[{"id":"manas-2010:p1263:b001:l034","ordinal":54785,"en":"Against the Chinese covering the earth,"},{"id":"manas-2010:p1263:b001:l035","ordinal":54786,"en":"Almambet and Syrgak, the two lions,"},{"id":"manas-2010:p1263:b001:l036","ordinal":54787,"en":"Went back in to confront them."},{"id":"manas-2010:p1263:b001:l037","ordinal":54788,"en":"Shedding blood, steeped in blood,"},{"id":"manas-2010:p1263:b001:l038","ordinal":54789,"en":"They went back in to fight."},{"id":"manas-2010:p1263:b001:l039","ordinal":54790,"en":"Fighting six months without rest,"},{"id":"manas-2010:p1263:b001:l040","ordinal":54791,"en":"Almambet and Syrgak,"},{"id":"manas-2010:p1263:b001:l041","ordinal":54792,"en":"Let us leave them for now;"},{"id":"manas-2010:p1263:b001:l042","ordinal":54793,"en":"Let us begin with warrior Manas."},{"id":"manas-2010:p1264:b002:l001","ordinal":54794,"en":"Upon Tal-Choku,"},{"id":"manas-2010:p1264:b002:l002","ordinal":54795,"en":"He woke from sleep with a start."},{"id":"manas-2010:p1264:b002:l003","ordinal":54796,"en":"Turning to his right,"},{"id":"manas-2010:p1264:b002:l004","ordinal":54797,"en":"Alarmed for Almambet,"},{"id":"manas-2010:p1264:b002:l005","ordinal":54798,"en":"He saddled Aybanboz."},{"id":"manas-2010:p1264:b002:l006","ordinal":54799,"en":"Roaring in anger,"},{"id":"manas-2010:p1264:b002:l007","ordinal":54800,"en":"To Chubak asleep,"},{"id":"manas-2010:p1264:b002:l008","ordinal":54801,"en":"“Wake up!” he called:"},{"id":"manas-2010:p1264:b002:l009","ordinal":54802,"en":"“Akbaltay's Chubak,"},{"id":"manas-2010:p1264:b002:l010","ordinal":54803,"en":"Before, beside broad Talas,"},{"id":"manas-2010:p1264:b002:l011","ordinal":54804,"en":"In the tamarisk hollow of Keng-Kol,"},{"id":"manas-2010:p1264:b002:l012","ordinal":54805,"en":"The teeming Kyrgyz, the many Nogoy,"},{"id":"manas-2010:p1264:b002:l013","ordinal":54806,"en":"When they were camped,"},{"id":"manas-2010:p1264:b002:l014","ordinal":54807,"en":"Fermented mare's milk by day, girls by night,"},{"id":"manas-2010:p1264:b002:l015","ordinal":54808,"en":"When it was thus,"},{"id":"manas-2010:p1264:b002:l016","ordinal":54809,"en":"Chasing wild asses over the sand,"},{"id":"manas-2010:p1264:b002:l017","ordinal":54810,"en":"When we were creeping along,"},{"id":"manas-2010:p1264:b002:l018","ordinal":54811,"en":"Staking forty fillies as the prize,"},{"id":"manas-2010:p1264:b002:l019","ordinal":54812,"en":"When we were playing,"},{"id":"manas-2010:p1264:b002:l020","ordinal":54813,"en":"When bored we shot roe deer;"},{"id":"manas-2010:p1264:b002:l021","ordinal":54814,"en":"When not bored, in Talas,"},{"id":"manas-2010:p1264:b002:l022","ordinal":54815,"en":"When we were amusing ourselves,"},{"id":"manas-2010:p1264:b002:l023","ordinal":54816,"en":"Rising in the morning,"},{"id":"manas-2010:p1264:b002:l024","ordinal":54817,"en":"You would slice and eat horse-rump meat."},{"id":"manas-2010:p1264:b002:l025","ordinal":54818,"en":"‘If a harsh, sorrowful day comes,"},{"id":"manas-2010:p1264:b002:l026","ordinal":54819,"en":"I shall shatter the governor-general,’ you would say."},{"id":"manas-2010:p1264:b002:l027","ordinal":54820,"en":"Akbaltay's Chubak,"},{"id":"manas-2010:p1264:b002:l028","ordinal":54821,"en":"Did you not lie boasting,"},{"id":"manas-2010:p1264:b002:l029","ordinal":54822,"en":"Thundering away on your own?"},{"id":"manas-2010:p1264:b002:l030","ordinal":54823,"en":"‘The Chinese on the ridge beside you,"},{"id":"manas-2010:p1264:b002:l031","ordinal":54824,"en":"I shall slaughter them,’ you would say."},{"id":"manas-2010:p1264:b002:l032","ordinal":54825,"en":"Taking a spear and mounting,"},{"id":"manas-2010:p1264:b002:l033","ordinal":54826,"en":"‘A marvelous battle"},{"id":"manas-2010:p1264:b002:l034","ordinal":54827,"en":"I shall wage,’ you would say."},{"id":"manas-2010:p1264:b002:l035","ordinal":54828,"en":"The time to slaughter has come;"},{"id":"manas-2010:p1264:b002:l036","ordinal":54829,"en":"The hour of mutual slaughter has come."},{"id":"manas-2010:p1264:b002:l037","ordinal":54830,"en":"Did you see what I saw?"},{"id":"manas-2010:p1264:b002:l038","ordinal":54831,"en":"Did you know what I knew?"},{"id":"manas-2010:p1265:b001:l001","ordinal":54832,"en":"Almambet and Syrgak, your companions,"},{"id":"manas-2010:p1265:b001:l002","ordinal":54833,"en":"Of the teeming Chinese unbelievers,"},{"id":"manas-2010:p1265:b001:l003","ordinal":54834,"en":"They have raided the horses."},{"id":"manas-2010:p1265:b001:l004","ordinal":54835,"en":"Behind the many horses,"},{"id":"manas-2010:p1265:b001:l005","ordinal":54836,"en":"Pursuers have come."},{"id":"manas-2010:p1265:b001:l006","ordinal":54837,"en":"The people of forty khans have stirred,"},{"id":"manas-2010:p1265:b001:l007","ordinal":54838,"en":"They have waged a tremendous battle."},{"id":"manas-2010:p1265:b001:l008","ordinal":54839,"en":"Almambet and Syrgak,"},{"id":"manas-2010:p1265:b001:l009","ordinal":54840,"en":"They have surrounded them."},{"id":"manas-2010:p1265:b001:l010","ordinal":54841,"en":"Now to seize them,"},{"id":"manas-2010:p1265:b001:l011","ordinal":54842,"en":"Upon both their heads"},{"id":"manas-2010:p1265:b001:l012","ordinal":54843,"en":"To bring harsh torment,"},{"id":"manas-2010:p1265:b001:l013","ordinal":54844,"en":"The teeming Chinese have crowded in,"},{"id":"manas-2010:p1265:b001:l014","ordinal":54845,"en":"They have made ready."},{"id":"manas-2010:p1265:b001:l015","ordinal":54846,"en":"Why should I tell the rest?"},{"id":"manas-2010:p1265:b001:l016","ordinal":54847,"en":"With a form unlike humankind,"},{"id":"manas-2010:p1265:b001:l017","ordinal":54848,"en":"Encircling them,"},{"id":"manas-2010:p1265:b001:l018","ordinal":54849,"en":"The One-Eyed have surged upon them."},{"id":"manas-2010:p1265:b001:l019","ordinal":54850,"en":"The One-Eyed who surround them,"},{"id":"manas-2010:p1265:b001:l020","ordinal":54851,"en":"Unless we charge their flank,"},{"id":"manas-2010:p1265:b001:l021","ordinal":54852,"en":"Unless we thrust spears at the unbelievers,"},{"id":"manas-2010:p1265:b001:l022","ordinal":54853,"en":"Almambet and Syrgak,"},{"id":"manas-2010:p1265:b001:l023","ordinal":54854,"en":"Unless we break them free,"},{"id":"manas-2010:p1265:b001:l024","ordinal":54855,"en":"Will they not know our dog-like conduct?"},{"id":"manas-2010:p1265:b001:l025","ordinal":54856,"en":"If what is told is true,"},{"id":"manas-2010:p1265:b001:l026","ordinal":54857,"en":"Tomorrow, on the Day of Resurrection,"},{"id":"manas-2010:p1265:b001:l027","ordinal":54858,"en":"Syrgak and Almambet,"},{"id":"manas-2010:p1265:b001:l028","ordinal":54859,"en":"The two of us then,"},{"id":"manas-2010:p1265:b001:l029","ordinal":54860,"en":"Will they not make us black donkeys and ride us?"},{"id":"manas-2010:p1265:b001:l030","ordinal":54861,"en":"Toward darkening Beijing,"},{"id":"manas-2010:p1265:b001:l031","ordinal":54862,"en":"Let us level our spears."},{"id":"manas-2010:p1265:b001:l032","ordinal":54863,"en":"From the multitudes of Chinese,"},{"id":"manas-2010:p1265:b001:l033","ordinal":54864,"en":"Almambet and Syrgak,"},{"id":"manas-2010:p1265:b001:l034","ordinal":54865,"en":"Let us break them free."},{"id":"manas-2010:p1265:b001:l035","ordinal":54866,"en":"The Chinese whose time has come,"},{"id":"manas-2010:p1265:b001:l036","ordinal":54867,"en":"Let us slaughter them as sacrifices."},{"id":"manas-2010:p1265:b001:l037","ordinal":54868,"en":"At the dark mass of unbelievers,"},{"id":"manas-2010:p1265:b001:l038","ordinal":54869,"en":"Let us level our guns."},{"id":"manas-2010:p1265:b001:l039","ordinal":54870,"en":"For warriors Almambet and Syrgak,"},{"id":"manas-2010:p1265:b001:l040","ordinal":54871,"en":"Let us give our mortal lives."},{"id":"manas-2010:p1265:b001:l041","ordinal":54872,"en":"The two lions who are enduring there,"},{"id":"manas-2010:p1265:b001:l042","ordinal":54873,"en":"Seeing them, my Chubak,"},{"id":"manas-2010:p1266:b001:l001","ordinal":54874,"en":"How could we remain alive!"},{"id":"manas-2010:p1266:b001:l002","ordinal":54875,"en":"The decree Heaven has sent,"},{"id":"manas-2010:p1266:b001:l003","ordinal":54876,"en":"If it comes upon our heads, let us face it."},{"id":"manas-2010:p1266:b001:l004","ordinal":54877,"en":"Grasping spears, breaking their ranks,"},{"id":"manas-2010:p1266:b001:l005","ordinal":54878,"en":"If death comes, falling to a bullet,"},{"id":"manas-2010:p1266:b001:l006","ordinal":54879,"en":"Let us die without sparing ourselves."},{"id":"manas-2010:p1266:b001:l007","ordinal":54880,"en":"Of the shouting Chinese,"},{"id":"manas-2010:p1266:b001:l008","ordinal":54881,"en":"Let us spill their blood without mercy!"},{"id":"manas-2010:p1266:b001:l009","ordinal":54882,"en":"Go quickly, my Chubak."},{"id":"manas-2010:p1266:b001:l010","ordinal":54883,"en":"For Almambet and Syrgak,"},{"id":"manas-2010:p1266:b001:l011","ordinal":54884,"en":"Let us become a supporting presence."},{"id":"manas-2010:p1266:b001:l012","ordinal":54885,"en":"If we do not support them,"},{"id":"manas-2010:p1266:b001:l013","ordinal":54886,"en":"If we do not go quickly,"},{"id":"manas-2010:p1266:b001:l014","ordinal":54887,"en":"Almambet and Syrgak,"},{"id":"manas-2010:p1266:b001:l015","ordinal":54888,"en":"Will they not seize them outright?"},{"id":"manas-2010:p1266:b001:l016","ordinal":54889,"en":"Almambet, against whom they bear a feud,"},{"id":"manas-2010:p1266:b001:l017","ordinal":54890,"en":"If he falls into the unbelievers' hands,"},{"id":"manas-2010:p1266:b001:l018","ordinal":54891,"en":"Will they not slit and split his belly,"},{"id":"manas-2010:p1266:b001:l019","ordinal":54892,"en":"Drag him onto the road,"},{"id":"manas-2010:p1266:b001:l020","ordinal":54893,"en":"Will they not throw him to the full-grown dogs!"},{"id":"manas-2010:p1266:b001:l021","ordinal":54894,"en":"‘Almambet has died,’ they will say."},{"id":"manas-2010:p1266:b001:l022","ordinal":54895,"en":"Will they not send word to Beijing?"},{"id":"manas-2010:p1266:b001:l023","ordinal":54896,"en":"Will God not strike that unruly one?"},{"id":"manas-2010:p1266:b001:l024","ordinal":54897,"en":"Of Beijing, untouched by the Four Companions,"},{"id":"manas-2010:p1266:b001:l025","ordinal":54898,"en":"Will they not gather its whole army?"},{"id":"manas-2010:p1266:b001:l026","ordinal":54899,"en":"When your Alake has died,"},{"id":"manas-2010:p1266:b001:l027","ordinal":54900,"en":"The handful of Muslims,"},{"id":"manas-2010:p1266:b001:l028","ordinal":54901,"en":"Will the many Chinese not drive them on,"},{"id":"manas-2010:p1266:b001:l029","ordinal":54902,"en":"Slaughtering them all the way to Mecca?"},{"id":"manas-2010:p1266:b001:l030","ordinal":54903,"en":"Your unbelievers of another faith,"},{"id":"manas-2010:p1266:b001:l031","ordinal":54904,"en":"Will they not wreak slaughter thus!"},{"id":"manas-2010:p1266:b001:l032","ordinal":54905,"en":"Go, Chubak, let us reach them."},{"id":"manas-2010:p1266:b001:l033","ordinal":54906,"en":"Let us die before those two,"},{"id":"manas-2010:p1266:b001:l034","ordinal":54907,"en":"For Almambet and Syrgak,"},{"id":"manas-2010:p1266:b001:l035","ordinal":54908,"en":"Let us become sacrifices,”"},{"id":"manas-2010:p1266:b001:l036","ordinal":54909,"en":"Said warrior Manas then,"},{"id":"manas-2010:p1266:b001:l037","ordinal":54910,"en":"Roaring in anger,"},{"id":"manas-2010:p1266:b001:l038","ordinal":54911,"en":"A wrathful lion, a precious warrior."},{"id":"manas-2010:p1266:b001:l039","ordinal":54912,"en":"Chubak, who stood watching,"},{"id":"manas-2010:p1266:b001:l040","ordinal":54913,"en":"His whole body bristled."},{"id":"manas-2010:p1266:b001:l041","ordinal":54914,"en":"The gray pouch beside him,"},{"id":"manas-2010:p1266:b001:l042","ordinal":54915,"en":"As he shouted and girded it at his waist,"},{"id":"manas-2010:p1267:b001:l001","ordinal":54916,"en":"Ak Eshen had become a companion beside him."},{"id":"manas-2010:p1267:b001:l002","ordinal":54917,"en":"His supporter was Kozhosan;"},{"id":"manas-2010:p1267:b001:l003","ordinal":54918,"en":"The one who gave his hand was Ak Eshen."},{"id":"manas-2010:p1267:b001:l004","ordinal":54919,"en":"Warrior Manas, the blue-maned one's"},{"id":"manas-2010:p1267:b001:l005","ordinal":54920,"en":"Splendor could not be faulted."},{"id":"manas-2010:p1267:b001:l006","ordinal":54921,"en":"To wreak slaughter on this journey,"},{"id":"manas-2010:p1267:b001:l007","ordinal":54922,"en":"His gun Akkelte, Akkula,"},{"id":"manas-2010:p1267:b001:l008","ordinal":54923,"en":"And his armor Akolpok were absent."},{"id":"manas-2010:p1267:b001:l009","ordinal":54924,"en":"Hurrying him without letting them be fetched,"},{"id":"manas-2010:p1267:b001:l010","ordinal":54925,"en":"Warrior Chubak had no good fortune."},{"id":"manas-2010:p1267:b001:l011","ordinal":54926,"en":"He did not turn back at the word death,"},{"id":"manas-2010:p1267:b001:l012","ordinal":54927,"en":"Did not retreat in fear of his end."},{"id":"manas-2010:p1267:b001:l013","ordinal":54928,"en":"If a pit lay dug,"},{"id":"manas-2010:p1267:b001:l014","ordinal":54929,"en":"He did not flee lest he fall into it."},{"id":"manas-2010:p1267:b001:l015","ordinal":54930,"en":"He rejoiced to see an enemy,"},{"id":"manas-2010:p1267:b001:l016","ordinal":54931,"en":"Turned the place of shooting into fire,"},{"id":"manas-2010:p1267:b001:l017","ordinal":54932,"en":"Destroyed those who grappled with him."},{"id":"manas-2010:p1267:b001:l018","ordinal":54933,"en":"He was a lion from birth,"},{"id":"manas-2010:p1267:b001:l019","ordinal":54934,"en":"His fame spreading to many,"},{"id":"manas-2010:p1267:b001:l020","ordinal":54935,"en":"A leopard, a blue-maned warrior."},{"id":"manas-2010:p1267:b001:l021","ordinal":54936,"en":"He set grassy ground ablaze,"},{"id":"manas-2010:p1267:b001:l022","ordinal":54937,"en":"Burned the meadows with fire,"},{"id":"manas-2010:p1267:b001:l023","ordinal":54938,"en":"What twelve ages had never wrought,"},{"id":"manas-2010:p1267:b001:l024","ordinal":54939,"en":"Not a stick for a herding pole remained."},{"id":"manas-2010:p1267:b001:l025","ordinal":54940,"en":"The Muslim lion, the precious warrior,"},{"id":"manas-2010:p1267:b001:l026","ordinal":54941,"en":"Looming like an immense mountain,"},{"id":"manas-2010:p1267:b001:l027","ordinal":54942,"en":"Rode in from the summit,"},{"id":"manas-2010:p1267:b001:l028","ordinal":54943,"en":"Flame pouring from his mouth."},{"id":"manas-2010:p1267:b001:l029","ordinal":54944,"en":"A black-spotted leopard"},{"id":"manas-2010:p1267:b001:l030","ordinal":54945,"en":"Leapt at his side."},{"id":"manas-2010:p1267:b001:l031","ordinal":54946,"en":"“Since my dear friend acts thus,"},{"id":"manas-2010:p1267:b001:l032","ordinal":54947,"en":"How can I spare my life?” he said."},{"id":"manas-2010:p1267:b001:l033","ordinal":54948,"en":"Khan Baltay's Chubak"},{"id":"manas-2010:p1267:b001:l034","ordinal":54949,"en":"Mounted Kögala, making ready."},{"id":"manas-2010:p1267:b001:l035","ordinal":54950,"en":"Talas is no less than Keng-Kol;"},{"id":"manas-2010:p1267:b001:l036","ordinal":54951,"en":"Stately warrior Chubak"},{"id":"manas-2010:p1267:b001:l037","ordinal":54952,"en":"Is no less than warrior Manas."},{"id":"manas-2010:p1267:b001:l038","ordinal":54953,"en":"Akbaltay's Chubak,"},{"id":"manas-2010:p1267:b001:l039","ordinal":54954,"en":"Except for Manas's guardian power,"},{"id":"manas-2010:p1267:b001:l040","ordinal":54955,"en":"Was no lion to fall short."},{"id":"manas-2010:p1267:b001:l041","ordinal":54956,"en":"Then Chubak stood resplendent,"},{"id":"manas-2010:p1267:b001:l042","ordinal":54957,"en":"Wearing a blue ribbed-cloth robe,"},{"id":"manas-2010:p1268:b001:l001","ordinal":54958,"en":"Riding a horse like Kögala,"},{"id":"manas-2010:p1268:b001:l002","ordinal":54959,"en":"Girding himself for battle,"},{"id":"manas-2010:p1268:b001:l003","ordinal":54960,"en":"“I entrust myself to God!” he said, taking heart."},{"id":"manas-2010:p1268:b001:l004","ordinal":54961,"en":"“Of the surging unbelievers,"},{"id":"manas-2010:p1268:b001:l005","ordinal":54962,"en":"Let me unravel their ranks."},{"id":"manas-2010:p1268:b001:l006","ordinal":54963,"en":"Let me truly bring them hell."},{"id":"manas-2010:p1268:b001:l007","ordinal":54964,"en":"My Alma, my friend for the afterlife,"},{"id":"manas-2010:p1268:b001:l008","ordinal":54965,"en":"If my strength suffices, from the Chinese,"},{"id":"manas-2010:p1268:b001:l009","ordinal":54966,"en":"Let me break him free."},{"id":"manas-2010:p1268:b001:l010","ordinal":54967,"en":"If I cannot break him free,"},{"id":"manas-2010:p1268:b001:l011","ordinal":54968,"en":"The decree God has sent,"},{"id":"manas-2010:p1268:b001:l012","ordinal":54969,"en":"Whatever it is, let me face it."},{"id":"manas-2010:p1268:b001:l013","ordinal":54970,"en":"For Almambet and Syrgak,"},{"id":"manas-2010:p1268:b001:l014","ordinal":54971,"en":"Let me become a supporting presence,”"},{"id":"manas-2010:p1268:b001:l015","ordinal":54972,"en":"Said warrior Chubak then,"},{"id":"manas-2010:p1268:b001:l016","ordinal":54973,"en":"Who did not retreat from blood,"},{"id":"manas-2010:p1268:b001:l017","ordinal":54974,"en":"That familiar impetuous blue-maned one."},{"id":"manas-2010:p1268:b001:l018","ordinal":54975,"en":"He dashed forward in anger,"},{"id":"manas-2010:p1268:b001:l019","ordinal":54976,"en":"Urging Kögala onward."},{"id":"manas-2010:p1268:b001:l020","ordinal":54977,"en":"Ranging farther, looking about,"},{"id":"manas-2010:p1268:b001:l021","ordinal":54978,"en":"Readying his keen sword,"},{"id":"manas-2010:p1268:b001:l022","ordinal":54979,"en":"Becoming a companion to Manas,"},{"id":"manas-2010:p1268:b001:l023","ordinal":54980,"en":"He was to meet with suffering."},{"id":"manas-2010:p1268:b001:l024","ordinal":54981,"en":"Warrior Chubak was to enter"},{"id":"manas-2010:p1268:b001:l025","ordinal":54982,"en":"The campaign of dreadful renown."},{"id":"manas-2010:p1268:b001:l026","ordinal":54983,"en":"To enter this campaign,"},{"id":"manas-2010:p1268:b001:l027","ordinal":54984,"en":"The champion who girded himself,"},{"id":"manas-2010:p1268:b001:l028","ordinal":54985,"en":"Going ahead of him"},{"id":"manas-2010:p1268:b001:l029","ordinal":54986,"en":"Was the foremost champion Manas."},{"id":"manas-2010:p1268:b001:l030","ordinal":54987,"en":"Let me tell you Manas's appearance:"},{"id":"manas-2010:p1268:b001:l031","ordinal":54988,"en":"Looking at his front,"},{"id":"manas-2010:p1268:b001:l032","ordinal":54989,"en":"He had the majesty of sixty warriors."},{"id":"manas-2010:p1268:b001:l033","ordinal":54990,"en":"Chubak behind him"},{"id":"manas-2010:p1268:b001:l034","ordinal":54991,"en":"Had the appearance of a dragon."},{"id":"manas-2010:p1268:b001:l035","ordinal":54992,"en":"When they looked then,"},{"id":"manas-2010:p1268:b001:l036","ordinal":54993,"en":"Before them, upon the sunny slope,"},{"id":"manas-2010:p1268:b001:l037","ordinal":54994,"en":"All the horses surged,"},{"id":"manas-2010:p1268:b001:l038","ordinal":54995,"en":"They were spread out in a mass."},{"id":"manas-2010:p1268:b001:l039","ordinal":54996,"en":"Driving the horses like a human,"},{"id":"manas-2010:p1268:b001:l040","ordinal":54997,"en":"Azhybay's Kartküröng"},{"id":"manas-2010:p1268:b001:l041","ordinal":54998,"en":"Was herding them onward."},{"id":"manas-2010:p1268:b001:l042","ordinal":54999,"en":"Making his neck like a gun hammer,"},{"id":"manas-2010:p1269:b001:l001","ordinal":55000,"en":"He had bent it down."},{"id":"manas-2010:p1269:b001:l002","ordinal":55001,"en":"Though Kartküröng was a beast,"},{"id":"manas-2010:p1269:b001:l003","ordinal":55002,"en":"Driving the horses like a human,"},{"id":"manas-2010:p1269:b001:l004","ordinal":55003,"en":"He was carrying off the herd."},{"id":"manas-2010:p1269:b001:l005","ordinal":55004,"en":"When he saw Khan Manas,"},{"id":"manas-2010:p1269:b001:l006","ordinal":55005,"en":"No longer driving the horses,"},{"id":"manas-2010:p1269:b001:l007","ordinal":55006,"en":"He left them and dashed away."},{"id":"manas-2010:p1269:b001:l008","ordinal":55007,"en":"Clods as large as a great cauldron,"},{"id":"manas-2010:p1269:b001:l009","ordinal":55008,"en":"He flung toward the sky."},{"id":"manas-2010:p1269:b001:l010","ordinal":55009,"en":"Neighing once, ringing out,"},{"id":"manas-2010:p1269:b001:l011","ordinal":55010,"en":"Before Khan Manas,"},{"id":"manas-2010:p1269:b001:l012","ordinal":55011,"en":"Kartküröng turned straight toward him,"},{"id":"manas-2010:p1269:b001:l013","ordinal":55012,"en":"He came on with a ringing neigh."},{"id":"manas-2010:p1269:b001:l014","ordinal":55013,"en":"“He will take the lead in his hand,” he thought."},{"id":"manas-2010:p1269:b001:l015","ordinal":55014,"en":"“If he is a true warrior sultan,"},{"id":"manas-2010:p1269:b001:l016","ordinal":55015,"en":"Toward Beijing before him,"},{"id":"manas-2010:p1269:b001:l017","ordinal":55016,"en":"He will take me along on the lead,” he thought."},{"id":"manas-2010:p1269:b001:l018","ordinal":55017,"en":"“When the grappling unbelievers"},{"id":"manas-2010:p1269:b001:l019","ordinal":55018,"en":"Come surging in,"},{"id":"manas-2010:p1269:b001:l020","ordinal":55019,"en":"Manas will mount me,” he thought."},{"id":"manas-2010:p1269:b001:l021","ordinal":55020,"en":"“Warrior Manas, born a leopard,"},{"id":"manas-2010:p1269:b001:l022","ordinal":55021,"en":"Riding me, upon the many enemies,"},{"id":"manas-2010:p1269:b001:l023","ordinal":55022,"en":"He will strike like a hawk,” he thought."},{"id":"manas-2010:p1269:b001:l024","ordinal":55023,"en":"“The leopard of sacred power"},{"id":"manas-2010:p1269:b001:l025","ordinal":55024,"en":"Will know my worth,” he thought."},{"id":"manas-2010:p1269:b001:l026","ordinal":55025,"en":"“If the warrior mounts my back,"},{"id":"manas-2010:p1269:b001:l027","ordinal":55026,"en":"Let me stretch my stride like a wild sheep."},{"id":"manas-2010:p1269:b001:l028","ordinal":55027,"en":"Kongurbay's Algara,"},{"id":"manas-2010:p1269:b001:l029","ordinal":55028,"en":"Let me bring him within reach three times."},{"id":"manas-2010:p1269:b001:l030","ordinal":55029,"en":"Let me too begin the campaign."},{"id":"manas-2010:p1269:b001:l031","ordinal":55030,"en":"If your blue-maned one mounts me,"},{"id":"manas-2010:p1269:b001:l032","ordinal":55031,"en":"Let me cast away my life."},{"id":"manas-2010:p1269:b001:l033","ordinal":55032,"en":"If he fights with spears, let me press close."},{"id":"manas-2010:p1269:b001:l034","ordinal":55033,"en":"Warrior Manas raising a shout,"},{"id":"manas-2010:p1269:b001:l035","ordinal":55034,"en":"Making the Chinese cry out,"},{"id":"manas-2010:p1269:b001:l036","ordinal":55035,"en":"If he drives them into Beijing,"},{"id":"manas-2010:p1269:b001:l037","ordinal":55036,"en":"However long he rides, without finding it burdensome,"},{"id":"manas-2010:p1269:b001:l038","ordinal":55037,"en":"Without growing hot and saddle-sore,"},{"id":"manas-2010:p1269:b001:l039","ordinal":55038,"en":"Drinking water, eating no grass,"},{"id":"manas-2010:p1269:b001:l040","ordinal":55039,"en":"Let me endure for the sultan."},{"id":"manas-2010:p1269:b001:l041","ordinal":55040,"en":"He will wear his shield-like armor,” he thought."}]
