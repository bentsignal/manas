[{"id":"semetey-1-2013:p0764:b003:l011","ordinal":135425,"en":"Kumaiyk climbed,"},{"id":"semetey-1-2013:p0764:b003:l012","ordinal":135426,"en":"And howled for three days."},{"id":"semetey-1-2013:p0764:b003:l013","ordinal":135427,"en":"A wise old man said:"},{"id":"semetey-1-2013:p0764:b003:l014","ordinal":135428,"en":"“Manas's son, the orphan hero,"},{"id":"semetey-1-2013:p0764:b003:l015","ordinal":135429,"en":"Has reached twelve years of age;"},{"id":"semetey-1-2013:p0764:b003:l016","ordinal":135430,"en":"This year his time to come has arrived.”"},{"id":"semetey-1-2013:p0764:b003:l017","ordinal":135431,"en":"Kumaiyk fled in a frenzy;"},{"id":"semetey-1-2013:p0764:b003:l018","ordinal":135432,"en":"Somehow, my orphan, he met you."},{"id":"semetey-1-2013:p0764:b003:l019","ordinal":135433,"en":"Akshumkar, of whom you speak—"},{"id":"semetey-1-2013:p0764:b003:l020","ordinal":135434,"en":"Everything you say is true."},{"id":"semetey-1-2013:p0764:b003:l021","ordinal":135435,"en":"When Manas the leopard died,"},{"id":"semetey-1-2013:p0764:b003:l022","ordinal":135436,"en":"Akshumkar vanished into the unseen."},{"id":"semetey-1-2013:p0764:b003:l023","ordinal":135437,"en":"His desire, in this way,"},{"id":"semetey-1-2013:p0764:b003:l024","ordinal":135438,"en":"Akshumkar had attained."},{"id":"semetey-1-2013:p0764:b003:l025","ordinal":135439,"en":"Since Manas the lion died,"},{"id":"semetey-1-2013:p0764:b003:l026","ordinal":135440,"en":"It has been twelve full years"},{"id":"semetey-1-2013:p0764:b003:l027","ordinal":135441,"en":"Since Akshumkar departed."},{"id":"semetey-1-2013:p0764:b003:l028","ordinal":135442,"en":"This year I learned from those who knew,"},{"id":"semetey-1-2013:p0764:b003:l029","ordinal":135443,"en":"I questioned the herders."},{"id":"semetey-1-2013:p0764:b003:l030","ordinal":135444,"en":"He has surveyed the land,"},{"id":"semetey-1-2013:p0764:b003:l031","ordinal":135445,"en":"And has reached Talas."},{"id":"semetey-1-2013:p0764:b003:l032","ordinal":135446,"en":"On the slope of that mountain,"},{"id":"semetey-1-2013:p0764:b003:l033","ordinal":135447,"en":"On the level place where sakers breed,"},{"id":"semetey-1-2013:p0764:b003:l034","ordinal":135448,"en":"Upon hard rock, the falcon's nest"},{"id":"semetey-1-2013:p0764:b003:l035","ordinal":135449,"en":"He has arrived and built, they say."},{"id":"semetey-1-2013:p0764:b003:l036","ordinal":135450,"en":"That Akshumkar,"},{"id":"semetey-1-2013:p0764:b003:l037","ordinal":135451,"en":"Roaming all the ridges,"},{"id":"semetey-1-2013:p0764:b003:l038","ordinal":135452,"en":"Has blocked the pass, they say."},{"id":"semetey-1-2013:p0764:b003:l039","ordinal":135453,"en":"The passing swans and migrant geese—"},{"id":"semetey-1-2013:p0764:b004:l001","ordinal":135454,"en":"He has wrought fierce slaughter, they say."},{"id":"semetey-1-2013:p0764:b004:l002","ordinal":135455,"en":"Then, along Chech-Tobo,"},{"id":"semetey-1-2013:p0764:b004:l003","ordinal":135456,"en":"He surveyed At-Bashy."},{"id":"semetey-1-2013:p0764:b004:l004","ordinal":135457,"en":"At Chatyr-Kol in Ak-Say,"},{"id":"semetey-1-2013:p0764:b004:l005","ordinal":135458,"en":"The falcon there—"},{"id":"semetey-1-2013:p0764:b004:l006","ordinal":135459,"en":"Akshumkar reached it,"},{"id":"semetey-1-2013:p0764:b004:l007","ordinal":135460,"en":"And they mated."},{"id":"semetey-1-2013:p0764:b004:l008","ordinal":135461,"en":"This year that wondrous creature"},{"id":"semetey-1-2013:p0764:b004:l009","ordinal":135462,"en":"Was heavy with young."},{"id":"semetey-1-2013:p0764:b004:l010","ordinal":135463,"en":"Surveying the cliff of which I spoke,"},{"id":"semetey-1-2013:p0764:b004:l011","ordinal":135464,"en":"It built a spacious nest,"},{"id":"semetey-1-2013:p0764:b004:l012","ordinal":135465,"en":"Laid its brood in winter,"},{"id":"semetey-1-2013:p0764:b004:l013","ordinal":135466,"en":"And left it frozen."},{"id":"semetey-1-2013:p0764:b004:l014","ordinal":135467,"en":"When the days grew long,"},{"id":"semetey-1-2013:p0764:b004:l015","ordinal":135468,"en":"Roaring through the ravines,"},{"id":"semetey-1-2013:p0764:b004:l016","ordinal":135469,"en":"Yellow waters swelled and flowed."},{"id":"semetey-1-2013:p0764:b004:l017","ordinal":135470,"en":"When life returned to the grass,"},{"id":"semetey-1-2013:p0764:b004:l018","ordinal":135471,"en":"When living creatures thronged,"},{"id":"semetey-1-2013:p0764:b004:l019","ordinal":135472,"en":"When the snow slipped away,"},{"id":"semetey-1-2013:p0764:b004:l020","ordinal":135473,"en":"When warmth reached the earth,"},{"id":"semetey-1-2013:p0764:b004:l021","ordinal":135474,"en":"Akshumkar, left by your father,"},{"id":"semetey-1-2013:p0764:b004:l022","ordinal":135475,"en":"Shed its breast feathers, they say."},{"id":"semetey-1-2013:p0764:b004:l023","ordinal":135476,"en":"Brooding for thirty-two days,"},{"id":"semetey-1-2013:p0764:b004:l024","ordinal":135477,"en":"It hatched its eggs, they say."},{"id":"semetey-1-2013:p0764:b004:l025","ordinal":135478,"en":"Himself a keen-eyed falcon;"},{"id":"semetey-1-2013:p0764:b004:l026","ordinal":135479,"en":"My dear orphan,"},{"id":"semetey-1-2013:p0764:b004:l027","ordinal":135480,"en":"That is property you may take."},{"id":"semetey-1-2013:p0764:b004:l028","ordinal":135481,"en":"Now the young are at the pinfeather stage."},{"id":"semetey-1-2013:p0764:b004:l029","ordinal":135482,"en":"The six keen blades descended from heaven,"},{"id":"semetey-1-2013:p0764:b004:l030","ordinal":135483,"en":"The very finest of swords,"},{"id":"semetey-1-2013:p0764:b004:l031","ordinal":135484,"en":"Zulpukor, left by Manas,"},{"id":"semetey-1-2013:p0764:b004:l032","ordinal":135485,"en":"Khan Bakay's Kylbolot,"},{"id":"semetey-1-2013:p0764:b004:l033","ordinal":135486,"en":"Zhoybolot, which Akybay took,"},{"id":"semetey-1-2013:p0764:b004:l034","ordinal":135487,"en":"Zhoykuma, which Almambet took,"},{"id":"semetey-1-2013:p0764:b004:l035","ordinal":135488,"en":"Achalbars, which Chubak took,"},{"id":"semetey-1-2013:p0764:b004:l036","ordinal":135489,"en":"The very last of the swords,"},{"id":"semetey-1-2013:p0764:b004:l037","ordinal":135490,"en":"Arkesken, which Syrgak took—"},{"id":"semetey-1-2013:p0764:b004:l038","ordinal":135491,"en":"I knew you would come, my orphan."},{"id":"semetey-1-2013:p0764:b004:l039","ordinal":135492,"en":"As a final bequest, poor man,"},{"id":"semetey-1-2013:p0765:b003:l001","ordinal":135493,"en":"I kept thinking, “When he comes, he will take them.”"},{"id":"semetey-1-2013:p0765:b003:l002","ordinal":135494,"en":"These are entrusted to us;"},{"id":"semetey-1-2013:p0765:b003:l003","ordinal":135495,"en":"I will give them to you; take them away."},{"id":"semetey-1-2013:p0765:b003:l004","ordinal":135496,"en":"Then Manas the leopard,"},{"id":"semetey-1-2013:p0765:b003:l005","ordinal":135497,"en":"Making Akkula prance,"},{"id":"semetey-1-2013:p0765:b003:l006","ordinal":135498,"en":"The enemy who faced him—"},{"id":"semetey-1-2013:p0765:b003:l007","ordinal":135499,"en":"He made those who met him crawl."},{"id":"semetey-1-2013:p0765:b003:l008","ordinal":135500,"en":"Those he faced fled in fear;"},{"id":"semetey-1-2013:p0765:b003:l009","ordinal":135501,"en":"Those who fought him did not get far."},{"id":"semetey-1-2013:p0765:b003:l010","ordinal":135502,"en":"If an enemy came out to fight,"},{"id":"semetey-1-2013:p0765:b003:l011","ordinal":135503,"en":"He took him in his jaws and chewed him."},{"id":"semetey-1-2013:p0765:b003:l012","ordinal":135504,"en":"No one remained to face him."},{"id":"semetey-1-2013:p0765:b003:l013","ordinal":135505,"en":"At the waist of the lion hero,"},{"id":"semetey-1-2013:p0765:b003:l014","ordinal":135506,"en":"Bozkise, which he girded on,"},{"id":"semetey-1-2013:p0765:b003:l015","ordinal":135507,"en":"Of fierce Manas alone,"},{"id":"semetey-1-2013:p0765:b003:l016","ordinal":135508,"en":"Was the belt that befriended his very soul."},{"id":"semetey-1-2013:p0765:b003:l017","ordinal":135509,"en":"No mortal could bear it in his hands,"},{"id":"semetey-1-2013:p0765:b003:l018","ordinal":135510,"en":"Nor dare to take hold of it."},{"id":"semetey-1-2013:p0765:b003:l019","ordinal":135511,"en":"No one apart from Manas"},{"id":"semetey-1-2013:p0765:b003:l020","ordinal":135512,"en":"Could endure fastening it at his waist."},{"id":"semetey-1-2013:p0765:b003:l021","ordinal":135513,"en":"I will tell you, my orphan:"},{"id":"semetey-1-2013:p0765:b003:l022","ordinal":135514,"en":"Take the world in abundance,"},{"id":"semetey-1-2013:p0765:b003:l023","ordinal":135515,"en":"At this time it is kept safe"},{"id":"semetey-1-2013:p0765:b003:l024","ordinal":135516,"en":"In Khan Kobosh's hands."},{"id":"semetey-1-2013:p0765:b003:l025","ordinal":135517,"en":"That same Bozkise,"},{"id":"semetey-1-2013:p0765:b003:l026","ordinal":135518,"en":"Take it away as a gift,"},{"id":"semetey-1-2013:p0765:b003:l027","ordinal":135519,"en":"Saying, “It was left by my valiant father,”"},{"id":"semetey-1-2013:p0765:b003:l028","ordinal":135520,"en":"And fasten it about your waist."},{"id":"semetey-1-2013:p0765:b003:l029","ordinal":135521,"en":"Akolpok, from your father Manas—"},{"id":"semetey-1-2013:p0765:b003:l030","ordinal":135522,"en":"Let me tell you its story."},{"id":"semetey-1-2013:p0765:b003:l031","ordinal":135523,"en":"Its collar gold, its sleeves copper,"},{"id":"semetey-1-2013:p0765:b003:l032","ordinal":135524,"en":"Double mail with lark-eye links,"},{"id":"semetey-1-2013:p0765:b003:l033","ordinal":135525,"en":"A rich outer coat, a roomy vest,"},{"id":"semetey-1-2013:p0765:b003:l034","ordinal":135526,"en":"Bulletproof when worn into battle."},{"id":"semetey-1-2013:p0765:b003:l035","ordinal":135527,"en":"Your valiant mother Kanykey"},{"id":"semetey-1-2013:p0765:b003:l036","ordinal":135528,"en":"Orenburg and Margilan—"},{"id":"semetey-1-2013:p0765:b003:l037","ordinal":135529,"en":"She had the lands between them searched."},{"id":"semetey-1-2013:p0765:b003:l038","ordinal":135530,"en":"The fiber from there—"},{"id":"semetey-1-2013:p0765:b003:l039","ordinal":135531,"en":"She had the merchants beaten"},{"id":"semetey-1-2013:p0765:b004:l001","ordinal":135532,"en":"And had it taken by force."},{"id":"semetey-1-2013:p0765:b004:l002","ordinal":135533,"en":"The fiber for its weft"},{"id":"semetey-1-2013:p0765:b004:l003","ordinal":135534,"en":"She had strong men twist."},{"id":"semetey-1-2013:p0765:b004:l004","ordinal":135535,"en":"Steel and the finest steel"},{"id":"semetey-1-2013:p0765:b004:l005","ordinal":135536,"en":"She had poured into its middle,"},{"id":"semetey-1-2013:p0765:b004:l006","ordinal":135537,"en":"And let it settle, dish after dish."},{"id":"semetey-1-2013:p0765:b004:l007","ordinal":135538,"en":"She lined its inside with fine fabric,"},{"id":"semetey-1-2013:p0765:b004:l008","ordinal":135539,"en":"Had nine buttons fastened to it."},{"id":"semetey-1-2013:p0765:b004:l009","ordinal":135540,"en":"Your precious mother Kanykey"},{"id":"semetey-1-2013:p0765:b004:l010","ordinal":135541,"en":"Worked it with her teeth for seven years without rest."},{"id":"semetey-1-2013:p0765:b004:l011","ordinal":135542,"en":"Keeping her eyes upon that coat,"},{"id":"semetey-1-2013:p0765:b004:l012","ordinal":135543,"en":"Her dear eyes grew strained."},{"id":"semetey-1-2013:p0765:b004:l013","ordinal":135544,"en":"From the effort of biting,"},{"id":"semetey-1-2013:p0765:b004:l014","ordinal":135545,"en":"Her door-like teeth wore away."},{"id":"semetey-1-2013:p0765:b004:l015","ordinal":135546,"en":"She had a precious weft laid in."},{"id":"semetey-1-2013:p0765:b004:l016","ordinal":135547,"en":"When he entered combat with the enemy,"},{"id":"semetey-1-2013:p0765:b004:l017","ordinal":135548,"en":"It satisfied a man's heart."},{"id":"semetey-1-2013:p0765:b004:l018","ordinal":135549,"en":"Arrows could not reach him,"},{"id":"semetey-1-2013:p0765:b004:l019","ordinal":135550,"en":"A spear's point could not pass through,"},{"id":"semetey-1-2013:p0765:b004:l020","ordinal":135551,"en":"A gun's bullet could not enter."},{"id":"semetey-1-2013:p0765:b004:l021","ordinal":135552,"en":"Akolpok, worn by the king—"},{"id":"semetey-1-2013:p0765:b004:l022","ordinal":135553,"en":"When Manas, my caravan, was still here,"},{"id":"semetey-1-2013:p0765:b004:l023","ordinal":135554,"en":"When the mighty champions were alive,"},{"id":"semetey-1-2013:p0765:b004:l024","ordinal":135555,"en":"With a cotton sash and broad boots,"},{"id":"semetey-1-2013:p0765:b004:l025","ordinal":135556,"en":"Kalcha, khan of the Kalmyks—"},{"id":"semetey-1-2013:p0765:b004:l026","ordinal":135557,"en":"When they took horses from Keng-Shor,"},{"id":"semetey-1-2013:p0765:b004:l027","ordinal":135558,"en":"Ten thousand livestock gathered as tribute,"},{"id":"semetey-1-2013:p0765:b004:l028","ordinal":135559,"en":"Countless great beasts of the treasury,"},{"id":"semetey-1-2013:p0765:b004:l029","ordinal":135560,"en":"Almambet and Chubak, names paired together,"},{"id":"semetey-1-2013:p0765:b004:l030","ordinal":135561,"en":"When they raided and took them all,"},{"id":"semetey-1-2013:p0765:b004:l031","ordinal":135562,"en":"Their frisking foals—"},{"id":"semetey-1-2013:p0765:b004:l032","ordinal":135563,"en":"When they slaughtered them in the water,"},{"id":"semetey-1-2013:p0765:b004:l033","ordinal":135564,"en":"Their neighing mares—"},{"id":"semetey-1-2013:p0765:b004:l034","ordinal":135565,"en":"When they drove them off without their foals,"},{"id":"semetey-1-2013:p0765:b004:l035","ordinal":135566,"en":"Azhybay's Kartkurong,"},{"id":"semetey-1-2013:p0765:b004:l036","ordinal":135567,"en":"When it took the lead of the herd,"},{"id":"semetey-1-2013:p0765:b004:l037","ordinal":135568,"en":"Their teeming khans—"},{"id":"semetey-1-2013:p0765:b004:l038","ordinal":135569,"en":"When they brought them to a day of ruin,"},{"id":"semetey-1-2013:p0765:b004:l039","ordinal":135570,"en":"The people who tended the horses—"},{"id":"semetey-1-2013:p0766:b003:l001","ordinal":135571,"en":"When they slaughtered them all,"},{"id":"semetey-1-2013:p0766:b003:l002","ordinal":135572,"en":"When they raided the horses and fled,"},{"id":"semetey-1-2013:p0766:b003:l003","ordinal":135573,"en":"The massed Chinese and Kongurbay,"},{"id":"semetey-1-2013:p0766:b003:l004","ordinal":135574,"en":"The people of forty khans gathered"},{"id":"semetey-1-2013:p0766:b003:l005","ordinal":135575,"en":"And caught up behind them."},{"id":"semetey-1-2013:p0766:b003:l006","ordinal":135576,"en":"A great and terrible slaughter"},{"id":"semetey-1-2013:p0766:b003:l007","ordinal":135577,"en":"Was then taking place."},{"id":"semetey-1-2013:p0766:b003:l008","ordinal":135578,"en":"Against Almambet and Syrgak,"},{"id":"semetey-1-2013:p0766:b003:l009","ordinal":135579,"en":"All the unbelieving people surged,"},{"id":"semetey-1-2013:p0766:b003:l010","ordinal":135580,"en":"About to wreak havoc,"},{"id":"semetey-1-2013:p0766:b003:l011","ordinal":135581,"en":"Almambet and Syrgak—"},{"id":"semetey-1-2013:p0766:b003:l012","ordinal":135582,"en":"About to bind and take them alive."},{"id":"semetey-1-2013:p0766:b003:l013","ordinal":135583,"en":"The lion Manas, the fierce hero,"},{"id":"semetey-1-2013:p0766:b003:l014","ordinal":135584,"en":"Among the teeming Chinese and Kalmyks"},{"id":"semetey-1-2013:p0766:b003:l015","ordinal":135585,"en":"Threw himself into the fray."},{"id":"semetey-1-2013:p0766:b003:l016","ordinal":135586,"en":"Drenched in bloody gore,"},{"id":"semetey-1-2013:p0766:b003:l017","ordinal":135587,"en":"They fought on without fleeing;"},{"id":"semetey-1-2013:p0766:b003:l018","ordinal":135588,"en":"A great slaughter took place."},{"id":"semetey-1-2013:p0766:b003:l019","ordinal":135589,"en":"Your father Manas, the generous lion,"},{"id":"semetey-1-2013:p0766:b003:l020","ordinal":135590,"en":"That guileless, hapless hero,"},{"id":"semetey-1-2013:p0766:b003:l021","ordinal":135591,"en":"His wineskin-like nose flaring,"},{"id":"semetey-1-2013:p0766:b003:l022","ordinal":135592,"en":"Loomed forward upon Aibanboz."},{"id":"semetey-1-2013:p0766:b003:l023","ordinal":135593,"en":"Aibanboz beneath him,"},{"id":"semetey-1-2013:p0766:b003:l024","ordinal":135594,"en":"That beast fit for slaughter, that year"},{"id":"semetey-1-2013:p0766:b003:l025","ordinal":135595,"en":"Had reached his forty-fourth year."},{"id":"semetey-1-2013:p0766:b003:l026","ordinal":135596,"en":"The place where they were fighting,"},{"id":"semetey-1-2013:p0766:b003:l027","ordinal":135597,"en":"That desert forty days across—"},{"id":"semetey-1-2013:p0766:b003:l028","ordinal":135598,"en":"Your leopard father Manas"},{"id":"semetey-1-2013:p0766:b003:l029","ordinal":135599,"en":"Was locked in destruction there."},{"id":"semetey-1-2013:p0766:b003:l030","ordinal":135600,"en":"They called it the desert of It-Baspas;"},{"id":"semetey-1-2013:p0766:b003:l031","ordinal":135601,"en":"Any mortal caught there"},{"id":"semetey-1-2013:p0766:b003:l032","ordinal":135602,"en":"Had to think of death."},{"id":"semetey-1-2013:p0766:b003:l033","ordinal":135603,"en":"When a swan flew there, its ears"},{"id":"semetey-1-2013:p0766:b003:l034","ordinal":135604,"en":"Were burned by that place."},{"id":"semetey-1-2013:p0766:b003:l035","ordinal":135605,"en":"When a wild ass passed, its hooves"},{"id":"semetey-1-2013:p0766:b003:l036","ordinal":135606,"en":"Were burned by that desert."},{"id":"semetey-1-2013:p0766:b003:l037","ordinal":135607,"en":"There was not a pinch of grass to eat;"},{"id":"semetey-1-2013:p0766:b003:l038","ordinal":135608,"en":"Not a drop of water on the ground."},{"id":"semetey-1-2013:p0766:b003:l039","ordinal":135609,"en":"Day and night in that place,"},{"id":"semetey-1-2013:p0766:b004:l001","ordinal":135610,"en":"They fought with mounting fury,"},{"id":"semetey-1-2013:p0766:b004:l002","ordinal":135611,"en":"Drenched in bright red blood,"},{"id":"semetey-1-2013:p0766:b004:l003","ordinal":135612,"en":"Battling long without respite."},{"id":"semetey-1-2013:p0766:b004:l004","ordinal":135613,"en":"While the slaughter raged,"},{"id":"semetey-1-2013:p0766:b004:l005","ordinal":135614,"en":"Kongurbay, the skilled judge,"},{"id":"semetey-1-2013:p0766:b004:l006","ordinal":135615,"en":"Knew Aibanboz would cease to move,"},{"id":"semetey-1-2013:p0766:b004:l007","ordinal":135616,"en":"And hero Kalcha knew it plainly."},{"id":"semetey-1-2013:p0766:b004:l008","ordinal":135617,"en":"Khan Manas's Aibanboz,"},{"id":"semetey-1-2013:p0766:b004:l009","ordinal":135618,"en":"His long ears flapping,"},{"id":"semetey-1-2013:p0766:b004:l010","ordinal":135619,"en":"When he had gone six days without water,"},{"id":"semetey-1-2013:p0766:b004:l011","ordinal":135620,"en":"It seems we will die a foul death,"},{"id":"semetey-1-2013:p0766:b004:l012","ordinal":135621,"en":"Would not move, though he struggled."},{"id":"semetey-1-2013:p0766:b004:l013","ordinal":135622,"en":"If pulled uphill, Aibanboz,"},{"id":"semetey-1-2013:p0766:b004:l014","ordinal":135623,"en":"His bowels and belly jolted."},{"id":"semetey-1-2013:p0766:b004:l015","ordinal":135624,"en":"If pulled downhill, that pig's"},{"id":"semetey-1-2013:p0766:b004:l016","ordinal":135625,"en":"Pit-like groin rumbled."},{"id":"semetey-1-2013:p0766:b004:l017","ordinal":135626,"en":"In such a state, Aibanboz,"},{"id":"semetey-1-2013:p0766:b004:l018","ordinal":135627,"en":"When he would no longer move,"},{"id":"semetey-1-2013:p0766:b004:l019","ordinal":135628,"en":"Six thousand Chinese and countless officials,"},{"id":"semetey-1-2013:p0766:b004:l020","ordinal":135629,"en":"Kongurbay their elder,"},{"id":"semetey-1-2013:p0766:b004:l021","ordinal":135630,"en":"And beside Kongurbay,"},{"id":"semetey-1-2013:p0766:b004:l022","ordinal":135631,"en":"Skilled spearmen,"},{"id":"semetey-1-2013:p0766:b004:l023","ordinal":135632,"en":"And mighty wielders of battle-axes,"},{"id":"semetey-1-2013:p0766:b004:l024","ordinal":135633,"en":"With bead plumes and coral stones,"},{"id":"semetey-1-2013:p0766:b004:l025","ordinal":135634,"en":"Their chief ruler mingled among them,"},{"id":"semetey-1-2013:p0766:b004:l026","ordinal":135635,"en":"His armored arm-guards spreading wide."},{"id":"semetey-1-2013:p0766:b004:l027","ordinal":135636,"en":"All their officials were there;"},{"id":"semetey-1-2013:p0766:b004:l028","ordinal":135637,"en":"Their resourceful Khan Kalcha was there."},{"id":"semetey-1-2013:p0766:b004:l029","ordinal":135638,"en":"Then they charged in fiercely"},{"id":"semetey-1-2013:p0766:b004:l030","ordinal":135639,"en":"At the outstanding hero, fierce Manas."},{"id":"semetey-1-2013:p0766:b004:l031","ordinal":135640,"en":"“My men in iron-cord mail,"},{"id":"semetey-1-2013:p0766:b004:l032","ordinal":135641,"en":"All my dagger-handed warriors,"},{"id":"semetey-1-2013:p0766:b004:l033","ordinal":135642,"en":"The hero Manas is a mighty man,"},{"id":"semetey-1-2013:p0766:b004:l034","ordinal":135643,"en":"A lion of extraordinary strength."},{"id":"semetey-1-2013:p0766:b004:l035","ordinal":135644,"en":"Let us capture him alive,"},{"id":"semetey-1-2013:p0766:b004:l036","ordinal":135645,"en":"To the Old Khan of Beijing"},{"id":"semetey-1-2013:p0766:b004:l037","ordinal":135646,"en":"Let us take him as a gift."},{"id":"semetey-1-2013:p0766:b004:l038","ordinal":135647,"en":"For the treasury's forty whores,"},{"id":"semetey-1-2013:p0766:b004:l039","ordinal":135648,"en":"Let us go and make him a stallion."},{"id":"semetey-1-2013:p0767:b003:l001","ordinal":135649,"en":"If a male child is born from him,"},{"id":"semetey-1-2013:p0767:b003:l002","ordinal":135650,"en":"Without shame or wounded pride,"},{"id":"semetey-1-2013:p0767:b003:l003","ordinal":135651,"en":"Let us put a golden crown upon him,"},{"id":"semetey-1-2013:p0767:b003:l004","ordinal":135652,"en":"Seat him on a golden throne,"},{"id":"semetey-1-2013:p0767:b003:l005","ordinal":135653,"en":"And raise him up as khan.”"},{"id":"semetey-1-2013:p0767:b003:l006","ordinal":135654,"en":"Khan Kongurbay said this,"},{"id":"semetey-1-2013:p0767:b003:l007","ordinal":135655,"en":"And the massed Chinese, the khagan's people,"},{"id":"semetey-1-2013:p0767:b003:l008","ordinal":135656,"en":"Surged in and thrust their spears."},{"id":"semetey-1-2013:p0767:b003:l009","ordinal":135657,"en":"Khan Kongurbay and Ylama"},{"id":"semetey-1-2013:p0767:b003:l010","ordinal":135658,"en":"Went in without sparing their lives."},{"id":"semetey-1-2013:p0767:b003:l011","ordinal":135659,"en":"Even if seventy spears struck at once,"},{"id":"semetey-1-2013:p0767:b003:l012","ordinal":135660,"en":"Its sleeves did not wear through."},{"id":"semetey-1-2013:p0767:b003:l013","ordinal":135661,"en":"Even if sixty spears struck at once,"},{"id":"semetey-1-2013:p0767:b003:l014","ordinal":135662,"en":"Its weft did not wear through."},{"id":"semetey-1-2013:p0767:b003:l015","ordinal":135663,"en":"Your leopard father Manas—"},{"id":"semetey-1-2013:p0767:b003:l016","ordinal":135664,"en":"Akolpok, which he chose to wear,"},{"id":"semetey-1-2013:p0767:b003:l017","ordinal":135665,"en":"Bulletproof when he entered combat,"},{"id":"semetey-1-2013:p0767:b003:l018","ordinal":135666,"en":"Akolpok, which he cherished—"},{"id":"semetey-1-2013:p0767:b003:l019","ordinal":135667,"en":"We kept it deliberately,"},{"id":"semetey-1-2013:p0767:b003:l020","ordinal":135668,"en":"So my dear orphan might wear it."},{"id":"semetey-1-2013:p0767:b003:l021","ordinal":135669,"en":"I kept it in trust;"},{"id":"semetey-1-2013:p0767:b003:l022","ordinal":135670,"en":"Know this service I have done."},{"id":"semetey-1-2013:p0767:b003:l023","ordinal":135671,"en":"Saying, “My uncles gave me a gift,”"},{"id":"semetey-1-2013:p0767:b003:l024","ordinal":135672,"en":"Wear it away, my dear orphan."},{"id":"semetey-1-2013:p0767:b003:l025","ordinal":135673,"en":"Your father the khan's Akkelte—"},{"id":"semetey-1-2013:p0767:b003:l026","ordinal":135674,"en":"Let me tell you its story."},{"id":"semetey-1-2013:p0767:b003:l027","ordinal":135675,"en":"Of supremely keen iron, apple-headed,"},{"id":"semetey-1-2013:p0767:b003:l028","ordinal":135676,"en":"It makes no distinction between far and near."},{"id":"semetey-1-2013:p0767:b003:l029","ordinal":135677,"en":"A support left by your father,"},{"id":"semetey-1-2013:p0767:b003:l030","ordinal":135678,"en":"It is property for you to shoot."},{"id":"semetey-1-2013:p0767:b003:l031","ordinal":135679,"en":"Your Akkelte is ready; take it away."},{"id":"semetey-1-2013:p0767:b003:l032","ordinal":135680,"en":"And now, my only one, hear my words."}]
