[{"id":"semetey-1-2013:p0737:b005:l003","ordinal":133377,"en":"Elder sister, now go back."},{"id":"semetey-1-2013:p0737:b005:l004","ordinal":133378,"en":"‘Semetey has promised to come,’"},{"id":"semetey-1-2013:p0737:b005:l005","ordinal":133379,"en":"Go and tell my khan-brother-in-law."},{"id":"semetey-1-2013:p0737:b005:l006","ordinal":133380,"en":"Acting as a wife, elder sister,"},{"id":"semetey-1-2013:p0737:b005:l007","ordinal":133381,"en":"Do not turn back to me."},{"id":"semetey-1-2013:p0737:b005:l008","ordinal":133382,"en":"Go out of my sight."},{"id":"semetey-1-2013:p0737:b005:l009","ordinal":133383,"en":"When I go to my kin,"},{"id":"semetey-1-2013:p0737:b005:l010","ordinal":133384,"en":"If you come before my eyes,"},{"id":"semetey-1-2013:p0737:b005:l011","ordinal":133385,"en":"My precious sister, you will die;"},{"id":"semetey-1-2013:p0737:b005:l012","ordinal":133386,"en":"You will face Judgment."},{"id":"semetey-1-2013:p0737:b005:l013","ordinal":133387,"en":"If you appear before me again,"},{"id":"semetey-1-2013:p0737:b005:l014","ordinal":133388,"en":"Sister, I will slaughter you."},{"id":"semetey-1-2013:p0737:b005:l015","ordinal":133389,"en":"Beside Manas, gone to the other world,"},{"id":"semetey-1-2013:p0737:b005:l016","ordinal":133390,"en":"I will lay you foot to foot with him."},{"id":"semetey-1-2013:p0737:b005:l017","ordinal":133391,"en":"I will slaughter and eat Telkurong, then leave."},{"id":"semetey-1-2013:p0737:b005:l018","ordinal":133392,"en":"To both my mothers,"},{"id":"semetey-1-2013:p0737:b005:l019","ordinal":133393,"en":"‘My sister Kardigach has died,’ I will say and leave."},{"id":"semetey-1-2013:p0737:b005:l020","ordinal":133394,"en":"Farewell then, sister,” he said."},{"id":"semetey-1-2013:p0737:b005:l021","ordinal":133395,"en":"They shook hands;"},{"id":"semetey-1-2013:p0737:b005:l022","ordinal":133396,"en":"Holding his hand, she wept bitterly."},{"id":"semetey-1-2013:p0737:b005:l023","ordinal":133397,"en":"Old Bakai, the spiritual protector, wept;"},{"id":"semetey-1-2013:p0737:b005:l024","ordinal":133398,"en":"On that dreadful day the grieving one wept again."},{"id":"semetey-1-2013:p0737:b005:l025","ordinal":133399,"en":"Speaking her lament as she strode,"},{"id":"semetey-1-2013:p0737:b005:l026","ordinal":133400,"en":"To Almighty God,"},{"id":"semetey-1-2013:p0737:b005:l027","ordinal":133401,"en":"The orphan found only at death's door,"},{"id":"semetey-1-2013:p0737:b005:l028","ordinal":133402,"en":"She entrusted as a sacred charge."},{"id":"semetey-1-2013:p0737:b005:l029","ordinal":133403,"en":"With her dark-brown horse,"},{"id":"semetey-1-2013:p0737:b005:l030","ordinal":133404,"en":"With her black battle coat,"},{"id":"semetey-1-2013:p0737:b005:l031","ordinal":133405,"en":"Parting from Semetey,"},{"id":"semetey-1-2013:p0737:b005:l032","ordinal":133406,"en":"Kardigach turned and rode away."},{"id":"semetey-1-2013:p0737:b005:l033","ordinal":133407,"en":"Through deep depressions,"},{"id":"semetey-1-2013:p0737:b005:l034","ordinal":133408,"en":"Kardigach rode along the hollow."},{"id":"semetey-1-2013:p0737:b005:l035","ordinal":133409,"en":"Her heart sorely troubled,"},{"id":"semetey-1-2013:p0737:b005:l036","ordinal":133410,"en":"Tears streaming from her eyes,"},{"id":"semetey-1-2013:p0737:b005:l037","ordinal":133411,"en":"‘The only child left by Manas—"},{"id":"semetey-1-2013:p0737:b005:l038","ordinal":133412,"en":"What will those six scoundrels do to him?’ she said."},{"id":"semetey-1-2013:p0737:b005:l039","ordinal":133413,"en":"She seems to suspect evil,"},{"id":"semetey-1-2013:p0738:b003:l001","ordinal":133414,"en":"Kardygach roamed the mountains."},{"id":"semetey-1-2013:p0738:b003:l002","ordinal":133415,"en":"Then Kardygach,"},{"id":"semetey-1-2013:p0738:b003:l003","ordinal":133416,"en":"Keeping out of Semetey's sight,"},{"id":"semetey-1-2013:p0738:b003:l004","ordinal":133417,"en":"The Telkurong beneath her"},{"id":"semetey-1-2013:p0738:b003:l005","ordinal":133418,"en":"Whipped on either side,"},{"id":"semetey-1-2013:p0738:b003:l006","ordinal":133419,"en":"Spurring this way and that,"},{"id":"semetey-1-2013:p0738:b003:l007","ordinal":133420,"en":"Through the land she knew,"},{"id":"semetey-1-2013:p0738:b003:l008","ordinal":133421,"en":"Along springs and streams in valleys,"},{"id":"semetey-1-2013:p0738:b003:l009","ordinal":133422,"en":"Keeping watch and scouting the road,"},{"id":"semetey-1-2013:p0738:b003:l010","ordinal":133423,"en":"Tracing tracks in anger,"},{"id":"semetey-1-2013:p0738:b003:l011","ordinal":133424,"en":"“Abyke, Kobosh, the six villains"},{"id":"semetey-1-2013:p0738:b003:l012","ordinal":133425,"en":"Will seize my orphan,” she thought."},{"id":"semetey-1-2013:p0738:b003:l013","ordinal":133426,"en":"“Some great dog may suddenly"},{"id":"semetey-1-2013:p0738:b004:l001","ordinal":133427,"en":"Make him vanish,” she thought."},{"id":"semetey-1-2013:p0738:b004:l002","ordinal":133428,"en":"“If they chance upon the orphan,"},{"id":"semetey-1-2013:p0738:b004:l003","ordinal":133429,"en":"Against those accursed, rootless kinsmen,"},{"id":"semetey-1-2013:p0738:b004:l004","ordinal":133430,"en":"I shall plunge straight in and level my spear."},{"id":"semetey-1-2013:p0738:b004:l005","ordinal":133431,"en":"Only when I have wiped them all out"},{"id":"semetey-1-2013:p0738:b004:l006","ordinal":133432,"en":"Shall I rest,” she thought."},{"id":"semetey-1-2013:p0738:b004:l007","ordinal":133433,"en":"Watching toward the field of battle,"},{"id":"semetey-1-2013:p0738:b004:l008","ordinal":133434,"en":"Until Semetey should turn back,"},{"id":"semetey-1-2013:p0738:b004:l009","ordinal":133435,"en":"Kardygach kept lookout."},{"id":"semetey-1-2013:p0738:b004:l010","ordinal":133436,"en":"Kardygach's deeds,"},{"id":"semetey-1-2013:p0738:b004:l011","ordinal":133437,"en":"Let us leave here;"},{"id":"semetey-1-2013:p0738:b004:l012","ordinal":133438,"en":"Of Bakai and Semetey,"},{"id":"semetey-1-2013:p0738:b004:l013","ordinal":133439,"en":"Let us begin the account."},{"id":"semetey-1-2013:p0738:b006:l001","ordinal":133440,"en":"Your aged uncle Bakai,"},{"id":"semetey-1-2013:p0738:b006:l002","ordinal":133441,"en":"Who teaches what is unknown,"},{"id":"semetey-1-2013:p0738:b006:l003","ordinal":133442,"en":"Is the learned one himself."},{"id":"semetey-1-2013:p0738:b006:l004","ordinal":133443,"en":"Who makes the unperceived perceived,"},{"id":"semetey-1-2013:p0738:b006:l005","ordinal":133444,"en":"Is the hawk's very dark-eyed presence."},{"id":"semetey-1-2013:p0738:b006:l006","ordinal":133445,"en":"Your uncle Bakai the Leopard,"},{"id":"semetey-1-2013:p0738:b006:l007","ordinal":133446,"en":"Without lingering, traveled on,"},{"id":"semetey-1-2013:p0738:b006:l008","ordinal":133447,"en":"Not sparing his horse, he went far."},{"id":"semetey-1-2013:p0738:b006:l009","ordinal":133448,"en":"“Kok-Zhaiyk at the head of Urbus,"},{"id":"semetey-1-2013:p0738:b006:l010","ordinal":133449,"en":"Of vile Abyke and Kobosh,"},{"id":"semetey-1-2013:p0738:b006:l011","ordinal":133450,"en":"That is the place they took for shelter."},{"id":"semetey-1-2013:p0738:b006:l012","ordinal":133451,"en":"The one who chased and scattered them all,"},{"id":"semetey-1-2013:p0738:b006:l013","ordinal":133452,"en":"I am that scourge, Bakai."},{"id":"semetey-1-2013:p0738:b006:l014","ordinal":133453,"en":"Unable to withstand my gunfire,"},{"id":"semetey-1-2013:p0738:b006:l015","ordinal":133454,"en":"Those are the people I fought with guns."},{"id":"semetey-1-2013:p0738:b006:l016","ordinal":133455,"en":"Lying on either bank,"},{"id":"semetey-1-2013:p0738:b006:l017","ordinal":133456,"en":"I, Bakai, with those dogs"},{"id":"semetey-1-2013:p0738:b006:l018","ordinal":133457,"en":"Traded shots for twelve years."},{"id":"semetey-1-2013:p0738:b006:l019","ordinal":133458,"en":"Wreaking devastation, I grew hardened."},{"id":"semetey-1-2013:p0738:b006:l020","ordinal":133459,"en":"Of Abyke's marksmen,"},{"id":"semetey-1-2013:p0738:b006:l021","ordinal":133460,"en":"I killed sixty,"},{"id":"semetey-1-2013:p0738:b007:l001","ordinal":133461,"en":"And earned the name Bloody-Neck."},{"id":"semetey-1-2013:p0738:b007:l002","ordinal":133462,"en":"Inflicting suffering as I went,"},{"id":"semetey-1-2013:p0738:b007:l003","ordinal":133463,"en":"Where was my prosperity?"},{"id":"semetey-1-2013:p0738:b007:l004","ordinal":133464,"en":"Left alone, apart from my people,"},{"id":"semetey-1-2013:p0738:b007:l005","ordinal":133465,"en":"I earned a bad name."},{"id":"semetey-1-2013:p0738:b007:l006","ordinal":133466,"en":"Listen carefully once again,"},{"id":"semetey-1-2013:p0738:b007:l007","ordinal":133467,"en":"My beloved fortress."},{"id":"semetey-1-2013:p0738:b007:l008","ordinal":133468,"en":"The forty warriors left by your father Manas—"},{"id":"semetey-1-2013:p0738:b007:l009","ordinal":133469,"en":"If you ask about them now,"},{"id":"semetey-1-2013:p0738:b007:l010","ordinal":133470,"en":"Those wicked-minded dogs and swine,"},{"id":"semetey-1-2013:p0738:b007:l011","ordinal":133471,"en":"All those rough-tempered unbelievers,"},{"id":"semetey-1-2013:p0738:b007:l012","ordinal":133472,"en":"Pressing claims in many places,"},{"id":"semetey-1-2013:p0738:b007:l013","ordinal":133473,"en":"Fighting enemies in many places,"},{"id":"semetey-1-2013:p0738:b007:l014","ordinal":133474,"en":"Those unbelievers became seasoned."},{"id":"semetey-1-2013:p0738:b007:l015","ordinal":133475,"en":"Killing heroes, cutting off heads,"},{"id":"semetey-1-2013:p0738:b007:l016","ordinal":133476,"en":"While your heroic father Manas lived,"},{"id":"semetey-1-2013:p0738:b007:l017","ordinal":133477,"en":"Those unbelievers became skilled."},{"id":"semetey-1-2013:p0738:b007:l018","ordinal":133478,"en":"Killing one-humped camels in many places,"},{"id":"semetey-1-2013:p0738:b007:l019","ordinal":133479,"en":"Those unbelievers became dependent."},{"id":"semetey-1-2013:p0738:b007:l020","ordinal":133480,"en":"Killing heroes in many places,"},{"id":"semetey-1-2013:p0738:b007:l021","ordinal":133481,"en":"Those unbelievers became dependent."},{"id":"semetey-1-2013:p0739:b003:l001","ordinal":133482,"en":"Among the finest spearmen,"},{"id":"semetey-1-2013:p0739:b003:l002","ordinal":133483,"en":"There are skilled warriors too."},{"id":"semetey-1-2013:p0739:b003:l003","ordinal":133484,"en":"With wisdom like lakes and rivers,"},{"id":"semetey-1-2013:p0739:b003:l004","ordinal":133485,"en":"There are excellent warriors too."},{"id":"semetey-1-2013:p0739:b003:l005","ordinal":133486,"en":"Striking blindly across, rash in temper,"},{"id":"semetey-1-2013:p0739:b003:l006","ordinal":133487,"en":"There are blind warriors too."},{"id":"semetey-1-2013:p0739:b003:l007","ordinal":133488,"en":"With no wisdom in their breasts,"},{"id":"semetey-1-2013:p0739:b003:l008","ordinal":133489,"en":"There are blind warriors too."},{"id":"semetey-1-2013:p0739:b003:l009","ordinal":133490,"en":"Fighting when too much is said,"},{"id":"semetey-1-2013:p0739:b003:l010","ordinal":133491,"en":"There are hot-tempered warriors too."},{"id":"semetey-1-2013:p0739:b003:l011","ordinal":133492,"en":"With no sense in their heads,"},{"id":"semetey-1-2013:p0739:b003:l012","ordinal":133493,"en":"There are rude warriors too."},{"id":"semetey-1-2013:p0739:b003:l013","ordinal":133494,"en":"Going wherever they are driven,"},{"id":"semetey-1-2013:p0739:b003:l014","ordinal":133495,"en":"There are calf-like warriors too."},{"id":"semetey-1-2013:p0739:b003:l015","ordinal":133496,"en":"Loving their lives, tending only themselves,"},{"id":"semetey-1-2013:p0739:b003:l016","ordinal":133497,"en":"There are cowardly warriors too."},{"id":"semetey-1-2013:p0739:b003:l017","ordinal":133498,"en":"Without strength to squeeze a louse,"},{"id":"semetey-1-2013:p0739:b003:l018","ordinal":133499,"en":"Unable to do a hair's worth with their hands,"},{"id":"semetey-1-2013:p0739:b003:l019","ordinal":133500,"en":"There are babbling warriors too."},{"id":"semetey-1-2013:p0739:b003:l020","ordinal":133501,"en":"Tall of stature, straight of build,"},{"id":"semetey-1-2013:p0739:b003:l021","ordinal":133502,"en":"There are imposing warriors too."},{"id":"semetey-1-2013:p0739:b003:l022","ordinal":133503,"en":"Able to lift a camel,"},{"id":"semetey-1-2013:p0739:b003:l023","ordinal":133504,"en":"There are mighty wrestlers too."},{"id":"semetey-1-2013:p0739:b003:l024","ordinal":133505,"en":"Offering endless flattery,"},{"id":"semetey-1-2013:p0739:b003:l025","ordinal":133506,"en":"There are fawning warriors too."},{"id":"semetey-1-2013:p0739:b003:l026","ordinal":133507,"en":"Big-lunged and blustering,"},{"id":"semetey-1-2013:p0739:b003:l027","ordinal":133508,"en":"There are puffed-up warriors too."},{"id":"semetey-1-2013:p0739:b003:l028","ordinal":133509,"en":"Their own good fortune in the chest"},{"id":"semetey-1-2013:p0739:b003:l029","ordinal":133510,"en":"There are warriors who kick away."},{"id":"semetey-1-2013:p0739:b003:l030","ordinal":133511,"en":"Broad-jawed, broad-tongued,"},{"id":"semetey-1-2013:p0739:b003:l031","ordinal":133512,"en":"Unerring, outstanding men,"},{"id":"semetey-1-2013:p0739:b003:l032","ordinal":133513,"en":"There are eloquent warriors too."},{"id":"semetey-1-2013:p0739:b003:l033","ordinal":133514,"en":"Sharpening their dark tongues,"},{"id":"semetey-1-2013:p0739:b003:l034","ordinal":133515,"en":"Singing before the khan,"},{"id":"semetey-1-2013:p0739:b003:l035","ordinal":133516,"en":"There are excellent warriors too."},{"id":"semetey-1-2013:p0739:b003:l036","ordinal":133517,"en":"Soft-hearted, pure in intention,"},{"id":"semetey-1-2013:p0739:b003:l037","ordinal":133518,"en":"There are outstanding warriors too."},{"id":"semetey-1-2013:p0739:b003:l038","ordinal":133519,"en":"Remaining true to Manas's salt,"},{"id":"semetey-1-2013:p0739:b003:l039","ordinal":133520,"en":"There are warriors who will stay too."},{"id":"semetey-1-2013:p0739:b005:l001","ordinal":133521,"en":"Out of nowhere, upheaval"},{"id":"semetey-1-2013:p0739:b005:l002","ordinal":133522,"en":"There are warriors who will unleash."},{"id":"semetey-1-2013:p0739:b005:l003","ordinal":133523,"en":"My dear child, gained from death,"},{"id":"semetey-1-2013:p0739:b005:l004","ordinal":133524,"en":"Your five fingers are not equal."},{"id":"semetey-1-2013:p0739:b005:l005","ordinal":133525,"en":"Vile Abyke and Kobosh"},{"id":"semetey-1-2013:p0739:b005:l006","ordinal":133526,"en":"Are not men to be trusted."},{"id":"semetey-1-2013:p0739:b005:l007","ordinal":133527,"en":"Now, my orphan,"},{"id":"semetey-1-2013:p0739:b005:l008","ordinal":133528,"en":"The finest of the forty warriors,"},{"id":"semetey-1-2013:p0739:b005:l009","ordinal":133529,"en":"Their shaman who strikes with lungs,"},{"id":"semetey-1-2013:p0739:b005:l010","ordinal":133530,"en":"The best at finding arguments,"},{"id":"semetey-1-2013:p0739:b005:l011","ordinal":133531,"en":"The leader of the forty, Kyrgylchal,"},{"id":"semetey-1-2013:p0739:b005:l012","ordinal":133532,"en":"That mad old man, swollen with pride among the forty,"},{"id":"semetey-1-2013:p0739:b005:l013","ordinal":133533,"en":"In winter's bitterest forty-day cold,"},{"id":"semetey-1-2013:p0739:b005:l014","ordinal":133534,"en":"Made his old wife rise forty times."},{"id":"semetey-1-2013:p0739:b005:l015","ordinal":133535,"en":"An old lecher, potent forty times,"},{"id":"semetey-1-2013:p0739:b005:l016","ordinal":133536,"en":"Laughing outside, vile within,"},{"id":"semetey-1-2013:p0739:b005:l017","ordinal":133537,"en":"He has eyes that see differently;"},{"id":"semetey-1-2013:p0739:b005:l018","ordinal":133538,"en":"He has strange, various words."},{"id":"semetey-1-2013:p0739:b005:l019","ordinal":133539,"en":"From among the forty warriors,"},{"id":"semetey-1-2013:p0739:b005:l020","ordinal":133540,"en":"Swine Kyrgylchal will not disappear."},{"id":"semetey-1-2013:p0739:b005:l021","ordinal":133541,"en":"Until swine Kyrgylchal disappears,"},{"id":"semetey-1-2013:p0739:b005:l022","ordinal":133542,"en":"The warriors' affairs will not improve."},{"id":"semetey-1-2013:p0739:b005:l023","ordinal":133543,"en":"Kyrgyl, leader of the forty,"},{"id":"semetey-1-2013:p0739:b005:l024","ordinal":133544,"en":"That damned Kyrgyl,"},{"id":"semetey-1-2013:p0739:b005:l025","ordinal":133545,"en":"Has wrought mischief."},{"id":"semetey-1-2013:p0739:b005:l026","ordinal":133546,"en":"To your wolf-maned father Manas"},{"id":"semetey-1-2013:p0739:b005:l027","ordinal":133547,"en":"He caused much trouble."},{"id":"semetey-1-2013:p0739:b005:l028","ordinal":133548,"en":"Here is Tazbaimat of wicked conduct."},{"id":"semetey-1-2013:p0739:b005:l029","ordinal":133549,"en":"These two united,"},{"id":"semetey-1-2013:p0739:b005:l030","ordinal":133550,"en":"Speaking words that ruin a people,"},{"id":"semetey-1-2013:p0739:b005:l031","ordinal":133551,"en":"Speaking of a time of death,"},{"id":"semetey-1-2013:p0739:b005:l032","ordinal":133552,"en":"Dogging every step,"},{"id":"semetey-1-2013:p0739:b005:l033","ordinal":133553,"en":"Your mother Kanykei"},{"id":"semetey-1-2013:p0739:b005:l034","ordinal":133554,"en":"They slandered before the six villains."},{"id":"semetey-1-2013:p0739:b005:l035","ordinal":133555,"en":"They had the whole scheme worked out;"},{"id":"semetey-1-2013:p0739:b005:l036","ordinal":133556,"en":"To Temirkan's city,"},{"id":"semetey-1-2013:p0739:b005:l037","ordinal":133557,"en":"That dog drove her wandering."},{"id":"semetey-1-2013:p0739:b005:l038","ordinal":133558,"en":"To Karakan's city,"},{"id":"semetey-1-2013:p0739:b005:l039","ordinal":133559,"en":"That dog drove her in flight."},{"id":"semetey-1-2013:p0740:b003:l001","ordinal":133560,"en":"My beloved orphan,"},{"id":"semetey-1-2013:p0740:b003:l002","ordinal":133561,"en":"The strongest of the six villains,"},{"id":"semetey-1-2013:p0740:b003:l003","ordinal":133562,"en":"Dog Kobosh, they made khan."},{"id":"semetey-1-2013:p0740:b003:l004","ordinal":133563,"en":"They destroyed whoever opposed them;"},{"id":"semetey-1-2013:p0740:b003:l005","ordinal":133564,"en":"Now they camp along the ravine."},{"id":"semetey-1-2013:p0740:b003:l006","ordinal":133565,"en":"All the forty warriors"},{"id":"semetey-1-2013:p0740:b003:l007","ordinal":133566,"en":"Have grown ravenous as dogs."},{"id":"semetey-1-2013:p0740:b003:l008","ordinal":133567,"en":"My beloved orphan,"},{"id":"semetey-1-2013:p0740:b003:l009","ordinal":133568,"en":"Take heed of these words of mine."},{"id":"semetey-1-2013:p0740:b003:l010","ordinal":133569,"en":"Do not fail to listen when I tell all,"},{"id":"semetey-1-2013:p0740:b003:l011","ordinal":133570,"en":"And ruin my efforts."},{"id":"semetey-1-2013:p0740:b003:l012","ordinal":133571,"en":"Your uncle, Lord Bakai's—"},{"id":"semetey-1-2013:p0740:b003:l013","ordinal":133572,"en":"Listen well to my words,"},{"id":"semetey-1-2013:p0740:b003:l014","ordinal":133573,"en":"My high-browed shelter,"},{"id":"semetey-1-2013:p0740:b003:l015","ordinal":133574,"en":"My shelter left by Manas."},{"id":"semetey-1-2013:p0740:b003:l016","ordinal":133575,"en":"Common iron is not sharp,"},{"id":"semetey-1-2013:p0740:b003:l017","ordinal":133576,"en":"Son, dogs raised elsewhere are no people of ours."},{"id":"semetey-1-2013:p0740:b003:l018","ordinal":133577,"en":"Iron pieced together will not become sharp,"},{"id":"semetey-1-2013:p0740:b003:l019","ordinal":133578,"en":"Dogs raised as slaves will not become our people."},{"id":"semetey-1-2013:p0740:b003:l020","ordinal":133579,"en":"The cloud across the blue sky,"},{"id":"semetey-1-2013:p0740:b003:l021","ordinal":133580,"en":"Once risen high, will not disperse."},{"id":"semetey-1-2013:p0740:b003:l022","ordinal":133581,"en":"The six villains, kin of the same father,"},{"id":"semetey-1-2013:p0740:b003:l023","ordinal":133582,"en":"It seems will not settle in one camp with us."},{"id":"semetey-1-2013:p0740:b003:l024","ordinal":133583,"en":"All that silk and white cloth,"},{"id":"semetey-1-2013:p0740:b003:l025","ordinal":133584,"en":"No color fades and changes."},{"id":"semetey-1-2013:p0740:b003:l026","ordinal":133585,"en":"The six fools called kinsmen"},{"id":"semetey-1-2013:p0740:b003:l027","ordinal":133586,"en":"Show no sign of bringing prosperity."},{"id":"semetey-1-2013:p0740:b003:l028","ordinal":133587,"en":"A dark peak, a great jutting crag,"},{"id":"semetey-1-2013:p0740:b003:l029","ordinal":133588,"en":"However long it stands, will not become a hollow."},{"id":"semetey-1-2013:p0740:b003:l030","ordinal":133589,"en":"The kin you seek out willingly"},{"id":"semetey-1-2013:p0740:b003:l031","ordinal":133590,"en":"Will not value you and leave you unharmed."},{"id":"semetey-1-2013:p0740:b003:l032","ordinal":133591,"en":"The kin you seek out willingly"},{"id":"semetey-1-2013:p0740:b003:l033","ordinal":133592,"en":"Are no dogs who will know your worth."},{"id":"semetey-1-2013:p0740:b003:l034","ordinal":133593,"en":"Without grieving you,"},{"id":"semetey-1-2013:p0740:b003:l035","ordinal":133594,"en":"They are not people who will receive you."},{"id":"semetey-1-2013:p0740:b003:l036","ordinal":133595,"en":"How often have I told you before, orphan:"},{"id":"semetey-1-2013:p0740:b003:l037","ordinal":133596,"en":"This valley is no land for us;"},{"id":"semetey-1-2013:p0740:b003:l038","ordinal":133597,"en":"These six are no people of ours."},{"id":"semetey-1-2013:p0740:b003:l039","ordinal":133598,"en":"My spring of a river through the valley,"},{"id":"semetey-1-2013:p0740:b004:l001","ordinal":133599,"en":"My light, gained from death,"},{"id":"semetey-1-2013:p0740:b004:l002","ordinal":133600,"en":"The kin who cut off heads,"},{"id":"semetey-1-2013:p0740:b004:l003","ordinal":133601,"en":"We have come to see—do you understand?"},{"id":"semetey-1-2013:p0740:b004:l004","ordinal":133602,"en":"If we act clumsily, without care,"},{"id":"semetey-1-2013:p0740:b004:l005","ordinal":133603,"en":"We have come to die—do you understand?"},{"id":"semetey-1-2013:p0740:b004:l006","ordinal":133604,"en":"Your forty warriors left by your father,"},{"id":"semetey-1-2013:p0740:b004:l007","ordinal":133605,"en":"Let us learn where they are."},{"id":"semetey-1-2013:p0740:b004:l008","ordinal":133606,"en":"If they are not with the villains,"},{"id":"semetey-1-2013:p0740:b004:l009","ordinal":133607,"en":"Then let us go in.”"},{"id":"semetey-1-2013:p0740:b004:l010","ordinal":133608,"en":"So said Khan Bakai,"},{"id":"semetey-1-2013:p0740:b004:l011","ordinal":133609,"en":"Urging Kokcholok onward."},{"id":"semetey-1-2013:p0740:b004:l012","ordinal":133610,"en":"Your wolf-maned Bakai the Leopard"},{"id":"semetey-1-2013:p0740:b004:l013","ordinal":133611,"en":"Pressed toward the forty warriors."},{"id":"semetey-1-2013:p0740:b004:l014","ordinal":133612,"en":"Watching the hilly ground,"},{"id":"semetey-1-2013:p0740:b004:l015","ordinal":133613,"en":"Hiding behind hillocks, Khan Bakai,"},{"id":"semetey-1-2013:p0740:b004:l016","ordinal":133614,"en":"That noble hero, so experienced,"},{"id":"semetey-1-2013:p0740:b004:l017","ordinal":133615,"en":"Scouted and searched the land,"},{"id":"semetey-1-2013:p0740:b004:l018","ordinal":133616,"en":"Working his wisdom, pondering his thoughts."},{"id":"semetey-1-2013:p0740:b004:l019","ordinal":133617,"en":"The wise elder Bakai,"},{"id":"semetey-1-2013:p0740:b004:l020","ordinal":133618,"en":"Experienced in every task,"},{"id":"semetey-1-2013:p0740:b004:l021","ordinal":133619,"en":"A saint born clear-sighted,"},{"id":"semetey-1-2013:p0740:b004:l022","ordinal":133620,"en":"However many difficult tasks arose,"},{"id":"semetey-1-2013:p0740:b004:l023","ordinal":133621,"en":"Bakai found the way through."},{"id":"semetey-1-2013:p0740:b004:l024","ordinal":133622,"en":"In a quarrel that brought devastation,"},{"id":"semetey-1-2013:p0740:b004:l025","ordinal":133623,"en":"Bakai found the fitting words."},{"id":"semetey-1-2013:p0740:b004:l026","ordinal":133624,"en":"The stubborn one who grew obstinate,"},{"id":"semetey-1-2013:p0740:b004:l027","ordinal":133625,"en":"He knew how to force him to comply."},{"id":"semetey-1-2013:p0740:b004:l028","ordinal":133626,"en":"The fool who would not heed much advice,"},{"id":"semetey-1-2013:p0740:b004:l029","ordinal":133627,"en":"He knew how to handle him."},{"id":"semetey-1-2013:p0740:b004:l030","ordinal":133628,"en":"Your uncle Bakai brought good fortune;"},{"id":"semetey-1-2013:p0740:b004:l031","ordinal":133629,"en":"He was a lion rich in wisdom."},{"id":"semetey-1-2013:p0740:b004:l032","ordinal":133630,"en":"To see the forty warriors,"},{"id":"semetey-1-2013:p0740:b004:l033","ordinal":133631,"en":"To someone close at heart,"},{"id":"semetey-1-2013:p0740:b004:l034","ordinal":133632,"en":"To show himself and return,"}]
