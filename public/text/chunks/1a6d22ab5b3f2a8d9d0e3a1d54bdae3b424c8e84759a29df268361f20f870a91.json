[{"id":"semetey-1-2013:p1217:b003:l032","ordinal":169985,"en":"Saying, “They have acted thus"},{"id":"semetey-1-2013:p1217:b003:l033","ordinal":169986,"en":"Toward noble Prince Manas,”"},{"id":"semetey-1-2013:p1217:b003:l034","ordinal":169987,"en":"The palm-sized Muslims"},{"id":"semetey-1-2013:p1217:b003:l035","ordinal":169988,"en":"Themselves remained—did you see?"},{"id":"semetey-1-2013:p1217:b003:l036","ordinal":169989,"en":"“Will we not all reach the root together?!”"},{"id":"semetey-1-2013:p1217:b003:l037","ordinal":169990,"en":"The Muslims murmured;"},{"id":"semetey-1-2013:p1217:b003:l038","ordinal":169991,"en":"Before China could destroy them,"},{"id":"semetey-1-2013:p1217:b003:l039","ordinal":169992,"en":"Manas himself would slaughter"},{"id":"semetey-1-2013:p1217:b005:l001","ordinal":169993,"en":"The palm-sized people of Islam."},{"id":"semetey-1-2013:p1217:b005:l002","ordinal":169994,"en":"The accursed bloodthirsty man's"},{"id":"semetey-1-2013:p1217:b005:l003","ordinal":169995,"en":"Command lived in his words,"},{"id":"semetey-1-2013:p1217:b005:l004","ordinal":169996,"en":"And stubbornness lived in his eyes."},{"id":"semetey-1-2013:p1217:b005:l005","ordinal":169997,"en":"This accursed bloodthirsty man,"},{"id":"semetey-1-2013:p1217:b005:l006","ordinal":169998,"en":"Quarreling with China,"},{"id":"semetey-1-2013:p1217:b005:l007","ordinal":169999,"en":"Speaks many such words;"},{"id":"semetey-1-2013:p1217:b005:l008","ordinal":170000,"en":"If you live, wait and see—"},{"id":"semetey-1-2013:p1217:b005:l009","ordinal":170001,"en":"The palm-sized Muslims,"},{"id":"semetey-1-2013:p1217:b005:l010","ordinal":170002,"en":"He will destroy them himself."},{"id":"semetey-1-2013:p1217:b005:l011","ordinal":170003,"en":"Will he heed the words of the weak?"},{"id":"semetey-1-2013:p1217:b005:l012","ordinal":170004,"en":"Will a river-flood engulf us,"},{"id":"semetey-1-2013:p1217:b005:l013","ordinal":170005,"en":"And many souls die?"},{"id":"semetey-1-2013:p1217:b005:l014","ordinal":170006,"en":"It is a surging flood;"},{"id":"semetey-1-2013:p1217:b005:l015","ordinal":170007,"en":"The Chinese people are mountain-like."},{"id":"semetey-1-2013:p1217:b005:l016","ordinal":170008,"en":"If a mountain falls, will it spare us?"},{"id":"semetey-1-2013:p1217:b005:l017","ordinal":170009,"en":"Can one who attacks"},{"id":"semetey-1-2013:p1217:b005:l018","ordinal":170010,"en":"The teeming infidels survive?"},{"id":"semetey-1-2013:p1217:b005:l019","ordinal":170011,"en":"If you suddenly grapple them,"},{"id":"semetey-1-2013:p1217:b005:l020","ordinal":170012,"en":"If we suddenly attack,"},{"id":"semetey-1-2013:p1217:b005:l021","ordinal":170013,"en":"Will they not bring calamity?"},{"id":"semetey-1-2013:p1217:b005:l022","ordinal":170014,"en":"Will we not all reach our root together?"},{"id":"semetey-1-2013:p1217:b005:l023","ordinal":170015,"en":"If we match strength with the infidels,"},{"id":"semetey-1-2013:p1217:b005:l024","ordinal":170016,"en":"Will they not bind alive"},{"id":"semetey-1-2013:p1217:b005:l025","ordinal":170017,"en":"Every one of the whole people?"},{"id":"semetey-1-2013:p1217:b005:l026","ordinal":170018,"en":"From Jylgynduu, Keng-Kol, and Talas,"},{"id":"semetey-1-2013:p1217:b005:l027","ordinal":170019,"en":"We are fated to suffer humiliation"},{"id":"semetey-1-2013:p1217:b005:l028","ordinal":170020,"en":"Because of ill-starred Manas."},{"id":"semetey-1-2013:p1217:b005:l029","ordinal":170021,"en":"This is his hardened habit;"},{"id":"semetey-1-2013:p1217:b005:l030","ordinal":170022,"en":"Your grim bloodthirsty man"},{"id":"semetey-1-2013:p1217:b005:l031","ordinal":170023,"en":"Would drive everyone into China—"},{"id":"semetey-1-2013:p1217:b005:l032","ordinal":170024,"en":"Such is his way of bringing slaughter."},{"id":"semetey-1-2013:p1217:b005:l033","ordinal":170025,"en":"May the incorrigible wretch never prosper;"},{"id":"semetey-1-2013:p1217:b005:l034","ordinal":170026,"en":"He remains bellowing."},{"id":"semetey-1-2013:p1217:b005:l035","ordinal":170027,"en":"If we merely watch, upon the whole age"},{"id":"semetey-1-2013:p1217:b005:l036","ordinal":170028,"en":"He will unleash utter turmoil."},{"id":"semetey-1-2013:p1217:b005:l037","ordinal":170029,"en":"Let us go to the accursed man;"},{"id":"semetey-1-2013:p1217:b005:l038","ordinal":170030,"en":"Saying, ‘My horse is thin,’"},{"id":"semetey-1-2013:p1217:b005:l039","ordinal":170031,"en":"Let us lodge our complaint."},{"id":"semetey-1-2013:p1218:b003:l001","ordinal":170032,"en":"To the open-hearted bloodthirsty man,"},{"id":"semetey-1-2013:p1218:b003:l002","ordinal":170033,"en":"Saying, ‘My horse is feeble,’"},{"id":"semetey-1-2013:p1218:b003:l003","ordinal":170034,"en":"Saying, ‘I myself am alone,’"},{"id":"semetey-1-2013:p1218:b003:l004","ordinal":170035,"en":"Let us make a jest of it."},{"id":"semetey-1-2013:p1218:b003:l005","ordinal":170036,"en":"If the bloodthirsty man can be reasoned with,"},{"id":"semetey-1-2013:p1218:b003:l006","ordinal":170037,"en":"Let us scatter the food and provisions,"},{"id":"semetey-1-2013:p1218:b003:l007","ordinal":170038,"en":"Mount our horses,"},{"id":"semetey-1-2013:p1218:b003:l008","ordinal":170039,"en":"And flee in every direction."},{"id":"semetey-1-2013:p1218:b003:l009","ordinal":170040,"en":"Why should we test ourselves"},{"id":"semetey-1-2013:p1218:b003:l010","ordinal":170041,"en":"Against the teeming Chinese?"},{"id":"semetey-1-2013:p1218:b003:l011","ordinal":170042,"en":"If Khan Manas brings them hell,"},{"id":"semetey-1-2013:p1218:b003:l012","ordinal":170043,"en":"Let us wait and then depart.”"},{"id":"semetey-1-2013:p1218:b003:l013","ordinal":170044,"en":"With elder Koshoy as their leader,"},{"id":"semetey-1-2013:p1218:b003:l014","ordinal":170045,"en":"All the Muslims then"},{"id":"semetey-1-2013:p1218:b003:l015","ordinal":170046,"en":"Voiced their grievance."},{"id":"semetey-1-2013:p1218:b003:l016","ordinal":170047,"en":"“If we fight during the feast,"},{"id":"semetey-1-2013:p1218:b003:l017","ordinal":170048,"en":"It will be a disgrace upon us."},{"id":"semetey-1-2013:p1218:b003:l018","ordinal":170049,"en":"This is no time fit for combat,"},{"id":"semetey-1-2013:p1218:b003:l019","ordinal":170050,"en":"No hour for waging war.”"},{"id":"semetey-1-2013:p1218:b003:l020","ordinal":170051,"en":"They wept before Khan Manas"},{"id":"semetey-1-2013:p1218:b003:l021","ordinal":170052,"en":"And cried out their grievance."},{"id":"semetey-1-2013:p1218:b003:l022","ordinal":170053,"en":"One bloodthirsty man said"},{"id":"semetey-1-2013:p1218:b003:l023","ordinal":170054,"en":"That his horses were thin;"},{"id":"semetey-1-2013:p1218:b003:l024","ordinal":170055,"en":"Another said"},{"id":"semetey-1-2013:p1218:b003:l025","ordinal":170056,"en":"That he himself was alone."},{"id":"semetey-1-2013:p1218:b003:l026","ordinal":170057,"en":"Another spoke,"},{"id":"semetey-1-2013:p1218:b003:l027","ordinal":170058,"en":"Saying his father was old."},{"id":"semetey-1-2013:p1218:b003:l028","ordinal":170059,"en":"Raging and shouting,"},{"id":"semetey-1-2013:p1218:b003:l029","ordinal":170060,"en":"He began the great turmoil."},{"id":"semetey-1-2013:p1218:b003:l030","ordinal":170061,"en":"Khan Manas then"},{"id":"semetey-1-2013:p1218:b003:l031","ordinal":170062,"en":"Slaughtered and left"},{"id":"semetey-1-2013:p1218:b003:l032","ordinal":170063,"en":"All the assembled people."},{"id":"semetey-1-2013:p1218:b003:l033","ordinal":170064,"en":"“Curse your father's graves, wretched people;"},{"id":"semetey-1-2013:p1218:b003:l034","ordinal":170065,"en":"Do not say, ‘My horse is thin,’"},{"id":"semetey-1-2013:p1218:b003:l035","ordinal":170066,"en":"And eat shame on account of your horse."},{"id":"semetey-1-2013:p1218:b003:l036","ordinal":170067,"en":"Whoever says, ‘My horse is thin,’"},{"id":"semetey-1-2013:p1218:b003:l037","ordinal":170068,"en":"I shall slaughter and eat his horse now."},{"id":"semetey-1-2013:p1218:b003:l038","ordinal":170069,"en":"Whoever says, ‘I myself am alone,’"},{"id":"semetey-1-2013:p1218:b003:l039","ordinal":170070,"en":"I shall slaughter him now."},{"id":"semetey-1-2013:p1218:b004:l001","ordinal":170071,"en":"Akkula's prize—"},{"id":"semetey-1-2013:p1218:b004:l002","ordinal":170072,"en":"How can I fail to take it?"},{"id":"semetey-1-2013:p1218:b004:l003","ordinal":170073,"en":"How can I fail to bring"},{"id":"semetey-1-2013:p1218:b004:l004","ordinal":170074,"en":"One slaughter upon China?"},{"id":"semetey-1-2013:p1218:b004:l005","ordinal":170075,"en":"His anger rising, he shouted;"},{"id":"semetey-1-2013:p1218:b004:l006","ordinal":170076,"en":"Some he confined,"},{"id":"semetey-1-2013:p1218:b004:l007","ordinal":170077,"en":"Some he beat,"},{"id":"semetey-1-2013:p1218:b004:l008","ordinal":170078,"en":"Some he cursed,"},{"id":"semetey-1-2013:p1218:b004:l009","ordinal":170079,"en":"And some he ordered onward."},{"id":"semetey-1-2013:p1218:b004:l010","ordinal":170080,"en":"All the Muslims,"},{"id":"semetey-1-2013:p1218:b004:l011","ordinal":170081,"en":"Unable to posture in resentment,"},{"id":"semetey-1-2013:p1218:b004:l012","ordinal":170082,"en":"Said, “Is it not Manas"},{"id":"semetey-1-2013:p1218:b004:l013","ordinal":170083,"en":"Who will slaughter every Muslim,"},{"id":"semetey-1-2013:p1218:b004:l014","ordinal":170084,"en":"Who will do to us"},{"id":"semetey-1-2013:p1218:b004:l015","ordinal":170085,"en":"Whatever he himself wishes,"},{"id":"semetey-1-2013:p1218:b004:l016","ordinal":170086,"en":"Who will somehow reach"},{"id":"semetey-1-2013:p1218:b004:l017","ordinal":170087,"en":"Your very root!”"},{"id":"semetey-1-2013:p1218:b004:l018","ordinal":170088,"en":"The great black Muslim people"},{"id":"semetey-1-2013:p1218:b004:l019","ordinal":170089,"en":"Wept and spoke from the heart."},{"id":"semetey-1-2013:p1218:b004:l020","ordinal":170090,"en":"As they stood exactly thus,"},{"id":"semetey-1-2013:p1218:b004:l021","ordinal":170091,"en":"Your fortunate lion Manas,"},{"id":"semetey-1-2013:p1218:b004:l022","ordinal":170092,"en":"Against the teeming infidel,"},{"id":"semetey-1-2013:p1218:b004:l023","ordinal":170093,"en":"Against hero Khan Kongurbai,"},{"id":"semetey-1-2013:p1218:b004:l024","ordinal":170094,"en":"Girded the jekene at his waist;"},{"id":"semetey-1-2013:p1218:b004:l025","ordinal":170095,"en":"Against the infidels bending the earth,"},{"id":"semetey-1-2013:p1218:b004:l026","ordinal":170096,"en":"Manas attacked alone."},{"id":"semetey-1-2013:p1218:b004:l027","ordinal":170097,"en":"Raging, he shouted,"},{"id":"semetey-1-2013:p1218:b004:l028","ordinal":170098,"en":"Calling out to Kongurbai:"},{"id":"semetey-1-2013:p1218:b004:l029","ordinal":170099,"en":"“Chinese people of forty khans,"},{"id":"semetey-1-2013:p1218:b004:l030","ordinal":170100,"en":"You have come from your farthest bounds;"},{"id":"semetey-1-2013:p1218:b004:l031","ordinal":170101,"en":"I have given you abundant food."},{"id":"semetey-1-2013:p1218:b004:l032","ordinal":170102,"en":"The host of ninety black infidels—"},{"id":"semetey-1-2013:p1218:b004:l033","ordinal":170103,"en":"You came without breaking formation;"},{"id":"semetey-1-2013:p1218:b004:l034","ordinal":170104,"en":"The countless slaughter animals,"},{"id":"semetey-1-2013:p1218:b004:l035","ordinal":170105,"en":"I gave in a mountain-like heap."},{"id":"semetey-1-2013:p1218:b004:l036","ordinal":170106,"en":"I gave red gold and livestock;"},{"id":"semetey-1-2013:p1218:b004:l037","ordinal":170107,"en":"I gave red-tailed camels."},{"id":"semetey-1-2013:p1218:b004:l038","ordinal":170108,"en":"Black Chinese and many Manchus—"},{"id":"semetey-1-2013:p1218:b004:l039","ordinal":170109,"en":"Akkula's prize—"},{"id":"semetey-1-2013:p1219:b003:l001","ordinal":170110,"en":"Do not take it away; leave it here."},{"id":"semetey-1-2013:p1219:b003:l002","ordinal":170111,"en":"You are no fool capable of taking it,"},{"id":"semetey-1-2013:p1219:b003:l003","ordinal":170112,"en":"And I am no Manas who would let it be taken!"},{"id":"semetey-1-2013:p1219:b003:l004","ordinal":170113,"en":"Three times I unleashed a great slaughter."},{"id":"semetey-1-2013:p1219:b003:l005","ordinal":170114,"en":"On the plain of Ükürchü,"},{"id":"semetey-1-2013:p1219:b003:l006","ordinal":170115,"en":"Along Üch-Kapkak,"},{"id":"semetey-1-2013:p1219:b003:l007","ordinal":170116,"en":"I raided and took three of your settlements."},{"id":"semetey-1-2013:p1219:b003:l008","ordinal":170117,"en":"It was not merely your horses, my Kalmyk;"},{"id":"semetey-1-2013:p1219:b003:l009","ordinal":170118,"en":"I seized your herds as well."},{"id":"semetey-1-2013:p1219:b003:l010","ordinal":170119,"en":"When I sacked your three cities,"},{"id":"semetey-1-2013:p1219:b003:l011","ordinal":170120,"en":"When I raided and took your monks,"},{"id":"semetey-1-2013:p1219:b003:l012","ordinal":170121,"en":"I cut off"},{"id":"semetey-1-2013:p1219:b003:l013","ordinal":170122,"en":"Your monks' topknots entirely."},{"id":"semetey-1-2013:p1219:b003:l014","ordinal":170123,"en":"I took a letter written in Chinese;"},{"id":"semetey-1-2013:p1219:b003:l015","ordinal":170124,"en":"I gelded your monk and made him a mount."},{"id":"semetey-1-2013:p1219:b003:l016","ordinal":170125,"en":"I brought a ruinous time upon you!"},{"id":"semetey-1-2013:p1219:b003:l017","ordinal":170126,"en":"I dug your grave deep;"},{"id":"semetey-1-2013:p1219:b003:l018","ordinal":170127,"en":"I hewed your road backward;"},{"id":"semetey-1-2013:p1219:b003:l019","ordinal":170128,"en":"I did wonders indeed!"},{"id":"semetey-1-2013:p1219:b003:l020","ordinal":170129,"en":"I traced many strange paths for you;"},{"id":"semetey-1-2013:p1219:b003:l021","ordinal":170130,"en":"I burned and destroyed five of your cities."},{"id":"semetey-1-2013:p1219:b003:l022","ordinal":170131,"en":"I brought great humiliation upon you;"},{"id":"semetey-1-2013:p1219:b003:l023","ordinal":170132,"en":"Five of your daughters with forelocks"},{"id":"semetey-1-2013:p1219:b003:l024","ordinal":170133,"en":"I took as booty."},{"id":"semetey-1-2013:p1219:b003:l025","ordinal":170134,"en":"Have you now become a man?"},{"id":"semetey-1-2013:p1219:b003:l026","ordinal":170135,"en":"Have you mounted a horse, looming there?"},{"id":"semetey-1-2013:p1219:b003:l027","ordinal":170136,"en":"Yesterday, after traveling seven years on foot,"},{"id":"semetey-1-2013:p1219:b003:l028","ordinal":170137,"en":"Above Jet-Kayt,"},{"id":"semetey-1-2013:p1219:b003:l029","ordinal":170138,"en":"I destroyed seven of your cities at once."},{"id":"semetey-1-2013:p1219:b003:l030","ordinal":170139,"en":"I plundered much of your treasure;"},{"id":"semetey-1-2013:p1219:b003:l031","ordinal":170140,"en":"I stirred up much destructive turmoil."},{"id":"semetey-1-2013:p1219:b003:l032","ordinal":170141,"en":"Eating seven batmans of wheat,"},{"id":"semetey-1-2013:p1219:b003:l033","ordinal":170142,"en":"You reek of grain, Joloy;"},{"id":"semetey-1-2013:p1219:b003:l034","ordinal":170143,"en":"Having killed seventy giants,"},{"id":"semetey-1-2013:p1219:b003:l035","ordinal":170144,"en":"You reek of blood, Joloy."},{"id":"semetey-1-2013:p1219:b003:l036","ordinal":170145,"en":"Eating sixty batmans of wheat,"},{"id":"semetey-1-2013:p1219:b003:l037","ordinal":170146,"en":"You reek of grain, Joloy;"},{"id":"semetey-1-2013:p1219:b003:l038","ordinal":170147,"en":"Having killed sixty giants,"},{"id":"semetey-1-2013:p1219:b003:l039","ordinal":170148,"en":"You reek of blood, Joloy."},{"id":"semetey-1-2013:p1219:b005:l001","ordinal":170149,"en":"Akkula's prize—"},{"id":"semetey-1-2013:p1219:b005:l002","ordinal":170150,"en":"Do not take it away; leave it here!"},{"id":"semetey-1-2013:p1219:b005:l003","ordinal":170151,"en":"I am no Manas who will let it be taken;"},{"id":"semetey-1-2013:p1219:b005:l004","ordinal":170152,"en":"You are no Joloy who can take it!"},{"id":"semetey-1-2013:p1219:b005:l005","ordinal":170153,"en":"Because of this prize,"},{"id":"semetey-1-2013:p1219:b005:l006","ordinal":170154,"en":"I shall be steeped in bloody blood."},{"id":"semetey-1-2013:p1219:b005:l007","ordinal":170155,"en":"My sprawling Black Kalmyk,"},{"id":"semetey-1-2013:p1219:b005:l008","ordinal":170156,"en":"I shall fight for six months without fleeing."},{"id":"semetey-1-2013:p1219:b005:l009","ordinal":170157,"en":"I shall divide your seven cities;"},{"id":"semetey-1-2013:p1219:b005:l010","ordinal":170158,"en":"I shall pursue you to the end and die fighting."},{"id":"semetey-1-2013:p1219:b005:l011","ordinal":170159,"en":"Tell of your red spear and its sheath;"},{"id":"semetey-1-2013:p1219:b005:l012","ordinal":170160,"en":"Fucking Chinese, tell the truth!”"},{"id":"semetey-1-2013:p1219:b005:l013","ordinal":170161,"en":"With a battle cry, Manas"},{"id":"semetey-1-2013:p1219:b005:l014","ordinal":170162,"en":"Reached Khan Joloy."},{"id":"semetey-1-2013:p1219:b005:l015","ordinal":170163,"en":"He seized his black-bladed whip"},{"id":"semetey-1-2013:p1219:b005:l016","ordinal":170164,"en":"And swung it around;"},{"id":"semetey-1-2013:p1219:b005:l017","ordinal":170165,"en":"Charging at Joloy,"},{"id":"semetey-1-2013:p1219:b005:l018","ordinal":170166,"en":"He struck him across the jaw."},{"id":"semetey-1-2013:p1219:b005:l019","ordinal":170167,"en":"His black malakay hat"},{"id":"semetey-1-2013:p1219:b005:l020","ordinal":170168,"en":"Flew shrieking into the sky."},{"id":"semetey-1-2013:p1219:b005:l021","ordinal":170169,"en":"When Manas attacked,"},{"id":"semetey-1-2013:p1219:b005:l022","ordinal":170170,"en":"Everyone now attacked."},{"id":"semetey-1-2013:p1219:b005:l023","ordinal":170171,"en":"The sovereign old Bakai"},{"id":"semetey-1-2013:p1219:b005:l024","ordinal":170172,"en":"Chased and scattered the infidels,"},{"id":"semetey-1-2013:p1219:b005:l025","ordinal":170173,"en":"Who swarmed like black worms."},{"id":"semetey-1-2013:p1219:b005:l026","ordinal":170174,"en":"Poor Joloy ran,"},{"id":"semetey-1-2013:p1219:b005:l027","ordinal":170175,"en":"Taking refuge among his Kalmyks,"},{"id":"semetey-1-2013:p1219:b005:l028","ordinal":170176,"en":"Blood streaming from his jaw."},{"id":"semetey-1-2013:p1219:b005:l029","ordinal":170177,"en":"A bruise as large as a horse's head rose;"},{"id":"semetey-1-2013:p1219:b005:l030","ordinal":170178,"en":"He barely bound his jaw with a scarf."},{"id":"semetey-1-2013:p1219:b005:l031","ordinal":170179,"en":"A bruise as large as a yurt rose;"},{"id":"semetey-1-2013:p1219:b005:l032","ordinal":170180,"en":"Groaning, he bound his jaw with a scarf."},{"id":"semetey-1-2013:p1219:b005:l033","ordinal":170181,"en":"The strongest of the jacketed Chinese"},{"id":"semetey-1-2013:p1219:b005:l034","ordinal":170182,"en":"Asked him what had happened:"},{"id":"semetey-1-2013:p1219:b005:l035","ordinal":170183,"en":"“Warrior leopard of the Chinese,"},{"id":"semetey-1-2013:p1219:b005:l036","ordinal":170184,"en":"What happened to your jaw?” they asked."},{"id":"semetey-1-2013:p1219:b005:l037","ordinal":170185,"en":"“His father Kyrgyz, his mother Sart,"},{"id":"semetey-1-2013:p1219:b005:l038","ordinal":170186,"en":"The slave Manas who resembles an Argyn,"},{"id":"semetey-1-2013:p1219:b005:l039","ordinal":170187,"en":"Who gnaws frozen apples—"},{"id":"semetey-1-2013:p1220:b003:l001","ordinal":170188,"en":"That bastard born of foul urine,"},{"id":"semetey-1-2013:p1220:b003:l002","ordinal":170189,"en":"That shrieking Burut—"},{"id":"semetey-1-2013:p1220:b003:l003","ordinal":170190,"en":"It seems his way struck me;"},{"id":"semetey-1-2013:p1220:b003:l004","ordinal":170191,"en":"It seems the hand"},{"id":"semetey-1-2013:p1220:b003:l005","ordinal":170192,"en":"Of screeching Manas struck me."},{"id":"semetey-1-2013:p1220:b003:l006","ordinal":170193,"en":"Those squealing Buruts—"},{"id":"semetey-1-2013:p1220:b003:l007","ordinal":170194,"en":"It seems their road reached me;"},{"id":"semetey-1-2013:p1220:b003:l008","ordinal":170195,"en":"It seems the hand"},{"id":"semetey-1-2013:p1220:b003:l009","ordinal":170196,"en":"Of shrieking Manas reached me.”"},{"id":"semetey-1-2013:p1220:b003:l010","ordinal":170197,"en":"Before Joloy could close his mouth,"},{"id":"semetey-1-2013:p1220:b003:l011","ordinal":170198,"en":"Hero Manas carved through"},{"id":"semetey-1-2013:p1220:b003:l012","ordinal":170199,"en":"Their center."},{"id":"semetey-1-2013:p1220:b003:l013","ordinal":170200,"en":"Almambet cut his way"},{"id":"semetey-1-2013:p1220:b003:l014","ordinal":170201,"en":"Around their flanks."},{"id":"semetey-1-2013:p1220:b003:l015","ordinal":170202,"en":"Hero Chubak hemmed in"},{"id":"semetey-1-2013:p1220:b003:l016","ordinal":170203,"en":"Their very center."},{"id":"semetey-1-2013:p1220:b003:l017","ordinal":170204,"en":"Khan Bakai raided"},{"id":"semetey-1-2013:p1220:b003:l018","ordinal":170205,"en":"One of their wings."},{"id":"semetey-1-2013:p1220:b003:l019","ordinal":170206,"en":"Hero Syrgak crushed"},{"id":"semetey-1-2013:p1220:b003:l020","ordinal":170207,"en":"Their outermost edge."},{"id":"semetey-1-2013:p1220:b003:l021","ordinal":170208,"en":"Agybay pierced"},{"id":"semetey-1-2013:p1220:b003:l022","ordinal":170209,"en":"One of their flanks."},{"id":"semetey-1-2013:p1220:b003:l023","ordinal":170210,"en":"Hero Kyrgylchal drove through"},{"id":"semetey-1-2013:p1220:b003:l024","ordinal":170211,"en":"The side by their throats."},{"id":"semetey-1-2013:p1220:b003:l025","ordinal":170212,"en":"Hero Shuutu laid waste"},{"id":"semetey-1-2013:p1220:b003:l026","ordinal":170213,"en":"One of their wings."},{"id":"semetey-1-2013:p1220:b003:l027","ordinal":170214,"en":"Raising the gray-mottled banner,"},{"id":"semetey-1-2013:p1220:b003:l028","ordinal":170215,"en":"The Chinese raised a wailing clamor."},{"id":"semetey-1-2013:p1220:b003:l029","ordinal":170216,"en":"Though it was said they would drive them off with blows,"},{"id":"semetey-1-2013:p1220:b003:l030","ordinal":170217,"en":"They slaughtered them as they drove them;"},{"id":"semetey-1-2013:p1220:b003:l031","ordinal":170218,"en":"Almambet, son of Aziz Khan,"},{"id":"semetey-1-2013:p1220:b003:l032","ordinal":170219,"en":"Unleashed extraordinary turmoil."},{"id":"semetey-1-2013:p1220:b003:l033","ordinal":170220,"en":"Khan Manas's forty companions—"},{"id":"semetey-1-2013:p1220:b003:l034","ordinal":170221,"en":"Told to take a cap, they took a head;"},{"id":"semetey-1-2013:p1220:b003:l035","ordinal":170222,"en":"Told to spill blood, they spilled demons;"},{"id":"semetey-1-2013:p1220:b003:l036","ordinal":170223,"en":"Told to drink water, they drank poison."},{"id":"semetey-1-2013:p1220:b003:l037","ordinal":170224,"en":"They unleashed a wondrous massacre;"},{"id":"semetey-1-2013:p1220:b003:l038","ordinal":170225,"en":"Every Chinese upon the plain"},{"id":"semetey-1-2013:p1220:b003:l039","ordinal":170226,"en":"Lay sprawled dead."},{"id":"semetey-1-2013:p1220:b004:l001","ordinal":170227,"en":"They unleashed the great slaughter."},{"id":"semetey-1-2013:p1220:b004:l002","ordinal":170228,"en":"They captured horses"},{"id":"semetey-1-2013:p1220:b004:l003","ordinal":170229,"en":"Worth a thousand times the prize."},{"id":"semetey-1-2013:p1220:b004:l004","ordinal":170230,"en":"Those who advanced to the front"},{"id":"semetey-1-2013:p1220:b004:l005","ordinal":170231,"en":"Each took seven thousand captured horses;"},{"id":"semetey-1-2013:p1220:b004:l006","ordinal":170232,"en":"The meek who could not reach them"},{"id":"semetey-1-2013:p1220:b004:l007","ordinal":170233,"en":"Each took seven hundred horses."},{"id":"semetey-1-2013:p1220:b004:l008","ordinal":170234,"en":"The crust of the earth was torn open;"},{"id":"semetey-1-2013:p1220:b004:l009","ordinal":170235,"en":"The Muslims went away"},{"id":"semetey-1-2013:p1220:b004:l010","ordinal":170236,"en":"Sated with prizes."},{"id":"semetey-1-2013:p1220:b004:l011","ordinal":170237,"en":"Standing face to face,"},{"id":"semetey-1-2013:p1220:b004:l012","ordinal":170238,"en":"Firing guns and drawing bows,"},{"id":"semetey-1-2013:p1220:b004:l013","ordinal":170239,"en":"They fought without fleeing."},{"id":"semetey-1-2013:p1220:b004:l014","ordinal":170240,"en":"Seven banners brought from Mecca"}]
