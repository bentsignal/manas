[{"id":"semetey-1-2013:p0758:b003:l014","ordinal":134401,"en":"Made us endure such hell,"},{"id":"semetey-1-2013:p0758:b003:l015","ordinal":134402,"en":"Had the butcher slaughter goats;"},{"id":"semetey-1-2013:p0758:b003:l016","ordinal":134403,"en":"He meant to make us suffer.’"},{"id":"semetey-1-2013:p0758:b003:l017","ordinal":134404,"en":"From time to time, growing violent,"},{"id":"semetey-1-2013:p0758:b003:l018","ordinal":134405,"en":"A khan like Kobosh arises;"},{"id":"semetey-1-2013:p0758:b003:l019","ordinal":134406,"en":"His voice drives the soul out."},{"id":"semetey-1-2013:p0758:b003:l021","ordinal":134407,"en":"Immersed in many pleasures,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0758:b003:l022","ordinal":134408,"en":"As Akylai and that Kobosh"},{"id":"semetey-1-2013:p0758:b003:l023","ordinal":134409,"en":"Lay entwined together,"},{"id":"semetey-1-2013:p0758:b003:l024","ordinal":134410,"en":"Manas's son, the orphan slave,"},{"id":"semetey-1-2013:p0758:b003:l025","ordinal":134411,"en":"Was sorely troubled in his thoughts."},{"id":"semetey-1-2013:p0758:b003:l026","ordinal":134412,"en":"The orphan who had wandered here"},{"id":"semetey-1-2013:p0758:b003:l027","ordinal":134413,"en":"Shed tears from his eyes."},{"id":"semetey-1-2013:p0758:b003:l028","ordinal":134414,"en":"As though his father had died today,"},{"id":"semetey-1-2013:p0758:b003:l029","ordinal":134415,"en":"His mind was sorely troubled."},{"id":"semetey-1-2013:p0758:b003:l030","ordinal":134416,"en":"At his pompous uncle Kobosh,"},{"id":"semetey-1-2013:p0758:b003:l031","ordinal":134417,"en":"He seemed to grow angry:"},{"id":"semetey-1-2013:p0758:b003:l032","ordinal":134418,"en":"‘Who pledged allegiance to twelve spiritual guides—"},{"id":"semetey-1-2013:p0758:b003:l033","ordinal":134419,"en":"May my holy father never die!"},{"id":"semetey-1-2013:p0758:b003:l034","ordinal":134420,"en":"May I never be left fatherless!"},{"id":"semetey-1-2013:p0758:b003:l035","ordinal":134421,"en":"Such humiliation as this—"},{"id":"semetey-1-2013:p0758:b003:l036","ordinal":134422,"en":"May no mortal be made to suffer it!’"},{"id":"semetey-1-2013:p0758:b003:l037","ordinal":134423,"en":"Steeling himself, burning within,"},{"id":"semetey-1-2013:p0758:b003:l038","ordinal":134424,"en":"The orphan could not stand watching."},{"id":"semetey-1-2013:p0758:b003:l039","ordinal":134425,"en":"The warrior born of Manas—"},{"id":"semetey-1-2013:p0758:b004:l001","ordinal":134426,"en":"Here was where he would spread havoc."},{"id":"semetey-1-2013:p0758:b004:l002","ordinal":134427,"en":"The orphan now made a stir;"},{"id":"semetey-1-2013:p0758:b004:l003","ordinal":134428,"en":"Of Manas, gone to the world to come,"},{"id":"semetey-1-2013:p0758:b004:l004","ordinal":134429,"en":"He stood demanding the possessions:"},{"id":"semetey-1-2013:p0758:b004:l005","ordinal":134430,"en":"‘Uncle Abyke, hear my words."},{"id":"semetey-1-2013:p0758:b004:l006","ordinal":134431,"en":"My father has died."},{"id":"semetey-1-2013:p0758:b004:l007","ordinal":134432,"en":"The countless riches left by my father—"},{"id":"semetey-1-2013:p0758:b004:l008","ordinal":134433,"en":"When you plundered and divided them,"},{"id":"semetey-1-2013:p0758:b004:l009","ordinal":134434,"en":"When you contrived matters thus,"},{"id":"semetey-1-2013:p0758:b004:l010","ordinal":134435,"en":"My poor widowed mother—"},{"id":"semetey-1-2013:p0758:b004:l011","ordinal":134436,"en":"When you struck and split her breast,"},{"id":"semetey-1-2013:p0758:b004:l012","ordinal":134437,"en":"To Temir Khan's city,"},{"id":"semetey-1-2013:p0758:b004:l013","ordinal":134438,"en":"When my mother went wandering,"},{"id":"semetey-1-2013:p0758:b004:l014","ordinal":134439,"en":"My dear mother Kanykei,"},{"id":"semetey-1-2013:p0758:b004:l015","ordinal":134440,"en":"When she fled toward Karakan,"},{"id":"semetey-1-2013:p0758:b004:l016","ordinal":134441,"en":"All the great wealth,"},{"id":"semetey-1-2013:p0758:b004:l017","ordinal":134442,"en":"When you ruined and scattered it,"},{"id":"semetey-1-2013:p0758:b004:l018","ordinal":134443,"en":"In those days, when you plundered the valuables,"},{"id":"semetey-1-2013:p0758:b004:l019","ordinal":134444,"en":"When the boar stirred up trouble,"},{"id":"semetey-1-2013:p0758:b004:l020","ordinal":134445,"en":"Ten days after my father died,"},{"id":"semetey-1-2013:p0758:b004:l021","ordinal":134446,"en":"Toward my unfortunate mother,"},{"id":"semetey-1-2013:p0758:b004:l022","ordinal":134447,"en":"When you became a predator,"},{"id":"semetey-1-2013:p0758:b004:l023","ordinal":134448,"en":"Every treasure, wealth and possession,"},{"id":"semetey-1-2013:p0758:b004:l024","ordinal":134449,"en":"When you took it as booty,"},{"id":"semetey-1-2013:p0758:b004:l025","ordinal":134450,"en":"While I was still in the cradle,"},{"id":"semetey-1-2013:p0758:b004:l026","ordinal":134451,"en":"My mother Chiyirdi,"},{"id":"semetey-1-2013:p0758:b004:l027","ordinal":134452,"en":"When she pulled me out and fled straight ahead,"},{"id":"semetey-1-2013:p0758:b004:l028","ordinal":134453,"en":"My cradle standing empty,"},{"id":"semetey-1-2013:p0758:b004:l029","ordinal":134454,"en":"My brave mother Kanykei,"},{"id":"semetey-1-2013:p0758:b004:l030","ordinal":134455,"en":"The slave woman's child,"},{"id":"semetey-1-2013:p0758:b004:l031","ordinal":134456,"en":"Taking him from his swaddling clothes,"},{"id":"semetey-1-2013:p0758:b004:l032","ordinal":134457,"en":"When she bound him in the cradle,"},{"id":"semetey-1-2013:p0758:b004:l033","ordinal":134458,"en":"My mother nursing him,"},{"id":"semetey-1-2013:p0758:b004:l034","ordinal":134459,"en":"When she put her breast in his mouth,"},{"id":"semetey-1-2013:p0758:b004:l035","ordinal":134460,"en":"Your shouting split stones."},{"id":"semetey-1-2013:p0758:b004:l036","ordinal":134461,"en":"Upon my wretched mother,"},{"id":"semetey-1-2013:p0758:b004:l037","ordinal":134462,"en":"When you burst in raging,"},{"id":"semetey-1-2013:p0758:b004:l038","ordinal":134463,"en":"You found just the right way!"},{"id":"semetey-1-2013:p0758:b004:l039","ordinal":134464,"en":"Striking my mother with a battle-axe—"},{"id":"semetey-1-2013:p0759:b003:l001","ordinal":134465,"en":"You struck her down, screaming."},{"id":"semetey-1-2013:p0759:b003:l004","ordinal":134466,"en":"The treasury left by Manas,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0759:b003:l005","ordinal":134467,"en":"You plundered it utterly."},{"id":"semetey-1-2013:p0759:b003:l006","ordinal":134468,"en":"Thus you did just as you pleased."},{"id":"semetey-1-2013:p0759:b003:l007","ordinal":134469,"en":"The wealth left by my father,"},{"id":"semetey-1-2013:p0759:b003:l008","ordinal":134470,"en":"You took as booty and rested content."},{"id":"semetey-1-2013:p0759:b003:l009","ordinal":134471,"en":"Until I reached twelve years of age,"},{"id":"semetey-1-2013:p0759:b003:l010","ordinal":134472,"en":"Because of you, my elder kinsmen,"},{"id":"semetey-1-2013:p0759:b003:l011","ordinal":134473,"en":"Because of your foolish deeds,"},{"id":"semetey-1-2013:p0759:b003:l012","ordinal":134474,"en":"Into Temir Khan's city"},{"id":"semetey-1-2013:p0759:b003:l013","ordinal":134475,"en":"I wandered and made a living;"},{"id":"semetey-1-2013:p0759:b003:l014","ordinal":134476,"en":"Into Kara Khan's city"},{"id":"semetey-1-2013:p0759:b003:l015","ordinal":134477,"en":"I fled and made a living."},{"id":"semetey-1-2013:p0759:b003:l016","ordinal":134478,"en":"When we wandered to Temir Khan,"},{"id":"semetey-1-2013:p0759:b003:l017","ordinal":134479,"en":"As for me, still in swaddling clothes,"},{"id":"semetey-1-2013:p0759:b003:l018","ordinal":134480,"en":"“Upon my child while he is young,"},{"id":"semetey-1-2013:p0759:b003:l019","ordinal":134481,"en":"Someone will bring suffering,” she thought."},{"id":"semetey-1-2013:p0759:b003:l020","ordinal":134482,"en":"My mother Kanykei"},{"id":"semetey-1-2013:p0759:b003:l021","ordinal":134483,"en":"She cut through my twig,"},{"id":"semetey-1-2013:p0759:b003:l023","ordinal":134484,"en":"Made me step over a dog's bowl,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0759:b003:l024","ordinal":134485,"en":"Made me step across a sword's edge."},{"id":"semetey-1-2013:p0759:b003:l025","ordinal":134486,"en":"Thus she suffered humiliation;"},{"id":"semetey-1-2013:p0759:b003:l026","ordinal":134487,"en":"She gave me to her own brother Ysmayyl."},{"id":"semetey-1-2013:p0759:b003:l027","ordinal":134488,"en":"When holy sages spread their hands,"},{"id":"semetey-1-2013:p0759:b003:l028","ordinal":134489,"en":"I knew nothing of blessings;"},{"id":"semetey-1-2013:p0759:b003:l029","ordinal":134490,"en":"Of Manas, gone to the other world,"},{"id":"semetey-1-2013:p0759:b003:l030","ordinal":134491,"en":"I knew nothing of his being my father."},{"id":"semetey-1-2013:p0759:b003:l031","ordinal":134492,"en":"A wretched soul born to such a fate,"},{"id":"semetey-1-2013:p0759:b003:l032","ordinal":134493,"en":"I grew up wandering."},{"id":"semetey-1-2013:p0759:b003:l034","ordinal":134494,"en":"Until I reached twelve,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0759:b003:l035","ordinal":134495,"en":"Temir Khan's little camel,"},{"id":"semetey-1-2013:p0759:b003:l036","ordinal":134496,"en":"Ysmayyl's son—"},{"id":"semetey-1-2013:p0759:b003:l037","ordinal":134497,"en":"That was what I was, poor soul."},{"id":"semetey-1-2013:p0759:b003:l038","ordinal":134498,"en":"When I reached twelve years of age,"},{"id":"semetey-1-2013:p0759:b003:l039","ordinal":134499,"en":"Finding no mountain to hurl myself against,"},{"id":"semetey-1-2013:p0759:b004:l001","ordinal":134500,"en":"Finding no foe to fight,"},{"id":"semetey-1-2013:p0759:b004:l002","ordinal":134501,"en":"Finding no head to wrench off,"},{"id":"semetey-1-2013:p0759:b004:l003","ordinal":134502,"en":"Finding no stone to bite,"},{"id":"semetey-1-2013:p0759:b004:l004","ordinal":134503,"en":"I locked up the wandering dervishes,"},{"id":"semetey-1-2013:p0759:b004:l005","ordinal":134504,"en":"I beat the mendicants."},{"id":"semetey-1-2013:p0759:b004:l006","ordinal":134505,"en":"If I saw a khoja, I kicked him"},{"id":"semetey-1-2013:p0759:b004:l007","ordinal":134506,"en":"And locked him in his mosque."},{"id":"semetey-1-2013:p0759:b004:l008","ordinal":134507,"en":"When they saw my wild behavior,"},{"id":"semetey-1-2013:p0759:b004:l009","ordinal":134508,"en":"All the people of Bukhara grew weary."},{"id":"semetey-1-2013:p0759:b004:l010","ordinal":134509,"en":"Temir Khan took fright;"},{"id":"semetey-1-2013:p0759:b004:l011","ordinal":134510,"en":"His mind alarmed, he pondered,"},{"id":"semetey-1-2013:p0759:b004:l012","ordinal":134511,"en":"And gathered the people of eight khans."},{"id":"semetey-1-2013:p0759:b004:l013","ordinal":134512,"en":"Then the widow Kanykei,"},{"id":"semetey-1-2013:p0759:b004:l014","ordinal":134513,"en":"In his sixtieth adult year,"},{"id":"semetey-1-2013:p0759:b004:l015","ordinal":134514,"en":"Entered Taitoru in the race."},{"id":"semetey-1-2013:p0759:b004:l016","ordinal":134515,"en":"Kanykei's Taitoru"},{"id":"semetey-1-2013:p0759:b004:l017","ordinal":134516,"en":"To the great city of Bukhara"},{"id":"semetey-1-2013:p0759:b004:l018","ordinal":134517,"en":"Came far out in front."},{"id":"semetey-1-2013:p0759:b004:l019","ordinal":134518,"en":"The many prizes in Bukhara,"},{"id":"semetey-1-2013:p0759:b004:l020","ordinal":134519,"en":"I gathered them all."},{"id":"semetey-1-2013:p0759:b004:l021","ordinal":134520,"en":"Not taking half a coin's worth of goods,"},{"id":"semetey-1-2013:p0759:b004:l022","ordinal":134521,"en":"Not taking half a penny's worth of hair,"},{"id":"semetey-1-2013:p0759:b004:l023","ordinal":134522,"en":"To all the wrestlers"},{"id":"semetey-1-2013:p0759:b004:l024","ordinal":134523,"en":"I gave them as booty."},{"id":"semetey-1-2013:p0759:b004:l025","ordinal":134524,"en":"Those watching crowded round;"},{"id":"semetey-1-2013:p0759:b004:l026","ordinal":134525,"en":"The people looked on in wonder."},{"id":"semetey-1-2013:p0759:b004:l027","ordinal":134526,"en":"When the crowd had gathered,"},{"id":"semetey-1-2013:p0759:b004:l028","ordinal":134527,"en":"Offering a thousand dark camels,"},{"id":"semetey-1-2013:p0759:b004:l029","ordinal":134528,"en":"Offering a thousand black mares with white blazes,"},{"id":"semetey-1-2013:p0759:b004:l030","ordinal":134529,"en":"Temir Khan proclaimed:"},{"id":"semetey-1-2013:p0759:b004:l031","ordinal":134530,"en":"“Let the wrestlers wrestle on foot;"},{"id":"semetey-1-2013:p0759:b004:l032","ordinal":134531,"en":"Let the loser go empty-handed!”"},{"id":"semetey-1-2013:p0759:b004:l033","ordinal":134532,"en":"Making it known to the people,"},{"id":"semetey-1-2013:p0759:b004:l034","ordinal":134533,"en":"He made his proclamation"},{"id":"semetey-1-2013:p0759:b004:l035","ordinal":134534,"en":"And gave his stern command."},{"id":"semetey-1-2013:p0759:b004:l036","ordinal":134535,"en":"From Kokand came Too-Balban;"},{"id":"semetey-1-2013:p0759:b004:l037","ordinal":134536,"en":"From Bukhara came Ak-Balban."},{"id":"semetey-1-2013:p0759:b004:l038","ordinal":134537,"en":"The champions wrestled on foot,"},{"id":"semetey-1-2013:p0759:b004:l039","ordinal":134538,"en":"Clashing like gray bulls."},{"id":"semetey-1-2013:p0760:b003:l001","ordinal":134539,"en":"Biting like stallions,"},{"id":"semetey-1-2013:p0760:b003:l002","ordinal":134540,"en":"Gnashing like hungry male camels,"},{"id":"semetey-1-2013:p0760:b003:l003","ordinal":134541,"en":"Gripping one another's trouser legs,"},{"id":"semetey-1-2013:p0760:b003:l004","ordinal":134542,"en":"Tripping each other without sparing their lives."},{"id":"semetey-1-2013:p0760:b003:l005","ordinal":134543,"en":"That Ak-Balban of Bukhara"},{"id":"semetey-1-2013:p0760:b003:l006","ordinal":134544,"en":"Grew weak;"},{"id":"semetey-1-2013:p0760:b003:l007","ordinal":134545,"en":"Too-Balban of Kokand"},{"id":"semetey-1-2013:p0760:b003:l008","ordinal":134546,"en":"Lifted him and dashed him down."},{"id":"semetey-1-2013:p0760:b003:l009","ordinal":134547,"en":"When all the many prizes of Bukhara"},{"id":"semetey-1-2013:p0760:b003:l010","ordinal":134548,"en":"He drove away,"},{"id":"semetey-1-2013:p0760:b003:l011","ordinal":134549,"en":"Wrestling with Too-Balban,"},{"id":"semetey-1-2013:p0760:b003:l012","ordinal":134550,"en":"Semetey put him to torment."},{"id":"semetey-1-2013:p0760:b003:l013","ordinal":134551,"en":"A champion such as Too-Balban"},{"id":"semetey-1-2013:p0760:b003:l014","ordinal":134552,"en":"He lifted and dashed once to the ground;"},{"id":"semetey-1-2013:p0760:b003:l015","ordinal":134553,"en":"When he tore his arm out,"},{"id":"semetey-1-2013:p0760:b003:l016","ordinal":134554,"en":"Through this, Too-Balban"},{"id":"semetey-1-2013:p0760:b003:l017","ordinal":134555,"en":"Met his death."},{"id":"semetey-1-2013:p0760:b003:l018","ordinal":134556,"en":"“He will surpass Manas,”"},{"id":"semetey-1-2013:p0760:b003:l019","ordinal":134557,"en":"All the people began to whisper."},{"id":"semetey-1-2013:p0760:b003:l021","ordinal":134558,"en":"Not content to stop at that,"},{"id":"semetey-1-2013:p0760:b003:l022","ordinal":134559,"en":"The mount beneath me"},{"id":"semetey-1-2013:p0760:b003:l023","ordinal":134560,"en":"Was Temir Khan's Aktulpar;"},{"id":"semetey-1-2013:p0760:b003:l024","ordinal":134561,"en":"What I held on my hand"},{"id":"semetey-1-2013:p0760:b003:l025","ordinal":134562,"en":"Was Ysmayyl's falcon."},{"id":"semetey-1-2013:p0760:b003:l026","ordinal":134563,"en":"I went out flying the falcon"},{"id":"semetey-1-2013:p0760:b003:l027","ordinal":134564,"en":"And heard the bald charcoal burner's words."},{"id":"semetey-1-2013:p0760:b003:l028","ordinal":134565,"en":"“Your great people are the Kyrgyz,” I heard."},{"id":"semetey-1-2013:p0760:b003:l029","ordinal":134566,"en":"“Your horse has a white blaze,"},{"id":"semetey-1-2013:p0760:b003:l030","ordinal":134567,"en":"Your father is someone else.”"},{"id":"semetey-1-2013:p0760:b003:l031","ordinal":134568,"en":"Sarytaz said a word;"},{"id":"semetey-1-2013:p0760:b003:l032","ordinal":134569,"en":"He put a troubling word into my thoughts."},{"id":"semetey-1-2013:p0760:b003:l033","ordinal":134570,"en":"I heard the words of that damned bald man:"},{"id":"semetey-1-2013:p0760:b003:l034","ordinal":134571,"en":"“My people are the Kyrgyz,” I heard."},{"id":"semetey-1-2013:p0760:b003:l035","ordinal":134572,"en":"“Manas is your father,"},{"id":"semetey-1-2013:p0760:b003:l036","ordinal":134573,"en":"Talas is your land,"},{"id":"semetey-1-2013:p0760:b003:l037","ordinal":134574,"en":"Kanykei is your mother,"},{"id":"semetey-1-2013:p0760:b003:l038","ordinal":134575,"en":"Ysmayyl is your mother's brother;"},{"id":"semetey-1-2013:p0760:b003:l039","ordinal":134576,"en":"Abyke and Kobosh in Talas are your elder kinsmen;"},{"id":"semetey-1-2013:p0760:b004:l001","ordinal":134577,"en":"Akun Khan is your father-in-law,"},{"id":"semetey-1-2013:p0760:b004:l002","ordinal":134578,"en":"Aichurok is your wife.”"},{"id":"semetey-1-2013:p0760:b004:l003","ordinal":134579,"en":"Sarytaz said a word;"},{"id":"semetey-1-2013:p0760:b004:l004","ordinal":134580,"en":"He put a troubling word into my thoughts."},{"id":"semetey-1-2013:p0760:b004:l005","ordinal":134581,"en":"I chose to mount Aktulpar;"},{"id":"semetey-1-2013:p0760:b004:l007","ordinal":134582,"en":"From far away I came of my own will,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0760:b004:l008","ordinal":134583,"en":"Saying, “Abyke and Kobosh are my kin.”"},{"id":"semetey-1-2013:p0760:b004:l009","ordinal":134584,"en":"You whom I regard in my father's place,"},{"id":"semetey-1-2013:p0760:b004:l010","ordinal":134585,"en":"Abyke, on whom I lean,"},{"id":"semetey-1-2013:p0760:b004:l011","ordinal":134586,"en":"Hear the words I mean to say."},{"id":"semetey-1-2013:p0760:b004:l012","ordinal":134587,"en":"Kumaiyk, left by my father Manas,"},{"id":"semetey-1-2013:p0760:b004:l013","ordinal":134588,"en":"That keen hunter known to the people,"},{"id":"semetey-1-2013:p0760:b004:l014","ordinal":134589,"en":"The inheritance left by my father Manas,"},{"id":"semetey-1-2013:p0760:b004:l015","ordinal":134590,"en":"From the banks of great Talas"},{"id":"semetey-1-2013:p0760:b004:l016","ordinal":134591,"en":"Has strayed into your keeping."},{"id":"semetey-1-2013:p0760:b004:l017","ordinal":134592,"en":"Where is that treasure, the white sighthound?"},{"id":"semetey-1-2013:p0760:b004:l018","ordinal":134593,"en":"Tell me what has become of him."},{"id":"semetey-1-2013:p0760:b004:l019","ordinal":134594,"en":"Long ago, the bird a kite hatched and raised,"},{"id":"semetey-1-2013:p0760:b004:l020","ordinal":134595,"en":"God Almighty, to my khan father,"},{"id":"semetey-1-2013:p0760:b004:l021","ordinal":134596,"en":"Brought it to Khan Manas—"},{"id":"semetey-1-2013:p0760:b004:l022","ordinal":134597,"en":"His talons iron, his jess fastener copper,"},{"id":"semetey-1-2013:p0760:b004:l023","ordinal":134598,"en":"Two cubits in girth,"},{"id":"semetey-1-2013:p0760:b004:l024","ordinal":134599,"en":"Whose striking talons never missed,"},{"id":"semetey-1-2013:p0760:b004:l025","ordinal":134600,"en":"Whom no keen hunting bird could match,"},{"id":"semetey-1-2013:p0760:b004:l026","ordinal":134601,"en":"Black-eyed, with speckled legs,"},{"id":"semetey-1-2013:p0760:b004:l027","ordinal":134602,"en":"Never shrinking from what he saw,"},{"id":"semetey-1-2013:p0760:b004:l029","ordinal":134603,"en":"He would not fold his wings and swoop;","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0760:b004:l030","ordinal":134604,"en":"He would not let a goose fly from the lake."},{"id":"semetey-1-2013:p0760:b004:l031","ordinal":134605,"en":"He would not gather his tail and swoop;"},{"id":"semetey-1-2013:p0760:b004:l032","ordinal":134606,"en":"He would not let a swan fly from the lake."},{"id":"semetey-1-2013:p0760:b004:l033","ordinal":134607,"en":"He was a bird to take hunting;"},{"id":"semetey-1-2013:p0760:b004:l034","ordinal":134608,"en":"He was a possession left by my father."},{"id":"semetey-1-2013:p0760:b004:l035","ordinal":134609,"en":"Where is the white falcon, uncle?!"},{"id":"semetey-1-2013:p0760:b004:l036","ordinal":134610,"en":"Long ago, into looming Great Beijing,"},{"id":"semetey-1-2013:p0760:b004:l037","ordinal":134611,"en":"When he went straight in and thrust his spear,"},{"id":"semetey-1-2013:p0760:b004:l038","ordinal":134612,"en":"From a hell of grievous suffering,"},{"id":"semetey-1-2013:p0760:b004:l039","ordinal":134613,"en":"When he freed lives."}]
