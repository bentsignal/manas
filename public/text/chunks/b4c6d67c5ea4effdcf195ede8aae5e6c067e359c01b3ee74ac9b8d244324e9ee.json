[{"id":"semetey-1-2013:p1267:b003:l004","ordinal":173825,"en":"Its bent places straightened,"},{"id":"semetey-1-2013:p1267:b003:l005","ordinal":173826,"en":"The master smith Bolokbay"},{"id":"semetey-1-2013:p1267:b003:l006","ordinal":173827,"en":"Had repaired the poor thing."},{"id":"semetey-1-2013:p1267:b003:l007","ordinal":173828,"en":"He had it bound with sinew;"},{"id":"semetey-1-2013:p1267:b003:l008","ordinal":173829,"en":"Leaving no hollow place,"},{"id":"semetey-1-2013:p1267:b003:l009","ordinal":173830,"en":"He wrapped it with gold."},{"id":"semetey-1-2013:p1267:b003:l010","ordinal":173831,"en":"So it would not slip from the hand,"},{"id":"semetey-1-2013:p1267:b003:l011","ordinal":173832,"en":"He lacquered its grip"},{"id":"semetey-1-2013:p1267:b003:l012","ordinal":173833,"en":"And covered it with elephant hide."},{"id":"semetey-1-2013:p1267:b003:l013","ordinal":173834,"en":"When leveled and thrust at the enemy,"},{"id":"semetey-1-2013:p1267:b003:l014","ordinal":173835,"en":"It glowed red as an ember;"},{"id":"semetey-1-2013:p1267:b003:l015","ordinal":173836,"en":"When leveled and brandished at the foe,"},{"id":"semetey-1-2013:p1267:b003:l016","ordinal":173837,"en":"A man's soul rejoiced."},{"id":"semetey-1-2013:p1267:b003:l017","ordinal":173838,"en":"When the patterned spear struck,"},{"id":"semetey-1-2013:p1267:b003:l018","ordinal":173839,"en":"It bent without breaking."},{"id":"semetey-1-2013:p1267:b003:l019","ordinal":173840,"en":"So precious was it:"},{"id":"semetey-1-2013:p1267:b003:l020","ordinal":173841,"en":"Its exterior was covered in hide;"},{"id":"semetey-1-2013:p1267:b003:l021","ordinal":173842,"en":"So a spear stroke would not cut it,"},{"id":"semetey-1-2013:p1267:b003:l022","ordinal":173843,"en":"He wrapped it with gold."},{"id":"semetey-1-2013:p1267:b003:l023","ordinal":173844,"en":"Its tip was wolf-tongue steel;"},{"id":"semetey-1-2013:p1267:b003:l024","ordinal":173845,"en":"It felled whomever it was leveled at."},{"id":"semetey-1-2013:p1267:b003:l025","ordinal":173846,"en":"\"Let the place it strikes not remain whole;"},{"id":"semetey-1-2013:p1267:b003:l026","ordinal":173847,"en":"Let him burn and die;"},{"id":"semetey-1-2013:p1267:b003:l027","ordinal":173848,"en":"Let an untimely death reach him,\""},{"id":"semetey-1-2013:p1267:b003:l028","ordinal":173849,"en":"They tempered it with albar steel."},{"id":"semetey-1-2013:p1267:b003:l029","ordinal":173850,"en":"It was of hollow-forged steel,"},{"id":"semetey-1-2013:p1267:b003:l030","ordinal":173851,"en":"Raised high in massive form,"},{"id":"semetey-1-2013:p1267:b003:l031","ordinal":173852,"en":"And crushed a charging enemy"},{"id":"semetey-1-2013:p1267:b003:l032","ordinal":173853,"en":"To the earth like a hare."},{"id":"semetey-1-2013:p1267:b003:l033","ordinal":173854,"en":"Taking the patterned spear and arming himself,"},{"id":"semetey-1-2013:p1267:b003:l034","ordinal":173855,"en":"Your foreign-born lord made ready."},{"id":"semetey-1-2013:p1267:b003:l035","ordinal":173856,"en":"Upon his head he wore"},{"id":"semetey-1-2013:p1267:b003:l036","ordinal":173857,"en":"A black cap of blue lynx."},{"id":"semetey-1-2013:p1267:b003:l037","ordinal":173858,"en":"Do not ask the valiant man's nature:"},{"id":"semetey-1-2013:p1267:b003:l038","ordinal":173859,"en":"The direction he faced became red fire."},{"id":"semetey-1-2013:p1267:b003:l039","ordinal":173860,"en":"Semetey was an ocean;"},{"id":"semetey-1-2013:p1267:b005:l001","ordinal":173861,"en":"His fortunes were complete."},{"id":"semetey-1-2013:p1267:b005:l002","ordinal":173862,"en":"He was the hero born greater"},{"id":"semetey-1-2013:p1267:b005:l003","ordinal":173863,"en":"Than his generous father Manas."},{"id":"semetey-1-2013:p1267:b005:l004","ordinal":173864,"en":"This was when he would battle"},{"id":"semetey-1-2013:p1267:b005:l005","ordinal":173865,"en":"The Jediger who had engulfed them."},{"id":"semetey-1-2013:p1267:b005:l006","ordinal":173866,"en":"The Akkolpok upon him—"},{"id":"semetey-1-2013:p1267:b005:l007","ordinal":173867,"en":"When slaves seized its silk,"},{"id":"semetey-1-2013:p1267:b005:l008","ordinal":173868,"en":"When the horde was destroyed then,"},{"id":"semetey-1-2013:p1267:b005:l009","ordinal":173869,"en":"And it fell into the hands"},{"id":"semetey-1-2013:p1267:b005:l010","ordinal":173870,"en":"Of a man clad in gray thread,"},{"id":"semetey-1-2013:p1267:b005:l011","ordinal":173871,"en":"These dogs had grown in silk"},{"id":"semetey-1-2013:p1267:b005:l012","ordinal":173872,"en":"And put the silk on themselves."},{"id":"semetey-1-2013:p1267:b005:l013","ordinal":173873,"en":"Semetey destroyed their horde"},{"id":"semetey-1-2013:p1267:b005:l014","ordinal":173874,"en":"And took back Akkolpok"},{"id":"semetey-1-2013:p1267:b005:l015","ordinal":173875,"en":"From the scoundrels' hands."},{"id":"semetey-1-2013:p1267:b005:l016","ordinal":173876,"en":"She twisted its filled places;"},{"id":"semetey-1-2013:p1267:b005:l017","ordinal":173877,"en":"Your dear mother Kanykei"},{"id":"semetey-1-2013:p1267:b005:l018","ordinal":173878,"en":"And skillfully repaired it all."},{"id":"semetey-1-2013:p1267:b005:l019","ordinal":173879,"en":"She had obtained the silk before,"},{"id":"semetey-1-2013:p1267:b005:l020","ordinal":173880,"en":"Silk mixed with fine fiber,"},{"id":"semetey-1-2013:p1267:b005:l021","ordinal":173881,"en":"And had its weave made of gold;"},{"id":"semetey-1-2013:p1267:b005:l022","ordinal":173882,"en":"She patched what was torn"},{"id":"semetey-1-2013:p1267:b005:l023","ordinal":173883,"en":"And your dear mother repaired"},{"id":"semetey-1-2013:p1267:b005:l024","ordinal":173884,"en":"Everything that was damaged."},{"id":"semetey-1-2013:p1267:b005:l025","ordinal":173885,"en":"She had the unsuitable parts removed"},{"id":"semetey-1-2013:p1267:b005:l026","ordinal":173886,"en":"And plates of steel"},{"id":"semetey-1-2013:p1267:b005:l027","ordinal":173887,"en":"Poured into its center."},{"id":"semetey-1-2013:p1267:b005:l028","ordinal":173888,"en":"The jaws of tongs could not grip it;"},{"id":"semetey-1-2013:p1267:b005:l029","ordinal":173889,"en":"The edge of Arkesken could not cut it."},{"id":"semetey-1-2013:p1267:b005:l030","ordinal":173890,"en":"No ember passed it when red willow burned;"},{"id":"semetey-1-2013:p1267:b005:l031","ordinal":173891,"en":"No spear pierced it in a joust,"},{"id":"semetey-1-2013:p1267:b005:l032","ordinal":173892,"en":"And no short blade cut its weave."},{"id":"semetey-1-2013:p1267:b005:l033","ordinal":173893,"en":"Its inside was silk and atlas,"},{"id":"semetey-1-2013:p1267:b005:l034","ordinal":173894,"en":"Its collar gold and sleeves brass."},{"id":"semetey-1-2013:p1267:b005:l035","ordinal":173895,"en":"Wearing Akkolpok, he appeared—"},{"id":"semetey-1-2013:p1267:b005:l036","ordinal":173896,"en":"The heroic lord, son of Manas;"},{"id":"semetey-1-2013:p1267:b005:l037","ordinal":173897,"en":"The time for slaughter had come!"},{"id":"semetey-1-2013:p1267:b005:l038","ordinal":173898,"en":"Golden-cheeked battle-axe,"},{"id":"semetey-1-2013:p1267:b005:l039","ordinal":173899,"en":"Of many splendid ornaments,"},{"id":"semetey-1-2013:p1268:b003:l001","ordinal":173900,"en":"Its haft was gold, its edge sharp."},{"id":"semetey-1-2013:p1268:b003:l002","ordinal":173901,"en":"When Turks came from Bukhara,"},{"id":"semetey-1-2013:p1268:b003:l003","ordinal":173902,"en":"Surpassing all after taking food,"},{"id":"semetey-1-2013:p1268:b003:l004","ordinal":173903,"en":"He was a friend of David—"},{"id":"semetey-1-2013:p1268:b003:l005","ordinal":173904,"en":"The master smith Bölökbai,"},{"id":"semetey-1-2013:p1268:b003:l006","ordinal":173905,"en":"Had made the poor thing."},{"id":"semetey-1-2013:p1268:b003:l007","ordinal":173906,"en":"Stars shifted in the sky;"},{"id":"semetey-1-2013:p1268:b003:l008","ordinal":173907,"en":"David and Bolokbay"},{"id":"semetey-1-2013:p1268:b003:l009","ordinal":173908,"en":"Became true friends."},{"id":"semetey-1-2013:p1268:b003:l010","ordinal":173909,"en":"Their charcoal swelled and melted;"},{"id":"semetey-1-2013:p1268:b003:l011","ordinal":173910,"en":"The two joined together."},{"id":"semetey-1-2013:p1268:b003:l012","ordinal":173911,"en":"Unable to withstand their charcoal,"},{"id":"semetey-1-2013:p1268:b003:l013","ordinal":173912,"en":"The forested mountainside was hollowed;"},{"id":"semetey-1-2013:p1268:b003:l014","ordinal":173913,"en":"Unable to withstand their bellows,"},{"id":"semetey-1-2013:p1268:b003:l015","ordinal":173914,"en":"A levy fell upon the Kyrgyz"},{"id":"semetey-1-2013:p1268:b003:l016","ordinal":173915,"en":"And many young bulls were slaughtered."},{"id":"semetey-1-2013:p1268:b003:l017","ordinal":173916,"en":"They joined and formed its point;"},{"id":"semetey-1-2013:p1268:b003:l018","ordinal":173917,"en":"\"Let whoever it touches die in pain,\""},{"id":"semetey-1-2013:p1268:b003:l019","ordinal":173918,"en":"They tempered it six times"},{"id":"semetey-1-2013:p1268:b003:l020","ordinal":173919,"en":"In a dragon's venom."},{"id":"semetey-1-2013:p1268:b003:l021","ordinal":173920,"en":"Its edge was red, its mouth fire;"},{"id":"semetey-1-2013:p1268:b003:l022","ordinal":173921,"en":"Whomever it struck died at once."},{"id":"semetey-1-2013:p1268:b003:l023","ordinal":173922,"en":"Whoever faced it found bitterness;"},{"id":"semetey-1-2013:p1268:b003:l024","ordinal":173923,"en":"One whose death had come met it."},{"id":"semetey-1-2013:p1268:b003:l025","ordinal":173924,"en":"Golden-cheeked battle-axe,"},{"id":"semetey-1-2013:p1268:b003:l026","ordinal":173925,"en":"Gold-adorned side pouch,"},{"id":"semetey-1-2013:p1268:b003:l027","ordinal":173926,"en":"Its excellence visible to the people—"},{"id":"semetey-1-2013:p1268:b003:l028","ordinal":173927,"en":"No one dared face it."},{"id":"semetey-1-2013:p1268:b003:l029","ordinal":173928,"en":"Your valiant-born sultan,"},{"id":"semetey-1-2013:p1268:b003:l030","ordinal":173929,"en":"Terrible in bearing and strong in venom,"},{"id":"semetey-1-2013:p1268:b003:l031","ordinal":173930,"en":"The true son of your generous lord,"},{"id":"semetey-1-2013:p1268:b003:l032","ordinal":173931,"en":"Was deeply troubled."},{"id":"semetey-1-2013:p1268:b003:l033","ordinal":173932,"en":"When one looked before him,"},{"id":"semetey-1-2013:p1268:b003:l034","ordinal":173933,"en":"The generous lord's young son"},{"id":"semetey-1-2013:p1268:b003:l035","ordinal":173934,"en":"Had the might of six thousand men;"},{"id":"semetey-1-2013:p1268:b003:l036","ordinal":173935,"en":"When one looked behind him,"},{"id":"semetey-1-2013:p1268:b003:l037","ordinal":173936,"en":"He bore the form of a dragon."},{"id":"semetey-1-2013:p1268:b003:l038","ordinal":173937,"en":"Towering high along the shortcut,"},{"id":"semetey-1-2013:p1268:b003:l039","ordinal":173938,"en":"The mountain-like Buurul—"},{"id":"semetey-1-2013:p1268:b004:l001","ordinal":173939,"en":"Dear Kanchoro led him."},{"id":"semetey-1-2013:p1268:b004:l002","ordinal":173940,"en":"Upon that Roan's head"},{"id":"semetey-1-2013:p1268:b004:l003","ordinal":173941,"en":"Was a white halter knotted in loops,"},{"id":"semetey-1-2013:p1268:b004:l004","ordinal":173942,"en":"A fitted halter worthy"},{"id":"semetey-1-2013:p1268:b004:l005","ordinal":173943,"en":"Of the mountain-like stallion."},{"id":"semetey-1-2013:p1268:b004:l006","ordinal":173944,"en":"Without haste or confusion, the heroes"},{"id":"semetey-1-2013:p1268:b004:l007","ordinal":173945,"en":"Now saddled and prepared"},{"id":"semetey-1-2013:p1268:b004:l008","ordinal":173946,"en":"The mountain-like Roan."},{"id":"semetey-1-2013:p1268:b004:l009","ordinal":173947,"en":"Semetey's Akkangky,"},{"id":"semetey-1-2013:p1268:b004:l010","ordinal":173948,"en":"A Kangky fitted to the dapple stallion,"},{"id":"semetey-1-2013:p1268:b004:l011","ordinal":173949,"en":"Its pommel pure gold,"},{"id":"semetey-1-2013:p1268:b004:l012","ordinal":173950,"en":"Its cantle solid silver,"},{"id":"semetey-1-2013:p1268:b004:l013","ordinal":173951,"en":"Both bows broad iron—"},{"id":"semetey-1-2013:p1268:b004:l014","ordinal":173952,"en":"Akkangky for riding downhill."},{"id":"semetey-1-2013:p1268:b004:l015","ordinal":173953,"en":"To go to the Jediger,"},{"id":"semetey-1-2013:p1268:b004:l016","ordinal":173954,"en":"To arrive and begin slaughter,"},{"id":"semetey-1-2013:p1268:b004:l017","ordinal":173955,"en":"Displaying his gray-maned courage,"},{"id":"semetey-1-2013:p1268:b004:l018","ordinal":173956,"en":"From before the golden throne,"},{"id":"semetey-1-2013:p1268:b004:l019","ordinal":173957,"en":"The mountain-like Buurul"},{"id":"semetey-1-2013:p1268:b004:l020","ordinal":173958,"en":"They brought and mounted Semetey upon him."},{"id":"semetey-1-2013:p1268:b004:l021","ordinal":173959,"en":"They readied his weapons"},{"id":"semetey-1-2013:p1268:b004:l022","ordinal":173960,"en":"And prepared every piece of armor."},{"id":"semetey-1-2013:p1268:b004:l023","ordinal":173961,"en":"Your lord came out apart,"},{"id":"semetey-1-2013:p1268:b004:l024","ordinal":173962,"en":"Looking like a solitary mountain."},{"id":"semetey-1-2013:p1268:b004:l025","ordinal":173963,"en":"Your lord was alone,"},{"id":"semetey-1-2013:p1268:b004:l026","ordinal":173964,"en":"Your sultan was unsurpassed."},{"id":"semetey-1-2013:p1268:b004:l027","ordinal":173965,"en":"Beside that lord"},{"id":"semetey-1-2013:p1268:b004:l028","ordinal":173966,"en":"There was no forest to flee into,"},{"id":"semetey-1-2013:p1268:b004:l029","ordinal":173967,"en":"No Kyrgyz to make a host."},{"id":"semetey-1-2013:p1268:b004:l030","ordinal":173968,"en":"He had no waist girded beside him,"},{"id":"semetey-1-2013:p1268:b004:l031","ordinal":173969,"en":"No place of ambush."},{"id":"semetey-1-2013:p1268:b004:l032","ordinal":173970,"en":"He had no fortune founded at Keng-Kol,"},{"id":"semetey-1-2013:p1268:b004:l033","ordinal":173971,"en":"No time to stride proudly."},{"id":"semetey-1-2013:p1268:b004:l034","ordinal":173972,"en":"The gray-maned son of Manas"},{"id":"semetey-1-2013:p1268:b004:l035","ordinal":173973,"en":"Had courage beyond all measure."},{"id":"semetey-1-2013:p1268:b004:l036","ordinal":173974,"en":"The Argyn who would have ridden as support"},{"id":"semetey-1-2013:p1268:b004:l037","ordinal":173975,"en":"Was not there."},{"id":"semetey-1-2013:p1268:b004:l038","ordinal":173976,"en":"He had no khan to find counsel;"},{"id":"semetey-1-2013:p1268:b004:l039","ordinal":173977,"en":"The Jediger were set to shoot,"},{"id":"semetey-1-2013:p1269:b003:l001","ordinal":173978,"en":"To devise a means for him,"},{"id":"semetey-1-2013:p1269:b003:l002","ordinal":173979,"en":"Neither Sary Khan nor Bakay was there."},{"id":"semetey-1-2013:p1269:b003:l003","ordinal":173980,"en":"The peerless lion stood utterly alone;"},{"id":"semetey-1-2013:p1269:b003:l004","ordinal":173981,"en":"The poor hero grew angry,"},{"id":"semetey-1-2013:p1269:b003:l005","ordinal":173982,"en":"Towering apart from other men,"},{"id":"semetey-1-2013:p1269:b003:l006","ordinal":173983,"en":"His terrible bearing held high."},{"id":"semetey-1-2013:p1269:b003:l007","ordinal":173984,"en":"As though sixty rivers converged"},{"id":"semetey-1-2013:p1269:b003:l008","ordinal":173985,"en":"And he were formed from their torrents;"},{"id":"semetey-1-2013:p1269:b003:l009","ordinal":173986,"en":"As though he were formed"},{"id":"semetey-1-2013:p1269:b003:l010","ordinal":173987,"en":"From every spur of twelve mountains;"},{"id":"semetey-1-2013:p1269:b003:l011","ordinal":173988,"en":"As though he were formed from the lair"},{"id":"semetey-1-2013:p1269:b003:l012","ordinal":173989,"en":"Of your hungry lion;"},{"id":"semetey-1-2013:p1269:b003:l013","ordinal":173990,"en":"As though he were formed from the supports"},{"id":"semetey-1-2013:p1269:b003:l014","ordinal":173991,"en":"Of heaven and earth."},{"id":"semetey-1-2013:p1269:b003:l015","ordinal":173992,"en":"Raging and champing for battle,"},{"id":"semetey-1-2013:p1269:b003:l016","ordinal":173993,"en":"Leopard-born Semetey"},{"id":"semetey-1-2013:p1269:b003:l017","ordinal":173994,"en":"Set out toward the Jediger."},{"id":"semetey-1-2013:p1269:b003:l018","ordinal":173995,"en":"Young Lord Semetey"},{"id":"semetey-1-2013:p1269:b003:l019","ordinal":173996,"en":"Mounted Buurul,"},{"id":"semetey-1-2013:p1269:b003:l020","ordinal":173997,"en":"Making him spirited then,"},{"id":"semetey-1-2013:p1269:b003:l021","ordinal":173998,"en":"Making him heave as though his master had died."},{"id":"semetey-1-2013:p1269:b003:l022","ordinal":173999,"en":"Semetey emerged"},{"id":"semetey-1-2013:p1269:b003:l023","ordinal":174000,"en":"From the treasury horde;"},{"id":"semetey-1-2013:p1269:b003:l024","ordinal":174001,"en":"The direction he lunged became red fire,"},{"id":"semetey-1-2013:p1269:b003:l025","ordinal":174002,"en":"And all who saw him lost heart."},{"id":"semetey-1-2013:p1269:b003:l026","ordinal":174003,"en":"Nine guardian spirits supported him;"},{"id":"semetey-1-2013:p1269:b003:l027","ordinal":174004,"en":"A black-striped leopard"},{"id":"semetey-1-2013:p1269:b003:l028","ordinal":174005,"en":"Strained at his side."},{"id":"semetey-1-2013:p1269:b003:l029","ordinal":174006,"en":"One of the forty chiltens"},{"id":"semetey-1-2013:p1269:b003:l030","ordinal":174007,"en":"Supported him unseen;"},{"id":"semetey-1-2013:p1269:b003:l031","ordinal":174008,"en":"A stunted gray-maned lion"},{"id":"semetey-1-2013:p1269:b003:l032","ordinal":174009,"en":"Made ready alongside him."},{"id":"semetey-1-2013:p1269:b003:l033","ordinal":174010,"en":"The forty chiltens and Khizr Ilyas"},{"id":"semetey-1-2013:p1269:b003:l034","ordinal":174011,"en":"All joined in supporting him."},{"id":"semetey-1-2013:p1269:b003:l035","ordinal":174012,"en":"A giant black eagle, a zymyr bird,"},{"id":"semetey-1-2013:p1269:b003:l036","ordinal":174013,"en":"As though about to carry him away,"},{"id":"semetey-1-2013:p1269:b003:l037","ordinal":174014,"en":"Stretched its feet down from the sky."},{"id":"semetey-1-2013:p1269:b003:l038","ordinal":174015,"en":"A black-striped dragon"},{"id":"semetey-1-2013:p1269:b003:l039","ordinal":174016,"en":"Crawled beneath him"},{"id":"semetey-1-2013:p1269:b004:l001","ordinal":174017,"en":"As though drawing him onward."},{"id":"semetey-1-2013:p1269:b004:l002","ordinal":174018,"en":"The orphaned son of Manas,"},{"id":"semetey-1-2013:p1269:b004:l003","ordinal":174019,"en":"Your rooster-like lion—"},{"id":"semetey-1-2013:p1269:b004:l004","ordinal":174020,"en":"Manas, whose spirit lived,"},{"id":"semetey-1-2013:p1269:b004:l005","ordinal":174021,"en":"Supported him above all."},{"id":"semetey-1-2013:p1269:b004:l006","ordinal":174022,"en":"Shimmering dark blue,"},{"id":"semetey-1-2013:p1269:b004:l007","ordinal":174023,"en":"The direction he faced became red fire."},{"id":"semetey-1-2013:p1269:b004:l008","ordinal":174024,"en":"At the place where he spent a night,"},{"id":"semetey-1-2013:p1269:b004:l009","ordinal":174025,"en":"A deep-rooted shrine arose;"},{"id":"semetey-1-2013:p1269:b004:l010","ordinal":174026,"en":"Khizr supported from his birth"},{"id":"semetey-1-2013:p1269:b004:l011","ordinal":174027,"en":"The descendant of the inexhaustible one."},{"id":"semetey-1-2013:p1269:b004:l012","ordinal":174028,"en":"At the place he chose to visit,"},{"id":"semetey-1-2013:p1269:b004:l013","ordinal":174029,"en":"A shrine with a city arose."},{"id":"semetey-1-2013:p1269:b004:l014","ordinal":174030,"en":"His sacred power was extraordinary;"},{"id":"semetey-1-2013:p1269:b004:l015","ordinal":174031,"en":"No enemy who challenged him prospered."},{"id":"semetey-1-2013:p1269:b004:l016","ordinal":174032,"en":"When he entered facing battle,"},{"id":"semetey-1-2013:p1269:b004:l017","ordinal":174033,"en":"Bullets crawled like snakes."},{"id":"semetey-1-2013:p1269:b004:l018","ordinal":174034,"en":"The valiant man's descendant—"},{"id":"semetey-1-2013:p1269:b004:l019","ordinal":174035,"en":"No one who confronted him survived."},{"id":"semetey-1-2013:p1269:b004:l020","ordinal":174036,"en":"As he stood now,"},{"id":"semetey-1-2013:p1269:b004:l021","ordinal":174037,"en":"He could conquer the whole world."},{"id":"semetey-1-2013:p1269:b004:l022","ordinal":174038,"en":"He was no Chynkojo or Toltoy;"},{"id":"semetey-1-2013:p1269:b004:l023","ordinal":174039,"en":"He could plainly bring slaughter"},{"id":"semetey-1-2013:p1269:b004:l024","ordinal":174040,"en":"Across the entire world."},{"id":"semetey-1-2013:p1269:b004:l025","ordinal":174041,"en":"Bullet-defying Arbuurul"},{"id":"semetey-1-2013:p1269:b004:l026","ordinal":174042,"en":"Was his exceptionally swift steed."},{"id":"semetey-1-2013:p1269:b004:l027","ordinal":174043,"en":"He was no Chynkojo or Toltoy;"},{"id":"semetey-1-2013:p1269:b004:l028","ordinal":174044,"en":"He was of an age to besiege"},{"id":"semetey-1-2013:p1269:b004:l029","ordinal":174045,"en":"Beijing in Kakanchyn,"},{"id":"semetey-1-2013:p1269:b004:l030","ordinal":174046,"en":"And had strength to engulf and slaughter."},{"id":"semetey-1-2013:p1269:b004:l031","ordinal":174047,"en":"What he wore upon him"},{"id":"semetey-1-2013:p1269:b004:l032","ordinal":174048,"en":"Was gold-collared kureoko armor."},{"id":"semetey-1-2013:p1269:b004:l033","ordinal":174049,"en":"The Jediger coveted it;"},{"id":"semetey-1-2013:p1269:b004:l034","ordinal":174050,"en":"They were about to fall into turmoil."},{"id":"semetey-1-2013:p1269:b004:l035","ordinal":174051,"en":"Driving after him,"},{"id":"semetey-1-2013:p1269:b004:l036","ordinal":174052,"en":"The Jediger would meet slaughter"},{"id":"semetey-1-2013:p1269:b004:l037","ordinal":174053,"en":"Because of desire for Aychurok."},{"id":"semetey-1-2013:p1269:b004:l038","ordinal":174054,"en":"Accursed Chynkojo,"},{"id":"semetey-1-2013:p1269:b004:l039","ordinal":174055,"en":"Fleeing lost from his village,"},{"id":"semetey-1-2013:p1270:b003:l001","ordinal":174056,"en":"Can there be such a fool,"},{"id":"semetey-1-2013:p1270:b003:l002","ordinal":174057,"en":"Contesting a lion's wife?"},{"id":"semetey-1-2013:p1270:b003:l003","ordinal":174058,"en":"To see the spectacle together,"},{"id":"semetey-1-2013:p1270:b003:l004","ordinal":174059,"en":"The ancestral spirit struck that people"},{"id":"semetey-1-2013:p1270:b003:l005","ordinal":174060,"en":"To die by your gray-maned hero."},{"id":"semetey-1-2013:p1270:b003:l006","ordinal":174061,"en":"When the hero sultan, son of Manas,"},{"id":"semetey-1-2013:p1270:b003:l007","ordinal":174062,"en":"Suddenly came out of the horde,"},{"id":"semetey-1-2013:p1270:b003:l008","ordinal":174063,"en":"His eyes blazed like a lion's;"},{"id":"semetey-1-2013:p1270:b003:l009","ordinal":174064,"en":"Those who saw him lost all strength."},{"id":"semetey-1-2013:p1270:b003:l010","ordinal":174065,"en":"Bloodlust seized"},{"id":"semetey-1-2013:p1270:b003:l011","ordinal":174066,"en":"The young gray-maned lord."},{"id":"semetey-1-2013:p1270:b003:l012","ordinal":174067,"en":"The garden planted in broad Afghanistan,"},{"id":"semetey-1-2013:p1270:b003:l013","ordinal":174068,"en":"The golden throne mounted as a bridegroom—"},{"id":"semetey-1-2013:p1270:b003:l014","ordinal":174069,"en":"Now was the time to clash"},{"id":"semetey-1-2013:p1270:b003:l015","ordinal":174070,"en":"With Toltoy who had come himself."},{"id":"semetey-1-2013:p1270:b003:l016","ordinal":174071,"en":"Raising sky-high"},{"id":"semetey-1-2013:p1270:b003:l017","ordinal":174072,"en":"The red banner with golden finial,"},{"id":"semetey-1-2013:p1270:b003:l018","ordinal":174073,"en":"The Opol-Too-like leopard"},{"id":"semetey-1-2013:p1270:b003:l019","ordinal":174074,"en":"Now advanced"},{"id":"semetey-1-2013:p1270:b003:l020","ordinal":174075,"en":"Toward Chynkojo."},{"id":"semetey-1-2013:p1270:b003:l021","ordinal":174076,"en":"Let us leave the valiant man"},{"id":"semetey-1-2013:p1270:b003:l022","ordinal":174077,"en":"Who had set his course,"},{"id":"semetey-1-2013:p1270:b003:l023","ordinal":174078,"en":"And begin the tale"},{"id":"semetey-1-2013:p1270:b003:l024","ordinal":174079,"en":"Of Kulchoro, Almambet's son."},{"id":"semetey-1-2013:p1270:b003:l025","ordinal":174080,"en":"The swaggering gray-maned hero"}]
