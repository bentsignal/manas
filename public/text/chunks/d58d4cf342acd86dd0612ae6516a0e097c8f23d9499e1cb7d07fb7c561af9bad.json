[{"id":"semetey-1-2013:p1055:b003:l039","ordinal":156673,"en":"Only Friday night knows where she flies."},{"id":"semetey-1-2013:p1055:b004:l001","ordinal":156674,"en":"Who knows where"},{"id":"semetey-1-2013:p1055:b004:l002","ordinal":156675,"en":"Calamitous Chürök may be!"},{"id":"semetey-1-2013:p1055:b004:l003","ordinal":156676,"en":"Unruly and raging Chürök,"},{"id":"semetey-1-2013:p1055:b004:l004","ordinal":156677,"en":"The turmoil born among mortals,"},{"id":"semetey-1-2013:p1055:b004:l005","ordinal":156678,"en":"Born never to fall into a man's snare,"},{"id":"semetey-1-2013:p1055:b004:l006","ordinal":156679,"en":"Never to fall into anyone's hands—"},{"id":"semetey-1-2013:p1055:b004:l007","ordinal":156680,"en":"Aychürök was born"},{"id":"semetey-1-2013:p1055:b004:l008","ordinal":156681,"en":"To be the Afghans' sorrow."},{"id":"semetey-1-2013:p1055:b004:l009","ordinal":156682,"en":"The people gathered in fascination"},{"id":"semetey-1-2013:p1055:b004:l010","ordinal":156683,"en":"And longed for Chürök."},{"id":"semetey-1-2013:p1055:b004:l011","ordinal":156684,"en":"Saying, 'I shall conquer her today,'"},{"id":"semetey-1-2013:p1055:b004:l012","ordinal":156685,"en":"You brought turmoil upon Afghanistan."},{"id":"semetey-1-2013:p1055:b004:l013","ordinal":156686,"en":"Do not roar, Chynkozho;"},{"id":"semetey-1-2013:p1055:b004:l014","ordinal":156687,"en":"Hold your army back for now."},{"id":"semetey-1-2013:p1055:b004:l015","ordinal":156688,"en":"I shall seize Chürök and give her to you;"},{"id":"semetey-1-2013:p1055:b004:l016","ordinal":156689,"en":"You yourself must bear"},{"id":"semetey-1-2013:p1055:b004:l017","ordinal":156690,"en":"The turmoil that follows behind her."},{"id":"semetey-1-2013:p1055:b004:l018","ordinal":156691,"en":"I have explained it plainly;"},{"id":"semetey-1-2013:p1055:b004:l019","ordinal":156692,"en":"Here is how the matter stands."},{"id":"semetey-1-2013:p1055:b004:l020","ordinal":156693,"en":"Listen, Chynkozho:"},{"id":"semetey-1-2013:p1055:b004:l021","ordinal":156694,"en":"She has a father-in-law in a turbulent land."},{"id":"semetey-1-2013:p1055:b004:l022","ordinal":156695,"en":"You committed violence many times;"},{"id":"semetey-1-2013:p1055:b004:l023","ordinal":156696,"en":"It is true that I did not consent."},{"id":"semetey-1-2013:p1055:b004:l024","ordinal":156697,"en":"You spoke many lying words;"},{"id":"semetey-1-2013:p1055:b004:l025","ordinal":156698,"en":"It is true that, fearing the end of it,"},{"id":"semetey-1-2013:p1055:b004:l026","ordinal":156699,"en":"I did not give Chürök."},{"id":"semetey-1-2013:p1055:b004:l027","ordinal":156700,"en":"You committed many kinds of violence;"},{"id":"semetey-1-2013:p1055:b004:l028","ordinal":156701,"en":"It is true that I did not consent."},{"id":"semetey-1-2013:p1055:b004:l029","ordinal":156702,"en":"Find wisdom and devise a plan;"},{"id":"semetey-1-2013:p1055:b004:l030","ordinal":156703,"en":"If you find wisdom, Chynkozho,"},{"id":"semetey-1-2013:p1055:b004:l031","ordinal":156704,"en":"Choose among women and take my masterwork."},{"id":"semetey-1-2013:p1055:b004:l032","ordinal":156705,"en":"You have come desiring her expressly;"},{"id":"semetey-1-2013:p1055:b004:l033","ordinal":156706,"en":"Take my daughter Aychürök!"},{"id":"semetey-1-2013:p1055:b004:l034","ordinal":156707,"en":"Together with the maiden, Chynkozho,"},{"id":"semetey-1-2013:p1055:b004:l035","ordinal":156708,"en":"Take my red-tailed knowledge;"},{"id":"semetey-1-2013:p1055:b004:l036","ordinal":156709,"en":"I am one whose soul feared turmoil—"},{"id":"semetey-1-2013:p1055:b004:l037","ordinal":156710,"en":"Understand what I have said!\""},{"id":"semetey-1-2013:p1055:b004:l038","ordinal":156711,"en":"Kozho stood surging with fury,"},{"id":"semetey-1-2013:p1055:b004:l039","ordinal":156712,"en":"Lashing the earth with his whip,"}]
