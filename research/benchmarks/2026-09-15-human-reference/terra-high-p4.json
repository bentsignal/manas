{
  "lines": [
    {"line": 1, "english": "Kökchü came, splendidly arrayed,", "note": ""},
    {"line": 2, "english": "his champions in groups of forty,", "note": ""},
    {"line": 3, "english": "mounted on red-bay horses,", "note": ""},
    {"line": 4, "english": "he set out in anger,", "note": ""},
    {"line": 5, "english": "having received a letter from Esen Khan;", "note": ""},
    {"line": 6, "english": "what else could poor Kökchü do?", "note": ""},
    {"line": 7, "english": "taking skilled sentries,", "note": ""},
    {"line": 8, "english": "men adept at thrusting spears,", "note": ""},
    {"line": 9, "english": "and a force of some seven hundred,", "note": ""},
    {"line": 10, "english": "that Kökchü had come.", "note": ""},
    {"line": 11, "english": "Making his short coat flap,", "note": ""},
    {"line": 12, "english": "making his coat of mail swell out,", "note": ""},
    {"line": 13, "english": "dust flew up to the sky;", "note": ""},
    {"line": 14, "english": "the army marched, kicking up dust.", "note": ""},
    {"line": 15, "english": "What the soldiers bore", "note": ""},
    {"line": 16, "english": "were curved bows and hidden arrows;", "note": ""},
    {"line": 17, "english": "to Bay Jakyp's ears", "note": ""},
    {"line": 18, "english": "the report came.", "note": ""},
    {"line": 19, "english": "His bellowing split the rocks,", "note": ""},
    {"line": 20, "english": "Kökchü came in full battle-fury,", "note": ""},
    {"line": 21, "english": "his cry splitting heads:", "note": ""}
  ]
}
