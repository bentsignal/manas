{"id": "sayakbay-ms-current142:pdf028:l020", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 28, "folio": 2345, "line_in_page": 20, "raw": "Менин каным төгүлсө,", "text": "Менин каным төгүлсө,", "en": "If my blood is spilled,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "First word may be мени rather than менин.", "bbox": null}
