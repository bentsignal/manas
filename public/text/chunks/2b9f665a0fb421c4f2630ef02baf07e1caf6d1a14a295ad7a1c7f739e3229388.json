[{"id":"seytek-2012:p1165:b002:l020","ordinal":384257,"en":"Will become an unwavering banner;"},{"id":"seytek-2012:p1165:b002:l021","ordinal":384258,"en":"Wherever his desire turns, an uproar will rise."},{"id":"seytek-2012:p1165:b002:l022","ordinal":384259,"en":"Those who heed his words"},{"id":"seytek-2012:p1165:b002:l023","ordinal":384260,"en":"He will master through speech,"},{"id":"seytek-2012:p1165:b002:l024","ordinal":384261,"en":"While fools who will not understand"},{"id":"seytek-2012:p1165:b002:l025","ordinal":384262,"en":"He will scatter in direct slaughter."},{"id":"seytek-2012:p1165:b002:l026","ordinal":384263,"en":"He will make the witless plead for mercy"},{"id":"seytek-2012:p1165:b002:l027","ordinal":384264,"en":"And subdue the hot-tempered."},{"id":"seytek-2012:p1165:b002:l028","ordinal":384265,"en":"His surge will be like a lake’s swift current,"},{"id":"seytek-2012:p1165:b002:l029","ordinal":384266,"en":"His courage like a blazing flame."},{"id":"seytek-2012:p1165:b002:l030","ordinal":384267,"en":"You are destined to have a son."},{"id":"seytek-2012:p1165:b002:l031","ordinal":384268,"en":"May this dream of ours come true,"},{"id":"seytek-2012:p1165:b002:l032","ordinal":384269,"en":"May true sacred power prevail,"},{"id":"seytek-2012:p1165:b002:l033","ordinal":384270,"en":"May fortune and abundance come in full."},{"id":"seytek-2012:p1165:b003:l001","ordinal":384271,"en":"May blessings come to the teeming people,"},{"id":"seytek-2012:p1165:b003:l002","ordinal":384272,"en":"Inexhaustible however freely they partake."},{"id":"seytek-2012:p1165:b003:l003","ordinal":384273,"en":"May God grant him land on which to live,"},{"id":"seytek-2012:p1165:b003:l004","ordinal":384274,"en":"And, so that he may sustain the people,"},{"id":"seytek-2012:p1165:b003:l005","ordinal":384275,"en":"May He grant a tiger-limbed hero"},{"id":"seytek-2012:p1165:b003:l006","ordinal":384276,"en":"Whose keenness is like Zulpuqor’s."},{"id":"seytek-2012:p1165:b003:l007","ordinal":384277,"en":"May every word he speaks be fitting;"},{"id":"seytek-2012:p1165:b003:l008","ordinal":384278,"en":"Trusting in the Creator’s protection,"},{"id":"seytek-2012:p1165:b003:l009","ordinal":384279,"en":"May Kenen’s cradle-cord be firm!”"},{"id":"seytek-2012:p1165:b003:l010","ordinal":384280,"en":"Thus Akjoltoy spoke,"},{"id":"seytek-2012:p1165:b003:l011","ordinal":384281,"en":"Interpreting the dream with precision,"},{"id":"seytek-2012:p1165:b003:l012","ordinal":384282,"en":"Explaining it fully without tiring,"},{"id":"seytek-2012:p1165:b003:l013","ordinal":384283,"en":"Unfolding meanings of many kinds,"},{"id":"seytek-2012:p1165:b003:l014","ordinal":384284,"en":"Interpreting it with surpassing accuracy,"},{"id":"seytek-2012:p1165:b003:l015","ordinal":384285,"en":"And so he finished reading the dream."},{"id":"seytek-2012:p1165:b003:l016","ordinal":384286,"en":"“Here are sixty head, beginning with horses,"},{"id":"seytek-2012:p1165:b003:l017","ordinal":384287,"en":"For my uncle Joltay,” he said,"},{"id":"seytek-2012:p1165:b003:l018","ordinal":384288,"en":"And gave them as his interpreter’s reward."},{"id":"seytek-2012:p1165:b003:l019","ordinal":384289,"en":"He gave double-humped camels,"},{"id":"seytek-2012:p1165:b003:l020","ordinal":384290,"en":"And livestock of all four kinds,"},{"id":"seytek-2012:p1165:b003:l021","ordinal":384291,"en":"Red gold and ornaments,"},{"id":"seytek-2012:p1165:b003:l022","ordinal":384292,"en":"Yellow-mottled cloth with a silken weave,"},{"id":"seytek-2012:p1165:b003:l023","ordinal":384293,"en":"Heavy black-mottled fabric,"},{"id":"seytek-2012:p1165:b003:l024","ordinal":384294,"en":"Bales of goods bound for transport,"},{"id":"seytek-2012:p1165:b003:l025","ordinal":384295,"en":"And red-gold coins."},{"id":"seytek-2012:p1165:b003:l026","ordinal":384296,"en":"He took a red camel won as booty,"},{"id":"seytek-2012:p1165:b003:l027","ordinal":384297,"en":"And an elephant fit for bearing loads."},{"id":"seytek-2012:p1165:b003:l028","ordinal":384298,"en":"Joltay’s heart was content;"},{"id":"seytek-2012:p1165:b003:l029","ordinal":384299,"en":"He became immeasurably rich,"},{"id":"seytek-2012:p1165:b003:l030","ordinal":384300,"en":"His hollows filled with milk,"},{"id":"seytek-2012:p1165:b003:l031","ordinal":384301,"en":"His wants filled with meat."},{"id":"seytek-2012:p1165:b003:l032","ordinal":384302,"en":"Joyful and at ease,"},{"id":"seytek-2012:p1165:b003:l033","ordinal":384303,"en":"Through all of this Akjoltoy"},{"id":"seytek-2012:p1165:b003:l034","ordinal":384304,"en":"Became a wealthy man tending countless herds."},{"id":"seytek-1991-continuation:p0315:b001:l001","ordinal":384305,"en":"KENEN"},{"id":"seytek-1991-continuation:p0315:b001:l002","ordinal":384306,"en":"THE BIRTH OF KENEN"},{"id":"seytek-1991-continuation:p0315:b002:l001","ordinal":384307,"en":"The moon waned and days passed,"},{"id":"seytek-1991-continuation:p0315:b002:l002","ordinal":384308,"en":"Many more days passed,"},{"id":"seytek-1991-continuation:p0315:b002:l003","ordinal":384309,"en":"Nine months were fulfilled,"},{"id":"seytek-1991-continuation:p0315:b002:l004","ordinal":384310,"en":"And after nine more days had passed,"},{"id":"seytek-1991-continuation:p0315:b002:l005","ordinal":384311,"en":"When her time was complete,"},{"id":"seytek-1991-continuation:p0315:b002:l006","ordinal":384312,"en":"The unfortunate noblewoman"},{"id":"seytek-1991-continuation:p0315:b002:l007","ordinal":384313,"en":"Went into labor."},{"id":"seytek-1991-continuation:p0315:b002:l008","ordinal":384314,"en":"Her waist ached above,"},{"id":"seytek-1991-continuation:p0315:b002:l009","ordinal":384315,"en":"Where death might strike, it ached,"},{"id":"seytek-1991-continuation:p0315:b002:l010","ordinal":384316,"en":"Both her dark thighs ached,"},{"id":"seytek-1991-continuation:p0315:b002:l011","ordinal":384317,"en":"Every bone, limb, and sinew,"},{"id":"seytek-1991-continuation:p0315:b002:l012","ordinal":384318,"en":"Without exception, ached,"},{"id":"seytek-1991-continuation:p0315:b002:l013","ordinal":384319,"en":"Her frail soul screamed,"},{"id":"seytek-1991-continuation:p0315:b002:l014","ordinal":384320,"en":"Unable to endure, she sobbed,"},{"id":"seytek-1991-continuation:p0315:b002:l015","ordinal":384321,"en":"Her ribs seemed torn apart,"},{"id":"seytek-1991-continuation:p0315:b002:l016","ordinal":384322,"en":"As though it would take her life now,"},{"id":"seytek-1991-continuation:p0315:b002:l017","ordinal":384323,"en":"The poor lady was utterly spent,"},{"id":"seytek-1991-continuation:p0315:b002:l018","ordinal":384324,"en":"As though bowing low, she would surrender her life,"},{"id":"seytek-1991-continuation:p0315:b002:l019","ordinal":384325,"en":"So grievous were her labor pains,"},{"id":"seytek-1991-continuation:p0315:b002:l020","ordinal":384326,"en":"Her life hung by a single hair,"},{"id":"seytek-1991-continuation:p0315:b002:l021","ordinal":384327,"en":"Her thoughts scattered in a thousand directions,"},{"id":"seytek-1991-continuation:p0315:b002:l022","ordinal":384328,"en":"Her frail soul was blown away,"},{"id":"seytek-1991-continuation:p0315:b002:l023","ordinal":384329,"en":"She strained and writhed,"},{"id":"seytek-1991-continuation:p0315:b002:l024","ordinal":384330,"en":"Her bewildered mind was divided,"},{"id":"seytek-1991-continuation:p0315:b002:l025","ordinal":384331,"en":"That accursed, merciless death"},{"id":"seytek-1991-continuation:p0315:b002:l026","ordinal":384332,"en":"Now appeared before her eyes,"},{"id":"seytek-1991-continuation:p0315:b002:l027","ordinal":384333,"en":"Worn down by torment,"},{"id":"seytek-1991-continuation:p0315:b002:l028","ordinal":384334,"en":"Seeing no hope, she despaired of life,"},{"id":"seytek-1991-continuation:p0315:b002:l029","ordinal":384335,"en":"When the fiercest labor came,"},{"id":"seytek-1991-continuation:p0315:b002:l030","ordinal":384336,"en":"For life is sweet until death,"},{"id":"seytek-1991-continuation:p0315:b002:l031","ordinal":384337,"en":"She kept writhing in agony."},{"id":"seytek-1991-continuation:p0315:b002:l032","ordinal":384338,"en":"At midnight,"},{"id":"seytek-1991-continuation:p0315:b002:l033","ordinal":384339,"en":"When her labor came to term,"},{"id":"seytek-1991-continuation:p0315:b002:l034","ordinal":384340,"en":"When the appointed hour was fulfilled,"},{"id":"seytek-1991-continuation:p0315:b002:l035","ordinal":384341,"en":"Sixty old matrons"},{"id":"seytek-1991-continuation:p0315:b004:l001","ordinal":384342,"en":"Waited in a circle around her,"},{"id":"seytek-1991-continuation:p0315:b004:l002","ordinal":384343,"en":"What a wondrous sight it was,"},{"id":"seytek-1991-continuation:p0315:b004:l003","ordinal":384344,"en":"A figure blessed with sacred grace,"},{"id":"seytek-1991-continuation:p0315:b004:l004","ordinal":384345,"en":"The wonder of it was this:"},{"id":"seytek-1991-continuation:p0315:b004:l005","ordinal":384346,"en":"The moon rose upon his brow,"},{"id":"seytek-1991-continuation:p0315:b004:l006","ordinal":384347,"en":"The sun stood above his crown,"},{"id":"seytek-1991-continuation:p0315:b004:l007","ordinal":384348,"en":"His perfect fortune set forth,"},{"id":"seytek-1991-continuation:p0315:b004:l008","ordinal":384349,"en":"The fierce black-maned leopard—"},{"id":"seytek-1991-continuation:p0315:b004:l009","ordinal":384350,"en":"She gave birth to brave Kenen."},{"id":"seytek-1991-continuation:p0315:b005:l001","ordinal":384351,"en":"The child dropped forth crying,"},{"id":"seytek-1991-continuation:p0315:b005:l002","ordinal":384352,"en":"Shouting every battle cry,"},{"id":"seytek-1991-continuation:p0315:b005:l003","ordinal":384353,"en":"He landed upright on his soles,"},{"id":"seytek-1991-continuation:p0315:b005:l004","ordinal":384354,"en":"His kin rejoiced,"},{"id":"seytek-1991-continuation:p0315:b005:l005","ordinal":384355,"en":"But the hateful enemy who begrudged him"},{"id":"seytek-1991-continuation:p0315:b005:l006","ordinal":384356,"en":"Felt his breast split apart."},{"id":"seytek-1991-continuation:p0315:b005:l007","ordinal":384357,"en":"He bore every heroic sign,"},{"id":"seytek-1991-continuation:p0315:b005:l008","ordinal":384358,"en":"And when they looked at his back,"},{"id":"seytek-1991-continuation:p0315:b005:l009","ordinal":384359,"en":"He had a black mane a span long,"},{"id":"seytek-1991-continuation:p0315:b006:l001","ordinal":384360,"en":"All the old women scurried,"},{"id":"seytek-1991-continuation:p0315:b006:l002","ordinal":384361,"en":"And all the young wives,"},{"id":"seytek-1991-continuation:p0315:b006:l003","ordinal":384362,"en":"Saying, “What an extraordinary horror!"},{"id":"seytek-1991-continuation:p0315:b006:l004","ordinal":384363,"en":"This is no child but a calamity,"},{"id":"seytek-1991-continuation:p0315:b006:l005","ordinal":384364,"en":"He is something wholly different,"},{"id":"seytek-1991-continuation:p0315:b006:l006","ordinal":384365,"en":"He has a roaring voice,"},{"id":"seytek-1991-continuation:p0315:b006:l007","ordinal":384366,"en":"Hair grows upon his back,"},{"id":"seytek-1991-continuation:p0315:b006:l008","ordinal":384367,"en":"Fur covers his body,"},{"id":"seytek-1991-continuation:p0315:b006:l009","ordinal":384368,"en":"He is one who will leave none unharmed,"},{"id":"seytek-1991-continuation:p0315:b006:l010","ordinal":384369,"en":"The black eye of disaster!”"},{"id":"seytek-1991-continuation:p0315:b006:l011","ordinal":384370,"en":"Losing their senses,"},{"id":"seytek-1991-continuation:p0315:b006:l012","ordinal":384371,"en":"As though he might seize and swallow a young child,"},{"id":"seytek-1991-continuation:p0315:b006:l013","ordinal":384372,"en":"They panicked and trembled,"},{"id":"seytek-1991-continuation:p0315:b006:l014","ordinal":384373,"en":"Many fled in terror,"},{"id":"seytek-1991-continuation:p0315:b006:l015","ordinal":384374,"en":"Many muttered incantations,"},{"id":"seytek-1991-continuation:p0315:b006:l016","ordinal":384375,"en":"And many among the people grumbled."},{"id":"seytek-1991-continuation:p0316:b001:l001","ordinal":384376,"en":"The noble Gulayym,"},{"id":"seytek-1991-continuation:p0316:b001:l002","ordinal":384377,"en":"The true lady, peer of princes,"},{"id":"seytek-1991-continuation:p0316:b001:l003","ordinal":384378,"en":"The capable lady in all she did,"},{"id":"seytek-1991-continuation:p0316:b001:l004","ordinal":384379,"en":"Purest among those with brass thimbles,"},{"id":"seytek-1991-continuation:p0316:b001:l005","ordinal":384380,"en":"Foremost among the scarf-wearing women,"},{"id":"seytek-1991-continuation:p0316:b001:l006","ordinal":384381,"en":"Said to the old women who were fleeing,"},{"id":"seytek-1991-continuation:p0316:b001:l007","ordinal":384382,"en":"“Fall down and be damned,"},{"id":"seytek-1991-continuation:p0316:b001:l008","ordinal":384383,"en":"May grave dust fill your eyes!”"},{"id":"seytek-1991-continuation:p0316:b001:l009","ordinal":384384,"en":"She scattered earth and chanted,"},{"id":"seytek-1991-continuation:p0316:b001:l010","ordinal":384385,"en":"Performing many different rites,"},{"id":"seytek-1991-continuation:p0316:b001:l011","ordinal":384386,"en":"Invoking Baabedin’s blessing,"},{"id":"seytek-1991-continuation:p0316:b001:l012","ordinal":384387,"en":"Naming a horse for the crescent hoof,"},{"id":"seytek-1991-continuation:p0316:b001:l013","ordinal":384388,"en":"Then slowly turned,"},{"id":"seytek-1991-continuation:p0316:b001:l014","ordinal":384389,"en":"And before the child upon the shield,"},{"id":"seytek-1991-continuation:p0316:b001:l015","ordinal":384390,"en":"The luckless woman repented,"},{"id":"seytek-1991-continuation:p0316:b001:l016","ordinal":384391,"en":"Bowing as young wives do,"},{"id":"seytek-1991-continuation:p0316:b001:l017","ordinal":384392,"en":"And opened her skirts, crying, “God!”"},{"id":"seytek-1991-continuation:p0316:b001:l018","ordinal":384393,"en":"When she looked at Kenen,"},{"id":"seytek-1991-continuation:p0316:b001:l019","ordinal":384394,"en":"Dark within and blue-gray without,"},{"id":"seytek-1991-continuation:p0316:b001:l020","ordinal":384395,"en":"He was one beyond all reckoning,"},{"id":"seytek-1991-continuation:p0316:b001:l021","ordinal":384396,"en":"His courage was singular, his wrath mighty,"},{"id":"seytek-1991-continuation:p0316:b001:l022","ordinal":384397,"en":"Such were the poor child’s black eyes."},{"id":"seytek-1991-continuation:p0316:b001:l023","ordinal":384398,"en":"He was one of the mightiest heroes,"},{"id":"seytek-1991-continuation:p0316:b001:l024","ordinal":384399,"en":"The lion of the Kyrgyz people."},{"id":"seytek-1991-continuation:p0316:b001:l025","ordinal":384400,"en":"With a steel razor in her hand,"},{"id":"seytek-1991-continuation:p0316:b001:l026","ordinal":384401,"en":"She swiftly cut his cord."},{"id":"seytek-1991-continuation:p0316:b001:l027","ordinal":384402,"en":"Saying, “Blessed be the day you saw the light,”"},{"id":"seytek-1991-continuation:p0316:b001:l028","ordinal":384403,"en":"She wrapped him in a robe,"},{"id":"seytek-1991-continuation:p0316:b001:l029","ordinal":384404,"en":"Into his right hand, black blood"},{"id":"seytek-1991-continuation:p0316:b001:l030","ordinal":384405,"en":"Brave Kenen grasped,"},{"id":"seytek-1991-continuation:p0316:b001:l031","ordinal":384406,"en":"Into his left hand, yellow gold"},{"id":"seytek-1991-continuation:p0316:b001:l032","ordinal":384407,"en":"Brave Kenen clutched."},{"id":"seytek-1991-continuation:p0316:b001:l033","ordinal":384408,"en":"He cried and roared wrathfully,"},{"id":"seytek-1991-continuation:p0316:b001:l034","ordinal":384409,"en":"To the vast multitude,"},{"id":"seytek-1991-continuation:p0316:b001:l035","ordinal":384410,"en":"As if crying, “I shall be the people’s guardian,”"},{"id":"seytek-1991-continuation:p0316:b001:l036","ordinal":384411,"en":"Thus he raised his battle cry,"},{"id":"seytek-1991-continuation:p0316:b001:l037","ordinal":384412,"en":"While still in the birth membrane, the child"},{"id":"seytek-1991-continuation:p0316:b001:l038","ordinal":384413,"en":"Was known to be destined for a khan,"},{"id":"seytek-1991-continuation:p0316:b001:l039","ordinal":384414,"en":"The fierce black-maned leopard"},{"id":"seytek-1991-continuation:p0316:b001:l040","ordinal":384415,"en":"Was known to be a peerless soul."},{"id":"seytek-1991-continuation:p0316:b001:l041","ordinal":384416,"en":"Against the wrathful foe,"},{"id":"seytek-1991-continuation:p0316:b001:l042","ordinal":384417,"en":"He showed he would stand firm,"},{"id":"seytek-1991-continuation:p0316:b001:l043","ordinal":384418,"en":"To the darkly raging fierce leopard,"},{"id":"seytek-1991-continuation:p0316:b001:l044","ordinal":384419,"en":"He was known to become a fire,"},{"id":"seytek-1991-continuation:p0316:b001:l045","ordinal":384420,"en":"In battle against the enemy,"},{"id":"seytek-1991-continuation:p0316:b001:l046","ordinal":384421,"en":"He was known to stand his ground."},{"id":"seytek-1991-continuation:p0316:b001:l047","ordinal":384422,"en":"He opened his mouth and roared,"},{"id":"seytek-1991-continuation:p0316:b001:l048","ordinal":384423,"en":"And the black blood in his hand"},{"id":"seytek-1991-continuation:p0316:b001:l049","ordinal":384424,"en":"He flung in a storm."},{"id":"seytek-1991-continuation:p0316:b002:l001","ordinal":384425,"en":"If a savage, turbulent enemy arose"},{"id":"seytek-1991-continuation:p0316:b002:l002","ordinal":384426,"en":"And came to grapple with his people,"},{"id":"seytek-1991-continuation:p0316:b002:l003","ordinal":384427,"en":"He meant to crush the black foe,"},{"id":"seytek-1991-continuation:p0316:b002:l004","ordinal":384428,"en":"And scatter his blood,"},{"id":"seytek-1991-continuation:p0316:b002:l005","ordinal":384429,"en":"The people’s defending hero"},{"id":"seytek-1991-continuation:p0316:b002:l006","ordinal":384430,"en":"Meant to guard the nation."},{"id":"seytek-1991-continuation:p0316:b002:l007","ordinal":384431,"en":"Sixty young wives and forty old women"},{"id":"seytek-1991-continuation:p0316:b002:l008","ordinal":384432,"en":"Could find no composure,"},{"id":"seytek-1991-continuation:p0316:b002:l009","ordinal":384433,"en":"Could not endure his countenance,"},{"id":"seytek-1991-continuation:p0316:b002:l010","ordinal":384434,"en":"Could not withstand his majesty,"},{"id":"seytek-1991-continuation:p0316:b002:l011","ordinal":384435,"en":"And in a flustered panic,"},{"id":"seytek-1991-continuation:p0316:b002:l012","ordinal":384436,"en":"They paced back and forth."},{"id":"seytek-1991-continuation:p0316:b002:l013","ordinal":384437,"en":"The yellow gold in his left hand,"},{"id":"seytek-1991-continuation:p0316:b002:l014","ordinal":384438,"en":"With many different cries,"},{"id":"seytek-1991-continuation:p0316:b002:l015","ordinal":384439,"en":"The roaring child scattered."},{"id":"seytek-1991-continuation:p0316:b002:l016","ordinal":384440,"en":"By scattering his omen,"},{"id":"seytek-1991-continuation:p0316:b002:l017","ordinal":384441,"en":"He meant that if an equal foe arose,"},{"id":"seytek-1991-continuation:p0316:b002:l018","ordinal":384442,"en":"He would turn him yellow as gold,"},{"id":"seytek-1991-continuation:p0316:b002:l019","ordinal":384443,"en":"Drain all strength from his limbs,"},{"id":"seytek-1991-continuation:p0316:b002:l020","ordinal":384444,"en":"And afflict him with jaundice."},{"id":"seytek-1991-continuation:p0316:b002:l021","ordinal":384445,"en":"If the foe pressed upon his throat,"},{"id":"seytek-1991-continuation:p0316:b002:l022","ordinal":384446,"en":"He meant to seize his people and possessions."},{"id":"seytek-1991-continuation:p0316:b002:l023","ordinal":384447,"en":"If a foe came forth to challenge him,"},{"id":"seytek-1991-continuation:p0316:b002:l024","ordinal":384448,"en":"He would pursue vengeance for six generations of fathers,"},{"id":"seytek-1991-continuation:p0316:b002:l025","ordinal":384449,"en":"Turn him yellow as jaundice,"},{"id":"seytek-1991-continuation:p0316:b002:l026","ordinal":384450,"en":"And take revenge."},{"id":"seytek-1991-continuation:p0316:b002:l027","ordinal":384451,"en":"A mighty bird of prey came to the perch,"},{"id":"seytek-1991-continuation:p0316:b002:l028","ordinal":384452,"en":"The falcon Kenen came into the world,"},{"id":"seytek-1991-continuation:p0316:b002:l029","ordinal":384453,"en":"They devised wonders no man had conceived,"},{"id":"seytek-1991-continuation:p0316:b002:l030","ordinal":384454,"en":"And held a feast that satisfied the world,"},{"id":"seytek-1991-continuation:p0316:b002:l031","ordinal":384455,"en":"The people’s hearts found peace,"},{"id":"seytek-1991-continuation:p0316:b002:l032","ordinal":384456,"en":"At word that Seytek had seen Kenen,"},{"id":"seytek-1991-continuation:p0316:b002:l033","ordinal":384457,"en":"The multitude throughout Ala-Too,"},{"id":"seytek-1991-continuation:p0316:b002:l034","ordinal":384458,"en":"With vast treasure and mighty fortune,"},{"id":"seytek-1991-continuation:p0316:b002:l035","ordinal":384459,"en":"Were overcome with tenderness,"},{"id":"seytek-1991-continuation:p0316:b002:l036","ordinal":384460,"en":"Their living hearts rejoiced,"},{"id":"seytek-1991-continuation:p0316:b002:l037","ordinal":384461,"en":"For at his birth the signs"},{"id":"seytek-1991-continuation:p0316:b002:l038","ordinal":384462,"en":"Showed that he would be a lion,"},{"id":"seytek-1991-continuation:p0316:b002:l039","ordinal":384463,"en":"Without delay they prepared a feast,"},{"id":"seytek-1991-continuation:p0316:b002:l040","ordinal":384464,"en":"And the great host surged with excitement,"},{"id":"seytek-1991-continuation:p0316:b002:l041","ordinal":384465,"en":"With meat heaped like Ala-Too,"},{"id":"seytek-1991-continuation:p0316:b002:l042","ordinal":384466,"en":"And broth spread like Ala-Köl,"},{"id":"seytek-1991-continuation:p0316:b002:l043","ordinal":384467,"en":"The tumultuous revelry of the feast"},{"id":"seytek-1991-continuation:p0316:b002:l044","ordinal":384468,"en":"Subsided after nine days,"},{"id":"seytek-1991-continuation:p0316:b002:l045","ordinal":384469,"en":"The entertainment had been abundant,"},{"id":"seytek-1991-continuation:p0316:b002:l046","ordinal":384470,"en":"And the people’s longing was fulfilled,"},{"id":"seytek-1991-continuation:p0316:b002:l047","ordinal":384471,"en":"He became a giant no horse could bear,"},{"id":"seytek-1991-continuation:p0316:b002:l048","ordinal":384472,"en":"And became lord of all the Kyrgyz,"},{"id":"seytek-1991-continuation:p0316:b002:l049","ordinal":384473,"en":"A glorious khan,"},{"id":"seytek-1991-continuation:p0317:b001:l001","ordinal":384474,"en":"A man whose weight was like a mountain."},{"id":"seytek-1991-continuation:p0317:b001:l002","ordinal":384475,"en":"He now came to bear the name Kenen,"},{"id":"seytek-1991-continuation:p0317:b001:l003","ordinal":384476,"en":"The hero now became his people’s fortress."},{"id":"seytek-1991-continuation:p0317:b001:l004","ordinal":384477,"en":"He now mounted Kertulpar,"},{"id":"seytek-1991-continuation:p0317:b001:l005","ordinal":384478,"en":"And as a majestic khan,"},{"id":"seytek-1991-continuation:p0317:b001:l006","ordinal":384479,"en":"He ruled the people."},{"id":"seytek-1991-continuation:p0317:b001:l007","ordinal":384480,"en":"While matters stood thus,"},{"id":"seytek-1991-continuation:p0317:b001:l008","ordinal":384481,"en":"Janaaly and Karach were khans,"},{"id":"seytek-1991-continuation:p0317:b001:l009","ordinal":384482,"en":"The two had been born as twins,"},{"id":"seytek-1991-continuation:p0317:b001:l010","ordinal":384483,"en":"They stirred the people and ruined nations,"},{"id":"seytek-1991-continuation:p0317:b001:l011","ordinal":384484,"en":"Those accursed madmen, blazing until death,"},{"id":"seytek-1991-continuation:p0317:b001:l012","ordinal":384485,"en":"From ancient times had borne"},{"id":"seytek-1991-continuation:p0317:b001:l013","ordinal":384486,"en":"Enmity toward the fierce leopard."},{"id":"seytek-1991-continuation:p0317:b001:l014","ordinal":384487,"en":"From those khans Janaaly and Karach,"},{"id":"seytek-1991-continuation:p0317:b001:l015","ordinal":384488,"en":"The two giants Ebegey and Kögöy"},{"id":"seytek-1991-continuation:p0317:b001:l016","ordinal":384489,"en":"Were born beyond all reckoning."},{"id":"seytek-1991-continuation:p0317:b001:l017","ordinal":384490,"en":"Beyond Bukhara and Sharip,"},{"id":"seytek-1991-continuation:p0317:b001:l018","ordinal":384491,"en":"This side of ancient Chambyl,"},{"id":"seytek-1991-continuation:p0317:b001:l019","ordinal":384492,"en":"Lay Belendi’s Sary-Bel,"},{"id":"seytek-1991-continuation:p0317:b001:l020","ordinal":384493,"en":"And they were born in Sary-Bel."},{"id":"seytek-1991-continuation:p0317:b001:l021","ordinal":384494,"en":"The two giants Ebegey and Kögöy"},{"id":"seytek-1991-continuation:p0317:b001:l022","ordinal":384495,"en":"Recently heard tidings from caravans,"},{"id":"seytek-1991-continuation:p0317:b001:l023","ordinal":384496,"en":"They heard that Semetey was dead, and his wretched son"},{"id":"seytek-1991-continuation:p0317:b001:l024","ordinal":384497,"en":"Seytek remained,"},{"id":"seytek-1991-continuation:p0317:b001:l025","ordinal":384498,"en":"Black-headed and cloven-footed,"},{"id":"seytek-1991-continuation:p0317:b001:l026","ordinal":384499,"en":"Led about by the hero Joltoy,"},{"id":"seytek-1991-continuation:p0317:b001:l027","ordinal":384500,"en":"Like so much livestock, they heard,"},{"id":"seytek-1991-continuation:p0317:b001:l028","ordinal":384501,"en":"So they advanced to wage war,"},{"id":"seytek-1991-continuation:p0317:b001:l029","ordinal":384502,"en":"To avenge an ancient grudge,"},{"id":"seytek-1991-continuation:p0317:b001:l030","ordinal":384503,"en":"Shrouding themselves as in mourning,"},{"id":"seytek-1991-continuation:p0317:b001:l031","ordinal":384504,"en":"And gathering again like clouds"},{"id":"seytek-1991-continuation:p0317:b001:l032","ordinal":384505,"en":"About to pour a violent rain,"},{"id":"seytek-1991-continuation:p0317:b001:l033","ordinal":384506,"en":"Ebegey and Kögöy thirsted for blood,"},{"id":"seytek-1991-continuation:p0317:b001:l034","ordinal":384507,"en":"The fools raged,"},{"id":"seytek-1991-continuation:p0317:b001:l035","ordinal":384508,"en":"The murderous lions sought battle,"},{"id":"seytek-1991-continuation:p0317:b001:l036","ordinal":384509,"en":"And the black earth grew hard beneath them."},{"id":"seytek-1991-continuation:p0317:b001:l037","ordinal":384510,"en":"They roared and thundered,"},{"id":"seytek-1991-continuation:p0317:b001:l038","ordinal":384511,"en":"And loaded their great guns,"},{"id":"seytek-1991-continuation:p0317:b001:l039","ordinal":384512,"en":"Oh, my child, the black earth, unable to overturn,"}]
