[{"id":"semetey-1-2013:p1353:b003:l007","ordinal":180481,"en":"Mounted a horse like a blue courser,"},{"id":"semetey-1-2013:p1353:b003:l008","ordinal":180482,"en":"And on the plain of Üch-Koshoy,"},{"id":"semetey-1-2013:p1353:b003:l009","ordinal":180483,"en":"Your elder, old Bakay,"},{"id":"semetey-1-2013:p1353:b003:l010","ordinal":180484,"en":"Beside broad Talas,"},{"id":"semetey-1-2013:p1353:b003:l011","ordinal":180485,"en":"When the predawn hour sounded"},{"id":"semetey-1-2013:p1353:b003:l012","ordinal":180486,"en":"And dawn grew bright,"},{"id":"semetey-1-2013:p1353:b003:l013","ordinal":180487,"en":"His saintly uncle Bakay"},{"id":"semetey-1-2013:p1353:b003:l014","ordinal":180488,"en":"Woke with a start from sleep,"},{"id":"semetey-1-2013:p1353:b003:l015","ordinal":180489,"en":"Turned onto his right side,"},{"id":"semetey-1-2013:p1353:b003:l016","ordinal":180490,"en":"Dipped his hands in water,"},{"id":"semetey-1-2013:p1353:b003:l017","ordinal":180491,"en":"Performed his ablutions,"},{"id":"semetey-1-2013:p1353:b003:l018","ordinal":180492,"en":"Prayed to the one God,"},{"id":"semetey-1-2013:p1353:b003:l019","ordinal":180493,"en":"Quickly recited the namaz,"},{"id":"semetey-1-2013:p1353:b003:l020","ordinal":180494,"en":"And saddled the blue courser."},{"id":"semetey-1-2013:p1353:b003:l021","ordinal":180495,"en":"He girded on his curved sword,"},{"id":"semetey-1-2013:p1353:b003:l022","ordinal":180496,"en":"Paused deep in thought,"},{"id":"semetey-1-2013:p1353:b003:l023","ordinal":180497,"en":"To the young son of Oyrong,"},{"id":"semetey-1-2013:p1353:b003:l024","ordinal":180498,"en":"To come and take counsel,"},{"id":"semetey-1-2013:p1353:b003:l025","ordinal":180499,"en":"He returned to his former concern."},{"id":"semetey-1-2013:p1353:b003:l026","ordinal":180500,"en":"Straining like a lion,"},{"id":"semetey-1-2013:p1353:b003:l027","ordinal":180501,"en":"Your lion uncle Bakay"},{"id":"semetey-1-2013:p1353:b003:l028","ordinal":180502,"en":"Received wisdom from the unseen;"},{"id":"semetey-1-2013:p1353:b003:l029","ordinal":180503,"en":"To the house of Jetigen,"},{"id":"semetey-1-2013:p1353:b003:l030","ordinal":180504,"en":"Bakai made ready and arrived."},{"id":"semetey-1-2013:p1353:b003:l031","ordinal":180505,"en":"All the weapons—"},{"id":"semetey-1-2013:p1353:b003:l032","ordinal":180506,"en":"Bakai brought them,"},{"id":"semetey-1-2013:p1353:b003:l033","ordinal":180507,"en":"And into Semetey's palace"},{"id":"semetey-1-2013:p1353:b003:l034","ordinal":180508,"en":"Bakai carried them."},{"id":"semetey-1-2013:p1353:b003:l035","ordinal":180509,"en":"The old man faced a hard journey;"},{"id":"semetey-1-2013:p1353:b003:l036","ordinal":180510,"en":"While alive his eyes were open;"},{"id":"semetey-1-2013:p1353:b003:l037","ordinal":180511,"en":"Death is shared, and speech is plain."},{"id":"semetey-1-2013:p1353:b003:l038","ordinal":180512,"en":"He found words in sudden need"},{"id":"semetey-1-2013:p1353:b003:l039","ordinal":180513,"en":"And found sight in darkness."},{"id":"semetey-1-2013:p1353:b005:l001","ordinal":180514,"en":"When he spoke harshly, none recognized him;"},{"id":"semetey-1-2013:p1353:b005:l002","ordinal":180515,"en":"In moonless darkness,"},{"id":"semetey-1-2013:p1353:b005:l003","ordinal":180516,"en":"He never lost the corsac's trail."},{"id":"semetey-1-2013:p1353:b005:l004","ordinal":180517,"en":"While exhausted Manas lived,"},{"id":"semetey-1-2013:p1353:b005:l005","ordinal":180518,"en":"When armies moved glittering by tens of thousands,"},{"id":"semetey-1-2013:p1353:b005:l006","ordinal":180519,"en":"Marching in their full multitude,"},{"id":"semetey-1-2013:p1353:b005:l007","ordinal":180520,"en":"Lion butcher Bakay"},{"id":"semetey-1-2013:p1353:b005:l008","ordinal":180521,"en":"Was leader of the moving host."},{"id":"semetey-1-2013:p1353:b005:l009","ordinal":180522,"en":"The old man who bore the banner"},{"id":"semetey-1-2013:p1353:b005:l010","ordinal":180523,"en":"Was the saint who served"},{"id":"semetey-1-2013:p1353:b005:l011","ordinal":180524,"en":"As butcher Oyrong Manas's standard."},{"id":"semetey-1-2013:p1353:b005:l012","ordinal":180525,"en":"Hearing that the hero's brave son"},{"id":"semetey-1-2013:p1353:b005:l013","ordinal":180526,"en":"Would gird his waist firmly"},{"id":"semetey-1-2013:p1353:b005:l014","ordinal":180527,"en":"And pursue the hero's blood price"},{"id":"semetey-1-2013:p1353:b005:l015","ordinal":180528,"en":"From the Kalmyks in Beijing,"},{"id":"semetey-1-2013:p1353:b005:l016","ordinal":180529,"en":"Putting on his battle clothes,"},{"id":"semetey-1-2013:p1353:b005:l017","ordinal":180530,"en":"Your dear khan and uncle Bakay,"},{"id":"semetey-1-2013:p1353:b005:l018","ordinal":180531,"en":"He hung the golden-jawed battle-axe"},{"id":"semetey-1-2013:p1353:b005:l019","ordinal":180532,"en":"From his wrist,"},{"id":"semetey-1-2013:p1353:b005:l020","ordinal":180533,"en":"Put on his warrior's garments,"},{"id":"semetey-1-2013:p1353:b005:l021","ordinal":180534,"en":"And placed upon his head"},{"id":"semetey-1-2013:p1353:b005:l022","ordinal":180535,"en":"A helmet of blue steel."},{"id":"semetey-1-2013:p1353:b005:l023","ordinal":180536,"en":"As the sun began to shimmer upward,"},{"id":"semetey-1-2013:p1353:b005:l024","ordinal":180537,"en":"On the plain of broad Talas,"},{"id":"semetey-1-2013:p1353:b005:l025","ordinal":180538,"en":"Facing Üch-Koshoy,"},{"id":"semetey-1-2013:p1353:b005:l026","ordinal":180539,"en":"At the edge where the Talas flows,"},{"id":"semetey-1-2013:p1353:b005:l027","ordinal":180540,"en":"Below Tört-Kül,"},{"id":"semetey-1-2013:p1353:b005:l028","ordinal":180541,"en":"In the celebrated garden"},{"id":"semetey-1-2013:p1353:b005:l029","ordinal":180542,"en":"First planted by Manas,"},{"id":"semetey-1-2013:p1353:b005:l030","ordinal":180543,"en":"At the black eye of the spring,"},{"id":"semetey-1-2013:p1353:b005:l031","ordinal":180544,"en":"Beside the tall plane tree,"},{"id":"semetey-1-2013:p1353:b005:l032","ordinal":180545,"en":"Within the gated fortress,"},{"id":"semetey-1-2013:p1353:b005:l033","ordinal":180546,"en":"At Kanykey's palace,"},{"id":"semetey-1-2013:p1353:b005:l034","ordinal":180547,"en":"Were five guest palaces,"},{"id":"semetey-1-2013:p1353:b005:l035","ordinal":180548,"en":"Built exceedingly strong;"},{"id":"semetey-1-2013:p1353:b005:l036","ordinal":180549,"en":"Its guards were beyond number,"},{"id":"semetey-1-2013:p1353:b005:l037","ordinal":180550,"en":"And still more were its sentries."},{"id":"semetey-1-2013:p1353:b005:l038","ordinal":180551,"en":"When an enemy appeared,"},{"id":"semetey-1-2013:p1353:b005:l039","ordinal":180552,"en":"They closed it in an instant,"},{"id":"semetey-1-2013:p1354:b003:l001","ordinal":180553,"en":"So no one could approach and enter."},{"id":"semetey-1-2013:p1354:b003:l002","ordinal":180554,"en":"Human noses and ears,"},{"id":"semetey-1-2013:p1354:b003:l003","ordinal":180555,"en":"Worn as amulets,"},{"id":"semetey-1-2013:p1354:b003:l004","ordinal":180556,"en":"By seventy executioners;"},{"id":"semetey-1-2013:p1354:b003:l005","ordinal":180557,"en":"Your skillful uncle Bakay"},{"id":"semetey-1-2013:p1354:b003:l006","ordinal":180558,"en":"Reached and entered the palace."},{"id":"semetey-1-2013:p1354:b003:l007","ordinal":180559,"en":"The great gate in the wall"},{"id":"semetey-1-2013:p1354:b003:l008","ordinal":180560,"en":"Opened its broad mouth."},{"id":"semetey-1-2013:p1354:b003:l009","ordinal":180561,"en":"When exemplary Bakay arrived,"},{"id":"semetey-1-2013:p1354:b003:l010","ordinal":180562,"en":"Within that palace"},{"id":"semetey-1-2013:p1354:b003:l011","ordinal":180563,"en":"Apples and raisins were scattered,"},{"id":"semetey-1-2013:p1354:b003:l012","ordinal":180564,"en":"And his elder, old Bakay,"},{"id":"semetey-1-2013:p1354:b004:l001","ordinal":180565,"en":"Was taken toward the guest palace"},{"id":"semetey-1-2013:p1354:b004:l002","ordinal":180566,"en":"And received as a guest."},{"id":"semetey-1-2013:p1354:b004:l003","ordinal":180567,"en":"They slaughtered a colt and set out tea,"},{"id":"semetey-1-2013:p1354:b004:l004","ordinal":180568,"en":"And laid out the food in abundance,"},{"id":"semetey-1-2013:p1354:b004:l005","ordinal":180569,"en":"Heaping sugar like snow,"},{"id":"semetey-1-2013:p1354:b004:l006","ordinal":180570,"en":"And piling up yellow butter."},{"id":"semetey-1-2013:p1354:b004:l007","ordinal":180571,"en":"They boiled and served"},{"id":"semetey-1-2013:p1354:b004:l008","ordinal":180572,"en":"A fat lamb and a choice head."},{"id":"semetey-1-2013:p1354:b004:l009","ordinal":180573,"en":"When they had eaten their fill,"},{"id":"semetey-1-2013:p1354:b004:l010","ordinal":180574,"en":"His elder, old Bakay,"},{"id":"semetey-1-2013:p1354:b004:l011","ordinal":180575,"en":"Spread his hands and said, “Amen!”"},{"id":"semetey-1-2013:p1354:b004:l012","ordinal":180576,"en":"And gave a new blessing."},{"id":"semetey-1-2013:p1354:b006:l001","ordinal":180577,"en":"Your dear mother Kanykey,"},{"id":"semetey-1-2013:p1354:b006:l002","ordinal":180578,"en":"Her saintly nature showing,"},{"id":"semetey-1-2013:p1354:b006:l003","ordinal":180579,"en":"Wondered what fate awaited the youth"},{"id":"semetey-1-2013:p1354:b006:l004","ordinal":180580,"en":"Whom she had seen when near death;"},{"id":"semetey-1-2013:p1354:b006:l005","ordinal":180581,"en":"Her tears poured down:"},{"id":"semetey-1-2013:p1354:b006:l006","ordinal":180582,"en":"“To Beijing, whence those who go do not return,"},{"id":"semetey-1-2013:p1354:b006:l007","ordinal":180583,"en":"Elder, old Bakay,"},{"id":"semetey-1-2013:p1354:b006:l008","ordinal":180584,"en":"If you take the boy as your support"},{"id":"semetey-1-2013:p1354:b006:l009","ordinal":180585,"en":"And set out upon the road,"},{"id":"semetey-1-2013:p1354:b006:l010","ordinal":180586,"en":"Beijing is a place of calamity."},{"id":"semetey-1-2013:p1354:b006:l011","ordinal":180587,"en":"No one has bowed and conquered it;"},{"id":"semetey-1-2013:p1354:b006:l012","ordinal":180588,"en":"Whoever attacked it did not survive."},{"id":"semetey-1-2013:p1354:b006:l013","ordinal":180589,"en":"To Beijing, whence those who go do not return,"},{"id":"semetey-1-2013:p1354:b006:l014","ordinal":180590,"en":"Elder, old Bakay,"},{"id":"semetey-1-2013:p1354:b006:l015","ordinal":180591,"en":"If you set out upon the road,"},{"id":"semetey-1-2013:p1354:b006:l016","ordinal":180592,"en":"The one you fight is Kakan-Chyn,"},{"id":"semetey-1-2013:p1354:b006:l017","ordinal":180593,"en":"Who never retreats when attacked."},{"id":"semetey-1-2013:p1354:b006:l018","ordinal":180594,"en":"What people have inhabited Beijing?"},{"id":"semetey-1-2013:p1354:b006:l019","ordinal":180595,"en":"Those who faced it did not return safely."},{"id":"semetey-1-2013:p1354:b006:l020","ordinal":180596,"en":"To Beijing beyond a saint's reach,"},{"id":"semetey-1-2013:p1354:b006:l021","ordinal":180597,"en":"My dear uncle,"},{"id":"semetey-1-2013:p1354:b006:l022","ordinal":180598,"en":"It would be terrible if you let the fine horse stumble!"},{"id":"semetey-1-2013:p1354:b006:l023","ordinal":180599,"en":"My legacy left by the hero,"},{"id":"semetey-1-2013:p1354:b007:l001","ordinal":180600,"en":"My hope needed by the renowned people,"},{"id":"semetey-1-2013:p1354:b007:l002","ordinal":180601,"en":"My dear uncle,"},{"id":"semetey-1-2013:p1354:b007:l003","ordinal":180602,"en":"I entrust him to you!"},{"id":"semetey-1-2013:p1354:b007:l004","ordinal":180603,"en":"My youthful son left by the butcher,"},{"id":"semetey-1-2013:p1354:b007:l005","ordinal":180604,"en":"Royal uncle, I entrust him to you!"},{"id":"semetey-1-2013:p1354:b007:l006","ordinal":180605,"en":"Following your imposing figure,"},{"id":"semetey-1-2013:p1354:b007:l007","ordinal":180606,"en":"You have begun a campaign against the khan."},{"id":"semetey-1-2013:p1354:b007:l008","ordinal":180607,"en":"The small Argyn and Ogoy people,"},{"id":"semetey-1-2013:p1354:b007:l009","ordinal":180608,"en":"Elder, lion Bakay,"},{"id":"semetey-1-2013:p1354:b007:l010","ordinal":180609,"en":"You have again left without protection!"},{"id":"semetey-1-2013:p1354:b007:l011","ordinal":180610,"en":"To Beijing beyond even a holy man's reach,"},{"id":"semetey-1-2013:p1354:b007:l012","ordinal":180611,"en":"Uncle, it would be terrible if you lost him;"},{"id":"semetey-1-2013:p1354:b007:l013","ordinal":180612,"en":"My only one left by the magnanimous hero,"},{"id":"semetey-1-2013:p1354:b007:l014","ordinal":180613,"en":"Uncle, I entrust him to you!"},{"id":"semetey-1-2013:p1354:b007:l015","ordinal":180614,"en":"Return without letting him enter battle;"},{"id":"semetey-1-2013:p1354:b007:l016","ordinal":180615,"en":"Royal uncle Bakay, hear my words!"},{"id":"semetey-1-2013:p1354:b007:l017","ordinal":180616,"en":"Kakan-Chyn's Beijing"},{"id":"semetey-1-2013:p1354:b007:l018","ordinal":180617,"en":"Has a teeming people;"},{"id":"semetey-1-2013:p1354:b007:l019","ordinal":180618,"en":"They leave no attacker unharmed,"},{"id":"semetey-1-2013:p1354:b007:l020","ordinal":180619,"en":"And have a custom of drinking his blood."},{"id":"semetey-1-2013:p1354:b007:l021","ordinal":180620,"en":"It has roads unknown to man,"},{"id":"semetey-1-2013:p1354:b007:l022","ordinal":180621,"en":"And its strength reaches across the world;"},{"id":"semetey-1-2013:p1354:b007:l023","ordinal":180622,"en":"It has the renowned mighty Kongur."},{"id":"semetey-1-2013:p1355:b003:l001","ordinal":180623,"en":"Beijing is no easy place,"},{"id":"semetey-1-2013:p1355:b003:l002","ordinal":180624,"en":"Nor are they a people easily faced!"},{"id":"semetey-1-2013:p1355:b003:l003","ordinal":180625,"en":"No one has brought them low;"},{"id":"semetey-1-2013:p1355:b003:l004","ordinal":180626,"en":"None who encountered them remained alive."},{"id":"semetey-1-2013:p1355:b003:l005","ordinal":180627,"en":"My khan and uncle Bakai, you know this!"},{"id":"semetey-1-2013:p1355:b003:l006","ordinal":180628,"en":"Heroes died upon the road they scouted;"},{"id":"semetey-1-2013:p1355:b003:l007","ordinal":180629,"en":"Valiant men died and khans died;"},{"id":"semetey-1-2013:p1355:b003:l008","ordinal":180630,"en":"Every soul that met them died."},{"id":"semetey-1-2013:p1355:b003:l009","ordinal":180631,"en":"Many giants who attacked them died;"},{"id":"semetey-1-2013:p1355:b003:l010","ordinal":180632,"en":"Grappling and fighting,"},{"id":"semetey-1-2013:p1355:b003:l011","ordinal":180633,"en":"All the lions died together."},{"id":"semetey-1-2013:p1355:b003:l012","ordinal":180634,"en":"When I speak, I have this grief;"},{"id":"semetey-1-2013:p1355:b003:l013","ordinal":180635,"en":"My auspicious uncle, listen well!"},{"id":"semetey-1-2013:p1355:b003:l014","ordinal":180636,"en":"Radiance-pouring Great Beijing"},{"id":"semetey-1-2013:p1355:b003:l015","ordinal":180637,"en":"Is no place to trample underfoot;"},{"id":"semetey-1-2013:p1355:b003:l016","ordinal":180638,"en":"The Chinese are numerous as ants,"},{"id":"semetey-1-2013:p1355:b003:l017","ordinal":180639,"en":"No people who yield their companions."},{"id":"semetey-1-2013:p1355:b003:l018","ordinal":180640,"en":"In the khagan's realm are the Black Chinese;"},{"id":"semetey-1-2013:p1355:b003:l019","ordinal":180641,"en":"Their arrogance is great and they have no faith."},{"id":"semetey-1-2013:p1355:b003:l020","ordinal":180642,"en":"Saying you will go and take Beijing,"},{"id":"semetey-1-2013:p1355:b003:l021","ordinal":180643,"en":"You have begun this calamity—"},{"id":"semetey-1-2013:p1355:b003:l022","ordinal":180644,"en":"Such is this filthy world!"},{"id":"semetey-1-2013:p1355:b003:l023","ordinal":180645,"en":"The boys you rely upon"},{"id":"semetey-1-2013:p1355:b003:l024","ordinal":180646,"en":"Have not yet begun to face"},{"id":"semetey-1-2013:p1355:b003:l025","ordinal":180647,"en":"And enter mighty, turbulent Beijing;"},{"id":"semetey-1-2013:p1355:b003:l026","ordinal":180648,"en":"They do not yet know the stratagems of war,"},{"id":"semetey-1-2013:p1355:b003:l027","ordinal":180649,"en":"Nor have they campaigned against an enemy."},{"id":"semetey-1-2013:p1355:b003:l028","ordinal":180650,"en":"That they would bring turmoil to Beijing,"},{"id":"semetey-1-2013:p1355:b003:l029","ordinal":180651,"en":"I knew from the beginning with great fear;"},{"id":"semetey-1-2013:p1355:b003:l030","ordinal":180652,"en":"Against the khan of Kakan-Chyn,"},{"id":"semetey-1-2013:p1355:b003:l031","ordinal":180653,"en":"I knew they would grapple!"},{"id":"semetey-1-2013:p1355:b003:l032","ordinal":180654,"en":"I knew long ago you would go;"},{"id":"semetey-1-2013:p1355:b003:l033","ordinal":180655,"en":"I had the whole earth searched"},{"id":"semetey-1-2013:p1355:b003:l034","ordinal":180656,"en":"And costly crimson materials"},{"id":"semetey-1-2013:p1355:b003:l035","ordinal":180657,"en":"Fetched from many lands!"},{"id":"semetey-1-2013:p1355:b003:l036","ordinal":180658,"en":"It will not admit a bullet in battle,"},{"id":"semetey-1-2013:p1355:b003:l037","ordinal":180659,"en":"Nor an ember when saxaul burns;"},{"id":"semetey-1-2013:p1355:b003:l038","ordinal":180660,"en":"I lined its inside with silk,"},{"id":"semetey-1-2013:p1355:b003:l039","ordinal":180661,"en":"And had it worked without pause for eight years."},{"id":"semetey-1-2013:p1355:b005:l001","ordinal":180662,"en":"I sent it from master to master,"},{"id":"semetey-1-2013:p1355:b005:l002","ordinal":180663,"en":"So no stray bullet could pass;"},{"id":"semetey-1-2013:p1355:b005:l003","ordinal":180664,"en":"I had experts test it."},{"id":"semetey-1-2013:p1355:b005:l004","ordinal":180665,"en":"I had them reject what was unsuitable;"},{"id":"semetey-1-2013:p1355:b005:l005","ordinal":180666,"en":"Plate after plate of steel,"},{"id":"semetey-1-2013:p1355:b005:l006","ordinal":180667,"en":"Filed with an Albar's blade and mixed,"},{"id":"semetey-1-2013:p1355:b005:l007","ordinal":180668,"en":"I had poured into its middle."},{"id":"semetey-1-2013:p1355:b005:l008","ordinal":180669,"en":"For a time I fashioned the coat,"},{"id":"semetey-1-2013:p1355:b005:l009","ordinal":180670,"en":"More splendid than all the possessions"},{"id":"semetey-1-2013:p1355:b005:l010","ordinal":180671,"en":"Of my noble prince Manas."},{"id":"semetey-1-2013:p1355:b005:l011","ordinal":180672,"en":"When the six vile men, Abyke and Köbösh,"},{"id":"semetey-1-2013:p1355:b005:l012","ordinal":180673,"en":"Tore away the ak-olpok armor,"},{"id":"semetey-1-2013:p1355:b005:l013","ordinal":180674,"en":"Its fiber remained frayed;"},{"id":"semetey-1-2013:p1355:b005:l014","ordinal":180675,"en":"Those lowborn villains"},{"id":"semetey-1-2013:p1355:b005:l015","ordinal":180676,"en":"Had worn it hanging loose."},{"id":"semetey-1-2013:p1355:b005:l016","ordinal":180677,"en":"At last, when Semetey"},{"id":"semetey-1-2013:p1355:b005:l017","ordinal":180678,"en":"Took it back again,"},{"id":"semetey-1-2013:p1355:b005:l018","ordinal":180679,"en":"Resting neither by day"},{"id":"semetey-1-2013:p1355:b005:l019","ordinal":180680,"en":"Nor sleeping at night,"},{"id":"semetey-1-2013:p1355:b005:l020","ordinal":180681,"en":"I took its weft and spun it,"},{"id":"semetey-1-2013:p1355:b005:l021","ordinal":180682,"en":"So no stray bullet could pass,"},{"id":"semetey-1-2013:p1355:b005:l022","ordinal":180683,"en":"And no needless death overtake him."},{"id":"semetey-1-2013:p1355:b005:l023","ordinal":180684,"en":"From precious materials of every kind,"},{"id":"semetey-1-2013:p1355:b005:l024","ordinal":180685,"en":"I worked them into its hem."},{"id":"semetey-1-2013:p1355:b005:l025","ordinal":180686,"en":"I stretched it on a frame and shaped it."},{"id":"semetey-1-2013:p1355:b005:l026","ordinal":180687,"en":"Far finer than all"},{"id":"semetey-1-2013:p1355:b005:l027","ordinal":180688,"en":"My noble hero had possessed,"},{"id":"semetey-1-2013:p1355:b005:l028","ordinal":180689,"en":"I fitted the ak-olpok armor."},{"id":"semetey-1-2013:p1355:b005:l029","ordinal":180690,"en":"I wearied the eyes that stared at it."},{"id":"semetey-1-2013:p1355:b005:l030","ordinal":180691,"en":"Having steel filed and the Albar's blade"},{"id":"semetey-1-2013:p1355:b005:l031","ordinal":180692,"en":"Ground entirely fine,"},{"id":"semetey-1-2013:p1355:b005:l032","ordinal":180693,"en":"I had it placed between the layers."},{"id":"semetey-1-2013:p1355:b005:l033","ordinal":180694,"en":"I adorned it with gold,"},{"id":"semetey-1-2013:p1355:b005:l034","ordinal":180695,"en":"Lest a spear pierce through"},{"id":"semetey-1-2013:p1355:b005:l035","ordinal":180696,"en":"Any place between its layers."},{"id":"semetey-1-2013:p1355:b005:l036","ordinal":180697,"en":"I slid slender rods through it."},{"id":"semetey-1-2013:p1355:b005:l037","ordinal":180698,"en":"I patched whatever had worn out;"},{"id":"semetey-1-2013:p1355:b005:l038","ordinal":180699,"en":"Resting neither by day"},{"id":"semetey-1-2013:p1355:b005:l039","ordinal":180700,"en":"Nor sleeping at night,"},{"id":"semetey-1-2013:p1356:b003:l001","ordinal":180701,"en":"I fitted it anew from the beginning."},{"id":"semetey-1-2013:p1356:b003:l002","ordinal":180702,"en":"I had ornament set upon its collar"},{"id":"semetey-1-2013:p1356:b003:l003","ordinal":180703,"en":"And wound it in twelve layers."},{"id":"semetey-1-2013:p1356:b003:l004","ordinal":180704,"en":"For the clash with the teeming infidel,"},{"id":"semetey-1-2013:p1356:b003:l005","ordinal":180705,"en":"With hero Khan Kongurbai,"},{"id":"semetey-1-2013:p1356:b003:l006","ordinal":180706,"en":"I intended it!"},{"id":"semetey-1-2013:p1356:b003:l007","ordinal":180707,"en":"So they might stand face-to-face,"},{"id":"semetey-1-2013:p1356:b003:l008","ordinal":180708,"en":"Firing guns and drawing bows,"},{"id":"semetey-1-2013:p1356:b003:l009","ordinal":180709,"en":"And throw themselves into the shooting;"},{"id":"semetey-1-2013:p1356:b003:l010","ordinal":180710,"en":"I repaired what was chipped,"},{"id":"semetey-1-2013:p1356:b003:l011","ordinal":180711,"en":"So the spear of that swine,"},{"id":"semetey-1-2013:p1356:b003:l012","ordinal":180712,"en":"The khan of the Kechil, could not pass through."},{"id":"semetey-1-2013:p1356:b003:l013","ordinal":180713,"en":"I, unfortunate Kanykey,"},{"id":"semetey-1-2013:p1356:b003:l014","ordinal":180714,"en":"Truly repaired the ak-olpok armor"},{"id":"semetey-1-2013:p1356:b003:l015","ordinal":180715,"en":"Left by Manas!"},{"id":"semetey-1-2013:p1356:b003:l016","ordinal":180716,"en":"The heroic khan's ak-olpok armor—"},{"id":"semetey-1-2013:p1356:b003:l017","ordinal":180717,"en":"So my valiant orphan might wear it,"},{"id":"semetey-1-2013:p1356:b003:l018","ordinal":180718,"en":"Might face and strike the enemy,"},{"id":"semetey-1-2013:p1356:b003:l019","ordinal":180719,"en":"Drive the opposing Kalcha"},{"id":"semetey-1-2013:p1356:b003:l020","ordinal":180720,"en":"As far as the khagan,"},{"id":"semetey-1-2013:p1356:b003:l021","ordinal":180721,"en":"And drive the heroes he faced"},{"id":"semetey-1-2013:p1356:b003:l022","ordinal":180722,"en":"Into Beijing;"},{"id":"semetey-1-2013:p1356:b003:l023","ordinal":180723,"en":"So upon the teeming khagan"},{"id":"semetey-1-2013:p1356:b003:l024","ordinal":180724,"en":"He might bring utter turmoil;"},{"id":"semetey-1-2013:p1356:b003:l025","ordinal":180725,"en":"So my young son of the bloodthirsty hero"},{"id":"semetey-1-2013:p1356:b003:l026","ordinal":180726,"en":"Might avenge himself upon the bloodthirsty foe;"},{"id":"semetey-1-2013:p1356:b003:l027","ordinal":180727,"en":"If a Kalcha fell into his hands,"},{"id":"semetey-1-2013:p1356:b003:l028","ordinal":180728,"en":"He might drag him along the road"},{"id":"semetey-1-2013:p1356:b003:l029","ordinal":180729,"en":"And display him to the Dungans;"},{"id":"semetey-1-2013:p1356:b003:l030","ordinal":180730,"en":"So if his doom came, he might die,"},{"id":"semetey-1-2013:p1356:b003:l031","ordinal":180731,"en":"And campaign against"},{"id":"semetey-1-2013:p1356:b003:l032","ordinal":180732,"en":"The teeming Chinese;"},{"id":"semetey-1-2013:p1356:b003:l033","ordinal":180733,"en":"There were many wonders when I gave it,"},{"id":"semetey-1-2013:p1356:b003:l034","ordinal":180734,"en":"So my valiant son might see them."},{"id":"semetey-1-2013:p1356:b003:l035","ordinal":180735,"en":"At that difficult time,"},{"id":"semetey-1-2013:p1356:b003:l036","ordinal":180736,"en":"Your mighty mother Kanykey"}]
