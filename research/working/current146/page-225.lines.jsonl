{"id": "sayakbay-ms-current146:pdf225:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 225, "folio": 608, "line_in_page": 10, "raw": "Адыр-кыдыр кезинде,", "text": "Адыр-кыдыр кезинде,", "en": "While crossing hill after hill,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf225:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 225, "folio": 608, "line_in_page": 11, "raw": "Ай талаа менен конгон,", "text": "Ай талаа менен конгон,", "en": "They camped across the moonlit steppe.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf225:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 225, "folio": 608, "line_in_page": 12, "raw": "Токтон кетип баратат,", "text": "Токтон кетип баратат,", "en": "He was departing from abundance.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
