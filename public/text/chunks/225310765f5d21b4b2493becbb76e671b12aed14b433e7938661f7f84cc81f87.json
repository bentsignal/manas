[{"id":"semetey-1-2013:p0861:b003:l037","ordinal":142849,"en":"All of them gathered together,"},{"id":"semetey-1-2013:p0861:b003:l038","ordinal":142850,"en":"Swearing an oath unto death,"},{"id":"semetey-1-2013:p0861:b003:l039","ordinal":142851,"en":"Making their promise firm,"},{"id":"semetey-1-2013:p0861:b004:l001","ordinal":142852,"en":"Manas's only orphan—"},{"id":"semetey-1-2013:p0861:b004:l002","ordinal":142853,"en":"To gather and seize him,"},{"id":"semetey-1-2013:p0861:b004:l003","ordinal":142854,"en":"To offer him as a sacrifice,"},{"id":"semetey-1-2013:p0861:b004:l004","ordinal":142855,"en":"To put him to death,"},{"id":"semetey-1-2013:p0861:b004:l005","ordinal":142856,"en":"To kill him and cut off his life,"},{"id":"semetey-1-2013:p0861:b004:l006","ordinal":142857,"en":"To make him like an extinguished fire—"},{"id":"semetey-1-2013:p0861:b004:l007","ordinal":142858,"en":"All the khans who had come,"},{"id":"semetey-1-2013:p0861:b004:l008","ordinal":142859,"en":"Their elders rich in wisdom,"},{"id":"semetey-1-2013:p0861:b004:l009","ordinal":142860,"en":"Made their promise firm,"},{"id":"semetey-1-2013:p0861:b004:l010","ordinal":142861,"en":"Swore an oath unto death,"},{"id":"semetey-1-2013:p0861:b004:l011","ordinal":142862,"en":"Chewed white wheat flour together,"},{"id":"semetey-1-2013:p0861:b004:l012","ordinal":142863,"en":"Swore to one another on the Quran,"},{"id":"semetey-1-2013:p0861:b004:l013","ordinal":142864,"en":"Slaughtered a white-gray mare,"},{"id":"semetey-1-2013:p0861:b004:l014","ordinal":142865,"en":"A holy Quran the size of a horse's head"},{"id":"semetey-1-2013:p0861:b004:l015","ordinal":142866,"en":"They placed against their chests."},{"id":"semetey-1-2013:p0861:b004:l016","ordinal":142867,"en":"Manas's orphan son—"},{"id":"semetey-1-2013:p0861:b004:l017","ordinal":142868,"en":"Whoever would not seize and slaughter him,"},{"id":"semetey-1-2013:p0861:b004:l018","ordinal":142869,"en":"They called a hero only in fine words,"},{"id":"semetey-1-2013:p0861:b004:l019","ordinal":142870,"en":"Called his seven forefathers unbelievers."},{"id":"semetey-1-2013:p0861:b004:l020","ordinal":142871,"en":"Muttering and roaring,"},{"id":"semetey-1-2013:p0861:b004:l021","ordinal":142872,"en":"From their tumult"},{"id":"semetey-1-2013:p0861:b004:l022","ordinal":142873,"en":"The earth split and rumbled."},{"id":"semetey-1-2013:p0861:b004:l023","ordinal":142874,"en":"And beside Kobosh,"},{"id":"semetey-1-2013:p0861:b004:l024","ordinal":142875,"en":"All forty companions,"},{"id":"semetey-1-2013:p0861:b004:l025","ordinal":142876,"en":"Their elders led by Kyrgyl,"},{"id":"semetey-1-2013:p0861:b004:l026","ordinal":142877,"en":"The skilled among the lancers,"},{"id":"semetey-1-2013:p0861:b004:l027","ordinal":142878,"en":"The finest, rich in wisdom,"},{"id":"semetey-1-2013:p0861:b004:l028","ordinal":142879,"en":"Their lions with elephant-like limbs,"},{"id":"semetey-1-2013:p0861:b004:l029","ordinal":142880,"en":"Their unsparing heroes,"},{"id":"semetey-1-2013:p0861:b004:l030","ordinal":142881,"en":"Those who would not recoil from stone,"},{"id":"semetey-1-2013:p0861:b004:l031","ordinal":142882,"en":"Those who would not turn back at death,"},{"id":"semetey-1-2013:p0861:b004:l032","ordinal":142883,"en":"Their broad-chested warriors,"},{"id":"semetey-1-2013:p0861:b004:l033","ordinal":142884,"en":"Their stately champions—"},{"id":"semetey-1-2013:p0861:b004:l034","ordinal":142885,"en":"Into the midst of that seething army"},{"id":"semetey-1-2013:p0861:b004:l035","ordinal":142886,"en":"Khan Sary Khan came."},{"id":"semetey-1-2013:p0861:b004:l036","ordinal":142887,"en":"Khan Manas's companion,"},{"id":"semetey-1-2013:p0861:b004:l037","ordinal":142888,"en":"The leopard Shuutu—what did he do?"},{"id":"semetey-1-2013:p0861:b004:l038","ordinal":142889,"en":"He said this to Sary Khan:"},{"id":"semetey-1-2013:p0861:b004:l039","ordinal":142890,"en":"“The command Allah has laid upon us—"},{"id":"semetey-1-2013:p0862:b003:l001","ordinal":142891,"en":"You have come to see it,"},{"id":"semetey-1-2013:p0862:b003:l002","ordinal":142892,"en":"Before your appointed death, at their hands"},{"id":"semetey-1-2013:p0862:b003:l003","ordinal":142893,"en":"You have come to die!"},{"id":"semetey-1-2013:p0862:b003:l004","ordinal":142894,"en":"More formidable have grown these dogs'"},{"id":"semetey-1-2013:p0862:b003:l005","ordinal":142895,"en":"Trenches they have dug;"},{"id":"semetey-1-2013:p0862:b003:l006","ordinal":142896,"en":"Do you see them making ready,"},{"id":"semetey-1-2013:p0862:b003:l007","ordinal":142897,"en":"Their armies that will sweep over us?"},{"id":"semetey-1-2013:p0862:b003:l008","ordinal":142898,"en":"For an elder like Baimyrza"},{"id":"semetey-1-2013:p0862:b003:l009","ordinal":142899,"en":"They will not go and render service;"},{"id":"semetey-1-2013:p0862:b003:l010","ordinal":142900,"en":"To Manas's orphan son"},{"id":"semetey-1-2013:p0862:b003:l011","ordinal":142901,"en":"They will not stand as kin."},{"id":"semetey-1-2013:p0862:b003:l012","ordinal":142902,"en":"Rein in over rocky ground,"},{"id":"semetey-1-2013:p0862:b003:l013","ordinal":142903,"en":"To Manas's orphan son"},{"id":"semetey-1-2013:p0862:b003:l014","ordinal":142904,"en":"Go and deliver my greeting."},{"id":"semetey-1-2013:p0862:b003:l015","ordinal":142905,"en":"A great dug pit confronts him,"},{"id":"semetey-1-2013:p0862:b003:l016","ordinal":142906,"en":"Boiling misery has come."},{"id":"semetey-1-2013:p0862:b003:l017","ordinal":142907,"en":"Manas's orphan son—"},{"id":"semetey-1-2013:p0862:b003:l018","ordinal":142908,"en":"If these men sweep over him,"},{"id":"semetey-1-2013:p0862:b003:l019","ordinal":142909,"en":"What will happen? I ask."},{"id":"semetey-1-2013:p0862:b003:l020","ordinal":142910,"en":"Great peril has come upon his dear head."},{"id":"semetey-1-2013:p0862:b003:l021","ordinal":142911,"en":"An unjust claim has arisen;"},{"id":"semetey-1-2013:p0862:b003:l022","ordinal":142912,"en":"Saying, ‘If Semetey comes, I will slaughter him,’"},{"id":"semetey-1-2013:p0862:b003:l023","ordinal":142913,"en":"Saying, ‘I will put him to death,’"},{"id":"semetey-1-2013:p0862:b003:l024","ordinal":142914,"en":"Fierce enemies have come from every side."},{"id":"semetey-1-2013:p0862:b003:l025","ordinal":142915,"en":"They sent throughout Sary-Arka,"},{"id":"semetey-1-2013:p0862:b003:l026","ordinal":142916,"en":"Summoned the sons of the Kazakhs,"},{"id":"semetey-1-2013:p0862:b003:l027","ordinal":142917,"en":"Sent throughout Alty-Shaar,"},{"id":"semetey-1-2013:p0862:b003:l028","ordinal":142918,"en":"Summoned Alabek's army."},{"id":"semetey-1-2013:p0862:b003:l029","ordinal":142919,"en":"He who dwelt in Eki-Kemin,"},{"id":"semetey-1-2013:p0862:b003:l030","ordinal":142920,"en":"Called a hero like an ogre,"},{"id":"semetey-1-2013:p0862:b003:l031","ordinal":142921,"en":"They sent to brave Urbu,"},{"id":"semetey-1-2013:p0862:b003:l032","ordinal":142922,"en":"Summoned his army;"},{"id":"semetey-1-2013:p0862:b003:l033","ordinal":142923,"en":"Muzburchak's Buyanbek—"},{"id":"semetey-1-2013:p0862:b003:l034","ordinal":142924,"en":"They summoned his army too."},{"id":"semetey-1-2013:p0862:b003:l035","ordinal":142925,"en":"“They have a trench dug,"},{"id":"semetey-1-2013:p0862:b003:l036","ordinal":142926,"en":"They have such a seething army,"},{"id":"semetey-1-2013:p0862:b003:l037","ordinal":142927,"en":"They have an orator with a bewitching tongue."},{"id":"semetey-1-2013:p0862:b003:l038","ordinal":142928,"en":"Uncle Sary, hear my words:"},{"id":"semetey-1-2013:p0862:b003:l039","ordinal":142929,"en":"There are many who will deceive you."},{"id":"semetey-1-2013:p0862:b004:l001","ordinal":142930,"en":"Do not yield to their deception,"},{"id":"semetey-1-2013:p0862:b004:l002","ordinal":142931,"en":"Do not enter their royal camp,"},{"id":"semetey-1-2013:p0862:b004:l003","ordinal":142932,"en":"Do not dismount from your horse,"},{"id":"semetey-1-2013:p0862:b004:l004","ordinal":142933,"en":"Do not die an untimely death."},{"id":"semetey-1-2013:p0862:b004:l005","ordinal":142934,"en":"Ready your battle-axe,"},{"id":"semetey-1-2013:p0862:b004:l006","ordinal":142935,"en":"Sharpen your sword and prepare."},{"id":"semetey-1-2013:p0862:b004:l007","ordinal":142936,"en":"What a time, what a day,"},{"id":"semetey-1-2013:p0862:b004:l008","ordinal":142937,"en":"What a night will it be?"},{"id":"semetey-1-2013:p0862:b004:l009","ordinal":142938,"en":"Drinking spirits and panting,"},{"id":"semetey-1-2013:p0862:b004:l010","ordinal":142939,"en":"All the warriors"},{"id":"semetey-1-2013:p0862:b004:l011","ordinal":142940,"en":"Around Abyke and Kobosh"},{"id":"semetey-1-2013:p0862:b004:l012","ordinal":142941,"en":"Struggled as if mad."},{"id":"semetey-1-2013:p0862:b004:l013","ordinal":142942,"en":"Drinking kumys, growing heated,"},{"id":"semetey-1-2013:p0862:b004:l014","ordinal":142943,"en":"Their bones and skin growing hot,"},{"id":"semetey-1-2013:p0862:b004:l015","ordinal":142944,"en":"Wiping sweat from their brows,"},{"id":"semetey-1-2013:p0862:b004:l016","ordinal":142945,"en":"Against Manas's orphan son"},{"id":"semetey-1-2013:p0862:b004:l017","ordinal":142946,"en":"They swore vengeance, pounding the ground."},{"id":"semetey-1-2013:p0862:b004:l018","ordinal":142947,"en":"Their eyes blazed like fire,"},{"id":"semetey-1-2013:p0862:b004:l019","ordinal":142948,"en":"They bit through their lips,"},{"id":"semetey-1-2013:p0862:b004:l020","ordinal":142949,"en":"Roared in fits of rage,"},{"id":"semetey-1-2013:p0862:b004:l021","ordinal":142950,"en":"Unable to stand still, raving,"},{"id":"semetey-1-2013:p0862:b004:l022","ordinal":142951,"en":"Shouting ‘Kobosh!’ as their battle cry."},{"id":"semetey-1-2013:p0862:b004:l023","ordinal":142952,"en":"Speaking words that would not stand,"},{"id":"semetey-1-2013:p0862:b004:l024","ordinal":142953,"en":"Making their promise firm,"},{"id":"semetey-1-2013:p0862:b004:l025","ordinal":142954,"en":"Shouting with all their might,"},{"id":"semetey-1-2013:p0862:b004:l026","ordinal":142955,"en":"They had plunged into tumult;"},{"id":"semetey-1-2013:p0862:b004:l027","ordinal":142956,"en":"Without sobering at all,"},{"id":"semetey-1-2013:p0862:b004:l028","ordinal":142957,"en":"They had plunged into uproar.”"},{"id":"semetey-1-2013:p0862:b004:l029","ordinal":142958,"en":"While they were roaring together,"},{"id":"semetey-1-2013:p0862:b004:l030","ordinal":142959,"en":"Dear Shuutu went to them."},{"id":"semetey-1-2013:p0862:b004:l031","ordinal":142960,"en":"These are the words Shuutu spoke:"},{"id":"semetey-1-2013:p0862:b004:l032","ordinal":142961,"en":"In the midst of the council,"},{"id":"semetey-1-2013:p0862:b004:l033","ordinal":142962,"en":"Shuutu said this:"},{"id":"semetey-1-2013:p0862:b004:l034","ordinal":142963,"en":"“Riding a gray stallion, bearing a banner,"},{"id":"semetey-1-2013:p0862:b004:l035","ordinal":142964,"en":"At the sight of his bearing"},{"id":"semetey-1-2013:p0862:b004:l036","ordinal":142965,"en":"The Kyrgyz people rejoiced."},{"id":"semetey-1-2013:p0862:b004:l037","ordinal":142966,"en":"He tethered the lamb beside the cow,"},{"id":"semetey-1-2013:p0862:b004:l038","ordinal":142967,"en":"His spirits and his kumys"},{"id":"semetey-1-2013:p0862:b004:l039","ordinal":142968,"en":"He made flow across the threshold."},{"id":"semetey-1-2013:p0863:b003:l001","ordinal":142969,"en":"In a single filling of the cauldron"},{"id":"semetey-1-2013:p0863:b003:l002","ordinal":142970,"en":"He boiled the meat of forty yearlings;"},{"id":"semetey-1-2013:p0863:b003:l003","ordinal":142971,"en":"For the destitute poor and needy"},{"id":"semetey-1-2013:p0863:b003:l004","ordinal":142972,"en":"He spread out food and meals."},{"id":"semetey-1-2013:p0863:b003:l005","ordinal":142973,"en":"The rich man's son Baimyrza—"},{"id":"semetey-1-2013:p0863:b003:l006","ordinal":142974,"en":"That generous man has died."},{"id":"semetey-1-2013:p0863:b003:l007","ordinal":142975,"en":"He has become one who will not return or turn back;"},{"id":"semetey-1-2013:p0863:b003:l008","ordinal":142976,"en":"And saw the place of Judgment."},{"id":"semetey-1-2013:p0863:b003:l009","ordinal":142977,"en":"His horse renowned for speed,"},{"id":"semetey-1-2013:p0863:b003:l010","ordinal":142978,"en":"Carrying a letter the size of a palm,"},{"id":"semetey-1-2013:p0863:b003:l011","ordinal":142979,"en":"His bowl-like eyes shining,"},{"id":"semetey-1-2013:p0863:b003:l012","ordinal":142980,"en":"Great Sary Khan has come."},{"id":"semetey-1-2013:p0863:b003:l013","ordinal":142981,"en":"Do not ask what Sary Khan is like:"},{"id":"semetey-1-2013:p0863:b003:l014","ordinal":142982,"en":"His words are sweeter than other men's,"},{"id":"semetey-1-2013:p0863:b003:l015","ordinal":142983,"en":"He has one eye on his forehead, as large as a bucket."},{"id":"semetey-1-2013:p0863:b003:l016","ordinal":142984,"en":"He rides a horse no bullet can catch,"},{"id":"semetey-1-2013:p0863:b003:l017","ordinal":142985,"en":"Wears a coat no bullet can pierce,"},{"id":"semetey-1-2013:p0863:b003:l018","ordinal":142986,"en":"Is clad in blue padded armor."},{"id":"semetey-1-2013:p0863:b003:l019","ordinal":142987,"en":"Had you seen Sary Khan,"},{"id":"semetey-1-2013:p0863:b003:l020","ordinal":142988,"en":"He springs like a blue tiger."},{"id":"semetey-1-2013:p0863:b003:l021","ordinal":142989,"en":"His right shoulder-blade is broad;"},{"id":"semetey-1-2013:p0863:b003:l022","ordinal":142990,"en":"He is a lion who can rout the Oirats."},{"id":"semetey-1-2013:p0863:b003:l023","ordinal":142991,"en":"He is skilled among the lancers;"},{"id":"semetey-1-2013:p0863:b003:l024","ordinal":142992,"en":"Resourceful and adept."},{"id":"semetey-1-2013:p0863:b003:l025","ordinal":142993,"en":"His size is equal to a mountain's,"},{"id":"semetey-1-2013:p0863:b003:l026","ordinal":142994,"en":"Enough to overcome anyone who faces him."},{"id":"semetey-1-2013:p0863:b003:l027","ordinal":142995,"en":"With a warrior's frame and a heart of stone,"},{"id":"semetey-1-2013:p0863:b003:l028","ordinal":142996,"en":"Terrible in majesty, mighty in fury,"},{"id":"semetey-1-2013:p0863:b003:l029","ordinal":142997,"en":"He has the appearance of a dragon."},{"id":"semetey-1-2013:p0863:b003:l030","ordinal":142998,"en":"The hero, brave Semetey's"},{"id":"semetey-1-2013:p0863:b003:l031","ordinal":142999,"en":"Envoy has come: give him an answer!”"},{"id":"semetey-1-2013:p0863:b003:l032","ordinal":143000,"en":"Those who heard this news—"},{"id":"semetey-1-2013:p0863:b003:l033","ordinal":143001,"en":"Eloquent Urbu, the fierce wolf hero,"},{"id":"semetey-1-2013:p0863:b003:l034","ordinal":143002,"en":"His tongue sugar, his heart venom,"},{"id":"semetey-1-2013:p0863:b003:l035","ordinal":143003,"en":"Ran out of the royal camp."},{"id":"semetey-1-2013:p0863:b003:l036","ordinal":143004,"en":"When he saw Sary Khan,"},{"id":"semetey-1-2013:p0863:b003:l037","ordinal":143005,"en":"His eyes blazed like fire;"},{"id":"semetey-1-2013:p0863:b003:l038","ordinal":143006,"en":"His stomach was boiling like fire."},{"id":"semetey-1-2013:p0863:b003:l039","ordinal":143007,"en":"Readying his weapons,"},{"id":"semetey-1-2013:p0863:b004:l001","ordinal":143008,"en":"He girded on his Arkesken sword,"},{"id":"semetey-1-2013:p0863:b004:l002","ordinal":143009,"en":"To seize Sary Khan,"},{"id":"semetey-1-2013:p0863:b004:l003","ordinal":143010,"en":"To offer him as a sacrifice,"},{"id":"semetey-1-2013:p0863:b004:l004","ordinal":143011,"en":"To bring the end of the world upon him,"},{"id":"semetey-1-2013:p0863:b004:l005","ordinal":143012,"en":"Without speaking with him,"},{"id":"semetey-1-2013:p0863:b004:l006","ordinal":143013,"en":"To cut off his head,"},{"id":"semetey-1-2013:p0863:b004:l007","ordinal":143014,"en":"Urbu came prepared."},{"id":"semetey-1-2013:p0863:b004:l008","ordinal":143015,"en":"Behind that Urbu,"},{"id":"semetey-1-2013:p0863:b004:l009","ordinal":143016,"en":"Kokcho's son Umotoy,"},{"id":"semetey-1-2013:p0863:b004:l010","ordinal":143017,"en":"Muzburchak's Buyanbek,"},{"id":"semetey-1-2013:p0863:b004:l011","ordinal":143018,"en":"Came rushing together too."},{"id":"semetey-1-2013:p0863:b004:l012","ordinal":143019,"en":"All forty companions"},{"id":"semetey-1-2013:p0863:b004:l013","ordinal":143020,"en":"Came again to seize him,"},{"id":"semetey-1-2013:p0863:b004:l014","ordinal":143021,"en":"Their elders led by Kyrgyl;"},{"id":"semetey-1-2013:p0863:b004:l015","ordinal":143022,"en":"They rushed upon your khan,"},{"id":"semetey-1-2013:p0863:b004:l016","ordinal":143023,"en":"The whole seething army."},{"id":"semetey-1-2013:p0863:b004:l017","ordinal":143024,"en":"When the army swept toward him,"},{"id":"semetey-1-2013:p0863:b004:l018","ordinal":143025,"en":"He knew they were enemies."},{"id":"semetey-1-2013:p0863:b004:l019","ordinal":143026,"en":"Once he knew they were enemies,"},{"id":"semetey-1-2013:p0863:b004:l020","ordinal":143027,"en":"Unflustered, unhurried, unconcerned,"},{"id":"semetey-1-2013:p0863:b004:l021","ordinal":143028,"en":"All of them—"},{"id":"semetey-1-2013:p0863:b004:l022","ordinal":143029,"en":"What did your dear uncle do?"},{"id":"semetey-1-2013:p0863:b004:l023","ordinal":143030,"en":"He counted them as nothing."},{"id":"semetey-1-2013:p0863:b004:l024","ordinal":143031,"en":"At the head of the advancing army,"},{"id":"semetey-1-2013:p0863:b004:l025","ordinal":143032,"en":"Dear Urbu readied himself"},{"id":"semetey-1-2013:p0863:b004:l026","ordinal":143033,"en":"To seize Sary Khan."},{"id":"semetey-1-2013:p0863:b004:l027","ordinal":143034,"en":"When Urbu came near,"},{"id":"semetey-1-2013:p0863:b004:l028","ordinal":143035,"en":"Within a lance's length,"},{"id":"semetey-1-2013:p0863:b004:l029","ordinal":143036,"en":"Khan Sary in the news"},{"id":"semetey-1-2013:p0863:b004:l030","ordinal":143037,"en":"We are one of those who reason;"},{"id":"semetey-1-2013:p0863:b004:l031","ordinal":143038,"en":"Saying I would be a messenger,"},{"id":"semetey-1-2013:p0863:b004:l032","ordinal":143039,"en":"We are an envoy serving as mediator."},{"id":"semetey-1-2013:p0863:b004:l033","ordinal":143040,"en":"Please stand a little farther away,"},{"id":"semetey-1-2013:p0863:b004:l034","ordinal":143041,"en":"Listen from where you are!"},{"id":"semetey-1-2013:p0863:b004:l035","ordinal":143042,"en":"You come running in a bluster;"},{"id":"semetey-1-2013:p0863:b004:l036","ordinal":143043,"en":"This conduct of yours is unseemly."},{"id":"semetey-1-2013:p0863:b004:l037","ordinal":143044,"en":"I see in my mind that you are an enemy."},{"id":"semetey-1-2013:p0863:b004:l038","ordinal":143045,"en":"Stand where you are!"},{"id":"semetey-1-2013:p0863:b004:l039","ordinal":143046,"en":"I have come as a messenger,"},{"id":"semetey-1-2013:p0864:b003:l001","ordinal":143047,"en":"Look and listen to my words."},{"id":"semetey-1-2013:p0864:b003:l002","ordinal":143048,"en":"Your wrestlers rush upon me;"},{"id":"semetey-1-2013:p0864:b003:l003","ordinal":143049,"en":"You look as though you mean to bind me."},{"id":"semetey-1-2013:p0864:b003:l004","ordinal":143050,"en":"Your fury is extraordinary."},{"id":"semetey-1-2013:p0864:b003:l005","ordinal":143051,"en":"Your stature and your bearing,"},{"id":"semetey-1-2013:p0864:b003:l006","ordinal":143052,"en":"Your appearance on horseback—"},{"id":"semetey-1-2013:p0864:b003:l007","ordinal":143053,"en":"You have shown a hostile face!"},{"id":"semetey-1-2013:p0864:b003:l008","ordinal":143054,"en":"Drinking kumys and shouting,"},{"id":"semetey-1-2013:p0864:b003:l009","ordinal":143055,"en":"Drinking spirits and panting,"},{"id":"semetey-1-2013:p0864:b003:l010","ordinal":143056,"en":"All of you raving and struggling"},{"id":"semetey-1-2013:p0864:b003:l011","ordinal":143057,"en":"To seize me,"},{"id":"semetey-1-2013:p0864:b003:l012","ordinal":143058,"en":"To offer me as a sacrifice;"},{"id":"semetey-1-2013:p0864:b003:l013","ordinal":143059,"en":"Manas's orphan son—"},{"id":"semetey-1-2013:p0864:b003:l014","ordinal":143060,"en":"To charge headlong and strike him,"},{"id":"semetey-1-2013:p0864:b003:l015","ordinal":143061,"en":"You have gathered and assembled troops,"},{"id":"semetey-1-2013:p0864:b003:l016","ordinal":143062,"en":"Shouting, gathered vast numbers."},{"id":"semetey-1-2013:p0864:b003:l017","ordinal":143063,"en":"I have seen this today."},{"id":"semetey-1-2013:p0864:b003:l018","ordinal":143064,"en":"Your manner has turned wicked;"},{"id":"semetey-1-2013:p0864:b003:l019","ordinal":143065,"en":"Our fury has risen mightily!”"},{"id":"semetey-1-2013:p0864:b003:l020","ordinal":143066,"en":"High-backed, yet low of stature,"},{"id":"semetey-1-2013:p0864:b003:l021","ordinal":143067,"en":"Tuuchunak beneath him—"},{"id":"semetey-1-2013:p0864:b003:l022","ordinal":143068,"en":"He urged Tuuchunak once,"},{"id":"semetey-1-2013:p0864:b003:l023","ordinal":143069,"en":"Took his lacquered lance in hand,"},{"id":"semetey-1-2013:p0864:b003:l024","ordinal":143070,"en":"Before he had finished turning it,"},{"id":"semetey-1-2013:p0864:b003:l025","ordinal":143071,"en":"Attacked brave Urbu;"},{"id":"semetey-1-2013:p0864:b003:l026","ordinal":143072,"en":"The skilled Sary Khan"},{"id":"semetey-1-2013:p0864:b003:l027","ordinal":143073,"en":"Reached brave Urbu."},{"id":"semetey-1-2013:p0864:b003:l028","ordinal":143074,"en":"“This side of the liver,” he said,"},{"id":"semetey-1-2013:p0864:b003:l029","ordinal":143075,"en":"“One edge of the lung,” he said,"},{"id":"semetey-1-2013:p0864:b003:l030","ordinal":143076,"en":"“The rim of the ribs,” he said,"},{"id":"semetey-1-2013:p0864:b003:l031","ordinal":143077,"en":"If it slips, face it."},{"id":"semetey-1-2013:p0864:b003:l032","ordinal":143078,"en":"“The top of his heart,” he said."},{"id":"semetey-1-2013:p0864:b003:l033","ordinal":143079,"en":"The skilled Sary Khan"},{"id":"semetey-1-2013:p0864:b003:l034","ordinal":143080,"en":"Arrived before an arrow could;"},{"id":"semetey-1-2013:p0864:b003:l035","ordinal":143081,"en":"Where he reached Urbu,"},{"id":"semetey-1-2013:p0864:b003:l036","ordinal":143082,"en":"He struck hard as he passed."},{"id":"semetey-1-2013:p0864:b003:l037","ordinal":143083,"en":"Sary Khan thrust unerringly;"},{"id":"semetey-1-2013:p0864:b003:l038","ordinal":143084,"en":"Khan Urbu was shattered."},{"id":"semetey-1-2013:p0864:b003:l039","ordinal":143085,"en":"From Algara the horse's back"},{"id":"semetey-1-2013:p0864:b004:l001","ordinal":143086,"en":"He shot upward with a jerk;"},{"id":"semetey-1-2013:p0864:b004:l002","ordinal":143087,"en":"From the shoulder-blade behind,"},{"id":"semetey-1-2013:p0864:b004:l003","ordinal":143088,"en":"Sary Khan's lance"},{"id":"semetey-1-2013:p0864:b004:l004","ordinal":143089,"en":"Jutted out with a jutting snap."},{"id":"semetey-1-2013:p0864:b004:l005","ordinal":143090,"en":"Having finished off brave Urbu,"},{"id":"semetey-1-2013:p0864:b004:l006","ordinal":143091,"en":"He passed farther on;"},{"id":"semetey-1-2013:p0864:b004:l007","ordinal":143092,"en":"Meeting him face to face,"},{"id":"semetey-1-2013:p0864:b004:l008","ordinal":143093,"en":"He reached Tazbaimat."},{"id":"semetey-1-2013:p0864:b004:l009","ordinal":143094,"en":"Your uncle Sary did not tire;"},{"id":"semetey-1-2013:p0864:b004:l010","ordinal":143095,"en":"Brandishing his lance,"},{"id":"semetey-1-2013:p0864:b004:l011","ordinal":143096,"en":"He struck true as he passed."},{"id":"semetey-1-2013:p0864:b004:l012","ordinal":143097,"en":"Tazbaimat, Manas's companion,"},{"id":"semetey-1-2013:p0864:b004:l013","ordinal":143098,"en":"Whatever enemy he faced,"},{"id":"semetey-1-2013:p0864:b004:l014","ordinal":143099,"en":"Was accustomed to come out for single combat."},{"id":"semetey-1-2013:p0864:b004:l015","ordinal":143100,"en":"When Sary Khan thrust his lance,"},{"id":"semetey-1-2013:p0864:b004:l016","ordinal":143101,"en":"Sary Khan's lance"},{"id":"semetey-1-2013:p0864:b004:l017","ordinal":143102,"en":"Was the first to reach its mark."},{"id":"semetey-1-2013:p0864:b004:l018","ordinal":143103,"en":"Baimat, who posed as a hero—"},{"id":"semetey-1-2013:p0864:b004:l019","ordinal":143104,"en":"His helmet of blue iron"}]
