[{"id":"semetey-1-2013:p1412:b005:l032","ordinal":184065,"en":"At the edge of the watch-lake,"},{"id":"semetey-1-2013:p1412:b005:l033","ordinal":184066,"en":"There on watch in its prime"},{"id":"semetey-1-2013:p1412:b005:l034","ordinal":184067,"en":"Stood the fire-doomed Kuuördök,"},{"id":"semetey-1-2013:p1412:b005:l035","ordinal":184068,"en":"In its accustomed place,"},{"id":"semetey-1-2013:p1412:b005:l036","ordinal":184069,"en":"Upon a rock like a yurt;"},{"id":"semetey-1-2013:p1412:b005:l037","ordinal":184070,"en":"When he caught sight of the duck,"},{"id":"semetey-1-2013:p1413:b003:l001","ordinal":184071,"en":"Bakay came riding in haste,"},{"id":"semetey-1-2013:p1413:b003:l002","ordinal":184072,"en":"Pleading with his son Semetey:"},{"id":"semetey-1-2013:p1413:b003:l003","ordinal":184073,"en":"\"Kuuördök is a cunning swine;"},{"id":"semetey-1-2013:p1413:b003:l004","ordinal":184074,"en":"Do not cast your falcon too soon;"},{"id":"semetey-1-2013:p1413:b003:l005","ordinal":184075,"en":"Do not slaughter your old uncle Bakai"},{"id":"semetey-1-2013:p1413:b003:l006","ordinal":184076,"en":"And leave him full of regret!"},{"id":"semetey-1-2013:p1413:b003:l007","ordinal":184077,"en":"Your uncle Bakai tells you this:"},{"id":"semetey-1-2013:p1413:b003:l008","ordinal":184078,"en":"Judge the bird's distance;"},{"id":"semetey-1-2013:p1413:b003:l009","ordinal":184079,"en":"Do not ruin things, my son—heed my words."},{"id":"semetey-1-2013:p1413:b003:l010","ordinal":184080,"en":"Set the falcon's mind upon it,"},{"id":"semetey-1-2013:p1413:b003:l011","ordinal":184081,"en":"And only then cast it loose!"},{"id":"semetey-1-2013:p1413:b003:l012","ordinal":184082,"en":"Do not make me lament, son—heed my words!\""},{"id":"semetey-1-2013:p1413:b003:l013","ordinal":184083,"en":"Bakai spoke these words;"},{"id":"semetey-1-2013:p1413:b003:l014","ordinal":184084,"en":"The orphaned hero, son of the Bloodthirsty One,"},{"id":"semetey-1-2013:p1413:b003:l015","ordinal":184085,"en":"Now drew near the duck."},{"id":"semetey-1-2013:p1413:b003:l016","ordinal":184086,"en":"When he drew near the duck,"},{"id":"semetey-1-2013:p1413:b003:l017","ordinal":184087,"en":"A matchless thoroughbred,"},{"id":"semetey-1-2013:p1413:b003:l018","ordinal":184088,"en":"Its gait rolled soft and smooth,"},{"id":"semetey-1-2013:p1413:b003:l019","ordinal":184089,"en":"Its steel shoes and sharp nails"},{"id":"semetey-1-2013:p1413:b003:l020","ordinal":184090,"en":"Shining on all fours."},{"id":"semetey-1-2013:p1413:b003:l021","ordinal":184091,"en":"The matchless Narbuurul,"},{"id":"semetey-1-2013:p1413:b003:l022","ordinal":184092,"en":"A fleet thoroughbred with mighty legs,"},{"id":"semetey-1-2013:p1413:b003:l023","ordinal":184093,"en":"Mattock hooves and a broad rump,"},{"id":"semetey-1-2013:p1413:b003:l024","ordinal":184094,"en":"A thoroughbred of the spacious land."},{"id":"semetey-1-2013:p1413:b003:l025","ordinal":184095,"en":"Tossing his forelock to the sky,"},{"id":"semetey-1-2013:p1413:b003:l026","ordinal":184096,"en":"Driving his hooves into the earth,"},{"id":"semetey-1-2013:p1413:b003:l027","ordinal":184097,"en":"He moved with the glide of a sighthound,"},{"id":"semetey-1-2013:p1413:b003:l028","ordinal":184098,"en":"Wherever he passed,"},{"id":"semetey-1-2013:p1413:b003:l029","ordinal":184099,"en":"Gliding without a sound."},{"id":"semetey-1-2013:p1413:b003:l030","ordinal":184100,"en":"The splendid hero born of Manas,"},{"id":"semetey-1-2013:p1413:b003:l031","ordinal":184101,"en":"To cast at Kuuördök"},{"id":"semetey-1-2013:p1413:b003:l032","ordinal":184102,"en":"And have his fill of joy,"},{"id":"semetey-1-2013:p1413:b003:l033","ordinal":184103,"en":"Coiled the long leash;"},{"id":"semetey-1-2013:p1413:b003:l034","ordinal":184104,"en":"The noble hero loosed Akshumkar,"},{"id":"semetey-1-2013:p1413:b003:l035","ordinal":184105,"en":"Letting it go on a shortened tether,"},{"id":"semetey-1-2013:p1413:b003:l036","ordinal":184106,"en":"Stepping obliquely and drawing it close,"},{"id":"semetey-1-2013:p1413:b003:l037","ordinal":184107,"en":"Making the short tether taut."},{"id":"semetey-1-2013:p1413:b003:l038","ordinal":184108,"en":"Circling in from the side,"},{"id":"semetey-1-2013:p1413:b003:l039","ordinal":184109,"en":"Behind him, Khan Bakai"},{"id":"semetey-1-2013:p1413:b004:l001","ordinal":184110,"en":"Girded his firm waist;"},{"id":"semetey-1-2013:p1413:b004:l002","ordinal":184111,"en":"Though old, hero Bakai"},{"id":"semetey-1-2013:p1413:b004:l003","ordinal":184112,"en":"A crescent-marked golden doolbas drum,"},{"id":"semetey-1-2013:p1413:b004:l004","ordinal":184113,"en":"Striking once with a ringing blow."},{"id":"semetey-1-2013:p1413:b004:l005","ordinal":184114,"en":"When the doolbas sounded,"},{"id":"semetey-1-2013:p1413:b004:l006","ordinal":184115,"en":"Kuuördök at the watch-post"},{"id":"semetey-1-2013:p1413:b004:l007","ordinal":184116,"en":"Circled in the air,"},{"id":"semetey-1-2013:p1413:b004:l008","ordinal":184117,"en":"Flying backward and banking."},{"id":"semetey-1-2013:p1413:b004:l009","ordinal":184118,"en":"The remarkable Kuuördök—"},{"id":"semetey-1-2013:p1413:b004:l010","ordinal":184119,"en":"His beak is long, his neck is copper,"},{"id":"semetey-1-2013:p1413:b004:l011","ordinal":184120,"en":"Its girth two fathoms,"},{"id":"semetey-1-2013:p1413:b004:l012","ordinal":184121,"en":"With an iron tail, swiftest of all;"},{"id":"semetey-1-2013:p1413:b004:l013","ordinal":184122,"en":"When frenzied Kuuördök"},{"id":"semetey-1-2013:p1413:b004:l014","ordinal":184123,"en":"Rose, no living creature could catch it."},{"id":"semetey-1-2013:p1413:b004:l015","ordinal":184124,"en":"As it rose,"},{"id":"semetey-1-2013:p1413:b004:l016","ordinal":184125,"en":"Semetey, born after"},{"id":"semetey-1-2013:p1413:b004:l017","ordinal":184126,"en":"His father Manas the gray wolf,"},{"id":"semetey-1-2013:p1413:b004:l018","ordinal":184127,"en":"Shouted in anger,"},{"id":"semetey-1-2013:p1413:b004:l019","ordinal":184128,"en":"Raised the cry of \"Bloodthirsty One!\""},{"id":"semetey-1-2013:p1413:b004:l020","ordinal":184129,"en":"He set the falcon in position,"},{"id":"semetey-1-2013:p1413:b004:l021","ordinal":184130,"en":"Brought it keenly onto the quarry,"},{"id":"semetey-1-2013:p1413:b004:l022","ordinal":184131,"en":"And watched it soar,"},{"id":"semetey-1-2013:p1413:b004:l023","ordinal":184132,"en":"Looking to either side."},{"id":"semetey-1-2013:p1413:b004:l024","ordinal":184133,"en":"Semetey's Akshumkar"},{"id":"semetey-1-2013:p1413:b004:l025","ordinal":184134,"en":"Was a champion beyond compare,"},{"id":"semetey-1-2013:p1413:b004:l026","ordinal":184135,"en":"Utterly peerless in the hunt."},{"id":"semetey-1-2013:p1413:b004:l027","ordinal":184136,"en":"No quarry escaped before it;"},{"id":"semetey-1-2013:p1413:b004:l028","ordinal":184137,"en":"Its talons were iron, its beak brass,"},{"id":"semetey-1-2013:p1413:b004:l029","ordinal":184138,"en":"Its girth two fathoms."},{"id":"semetey-1-2013:p1413:b004:l030","ordinal":184139,"en":"Black eyes, blue legs,"},{"id":"semetey-1-2013:p1413:b004:l031","ordinal":184140,"en":"It never turned back from what it saw,"},{"id":"semetey-1-2013:p1413:b004:l032","ordinal":184141,"en":"And left no morsel in a pail uneaten."},{"id":"semetey-1-2013:p1413:b004:l033","ordinal":184142,"en":"It would not let a goose rise from the lake,"},{"id":"semetey-1-2013:p1413:b004:l034","ordinal":184143,"en":"But folded its wings and stooped upon it;"},{"id":"semetey-1-2013:p1413:b004:l035","ordinal":184144,"en":"It would not let a swan rise from the lake,"},{"id":"semetey-1-2013:p1413:b004:l036","ordinal":184145,"en":"But gathered its tail and stooped upon it."},{"id":"semetey-1-2013:p1413:b004:l037","ordinal":184146,"en":"The champion who trained it as a hunting bird"},{"id":"semetey-1-2013:p1413:b004:l038","ordinal":184147,"en":"Was a young man touched by Khizir,"},{"id":"semetey-1-2013:p1413:b004:l039","ordinal":184148,"en":"To whom God himself had granted it!"},{"id":"semetey-1-2013:p1414:b003:l001","ordinal":184149,"en":"Beating the drum and raising a cry,"},{"id":"semetey-1-2013:p1414:b003:l002","ordinal":184150,"en":"Your capable uncle Bakai"},{"id":"semetey-1-2013:p1414:b003:l003","ordinal":184151,"en":"Came riding here and there;"},{"id":"semetey-1-2013:p1414:b003:l004","ordinal":184152,"en":"Kökcholok came snorting,"},{"id":"semetey-1-2013:p1414:b003:l005","ordinal":184153,"en":"As Bakai fired his gun and drew his bow."},{"id":"semetey-1-2013:p1414:b003:l006","ordinal":184154,"en":"Your uncle Bakai, bringer of good fortune,"},{"id":"semetey-1-2013:p1414:b003:l007","ordinal":184155,"en":"Urged it on without cease."},{"id":"semetey-1-2013:p1414:b003:l008","ordinal":184156,"en":"At that moment Kuuördök"},{"id":"semetey-1-2013:p1414:b003:l009","ordinal":184157,"en":"Flew up from the lake;"},{"id":"semetey-1-2013:p1414:b003:l010","ordinal":184158,"en":"When it had risen,"},{"id":"semetey-1-2013:p1414:b003:l011","ordinal":184159,"en":"Your young son of the gray wolf"},{"id":"semetey-1-2013:p1414:b003:l012","ordinal":184160,"en":"Cast Akshumkar at it."},{"id":"semetey-1-2013:p1414:b003:l013","ordinal":184161,"en":"Striking a rock and falling limp,"},{"id":"semetey-1-2013:p1414:b003:l014","ordinal":184162,"en":"Akshumkar lay unconscious"},{"id":"semetey-1-2013:p1414:b003:l015","ordinal":184163,"en":"For the time it takes tea to boil."},{"id":"semetey-1-2013:p1414:b003:l016","ordinal":184164,"en":"Bakai shouted out:"},{"id":"semetey-1-2013:p1414:b003:l017","ordinal":184165,"en":"\"Wretched child, be ruined!"},{"id":"semetey-1-2013:p1414:b003:l018","ordinal":184166,"en":"You never heed my words;"},{"id":"semetey-1-2013:p1414:b003:l019","ordinal":184167,"en":"You are always ill-fated,"},{"id":"semetey-1-2013:p1414:b003:l020","ordinal":184168,"en":"Bent on gouging out my eyes!"},{"id":"semetey-1-2013:p1414:b003:l021","ordinal":184169,"en":"No matter what I say, you will not listen;"},{"id":"semetey-1-2013:p1414:b003:l022","ordinal":184170,"en":"Arrogant son, you will come to no good!\""},{"id":"semetey-1-2013:p1414:b003:l023","ordinal":184171,"en":"Tearing out and flinging away his beard,"},{"id":"semetey-1-2013:p1414:b003:l024","ordinal":184172,"en":"Tugging and flinging his mustache,"},{"id":"semetey-1-2013:p1414:b003:l025","ordinal":184173,"en":"Staggering up and down,"},{"id":"semetey-1-2013:p1414:b003:l026","ordinal":184174,"en":"Your uncle Bakai wailed"},{"id":"semetey-1-2013:p1414:b003:l027","ordinal":184175,"en":"And beat himself upon the head:"},{"id":"semetey-1-2013:p1414:b003:l028","ordinal":184176,"en":"\"Alas, Manas—if only you had not died!"},{"id":"semetey-1-2013:p1414:b003:l029","ordinal":184177,"en":"Then this wretched soul would not see such disgrace!"},{"id":"semetey-1-2013:p1414:b003:l030","ordinal":184178,"en":"Curse you, Manas—if only you had not died,"},{"id":"semetey-1-2013:p1414:b003:l031","ordinal":184179,"en":"Then Bakai would not see such suffering!"},{"id":"semetey-1-2013:p1414:b003:l032","ordinal":184180,"en":"I have withered like grass in a dry streambed;"},{"id":"semetey-1-2013:p1414:b003:l033","ordinal":184181,"en":"When Manas passed away"},{"id":"semetey-1-2013:p1414:b003:l034","ordinal":184182,"en":"No one heeds my words,"},{"id":"semetey-1-2013:p1414:b003:l035","ordinal":184183,"en":"And I am like a fire gone out!"},{"id":"semetey-1-2013:p1414:b003:l036","ordinal":184184,"en":"Curse you, Manas, for dying"},{"id":"semetey-1-2013:p1414:b003:l037","ordinal":184185,"en":"And leaving your dependent"},{"id":"semetey-1-2013:p1414:b003:l038","ordinal":184186,"en":"To a wretch like this!\" he cried."},{"id":"semetey-1-2013:p1414:b003:l039","ordinal":184187,"en":"As Bakai stood thus,"},{"id":"semetey-1-2013:p1414:b004:l001","ordinal":184188,"en":"Akshumkar recovered its senses,"},{"id":"semetey-1-2013:p1414:b004:l002","ordinal":184189,"en":"Shook itself and voided its bowels;"},{"id":"semetey-1-2013:p1414:b004:l003","ordinal":184190,"en":"The gray wolf's falcon"},{"id":"semetey-1-2013:p1414:b004:l004","ordinal":184191,"en":"Rose and flew anew,"},{"id":"semetey-1-2013:p1414:b004:l005","ordinal":184192,"en":"It circled in the air,"},{"id":"semetey-1-2013:p1414:b004:l006","ordinal":184193,"en":"Flying backward and banking;"},{"id":"semetey-1-2013:p1414:b004:l007","ordinal":184194,"en":"It climbed and righted itself,"},{"id":"semetey-1-2013:p1414:b004:l008","ordinal":184195,"en":"As though it had lost sight of the quarry;"},{"id":"semetey-1-2013:p1414:b004:l009","ordinal":184196,"en":"With twelve tail-feathers and forty pinions,"},{"id":"semetey-1-2013:p1414:b004:l010","ordinal":184197,"en":"It now beat its wings mightily,"},{"id":"semetey-1-2013:p1414:b004:l011","ordinal":184198,"en":"Drawing itself tight with a hiss,"},{"id":"semetey-1-2013:p1414:b004:l012","ordinal":184199,"en":"Its roar breaking forth."},{"id":"semetey-1-2013:p1414:b004:l013","ordinal":184200,"en":"At times,"},{"id":"semetey-1-2013:p1414:b004:l014","ordinal":184201,"en":"It looked like a gray sparrow;"},{"id":"semetey-1-2013:p1414:b004:l015","ordinal":184202,"en":"Fluttering its wings,"},{"id":"semetey-1-2013:p1414:b004:l016","ordinal":184203,"en":"Quivering faster than an arrow,"},{"id":"semetey-1-2013:p1414:b004:l017","ordinal":184204,"en":"Its wingbeats could not be seen;"},{"id":"semetey-1-2013:p1414:b004:l018","ordinal":184205,"en":"It began the tumult,"},{"id":"semetey-1-2013:p1414:b004:l019","ordinal":184206,"en":"Risking its very life."},{"id":"semetey-1-2013:p1414:b004:l020","ordinal":184207,"en":"Toward the fortress with iron gates,"},{"id":"semetey-1-2013:p1414:b004:l021","ordinal":184208,"en":"Toward old Khan's palace,"},{"id":"semetey-1-2013:p1414:b004:l022","ordinal":184209,"en":"Ringed by plane trees,"},{"id":"semetey-1-2013:p1414:b004:l023","ordinal":184210,"en":"With a golden throne at its center,"},{"id":"semetey-1-2013:p1414:b004:l024","ordinal":184211,"en":"Beneath the golden throne,"},{"id":"semetey-1-2013:p1414:b004:l025","ordinal":184212,"en":"A bottomless black well;"},{"id":"semetey-1-2013:p1414:b004:l026","ordinal":184213,"en":"The gray-winged duck had nearly arrived"},{"id":"semetey-1-2013:p1414:b004:l027","ordinal":184214,"en":"And was about to descend."},{"id":"semetey-1-2013:p1414:b004:l028","ordinal":184215,"en":"Just as it was about to alight"},{"id":"semetey-1-2013:p1414:b004:l029","ordinal":184216,"en":"Before mighty elder Kary Khan,"},{"id":"semetey-1-2013:p1414:b004:l030","ordinal":184217,"en":"Spread the news in every direction,"},{"id":"semetey-1-2013:p1414:b004:l031","ordinal":184218,"en":"And reach the bottom,"},{"id":"semetey-1-2013:p1414:b004:l032","ordinal":184219,"en":"The gray wolf's Akshumkar"},{"id":"semetey-1-2013:p1414:b004:l033","ordinal":184220,"en":"Folded over with a hiss;"},{"id":"semetey-1-2013:p1414:b004:l034","ordinal":184221,"en":"Reaching before the arrow,"},{"id":"semetey-1-2013:p1414:b004:l035","ordinal":184222,"en":"It seized the duck where it caught it,"},{"id":"semetey-1-2013:p1414:b004:l036","ordinal":184223,"en":"Without having his khan informed,"},{"id":"semetey-1-2013:p1414:b004:l037","ordinal":184224,"en":"The leopard's Akshumkar"},{"id":"semetey-1-2013:p1414:b004:l038","ordinal":184225,"en":"Struck and carried it away."},{"id":"semetey-1-2013:p1414:b004:l039","ordinal":184226,"en":"It lifted Kuuördök,"},{"id":"semetey-1-2013:p1415:b003:l001","ordinal":184227,"en":"He circled back, hovering,"},{"id":"semetey-1-2013:p1415:b003:l002","ordinal":184228,"en":"And drew near the Pole Star."},{"id":"semetey-1-2013:p1415:b003:l003","ordinal":184229,"en":"From the falcon once carried"},{"id":"semetey-1-2013:p1415:b003:l004","ordinal":184230,"en":"By his father Manas, the gray wolf,"},{"id":"semetey-1-2013:p1415:b003:l005","ordinal":184231,"en":"A bird had been born as a legacy held in trust;"},{"id":"semetey-1-2013:p1415:b003:l006","ordinal":184232,"en":"Allah ordained that it should come"},{"id":"semetey-1-2013:p1415:b003:l007","ordinal":184233,"en":"To the young champion, the noble lord’s son."},{"id":"semetey-1-2013:p1415:b003:l008","ordinal":184234,"en":"When loosed, that champion was his treasure,"},{"id":"semetey-1-2013:p1415:b003:l009","ordinal":184235,"en":"The treasure left as a gift"},{"id":"semetey-1-2013:p1415:b003:l010","ordinal":184236,"en":"By valiant Manas, the gray wolf!"},{"id":"semetey-1-2013:p1415:b003:l011","ordinal":184237,"en":"It had utterly torn apart"},{"id":"semetey-1-2013:p1415:b003:l012","ordinal":184238,"en":"The breast and chest,"},{"id":"semetey-1-2013:p1415:b003:l013","ordinal":184239,"en":"And feasted to its heart’s content"},{"id":"semetey-1-2013:p1415:b003:l014","ordinal":184240,"en":"Upon the dark flesh of the breast."},{"id":"semetey-1-2013:p1415:b003:l015","ordinal":184241,"en":"Your noble Akshumkar"},{"id":"semetey-1-2013:p1415:b003:l016","ordinal":184242,"en":"Flashed beneath the moon in the sky,"},{"id":"semetey-1-2013:p1415:b003:l017","ordinal":184243,"en":"Lifting the wild duck,"},{"id":"semetey-1-2013:p1415:b003:l018","ordinal":184244,"en":"And came down from the sky in triumph,"},{"id":"semetey-1-2013:p1415:b003:l019","ordinal":184245,"en":"Crying out loudly!"},{"id":"semetey-1-2013:p1415:b003:l020","ordinal":184246,"en":"His eyes beheld the falcon,"},{"id":"semetey-1-2013:p1415:b003:l021","ordinal":184247,"en":"The accursed wild duck"},{"id":"semetey-1-2013:p1415:b003:l022","ordinal":184248,"en":"That Akshumkar had snatched and brought;"},{"id":"semetey-1-2013:p1415:b003:l023","ordinal":184249,"en":"His uncle, old Bakai,"},{"id":"semetey-1-2013:p1415:b003:l024","ordinal":184250,"en":"Saw it coming with his own eyes!"},{"id":"semetey-1-2013:p1415:b003:l025","ordinal":184251,"en":"“My beloved Akshumkar,"},{"id":"semetey-1-2013:p1415:b003:l026","ordinal":184252,"en":"May aged Bakai circle in devotion"},{"id":"semetey-1-2013:p1415:b003:l027","ordinal":184253,"en":"Around a champion like you!"},{"id":"semetey-1-2013:p1415:b003:l028","ordinal":184254,"en":"Merely seeing you leaves my heart content;"},{"id":"semetey-1-2013:p1415:b003:l029","ordinal":184255,"en":"Apart from you, my champion,"},{"id":"semetey-1-2013:p1415:b003:l030","ordinal":184256,"en":"I possess no treasure—"},{"id":"semetey-1-2013:p1415:b003:l031","ordinal":184257,"en":"From your eyes like black currants,"},{"id":"semetey-1-2013:p1415:b003:l032","ordinal":184258,"en":"From you who caught the wild duck!"},{"id":"semetey-1-2013:p1415:b003:l033","ordinal":184259,"en":"Now that I, Bakai, am old,"},{"id":"semetey-1-2013:p1415:b003:l034","ordinal":184260,"en":"My beloved Akshumkar,"},{"id":"semetey-1-2013:p1415:b003:l035","ordinal":184261,"en":"May I be your sacrifice!”"},{"id":"semetey-1-2013:p1415:b003:l036","ordinal":184262,"en":"Rejoicing, Khan Bakai"},{"id":"semetey-1-2013:p1415:b003:l037","ordinal":184263,"en":"Swiftly invoked Babedin,"},{"id":"semetey-1-2013:p1415:b003:l038","ordinal":184264,"en":"Promised a sheep to Koroson,"},{"id":"semetey-1-2013:p1415:b003:l039","ordinal":184265,"en":"And before Allah Most High, the One,"},{"id":"semetey-1-2013:p1415:b004:l001","ordinal":184266,"en":"Also spoke the vow of Aituyak."},{"id":"semetey-1-2013:p1415:b004:l002","ordinal":184267,"en":"All his longing subsided;"},{"id":"semetey-1-2013:p1415:b004:l003","ordinal":184268,"en":"Your uncle and Semetey"},{"id":"semetey-1-2013:p1415:b004:l004","ordinal":184269,"en":"Had their eyes opened wide as umach,"},{"id":"semetey-1-2013:p1415:b004:l005","ordinal":184270,"en":"And all their sorrow subsided."},{"id":"semetey-1-2013:p1415:b004:l006","ordinal":184271,"en":"Near the forked pass,"},{"id":"semetey-1-2013:p1415:b004:l007","ordinal":184272,"en":"To the high, level upland,"},{"id":"semetey-1-2013:p1415:b004:l008","ordinal":184273,"en":"To the level ground covered in fescue,"},{"id":"semetey-1-2013:p1415:b004:l009","ordinal":184274,"en":"To lovely Kara-Kyya,"},{"id":"semetey-1-2013:p1415:b004:l010","ordinal":184275,"en":"They turned aside to camp."},{"id":"semetey-1-2013:p1415:b004:l011","ordinal":184276,"en":"For your aged uncle Bakai,"},{"id":"semetey-1-2013:p1415:b004:l012","ordinal":184277,"en":"They sliced rump meat and served mane-fat;"},{"id":"semetey-1-2013:p1415:b004:l013","ordinal":184278,"en":"Without delay they had him begin his tale."},{"id":"semetey-1-2013:p1415:b004:l014","ordinal":184279,"en":"For valiant old Bakai,"},{"id":"semetey-1-2013:p1415:b004:l015","ordinal":184280,"en":"They had a fattened lamb and sweet head"},{"id":"semetey-1-2013:p1415:b004:l016","ordinal":184281,"en":"Boiled into bor."},{"id":"semetey-1-2013:p1415:b004:l017","ordinal":184282,"en":"They heaped up sugar like snow"},{"id":"semetey-1-2013:p1415:b004:l018","ordinal":184283,"en":"And scooped out yellow butter."},{"id":"semetey-1-2013:p1415:b004:l019","ordinal":184284,"en":"They served a thousand and one kinds of food,"},{"id":"semetey-1-2013:p1415:b004:l020","ordinal":184285,"en":"Plunging their elder uncle Bakai"},{"id":"semetey-1-2013:p1415:b004:l021","ordinal":184286,"en":"Into every kind of pleasure;"},{"id":"semetey-1-2013:p1415:b004:l022","ordinal":184287,"en":"The luxuriant turf and clean ground"},{"id":"semetey-1-2013:p1415:b004:l023","ordinal":184288,"en":"Pleased the gray-wolf hero."},{"id":"semetey-1-2013:p1415:b004:l024","ordinal":184289,"en":"They had him begin tales of every kind,"},{"id":"semetey-1-2013:p1415:b004:l025","ordinal":184290,"en":"And gave their poor uncle Bakai"},{"id":"semetey-1-2013:p1415:b004:l026","ordinal":184291,"en":"A Bayandos pillow upon which to rest."},{"id":"semetey-1-2013:p1415:b004:l027","ordinal":184292,"en":"Their uncle Bakai, your sage,"},{"id":"semetey-1-2013:p1415:b004:l028","ordinal":184293,"en":"Now fell into a hero’s sleep."},{"id":"semetey-1-2013:p1415:b004:l029","ordinal":184294,"en":"For the gray wolf born after"},{"id":"semetey-1-2013:p1415:b004:l030","ordinal":184295,"en":"His father, Lord Manas,"},{"id":"semetey-1-2013:p1415:b004:l031","ordinal":184296,"en":"There was the Akkangky saddle made by Almambet,"},{"id":"semetey-1-2013:p1415:b004:l032","ordinal":184297,"en":"The Kangky saddle fitted for Semetey."},{"id":"semetey-1-2013:p1415:b004:l033","ordinal":184298,"en":"Its front bow was pure gold,"},{"id":"semetey-1-2013:p1415:b004:l034","ordinal":184299,"en":"Its rear bow solid silver,"},{"id":"semetey-1-2013:p1415:b004:l035","ordinal":184300,"en":"And its two sides broad iron;"},{"id":"semetey-1-2013:p1415:b004:l036","ordinal":184301,"en":"It would not shift when ridden downhill."},{"id":"semetey-1-2013:p1415:b004:l037","ordinal":184302,"en":"The splendid hero, the lord’s son,"},{"id":"semetey-1-2013:p1415:b004:l038","ordinal":184303,"en":"Rested his head upon Akkangky,"},{"id":"semetey-1-2013:p1415:b004:l039","ordinal":184304,"en":"With his head toward the qibla,"},{"id":"semetey-1-2013:p1416:b003:l001","ordinal":184305,"en":"Covered himself with Akolpok,"},{"id":"semetey-1-2013:p1416:b003:l002","ordinal":184306,"en":"Prayed to the spirit"},{"id":"semetey-1-2013:p1416:b003:l003","ordinal":184307,"en":"Of his father Manas, the gray wolf,"},{"id":"semetey-1-2013:p1416:b003:l004","ordinal":184308,"en":"And fell into a hero’s sleep."},{"id":"semetey-1-2013:p1416:b003:l005","ordinal":184309,"en":"They removed the saddles"},{"id":"semetey-1-2013:p1416:b003:l006","ordinal":184310,"en":"From Kökcholok and Taibuurul,"},{"id":"semetey-1-2013:p1416:b003:l007","ordinal":184311,"en":"Leaving them bare-backed,"},{"id":"semetey-1-2013:p1416:b003:l008","ordinal":184312,"en":"And tethered the ancient coursers high."},{"id":"semetey-1-2013:p1416:b003:l009","ordinal":184313,"en":"They lay upon their sides and rested,"},{"id":"semetey-1-2013:p1416:b003:l010","ordinal":184314,"en":"Lay down and slept their fill,"},{"id":"semetey-1-2013:p1416:b003:l011","ordinal":184315,"en":"Rested propped upon an elbow,"},{"id":"semetey-1-2013:p1416:b003:l012","ordinal":184316,"en":"And took a brief doze."},{"id":"semetey-1-2013:p1416:b003:l013","ordinal":184317,"en":"When the time of truthful dawn arrived,"},{"id":"semetey-1-2013:p1416:b003:l014","ordinal":184318,"en":"When daybreak turned yellow,"},{"id":"semetey-1-2013:p1416:b003:l015","ordinal":184319,"en":"The stars separated above them,"},{"id":"semetey-1-2013:p1416:b003:l016","ordinal":184320,"en":"And dawn appeared, swelling bright."}]
