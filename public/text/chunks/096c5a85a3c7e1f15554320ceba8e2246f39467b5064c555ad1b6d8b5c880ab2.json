[{"id":"semetey-1-2013:p0423:b003:l022","ordinal":109313,"en":"My regret is bitter; my heart burns."},{"id":"semetey-1-2013:p0423:b003:l023","ordinal":109314,"en":"Who knows if it is false or true?"},{"id":"semetey-1-2013:p0423:b003:l024","ordinal":109315,"en":"Let me go to that great Keng-Kol.”"},{"id":"semetey-1-2013:p0423:b003:l025","ordinal":109316,"en":"Chubak journeyed without stopping."},{"id":"semetey-1-2013:p0423:b003:l026","ordinal":109317,"en":"Do not ask about the tiger's state—"},{"id":"semetey-1-2013:p0423:b003:l027","ordinal":109318,"en":"Akbaltay's wayward warrior,"},{"id":"semetey-1-2013:p0423:b003:l028","ordinal":109319,"en":"On account of his father,"},{"id":"semetey-1-2013:p0423:b003:l029","ordinal":109320,"en":"Decided to come to Talas,"},{"id":"semetey-1-2013:p0423:b003:l030","ordinal":109321,"en":"That valiant Chubak of yours."},{"id":"semetey-1-2013:p0423:b003:l031","ordinal":109322,"en":"Let me leave him thus for now,"},{"id":"semetey-1-2013:p0423:b003:l032","ordinal":109323,"en":"And your mother, unfortunate Kanykey's tale—"},{"id":"semetey-1-2013:p0423:b003:l034","ordinal":109324,"en":"Let me begin, leaving nothing out:"},{"id":"semetey-1-2013:p0423:b003:l035","ordinal":109325,"en":"When Kanykey was in her fortress,"},{"id":"semetey-1-2013:p0423:b003:l036","ordinal":109326,"en":"When your mother was neglected six months,"},{"id":"semetey-1-2013:p0423:b003:l037","ordinal":109327,"en":"When Alooke's Kongurbay"},{"id":"semetey-1-2013:p0423:b003:l038","ordinal":109328,"en":"And the six Chinese tribes would come,"},{"id":"semetey-1-2013:p0423:b003:l039","ordinal":109329,"en":"When your wretched mother learned of it,"},{"id":"semetey-1-2013:p0423:b004:l001","ordinal":109330,"en":"I moved apart to summer pasture."},{"id":"semetey-1-2013:p0423:b004:l002","ordinal":109331,"en":"Let me tell the other part:"},{"id":"semetey-1-2013:p0423:b004:l003","ordinal":109332,"en":"Your father's Akkula"},{"id":"semetey-1-2013:p0423:b004:l004","ordinal":109333,"en":"I tethered with my own hands."},{"id":"semetey-1-2013:p0423:b004:l005","ordinal":109334,"en":"Bringing him to perfect condition,"},{"id":"semetey-1-2013:p0423:b004:l006","ordinal":109335,"en":"I readied him for a true campaign."},{"id":"semetey-1-2013:p0423:b004:l007","ordinal":109336,"en":"I grieved and often wept."},{"id":"semetey-1-2013:p0423:b004:l008","ordinal":109337,"en":"Though he neglected me sixty times,"},{"id":"semetey-1-2013:p0423:b004:l009","ordinal":109338,"en":"My generous lord mounting Akkula,"},{"id":"semetey-1-2013:p0423:b004:l010","ordinal":109339,"en":"And entering battle—that was my wish."},{"id":"semetey-1-2013:p0423:b004:l011","ordinal":109340,"en":"I did not stand there idly then."},{"id":"semetey-1-2013:p0423:b004:l012","ordinal":109341,"en":"Your father's weapons—"},{"id":"semetey-1-2013:p0423:b004:l013","ordinal":109342,"en":"Gathering everything he had and lacked,"},{"id":"semetey-1-2013:p0423:b004:l014","ordinal":109343,"en":"I made them ready in the palace."},{"id":"semetey-1-2013:p0423:b004:l015","ordinal":109344,"en":"While your mother was doing this,"},{"id":"semetey-1-2013:p0423:b004:l016","ordinal":109345,"en":"With a cotton belt and broad boots,"},{"id":"semetey-1-2013:p0423:b004:l017","ordinal":109346,"en":"Kongurbay, khan of the tonsured ones,"},{"id":"semetey-1-2013:p0423:b004:l018","ordinal":109347,"en":"Brought twelve divisions of troops,"},{"id":"semetey-1-2013:p0423:b004:l019","ordinal":109348,"en":"Brought an iron-rope net."},{"id":"semetey-1-2013:p0423:b004:l020","ordinal":109349,"en":"His captains of ten bobbed along;"},{"id":"semetey-1-2013:p0423:b004:l021","ordinal":109350,"en":"The spearheads jutted up;"},{"id":"semetey-1-2013:p0423:b004:l022","ordinal":109351,"en":"Men's heads knocked together;"},{"id":"semetey-1-2013:p0423:b004:l023","ordinal":109352,"en":"The spearheads clashed."},{"id":"semetey-1-2013:p0423:b004:l024","ordinal":109353,"en":"“That lord of yours, childish Manas—"},{"id":"semetey-1-2013:p0423:b004:l025","ordinal":109354,"en":"I will trample on his head,"},{"id":"semetey-1-2013:p0423:b004:l026","ordinal":109355,"en":"I will scatter his four kinds of livestock."},{"id":"semetey-1-2013:p0423:b004:l027","ordinal":109356,"en":"Seizing his mares,"},{"id":"semetey-1-2013:p0423:b004:l028","ordinal":109357,"en":"If any of them come near,"},{"id":"semetey-1-2013:p0423:b004:l029","ordinal":109358,"en":"I'll smash their brains, laying them low."},{"id":"semetey-1-2013:p0423:b004:l030","ordinal":109359,"en":"I shall make the Kyrgyz pay"},{"id":"semetey-1-2013:p0423:b004:l031","ordinal":109360,"en":"For things from long ago."},{"id":"semetey-1-2013:p0423:b004:l032","ordinal":109361,"en":"I shall seize and bring him bound,"},{"id":"semetey-1-2013:p0423:b004:l033","ordinal":109362,"en":"That giant Manas, like Kambar."},{"id":"semetey-1-2013:p0423:b004:l034","ordinal":109363,"en":"If Manas acts stubbornly,"},{"id":"semetey-1-2013:p0423:b004:l035","ordinal":109364,"en":"I shall seize him without delay."},{"id":"semetey-1-2013:p0423:b004:l036","ordinal":109365,"en":"Into a dungeon forty rope-lengths deep"},{"id":"semetey-1-2013:p0423:b004:l037","ordinal":109366,"en":"I shall drive and cast him."},{"id":"semetey-1-2013:p0423:b004:l038","ordinal":109367,"en":"After that, the Kyrgyz—"},{"id":"semetey-1-2013:p0423:b004:l039","ordinal":109368,"en":"I shall raid their village and slaughter them."},{"id":"semetey-1-2013:p0424:b003:l001","ordinal":109369,"en":"With seven standards for banners,"},{"id":"semetey-1-2013:p0424:b003:l002","ordinal":109370,"en":"Alakoo's Kongurbay,"},{"id":"semetey-1-2013:p0424:b003:l003","ordinal":109371,"en":"With seventy thousand troops—"},{"id":"semetey-1-2013:p0424:b003:l004","ordinal":109372,"en":"Of the red-tufted Chinese,"},{"id":"semetey-1-2013:p0424:b003:l005","ordinal":109373,"en":"Then their mighty ones, ah, set out."},{"id":"semetey-1-2013:p0424:b003:l006","ordinal":109374,"en":"Of the jewel-wearing Chinese,"},{"id":"semetey-1-2013:p0424:b003:l007","ordinal":109375,"en":"The shaven-headed ones set out."},{"id":"semetey-1-2013:p0424:b003:l008","ordinal":109376,"en":"Of the jacket-wearing Kalmyks,"},{"id":"semetey-1-2013:p0424:b003:l009","ordinal":109377,"en":"The strong ones formed their ranks."},{"id":"semetey-1-2013:p0424:b003:l010","ordinal":109378,"en":"Of the armguard-wearing Manchus,"},{"id":"semetey-1-2013:p0424:b003:l011","ordinal":109379,"en":"Their officers formed their ranks."},{"id":"semetey-1-2013:p0424:b003:l012","ordinal":109380,"en":"Hearing the grave news,"},{"id":"semetey-1-2013:p0424:b003:l013","ordinal":109381,"en":"That Khan Baltay's Chubak"},{"id":"semetey-1-2013:p0424:b003:l014","ordinal":109382,"en":"Had fled, they heard;"},{"id":"semetey-1-2013:p0424:b003:l015","ordinal":109383,"en":"The treasury and gold coins"},{"id":"semetey-1-2013:p0424:b003:l016","ordinal":109384,"en":"He had scattered, they heard."},{"id":"semetey-1-2013:p0424:b003:l017","ordinal":109385,"en":"Ez kara, khan of the Manchus,"},{"id":"semetey-1-2013:p0424:b003:l018","ordinal":109386,"en":"They dressed in an unyielding coat,"},{"id":"semetey-1-2013:p0424:b003:l019","ordinal":109387,"en":"Mounted on the great brown horse,"},{"id":"semetey-1-2013:p0424:b003:l020","ordinal":109388,"en":"Gave ten thousand Manchu troops,"},{"id":"semetey-1-2013:p0424:b003:l021","ordinal":109389,"en":"And sent Ez kara forth."},{"id":"semetey-1-2013:p0424:b003:l022","ordinal":109390,"en":"Ah, a beaded cap-button, a coral stone,"},{"id":"semetey-1-2013:p0424:b003:l023","ordinal":109391,"en":"With their governor-khans among them,"},{"id":"semetey-1-2013:p0424:b003:l024","ordinal":109392,"en":"Who had gone on foot six years,"},{"id":"semetey-1-2013:p0424:b003:l025","ordinal":109393,"en":"Greased sixty spears,"},{"id":"semetey-1-2013:p0424:b003:l026","ordinal":109394,"en":"Slaughtered six thousand people—"},{"id":"semetey-1-2013:p0424:b003:l027","ordinal":109395,"en":"Khan Joloy, khan of the Kalmyks,"},{"id":"semetey-1-2013:p0424:b003:l028","ordinal":109396,"en":"They clothed in bulletproof armor,"},{"id":"semetey-1-2013:p0424:b003:l029","ordinal":109397,"en":"Mounted on Achbuudan,"},{"id":"semetey-1-2013:p0424:b003:l030","ordinal":109398,"en":"With a black cap and broad boots,"},{"id":"semetey-1-2013:p0424:b003:l031","ordinal":109399,"en":"Gave ten thousand Kalmyk troops,"},{"id":"semetey-1-2013:p0424:b003:l032","ordinal":109400,"en":"And sent Khan Joloy forth."},{"id":"semetey-1-2013:p0424:b003:l033","ordinal":109401,"en":"Much of his due remained with the people;"},{"id":"semetey-1-2013:p0424:b003:l034","ordinal":109402,"en":"If dusk caught him in the steppe,"},{"id":"semetey-1-2013:p0424:b003:l035","ordinal":109403,"en":"Wolves tear it apart and eat it."},{"id":"semetey-1-2013:p0424:b003:l036","ordinal":109404,"en":"Orokkyr, khan of the Shibee,"},{"id":"semetey-1-2013:p0424:b003:l037","ordinal":109405,"en":"They dressed in a great black coat,"},{"id":"semetey-1-2013:p0424:b003:l038","ordinal":109406,"en":"Mounted on a great rhinoceros,"},{"id":"semetey-1-2013:p0424:b003:l039","ordinal":109407,"en":"Gave ten thousand Shibee troops,"},{"id":"semetey-1-2013:p0424:b004:l001","ordinal":109408,"en":"And sent Orokkyr forth."},{"id":"semetey-1-2013:p0424:b004:l002","ordinal":109409,"en":"Karykan, khan of Beijing,"},{"id":"semetey-1-2013:p0424:b004:l003","ordinal":109410,"en":"Whose temper had grown fiercely bitter,"},{"id":"semetey-1-2013:p0424:b004:l004","ordinal":109411,"en":"Issued stern commands to Beijing,"},{"id":"semetey-1-2013:p0424:b004:l005","ordinal":109412,"en":"Brought great terror upon his people,"},{"id":"semetey-1-2013:p0424:b004:l006","ordinal":109413,"en":"And red-whip Shypshaydar,"},{"id":"semetey-1-2013:p0424:b004:l007","ordinal":109414,"en":"The giant, he sent with them."},{"id":"semetey-1-2013:p0424:b004:l008","ordinal":109415,"en":"Tiken the mighty, Muzkindik's son—"},{"id":"semetey-1-2013:p0424:b004:l009","ordinal":109416,"en":"Then he sent the man on foot with them."},{"id":"semetey-1-2013:p0424:b004:l010","ordinal":109417,"en":"A flood, denser than the reeds,"},{"id":"semetey-1-2013:p0424:b004:l011","ordinal":109418,"en":"The seething Chinese thronged everywhere,"},{"id":"semetey-1-2013:p0424:b004:l012","ordinal":109419,"en":"Swarming like ants,"},{"id":"semetey-1-2013:p0424:b004:l013","ordinal":109420,"en":"Teeming more thickly than gnats."},{"id":"semetey-1-2013:p0424:b004:l014","ordinal":109421,"en":"See the reeds, see the flood!"},{"id":"semetey-1-2013:p0424:b004:l015","ordinal":109422,"en":"After lying down one night, behold—"},{"id":"semetey-1-2013:p0424:b004:l016","ordinal":109423,"en":"See the Chinese people swarming over us!"},{"id":"semetey-1-2013:p0424:b004:l017","ordinal":109424,"en":"Circling over our heads,"},{"id":"semetey-1-2013:p0424:b004:l018","ordinal":109425,"en":"When the Chinese in four great hosts descended,"},{"id":"semetey-1-2013:p0424:b004:l019","ordinal":109426,"en":"The Kyrgyz people lay asleep."},{"id":"semetey-1-2013:p0424:b004:l020","ordinal":109427,"en":"There were no lookouts or guards then."},{"id":"semetey-1-2013:p0424:b004:l021","ordinal":109428,"en":"When dark night falls upon one's hapless head,"},{"id":"semetey-1-2013:p0424:b004:l022","ordinal":109429,"en":"My colt, this is how it is—this shitty world!"},{"id":"semetey-1-2013:p0424:b004:l023","ordinal":109430,"en":"When Argyn and Kyrgyz sought the lowlands,"},{"id":"semetey-1-2013:p0424:b004:l024","ordinal":109431,"en":"And lay encamped,"},{"id":"semetey-1-2013:p0424:b004:l025","ordinal":109432,"en":"With kumys by day and girls by night,"},{"id":"semetey-1-2013:p0424:b004:l026","ordinal":109433,"en":"While this was going on,"},{"id":"semetey-1-2013:p0424:b004:l027","ordinal":109434,"en":"Wearing double marten-fur caps,"},{"id":"semetey-1-2013:p0424:b004:l028","ordinal":109435,"en":"Swaying at their ease,"},{"id":"semetey-1-2013:p0424:b004:l029","ordinal":109436,"en":"With no thought such a foe would come,"},{"id":"semetey-1-2013:p0424:b004:l030","ordinal":109437,"en":"While they enjoyed themselves,"},{"id":"semetey-1-2013:p0424:b004:l031","ordinal":109438,"en":"Whole otter skins"},{"id":"semetey-1-2013:p0424:b004:l032","ordinal":109439,"en":"They divided into halves,"},{"id":"semetey-1-2013:p0424:b004:l033","ordinal":109440,"en":"They used to trim their trouser legs."},{"id":"semetey-1-2013:p0424:b004:l034","ordinal":109441,"en":"When bored, they shot roe deer;"},{"id":"semetey-1-2013:p0424:b004:l035","ordinal":109442,"en":"If not bored, they lay in broad Talas."},{"id":"semetey-1-2013:p0424:b004:l036","ordinal":109443,"en":"There were no scouts, no lookouts."},{"id":"semetey-1-2013:p0424:b004:l037","ordinal":109444,"en":"The massed Chinese set out,"},{"id":"semetey-1-2013:p0424:b004:l038","ordinal":109445,"en":"Traveled along the Ili,"},{"id":"semetey-1-2013:p0424:b004:l039","ordinal":109446,"en":"And when they overran Ach-Maral,"},{"id":"semetey-1-2013:p0425:b003:l001","ordinal":109447,"en":"When they overran Ak-Ermen,"},{"id":"semetey-1-2013:p0425:b003:l002","ordinal":109448,"en":"When they scattered the four kinds of livestock,"},{"id":"semetey-1-2013:p0425:b003:l003","ordinal":109449,"en":"The Kyrgyz in Talas—"},{"id":"semetey-1-2013:p0425:b003:l004","ordinal":109450,"en":"Kongurbay of Beijing,"},{"id":"semetey-1-2013:p0425:b003:l005","ordinal":109451,"en":"In the middle of the night,"},{"id":"semetey-1-2013:p0425:b003:l006","ordinal":109452,"en":"Came upon them unprepared."},{"id":"semetey-1-2013:p0425:b003:l007","ordinal":109453,"en":"When they plundered the booty,"},{"id":"semetey-1-2013:p0425:b003:l008","ordinal":109454,"en":"When the Chinese wreaked havoc,"},{"id":"semetey-1-2013:p0425:b003:l009","ordinal":109455,"en":"When Argyn and Kyrgyz in Talas"},{"id":"semetey-1-2013:p0425:b003:l010","ordinal":109456,"en":"Suffered their bitter ordeal,"},{"id":"semetey-1-2013:p0425:b003:l011","ordinal":109457,"en":"‘Struck on the head with a battle-axe,"},{"id":"semetey-1-2013:p0425:b003:l012","ordinal":109458,"en":"When Khan Ormombek died,"},{"id":"semetey-1-2013:p0425:b003:l013","ordinal":109459,"en":"A gray-dappled pennon, a red banner—"},{"id":"semetey-1-2013:p0425:b003:l014","ordinal":109460,"en":"May God never turn such a sight upon you!"},{"id":"semetey-1-2013:p0425:b003:l015","ordinal":109461,"en":"Cries of “Woe!” and uproar,"},{"id":"semetey-1-2013:p0425:b003:l016","ordinal":109462,"en":"A white-dappled pennon, a red banner,"},{"id":"semetey-1-2013:p0425:b003:l017","ordinal":109463,"en":"Shrill cries and uproar,"},{"id":"semetey-1-2013:p0425:b003:l018","ordinal":109464,"en":"Unable to find their bearings,"},{"id":"semetey-1-2013:p0425:b003:l019","ordinal":109465,"en":"The Kyrgyz fled in confusion."},{"id":"semetey-1-2013:p0425:b003:l020","ordinal":109466,"en":"“Take us with our faith intact,” they prayed,"},{"id":"semetey-1-2013:p0425:b003:l021","ordinal":109467,"en":"Preparing themselves for death."},{"id":"semetey-1-2013:p0425:b003:l022","ordinal":109468,"en":"Aziz Khan's Almambet,"},{"id":"semetey-1-2013:p0425:b003:l023","ordinal":109469,"en":"Brave Bakay of wise counsel,"},{"id":"semetey-1-2013:p0425:b003:l024","ordinal":109470,"en":"Argyn Khan's Ajybay,"},{"id":"semetey-1-2013:p0425:b003:l025","ordinal":109471,"en":"Ulakhan's Syrgak—"},{"id":"semetey-1-2013:p0425:b003:l026","ordinal":109472,"en":"Whom no mortal could withstand—"},{"id":"semetey-1-2013:p0425:b003:l027","ordinal":109473,"en":"Entering the battle then,"},{"id":"semetey-1-2013:p0425:b003:l028","ordinal":109474,"en":"The Four Lions stood firm."},{"id":"semetey-1-2013:p0425:b003:l029","ordinal":109475,"en":"The spear's point bent;"},{"id":"semetey-1-2013:p0425:b003:l030","ordinal":109476,"en":"Your uncle Bakay fought with his spear."},{"id":"semetey-1-2013:p0425:b003:l031","ordinal":109477,"en":"Aziz Khan's Almambet,"},{"id":"semetey-1-2013:p0425:b003:l032","ordinal":109478,"en":"Who had studied sorcery,"},{"id":"semetey-1-2013:p0425:b003:l033","ordinal":109479,"en":"Turned a summer's day to winter."},{"id":"semetey-1-2013:p0425:b003:l034","ordinal":109480,"en":"The thinly clad Chinese"},{"id":"semetey-1-2013:p0425:b003:l035","ordinal":109481,"en":"He made whimper like girls."},{"id":"semetey-1-2013:p0425:b003:l036","ordinal":109482,"en":"Defending the Kyrgyz at death's door,"},{"id":"semetey-1-2013:p0425:b003:l037","ordinal":109483,"en":"My precious Almam stood firm."},{"id":"semetey-1-2013:p0425:b003:l038","ordinal":109484,"en":"Girding his battle belt about his waist,"},{"id":"semetey-1-2013:p0425:b003:l039","ordinal":109485,"en":"Ulakhan's Syrgak,"},{"id":"semetey-1-2013:p0425:b005:l001","ordinal":109486,"en":"Against seventy thousand Kalmyks,"},{"id":"semetey-1-2013:p0425:b005:l002","ordinal":109487,"en":"Attacked, plunging in alone."},{"id":"semetey-1-2013:p0425:b005:l003","ordinal":109488,"en":"The Chinese were a multitude; he was alone."},{"id":"semetey-1-2013:p0425:b005:l004","ordinal":109489,"en":"What could he do against God's will?"},{"id":"semetey-1-2013:p0425:b005:l005","ordinal":109490,"en":"Look at the ants, look at the worms!"},{"id":"semetey-1-2013:p0425:b005:l006","ordinal":109491,"en":"Look at the Chinese, as numerous as worms!"},{"id":"semetey-1-2013:p0425:b005:l007","ordinal":109492,"en":"Forty Chinese tribes, countless warriors,"},{"id":"semetey-1-2013:p0425:b005:l008","ordinal":109493,"en":"Descended in the night."},{"id":"semetey-1-2013:p0425:b005:l009","ordinal":109494,"en":"Much sorrow remained for your father Manas."},{"id":"semetey-1-2013:p0425:b005:l010","ordinal":109495,"en":"Their fangs jutting out,"},{"id":"semetey-1-2013:p0425:b005:l011","ordinal":109496,"en":"Horse carcasses fell in mountains."},{"id":"semetey-1-2013:p0425:b005:l012","ordinal":109497,"en":"Their mustaches bristling,"},{"id":"semetey-1-2013:p0425:b005:l013","ordinal":109498,"en":"Warriors' corpses fell in bundles."},{"id":"semetey-1-2013:p0425:b005:l014","ordinal":109499,"en":"The Kyrgyz fled in confusion."},{"id":"semetey-1-2013:p0425:b005:l015","ordinal":109500,"en":"Your father lay asleep."},{"id":"semetey-1-2013:p0425:b005:l016","ordinal":109501,"en":"They begged Khan Manas:"},{"id":"semetey-1-2013:p0425:b005:l017","ordinal":109502,"en":"“Alas, fierce one, what will you do?"},{"id":"semetey-1-2013:p0425:b005:l018","ordinal":109503,"en":"Four Chinese tribes made ready,"},{"id":"semetey-1-2013:p0425:b005:l019","ordinal":109504,"en":"And fell upon our heads;"},{"id":"semetey-1-2013:p0425:b005:l020","ordinal":109505,"en":"They scattered the four kinds of livestock."},{"id":"semetey-1-2013:p0425:b005:l021","ordinal":109506,"en":"Show them something extraordinary!"},{"id":"semetey-1-2013:p0425:b005:l022","ordinal":109507,"en":"These dear people standing here—"},{"id":"semetey-1-2013:p0425:b005:l023","ordinal":109508,"en":"If you truly are our khan,"},{"id":"semetey-1-2013:p0425:b005:l024","ordinal":109509,"en":"Rescue us!” they cried."},{"id":"semetey-1-2013:p0425:b005:l025","ordinal":109510,"en":"The Kyrgyz wept and sobbed,"},{"id":"semetey-1-2013:p0425:b005:l026","ordinal":109511,"en":"Their girls and women screamed,"},{"id":"semetey-1-2013:p0425:b005:l027","ordinal":109512,"en":"When they came to your father, the childlike lion."},{"id":"semetey-1-2013:p0425:b005:l028","ordinal":109513,"en":"Your father, Manas the panther,"},{"id":"semetey-1-2013:p0425:b005:l029","ordinal":109514,"en":"Ran in just his shirt, with great strides,"},{"id":"semetey-1-2013:p0425:b005:l030","ordinal":109515,"en":"Barefoot, bareheaded,"},{"id":"semetey-1-2013:p0425:b005:l031","ordinal":109516,"en":"Bare, without his bulletproof armor,"},{"id":"semetey-1-2013:p0425:b005:l032","ordinal":109517,"en":"Taking a yurt-propping pole in his hand."},{"id":"semetey-1-2013:p0425:b005:l033","ordinal":109518,"en":"“My suffering has come; let me bear it."},{"id":"semetey-1-2013:p0425:b005:l034","ordinal":109519,"en":"At least let me take an enemy down with me!”"},{"id":"semetey-1-2013:p0425:b005:l035","ordinal":109520,"en":"Your father grieved and muttered,"},{"id":"semetey-1-2013:p0425:b005:l036","ordinal":109521,"en":"Wailing as he spoke his last wishes,"},{"id":"semetey-1-2013:p0425:b005:l037","ordinal":109522,"en":"Running on foot, without a horse,"},{"id":"semetey-1-2013:p0425:b005:l038","ordinal":109523,"en":"Giving up hope of his life held in trust."},{"id":"semetey-1-2013:p0425:b005:l039","ordinal":109524,"en":"“Ah, alas, this treacherous, false world,"},{"id":"semetey-1-2013:p0426:b003:l001","ordinal":109525,"en":"My foolishness knows no equal."},{"id":"semetey-1-2013:p0426:b003:l002","ordinal":109526,"en":"The foal of a young mare,"},{"id":"semetey-1-2013:p0426:b003:l003","ordinal":109527,"en":"The tireless steed among horses,"},{"id":"semetey-1-2013:p0426:b003:l004","ordinal":109528,"en":"Akkula the courser is not here."},{"id":"semetey-1-2013:p0426:b003:l005","ordinal":109529,"en":"Was this your nature, shitty world?!"},{"id":"semetey-1-2013:p0426:b003:l006","ordinal":109530,"en":"Alakoo's Kongurbay"},{"id":"semetey-1-2013:p0426:b003:l007","ordinal":109531,"en":"Will roar and strike with his spear."},{"id":"semetey-1-2013:p0426:b003:l008","ordinal":109532,"en":"Red-whip Shypshaydar"},{"id":"semetey-1-2013:p0426:b003:l009","ordinal":109533,"en":"Was a mighty giant;"},{"id":"semetey-1-2013:p0426:b003:l010","ordinal":109534,"en":"He will seize me now."},{"id":"semetey-1-2013:p0426:b003:l011","ordinal":109535,"en":"Ez kara, khan of the Manchus,"},{"id":"semetey-1-2013:p0426:b003:l012","ordinal":109536,"en":"Will have me dragged along the road,"},{"id":"semetey-1-2013:p0426:b003:l013","ordinal":109537,"en":"And torn apart for the great dogs!"},{"id":"semetey-1-2013:p0426:b003:l014","ordinal":109538,"en":"Ez kara, khan of the Manchus,"},{"id":"semetey-1-2013:p0426:b003:l015","ordinal":109539,"en":"Will find some way to deal with me!"},{"id":"semetey-1-2013:p0426:b003:l016","ordinal":109540,"en":"Six thousand Chinese, countless officers,"},{"id":"semetey-1-2013:p0426:b003:l017","ordinal":109541,"en":"And Alakoo's Kongurbay"},{"id":"semetey-1-2013:p0426:b003:l018","ordinal":109542,"en":"Will raid and slaughter my village!"},{"id":"semetey-1-2013:p0426:b003:l019","ordinal":109543,"en":"Ez kara, khan of the Manchus,"},{"id":"semetey-1-2013:p0426:b003:l020","ordinal":109544,"en":"Will find some way to deal with me!"},{"id":"semetey-1-2013:p0426:b003:l021","ordinal":109545,"en":"Will the Kyrgyz be carried off as booty?!"},{"id":"semetey-1-2013:p0426:b003:l022","ordinal":109546,"en":"Will the Chinese bring about my end?!"},{"id":"semetey-1-2013:p0426:b003:l023","ordinal":109547,"en":"Digging my pit deep,"},{"id":"semetey-1-2013:p0426:b003:l024","ordinal":109548,"en":"Starting strife in the dark night,"},{"id":"semetey-1-2013:p0426:b003:l025","ordinal":109549,"en":"The Chinese emperor's people made ready,"},{"id":"semetey-1-2013:p0426:b003:l026","ordinal":109550,"en":"And showed me calamity!”"},{"id":"semetey-1-2013:p0426:b003:l027","ordinal":109551,"en":"Muttering as he spoke his last wishes,"},{"id":"semetey-1-2013:p0426:b003:l028","ordinal":109552,"en":"Grieving as he walked, crying out,"},{"id":"semetey-1-2013:p0426:b003:l029","ordinal":109553,"en":"Your father took a pole,"},{"id":"semetey-1-2013:p0426:b003:l030","ordinal":109554,"en":"Unable to strike the renowned Chinese giant."},{"id":"semetey-1-2013:p0426:b003:l031","ordinal":109555,"en":"Barefoot and bareheaded,"},{"id":"semetey-1-2013:p0426:b003:l032","ordinal":109556,"en":"Your father, once happy Manas,"},{"id":"semetey-1-2013:p0426:b003:l033","ordinal":109557,"en":"Could not find his bearings."},{"id":"semetey-1-2013:p0426:b003:l034","ordinal":109558,"en":"God's sun in heaven grew overcast."},{"id":"semetey-1-2013:p0426:b003:l035","ordinal":109559,"en":"Sixty cares came upon his head at once."},{"id":"semetey-1-2013:p0426:b003:l036","ordinal":109560,"en":"Holding the pole, he begged;"},{"id":"semetey-1-2013:p0426:b003:l037","ordinal":109561,"en":"Your hero stammered his profession of faith."},{"id":"semetey-1-2013:p0426:b003:l038","ordinal":109562,"en":"“Akkula, whom I rode without rest—"},{"id":"semetey-1-2013:p0426:b003:l039","ordinal":109563,"en":"Has he come to rest this year?"},{"id":"semetey-1-2013:p0426:b004:l001","ordinal":109564,"en":"These dear people, robbed of peace—"},{"id":"semetey-1-2013:p0426:b004:l002","ordinal":109565,"en":"Did the Chinese come in secret"},{"id":"semetey-1-2013:p0426:b004:l003","ordinal":109566,"en":"And silence them without a sound?"},{"id":"semetey-1-2013:p0426:b004:l004","ordinal":109567,"en":"I shall take an enemy down with me,” he said."},{"id":"semetey-1-2013:p0426:b004:l005","ordinal":109568,"en":"Your blessed father strode about."}]
