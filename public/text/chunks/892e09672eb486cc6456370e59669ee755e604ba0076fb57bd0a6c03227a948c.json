[{"id":"seytek-2012:p0966:b003:l014","ordinal":368897,"en":"Had bestowed these without measure."},{"id":"seytek-2012:p0966:b003:l015","ordinal":368898,"en":"Her dignity was rare and pearl-like,"},{"id":"seytek-2012:p0966:b003:l016","ordinal":368899,"en":"Her form like a maiden made of light."},{"id":"seytek-2012:p0966:b003:l017","ordinal":368900,"en":"Without so much as a smile, she stood solemn,"},{"id":"seytek-2012:p0966:b003:l018","ordinal":368901,"en":"Her calm deliberation evident;"},{"id":"seytek-2012:p0966:b003:l019","ordinal":368902,"en":"Whenever one saw her judgment,"},{"id":"seytek-2012:p0966:b003:l020","ordinal":368903,"en":"A mortal soul entrusted to God rejoiced."},{"id":"seytek-2012:p0966:b003:l021","ordinal":368904,"en":"The lion-maiden wrestler’s"},{"id":"seytek-2012:p0966:b003:l022","ordinal":368905,"en":"Character revealed itself thus:"},{"id":"seytek-2012:p0966:b003:l023","ordinal":368906,"en":"She strode behind them, solemn,"},{"id":"seytek-2012:p0966:b003:l024","ordinal":368907,"en":"And the poor woman of camel-like stature"},{"id":"seytek-2012:p0966:b003:l025","ordinal":368908,"en":"Had her moonlike face bathed in light,"},{"id":"seytek-2012:p0966:b003:l026","ordinal":368909,"en":"Her heroism plain to see."},{"id":"seytek-2012:p0966:b003:l027","ordinal":368910,"en":"She donned her battle armor;"},{"id":"seytek-2012:p0966:b003:l028","ordinal":368911,"en":"The mighty maiden, fitted for war,"},{"id":"seytek-2012:p0966:b003:l029","ordinal":368912,"en":"Destroyed whoever approached her,"},{"id":"seytek-2012:p0966:b003:l030","ordinal":368913,"en":"And went forth to win the great prize."},{"id":"seytek-2012:p0966:b003:l031","ordinal":368914,"en":"Her arms were exceptional, her fury fierce;"},{"id":"seytek-2012:p0966:b003:l032","ordinal":368915,"en":"She laid her mortal enemies low."},{"id":"seytek-2012:p0966:b003:l033","ordinal":368916,"en":"Her heroism became renowned,"},{"id":"seytek-2012:p0966:b003:l034","ordinal":368917,"en":"And enemies who faced her recoiled."},{"id":"seytek-2012:p0966:b003:l035","ordinal":368918,"en":"Those who coveted her were slain,"},{"id":"seytek-2012:p0966:b003:l036","ordinal":368919,"en":"And many reins were pulled tight."},{"id":"seytek-2012:p0966:b003:l037","ordinal":368920,"en":"Thinking, “I shall take the maiden,”"},{"id":"seytek-2012:p0966:b003:l038","ordinal":368921,"en":"Many wrestlers and many warriors"},{"id":"seytek-2012:p0966:b003:l039","ordinal":368922,"en":"Fell prostrate when they faced her."},{"id":"seytek-2012:p0966:b003:l040","ordinal":368923,"en":"Thinking, “I shall mow them like spring grass,"},{"id":"seytek-2012:p0967:b002:l001","ordinal":368924,"en":"I shall subdue their noble people,"},{"id":"seytek-2012:p0967:b002:l002","ordinal":368925,"en":"And slaughter their proud nation.”"},{"id":"seytek-2012:p0967:b002:l003","ordinal":368926,"en":"Their heads were ensnared in suffering;"},{"id":"seytek-2012:p0967:b002:l004","ordinal":368927,"en":"Eighty champions and eighty companies,"},{"id":"seytek-2012:p0967:b002:l005","ordinal":368928,"en":"And multitudes came out to clash."},{"id":"seytek-2012:p0967:b002:l006","ordinal":368929,"en":"They had wrestlers and warriors,"},{"id":"seytek-2012:p0967:b002:l007","ordinal":368930,"en":"And Sarybay stood among them;"},{"id":"seytek-2012:p0967:b002:l008","ordinal":368931,"en":"They had champions and lions,"},{"id":"seytek-2012:p0967:b002:l009","ordinal":368932,"en":"Lions who had thrown the whole world into turmoil."},{"id":"seytek-2012:p0967:b002:l010","ordinal":368933,"en":"Blustering with swollen lungs,"},{"id":"seytek-2012:p0967:b002:l011","ordinal":368934,"en":"Their arrogant breasts pounding,"},{"id":"seytek-2012:p0967:b002:l012","ordinal":368935,"en":"Sarybay attacked."},{"id":"seytek-2012:p0967:b002:l013","ordinal":368936,"en":"Heroes fell and khans died;"},{"id":"seytek-2012:p0967:b002:l014","ordinal":368937,"en":"Through the wretched villain’s great savagery,"},{"id":"seytek-2012:p0967:b002:l015","ordinal":368938,"en":"All who faced him perished."},{"id":"seytek-2012:p0967:b002:l016","ordinal":368939,"en":"Sarybay himself was wounded,"},{"id":"seytek-2012:p0967:b002:l017","ordinal":368940,"en":"And many others came to grief."},{"id":"seytek-2012:p0967:b002:l018","ordinal":368941,"en":"It became a great and dreadful calamity,"},{"id":"seytek-2012:p0967:b002:l019","ordinal":368942,"en":"A deafening uproar."},{"id":"seytek-2012:p0967:b002:l020","ordinal":368943,"en":"This was the maiden’s battle;"},{"id":"seytek-2012:p0967:b002:l021","ordinal":368944,"en":"She fell into death-dealing hands."},{"id":"seytek-2012:p0967:b002:l022","ordinal":368945,"en":"Sarybay, son of the monster,"},{"id":"seytek-2012:p0967:b002:l023","ordinal":368946,"en":"Had his head split seven times,"},{"id":"seytek-2012:p0967:b002:l024","ordinal":368947,"en":"And was stabbed through seven layers."},{"id":"seytek-2012:p0967:b002:l025","ordinal":368948,"en":"Clouds gathered in the sky;"},{"id":"seytek-2012:p0967:b002:l026","ordinal":368949,"en":"He raged madly as he neared death—"},{"id":"seytek-2012:p0967:b002:l027","ordinal":368950,"en":"Such was his measure when beheld."},{"id":"seytek-2012:p0967:b002:l028","ordinal":368951,"en":"They entered a grievous conflict,"},{"id":"seytek-2012:p0967:b002:l029","ordinal":368952,"en":"Fighting through summer and winter,"},{"id":"seytek-2012:p0967:b002:l030","ordinal":368953,"en":"Wrestling and accusing each other,"},{"id":"seytek-2012:p0967:b002:l031","ordinal":368954,"en":"Passing their days in spear combat."},{"id":"seytek-2012:p0967:b002:l032","ordinal":368955,"en":"Fierce in wrath was Sarybay;"},{"id":"seytek-2012:p0967:b002:l033","ordinal":368956,"en":"Kuyaly, daughter of Kayypchal,"},{"id":"seytek-2012:p0967:b002:l034","ordinal":368957,"en":"Showed such prowess as a wrestler."},{"id":"seytek-2012:p0967:b002:l035","ordinal":368958,"en":"With the warrior son of the monster,"},{"id":"seytek-2012:p0967:b002:l036","ordinal":368959,"en":"With the lion who greased the earth with blood,"},{"id":"seytek-2012:p0967:b002:l037","ordinal":368960,"en":"She grappled like a white snake,"},{"id":"seytek-2012:p0967:b002:l038","ordinal":368961,"en":"And they mauled each other like ravenous stallion camels."},{"id":"seytek-2012:p0967:b002:l039","ordinal":368962,"en":"They had struggled against each other before;"},{"id":"seytek-2012:p0967:b002:l040","ordinal":368963,"en":"When the infidel son of the monster"},{"id":"seytek-2012:p0967:b003:l001","ordinal":368964,"en":"Was still young, she had encountered him."},{"id":"seytek-2012:p0967:b003:l002","ordinal":368965,"en":"She wrecked his camp and seized his plunder,"},{"id":"seytek-2012:p0967:b003:l003","ordinal":368966,"en":"Slaughtered his khan and left him sprawled,"},{"id":"seytek-2012:p0967:b003:l004","ordinal":368967,"en":"And waged a terrible battle."},{"id":"seytek-2012:p0967:b003:l005","ordinal":368968,"en":"She had slaughtered his people,"},{"id":"seytek-2012:p0967:b003:l006","ordinal":368969,"en":"And divided his treasury."},{"id":"seytek-2012:p0967:b003:l007","ordinal":368970,"en":"She wiped out those who wore braids,"},{"id":"seytek-2012:p0967:b003:l008","ordinal":368971,"en":"And enslaved all she encountered;"},{"id":"seytek-2012:p0967:b003:l009","ordinal":368972,"en":"She reduced the topknotted to ashes,"},{"id":"seytek-2012:p0967:b003:l010","ordinal":368973,"en":"And whenever enemies came to fight,"},{"id":"seytek-2012:p0967:b003:l011","ordinal":368974,"en":"She hunted them down and destroyed them."},{"id":"seytek-2012:p0967:b003:l012","ordinal":368975,"en":"She threw down those lacking sense,"},{"id":"seytek-2012:p0967:b003:l013","ordinal":368976,"en":"And many times before had made the swine"},{"id":"seytek-2012:p0967:b003:l014","ordinal":368977,"en":"Suffer torment at her hands."},{"id":"seytek-2012:p0967:b003:l015","ordinal":368978,"en":"Against the hero Sarybay,"},{"id":"seytek-2012:p0967:b003:l016","ordinal":368979,"en":"She followed close upon his yellow trail,"},{"id":"seytek-2012:p0967:b003:l017","ordinal":368980,"en":"And stretched him out like one struck by wasting sickness."},{"id":"seytek-2012:p0967:b003:l018","ordinal":368981,"en":"Driving the charging warriors before her,"},{"id":"seytek-2012:p0967:b003:l019","ordinal":368982,"en":"Kuyaly, daughter of Kayypchal,"},{"id":"seytek-2012:p0967:b003:l020","ordinal":368983,"en":"Raged onward upon Jeljetpes;"},{"id":"seytek-2012:p0967:b003:l021","ordinal":368984,"en":"She donned her armor for war,"},{"id":"seytek-2012:p0967:b003:l022","ordinal":368985,"en":"Her companions swelling into a mighty host,"},{"id":"seytek-2012:p0967:b003:l023","ordinal":368986,"en":"And whoever approached was struck down."},{"id":"seytek-2012:p0967:b003:l024","ordinal":368987,"en":"Blood flowed from her grappling,"},{"id":"seytek-2012:p0967:b003:l025","ordinal":368988,"en":"And dust rose wherever she challenged."},{"id":"seytek-2012:p0967:b003:l026","ordinal":368989,"en":"Early words became late deeds;"},{"id":"seytek-2012:p0967:b003:l027","ordinal":368990,"en":"Her two eyes seemed to become four."},{"id":"seytek-2012:p0967:b003:l028","ordinal":368991,"en":"On an earlier occasion,"},{"id":"seytek-2012:p0967:b003:l029","ordinal":368992,"en":"When they had met face-to-face,"},{"id":"seytek-2012:p0967:b003:l030","ordinal":368993,"en":"And gone forth to raise battle,"},{"id":"seytek-2012:p0967:b003:l031","ordinal":368994,"en":"They stood pummeling each other,"},{"id":"seytek-2012:p0967:b003:l032","ordinal":368995,"en":"Until they came to binding hands."},{"id":"seytek-2012:p0967:b003:l033","ordinal":368996,"en":"She had inflicted utter calamity"},{"id":"seytek-2012:p0967:b003:l034","ordinal":368997,"en":"Upon Sarybay."},{"id":"seytek-2012:p0967:b003:l035","ordinal":368998,"en":"She bound the strong arms of"},{"id":"seytek-2012:p0967:b003:l036","ordinal":368999,"en":"Sarybay’s countless host and blocked their open road;"},{"id":"seytek-2012:p0967:b003:l037","ordinal":369000,"en":"Around that infidel Sarybay,"},{"id":"seytek-2012:p0967:b003:l038","ordinal":369001,"en":"She cast a ring about his feet,"},{"id":"seytek-2012:p0967:b003:l039","ordinal":369002,"en":"Waging a daylong battle for his blood,"},{"id":"seytek-2012:p0967:b003:l040","ordinal":369003,"en":"Striking once more at his life."},{"id":"seytek-2012:p0968:b002:l001","ordinal":369004,"en":"When the struggle reached its fiercest,"},{"id":"seytek-2012:p0968:b002:l002","ordinal":369005,"en":"Seytek brought forward a special force"},{"id":"seytek-2012:p0968:b002:l003","ordinal":369006,"en":"And compelled them to submit."},{"id":"seytek-2012:p0968:b002:l004","ordinal":369007,"en":"A mighty battle and tremendous uproar—"},{"id":"seytek-2012:p0968:b002:l005","ordinal":369008,"en":"Such was the clash they waged."},{"id":"seytek-2012:p0968:b002:l006","ordinal":369009,"en":"But Sarybay"},{"id":"seytek-2012:p0968:b002:l007","ordinal":369010,"en":"Was an extraordinarily powerful weather-worker;"},{"id":"seytek-2012:p0968:b002:l008","ordinal":369011,"en":"Rain poured over every ridge,"},{"id":"seytek-2012:p0968:b002:l009","ordinal":369012,"en":"Hail beat upon every hollow,"},{"id":"seytek-2012:p0968:b002:l010","ordinal":369013,"en":"Fog covered the open plain,"},{"id":"seytek-2012:p0968:b002:l011","ordinal":369014,"en":"And fierce winds and creeping mist"},{"id":"seytek-2012:p0968:b002:l012","ordinal":369015,"en":"Closed in and blinded every eye."},{"id":"seytek-2012:p0968:b002:l013","ordinal":369016,"en":"Clouds gathered across the sky;"},{"id":"seytek-2012:p0968:b002:l014","ordinal":369017,"en":"Sarybay led Kuyaly astray"},{"id":"seytek-2012:p0968:b002:l015","ordinal":369018,"en":"And escaped from her,"},{"id":"seytek-2012:p0968:b002:l016","ordinal":369019,"en":"Barely saving himself from death."},{"id":"seytek-2012:p0968:b002:l017","ordinal":369020,"en":"Your bellowing champion,"},{"id":"seytek-2012:p0968:b002:l018","ordinal":369021,"en":"To wage battle against the full-armed infidel,"},{"id":"seytek-2012:p0968:b002:l019","ordinal":369022,"en":"And go forth to strike him,"},{"id":"seytek-2012:p0968:b002:l020","ordinal":369023,"en":"Gathered her strength for a desperate assault;"},{"id":"seytek-2012:p0968:b002:l021","ordinal":369024,"en":"To stand as a warrior on the field,"},{"id":"seytek-2012:p0968:b002:l022","ordinal":369025,"en":"The lion-maiden Kuyaly"},{"id":"seytek-2012:p0968:b002:l023","ordinal":369026,"en":"Chose and donned a pale-gray robe,"},{"id":"seytek-2012:p0968:b002:l024","ordinal":369027,"en":"And mounted the swift steed Jeljetpes."},{"id":"seytek-2012:p0968:b002:l025","ordinal":369028,"en":"Composed yet fierce for combat,"},{"id":"seytek-2012:p0968:b002:l026","ordinal":369029,"en":"The mighty maiden cast her life aside"},{"id":"seytek-2012:p0968:b002:l027","ordinal":369030,"en":"And girded on a naked sword."},{"id":"seytek-2012:p0968:b002:l028","ordinal":369031,"en":"Excited by her own fury,"},{"id":"seytek-2012:p0968:b002:l029","ordinal":369032,"en":"She panted with rage"},{"id":"seytek-2012:p0968:b002:l030","ordinal":369033,"en":"And turned Jeljetpes by the mouth."},{"id":"seytek-2012:p0968:b002:l031","ordinal":369034,"en":"Saying this to the hero Seytek,"},{"id":"seytek-2012:p0968:b002:l032","ordinal":369035,"en":"The lion-maiden came and stood before him:"},{"id":"seytek-2012:p0968:b002:l033","ordinal":369036,"en":"“I am the one who will fight Sarybay;"},{"id":"seytek-2012:p0968:b002:l034","ordinal":369037,"en":"I shall cast him into the melee."},{"id":"seytek-2012:p0968:b002:l035","ordinal":369038,"en":"Sarybay’s burden of calamity"},{"id":"seytek-2012:p0968:b002:l036","ordinal":369039,"en":"I shall take upon myself."},{"id":"seytek-2012:p0968:b002:l037","ordinal":369040,"en":"At the call to battle I shall charge ahead;"},{"id":"seytek-2012:p0968:b002:l038","ordinal":369041,"en":"His torment and his death"},{"id":"seytek-2012:p0968:b002:l039","ordinal":369042,"en":"I shall seize with both hands and prevail!"},{"id":"seytek-2012:p0968:b002:l040","ordinal":369043,"en":"I shall slaughter his heroes.”"},{"id":"seytek-2012:p0968:b003:l001","ordinal":369044,"en":"So spoke Kuyaly,"},{"id":"seytek-2012:p0968:b003:l002","ordinal":369045,"en":"And such was her bravery."},{"id":"seytek-2012:p0968:b003:l003","ordinal":369046,"en":"Her precious hair, long as feather grass,"},{"id":"seytek-2012:p0968:b003:l004","ordinal":369047,"en":"She wound and knotted upon her crown,"},{"id":"seytek-2012:p0968:b003:l005","ordinal":369048,"en":"And donned her arrow-proof coat."},{"id":"seytek-2012:p0968:b003:l006","ordinal":369049,"en":"A golden-cheeked battle-axe"},{"id":"seytek-2012:p0968:b003:l007","ordinal":369050,"en":"She slung upon her bare forearm;"},{"id":"seytek-2012:p0968:b003:l008","ordinal":369051,"en":"A double-edged Zulfiqar"},{"id":"seytek-2012:p0968:b003:l009","ordinal":369052,"en":"Was gripped in her hand."},{"id":"seytek-2012:p0968:b003:l010","ordinal":369053,"en":"Breaking through and opening a path,"},{"id":"seytek-2012:p0968:b003:l011","ordinal":369054,"en":"She charged the host without pause,"},{"id":"seytek-2012:p0968:b003:l012","ordinal":369055,"en":"Shouting, “Do not flee!”"},{"id":"seytek-2012:p0968:b003:l013","ordinal":369056,"en":"And raising a true battle cry,"},{"id":"seytek-2012:p0968:b003:l014","ordinal":369057,"en":"She turned her face toward death."},{"id":"seytek-2012:p0968:b003:l015","ordinal":369058,"en":"With a steel shaft and sharpened point,"},{"id":"seytek-2012:p0968:b003:l016","ordinal":369059,"en":"A decorated spear fit for war,"},{"id":"seytek-2012:p0968:b003:l017","ordinal":369060,"en":"She thrust forth with a thunderous roar."},{"id":"seytek-2012:p0968:b003:l018","ordinal":369061,"en":"Before the maiden’s courage,"},{"id":"seytek-2012:p0968:b003:l019","ordinal":369062,"en":"Even khans could not bear to look;"},{"id":"seytek-2012:p0968:b003:l020","ordinal":369063,"en":"No mortal could approach"},{"id":"seytek-2012:p0968:b003:l021","ordinal":369064,"en":"The maiden in her heroism."},{"id":"seytek-2012:p0968:b003:l022","ordinal":369065,"en":"When she merely surged,"},{"id":"seytek-2012:p0968:b003:l023","ordinal":369066,"en":"Even mountains could not withstand her;"},{"id":"seytek-2012:p0968:b003:l024","ordinal":369067,"en":"When she moved against the wicked,"},{"id":"seytek-2012:p0968:b003:l025","ordinal":369068,"en":"Even swarming Chinese hosts could not defeat her."},{"id":"seytek-2012:p0968:b003:l026","ordinal":369069,"en":"Then Kuyaly"},{"id":"seytek-2012:p0968:b003:l027","ordinal":369070,"en":"Turned straight toward Sarybay,"},{"id":"seytek-2012:p0968:b003:l028","ordinal":369071,"en":"Taking her steel spear in hand."},{"id":"seytek-2012:p0968:b003:l029","ordinal":369072,"en":"When she lashed her horse,"},{"id":"seytek-2012:p0968:b003:l030","ordinal":369073,"en":"Its mouth gaped like a cavern."},{"id":"seytek-2012:p0968:b003:l031","ordinal":369074,"en":"Her bravery was extraordinary,"},{"id":"seytek-2012:p0968:b003:l032","ordinal":369075,"en":"Her appearance majestic;"},{"id":"seytek-2012:p0968:b003:l033","ordinal":369076,"en":"When mounted, her bearing"},{"id":"seytek-2012:p0968:b003:l034","ordinal":369077,"en":"Was unlike that of any other human."},{"id":"seytek-2012:p0968:b003:l035","ordinal":369078,"en":"Throughout the entire world,"},{"id":"seytek-2012:p0968:b003:l036","ordinal":369079,"en":"To every long-eared elder,"},{"id":"seytek-2012:p0968:b003:l037","ordinal":369080,"en":"To all people everywhere,"},{"id":"seytek-2012:p0968:b003:l038","ordinal":369081,"en":"To all who knew or saw her,"},{"id":"seytek-2012:p0968:b003:l039","ordinal":369082,"en":"Her name was famed like that of a saint."},{"id":"seytek-2012:p0968:b003:l040","ordinal":369083,"en":"The poor soul’s fortune stood in perfect balance."},{"id":"seytek-2012:p0969:b002:l001","ordinal":369084,"en":"To all of the universe"},{"id":"seytek-2012:p0969:b002:l002","ordinal":369085,"en":"He is a bastard whose name is heard."},{"id":"seytek-2012:p0969:b002:l003","ordinal":369086,"en":"Shamdagai is unpredictable"},{"id":"seytek-2012:p0969:b002:l004","ordinal":369087,"en":"Shak held out his spear,"},{"id":"seytek-2012:p0969:b002:l005","ordinal":369088,"en":"Chatishyan slaughtered."},{"id":"seytek-2012:p0969:b002:l006","ordinal":369089,"en":"God don't show his face"},{"id":"seytek-2012:p0969:b002:l007","ordinal":369090,"en":"Troubled by many divisions,"},{"id":"seytek-2012:p0969:b002:l008","ordinal":369091,"en":"Put in turn,"},{"id":"seytek-2012:p0969:b002:l009","ordinal":369092,"en":"There was a constant conflict,"},{"id":"seytek-2012:p0969:b002:l010","ordinal":369093,"en":"There was a noise in the sky,"},{"id":"seytek-2012:p0969:b002:l011","ordinal":369094,"en":"Sarybay joined the meeting."},{"id":"seytek-2012:p0969:b002:l012","ordinal":369095,"en":"The big hero is humble."},{"id":"seytek-2012:p0969:b002:l013","ordinal":369096,"en":"Screaming angrily"},{"id":"seytek-2012:p0969:b002:l014","ordinal":369097,"en":"A rabid man who sees a wrestler"},{"id":"seytek-2012:p0969:b002:l015","ordinal":369098,"en":"Yelling that you are a bitch:"},{"id":"seytek-2012:p0969:b002:l016","ordinal":369099,"en":"\"I have the strange power of death,"},{"id":"seytek-2012:p0969:b002:l017","ordinal":369100,"en":"Kanchyk wrestler listen,"},{"id":"seytek-2012:p0969:b002:l018","ordinal":369101,"en":"Don't turn your back,"},{"id":"seytek-2012:p0969:b002:l019","ordinal":369102,"en":"Do not start muttering,"},{"id":"seytek-2012:p0969:b002:l020","ordinal":369103,"en":"Like other cousins,"},{"id":"seytek-2012:p0969:b002:l021","ordinal":369104,"en":"Like the people who started"},{"id":"seytek-2012:p0969:b002:l022","ordinal":369105,"en":"I will give you the account!"},{"id":"seytek-2012:p0969:b002:l023","ordinal":369106,"en":"A great elder from long ago,"},{"id":"seytek-2012:p0969:b002:l024","ordinal":369107,"en":"The path of the female is senior,"},{"id":"seytek-2012:p0969:b002:l025","ordinal":369108,"en":"If a soul is created, a creature,"},{"id":"seytek-2012:p0969:b002:l026","ordinal":369109,"en":"Give al