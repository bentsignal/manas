[{"id":"semetey-1-2013:p0774:b003:l001","ordinal":136193,"en":"She had laid it at her hip."},{"id":"semetey-1-2013:p0774:b003:l002","ordinal":136194,"en":"In great Kobosh's embrace"},{"id":"semetey-1-2013:p0774:b003:l003","ordinal":136195,"en":"She lay and would not rise."},{"id":"semetey-1-2013:p0774:b003:l004","ordinal":136196,"en":"That fierce woman Akylai,"},{"id":"semetey-1-2013:p0774:b003:l005","ordinal":136197,"en":"The witless wretch—"},{"id":"semetey-1-2013:p0774:b003:l006","ordinal":136198,"en":"He swept that woman up and flung her,"},{"id":"semetey-1-2013:p0774:b003:l007","ordinal":136199,"en":"Ah, the orphan child, the hero!"},{"id":"semetey-1-2013:p0774:b003:l008","ordinal":136200,"en":"Akylay rolled away,"},{"id":"semetey-1-2013:p0774:b003:l009","ordinal":136201,"en":"The wretch tumbled;"},{"id":"semetey-1-2013:p0774:b003:l010","ordinal":136202,"en":"Rolling toward the stone hearth,"},{"id":"semetey-1-2013:p0774:b003:l011","ordinal":136203,"en":"Akylay struck the ground."},{"id":"semetey-1-2013:p0774:b003:l012","ordinal":136204,"en":"Her back was bent and hunched;"},{"id":"semetey-1-2013:p0774:b003:l013","ordinal":136205,"en":"She had no strength to utter “Ah,”"},{"id":"semetey-1-2013:p0774:b003:l014","ordinal":136206,"en":"Her eyes bulged out."},{"id":"semetey-1-2013:p0774:b003:l015","ordinal":136207,"en":"Her knees ached, crushed and battered,"},{"id":"semetey-1-2013:p0774:b003:l016","ordinal":136208,"en":"Every bone throbbed with pain."},{"id":"semetey-1-2013:p0774:b003:l017","ordinal":136209,"en":"“The humiliation I never suffered from Manas"},{"id":"semetey-1-2013:p0774:b003:l018","ordinal":136210,"en":"I have suffered from his son,” she said,"},{"id":"semetey-1-2013:p0774:b003:l019","ordinal":136211,"en":"Akylay weeping and shrieking."},{"id":"semetey-1-2013:p0774:b003:l020","ordinal":136212,"en":"The child prince, the orphan slave,"},{"id":"semetey-1-2013:p0774:b003:l021","ordinal":136213,"en":"Appeared like a calamity."},{"id":"semetey-1-2013:p0774:b003:l022","ordinal":136214,"en":"The wealth that Manas left,"},{"id":"semetey-1-2013:p0774:b003:l023","ordinal":136215,"en":"Without leaving so much as a hair,"},{"id":"semetey-1-2013:p0774:b003:l024","ordinal":136216,"en":"From the hands of Abyke and Kobosh"},{"id":"semetey-1-2013:p0774:b003:l025","ordinal":136217,"en":"He seemed to have seized."},{"id":"semetey-1-2013:p0774:b003:l026","ordinal":136218,"en":"Lifting the great saddlebag,"},{"id":"semetey-1-2013:p0774:b003:l027","ordinal":136219,"en":"Semetey, onto Aktulpar,"},{"id":"semetey-1-2013:p0774:b003:l028","ordinal":136220,"en":"Had apparently loaded it."},{"id":"semetey-1-2013:p0774:b003:l029","ordinal":136221,"en":"Making ready, full of spirit,"},{"id":"semetey-1-2013:p0774:b003:l030","ordinal":136222,"en":"Preparing his weapons,"},{"id":"semetey-1-2013:p0774:b003:l031","ordinal":136223,"en":"As the child was going out,"},{"id":"semetey-1-2013:p0774:b003:l032","ordinal":136224,"en":"The support left by Manas,"},{"id":"semetey-1-2013:p0774:b003:l033","ordinal":136225,"en":"That watchful Bakai,"},{"id":"semetey-1-2013:p0774:b003:l034","ordinal":136226,"en":"To Manas's orphan son,"},{"id":"semetey-1-2013:p0774:b003:l035","ordinal":136227,"en":"Biting his lip and winking,"},{"id":"semetey-1-2013:p0774:b003:l036","ordinal":136228,"en":"As Bakai stood beside him,"},{"id":"semetey-1-2013:p0774:b003:l037","ordinal":136229,"en":"Manas's son, the orphan hero—"},{"id":"semetey-1-2013:p0774:b003:l038","ordinal":136230,"en":"The mighty treasure taken from China"},{"id":"semetey-1-2013:p0774:b003:l039","ordinal":136231,"en":"Was in Abyke's hands."},{"id":"semetey-1-2013:p0774:b004:l001","ordinal":136232,"en":"What was there, and what was not!"},{"id":"semetey-1-2013:p0774:b004:l002","ordinal":136233,"en":"Bukhara's costly yellow-mottled cloth,"},{"id":"semetey-1-2013:p0774:b004:l003","ordinal":136234,"en":"Andijan's costly black-mottled weave,"},{"id":"semetey-1-2013:p0774:b004:l004","ordinal":136235,"en":"Were packed in one saddlebag."},{"id":"semetey-1-2013:p0774:b004:l005","ordinal":136236,"en":"If you ask about that saddlebag,"},{"id":"semetey-1-2013:p0774:b004:l006","ordinal":136237,"en":"Its lock was gold, its fastening copper,"},{"id":"semetey-1-2013:p0774:b004:l007","ordinal":136238,"en":"Pale in color, measuring an arshin—"},{"id":"semetey-1-2013:p0774:b004:l008","ordinal":136239,"en":"Now came this saddlebag's turn."},{"id":"semetey-1-2013:p0774:b004:l009","ordinal":136240,"en":"Satisfying the eye's desire,"},{"id":"semetey-1-2013:p0774:b004:l010","ordinal":136241,"en":"Costly crimson fabric,"},{"id":"semetey-1-2013:p0774:b004:l011","ordinal":136242,"en":"Mixed with gold and rubies,"},{"id":"semetey-1-2013:p0774:b004:l012","ordinal":136243,"en":"Was packed in that saddlebag."},{"id":"semetey-1-2013:p0774:b004:l013","ordinal":136244,"en":"When the child took the saddlebag,"},{"id":"semetey-1-2013:p0774:b004:l014","ordinal":136245,"en":"From his father, generous Manas,"},{"id":"semetey-1-2013:p0774:b004:l015","ordinal":136246,"en":"The wealth that had remained—"},{"id":"semetey-1-2013:p0774:b004:l016","ordinal":136247,"en":"Semetey had taken it, it seems."},{"id":"semetey-1-2013:p0774:b004:l017","ordinal":136248,"en":"Upon the six villains, terror"},{"id":"semetey-1-2013:p0774:b004:l018","ordinal":136249,"en":"Semetey had brought, it seems."},{"id":"semetey-1-2013:p0774:b004:l019","ordinal":136250,"en":"Leaving none of his wealth behind,"},{"id":"semetey-1-2013:p0774:b004:l020","ordinal":136251,"en":"Semetey had taken it, it seems."},{"id":"semetey-1-2013:p0774:b004:l021","ordinal":136252,"en":"Plundering their valuables thus,"},{"id":"semetey-1-2013:p0774:b004:l022","ordinal":136253,"en":"Semetey had gone, it seems."},{"id":"semetey-1-2013:p0774:b004:l023","ordinal":136254,"en":"The six villains' ruin"},{"id":"semetey-1-2013:p0774:b004:l024","ordinal":136255,"en":"Semetey had brought about, it seems."},{"id":"semetey-1-2013:p0774:b004:l025","ordinal":136256,"en":"This orphan of Manas,"},{"id":"semetey-1-2013:p0774:b004:l026","ordinal":136257,"en":"An orphan, had grown to maturity,"},{"id":"semetey-1-2013:p0774:b004:l027","ordinal":136258,"en":"And thus joined their ranks."},{"id":"semetey-1-2013:p0774:b004:l028","ordinal":136259,"en":"He grew to manhood, became a hero,"},{"id":"semetey-1-2013:p0774:b004:l029","ordinal":136260,"en":"Became the equal of a hero's son."},{"id":"semetey-1-2013:p0774:b004:l030","ordinal":136261,"en":"Wherever your orphan arrived,"},{"id":"semetey-1-2013:p0774:b004:l031","ordinal":136262,"en":"The standard-winner raised his banner,"},{"id":"semetey-1-2013:p0774:b004:l032","ordinal":136263,"en":"He raised turmoil among the six villains."},{"id":"semetey-1-2013:p0774:b004:l033","ordinal":136264,"en":"Manas's son, the rogue—"},{"id":"semetey-1-2013:p0774:b004:l034","ordinal":136265,"en":"Even if he died, there was no regret."},{"id":"semetey-1-2013:p0774:b004:l035","ordinal":136266,"en":"In the hands of the six villains"},{"id":"semetey-1-2013:p0774:b004:l036","ordinal":136267,"en":"Not a trace of anything remained."},{"id":"semetey-1-2013:p0774:b004:l037","ordinal":136268,"en":"Abyke stood there working himself up,"},{"id":"semetey-1-2013:p0774:b004:l038","ordinal":136269,"en":"Speaking to the dog Kobosh."},{"id":"semetey-1-2013:p0774:b004:l039","ordinal":136270,"en":"“A fool has no kinsmen,"},{"id":"semetey-1-2013:p0775:b003:l001","ordinal":136271,"en":"You care about nothing."},{"id":"semetey-1-2013:p0775:b003:l002","ordinal":136272,"en":"My fool, you have ruined me;"},{"id":"semetey-1-2013:p0775:b003:l003","ordinal":136273,"en":"You meant to dig my pit,"},{"id":"semetey-1-2013:p0775:b003:l004","ordinal":136274,"en":"You meant to boil my misery."},{"id":"semetey-1-2013:p0775:b003:l005","ordinal":136275,"en":"You meant to show my eyes"},{"id":"semetey-1-2013:p0775:b003:l006","ordinal":136276,"en":"A wonder no human could bear to see."},{"id":"semetey-1-2013:p0775:b003:l007","ordinal":136277,"en":"You have proved a foolish villain;"},{"id":"semetey-1-2013:p0775:b003:l008","ordinal":136278,"en":"He was an enemy of ours."},{"id":"semetey-1-2013:p0775:b003:l009","ordinal":136279,"en":"My crimson-red treasures—"},{"id":"semetey-1-2013:p0775:b003:l010","ordinal":136280,"en":"Unable to keep quiet without shouting,"},{"id":"semetey-1-2013:p0775:b003:l011","ordinal":136281,"en":"My fool, you meant to ruin me."},{"id":"semetey-1-2013:p0775:b003:l012","ordinal":136282,"en":"Before you even saw the orphan,"},{"id":"semetey-1-2013:p0775:b003:l013","ordinal":136283,"en":"You spoke to him of battle."},{"id":"semetey-1-2013:p0775:b003:l014","ordinal":136284,"en":"If you keep on like this, fool,"},{"id":"semetey-1-2013:p0775:b003:l015","ordinal":136285,"en":"You will bring about my ruin."},{"id":"semetey-1-2013:p0775:b003:l016","ordinal":136286,"en":"Can a human be like you?"},{"id":"semetey-1-2013:p0775:b003:l017","ordinal":136287,"en":"Can one who calls you human come to any good?"},{"id":"semetey-1-2013:p0775:b003:l018","ordinal":136288,"en":"You have blackened my face;"},{"id":"semetey-1-2013:p0775:b003:l019","ordinal":136289,"en":"You showed your hostility"},{"id":"semetey-1-2013:p0775:b003:l020","ordinal":136290,"en":"To the orphan who came to our home!”"},{"id":"semetey-1-2013:p0775:b003:l021","ordinal":136291,"en":"Abyke spoke and fell silent."},{"id":"semetey-1-2013:p0775:b003:l022","ordinal":136292,"en":"This orphan son of Manas"},{"id":"semetey-1-2013:p0775:b003:l023","ordinal":136293,"en":"Made for the doorway."},{"id":"semetey-1-2013:p0775:b003:l024","ordinal":136294,"en":"Bending his knees toward the ground,"},{"id":"semetey-1-2013:p0775:b003:l025","ordinal":136295,"en":"Running toward the doorway,"},{"id":"semetey-1-2013:p0775:b003:l026","ordinal":136296,"en":"Bakai and Semetey"},{"id":"semetey-1-2013:p0775:b003:l027","ordinal":136297,"en":"Bound and fastened it again,"},{"id":"semetey-1-2013:p0775:b003:l028","ordinal":136298,"en":"The wealth that Manas had left,"},{"id":"semetey-1-2013:p0775:b003:l029","ordinal":136299,"en":"Securing it to the saddle straps."},{"id":"semetey-1-2013:p0775:b003:l030","ordinal":136300,"en":"Understanding, the child wept bitterly;"},{"id":"semetey-1-2013:p0775:b003:l031","ordinal":136301,"en":"All these possessions"},{"id":"semetey-1-2013:p0775:b003:l032","ordinal":136302,"en":"He dedicated to his mother Kanykey."},{"id":"semetey-1-2013:p0775:b003:l033","ordinal":136303,"en":"His heart softened and was moved;"},{"id":"semetey-1-2013:p0775:b003:l034","ordinal":136304,"en":"With brave Bakai following,"},{"id":"semetey-1-2013:p0775:b003:l035","ordinal":136305,"en":"Your orphan rode out,"},{"id":"semetey-1-2013:p0775:b003:l036","ordinal":136306,"en":"Looking like a lion."},{"id":"semetey-1-2013:p0775:b003:l037","ordinal":136307,"en":"From valiant, wolf-maned Manas,"},{"id":"semetey-1-2013:p0775:b003:l038","ordinal":136308,"en":"Your dear lad left as a gift,"},{"id":"semetey-1-2013:p0775:b003:l039","ordinal":136309,"en":"Surging forth, breaking away,"},{"id":"semetey-1-2013:p0775:b004:l001","ordinal":136310,"en":"Your dear lad rode out,"},{"id":"semetey-1-2013:p0775:b004:l002","ordinal":136311,"en":"Looking like a towering mountain."},{"id":"semetey-1-2013:p0775:b004:l003","ordinal":136312,"en":"This damned orphan—"},{"id":"semetey-1-2013:p0775:b004:l004","ordinal":136313,"en":"Look at what he did:"},{"id":"semetey-1-2013:p0775:b004:l005","ordinal":136314,"en":"Slung upon him was Akkelte,"},{"id":"semetey-1-2013:p0775:b004:l006","ordinal":136315,"en":"Girded about him was Boz Kise."},{"id":"semetey-1-2013:p0775:b004:l007","ordinal":136316,"en":"The foal of champion Manas,"},{"id":"semetey-1-2013:p0775:b004:l008","ordinal":136317,"en":"What he wore upon his body"},{"id":"semetey-1-2013:p0775:b004:l009","ordinal":136318,"en":"Was Khan Manas's precious cloth robe."},{"id":"semetey-1-2013:p0775:b004:l010","ordinal":136319,"en":"Ringing as he rode,"},{"id":"semetey-1-2013:p0775:b004:l011","ordinal":136320,"en":"Zulpukor, left by Manas,"},{"id":"semetey-1-2013:p0775:b004:l012","ordinal":136321,"en":"As though it had found its master,"},{"id":"semetey-1-2013:p0775:b004:l013","ordinal":136322,"en":"Jangled at his left side."},{"id":"semetey-1-2013:p0775:b004:l014","ordinal":136323,"en":"In his uncle Bakai's hand,"},{"id":"semetey-1-2013:p0775:b004:l015","ordinal":136324,"en":"The banner fluttered."},{"id":"semetey-1-2013:p0775:b004:l016","ordinal":136325,"en":"The blood-drinker left by Manas,"},{"id":"semetey-1-2013:p0775:b004:l017","ordinal":136326,"en":"By the poor orphan child"},{"id":"semetey-1-2013:p0775:b004:l018","ordinal":136327,"en":"Received as a gift, Syrnayza,"},{"id":"semetey-1-2013:p0775:b004:l019","ordinal":136328,"en":"Flashed beside his thigh."},{"id":"semetey-1-2013:p0775:b004:l020","ordinal":136329,"en":"At the sight, the heart was moved;"},{"id":"semetey-1-2013:p0775:b004:l021","ordinal":136330,"en":"It seemed to change a thousand ways."},{"id":"semetey-1-2013:p0775:b004:l022","ordinal":136331,"en":"When he took his weapons,"},{"id":"semetey-1-2013:p0775:b004:l023","ordinal":136332,"en":"When he girded Boz Kise about his waist,"},{"id":"semetey-1-2013:p0775:b004:l024","ordinal":136333,"en":"His nine protectors"},{"id":"semetey-1-2013:p0775:b004:l025","ordinal":136334,"en":"Now gave him their support."},{"id":"semetey-1-2013:p0775:b004:l026","ordinal":136335,"en":"The forty saints, Khyzyr Iliyas,"},{"id":"semetey-1-2013:p0775:b004:l027","ordinal":136336,"en":"Had become his companions."},{"id":"semetey-1-2013:p0775:b004:l028","ordinal":136337,"en":"When dear Bakai looked,"},{"id":"semetey-1-2013:p0775:b004:l029","ordinal":136338,"en":"A black-spotted leopard"},{"id":"semetey-1-2013:p0775:b004:l030","ordinal":136339,"en":"Prowled at his side;"},{"id":"semetey-1-2013:p0775:b004:l031","ordinal":136340,"en":"A short-tailed, blue-maned lion"},{"id":"semetey-1-2013:p0775:b004:l032","ordinal":136341,"en":"Made ready beside him."},{"id":"semetey-1-2013:p0775:b004:l033","ordinal":136342,"en":"Seeing those who supported him,"},{"id":"semetey-1-2013:p0775:b004:l034","ordinal":136343,"en":"His uncle Bakai, the guardian patron,"},{"id":"semetey-1-2013:p0775:b004:l035","ordinal":136344,"en":"Prayed with all his soul:"},{"id":"semetey-1-2013:p0775:b004:l036","ordinal":136345,"en":"“My orphan, blessed with such good fortune,"},{"id":"semetey-1-2013:p0775:b004:l037","ordinal":136346,"en":"Has found all things in harmony."},{"id":"semetey-1-2013:p0775:b004:l038","ordinal":136347,"en":"If you look within him,"},{"id":"semetey-1-2013:p0775:b004:l039","ordinal":136348,"en":"He has grown wider than the face of the earth,"},{"id":"semetey-1-2013:p0776:b003:l001","ordinal":136349,"en":"Than wolf-maned Lord Manas,"},{"id":"semetey-1-2013:p0776:b003:l002","ordinal":136350,"en":"In what way is he less?"},{"id":"semetey-1-2013:p0776:b003:l003","ordinal":136351,"en":"From falcon Manas, the champion,"},{"id":"semetey-1-2013:p0776:b003:l004","ordinal":136352,"en":"Is this not my hawk?"},{"id":"semetey-1-2013:p0776:b003:l005","ordinal":136353,"en":"From goshawk Manas, the wolf-maned,"},{"id":"semetey-1-2013:p0776:b003:l006","ordinal":136354,"en":"Is this not my goshawk?"},{"id":"semetey-1-2013:p0776:b003:l007","ordinal":136355,"en":"His protectors have proved true;"},{"id":"semetey-1-2013:p0776:b003:l008","ordinal":136356,"en":"Every limb has grown in balance."},{"id":"semetey-1-2013:p0776:b003:l009","ordinal":136357,"en":"If my orphan lives unharmed,"},{"id":"semetey-1-2013:p0776:b003:l010","ordinal":136358,"en":"He has become a hero worth the world."},{"id":"semetey-1-2013:p0776:b003:l011","ordinal":136359,"en":"If old Bakai does not die,"},{"id":"semetey-1-2013:p0776:b003:l012","ordinal":136360,"en":"If he does not see Judgment Day,"},{"id":"semetey-1-2013:p0776:b003:l013","ordinal":136361,"en":"Beginning with Khakan and Beijing,"},{"id":"semetey-1-2013:p0776:b003:l014","ordinal":136362,"en":"I shall ride and scout the way."},{"id":"semetey-1-2013:p0776:b003:l015","ordinal":136363,"en":"From the seething unbelievers,"},{"id":"semetey-1-2013:p0776:b003:l016","ordinal":136364,"en":"If I reach them, I shall take revenge.”"},{"id":"semetey-1-2013:p0776:b003:l017","ordinal":136365,"en":"Seeing those who supported him,"},{"id":"semetey-1-2013:p0776:b003:l018","ordinal":136366,"en":"“He has become like my Manas,” he said."},{"id":"semetey-1-2013:p0776:b003:l019","ordinal":136367,"en":"Poor Bakai prayed,"},{"id":"semetey-1-2013:p0776:b003:l020","ordinal":136368,"en":"Quickly invoking Bahauddin,"},{"id":"semetey-1-2013:p0776:b003:l021","ordinal":136369,"en":"Calling on the one God, reciting from memory;"},{"id":"semetey-1-2013:p0776:b003:l022","ordinal":136370,"en":"Poor Bakai rode along."},{"id":"semetey-1-2013:p0776:b003:l023","ordinal":136371,"en":"Traveling on their return journey,"},{"id":"semetey-1-2013:p0776:b003:l024","ordinal":136372,"en":"The tale of these two."},{"id":"semetey-1-2013:p0776:b003:l025","ordinal":136373,"en":"Now let me tell you"},{"id":"semetey-1-2013:p0776:b003:l026","ordinal":136374,"en":"The tale of Abyke and Kobosh."},{"id":"semetey-1-2013:p0776:b003:l027","ordinal":136375,"en":"His reason returning, his senses gathered,"},{"id":"semetey-1-2013:p0776:b003:l028","ordinal":136376,"en":"Kobosh had stood up."},{"id":"semetey-1-2013:p0776:b003:l029","ordinal":136377,"en":"Akylay, Shoruk's daughter,"},{"id":"semetey-1-2013:p0776:b003:l030","ordinal":136378,"en":"The wretch who strutted in rustling finery,"},{"id":"semetey-1-2013:p0776:b003:l031","ordinal":136379,"en":"Who had forgotten Khan Manas,"},{"id":"semetey-1-2013:p0776:b003:l032","ordinal":136380,"en":"Now Kobosh's wife,"},{"id":"semetey-1-2013:p0776:b003:l033","ordinal":136381,"en":"That wretch grew furious."},{"id":"semetey-1-2013:p0776:b003:l034","ordinal":136382,"en":"The worthless wife did not mend her ways;"},{"id":"semetey-1-2013:p0776:b003:l035","ordinal":136383,"en":"She left no wickedness undone."},{"id":"semetey-1-2013:p0776:b003:l036","ordinal":136384,"en":"She knew not what strife she would raise;"},{"id":"semetey-1-2013:p0776:b003:l037","ordinal":136385,"en":"Screaming, weeping, roaring,"},{"id":"semetey-1-2013:p0776:b003:l038","ordinal":136386,"en":"She abused Kobosh bitterly,"},{"id":"semetey-1-2013:p0776:b003:l039","ordinal":136387,"en":"And wished for greater wickedness,"},{"id":"semetey-1-2013:p0776:b004:l001","ordinal":136388,"en":"She drove Kobosh on fiercely:"},{"id":"semetey-1-2013:p0776:b004:l002","ordinal":136389,"en":"“You villains, of a junior wife,"},{"id":"semetey-1-2013:p0776:b004:l003","ordinal":136390,"en":"You are indeed sons!"},{"id":"semetey-1-2013:p0776:b004:l004","ordinal":136391,"en":"And towered like a craggy peak;"},{"id":"semetey-1-2013:p0776:b004:l005","ordinal":136392,"en":"You are indeed sheep!"},{"id":"semetey-1-2013:p0776:b004:l006","ordinal":136393,"en":"Lying on your breast, short-shanked,"},{"id":"semetey-1-2013:p0776:b004:l007","ordinal":136394,"en":"You are indeed a dog."},{"id":"semetey-1-2013:p0776:b004:l008","ordinal":136395,"en":"I have reason to call you a dog;"},{"id":"semetey-1-2013:p0776:b004:l009","ordinal":136396,"en":"You have acted like dogs."},{"id":"semetey-1-2013:p0776:b004:l010","ordinal":136397,"en":"Is this not your doggishness?"},{"id":"semetey-1-2013:p0776:b004:l011","ordinal":136398,"en":"Settled in Talas, you failed to become mighty;"},{"id":"semetey-1-2013:p0776:b004:l012","ordinal":136399,"en":"My treasury left by the warrior—"},{"id":"semetey-1-2013:p0776:b004:l013","ordinal":136400,"en":"You wretches failed to be its masters."},{"id":"semetey-1-2013:p0776:b004:l014","ordinal":136401,"en":"My precious wealth and possessions"},{"id":"semetey-1-2013:p0776:b004:l015","ordinal":136402,"en":"You let it be struck from the flank,"},{"id":"semetey-1-2013:p0776:b004:l016","ordinal":136403,"en":"My costly wealth"},{"id":"semetey-1-2013:p0776:b004:l017","ordinal":136404,"en":"You let a single orphan take."},{"id":"semetey-1-2013:p0776:b004:l018","ordinal":136405,"en":"The bright red crimson fabric,"},{"id":"semetey-1-2013:p0776:b004:l019","ordinal":136406,"en":"Trail diagonally along the road."},{"id":"semetey-1-2013:p0776:b004:l020","ordinal":136407,"en":"My precious possessions"},{"id":"semetey-1-2013:p0776:b004:l021","ordinal":136408,"en":"You let be taken, no match for him."},{"id":"semetey-1-2013:p0776:b004:l022","ordinal":136409,"en":"Gazing intently day and night,"},{"id":"semetey-1-2013:p0776:b004:l023","ordinal":136410,"en":"Puffed up, you slept your fill."},{"id":"semetey-1-2013:p0776:b004:l024","ordinal":136411,"en":"The possessions left by Manas"},{"id":"semetey-1-2013:p0776:b004:l025","ordinal":136412,"en":"You let a single orphan take."},{"id":"semetey-1-2013:p0776:b004:l026","ordinal":136413,"en":"You hulking dog who fancied himself a lord,"},{"id":"semetey-1-2013:p0776:b004:l027","ordinal":136414,"en":"You let him trample over your heads together."},{"id":"semetey-1-2013:p0776:b004:l028","ordinal":136415,"en":"The possessions left by the lord"},{"id":"semetey-1-2013:p0776:b004:l029","ordinal":136416,"en":"You let a wandering slave scatter."},{"id":"semetey-1-2013:p0776:b004:l030","ordinal":136417,"en":"My treasury, withheld when asked for,"},{"id":"semetey-1-2013:p0776:b004:l031","ordinal":136418,"en":"You let him seize by force."},{"id":"semetey-1-2013:p0776:b004:l032","ordinal":136419,"en":"The possessions left by the sultan"},{"id":"semetey-1-2013:p0776:b004:l033","ordinal":136420,"en":"You let a wandering slave take."},{"id":"semetey-1-2013:p0776:b004:l034","ordinal":136421,"en":"Your honesty became clear today."},{"id":"semetey-1-2013:p0776:b004:l035","ordinal":136422,"en":"Into my pure treasury of wealth"},{"id":"semetey-1-2013:p0776:b004:l036","ordinal":136423,"en":"You let an orphan slave enter."},{"id":"semetey-1-2013:p0776:b004:l037","ordinal":136424,"en":"My treasury of precious gold coins"},{"id":"semetey-1-2013:p0776:b004:l038","ordinal":136425,"en":"You let Semetey plunder."},{"id":"semetey-1-2013:p0776:b004:l039","ordinal":136426,"en":"Fighting, your strength could not prevail,"},{"id":"semetey-1-2013:p0777:b003:l001","ordinal":136427,"en":"You hulking dog, your strength exhausted,"},{"id":"semetey-1-2013:p0777:b003:l002","ordinal":136428,"en":"You let Bakai Khan restrain you."},{"id":"semetey-1-2013:p0777:b003:l003","ordinal":136429,"en":"By Manas's fugitive son"},{"id":"semetey-1-2013:p0777:b003:l004","ordinal":136430,"en":"You let poor me be beaten."},{"id":"semetey-1-2013:p0777:b003:l005","ordinal":136431,"en":"Your father's grave, you hulking dog!"},{"id":"semetey-1-2013:p0777:b003:l006","ordinal":136432,"en":"If I gather sand, it is not stone."},{"id":"semetey-1-2013:p0777:b003:l007","ordinal":136433,"en":"Yesterday, drinking spirits and panting,"},{"id":"semetey-1-2013:p0777:b003:l008","ordinal":136434,"en":"As you raged together,"},{"id":"semetey-1-2013:p0777:b003:l009","ordinal":136435,"en":"You used to slice and eat the rump meat;"},{"id":"semetey-1-2013:p0777:b003:l010","ordinal":136436,"en":"All six villains, gathered together,"},{"id":"semetey-1-2013:p0777:b003:l011","ordinal":136437,"en":"You said you would crush the general."},{"id":"semetey-1-2013:p0777:b003:l012","ordinal":136438,"en":"Instead of a general, you hulking dog,"},{"id":"semetey-1-2013:p0777:b003:l013","ordinal":136439,"en":"You have become a grass-grazing camel."},{"id":"semetey-1-2013:p0777:b003:l014","ordinal":136440,"en":"Over the orphan son of Manas,"},{"id":"semetey-1-2013:p0777:b003:l015","ordinal":136441,"en":"When did you six villains gain mastery?"},{"id":"semetey-1-2013:p0777:b003:l016","ordinal":136442,"en":"Abyke, a khan among the six, wept;"},{"id":"semetey-1-2013:p0777:b003:l017","ordinal":136443,"en":"If he lives, just wait:"},{"id":"semetey-1-2013:p0777:b003:l018","ordinal":136444,"en":"Semetey will bring about your ruin!"},{"id":"semetey-1-2013:p0777:b003:l019","ordinal":136445,"en":"To his mother, that quarrelsome wife,"},{"id":"semetey-1-2013:p0777:b003:l020","ordinal":136446,"en":"You six witless villains"},{"id":"semetey-1-2013:p0777:b003:l021","ordinal":136447,"en":"Brought humiliation, to a wretch like her."},{"id":"semetey-1-2013:p0777:b003:l023","ordinal":136448,"en":"Offer your own head as a gift"}]
