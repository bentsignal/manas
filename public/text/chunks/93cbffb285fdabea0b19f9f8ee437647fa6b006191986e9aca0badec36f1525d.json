[{"id":"semetey-2-2013:p1343:b004:l006","ordinal":290049,"en":"They struck whoever came near"},{"id":"semetey-2-2013:p1343:b004:l007","ordinal":290050,"en":"Right beneath the armpit."},{"id":"semetey-2-2013:p1343:b004:l008","ordinal":290051,"en":"The massed black Jediger"},{"id":"semetey-2-2013:p1343:b004:l009","ordinal":290052,"en":"Tried courageously to storm the gate,"},{"id":"semetey-2-2013:p1343:b004:l010","ordinal":290053,"en":"Yet stood afraid to advance and fire"},{"id":"semetey-2-2013:p1343:b004:l011","ordinal":290054,"en":"Against the wrestlers and heroes."},{"id":"semetey-2-2013:p1343:b004:l012","ordinal":290055,"en":"The gate was strong, guarded by lions;"},{"id":"semetey-2-2013:p1343:b004:l013","ordinal":290056,"en":"Unable to overrun the gate,"},{"id":"semetey-2-2013:p1343:b004:l014","ordinal":290057,"en":"Those Jediger were dumbfounded."},{"id":"semetey-2-2013:p1343:b004:l015","ordinal":290058,"en":"The watchmen and guards grew fierce;"},{"id":"semetey-2-2013:p1343:b004:l016","ordinal":290059,"en":"Unable to flood into the stronghold,"},{"id":"semetey-2-2013:p1343:b004:l017","ordinal":290060,"en":"The massed black Jediger"},{"id":"semetey-2-2013:p1343:b004:l018","ordinal":290061,"en":"Took on the look of men about to flee."},{"id":"semetey-2-2013:p1343:b004:l019","ordinal":290062,"en":"Their warriors were speared from the gate,"},{"id":"semetey-2-2013:p1343:b004:l020","ordinal":290063,"en":"Taken suddenly by surprise;"},{"id":"semetey-2-2013:p1343:b004:l021","ordinal":290064,"en":"The Jediger went about grieving,"},{"id":"semetey-2-2013:p1343:b004:l022","ordinal":290065,"en":"Saying, “Our dear man has died;"},{"id":"semetey-2-2013:p1343:b004:l023","ordinal":290066,"en":"The dear hero has seen"},{"id":"semetey-2-2013:p1343:b004:l024","ordinal":290067,"en":"The true place from which none returns.”"},{"id":"semetey-2-2013:p1343:b004:l025","ordinal":290068,"en":"The people broke into separate bands;"},{"id":"semetey-2-2013:p1343:b004:l026","ordinal":290069,"en":"The massed black Jediger"},{"id":"semetey-2-2013:p1343:b004:l027","ordinal":290070,"en":"Were gathering themselves together,"},{"id":"semetey-2-2013:p1343:b004:l028","ordinal":290071,"en":"Lamenting, “Our dear kinsman"},{"id":"semetey-2-2013:p1343:b004:l029","ordinal":290072,"en":"Died in such-and-such a place.”"},{"id":"semetey-2-2013:p1343:b004:l030","ordinal":290073,"en":"This was when they raised their lament."},{"id":"semetey-2-2013:p1343:b004:l031","ordinal":290074,"en":"Brave Kyyaz of the Jediger,"},{"id":"semetey-2-2013:p1343:b004:l032","ordinal":290075,"en":"To send his people surging forward,"},{"id":"semetey-2-2013:p1343:b004:l033","ordinal":290076,"en":"Struck the great war drum."},{"id":"semetey-2-2013:p1343:b004:l034","ordinal":290077,"en":"The host, poised to flee, halted;"},{"id":"semetey-2-2013:p1343:b004:l035","ordinal":290078,"en":"The people stood divided."},{"id":"semetey-2-2013:p1343:b004:l036","ordinal":290079,"en":"Those who had turned to retreat"},{"id":"semetey-2-2013:p1343:b004:l037","ordinal":290080,"en":"Now came streaming out again;"},{"id":"semetey-2-2013:p1343:b004:l038","ordinal":290081,"en":"Every last one thundered forth—"},{"id":"semetey-2-2013:p1343:b004:l039","ordinal":290082,"en":"The accursed-looking Jediger."},{"id":"semetey-2-2013:p1344:b003:l001","ordinal":290083,"en":"“Go forward, every last one of you,"},{"id":"semetey-2-2013:p1344:b003:l002","ordinal":290084,"en":"Young and old alike!"},{"id":"semetey-2-2013:p1344:b003:l003","ordinal":290085,"en":"Fire muskets and draw bows;"},{"id":"semetey-2-2013:p1344:b003:l004","ordinal":290086,"en":"All you black Jediger,"},{"id":"semetey-2-2013:p1344:b003:l005","ordinal":290087,"en":"Attack together as one!"},{"id":"semetey-2-2013:p1344:b003:l006","ordinal":290088,"en":"Overwhelm and plunder"},{"id":"semetey-2-2013:p1344:b003:l007","ordinal":290089,"en":"The helpless women and young children."},{"id":"semetey-2-2013:p1344:b003:l008","ordinal":290090,"en":"Break the stronghold, take the spoils,"},{"id":"semetey-2-2013:p1344:b003:l009","ordinal":290091,"en":"Seize the swaying beauties—"},{"id":"semetey-2-2013:p1344:b003:l010","ordinal":290092,"en":"Fight the battle in this way!"},{"id":"semetey-2-2013:p1344:b003:l011","ordinal":290093,"en":"You massed black Jediger,"},{"id":"semetey-2-2013:p1344:b003:l012","ordinal":290094,"en":"From ancient times until now"},{"id":"semetey-2-2013:p1344:b003:l013","ordinal":290095,"en":"You have lived by conquest;"},{"id":"semetey-2-2013:p1344:b003:l014","ordinal":290096,"en":"Why do you retreat like this"},{"id":"semetey-2-2013:p1344:b003:l015","ordinal":290097,"en":"From gatekeepers and women?"},{"id":"semetey-2-2013:p1344:b003:l016","ordinal":290098,"en":"What will you do if the lost gray wolf is found"},{"id":"semetey-2-2013:p1344:b003:l017","ordinal":290099,"en":"And Semetey returns?"},{"id":"semetey-2-2013:p1344:b003:l018","ordinal":290100,"en":"Jediger, divide among yourselves"},{"id":"semetey-2-2013:p1344:b003:l019","ordinal":290101,"en":"The property left to the women!"},{"id":"semetey-2-2013:p1344:b003:l020","ordinal":290102,"en":"Rather than flee the gatekeepers,"},{"id":"semetey-2-2013:p1344:b003:l021","ordinal":290103,"en":"Rather than lie here facing death,"},{"id":"semetey-2-2013:p1344:b003:l022","ordinal":290104,"en":"You should die, Jediger!"},{"id":"semetey-2-2013:p1344:b003:l023","ordinal":290105,"en":"Rather than the courageous Kanchoro"},{"id":"semetey-2-2013:p1344:b003:l024","ordinal":290106,"en":"Flying into a rage"},{"id":"semetey-2-2013:p1344:b003:l025","ordinal":290107,"en":"And starting this calamity outright,"},{"id":"semetey-2-2013:p1344:b003:l026","ordinal":290108,"en":"Charging with a battle cry"},{"id":"semetey-2-2013:p1344:b003:l027","ordinal":290109,"en":"And having the Jediger slaughtered."},{"id":"semetey-2-2013:p1344:b003:l028","ordinal":290110,"en":"Rather than return without breaking the gate,"},{"id":"semetey-2-2013:p1344:b003:l029","ordinal":290111,"en":"Rather than stand frightened of women—"},{"id":"semetey-2-2013:p1344:b003:l030","ordinal":290112,"en":"Jediger, lower than women—"},{"id":"semetey-2-2013:p1344:b003:l031","ordinal":290113,"en":"Rather than flee the gatekeepers,"},{"id":"semetey-2-2013:p1344:b003:l032","ordinal":290114,"en":"May Kyyaz your leader die;"},{"id":"semetey-2-2013:p1344:b003:l033","ordinal":290115,"en":"You massed black Jediger,"},{"id":"semetey-2-2013:p1344:b003:l034","ordinal":290116,"en":"You snarling curs, may all of you die!"},{"id":"semetey-2-2013:p1344:b003:l035","ordinal":290117,"en":"You witless black Jediger,"},{"id":"semetey-2-2013:p1344:b003:l036","ordinal":290118,"en":"Could a hero be like you?"},{"id":"semetey-2-2013:p1344:b003:l037","ordinal":290119,"en":"All of you are a wretched, cowardly people;"},{"id":"semetey-2-2013:p1344:b003:l038","ordinal":290120,"en":"Is it any wonder you are called cowards?"},{"id":"semetey-2-2013:p1344:b003:l039","ordinal":290121,"en":"Had I not been here, Jediger,"},{"id":"semetey-2-2013:p1344:b004:l001","ordinal":290122,"en":"Külchoro would have entered alone"},{"id":"semetey-2-2013:p1344:b004:l002","ordinal":290123,"en":"And destroyed your people"},{"id":"semetey-2-2013:p1344:b004:l003","ordinal":290124,"en":"In your free land of Jeti-Özön;"},{"id":"semetey-2-2013:p1344:b004:l004","ordinal":290125,"en":"He would have cooled your ardor,"},{"id":"semetey-2-2013:p1344:b004:l005","ordinal":290126,"en":"Broken your backs,"},{"id":"semetey-2-2013:p1344:b004:l006","ordinal":290127,"en":"And hacked your lion,"},{"id":"semetey-2-2013:p1344:b004:l007","ordinal":290128,"en":"Kyyaz your khan, to pieces.”"},{"id":"semetey-2-2013:p1344:b004:l008","ordinal":290129,"en":"He began his wrathful tirade;"},{"id":"semetey-2-2013:p1344:b004:l009","ordinal":290130,"en":"With piercing cries and rallying shouts,"},{"id":"semetey-2-2013:p1344:b004:l010","ordinal":290131,"en":"Raising a furious clamor,"},{"id":"semetey-2-2013:p1344:b004:l011","ordinal":290132,"en":"He sent the massed black Jediger"},{"id":"semetey-2-2013:p1344:b004:l012","ordinal":290133,"en":"Charging to their slaughter."},{"id":"semetey-2-2013:p1344:b004:l013","ordinal":290134,"en":"Again and again he spoke;"},{"id":"semetey-2-2013:p1344:b004:l014","ordinal":290135,"en":"The treacherous kinsman Kanchoro—"},{"id":"semetey-2-2013:p1344:b004:l015","ordinal":290136,"en":"May he never prosper or multiply,"},{"id":"semetey-2-2013:p1344:b004:l016","ordinal":290137,"en":"May he never thrive—"},{"id":"semetey-2-2013:p1344:b004:l017","ordinal":290138,"en":"Roused the Jediger."},{"id":"semetey-2-2013:p1344:b004:l018","ordinal":290139,"en":"Every last man thundered;"},{"id":"semetey-2-2013:p1344:b004:l019","ordinal":290140,"en":"The entire Jediger host"},{"id":"semetey-2-2013:p1344:b004:l020","ordinal":290141,"en":"Launched its roaring assault."},{"id":"semetey-2-2013:p1344:b004:l021","ordinal":290142,"en":"Kanchoro drove in"},{"id":"semetey-2-2013:p1344:b004:l022","ordinal":290143,"en":"The skillful spearmen,"},{"id":"semetey-2-2013:p1344:b004:l023","ordinal":290144,"en":"The strongest of the Jediger,"},{"id":"semetey-2-2013:p1344:b004:l024","ordinal":290145,"en":"And hemmed in the palace."},{"id":"semetey-2-2013:p1344:b004:l025","ordinal":290146,"en":"They wrought havoc at the palace;"},{"id":"semetey-2-2013:p1344:b004:l026","ordinal":290147,"en":"The eye could not follow them,"},{"id":"semetey-2-2013:p1344:b004:l027","ordinal":290148,"en":"Nor tell which man was which,"},{"id":"semetey-2-2013:p1344:b004:l028","ordinal":290149,"en":"Like tumbleweed flying in the wind."},{"id":"semetey-2-2013:p1344:b004:l029","ordinal":290150,"en":"May God spare us the sight—"},{"id":"semetey-2-2013:p1344:b004:l030","ordinal":290151,"en":"They stood surrounding the gate."},{"id":"semetey-2-2013:p1344:b004:l031","ordinal":290152,"en":"The executioners barring the gate"},{"id":"semetey-2-2013:p1344:b004:l032","ordinal":290153,"en":"Fought without rest for seven days;"},{"id":"semetey-2-2013:p1344:b004:l033","ordinal":290154,"en":"Who had ever seen such a struggle?"},{"id":"semetey-2-2013:p1344:b004:l034","ordinal":290155,"en":"Talas rose like a mountain before their departure;"},{"id":"semetey-2-2013:p1344:b004:l035","ordinal":290156,"en":"Her own son born from her body—"},{"id":"semetey-2-2013:p1344:b004:l036","ordinal":290157,"en":"To tell it fully is a great calamity—"},{"id":"semetey-2-2013:p1344:b004:l037","ordinal":290158,"en":"Kanchoro had become an infidel foe."},{"id":"semetey-2-2013:p1344:b004:l038","ordinal":290159,"en":"A destroyer had arisen within,"},{"id":"semetey-2-2013:p1344:b004:l039","ordinal":290160,"en":"A man who brought ruin upon the people."},{"id":"semetey-2-2013:p1345:b003:l001","ordinal":290161,"en":"They fired bullets into the palace city,"},{"id":"semetey-2-2013:p1345:b003:l002","ordinal":290162,"en":"Becoming enemies of the bloodthirsty khan."},{"id":"semetey-2-2013:p1345:b003:l003","ordinal":290163,"en":"This infidel Kanchoro"},{"id":"semetey-2-2013:p1345:b003:l004","ordinal":290164,"en":"Was the foster son of that bloodthirsty lord;"},{"id":"semetey-2-2013:p1345:b003:l005","ordinal":290165,"en":"They had kicked together like colt and yearling,"},{"id":"semetey-2-2013:p1345:b003:l006","ordinal":290166,"en":"And quarreled as they sucked the same breast."},{"id":"semetey-2-2013:p1345:b003:l007","ordinal":290167,"en":"Behold that kinship!"},{"id":"semetey-2-2013:p1345:b003:l008","ordinal":290168,"en":"Behold the treachery of the choro"},{"id":"semetey-2-2013:p1345:b003:l009","ordinal":290169,"en":"Who turned against his kinsman like an enemy"},{"id":"semetey-2-2013:p1345:b003:l010","ordinal":290170,"en":"And died corrupted!"},{"id":"semetey-2-2013:p1345:b003:l011","ordinal":290171,"en":"From the top of the tower,"},{"id":"semetey-2-2013:p1345:b003:l012","ordinal":290172,"en":"Poor Aychürök, the woman,"},{"id":"semetey-2-2013:p1345:b003:l013","ordinal":290173,"en":"Her proud dark head bowed,"},{"id":"semetey-2-2013:p1345:b003:l014","ordinal":290174,"en":"Her bloodied face torn open,"},{"id":"semetey-2-2013:p1345:b003:l015","ordinal":290175,"en":"Burning and blazing into embers,"},{"id":"semetey-2-2013:p1345:b003:l016","ordinal":290176,"en":"Turned by grief into fire,"},{"id":"semetey-2-2013:p1345:b003:l017","ordinal":290177,"en":"Her knees bending to the ground,"},{"id":"semetey-2-2013:p1345:b003:l018","ordinal":290178,"en":"Shrieking, weeping, and screaming,"},{"id":"semetey-2-2013:p1345:b003:l019","ordinal":290179,"en":"Burst in upon true Kanykey,"},{"id":"semetey-2-2013:p1345:b003:l020","ordinal":290180,"en":"Wailing and sobbing."},{"id":"semetey-2-2013:p1345:b003:l021","ordinal":290181,"en":"When she saw Aychürök’s condition,"},{"id":"semetey-2-2013:p1345:b003:l022","ordinal":290182,"en":"Her grandmother Chyyyrdy,"},{"id":"semetey-2-2013:p1345:b003:l023","ordinal":290183,"en":"That elder wife, understood"},{"id":"semetey-2-2013:p1345:b003:l024","ordinal":290184,"en":"That her one cherished man had died."},{"id":"semetey-2-2013:p1345:b003:l025","ordinal":290185,"en":"Thinking, “How can I live bereft of my only one?"},{"id":"semetey-2-2013:p1345:b003:l026","ordinal":290186,"en":"I will drive a knife into myself,”"},{"id":"semetey-2-2013:p1345:b003:l027","ordinal":290187,"en":"Within a white saddlebag,"},{"id":"semetey-2-2013:p1345:b003:l028","ordinal":290188,"en":"Bought for six thousand camels and a thousand colts,"},{"id":"semetey-2-2013:p1345:b003:l029","ordinal":290189,"en":"Was the white blade she had purchased."},{"id":"semetey-2-2013:p1345:b003:l030","ordinal":290190,"en":"She seized its handle"},{"id":"semetey-2-2013:p1345:b003:l031","ordinal":290191,"en":"And drew it from its sheath."},{"id":"semetey-2-2013:p1345:b003:l032","ordinal":290192,"en":"“It is the pennon fixed to the spear,"},{"id":"semetey-2-2013:p1345:b003:l033","ordinal":290193,"en":"A special keepsake left"},{"id":"semetey-2-2013:p1345:b003:l034","ordinal":290194,"en":"By magnanimous Manas, the radiant one,” she said."},{"id":"semetey-2-2013:p1345:b003:l035","ordinal":290195,"en":"She shrieked, wept, and grieved,"},{"id":"semetey-2-2013:p1345:b003:l036","ordinal":290196,"en":"Bereft of two sons in succession."},{"id":"semetey-2-2013:p1345:b003:l037","ordinal":290197,"en":"“How can I remain now?"},{"id":"semetey-2-2013:p1345:b003:l038","ordinal":290198,"en":"Though God may refuse to take me,"},{"id":"semetey-2-2013:p1345:b003:l039","ordinal":290199,"en":"I will go in this way today.”"},{"id":"semetey-2-2013:p1345:b005:l001","ordinal":290200,"en":"The fine blade, solid steel with a golden hilt,"},{"id":"semetey-2-2013:p1345:b005:l002","ordinal":290201,"en":"Was steel through and through;"},{"id":"semetey-2-2013:p1345:b005:l003","ordinal":290202,"en":"She grasped and turned it in her hand,"},{"id":"semetey-2-2013:p1345:b005:l004","ordinal":290203,"en":"Then plunged the white blade"},{"id":"semetey-2-2013:p1345:b005:l005","ordinal":290204,"en":"Into the thick flesh of her living heart."},{"id":"semetey-2-2013:p1345:b005:l006","ordinal":290205,"en":"Chyyyrdy herself"},{"id":"semetey-2-2013:p1345:b005:l007","ordinal":290206,"en":"Cut herself open."},{"id":"semetey-2-2013:p1345:b005:l008","ordinal":290207,"en":"Poor Aychürök, the woman,"},{"id":"semetey-2-2013:p1345:b005:l009","ordinal":290208,"en":"Saw with her own eyes"},{"id":"semetey-2-2013:p1345:b005:l010","ordinal":290209,"en":"That her grandmother had died."},{"id":"semetey-2-2013:p1345:b005:l011","ordinal":290210,"en":"Her mind was pierced and split apart;"},{"id":"semetey-2-2013:p1345:b005:l012","ordinal":290211,"en":"Twelve afflictions and a thousand cares"},{"id":"semetey-2-2013:p1345:b005:l013","ordinal":290212,"en":"Appeared above her head."},{"id":"semetey-2-2013:p1345:b005:l014","ordinal":290213,"en":"Fire that burns through the grass is terrible;"},{"id":"semetey-2-2013:p1345:b005:l015","ordinal":290214,"en":"Worse is Kanchoro sprung from one’s own people,"},{"id":"semetey-2-2013:p1345:b005:l016","ordinal":290215,"en":"An enemy gone rabid."},{"id":"semetey-2-2013:p1345:b005:l017","ordinal":290216,"en":"When the cruel enemy surged in"},{"id":"semetey-2-2013:p1345:b005:l018","ordinal":290217,"en":"And plundered all beneath them,"},{"id":"semetey-2-2013:p1345:b005:l019","ordinal":290218,"en":"When orphan, widow, and aged soul"},{"id":"semetey-2-2013:p1345:b005:l020","ordinal":290219,"en":"Were thrown into a dug pit,"},{"id":"semetey-2-2013:p1345:b005:l021","ordinal":290220,"en":"“The dogs will take her if we plead;"},{"id":"semetey-2-2013:p1345:b005:l022","ordinal":290221,"en":"Before the five bright stars,"},{"id":"semetey-2-2013:p1345:b005:l023","ordinal":290222,"en":"Golden rubies in the radiant firmament, have set—"},{"id":"semetey-2-2013:p1345:b005:l024","ordinal":290223,"en":"My mother who suckled me on five separate journeys,"},{"id":"semetey-2-2013:p1345:b005:l025","ordinal":290224,"en":"Who widened her narrow womb,"},{"id":"semetey-2-2013:p1345:b005:l026","ordinal":290225,"en":"Who emptied her stone-hard breasts,"},{"id":"semetey-2-2013:p1345:b005:l027","ordinal":290226,"en":"And raised us to maturity—"},{"id":"semetey-2-2013:p1345:b005:l028","ordinal":290227,"en":"When they plunder us,"},{"id":"semetey-2-2013:p1345:b005:l029","ordinal":290228,"en":"My dearest mother,"},{"id":"semetey-2-2013:p1345:b005:l030","ordinal":290229,"en":"If she suddenly disappears,"},{"id":"semetey-2-2013:p1345:b005:l031","ordinal":290230,"en":"If by chance she lies unburied,"},{"id":"semetey-2-2013:p1345:b005:l032","ordinal":290231,"en":"If Kanchoro sees her,"},{"id":"semetey-2-2013:p1345:b005:l033","ordinal":290232,"en":"Shameless before breast milk and salt,"},{"id":"semetey-2-2013:p1345:b005:l034","ordinal":290233,"en":"Will he acknowledge my mother?"},{"id":"semetey-2-2013:p1345:b005:l035","ordinal":290234,"en":"Will he call her kin to the leopard,"},{"id":"semetey-2-2013:p1345:b005:l036","ordinal":290235,"en":"Or an old raving infidel"},{"id":"semetey-2-2013:p1345:b005:l037","ordinal":290236,"en":"Who has lived too long,"},{"id":"semetey-2-2013:p1345:b005:l038","ordinal":290237,"en":"Drag her along the road,"},{"id":"semetey-2-2013:p1345:b005:l039","ordinal":290238,"en":"And hand her to the Dangyt?"},{"id":"semetey-2-2013:p1346:b003:l001","ordinal":290239,"en":"As though taking vengeance on a corpse,"},{"id":"semetey-2-2013:p1346:b003:l002","ordinal":290240,"en":"Will he subject her to this humiliation?"},{"id":"semetey-2-2013:p1346:b003:l003","ordinal":290241,"en":"Will God strike down the choro"},{"id":"semetey-2-2013:p1346:b003:l004","ordinal":290242,"en":"Whose conduct is strange and whose salt is accursed?”"},{"id":"semetey-2-2013:p1346:b003:l005","ordinal":290243,"en":"So spoke Aychürök."},{"id":"semetey-2-2013:p1346:b003:l006","ordinal":290244,"en":"Some people say"},{"id":"semetey-2-2013:p1346:b003:l007","ordinal":290245,"en":"That renowned Chürök"},{"id":"semetey-2-2013:p1346:b003:l008","ordinal":290246,"en":"Was a daughter of the peri."},{"id":"semetey-2-2013:p1346:b003:l009","ordinal":290247,"en":"Wise in counsel, honored as night,"},{"id":"semetey-2-2013:p1346:b003:l010","ordinal":290248,"en":"My wondrous sister-in-law—"},{"id":"semetey-2-2013:p1346:b003:l011","ordinal":290249,"en":"After Kanchoro heaped disgrace on her,"},{"id":"semetey-2-2013:p1346:b003:l012","ordinal":290250,"en":"After the massed black Jediger"},{"id":"semetey-2-2013:p1346:b003:l013","ordinal":290251,"en":"Surrounded the palace,"},{"id":"semetey-2-2013:p1346:b003:l014","ordinal":290252,"en":"Poor Chürök pondered"},{"id":"semetey-2-2013:p1346:b003:l015","ordinal":290253,"en":"Her many grievous cares:"},{"id":"semetey-2-2013:p1346:b003:l016","ordinal":290254,"en":"“If the lion born as son"},{"id":"semetey-2-2013:p1346:b003:l017","ordinal":290255,"en":"Of my mother’s golden womb,"},{"id":"semetey-2-2013:p1346:b003:l018","ordinal":290256,"en":"My ship that sailed the river,"},{"id":"semetey-2-2013:p1346:b003:l019","ordinal":290257,"en":"Should suddenly vanish from sight"},{"id":"semetey-2-2013:p1346:b003:l020","ordinal":290258,"en":"And by chance lie unburied,"},{"id":"semetey-2-2013:p1346:b003:l021","ordinal":290259,"en":"Ravens will croak and peck out"},{"id":"semetey-2-2013:p1346:b003:l022","ordinal":290260,"en":"Those two eyes unlike any human eyes;"},{"id":"semetey-2-2013:p1346:b003:l023","ordinal":290261,"en":"Crows will foul"},{"id":"semetey-2-2013:p1346:b003:l024","ordinal":290262,"en":"His created golden head;"},{"id":"semetey-2-2013:p1346:b003:l025","ordinal":290263,"en":"My mother will thereby"},{"id":"semetey-2-2013:p1346:b003:l026","ordinal":290264,"en":"Become dung for beasts.”"},{"id":"semetey-2-2013:p1346:b003:l027","ordinal":290265,"en":"Without letting anyone know,"},{"id":"semetey-2-2013:p1346:b003:l028","ordinal":290266,"en":"Without allowing a single person near,"},{"id":"semetey-2-2013:p1346:b003:l029","ordinal":290267,"en":"The learned woman Aychürök,"},{"id":"semetey-2-2013:p1346:b003:l030","ordinal":290268,"en":"Agile beyond measure,"},{"id":"semetey-2-2013:p1346:b003:l031","ordinal":290269,"en":"Hollowed out the edge of the hearth"},{"id":"semetey-2-2013:p1346:b003:l032","ordinal":290270,"en":"Of the clamorous infidel."},{"id":"semetey-2-2013:p1346:b003:l033","ordinal":290271,"en":"She folded her mother Chyyyrdy at the waist,"},{"id":"semetey-2-2013:p1346:b003:l034","ordinal":290272,"en":"Placed her within a burial wrapping,"},{"id":"semetey-2-2013:p1346:b003:l035","ordinal":290273,"en":"And laid her there."},{"id":"semetey-2-2013:p1346:b003:l036","ordinal":290274,"en":"Her mother Chyyyrdy was dead;"},{"id":"semetey-2-2013:p1346:b003:l037","ordinal":290275,"en":"Aychürök, the moonlike woman,"},{"id":"semetey-2-2013:p1346:b003:l038","ordinal":290276,"en":"Buried her with her own hands."},{"id":"semetey-2-2013:p1346:b003:l039","ordinal":290277,"en":"Then Aychürök,"},{"id":"semetey-2-2013:p1346:b004:l001","ordinal":290278,"en":"Grieving in mourning,"},{"id":"semetey-2-2013:p1346:b004:l002","ordinal":290279,"en":"Ran to Kanykey;"},{"id":"semetey-2-2013:p1346:b004:l003","ordinal":290280,"en":"Speaking softly but firmly,"},{"id":"semetey-2-2013:p1346:b004:l004","ordinal":290281,"en":"She began addressing mother Kanykey:"},{"id":"semetey-2-2013:p1346:b004:l005","ordinal":290282,"en":"“Ah, beauty among the dark-haired,"},{"id":"semetey-2-2013:p1346:b004:l006","ordinal":290283,"en":"Foremost among women,"},{"id":"semetey-2-2013:p1346:b004:l007","ordinal":290284,"en":"Purest in the flowing gown,"},{"id":"semetey-2-2013:p1346:b004:l008","ordinal":290285,"en":"Most fitting of the long-haired,"},{"id":"semetey-2-2013:p1346:b004:l009","ordinal":290286,"en":"Strongest among all womankind!"},{"id":"semetey-2-2013:p1346:b004:l010","ordinal":290287,"en":"My mother who knows the worth"},{"id":"semetey-2-2013:p1346:b004:l011","ordinal":290288,"en":"Of suffering and death,"},{"id":"semetey-2-2013:p1346:b004:l012","ordinal":290289,"en":"Of paradise and hell,"},{"id":"semetey-2-2013:p1346:b004:l013","ordinal":290290,"en":"Of plenty and want,"},{"id":"semetey-2-2013:p1346:b004:l014","ordinal":290291,"en":"Of hunger and fullness—"},{"id":"semetey-2-2013:p1346:b004:l015","ordinal":290292,"en":"My precious blessing!"},{"id":"semetey-2-2013:p1346:b004:l016","ordinal":290293,"en":"You joined what was severed,"},{"id":"semetey-2-2013:p1346:b004:l017","ordinal":290294,"en":"Gathered what was scattered,"},{"id":"semetey-2-2013:p1346:b004:l018","ordinal":290295,"en":"Kindled the extinguished fire,"},{"id":"semetey-2-2013:p1346:b004:l019","ordinal":290296,"en":"And brought dead souls back to life;"},{"id":"semetey-2-2013:p1346:b004:l020","ordinal":290297,"en":"You raised bowed heads as banners"},{"id":"semetey-2-2013:p1346:b004:l021","ordinal":290298,"en":"And made heroes of heads in mourning."},{"id":"semetey-2-2013:p1346:b004:l022","ordinal":290299,"en":"My mother who has known the weight"},{"id":"semetey-2-2013:p1346:b004:l023","ordinal":290300,"en":"Of bitter suffering and affliction,"},{"id":"semetey-2-2013:p1346:b004:l024","ordinal":290301,"en":"Who has seen the ways"},{"id":"semetey-2-2013:p1346:b004:l025","ordinal":290302,"en":"Of men who are both kin and foe—"},{"id":"semetey-2-2013:p1346:b004:l026","ordinal":290303,"en":"Your spring flowing from the valley,"},{"id":"semetey-2-2013:p1346:b004:l027","ordinal":290304,"en":"Your brave son whom you bore near death,"}]
