[{"id":"semetey-1-2013:p0840:b004:l019","ordinal":140545,"en":"Your falcon who has died—"},{"id":"semetey-1-2013:p0840:b004:l020","ordinal":140546,"en":"When Muslims insulted him,"},{"id":"semetey-1-2013:p0840:b004:l021","ordinal":140547,"en":"He would not rise in anger or heed it."},{"id":"semetey-1-2013:p0840:b004:l022","ordinal":140548,"en":"His gold by the pood, his gold coins—"},{"id":"semetey-1-2013:p0840:b004:l023","ordinal":140549,"en":"Even if Muslims burned them,"},{"id":"semetey-1-2013:p0840:b004:l024","ordinal":140550,"en":"He would not regard it as worth a hair!"},{"id":"semetey-1-2013:p0840:b004:l025","ordinal":140551,"en":"Even if they humiliated him like a sheep,"},{"id":"semetey-1-2013:p0840:b004:l026","ordinal":140552,"en":"He would pay the Muslims no heed!"},{"id":"semetey-1-2013:p0840:b004:l027","ordinal":140553,"en":"Are not their khans fools?"},{"id":"semetey-1-2013:p0840:b004:l028","ordinal":140554,"en":"My darling orphan,"},{"id":"semetey-1-2013:p0840:b004:l029","ordinal":140555,"en":"What guilt have the many people?"},{"id":"semetey-1-2013:p0840:b004:l030","ordinal":140556,"en":"Is not their leader a swine?"},{"id":"semetey-1-2013:p0840:b004:l031","ordinal":140557,"en":"What guilt have the other people?"},{"id":"semetey-1-2013:p0840:b004:l032","ordinal":140558,"en":"Be patient, orphan, be patient!"},{"id":"semetey-1-2013:p0840:b004:l033","ordinal":140559,"en":"In the end, one day we shall die."},{"id":"semetey-1-2013:p0840:b004:l034","ordinal":140560,"en":"If we kill innocent people,"},{"id":"semetey-1-2013:p0840:b004:l035","ordinal":140561,"en":"On the coming Day of Resurrection,"},{"id":"semetey-1-2013:p0840:b004:l036","ordinal":140562,"en":"How shall we answer for their blood?"},{"id":"semetey-1-2013:p0840:b004:l037","ordinal":140563,"en":"If you contend with Khan Kokand,"},{"id":"semetey-1-2013:p0840:b004:l038","ordinal":140564,"en":"What desire will you fulfill?"},{"id":"semetey-1-2013:p0840:b004:l039","ordinal":140565,"en":"Will you slaughter its people?"},{"id":"semetey-1-2013:p0841:b003:l001","ordinal":140566,"en":"When you make your people wretched,"},{"id":"semetey-1-2013:p0841:b003:l002","ordinal":140567,"en":"When you slaughter Kokand’s people,"},{"id":"semetey-1-2013:p0841:b003:l003","ordinal":140568,"en":"When you bring them all to their end,"},{"id":"semetey-1-2013:p0841:b003:l004","ordinal":140569,"en":"Persisting in your stubbornness,"},{"id":"semetey-1-2013:p0841:b003:l005","ordinal":140570,"en":"When you slaughter this people,"},{"id":"semetey-1-2013:p0841:b003:l006","ordinal":140571,"en":"We shall be deeply steeped in their blood."},{"id":"semetey-1-2013:p0841:b003:l007","ordinal":140572,"en":"On the coming Day of Resurrection,"},{"id":"semetey-1-2013:p0841:b003:l008","ordinal":140573,"en":"We shall become black donkeys."},{"id":"semetey-1-2013:p0841:b003:l009","ordinal":140574,"en":"If what is told is true,"},{"id":"semetey-1-2013:p0841:b003:l010","ordinal":140575,"en":"On Judgment’s narrow path,"},{"id":"semetey-1-2013:p0841:b003:l012","ordinal":140576,"en":"‘He slaughtered the innocent,’ they will say;","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0841:b003:l013","ordinal":140577,"en":"Will they not come demanding justice for their blood?”"},{"id":"semetey-1-2013:p0841:b003:l014","ordinal":140578,"en":"Your uncle Sary, with eyes like little bowls,"},{"id":"semetey-1-2013:p0841:b003:l015","ordinal":140579,"en":"Teaching him what he did not know,"},{"id":"semetey-1-2013:p0841:b003:l016","ordinal":140580,"en":"Thus bringing him to heed,"},{"id":"semetey-1-2013:p0841:b003:l017","ordinal":140581,"en":"The orphan son of Manas,"},{"id":"semetey-1-2013:p0841:b003:l018","ordinal":140582,"en":"Taking the lead rope, led him,"},{"id":"semetey-1-2013:p0841:b003:l019","ordinal":140583,"en":"Cutting across to a narrow road."},{"id":"semetey-1-2013:p0841:b003:l020","ordinal":140584,"en":"Teaching him what he did not know,"},{"id":"semetey-1-2013:p0841:b003:l021","ordinal":140585,"en":"Thus setting him upon the road,"},{"id":"semetey-1-2013:p0841:b003:l022","ordinal":140586,"en":"He took the orphan away."},{"id":"semetey-1-2013:p0841:b003:l023","ordinal":140587,"en":"Having made a spectacle upon the road,"},{"id":"semetey-1-2013:p0841:b003:l024","ordinal":140588,"en":"Having wrought havoc in Kokand,"},{"id":"semetey-1-2013:p0841:b003:l025","ordinal":140589,"en":"Sated with blood and hardened,"},{"id":"semetey-1-2013:p0841:b003:l026","ordinal":140590,"en":"Renowned as a fierce leopard,"},{"id":"semetey-1-2013:p0841:b003:l027","ordinal":140591,"en":"They had left Bukhara,"},{"id":"semetey-1-2013:p0841:b003:l028","ordinal":140592,"en":"And passed toward Talas."},{"id":"semetey-1-2013:p0841:b003:l029","ordinal":140593,"en":"His mother Kanykei’s Aman-Jol—"},{"id":"semetey-1-2013:p0841:b003:l030","ordinal":140594,"en":"They now followed Aman-Jol."},{"id":"semetey-1-2013:p0841:b003:l031","ordinal":140595,"en":"The orphan did not weary of the journey;"},{"id":"semetey-1-2013:p0841:b003:l032","ordinal":140596,"en":"They reached the Syr-Darya."},{"id":"semetey-1-2013:p0841:b003:l033","ordinal":140597,"en":"To the banks of the Syr-Darya,"},{"id":"semetey-1-2013:p0841:b003:l034","ordinal":140598,"en":"When they drew near,"},{"id":"semetey-1-2013:p0841:b003:l035","ordinal":140599,"en":"After enduring much grief and torment,"},{"id":"semetey-1-2013:p0841:b003:l036","ordinal":140600,"en":"When they reached the place she had crossed,"},{"id":"semetey-1-2013:p0841:b003:l037","ordinal":140601,"en":"In winter’s fiercest cold,"},{"id":"semetey-1-2013:p0841:b003:l038","ordinal":140602,"en":"Forty-two times zigzagging through that water,"},{"id":"semetey-1-2013:p0841:b003:l039","ordinal":140603,"en":"When they reached the place she had forded,"},{"id":"semetey-1-2013:p0841:b005:l001","ordinal":140604,"en":"Then your mother Kanykei—"},{"id":"semetey-1-2013:p0841:b005:l002","ordinal":140605,"en":"Would God take her merely for lamenting?"},{"id":"semetey-1-2013:p0841:b005:l003","ordinal":140606,"en":"She had prayed for her only child."},{"id":"semetey-1-2013:p0841:b005:l004","ordinal":140607,"en":"The ice then frozen to her calves—"},{"id":"semetey-1-2013:p0841:b005:l005","ordinal":140608,"en":"Could it ever leave her very bones?"},{"id":"semetey-1-2013:p0841:b005:l006","ordinal":140609,"en":"When she saw the road she had come,"},{"id":"semetey-1-2013:p0841:b005:l007","ordinal":140610,"en":"Her heart was deeply troubled,"},{"id":"semetey-1-2013:p0841:b005:l008","ordinal":140611,"en":"Tears poured from her eyes,"},{"id":"semetey-1-2013:p0841:b005:l009","ordinal":140612,"en":"Her ribs seemed to come apart,"},{"id":"semetey-1-2013:p0841:b005:l010","ordinal":140613,"en":"Her heart burned with grief."},{"id":"semetey-1-2013:p0841:b005:l011","ordinal":140614,"en":"She stood gazing, aching,"},{"id":"semetey-1-2013:p0841:b005:l012","ordinal":140615,"en":"And to the orphan left by Manas"},{"id":"semetey-1-2013:p0841:b005:l013","ordinal":140616,"en":"The meaning of the Syr-Darya"},{"id":"semetey-1-2013:p0841:b005:l014","ordinal":140617,"en":"She told with sobs:"},{"id":"semetey-1-2013:p0841:b005:l015","ordinal":140618,"en":"“Once, when I scattered my countless possessions,"},{"id":"semetey-1-2013:p0841:b005:l016","ordinal":140619,"en":"When I fled Talas on foot,"},{"id":"semetey-1-2013:p0841:b005:l017","ordinal":140620,"en":"My child, for your sake,"},{"id":"semetey-1-2013:p0841:b005:l018","ordinal":140621,"en":"I roamed along the mountains’ edges."},{"id":"semetey-1-2013:p0841:b005:l019","ordinal":140622,"en":"‘The only one left by the hero,’ I said,"},{"id":"semetey-1-2013:p0841:b005:l020","ordinal":140623,"en":"In the fold of my wraparound skirt"},{"id":"semetey-1-2013:p0841:b005:l021","ordinal":140624,"en":"I tucked you securely and fastened you,"},{"id":"semetey-1-2013:p0841:b005:l022","ordinal":140625,"en":"Chafing my heels,"},{"id":"semetey-1-2013:p0841:b005:l023","ordinal":140626,"en":"Aching in the flesh of my calves."},{"id":"semetey-1-2013:p0841:b005:l024","ordinal":140627,"en":"The child cried from hunger;"},{"id":"semetey-1-2013:p0841:b005:l025","ordinal":140628,"en":"I, your mother, a wretched slave,"},{"id":"semetey-1-2013:p0841:b005:l026","ordinal":140629,"en":"Sobbed, finding no way out."},{"id":"semetey-1-2013:p0841:b005:l027","ordinal":140630,"en":"Unable to ford the Syr-Darya,"},{"id":"semetey-1-2013:p0841:b005:l028","ordinal":140631,"en":"Unable to reach my desire,"},{"id":"semetey-1-2013:p0841:b005:l029","ordinal":140632,"en":"Allah’s sun in heaven clouded over;"},{"id":"semetey-1-2013:p0841:b005:l030","ordinal":140633,"en":"Sixty worries fell upon me together."},{"id":"semetey-1-2013:p0841:b005:l031","ordinal":140634,"en":"My mother upon my back,"},{"id":"semetey-1-2013:p0841:b005:l032","ordinal":140635,"en":"You, my child, at my waist,"},{"id":"semetey-1-2013:p0841:b005:l033","ordinal":140636,"en":"I carried you both without wearying;"},{"id":"semetey-1-2013:p0841:b005:l034","ordinal":140637,"en":"Your old grandmother coughed on my back."},{"id":"semetey-1-2013:p0841:b005:l035","ordinal":140638,"en":"Would God take me merely for lamenting?"},{"id":"semetey-1-2013:p0841:b005:l036","ordinal":140639,"en":"The ice frozen to my shins—"},{"id":"semetey-1-2013:p0841:b005:l037","ordinal":140640,"en":"Could it ever leave my very bones?"},{"id":"semetey-1-2013:p0841:b005:l038","ordinal":140641,"en":"Unable to cross this water,"},{"id":"semetey-1-2013:p0842:b003:l001","ordinal":140642,"en":"Unable to reach the place I sought,"},{"id":"semetey-1-2013:p0842:b003:l002","ordinal":140643,"en":"The flesh of my soles wore away and split;"},{"id":"semetey-1-2013:p0842:b003:l003","ordinal":140644,"en":"The dark blood flowing from my calves"},{"id":"semetey-1-2013:p0842:b003:l004","ordinal":140645,"en":"Streamed down the length of a saddle strap."},{"id":"semetey-1-2013:p0842:b003:l005","ordinal":140646,"en":"My voice reached God;"},{"id":"semetey-1-2013:p0842:b003:l006","ordinal":140647,"en":"I fell and crawled upon the earth."},{"id":"semetey-1-2013:p0842:b003:l008","ordinal":140648,"en":"Noble Bakai, the valiant one,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0842:b003:l009","ordinal":140649,"en":"Your father’s dear companion,"},{"id":"semetey-1-2013:p0842:b003:l010","ordinal":140650,"en":"His companion unto Judgment,"},{"id":"semetey-1-2013:p0842:b003:l011","ordinal":140651,"en":"His comrade blessed by Kydyr—"},{"id":"semetey-1-2013:p0842:b003:l012","ordinal":140652,"en":"Your fierce father Manas’s"},{"id":"semetey-1-2013:p0842:b003:l013","ordinal":140653,"en":"Dear adviser,"},{"id":"semetey-1-2013:p0842:b003:l014","ordinal":140654,"en":"Noble Bakai, the falcon,"},{"id":"semetey-1-2013:p0842:b003:l015","ordinal":140655,"en":"Brought two swift horses,"},{"id":"semetey-1-2013:p0842:b003:l016","ordinal":140656,"en":"Brought two skins of milk."},{"id":"semetey-1-2013:p0842:b003:l017","ordinal":140657,"en":"On the banks of the Syr-Darya,"},{"id":"semetey-1-2013:p0842:b003:l018","ordinal":140658,"en":"Your noble elder Bakai’s"},{"id":"semetey-1-2013:p0842:b003:l019","ordinal":140659,"en":"Wether slaughtered for our food—"},{"id":"semetey-1-2013:p0842:b003:l020","ordinal":140660,"en":"How can they leave my memory,"},{"id":"semetey-1-2013:p0842:b003:l021","ordinal":140661,"en":"The deeds of those six scoundrels?"},{"id":"semetey-1-2013:p0842:b003:l022","ordinal":140662,"en":"Jaiyk-Kechüü and Tash-Kechüü—"},{"id":"semetey-1-2013:p0842:b003:l023","ordinal":140663,"en":"Your royal elder Bakai,"},{"id":"semetey-1-2013:p0842:b003:l024","ordinal":140664,"en":"The sage who knew them all,"},{"id":"semetey-1-2013:p0842:b003:l025","ordinal":140665,"en":"Kindling the extinguished fire,"},{"id":"semetey-1-2013:p0842:b003:l026","ordinal":140666,"en":"Reviving the dead,"},{"id":"semetey-1-2013:p0842:b003:l027","ordinal":140667,"en":"Toward Khan Bukhara"},{"id":"semetey-1-2013:p0842:b003:l028","ordinal":140668,"en":"The sage set us on the road.”"},{"id":"semetey-1-2013:p0842:b003:l029","ordinal":140669,"en":"Tash-Kechüü, which Bakai found,"},{"id":"semetey-1-2013:p0842:b003:l030","ordinal":140670,"en":"The familiar ford the sage found—"},{"id":"semetey-1-2013:p0842:b003:l031","ordinal":140671,"en":"Your formidable mother Kanykei"},{"id":"semetey-1-2013:p0842:b003:l032","ordinal":140672,"en":"Now took Tash-Kechüü."},{"id":"semetey-1-2013:p0842:b003:l033","ordinal":140673,"en":"Leading all the pack animals in a line,"},{"id":"semetey-1-2013:p0842:b003:l034","ordinal":140674,"en":"They safely crossed,"},{"id":"semetey-1-2013:p0842:b003:l035","ordinal":140675,"en":"And set out upon the open plain."},{"id":"semetey-1-2013:p0842:b003:l036","ordinal":140676,"en":"Taking no rest by day,"},{"id":"semetey-1-2013:p0842:b003:l037","ordinal":140677,"en":"Taking no sleep at night,"},{"id":"semetey-1-2013:p0842:b003:l038","ordinal":140678,"en":"Never lying down for a full sleep,"},{"id":"semetey-1-2013:p0842:b003:l039","ordinal":140679,"en":"Never letting the swift horses weary,"},{"id":"semetey-1-2013:p0842:b004:l001","ordinal":140680,"en":"Thus they moved toward Talas."},{"id":"semetey-1-2013:p0842:b004:l002","ordinal":140681,"en":"Traveling across the open plain,"},{"id":"semetey-1-2013:p0842:b004:l003","ordinal":140682,"en":"Going far and tiring their horses,"},{"id":"semetey-1-2013:p0842:b004:l004","ordinal":140683,"en":"Loading their pack animals,"},{"id":"semetey-1-2013:p0842:b004:l005","ordinal":140684,"en":"Having openly departed Bukhara,"},{"id":"semetey-1-2013:p0842:b004:l006","ordinal":140685,"en":"They moved toward Talas."},{"id":"semetey-1-2013:p0842:b004:l007","ordinal":140686,"en":"Over ridge after hilly ridge,"},{"id":"semetey-1-2013:p0842:b004:l008","ordinal":140687,"en":"Over ridges of the open plain,"},{"id":"semetey-1-2013:p0842:b004:l009","ordinal":140688,"en":"At Chiyyrchyk and Salar-Ata,"},{"id":"semetey-1-2013:p0842:b004:l010","ordinal":140689,"en":"They prayed as they passed."},{"id":"semetey-1-2013:p0842:b004:l011","ordinal":140690,"en":"Turkestan, hazy in the distance,"},{"id":"semetey-1-2013:p0842:b004:l012","ordinal":140691,"en":"The great shrine of Tümön-Ata—"},{"id":"semetey-1-2013:p0842:b004:l013","ordinal":140692,"en":"Leaving none of them unvisited,"},{"id":"semetey-1-2013:p0842:b004:l014","ordinal":140693,"en":"They paid reverence as they went."},{"id":"semetey-1-2013:p0842:b004:l015","ordinal":140694,"en":"Crossing passes, moving along the road,"},{"id":"semetey-1-2013:p0842:b004:l016","ordinal":140695,"en":"Seeing many wondrous ridges,"},{"id":"semetey-1-2013:p0842:b004:l017","ordinal":140696,"en":"Seeing sacred places,"},{"id":"semetey-1-2013:p0842:b004:l018","ordinal":140697,"en":"Into jagged ridges,"},{"id":"semetey-1-2013:p0842:b004:l019","ordinal":140698,"en":"Into gaping places,"},{"id":"semetey-1-2013:p0842:b004:l020","ordinal":140699,"en":"They now came."},{"id":"semetey-1-2013:p0842:b004:l021","ordinal":140700,"en":"They saw a ridge rise from the level plain;"},{"id":"semetey-1-2013:p0842:b004:l022","ordinal":140701,"en":"As though a person had made them,"},{"id":"semetey-1-2013:p0842:b004:l023","ordinal":140702,"en":"They saw hills in various places."},{"id":"semetey-1-2013:p0842:b004:l024","ordinal":140703,"en":"Traveling day and night,"},{"id":"semetey-1-2013:p0842:b004:l025","ordinal":140704,"en":"They moved on with a rumble."},{"id":"semetey-1-2013:p0842:b004:l026","ordinal":140705,"en":"Traveling for many days,"},{"id":"semetey-1-2013:p0842:b004:l027","ordinal":140706,"en":"Moving far, no little distance,"},{"id":"semetey-1-2013:p0842:b004:l028","ordinal":140707,"en":"They journeyed eagerly without wearying."},{"id":"semetey-1-2013:p0842:b004:l029","ordinal":140708,"en":"A wondrous place no person had seen"},{"id":"semetey-1-2013:p0842:b004:l030","ordinal":140709,"en":"Came forth to meet them."},{"id":"semetey-1-2013:p0842:b004:l031","ordinal":140710,"en":"It had steep banks and hills,"},{"id":"semetey-1-2013:p0842:b004:l032","ordinal":140711,"en":"Places marvelous to behold,"},{"id":"semetey-1-2013:p0842:b004:l033","ordinal":140712,"en":"Hillocks and ridges."},{"id":"semetey-1-2013:p0842:b004:l034","ordinal":140713,"en":"Looking closely at this land,"},{"id":"semetey-1-2013:p0842:b004:l035","ordinal":140714,"en":"There were places beyond human telling."},{"id":"semetey-1-2013:p0842:b004:l036","ordinal":140715,"en":"Seeing craggy, jutting mountains,"},{"id":"semetey-1-2013:p0842:b004:l037","ordinal":140716,"en":"Seeing places no person trod,"},{"id":"semetey-1-2013:p0842:b004:l038","ordinal":140717,"en":"To a pass like a saddle ridge"},{"id":"semetey-1-2013:p0842:b004:l039","ordinal":140718,"en":"They now climbed."},{"id":"semetey-1-2013:p0843:b004:l001","ordinal":140719,"en":"When they climbed onto the ridge,"},{"id":"semetey-1-2013:p0843:b004:l002","ordinal":140720,"en":"Do not ask the hero’s state;"},{"id":"semetey-1-2013:p0843:b004:l003","ordinal":140721,"en":"When they climbed that hill,"},{"id":"semetey-1-2013:p0843:b004:l004","ordinal":140722,"en":"Do not ask your wretched mother’s state!"},{"id":"semetey-1-2013:p0843:b004:l005","ordinal":140723,"en":"When she beheld the land,"},{"id":"semetey-1-2013:p0843:b004:l006","ordinal":140724,"en":"She spoke of what its places meant."},{"id":"semetey-1-2013:p0843:b004:l007","ordinal":140725,"en":"“Showing through the haze—"},{"id":"semetey-1-2013:p0843:b004:l008","ordinal":140726,"en":"Oluya-Ata and broad Merki."},{"id":"semetey-1-2013:p0843:b004:l009","ordinal":140727,"en":"Oh, my orphan, what can I do?"},{"id":"semetey-1-2013:p0843:b004:l010","ordinal":140728,"en":"The past comes into my mind!"},{"id":"semetey-1-2013:p0843:b004:l011","ordinal":140729,"en":"Visible farther beyond,"},{"id":"semetey-1-2013:p0843:b004:l012","ordinal":140730,"en":"Kara-Balta and Sokuluk"},{"id":"semetey-1-2013:p0843:b004:l013","ordinal":140731,"en":"Show dark and beautiful."},{"id":"semetey-1-2013:p0843:b004:l014","ordinal":140732,"en":"Your mother, whose fortune has withered,"},{"id":"semetey-1-2013:p0843:b004:l015","ordinal":140733,"en":"Pours tears from her eyes."},{"id":"semetey-1-2013:p0843:b004:l016","ordinal":140734,"en":"My child whom I gained at death’s door,"},{"id":"semetey-1-2013:p0843:b004:l017","ordinal":140735,"en":"What is seen today is gone tomorrow;"},{"id":"semetey-1-2013:p0843:b004:l018","ordinal":140736,"en":"Such is this shitty world!"},{"id":"semetey-1-2013:p0843:b004:l019","ordinal":140737,"en":"That gaping gorge there—"},{"id":"semetey-1-2013:p0843:b004:l020","ordinal":140738,"en":"Listen to the torment, orphan;"},{"id":"semetey-1-2013:p0843:b004:l021","ordinal":140739,"en":"Your mother will tell much of her sorrow."},{"id":"semetey-1-2013:p0843:b004:l022","ordinal":140740,"en":"That is Küyük Pass."},{"id":"semetey-1-2013:p0843:b004:l023","ordinal":140741,"en":"My voice reached God,"},{"id":"semetey-1-2013:p0843:b004:l024","ordinal":140742,"en":"My very bones ached;"},{"id":"semetey-1-2013:p0843:b004:l025","ordinal":140743,"en":"I cried out, but God did not take me."},{"id":"semetey-1-2013:p0843:b004:l026","ordinal":140744,"en":"The place where she scattered her wealth,"},{"id":"semetey-1-2013:p0843:b004:l027","ordinal":140745,"en":"The place where your mother fled on foot,"},{"id":"semetey-1-2013:p0843:b004:l028","ordinal":140746,"en":"When your mother suffered humiliation,"},{"id":"semetey-1-2013:p0843:b004:l029","ordinal":140747,"en":"All these places,"},{"id":"semetey-1-2013:p0843:b004:l030","ordinal":140748,"en":"Leaving none, she crossed."},{"id":"semetey-1-2013:p0843:b004:l031","ordinal":140749,"en":"That gray, backward-sloping hill—"},{"id":"semetey-1-2013:p0843:b004:l032","ordinal":140750,"en":"That is the pass called Chakmak."},{"id":"semetey-1-2013:p0843:b004:l033","ordinal":140751,"en":"Weary from fleeing, exhausted,"},{"id":"semetey-1-2013:p0843:b004:l034","ordinal":140752,"en":"I was the wretch who lamented there."},{"id":"semetey-1-2013:p0843:b004:l035","ordinal":140753,"en":"The gray round hill, leaning back—"},{"id":"semetey-1-2013:p0843:b004:l036","ordinal":140754,"en":"That is Jorgo Pass."},{"id":"semetey-1-2013:p0843:b006:l001","ordinal":140755,"en":"Sobbing in grief, unable to cross,"},{"id":"semetey-1-2013:p0843:b006:l002","ordinal":140756,"en":"I was the one who suffered torment."},{"id":"semetey-1-2013:p0843:b006:l003","ordinal":140757,"en":"I, your mother Kanykei,"},{"id":"semetey-1-2013:p0843:b006:l004","ordinal":140758,"en":"Could not cross Küyük Pass;"},{"id":"semetey-1-2013:p0843:b006:l005","ordinal":140759,"en":"Burning with grief, I could not walk."},{"id":"semetey-1-2013:p0843:b006:l006","ordinal":140760,"en":"I could not cross Jorgo Pass;"},{"id":"semetey-1-2013:p0843:b006:l007","ordinal":140761,"en":"Sobbing in grief, I could not walk."},{"id":"semetey-1-2013:p0843:b006:l008","ordinal":140762,"en":"I could not cross Chakmak Pass;"},{"id":"semetey-1-2013:p0843:b006:l009","ordinal":140763,"en":"Weary and weeping, I could not walk."},{"id":"semetey-1-2013:p0843:b006:l010","ordinal":140764,"en":"Dark blood flowed from my calves;"},{"id":"semetey-1-2013:p0843:b006:l011","ordinal":140765,"en":"My strength left me, wretched as I was."},{"id":"semetey-1-2013:p0843:b006:l012","ordinal":140766,"en":"Swaying, dragging myself along,"},{"id":"semetey-1-2013:p0843:b006:l013","ordinal":140767,"en":"The skin of my soles all stripped away,"},{"id":"semetey-1-2013:p0843:b006:l014","ordinal":140768,"en":"My heels chafed,"},{"id":"semetey-1-2013:p0843:b006:l015","ordinal":140769,"en":"The flesh of my calves aching,"},{"id":"semetey-1-2013:p0843:b006:l016","ordinal":140770,"en":"For two days in one place"},{"id":"semetey-1-2013:p0843:b006:l017","ordinal":140771,"en":"Never lying down, I fled."},{"id":"semetey-1-2013:p0843:b006:l018","ordinal":140772,"en":"On the face of the earth, my precious life"},{"id":"semetey-1-2013:p0843:b006:l019","ordinal":140773,"en":"Found no room, and I fled."},{"id":"semetey-1-2013:p0843:b006:l020","ordinal":140774,"en":"A span of my flank rubbed raw,"},{"id":"semetey-1-2013:p0843:b006:l022","ordinal":140775,"en":"My heart plunged into darkness and pain,"},{"id":"semetey-1-2013:p0843:b006:l023","ordinal":140776,"en":"My orphan child, for your sake,"},{"id":"semetey-1-2013:p0843:b006:l024","ordinal":140777,"en":"What did I not see?"},{"id":"semetey-1-2013:p0843:b006:l025","ordinal":140778,"en":"What did I not become?"},{"id":"semetey-1-2013:p0843:b006:l026","ordinal":140779,"en":"When God laid this upon my head,"},{"id":"semetey-1-2013:p0843:b006:l027","ordinal":140780,"en":"Black night fell over me."},{"id":"semetey-1-2013:p0843:b006:l028","ordinal":140781,"en":"With no shoes, in my stockings,"},{"id":"semetey-1-2013:p0843:b006:l029","ordinal":140782,"en":"When your mother fled this way,"},{"id":"semetey-1-2013:p0843:b006:l030","ordinal":140783,"en":"Though I grieved, my wretched life would not end."},{"id":"semetey-1-2013:p0843:b006:l031","ordinal":140784,"en":"My boots worn out, in stockings,"},{"id":"semetey-1-2013:p0843:b006:l032","ordinal":140785,"en":"Unless He wished to take it,"},{"id":"semetey-1-2013:p0843:b006:l033","ordinal":140786,"en":"This obstinate life would not die!"},{"id":"semetey-1-2013:p0843:b006:l034","ordinal":140787,"en":"My child, for your sake,"},{"id":"semetey-1-2013:p0843:b006:l035","ordinal":140788,"en":"Sobbing, weeping, crying aloud,"},{"id":"semetey-1-2013:p0843:b006:l036","ordinal":140789,"en":"I called upon the dead."},{"id":"semetey-1-2013:p0844:b003:l001","ordinal":140790,"en":"“Though I speak, sorrow does not end;"},{"id":"semetey-1-2013:p0844:b003:l002","ordinal":140791,"en":"Your fierce father cannot be found."},{"id":"semetey-1-2013:p0844:b003:l003","ordinal":140792,"en":"Weeping and crying for so long,"},{"id":"semetey-1-2013:p0844:b003:l004","ordinal":140793,"en":"‘My bloodthirsty hero!’ I sobbed.”"},{"id":"semetey-1-2013:p0844:b003:l005","ordinal":140794,"en":"Your mother Kanykei said this,"},{"id":"semetey-1-2013:p0844:b003:l006","ordinal":140795,"en":"Told of terrors no one had heard,"},{"id":"semetey-1-2013:p0844:b003:l007","ordinal":140796,"en":"Told of ridge after ridge,"},{"id":"semetey-1-2013:p0844:b003:l008","ordinal":140797,"en":"Told of many separate places."},{"id":"semetey-1-2013:p0844:b003:l009","ordinal":140798,"en":"The yellow, hilly rises—"},{"id":"semetey-1-2013:p0844:b003:l010","ordinal":140799,"en":"They crossed their lower slopes."},{"id":"semetey-1-2013:p0844:b003:l011","ordinal":140800,"en":"The shrine of Oluya-Ata—"}]
