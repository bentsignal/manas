20743,"en":"If you get it, don't move."},{"id":"seytek-2012:p0358:b003:l025","ordinal":320744,"en":"I am Emil Chokmor."},{"id":"seytek-2012:p0358:b003:l026","ordinal":320745,"en":"If you flow, you will be filled with joy."},{"id":"seytek-2012:p0358:b003:l027","ordinal":320746,"en":"If you cry, you will be angry"},{"id":"seytek-2012:p0358:b003:l028","ordinal":320747,"en":"I am the first cousin."},{"id":"seytek-2012:p0358:b003:l029","ordinal":320748,"en":"Listen to me, my dear,"},{"id":"seytek-2012:p0358:b003:l030","ordinal":320749,"en":"Wait for me, my dear."},{"id":"seytek-2012:p0358:b003:l031","ordinal":320750,"en":"Unable to find Aizaker,"},{"id":"seytek-2012:p0358:b003:l032","ordinal":320751,"en":"I sharpen black steel,"},{"id":"seytek-2012:p0358:b003:l033","ordinal":320752,"en":"If the enemy attacks,"},{"id":"seytek-2012:p0358:b003:l034","ordinal":320753,"en":"I will punch the snow,"},{"id":"seytek-2012:p0358:b003:l035","ordinal":320754,"en":"If the drum beats, the wind won't blow,"},{"id":"seytek-2012:p0358:b003:l036","ordinal":320755,"en":"I am a swampy forest."},{"id":"seytek-2012:p0358:b003:l037","ordinal":320756,"en":"The moon ruled the universe"},{"id":"seytek-2012:p0358:b003:l038","ordinal":320757,"en":"Hungry cry, sly suran,"},{"id":"seytek-2012:p0358:b003:l039","ordinal":320758,"en":"I'm very sorry."},{"id":"seytek-2012:p0358:b003:l040","ordinal":320759,"en":"Wait, air, myself,"},{"id":"seytek-2012:p0359:b002:l001","ordinal":320760,"en":"It is equal to the black earth."},{"id":"seytek-2012:p0359:b002:l002","ordinal":320761,"en":"No courage, weak heart,"},{"id":"seytek-2012:p0359:b002:l003","ordinal":320762,"en":"It's almost impossible to go on patrol."},{"id":"seytek-2012:p0359:b002:l004","ordinal":320763,"en":"A thick black sardine -"},{"id":"seytek-2012:p0359:b002:l005","ordinal":320764,"en":"Where did he say he was a hero?"},{"id":"seytek-2012:p0359:b002:l006","ordinal":320765,"en":"Twisted steel rod,"},{"id":"seytek-2012:p0359:b002:l007","ordinal":320766,"en":"Look at Imger."},{"id":"seytek-2012:p0359:b002:l008","ordinal":320767,"en":"Botom, a fireman on a horse,"},{"id":"seytek-2012:p0359:b002:l009","ordinal":320768,"en":"A smiling enemy, a servant"}]
