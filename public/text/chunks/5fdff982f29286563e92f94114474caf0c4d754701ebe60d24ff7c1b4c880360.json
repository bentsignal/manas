[{"id":"manas-2010:p1832:b001:l013","ordinal":78593,"en":"O warrior, can grief be repayment?"},{"id":"manas-2010:p1832:b001:l014","ordinal":78594,"en":"You gave your only child as a gift;"},{"id":"manas-2010:p1832:b001:l015","ordinal":78595,"en":"Can your promise become two?"},{"id":"manas-2010:p1832:b001:l016","ordinal":78596,"en":"Your falcon, your only light,"},{"id":"manas-2010:p1832:b001:l017","ordinal":78597,"en":"Has attained his desire."},{"id":"manas-2010:p1832:b001:l018","ordinal":78598,"en":"This is God's decree:"},{"id":"manas-2010:p1832:b001:l019","ordinal":78599,"en":"Manas, your confidant and dear friend,"},{"id":"manas-2010:p1832:b001:l020","ordinal":78600,"en":"Has taken the falcon with him as a companion.”"},{"id":"manas-2010:p1832:b001:l021","ordinal":78601,"en":"So, grieving thus,"},{"id":"manas-2010:p1832:b001:l022","ordinal":78602,"en":"Kokboru went back to his people, they say."},{"id":"manas-2010:p1832:b001:l023","ordinal":78603,"en":"With anguish lodged within him,"},{"id":"manas-2010:p1832:b001:l024","ordinal":78604,"en":"“My only child Koyonaaly has died,” he said."},{"id":"manas-2010:p1832:b001:l025","ordinal":78605,"en":"To Khan Manas's funeral observances,"},{"id":"manas-2010:p1832:b001:l026","ordinal":78606,"en":"Kokboru did not come, they say."},{"id":"manas-2010:p1832:b001:l027","ordinal":78607,"en":"“Because Kokboru has not come,”"},{"id":"manas-2010:p1832:b001:l028","ordinal":78608,"en":"Toshtuk did not come, they say."},{"id":"manas-2010:p1832:b001:l029","ordinal":78609,"en":"Since Toshtuk did not come,"},{"id":"manas-2010:p1832:b001:l030","ordinal":78610,"en":"Khan Koshoi of the Katagan,"},{"id":"manas-2010:p1832:b001:l031","ordinal":78611,"en":"That khan did not come, they say."},{"id":"manas-2010:p1832:b001:l032","ordinal":78612,"en":"Those who had made their promise firm,"},{"id":"manas-2010:p1832:b001:l033","ordinal":78613,"en":"All the khans—"},{"id":"manas-2010:p1832:b001:l034","ordinal":78614,"en":"And so, all of them failed"},{"id":"manas-2010:p1832:b001:l035","ordinal":78615,"en":"To come, they say!"}]
