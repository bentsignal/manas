[{"id":"semetey-1-2013:p1085:b003:l031","ordinal":158977,"en":"And kept flogging him."},{"id":"semetey-1-2013:p1085:b003:l032","ordinal":158978,"en":"Such were Alööke's deeds:"},{"id":"semetey-1-2013:p1085:b003:l033","ordinal":158979,"en":"When anyone went to Alööke,"},{"id":"semetey-1-2013:p1085:b003:l034","ordinal":158980,"en":"Every person who went"},{"id":"semetey-1-2013:p1085:b003:l035","ordinal":158981,"en":"Paid homage and bowed."},{"id":"semetey-1-2013:p1085:b003:l036","ordinal":158982,"en":"Alööke's deeds"},{"id":"semetey-1-2013:p1085:b003:l037","ordinal":158983,"en":"Became clearly known"},{"id":"semetey-1-2013:p1085:b003:l038","ordinal":158984,"en":"To magnanimous Sultan Manas."},{"id":"semetey-1-2013:p1085:b003:l039","ordinal":158985,"en":"With Khan Bakai and Manas at their head,"},{"id":"semetey-1-2013:p1085:b004:l001","ordinal":158986,"en":"When they launched an assault"},{"id":"semetey-1-2013:p1085:b004:l002","ordinal":158987,"en":"Against Alööke,"},{"id":"semetey-1-2013:p1085:b004:l003","ordinal":158988,"en":"And heard reports from those who came,"},{"id":"semetey-1-2013:p1085:b004:l004","ordinal":158989,"en":"Brave Manas went to meet him"},{"id":"semetey-1-2013:p1085:b004:l005","ordinal":158990,"en":"And, they heard, burned everything down."},{"id":"semetey-1-2013:p1085:b004:l006","ordinal":158991,"en":"All his possessions were scattered;"},{"id":"semetey-1-2013:p1085:b004:l007","ordinal":158992,"en":"Scorched by the fire, Alööke"},{"id":"semetey-1-2013:p1085:b004:l008","ordinal":158993,"en":"Fled toward Beijing."},{"id":"semetey-1-2013:p1085:b004:l009","ordinal":158994,"en":"From where he settled, Alööke"},{"id":"semetey-1-2013:p1085:b004:l010","ordinal":158995,"en":"Overran broad Kashgar."},{"id":"semetey-1-2013:p1085:b004:l011","ordinal":158996,"en":"When he reached Great Aksy"},{"id":"semetey-1-2013:p1085:b004:l012","ordinal":158997,"en":"And crossed Kum-Aryk,"},{"id":"semetey-1-2013:p1085:b004:l013","ordinal":158998,"en":"At the edge of broad Ak-Chiy,"},{"id":"semetey-1-2013:p1085:b004:l014","ordinal":158999,"en":"Alööke posted his sentries"},{"id":"semetey-1-2013:p1085:b004:l015","ordinal":159000,"en":"And made camp."},{"id":"semetey-1-2013:p1085:b004:l016","ordinal":159001,"en":"Brave Manas bore down on him"},{"id":"semetey-1-2013:p1085:b004:l017","ordinal":159002,"en":"From above"},{"id":"semetey-1-2013:p1085:b004:l018","ordinal":159003,"en":"And scattered all four kinds of his livestock."},{"id":"semetey-1-2013:p1085:b004:l019","ordinal":159004,"en":"He caught up with him and seized him,"},{"id":"semetey-1-2013:p1085:b004:l020","ordinal":159005,"en":"And slaughtered him as a sacrifice."},{"id":"semetey-1-2013:p1085:b004:l021","ordinal":159006,"en":"Saying, “Manas slaughtered my father,”"},{"id":"semetey-1-2013:p1085:b004:l022","ordinal":159007,"en":"Alööke's son Kongurbai"},{"id":"semetey-1-2013:p1085:b004:l023","ordinal":159008,"en":"Came to bear a grudge"},{"id":"semetey-1-2013:p1085:b004:l024","ordinal":159009,"en":"Against noble, magnanimous Manas."},{"id":"semetey-1-2013:p1085:b004:l025","ordinal":159010,"en":"Manas was such a hero:"},{"id":"semetey-1-2013:p1085:b004:l026","ordinal":159011,"en":"For the mere handful of Muslims,"},{"id":"semetey-1-2013:p1085:b004:l027","ordinal":159012,"en":"Magnanimous Manas the leopard"},{"id":"semetey-1-2013:p1085:b004:l028","ordinal":159013,"en":"Was a fortress that protected them."},{"id":"semetey-1-2013:p1085:b004:l029","ordinal":159014,"en":"What twelve ages had never wrought,"},{"id":"semetey-1-2013:p1085:b004:l030","ordinal":159015,"en":"Ruining Sultan Manas did;"},{"id":"semetey-1-2013:p1085:b004:l031","ordinal":159016,"en":"In that bygone age,"},{"id":"semetey-1-2013:p1085:b004:l032","ordinal":159017,"en":"Not a stick for a horse-catching pole remained."},{"id":"semetey-1-2013:p1085:b004:l033","ordinal":159018,"en":"Manas was such a hero;"},{"id":"semetey-1-2013:p1085:b004:l034","ordinal":159019,"en":"His fortune was complete."},{"id":"semetey-1-2013:p1085:b004:l035","ordinal":159020,"en":"When one looked within him,"},{"id":"semetey-1-2013:p1085:b004:l036","ordinal":159021,"en":"He was broader than the face of the earth."},{"id":"semetey-1-2013:p1085:b004:l037","ordinal":159022,"en":"A hero like Manas,"},{"id":"semetey-1-2013:p1085:b004:l038","ordinal":159023,"en":"For the Muslim people—"},{"id":"semetey-1-2013:p1086:b003:l001","ordinal":159024,"en":"The Creator would surely never grant another."},{"id":"semetey-1-2013:p1086:b003:l002","ordinal":159025,"en":"Where the racehorse Akkula had not trodden,"},{"id":"semetey-1-2013:p1086:b003:l003","ordinal":159026,"en":"Nothing on earth remained whole."},{"id":"semetey-1-2013:p1086:b003:l004","ordinal":159027,"en":"Where Manas's hand had not reached,"},{"id":"semetey-1-2013:p1086:b003:l005","ordinal":159028,"en":"No people remained whole."},{"id":"semetey-1-2013:p1086:b003:l006","ordinal":159029,"en":"Was it not Manas whose every deed"},{"id":"semetey-1-2013:p1086:b003:l007","ordinal":159030,"en":"Pleased mortal men?"},{"id":"semetey-1-2013:p1086:b003:l008","ordinal":159031,"en":"Did Manas not raise"},{"id":"semetey-1-2013:p1086:b003:l009","ordinal":159032,"en":"The tiny band of Muslims"},{"id":"semetey-1-2013:p1086:b003:l010","ordinal":159033,"en":"Among infidels of another father?"},{"id":"semetey-1-2013:p1086:b003:l011","ordinal":159034,"en":"The one he pinched was Bakburchun;"},{"id":"semetey-1-2013:p1086:b004:l001","ordinal":159035,"en":"The foe he fought in earnest was Kakan-Chyn."},{"id":"semetey-1-2013:p1086:b004:l002","ordinal":159036,"en":"When many saints spread their hands in prayer,"},{"id":"semetey-1-2013:p1086:b004:l003","ordinal":159037,"en":"Hero Manas was their blessing."},{"id":"semetey-1-2013:p1086:b004:l004","ordinal":159038,"en":"When the Chinese swept over the land,"},{"id":"semetey-1-2013:p1086:b004:l005","ordinal":159039,"en":"To the Muslim people"},{"id":"semetey-1-2013:p1086:b004:l006","ordinal":159040,"en":"Hero Manas was a father."},{"id":"semetey-1-2013:p1086:b004:l007","ordinal":159041,"en":"He was called the hero Manas;"},{"id":"semetey-1-2013:p1086:b004:l008","ordinal":159042,"en":"I have seen what he was"},{"id":"semetey-1-2013:p1086:b004:l009","ordinal":159043,"en":"Upon the face of the world."},{"id":"semetey-1-2013:p1086:b004:l010","ordinal":159044,"en":"I have seen that he was a fortress"},{"id":"semetey-1-2013:p1086:b004:l011","ordinal":159045,"en":"Through which no wind reached the Muslims."},{"id":"semetey-1-2013:p1086:b006:l001","ordinal":159046,"en":"Yesterday—was there such a deed in your tidings?"},{"id":"semetey-1-2013:p1086:b006:l002","ordinal":159047,"en":"Dear Kozho, listen!"},{"id":"semetey-1-2013:p1086:b006:l003","ordinal":159048,"en":"Yesterday, at Kökötöy's funeral feast,"},{"id":"semetey-1-2013:p1086:b006:l004","ordinal":159049,"en":"Before the great gathering,"},{"id":"semetey-1-2013:p1086:b006:l005","ordinal":159050,"en":"Koshoy went, and I went."},{"id":"semetey-1-2013:p1086:b006:l006","ordinal":159051,"en":"Chynkozho, son of Shygay,"},{"id":"semetey-1-2013:p1086:b006:l007","ordinal":159052,"en":"When did you go with them?"},{"id":"semetey-1-2013:p1086:b006:l008","ordinal":159053,"en":"Yesterday, when Khan Kökötöy passed away,"},{"id":"semetey-1-2013:p1086:b006:l009","ordinal":159054,"en":"When he went without turning back"},{"id":"semetey-1-2013:p1086:b006:l010","ordinal":159055,"en":"To the land from which none return,"},{"id":"semetey-1-2013:p1086:b006:l011","ordinal":159056,"en":"There was a man named Kökötöy;"},{"id":"semetey-1-2013:p1086:b006:l012","ordinal":159057,"en":"In the world, Kökötöy"},{"id":"semetey-1-2013:p1086:b006:l013","ordinal":159058,"en":"Had been a wealthy pillar."},{"id":"semetey-1-2013:p1086:b006:l014","ordinal":159059,"en":"He was a rich man dwelling"},{"id":"semetey-1-2013:p1086:b006:l015","ordinal":159060,"en":"In old Tashken and Chyyrchyk."},{"id":"semetey-1-2013:p1086:b006:l016","ordinal":159061,"en":"Of all the peoples of the age"},{"id":"semetey-1-2013:p1086:b006:l017","ordinal":159062,"en":"That ears had heard and eyes had seen,"},{"id":"semetey-1-2013:p1086:b006:l018","ordinal":159063,"en":"Kökötöy was the wealthiest."},{"id":"semetey-1-2013:p1086:b006:l019","ordinal":159064,"en":"He was a khan with forty rooms"},{"id":"semetey-1-2013:p1086:b006:l020","ordinal":159065,"en":"Filled with red coins and yellow gold."},{"id":"semetey-1-2013:p1086:b006:l021","ordinal":159066,"en":"So there was one named Kökötöy."},{"id":"semetey-1-2013:p1086:b006:l022","ordinal":159067,"en":"To all four quarters,"},{"id":"semetey-1-2013:p1086:b007:l001","ordinal":159068,"en":"Kökötöy's wealth"},{"id":"semetey-1-2013:p1086:b007:l002","ordinal":159069,"en":"Spread and brimmed like a lake."},{"id":"semetey-1-2013:p1086:b007:l003","ordinal":159070,"en":"He tended all four kinds of livestock;"},{"id":"semetey-1-2013:p1086:b007:l004","ordinal":159071,"en":"Upon the hairy-breasted black earth,"},{"id":"semetey-1-2013:p1086:b007:l005","ordinal":159072,"en":"Kökötöy's worldly herds"},{"id":"semetey-1-2013:p1086:b007:l006","ordinal":159073,"en":"Had sprung from the strongest stock."},{"id":"semetey-1-2013:p1086:b007:l007","ordinal":159074,"en":"Kökötöy, father of the people,"},{"id":"semetey-1-2013:p1086:b007:l008","ordinal":159075,"en":"Had grown very old;"},{"id":"semetey-1-2013:p1086:b007:l009","ordinal":159076,"en":"His wealth was complete,"},{"id":"semetey-1-2013:p1086:b007:l010","ordinal":159077,"en":"Yet Kökötöy, father of the people,"},{"id":"semetey-1-2013:p1086:b007:l011","ordinal":159078,"en":"Had remained childless."},{"id":"semetey-1-2013:p1086:b007:l012","ordinal":159079,"en":"Trusting in his wealth, Kökötöy"},{"id":"semetey-1-2013:p1086:b007:l013","ordinal":159080,"en":"Had taken seven wives;"},{"id":"semetey-1-2013:p1086:b007:l014","ordinal":159081,"en":"Until he reached seventy-five,"},{"id":"semetey-1-2013:p1086:b007:l015","ordinal":159082,"en":"He had remained without seeing a child."},{"id":"semetey-1-2013:p1086:b007:l016","ordinal":159083,"en":"When he reached seventy-five,"},{"id":"semetey-1-2013:p1086:b007:l017","ordinal":159084,"en":"He took seventy young men as attendants,"},{"id":"semetey-1-2013:p1086:b007:l018","ordinal":159085,"en":"Hunting wild asses and pursuing gazelles,"},{"id":"semetey-1-2013:p1086:b007:l019","ordinal":159086,"en":"And went on a great hunt."},{"id":"semetey-1-2013:p1086:b007:l020","ordinal":159087,"en":"As he journeyed on his travels,"},{"id":"semetey-1-2013:p1086:b007:l021","ordinal":159088,"en":"From Kayypchy's ridge,"},{"id":"semetey-1-2013:p1086:b007:l022","ordinal":159089,"en":"From the desert of Mediyan,"}]
