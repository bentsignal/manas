[{"id":"manas-2010:p1305:b001:l037","ordinal":56577,"en":"Crush them, leaving neither alive!"},{"id":"manas-2010:p1305:b001:l038","ordinal":56578,"en":"If we take the four, people of forty khans,"},{"id":"manas-2010:p1305:b001:l039","ordinal":56579,"en":"There is no ship upon the dark water;"},{"id":"manas-2010:p1305:b001:l040","ordinal":56580,"en":"After that, among the Kyrgyz,"},{"id":"manas-2010:p1305:b001:l041","ordinal":56581,"en":"No one can stand against us."},{"id":"manas-2010:p1305:b001:l042","ordinal":56582,"en":"Overwhelm them, Chinese, overwhelm them!” he cried."},{"id":"manas-2010:p1306:b001:l001","ordinal":56583,"en":"Kongurbay sent out the word."},{"id":"manas-2010:p1306:b001:l002","ordinal":56584,"en":"When Kongurbay spoke thus,"},{"id":"manas-2010:p1306:b001:l003","ordinal":56585,"en":"The great Chinese multitude stirred."},{"id":"manas-2010:p1306:b001:l004","ordinal":56586,"en":"The people of forty khans united"},{"id":"manas-2010:p1306:b001:l005","ordinal":56587,"en":"And rushed in without looking back."},{"id":"manas-2010:p1306:b001:l006","ordinal":56588,"en":"Some with bricks, some with stones,"},{"id":"manas-2010:p1306:b001:l007","ordinal":56589,"en":"They prepared to build a fortress."},{"id":"manas-2010:p1306:b001:l008","ordinal":56590,"en":"You could not tell if they were insects,"},{"id":"manas-2010:p1306:b001:l009","ordinal":56591,"en":"Nor tell if they were people,"},{"id":"manas-2010:p1306:b001:l010","ordinal":56592,"en":"Nor know if they were grass,"},{"id":"manas-2010:p1306:b001:l011","ordinal":56593,"en":"Nor know if they were a lake."},{"id":"manas-2010:p1306:b001:l012","ordinal":56594,"en":"The Chinese people of forty khans"},{"id":"manas-2010:p1306:b001:l013","ordinal":56595,"en":"Arrived without looking back."},{"id":"manas-2010:p1306:b001:l014","ordinal":56596,"en":"The bricks and stones in their hands"},{"id":"manas-2010:p1306:b001:l015","ordinal":56597,"en":"They set down, one apiece, as they passed."},{"id":"manas-2010:p1306:b001:l016","ordinal":56598,"en":"Each took a double handful"},{"id":"manas-2010:p1306:b001:l017","ordinal":56599,"en":"From the ditch he had ordered,"},{"id":"manas-2010:p1306:b001:l018","ordinal":56600,"en":"Scooping it out as they passed."},{"id":"manas-2010:p1306:b001:l019","ordinal":56601,"en":"Look how numerous the Chinese were!"},{"id":"manas-2010:p1306:b001:l020","ordinal":56602,"en":"They made the wall forty cubits high;"},{"id":"manas-2010:p1306:b001:l021","ordinal":56603,"en":"They made the ditch forty cubits deep."},{"id":"manas-2010:p1306:b001:l022","ordinal":56604,"en":"Outside that ditch,"},{"id":"manas-2010:p1306:b001:l023","ordinal":56605,"en":"The two clans, Kuyku and Shiyku,"},{"id":"manas-2010:p1306:b001:l024","ordinal":56606,"en":"The Chinese ran around in a ring."},{"id":"manas-2010:p1306:b001:l025","ordinal":56607,"en":"Poor Chubak and Almambet"},{"id":"manas-2010:p1306:b001:l026","ordinal":56608,"en":"Despaired of their wretched lives."},{"id":"manas-2010:p1306:b001:l027","ordinal":56609,"en":"Then Almambet,"},{"id":"manas-2010:p1306:b001:l028","ordinal":56610,"en":"Who was worth many men in combat,"},{"id":"manas-2010:p1306:b001:l029","ordinal":56611,"en":"Who had struggled for kingship from the start,"},{"id":"manas-2010:p1306:b001:l030","ordinal":56612,"en":"Young goshawk Almambet—"},{"id":"manas-2010:p1306:b001:l031","ordinal":56613,"en":"The customs the Chinese practiced,"},{"id":"manas-2010:p1306:b001:l032","ordinal":56614,"en":"Had he not come knowing them?"},{"id":"manas-2010:p1306:b001:l033","ordinal":56615,"en":"“If the Chinese do this, it bodes no good;"},{"id":"manas-2010:p1306:b001:l034","ordinal":56616,"en":"They certainly will not spare us."},{"id":"manas-2010:p1306:b001:l035","ordinal":56617,"en":"Dear Chubak, my soul’s friend,"},{"id":"manas-2010:p1306:b001:l036","ordinal":56618,"en":"Without wearying, against the Chinese,"},{"id":"manas-2010:p1306:b001:l037","ordinal":56619,"en":"Let us employ a stratagem"},{"id":"manas-2010:p1306:b001:l038","ordinal":56620,"en":"And preserve our lives this way."},{"id":"manas-2010:p1306:b001:l039","ordinal":56621,"en":"Among unbelievers as thick as cattle’s hair,"},{"id":"manas-2010:p1306:b001:l040","ordinal":56622,"en":"Let us die when our appointed time comes."},{"id":"manas-2010:p1306:b001:l041","ordinal":56623,"en":"Manas, the lion of the world—"},{"id":"manas-2010:p1306:b001:l042","ordinal":56624,"en":"Unless we two have died first,"},{"id":"manas-2010:p1307:b001:l001","ordinal":56625,"en":"How could we give him up alive?"},{"id":"manas-2010:p1307:b001:l002","ordinal":56626,"en":"Turn Kogala’s head,” he said."},{"id":"manas-2010:p1307:b001:l003","ordinal":56627,"en":"“My Chubak, born a wolf-man,"},{"id":"manas-2010:p1307:b001:l004","ordinal":56628,"en":"Do not let their many champions climb;"},{"id":"manas-2010:p1307:b001:l005","ordinal":56629,"en":"Hold the mountain slope,” he said."},{"id":"manas-2010:p1307:b001:l006","ordinal":56630,"en":"Azizkhan’s Almambet,"},{"id":"manas-2010:p1307:b001:l007","ordinal":56631,"en":"Sarala with lean, cowlike haunches,"},{"id":"manas-2010:p1307:b001:l008","ordinal":56632,"en":"Had he not saddled and brought him?"},{"id":"manas-2010:p1307:b001:l009","ordinal":56633,"en":"Cloudy by day, clear by night,"},{"id":"manas-2010:p1307:b001:l010","ordinal":56634,"en":"Disrupting the weather’s whirlwinds,"},{"id":"manas-2010:p1307:b001:l011","ordinal":56635,"en":"Without stint, his incantations"},{"id":"manas-2010:p1307:b001:l012","ordinal":56636,"en":"Had he not come reciting?"},{"id":"manas-2010:p1307:b001:l013","ordinal":56637,"en":"A mere Muslim"},{"id":"manas-2010:p1307:b001:l014","ordinal":56638,"en":"Your Almam had become, had he not?"},{"id":"manas-2010:p1307:b001:l015","ordinal":56639,"en":"Beijing of the forty gates—"},{"id":"manas-2010:p1307:b001:l016","ordinal":56640,"en":"The Karykan who ruled it"},{"id":"manas-2010:p1307:b001:l017","ordinal":56641,"en":"Had been your Almam, had he not?"},{"id":"manas-2010:p1307:b001:l018","ordinal":56642,"en":"Upon Karykan"},{"id":"manas-2010:p1307:b001:l019","ordinal":56643,"en":"Merciless trouble"},{"id":"manas-2010:p1307:b001:l020","ordinal":56644,"en":"Had he not come bringing?"},{"id":"manas-2010:p1307:b001:l021","ordinal":56645,"en":"“A weather stone is needed to save our lives,”"},{"id":"manas-2010:p1307:b001:l022","ordinal":56646,"en":"Your renowned champion Almam said."},{"id":"manas-2010:p1307:b001:l023","ordinal":56647,"en":"Karykan’s weather stone,"},{"id":"manas-2010:p1307:b001:l024","ordinal":56648,"en":"Had he not brought it away?"},{"id":"manas-2010:p1307:b001:l025","ordinal":56649,"en":"Rattling in Kalmyk,"},{"id":"manas-2010:p1307:b001:l026","ordinal":56650,"en":"Babbling in Chinese,"},{"id":"manas-2010:p1307:b001:l027","ordinal":56651,"en":"Karykan’s weather stone,"},{"id":"manas-2010:p1307:b001:l028","ordinal":56652,"en":"Into a bowl of plain water,"},{"id":"manas-2010:p1307:b001:l029","ordinal":56653,"en":"He lifted and plunged."},{"id":"manas-2010:p1307:b001:l030","ordinal":56654,"en":"Thus Almambet"},{"id":"manas-2010:p1307:b001:l031","ordinal":56655,"en":"Worked a mighty stratagem;"},{"id":"manas-2010:p1307:b001:l032","ordinal":56656,"en":"He cast a spell upon the weather."},{"id":"manas-2010:p1307:b001:l033","ordinal":56657,"en":"Clouds thundered from the sky,"},{"id":"manas-2010:p1307:b001:l034","ordinal":56658,"en":"Rolling down toward the earth."},{"id":"manas-2010:p1307:b001:l035","ordinal":56659,"en":"The face of heaven closed over;"},{"id":"manas-2010:p1307:b001:l036","ordinal":56660,"en":"The earth was shut within clouds."},{"id":"manas-2010:p1307:b001:l037","ordinal":56661,"en":"Thus Almambet,"},{"id":"manas-2010:p1307:b001:l038","ordinal":56662,"en":"Sarala with lean, cowlike haunches,"},{"id":"manas-2010:p1307:b001:l039","ordinal":56663,"en":"Your precious lion tethered."},{"id":"manas-2010:p1307:b001:l040","ordinal":56664,"en":"Turning summer’s day into winter,"},{"id":"manas-2010:p1307:b001:l041","ordinal":56665,"en":"The lightly clad Chinese"},{"id":"manas-2010:p1307:b001:l042","ordinal":56666,"en":"He made whimper like girls,"},{"id":"manas-2010:p1308:b001:l001","ordinal":56667,"en":"As your precious warrior worked weather magic."},{"id":"manas-2010:p1308:b001:l002","ordinal":56668,"en":"Though rain fell, they massed together;"},{"id":"manas-2010:p1308:b001:l003","ordinal":56669,"en":"The many Chinese pressed upon them,"},{"id":"manas-2010:p1308:b001:l004","ordinal":56670,"en":"Preparing to seize them."},{"id":"manas-2010:p1308:b001:l005","ordinal":56671,"en":"The people of forty khans boasted;"},{"id":"manas-2010:p1308:b001:l006","ordinal":56672,"en":"The mighty warrior Kongurbay"},{"id":"manas-2010:p1308:b001:l007","ordinal":56673,"en":"Gave orders to them all."},{"id":"manas-2010:p1308:b001:l008","ordinal":56674,"en":"Once they heard the word,"},{"id":"manas-2010:p1308:b001:l009","ordinal":56675,"en":"They swarmed together like ants:"},{"id":"manas-2010:p1308:b001:l010","ordinal":56676,"en":"Beijing’s host as countless as sand."},{"id":"manas-2010:p1308:b001:l011","ordinal":56677,"en":"Let us leave this here"},{"id":"manas-2010:p1308:b001:l012","ordinal":56678,"en":"And begin upon this other side."},{"id":"manas-2010:p1308:b001:l013","ordinal":56679,"en":"With the twelve khans’ army,"},{"id":"manas-2010:p1308:b001:l014","ordinal":56680,"en":"Great Bakai, left in the rear camp,"},{"id":"manas-2010:p1308:b001:l015","ordinal":56681,"en":"Woke from sleep in alarm."},{"id":"manas-2010:p1308:b001:l016","ordinal":56682,"en":"He turned onto his right side,"},{"id":"manas-2010:p1308:b001:l017","ordinal":56683,"en":"Hurriedly performed his prayers,"},{"id":"manas-2010:p1308:b001:l018","ordinal":56684,"en":"And feared for Khan Manas."},{"id":"manas-2010:p1308:b001:l019","ordinal":56685,"en":"He saddled his gray battle steed,"},{"id":"manas-2010:p1308:b001:l020","ordinal":56686,"en":"Crying out in haste,"},{"id":"manas-2010:p1308:b001:l021","ordinal":56687,"en":"Calling for Ajybai:"},{"id":"manas-2010:p1308:b001:l022","ordinal":56688,"en":"“Come, Ajybai, bound to my soul!"},{"id":"manas-2010:p1308:b001:l023","ordinal":56689,"en":"Last night I had a dream;"},{"id":"manas-2010:p1308:b001:l024","ordinal":56690,"en":"I saw something to fear."},{"id":"manas-2010:p1308:b001:l025","ordinal":56691,"en":"The Chinese massed as enemies;"},{"id":"manas-2010:p1308:b001:l026","ordinal":56692,"en":"Of the wolf-man, champion Manas,"},{"id":"manas-2010:p1308:b001:l027","ordinal":56693,"en":"Few days of life remained."},{"id":"manas-2010:p1308:b001:l028","ordinal":56694,"en":"If my feeling is right, dear Ajybai,"},{"id":"manas-2010:p1308:b001:l029","ordinal":56695,"en":"With his long ears drooping,"},{"id":"manas-2010:p1308:b001:l030","ordinal":56696,"en":"Aibanboz must have stopped moving."},{"id":"manas-2010:p1308:b001:l031","ordinal":56697,"en":"Upon the warrior Manas’s head,"},{"id":"manas-2010:p1308:b001:l032","ordinal":56698,"en":"The Chinese, sweeping over him like a flood,"},{"id":"manas-2010:p1308:b001:l033","ordinal":56699,"en":"Must have brought the Last Day."},{"id":"manas-2010:p1308:b001:l034","ordinal":56700,"en":"From the dream I saw last night,"},{"id":"manas-2010:p1308:b001:l035","ordinal":56701,"en":"If my feeling is right, has he died?"},{"id":"manas-2010:p1308:b001:l036","ordinal":56702,"en":"Even if the warrior Manas has not died,"},{"id":"manas-2010:p1308:b001:l037","ordinal":56703,"en":"He must be as good as dead."},{"id":"manas-2010:p1308:b001:l038","ordinal":56704,"en":"What can I tell you, dear Ajybai,"},{"id":"manas-2010:p1308:b001:l039","ordinal":56705,"en":"If we lose the warrior Manas..."},{"id":"manas-2010:p1308:b001:l040","ordinal":56706,"en":"Grant us a time of goodness!"},{"id":"manas-2010:p1308:b001:l041","ordinal":56707,"en":"If God ever created a living soul,"},{"id":"manas-2010:p1308:b001:l042","ordinal":56708,"en":"He was a lion born a leopard,"},{"id":"manas-2010:p1309:b001:l001","ordinal":56709,"en":"God, keep Manas safe!"},{"id":"manas-2010:p1309:b001:l002","ordinal":56710,"en":"The reason I was frightened so,"},{"id":"manas-2010:p1309:b001:l003","ordinal":56711,"en":"The grief I have to tell:"},{"id":"manas-2010:p1309:b001:l004","ordinal":56712,"en":"Great Beijing, to which he journeyed,"},{"id":"manas-2010:p1309:b001:l005","ordinal":56713,"en":"They call a fortified ridge,"},{"id":"manas-2010:p1309:b001:l006","ordinal":56714,"en":"Not conquered by just anyone,"},{"id":"manas-2010:p1309:b001:l007","ordinal":56715,"en":"A people whole from ancient times."},{"id":"manas-2010:p1309:b001:l008","ordinal":56716,"en":"No soul who went there returned;"},{"id":"manas-2010:p1309:b001:l009","ordinal":56717,"en":"They call it a land of no return."},{"id":"manas-2010:p1309:b001:l010","ordinal":56718,"en":"That he has come from so far away,"},{"id":"manas-2010:p1309:b001:l011","ordinal":56719,"en":"Shrouded in red dust,"},{"id":"manas-2010:p1309:b001:l012","ordinal":56720,"en":"Kartküröng beneath him,"},{"id":"manas-2010:p1309:b001:l013","ordinal":56721,"en":"That he came fleeing yesterday—"},{"id":"manas-2010:p1309:b001:l014","ordinal":56722,"en":"Is it not an evil omen?"},{"id":"manas-2010:p1309:b001:l015","ordinal":56723,"en":"Now, Ajybay, prepare!"},{"id":"manas-2010:p1309:b001:l016","ordinal":56724,"en":"Set your appointed time close to dawn."},{"id":"manas-2010:p1309:b001:l017","ordinal":56725,"en":"From among the forty companions,"},{"id":"manas-2010:p1309:b001:l018","ordinal":56726,"en":"Choose men to accompany you."},{"id":"manas-2010:p1309:b001:l019","ordinal":56727,"en":"Take a brave man who will not hold back;"},{"id":"manas-2010:p1309:b001:l020","ordinal":56728,"en":"My Ajybay, heed my words!"},{"id":"manas-2010:p1309:b001:l021","ordinal":56729,"en":"Go yourself without delay."},{"id":"manas-2010:p1309:b001:l022","ordinal":56730,"en":"Put on Chinese clothing;"},{"id":"manas-2010:p1309:b001:l023","ordinal":56731,"en":"Manas, my companion till Judgment Day,"},{"id":"manas-2010:p1309:b001:l024","ordinal":56732,"en":"Learn where he is!’"},{"id":"manas-2010:p1309:b001:l025","ordinal":56733,"en":"He knew seventy different tongues;"},{"id":"manas-2010:p1309:b001:l026","ordinal":56734,"en":"You were accomplished, Ajybay,"},{"id":"manas-2010:p1309:b001:l027","ordinal":56735,"en":"Who sharpened his eloquent tongue,"},{"id":"manas-2010:p1309:b001:l028","ordinal":56736,"en":"Who sang out before the khan."},{"id":"manas-2010:p1309:b001:l029","ordinal":56737,"en":"Broad of jaw, broad of tongue,"},{"id":"manas-2010:p1309:b001:l030","ordinal":56738,"en":"Accomplished orator Ajybay,"},{"id":"manas-2010:p1309:b001:l031","ordinal":56739,"en":"When Bakay spoke like this,"},{"id":"manas-2010:p1309:b001:l032","ordinal":56740,"en":"Would your hero Ajy stand idle?"},{"id":"manas-2010:p1309:b001:l033","ordinal":56741,"en":"His thoughts undivided by a hair,"},{"id":"manas-2010:p1309:b001:l034","ordinal":56742,"en":"His life valued less than a hair,"},{"id":"manas-2010:p1309:b001:l035","ordinal":56743,"en":"His eyes not closing for sleep,"},{"id":"manas-2010:p1309:b001:l036","ordinal":56744,"en":"To that immense, vast army,"},{"id":"manas-2010:p1309:b001:l037","ordinal":56745,"en":"To not a single man known,"},{"id":"manas-2010:p1309:b001:l038","ordinal":56746,"en":"Baabedin Khan's son,"},{"id":"manas-2010:p1309:b001:l039","ordinal":56747,"en":"Baychoro, born a hero,"},{"id":"manas-2010:p1309:b001:l040","ordinal":56748,"en":"Baychoro and the Singer's Son,"},{"id":"manas-2010:p1309:b001:l041","ordinal":56749,"en":"Taking them along as companions,"},{"id":"manas-2010:p1309:b001:l042","ordinal":56750,"en":"Hero Manas's Akkula,"},{"id":"manas-2010:p1310:b001:l001","ordinal":56751,"en":"Having fastened a soft-leather halter,"},{"id":"manas-2010:p1310:b001:l002","ordinal":56752,"en":"Do not miss the bullet"},{"id":"manas-2010:p1310:b001:l003","ordinal":56753,"en":"He had covered with precious cloth."},{"id":"manas-2010:p1310:b001:l004","ordinal":56754,"en":"The white padded armor and Akkelte,"},{"id":"manas-2010:p1310:b001:l005","ordinal":56755,"en":"He had loaded together upon the steed."},{"id":"manas-2010:p1310:b001:l006","ordinal":56756,"en":"Without lying down to sleep his fill,"},{"id":"manas-2010:p1310:b001:l007","ordinal":56757,"en":"Having Baychoro lead him alongside,"},{"id":"manas-2010:p1310:b001:l008","ordinal":56758,"en":"Ajybay set off."},{"id":"manas-2010:p1310:b001:l009","ordinal":56759,"en":"Leading Akkula,"},{"id":"manas-2010:p1310:b001:l010","ordinal":56760,"en":"To bring him to the Magnanimous One,"},{"id":"manas-2010:p1310:b001:l011","ordinal":56761,"en":"There Ajybay took his road."},{"id":"manas-2010:p1310:b001:l012","ordinal":56762,"en":"When Ajy mounted and set out,"},{"id":"manas-2010:p1310:b001:l013","ordinal":56763,"en":"Ajybay came out to intercept."},{"id":"manas-2010:p1310:b001:l014","ordinal":56764,"en":"Girding himself for the venture,"},{"id":"manas-2010:p1310:b001:l015","ordinal":56765,"en":"Hero Bakay did not stop."},{"id":"manas-2010:p1310:b001:l016","ordinal":56766,"en":"Toward the pale curved crest of the hill,"},{"id":"manas-2010:p1310:b001:l017","ordinal":56767,"en":"He turned his horse's head."},{"id":"manas-2010:p1310:b001:l018","ordinal":56768,"en":"Buurul-Tün of Chöngörlüü,"},{"id":"manas-2010:p1310:b001:l019","ordinal":56769,"en":"He stood looking toward it."},{"id":"manas-2010:p1310:b001:l020","ordinal":56770,"en":"Standing watching, Khan Bakay,"},{"id":"manas-2010:p1310:b001:l021","ordinal":56771,"en":"Not ceasing in his anxiety,"},{"id":"manas-2010:p1310:b001:l022","ordinal":56772,"en":"Saw Syrgak's distant shape."},{"id":"manas-2010:p1310:b001:l023","ordinal":56773,"en":"Roaring in anger,"},{"id":"manas-2010:p1310:b001:l024","ordinal":56774,"en":"To Ajybay beside him,"},{"id":"manas-2010:p1310:b001:l025","ordinal":56775,"en":"Calling, ‘My companion in soul!’"},{"id":"manas-2010:p1310:b001:l026","ordinal":56776,"en":"‘Champion Ajy, my renowned one,"},{"id":"manas-2010:p1310:b001:l027","ordinal":56777,"en":"My distinguished one among the renowned people!"},{"id":"manas-2010:p1310:b001:l028","ordinal":56778,"en":"Have you seen what I have seen?"},{"id":"manas-2010:p1310:b001:l029","ordinal":56779,"en":"Have you understood what I have understood?’"},{"id":"manas-2010:p1310:b001:l030","ordinal":56780,"en":"‘No, my tiger Bakay!"},{"id":"manas-2010:p1310:b001:l031","ordinal":56781,"en":"I have not understood what you have;"},{"id":"manas-2010:p1310:b001:l032","ordinal":56782,"en":"I have not seen what you have!"},{"id":"manas-2010:p1310:b001:l033","ordinal":56783,"en":"To this wretch's eyes,"},{"id":"manas-2010:p1310:b001:l034","ordinal":56784,"en":"Things look blurred."},{"id":"manas-2010:p1310:b001:l035","ordinal":56785,"en":"Drinking water in the dark,"},{"id":"manas-2010:p1310:b001:l036","ordinal":56786,"en":"It has reached my eyes."},{"id":"manas-2010:p1310:b001:l037","ordinal":56787,"en":"To this doomed man's eyes,"},{"id":"manas-2010:p1310:b001:l038","ordinal":56788,"en":"Things look dark."},{"id":"manas-2010:p1310:b001:l039","ordinal":56789,"en":"Nothing at all can be made out."},{"id":"manas-2010:p1310:b001:l040","ordinal":56790,"en":"Riding so much by night and day,"},{"id":"manas-2010:p1310:b001:l041","ordinal":56791,"en":"The strength of my eyes has gone.’"},{"id":"manas-2010:p1310:b001:l042","ordinal":56792,"en":"Then Bakay said:"},{"id":"manas-2010:p1311:b001:l001","ordinal":56793,"en":"‘If you see nothing at all,"},{"id":"manas-2010:p1311:b001:l002","ordinal":56794,"en":"Before us is Buurul-Tün."},{"id":"manas-2010:p1311:b001:l003","ordinal":56795,"en":"Along Buurul-Tün,"},{"id":"manas-2010:p1311:b001:l004","ordinal":56796,"en":"Upon Chöngörlüü's ridge,"},{"id":"manas-2010:p1311:b001:l005","ordinal":56797,"en":"Dust rises in repeated bursts."},{"id":"manas-2010:p1311:b001:l006","ordinal":56798,"en":"Thinking of it, my Ajy, my soul departs."},{"id":"manas-2010:p1311:b001:l007","ordinal":56799,"en":"If you watch the rising dust,"},{"id":"manas-2010:p1311:b001:l008","ordinal":56800,"en":"It is Kökchebich's dust."},{"id":"manas-2010:p1311:b001:l009","ordinal":56801,"en":"The rider upon him"},{"id":"manas-2010:p1311:b001:l010","ordinal":56802,"en":"Is young champion Syrgak."},{"id":"manas-2010:p1311:b001:l011","ordinal":56803,"en":"Has Alöökö's son Kongurbay"},{"id":"manas-2010:p1311:b001:l012","ordinal":56804,"en":"Inflicted torment and humiliation?"},{"id":"manas-2010:p1311:b001:l013","ordinal":56805,"en":"If he had his way, dear Syrgak—"},{"id":"manas-2010:p1311:b001:l014","ordinal":56806,"en":"Has he been left wounded?"},{"id":"manas-2010:p1311:b001:l015","ordinal":56807,"en":"Look carefully, Ajybay!"},{"id":"manas-2010:p1311:b001:l016","ordinal":56808,"en":"At times he can be seen;"},{"id":"manas-2010:p1311:b001:l017","ordinal":56809,"en":"When he cannot, a long trail"},{"id":"manas-2010:p1311:b001:l018","ordinal":56810,"en":"Spreads out as blue smoke."},{"id":"manas-2010:p1311:b001:l019","ordinal":56811,"en":"His neck bending like a mountain sheep's,"},{"id":"manas-2010:p1311:b001:l020","ordinal":56812,"en":"Bounding like a roe deer,"},{"id":"manas-2010:p1311:b001:l021","ordinal":56813,"en":"He has lowered his head to the earth."},{"id":"manas-2010:p1311:b001:l022","ordinal":56814,"en":"Kökchebich, who has known haste,"},{"id":"manas-2010:p1311:b001:l023","ordinal":56815,"en":"Has grown hot in the body."},{"id":"manas-2010:p1311:b001:l024","ordinal":56816,"en":"Once Kökchebich is heated,"},{"id":"manas-2010:p1311:b001:l025","ordinal":56817,"en":"No soul can draw level with him."},{"id":"manas-2010:p1311:b001:l026","ordinal":56818,"en":"Unless we trick him and catch him,"},{"id":"manas-2010:p1311:b001:l027","ordinal":56819,"en":"No beast can catch that creature."},{"id":"manas-2010:p1311:b001:l028","ordinal":56820,"en":"Syrgak upon him"},{"id":"manas-2010:p1311:b001:l029","ordinal":56821,"en":"Has no stain in his heart."},{"id":"manas-2010:p1311:b001:l030","ordinal":56822,"en":"He was a blustering fellow,"},{"id":"manas-2010:p1311:b001:l031","ordinal":56823,"en":"Knowing not a hair of deceit,"},{"id":"manas-2010:p1311:b001:l032","ordinal":56824,"en":"An open-hearted man."},{"id":"manas-2010:p1311:b001:l033","ordinal":56825,"en":"“Manas lies bound,”"},{"id":"manas-2010:p1311:b001:l034","ordinal":56826,"en":"If by chance he blurts it out,"},{"id":"manas-2010:p1311:b001:l035","ordinal":56827,"en":"The Muslims who barely reached here,"},{"id":"manas-2010:p1311:b001:l036","ordinal":56828,"en":"Saying, “Die a thousand times rather than once,”"},{"id":"manas-2010:p1311:b001:l037","ordinal":56829,"en":"May they not cross Kezeng-Bel,"},{"id":"manas-2010:p1311:b001:l038","ordinal":56830,"en":"Of the Ogoy and Kyrgyz in Talas,"},{"id":"manas-2010:p1311:b001:l039","ordinal":56831,"en":"Plundering their herds and possessions,"},{"id":"manas-2010:p1311:b001:l040","ordinal":56832,"en":"May they not flee to their own land!"}]
