[{"id":"semetey-1-2013:p1145:b003:l038","ordinal":163585,"en":"“Bloodthirsty lion, Manas the leopard,"},{"id":"semetey-1-2013:p1145:b003:l039","ordinal":163586,"en":"Do you see how grass grows on the slope?"},{"id":"semetey-1-2013:p1145:b005:l001","ordinal":163587,"en":"The infidel people are many."},{"id":"semetey-1-2013:p1145:b005:l002","ordinal":163588,"en":"The grass on the upland is sparse;"},{"id":"semetey-1-2013:p1145:b005:l003","ordinal":163589,"en":"The Muslim people are few."},{"id":"semetey-1-2013:p1145:b005:l004","ordinal":163590,"en":"The raging Zholoy and Kongurbai"},{"id":"semetey-1-2013:p1145:b005:l005","ordinal":163591,"en":"May seize the plunder,"},{"id":"semetey-1-2013:p1145:b005:l006","ordinal":163592,"en":"And bring devastation upon us."},{"id":"semetey-1-2013:p1145:b005:l007","ordinal":163593,"en":"Kökötöy's livestock was driven in crowds"},{"id":"semetey-1-2013:p1145:b005:l008","ordinal":163594,"en":"From Tashkent."},{"id":"semetey-1-2013:p1145:b005:l009","ordinal":163595,"en":"Coming to hold the feast,"},{"id":"semetey-1-2013:p1145:b005:l010","ordinal":163596,"en":"The renowned boy Bokmurun"},{"id":"semetey-1-2013:p1145:b005:l011","ordinal":163597,"en":"Has become badly entangled in trouble."},{"id":"semetey-1-2013:p1145:b005:l012","ordinal":163598,"en":"Making merry to hold the feast,"},{"id":"semetey-1-2013:p1145:b005:l013","ordinal":163599,"en":"Perhaps Bokmurun cast havoc"},{"id":"semetey-1-2013:p1145:b005:l014","ordinal":163600,"en":"Upon his great wealth."},{"id":"semetey-1-2013:p1145:b005:l015","ordinal":163601,"en":"Ah, my colt Khan Manas,"},{"id":"semetey-1-2013:p1145:b005:l016","ordinal":163602,"en":"There are the people of Kakanchyn,"},{"id":"semetey-1-2013:p1145:b005:l017","ordinal":163603,"en":"And the wrathful Kalcha, the formidable one,"},{"id":"semetey-1-2013:p1145:b005:l018","ordinal":163604,"en":"Whose custom is to drink the blood"},{"id":"semetey-1-2013:p1145:b005:l019","ordinal":163605,"en":"Of anyone who attacks him."},{"id":"semetey-1-2013:p1145:b005:l020","ordinal":163606,"en":"Here are the people of Chynmachyn,"},{"id":"semetey-1-2013:p1145:b005:l021","ordinal":163607,"en":"The bridle-haired Kalmyks,"},{"id":"semetey-1-2013:p1145:b005:l022","ordinal":163608,"en":"Ready to contend with us."},{"id":"semetey-1-2013:p1145:b005:l023","ordinal":163609,"en":"I know the truth of Beijing:"},{"id":"semetey-1-2013:p1145:b005:l024","ordinal":163610,"en":"Long ago, in the prophet Noah's time,"},{"id":"semetey-1-2013:p1145:b005:l025","ordinal":163611,"en":"The flood passed here."},{"id":"semetey-1-2013:p1145:b005:l026","ordinal":163612,"en":"When the floodwaters surged and overflowed,"},{"id":"semetey-1-2013:p1145:b005:l027","ordinal":163613,"en":"Their waves did not reach Beijing,"},{"id":"semetey-1-2013:p1145:b005:l028","ordinal":163614,"en":"And six hundred households remained."},{"id":"semetey-1-2013:p1145:b005:l029","ordinal":163615,"en":"Receiving a blessing from a holy elder,"},{"id":"semetey-1-2013:p1145:b005:l030","ordinal":163616,"en":"Because they survived,"},{"id":"semetey-1-2013:p1145:b005:l031","ordinal":163617,"en":"They were called Esenkhan."},{"id":"semetey-1-2013:p1145:b005:l032","ordinal":163618,"en":"Of Kakanchyn's forty gates,"},{"id":"semetey-1-2013:p1145:b005:l033","ordinal":163619,"en":"One gate was never closed"},{"id":"semetey-1-2013:p1145:b005:l034","ordinal":163620,"en":"And opened toward Mecca."},{"id":"semetey-1-2013:p1145:b005:l035","ordinal":163621,"en":"Upon that gate"},{"id":"semetey-1-2013:p1145:b005:l036","ordinal":163622,"en":"Were written the names"},{"id":"semetey-1-2013:p1145:b005:l037","ordinal":163623,"en":"Of the white prophet Mustafa and Muhammad,"},{"id":"semetey-1-2013:p1145:b005:l038","ordinal":163624,"en":"Lest a devil should strike"},{"id":"semetey-1-2013:p1145:b005:l039","ordinal":163625,"en":"The mere handful of Muslims."},{"id":"semetey-1-2013:p1146:b003:l001","ordinal":163626,"en":"Upon Beijing of Kakanchyn,"},{"id":"semetey-1-2013:p1146:b003:l002","ordinal":163627,"en":"God's seed was scattered."},{"id":"semetey-1-2013:p1146:b003:l003","ordinal":163628,"en":"Seed poured upon Beijing;"},{"id":"semetey-1-2013:p1146:b003:l004","ordinal":163629,"en":"His Holiness Ali the lion"},{"id":"semetey-1-2013:p1146:b003:l005","ordinal":163630,"en":"Turned back from great Beijing."},{"id":"semetey-1-2013:p1146:b003:l006","ordinal":163631,"en":"There is no great faith here."},{"id":"semetey-1-2013:p1146:b003:l007","ordinal":163632,"en":"Truly, God favored us;"},{"id":"semetey-1-2013:p1146:b003:l008","ordinal":163633,"en":"We have remained in their midst."},{"id":"semetey-1-2013:p1146:b003:l009","ordinal":163634,"en":"Such filth is this world;"},{"id":"semetey-1-2013:p1146:b003:l010","ordinal":163635,"en":"The breast holds many sorrows."},{"id":"semetey-1-2013:p1146:b003:l011","ordinal":163636,"en":"We have come and attacked a numerous people;"},{"id":"semetey-1-2013:p1146:b003:l012","ordinal":163637,"en":"Such is this treacherous false world."},{"id":"semetey-1-2013:p1146:b003:l013","ordinal":163638,"en":"Of the sons of Muslims,"},{"id":"semetey-1-2013:p1146:b003:l014","ordinal":163639,"en":"Exactly a thousand souls remain."},{"id":"semetey-1-2013:p1146:b003:l015","ordinal":163640,"en":"Taking wives from the Chinese,"},{"id":"semetey-1-2013:p1146:b003:l016","ordinal":163641,"en":"There remains Turkan;"},{"id":"semetey-1-2013:p1146:b003:l017","ordinal":163642,"en":"If you ask, you will find him,"},{"id":"semetey-1-2013:p1146:b003:l018","ordinal":163643,"en":"The true Muslim Turdana."},{"id":"semetey-1-2013:p1146:b003:l019","ordinal":163644,"en":"If we lament, great sorrow comes forth;"},{"id":"semetey-1-2013:p1146:b003:l020","ordinal":163645,"en":"If you ask, you will find"},{"id":"semetey-1-2013:p1146:b003:l021","ordinal":163646,"en":"True Kyrgyz descendants"},{"id":"semetey-1-2013:p1146:b003:l022","ordinal":163647,"en":"In Beijing of Kakanchyn,"},{"id":"semetey-1-2013:p1146:b003:l023","ordinal":163648,"en":"A people called Salaalyk."},{"id":"semetey-1-2013:p1146:b003:l024","ordinal":163649,"en":"Calling it Kökötöy's feast,"},{"id":"semetey-1-2013:p1146:b003:l025","ordinal":163650,"en":"We have come to the feast;"},{"id":"semetey-1-2013:p1146:b003:l026","ordinal":163651,"en":"If quarrels arise, we have come"},{"id":"semetey-1-2013:p1146:b003:l027","ordinal":163652,"en":"To meet what falls upon our heads."},{"id":"semetey-1-2013:p1146:b003:l028","ordinal":163653,"en":"We have come to see"},{"id":"semetey-1-2013:p1146:b003:l029","ordinal":163654,"en":"Kökötöy's festive feast;"},{"id":"semetey-1-2013:p1146:b003:l030","ordinal":163655,"en":"We have come to be plundered"},{"id":"semetey-1-2013:p1146:b003:l031","ordinal":163656,"en":"And die at the hands of the Black Chinese."},{"id":"semetey-1-2013:p1146:b003:l032","ordinal":163657,"en":"We have come to give our inheritance"},{"id":"semetey-1-2013:p1146:b003:l033","ordinal":163658,"en":"To the Enchi-Kuyun Kalmyks."},{"id":"semetey-1-2013:p1146:b003:l034","ordinal":163659,"en":"Heeding Köpkölöng's words,"},{"id":"semetey-1-2013:p1146:b003:l035","ordinal":163660,"en":"We have come here to die."},{"id":"semetey-1-2013:p1146:b003:l036","ordinal":163661,"en":"While my beard is white as a swan,"},{"id":"semetey-1-2013:p1146:b003:l037","ordinal":163662,"en":"While my journey's end is near,"},{"id":"semetey-1-2013:p1146:b003:l038","ordinal":163663,"en":"God has struck the Burut,"},{"id":"semetey-1-2013:p1146:b003:l039","ordinal":163664,"en":"For they stand trembling against us."},{"id":"semetey-1-2013:p1146:b004:l001","ordinal":163665,"en":"When my time has passed,"},{"id":"semetey-1-2013:p1146:b004:l002","ordinal":163666,"en":"God has struck the Chinese,"},{"id":"semetey-1-2013:p1146:b004:l003","ordinal":163667,"en":"For they stand opposing us."},{"id":"semetey-1-2013:p1146:b004:l004","ordinal":163668,"en":"The swaggering Kalcha, the formidable one—"},{"id":"semetey-1-2013:p1146:b004:l005","ordinal":163669,"en":"If his strength suffices, these Chinese"},{"id":"semetey-1-2013:p1146:b004:l006","ordinal":163670,"en":"Have the power to fight."},{"id":"semetey-1-2013:p1146:b004:l007","ordinal":163671,"en":"Among the seething infidels,"},{"id":"semetey-1-2013:p1146:b004:l008","ordinal":163672,"en":"With heroic Khan Kongurbai,"},{"id":"semetey-1-2013:p1146:b004:l009","ordinal":163673,"en":"There are those who know no human tongue,"},{"id":"semetey-1-2013:p1146:b004:l010","ordinal":163674,"en":"Whose words resemble beasts' cries."},{"id":"semetey-1-2013:p1146:b004:l011","ordinal":163675,"en":"There is a mountain-like cyclops"},{"id":"semetey-1-2013:p1146:b004:l012","ordinal":163676,"en":"Who crushes anyone beside him."},{"id":"semetey-1-2013:p1146:b004:l013","ordinal":163677,"en":"They have heroes of many kinds"},{"id":"semetey-1-2013:p1146:b004:l014","ordinal":163678,"en":"And revenge for their fathers."},{"id":"semetey-1-2013:p1146:b004:l015","ordinal":163679,"en":"If they find the chance,"},{"id":"semetey-1-2013:p1146:b004:l016","ordinal":163680,"en":"They have reason to fight us."},{"id":"semetey-1-2013:p1146:b004:l017","ordinal":163681,"en":"The bellowing infidels"},{"id":"semetey-1-2013:p1146:b004:l018","ordinal":163682,"en":"Have armor no bullet pierces;"},{"id":"semetey-1-2013:p1146:b004:l019","ordinal":163683,"en":"Think of their dagger-men."},{"id":"semetey-1-2013:p1146:b004:l020","ordinal":163684,"en":"The infidels came in strength,"},{"id":"semetey-1-2013:p1146:b004:l021","ordinal":163685,"en":"Their waists girded with resolve."},{"id":"semetey-1-2013:p1146:b004:l022","ordinal":163686,"en":"They have heroes held in readiness,"},{"id":"semetey-1-2013:p1146:b004:l023","ordinal":163687,"en":"Ready to cause disaster"},{"id":"semetey-1-2013:p1146:b004:l024","ordinal":163688,"en":"And confront us at this feast."},{"id":"semetey-1-2013:p1146:b004:l025","ordinal":163689,"en":"Without quarreling or disputing,"},{"id":"semetey-1-2013:p1146:b004:l026","ordinal":163690,"en":"Let us consent to their demand"},{"id":"semetey-1-2013:p1146:b004:l027","ordinal":163691,"en":"And present them Maaniker."},{"id":"semetey-1-2013:p1146:b004:l028","ordinal":163692,"en":"Let us deceive them with the horse;"},{"id":"semetey-1-2013:p1146:b004:l029","ordinal":163693,"en":"Let us find this solution.”"},{"id":"semetey-1-2013:p1146:b004:l030","ordinal":163694,"en":"Your uncle Koshoy honked loudly"},{"id":"semetey-1-2013:p1146:b004:l031","ordinal":163695,"en":"And offered these words."},{"id":"semetey-1-2013:p1146:b004:l032","ordinal":163696,"en":"After him Bokmurun"},{"id":"semetey-1-2013:p1146:b004:l033","ordinal":163697,"en":"Joined in and said:"},{"id":"semetey-1-2013:p1146:b004:l034","ordinal":163698,"en":"“They gathered and came to my feast,"},{"id":"semetey-1-2013:p1146:b004:l035","ordinal":163699,"en":"And struck my head with a club;"},{"id":"semetey-1-2013:p1146:b004:l036","ordinal":163700,"en":"They trampled my wishes"},{"id":"semetey-1-2013:p1146:b004:l037","ordinal":163701,"en":"And used force at my feast."},{"id":"semetey-1-2013:p1146:b004:l038","ordinal":163702,"en":"If we do not consent to their demand,"},{"id":"semetey-1-2013:p1146:b004:l039","ordinal":163703,"en":"Perhaps they will seize all the plunder,"},{"id":"semetey-1-2013:p1147:b003:l001","ordinal":163704,"en":"Perhaps they will bring harsh devastation,"},{"id":"semetey-1-2013:p1147:b003:l002","ordinal":163705,"en":"Overrun the village now,"},{"id":"semetey-1-2013:p1147:b003:l003","ordinal":163706,"en":"And scatter the white-gold goods."},{"id":"semetey-1-2013:p1147:b003:l004","ordinal":163707,"en":"Perhaps we will all meet our end;"},{"id":"semetey-1-2013:p1147:b003:l005","ordinal":163708,"en":"Why did we give this exhausting feast?"},{"id":"semetey-1-2013:p1147:b003:l006","ordinal":163709,"en":"Perhaps they will plunder everything."},{"id":"semetey-1-2013:p1147:b003:l007","ordinal":163710,"en":"Here is the feast if you want its spectacle;"},{"id":"semetey-1-2013:p1147:b003:l008","ordinal":163711,"en":"Saying, “You have done wrong,”"},{"id":"semetey-1-2013:p1147:b003:l009","ordinal":163712,"en":"Here is my head if you cut it off."},{"id":"semetey-1-2013:p1147:b003:l010","ordinal":163713,"en":"They have brought disaster to my house"},{"id":"semetey-1-2013:p1147:b003:l011","ordinal":163714,"en":"And will utterly end my line."},{"id":"semetey-1-2013:p1147:b003:l012","ordinal":163715,"en":"It was livestock left by my father;"},{"id":"semetey-1-2013:p1147:b003:l013","ordinal":163716,"en":"These Chinese are demanding"},{"id":"semetey-1-2013:p1147:b003:l014","ordinal":163717,"en":"The swift horse Maaniker."},{"id":"semetey-1-2013:p1147:b003:l015","ordinal":163718,"en":"If I do not give Maaniker,"},{"id":"semetey-1-2013:p1147:b003:l016","ordinal":163719,"en":"They stand ready to cause turmoil.”"},{"id":"semetey-1-2013:p1147:b003:l017","ordinal":163720,"en":"Bokmurun came weeping"},{"id":"semetey-1-2013:p1147:b003:l018","ordinal":163721,"en":"And presented Manas"},{"id":"semetey-1-2013:p1147:b003:l019","ordinal":163722,"en":"Kökötöy's great ingot, large as a bucket."},{"id":"semetey-1-2013:p1147:b003:l020","ordinal":163723,"en":"It was a great ingot."},{"id":"semetey-1-2013:p1147:b003:l021","ordinal":163724,"en":"Manas accepted the gift"},{"id":"semetey-1-2013:p1147:b003:l022","ordinal":163725,"en":"And handed it to his uncle Bakai."},{"id":"semetey-1-2013:p1147:b003:l023","ordinal":163726,"en":"His thirst for blood seized him strongly,"},{"id":"semetey-1-2013:p1147:b003:l024","ordinal":163727,"en":"And he said to Koshoy:"},{"id":"semetey-1-2013:p1147:b003:l025","ordinal":163728,"en":"“Your life has grown long;"},{"id":"semetey-1-2013:p1147:b003:l026","ordinal":163729,"en":"You have become querulous."},{"id":"semetey-1-2013:p1147:b003:l027","ordinal":163730,"en":"Strength has left your body,"},{"id":"semetey-1-2013:p1147:b003:l028","ordinal":163731,"en":"And you have grown weary."},{"id":"semetey-1-2013:p1147:b003:l029","ordinal":163732,"en":"When the Black Kalmyks pressed you,"},{"id":"semetey-1-2013:p1147:b003:l030","ordinal":163733,"en":"You have come to nothing."},{"id":"semetey-1-2013:p1147:b003:l031","ordinal":163734,"en":"Power has left your body;"},{"id":"semetey-1-2013:p1147:b003:l032","ordinal":163735,"en":"Your body has lost its power."},{"id":"semetey-1-2013:p1147:b003:l033","ordinal":163736,"en":"You have become useless."},{"id":"semetey-1-2013:p1147:b003:l034","ordinal":163737,"en":"These Chinese act as tyrants;"},{"id":"semetey-1-2013:p1147:b003:l035","ordinal":163738,"en":"I have no time to lie in the uplands."},{"id":"semetey-1-2013:p1147:b003:l036","ordinal":163739,"en":"If these Chinese bluster,"},{"id":"semetey-1-2013:p1147:b003:l037","ordinal":163740,"en":"I have no life I would spare from death."},{"id":"semetey-1-2013:p1147:b003:l038","ordinal":163741,"en":"While my dear soul lives,"},{"id":"semetey-1-2013:p1147:b003:l039","ordinal":163742,"en":"I have no livestock to offer the Chinese,"},{"id":"semetey-1-2013:p1147:b005:l001","ordinal":163743,"en":"And no time to give Maaniker."},{"id":"semetey-1-2013:p1147:b005:l002","ordinal":163744,"en":"If your infidels scowl,"},{"id":"semetey-1-2013:p1147:b005:l003","ordinal":163745,"en":"I have no soul that will shrink back."},{"id":"semetey-1-2013:p1147:b005:l004","ordinal":163746,"en":"Sense has fled your body;"},{"id":"semetey-1-2013:p1147:b005:l005","ordinal":163747,"en":"You have come to nothing."},{"id":"semetey-1-2013:p1147:b005:l006","ordinal":163748,"en":"Your courage has gone with age;"},{"id":"semetey-1-2013:p1147:b005:l007","ordinal":163749,"en":"Dear uncle and leopard,"},{"id":"semetey-1-2013:p1147:b005:l008","ordinal":163750,"en":"You have become useless."},{"id":"semetey-1-2013:p1147:b005:l009","ordinal":163751,"en":"If the Chinese scowl in anger"},{"id":"semetey-1-2013:p1147:b005:l010","ordinal":163752,"en":"And take Maaniker today,"},{"id":"semetey-1-2013:p1147:b005:l011","ordinal":163753,"en":"Growing insolent tomorrow,"},{"id":"semetey-1-2013:p1147:b005:l012","ordinal":163754,"en":"Will they not take Akkula too?"},{"id":"semetey-1-2013:p1147:b005:l013","ordinal":163755,"en":"Will they not add him as well?"},{"id":"semetey-1-2013:p1147:b005:l014","ordinal":163756,"en":"The following day they may come"},{"id":"semetey-1-2013:p1147:b005:l015","ordinal":163757,"en":"And take in the same way"},{"id":"semetey-1-2013:p1147:b005:l016","ordinal":163758,"en":"Many leopard-like racehorses."},{"id":"semetey-1-2013:p1147:b005:l017","ordinal":163759,"en":"Those many swift horses."},{"id":"semetey-1-2013:p1147:b005:l018","ordinal":163760,"en":"Will they not strip away the swift horses?"},{"id":"semetey-1-2013:p1147:b005:l019","ordinal":163761,"en":"When we are left on foot and downcast,"},{"id":"semetey-1-2013:p1147:b005:l020","ordinal":163762,"en":"Will they not bring hell every day?"},{"id":"semetey-1-2013:p1147:b005:l021","ordinal":163763,"en":"If we are parted from our racehorses,"},{"id":"semetey-1-2013:p1147:b005:l022","ordinal":163764,"en":"Will the Muslim giants not"},{"id":"semetey-1-2013:p1147:b005:l023","ordinal":163765,"en":"Carry their saddles on their backs"},{"id":"semetey-1-2013:p1147:b005:l024","ordinal":163766,"en":"And suffer bitter hardship?"},{"id":"semetey-1-2013:p1147:b005:l025","ordinal":163767,"en":"Will they not suffer?"},{"id":"semetey-1-2013:p1147:b005:l026","ordinal":163768,"en":"Will the Chinese not do as they please?"},{"id":"semetey-1-2013:p1147:b005:l027","ordinal":163769,"en":"Will God not strike us thus,"},{"id":"semetey-1-2013:p1147:b005:l028","ordinal":163770,"en":"And will they not drive us on foot and kill us?"},{"id":"semetey-1-2013:p1147:b005:l029","ordinal":163771,"en":"The seething infidels"},{"id":"semetey-1-2013:p1147:b005:l030","ordinal":163772,"en":"Will part you from your horses"},{"id":"semetey-1-2013:p1147:b005:l031","ordinal":163773,"en":"And scatter all four kinds of livestock;"},{"id":"semetey-1-2013:p1147:b005:l032","ordinal":163774,"en":"Will they not dig a well in your place of honor?"},{"id":"semetey-1-2013:p1147:b005:l033","ordinal":163775,"en":"Will they not bind your heroes?"},{"id":"semetey-1-2013:p1147:b005:l034","ordinal":163776,"en":"Once left helpless on foot,"},{"id":"semetey-1-2013:p1147:b005:l035","ordinal":163777,"en":"Will they not bring calamity?"},{"id":"semetey-1-2013:p1147:b005:l036","ordinal":163778,"en":"Will the Chinese not do as they please"},{"id":"semetey-1-2013:p1147:b005:l037","ordinal":163779,"en":"And slaughter every one of you?"},{"id":"semetey-1-2013:p1147:b005:l038","ordinal":163780,"en":"Will they not cross over your flank"},{"id":"semetey-1-2013:p1147:b005:l039","ordinal":163781,"en":"And scatter your great wealth?”"},{"id":"semetey-1-2013:p1148:b003:l001","ordinal":163782,"en":"Would they not all recognize the treachery?"},{"id":"semetey-1-2013:p1148:b003:l002","ordinal":163783,"en":"If we let the Chinese slaughter"},{"id":"semetey-1-2013:p1148:b003:l003","ordinal":163784,"en":"The mere handful of Muslims,"},{"id":"semetey-1-2013:p1148:b003:l004","ordinal":163785,"en":"On the dawn of Judgment Day,"},{"id":"semetey-1-2013:p1148:b003:l005","ordinal":163786,"en":"Will they not ride us like black donkeys?"},{"id":"semetey-1-2013:p1148:b003:l006","ordinal":163787,"en":"One day we will die in the end;"},{"id":"semetey-1-2013:p1148:b003:l007","ordinal":163788,"en":"If the creatures accuse us,"},{"id":"semetey-1-2013:p1148:b003:l008","ordinal":163789,"en":"Saying we surrendered it from fear,"},{"id":"semetey-1-2013:p1148:b003:l009","ordinal":163790,"en":"What answer will we give?"},{"id":"semetey-1-2013:p1148:b003:l010","ordinal":163791,"en":"While I possess robust strength,"},{"id":"semetey-1-2013:p1148:b003:l011","ordinal":163792,"en":"How can I give away my racehorse!"},{"id":"semetey-1-2013:p1148:b003:l012","ordinal":163793,"en":"Let me contend"},{"id":"semetey-1-2013:p1148:b003:l013","ordinal":163794,"en":"With the Chinese gathering strength."},{"id":"semetey-1-2013:p1148:b003:l014","ordinal":163795,"en":"To the Chinese infidels before me,"},{"id":"semetey-1-2013:p1148:b003:l015","ordinal":163796,"en":"While my falcon head remains,"},{"id":"semetey-1-2013:p1148:b003:l016","ordinal":163797,"en":"How can I give my thoroughbred!"},{"id":"semetey-1-2013:p1148:b003:l017","ordinal":163798,"en":"If they commit outright violence,"},{"id":"semetey-1-2013:p1148:b003:l018","ordinal":163799,"en":"Let me grapple with them!"},{"id":"semetey-1-2013:p1148:b003:l019","ordinal":163800,"en":"If the Kalmyks bring disaster,"},{"id":"semetey-1-2013:p1148:b003:l020","ordinal":163801,"en":"I will drive them toward Altai."},{"id":"semetey-1-2013:p1148:b003:l021","ordinal":163802,"en":"Now I will slice the scalp"},{"id":"semetey-1-2013:p1148:b003:l022","ordinal":163803,"en":"Of damned Zholoy!"},{"id":"semetey-1-2013:p1148:b003:l023","ordinal":163804,"en":"The seething Chinese people"},{"id":"semetey-1-2013:p1148:b003:l024","ordinal":163805,"en":"Seem eager for it;"},{"id":"semetey-1-2013:p1148:b003:l025","ordinal":163806,"en":"Let me fight them to the death!"},{"id":"semetey-1-2013:p1148:b003:l026","ordinal":163807,"en":"I will mount Akkula;"},{"id":"semetey-1-2013:p1148:b003:l027","ordinal":163808,"en":"The swine have multiplied,"},{"id":"semetey-1-2013:p1148:b003:l028","ordinal":163809,"en":"And I will drive them as far as Kakan."},{"id":"semetey-1-2013:p1148:b003:l029","ordinal":163810,"en":"Fed full at the feast, these Chinese"},{"id":"semetey-1-2013:p1148:b003:l030","ordinal":163811,"en":"Seem to have grown ravenous."},{"id":"semetey-1-2013:p1148:b003:l031","ordinal":163812,"en":"They seem to have gone mad,"},{"id":"semetey-1-2013:p1148:b003:l032","ordinal":163813,"en":"Becoming men eager to wrestle."},{"id":"semetey-1-2013:p1148:b003:l033","ordinal":163814,"en":"If the Chinese behave like this,"},{"id":"semetey-1-2013:p1148:b003:l034","ordinal":163815,"en":"I will pull out their stopper."},{"id":"semetey-1-2013:p1148:b003:l035","ordinal":163816,"en":"If the dogs start tearing at us,"},{"id":"semetey-1-2013:p1148:b003:l036","ordinal":163817,"en":"I will slaughter them utterly."},{"id":"semetey-1-2013:p1148:b003:l037","ordinal":163818,"en":"I will take the horse"},{"id":"semetey-1-2013:p1148:b003:l038","ordinal":163819,"en":"Of the infidel who acts as tyrant."},{"id":"semetey-1-2013:p1148:b003:l039","ordinal":163820,"en":"If these Chinese act as tyrants,"},{"id":"semetey-1-2013:p1148:b004:l001","ordinal":163821,"en":"I will slaughter them to the last."},{"id":"semetey-1-2013:p1148:b004:l002","ordinal":163822,"en":"If they find warfare pleasing,"},{"id":"semetey-1-2013:p1148:b004:l003","ordinal":163823,"en":"I will slaughter them until they wither."},{"id":"semetey-1-2013:p1148:b004:l004","ordinal":163824,"en":"If this is truly their intent,"},{"id":"semetey-1-2013:p1148:b004:l005","ordinal":163825,"en":"I will remain and trade spears!"},{"id":"semetey-1-2013:p1148:b004:l006","ordinal":163826,"en":"I will first offer warm words:"},{"id":"semetey-1-2013:p1148:b004:l007","ordinal":163827,"en":"‘You came as guests; stop.’"},{"id":"semetey-1-2013:p1148:b004:l008","ordinal":163828,"en":"I will go to the baldheads"},{"id":"semetey-1-2013:p1148:b004:l009","ordinal":163829,"en":"Of the stone-carrying Chinese."},{"id":"semetey-1-2013:p1148:b004:l010","ordinal":163830,"en":"If they do not heed my words,"},{"id":"semetey-1-2013:p1148:b004:l011","ordinal":163831,"en":"I will fight them to destruction.”"},{"id":"semetey-1-2013:p1148:b004:l012","ordinal":163832,"en":"Thus brave Manas spoke,"},{"id":"semetey-1-2013:p1148:b004:l013","ordinal":163833,"en":"His eyes like twilight mist,"},{"id":"semetey-1-2013:p1148:b004:l014","ordinal":163834,"en":"His face like oiled wheat,"},{"id":"semetey-1-2013:p1148:b004:l015","ordinal":163835,"en":"Venom pouring from his face,"},{"id":"semetey-1-2013:p1148:b004:l016","ordinal":163836,"en":"His form like a naked blade."},{"id":"semetey-1-2013:p1148:b004:l017","ordinal":163837,"en":"When seen from the front,"},{"id":"semetey-1-2013:p1148:b004:l018","ordinal":163838,"en":"Your magnanimous Sultan Manas"},{"id":"semetey-1-2013:p1148:b004:l019","ordinal":163839,"en":"Had the dread of a dragon."},{"id":"semetey-1-2013:p1148:b004:l020","ordinal":163840,"en":"When seen from behind,"}]
