[{"id":"semetey-2-2013:p1327:b003:l012","ordinal":288769,"en":"Besides me to receive them."},{"id":"semetey-2-2013:p1327:b003:l013","ordinal":288770,"en":"Leaders of tens and hundreds,"},{"id":"semetey-2-2013:p1327:b003:l014","ordinal":288771,"en":"Leaders of fifties and thousands,"},{"id":"semetey-2-2013:p1327:b003:l015","ordinal":288772,"en":"Divide them and return home;"},{"id":"semetey-2-2013:p1327:b003:l016","ordinal":288773,"en":"Say, ‘My khan gave us aid,’"},{"id":"semetey-2-2013:p1327:b003:l017","ordinal":288774,"en":"And offer thanks to me."},{"id":"semetey-2-2013:p1327:b003:l018","ordinal":288775,"en":"Divide among yourselves as booty"},{"id":"semetey-2-2013:p1327:b003:l019","ordinal":288776,"en":"The countless scattered gold coins;"},{"id":"semetey-2-2013:p1327:b003:l020","ordinal":288777,"en":"Go tell your homeland,"},{"id":"semetey-2-2013:p1327:b003:l021","ordinal":288778,"en":"‘Kanchoro performed a heroic deed.’"},{"id":"semetey-2-2013:p1327:b003:l022","ordinal":288779,"en":"Without quarreling or struggling,"},{"id":"semetey-2-2013:p1327:b003:l023","ordinal":288780,"en":"Find a way to divide"},{"id":"semetey-2-2013:p1327:b003:l024","ordinal":288781,"en":"The hero-khan's vast wealth."},{"id":"semetey-2-2013:p1327:b003:l025","ordinal":288782,"en":"Call me your hero and your lion;"},{"id":"semetey-2-2013:p1327:b003:l026","ordinal":288783,"en":"O Jediger, understand this!"},{"id":"semetey-2-2013:p1327:b003:l027","ordinal":288784,"en":"Observe the hero's leonine courage"},{"id":"semetey-2-2013:p1327:b003:l028","ordinal":288785,"en":"And always remember it!"},{"id":"semetey-2-2013:p1327:b003:l029","ordinal":288786,"en":"Snorting in excitement,"},{"id":"semetey-2-2013:p1327:b003:l030","ordinal":288787,"en":"Suddenly raising a battle cry,"},{"id":"semetey-2-2013:p1327:b003:l031","ordinal":288788,"en":"No people can withstand me,"},{"id":"semetey-2-2013:p1327:b003:l032","ordinal":288789,"en":"No charging foe can come near,"},{"id":"semetey-2-2013:p1327:b003:l033","ordinal":288790,"en":"No enemy can defeat me in battle."},{"id":"semetey-2-2013:p1327:b003:l034","ordinal":288791,"en":"When a hero stands at the front,"},{"id":"semetey-2-2013:p1327:b003:l035","ordinal":288792,"en":"Can any man with a thumb attack?"},{"id":"semetey-2-2013:p1327:b003:l036","ordinal":288793,"en":"Can any clawed enemy touch you?"},{"id":"semetey-2-2013:p1327:b003:l037","ordinal":288794,"en":"Can a cold-blooded foe advance?"},{"id":"semetey-2-2013:p1327:b003:l038","ordinal":288795,"en":"While your valiant Choro lives,"},{"id":"semetey-2-2013:p1327:b003:l039","ordinal":288796,"en":"My forearm is thick, my heart is stone,"},{"id":"semetey-2-2013:p1327:b004:l001","ordinal":288797,"en":"My body broad and powerful."},{"id":"semetey-2-2013:p1327:b004:l002","ordinal":288798,"en":"While your Choro stands watch,"},{"id":"semetey-2-2013:p1327:b004:l003","ordinal":288799,"en":"No one is swept away in the flood;"},{"id":"semetey-2-2013:p1327:b004:l004","ordinal":288800,"en":"Jediger, death cannot touch you."},{"id":"semetey-2-2013:p1327:b004:l005","ordinal":288801,"en":"There is no boat upon black water,"},{"id":"semetey-2-2013:p1327:b004:l006","ordinal":288802,"en":"But while your Khan Kanchoro lives,"},{"id":"semetey-2-2013:p1327:b004:l007","ordinal":288803,"en":"Jediger, death cannot touch you!"},{"id":"semetey-2-2013:p1327:b004:l008","ordinal":288804,"en":"In Talas, slaughter the livestock"},{"id":"semetey-2-2013:p1327:b004:l009","ordinal":288805,"en":"Of the Kyrgyz and Argyn and hold a feast;"},{"id":"semetey-2-2013:p1327:b004:l010","ordinal":288806,"en":"Slaughter their heroes and wreak havoc."},{"id":"semetey-2-2013:p1327:b004:l011","ordinal":288807,"en":"Make the gateway run with blood,"},{"id":"semetey-2-2013:p1327:b004:l012","ordinal":288808,"en":"And turn the black road to dust."},{"id":"semetey-2-2013:p1327:b004:l013","ordinal":288809,"en":"Make widows of their beauties,"},{"id":"semetey-2-2013:p1327:b004:l014","ordinal":288810,"en":"And slaves of their princes;"},{"id":"semetey-2-2013:p1327:b004:l015","ordinal":288811,"en":"Their wise old men—"},{"id":"semetey-2-2013:p1327:b004:l016","ordinal":288812,"en":"Smash and kill them all!"},{"id":"semetey-2-2013:p1327:b004:l017","ordinal":288813,"en":"Break apart their yurt frames and poles,"},{"id":"semetey-2-2013:p1327:b004:l018","ordinal":288814,"en":"And make their brides and daughters weep."},{"id":"semetey-2-2013:p1327:b004:l019","ordinal":288815,"en":"Take their old folk as plunder;"},{"id":"semetey-2-2013:p1327:b004:l020","ordinal":288816,"en":"Lay waste to them all."},{"id":"semetey-2-2013:p1327:b004:l021","ordinal":288817,"en":"Make their rulers and lions suffer,"},{"id":"semetey-2-2013:p1327:b004:l022","ordinal":288818,"en":"And crush the people of the steppe."},{"id":"semetey-2-2013:p1327:b004:l023","ordinal":288819,"en":"Cast cold lassos"},{"id":"semetey-2-2013:p1327:b004:l024","ordinal":288820,"en":"Over the steeds they would never surrender;"},{"id":"semetey-2-2013:p1327:b004:l025","ordinal":288821,"en":"Inflict open humiliation"},{"id":"semetey-2-2013:p1327:b004:l026","ordinal":288822,"en":"Upon flourishing Talas."},{"id":"semetey-2-2013:p1327:b004:l027","ordinal":288823,"en":"Bring misery upon its beks;"},{"id":"semetey-2-2013:p1327:b004:l028","ordinal":288824,"en":"Advance upon these black-hearted people"},{"id":"semetey-2-2013:p1327:b004:l029","ordinal":288825,"en":"And plunder them."},{"id":"semetey-2-2013:p1327:b004:l030","ordinal":288826,"en":"My great people, consider this:"},{"id":"semetey-2-2013:p1327:b004:l031","ordinal":288827,"en":"A khan's threshold is the Day of Judgment,"},{"id":"semetey-2-2013:p1327:b004:l032","ordinal":288828,"en":"And one must speak with care;"},{"id":"semetey-2-2013:p1327:b004:l033","ordinal":288829,"en":"A hero's threshold is solid iron,"},{"id":"semetey-2-2013:p1327:b004:l034","ordinal":288830,"en":"And one needs skill to melt it."},{"id":"semetey-2-2013:p1327:b004:l035","ordinal":288831,"en":"I have given the order—understand it,"},{"id":"semetey-2-2013:p1327:b004:l036","ordinal":288832,"en":"You many Black Jediger;"},{"id":"semetey-2-2013:p1327:b004:l037","ordinal":288833,"en":"Obey my word and do not anger me!”"},{"id":"semetey-2-2013:p1327:b004:l038","ordinal":288834,"en":"Thus Kanchoro spoke,"},{"id":"semetey-2-2013:p1327:b004:l039","ordinal":288835,"en":"That retainer faithless to the salt he had eaten,"},{"id":"semetey-2-2013:p1328:b003:l001","ordinal":288836,"en":"That retainer who was calamity itself,"},{"id":"semetey-2-2013:p1328:b003:l002","ordinal":288837,"en":"The pale retainer who slew his own kin;"},{"id":"semetey-2-2013:p1328:b003:l003","ordinal":288838,"en":"Greasing his bowels with fat,"},{"id":"semetey-2-2013:p1328:b003:l004","ordinal":288839,"en":"When his stubborn rage seized him,"},{"id":"semetey-2-2013:p1328:b003:l005","ordinal":288840,"en":"He destroyed his own elder brother."},{"id":"semetey-2-2013:p1328:b003:l006","ordinal":288841,"en":"No goodness or manly honor"},{"id":"semetey-2-2013:p1328:b003:l007","ordinal":288842,"en":"Remained in Kanchoro."},{"id":"semetey-2-2013:p1328:b003:l008","ordinal":288843,"en":"Kanchoro himself was a lofty slave,"},{"id":"semetey-2-2013:p1328:b003:l009","ordinal":288844,"en":"With a treacherous heart and sullen nature—"},{"id":"semetey-2-2013:p1328:b003:l010","ordinal":288845,"en":"Such a son had come among mankind."},{"id":"semetey-2-2013:p1328:b003:l011","ordinal":288846,"en":"When frenzy overcame him,"},{"id":"semetey-2-2013:p1328:b003:l012","ordinal":288847,"en":"He destroyed his own close kin"},{"id":"semetey-2-2013:p1328:b003:l013","ordinal":288848,"en":"And made a bondwoman of the mother"},{"id":"semetey-2-2013:p1328:b003:l014","ordinal":288849,"en":"Of his heroic kinsman who faced death."},{"id":"semetey-2-2013:p1328:b003:l015","ordinal":288850,"en":"The wretched son of a dog—"},{"id":"semetey-2-2013:p1328:b003:l016","ordinal":288851,"en":"A truly corrupted nightmare;"},{"id":"semetey-2-2013:p1328:b003:l017","ordinal":288852,"en":"Such a deed had never happened in an age."},{"id":"semetey-2-2013:p1328:b003:l018","ordinal":288853,"en":"To subject surpassingly beautiful Aichurok"},{"id":"semetey-2-2013:p1328:b003:l019","ordinal":288854,"en":"To still greater torment,"},{"id":"semetey-2-2013:p1328:b003:l020","ordinal":288855,"en":"And take that radiant beauty"},{"id":"semetey-2-2013:p1328:b003:l021","ordinal":288856,"en":"As plunder for himself,"},{"id":"semetey-2-2013:p1328:b003:l022","ordinal":288857,"en":"He urged the Jediger onward."},{"id":"semetey-2-2013:p1328:b003:l023","ordinal":288858,"en":"When the bloodstained warrior vanished,"},{"id":"semetey-2-2013:p1328:b003:l024","ordinal":288859,"en":"The Jediger people laughed"},{"id":"semetey-2-2013:p1328:b003:l025","ordinal":288860,"en":"At the frenzied swine."},{"id":"semetey-2-2013:p1328:b003:l026","ordinal":288861,"en":"The deep black earth beneath them"},{"id":"semetey-2-2013:p1328:b003:l027","ordinal":288862,"en":"Endured the great weight"},{"id":"semetey-2-2013:p1328:b003:l028","ordinal":288863,"en":"When Choro roared."},{"id":"semetey-2-2013:p1328:b003:l029","ordinal":288864,"en":"When that Choro strutted,"},{"id":"semetey-2-2013:p1328:b003:l030","ordinal":288865,"en":"He seemed lord of earth and water;"},{"id":"semetey-2-2013:p1328:b003:l031","ordinal":288866,"en":"When the broad brute barked,"},{"id":"semetey-2-2013:p1328:b003:l032","ordinal":288867,"en":"He seemed master of the land and streams."},{"id":"semetey-2-2013:p1328:b003:l033","ordinal":288868,"en":"The doomed man's fury"},{"id":"semetey-2-2013:p1328:b003:l034","ordinal":288869,"en":"Was like a giant in his swaggering;"},{"id":"semetey-2-2013:p1328:b003:l035","ordinal":288870,"en":"When the madman barked,"},{"id":"semetey-2-2013:p1328:b003:l036","ordinal":288871,"en":"He seemed a wrestler greater than the world."},{"id":"semetey-2-2013:p1328:b003:l037","ordinal":288872,"en":"His appearance and bearing"},{"id":"semetey-2-2013:p1328:b003:l038","ordinal":288873,"en":"Were like a tyrant ruling a nation;"},{"id":"semetey-2-2013:p1328:b003:l039","ordinal":288874,"en":"When the madman lurched about,"},{"id":"semetey-2-2013:p1328:b004:l001","ordinal":288875,"en":"He seemed a man bent on ruining a people."},{"id":"semetey-2-2013:p1328:b004:l002","ordinal":288876,"en":"See how he strutted—"},{"id":"semetey-2-2013:p1328:b004:l003","ordinal":288877,"en":"Like Kozkaman of old."},{"id":"semetey-2-2013:p1328:b004:l004","ordinal":288878,"en":"He roared in wrath"},{"id":"semetey-2-2013:p1328:b004:l005","ordinal":288879,"en":"At the great host of people;"},{"id":"semetey-2-2013:p1328:b004:l006","ordinal":288880,"en":"Taking the bloodstained lion as his model,"},{"id":"semetey-2-2013:p1328:b004:l007","ordinal":288881,"en":"The madman had grown savage."},{"id":"semetey-2-2013:p1328:b004:l008","ordinal":288882,"en":"He summoned the whole multitude,"},{"id":"semetey-2-2013:p1328:b004:l009","ordinal":288883,"en":"Crying, “Come, every one of you!”"},{"id":"semetey-2-2013:p1328:b004:l010","ordinal":288884,"en":"Looking at him made the heart recoil."},{"id":"semetey-2-2013:p1328:b004:l011","ordinal":288885,"en":"The madman, possessed by a spirit,"},{"id":"semetey-2-2013:p1328:b004:l012","ordinal":288886,"en":"Loomed like a towering mountain;"},{"id":"semetey-2-2013:p1328:b004:l013","ordinal":288887,"en":"The blue flame issuing from his mouth"},{"id":"semetey-2-2013:p1328:b004:l014","ordinal":288888,"en":"Poured out in gusts."},{"id":"semetey-2-2013:p1328:b004:l015","ordinal":288889,"en":"He meant to plunder the nation,"},{"id":"semetey-2-2013:p1328:b004:l016","ordinal":288890,"en":"To subject his people to misery,"},{"id":"semetey-2-2013:p1328:b004:l017","ordinal":288891,"en":"To erase the name of Semetey"},{"id":"semetey-2-2013:p1328:b004:l018","ordinal":288892,"en":"And remain as sultan himself,"},{"id":"semetey-2-2013:p1328:b004:l019","ordinal":288893,"en":"Taking both reins and the single bridle"},{"id":"semetey-2-2013:p1328:b004:l020","ordinal":288894,"en":"Somehow into his own hands."},{"id":"semetey-2-2013:p1328:b004:l021","ordinal":288895,"en":"Kanchoro, brother to corruption,"},{"id":"semetey-2-2013:p1328:b004:l022","ordinal":288896,"en":"When every other scheme failed,"},{"id":"semetey-2-2013:p1328:b004:l023","ordinal":288897,"en":"Meant to remain sultan in Talas."},{"id":"semetey-2-2013:p1328:b004:l024","ordinal":288898,"en":"Fluent-tongued Kanchoro—"},{"id":"semetey-2-2013:p1328:b004:l025","ordinal":288899,"en":"It is true he was conspicuous;"},{"id":"semetey-2-2013:p1328:b004:l026","ordinal":288900,"en":"The most insinuating smooth-talker,"},{"id":"semetey-2-2013:p1328:b004:l027","ordinal":288901,"en":"It is also true that Choro's conduct"},{"id":"semetey-2-2013:p1328:b004:l028","ordinal":288902,"en":"Was unlike any other person's."},{"id":"semetey-2-2013:p1328:b004:l029","ordinal":288903,"en":"That Choro of treacherous intent,"},{"id":"semetey-2-2013:p1328:b004:l030","ordinal":288904,"en":"Kanchoro, raising a battle cry, said:"},{"id":"semetey-2-2013:p1328:b004:l031","ordinal":288905,"en":"“You many Black Jediger,"},{"id":"semetey-2-2013:p1328:b004:l032","ordinal":288906,"en":"If you will not heed wise counsel,"},{"id":"semetey-2-2013:p1328:b004:l033","ordinal":288907,"en":"If you do not know your place,"},{"id":"semetey-2-2013:p1328:b004:l034","ordinal":288908,"en":"Then you have eaten filth!"},{"id":"semetey-2-2013:p1328:b004:l035","ordinal":288909,"en":"Babbling two at a time,"},{"id":"semetey-2-2013:p1328:b004:l036","ordinal":288910,"en":"What else did you say?"},{"id":"semetey-2-2013:p1328:b004:l037","ordinal":288911,"en":"As for Churok, Akun's daughter,"},{"id":"semetey-2-2013:p1328:b004:l038","ordinal":288912,"en":"That surpassingly beautiful wonder,"},{"id":"semetey-2-2013:p1328:b004:l039","ordinal":288913,"en":"That marvelous woman—"},{"id":"semetey-2-2013:p1329:b003:l001","ordinal":288914,"en":"This comely infidel woman—"},{"id":"semetey-2-2013:p1329:b003:l002","ordinal":288915,"en":"If blood should drip upon this black earth,"},{"id":"semetey-2-2013:p1329:b003:l003","ordinal":288916,"en":"This infidel, white as snow,"},{"id":"semetey-2-2013:p1329:b003:l004","ordinal":288917,"en":"Is surpassingly beautiful and bold;"},{"id":"semetey-2-2013:p1329:b003:l005","ordinal":288918,"en":"There is no such marvel in the village."},{"id":"semetey-2-2013:p1329:b003:l006","ordinal":288919,"en":"With a handspan waist and moonlike face,"},{"id":"semetey-2-2013:p1329:b003:l007","ordinal":288920,"en":"That celebrated beauty, that wanton woman,"},{"id":"semetey-2-2013:p1329:b003:l008","ordinal":288921,"en":"Is full of guile and fierce with venom—"},{"id":"semetey-2-2013:p1329:b003:l009","ordinal":288922,"en":"Aychörök, fertile in cunning,"},{"id":"semetey-2-2013:p1329:b003:l010","ordinal":288923,"en":"This mischief-maker, fertile in cunning."},{"id":"semetey-2-2013:p1329:b003:l011","ordinal":288924,"en":"Friday alone knew when she walked;"},{"id":"semetey-2-2013:p1329:b003:l012","ordinal":288925,"en":"The twilight night knew when she flew."},{"id":"semetey-2-2013:p1329:b003:l013","ordinal":288926,"en":"She swept across every quarter,"},{"id":"semetey-2-2013:p1329:b003:l014","ordinal":288927,"en":"The whole wide world,"},{"id":"semetey-2-2013:p1329:b003:l015","ordinal":288928,"en":"Flying as she roamed."},{"id":"semetey-2-2013:p1329:b003:l016","ordinal":288929,"en":"No mountain pass remained uncrossed,"},{"id":"semetey-2-2013:p1329:b003:l017","ordinal":288930,"en":"No man remained whom she had not visited;"},{"id":"semetey-2-2013:p1329:b003:l018","ordinal":288931,"en":"Chörök has seen a great deal."},{"id":"semetey-2-2013:p1329:b003:l019","ordinal":288932,"en":"She is no Chörök, but simply"},{"id":"semetey-2-2013:p1329:b003:l020","ordinal":288933,"en":"A scourge who brings nations to ruin."},{"id":"semetey-2-2013:p1329:b003:l021","ordinal":288934,"en":"Take that unruly-minded woman,"},{"id":"semetey-2-2013:p1329:b003:l022","ordinal":288935,"en":"That glittering infidel woman"},{"id":"semetey-2-2013:p1329:b003:l023","ordinal":288936,"en":"Who learned the whole world in flight."},{"id":"semetey-2-2013:p1329:b003:l024","ordinal":288937,"en":"There is no ridge she has not flown beyond;"},{"id":"semetey-2-2013:p1329:b003:l025","ordinal":288938,"en":"There is no man who does not recognize"},{"id":"semetey-2-2013:p1329:b003:l026","ordinal":288939,"en":"The outward face of that black-hearted wretch."},{"id":"semetey-2-2013:p1329:b003:l027","ordinal":288940,"en":"Damn you, valiant Kiyaz!"},{"id":"semetey-2-2013:p1329:b003:l028","ordinal":288941,"en":"Kiyaz, you witless fool!"},{"id":"semetey-2-2013:p1329:b003:l029","ordinal":288942,"en":"Aychörök, the accomplished one among women,"},{"id":"semetey-2-2013:p1329:b003:l030","ordinal":288943,"en":"That tumultuous woman,"},{"id":"semetey-2-2013:p1329:b003:l031","ordinal":288944,"en":"Was Khan Akun's daughter."},{"id":"semetey-2-2013:p1329:b003:l032","ordinal":288945,"en":"She was the subject of my words,"},{"id":"semetey-2-2013:p1329:b003:l033","ordinal":288946,"en":"And she was your sister-in-law;"},{"id":"semetey-2-2013:p1329:b003:l034","ordinal":288947,"en":"You truly are shameless, Kiyaz."},{"id":"semetey-2-2013:p1329:b003:l035","ordinal":288948,"en":"You have courage but no sense;"},{"id":"semetey-2-2013:p1329:b003:l036","ordinal":288949,"en":"You are a blundering Kiyaz."},{"id":"semetey-2-2013:p1329:b003:l037","ordinal":288950,"en":"Why do you not unleash"},{"id":"semetey-2-2013:p1329:b003:l038","ordinal":288951,"en":"Utter slaughter, Kiyaz?"},{"id":"semetey-2-2013:p1329:b003:l039","ordinal":288952,"en":"Why do you not take Aychörök"},{"id":"semetey-2-2013:p1329:b005:l001","ordinal":288953,"en":"As plunder, Kiyaz?"},{"id":"semetey-2-2013:p1329:b005:l002","ordinal":288954,"en":"Look there: the peerless woman Aychörök"},{"id":"semetey-2-2013:p1329:b005:l003","ordinal":288955,"en":"Is, after all, your wife;"},{"id":"semetey-2-2013:p1329:b005:l004","ordinal":288956,"en":"If you truly contest her, she is your widow,"},{"id":"semetey-2-2013:p1329:b005:l005","ordinal":288957,"en":"And if you exert yourself, your own spouse."},{"id":"semetey-2-2013:p1329:b005:l006","ordinal":288958,"en":"You destroyed that swaggering ruin-bringer,"},{"id":"semetey-2-2013:p1329:b005:l007","ordinal":288959,"en":"You demolished the Grey Wolf's fortress."},{"id":"semetey-2-2013:p1329:b005:l008","ordinal":288960,"en":"You are a hero, you are a lion;"},{"id":"semetey-2-2013:p1329:b005:l009","ordinal":288961,"en":"Yet you are a foolish Kiyaz."},{"id":"semetey-2-2013:p1329:b005:l010","ordinal":288962,"en":"You are the man to take the beauty."},{"id":"semetey-2-2013:p1329:b005:l011","ordinal":288963,"en":"Think it through and raise the tumult;"},{"id":"semetey-2-2013:p1329:b005:l012","ordinal":288964,"en":"Show Talas the strength of your arm."},{"id":"semetey-2-2013:p1329:b005:l013","ordinal":288965,"en":"Take the woman as a prize,"},{"id":"semetey-2-2013:p1329:b005:l014","ordinal":288966,"en":"This beautiful woman Chörök,"},{"id":"semetey-2-2013:p1329:b005:l015","ordinal":288967,"en":"This strange-minded infidel,"},{"id":"semetey-2-2013:p1329:b005:l016","ordinal":288968,"en":"This graceful, shimmering woman,"},{"id":"semetey-2-2013:p1329:b005:l017","ordinal":288969,"en":"With thimble mouth and camel-calf eyes,"},{"id":"semetey-2-2013:p1329:b005:l018","ordinal":288970,"en":"With rolling black eyes."},{"id":"semetey-2-2013:p1329:b005:l019","ordinal":288971,"en":"There is no need to ponder such words."},{"id":"semetey-2-2013:p1329:b005:l020","ordinal":288972,"en":"Ah, God-forsaken valiant Kiyaz,"},{"id":"semetey-2-2013:p1329:b005:l021","ordinal":288973,"en":"Now is the time to take Aychörök."},{"id":"semetey-2-2013:p1329:b005:l022","ordinal":288974,"en":"Take Aychörök as your spoil"},{"id":"semetey-2-2013:p1329:b005:l023","ordinal":288975,"en":"And return, Kiyaz!"},{"id":"semetey-2-2013:p1329:b005:l024","ordinal":288976,"en":"Why not hold a grand spectacle,"},{"id":"semetey-2-2013:p1329:b005:l025","ordinal":288977,"en":"A mighty feast, Kiyaz?"},{"id":"semetey-2-2013:p1329:b005:l026","ordinal":288978,"en":"Meet her face-to-face and speak,"},{"id":"semetey-2-2013:p1329:b005:l027","ordinal":288979,"en":"Saying, “Sister-in-law, come with us.”"},{"id":"semetey-2-2013:p1329:b005:l028","ordinal":288980,"en":"Make the infidel Aychörök,"},{"id":"semetey-2-2013:p1329:b005:l029","ordinal":288981,"en":"That woman, your plunder;"},{"id":"semetey-2-2013:p1329:b005:l030","ordinal":288982,"en":"Devise a plan no man could imagine,"},{"id":"semetey-2-2013:p1329:b005:l031","ordinal":288983,"en":"And hold a feast without stint."},{"id":"semetey-2-2013:p1329:b005:l032","ordinal":288984,"en":"Open up all the livestock;"},{"id":"semetey-2-2013:p1329:b005:l033","ordinal":288985,"en":"Let the revelry be like this:"},{"id":"semetey-2-2013:p1329:b005:l034","ordinal":288986,"en":"Parade her through many towns,"},{"id":"semetey-2-2013:p1329:b005:l035","ordinal":288987,"en":"Take her and display her before the people;"},{"id":"semetey-2-2013:p1329:b005:l036","ordinal":288988,"en":"Heap meat as high as Ala-Too,"},{"id":"semetey-2-2013:p1329:b005:l037","ordinal":288989,"en":"Pour broth as vast as Ala-Köl,"},{"id":"semetey-2-2013:p1329:b005:l038","ordinal":288990,"en":"Raise dust along the lower road"},{"id":"semetey-2-2013:p1329:b005:l039","ordinal":288991,"en":"And amaze all who see it."},{"id":"semetey-2-2013:p1330:b003:l001","ordinal":288992,"en":"You should stage much entertainment"},{"id":"semetey-2-2013:p1330:b003:l002","ordinal":288993,"en":"And great games, Kiyaz!"},{"id":"semetey-2-2013:p1330:b003:l003","ordinal":288994,"en":"Make this manifest infidel Chörök"},{"id":"semetey-2-2013:p1330:b003:l004","ordinal":288995,"en":"A moon-crested banner,"},{"id":"semetey-2-2013:p1330:b003:l005","ordinal":288996,"en":"A clamor that delights the people,"},{"id":"semetey-2-2013:p1330:b003:l006","ordinal":288997,"en":"A sensation among all who see,"},{"id":"semetey-2-2013:p1330:b003:l007","ordinal":288998,"en":"Proclaiming, “Chörök who raised the tumult!”"},{"id":"semetey-2-2013:p1330:b003:l008","ordinal":288999,"en":"Halt everyone and stir their souls,"},{"id":"semetey-2-2013:p1330:b003:l009","ordinal":289000,"en":"Delighting all who hear."},{"id":"semetey-2-2013:p1330:b003:l010","ordinal":289001,"en":"For that shimmering infidel,"},{"id":"semetey-2-2013:p1330:b003:l011","ordinal":289002,"en":"That strange-minded woman,"},{"id":"semetey-2-2013:p1330:b003:l012","ordinal":289003,"en":"Slaughter livestock of all four kinds;"},{"id":"semetey-2-2013:p1330:b003:l013","ordinal":289004,"en":"At her feast, slaughter ninety sheep."},{"id":"semetey-2-2013:p1330:b003:l014","ordinal":289005,"en":"Say, “Chörök is Kiyaz's wife,”"},{"id":"semetey-2-2013:p1330:b003:l015","ordinal":289006,"en":"And give her that name!"},{"id":"semetey-2-2013:p1330:b003:l016","ordinal":289007,"en":"That is my counsel; understand it."},{"id":"semetey-2-2013:p1330:b003:l017","ordinal":289008,"en":"You were a simple-hearted hero;"},{"id":"semetey-2-2013:p1330:b003:l018","ordinal":289009,"en":"My great Kiyaz, heed my words."},{"id":"semetey-2-2013:p1330:b003:l019","ordinal":289010,"en":"There is hardship and disaster;"},{"id":"semetey-2-2013:p1330:b003:l020","ordinal":289011,"en":"Grasp the point of what I say."},{"id":"semetey-2-2013:p1330:b003:l021","ordinal":289012,"en":"If you are noble, if you are a khan,"},{"id":"semetey-2-2013:p1330:b003:l022","ordinal":289013,"en":"Know that Toltoy is your elder."},{"id":"semetey-2-2013:p1330:b003:l023","ordinal":289014,"en":"Take the shimmering woman"},{"id":"semetey-2-2013:p1330:b003:l024","ordinal":289015,"en":"In the red dress with ribbon waist!"},{"id":"semetey-2-2013:p1330:b003:l025","ordinal":289016,"en":"If you incur her wrath,"},{"id":"semetey-2-2013:p1330:b003:l026","ordinal":289017,"en":"That wild infidel woman"},{"id":"semetey-2-2013:p1330:b003:l027","ordinal":289018,"en":"Who has bent the peoples of the age—"},{"id":"semetey-2-2013:p1330:b003:l028","ordinal":289019,"en":"If you receive her well, she is Chörök;"},{"id":"semetey-2-2013:p1330:b003:l029","ordinal":289020,"en":"If you fail to tend her this time,"},{"id":"semetey-2-2013:p1330:b003:l030","ordinal":289021,"en":"She is a calamity that will bring gloom."},{"id":"semetey-2-2013:p1330:b003:l031","ordinal":289022,"en":"If you desire her, she is a wife;"},{"id":"semetey-2-2013:p1330:b003:l032","ordinal":289023,"en":"If you depart from proper custom,"},{"id":"semetey-2-2013:p1330:b003:l033","ordinal":289024,"en":"She is an ill-starred infidel."}]
