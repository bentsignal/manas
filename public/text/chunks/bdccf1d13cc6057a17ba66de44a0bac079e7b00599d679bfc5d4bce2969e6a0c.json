[{"id":"semetey-1-2013:p1256:b004:l005","ordinal":172033,"en":"With dark eyes flashing,"},{"id":"semetey-1-2013:p1256:b004:l006","ordinal":172034,"en":"She had exactly forty"},{"id":"semetey-1-2013:p1256:b004:l007","ordinal":172035,"en":"Of the most precious beauties brought,"},{"id":"semetey-1-2013:p1256:b004:l008","ordinal":172036,"en":"And held magnificent games."},{"id":"semetey-1-2013:p1256:b004:l009","ordinal":172037,"en":"In dürüyö* dresses with foxlike waists,"},{"id":"semetey-1-2013:p1256:b004:l010","ordinal":172038,"en":"She had the dear women brought"},{"id":"semetey-1-2013:p1256:b004:l011","ordinal":172039,"en":"And held games of every kind."},{"id":"semetey-1-2013:p1256:b004:l012","ordinal":172040,"en":"None of the heroes slept;"},{"id":"semetey-1-2013:p1256:b004:l013","ordinal":172041,"en":"Their sides did not touch the earth."},{"id":"semetey-1-2013:p1256:b004:l014","ordinal":172042,"en":"They did not prop themselves on elbows to sleep,"},{"id":"semetey-1-2013:p1256:b004:l015","ordinal":172043,"en":"Nor rest for even a brief doze."},{"id":"semetey-1-2013:p1256:b004:l016","ordinal":172044,"en":"When all the heroes had risen,"},{"id":"semetey-1-2013:p1256:b004:l017","ordinal":172045,"en":"Azhibai came up"},{"id":"semetey-1-2013:p1256:b004:l018","ordinal":172046,"en":"To hero Semetey,"},{"id":"semetey-1-2013:p1256:b004:l019","ordinal":172047,"en":"Offered greeting before him,"},{"id":"semetey-1-2013:p1256:b004:l020","ordinal":172048,"en":"And Semetey returned the greeting."},{"id":"semetey-1-2013:p1256:b004:l021","ordinal":172049,"en":"The formidable orator Azhibai"},{"id":"semetey-1-2013:p1256:b004:l022","ordinal":172050,"en":"Raised his voice and began to speak."},{"id":"semetey-1-2013:p1256:b004:l023","ordinal":172051,"en":"Broad-jawed and flat-tongued,"},{"id":"semetey-1-2013:p1256:b004:l024","ordinal":172052,"en":"He was a servant who never stumbled in speech;"},{"id":"semetey-1-2013:p1256:b004:l025","ordinal":172053,"en":"A swift orator and reasoner,"},{"id":"semetey-1-2013:p1256:b004:l026","ordinal":172054,"en":"He was a courageous speaker."},{"id":"semetey-1-2013:p1256:b004:l027","ordinal":172055,"en":"He sharpened his black tongue"},{"id":"semetey-1-2013:p1256:b004:l028","ordinal":172056,"en":"And sang out before the khan."},{"id":"semetey-1-2013:p1256:b004:l029","ordinal":172057,"en":"When he spoke, he faced a man's soul;"},{"id":"semetey-1-2013:p1256:b004:l030","ordinal":172058,"en":"His words set a man's soul aflame—"},{"id":"semetey-1-2013:p1256:b004:l031","ordinal":172059,"en":"Such a servant was he."},{"id":"semetey-1-2013:p1256:b004:l032","ordinal":172060,"en":"His eloquence and wisdom"},{"id":"semetey-1-2013:p1256:b004:l033","ordinal":172061,"en":"Were equally matched."},{"id":"semetey-1-2013:p1256:b004:l034","ordinal":172062,"en":"They called him Azhibai the orator,"},{"id":"semetey-1-2013:p1256:b004:l035","ordinal":172063,"en":"A resourceful man who found the argument,"},{"id":"semetey-1-2013:p1256:b004:l036","ordinal":172064,"en":"A hero who spared nothing."},{"id":"semetey-1-2013:p1256:b004:l037","ordinal":172065,"en":"To hero Semetey,"},{"id":"semetey-1-2013:p1256:b004:l038","ordinal":172066,"en":"Azhibai spoke a word"},{"id":"semetey-1-2013:p1256:b004:l039","ordinal":172067,"en":"And planted a foul thought in his mind:"},{"id":"semetey-1-2013:p1257:b003:l001","ordinal":172068,"en":"“Silver-eyed and sun-faced,"},{"id":"semetey-1-2013:p1257:b003:l002","ordinal":172069,"en":"My thundering sultan,"},{"id":"semetey-1-2013:p1257:b003:l003","ordinal":172070,"en":"Golden-eyed and moon-faced,"},{"id":"semetey-1-2013:p1257:b003:l004","ordinal":172071,"en":"My dear sultan!"},{"id":"semetey-1-2013:p1257:b003:l005","ordinal":172072,"en":"My hoof left by the tulpar,"},{"id":"semetey-1-2013:p1257:b003:l006","ordinal":172073,"en":"My young hero left to me"},{"id":"semetey-1-2013:p1257:b003:l007","ordinal":172074,"en":"By falcon Manas, the charger!"},{"id":"semetey-1-2013:p1257:b003:l008","ordinal":172075,"en":"My banner fixed upon the spear,"},{"id":"semetey-1-2013:p1257:b003:l009","ordinal":172076,"en":"My gift left by the gray wolf:"},{"id":"semetey-1-2013:p1257:b003:l010","ordinal":172077,"en":"Your Kyrgyz village in Talas,"},{"id":"semetey-1-2013:p1257:b003:l011","ordinal":172078,"en":"Your Afghan in-laws in Orol—"},{"id":"semetey-1-2013:p1257:b003:l012","ordinal":172079,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1257:b003:l013","ordinal":172080,"en":"Has gathered his army and exchanged fire,"},{"id":"semetey-1-2013:p1257:b003:l014","ordinal":172081,"en":"And is about to wipe away your name."},{"id":"semetey-1-2013:p1257:b003:l015","ordinal":172082,"en":"My village is in Orol;"},{"id":"semetey-1-2013:p1257:b003:l016","ordinal":172083,"en":"Aychürök is your wife."},{"id":"semetey-1-2013:p1257:b003:l017","ordinal":172084,"en":"Because of Aychürök,"},{"id":"semetey-1-2013:p1257:b003:l018","ordinal":172085,"en":"Toltoy surged upon us then"},{"id":"semetey-1-2013:p1257:b003:l019","ordinal":172086,"en":"And was about to wipe away my name."},{"id":"semetey-1-2013:p1257:b003:l020","ordinal":172087,"en":"A true black army glittered;"},{"id":"semetey-1-2013:p1257:b003:l021","ordinal":172088,"en":"Chynkojo has engulfed us."},{"id":"semetey-1-2013:p1257:b003:l022","ordinal":172089,"en":"Turn your eyes toward us;"},{"id":"semetey-1-2013:p1257:b003:l023","ordinal":172090,"en":"If your gray-wolf nature is true,"},{"id":"semetey-1-2013:p1257:b003:l024","ordinal":172091,"en":"Come and rescue us!"},{"id":"semetey-1-2013:p1257:b003:l025","ordinal":172092,"en":"The deeply dug pit has come;"},{"id":"semetey-1-2013:p1257:b003:l026","ordinal":172093,"en":"My support, child Semetey,"},{"id":"semetey-1-2013:p1257:b003:l027","ordinal":172094,"en":"It presses hard upon our mortal lives."},{"id":"semetey-1-2013:p1257:b003:l028","ordinal":172095,"en":"Saying, ‘I shall level the inner fortress"},{"id":"semetey-1-2013:p1257:b003:l029","ordinal":172096,"en":"And slaughter them all,’"},{"id":"semetey-1-2013:p1257:b003:l030","ordinal":172097,"en":"Saying, ‘I shall smash the stone fortress"},{"id":"semetey-1-2013:p1257:b003:l031","ordinal":172098,"en":"And slaughter them utterly,’"},{"id":"semetey-1-2013:p1257:b003:l032","ordinal":172099,"en":"The accursed mighty Khoja has come;"},{"id":"semetey-1-2013:p1257:b003:l033","ordinal":172100,"en":"Upon your weak Afghan in-laws"},{"id":"semetey-1-2013:p1257:b003:l034","ordinal":172101,"en":"He has brought merciless force."},{"id":"semetey-1-2013:p1257:b003:l035","ordinal":172102,"en":"Driving them after him,"},{"id":"semetey-1-2013:p1257:b003:l036","ordinal":172103,"en":"Through his desire for Aychürök,"},{"id":"semetey-1-2013:p1257:b003:l037","ordinal":172104,"en":"Though we said she had a husband, he attacked."},{"id":"semetey-1-2013:p1257:b003:l038","ordinal":172105,"en":"Before this, Chynkojo,"},{"id":"semetey-1-2013:p1257:b003:l039","ordinal":172106,"en":"Saying, ‘Give us your eldest daughter,’"},{"id":"semetey-1-2013:p1257:b005:l001","ordinal":172107,"en":"Exchanged fire six times."},{"id":"semetey-1-2013:p1257:b005:l002","ordinal":172108,"en":"Riding out with shouts to single combat,"},{"id":"semetey-1-2013:p1257:b005:l003","ordinal":172109,"en":"Gray argamaks died;"},{"id":"semetey-1-2013:p1257:b005:l004","ordinal":172110,"en":"In the mounted single combats,"},{"id":"semetey-1-2013:p1257:b005:l005","ordinal":172111,"en":"Brave heroes died."},{"id":"semetey-1-2013:p1257:b005:l006","ordinal":172112,"en":"Those whose doom had come perished;"},{"id":"semetey-1-2013:p1257:b005:l007","ordinal":172113,"en":"Crying, ‘Ah, Aychürök, may you not prosper!’"},{"id":"semetey-1-2013:p1257:b005:l008","ordinal":172114,"en":"The Afghan people wept."},{"id":"semetey-1-2013:p1257:b005:l009","ordinal":172115,"en":"Many heroes from their side died;"},{"id":"semetey-1-2013:p1257:b005:l010","ordinal":172116,"en":"Many heroes from ours died;"},{"id":"semetey-1-2013:p1257:b005:l011","ordinal":172117,"en":"The dead became the black earth."},{"id":"semetey-1-2013:p1257:b005:l012","ordinal":172118,"en":"Saying, ‘Give your daughter as tribute,’"},{"id":"semetey-1-2013:p1257:b005:l013","ordinal":172119,"en":"Accursed Khoja raged;"},{"id":"semetey-1-2013:p1257:b005:l014","ordinal":172120,"en":"Saying, ‘Give your daughter quickly,’"},{"id":"semetey-1-2013:p1257:b005:l015","ordinal":172121,"en":"Accursed Toltoy strained greedily."},{"id":"semetey-1-2013:p1257:b005:l016","ordinal":172122,"en":"They took all the livestock,"},{"id":"semetey-1-2013:p1257:b005:l017","ordinal":172123,"en":"And destroyed many cities;"},{"id":"semetey-1-2013:p1257:b005:l018","ordinal":172124,"en":"They shattered yurt frames and roof poles,"},{"id":"semetey-1-2013:p1257:b005:l019","ordinal":172125,"en":"And made wives and maidens weep."},{"id":"semetey-1-2013:p1257:b005:l020","ordinal":172126,"en":"Chynkojo brought humiliation;"},{"id":"semetey-1-2013:p1257:b005:l021","ordinal":172127,"en":"He proved a skilled horseman,"},{"id":"semetey-1-2013:p1257:b005:l022","ordinal":172128,"en":"And now imposed great oppression."},{"id":"semetey-1-2013:p1257:b005:l023","ordinal":172129,"en":"The time to slaughter one another has come;"},{"id":"semetey-1-2013:p1257:b005:l024","ordinal":172130,"en":"The hour of massacre has come."},{"id":"semetey-1-2013:p1257:b005:l025","ordinal":172131,"en":"The low gray hills have come;"},{"id":"semetey-1-2013:p1257:b005:l026","ordinal":172132,"en":"Khoja's enemy host has stormed in."},{"id":"semetey-1-2013:p1257:b005:l027","ordinal":172133,"en":"A mass bullets cannot pierce has come;"},{"id":"semetey-1-2013:p1257:b005:l028","ordinal":172134,"en":"A grim-faced army has come."},{"id":"semetey-1-2013:p1257:b005:l029","ordinal":172135,"en":"Unless you yourself are my mighty champion,"},{"id":"semetey-1-2013:p1257:b005:l030","ordinal":172136,"en":"Mighty Toltoy has come"},{"id":"semetey-1-2013:p1257:b005:l031","ordinal":172137,"en":"To overturn the mountain pass."},{"id":"semetey-1-2013:p1257:b005:l032","ordinal":172138,"en":"Tölöbay, son of Tölök,"},{"id":"semetey-1-2013:p1257:b005:l033","ordinal":172139,"en":"Has engulfed us from below."},{"id":"semetey-1-2013:p1257:b005:l034","ordinal":172140,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1257:b005:l035","ordinal":172141,"en":"The khoja whose deeds were bold—"},{"id":"semetey-1-2013:p1257:b005:l036","ordinal":172142,"en":"Let us not belittle the hero,"},{"id":"semetey-1-2013:p1257:b005:l037","ordinal":172143,"en":"The valiant Toltoy who has come."},{"id":"semetey-1-2013:p1257:b005:l038","ordinal":172144,"en":"If we do not give Aychürök as tribute,"},{"id":"semetey-1-2013:p1257:b005:l039","ordinal":172145,"en":"The time has come for him to bring slaughter."},{"id":"semetey-1-2013:p1258:b003:l001","ordinal":172146,"en":"The hour has come for him to slaughter us."},{"id":"semetey-1-2013:p1258:b003:l002","ordinal":172147,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1258:b003:l003","ordinal":172148,"en":"The khoja whose deeds were bold,"},{"id":"semetey-1-2013:p1258:b003:l004","ordinal":172149,"en":"When summer came,"},{"id":"semetey-1-2013:p1258:b003:l005","ordinal":172150,"en":"Would not let us mount even a maned filly;"},{"id":"semetey-1-2013:p1258:b003:l006","ordinal":172151,"en":"He brought suffering upon my village."},{"id":"semetey-1-2013:p1258:b003:l007","ordinal":172152,"en":"When autumn came,"},{"id":"semetey-1-2013:p1258:b003:l008","ordinal":172153,"en":"He would not let us eat even a tailed lamb;"},{"id":"semetey-1-2013:p1258:b003:l009","ordinal":172154,"en":"He brought humiliation upon my land."},{"id":"semetey-1-2013:p1258:b003:l010","ordinal":172155,"en":"He let no tent trappings be prepared,"},{"id":"semetey-1-2013:p1258:b003:l011","ordinal":172156,"en":"No crops of any kind be sown,"},{"id":"semetey-1-2013:p1258:b003:l012","ordinal":172157,"en":"No furrow be opened in the earth,"},{"id":"semetey-1-2013:p1258:b003:l013","ordinal":172158,"en":"No handful of grain be scattered."},{"id":"semetey-1-2013:p1258:b003:l014","ordinal":172159,"en":"Chynkojo's humiliation"},{"id":"semetey-1-2013:p1258:b003:l015","ordinal":172160,"en":"Never leaves my innermost heart;"},{"id":"semetey-1-2013:p1258:b003:l016","ordinal":172161,"en":"Such is the accursed man's oppression."},{"id":"semetey-1-2013:p1258:b003:l017","ordinal":172162,"en":"All the great people"},{"id":"semetey-1-2013:p1258:b003:l018","ordinal":172163,"en":"He broke apart and dispersed;"},{"id":"semetey-1-2013:p1258:b003:l019","ordinal":172164,"en":"He imposed hell by force,"},{"id":"semetey-1-2013:p1258:b003:l020","ordinal":172165,"en":"And gathered his army complete."},{"id":"semetey-1-2013:p1258:b003:l021","ordinal":172166,"en":"Saying, ‘Give your eldest daughter,’"},{"id":"semetey-1-2013:p1258:b003:l022","ordinal":172167,"en":"He used force against Khan Akun."},{"id":"semetey-1-2013:p1258:b003:l023","ordinal":172168,"en":"If we do not obey what he says,"},{"id":"semetey-1-2013:p1258:b003:l024","ordinal":172169,"en":"If we do not give Aychürök,"},{"id":"semetey-1-2013:p1258:b003:l025","ordinal":172170,"en":"He will level the straight fortress"},{"id":"semetey-1-2013:p1258:b003:l026","ordinal":172171,"en":"And raid us entirely;"},{"id":"semetey-1-2013:p1258:b003:l027","ordinal":172172,"en":"The accursed mighty Khoja has come."},{"id":"semetey-1-2013:p1258:b003:l028","ordinal":172173,"en":"Leading an army like black worms,"},{"id":"semetey-1-2013:p1258:b003:l029","ordinal":172174,"en":"Infidel Khoja is coming;"},{"id":"semetey-1-2013:p1258:b003:l030","ordinal":172175,"en":"To bring slaughter upon the people,"},{"id":"semetey-1-2013:p1258:b003:l031","ordinal":172176,"en":"Hero Khoja is coming."},{"id":"semetey-1-2013:p1258:b003:l032","ordinal":172177,"en":"Toltoy of the Jediger"},{"id":"semetey-1-2013:p1258:b003:l033","ordinal":172178,"en":"Leads an army that bends the earth,"},{"id":"semetey-1-2013:p1258:b003:l034","ordinal":172179,"en":"Driving all the Jediger together,"},{"id":"semetey-1-2013:p1258:b003:l035","ordinal":172180,"en":"Prepared to ride out in single combat."},{"id":"semetey-1-2013:p1258:b003:l036","ordinal":172181,"en":"Like an enraged tiger,"},{"id":"semetey-1-2013:p1258:b003:l037","ordinal":172182,"en":"Leaving no attacker alive,"},{"id":"semetey-1-2013:p1258:b003:l038","ordinal":172183,"en":"The deeply dug pit comes;"},{"id":"semetey-1-2013:p1258:b003:l039","ordinal":172184,"en":"Misfortune comes to whoever angers him."},{"id":"semetey-1-2013:p1258:b004:l001","ordinal":172185,"en":"An army comes that will engulf"},{"id":"semetey-1-2013:p1258:b004:l002","ordinal":172186,"en":"The few Afghans."},{"id":"semetey-1-2013:p1258:b004:l003","ordinal":172187,"en":"A gray-piebald banner comes;"},{"id":"semetey-1-2013:p1258:b004:l004","ordinal":172188,"en":"Unless you are our own defender,"},{"id":"semetey-1-2013:p1258:b004:l005","ordinal":172189,"en":"A wailing uproar comes."},{"id":"semetey-1-2013:p1258:b004:l006","ordinal":172190,"en":"A white-mottled banner comes;"},{"id":"semetey-1-2013:p1258:b004:l007","ordinal":172191,"en":"Hungry shouts and uproar come."},{"id":"semetey-1-2013:p1258:b004:l008","ordinal":172192,"en":"My courageous hero Toltoy—"},{"id":"semetey-1-2013:p1258:b004:l009","ordinal":172193,"en":"Where was he born,"},{"id":"semetey-1-2013:p1258:b004:l010","ordinal":172194,"en":"That while he has Chynkojo"},{"id":"semetey-1-2013:p1258:b004:l011","ordinal":172195,"en":"He unleashes turmoil upon us?"},{"id":"semetey-1-2013:p1258:b004:l012","ordinal":172196,"en":"The Jediger have spurred forward"},{"id":"semetey-1-2013:p1258:b004:l013","ordinal":172197,"en":"And engulfed us evenly;"},{"id":"semetey-1-2013:p1258:b004:l014","ordinal":172198,"en":"Half bear guns and half spears,"},{"id":"semetey-1-2013:p1258:b004:l015","ordinal":172199,"en":"Bringing slaughter upon you."},{"id":"semetey-1-2013:p1258:b004:l016","ordinal":172200,"en":"The Jediger are surging upon us;"},{"id":"semetey-1-2013:p1258:b004:l017","ordinal":172201,"en":"What remedy can we devise?"},{"id":"semetey-1-2013:p1258:b004:l018","ordinal":172202,"en":"Only son of the king,"},{"id":"semetey-1-2013:p1258:b004:l019","ordinal":172203,"en":"Here is sovereign Afghan land;"},{"id":"semetey-1-2013:p1258:b004:l020","ordinal":172204,"en":"If you do not rescue it,"},{"id":"semetey-1-2013:p1258:b004:l021","ordinal":172205,"en":"Slaughter it with your own hand—"},{"id":"semetey-1-2013:p1258:b004:l022","ordinal":172206,"en":"If you would take heads, here are ours."},{"id":"semetey-1-2013:p1258:b004:l023","ordinal":172207,"en":"The time has come to receive judgment;"},{"id":"semetey-1-2013:p1258:b004:l024","ordinal":172208,"en":"Unless you yourself are sharp,"},{"id":"semetey-1-2013:p1258:b004:l025","ordinal":172209,"en":"The hour has come for us to die."},{"id":"semetey-1-2013:p1258:b004:l026","ordinal":172210,"en":"The time for a spectacle has come;"},{"id":"semetey-1-2013:p1258:b004:l027","ordinal":172211,"en":"Unless you yourself are our precious one,"},{"id":"semetey-1-2013:p1258:b004:l028","ordinal":172212,"en":"The hour has come for us to be slaughtered."},{"id":"semetey-1-2013:p1258:b004:l029","ordinal":172213,"en":"Wrathful Toltoy has come;"},{"id":"semetey-1-2013:p1258:b004:l030","ordinal":172214,"en":"Blood ready to flow has come."},{"id":"semetey-1-2013:p1258:b004:l031","ordinal":172215,"en":"If his Khoja raises a shout,"},{"id":"semetey-1-2013:p1258:b004:l032","ordinal":172216,"en":"Lives ready to be cut down have come."},{"id":"semetey-1-2013:p1258:b004:l033","ordinal":172217,"en":"If we match strength with Toltoy,"},{"id":"semetey-1-2013:p1258:b004:l034","ordinal":172218,"en":"He seems able to uproot the pillars;"},{"id":"semetey-1-2013:p1258:b004:l035","ordinal":172219,"en":"If we struggle with Chynkojo,"},{"id":"semetey-1-2013:p1258:b004:l036","ordinal":172220,"en":"He seems able to slaughter us without remainder."},{"id":"semetey-1-2013:p1258:b004:l037","ordinal":172221,"en":"From the flank, his Tölök"},{"id":"semetey-1-2013:p1258:b004:l038","ordinal":172222,"en":"Seems able to mow down the great people."},{"id":"semetey-1-2013:p1258:b004:l039","ordinal":172223,"en":"If they engulf Afghanistan,"},{"id":"semetey-1-2013:p1259:b003:l001","ordinal":172224,"en":"Tölöbay and Kalcha seem able to swallow us."},{"id":"semetey-1-2013:p1259:b003:l002","ordinal":172225,"en":"Unless you yourself defend us,"},{"id":"semetey-1-2013:p1259:b003:l003","ordinal":172226,"en":"They seem able to plunder our goods."},{"id":"semetey-1-2013:p1259:b003:l004","ordinal":172227,"en":"With Aychürök at their head,"},{"id":"semetey-1-2013:p1259:b003:l005","ordinal":172228,"en":"Smashing stone to rubble,"},{"id":"semetey-1-2013:p1259:b003:l006","ordinal":172229,"en":"They seem able to seize"},{"id":"semetey-1-2013:p1259:b003:l007","ordinal":172230,"en":"Every wife and maiden as plunder."},{"id":"semetey-1-2013:p1259:b003:l008","ordinal":172231,"en":"The pit has been dug deep;"},{"id":"semetey-1-2013:p1259:b003:l009","ordinal":172232,"en":"Unless you yourself are our noble one,"},{"id":"semetey-1-2013:p1259:b003:l010","ordinal":172233,"en":"Our bitter brine has begun to boil."},{"id":"semetey-1-2013:p1259:b003:l011","ordinal":172234,"en":"Upon Chürök, whom my father raised,"},{"id":"semetey-1-2013:p1259:b003:l012","ordinal":172235,"en":"They have brought great turmoil to her village."},{"id":"semetey-1-2013:p1259:b003:l013","ordinal":172236,"en":"A claimant comes to bring disaster;"},{"id":"semetey-1-2013:p1259:b003:l014","ordinal":172237,"en":"An enemy comes to face us!”"},{"id":"semetey-1-2013:p1259:b003:l015","ordinal":172238,"en":"When Ajybay said this,"},{"id":"semetey-1-2013:p1259:b003:l016","ordinal":172239,"en":"The lion prince Semetey"},{"id":"semetey-1-2013:p1259:b003:l017","ordinal":172240,"en":"Swelled like a lion."},{"id":"semetey-1-2013:p1259:b003:l018","ordinal":172241,"en":"His anger came and would not cease;"},{"id":"semetey-1-2013:p1259:b003:l019","ordinal":172242,"en":"The former fury"},{"id":"semetey-1-2013:p1259:b003:l020","ordinal":172243,"en":"Of the gray wolf, son of Manas, flared."},{"id":"semetey-1-2013:p1259:b003:l021","ordinal":172244,"en":"As Ajybay stood speaking thus,"},{"id":"semetey-1-2013:p1259:b003:l022","ordinal":172245,"en":"His eyes blazed like fire;"},{"id":"semetey-1-2013:p1259:b003:l023","ordinal":172246,"en":"Descendant of the accursed one,"},{"id":"semetey-1-2013:p1259:b003:l024","ordinal":172247,"en":"Bloodlust seized him."},{"id":"semetey-1-2013:p1259:b003:l025","ordinal":172248,"en":"His broad white teeth like a gate—"},{"id":"semetey-1-2013:p1259:b003:l026","ordinal":172249,"en":"Grinding them then,"},{"id":"semetey-1-2013:p1259:b003:l027","ordinal":172250,"en":"He chewed them section by section."},{"id":"semetey-1-2013:p1259:b003:l028","ordinal":172251,"en":"“Ah, Ajybay, my brother-in-law!"},{"id":"semetey-1-2013:p1259:b003:l029","ordinal":172252,"en":"I have oiled my white steel."},{"id":"semetey-1-2013:p1259:b003:l030","ordinal":172253,"en":"When they sorely provoked my anger,"},{"id":"semetey-1-2013:p1259:b003:l031","ordinal":172254,"en":"I laid low the lions"},{"id":"semetey-1-2013:p1259:b003:l032","ordinal":172255,"en":"Of Argyn and Kyrgyz."},{"id":"semetey-1-2013:p1259:b003:l033","ordinal":172256,"en":"Of battles and slaughters such as this,"},{"id":"semetey-1-2013:p1259:b003:l034","ordinal":172257,"en":"I have seen many!”"},{"id":"semetey-1-2013:p1259:b003:l035","ordinal":172258,"en":"Saying this then,"},{"id":"semetey-1-2013:p1259:b003:l036","ordinal":172259,"en":"Semetey raged."},{"id":"semetey-1-2013:p1259:b003:l037","ordinal":172260,"en":"He had karnays and surnays sounded,"},{"id":"semetey-1-2013:p1259:b003:l038","ordinal":172261,"en":"Loaded the army upon camels,"},{"id":"semetey-1-2013:p1259:b003:l039","ordinal":172262,"en":"Had the tulpars tethered,"},{"id":"semetey-1-2013:p1259:b005:l001","ordinal":172263,"en":"And the brave men made ready."},{"id":"semetey-1-2013:p1259:b005:l002","ordinal":172264,"en":"Running like a lion,"},{"id":"semetey-1-2013:p1259:b005:l003","ordinal":172265,"en":"He prepared to exchange fire with Toltoy;"},{"id":"semetey-1-2013:p1259:b005:l004","ordinal":172266,"en":"The lion boy Semetey"},{"id":"semetey-1-2013:p1259:b005:l005","ordinal":172267,"en":"Donned his battle clothing:"},{"id":"semetey-1-2013:p1259:b005:l006","ordinal":172268,"en":"“Let me lift my lower leg"},{"id":"semetey-1-2013:p1259:b005:l007","ordinal":172269,"en":"Upon a charger like Taybuurul;"},{"id":"semetey-1-2013:p1259:b005:l008","ordinal":172270,"en":"Let me test myself in combat"},{"id":"semetey-1-2013:p1259:b005:l009","ordinal":172271,"en":"Against that one who boasts of his might,"},{"id":"semetey-1-2013:p1259:b005:l010","ordinal":172272,"en":"Against my kinsman Chynkojo!”"},{"id":"semetey-1-2013:p1259:b005:l011","ordinal":172273,"en":"From his royal father Manas,"},{"id":"semetey-1-2013:p1259:b005:l012","ordinal":172274,"en":"When entering true slaughter,"},{"id":"semetey-1-2013:p1259:b005:l013","ordinal":172275,"en":"There was a doolbas drum to be beaten;"},{"id":"semetey-1-2013:p1259:b005:l014","ordinal":172276,"en":"When struck, the earth grew still"},{"id":"semetey-1-2013:p1259:b005:l015","ordinal":172277,"en":"And cowards' faces changed."},{"id":"semetey-1-2013:p1259:b005:l016","ordinal":172278,"en":"When beaten, it deafened the ears"},{"id":"semetey-1-2013:p1259:b005:l017","ordinal":172279,"en":"And could be heard from far away."},{"id":"semetey-1-2013:p1259:b005:l018","ordinal":172280,"en":"Made only from the hide of bil,"},{"id":"semetey-1-2013:p1259:b005:l019","ordinal":172281,"en":"When covered it measured three fathoms;"},{"id":"semetey-1-2013:p1259:b005:l020","ordinal":172282,"en":"When the enemy surged upon them,"},{"id":"semetey-1-2013:p1259:b005:l021","ordinal":172283,"en":"His champion beat it for the omen—"},{"id":"semetey-1-2013:p1259:b005:l022","ordinal":172284,"en":"Hear its voice and flee far away."},{"id":"semetey-1-2013:p1259:b005:l023","ordinal":172285,"en":"When the doolbas was beaten,"},{"id":"semetey-1-2013:p1259:b005:l024","ordinal":172286,"en":"It deafened the ears when heard;"},{"id":"semetey-1-2013:p1259:b005:l025","ordinal":172287,"en":"While your falcons lived,"},{"id":"semetey-1-2013:p1259:b005:l026","ordinal":172288,"en":"It had brought turmoil upon many."}]
