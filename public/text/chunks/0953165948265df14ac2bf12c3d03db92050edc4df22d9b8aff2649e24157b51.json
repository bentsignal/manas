[{"id":"semetey-1-2013:p1356:b003:l037","ordinal":180737,"en":"Brought forth an article."},{"id":"semetey-1-2013:p1356:b003:l038","ordinal":180738,"en":"Your dear mother Kanykey"},{"id":"semetey-1-2013:p1356:b003:l039","ordinal":180739,"en":"Made her motherhood known:"},{"id":"semetey-1-2013:p1356:b004:l001","ordinal":180740,"en":"She clothed him in ak-olpok armor"},{"id":"semetey-1-2013:p1356:b004:l002","ordinal":180741,"en":"That no bullet pierced in battle."},{"id":"semetey-1-2013:p1356:b004:l003","ordinal":180742,"en":"The blue saddlebag she brought—"},{"id":"semetey-1-2013:p1356:b004:l004","ordinal":180743,"en":"The blue saddlebag bore no pattern;"},{"id":"semetey-1-2013:p1356:b004:l005","ordinal":180744,"en":"Inside the white saddlebag,"},{"id":"semetey-1-2013:p1356:b004:l006","ordinal":180745,"en":"What was there, and what was not!"},{"id":"semetey-1-2013:p1356:b004:l007","ordinal":180746,"en":"Many champions lifted it;"},{"id":"semetey-1-2013:p1356:b004:l008","ordinal":180747,"en":"Men marveled at the service"},{"id":"semetey-1-2013:p1356:b004:l009","ordinal":180748,"en":"Of your dear, formidable mother."},{"id":"semetey-1-2013:p1356:b004:l010","ordinal":180749,"en":"It held coats of separate kinds;"},{"id":"semetey-1-2013:p1356:b004:l011","ordinal":180750,"en":"Inside that saddlebag"},{"id":"semetey-1-2013:p1356:b004:l012","ordinal":180751,"en":"Were wonders no one had seen."},{"id":"semetey-1-2013:p1356:b004:l013","ordinal":180752,"en":"Your exceptional mother Kanykey,"},{"id":"semetey-1-2013:p1356:b004:l014","ordinal":180753,"en":"Bending her wisdom and pondering,"},{"id":"semetey-1-2013:p1356:b004:l015","ordinal":180754,"en":"Knew he would reach Kakan-Chyn's Beijing"},{"id":"semetey-1-2013:p1356:b004:l016","ordinal":180755,"en":"And grapple there;"},{"id":"semetey-1-2013:p1356:b004:l017","ordinal":180756,"en":"If battle arose suddenly,"},{"id":"semetey-1-2013:p1356:b004:l018","ordinal":180757,"en":"If death came by chance,"},{"id":"semetey-1-2013:p1356:b004:l019","ordinal":180758,"en":"She thought a stray bullet might pass."},{"id":"semetey-1-2013:p1356:b004:l020","ordinal":180759,"en":"Showing her skill,"},{"id":"semetey-1-2013:p1356:b004:l021","ordinal":180760,"en":"She clothed your lion uncle Bakai"},{"id":"semetey-1-2013:p1356:b004:l022","ordinal":180761,"en":"In bulletproof armor."},{"id":"semetey-1-2013:p1356:b004:l023","ordinal":180762,"en":"“Long ago I knew"},{"id":"semetey-1-2013:p1356:b004:l024","ordinal":180763,"en":"Of the costly campaign to Beijing,"},{"id":"semetey-1-2013:p1356:b004:l025","ordinal":180764,"en":"And had prepared many pieces"},{"id":"semetey-1-2013:p1356:b004:l026","ordinal":180765,"en":"Of bulletproof clothing."},{"id":"semetey-1-2013:p1356:b004:l027","ordinal":180766,"en":"So against the teeming infidel,"},{"id":"semetey-1-2013:p1356:b004:l028","ordinal":180767,"en":"Against hero Khan Kongurbai,"},{"id":"semetey-1-2013:p1356:b004:l029","ordinal":180768,"en":"He might fight without fleeing;"},{"id":"semetey-1-2013:p1356:b004:l030","ordinal":180769,"en":"Taking no heed of death,"},{"id":"semetey-1-2013:p1356:b004:l031","ordinal":180770,"en":"Never stopping to say, ‘I shall die,’"},{"id":"semetey-1-2013:p1356:b004:l032","ordinal":180771,"en":"He might press the conflict to its limit;"},{"id":"semetey-1-2013:p1356:b004:l033","ordinal":180772,"en":"Against the overbearing Kalcha"},{"id":"semetey-1-2013:p1356:b004:l034","ordinal":180773,"en":"He might go sharp and resolute,"},{"id":"semetey-1-2013:p1356:b004:l035","ordinal":180774,"en":"Roaring in wrath,"},{"id":"semetey-1-2013:p1356:b004:l036","ordinal":180775,"en":"Raising the battle cry of his royal father Manas,"},{"id":"semetey-1-2013:p1356:b004:l037","ordinal":180776,"en":"He might strike the foe without fleeing,"},{"id":"semetey-1-2013:p1356:b004:l038","ordinal":180777,"en":"And enter battle without tiring."},{"id":"semetey-1-2013:p1356:b004:l039","ordinal":180778,"en":"If they stand face-to-face,"},{"id":"semetey-1-2013:p1357:b003:l001","ordinal":180779,"en":"Holding each other's reins,"},{"id":"semetey-1-2013:p1357:b003:l002","ordinal":180780,"en":"Fighting face-to-face,"},{"id":"semetey-1-2013:p1357:b003:l003","ordinal":180781,"en":"Shouting and striking with axes,"},{"id":"semetey-1-2013:p1357:b003:l004","ordinal":180782,"en":"Grappling from the very hem,"},{"id":"semetey-1-2013:p1357:b003:l005","ordinal":180783,"en":"Until they exhaust one another—"},{"id":"semetey-1-2013:p1357:b003:l006","ordinal":180784,"en":"It would be vain if I failed to foresee it."},{"id":"semetey-1-2013:p1357:b003:l007","ordinal":180785,"en":"If I failed to foresee this affair,"},{"id":"semetey-1-2013:p1357:b003:l008","ordinal":180786,"en":"An axe or sword might pass through,"},{"id":"semetey-1-2013:p1357:b003:l009","ordinal":180787,"en":"And needless death might overtake him."},{"id":"semetey-1-2013:p1357:b003:l010","ordinal":180788,"en":"I had its inside lined with silk;"},{"id":"semetey-1-2013:p1357:b003:l011","ordinal":180789,"en":"Its four sides were wondrous—"},{"id":"semetey-1-2013:p1357:b003:l012","ordinal":180790,"en":"I had them reinforced with sharp steel,"},{"id":"semetey-1-2013:p1357:b003:l013","ordinal":180791,"en":"Cast from yellow gold"},{"id":"semetey-1-2013:p1357:b003:l014","ordinal":180792,"en":"And placed within its middle."},{"id":"semetey-1-2013:p1357:b003:l015","ordinal":180793,"en":"For seven years I watched and repaired it,"},{"id":"semetey-1-2013:p1357:b003:l016","ordinal":180794,"en":"Intending it for the battle"},{"id":"semetey-1-2013:p1357:b003:l017","ordinal":180795,"en":"Of my renowned son."},{"id":"semetey-1-2013:p1357:b003:l018","ordinal":180796,"en":"A deep-blue iron helmet"},{"id":"semetey-1-2013:p1357:b003:l019","ordinal":180797,"en":"And coat of mail, for him to wear together;"},{"id":"semetey-1-2013:p1357:b003:l020","ordinal":180798,"en":"So he might cross their fastenings"},{"id":"semetey-1-2013:p1357:b003:l021","ordinal":180799,"en":"And tie them beneath his throat;"},{"id":"semetey-1-2013:p1357:b003:l022","ordinal":180800,"en":"So he might know this service."},{"id":"semetey-1-2013:p1357:b003:l023","ordinal":180801,"en":"It is indeed true that possessions"},{"id":"semetey-1-2013:p1357:b003:l024","ordinal":180802,"en":"Are the protection of a life held in trust;"},{"id":"semetey-1-2013:p1357:b003:l025","ordinal":180803,"en":"It is also true that a sharp weapon"},{"id":"semetey-1-2013:p1357:b003:l026","ordinal":180804,"en":"Shatters when struck against it."},{"id":"semetey-1-2013:p1357:b003:l027","ordinal":180805,"en":"I have been making these things;"},{"id":"semetey-1-2013:p1357:b003:l028","ordinal":180806,"en":"Hear of this labor of mine!"},{"id":"semetey-1-2013:p1357:b003:l029","ordinal":180807,"en":"Know the value of it when you go,"},{"id":"semetey-1-2013:p1357:b003:l030","ordinal":180808,"en":"And say, ‘My mother suffered hardship!’"},{"id":"semetey-1-2013:p1357:b003:l031","ordinal":180809,"en":"A true helmet and coat of mail—"},{"id":"semetey-1-2013:p1357:b003:l032","ordinal":180810,"en":"My valiant son, wear them when you go!"},{"id":"semetey-1-2013:p1357:b003:l033","ordinal":180811,"en":"I, your unfortunate mother,"},{"id":"semetey-1-2013:p1357:b003:l034","ordinal":180812,"en":"Have many kinds of armor;"},{"id":"semetey-1-2013:p1357:b003:l035","ordinal":180813,"en":"To give you, my son,"},{"id":"semetey-1-2013:p1357:b003:l036","ordinal":180814,"en":"I have many kinds of wonders."},{"id":"semetey-1-2013:p1357:b003:l037","ordinal":180815,"en":"My heart is shut in grief, my soul aflame;"},{"id":"semetey-1-2013:p1357:b003:l038","ordinal":180816,"en":"In this mother's hands,"},{"id":"semetey-1-2013:p1357:b003:l039","ordinal":180817,"en":"What is there, and what is not!"},{"id":"semetey-1-2013:p1357:b004:l001","ordinal":180818,"en":"That you would grapple with the khagan,"},{"id":"semetey-1-2013:p1357:b004:l002","ordinal":180819,"en":"And stand unleashing turmoil,"},{"id":"semetey-1-2013:p1357:b004:l003","ordinal":180820,"en":"Bringing fierce upheaval,"},{"id":"semetey-1-2013:p1357:b004:l004","ordinal":180821,"en":"That you would campaign"},{"id":"semetey-1-2013:p1357:b004:l005","ordinal":180822,"en":"Against Kakan-Chyn's Beijing—"},{"id":"semetey-1-2013:p1357:b004:l006","ordinal":180823,"en":"I knew it long ago!"},{"id":"semetey-1-2013:p1357:b004:l007","ordinal":180824,"en":"So my orphan with his noble calling might wear it,"},{"id":"semetey-1-2013:p1357:b004:l008","ordinal":180825,"en":"I had prepared many pieces!"},{"id":"semetey-1-2013:p1357:b004:l009","ordinal":180826,"en":"As I stood pondering,"},{"id":"semetey-1-2013:p1357:b004:l010","ordinal":180827,"en":"On account of my youthful son,"},{"id":"semetey-1-2013:p1357:b004:l011","ordinal":180828,"en":"God's sun darkened in the sky;"},{"id":"semetey-1-2013:p1357:b004:l012","ordinal":180829,"en":"Sixty worries came upon my head at once."},{"id":"semetey-1-2013:p1357:b004:l013","ordinal":180830,"en":"My hair twisted like reins;"},{"id":"semetey-1-2013:p1357:b004:l014","ordinal":180831,"en":"Yesterday, unable to stand from true grief,"},{"id":"semetey-1-2013:p1357:b004:l015","ordinal":180832,"en":"I summoned the lame smith Bölökbai"},{"id":"semetey-1-2013:p1357:b004:l016","ordinal":180833,"en":"And forty Kalcha craftsmen."},{"id":"semetey-1-2013:p1357:b004:l017","ordinal":180834,"en":"I had them wear the jekeybos coat;"},{"id":"semetey-1-2013:p1357:b004:l018","ordinal":180835,"en":"I, wretched and resourceful,"},{"id":"semetey-1-2013:p1357:b004:l019","ordinal":180836,"en":"Mounted them on ambling horses that did not gallop,"},{"id":"semetey-1-2013:p1357:b004:l020","ordinal":180837,"en":"And had them search the whole earth."},{"id":"semetey-1-2013:p1357:b004:l021","ordinal":180838,"en":"I had heard much from those who had seen"},{"id":"semetey-1-2013:p1357:b004:l022","ordinal":180839,"en":"The ibex of Jetik-Too,"},{"id":"semetey-1-2013:p1357:b004:l023","ordinal":180840,"en":"And from all who knew"},{"id":"semetey-1-2013:p1357:b004:l024","ordinal":180841,"en":"That nowhere was there any hide"},{"id":"semetey-1-2013:p1357:b004:l025","ordinal":180842,"en":"Like its hide."},{"id":"semetey-1-2013:p1357:b004:l026","ordinal":180843,"en":"I loaded provisions on camels,"},{"id":"semetey-1-2013:p1357:b004:l027","ordinal":180844,"en":"And had the mountain ibex of Jetkileng"},{"id":"semetey-1-2013:p1357:b004:l028","ordinal":180845,"en":"Shot after they went to Jet-Kait."},{"id":"semetey-1-2013:p1357:b004:l029","ordinal":180846,"en":"Keeping it from the eye of the sun,"},{"id":"semetey-1-2013:p1357:b004:l030","ordinal":180847,"en":"I laid it in the shade;"},{"id":"semetey-1-2013:p1357:b004:l031","ordinal":180848,"en":"I, wretched woman, seasoned its hide,"},{"id":"semetey-1-2013:p1357:b004:l032","ordinal":180849,"en":"Resting neither by day"},{"id":"semetey-1-2013:p1357:b004:l033","ordinal":180850,"en":"Nor sleeping at night."},{"id":"semetey-1-2013:p1357:b004:l034","ordinal":180851,"en":"I had it worked by my own hand;"},{"id":"semetey-1-2013:p1357:b004:l035","ordinal":180852,"en":"Lest its curing remain incomplete,"},{"id":"semetey-1-2013:p1357:b004:l036","ordinal":180853,"en":"I had exactly eighty-five strong men"},{"id":"semetey-1-2013:p1357:b004:l037","ordinal":180854,"en":"Work it without pause for six months,"},{"id":"semetey-1-2013:p1357:b004:l038","ordinal":180855,"en":"Bringing its curing to perfection,"},{"id":"semetey-1-2013:p1357:b004:l039","ordinal":180856,"en":"And had skilled men cut it,"},{"id":"semetey-1-2013:p1358:b003:l001","ordinal":180857,"en":"The ill-fated hide"},{"id":"semetey-1-2013:p1358:b003:l002","ordinal":180858,"en":"Folded bellywise like a snake."},{"id":"semetey-1-2013:p1358:b003:l003","ordinal":180859,"en":"I gathered every seamstress"},{"id":"semetey-1-2013:p1358:b003:l004","ordinal":180860,"en":"And had it sewn with tiny stitches;"},{"id":"semetey-1-2013:p1358:b003:l005","ordinal":180861,"en":"I had skilled workers test it,"},{"id":"semetey-1-2013:p1358:b003:l006","ordinal":180862,"en":"And lined its inside with silk."},{"id":"semetey-1-2013:p1358:b003:l007","ordinal":180863,"en":"Forty Kyrgyz daughters-in-law"},{"id":"semetey-1-2013:p1358:b003:l008","ordinal":180864,"en":"Bit and tightened its seams;"},{"id":"semetey-1-2013:p1358:b003:l009","ordinal":180865,"en":"I had them reject what was unsuitable,"},{"id":"semetey-1-2013:p1358:b003:l010","ordinal":180866,"en":"File down steel,"},{"id":"semetey-1-2013:p1358:b003:l011","ordinal":180867,"en":"And pour it between the layers."},{"id":"semetey-1-2013:p1358:b003:l012","ordinal":180868,"en":"The sight of it satisfied the eye;"},{"id":"semetey-1-2013:p1358:b003:l013","ordinal":180869,"en":"I fitted and repaired it,"},{"id":"semetey-1-2013:p1358:b003:l014","ordinal":180870,"en":"So a thrusting spear would not pass."},{"id":"semetey-1-2013:p1358:b003:l015","ordinal":180871,"en":"I intended it for the conflict"},{"id":"semetey-1-2013:p1358:b003:l016","ordinal":180872,"en":"With hero Khan Kongurbai!"},{"id":"semetey-1-2013:p1358:b003:l017","ordinal":180873,"en":"When Kandagai is gripped and pulled,"},{"id":"semetey-1-2013:p1358:b003:l018","ordinal":180874,"en":"It stretches like glue;"},{"id":"semetey-1-2013:p1358:b003:l019","ordinal":180875,"en":"When Kandagai is released,"},{"id":"semetey-1-2013:p1358:b003:l020","ordinal":180876,"en":"It gathers like a tendon."},{"id":"semetey-1-2013:p1358:b003:l021","ordinal":180877,"en":"The sight of it satisfies the heart;"},{"id":"semetey-1-2013:p1358:b003:l022","ordinal":180878,"en":"If struck with a shout,"},{"id":"semetey-1-2013:p1358:b003:l023","ordinal":180879,"en":"Even a thrusting spear will not pass,"},{"id":"semetey-1-2013:p1358:b003:l024","ordinal":180880,"en":"And the hand gripping it grows weary."},{"id":"semetey-1-2013:p1358:b003:l025","ordinal":180881,"en":"If an Ochogor gun fires, its bullet will not pass,"},{"id":"semetey-1-2013:p1358:b003:l026","ordinal":180882,"en":"But lodges within its middle."},{"id":"semetey-1-2013:p1358:b003:l027","ordinal":180883,"en":"With a golden border at its rim,"},{"id":"semetey-1-2013:p1358:b003:l028","ordinal":180884,"en":"The ill-fated Kandagai,"},{"id":"semetey-1-2013:p1358:b003:l029","ordinal":180885,"en":"All of its wrist guards"},{"id":"semetey-1-2013:p1358:b003:l030","ordinal":180886,"en":"Were embroidered in pure gold."},{"id":"semetey-1-2013:p1358:b003:l031","ordinal":180887,"en":"I worked twin spade-shaped ornaments into it;"},{"id":"semetey-1-2013:p1358:b003:l032","ordinal":180888,"en":"So its seams would not come apart,"},{"id":"semetey-1-2013:p1358:b003:l033","ordinal":180889,"en":"I wrapped them with yellow gold."},{"id":"semetey-1-2013:p1358:b003:l034","ordinal":180890,"en":"Beijing was a formidable place,"},{"id":"semetey-1-2013:p1358:b003:l035","ordinal":180891,"en":"Its people wicked and dangerous;"},{"id":"semetey-1-2013:p1358:b003:l036","ordinal":180892,"en":"If they stood facing one another,"},{"id":"semetey-1-2013:p1358:b003:l037","ordinal":180893,"en":"Firing guns and drawing bows,"},{"id":"semetey-1-2013:p1358:b003:l038","ordinal":180894,"en":"And fought with all their might,"},{"id":"semetey-1-2013:p1358:b003:l039","ordinal":180895,"en":"Arrowheads would shriek,"},{"id":"semetey-1-2013:p1358:b004:l001","ordinal":180896,"en":"Their points of impact burst apart,"},{"id":"semetey-1-2013:p1358:b004:l002","ordinal":180897,"en":"And spilled blood gush."},{"id":"semetey-1-2013:p1358:b004:l003","ordinal":180898,"en":"Lest needless death overtake him,"},{"id":"semetey-1-2013:p1358:b004:l004","ordinal":180899,"en":"And he leave this world clear-eyed"},{"id":"semetey-1-2013:p1358:b004:l005","ordinal":180900,"en":"Yet filled with regret,"},{"id":"semetey-1-2013:p1358:b004:l006","ordinal":180901,"en":"Costly Kandagai—"},{"id":"semetey-1-2013:p1358:b004:l007","ordinal":180902,"en":"I have been making it."},{"id":"semetey-1-2013:p1358:b004:l008","ordinal":180903,"en":"My precious orphan, listen well!"},{"id":"semetey-1-2013:p1358:b004:l009","ordinal":180904,"en":"Many strong men worked and softened it;"},{"id":"semetey-1-2013:p1358:b004:l010","ordinal":180905,"en":"If you take it to Beijing, there will be great conflict!"},{"id":"semetey-1-2013:p1358:b004:l011","ordinal":180906,"en":"Its opening has a broad border;"},{"id":"semetey-1-2013:p1358:b004:l012","ordinal":180907,"en":"If you wear it in battle, my foal,"},{"id":"semetey-1-2013:p1358:b004:l013","ordinal":180908,"en":"It is a shield for your entrusted life!"},{"id":"semetey-1-2013:p1358:b004:l014","ordinal":180909,"en":"Receiving messages from many places,"},{"id":"semetey-1-2013:p1358:b004:l015","ordinal":180910,"en":"My orphan, my support—"},{"id":"semetey-1-2013:p1358:b004:l016","ordinal":180911,"en":"Wondering whether he would remain safe,"},{"id":"semetey-1-2013:p1358:b004:l017","ordinal":180912,"en":"I specially kept preparing it!"},{"id":"semetey-1-2013:p1358:b004:l018","ordinal":180913,"en":"The one you grapple is Kakan-Chyn;"},{"id":"semetey-1-2013:p1358:b004:l019","ordinal":180914,"en":"The one you oppose is Bakburchun."},{"id":"semetey-1-2013:p1358:b004:l020","ordinal":180915,"en":"My orphan foal, listen:"},{"id":"semetey-1-2013:p1358:b004:l021","ordinal":180916,"en":"Wear it when you go to battle;"},{"id":"semetey-1-2013:p1358:b004:l022","ordinal":180917,"en":"The road to Beijing is a perilous road,"},{"id":"semetey-1-2013:p1358:b004:l023","ordinal":180918,"en":"Face the foe and strike!”"},{"id":"semetey-1-2013:p1358:b004:l024","ordinal":180919,"en":"Weeping bitterly, Kanykey"},{"id":"semetey-1-2013:p1358:b004:l025","ordinal":180920,"en":"Now gave him the Kandagai."},{"id":"semetey-1-2013:p1358:b004:l026","ordinal":180921,"en":"When one looked at the Kandagai,"},{"id":"semetey-1-2013:p1358:b004:l027","ordinal":180922,"en":"One saw the skill"},{"id":"semetey-1-2013:p1358:b004:l028","ordinal":180923,"en":"Of your dear, formidable mother."},{"id":"semetey-1-2013:p1358:b004:l029","ordinal":180924,"en":"Kandagai was exceedingly precious,"},{"id":"semetey-1-2013:p1358:b004:l030","ordinal":180925,"en":"With a worth no man could attain;"},{"id":"semetey-1-2013:p1358:b004:l031","ordinal":180926,"en":"So her son might prepare and wear it,"},{"id":"semetey-1-2013:p1358:b004:l032","ordinal":180927,"en":"So he might strike the foe without tiring,"},{"id":"semetey-1-2013:p1358:b004:l033","ordinal":180928,"en":"The mighty queen had made"},{"id":"semetey-1-2013:p1358:b004:l034","ordinal":180929,"en":"The Kandagai!"},{"id":"semetey-1-2013:p1358:b004:l035","ordinal":180930,"en":"True saint Kanykey—"},{"id":"semetey-1-2013:p1358:b004:l036","ordinal":180931,"en":"Most skillful of the long-haired,"},{"id":"semetey-1-2013:p1358:b004:l037","ordinal":180932,"en":"The finest of women."},{"id":"semetey-1-2013:p1358:b004:l038","ordinal":180933,"en":"Dear queen Kanykey,"},{"id":"semetey-1-2013:p1358:b004:l039","ordinal":180934,"en":"The purest of womankind,"},{"id":"semetey-1-2013:p1359:b003:l001","ordinal":180935,"en":"Foremost among women in white kerchiefs."},{"id":"semetey-1-2013:p1359:b003:l002","ordinal":180936,"en":"The one you oppose is Kakan-Chyn,"},{"id":"semetey-1-2013:p1359:b003:l003","ordinal":180937,"en":"O mighty Bakai, my support!"},{"id":"semetey-1-2013:p1359:b003:l004","ordinal":180938,"en":"Without turning from the land of Beijing,"},{"id":"semetey-1-2013:p1359:b003:l005","ordinal":180939,"en":"You have set off in pursuit;"},{"id":"semetey-1-2013:p1359:b003:l006","ordinal":180940,"en":"Without turning, beginning a holy war,"},{"id":"semetey-1-2013:p1359:b003:l007","ordinal":180941,"en":"You have set off seeking blood vengeance."},{"id":"semetey-1-2013:p1359:b003:l008","ordinal":180942,"en":"May the enemy who attacks you be overcome!"},{"id":"semetey-1-2013:p1359:b003:l009","ordinal":180943,"en":"May my Lord prosper your undertaking;"},{"id":"semetey-1-2013:p1359:b003:l010","ordinal":180944,"en":"May Khizir support your road!"},{"id":"semetey-1-2013:p1359:b003:l011","ordinal":180945,"en":"May your tiger father charge forth"},{"id":"semetey-1-2013:p1359:b003:l012","ordinal":180946,"en":"And appear on your road to support you!"},{"id":"semetey-1-2013:p1359:b003:l013","ordinal":180947,"en":"I have this precious thing;"},{"id":"semetey-1-2013:p1359:b003:l014","ordinal":180948,"en":"My blessed son, listen well!"},{"id":"semetey-1-2013:p1359:b003:l015","ordinal":180949,"en":"Buttoning its front,"},{"id":"semetey-1-2013:p1359:b003:l016","ordinal":180950,"en":"Covering his broad chest,"},{"id":"semetey-1-2013:p1359:b003:l017","ordinal":180951,"en":"So my son might wear it when breaking the host,"},{"id":"semetey-1-2013:p1359:b003:l018","ordinal":180952,"en":"Roaring and taking the risk,"},{"id":"semetey-1-2013:p1359:b003:l019","ordinal":180953,"en":"So he might strike the foe without stopping,"},{"id":"semetey-1-2013:p1359:b003:l020","ordinal":180954,"en":"Break apart the Chinese host,"},{"id":"semetey-1-2013:p1359:b003:l021","ordinal":180955,"en":"And drive them as far as the khagan,"},{"id":"semetey-1-2013:p1359:b003:l022","ordinal":180956,"en":"I made four articles for you four;"},{"id":"semetey-1-2013:p1359:b003:l023","ordinal":180957,"en":"Prince Bakai, the work was hard!"},{"id":"semetey-1-2013:p1359:b003:l024","ordinal":180958,"en":"That you would bring turmoil"},{"id":"semetey-1-2013:p1359:b003:l025","ordinal":180959,"en":"Upon Kakan-Chyn, I knew long ago."},{"id":"semetey-1-2013:p1359:b003:l026","ordinal":180960,"en":"That you would lead your boys"},{"id":"semetey-1-2013:p1359:b003:l027","ordinal":180961,"en":"Against the teeming Chinese,"},{"id":"semetey-1-2013:p1359:b003:l028","ordinal":180962,"en":"I knew long ago;"},{"id":"semetey-1-2013:p1359:b003:l029","ordinal":180963,"en":"That you would unleash calamity and horror,"},{"id":"semetey-1-2013:p1359:b003:l030","ordinal":180964,"en":"I knew long ago."},{"id":"semetey-1-2013:p1359:b003:l031","ordinal":180965,"en":"So he might wear it against his body,"},{"id":"semetey-1-2013:p1359:b003:l032","ordinal":180966,"en":"And face and strike the enemy,"},{"id":"semetey-1-2013:p1359:b003:l033","ordinal":180967,"en":"I have a short coat of plate armor."},{"id":"semetey-1-2013:p1359:b003:l034","ordinal":180968,"en":"When I tell it, it holds such wonders."},{"id":"semetey-1-2013:p1359:b003:l035","ordinal":180969,"en":"Whoever wears it need have little regret;"},{"id":"semetey-1-2013:p1359:b003:l036","ordinal":180970,"en":"If the gray wolves put it on"},{"id":"semetey-1-2013:p1359:b003:l037","ordinal":180971,"en":"And take it to China, there will be great conflict."},{"id":"semetey-1-2013:p1359:b003:l038","ordinal":180972,"en":"This barren, slippery world—"},{"id":"semetey-1-2013:p1359:b003:l039","ordinal":180973,"en":"If they should raid the horses,"},{"id":"semetey-1-2013:p1359:b004:l001","ordinal":180974,"en":"And fight one-on-one"},{"id":"semetey-1-2013:p1359:b004:l002","ordinal":180975,"en":"With mighty hero Kongurbai,"},{"id":"semetey-1-2013:p1359:b004:l003","ordinal":180976,"en":"I feared a spear thrust might pass through."},{"id":"semetey-1-2013:p1359:b004:l004","ordinal":180977,"en":"I, black-faced Kanykey,"},{"id":"semetey-1-2013:p1359:b004:l005","ordinal":180978,"en":"Would have labored in vain if I had not foreseen it;"},{"id":"semetey-1-2013:p1359:b004:l006","ordinal":180979,"en":"Long ago I prepared"},{"id":"semetey-1-2013:p1359:b004:l007","ordinal":180980,"en":"This bulletproof armor."},{"id":"semetey-1-2013:p1359:b004:l008","ordinal":180981,"en":"Across the front of the shoulder,"},{"id":"semetey-1-2013:p1359:b004:l009","ordinal":180982,"en":"Along the edge of the ribs,"},{"id":"semetey-1-2013:p1359:b004:l010","ordinal":180983,"en":"I had fitted and fashioned"},{"id":"semetey-1-2013:p1359:b004:l011","ordinal":180984,"en":"Iron reinforcing bands."},{"id":"semetey-1-2013:p1359:b004:l012","ordinal":180985,"en":"It has nine buttons;"},{"id":"semetey-1-2013:p1359:b004:l013","ordinal":180986,"en":"So he might wear it buttoned,"},{"id":"semetey-1-2013:p1359:b004:l014","ordinal":180987,"en":"And go without stopping to strike"},{"id":"semetey-1-2013:p1359:b004:l015","ordinal":180988,"en":"Enemies who roll against him;"},{"id":"semetey-1-2013:p1359:b004:l016","ordinal":180989,"en":"So upon the foe he faces"},{"id":"semetey-1-2013:p1359:b004:l017","ordinal":180990,"en":"He might firmly bring hardship;"},{"id":"semetey-1-2013:p1359:b004:l018","ordinal":180991,"en":"So my orphan might enter boldly"},{"id":"semetey-1-2013:p1359:b004:l019","ordinal":180992,"en":"And avenge his father Manas,"}]
