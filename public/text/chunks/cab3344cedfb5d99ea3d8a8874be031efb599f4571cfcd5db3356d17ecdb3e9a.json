[{"id":"semetey-2-2013:p1333:b003:l006","ordinal":288257,"en":"No mountain could withstand him;"},{"id":"semetey-2-2013:p1333:b003:l007","ordinal":288258,"en":"Even the Kyrgyz in all their multitude"},{"id":"semetey-2-2013:p1333:b003:l008","ordinal":288259,"en":"Could not defeat this Choro."},{"id":"semetey-2-2013:p1333:b003:l009","ordinal":288260,"en":"He sprang like a tiger;"},{"id":"semetey-2-2013:p1333:b003:l010","ordinal":288261,"en":"No one who fought him would survive."},{"id":"semetey-2-2013:p1333:b003:l011","ordinal":288262,"en":"He made ready like a wild boar."},{"id":"semetey-2-2013:p1333:b003:l012","ordinal":288263,"en":"The great host was struck speechless"},{"id":"semetey-2-2013:p1333:b003:l013","ordinal":288264,"en":"And simply despaired of life;"},{"id":"semetey-2-2013:p1333:b003:l014","ordinal":288265,"en":"Unable to collect their wits,"},{"id":"semetey-2-2013:p1333:b003:l015","ordinal":288266,"en":"The people clamored in bewilderment."},{"id":"semetey-2-2013:p1333:b003:l016","ordinal":288267,"en":"A calamity befell the multitude:"},{"id":"semetey-2-2013:p1333:b003:l017","ordinal":288268,"en":"Fierce as a mountain, potent in venom,"},{"id":"semetey-2-2013:p1333:b003:l018","ordinal":288269,"en":"Choro stood roaring."},{"id":"semetey-2-2013:p1333:b003:l019","ordinal":288270,"en":"Without speaking or saying a word,"},{"id":"semetey-2-2013:p1333:b003:l020","ordinal":288271,"en":"The great people stood crushed."},{"id":"semetey-2-2013:p1333:b003:l021","ordinal":288272,"en":"He spoke like a storm and began his address,"},{"id":"semetey-2-2013:p1333:b003:l022","ordinal":288273,"en":"Overwhelming the assembled people."},{"id":"semetey-2-2013:p1333:b003:l023","ordinal":288274,"en":"Jylgyn and Keng-Kol became a ravine;"},{"id":"semetey-2-2013:p1333:b003:l024","ordinal":288275,"en":"Kanchoro arose from among his own"},{"id":"semetey-2-2013:p1333:b003:l025","ordinal":288276,"en":"To become, for the Argyn and Kyrgyz,"},{"id":"semetey-2-2013:p1333:b003:l026","ordinal":288277,"en":"An enemy worse than the Chinese."},{"id":"semetey-2-2013:p1333:b003:l027","ordinal":288278,"en":"The dear people sobbed and wept,"},{"id":"semetey-2-2013:p1333:b003:l028","ordinal":288279,"en":"Grieving in utter anguish,"},{"id":"semetey-2-2013:p1333:b003:l029","ordinal":288280,"en":"Bereft of their mighty warrior."},{"id":"semetey-2-2013:p1333:b003:l030","ordinal":288281,"en":"“What kind of age is this?” they cried,"},{"id":"semetey-2-2013:p1333:b003:l031","ordinal":288282,"en":"And all the people stood lamenting."},{"id":"semetey-2-2013:p1333:b003:l032","ordinal":288283,"en":"At the wrath of Khan Kanchoro,"},{"id":"semetey-2-2013:p1333:b003:l033","ordinal":288284,"en":"Khan and commoner alike were amazed."},{"id":"semetey-2-2013:p1333:b003:l034","ordinal":288285,"en":"Kanchoro began his fury;"},{"id":"semetey-2-2013:p1333:b003:l035","ordinal":288286,"en":"The people who witnessed it"},{"id":"semetey-2-2013:p1333:b003:l036","ordinal":288287,"en":"Renounced not only their livestock"},{"id":"semetey-2-2013:p1333:b003:l037","ordinal":288288,"en":"But even life itself."},{"id":"semetey-2-2013:p1333:b003:l038","ordinal":288289,"en":"He donned his arrow-proof coat,"},{"id":"semetey-2-2013:p1333:b003:l039","ordinal":288290,"en":"As though about to plunge deep into battle."},{"id":"semetey-2-2013:p1333:b004:l001","ordinal":288291,"en":"He split the tail of his mount"},{"id":"semetey-2-2013:p1333:b004:l002","ordinal":288292,"en":"Diagonally and tied it in a hard knot."},{"id":"semetey-2-2013:p1333:b004:l003","ordinal":288293,"en":"He turned his tulpar's head;"},{"id":"semetey-2-2013:p1333:b004:l004","ordinal":288294,"en":"The crested banner appeared in his hand."},{"id":"semetey-2-2013:p1333:b004:l005","ordinal":288295,"en":"The hearts of all the watching people"},{"id":"semetey-2-2013:p1333:b004:l006","ordinal":288296,"en":"Were torn grievously apart."},{"id":"semetey-2-2013:p1333:b004:l007","ordinal":288297,"en":"The Grey Wolf's hardy sons cried,"},{"id":"semetey-2-2013:p1333:b004:l008","ordinal":288298,"en":"“What age is this, what day?"},{"id":"semetey-2-2013:p1333:b004:l009","ordinal":288299,"en":"What sort of night must we behold?”"},{"id":"semetey-2-2013:p1333:b004:l010","ordinal":288300,"en":"The people clamored and grieved;"},{"id":"semetey-2-2013:p1333:b004:l011","ordinal":288301,"en":"The birch wept and the willow wept,"},{"id":"semetey-2-2013:p1333:b004:l012","ordinal":288302,"en":"Every living soul who looked on wept,"},{"id":"semetey-2-2013:p1333:b004:l013","ordinal":288303,"en":"The men who claimed courage wept;"},{"id":"semetey-2-2013:p1333:b004:l014","ordinal":288304,"en":"Look—the black earth itself wept."},{"id":"semetey-2-2013:p1333:b004:l015","ordinal":288305,"en":"The dear Argyn and Kyrgyz people"},{"id":"semetey-2-2013:p1333:b004:l016","ordinal":288306,"en":"Moved among them, wailing."},{"id":"semetey-2-2013:p1333:b004:l017","ordinal":288307,"en":"While the populace stood thus,"},{"id":"semetey-2-2013:p1333:b004:l018","ordinal":288308,"en":"What did Khan Kanchoro do?"},{"id":"semetey-2-2013:p1333:b004:l019","ordinal":288309,"en":"He went jingling on, unconcerned,"},{"id":"semetey-2-2013:p1333:b004:l020","ordinal":288310,"en":"Counting the clamor of the people"},{"id":"semetey-2-2013:p1333:b004:l021","ordinal":288311,"en":"As no more than the cuff of his trousers."},{"id":"semetey-2-2013:p1333:b004:l022","ordinal":288312,"en":"He did not regard a dusty black ridge"},{"id":"semetey-2-2013:p1333:b004:l023","ordinal":288313,"en":"As even a mountain pass,"},{"id":"semetey-2-2013:p1333:b004:l024","ordinal":288314,"en":"Nor did he regard the people's clamor"},{"id":"semetey-2-2013:p1333:b004:l025","ordinal":288315,"en":"As so much as grass."},{"id":"semetey-2-2013:p1333:b004:l026","ordinal":288316,"en":"The goatskin war drum—"},{"id":"semetey-2-2013:p1333:b004:l027","ordinal":288317,"en":"He beat the great drum."},{"id":"semetey-2-2013:p1333:b004:l028","ordinal":288318,"en":"In Jeti-Özön the Jediger,"},{"id":"semetey-2-2013:p1333:b004:l029","ordinal":288319,"en":"The vast, eager-standing host,"},{"id":"semetey-2-2013:p1333:b004:l030","ordinal":288320,"en":"He roused every one of them."},{"id":"semetey-2-2013:p1333:b004:l031","ordinal":288321,"en":"Damn you, Jediger!"},{"id":"semetey-2-2013:p1333:b004:l032","ordinal":288322,"en":"Obey the words of Khan Kanchoro;"},{"id":"semetey-2-2013:p1333:b004:l033","ordinal":288323,"en":"Let all the people enter upon his plan."},{"id":"semetey-2-2013:p1333:b004:l034","ordinal":288324,"en":"In Kara-Buura and Chatkal,"},{"id":"semetey-2-2013:p1333:b004:l035","ordinal":288325,"en":"The many herds of horses left in sight"},{"id":"semetey-2-2013:p1333:b004:l036","ordinal":288326,"en":"Must be grazing there in sweeping ranks."},{"id":"semetey-2-2013:p1333:b004:l037","ordinal":288327,"en":"The sunny side of the horse range"},{"id":"semetey-2-2013:p1333:b004:l038","ordinal":288328,"en":"Lies on the ridge of Jorgo-Küyük;"},{"id":"semetey-2-2013:p1333:b004:l039","ordinal":288329,"en":"The shaded side of the horse range—"},{"id":"semetey-2-2013:p1334:b003:l001","ordinal":288330,"en":"Faces toward Bek-Jailoo,"},{"id":"semetey-2-2013:p1334:b003:l002","ordinal":288331,"en":"Its pass-side toward Kan-Jailoo."},{"id":"semetey-2-2013:p1334:b003:l003","ordinal":288332,"en":"On the ridge of Kan-Jailoo,"},{"id":"semetey-2-2013:p1334:b003:l004","ordinal":288333,"en":"The nearer side of the horse range"},{"id":"semetey-2-2013:p1334:b003:l005","ordinal":288334,"en":"Is by Üch-Koshoi and Keng-Shor."},{"id":"semetey-2-2013:p1334:b003:l006","ordinal":288335,"en":"Wreak havoc and raise turmoil;"},{"id":"semetey-2-2013:p1334:b003:l007","ordinal":288336,"en":"This mighty warrior's countless horses—"},{"id":"semetey-2-2013:p1334:b003:l008","ordinal":288337,"en":"Plunder and drive them off."},{"id":"semetey-2-2013:p1334:b003:l009","ordinal":288338,"en":"Jediger of Jeti-Özön,"},{"id":"semetey-2-2013:p1334:b003:l010","ordinal":288339,"en":"All of you who are able,"},{"id":"semetey-2-2013:p1334:b003:l011","ordinal":288340,"en":"Drive away seven thousand horses each;"},{"id":"semetey-2-2013:p1334:b003:l012","ordinal":288341,"en":"You weaklings unable to manage that,"},{"id":"semetey-2-2013:p1334:b003:l013","ordinal":288342,"en":"Drive away seven hundred each;"},{"id":"semetey-2-2013:p1334:b003:l014","ordinal":288343,"en":"You weaklings unable to manage that,"},{"id":"semetey-2-2013:p1334:b003:l015","ordinal":288344,"en":"Drive away seven hundred horses each"},{"id":"semetey-2-2013:p1334:b003:l016","ordinal":288345,"en":"And make them your plunder."},{"id":"semetey-2-2013:p1334:b003:l017","ordinal":288346,"en":"Twelve tümön of abundant livestock—"},{"id":"semetey-2-2013:p1334:b003:l018","ordinal":288347,"en":"Thus plunder and seize them."},{"id":"semetey-2-2013:p1334:b003:l019","ordinal":288348,"en":"Then all your misfortune will vanish,"},{"id":"semetey-2-2013:p1334:b003:l020","ordinal":288349,"en":"And you great black host of Jediger"},{"id":"semetey-2-2013:p1334:b003:l021","ordinal":288350,"en":"Will lie at ease with swollen bellies."},{"id":"semetey-2-2013:p1334:b003:l022","ordinal":288351,"en":"Unleash the passion in your hearts;"},{"id":"semetey-2-2013:p1334:b003:l023","ordinal":288352,"en":"In this way pass beyond misfortune."},{"id":"semetey-2-2013:p1334:b003:l024","ordinal":288353,"en":"Take all his worldly goods"},{"id":"semetey-2-2013:p1334:b003:l025","ordinal":288354,"en":"And settle down wealthy."},{"id":"semetey-2-2013:p1334:b003:l026","ordinal":288355,"en":"In the mountains are nine hosts of horses,"},{"id":"semetey-2-2013:p1334:b003:l027","ordinal":288356,"en":"Packhorses mingled with thoroughbreds."},{"id":"semetey-2-2013:p1334:b003:l028","ordinal":288357,"en":"If you go in and take them as spoil,"},{"id":"semetey-2-2013:p1334:b003:l029","ordinal":288358,"en":"Let your poor hearts rejoice!"},{"id":"semetey-2-2013:p1334:b003:l030","ordinal":288359,"en":"On the hills are piebald horses,"},{"id":"semetey-2-2013:p1334:b003:l031","ordinal":288360,"en":"Fleet thoroughbreds mingled among them."},{"id":"semetey-2-2013:p1334:b003:l032","ordinal":288361,"en":"Go and plunder them all;"},{"id":"semetey-2-2013:p1334:b003:l033","ordinal":288362,"en":"Let your poor hearts rejoice!"},{"id":"semetey-2-2013:p1334:b003:l034","ordinal":288363,"en":"Cast a cold catch-rope"},{"id":"semetey-2-2013:p1334:b003:l035","ordinal":288364,"en":"Upon the thoroughbred he would not give when asked."},{"id":"semetey-2-2013:p1334:b003:l036","ordinal":288365,"en":"Strike on every side"},{"id":"semetey-2-2013:p1334:b003:l037","ordinal":288366,"en":"The countless black herds he withholds despite pleas."},{"id":"semetey-2-2013:p1334:b003:l038","ordinal":288367,"en":"Cast lassos over the thoroughbreds"},{"id":"semetey-2-2013:p1334:b003:l039","ordinal":288368,"en":"And enter into this revel."},{"id":"semetey-2-2013:p1334:b004:l001","ordinal":288369,"en":"At Kuu-Tez of Kuugandy"},{"id":"semetey-2-2013:p1334:b004:l002","ordinal":288370,"en":"Loose horses are lying now."},{"id":"semetey-2-2013:p1334:b004:l003","ordinal":288371,"en":"Look upon the splendid livestock;"},{"id":"semetey-2-2013:p1334:b004:l004","ordinal":288372,"en":"Divide by the measure of the whip"},{"id":"semetey-2-2013:p1334:b004:l005","ordinal":288373,"en":"The countless horses left by the mighty warrior."},{"id":"semetey-2-2013:p1334:b004:l006","ordinal":288374,"en":"The great treasury and myriad possessions—"},{"id":"semetey-2-2013:p1334:b004:l007","ordinal":288375,"en":"Plunder them all and leave nothing."},{"id":"semetey-2-2013:p1334:b004:l008","ordinal":288376,"en":"Say, “Kanchoro's support"},{"id":"semetey-2-2013:p1334:b004:l009","ordinal":288377,"en":"Has brought us this much benefit.”"},{"id":"semetey-2-2013:p1334:b004:l010","ordinal":288378,"en":"Go back to your lands, Jediger,"},{"id":"semetey-2-2013:p1334:b004:l011","ordinal":288379,"en":"And boast of it with elation."},{"id":"semetey-2-2013:p1334:b004:l012","ordinal":288380,"en":"This mighty warrior's treasury,"},{"id":"semetey-2-2013:p1334:b004:l013","ordinal":288381,"en":"The gate standing before the palace,"},{"id":"semetey-2-2013:p1334:b004:l014","ordinal":288382,"en":"The garden planted with plane trees,"},{"id":"semetey-2-2013:p1334:b004:l015","ordinal":288383,"en":"The true warrior-khan's throne,"},{"id":"semetey-2-2013:p1334:b004:l016","ordinal":288384,"en":"The dark eye of the spring,"},{"id":"semetey-2-2013:p1334:b004:l017","ordinal":288385,"en":"The very plane tree itself,"},{"id":"semetey-2-2013:p1334:b004:l018","ordinal":288386,"en":"The golden-gated horde—"},{"id":"semetey-2-2013:p1334:b004:l019","ordinal":288387,"en":"Great black host of Jediger,"},{"id":"semetey-2-2013:p1334:b004:l020","ordinal":288388,"en":"Throw yourselves upon them without sparing life;"},{"id":"semetey-2-2013:p1334:b004:l021","ordinal":288389,"en":"Launch a mass assault!"},{"id":"semetey-2-2013:p1334:b004:l022","ordinal":288390,"en":"Make arrows rain down like rain,"},{"id":"semetey-2-2013:p1334:b004:l023","ordinal":288391,"en":"Shoot bullets like hail;"},{"id":"semetey-2-2013:p1334:b004:l024","ordinal":288392,"en":"Slaughter his heroes and lay them low,"},{"id":"semetey-2-2013:p1334:b004:l025","ordinal":288393,"en":"Set all his people clamoring,"},{"id":"semetey-2-2013:p1334:b004:l026","ordinal":288394,"en":"Slaughter his khans and lay them low,"},{"id":"semetey-2-2013:p1334:b004:l027","ordinal":288395,"en":"Destroy all who remain."},{"id":"semetey-2-2013:p1334:b004:l028","ordinal":288396,"en":"Make their women don black headdresses;"},{"id":"semetey-2-2013:p1334:b004:l029","ordinal":288397,"en":"Slaughter every last one."},{"id":"semetey-2-2013:p1334:b004:l030","ordinal":288398,"en":"Bring terror upon their beks;"},{"id":"semetey-2-2013:p1334:b004:l031","ordinal":288399,"en":"Attack head-on and plunder."},{"id":"semetey-2-2013:p1334:b004:l032","ordinal":288400,"en":"Say, “We overran from above"},{"id":"semetey-2-2013:p1334:b004:l033","ordinal":288401,"en":"The mighty warrior who fell upon us;"},{"id":"semetey-2-2013:p1334:b004:l034","ordinal":288402,"en":"We scattered his four kinds of livestock,"},{"id":"semetey-2-2013:p1334:b004:l035","ordinal":288403,"en":"Slaughtered and destroyed his nobles,"},{"id":"semetey-2-2013:p1334:b004:l036","ordinal":288404,"en":"And raised a great upheaval.”"},{"id":"semetey-2-2013:p1334:b004:l037","ordinal":288405,"en":"Such is the way of combat."},{"id":"semetey-2-2013:p1334:b004:l038","ordinal":288406,"en":"Say, “We destroyed his remaining men"},{"id":"semetey-2-2013:p1334:b004:l039","ordinal":288407,"en":"And carried off his women.”"},{"id":"semetey-2-2013:p1335:b003:l001","ordinal":288408,"en":"Jediger of Jeti-Özön,"},{"id":"semetey-2-2013:p1335:b003:l002","ordinal":288409,"en":"You will have something to boast of."},{"id":"semetey-2-2013:p1335:b003:l003","ordinal":288410,"en":"Since you were born as Jediger,"},{"id":"semetey-2-2013:p1335:b003:l004","ordinal":288411,"en":"Dig a well in the place of honor;"},{"id":"semetey-2-2013:p1335:b003:l005","ordinal":288412,"en":"Scatter their four kinds of livestock."},{"id":"semetey-2-2013:p1335:b003:l006","ordinal":288413,"en":"Great black host of Jediger,"},{"id":"semetey-2-2013:p1335:b003:l007","ordinal":288414,"en":"Move off in a dark mass along the ridge."},{"id":"semetey-2-2013:p1335:b003:l008","ordinal":288415,"en":"My people, thus avenge"},{"id":"semetey-2-2013:p1335:b003:l009","ordinal":288416,"en":"Toltoy, who was your uncle and khan!"},{"id":"semetey-2-2013:p1335:b003:l010","ordinal":288417,"en":"Slaughter every one"},{"id":"semetey-2-2013:p1335:b003:l011","ordinal":288418,"en":"Of their elders who boasted of strength."},{"id":"semetey-2-2013:p1335:b003:l012","ordinal":288419,"en":"Seething Jediger,"},{"id":"semetey-2-2013:p1335:b003:l013","ordinal":288420,"en":"Know that I have spoken thus."},{"id":"semetey-2-2013:p1335:b003:l014","ordinal":288421,"en":"My people, every one of you, heed"},{"id":"semetey-2-2013:p1335:b003:l015","ordinal":288422,"en":"What your Khan Kanchoro has said."},{"id":"semetey-2-2013:p1335:b003:l016","ordinal":288423,"en":"Of this son-of-a-bitch warrior,"},{"id":"semetey-2-2013:p1335:b003:l017","ordinal":288424,"en":"This oath-breaker who ruined the age,"},{"id":"semetey-2-2013:p1335:b003:l018","ordinal":288425,"en":"Slaughter many and take your plunder!"},{"id":"semetey-2-2013:p1335:b003:l019","ordinal":288426,"en":"Cut down his plane trees and lay them low;"},{"id":"semetey-2-2013:p1335:b003:l020","ordinal":288427,"en":"Kick down his walls."},{"id":"semetey-2-2013:p1335:b003:l021","ordinal":288428,"en":"Plunder and take his gold;"},{"id":"semetey-2-2013:p1335:b003:l022","ordinal":288429,"en":"Raise merciless turmoil."},{"id":"semetey-2-2013:p1335:b003:l023","ordinal":288430,"en":"Draw bows and make arrows rain;"},{"id":"semetey-2-2013:p1335:b003:l024","ordinal":288431,"en":"Shoot other missiles like hail."},{"id":"semetey-2-2013:p1335:b003:l025","ordinal":288432,"en":"Exert your strength without mercy,"},{"id":"semetey-2-2013:p1335:b003:l026","ordinal":288433,"en":"Level his capital to the ground,"},{"id":"semetey-2-2013:p1335:b003:l027","ordinal":288434,"en":"And sack it completely."},{"id":"semetey-2-2013:p1335:b003:l028","ordinal":288435,"en":"Bring slaughter upon his people."},{"id":"semetey-2-2013:p1335:b003:l029","ordinal":288436,"en":"Come now, Jediger, do not stand idle;"},{"id":"semetey-2-2013:p1335:b003:l030","ordinal":288437,"en":"Take your positions on either side."},{"id":"semetey-2-2013:p1335:b003:l031","ordinal":288438,"en":"Fire your guns and draw your bows;"},{"id":"semetey-2-2013:p1335:b003:l032","ordinal":288439,"en":"Fight with blades flashing."},{"id":"semetey-2-2013:p1335:b003:l033","ordinal":288440,"en":"Let bowstrings and arrows thrum,"},{"id":"semetey-2-2013:p1335:b003:l034","ordinal":288441,"en":"Let the places they strike burst apart,"},{"id":"semetey-2-2013:p1335:b003:l035","ordinal":288442,"en":"Let spilled blood run in streams."},{"id":"semetey-2-2013:p1335:b003:l036","ordinal":288443,"en":"Hack through and hollow out"},{"id":"semetey-2-2013:p1335:b003:l037","ordinal":288444,"en":"A place as broad as a ship."},{"id":"semetey-2-2013:p1335:b003:l038","ordinal":288445,"en":"If any soul dies in the fighting,"},{"id":"semetey-2-2013:p1335:b003:l039","ordinal":288446,"en":"Bury him in his clothes."},{"id":"semetey-2-2013:p1335:b004:l001","ordinal":288447,"en":"Such is the way of battle;"},{"id":"semetey-2-2013:p1335:b004:l002","ordinal":288448,"en":"Thus feast upon the plunder."},{"id":"semetey-2-2013:p1335:b004:l003","ordinal":288449,"en":"Break apart their fine goods;"},{"id":"semetey-2-2013:p1335:b004:l004","ordinal":288450,"en":"Bring ruin upon them in earnest."},{"id":"semetey-2-2013:p1335:b004:l005","ordinal":288451,"en":"If his guards resist,"},{"id":"semetey-2-2013:p1335:b004:l006","ordinal":288452,"en":"Drag them along the road"},{"id":"semetey-2-2013:p1335:b004:l007","ordinal":288453,"en":"And hand them over to the Dangyt!"},{"id":"semetey-2-2013:p1335:b004:l008","ordinal":288454,"en":"Slaughter every able man who guards the gate;"},{"id":"semetey-2-2013:p1335:b004:l009","ordinal":288455,"en":"Leave none alive."},{"id":"semetey-2-2013:p1335:b004:l010","ordinal":288456,"en":"Great black host of Jediger,"},{"id":"semetey-2-2013:p1335:b004:l011","ordinal":288457,"en":"Plunder the warrior-khan's treasury;"},{"id":"semetey-2-2013:p1335:b004:l012","ordinal":288458,"en":"Do not leave a thing!"},{"id":"semetey-2-2013:p1335:b004:l013","ordinal":288459,"en":"Let dust fly to the heavens;"},{"id":"semetey-2-2013:p1335:b004:l014","ordinal":288460,"en":"Let troops boil up in dusty masses."},{"id":"semetey-2-2013:p1335:b004:l015","ordinal":288461,"en":"Let spearheads clash,"},{"id":"semetey-2-2013:p1335:b004:l016","ordinal":288462,"en":"And human heads collide!”"},{"id":"semetey-2-2013:p1335:b004:l017","ordinal":288463,"en":"So Kanchoro spoke"},{"id":"semetey-2-2013:p1335:b004:l018","ordinal":288464,"en":"And issued his command"},{"id":"semetey-2-2013:p1335:b004:l019","ordinal":288465,"en":"To plunder the treasury."},{"id":"semetey-2-2013:p1335:b004:l020","ordinal":288466,"en":"He was working a monstrous outrage,"},{"id":"semetey-2-2013:p1335:b004:l021","ordinal":288467,"en":"A great and merciless calamity."},{"id":"semetey-2-2013:p1335:b004:l022","ordinal":288468,"en":"Crested banners filled the ranks;"},{"id":"semetey-2-2013:p1335:b004:l023","ordinal":288469,"en":"The clamor split the sky."},{"id":"semetey-2-2013:p1335:b004:l024","ordinal":288470,"en":"When Kanchoro commanded,"},{"id":"semetey-2-2013:p1335:b004:l025","ordinal":288471,"en":"“Break the horde and take plunder!"},{"id":"semetey-2-2013:p1335:b004:l026","ordinal":288472,"en":"Attack them with a roar!”"},{"id":"semetey-2-2013:p1335:b004:l027","ordinal":288473,"en":"Choro issued his decree."},{"id":"semetey-2-2013:p1335:b004:l028","ordinal":288474,"en":"Ah, this luckless Choro—"},{"id":"semetey-2-2013:p1335:b004:l029","ordinal":288475,"en":"The hair on his crown bristled,"},{"id":"semetey-2-2013:p1335:b004:l030","ordinal":288476,"en":"His eyes truly blazed with fire;"},{"id":"semetey-2-2013:p1335:b004:l031","ordinal":288477,"en":"His broad front teeth, large as a gate,"},{"id":"semetey-2-2013:p1335:b004:l032","ordinal":288478,"en":"Teeth unlike those of any other soul,"},{"id":"semetey-2-2013:p1335:b004:l033","ordinal":288479,"en":"Ground together with a loud crunch."},{"id":"semetey-2-2013:p1335:b004:l034","ordinal":288480,"en":"Kanchoro raised the battle cry."},{"id":"semetey-2-2013:p1335:b004:l035","ordinal":288481,"en":"Not one soul remained upright;"},{"id":"semetey-2-2013:p1335:b004:l036","ordinal":288482,"en":"The great black host of Jediger"},{"id":"semetey-2-2013:p1335:b004:l037","ordinal":288483,"en":"Began to claw at the earth."},{"id":"semetey-2-2013:p1335:b004:l038","ordinal":288484,"en":"As the Jediger stood thus,"},{"id":"semetey-2-2013:p1335:b004:l039","ordinal":288485,"en":"Choro emerged in a frenzy."},{"id":"semetey-2-2013:p1336:b003:l001","ordinal":288486,"en":"His shout split stone;"},{"id":"semetey-2-2013:p1336:b003:l002","ordinal":288487,"en":"His roar split heads."},{"id":"semetey-2-2013:p1336:b003:l003","ordinal":288488,"en":"He began a vast tumult"},{"id":"semetey-2-2013:p1336:b003:l004","ordinal":288489,"en":"Such as men might know and nations behold."},{"id":"semetey-2-2013:p1336:b003:l005","ordinal":288490,"en":"The Jediger faltered"},{"id":"semetey-2-2013:p1336:b003:l006","ordinal":288491,"en":"And began to flee."},{"id":"semetey-2-2013:p1336:b003:l007","ordinal":288492,"en":"“Great black host of Jediger,"},{"id":"semetey-2-2013:p1336:b003:l008","ordinal":288493,"en":"You are merely hands that were just fighting,"},{"id":"semetey-2-2013:p1336:b003:l009","ordinal":288494,"en":"Merely mouths that were just boasting."},{"id":"semetey-2-2013:p1336:b003:l010","ordinal":288495,"en":"Jediger who claimed to be heroes,"},{"id":"semetey-2-2013:p1336:b003:l011","ordinal":288496,"en":"If you flee now, you are finished!"},{"id":"semetey-2-2013:p1336:b003:l012","ordinal":288497,"en":"Looking back again and again,"},{"id":"semetey-2-2013:p1336:b003:l013","ordinal":288498,"en":"What were you saying just now?"},{"id":"semetey-2-2013:p1336:b003:l014","ordinal":288499,"en":"If you are heroes, if you are lions,"},{"id":"semetey-2-2013:p1336:b003:l015","ordinal":288500,"en":"If you are the finest people—!”"},{"id":"semetey-2-2013:p1336:b003:l016","ordinal":288501,"en":"When Kanchoro spoke thus,"},{"id":"semetey-2-2013:p1336:b003:l017","ordinal":288502,"en":"The Jediger rose as one"},{"id":"semetey-2-2013:p1336:b003:l018","ordinal":288503,"en":"And all marched thundering."},{"id":"semetey-2-2013:p1336:b003:l019","ordinal":288504,"en":"At the valor of that host,"},{"id":"semetey-2-2013:p1336:b003:l020","ordinal":288505,"en":"The earth split with a roar."},{"id":"semetey-2-2013:p1336:b003:l021","ordinal":288506,"en":"Trumpets deafened the ear;"},{"id":"semetey-2-2013:p1336:b003:l022","ordinal":288507,"en":"Pale banners became their standards."},{"id":"semetey-2-2013:p1336:b003:l023","ordinal":288508,"en":"A clamor split the sky;"},{"id":"semetey-2-2013:p1336:b003:l024","ordinal":288509,"en":"The people cried out and the host swelled,"},{"id":"semetey-2-2013:p1336:b003:l025","ordinal":288510,"en":"Countless and abundant."},{"id":"semetey-2-2013:p1336:b003:l026","ordinal":288511,"en":"The attacking Jediger"},{"id":"semetey-2-2013:p1336:b003:l027","ordinal":288512,"en":"Divided into surging ranks;"}]
