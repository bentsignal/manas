{"id": "sayakbay-ms-current146:pdf185:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 185, "folio": 568, "line_in_page": 6, "raw": "Буруттан кытай балаа көрөт деп,", "text": "Буруттан кытай балаа көрөт деп,", "en": "Saying China would suffer calamity from the Burut,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf185:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 185, "folio": 568, "line_in_page": 7, "raw": "Кармашкан адам өлөт деп,", "text": "Кармашкан адам өлөт деп,", "en": "Saying any man who grappled with him would die.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
