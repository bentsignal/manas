[{"id":"manas-2010:p0358:b001:l023","ordinal":16385,"en":"And before Esenkan"},{"id":"manas-2010:p0358:b001:l024","ordinal":16386,"en":"Let us lay him as a gift!"},{"id":"manas-2010:p0358:b001:l025","ordinal":16387,"en":"‘For this people of forty Chinese tribes,"},{"id":"manas-2010:p0358:b001:l026","ordinal":16388,"en":"Here is the enemy you feared,’ we shall say,"},{"id":"manas-2010:p0358:b001:l027","ordinal":16389,"en":"Making an open spectacle of it,"},{"id":"manas-2010:p0358:b001:l028","ordinal":16390,"en":"And ask for his khanship!"},{"id":"manas-2010:p0358:b001:l029","ordinal":16391,"en":"Those forty households in Altai,"},{"id":"manas-2010:p0358:b001:l030","ordinal":16392,"en":"Those daughter-damned Buruts,"},{"id":"manas-2010:p0358:b001:l031","ordinal":16393,"en":"Are enemies, are foes;"},{"id":"manas-2010:p0358:b001:l032","ordinal":16394,"en":"They have grown rich and run mad."},{"id":"manas-2010:p0358:b001:l033","ordinal":16395,"en":"Have you seen that formidable hero?"},{"id":"manas-2010:p0358:b001:l034","ordinal":16396,"en":"He has little of an envoy's courtesy."},{"id":"manas-2010:p0358:b001:l035","ordinal":16397,"en":"Those forty Burut households—"},{"id":"manas-2010:p0358:b001:l036","ordinal":16398,"en":"Let us plunder their possessions,"},{"id":"manas-2010:p0358:b001:l037","ordinal":16399,"en":"Let us crush the trouble firmly,"},{"id":"manas-2010:p0358:b001:l038","ordinal":16400,"en":"Let us slaughter their courageous men;"},{"id":"manas-2010:p0358:b001:l039","ordinal":16401,"en":"Their women and their children,"},{"id":"manas-2010:p0358:b001:l040","ordinal":16402,"en":"Let us take them as spoil!"},{"id":"manas-2010:p0358:b001:l041","ordinal":16403,"en":"Let us parch their seed like salt;"},{"id":"manas-2010:p0358:b001:l042","ordinal":16404,"en":"Of those daughter-damned Buruts,"},{"id":"manas-2010:p0358:b001:l043","ordinal":16405,"en":"Leaving not so much as a hair,"},{"id":"manas-2010:p0358:b001:l044","ordinal":16406,"en":"Let us tear them out by the roots."},{"id":"manas-2010:p0358:b001:l045","ordinal":16407,"en":"Let us raid their countless cattle,"},{"id":"manas-2010:p0358:b001:l046","ordinal":16408,"en":"Let us return with their livestock as spoil."},{"id":"manas-2010:p0358:b001:l047","ordinal":16409,"en":"Let us slaughter their mighty men,"},{"id":"manas-2010:p0358:b001:l048","ordinal":16410,"en":"Let us take their daughters captive."},{"id":"manas-2010:p0359:b001:l001","ordinal":16411,"en":"Let us seize their giant Manas;"},{"id":"manas-2010:p0359:b001:l002","ordinal":16412,"en":"Let us scatter that Burut's"},{"id":"manas-2010:p0359:b001:l003","ordinal":16413,"en":"Brains if he draws near!"},{"id":"manas-2010:p0359:b001:l004","ordinal":16414,"en":"His oppression has gone too far;"},{"id":"manas-2010:p0359:b001:l005","ordinal":16415,"en":"Let us endure no more"},{"id":"manas-2010:p0359:b001:l006","ordinal":16416,"en":"Of Manas's humiliation!"},{"id":"manas-2010:p0359:b001:l007","ordinal":16417,"en":"Let us scout the road ahead;"},{"id":"manas-2010:p0359:b001:l008","ordinal":16418,"en":"Where might the bloodthirsty one be?"},{"id":"manas-2010:p0359:b001:l009","ordinal":16419,"en":"Let us learn where Manas is."},{"id":"manas-2010:p0359:b001:l010","ordinal":16420,"en":"If that bloodthirsty one lies unguarded,"},{"id":"manas-2010:p0359:b001:l011","ordinal":16421,"en":"Let us charge into a raid!"},{"id":"manas-2010:p0359:b001:l012","ordinal":16422,"en":"Firing guns and drawing bows,"},{"id":"manas-2010:p0359:b001:l013","ordinal":16423,"en":"Thrusting spears and shouting,"},{"id":"manas-2010:p0359:b001:l014","ordinal":16424,"en":"Let us launch the onslaught!"},{"id":"manas-2010:p0359:b001:l015","ordinal":16425,"en":"Standing on either side,"},{"id":"manas-2010:p0359:b001:l016","ordinal":16426,"en":"Ripping lungs and cutting heads,"},{"id":"manas-2010:p0359:b001:l017","ordinal":16427,"en":"Let us slaughter without mercy!"},{"id":"manas-2010:p0359:b001:l018","ordinal":16428,"en":"Chong-Özön in the Altai mountains—"},{"id":"manas-2010:p0359:b001:l019","ordinal":16429,"en":"Let us trample the Chong-Özön road."},{"id":"manas-2010:p0359:b001:l020","ordinal":16430,"en":"Spare yourselves nothing, champions;"},{"id":"manas-2010:p0359:b001:l021","ordinal":16431,"en":"Let us all descend together!"},{"id":"manas-2010:p0359:b001:l022","ordinal":16432,"en":"Let us find some means;"},{"id":"manas-2010:p0359:b001:l023","ordinal":16433,"en":"Those daughter-damned Buruts,"},{"id":"manas-2010:p0359:b001:l024","ordinal":16434,"en":"Let us attack and slaughter them!"},{"id":"manas-2010:p0359:b001:l025","ordinal":16435,"en":"Let us enter their abundant wealth,"},{"id":"manas-2010:p0359:b001:l026","ordinal":16436,"en":"Let us slit their scalps."},{"id":"manas-2010:p0359:b001:l027","ordinal":16437,"en":"Crafty Jakyp seems an unbeliever;"},{"id":"manas-2010:p0359:b001:l028","ordinal":16438,"en":"Concealing the truth, deceiving the khan,"},{"id":"manas-2010:p0359:b001:l029","ordinal":16439,"en":"This Jakyp seems a trickster."},{"id":"manas-2010:p0359:b001:l030","ordinal":16440,"en":"Not fighting squarely face to face,"},{"id":"manas-2010:p0359:b001:l031","ordinal":16441,"en":"He is a damned one indeed."},{"id":"manas-2010:p0359:b001:l032","ordinal":16442,"en":"‘My son has become a hero,’"},{"id":"manas-2010:p0359:b001:l033","ordinal":16443,"en":"This Jakyp has boasted."},{"id":"manas-2010:p0359:b001:l034","ordinal":16444,"en":"Instead of slaughtering the Buruts,"},{"id":"manas-2010:p0359:b001:l035","ordinal":16445,"en":"Why did they drive them here,"},{"id":"manas-2010:p0359:b001:l036","ordinal":16446,"en":"To these parts of Altai—"},{"id":"manas-2010:p0359:b001:l037","ordinal":16447,"en":"That people called the Buruts!"},{"id":"manas-2010:p0359:b001:l038","ordinal":16448,"en":"He is one who should burn;"},{"id":"manas-2010:p0359:b001:l039","ordinal":16449,"en":"From those daughter-damned Buruts"},{"id":"manas-2010:p0359:b001:l040","ordinal":16450,"en":"A mighty son, Manas, was born."},{"id":"manas-2010:p0359:b001:l041","ordinal":16451,"en":"Now is the time to slaughter them."},{"id":"manas-2010:p0359:b001:l042","ordinal":16452,"en":"Those champions who play the hero,"},{"id":"manas-2010:p0359:b001:l043","ordinal":16453,"en":"Those who have come out of Beijing,"},{"id":"manas-2010:p0359:b001:l044","ordinal":16454,"en":"Have you observed or have you not"},{"id":"manas-2010:p0359:b001:l045","ordinal":16455,"en":"That bloodthirsty one's strife,"},{"id":"manas-2010:p0359:b001:l046","ordinal":16456,"en":"How every village headman"},{"id":"manas-2010:p0359:b001:l047","ordinal":16457,"en":"He has cut down and slaughtered!"},{"id":"manas-2010:p0359:b001:l048","ordinal":16458,"en":"He bound those who went there—"},{"id":"manas-2010:p0360:b001:l001","ordinal":16459,"en":"Such was the bloodthirsty one's strife!"},{"id":"manas-2010:p0360:b001:l002","ordinal":16460,"en":"No mortal can bend him down and take him;"},{"id":"manas-2010:p0360:b001:l003","ordinal":16461,"en":"Those who challenge him cannot survive."},{"id":"manas-2010:p0360:b001:l004","ordinal":16462,"en":"Of middling height and broad of shoulder,"},{"id":"manas-2010:p0360:b001:l005","ordinal":16463,"en":"Both champion and lion—"},{"id":"manas-2010:p0360:b001:l006","ordinal":16464,"en":"I was the one called Zholoy."},{"id":"manas-2010:p0360:b001:l007","ordinal":16465,"en":"Ah, no such warrior is born in the world!"},{"id":"manas-2010:p0360:b001:l008","ordinal":16466,"en":"Wide-mouthed, with cliff-like brows,"},{"id":"manas-2010:p0360:b001:l009","ordinal":16467,"en":"His face like oiled wheat,"},{"id":"manas-2010:p0360:b001:l010","ordinal":16468,"en":"His eyes like twilight mist,"},{"id":"manas-2010:p0360:b001:l011","ordinal":16469,"en":"His charge is full of wrath,"},{"id":"manas-2010:p0360:b001:l012","ordinal":16470,"en":"He pours venom into combat."},{"id":"manas-2010:p0360:b001:l013","ordinal":16471,"en":"He splits his challengers in two;"},{"id":"manas-2010:p0360:b001:l014","ordinal":16472,"en":"He has the look of a boar."},{"id":"manas-2010:p0360:b001:l015","ordinal":16473,"en":"Chewing up those who challenge him,"},{"id":"manas-2010:p0360:b001:l016","ordinal":16474,"en":"He has the bearing of a lion."},{"id":"manas-2010:p0360:b001:l017","ordinal":16475,"en":"He girds his waist alone."},{"id":"manas-2010:p0360:b001:l018","ordinal":16476,"en":"Through countless troops that fill the earth"},{"id":"manas-2010:p0360:b001:l019","ordinal":16477,"en":"He enters alone and attacks!"},{"id":"manas-2010:p0360:b001:l020","ordinal":16478,"en":"His courage is unlike all others'."},{"id":"manas-2010:p0360:b001:l021","ordinal":16479,"en":"When you see his fierce wolf's bearing,"},{"id":"manas-2010:p0360:b001:l022","ordinal":16480,"en":"Do not fluster and lose your heads;"},{"id":"manas-2010:p0360:b001:l023","ordinal":16481,"en":"Like men struck down by slaughter,"},{"id":"manas-2010:p0360:b001:l024","ordinal":16482,"en":"Do not all break and flee!"},{"id":"manas-2010:p0360:b001:l025","ordinal":16483,"en":"If we stand on either side,"},{"id":"manas-2010:p0360:b001:l026","ordinal":16484,"en":"Thrusting spears and striking axes,"},{"id":"manas-2010:p0360:b001:l027","ordinal":16485,"en":"If we fight with crashing blows,"},{"id":"manas-2010:p0360:b001:l028","ordinal":16486,"en":"Hurrying, scurrying, floundering—"},{"id":"manas-2010:p0360:b001:l029","ordinal":16487,"en":"If you panic, you shall suffer!"},{"id":"manas-2010:p0360:b001:l030","ordinal":16488,"en":"From that lone valiant Burut,"},{"id":"manas-2010:p0360:b001:l031","ordinal":16489,"en":"If you flee, you shall suffer!"},{"id":"manas-2010:p0360:b001:l032","ordinal":16490,"en":"I have spoken; hear me, all of you!"},{"id":"manas-2010:p0360:b001:l033","ordinal":16491,"en":"If you do not heed these words,"},{"id":"manas-2010:p0360:b001:l034","ordinal":16492,"en":"From the rough champion Zholoy"},{"id":"manas-2010:p0360:b001:l035","ordinal":16493,"en":"You shall take a thorough beating."},{"id":"manas-2010:p0360:b001:l036","ordinal":16494,"en":"If you turn back, you shall die;"},{"id":"manas-2010:p0360:b001:l037","ordinal":16495,"en":"For fleeing, you shall answer to me!”"},{"id":"manas-2010:p0360:b001:l038","ordinal":16496,"en":"Zholoy spoke these words now."},{"id":"manas-2010:p0360:b001:l039","ordinal":16497,"en":"“So let it be for anyone who flees,”"},{"id":"manas-2010:p0360:b001:l040","ordinal":16498,"en":"The countless charging soldiers"},{"id":"manas-2010:p0360:b001:l041","ordinal":16499,"en":"Made their pledge now:"},{"id":"manas-2010:p0360:b001:l042","ordinal":16500,"en":"“From that bloodthirsty bringer of trouble,"},{"id":"manas-2010:p0360:b001:l043","ordinal":16501,"en":"Rather than turn away and flee,"},{"id":"manas-2010:p0360:b001:l044","ordinal":16502,"en":"Let us die at that deceiver's hand."},{"id":"manas-2010:p0360:b001:l045","ordinal":16503,"en":"Let the spearmen charge;"},{"id":"manas-2010:p0360:b001:l046","ordinal":16504,"en":"That Burut, his mother's only son,"},{"id":"manas-2010:p0360:b001:l047","ordinal":16505,"en":"Let us all assail together."},{"id":"manas-2010:p0360:b001:l048","ordinal":16506,"en":"Any champion who flees—"},{"id":"manas-2010:p0361:b001:l001","ordinal":16507,"en":"Let us seize him in our wrath;"},{"id":"manas-2010:p0361:b001:l002","ordinal":16508,"en":"If he breaks the ranks,"},{"id":"manas-2010:p0361:b001:l003","ordinal":16509,"en":"Let us crush and kill him like a dog!"},{"id":"manas-2010:p0361:b001:l004","ordinal":16510,"en":"Whatever son this Burut may be,"},{"id":"manas-2010:p0361:b001:l005","ordinal":16511,"en":"Let not one of us fail to attack!"},{"id":"manas-2010:p0361:b001:l006","ordinal":16512,"en":"Let our strong men overwhelm him;"},{"id":"manas-2010:p0361:b001:l007","ordinal":16513,"en":"That Burut has grown mighty—"},{"id":"manas-2010:p0361:b001:l008","ordinal":16514,"en":"Let us clash with him!"},{"id":"manas-2010:p0361:b001:l009","ordinal":16515,"en":"“Champion Zholoy, brave warrior,” they said,"},{"id":"manas-2010:p0361:b001:l010","ordinal":16516,"en":"“What you have spoken is wise,” they said."},{"id":"manas-2010:p0361:b001:l011","ordinal":16517,"en":"Gathering and supporting him,"},{"id":"manas-2010:p0361:b001:l012","ordinal":16518,"en":"Their idols hammered out of bronze,"},{"id":"manas-2010:p0361:b001:l013","ordinal":16519,"en":"Those clattering idols,"},{"id":"manas-2010:p0361:b001:l014","ordinal":16520,"en":"They struck against their chests:"},{"id":"manas-2010:p0361:b001:l015","ordinal":16521,"en":"“May this idol strike us down!” they said."},{"id":"manas-2010:p0361:b001:l016","ordinal":16522,"en":"They listened to the mighty command,"},{"id":"manas-2010:p0361:b001:l017","ordinal":16523,"en":"They stood together in a crowd."},{"id":"manas-2010:p0361:b001:l018","ordinal":16524,"en":"They heard great Zholoy's words,"},{"id":"manas-2010:p0361:b001:l019","ordinal":16525,"en":"They deemed them right."},{"id":"manas-2010:p0361:b001:l020","ordinal":16526,"en":"They divided off the champions;"},{"id":"manas-2010:p0361:b001:l021","ordinal":16527,"en":"Their courageous and their strong"},{"id":"manas-2010:p0361:b001:l022","ordinal":16528,"en":"They placed at the very front."},{"id":"manas-2010:p0361:b001:l023","ordinal":16529,"en":"Their great boots jutting out,"},{"id":"manas-2010:p0361:b001:l024","ordinal":16530,"en":"The dense army launched its charge,"},{"id":"manas-2010:p0361:b001:l025","ordinal":16531,"en":"Looming like Mount Opol."},{"id":"manas-2010:p0361:b001:l026","ordinal":16532,"en":"Their saddle flaps fluttered;"},{"id":"manas-2010:p0361:b001:l027","ordinal":16533,"en":"Black hair thick as a hand-mallet"},{"id":"manas-2010:p0361:b001:l028","ordinal":16534,"en":"Swung upon their backs."},{"id":"manas-2010:p0361:b001:l029","ordinal":16535,"en":"The Chinese rose in a clamorous frenzy;"},{"id":"manas-2010:p0361:b001:l030","ordinal":16536,"en":"As though they would overwhelm all,"},{"id":"manas-2010:p0361:b001:l031","ordinal":16537,"en":"The emperor's people shouted,"},{"id":"manas-2010:p0361:b001:l032","ordinal":16538,"en":"Thundering in their wrath."},{"id":"manas-2010:p0361:b001:l033","ordinal":16539,"en":"From the champions' fury"},{"id":"manas-2010:p0361:b001:l034","ordinal":16540,"en":"The earth broke into a rumble."},{"id":"manas-2010:p0361:b001:l035","ordinal":16541,"en":"Their champions were extraordinary,"},{"id":"manas-2010:p0361:b001:l036","ordinal":16542,"en":"Their heroes were many;"},{"id":"manas-2010:p0361:b001:l037","ordinal":16543,"en":"They had strong men and giants,"},{"id":"manas-2010:p0361:b001:l038","ordinal":16544,"en":"Their valiant men had gathered might."},{"id":"manas-2010:p0361:b001:l039","ordinal":16545,"en":"Leaders of ten wheeled about;"},{"id":"manas-2010:p0361:b001:l040","ordinal":16546,"en":"Seven standards became their banners,"},{"id":"manas-2010:p0361:b001:l041","ordinal":16547,"en":"Their uproar filled the earth."},{"id":"manas-2010:p0361:b001:l042","ordinal":16548,"en":"Axemen stood at the front,"},{"id":"manas-2010:p0361:b001:l043","ordinal":16549,"en":"Their heroes on the flanks,"},{"id":"manas-2010:p0361:b001:l044","ordinal":16550,"en":"Their mighty men on the flanks,"},{"id":"manas-2010:p0361:b001:l045","ordinal":16551,"en":"Swordsmen at the front,"},{"id":"manas-2010:p0361:b001:l046","ordinal":16552,"en":"Thick-armed and full of courage."},{"id":"manas-2010:p0361:b001:l047","ordinal":16553,"en":"Their war cries deafened ears;"},{"id":"manas-2010:p0361:b001:l048","ordinal":16554,"en":"Their roaring split the rocks!"},{"id":"manas-2010:p0362:b001:l001","ordinal":16555,"en":"Dust billowed as they marched;"},{"id":"manas-2010:p0362:b001:l002","ordinal":16556,"en":"Esenkan's many soldiers"},{"id":"manas-2010:p0362:b001:l003","ordinal":16557,"en":"Shouted out their songs."},{"id":"manas-2010:p0362:b001:l004","ordinal":16558,"en":"An army of countless kinds—"},{"id":"manas-2010:p0362:b001:l005","ordinal":16559,"en":"May God spare us the sight—"},{"id":"manas-2010:p0362:b001:l006","ordinal":16560,"en":"More than a man could bear to see,"},{"id":"manas-2010:p0362:b001:l007","ordinal":16561,"en":"They surged in all their strength."},{"id":"manas-2010:p0362:b001:l008","ordinal":16562,"en":"Warrior Zholoy at the front,"},{"id":"manas-2010:p0362:b001:l009","ordinal":16563,"en":"Ezkara at the rear,"},{"id":"manas-2010:p0362:b001:l010","ordinal":16564,"en":"They hemmed the army in, pounding along."},{"id":"manas-2010:p0362:b001:l011","ordinal":16565,"en":"Dividing into troops of a thousand,"},{"id":"manas-2010:p0362:b001:l012","ordinal":16566,"en":"They came swarming forth."},{"id":"manas-2010:p0362:b001:l013","ordinal":16567,"en":"Giant Döödür and Karazhoy"},{"id":"manas-2010:p0362:b001:l014","ordinal":16568,"en":"Came driving them forward."},{"id":"manas-2010:p0362:b001:l015","ordinal":16569,"en":"The troops they drove that day—"},{"id":"manas-2010:p0362:b001:l016","ordinal":16570,"en":"You could not tell them from insects—"},{"id":"manas-2010:p0362:b001:l017","ordinal":16571,"en":"Came swarming forth."},{"id":"manas-2010:p0362:b001:l018","ordinal":16572,"en":"Their spears appeared like reeds;"},{"id":"manas-2010:p0362:b001:l019","ordinal":16573,"en":"Their courageous and their strong"},{"id":"manas-2010:p0362:b001:l020","ordinal":16574,"en":"Were singled out to go ahead."},{"id":"manas-2010:p0362:b001:l021","ordinal":16575,"en":"Like tumbleweed in flight,"},{"id":"manas-2010:p0362:b001:l022","ordinal":16576,"en":"Too swift to catch the eye,"},{"id":"manas-2010:p0362:b001:l023","ordinal":16577,"en":"Dust rising in a black fog,"},{"id":"manas-2010:p0362:b001:l024","ordinal":16578,"en":"They came swarming forth."},{"id":"manas-2010:p0362:b001:l025","ordinal":16579,"en":"“Ride! Quickly! Go, go!” he cried;"},{"id":"manas-2010:p0362:b001:l026","ordinal":16580,"en":"At the army's rear, Ezkara,"},{"id":"manas-2010:p0362:b001:l027","ordinal":16581,"en":"Beating them with his battle-axe,"},{"id":"manas-2010:p0362:b001:l028","ordinal":16582,"en":"Came driving them forward."},{"id":"manas-2010:p0362:b001:l029","ordinal":16583,"en":"An army of a thousand multitudes,"},{"id":"manas-2010:p0362:b001:l030","ordinal":16584,"en":"Great Zholoy at its head,"},{"id":"manas-2010:p0362:b001:l031","ordinal":16585,"en":"They skirted the Altai mountains,"},{"id":"manas-2010:p0362:b001:l032","ordinal":16586,"en":"Of the gray, rolling, gullied hills,"},{"id":"manas-2010:p0362:b001:l033","ordinal":16587,"en":"They skirted the lower slopes,"},{"id":"manas-2010:p0362:b001:l034","ordinal":16588,"en":"To the strange mountain's spur,"},{"id":"manas-2010:p0362:b001:l035","ordinal":16589,"en":"To its projecting, jutting headland."},{"id":"manas-2010:p0362:b001:l036","ordinal":16590,"en":"The army overran Keng-Özön,"},{"id":"manas-2010:p0362:b001:l037","ordinal":16591,"en":"An immense host, no small band,"},{"id":"manas-2010:p0362:b001:l038","ordinal":16592,"en":"Skirting Kyyan-Kyr."},{"id":"manas-2010:p0362:b001:l039","ordinal":16593,"en":"Their coursers, mules and rhinoceroses,"},{"id":"manas-2010:p0362:b001:l040","ordinal":16594,"en":"Every one of them they had"},{"id":"manas-2010:p0362:b001:l041","ordinal":16595,"en":"Shod and made ready."},{"id":"manas-2010:p0362:b001:l042","ordinal":16596,"en":"Spear tips flashed,"},{"id":"manas-2010:p0362:b001:l043","ordinal":16597,"en":"Brass horns rang out,"},{"id":"manas-2010:p0362:b001:l044","ordinal":16598,"en":"Their strong men thundered,"},{"id":"manas-2010:p0362:b001:l045","ordinal":16599,"en":"Their champions pounded along,"},{"id":"manas-2010:p0362:b001:l046","ordinal":16600,"en":"As though to slaughter the world."},{"id":"manas-2010:p0362:b001:l047","ordinal":16601,"en":"The army marched, the host swarmed,"},{"id":"manas-2010:p0362:b001:l048","ordinal":16602,"en":"As though not merely warrior Manas,"},{"id":"manas-2010:p0363:b001:l001","ordinal":16603,"en":"But the whole throng of Buruts,"},{"id":"manas-2010:p0363:b001:l002","ordinal":16604,"en":"Their people, they would bind."},{"id":"manas-2010:p0363:b001:l003","ordinal":16605,"en":"Great Döödür on his great mule,"},{"id":"manas-2010:p0363:b001:l004","ordinal":16606,"en":"The oldest of the physicians,"},{"id":"manas-2010:p0363:b001:l005","ordinal":16607,"en":"He drove along that day,"},{"id":"manas-2010:p0363:b001:l006","ordinal":16608,"en":"All those clanging, jingling men."},{"id":"manas-2010:p0363:b001:l007","ordinal":16609,"en":"In flapping, flouncing, broad robes,"},{"id":"manas-2010:p0363:b001:l008","ordinal":16610,"en":"The Chinese people then"},{"id":"manas-2010:p0363:b001:l009","ordinal":16611,"en":"Buzzed together in a separate throng."},{"id":"manas-2010:p0363:b001:l010","ordinal":16612,"en":"There were Black Kalmyks and Manchus;"},{"id":"manas-2010:p0363:b001:l011","ordinal":16613,"en":"May Kydyr and God protect us—"},{"id":"manas-2010:p0363:b001:l012","ordinal":16614,"en":"So many souls had swept upon us!"},{"id":"manas-2010:p0363:b001:l013","ordinal":16615,"en":"There were khans who guarded thrones;"},{"id":"manas-2010:p0363:b001:l014","ordinal":16616,"en":"Those who slashed whomever they seized,"},{"id":"manas-2010:p0363:b001:l015","ordinal":16617,"en":"All the blood-drinkers were there."},{"id":"manas-2010:p0363:b001:l016","ordinal":16618,"en":"Taking their command and raging,"},{"id":"manas-2010:p0363:b001:l017","ordinal":16619,"en":"Hero Manas, the wolf-man,"},{"id":"manas-2010:p0363:b001:l018","ordinal":16620,"en":"To bind him securely,"},{"id":"manas-2010:p0363:b001:l019","ordinal":16621,"en":"They were fiercely determined."},{"id":"manas-2010:p0363:b001:l020","ordinal":16622,"en":"Careful over terrain, knowing the roads,"},{"id":"manas-2010:p0363:b001:l021","ordinal":16623,"en":"Their accomplished champion Zholoy"},{"id":"manas-2010:p0363:b001:l022","ordinal":16624,"en":"The narrow paths of gray, rolling hills"},{"id":"manas-2010:p0363:b001:l023","ordinal":16625,"en":"He had trodden thoroughly."},{"id":"manas-2010:p0363:b001:l024","ordinal":16626,"en":"“The Buruts must be here,” he said."},{"id":"manas-2010:p0363:b001:l025","ordinal":16627,"en":"Warrior Zholoy, born resourceful,"},{"id":"manas-2010:p0363:b001:l026","ordinal":16628,"en":"Had taken up the lead!"},{"id":"manas-2010:p0363:b001:l027","ordinal":16629,"en":"Keeping a home beneath gray yurt felt,"},{"id":"manas-2010:p0363:b001:l028","ordinal":16630,"en":"Was it not Zholoy who had grown up so?"},{"id":"manas-2010:p0363:b001:l029","ordinal":16631,"en":"Scouting, ranging over country,"},{"id":"manas-2010:p0363:b001:l030","ordinal":16632,"en":"Was it not Zholoy who was used to it?"},{"id":"manas-2010:p0363:b001:l031","ordinal":16633,"en":"Rich broth and fatty meat,"},{"id":"manas-2010:p0363:b001:l032","ordinal":16634,"en":"Was it not Zholoy who had eaten them?"},{"id":"manas-2010:p0363:b001:l033","ordinal":16635,"en":"“Where is there any trouble for me!”"},{"id":"manas-2010:p0363:b001:l034","ordinal":16636,"en":"Was it not Zholoy who said it?"},{"id":"manas-2010:p0363:b001:l035","ordinal":16637,"en":"On green, mottled meadow turf,"},{"id":"manas-2010:p0363:b001:l036","ordinal":16638,"en":"Was it not Zholoy who had grown up?"},{"id":"manas-2010:p0363:b001:l037","ordinal":16639,"en":"Migrating and making camp since the beginning,"},{"id":"manas-2010:p0363:b001:l038","ordinal":16640,"en":"Was it not Zholoy who was used to it!"}]
