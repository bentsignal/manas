{"id": "sayakbay-ms-current146:pdf158:l005", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 158, "folio": 541, "line_in_page": 5, "raw": "Олжоосун өзү деп,", "text": "Олжоосун өзү деп,", "en": "Calling the spoil his own,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
