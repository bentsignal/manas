[{"id":"semetey-1-2013:p0982:b003:l036","ordinal":152065,"en":"“Father! Wild sister-in-law Chachykey!"},{"id":"semetey-1-2013:p0982:b003:l037","ordinal":152066,"en":"I know your unruly nature;"},{"id":"semetey-1-2013:p0982:b003:l038","ordinal":152067,"en":"My swaggering prince Semetey—"},{"id":"semetey-1-2013:p0982:b003:l039","ordinal":152068,"en":"I go on honoring his spirit!”"},{"id":"semetey-1-2013:p0982:b004:l001","ordinal":152069,"en":"The boy said this and fled."},{"id":"semetey-1-2013:p0982:b004:l002","ordinal":152070,"en":"Kulchoro flew like an arrow;"},{"id":"semetey-1-2013:p0982:b004:l003","ordinal":152071,"en":"The wretch could not draw near him."},{"id":"semetey-1-2013:p0982:b004:l004","ordinal":152072,"en":"The great woman raised a shout"},{"id":"semetey-1-2013:p0982:b004:l005","ordinal":152073,"en":"And struck out in anger."},{"id":"semetey-1-2013:p0982:b004:l006","ordinal":152074,"en":"From far behind the boy,"},{"id":"semetey-1-2013:p0982:b004:l007","ordinal":152075,"en":"The knife struck the gate."},{"id":"semetey-1-2013:p0982:b004:l008","ordinal":152076,"en":"The gate shattered apart,"},{"id":"semetey-1-2013:p0982:b004:l009","ordinal":152077,"en":"And thirty daughters-in-law and thirty girls"},{"id":"semetey-1-2013:p0982:b004:l010","ordinal":152078,"en":"Fled in every direction, crying out."},{"id":"semetey-1-2013:p0982:b004:l011","ordinal":152079,"en":"Kulchoro ran on,"},{"id":"semetey-1-2013:p0982:b004:l012","ordinal":152080,"en":"Bending low for a spear’s length,"},{"id":"semetey-1-2013:p0982:b004:l013","ordinal":152081,"en":"He reached the top of Akborchuk"},{"id":"semetey-1-2013:p0982:b004:l014","ordinal":152082,"en":"And rushed onward in haste."},{"id":"semetey-1-2013:p0982:b004:l015","ordinal":152083,"en":"He fled as though enemies had entered the village,"},{"id":"semetey-1-2013:p0982:b004:l016","ordinal":152084,"en":"Running away"},{"id":"semetey-1-2013:p0982:b004:l017","ordinal":152085,"en":"From Semetey’s wife."},{"id":"semetey-1-2013:p0982:b004:l018","ordinal":152086,"en":"He took the road at speed,"},{"id":"semetey-1-2013:p0982:b004:l019","ordinal":152087,"en":"And charged onward without drawing near."},{"id":"semetey-1-2013:p0982:b004:l020","ordinal":152088,"en":"Hurrying, the two matched their pace,"},{"id":"semetey-1-2013:p0982:b004:l021","ordinal":152089,"en":"And the two equal warrior choros"},{"id":"semetey-1-2013:p0982:b004:l022","ordinal":152090,"en":"Took counsel in an empty place:"},{"id":"semetey-1-2013:p0982:b004:l023","ordinal":152091,"en":"“Who can understand a secret like this?"},{"id":"semetey-1-2013:p0982:b004:l024","ordinal":152092,"en":"Elder Kanchoro, hear my words!"},{"id":"semetey-1-2013:p0982:b004:l025","ordinal":152093,"en":"His wife is out of her senses;"},{"id":"semetey-1-2013:p0982:b004:l026","ordinal":152094,"en":"That croaking wretch"},{"id":"semetey-1-2013:p0982:b004:l027","ordinal":152095,"en":"Nearly killed me."},{"id":"semetey-1-2013:p0982:b004:l028","ordinal":152096,"en":"Along the Üch-Koshoy,"},{"id":"semetey-1-2013:p0982:b004:l029","ordinal":152097,"en":"Our blue-maned elder, great Bakay,"},{"id":"semetey-1-2013:p0982:b004:l030","ordinal":152098,"en":"Is an old man of immense wisdom,"},{"id":"semetey-1-2013:p0982:b004:l031","ordinal":152099,"en":"A sage left to us"},{"id":"semetey-1-2013:p0982:b004:l032","ordinal":152100,"en":"By the blue-maned lion Manas."},{"id":"semetey-1-2013:p0982:b004:l033","ordinal":152101,"en":"Bakay’s senior wife Körpöjan—"},{"id":"semetey-1-2013:p0982:b004:l034","ordinal":152102,"en":"Let us bring her between us,"},{"id":"semetey-1-2013:p0982:b004:l035","ordinal":152103,"en":"And learn the news for certain."},{"id":"semetey-1-2013:p0982:b004:l036","ordinal":152104,"en":"On the face of the willow country,"},{"id":"semetey-1-2013:p0982:b004:l037","ordinal":152105,"en":"On this side of Keng-Köl,"},{"id":"semetey-1-2013:p0982:b004:l038","ordinal":152106,"en":"Sarykan of the bowl-shaped eyes"},{"id":"semetey-1-2013:p0982:b004:l039","ordinal":152107,"en":"Was a person of sacred power,"},{"id":"semetey-1-2013:p0983:b003:l001","ordinal":152108,"en":"And his senior wife Tynymkan—"},{"id":"semetey-1-2013:p0983:b003:l002","ordinal":152109,"en":"Let us place all four between us"},{"id":"semetey-1-2013:p0983:b003:l003","ordinal":152110,"en":"And learn the news in that way."},{"id":"semetey-1-2013:p0983:b003:l004","ordinal":152111,"en":"On this side of Talas,"},{"id":"semetey-1-2013:p0983:b003:l005","ordinal":152112,"en":"Beyond Keng-Köl,"},{"id":"semetey-1-2013:p0983:b003:l006","ordinal":152113,"en":"There is Jamgyrchy of the Esheks;"},{"id":"semetey-1-2013:p0983:b003:l007","ordinal":152114,"en":"Let us seek him among the men,"},{"id":"semetey-1-2013:p0983:b003:l008","ordinal":152115,"en":"And make his senior wife Jaynake"},{"id":"semetey-1-2013:p0983:b003:l009","ordinal":152116,"en":"Our envoy."},{"id":"semetey-1-2013:p0983:b003:l010","ordinal":152117,"en":"Let us somehow obtain news"},{"id":"semetey-1-2013:p0983:b003:l011","ordinal":152118,"en":"From that witless, wicked woman."},{"id":"semetey-1-2013:p0983:b003:l012","ordinal":152119,"en":"Let us appoint the envoy firmly."},{"id":"semetey-1-2013:p0983:b003:l013","ordinal":152120,"en":"My elder is a true man—"},{"id":"semetey-1-2013:p0983:b003:l014","ordinal":152121,"en":"How could he have called her ‘wife’?"},{"id":"semetey-1-2013:p0983:b003:l015","ordinal":152122,"en":"My sister-in-law is witless;"},{"id":"semetey-1-2013:p0983:b003:l016","ordinal":152123,"en":"He has pampered his wife too much,"},{"id":"semetey-1-2013:p0983:b003:l017","ordinal":152124,"en":"And the wretch has grown loud and wild.”"},{"id":"semetey-1-2013:p0983:b003:l018","ordinal":152125,"en":"They traveled through half the night,"},{"id":"semetey-1-2013:p0983:b003:l019","ordinal":152126,"en":"Rode far without sparing their horses,"},{"id":"semetey-1-2013:p0983:b003:l020","ordinal":152127,"en":"And when the pale dawn drove onward,"},{"id":"semetey-1-2013:p0983:b003:l021","ordinal":152128,"en":"When light touched the earth,"},{"id":"semetey-1-2013:p0983:b003:l022","ordinal":152129,"en":"When daybreak opened dimly"},{"id":"semetey-1-2013:p0983:b003:l023","ordinal":152130,"en":"And light scattered over the land,"},{"id":"semetey-1-2013:p0983:b003:l024","ordinal":152131,"en":"The two went directly"},{"id":"semetey-1-2013:p0983:b003:l025","ordinal":152132,"en":"Before your brave elder Bakay."},{"id":"semetey-1-2013:p0983:b003:l026","ordinal":152133,"en":"When great Bakay in the encampment"},{"id":"semetey-1-2013:p0983:b003:l027","ordinal":152134,"en":"Saw the boys’ appearance,"},{"id":"semetey-1-2013:p0983:b003:l028","ordinal":152135,"en":"He sprang from his place:"},{"id":"semetey-1-2013:p0983:b003:l029","ordinal":152136,"en":"“Kanchoro and Kulchoro,"},{"id":"semetey-1-2013:p0983:b003:l030","ordinal":152137,"en":"My twins who keep me company,"},{"id":"semetey-1-2013:p0983:b003:l031","ordinal":152138,"en":"My sea left from the twin pair,"},{"id":"semetey-1-2013:p0983:b003:l032","ordinal":152139,"en":"My morning stars beside the moon,"},{"id":"semetey-1-2013:p0983:b003:l033","ordinal":152140,"en":"My cherished sultans,"},{"id":"semetey-1-2013:p0983:b003:l034","ordinal":152141,"en":"Your backs I set upon watch—"},{"id":"semetey-1-2013:p0983:b003:l035","ordinal":152142,"en":"My dear stars,"},{"id":"semetey-1-2013:p0983:b003:l036","ordinal":152143,"en":"You have come in a terrible hurry."},{"id":"semetey-1-2013:p0983:b003:l037","ordinal":152144,"en":"Are your Kyrgyz people safe?"},{"id":"semetey-1-2013:p0983:b003:l038","ordinal":152145,"en":"Is he before you safe—"},{"id":"semetey-1-2013:p0983:b003:l039","ordinal":152146,"en":"Poor, solitary Semetey?"},{"id":"semetey-1-2013:p0983:b004:l001","ordinal":152147,"en":"Is your fortune, braided like bargek,"},{"id":"semetey-1-2013:p0983:b004:l002","ordinal":152148,"en":"Standing secure and well,"},{"id":"semetey-1-2013:p0983:b004:l003","ordinal":152149,"en":"And your numerous Argyn people safe?”"},{"id":"semetey-1-2013:p0983:b004:l004","ordinal":152150,"en":"Your elder Bakay said these words."},{"id":"semetey-1-2013:p0983:b004:l005","ordinal":152151,"en":"Startled awake, he sprang up,"},{"id":"semetey-1-2013:p0983:b004:l006","ordinal":152152,"en":"Hurriedly put on his clothes,"},{"id":"semetey-1-2013:p0983:b004:l007","ordinal":152153,"en":"And, alarmed by those who had arrived,"},{"id":"semetey-1-2013:p0983:b004:l008","ordinal":152154,"en":"Your heroic elder Bakay"},{"id":"semetey-1-2013:p0983:b004:l009","ordinal":152155,"en":"Saddled the blue tulpar."},{"id":"semetey-1-2013:p0983:b004:l010","ordinal":152156,"en":"Alarmed by his boys, he said:"},{"id":"semetey-1-2013:p0983:b004:l011","ordinal":152157,"en":"“Oh, my two equal colts,"},{"id":"semetey-1-2013:p0983:b004:l012","ordinal":152158,"en":"Is there a gray, rolling mountain before you?"},{"id":"semetey-1-2013:p0983:b004:l013","ordinal":152159,"en":"You have come in desperate haste,"},{"id":"semetey-1-2013:p0983:b004:l014","ordinal":152160,"en":"Darkening your very lives—"},{"id":"semetey-1-2013:p0983:b004:l015","ordinal":152161,"en":"Is there an enemy surrounding you?"},{"id":"semetey-1-2013:p0983:b004:l016","ordinal":152162,"en":"If an enemy has come from Mecca,"},{"id":"semetey-1-2013:p0983:b004:l017","ordinal":152163,"en":"Brave boys, tell me the truth;"},{"id":"semetey-1-2013:p0983:b004:l018","ordinal":152164,"en":"I shall mount Kökcholok"},{"id":"semetey-1-2013:p0983:b004:l019","ordinal":152165,"en":"And drive them back as far as Mecca."},{"id":"semetey-1-2013:p0983:b004:l020","ordinal":152166,"en":"If an enemy has come from China,"},{"id":"semetey-1-2013:p0983:b004:l021","ordinal":152167,"en":"I shall saddle and mount the tulpar,"},{"id":"semetey-1-2013:p0983:b004:l022","ordinal":152168,"en":"Break their ranks and strike them."},{"id":"semetey-1-2013:p0983:b004:l023","ordinal":152169,"en":"Tell me your words without stumbling;"},{"id":"semetey-1-2013:p0983:b004:l024","ordinal":152170,"en":"You have come in reckless haste."},{"id":"semetey-1-2013:p0983:b004:l025","ordinal":152171,"en":"Boys, tell the truth without faltering.”"},{"id":"semetey-1-2013:p0983:b004:l026","ordinal":152172,"en":"Hero Bakay said this"},{"id":"semetey-1-2013:p0983:b004:l027","ordinal":152173,"en":"To the boys who had hurried so greatly."},{"id":"semetey-1-2013:p0983:b004:l028","ordinal":152174,"en":"“Ah, senior wife, rise,” he said;"},{"id":"semetey-1-2013:p0983:b004:l029","ordinal":152175,"en":"“Pour my boys"},{"id":"semetey-1-2013:p0983:b004:l030","ordinal":152176,"en":"Some fresh yellow mare’s milk.”"},{"id":"semetey-1-2013:p0983:b004:l031","ordinal":152177,"en":"The senior wife sprang up"},{"id":"semetey-1-2013:p0983:b004:l032","ordinal":152178,"en":"And poured Bakay Khan’s great cup"},{"id":"semetey-1-2013:p0983:b004:l033","ordinal":152179,"en":"For the boys."},{"id":"semetey-1-2013:p0983:b004:l034","ordinal":152180,"en":"“Elder Bakay, hear my words!"},{"id":"semetey-1-2013:p0983:b004:l035","ordinal":152181,"en":"We opened tireless Buurul’s stride;"},{"id":"semetey-1-2013:p0983:b004:l036","ordinal":152182,"en":"Can such misery truly happen?"},{"id":"semetey-1-2013:p0983:b004:l037","ordinal":152183,"en":"Along the shore of Ala-Köl"},{"id":"semetey-1-2013:p0983:b004:l038","ordinal":152184,"en":"We lost Akshunkar!"},{"id":"semetey-1-2013:p0983:b004:l039","ordinal":152185,"en":"We let it strike the reed beds,"},{"id":"semetey-1-2013:p0984:b003:l001","ordinal":152186,"en":"From before the riverbank,"},{"id":"semetey-1-2013:p0984:b003:l002","ordinal":152187,"en":"Wise elder, tell us:"},{"id":"semetey-1-2013:p0984:b003:l003","ordinal":152188,"en":"We lost Akshunkar!"},{"id":"semetey-1-2013:p0984:b003:l004","ordinal":152189,"en":"We saw a swan of wondrous power;"},{"id":"semetey-1-2013:p0984:b003:l005","ordinal":152190,"en":"Akshunkar was carried away,"},{"id":"semetey-1-2013:p0984:b003:l006","ordinal":152191,"en":"And we saw turmoil fall into calamity."},{"id":"semetey-1-2013:p0984:b003:l007","ordinal":152192,"en":"These were my elder Semetey’s words:"},{"id":"semetey-1-2013:p0984:b003:l008","ordinal":152193,"en":"‘My exceedingly wise elder,"},{"id":"semetey-1-2013:p0984:b003:l009","ordinal":152194,"en":"My elder, the tiger Bakay,"},{"id":"semetey-1-2013:p0984:b003:l010","ordinal":152195,"en":"Will tell us"},{"id":"semetey-1-2013:p0984:b003:l011","ordinal":152196,"en":"Where the falcon went.’”"},{"id":"semetey-1-2013:p0984:b003:l012","ordinal":152197,"en":"After the boys had said this,"},{"id":"semetey-1-2013:p0984:b003:l013","ordinal":152198,"en":"The aged hero Bakay"},{"id":"semetey-1-2013:p0984:b003:l014","ordinal":152199,"en":"Sent for Jamgyrchy of the Esheks"},{"id":"semetey-1-2013:p0984:b003:l015","ordinal":152200,"en":"Together with his wife,"},{"id":"semetey-1-2013:p0984:b003:l016","ordinal":152201,"en":"And had Sarykan of the bowl-shaped eyes"},{"id":"semetey-1-2013:p0984:b003:l017","ordinal":152202,"en":"Brought along with him."},{"id":"semetey-1-2013:p0984:b003:l018","ordinal":152203,"en":"They hurried and bustled,"},{"id":"semetey-1-2013:p0984:b003:l019","ordinal":152204,"en":"Asking what disaster lay ahead."},{"id":"semetey-1-2013:p0984:b003:l020","ordinal":152205,"en":"“He flew his bird at a swan;"},{"id":"semetey-1-2013:p0984:b003:l021","ordinal":152206,"en":"The swan is gone, and so is the bird,"},{"id":"semetey-1-2013:p0984:b003:l022","ordinal":152207,"en":"And he has remained on the empty plain."},{"id":"semetey-1-2013:p0984:b003:l023","ordinal":152208,"en":"May God spare us such a sight!"},{"id":"semetey-1-2013:p0984:b003:l024","ordinal":152209,"en":"When my age-mate Manas lived,"},{"id":"semetey-1-2013:p0984:b003:l025","ordinal":152210,"en":"If Akshunkar was flown at a swan,"},{"id":"semetey-1-2013:p0984:b003:l026","ordinal":152211,"en":"It would strike the swan down;"},{"id":"semetey-1-2013:p0984:b003:l027","ordinal":152212,"en":"Not only a swan—it would tower above"},{"id":"semetey-1-2013:p0984:b003:l028","ordinal":152213,"en":"And take the creatures of the mountains as well."},{"id":"semetey-1-2013:p0984:b003:l029","ordinal":152214,"en":"As for the falcon that flew away,"},{"id":"semetey-1-2013:p0984:b003:l030","ordinal":152215,"en":"If what they say is true,"},{"id":"semetey-1-2013:p0984:b003:l031","ordinal":152216,"en":"I must consider this very carefully."},{"id":"semetey-1-2013:p0984:b003:l032","ordinal":152217,"en":"Let all three khans gather,"},{"id":"semetey-1-2013:p0984:b003:l033","ordinal":152218,"en":"With the three senior wives and ourselves,"},{"id":"semetey-1-2013:p0984:b003:l034","ordinal":152219,"en":"And place the matter among us."},{"id":"semetey-1-2013:p0984:b003:l035","ordinal":152220,"en":"Let us go swiftly without delay,"},{"id":"semetey-1-2013:p0984:b003:l036","ordinal":152221,"en":"Put the three old women between us,"},{"id":"semetey-1-2013:p0984:b003:l037","ordinal":152222,"en":"And obtain an answer from the daughter-in-law."},{"id":"semetey-1-2013:p0984:b003:l038","ordinal":152223,"en":"The swan is gone, and so is the bird;"},{"id":"semetey-1-2013:p0984:b003:l039","ordinal":152224,"en":"It must be a time of God’s punishment,"},{"id":"semetey-1-2013:p0984:b004:l001","ordinal":152225,"en":"And poor Semetey"},{"id":"semetey-1-2013:p0984:b004:l002","ordinal":152226,"en":"Must be standing there exhausted.”"},{"id":"semetey-1-2013:p0984:b004:l003","ordinal":152227,"en":"Hearing the boys’ account,"},{"id":"semetey-1-2013:p0984:b004:l004","ordinal":152228,"en":"And hearing that Chachykey knew"},{"id":"semetey-1-2013:p0984:b004:l005","ordinal":152229,"en":"What had become of Akshunkar,"},{"id":"semetey-1-2013:p0984:b004:l006","ordinal":152230,"en":"The lion was deeply stirred,"},{"id":"semetey-1-2013:p0984:b004:l007","ordinal":152231,"en":"And blue-maned Bakay mounted."},{"id":"semetey-1-2013:p0984:b004:l008","ordinal":152232,"en":"They joined Bakay,"},{"id":"semetey-1-2013:p0984:b004:l009","ordinal":152233,"en":"And all six rode out together"},{"id":"semetey-1-2013:p0984:b004:l010","ordinal":152234,"en":"To Kanykey’s encampment,"},{"id":"semetey-1-2013:p0984:b004:l011","ordinal":152235,"en":"To Chachykey’s gated fortress."},{"id":"semetey-1-2013:p0984:b004:l012","ordinal":152236,"en":"On the marsh of gathering,"},{"id":"semetey-1-2013:p0984:b004:l013","ordinal":152237,"en":"They gathered in a circle;"},{"id":"semetey-1-2013:p0984:b004:l014","ordinal":152238,"en":"On the marsh of assembly,"},{"id":"semetey-1-2013:p0984:b004:l015","ordinal":152239,"en":"They all assembled together."},{"id":"semetey-1-2013:p0984:b004:l016","ordinal":152240,"en":"They placed the matter among them,"},{"id":"semetey-1-2013:p0984:b004:l017","ordinal":152241,"en":"Conversed and questioned one another,"},{"id":"semetey-1-2013:p0984:b004:l018","ordinal":152242,"en":"Matched their findings step by step,"},{"id":"semetey-1-2013:p0984:b004:l019","ordinal":152243,"en":"And formed a khan’s council;"},{"id":"semetey-1-2013:p0984:b004:l020","ordinal":152244,"en":"It became a great gathering."},{"id":"semetey-1-2013:p0984:b004:l021","ordinal":152245,"en":"There were wise and aged people,"},{"id":"semetey-1-2013:p0984:b004:l022","ordinal":152246,"en":"And all the blue-maned champions were there:"},{"id":"semetey-1-2013:p0984:b004:l023","ordinal":152247,"en":"The tiger Bakay and Jamgyrchy,"},{"id":"semetey-1-2013:p0984:b004:l024","ordinal":152248,"en":"And your elder Sary as well."},{"id":"semetey-1-2013:p0984:b004:l025","ordinal":152249,"en":"Kanykey, the wife of Manas,"},{"id":"semetey-1-2013:p0984:b004:l026","ordinal":152250,"en":"The wise, fierce woman, was also there."},{"id":"semetey-1-2013:p0984:b004:l027","ordinal":152251,"en":"When only khans had arrived,"},{"id":"semetey-1-2013:p0984:b004:l028","ordinal":152252,"en":"They began the splendid proceedings:"},{"id":"semetey-1-2013:p0984:b004:l029","ordinal":152253,"en":"They had tender lamb and sweet head-meat"},{"id":"semetey-1-2013:p0984:b004:l030","ordinal":152254,"en":"Set boiling in broth,"},{"id":"semetey-1-2013:p0984:b004:l031","ordinal":152255,"en":"Spread thick felt carpets,"},{"id":"semetey-1-2013:p0984:b004:l032","ordinal":152256,"en":"And filled them with yellow butter."},{"id":"semetey-1-2013:p0984:b004:l033","ordinal":152257,"en":"They cut rump meat and laid out mane fat,"},{"id":"semetey-1-2013:p0984:b004:l034","ordinal":152258,"en":"And set arak and honey as drink,"},{"id":"semetey-1-2013:p0984:b004:l035","ordinal":152259,"en":"Preparing to receive their guests."},{"id":"semetey-1-2013:p0984:b004:l036","ordinal":152260,"en":"“Tell the khans the truth,” they said,"},{"id":"semetey-1-2013:p0984:b004:l037","ordinal":152261,"en":"Pleading with Chachykey;"},{"id":"semetey-1-2013:p0984:b004:l038","ordinal":152262,"en":"They sent three people forward,"},{"id":"semetey-1-2013:p0984:b004:l039","ordinal":152263,"en":"The three senior wives and noble women,"},{"id":"semetey-1-2013:p0985:b003:l001","ordinal":152264,"en":"Sent them out as mediators:"},{"id":"semetey-1-2013:p0985:b003:l002","ordinal":152265,"en":"One was the khan’s Körpöjan,"},{"id":"semetey-1-2013:p0985:b003:l003","ordinal":152266,"en":"One was Sarykan’s Tynymkan,"},{"id":"semetey-1-2013:p0985:b003:l004","ordinal":152267,"en":"And one was Jamgyrchy’s Jaynake."},{"id":"semetey-1-2013:p0985:b003:l005","ordinal":152268,"en":"The three senior wives went together,"},{"id":"semetey-1-2013:p0985:b003:l006","ordinal":152269,"en":"Stepped between the two sides,"},{"id":"semetey-1-2013:p0985:b003:l007","ordinal":152270,"en":"And went to obtain an answer"},{"id":"semetey-1-2013:p0985:b003:l008","ordinal":152271,"en":"From the pampered woman."},{"id":"semetey-1-2013:p0985:b003:l009","ordinal":152272,"en":"Chachykey’s white palace"},{"id":"semetey-1-2013:p0985:b003:l010","ordinal":152273,"en":"Had a gate of solid iron and tin;"},{"id":"semetey-1-2013:p0985:b003:l011","ordinal":152274,"en":"The pampered daughter-in-law’s"},{"id":"semetey-1-2013:p0985:b003:l012","ordinal":152275,"en":"Splendor was exceedingly great."},{"id":"semetey-1-2013:p0985:b003:l013","ordinal":152276,"en":"No one dared approach it,"},{"id":"semetey-1-2013:p0985:b003:l014","ordinal":152277,"en":"And whoever did was amazed;"},{"id":"semetey-1-2013:p0985:b003:l015","ordinal":152278,"en":"No traveler dared go there,"},{"id":"semetey-1-2013:p0985:b003:l016","ordinal":152279,"en":"And whoever looked was amazed."},{"id":"semetey-1-2013:p0985:b003:l017","ordinal":152280,"en":"At Chachykey’s encampment,"},{"id":"semetey-1-2013:p0985:b003:l018","ordinal":152281,"en":"Acting as mediators there,"},{"id":"semetey-1-2013:p0985:b003:l019","ordinal":152282,"en":"The three senior wives entered"},{"id":"semetey-1-2013:p0985:b003:l020","ordinal":152283,"en":"To learn what had become"},{"id":"semetey-1-2013:p0985:b003:l021","ordinal":152284,"en":"Of the falcon that had flown away."},{"id":"semetey-1-2013:p0985:b003:l022","ordinal":152285,"en":"Körpöjan, wife of Khan Bakay,"},{"id":"semetey-1-2013:p0985:b003:l023","ordinal":152286,"en":"Moved like a goose with young,"},{"id":"semetey-1-2013:p0985:b003:l024","ordinal":152287,"en":"Walked inside, and began speaking:"},{"id":"semetey-1-2013:p0985:b003:l025","ordinal":152288,"en":"“You were once a younger child;"},{"id":"semetey-1-2013:p0985:b003:l026","ordinal":152289,"en":"Ah, delight who shares my life!"},{"id":"semetey-1-2013:p0985:b003:l027","ordinal":152290,"en":"Now, my child, tell the truth."},{"id":"semetey-1-2013:p0985:b003:l028","ordinal":152291,"en":"They opened their horses’ stride;"},{"id":"semetey-1-2013:p0985:b003:l029","ordinal":152292,"en":"Along the shore of Ala-Köl,"},{"id":"semetey-1-2013:p0985:b003:l030","ordinal":152293,"en":"Prince Semetey the lion"},{"id":"semetey-1-2013:p0985:b003:l031","ordinal":152294,"en":"Lost Akshunkar."},{"id":"semetey-1-2013:p0985:b003:l032","ordinal":152295,"en":"Take wisdom worth red gold;"},{"id":"semetey-1-2013:p0985:b003:l033","ordinal":152296,"en":"My precious child, heed my words!"},{"id":"semetey-1-2013:p0985:b003:l034","ordinal":152297,"en":"We followed the chain of tradition,"},{"id":"semetey-1-2013:p0985:b003:l035","ordinal":152298,"en":"Asked the learned men,"},{"id":"semetey-1-2013:p0985:b003:l036","ordinal":152299,"en":"And heard words from men of counsel:"},{"id":"semetey-1-2013:p0985:b003:l037","ordinal":152300,"en":"Of the falcon that was carried away,"},{"id":"semetey-1-2013:p0985:b003:l038","ordinal":152301,"en":"My colt, we heard that you know."},{"id":"semetey-1-2013:p0985:b003:l039","ordinal":152302,"en":"Ah, my colt Chachykey,"},{"id":"semetey-1-2013:p0985:b005:l001","ordinal":152303,"en":"Tell the song you have sung,"},{"id":"semetey-1-2013:p0985:b005:l002","ordinal":152304,"en":"And speak your secret faithfully!"},{"id":"semetey-1-2013:p0985:b005:l003","ordinal":152305,"en":"If you tell your secret, you will prosper"},{"id":"semetey-1-2013:p0985:b005:l004","ordinal":152306,"en":"And become a pure senior wife."},{"id":"semetey-1-2013:p0985:b005:l005","ordinal":152307,"en":"If you are human, tell the truth:"},{"id":"semetey-1-2013:p0985:b005:l006","ordinal":152308,"en":"How did you sleep, and what dream did you see?"},{"id":"semetey-1-2013:p0985:b005:l007","ordinal":152309,"en":"What manner of event did you witness?"},{"id":"semetey-1-2013:p0985:b005:l008","ordinal":152310,"en":"Tell the truth, my colt!"},{"id":"semetey-1-2013:p0985:b005:l009","ordinal":152311,"en":"Think upon what came before and after;"},{"id":"semetey-1-2013:p0985:b005:l010","ordinal":152312,"en":"If you do not tell it, your blue lord"},{"id":"semetey-1-2013:p0985:b005:l011","ordinal":152313,"en":"May mock you for nothing."},{"id":"semetey-1-2013:p0985:b005:l012","ordinal":152314,"en":"A man’s work is solid iron,"},{"id":"semetey-1-2013:p0985:b005:l013","ordinal":152315,"en":"My child, but your name is woman;"},{"id":"semetey-1-2013:p0985:b005:l014","ordinal":152316,"en":"One needs skill to melt it."},{"id":"semetey-1-2013:p0985:b005:l015","ordinal":152317,"en":"If you do not tell, shame and reproach"},{"id":"semetey-1-2013:p0985:b005:l016","ordinal":152318,"en":"Will fall upon your own head."},{"id":"semetey-1-2013:p0985:b005:l017","ordinal":152319,"en":"If you do not tell, my colt,"},{"id":"semetey-1-2013:p0985:b005:l018","ordinal":152320,"en":"What can I say of every deed"}]
