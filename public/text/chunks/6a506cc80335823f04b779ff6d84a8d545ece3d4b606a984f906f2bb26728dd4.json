[{"id":"semetey-1-2013:p1149:b003:l032","ordinal":164865,"en":"I seized your whole herd, Zholoy."},{"id":"semetey-1-2013:p1149:b003:l033","ordinal":164866,"en":"Have you only now become a man, Zholoy?"},{"id":"semetey-1-2013:p1149:b003:l034","ordinal":164867,"en":"Have you mounted a horse upright, Zholoy?"},{"id":"semetey-1-2013:p1149:b003:l035","ordinal":164868,"en":"I summoned you to my feast, Zholoy,"},{"id":"semetey-1-2013:p1149:b003:l036","ordinal":164869,"en":"But you launched an attack upon me!"},{"id":"semetey-1-2013:p1149:b003:l037","ordinal":164870,"en":"You became a guest at my feast, Zholoy,"},{"id":"semetey-1-2013:p1149:b003:l038","ordinal":164871,"en":"But brought humiliation upon my wishes."},{"id":"semetey-1-2013:p1149:b003:l039","ordinal":164872,"en":"I will fight without dying, Zholoy!"},{"id":"semetey-1-2013:p1149:b004:l001","ordinal":164873,"en":"Until the soft reeds ripen,"},{"id":"semetey-1-2013:p1149:b004:l002","ordinal":164874,"en":"Until the law's ashes fly,"},{"id":"semetey-1-2013:p1149:b004:l003","ordinal":164875,"en":"I will fight firmly for six months, Zholoy."},{"id":"semetey-1-2013:p1149:b004:l004","ordinal":164876,"en":"If you came to the feast, state your intent, Zholoy;"},{"id":"semetey-1-2013:p1149:b004:l005","ordinal":164877,"en":"If you mean to shoot, speak the truth,"},{"id":"semetey-1-2013:p1149:b004:l006","ordinal":164878,"en":"Zholoy."},{"id":"semetey-1-2013:p1149:b004:l007","ordinal":164879,"en":"If you mean to wrestle, give your answer,"},{"id":"semetey-1-2013:p1149:b004:l008","ordinal":164880,"en":"Zholoy!"},{"id":"semetey-1-2013:p1149:b004:l009","ordinal":164881,"en":"If we stand opposed,"},{"id":"semetey-1-2013:p1149:b004:l010","ordinal":164882,"en":"Firing guns and drawing bows,"},{"id":"semetey-1-2013:p1149:b004:l011","ordinal":164883,"en":"And fight with smashing blows,"},{"id":"semetey-1-2013:p1149:b004:l012","ordinal":164884,"en":"I will show a fearsome face;"},{"id":"semetey-1-2013:p1149:b004:l013","ordinal":164885,"en":"I will remain until we are spent,"},{"id":"semetey-1-2013:p1149:b004:l014","ordinal":164886,"en":"And fight to your very end."},{"id":"semetey-1-2013:p1149:b004:l015","ordinal":164887,"en":"I have armor no bullet pierces, Zholoy;"},{"id":"semetey-1-2013:p1149:b004:l016","ordinal":164888,"en":"I have a horse no bullet reaches, Zholoy."},{"id":"semetey-1-2013:p1149:b004:l017","ordinal":164889,"en":"You have your Kalcha Kongurbai, Zholoy;"},{"id":"semetey-1-2013:p1149:b004:l018","ordinal":164890,"en":"Let us fight in earnest."},{"id":"semetey-1-2013:p1149:b004:l019","ordinal":164891,"en":"How many khans have you who can fight, Zholoy?"},{"id":"semetey-1-2013:p1149:b004:l020","ordinal":164892,"en":"I learned your numbers long ago, Zholoy;"},{"id":"semetey-1-2013:p1149:b004:l021","ordinal":164893,"en":"I have long wished to meet you."},{"id":"semetey-1-2013:p1149:b004:l022","ordinal":164894,"en":"If you will shoot, state your true intent."},{"id":"semetey-1-2013:p1149:b004:l023","ordinal":164895,"en":"You are not a Kalmyk who can frighten me."},{"id":"semetey-1-2013:p1149:b004:l024","ordinal":164896,"en":"Turning your back, Zholoy,"},{"id":"semetey-1-2013:p1149:b004:l025","ordinal":164897,"en":"You have come to destroy each other!”"},{"id":"semetey-1-2013:p1149:b004:l026","ordinal":164898,"en":"When Manas displayed his wrath,"},{"id":"semetey-1-2013:p1149:b004:l027","ordinal":164899,"en":"Khan Manas and the Kalmyks"},{"id":"semetey-1-2013:p1149:b004:l028","ordinal":164900,"en":"Began to quarrel."},{"id":"semetey-1-2013:p1149:b004:l029","ordinal":164901,"en":"That was when I stood watching."},{"id":"semetey-1-2013:p1149:b004:l030","ordinal":164902,"en":"This will bring disaster upon you;"},{"id":"semetey-1-2013:p1149:b004:l031","ordinal":164903,"en":"I have said much—hear me, Kozho.”"},{"id":"semetey-1-2013:p1149:b004:l032","ordinal":164904,"en":"At Khan Kökötöy's memorial feast,"},{"id":"semetey-1-2013:p1149:b004:l033","ordinal":164905,"en":"Before the great gathering,"},{"id":"semetey-1-2013:p1149:b004:l034","ordinal":164906,"en":"I saw bloodthirsty Manas the leopard"},{"id":"semetey-1-2013:p1149:b004:l035","ordinal":164907,"en":"Protect the people."},{"id":"semetey-1-2013:p1149:b004:l036","ordinal":164908,"en":"I saw him drain"},{"id":"semetey-1-2013:p1149:b004:l037","ordinal":164909,"en":"The Black Chinese and Manchus."},{"id":"semetey-1-2013:p1149:b004:l038","ordinal":164910,"en":"How can you go to the son"},{"id":"semetey-1-2013:p1149:b004:l039","ordinal":164911,"en":"Of such a Manas,"},{"id":"semetey-1-2013:p1150:b003:l001","ordinal":164912,"en":"How can you take his bride?"},{"id":"semetey-1-2013:p1150:b003:l002","ordinal":164913,"en":"If you continue like this, my Kozho,"},{"id":"semetey-1-2013:p1150:b003:l003","ordinal":164914,"en":"You will fall into calamity!"},{"id":"semetey-1-2013:p1150:b003:l004","ordinal":164915,"en":"When bloodthirsty Manas the leopard"},{"id":"semetey-1-2013:p1150:b003:l005","ordinal":164916,"en":"Found the Black Kalmyks and Manchus"},{"id":"semetey-1-2013:p1150:b003:l006","ordinal":164917,"en":"Lying there in arrogance,"},{"id":"semetey-1-2013:p1150:b003:l007","ordinal":164918,"en":"Letting them plunder meat from the hearths"},{"id":"semetey-1-2013:p1150:b003:l008","ordinal":164919,"en":"And beat many Kalmyks with pokers,"},{"id":"semetey-1-2013:p1150:b003:l009","ordinal":164920,"en":"Baymyrza came like a khan,"},{"id":"semetey-1-2013:p1150:b003:l010","ordinal":164921,"en":"In turmoil and dust."},{"id":"semetey-1-2013:p1150:b003:l011","ordinal":164922,"en":"“Do as you please, even if you slaughter them,"},{"id":"semetey-1-2013:p1150:b003:l012","ordinal":164923,"en":"Alas, Manas, as your heart desires!”"},{"id":"semetey-1-2013:p1150:b003:l013","ordinal":164924,"en":"Baymyrza stood and said this:"},{"id":"semetey-1-2013:p1150:b003:l014","ordinal":164925,"en":"“We held Khan Kökötöy's feast, Manas;"},{"id":"semetey-1-2013:p1150:b003:l015","ordinal":164926,"en":"We held a feast mixed with turmoil, Manas!"},{"id":"semetey-1-2013:p1150:b003:l016","ordinal":164927,"en":"We alarmed many and gathered the people;"},{"id":"semetey-1-2013:p1150:b003:l017","ordinal":164928,"en":"We have caused excessive suffering, Manas!"},{"id":"semetey-1-2013:p1150:b003:l018","ordinal":164929,"en":"In the eyes of the Black Kalmyks and Manchus"},{"id":"semetey-1-2013:p1150:b003:l019","ordinal":164930,"en":"There was a hostile glare."},{"id":"semetey-1-2013:p1150:b003:l020","ordinal":164931,"en":"If these dogs have the strength,"},{"id":"semetey-1-2013:p1150:b003:l021","ordinal":164932,"en":"They are ready to strike me."},{"id":"semetey-1-2013:p1150:b003:l022","ordinal":164933,"en":"They brought turmoil upon my feast"},{"id":"semetey-1-2013:p1150:b003:l023","ordinal":164934,"en":"And hell upon my mind."},{"id":"semetey-1-2013:p1150:b003:l024","ordinal":164935,"en":"Fed full on meat, they went mad"},{"id":"semetey-1-2013:p1150:b003:l025","ordinal":164936,"en":"And grew eager to attack."},{"id":"semetey-1-2013:p1150:b004:l001","ordinal":164937,"en":"From the seething infidels,"},{"id":"semetey-1-2013:p1150:b004:l002","ordinal":164938,"en":"How could my wretched head escape?"},{"id":"semetey-1-2013:p1150:b004:l003","ordinal":164939,"en":"Perhaps they will bind our heroes;"},{"id":"semetey-1-2013:p1150:b004:l004","ordinal":164940,"en":"These infidels, like a flood,"},{"id":"semetey-1-2013:p1150:b004:l005","ordinal":164941,"en":"May bring hell upon our heads."},{"id":"semetey-1-2013:p1150:b004:l006","ordinal":164942,"en":"Perhaps they will do as they please"},{"id":"semetey-1-2013:p1150:b004:l007","ordinal":164943,"en":"And slaughter every soul."},{"id":"semetey-1-2013:p1150:b004:l008","ordinal":164944,"en":"They seized the hearths"},{"id":"semetey-1-2013:p1150:b004:l009","ordinal":164945,"en":"And set out causing turmoil.”"},{"id":"semetey-1-2013:p1150:b004:l010","ordinal":164946,"en":"While Baymyrza spoke,"},{"id":"semetey-1-2013:p1150:b004:l011","ordinal":164947,"en":"Baymyrza, the rich man's son,"},{"id":"semetey-1-2013:p1150:b004:l012","ordinal":164948,"en":"Lost heart."},{"id":"semetey-1-2013:p1150:b004:l013","ordinal":164949,"en":"His eyes darted wildly;"},{"id":"semetey-1-2013:p1150:b004:l014","ordinal":164950,"en":"His joints went limp."},{"id":"semetey-1-2013:p1150:b004:l015","ordinal":164951,"en":"Baymyrza fled in grief;"},{"id":"semetey-1-2013:p1150:b004:l016","ordinal":164952,"en":"Suffering pressure from the infidels,"},{"id":"semetey-1-2013:p1150:b004:l017","ordinal":164953,"en":"He despaired of his entrusted life"},{"id":"semetey-1-2013:p1150:b004:l018","ordinal":164954,"en":"Hoping there might be a way,"},{"id":"semetey-1-2013:p1150:b004:l019","ordinal":164955,"en":"He ran toward Manas."},{"id":"semetey-1-2013:p1150:b004:l020","ordinal":164956,"en":"Seeing this, mighty Manas—"},{"id":"semetey-1-2013:p1150:b004:l021","ordinal":164957,"en":"Mighty Manas, who had never suffered humiliation,"},{"id":"semetey-1-2013:p1150:b004:l022","ordinal":164958,"en":"Saw a dreadful sight"},{"id":"semetey-1-2013:p1150:b004:l023","ordinal":164959,"en":"When his people came weeping;"},{"id":"semetey-1-2013:p1150:b004:l024","ordinal":164960,"en":"From the Black Chinese and Manchus,"},{"id":"semetey-1-2013:p1150:b004:l025","ordinal":164961,"en":"Mighty Manas suffered humiliation."},{"id":"semetey-1-2013:p1150:b006:l001","ordinal":164962,"en":"“Rather than see this humiliation,"},{"id":"semetey-1-2013:p1150:b006:l002","ordinal":164963,"en":"May I sink away unborn;"},{"id":"semetey-1-2013:p1150:b006:l003","ordinal":164964,"en":"Rather than this, may I die and not live."},{"id":"semetey-1-2013:p1150:b006:l004","ordinal":164965,"en":"Let me witness this humiliation"},{"id":"semetey-1-2013:p1150:b006:l005","ordinal":164966,"en":"From the seething Chinese and Manchus."},{"id":"semetey-1-2013:p1150:b006:l006","ordinal":164967,"en":"Bring Aybanboz; I will mount him."},{"id":"semetey-1-2013:p1150:b006:l007","ordinal":164968,"en":"I will drive the seething Chinese"},{"id":"semetey-1-2013:p1150:b006:l008","ordinal":164969,"en":"As far as Kakan.”"},{"id":"semetey-1-2013:p1150:b006:l009","ordinal":164970,"en":"Thus brave Manas spoke."},{"id":"semetey-1-2013:p1150:b007:l001","ordinal":164971,"en":"His eyes flashed like fire;"},{"id":"semetey-1-2013:p1150:b007:l002","ordinal":164972,"en":"His thirst for blood truly seized him."},{"id":"semetey-1-2013:p1150:b007:l003","ordinal":164973,"en":"When he advanced in earnest,"},{"id":"semetey-1-2013:p1150:b007:l004","ordinal":164974,"en":"Venom poured from his face"},{"id":"semetey-1-2013:p1150:b007:l005","ordinal":164975,"en":"And his heroic form appeared."},{"id":"semetey-1-2013:p1150:b007:l006","ordinal":164976,"en":"“Golden-cheeked battle-ax—"},{"id":"semetey-1-2013:p1150:b007:l007","ordinal":164977,"en":"You have come seeking a fight."},{"id":"semetey-1-2013:p1150:b007:l008","ordinal":164978,"en":"Great Kalcha, huge as a yurt,"},{"id":"semetey-1-2013:p1150:b007:l009","ordinal":164979,"en":"The people you beat are of another kind."},{"id":"semetey-1-2013:p1151:b003:l001","ordinal":164980,"en":"I shall now show my weight;"},{"id":"semetey-1-2013:p1151:b003:l002","ordinal":164981,"en":"My name is Manas, the champion."},{"id":"semetey-1-2013:p1151:b003:l003","ordinal":164982,"en":"Grasping the black-jawed whip"},{"id":"semetey-1-2013:p1151:b003:l004","ordinal":164983,"en":"And swinging it around,"},{"id":"semetey-1-2013:p1151:b003:l005","ordinal":164984,"en":"He struck a hero like Ezkara"},{"id":"semetey-1-2013:p1151:b003:l006","ordinal":164985,"en":"Across the crown of his head."},{"id":"semetey-1-2013:p1151:b003:l007","ordinal":164986,"en":"His fur cap flew whistling;"},{"id":"semetey-1-2013:p1151:b003:l008","ordinal":164987,"en":"The jeweled plume scattered."},{"id":"semetey-1-2013:p1151:b003:l009","ordinal":164988,"en":"Unable to withstand his wrath,"},{"id":"semetey-1-2013:p1151:b003:l010","ordinal":164989,"en":"Six thousand Chinese and a thousand kalday"},{"id":"semetey-1-2013:p1151:b003:l011","ordinal":164990,"en":"Fled away with a roar."},{"id":"semetey-1-2013:p1151:b003:l012","ordinal":164991,"en":"The handful of Muslims"},{"id":"semetey-1-2013:p1151:b003:l013","ordinal":164992,"en":"Prayed, \"May God preserve Manas!\""},{"id":"semetey-1-2013:p1151:b003:l014","ordinal":164993,"en":"Crying bitterly."},{"id":"semetey-1-2013:p1151:b003:l015","ordinal":164994,"en":"Unable to withstand his courage,"},{"id":"semetey-1-2013:p1151:b003:l016","ordinal":164995,"en":"The Manchu people cried out."},{"id":"semetey-1-2013:p1151:b003:l017","ordinal":164996,"en":"The courageous hero Manas"},{"id":"semetey-1-2013:p1151:b003:l018","ordinal":164997,"en":"Then fell upon the Kalmyks"},{"id":"semetey-1-2013:p1151:b003:l019","ordinal":164998,"en":"And brought the end-time upon their heads."},{"id":"semetey-1-2013:p1151:b003:l020","ordinal":164999,"en":"Whipping them in fury,"},{"id":"semetey-1-2013:p1151:b003:l021","ordinal":165000,"en":"Hero Manas drove them together."},{"id":"semetey-1-2013:p1151:b003:l022","ordinal":165001,"en":"Making blows crack,"},{"id":"semetey-1-2013:p1151:b003:l023","ordinal":165002,"en":"The black Kalmyks and Manchus—"},{"id":"semetey-1-2013:p1151:b003:l024","ordinal":165003,"en":"Hero Manas began beating them."},{"id":"semetey-1-2013:p1151:b003:l025","ordinal":165004,"en":"When Manas raised his hand,"},{"id":"semetey-1-2013:p1151:b003:l026","ordinal":165005,"en":"Everyone raised a hand;"},{"id":"semetey-1-2013:p1151:b003:l027","ordinal":165006,"en":"The tiger, elder Bakay,"},{"id":"semetey-1-2013:p1151:b003:l028","ordinal":165007,"en":"Raised his aged hand."},{"id":"semetey-1-2013:p1151:b003:l029","ordinal":165008,"en":"Dust flew and haze descended;"},{"id":"semetey-1-2013:p1151:b003:l030","ordinal":165009,"en":"Turmoil arose."},{"id":"semetey-1-2013:p1151:b003:l031","ordinal":165010,"en":"Khan Manas's forty companions"},{"id":"semetey-1-2013:p1151:b003:l032","ordinal":165011,"en":"Clashed and fought."},{"id":"semetey-1-2013:p1151:b003:l033","ordinal":165012,"en":"There was Almambet of Azizkan,"},{"id":"semetey-1-2013:p1151:b003:l034","ordinal":165013,"en":"And Chubak, son of Akbaltay;"},{"id":"semetey-1-2013:p1151:b003:l035","ordinal":165014,"en":"A champion equal to Manas,"},{"id":"semetey-1-2013:p1151:b003:l036","ordinal":165015,"en":"Syrgak, son of Ulak Khan,"},{"id":"semetey-1-2013:p1151:b003:l037","ordinal":165016,"en":"Moved among them sowing turmoil."},{"id":"semetey-1-2013:p1151:b003:l038","ordinal":165017,"en":"Throwing all into confusion,"},{"id":"semetey-1-2013:p1151:b003:l039","ordinal":165018,"en":"Your lions then"},{"id":"semetey-1-2013:p1151:b004:l001","ordinal":165019,"en":"Brought battle upon the Chinese."},{"id":"semetey-1-2013:p1151:b004:l002","ordinal":165020,"en":"Good heavens, hero Manas"},{"id":"semetey-1-2013:p1151:b004:l003","ordinal":165021,"en":"Carved through and beat their center;"},{"id":"semetey-1-2013:p1151:b004:l004","ordinal":165022,"en":"All around them, hero Bakay"},{"id":"semetey-1-2013:p1151:b004:l005","ordinal":165023,"en":"Slaughtered and beat them."},{"id":"semetey-1-2013:p1151:b004:l006","ordinal":165024,"en":"Their two flanks, hero Almang"},{"id":"semetey-1-2013:p1151:b004:l007","ordinal":165025,"en":"Drove and scattered;"},{"id":"semetey-1-2013:p1151:b004:l008","ordinal":165026,"en":"All around them, hero Chubak"},{"id":"semetey-1-2013:p1151:b004:l009","ordinal":165027,"en":"Drove them evenly."},{"id":"semetey-1-2013:p1151:b004:l010","ordinal":165028,"en":"The seething Chinese—"},{"id":"semetey-1-2013:p1151:b004:l011","ordinal":165029,"en":"Tiger Manas shouted"},{"id":"semetey-1-2013:p1151:b004:l012","ordinal":165030,"en":"And beat them with fierce delight."},{"id":"semetey-1-2013:p1151:b004:l013","ordinal":165031,"en":"At the edges, the forty companions"},{"id":"semetey-1-2013:p1151:b004:l014","ordinal":165032,"en":"Clashed and fought."},{"id":"semetey-1-2013:p1151:b004:l015","ordinal":165033,"en":"When one looked, the eye caught nothing;"},{"id":"semetey-1-2013:p1151:b004:l016","ordinal":165034,"en":"Among the seething multitude,"},{"id":"semetey-1-2013:p1151:b004:l017","ordinal":165035,"en":"None could tell which was which."},{"id":"semetey-1-2013:p1151:b004:l018","ordinal":165036,"en":"Dust covered them and clouds flew,"},{"id":"semetey-1-2013:p1151:b004:l019","ordinal":165037,"en":"The dust wheeling into the sky;"},{"id":"semetey-1-2013:p1151:b004:l020","ordinal":165038,"en":"The might of the black Chinese"},{"id":"semetey-1-2013:p1151:b004:l021","ordinal":165039,"en":"Was now restrained."},{"id":"semetey-1-2013:p1151:b004:l022","ordinal":165040,"en":"There the tiger, bloodthirsty Manas,"},{"id":"semetey-1-2013:p1151:b004:l023","ordinal":165041,"en":"Unleashed havoc!"},{"id":"semetey-1-2013:p1151:b004:l024","ordinal":165042,"en":"May God not turn his face against us;"},{"id":"semetey-1-2013:p1151:b004:l025","ordinal":165043,"en":"When we said we would beat and drive them,"},{"id":"semetey-1-2013:p1151:b004:l026","ordinal":165044,"en":"He slaughtered and drove them away."},{"id":"semetey-1-2013:p1151:b004:l027","ordinal":165045,"en":"Some black Kalmyks"},{"id":"semetey-1-2013:p1151:b004:l028","ordinal":165046,"en":"Ran fleeing in disorder,"},{"id":"semetey-1-2013:p1151:b004:l029","ordinal":165047,"en":"Hiding among their firewood."},{"id":"semetey-1-2013:p1151:b004:l030","ordinal":165048,"en":"Saying they had brought excessive trouble"},{"id":"semetey-1-2013:p1151:b004:l031","ordinal":165049,"en":"Upon the unyielding Burut,"},{"id":"semetey-1-2013:p1151:b004:l032","ordinal":165050,"en":"Many bitterly regretted it."},{"id":"semetey-1-2013:p1151:b004:l033","ordinal":165051,"en":"Heads split and eyes came out;"},{"id":"semetey-1-2013:p1151:b004:l034","ordinal":165052,"en":"Many roared in pain."},{"id":"semetey-1-2013:p1151:b004:l035","ordinal":165053,"en":"Unable to find their bearings,"},{"id":"semetey-1-2013:p1151:b004:l036","ordinal":165054,"en":"Many rushed about in panic,"},{"id":"semetey-1-2013:p1151:b004:l037","ordinal":165055,"en":"Sheltering beside their own horses;"},{"id":"semetey-1-2013:p1151:b004:l038","ordinal":165056,"en":"Many rushed about in panic."},{"id":"semetey-1-2013:p1151:b004:l039","ordinal":165057,"en":"Throwing all into confusion,"},{"id":"semetey-1-2013:p1152:b003:l001","ordinal":165058,"en":"When they were about to finish them utterly,"},{"id":"semetey-1-2013:p1152:b003:l002","ordinal":165059,"en":"When they were about to slaughter"},{"id":"semetey-1-2013:p1152:b003:l003","ordinal":165060,"en":"All the grim-looking black Kalmyks,"},{"id":"semetey-1-2013:p1152:b003:l004","ordinal":165061,"en":"Orokkyr and Muzkindik,"},{"id":"semetey-1-2013:p1152:b003:l005","ordinal":165062,"en":"Hero Kongurbay and Ezkara,"},{"id":"semetey-1-2013:p1152:b003:l006","ordinal":165063,"en":"Dismounted from their horses"},{"id":"semetey-1-2013:p1152:b003:l007","ordinal":165064,"en":"And held the horses back."},{"id":"semetey-1-2013:p1152:b003:l008","ordinal":165065,"en":"Dear hero Kongurbay"},{"id":"semetey-1-2013:p1152:b003:l009","ordinal":165066,"en":"Then began to speak:"},{"id":"semetey-1-2013:p1152:b003:l010","ordinal":165067,"en":"\"Here are the Burut people with a leader;"},{"id":"semetey-1-2013:p1152:b003:l011","ordinal":165068,"en":"Here are we—do with us as you will!"},{"id":"semetey-1-2013:p1152:b003:l012","ordinal":165069,"en":"If you ask our station,"},{"id":"semetey-1-2013:p1152:b003:l013","ordinal":165070,"en":"Each of us is a great lord."},{"id":"semetey-1-2013:p1152:b003:l014","ordinal":165071,"en":"Having heard word"},{"id":"semetey-1-2013:p1152:b003:l015","ordinal":165072,"en":"That it was Khan Kökötöy's feast,"},{"id":"semetey-1-2013:p1152:b003:l016","ordinal":165073,"en":"We rode here from Kakan."},{"id":"semetey-1-2013:p1152:b003:l017","ordinal":165074,"en":"We came to your feast,"},{"id":"semetey-1-2013:p1152:b003:l018","ordinal":165075,"en":"And after eating our fill,"},{"id":"semetey-1-2013:p1152:b003:l019","ordinal":165076,"en":"We grew unruly!"},{"id":"semetey-1-2013:p1152:b003:l020","ordinal":165077,"en":"Planning to unleash turmoil,"},{"id":"semetey-1-2013:p1152:b003:l021","ordinal":165078,"en":"We have fallen into hell like this!"},{"id":"semetey-1-2013:p1152:b003:l022","ordinal":165079,"en":"Coming to your feast and using force,"},{"id":"semetey-1-2013:p1152:b003:l023","ordinal":165080,"en":"We have become guilty!"},{"id":"semetey-1-2013:p1152:b003:l024","ordinal":165081,"en":"We came as guests, tiger,"},{"id":"semetey-1-2013:p1152:b003:l025","ordinal":165082,"en":"But humiliated you harshly."},{"id":"semetey-1-2013:p1152:b003:l026","ordinal":165083,"en":"Forgive this offense;"},{"id":"semetey-1-2013:p1152:b003:l027","ordinal":165084,"en":"If you will not forgive it,"},{"id":"semetey-1-2013:p1152:b003:l028","ordinal":165085,"en":"Here is the head—cut it off!\""},{"id":"semetey-1-2013:p1152:b003:l029","ordinal":165086,"en":"The bald men of the jewel-wearing Chinese"},{"id":"semetey-1-2013:p1152:b003:l030","ordinal":165087,"en":"Said this;"},{"id":"semetey-1-2013:p1152:b003:l031","ordinal":165088,"en":"The strong men of the coat-wearing Chinese"},{"id":"semetey-1-2013:p1152:b003:l032","ordinal":165089,"en":"Said this."},{"id":"semetey-1-2013:p1152:b003:l033","ordinal":165090,"en":"Their knees bent to the ground;"},{"id":"semetey-1-2013:p1152:b003:l034","ordinal":165091,"en":"As though Esenkan had come,"},{"id":"semetey-1-2013:p1152:b003:l035","ordinal":165092,"en":"They bowed before hero Manas."},{"id":"semetey-1-2013:p1152:b003:l036","ordinal":165093,"en":"Among the black Kalmyk people,"},{"id":"semetey-1-2013:p1152:b003:l037","ordinal":165094,"en":"There is the custom of bowing like women"},{"id":"semetey-1-2013:p1152:b003:l038","ordinal":165095,"en":"Before great lords;"},{"id":"semetey-1-2013:p1152:b003:l039","ordinal":165096,"en":"Such is the infidels' tradition."},{"id":"semetey-1-2013:p1152:b004:l001","ordinal":165097,"en":"\"With black Kalmyks and Manchus,"},{"id":"semetey-1-2013:p1152:b004:l002","ordinal":165098,"en":"Why should we quarrel?"},{"id":"semetey-1-2013:p1152:b004:l003","ordinal":165099,"en":"What inheritance would we gain?"},{"id":"semetey-1-2013:p1152:b004:l004","ordinal":165100,"en":"Toward infidels who came to the feast,"},{"id":"semetey-1-2013:p1152:b004:l005","ordinal":165101,"en":"Why should we behave roughly?"},{"id":"semetey-1-2013:p1152:b004:l006","ordinal":165102,"en":"By attacking amid the feast,"},{"id":"semetey-1-2013:p1152:b004:l007","ordinal":165103,"en":"What inheritance would we gain?\""},{"id":"semetey-1-2013:p1152:b004:l008","ordinal":165104,"en":"The stalwarts Koshoy and Bakay"},{"id":"semetey-1-2013:p1152:b004:l009","ordinal":165105,"en":"Stood between them."},{"id":"semetey-1-2013:p1152:b004:l010","ordinal":165106,"en":"When they were about to reach the very end"},{"id":"semetey-1-2013:p1152:b004:l011","ordinal":165107,"en":"The black Chinese and many Manchus—"},{"id":"semetey-1-2013:p1152:b004:l012","ordinal":165108,"en":"And utterly plunder them together,"},{"id":"semetey-1-2013:p1152:b004:l013","ordinal":165109,"en":"The tiger, bloodthirsty Manas,"},{"id":"semetey-1-2013:p1152:b004:l014","ordinal":165110,"en":"Stopped as though he had drunk poison."},{"id":"semetey-1-2013:p1152:b004:l015","ordinal":165111,"en":"Infidel and Muslim alike—"},{"id":"semetey-1-2013:p1152:b004:l016","ordinal":165112,"en":"Saying it was Khan Kökötöy's feast,"},{"id":"semetey-1-2013:p1152:b004:l017","ordinal":165113,"en":"A spectacle arose."},{"id":"semetey-1-2013:p1152:b004:l018","ordinal":165114,"en":"Saying it was the place of the great gathering,"},{"id":"semetey-1-2013:p1152:b004:l019","ordinal":165115,"en":"The feast of Khan Kökötöy,"},{"id":"semetey-1-2013:p1152:b004:l020","ordinal":165116,"en":"With bloodthirsty Manas among them,"},{"id":"semetey-1-2013:p1152:b004:l021","ordinal":165117,"en":"Infidel and Muslim alike"},{"id":"semetey-1-2013:p1152:b004:l022","ordinal":165118,"en":"Raced like the qibla wind,"},{"id":"semetey-1-2013:p1152:b004:l023","ordinal":165119,"en":"Made peace once more,"},{"id":"semetey-1-2013:p1152:b004:l024","ordinal":165120,"en":"Abandoned words of disorder,"}]
