[{"id":"semetey-1-2013:p1078:b004:l021","ordinal":158465,"en":"Day passed and night came,"},{"id":"semetey-1-2013:p1078:b004:l022","ordinal":158466,"en":"Darkness settled as brows turned black."},{"id":"semetey-1-2013:p1078:b004:l023","ordinal":158467,"en":"His eyes bound by night travel,"},{"id":"semetey-1-2013:p1078:b004:l024","ordinal":158468,"en":"He crossed winding ravines,"},{"id":"semetey-1-2013:p1078:b004:l025","ordinal":158469,"en":"And passed twisting mountains."},{"id":"semetey-1-2013:p1078:b004:l026","ordinal":158470,"en":"Seeing a broad black river,"},{"id":"semetey-1-2013:p1078:b004:l027","ordinal":158471,"en":"He traveled without turning aside,"},{"id":"semetey-1-2013:p1078:b004:l028","ordinal":158472,"en":"Covering much ground without sparing his horse."},{"id":"semetey-1-2013:p1078:b004:l029","ordinal":158473,"en":"Now he drew near"},{"id":"semetey-1-2013:p1078:b004:l030","ordinal":158474,"en":"The junction of nine roads,"},{"id":"semetey-1-2013:p1078:b004:l031","ordinal":158475,"en":"At the boundary of Börü-Koy:"},{"id":"semetey-1-2013:p1078:b004:l032","ordinal":158476,"en":"One road came into Afghanistan,"},{"id":"semetey-1-2013:p1078:b004:l033","ordinal":158477,"en":"A black road went to Kashgar;"},{"id":"semetey-1-2013:p1078:b004:l034","ordinal":158478,"en":"One road came into Afghanistan,"},{"id":"semetey-1-2013:p1078:b004:l035","ordinal":158479,"en":"A straight road went to Turpan;"},{"id":"semetey-1-2013:p1078:b004:l036","ordinal":158480,"en":"One road came into Afghanistan,"},{"id":"semetey-1-2013:p1078:b004:l037","ordinal":158481,"en":"A marked road went to Beijing;"},{"id":"semetey-1-2013:p1078:b004:l038","ordinal":158482,"en":"One road came into Afghanistan—"},{"id":"semetey-1-2013:p1079:b003:l001","ordinal":158483,"en":"A perilous road went to Kokon;"},{"id":"semetey-1-2013:p1079:b003:l002","ordinal":158484,"en":"One road came into Afghanistan,"},{"id":"semetey-1-2013:p1079:b003:l003","ordinal":158485,"en":"The safe road of Andijan."},{"id":"semetey-1-2013:p1079:b003:l004","ordinal":158486,"en":"He circled and surveyed them all;"},{"id":"semetey-1-2013:p1079:b003:l005","ordinal":158487,"en":"The orphan boy Külchoro"},{"id":"semetey-1-2013:p1079:b003:l006","ordinal":158488,"en":"Now marveled at the land."},{"id":"semetey-1-2013:p1079:b003:l007","ordinal":158489,"en":"As Külchoro looked carefully,"},{"id":"semetey-1-2013:p1079:b003:l008","ordinal":158490,"en":"There was the crest of a rise;"},{"id":"semetey-1-2013:p1079:b003:l009","ordinal":158491,"en":"When he rode up and looked,"},{"id":"semetey-1-2013:p1079:b003:l010","ordinal":158492,"en":"There stood Manas's cairn."},{"id":"semetey-1-2013:p1079:b003:l011","ordinal":158493,"en":"Upon the cairn stone"},{"id":"semetey-1-2013:p1079:b003:l012","ordinal":158494,"en":"Was Almambet's inscription."},{"id":"semetey-1-2013:p1079:b003:l013","ordinal":158495,"en":"Yesterday, when they were bringing disgrace"},{"id":"semetey-1-2013:p1079:b003:l014","ordinal":158496,"en":"Upon the kozho in Kokon,"},{"id":"semetey-1-2013:p1079:b003:l015","ordinal":158497,"en":"When they were imposing violent turmoil"},{"id":"semetey-1-2013:p1079:b003:l016","ordinal":158498,"en":"Across the face of the earth,"},{"id":"semetey-1-2013:p1079:b003:l017","ordinal":158499,"en":"When mighty leopard Manas"},{"id":"semetey-1-2013:p1079:b003:l018","ordinal":158500,"en":"Struck the Kyzylbash people"},{"id":"semetey-1-2013:p1079:b003:l019","ordinal":158501,"en":"And returned them facing home,"},{"id":"semetey-1-2013:p1079:b003:l020","ordinal":158502,"en":"That was when heroic leopard Manas"},{"id":"semetey-1-2013:p1079:b003:l021","ordinal":158503,"en":"Had gone down there;"},{"id":"semetey-1-2013:p1079:b003:l022","ordinal":158504,"en":"It was the place where Almambet,"},{"id":"semetey-1-2013:p1079:b003:l023","ordinal":158505,"en":"Chubak, and brave Manas had lain."},{"id":"semetey-1-2013:p1079:b003:l024","ordinal":158506,"en":"\"This is the black stone's inscription;"},{"id":"semetey-1-2013:p1079:b003:l025","ordinal":158507,"en":"This is the name of Khan Almambet."},{"id":"semetey-1-2013:p1079:b003:l026","ordinal":158508,"en":"This is a pass left by the forefathers,"},{"id":"semetey-1-2013:p1079:b003:l027","ordinal":158509,"en":"A place where heroes lay."},{"id":"semetey-1-2013:p1079:b003:l028","ordinal":158510,"en":"It is a pass brave Toltoy"},{"id":"semetey-1-2013:p1079:b003:l029","ordinal":158511,"en":"Will cross without noticing."},{"id":"semetey-1-2013:p1079:b003:l030","ordinal":158512,"en":"Over there is Batkalysh Hill, Besh-Belchir;"},{"id":"semetey-1-2013:p1079:b003:l031","ordinal":158513,"en":"Sovereign God, bring it face to face"},{"id":"semetey-1-2013:p1079:b003:l032","ordinal":158514,"en":"With boastful Toltoy."},{"id":"semetey-1-2013:p1079:b003:l033","ordinal":158515,"en":"If he suddenly arrives,"},{"id":"semetey-1-2013:p1079:b003:l034","ordinal":158516,"en":"If Toltoy unexpectedly appears,"},{"id":"semetey-1-2013:p1079:b003:l035","ordinal":158517,"en":"Let us level our spears straight"},{"id":"semetey-1-2013:p1079:b003:l036","ordinal":158518,"en":"And fight without drawing back."},{"id":"semetey-1-2013:p1079:b003:l037","ordinal":158519,"en":"Let us be drenched in bloody blood,"},{"id":"semetey-1-2013:p1079:b003:l038","ordinal":158520,"en":"And stand fighting without fleeing."},{"id":"semetey-1-2013:p1079:b003:l039","ordinal":158521,"en":"If brave Toltoy suddenly turns and runs,"},{"id":"semetey-1-2013:p1079:b004:l001","ordinal":158522,"en":"Buurul will drive him onto the plain;"},{"id":"semetey-1-2013:p1079:b004:l002","ordinal":158523,"en":"From the feather-grass-covered rise,"},{"id":"semetey-1-2013:p1079:b004:l003","ordinal":158524,"en":"From the broad-backed high pass,"},{"id":"semetey-1-2013:p1079:b004:l004","ordinal":158525,"en":"Unless he dies, Buurul will catch him."},{"id":"semetey-1-2013:p1079:b004:l005","ordinal":158526,"en":"God, guide the path"},{"id":"semetey-1-2013:p1079:b004:l006","ordinal":158527,"en":"Of the lions gone before;"},{"id":"semetey-1-2013:p1079:b004:l007","ordinal":158528,"en":"Lion Manas, with whom twelve joined hands,"},{"id":"semetey-1-2013:p1079:b004:l008","ordinal":158529,"en":"Stand as my protector.\""},{"id":"semetey-1-2013:p1079:b004:l009","ordinal":158530,"en":"Growing bold and bracing himself,"},{"id":"semetey-1-2013:p1079:b004:l010","ordinal":158531,"en":"The renowned leopard kinsman"},{"id":"semetey-1-2013:p1079:b004:l011","ordinal":158532,"en":"Swayed as though struck from this side."},{"id":"semetey-1-2013:p1079:b004:l012","ordinal":158533,"en":"Humming, without a care:"},{"id":"semetey-1-2013:p1079:b004:l013","ordinal":158534,"en":"\"Toltoy of the Zhediger"},{"id":"semetey-1-2013:p1079:b004:l014","ordinal":158535,"en":"Is said to be approaching.\""},{"id":"semetey-1-2013:p1079:b004:l015","ordinal":158536,"en":"He did not value him at his trouser cuff."},{"id":"semetey-1-2013:p1079:b004:l016","ordinal":158537,"en":"God Almighty, the Omnipotent,"},{"id":"semetey-1-2013:p1079:b004:l017","ordinal":158538,"en":"Had given courage and proud daring"},{"id":"semetey-1-2013:p1079:b004:l018","ordinal":158539,"en":"Without measure."},{"id":"semetey-1-2013:p1079:b004:l019","ordinal":158540,"en":"The leopard's Syrnayza—"},{"id":"semetey-1-2013:p1079:b004:l020","ordinal":158541,"en":"Ill-fated Külchoro"},{"id":"semetey-1-2013:p1079:b004:l021","ordinal":158542,"en":"Now took it firmly in his hand."},{"id":"semetey-1-2013:p1079:b004:l022","ordinal":158543,"en":"The white reins steeped in dye"},{"id":"semetey-1-2013:p1079:b004:l023","ordinal":158544,"en":"He wound twice around"},{"id":"semetey-1-2013:p1079:b004:l024","ordinal":158545,"en":"The pommel of Akkangky."},{"id":"semetey-1-2013:p1079:b004:l025","ordinal":158546,"en":"Saying, \"I take the risk—Allah, support me,\""},{"id":"semetey-1-2013:p1079:b004:l026","ordinal":158547,"en":"He now planted Semetey's Syrnayza"},{"id":"semetey-1-2013:p1079:b004:l027","ordinal":158548,"en":"Firmly into the earth."},{"id":"semetey-1-2013:p1079:b004:l028","ordinal":158549,"en":"He now set up a stone support."},{"id":"semetey-1-2013:p1079:b004:l029","ordinal":158550,"en":"Without saying Toltoy was coming,"},{"id":"semetey-1-2013:p1079:b004:l030","ordinal":158551,"en":"Lion-born Külchoro"},{"id":"semetey-1-2013:p1079:b004:l031","ordinal":158552,"en":"Grew weary and fell asleep."},{"id":"semetey-1-2013:p1079:b004:l032","ordinal":158553,"en":"He now began to snore;"},{"id":"semetey-1-2013:p1079:b004:l033","ordinal":158554,"en":"Fearless Külchoro"},{"id":"semetey-1-2013:p1079:b004:l034","ordinal":158555,"en":"Slept on without stirring."},{"id":"semetey-1-2013:p1079:b004:l035","ordinal":158556,"en":"He lay there propped up,"},{"id":"semetey-1-2013:p1079:b004:l036","ordinal":158557,"en":"Sleeping in the saddle."},{"id":"semetey-1-2013:p1079:b004:l037","ordinal":158558,"en":"As for Külchoro's guest,"},{"id":"semetey-1-2013:p1079:b004:l038","ordinal":158559,"en":"Now let me tell"},{"id":"semetey-1-2013:p1079:b004:l039","ordinal":158560,"en":"The tale of brave Toltoy."}]
