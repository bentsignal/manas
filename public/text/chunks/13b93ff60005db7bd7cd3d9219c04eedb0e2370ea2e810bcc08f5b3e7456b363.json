[{"id":"semetey-1-2013:p0740:b004:l035","ordinal":133633,"en":"His wisdom a brimming river,"},{"id":"semetey-1-2013:p0740:b004:l036","ordinal":133634,"en":"My aged uncle Bakai"},{"id":"semetey-1-2013:p0740:b004:l037","ordinal":133635,"en":"Spurred into the hills,"},{"id":"semetey-1-2013:p0740:b004:l038","ordinal":133636,"en":"Darting onward with Kokcholok,"},{"id":"semetey-1-2013:p0740:b004:l039","ordinal":133637,"en":"Unnoticed by a single person,"},{"id":"semetey-1-2013:p0741:b003:l001","ordinal":133638,"en":"Unseen by a single soul,"},{"id":"semetey-1-2013:p0741:b003:l002","ordinal":133639,"en":"So great was his knowledge,"},{"id":"semetey-1-2013:p0741:b003:l003","ordinal":133640,"en":"Bakai the leopard"},{"id":"semetey-1-2013:p0741:b003:l004","ordinal":133641,"en":"“The dear child gained from death—"},{"id":"semetey-1-2013:p0741:b003:l005","ordinal":133642,"en":"What might they do to him?”"},{"id":"semetey-1-2013:p0741:b003:l006","ordinal":133643,"en":"He went in fear—do you see?"},{"id":"semetey-1-2013:p0741:b003:l007","ordinal":133644,"en":"Of unbelieving Abyke and Kobosh,"},{"id":"semetey-1-2013:p0741:b003:l008","ordinal":133645,"en":"He went in dread—do you see?"},{"id":"semetey-1-2013:p0741:b003:l009","ordinal":133646,"en":"Following down the bank,"},{"id":"semetey-1-2013:p0741:b003:l010","ordinal":133647,"en":"Seven passes and forty hillocks,"},{"id":"semetey-1-2013:p0741:b003:l011","ordinal":133648,"en":"He searched them all without omission."},{"id":"semetey-1-2013:p0741:b003:l012","ordinal":133649,"en":"From a particular dark hill,"},{"id":"semetey-1-2013:p0741:b003:l013","ordinal":133650,"en":"When he looked from its flank,"},{"id":"semetey-1-2013:p0741:b003:l014","ordinal":133651,"en":"An unusual person appeared."},{"id":"semetey-1-2013:p0741:b003:l015","ordinal":133652,"en":"When he saw that person,"},{"id":"semetey-1-2013:p0741:b003:l016","ordinal":133653,"en":"Your wolfish uncle Bakai's"},{"id":"semetey-1-2013:p0741:b003:l017","ordinal":133654,"en":"Heart was sorely troubled."},{"id":"semetey-1-2013:p0741:b003:l018","ordinal":133655,"en":"The form and bearing,"},{"id":"semetey-1-2013:p0741:b003:l019","ordinal":133656,"en":"The appearance on horseback—"},{"id":"semetey-1-2013:p0741:b003:l020","ordinal":133657,"en":"It was one of the forty warriors."},{"id":"semetey-1-2013:p0741:b003:l021","ordinal":133658,"en":"Seeing this, mighty Bakai"},{"id":"semetey-1-2013:p0741:b003:l022","ordinal":133659,"en":"Looked from the ridges."},{"id":"semetey-1-2013:p0741:b003:l023","ordinal":133660,"en":"It did not look like Kyrgylchal."},{"id":"semetey-1-2013:p0741:b003:l024","ordinal":133661,"en":"When he looked from the front,"},{"id":"semetey-1-2013:p0741:b003:l025","ordinal":133662,"en":"It did not look like Baichoro."},{"id":"semetey-1-2013:p0741:b003:l026","ordinal":133663,"en":"When he watched the way he rode,"},{"id":"semetey-1-2013:p0741:b003:l027","ordinal":133664,"en":"It did not look like Tazbaimat."},{"id":"semetey-1-2013:p0741:b003:l028","ordinal":133665,"en":"Drawing very near, Khan Bakai,"},{"id":"semetey-1-2013:p0741:b003:l029","ordinal":133666,"en":"When valiant Bakai looked,"},{"id":"semetey-1-2013:p0741:b003:l030","ordinal":133667,"en":"It was heroic Shuutu, with a hat like a yurt's roof felt,"},{"id":"semetey-1-2013:p0741:b003:l031","ordinal":133668,"en":"The hawk among humankind,"},{"id":"semetey-1-2013:p0741:b003:l032","ordinal":133669,"en":"Manas, gone to the Last Judgment,"},{"id":"semetey-1-2013:p0741:b003:l033","ordinal":133670,"en":"He had not forgotten, poor soul."},{"id":"semetey-1-2013:p0741:b003:l034","ordinal":133671,"en":"The finest of the forty warriors,"},{"id":"semetey-1-2013:p0741:b003:l035","ordinal":133672,"en":"Wolf-maned Bakai the Leopard's"},{"id":"semetey-1-2013:p0741:b003:l036","ordinal":133673,"en":"Suitable partner for counsel,"},{"id":"semetey-1-2013:p0741:b003:l037","ordinal":133674,"en":"Himself the son of a prince,"},{"id":"semetey-1-2013:p0741:b003:l038","ordinal":133675,"en":"Noble Shuutu, his heroic peer,"},{"id":"semetey-1-2013:p0741:b003:l039","ordinal":133676,"en":"While alive, one to gather with;"},{"id":"semetey-1-2013:p0741:b004:l001","ordinal":133677,"en":"If dead, a companion in faith."},{"id":"semetey-1-2013:p0741:b004:l002","ordinal":133678,"en":"In this Kobosh's hands,"},{"id":"semetey-1-2013:p0741:b004:l003","ordinal":133679,"en":"Powerless, Shuutu the bondsman"},{"id":"semetey-1-2013:p0741:b004:l004","ordinal":133680,"en":"Was in a net forty ropes long."},{"id":"semetey-1-2013:p0741:b004:l005","ordinal":133681,"en":"He went about grieving much:"},{"id":"semetey-1-2013:p0741:b004:l006","ordinal":133682,"en":"“Manas the Leopard,” he kept saying."},{"id":"semetey-1-2013:p0741:b004:l007","ordinal":133683,"en":"“Kanykei left in mourning;"},{"id":"semetey-1-2013:p0741:b004:l008","ordinal":133684,"en":"Semetey fled away."},{"id":"semetey-1-2013:p0741:b004:l009","ordinal":133685,"en":"The Bloodthirsty One's wife and child,"},{"id":"semetey-1-2013:p0741:b004:l010","ordinal":133686,"en":"What became of them?” he kept asking."},{"id":"semetey-1-2013:p0741:b004:l011","ordinal":133687,"en":"He heard accounts from knowledgeable men,"},{"id":"semetey-1-2013:p0741:b004:l012","ordinal":133688,"en":"And asked much of those who knew."},{"id":"semetey-1-2013:p0741:b004:l013","ordinal":133689,"en":"He went about grieving much:"},{"id":"semetey-1-2013:p0741:b004:l014","ordinal":133690,"en":"“My Bloodthirsty One's Semetey,"},{"id":"semetey-1-2013:p0741:b004:l015","ordinal":133691,"en":"Will he come?” he kept asking."},{"id":"semetey-1-2013:p0741:b004:l016","ordinal":133692,"en":"Abyke and Kobosh, the two villains,"},{"id":"semetey-1-2013:p0741:b004:l017","ordinal":133693,"en":"Thinking he would die."},{"id":"semetey-1-2013:p0741:b004:l018","ordinal":133694,"en":"“God has given us Manas,” they said."},{"id":"semetey-1-2013:p0741:b004:l019","ordinal":133695,"en":"Their brows grew bright and clear;"},{"id":"semetey-1-2013:p0741:b004:l020","ordinal":133696,"en":"Their foreboding healed and lifted."},{"id":"semetey-1-2013:p0741:b004:l021","ordinal":133697,"en":"In the marsh of Uyrulmo,"},{"id":"semetey-1-2013:p0741:b004:l022","ordinal":133698,"en":"They gathered in a circle."},{"id":"semetey-1-2013:p0741:b004:l023","ordinal":133699,"en":"In the marsh of Chogulma,"},{"id":"semetey-1-2013:p0741:b004:l024","ordinal":133700,"en":"They assembled together."},{"id":"semetey-1-2013:p0741:b004:l025","ordinal":133701,"en":"Crying, “Baabedin!”"},{"id":"semetey-1-2013:p0741:b004:l026","ordinal":133702,"en":"Raising the war cry, “Kobosh!”"},{"id":"semetey-1-2013:p0741:b004:l027","ordinal":133703,"en":"All the six villains,"},{"id":"semetey-1-2013:p0741:b004:l028","ordinal":133704,"en":"And the elders of the forty warriors, Kyrgyl at their head,"},{"id":"semetey-1-2013:p0741:b004:l030","ordinal":133705,"en":"Abyke and Kobosh justified themselves:"},{"id":"semetey-1-2013:p0741:b004:l031","ordinal":133706,"en":"“We have imposed tribute like this,” they said."},{"id":"semetey-1-2013:p0741:b004:l032","ordinal":133707,"en":"“We have become sultans,” they said."},{"id":"semetey-1-2013:p0741:b004:l033","ordinal":133708,"en":"Abyke, Kobosh, the six villains,"},{"id":"semetey-1-2013:p0741:b004:l034","ordinal":133709,"en":"Boasted to the forty warriors."},{"id":"semetey-1-2013:p0741:b004:l035","ordinal":133710,"en":"In Kobosh's house,"},{"id":"semetey-1-2013:p0741:b004:l036","ordinal":133711,"en":"In the corner was strong liquor,"},{"id":"semetey-1-2013:p0741:b004:l037","ordinal":133712,"en":"Liquor in a Kalmyk-style leather flask."},{"id":"semetey-1-2013:p0741:b004:l038","ordinal":133713,"en":"Opening their tall leather vessels,"},{"id":"semetey-1-2013:p0741:b004:l039","ordinal":133714,"en":"The liquor in flasks and tall leather vessels,"},{"id":"semetey-1-2013:p0742:b003:l001","ordinal":133715,"en":"They opened them and poured it out."},{"id":"semetey-1-2013:p0742:b003:l002","ordinal":133716,"en":"A formidable man, a formidable business,"},{"id":"semetey-1-2013:p0742:b003:l003","ordinal":133717,"en":"Performing rites in Kalmyk fashion,"},{"id":"semetey-1-2013:p0742:b003:l004","ordinal":133718,"en":"Chattering noisily, they offered drinks."},{"id":"semetey-1-2013:p0742:b003:l005","ordinal":133719,"en":"Drinking his liquor, justifying himself,"},{"id":"semetey-1-2013:p0742:b003:l006","ordinal":133720,"en":"That empty-hearted bastard,"},{"id":"semetey-1-2013:p0742:b003:l007","ordinal":133721,"en":"Dog Kobosh stood boasting."},{"id":"semetey-1-2013:p0742:b003:l008","ordinal":133722,"en":"Shouting to the forty warriors,"},{"id":"semetey-1-2013:p0742:b003:l009","ordinal":133723,"en":"Their elders with Kyrgyl at their head,"},{"id":"semetey-1-2013:p0742:b003:l010","ordinal":133724,"en":"He called, “Come here!"},{"id":"semetey-1-2013:p0742:b003:l011","ordinal":133725,"en":"When your mighty Manas lived,"},{"id":"semetey-1-2013:p0742:b003:l012","ordinal":133726,"en":"You forty came from forty different places."},{"id":"semetey-1-2013:p0742:b003:l014","ordinal":133727,"en":"When that simpleton of yours, Manas, lived,"},{"id":"semetey-1-2013:p0742:b003:l015","ordinal":133728,"en":"When were you khans as you are under me?"},{"id":"semetey-1-2013:p0742:b003:l016","ordinal":133729,"en":"When Manas lived,"},{"id":"semetey-1-2013:p0742:b003:l017","ordinal":133730,"en":"You became his equals by fighting his enemies."},{"id":"semetey-1-2013:p0742:b003:l018","ordinal":133731,"en":"Now that I am here,"},{"id":"semetey-1-2013:p0742:b003:l019","ordinal":133732,"en":"You became a seasoned lion."},{"id":"semetey-1-2013:p0742:b003:l020","ordinal":133733,"en":"When Manas lived,"},{"id":"semetey-1-2013:p0742:b003:l021","ordinal":133734,"en":"You wearied yourselves on reconnaissance."},{"id":"semetey-1-2013:p0742:b003:l022","ordinal":133735,"en":"Forty warriors, you grew old fighting."},{"id":"semetey-1-2013:p0742:b003:l024","ordinal":133736,"en":"Your elders suffered humiliation;"},{"id":"semetey-1-2013:p0742:b003:l025","ordinal":133737,"en":"All of you went childless."},{"id":"semetey-1-2013:p0742:b003:l026","ordinal":133738,"en":"Damn you, forty warriors!"},{"id":"semetey-1-2013:p0742:b003:l027","ordinal":133739,"en":"Your day has come—laugh now,"},{"id":"semetey-1-2013:p0742:b003:l028","ordinal":133740,"en":"And recognize this service of mine."},{"id":"semetey-1-2013:p0742:b003:l029","ordinal":133741,"en":"Your misfortune has now been undone;"},{"id":"semetey-1-2013:p0742:b003:l030","ordinal":133742,"en":"Forty warriors, value it dearly."},{"id":"semetey-1-2013:p0742:b003:l031","ordinal":133743,"en":"If I, Kobosh, stand face to face,"},{"id":"semetey-1-2013:p0742:b003:l032","ordinal":133744,"en":"I strike down one as huge as a mountain."},{"id":"semetey-1-2013:p0742:b003:l033","ordinal":133745,"en":"At this very moment,"},{"id":"semetey-1-2013:p0742:b003:l034","ordinal":133746,"en":"What have I become?"},{"id":"semetey-1-2013:p0742:b003:l035","ordinal":133747,"en":"Forty warriors, judge it all in turn."},{"id":"semetey-1-2013:p0742:b003:l036","ordinal":133748,"en":"What were the days of Manas like?"},{"id":"semetey-1-2013:p0742:b003:l037","ordinal":133749,"en":"What are my days like?"},{"id":"semetey-1-2013:p0742:b003:l038","ordinal":133750,"en":"Forty warriors, judge today!"},{"id":"semetey-1-2013:p0742:b003:l039","ordinal":133751,"en":"Forty warriors, sing your song;"},{"id":"semetey-1-2013:p0742:b004:l001","ordinal":133752,"en":"Tell your secret as truthfully as your faith.”"},{"id":"semetey-1-2013:p0742:b004:l002","ordinal":133753,"en":"Puffing and swelling with pride,"},{"id":"semetey-1-2013:p0742:b004:l003","ordinal":133754,"en":"While Kobosh stood thus,"},{"id":"semetey-1-2013:p0742:b004:l004","ordinal":133755,"en":"Kyrgyl and Tazbaimat,"},{"id":"semetey-1-2013:p0742:b004:l005","ordinal":133756,"en":"Fawning and flattering,"},{"id":"semetey-1-2013:p0742:b004:l006","ordinal":133757,"en":"Cowered beneath Kobosh's arm."},{"id":"semetey-1-2013:p0742:b004:l007","ordinal":133758,"en":"When God had struck Kyrgyl,"},{"id":"semetey-1-2013:p0742:b004:l008","ordinal":133759,"en":"While he stood flattering,"},{"id":"semetey-1-2013:p0742:b004:l009","ordinal":133760,"en":"What could poor Kyrgyl do?"},{"id":"semetey-1-2013:p0742:b004:l010","ordinal":133761,"en":"Unable to gather courage and venture close,"},{"id":"semetey-1-2013:p0742:b004:l011","ordinal":133762,"en":"Of the six struck by darkness,"},{"id":"semetey-1-2013:p0742:b004:l012","ordinal":133763,"en":"He could find not one heroic deed."},{"id":"semetey-1-2013:p0742:b004:l013","ordinal":133764,"en":"Looking, he could meet no one's eyes;"},{"id":"semetey-1-2013:p0742:b004:l014","ordinal":133765,"en":"Trying to speak, no words came."},{"id":"semetey-1-2013:p0742:b004:l015","ordinal":133766,"en":"There was no saddlecloth to saddle up and ride,"},{"id":"semetey-1-2013:p0742:b004:l016","ordinal":133767,"en":"Nor courage to cleave the ranks."},{"id":"semetey-1-2013:p0742:b004:l017","ordinal":133768,"en":"Deeply ashamed, Kyrgylchal"},{"id":"semetey-1-2013:p0742:b004:l018","ordinal":133769,"en":"Toppled and fell sideways."},{"id":"semetey-1-2013:p0742:b004:l019","ordinal":133770,"en":"God-stricken Tazbaimat"},{"id":"semetey-1-2013:p0742:b004:l020","ordinal":133771,"en":"Stood scratching at the earth."},{"id":"semetey-1-2013:p0742:b004:l021","ordinal":133772,"en":"Khan Manas's forty warriors,"},{"id":"semetey-1-2013:p0742:b004:l022","ordinal":133773,"en":"When looked at, not one spoke."},{"id":"semetey-1-2013:p0742:b004:l023","ordinal":133774,"en":"As though struck dumb,"},{"id":"semetey-1-2013:p0742:b004:l024","ordinal":133775,"en":"Not one said a word to Kobosh."},{"id":"semetey-1-2013:p0742:b004:l025","ordinal":133776,"en":"As though struck dumb,"},{"id":"semetey-1-2013:p0742:b004:l026","ordinal":133777,"en":"They were left speechless."},{"id":"semetey-1-2013:p0742:b004:l027","ordinal":133778,"en":"Their elders, Kyrgyl at their head,"},{"id":"semetey-1-2013:p0742:b004:l028","ordinal":133779,"en":"Shifted uneasily and scratched the ground,"},{"id":"semetey-1-2013:p0742:b004:l029","ordinal":133780,"en":"All the forty warriors."},{"id":"semetey-1-2013:p0742:b004:l030","ordinal":133781,"en":"Among those warriors,"},{"id":"semetey-1-2013:p0742:b004:l031","ordinal":133782,"en":"Heroic Shuutu, with a hat like a yurt's roof felt,"},{"id":"semetey-1-2013:p0742:b004:l032","ordinal":133783,"en":"And Yraman's son Yrchy,"},{"id":"semetey-1-2013:p0742:b004:l033","ordinal":133784,"en":"These two spoke the truth."},{"id":"semetey-1-2013:p0742:b004:l034","ordinal":133785,"en":"They said bitter things that pierced the marrow:"},{"id":"semetey-1-2013:p0742:b004:l035","ordinal":133786,"en":"“What was Manas like, what a lion!"},{"id":"semetey-1-2013:p0742:b004:l036","ordinal":133787,"en":"When bloodthirsty Manas lived,"},{"id":"semetey-1-2013:p0742:b004:l037","ordinal":133788,"en":"What were the days we passed like?"},{"id":"semetey-1-2013:p0742:b004:l038","ordinal":133789,"en":"Speak today, Khan Kobosh,"},{"id":"semetey-1-2013:p0742:b004:l039","ordinal":133790,"en":"Like roasted flour stirred into water,"},{"id":"semetey-1-2013:p0743:b003:l001","ordinal":133791,"en":"When wolf-maned Manas lived,"},{"id":"semetey-1-2013:p0743:b003:l002","ordinal":133792,"en":"We fought with many lands;"},{"id":"semetey-1-2013:p0743:b003:l003","ordinal":133793,"en":"We raided their horses openly."},{"id":"semetey-1-2013:p0743:b003:l004","ordinal":133794,"en":"We jousted with many giants;"},{"id":"semetey-1-2013:p0743:b003:l005","ordinal":133795,"en":"We satisfied every itching urge,"},{"id":"semetey-1-2013:p0743:b003:l006","ordinal":133796,"en":"And lived immersed in delight."},{"id":"semetey-1-2013:p0743:b003:l007","ordinal":133797,"en":"Into liquor poured in leather flasks like yours,"},{"id":"semetey-1-2013:p0743:b003:l009","ordinal":133798,"en":"When wild fury seized us,"},{"id":"semetey-1-2013:p0743:b003:l010","ordinal":133799,"en":"We would grasp such a flask by its mouth,"},{"id":"semetey-1-2013:p0743:b003:l011","ordinal":133800,"en":"And piss into it in a stream."},{"id":"semetey-1-2013:p0743:b003:l012","ordinal":133801,"en":"You gathered forty warriors and became khan;"},{"id":"semetey-1-2013:p0743:b003:l013","ordinal":133802,"en":"Uncle Kobosh, when will you perform a heroic deed?"},{"id":"semetey-1-2013:p0743:b003:l014","ordinal":133803,"en":"These words of yours are empty talk;"},{"id":"semetey-1-2013:p0743:b003:l015","ordinal":133804,"en":"Uncle Kobosh, you stand praising your liquor."},{"id":"semetey-1-2013:p0743:b003:l016","ordinal":133805,"en":"Liquor is bitter fare;"},{"id":"semetey-1-2013:p0743:b003:l017","ordinal":133806,"en":"The drinker's head becomes confused."},{"id":"semetey-1-2013:p0743:b003:l018","ordinal":133807,"en":"A man who has filled himself with liquor"},{"id":"semetey-1-2013:p0743:b003:l019","ordinal":133808,"en":"Attacks even his own mother."},{"id":"semetey-1-2013:p0743:b003:l020","ordinal":133809,"en":"You boast of your liquor and food;"},{"id":"semetey-1-2013:p0743:b003:l021","ordinal":133810,"en":"Whenever I look,"},{"id":"semetey-1-2013:p0743:b003:l022","ordinal":133811,"en":"Your brow never leaves the house."},{"id":"semetey-1-2013:p0743:b003:l023","ordinal":133812,"en":"When bloodthirsty Manas lived,"},{"id":"semetey-1-2013:p0743:b003:l024","ordinal":133813,"en":"When the Leopard was alive,"},{"id":"semetey-1-2013:p0743:b003:l025","ordinal":133814,"en":"Damn you, forty warriors!"},{"id":"semetey-1-2013:p0743:b003:l026","ordinal":133815,"en":"We all settled in Talas;"},{"id":"semetey-1-2013:p0743:b003:l027","ordinal":133816,"en":"We became Manas's warriors."},{"id":"semetey-1-2013:p0743:b003:l028","ordinal":133817,"en":"Fattening our horses, we grew skilled;"},{"id":"semetey-1-2013:p0743:b003:l029","ordinal":133818,"en":"Camping as neighbors, we became forty."},{"id":"semetey-1-2013:p0743:b003:l030","ordinal":133819,"en":"When Manas the Tiger lived,"},{"id":"semetey-1-2013:p0743:b003:l031","ordinal":133820,"en":"We fought the enemy together;"},{"id":"semetey-1-2013:p0743:b003:l032","ordinal":133821,"en":"We pressed our claims together;"},{"id":"semetey-1-2013:p0743:b003:l033","ordinal":133822,"en":"We scouted together;"},{"id":"semetey-1-2013:p0743:b003:l034","ordinal":133823,"en":"We took horses from foreign-speaking peoples."},{"id":"semetey-1-2013:p0743:b003:l035","ordinal":133824,"en":"With Manas the Leopard, that lion,"},{"id":"semetey-1-2013:p0743:b003:l036","ordinal":133825,"en":"When did we ever fall out?"},{"id":"semetey-1-2013:p0743:b003:l037","ordinal":133826,"en":"In death we died together;"},{"id":"semetey-1-2013:p0743:b003:l038","ordinal":133827,"en":"We enjoyed happiness together."},{"id":"semetey-1-2013:p0743:b003:l039","ordinal":133828,"en":"The matchless Akolpok armor"},{"id":"semetey-1-2013:p0743:b004:l001","ordinal":133829,"en":"We threw into the middle,"},{"id":"semetey-1-2013:p0743:b004:l002","ordinal":133830,"en":"And split it into equal shares."},{"id":"semetey-1-2013:p0743:b004:l003","ordinal":133831,"en":"With sovereign Manas the Lion,"},{"id":"semetey-1-2013:p0743:b004:l004","ordinal":133832,"en":"We united when tiny as lice;"},{"id":"semetey-1-2013:p0743:b004:l005","ordinal":133833,"en":"We joined when thumb-small."},{"id":"semetey-1-2013:p0743:b004:l006","ordinal":133834,"en":"When we lived in open delight,"},{"id":"semetey-1-2013:p0743:b004:l007","ordinal":133835,"en":"Each of you forty warriors,"},{"id":"semetey-1-2013:p0743:b004:l008","ordinal":133836,"en":"Into your treasuries yellow gold"},{"id":"semetey-1-2013:p0743:b004:l009","ordinal":133837,"en":"Was being weighed in equal loads."},{"id":"semetey-1-2013:p0743:b004:l010","ordinal":133838,"en":"When bored, we shot roe deer;"},{"id":"semetey-1-2013:p0743:b004:l011","ordinal":133839,"en":"When not bored, in Talas,"},{"id":"semetey-1-2013:p0743:b004:l012","ordinal":133840,"en":"We rode two-year-olds and flew hawks,"},{"id":"semetey-1-2013:p0743:b004:l013","ordinal":133841,"en":"And played in wild delight."},{"id":"semetey-1-2013:p0743:b004:l014","ordinal":133842,"en":"When Manas the Swift Steed lived,"},{"id":"semetey-1-2013:p0743:b004:l015","ordinal":133843,"en":"Whole otter pelts"},{"id":"semetey-1-2013:p0743:b004:l016","ordinal":133844,"en":"We would split in half,"},{"id":"semetey-1-2013:p0743:b004:l017","ordinal":133845,"en":"And made them into trouser legs."},{"id":"semetey-1-2013:p0743:b004:l018","ordinal":133846,"en":"When Manas the Leopard lived,"},{"id":"semetey-1-2013:p0743:b004:l019","ordinal":133847,"en":"Untouched by a further spear-thrust,"},{"id":"semetey-1-2013:p0743:b004:l020","ordinal":133848,"en":"No people remained intact."},{"id":"semetey-1-2013:p0743:b004:l021","ordinal":133849,"en":"Untrodden by our noble winged steeds,"},{"id":"semetey-1-2013:p0743:b004:l022","ordinal":133850,"en":"No land remained intact."},{"id":"semetey-1-2013:p0743:b004:l023","ordinal":133851,"en":"When noble Manas lived,"},{"id":"semetey-1-2013:p0743:b004:l024","ordinal":133852,"en":"We drove white deer and made them cattle;"},{"id":"semetey-1-2013:p0743:b004:l025","ordinal":133853,"en":"We threw the enemy we fought into confusion."},{"id":"semetey-1-2013:p0743:b004:l026","ordinal":133854,"en":"Anyone who played the ruler,"},{"id":"semetey-1-2013:p0743:b004:l027","ordinal":133855,"en":"We fell upon without mercy and quarreled with."},{"id":"semetey-1-2013:p0743:b004:l028","ordinal":133856,"en":"We drove gray deer and made them cattle."},{"id":"semetey-1-2013:p0743:b004:l029","ordinal":133857,"en":"When wolf-maned Manas lived,"},{"id":"semetey-1-2013:p0743:b004:l030","ordinal":133858,"en":"We threw our chosen enemy into confusion."},{"id":"semetey-1-2013:p0743:b004:l031","ordinal":133859,"en":"If anyone grew puffed up,"},{"id":"semetey-1-2013:p0743:b004:l032","ordinal":133860,"en":"We openly worked him like softened hide."},{"id":"semetey-1-2013:p0743:b004:l033","ordinal":133861,"en":"We filled our cartridge pouches with bullets."},{"id":"semetey-1-2013:p0743:b004:l034","ordinal":133862,"en":"When Manas lived,"},{"id":"semetey-1-2013:p0743:b004:l035","ordinal":133863,"en":"We wiped out our chosen enemy."},{"id":"semetey-1-2013:p0743:b004:l036","ordinal":133864,"en":"Truly, when Manas lived,"},{"id":"semetey-1-2013:p0743:b004:l037","ordinal":133865,"en":"All you warriors were in earnest."},{"id":"semetey-1-2013:p0743:b004:l038","ordinal":133866,"en":"Here is your elder Kyrgyl."},{"id":"semetey-1-2013:p0743:b004:l039","ordinal":133867,"en":"When we blocked Chylan's road,"},{"id":"semetey-1-2013:p0744:b003:l001","ordinal":133868,"en":"Upon Beijing of Chynmachyn"},{"id":"semetey-1-2013:p0744:b003:l002","ordinal":133869,"en":"We unleashed a true upheaval."},{"id":"semetey-1-2013:p0744:b003:l003","ordinal":133870,"en":"Of the Black Kalmyk Zholoy's"},{"id":"semetey-1-2013:p0744:b003:l004","ordinal":133871,"en":"Sixty giants we killed,"},{"id":"semetey-1-2013:p0744:b003:l005","ordinal":133872,"en":"And took his tea on a thousand camels."},{"id":"semetey-1-2013:p0744:b003:l006","ordinal":133873,"en":"Together we unleashed a battle."},{"id":"semetey-1-2013:p0744:b003:l007","ordinal":133874,"en":"Before the valiant, gray-maned Manas,"},{"id":"semetey-1-2013:p0744:b003:l008","ordinal":133875,"en":"Any mortal who faced him lay prostrate,"},{"id":"semetey-1-2013:p0744:b003:l009","ordinal":133876,"en":"Those who came to face him fell."},{"id":"semetey-1-2013:p0744:b003:l010","ordinal":133877,"en":"Of that Manas's turmoil,"},{"id":"semetey-1-2013:p0744:b003:l011","ordinal":133878,"en":"When they took heed and heard,"},{"id":"semetey-1-2013:p0744:b003:l012","ordinal":133879,"en":"Of Beijing in Kakanchyn,"},{"id":"semetey-1-2013:p0744:b003:l013","ordinal":133880,"en":"Karykan wept."},{"id":"semetey-1-2013:p0744:b003:l014","ordinal":133881,"en":"You cannot equal Manas."},{"id":"semetey-1-2013:p0744:b003:l015","ordinal":133882,"en":"Take heed, good-for-nothing Kobosh!"},{"id":"semetey-1-2013:p0744:b003:l016","ordinal":133883,"en":"When I think of Manas,"},{"id":"semetey-1-2013:p0744:b003:l017","ordinal":133884,"en":"I burn and blaze like fire."},{"id":"semetey-1-2013:p0744:b003:l018","ordinal":133885,"en":"I would die, but life is sweet;"},{"id":"semetey-1-2013:p0744:b003:l019","ordinal":133886,"en":"That is why I do not die."},{"id":"semetey-1-2013:p0744:b003:l020","ordinal":133887,"en":"When Manas, our noble steed, lived,"},{"id":"semetey-1-2013:p0744:b003:l021","ordinal":133888,"en":"We broke into Ombu and took spoils."}]
