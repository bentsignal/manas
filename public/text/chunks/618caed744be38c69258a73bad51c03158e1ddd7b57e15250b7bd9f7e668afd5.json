[{"id":"semetey-1-2013:p0838:b003:l003","ordinal":141057,"en":"Of many mighty stallions,"},{"id":"semetey-1-2013:p0838:b003:l004","ordinal":141058,"en":"The saddles had slipped onto their necks;"},{"id":"semetey-1-2013:p0838:b003:l005","ordinal":141059,"en":"Many were wrenching themselves free,"},{"id":"semetey-1-2013:p0838:b003:l006","ordinal":141060,"en":"Many swift noble steeds,"},{"id":"semetey-1-2013:p0838:b003:l007","ordinal":141061,"en":"Their saddles and saddlecloths still upon them,"},{"id":"semetey-1-2013:p0838:b003:l008","ordinal":141062,"en":"Had no masters to mount and ride;"},{"id":"semetey-1-2013:p0838:b003:l009","ordinal":141063,"en":"Many were being led alongside."},{"id":"semetey-1-2013:p0838:b003:l010","ordinal":141064,"en":"“My dear, precious kinsman"},{"id":"semetey-1-2013:p0838:b003:l011","ordinal":141065,"en":"Has died in such-and-such a place,"},{"id":"semetey-1-2013:p0838:b003:l012","ordinal":141066,"en":"Has met Judgment,” they cried;"},{"id":"semetey-1-2013:p0838:b003:l013","ordinal":141067,"en":"Many went wailing."},{"id":"semetey-1-2013:p0838:b003:l014","ordinal":141068,"en":"In panic for their precious lives,"},{"id":"semetey-1-2013:p0838:b003:l015","ordinal":141069,"en":"Many had lost all hope."},{"id":"semetey-1-2013:p0838:b003:l016","ordinal":141070,"en":"Folding their arms upon their breasts,"},{"id":"semetey-1-2013:p0838:b003:l017","ordinal":141071,"en":"Many came running."},{"id":"semetey-1-2013:p0838:b003:l018","ordinal":141072,"en":"“We came because of the khan’s wrath;"},{"id":"semetey-1-2013:p0838:b003:l019","ordinal":141073,"en":"We have died unawares,” they cried;"},{"id":"semetey-1-2013:p0838:b003:l020","ordinal":141074,"en":"Many made their lament."},{"id":"semetey-1-2013:p0838:b003:l021","ordinal":141075,"en":"Taking their spears and darting about,"},{"id":"semetey-1-2013:p0838:b003:l022","ordinal":141076,"en":"Many still attacked."},{"id":"semetey-1-2013:p0838:b003:l023","ordinal":141077,"en":"“Hero, we submit as slaves!”"},{"id":"semetey-1-2013:p0838:b003:l024","ordinal":141078,"en":"Many pleaded."},{"id":"semetey-1-2013:p0838:b003:l025","ordinal":141079,"en":"A hero himself, grim of face,"},{"id":"semetey-1-2013:p0838:b003:l026","ordinal":141080,"en":"Riding a red-chestnut horse,"},{"id":"semetey-1-2013:p0838:b003:l027","ordinal":141081,"en":"Its long tail tightly knotted,"},{"id":"semetey-1-2013:p0838:b003:l028","ordinal":141082,"en":"A golden-cheeked battleaxe"},{"id":"semetey-1-2013:p0838:b003:l029","ordinal":141083,"en":"Hung from his wrist."},{"id":"semetey-1-2013:p0838:b003:l030","ordinal":141084,"en":"He looked like the angel of death;"},{"id":"semetey-1-2013:p0838:b003:l031","ordinal":141085,"en":"To see him troubled the heart."},{"id":"semetey-1-2013:p0838:b003:l032","ordinal":141086,"en":"Equipped with every kind of gear,"},{"id":"semetey-1-2013:p0838:b003:l033","ordinal":141087,"en":"Pouncing like a lion,"},{"id":"semetey-1-2013:p0838:b003:l034","ordinal":141088,"en":"Clad in mottled blue iron,"},{"id":"semetey-1-2013:p0838:b003:l035","ordinal":141089,"en":"The tip of his spear curved,"},{"id":"semetey-1-2013:p0838:b003:l036","ordinal":141090,"en":"Rough in appearance, grim of face,"},{"id":"semetey-1-2013:p0838:b003:l037","ordinal":141091,"en":"He was a great champion above the multitude."},{"id":"semetey-1-2013:p0838:b003:l038","ordinal":141092,"en":"The peoples of four khans had gathered"},{"id":"semetey-1-2013:p0838:b003:l039","ordinal":141093,"en":"And sent this one champion."},{"id":"semetey-1-2013:p0838:b004:l001","ordinal":141094,"en":"As large as a mountain,"},{"id":"semetey-1-2013:p0838:b004:l002","ordinal":141095,"en":"Fierce in strength, bitter of face,"},{"id":"semetey-1-2013:p0838:b004:l003","ordinal":141096,"en":"He seemed ready to devour whoever appeared."},{"id":"semetey-1-2013:p0838:b004:l004","ordinal":141097,"en":"The sound of his approach"},{"id":"semetey-1-2013:p0838:b004:l005","ordinal":141098,"en":"Rumbled as though the earth were splitting."},{"id":"semetey-1-2013:p0838:b004:l006","ordinal":141099,"en":"“Manas’s orphan slave,"},{"id":"semetey-1-2013:p0838:b004:l007","ordinal":141100,"en":"Even if you have seventy lives,"},{"id":"semetey-1-2013:p0838:b004:l008","ordinal":141101,"en":"Now you have died by my hand,"},{"id":"semetey-1-2013:p0838:b004:l009","ordinal":141102,"en":"Now you have met Judgment!” he cried."},{"id":"semetey-1-2013:p0838:b004:l010","ordinal":141103,"en":"He thundered in arrogant boasts;"},{"id":"semetey-1-2013:p0838:b004:l011","ordinal":141104,"en":"At the champion’s boasting,"},{"id":"semetey-1-2013:p0838:b004:l012","ordinal":141105,"en":"The earth rumbled and split."},{"id":"semetey-1-2013:p0838:b004:l013","ordinal":141106,"en":"Watching his wrath,"},{"id":"semetey-1-2013:p0838:b004:l014","ordinal":141107,"en":"Big heart flutters,"},{"id":"semetey-1-2013:p0838:b004:l015","ordinal":141108,"en":"The heart could not help trembling."},{"id":"semetey-1-2013:p0838:b004:l016","ordinal":141109,"en":"The champion of Hindustan"},{"id":"semetey-1-2013:p0838:b004:l017","ordinal":141110,"en":"Was named Orokjan."},{"id":"semetey-1-2013:p0838:b004:l018","ordinal":141111,"en":"Orokjan’s size"},{"id":"semetey-1-2013:p0838:b004:l019","ordinal":141112,"en":"Was that of a little hill."},{"id":"semetey-1-2013:p0838:b004:l020","ordinal":141113,"en":"Having fought in many lands,"},{"id":"semetey-1-2013:p0838:b004:l021","ordinal":141114,"en":"He was an experienced man."},{"id":"semetey-1-2013:p0838:b004:l022","ordinal":141115,"en":"Among spearmen he was skilled;"},{"id":"semetey-1-2013:p0838:b004:l023","ordinal":141116,"en":"He too was an accomplished master,"},{"id":"semetey-1-2013:p0838:b004:l024","ordinal":141117,"en":"Resourceful and adept."},{"id":"semetey-1-2013:p0838:b004:l025","ordinal":141118,"en":"Sparing no effort, that champion"},{"id":"semetey-1-2013:p0838:b004:l026","ordinal":141119,"en":"Cried, “Come here for single combat!”"},{"id":"semetey-1-2013:p0838:b004:l027","ordinal":141120,"en":"Kyljeerde’s head"},{"id":"semetey-1-2013:p0838:b004:l028","ordinal":141121,"en":"He turned and rode forth."},{"id":"semetey-1-2013:p0838:b004:l029","ordinal":141122,"en":"Shouting loudly, his spear"},{"id":"semetey-1-2013:p0838:b004:l030","ordinal":141123,"en":"Leveled, he came forward!"},{"id":"semetey-1-2013:p0838:b004:l031","ordinal":141124,"en":"As though an evil spirit had seized his wife,"},{"id":"semetey-1-2013:p0838:b004:l032","ordinal":141125,"en":"As though fleeing with pursuers close behind,"},{"id":"semetey-1-2013:p0838:b004:l033","ordinal":141126,"en":"As though pursuing someone close ahead,"},{"id":"semetey-1-2013:p0838:b004:l034","ordinal":141127,"en":"As though his wife had borne a son,"},{"id":"semetey-1-2013:p0838:b004:l035","ordinal":141128,"en":"He hastened in great agitation."},{"id":"semetey-1-2013:p0838:b004:l036","ordinal":141129,"en":"From the broad riverbed without a pebble,"},{"id":"semetey-1-2013:p0838:b004:l037","ordinal":141130,"en":"No signal horn sounded from the broad expanse;"},{"id":"semetey-1-2013:p0838:b004:l038","ordinal":141131,"en":"No foe would escape his spear."},{"id":"semetey-1-2013:p0838:b004:l039","ordinal":141132,"en":"Your sultan, Manas’s son—"},{"id":"semetey-1-2013:p0839:b003:l001","ordinal":141133,"en":"When Orokjan had just arrived,"},{"id":"semetey-1-2013:p0839:b003:l002","ordinal":141134,"en":"He turned Buurul’s head,"},{"id":"semetey-1-2013:p0839:b003:l003","ordinal":141135,"en":"Without fretting over brow or eyebrow,"},{"id":"semetey-1-2013:p0839:b003:l004","ordinal":141136,"en":"And stood watching somberly."},{"id":"semetey-1-2013:p0839:b003:l005","ordinal":141137,"en":"“Let the champion take his turn;"},{"id":"semetey-1-2013:p0839:b003:l006","ordinal":141138,"en":"Let him have no regrets."},{"id":"semetey-1-2013:p0839:b003:l007","ordinal":141139,"en":"If this champion has the strength,"},{"id":"semetey-1-2013:p0839:b003:l008","ordinal":141140,"en":"Let him slaughter me before a boar;"},{"id":"semetey-1-2013:p0839:b003:l009","ordinal":141141,"en":"Let him be angry at Kapkai."},{"id":"semetey-1-2013:p0839:b003:l010","ordinal":141142,"en":"Semetey held his ground."},{"id":"semetey-1-2013:p0839:b003:l011","ordinal":141143,"en":"When Orok charged and thrust,"},{"id":"semetey-1-2013:p0839:b003:l012","ordinal":141144,"en":"“My brow! My eyebrow!”—"},{"id":"semetey-1-2013:p0839:b003:l013","ordinal":141145,"en":"Semetey did not recoil."},{"id":"semetey-1-2013:p0839:b003:l014","ordinal":141146,"en":"Beyond his fierce father Manas,"},{"id":"semetey-1-2013:p0839:b003:l015","ordinal":141147,"en":"He was a hero born greater still."},{"id":"semetey-1-2013:p0839:b003:l016","ordinal":141148,"en":"The painted spear with its thickened iron head"},{"id":"semetey-1-2013:p0839:b003:l017","ordinal":141149,"en":"He grasped it ready in his hand."},{"id":"semetey-1-2013:p0839:b003:l018","ordinal":141150,"en":"Your hero bent and hunched his back,"},{"id":"semetey-1-2013:p0839:b003:l019","ordinal":141151,"en":"His eyes bulged,"},{"id":"semetey-1-2013:p0839:b003:l020","ordinal":141152,"en":"His ribs stood out."},{"id":"semetey-1-2013:p0839:b003:l021","ordinal":141153,"en":"Without looking around him,"},{"id":"semetey-1-2013:p0839:b003:l022","ordinal":141154,"en":"Your orphan, son of the ocean,"},{"id":"semetey-1-2013:p0839:b003:l023","ordinal":141155,"en":"Spared not his own life."},{"id":"semetey-1-2013:p0839:b003:l024","ordinal":141156,"en":"When the boy leveled his spear,"},{"id":"semetey-1-2013:p0839:b003:l025","ordinal":141157,"en":"Orokjan stood before him."},{"id":"semetey-1-2013:p0839:b003:l026","ordinal":141158,"en":"Manas’s son reached him;"},{"id":"semetey-1-2013:p0839:b003:l027","ordinal":141159,"en":"From Kyljeerde’s back,"},{"id":"semetey-1-2013:p0839:b003:l028","ordinal":141160,"en":"The moment he reached Orok,"},{"id":"semetey-1-2013:p0839:b003:l029","ordinal":141161,"en":"He pitched him down as he passed."},{"id":"semetey-1-2013:p0839:b003:l030","ordinal":141162,"en":"Zulpukor, left by his father Manas—"},{"id":"semetey-1-2013:p0839:b003:l031","ordinal":141163,"en":"Grasping it by the hilt,"},{"id":"semetey-1-2013:p0839:b003:l032","ordinal":141164,"en":"Drawing it from its sheath,"},{"id":"semetey-1-2013:p0839:b003:l033","ordinal":141165,"en":"He cut off Orok’s head."},{"id":"semetey-1-2013:p0839:b003:l034","ordinal":141166,"en":"Of all the thousand champions,"},{"id":"semetey-1-2013:p0839:b003:l035","ordinal":141167,"en":"Those remaining alive—"},{"id":"semetey-1-2013:p0839:b003:l036","ordinal":141168,"en":"Their own possessions across the field"},{"id":"semetey-1-2013:p0839:b003:l037","ordinal":141169,"en":"Many scattered and abandoned."},{"id":"semetey-1-2013:p0839:b003:l038","ordinal":141170,"en":"Each in whatever direction he faced,"},{"id":"semetey-1-2013:p0839:b003:l039","ordinal":141171,"en":"Many fled away."},{"id":"semetey-1-2013:p0839:b004:l001","ordinal":141172,"en":"Their uproar scattered like dust;"},{"id":"semetey-1-2013:p0839:b004:l002","ordinal":141173,"en":"All the champions went singly,"},{"id":"semetey-1-2013:p0839:b004:l003","ordinal":141174,"en":"Unable to regain their composure,"},{"id":"semetey-1-2013:p0839:b004:l004","ordinal":141175,"en":"Struggling for their lives,"},{"id":"semetey-1-2013:p0839:b004:l005","ordinal":141176,"en":"The champions wandered one by one."},{"id":"semetey-1-2013:p0839:b004:l006","ordinal":141177,"en":"Fleeing in distress, the champions"},{"id":"semetey-1-2013:p0839:b004:l007","ordinal":141178,"en":"Before the kushbegi"},{"id":"semetey-1-2013:p0839:b004:l008","ordinal":141179,"en":"Ran in agitation."},{"id":"semetey-1-2013:p0839:b004:l009","ordinal":141180,"en":"All the champions who arrived"},{"id":"semetey-1-2013:p0839:b004:l010","ordinal":141181,"en":"Maligned him to the kushbegi:"},{"id":"semetey-1-2013:p0839:b004:l011","ordinal":141182,"en":"“He is no ordinary orphan boy."},{"id":"semetey-1-2013:p0839:b004:l012","ordinal":141183,"en":"All eighteen thousand worlds—"},{"id":"semetey-1-2013:p0839:b004:l013","ordinal":141184,"en":"He would give them no peace."},{"id":"semetey-1-2013:p0839:b004:l014","ordinal":141185,"en":"The imposing wolf has died;"},{"id":"semetey-1-2013:p0839:b004:l015","ordinal":141186,"en":"Many who faced him have died."},{"id":"semetey-1-2013:p0839:b004:l016","ordinal":141187,"en":"Khans Janaaly and Karach have died;"},{"id":"semetey-1-2013:p0839:b004:l017","ordinal":141188,"en":"Champion Orokjan has died too."},{"id":"semetey-1-2013:p0839:b004:l018","ordinal":141189,"en":"Manas’s orphan son"},{"id":"semetey-1-2013:p0839:b004:l019","ordinal":141190,"en":"Has Buurul beneath him."},{"id":"semetey-1-2013:p0839:b004:l020","ordinal":141191,"en":"Not merely us, the peoples of four khans—"},{"id":"semetey-1-2013:p0839:b004:l021","ordinal":141192,"en":"Upon all eighteen thousand worlds"},{"id":"semetey-1-2013:p0839:b004:l022","ordinal":141193,"en":"He has the strength to wreak slaughter."},{"id":"semetey-1-2013:p0839:b004:l023","ordinal":141194,"en":"Broad-chested, with a mighty breast,"},{"id":"semetey-1-2013:p0839:b004:l024","ordinal":141195,"en":"He is a son worthy of a hero."},{"id":"semetey-1-2013:p0839:b004:l025","ordinal":141196,"en":"Beyond his fierce father Manas,"},{"id":"semetey-1-2013:p0839:b004:l026","ordinal":141197,"en":"He is born a greater terror."},{"id":"semetey-1-2013:p0839:b004:l027","ordinal":141198,"en":"Whoever grapples with him will not prosper;"},{"id":"semetey-1-2013:p0839:b004:l028","ordinal":141199,"en":"Whoever clashes with him will not remain unharmed."},{"id":"semetey-1-2013:p0839:b004:l029","ordinal":141200,"en":"We have seen the boy’s terror;"},{"id":"semetey-1-2013:p0839:b004:l030","ordinal":141201,"en":"We have stepped upon"},{"id":"semetey-1-2013:p0839:b004:l031","ordinal":141202,"en":"A dragon’s tail."},{"id":"semetey-1-2013:p0839:b004:l032","ordinal":141203,"en":"We have taken fright at the boy."},{"id":"semetey-1-2013:p0839:b004:l033","ordinal":141204,"en":"His renown is great, his face is grim,"},{"id":"semetey-1-2013:p0839:b004:l034","ordinal":141205,"en":"Fierce and resolute as a lion,"},{"id":"semetey-1-2013:p0839:b004:l035","ordinal":141206,"en":"No man can go to match him;"},{"id":"semetey-1-2013:p0839:b004:l036","ordinal":141207,"en":"None who challenges him can remain alive."},{"id":"semetey-1-2013:p0839:b004:l037","ordinal":141208,"en":"He merely played a little;"},{"id":"semetey-1-2013:p0839:b004:l038","ordinal":141209,"en":"Thirty champions died together."},{"id":"semetey-1-2013:p0839:b004:l039","ordinal":141210,"en":"These eyes, may they be gouged out, saw it."},{"id":"semetey-1-2013:p0840:b003:l001","ordinal":141211,"en":"Those whose death had come were caught;"},{"id":"semetey-1-2013:p0840:b003:l002","ordinal":141212,"en":"All whose death had not come"},{"id":"semetey-1-2013:p0840:b003:l003","ordinal":141213,"en":"Barely escaped by fleeing."},{"id":"semetey-1-2013:p0840:b003:l004","ordinal":141214,"en":"If you keep contending with him, this orphan"},{"id":"semetey-1-2013:p0840:b003:l005","ordinal":141215,"en":"Will plunder the fine cloth;"},{"id":"semetey-1-2013:p0840:b003:l006","ordinal":141216,"en":"Will he not cause terrible havoc?"},{"id":"semetey-1-2013:p0840:b003:l007","ordinal":141217,"en":"Destroying you,"},{"id":"semetey-1-2013:p0840:b003:l008","ordinal":141218,"en":"Slaughtering us,"},{"id":"semetey-1-2013:p0840:b003:l009","ordinal":141219,"en":"With thimble mouths and camel-calf eyes,"},{"id":"semetey-1-2013:p0840:b003:l010","ordinal":141220,"en":"With roving dark eyes,"},{"id":"semetey-1-2013:p0840:b003:l011","ordinal":141221,"en":"‘He will take the girls as plunder,’ we thought;"},{"id":"semetey-1-2013:p0840:b003:l012","ordinal":141222,"en":"We greatly feared this being."},{"id":"semetey-1-2013:p0840:b003:l013","ordinal":141223,"en":"A thousand champions, as though we would not spare him,"},{"id":"semetey-1-2013:p0840:b003:l014","ordinal":141224,"en":"We thrust our spears and joined battle,"},{"id":"semetey-1-2013:p0840:b003:l015","ordinal":141225,"en":"And fell needlessly into torment."},{"id":"semetey-1-2013:p0840:b003:l016","ordinal":141226,"en":"He could humiliate the khojas,"},{"id":"semetey-1-2013:p0840:b003:l017","ordinal":141227,"en":"Drive off and slaughter the mullahs."},{"id":"semetey-1-2013:p0840:b003:l018","ordinal":141228,"en":"If you keep contending, this orphan"},{"id":"semetey-1-2013:p0840:b003:l019","ordinal":141229,"en":"Will bring us to our end,"},{"id":"semetey-1-2013:p0840:b003:l020","ordinal":141230,"en":"Will slaughter us entirely.”"},{"id":"semetey-1-2013:p0840:b003:l021","ordinal":141231,"en":"Hearing the champions, Kozubek—"},{"id":"semetey-1-2013:p0840:b003:l022","ordinal":141232,"en":"This khan lost his composure."},{"id":"semetey-1-2013:p0840:b003:l023","ordinal":141233,"en":"Never satisfied with begging and consuming,"},{"id":"semetey-1-2013:p0840:b003:l024","ordinal":141234,"en":"Never abandoning his greed,"},{"id":"semetey-1-2013:p0840:b003:l025","ordinal":141235,"en":"“That bastard of Kyrgyz stock"},{"id":"semetey-1-2013:p0840:b003:l026","ordinal":141236,"en":"Will bring calamity,” he thought."},{"id":"semetey-1-2013:p0840:b003:l027","ordinal":141237,"en":"“The peoples of four khans, every one,"},{"id":"semetey-1-2013:p0840:b003:l028","ordinal":141238,"en":"He will slaughter today,” he thought."},{"id":"semetey-1-2013:p0840:b003:l029","ordinal":141239,"en":"“If this orphan continues thus,"},{"id":"semetey-1-2013:p0840:b003:l030","ordinal":141240,"en":"In Kapkay, they will be angry."},{"id":"semetey-1-2013:p0840:b003:l031","ordinal":141241,"en":"Their wide robes flapping,"},{"id":"semetey-1-2013:p0840:b003:l032","ordinal":141242,"en":"All of the right horses"},{"id":"semetey-1-2013:p0840:b003:l033","ordinal":141243,"en":"Their breasts bared,"},{"id":"semetey-1-2013:p0840:b003:l034","ordinal":141244,"en":"In terrible haste,"},{"id":"semetey-1-2013:p0840:b003:l035","ordinal":141245,"en":"They fled awkwardly to the palace,"},{"id":"semetey-1-2013:p0840:b003:l036","ordinal":141246,"en":"Their hearts troubled,"},{"id":"semetey-1-2013:p0840:b003:l037","ordinal":141247,"en":"Their chests exposed,"},{"id":"semetey-1-2013:p0840:b003:l038","ordinal":141248,"en":"Their noses flaring,"},{"id":"semetey-1-2013:p0840:b003:l039","ordinal":141249,"en":"Fleeing in frantic haste."},{"id":"semetey-1-2013:p0840:b004:l001","ordinal":141250,"en":"Scolding their sentries,"},{"id":"semetey-1-2013:p0840:b004:l002","ordinal":141251,"en":"Bolting their doors,"},{"id":"semetey-1-2013:p0840:b004:l003","ordinal":141252,"en":"They fled into the palace;"},{"id":"semetey-1-2013:p0840:b004:l004","ordinal":141253,"en":"Kokand shut itself within the palace."},{"id":"semetey-1-2013:p0840:b004:l005","ordinal":141254,"en":"Driving the champions, shouting,"},{"id":"semetey-1-2013:p0840:b004:l006","ordinal":141255,"en":"Those left alive"},{"id":"semetey-1-2013:p0840:b004:l007","ordinal":141256,"en":"Semetey came pursuing,"},{"id":"semetey-1-2013:p0840:b004:l008","ordinal":141257,"en":"Sweeping them toward Kokand."},{"id":"semetey-1-2013:p0840:b004:l009","ordinal":141258,"en":"Sary Khan, with eyes like little bowls,"},{"id":"semetey-1-2013:p0840:b004:l010","ordinal":141259,"en":"Took the road and sped forward,"},{"id":"semetey-1-2013:p0840:b004:l011","ordinal":141260,"en":"Shouting “Semetey!”"},{"id":"semetey-1-2013:p0840:b004:l012","ordinal":141261,"en":"Urging his horse, he reached him."},{"id":"semetey-1-2013:p0840:b004:l013","ordinal":141262,"en":"Sary Khan came up,"},{"id":"semetey-1-2013:p0840:b004:l014","ordinal":141263,"en":"Took hold of the bit,"},{"id":"semetey-1-2013:p0840:b004:l015","ordinal":141264,"en":"And spoke words of wisdom:"},{"id":"semetey-1-2013:p0840:b004:l016","ordinal":141265,"en":"“My spring before me,"},{"id":"semetey-1-2013:p0840:b004:l017","ordinal":141266,"en":"My lamp upon which I rely!"},{"id":"semetey-1-2013:p0840:b004:l018","ordinal":141267,"en":"Your father Manas, that surpassing lion,"},{"id":"semetey-1-2013:p0840:b004:l019","ordinal":141268,"en":"Your falcon who has died—"},{"id":"semetey-1-2013:p0840:b004:l020","ordinal":141269,"en":"When Muslims insulted him,"},{"id":"semetey-1-2013:p0840:b004:l021","ordinal":141270,"en":"He would not rise in anger or heed it."},{"id":"semetey-1-2013:p0840:b004:l022","ordinal":141271,"en":"His gold by the pood, his gold coins—"},{"id":"semetey-1-2013:p0840:b004:l023","ordinal":141272,"en":"Even if Muslims burned them,"},{"id":"semetey-1-2013:p0840:b004:l024","ordinal":141273,"en":"He would not regard it as worth a hair!"},{"id":"semetey-1-2013:p0840:b004:l025","ordinal":141274,"en":"Even if they humiliated him like a sheep,"},{"id":"semetey-1-2013:p0840:b004:l026","ordinal":141275,"en":"He would pay the Muslims no heed!"},{"id":"semetey-1-2013:p0840:b004:l027","ordinal":141276,"en":"Are not their khans fools?"},{"id":"semetey-1-2013:p0840:b004:l028","ordinal":141277,"en":"My darling orphan,"},{"id":"semetey-1-2013:p0840:b004:l029","ordinal":141278,"en":"What guilt have the many people?"},{"id":"semetey-1-2013:p0840:b004:l030","ordinal":141279,"en":"Is not their leader a swine?"},{"id":"semetey-1-2013:p0840:b004:l031","ordinal":141280,"en":"What guilt have the other people?"},{"id":"semetey-1-2013:p0840:b004:l032","ordinal":141281,"en":"Be patient, orphan, be patient!"},{"id":"semetey-1-2013:p0840:b004:l033","ordinal":141282,"en":"In the end, one day we shall die."},{"id":"semetey-1-2013:p0840:b004:l034","ordinal":141283,"en":"If we kill innocent people,"},{"id":"semetey-1-2013:p0840:b004:l035","ordinal":141284,"en":"On the coming Day of Resurrection,"},{"id":"semetey-1-2013:p0840:b004:l036","ordinal":141285,"en":"How shall we answer for their blood?"},{"id":"semetey-1-2013:p0840:b004:l037","ordinal":141286,"en":"If you contend with Khan Kokand,"},{"id":"semetey-1-2013:p0840:b004:l038","ordinal":141287,"en":"What desire will you fulfill?"},{"id":"semetey-1-2013:p0840:b004:l039","ordinal":141288,"en":"Will you slaughter its people?"},{"id":"semetey-1-2013:p0841:b003:l001","ordinal":141289,"en":"When you make your people wretched,"},{"id":"semetey-1-2013:p0841:b003:l002","ordinal":141290,"en":"When you slaughter Kokand’s people,"},{"id":"semetey-1-2013:p0841:b003:l003","ordinal":141291,"en":"When you bring them all to their end,"},{"id":"semetey-1-2013:p0841:b003:l004","ordinal":141292,"en":"Persisting in your stubbornness,"},{"id":"semetey-1-2013:p0841:b003:l005","ordinal":141293,"en":"When you slaughter this people,"},{"id":"semetey-1-2013:p0841:b003:l006","ordinal":141294,"en":"We shall be deeply steeped in their blood."},{"id":"semetey-1-2013:p0841:b003:l007","ordinal":141295,"en":"On the coming Day of Resurrection,"},{"id":"semetey-1-2013:p0841:b003:l008","ordinal":141296,"en":"We shall become black donkeys."},{"id":"semetey-1-2013:p0841:b003:l009","ordinal":141297,"en":"If what is told is true,"},{"id":"semetey-1-2013:p0841:b003:l010","ordinal":141298,"en":"On Judgment’s narrow path,"},{"id":"semetey-1-2013:p0841:b003:l011","ordinal":141299,"en":"Don't you know ignorance?"},{"id":"semetey-1-2013:p0841:b003:l012","ordinal":141300,"en":"‘He slaughtered the innocent,’ they will say;"},{"id":"semetey-1-2013:p0841:b003:l013","ordinal":141301,"en":"Will they not come demanding justice for their blood?”"},{"id":"semetey-1-2013:p0841:b003:l014","ordinal":141302,"en":"Your uncle Sary, with eyes like little bowls,"},{"id":"semetey-1-2013:p0841:b003:l015","ordinal":141303,"en":"Teaching him what he did not know,"},{"id":"semetey-1-2013:p0841:b003:l016","ordinal":141304,"en":"Thus bringing him to heed,"},{"id":"semetey-1-2013:p0841:b003:l017","ordinal":141305,"en":"The orphan son of Manas,"},{"id":"semetey-1-2013:p0841:b003:l018","ordinal":141306,"en":"Taking the lead rope, led him,"},{"id":"semetey-1-2013:p0841:b003:l019","ordinal":141307,"en":"Cutting across to a narrow road."},{"id":"semetey-1-2013:p0841:b003:l020","ordinal":141308,"en":"Teaching him what he did not know,"},{"id":"semetey-1-2013:p0841:b003:l021","ordinal":141309,"en":"Thus setting him upon the road,"},{"id":"semetey-1-2013:p0841:b003:l022","ordinal":141310,"en":"He took the orphan away."},{"id":"semetey-1-2013:p0841:b003:l023","ordinal":141311,"en":"Having made a spectacle upon the road,"},{"id":"semetey-1-2013:p0841:b003:l024","ordinal":141312,"en":"Having wrought havoc in Kokand,"}]
