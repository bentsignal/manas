[{"id":"seytek-2012:p0026:b003:l036","ordinal":297217,"en":"Who else could know that she had gone?"},{"id":"seytek-2012:p0026:b003:l037","ordinal":297218,"en":"When she unleashed her powers fully,"},{"id":"seytek-2012:p0026:b003:l038","ordinal":297219,"en":"She turned a summer day to winter"},{"id":"seytek-2012:p0026:b003:l039","ordinal":297220,"en":"And froze every summer pasture."},{"id":"seytek-2012:p0026:b003:l040","ordinal":297221,"en":"When the distraught woman gathered her strength,"},{"id":"seytek-2012:p0026:b002:l001","ordinal":297222,"en":"Mist rises from the ravine;"},{"id":"seytek-2012:p0026:b002:l002","ordinal":297223,"en":"When misfortune is truly driven to fury,"},{"id":"seytek-2012:p0026:b002:l003","ordinal":297224,"en":"It finds a thousand true devices."},{"id":"seytek-2012:p0026:b002:l004","ordinal":297225,"en":"She reads Arabic spells and blinds the eyes,"},{"id":"seytek-2012:p0026:b002:l005","ordinal":297226,"en":"Turns into a white swan and alters the weather."},{"id":"seytek-2012:p0026:b002:l006","ordinal":297227,"en":"Do not call Chürök ordinary,"},{"id":"seytek-2012:p0026:b002:l007","ordinal":297228,"en":"With all her wondrous powers;"},{"id":"seytek-2012:p0026:b002:l008","ordinal":297229,"en":"Do not think Chürök insignificant,"},{"id":"seytek-2012:p0026:b002:l009","ordinal":297230,"en":"So extraordinary is her nature."},{"id":"seytek-2012:p0026:b002:l010","ordinal":297231,"en":"The beauty of that unfortunate woman,"},{"id":"seytek-2012:p0026:b002:l011","ordinal":297232,"en":"Her lovely form, was found in no mortal,"},{"id":"seytek-2012:p0026:b002:l012","ordinal":297233,"en":"Nor was the precious grace of her heart."},{"id":"seytek-2012:p0026:b002:l013","ordinal":297234,"en":"By day she pleased Kyyaz,"},{"id":"seytek-2012:p0026:b002:l014","ordinal":297235,"en":"Delighting and beguiling his soul;"},{"id":"seytek-2012:p0026:b002:l015","ordinal":297236,"en":"When night fell, she deceived Kyyaz"},{"id":"seytek-2012:p0026:b002:l016","ordinal":297237,"en":"By casting a spell upon his eyes."},{"id":"seytek-2012:p0026:b002:l017","ordinal":297238,"en":"Thus not the slightest suspicion"},{"id":"seytek-2012:p0026:b002:l018","ordinal":297239,"en":"Remained in Kyyaz’s mind."},{"id":"seytek-2012:p0026:b002:l019","ordinal":297240,"en":"The renowned Aichürök"},{"id":"seytek-2012:p0026:b002:l020","ordinal":297241,"en":"Stayed beside Kyyaz, son of Bagysh,"},{"id":"seytek-2012:p0026:b002:l021","ordinal":297242,"en":"Flirting with him"},{"id":"seytek-2012:p0026:b002:l022","ordinal":297243,"en":"Throughout the day."},{"id":"seytek-2012:p0026:b002:l023","ordinal":297244,"en":"At night she blinded"},{"id":"seytek-2012:p0026:b002:l024","ordinal":297245,"en":"The hero Kyyaz’s eyes"},{"id":"seytek-2012:p0026:b002:l025","ordinal":297246,"en":"And deceived him."},{"id":"seytek-2012:p0026:b002:l026","ordinal":297247,"en":"She would lie with her back turned to him,"},{"id":"seytek-2012:p0026:b002:l027","ordinal":297248,"en":"And every day, disguising"},{"id":"seytek-2012:p0026:b002:l028","ordinal":297249,"en":"One of the attendants herself,"},{"id":"seytek-2012:p0026:b002:l029","ordinal":297250,"en":"She would give Kyyaz"},{"id":"seytek-2012:p0026:b002:l030","ordinal":297251,"en":"One of the young women beside her."},{"id":"seytek-2012:p0026:b002:l031","ordinal":297252,"en":"A rivered spring beneath a sheer cliff—"},{"id":"seytek-2012:p0026:b002:l032","ordinal":297253,"en":"Will it yield its heart when it dies,"},{"id":"seytek-2012:p0026:b002:l033","ordinal":297254,"en":"Such a wretched creature as that?"},{"id":"seytek-2012:p0026:b002:l034","ordinal":297255,"en":"The days waned and the months passed;"},{"id":"seytek-2012:p0026:b002:l035","ordinal":297256,"en":"Since brave Kyyaz had taken Chürök,"},{"id":"seytek-2012:p0026:b002:l036","ordinal":297257,"en":"Nine months were completed,"},{"id":"seytek-2012:p0026:b002:l037","ordinal":297258,"en":"And nearly ten months had passed."},{"id":"seytek-2012:p0026:b002:l038","ordinal":297259,"en":"Her womb grew ripe and her term was full,"},{"id":"seytek-2012:p0026:b002:l039","ordinal":297260,"en":"The appointed time and day arrived."},{"id":"seytek-2012:p0026:b002:l040","ordinal":297261,"en":"Beside moonlike Chürök"},{"id":"seytek-2012:p0027:b003:l001","ordinal":297262,"en":"Thus her labor came upon her."},{"id":"seytek-2012:p0027:b003:l002","ordinal":297263,"en":"On the sacred night of Friday,"},{"id":"seytek-2012:p0027:b003:l003","ordinal":297264,"en":"During the day of Thursday,"},{"id":"seytek-2012:p0027:b003:l004","ordinal":297265,"en":"Full labor came"},{"id":"seytek-2012:p0027:b003:l005","ordinal":297266,"en":"Upon moonlike Chürök,"},{"id":"seytek-2012:p0027:b003:l006","ordinal":297267,"en":"The wise and wondrous woman."},{"id":"seytek-2012:p0027:b003:l007","ordinal":297268,"en":"Her spirits failed and her flesh ached;"},{"id":"seytek-2012:p0027:b003:l008","ordinal":297269,"en":"Labor came upon Chürök."},{"id":"seytek-2012:p0027:b003:l009","ordinal":297270,"en":"Blood came as the sign of the child;"},{"id":"seytek-2012:p0027:b003:l010","ordinal":297271,"en":"Seeing the sign, she cried aloud,"},{"id":"seytek-2012:p0027:b003:l011","ordinal":297272,"en":"And Aichürök’s strength deserted her."},{"id":"seytek-2012:p0027:b003:l012","ordinal":297273,"en":"Her back throbbed with terrible pain;"},{"id":"seytek-2012:p0027:b003:l013","ordinal":297274,"en":"All her sixty joints and forty-one bones"},{"id":"seytek-2012:p0027:b003:l014","ordinal":297275,"en":"Ached without a single exception."},{"id":"seytek-2012:p0027:b003:l015","ordinal":297276,"en":"Whenever Chürök sat down,"},{"id":"seytek-2012:p0027:b003:l016","ordinal":297277,"en":"Both her dark thighs hurt;"},{"id":"seytek-2012:p0027:b003:l017","ordinal":297278,"en":"The poor woman’s bladder also ached,"},{"id":"seytek-2012:p0027:b003:l018","ordinal":297279,"en":"Leaving her unable to move."},{"id":"seytek-2012:p0027:b003:l019","ordinal":297280,"en":"Her whole body hurt,"},{"id":"seytek-2012:p0027:b003:l020","ordinal":297281,"en":"Her most intimate parts were in pain;"},{"id":"seytek-2012:p0027:b003:l021","ordinal":297282,"en":"Her labor became a terrible affliction."},{"id":"seytek-2012:p0027:b003:l022","ordinal":297283,"en":"She screamed and cried aloud,"},{"id":"seytek-2012:p0027:b003:l023","ordinal":297284,"en":"Sobbing because she could not endure it."},{"id":"seytek-2012:p0027:b003:l024","ordinal":297285,"en":"Her ribs seemed to split apart"},{"id":"seytek-2012:p0027:b003:l025","ordinal":297286,"en":"And tears poured from her eyes;"},{"id":"seytek-2012:p0027:b003:l026","ordinal":297287,"en":"Cruel, accursed death"},{"id":"seytek-2012:p0027:b003:l027","ordinal":297288,"en":"Seemed close before her eyes."},{"id":"seytek-2012:p0027:b003:l028","ordinal":297289,"en":"Sobbing, the woman Aichürök"},{"id":"seytek-2012:p0027:b003:l029","ordinal":297290,"en":"Spent her frail, fly-like life,"},{"id":"seytek-2012:p0027:b003:l030","ordinal":297291,"en":"Screaming and crying aloud:"},{"id":"seytek-2012:p0027:b003:l031","ordinal":297292,"en":"“Show me the brave boy left by my khan,"},{"id":"seytek-2012:p0027:b003:l032","ordinal":297293,"en":"The heir left by the bloodthirsty hero,"},{"id":"seytek-2012:p0027:b003:l033","ordinal":297294,"en":"The banner fastened to the spear,"},{"id":"seytek-2012:p0027:b003:l034","ordinal":297295,"en":"The gift bestowed by the betrothed,"},{"id":"seytek-2012:p0027:b003:l035","ordinal":297296,"en":"The hoofprint left by the noble steed,"},{"id":"seytek-2012:p0027:b003:l036","ordinal":297297,"en":"The brave boy left by the falcon—"},{"id":"seytek-2012:p0027:b003:l037","ordinal":297298,"en":"O God, show him to me unharmed!"},{"id":"seytek-2012:p0027:b003:l038","ordinal":297299,"en":"Make this grievous pain subside,"},{"id":"seytek-2012:p0027:b003:l039","ordinal":297300,"en":"Brighten this mirror-like face!”"},{"id":"seytek-2012:p0027:b003:l040","ordinal":297301,"en":"Her spirit was sorrow and her heart was pain;"},{"id":"seytek-2012:p0027:b002:l001","ordinal":297302,"en":"“Let this burning anguish subside,” she prayed,"},{"id":"seytek-2012:p0027:b002:l002","ordinal":297303,"en":"Seeking a remedy from Allah,"},{"id":"seytek-2012:p0027:b002:l003","ordinal":297304,"en":"The unfortunate woman beseeching God"},{"id":"seytek-2012:p0027:b002:l004","ordinal":297305,"en":"For the child within her womb."},{"id":"seytek-2012:p0027:b002:l005","ordinal":297306,"en":"“Grant him to me,” she pleaded;"},{"id":"seytek-2012:p0027:b002:l006","ordinal":297307,"en":"“What will he endure"},{"id":"seytek-2012:p0027:b002:l007","ordinal":297308,"en":"Among bitter enemies?"},{"id":"seytek-2012:p0027:b002:l008","ordinal":297309,"en":"If my appointed days end and death comes,"},{"id":"seytek-2012:p0027:b002:l009","ordinal":297310,"en":"What will become of him when I die?"},{"id":"seytek-2012:p0027:b002:l010","ordinal":297311,"en":"How shall I ever see"},{"id":"seytek-2012:p0027:b002:l011","ordinal":297312,"en":"The renowned young gray wolf,"},{"id":"seytek-2012:p0027:b002:l012","ordinal":297313,"en":"Born of my blood and dark eyes,"},{"id":"seytek-2012:p0027:b002:l013","ordinal":297314,"en":"The brave boy I have longed for,"},{"id":"seytek-2012:p0027:b002:l014","ordinal":297315,"en":"The hero destined before me?"},{"id":"seytek-2012:p0027:b002:l015","ordinal":297316,"en":"Alas, countless worries have torn apart my mind"},{"id":"seytek-2012:p0027:b002:l016","ordinal":297317,"en":"For the child sprung from my loins."},{"id":"seytek-2012:p0027:b002:l017","ordinal":297318,"en":"Without letting the enemy suspect,"},{"id":"seytek-2012:p0027:b002:l018","ordinal":297319,"en":"Can I entrust him to someone’s care?"},{"id":"seytek-2012:p0027:b002:l019","ordinal":297320,"en":"If they use force without warning,"},{"id":"seytek-2012:p0027:b002:l020","ordinal":297321,"en":"If they suddenly commit violence,"},{"id":"seytek-2012:p0027:b002:l021","ordinal":297322,"en":"Will they fear the watching eye?"},{"id":"seytek-2012:p0027:b002:l022","ordinal":297323,"en":"Will they act as enemies"},{"id":"seytek-2012:p0027:b002:l023","ordinal":297324,"en":"To the brave boy left by the lion?"},{"id":"seytek-2012:p0027:b002:l024","ordinal":297325,"en":"Will they kill him without delay,"},{"id":"seytek-2012:p0027:b002:l025","ordinal":297326,"en":"Before he reaches maturity?”"},{"id":"seytek-2012:p0027:b002:l026","ordinal":297327,"en":"Countless cares would not fit within her breast,"},{"id":"seytek-2012:p0027:b002:l027","ordinal":297328,"en":"Her tears streamed in a thousand rivulets;"},{"id":"seytek-2012:p0027:b002:l028","ordinal":297329,"en":"The poor woman wept all the more."},{"id":"seytek-2012:p0027:b002:l029","ordinal":297330,"en":"The reason she wept"},{"id":"seytek-2012:p0027:b002:l030","ordinal":297331,"en":"Was that she had been taken as spoil;"},{"id":"seytek-2012:p0027:b002:l031","ordinal":297332,"en":"The unfortunate woman wept in sorrow"},{"id":"seytek-2012:p0027:b002:l032","ordinal":297333,"en":"Because she had been given an evil name."},{"id":"seytek-2012:p0027:b002:l033","ordinal":297334,"en":"The reason she wept was this:"},{"id":"seytek-2012:p0027:b002:l034","ordinal":297335,"en":"She had no strong protector,"},{"id":"seytek-2012:p0027:b002:l035","ordinal":297336,"en":"No secure place to shelter,"},{"id":"seytek-2012:p0027:b002:l036","ordinal":297337,"en":"No forest into which she could flee,"},{"id":"seytek-2012:p0027:b002:l037","ordinal":297338,"en":"No Nogoy people to defend her;"},{"id":"seytek-2012:p0027:b002:l038","ordinal":297339,"en":"Her misery was beyond measure."},{"id":"seytek-2012:p0027:b002:l039","ordinal":297340,"en":"She had no renowned Kyrgyz people,"},{"id":"seytek-2012:p0027:b002:l040","ordinal":297341,"en":"Mighty as mountains, to be her hope."},{"id":"seytek-2012:p0028:b003:l001","ordinal":297342,"en":"Her many thoughts unraveled,"},{"id":"seytek-2012:p0028:b003:l002","ordinal":297343,"en":"Her bewildered mind broke apart;"},{"id":"seytek-2012:p0028:b003:l003","ordinal":297344,"en":"The dark earth, sealed below,"},{"id":"seytek-2012:p0028:b003:l004","ordinal":297345,"en":"Seemed ready to take her"},{"id":"seytek-2012:p0028:b003:l005","ordinal":297346,"en":"If her head survived this ordeal."},{"id":"seytek-2012:p0028:b003:l006","ordinal":297347,"en":"From the distraught poor woman’s"},{"id":"seytek-2012:p0028:b003:l007","ordinal":297348,"en":"Quail-like eyes,"},{"id":"seytek-2012:p0028:b003:l008","ordinal":297349,"en":"Tears fell one after another;"},{"id":"seytek-2012:p0028:b003:l009","ordinal":297350,"en":"From her currant-dark eyes,"},{"id":"seytek-2012:p0028:b003:l010","ordinal":297351,"en":"As the wretched woman trembled,"},{"id":"seytek-2012:p0028:b003:l011","ordinal":297352,"en":"Tears fell a whip’s length."},{"id":"seytek-2012:p0028:b003:l012","ordinal":297353,"en":"Unable to gather and steady her thoughts,"},{"id":"seytek-2012:p0028:b003:l013","ordinal":297354,"en":"She wept in anguish from her sorrow"},{"id":"seytek-2012:p0028:b003:l014","ordinal":297355,"en":"And could not even draw back the mucus from her nose."},{"id":"seytek-2012:p0028:b003:l015","ordinal":297356,"en":"As the distraught woman lamented,"},{"id":"seytek-2012:p0028:b003:l016","ordinal":297357,"en":"Her joints loosened and came apart;"},{"id":"seytek-2012:p0028:b003:l017","ordinal":297358,"en":"Brave Kyyaz of the Jediger"},{"id":"seytek-2012:p0028:b003:l018","ordinal":297359,"en":"Appeared before her eyes"},{"id":"seytek-2012:p0028:b003:l019","ordinal":297360,"en":"Like a ravenous monster."},{"id":"seytek-2012:p0028:b003:l020","ordinal":297361,"en":"The golden doorway and gate"},{"id":"seytek-2012:p0028:b003:l021","ordinal":297362,"en":"Had panels of solid tin."},{"id":"seytek-2012:p0028:b003:l022","ordinal":297363,"en":"As for the approach to Khan Kyyaz,"},{"id":"seytek-2012:p0028:b003:l023","ordinal":297364,"en":"The looming figure’s"},{"id":"seytek-2012:p0028:b003:l024","ordinal":297365,"en":"Appearance was like this:"},{"id":"seytek-2012:p0028:b003:l025","ordinal":297366,"en":"Within the white palace,"},{"id":"seytek-2012:p0028:b003:l026","ordinal":297367,"en":"Beside the dark spring,"},{"id":"seytek-2012:p0028:b003:l027","ordinal":297368,"en":"Right by the plane tree,"},{"id":"seytek-2012:p0028:b003:l028","ordinal":297369,"en":"Surrounded by a fortress of lions—"},{"id":"seytek-2012:p0028:b003:l029","ordinal":297370,"en":"Who among humankind had ever possessed such things?"},{"id":"seytek-2012:p0028:b003:l030","ordinal":297371,"en":"Your radiant Chürök,"},{"id":"seytek-2012:p0028:b003:l031","ordinal":297372,"en":"Your formidable wonder,"},{"id":"seytek-2012:p0028:b003:l032","ordinal":297373,"en":"Your moon-beautiful wife,"},{"id":"seytek-2012:p0028:b003:l033","ordinal":297374,"en":"Your infidel rich in wisdom,"},{"id":"seytek-2012:p0028:b003:l034","ordinal":297375,"en":"Had grown old among the people, keeping the nation,"},{"id":"seytek-2012:p0028:b003:l035","ordinal":297376,"en":"And become renowned."},{"id":"seytek-2012:p0028:b003:l036","ordinal":297377,"en":"Without shame she had Mother Umai Zuura"},{"id":"seytek-2012:p0028:b003:l037","ordinal":297378,"en":"Set her womb aright,"},{"id":"seytek-2012:p0028:b003:l038","ordinal":297379,"en":"And, letting no one suspect,"},{"id":"seytek-2012:p0028:b003:l039","ordinal":297380,"en":"The distraught woman labored for seven days,"},{"id":"seytek-2012:p0028:b003:l040","ordinal":297381,"en":"Spending her frail, fly-like life."},{"id":"seytek-2012:p0028:b002:l001","ordinal":297382,"en":"This woman earnestly begged"},{"id":"seytek-2012:p0028:b002:l002","ordinal":297383,"en":"The true God for a child."},{"id":"seytek-2012:p0028:b002:l003","ordinal":297384,"en":"After seven days had passed,"},{"id":"seytek-2012:p0028:b002:l004","ordinal":297385,"en":"When Chürök’s true labor"},{"id":"seytek-2012:p0028:b002:l005","ordinal":297386,"en":"Had lasted seven days,"},{"id":"seytek-2012:p0028:b002:l006","ordinal":297387,"en":"Her blood was spent and her strength was gone,"},{"id":"seytek-2012:p0028:b002:l007","ordinal":297388,"en":"Her power failed and her breath grew faint."},{"id":"seytek-2012:p0028:b002:l008","ordinal":297389,"en":"Wailing and wasting away for the child,"},{"id":"seytek-2012:p0028:b002:l009","ordinal":297390,"en":"She was left utterly helpless."},{"id":"seytek-2012:p0028:b002:l010","ordinal":297391,"en":"Then Aichürök"},{"id":"seytek-2012:p0028:b002:l011","ordinal":297392,"en":"Raised her voice in a scream;"},{"id":"seytek-2012:p0028:b002:l012","ordinal":297393,"en":"The lifeless trees wept,"},{"id":"seytek-2012:p0028:b002:l013","ordinal":297394,"en":"All the Creator’s works wept,"},{"id":"seytek-2012:p0028:b002:l014","ordinal":297395,"en":"Every living creature wept—"},{"id":"seytek-2012:p0028:b002:l015","ordinal":297396,"en":"Chürök’s ordeal had begun."},{"id":"seytek-2012:p0028:b002:l016","ordinal":297397,"en":"Sixty stars and seven wild sheep,"},{"id":"seytek-2012:p0028:b002:l017","ordinal":297398,"en":"Arrayed high overhead,"},{"id":"seytek-2012:p0028:b002:l018","ordinal":297399,"en":"The moon and stars sharing her travail,"},{"id":"seytek-2012:p0028:b002:l019","ordinal":297400,"en":"Labored together above her."},{"id":"seytek-2012:p0028:b002:l020","ordinal":297401,"en":"Gathering all around,"},{"id":"seytek-2012:p0028:b002:l021","ordinal":297402,"en":"The shamans of every tribe"},{"id":"seytek-2012:p0028:b002:l022","ordinal":297403,"en":"Joined her travail in a great throng."},{"id":"seytek-2012:p0028:b002:l023","ordinal":297404,"en":"Then Aichürök"},{"id":"seytek-2012:p0028:b002:l024","ordinal":297405,"en":"Labored without pause for eight days;"},{"id":"seytek-2012:p0028:b002:l025","ordinal":297406,"en":"Only a spoonful of blood remained."},{"id":"seytek-2012:p0028:b002:l026","ordinal":297407,"en":"She lost consciousness, unable even to groan,"},{"id":"seytek-2012:p0028:b002:l027","ordinal":297408,"en":"And her flesh became a bruised, blue pulp."},{"id":"seytek-2012:p0028:b002:l028","ordinal":297409,"en":"She had no voice left even to moan,"},{"id":"seytek-2012:p0028:b002:l029","ordinal":297410,"en":"And no strength remained"},{"id":"seytek-2012:p0028:b002:l030","ordinal":297411,"en":"To hide her state from Kyyaz of the Jediger."},{"id":"seytek-2012:p0028:b002:l031","ordinal":297412,"en":"Agonized by true labor,"},{"id":"seytek-2012:p0028:b002:l032","ordinal":297413,"en":"The poor woman could endure no more"},{"id":"seytek-2012:p0028:b002:l033","ordinal":297414,"en":"And despaired of her frail, fly-like life."},{"id":"seytek-2012:p0028:b002:l034","ordinal":297415,"en":"When nine days had passed,"},{"id":"seytek-2012:p0028:b002:l035","ordinal":297416,"en":"There was no way to restrain herself;"},{"id":"seytek-2012:p0028:b002:l036","ordinal":297417,"en":"None of her own gathered people were there."},{"id":"seytek-2012:p0028:b002:l037","ordinal":297418,"en":"When the bright dawn advanced"},{"id":"seytek-2012:p0028:b002:l038","ordinal":297419,"en":"And its first light glimmered,"},{"id":"seytek-2012:p0028:b002:l039","ordinal":297420,"en":"When daylight touched the earth,"},{"id":"seytek-2012:p0028:b002:l040","ordinal":297421,"en":"Stars poured down from the sky."},{"id":"seytek-2012:p0030:b003:l001","ordinal":297422,"en":"A great reverberation struck the earth;"},{"id":"seytek-2012:p0030:b003:l002","ordinal":297423,"en":"Stars appeared one by one overhead,"},{"id":"seytek-2012:p0030:b003:l003","ordinal":297424,"en":"And light quivered upon the ground."},{"id":"seytek-2012:p0030:b003:l004","ordinal":297425,"en":"Stars flashed in the heavens,"},{"id":"seytek-2012:p0030:b003:l005","ordinal":297426,"en":"Cries rang toward the qibla,"},{"id":"seytek-2012:p0030:b003:l006","ordinal":297427,"en":"The bitter wind before dawn whistled,"},{"id":"seytek-2012:p0030:b003:l007","ordinal":297428,"en":"The reed tops rattled,"},{"id":"seytek-2012:p0030:b003:l008","ordinal":297429,"en":"And fledgling larks clamored."},{"id":"seytek-2012:p0030:b003:l009","ordinal":297430,"en":"Full daylight touched the earth,"},{"id":"seytek-2012:p0030:b003:l010","ordinal":297431,"en":"And the radiant dawn advanced."},{"id":"seytek-2012:p0030:b003:l011","ordinal":297432,"en":"Every beast and living creature"},{"id":"seytek-2012:p0030:b003:l012","ordinal":297433,"en":"Raised a clamor from the earth;"},{"id":"seytek-2012:p0030:b003:l013","ordinal":297434,"en":"Upon every mountaintop,"},{"id":"seytek-2012:p0030:b003:l014","ordinal":297435,"en":"Radiance poured as the sun rose."},{"id":"seytek-2012:p0030:b003:l015","ordinal":297436,"en":"From the palace in the tower,"},{"id":"seytek-2012:p0030:b003:l016","ordinal":297437,"en":"Holding a golden staff,"},{"id":"seytek-2012:p0030:b003:l017","ordinal":297438,"en":"Waving her white kerchief,"},{"id":"seytek-2012:p0030:b003:l018","ordinal":297439,"en":"Wrapped in a loose fur coat,"},{"id":"seytek-2012:p0030:b003:l019","ordinal":297440,"en":"The unfortunate woman walked with measured grace,"},{"id":"seytek-2012:p0030:b003:l020","ordinal":297441,"en":"Imploring the Creator."},{"id":"seytek-2012:p0030:b003:l021","ordinal":297442,"en":"Within the tower with its threshold,"},{"id":"seytek-2012:p0030:b003:l022","ordinal":297443,"en":"The helpless, ill-fated woman"},{"id":"seytek-2012:p0030:b003:l023","ordinal":297444,"en":"Stood in true labor."},{"id":"seytek-2012:p0030:b003:l024","ordinal":297445,"en":"Mountainous Kyyaz now saw"},{"id":"seytek-2012:p0030:b003:l025","ordinal":297446,"en":"Your sister-in-law’s travail."},{"id":"seytek-2012:p0030:b003:l026","ordinal":297447,"en":"Seeing it, brave Kyyaz"},{"id":"seytek-2012:p0030:b003:l027","ordinal":297448,"en":"Prepared himself like a hawk;"},{"id":"seytek-2012:p0030:b003:l028","ordinal":297449,"en":"An idea from the unseen"},{"id":"seytek-2012:p0030:b003:l029","ordinal":297450,"en":"Came to brave Kyyaz."},{"id":"seytek-2012:p0030:b003:l030","ordinal":297451,"en":"Rumbling in fury,"},{"id":"seytek-2012:p0030:b003:l031","ordinal":297452,"en":"He addressed the great dark host of the Jediger:"},{"id":"seytek-2012:p0030:b003:l032","ordinal":297453,"en":"“Assemble before the khan!”"},{"id":"seytek-2012:p0030:b003:l033","ordinal":297454,"en":"Khan Kyyaz began to rage."},{"id":"seytek-2012:p0030:b003:l034","ordinal":297455,"en":"When they saw Khan Kyyaz’s wrath,"},{"id":"seytek-2012:p0030:b003:l035","ordinal":297456,"en":"The Jediger acted as though an enemy had come;"},{"id":"seytek-2012:p0030:b003:l036","ordinal":297457,"en":"Crying, “May our people’s road be fortunate!”"},{"id":"seytek-2012:p0030:b003:l037","ordinal":297458,"en":"They scattered in fright."},{"id":"seytek-2012:p0030:b003:l038","ordinal":297459,"en":"The tower was the emblem of the khan—"},{"id":"seytek-2012:p0030:b003:l039","ordinal":297460,"en":"Ask no more about that tower:"},{"id":"seytek-2012:p0030:b003:l040","ordinal":297461,"en":"Its full height was magnificent."},{"id":"seytek-2012:p0030:b002:l001","ordinal":297462,"en":"From atop that tower"},{"id":"seytek-2012:p0030:b002:l002","ordinal":297463,"en":"She called out to all the assembled people."},{"id":"seytek-2012:p0030:b002:l003","ordinal":297464,"en":"“Surging hosts of the Jediger,"},{"id":"seytek-2012:p0030:b002:l004","ordinal":297465,"en":"Come, all of you!” she cried."},{"id":"seytek-2012:p0030:b002:l005","ordinal":297466,"en":"“Great dark host of the Jediger,"},{"id":"seytek-2012:p0030:b002:l006","ordinal":297467,"en":"The khan’s doorway is like Judgment Day;"},{"id":"seytek-2012:p0030:b002:l007","ordinal":297468,"en":"We need a way to pass through it."},{"id":"seytek-2012:p0030:b002:l008","ordinal":297469,"en":"The khan’s heart is massive iron;"},{"id":"seytek-2012:p0030:b002:l009","ordinal":297470,"en":"We need a way to melt it."},{"id":"seytek-2012:p0030:b002:l010","ordinal":297471,"en":"Let the renowned Jediger people"},{"id":"seytek-2012:p0030:b002:l011","ordinal":297472,"en":"Take counsel two by two."}]
