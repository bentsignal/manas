[{"id":"sayakbay-ms-current144:pdf087:l011","ordinal":390913,"en":"His champion wielding an axe,"},{"id":"sayakbay-ms-current144:pdf087:l012","ordinal":390914,"en":"At a word he would act,"},{"id":"sayakbay-ms-current144:pdf087:l013","ordinal":390915,"en":"Bringing his full force to bear,"},{"id":"sayakbay-ms-current144:pdf087:l014","ordinal":390916,"en":"A gray tiger at his side,"},{"id":"sayakbay-ms-current144:pdf087:l015","ordinal":390917,"en":"Ready now to tear apart,"},{"id":"sayakbay-ms-current144:pdf087:l016","ordinal":390918,"en":"[When guarding the …,]"},{"id":"sayakbay-ms-current144:pdf087:l017","ordinal":390919,"en":"[Without speaking, pledging his head,]"},{"id":"sayakbay-ms-current144:pdf087:l018","ordinal":390920,"en":"[Going straight to his death,]"},{"id":"sayakbay-ms-current144:pdf087:l019","ordinal":390921,"en":"[Simply doomed to die.]"},{"id":"sayakbay-ms-current144:pdf087:l020","ordinal":390922,"en":"He brought on disaster,"},{"id":"sayakbay-ms-current144:pdf087:l021","ordinal":390923,"en":"Against a warrior resting peacefully,"},{"id":"sayakbay-ms-current144:pdf087:l022","ordinal":390924,"en":"Your champion was foolish,"},{"id":"sayakbay-ms-current144:pdf087:l023","ordinal":390925,"en":"He gave away his suspicions."},{"id":"sayakbay-ms-current144:pdf087:l024","ordinal":390926,"en":"[The day's provisions …,]"},{"id":"sayakbay-ms-current144:pdf087:l025","ordinal":390927,"en":"The weather turned, barring the road,"},{"id":"sayakbay-ms-current144:pdf087:l026","ordinal":390928,"en":"Driving the horses in a thundering herd,"},{"id":"sayakbay-ms-current144:pdf087:l027","ordinal":390929,"en":"Come, wise one, let us flee."},{"id":"sayakbay-ms-current144:pdf087:l028","ordinal":390930,"en":"[The dark enemy, to the Kyrgyz,]"},{"id":"sayakbay-ms-current144:pdf087:l029","ordinal":390931,"en":"[He has high ground and a purpose,]"},{"id":"sayakbay-ms-current144:pdf087:l030","ordinal":390932,"en":"[Saying they are a fierce, dreadful people,]"},{"id":"sayakbay-ms-current144:pdf088:l001","ordinal":390933,"en":"If a Chinese person fell into his hands,"},{"id":"sayakbay-ms-current144:pdf088:l002","ordinal":390934,"en":"He shed their blood without flinching,"},{"id":"sayakbay-ms-current144:pdf088:l003","ordinal":390935,"en":"Such was the custom among these Kyrgyz."},{"id":"sayakbay-ms-current144:pdf088:l004","ordinal":390936,"en":"[From our fathers, his forefather,]"},{"id":"sayakbay-ms-current144:pdf088:l005","ordinal":390937,"en":"Drinking blood, never drawing back,"},{"id":"sayakbay-ms-current144:pdf088:l006","ordinal":390938,"en":"Until entering the earth in death,"},{"id":"sayakbay-ms-current144:pdf088:l008","ordinal":390939,"en":"[Led by that accursed fool,]"},{"id":"sayakbay-ms-current144:pdf088:l009","ordinal":390940,"en":"If you fail to notice, great sage,"},{"id":"sayakbay-ms-current144:pdf088:l010","ordinal":390941,"en":"He will bring us great trouble."},{"id":"sayakbay-ms-current144:pdf088:l011","ordinal":390942,"en":"Your father and forefathers,"},{"id":"sayakbay-ms-current144:pdf088:l012","ordinal":390943,"en":"[Straining, that devouring fiend,]"},{"id":"sayakbay-ms-current144:pdf088:l013","ordinal":390944,"en":"The hero truly overwhelms one's strength."},{"id":"sayakbay-ms-current144:pdf088:l014","ordinal":390945,"en":"In combat, you cannot match him,"},{"id":"sayakbay-ms-current144:pdf088:l015","ordinal":390946,"en":"[The forty khanates all around,]"},{"id":"sayakbay-ms-current144:pdf088:l016","ordinal":390947,"en":"[Their mountains high, their land …,]"},{"id":"sayakbay-ms-current144:pdf088:l017","ordinal":390948,"en":"He killed those who ruled,"},{"id":"sayakbay-ms-current144:pdf088:l018","ordinal":390949,"en":"No number of emperors can defeat him,"},{"id":"sayakbay-ms-current144:pdf088:l019","ordinal":390950,"en":"Even after countless thousands of years,"},{"id":"sayakbay-ms-current144:pdf088:l020","ordinal":390951,"en":"Our Chinese people cannot avenge themselves,"},{"id":"sayakbay-ms-current144:pdf088:l021","ordinal":390952,"en":"Once coming to fight, he never withdrew,"},{"id":"sayakbay-ms-current144:pdf088:l022","ordinal":390953,"en":"The offspring of the cunning Burut."},{"id":"sayakbay-ms-current144:pdf088:l023","ordinal":390954,"en":"Brandishing a mottled blue shield,"},{"id":"sayakbay-ms-current144:pdf088:l024","ordinal":390955,"en":"Never sated when tasting blood,"},{"id":"sayakbay-ms-current144:pdf088:l025","ordinal":390956,"en":"Told to drink water, he drank poison,"},{"id":"sayakbay-ms-current144:pdf088:l026","ordinal":390957,"en":"They have leveled their spears,"},{"id":"sayakbay-ms-current144:pdf088:l027","ordinal":390958,"en":"[The bannered warrior …,]"},{"id":"sayakbay-ms-current144:pdf088:l028","ordinal":390959,"en":"[A people not overcome by frenzy,]"},{"id":"sayakbay-ms-current144:pdf088:l029","ordinal":390960,"en":"[One who flails, falls, and dies,]"},{"id":"sayakbay-ms-current144:pdf088:l030","ordinal":390961,"en":"This is towering Ala-Too,"},{"id":"sayakbay-ms-current144:pdf089:l001","ordinal":390962,"en":"Let us turn our horses' rumps toward them,"},{"id":"sayakbay-ms-current144:pdf089:l002","ordinal":390963,"en":"Let us ride along the plain,"},{"id":"sayakbay-ms-current144:pdf089:l003","ordinal":390964,"en":"If we do not turn our horses away,"},{"id":"sayakbay-ms-current144:pdf089:l004","ordinal":390965,"en":"If we do not follow the plain,"},{"id":"sayakbay-ms-current144:pdf089:l005","ordinal":390966,"en":"We shall suffer strange humiliation,"},{"id":"sayakbay-ms-current144:pdf089:l006","ordinal":390967,"en":"We shall suffer greatly from the Kyrgyz,"},{"id":"sayakbay-ms-current144:pdf089:l007","ordinal":390968,"en":"The humiliation our grandfathers suffered."},{"id":"sayakbay-ms-current144:pdf089:l008","ordinal":390969,"en":"So the giant Küchük spoke at length,"},{"id":"sayakbay-ms-current144:pdf089:l009","ordinal":390970,"en":"The giant Küchük caused great turmoil."},{"id":"sayakbay-ms-current144:pdf089:l011","ordinal":390971,"en":"Like a great cauldron boiling food,"},{"id":"sayakbay-ms-current144:pdf089:l015","ordinal":390972,"en":"You are an infidel calling himself a hero,"},{"id":"sayakbay-ms-current144:pdf089:l018","ordinal":390973,"en":"[These eyes have seen your forefathers,]"},{"id":"sayakbay-ms-current144:pdf089:l019","ordinal":390974,"en":"Look at these words of yours,"},{"id":"sayakbay-ms-current144:pdf089:l023","ordinal":390975,"en":"Uttering coarse, wicked words,"},{"id":"sayakbay-ms-current144:pdf089:l025","ordinal":390976,"en":"Posing as a hero, boasting of bravery,"},{"id":"sayakbay-ms-current144:pdf089:l026","ordinal":390977,"en":"You make the champion roar."},{"id":"sayakbay-ms-current144:pdf089:l027","ordinal":390978,"en":"[Why do you begin this struggle,]"},{"id":"sayakbay-ms-current144:pdf089:l030","ordinal":390979,"en":"Does one not die when his hour comes?"},{"id":"sayakbay-ms-current144:pdf089:l031","ordinal":390980,"en":"[Does your appearance not look empty?]"},{"id":"sayakbay-ms-current144:pdf089:l032","ordinal":390981,"en":"[When boasting with your tongue,]"},{"id":"sayakbay-ms-current144:pdf090:l001","ordinal":390982,"en":"This was what he saw then."},{"id":"sayakbay-ms-current144:pdf090:l002","ordinal":390983,"en":"[With no presence, no heart,]"},{"id":"sayakbay-ms-current144:pdf090:l004","ordinal":390984,"en":"Burning his world behind him,"},{"id":"sayakbay-ms-current144:pdf090:l006","ordinal":390985,"en":"The near edge of the Burut lands,"},{"id":"sayakbay-ms-current144:pdf090:l007","ordinal":390986,"en":"Will they not say he had seen it?"},{"id":"sayakbay-ms-current144:pdf090:l008","ordinal":390987,"en":"Unless his allotted death took him,"},{"id":"sayakbay-ms-current144:pdf090:l010","ordinal":390988,"en":"[From afar, speaking behind his back,]"},{"id":"sayakbay-ms-current144:pdf090:l012","ordinal":390989,"en":"Giant Küchük, ignorant one, sink into the earth,"},{"id":"sayakbay-ms-current144:pdf090:l013","ordinal":390990,"en":"Who would listen to these words of yours?"},{"id":"sayakbay-ms-current144:pdf090:l014","ordinal":390991,"en":"Let the blinding night hear them,"},{"id":"sayakbay-ms-current144:pdf090:l015","ordinal":390992,"en":"Let unnoticed waters hear them,"},{"id":"sayakbay-ms-current144:pdf090:l016","ordinal":390993,"en":"[Let the loud tumult hear them.]"},{"id":"sayakbay-ms-current144:pdf090:l017","ordinal":390994,"en":"Is this what you say now?"},{"id":"sayakbay-ms-current144:pdf090:l019","ordinal":390995,"en":"[The measure of these words,]"},{"id":"sayakbay-ms-current144:pdf090:l020","ordinal":390996,"en":"Let the dog striking the threshold hear,"},{"id":"sayakbay-ms-current144:pdf090:l021","ordinal":390997,"en":"[Let the beast and bird that cry hear,]"},{"id":"sayakbay-ms-current144:pdf090:l022","ordinal":390998,"en":"Who else should hear such words?"},{"id":"sayakbay-ms-current144:pdf090:l023","ordinal":390999,"en":"[Yesterday, when night fell upon the mountain,]"},{"id":"sayakbay-ms-current144:pdf090:l024","ordinal":391000,"en":"The people gathered, the nation stood,"},{"id":"sayakbay-ms-current144:pdf090:l025","ordinal":391001,"en":"Those called male kinsmen,"},{"id":"sayakbay-ms-current144:pdf090:l026","ordinal":391002,"en":"So many rams, so much livestock,"},{"id":"sayakbay-ms-current144:pdf090:l027","ordinal":391003,"en":"They gave as gifts for glad tidings,"},{"id":"sayakbay-ms-current144:pdf090:l028","ordinal":391004,"en":"Calling him a man who would defend honor,"},{"id":"sayakbay-ms-current144:pdf090:l029","ordinal":391005,"en":"They called him protector of the people."},{"id":"sayakbay-ms-current144:pdf090:l030","ordinal":391006,"en":"Perish if you do not protect the people,"},{"id":"sayakbay-ms-current144:pdf090:l031","ordinal":391007,"en":"Die rather than fail to be a man,"},{"id":"sayakbay-ms-current144:pdf090:l032","ordinal":391008,"en":"You spoke before your kinsmen,"},{"id":"sayakbay-ms-current144:pdf091:l001","ordinal":391009,"en":"[Hey, sunk before you were even born,]"},{"id":"sayakbay-ms-current144:pdf091:l002","ordinal":391010,"en":"You made your people tremble,"},{"id":"sayakbay-ms-current144:pdf091:l004","ordinal":391011,"en":"Without resource, without honor,"},{"id":"sayakbay-ms-current144:pdf091:l005","ordinal":391012,"en":"[Roaring, he drove them into hardship.]"},{"id":"sayakbay-ms-current144:pdf091:l006","ordinal":391013,"en":"Licking your sword, swaggering,"},{"id":"sayakbay-ms-current144:pdf091:l010","ordinal":391014,"en":"For the honor of the people,"},{"id":"sayakbay-ms-current144:pdf091:l012","ordinal":391015,"en":"I will act bravely, stout of heart,"},{"id":"sayakbay-ms-current144:pdf091:l014","ordinal":391016,"en":"[One gift of the Chinese,]"},{"id":"sayakbay-ms-current144:pdf091:l015","ordinal":391017,"en":"You said you would take it."},{"id":"sayakbay-ms-current144:pdf091:l016","ordinal":391018,"en":"Destroying their people, to their roots,"},{"id":"sayakbay-ms-current144:pdf091:l017","ordinal":391019,"en":"You said you would reach them!"},{"id":"sayakbay-ms-current144:pdf091:l018","ordinal":391020,"en":"Thus the great sage reproached him,"},{"id":"sayakbay-ms-current144:pdf091:l019","ordinal":391021,"en":"Muttering in fury,"},{"id":"sayakbay-ms-current144:pdf091:l020","ordinal":391022,"en":"Scolding harshly, thundering,"},{"id":"sayakbay-ms-current144:pdf091:l021","ordinal":391023,"en":"[He now drew the great arrow.]"},{"id":"sayakbay-ms-current144:pdf091:l022","ordinal":391024,"en":"[With the presence of such a man,]"},{"id":"sayakbay-ms-current144:pdf091:l023","ordinal":391025,"en":"[Without wearing them down or bewildering them,]"},{"id":"sayakbay-ms-current144:pdf091:l024","ordinal":391026,"en":"Seize him, cut off his head, he said."},{"id":"sayakbay-ms-current144:pdf091:l025","ordinal":391027,"en":"[When he shouted from among the people,]"},{"id":"sayakbay-ms-current144:pdf091:l027","ordinal":391028,"en":"Would they merely stand and watch?"},{"id":"sayakbay-ms-current144:pdf091:l028","ordinal":391029,"en":"Since he was the people's leader,"},{"id":"sayakbay-ms-current144:pdf091:l029","ordinal":391030,"en":"What choice had the two giants?"},{"id":"sayakbay-ms-current144:pdf091:l030","ordinal":391031,"en":"His champion who drew the bow,"},{"id":"sayakbay-ms-current144:pdf091:l031","ordinal":391032,"en":"Took his bow from the ground,"},{"id":"sayakbay-ms-current144:pdf092:l001","ordinal":391033,"en":"Beside that sage,"},{"id":"sayakbay-ms-current144:pdf092:l003","ordinal":391034,"en":"[Broad-chested, with a sweeping presence,]"},{"id":"sayakbay-ms-current144:pdf092:l004","ordinal":391035,"en":"[He also had his mounted attendants,]"},{"id":"sayakbay-ms-current144:pdf092:l005","ordinal":391036,"en":"Who took heads at a command,"},{"id":"sayakbay-ms-current144:pdf092:l006","ordinal":391037,"en":"Long accustomed to the khan's orders,"},{"id":"sayakbay-ms-current144:pdf092:l007","ordinal":391038,"en":"He had such infidels too."},{"id":"sayakbay-ms-current144:pdf092:l009","ordinal":391039,"en":"Drew their swords from their sheaths,"},{"id":"sayakbay-ms-current144:pdf092:l010","ordinal":391040,"en":"Rolled up their cutting arms' sleeves,"},{"id":"sayakbay-ms-current144:pdf092:l015","ordinal":391041,"en":"The very destroyer of the people,"},{"id":"sayakbay-ms-current144:pdf092:l016","ordinal":391042,"en":"No true kinsman to my people,"},{"id":"sayakbay-ms-current144:pdf092:l017","ordinal":391043,"en":"Wicked to his roots,"},{"id":"sayakbay-ms-current144:pdf092:l018","ordinal":391044,"en":"They cut off his head with a sword,"},{"id":"sayakbay-ms-current144:pdf092:l019","ordinal":391045,"en":"Küchük, who had spoken the truth,"},{"id":"sayakbay-ms-current144:pdf092:l025","ordinal":391046,"en":"Destroying his own executioner,"},{"id":"sayakbay-ms-current144:pdf092:l027","ordinal":391047,"en":"He killed his own kinsman,"},{"id":"sayakbay-ms-current144:pdf092:l028","ordinal":391048,"en":"To whom would he remain loyal?"},{"id":"sayakbay-ms-current144:pdf092:l031","ordinal":391049,"en":"To the champion who strode forward,"},{"id":"sayakbay-ms-current144:pdf092:l032","ordinal":391050,"en":"Pouring out his wrath, making them rigid,"},{"id":"sayakbay-ms-current144:pdf093:l001","ordinal":391051,"en":"If we speak, he will kill us, they thought,"},{"id":"sayakbay-ms-current144:pdf093:l002","ordinal":391052,"en":"[He spoke threatening words.]"},{"id":"sayakbay-ms-current144:pdf093:l003","ordinal":391053,"en":"The Chinese numbered forty thousand,"},{"id":"sayakbay-ms-current144:pdf093:l004","ordinal":391054,"en":"[Calling that mountain of humiliation foolish,]"},{"id":"sayakbay-ms-current144:pdf093:l005","ordinal":391055,"en":"He made the promise firm."},{"id":"sayakbay-ms-current144:pdf093:l006","ordinal":391056,"en":"Saying I was not afraid is one statement,"},{"id":"sayakbay-ms-current144:pdf093:l007","ordinal":391057,"en":"Saying I was afraid is a thousand words,"},{"id":"sayakbay-ms-current144:pdf093:l008","ordinal":391058,"en":"[Troubled by what they heard,]"},{"id":"sayakbay-ms-current144:pdf093:l009","ordinal":391059,"en":"[His battle cry cast its shadow.]"},{"id":"sayakbay-ms-current144:pdf093:l012","ordinal":391060,"en":"[They began their ruler's assigned duty.]"},{"id":"sayakbay-ms-current144:pdf093:l013","ordinal":391061,"en":"[Even if you kill me, I do not know,]"},{"id":"sayakbay-ms-current144:pdf093:l014","ordinal":391062,"en":"After that, what they had seen,"},{"id":"sayakbay-ms-current144:pdf093:l015","ordinal":391063,"en":"They dismissed with I was not afraid."},{"id":"sayakbay-ms-current144:pdf093:l016","ordinal":391064,"en":"The people cried out and grieved,"},{"id":"sayakbay-ms-current144:pdf093:l017","ordinal":391065,"en":"The sorrowful champion stood there."},{"id":"sayakbay-ms-current144:pdf093:l018","ordinal":391066,"en":"Then the great sage,"},{"id":"sayakbay-ms-current144:pdf093:l020","ordinal":391067,"en":"[Performing weather spells and incantations,]"},{"id":"sayakbay-ms-current144:pdf093:l021","ordinal":391068,"en":"[Mounted, the mighty marksman,]"},{"id":"sayakbay-ms-current144:pdf093:l022","ordinal":391069,"en":"One who came but once into the world,"},{"id":"sayakbay-ms-current144:pdf093:l023","ordinal":391070,"en":"When drawing a bow, he never missed,"},{"id":"sayakbay-ms-current144:pdf093:l024","ordinal":391071,"en":"In combat, he made his foes bleed,"},{"id":"sayakbay-ms-current144:pdf093:l025","ordinal":391072,"en":"[The mightiest of the terrible fiends,]"},{"id":"sayakbay-ms-current144:pdf093:l026","ordinal":391073,"en":"The stoutest, never flinching,"},{"id":"sayakbay-ms-current144:pdf093:l027","ordinal":391074,"en":"To him, Joltoy's fame,"},{"id":"sayakbay-ms-current144:pdf093:l028","ordinal":391075,"en":"Was truly well known,"},{"id":"sayakbay-ms-current144:pdf093:l029","ordinal":391076,"en":"[For him, true hardship …,]"},{"id":"sayakbay-ms-current144:pdf093:l030","ordinal":391077,"en":"[This was the head of …,]"},{"id":"sayakbay-ms-current144:pdf093:l031","ordinal":391078,"en":"His first word was never contradicted,"},{"id":"sayakbay-ms-current144:pdf093:l032","ordinal":391079,"en":"Even when sending word through the ages,"},{"id":"sayakbay-ms-current144:pdf094:l001","ordinal":391080,"en":"Of this accursed slave,"},{"id":"sayakbay-ms-current144:pdf094:l002","ordinal":391081,"en":"His deeds were not genuine."},{"id":"sayakbay-ms-current144:pdf094:l003","ordinal":391082,"en":"He was their chief, their khan,"},{"id":"sayakbay-ms-current144:pdf094:l004","ordinal":391083,"en":"[This was the city where he set foot,]"},{"id":"sayakbay-ms-current144:pdf094:l005","ordinal":391084,"en":"This was their unshaken fortress,"},{"id":"sayakbay-ms-current144:pdf094:l006","ordinal":391085,"en":"This was their unwavering warrior."},{"id":"sayakbay-ms-current144:pdf094:l007","ordinal":391086,"en":"The great sage, without haste,"},{"id":"sayakbay-ms-current144:pdf094:l008","ordinal":391087,"en":"Let whichever Burut come, he said,"},{"id":"sayakbay-ms-current144:pdf094:l009","ordinal":391088,"en":"[From where had these warriors gathered?]"},{"id":"sayakbay-ms-current144:pdf094:l010","ordinal":391089,"en":"Great Köbük, who came from Beijing,"},{"id":"sayakbay-ms-current144:pdf094:l012","ordinal":391090,"en":"Wearing an arrow-proof coat of armor,"},{"id":"sayakbay-ms-current144:pdf094:l013","ordinal":391091,"en":"Riding a horse no arrow could catch,"},{"id":"sayakbay-ms-current144:pdf094:l014","ordinal":391092,"en":"Taking a spear like a pine tree,"},{"id":"sayakbay-ms-current144:pdf094:l015","ordinal":391093,"en":"[His path swelled as large as a house,]"},{"id":"sayakbay-ms-current144:pdf094:l016","ordinal":391094,"en":"So the frightened Burut would flee,"},{"id":"sayakbay-ms-current144:pdf094:l017","ordinal":391095,"en":"Before his majesty and wrath,"},{"id":"sayakbay-ms-current144:pdf094:l018","ordinal":391096,"en":"[Before his dreadful fury,]"},{"id":"sayakbay-ms-current144:pdf094:l020","ordinal":391097,"en":"Would sink beneath the earth,"},{"id":"sayakbay-ms-current144:pdf094:l023","ordinal":391098,"en":"Despairing of his precious life,"},{"id":"sayakbay-ms-current144:pdf094:l024","ordinal":391099,"en":"Let him flee in terror and confusion."},{"id":"sayakbay-ms-current144:pdf094:l025","ordinal":391100,"en":"[His stature appearing overwhelming,]"},{"id":"sayakbay-ms-current144:pdf094:l026","ordinal":391101,"en":"Standing apart from ninety kinds,"},{"id":"sayakbay-ms-current144:pdf094:l027","ordinal":391102,"en":"A mountain supporting the sky,"},{"id":"sayakbay-ms-current144:pdf094:l028","ordinal":391103,"en":"Raging, imposing his will,"},{"id":"sayakbay-ms-current144:pdf094:l029","ordinal":391104,"en":"[Draining so many, raising an uproar,]"},{"id":"sayakbay-ms-current144:pdf095:l001","ordinal":391105,"en":"[Loading the Onogor with shot,]"},{"id":"sayakbay-ms-current144:pdf095:l002","ordinal":391106,"en":"That fearsome madman,"},{"id":"sayakbay-ms-current144:pdf095:l003","ordinal":391107,"en":"[A coarse steel belt of terror,]"},{"id":"sayakbay-ms-current144:pdf095:l004","ordinal":391108,"en":"Fastening it neatly to his saddle straps,"},{"id":"sayakbay-ms-current144:pdf095:l005","ordinal":391109,"en":"That practiced wretch,"},{"id":"sayakbay-ms-current144:pdf095:l006","ordinal":391110,"en":"Setting the shield above his head,"},{"id":"sayakbay-ms-current144:pdf095:l010","ordinal":391111,"en":"The madman's war drum,"},{"id":"sayakbay-ms-current144:pdf095:l011","ordinal":391112,"en":"[Hearing its sound, you would be struck down.]"},{"id":"sayakbay-ms-current144:pdf095:l012","ordinal":391113,"en":"[His champion struck it to sound,]"},{"id":"sayakbay-ms-current144:pdf095:l014","ordinal":391114,"en":"[Their wits simply fled.]"},{"id":"sayakbay-ms-current144:pdf095:l015","ordinal":391115,"en":"That Chinese warrior, mad at heart,"},{"id":"sayakbay-ms-current144:pdf095:l017","ordinal":391116,"en":"Know for yourself, lord,"},{"id":"sayakbay-ms-current144:pdf095:l018","ordinal":391117,"en":"Its girth was three fathoms,"},{"id":"sayakbay-ms-current144:pdf095:l019","ordinal":391118,"en":"[Simply breaking the …,]"},{"id":"sayakbay-ms-current144:pdf095:l020","ordinal":391119,"en":"[Visible across the face of the earth.]"},{"id":"sayakbay-ms-current144:pdf095:l023","ordinal":391120,"en":"Alabash, the mighty stallion,"},{"id":"sayakbay-ms-current144:pdf095:l024","ordinal":391121,"en":"[That wild one panicked,]"},{"id":"sayakbay-ms-current144:pdf095:l025","ordinal":391122,"en":"Fine steeds and swift chargers mingled,"},{"id":"sayakbay-ms-current144:pdf095:l026","ordinal":391123,"en":"The earth shook with their thunder,"},{"id":"sayakbay-ms-current144:pdf095:l027","ordinal":391124,"en":"[Red roans with flowing manes,]"},{"id":"sayakbay-ms-current144:pdf095:l028","ordinal":391125,"en":"[Toward where Seytek stood some distance away,]"},{"id":"sayakbay-ms-current144:pdf095:l029","ordinal":391126,"en":"Stampeding from the plain, thundering,"},{"id":"sayakbay-ms-current144:pdf095:l031","ordinal":391127,"en":"More than a hundred horses,"},{"id":"sayakbay-ms-current144:pdf096:l001","ordinal":391128,"en":"Some had hindquarters left,"},{"id":"sayakbay-ms-current144:pdf096:l002","ordinal":391129,"en":"Some had their faces left,"},{"id":"sayakbay-ms-current144:pdf096:l003","ordinal":391130,"en":"[Devouring the stiffened, fat yearlings,]"},{"id":"sayakbay-ms-current144:pdf096:l004","ordinal":391131,"en":"[Devouring those alongside in the open,]"},{"id":"sayakbay-ms-current144:pdf096:l005","ordinal":391132,"en":"[The herdsman, caught up in excitement,]"},{"id":"sayakbay-ms-current144:pdf096:l006","ordinal":391133,"en":"Had not remained asleep,"},{"id":"sayakbay-ms-current144:pdf096:l007","ordinal":391134,"en":"Those accursed wretches,"},{"id":"sayakbay-ms-current144:pdf096:l008","ordinal":391135,"en":"[They were left in their trousers,]"},{"id":"sayakbay-ms-current144:pdf096:l009","ordinal":391136,"en":"Those sprawled out sleeping,"},{"id":"sayakbay-ms-current144:pdf096:l012","ordinal":391137,"en":"Leaping and bounding,"},{"id":"sayakbay-ms-current144:pdf096:l013","ordinal":391138,"en":"Speaking as though still asleep,"},{"id":"sayakbay-ms-current144:pdf096:l015","ordinal":391139,"en":"They rounded up the horses,"},{"id":"sayakbay-ms-current144:pdf096:l017","ordinal":391140,"en":"Striking with his catching pole."},{"id":"sayakbay-ms-current144:pdf096:l018","ordinal":391141,"en":"Then the great sage,"},{"id":"sayakbay-ms-current144:pdf096:l019","ordinal":391142,"en":"[The steadfast warrior Ichig,]"},{"id":"sayakbay-ms-current144:pdf096:l020","ordinal":391143,"en":"[His divination vast as the sea,]"},{"id":"sayakbay-ms-current144:pdf096:l021","ordinal":391144,"en":"[The faultless warrior that day,]"},{"id":"sayakbay-ms-current144:pdf096:l023","ordinal":391145,"en":"Raising a tumult like the world's end,"},{"id":"sayakbay-ms-current144:pdf096:l024","ordinal":391146,"en":"Driving all the horses from the plain,"},{"id":"sayakbay-ms-current144:pdf096:l025","ordinal":391147,"en":"[Sweeping through in a dark mass,]"},{"id":"sayakbay-ms-current144:pdf096:l027","ordinal":391148,"en":"[At that place, his horses,]"},{"id":"sayakbay-ms-current144:pdf096:l028","ordinal":391149,"en":"He raged, wreaking slaughter."},{"id":"sayakbay-ms-current144:pdf096:l030","ordinal":391150,"en":"[Drawing his bow in pursuit,]"},{"id":"sayakbay-ms-current144:pdf096:l031","ordinal":391151,"en":"Thundering when a raven flew,"},{"id":"sayakbay-ms-current144:pdf096:l032","ordinal":391152,"en":"Shooting it without letting it escape,"},{"id":"sayakbay-ms-current144:pdf097:l001","ordinal":391153,"en":"Pouring out his wrath, bellowing,"},{"id":"sayakbay-ms-current144:pdf097:l004","ordinal":391154,"en":"Driving the horses off to the right,"},{"id":"sayakbay-ms-current144:pdf097:l005","ordinal":391155,"en":"[Turning them back with his whip,]"},{"id":"sayakbay-ms-current144:pdf097:l006","ordinal":391156,"en":"[Your mighty warrior along the ridge,]"},{"id":"sayakbay-ms-current144:pdf097:l007","ordinal":391157,"en":"Went on doing so,"},{"id":"sayakbay-ms-current144:pdf097:l008","ordinal":391158,"en":"[The horses veering aside,]"},{"id":"sayakbay-ms-current144:pdf097:l009","ordinal":391159,"en":"Cutting them down in heaps,"},{"id":"sayakbay-ms-current144:pdf097:l010","ordinal":391160,"en":"He went on slaughtering them,"},{"id":"sayakbay-ms-current144:pdf097:l012","ordinal":391161,"en":"He went on bringing it."},{"id":"sayakbay-ms-current144:pdf097:l014","ordinal":391162,"en":"Roaring in a show of might,"},{"id":"sayakbay-ms-current144:pdf097:l015","ordinal":391163,"en":"Calling his champions,"},{"id":"sayakbay-ms-current144:pdf097:l016","ordinal":391164,"en":"Is there anyone who will strike straight?"},{"id":"sayakbay-ms-current144:pdf097:l017","ordinal":391165,"en":"[While your troubled head remains,]"},{"id":"sayakbay-ms-current144:pdf097:l018","ordinal":391166,"en":"From the ruined Burut people,"},{"id":"sayakbay-ms-current144:pdf097:l019","ordinal":391167,"en":"Where is the bold one to face me?"},{"id":"sayakbay-ms-current144:pdf097:l020","ordinal":391168,"en":"He has a mighty steed beneath him,"}]
