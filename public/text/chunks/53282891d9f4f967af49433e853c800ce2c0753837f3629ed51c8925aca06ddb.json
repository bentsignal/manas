[{"id":"manas-2010:p1178:b001:l015","ordinal":51201,"en":"The polished spear splintered."},{"id":"manas-2010:p1178:b001:l016","ordinal":51202,"en":"The wretched blind one remained wretched."},{"id":"manas-2010:p1178:b001:l017","ordinal":51203,"en":"When the horse collided with him,"},{"id":"manas-2010:p1178:b001:l018","ordinal":51204,"en":"He sank knee-deep into the earth."},{"id":"manas-2010:p1178:b001:l019","ordinal":51205,"en":"Before he could gather his senses,"},{"id":"manas-2010:p1178:b001:l020","ordinal":51206,"en":"Before dear swift Sarala"},{"id":"manas-2010:p1178:b001:l021","ordinal":51207,"en":"Could stand upright again,"},{"id":"manas-2010:p1178:b001:l022","ordinal":51208,"en":"His brow darkened a handspan."},{"id":"manas-2010:p1178:b001:l023","ordinal":51209,"en":"From mighty Malgun,"},{"id":"manas-2010:p1178:b001:l024","ordinal":51210,"en":"What person had escaped?"},{"id":"manas-2010:p1178:b001:l025","ordinal":51211,"en":"He intended to make a spectacle,"},{"id":"manas-2010:p1178:b001:l026","ordinal":51212,"en":"Upon Almambet's head"},{"id":"manas-2010:p1178:b001:l027","ordinal":51213,"en":"He intended to bring disaster."},{"id":"manas-2010:p1178:b001:l028","ordinal":51214,"en":"Letting out a roar,"},{"id":"manas-2010:p1178:b001:l029","ordinal":51215,"en":"Sarala's tail"},{"id":"manas-2010:p1178:b001:l030","ordinal":51216,"en":"And Almambet's robe hem,"},{"id":"manas-2010:p1178:b001:l031","ordinal":51217,"en":"Into the wicked blind one's hand,"},{"id":"manas-2010:p1178:b001:l032","ordinal":51218,"en":"Both fell together."},{"id":"manas-2010:p1178:b001:l033","ordinal":51219,"en":"What a lion Almambet was!"},{"id":"manas-2010:p1178:b001:l034","ordinal":51220,"en":"Joined to Sarala,"},{"id":"manas-2010:p1178:b001:l035","ordinal":51221,"en":"He dragged both of them alike."},{"id":"manas-2010:p1178:b001:l036","ordinal":51222,"en":"The axe as big as a herder's shelter,"},{"id":"manas-2010:p1178:b001:l037","ordinal":51223,"en":"Positioning it in his hand,"},{"id":"manas-2010:p1178:b001:l038","ordinal":51224,"en":"Great Malgun was about to take up."},{"id":"manas-2010:p1178:b001:l039","ordinal":51225,"en":"While Almambet was in this plight,"},{"id":"manas-2010:p1178:b001:l040","ordinal":51226,"en":"So much worry that the heart could not contain it—"},{"id":"manas-2010:p1178:b001:l041","ordinal":51227,"en":"Dear mighty Syrgak's"},{"id":"manas-2010:p1178:b001:l042","ordinal":51228,"en":"Tears streamed in ten directions:"},{"id":"manas-2010:p1179:b001:l001","ordinal":51229,"en":"'You have brought him against this blind one!"},{"id":"manas-2010:p1179:b001:l002","ordinal":51230,"en":"Is this the doom that has come upon us?"},{"id":"manas-2010:p1179:b001:l003","ordinal":51231,"en":"He was a hero born a leopard."},{"id":"manas-2010:p1179:b001:l004","ordinal":51232,"en":"God, keep my Alma safe!"},{"id":"manas-2010:p1179:b001:l005","ordinal":51233,"en":"If my death has come, let me die."},{"id":"manas-2010:p1179:b001:l006","ordinal":51234,"en":"For a lion like Almambet,"},{"id":"manas-2010:p1179:b001:l007","ordinal":51235,"en":"Let me give myself in sacrifice.'"},{"id":"manas-2010:p1179:b001:l008","ordinal":51236,"en":"Kökchebich beneath him,"},{"id":"manas-2010:p1179:b001:l009","ordinal":51237,"en":"He whipped on right and left,"},{"id":"manas-2010:p1179:b001:l010","ordinal":51238,"en":"Spurring on both sides."},{"id":"manas-2010:p1179:b001:l011","ordinal":51239,"en":"He reached them faster than an arrow."},{"id":"manas-2010:p1179:b001:l012","ordinal":51240,"en":"Upon reaching him, the blind one,"},{"id":"manas-2010:p1179:b001:l013","ordinal":51241,"en":"From over Almambet,"},{"id":"manas-2010:p1179:b001:l014","ordinal":51242,"en":"He knocked aside as he passed."},{"id":"manas-2010:p1179:b001:l015","ordinal":51243,"en":"At this, Almambet"},{"id":"manas-2010:p1179:b001:l016","ordinal":51244,"en":"Sprang onto his horse"},{"id":"manas-2010:p1179:b001:l017","ordinal":51245,"en":"And recovered himself."},{"id":"manas-2010:p1179:b001:l018","ordinal":51246,"en":"Turning about, hero Syrgak,"},{"id":"manas-2010:p1179:b001:l019","ordinal":51247,"en":"Charging like a falcon,"},{"id":"manas-2010:p1179:b001:l020","ordinal":51248,"en":"Came rushing back."},{"id":"manas-2010:p1179:b001:l021","ordinal":51249,"en":"His battle-axe forged of steel,"},{"id":"manas-2010:p1179:b001:l022","ordinal":51250,"en":"Hero Syrgak gripped firmly."},{"id":"manas-2010:p1179:b001:l023","ordinal":51251,"en":"Malgun, as big as a hill,"},{"id":"manas-2010:p1179:b001:l024","ordinal":51252,"en":"On top of his head, twice,"},{"id":"manas-2010:p1179:b001:l025","ordinal":51253,"en":"He struck as he passed."},{"id":"manas-2010:p1179:b001:l026","ordinal":51254,"en":"Malgun paid no heed to the blows."},{"id":"manas-2010:p1179:b001:l027","ordinal":51255,"en":"The force of Syrgak's blows,"},{"id":"manas-2010:p1179:b001:l028","ordinal":51256,"en":"He counted as nothing."},{"id":"manas-2010:p1179:b001:l029","ordinal":51257,"en":"Before Syrgak could turn and pass,"},{"id":"manas-2010:p1179:b001:l030","ordinal":51258,"en":"The trick rider, the swift runner,"},{"id":"manas-2010:p1179:b001:l031","ordinal":51259,"en":"The great performing wrestler,"},{"id":"manas-2010:p1179:b001:l032","ordinal":51260,"en":"In the blink of an eye,"},{"id":"manas-2010:p1179:b001:l033","ordinal":51261,"en":"Young hero Syrgak's"},{"id":"manas-2010:p1179:b001:l034","ordinal":51262,"en":"Head he was about to split with a blow."},{"id":"manas-2010:p1179:b001:l035","ordinal":51263,"en":"Not letting hero Syrgak be struck,"},{"id":"manas-2010:p1179:b001:l036","ordinal":51264,"en":"Dear gray-maned Almambet"},{"id":"manas-2010:p1179:b001:l037","ordinal":51265,"en":"Reached him faster than a whirlwind."},{"id":"manas-2010:p1179:b001:l038","ordinal":51266,"en":"Upon reaching Malgun,"},{"id":"manas-2010:p1179:b001:l039","ordinal":51267,"en":"He drove a blow into his breast as he passed."},{"id":"manas-2010:p1179:b001:l040","ordinal":51268,"en":"Young Syrgak, held captive,"},{"id":"manas-2010:p1179:b001:l041","ordinal":51269,"en":"Was freed and escaped."},{"id":"manas-2010:p1179:b001:l042","ordinal":51270,"en":"Malgun and Almambet"},{"id":"manas-2010:p1180:b001:l001","ordinal":51271,"en":"Began striking each other."},{"id":"manas-2010:p1180:b001:l002","ordinal":51272,"en":"The faces of their shields clashed."},{"id":"manas-2010:p1180:b001:l003","ordinal":51273,"en":"Their armor tore."},{"id":"manas-2010:p1180:b001:l004","ordinal":51274,"en":"The two heroes, standing without fleeing,"},{"id":"manas-2010:p1180:b001:l005","ordinal":51275,"en":"Fought in earnest."},{"id":"manas-2010:p1180:b001:l006","ordinal":51276,"en":"Bounding upon Kökchebich,"},{"id":"manas-2010:p1180:b001:l007","ordinal":51277,"en":"Hero Syrgak rode alongside."},{"id":"manas-2010:p1180:b001:l008","ordinal":51278,"en":"'Would that I had not been created,' he said,"},{"id":"manas-2010:p1180:b001:l009","ordinal":51279,"en":"Pleading with the Creator,"},{"id":"manas-2010:p1180:b001:l010","ordinal":51280,"en":"Hero Syrgak rode in tears."},{"id":"manas-2010:p1180:b001:l011","ordinal":51281,"en":"'I, Almambet, beyond all others,"},{"id":"manas-2010:p1180:b001:l012","ordinal":51282,"en":"Became a lion among humankind."},{"id":"manas-2010:p1180:b001:l013","ordinal":51283,"en":"Not even made the equal of one Malgun,"},{"id":"manas-2010:p1180:b001:l014","ordinal":51284,"en":"Why have I become so inferior?"},{"id":"manas-2010:p1180:b001:l015","ordinal":51285,"en":"Whatever happens, let me face it."},{"id":"manas-2010:p1180:b001:l016","ordinal":51286,"en":"While we stand opposing one another,"},{"id":"manas-2010:p1180:b001:l017","ordinal":51287,"en":"The infidel Malgun, the blind one,"},{"id":"manas-2010:p1180:b001:l018","ordinal":51288,"en":"Without missing his single eye,"},{"id":"manas-2010:p1180:b001:l019","ordinal":51289,"en":"Taking careful aim with my spear,"},{"id":"manas-2010:p1180:b001:l020","ordinal":51290,"en":"Let me thrust him in the eye!'"},{"id":"manas-2010:p1180:b001:l021","ordinal":51291,"en":"Saying this, hero Syrgak"},{"id":"manas-2010:p1180:b001:l022","ordinal":51292,"en":"Reached him like a merlin."},{"id":"manas-2010:p1180:b001:l023","ordinal":51293,"en":"'Malgun's single eye!' he cried."},{"id":"manas-2010:p1180:b001:l024","ordinal":51294,"en":"Into the pupil, hero Syrgak"},{"id":"manas-2010:p1180:b001:l025","ordinal":51295,"en":"Drove a blow as he passed."},{"id":"manas-2010:p1180:b001:l026","ordinal":51296,"en":"When the pupil was struck,"},{"id":"manas-2010:p1180:b001:l027","ordinal":51297,"en":"Speared in his single eye,"},{"id":"manas-2010:p1180:b001:l028","ordinal":51298,"en":"He lost his pupil."},{"id":"manas-2010:p1180:b001:l029","ordinal":51299,"en":"Helpless, Great Malgun"},{"id":"manas-2010:p1180:b001:l030","ordinal":51300,"en":"Fled toward the mountain, bounding."},{"id":"manas-2010:p1180:b001:l031","ordinal":51301,"en":"Almambet and Syrgak, the two lions,"},{"id":"manas-2010:p1180:b001:l032","ordinal":51302,"en":"Kept him from the mountain, beating him."},{"id":"manas-2010:p1180:b001:l033","ordinal":51303,"en":"In Beijing there was no other like Malgun."},{"id":"manas-2010:p1180:b001:l034","ordinal":51304,"en":"Though a spear thrust, it could not pierce him;"},{"id":"manas-2010:p1180:b001:l035","ordinal":51305,"en":"Though a sword swung, it could not cut him."},{"id":"manas-2010:p1180:b001:l036","ordinal":51306,"en":"If he truly ran in flight,"},{"id":"manas-2010:p1180:b001:l037","ordinal":51307,"en":"The two swift horses could not catch him."},{"id":"manas-2010:p1180:b001:l038","ordinal":51308,"en":"Even if Baltay struck, he could not pierce him."},{"id":"manas-2010:p1180:b001:l039","ordinal":51309,"en":"How could they hold back from the infidel?"},{"id":"manas-2010:p1180:b001:l040","ordinal":51310,"en":"Taking Malgun between them,"},{"id":"manas-2010:p1180:b001:l041","ordinal":51311,"en":"They beat him for six days,"},{"id":"manas-2010:p1180:b001:l042","ordinal":51312,"en":"Unable to kill Malgun,"},{"id":"manas-2010:p1181:b001:l001","ordinal":51313,"en":"The two fierce heroes grew weary."},{"id":"manas-2010:p1181:b001:l002","ordinal":51314,"en":"The time of death had come."},{"id":"manas-2010:p1181:b001:l003","ordinal":51315,"en":"Bounding up once more,"},{"id":"manas-2010:p1181:b001:l004","ordinal":51316,"en":"Young Syrgak was beside him."},{"id":"manas-2010:p1181:b001:l005","ordinal":51317,"en":"Upon reaching him, hero Syrgak"},{"id":"manas-2010:p1181:b001:l006","ordinal":51318,"en":"The helmet on his head"},{"id":"manas-2010:p1181:b001:l007","ordinal":51319,"en":"Knocked flying as he passed."},{"id":"manas-2010:p1181:b001:l008","ordinal":51320,"en":"The precious, specially forged steel,"},{"id":"manas-2010:p1181:b001:l009","ordinal":51321,"en":"Azizkan's only son"},{"id":"manas-2010:p1181:b001:l010","ordinal":51322,"en":"Firmly took in hand."},{"id":"manas-2010:p1181:b001:l011","ordinal":51323,"en":"Angling his stroke at Malgun,"},{"id":"manas-2010:p1181:b001:l012","ordinal":51324,"en":"He swung at his head."},{"id":"manas-2010:p1181:b001:l013","ordinal":51325,"en":"He bloodied him for a handspan."},{"id":"manas-2010:p1181:b001:l014","ordinal":51326,"en":"When Almambet struck once,"},{"id":"manas-2010:p1181:b001:l015","ordinal":51327,"en":"After slaughtering Great Malgun,"},{"id":"manas-2010:p1181:b001:l016","ordinal":51328,"en":"There was no lion like Almambet."},{"id":"manas-2010:p1181:b001:l017","ordinal":51329,"en":"Piercing Malgun through the lip,"},{"id":"manas-2010:p1181:b001:l018","ordinal":51330,"en":"When he loaded it onto the horse,"},{"id":"manas-2010:p1181:b001:l019","ordinal":51331,"en":"Even Malgun's head alone,"},{"id":"manas-2010:p1181:b001:l020","ordinal":51332,"en":"Dear Syrgak could not counterbalance."},{"id":"manas-2010:p1181:b001:l021","ordinal":51333,"en":"If the infidel still had his mule,"},{"id":"manas-2010:p1181:b001:l022","ordinal":51334,"en":"To match him in the world,"},{"id":"manas-2010:p1181:b001:l023","ordinal":51335,"en":"There was no hero among humankind."},{"id":"manas-2010:p1181:b001:l024","ordinal":51336,"en":"Azizkan's only son—"},{"id":"manas-2010:p1181:b001:l025","ordinal":51337,"en":"Beijing, which had girded itself—"},{"id":"manas-2010:p1181:b001:l026","ordinal":51338,"en":"The lion slaughtered wherever he advanced."},{"id":"manas-2010:p1181:b001:l027","ordinal":51339,"en":"With Great Malgun foremost,"},{"id":"manas-2010:p1181:b001:l028","ordinal":51340,"en":"This was where he slaughtered forty monks."},{"id":"manas-2010:p1181:b001:l029","ordinal":51341,"en":"At this time, Great Beijing"},{"id":"manas-2010:p1181:b001:l030","ordinal":51342,"en":"Concerned itself with nothing."},{"id":"manas-2010:p1181:b001:l031","ordinal":51343,"en":"Beyond this, at Beijing's"},{"id":"manas-2010:p1181:b001:l032","ordinal":51344,"en":"Watchpost, no one remained."},{"id":"manas-2010:p1181:b001:l033","ordinal":51345,"en":"'My precious Syrgak,"},{"id":"manas-2010:p1181:b001:l034","ordinal":51346,"en":"We shall scatter the Chinese people's many horses."},{"id":"manas-2010:p1181:b001:l035","ordinal":51347,"en":"Now, if we travel for two days,"},{"id":"manas-2010:p1181:b001:l036","ordinal":51348,"en":"We shall cross the ridge of It-Ölbös."},{"id":"manas-2010:p1181:b001:l037","ordinal":51349,"en":"Where the land slopes down, the huge woman,"},{"id":"manas-2010:p1181:b001:l038","ordinal":51350,"en":"We shall enter Kanyshay's people's land."},{"id":"manas-2010:p1181:b001:l039","ordinal":51351,"en":"If we find a way against the woman,"},{"id":"manas-2010:p1181:b001:l040","ordinal":51352,"en":"We shall contrive to slaughter her."},{"id":"manas-2010:p1181:b001:l041","ordinal":51353,"en":"If we blunder and arouse suspicion,"},{"id":"manas-2010:p1181:b001:l042","ordinal":51354,"en":"We shall become the woman's prisoners."},{"id":"manas-2010:p1182:b001:l001","ordinal":51355,"en":"At the mouth of the entrance,"},{"id":"manas-2010:p1182:b001:l002","ordinal":51356,"en":"There is a tent built of gold."},{"id":"manas-2010:p1182:b001:l003","ordinal":51357,"en":"Inside that tent,"},{"id":"manas-2010:p1182:b001:l004","ordinal":51358,"en":"Bozkertik and Muzkindik,"},{"id":"manas-2010:p1182:b001:l005","ordinal":51359,"en":"There are two paired heroes."},{"id":"manas-2010:p1182:b001:l006","ordinal":51360,"en":"In the dense, tangled forest,"},{"id":"manas-2010:p1182:b001:l007","ordinal":51361,"en":"There is a path for a single horse."},{"id":"manas-2010:p1182:b001:l008","ordinal":51362,"en":"Whatever the time, whatever the day,"},{"id":"manas-2010:p1182:b001:l009","ordinal":51363,"en":"My dear Syrgak,"},{"id":"manas-2010:p1182:b001:l010","ordinal":51364,"en":"They have a mighty one named Kanzharkol."},{"id":"manas-2010:p1182:b001:l011","ordinal":51365,"en":"Without arousing suspicion,"},{"id":"manas-2010:p1182:b001:l012","ordinal":51366,"en":"If we destroy them all alike,"},{"id":"manas-2010:p1182:b001:l013","ordinal":51367,"en":"We shall scatter the Chinese road."},{"id":"manas-2010:p1182:b001:l014","ordinal":51368,"en":"We shall open the Kyrgyz road."},{"id":"manas-2010:p1182:b001:l015","ordinal":51369,"en":"Esenkan in Beijing,"},{"id":"manas-2010:p1182:b001:l016","ordinal":51370,"en":"And his daughter Burulcha,"},{"id":"manas-2010:p1182:b001:l017","ordinal":51371,"en":"We shall meet and return—"},{"id":"manas-2010:p1182:b001:l018","ordinal":51372,"en":"(If my Syrgak remains safe.)"},{"id":"manas-2010:p1182:b001:l019","ordinal":51373,"en":"If we arouse suspicion, my Syrgak,"},{"id":"manas-2010:p1182:b001:l020","ordinal":51374,"en":"A thousand of Kanzharkol's men"},{"id":"manas-2010:p1182:b001:l021","ordinal":51375,"en":"Will prepare, saying, “I shall capture them.”"},{"id":"manas-2010:p1182:b001:l022","ordinal":51376,"en":"This too is Beijing's watchpost."},{"id":"manas-2010:p1182:b001:l023","ordinal":51377,"en":"If we arouse suspicion, my Syrgak,"},{"id":"manas-2010:p1182:b001:l024","ordinal":51378,"en":"With their huge woman at their head,"},{"id":"manas-2010:p1182:b001:l025","ordinal":51379,"en":"They will crowd upon the two of us."},{"id":"manas-2010:p1182:b001:l026","ordinal":51380,"en":"How many times shall I tell this?"},{"id":"manas-2010:p1182:b001:l027","ordinal":51381,"en":"This is their fortified ridge."},{"id":"manas-2010:p1182:b001:l028","ordinal":51382,"en":"Firmly trusting it, Karykan"},{"id":"manas-2010:p1182:b001:l029","ordinal":51383,"en":"Has girded himself upon this place."},{"id":"manas-2010:p1182:b001:l031","ordinal":51384,"en":"These are the executioner Chinese people.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p1182:b001:l032","ordinal":51385,"en":"Knowing the worth of the Chinese,"},{"id":"manas-2010:p1182:b001:l033","ordinal":51386,"en":"I am the one who has seen so many."},{"id":"manas-2010:p1182:b001:l034","ordinal":51387,"en":"Those you could ride upon and raid"},{"id":"manas-2010:p1182:b001:l035","ordinal":51388,"en":"Were the cities of Margalang and Bukhara."},{"id":"manas-2010:p1182:b001:l036","ordinal":51389,"en":"Those you could slaughter without looking back"},{"id":"manas-2010:p1182:b001:l037","ordinal":51390,"en":"Were the people of the Kyzylbash."},{"id":"manas-2010:p1182:b001:l038","ordinal":51391,"en":"To rage and say, “Chinese!”"},{"id":"manas-2010:p1182:b001:l039","ordinal":51392,"en":"And attack without looking back,"},{"id":"manas-2010:p1182:b001:l040","ordinal":51393,"en":"I, your Alma, am no bastard fool."},{"id":"manas-2010:p1182:b001:l041","ordinal":51394,"en":"From the formidable Chinese of Beijing,"},{"id":"manas-2010:p1182:b001:l042","ordinal":51395,"en":"These are no people from whom to return unharmed.'"},{"id":"manas-2010:p1183:b001:l001","ordinal":51396,"en":"Saying this, Almambet"},{"id":"manas-2010:p1183:b001:l002","ordinal":51397,"en":"Muttered and gathered his force."},{"id":"manas-2010:p1183:b001:l003","ordinal":51398,"en":"If you watched his appearance,"},{"id":"manas-2010:p1183:b001:l004","ordinal":51399,"en":"It changed in so many ways."},{"id":"manas-2010:p1183:b001:l005","ordinal":51400,"en":"When they entered the narrow ledge,"},{"id":"manas-2010:p1183:b001:l006","ordinal":51401,"en":"Looking very carefully,"},{"id":"manas-2010:p1183:b001:l007","ordinal":51402,"en":"A black-spotted leopard"},{"id":"manas-2010:p1183:b001:l008","ordinal":51403,"en":"Charged along his flank."},{"id":"manas-2010:p1183:b001:l009","ordinal":51404,"en":"Your leopard-champion Alma's"},{"id":"manas-2010:p1183:b001:l010","ordinal":51405,"en":"Protector was this creature."},{"id":"manas-2010:p1183:b001:l011","ordinal":51406,"en":"Along the winding road,"},{"id":"manas-2010:p1183:b001:l012","ordinal":51407,"en":"When they turned and went,"},{"id":"manas-2010:p1183:b001:l013","ordinal":51408,"en":"At one glance toward your Alma,"},{"id":"manas-2010:p1183:b001:l014","ordinal":51409,"en":"A lion with a whip-like tail,"},{"id":"manas-2010:p1183:b001:l015","ordinal":51410,"en":"Raging and charging,"},{"id":"manas-2010:p1183:b001:l016","ordinal":51411,"en":"Had also come."},{"id":"manas-2010:p1183:b001:l017","ordinal":51412,"en":"At another glance toward your Alma,"},{"id":"manas-2010:p1183:b001:l018","ordinal":51413,"en":"Forty spearmen, forty-one beings,"},{"id":"manas-2010:p1183:b001:l019","ordinal":51414,"en":"Had surrounded him."},{"id":"manas-2010:p1183:b001:l020","ordinal":51415,"en":"Into Zhangyryk's Zhar-Kyya,"},{"id":"manas-2010:p1183:b001:l021","ordinal":51416,"en":"When they had just entered,"},{"id":"manas-2010:p1183:b001:l022","ordinal":51417,"en":"A dragon six fathoms long,"},{"id":"manas-2010:p1183:b001:l023","ordinal":51418,"en":"Fire coming from its mouth,"},{"id":"manas-2010:p1183:b001:l024","ordinal":51419,"en":"Lumbering behind him,"},{"id":"manas-2010:p1183:b001:l025","ordinal":51420,"en":"Had joined their journey."},{"id":"manas-2010:p1183:b001:l026","ordinal":51421,"en":"When he looked yet again,"},{"id":"manas-2010:p1183:b001:l027","ordinal":51422,"en":"A mighty black bird, looming,"},{"id":"manas-2010:p1183:b001:l028","ordinal":51423,"en":"Stretching out its splayed claws,"},{"id":"manas-2010:p1183:b001:l029","ordinal":51424,"en":"As though it would snatch Almambet,"},{"id":"manas-2010:p1183:b001:l030","ordinal":51425,"en":"Had drawn near."},{"id":"manas-2010:p1183:b001:l031","ordinal":51426,"en":"(Much is false, much is true;"},{"id":"manas-2010:p1183:b001:l032","ordinal":51427,"en":"No person has come who saw it."},{"id":"manas-2010:p1183:b001:l033","ordinal":51428,"en":"One part is false, one part is true;"},{"id":"manas-2010:p1183:b001:l034","ordinal":51429,"en":"No person has come who knows it."},{"id":"manas-2010:p1183:b001:l035","ordinal":51430,"en":"From the people of old, to us,"},{"id":"manas-2010:p1183:b001:l036","ordinal":51431,"en":"This tale has come down."},{"id":"manas-2010:p1183:b001:l037","ordinal":51432,"en":"Since their time it has turned over—"},{"id":"manas-2010:p1183:b001:l038","ordinal":51433,"en":"This immense, wayward world, alas.)"},{"id":"manas-2010:p1183:b001:l039","ordinal":51434,"en":"They journeyed toward Beijing."},{"id":"manas-2010:p1183:b001:l040","ordinal":51435,"en":"They traveled far along the road."},{"id":"manas-2010:p1183:b001:l041","ordinal":51436,"en":"Sarala beneath him,"},{"id":"manas-2010:p1183:b001:l042","ordinal":51437,"en":"Though he wished to tell, had no speech."},{"id":"manas-2010:p1184:b001:l001","ordinal":51438,"en":"The many curving ridges,"},{"id":"manas-2010:p1184:b001:l002","ordinal":51439,"en":"When he saw where he had crossed them,"},{"id":"manas-2010:p1184:b001:l003","ordinal":51440,"en":"From foalhood, frolicking,"},{"id":"manas-2010:p1184:b001:l004","ordinal":51441,"en":"When he saw where he had trodden,"},{"id":"manas-2010:p1184:b001:l005","ordinal":51442,"en":"He flung his forelock toward the sky,"},{"id":"manas-2010:p1184:b001:l006","ordinal":51443,"en":"He drove his hooves into the earth."},{"id":"manas-2010:p1184:b001:l007","ordinal":51444,"en":"The black steel bit"},{"id":"manas-2010:p1184:b001:l008","ordinal":51445,"en":"He struck against his throat."},{"id":"manas-2010:p1184:b001:l009","ordinal":51446,"en":"As though he would roll upon the ground,"},{"id":"manas-2010:p1184:b001:l010","ordinal":51447,"en":"His tail like a strand of silk"},{"id":"manas-2010:p1184:b001:l011","ordinal":51448,"en":"He slapped against his thighs."},{"id":"manas-2010:p1184:b001:l012","ordinal":51449,"en":"The hilltop's pale, curved ridge,"},{"id":"manas-2010:p1184:b001:l013","ordinal":51450,"en":"Sarala went along seeing it."},{"id":"manas-2010:p1184:b001:l014","ordinal":51451,"en":"Whinnying and pawing the ground,"},{"id":"manas-2010:p1184:b001:l015","ordinal":51452,"en":"Sarala went onward."},{"id":"manas-2010:p1184:b001:l016","ordinal":51453,"en":"When he traveled swiftly,"},{"id":"manas-2010:p1184:b001:l017","ordinal":51454,"en":"Sarala, the accomplished steed,"},{"id":"manas-2010:p1184:b001:l018","ordinal":51455,"en":"No wind could match his trot,"},{"id":"manas-2010:p1184:b001:l019","ordinal":51456,"en":"No beast could match his walk."}]
