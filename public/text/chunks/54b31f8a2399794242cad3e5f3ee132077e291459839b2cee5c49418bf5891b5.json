[{"id":"semetey-1-2013:p0714:b004:l009","ordinal":131073,"en":"Driving their great army onward,"},{"id":"semetey-1-2013:p0714:b004:l010","ordinal":131074,"en":"They spread them like ants."},{"id":"semetey-1-2013:p0714:b004:l012","ordinal":131075,"en":"Myriad livestock collected as tax,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0714:b004:l013","ordinal":131076,"en":"They had driven along for provisions."},{"id":"semetey-1-2013:p0714:b004:l014","ordinal":131077,"en":"The red banner with its golden crescent,"},{"id":"semetey-1-2013:p0714:b004:l015","ordinal":131078,"en":"Shouts and tumult resounded."},{"id":"semetey-1-2013:p0714:b004:l016","ordinal":131079,"en":"“Against the dark-hearted Burut,"},{"id":"semetey-1-2013:p0714:b004:l017","ordinal":131080,"en":"I shall march and wage war,” he said."},{"id":"semetey-1-2013:p0714:b004:l018","ordinal":131081,"en":"“The great strife that will not heal,"},{"id":"semetey-1-2013:p0714:b004:l019","ordinal":131082,"en":"The heavy blood-price for Alooke,"},{"id":"semetey-1-2013:p0714:b004:l020","ordinal":131083,"en":"I shall go and take from the Burut,” he said."},{"id":"semetey-1-2013:p0714:b004:l021","ordinal":131084,"en":"“A red sash made in Beijing,"},{"id":"semetey-1-2013:p0714:b004:l022","ordinal":131085,"en":"I shall bind firmly round my waist,” he said."},{"id":"semetey-1-2013:p0714:b004:l023","ordinal":131086,"en":"“I shall seek the blood-price for my father Alooke,” he said."},{"id":"semetey-1-2013:p0714:b004:l024","ordinal":131087,"en":"The forty Chinese tribes, a formidable people,"},{"id":"semetey-1-2013:p0714:b004:l025","ordinal":131088,"en":"They drove onward at the fitting moment."},{"id":"semetey-1-2013:p0714:b004:l026","ordinal":131089,"en":"The Chinese wearing jackets,"},{"id":"semetey-1-2013:p0714:b004:l027","ordinal":131090,"en":"Their strongest they drove along together."},{"id":"semetey-1-2013:p0714:b004:l028","ordinal":131091,"en":"When the Kara Chinese and Manchu people"},{"id":"semetey-1-2013:p0714:b004:l029","ordinal":131092,"en":"Swept down upon us,"},{"id":"semetey-1-2013:p0714:b004:l030","ordinal":131093,"en":"When they wrought devastation,"},{"id":"semetey-1-2013:p0714:b004:l031","ordinal":131094,"en":"Kardygach, standing lookout,"},{"id":"semetey-1-2013:p0714:b004:l032","ordinal":131095,"en":"Alone caught sight of them."},{"id":"semetey-1-2013:p0714:b004:l033","ordinal":131096,"en":"Taking the sword Zulpukor in hand,"},{"id":"semetey-1-2013:p0714:b004:l034","ordinal":131097,"en":"Striking Telkyzyl once,"},{"id":"semetey-1-2013:p0714:b004:l035","ordinal":131098,"en":"Into the Chinese covering the earth"},{"id":"semetey-1-2013:p0714:b004:l036","ordinal":131099,"en":"She entered alone and attacked their army."},{"id":"semetey-1-2013:p0714:b004:l037","ordinal":131100,"en":"When Kardygach endured that hell,"},{"id":"semetey-1-2013:p0714:b004:l038","ordinal":131101,"en":"Here, telling of it,"},{"id":"semetey-1-2013:p0714:b004:l039","ordinal":131102,"en":"Khan Bakai had these words."},{"id":"semetey-1-2013:p0715:b003:l001","ordinal":131103,"en":"Kyrgylchal, head of the forty,"},{"id":"semetey-1-2013:p0715:b003:l002","ordinal":131104,"en":"The mad old man, swollen with pride among the forty,"},{"id":"semetey-1-2013:p0715:b003:l003","ordinal":131105,"en":"The bald old man with a scanty beard,"},{"id":"semetey-1-2013:p0715:b003:l004","ordinal":131106,"en":"The infidel old man born for mischief,"},{"id":"semetey-1-2013:p0715:b003:l005","ordinal":131107,"en":"Who devised a thousand wicked schemes—"},{"id":"semetey-1-2013:p0715:b003:l006","ordinal":131108,"en":"Though he was ruining everything,"},{"id":"semetey-1-2013:p0715:b003:l007","ordinal":131109,"en":"Courser Manas, the leopard,"},{"id":"semetey-1-2013:p0715:b003:l008","ordinal":131110,"en":"Never said, ‘He has wrought mischief.’"},{"id":"semetey-1-2013:p0715:b003:l009","ordinal":131111,"en":"Following in his footsteps,"},{"id":"semetey-1-2013:p0715:b003:l010","ordinal":131112,"en":"Slandering him with hellish malice,"},{"id":"semetey-1-2013:p0715:b003:l011","ordinal":131113,"en":"He had words that men would believe,"},{"id":"semetey-1-2013:p0715:b003:l012","ordinal":131114,"en":"He had ways fit for hell."},{"id":"semetey-1-2013:p0715:b003:l013","ordinal":131115,"en":"Your mountain-like father, Khan Manas,"},{"id":"semetey-1-2013:p0715:b003:l014","ordinal":131116,"en":"Had been led astray by him."},{"id":"semetey-1-2013:p0715:b003:l015","ordinal":131117,"en":"Kyrgyl said this to your father,"},{"id":"semetey-1-2013:p0715:b003:l016","ordinal":131118,"en":"Spoke of horrors no man knew."},{"id":"semetey-1-2013:p0715:b003:l017","ordinal":131119,"en":"These were Kyrgyl's words;"},{"id":"semetey-1-2013:p0715:b003:l018","ordinal":131120,"en":"Your father, gone to the next world,"},{"id":"semetey-1-2013:p0715:b003:l019","ordinal":131121,"en":"Was led astray in this way:"},{"id":"semetey-1-2013:p0715:b003:l020","ordinal":131122,"en":"‘Manas, blessed by Khizir, hear my words!"},{"id":"semetey-1-2013:p0715:b003:l021","ordinal":131123,"en":"Your countless beasts upon the hills"},{"id":"semetey-1-2013:p0715:b003:l022","ordinal":131124,"en":"Are no coursers, after all."},{"id":"semetey-1-2013:p0715:b003:l023","ordinal":131125,"en":"You became friends for the next world—"},{"id":"semetey-1-2013:p0715:b003:l024","ordinal":131126,"en":"Akbaltai's Chubak,"},{"id":"semetey-1-2013:p0715:b003:l025","ordinal":131127,"en":"That malicious wretch,"},{"id":"semetey-1-2013:p0715:b003:l026","ordinal":131128,"en":"Is no kinsman, after all."},{"id":"semetey-1-2013:p0715:b003:l027","ordinal":131129,"en":"Cherish an ass for nine years,"},{"id":"semetey-1-2013:p0715:b003:l028","ordinal":131130,"en":"It will never become a courser."},{"id":"semetey-1-2013:p0715:b003:l029","ordinal":131131,"en":"Akbaltai's bastard Chubak,"},{"id":"semetey-1-2013:p0715:b003:l030","ordinal":131132,"en":"That wretch born of a daughter,"},{"id":"semetey-1-2013:p0715:b003:l031","ordinal":131133,"en":"Will never become your kinsman."},{"id":"semetey-1-2013:p0715:b003:l032","ordinal":131134,"en":"White wheat sown on a ridge"},{"id":"semetey-1-2013:p0715:b003:l033","ordinal":131135,"en":"Is no crop, after all."},{"id":"semetey-1-2013:p0715:b003:l034","ordinal":131136,"en":"Kanykei and your Chubak"},{"id":"semetey-1-2013:p0715:b003:l035","ordinal":131137,"en":"Are not innocent, after all."},{"id":"semetey-1-2013:p0715:b003:l036","ordinal":131138,"en":"The valleys of this Talas"},{"id":"semetey-1-2013:p0715:b003:l037","ordinal":131139,"en":"Will never become ravines, after all."},{"id":"semetey-1-2013:p0715:b003:l038","ordinal":131140,"en":"Kanykei and this Chubak"},{"id":"semetey-1-2013:p0715:b003:l039","ordinal":131141,"en":"Are not innocent, after all."},{"id":"semetey-1-2013:p0715:b005:l001","ordinal":131142,"en":"When the people move toward Kan-Jailoo,"},{"id":"semetey-1-2013:p0715:b005:l002","ordinal":131143,"en":"They dismount without a care."},{"id":"semetey-1-2013:p0715:b005:l003","ordinal":131144,"en":"On the migration they drink liquor,"},{"id":"semetey-1-2013:p0715:b005:l004","ordinal":131145,"en":"Drinking it openly."},{"id":"semetey-1-2013:p0715:b005:l005","ordinal":131146,"en":"Lord Manas the sultan—"},{"id":"semetey-1-2013:p0715:b005:l006","ordinal":131147,"en":"Can one who treads his bed prosper?"},{"id":"semetey-1-2013:p0715:b005:l007","ordinal":131148,"en":"If sickness truly strikes his head,"},{"id":"semetey-1-2013:p0715:b005:l008","ordinal":131149,"en":"Will raving Chubak rise again?"},{"id":"semetey-1-2013:p0715:b005:l009","ordinal":131150,"en":"Blessed Manas, the fierce one—"},{"id":"semetey-1-2013:p0715:b005:l010","ordinal":131151,"en":"Can one who treads his pillow prosper?"},{"id":"semetey-1-2013:p0715:b005:l011","ordinal":131152,"en":"False-swearing Chubak, that half-Sart—"},{"id":"semetey-1-2013:p0715:b005:l012","ordinal":131153,"en":"Will he rise when it strikes his soul?’"},{"id":"semetey-1-2013:p0715:b005:l013","ordinal":131154,"en":"Speaking such words,"},{"id":"semetey-1-2013:p0715:b005:l014","ordinal":131155,"en":"He turned truthful words into a curse."},{"id":"semetey-1-2013:p0715:b005:l015","ordinal":131156,"en":"The words Kyrgyl spoke—"},{"id":"semetey-1-2013:p0715:b005:l016","ordinal":131157,"en":"Your khan father, gone to the next world,"},{"id":"semetey-1-2013:p0715:b005:l017","ordinal":131158,"en":"Believed them wholly."},{"id":"semetey-1-2013:p0715:b005:l018","ordinal":131159,"en":"Leopard Chubak was shamed;"},{"id":"semetey-1-2013:p0715:b005:l019","ordinal":131160,"en":"Hearing them, he was distressed."},{"id":"semetey-1-2013:p0715:b005:l020","ordinal":131161,"en":"‘Kanykei was my mother!"},{"id":"semetey-1-2013:p0715:b005:l021","ordinal":131162,"en":"Could I prosper if I took advantage of her?"},{"id":"semetey-1-2013:p0715:b005:l022","ordinal":131163,"en":"With the noble khan, wretched me,"},{"id":"semetey-1-2013:p0715:b005:l023","ordinal":131164,"en":"I was a friend for the next world."},{"id":"semetey-1-2013:p0715:b005:l024","ordinal":131165,"en":"Could I prosper if I pissed upon that oath?’"},{"id":"semetey-1-2013:p0715:b005:l025","ordinal":131166,"en":"So saying, he blazed with anger."},{"id":"semetey-1-2013:p0715:b005:l026","ordinal":131167,"en":"Chubak took offense and felt aggrieved."},{"id":"semetey-1-2013:p0715:b005:l027","ordinal":131168,"en":"Countless treasures, gold and riches—"},{"id":"semetey-1-2013:p0715:b005:l028","ordinal":131169,"en":"Chubak scattered them all abroad."},{"id":"semetey-1-2013:p0715:b005:l029","ordinal":131170,"en":"To Chong-Alai of broad Kashgar,"},{"id":"semetey-1-2013:p0715:b005:l030","ordinal":131171,"en":"Chubak fled in proud defiance."},{"id":"semetey-1-2013:p0715:b005:l031","ordinal":131172,"en":"With cotton sash and roomy boots—"},{"id":"semetey-1-2013:p0715:b005:l032","ordinal":131173,"en":"To the Kalcha, the monks' khan,"},{"id":"semetey-1-2013:p0715:b005:l033","ordinal":131174,"en":"Khan Akbaltai's warrior Chubak"},{"id":"semetey-1-2013:p0715:b005:l034","ordinal":131175,"en":"Gave six swift horses,"},{"id":"semetey-1-2013:p0715:b005:l035","ordinal":131176,"en":"Gave a letter the size of a palm:"},{"id":"semetey-1-2013:p0715:b005:l036","ordinal":131177,"en":"‘Fortunate Lord Manas"},{"id":"semetey-1-2013:p0715:b005:l037","ordinal":131178,"en":"God has taken, leaving him stretched out;"},{"id":"semetey-1-2013:p0715:b005:l038","ordinal":131179,"en":"The companions who supported him"},{"id":"semetey-1-2013:p0715:b005:l039","ordinal":131180,"en":"Have left his side,’ he said."},{"id":"semetey-1-2013:p0716:b003:l001","ordinal":131181,"en":"The heart of Talas had become a ravine;"},{"id":"semetey-1-2013:p0716:b003:l002","ordinal":131182,"en":"Trusted Chubak had become an enemy."},{"id":"semetey-1-2013:p0716:b003:l003","ordinal":131183,"en":"To Beijing of the khakan khan,"},{"id":"semetey-1-2013:p0716:b003:l004","ordinal":131184,"en":"Chubak's letter had arrived."},{"id":"semetey-1-2013:p0716:b003:l005","ordinal":131185,"en":"To avenge Alooke,"},{"id":"semetey-1-2013:p0716:b003:l006","ordinal":131186,"en":"With Khan Kongurbai at their head,"},{"id":"semetey-1-2013:p0716:b003:l007","ordinal":131187,"en":"The forty Chinese tribes set out."},{"id":"semetey-1-2013:p0716:b003:l008","ordinal":131188,"en":"Kyrgyl, head of the forty—"},{"id":"semetey-1-2013:p0716:b003:l009","ordinal":131189,"en":"When God Almighty took him,"},{"id":"semetey-1-2013:p0716:b003:l010","ordinal":131190,"en":"Your precious mother Kanykei"},{"id":"semetey-1-2013:p0716:b003:l011","ordinal":131191,"en":"Had been neglected for six months."},{"id":"semetey-1-2013:p0716:b003:l012","ordinal":131192,"en":"In a mountainside hollow of great Talas,"},{"id":"semetey-1-2013:p0716:b003:l013","ordinal":131193,"en":"Your great lord father, warrior Khan Manas,"},{"id":"semetey-1-2013:p0716:b003:l014","ordinal":131194,"en":"Was sleeping with Akylai."},{"id":"semetey-1-2013:p0716:b003:l015","ordinal":131195,"en":"Feeling shame, saying nothing,"},{"id":"semetey-1-2013:p0716:b003:l016","ordinal":131196,"en":"Unfortunate Kanykei suffered torment."},{"id":"semetey-1-2013:p0716:b003:l017","ordinal":131197,"en":"Neglected Kanykei"},{"id":"semetey-1-2013:p0716:b003:l018","ordinal":131198,"en":"Summered at Jilgynduu."},{"id":"semetey-1-2013:p0716:b003:l019","ordinal":131199,"en":"Akkula and Akolpok,"},{"id":"semetey-1-2013:p0716:b003:l020","ordinal":131200,"en":"She made them both ready together."},{"id":"semetey-1-2013:p0716:b003:l021","ordinal":131201,"en":"In those days, in Kara-Buura and Chatkal,"},{"id":"semetey-1-2013:p0716:b003:l022","ordinal":131202,"en":"Lying at ease without sorrow,"},{"id":"semetey-1-2013:p0716:b003:l023","ordinal":131203,"en":"The multitude of Kyrgyz lay encamped."},{"id":"semetey-1-2013:p0716:b003:l024","ordinal":131204,"en":"Dusk fell, the sun set;"},{"id":"semetey-1-2013:p0716:b003:l025","ordinal":131205,"en":"The earliest sleepers had all lain down."},{"id":"semetey-1-2013:p0716:b003:l026","ordinal":131206,"en":"Gray-mottled pennants, a red banner,"},{"id":"semetey-1-2013:p0716:b003:l027","ordinal":131207,"en":"Cries of ‘Alas!’ and great uproar;"},{"id":"semetey-1-2013:p0716:b003:l028","ordinal":131208,"en":"White standards, a black banner,"},{"id":"semetey-1-2013:p0716:b003:l029","ordinal":131209,"en":"Battle cries and great uproar."},{"id":"semetey-1-2013:p0716:b003:l030","ordinal":131210,"en":"Stars slanted down, breaking from the sky."},{"id":"semetey-1-2013:p0716:b003:l031","ordinal":131211,"en":"All manner of shouts—"},{"id":"semetey-1-2013:p0716:b003:l032","ordinal":131212,"en":"They seemed to be Chinese voices."},{"id":"semetey-1-2013:p0716:b003:l033","ordinal":131213,"en":"Swarming like black worms,"},{"id":"semetey-1-2013:p0716:b003:l034","ordinal":131214,"en":"The Kalmyk army surged;"},{"id":"semetey-1-2013:p0716:b003:l035","ordinal":131215,"en":"The jangjung's army closed in."},{"id":"semetey-1-2013:p0716:b003:l036","ordinal":131216,"en":"Kongurbai, the monks' khan,"},{"id":"semetey-1-2013:p0716:b003:l037","ordinal":131217,"en":"Had prepared ahead of them."},{"id":"semetey-1-2013:p0716:b003:l038","ordinal":131218,"en":"Upon the Kyrgyz of four tribes"},{"id":"semetey-1-2013:p0716:b003:l039","ordinal":131219,"en":"He descended from above."},{"id":"semetey-1-2013:p0716:b004:l001","ordinal":131220,"en":"Barefoot and bareheaded,"},{"id":"semetey-1-2013:p0716:b004:l002","ordinal":131221,"en":"Taking a tent pole in his hand,"},{"id":"semetey-1-2013:p0716:b004:l003","ordinal":131222,"en":"Your lord father Manas was in haste."},{"id":"semetey-1-2013:p0716:b004:l004","ordinal":131223,"en":"Then the lord's wife Kanykei,"},{"id":"semetey-1-2013:p0716:b004:l005","ordinal":131224,"en":"That tormented, fiery, luckless woman,"},{"id":"semetey-1-2013:p0716:b004:l006","ordinal":131225,"en":"Showed her valor."},{"id":"semetey-1-2013:p0716:b004:l007","ordinal":131226,"en":"Akkula and Akolpok—"},{"id":"semetey-1-2013:p0716:b004:l008","ordinal":131227,"en":"She mounted your father,"},{"id":"semetey-1-2013:p0716:b004:l009","ordinal":131228,"en":"And all his weapons"},{"id":"semetey-1-2013:p0716:b004:l010","ordinal":131229,"en":"She gave into your father's keeping,"},{"id":"semetey-1-2013:p0716:b004:l011","ordinal":131230,"en":"Sending him thus against the Chinese."},{"id":"semetey-1-2013:p0716:b004:l012","ordinal":131231,"en":"Blue haze broke from the sky;"},{"id":"semetey-1-2013:p0716:b004:l013","ordinal":131232,"en":"Sweeping forward on Kökala,"},{"id":"semetey-1-2013:p0716:b004:l014","ordinal":131233,"en":"Your fierce Chubak appeared."},{"id":"semetey-1-2013:p0716:b004:l015","ordinal":131234,"en":"Khan Bakai, the rich man's son,"},{"id":"semetey-1-2013:p0716:b004:l016","ordinal":131235,"en":"Your warrior elder was there too,"},{"id":"semetey-1-2013:p0716:b004:l017","ordinal":131236,"en":"And Ulak Khan's Syrgak,"},{"id":"semetey-1-2013:p0716:b004:l018","ordinal":131237,"en":"And your father, leopard Manas."},{"id":"semetey-1-2013:p0716:b004:l019","ordinal":131238,"en":"When these men wrought their deeds,"},{"id":"semetey-1-2013:p0716:b004:l020","ordinal":131239,"en":"The red banner of the Chinese—"},{"id":"semetey-1-2013:p0716:b004:l021","ordinal":131240,"en":"When my dear Chubak struck it,"},{"id":"semetey-1-2013:p0716:b004:l022","ordinal":131241,"en":"The infidels of another faith"},{"id":"semetey-1-2013:p0716:b004:l023","ordinal":131242,"en":"Hastened to draw back."},{"id":"semetey-1-2013:p0716:b004:l024","ordinal":131243,"en":"Your exceedingly fortunate father's"},{"id":"semetey-1-2013:p0716:b004:l025","ordinal":131244,"en":"Heat they could not endure;"},{"id":"semetey-1-2013:p0716:b004:l026","ordinal":131245,"en":"His strength they could not withstand."},{"id":"semetey-1-2013:p0716:b004:l027","ordinal":131246,"en":"The black Manchus, the many Sibe,"},{"id":"semetey-1-2013:p0716:b004:l028","ordinal":131247,"en":"Fled in headlong haste."},{"id":"semetey-1-2013:p0716:b004:l029","ordinal":131248,"en":"The Chinese banner fell;"},{"id":"semetey-1-2013:p0716:b004:l030","ordinal":131249,"en":"They fled toward Beijing."},{"id":"semetey-1-2013:p0716:b004:l031","ordinal":131250,"en":"The infidels, thick as black willows,"},{"id":"semetey-1-2013:p0716:b004:l032","ordinal":131251,"en":"They scattered toward Beijing."},{"id":"semetey-1-2013:p0716:b004:l033","ordinal":131252,"en":"With their teeth jutting out,"},{"id":"semetey-1-2013:p0716:b004:l034","ordinal":131253,"en":"Dead horses fell in mountains."},{"id":"semetey-1-2013:p0716:b004:l035","ordinal":131254,"en":"With their fine mustaches smoothed down,"},{"id":"semetey-1-2013:p0716:b004:l036","ordinal":131255,"en":"Dead warriors fell in heaps."},{"id":"semetey-1-2013:p0716:b004:l037","ordinal":131256,"en":"The black Chinese and Manchus—"},{"id":"semetey-1-2013:p0716:b004:l038","ordinal":131257,"en":"Their cries reached God."},{"id":"semetey-1-2013:p0716:b004:l039","ordinal":131258,"en":"All their spears"},{"id":"semetey-1-2013:p0717:b003:l001","ordinal":131259,"en":"Fell crisscross to the ground."},{"id":"semetey-1-2013:p0717:b003:l002","ordinal":131260,"en":"Against the forty Chinese tribes of Beijing,"},{"id":"semetey-1-2013:p0717:b003:l003","ordinal":131261,"en":"They wrought such deeds,"},{"id":"semetey-1-2013:p0717:b003:l004","ordinal":131262,"en":"And the handful of Muslims"},{"id":"semetey-1-2013:p0717:b003:l005","ordinal":131263,"en":"They rescued and set free."},{"id":"semetey-1-2013:p0717:b003:l006","ordinal":131264,"en":"The jacket-wearing Chinese—"},{"id":"semetey-1-2013:p0717:b003:l007","ordinal":131265,"en":"Their strongest they drove off and slew."},{"id":"semetey-1-2013:p0717:b003:l008","ordinal":131266,"en":"The stone-worshipping Chinese—"},{"id":"semetey-1-2013:p0717:b003:l009","ordinal":131267,"en":"Their bald ones they pursued."},{"id":"semetey-1-2013:p0717:b003:l010","ordinal":131268,"en":"Let us leave that aside,"},{"id":"semetey-1-2013:p0717:b003:l011","ordinal":131269,"en":"And lonely Kardygach in sorrow—"},{"id":"semetey-1-2013:p0717:b003:l012","ordinal":131270,"en":"Let us begin to tell of her."},{"id":"semetey-1-2013:p0717:b003:l013","ordinal":131271,"en":"Kardygach, born a leopard,"},{"id":"semetey-1-2013:p0717:b003:l014","ordinal":131272,"en":"Faced Kongurbai, the monks' khan,"},{"id":"semetey-1-2013:p0717:b003:l015","ordinal":131273,"en":"Standing against him."},{"id":"semetey-1-2013:p0717:b003:l016","ordinal":131274,"en":"Sparing not her precious life,"},{"id":"semetey-1-2013:p0717:b003:l017","ordinal":131275,"en":"At Alooke's Kongurbai,"},{"id":"semetey-1-2013:p0717:b003:l018","ordinal":131276,"en":"Kardygach standing there"},{"id":"semetey-1-2013:p0717:b003:l019","ordinal":131277,"en":"Charged and thrust her spear."},{"id":"semetey-1-2013:p0717:b003:l020","ordinal":131278,"en":"Alooke's Kongurbai"},{"id":"semetey-1-2013:p0717:b003:l021","ordinal":131279,"en":"Found himself at his wits' end."},{"id":"semetey-1-2013:p0717:b003:l022","ordinal":131280,"en":"Kongurbai's forty lords,"},{"id":"semetey-1-2013:p0717:b003:l023","ordinal":131281,"en":"The swaggering Kalcha,"},{"id":"semetey-1-2013:p0717:b003:l024","ordinal":131282,"en":"She had weakened them."},{"id":"semetey-1-2013:p0717:b003:l025","ordinal":131283,"en":"The giants of the Chinese,"},{"id":"semetey-1-2013:p0717:b003:l026","ordinal":131284,"en":"Warriors as numerous as ants,"},{"id":"semetey-1-2013:p0717:b003:l027","ordinal":131285,"en":"The infidels surrounded her."},{"id":"semetey-1-2013:p0717:b003:l028","ordinal":131286,"en":"May solitude perish!"},{"id":"semetey-1-2013:p0717:b003:l029","ordinal":131287,"en":"The infidels' treasury marksman,"},{"id":"semetey-1-2013:p0717:b003:l030","ordinal":131288,"en":"Karajoy, drew near."},{"id":"semetey-1-2013:p0717:b003:l031","ordinal":131289,"en":"Black-maned Boroonchu—"},{"id":"semetey-1-2013:p0717:b003:l032","ordinal":131290,"en":"When she speared Boroonchu,"},{"id":"semetey-1-2013:p0717:b003:l033","ordinal":131291,"en":"The girl met with misfortune."},{"id":"semetey-1-2013:p0717:b003:l034","ordinal":131292,"en":"Karajoy, standing close,"},{"id":"semetey-1-2013:p0717:b003:l035","ordinal":131293,"en":"Shot the horse Telkyzyl."},{"id":"semetey-1-2013:p0717:b003:l036","ordinal":131294,"en":"Shaking his head, Telkyzyl"},{"id":"semetey-1-2013:p0717:b003:l037","ordinal":131295,"en":"Collapsed and lay upon the ground."},{"id":"semetey-1-2013:p0717:b003:l038","ordinal":131296,"en":"Then Ylama, the Kalmyk wrestler—"},{"id":"semetey-1-2013:p0717:b003:l039","ordinal":131297,"en":"Ask not about that infidel!"},{"id":"semetey-1-2013:p0717:b004:l001","ordinal":131298,"en":"The girl caught in their hands"},{"id":"semetey-1-2013:p0717:b004:l002","ordinal":131299,"en":"They had surrounded."},{"id":"semetey-1-2013:p0717:b004:l003","ordinal":131300,"en":"Upon your unfortunate elder sister Kardygach"},{"id":"semetey-1-2013:p0717:b004:l004","ordinal":131301,"en":"They brought calamity."},{"id":"semetey-1-2013:p0717:b004:l005","ordinal":131302,"en":"Then those clad in iron-cord mail,"},{"id":"semetey-1-2013:p0717:b004:l006","ordinal":131303,"en":"All those with dagger-hands,"},{"id":"semetey-1-2013:p0717:b004:l007","ordinal":131304,"en":"Those skilled in casting lassos,"},{"id":"semetey-1-2013:p0717:b004:l008","ordinal":131305,"en":"The seething champions of the unbelievers—"},{"id":"semetey-1-2013:p0717:b004:l010","ordinal":131306,"en":"When the great army swept upon her,"},{"id":"semetey-1-2013:p0717:b004:l011","ordinal":131307,"en":"A jangjung who came near—"},{"id":"semetey-1-2013:p0717:b004:l012","ordinal":131308,"en":"She tore out his intestines."},{"id":"semetey-1-2013:p0717:b004:l013","ordinal":131309,"en":"Wherever her spear could reach,"},{"id":"semetey-1-2013:p0717:b004:l014","ordinal":131310,"en":"She sent them crawling with her spear."},{"id":"semetey-1-2013:p0717:b004:l015","ordinal":131311,"en":"Those who ventured close in eagerness,"},{"id":"semetey-1-2013:p0717:b004:l016","ordinal":131312,"en":"She felled with her sword."},{"id":"semetey-1-2013:p0717:b004:l017","ordinal":131313,"en":"Shedding the infidels' blood,"},{"id":"semetey-1-2013:p0717:b004:l018","ordinal":131314,"en":"The unfortunate one endured four days."},{"id":"semetey-1-2013:p0717:b004:l019","ordinal":131315,"en":"Furious and grieving,"},{"id":"semetey-1-2013:p0717:b004:l020","ordinal":131316,"en":"The steed she rode on campaign,"},{"id":"semetey-1-2013:p0717:b004:l021","ordinal":131317,"en":"Telkyzyl, she had lost."},{"id":"semetey-1-2013:p0717:b004:l022","ordinal":131318,"en":"Then dust covered her breast;"},{"id":"semetey-1-2013:p0717:b004:l023","ordinal":131319,"en":"Dark blood covered her eyes."},{"id":"semetey-1-2013:p0717:b004:l024","ordinal":131320,"en":"Her wits grew weak, her heart burned;"},{"id":"semetey-1-2013:p0717:b004:l025","ordinal":131321,"en":"Her strength failed, she sagged."},{"id":"semetey-1-2013:p0717:b004:l026","ordinal":131322,"en":"Both her arms hung loose;"},{"id":"semetey-1-2013:p0717:b004:l027","ordinal":131323,"en":"Both her eyes darted wildly."},{"id":"semetey-1-2013:p0717:b004:l028","ordinal":131324,"en":"She had no support to lean upon,"},{"id":"semetey-1-2013:p0717:b004:l029","ordinal":131325,"en":"No renowned lion Manas."},{"id":"semetey-1-2013:p0717:b004:l030","ordinal":131326,"en":"Seven wolves and a single sheep—"},{"id":"semetey-1-2013:p0717:b004:l031","ordinal":131327,"en":"My dear orphan, hear this—"},{"id":"semetey-1-2013:p0717:b004:l032","ordinal":131328,"en":"If they tear at it, will they leave its carcass?"}]
