[{"id":"semetey-1-2013:p0946:b003:l014","ordinal":149249,"en":"He summered in a hot place."},{"id":"semetey-1-2013:p0946:b003:l015","ordinal":149250,"en":"Whether walking or standing, at his waist"},{"id":"semetey-1-2013:p0946:b003:l016","ordinal":149251,"en":"He tied a flatbread as large as a hoe."},{"id":"semetey-1-2013:p0946:b003:l017","ordinal":149252,"en":"A great hoe shaped like a vulture's tail"},{"id":"semetey-1-2013:p0946:b003:l018","ordinal":149253,"en":"He carried over his back."},{"id":"semetey-1-2013:p0946:b003:l019","ordinal":149254,"en":"His shirt open, his chest bare,"},{"id":"semetey-1-2013:p0946:b003:l020","ordinal":149255,"en":"He was neither renowned nor a support,"},{"id":"semetey-1-2013:p0946:b003:l021","ordinal":149256,"en":"No man whom a mortal could trust as a champion"},{"id":"semetey-1-2013:p0946:b003:l022","ordinal":149257,"en":"And take as a husband."},{"id":"semetey-1-2013:p0946:b003:l023","ordinal":149258,"en":"Not wishing to look at him, she passed on,"},{"id":"semetey-1-2013:p0946:b003:l024","ordinal":149259,"en":"Turned this way, wandering,"},{"id":"semetey-1-2013:p0946:b003:l025","ordinal":149260,"en":"Crossed Erkech-Tam,"},{"id":"semetey-1-2013:p0946:b003:l026","ordinal":149261,"en":"And passed through great Andijan."},{"id":"semetey-1-2013:p0946:b003:l027","ordinal":149262,"en":"Synjybek of Andijan—"},{"id":"semetey-1-2013:p0946:b003:l028","ordinal":149263,"en":"She examined him as she passed."},{"id":"semetey-1-2013:p0946:b003:l029","ordinal":149264,"en":"When she judged Synjybek,"},{"id":"semetey-1-2013:p0946:b003:l030","ordinal":149265,"en":"I have no gathered army."},{"id":"semetey-1-2013:p0946:b003:l031","ordinal":149266,"en":"These ruined men—"},{"id":"semetey-1-2013:p0946:b003:l032","ordinal":149267,"en":"All their horses were stallions,"},{"id":"semetey-1-2013:p0946:b003:l033","ordinal":149268,"en":"With no cruppers at all."},{"id":"semetey-1-2013:p0946:b003:l034","ordinal":149269,"en":"His blue overshoes sticking out,"},{"id":"semetey-1-2013:p0946:b003:l035","ordinal":149270,"en":"His thoroughbred holding its head high,"},{"id":"semetey-1-2013:p0946:b003:l036","ordinal":149271,"en":"Like a black young ram,"},{"id":"semetey-1-2013:p0946:b003:l037","ordinal":149272,"en":"He was a slave who balked,"},{"id":"semetey-1-2013:p0946:b003:l038","ordinal":149273,"en":"Like a male black crow,"},{"id":"semetey-1-2013:p0946:b003:l039","ordinal":149274,"en":"He was a fellow who hopped about."},{"id":"semetey-1-2013:p0946:b004:l001","ordinal":149275,"en":"'Calling this one a hero,"},{"id":"semetey-1-2013:p0946:b004:l002","ordinal":149276,"en":"Would a woman who married him prosper?"},{"id":"semetey-1-2013:p0946:b004:l003","ordinal":149277,"en":"May his wish never be granted!"},{"id":"semetey-1-2013:p0946:b004:l004","ordinal":149278,"en":"If the hero Toltoi faced him,"},{"id":"semetey-1-2013:p0946:b004:l005","ordinal":149279,"en":"Would he leave such a Sart alive"},{"id":"semetey-1-2013:p0946:b004:l006","ordinal":149280,"en":"Even long enough to boil tea?"},{"id":"semetey-1-2013:p0946:b004:l007","ordinal":149281,"en":"The Sarts' mottled robes,"},{"id":"semetey-1-2013:p0946:b004:l008","ordinal":149282,"en":"With what face could I wear them?"},{"id":"semetey-1-2013:p0946:b004:l009","ordinal":149283,"en":"How could I marry this one?"},{"id":"semetey-1-2013:p0946:b004:l010","ordinal":149284,"en":"As though I were snub-nosed,"},{"id":"semetey-1-2013:p0946:b004:l011","ordinal":149285,"en":"How could I go about veiled?'"},{"id":"semetey-1-2013:p0946:b004:l012","ordinal":149286,"en":"Passing on from there,"},{"id":"semetey-1-2013:p0946:b004:l013","ordinal":149287,"en":"Aichurok went again,"},{"id":"semetey-1-2013:p0946:b004:l014","ordinal":149288,"en":"Wandering among other peoples."},{"id":"semetey-1-2013:p0946:b004:l015","ordinal":149289,"en":"Malabek in Margalan—"},{"id":"semetey-1-2013:p0946:b004:l016","ordinal":149290,"en":"She examined Malabek."},{"id":"semetey-1-2013:p0946:b004:l017","ordinal":149291,"en":"There were the lands of Kokand and Tashkent,"},{"id":"semetey-1-2013:p0946:b004:l018","ordinal":149292,"en":"Their people alike as hares."},{"id":"semetey-1-2013:p0946:b004:l019","ordinal":149293,"en":"'If I repeat it, it is the same tale;"},{"id":"semetey-1-2013:p0946:b004:l020","ordinal":149294,"en":"Must I go on repeating it?"},{"id":"semetey-1-2013:p0946:b004:l021","ordinal":149295,"en":"One of the usual"},{"id":"semetey-1-2013:p0946:b004:l022","ordinal":149296,"en":"Saying, 'That is how she spoke then.'"},{"id":"semetey-1-2013:p0946:b004:l023","ordinal":149297,"en":"Noble Churok grieved,"},{"id":"semetey-1-2013:p0946:b004:l024","ordinal":149298,"en":"Despairing of packsaddle riders,"},{"id":"semetey-1-2013:p0946:b004:l025","ordinal":149299,"en":"Drew away in alarm toward this side."},{"id":"semetey-1-2013:p0946:b004:l026","ordinal":149300,"en":"Traversing the earth,"},{"id":"semetey-1-2013:p0946:b004:l027","ordinal":149301,"en":"Of the giants she had heard of,"},{"id":"semetey-1-2013:p0946:b004:l028","ordinal":149302,"en":"She visited every one."},{"id":"semetey-1-2013:p0946:b004:l029","ordinal":149303,"en":"'Let me search over the earth,"},{"id":"semetey-1-2013:p0946:b004:l030","ordinal":149304,"en":"Let me find the one I need."},{"id":"semetey-1-2013:p0946:b004:l031","ordinal":149305,"en":"Why should I go on grieving?"},{"id":"semetey-1-2013:p0946:b004:l032","ordinal":149306,"en":"If I lose hope in the Muslims,"},{"id":"semetey-1-2013:p0946:b004:l033","ordinal":149307,"en":"Let me go among the infidels."},{"id":"semetey-1-2013:p0946:b004:l034","ordinal":149308,"en":"Let me be dreamless,"},{"id":"semetey-1-2013:p0946:b004:l035","ordinal":149309,"en":"The giants of the Muslims,"},{"id":"semetey-1-2013:p0946:b004:l036","ordinal":149310,"en":"Let me visit every one."},{"id":"semetey-1-2013:p0946:b004:l037","ordinal":149311,"en":"Dwelling in Ketmen-Tobo,"},{"id":"semetey-1-2013:p0946:b004:l038","ordinal":149312,"en":"Said to be a stately hero,"},{"id":"semetey-1-2013:p0946:b004:l039","ordinal":149313,"en":"Whose fame has reached Alai,"},{"id":"semetey-1-2013:p0947:b003:l001","ordinal":149314,"en":"Whose ancestral power has spread far,"},{"id":"semetey-1-2013:p0947:b003:l002","ordinal":149315,"en":"Bilerik of Aikojo—"},{"id":"semetey-1-2013:p0947:b003:l003","ordinal":149316,"en":"Let me turn and see him once.'"},{"id":"semetey-1-2013:p0947:b003:l004","ordinal":149317,"en":"Bilerik of Aikojo—"},{"id":"semetey-1-2013:p0947:b003:l005","ordinal":149318,"en":"She came to Bilerik,"},{"id":"semetey-1-2013:p0947:b003:l006","ordinal":149319,"en":"And put him to the test."},{"id":"semetey-1-2013:p0947:b003:l007","ordinal":149320,"en":"A fidgety horse with a slow pacing gait,"},{"id":"semetey-1-2013:p0947:b003:l008","ordinal":149321,"en":"He was a man like an ambling horse."},{"id":"semetey-1-2013:p0947:b003:l009","ordinal":149322,"en":"Washing whether he sat or stood,"},{"id":"semetey-1-2013:p0947:b003:l010","ordinal":149323,"en":"He was a mullah-like man."},{"id":"semetey-1-2013:p0947:b003:l011","ordinal":149324,"en":"Never rising from one place,"},{"id":"semetey-1-2013:p0947:b003:l012","ordinal":149325,"en":"He was a woman-like man."},{"id":"semetey-1-2013:p0947:b003:l013","ordinal":149326,"en":"His turban never leaving his head,"},{"id":"semetey-1-2013:p0947:b003:l014","ordinal":149327,"en":"He was a woman-like man."},{"id":"semetey-1-2013:p0947:b003:l015","ordinal":149328,"en":"What God had done,"},{"id":"semetey-1-2013:p0947:b003:l016","ordinal":149329,"en":"'Would wretched Toltoi spare"},{"id":"semetey-1-2013:p0947:b003:l017","ordinal":149330,"en":"This woman-like man of mine?"},{"id":"semetey-1-2013:p0947:b003:l018","ordinal":149331,"en":"A mottled silk dress,"},{"id":"semetey-1-2013:p0947:b003:l019","ordinal":149332,"en":"With what face could I wear it?"},{"id":"semetey-1-2013:p0947:b003:l020","ordinal":149333,"en":"He himself is a flawed man;"},{"id":"semetey-1-2013:p0947:b003:l021","ordinal":149334,"en":"With what face could I marry him?'"},{"id":"semetey-1-2013:p0947:b003:l022","ordinal":149335,"en":"She passed on from there,"},{"id":"semetey-1-2013:p0947:b003:l023","ordinal":149336,"en":"Wandered onward,"},{"id":"semetey-1-2013:p0947:b003:l024","ordinal":149337,"en":"Passed through Maseyil,"},{"id":"semetey-1-2013:p0947:b003:l025","ordinal":149338,"en":"Crossed broad Kakshaal."},{"id":"semetey-1-2013:p0947:b003:l026","ordinal":149339,"en":"In the hollow of that Kakshaal,"},{"id":"semetey-1-2013:p0947:b003:l027","ordinal":149340,"en":"On the banks of Jaman-Suu,"},{"id":"semetey-1-2013:p0947:b003:l028","ordinal":149341,"en":"Dwelling in Saparbai,"},{"id":"semetey-1-2013:p0947:b003:l029","ordinal":149342,"en":"Wintering in Kulansaryk,"},{"id":"semetey-1-2013:p0947:b003:l030","ordinal":149343,"en":"The youngest of nine sons,"},{"id":"semetey-1-2013:p0947:b003:l031","ordinal":149344,"en":"A servant of the one God,"},{"id":"semetey-1-2013:p0947:b003:l032","ordinal":149345,"en":"Eleman's darling."},{"id":"semetey-1-2013:p0947:b003:l033","ordinal":149346,"en":"Dwelling in Kulansaryk,"},{"id":"semetey-1-2013:p0947:b003:l034","ordinal":149347,"en":"That wretched dauntless hero,"},{"id":"semetey-1-2013:p0947:b003:l035","ordinal":149348,"en":"Said to be unlike other mortals,"},{"id":"semetey-1-2013:p0947:b003:l036","ordinal":149349,"en":"Who wore a bulletproof coat,"},{"id":"semetey-1-2013:p0947:b003:l037","ordinal":149350,"en":"Seven giants beneath the earth—"},{"id":"semetey-1-2013:p0947:b003:l038","ordinal":149351,"en":"He went in alone and attacked them,"},{"id":"semetey-1-2013:p0947:b003:l039","ordinal":149352,"en":"He girded the jekene at his waist;"},{"id":"semetey-1-2013:p0947:b005:l001","ordinal":149353,"en":"When seven tumens of enemies came,"},{"id":"semetey-1-2013:p0947:b005:l002","ordinal":149354,"en":"He attacked alone through their midst."},{"id":"semetey-1-2013:p0947:b005:l003","ordinal":149355,"en":"Hero Manas's champions,"},{"id":"semetey-1-2013:p0947:b005:l004","ordinal":149356,"en":"The champion of many giants,"},{"id":"semetey-1-2013:p0947:b005:l005","ordinal":149357,"en":"To put the hero Toshtuk to the test,"},{"id":"semetey-1-2013:p0947:b005:l006","ordinal":149358,"en":"To go and see him,"},{"id":"semetey-1-2013:p0947:b005:l007","ordinal":149359,"en":"To marry him if he pleased her,"},{"id":"semetey-1-2013:p0947:b005:l008","ordinal":149360,"en":"Without taking shame or offense,"},{"id":"semetey-1-2013:p0947:b005:l009","ordinal":149361,"en":"To live as his junior wife:"},{"id":"semetey-1-2013:p0947:b005:l010","ordinal":149362,"en":"'If Toshtuk pleases me,"},{"id":"semetey-1-2013:p0947:b005:l011","ordinal":149363,"en":"Let me take him along as my husband,"},{"id":"semetey-1-2013:p0947:b005:l012","ordinal":149364,"en":"Toltoi of the Jediger—"},{"id":"semetey-1-2013:p0947:b005:l013","ordinal":149365,"en":"Let him level him with the black earth,"},{"id":"semetey-1-2013:p0947:b005:l014","ordinal":149366,"en":"If I do not wreak devastation,"},{"id":"semetey-1-2013:p0947:b005:l015","ordinal":149367,"en":"If Toshtuk pleases my heart,"},{"id":"semetey-1-2013:p0947:b005:l016","ordinal":149368,"en":"If I do not take him as my bridegroom!'"},{"id":"semetey-1-2013:p0947:b005:l017","ordinal":149369,"en":"Speeding through the clouds,"},{"id":"semetey-1-2013:p0947:b005:l018","ordinal":149370,"en":"Toward Eleman's Toshtuk,"},{"id":"semetey-1-2013:p0947:b005:l019","ordinal":149371,"en":"She drew near and entered."},{"id":"semetey-1-2013:p0947:b005:l020","ordinal":149372,"en":"'He is a thick-armed lion,"},{"id":"semetey-1-2013:p0947:b005:l021","ordinal":149373,"en":"Hero Toshtuk is a warrior."},{"id":"semetey-1-2013:p0947:b005:l022","ordinal":149374,"en":"Had I met him in his youth,"},{"id":"semetey-1-2013:p0947:b005:l023","ordinal":149375,"en":"This Sultan Toshtuk"},{"id":"semetey-1-2013:p0947:b005:l024","ordinal":149376,"en":"Would have been a man to marry."},{"id":"semetey-1-2013:p0947:b005:l025","ordinal":149377,"en":"Tall and broad-shouldered,"},{"id":"semetey-1-2013:p0947:b005:l026","ordinal":149378,"en":"Both a champion and a lion,"},{"id":"semetey-1-2013:p0947:b005:l027","ordinal":149379,"en":"He has passed sixty."},{"id":"semetey-1-2013:p0947:b005:l028","ordinal":149380,"en":"The present age of the champion"},{"id":"semetey-1-2013:p0947:b005:l029","ordinal":149381,"en":"Has reached seventy."},{"id":"semetey-1-2013:p0947:b005:l030","ordinal":149382,"en":"He has left his youth behind,"},{"id":"semetey-1-2013:p0947:b005:l031","ordinal":149383,"en":"Has reached old age."},{"id":"semetey-1-2013:p0947:b005:l032","ordinal":149384,"en":"The warmth has left his embrace,"},{"id":"semetey-1-2013:p0947:b005:l033","ordinal":149385,"en":"The vigor has left his play."},{"id":"semetey-1-2013:p0947:b005:l034","ordinal":149386,"en":"To this man in his old age,"},{"id":"semetey-1-2013:p0947:b005:l035","ordinal":149387,"en":"With what face could I marry?"},{"id":"semetey-1-2013:p0947:b005:l036","ordinal":149388,"en":"He is a man grown old."},{"id":"semetey-1-2013:p0947:b005:l037","ordinal":149389,"en":"Looking at his household,"},{"id":"semetey-1-2013:p0947:b005:l038","ordinal":149390,"en":"He has four wives."},{"id":"semetey-1-2013:p0947:b005:l039","ordinal":149391,"en":"Otherwise, Toshtuk is a seer,"},{"id":"semetey-1-2013:p0948:b003:l001","ordinal":149392,"en":"A man of holy lineage."},{"id":"semetey-1-2013:p0948:b003:l002","ordinal":149393,"en":"That hero has grown stooped."},{"id":"semetey-1-2013:p0948:b003:l003","ordinal":149394,"en":"In his youth, giant Toshtuk"},{"id":"semetey-1-2013:p0948:b003:l004","ordinal":149395,"en":"Was champion among many giants."},{"id":"semetey-1-2013:p0948:b003:l005","ordinal":149396,"en":"His golden head has turned white,"},{"id":"semetey-1-2013:p0948:b003:l006","ordinal":149397,"en":"His season of youth has passed,"},{"id":"semetey-1-2013:p0948:b003:l007","ordinal":149398,"en":"He has reached the season of an old man."},{"id":"semetey-1-2013:p0948:b003:l008","ordinal":149399,"en":"Were it not for that fault,"},{"id":"semetey-1-2013:p0948:b003:l009","ordinal":149400,"en":"What could dear Toshtuk not do?"},{"id":"semetey-1-2013:p0948:b003:l010","ordinal":149401,"en":"Wearing such a battle coat as Chaiyingi,"},{"id":"semetey-1-2013:p0948:b003:l011","ordinal":149402,"en":"Riding such a horse as Chalkuiruk,"},{"id":"semetey-1-2013:p0948:b003:l012","ordinal":149403,"en":"Hero Toshtuk would hold himself proudly.'"},{"id":"semetey-1-2013:p0948:b003:l013","ordinal":149404,"en":"Finding him wanting because of old age,"},{"id":"semetey-1-2013:p0948:b003:l014","ordinal":149405,"en":"Aichurok turned back."},{"id":"semetey-1-2013:p0948:b003:l015","ordinal":149406,"en":"Following her course, she flew;"},{"id":"semetey-1-2013:p0948:b003:l016","ordinal":149407,"en":"Then Aichurok"},{"id":"semetey-1-2013:p0948:b003:l017","ordinal":149408,"en":"Descended upon Chech-Tobo."},{"id":"semetey-1-2013:p0948:b003:l018","ordinal":149409,"en":"Dwelling in Chech-Tobo,"},{"id":"semetey-1-2013:p0948:b003:l019","ordinal":149410,"en":"Said to be an immeasurable hero,"},{"id":"semetey-1-2013:p0948:b003:l020","ordinal":149411,"en":"For the warrior held bound,"},{"id":"semetey-1-2013:p0948:b003:l021","ordinal":149412,"en":"Hero Koshoi opened the way to fortune."},{"id":"semetey-1-2013:p0948:b003:l022","ordinal":149413,"en":"For the market that stood closed,"},{"id":"semetey-1-2013:p0948:b003:l023","ordinal":149414,"en":"Hero Koshoi opened its city."},{"id":"semetey-1-2013:p0948:b003:l024","ordinal":149415,"en":"A truly saintly elder,"},{"id":"semetey-1-2013:p0948:b003:l025","ordinal":149416,"en":"A truly knowledgeable seer,"},{"id":"semetey-1-2013:p0948:b003:l026","ordinal":149417,"en":"Whose blessing enriched the people,"},{"id":"semetey-1-2013:p0948:b003:l027","ordinal":149418,"en":"Who brought prosperity to those he watched over,"},{"id":"semetey-1-2013:p0948:b003:l028","ordinal":149419,"en":"A prophet-like saint."},{"id":"semetey-1-2013:p0948:b003:l029","ordinal":149420,"en":"Receiving a letter from the caliph,"},{"id":"semetey-1-2013:p0948:b003:l030","ordinal":149421,"en":"Receiving a blessing from a prince,"},{"id":"semetey-1-2013:p0948:b003:l031","ordinal":149422,"en":"Pledging allegiance to twelve spiritual guides,"},{"id":"semetey-1-2013:p0948:b003:l032","ordinal":149423,"en":"Named Zayibburush*"},{"id":"semetey-1-2013:p0948:b003:l033","ordinal":149424,"en":"Whose blessing enriched the people,"},{"id":"semetey-1-2013:p0948:b003:l034","ordinal":149425,"en":"Who brought prosperity to anyone he regarded,"},{"id":"semetey-1-2013:p0948:b003:l035","ordinal":149426,"en":"His white beard flowing,"},{"id":"semetey-1-2013:p0948:b003:l036","ordinal":149427,"en":"Who understood the words of the Haftiyak."},{"id":"semetey-1-2013:p0948:b003:l037","ordinal":149428,"en":"A sultan blessed by Kydyr, a precious hero—"},{"id":"semetey-1-2013:p0948:b003:l038","ordinal":149429,"en":"Aichurok, a formidable judge,"},{"id":"semetey-1-2013:p0948:b003:l039","ordinal":149430,"en":"Was there appraising him."},{"id":"semetey-1-2013:p0948:b004:l001","ordinal":149431,"en":"Do not ask about your elder:"},{"id":"semetey-1-2013:p0948:b004:l002","ordinal":149432,"en":"God had given him long life,"},{"id":"semetey-1-2013:p0948:b004:l003","ordinal":149433,"en":"His age approached a hundred."},{"id":"semetey-1-2013:p0948:b004:l004","ordinal":149434,"en":"In his youth, this elder of mine,"},{"id":"semetey-1-2013:p0948:b004:l005","ordinal":149435,"en":"The dear land of Jeti-Suu,"},{"id":"semetey-1-2013:p0948:b004:l006","ordinal":149436,"en":"Through skill had made it a homeland."},{"id":"semetey-1-2013:p0948:b004:l007","ordinal":149437,"en":"The Kyrgyz of Jeti-Suu,"},{"id":"semetey-1-2013:p0948:b004:l008","ordinal":149438,"en":"Through his efforts had made them a people."},{"id":"semetey-1-2013:p0948:b004:l009","ordinal":149439,"en":"When she examined your elder,"},{"id":"semetey-1-2013:p0948:b004:l010","ordinal":149440,"en":"He crouched beside the fire."},{"id":"semetey-1-2013:p0948:b004:l011","ordinal":149441,"en":"What could your dear elder do?"},{"id":"semetey-1-2013:p0948:b004:l012","ordinal":149442,"en":"He had sunk down and could not rise."},{"id":"semetey-1-2013:p0948:b004:l013","ordinal":149443,"en":"To call him alive, he did not count;"},{"id":"semetey-1-2013:p0948:b004:l014","ordinal":149444,"en":"To call him dead, he was not in the grave."},{"id":"semetey-1-2013:p0948:b004:l015","ordinal":149445,"en":"When Koshoy drove them forward,"},{"id":"semetey-1-2013:p0948:b004:l016","ordinal":149446,"en":"Chattering like magpies and jackdaws,"},{"id":"semetey-1-2013:p0948:b004:l017","ordinal":149447,"en":"The brow has lost its eyebrows;"},{"id":"semetey-1-2013:p0948:b004:l018","ordinal":149448,"en":"The Kyrgyz of Jeti-Suu—"},{"id":"semetey-1-2013:p0948:b004:l019","ordinal":149449,"en":"Lost their heads to the infidels."},{"id":"semetey-1-2013:p0948:b004:l020","ordinal":149450,"en":"Koshoi's strength had gone."},{"id":"semetey-1-2013:p0948:b004:l021","ordinal":149451,"en":"Not heeding one another's words,"},{"id":"semetey-1-2013:p0948:b004:l022","ordinal":149452,"en":"Unable to bear one another,"},{"id":"semetey-1-2013:p0948:b004:l023","ordinal":149453,"en":"All the Kyrgyz"},{"id":"semetey-1-2013:p0948:b004:l024","ordinal":149454,"en":"Were no people to welcome her."},{"id":"semetey-1-2013:p0948:b004:l025","ordinal":149455,"en":"No people who will welcome you."},{"id":"semetey-1-2013:p0948:b004:l026","ordinal":149456,"en":"'My aged elder, Khan Koshoi,"},{"id":"semetey-1-2013:p0948:b004:l027","ordinal":149457,"en":"Is the equal of my grandfather."},{"id":"semetey-1-2013:p0948:b004:l028","ordinal":149458,"en":"To this weary giant Koshoi,"},{"id":"semetey-1-2013:p0948:b004:l029","ordinal":149459,"en":"Why should I be bound?"},{"id":"semetey-1-2013:p0948:b004:l030","ordinal":149460,"en":"The giants upon the face of the earth,"},{"id":"semetey-1-2013:p0948:b004:l031","ordinal":149461,"en":"Let me go and see them all.'"},{"id":"semetey-1-2013:p0948:b004:l032","ordinal":149462,"en":"Wintering by broad Issyk-Kol,"},{"id":"semetey-1-2013:p0948:b004:l033","ordinal":149463,"en":"Summering in the two Kemins,"},{"id":"semetey-1-2013:p0948:b004:l034","ordinal":149464,"en":"Tethering a pair of black horses,"},{"id":"semetey-1-2013:p0948:b004:l035","ordinal":149465,"en":"Making a dark cave his home,"},{"id":"semetey-1-2013:p0948:b004:l036","ordinal":149466,"en":"To put Urbu to the test,"},{"id":"semetey-1-2013:p0948:b004:l037","ordinal":149467,"en":"When Aichurok came in,"},{"id":"semetey-1-2013:p0948:b004:l038","ordinal":149468,"en":"His people remained, but he was gone."},{"id":"semetey-1-2013:p0948:b004:l039","ordinal":149469,"en":"The hero Urbu was no longer living,"},{"id":"semetey-1-2013:p0949:b003:l001","ordinal":149470,"en":"What is seen today is gone tomorrow;"},{"id":"semetey-1-2013:p0949:b003:l002","ordinal":149471,"en":"Such is this shitty world."},{"id":"semetey-1-2013:p0949:b003:l003","ordinal":149472,"en":"Their leader Urbu had died."},{"id":"semetey-1-2013:p0949:b003:l004","ordinal":149473,"en":"Scattered by attacks,"},{"id":"semetey-1-2013:p0949:b003:l005","ordinal":149474,"en":"The wretched people struggled on."},{"id":"semetey-1-2013:p0949:b003:l006","ordinal":149475,"en":"His people had settled in the valley."},{"id":"semetey-1-2013:p0949:b003:l007","ordinal":149476,"en":"With the hero Urbu himself dead,"},{"id":"semetey-1-2013:p0949:b003:l008","ordinal":149477,"en":"It was as though a fire had gone out."},{"id":"semetey-1-2013:p0949:b003:l009","ordinal":149478,"en":"Despairing of Urbu, Churok"},{"id":"semetey-1-2013:p0949:b003:l010","ordinal":149479,"en":"Crossed Chong-Kashtek,"},{"id":"semetey-1-2013:p0949:b003:l011","ordinal":149480,"en":"Wandered through desert lands,"},{"id":"semetey-1-2013:p0949:b003:l012","ordinal":149481,"en":"Passed over the broad Ili."},{"id":"semetey-1-2013:p0949:b003:l013","ordinal":149482,"en":"Crossing ridge after ridge,"},{"id":"semetey-1-2013:p0949:b003:l014","ordinal":149483,"en":"Crossing rugged mountain passes,"},{"id":"semetey-1-2013:p0949:b003:l015","ordinal":149484,"en":"Traversing countless lands,"},{"id":"semetey-1-2013:p0949:b003:l016","ordinal":149485,"en":"Wandering through Sary-Arka,"},{"id":"semetey-1-2013:p0949:b003:l017","ordinal":149486,"en":"When she came to Sary-Arka,"},{"id":"semetey-1-2013:p0949:b003:l018","ordinal":149487,"en":"She saw an unusual people there:"},{"id":"semetey-1-2013:p0949:b003:l019","ordinal":149488,"en":"Who prepared their millet hard as stone,"},{"id":"semetey-1-2013:p0949:b003:l020","ordinal":149489,"en":"Praised their wives as though they were maidens,"},{"id":"semetey-1-2013:p0949:b003:l021","ordinal":149490,"en":"With watery ayran and blue-gray dried curds."},{"id":"semetey-1-2013:p0949:b003:l022","ordinal":149491,"en":"The Kazakhs' Khan Kokcho,"},{"id":"semetey-1-2013:p0949:b003:l023","ordinal":149492,"en":"And Kokcho's son Umotoi—"},{"id":"semetey-1-2013:p0949:b003:l024","ordinal":149493,"en":"She came to put Umotoi to the test."},{"id":"semetey-1-2013:p0949:b003:l025","ordinal":149494,"en":"From the grassy heights of Sary-Arka,"},{"id":"semetey-1-2013:p0949:b003:l026","ordinal":149495,"en":"With sixty champions beside him,"},{"id":"semetey-1-2013:p0949:b003:l027","ordinal":149496,"en":"He had returned from a hunting expedition;"},{"id":"semetey-1-2013:p0949:b003:l028","ordinal":149497,"en":"She stood appraising Umotoi."},{"id":"semetey-1-2013:p0949:b003:l029","ordinal":149498,"en":"Dull-minded, without spirit,"},{"id":"semetey-1-2013:p0949:b003:l030","ordinal":149499,"en":"Calf-like Umotoi;"},{"id":"semetey-1-2013:p0949:b003:l031","ordinal":149500,"en":"When he advanced against a foe,"},{"id":"semetey-1-2013:p0949:b003:l032","ordinal":149501,"en":"Cowardly Umotoi."},{"id":"semetey-1-2013:p0949:b003:l033","ordinal":149502,"en":"He was no support to bind about one's waist,"},{"id":"semetey-1-2013:p0949:b003:l034","ordinal":149503,"en":"No hero to rely upon firmly."},{"id":"semetey-1-2013:p0949:b003:l035","ordinal":149504,"en":"Once he fled, he would never stop;"}]
