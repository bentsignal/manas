[{"id":"manas-2010:p1324:b001:l041","ordinal":57345,"en":"Would I not have endured, Akkula?"},{"id":"manas-2010:p1324:b001:l042","ordinal":57346,"en":"Had Akkula been my mount,"},{"id":"manas-2010:p1325:b001:l001","ordinal":57347,"en":"With my white padded armor to wear,"},{"id":"manas-2010:p1325:b001:l002","ordinal":57348,"en":"With Akkelte to fire,"},{"id":"manas-2010:p1325:b001:l003","ordinal":57349,"en":"Would I not take heart,"},{"id":"manas-2010:p1325:b001:l004","ordinal":57350,"en":"And upon the ant-like Chinese"},{"id":"manas-2010:p1325:b001:l005","ordinal":57351,"en":"Would I not bring calamity!"},{"id":"manas-2010:p1325:b001:l006","ordinal":57352,"en":"Now, attacking the governors, I will not turn back;"},{"id":"manas-2010:p1325:b001:l007","ordinal":57353,"en":"If a dark day falls upon me,"},{"id":"manas-2010:p1325:b001:l008","ordinal":57354,"en":"Akkula, I will not part from you!"},{"id":"manas-2010:p1325:b001:l009","ordinal":57355,"en":"My very life has suffered,"},{"id":"manas-2010:p1325:b001:l010","ordinal":57356,"en":"Startled terribly..."},{"id":"manas-2010:p1325:b001:l011","ordinal":57357,"en":"Its front pommel of white gold,"},{"id":"manas-2010:p1325:b001:l012","ordinal":57358,"en":"Its rear cantle of pure silver,"},{"id":"manas-2010:p1325:b001:l013","ordinal":57359,"en":"The broad-pommeled saddle with birchwood sides,"},{"id":"manas-2010:p1325:b001:l014","ordinal":57360,"en":"He took and saddled on the horse."},{"id":"manas-2010:p1325:b001:l015","ordinal":57361,"en":"Preparing his weapons of war,"},{"id":"manas-2010:p1325:b001:l016","ordinal":57362,"en":"Girding on his Zhoybolot,"},{"id":"manas-2010:p1325:b001:l017","ordinal":57363,"en":"Turning to the one God."},{"id":"manas-2010:p1325:b001:l018","ordinal":57364,"en":"Seeing them, Manas sighed—"},{"id":"manas-2010:p1325:b001:l019","ordinal":57365,"en":"Was it not from joy?—"},{"id":"manas-2010:p1325:b001:l020","ordinal":57366,"en":"Running and scampering like a child,"},{"id":"manas-2010:p1325:b001:l021","ordinal":57367,"en":"Putting on his white padded armor,"},{"id":"manas-2010:p1325:b001:l022","ordinal":57368,"en":"Taking Akkelte in his hand,"},{"id":"manas-2010:p1325:b001:l023","ordinal":57369,"en":"When his spirit returned to him,"},{"id":"manas-2010:p1325:b001:l024","ordinal":57370,"en":"The leopard spoke again:"},{"id":"manas-2010:p1325:b001:l025","ordinal":57371,"en":"“My Almambet and Chubak,"},{"id":"manas-2010:p1325:b001:l026","ordinal":57372,"en":"My Syrgak, struck by the battle-axe—"},{"id":"manas-2010:p1325:b001:l027","ordinal":57373,"en":"Bakay has found a way,”"},{"id":"manas-2010:p1325:b001:l028","ordinal":57374,"en":"His Ajybay having told him,"},{"id":"manas-2010:p1325:b001:l029","ordinal":57375,"en":"He quickly cried, “Baabedin!”"},{"id":"manas-2010:p1325:b001:l030","ordinal":57376,"en":"To one of his protecting spirits"},{"id":"manas-2010:p1325:b001:l031","ordinal":57377,"en":"He pledged a moon-hoofed horse for sacrifice."},{"id":"manas-2010:p1325:b001:l032","ordinal":57378,"en":"Then Manas grew jubilant,"},{"id":"manas-2010:p1325:b001:l033","ordinal":57379,"en":"To attack the enemy alone"},{"id":"manas-2010:p1325:b001:l034","ordinal":57380,"en":"He prepared his weapons;"},{"id":"manas-2010:p1325:b001:l035","ordinal":57381,"en":"Your Manas took his hungry steel sword"},{"id":"manas-2010:p1325:b001:l036","ordinal":57382,"en":"And put it in its sheath."},{"id":"manas-2010:p1325:b001:l037","ordinal":57383,"en":"His gun, Akkelte,"},{"id":"manas-2010:p1325:b001:l038","ordinal":57384,"en":"The lion now took in hand."},{"id":"manas-2010:p1325:b001:l039","ordinal":57385,"en":"When God was granting favor,"},{"id":"manas-2010:p1325:b001:l040","ordinal":57386,"en":"Akkelte’s voice was unmistakable:"},{"id":"manas-2010:p1325:b001:l041","ordinal":57387,"en":"At its crack, it thundered,"},{"id":"manas-2010:p1325:b001:l042","ordinal":57388,"en":"As though the sky had fallen,"},{"id":"manas-2010:p1326:b001:l001","ordinal":57389,"en":"Making a person’s body shudder."},{"id":"manas-2010:p1326:b001:l002","ordinal":57390,"en":"Taking the shot as an omen,"},{"id":"manas-2010:p1326:b001:l003","ordinal":57391,"en":"Manas would enter battle;"},{"id":"manas-2010:p1326:b001:l004","ordinal":57392,"en":"When God was about to strike him down,"},{"id":"manas-2010:p1326:b001:l005","ordinal":57393,"en":"It made no roar, only a plop,"},{"id":"manas-2010:p1326:b001:l006","ordinal":57394,"en":"Not reaching a handspan,"},{"id":"manas-2010:p1326:b001:l007","ordinal":57395,"en":"Its fired bullet fell with a thud."},{"id":"manas-2010:p1326:b001:l008","ordinal":57396,"en":"“Akkelte, which I have always fired,"},{"id":"manas-2010:p1326:b001:l009","ordinal":57397,"en":"Let me shoot and take an omen,"},{"id":"manas-2010:p1326:b001:l010","ordinal":57398,"en":"Of the lions Almambet and Chubak"},{"id":"manas-2010:p1326:b001:l011","ordinal":57399,"en":"Let me learn the fate!”"},{"id":"manas-2010:p1326:b001:l012","ordinal":57400,"en":"Thinking this, hero Manas—"},{"id":"manas-2010:p1326:b001:l013","ordinal":57401,"en":"Akkelte, when slung upon him,"},{"id":"manas-2010:p1326:b001:l014","ordinal":57402,"en":"The mirror of his shoulder blade,"},{"id":"manas-2010:p1326:b001:l015","ordinal":57403,"en":"If it struck an enemy in combat,"},{"id":"manas-2010:p1326:b001:l016","ordinal":57404,"en":"Would make him surrender his borrowed life."},{"id":"manas-2010:p1326:b001:l017","ordinal":57405,"en":"Girding on his gray ammunition belt,"},{"id":"manas-2010:p1326:b001:l018","ordinal":57406,"en":"Leveling Akkelte,"},{"id":"manas-2010:p1326:b001:l019","ordinal":57407,"en":"At the seething mass before him,"},{"id":"manas-2010:p1326:b001:l020","ordinal":57408,"en":"The multitude of Chinese, he fired once."},{"id":"manas-2010:p1326:b001:l021","ordinal":57409,"en":"He struck once with Akkelte;"},{"id":"manas-2010:p1326:b001:l022","ordinal":57410,"en":"Astonished, the many Chinese,"},{"id":"manas-2010:p1326:b001:l023","ordinal":57411,"en":"Surging as though about to flee,"},{"id":"manas-2010:p1326:b001:l024","ordinal":57412,"en":"Drew back in a sudden rush."},{"id":"manas-2010:p1326:b001:l025","ordinal":57413,"en":"“The leopard’s Akkula"},{"id":"manas-2010:p1326:b001:l026","ordinal":57414,"en":"Must have arrived safely,”"},{"id":"manas-2010:p1326:b001:l027","ordinal":57415,"en":"Thought Almambet and Chubak."},{"id":"manas-2010:p1326:b001:l028","ordinal":57416,"en":"“The day of our attack"},{"id":"manas-2010:p1326:b001:l029","ordinal":57417,"en":"Is a day of the Night of Power;"},{"id":"manas-2010:p1326:b001:l030","ordinal":57418,"en":"The thunder coming this way"},{"id":"manas-2010:p1326:b001:l031","ordinal":57419,"en":"Is the voice of Akkelte."},{"id":"manas-2010:p1326:b001:l032","ordinal":57420,"en":"If the magnanimous one has his wish,"},{"id":"manas-2010:p1326:b001:l033","ordinal":57421,"en":"His Akkula from the rear camp"},{"id":"manas-2010:p1326:b001:l034","ordinal":57422,"en":"Must have arrived by now.”"},{"id":"manas-2010:p1326:b001:l035","ordinal":57423,"en":"Saying this, the two lions"},{"id":"manas-2010:p1326:b001:l036","ordinal":57424,"en":"Girded their swords at an angle,"},{"id":"manas-2010:p1326:b001:l037","ordinal":57425,"en":"Prepared for battle,"},{"id":"manas-2010:p1326:b001:l038","ordinal":57426,"en":"Saying, “We have seen the face of Islam;"},{"id":"manas-2010:p1326:b001:l039","ordinal":57427,"en":"Without biting our fingers in regret,"},{"id":"manas-2010:p1326:b001:l040","ordinal":57428,"en":"Now we can die without regrets!”"},{"id":"manas-2010:p1326:b001:l041","ordinal":57429,"en":"Almambet and Chubak, the two lions,"},{"id":"manas-2010:p1326:b001:l042","ordinal":57430,"en":"Now summoned their courage."},{"id":"manas-2010:p1327:b001:l001","ordinal":57431,"en":"Making Akkula lunge,"},{"id":"manas-2010:p1327:b001:l002","ordinal":57432,"en":"Making him jerk as though his rider had died,"},{"id":"manas-2010:p1327:b001:l003","ordinal":57433,"en":"The five champions on the ridge,"},{"id":"manas-2010:p1327:b001:l004","ordinal":57434,"en":"Not letting him go against the Chinese,"},{"id":"manas-2010:p1327:b001:l005","ordinal":57435,"en":"Now held Manas back."},{"id":"manas-2010:p1327:b001:l006","ordinal":57436,"en":"With Akkula in his hands,"},{"id":"manas-2010:p1327:b001:l007","ordinal":57437,"en":"Manas stood shouting;"},{"id":"manas-2010:p1327:b001:l008","ordinal":57438,"en":"Let us leave him thus for now,"},{"id":"manas-2010:p1327:b001:l009","ordinal":57439,"en":"And of renowned Bakay the leopard,"},{"id":"manas-2010:p1327:b001:l010","ordinal":57440,"en":"Let us begin the champion’s tale."},{"id":"manas-2010:p1327:b003:l001","ordinal":57441,"en":"Without his mind straying a hair,"},{"id":"manas-2010:p1327:b003:l002","ordinal":57442,"en":"Making each deed remarkable,"},{"id":"manas-2010:p1327:b003:l003","ordinal":57443,"en":"Of the vast army there,"},{"id":"manas-2010:p1327:b003:l004","ordinal":57444,"en":"Bakay was unseen by a single man;"},{"id":"manas-2010:p1327:b003:l005","ordinal":57445,"en":"To Khan Manas’s forty companions"},{"id":"manas-2010:p1327:b003:l006","ordinal":57446,"en":"Bakay now walked."},{"id":"manas-2010:p1327:b003:l007","ordinal":57447,"en":"Led by old Kyrgyl,"},{"id":"manas-2010:p1327:b003:l008","ordinal":57448,"en":"The companions were making merry!"},{"id":"manas-2010:p1327:b003:l009","ordinal":57449,"en":"Dividing into two sides,"},{"id":"manas-2010:p1327:b003:l010","ordinal":57450,"en":"They had set up a knucklebone game;"},{"id":"manas-2010:p1327:b003:l011","ordinal":57451,"en":"Their lion Manas was not in their thoughts."},{"id":"manas-2010:p1327:b003:l012","ordinal":57452,"en":"For the winnings, six mares"},{"id":"manas-2010:p1327:b003:l013","ordinal":57453,"en":"They had set as the prize."},{"id":"manas-2010:p1327:b003:l014","ordinal":57454,"en":"Then Bakay said these words:"},{"id":"manas-2010:p1327:b003:l015","ordinal":57455,"en":"“Alas, forty companions,"},{"id":"manas-2010:p1327:b003:l016","ordinal":57456,"en":"You forty were wolves from forty places;"},{"id":"manas-2010:p1327:b003:l017","ordinal":57457,"en":"When your falcon Manas was there,"},{"id":"manas-2010:p1327:b003:l018","ordinal":57458,"en":"You were lions who could rout many!"},{"id":"manas-2010:p1327:b003:l019","ordinal":57459,"en":"When hero Manas was there,"},{"id":"manas-2010:p1327:b003:l020","ordinal":57460,"en":"You put on a show on days of rest;"},{"id":"manas-2010:p1327:b003:l021","ordinal":57461,"en":"Against the enemy who came to fight"},{"id":"manas-2010:p1327:b003:l022","ordinal":57462,"en":"You made battle without holding back!"},{"id":"manas-2010:p1327:b003:l023","ordinal":57463,"en":"You grew hardened by shedding blood,"},{"id":"manas-2010:p1327:b003:l024","ordinal":57464,"en":"You earned the name of bloodthirsty companions."},{"id":"manas-2010:p1327:b003:l025","ordinal":57465,"en":"You forty were the sons of forty khans—"},{"id":"manas-2010:p1328:b001:l001","ordinal":57466,"en":"Could even I be without error?"},{"id":"manas-2010:p1328:b001:l002","ordinal":57467,"en":"One companion, you came wandering,"},{"id":"manas-2010:p1328:b001:l003","ordinal":57468,"en":"When you came wandering without a horse,"},{"id":"manas-2010:p1328:b001:l004","ordinal":57469,"en":"With wild-sheep legs and copper forelegs,"},{"id":"manas-2010:p1328:b001:l005","ordinal":57470,"en":"A horse great Manas gave you to ride."},{"id":"manas-2010:p1328:b001:l006","ordinal":57471,"en":"One companion came without a coat;"},{"id":"manas-2010:p1328:b001:l007","ordinal":57472,"en":"To the companion who came without a coat,"},{"id":"manas-2010:p1328:b001:l008","ordinal":57473,"en":"Its collar gold, its sleeves copper,"},{"id":"manas-2010:p1328:b001:l009","ordinal":57474,"en":"Double mail with lark-eye rings,"},{"id":"manas-2010:p1328:b001:l010","ordinal":57475,"en":"A gold-and-silver-braided collar, a broad jacket—"},{"id":"manas-2010:p1328:b001:l011","ordinal":57476,"en":"A coat great Manas clothed him in!"},{"id":"manas-2010:p1328:b001:l012","ordinal":57477,"en":"One companion, you came without a wife;"},{"id":"manas-2010:p1328:b001:l013","ordinal":57478,"en":"For the companion who came without a wife,"},{"id":"manas-2010:p1328:b001:l014","ordinal":57479,"en":"From among the playful beauties"},{"id":"manas-2010:p1328:b001:l015","ordinal":57480,"en":"Great Manas obtained a bride!"},{"id":"manas-2010:p1328:b001:l016","ordinal":57481,"en":"Some companions came without livestock;"},{"id":"manas-2010:p1328:b001:l017","ordinal":57482,"en":"For the companions who came without livestock,"},{"id":"manas-2010:p1328:b001:l018","ordinal":57483,"en":"Piebald-headed horses on the hills,"},{"id":"manas-2010:p1328:b001:l019","ordinal":57484,"en":"Wild-sheep necks and apple-shaped heads,"},{"id":"manas-2010:p1328:b001:l020","ordinal":57485,"en":"Having them brought and branded,"},{"id":"manas-2010:p1328:b001:l021","ordinal":57486,"en":"Great Manas divided them among you."},{"id":"manas-2010:p1328:b001:l022","ordinal":57487,"en":"He built splendid houses;"},{"id":"manas-2010:p1328:b001:l023","ordinal":57488,"en":"You who had scattered into every ravine,"},{"id":"manas-2010:p1328:b001:l024","ordinal":57489,"en":"Illustrious great Manas"},{"id":"manas-2010:p1328:b001:l025","ordinal":57490,"en":"Made each of you a khan."},{"id":"manas-2010:p1328:b001:l026","ordinal":57491,"en":"Since coming to hero Manas,"},{"id":"manas-2010:p1328:b001:l027","ordinal":57492,"en":"You have met no sudden calamity;"},{"id":"manas-2010:p1328:b001:l028","ordinal":57493,"en":"Struck by an unexpected bullet,"},{"id":"manas-2010:p1328:b001:l029","ordinal":57494,"en":"Not one of you died in battle!"},{"id":"manas-2010:p1328:b001:l030","ordinal":57495,"en":"And while Manas was there,"},{"id":"manas-2010:p1328:b001:l031","ordinal":57496,"en":"You ate slices of horse-rump meat;"},{"id":"manas-2010:p1328:b001:l032","ordinal":57497,"en":"‘If my sovereign should suffer,"},{"id":"manas-2010:p1328:b001:l033","ordinal":57498,"en":"I will crush the governor-general,’ you said."},{"id":"manas-2010:p1328:b001:l034","ordinal":57499,"en":"In the hollow of Zhylgynduu,"},{"id":"manas-2010:p1328:b001:l035","ordinal":57500,"en":"Along broad Talas,"},{"id":"manas-2010:p1328:b001:l036","ordinal":57501,"en":"While the multitude lay in happiness,"},{"id":"manas-2010:p1328:b001:l037","ordinal":57502,"en":"Would you lie there rejoicing,"},{"id":"manas-2010:p1328:b001:l038","ordinal":57503,"en":"All of you boasting together,"},{"id":"manas-2010:p1328:b001:l039","ordinal":57504,"en":"‘If there is a formidable, deep-rooted enemy,"},{"id":"manas-2010:p1328:b001:l040","ordinal":57505,"en":"The steeds we ride today"},{"id":"manas-2010:p1328:b001:l041","ordinal":57506,"en":"We shall make rear and leap,’ you would say,"},{"id":"manas-2010:p1328:b001:l042","ordinal":57507,"en":"While magnanimous Manas was there,"},{"id":"manas-2010:p1329:b001:l001","ordinal":57508,"en":"‘All the wide world,"},{"id":"manas-2010:p1329:b001:l002","ordinal":57509,"en":"I shall destroy,’ you would say."},{"id":"manas-2010:p1329:b001:l003","ordinal":57510,"en":"The time for mutual slaughter has come;"},{"id":"manas-2010:p1329:b001:l004","ordinal":57511,"en":"The hour to die together has come."},{"id":"manas-2010:p1329:b001:l005","ordinal":57512,"en":"The battle-axe has bent at its middle;"},{"id":"manas-2010:p1329:b001:l006","ordinal":57513,"en":"Life itself is truly hard pressed."},{"id":"manas-2010:p1329:b001:l007","ordinal":57514,"en":"Your lion, generous Manas,"},{"id":"manas-2010:p1329:b001:l008","ordinal":57515,"en":"Look carefully, forty companions,"},{"id":"manas-2010:p1329:b001:l009","ordinal":57516,"en":"They have surrounded him."},{"id":"manas-2010:p1329:b001:l010","ordinal":57517,"en":"Your lion Manas, vast as the sea,"},{"id":"manas-2010:p1329:b001:l011","ordinal":57518,"en":"The teeming Chinese unbelievers,"},{"id":"manas-2010:p1329:b001:l012","ordinal":57519,"en":"How deeply they have encircled him!”"},{"id":"manas-2010:p1329:b001:l013","ordinal":57520,"en":"When they heard this from Bakay,"},{"id":"manas-2010:p1329:b001:l014","ordinal":57521,"en":"All the companions, without pausing,"},{"id":"manas-2010:p1329:b001:l015","ordinal":57522,"en":"Divided six by six,"},{"id":"manas-2010:p1329:b001:l016","ordinal":57523,"en":"As though they might flee back,"},{"id":"manas-2010:p1329:b001:l017","ordinal":57524,"en":"The people of twelve khans,"},{"id":"manas-2010:p1329:b001:l018","ordinal":57525,"en":"They poured out to block their way."},{"id":"manas-2010:p1329:b001:l019","ordinal":57526,"en":"The forty precious warrior companions"},{"id":"manas-2010:p1329:b001:l020","ordinal":57527,"en":"Looked like lions."},{"id":"manas-2010:p1329:b001:l021","ordinal":57528,"en":"Unseen by a single soul,"},{"id":"manas-2010:p1329:b001:l022","ordinal":57529,"en":"While Bakay stood in the tent,"},{"id":"manas-2010:p1329:b001:l023","ordinal":57530,"en":"Your Bakay, like a rooster,"},{"id":"manas-2010:p1329:b001:l024","ordinal":57531,"en":"With his hands behind his back,"},{"id":"manas-2010:p1329:b001:l025","ordinal":57532,"en":"As he walked with his robe draped loosely,"},{"id":"manas-2010:p1329:b001:l026","ordinal":57533,"en":"Joining Khan Bakay,"},{"id":"manas-2010:p1329:b001:l027","ordinal":57534,"en":"Khan Koshoy of the Katagan,"},{"id":"manas-2010:p1329:b001:l028","ordinal":57535,"en":"Eleman's warrior Töshtük,"},{"id":"manas-2010:p1329:b001:l029","ordinal":57536,"en":"Zhamgyrchy of the Eshtek,"},{"id":"manas-2010:p1329:b001:l030","ordinal":57537,"en":"Men of many tribes had come."},{"id":"manas-2010:p1329:b001:l032","ordinal":57538,"en":"Aykhozho in a motley robe,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p1329:b001:l033","ordinal":57539,"en":"He had come for the rites of faith."},{"id":"manas-2010:p1329:b001:l034","ordinal":57540,"en":"With Aykhozho at their head,"},{"id":"manas-2010:p1329:b001:l035","ordinal":57541,"en":"While the great host stood all together,"},{"id":"manas-2010:p1329:b001:l036","ordinal":57542,"en":"From a ridge like a saddle's back,"},{"id":"manas-2010:p1329:b001:l037","ordinal":57543,"en":"Syrgak came shouting,"},{"id":"manas-2010:p1329:b001:l038","ordinal":57544,"en":"Calling, “A reward for good news!”"},{"id":"manas-2010:p1329:b001:l039","ordinal":57545,"en":"“In a dreadful business whose pleasures cost dearly,"},{"id":"manas-2010:p1329:b001:l040","ordinal":57546,"en":"Will you plunge, people of Islam!"},{"id":"manas-2010:p1329:b001:l041","ordinal":57547,"en":"Bakay, warrior Koshoy at the head,"},{"id":"manas-2010:p1329:b001:l042","ordinal":57548,"en":"All of you together, never weary,"},{"id":"manas-2010:p1330:b001:l001","ordinal":57549,"en":"Do you lie there, Muslims!"},{"id":"manas-2010:p1330:b001:l002","ordinal":57550,"en":"When death arrives and your days are done,"},{"id":"manas-2010:p1330:b001:l003","ordinal":57551,"en":"Will you not die, Muslims!"},{"id":"manas-2010:p1330:b001:l004","ordinal":57552,"en":"Manas has taken Beijing."},{"id":"manas-2010:p1330:b001:l005","ordinal":57553,"en":"Will you not all go, its marvels,"},{"id":"manas-2010:p1330:b001:l006","ordinal":57554,"en":"Will you not see them, Muslims!"},{"id":"manas-2010:p1330:b001:l007","ordinal":57555,"en":"We have taken exceptionally fine craftswomen."},{"id":"manas-2010:p1330:b001:l008","ordinal":57556,"en":"From the kakan's Beijing,"},{"id":"manas-2010:p1330:b001:l009","ordinal":57557,"en":"Thimble-mouthed, camel-calf-eyed,"},{"id":"manas-2010:p1330:b001:l010","ordinal":57558,"en":"Among those languid beauties,"},{"id":"manas-2010:p1330:b001:l011","ordinal":57559,"en":"We have taken so many young wives and girls."},{"id":"manas-2010:p1330:b001:l012","ordinal":57560,"en":"The gold and silver,"},{"id":"manas-2010:p1330:b001:l013","ordinal":57561,"en":"We cannot load it all!"},{"id":"manas-2010:p1330:b001:l014","ordinal":57562,"en":"Fair-faced young wives, beautiful girls,"},{"id":"manas-2010:p1330:b001:l015","ordinal":57563,"en":"We cannot plunder them all!"},{"id":"manas-2010:p1330:b001:l016","ordinal":57564,"en":"We have besieged Outer Beijing;"},{"id":"manas-2010:p1330:b001:l017","ordinal":57565,"en":"We have slain Chinese warriors who could wreck the world."},{"id":"manas-2010:p1330:b001:l018","ordinal":57566,"en":"There are Almambet and generous Manas;"},{"id":"manas-2010:p1330:b001:l019","ordinal":57567,"en":"Consider it, Muslims!"},{"id":"manas-2010:p1330:b001:l020","ordinal":57568,"en":"With warrior Chubak at our head,"},{"id":"manas-2010:p1330:b001:l021","ordinal":57569,"en":"We remained in a place where we did not die."},{"id":"manas-2010:p1330:b001:l022","ordinal":57570,"en":"We began shooting without mercy."},{"id":"manas-2010:p1330:b001:l023","ordinal":57571,"en":"Over the city of Outer Beijing,"},{"id":"manas-2010:p1330:b001:l024","ordinal":57572,"en":"Generous warrior Manas,"},{"id":"manas-2010:p1330:b001:l025","ordinal":57573,"en":"We have raised him as khan."},{"id":"manas-2010:p1330:b001:l026","ordinal":57574,"en":"To ride to feasts and memorial banquets,"},{"id":"manas-2010:p1330:b001:l027","ordinal":57575,"en":"To go moving smoothly along,"},{"id":"manas-2010:p1330:b001:l028","ordinal":57576,"en":"With shoes of gold,"},{"id":"manas-2010:p1330:b001:l029","ordinal":57577,"en":"We have taken countless pacers."},{"id":"manas-2010:p1330:b001:l030","ordinal":57578,"en":"After those pacers,"},{"id":"manas-2010:p1330:b001:l031","ordinal":57579,"en":"We took the finest among women."},{"id":"manas-2010:p1330:b001:l032","ordinal":57580,"en":"Esenkan's Burulcha,"},{"id":"manas-2010:p1330:b001:l033","ordinal":57581,"en":"We took that girl of immeasurable beauty."},{"id":"manas-2010:p1330:b001:l034","ordinal":57582,"en":"The governor-general's daughter Birmyskal,"},{"id":"manas-2010:p1330:b001:l035","ordinal":57583,"en":"They gave us as a gift."},{"id":"manas-2010:p1330:b001:l036","ordinal":57584,"en":"We stirred strife among the Chinese host."},{"id":"manas-2010:p1330:b001:l037","ordinal":57585,"en":"Kökchebich beneath me,"},{"id":"manas-2010:p1330:b001:l038","ordinal":57586,"en":"This is my winged horse."},{"id":"manas-2010:p1330:b001:l039","ordinal":57587,"en":"‘Let them all come, none staying behind,’"},{"id":"manas-2010:p1330:b001:l040","ordinal":57588,"en":"This is the letter Manas the leopard wrote!"},{"id":"manas-2010:p1330:b001:l041","ordinal":57589,"en":"‘Let him stir the people and gather them,’ he says."},{"id":"manas-2010:p1330:b001:l042","ordinal":57590,"en":"‘The two girls taken as spoils,"},{"id":"manas-2010:p1331:b001:l001","ordinal":57591,"en":"To Almambet and Chubak,"},{"id":"manas-2010:p1331:b001:l002","ordinal":57592,"en":"Let Aykhozho perform their marriage rites,’ he says.”"},{"id":"manas-2010:p1331:b001:l003","ordinal":57593,"en":"When they heard this news,"},{"id":"manas-2010:p1331:b001:l004","ordinal":57594,"en":"Aykhozho and old Koshoy,"},{"id":"manas-2010:p1331:b001:l005","ordinal":57595,"en":"Surrounding him, crying out,"},{"id":"manas-2010:p1331:b001:l006","ordinal":57596,"en":"The boy Syrgak, vast as the sea,"},{"id":"manas-2010:p1331:b001:l007","ordinal":57597,"en":"All the Muslims gathered round."},{"id":"manas-2010:p1331:b001:l008","ordinal":57598,"en":"If you looked then,"},{"id":"manas-2010:p1331:b001:l009","ordinal":57599,"en":"His face had filled out, radiant."},{"id":"manas-2010:p1331:b001:l010","ordinal":57600,"en":"A vigorous courser, a brave young man,"}]
