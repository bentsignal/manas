[{"id":"manas-2010:p0219:b001:l029","ordinal":9729,"en":"May I sink away unborn,"},{"id":"manas-2010:p0219:b001:l030","ordinal":9730,"en":"If I do not spear your lords down!"},{"id":"manas-2010:p0219:b001:l031","ordinal":9731,"en":"If I do not seize your stone-badged officials,"},{"id":"manas-2010:p0219:b001:l032","ordinal":9732,"en":"Among your red-tasseled men,"},{"id":"manas-2010:p0219:b001:l033","ordinal":9733,"en":"If I do not raise a costly slaughter!’"},{"id":"manas-2010:p0219:b001:l034","ordinal":9734,"en":"Terrible in might, fierce in menace,"},{"id":"manas-2010:p0219:b001:l035","ordinal":9735,"en":"Manas the lion raged:"},{"id":"manas-2010:p0219:b001:l036","ordinal":9736,"en":"‘Ah, three hearth stones, one hearth,"},{"id":"manas-2010:p0219:b001:l037","ordinal":9737,"en":"Wineskin-nosed, great glutton,"},{"id":"manas-2010:p0219:b001:l038","ordinal":9738,"en":"Whose hem has never touched the earth,"},{"id":"manas-2010:p0219:b001:l039","ordinal":9739,"en":"That my Lord is one,"},{"id":"manas-2010:p0219:b001:l040","ordinal":9740,"en":"You have never known it."},{"id":"manas-2010:p0219:b001:l041","ordinal":9741,"en":"You do not rise in the morning,"},{"id":"manas-2010:p0219:b001:l042","ordinal":9742,"en":"You bastard, uncircumcised dog,"},{"id":"manas-2010:p0219:b001:l043","ordinal":9743,"en":"You never wash your ancient dirt."},{"id":"manas-2010:p0219:b001:l044","ordinal":9744,"en":"Without saying this or that,"},{"id":"manas-2010:p0219:b001:l045","ordinal":9745,"en":"You eat livestock without slitting their throats."},{"id":"manas-2010:p0219:b001:l046","ordinal":9746,"en":"You have made your lamas one,"},{"id":"manas-2010:p0219:b001:l047","ordinal":9747,"en":"With many livestock but no head,"},{"id":"manas-2010:p0219:b001:l048","ordinal":9748,"en":"Always calling your idol God."},{"id":"manas-2010:p0220:b001:l001","ordinal":9749,"en":"Your gathered Black Kalmyks,"},{"id":"manas-2010:p0220:b001:l002","ordinal":9750,"en":"From the kakan of Beijing,"},{"id":"manas-2010:p0220:b001:l003","ordinal":9751,"en":"You have taken your khan's command."},{"id":"manas-2010:p0220:b001:l004","ordinal":9752,"en":"Your Black Kalmyk kalday"},{"id":"manas-2010:p0220:b001:l005","ordinal":9753,"en":"You have unleashed fierce wrath."},{"id":"manas-2010:p0220:b001:l006","ordinal":9754,"en":"Take your turn now,’ he said."},{"id":"manas-2010:p0220:b001:l007","ordinal":9755,"en":"‘If you have the strength, my Kalmyk,"},{"id":"manas-2010:p0220:b001:l008","ordinal":9756,"en":"Now suck me dry,’ he said."},{"id":"manas-2010:p0220:b001:l009","ordinal":9757,"en":"He now turned Toruchaar's head."},{"id":"manas-2010:p0220:b001:l010","ordinal":9758,"en":"‘Take your turn, Zholoy,’ he said."},{"id":"manas-2010:p0220:b001:l011","ordinal":9759,"en":"‘Put forth your full strength,’ he said."},{"id":"manas-2010:p0220:b001:l012","ordinal":9760,"en":"‘Stately great Kalmyk,"},{"id":"manas-2010:p0220:b001:l013","ordinal":9761,"en":"Come, take your revenge,’ he said."},{"id":"manas-2010:p0220:b001:l014","ordinal":9762,"en":"Without moving, without stirring,"},{"id":"manas-2010:p0220:b001:l015","ordinal":9763,"en":"The leopard touched by Kydyr"},{"id":"manas-2010:p0220:b001:l016","ordinal":9764,"en":"Stood looking, without the slightest movement."},{"id":"manas-2010:p0220:b001:l017","ordinal":9765,"en":"Khan Zholoy upon Achbuudan,"},{"id":"manas-2010:p0220:b001:l018","ordinal":9766,"en":"Scowling and spreading wide,"},{"id":"manas-2010:p0220:b001:l019","ordinal":9767,"en":"Swelling like a towering mountain,"},{"id":"manas-2010:p0220:b001:l020","ordinal":9768,"en":"Was one of the accomplished heroes."},{"id":"manas-2010:p0220:b001:l021","ordinal":9769,"en":"He looked and appraised Manas;"},{"id":"manas-2010:p0220:b001:l022","ordinal":9770,"en":"He himself was a discerning slave."},{"id":"manas-2010:p0220:b001:l023","ordinal":9771,"en":"‘Good heavens, his menace is unlike a man's;"},{"id":"manas-2010:p0220:b001:l024","ordinal":9772,"en":"He has the form of a lion.’"},{"id":"manas-2010:p0220:b001:l025","ordinal":9773,"en":"A black-spotted leopard,"},{"id":"manas-2010:p0220:b001:l026","ordinal":9774,"en":"Companion to the bloodthirsty hero,"},{"id":"manas-2010:p0220:b001:l027","ordinal":9775,"en":"Raged at his flank."},{"id":"manas-2010:p0220:b001:l028","ordinal":9776,"en":"A short-tailed, gray-maned lion,"},{"id":"manas-2010:p0220:b001:l029","ordinal":9777,"en":"As though about to seize,"},{"id":"manas-2010:p0220:b001:l030","ordinal":9778,"en":"The lion hero's retainer,"},{"id":"manas-2010:p0220:b001:l031","ordinal":9779,"en":"Raged behind him."},{"id":"manas-2010:p0220:b001:l032","ordinal":9780,"en":"At one glance, a thousand men,"},{"id":"manas-2010:p0220:b001:l033","ordinal":9781,"en":"Saying, ‘Watch the Kalmyk,’"},{"id":"manas-2010:p0220:b001:l034","ordinal":9782,"en":"As though lying in wait,"},{"id":"manas-2010:p0220:b001:l035","ordinal":9783,"en":"Crowded behind him."},{"id":"manas-2010:p0220:b001:l036","ordinal":9784,"en":"When he looked before him,"},{"id":"manas-2010:p0220:b001:l037","ordinal":9785,"en":"Its mouth opened like a chasm,"},{"id":"manas-2010:p0220:b001:l038","ordinal":9786,"en":"As though about to seize him,"},{"id":"manas-2010:p0220:b001:l039","ordinal":9787,"en":"A gray tiger lay in wait."},{"id":"manas-2010:p0220:b001:l040","ordinal":9788,"en":"If you looked at every limb,"},{"id":"manas-2010:p0220:b001:l041","ordinal":9789,"en":"A lion's form appeared."},{"id":"manas-2010:p0220:b001:l042","ordinal":9790,"en":"His mind bewildered, his heart burning,"},{"id":"manas-2010:p0220:b001:l043","ordinal":9791,"en":"Zholoy's spirit was troubled."},{"id":"manas-2010:p0220:b001:l044","ordinal":9792,"en":"When he looked all around,"},{"id":"manas-2010:p0220:b001:l045","ordinal":9793,"en":"That Burut who had just come"},{"id":"manas-2010:p0220:b001:l046","ordinal":9794,"en":"Showed the form of an ogre."},{"id":"manas-2010:p0220:b001:l047","ordinal":9795,"en":"Both champion and lion,"},{"id":"manas-2010:p0220:b001:l048","ordinal":9796,"en":"No such lion exists among men."},{"id":"manas-2010:p0221:b001:l001","ordinal":9797,"en":"Thick-armed, stone-hearted,"},{"id":"manas-2010:p0221:b001:l002","ordinal":9798,"en":"Strong-limbed, heedless,"},{"id":"manas-2010:p0221:b001:l003","ordinal":9799,"en":"Great in strength, fierce in menace,"},{"id":"manas-2010:p0221:b001:l004","ordinal":9800,"en":"Anyone who challenged him"},{"id":"manas-2010:p0221:b001:l005","ordinal":9801,"en":"He would lay utterly flat."},{"id":"manas-2010:p0221:b001:l006","ordinal":9802,"en":"He had a black cap as large as a house;"},{"id":"manas-2010:p0221:b001:l007","ordinal":9803,"en":"Throughout all the world,"},{"id":"manas-2010:p0221:b001:l008","ordinal":9804,"en":"He had the will to slaughter alone."},{"id":"manas-2010:p0221:b001:l009","ordinal":9805,"en":"Toruchaar beneath him,"},{"id":"manas-2010:p0221:b001:l010","ordinal":9806,"en":"No beast could match his stride."},{"id":"manas-2010:p0221:b001:l011","ordinal":9807,"en":"Against the bloodthirsty one riding him,"},{"id":"manas-2010:p0221:b001:l012","ordinal":9808,"en":"No strength would suffice in struggle."},{"id":"manas-2010:p0221:b001:l013","ordinal":9809,"en":"When one came to face him,"},{"id":"manas-2010:p0221:b001:l014","ordinal":9810,"en":"A mortal's spirit was troubled."},{"id":"manas-2010:p0221:b001:l015","ordinal":9811,"en":"Between his two cheeks,"},{"id":"manas-2010:p0221:b001:l016","ordinal":9812,"en":"A dragon's form appeared."},{"id":"manas-2010:p0221:b001:l017","ordinal":9813,"en":"He was a lion of great might;"},{"id":"manas-2010:p0221:b001:l018","ordinal":9814,"en":"Throughout all the world,"},{"id":"manas-2010:p0221:b001:l019","ordinal":9815,"en":"He was a man who would bring slaughter."},{"id":"manas-2010:p0221:b001:l020","ordinal":9816,"en":"Unnoticed, the wretched Burut"},{"id":"manas-2010:p0221:b001:l021","ordinal":9817,"en":"Was born here in Altai."},{"id":"manas-2010:p0221:b001:l022","ordinal":9818,"en":"Upon anyone who challenged him,"},{"id":"manas-2010:p0221:b001:l023","ordinal":9819,"en":"He would bring uproar."},{"id":"manas-2010:p0221:b001:l024","ordinal":9820,"en":"He was no lion born in vain;"},{"id":"manas-2010:p0221:b001:l025","ordinal":9821,"en":"He was no ordinary, easy boy."},{"id":"manas-2010:p0221:b001:l026","ordinal":9822,"en":"At the sight, the heart quivered;"},{"id":"manas-2010:p0221:b001:l027","ordinal":9823,"en":"It was known he was a lion."},{"id":"manas-2010:p0221:b001:l028","ordinal":9824,"en":"As soon as the hero Zholoy saw him,"},{"id":"manas-2010:p0221:b001:l029","ordinal":9825,"en":"He saw Manas and grieved."},{"id":"manas-2010:p0221:b001:l030","ordinal":9826,"en":"Observing him, the hero Zholoy"},{"id":"manas-2010:p0221:b001:l031","ordinal":9827,"en":"Despaired of his own life."},{"id":"manas-2010:p0221:b001:l032","ordinal":9828,"en":"Thrusting his spear without drawing back,"},{"id":"manas-2010:p0221:b001:l033","ordinal":9829,"en":"Not recoiling from death a hair's breadth,"},{"id":"manas-2010:p0221:b001:l034","ordinal":9830,"en":"He struck Achbuudan once,"},{"id":"manas-2010:p0221:b001:l035","ordinal":9831,"en":"Took his spear in wrath."},{"id":"manas-2010:p0221:b001:l036","ordinal":9832,"en":"Like a cloud about to rain again,"},{"id":"manas-2010:p0221:b001:l037","ordinal":9833,"en":"Wrath spread over his face."},{"id":"manas-2010:p0221:b001:l038","ordinal":9834,"en":"The hair on his crown bristled."},{"id":"manas-2010:p0221:b001:l039","ordinal":9835,"en":"The valiant champion Zholoy"},{"id":"manas-2010:p0221:b001:l040","ordinal":9836,"en":"Thrust his spear at Manas."},{"id":"manas-2010:p0221:b001:l041","ordinal":9837,"en":"To the unbeliever full of strength,"},{"id":"manas-2010:p0221:b001:l042","ordinal":9838,"en":"The hero Manas gave his turn"},{"id":"manas-2010:p0221:b001:l043","ordinal":9839,"en":"And now stood without stirring."},{"id":"manas-2010:p0221:b001:l044","ordinal":9840,"en":"The hero Zholoy faced him and stabbed."},{"id":"manas-2010:p0221:b001:l045","ordinal":9841,"en":"Manas the mighty predator, the dear lion,"},{"id":"manas-2010:p0221:b001:l046","ordinal":9842,"en":"Rang ‘zing, zing,’ unconcerned."},{"id":"manas-2010:p0221:b001:l047","ordinal":9843,"en":"Champion Zholoy's thrust,"},{"id":"manas-2010:p0221:b001:l048","ordinal":9844,"en":"He counted it as nothing."},{"id":"manas-2010:p0222:b001:l001","ordinal":9845,"en":"There was no unbeliever as mighty as Zholoy."},{"id":"manas-2010:p0222:b001:l002","ordinal":9846,"en":"The Kalmyks' Zholoy,"},{"id":"manas-2010:p0222:b001:l003","ordinal":9847,"en":"He did not count him as half a hair."},{"id":"manas-2010:p0222:b001:l004","ordinal":9848,"en":"When Zholoy shouted and stabbed,"},{"id":"manas-2010:p0222:b001:l005","ordinal":9849,"en":"His spear shattered into fragments."},{"id":"manas-2010:p0222:b001:l006","ordinal":9850,"en":"The valiant, wolf-maned Manas's"},{"id":"manas-2010:p0222:b001:l007","ordinal":9851,"en":"Lionhood became known."},{"id":"manas-2010:p0222:b001:l008","ordinal":9852,"en":"Achbuudan beneath him,"},{"id":"manas-2010:p0222:b001:l009","ordinal":9853,"en":"The hero Zholoy's tulpar,"},{"id":"manas-2010:p0222:b001:l010","ordinal":9854,"en":"Sank to his knees in the earth."},{"id":"manas-2010:p0222:b001:l011","ordinal":9855,"en":"Though he stabbed hard, Khan Manas"},{"id":"manas-2010:p0222:b001:l012","ordinal":9856,"en":"Did not even tilt once."},{"id":"manas-2010:p0222:b001:l013","ordinal":9857,"en":"The Kalmyks' Khan Zholoy"},{"id":"manas-2010:p0222:b001:l014","ordinal":9858,"en":"Worked his mind and pondered."},{"id":"manas-2010:p0222:b001:l015","ordinal":9859,"en":"Not the slightest means remained."},{"id":"manas-2010:p0222:b001:l016","ordinal":9860,"en":"Valiant Zholoy, the bloodthirsty hero,"},{"id":"manas-2010:p0222:b001:l017","ordinal":9861,"en":"Prepared a way to flee."},{"id":"manas-2010:p0222:b001:l018","ordinal":9862,"en":"‘If Manas turns, he will devour me."},{"id":"manas-2010:p0222:b001:l019","ordinal":9863,"en":"If the Burut stabs, he will do me no good."},{"id":"manas-2010:p0222:b001:l020","ordinal":9864,"en":"This bastard Burut"},{"id":"manas-2010:p0222:b001:l021","ordinal":9865,"en":"Certainly will not leave me unharmed."},{"id":"manas-2010:p0222:b001:l022","ordinal":9866,"en":"This bastard, bloodthirsty one,"},{"id":"manas-2010:p0222:b001:l023","ordinal":9867,"en":"This cunning one standing in the joust,"},{"id":"manas-2010:p0222:b001:l024","ordinal":9868,"en":"His lionhood was known long ago."},{"id":"manas-2010:p0222:b001:l025","ordinal":9869,"en":"Six years before he was born,"},{"id":"manas-2010:p0222:b001:l026","ordinal":9870,"en":"Of the kakan's Beijing,"},{"id":"manas-2010:p0222:b001:l027","ordinal":9871,"en":"It was written in the book."},{"id":"manas-2010:p0222:b001:l028","ordinal":9872,"en":"He is that bloodthirsty Burut himself."},{"id":"manas-2010:p0222:b001:l029","ordinal":9873,"en":"Since I became Zholoy,"},{"id":"manas-2010:p0222:b001:l030","ordinal":9874,"en":"Since, alas, I won the name Zholoy,"},{"id":"manas-2010:p0222:b001:l031","ordinal":9875,"en":"I have never seen such a lion."},{"id":"manas-2010:p0222:b001:l032","ordinal":9876,"en":"I was a champion, I was a lion;"},{"id":"manas-2010:p0222:b001:l033","ordinal":9877,"en":"I have become worthless."},{"id":"manas-2010:p0222:b001:l034","ordinal":9878,"en":"Who confounded the world,"},{"id":"manas-2010:p0222:b001:l035","ordinal":9879,"en":"I was the renowned hero Zholoy;"},{"id":"manas-2010:p0222:b001:l036","ordinal":9880,"en":"I have come to ruin."},{"id":"manas-2010:p0222:b001:l037","ordinal":9881,"en":"All my wrathful strength is gone;"},{"id":"manas-2010:p0222:b001:l038","ordinal":9882,"en":"I have no strength as before."},{"id":"manas-2010:p0222:b001:l039","ordinal":9883,"en":"I have become worthless,’"},{"id":"manas-2010:p0222:b001:l040","ordinal":9884,"en":"Thus Khan Zholoy spoke,"},{"id":"manas-2010:p0222:b001:l041","ordinal":9885,"en":"Thinking confused, muttering thoughts."},{"id":"manas-2010:p0222:b001:l042","ordinal":9886,"en":"While Zholoy stood like this,"},{"id":"manas-2010:p0222:b001:l043","ordinal":9887,"en":"The tiger, the generous one, the leopard,"},{"id":"manas-2010:p0222:b001:l044","ordinal":9888,"en":"Poised himself and raged."},{"id":"manas-2010:p0222:b001:l045","ordinal":9889,"en":"To spear Zholoy,"},{"id":"manas-2010:p0222:b001:l046","ordinal":9890,"en":"Your generous tiger prepared himself."},{"id":"manas-2010:p0222:b001:l047","ordinal":9891,"en":"Without looking all around,"},{"id":"manas-2010:p0222:b001:l048","ordinal":9892,"en":"Your ocean thrust his spear."},{"id":"manas-2010:p0223:b001:l001","ordinal":9893,"en":"Not sparing his life at all."},{"id":"manas-2010:p0223:b001:l002","ordinal":9894,"en":"Without looking from side to side,"},{"id":"manas-2010:p0223:b001:l003","ordinal":9895,"en":"He shouted and thrust his spear,"},{"id":"manas-2010:p0223:b001:l004","ordinal":9896,"en":"Not sparing his life a whit."},{"id":"manas-2010:p0223:b001:l005","ordinal":9897,"en":"Wearing a coat of blue-gray iron,"},{"id":"manas-2010:p0223:b001:l006","ordinal":9898,"en":"Taking a green-sapling spear in hand,"},{"id":"manas-2010:p0223:b001:l007","ordinal":9899,"en":"Striking Toruchaar once on the thigh,"},{"id":"manas-2010:p0223:b001:l008","ordinal":9900,"en":"Readying the spear in his hand,"},{"id":"manas-2010:p0223:b001:l009","ordinal":9901,"en":"He troubled those who saw him."},{"id":"manas-2010:p0223:b001:l010","ordinal":9902,"en":"Plainly the dear hero"},{"id":"manas-2010:p0223:b001:l011","ordinal":9903,"en":"Showed his wolf-maned bearing."},{"id":"manas-2010:p0223:b001:l012","ordinal":9904,"en":"To take his turn from Zholoy,"},{"id":"manas-2010:p0223:b001:l013","ordinal":9905,"en":"To die if death should come,"},{"id":"manas-2010:p0223:b001:l014","ordinal":9906,"en":"The hero Manas, with Zholoy,"},{"id":"manas-2010:p0223:b001:l015","ordinal":9907,"en":"To try a bout of fighting,"},{"id":"manas-2010:p0223:b001:l016","ordinal":9908,"en":"Bloodthirsty Manas, the blood drinker,"},{"id":"manas-2010:p0223:b001:l017","ordinal":9909,"en":"Before one could say this or that,"},{"id":"manas-2010:p0223:b001:l018","ordinal":9910,"en":"Before an eye could blink,"},{"id":"manas-2010:p0223:b001:l019","ordinal":9911,"en":"Your valiant Manas faced him"},{"id":"manas-2010:p0223:b001:l020","ordinal":9912,"en":"And reached Khan Zholoy."},{"id":"manas-2010:p0223:b001:l021","ordinal":9913,"en":"Upon reaching Zholoy—"},{"id":"manas-2010:p0223:b001:l022","ordinal":9914,"en":"Were it not for his bloodthirstiness,"},{"id":"manas-2010:p0223:b001:l023","ordinal":9915,"en":"Would anyone other than Khan Manas"},{"id":"manas-2010:p0223:b001:l024","ordinal":9916,"en":"Dare approach Khan Zholoy?"},{"id":"manas-2010:p0223:b001:l025","ordinal":9917,"en":"What sort of being was Zholoy?"},{"id":"manas-2010:p0223:b001:l026","ordinal":9918,"en":"Manas, who attacked the hero Zholoy,"},{"id":"manas-2010:p0223:b001:l027","ordinal":9919,"en":"What sort of lion was he?"},{"id":"manas-2010:p0223:b001:l028","ordinal":9920,"en":"His chest like a hungry lion's,"},{"id":"manas-2010:p0223:b001:l029","ordinal":9921,"en":"His eyes like a keen hunting hawk's,"},{"id":"manas-2010:p0223:b001:l030","ordinal":9922,"en":"Manas came up shouting."},{"id":"manas-2010:p0223:b001:l031","ordinal":9923,"en":"Upon reaching Zholoy, he said:"},{"id":"manas-2010:p0223:b001:l032","ordinal":9924,"en":"‘The pommel of the Kalmyk saddle,"},{"id":"manas-2010:p0223:b001:l033","ordinal":9925,"en":"Right at the crown of the heart.’"},{"id":"manas-2010:p0223:b001:l034","ordinal":9926,"en":"Your unbeliever born ready"},{"id":"manas-2010:p0223:b001:l035","ordinal":9927,"en":"Now charged and thrust his spear."},{"id":"manas-2010:p0223:b001:l036","ordinal":9928,"en":"The Kalmyk khan Zholoy's"},{"id":"manas-2010:p0223:b001:l037","ordinal":9929,"en":"Feet slipped from the stirrups;"},{"id":"manas-2010:p0223:b001:l038","ordinal":9930,"en":"His backside tilted from the saddle."},{"id":"manas-2010:p0223:b001:l039","ordinal":9931,"en":"Both skirts of his coat flapped;"},{"id":"manas-2010:p0223:b001:l040","ordinal":9932,"en":"He despaired of his precious life."},{"id":"manas-2010:p0223:b001:l041","ordinal":9933,"en":"The Kalmyks' Zholoy,"},{"id":"manas-2010:p0223:b001:l042","ordinal":9934,"en":"His two eyes blazed."},{"id":"manas-2010:p0223:b001:l043","ordinal":9935,"en":"Despairing of his precious life,"},{"id":"manas-2010:p0223:b001:l044","ordinal":9936,"en":"He seized the crupper."},{"id":"manas-2010:p0223:b001:l045","ordinal":9937,"en":"His whole inside burned."},{"id":"manas-2010:p0223:b001:l046","ordinal":9938,"en":"The Kalmyks' Zholoy"},{"id":"manas-2010:p0223:b001:l047","ordinal":9939,"en":"Despaired of his fly-like life."},{"id":"manas-2010:p0223:b001:l048","ordinal":9940,"en":"‘If the Burut turns, I am dead."},{"id":"manas-2010:p0224:b001:l001","ordinal":9941,"en":"From a twelve-year-old Burut"},{"id":"manas-2010:p0224:b001:l002","ordinal":9942,"en":"I have seen death all too clearly,’ he said."},{"id":"manas-2010:p0224:b001:l003","ordinal":9943,"en":"His wits gone, drooping,"},{"id":"manas-2010:p0224:b001:l004","ordinal":9944,"en":"Unable to gather his senses,"},{"id":"manas-2010:p0224:b001:l005","ordinal":9945,"en":"The hero Zholoy stood bewildered."},{"id":"manas-2010:p0224:b001:l006","ordinal":9946,"en":"Helpless, he roared,"},{"id":"manas-2010:p0224:b001:l007","ordinal":9947,"en":"Crying the battle cry ‘Möndü!’"},{"id":"manas-2010:p0224:b001:l008","ordinal":9948,"en":"Before Manas could turn and come,"},{"id":"manas-2010:p0224:b001:l009","ordinal":9949,"en":"The Kalmyks' Zholoy"},{"id":"manas-2010:p0224:b001:l010","ordinal":9950,"en":"Called his giant Kaman."},{"id":"manas-2010:p0224:b001:l011","ordinal":9951,"en":"Vulture-tailed Zhoon the giant,"},{"id":"manas-2010:p0224:b001:l012","ordinal":9952,"en":"He shouted for his giant Zhoon."},{"id":"manas-2010:p0224:b001:l013","ordinal":9953,"en":"Sixty zhaysangs and forty giants,"},{"id":"manas-2010:p0224:b001:l014","ordinal":9954,"en":"Forming a fortress around Zholoy,"},{"id":"manas-2010:p0224:b001:l015","ordinal":9955,"en":"Came and surrounded him."},{"id":"manas-2010:p0224:b001:l016","ordinal":9956,"en":"Propping and supporting Zholoy,"},{"id":"manas-2010:p0224:b001:l017","ordinal":9957,"en":"They set him right and moved away."},{"id":"manas-2010:p0224:b001:l018","ordinal":9958,"en":"Raising strife behind them,"},{"id":"manas-2010:p0224:b001:l019","ordinal":9959,"en":"Gliding like a white lion,"},{"id":"manas-2010:p0224:b001:l020","ordinal":9960,"en":"Your valiant Manas headed toward them."},{"id":"manas-2010:p0224:b001:l021","ordinal":9961,"en":"Without sparing his marked life,"},{"id":"manas-2010:p0224:b001:l022","ordinal":9962,"en":"He now reached the champions."},{"id":"manas-2010:p0224:b001:l023","ordinal":9963,"en":"Scissor-eared Kaman the giant,"},{"id":"manas-2010:p0224:b001:l024","ordinal":9964,"en":"Vulture-tailed Zhoon the giant,"},{"id":"manas-2010:p0224:b001:l025","ordinal":9965,"en":"The mighty champions in his path,"},{"id":"manas-2010:p0224:b001:l026","ordinal":9966,"en":"Before the leopard lord, the bloodthirsty one,"},{"id":"manas-2010:p0224:b001:l027","ordinal":9967,"en":"They came out to meet him."},{"id":"manas-2010:p0224:b001:l028","ordinal":9968,"en":"Breaking through champions, making a road,"},{"id":"manas-2010:p0224:b001:l029","ordinal":9969,"en":"Among the jacket-wearing champions,"},{"id":"manas-2010:p0224:b001:l030","ordinal":9970,"en":"He attacked the strongest."},{"id":"manas-2010:p0224:b001:l031","ordinal":9971,"en":"Standing face to face,"},{"id":"manas-2010:p0224:b001:l032","ordinal":9972,"en":"The wolf-maned heroes thrust their spears,"},{"id":"manas-2010:p0224:b001:l033","ordinal":9973,"en":"Facing each other in battle."},{"id":"manas-2010:p0224:b001:l034","ordinal":9974,"en":"When they struck, the spears"},{"id":"manas-2010:p0224:b001:l035","ordinal":9975,"en":"Broke and shattered like dry stalks."},{"id":"manas-2010:p0224:b001:l036","ordinal":9976,"en":"White fibers from the spear tips"},{"id":"manas-2010:p0224:b001:l037","ordinal":9977,"en":"Flew flapping and whirring."},{"id":"manas-2010:p0224:b001:l038","ordinal":9978,"en":"When the spears were of no use,"},{"id":"manas-2010:p0224:b001:l039","ordinal":9979,"en":"They took battle-axes in hand."},{"id":"manas-2010:p0224:b001:l040","ordinal":9980,"en":"Without blinking, the wolf-maned heroes"},{"id":"manas-2010:p0224:b001:l041","ordinal":9981,"en":"Fought with these."},{"id":"manas-2010:p0224:b001:l042","ordinal":9982,"en":"The battle-axes broke and shattered;"},{"id":"manas-2010:p0224:b001:l043","ordinal":9983,"en":"Not a handspan remained intact."},{"id":"manas-2010:p0224:b001:l044","ordinal":9984,"en":"They broke utterly with a shriek."}]
