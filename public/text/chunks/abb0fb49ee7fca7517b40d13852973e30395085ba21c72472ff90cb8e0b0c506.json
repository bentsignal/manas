[{"id":"semetey-1-2013:p0225:b005:l005","ordinal":93953,"en":"To the fierce lord Chubak,"},{"id":"semetey-1-2013:p0225:b005:l006","ordinal":93954,"en":"Of all the round-hoofed horses"},{"id":"semetey-1-2013:p0225:b005:l007","ordinal":93955,"en":"Not a single one appealed."},{"id":"semetey-1-2013:p0225:b005:l008","ordinal":93956,"en":"At that time your Chubak"},{"id":"semetey-1-2013:p0225:b005:l009","ordinal":93957,"en":"Saw a vision in his sleep,"},{"id":"semetey-1-2013:p0225:b005:l010","ordinal":93958,"en":"Dreamed a wondrous, happy dream."},{"id":"semetey-1-2013:p0225:b005:l011","ordinal":93959,"en":"Startled awake from sleep,"},{"id":"semetey-1-2013:p0225:b005:l012","ordinal":93960,"en":"Stirring like a lion,"},{"id":"semetey-1-2013:p0225:b005:l013","ordinal":93961,"en":"At the hour of midnight"},{"id":"semetey-1-2013:p0225:b005:l014","ordinal":93962,"en":"He set off in a frenzy."},{"id":"semetey-1-2013:p0225:b005:l015","ordinal":93963,"en":"When the dawn shone clear,"},{"id":"semetey-1-2013:p0225:b005:l016","ordinal":93964,"en":"In the desert of Mediyan,"},{"id":"semetey-1-2013:p0225:b005:l017","ordinal":93965,"en":"At spear-high Kara-Kum,"},{"id":"semetey-1-2013:p0225:b005:l018","ordinal":93966,"en":"Where he lay exhausted,"},{"id":"semetey-1-2013:p0225:b005:l019","ordinal":93967,"en":"Kokala, whom he would ride,"},{"id":"semetey-1-2013:p0225:b005:l020","ordinal":93968,"en":"Was just entering his fifth year."},{"id":"semetey-1-2013:p0225:b005:l021","ordinal":93969,"en":"At that time Kokala"},{"id":"semetey-1-2013:p0225:b005:l022","ordinal":93970,"en":"Was indeed in his fifth year."},{"id":"semetey-1-2013:p0225:b005:l023","ordinal":93971,"en":"Born of Kulan-Sur,"},{"id":"semetey-1-2013:p0225:b005:l024","ordinal":93972,"en":"He was a fully gifted steed."},{"id":"semetey-1-2013:p0225:b005:l025","ordinal":93973,"en":"The red-bearded elder Kayyp"},{"id":"semetey-1-2013:p0225:b005:l026","ordinal":93974,"en":"From the desert of Mediyan"},{"id":"semetey-1-2013:p0225:b005:l027","ordinal":93975,"en":"Had led him on a tether."},{"id":"semetey-1-2013:p0225:b005:l028","ordinal":93976,"en":"Before your champion Chubak"},{"id":"semetey-1-2013:p0225:b005:l029","ordinal":93977,"en":"He had brought the horse."},{"id":"semetey-1-2013:p0225:b005:l030","ordinal":93978,"en":"When he wore a blue reps coat,"},{"id":"semetey-1-2013:p0225:b005:l031","ordinal":93979,"en":"When your Chubak rode Kokala,"},{"id":"semetey-1-2013:p0225:b005:l032","ordinal":93980,"en":"Hearing of his awesome spirit,"},{"id":"semetey-1-2013:p0225:b005:l033","ordinal":93981,"en":"Far-off enemies grieved."},{"id":"semetey-1-2013:p0225:b005:l034","ordinal":93982,"en":"'The few Muslims,"},{"id":"semetey-1-2013:p0225:b005:l035","ordinal":93983,"en":"If he wishes, he will bring under his rule,'"},{"id":"semetey-1-2013:p0225:b005:l036","ordinal":93984,"en":"His father Baltai said with joy."},{"id":"semetey-1-2013:p0225:b005:l037","ordinal":93985,"en":"When he reached twelve years,"},{"id":"semetey-1-2013:p0225:b005:l038","ordinal":93986,"en":"He stirred strife in so many lands,"},{"id":"semetey-1-2013:p0225:b005:l039","ordinal":93987,"en":"That lion Chubak, the fearless one—"},{"id":"semetey-1-2013:p0226:b003:l001","ordinal":93988,"en":"More than that, he besieged Kashgar and took it six times."},{"id":"semetey-1-2013:p0226:b003:l003","ordinal":93989,"en":"When he reached thirteen years,"},{"id":"semetey-1-2013:p0226:b003:l004","ordinal":93990,"en":"He besieged the Afghans and took them ten times."},{"id":"semetey-1-2013:p0226:b003:l005","ordinal":93991,"en":"Wading in blood, he grew hardened,"},{"id":"semetey-1-2013:p0226:b003:l006","ordinal":93992,"en":"Won the name of Chubak the Leopard."},{"id":"semetey-1-2013:p0226:b003:l007","ordinal":93993,"en":"When he reached sixteen,"},{"id":"semetey-1-2013:p0226:b003:l008","ordinal":93994,"en":"He was called Chubak the Destroyer."},{"id":"semetey-1-2013:p0226:b003:l009","ordinal":93995,"en":"The red steel bent"},{"id":"semetey-1-2013:p0226:b003:l010","ordinal":93996,"en":"As with your Khydyr-blessed warrior brother-in-law"},{"id":"semetey-1-2013:p0226:b003:l011","ordinal":93997,"en":"He jousted forty-eight days."},{"id":"semetey-1-2013:p0226:b003:l012","ordinal":93998,"en":"Recognizing his fortune,"},{"id":"semetey-1-2013:p0226:b003:l013","ordinal":93999,"en":"A star stirred in the sky;"},{"id":"semetey-1-2013:p0226:b003:l014","ordinal":94000,"en":"They became friends for the next world,"},{"id":"semetey-1-2013:p0226:b003:l015","ordinal":94001,"en":"And he made his home in Talas,"},{"id":"semetey-1-2013:p0226:b003:l016","ordinal":94002,"en":"Became a companion of Manas."},{"id":"semetey-1-2013:p0226:b003:l017","ordinal":94003,"en":"To the fortunate warrior Manas"},{"id":"semetey-1-2013:p0226:b003:l018","ordinal":94004,"en":"Came men who were his equals:"},{"id":"semetey-1-2013:p0226:b003:l019","ordinal":94005,"en":"Forty-two warriors, forty companions,"},{"id":"semetey-1-2013:p0226:b003:l020","ordinal":94006,"en":"Every one apart from other men,"},{"id":"semetey-1-2013:p0226:b003:l021","ordinal":94007,"en":"Fearless champions who could wreck the world,"},{"id":"semetey-1-2013:p0226:b003:l022","ordinal":94008,"en":"Forty-two equal lions came."},{"id":"semetey-1-2013:p0226:b003:l023","ordinal":94009,"en":"Such is the tale of Chubak."},{"id":"semetey-1-2013:p0226:b003:l024","ordinal":94010,"en":"Let me leave that here"},{"id":"semetey-1-2013:p0226:b003:l025","ordinal":94011,"en":"And of Azyz Khan's Almambet"},{"id":"semetey-1-2013:p0226:b003:l026","ordinal":94012,"en":"Begin to tell the news."},{"id":"semetey-1-2013:p0226:b003:l027","ordinal":94013,"en":"With golden forelock and tasseled belt,"},{"id":"semetey-1-2013:p0226:b003:l028","ordinal":94014,"en":"Azyz Khan's only son"},{"id":"semetey-1-2013:p0226:b003:l029","ordinal":94015,"en":"Was a mighty khan in Kakan."},{"id":"semetey-1-2013:p0226:b003:l030","ordinal":94016,"en":"He too was a blessed soul."},{"id":"semetey-1-2013:p0226:b003:l031","ordinal":94017,"en":"Your Alake was conceived of light,"},{"id":"semetey-1-2013:p0226:b003:l032","ordinal":94018,"en":"Himself the son of light,"},{"id":"semetey-1-2013:p0226:b003:l033","ordinal":94019,"en":"Almambet, that blessed soul."},{"id":"semetey-1-2013:p0226:b003:l034","ordinal":94020,"en":"His father, the Chinese Azyz Khan,"},{"id":"semetey-1-2013:p0226:b003:l035","ordinal":94021,"en":"Said, 'I have seen Almambet,'"},{"id":"semetey-1-2013:p0226:b003:l036","ordinal":94022,"en":"And swept the grime from his heart."},{"id":"semetey-1-2013:p0226:b003:l037","ordinal":94023,"en":"The forty tribes of Chinese-Kakan folk"},{"id":"semetey-1-2013:p0226:b003:l038","ordinal":94024,"en":"Struggled, unable to name him,"},{"id":"semetey-1-2013:p0226:b003:l039","ordinal":94025,"en":"And were sorely troubled."},{"id":"semetey-1-2013:p0226:b004:l001","ordinal":94026,"en":"At about noon there arrived"},{"id":"semetey-1-2013:p0226:b004:l002","ordinal":94027,"en":"The white-bearded dervish Khydyr."},{"id":"semetey-1-2013:p0226:b004:l003","ordinal":94028,"en":"He banished all their sorrow,"},{"id":"semetey-1-2013:p0226:b004:l004","ordinal":94029,"en":"Named him Khan Almambet."},{"id":"semetey-1-2013:p0226:b004:l005","ordinal":94030,"en":"Receiving the elder's blessing,"},{"id":"semetey-1-2013:p0226:b004:l006","ordinal":94031,"en":"He was given the name Almambet."},{"id":"semetey-1-2013:p0226:b004:l007","ordinal":94032,"en":"When that fierce warrior was born,"},{"id":"semetey-1-2013:p0226:b004:l008","ordinal":94033,"en":"The tips of his ears were pierced."},{"id":"semetey-1-2013:p0226:b004:l009","ordinal":94034,"en":"He had come out of the womb"},{"id":"semetey-1-2013:p0226:b004:l010","ordinal":94035,"en":"With his foreskin already cut."},{"id":"semetey-1-2013:p0226:b004:l011","ordinal":94036,"en":"His forehead reached the earth."},{"id":"semetey-1-2013:p0226:b004:l012","ordinal":94037,"en":"For eighty days waters flowed"},{"id":"semetey-1-2013:p0226:b004:l013","ordinal":94038,"en":"And earthquakes shook the ground."},{"id":"semetey-1-2013:p0226:b004:l014","ordinal":94039,"en":"When the Chinese diviner"},{"id":"semetey-1-2013:p0226:b004:l015","ordinal":94040,"en":"Would seize and torment him,"},{"id":"semetey-1-2013:p0226:b004:l016","ordinal":94041,"en":"Would cast him in a pit forty cubits deep,"},{"id":"semetey-1-2013:p0226:b004:l017","ordinal":94042,"en":"An amulet was hung about his neck"},{"id":"semetey-1-2013:p0226:b004:l018","ordinal":94043,"en":"And his maternal grandfather Sooronduk Khan was made to raise him."},{"id":"semetey-1-2013:p0226:b004:l019","ordinal":94044,"en":"He grew up in Sooronduk's land,"},{"id":"semetey-1-2013:p0226:b004:l020","ordinal":94045,"en":"Saw a holy man in his dream,"},{"id":"semetey-1-2013:p0226:b004:l021","ordinal":94046,"en":"Saw both Paradise and Hell."},{"id":"semetey-1-2013:p0226:b004:l022","ordinal":94047,"en":"Through his valor, the warrior Alman"},{"id":"semetey-1-2013:p0226:b004:l023","ordinal":94048,"en":"Studied wonders and grew inspired."},{"id":"semetey-1-2013:p0226:b004:l024","ordinal":94049,"en":"In his youth he found Sarala,"},{"id":"semetey-1-2013:p0226:b004:l025","ordinal":94050,"en":"Born of a wild ass."},{"id":"semetey-1-2013:p0226:b004:l026","ordinal":94051,"en":"When he reached twelve years,"},{"id":"semetey-1-2013:p0226:b004:l027","ordinal":94052,"en":"Konurbai, Alooke's son—"},{"id":"semetey-1-2013:p0226:b004:l028","ordinal":94053,"en":"He laid siege to Konurbai."},{"id":"semetey-1-2013:p0226:b004:l029","ordinal":94054,"en":"Everyone except Karykan"},{"id":"semetey-1-2013:p0226:b004:l030","ordinal":94055,"en":"He smashed to pieces,"},{"id":"semetey-1-2013:p0226:b004:l031","ordinal":94056,"en":"Your Alman beat them utterly."},{"id":"semetey-1-2013:p0226:b004:l032","ordinal":94057,"en":"The Manchu warrior Esen Khan"},{"id":"semetey-1-2013:p0226:b004:l033","ordinal":94058,"en":"He besieged for twenty-four days."},{"id":"semetey-1-2013:p0226:b004:l034","ordinal":94059,"en":"Great Beijing was left helpless,"},{"id":"semetey-1-2013:p0226:b004:l035","ordinal":94060,"en":"Placed a golden crown upon him,"},{"id":"semetey-1-2013:p0226:b004:l036","ordinal":94061,"en":"Upon Karykan's golden throne"},{"id":"semetey-1-2013:p0226:b004:l037","ordinal":94062,"en":"They seated him without restraint."},{"id":"semetey-1-2013:p0226:b004:l038","ordinal":94063,"en":"He too, in Kakan's Beijing,"},{"id":"semetey-1-2013:p0226:b004:l039","ordinal":94064,"en":"Became a man of sacred might."},{"id":"semetey-1-2013:p0227:b003:l001","ordinal":94065,"en":"Indeed, in Kakan's Beijing"},{"id":"semetey-1-2013:p0227:b003:l002","ordinal":94066,"en":"He was khan for twenty-four months."},{"id":"semetey-1-2013:p0227:b003:l003","ordinal":94067,"en":"While he ruled as Kakan khan,"},{"id":"semetey-1-2013:p0227:b003:l004","ordinal":94068,"en":"When he served his God,"},{"id":"semetey-1-2013:p0227:b003:l005","ordinal":94069,"en":"His gathered wealth was left in Kakan;"},{"id":"semetey-1-2013:p0227:b003:l006","ordinal":94070,"en":"What he desired was faith."},{"id":"semetey-1-2013:p0227:b003:l007","ordinal":94071,"en":"His gathered wealth was left in Beijing;"},{"id":"semetey-1-2013:p0227:b003:l008","ordinal":94072,"en":"What he cherished was faith."},{"id":"semetey-1-2013:p0227:b003:l009","ordinal":94073,"en":"Casting away his golden throne,"},{"id":"semetey-1-2013:p0227:b003:l010","ordinal":94074,"en":"Saying, 'He will not enter Islam,'"},{"id":"semetey-1-2013:p0227:b003:l011","ordinal":94075,"en":"He killed his father Azyz Khan."},{"id":"semetey-1-2013:p0227:b003:l012","ordinal":94076,"en":"Cleansed of the dark religion,"},{"id":"semetey-1-2013:p0227:b003:l013","ordinal":94077,"en":"Fleeing the unbelievers, estranged from them,"},{"id":"semetey-1-2013:p0227:b003:l014","ordinal":94078,"en":"He came and settled in Talas."},{"id":"semetey-1-2013:p0227:b003:l015","ordinal":94079,"en":"He too became a companion of Manas."},{"id":"semetey-1-2013:p0227:b003:l016","ordinal":94080,"en":"When they campaigned against Kakan,"},{"id":"semetey-1-2013:p0227:b003:l017","ordinal":94081,"en":"When they wrought devastation,"},{"id":"semetey-1-2013:p0227:b003:l018","ordinal":94082,"en":"The lions Almambet and Chubak died,"},{"id":"semetey-1-2013:p0227:b003:l019","ordinal":94083,"en":"Egizey and Shooruk died together,"},{"id":"semetey-1-2013:p0227:b003:l020","ordinal":94084,"en":"Muzburchak and Khan Kokcho died,"},{"id":"semetey-1-2013:p0227:b003:l021","ordinal":94085,"en":"Everyone who reached Beijing died."},{"id":"semetey-1-2013:p0227:b003:l023","ordinal":94086,"en":"Beijing, forty days' journey across,"},{"id":"semetey-1-2013:p0227:b003:l024","ordinal":94087,"en":"He had scouted round its edges."},{"id":"semetey-1-2013:p0227:b003:l025","ordinal":94088,"en":"All the mighty men"},{"id":"semetey-1-2013:p0227:b003:l026","ordinal":94089,"en":"He let the Chinese take as gifts."},{"id":"semetey-1-2013:p0227:b003:l027","ordinal":94090,"en":"In anguish my brother-in-law died too."},{"id":"semetey-1-2013:p0227:b003:l028","ordinal":94091,"en":"There was no male child of his line."},{"id":"semetey-1-2013:p0227:b003:l029","ordinal":94092,"en":"Fleeing Talas in distress,"},{"id":"semetey-1-2013:p0227:b003:l030","ordinal":94093,"en":"Left the widow of Manas,"},{"id":"semetey-1-2013:p0227:b003:l031","ordinal":94094,"en":"My elder sister came wandering."},{"id":"semetey-1-2013:p0227:b003:l032","ordinal":94095,"en":"Widowed, without recourse,"},{"id":"semetey-1-2013:p0227:b003:l033","ordinal":94096,"en":"With no son of my brother-in-law."},{"id":"semetey-1-2013:p0227:b003:l034","ordinal":94097,"en":"As they say, one camps along a river;"},{"id":"semetey-1-2013:p0227:b003:l035","ordinal":94098,"en":"For a woman whose husband dies,"},{"id":"semetey-1-2013:p0227:b003:l036","ordinal":94099,"en":"Her own kin are close, they say."},{"id":"semetey-1-2013:p0227:b003:l037","ordinal":94100,"en":"Wearing a loose, flapping felt cloak,"},{"id":"semetey-1-2013:p0227:b003:l038","ordinal":94101,"en":"Grieving, weeping, stumbling along,"},{"id":"semetey-1-2013:p0227:b003:l039","ordinal":94102,"en":"She came hurrying as a widow,"},{"id":"semetey-1-2013:p0227:b005:l001","ordinal":94103,"en":"Came wandering to Bukhara,"},{"id":"semetey-1-2013:p0227:b005:l002","ordinal":94104,"en":"Had her fill of suffering."},{"id":"semetey-1-2013:p0227:b005:l003","ordinal":94105,"en":"Living widowed, she grew wild."},{"id":"semetey-1-2013:p0227:b005:l004","ordinal":94106,"en":"May she sink into the earth, that woman,"},{"id":"semetey-1-2013:p0227:b005:l005","ordinal":94107,"en":"Crazed with racing horses!"},{"id":"semetey-1-2013:p0227:b005:l006","ordinal":94108,"en":"Since your brother-in-law left your sister,"},{"id":"semetey-1-2013:p0227:b005:l007","ordinal":94109,"en":"When you count the years,"},{"id":"semetey-1-2013:p0227:b005:l008","ordinal":94110,"en":"Twelve years have passed."},{"id":"semetey-1-2013:p0227:b005:l009","ordinal":94111,"en":"This very year, since your sister"},{"id":"semetey-1-2013:p0227:b005:l010","ordinal":94112,"en":"Came wandering to Bukhara,"},{"id":"semetey-1-2013:p0227:b005:l011","ordinal":94113,"en":"It has been exactly twelve years."},{"id":"semetey-1-2013:p0227:b005:l012","ordinal":94114,"en":"Widowed, she pushes herself forward,"},{"id":"semetey-1-2013:p0227:b005:l013","ordinal":94115,"en":"Crazed with racing horses—"},{"id":"semetey-1-2013:p0227:b005:l014","ordinal":94116,"en":"Can anyone be so shameless?"},{"id":"semetey-1-2013:p0227:b005:l015","ordinal":94117,"en":"Trouble upon the whole wide world—"},{"id":"semetey-1-2013:p0227:b005:l016","ordinal":94118,"en":"Let your shameless sister not bring it."},{"id":"semetey-1-2013:p0227:b005:l017","ordinal":94119,"en":"That accursed madwoman"},{"id":"semetey-1-2013:p0227:b005:l018","ordinal":94120,"en":"Was an exceptionally strong slave woman."},{"id":"semetey-1-2013:p0227:b005:l019","ordinal":94121,"en":"My darling foal,"},{"id":"semetey-1-2013:p0227:b005:l020","ordinal":94122,"en":"Semetey, do not fail to overpower her."},{"id":"semetey-1-2013:p0227:b005:l022","ordinal":94123,"en":"Choose your companions carefully.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0227:b005:l023","ordinal":94124,"en":"When the black gun cracks,"},{"id":"semetey-1-2013:p0227:b005:l024","ordinal":94125,"en":"Take a strong man who will not flee."},{"id":"semetey-1-2013:p0227:b005:l025","ordinal":94126,"en":"When the fierce gun snaps,"},{"id":"semetey-1-2013:p0227:b005:l026","ordinal":94127,"en":"Take a skilled man who will not start."},{"id":"semetey-1-2013:p0227:b005:l027","ordinal":94128,"en":"If an enemy confronts you,"},{"id":"semetey-1-2013:p0227:b005:l028","ordinal":94129,"en":"Take one who will grip and thrust a spear."},{"id":"semetey-1-2013:p0227:b005:l029","ordinal":94130,"en":"If some unforeseen trouble comes,"},{"id":"semetey-1-2013:p0227:b005:l030","ordinal":94131,"en":"Take one who will hold your horse!'"},{"id":"semetey-1-2013:p0227:b005:l031","ordinal":94132,"en":"The twisted copper crest"},{"id":"semetey-1-2013:p0227:b005:l032","ordinal":94133,"en":"He gripped at its corner and turned."},{"id":"semetey-1-2013:p0227:b005:l033","ordinal":94134,"en":"Working his son into a fury,"},{"id":"semetey-1-2013:p0227:b005:l034","ordinal":94135,"en":"Saying, 'Seize your sister and slaughter her,'"},{"id":"semetey-1-2013:p0227:b005:l035","ordinal":94136,"en":"He sent him to his mother."},{"id":"semetey-1-2013:p0227:b005:l036","ordinal":94137,"en":"Giving orders, Ismail"},{"id":"semetey-1-2013:p0227:b005:l037","ordinal":94138,"en":"Had the drum beaten."},{"id":"semetey-1-2013:p0227:b005:l038","ordinal":94139,"en":"The great komuz with an armful-wide back,"},{"id":"semetey-1-2013:p0227:b005:l039","ordinal":94140,"en":"The dombra, he had played."},{"id":"semetey-1-2013:p0228:b003:l001","ordinal":94141,"en":"Some sixty of his champions,"},{"id":"semetey-1-2013:p0228:b003:l002","ordinal":94142,"en":"By his father's Sart custom,"},{"id":"semetey-1-2013:p0228:b003:l003","ordinal":94143,"en":"Now began to sing."},{"id":"semetey-1-2013:p0228:b003:l004","ordinal":94144,"en":"Some seventy champions"},{"id":"semetey-1-2013:p0228:b003:l005","ordinal":94145,"en":"To the poor orphan boy"},{"id":"semetey-1-2013:p0228:b003:l006","ordinal":94146,"en":"Became companions."},{"id":"semetey-1-2013:p0228:b003:l007","ordinal":94147,"en":"At that time Semetey"},{"id":"semetey-1-2013:p0228:b003:l008","ordinal":94148,"en":"Had his wish granted by God,"},{"id":"semetey-1-2013:p0228:b003:l009","ordinal":94149,"en":"Had reached twelve years of age."},{"id":"semetey-1-2013:p0228:b003:l010","ordinal":94150,"en":"The ten companions' gift bestowed by the saint—"},{"id":"semetey-1-2013:p0228:b003:l011","ordinal":94151,"en":"He did not yet know it was a blessing."},{"id":"semetey-1-2013:p0228:b003:l012","ordinal":94152,"en":"Manas, who had gone to the next world—"},{"id":"semetey-1-2013:p0228:b003:l013","ordinal":94153,"en":"He did not yet know he was his father."},{"id":"semetey-1-2013:p0228:b003:l014","ordinal":94154,"en":"Hearing Ismail's words,"},{"id":"semetey-1-2013:p0228:b003:l015","ordinal":94155,"en":"Hearing that the fugitive Kanykei"},{"id":"semetey-1-2013:p0228:b003:l016","ordinal":94156,"en":"Had raced her horse,"},{"id":"semetey-1-2013:p0228:b003:l017","ordinal":94157,"en":"To gouge her eyes in vengeance,"},{"id":"semetey-1-2013:p0228:b003:l018","ordinal":94158,"en":"To seize and slaughter her,"},{"id":"semetey-1-2013:p0228:b003:l019","ordinal":94159,"en":"That shameless, raging woman,"},{"id":"semetey-1-2013:p0228:b003:l020","ordinal":94160,"en":"To catch her upon the road,"},{"id":"semetey-1-2013:p0228:b003:l021","ordinal":94161,"en":"The boy's mind was turned,"},{"id":"semetey-1-2013:p0228:b003:l022","ordinal":94162,"en":"To slaughter her as a sacrifice,"},{"id":"semetey-1-2013:p0228:b003:l023","ordinal":94163,"en":"If he could, in this way"},{"id":"semetey-1-2013:p0228:b003:l024","ordinal":94164,"en":"To cut off her head."},{"id":"semetey-1-2013:p0228:b003:l025","ordinal":94165,"en":"The warrior thought, 'My widowed sister—"},{"id":"semetey-1-2013:p0228:b003:l026","ordinal":94166,"en":"What is this wild behavior?"},{"id":"semetey-1-2013:p0228:b003:l027","ordinal":94167,"en":"Dressing herself in men's clothes,"},{"id":"semetey-1-2013:p0228:b003:l028","ordinal":94168,"en":"What is this madness?'"},{"id":"semetey-1-2013:p0228:b003:l029","ordinal":94169,"en":"Hearing it, he felt constrained,"},{"id":"semetey-1-2013:p0228:b003:l030","ordinal":94170,"en":"The boy was thus tormented by shame."},{"id":"semetey-1-2013:p0228:b003:l031","ordinal":94171,"en":"From iron-gated Bukhara"},{"id":"semetey-1-2013:p0228:b003:l032","ordinal":94172,"en":"The boy went without turning back."},{"id":"semetey-1-2013:p0228:b003:l033","ordinal":94173,"en":"The horse he rode beneath him"},{"id":"semetey-1-2013:p0228:b003:l034","ordinal":94174,"en":"Was Temir Khan's wondrous steed."},{"id":"semetey-1-2013:p0228:b003:l035","ordinal":94175,"en":"The sword within his hand"},{"id":"semetey-1-2013:p0228:b003:l036","ordinal":94176,"en":"Was Ismail's steel."},{"id":"semetey-1-2013:p0228:b003:l037","ordinal":94177,"en":"Semetey grew furious,"},{"id":"semetey-1-2013:p0228:b003:l038","ordinal":94178,"en":"Flames hissing from his mouth,"},{"id":"semetey-1-2013:p0228:b003:l039","ordinal":94179,"en":"His mighty teeth, as broad as doors,"},{"id":"semetey-1-2013:p0228:b004:l001","ordinal":94180,"en":"Shattered into millet grains."},{"id":"semetey-1-2013:p0228:b004:l002","ordinal":94181,"en":"To Kanykei's sorrow,"},{"id":"semetey-1-2013:p0228:b004:l003","ordinal":94182,"en":"Some seventy fearless men,"},{"id":"semetey-1-2013:p0228:b004:l004","ordinal":94183,"en":"All his champions,"},{"id":"semetey-1-2013:p0228:b004:l005","ordinal":94184,"en":"Became his companions."},{"id":"semetey-1-2013:p0228:b004:l006","ordinal":94185,"en":"Among the champions"},{"id":"semetey-1-2013:p0228:b004:l007","ordinal":94186,"en":"Were skilled men who could find a way,"},{"id":"semetey-1-2013:p0228:b004:l008","ordinal":94187,"en":"Men who would not flee a massed foe,"},{"id":"semetey-1-2013:p0228:b004:l009","ordinal":94188,"en":"Broad-chested men of might,"},{"id":"semetey-1-2013:p0228:b004:l010","ordinal":94189,"en":"Marksmen who never missed."},{"id":"semetey-1-2013:p0228:b004:l011","ordinal":94190,"en":"All his champions"},{"id":"semetey-1-2013:p0228:b004:l012","ordinal":94191,"en":"Accompanied the boy,"},{"id":"semetey-1-2013:p0228:b004:l013","ordinal":94192,"en":"Traveling without turning aside,"},{"id":"semetey-1-2013:p0228:b004:l014","ordinal":94193,"en":"Toward the racing plain,"},{"id":"semetey-1-2013:p0228:b004:l015","ordinal":94194,"en":"All of those champions,"},{"id":"semetey-1-2013:p0228:b004:l016","ordinal":94195,"en":"Their leaders of ten bobbing in their saddles,"},{"id":"semetey-1-2013:p0228:b004:l017","ordinal":94196,"en":"Their spears jutting up,"},{"id":"semetey-1-2013:p0228:b004:l018","ordinal":94197,"en":"Their executioners roused to frenzy,"},{"id":"semetey-1-2013:p0228:b004:l019","ordinal":94198,"en":"With seven thousand at their side,"},{"id":"semetey-1-2013:p0228:b004:l020","ordinal":94199,"en":"Went on in wild excitement,"},{"id":"semetey-1-2013:p0228:b004:l021","ordinal":94200,"en":"Raging like madmen,"},{"id":"semetey-1-2013:p0228:b004:l022","ordinal":94201,"en":"Sparing no horses on the road,"},{"id":"semetey-1-2013:p0228:b004:l023","ordinal":94202,"en":"Traveling far without restraint."},{"id":"semetey-1-2013:p0228:b004:l024","ordinal":94203,"en":"Semetey set out."},{"id":"semetey-1-2013:p0228:b004:l025","ordinal":94204,"en":"With seventy champions beside him,"},{"id":"semetey-1-2013:p0228:b004:l026","ordinal":94205,"en":"From the sandy, saddle-shaped ridge"},{"id":"semetey-1-2013:p0228:b004:l027","ordinal":94206,"en":"Semetey came burning with rage."},{"id":"semetey-1-2013:p0228:b004:l028","ordinal":94207,"en":"Drawing his sword, tight-lipped,"},{"id":"semetey-1-2013:p0228:b004:l029","ordinal":94208,"en":"Slipping along like a dragon,"}]
