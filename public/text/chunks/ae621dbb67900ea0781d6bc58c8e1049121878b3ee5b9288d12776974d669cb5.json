[{"id":"semetey-1-2013:p0934:b004:l023","ordinal":147457,"en":"His words are jagged and rough."},{"id":"semetey-1-2013:p0934:b004:l024","ordinal":147458,"en":"When hardship fell upon his thimble-sized head,"},{"id":"semetey-1-2013:p0934:b004:l026","ordinal":147459,"en":"It seems he came here in this state.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0934:b004:l027","ordinal":147460,"en":"He speaks with great boasting;"},{"id":"semetey-1-2013:p0934:b004:l028","ordinal":147461,"en":"Having grappled with some hero,"},{"id":"semetey-1-2013:p0934:b004:l029","ordinal":147462,"en":"It seems he arrived worn out."},{"id":"semetey-1-2013:p0934:b004:l030","ordinal":147463,"en":"Our khan Toltoy, the leopard,"},{"id":"semetey-1-2013:p0934:b004:l032","ordinal":147464,"en":"Will heed this Kozho's words,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0934:b004:l033","ordinal":147465,"en":"And subject these people to oppression,"},{"id":"semetey-1-2013:p0934:b004:l034","ordinal":147466,"en":"Slaughtering them to the last."},{"id":"semetey-1-2013:p0934:b004:l035","ordinal":147467,"en":"The stooping old and the tender young—"},{"id":"semetey-1-2013:p0934:b005:l001","ordinal":147468,"en":"He will bear the guilt for them!”"},{"id":"semetey-1-2013:p0934:b005:l002","ordinal":147469,"en":"The people spoke thus and fell silent,"},{"id":"semetey-1-2013:p0934:b005:l003","ordinal":147470,"en":"Cursing one another."},{"id":"semetey-1-2013:p0934:b005:l004","ordinal":147471,"en":"Chynkozho came to Toltoy,"},{"id":"semetey-1-2013:p0934:b005:l005","ordinal":147472,"en":"And became a renowned khan,"},{"id":"semetey-1-2013:p0934:b005:l006","ordinal":147473,"en":"And became an influential man."},{"id":"semetey-1-2013:p0934:b005:l007","ordinal":147474,"en":"Than the hero Toltoy himself,"},{"id":"semetey-1-2013:p0934:b005:l008","ordinal":147475,"en":"He became a mightier khan."},{"id":"semetey-1-2013:p0934:b005:l009","ordinal":147476,"en":"Kozho and the hero Toltoy,"},{"id":"semetey-1-2013:p0934:b005:l010","ordinal":147477,"en":"Tolok and Tolobai,"},{"id":"semetey-1-2013:p0934:b005:l011","ordinal":147478,"en":"Kalcha and Kadyrbai—"},{"id":"semetey-1-2013:p0934:b005:l012","ordinal":147479,"en":"Of the Zhediger people,"},{"id":"semetey-1-2013:p0934:b005:l013","ordinal":147480,"en":"These six were the foremost,"},{"id":"semetey-1-2013:p0934:b005:l014","ordinal":147481,"en":"Their shamans who struck with lungs,"},{"id":"semetey-1-2013:p0934:b005:l015","ordinal":147482,"en":"Their noblemen who raised them up,"},{"id":"semetey-1-2013:p0934:b005:l016","ordinal":147483,"en":"Their heroes among spearmen,"},{"id":"semetey-1-2013:p0934:b005:l017","ordinal":147484,"en":"Their champions who swung battle-axes."},{"id":"semetey-1-2013:p0934:b005:l018","ordinal":147485,"en":"These six joined together."},{"id":"semetey-1-2013:p0934:b005:l019","ordinal":147486,"en":"Like flour of white wheat,"},{"id":"semetey-1-2013:p0934:b005:l020","ordinal":147487,"en":"They were kneaded into one."},{"id":"semetey-1-2013:p0934:b005:l021","ordinal":147488,"en":"Like hairs of a white saiga,"},{"id":"semetey-1-2013:p0934:b005:l023","ordinal":147489,"en":"They swore an oath unto death,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0934:b005:l024","ordinal":147490,"en":"And made their promise binding:"},{"id":"semetey-1-2013:p0934:b005:l025","ordinal":147491,"en":"To pursue claims together,"},{"id":"semetey-1-2013:p0934:b005:l026","ordinal":147492,"en":"To fight enemies together,"},{"id":"semetey-1-2013:p0934:b005:l027","ordinal":147493,"en":"To wage battle together,"},{"id":"semetey-1-2013:p0934:b005:l028","ordinal":147494,"en":"And if their appointed time came, their days ended,"},{"id":"semetey-1-2013:p0934:b005:l029","ordinal":147495,"en":"To die together in one place."},{"id":"semetey-1-2013:p0934:b005:l030","ordinal":147496,"en":"Calling upon God,"},{"id":"semetey-1-2013:p0934:b005:l031","ordinal":147497,"en":"They made their promise binding,"},{"id":"semetey-1-2013:p0934:b005:l032","ordinal":147498,"en":"And swore an oath upon their lives,"},{"id":"semetey-1-2013:p0934:b005:l033","ordinal":147499,"en":"Kissing the mouths of guns,"},{"id":"semetey-1-2013:p0934:b005:l034","ordinal":147500,"en":"Licking the edges of swords."},{"id":"semetey-1-2013:p0934:b005:l035","ordinal":147501,"en":"Nine thousand horses upon the mountains,"},{"id":"semetey-1-2013:p0935:b003:l001","ordinal":147502,"en":"Of the Zhediger's Toltoy,"},{"id":"semetey-1-2013:p0935:b003:l002","ordinal":147503,"en":"Which sorrow shall you tell?"},{"id":"semetey-1-2013:p0935:b003:l003","ordinal":147504,"en":"He had ninety fat mares brought,"},{"id":"semetey-1-2013:p0935:b003:l004","ordinal":147505,"en":"Turned toward the qibla,"},{"id":"semetey-1-2013:p0935:b003:l005","ordinal":147506,"en":"And had them offered as horse sacrifices."},{"id":"semetey-1-2013:p0935:b003:l006","ordinal":147507,"en":"“Those who turn back and flee the enemy,"},{"id":"semetey-1-2013:p0935:b003:l007","ordinal":147508,"en":"May they die in this fashion,” he said,"},{"id":"semetey-1-2013:p0935:b003:l008","ordinal":147509,"en":"And dipped his hand in blood."},{"id":"semetey-1-2013:p0935:b003:l009","ordinal":147510,"en":"Chynkozho arrived and settled"},{"id":"semetey-1-2013:p0935:b003:l010","ordinal":147511,"en":"Beside Toltoy of the Zhediger."},{"id":"semetey-1-2013:p0935:b003:l011","ordinal":147512,"en":"At Zheti-Ozon, the Zhediger"},{"id":"semetey-1-2013:p0935:b003:l012","ordinal":147513,"en":"He gathered completely."},{"id":"semetey-1-2013:p0935:b003:l013","ordinal":147514,"en":"Then Chynkozho,"},{"id":"semetey-1-2013:p0935:b003:l014","ordinal":147515,"en":"Of what he had seen and known,"},{"id":"semetey-1-2013:p0935:b003:l015","ordinal":147516,"en":"Told a lengthy tale."},{"id":"semetey-1-2013:p0935:b003:l016","ordinal":147517,"en":"Their sheep shared one fold;"},{"id":"semetey-1-2013:p0935:b003:l017","ordinal":147518,"en":"Their food they shared as comrades."},{"id":"semetey-1-2013:p0935:b003:l018","ordinal":147519,"en":"His heart was at ease, like a flower."},{"id":"semetey-1-2013:p0935:b003:l019","ordinal":147520,"en":"Winter passed and summer came."},{"id":"semetey-1-2013:p0935:b003:l020","ordinal":147521,"en":"As the people were about to move uphill,"},{"id":"semetey-1-2013:p0935:b003:l021","ordinal":147522,"en":"When summer had come,"},{"id":"semetey-1-2013:p0935:b003:l022","ordinal":147523,"en":"Shygai's son Chynkozho,"},{"id":"semetey-1-2013:p0935:b003:l023","ordinal":147524,"en":"Kozho, capable in all he did,"},{"id":"semetey-1-2013:p0935:b003:l024","ordinal":147525,"en":"Roared in anger,"},{"id":"semetey-1-2013:p0935:b003:l025","ordinal":147526,"en":"And summoned the great mass of Zhediger,"},{"id":"semetey-1-2013:p0935:b003:l026","ordinal":147527,"en":"Leaving not one uncalled."},{"id":"semetey-1-2013:p0935:b003:l027","ordinal":147528,"en":"“An order has come from the khan,” they said."},{"id":"semetey-1-2013:p0935:b003:l028","ordinal":147529,"en":"All the Zhediger"},{"id":"semetey-1-2013:p0935:b003:l029","ordinal":147530,"en":"Came there then."},{"id":"semetey-1-2013:p0935:b003:l030","ordinal":147531,"en":"Tolok and Toltoy were their elders."},{"id":"semetey-1-2013:p0935:b003:l031","ordinal":147532,"en":"Without turning to look at Toltoy,"},{"id":"semetey-1-2013:p0935:b003:l032","ordinal":147533,"en":"As though struck by a massacre,"},{"id":"semetey-1-2013:p0935:b003:l033","ordinal":147534,"en":"They all crumbled before him."},{"id":"semetey-1-2013:p0935:b003:l034","ordinal":147535,"en":"“Zhediger people of every clan,"},{"id":"semetey-1-2013:p0935:b003:l035","ordinal":147536,"en":"I shall give you all courage."},{"id":"semetey-1-2013:p0935:b003:l036","ordinal":147537,"en":"If you turn back and flee,"},{"id":"semetey-1-2013:p0935:b003:l037","ordinal":147538,"en":"Then you have eaten shit."},{"id":"semetey-1-2013:p0935:b003:l038","ordinal":147539,"en":"When I first arrived,"},{"id":"semetey-1-2013:p0935:b003:l039","ordinal":147540,"en":"Swaying about in pairs,"},{"id":"semetey-1-2013:p0935:b004:l001","ordinal":147541,"en":"What was it you said!"},{"id":"semetey-1-2013:p0935:b004:l002","ordinal":147542,"en":"Come, your elders with your chiefs at their head."},{"id":"semetey-1-2013:p0935:b004:l003","ordinal":147543,"en":"All you people of mine, come!"},{"id":"semetey-1-2013:p0935:b004:l004","ordinal":147544,"en":"Let me tell you much:"},{"id":"semetey-1-2013:p0935:b004:l005","ordinal":147545,"en":"We were the Argyn and Kyrgyz people."},{"id":"semetey-1-2013:p0935:b004:l006","ordinal":147546,"en":"Born among those folk,"},{"id":"semetey-1-2013:p0935:b004:l007","ordinal":147547,"en":"A khan named Manas arose."},{"id":"semetey-1-2013:p0935:b004:l008","ordinal":147548,"en":"The enemies who heard of him"},{"id":"semetey-1-2013:p0935:b004:l009","ordinal":147549,"en":"Had the life driven from their breasts."},{"id":"semetey-1-2013:p0935:b004:l010","ordinal":147550,"en":"He was born and grew up in Altai;"},{"id":"semetey-1-2013:p0935:b004:l011","ordinal":147551,"en":"The foes who grappled with him were brought low."},{"id":"semetey-1-2013:p0935:b004:l012","ordinal":147552,"en":"Upon Boshogo, the dark Kalmyk,"},{"id":"semetey-1-2013:p0935:b004:l013","ordinal":147553,"en":"He brought devastation."},{"id":"semetey-1-2013:p0935:b004:l014","ordinal":147554,"en":"He brought devastation once,"},{"id":"semetey-1-2013:p0935:b004:l015","ordinal":147555,"en":"Destroyed Kangai and took its wealth."},{"id":"semetey-1-2013:p0935:b004:l016","ordinal":147556,"en":"The Chinese people's great khan,"},{"id":"semetey-1-2013:p0935:b004:l017","ordinal":147557,"en":"Alooke, he sent into the earth,"},{"id":"semetey-1-2013:p0935:b004:l018","ordinal":147558,"en":"And showed himself a lion."},{"id":"semetey-1-2013:p0935:b004:l019","ordinal":147559,"en":"Clashing with the unbelievers,"},{"id":"semetey-1-2013:p0935:b004:l020","ordinal":147560,"en":"Fighting with the unbelievers,"},{"id":"semetey-1-2013:p0935:b004:l021","ordinal":147561,"en":"That Manas died."},{"id":"semetey-1-2013:p0935:b004:l022","ordinal":147562,"en":"The countless riches Manas left,"},{"id":"semetey-1-2013:p0935:b004:l023","ordinal":147563,"en":"Abyke, Kobosh—the six villains—"},{"id":"semetey-1-2013:p0935:b004:l024","ordinal":147564,"en":"Those men lived upon them."},{"id":"semetey-1-2013:p0935:b004:l025","ordinal":147565,"en":"His fierce mother Kanykei,"},{"id":"semetey-1-2013:p0935:b004:l026","ordinal":147566,"en":"With Semetey left an orphan,"},{"id":"semetey-1-2013:p0935:b004:l027","ordinal":147567,"en":"Her mind distressed by humiliation,"},{"id":"semetey-1-2013:p0935:b004:l028","ordinal":147568,"en":"Fled away with her child."},{"id":"semetey-1-2013:p0935:b004:l029","ordinal":147569,"en":"He went to Bukhara and grew up,"},{"id":"semetey-1-2013:p0935:b004:l030","ordinal":147570,"en":"Returned to Talas,"},{"id":"semetey-1-2013:p0935:b004:l031","ordinal":147571,"en":"And killed his own kinsmen."},{"id":"semetey-1-2013:p0935:b004:l032","ordinal":147572,"en":"That boy turned out a reckless desperado."},{"id":"semetey-1-2013:p0935:b004:l033","ordinal":147573,"en":"When he moved toward Talas,"},{"id":"semetey-1-2013:p0935:b004:l034","ordinal":147574,"en":"Temir Khan flattered him,"},{"id":"semetey-1-2013:p0935:b004:l035","ordinal":147575,"en":"Calling the boy a hero."},{"id":"semetey-1-2013:p0935:b004:l036","ordinal":147576,"en":"God had struck the Sarts down."},{"id":"semetey-1-2013:p0935:b004:l037","ordinal":147577,"en":"Shah Temir's Chachykei,"},{"id":"semetey-1-2013:p0935:b004:l038","ordinal":147578,"en":"The woman you were to marry,"},{"id":"semetey-1-2013:p0935:b004:l039","ordinal":147579,"en":"They offered her as a gift to Semetey,"},{"id":"semetey-1-2013:p0936:b003:l001","ordinal":147580,"en":"That orphan, son of Manas,"},{"id":"semetey-1-2013:p0936:b003:l002","ordinal":147581,"en":"Has committed this outrage."},{"id":"semetey-1-2013:p0936:b003:l003","ordinal":147582,"en":"Having your wife taken from you,"},{"id":"semetey-1-2013:p0936:b003:l004","ordinal":147583,"en":"Toltoi, you have been struck by God."},{"id":"semetey-1-2013:p0936:b003:l005","ordinal":147584,"en":"His father, bloodthirsty Manas,"},{"id":"semetey-1-2013:p0936:b003:l006","ordinal":147585,"en":"I am the one who deceived him six times."},{"id":"semetey-1-2013:p0936:b003:l007","ordinal":147586,"en":"If you speak of a hero, I am a hero;"},{"id":"semetey-1-2013:p0936:b003:l008","ordinal":147587,"en":"My friend Toltoi, hear me:"},{"id":"semetey-1-2013:p0936:b003:l009","ordinal":147588,"en":"If another army appears upon the road,"},{"id":"semetey-1-2013:p0936:b003:l010","ordinal":147589,"en":"I alone shall be its match."},{"id":"semetey-1-2013:p0936:b003:l011","ordinal":147590,"en":"When he hears the sound of guns,"},{"id":"semetey-1-2013:p0936:b003:l012","ordinal":147591,"en":"My black horse flies into the sky."},{"id":"semetey-1-2013:p0936:b003:l013","ordinal":147592,"en":"Not merely China, but the whole world"},{"id":"semetey-1-2013:p0936:b003:l014","ordinal":147593,"en":"I am accustomed to slaughter."},{"id":"semetey-1-2013:p0936:b003:l015","ordinal":147594,"en":"I have come to you to lay bare"},{"id":"semetey-1-2013:p0936:b003:l016","ordinal":147595,"en":"That Semetey's record."},{"id":"semetey-1-2013:p0936:b003:l017","ordinal":147596,"en":"There is no ship upon the dark water;"},{"id":"semetey-1-2013:p0936:b003:l018","ordinal":147597,"en":"Watch, Jediger:"},{"id":"semetey-1-2013:p0936:b003:l019","ordinal":147598,"en":"So long as my precious head survives,"},{"id":"semetey-1-2013:p0936:b003:l020","ordinal":147599,"en":"There is no one to defy you."},{"id":"semetey-1-2013:p0936:b003:l021","ordinal":147600,"en":"So long as my black horse is safe,"},{"id":"semetey-1-2013:p0936:b003:l022","ordinal":147601,"en":"The eighteen thousand worlds"},{"id":"semetey-1-2013:p0936:b003:l023","ordinal":147602,"en":"I can crush like meal."},{"id":"semetey-1-2013:p0936:b003:l025","ordinal":147603,"en":"While the hero Kojo is here,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0936:b003:l026","ordinal":147604,"en":"Jediger, you have no enemy."},{"id":"semetey-1-2013:p0936:b003:l027","ordinal":147605,"en":"Perhaps you have heard:"},{"id":"semetey-1-2013:p0936:b003:l028","ordinal":147606,"en":"In the hollow of Karkyra,"},{"id":"semetey-1-2013:p0936:b003:l029","ordinal":147607,"en":"At Khan Kokotoi's feast,"},{"id":"semetey-1-2013:p0936:b003:l030","ordinal":147608,"en":"Of the hairy-mouthed Russians,"},{"id":"semetey-1-2013:p0936:b003:l031","ordinal":147609,"en":"When twelve kinds arrived,"},{"id":"semetey-1-2013:p0936:b003:l032","ordinal":147610,"en":"Of the red-tufted Chinese,"},{"id":"semetey-1-2013:p0936:b003:l033","ordinal":147611,"en":"When forty clans arrived,"},{"id":"semetey-1-2013:p0936:b003:l034","ordinal":147612,"en":"At Kara-Saz in Karkyra,"},{"id":"semetey-1-2013:p0936:b003:l035","ordinal":147613,"en":"When mares were tethered,"},{"id":"semetey-1-2013:p0936:b003:l036","ordinal":147614,"en":"Becoming friends with the kaldai,"},{"id":"semetey-1-2013:p0936:b003:l038","ordinal":147615,"en":"At Khan Kokotoi's feast,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0936:b003:l039","ordinal":147616,"en":"When the giants gathered,"},{"id":"semetey-1-2013:p0936:b004:l001","ordinal":147617,"en":"Not a single human being remaining behind,"},{"id":"semetey-1-2013:p0936:b004:l002","ordinal":147618,"en":"When everyone had gone there,"},{"id":"semetey-1-2013:p0936:b004:l003","ordinal":147619,"en":"Saintly Khan Koshoi"},{"id":"semetey-1-2013:p0936:b004:l004","ordinal":147620,"en":"Gave a stern command,"},{"id":"semetey-1-2013:p0936:b004:l006","ordinal":147621,"en":"Kokotoi's great feast","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0936:b004:l007","ordinal":147622,"en":"The Muslim faithful undertook."},{"id":"semetey-1-2013:p0936:b004:l008","ordinal":147623,"en":"Within that gathering"},{"id":"semetey-1-2013:p0936:b004:l009","ordinal":147624,"en":"Were the giants Koshoi and Toshtuk,"},{"id":"semetey-1-2013:p0936:b004:l010","ordinal":147625,"en":"And all the people who had set out."},{"id":"semetey-1-2013:p0936:b004:l011","ordinal":147626,"en":"From the Kara-Kalmak and Manchus"},{"id":"semetey-1-2013:p0936:b004:l012","ordinal":147627,"en":"Was that dear giant Joloi."},{"id":"semetey-1-2013:p0936:b004:l013","ordinal":147628,"en":"The Muslims had their master, leopard Manas."},{"id":"semetey-1-2013:p0936:b004:l015","ordinal":147629,"en":"From China were warriors of many kinds;"},{"id":"semetey-1-2013:p0936:b004:l016","ordinal":147630,"en":"Among those Chinese"},{"id":"semetey-1-2013:p0936:b004:l017","ordinal":147631,"en":"Was hairy-soled Tukubai,"},{"id":"semetey-1-2013:p0936:b004:l018","ordinal":147632,"en":"That utterly ruined infidel."},{"id":"semetey-1-2013:p0936:b004:l019","ordinal":147633,"en":"He spared no one he grappled with,"},{"id":"semetey-1-2013:p0936:b004:l020","ordinal":147634,"en":"And the meat of a single pig,"},{"id":"semetey-1-2013:p0936:b004:l021","ordinal":147635,"en":"Though he ate it all himself, could not fill him."},{"id":"semetey-1-2013:p0936:b004:l022","ordinal":147636,"en":"Relying on their might, those Chinese"},{"id":"semetey-1-2013:p0936:b004:l023","ordinal":147637,"en":"Surged forward together without stopping,"},{"id":"semetey-1-2013:p0936:b004:l024","ordinal":147638,"en":"Stirred up the meat at the cooking trench,"},{"id":"semetey-1-2013:p0936:b004:l025","ordinal":147639,"en":"The raw meat just put in,"},{"id":"semetey-1-2013:p0936:b004:l026","ordinal":147640,"en":"With no thought for cooked or raw,"},{"id":"semetey-1-2013:p0936:b004:l027","ordinal":147641,"en":"The Kara-Kalmaks plundered."},{"id":"semetey-1-2013:p0936:b004:l028","ordinal":147642,"en":"The young men serving at Kokotoi's feast"},{"id":"semetey-1-2013:p0936:b004:l030","ordinal":147643,"en":"They beat with fire pokers."},{"id":"semetey-1-2013:p0936:b004:l031","ordinal":147644,"en":"The swarming infidels"},{"id":"semetey-1-2013:p0936:b004:l032","ordinal":147645,"en":"Ran toward the cooking trench."},{"id":"semetey-1-2013:p0936:b004:l033","ordinal":147646,"en":"The Muslims who watched"},{"id":"semetey-1-2013:p0936:b004:l034","ordinal":147647,"en":"Despaired of their lives."},{"id":"semetey-1-2013:p0936:b004:l035","ordinal":147648,"en":"Lashing out upon Ak-Kula,"},{"id":"semetey-1-2013:p0936:b004:l036","ordinal":147649,"en":"Leopard Manas then,"},{"id":"semetey-1-2013:p0936:b004:l037","ordinal":147650,"en":"Pleading with the one God,"},{"id":"semetey-1-2013:p0936:b004:l038","ordinal":147651,"en":"'We invited them to a memorial feast,"},{"id":"semetey-1-2013:p0936:b004:l039","ordinal":147652,"en":"But they have come to seize it,' he said,"},{"id":"semetey-1-2013:p0937:b003:l001","ordinal":147653,"en":"'They have come to bring"},{"id":"semetey-1-2013:p0937:b003:l002","ordinal":147654,"en":"Merciless uproar,' he said."},{"id":"semetey-1-2013:p0937:b003:l003","ordinal":147655,"en":"Flushing like a lion,"},{"id":"semetey-1-2013:p0937:b003:l005","ordinal":147656,"en":"Dust issuing from the corners of his mouth,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0937:b003:l007","ordinal":147657,"en":"Girding himself with the gray belt,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0937:b003:l008","ordinal":147658,"en":"Manas entered, thundering."},{"id":"semetey-1-2013:p0937:b003:l009","ordinal":147659,"en":"The host of Chinese and many Manchus"},{"id":"semetey-1-2013:p0937:b003:l010","ordinal":147660,"en":"From the cooking trench"},{"id":"semetey-1-2013:p0937:b003:l011","ordinal":147661,"en":"Fled in a roaring rush."},{"id":"semetey-1-2013:p0937:b003:l012","ordinal":147662,"en":"We thought, 'He will beat them away,'"},{"id":"semetey-1-2013:p0937:b003:l013","ordinal":147663,"en":"But he drove them away slaughtering."},{"id":"semetey-1-2013:p0937:b003:l014","ordinal":147664,"en":"The Muslims with split heads,"},{"id":"semetey-1-2013:p0937:b003:l015","ordinal":147665,"en":"The hero, leopard Manas,"},{"id":"semetey-1-2013:p0937:b003:l016","ordinal":147666,"en":"Rescued from them."},{"id":"semetey-1-2013:p0937:b003:l017","ordinal":147667,"en":"'They will say he gave a feast and started a quarrel;"},{"id":"semetey-1-2013:p0937:b003:l018","ordinal":147668,"en":"The dispute will spread throughout the world;"},{"id":"semetey-1-2013:p0937:b003:l019","ordinal":147669,"en":"The infidels and Muslims"},{"id":"semetey-1-2013:p0937:b003:l020","ordinal":147670,"en":"Will come to blows,' they said."},{"id":"semetey-1-2013:p0937:b003:l021","ordinal":147671,"en":"Dear Koshoi and Akun Khan"},{"id":"semetey-1-2013:p0937:b003:l022","ordinal":147672,"en":"Seized Manas,"},{"id":"semetey-1-2013:p0937:b003:l023","ordinal":147673,"en":"As he raged and struggled,"},{"id":"semetey-1-2013:p0937:b003:l024","ordinal":147674,"en":"And lunged like a widow in grief."},{"id":"semetey-1-2013:p0937:b003:l025","ordinal":147675,"en":"Somehow taking hold of Manas,"},{"id":"semetey-1-2013:p0937:b003:l026","ordinal":147676,"en":"They separated him from the Chinese."},{"id":"semetey-1-2013:p0937:b003:l027","ordinal":147677,"en":"Then Akun said this:"},{"id":"semetey-1-2013:p0937:b003:l028","ordinal":147678,"en":"'We are friends until Judgment Day;"},{"id":"semetey-1-2013:p0937:b003:l029","ordinal":147679,"en":"Understand these words of mine,"},{"id":"semetey-1-2013:p0937:b003:l030","ordinal":147680,"en":"Put aside your anger and heed me!"},{"id":"semetey-1-2013:p0937:b003:l031","ordinal":147681,"en":"From the ridge of Belgiluu,"},{"id":"semetey-1-2013:p0937:b003:l032","ordinal":147682,"en":"From the place where peris play,"},{"id":"semetey-1-2013:p0937:b003:l034","ordinal":147683,"en":"Beautiful as the shining moon,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0937:b003:l035","ordinal":147684,"en":"I found a newborn girl."},{"id":"semetey-1-2013:p0937:b003:l036","ordinal":147685,"en":"I slaughtered ninety beasts for her feast,"},{"id":"semetey-1-2013:p0937:b003:l037","ordinal":147686,"en":"Saying, \"She is surpassingly beautiful,\""},{"id":"semetey-1-2013:p0937:b003:l038","ordinal":147687,"en":"I named her Churok."},{"id":"semetey-1-2013:p0937:b003:l039","ordinal":147688,"en":"In my child's ears"},{"id":"semetey-1-2013:p0937:b005:l001","ordinal":147689,"en":"I placed gold earrings."},{"id":"semetey-1-2013:p0937:b005:l002","ordinal":147690,"en":"Magnanimous Manas, my soul-friend,"},{"id":"semetey-1-2013:p0937:b005:l003","ordinal":147691,"en":"I have set her aside for you."},{"id":"semetey-1-2013:p0937:b005:l004","ordinal":147692,"en":"Heed my words well,"},{"id":"semetey-1-2013:p0937:b005:l005","ordinal":147693,"en":"Take her as your daughter-in-law."},{"id":"semetey-1-2013:p0937:b005:l006","ordinal":147694,"en":"Spread your hands and say \"Amen,\""},{"id":"semetey-1-2013:p0937:b005:l007","ordinal":147695,"en":"And bind her in betrothal.'"},{"id":"semetey-1-2013:p0937:b005:l008","ordinal":147696,"en":"When he spoke thus,"},{"id":"semetey-1-2013:p0937:b005:l009","ordinal":147697,"en":"'That is well, Akun,' he said,"},{"id":"semetey-1-2013:p0937:b005:l010","ordinal":147698,"en":"'What you have said is wise.'"},{"id":"semetey-1-2013:p0937:b005:l011","ordinal":147699,"en":"They arranged the marriage and drove livestock,"},{"id":"semetey-1-2013:p0937:b005:l013","ordinal":147700,"en":"This is the story:","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0937:b005:l014","ordinal":147701,"en":"Akun's daughter Aichurok"},{"id":"semetey-1-2013:p0937:b005:l015","ordinal":147702,"en":"Is to be Manas's daughter-in-law."},{"id":"semetey-1-2013:p0937:b005:l016","ordinal":147703,"en":"Heed me, my hero Toltoi;"},{"id":"semetey-1-2013:p0937:b005:l017","ordinal":147704,"en":"If you ask about her,"},{"id":"semetey-1-2013:p0937:b005:l018","ordinal":147705,"en":"She is Semetey's wife."},{"id":"semetey-1-2013:p0937:b005:l020","ordinal":147706,"en":"He has a maiden he is to take as wife.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0937:b005:l021","ordinal":147707,"en":"He took your wife;"},{"id":"semetey-1-2013:p0937:b005:l022","ordinal":147708,"en":"If you take his wife,"},{"id":"semetey-1-2013:p0937:b005:l023","ordinal":147709,"en":"Such is honor, after all."},{"id":"semetey-1-2013:p0937:b005:l024","ordinal":147710,"en":"Consider it, my hero Toltoi!"},{"id":"semetey-1-2013:p0937:b005:l025","ordinal":147711,"en":"At Jeti-Ozon, let us muster"},{"id":"semetey-1-2013:p0937:b005:l026","ordinal":147712,"en":"The Jediger in full."}]
