[{"id":"seytek-2012:p0922:b002:l039","ordinal":366337,"en":"The land fell into turmoil."},{"id":"seytek-2012:p0922:b002:l040","ordinal":366338,"en":"The raging madman"},{"id":"seytek-2012:p0922:b003:l001","ordinal":366339,"en":"Did not know his end was near."},{"id":"seytek-2012:p0922:b003:l002","ordinal":366340,"en":"When he reached the great battlefield,"},{"id":"seytek-2012:p0922:b003:l003","ordinal":366341,"en":"He reined in his charger and halted."},{"id":"seytek-2012:p0922:b003:l004","ordinal":366342,"en":"Making the blue heavens resound,"},{"id":"seytek-2012:p0922:b003:l005","ordinal":366343,"en":"His forces began arriving and stopping."},{"id":"seytek-2012:p0922:b003:l006","ordinal":366344,"en":"Flame burst from the great guns;"},{"id":"seytek-2012:p0922:b003:l007","ordinal":366345,"en":"When their mouths opened, fire poured forth."},{"id":"seytek-2012:p0922:b003:l008","ordinal":366346,"en":"They climbed the ridge and braced themselves,"},{"id":"seytek-2012:p0922:b003:l009","ordinal":366347,"en":"Swaying as though shooting this way,"},{"id":"seytek-2012:p0922:b003:l010","ordinal":366348,"en":"Menacing and straining,"},{"id":"seytek-2012:p0922:b003:l011","ordinal":366349,"en":"Shouting as if possessed,"},{"id":"seytek-2012:p0922:b003:l012","ordinal":366350,"en":"Calling their people to come."},{"id":"seytek-2012:p0922:b003:l013","ordinal":366351,"en":"At the sight, the mind reeled;"},{"id":"seytek-2012:p0922:b003:l014","ordinal":366352,"en":"The blue crags of the splendid mountain"},{"id":"seytek-2012:p0922:b003:l015","ordinal":366353,"en":"Seemed like a whole vast world."},{"id":"seytek-2012:p0922:b003:l016","ordinal":366354,"en":"Like a man who never walked slowly,"},{"id":"seytek-2012:p0922:b003:l017","ordinal":366355,"en":"It seemed to stride forward."},{"id":"seytek-2012:p0922:b003:l018","ordinal":366356,"en":"Like the ravines of a valley"},{"id":"seytek-2012:p0922:b003:l019","ordinal":366357,"en":"Down which waters plunge, it appeared."},{"id":"seytek-2012:p0922:b003:l020","ordinal":366358,"en":"“Ah, the enemy!” they cried, straining forward,"},{"id":"seytek-2012:p0922:b003:l021","ordinal":366359,"en":"Their eyes dimming."},{"id":"seytek-2012:p0922:b003:l022","ordinal":366360,"en":"……………………………."},{"id":"seytek-2012:p0922:b003:l023","ordinal":366361,"en":"From the enraged boar,"},{"id":"seytek-2012:p0922:b003:l024","ordinal":366362,"en":"Ferocity burst forth,"},{"id":"seytek-2012:p0922:b003:l025","ordinal":366363,"en":"And hair bristled on both cheeks."},{"id":"seytek-2012:p0922:b003:l026","ordinal":366364,"en":"He raged and would not stand still;"},{"id":"seytek-2012:p0922:b003:l027","ordinal":366365,"en":"The people scattered in clamor."},{"id":"seytek-2012:p0922:b003:l028","ordinal":366366,"en":"When they came before his army,"},{"id":"seytek-2012:p0922:b003:l029","ordinal":366367,"en":"They could not face his wrath,"},{"id":"seytek-2012:p0922:b003:l030","ordinal":366368,"en":"Nor endure his fury."},{"id":"seytek-2012:p0922:b003:l031","ordinal":366369,"en":"Before his prestige and appearance,"},{"id":"seytek-2012:p0922:b003:l032","ordinal":366370,"en":"Even a mare could not stand her ground."},{"id":"seytek-2012:p0922:b003:l033","ordinal":366371,"en":"The people despaired of their lives"},{"id":"seytek-2012:p0922:b003:l034","ordinal":366372,"en":"At his aspect and nature,"},{"id":"seytek-2012:p0922:b003:l035","ordinal":366373,"en":"At the calamity of his strife,"},{"id":"seytek-2012:p0922:b003:l036","ordinal":366374,"en":"At his strength and venom,"},{"id":"seytek-2012:p0922:b003:l037","ordinal":366375,"en":"At the wrath he visited upon men."},{"id":"seytek-2012:p0922:b003:l038","ordinal":366376,"en":"Once confronted, he spared no life;"},{"id":"seytek-2012:p0922:b003:l039","ordinal":366377,"en":"No mortal had ever been like him."},{"id":"seytek-2012:p0922:b003:l040","ordinal":366378,"en":"Every living soul despaired,"},{"id":"seytek-2012:p0923:b002:l001","ordinal":366379,"en":"And while all living beings stood thus,"},{"id":"seytek-2012:p0923:b002:l002","ordinal":366380,"en":"Kuyaly of Kaiypchal"},{"id":"seytek-2012:p0923:b002:l003","ordinal":366381,"en":"Also began her holy war."},{"id":"seytek-2012:p0923:b002:l004","ordinal":366382,"en":"Then Seytek spoke,"},{"id":"seytek-2012:p0923:b002:l005","ordinal":366383,"en":"And these were the words he said:"},{"id":"seytek-2012:p0923:b002:l006","ordinal":366384,"en":"“When he rages, roaring,"},{"id":"seytek-2012:p0923:b002:l007","ordinal":366385,"en":"And summons his people and army,"},{"id":"seytek-2012:p0923:b002:l008","ordinal":366386,"en":"Sarybai at their head"},{"id":"seytek-2012:p0923:b002:l009","ordinal":366387,"en":"Roars and stirs up conflict."},{"id":"seytek-2012:p0923:b002:l010","ordinal":366388,"en":"The sin and the merit alike,"},{"id":"seytek-2012:p0923:b002:l011","ordinal":366389,"en":"If he turns to evil, are his own."},{"id":"seytek-2012:p0923:b002:l012","ordinal":366390,"en":"Amid the four sacred duties,"},{"id":"seytek-2012:p0923:b002:l013","ordinal":366391,"en":"Kaiypchal's champion maiden,"},{"id":"seytek-2012:p0923:b002:l014","ordinal":366392,"en":"That surpassing, impetuous warrior—"},{"id":"seytek-2012:p0923:b002:l015","ordinal":366393,"en":"This infidel Sarybai,"},{"id":"seytek-2012:p0923:b002:l016","ordinal":366394,"en":"Who carries men away,"},{"id":"seytek-2012:p0923:b002:l017","ordinal":366395,"en":"This is the mouth that has uttered so much,"},{"id":"seytek-2012:p0923:b002:l018","ordinal":366396,"en":"This is the army standing ready to fight,"},{"id":"seytek-2012:p0923:b002:l019","ordinal":366397,"en":"This is the surging, frantic people."},{"id":"seytek-2012:p0923:b002:l020","ordinal":366398,"en":"Like a grievous affliction,"},{"id":"seytek-2012:p0923:b002:l021","ordinal":366399,"en":"This is the moment long awaited."},{"id":"seytek-2012:p0923:b002:l022","ordinal":366400,"en":"The tormented, desperate people"},{"id":"seytek-2012:p0923:b002:l023","ordinal":366401,"en":"Cannot walk for their pain."},{"id":"seytek-2012:p0923:b002:l024","ordinal":366402,"en":"That swine who calls himself a warrior—"},{"id":"seytek-2012:p0923:b002:l025","ordinal":366403,"en":"I will crush the monster;"},{"id":"seytek-2012:p0923:b002:l026","ordinal":366404,"en":"If he fights, I will soak him in blood,"},{"id":"seytek-2012:p0923:b002:l027","ordinal":366405,"en":"Hack him apart, and still his breath."},{"id":"seytek-2012:p0923:b002:l028","ordinal":366406,"en":"Talas is no easy land;"},{"id":"seytek-2012:p0923:b002:l029","ordinal":366407,"en":"Kuyaly, who tests warriors,"},{"id":"seytek-2012:p0923:b002:l030","ordinal":366408,"en":"Is no feeble or ordinary hero."},{"id":"seytek-2012:p0923:b002:l031","ordinal":366409,"en":"This infidel, son of a demon,"},{"id":"seytek-2012:p0923:b002:l032","ordinal":366410,"en":"Is no lion equal to her, if you consider it."},{"id":"seytek-2012:p0923:b002:l033","ordinal":366411,"en":"Let us strike a terrible blow;"},{"id":"seytek-2012:p0923:b002:l034","ordinal":366412,"en":"If fortune favors us, let us take him."},{"id":"seytek-2012:p0923:b002:l035","ordinal":366413,"en":"From the grievous death that has come,"},{"id":"seytek-2012:p0923:b002:l036","ordinal":366414,"en":"Let us shield the people."},{"id":"seytek-2012:p0923:b002:l037","ordinal":366415,"en":"Let us test the strength"},{"id":"seytek-2012:p0923:b002:l038","ordinal":366416,"en":"Of this vicious, wrathful swine;"},{"id":"seytek-2012:p0923:b002:l039","ordinal":366417,"en":"Let us grapple and join battle."},{"id":"seytek-2012:p0923:b002:l040","ordinal":366418,"en":"Until we have grappled and fought,"},{"id":"seytek-2012:p0923:b004:l001","ordinal":366419,"en":"Until we have rescued his great nation"},{"id":"seytek-2012:p0923:b004:l002","ordinal":366420,"en":"From its misery,"},{"id":"seytek-2012:p0923:b004:l003","ordinal":366421,"en":"The early hope has grown late;"},{"id":"seytek-2012:p0923:b004:l004","ordinal":366422,"en":"My two eyes have become four with watching."},{"id":"seytek-2012:p0923:b004:l005","ordinal":366423,"en":"If my frail soul may rejoice,"},{"id":"seytek-2012:p0923:b004:l006","ordinal":366424,"en":"My warrior heart pounds;"},{"id":"seytek-2012:p0923:b004:l007","ordinal":366425,"en":"Oh, joyful hour!"},{"id":"seytek-2012:p0923:b004:l008","ordinal":366426,"en":"Sarybai, whom I have sought,"},{"id":"seytek-2012:p0923:b004:l009","ordinal":366427,"en":"Has appeared before my face."},{"id":"seytek-2012:p0923:b004:l010","ordinal":366428,"en":"What was broken in me is restored;"},{"id":"seytek-2012:p0923:b004:l011","ordinal":366429,"en":"Thus my soul rejoices."},{"id":"seytek-2012:p0923:b004:l012","ordinal":366430,"en":"I lower my spear and face him,"},{"id":"seytek-2012:p0923:b004:l013","ordinal":366431,"en":"And seize the fighting arm."},{"id":"seytek-2012:p0923:b004:l014","ordinal":366432,"en":"My poor soul is so overjoyed"},{"id":"seytek-2012:p0923:b004:l015","ordinal":366433,"en":"That I can scarcely stay upon the earth."},{"id":"seytek-2012:p0923:b004:l016","ordinal":366434,"en":"Though I fight another six days,"},{"id":"seytek-2012:p0923:b004:l017","ordinal":366435,"en":"My mounting fury will change;"},{"id":"seytek-2012:p0923:b004:l018","ordinal":366436,"en":"If he rages, shall I flee"},{"id":"seytek-2012:p0923:b004:l019","ordinal":366437,"en":"From that swine who calls himself a warrior?"},{"id":"seytek-2012:p0923:b004:l020","ordinal":366438,"en":"Let us find a way to settle his account."},{"id":"seytek-2012:p0923:b004:l021","ordinal":366439,"en":"My name is Kuyaly;"},{"id":"seytek-2012:p0923:b004:l022","ordinal":366440,"en":"I do not boast idly."},{"id":"seytek-2012:p0923:b004:l023","ordinal":366441,"en":"The wings beneath me"},{"id":"seytek-2012:p0923:b004:l024","ordinal":366442,"en":"Have fought in desert and amid armies."},{"id":"seytek-2012:p0923:b004:l025","ordinal":366443,"en":"This infidel Sarybai—"},{"id":"seytek-2012:p0923:b004:l026","ordinal":366444,"en":"Boasting is his habit."},{"id":"seytek-2012:p0923:b004:l027","ordinal":366445,"en":"Do not grieve, asking whether your vengeance died"},{"id":"seytek-2012:p0923:b004:l028","ordinal":366446,"en":"While he still raged before his death;"},{"id":"seytek-2012:p0923:b004:l029","ordinal":366447,"en":"Call him a doomed, overbearing wretch,"},{"id":"seytek-2012:p0923:b004:l030","ordinal":366448,"en":"And let not his people remain forever unreformed."},{"id":"seytek-2012:p0923:b004:l031","ordinal":366449,"en":"Split apart his arrow-proof coat;"},{"id":"seytek-2012:p0923:b004:l032","ordinal":366450,"en":"The calamity that has come from him—"},{"id":"seytek-2012:p0923:b004:l033","ordinal":366451,"en":"Try warding it off with your own hands."},{"id":"seytek-2012:p0923:b004:l034","ordinal":366452,"en":"Ride out in single combat,"},{"id":"seytek-2012:p0923:b004:l035","ordinal":366453,"en":"And clash with him once more."},{"id":"seytek-2012:p0923:b004:l036","ordinal":366454,"en":"These are the words I speak:"},{"id":"seytek-2012:p0923:b004:l037","ordinal":366455,"en":"I shall cast my challenge to the moon;"},{"id":"seytek-2012:p0923:b004:l038","ordinal":366456,"en":"The misery he brought upon the people"},{"id":"seytek-2012:p0923:b004:l039","ordinal":366457,"en":"I shall meet and turn aside."},{"id":"seytek-2012:p0923:b004:l040","ordinal":366458,"en":"If I die, dear people,"},{"id":"seytek-2012:p0924:b002:l001","ordinal":366459,"en":"Say, ‘She died at Sarybai's hand;"},{"id":"seytek-2012:p0924:b002:l002","ordinal":366460,"en":"She went to the land of no return;"},{"id":"seytek-2012:p0924:b002:l003","ordinal":366461,"en":"The lioness met her fate,’"},{"id":"seytek-2012:p0924:b002:l004","ordinal":366462,"en":"And abandon all hope of me."},{"id":"seytek-2012:p0924:b002:l005","ordinal":366463,"en":"Say, ‘Our true champion has died;"},{"id":"seytek-2012:p0924:b002:l006","ordinal":366464,"en":"The valiant maiden met her fate;"},{"id":"seytek-2012:p0924:b002:l007","ordinal":366465,"en":"Her blood filled the riverbed;"},{"id":"seytek-2012:p0924:b002:l008","ordinal":366466,"en":"She was extinguished like a fire.’"},{"id":"seytek-2012:p0924:b002:l009","ordinal":366467,"en":"Scatter those who have assembled;"},{"id":"seytek-2012:p0924:b002:l010","ordinal":366468,"en":"Flee in every direction."},{"id":"seytek-2012:p0924:b002:l011","ordinal":366469,"en":"But if you are men, if you are warriors,"},{"id":"seytek-2012:p0924:b002:l012","ordinal":366470,"en":"Strike and wage battle;"},{"id":"seytek-2012:p0924:b002:l013","ordinal":366471,"en":"Stand beneath the banner."},{"id":"seytek-2012:p0924:b002:l014","ordinal":366472,"en":"Seek out and witness"},{"id":"seytek-2012:p0924:b002:l015","ordinal":366473,"en":"The great, bloody conflict;"},{"id":"seytek-2012:p0924:b002:l016","ordinal":366474,"en":"When you see it, let us not lose heart."},{"id":"seytek-2012:p0924:b002:l017","ordinal":366475,"en":"Say that Kuyaly is dead,"},{"id":"seytek-2012:p0924:b002:l018","ordinal":366476,"en":"And surrender everything you behold!"},{"id":"seytek-2012:p0924:b002:l019","ordinal":366477,"en":"In the fierce, entangled battle,"},{"id":"seytek-2012:p0924:b002:l020","ordinal":366478,"en":"What use is grieving?"},{"id":"seytek-2012:p0924:b002:l021","ordinal":366479,"en":"In the harsh, ruined ravine,"},{"id":"seytek-2012:p0924:b002:l022","ordinal":366480,"en":"What use is wasting away in sorrow,"},{"id":"seytek-2012:p0924:b002:l023","ordinal":366481,"en":"Paling from yellow sickness—"},{"id":"seytek-2012:p0924:b002:l024","ordinal":366482,"en":"What use is pining?"},{"id":"seytek-2012:p0924:b002:l025","ordinal":366483,"en":"Champions who have girded your waists,"},{"id":"seytek-2012:p0924:b002:l026","ordinal":366484,"en":"Sarybai is a champion too,"},{"id":"seytek-2012:p0924:b002:l027","ordinal":366485,"en":"A black-hearted lion."},{"id":"seytek-2012:p0924:b002:l028","ordinal":366486,"en":"Do not stand idle—join battle;"},{"id":"seytek-2012:p0924:b002:l029","ordinal":366487,"en":"Lift up once"},{"id":"seytek-2012:p0924:b002:l030","ordinal":366488,"en":"This grievous, bitter burden."},{"id":"seytek-2012:p0924:b002:l031","ordinal":366489,"en":"When each one's courage is revealed,"},{"id":"seytek-2012:p0924:b002:l032","ordinal":366490,"en":"When they arrive with battle cries,"},{"id":"seytek-2012:p0924:b002:l033","ordinal":366491,"en":"If I fight them one by one"},{"id":"seytek-2012:p0924:b002:l034","ordinal":366492,"en":"And depart forever,"},{"id":"seytek-2012:p0924:b002:l035","ordinal":366493,"en":"Lower your spears."},{"id":"seytek-2012:p0924:b002:l036","ordinal":366494,"en":"If you are heroes, if you are men,"},{"id":"seytek-2012:p0924:b002:l037","ordinal":366495,"en":"If you bear the cry of the noble gray-maned wolf,"},{"id":"seytek-2012:p0924:b002:l038","ordinal":366496,"en":"If you are hawk-like warriors,"},{"id":"seytek-2012:p0924:b002:l039","ordinal":366497,"en":"And fate appoints me death,"},{"id":"seytek-2012:p0924:b002:l040","ordinal":366498,"en":"Then those of you who remain alive"},{"id":"seytek-2012:p0924:b003:l001","ordinal":366499,"en":"Stand as my support;"},{"id":"seytek-2012:p0924:b003:l002","ordinal":366500,"en":"Keep your promise!"},{"id":"seytek-2012:p0924:b003:l003","ordinal":366501,"en":"He has a tail and a living soul,"},{"id":"seytek-2012:p0924:b003:l004","ordinal":366502,"en":"And venom in his purpose;"},{"id":"seytek-2012:p0924:b003:l005","ordinal":366503,"en":"Let Sarybai despair of life,"},{"id":"seytek-2012:p0924:b003:l006","ordinal":366504,"en":"Saying, ‘Here is a soul with a mighty arm.’"},{"id":"seytek-2012:p0924:b003:l007","ordinal":366505,"en":"Such is the word you have heard from me."},{"id":"seytek-2012:p0924:b003:l008","ordinal":366506,"en":"Be my support and my strength;"},{"id":"seytek-2012:p0924:b003:l009","ordinal":366507,"en":"Charge forth against the enemy."},{"id":"seytek-2012:p0924:b003:l010","ordinal":366508,"en":"If I fight while holding the upper ground,"},{"id":"seytek-2012:p0924:b003:l011","ordinal":366509,"en":"Be my prop;"},{"id":"seytek-2012:p0924:b003:l012","ordinal":366510,"en":"If by chance I am driven downhill,"},{"id":"seytek-2012:p0924:b003:l013","ordinal":366511,"en":"Be my prop."},{"id":"seytek-2012:p0924:b003:l014","ordinal":366512,"en":"Do not let his army engulf me;"},{"id":"seytek-2012:p0924:b003:l015","ordinal":366513,"en":"Do not let them spear me from every side"},{"id":"seytek-2012:p0924:b003:l016","ordinal":366514,"en":"And close their ranks around me."},{"id":"seytek-2012:p0924:b003:l017","ordinal":366515,"en":"Let them not hem in my hands"},{"id":"seytek-2012:p0924:b003:l018","ordinal":366516,"en":"Or block my path."},{"id":"seytek-2012:p0924:b003:l019","ordinal":366517,"en":"Let him not display his prowess."},{"id":"seytek-2012:p0924:b003:l020","ordinal":366518,"en":"Sarybai is the one I face;"},{"id":"seytek-2012:p0924:b003:l021","ordinal":366519,"en":"Such is our notorious foe."},{"id":"seytek-2012:p0924:b003:l022","ordinal":366520,"en":"My allied peoples cry aloud,"},{"id":"seytek-2012:p0924:b003:l023","ordinal":366521,"en":"Shuddering and trembling."},{"id":"seytek-2012:p0924:b003:l024","ordinal":366522,"en":"Would God not strike us"},{"id":"seytek-2012:p0924:b003:l025","ordinal":366523,"en":"If I lost my senses"},{"id":"seytek-2012:p0924:b003:l026","ordinal":366524,"en":"And turned back in flight,"},{"id":"seytek-2012:p0924:b003:l027","ordinal":366525,"en":"Showed the enemy my horse's rump,"},{"id":"seytek-2012:p0924:b003:l028","ordinal":366526,"en":"And surrendered my reason?"},{"id":"seytek-2012:p0924:b003:l029","ordinal":366527,"en":"Would He not bring calamity"},{"id":"seytek-2012:p0924:b003:l030","ordinal":366528,"en":"When the great host panics?"},{"id":"seytek-2012:p0924:b003:l031","ordinal":366529,"en":"Would He not take them even as they flee?"},{"id":"seytek-2012:p0924:b003:l032","ordinal":366530,"en":"Therefore heed these words:"},{"id":"seytek-2012:p0924:b003:l033","ordinal":366531,"en":"Stand as my support."},{"id":"seytek-2012:p0924:b003:l034","ordinal":366532,"en":"If you do not support me,"},{"id":"seytek-2012:p0924:b003:l035","ordinal":366533,"en":"Will not seven wolves"},{"id":"seytek-2012:p0924:b003:l036","ordinal":366534,"en":"Fall upon and tear apart one sheep?"},{"id":"seytek-2012:p0924:b003:l037","ordinal":366535,"en":"A lone soul faces many perils;"},{"id":"seytek-2012:p0924:b003:l038","ordinal":366536,"en":"Will they not drag it away after beating it?"},{"id":"seytek-2012:p0924:b003:l039","ordinal":366537,"en":"Will not a thousand men"},{"id":"seytek-2012:p0924:b003:l040","ordinal":366538,"en":"Shoot down one person in a single day?"},{"id":"seytek-2012:p0925:b002:l001","ordinal":366539,"en":"Turn your chargers' heads;"},{"id":"seytek-2012:p0925:b002:l002","ordinal":366540,"en":"Stand ready, army, safe and sound;"},{"id":"seytek-2012:p0925:b002:l003","ordinal":366541,"en":"Do not stand idle—lower your spears."},{"id":"seytek-2012:p0925:b002:l004","ordinal":366542,"en":"If death overtakes you, die."},{"id":"seytek-2012:p0925:b002:l005","ordinal":366543,"en":"For the warrior Seytek,"},{"id":"seytek-2012:p0925:b002:l006","ordinal":366544,"en":"All the vast Kyrgyz host,"},{"id":"seytek-2012:p0925:b002:l007","ordinal":366545,"en":"Stand as my support."},{"id":"seytek-2012:p0925:b002:l008","ordinal":366546,"en":"Fight with ringing battle cries;"},{"id":"seytek-2012:p0925:b002:l009","ordinal":366547,"en":"Plunge into the tumult,"},{"id":"seytek-2012:p0925:b002:l010","ordinal":366548,"en":"Thrusting and dueling with spears."},{"id":"seytek-2012:p0925:b002:l011","ordinal":366549,"en":"When the uproar begins,"},{"id":"seytek-2012:p0925:b002:l012","ordinal":366550,"en":"Sarybai will ride out in single combat,"},{"id":"seytek-2012:p0925:b002:l013","ordinal":366551,"en":"Upon his frenzied racing camel."},{"id":"seytek-2012:p0925:b002:l014","ordinal":366552,"en":"His valor is extraordinary,"},{"id":"seytek-2012:p0925:b002:l015","ordinal":366553,"en":"His worth and venom immense."},{"id":"seytek-2012:p0925:b002:l016","ordinal":366554,"en":"That towering swine—"},{"id":"seytek-2012:p0925:b002:l017","ordinal":366555,"en":"The accursed man's spears"},{"id":"seytek-2012:p0925:b002:l018","ordinal":366556,"en":"Are wielded with skill."},{"id":"seytek-2012:p0925:b002:l019","ordinal":366557,"en":"Though Sarybai's devices are exhausted,"},{"id":"seytek-2012:p0925:b002:l020","ordinal":366558,"en":"He still has strength."},{"id":"seytek-2012:p0925:b002:l021","ordinal":366559,"en":"He found no mountain to strike,"},{"id":"seytek-2012:p0925:b002:l022","ordinal":366560,"en":"No enemy with whom to fight."},{"id":"seytek-2012:p0925:b002:l023","ordinal":366561,"en":"The power that enters great conflict,"},{"id":"seytek-2012:p0925:b002:l024","ordinal":366562,"en":"The power that unleashes great turmoil—"},{"id":"seytek-2012:p0925:b002:l025","ordinal":366563,"en":"When you go to face him"},{"id":"seytek-2012:p0925:b002:l026","ordinal":366564,"en":"And confront him,"},{"id":"seytek-2012:p0925:b002:l027","ordinal":366565,"en":"From the Kutbe side,"},{"id":"seytek-2012:p0925:b002:l028","ordinal":366566,"en":"Surge forward on the gray horse;"},{"id":"seytek-2012:p0925:b002:l029","ordinal":366567,"en":"Let the warriors enter from the flank."},{"id":"seytek-2012:p0925:b002:l030","ordinal":366568,"en":"Drive the young steeds through,"},{"id":"seytek-2012:p0925:b002:l031","ordinal":366569,"en":"And pursue as far as you reach."},{"id":"seytek-2012:p0925:b002:l032","ordinal":366570,"en":"From Alakem's lower side,"},{"id":"seytek-2012:p0925:b002:l033","ordinal":366571,"en":"Pour forth heavy fire."},{"id":"seytek-2012:p0925:b002:l034","ordinal":366572,"en":"Leave Sarybai's myriad host"},{"id":"seytek-2012:p0925:b002:l035","ordinal":366573,"en":"Unable to bind our hands."},{"id":"seytek-2012:p0925:b002:l036","ordinal":366574,"en":"Raise the battle cry and reach them;"},{"id":"seytek-2012:p0925:b002:l037","ordinal":366575,"en":"Charge all together,"},{"id":"seytek-2012:p0925:b002:l038","ordinal":366576,"en":"And wage war as one."},{"id":"seytek-2012:p0925:b002:l039","ordinal":366577,"en":"Such is the way of battle.”"},{"id":"seytek-2012:p0925:b002:l040","ordinal":366578,"en":"So spoke the champion maiden:"},{"id":"seytek-2012:p0925:b003:l001","ordinal":366579,"en":"“Sarybai, who has ridden out alone—"},{"id":"seytek-2012:p0925:b003:l002","ordinal":366580,"en":"I shall see how he rages,"},{"id":"seytek-2012:p0925:b003:l003","ordinal":366581,"en":"Put an end to his panting,"},{"id":"seytek-2012:p0925:b003:l004","ordinal":366582,"en":"Tear his eyes wide open,"},{"id":"seytek-2012:p0925:b003:l005","ordinal":366583,"en":"Crush him if he falls into my hands,"},{"id":"seytek-2012:p0925:b003:l006","ordinal":366584,"en":"Break his ribs,"},{"id":"seytek-2012:p0925:b003:l007","ordinal":366585,"en":"Seize him and spill his blood."},{"id":"seytek-2012:p0925:b003:l008","ordinal":366586,"en":"That marksman who calls himself a champion,"},{"id":"seytek-2012:p0925:b003:l009","ordinal":366587,"en":"Who made the whole world submit—"},{"id":"seytek-2012:p0925:b003:l010","ordinal":366588,"en":"Your lone-ranging warrior—"},{"id":"seytek-2012:p0925:b003:l011","ordinal":366589,"en":"I shall inflict great misery upon him"},{"id":"seytek-2012:p0925:b003:l012","ordinal":366590,"en":"And avenge the ancient grudge.”"},{"id":"seytek-2012:p0925:b003:l013","ordinal":366591,"en":"So saying, Kuyaly"},{"id":"seytek-2012:p0925:b003:l014","ordinal":366592,"en":"Gripped her weapon fiercely;"}]
