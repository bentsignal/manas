[{"id":"semetey-1-2013:p0429:b004:l035","ordinal":109825,"en":"They stood shouting at one another."},{"id":"semetey-1-2013:p0429:b004:l036","ordinal":109826,"en":"Roaring, they thrust their spears;"},{"id":"semetey-1-2013:p0429:b004:l037","ordinal":109827,"en":"The spears they thrust broke."},{"id":"semetey-1-2013:p0429:b004:l038","ordinal":109828,"en":"Men wearied; strength ebbed,"},{"id":"semetey-1-2013:p0429:b004:l039","ordinal":109829,"en":"In the slaughter where they met,"},{"id":"semetey-1-2013:p0430:b003:l001","ordinal":109830,"en":"Weakened as his dark blood flowed,"},{"id":"semetey-1-2013:p0430:b003:l002","ordinal":109831,"en":"When he was in dire distress,"},{"id":"semetey-1-2013:p0430:b003:l003","ordinal":109832,"en":"Your father grinned broadly,"},{"id":"semetey-1-2013:p0430:b003:l004","ordinal":109833,"en":"Utterly unconcerned,"},{"id":"semetey-1-2013:p0430:b003:l005","ordinal":109834,"en":"The countless Chinese wrestlers"},{"id":"semetey-1-2013:p0430:b003:l006","ordinal":109835,"en":"He deemed worth less than his trouser hem."},{"id":"semetey-1-2013:p0430:b003:l007","ordinal":109836,"en":"His guardian spirit Kojosan"},{"id":"semetey-1-2013:p0430:b003:l008","ordinal":109837,"en":"Rushed in to support his arms."},{"id":"semetey-1-2013:p0430:b003:l009","ordinal":109838,"en":"Kyrk chilten, Kyzyr Ilya"},{"id":"semetey-1-2013:p0430:b003:l010","ordinal":109839,"en":"They gathered like forty thousand souls."},{"id":"semetey-1-2013:p0430:b003:l011","ordinal":109840,"en":"The black-spotted leopard—"},{"id":"semetey-1-2013:p0430:b003:l012","ordinal":109841,"en":"If you looked, your fierce father—"},{"id":"semetey-1-2013:p0430:b003:l013","ordinal":109842,"en":"It leapt beside his flank."},{"id":"semetey-1-2013:p0430:b003:l014","ordinal":109843,"en":"The short-tailed, fierce-maned lion"},{"id":"semetey-1-2013:p0430:b003:l015","ordinal":109844,"en":"Made ready close beside him."},{"id":"semetey-1-2013:p0430:b003:l016","ordinal":109845,"en":"When your fortunate leopard father"},{"id":"semetey-1-2013:p0430:b003:l017","ordinal":109846,"en":"Charged ahead,"},{"id":"semetey-1-2013:p0430:b003:l018","ordinal":109847,"en":"He seemed like six thousand troops."},{"id":"semetey-1-2013:p0430:b003:l019","ordinal":109848,"en":"At the sight of that great form,"},{"id":"semetey-1-2013:p0430:b003:l020","ordinal":109849,"en":"The Chinese scattered in flight."},{"id":"semetey-1-2013:p0430:b003:l021","ordinal":109850,"en":"Those Chinese who had fled"},{"id":"semetey-1-2013:p0430:b003:l022","ordinal":109851,"en":"Shed blood when he caught them."},{"id":"semetey-1-2013:p0430:b003:l023","ordinal":109852,"en":"Among the fleeing Chinese,"},{"id":"semetey-1-2013:p0430:b003:l024","ordinal":109853,"en":"Kongurbay gathered his courage."},{"id":"semetey-1-2013:p0430:b003:l025","ordinal":109854,"en":"Just because he was Chinese,"},{"id":"semetey-1-2013:p0430:b003:l026","ordinal":109855,"en":"Let us not belittle Kongurbay."},{"id":"semetey-1-2013:p0430:b003:l027","ordinal":109856,"en":"Fortune favored him in all things;"},{"id":"semetey-1-2013:p0430:b003:l028","ordinal":109857,"en":"He was a hero born in Beijing."},{"id":"semetey-1-2013:p0430:b003:l029","ordinal":109858,"en":"From the countless seething host"},{"id":"semetey-1-2013:p0430:b003:l030","ordinal":109859,"en":"Came blood-red-whipped Shypshaydar,"},{"id":"semetey-1-2013:p0430:b003:l031","ordinal":109860,"en":"The khan called Shypshaydar."},{"id":"semetey-1-2013:p0430:b003:l032","ordinal":109861,"en":"Ill-natured Kongurbay—"},{"id":"semetey-1-2013:p0430:b003:l033","ordinal":109862,"en":"The wretch's voice could frighten souls away."},{"id":"semetey-1-2013:p0430:b003:l034","ordinal":109863,"en":"Kongurbay's black horse,"},{"id":"semetey-1-2013:p0430:b003:l035","ordinal":109864,"en":"That black horse had"},{"id":"semetey-1-2013:p0430:b003:l036","ordinal":109865,"en":"Wings upon its flanks."},{"id":"semetey-1-2013:p0430:b003:l037","ordinal":109866,"en":"When his precious life was pressed,"},{"id":"semetey-1-2013:p0430:b003:l038","ordinal":109867,"en":"Ill-natured Kongurbay"},{"id":"semetey-1-2013:p0430:b003:l039","ordinal":109868,"en":"The Black Kalmyks and Manchus—"},{"id":"semetey-1-2013:p0430:b004:l001","ordinal":109869,"en":"He would beat their mighty warriors:"},{"id":"semetey-1-2013:p0430:b004:l002","ordinal":109870,"en":"Driving them forward was his custom."},{"id":"semetey-1-2013:p0430:b004:l003","ordinal":109871,"en":"The coat-clad Chinese—"},{"id":"semetey-1-2013:p0430:b004:l004","ordinal":109872,"en":"He beat their strongest men"},{"id":"semetey-1-2013:p0430:b004:l005","ordinal":109873,"en":"And drove them into battle."},{"id":"semetey-1-2013:p0430:b004:l006","ordinal":109874,"en":"His armguards looming broad,"},{"id":"semetey-1-2013:p0430:b004:l007","ordinal":109875,"en":"Kongurbay pressed in to surround him."},{"id":"semetey-1-2013:p0430:b004:l008","ordinal":109876,"en":"The Black Kalmyks and Manchus"},{"id":"semetey-1-2013:p0430:b004:l009","ordinal":109877,"en":"Kongurbay drove in with blows."},{"id":"semetey-1-2013:p0430:b004:l010","ordinal":109878,"en":"The reason he drove them in—"},{"id":"semetey-1-2013:p0430:b004:l011","ordinal":109879,"en":"Was Kongurbay not a hero?"},{"id":"semetey-1-2013:p0430:b004:l012","ordinal":109880,"en":"Of Beijing’s Chinese and Manchus,"},{"id":"semetey-1-2013:p0430:b004:l013","ordinal":109881,"en":"Was Kongurbay not the backbone?"},{"id":"semetey-1-2013:p0430:b004:l014","ordinal":109882,"en":"Do not despise him as an unbeliever:"},{"id":"semetey-1-2013:p0430:b004:l015","ordinal":109883,"en":"Was Kongurbay not a lion?"},{"id":"semetey-1-2013:p0430:b004:l016","ordinal":109884,"en":"His coat of mail spreading wide,"},{"id":"semetey-1-2013:p0430:b004:l017","ordinal":109885,"en":"He beat his mighty warriors"},{"id":"semetey-1-2013:p0430:b004:l018","ordinal":109886,"en":"And hammered them forward."},{"id":"semetey-1-2013:p0430:b004:l019","ordinal":109887,"en":"Mace-bearing Tiken the mighty,"},{"id":"semetey-1-2013:p0430:b004:l020","ordinal":109888,"en":"The men with iron-rope nets,"},{"id":"semetey-1-2013:p0430:b004:l021","ordinal":109889,"en":"And all the Dagger-Hands—"},{"id":"semetey-1-2013:p0430:b004:l022","ordinal":109890,"en":"Once their khan had swarmed upon him,"},{"id":"semetey-1-2013:p0430:b004:l023","ordinal":109891,"en":"The great Chinese host grew thick."},{"id":"semetey-1-2013:p0430:b004:l024","ordinal":109892,"en":"Once they had all swarmed upon him,"},{"id":"semetey-1-2013:p0430:b004:l025","ordinal":109893,"en":"They would cast an iron net,"},{"id":"semetey-1-2013:p0430:b004:l026","ordinal":109894,"en":"Surround your father,"},{"id":"semetey-1-2013:p0430:b004:l027","ordinal":109895,"en":"And take him alive."},{"id":"semetey-1-2013:p0430:b004:l028","ordinal":109896,"en":"To Beijing's highborn women"},{"id":"semetey-1-2013:p0430:b004:l029","ordinal":109897,"en":"They would take him as a breeding stallion,"},{"id":"semetey-1-2013:p0430:b004:l030","ordinal":109898,"en":"On your own father, fierce Manas,"},{"id":"semetey-1-2013:p0430:b004:l031","ordinal":109899,"en":"They would take vengeance thus..."},{"id":"semetey-1-2013:p0430:b004:l032","ordinal":109900,"en":"Gray haze and burning dust,"},{"id":"semetey-1-2013:p0430:b004:l033","ordinal":109901,"en":"So many dying souls—"},{"id":"semetey-1-2013:p0430:b004:l034","ordinal":109902,"en":"With his wits shaken and strength gone,"},{"id":"semetey-1-2013:p0430:b004:l035","ordinal":109903,"en":"There was your father,"},{"id":"semetey-1-2013:p0430:b004:l036","ordinal":109904,"en":"Surrounded by the Chinese host."},{"id":"semetey-1-2013:p0430:b004:l037","ordinal":109905,"en":"Many strong warriors reached him."},{"id":"semetey-1-2013:p0430:b004:l038","ordinal":109906,"en":"As the swarming Chinese drew near,"},{"id":"semetey-1-2013:p0430:b004:l039","ordinal":109907,"en":"Your noble, fierce father—"},{"id":"semetey-1-2013:p0431:b003:l001","ordinal":109908,"en":"As they were about to take him alive,"},{"id":"semetey-1-2013:p0431:b003:l002","ordinal":109909,"en":"And bring him to such ruin,"},{"id":"semetey-1-2013:p0431:b003:l003","ordinal":109910,"en":"I, your unfortunate mother, said:"},{"id":"semetey-1-2013:p0431:b003:l004","ordinal":109911,"en":"'If my death has come, let me die;"},{"id":"semetey-1-2013:p0431:b003:l005","ordinal":109912,"en":"For my own generous lord,"},{"id":"semetey-1-2013:p0431:b003:l006","ordinal":109913,"en":"If I live, this woman"},{"id":"semetey-1-2013:p0431:b003:l007","ordinal":109914,"en":"Will stand at his side.'"},{"id":"semetey-1-2013:p0431:b003:l008","ordinal":109915,"en":"Saying this, wretched as I was,"},{"id":"semetey-1-2013:p0431:b003:l009","ordinal":109916,"en":"I leveled my spear and shouted,"},{"id":"semetey-1-2013:p0431:b003:l010","ordinal":109917,"en":"Concealing that I was a woman."},{"id":"semetey-1-2013:p0431:b003:l011","ordinal":109918,"en":"With 'Manas!' as my battle cry,"},{"id":"semetey-1-2013:p0431:b003:l012","ordinal":109919,"en":"Those shameless Chinese and Manchus"},{"id":"semetey-1-2013:p0431:b003:l013","ordinal":109920,"en":"From your fierce father Manas"},{"id":"semetey-1-2013:p0431:b003:l014","ordinal":109921,"en":"I drove back in confusion."},{"id":"semetey-1-2013:p0431:b003:l015","ordinal":109922,"en":"My crown chilled, my arms grew weary,"},{"id":"semetey-1-2013:p0431:b003:l016","ordinal":109923,"en":"As we aimed blows at one another's heads,"},{"id":"semetey-1-2013:p0431:b003:l017","ordinal":109924,"en":"Clashing with our spears,"},{"id":"semetey-1-2013:p0431:b003:l018","ordinal":109925,"en":"Struggling this way and that,"},{"id":"semetey-1-2013:p0431:b003:l019","ordinal":109926,"en":"The steadily leveled spears"},{"id":"semetey-1-2013:p0431:b003:l020","ordinal":109927,"en":"We parried from the front."},{"id":"semetey-1-2013:p0431:b003:l021","ordinal":109928,"en":"Those whose death had come died,"},{"id":"semetey-1-2013:p0431:b003:l022","ordinal":109929,"en":"And what Allah had ordained,"},{"id":"semetey-1-2013:p0431:b003:l023","ordinal":109930,"en":"Our wretched heads endured."},{"id":"semetey-1-2013:p0431:b003:l024","ordinal":109931,"en":"Your father, Manas the lion—"},{"id":"semetey-1-2013:p0431:b003:l025","ordinal":109932,"en":"They had heard he was a hero."},{"id":"semetey-1-2013:p0431:b003:l026","ordinal":109933,"en":"Clashing with the bloody khan,"},{"id":"semetey-1-2013:p0431:b003:l027","ordinal":109934,"en":"Your leopard father, fierce hero,"},{"id":"semetey-1-2013:p0431:b003:l028","ordinal":109935,"en":"Fought without retreating."},{"id":"semetey-1-2013:p0431:b003:l029","ordinal":109936,"en":"Leaning low, he speared a warrior,"},{"id":"semetey-1-2013:p0431:b003:l030","ordinal":109937,"en":"And the ancient Shibe and Manchu—"},{"id":"semetey-1-2013:p0431:b003:l031","ordinal":109938,"en":"He speared many of them in a row."},{"id":"semetey-1-2013:p0431:b003:l032","ordinal":109939,"en":"Wheeling Akkula about,"},{"id":"semetey-1-2013:p0431:b003:l033","ordinal":109940,"en":"He made the Shibe and Torgut fighters"},{"id":"semetey-1-2013:p0431:b003:l034","ordinal":109941,"en":"Who faced him fall and crawl."},{"id":"semetey-1-2013:p0431:b003:l035","ordinal":109942,"en":"When your khan father, blessed by Kyzyr,"},{"id":"semetey-1-2013:p0431:b003:l036","ordinal":109943,"en":"Wrought that dreadful slaughter,"},{"id":"semetey-1-2013:p0431:b003:l037","ordinal":109944,"en":"When the Argyn and Kyrgyz people"},{"id":"semetey-1-2013:p0431:b003:l038","ordinal":109945,"en":"From those Chinese hands"},{"id":"semetey-1-2013:p0431:b003:l039","ordinal":109946,"en":"He rescued,"},{"id":"semetey-1-2013:p0431:b004:l001","ordinal":109947,"en":"Of your father's Akkula,"},{"id":"semetey-1-2013:p0431:b004:l002","ordinal":109948,"en":"The swift steed, let me tell:"},{"id":"semetey-1-2013:p0431:b004:l003","ordinal":109949,"en":"When his precious life was pressed"},{"id":"semetey-1-2013:p0431:b004:l004","ordinal":109950,"en":"And the immense Chinese host came,"},{"id":"semetey-1-2013:p0431:b004:l005","ordinal":109951,"en":"As he ran downhill,"},{"id":"semetey-1-2013:p0431:b004:l006","ordinal":109952,"en":"Your father's Akkula"},{"id":"semetey-1-2013:p0431:b004:l007","ordinal":109953,"en":"Planted his forelegs like a roe deer."},{"id":"semetey-1-2013:p0431:b004:l008","ordinal":109954,"en":"As he headed uphill,"},{"id":"semetey-1-2013:p0431:b004:l009","ordinal":109955,"en":"That peerless winged steed"},{"id":"semetey-1-2013:p0431:b004:l010","ordinal":109956,"en":"Spread his mane and tail."},{"id":"semetey-1-2013:p0431:b004:l011","ordinal":109957,"en":"When he came to rounded hillocks,"},{"id":"semetey-1-2013:p0431:b004:l012","ordinal":109958,"en":"You're just an animal,"},{"id":"semetey-1-2013:p0431:b004:l013","ordinal":109959,"en":"Bounding and darting as he ran."},{"id":"semetey-1-2013:p0431:b004:l014","ordinal":109960,"en":"When he came to hilly ground,"},{"id":"semetey-1-2013:p0431:b004:l015","ordinal":109961,"en":"His eyes flashed like flint."},{"id":"semetey-1-2013:p0431:b004:l016","ordinal":109962,"en":"When he truly raced straight ahead,"},{"id":"semetey-1-2013:p0431:b004:l017","ordinal":109963,"en":"His mane and tail spread wide,"},{"id":"semetey-1-2013:p0431:b004:l018","ordinal":109964,"en":"And white foam mixed with blood"},{"id":"semetey-1-2013:p0431:b004:l019","ordinal":109965,"en":"Clung to his breast."},{"id":"semetey-1-2013:p0431:b004:l020","ordinal":109966,"en":"I watched in wonder,"},{"id":"semetey-1-2013:p0431:b004:l021","ordinal":109967,"en":"Saying, 'God, protect my only one!'"},{"id":"semetey-1-2013:p0431:b004:l022","ordinal":109968,"en":"And pleading with the Creator."},{"id":"semetey-1-2013:p0431:b004:l023","ordinal":109969,"en":"In some places,"},{"id":"semetey-1-2013:p0431:b004:l024","ordinal":109970,"en":"Your father's Akkula"},{"id":"semetey-1-2013:p0431:b004:l025","ordinal":109971,"en":"Raced the flying birds."},{"id":"semetey-1-2013:p0431:b004:l026","ordinal":109972,"en":"The specially braided white reins"},{"id":"semetey-1-2013:p0431:b004:l027","ordinal":109973,"en":"Grew rigid in his palm,"},{"id":"semetey-1-2013:p0431:b004:l028","ordinal":109974,"en":"Of that immeasurably swift steed,"},{"id":"semetey-1-2013:p0431:b004:l029","ordinal":109975,"en":"He wrestled with the bit."},{"id":"semetey-1-2013:p0431:b004:l030","ordinal":109976,"en":"Your father's Akkula—"},{"id":"semetey-1-2013:p0431:b004:l031","ordinal":109977,"en":"No animal matched his walk,"},{"id":"semetey-1-2013:p0431:b004:l032","ordinal":109978,"en":"No wind matched his trot."},{"id":"semetey-1-2013:p0431:b004:l033","ordinal":109979,"en":"The wind could not match him"},{"id":"semetey-1-2013:p0431:b004:l034","ordinal":109980,"en":"Because he was the Duldul of horses."},{"id":"semetey-1-2013:p0431:b004:l035","ordinal":109981,"en":"His custom was to ride six horses."},{"id":"semetey-1-2013:p0431:b004:l036","ordinal":109982,"en":"Your father's wings—"},{"id":"semetey-1-2013:p0431:b004:l037","ordinal":109983,"en":"Raiding the village and causing strife"},{"id":"semetey-1-2013:p0431:b004:l038","ordinal":109984,"en":"Was Kongurbay's custom."},{"id":"semetey-1-2013:p0431:b004:l039","ordinal":109985,"en":"'I will bind Manas and take him,' he said."},{"id":"semetey-1-2013:p0432:b003:l001","ordinal":109986,"en":"Raiding and causing strife—"},{"id":"semetey-1-2013:p0432:b003:l002","ordinal":109987,"en":"Such was Ezkara's campaign."},{"id":"semetey-1-2013:p0432:b003:l003","ordinal":109988,"en":"The massed Chinese, the emperor's people,"},{"id":"semetey-1-2013:p0432:b003:l004","ordinal":109989,"en":"Stood defiant and raised strife again."},{"id":"semetey-1-2013:p0432:b003:l005","ordinal":109990,"en":"The most skillful spearmen,"},{"id":"semetey-1-2013:p0432:b003:l006","ordinal":109991,"en":"The finest battle-axe wielders,"},{"id":"semetey-1-2013:p0432:b003:l007","ordinal":109992,"en":"The nimble, crafty, formidable men,"},{"id":"semetey-1-2013:p0432:b003:l008","ordinal":109993,"en":"The captains of ten and a thousand—"},{"id":"semetey-1-2013:p0432:b003:l009","ordinal":109994,"en":"The captains of ten bobbed in their saddles,"},{"id":"semetey-1-2013:p0432:b003:l010","ordinal":109995,"en":"Their spears jutting out."},{"id":"semetey-1-2013:p0432:b003:l011","ordinal":109996,"en":"The captain of a thousand grew excited;"},{"id":"semetey-1-2013:p0432:b003:l012","ordinal":109997,"en":"Captains of fifty and ten"},{"id":"semetey-1-2013:p0432:b003:l013","ordinal":109998,"en":"Raged beyond all reckoning."},{"id":"semetey-1-2013:p0432:b003:l014","ordinal":109999,"en":"They fired bullets like rain,"},{"id":"semetey-1-2013:p0432:b003:l015","ordinal":110000,"en":"And shot arrows like hail."},{"id":"semetey-1-2013:p0432:b003:l016","ordinal":110001,"en":"Look at the darkly burning embers,"},{"id":"semetey-1-2013:p0432:b003:l017","ordinal":110002,"en":"Coming straight at your khan father;"},{"id":"semetey-1-2013:p0432:b003:l018","ordinal":110003,"en":"Look at the bullets swarming over him."},{"id":"semetey-1-2013:p0432:b003:l019","ordinal":110004,"en":"Look at the hail, look at the embers,"},{"id":"semetey-1-2013:p0432:b003:l020","ordinal":110005,"en":"Look at the bullets striking separately."},{"id":"semetey-1-2013:p0432:b003:l021","ordinal":110006,"en":"Look at the trench they had dug,"},{"id":"semetey-1-2013:p0432:b003:l022","ordinal":110007,"en":"See the misery stirred up,"},{"id":"semetey-1-2013:p0432:b003:l023","ordinal":110008,"en":"The massed Chinese and countless Torgut—"},{"id":"semetey-1-2013:p0432:b003:l024","ordinal":110009,"en":"Look at the troops swarming over him."},{"id":"semetey-1-2013:p0432:b003:l025","ordinal":110010,"en":"Not sparing his own life,"},{"id":"semetey-1-2013:p0432:b003:l026","ordinal":110011,"en":"Kongurbay charged in fiercely."},{"id":"semetey-1-2013:p0432:b003:l027","ordinal":110012,"en":"Look at that great, renowned Kalcha."},{"id":"semetey-1-2013:p0432:b003:l028","ordinal":110013,"en":"His wrestlers, Yyby and Shyyky,"},{"id":"semetey-1-2013:p0432:b003:l029","ordinal":110014,"en":"Cast lassos at him from the side."},{"id":"semetey-1-2013:p0432:b003:l030","ordinal":110015,"en":"Ezkara, khan of the Manchus,"},{"id":"semetey-1-2013:p0432:b003:l031","ordinal":110016,"en":"Also shouted and thrust his spear."},{"id":"semetey-1-2013:p0432:b003:l032","ordinal":110017,"en":"Although many spears cut at once,"},{"id":"semetey-1-2013:p0432:b003:l033","ordinal":110018,"en":"Your father, blessed by Kyzyr,"},{"id":"semetey-1-2013:p0432:b003:l034","ordinal":110019,"en":"Stood looking on without flinching!"},{"id":"semetey-1-2013:p0432:b003:l035","ordinal":110020,"en":"Fortune favored him in everything."},{"id":"semetey-1-2013:p0432:b003:l036","ordinal":110021,"en":"If you looked within him,"},{"id":"semetey-1-2013:p0432:b003:l037","ordinal":110022,"en":"He was broader than the earth."},{"id":"semetey-1-2013:p0432:b003:l038","ordinal":110023,"en":"When it came to the Muslims,"},{"id":"semetey-1-2013:p0432:b003:l039","ordinal":110024,"en":"He was an unbreakable iron fortress,"},{"id":"semetey-1-2013:p0432:b004:l001","ordinal":110025,"en":"A lion of surpassing fortune."},{"id":"semetey-1-2013:p0432:b004:l002","ordinal":110026,"en":"A soul like your father—the one God"},{"id":"semetey-1-2013:p0432:b004:l003","ordinal":110027,"en":"Would never create, my orphan!"},{"id":"semetey-1-2013:p0432:b004:l004","ordinal":110028,"en":"When the Chinese pressed hard,"},{"id":"semetey-1-2013:p0432:b004:l005","ordinal":110029,"en":"When the shouting Chinese and many Manchus"},{"id":"semetey-1-2013:p0432:b004:l006","ordinal":110030,"en":"Your father, blessed by Kyzyr,"},{"id":"semetey-1-2013:p0432:b004:l007","ordinal":110031,"en":"Had surrounded,"},{"id":"semetey-1-2013:p0432:b004:l008","ordinal":110032,"en":"The massed Chinese stood defiant"},{"id":"semetey-1-2013:p0432:b004:l009","ordinal":110033,"en":"And swarmed in, clamoring."},{"id":"semetey-1-2013:p0432:b004:l010","ordinal":110034,"en":"When your father turned to look—"},{"id":"semetey-1-2013:p0432:b004:l011","ordinal":110035,"en":"Did you see what a lion he was?—"},{"id":"semetey-1-2013:p0432:b004:l012","ordinal":110036,"en":"The massed Chinese and many Manchus"},{"id":"semetey-1-2013:p0432:b004:l013","ordinal":110037,"en":"Fled away, clamoring."},{"id":"semetey-1-2013:p0432:b004:l014","ordinal":110038,"en":"When the Chinese advanced,"},{"id":"semetey-1-2013:p0432:b004:l015","ordinal":110039,"en":"When they attacked your father,"},{"id":"semetey-1-2013:p0432:b004:l016","ordinal":110040,"en":"Many a swift winged steed"},{"id":"semetey-1-2013:p0432:b004:l017","ordinal":110041,"en":"Had its saddle under its belly;"},{"id":"semetey-1-2013:p0432:b004:l018","ordinal":110042,"en":"Even more ran about, refusing capture."},{"id":"semetey-1-2013:p0432:b004:l019","ordinal":110043,"en":"Whimpering in Chinese,"},{"id":"semetey-1-2013:p0432:b004:l020","ordinal":110044,"en":"Chattering in Kalmyk,"},{"id":"semetey-1-2013:p0432:b004:l021","ordinal":110045,"en":"Fleeing, hurrying across the fields,"},{"id":"semetey-1-2013:p0432:b004:l022","ordinal":110046,"en":"Still more were coming to a halt."},{"id":"semetey-1-2013:p0432:b004:l023","ordinal":110047,"en":"'My precious, dear kinsman"},{"id":"semetey-1-2013:p0432:b004:l024","ordinal":110048,"en":"Died in such-and-such a place,' they said;"},{"id":"semetey-1-2013:p0432:b004:l025","ordinal":110049,"en":"Still more went about lamenting."},{"id":"semetey-1-2013:p0432:b004:l026","ordinal":110050,"en":"Separated from one another,"},{"id":"semetey-1-2013:p0432:b004:l027","ordinal":110051,"en":"Still more stood looking about."},{"id":"semetey-1-2013:p0432:b004:l028","ordinal":110052,"en":"Putting on a false show of courage,"},{"id":"semetey-1-2013:p0432:b004:l029","ordinal":110053,"en":"They blocked one another's way back"},{"id":"semetey-1-2013:p0432:b004:l030","ordinal":110054,"en":"And beat one another, many more."},{"id":"semetey-1-2013:p0432:b004:l031","ordinal":110055,"en":"Saying Khan Manas would slaughter them,"},{"id":"semetey-1-2013:p0432:b004:l032","ordinal":110056,"en":"They fled in terror, one by one;"},{"id":"semetey-1-2013:p0432:b004:l033","ordinal":110057,"en":"Still more scattered away."},{"id":"semetey-1-2013:p0432:b004:l034","ordinal":110058,"en":"Parted from their companions,"},{"id":"semetey-1-2013:p0432:b004:l035","ordinal":110059,"en":"Suffering distress, one by one,"},{"id":"semetey-1-2013:p0432:b004:l036","ordinal":110060,"en":"Still more went about looking."},{"id":"semetey-1-2013:p0432:b004:l037","ordinal":110061,"en":"Struck by spears in the clash,"},{"id":"semetey-1-2013:p0432:b004:l038","ordinal":110062,"en":"Still more cried out in misery."},{"id":"semetey-1-2013:p0432:b004:l039","ordinal":110063,"en":"Struck by battle-axes in the fight,"},{"id":"semetey-1-2013:p0433:b003:l001","ordinal":110064,"en":"Still more had been blinded."},{"id":"semetey-1-2013:p0433:b003:l002","ordinal":110065,"en":"With broken legs, unable to walk,"},{"id":"semetey-1-2013:p0433:b003:l003","ordinal":110066,"en":"Still more were being helped along."},{"id":"semetey-1-2013:p0433:b003:l004","ordinal":110067,"en":"With broken arms, crying in pain,"},{"id":"semetey-1-2013:p0433:b003:l005","ordinal":110068,"en":"Still more went about wailing."},{"id":"semetey-1-2013:p0433:b003:l006","ordinal":110069,"en":"Their cruppers broken,"},{"id":"semetey-1-2013:p0433:b003:l007","ordinal":110070,"en":"Their saddles slipping to their horses' necks,"},{"id":"semetey-1-2013:p0433:b003:l008","ordinal":110071,"en":"Still more were left in distress."},{"id":"semetey-1-2013:p0433:b003:l009","ordinal":110072,"en":"Many Chinese warriors"},{"id":"semetey-1-2013:p0433:b003:l010","ordinal":110073,"en":"Had their saddle-girths break,"},{"id":"semetey-1-2013:p0433:b003:l011","ordinal":110074,"en":"Their saddles falling under their horses' bellies;"},{"id":"semetey-1-2013:p0433:b003:l012","ordinal":110075,"en":"Still more were left in distress."},{"id":"semetey-1-2013:p0433:b003:l013","ordinal":110076,"en":"The cowards fled away;"},{"id":"semetey-1-2013:p0433:b003:l014","ordinal":110077,"en":"The brave stayed and fought."},{"id":"semetey-1-2013:p0433:b003:l015","ordinal":110078,"en":"When clear dawn broke,"},{"id":"semetey-1-2013:p0433:b003:l016","ordinal":110079,"en":"When light fell on the earth,"},{"id":"semetey-1-2013:p0433:b003:l017","ordinal":110080,"en":"Dawn whitened and opened,"}]
