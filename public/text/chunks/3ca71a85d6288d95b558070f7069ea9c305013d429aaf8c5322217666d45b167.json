[{"id":"seytek-2012:p0984:b002:l030","ordinal":372481,"en":"Is it right for her to go seeking a man?"},{"id":"seytek-2012:p0984:b002:l031","ordinal":372482,"en":"A lone girl like a princess,"},{"id":"seytek-2012:p0984:b002:l032","ordinal":372483,"en":"Should she go out to grapple?"},{"id":"seytek-2012:p0984:b002:l033","ordinal":372484,"en":"Roaming among the people and unsettling the land,"},{"id":"seytek-2012:p0984:b002:l034","ordinal":372485,"en":"Could there be a troublemaker like you?"},{"id":"seytek-2012:p0984:b002:l035","ordinal":372486,"en":"The only daughter of a noble soul,"},{"id":"seytek-2012:p0984:b002:l036","ordinal":372487,"en":"Is it fitting for her to seek a man?"},{"id":"seytek-2012:p0984:b002:l037","ordinal":372488,"en":"Could there be a troublemaker like you,"},{"id":"seytek-2012:p0984:b002:l038","ordinal":372489,"en":"Unless you meet me face to face?"},{"id":"seytek-2012:p0984:b002:l039","ordinal":372490,"en":"I draw my sword and sheath it,"},{"id":"seytek-2012:p0984:b002:l040","ordinal":372491,"en":"Now roused, I speak in earnest."},{"id":"seytek-2012:p0984:b003:l001","ordinal":372492,"en":"You cast poison into my ashes,"},{"id":"seytek-2012:p0984:b003:l002","ordinal":372493,"en":"Making your secret known to strangers,"},{"id":"seytek-2012:p0984:b003:l003","ordinal":372494,"en":"Thus you brought me to ruin."},{"id":"seytek-2012:p0984:b003:l004","ordinal":372495,"en":"You grappled with me, then turned away,"},{"id":"seytek-2012:p0984:b003:l005","ordinal":372496,"en":"You scorched my poor soul."},{"id":"seytek-2012:p0984:b003:l006","ordinal":372497,"en":"You made all your deeds dark as night,"},{"id":"seytek-2012:p0984:b003:l007","ordinal":372498,"en":"You darkened my heart."},{"id":"seytek-2012:p0984:b003:l008","ordinal":372499,"en":"You did it not once but a thousand times,"},{"id":"seytek-2012:p0984:b003:l009","ordinal":372500,"en":"Why did you stir up so much strife?"},{"id":"seytek-2012:p0984:b003:l010","ordinal":372501,"en":"You bound my fortune,"},{"id":"seytek-2012:p0984:b003:l011","ordinal":372502,"en":"I was a warrior, I was a lion,"},{"id":"seytek-2012:p0984:b003:l012","ordinal":372503,"en":"Yet you broke my spirit again and again."},{"id":"seytek-2012:p0984:b003:l013","ordinal":372504,"en":"You drained so much of my strength,"},{"id":"seytek-2012:p0984:b003:l014","ordinal":372505,"en":"You so often drove my soul to fury,"},{"id":"seytek-2012:p0984:b003:l015","ordinal":372506,"en":"Starting trouble every day,"},{"id":"seytek-2012:p0984:b003:l016","ordinal":372507,"en":"Together you brought me to ruin."},{"id":"seytek-2012:p0984:b003:l017","ordinal":372508,"en":"My anger rises and I stiffen,"},{"id":"seytek-2012:p0984:b003:l018","ordinal":372509,"en":"I will not leave any one of you unchallenged,"},{"id":"seytek-2012:p0984:b003:l019","ordinal":372510,"en":"In the desert of Batkalash,"},{"id":"seytek-2012:p0984:b003:l020","ordinal":372511,"en":"On the edge of It-Zhürbös, where no dog goes,"},{"id":"seytek-2012:p0984:b003:l021","ordinal":372512,"en":"I barely escaped with my life."},{"id":"seytek-2012:p0984:b003:l022","ordinal":372513,"en":"I owe no vengeance for your father,"},{"id":"seytek-2012:p0984:b003:l023","ordinal":372514,"en":"Yet you have fought so many such battles,"},{"id":"seytek-2012:p0984:b003:l024","ordinal":372515,"en":"Swaggering though your strength fails,"},{"id":"seytek-2012:p0984:b003:l025","ordinal":372516,"en":"You black-faced wretch, until I take revenge on you,"},{"id":"seytek-2012:p0984:b003:l026","ordinal":372517,"en":"Until I throw you from your horse,"},{"id":"seytek-2012:p0984:b003:l027","ordinal":372518,"en":"If I do not take you then,"},{"id":"seytek-2012:p0984:b003:l028","ordinal":372519,"en":"You paid no heed to my words,"},{"id":"seytek-2012:p0984:b003:l029","ordinal":372520,"en":"You made me a neglected suitor,"},{"id":"seytek-2012:p0984:b003:l030","ordinal":372521,"en":"You must have loved making me forlorn,"},{"id":"seytek-2012:p0984:b003:l031","ordinal":372522,"en":"You tracked my every step,"},{"id":"seytek-2012:p0984:b003:l032","ordinal":372523,"en":"And chased me until you grew pale,"},{"id":"seytek-2012:p0984:b003:l033","ordinal":372524,"en":"On the plain of Zhelpinish,"},{"id":"seytek-2012:p0984:b003:l034","ordinal":372525,"en":"I slew whoever came upon me,"},{"id":"seytek-2012:p0984:b003:l035","ordinal":372526,"en":"Without saying what I had to say,"},{"id":"seytek-2012:p0984:b003:l036","ordinal":372527,"en":"I went away without taking myself [unclear],"},{"id":"seytek-2012:p0984:b003:l037","ordinal":372528,"en":"Here I was made to feel neglected,"},{"id":"seytek-2012:p0984:b003:l038","ordinal":372529,"en":"You are false to everyone born,"},{"id":"seytek-2012:p0984:b003:l039","ordinal":372530,"en":"You are a soul burned by grief,"},{"id":"seytek-2012:p0984:b003:l040","ordinal":372531,"en":"Such grief has come over you."},{"id":"seytek-2012:p0985:b003:l001","ordinal":372532,"en":"You fought on the stony field,"},{"id":"seytek-2012:p0985:b003:l002","ordinal":372533,"en":"You clashed with me many times,"},{"id":"seytek-2012:p0985:b003:l003","ordinal":372534,"en":"When I thrust, you turned aside my spear,"},{"id":"seytek-2012:p0985:b003:l004","ordinal":372535,"en":"You bitter, vengeful bitch,"},{"id":"seytek-2012:p0985:b003:l005","ordinal":372536,"en":"You left me without a single maned or tailed beast,"},{"id":"seytek-2012:p0985:b003:l006","ordinal":372537,"en":"You inflicted that punishment on me."},{"id":"seytek-2012:p0985:b003:l007","ordinal":372538,"en":"You left me no horn with which to butt,"},{"id":"seytek-2012:p0985:b003:l008","ordinal":372539,"en":"You left me hornless and defenseless,"},{"id":"seytek-2012:p0985:b003:l009","ordinal":372540,"en":"Only my wasted frame remains; I have no strength,"},{"id":"seytek-2012:p0985:b003:l010","ordinal":372541,"en":"You left me clumsy and broken."},{"id":"seytek-2012:p0985:b003:l011","ordinal":372542,"en":"If I do not start a boundless quarrel,"},{"id":"seytek-2012:p0985:b003:l012","ordinal":372543,"en":"If I do not take you as a captive wife,"},{"id":"seytek-2012:p0985:b003:l013","ordinal":372544,"en":"I am Sarybay the hero,"},{"id":"seytek-2012:p0985:b003:l014","ordinal":372545,"en":"If I do not take my revenge without relenting,"},{"id":"seytek-2012:p0985:b003:l015","ordinal":372546,"en":"May I perish as though never born,"},{"id":"seytek-2012:p0985:b003:l016","ordinal":372547,"en":"May I die instead of living."},{"id":"seytek-2012:p0985:b003:l017","ordinal":372548,"en":"Fighting fiercely in earnest,"},{"id":"seytek-2012:p0985:b003:l018","ordinal":372549,"en":"Grappling chest to chest,"},{"id":"seytek-2012:p0985:b003:l019","ordinal":372550,"en":"If I do not wage a furious war,"},{"id":"seytek-2012:p0985:b003:l020","ordinal":372551,"en":"If I do not take you as a captive wife,"},{"id":"seytek-2012:p0985:b003:l021","ordinal":372552,"en":"May I perish as though never born,"},{"id":"seytek-2012:p0985:b003:l022","ordinal":372553,"en":"May I die instead of living."},{"id":"seytek-2012:p0985:b003:l023","ordinal":372554,"en":"I am Sarybay the hero,"},{"id":"seytek-2012:p0985:b003:l024","ordinal":372555,"en":"I will aim and thrust my spear,"},{"id":"seytek-2012:p0985:b003:l025","ordinal":372556,"en":"I will truly avenge myself."},{"id":"seytek-2012:p0985:b003:l026","ordinal":372557,"en":"I will bring you to your end,"},{"id":"seytek-2012:p0985:b003:l027","ordinal":372558,"en":"To that true place from which no soul returns,"},{"id":"seytek-2012:p0985:b003:l028","ordinal":372559,"en":"If I do not go there myself,"},{"id":"seytek-2012:p0985:b003:l029","ordinal":372560,"en":"The pass to which every soul must go,"},{"id":"seytek-2012:p0985:b003:l030","ordinal":372561,"en":"If I do not cross over it."},{"id":"seytek-2012:p0985:b003:l031","ordinal":372562,"en":"Moving, alive, still undying,"},{"id":"seytek-2012:p0985:b003:l032","ordinal":372563,"en":"Huddling and saying, 'I am alive,'"},{"id":"seytek-2012:p0985:b003:l033","ordinal":372564,"en":"Gulping and saying, 'I will not die,'"},{"id":"seytek-2012:p0985:b003:l034","ordinal":372565,"en":"I will claim my inheritance,"},{"id":"seytek-2012:p0985:b003:l035","ordinal":372566,"en":"A woman taken as booty, he said,"},{"id":"seytek-2012:p0985:b003:l036","ordinal":372567,"en":"I will seize her as spoil."},{"id":"seytek-2012:p0985:b003:l037","ordinal":372568,"en":"He burned with unbearable anguish,"},{"id":"seytek-2012:p0985:b003:l038","ordinal":372569,"en":"Setting someone upon a horse,"},{"id":"seytek-2012:p0985:b003:l039","ordinal":372570,"en":"Thus his soul burned with pain,"},{"id":"seytek-2012:p0985:b002:l001","ordinal":372571,"en":"Before the judges of horses,"},{"id":"seytek-2012:p0985:b002:l002","ordinal":372572,"en":"Having the strongmen beat you,"},{"id":"seytek-2012:p0985:b002:l003","ordinal":372573,"en":"Having your hair braided in fives,"},{"id":"seytek-2012:p0985:b002:l004","ordinal":372574,"en":"The possessions in your hands"},{"id":"seytek-2012:p0985:b002:l005","ordinal":372575,"en":"I will let hostile hands destroy,"},{"id":"seytek-2012:p0985:b002:l006","ordinal":372576,"en":"If I do not humiliate you like a sheep,"},{"id":"seytek-2012:p0985:b002:l007","ordinal":372577,"en":"If I do not take you as a captive wife,"},{"id":"seytek-2012:p0985:b002:l008","ordinal":372578,"en":"May I perish as though never born,"},{"id":"seytek-2012:p0985:b002:l009","ordinal":372579,"en":"May I die instead of living!"},{"id":"seytek-2012:p0985:b002:l010","ordinal":372580,"en":"What use is my being a hero?"},{"id":"seytek-2012:p0985:b002:l011","ordinal":372581,"en":"I will leave this world."},{"id":"seytek-2012:p0985:b002:l012","ordinal":372582,"en":"Raising a great tumult and uproar,"},{"id":"seytek-2012:p0985:b002:l013","ordinal":372583,"en":"I will bring you to your end,"},{"id":"seytek-2012:p0985:b002:l014","ordinal":372584,"en":"Semetey, in whom you put your trust,"},{"id":"seytek-2012:p0985:b002:l015","ordinal":372585,"en":"If I do not bring your head low,"},{"id":"seytek-2012:p0985:b002:l016","ordinal":372586,"en":"You ill-fated one struck from above,"},{"id":"seytek-2012:p0985:b002:l017","ordinal":372587,"en":"If I do not scatter your four kinds of livestock,"},{"id":"seytek-2012:p0985:b002:l018","ordinal":372588,"en":"What use is my being Sarybay?"},{"id":"seytek-2012:p0985:b002:l019","ordinal":372589,"en":"Rather than suffer shame at a woman's hands,"},{"id":"seytek-2012:p0985:b002:l020","ordinal":372590,"en":"I will leave this world."},{"id":"seytek-2012:p0985:b002:l021","ordinal":372591,"en":"I will wage war without asking leave,"},{"id":"seytek-2012:p0985:b002:l022","ordinal":372592,"en":"That swaggering wanton woman,"},{"id":"seytek-2012:p0985:b002:l023","ordinal":372593,"en":"If I do not take her as my captive,”"},{"id":"seytek-2012:p0985:b002:l024","ordinal":372594,"en":"So Sarybay spoke,"},{"id":"seytek-2012:p0985:b002:l025","ordinal":372595,"en":"A great quarrel and mighty uproar"},{"id":"seytek-2012:p0985:b002:l026","ordinal":372596,"en":"Were flaring higher and higher,"},{"id":"seytek-2012:p0985:b002:l027","ordinal":372597,"en":"Still more than before"},{"id":"seytek-2012:p0985:b002:l028","ordinal":372598,"en":"They were growing fiercer."},{"id":"seytek-2012:p0985:b002:l029","ordinal":372599,"en":"Sarybay seemed to overwhelm the whole world,"},{"id":"seytek-2012:p0985:b002:l030","ordinal":372600,"en":"Bearing down upon it."},{"id":"seytek-2012:p0985:b002:l031","ordinal":372601,"en":"His old quarrel"},{"id":"seytek-2012:p0985:b002:l032","ordinal":372602,"en":"Left no opening in the world,"},{"id":"seytek-2012:p0985:b002:l033","ordinal":372603,"en":"Closing it in on every side."},{"id":"seytek-2012:p0985:b002:l034","ordinal":372604,"en":"Sarybay, as before,"},{"id":"seytek-2012:p0985:b002:l035","ordinal":372605,"en":"Was growing still fiercer."},{"id":"seytek-2012:p0985:b002:l036","ordinal":372606,"en":"Crackling like lightning,"},{"id":"seytek-2012:p0985:b002:l037","ordinal":372607,"en":"With a menacing roar,"},{"id":"seytek-2012:p0985:b002:l038","ordinal":372608,"en":"Raising a piercing cry,"},{"id":"seytek-2012:p0985:b002:l039","ordinal":372609,"en":"Raising a shout of alarm,"},{"id":"seytek-2012:p0985:b002:l040","ordinal":372610,"en":"The swine had set his heart aflame,"},{"id":"seytek-2012:p0986:b002:l001","ordinal":372611,"en":"Like a pile of weeds,"},{"id":"seytek-2012:p0986:b002:l002","ordinal":372612,"en":"What I said is illegitimate"},{"id":"seytek-2012:p0986:b002:l003","ordinal":372613,"en":"Like an arrow of punishment,"},{"id":"seytek-2012:p0986:b002:l004","ordinal":372614,"en":"A pig with a soul"},{"id":"seytek-2012:p0986:b002:l005","ordinal":372615,"en":"The conflict is modest."},{"id":"seytek-2012:p0986:b002:l006","ordinal":372616,"en":"Do not speak"},{"id":"seytek-2012:p0986:b002:l007","ordinal":372617,"en":"Stuck to the bone."},{"id":"seytek-2012:p0986:b002:l008","ordinal":372618,"en":"Kuyaly, like a demon"},{"id":"seytek-2012:p0986:b002:l009","ordinal":372619,"en":"Otter fur on the head,"},{"id":"seytek-2012:p0986:b002:l010","ordinal":372620,"en":"If you see courage, it is black and blue."},{"id":"seytek-2012:p0986:b002:l011","ordinal":372621,"en":"To the urine of Sarybay,"},{"id":"seytek-2012:p0986:b002:l012","ordinal":372622,"en":"The anger that is being put"},{"id":"seytek-2012:p0986:b002:l013","ordinal":372623,"en":"Burning and burning"},{"id":"seytek-2012:p0986:b002:l014","ordinal":372624,"en":"Dying and disappearing"},{"id":"seytek-2012:p0986:b002:l015","ordinal":372625,"en":"The soul is buzzing, the teeth are gnashing,"},{"id":"seytek-2012:p0986:b002:l016","ordinal":372626,"en":"Heart widened with fear,"},{"id":"seytek-2012:p0986:b002:l017","ordinal":372627,"en":"It's cold and winter,"},{"id":"seytek-2012:p0986:b002:l018","ordinal":372628,"en":"If you see, the heart is cold,"},{"id":"seytek-2012:p0986:b002:l019","ordinal":372629,"en":"Courage surges, blood boils,"},{"id":"seytek-2012:p0986:b002:l020","ordinal":372630,"en":"Burning and boiling,"},{"id":"seytek-2012:p0986:b002:l021","ordinal":372631,"en":"A fierce anger began,"},{"id":"seytek-2012:p0986:b002:l022","ordinal":372632,"en":"A person who gives honor"},{"id":"seytek-2012:p0986:b002:l023","ordinal":372633,"en":"If I die, bury me"},{"id":"seytek-2012:p0986:b002:l024","ordinal":372634,"en":"He threw it on the ground,"},{"id":"seytek-2012:p0986:b002:l025","ordinal":372635,"en":"Burning and burning"},{"id":"seytek-2012:p0986:b002:l026","ordinal":372636,"en":"Kuyaly without going out to fight"},{"id":"seytek-2012:p0986:b002:l027","ordinal":372637,"en":"The neighbor stopped."},{"id":"seytek-2012:p0986:b002:l028","ordinal":372638,"en":"Looking around,"},{"id":"seytek-2012:p0986:b002:l029","ordinal":372639,"en":"He was so heartbroken,"},{"id":"seytek-2012:p0986:b002:l030","ordinal":372640,"en":"Despite wandering around,"},{"id":"seytek-2012:p0986:b002:l031","ordinal":372641,"en":"Kylcha took her life,"},{"id":"seytek-2012:p0986:b002:l032","ordinal":372642,"en":"May it be a black cheek,"},{"id":"seytek-2012:p0986:b002:l033","ordinal":372643,"en":"I can't hold back,"},{"id":"seytek-2012:p0986:b002:l034","ordinal":372644,"en":"It's windy"},{"id":"seytek-2012:p0986:b002:l035","ordinal":372645,"en":"Arrested,"},{"id":"seytek-2012:p0986:b002:l036","ordinal":372646,"en":"The secret left by Beren is the spear"},{"id":"seytek-2012:p0986:b002:l037","ordinal":372647,"en":"Holding the face,"},{"id":"seytek-2012:p0986:b002:l038","ordinal":372648,"en":"King God is the cause,"},{"id":"seytek-2012:p0986:b002:l039","ordinal":372649,"en":"Let's shake it,"},{"id":"seytek-2012:p0986:b002:l040","ordinal":372650,"en":"You are a hero"},{"id":"seytek-2012:p0986:b003:l001","ordinal":372651,"en":"God bless you,"},{"id":"seytek-2012:p0986:b003:l002","ordinal":372652,"en":"That's when Kuyaly,"},{"id":"seytek-2012:p0986:b003:l003","ordinal":372653,"en":"Say Baabedin quickly,"},{"id":"seytek-2012:p0986:b003:l004","ordinal":372654,"en":"Praying to God"},{"id":"seytek-2012:p0986:b003:l00