[{"id":"semetey-1-2013:p0493:b003:l006","ordinal":114433,"en":"“Never sated with asking,"},{"id":"semetey-1-2013:p0493:b003:l007","ordinal":114434,"en":"Never abandoning greed,"},{"id":"semetey-1-2013:p0493:b003:l008","ordinal":114435,"en":"Kyrgyz sultan, Burut hero,"},{"id":"semetey-1-2013:p0493:b003:l009","ordinal":114436,"en":"Today your questioning will come to an end."},{"id":"semetey-1-2013:p0493:b003:l011","ordinal":114437,"en":"Come to the open ground, Burut."},{"id":"semetey-1-2013:p0493:b003:l012","ordinal":114438,"en":"Not you—your precious Manas has encountered it."},{"id":"semetey-1-2013:p0493:b003:l014","ordinal":114439,"en":"He is grievously sick;"},{"id":"semetey-1-2013:p0493:b003:l015","ordinal":114440,"en":"Your Manas is pierced in forty places."},{"id":"semetey-1-2013:p0493:b003:l016","ordinal":114441,"en":"This is the road the scouts have reconnoitered;"},{"id":"semetey-1-2013:p0493:b003:l017","ordinal":114442,"en":"This is the force that kept striking."},{"id":"semetey-1-2013:p0493:b003:l018","ordinal":114443,"en":"Not merely you, my boy Syrgak—"},{"id":"semetey-1-2013:p0493:b003:l019","ordinal":114444,"en":"Gray-maned King Manas himself"},{"id":"semetey-1-2013:p0493:b003:l020","ordinal":114445,"en":"This is the force that took him.”"},{"id":"semetey-1-2013:p0493:b003:l021","ordinal":114446,"en":"Speaking thus, Kökchököz"},{"id":"semetey-1-2013:p0493:b003:l022","ordinal":114447,"en":"Charged in wrath,"},{"id":"semetey-1-2013:p0493:b003:l023","ordinal":114448,"en":"Turning Kertoru's head."},{"id":"semetey-1-2013:p0493:b003:l024","ordinal":114449,"en":"His outstretched spear, its head of cast iron,"},{"id":"semetey-1-2013:p0493:b003:l025","ordinal":114450,"en":"At poor young Syrgak"},{"id":"semetey-1-2013:p0493:b003:l026","ordinal":114451,"en":"He thrust with a roar."},{"id":"semetey-1-2013:p0493:b003:l027","ordinal":114452,"en":"The unbeliever's wrath poured out."},{"id":"semetey-1-2013:p0493:b003:l028","ordinal":114453,"en":"It was not young hero Syrgak—"},{"id":"semetey-1-2013:p0493:b003:l029","ordinal":114454,"en":"Alas, it was Bakai whose heart was troubled."},{"id":"semetey-1-2013:p0493:b003:l030","ordinal":114455,"en":"For young gray-maned Syrgak,"},{"id":"semetey-1-2013:p0493:b003:l031","ordinal":114456,"en":"Almambet, Chubak and Bakai"},{"id":"semetey-1-2013:p0493:b003:l032","ordinal":114457,"en":"Spread their hands, saying, “Amen!"},{"id":"semetey-1-2013:p0493:b003:l033","ordinal":114458,"en":"You were a boy of sixteen,"},{"id":"semetey-1-2013:p0493:b003:l034","ordinal":114459,"en":"A playful young soul."},{"id":"semetey-1-2013:p0493:b003:l035","ordinal":114460,"en":"If you are defeated, it will bring disgrace."},{"id":"semetey-1-2013:p0493:b003:l036","ordinal":114461,"en":"The prince's son"},{"id":"semetey-1-2013:p0493:b003:l037","ordinal":114462,"en":"Is entrusted to the one God!"},{"id":"semetey-1-2013:p0493:b003:l038","ordinal":114463,"en":"Against the unbeliever among spearmen,"},{"id":"semetey-1-2013:p0493:b003:l039","ordinal":114464,"en":"Against the skilled one he goes,"},{"id":"semetey-1-2013:p0493:b004:l001","ordinal":114465,"en":"The renowned man who knows the enemy's tactics."},{"id":"semetey-1-2013:p0493:b004:l002","ordinal":114466,"en":"My Syrgak goes against a champion."},{"id":"semetey-1-2013:p0493:b004:l003","ordinal":114467,"en":"What almighty Jabbar has decreed,"},{"id":"semetey-1-2013:p0493:b004:l004","ordinal":114468,"en":"He goes to see."},{"id":"semetey-1-2013:p0493:b004:l005","ordinal":114469,"en":"Among the many renowned Kalmyks,"},{"id":"semetey-1-2013:p0493:b004:l006","ordinal":114470,"en":"My Syrgak goes to die."},{"id":"semetey-1-2013:p0493:b004:l007","ordinal":114471,"en":"A lone hero whose life is measured—"},{"id":"semetey-1-2013:p0493:b004:l008","ordinal":114472,"en":"Will the Chinese cleave him apart?"},{"id":"semetey-1-2013:p0493:b004:l009","ordinal":114473,"en":"Creator, you alone, be his helper!"},{"id":"semetey-1-2013:p0493:b004:l010","ordinal":114474,"en":"Forty chiltens, my Khizr-Ilyas,"},{"id":"semetey-1-2013:p0493:b004:l011","ordinal":114475,"en":"Hear our cry and watch over him."},{"id":"semetey-1-2013:p0493:b004:l012","ordinal":114476,"en":"Pure Prophet, Ali the Lion,"},{"id":"semetey-1-2013:p0493:b004:l013","ordinal":114477,"en":"Support that little lion there!”"},{"id":"semetey-1-2013:p0493:b004:l015","ordinal":114478,"en":"Almambet and fortunate Bakai"},{"id":"semetey-1-2013:p0493:b004:l016","ordinal":114479,"en":"Spread their hands, saying, “Amen!”"},{"id":"semetey-1-2013:p0493:b004:l017","ordinal":114480,"en":"The noble ones gave their blessing."},{"id":"semetey-1-2013:p0493:b004:l018","ordinal":114481,"en":"As though they would part forever,"},{"id":"semetey-1-2013:p0493:b004:l019","ordinal":114482,"en":"The lions grieved for Syrgak."},{"id":"semetey-1-2013:p0493:b004:l021","ordinal":114483,"en":"Without looking about him,"},{"id":"semetey-1-2013:p0493:b004:l022","ordinal":114484,"en":"Renowned Syrgak himself"},{"id":"semetey-1-2013:p0493:b004:l023","ordinal":114485,"en":"Swayed out into battle,"},{"id":"semetey-1-2013:p0493:b004:l024","ordinal":114486,"en":"Not sparing his life at all."},{"id":"semetey-1-2013:p0493:b004:l025","ordinal":114487,"en":"The renowned young Syrgak"},{"id":"semetey-1-2013:p0493:b004:l026","ordinal":114488,"en":"Shouted, “Baba ad-Din!”"},{"id":"semetey-1-2013:p0493:b004:l027","ordinal":114489,"en":"As he reached the appointed ground,"},{"id":"semetey-1-2013:p0493:b004:l028","ordinal":114490,"en":"As he went to face his opponent,"},{"id":"semetey-1-2013:p0493:b004:l029","ordinal":114491,"en":"He raised the battle cry, “Manas!”"},{"id":"semetey-1-2013:p0493:b004:l030","ordinal":114492,"en":"In the bulletproof armor dear Kanykei, your sister-in-law, had made,"},{"id":"semetey-1-2013:p0493:b004:l032","ordinal":114493,"en":"He dressed without a gap."},{"id":"semetey-1-2013:p0493:b004:l033","ordinal":114494,"en":"He headed toward the Kalmyk,"},{"id":"semetey-1-2013:p0493:b004:l034","ordinal":114495,"en":"Like one seeing his wife's kin."},{"id":"semetey-1-2013:p0493:b004:l035","ordinal":114496,"en":"That fine fellow smiled broadly, laughing in delight."},{"id":"semetey-1-2013:p0493:b004:l037","ordinal":114497,"en":"Extending his spear, untroubled,"},{"id":"semetey-1-2013:p0493:b004:l038","ordinal":114498,"en":"Syrgak went forward,"},{"id":"semetey-1-2013:p0493:b004:l039","ordinal":114499,"en":"Toward the dark Kalmyk before him,"},{"id":"semetey-1-2013:p0494:b003:l001","ordinal":114500,"en":"Not considering him worth a trouser-leg."},{"id":"semetey-1-2013:p0494:b003:l002","ordinal":114501,"en":"Courage and lion-heartedness"},{"id":"semetey-1-2013:p0494:b003:l003","ordinal":114502,"en":"To young gray-maned Syrgak"},{"id":"semetey-1-2013:p0494:b003:l004","ordinal":114503,"en":"Allah the Creator"},{"id":"semetey-1-2013:p0494:b003:l005","ordinal":114504,"en":"Had given without measure."},{"id":"semetey-1-2013:p0494:b003:l006","ordinal":114505,"en":"He looked neither up nor down."},{"id":"semetey-1-2013:p0494:b003:l007","ordinal":114506,"en":"Have you seen his recklessness?"},{"id":"semetey-1-2013:p0494:b003:l008","ordinal":114507,"en":"The boy did not think of dying."},{"id":"semetey-1-2013:p0494:b003:l009","ordinal":114508,"en":"The boy shrank not at all from death;"},{"id":"semetey-1-2013:p0494:b003:l010","ordinal":114509,"en":"He never fled an enemy in battle."},{"id":"semetey-1-2013:p0494:b003:l011","ordinal":114510,"en":"Then Syrgak"},{"id":"semetey-1-2013:p0494:b003:l012","ordinal":114511,"en":"Turned Kökchebich's head."},{"id":"semetey-1-2013:p0494:b003:l013","ordinal":114512,"en":"Kökchököz, like Opol Mountain,"},{"id":"semetey-1-2013:p0494:b003:l014","ordinal":114513,"en":"Thrust his spear with a roar."},{"id":"semetey-1-2013:p0494:b003:l015","ordinal":114514,"en":"Kökchököz, like Opol Mountain—"},{"id":"semetey-1-2013:p0494:b003:l016","ordinal":114515,"en":"Let me tell of that gray-maned hero."},{"id":"semetey-1-2013:p0494:b003:l018","ordinal":114516,"en":"The great hair at his nape","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0494:b003:l019","ordinal":114517,"en":"Shook like a mallet."},{"id":"semetey-1-2013:p0494:b003:l020","ordinal":114518,"en":"Dust rose from his wrath;"},{"id":"semetey-1-2013:p0494:b003:l021","ordinal":114519,"en":"Lives fled before the unbeliever's might."},{"id":"semetey-1-2013:p0494:b003:l022","ordinal":114520,"en":"He had six battle-axes,"},{"id":"semetey-1-2013:p0494:b003:l023","ordinal":114521,"en":"One to replace another if it broke,"},{"id":"semetey-1-2013:p0494:b003:l024","ordinal":114522,"en":"Tied to his cotton belt."},{"id":"semetey-1-2013:p0494:b003:l025","ordinal":114523,"en":"He had three spears,"},{"id":"semetey-1-2013:p0494:b003:l026","ordinal":114524,"en":"Two laid beneath his thighs."},{"id":"semetey-1-2013:p0494:b003:l027","ordinal":114525,"en":"A blue spear some forty fathoms long"},{"id":"semetey-1-2013:p0494:b003:l028","ordinal":114526,"en":"He thrust firmly with a roar,"},{"id":"semetey-1-2013:p0494:b003:l029","ordinal":114527,"en":"Ready there at his hand."},{"id":"semetey-1-2013:p0494:b003:l030","ordinal":114528,"en":"Beneath Kökchököz"},{"id":"semetey-1-2013:p0494:b003:l031","ordinal":114529,"en":"Was his winged steed Kertoru."},{"id":"semetey-1-2013:p0494:b003:l032","ordinal":114530,"en":"The imposing Kökchököz—"},{"id":"semetey-1-2013:p0494:b003:l033","ordinal":114531,"en":"Not merely young Syrgak,"},{"id":"semetey-1-2013:p0494:b003:l034","ordinal":114532,"en":"He had strength to destroy the world."},{"id":"semetey-1-2013:p0494:b003:l035","ordinal":114533,"en":"Blood flowed at the news of him."},{"id":"semetey-1-2013:p0494:b003:l036","ordinal":114534,"en":"Your uncle came forward,"},{"id":"semetey-1-2013:p0494:b003:l037","ordinal":114535,"en":"Lives fleeing before his might."},{"id":"semetey-1-2013:p0494:b003:l038","ordinal":114536,"en":"He arrived before an arrow could."},{"id":"semetey-1-2013:p0494:b003:l039","ordinal":114537,"en":"Accomplished, renowned Syrgak,"},{"id":"semetey-1-2013:p0494:b004:l001","ordinal":114538,"en":"As he reached the Kalmyk,"},{"id":"semetey-1-2013:p0494:b004:l002","ordinal":114539,"en":"Struck him squarely on the jaw and passed."},{"id":"semetey-1-2013:p0494:b004:l003","ordinal":114540,"en":"It rang out, but he paid no heed."},{"id":"semetey-1-2013:p0494:b004:l004","ordinal":114541,"en":"Hero Syrgak's thrust,"},{"id":"semetey-1-2013:p0494:b004:l005","ordinal":114542,"en":"Mighty Kökchököz"},{"id":"semetey-1-2013:p0494:b004:l006","ordinal":114543,"en":"Counted as less than a trouser-leg."},{"id":"semetey-1-2013:p0494:b004:l007","ordinal":114544,"en":"Before Syrgak could rein in Kökchebich,"},{"id":"semetey-1-2013:p0494:b004:l008","ordinal":114545,"en":"The nimble gray-maned Kökchököz"},{"id":"semetey-1-2013:p0494:b004:l009","ordinal":114546,"en":"His blue spear forty fathoms long"},{"id":"semetey-1-2013:p0494:b004:l010","ordinal":114547,"en":"Thrust toward him with a shout."},{"id":"semetey-1-2013:p0494:b004:l011","ordinal":114548,"en":"Syrgak, leaning to one side,"},{"id":"semetey-1-2013:p0494:b004:l012","ordinal":114549,"en":"He charged up to and struck."},{"id":"semetey-1-2013:p0494:b004:l013","ordinal":114550,"en":"The spear's terrible impact—"},{"id":"semetey-1-2013:p0494:b004:l014","ordinal":114551,"en":"He toppled, disappearing from sight."},{"id":"semetey-1-2013:p0494:b004:l015","ordinal":114552,"en":"“O Almighty, protect me!” he cried."},{"id":"semetey-1-2013:p0494:b004:l016","ordinal":114553,"en":"Your Syrgak, Kökchebich's sacred mane"},{"id":"semetey-1-2013:p0494:b004:l017","ordinal":114554,"en":"Barely caught, and righted himself."},{"id":"semetey-1-2013:p0494:b004:l018","ordinal":114555,"en":"Upon Syrgak, barely staying upright,"},{"id":"semetey-1-2013:p0494:b004:l019","ordinal":114556,"en":"Kökchököz inflicted torment."},{"id":"semetey-1-2013:p0494:b004:l021","ordinal":114557,"en":"Kökchököz took it up","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0494:b004:l022","ordinal":114558,"en":"And fired forty times with it."},{"id":"semetey-1-2013:p0494:b004:l023","ordinal":114559,"en":"The gray arrow with steel bullets—"},{"id":"semetey-1-2013:p0494:b004:l024","ordinal":114560,"en":"With this he fired four times."},{"id":"semetey-1-2013:p0494:b004:l025","ordinal":114561,"en":"Renowned young Syrgak's"},{"id":"semetey-1-2013:p0494:b004:l026","ordinal":114562,"en":"Eyes began to dart;"},{"id":"semetey-1-2013:p0494:b004:l027","ordinal":114563,"en":"His legs began to dangle."},{"id":"semetey-1-2013:p0494:b004:l028","ordinal":114564,"en":"Azhybai, Bakai and Almambet"},{"id":"semetey-1-2013:p0494:b004:l029","ordinal":114565,"en":"Watched in anguish."},{"id":"semetey-1-2013:p0494:b004:l030","ordinal":114566,"en":"Kökchököz, the nimble leopard:"},{"id":"semetey-1-2013:p0494:b004:l031","ordinal":114567,"en":"“I will capture him alive,"},{"id":"semetey-1-2013:p0494:b004:l032","ordinal":114568,"en":"To the khagan's Chynchy Khan,"},{"id":"semetey-1-2013:p0494:b004:l033","ordinal":114569,"en":"To the strong fortress with forty gates,"},{"id":"semetey-1-2013:p0494:b004:l034","ordinal":114570,"en":"To the khagan's dark city,"},{"id":"semetey-1-2013:p0494:b004:l035","ordinal":114571,"en":"I will take him alive,"},{"id":"semetey-1-2013:p0494:b004:l036","ordinal":114572,"en":"Into a dungeon forty rope-lengths deep"},{"id":"semetey-1-2013:p0494:b004:l037","ordinal":114573,"en":"I will take and cast him.”"},{"id":"semetey-1-2013:p0494:b004:l038","ordinal":114574,"en":"Not yet come to full strength,"},{"id":"semetey-1-2013:p0494:b004:l039","ordinal":114575,"en":"From young gray-maned Syrgak,"},{"id":"semetey-1-2013:p0495:b003:l001","ordinal":114576,"en":"That is how I shall take revenge!"},{"id":"semetey-1-2013:p0495:b003:l002","ordinal":114577,"en":"Of Khan Manas's forty noble companions,"},{"id":"semetey-1-2013:p0495:b003:l003","ordinal":114578,"en":"I shall leave not one alive;"},{"id":"semetey-1-2013:p0495:b003:l004","ordinal":114579,"en":"To these Buruts standing here"},{"id":"semetey-1-2013:p0495:b003:l005","ordinal":114580,"en":"I shall do all I know how!”"},{"id":"semetey-1-2013:p0495:b003:l006","ordinal":114581,"en":"Against Syrgak, swaying there,"},{"id":"semetey-1-2013:p0495:b003:l007","ordinal":114582,"en":"His golden-cheeked battle-axe"},{"id":"semetey-1-2013:p0495:b003:l008","ordinal":114583,"en":"Kökchököz took up"},{"id":"semetey-1-2013:p0495:b003:l009","ordinal":114584,"en":"And struck four times with it."},{"id":"semetey-1-2013:p0495:b003:l010","ordinal":114585,"en":"Arkesken, the black steel sword,"},{"id":"semetey-1-2013:p0495:b003:l011","ordinal":114586,"en":"Syrgak the panther took in hand."},{"id":"semetey-1-2013:p0495:b003:l012","ordinal":114587,"en":"Of Kökchököz's spears,"},{"id":"semetey-1-2013:p0495:b003:l013","ordinal":114588,"en":"He broke two in succession."},{"id":"semetey-1-2013:p0495:b003:l014","ordinal":114589,"en":"They stood in single combat;"},{"id":"semetey-1-2013:p0495:b003:l015","ordinal":114590,"en":"Young Syrgak, that noble hero,"},{"id":"semetey-1-2013:p0495:b003:l016","ordinal":114591,"en":"Fought seven days without a rest."},{"id":"semetey-1-2013:p0495:b003:l017","ordinal":114592,"en":"Then came Almambet,"},{"id":"semetey-1-2013:p0495:b003:l018","ordinal":114593,"en":"Who had entered the caliph's presence and received a writ,"},{"id":"semetey-1-2013:p0495:b003:l019","ordinal":114594,"en":"Become a disciple of twelve spiritual guides,"},{"id":"semetey-1-2013:p0495:b003:l020","ordinal":114595,"en":"And earned the name of Supremely Renowned."},{"id":"semetey-1-2013:p0495:b003:l021","ordinal":114596,"en":"Wolf-man Almambet, the outstanding one,"},{"id":"semetey-1-2013:p0495:b003:l022","ordinal":114597,"en":"Whose heroic mettle stood apart,"},{"id":"semetey-1-2013:p0495:b003:l023","ordinal":114598,"en":"Struck Sarala on the flank,"},{"id":"semetey-1-2013:p0495:b003:l024","ordinal":114599,"en":"Crying, “Dear Syrgak!”"},{"id":"semetey-1-2013:p0495:b003:l025","ordinal":114600,"en":"Spurring the courser Aisarala"},{"id":"semetey-1-2013:p0495:b003:l026","ordinal":114601,"en":"This way and that,"},{"id":"semetey-1-2013:p0495:b003:l027","ordinal":114602,"en":"Lashing right and left,"},{"id":"semetey-1-2013:p0495:b003:l028","ordinal":114603,"en":"He arrived before an arrow could."},{"id":"semetey-1-2013:p0495:b003:l029","ordinal":114604,"en":"Reaching Kökchököz,"},{"id":"semetey-1-2013:p0495:b003:l030","ordinal":114605,"en":"That consummate wrestler, that swine,"},{"id":"semetey-1-2013:p0495:b003:l031","ordinal":114606,"en":"With the painted spear in his hand,"},{"id":"semetey-1-2013:p0495:b003:l032","ordinal":114607,"en":"His waist bent over beyond it,"},{"id":"semetey-1-2013:p0495:b003:l033","ordinal":114608,"en":"His rib bones jutting out,"},{"id":"semetey-1-2013:p0495:b003:l034","ordinal":114609,"en":"Without looking round,"},{"id":"semetey-1-2013:p0495:b003:l035","ordinal":114610,"en":"Without the slightest care for his life,"},{"id":"semetey-1-2013:p0495:b003:l036","ordinal":114611,"en":"Almambet shouted and thrust."},{"id":"semetey-1-2013:p0495:b003:l037","ordinal":114612,"en":"The Kalmyk did not even sway:"},{"id":"semetey-1-2013:p0495:b003:l038","ordinal":114613,"en":"Skilled on horseback, swift on foot,"},{"id":"semetey-1-2013:p0495:b003:l039","ordinal":114614,"en":"A mighty wrestler in state service."},{"id":"semetey-1-2013:p0495:b004:l001","ordinal":114615,"en":"Almambet stood upon the height;"},{"id":"semetey-1-2013:p0495:b004:l002","ordinal":114616,"en":"The Chinese stretched out and thrust;"},{"id":"semetey-1-2013:p0495:b004:l003","ordinal":114617,"en":"Almambet the lion did not flinch."},{"id":"semetey-1-2013:p0495:b004:l004","ordinal":114618,"en":"The Chinese braced himself;"},{"id":"semetey-1-2013:p0495:b004:l005","ordinal":114619,"en":"Almambet stretched out and thrust;"},{"id":"semetey-1-2013:p0495:b004:l006","ordinal":114620,"en":"The Chinese did not stir."},{"id":"semetey-1-2013:p0495:b004:l007","ordinal":114621,"en":"They thrust in turn,"},{"id":"semetey-1-2013:p0495:b004:l008","ordinal":114622,"en":"Taking their turns in order."},{"id":"semetey-1-2013:p0495:b004:l009","ordinal":114623,"en":"Their spears shattered"},{"id":"semetey-1-2013:p0495:b004:l010","ordinal":114624,"en":"Against the Chinese, foremost in strength,"},{"id":"semetey-1-2013:p0495:b004:l011","ordinal":114625,"en":"Almambet and Syrgak fought."},{"id":"semetey-1-2013:p0495:b004:l012","ordinal":114626,"en":"The Chinese watching them"},{"id":"semetey-1-2013:p0495:b004:l013","ordinal":114627,"en":"Drew their bows like rain,"},{"id":"semetey-1-2013:p0495:b004:l014","ordinal":114628,"en":"Shooting more thickly than hail."},{"id":"semetey-1-2013:p0495:b004:l015","ordinal":114629,"en":"Kökchököz's nine sons,"},{"id":"semetey-1-2013:p0495:b004:l016","ordinal":114630,"en":"Their very fame struck fear into those who saw them."},{"id":"semetey-1-2013:p0495:b004:l017","ordinal":114631,"en":"Fivefold beyond their father,"},{"id":"semetey-1-2013:p0495:b004:l018","ordinal":114632,"en":"They had studied wondrous arts."},{"id":"semetey-1-2013:p0495:b004:l019","ordinal":114633,"en":"Kökchököz's nine sons"},{"id":"semetey-1-2013:p0495:b004:l020","ordinal":114634,"en":"Came swooping down"},{"id":"semetey-1-2013:p0495:b004:l021","ordinal":114635,"en":"My wolf-men Almambet and Syrgak"},{"id":"semetey-1-2013:p0495:b004:l022","ordinal":114636,"en":"They surrounded."},{"id":"semetey-1-2013:p0495:b004:l023","ordinal":114637,"en":"Look at the rain, look at the fire,"},{"id":"semetey-1-2013:p0495:b004:l024","ordinal":114638,"en":"From those dogs, every one a wrestler,"},{"id":"semetey-1-2013:p0495:b004:l025","ordinal":114639,"en":"Look at the missiles raining down."},{"id":"semetey-1-2013:p0495:b004:l026","ordinal":114640,"en":"Look at the fiercely burning embers,"},{"id":"semetey-1-2013:p0495:b004:l027","ordinal":114641,"en":"Look at the missiles striking without a break."},{"id":"semetey-1-2013:p0495:b004:l028","ordinal":114642,"en":"Moon-banners, red standards,"},{"id":"semetey-1-2013:p0495:b004:l029","ordinal":114643,"en":"A burning haze ahead,"},{"id":"semetey-1-2013:p0495:b004:l030","ordinal":114644,"en":"Shrill cries and clamor."},{"id":"semetey-1-2013:p0495:b004:l031","ordinal":114645,"en":"Almambet and Syrgak—"},{"id":"semetey-1-2013:p0495:b004:l032","ordinal":114646,"en":"When Kökchököz and the nine he led"},{"id":"semetey-1-2013:p0495:b004:l033","ordinal":114647,"en":"Surrounded them,"},{"id":"semetey-1-2013:p0495:b004:l034","ordinal":114648,"en":"Hardship no man had seen"},{"id":"semetey-1-2013:p0495:b004:l035","ordinal":114649,"en":"They brought upon those noble heads."},{"id":"semetey-1-2013:p0495:b004:l036","ordinal":114650,"en":"The gray haze, the burning dust,"},{"id":"semetey-1-2013:p0495:b004:l037","ordinal":114651,"en":"So thick, it seemed, that nothing could be seen,"},{"id":"semetey-1-2013:p0495:b004:l038","ordinal":114652,"en":"Settled to the ground;"},{"id":"semetey-1-2013:p0495:b004:l039","ordinal":114653,"en":"The two khans, Ajybai and Bakai—"},{"id":"semetey-1-2013:p0496:b003:l001","ordinal":114654,"en":"They charged without a pause;"},{"id":"semetey-1-2013:p0496:b003:l002","ordinal":114655,"en":"The Muslims swept over the field."},{"id":"semetey-1-2013:p0496:b003:l003","ordinal":114656,"en":"Before those Muslims arrived,"},{"id":"semetey-1-2013:p0496:b003:l004","ordinal":114657,"en":"Fine steeds among all horses,"},{"id":"semetey-1-2013:p0496:b003:l005","ordinal":114658,"en":"Sharing death, their lives as one,"},{"id":"semetey-1-2013:p0496:b003:l006","ordinal":114659,"en":"Almambet and Syrgak fought together."},{"id":"semetey-1-2013:p0496:b003:l007","ordinal":114660,"en":"Drawing their bows like rain,"},{"id":"semetey-1-2013:p0496:b003:l008","ordinal":114661,"en":"The dogs had rushed them all at once;"},{"id":"semetey-1-2013:p0496:b003:l009","ordinal":114662,"en":"Unable to find a way out, Almambet the lion"},{"id":"semetey-1-2013:p0496:b003:l010","ordinal":114663,"en":"Was hard-pressed there."},{"id":"semetey-1-2013:p0496:b003:l011","ordinal":114664,"en":"Kökchököz's sons"},{"id":"semetey-1-2013:p0496:b003:l012","ordinal":114665,"en":"Almambet and Syrgak together"},{"id":"semetey-1-2013:p0496:b003:l013","ordinal":114666,"en":"They had surrounded."},{"id":"semetey-1-2013:p0496:b003:l014","ordinal":114667,"en":"Here was their intent:"},{"id":"semetey-1-2013:p0496:b003:l015","ordinal":114668,"en":"To the Khakan's Old Khan"},{"id":"semetey-1-2013:p0496:b003:l016","ordinal":114669,"en":"They would drive them alive,"},{"id":"semetey-1-2013:p0496:b003:l017","ordinal":114670,"en":"From the panther himself"},{"id":"semetey-1-2013:p0496:b003:l018","ordinal":114671,"en":"To take revenge in that far land."},{"id":"semetey-1-2013:p0496:b003:l019","ordinal":114672,"en":"Wearing his blue lynx-fur cap,"},{"id":"semetey-1-2013:p0496:b003:l020","ordinal":114673,"en":"Your wolf-man elder, Khan Bakai,"},{"id":"semetey-1-2013:p0496:b003:l021","ordinal":114674,"en":"Came straight into the fray."},{"id":"semetey-1-2013:p0496:b003:l022","ordinal":114675,"en":"Akbaltai's Chubak"},{"id":"semetey-1-2013:p0496:b003:l023","ordinal":114676,"en":"Plunged into the battle."},{"id":"semetey-1-2013:p0496:b003:l024","ordinal":114677,"en":"Like tumbleweed flying,"},{"id":"semetey-1-2013:p0496:b003:l025","ordinal":114678,"en":"Khan Manas's forty noble companions,"},{"id":"semetey-1-2013:p0496:b003:l026","ordinal":114679,"en":"All fighting side by side,"},{"id":"semetey-1-2013:p0496:b003:l027","ordinal":114680,"en":"Joined the melee."},{"id":"semetey-1-2013:p0496:b003:l028","ordinal":114681,"en":"Bloodthirsty Manas the panther,"},{"id":"semetey-1-2013:p0496:b003:l029","ordinal":114682,"en":"When he had come halfway,"},{"id":"semetey-1-2013:p0496:b003:l030","ordinal":114683,"en":"Suffered the grievous workings of the poison:"},{"id":"semetey-1-2013:p0496:b003:l031","ordinal":114684,"en":"Pierced in forty places,"},{"id":"semetey-1-2013:p0496:b003:l032","ordinal":114685,"en":"A dire ordeal that could kill him"},{"id":"semetey-1-2013:p0496:b003:l033","ordinal":114686,"en":"Had befallen the wolf-man with full force."},{"id":"semetey-1-2013:p0496:b003:l034","ordinal":114687,"en":"From some of the opened wounds"},{"id":"semetey-1-2013:p0496:b003:l035","ordinal":114688,"en":"Dark blood flowed;"}]
