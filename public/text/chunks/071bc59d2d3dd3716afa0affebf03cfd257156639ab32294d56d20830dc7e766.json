[{"id":"semetey-1-2013:p1165:b004:l020","ordinal":165121,"en":"Infidels and Muslims"},{"id":"semetey-1-2013:p1165:b004:l021","ordinal":165122,"en":"Said wrestling would be held for sport,"},{"id":"semetey-1-2013:p1165:b004:l022","ordinal":165123,"en":"That whoever threw his opponent would win the prize,"},{"id":"semetey-1-2013:p1165:b004:l023","ordinal":165124,"en":"And whoever fell would be left with nothing."},{"id":"semetey-1-2013:p1165:b004:l024","ordinal":165125,"en":"The prize for all the wrestlers"},{"id":"semetey-1-2013:p1165:b004:l025","ordinal":165126,"en":"Was a thousand black Bactrian camels"},{"id":"semetey-1-2013:p1165:b004:l026","ordinal":165127,"en":"And a thousand black, blaze-faced mares."},{"id":"semetey-1-2013:p1165:b004:l027","ordinal":165128,"en":"Bringing them to war and having them guarded,"},{"id":"semetey-1-2013:p1165:b004:l028","ordinal":165129,"en":"Having anyone who came near them beaten,"},{"id":"semetey-1-2013:p1165:b004:l029","ordinal":165130,"en":"Among infidels and Muslims,"},{"id":"semetey-1-2013:p1165:b004:l030","ordinal":165131,"en":"Hero Manas had set them aside."},{"id":"semetey-1-2013:p1165:b004:l031","ordinal":165132,"en":"When Manas unleashed his wrath,"},{"id":"semetey-1-2013:p1165:b004:l032","ordinal":165133,"en":"The people gathered in a throng."},{"id":"semetey-1-2013:p1165:b004:l033","ordinal":165134,"en":"“The plundering Chinese and Manchus"},{"id":"semetey-1-2013:p1165:b004:l034","ordinal":165135,"en":"Lined up as though they had drunk poison."},{"id":"semetey-1-2013:p1165:b004:l035","ordinal":165136,"en":"The peoples chose not to flee;"},{"id":"semetey-1-2013:p1165:b004:l036","ordinal":165137,"en":"They stayed to watch the spectacle."},{"id":"semetey-1-2013:p1165:b004:l037","ordinal":165138,"en":"When Koshoi advanced, ready,"},{"id":"semetey-1-2013:p1165:b004:l038","ordinal":165139,"en":"Let us leave this matter here"},{"id":"semetey-1-2013:p1165:b004:l039","ordinal":165140,"en":"With the wrestler of the Kalmyks."},{"id":"semetey-1-2013:p1166:b003:l001","ordinal":165141,"en":"Let us begin the tale of Joloy."},{"id":"semetey-1-2013:p1166:b003:l002","ordinal":165142,"en":"For six years he traveled on foot,"},{"id":"semetey-1-2013:p1166:b003:l003","ordinal":165143,"en":"Greasing his great spear,"},{"id":"semetey-1-2013:p1166:b003:l004","ordinal":165144,"en":"Laying low those who fought him—"},{"id":"semetey-1-2013:p1166:b003:l005","ordinal":165145,"en":"Hero Joloy, reeking of blood."},{"id":"semetey-1-2013:p1166:b003:l006","ordinal":165146,"en":"For seven years he traveled on foot,"},{"id":"semetey-1-2013:p1166:b003:l007","ordinal":165147,"en":"Greasing his well-made spear,"},{"id":"semetey-1-2013:p1166:b003:l008","ordinal":165148,"en":"Laying low all he reached—"},{"id":"semetey-1-2013:p1166:b003:l009","ordinal":165149,"en":"Hero Joloy, reeking of demons."},{"id":"semetey-1-2013:p1166:b003:l010","ordinal":165150,"en":"Fuming and roaring in anger,"},{"id":"semetey-1-2013:p1166:b003:l011","ordinal":165151,"en":"Dear Joloy came thundering:"},{"id":"semetey-1-2013:p1166:b003:l012","ordinal":165152,"en":"“I will tear off the head"},{"id":"semetey-1-2013:p1166:b003:l013","ordinal":165153,"en":"Of the Burut who has come to wrestle."},{"id":"semetey-1-2013:p1166:b003:l014","ordinal":165154,"en":"Upon this palm-sized Burut"},{"id":"semetey-1-2013:p1166:b003:l015","ordinal":165155,"en":"I will heap suffering all at once,” he said."},{"id":"semetey-1-2013:p1166:b003:l016","ordinal":165156,"en":"Your infidel Joloy roared."},{"id":"semetey-1-2013:p1166:b003:l017","ordinal":165157,"en":"“I will take"},{"id":"semetey-1-2013:p1166:b003:l018","ordinal":165158,"en":"This fucking Burut's prize."},{"id":"semetey-1-2013:p1166:b003:l019","ordinal":165159,"en":"I will take his prize and bind him,” he said."},{"id":"semetey-1-2013:p1166:b003:l020","ordinal":165160,"en":"“This Burut who calls himself a hero,"},{"id":"semetey-1-2013:p1166:b003:l021","ordinal":165161,"en":"I will chase as far as Mecca,” he said."},{"id":"semetey-1-2013:p1166:b003:l022","ordinal":165162,"en":"From among the infidel people,"},{"id":"semetey-1-2013:p1166:b003:l023","ordinal":165163,"en":"To wrestle on foot,"},{"id":"semetey-1-2013:p1166:b003:l024","ordinal":165164,"en":"Joloy came out alone."},{"id":"semetey-1-2013:p1166:b003:l025","ordinal":165165,"en":"Joloy's form"},{"id":"semetey-1-2013:p1166:b003:l026","ordinal":165166,"en":"Looked as large as a yurt."},{"id":"semetey-1-2013:p1166:b003:l027","ordinal":165167,"en":"Joloy of the Kalmyks"},{"id":"semetey-1-2013:p1166:b003:l028","ordinal":165168,"en":"Was like a hungry lion or tiger;"},{"id":"semetey-1-2013:p1166:b003:l029","ordinal":165169,"en":"No one who wrestled him survived."},{"id":"semetey-1-2013:p1166:b003:l030","ordinal":165170,"en":"On the field where they would wrestle,"},{"id":"semetey-1-2013:p1166:b003:l031","ordinal":165171,"en":"At the high center"},{"id":"semetey-1-2013:p1166:b003:l032","ordinal":165172,"en":"Of the gleaming plain,"},{"id":"semetey-1-2013:p1166:b003:l033","ordinal":165173,"en":"Ancient Koshoi stood."},{"id":"semetey-1-2013:p1166:b003:l034","ordinal":165174,"en":"Saying, “I will seize and throw the old man,”"},{"id":"semetey-1-2013:p1166:b003:l035","ordinal":165175,"en":"God had struck Joloy."},{"id":"semetey-1-2013:p1166:b003:l036","ordinal":165176,"en":"Do not ask what Joloy was like:"},{"id":"semetey-1-2013:p1166:b003:l037","ordinal":165177,"en":"He was drunk on liquor;"},{"id":"semetey-1-2013:p1166:b003:l038","ordinal":165178,"en":"This infidel was"},{"id":"semetey-1-2013:p1166:b003:l039","ordinal":165179,"en":"Far younger than your elder."},{"id":"semetey-1-2013:p1166:b004:l001","ordinal":165180,"en":"It was the time when he settled"},{"id":"semetey-1-2013:p1166:b004:l002","ordinal":165181,"en":"The Black Kalmyks' disputes."},{"id":"semetey-1-2013:p1166:b004:l003","ordinal":165182,"en":"It was the time when that infidel,"},{"id":"semetey-1-2013:p1166:b004:l004","ordinal":165183,"en":"Steeled with courage, was in full force."},{"id":"semetey-1-2013:p1166:b004:l005","ordinal":165184,"en":"It was the time when Joloy"},{"id":"semetey-1-2013:p1166:b004:l006","ordinal":165185,"en":"Was mounting in strength like a stallion."},{"id":"semetey-1-2013:p1166:b004:l007","ordinal":165186,"en":"The Kalmyks' küpsör garment"},{"id":"semetey-1-2013:p1166:b004:l008","ordinal":165187,"en":"He wrapped puffed around his waist."},{"id":"semetey-1-2013:p1166:b004:l009","ordinal":165188,"en":"Sixty billy-goat hides"},{"id":"semetey-1-2013:p1166:b004:l010","ordinal":165189,"en":"He had sewn together as its outer layer"},{"id":"semetey-1-2013:p1166:b004:l011","ordinal":165190,"en":"And made into trousers."},{"id":"semetey-1-2013:p1166:b004:l012","ordinal":165191,"en":"Bareheaded, his head huge as a cauldron,"},{"id":"semetey-1-2013:p1166:b004:l013","ordinal":165192,"en":"Down the back of that damned infidel"},{"id":"semetey-1-2013:p1166:b004:l014","ordinal":165193,"en":"Hung braided"},{"id":"semetey-1-2013:p1166:b004:l015","ordinal":165194,"en":"Black hair thick as a club."},{"id":"semetey-1-2013:p1166:b004:l016","ordinal":165195,"en":"Koshoi went striding forward;"},{"id":"semetey-1-2013:p1166:b004:l017","ordinal":165196,"en":"Hero Joloy, a mighty man,"},{"id":"semetey-1-2013:p1166:b004:l018","ordinal":165197,"en":"Came out before him."},{"id":"semetey-1-2013:p1166:b004:l019","ordinal":165198,"en":"Joloy spoke to Koshoi:"},{"id":"semetey-1-2013:p1166:b004:l020","ordinal":165199,"en":"“You are dead, Burut,” he said."},{"id":"semetey-1-2013:p1166:b004:l021","ordinal":165200,"en":"“Fortunate Manas's blessed one,"},{"id":"semetey-1-2013:p1166:b004:l022","ordinal":165201,"en":"My fucking Burut,"},{"id":"semetey-1-2013:p1166:b004:l023","ordinal":165202,"en":"I will break your leg.”"},{"id":"semetey-1-2013:p1166:b004:l024","ordinal":165203,"en":"Roaring in fury,"},{"id":"semetey-1-2013:p1166:b004:l025","ordinal":165204,"en":"Joloy came upon him."},{"id":"semetey-1-2013:p1166:b004:l026","ordinal":165205,"en":"Your dear elder Koshoi said,"},{"id":"semetey-1-2013:p1166:b004:l027","ordinal":165206,"en":"“Kalmyk, take your turn,”"},{"id":"semetey-1-2013:p1166:b004:l028","ordinal":165207,"en":"And held out his forearm."},{"id":"semetey-1-2013:p1166:b004:l029","ordinal":165208,"en":"Joloy, huge as Opol-Too,"},{"id":"semetey-1-2013:p1166:b004:l030","ordinal":165209,"en":"Seized him by the forearm."},{"id":"semetey-1-2013:p1166:b004:l031","ordinal":165210,"en":"Was it not Koshoi who divided"},{"id":"semetey-1-2013:p1166:b004:l032","ordinal":165211,"en":"The frontier of Esenkan?"},{"id":"semetey-1-2013:p1166:b004:l033","ordinal":165212,"en":"Was it not Koshoi who had grown accustomed"},{"id":"semetey-1-2013:p1166:b004:l034","ordinal":165213,"en":"To grappling with many men?"},{"id":"semetey-1-2013:p1166:b004:l035","ordinal":165214,"en":"Was it not capable Koshoi,"},{"id":"semetey-1-2013:p1166:b004:l036","ordinal":165215,"en":"Born to be a wrestler on foot?"},{"id":"semetey-1-2013:p1166:b004:l037","ordinal":165216,"en":"Was it not renowned Koshoi,"},{"id":"semetey-1-2013:p1166:b004:l038","ordinal":165217,"en":"Who had grappled with so many giants?"},{"id":"semetey-1-2013:p1166:b004:l039","ordinal":165218,"en":"The day passed as they wrestled,"}]
