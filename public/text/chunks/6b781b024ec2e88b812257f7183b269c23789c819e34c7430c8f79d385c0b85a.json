[{"id":"seytek-2012:p0391:b003:l020","ordinal":324353,"en":"Stretching tall as Surayyl,"},{"id":"seytek-2012:p0391:b003:l021","ordinal":324354,"en":"Striding jauntily and eagerly,"},{"id":"seytek-2012:p0391:b003:l022","ordinal":324355,"en":"Arching like a white doe,"},{"id":"seytek-2012:p0391:b003:l023","ordinal":324356,"en":"Rushing on without sparing her life,"},{"id":"seytek-2012:p0391:b003:l024","ordinal":324357,"en":"Driven by a furious spirit."},{"id":"seytek-2012:p0391:b003:l025","ordinal":324358,"en":"Her life, merely held in trust,"},{"id":"seytek-2012:p0391:b003:l026","ordinal":324359,"en":"She staked upon a single hair."},{"id":"seytek-2012:p0391:b003:l027","ordinal":324360,"en":"She broke away in fury,"},{"id":"seytek-2012:p0391:b003:l028","ordinal":324361,"en":"Her heroic courage plain,"},{"id":"seytek-2012:p0391:b003:l029","ordinal":324362,"en":"Her eyes dimmed, her heart aflame;"},{"id":"seytek-2012:p0391:b003:l030","ordinal":324363,"en":"Though many cried out, she strode on."},{"id":"seytek-2012:p0391:b003:l031","ordinal":324364,"en":"When courage rose, the head was forfeit,"},{"id":"seytek-2012:p0391:b003:l032","ordinal":324365,"en":"And from her currant-dark eyes"},{"id":"seytek-2012:p0391:b003:l033","ordinal":324366,"en":"Tears mingled with blood streamed down."},{"id":"seytek-2012:p0391:b003:l034","ordinal":324367,"en":"She began the true battle;"},{"id":"seytek-2012:p0391:b003:l035","ordinal":324368,"en":"Straining every sinew, the poor woman"},{"id":"seytek-2012:p0391:b003:l036","ordinal":324369,"en":"Cast away her fly-like life."},{"id":"seytek-2012:p0391:b003:l037","ordinal":324370,"en":"She summoned fierce resolve;"},{"id":"seytek-2012:p0391:b003:l038","ordinal":324371,"en":"This raging woman cast her precious life"},{"id":"seytek-2012:p0391:b003:l039","ordinal":324372,"en":"Without hesitation upon the black earth."},{"id":"seytek-2012:p0391:b003:l040","ordinal":324373,"en":"His blood draining, he ground his teeth."},{"id":"seytek-2012:p0392:b002:l001","ordinal":324374,"en":"Her heart boiled like fire:"},{"id":"seytek-2012:p0392:b002:l002","ordinal":324375,"en":"“Can an aged soul live forever?"},{"id":"seytek-2012:p0392:b002:l003","ordinal":324376,"en":"Has not the mischief"},{"id":"seytek-2012:p0392:b002:l004","ordinal":324377,"en":"Of wretched Chachykey gone far enough?"},{"id":"seytek-2012:p0392:b002:l005","ordinal":324378,"en":"Despairing of her fly-like life,"},{"id":"seytek-2012:p0392:b002:l006","ordinal":324379,"en":"Behind Aichürök"},{"id":"seytek-2012:p0392:b002:l007","ordinal":324380,"en":"Kanykey came running."},{"id":"seytek-2012:p0392:b002:l008","ordinal":324381,"en":"“Kanchoro has always been fierce."},{"id":"seytek-2012:p0392:b002:l009","ordinal":324382,"en":"My dear son Külchoro"},{"id":"seytek-2012:p0392:b002:l010","ordinal":324383,"en":"Has always been tenderhearted."},{"id":"seytek-2012:p0392:b002:l011","ordinal":324384,"en":"If they stand face-to-face,"},{"id":"seytek-2012:p0392:b002:l012","ordinal":324385,"en":"Thrusting spears and striking with axes,"},{"id":"seytek-2012:p0392:b002:l013","ordinal":324386,"en":"Battering each other in combat,"},{"id":"seytek-2012:p0392:b002:l014","ordinal":324387,"en":"Taking up Zulfiqar-like spears,"},{"id":"seytek-2012:p0392:b002:l015","ordinal":324388,"en":"Driving them into living hearts,"},{"id":"seytek-2012:p0392:b002:l016","ordinal":324389,"en":"And fighting without measure;"},{"id":"seytek-2012:p0392:b002:l017","ordinal":324390,"en":"If they begin a dreadful conflict"},{"id":"seytek-2012:p0392:b002:l018","ordinal":324391,"en":"And stake lives frail as flies"},{"id":"seytek-2012:p0392:b002:l019","ordinal":324392,"en":"Upon a single hair;"},{"id":"seytek-2012:p0392:b002:l020","ordinal":324393,"en":"If they begin a slaughtering battle,"},{"id":"seytek-2012:p0392:b002:l021","ordinal":324394,"en":"When blades are drawn aslant,"},{"id":"seytek-2012:p0392:b002:l022","ordinal":324395,"en":"The sword will blaze with heat"},{"id":"seytek-2012:p0392:b002:l023","ordinal":324396,"en":"As they grapple till they are cherry-red—"},{"id":"seytek-2012:p0392:b002:l024","ordinal":324397,"en":"Such is the ruin of furious war."},{"id":"seytek-2012:p0392:b002:l025","ordinal":324398,"en":"If by chance the fatal hour arrives"},{"id":"seytek-2012:p0392:b002:l026","ordinal":324399,"en":"In a struggle such as this,"},{"id":"seytek-2012:p0392:b002:l027","ordinal":324400,"en":"Kanchoro, who guarded the horde and ruled the people,"},{"id":"seytek-2012:p0392:b002:l028","ordinal":324401,"en":"Who mounted and held the golden throne,"},{"id":"seytek-2012:p0392:b002:l029","ordinal":324402,"en":"Who never suffered torment or humiliation"},{"id":"seytek-2012:p0392:b002:l030","ordinal":324403,"en":"But grazed freely on broad pastures,"},{"id":"seytek-2012:p0392:b002:l031","ordinal":324404,"en":"Whose five fingers never lacked grease,"},{"id":"seytek-2012:p0392:b002:l032","ordinal":324405,"en":"Whose marrow no arrow could pierce—"},{"id":"seytek-2012:p0392:b002:l033","ordinal":324406,"en":"Black-hearted Kanchoro"},{"id":"seytek-2012:p0392:b002:l034","ordinal":324407,"en":"Will wage the clash savagely."},{"id":"seytek-2012:p0392:b002:l035","ordinal":324408,"en":"By what means will he seize"},{"id":"seytek-2012:p0392:b002:l036","ordinal":324409,"en":"My only son, my sole protector?"},{"id":"seytek-2012:p0392:b002:l037","ordinal":324410,"en":"Only lately recovered from slavery,"},{"id":"seytek-2012:p0392:b002:l038","ordinal":324411,"en":"Grown strong after years of misery,"},{"id":"seytek-2012:p0392:b002:l039","ordinal":324412,"en":"His shoulders only newly filled out,"},{"id":"seytek-2012:p0392:b002:l040","ordinal":324413,"en":"My lion was pure steel."},{"id":"seytek-2012:p0392:b003:l001","ordinal":324414,"en":"Her darkening eyes became clouded;"},{"id":"seytek-2012:p0392:b003:l002","ordinal":324415,"en":"The two servants who kept her alive"},{"id":"seytek-2012:p0392:b003:l003","ordinal":324416,"en":"Stiffened like stakes, palsied,"},{"id":"seytek-2012:p0392:b003:l004","ordinal":324417,"en":"Their chests rasping,"},{"id":"seytek-2012:p0392:b003:l005","ordinal":324418,"en":"Their entire bodies"},{"id":"seytek-2012:p0392:b003:l006","ordinal":324419,"en":"Shuddering beyond control."},{"id":"seytek-2012:p0392:b003:l007","ordinal":324420,"en":"Her twelve bones and limbs"},{"id":"seytek-2012:p0392:b003:l008","ordinal":324421,"en":"Wasted helplessly, wheezing;"},{"id":"seytek-2012:p0392:b003:l009","ordinal":324422,"en":"Her ten vertebrae and eighty joints"},{"id":"seytek-2012:p0392:b003:l010","ordinal":324423,"en":"Crackled, swollen with yellow fluid."},{"id":"seytek-2012:p0392:b003:l011","ordinal":324424,"en":"Her waist sank and her back bent,"},{"id":"seytek-2012:p0392:b003:l012","ordinal":324425,"en":"Her stricken body withered."},{"id":"seytek-2012:p0392:b003:l013","ordinal":324426,"en":"The old lady remained there"},{"id":"seytek-2012:p0392:b003:l014","ordinal":324427,"en":"With her body weakened and diminished,"},{"id":"seytek-2012:p0392:b003:l015","ordinal":324428,"en":"Brought level with the black earth,"},{"id":"seytek-2012:p0392:b003:l016","ordinal":324429,"en":"Left stooped and bent."},{"id":"seytek-2012:p0392:b003:l017","ordinal":324430,"en":"Gripping the doorpost, she ran,"},{"id":"seytek-2012:p0392:b003:l018","ordinal":324431,"en":"Burning and grieving"},{"id":"seytek-2012:p0392:b003:l019","ordinal":324432,"en":"At Kanchoro’s wrath."},{"id":"seytek-2012:p0392:b003:l020","ordinal":324433,"en":"While divinely protected Külchoro,"},{"id":"seytek-2012:p0392:b003:l021","ordinal":324434,"en":"Her precious son, still lived,"},{"id":"seytek-2012:p0392:b003:l022","ordinal":324435,"en":"Kanchoro had humiliated her."},{"id":"seytek-2012:p0392:b003:l023","ordinal":324436,"en":"She came to slash him to pieces,"},{"id":"seytek-2012:p0392:b003:l024","ordinal":324437,"en":"To torture him and bring calamity,"},{"id":"seytek-2012:p0392:b003:l025","ordinal":324438,"en":"To spare not a hair of the villain,"},{"id":"seytek-2012:p0392:b003:l026","ordinal":324439,"en":"But torment him and take his life;"},{"id":"seytek-2012:p0392:b003:l027","ordinal":324440,"en":"To face whatever fate might bring,"},{"id":"seytek-2012:p0392:b003:l028","ordinal":324441,"en":"And stand as a protecting presence"},{"id":"seytek-2012:p0392:b003:l029","ordinal":324442,"en":"Beside her son, the falcon-warrior."},{"id":"seytek-2012:p0392:b003:l030","ordinal":324443,"en":"Your mother Kanykey ran,"},{"id":"seytek-2012:p0392:b003:l031","ordinal":324444,"en":"Flying like an arrow in her joy,"},{"id":"seytek-2012:p0392:b003:l032","ordinal":324445,"en":"Toward Khan Kanchoro’s horde,"},{"id":"seytek-2012:p0392:b003:l033","ordinal":324446,"en":"Ready as a hawk."},{"id":"seytek-2012:p0392:b003:l034","ordinal":324447,"en":"Inspiration came to her from the unseen;"},{"id":"seytek-2012:p0392:b003:l035","ordinal":324448,"en":"She weighed her wits and pondered:"},{"id":"seytek-2012:p0392:b003:l036","ordinal":324449,"en":"“I shall seize and slaughter Kanchoro,"},{"id":"seytek-2012:p0392:b003:l037","ordinal":324450,"en":"And roast the bitch Chachykey"},{"id":"seytek-2012:p0392:b003:l038","ordinal":324451,"en":"For my feast,"},{"id":"seytek-2012:p0392:b003:l039","ordinal":324452,"en":"Then put an end to the grievous misery"},{"id":"seytek-2012:p0392:b003:l040","ordinal":324453,"en":"And all the humiliations I have suffered.”"},{"id":"seytek-2012:p0393:b002:l001","ordinal":324454,"en":"The old guards blocking the road"},{"id":"seytek-2012:p0393:b002:l002","ordinal":324455,"en":"Threw everything down in ruin,"},{"id":"seytek-2012:p0393:b002:l003","ordinal":324456,"en":"Even the bravest among them."},{"id":"seytek-2012:p0393:b002:l004","ordinal":324457,"en":"The hard-pressed guards fled,"},{"id":"seytek-2012:p0393:b002:l005","ordinal":324458,"en":"Scattering their swords on the ridge;"},{"id":"seytek-2012:p0393:b002:l006","ordinal":324459,"en":"Bellowing and stumbling,"},{"id":"seytek-2012:p0393:b002:l007","ordinal":324460,"en":"Many souls fled back."},{"id":"seytek-2012:p0393:b002:l008","ordinal":324461,"en":"When they heard of the hero’s courage,"},{"id":"seytek-2012:p0393:b002:l009","ordinal":324462,"en":"The sentries ran away."},{"id":"seytek-2012:p0393:b002:l010","ordinal":324463,"en":"The many guards scattered in panic"},{"id":"seytek-2012:p0393:b002:l011","ordinal":324464,"en":"And reached their separate homes,"},{"id":"seytek-2012:p0393:b002:l012","ordinal":324465,"en":"Abandoning all their possessions;"},{"id":"seytek-2012:p0393:b002:l013","ordinal":324466,"en":"The swaggering champions"},{"id":"seytek-2012:p0393:b002:l014","ordinal":324467,"en":"Fled each to his own place."},{"id":"seytek-2012:p0393:b002:l015","ordinal":324468,"en":"“The hero’s son has come,” they said,"},{"id":"seytek-2012:p0393:b002:l016","ordinal":324469,"en":"“The apple of Külchoro’s eye;"},{"id":"seytek-2012:p0393:b002:l017","ordinal":324470,"en":"The bloodthirsty hero’s own young champion,"},{"id":"seytek-2012:p0393:b002:l018","ordinal":324471,"en":"For whose feast ninety beasts were slaughtered,"},{"id":"seytek-2012:p0393:b002:l019","ordinal":324472,"en":"Who was named Seytek—"},{"id":"seytek-2012:p0393:b002:l020","ordinal":324473,"en":"The noble one himself has come!”"},{"id":"seytek-2012:p0393:b002:l021","ordinal":324474,"en":"They swiftly invoked Baabedin,"},{"id":"seytek-2012:p0393:b002:l022","ordinal":324475,"en":"Having heard he was the consummate champion."},{"id":"seytek-2012:p0393:b002:l023","ordinal":324476,"en":"They heard that divinely protected Külchoro"},{"id":"seytek-2012:p0393:b002:l024","ordinal":324477,"en":"And hero Seytek had come."},{"id":"seytek-2012:p0393:b002:l025","ordinal":324478,"en":"The champions who had heard of them before"},{"id":"seytek-2012:p0393:b002:l026","ordinal":324479,"en":"Invoked God and slaughtered sheep,"},{"id":"seytek-2012:p0393:b002:l027","ordinal":324480,"en":"Shouting approval and slaughtering colts,"},{"id":"seytek-2012:p0393:b002:l028","ordinal":324481,"en":"And began a mighty celebration."},{"id":"seytek-2012:p0393:b002:l029","ordinal":324482,"en":"They left Kanchoro’s gate"},{"id":"seytek-2012:p0393:b002:l030","ordinal":324483,"en":"Deserted and unguarded."},{"id":"seytek-2012:p0393:b002:l031","ordinal":324484,"en":"They passed it contemptuously;"},{"id":"seytek-2012:p0393:b002:l032","ordinal":324485,"en":"The gatekeepers at the outer entrance,"},{"id":"seytek-2012:p0393:b002:l033","ordinal":324486,"en":"The keepers of the khan’s door,"},{"id":"seytek-2012:p0393:b002:l034","ordinal":324487,"en":"The warriors stationed on watch,"},{"id":"seytek-2012:p0393:b002:l035","ordinal":324488,"en":"And the brave sentries—"},{"id":"seytek-2012:p0393:b002:l036","ordinal":324489,"en":"Every one of them fled."},{"id":"seytek-2012:p0393:b002:l037","ordinal":324490,"en":"The people raised a clamorous uproar"},{"id":"seytek-2012:p0393:b002:l038","ordinal":324491,"en":"And had long since reached"},{"id":"seytek-2012:p0393:b002:l039","ordinal":324492,"en":"The very seat of Kanchoro."},{"id":"seytek-2012:p0393:b002:l040","ordinal":324493,"en":"Her champion and protector"},{"id":"seytek-2012:p0393:b003:l001","ordinal":324494,"en":"Had been wounded in sixty places."},{"id":"seytek-2012:p0393:b003:l002","ordinal":324495,"en":"The blue mountain pass had become a marsh;"},{"id":"seytek-2012:p0393:b003:l003","ordinal":324496,"en":"Little true valor remained"},{"id":"seytek-2012:p0393:b003:l004","ordinal":324497,"en":"Of that lineage now exhausted."},{"id":"seytek-2012:p0393:b003:l005","ordinal":324498,"en":"Few of the bloodline remained;"},{"id":"seytek-2012:p0393:b003:l006","ordinal":324499,"en":"Most of my son’s strength was gone."},{"id":"seytek-2012:p0393:b003:l007","ordinal":324500,"en":"“May that roaring madman"},{"id":"seytek-2012:p0393:b003:l008","ordinal":324501,"en":"Not suddenly bring humiliation upon him."},{"id":"seytek-2012:p0393:b003:l009","ordinal":324502,"en":"While my hair is white as down,"},{"id":"seytek-2012:p0393:b003:l010","ordinal":324503,"en":"As he sets out upon his journey,"},{"id":"seytek-2012:p0393:b003:l011","ordinal":324504,"en":"At the hour when he cannot turn back,"},{"id":"seytek-2012:p0393:b003:l012","ordinal":324505,"en":"Now that the end draws near,"},{"id":"seytek-2012:p0393:b003:l013","ordinal":324506,"en":"Let me die before fate claims me;"},{"id":"seytek-2012:p0393:b003:l014","ordinal":324507,"en":"For my son, small as a crow,"},{"id":"seytek-2012:p0393:b003:l015","ordinal":324508,"en":"Let me grapple and spill his enemy’s blood.”"},{"id":"seytek-2012:p0393:b003:l016","ordinal":324509,"en":"To inflict the utmost torment,"},{"id":"seytek-2012:p0393:b003:l017","ordinal":324510,"en":"And rescue divinely protected Külchoro"},{"id":"seytek-2012:p0393:b003:l018","ordinal":324511,"en":"From the furious swine’s clutches,"},{"id":"seytek-2012:p0393:b003:l019","ordinal":324512,"en":"She hastened onward."},{"id":"seytek-2012:p0393:b003:l020","ordinal":324513,"en":"What had been spoken early now seemed late;"},{"id":"seytek-2012:p0393:b003:l021","ordinal":324514,"en":"Her two eyes strained in longing,"},{"id":"seytek-2012:p0393:b003:l022","ordinal":324515,"en":"Her knees crackled as they bent,"},{"id":"seytek-2012:p0393:b003:l023","ordinal":324516,"en":"Yet summoning her courage, she ran."},{"id":"seytek-2012:p0393:b003:l024","ordinal":324517,"en":"How could she hold herself back?"},{"id":"seytek-2012:p0393:b003:l025","ordinal":324518,"en":"She leaned upon the sharp Albar sword"},{"id":"seytek-2012:p0393:b003:l026","ordinal":324519,"en":"Given by Atash;"},{"id":"seytek-2012:p0393:b003:l027","ordinal":324520,"en":"How could this grief-stricken old woman"},{"id":"seytek-2012:p0393:b003:l028","ordinal":324521,"en":"Possibly spare herself"},{"id":"seytek-2012:p0393:b003:l029","ordinal":324522,"en":"From the dragon’s affliction?"},{"id":"seytek-2012:p0393:b003:l030","ordinal":324523,"en":"Following Aichürök,"},{"id":"seytek-2012:p0393:b003:l031","ordinal":324524,"en":"The venerable white-haired Kanykey,"},{"id":"seytek-2012:p0393:b003:l032","ordinal":324525,"en":"His mother, arrived."},{"id":"seytek-2012:p0393:b003:l033","ordinal":324526,"en":"With a protector, one’s belly is full;"},{"id":"seytek-2012:p0393:b003:l034","ordinal":324527,"en":"Apart from one’s mother, there is no Mecca."},{"id":"seytek-2012:p0393:b003:l035","ordinal":324528,"en":"His mother had arrived,"},{"id":"seytek-2012:p0393:b003:l036","ordinal":324529,"en":"And beside his protector"},{"id":"seytek-2012:p0393:b003:l037","ordinal":324530,"en":"His beloved had arrived."},{"id":"seytek-2012:p0393:b003:l038","ordinal":324531,"en":"Külchoro saw his mother and sister-in-law,"},{"id":"seytek-2012:p0393:b003:l039","ordinal":324532,"en":"He saw his dearest ones."},{"id":"seytek-2012:p0393:b003:l040","ordinal":324533,"en":"When the venerable women came,"},{"id":"seytek-2012:p0394:b002:l001","ordinal":324534,"en":"His body turned cold and trembled,"},{"id":"seytek-2012:p0394:b002:l002","ordinal":324535,"en":"And his wretched life, merely held in trust,"},{"id":"seytek-2012:p0394:b002:l003","ordinal":324536,"en":"Started from his crown and shrieked."},{"id":"seytek-2012:p0394:b002:l004","ordinal":324537,"en":"Finding no place to make a stand,"},{"id":"seytek-2012:p0394:b002:l005","ordinal":324538,"en":"He despaired of his fly-like life;"},{"id":"seytek-2012:p0394:b002:l006","ordinal":324539,"en":"Not a trace of life remained in him."},{"id":"seytek-2012:p0394:b002:l007","ordinal":324540,"en":"His voice deserted his throat,"},{"id":"seytek-2012:p0394:b002:l008","ordinal":324541,"en":"His last owl-like feather fell,"},{"id":"seytek-2012:p0394:b002:l009","ordinal":324542,"en":"And he stood disheveled in anguish,"},{"id":"seytek-2012:p0394:b002:l010","ordinal":324543,"en":"Thus despairing of life."},{"id":"seytek-2012:p0394:b002:l011","ordinal":324544,"en":"His whole body shuddered"},{"id":"seytek-2012:p0394:b002:l012","ordinal":324545,"en":"When he saw Külchoro and Kanykey"},{"id":"seytek-2012:p0394:b002:l013","ordinal":324546,"en":"Together with Aichürök;"},{"id":"seytek-2012:p0394:b002:l014","ordinal":324547,"en":"The wretch found no recourse,"},{"id":"seytek-2012:p0394:b002:l015","ordinal":324548,"en":"And his tiny soul screamed."},{"id":"seytek-2012:p0394:b002:l016","ordinal":324549,"en":"He flew from the throne"},{"id":"seytek-2012:p0394:b002:l017","ordinal":324550,"en":"And crashed upon the ground."},{"id":"seytek-2012:p0394:b002:l018","ordinal":324551,"en":"His head struck the earth,"},{"id":"seytek-2012:p0394:b002:l019","ordinal":324552,"en":"And split open"},{"id":"seytek-2012:p0394:b002:l020","ordinal":324553,"en":"A full span and two fingers wide."},{"id":"seytek-2012:p0394:b002:l021","ordinal":324554,"en":"The oath-breaker was struck by his oath,"},{"id":"seytek-2012:p0394:b002:l022","ordinal":324555,"en":"The accursed was struck by a demon,"},{"id":"seytek-2012:p0394:b002:l023","ordinal":324556,"en":"Struck by the dust of the white horses,"},{"id":"seytek-2012:p0394:b002:l024","ordinal":324557,"en":"Struck by the glory of his father Manas,"},{"id":"seytek-2012:p0394:b002:l025","ordinal":324558,"en":"Struck by the strength of Semetey,"},{"id":"seytek-2012:p0394:b002:l026","ordinal":324559,"en":"Struck by Kanykey’s milk."},{"id":"seytek-2012:p0394:b002:l027","ordinal":324560,"en":"The warrior lay there, struck by his oath."},{"id":"seytek-2012:p0394:b002:l028","ordinal":324561,"en":"The accursed was struck by a demon,"},{"id":"seytek-2012:p0394:b002:l029","ordinal":324562,"en":"Struck by the bloom of the white fruit,"},{"id":"seytek-2012:p0394:b002:l030","ordinal":324563,"en":"Struck by the days of kumis and nights of maidens,"},{"id":"seytek-2012:p0394:b002:l031","ordinal":324564,"en":"Struck by the mighty age of the Kyrgyz."},{"id":"seytek-2012:p0394:b002:l032","ordinal":324565,"en":"As Kanchoro stood there thus,"},{"id":"seytek-2012:p0394:b002:l033","ordinal":324566,"en":"Kanykey and Aichürök"},{"id":"seytek-2012:p0394:b002:l034","ordinal":324567,"en":"Rose together in equal fury"},{"id":"seytek-2012:p0394:b002:l035","ordinal":324568,"en":"And addressed Kanchoro."},{"id":"seytek-2012:p0394:b002:l036","ordinal":324569,"en":"Speaking softly but striking hard,"},{"id":"seytek-2012:p0394:b002:l037","ordinal":324570,"en":"Kanykey entered and began:"},{"id":"seytek-2012:p0394:b002:l038","ordinal":324571,"en":"“Yesterday, when my son Semetey"},{"id":"seytek-2012:p0394:b002:l039","ordinal":324572,"en":"Was left fatherless,"},{"id":"seytek-2012:p0394:b002:l040","ordinal":324573,"en":"His mother carried him away in flight."},{"id":"seytek-2012:p0394:b003:l001","ordinal":324574,"en":"Deprived of his champions,"},{"id":"seytek-2012:p0394:b003:l002","ordinal":324575,"en":"That son of a bitch, that swine,"},{"id":"seytek-2012:p0394:b003:l003","ordinal":324576,"en":"That hero who troubled the world,"},{"id":"seytek-2012:p0394:b003:l004","ordinal":324577,"en":"That infidel who spread seductive turmoil,"},{"id":"seytek-2012:p0394:b003:l005","ordinal":324578,"en":"Was deserted by the retinue at his side"},{"id":"seytek-2012:p0394:b003:l006","ordinal":324579,"en":"And left sitting thus."},{"id":"seytek-2012:p0394:b003:l007","ordinal":324580,"en":"His guards fled and his strength departed,"},{"id":"seytek-2012:p0394:b003:l008","ordinal":324581,"en":"The watchmen beside him were gone;"},{"id":"seytek-2012:p0394:b003:l009","ordinal":324582,"en":"He had no champions and no khan."},{"id":"seytek-2012:p0394:b003:l010","ordinal":324583,"en":"All the fierce men who would swarm"},{"id":"seytek-2012:p0394:b003:l011","ordinal":324584,"en":"At a single command were gone."},{"id":"seytek-2012:p0394:b003:l012","ordinal":324585,"en":"However loudly he shouted and cried,"},{"id":"seytek-2012:p0394:b003:l013","ordinal":324586,"en":"He had neither support nor strength,"},{"id":"seytek-2012:p0394:b003:l014","ordinal":324587,"en":"No stronghold from which to shoot,"},{"id":"seytek-2012:p0394:b003:l015","ordinal":324588,"en":"No khan to serve as protector,"},{"id":"seytek-2012:p0394:b003:l016","ordinal":324589,"en":"And none of the courageous heroes."},{"id":"seytek-2012:p0394:b003:l017","ordinal":324590,"en":"He burned fiercely in grief,"},{"id":"seytek-2012:p0394:b003:l018","ordinal":324591,"en":"And was parted from the wife"},{"id":"seytek-2012:p0394:b003:l019","ordinal":324592,"en":"Who had been his protector,"},{"id":"seytek-2012:p0394:b003:l020","ordinal":324593,"en":"Leaving him alone in the horde."},{"id":"seytek-2012:p0394:b003:l021","ordinal":324594,"en":"The two women and Külchoro"},{"id":"seytek-2012:p0394:b003:l022","ordinal":324595,"en":"Prepared to punish the villain who ruined the people,"},{"id":"seytek-2012:p0394:b003:l023","ordinal":324596,"en":"The wild-headed instigator of strife,"},{"id":"seytek-2012:p0394:b003:l024","ordinal":324597,"en":"The great lord known throughout the age,"},{"id":"seytek-2012:p0394:b003:l025","ordinal":324598,"en":"The fiercely wrathful destroyer,"},{"id":"seytek-2012:p0394:b003:l026","ordinal":324599,"en":"The slayer of so many heroes—"},{"id":"seytek-2012:p0394:b003:l027","ordinal":324600,"en":"They would make the staggering lord,"},{"id":"seytek-2012:p0394:b003:l028","ordinal":324601,"en":"The great Kanchoro,"},{"id":"seytek-2012:p0394:b003:l029","ordinal":324602,"en":"Pay the penalty."},{"id":"seytek-2012:p0394:b003:l030","ordinal":324603,"en":"Kanykey and Chürök burned with grief;"},{"id":"seytek-2012:p0394:b003:l031","ordinal":324604,"en":"Wretched Kanchoro"},{"id":"seytek-2012:p0394:b003:l032","ordinal":324605,"en":"Despaired of his precious life."},{"id":"seytek-2012:p0394:b003:l033","ordinal":324606,"en":"Courage left his heart,"},{"id":"seytek-2012:p0394:b003:l034","ordinal":324607,"en":"Strength left his wrists,"},{"id":"seytek-2012:p0394:b003:l035","ordinal":324608,"en":"Tears fell from his lashes;"}]
