[{"id":"semetey-1-2013:p0748:b003:l009","ordinal":133633,"en":"In the desert of an empty plain,"},{"id":"semetey-1-2013:p0748:b003:l010","ordinal":133634,"en":"Encountered by unseen providence,"},{"id":"semetey-1-2013:p0748:b003:l011","ordinal":133635,"en":"Six sharp blades in the empty plain"},{"id":"semetey-1-2013:p0748:b003:l012","ordinal":133636,"en":"Were found by leopard Khan Manas."},{"id":"semetey-1-2013:p0748:b003:l013","ordinal":133637,"en":"The very finest of swords:"},{"id":"semetey-1-2013:p0748:b003:l014","ordinal":133638,"en":"Zulpukor, taken by Manas,"},{"id":"semetey-1-2013:p0748:b003:l015","ordinal":133639,"en":"Khan Bakai's Oikuma,"},{"id":"semetey-1-2013:p0748:b003:l016","ordinal":133640,"en":"Azhybai's Achalbars,"},{"id":"semetey-1-2013:p0748:b003:l017","ordinal":133641,"en":"Zhoikuma, taken by Almambet,"},{"id":"semetey-1-2013:p0748:b003:l018","ordinal":133642,"en":"Kylbolot, taken by Chubak,"},{"id":"semetey-1-2013:p0748:b003:l019","ordinal":133643,"en":"Narkesken, taken by Syrgak."},{"id":"semetey-1-2013:p0748:b003:l020","ordinal":133644,"en":"Those were the six sharp steel blades."},{"id":"semetey-1-2013:p0748:b003:l021","ordinal":133645,"en":"To every enemy they fought,"},{"id":"semetey-1-2013:p0748:b003:l022","ordinal":133646,"en":"Those treasures brought torment."},{"id":"semetey-1-2013:p0748:b003:l023","ordinal":133647,"en":"Upon any enemy who turned against them,"},{"id":"semetey-1-2013:p0748:b003:l024","ordinal":133648,"en":"Those blades brought slaughter."},{"id":"semetey-1-2013:p0748:b003:l025","ordinal":133649,"en":"When eagerly drawn from their sheaths,"},{"id":"semetey-1-2013:p0748:b003:l026","ordinal":133650,"en":"They never went idle without drinking blood."},{"id":"semetey-1-2013:p0748:b003:l027","ordinal":133651,"en":"Unless thoroughly sated with blood,"},{"id":"semetey-1-2013:p0748:b003:l028","ordinal":133652,"en":"They would not go back into their sheaths."},{"id":"semetey-1-2013:p0748:b003:l029","ordinal":133653,"en":"When hardship beset the heroes,"},{"id":"semetey-1-2013:p0748:b003:l030","ordinal":133654,"en":"When an enemy came against them,"},{"id":"semetey-1-2013:p0748:b003:l031","ordinal":133655,"en":"Valiant Manas and the six lions,"},{"id":"semetey-1-2013:p0748:b003:l032","ordinal":133656,"en":"The heroes drew them from their sheaths."},{"id":"semetey-1-2013:p0748:b003:l033","ordinal":133657,"en":"With every swing they lengthened."},{"id":"semetey-1-2013:p0748:b003:l034","ordinal":133658,"en":"When all those noble men had died,"},{"id":"semetey-1-2013:p0748:b003:l035","ordinal":133659,"en":"The six blades were left as spoils,"},{"id":"semetey-1-2013:p0748:b003:l036","ordinal":133660,"en":"In the hands of the six scoundrels."},{"id":"semetey-1-2013:p0748:b003:l037","ordinal":133661,"en":"Elder Bakai, remember:"},{"id":"semetey-1-2013:p0748:b003:l038","ordinal":133662,"en":"Akkelte, left by leopard Manas,"},{"id":"semetey-1-2013:p0748:b003:l039","ordinal":133663,"en":"In play, an ochogor gun,"},{"id":"semetey-1-2013:p0748:b004:l001","ordinal":133664,"en":"When fired in earnest, a koichagyr gun."},{"id":"semetey-1-2013:p0748:b004:l002","ordinal":133665,"en":"When slung on his back, the noble thing"},{"id":"semetey-1-2013:p0748:b004:l003","ordinal":133666,"en":"Was a mirror for his shoulder blades."},{"id":"semetey-1-2013:p0748:b004:l004","ordinal":133667,"en":"When aimed at an enemy in battle,"},{"id":"semetey-1-2013:p0748:b004:l005","ordinal":133668,"en":"It was solace for his mortal soul."},{"id":"semetey-1-2013:p0748:b004:l006","ordinal":133669,"en":"Almabash, of surpassingly keen iron,"},{"id":"semetey-1-2013:p0748:b004:l007","ordinal":133670,"en":"Made no distinction between far and near."},{"id":"semetey-1-2013:p0748:b004:l008","ordinal":133671,"en":"It would not fail for sixty days."},{"id":"semetey-1-2013:p0748:b004:l009","ordinal":133672,"en":"Akkelte, the living gun,"},{"id":"semetey-1-2013:p0748:b004:l010","ordinal":133673,"en":"That blessed thing has become booty."},{"id":"semetey-1-2013:p0748:b004:l011","ordinal":133674,"en":"It is in Kobosh's hands."},{"id":"semetey-1-2013:p0748:b004:l012","ordinal":133675,"en":"Ask for it and take it away."},{"id":"semetey-1-2013:p0748:b004:l013","ordinal":133676,"en":"Elder Bakai, hear my words."},{"id":"semetey-1-2013:p0748:b004:l014","ordinal":133677,"en":"The forty warriors left by Manas"},{"id":"semetey-1-2013:p0748:b004:l015","ordinal":133678,"en":"Were forty dogs from forty places."},{"id":"semetey-1-2013:p0748:b004:l016","ordinal":133679,"en":"Since old Kyrgyl became their chief,"},{"id":"semetey-1-2013:p0748:b004:l017","ordinal":133680,"en":"What were they but dogs?"},{"id":"semetey-1-2013:p0748:b004:l018","ordinal":133681,"en":"Full of liquor, running wild—"},{"id":"semetey-1-2013:p0748:b004:l019","ordinal":133682,"en":"Elder Bakai, take thought,"},{"id":"semetey-1-2013:p0748:b004:l020","ordinal":133683,"en":"Lest they rush to attack."},{"id":"semetey-1-2013:p0748:b004:l021","ordinal":133684,"en":"That warrior Tazbaimat"},{"id":"semetey-1-2013:p0748:b004:l022","ordinal":133685,"en":"Was an exceptionally cunning bald man."},{"id":"semetey-1-2013:p0748:b004:l023","ordinal":133686,"en":"He had little skill as an envoy;"},{"id":"semetey-1-2013:p0748:b004:l024","ordinal":133687,"en":"He was Kanykei's enemy."},{"id":"semetey-1-2013:p0748:b004:l025","ordinal":133688,"en":"Abyke, Kobosh, the six scoundrels,"},{"id":"semetey-1-2013:p0748:b004:l026","ordinal":133689,"en":"Were puffed up, drunk on wealth."},{"id":"semetey-1-2013:p0748:b004:l027","ordinal":133690,"en":"Men had died and blood was shed;"},{"id":"semetey-1-2013:p0748:b004:l028","ordinal":133691,"en":"Elder, they were your enemies."},{"id":"semetey-1-2013:p0748:b004:l029","ordinal":133692,"en":"The scoundrels Abyke and Kobosh—"},{"id":"semetey-1-2013:p0748:b004:l031","ordinal":133693,"en":"Their deeds bring no joy to the soul.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0748:b004:l032","ordinal":133694,"en":"Valiant elder, hear my words."},{"id":"semetey-1-2013:p0748:b004:l033","ordinal":133695,"en":"I shall fashion a speech,"},{"id":"semetey-1-2013:p0748:b004:l034","ordinal":133696,"en":"And those dogs full of millet beer"},{"id":"semetey-1-2013:p0748:b004:l035","ordinal":133697,"en":"I shall send along the wrong road."},{"id":"semetey-1-2013:p0748:b004:l036","ordinal":133698,"en":"I shall go in cautiously,"},{"id":"semetey-1-2013:p0748:b004:l037","ordinal":133699,"en":"And those dogs full of liquor"},{"id":"semetey-1-2013:p0748:b004:l038","ordinal":133700,"en":"I shall send along a distant road."},{"id":"semetey-1-2013:p0748:b004:l039","ordinal":133701,"en":"For the orphan left by the magnanimous one,"},{"id":"semetey-1-2013:p0749:b003:l001","ordinal":133702,"en":"I shall clear his land.\""},{"id":"semetey-1-2013:p0749:b003:l002","ordinal":133703,"en":"Khan Bakai remained on watch."},{"id":"semetey-1-2013:p0749:b003:l003","ordinal":133704,"en":"Shuutu the servant went back."},{"id":"semetey-1-2013:p0749:b003:l004","ordinal":133705,"en":"Having seen so many lands,"},{"id":"semetey-1-2013:p0749:b003:l005","ordinal":133706,"en":"Experienced Shuutu went along."},{"id":"semetey-1-2013:p0749:b003:l006","ordinal":133707,"en":"With mature wisdom and a broad mind,"},{"id":"semetey-1-2013:p0749:b003:l007","ordinal":133708,"en":"Resourceful Shuutu went along."},{"id":"semetey-1-2013:p0749:b003:l008","ordinal":133709,"en":"When Khan Manas lived,"},{"id":"semetey-1-2013:p0749:b003:l009","ordinal":133710,"en":"He had often traveled as an envoy."},{"id":"semetey-1-2013:p0749:b003:l010","ordinal":133711,"en":"Experienced Shuutu went along."},{"id":"semetey-1-2013:p0749:b003:l011","ordinal":133712,"en":"Do not ask about Shuutu:"},{"id":"semetey-1-2013:p0749:b003:l012","ordinal":133713,"en":"When lion Manas lived,"},{"id":"semetey-1-2013:p0749:b003:l013","ordinal":133714,"en":"He had him ride a swift camel,"},{"id":"semetey-1-2013:p0749:b003:l014","ordinal":133715,"en":"Sent him roaming the face of the earth,"},{"id":"semetey-1-2013:p0749:b003:l015","ordinal":133716,"en":"Had him learn of everything."},{"id":"semetey-1-2013:p0749:b003:l016","ordinal":133717,"en":"Taking six swift horses,"},{"id":"semetey-1-2013:p0749:b003:l017","ordinal":133718,"en":"What could lion Shuutu do?"},{"id":"semetey-1-2013:p0749:b003:l018","ordinal":133719,"en":"Making a letter the size of a palm,"},{"id":"semetey-1-2013:p0749:b003:l019","ordinal":133720,"en":"He had roamed the earth."},{"id":"semetey-1-2013:p0749:b003:l020","ordinal":133721,"en":"From every scholar he had received a letter."},{"id":"semetey-1-2013:p0749:b003:l021","ordinal":133722,"en":"He was called lion Shuutu."},{"id":"semetey-1-2013:p0749:b003:l022","ordinal":133723,"en":"Deep in wisdom, greatly eloquent,"},{"id":"semetey-1-2013:p0749:b003:l023","ordinal":133724,"en":"Hero Shuutu never wavered."},{"id":"semetey-1-2013:p0749:b003:l024","ordinal":133725,"en":"He honed his dark tongue,"},{"id":"semetey-1-2013:p0749:b003:l025","ordinal":133726,"en":"Spoke eloquently before the people."},{"id":"semetey-1-2013:p0749:b003:l026","ordinal":133727,"en":"Swift in speech, with a nimble tongue,"},{"id":"semetey-1-2013:p0749:b003:l027","ordinal":133728,"en":"He was the hero who could find an argument."},{"id":"semetey-1-2013:p0749:b003:l028","ordinal":133729,"en":"For the forty warriors,"},{"id":"semetey-1-2013:p0749:b003:l029","ordinal":133730,"en":"Now he would put on a spectacle."},{"id":"semetey-1-2013:p0749:b003:l030","ordinal":133731,"en":"To Khan Kobosh's court,"},{"id":"semetey-1-2013:p0749:b003:l031","ordinal":133732,"en":"To Abyke's wide valley,"},{"id":"semetey-1-2013:p0749:b003:l032","ordinal":133733,"en":"To the place where they held council,"},{"id":"semetey-1-2013:p0749:b003:l033","ordinal":133734,"en":"Roaring in anger,"},{"id":"semetey-1-2013:p0749:b003:l034","ordinal":133735,"en":"Calling out, \"Forty warriors!\""},{"id":"semetey-1-2013:p0749:b003:l035","ordinal":133736,"en":"Shuutu the servant made a scene."},{"id":"semetey-1-2013:p0749:b003:l036","ordinal":133737,"en":"For the elders led by Kyrgyl,"},{"id":"semetey-1-2013:p0749:b003:l037","ordinal":133738,"en":"As though slaughter had struck,"},{"id":"semetey-1-2013:p0749:b003:l038","ordinal":133739,"en":"He made a spectacle for them all."},{"id":"semetey-1-2013:p0749:b003:l039","ordinal":133740,"en":"These were Shuutu's words;"},{"id":"semetey-1-2013:p0749:b004:l001","ordinal":133741,"en":"Here was the uproar he unleashed:"},{"id":"semetey-1-2013:p0749:b004:l002","ordinal":133742,"en":"\"Collapse, instead of being forty warriors!"},{"id":"semetey-1-2013:p0749:b004:l003","ordinal":133743,"en":"You have no sentry posted on the ridge."},{"id":"semetey-1-2013:p0749:b004:l004","ordinal":133744,"en":"You are all ruined!"},{"id":"semetey-1-2013:p0749:b004:l005","ordinal":133745,"en":"Your father's grave, forty warriors!"},{"id":"semetey-1-2013:p0749:b004:l006","ordinal":133746,"en":"When precious Khan Manas died,"},{"id":"semetey-1-2013:p0749:b004:l007","ordinal":133747,"en":"When all died with Manas,"},{"id":"semetey-1-2013:p0749:b004:l008","ordinal":133748,"en":"You forty warriors were left."},{"id":"semetey-1-2013:p0749:b004:l009","ordinal":133749,"en":"After the lord passed away,"},{"id":"semetey-1-2013:p0749:b004:l010","ordinal":133750,"en":"You settled along the river."},{"id":"semetey-1-2013:p0749:b004:l011","ordinal":133751,"en":"After gray-maned Manas died,"},{"id":"semetey-1-2013:p0749:b004:l012","ordinal":133752,"en":"You became like an extinguished fire."},{"id":"semetey-1-2013:p0749:b004:l013","ordinal":133753,"en":"Your father's grave, forty warriors!"},{"id":"semetey-1-2013:p0749:b004:l014","ordinal":133754,"en":"Drink stones, not liquor!"},{"id":"semetey-1-2013:p0749:b004:l015","ordinal":133755,"en":"If that is too little, forty warriors,"},{"id":"semetey-1-2013:p0749:b004:l016","ordinal":133756,"en":"Drink your father's blood as well!"},{"id":"semetey-1-2013:p0749:b004:l017","ordinal":133757,"en":"You have no garden planted in Talas."},{"id":"semetey-1-2013:p0749:b004:l018","ordinal":133758,"en":"Your father's grave, forty warriors!"},{"id":"semetey-1-2013:p0749:b004:l019","ordinal":133759,"en":"This is no time to lie with legs spread."},{"id":"semetey-1-2013:p0749:b004:l020","ordinal":133760,"en":"You have no garden planted in the broad valley."},{"id":"semetey-1-2013:p0749:b004:l021","ordinal":133761,"en":"Your father's grave, forty pigs!"},{"id":"semetey-1-2013:p0749:b004:l022","ordinal":133762,"en":"This is no time to stretch out idly."},{"id":"semetey-1-2013:p0749:b004:l023","ordinal":133763,"en":"When whatever you wished for came,"},{"id":"semetey-1-2013:p0749:b004:l024","ordinal":133764,"en":"Is there a night like the Night of Power?"},{"id":"semetey-1-2013:p0749:b004:l025","ordinal":133765,"en":"Whole otter pelts"},{"id":"semetey-1-2013:p0749:b004:l026","ordinal":133766,"en":"You divided in halves"},{"id":"semetey-1-2013:p0749:b004:l027","ordinal":133767,"en":"And made into trouser legs—"},{"id":"semetey-1-2013:p0749:b004:l028","ordinal":133768,"en":"Are those former days still here?"},{"id":"semetey-1-2013:p0749:b004:l030","ordinal":133769,"en":"This is no time to sprawl about.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0749:b004:l031","ordinal":133770,"en":"You have lands you made desolate;"},{"id":"semetey-1-2013:p0749:b004:l032","ordinal":133771,"en":"Many peoples bear you a grudge."},{"id":"semetey-1-2013:p0749:b004:l033","ordinal":133772,"en":"The Six Cities, the khan of Kokand,"},{"id":"semetey-1-2013:p0749:b004:l034","ordinal":133773,"en":"Andijan and broad Bukhara,"},{"id":"semetey-1-2013:p0749:b004:l035","ordinal":133774,"en":"Farther away, Afghanistan and India—"},{"id":"semetey-1-2013:p0749:b004:l036","ordinal":133775,"en":"You have these enemies to fight."},{"id":"semetey-1-2013:p0749:b004:l037","ordinal":133776,"en":"On your right are the Russians;"},{"id":"semetey-1-2013:p0749:b004:l038","ordinal":133777,"en":"On the hills are the Chinese."},{"id":"semetey-1-2013:p0749:b004:l039","ordinal":133778,"en":"You have many enemies to clash with."},{"id":"semetey-1-2013:p0750:b003:l001","ordinal":133779,"en":"Kobosh and Abyke, who became khans—"},{"id":"semetey-1-2013:p0750:b003:l002","ordinal":133780,"en":"You have elders such as these,"},{"id":"semetey-1-2013:p0750:b003:l003","ordinal":133781,"en":"And every sort of enemy to fight."},{"id":"semetey-1-2013:p0750:b003:l004","ordinal":133782,"en":"Farther away there are also the Chinese."},{"id":"semetey-1-2013:p0750:b003:l005","ordinal":133783,"en":"His fame resounding among the people,"},{"id":"semetey-1-2013:p0750:b003:l006","ordinal":133784,"en":"There is their khan, Khan Kongurbai;"},{"id":"semetey-1-2013:p0750:b003:l007","ordinal":133785,"en":"You have another enemy to fight."},{"id":"semetey-1-2013:p0750:b003:l008","ordinal":133786,"en":"While you drink liquor, panting,"},{"id":"semetey-1-2013:p0750:b003:l009","ordinal":133787,"en":"And revel, unaware,"},{"id":"semetey-1-2013:p0750:b003:l010","ordinal":133788,"en":"There are those who will give you all a spectacle,"},{"id":"semetey-1-2013:p0750:b003:l011","ordinal":133789,"en":"Those who will slaughter you all without looking back."},{"id":"semetey-1-2013:p0750:b003:l012","ordinal":133790,"en":"If the countless Chinese swarm upon you,"},{"id":"semetey-1-2013:p0750:b003:l013","ordinal":133791,"en":"There is no forest to flee into."},{"id":"semetey-1-2013:p0750:b003:l014","ordinal":133792,"en":"To unleash an upheaval,"},{"id":"semetey-1-2013:p0750:b003:l015","ordinal":133793,"en":"To rescue you,"},{"id":"semetey-1-2013:p0750:b003:l016","ordinal":133794,"en":"Bloodthirsty Manas is not here."},{"id":"semetey-1-2013:p0750:b003:l017","ordinal":133795,"en":"Drink your shit, not mare's milk!"},{"id":"semetey-1-2013:p0750:b003:l018","ordinal":133796,"en":"Instead of drinking liquor, forty warriors,"},{"id":"semetey-1-2013:p0750:b003:l019","ordinal":133797,"en":"Drink your ancestor's blood."},{"id":"semetey-1-2013:p0750:b003:l020","ordinal":133798,"en":"When I kept watch and scouted the land,"},{"id":"semetey-1-2013:p0750:b003:l021","ordinal":133799,"en":"When I received alarming news,"},{"id":"semetey-1-2013:p0750:b003:l022","ordinal":133800,"en":"From Kara-Buura and Chatkal"},{"id":"semetey-1-2013:p0750:b003:l023","ordinal":133801,"en":"Dust rose in surging clouds."},{"id":"semetey-1-2013:p0750:b003:l024","ordinal":133802,"en":"When I looked at that surging dust,"},{"id":"semetey-1-2013:p0750:b003:l025","ordinal":133803,"en":"I, hero Shuutu, was scared to death."},{"id":"semetey-1-2013:p0750:b003:l026","ordinal":133804,"en":"The Black Chinese and countless Manchu,"},{"id":"semetey-1-2013:p0750:b003:l027","ordinal":133805,"en":"With Khan Kongurbai at their head,"},{"id":"semetey-1-2013:p0750:b003:l028","ordinal":133806,"en":"Seem to be swarming upon us."},{"id":"semetey-1-2013:p0750:b003:l029","ordinal":133807,"en":"When Manas died, all died."},{"id":"semetey-1-2013:p0750:b003:l030","ordinal":133808,"en":"Your father's grave, forty warriors!"},{"id":"semetey-1-2013:p0750:b003:l031","ordinal":133809,"en":"Your day of ruin has come!\""},{"id":"semetey-1-2013:p0750:b003:l032","ordinal":133810,"en":"As Shuutu spoke thus,"},{"id":"semetey-1-2013:p0750:b003:l033","ordinal":133811,"en":"Khan Manas's forty warriors,"},{"id":"semetey-1-2013:p0750:b003:l034","ordinal":133812,"en":"As though slaughter had struck,"},{"id":"semetey-1-2013:p0750:b003:l035","ordinal":133813,"en":"Rushed about in a spectacle,"},{"id":"semetey-1-2013:p0750:b003:l036","ordinal":133814,"en":"Trampling and tearing their hems,"},{"id":"semetey-1-2013:p0750:b003:l037","ordinal":133815,"en":"Running in a flurry,"},{"id":"semetey-1-2013:p0750:b003:l038","ordinal":133816,"en":"Blowing their trumpets."},{"id":"semetey-1-2013:p0750:b003:l039","ordinal":133817,"en":"The red one-humped camels left by Manas"},{"id":"semetey-1-2013:p0750:b004:l001","ordinal":133818,"en":"They loaded heavily with provisions."},{"id":"semetey-1-2013:p0750:b004:l002","ordinal":133819,"en":"They made ready their weapons,"},{"id":"semetey-1-2013:p0750:b004:l003","ordinal":133820,"en":"Strapped on their small cooking pots,"},{"id":"semetey-1-2013:p0750:b004:l004","ordinal":133821,"en":"Beat their drums,"},{"id":"semetey-1-2013:p0750:b004:l005","ordinal":133822,"en":"And toward Kara-Buura and Chatkal"},{"id":"semetey-1-2013:p0750:b004:l006","ordinal":133823,"en":"All rushed off together."},{"id":"semetey-1-2013:p0750:b004:l007","ordinal":133824,"en":"Among the forty warriors,"},{"id":"semetey-1-2013:p0750:b004:l008","ordinal":133825,"en":"Adybai and Kolbai, two scoundrels,"},{"id":"semetey-1-2013:p0750:b004:l009","ordinal":133826,"en":"Chyibyt and Kochkor, making four scoundrels,"},{"id":"semetey-1-2013:p0750:b004:l010","ordinal":133827,"en":"Now went away with them."},{"id":"semetey-1-2013:p0750:b004:l011","ordinal":133828,"en":"Great Bakai saw them leave."},{"id":"semetey-1-2013:p0750:b004:l012","ordinal":133829,"en":"On that day Kokcholok"},{"id":"semetey-1-2013:p0750:b004:l013","ordinal":133830,"en":"Sped like an arrow in flight."},{"id":"semetey-1-2013:p0750:b004:l014","ordinal":133831,"en":"On that day Kokcholok—"},{"id":"semetey-1-2013:p0750:b004:l015","ordinal":133832,"en":"The black stones he passed over"},{"id":"semetey-1-2013:p0750:b004:l016","ordinal":133833,"en":"Crumbled like charcoal."},{"id":"semetey-1-2013:p0750:b004:l017","ordinal":133834,"en":"The wind could not match his trot;"},{"id":"semetey-1-2013:p0750:b004:l018","ordinal":133835,"en":"No beast could match his walk."},{"id":"semetey-1-2013:p0750:b004:l019","ordinal":133836,"en":"He thundered like a cloud."},{"id":"semetey-1-2013:p0750:b004:l020","ordinal":133837,"en":"When Kokcholok went along,"},{"id":"semetey-1-2013:p0750:b004:l021","ordinal":133838,"en":"The tips of the grass trembled."},{"id":"semetey-1-2013:p0750:b004:l022","ordinal":133839,"en":"When he ran with stretching strides,"},{"id":"semetey-1-2013:p0750:b004:l023","ordinal":133840,"en":"He looked like a wild mountain sheep."},{"id":"semetey-1-2013:p0750:b004:l024","ordinal":133841,"en":"\"Though an animal, he has a soul;"},{"id":"semetey-1-2013:p0750:b004:l025","ordinal":133842,"en":"He is making a wish,\" he thought."},{"id":"semetey-1-2013:p0750:b004:l026","ordinal":133843,"en":"Bakai, whom you have seen,"},{"id":"semetey-1-2013:p0750:b004:l027","ordinal":133844,"en":"Was deeply moved."},{"id":"semetey-1-2013:p0750:b004:l028","ordinal":133845,"en":"Eagerly heading toward his orphan,"},{"id":"semetey-1-2013:p0750:b004:l029","ordinal":133846,"en":"Bakai reached the boy."},{"id":"semetey-1-2013:p0750:b004:l030","ordinal":133847,"en":"He turned Kokcholok's head."},{"id":"semetey-1-2013:p0750:b004:l031","ordinal":133848,"en":"Old gray-maned Bakai"},{"id":"semetey-1-2013:p0750:b004:l032","ordinal":133849,"en":"Now spoke many words:"},{"id":"semetey-1-2013:p0750:b004:l033","ordinal":133850,"en":"\"The forty warriors left by your father,"},{"id":"semetey-1-2013:p0750:b004:l034","ordinal":133851,"en":"The elders with Kyrgyl at their head—"},{"id":"semetey-1-2013:p0750:b004:l035","ordinal":133852,"en":"Shuutu the servant made a scene"},{"id":"semetey-1-2013:p0750:b004:l036","ordinal":133853,"en":"And sent them all away."},{"id":"semetey-1-2013:p0750:b004:l037","ordinal":133854,"en":"At their court, I reckon,"},{"id":"semetey-1-2013:p0750:b004:l038","ordinal":133855,"en":"The heroes Abyke and Kobosh remain."},{"id":"semetey-1-2013:p0750:b004:l039","ordinal":133856,"en":"Let us go straight in and speak,"},{"id":"semetey-1-2013:p0751:b003:l001","ordinal":133857,"en":"My darling orphan,"},{"id":"semetey-1-2013:p0751:b003:l002","ordinal":133858,"en":"And pour out our grievances."},{"id":"semetey-1-2013:p0751:b003:l003","ordinal":133859,"en":"The abundant wealth left by your father Manas—"},{"id":"semetey-1-2013:p0751:b003:l004","ordinal":133860,"en":"Let us ask them to give us a gift."},{"id":"semetey-1-2013:p0751:b003:l006","ordinal":133861,"en":"Heed these words of mine.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0751:b003:l007","ordinal":133862,"en":"If those fools would cease to be fools,"},{"id":"semetey-1-2013:p0751:b003:l008","ordinal":133863,"en":"Their thoughts would not be alien to ours."},{"id":"semetey-1-2013:p0751:b003:l009","ordinal":133864,"en":"They share a father with your father;"},{"id":"semetey-1-2013:p0751:b003:l010","ordinal":133865,"en":"These dogs are the younger wife's sons."},{"id":"semetey-1-2013:p0751:b003:l011","ordinal":133866,"en":"The most wicked of the six,"},{"id":"semetey-1-2013:p0751:b003:l012","ordinal":133867,"en":"Ignorant, wretched Kobosh—"},{"id":"semetey-1-2013:p0751:b003:l013","ordinal":133868,"en":"Consider your uncle Kobosh,"},{"id":"semetey-1-2013:p0751:b003:l014","ordinal":133869,"en":"That coarse, unruly wretch."},{"id":"semetey-1-2013:p0751:b003:l015","ordinal":133870,"en":"Think, orphan, and heed my words."},{"id":"semetey-1-2013:p0751:b003:l016","ordinal":133871,"en":"Know this service I do for you.\""},{"id":"semetey-1-2013:p0751:b003:l017","ordinal":133872,"en":"So spoke great Bakai,"},{"id":"semetey-1-2013:p0751:b003:l018","ordinal":133873,"en":"With Semetey following him."},{"id":"semetey-1-2013:p0751:b003:l019","ordinal":133874,"en":"Eagerly setting out on the road,"},{"id":"semetey-1-2013:p0751:b003:l020","ordinal":133875,"en":"To Abyke and Kobosh"},{"id":"semetey-1-2013:p0751:b003:l021","ordinal":133876,"en":"To go and greet them,"},{"id":"semetey-1-2013:p0751:b003:l022","ordinal":133877,"en":"The poor orphan grew excited,"},{"id":"semetey-1-2013:p0751:b003:l023","ordinal":133878,"en":"And kept questioning Bakai."},{"id":"semetey-1-2013:p0751:b003:l024","ordinal":133879,"en":"As the boy asked,"},{"id":"semetey-1-2013:p0751:b003:l025","ordinal":133880,"en":"Poor Bakai spoke thus:"},{"id":"semetey-1-2013:p0751:b003:l026","ordinal":133881,"en":"\"My orphan son, come this way."},{"id":"semetey-1-2013:p0751:b003:l027","ordinal":133882,"en":"When hero Manas died,"},{"id":"semetey-1-2013:p0751:b003:l028","ordinal":133883,"en":"When the people gathered and buried him,"},{"id":"semetey-1-2013:p0751:b003:l029","ordinal":133884,"en":"When misfortune and hardship came,"},{"id":"semetey-1-2013:p0751:b003:l030","ordinal":133885,"en":"The Argyn and the Kyrgyz—"},{"id":"semetey-1-2013:p0751:b003:l031","ordinal":133886,"en":"Abyke, Kobosh, the six scoundrels,"},{"id":"semetey-1-2013:p0751:b003:l032","ordinal":133887,"en":"Gathered them all together."},{"id":"semetey-1-2013:p0751:b003:l034","ordinal":133888,"en":"'Give nine unbred yearlings,' they said,","gapBefore":"[Source wording unresolved; translation pending]"}]
