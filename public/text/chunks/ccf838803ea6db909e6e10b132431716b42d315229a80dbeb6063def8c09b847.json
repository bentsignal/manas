[{"id":"manas-2010:p1122:b001:l035","ordinal":48897,"en":"Breasts the white vultures would eat;"},{"id":"manas-2010:p1122:b001:l036","ordinal":48898,"en":"The carrion birds would gorge upon her flesh,"},{"id":"manas-2010:p1122:b001:l037","ordinal":48899,"en":"Would gouge out her two eyes."},{"id":"manas-2010:p1122:b001:l038","ordinal":48900,"en":"Her gleaming teeth, like shovels,"},{"id":"manas-2010:p1122:b001:l039","ordinal":48901,"en":"Would become crow shit, I thought."},{"id":"manas-2010:p1122:b001:l040","ordinal":48902,"en":"My dear, precious mother"},{"id":"manas-2010:p1122:b001:l041","ordinal":48903,"en":"Would remain unburied in the desert, I thought."},{"id":"manas-2010:p1122:b001:l042","ordinal":48904,"en":"I stooped, lifted and folded her at the waist."},{"id":"manas-2010:p1123:b001:l001","ordinal":48905,"en":"I loaded her onto the bay mare."},{"id":"manas-2010:p1123:b001:l002","ordinal":48906,"en":"The place where battle had been fought"},{"id":"manas-2010:p1123:b001:l003","ordinal":48907,"en":"Was filled with Solon Chinese."},{"id":"manas-2010:p1123:b001:l004","ordinal":48908,"en":"The forty vigorous warriors,"},{"id":"manas-2010:p1123:b001:l005","ordinal":48909,"en":"All forty had been struck by bullets,"},{"id":"manas-2010:p1123:b001:l006","ordinal":48910,"en":"Had become martyrs in forty places."},{"id":"manas-2010:p1123:b001:l007","ordinal":48911,"en":"Hardship descended upon my head."},{"id":"manas-2010:p1123:b001:l008","ordinal":48912,"en":"Alongside my mother,"},{"id":"manas-2010:p1123:b001:l009","ordinal":48913,"en":"I loaded the forty warriors too."},{"id":"manas-2010:p1123:b001:l010","ordinal":48914,"en":"Defeated—a name of shame!"},{"id":"manas-2010:p1123:b001:l011","ordinal":48915,"en":"Into the forest of Kök-Bulung,"},{"id":"manas-2010:p1123:b001:l012","ordinal":48916,"en":"The forty warriors and my mother"},{"id":"manas-2010:p1123:b001:l013","ordinal":48917,"en":"I laid in the forest for safekeeping."},{"id":"manas-2010:p1123:b001:l014","ordinal":48918,"en":"'If I have the strength, the Burut"},{"id":"manas-2010:p1123:b001:l015","ordinal":48919,"en":"I shall gather, every one."},{"id":"manas-2010:p1123:b001:l016","ordinal":48920,"en":"Upon Beijing with its forty gates,"},{"id":"manas-2010:p1123:b001:l017","ordinal":48921,"en":"If I live, I shall bring slaughter."},{"id":"manas-2010:p1123:b001:l018","ordinal":48922,"en":"From where I have left them in trust,"},{"id":"manas-2010:p1123:b001:l019","ordinal":48923,"en":"The warriors and my mother"},{"id":"manas-2010:p1123:b001:l020","ordinal":48924,"en":"I shall load and take back again.'"},{"id":"manas-2010:p1123:b001:l021","ordinal":48925,"en":"While I slaughtered the bay mare,"},{"id":"manas-2010:p1123:b001:l022","ordinal":48926,"en":"While I widened forty-one graves"},{"id":"manas-2010:p1123:b001:l023","ordinal":48927,"en":"And dug them all,"},{"id":"manas-2010:p1123:b001:l024","ordinal":48928,"en":"The countless Chinese learned the news."},{"id":"manas-2010:p1123:b001:l025","ordinal":48929,"en":"Pouring out of Inner Beijing,"},{"id":"manas-2010:p1123:b001:l026","ordinal":48930,"en":"They came sweeping toward me."},{"id":"manas-2010:p1123:b001:l027","ordinal":48931,"en":"Karykan, the khan of Beijing,"},{"id":"manas-2010:p1123:b001:l028","ordinal":48932,"en":"Gave an order to his people:"},{"id":"manas-2010:p1123:b001:l029","ordinal":48933,"en":"'Two bricks for each man—"},{"id":"manas-2010:p1123:b001:l030","ordinal":48934,"en":"Take them!' he commanded."},{"id":"manas-2010:p1123:b001:l031","ordinal":48935,"en":"With one side facing Beijing,"},{"id":"manas-2010:p1123:b001:l032","ordinal":48936,"en":"Fortifying the other side,"},{"id":"manas-2010:p1123:b001:l033","ordinal":48937,"en":"Making Tash-Köpürö a stronghold,"},{"id":"manas-2010:p1123:b001:l034","ordinal":48938,"en":"The bricks they had baked"},{"id":"manas-2010:p1123:b001:l035","ordinal":48939,"en":"They laid in rows, two abreast."},{"id":"manas-2010:p1123:b001:l036","ordinal":48940,"en":"Bringing earth in their robe hems,"},{"id":"manas-2010:p1123:b001:l037","ordinal":48941,"en":"They put it into the hollows."},{"id":"manas-2010:p1123:b001:l038","ordinal":48942,"en":"When dawn broke clear,"},{"id":"manas-2010:p1123:b001:l039","ordinal":48943,"en":"When light fell upon the earth,"},{"id":"manas-2010:p1123:b001:l040","ordinal":48944,"en":"When I thought to leave,"},{"id":"manas-2010:p1123:b001:l041","ordinal":48945,"en":"They had dug my deep pit."},{"id":"manas-2010:p1123:b001:l042","ordinal":48946,"en":"By their vast numbers, the countless Chinese"},{"id":"manas-2010:p1124:b001:l001","ordinal":48947,"en":"Had boiled my misery."},{"id":"manas-2010:p1124:b001:l002","ordinal":48948,"en":"Preparing throughout the night,"},{"id":"manas-2010:p1124:b001:l003","ordinal":48949,"en":"They had blocked my road."},{"id":"manas-2010:p1124:b001:l004","ordinal":48950,"en":"When I tried to depart,"},{"id":"manas-2010:p1124:b001:l005","ordinal":48951,"en":"There was a wall with a hollow forty cubits deep."},{"id":"manas-2010:p1124:b001:l006","ordinal":48952,"en":"I was about to die in anguish,"},{"id":"manas-2010:p1124:b001:l007","ordinal":48953,"en":"Completely despairing of life."},{"id":"manas-2010:p1124:b001:l008","ordinal":48954,"en":"Gathering courage, I shouted."},{"id":"manas-2010:p1124:b001:l009","ordinal":48955,"en":"To have support at my side,"},{"id":"manas-2010:p1124:b001:l010","ordinal":48956,"en":"I called hero Mazhik."},{"id":"manas-2010:p1124:b001:l011","ordinal":48957,"en":"'The evil fallen upon our heads—"},{"id":"manas-2010:p1124:b001:l012","ordinal":48958,"en":"Have we encountered it here?"},{"id":"manas-2010:p1124:b001:l013","ordinal":48959,"en":"Before our appointed deaths, have we two"},{"id":"manas-2010:p1124:b001:l014","ordinal":48960,"en":"Died within this forest?"},{"id":"manas-2010:p1124:b001:l015","ordinal":48961,"en":"Rather than, among Black Chinese and Manchus,"},{"id":"manas-2010:p1124:b001:l016","ordinal":48962,"en":"Remain imprisoned,"},{"id":"manas-2010:p1124:b001:l017","ordinal":48963,"en":"By Chinese who do not know our tongue,"},{"id":"manas-2010:p1124:b001:l018","ordinal":48964,"en":"Rather than remain driven along,"},{"id":"manas-2010:p1124:b001:l019","ordinal":48965,"en":"Give me the lead rope, Mazhik!'"},{"id":"manas-2010:p1124:b001:l020","ordinal":48966,"en":"I took the lead rope in my hand,"},{"id":"manas-2010:p1124:b001:l021","ordinal":48967,"en":"I brought it against my breast."},{"id":"manas-2010:p1124:b001:l022","ordinal":48968,"en":"'Hold yourself firm, Mazhik."},{"id":"manas-2010:p1124:b001:l023","ordinal":48969,"en":"Close your two eyes."},{"id":"manas-2010:p1124:b001:l024","ordinal":48970,"en":"Come, let us go from here."},{"id":"manas-2010:p1124:b001:l025","ordinal":48971,"en":"Against that high wall,"},{"id":"manas-2010:p1124:b001:l026","ordinal":48972,"en":"Let us advance and strike!'"},{"id":"manas-2010:p1124:b001:l027","ordinal":48973,"en":"After saying this,"},{"id":"manas-2010:p1124:b001:l028","ordinal":48974,"en":"I struck Sarala on the flank."},{"id":"manas-2010:p1124:b001:l029","ordinal":48975,"en":"Heading toward the wall,"},{"id":"manas-2010:p1124:b001:l030","ordinal":48976,"en":"Hero Mazhik was the one I dragged;"},{"id":"manas-2010:p1124:b001:l031","ordinal":48977,"en":"I went along dragging him."},{"id":"manas-2010:p1124:b001:l032","ordinal":48978,"en":"When we drew near the wall,"},{"id":"manas-2010:p1124:b001:l033","ordinal":48979,"en":"In this world, my steed was dear;"},{"id":"manas-2010:p1124:b001:l034","ordinal":48980,"en":"The life within my breast was dear."},{"id":"manas-2010:p1124:b001:l035","ordinal":48981,"en":"Despairing of my only life,"},{"id":"manas-2010:p1124:b001:l036","ordinal":48982,"en":"I closed my two eyes."},{"id":"manas-2010:p1124:b001:l037","ordinal":48983,"en":"Sarala, my dear swift horse,"},{"id":"manas-2010:p1124:b001:l038","ordinal":48984,"en":"Bounded far away."},{"id":"manas-2010:p1124:b001:l039","ordinal":48985,"en":"After we passed over the wall,"},{"id":"manas-2010:p1124:b001:l040","ordinal":48986,"en":"Let me tell you the truth:"},{"id":"manas-2010:p1124:b001:l041","ordinal":48987,"en":"Leopard Manas, my gray-maned hero,"},{"id":"manas-2010:p1124:b001:l042","ordinal":48988,"en":"I rejoiced indeed!"},{"id":"manas-2010:p1125:b001:l001","ordinal":48989,"en":"The high wall became low."},{"id":"manas-2010:p1125:b001:l002","ordinal":48990,"en":"Even now I marvel,"},{"id":"manas-2010:p1125:b001:l003","ordinal":48991,"en":"Thinking, 'An angel supported us.'"},{"id":"manas-2010:p1125:b001:l004","ordinal":48992,"en":"I truly think so."},{"id":"manas-2010:p1125:b001:l005","ordinal":48993,"en":"When I thought Sarala would fall,"},{"id":"manas-2010:p1125:b001:l006","ordinal":48994,"en":"He landed upright on all four feet."},{"id":"manas-2010:p1125:b001:l007","ordinal":48995,"en":"When he leaped down from the wall,"},{"id":"manas-2010:p1125:b001:l008","ordinal":48996,"en":"'Now my death has come,' I thought."},{"id":"manas-2010:p1125:b001:l009","ordinal":48997,"en":"'Sarala beneath me—"},{"id":"manas-2010:p1125:b001:l010","ordinal":48998,"en":"His legs have been shattered,' I thought."},{"id":"manas-2010:p1125:b001:l011","ordinal":48999,"en":"When I tugged at his mouth,"},{"id":"manas-2010:p1125:b001:l012","ordinal":49000,"en":"He pranced along beneath me."},{"id":"manas-2010:p1125:b001:l013","ordinal":49001,"en":"Sarala, the wondrous steed, was safe."},{"id":"manas-2010:p1125:b001:l014","ordinal":49002,"en":"Swaying whenever I moved,"},{"id":"manas-2010:p1125:b001:l015","ordinal":49003,"en":"I, upon his back, was safe."},{"id":"manas-2010:p1125:b001:l016","ordinal":49004,"en":"'Having struck the wall with force,"},{"id":"manas-2010:p1125:b001:l017","ordinal":49005,"en":"When will Kögala come?' I thought."},{"id":"manas-2010:p1125:b001:l018","ordinal":49006,"en":"'Were his mouth and neck torn out?"},{"id":"manas-2010:p1125:b001:l019","ordinal":49007,"en":"Has he perhaps been left behind,"},{"id":"manas-2010:p1125:b001:l020","ordinal":49008,"en":"A limb torn off?'"},{"id":"manas-2010:p1125:b001:l021","ordinal":49009,"en":"When I turned back and looked,"},{"id":"manas-2010:p1125:b001:l022","ordinal":49010,"en":"Kögala and Mazhik were safe as well!"},{"id":"manas-2010:p1125:b001:l023","ordinal":49011,"en":"From Beijing that heroes could not assail,"},{"id":"manas-2010:p1125:b001:l024","ordinal":49012,"en":"I fled, my strength insufficient."},{"id":"manas-2010:p1125:b001:l025","ordinal":49013,"en":"Along saddle-backed glaciers,"},{"id":"manas-2010:p1125:b001:l026","ordinal":49014,"en":"I escaped by fleeing beside them."},{"id":"manas-2010:p1125:b001:l027","ordinal":49015,"en":"Mazhik, who was beside me,"},{"id":"manas-2010:p1125:b001:l028","ordinal":49016,"en":"I took with me and escaped."},{"id":"manas-2010:p1125:b001:l029","ordinal":49017,"en":"Cloudy by day, clear by night,"},{"id":"manas-2010:p1125:b001:l030","ordinal":49018,"en":"I disturbed the weather with whirlwinds,"},{"id":"manas-2010:p1125:b001:l031","ordinal":49019,"en":"Made hail fall on the foothills,"},{"id":"manas-2010:p1125:b001:l032","ordinal":49020,"en":"Made sleet-bearing wind blow in the lowlands,"},{"id":"manas-2010:p1125:b001:l033","ordinal":49021,"en":"And all the level country"},{"id":"manas-2010:p1125:b001:l034","ordinal":49022,"en":"I covered in low-lying mist."},{"id":"manas-2010:p1125:b001:l035","ordinal":49023,"en":"Working weather magic, I escaped."},{"id":"manas-2010:p1125:b001:l036","ordinal":49024,"en":"How did I spare the Chinese?"},{"id":"manas-2010:p1125:b001:l037","ordinal":49025,"en":"Traveling for twelve days,"},{"id":"manas-2010:p1125:b001:l038","ordinal":49026,"en":"This very Tal-Choku"},{"id":"manas-2010:p1125:b001:l039","ordinal":49027,"en":"I barely reached then."},{"id":"manas-2010:p1125:b001:l040","ordinal":49028,"en":"From where it was running wild,"},{"id":"manas-2010:p1125:b001:l041","ordinal":49029,"en":"A wild, pale mare,"},{"id":"manas-2010:p1125:b001:l042","ordinal":49030,"en":"I caught and slaughtered."},{"id":"manas-2010:p1126:b001:l001","ordinal":49031,"en":"On rib fat and thick intestine,"},{"id":"manas-2010:p1126:b001:l002","ordinal":49032,"en":"I feasted like a hungry wolf."},{"id":"manas-2010:p1126:b001:l003","ordinal":49033,"en":"My father's robe of half-khan rank,"},{"id":"manas-2010:p1126:b001:l004","ordinal":49034,"en":"At the foot of a green cotoneaster,"},{"id":"manas-2010:p1126:b001:l005","ordinal":49035,"en":"I left for safekeeping."},{"id":"manas-2010:p1126:b001:l006","ordinal":49036,"en":"'If my mortal life remains,"},{"id":"manas-2010:p1126:b001:l007","ordinal":49037,"en":"When I return to Beijing,"},{"id":"manas-2010:p1126:b001:l008","ordinal":49038,"en":"I shall put on Chinese clothing."},{"id":"manas-2010:p1126:b001:l009","ordinal":49039,"en":"Wearing the rank stone in Chinese fashion,"},{"id":"manas-2010:p1126:b001:l010","ordinal":49040,"en":"I too shall attack Beijing,' I thought."},{"id":"manas-2010:p1126:b001:l011","ordinal":49041,"en":"Scatter its earth and look,"},{"id":"manas-2010:p1126:b001:l012","ordinal":49042,"en":"My dear Syrgak."},{"id":"manas-2010:p1126:b001:l013","ordinal":49043,"en":"Do not keep talking, my light;"},{"id":"manas-2010:p1126:b001:l014","ordinal":49044,"en":"Open that little mound and look!'"},{"id":"manas-2010:p1126:b001:l015","ordinal":49045,"en":"Almambet, Azizkan's son,"},{"id":"manas-2010:p1126:b001:l016","ordinal":49046,"en":"Spoke these words."},{"id":"manas-2010:p1126:b001:l017","ordinal":49047,"en":"With the red-tufted polished spear,"},{"id":"manas-2010:p1126:b001:l018","ordinal":49048,"en":"He struck one place with a thud"},{"id":"manas-2010:p1126:b001:l019","ordinal":49049,"en":"And stood looking."},{"id":"manas-2010:p1126:b001:l020","ordinal":49050,"en":"Then Syrgak thought this:"},{"id":"manas-2010:p1126:b001:l021","ordinal":49051,"en":"'How many days it has been,"},{"id":"manas-2010:p1126:b001:l022","ordinal":49052,"en":"Since your Alma left Beijing,"},{"id":"manas-2010:p1126:b001:l023","ordinal":49053,"en":"How many years it has been—"},{"id":"manas-2010:p1126:b001:l024","ordinal":49054,"en":"And it was night, not day."},{"id":"manas-2010:p1126:b001:l025","ordinal":49055,"en":"That ill-starred fugitive—"},{"id":"manas-2010:p1126:b001:l026","ordinal":49056,"en":"Look at the lies he tells!'"},{"id":"manas-2010:p1126:b001:l027","ordinal":49057,"en":"Thinking this, he opened it with his spear,"},{"id":"manas-2010:p1126:b001:l028","ordinal":49058,"en":"Scattering the earth."},{"id":"manas-2010:p1126:b001:l029","ordinal":49059,"en":"Before an eye could blink,"},{"id":"manas-2010:p1126:b001:l030","ordinal":49060,"en":"When he opened it and looked,"},{"id":"manas-2010:p1126:b001:l031","ordinal":49061,"en":"Without error, the buried thing"},{"id":"manas-2010:p1126:b001:l032","ordinal":49062,"en":"Almambet had struck directly above."},{"id":"manas-2010:p1126:b001:l033","ordinal":49063,"en":"Rolled up and sealed,"},{"id":"manas-2010:p1126:b001:l034","ordinal":49064,"en":"Enclosed in leather,"},{"id":"manas-2010:p1126:b001:l035","ordinal":49065,"en":"From his khan father Azizkan,"},{"id":"manas-2010:p1126:b001:l036","ordinal":49066,"en":"There remained the golden robe."},{"id":"manas-2010:p1126:b001:l037","ordinal":49067,"en":"When he unwrapped it and looked,"},{"id":"manas-2010:p1126:b001:l038","ordinal":49068,"en":"Gold and rubies"},{"id":"manas-2010:p1126:b001:l039","ordinal":49069,"en":"Had been set all across it,"},{"id":"manas-2010:p1126:b001:l040","ordinal":49070,"en":"Dazzling the beholder's eyes,"},{"id":"manas-2010:p1126:b001:l041","ordinal":49071,"en":"Satisfying the heart."},{"id":"manas-2010:p1126:b001:l042","ordinal":49072,"en":"When he saw this proof,"},{"id":"manas-2010:p1127:b001:l001","ordinal":49073,"en":"Gray-maned Manas rejoiced."},{"id":"manas-2010:p1127:b001:l002","ordinal":49074,"en":"'Such is the story of the robe."},{"id":"manas-2010:p1127:b001:l003","ordinal":49075,"en":"Let me leave it aside!"},{"id":"manas-2010:p1127:b001:l004","ordinal":49076,"en":"A tale of how I came to you—"},{"id":"manas-2010:p1127:b001:l005","ordinal":49077,"en":"Let me begin that now."},{"id":"manas-2010:p1127:b001:l006","ordinal":49078,"en":"Stifled by distress, finding no place,"},{"id":"manas-2010:p1127:b001:l007","ordinal":49079,"en":"My Burut, finding no hero like you,"},{"id":"manas-2010:p1127:b001:l008","ordinal":49080,"en":"Seeking a people, never resting,"},{"id":"manas-2010:p1127:b001:l009","ordinal":49081,"en":"I scoured the face of the earth."},{"id":"manas-2010:p1127:b001:l010","ordinal":49082,"en":"The great river down below,"},{"id":"manas-2010:p1127:b001:l011","ordinal":49083,"en":"I roamed all along it."},{"id":"manas-2010:p1127:b001:l012","ordinal":49084,"en":"To the broad plain below,"},{"id":"manas-2010:p1127:b001:l013","ordinal":49085,"en":"When I drew near,"},{"id":"manas-2010:p1127:b001:l014","ordinal":49086,"en":"There I saw nine people."},{"id":"manas-2010:p1127:b001:l015","ordinal":49087,"en":"A pitchfork was in his hand,"},{"id":"manas-2010:p1127:b001:l016","ordinal":49088,"en":"A rake was on his back."},{"id":"manas-2010:p1127:b001:l017","ordinal":49089,"en":"He had a bay mare with a foal."},{"id":"manas-2010:p1127:b001:l018","ordinal":49090,"en":"Draping himself in a yellow robe,"},{"id":"manas-2010:p1127:b001:l019","ordinal":49091,"en":"He sat sprawling upon it."},{"id":"manas-2010:p1127:b001:l020","ordinal":49092,"en":"Training his bay mare,"},{"id":"manas-2010:p1127:b001:l021","ordinal":49093,"en":"He made it drag a heap of hay."},{"id":"manas-2010:p1127:b001:l022","ordinal":49094,"en":"Looking, unable to make him out,"},{"id":"manas-2010:p1127:b001:l023","ordinal":49095,"en":"Unable to know who he was,"},{"id":"manas-2010:p1127:b001:l024","ordinal":49096,"en":"I approached and greeted him."},{"id":"manas-2010:p1127:b001:l025","ordinal":49097,"en":"When I greeted him, there was no reply."},{"id":"manas-2010:p1127:b001:l026","ordinal":49098,"en":"His face was yellow, his eyes blue;"},{"id":"manas-2010:p1127:b001:l027","ordinal":49099,"en":"His babbling words were many."},{"id":"manas-2010:p1127:b001:l028","ordinal":49100,"en":"When I said something,"},{"id":"manas-2010:p1127:b001:l029","ordinal":49101,"en":"He stared at me blankly."},{"id":"manas-2010:p1127:b001:l030","ordinal":49102,"en":"When he spoke his babble,"},{"id":"manas-2010:p1127:b001:l031","ordinal":49103,"en":"Unable to understand his words,"},{"id":"manas-2010:p1127:b001:l032","ordinal":49104,"en":"I in turn stared blankly."},{"id":"manas-2010:p1127:b001:l033","ordinal":49105,"en":"Astonished, not understanding his speech,"},{"id":"manas-2010:p1127:b001:l034","ordinal":49106,"en":"I stood staring in bewilderment."},{"id":"manas-2010:p1127:b001:l035","ordinal":49107,"en":"One old man of about eighty"},{"id":"manas-2010:p1127:b001:l036","ordinal":49108,"en":"Rose up, looming large,"},{"id":"manas-2010:p1127:b001:l037","ordinal":49109,"en":"And gazed toward the west."},{"id":"manas-2010:p1127:b001:l038","ordinal":49110,"en":"'They do not understand what is said—"},{"id":"manas-2010:p1127:b001:l039","ordinal":49111,"en":"Such a people they are,' I said and left."},{"id":"manas-2010:p1127:b001:l040","ordinal":49112,"en":"The nine in nine places,"},{"id":"manas-2010:p1127:b001:l041","ordinal":49113,"en":"I myself struck and laid them out."},{"id":"manas-2010:p1127:b001:l042","ordinal":49114,"en":"Seizing and slaughtering it,"},{"id":"manas-2010:p1128:b001:l001","ordinal":49115,"en":"I ate their bay mare and departed."},{"id":"manas-2010:p1128:b001:l002","ordinal":49116,"en":"Then I dashed onward,"},{"id":"manas-2010:p1128:b001:l003","ordinal":49117,"en":"Urging my horse across the plain."},{"id":"manas-2010:p1128:b001:l004","ordinal":49118,"en":"Hero Mazhik followed me."},{"id":"manas-2010:p1128:b001:l005","ordinal":49119,"en":"How did I hold back from the journey?"},{"id":"manas-2010:p1128:b001:l006","ordinal":49120,"en":"I reached Sary-Arka."},{"id":"manas-2010:p1128:b001:l007","ordinal":49121,"en":"Driving horses in lake-like herds,"},{"id":"manas-2010:p1128:b001:l008","ordinal":49122,"en":"Tethering a swift gray-piebald horse,"},{"id":"manas-2010:p1128:b001:l009","ordinal":49123,"en":"Husking his millet clean as stones,"},{"id":"manas-2010:p1128:b001:l010","ordinal":49124,"en":"Praising his wife like a maiden,"},{"id":"manas-2010:p1128:b001:l011","ordinal":49125,"en":"His first ancestor from Alach,"},{"id":"manas-2010:p1128:b001:l012","ordinal":49126,"en":"His yurt lattice made of wood—"},{"id":"manas-2010:p1128:b001:l013","ordinal":49127,"en":"Hero Kökchö, Aydarkan's son,"},{"id":"manas-2010:p1128:b001:l014","ordinal":49128,"en":"A loose-swaying, slow pacer,"},{"id":"manas-2010:p1128:b001:l015","ordinal":49129,"en":"Was a man rather like a pacing horse."},{"id":"manas-2010:p1128:b001:l016","ordinal":49130,"en":"Speaking of religious law,"},{"id":"manas-2010:p1128:b001:l017","ordinal":49131,"en":"He was a man rather like a cleric."},{"id":"manas-2010:p1128:b001:l018","ordinal":49132,"en":"I turned toward him."},{"id":"manas-2010:p1128:b001:l019","ordinal":49133,"en":"Kökchö, Aydarkan's son,"},{"id":"manas-2010:p1128:b001:l020","ordinal":49134,"en":"I deliberately put to the test."},{"id":"manas-2010:p1128:b001:l021","ordinal":49135,"en":"'If you will be my friend, hero Kökchö,"},{"id":"manas-2010:p1128:b001:l022","ordinal":49136,"en":"Prepare the oath you will speak."},{"id":"manas-2010:p1128:b001:l023","ordinal":49137,"en":"If you wish to exchange fire,"},{"id":"manas-2010:p1128:b001:l024","ordinal":49138,"en":"Make your marksmen ready.'"},{"id":"manas-2010:p1128:b001:l025","ordinal":49139,"en":"Hearing this, hero Kökchö said:"},{"id":"manas-2010:p1128:b001:l026","ordinal":49140,"en":"'Your long and short robes—"},{"id":"manas-2010:p1128:b001:l027","ordinal":49141,"en":"Let me be a dog if I put them on with you!"},{"id":"manas-2010:p1128:b001:l028","ordinal":49142,"en":"Grappling and seizing hold,"},{"id":"manas-2010:p1128:b001:l029","ordinal":49143,"en":"Let me be a dog if I attack you!'"},{"id":"manas-2010:p1128:b001:l030","ordinal":49144,"en":"When I heard Kökchö's words,"},{"id":"manas-2010:p1128:b001:l031","ordinal":49145,"en":"My spirit grew excited,"},{"id":"manas-2010:p1128:b001:l032","ordinal":49146,"en":"My whole body relaxed."},{"id":"manas-2010:p1128:b001:l033","ordinal":49147,"en":"With Aydarkan's Kökchö,"},{"id":"manas-2010:p1128:b001:l034","ordinal":49148,"en":"I became a friend once and for all."},{"id":"manas-2010:p1128:b001:l035","ordinal":49149,"en":"I submitted myself to sincerity."},{"id":"manas-2010:p1128:b001:l036","ordinal":49150,"en":"Not sparing my life for Kökchö,"},{"id":"manas-2010:p1128:b001:l037","ordinal":49151,"en":"I served him for six years!"},{"id":"manas-2010:p1128:b001:l038","ordinal":49152,"en":"While I stayed there,"}]
