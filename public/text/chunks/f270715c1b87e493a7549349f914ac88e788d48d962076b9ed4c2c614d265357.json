[{"id":"semetey-1-2013:p0827:b005:l031","ordinal":140289,"en":"When I scattered my wealth,"},{"id":"semetey-1-2013:p0827:b005:l032","ordinal":140290,"en":"When I fled Talas on foot,"},{"id":"semetey-1-2013:p0827:b005:l033","ordinal":140291,"en":"It was Aman-Jol itself—"},{"id":"semetey-1-2013:p0827:b005:l034","ordinal":140292,"en":"Indeed, its very black eye."},{"id":"semetey-1-2013:p0827:b005:l035","ordinal":140293,"en":"With their ears pricked up,"},{"id":"semetey-1-2013:p0827:b005:l036","ordinal":140294,"en":"Wolves do not travel this road."},{"id":"semetey-1-2013:p0827:b005:l037","ordinal":140295,"en":"With their tails trailing,"},{"id":"semetey-1-2013:p0827:b005:l038","ordinal":140296,"en":"Foxes do not travel this road."},{"id":"semetey-1-2013:p0827:b005:l039","ordinal":140297,"en":"No one is holding back,"},{"id":"semetey-1-2013:p0828:b003:l001","ordinal":140298,"en":"Where no cold-hearted man comes and goes,"},{"id":"semetey-1-2013:p0828:b003:l002","ordinal":140299,"en":"Whose way caravans do not know—"},{"id":"semetey-1-2013:p0828:b003:l003","ordinal":140300,"en":"This is the road called Aman-Jol."},{"id":"semetey-1-2013:p0828:b003:l004","ordinal":140301,"en":"There, taking shape in the haze,"},{"id":"semetey-1-2013:p0828:b003:l005","ordinal":140302,"en":"There, rising to a misty point,"},{"id":"semetey-1-2013:p0828:b003:l006","ordinal":140303,"en":"Swelling like a little bowl,"},{"id":"semetey-1-2013:p0828:b003:l007","ordinal":140304,"en":"Low fog falling apart along its edges,"},{"id":"semetey-1-2013:p0828:b003:l008","ordinal":140305,"en":"Dark smoke showing above it—"},{"id":"semetey-1-2013:p0828:b003:l009","ordinal":140306,"en":"That is the city called Khan Kokand."},{"id":"semetey-1-2013:p0828:b003:l010","ordinal":140307,"en":"A glittering tower"},{"id":"semetey-1-2013:p0828:b003:l011","ordinal":140308,"en":"The great city lying there,"},{"id":"semetey-1-2013:p0828:b003:l012","ordinal":140309,"en":"Rising to a point, is Samarkand."},{"id":"semetey-1-2013:p0828:b003:l013","ordinal":140310,"en":"There, its outline beyond the reach of sight—"},{"id":"semetey-1-2013:p0828:b003:l015","ordinal":140311,"en":"Listen, my only child—"},{"id":"semetey-1-2013:p0828:b003:l016","ordinal":140312,"en":"That is the city called Margalan."},{"id":"semetey-1-2013:p0828:b003:l017","ordinal":140313,"en":"Its name is heard, its shape unseen;"},{"id":"semetey-1-2013:p0828:b003:l018","ordinal":140314,"en":"My child, that is the road to Andijan."},{"id":"semetey-1-2013:p0828:b003:l019","ordinal":140315,"en":"Ruling Andijan"},{"id":"semetey-1-2013:p0828:b003:l020","ordinal":140316,"en":"Was fork-bearded Synchybek;"},{"id":"semetey-1-2013:p0828:b003:l021","ordinal":140317,"en":"In Alty-Shaar was Alabek."},{"id":"semetey-1-2013:p0828:b003:l022","ordinal":140318,"en":"Many tales were told of them;"},{"id":"semetey-1-2013:p0828:b003:l023","ordinal":140319,"en":"Their rulers were various beks."},{"id":"semetey-1-2013:p0828:b003:l024","ordinal":140320,"en":"Orphan, listen now!"},{"id":"semetey-1-2013:p0828:b003:l025","ordinal":140321,"en":"Malabek of Margalan,"},{"id":"semetey-1-2013:p0828:b003:l026","ordinal":140322,"en":"Sanchybek of Samarkand,"},{"id":"semetey-1-2013:p0828:b003:l027","ordinal":140323,"en":"Kozubek of Khan Kokand—"},{"id":"semetey-1-2013:p0828:b003:l028","ordinal":140324,"en":"Their thoroughbreds thundered."},{"id":"semetey-1-2013:p0828:b003:l029","ordinal":140325,"en":"The sacred city with its court,"},{"id":"semetey-1-2013:p0828:b003:l030","ordinal":140326,"en":"Great Kokand and Margalan—"},{"id":"semetey-1-2013:p0828:b003:l031","ordinal":140327,"en":"They themselves were blustering, bellowing men,"},{"id":"semetey-1-2013:p0828:b003:l032","ordinal":140328,"en":"Arrogant and contrary;"},{"id":"semetey-1-2013:p0828:b003:l033","ordinal":140329,"en":"Those people were like beasts."},{"id":"semetey-1-2013:p0828:b003:l034","ordinal":140330,"en":"They had round baked bread,"},{"id":"semetey-1-2013:p0828:b003:l035","ordinal":140331,"en":"And houses with four corners."},{"id":"semetey-1-2013:p0828:b003:l036","ordinal":140332,"en":"Spring came with moonless darkness;"},{"id":"semetey-1-2013:p0828:b003:l037","ordinal":140333,"en":"These shouting Sarts"},{"id":"semetey-1-2013:p0828:b003:l038","ordinal":140334,"en":"Were rather hostile to your father Manas."},{"id":"semetey-1-2013:p0828:b003:l039","ordinal":140335,"en":"The reason they became enemies:"},{"id":"semetey-1-2013:p0828:b004:l001","ordinal":140336,"en":"When your father came from Altai"},{"id":"semetey-1-2013:p0828:b004:l002","ordinal":140337,"en":"And made Talas his home,"},{"id":"semetey-1-2013:p0828:b004:l003","ordinal":140338,"en":"A handful of Muslims"},{"id":"semetey-1-2013:p0828:b004:l004","ordinal":140339,"en":"He gathered about him as a father."},{"id":"semetey-1-2013:p0828:b004:l005","ordinal":140340,"en":"Of twelve Muslim khans,"},{"id":"semetey-1-2013:p0828:b004:l006","ordinal":140341,"en":"When two remained neutral,"},{"id":"semetey-1-2013:p0828:b004:l007","ordinal":140342,"en":"‘I shall attack your father,’ they said;"},{"id":"semetey-1-2013:p0828:b004:l008","ordinal":140343,"en":"When God struck the others,"},{"id":"semetey-1-2013:p0828:b004:l009","ordinal":140344,"en":"When they went to broad Talas,"},{"id":"semetey-1-2013:p0828:b004:l010","ordinal":140345,"en":"Into the warriors’ hands"},{"id":"semetey-1-2013:p0828:b004:l011","ordinal":140346,"en":"Fell the people of ten khans."},{"id":"semetey-1-2013:p0828:b004:l012","ordinal":140347,"en":"Your khan father, leopard Manas,"},{"id":"semetey-1-2013:p0828:b004:l013","ordinal":140348,"en":"Made his dwelling in Talas;"},{"id":"semetey-1-2013:p0828:b004:l014","ordinal":140349,"en":"The Muslim people of ten khans—"},{"id":"semetey-1-2013:p0828:b004:l015","ordinal":140350,"en":"He drove them all"},{"id":"semetey-1-2013:p0828:b004:l016","ordinal":140351,"en":"Under guard toward Beijing."},{"id":"semetey-1-2013:p0828:b004:l017","ordinal":140352,"en":"Beijing, beyond Sulaiman’s reach—"},{"id":"semetey-1-2013:p0828:b004:l018","ordinal":140353,"en":"When he called it to account,"},{"id":"semetey-1-2013:p0828:b004:l019","ordinal":140354,"en":"Beijing, untouched by Aaly-Sher—"},{"id":"semetey-1-2013:p0828:b004:l020","ordinal":140355,"en":"When he fought and wrought slaughter there,"},{"id":"semetey-1-2013:p0828:b004:l021","ordinal":140356,"en":"Proud lords and khans died,"},{"id":"semetey-1-2013:p0828:b004:l022","ordinal":140357,"en":"Everyone he met died."},{"id":"semetey-1-2013:p0828:b004:l023","ordinal":140358,"en":"Not knowing his deeds, the Kokand people,"},{"id":"semetey-1-2013:p0828:b004:l024","ordinal":140359,"en":"The peoples of four khans, gathered;"},{"id":"semetey-1-2013:p0828:b004:l025","ordinal":140360,"en":"As prizes.\""},{"id":"semetey-1-2013:p0828:b004:l026","ordinal":140361,"en":"Thus, when their conduct turned bad,"},{"id":"semetey-1-2013:p0828:b004:l028","ordinal":140362,"en":"Your leopard father"},{"id":"semetey-1-2013:p0828:b004:l029","ordinal":140363,"en":"Would humiliate Kokand."},{"id":"semetey-1-2013:p0828:b004:l030","ordinal":140364,"en":"Relentlessly, from the Sarts,"},{"id":"semetey-1-2013:p0828:b004:l031","ordinal":140365,"en":"He exacted heavy tribute."},{"id":"semetey-1-2013:p0828:b004:l032","ordinal":140366,"en":"From Alty-Shaar and Kokand"},{"id":"semetey-1-2013:p0828:b004:l033","ordinal":140367,"en":"He took tribute;"},{"id":"semetey-1-2013:p0828:b004:l034","ordinal":140368,"en":"He treated them like sheep."},{"id":"semetey-1-2013:p0828:b004:l035","ordinal":140369,"en":"Six thousand silver ingots, a thousand otter pelts"},{"id":"semetey-1-2013:p0828:b004:l036","ordinal":140370,"en":"He would take in tribute."},{"id":"semetey-1-2013:p0828:b004:l037","ordinal":140371,"en":"Unable to bear the tribute,"},{"id":"semetey-1-2013:p0828:b004:l038","ordinal":140372,"en":"Every people would weep."},{"id":"semetey-1-2013:p0828:b004:l039","ordinal":140373,"en":"They too have a vengeance to seek."},{"id":"semetey-1-2013:p0829:b003:l001","ordinal":140374,"en":"‘They have moved away from Bukhara,’"},{"id":"semetey-1-2013:p0829:b003:l002","ordinal":140375,"en":"They must have heard from caravans."},{"id":"semetey-1-2013:p0829:b003:l003","ordinal":140376,"en":"The peoples of four khans have surely united"},{"id":"semetey-1-2013:p0829:b003:l004","ordinal":140377,"en":"And gathered their armies."},{"id":"semetey-1-2013:p0829:b003:l005","ordinal":140378,"en":"To seize you,"},{"id":"semetey-1-2013:p0829:b003:l006","ordinal":140379,"en":"To put an end to you,"},{"id":"semetey-1-2013:p0829:b003:l007","ordinal":140380,"en":"The peoples of four khans have gathered,"},{"id":"semetey-1-2013:p0829:b003:l008","ordinal":140381,"en":"Chewing white wheat flour,"},{"id":"semetey-1-2013:p0829:b003:l009","ordinal":140382,"en":"Holding the Holy Koran,"},{"id":"semetey-1-2013:p0829:b003:l010","ordinal":140383,"en":"Invoking God as they speak,"},{"id":"semetey-1-2013:p0829:b003:l011","ordinal":140384,"en":"Making their promise firm,"},{"id":"semetey-1-2013:p0829:b003:l012","ordinal":140385,"en":"Swearing an oath unto death,"},{"id":"semetey-1-2013:p0829:b003:l013","ordinal":140386,"en":"They must have risen in uproar."},{"id":"semetey-1-2013:p0829:b003:l014","ordinal":140387,"en":"All those people"},{"id":"semetey-1-2013:p0829:b003:l015","ordinal":140388,"en":"Must be in great turmoil;"},{"id":"semetey-1-2013:p0829:b003:l016","ordinal":140389,"en":"They must have gathered their champions,"},{"id":"semetey-1-2013:p0829:b003:l017","ordinal":140390,"en":"The others must be plotting,"},{"id":"semetey-1-2013:p0829:b003:l018","ordinal":140391,"en":"They must have blocked your way."},{"id":"semetey-1-2013:p0829:b003:l019","ordinal":140392,"en":"It is no ridge to give us shelter,"},{"id":"semetey-1-2013:p0829:b003:l020","ordinal":140393,"en":"No people a mortal can trust."},{"id":"semetey-1-2013:p0829:b003:l021","ordinal":140394,"en":"‘He threw Tööbalban down;"},{"id":"semetey-1-2013:p0829:b003:l022","ordinal":140395,"en":"Though we begged him for mercy, he would not desist;"},{"id":"semetey-1-2013:p0829:b003:l023","ordinal":140396,"en":"He tore off one arm,"},{"id":"semetey-1-2013:p0829:b003:l024","ordinal":140397,"en":"He put him to death’—"},{"id":"semetey-1-2013:p0829:b003:l025","ordinal":140398,"en":"Kokand has that vengeance too."},{"id":"semetey-1-2013:p0829:b003:l026","ordinal":140399,"en":"My spring, my river in its valley,"},{"id":"semetey-1-2013:p0829:b003:l027","ordinal":140400,"en":"My child whom I gained at death’s door,"},{"id":"semetey-1-2013:p0829:b003:l028","ordinal":140401,"en":"That hill showing darkly"},{"id":"semetey-1-2013:p0829:b003:l029","ordinal":140402,"en":"Is the ridge of Khan Kokand."},{"id":"semetey-1-2013:p0829:b003:l030","ordinal":140403,"en":"At all times on that ridge"},{"id":"semetey-1-2013:p0829:b003:l031","ordinal":140404,"en":"A sentry has stood."},{"id":"semetey-1-2013:p0829:b003:l032","ordinal":140405,"en":"My darling orphan,"},{"id":"semetey-1-2013:p0829:b003:l033","ordinal":140406,"en":"Let us never come upon them."},{"id":"semetey-1-2013:p0829:b003:l034","ordinal":140407,"en":"I, your mother Kanykei—"},{"id":"semetey-1-2013:p0829:b003:l035","ordinal":140408,"en":"Understand her blessed words;"},{"id":"semetey-1-2013:p0829:b003:l036","ordinal":140409,"en":"My precious orphan, heed me!"},{"id":"semetey-1-2013:p0829:b003:l037","ordinal":140410,"en":"If we come upon this road,"},{"id":"semetey-1-2013:p0829:b003:l038","ordinal":140411,"en":"If you are captured by Kokand,"},{"id":"semetey-1-2013:p0829:b003:l039","ordinal":140412,"en":"If you challenge them, they will not let you prosper;"},{"id":"semetey-1-2013:p0829:b004:l001","ordinal":140413,"en":"Alas, Kokand will not leave you unharmed."},{"id":"semetey-1-2013:p0829:b004:l002","ordinal":140414,"en":"Gathered from four khans’ peoples,"},{"id":"semetey-1-2013:p0829:b004:l003","ordinal":140415,"en":"They have great numbers of troops,"},{"id":"semetey-1-2013:p0829:b004:l004","ordinal":140416,"en":"They have pits dug ready,"},{"id":"semetey-1-2013:p0829:b004:l005","ordinal":140417,"en":"They have brine boiling ready."},{"id":"semetey-1-2013:p0829:b004:l006","ordinal":140418,"en":"Aman-Jol, where your mother came wandering—"},{"id":"semetey-1-2013:p0829:b004:l008","ordinal":140419,"en":"Let us take Aman-Jol."},{"id":"semetey-1-2013:p0829:b004:l009","ordinal":140420,"en":"These people with their white devils—"},{"id":"semetey-1-2013:p0829:b004:l010","ordinal":140421,"en":"My darling foal,"},{"id":"semetey-1-2013:p0829:b004:l011","ordinal":140422,"en":"Let us pass away unseen."},{"id":"semetey-1-2013:p0829:b004:l012","ordinal":140423,"en":"These people riding on packsaddles—"},{"id":"semetey-1-2013:p0829:b004:l013","ordinal":140424,"en":"Why should we contend with them?"},{"id":"semetey-1-2013:p0829:b004:l014","ordinal":140425,"en":"This road is full of terror and trouble."},{"id":"semetey-1-2013:p0829:b004:l015","ordinal":140426,"en":"The land inherited from your father—"},{"id":"semetey-1-2013:p0829:b004:l016","ordinal":140427,"en":"Let us enter Talas."},{"id":"semetey-1-2013:p0829:b004:l017","ordinal":140428,"en":"White-bearded elders have said,"},{"id":"semetey-1-2013:p0829:b004:l018","ordinal":140429,"en":"All the wise have said:"},{"id":"semetey-1-2013:p0829:b004:l019","ordinal":140430,"en":"‘A man rests not till he reaches his people,"},{"id":"semetey-1-2013:p0829:b004:l020","ordinal":140431,"en":"A girl rests not till she marries a man,"},{"id":"semetey-1-2013:p0829:b004:l021","ordinal":140432,"en":"A dog rests not till it reaches its home.’"},{"id":"semetey-1-2013:p0829:b004:l022","ordinal":140433,"en":"My hoof left by the noble steed,"},{"id":"semetey-1-2013:p0829:b004:l023","ordinal":140434,"en":"My young one left by the falcon!"},{"id":"semetey-1-2013:p0829:b004:l024","ordinal":140435,"en":"Bukhara has rough ridges,"},{"id":"semetey-1-2013:p0829:b004:l025","ordinal":140436,"en":"And people inclined to mischief."},{"id":"semetey-1-2013:p0829:b004:l026","ordinal":140437,"en":"Do not lean on a rugged ridge;"},{"id":"semetey-1-2013:p0829:b004:l027","ordinal":140438,"en":"Do not contend with treacherous people."},{"id":"semetey-1-2013:p0829:b004:l028","ordinal":140439,"en":"Utterly alone, a solitary pine,"},{"id":"semetey-1-2013:p0829:b004:l029","ordinal":140440,"en":"You alone are my support."},{"id":"semetey-1-2013:p0829:b004:l030","ordinal":140441,"en":"You have no support to rely upon;"},{"id":"semetey-1-2013:p0829:b004:l031","ordinal":140442,"en":"If a great army advances and surrounds you,"},{"id":"semetey-1-2013:p0829:b004:l032","ordinal":140443,"en":"You have no famed warrior Bakai."},{"id":"semetey-1-2013:p0829:b004:l033","ordinal":140444,"en":"There is no forest to flee into;"},{"id":"semetey-1-2013:p0829:b004:l034","ordinal":140445,"en":"Beside you, to give you shelter,"},{"id":"semetey-1-2013:p0829:b004:l035","ordinal":140446,"en":"There is no vast Kyrgyz people!”"},{"id":"semetey-1-2013:p0829:b004:l036","ordinal":140447,"en":"As his mother spoke,"},{"id":"semetey-1-2013:p0829:b004:l037","ordinal":140448,"en":"Would the incorrigible orphan mend his ways?"},{"id":"semetey-1-2013:p0829:b004:l038","ordinal":140449,"en":"Of your dear, fierce mother—"},{"id":"semetey-1-2013:p0830:b003:l001","ordinal":140450,"en":"Would he heed her words?"},{"id":"semetey-1-2013:p0830:b003:l002","ordinal":140451,"en":"Growing stronger whenever it seemed spent,"},{"id":"semetey-1-2013:p0830:b003:l003","ordinal":140452,"en":"The line of deep-rooted Manas;"},{"id":"semetey-1-2013:p0830:b003:l004","ordinal":140453,"en":"Increasing with every death,"},{"id":"semetey-1-2013:p0830:b003:l005","ordinal":140454,"en":"The line of mighty Manas—"},{"id":"semetey-1-2013:p0830:b003:l006","ordinal":140455,"en":"Semetey stood and said:"},{"id":"semetey-1-2013:p0830:b003:l007","ordinal":140456,"en":"“Alas, Mother, what are you saying?"},{"id":"semetey-1-2013:p0830:b003:l008","ordinal":140457,"en":"Who should hear these words of yours?"},{"id":"semetey-1-2013:p0830:b003:l009","ordinal":140458,"en":"Let only the dark night hear them;"},{"id":"semetey-1-2013:p0830:b003:l010","ordinal":140459,"en":"Who else should hear them?"},{"id":"semetey-1-2013:p0830:b003:l011","ordinal":140460,"en":"When we moved from Temirkan,"},{"id":"semetey-1-2013:p0830:b003:l012","ordinal":140461,"en":"‘He wandered in and grew up here,"},{"id":"semetey-1-2013:p0830:b003:l013","ordinal":140462,"en":"Then took his inheritance,’ will they not say?"},{"id":"semetey-1-2013:p0830:b003:l014","ordinal":140463,"en":"‘The wealth he received as his share"},{"id":"semetey-1-2013:p0830:b003:l015","ordinal":140464,"en":"He scattered and left,’ will they not say?"},{"id":"semetey-1-2013:p0830:b003:l016","ordinal":140465,"en":"‘That worthless son of Manas,"},{"id":"semetey-1-2013:p0830:b003:l017","ordinal":140466,"en":"And gathered troops all along the road—"},{"id":"semetey-1-2013:p0830:b003:l018","ordinal":140467,"en":"Through mountains where no wild goat walks,"},{"id":"semetey-1-2013:p0830:b003:l019","ordinal":140468,"en":"He fled,’ will they not say?"},{"id":"semetey-1-2013:p0830:b003:l020","ordinal":140469,"en":"Their many people will gather;"},{"id":"semetey-1-2013:p0830:b003:l021","ordinal":140470,"en":"Will they not gossip and mock?"},{"id":"semetey-1-2013:p0830:b003:l022","ordinal":140471,"en":"A man destined to be struck down—"},{"id":"semetey-1-2013:p0830:b003:l023","ordinal":140472,"en":"Does not God strike him thus?"},{"id":"semetey-1-2013:p0830:b003:l024","ordinal":140473,"en":"The decree written by Allah—"},{"id":"semetey-1-2013:p0830:b003:l025","ordinal":140474,"en":"Must not a mortal soul meet it?"},{"id":"semetey-1-2013:p0830:b003:l026","ordinal":140475,"en":"When death comes and our days are ended,"},{"id":"semetey-1-2013:p0830:b003:l027","ordinal":140476,"en":"When the Creator gives command,"},{"id":"semetey-1-2013:p0830:b003:l028","ordinal":140477,"en":"When the angel who takes life"},{"id":"semetey-1-2013:p0830:b003:l029","ordinal":140478,"en":"Stretches his five fingers toward us,"},{"id":"semetey-1-2013:p0830:b003:l030","ordinal":140479,"en":"Then the glib tongue that speaks is stilled."},{"id":"semetey-1-2013:p0830:b003:l031","ordinal":140480,"en":"This world is truly vain;"},{"id":"semetey-1-2013:p0830:b003:l032","ordinal":140481,"en":"What soul can flee and escape?"},{"id":"semetey-1-2013:p0830:b003:l033","ordinal":140482,"en":"The dug grave will receive us;"},{"id":"semetey-1-2013:p0830:b004:l001","ordinal":140483,"en":"All eighteen thousand worlds"},{"id":"semetey-1-2013:p0830:b004:l002","ordinal":140484,"en":"The black earth will swallow."},{"id":"semetey-1-2013:p0830:b004:l003","ordinal":140485,"en":"The only son of a prince—"},{"id":"semetey-1-2013:p0830:b004:l004","ordinal":140486,"en":"Can he run away?"},{"id":"semetey-1-2013:p0830:b004:l005","ordinal":140487,"en":"The life entrusted to us in this world—"},{"id":"semetey-1-2013:p0830:b004:l006","ordinal":140488,"en":"Is it right to keep it hiding?"},{"id":"semetey-1-2013:p0830:b004:l007","ordinal":140489,"en":"Let me go to Kokand;"},{"id":"semetey-1-2013:p0830:b004:l008","ordinal":140490,"en":"If its people are well,"},{"id":"semetey-1-2013:p0830:b004:l009","ordinal":140491,"en":"Let me too greet them!”"},{"id":"semetey-1-2013:p0830:b004:l010","ordinal":140492,"en":"Your fierce one, Manas’s son,"},{"id":"semetey-1-2013:p0830:b004:l011","ordinal":140493,"en":"That dear hero like a fighting cock—"},{"id":"semetey-1-2013:p0830:b004:l012","ordinal":140494,"en":"That place saw his stirring."},{"id":"semetey-1-2013:p0830:b004:l013","ordinal":140495,"en":"And seized the bridle"},{"id":"semetey-1-2013:p0830:b004:l014","ordinal":140496,"en":"He gathered up the reins,"},{"id":"semetey-1-2013:p0830:b004:l015","ordinal":140497,"en":"And toward Khan Kokand"},{"id":"semetey-1-2013:p0830:b004:l016","ordinal":140498,"en":"Your orphan cried, “Go!” and set off."},{"id":"semetey-1-2013:p0830:b004:l018","ordinal":140499,"en":"Sary Khan, with eyes like little bowls,"},{"id":"semetey-1-2013:p0830:b004:l019","ordinal":140500,"en":"Had a beast such as Tuuchunak;"},{"id":"semetey-1-2013:p0830:b004:l020","ordinal":140501,"en":"He too had the strength of a thousand men."},{"id":"semetey-1-2013:p0830:b004:l021","ordinal":140502,"en":"Thick-armed, stone-hearted,"},{"id":"semetey-1-2013:p0830:b004:l022","ordinal":140503,"en":"The fortified city of Kokand—"},{"id":"semetey-1-2013:p0830:b004:l023","ordinal":140504,"en":"If he attacked it, he would bring great trouble."},{"id":"semetey-1-2013:p0830:b004:l024","ordinal":140505,"en":"Drawing near to Khan Kokand,"},{"id":"semetey-1-2013:p0830:b004:l025","ordinal":140506,"en":"Tuuchunak flew like an arrow behind him,"},{"id":"semetey-1-2013:p0830:b004:l026","ordinal":140507,"en":"Coming at a flashing gallop."},{"id":"semetey-1-2013:p0830:b004:l027","ordinal":140508,"en":"To Kokand’s lookout post"},{"id":"semetey-1-2013:p0830:b004:l028","ordinal":140509,"en":"The two rode forward."},{"id":"semetey-1-2013:p0830:b004:l029","ordinal":140510,"en":"Kokand’s sentry,"},{"id":"semetey-1-2013:p0830:b004:l030","ordinal":140511,"en":"Seeing the boy, darted away,"},{"id":"semetey-1-2013:p0830:b004:l031","ordinal":140512,"en":"Urging his horse toward Kokand."},{"id":"semetey-1-2013:p0830:b004:l032","ordinal":140513,"en":"To Kozubek in Kokand"},{"id":"semetey-1-2013:p0830:b004:l033","ordinal":140514,"en":"He went and brought the news."},{"id":"semetey-1-2013:p0831:b004:l001","ordinal":140515,"en":"“He who began that turmoil,"},{"id":"semetey-1-2013:p0831:b004:l002","ordinal":140516,"en":"Who tore out one of Tööbalban’s arms"},{"id":"semetey-1-2013:p0831:b004:l003","ordinal":140517,"en":"Completely—"},{"id":"semetey-1-2013:p0831:b004:l004","ordinal":140518,"en":"That bastard has come,"},{"id":"semetey-1-2013:p0831:b004:l005","ordinal":140519,"en":"That whoreson has come!”"},{"id":"semetey-1-2013:p0831:b004:l006","ordinal":140520,"en":"The sentry came in great agitation,"},{"id":"semetey-1-2013:p0831:b004:l007","ordinal":140521,"en":"Speaking to Kozubek:"},{"id":"semetey-1-2013:p0831:b004:l008","ordinal":140522,"en":"“He who began the turmoil,"},{"id":"semetey-1-2013:p0831:b004:l009","ordinal":140523,"en":"When he went on from here,"},{"id":"semetey-1-2013:p0831:b004:l010","ordinal":140524,"en":"Some sixty of Kokand’s soldiers"},{"id":"semetey-1-2013:p0831:b004:l011","ordinal":140525,"en":"He slaughtered to the last man."},{"id":"semetey-1-2013:p0831:b004:l012","ordinal":140526,"en":"Growing to manhood as an orphan,"},{"id":"semetey-1-2013:p0831:b004:l013","ordinal":140527,"en":"The orphan slave is passing by."},{"id":"semetey-1-2013:p0831:b004:l014","ordinal":140528,"en":"If you do not seize him now,"},{"id":"semetey-1-2013:p0831:b004:l015","ordinal":140529,"en":"If you do not put an end to him,"},{"id":"semetey-1-2013:p0831:b004:l016","ordinal":140530,"en":"When he returns, the orphan slave"},{"id":"semetey-1-2013:p0831:b004:l017","ordinal":140531,"en":"Will imprison the wandering dervishes,"},{"id":"semetey-1-2013:p0831:b004:l018","ordinal":140532,"en":"Will he not beat the khojas?"},{"id":"semetey-1-2013:p0831:b004:l019","ordinal":140533,"en":"The turbaned khojas,"},{"id":"semetey-1-2013:p0831:b004:l020","ordinal":140534,"en":"The mullahs in the mosque—"},{"id":"semetey-1-2013:p0831:b004:l021","ordinal":140535,"en":"He will slaughter every one."},{"id":"semetey-1-2013:p0831:b004:l022","ordinal":140536,"en":"God will surely strike the orphan down;"},{"id":"semetey-1-2013:p0831:b004:l023","ordinal":140537,"en":"He will humiliate Kokand."},{"id":"semetey-1-2013:p0831:b004:l024","ordinal":140538,"en":"Sweeping up Samarkand’s people,"},{"id":"semetey-1-2013:p0831:b004:l025","ordinal":140539,"en":"He will drive them toward Talas."},{"id":"semetey-1-2013:p0831:b004:l026","ordinal":140540,"en":"He will bind Margalan,"},{"id":"semetey-1-2013:p0831:b004:l027","ordinal":140541,"en":"He will devastate Andijan."},{"id":"semetey-1-2013:p0831:b004:l028","ordinal":140542,"en":"He will take the tribute in full,"},{"id":"semetey-1-2013:p0831:b004:l029","ordinal":140543,"en":"‘My property left by my father,’ he will say,"},{"id":"semetey-1-2013:p0831:b004:l030","ordinal":140544,"en":"And torment us all together!"}]
