[{"id":"seytek-2012:p0513:b002:l014","ordinal":333825,"en":"Unable to regain their senses,"},{"id":"seytek-2012:p0513:b002:l015","ordinal":333826,"en":"The great host stood clamoring."},{"id":"seytek-2012:p0513:b002:l016","ordinal":333827,"en":"The war drum thundered firmly;"},{"id":"seytek-2012:p0513:b002:l017","ordinal":333828,"en":"Within the army Külchoro"},{"id":"seytek-2012:p0513:b002:l018","ordinal":333829,"en":"Swept forward like a spirit,"},{"id":"seytek-2012:p0513:b002:l019","ordinal":333830,"en":"Finding counsel where none seemed possible."},{"id":"seytek-2012:p0513:b002:l020","ordinal":333831,"en":"The trumpets blared in excitement,"},{"id":"seytek-2012:p0513:b002:l021","ordinal":333832,"en":"And his trumpeter grew fervent."},{"id":"seytek-2012:p0513:b002:l022","ordinal":333833,"en":"Throwing every soul into alarm,"},{"id":"seytek-2012:p0513:b002:l023","ordinal":333834,"en":"He made the gray horse beneath him"},{"id":"seytek-2012:p0513:b002:l024","ordinal":333835,"en":"Stride forward at a stately pace,"},{"id":"seytek-2012:p0513:b002:l025","ordinal":333836,"en":"And leveled his steel weapon."},{"id":"seytek-2012:p0513:b002:l026","ordinal":333837,"en":"He swallowed up the countless host"},{"id":"seytek-2012:p0513:b002:l027","ordinal":333838,"en":"That had panicked helplessly."},{"id":"seytek-2012:p0513:b002:l028","ordinal":333839,"en":"His lashes became leaping flame,"},{"id":"seytek-2012:p0513:b002:l029","ordinal":333840,"en":"His eyes blazed like embers."},{"id":"seytek-2012:p0513:b002:l030","ordinal":333841,"en":"He gnashed his teeth with a crack,"},{"id":"seytek-2012:p0513:b002:l031","ordinal":333842,"en":"His bloodthirsty visage boiling fiercely."},{"id":"seytek-2012:p0513:b002:l032","ordinal":333843,"en":"Flaring with wrath,"},{"id":"seytek-2012:p0513:b002:l033","ordinal":333844,"en":"He addressed the great army:"},{"id":"seytek-2012:p0513:b002:l034","ordinal":333845,"en":"“Damn you, mighty host!"},{"id":"seytek-2012:p0513:b002:l035","ordinal":333846,"en":"You are lions and tigers,"},{"id":"seytek-2012:p0513:b002:l036","ordinal":333847,"en":"Imposing warriors,"},{"id":"seytek-2012:p0513:b002:l037","ordinal":333848,"en":"Who came here seeking battle!"},{"id":"seytek-2012:p0513:b002:l038","ordinal":333849,"en":"But when battle begins, you lose your heads"},{"id":"seytek-2012:p0513:b002:l039","ordinal":333850,"en":"And flee in terror—"},{"id":"seytek-2012:p0513:b002:l040","ordinal":333851,"en":"If you act so, people, you are dead!"},{"id":"seytek-2012:p0513:b003:l001","ordinal":333852,"en":"Those who escaped death"},{"id":"seytek-2012:p0513:b003:l002","ordinal":333853,"en":"Raised a clamor and fled back."},{"id":"seytek-2012:p0513:b003:l003","ordinal":333854,"en":"Some champions are wounded,"},{"id":"seytek-2012:p0513:b003:l004","ordinal":333855,"en":"While some remain wholly unharmed."},{"id":"seytek-2012:p0513:b003:l005","ordinal":333856,"en":"Some champions lost their nerve,"},{"id":"seytek-2012:p0513:b003:l006","ordinal":333857,"en":"Were soundly pierced by spears,"},{"id":"seytek-2012:p0513:b003:l007","ordinal":333858,"en":"And fled without finding a way out."},{"id":"seytek-2012:p0513:b003:l008","ordinal":333859,"en":"May God never show us his face!"},{"id":"seytek-2012:p0513:b003:l009","ordinal":333860,"en":"Sarybai is a horror,"},{"id":"seytek-2012:p0513:b003:l010","ordinal":333861,"en":"They say he turned the army from the hills;"},{"id":"seytek-2012:p0513:b003:l011","ordinal":333862,"en":"They say he slaughtered without a word"},{"id":"seytek-2012:p0513:b003:l012","ordinal":333863,"en":"All whom he encountered."},{"id":"seytek-2012:p0513:b003:l013","ordinal":333864,"en":"None can overcome him in combat,"},{"id":"seytek-2012:p0513:b003:l014","ordinal":333865,"en":"No lion’s teeth can pierce him;"},{"id":"seytek-2012:p0513:b003:l015","ordinal":333866,"en":"His form is strange, his venom strong."},{"id":"seytek-2012:p0513:b003:l016","ordinal":333867,"en":"If you encounter Sarybai,"},{"id":"seytek-2012:p0513:b003:l017","ordinal":333868,"en":"Abandon hope of life and count yourselves dead!"},{"id":"seytek-2012:p0513:b003:l018","ordinal":333869,"en":"He is fire incarnate,"},{"id":"seytek-2012:p0513:b003:l019","ordinal":333870,"en":"The eye of a devouring fiend,"},{"id":"seytek-2012:p0513:b003:l020","ordinal":333871,"en":"The very red essence of disaster."},{"id":"seytek-2012:p0513:b003:l021","ordinal":333872,"en":"We have seen Sarybai’s form:"},{"id":"seytek-2012:p0513:b003:l022","ordinal":333873,"en":"He is like a champion who ruins nations,"},{"id":"seytek-2012:p0513:b003:l023","ordinal":333874,"en":"Driving men like helpless prey,"},{"id":"seytek-2012:p0513:b003:l024","ordinal":333875,"en":"Rending them like a hungry wolf."},{"id":"seytek-2012:p0513:b003:l025","ordinal":333876,"en":"It is as though he gathered the whole world"},{"id":"seytek-2012:p0513:b003:l026","ordinal":333877,"en":"And stuffed it into a single sack."},{"id":"seytek-2012:p0513:b003:l027","ordinal":333878,"en":"Almighty Allah creates"},{"id":"seytek-2012:p0513:b003:l028","ordinal":333879,"en":"His servants in every fashion."},{"id":"seytek-2012:p0513:b003:l029","ordinal":333880,"en":"His two cheeks hang loose,"},{"id":"seytek-2012:p0513:b003:l030","ordinal":333881,"en":"As though two giants had feasted."},{"id":"seytek-2012:p0513:b003:l031","ordinal":333882,"en":"He turns all before him into desert,"},{"id":"seytek-2012:p0513:b003:l032","ordinal":333883,"en":"As though gulping them down whole."},{"id":"seytek-2012:p0513:b003:l033","ordinal":333884,"en":"No vast host can advance against him;"},{"id":"seytek-2012:p0513:b003:l034","ordinal":333885,"en":"None who fights him can survive."},{"id":"seytek-2012:p0513:b003:l035","ordinal":333886,"en":"Black-browed like a recumbent hound,"},{"id":"seytek-2012:p0513:b003:l036","ordinal":333887,"en":"As though vultures roosted upon him,"},{"id":"seytek-2012:p0513:b003:l037","ordinal":333888,"en":"He gnaws whoever meets him,"},{"id":"seytek-2012:p0513:b003:l038","ordinal":333889,"en":"As though swallowing them whole—"},{"id":"seytek-2012:p0513:b003:l039","ordinal":333890,"en":"Such is Sarybai’s appearance."},{"id":"seytek-2012:p0513:b003:l040","ordinal":333891,"en":"However hard each man may struggle,"},{"id":"seytek-2012:p0514:b002:l001","ordinal":333892,"en":"“If I do not slaughter all I meet,"},{"id":"seytek-2012:p0514:b002:l002","ordinal":333893,"en":"If in the end I do not sate myself"},{"id":"seytek-2012:p0514:b002:l003","ordinal":333894,"en":"Upon that dog Sarybai’s blood!”"},{"id":"seytek-2012:p0514:b002:l004","ordinal":333895,"en":"Hero Külchoro spoke these words;"},{"id":"seytek-2012:p0514:b002:l005","ordinal":333896,"en":"Your renowned uncle rose there,"},{"id":"seytek-2012:p0514:b002:l006","ordinal":333897,"en":"Your uncle Külchoro spoke thus,"},{"id":"seytek-2012:p0514:b002:l007","ordinal":333898,"en":"And his eyes glittered like flame."},{"id":"seytek-2012:p0514:b002:l008","ordinal":333899,"en":"When he heard of Sarybai,"},{"id":"seytek-2012:p0514:b002:l009","ordinal":333900,"en":"Fearsome rage seized him."},{"id":"seytek-2012:p0514:b002:l010","ordinal":333901,"en":"His precious, clenched teeth"},{"id":"seytek-2012:p0514:b002:l011","ordinal":333902,"en":"He ground again and again."},{"id":"seytek-2012:p0514:b002:l012","ordinal":333903,"en":"Hell showed upon his face;"},{"id":"seytek-2012:p0514:b002:l013","ordinal":333904,"en":"His lion-hearted valor"},{"id":"seytek-2012:p0514:b002:l014","ordinal":333905,"en":"Surpassed the host and set him apart."},{"id":"seytek-2012:p0514:b002:l015","ordinal":333906,"en":"He gathered himself like a blue tiger,"},{"id":"seytek-2012:p0514:b002:l016","ordinal":333907,"en":"Clad himself in armor no bullet pierced,"},{"id":"seytek-2012:p0514:b002:l017","ordinal":333908,"en":"Set all his weapons in order,"},{"id":"seytek-2012:p0514:b002:l018","ordinal":333909,"en":"And girded on his gleaming sword."},{"id":"seytek-2012:p0514:b002:l019","ordinal":333910,"en":"Hearts sank and parted,"},{"id":"seytek-2012:p0514:b002:l020","ordinal":333911,"en":"As he parted from the vast army,"},{"id":"seytek-2012:p0514:b002:l021","ordinal":333912,"en":"The tasseled standard swaying in his hand."},{"id":"seytek-2012:p0514:b002:l022","ordinal":333913,"en":"And so Külchoro,"},{"id":"seytek-2012:p0514:b002:l023","ordinal":333914,"en":"Galloping upon Surkiyik,"},{"id":"seytek-2012:p0514:b002:l024","ordinal":333915,"en":"Made the earth’s navel quake."},{"id":"seytek-2012:p0514:b002:l025","ordinal":333916,"en":"Tall and broad-shouldered,"},{"id":"seytek-2012:p0514:b002:l026","ordinal":333917,"en":"Both champion and lion,"},{"id":"seytek-2012:p0514:b002:l027","ordinal":333918,"en":"He was a seasoned hero who knew the enemy’s ways."},{"id":"seytek-2012:p0514:b002:l028","ordinal":333919,"en":"Toward the infidel of mighty arms,"},{"id":"seytek-2012:p0514:b002:l029","ordinal":333920,"en":"Toward the hero of abundant courage,"},{"id":"seytek-2012:p0514:b002:l030","ordinal":333921,"en":"Toward the infidel Sarybai,"},{"id":"seytek-2012:p0514:b002:l031","ordinal":333922,"en":"He hastened without pausing for breath,"},{"id":"seytek-2012:p0514:b002:l032","ordinal":333923,"en":"To clash fiercely in combat,"},{"id":"seytek-2012:p0514:b002:l033","ordinal":333924,"en":"To fight to the death,"},{"id":"seytek-2012:p0514:b002:l034","ordinal":333925,"en":"To wreak great slaughter,"},{"id":"seytek-2012:p0514:b002:l035","ordinal":333926,"en":"And meet him face-to-face."},{"id":"seytek-2012:p0514:b002:l036","ordinal":333927,"en":"What he said at dawn was fulfilled by dusk,"},{"id":"seytek-2012:p0514:b002:l037","ordinal":333928,"en":"And his eyes strained with expectation."},{"id":"seytek-2012:p0514:b002:l038","ordinal":333929,"en":"Gripping his spear and grinding his teeth,"},{"id":"seytek-2012:p0514:b002:l039","ordinal":333930,"en":"Truly exultant, his eyes ablaze,"},{"id":"seytek-2012:p0514:b002:l040","ordinal":333931,"en":"He went forth to single combat."},{"id":"seytek-2012:p0514:b003:l001","ordinal":333932,"en":"Do valiant champions"},{"id":"seytek-2012:p0514:b003:l002","ordinal":333933,"en":"Not die against the foe they meet?"},{"id":"seytek-2012:p0514:b003:l003","ordinal":333934,"en":"When need demands, do they not give"},{"id":"seytek-2012:p0514:b003:l004","ordinal":333935,"en":"This life to whatever cause they choose?"},{"id":"seytek-2012:p0514:b003:l005","ordinal":333936,"en":"You lost your senses,"},{"id":"seytek-2012:p0514:b003:l006","ordinal":333937,"en":"Rushed about and raised a clamor,"},{"id":"seytek-2012:p0514:b003:l007","ordinal":333938,"en":"Then fled without finding a way."},{"id":"seytek-2012:p0514:b003:l008","ordinal":333939,"en":"Here are your heroes and warriors;"},{"id":"seytek-2012:p0514:b003:l009","ordinal":333940,"en":"When you begin to stir up words,"},{"id":"seytek-2012:p0514:b003:l010","ordinal":333941,"en":"You have weaklings who grow afraid,"},{"id":"seytek-2012:p0514:b003:l011","ordinal":333942,"en":"And fools who panic without counsel."},{"id":"seytek-2012:p0514:b003:l012","ordinal":333943,"en":"You have men who throw vast armies into chaos,"},{"id":"seytek-2012:p0514:b003:l013","ordinal":333944,"en":"Break their strength, and flee."},{"id":"seytek-2012:p0514:b003:l014","ordinal":333945,"en":"You have cowards and warriors,"},{"id":"seytek-2012:p0514:b003:l015","ordinal":333946,"en":"And weaklings who spread disorder."},{"id":"seytek-2012:p0514:b003:l016","ordinal":333947,"en":"Babbling praise of Sarybai—"},{"id":"seytek-2012:p0514:b003:l017","ordinal":333948,"en":"Damn you, wretched people,"},{"id":"seytek-2012:p0514:b003:l018","ordinal":333949,"en":"God has surely cursed you!"},{"id":"seytek-2012:p0514:b003:l019","ordinal":333950,"en":"Is Sarybai such a peerless lion?"},{"id":"seytek-2012:p0514:b003:l020","ordinal":333951,"en":"Is that infidel, the monster’s son,"},{"id":"seytek-2012:p0514:b003:l021","ordinal":333952,"en":"A greater warrior than I?"},{"id":"seytek-2012:p0514:b003:l022","ordinal":333953,"en":"I shall go to the great battlefield,"},{"id":"seytek-2012:p0514:b003:l023","ordinal":333954,"en":"And grapple with Sarybai."},{"id":"seytek-2012:p0514:b003:l024","ordinal":333955,"en":"I shall fire my gun and draw my bow,"},{"id":"seytek-2012:p0514:b003:l025","ordinal":333956,"en":"And wage a relentless fight."},{"id":"seytek-2012:p0514:b003:l026","ordinal":333957,"en":"Broad Talas is no cheap land;"},{"id":"seytek-2012:p0514:b003:l027","ordinal":333958,"en":"Külchoro, born of the renowned,"},{"id":"seytek-2012:p0514:b003:l028","ordinal":333959,"en":"Is no common warrior."},{"id":"seytek-2012:p0514:b003:l029","ordinal":333960,"en":"Sarybai is the one I shall fight,"},{"id":"seytek-2012:p0514:b003:l030","ordinal":333961,"en":"That infidel whose shape is like a mountain,"},{"id":"seytek-2012:p0514:b003:l031","ordinal":333962,"en":"The warrior Khan Sarybai,"},{"id":"seytek-2012:p0514:b003:l032","ordinal":333963,"en":"The brute who scorches the earth,"},{"id":"seytek-2012:p0514:b003:l033","ordinal":333964,"en":"The champion who destroys nations."},{"id":"seytek-2012:p0514:b003:l034","ordinal":333965,"en":"I shall rain many shots upon him,"},{"id":"seytek-2012:p0514:b003:l035","ordinal":333966,"en":"And slaughter his pampered people."},{"id":"seytek-2012:p0514:b003:l036","ordinal":333967,"en":"If I do not seize his spoils,"},{"id":"seytek-2012:p0514:b003:l037","ordinal":333968,"en":"If I do not unleash a shattering battle,"},{"id":"seytek-2012:p0514:b003:l038","ordinal":333969,"en":"Standing face-to-face with him"},{"id":"seytek-2012:p0514:b003:l039","ordinal":333970,"en":"And fighting until this dear life"},{"id":"seytek-2012:p0514:b003:l040","ordinal":333971,"en":"Vanishes before all eyes,"},{"id":"seytek-2012:p0515:b002:l001","ordinal":333972,"en":"He appeared wherever he could be seen,"},{"id":"seytek-2012:p0515:b002:l002","ordinal":333973,"en":"And in unseen ravines"},{"id":"seytek-2012:p0515:b002:l003","ordinal":333974,"en":"He streamed like blue smoke."},{"id":"seytek-2012:p0515:b002:l004","ordinal":333975,"en":"His eyes shone red,"},{"id":"seytek-2012:p0515:b002:l005","ordinal":333976,"en":"His stride lengthened like an argali’s."},{"id":"seytek-2012:p0515:b002:l006","ordinal":333977,"en":"When he came to a bend,"},{"id":"seytek-2012:p0515:b002:l007","ordinal":333978,"en":"The creature proved a true courser,"},{"id":"seytek-2012:p0515:b002:l008","ordinal":333979,"en":"His eyes reddening like a stag’s."},{"id":"seytek-2012:p0515:b002:l009","ordinal":333980,"en":"When he came to winding ground,"},{"id":"seytek-2012:p0515:b002:l010","ordinal":333981,"en":"He stretched his stride and raised tumult,"},{"id":"seytek-2012:p0515:b002:l011","ordinal":333982,"en":"His fleet pace growing longer."},{"id":"seytek-2012:p0515:b002:l012","ordinal":333983,"en":"His hooves thundered on the earth;"},{"id":"seytek-2012:p0515:b002:l013","ordinal":333984,"en":"The black-steel bit"},{"id":"seytek-2012:p0515:b002:l014","ordinal":333985,"en":"Clattered in his throat."},{"id":"seytek-2012:p0515:b002:l015","ordinal":333986,"en":"He flung his forelock to the sky,"},{"id":"seytek-2012:p0515:b002:l016","ordinal":333987,"en":"And drove his hooves into the ground."},{"id":"seytek-2012:p0515:b002:l017","ordinal":333988,"en":"The black-steel bit"},{"id":"seytek-2012:p0515:b002:l018","ordinal":333989,"en":"Beat against his gullet;"},{"id":"seytek-2012:p0515:b002:l019","ordinal":333990,"en":"His willow-silk tail"},{"id":"seytek-2012:p0515:b002:l020","ordinal":333991,"en":"Lashed his spreading legs."},{"id":"seytek-2012:p0515:b002:l021","ordinal":333992,"en":"He laid back his ears like a kulan"},{"id":"seytek-2012:p0515:b002:l022","ordinal":333993,"en":"And swept the earth like a whirlwind."},{"id":"seytek-2012:p0515:b002:l023","ordinal":333994,"en":"At the sound of clamor he surged,"},{"id":"seytek-2012:p0515:b002:l024","ordinal":333995,"en":"And when he ran, the black earth"},{"id":"seytek-2012:p0515:b002:l025","ordinal":333996,"en":"Split layer upon layer—"},{"id":"seytek-2012:p0515:b002:l026","ordinal":333997,"en":"Such was the nature of that tulpar."},{"id":"seytek-2012:p0515:b002:l027","ordinal":333998,"en":"Spear in hand, breaking formations,"},{"id":"seytek-2012:p0515:b002:l028","ordinal":333999,"en":"Külchoro hastened onward."},{"id":"seytek-2012:p0515:b002:l029","ordinal":334000,"en":"He rode across the rise called Horse-Cannot-Pass,"},{"id":"seytek-2012:p0515:b002:l030","ordinal":334001,"en":"Pressing steadily forward."},{"id":"seytek-2012:p0515:b002:l031","ordinal":334002,"en":"Through the open desert of People-Cannot-Cross,"},{"id":"seytek-2012:p0515:b002:l032","ordinal":334003,"en":"He went to settle the matter."},{"id":"seytek-2012:p0515:b002:l033","ordinal":334004,"en":"Toward the infidel, the monster’s son,"},{"id":"seytek-2012:p0515:b002:l034","ordinal":334005,"en":"He went to fight to the death."},{"id":"seytek-2012:p0515:b002:l035","ordinal":334006,"en":"At the Sheer Cliff of Soul-Cannot-Pass,"},{"id":"seytek-2012:p0515:b002:l036","ordinal":334007,"en":"He went to carve a road."},{"id":"seytek-2012:p0515:b002:l037","ordinal":334008,"en":"Against the raging infidel,"},{"id":"seytek-2012:p0515:b002:l038","ordinal":334009,"en":"Against brave Sarybai,"},{"id":"seytek-2012:p0515:b002:l039","ordinal":334010,"en":"He went to launch his assault."},{"id":"seytek-2012:p0515:b002:l040","ordinal":334011,"en":"Against the master of land and water,"},{"id":"seytek-2012:p0515:b003:l001","ordinal":334012,"en":"The rabid, frenzied Sarybai,"},{"id":"seytek-2012:p0515:b003:l002","ordinal":334013,"en":"He went to capture him if his strength sufficed,"},{"id":"seytek-2012:p0515:b003:l003","ordinal":334014,"en":"To unleash terrible slaughter,"},{"id":"seytek-2012:p0515:b003:l004","ordinal":334015,"en":"To throw all into turmoil,"},{"id":"seytek-2012:p0515:b003:l005","ordinal":334016,"en":"And search every pouch"},{"id":"seytek-2012:p0515:b003:l006","ordinal":334017,"en":"Of that champion-posing swine."},{"id":"seytek-2012:p0515:b003:l007","ordinal":334018,"en":"He went to cast hell upon his ranks,"},{"id":"seytek-2012:p0515:b003:l008","ordinal":334019,"en":"To charge in and fight without stopping,"},{"id":"seytek-2012:p0515:b003:l009","ordinal":334020,"en":"And thrust that infidel Sarybai"},{"id":"seytek-2012:p0515:b003:l010","ordinal":334021,"en":"Headlong to the ground."},{"id":"seytek-2012:p0515:b003:l011","ordinal":334022,"en":"Thus matters came to pass,"},{"id":"seytek-2012:p0515:b003:l012","ordinal":334023,"en":"And Külchoro resolved"},{"id":"seytek-2012:p0515:b003:l013","ordinal":334024,"en":"To meet him face-to-face."},{"id":"seytek-2012:p0515:b003:l014","ordinal":334025,"en":"They would clash and test their strength;"},{"id":"seytek-2012:p0515:b003:l015","ordinal":334026,"en":"If fortune favored the valiant man,"},{"id":"seytek-2012:p0515:b003:l016","ordinal":334027,"en":"He would spill Sarybai’s blood,"},{"id":"seytek-2012:p0515:b003:l017","ordinal":334028,"en":"And if not, he would die."},{"id":"seytek-2012:p0515:b003:l018","ordinal":334029,"en":"Gripping his spear, steeling himself,"},{"id":"seytek-2012:p0515:b003:l019","ordinal":334030,"en":"He bit hard upon his lip."},{"id":"seytek-2012:p0515:b003:l020","ordinal":334031,"en":"He scowled in fury,"},{"id":"seytek-2012:p0515:b003:l021","ordinal":334032,"en":"And buckled on his gray girdle."},{"id":"seytek-2012:p0515:b003:l022","ordinal":334033,"en":"He arranged and fastened his weapons;"},{"id":"seytek-2012:p0515:b003:l023","ordinal":334034,"en":"When his rage made him bristle,"},{"id":"seytek-2012:p0515:b003:l024","ordinal":334035,"en":"Wrath transformed his face."},{"id":"seytek-2012:p0515:b003:l025","ordinal":334036,"en":"He surveyed the broad plain,"},{"id":"seytek-2012:p0515:b003:l026","ordinal":334037,"en":"And braced his spirit, saying, “I trust in fate.”"},{"id":"seytek-2012:p0515:b003:l027","ordinal":334038,"en":"He seized his black-handled whip,"},{"id":"seytek-2012:p0515:b003:l028","ordinal":334039,"en":"Swung it around,"},{"id":"seytek-2012:p0515:b003:l029","ordinal":334040,"en":"And Surkaiyk, a steed like none but a spirit—"},{"id":"seytek-2012:p0515:b003:l030","ordinal":334041,"en":"Support of his life held in trust,"},{"id":"seytek-2012:p0515:b003:l031","ordinal":334042,"en":"Pearl among all flowing-tailed horses,"},{"id":"seytek-2012:p0515:b003:l032","ordinal":334043,"en":"Foal of the spirit-gray mare,"},{"id":"seytek-2012:p0515:b003:l033","ordinal":334044,"en":"Duldul among the horses of Karanda—"},{"id":"seytek-2012:p0515:b003:l034","ordinal":334045,"en":"That dark-bay Surkaiyk,"},{"id":"seytek-2012:p0515:b003:l035","ordinal":334046,"en":"He circled the whip over him"},{"id":"seytek-2012:p0515:b003:l036","ordinal":334047,"en":"And struck it against his flank."},{"id":"seytek-2012:p0515:b003:l037","ordinal":334048,"en":"He made the rugged ground quake,"},{"id":"seytek-2012:p0515:b003:l038","ordinal":334049,"en":"Galloping onward upon Surkaiyk."},{"id":"seytek-2012:p0515:b003:l039","ordinal":334050,"en":"Külchoro rode out to single combat"},{"id":"seytek-2012:p0515:b003:l040","ordinal":334051,"en":"Upon the fiery Surkaiyk."},{"id":"seytek-2012:p0516:b002:l001","ordinal":334052,"en":"Külchoro, upheld by the spirits,"},{"id":"seytek-2012:p0516:b002:l002","ordinal":334053,"en":"Was tall and broad-shouldered,"},{"id":"seytek-2012:p0516:b002:l003","ordinal":334054,"en":"Both champion and lion,"},{"id":"seytek-2012:p0516:b002:l004","ordinal":334055,"en":"A seasoned hero who knew"},{"id":"seytek-2012:p0516:b002:l005","ordinal":334056,"en":"The enemy’s ways exceedingly well."},{"id":"seytek-2012:p0516:b002:l006","ordinal":334057,"en":"He struck Kulansur once upon the flank,"},{"id":"seytek-2012:p0516:b002:l007","ordinal":334058,"en":"Took up his fine steel spear,"},{"id":"seytek-2012:p0516:b002:l008","ordinal":334059,"en":"And rode straight toward Sarybai."},{"id":"seytek-2012:p0516:b002:l009","ordinal":334060,"en":"Against brave Sarybai"},{"id":"seytek-2012:p0516:b002:l010","ordinal":334061,"en":"He charged alone:"},{"id":"seytek-2012:p0516:b002:l011","ordinal":334062,"en":"“Sarybai, son of the monster,"},{"id":"seytek-2012:p0516:b002:l012","ordinal":334063,"en":"If you are brave Sarybai,"},{"id":"seytek-2012:p0516:b002:l013","ordinal":334064,"en":"And I am brave Külchoro,"},{"id":"seytek-2012:p0516:b002:l014","ordinal":334065,"en":"Let us face each other with leveled spears"},{"id":"seytek-2012:p0516:b002:l015","ordinal":334066,"en":"And meet in single combat;"},{"id":"seytek-2012:p0516:b002:l016","ordinal":334067,"en":"If death comes, let us die!"},{"id":"seytek-2012:p0516:b002:l017","ordinal":334068,"en":"Let us stand face-to-face,"},{"id":"seytek-2012:p0516:b002:l018","ordinal":334069,"en":"Fight without sparing our lives,"},{"id":"seytek-2012:p0516:b002:l019","ordinal":334070,"en":"And bring this to its final end."},{"id":"seytek-2012:p0516:b002:l020","ordinal":334071,"en":"Let our spears begin their work;"},{"id":"seytek-2012:p0516:b002:l021","ordinal":334072,"en":"Let turmoil seize the earth"},{"id":"seytek-2012:p0516:b002:l022","ordinal":334073,"en":"Until it crumbles beneath us."},{"id":"seytek-2012:p0516:b002:l023","ordinal":334074,"en":"If I am the son of Almambet"},{"id":"seytek-2012:p0516:b002:l024","ordinal":334075,"en":"And you the monster’s son,"},{"id":"seytek-2012:p0516:b002:l025","ordinal":334076,"en":"Let me hear your vaunted fury!"},{"id":"seytek-2012:p0516:b002:l026","ordinal":334077,"en":"Though born of a monster,"},{"id":"seytek-2012:p0516:b002:l027","ordinal":334078,"en":"Even if you possessed seven thousand lives,"},{"id":"seytek-2012:p0516:b002:l028","ordinal":334079,"en":"I would kill and bury you in the earth!"},{"id":"seytek-2012:p0516:b002:l029","ordinal":334080,"en":"I shall spread slaughter to your farthest bounds,"}]
