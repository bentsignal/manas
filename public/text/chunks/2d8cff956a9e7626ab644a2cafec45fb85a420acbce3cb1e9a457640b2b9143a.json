[{"id":"manas-2010:p1183:b001:l037","ordinal":51457,"en":"Since their time it has turned over—"},{"id":"manas-2010:p1183:b001:l038","ordinal":51458,"en":"This immense, wayward world, alas.)"},{"id":"manas-2010:p1183:b001:l039","ordinal":51459,"en":"They journeyed toward Beijing."},{"id":"manas-2010:p1183:b001:l040","ordinal":51460,"en":"They traveled far along the road."},{"id":"manas-2010:p1183:b001:l041","ordinal":51461,"en":"Sarala beneath him,"},{"id":"manas-2010:p1183:b001:l042","ordinal":51462,"en":"Though he wished to tell, had no speech."},{"id":"manas-2010:p1184:b001:l001","ordinal":51463,"en":"The many curving ridges,"},{"id":"manas-2010:p1184:b001:l002","ordinal":51464,"en":"When he saw where he had crossed them,"},{"id":"manas-2010:p1184:b001:l003","ordinal":51465,"en":"From foalhood, frolicking,"},{"id":"manas-2010:p1184:b001:l004","ordinal":51466,"en":"When he saw where he had trodden,"},{"id":"manas-2010:p1184:b001:l005","ordinal":51467,"en":"He flung his forelock toward the sky,"},{"id":"manas-2010:p1184:b001:l006","ordinal":51468,"en":"He drove his hooves into the earth."},{"id":"manas-2010:p1184:b001:l007","ordinal":51469,"en":"The black steel bit"},{"id":"manas-2010:p1184:b001:l008","ordinal":51470,"en":"He struck against his throat."},{"id":"manas-2010:p1184:b001:l009","ordinal":51471,"en":"As though he would roll upon the ground,"},{"id":"manas-2010:p1184:b001:l010","ordinal":51472,"en":"His tail like a strand of silk"},{"id":"manas-2010:p1184:b001:l011","ordinal":51473,"en":"He slapped against his thighs."},{"id":"manas-2010:p1184:b001:l012","ordinal":51474,"en":"The hilltop's pale, curved ridge,"},{"id":"manas-2010:p1184:b001:l013","ordinal":51475,"en":"Sarala went along seeing it."},{"id":"manas-2010:p1184:b001:l014","ordinal":51476,"en":"Whinnying and pawing the ground,"},{"id":"manas-2010:p1184:b001:l015","ordinal":51477,"en":"Sarala went onward."},{"id":"manas-2010:p1184:b001:l016","ordinal":51478,"en":"When he traveled swiftly,"},{"id":"manas-2010:p1184:b001:l017","ordinal":51479,"en":"Sarala, the accomplished steed,"},{"id":"manas-2010:p1184:b001:l018","ordinal":51480,"en":"No wind could match his trot,"},{"id":"manas-2010:p1184:b001:l019","ordinal":51481,"en":"No beast could match his walk."},{"id":"manas-2010:p1184:b001:l020","ordinal":51482,"en":"When Almambet urged him onward,"},{"id":"manas-2010:p1184:b001:l021","ordinal":51483,"en":"His robe hem and sleeves flapping,"},{"id":"manas-2010:p1184:b001:l022","ordinal":51484,"en":"No fired shot could catch him."},{"id":"manas-2010:p1184:b001:l023","ordinal":51485,"en":"When he saw broad Beijing,"},{"id":"manas-2010:p1184:b001:l024","ordinal":51486,"en":"Though Sarala was a beast,"},{"id":"manas-2010:p1184:b001:l025","ordinal":51487,"en":"His soul rejoiced exceedingly."},{"id":"manas-2010:p1184:b001:l026","ordinal":51488,"en":"Sighing and drooping,"},{"id":"manas-2010:p1184:b001:l027","ordinal":51489,"en":"He grieved as he thought of his herd."},{"id":"manas-2010:p1184:b001:l028","ordinal":51490,"en":"The ground he trod shattered."},{"id":"manas-2010:p1184:b001:l029","ordinal":51491,"en":"Clods as big as a great cauldron"},{"id":"manas-2010:p1184:b001:l030","ordinal":51492,"en":"Whizzed above his head."},{"id":"manas-2010:p1184:b001:l031","ordinal":51493,"en":"As he moved on, they flickered."},{"id":"manas-2010:p1184:b001:l032","ordinal":51494,"en":"Silver horseshoes, golden nails,"},{"id":"manas-2010:p1184:b001:l033","ordinal":51495,"en":"Glittered upon his feet."},{"id":"manas-2010:p1184:b001:l034","ordinal":51496,"en":"His mouth opened like a chasm."},{"id":"manas-2010:p1184:b001:l035","ordinal":51497,"en":"White foam mixed with blood"},{"id":"manas-2010:p1184:b001:l036","ordinal":51498,"en":"Spattered upon his breast."},{"id":"manas-2010:p1184:b001:l037","ordinal":51499,"en":"His soles clattered against the earth."},{"id":"manas-2010:p1184:b001:l038","ordinal":51500,"en":"His dangling tongue, a handspan long,"},{"id":"manas-2010:p1184:b001:l039","ordinal":51501,"en":"Flapped against his knees."},{"id":"manas-2010:p1184:b001:l040","ordinal":51502,"en":"Sarala, the swift racer, took the road."},{"id":"manas-2010:p1184:b001:l041","ordinal":51503,"en":"Ahead of him, hero Syrgak,"},{"id":"manas-2010:p1184:b001:l042","ordinal":51504,"en":"Leading Kartküröng,"},{"id":"manas-2010:p1185:b001:l001","ordinal":51505,"en":"Bore a heavy weight of thought."},{"id":"manas-2010:p1185:b001:l002","ordinal":51506,"en":"'God's single command—"},{"id":"manas-2010:p1185:b001:l003","ordinal":51507,"en":"If it falls upon us, let us face it."},{"id":"manas-2010:p1185:b001:l004","ordinal":51508,"en":"Clashing with spears,"},{"id":"manas-2010:p1185:b001:l005","ordinal":51509,"en":"If death comes, let us die."},{"id":"manas-2010:p1185:b001:l006","ordinal":51510,"en":"Let there be one great battle;"},{"id":"manas-2010:p1185:b001:l007","ordinal":51511,"en":"Making the Chinese cower,"},{"id":"manas-2010:p1185:b001:l008","ordinal":51512,"en":"Let us split their cities many times!'"},{"id":"manas-2010:p1185:b001:l009","ordinal":51513,"en":"Syrgak's soul burned with this desire."},{"id":"manas-2010:p1185:b001:l010","ordinal":51514,"en":"'The forest appearing dark,"},{"id":"manas-2010:p1185:b001:l011","ordinal":51515,"en":"Its smoke rising into the sky,"},{"id":"manas-2010:p1185:b001:l012","ordinal":51516,"en":"A great shape looming,"},{"id":"manas-2010:p1185:b001:l013","ordinal":51517,"en":"Its outline emerging before the eyes—"},{"id":"manas-2010:p1185:b001:l014","ordinal":51518,"en":"This is the frontier where Kanyshay stands."},{"id":"manas-2010:p1185:b001:l015","ordinal":51519,"en":"If we appear before her eyes,"},{"id":"manas-2010:p1185:b001:l016","ordinal":51520,"en":"These are the people who will clash with us."},{"id":"manas-2010:p1185:b001:l017","ordinal":51521,"en":"If we do not take her by wisdom,"},{"id":"manas-2010:p1185:b001:l018","ordinal":51522,"en":"This is the warrior who will torment us."},{"id":"manas-2010:p1185:b001:l019","ordinal":51523,"en":"She has footmen no horse could carry."},{"id":"manas-2010:p1185:b001:l020","ordinal":51524,"en":"Why should I speak of the others?"},{"id":"manas-2010:p1185:b001:l021","ordinal":51525,"en":"Among these people,"},{"id":"manas-2010:p1185:b001:l022","ordinal":51526,"en":"She has a giant named Muzkindik."},{"id":"manas-2010:p1185:b001:l023","ordinal":51527,"en":"She is not a woman alone;"},{"id":"manas-2010:p1185:b001:l024","ordinal":51528,"en":"She is no solitary soul."},{"id":"manas-2010:p1185:b001:l025","ordinal":51529,"en":"She has a thousand troops in her hands.'"},{"id":"manas-2010:p1185:b001:l026","ordinal":51530,"en":"Saying this, Almambet,"},{"id":"manas-2010:p1185:b001:l027","ordinal":51531,"en":"Making his eyes blaze like fire,"},{"id":"manas-2010:p1185:b001:l028","ordinal":51532,"en":"Sarala beneath him,"},{"id":"manas-2010:p1185:b001:l029","ordinal":51533,"en":"He handed to hero Syrgak."},{"id":"manas-2010:p1185:b001:l030","ordinal":51534,"en":"Girding on his unsheathed sword,"},{"id":"manas-2010:p1185:b001:l031","ordinal":51535,"en":"Hooking his battle-axe at his waist,"},{"id":"manas-2010:p1185:b001:l032","ordinal":51536,"en":"Wearing his bulletproof coat,"},{"id":"manas-2010:p1185:b001:l033","ordinal":51537,"en":"Placing the Quran against his breast,"},{"id":"manas-2010:p1185:b001:l034","ordinal":51538,"en":"'Grant me support!' he pleaded."},{"id":"manas-2010:p1185:b001:l035","ordinal":51539,"en":"Stepping forward and pausing,"},{"id":"manas-2010:p1185:b001:l036","ordinal":51540,"en":"Poised like a darting snake,"},{"id":"manas-2010:p1185:b001:l037","ordinal":51541,"en":"Charging like a lion:"},{"id":"manas-2010:p1185:b001:l038","ordinal":51542,"en":"'Be careful, Syrgak; keep your eyes open,"},{"id":"manas-2010:p1185:b001:l039","ordinal":51543,"en":"My soul's companion in this distant land.'"},{"id":"manas-2010:p1185:b001:l040","ordinal":51544,"en":"Stepping nimbly and looking about,"},{"id":"manas-2010:p1185:b001:l041","ordinal":51545,"en":"Like a wolf about to strike the sheep,"},{"id":"manas-2010:p1185:b001:l042","ordinal":51546,"en":"Licking his mouth and muzzle,"},{"id":"manas-2010:p1186:b001:l001","ordinal":51547,"en":"Walking swiftly into the forest,"},{"id":"manas-2010:p1186:b001:l002","ordinal":51548,"en":"Almambet entered."},{"id":"manas-2010:p1186:b001:l003","ordinal":51549,"en":"In the middle of the forest,"},{"id":"manas-2010:p1186:b001:l004","ordinal":51550,"en":"A green plane tree was as big as a house."},{"id":"manas-2010:p1186:b001:l005","ordinal":51551,"en":"To see this plane tree,"},{"id":"manas-2010:p1186:b001:l006","ordinal":51552,"en":"Anyone would truly long."},{"id":"manas-2010:p1186:b001:l007","ordinal":51553,"en":"At the foot of the lone plane tree,"},{"id":"manas-2010:p1186:b001:l008","ordinal":51554,"en":"A spring-fed stream was flowing."},{"id":"manas-2010:p1186:b001:l009","ordinal":51555,"en":"Of the Chinese who wore rank stones,"},{"id":"manas-2010:p1186:b001:l010","ordinal":51556,"en":"The finest drank this water."},{"id":"manas-2010:p1186:b001:l011","ordinal":51557,"en":"Deliberately, from Beijing,"},{"id":"manas-2010:p1186:b001:l012","ordinal":51558,"en":"They had the peoples of six khans searched."},{"id":"manas-2010:p1186:b001:l013","ordinal":51559,"en":"From before Esenkan,"},{"id":"manas-2010:p1186:b001:l014","ordinal":51560,"en":"A wrestler with donkey ears,"},{"id":"manas-2010:p1186:b001:l015","ordinal":51561,"en":"To carry their water,"},{"id":"manas-2010:p1186:b001:l016","ordinal":51562,"en":"They had specially summoned him."},{"id":"manas-2010:p1186:b001:l017","ordinal":51563,"en":"Coughing with heavy hacks,"},{"id":"manas-2010:p1186:b001:l018","ordinal":51564,"en":"To the plane tree to fetch water,"},{"id":"manas-2010:p1186:b001:l019","ordinal":51565,"en":"The skins of six bulls"},{"id":"manas-2010:p1186:b001:l020","ordinal":51566,"en":"He brought upon his shoulders."},{"id":"manas-2010:p1186:b001:l021","ordinal":51567,"en":"When he drew near the spring,"},{"id":"manas-2010:p1186:b001:l022","ordinal":51568,"en":"When my Alma learned of it,"},{"id":"manas-2010:p1186:b001:l023","ordinal":51569,"en":"The wrestler filled the water skins,"},{"id":"manas-2010:p1186:b001:l024","ordinal":51570,"en":"Sitting as large as a house."},{"id":"manas-2010:p1186:b001:l025","ordinal":51571,"en":"When he was about to lift them onto his shoulder,"},{"id":"manas-2010:p1186:b001:l026","ordinal":51572,"en":"To the woman Kanyshay,"},{"id":"manas-2010:p1186:b001:l027","ordinal":51573,"en":"When the wrestler was about to carry them,"},{"id":"manas-2010:p1186:b001:l028","ordinal":51574,"en":"He did not let him take a step."},{"id":"manas-2010:p1186:b001:l029","ordinal":51575,"en":"Gray-maned champion Almambet"},{"id":"manas-2010:p1186:b001:l030","ordinal":51576,"en":"Reached him and seized him."},{"id":"manas-2010:p1186:b001:l031","ordinal":51577,"en":"Upon reaching him, Almambet"},{"id":"manas-2010:p1186:b001:l032","ordinal":51578,"en":"Cut off his head, leaving him thrashing,"},{"id":"manas-2010:p1186:b001:l033","ordinal":51579,"en":"And threw him into the spring-fed stream."},{"id":"manas-2010:p1186:b001:l034","ordinal":51580,"en":"Over his own clothing,"},{"id":"manas-2010:p1186:b001:l035","ordinal":51581,"en":"All the wrestler's garments"},{"id":"manas-2010:p1186:b001:l036","ordinal":51582,"en":"He put on."},{"id":"manas-2010:p1186:b001:l037","ordinal":51583,"en":"His crest of hair, like a hand-held mace,"},{"id":"manas-2010:p1186:b001:l038","ordinal":51584,"en":"He spread down his back."},{"id":"manas-2010:p1186:b001:l039","ordinal":51585,"en":"Carrying water for six days,"},{"id":"manas-2010:p1186:b001:l040","ordinal":51586,"en":"To the mighty fighters and the huge woman,"},{"id":"manas-2010:p1186:b001:l041","ordinal":51587,"en":"To the infidel Kanyshay's"},{"id":"manas-2010:p1186:b001:l042","ordinal":51588,"en":"Court he now went."},{"id":"manas-2010:p1187:b001:l001","ordinal":51589,"en":"Among the clamoring Chinese,"},{"id":"manas-2010:p1187:b001:l002","ordinal":51590,"en":"He now entered."},{"id":"manas-2010:p1187:b001:l003","ordinal":51591,"en":"At that time, the court"},{"id":"manas-2010:p1187:b001:l004","ordinal":51592,"en":"Was filled with seething Chinese."},{"id":"manas-2010:p1187:b001:l005","ordinal":51593,"en":"It was the month of the Spring Festival;"},{"id":"manas-2010:p1187:b001:l006","ordinal":51594,"en":"Almambet had chanced upon it."},{"id":"manas-2010:p1187:b001:l007","ordinal":51595,"en":"What stratagem he might find,"},{"id":"manas-2010:p1187:b001:l008","ordinal":51596,"en":"Considering then,"},{"id":"manas-2010:p1187:b001:l009","ordinal":51597,"en":"Almambet entered thoughtfully."},{"id":"manas-2010:p1187:b001:l010","ordinal":51598,"en":"Among the Chinese who wore rank stones,"},{"id":"manas-2010:p1187:b001:l011","ordinal":51599,"en":"He was a servant accustomed to being foremost."},{"id":"manas-2010:p1187:b001:l012","ordinal":51600,"en":"Stepping forward and bending,"},{"id":"manas-2010:p1187:b001:l013","ordinal":51601,"en":"Bowing like a Chinese man,"},{"id":"manas-2010:p1187:b001:l014","ordinal":51602,"en":"Babbling in another tongue,"},{"id":"manas-2010:p1187:b001:l015","ordinal":51603,"en":"Rattling away in Kalmyk,"},{"id":"manas-2010:p1187:b001:l016","ordinal":51604,"en":"Performing and offering words,"},{"id":"manas-2010:p1187:b001:l017","ordinal":51605,"en":"Speaking softly, casting them firmly,"},{"id":"manas-2010:p1187:b001:l018","ordinal":51606,"en":"The diversions of forty different peoples,"},{"id":"manas-2010:p1187:b001:l019","ordinal":51607,"en":"Relating them all alike,"},{"id":"manas-2010:p1187:b001:l020","ordinal":51608,"en":"He uttered many kinds of words."},{"id":"manas-2010:p1187:b001:l021","ordinal":51609,"en":"The Chinese who saw him shrank aside."},{"id":"manas-2010:p1187:b001:l022","ordinal":51610,"en":"Before the huge woman,"},{"id":"manas-2010:p1187:b001:l023","ordinal":51611,"en":"Almambet, Azizkan's son,"},{"id":"manas-2010:p1187:b001:l024","ordinal":51612,"en":"Entered with a gliding step."},{"id":"manas-2010:p1187:b001:l025","ordinal":51613,"en":"Poised like a darting snake,"},{"id":"manas-2010:p1187:b001:l026","ordinal":51614,"en":"His brown eyes without a speck,"},{"id":"manas-2010:p1187:b001:l027","ordinal":51615,"en":"His fair face without a freckle,"},{"id":"manas-2010:p1187:b001:l028","ordinal":51616,"en":"Almambet, Azizkan's son,"},{"id":"manas-2010:p1187:b001:l029","ordinal":51617,"en":"With his neck like a catching pole,"},{"id":"manas-2010:p1187:b001:l030","ordinal":51618,"en":"Showing his white throat,"},{"id":"manas-2010:p1187:b001:l031","ordinal":51619,"en":"Stood dancing with a sorrowful air."},{"id":"manas-2010:p1187:b001:l032","ordinal":51620,"en":"When your Alake performed,"},{"id":"manas-2010:p1187:b001:l033","ordinal":51621,"en":"The Chinese did not notice or know."},{"id":"manas-2010:p1187:b001:l034","ordinal":51622,"en":"That it was truly Almambet,"},{"id":"manas-2010:p1187:b001:l035","ordinal":51623,"en":"The foolish Chinese did not sense."},{"id":"manas-2010:p1187:b001:l036","ordinal":51624,"en":"Upon a platform made of gold,"},{"id":"manas-2010:p1187:b001:l037","ordinal":51625,"en":"The huge woman sitting there,"},{"id":"manas-2010:p1187:b001:l038","ordinal":51626,"en":"As your Alake danced,"},{"id":"manas-2010:p1187:b001:l039","ordinal":51627,"en":"Her body melting in a daze,"},{"id":"manas-2010:p1187:b001:l040","ordinal":51628,"en":"'If only I could lie embracing him,' she thought."},{"id":"manas-2010:p1187:b001:l041","ordinal":51629,"en":"Falling in love with your Alma,"},{"id":"manas-2010:p1187:b001:l042","ordinal":51630,"en":"She lost her senses in bewilderment."},{"id":"manas-2010:p1188:b001:l001","ordinal":51631,"en":"Burning and burning, yet not turning to embers,"},{"id":"manas-2010:p1188:b001:l002","ordinal":51632,"en":"Kanyshay, in her desire,"},{"id":"manas-2010:p1188:b001:l003","ordinal":51633,"en":"Held herself back with patience."},{"id":"manas-2010:p1188:b001:l004","ordinal":51634,"en":"'Upon the forty tribes of Chinese people,"},{"id":"manas-2010:p1188:b001:l005","ordinal":51635,"en":"Throughout their many lands,"},{"id":"manas-2010:p1188:b001:l006","ordinal":51636,"en":"“Each of you, forty mighty fighters,"},{"id":"manas-2010:p1188:b001:l007","ordinal":51637,"en":"Give me!”—if I imposed this levy,"},{"id":"manas-2010:p1188:b001:l008","ordinal":51638,"en":"Over that multitude of mighty fighters,"},{"id":"manas-2010:p1188:b001:l009","ordinal":51639,"en":"If I made him the leader,"},{"id":"manas-2010:p1188:b001:l010","ordinal":51640,"en":"Drawing close and becoming intimate,"},{"id":"manas-2010:p1188:b001:l011","ordinal":51641,"en":"If I lay with him in one bed,"},{"id":"manas-2010:p1188:b001:l012","ordinal":51642,"en":"To the many people at the Spring Festival,"},{"id":"manas-2010:p1188:b001:l013","ordinal":51643,"en":"Giving abundant spirits and wine,"},{"id":"manas-2010:p1188:b001:l014","ordinal":51644,"en":"Making every one of them drunk,"},{"id":"manas-2010:p1188:b001:l015","ordinal":51645,"en":"That singing water carrier,"},{"id":"manas-2010:p1188:b001:l016","ordinal":51646,"en":"If I pressed him to my breast!'"},{"id":"manas-2010:p1188:b001:l017","ordinal":51647,"en":"So thought the huge woman."},{"id":"manas-2010:p1188:b001:l018","ordinal":51648,"en":"Still more, Almambet"},{"id":"manas-2010:p1188:b001:l019","ordinal":51649,"en":"Enthralled the Chinese,"},{"id":"manas-2010:p1188:b001:l020","ordinal":51650,"en":"Their men, not merely their girls,"},{"id":"manas-2010:p1188:b001:l021","ordinal":51651,"en":"Melting their entire bodies."},{"id":"manas-2010:p1188:b001:l022","ordinal":51652,"en":"Into so many delightful melodies,"},{"id":"manas-2010:p1188:b001:l023","ordinal":51653,"en":"Almambet now launched."},{"id":"manas-2010:p1188:b001:l024","ordinal":51654,"en":"Into the jars filled with spirits,"},{"id":"manas-2010:p1188:b001:l025","ordinal":51655,"en":"Now and then Almambet,"},{"id":"manas-2010:p1188:b001:l026","ordinal":51656,"en":"The poisons he had brought ready,"},{"id":"manas-2010:p1188:b001:l027","ordinal":51657,"en":"Pretending to dance, without revealing it,"},{"id":"manas-2010:p1188:b001:l028","ordinal":51658,"en":"Without showing the countless Chinese,"},{"id":"manas-2010:p1188:b001:l029","ordinal":51659,"en":"Into the leather pails and flasks,"},{"id":"manas-2010:p1188:b001:l030","ordinal":51660,"en":"Almambet poured them."},{"id":"manas-2010:p1188:b001:l031","ordinal":51661,"en":"Kanzharkol and Muzkindik—"},{"id":"manas-2010:p1188:b001:l032","ordinal":51662,"en":"No one could offer resistance."},{"id":"manas-2010:p1188:b001:l033","ordinal":51663,"en":"Bringing the spirits,"},{"id":"manas-2010:p1188:b001:l034","ordinal":51664,"en":"Almambet offered them."},{"id":"manas-2010:p1188:b001:l035","ordinal":51665,"en":"The finest of swift runners,"},{"id":"manas-2010:p1188:b001:l036","ordinal":51666,"en":"The most skillful before the enemy,"},{"id":"manas-2010:p1188:b001:l037","ordinal":51667,"en":"He came to Muzkindik."},{"id":"manas-2010:p1188:b001:l038","ordinal":51668,"en":"Stepping up unnoticed and bowing,"},{"id":"manas-2010:p1188:b001:l039","ordinal":51669,"en":"Bending low at the waist,"},{"id":"manas-2010:p1188:b001:l040","ordinal":51670,"en":"He gave him spirits too."},{"id":"manas-2010:p1188:b001:l041","ordinal":51671,"en":"The spirits being offered,"},{"id":"manas-2010:p1188:b001:l042","ordinal":51672,"en":"Wherever they drank, they doubled over,"},{"id":"manas-2010:p1189:b001:l001","ordinal":51673,"en":"Still more lay dying."},{"id":"manas-2010:p1189:b001:l002","ordinal":51674,"en":"Foam trailed from their mouths;"},{"id":"manas-2010:p1189:b001:l003","ordinal":51675,"en":"Unable to walk, they twitched,"},{"id":"manas-2010:p1189:b001:l004","ordinal":51676,"en":"Their lives barely stirring;"},{"id":"manas-2010:p1189:b001:l005","ordinal":51677,"en":"Still more lay sprawled."},{"id":"manas-2010:p1189:b001:l006","ordinal":51678,"en":"Their vomiting would not cease;"},{"id":"manas-2010:p1189:b001:l007","ordinal":51679,"en":"Too drunk to walk,"},{"id":"manas-2010:p1189:b001:l008","ordinal":51680,"en":"Still more lay fallen."},{"id":"manas-2010:p1189:b001:l009","ordinal":51681,"en":"Their two eyes narrowing,"},{"id":"manas-2010:p1189:b001:l010","ordinal":51682,"en":"As though about to die,"},{"id":"manas-2010:p1189:b001:l011","ordinal":51683,"en":"Then glaring, staring wide,"},{"id":"manas-2010:p1189:b001:l012","ordinal":51684,"en":"Staggering back and forth,"},{"id":"manas-2010:p1189:b001:l013","ordinal":51685,"en":"Still more lay writhing."},{"id":"manas-2010:p1189:b001:l014","ordinal":51686,"en":"Not knowing what they said,"},{"id":"manas-2010:p1189:b001:l015","ordinal":51687,"en":"Seeing no one,"},{"id":"manas-2010:p1189:b001:l016","ordinal":51688,"en":"Saying whatever came to their mouths,"},{"id":"manas-2010:p1189:b001:l017","ordinal":51689,"en":"Still more were singing."},{"id":"manas-2010:p1189:b001:l018","ordinal":51690,"en":"Their words a muffled rumble,"},{"id":"manas-2010:p1189:b001:l019","ordinal":51691,"en":"They muttered to themselves;"},{"id":"manas-2010:p1189:b001:l020","ordinal":51692,"en":"Tears streaming ten ways,"},{"id":"manas-2010:p1189:b001:l021","ordinal":51693,"en":"Still more were crying."},{"id":"manas-2010:p1189:b001:l022","ordinal":51694,"en":"When she saw such things,"},{"id":"manas-2010:p1189:b001:l023","ordinal":51695,"en":"Saw and understood them all,"},{"id":"manas-2010:p1189:b001:l024","ordinal":51696,"en":"‘What has happened here?’"},{"id":"manas-2010:p1189:b001:l025","ordinal":51697,"en":"The huge woman thought."},{"id":"manas-2010:p1189:b001:l026","ordinal":51698,"en":"‘Who came tearing through this people,"},{"id":"manas-2010:p1189:b001:l027","ordinal":51699,"en":"And as soon as he arrived"},{"id":"manas-2010:p1189:b001:l028","ordinal":51700,"en":"Threw them into such turmoil?"},{"id":"manas-2010:p1189:b001:l029","ordinal":51701,"en":"The one whose encircling rope was twisted from horsehair,"},{"id":"manas-2010:p1189:b001:l030","ordinal":51702,"en":"Who had his whole part made incomplete,"},{"id":"manas-2010:p1189:b001:l031","ordinal":51703,"en":"Who went to the Burut and had it cut—"},{"id":"manas-2010:p1189:b001:l032","ordinal":51704,"en":"Azizkan's blood-drinking son,"},{"id":"manas-2010:p1189:b001:l033","ordinal":51705,"en":"Almambet must have come!"},{"id":"manas-2010:p1189:b001:l034","ordinal":51706,"en":"Relentless strife"},{"id":"manas-2010:p1189:b001:l035","ordinal":51707,"en":"He has brought upon us!"},{"id":"manas-2010:p1189:b001:l036","ordinal":51708,"en":"Every guard along the way,"},{"id":"manas-2010:p1189:b001:l037","ordinal":51709,"en":"He has killed them all alike;"},{"id":"manas-2010:p1189:b001:l038","ordinal":51710,"en":"He has come slaughtering them."},{"id":"manas-2010:p1189:b001:l039","ordinal":51711,"en":"The mountain ram and the fox,"},{"id":"manas-2010:p1189:b001:l040","ordinal":51712,"en":"The one-eyed great giant,"}]
