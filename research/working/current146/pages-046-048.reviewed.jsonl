{"id": "sayakbay-ms-current146:pdf048:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 48, "folio": 431, "line_in_page": 17, "raw": "Чабактай чордомой,", "text": "Чабактай чордомой,", "en": "Chabak, the fine champion,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The formula and epithet are uncertain; Чабак may be a personal name.", "bbox": null}
