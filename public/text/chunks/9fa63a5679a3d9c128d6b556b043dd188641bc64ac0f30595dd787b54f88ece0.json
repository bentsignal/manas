[{"id":"semetey-1-2013:p0223:b004:l032","ordinal":93953,"en":"Bring it to your father Ismail."},{"id":"semetey-1-2013:p0223:b004:l033","ordinal":93954,"en":"An unbeliever who runs wild like that,"},{"id":"semetey-1-2013:p0223:b004:l035","ordinal":93955,"en":"Do not let her near me, my child;"},{"id":"semetey-1-2013:p0223:b004:l036","ordinal":93956,"en":"Do not let me see her."},{"id":"semetey-1-2013:p0223:b004:l037","ordinal":93957,"en":"Let me tell you of your elder sister."},{"id":"semetey-1-2013:p0223:b004:l038","ordinal":93958,"en":"Your brother-in-law Manas was a hero,"},{"id":"semetey-1-2013:p0223:b004:l039","ordinal":93959,"en":"Born from the whole wide world,"},{"id":"semetey-1-2013:p0224:b003:l001","ordinal":93960,"en":"He was a lion who had emerged."},{"id":"semetey-1-2013:p0224:b003:l002","ordinal":93961,"en":"When he scattered the unbelievers' wealth,"},{"id":"semetey-1-2013:p0224:b003:l003","ordinal":93962,"en":"When he opened the way for Islam,"},{"id":"semetey-1-2013:p0224:b003:l004","ordinal":93963,"en":"Looming Great Beijing—"},{"id":"semetey-1-2013:p0224:b003:l005","ordinal":93964,"en":"When he entered straight and thrust his spear,"},{"id":"semetey-1-2013:p0224:b003:l006","ordinal":93965,"en":"When the grim-faced Chinese and many Manchus"},{"id":"semetey-1-2013:p0224:b003:l007","ordinal":93966,"en":"Were slaughtered without one left,"},{"id":"semetey-1-2013:p0224:b003:l008","ordinal":93967,"en":"When he campaigned against Kakancha"},{"id":"semetey-1-2013:p0224:b003:l009","ordinal":93968,"en":"And fought a mighty battle,"},{"id":"semetey-1-2013:p0224:b003:l010","ordinal":93969,"en":"Twelve khans' peoples went,"},{"id":"semetey-1-2013:p0224:b003:l011","ordinal":93970,"en":"Twelve myriad troops went,"},{"id":"semetey-1-2013:p0224:b003:l012","ordinal":93971,"en":"My father Temir Khan"},{"id":"semetey-1-2013:p0224:b003:l013","ordinal":93972,"en":"Went leading the army."},{"id":"semetey-1-2013:p0224:b003:l014","ordinal":93973,"en":"The two khans Egizey and Shooruk"},{"id":"semetey-1-2013:p0224:b003:l015","ordinal":93974,"en":"Went to wage holy war,"},{"id":"semetey-1-2013:p0224:b003:l016","ordinal":93975,"en":"My golden crown Muzburchak,"},{"id":"semetey-1-2013:p0224:b003:l017","ordinal":93976,"en":"Khan Kokcho of the Kazakhs,"},{"id":"semetey-1-2013:p0224:b003:l018","ordinal":93977,"en":"Zhamgyrchy of the Eshteks,"},{"id":"semetey-1-2013:p0224:b003:l019","ordinal":93978,"en":"The warrior Toshtuk, Eleman's son,"},{"id":"semetey-1-2013:p0224:b003:l020","ordinal":93979,"en":"Khan Koshoi of the Katagans,"},{"id":"semetey-1-2013:p0224:b003:l021","ordinal":93980,"en":"The warrior Shygai of the Zhedigers,"},{"id":"semetey-1-2013:p0224:b003:l022","ordinal":93981,"en":"The warrior Urbu, Eybit Khan's son,"},{"id":"semetey-1-2013:p0224:b003:l023","ordinal":93982,"en":"Bokmurun, Kokotoy's son,"},{"id":"semetey-1-2013:p0224:b003:l024","ordinal":93983,"en":"The fierce warriors and the old men—"},{"id":"semetey-1-2013:p0224:b003:l025","ordinal":93984,"en":"Who was left who had not seen it?"},{"id":"semetey-1-2013:p0224:b003:l026","ordinal":93985,"en":"The Sarts' four khans and their peoples"},{"id":"semetey-1-2013:p0224:b003:l027","ordinal":93986,"en":"Were all there then."},{"id":"semetey-1-2013:p0224:b003:l028","ordinal":93987,"en":"There were great men bearing maces,"},{"id":"semetey-1-2013:p0224:b003:l029","ordinal":93988,"en":"Many mighty champions together,"},{"id":"semetey-1-2013:p0224:b003:l030","ordinal":93989,"en":"The renowned elder Koshoi,"},{"id":"semetey-1-2013:p0224:b003:l031","ordinal":93990,"en":"All twelve great champions."},{"id":"semetey-1-2013:p0224:b003:l032","ordinal":93991,"en":"There were heroes and men of skill,"},{"id":"semetey-1-2013:p0224:b003:l033","ordinal":93992,"en":"Men greater than many champions."},{"id":"semetey-1-2013:p0224:b003:l034","ordinal":93993,"en":"Your brother-in-law Manas Khan"},{"id":"semetey-1-2013:p0224:b003:l035","ordinal":93994,"en":"Had settled in the land of Talas."},{"id":"semetey-1-2013:p0224:b003:l036","ordinal":93995,"en":"That handful of the Islamic faithful,"},{"id":"semetey-1-2013:p0224:b003:l037","ordinal":93996,"en":"To Kakanchyn's Beijing"},{"id":"semetey-1-2013:p0224:b003:l038","ordinal":93997,"en":"He drove them under escort."},{"id":"semetey-1-2013:p0224:b003:l039","ordinal":93998,"en":"Whoever placed him in the lead had luck:"},{"id":"semetey-1-2013:p0224:b004:l001","ordinal":93999,"en":"The resourceful elder Bakai was there."},{"id":"semetey-1-2013:p0224:b004:l002","ordinal":94000,"en":"Knowing sixty kinds of languages,"},{"id":"semetey-1-2013:p0224:b004:l003","ordinal":94001,"en":"The world's eloquent speaker,"},{"id":"semetey-1-2013:p0224:b004:l004","ordinal":94002,"en":"Azhybai, son of Argyn Khan,"},{"id":"semetey-1-2013:p0224:b004:l005","ordinal":94003,"en":"And the warrior Akzholtoi was there."},{"id":"semetey-1-2013:p0224:b004:l006","ordinal":94004,"en":"With your brother-in-law blessed by Khydyr,"},{"id":"semetey-1-2013:p0224:b004:l007","ordinal":94005,"en":"All the mighty men were gathered."},{"id":"semetey-1-2013:p0224:b004:l008","ordinal":94006,"en":"The Creator granted him honor;"},{"id":"semetey-1-2013:p0224:b004:l009","ordinal":94007,"en":"Such was your brother-in-law,"},{"id":"semetey-1-2013:p0224:b004:l010","ordinal":94008,"en":"Blessed by God with fortune."},{"id":"semetey-1-2013:p0224:b004:l011","ordinal":94009,"en":"Men skilled at swordplay were there,"},{"id":"semetey-1-2013:p0224:b004:l012","ordinal":94010,"en":"A great holy war that shattered multitudes,"},{"id":"semetey-1-2013:p0224:b004:l013","ordinal":94011,"en":"So many outstanding men were there."},{"id":"semetey-1-2013:p0224:b004:l014","ordinal":94012,"en":"There was a Buraq to ride in the rear,"},{"id":"semetey-1-2013:p0224:b004:l015","ordinal":94013,"en":"And not a hair less than Manas,"},{"id":"semetey-1-2013:p0224:b004:l016","ordinal":94014,"en":"Chubak, Akbaltai Khan's son, was there."},{"id":"semetey-1-2013:p0224:b004:l017","ordinal":94015,"en":"I carried on the ancient telling,"},{"id":"semetey-1-2013:p0224:b004:l018","ordinal":94016,"en":"I asked the knowledgeable men:"},{"id":"semetey-1-2013:p0224:b004:l019","ordinal":94017,"en":"Beyond the far side of Kashgar"},{"id":"semetey-1-2013:p0224:b004:l020","ordinal":94018,"en":"Was a land called Alai."},{"id":"semetey-1-2013:p0224:b004:l021","ordinal":94019,"en":"Settled in Alai"},{"id":"semetey-1-2013:p0224:b004:l022","ordinal":94020,"en":"Was a people named Oigut."},{"id":"semetey-1-2013:p0224:b004:l023","ordinal":94021,"en":"Of the dear Kyrgyz people of forty tribes,"},{"id":"semetey-1-2013:p0224:b004:l024","ordinal":94022,"en":"They were one of the precious branches."},{"id":"semetey-1-2013:p0224:b004:l025","ordinal":94023,"en":"Akbaltai, khan of the Oigut,"},{"id":"semetey-1-2013:p0224:b004:l026","ordinal":94024,"en":"Was a blessed khan."},{"id":"semetey-1-2013:p0224:b004:l027","ordinal":94025,"en":"In Akbaltai's household,"},{"id":"semetey-1-2013:p0224:b004:l028","ordinal":94026,"en":"For the sake of a single child,"},{"id":"semetey-1-2013:p0224:b004:l029","ordinal":94027,"en":"There were sixty wives."},{"id":"semetey-1-2013:p0224:b004:l030","ordinal":94028,"en":"His father Akbaltai"},{"id":"semetey-1-2013:p0224:b004:l031","ordinal":94029,"en":"Had taken sixty wives,"},{"id":"semetey-1-2013:p0224:b004:l032","ordinal":94030,"en":"Yet yearned for a single child,"},{"id":"semetey-1-2013:p0224:b004:l033","ordinal":94031,"en":"Left without an heir."},{"id":"semetey-1-2013:p0224:b004:l034","ordinal":94032,"en":"In his old age Akbaltai,"},{"id":"semetey-1-2013:p0224:b004:l035","ordinal":94033,"en":"For the sake of one offspring,"},{"id":"semetey-1-2013:p0224:b004:l036","ordinal":94034,"en":"Journeyed everywhere,"},{"id":"semetey-1-2013:p0224:b004:l037","ordinal":94035,"en":"Visiting every sacred tomb on earth,"},{"id":"semetey-1-2013:p0224:b004:l038","ordinal":94036,"en":"Leaving not a single one unseen,"},{"id":"semetey-1-2013:p0224:b004:l039","ordinal":94037,"en":"Giving horses to those without,"},{"id":"semetey-1-2013:p0225:b003:l001","ordinal":94038,"en":"Sparing none of his livestock,"},{"id":"semetey-1-2013:p0225:b003:l002","ordinal":94039,"en":"Akbaltai in those days"},{"id":"semetey-1-2013:p0225:b003:l003","ordinal":94040,"en":"Readily gave alms,"},{"id":"semetey-1-2013:p0225:b003:l004","ordinal":94041,"en":"Wandered in search of offspring,"},{"id":"semetey-1-2013:p0225:b003:l005","ordinal":94042,"en":"And implored the one God."},{"id":"semetey-1-2013:p0225:b003:l006","ordinal":94043,"en":"When God granted his wish,"},{"id":"semetey-1-2013:p0225:b003:l007","ordinal":94044,"en":"His father Akbaltai"},{"id":"semetey-1-2013:p0225:b003:l008","ordinal":94045,"en":"Had reached the age of seventy."},{"id":"semetey-1-2013:p0225:b003:l009","ordinal":94046,"en":"When the people moved to higher pastures,"},{"id":"semetey-1-2013:p0225:b003:l010","ordinal":94047,"en":"In summer, when horses' tongues turn black,"},{"id":"semetey-1-2013:p0225:b003:l011","ordinal":94048,"en":"Upon the ridge of Maseyil,"},{"id":"semetey-1-2013:p0225:b003:l012","ordinal":94049,"en":"On the nearer side of Bukhara,"},{"id":"semetey-1-2013:p0225:b003:l013","ordinal":94050,"en":"He would slaughter sixty beasts."},{"id":"semetey-1-2013:p0225:b003:l014","ordinal":94051,"en":"Wrapped in white felt,"},{"id":"semetey-1-2013:p0225:b003:l015","ordinal":94052,"en":"Chubak was the child he found."},{"id":"semetey-1-2013:p0225:b003:l016","ordinal":94053,"en":"He slaughtered ninety for the feast."},{"id":"semetey-1-2013:p0225:b003:l017","ordinal":94054,"en":"Having found him, Akbaltai"},{"id":"semetey-1-2013:p0225:b003:l018","ordinal":94055,"en":"Gave him the name of Chubak."},{"id":"semetey-1-2013:p0225:b003:l019","ordinal":94056,"en":"Saying, 'Such-and-such a wife bore him,'"},{"id":"semetey-1-2013:p0225:b003:l020","ordinal":94057,"en":"He drove all sorrow from his heart."},{"id":"semetey-1-2013:p0225:b003:l022","ordinal":94058,"en":"Before Chubak reached six,"},{"id":"semetey-1-2013:p0225:b003:l023","ordinal":94059,"en":"He spent his four kinds of livestock,"},{"id":"semetey-1-2013:p0225:b003:l024","ordinal":94060,"en":"Fervently begging Allah alone"},{"id":"semetey-1-2013:p0225:b003:l025","ordinal":94061,"en":"To make his life secure."},{"id":"semetey-1-2013:p0225:b003:l026","ordinal":94062,"en":"When he reached seven years,"},{"id":"semetey-1-2013:p0225:b003:l027","ordinal":94063,"en":"He saw he was a lion."},{"id":"semetey-1-2013:p0225:b003:l028","ordinal":94064,"en":"Khoja and mullah took command,"},{"id":"semetey-1-2013:p0225:b003:l029","ordinal":94065,"en":"To Egypt and Baghdad"},{"id":"semetey-1-2013:p0225:b003:l030","ordinal":94066,"en":"He entrusted him to a mullah."},{"id":"semetey-1-2013:p0225:b003:l031","ordinal":94067,"en":"By the time he reached eleven,"},{"id":"semetey-1-2013:p0225:b003:l032","ordinal":94068,"en":"He had studied learning with the mullah"},{"id":"semetey-1-2013:p0225:b003:l033","ordinal":94069,"en":"And received a written document from Kankozho."},{"id":"semetey-1-2013:p0225:b003:l034","ordinal":94070,"en":"When he reached twelve years,"},{"id":"semetey-1-2013:p0225:b003:l035","ordinal":94071,"en":"He took the caliph's blessing."},{"id":"semetey-1-2013:p0225:b003:l036","ordinal":94072,"en":"Thus the warrior Chubak"},{"id":"semetey-1-2013:p0225:b003:l037","ordinal":94073,"en":"Was named the mighty conquering champion."},{"id":"semetey-1-2013:p0225:b003:l038","ordinal":94074,"en":"He trotted like a lion"},{"id":"semetey-1-2013:p0225:b003:l039","ordinal":94075,"en":"And to his father Baltai's village"},{"id":"semetey-1-2013:p0225:b005:l001","ordinal":94076,"en":"He came at only twelve."},{"id":"semetey-1-2013:p0225:b005:l002","ordinal":94077,"en":"His father's countless dark herds,"},{"id":"semetey-1-2013:p0225:b005:l003","ordinal":94078,"en":"The long-tailed horses,"},{"id":"semetey-1-2013:p0225:b005:l004","ordinal":94079,"en":"He had led past in a file."},{"id":"semetey-1-2013:p0225:b005:l005","ordinal":94080,"en":"To the fierce lord Chubak,"},{"id":"semetey-1-2013:p0225:b005:l006","ordinal":94081,"en":"Of all the round-hoofed horses"},{"id":"semetey-1-2013:p0225:b005:l007","ordinal":94082,"en":"Not a single one appealed."},{"id":"semetey-1-2013:p0225:b005:l008","ordinal":94083,"en":"At that time your Chubak"},{"id":"semetey-1-2013:p0225:b005:l009","ordinal":94084,"en":"Saw a vision in his sleep,"},{"id":"semetey-1-2013:p0225:b005:l010","ordinal":94085,"en":"Dreamed a wondrous, happy dream."},{"id":"semetey-1-2013:p0225:b005:l011","ordinal":94086,"en":"Startled awake from sleep,"},{"id":"semetey-1-2013:p0225:b005:l012","ordinal":94087,"en":"Stirring like a lion,"},{"id":"semetey-1-2013:p0225:b005:l013","ordinal":94088,"en":"At the hour of midnight"},{"id":"semetey-1-2013:p0225:b005:l014","ordinal":94089,"en":"He set off in a frenzy."},{"id":"semetey-1-2013:p0225:b005:l015","ordinal":94090,"en":"When the dawn shone clear,"},{"id":"semetey-1-2013:p0225:b005:l016","ordinal":94091,"en":"In the desert of Mediyan,"},{"id":"semetey-1-2013:p0225:b005:l017","ordinal":94092,"en":"At spear-high Kara-Kum,"},{"id":"semetey-1-2013:p0225:b005:l018","ordinal":94093,"en":"Where he lay exhausted,"},{"id":"semetey-1-2013:p0225:b005:l019","ordinal":94094,"en":"Kokala, whom he would ride,"},{"id":"semetey-1-2013:p0225:b005:l020","ordinal":94095,"en":"Was just entering his fifth year."},{"id":"semetey-1-2013:p0225:b005:l021","ordinal":94096,"en":"At that time Kokala"},{"id":"semetey-1-2013:p0225:b005:l022","ordinal":94097,"en":"Was indeed in his fifth year."},{"id":"semetey-1-2013:p0225:b005:l023","ordinal":94098,"en":"Born of Kulan-Sur,"},{"id":"semetey-1-2013:p0225:b005:l024","ordinal":94099,"en":"He was a fully gifted steed."},{"id":"semetey-1-2013:p0225:b005:l025","ordinal":94100,"en":"The red-bearded elder Kayyp"},{"id":"semetey-1-2013:p0225:b005:l026","ordinal":94101,"en":"From the desert of Mediyan"},{"id":"semetey-1-2013:p0225:b005:l027","ordinal":94102,"en":"Had led him on a tether."},{"id":"semetey-1-2013:p0225:b005:l028","ordinal":94103,"en":"Before your champion Chubak"},{"id":"semetey-1-2013:p0225:b005:l029","ordinal":94104,"en":"He had brought the horse."},{"id":"semetey-1-2013:p0225:b005:l030","ordinal":94105,"en":"When he wore a blue reps coat,"},{"id":"semetey-1-2013:p0225:b005:l031","ordinal":94106,"en":"When your Chubak rode Kokala,"},{"id":"semetey-1-2013:p0225:b005:l032","ordinal":94107,"en":"Hearing of his awesome spirit,"},{"id":"semetey-1-2013:p0225:b005:l033","ordinal":94108,"en":"Far-off enemies grieved."},{"id":"semetey-1-2013:p0225:b005:l034","ordinal":94109,"en":"'The few Muslims,"},{"id":"semetey-1-2013:p0225:b005:l035","ordinal":94110,"en":"If he wishes, he will bring under his rule,'"},{"id":"semetey-1-2013:p0225:b005:l036","ordinal":94111,"en":"His father Baltai said with joy."},{"id":"semetey-1-2013:p0225:b005:l037","ordinal":94112,"en":"When he reached twelve years,"},{"id":"semetey-1-2013:p0225:b005:l038","ordinal":94113,"en":"He stirred strife in so many lands,"},{"id":"semetey-1-2013:p0225:b005:l039","ordinal":94114,"en":"That lion Chubak, the fearless one—"},{"id":"semetey-1-2013:p0226:b003:l001","ordinal":94115,"en":"More than that, he besieged Kashgar and took it six times."},{"id":"semetey-1-2013:p0226:b003:l003","ordinal":94116,"en":"When he reached thirteen years,"},{"id":"semetey-1-2013:p0226:b003:l004","ordinal":94117,"en":"He besieged the Afghans and took them ten times."},{"id":"semetey-1-2013:p0226:b003:l005","ordinal":94118,"en":"Wading in blood, he grew hardened,"},{"id":"semetey-1-2013:p0226:b003:l006","ordinal":94119,"en":"Won the name of Chubak the Leopard."},{"id":"semetey-1-2013:p0226:b003:l007","ordinal":94120,"en":"When he reached sixteen,"},{"id":"semetey-1-2013:p0226:b003:l008","ordinal":94121,"en":"He was called Chubak the Destroyer."},{"id":"semetey-1-2013:p0226:b003:l009","ordinal":94122,"en":"The red steel bent"},{"id":"semetey-1-2013:p0226:b003:l010","ordinal":94123,"en":"As with your Khydyr-blessed warrior brother-in-law"},{"id":"semetey-1-2013:p0226:b003:l011","ordinal":94124,"en":"He jousted forty-eight days."},{"id":"semetey-1-2013:p0226:b003:l012","ordinal":94125,"en":"Recognizing his fortune,"},{"id":"semetey-1-2013:p0226:b003:l013","ordinal":94126,"en":"A star stirred in the sky;"},{"id":"semetey-1-2013:p0226:b003:l014","ordinal":94127,"en":"They became friends for the next world,"},{"id":"semetey-1-2013:p0226:b003:l015","ordinal":94128,"en":"And he made his home in Talas,"},{"id":"semetey-1-2013:p0226:b003:l016","ordinal":94129,"en":"Became a companion of Manas."},{"id":"semetey-1-2013:p0226:b003:l017","ordinal":94130,"en":"To the fortunate warrior Manas"},{"id":"semetey-1-2013:p0226:b003:l018","ordinal":94131,"en":"Came men who were his equals:"},{"id":"semetey-1-2013:p0226:b003:l019","ordinal":94132,"en":"Forty-two warriors, forty companions,"},{"id":"semetey-1-2013:p0226:b003:l020","ordinal":94133,"en":"Every one apart from other men,"},{"id":"semetey-1-2013:p0226:b003:l021","ordinal":94134,"en":"Fearless champions who could wreck the world,"},{"id":"semetey-1-2013:p0226:b003:l022","ordinal":94135,"en":"Forty-two equal lions came."},{"id":"semetey-1-2013:p0226:b003:l023","ordinal":94136,"en":"Such is the tale of Chubak."},{"id":"semetey-1-2013:p0226:b003:l024","ordinal":94137,"en":"Let me leave that here"},{"id":"semetey-1-2013:p0226:b003:l025","ordinal":94138,"en":"And of Azyz Khan's Almambet"},{"id":"semetey-1-2013:p0226:b003:l026","ordinal":94139,"en":"Begin to tell the news."},{"id":"semetey-1-2013:p0226:b003:l027","ordinal":94140,"en":"With golden forelock and tasseled belt,"},{"id":"semetey-1-2013:p0226:b003:l028","ordinal":94141,"en":"Azyz Khan's only son"},{"id":"semetey-1-2013:p0226:b003:l029","ordinal":94142,"en":"Was a mighty khan in Kakan."},{"id":"semetey-1-2013:p0226:b003:l030","ordinal":94143,"en":"He too was a blessed soul."},{"id":"semetey-1-2013:p0226:b003:l031","ordinal":94144,"en":"Your Alake was conceived of light,"},{"id":"semetey-1-2013:p0226:b003:l032","ordinal":94145,"en":"Himself the son of light,"},{"id":"semetey-1-2013:p0226:b003:l033","ordinal":94146,"en":"Almambet, that blessed soul."},{"id":"semetey-1-2013:p0226:b003:l034","ordinal":94147,"en":"His father, the Chinese Azyz Khan,"},{"id":"semetey-1-2013:p0226:b003:l035","ordinal":94148,"en":"Said, 'I have seen Almambet,'"},{"id":"semetey-1-2013:p0226:b003:l036","ordinal":94149,"en":"And swept the grime from his heart."},{"id":"semetey-1-2013:p0226:b003:l037","ordinal":94150,"en":"The forty tribes of Chinese-Kakan folk"},{"id":"semetey-1-2013:p0226:b003:l038","ordinal":94151,"en":"Struggled, unable to name him,"},{"id":"semetey-1-2013:p0226:b003:l039","ordinal":94152,"en":"And were sorely troubled."},{"id":"semetey-1-2013:p0226:b004:l001","ordinal":94153,"en":"At about noon there arrived"},{"id":"semetey-1-2013:p0226:b004:l002","ordinal":94154,"en":"The white-bearded dervish Khydyr."},{"id":"semetey-1-2013:p0226:b004:l003","ordinal":94155,"en":"He banished all their sorrow,"},{"id":"semetey-1-2013:p0226:b004:l004","ordinal":94156,"en":"Named him Khan Almambet."},{"id":"semetey-1-2013:p0226:b004:l005","ordinal":94157,"en":"Receiving the elder's blessing,"},{"id":"semetey-1-2013:p0226:b004:l006","ordinal":94158,"en":"He was given the name Almambet."},{"id":"semetey-1-2013:p0226:b004:l007","ordinal":94159,"en":"When that fierce warrior was born,"},{"id":"semetey-1-2013:p0226:b004:l008","ordinal":94160,"en":"The tips of his ears were pierced."},{"id":"semetey-1-2013:p0226:b004:l009","ordinal":94161,"en":"He had come out of the womb"},{"id":"semetey-1-2013:p0226:b004:l010","ordinal":94162,"en":"With his foreskin already cut."},{"id":"semetey-1-2013:p0226:b004:l011","ordinal":94163,"en":"His forehead reached the earth."},{"id":"semetey-1-2013:p0226:b004:l012","ordinal":94164,"en":"For eighty days waters flowed"},{"id":"semetey-1-2013:p0226:b004:l013","ordinal":94165,"en":"And earthquakes shook the ground."},{"id":"semetey-1-2013:p0226:b004:l014","ordinal":94166,"en":"When the Chinese diviner"},{"id":"semetey-1-2013:p0226:b004:l015","ordinal":94167,"en":"Would seize and torment him,"},{"id":"semetey-1-2013:p0226:b004:l016","ordinal":94168,"en":"Would cast him in a pit forty cubits deep,"},{"id":"semetey-1-2013:p0226:b004:l017","ordinal":94169,"en":"An amulet was hung about his neck"},{"id":"semetey-1-2013:p0226:b004:l018","ordinal":94170,"en":"And his maternal grandfather Sooronduk Khan was made to raise him."},{"id":"semetey-1-2013:p0226:b004:l019","ordinal":94171,"en":"He grew up in Sooronduk's land,"},{"id":"semetey-1-2013:p0226:b004:l020","ordinal":94172,"en":"Saw a holy man in his dream,"},{"id":"semetey-1-2013:p0226:b004:l021","ordinal":94173,"en":"Saw both Paradise and Hell."},{"id":"semetey-1-2013:p0226:b004:l022","ordinal":94174,"en":"Through his valor, the warrior Alman"},{"id":"semetey-1-2013:p0226:b004:l023","ordinal":94175,"en":"Studied wonders and grew inspired."},{"id":"semetey-1-2013:p0226:b004:l024","ordinal":94176,"en":"In his youth he found Sarala,"},{"id":"semetey-1-2013:p0226:b004:l025","ordinal":94177,"en":"Born of a wild ass."},{"id":"semetey-1-2013:p0226:b004:l026","ordinal":94178,"en":"When he reached twelve years,"},{"id":"semetey-1-2013:p0226:b004:l027","ordinal":94179,"en":"Konurbai, Alooke's son—"},{"id":"semetey-1-2013:p0226:b004:l028","ordinal":94180,"en":"He laid siege to Konurbai."},{"id":"semetey-1-2013:p0226:b004:l029","ordinal":94181,"en":"Everyone except Karykan"},{"id":"semetey-1-2013:p0226:b004:l030","ordinal":94182,"en":"He smashed to pieces,"},{"id":"semetey-1-2013:p0226:b004:l031","ordinal":94183,"en":"Your Alman beat them utterly."},{"id":"semetey-1-2013:p0226:b004:l032","ordinal":94184,"en":"The Manchu warrior Esen Khan"},{"id":"semetey-1-2013:p0226:b004:l033","ordinal":94185,"en":"He besieged for twenty-four days."},{"id":"semetey-1-2013:p0226:b004:l034","ordinal":94186,"en":"Great Beijing was left helpless,"},{"id":"semetey-1-2013:p0226:b004:l035","ordinal":94187,"en":"Placed a golden crown upon him,"},{"id":"semetey-1-2013:p0226:b004:l036","ordinal":94188,"en":"Upon Karykan's golden throne"},{"id":"semetey-1-2013:p0226:b004:l037","ordinal":94189,"en":"They seated him without restraint."},{"id":"semetey-1-2013:p0226:b004:l038","ordinal":94190,"en":"He too, in Kakan's Beijing,"},{"id":"semetey-1-2013:p0226:b004:l039","ordinal":94191,"en":"Became a man of sacred might."},{"id":"semetey-1-2013:p0227:b003:l001","ordinal":94192,"en":"Indeed, in Kakan's Beijing"},{"id":"semetey-1-2013:p0227:b003:l002","ordinal":94193,"en":"He was khan for twenty-four months."},{"id":"semetey-1-2013:p0227:b003:l003","ordinal":94194,"en":"While he ruled as Kakan khan,"},{"id":"semetey-1-2013:p0227:b003:l004","ordinal":94195,"en":"When he served his God,"},{"id":"semetey-1-2013:p0227:b003:l005","ordinal":94196,"en":"His gathered wealth was left in Kakan;"},{"id":"semetey-1-2013:p0227:b003:l006","ordinal":94197,"en":"What he desired was faith."},{"id":"semetey-1-2013:p0227:b003:l007","ordinal":94198,"en":"His gathered wealth was left in Beijing;"},{"id":"semetey-1-2013:p0227:b003:l008","ordinal":94199,"en":"What he cherished was faith."},{"id":"semetey-1-2013:p0227:b003:l009","ordinal":94200,"en":"Casting away his golden throne,"},{"id":"semetey-1-2013:p0227:b003:l010","ordinal":94201,"en":"Saying, 'He will not enter Islam,'"},{"id":"semetey-1-2013:p0227:b003:l011","ordinal":94202,"en":"He killed his father Azyz Khan."},{"id":"semetey-1-2013:p0227:b003:l012","ordinal":94203,"en":"Cleansed of the dark religion,"},{"id":"semetey-1-2013:p0227:b003:l013","ordinal":94204,"en":"Fleeing the unbelievers, estranged from them,"},{"id":"semetey-1-2013:p0227:b003:l014","ordinal":94205,"en":"He came and settled in Talas."},{"id":"semetey-1-2013:p0227:b003:l015","ordinal":94206,"en":"He too became a companion of Manas."},{"id":"semetey-1-2013:p0227:b003:l016","ordinal":94207,"en":"When they campaigned against Kakan,"},{"id":"semetey-1-2013:p0227:b003:l017","ordinal":94208,"en":"When they wrought devastation,"}]
