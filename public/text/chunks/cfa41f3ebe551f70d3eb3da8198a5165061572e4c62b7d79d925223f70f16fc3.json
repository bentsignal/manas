[{"id":"semetey-1-2013:p1062:b003:l005","ordinal":157185,"en":"Poor Chürök from the infidels."},{"id":"semetey-1-2013:p1062:b003:l006","ordinal":157186,"en":"Keeping the hero's condition unknown,"},{"id":"semetey-1-2013:p1062:b003:l007","ordinal":157187,"en":"She had become absorbed in diversion;"},{"id":"semetey-1-2013:p1062:b003:l008","ordinal":157188,"en":"For many days on end"},{"id":"semetey-1-2013:p1062:b003:l009","ordinal":157189,"en":"She had lain beside Semetey."},{"id":"semetey-1-2013:p1062:b003:l010","ordinal":157190,"en":"Azhybay and Tümönbay"},{"id":"semetey-1-2013:p1062:b003:l011","ordinal":157191,"en":"Had learned of the one between them."},{"id":"semetey-1-2013:p1062:b003:l012","ordinal":157192,"en":"Wondering, \"How will those two come?\""},{"id":"semetey-1-2013:p1062:b003:l013","ordinal":157193,"en":"She had gone into her bed."},{"id":"semetey-1-2013:p1062:b003:l014","ordinal":157194,"en":"The doomed woman, who for many days"},{"id":"semetey-1-2013:p1062:b003:l015","ordinal":157195,"en":"And many nights had not slept,"},{"id":"semetey-1-2013:p1062:b003:l016","ordinal":157196,"en":"Had sunk into pleasure;"},{"id":"semetey-1-2013:p1062:b003:l017","ordinal":157197,"en":"When those two arrived,"},{"id":"semetey-1-2013:p1062:b003:l018","ordinal":157198,"en":"She lay sleeping without stirring."},{"id":"semetey-1-2013:p1062:b003:l019","ordinal":157199,"en":"At Aychürök's house,"},{"id":"semetey-1-2013:p1062:b003:l020","ordinal":157200,"en":"By her door, the gatekeeper"},{"id":"semetey-1-2013:p1062:b003:l021","ordinal":157201,"en":"Began a conversation;"},{"id":"semetey-1-2013:p1062:b003:l022","ordinal":157202,"en":"They asked the gatekeeper:"},{"id":"semetey-1-2013:p1062:b003:l023","ordinal":157203,"en":"\"Aychürök, daughter of Akun—"},{"id":"semetey-1-2013:p1062:b003:l024","ordinal":157204,"en":"Is Chürök in the house?"},{"id":"semetey-1-2013:p1062:b003:l025","ordinal":157205,"en":"The turmoil that stirred the whole world—"},{"id":"semetey-1-2013:p1062:b003:l026","ordinal":157206,"en":"Is that trouble in the house?\""},{"id":"semetey-1-2013:p1062:b003:l027","ordinal":157207,"en":"If you ask how Chürök fared,"},{"id":"semetey-1-2013:p1062:b003:l028","ordinal":157208,"en":"She woke with a start from sleep,"},{"id":"semetey-1-2013:p1062:b003:l029","ordinal":157209,"en":"And rolled onto her right side;"},{"id":"semetey-1-2013:p1062:b003:l030","ordinal":157210,"en":"Her excited heart grew calm,"},{"id":"semetey-1-2013:p1062:b003:l031","ordinal":157211,"en":"Her eyes opened wide as bowls,"},{"id":"semetey-1-2013:p1062:b003:l032","ordinal":157212,"en":"And Aychürök sprang up."},{"id":"semetey-1-2013:p1062:b003:l033","ordinal":157213,"en":"From outside the door came a shout:"},{"id":"semetey-1-2013:p1062:b003:l034","ordinal":157214,"en":"Azhybay and Tümönbay"},{"id":"semetey-1-2013:p1062:b003:l035","ordinal":157215,"en":"Were calling out for Aychürök."},{"id":"semetey-1-2013:p1062:b003:l036","ordinal":157216,"en":"Aychürök, daughter of Akun,"},{"id":"semetey-1-2013:p1062:b003:l037","ordinal":157217,"en":"Rose thoughtfully, drawing out her thoughts,"},{"id":"semetey-1-2013:p1062:b003:l038","ordinal":157218,"en":"Stretching tall like a young plane tree,"},{"id":"semetey-1-2013:p1062:b003:l039","ordinal":157219,"en":"Arching herself like a lynx,"},{"id":"semetey-1-2013:p1062:b004:l001","ordinal":157220,"en":"Reluctant to utter a word,"},{"id":"semetey-1-2013:p1062:b004:l002","ordinal":157221,"en":"Maturing in beauty like a doe,"},{"id":"semetey-1-2013:p1062:b004:l003","ordinal":157222,"en":"Her hair winding around her head,"},{"id":"semetey-1-2013:p1062:b004:l004","ordinal":157223,"en":"Maturing in beauty like a deer,"},{"id":"semetey-1-2013:p1062:b004:l005","ordinal":157224,"en":"Her hair winding around her feet."},{"id":"semetey-1-2013:p1062:b004:l006","ordinal":157225,"en":"Radiant Aychürök"},{"id":"semetey-1-2013:p1062:b004:l007","ordinal":157226,"en":"Turned and came out through the door."},{"id":"semetey-1-2013:p1062:b004:l008","ordinal":157227,"en":"\"I have a grave already dug;"},{"id":"semetey-1-2013:p1062:b004:l009","ordinal":157228,"en":"My dear Aychürök,"},{"id":"semetey-1-2013:p1062:b004:l010","ordinal":157229,"en":"I have boiling misery."},{"id":"semetey-1-2013:p1062:b004:l011","ordinal":157230,"en":"Toltoy of the Zhediger"},{"id":"semetey-1-2013:p1062:b004:l012","ordinal":157231,"en":"And his consummate hero Kozho"},{"id":"semetey-1-2013:p1062:b004:l013","ordinal":157232,"en":"Have descended upon our heads;"},{"id":"semetey-1-2013:p1062:b004:l014","ordinal":157233,"en":"They have scattered all our livestock."},{"id":"semetey-1-2013:p1062:b004:l015","ordinal":157234,"en":"Unless we give you as a tribute,"},{"id":"semetey-1-2013:p1062:b004:l016","ordinal":157235,"en":"They will level the deepest fortress"},{"id":"semetey-1-2013:p1062:b004:l017","ordinal":157236,"en":"And slaughter every one of us."},{"id":"semetey-1-2013:p1062:b004:l018","ordinal":157237,"en":"He has seized and plundered the people;"},{"id":"semetey-1-2013:p1062:b004:l019","ordinal":157238,"en":"If we do not give you first,"},{"id":"semetey-1-2013:p1062:b004:l020","ordinal":157239,"en":"A force as great as the Zhediger will come,"},{"id":"semetey-1-2013:p1062:b004:l021","ordinal":157240,"en":"So numerous the earth will sag."},{"id":"semetey-1-2013:p1062:b004:l022","ordinal":157241,"en":"My dear Chürökbay,"},{"id":"semetey-1-2013:p1062:b004:l023","ordinal":157242,"en":"If you heed our words,"},{"id":"semetey-1-2013:p1062:b004:l024","ordinal":157243,"en":"He too is a father's son;"},{"id":"semetey-1-2013:p1062:b004:l025","ordinal":157244,"en":"Go to brave Toltoy."},{"id":"semetey-1-2013:p1062:b004:l026","ordinal":157245,"en":"If you go to Toltoy and die,"},{"id":"semetey-1-2013:p1062:b004:l027","ordinal":157246,"en":"We shall see your bones;"},{"id":"semetey-1-2013:p1062:b004:l028","ordinal":157247,"en":"Saying, 'She became her people's shield,'"},{"id":"semetey-1-2013:p1062:b004:l029","ordinal":157248,"en":"We shall have a tomb of gold built"},{"id":"semetey-1-2013:p1062:b004:l030","ordinal":157249,"en":"And bury you exactly so."},{"id":"semetey-1-2013:p1062:b004:l031","ordinal":157250,"en":"Understand well all I have said;"},{"id":"semetey-1-2013:p1062:b004:l032","ordinal":157251,"en":"My golden Chürök, heed my words!"},{"id":"semetey-1-2013:p1062:b004:l033","ordinal":157252,"en":"If you do not heed our words,"},{"id":"semetey-1-2013:p1062:b004:l034","ordinal":157253,"en":"If you do not go to brave Toltoy,"},{"id":"semetey-1-2013:p1062:b004:l035","ordinal":157254,"en":"They will water their orchards"},{"id":"semetey-1-2013:p1062:b004:l036","ordinal":157255,"en":"And turn this place into gardens;"},{"id":"semetey-1-2013:p1062:b004:l037","ordinal":157256,"en":"They will take your aged father Akun"},{"id":"semetey-1-2013:p1062:b004:l038","ordinal":157257,"en":"And make him gather firewood;"},{"id":"semetey-1-2013:p1062:b004:l039","ordinal":157258,"en":"If the Zhediger take us in their wrath—"},{"id":"semetey-1-2013:p1063:b003:l001","ordinal":157259,"en":"If they suddenly overrun us,"},{"id":"semetey-1-2013:p1063:b003:l002","ordinal":157260,"en":"If they unexpectedly make war,"},{"id":"semetey-1-2013:p1063:b003:l003","ordinal":157261,"en":"They will pass through"},{"id":"semetey-1-2013:p1063:b003:l004","ordinal":157262,"en":"And slaughter all Afghanistan here."},{"id":"semetey-1-2013:p1063:b003:l005","ordinal":157263,"en":"Their army can enter over ridge after ridge;"},{"id":"semetey-1-2013:p1063:b003:l006","ordinal":157264,"en":"If we say we will not give you, sister,"},{"id":"semetey-1-2013:p1063:b003:l007","ordinal":157265,"en":"Their renowned great Kozho"},{"id":"semetey-1-2013:p1063:b003:l008","ordinal":157266,"en":"Will advance and overwhelm us!"},{"id":"semetey-1-2013:p1063:b003:l009","ordinal":157267,"en":"The army of the Zhediger"},{"id":"semetey-1-2013:p1063:b003:l010","ordinal":157268,"en":"Will overrun us together"},{"id":"semetey-1-2013:p1063:b003:l011","ordinal":157269,"en":"And destroy us all together;"},{"id":"semetey-1-2013:p1063:b003:l012","ordinal":157270,"en":"They have mighty Toltoy,"},{"id":"semetey-1-2013:p1063:b003:l013","ordinal":157271,"en":"Who, once aroused, spares no soul."},{"id":"semetey-1-2013:p1063:b003:l014","ordinal":157272,"en":"If we do not agree to what he says,"},{"id":"semetey-1-2013:p1063:b003:l015","ordinal":157273,"en":"If we do not give you as tribute,"},{"id":"semetey-1-2013:p1063:b003:l016","ordinal":157274,"en":"If we stand opposed across from them,"},{"id":"semetey-1-2013:p1063:b003:l017","ordinal":157275,"en":"Firing guns and drawing bows,"},{"id":"semetey-1-2013:p1063:b003:l018","ordinal":157276,"en":"And clash against them in battle,"},{"id":"semetey-1-2013:p1063:b003:l019","ordinal":157277,"en":"While arrows whistle,"},{"id":"semetey-1-2013:p1063:b003:l020","ordinal":157278,"en":"And strike their marks with a sting,"},{"id":"semetey-1-2013:p1063:b003:l021","ordinal":157279,"en":"And the people perish screaming,"},{"id":"semetey-1-2013:p1063:b003:l022","ordinal":157280,"en":"What would become of us?"},{"id":"semetey-1-2013:p1063:b003:l023","ordinal":157281,"en":"Why not heed"},{"id":"semetey-1-2013:p1063:b003:l024","ordinal":157282,"en":"The words I have spoken, Aychürök?"},{"id":"semetey-1-2013:p1063:b003:l025","ordinal":157283,"en":"He too is a father's son;"},{"id":"semetey-1-2013:p1063:b003:l026","ordinal":157284,"en":"Why not go"},{"id":"semetey-1-2013:p1063:b003:l027","ordinal":157285,"en":"To that hero Toltoy, Aychürök?"},{"id":"semetey-1-2013:p1063:b003:l028","ordinal":157286,"en":"Shining in a coat of mail,"},{"id":"semetey-1-2013:p1063:b003:l029","ordinal":157287,"en":"You have no choice but to go;"},{"id":"semetey-1-2013:p1063:b003:l030","ordinal":157288,"en":"After facing them and fighting,"},{"id":"semetey-1-2013:p1063:b003:l031","ordinal":157289,"en":"We have no choice but to give you"},{"id":"semetey-1-2013:p1063:b003:l032","ordinal":157290,"en":"To those barking dogs."},{"id":"semetey-1-2013:p1063:b003:l033","ordinal":157291,"en":"Our strength is spent and our power gone;"},{"id":"semetey-1-2013:p1063:b003:l034","ordinal":157292,"en":"We have no means left to take counsel."},{"id":"semetey-1-2013:p1063:b003:l035","ordinal":157293,"en":"Chürökbay, if we fight"},{"id":"semetey-1-2013:p1063:b003:l036","ordinal":157294,"en":"On your account, blood will flow."},{"id":"semetey-1-2013:p1063:b003:l037","ordinal":157295,"en":"After sitting deep in thought,"},{"id":"semetey-1-2013:p1063:b003:l038","ordinal":157296,"en":"We have resolved to heed your word;"},{"id":"semetey-1-2013:p1063:b003:l039","ordinal":157297,"en":"We have resolved to find the means"},{"id":"semetey-1-2013:p1063:b004:l001","ordinal":157298,"en":"To give you as tribute to Toltoy."},{"id":"semetey-1-2013:p1063:b004:l002","ordinal":157299,"en":"Without taking offense or resisting,"},{"id":"semetey-1-2013:p1063:b004:l003","ordinal":157300,"en":"We have now found the means;"},{"id":"semetey-1-2013:p1063:b004:l004","ordinal":157301,"en":"Finish all your objections!"},{"id":"semetey-1-2013:p1063:b004:l005","ordinal":157302,"en":"From over there we have found"},{"id":"semetey-1-2013:p1063:b004:l006","ordinal":157303,"en":"Your husband, lion Toltoy!"},{"id":"semetey-1-2013:p1063:b004:l007","ordinal":157304,"en":"When all recourse is slipping away,"},{"id":"semetey-1-2013:p1063:b004:l008","ordinal":157305,"en":"Toltoy of the Zhediger"},{"id":"semetey-1-2013:p1063:b004:l009","ordinal":157306,"en":"Is also a father's son."},{"id":"semetey-1-2013:p1063:b004:l010","ordinal":157307,"en":"Now heed our words;"},{"id":"semetey-1-2013:p1063:b004:l011","ordinal":157308,"en":"The people will be slaughtered for you—"},{"id":"semetey-1-2013:p1063:b004:l012","ordinal":157309,"en":"Go to brave Toltoy!\""},{"id":"semetey-1-2013:p1063:b004:l013","ordinal":157310,"en":"When they had spoken thus,"},{"id":"semetey-1-2013:p1063:b004:l014","ordinal":157311,"en":"Chürök then said this:"},{"id":"semetey-1-2013:p1063:b004:l015","ordinal":157312,"en":"\"Azhybay and Tümönbay,"},{"id":"semetey-1-2013:p1063:b004:l016","ordinal":157313,"en":"My two dear elder brothers,"},{"id":"semetey-1-2013:p1063:b004:l017","ordinal":157314,"en":"I shall heed what you say."},{"id":"semetey-1-2013:p1063:b004:l018","ordinal":157315,"en":"My father is old and I am a girl;"},{"id":"semetey-1-2013:p1063:b004:l019","ordinal":157316,"en":"What choice have I, what can I do?"},{"id":"semetey-1-2013:p1063:b004:l020","ordinal":157317,"en":"I shall go to your Toltoy!"},{"id":"semetey-1-2013:p1063:b004:l021","ordinal":157318,"en":"My dear two elder brothers,"},{"id":"semetey-1-2013:p1063:b004:l022","ordinal":157319,"en":"Your manhood has become clear."},{"id":"semetey-1-2013:p1063:b004:l023","ordinal":157320,"en":"Why not agree to what he says,"},{"id":"semetey-1-2013:p1063:b004:l024","ordinal":157321,"en":"Take from Toltoy of the Zhediger"},{"id":"semetey-1-2013:p1063:b004:l025","ordinal":157322,"en":"Livestock enough to make the earth sag,"},{"id":"semetey-1-2013:p1063:b004:l026","ordinal":157323,"en":"And only then give me away?"},{"id":"semetey-1-2013:p1063:b004:l027","ordinal":157324,"en":"Have you killed countless men"},{"id":"semetey-1-2013:p1063:b004:l028","ordinal":157325,"en":"Among the Zhediger people"},{"id":"semetey-1-2013:p1063:b004:l029","ordinal":157326,"en":"And become blood-debtors?"},{"id":"semetey-1-2013:p1063:b004:l030","ordinal":157327,"en":"Have you become plunder-debtors"},{"id":"semetey-1-2013:p1063:b004:l031","ordinal":157328,"en":"For stealing camels?"},{"id":"semetey-1-2013:p1063:b004:l032","ordinal":157329,"en":"If you have no such fear,"},{"id":"semetey-1-2013:p1063:b004:l033","ordinal":157330,"en":"Have you given me as a fine"},{"id":"semetey-1-2013:p1063:b004:l034","ordinal":157331,"en":"Because you rode no dappled pacing colt,"},{"id":"semetey-1-2013:p1063:b004:l035","ordinal":157332,"en":"Ate no knucklebone's meat,"},{"id":"semetey-1-2013:p1063:b004:l036","ordinal":157333,"en":"Rode no spotted pacing horse,"},{"id":"semetey-1-2013:p1063:b004:l037","ordinal":157334,"en":"And ate no rich joint of meat?"},{"id":"semetey-1-2013:p1063:b004:l038","ordinal":157335,"en":"The Zhediger who would take a wife—"},{"id":"semetey-1-2013:p1063:b004:l039","ordinal":157336,"en":"Why not raise a great tumult against them?"}]
