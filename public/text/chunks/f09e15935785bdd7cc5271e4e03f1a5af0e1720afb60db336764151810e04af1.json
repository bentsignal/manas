[{"id":"semetey-1-2013:p0800:b003:l004","ordinal":137473,"en":"If your orphan, Manas's son,"},{"id":"semetey-1-2013:p0800:b003:l005","ordinal":137474,"en":"Did not arrive that day,"},{"id":"semetey-1-2013:p0800:b003:l006","ordinal":137475,"en":"The anguish of the Day of Judgment"},{"id":"semetey-1-2013:p0800:b003:l007","ordinal":137476,"en":"He would have to face."},{"id":"semetey-1-2013:p0800:b003:l008","ordinal":137477,"en":"The thirty days were exactly up;"},{"id":"semetey-1-2013:p0800:b003:l009","ordinal":137478,"en":"Your mighty mother Chiyyrdy"},{"id":"semetey-1-2013:p0800:b003:l010","ordinal":137479,"en":"Was about to die."},{"id":"semetey-1-2013:p0800:b003:l011","ordinal":137480,"en":"Taking no food, eating nothing,"},{"id":"semetey-1-2013:p0800:b003:l012","ordinal":137481,"en":"She had brought this torment upon them."},{"id":"semetey-1-2013:p0800:b003:l013","ordinal":137482,"en":"‘When will my orphan come?’"},{"id":"semetey-1-2013:p0800:b003:l014","ordinal":137483,"en":"She lay there wailing."},{"id":"semetey-1-2013:p0800:b003:l015","ordinal":137484,"en":"‘God will grant us the orphan;"},{"id":"semetey-1-2013:p0800:b003:l016","ordinal":137485,"en":"If he is alive, he will come,’"},{"id":"semetey-1-2013:p0800:b003:l017","ordinal":137486,"en":"Your dear mother Kanykei said,"},{"id":"semetey-1-2013:p0800:b003:l018","ordinal":137487,"en":"Enduring this anguish."},{"id":"semetey-1-2013:p0800:b003:l019","ordinal":137488,"en":"The bowed old woman Chiyyrdy"},{"id":"semetey-1-2013:p0800:b003:l020","ordinal":137489,"en":"Had reached ninety-five years."},{"id":"semetey-1-2013:p0800:b003:l021","ordinal":137490,"en":"Sorrowful Kanykei,"},{"id":"semetey-1-2013:p0800:b003:l022","ordinal":137491,"en":"Your dear, unfortunate sister-in-law,"},{"id":"semetey-1-2013:p0800:b003:l023","ordinal":137492,"en":"Had only to look at old Chiyyrdy"},{"id":"semetey-1-2013:p0800:b003:l024","ordinal":137493,"en":"For her hunger to be satisfied."},{"id":"semetey-1-2013:p0800:b003:l025","ordinal":137494,"en":"The support left by her Khan Manas—"},{"id":"semetey-1-2013:p0800:b003:l026","ordinal":137495,"en":"The sight of her satisfied her hunger;"},{"id":"semetey-1-2013:p0800:b003:l027","ordinal":137496,"en":"She had no one else like her."},{"id":"semetey-1-2013:p0800:b003:l030","ordinal":137497,"en":"‘Let her be my refuge,’ she said.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0800:b003:l031","ordinal":137498,"en":"Your poor sister-in-law Kanykei"},{"id":"semetey-1-2013:p0800:b003:l032","ordinal":137499,"en":"Had set her upon her shoulders"},{"id":"semetey-1-2013:p0800:b003:l033","ordinal":137500,"en":"And brought her away."},{"id":"semetey-1-2013:p0800:b003:l034","ordinal":137501,"en":"Then Chiyyrdy,"},{"id":"semetey-1-2013:p0800:b003:l035","ordinal":137502,"en":"Saying, ‘The orphan has gone to his people,’"},{"id":"semetey-1-2013:p0800:b003:l036","ordinal":137503,"en":"Was torn with worry."},{"id":"semetey-1-2013:p0800:b003:l037","ordinal":137504,"en":"Tears poured from her eyes,"},{"id":"semetey-1-2013:p0800:b003:l038","ordinal":137505,"en":"Both her eyes festered,"},{"id":"semetey-1-2013:p0800:b003:l039","ordinal":137506,"en":"Her whole body trembled."},{"id":"semetey-1-2013:p0800:b004:l001","ordinal":137507,"en":"Not in the grave, if one called her dead,"},{"id":"semetey-1-2013:p0800:b004:l002","ordinal":137508,"en":"The elder of ninety-five"},{"id":"semetey-1-2013:p0800:b004:l003","ordinal":137509,"en":"Lay huddled there."},{"id":"semetey-1-2013:p0800:b004:l004","ordinal":137510,"en":"Unable to rise, the old lady"},{"id":"semetey-1-2013:p0800:b004:l005","ordinal":137511,"en":"Had sunk down."},{"id":"semetey-1-2013:p0800:b004:l006","ordinal":137512,"en":"If that Semetey did not come,"},{"id":"semetey-1-2013:p0800:b004:l007","ordinal":137513,"en":"‘Why should I go on living"},{"id":"semetey-1-2013:p0800:b004:l008","ordinal":137514,"en":"In this world?’ she said."},{"id":"semetey-1-2013:p0800:b004:l009","ordinal":137515,"en":"Stubbornly, she resolved"},{"id":"semetey-1-2013:p0800:b004:l010","ordinal":137516,"en":"To endure hunger."},{"id":"semetey-1-2013:p0800:b004:l011","ordinal":137517,"en":"From this false world"},{"id":"semetey-1-2013:p0800:b004:l012","ordinal":137518,"en":"She resolved to die."},{"id":"semetey-1-2013:p0800:b004:l013","ordinal":137519,"en":"‘When will the orphan come?"},{"id":"semetey-1-2013:p0800:b004:l014","ordinal":137520,"en":"When will I see his face?’ she said."},{"id":"semetey-1-2013:p0800:b004:l015","ordinal":137521,"en":"Refusing to listen, hunched over,"},{"id":"semetey-1-2013:p0800:b004:l016","ordinal":137522,"en":"She lay huddled there."},{"id":"semetey-1-2013:p0800:b004:l017","ordinal":137523,"en":"‘When will the orphan come?’ she said,"},{"id":"semetey-1-2013:p0800:b004:l018","ordinal":137524,"en":"And sank down."},{"id":"semetey-1-2013:p0800:b004:l019","ordinal":137525,"en":"While her mother lay bowed down,"},{"id":"semetey-1-2013:p0800:b004:l020","ordinal":137526,"en":"While she brought this torment,"},{"id":"semetey-1-2013:p0800:b004:l021","ordinal":137527,"en":"Your dear sister-in-law Kanykei,"},{"id":"semetey-1-2013:p0800:b004:l022","ordinal":137528,"en":"Her knees bending to the ground,"},{"id":"semetey-1-2013:p0800:b004:l023","ordinal":137529,"en":"Into Khan Temir’s tower"},{"id":"semetey-1-2013:p0800:b004:l024","ordinal":137530,"en":"She ran and climbed."},{"id":"semetey-1-2013:p0800:b004:l025","ordinal":137531,"en":"Kanykei hoped"},{"id":"semetey-1-2013:p0800:b004:l026","ordinal":137532,"en":"To climb up and see her orphan,"},{"id":"semetey-1-2013:p0800:b004:l027","ordinal":137533,"en":"And, if she saw him, give the news"},{"id":"semetey-1-2013:p0800:b004:l028","ordinal":137534,"en":"To Chiyyrdy."},{"id":"semetey-1-2013:p0800:b004:l029","ordinal":137535,"en":"Your dear mother Kanykei"},{"id":"semetey-1-2013:p0800:b004:l032","ordinal":137536,"en":"Khan Manas's great spyglass,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0800:b004:l033","ordinal":137537,"en":"Your valiant sister-in-law Kanykei"},{"id":"semetey-1-2013:p0800:b004:l034","ordinal":137538,"en":"Had hidden in the fold of her overskirt,"},{"id":"semetey-1-2013:p0800:b004:l035","ordinal":137539,"en":"Secured it firmly in her care,"},{"id":"semetey-1-2013:p0800:b004:l036","ordinal":137540,"en":"And brought it away."},{"id":"semetey-1-2013:p0800:b004:l037","ordinal":137541,"en":"She bound it again and fastened it close,"},{"id":"semetey-1-2013:p0800:b004:l038","ordinal":137542,"en":"Entrusted it to a place none knew,"},{"id":"semetey-1-2013:p0800:b004:l039","ordinal":137543,"en":"Weeping bitterly to the one God,"},{"id":"semetey-1-2013:p0801:b003:l001","ordinal":137544,"en":"Dedicating it to her dear Semetey."},{"id":"semetey-1-2013:p0801:b003:l002","ordinal":137545,"en":"Unable to keep still in her haste,"},{"id":"semetey-1-2013:p0801:b003:l003","ordinal":137546,"en":"Terribly afraid of the boy,"},{"id":"semetey-1-2013:p0801:b003:l004","ordinal":137547,"en":"Without taking its strap from her neck,"},{"id":"semetey-1-2013:p0801:b003:l005","ordinal":137548,"en":"The telescope of unmeasured range"},{"id":"semetey-1-2013:p0801:b003:l006","ordinal":137549,"en":"She drew out from her bosom."},{"id":"semetey-1-2013:p0801:b003:l007","ordinal":137550,"en":"Turning its ring,"},{"id":"semetey-1-2013:p0801:b003:l008","ordinal":137551,"en":"Bringing it right to her eye,"},{"id":"semetey-1-2013:p0801:b003:l009","ordinal":137552,"en":"She looked through the telescope."},{"id":"semetey-1-2013:p0801:b003:l010","ordinal":137553,"en":"It seemed that Allah Almighty, the one God,"},{"id":"semetey-1-2013:p0801:b003:l011","ordinal":137554,"en":"Had granted her wish;"},{"id":"semetey-1-2013:p0801:b003:l012","ordinal":137555,"en":"Her only son, who had gone to his people,"},{"id":"semetey-1-2013:p0801:b003:l013","ordinal":137556,"en":"Seemed to have returned!"},{"id":"semetey-1-2013:p0801:b003:l014","ordinal":137557,"en":"When she looked in front of him,"},{"id":"semetey-1-2013:p0801:b003:l015","ordinal":137558,"en":"Never flinching from a tiger,"},{"id":"semetey-1-2013:p0801:b003:l016","ordinal":137559,"en":"Never turning back from a bear,"},{"id":"semetey-1-2013:p0801:b003:l017","ordinal":137560,"en":"Making the one who loosed him laugh,"},{"id":"semetey-1-2013:p0801:b003:l018","ordinal":137561,"en":"Destroying whatever he bit,"},{"id":"semetey-1-2013:p0801:b003:l019","ordinal":137562,"en":"Tended when he was little,"},{"id":"semetey-1-2013:p0801:b003:l020","ordinal":137563,"en":"Kept when he was a puppy,"},{"id":"semetey-1-2013:p0801:b003:l021","ordinal":137564,"en":"With a collar put around his neck,"},{"id":"semetey-1-2013:p0801:b003:l022","ordinal":137565,"en":"Fed at the treasury's expense,"},{"id":"semetey-1-2013:p0801:b003:l023","ordinal":137566,"en":"“Would that he were my dog!”"},{"id":"semetey-1-2013:p0801:b003:l024","ordinal":137567,"en":"So all who saw him wished."},{"id":"semetey-1-2013:p0801:b003:l025","ordinal":137568,"en":"That Kumaiyk who had strayed away—"},{"id":"semetey-1-2013:p0801:b003:l026","ordinal":137569,"en":"“He was like my firstborn son;"},{"id":"semetey-1-2013:p0801:b003:l027","ordinal":137570,"en":"I was like a mother to him."},{"id":"semetey-1-2013:p0801:b003:l028","ordinal":137571,"en":"Allah Almighty, the All-Powerful,"},{"id":"semetey-1-2013:p0801:b003:l029","ordinal":137572,"en":"Seems to have granted him to me."},{"id":"semetey-1-2013:p0801:b003:l030","ordinal":137573,"en":"Before Semetey,"},{"id":"semetey-1-2013:p0801:b003:l032","ordinal":137574,"en":"He seems to have returned!","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0801:b003:l034","ordinal":137575,"en":"My only child, won at death's door,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0801:b003:l035","ordinal":137576,"en":"Kumaiyk, left in trust,"},{"id":"semetey-1-2013:p0801:b003:l036","ordinal":137577,"en":"He has brought back to me"},{"id":"semetey-1-2013:p0801:b003:l037","ordinal":137578,"en":"And shown before my eyes.”"},{"id":"semetey-1-2013:p0801:b003:l038","ordinal":137579,"en":"Her poor heart was stirred;"},{"id":"semetey-1-2013:p0801:b003:l039","ordinal":137580,"en":"The one running below"},{"id":"semetey-1-2013:p0801:b005:l001","ordinal":137581,"en":"Was truly Kumaiyk, it seemed."},{"id":"semetey-1-2013:p0801:b005:l002","ordinal":137582,"en":"The one coming behind him—"},{"id":"semetey-1-2013:p0801:b005:l003","ordinal":137583,"en":"“My plump little mottled gray hawk,"},{"id":"semetey-1-2013:p0801:b005:l004","ordinal":137584,"en":"My gray goshawk, my falcon,"},{"id":"semetey-1-2013:p0801:b005:l005","ordinal":137585,"en":"My spring flowing through the valley,"},{"id":"semetey-1-2013:p0801:b005:l006","ordinal":137586,"en":"Comes riding Taibuurul,"},{"id":"semetey-1-2013:p0801:b005:l007","ordinal":137587,"en":"My lamp, won at death's door!”"},{"id":"semetey-1-2013:p0801:b005:l008","ordinal":137588,"en":"Seeing him, her poor heart was stirred:"},{"id":"semetey-1-2013:p0801:b005:l009","ordinal":137589,"en":"“Oh, mother, good tidings!"},{"id":"semetey-1-2013:p0801:b005:l010","ordinal":137590,"en":"My orphan seems to be coming!"},{"id":"semetey-1-2013:p0801:b005:l011","ordinal":137591,"en":"He has granted what I wished;"},{"id":"semetey-1-2013:p0801:b005:l012","ordinal":137592,"en":"My orphan, my support, has come!"},{"id":"semetey-1-2013:p0801:b005:l013","ordinal":137593,"en":"God has granted my desire."},{"id":"semetey-1-2013:p0801:b005:l014","ordinal":137594,"en":"Come, mother, rise up;"},{"id":"semetey-1-2013:p0801:b005:l015","ordinal":137595,"en":"The orphan we watched for has come!"},{"id":"semetey-1-2013:p0801:b005:l016","ordinal":137596,"en":"Your brow will now brighten;"},{"id":"semetey-1-2013:p0801:b005:l017","ordinal":137597,"en":"Your sorrow will now ease."},{"id":"semetey-1-2013:p0801:b005:l018","ordinal":137598,"en":"Seeing him, the heart is stirred;"},{"id":"semetey-1-2013:p0801:b005:l019","ordinal":137599,"en":"In build and bearing"},{"id":"semetey-1-2013:p0801:b005:l020","ordinal":137600,"en":"He looks like Manas."},{"id":"semetey-1-2013:p0801:b005:l021","ordinal":137601,"en":"God has granted my desire;"},{"id":"semetey-1-2013:p0801:b005:l022","ordinal":137602,"en":"My orphan left by Manas"},{"id":"semetey-1-2013:p0801:b005:l023","ordinal":137603,"en":"Has taken what he sought."},{"id":"semetey-1-2013:p0801:b005:l024","ordinal":137604,"en":"Why speak of the rest?"},{"id":"semetey-1-2013:p0801:b005:l025","ordinal":137605,"en":"Left by his father,"},{"id":"semetey-1-2013:p0801:b005:l026","ordinal":137606,"en":"The white falcon he has brought."},{"id":"semetey-1-2013:p0801:b005:l027","ordinal":137607,"en":"That dear bird called the wild duck"},{"id":"semetey-1-2013:p0801:b005:l028","ordinal":137608,"en":"Flies without turning back, in search of food."},{"id":"semetey-1-2013:p0801:b005:l029","ordinal":137609,"en":"How much I have suffered, poor soul,"},{"id":"semetey-1-2013:p0801:b005:l030","ordinal":137610,"en":"For you, who came from my womb!"},{"id":"semetey-1-2013:p0801:b005:l031","ordinal":137611,"en":"That wretched bird called the kite"},{"id":"semetey-1-2013:p0801:b005:l032","ordinal":137612,"en":"Swoops in flight in search of food."},{"id":"semetey-1-2013:p0801:b005:l033","ordinal":137613,"en":"Your two mothers have suffered so much"},{"id":"semetey-1-2013:p0801:b005:l034","ordinal":137614,"en":"For you, who came from the womb!”"},{"id":"semetey-1-2013:p0801:b005:l035","ordinal":137615,"en":"Both his mothers wept;"},{"id":"semetey-1-2013:p0801:b005:l036","ordinal":137616,"en":"Poor Chiyirdi wept especially hard."},{"id":"semetey-1-2013:p0801:b005:l038","ordinal":137617,"en":"The boy entered Bukhara,"},{"id":"semetey-1-2013:p0801:b005:l039","ordinal":137618,"en":"All his gear in readiness."},{"id":"semetey-1-2013:p0802:b003:l001","ordinal":137619,"en":"The trust left by Manas,"},{"id":"semetey-1-2013:p0802:b003:l002","ordinal":137620,"en":"All of it was provided."},{"id":"semetey-1-2013:p0802:b003:l003","ordinal":137621,"en":"Long ago, when the widow fled there,"},{"id":"semetey-1-2013:p0802:b003:l004","ordinal":137622,"en":"Her father had set it apart for her:"},{"id":"semetey-1-2013:p0802:b003:l005","ordinal":137623,"en":"Kanykei's white palace,"},{"id":"semetey-1-2013:p0802:b003:l006","ordinal":137624,"en":"Its doors of iron and solid tin."},{"id":"semetey-1-2013:p0802:b003:l007","ordinal":137625,"en":"Though that unfortunate woman was a widow,"},{"id":"semetey-1-2013:p0802:b003:l008","ordinal":137626,"en":"Her dignity was very great."},{"id":"semetey-1-2013:p0802:b003:l009","ordinal":137627,"en":"The poor orphan, grown imposing,"},{"id":"semetey-1-2013:p0802:b003:l010","ordinal":137628,"en":"Stood grandly like his father Manas."},{"id":"semetey-1-2013:p0802:b003:l011","ordinal":137629,"en":"Seeing him, the heart was stirred;"},{"id":"semetey-1-2013:p0802:b003:l012","ordinal":137630,"en":"Your orphan, the wolf-maned warrior's son,"},{"id":"semetey-1-2013:p0802:b003:l013","ordinal":137631,"en":"Came fully into view."},{"id":"semetey-1-2013:p0802:b003:l014","ordinal":137632,"en":"A black-spotted leopard,"},{"id":"semetey-1-2013:p0802:b003:l015","ordinal":137633,"en":"Springing at his side,"},{"id":"semetey-1-2013:p0802:b003:l016","ordinal":137634,"en":"Secretly lent him protection;"},{"id":"semetey-1-2013:p0802:b003:l017","ordinal":137635,"en":"Round about the boy"},{"id":"semetey-1-2013:p0802:b003:l018","ordinal":137636,"en":"It circled."},{"id":"semetey-1-2013:p0802:b003:l019","ordinal":137637,"en":"Kanykei and Chiyirdi,"},{"id":"semetey-1-2013:p0802:b003:l020","ordinal":137638,"en":"Seeing the boy's form,"},{"id":"semetey-1-2013:p0802:b003:l021","ordinal":137639,"en":"Offered their very lives"},{"id":"semetey-1-2013:p0802:b003:l022","ordinal":137640,"en":"As a sacrifice for him."},{"id":"semetey-1-2013:p0802:b003:l023","ordinal":137641,"en":"When they saw their precious one,"},{"id":"semetey-1-2013:p0802:b003:l024","ordinal":137642,"en":"His two mothers rejoiced."},{"id":"semetey-1-2013:p0802:b003:l025","ordinal":137643,"en":"When they saw Kumaiyk,"},{"id":"semetey-1-2013:p0802:b003:l026","ordinal":137644,"en":"Kanykei and Chiyirdi"},{"id":"semetey-1-2013:p0802:b003:l027","ordinal":137645,"en":"Both grieved together."},{"id":"semetey-1-2013:p0802:b003:l028","ordinal":137646,"en":"He had no tongue to speak with,"},{"id":"semetey-1-2013:p0802:b003:l029","ordinal":137647,"en":"Kumaiyk, wiser than other beasts."},{"id":"semetey-1-2013:p0802:b003:l030","ordinal":137648,"en":"The people were there, their khan was there;"},{"id":"semetey-1-2013:p0802:b003:l031","ordinal":137649,"en":"As Kumaiyk stood thus,"},{"id":"semetey-1-2013:p0802:b003:l032","ordinal":137650,"en":"All the multitude was there."},{"id":"semetey-1-2013:p0802:b003:l033","ordinal":137651,"en":"When he saw the two ladies,"},{"id":"semetey-1-2013:p0802:b003:l034","ordinal":137652,"en":"Crouching like a quail,"},{"id":"semetey-1-2013:p0802:b003:l035","ordinal":137653,"en":"Kumaiyk came crouching low."},{"id":"semetey-1-2013:p0802:b003:l036","ordinal":137654,"en":"Tears welled in his eyes;"},{"id":"semetey-1-2013:p0802:b003:l037","ordinal":137655,"en":"Kumaiyk came shedding them."},{"id":"semetey-1-2013:p0802:b003:l038","ordinal":137656,"en":"When he saw the two ladies,"},{"id":"semetey-1-2013:p0802:b003:l039","ordinal":137657,"en":"Kumaiyk stood distraught;"},{"id":"semetey-1-2013:p0802:b004:l001","ordinal":137658,"en":"Sobbing more than a human,"},{"id":"semetey-1-2013:p0802:b004:l002","ordinal":137659,"en":"Kumaiyk stood howling."},{"id":"semetey-1-2013:p0802:b004:l003","ordinal":137660,"en":"Then Kumaiyk,"},{"id":"semetey-1-2013:p0802:b004:l004","ordinal":137661,"en":"When he saw Kanykei,"},{"id":"semetey-1-2013:p0802:b004:l005","ordinal":137662,"en":"Laid his head upon her breast;"},{"id":"semetey-1-2013:p0802:b004:l006","ordinal":137663,"en":"Like a person weeping,"},{"id":"semetey-1-2013:p0802:b004:l007","ordinal":137664,"en":"He lay down and wailed."},{"id":"semetey-1-2013:p0802:b004:l008","ordinal":137665,"en":"As Kumaiyk did this,"},{"id":"semetey-1-2013:p0802:b004:l009","ordinal":137666,"en":"Your poor mother wept with him."},{"id":"semetey-1-2013:p0802:b004:l010","ordinal":137667,"en":"Her own father Temir Khan,"},{"id":"semetey-1-2013:p0802:b004:l011","ordinal":137668,"en":"Her younger brother Ysmayyl—"},{"id":"semetey-1-2013:p0802:b004:l012","ordinal":137669,"en":"The khan of Bukhara wept with them."},{"id":"semetey-1-2013:p0802:b004:l013","ordinal":137670,"en":"When the khan wept, the people wept;"},{"id":"semetey-1-2013:p0802:b004:l014","ordinal":137671,"en":"All the people wept together."},{"id":"semetey-1-2013:p0802:b004:l015","ordinal":137672,"en":"Chiyirdi, grown old,"},{"id":"semetey-1-2013:p0802:b004:l016","ordinal":137673,"en":"The old woman in her bed, wept."},{"id":"semetey-1-2013:p0802:b004:l017","ordinal":137674,"en":"Ah, that creature Kumaiyk"},{"id":"semetey-1-2013:p0802:b004:l018","ordinal":137675,"en":"Had taken my mother"},{"id":"semetey-1-2013:p0802:b004:l019","ordinal":137676,"en":"As a mother in his own mother's place;"},{"id":"semetey-1-2013:p0802:b004:l020","ordinal":137677,"en":"He laid his head upon her breast."},{"id":"semetey-1-2013:p0802:b004:l021","ordinal":137678,"en":"He sniffed at her right breast,"},{"id":"semetey-1-2013:p0802:b004:l022","ordinal":137679,"en":"Then sniffed at her left."},{"id":"semetey-1-2013:p0802:b004:l023","ordinal":137680,"en":"Kanykei wept bitterly;"},{"id":"semetey-1-2013:p0802:b004:l024","ordinal":137681,"en":"Kumaiyk growled."},{"id":"semetey-1-2013:p0802:b004:l025","ordinal":137682,"en":"“Kumaiyk, whom we had asked after,"},{"id":"semetey-1-2013:p0802:b004:l026","ordinal":137683,"en":"Has come in the flesh,” she said."},{"id":"semetey-1-2013:p0802:b004:l027","ordinal":137684,"en":"“The inheritance I longed for"},{"id":"semetey-1-2013:p0802:b004:l028","ordinal":137685,"en":"Has come back to me,” she said."},{"id":"semetey-1-2013:p0802:b004:l029","ordinal":137686,"en":"Like rain from the sky,"},{"id":"semetey-1-2013:p0802:b004:l030","ordinal":137687,"en":"They caressed one another."},{"id":"semetey-1-2013:p0802:b004:l031","ordinal":137688,"en":"For twelve years they had not seen each other;"},{"id":"semetey-1-2013:p0802:b004:l032","ordinal":137689,"en":"Now they were reunited."},{"id":"semetey-1-2013:p0802:b004:l033","ordinal":137690,"en":"Their lord, Manas the wolf-maned warrior,"},{"id":"semetey-1-2013:p0802:b004:l034","ordinal":137691,"en":"Had indeed been their lord."},{"id":"semetey-1-2013:p0802:b004:l035","ordinal":137692,"en":"Long ago, Manas the leopard,"},{"id":"semetey-1-2013:p0802:b004:l036","ordinal":137693,"en":"At the Pass of Belendi,"},{"id":"semetey-1-2013:p0802:b004:l037","ordinal":137694,"en":"Where he performed his ablutions,"},{"id":"semetey-1-2013:p0802:b004:l038","ordinal":137695,"en":"Had found Kumaiyk,"},{"id":"semetey-1-2013:p0802:b004:l039","ordinal":137696,"en":"Before his eyes had opened."},{"id":"semetey-1-2013:p0803:b003:l001","ordinal":137697,"en":"When he was near to death,"},{"id":"semetey-1-2013:p0803:b003:l002","ordinal":137698,"en":"When he found him and brought him back,"},{"id":"semetey-1-2013:p0803:b003:l003","ordinal":137699,"en":"When he gave him to Kanykei,"},{"id":"semetey-1-2013:p0803:b003:l004","ordinal":137700,"en":"The steel collar upon his neck"},{"id":"semetey-1-2013:p0803:b003:l005","ordinal":137701,"en":"Was fastened by Kanykei."},{"id":"semetey-1-2013:p0803:b003:l006","ordinal":137702,"en":"Becoming his mother then,"},{"id":"semetey-1-2013:p0803:b003:l007","ordinal":137703,"en":"Kanykei had raised him."},{"id":"semetey-1-2013:p0803:b003:l008","ordinal":137704,"en":"Before his eyes had opened,"},{"id":"semetey-1-2013:p0803:b003:l009","ordinal":137705,"en":"When he was no bigger than a hand,"},{"id":"semetey-1-2013:p0803:b003:l010","ordinal":137706,"en":"“If I tend the puppy badly,"},{"id":"semetey-1-2013:p0803:b003:l011","ordinal":137707,"en":"Death will take him needlessly,"},{"id":"semetey-1-2013:p0803:b003:l012","ordinal":137708,"en":"And my hopes will perish with him,” she said."},{"id":"semetey-1-2013:p0803:b003:l013","ordinal":137709,"en":"She fed him milk from her mouth;"},{"id":"semetey-1-2013:p0803:b003:l014","ordinal":137710,"en":"She gave him meat with her hand."},{"id":"semetey-1-2013:p0803:b003:l015","ordinal":137711,"en":"Taking no rest by day,"},{"id":"semetey-1-2013:p0803:b003:l016","ordinal":137712,"en":"Getting no sleep by night,"},{"id":"semetey-1-2013:p0803:b003:l017","ordinal":137713,"en":"Thus she raised the sighthound."},{"id":"semetey-1-2013:p0803:b003:l018","ordinal":137714,"en":"Never once lying idle,"},{"id":"semetey-1-2013:p0803:b003:l019","ordinal":137715,"en":"The sighthound you have seen"},{"id":"semetey-1-2013:p0803:b003:l020","ordinal":137716,"en":"She kept as a mother would."},{"id":"semetey-1-2013:p0803:b003:l021","ordinal":137717,"en":"In raising Kumaiyk,"},{"id":"semetey-1-2013:p0803:b003:l022","ordinal":137718,"en":"She thought and pondered,"},{"id":"semetey-1-2013:p0803:b003:l023","ordinal":137719,"en":"Taking a broad view of the world."},{"id":"semetey-1-2013:p0803:b003:l024","ordinal":137720,"en":"“If this Kumaiyk I am raising"},{"id":"semetey-1-2013:p0803:b003:l025","ordinal":137721,"en":"Should happen to die,"},{"id":"semetey-1-2013:p0803:b003:l026","ordinal":137722,"en":"Should happen to be maimed,"},{"id":"semetey-1-2013:p0803:b003:l027","ordinal":137723,"en":"This whole Bukhara here—"},{"id":"semetey-1-2013:p0803:b003:l028","ordinal":137724,"en":"The leopard, in his wrath,"},{"id":"semetey-1-2013:p0803:b003:l029","ordinal":137725,"en":"Will lay it all waste,"},{"id":"semetey-1-2013:p0803:b003:l030","ordinal":137726,"en":"And thus destroy us utterly,” she said."},{"id":"semetey-1-2013:p0803:b003:l031","ordinal":137727,"en":"She tended and trained him well;"},{"id":"semetey-1-2013:p0803:b003:l032","ordinal":137728,"en":"That poor Kumaiyk"}]
