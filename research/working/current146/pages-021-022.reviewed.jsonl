{"id": "sayakbay-ms-current146:pdf022:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 22, "folio": 405, "line_in_page": 30, "raw": "Түмөндөн тандаган миңбашы,", "text": "Түмөндөн тандаган миңбашы,", "en": "The commander of a thousand chosen from a myriad,", "classification": "narrative", "transcription_status": "visually_transcribed", "bbox": null}
{"id": "sayakbay-ms-current146:pdf022:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 22, "folio": 405, "line_in_page": 31, "raw": "Бөздүн журтун суюрткан,", "text": "Бөздүн журтун суюрткан,", "en": "He thinned the people of Böz,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Бөздүн and суюрткан are provisional readings; Бөз may be a name or the first word may differ.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf022:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 22, "folio": 405, "line_in_page": 32, "raw": "Карагандын журтун кайдарган,", "text": "Карагандын журтун кайдарган,", "en": "He drove back the people of Karagan,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Карагандын may be a proper name; the final verb is faint and provisionally normalized as кайдарган.", "bbox": null}
