[{"id":"semetey-1-2013:p0403:b003:l033","ordinal":107777,"en":"They stood and took their turns;"},{"id":"semetey-1-2013:p0403:b003:l034","ordinal":107778,"en":"Your father and Maiden Saikal"},{"id":"semetey-1-2013:p0403:b003:l035","ordinal":107779,"en":"Fought each other turn by turn."},{"id":"semetey-1-2013:p0403:b003:l036","ordinal":107780,"en":"They fought with axes;"},{"id":"semetey-1-2013:p0403:b003:l037","ordinal":107781,"en":"The axe heads shattered,"},{"id":"semetey-1-2013:p0403:b003:l038","ordinal":107782,"en":"Leaving the handles in their hands."},{"id":"semetey-1-2013:p0403:b003:l039","ordinal":107783,"en":"They fought with swords;"},{"id":"semetey-1-2013:p0403:b005:l001","ordinal":107784,"en":"All the swords shattered,"},{"id":"semetey-1-2013:p0403:b005:l002","ordinal":107785,"en":"Leaving the sheaths in their hands."},{"id":"semetey-1-2013:p0403:b005:l003","ordinal":107786,"en":"They grappled by the hems of their coats;"},{"id":"semetey-1-2013:p0403:b005:l004","ordinal":107787,"en":"At that time, the two heroes"},{"id":"semetey-1-2013:p0403:b005:l005","ordinal":107788,"en":"Exhausted one another."},{"id":"semetey-1-2013:p0403:b005:l006","ordinal":107789,"en":"Grasping collars, they pulled and struggled."},{"id":"semetey-1-2013:p0403:b005:l007","ordinal":107790,"en":"Maiden Saikal's Alkara"},{"id":"semetey-1-2013:p0403:b005:l008","ordinal":107791,"en":"And your father's Ak-kula,"},{"id":"semetey-1-2013:p0403:b005:l009","ordinal":107792,"en":"Under the strain of these champions,"},{"id":"semetey-1-2013:p0403:b005:l010","ordinal":107793,"en":"The beasts could not hold out;"},{"id":"semetey-1-2013:p0403:b005:l011","ordinal":107794,"en":"They sank knee-deep into sand."},{"id":"semetey-1-2013:p0403:b005:l012","ordinal":107795,"en":"Unable to endure by day,"},{"id":"semetey-1-2013:p0403:b005:l013","ordinal":107796,"en":"Taking no sleep at night,"},{"id":"semetey-1-2013:p0403:b005:l014","ordinal":107797,"en":"They stood through days and nights,"},{"id":"semetey-1-2013:p0403:b005:l015","ordinal":107798,"en":"Fighting without respite."},{"id":"semetey-1-2013:p0403:b005:l016","ordinal":107799,"en":"On the fescue-covered slope,"},{"id":"semetey-1-2013:p0403:b005:l017","ordinal":107800,"en":"Your father and Maiden Saikal,"},{"id":"semetey-1-2013:p0403:b005:l018","ordinal":107801,"en":"Where they faced each other,"},{"id":"semetey-1-2013:p0403:b005:l019","ordinal":107802,"en":"At the pass of Yrgaity,"},{"id":"semetey-1-2013:p0403:b005:l020","ordinal":107803,"en":"As they swayed back and forth,"},{"id":"semetey-1-2013:p0403:b005:l021","ordinal":107804,"en":"God struck Saikal."},{"id":"semetey-1-2013:p0403:b005:l022","ordinal":107805,"en":"That bitch, fierce Saikal,"},{"id":"semetey-1-2013:p0403:b005:l023","ordinal":107806,"en":"Stood gathering her strength."},{"id":"semetey-1-2013:p0403:b005:l024","ordinal":107807,"en":"Alkara beneath her,"},{"id":"semetey-1-2013:p0403:b005:l025","ordinal":107808,"en":"She whipped on either side,"},{"id":"semetey-1-2013:p0403:b005:l026","ordinal":107809,"en":"Spurring left and right,"},{"id":"semetey-1-2013:p0403:b005:l027","ordinal":107810,"en":"Shouting in fury,"},{"id":"semetey-1-2013:p0403:b005:l028","ordinal":107811,"en":"Crying 'Karacha!' as her battle cry."},{"id":"semetey-1-2013:p0403:b005:l029","ordinal":107812,"en":"She was sustained by Shai;"},{"id":"semetey-1-2013:p0403:b005:l030","ordinal":107813,"en":"She was a female lion, a mighty beast."},{"id":"semetey-1-2013:p0403:b005:l031","ordinal":107814,"en":"Your father Manas puffed and panted;"},{"id":"semetey-1-2013:p0403:b005:l032","ordinal":107815,"en":"Your warrior father could not bend down,"},{"id":"semetey-1-2013:p0403:b005:l033","ordinal":107816,"en":"For he had grown very fat."},{"id":"semetey-1-2013:p0403:b005:l034","ordinal":107817,"en":"Saikal came charging;"},{"id":"semetey-1-2013:p0403:b005:l035","ordinal":107818,"en":"The muscle about his ribs,"},{"id":"semetey-1-2013:p0403:b005:l036","ordinal":107819,"en":"She punched it as she swept past."},{"id":"semetey-1-2013:p0403:b005:l037","ordinal":107820,"en":"Coughing in great bursts,"},{"id":"semetey-1-2013:p0403:b005:l038","ordinal":107821,"en":"Like one stricken with grief,"},{"id":"semetey-1-2013:p0403:b005:l039","ordinal":107822,"en":"Your great hulking father Manas,"},{"id":"semetey-1-2013:p0404:b003:l001","ordinal":107823,"en":"Then she seized him;"},{"id":"semetey-1-2013:p0404:b003:l002","ordinal":107824,"en":"Maiden Saikal lifted him from his horse."},{"id":"semetey-1-2013:p0404:b003:l003","ordinal":107825,"en":"To throw him off his mount,"},{"id":"semetey-1-2013:p0404:b003:l004","ordinal":107826,"en":"Noble Saikal could not bring herself."},{"id":"semetey-1-2013:p0404:b003:l005","ordinal":107827,"en":"For bringing calamity upon the hero,"},{"id":"semetey-1-2013:p0404:b003:l006","ordinal":107828,"en":"Your warrior Saikal felt no shame."},{"id":"semetey-1-2013:p0404:b003:l007","ordinal":107829,"en":"Allah's sun grew overcast in the sky;"},{"id":"semetey-1-2013:p0404:b003:l008","ordinal":107830,"en":"Upon Maiden Saikal's head"},{"id":"semetey-1-2013:p0404:b003:l009","ordinal":107831,"en":"Sixty worries came at once:"},{"id":"semetey-1-2013:p0404:b003:l010","ordinal":107832,"en":"'This Khan Manas here"},{"id":"semetey-1-2013:p0404:b003:l011","ordinal":107833,"en":"Was a lion who slaughtered infidels;"},{"id":"semetey-1-2013:p0404:b003:l012","ordinal":107834,"en":"His fortune was complete."},{"id":"semetey-1-2013:p0404:b003:l013","ordinal":107835,"en":"When I looked within him,"},{"id":"semetey-1-2013:p0404:b003:l014","ordinal":107836,"en":"He was broader than the earth."},{"id":"semetey-1-2013:p0404:b003:l015","ordinal":107837,"en":"The youngest of six lions,"},{"id":"semetey-1-2013:p0404:b003:l016","ordinal":107838,"en":"God's beloved mortal,"},{"id":"semetey-1-2013:p0404:b003:l017","ordinal":107839,"en":"He was a mighty conquering warrior."},{"id":"semetey-1-2013:p0404:b003:l018","ordinal":107840,"en":"A soul like generous Sultan Manas,"},{"id":"semetey-1-2013:p0404:b003:l019","ordinal":107841,"en":"The Creator who fashions life"},{"id":"semetey-1-2013:p0404:b003:l020","ordinal":107842,"en":"Will not give again soon."},{"id":"semetey-1-2013:p0404:b003:l021","ordinal":107843,"en":"On my upland side are the Chinese;"},{"id":"semetey-1-2013:p0404:b003:l022","ordinal":107844,"en":"Above me are the Barang."},{"id":"semetey-1-2013:p0404:b003:l023","ordinal":107845,"en":"Many foes would contend with us."},{"id":"semetey-1-2013:p0404:b003:l024","ordinal":107846,"en":"\"A woman speared Manas,\" they will say."},{"id":"semetey-1-2013:p0404:b003:l025","ordinal":107847,"en":"A people of forty tribes:"},{"id":"semetey-1-2013:p0404:b003:l026","ordinal":107848,"en":"Will God strike the Chinese?"},{"id":"semetey-1-2013:p0404:b003:l027","ordinal":107849,"en":"He was the lion of the Muslims;"},{"id":"semetey-1-2013:p0404:b003:l028","ordinal":107850,"en":"Will Islam's backbone break?"},{"id":"semetey-1-2013:p0404:b003:l029","ordinal":107851,"en":"Konurbai in Kakan,"},{"id":"semetey-1-2013:p0404:b003:l030","ordinal":107852,"en":"Will he come pouring in"},{"id":"semetey-1-2013:p0404:b003:l031","ordinal":107853,"en":"And slaughter these Kyrgyz people?"},{"id":"semetey-1-2013:p0404:b003:l032","ordinal":107854,"en":"\"You acted fiercely,\" they will say;"},{"id":"semetey-1-2013:p0404:b003:l033","ordinal":107855,"en":"Will God strike me openly?"},{"id":"semetey-1-2013:p0404:b003:l034","ordinal":107856,"en":"The great Chinese people of forty tribes,"},{"id":"semetey-1-2013:p0404:b003:l035","ordinal":107857,"en":"If news reaches them and suddenly"},{"id":"semetey-1-2013:p0404:b003:l036","ordinal":107858,"en":"They come pouring in here,"},{"id":"semetey-1-2013:p0404:b003:l037","ordinal":107859,"en":"Unable to rescue them,"},{"id":"semetey-1-2013:p0404:b003:l038","ordinal":107860,"en":"Will my fortune plainly break?"},{"id":"semetey-1-2013:p0404:b003:l039","ordinal":107861,"en":"Will the people know my dog's deed?"},{"id":"semetey-1-2013:p0404:b004:l001","ordinal":107862,"en":"On the dawn of Judgment Day,"},{"id":"semetey-1-2013:p0404:b004:l002","ordinal":107863,"en":"If a Muslim looks upon it,"},{"id":"semetey-1-2013:p0404:b004:l003","ordinal":107864,"en":"Will they make a black donkey of me?"},{"id":"semetey-1-2013:p0404:b004:l004","ordinal":107865,"en":"Shoeing his white-gray horse,"},{"id":"semetey-1-2013:p0404:b004:l005","ordinal":107866,"en":"He was the lion of the Muslims."},{"id":"semetey-1-2013:p0404:b004:l006","ordinal":107867,"en":"\"You caused such suffering,\" he will say;"},{"id":"semetey-1-2013:p0404:b004:l007","ordinal":107868,"en":"Will he leave me, the unfortunate one, alone,"},{"id":"semetey-1-2013:p0404:b004:l008","ordinal":107869,"en":"Seizing my collar in a place of peril?"},{"id":"semetey-1-2013:p0404:b004:l009","ordinal":107870,"en":"He was a lion who laid infidels low;"},{"id":"semetey-1-2013:p0404:b004:l010","ordinal":107871,"en":"His fortune was complete.'"},{"id":"semetey-1-2013:p0404:b004:l011","ordinal":107872,"en":"So Maiden Saikal thought then."},{"id":"semetey-1-2013:p0404:b004:l012","ordinal":107873,"en":"Because of Judgment,"},{"id":"semetey-1-2013:p0404:b004:l013","ordinal":107874,"en":"And because that wretched hell exists,"},{"id":"semetey-1-2013:p0404:b004:l014","ordinal":107875,"en":"Your father Sultan Manas"},{"id":"semetey-1-2013:p0404:b004:l015","ordinal":107876,"en":"She set back upon his horse."},{"id":"semetey-1-2013:p0404:b004:l016","ordinal":107877,"en":"Just as she was doing so,"},{"id":"semetey-1-2013:p0404:b004:l017","ordinal":107878,"en":"Riding the horse Aisarala,"},{"id":"semetey-1-2013:p0404:b004:l018","ordinal":107879,"en":"Wearing yellow leather trousers,"},{"id":"semetey-1-2013:p0404:b004:l019","ordinal":107880,"en":"Carrying a spear without a tuft,"},{"id":"semetey-1-2013:p0404:b004:l020","ordinal":107881,"en":"A naked sword strapped at his side,"},{"id":"semetey-1-2013:p0404:b004:l021","ordinal":107882,"en":"Who fled darkness and became pure,"},{"id":"semetey-1-2013:p0404:b004:l022","ordinal":107883,"en":"Who turned away from the dark faith,"},{"id":"semetey-1-2013:p0404:b004:l023","ordinal":107884,"en":"A sharer of wealth while alive,"},{"id":"semetey-1-2013:p0404:b004:l024","ordinal":107885,"en":"A brother in faith when dead,"},{"id":"semetey-1-2013:p0404:b004:l025","ordinal":107886,"en":"One in soul when riding on raids,"},{"id":"semetey-1-2013:p0404:b004:l026","ordinal":107887,"en":"One in blood when entering battle,"},{"id":"semetey-1-2013:p0404:b004:l027","ordinal":107888,"en":"Sharing livestock while alive,"},{"id":"semetey-1-2013:p0404:b004:l028","ordinal":107889,"en":"Six kinds of stars stirred in the sky:"},{"id":"semetey-1-2013:p0404:b004:l030","ordinal":107890,"en":"With your father Manas the lion,"},{"id":"semetey-1-2013:p0404:b004:l031","ordinal":107891,"en":"He had been a friend through sixty journeys."},{"id":"semetey-1-2013:p0404:b004:l032","ordinal":107892,"en":"Stirred by his valor,"},{"id":"semetey-1-2013:p0404:b004:l033","ordinal":107893,"en":"At the pass of Yrgaity,"},{"id":"semetey-1-2013:p0404:b004:l034","ordinal":107894,"en":"As they swayed back and forth,"},{"id":"semetey-1-2013:p0404:b004:l035","ordinal":107895,"en":"At Karacha's Saikal,"},{"id":"semetey-1-2013:p0404:b004:l036","ordinal":107896,"en":"Charging from her flank,"},{"id":"semetey-1-2013:p0404:b004:l037","ordinal":107897,"en":"Your leopard Almam came upon her."},{"id":"semetey-1-2013:p0404:b004:l038","ordinal":107898,"en":"Striking Sarala on the thigh,"},{"id":"semetey-1-2013:p0404:b004:l039","ordinal":107899,"en":"Raising 'Khan Manas!' as his cry,"},{"id":"semetey-1-2013:p0405:b003:l001","ordinal":107900,"en":"He attacked Khan Saikal:"},{"id":"semetey-1-2013:p0405:b003:l002","ordinal":107901,"en":"“He was the lion who shattered the unbelievers,"},{"id":"semetey-1-2013:p0405:b003:l003","ordinal":107902,"en":"His world complete on every side."},{"id":"semetey-1-2013:p0405:b003:l004","ordinal":107903,"en":"You have struck my lord and made him sway—"},{"id":"semetey-1-2013:p0405:b003:l005","ordinal":107904,"en":"Woman, where did you come from?"},{"id":"semetey-1-2013:p0405:b003:l007","ordinal":107905,"en":"He was the lion who shattered China."},{"id":"semetey-1-2013:p0405:b003:l008","ordinal":107906,"en":"You struck my precious lord and grew arrogant—"},{"id":"semetey-1-2013:p0405:b003:l009","ordinal":107907,"en":"Woman, where did such a lion come from?"},{"id":"semetey-1-2013:p0405:b003:l011","ordinal":107908,"en":"Take your hand away!"},{"id":"semetey-1-2013:p0405:b003:l012","ordinal":107909,"en":"Now I shall do to you"},{"id":"semetey-1-2013:p0405:b003:l013","ordinal":107910,"en":"What no one has ever done!”"},{"id":"semetey-1-2013:p0405:b003:l014","ordinal":107911,"en":"Speaking thus, Almambet"},{"id":"semetey-1-2013:p0405:b003:l015","ordinal":107912,"en":"Charged at Saikal;"},{"id":"semetey-1-2013:p0405:b003:l016","ordinal":107913,"en":"They fought with spears upon the open plain."},{"id":"semetey-1-2013:p0405:b003:l017","ordinal":107914,"en":"There was no reckoning night or day."},{"id":"semetey-1-2013:p0405:b003:l018","ordinal":107915,"en":"Such is this filthy world!"},{"id":"semetey-1-2013:p0405:b003:l019","ordinal":107916,"en":"They wore one another out."},{"id":"semetey-1-2013:p0405:b003:l020","ordinal":107917,"en":"The dear lion suffered hardship;"},{"id":"semetey-1-2013:p0405:b003:l021","ordinal":107918,"en":"Your father, wolf-like Manas,"},{"id":"semetey-1-2013:p0405:b003:l022","ordinal":107919,"en":"They managed to rescue."},{"id":"semetey-1-2013:p0405:b003:l023","ordinal":107920,"en":"Hearing news from a messenger,"},{"id":"semetey-1-2013:p0405:b003:l024","ordinal":107921,"en":"I, your mother, dwelling in Talas,"},{"id":"semetey-1-2013:p0405:b003:l025","ordinal":107922,"en":"Heard that Karacha's Saikal"},{"id":"semetey-1-2013:p0405:b003:l026","ordinal":107923,"en":"Had overcome my wolf-like lord."},{"id":"semetey-1-2013:p0405:b003:l027","ordinal":107924,"en":"Hearing evil tidings in the rumors,"},{"id":"semetey-1-2013:p0405:b003:l028","ordinal":107925,"en":"I heard that formidable Saikal"},{"id":"semetey-1-2013:p0405:b003:l029","ordinal":107926,"en":"Had struck with her spear"},{"id":"semetey-1-2013:p0405:b003:l030","ordinal":107927,"en":"Your father Khan Manas, my wolf-like lord."},{"id":"semetey-1-2013:p0405:b003:l031","ordinal":107928,"en":"My wretched heart was torn,"},{"id":"semetey-1-2013:p0405:b003:l032","ordinal":107929,"en":"The tears poured from my eyes."},{"id":"semetey-1-2013:p0405:b003:l033","ordinal":107930,"en":"I could not rise, crying and wailing."},{"id":"semetey-1-2013:p0405:b003:l034","ordinal":107931,"en":"My strength of mind deserted me;"},{"id":"semetey-1-2013:p0405:b003:l035","ordinal":107932,"en":"I could find no smallest way out."},{"id":"semetey-1-2013:p0405:b003:l036","ordinal":107933,"en":"I had brought my khan to ruin,"},{"id":"semetey-1-2013:p0405:b003:l037","ordinal":107934,"en":"I had ruined my own condition."},{"id":"semetey-1-2013:p0405:b003:l038","ordinal":107935,"en":"My dear hair, thick as a saddle-girth,"},{"id":"semetey-1-2013:p0405:b003:l039","ordinal":107936,"en":"I bound tightly upon my crown."},{"id":"semetey-1-2013:p0405:b004:l001","ordinal":107937,"en":"My black, blaze-faced thoroughbred"},{"id":"semetey-1-2013:p0405:b004:l002","ordinal":107938,"en":"I saddled firmly and mounted."},{"id":"semetey-1-2013:p0405:b004:l003","ordinal":107939,"en":"I left Talas and journeyed on,"},{"id":"semetey-1-2013:p0405:b004:l004","ordinal":107940,"en":"Rode far, without sparing the horse."},{"id":"semetey-1-2013:p0405:b004:l005","ordinal":107941,"en":"I summered in Taragai."},{"id":"semetey-1-2013:p0405:b004:l006","ordinal":107942,"en":"When I reached Zhoo-Zhurok,"},{"id":"semetey-1-2013:p0405:b004:l007","ordinal":107943,"en":"I separated the young mares and tethered them for milking."},{"id":"semetey-1-2013:p0405:b004:l008","ordinal":107944,"en":"Because of your father,"},{"id":"semetey-1-2013:p0405:b004:l009","ordinal":107945,"en":"Because of the maiden Saikal,"},{"id":"semetey-1-2013:p0405:b004:l010","ordinal":107946,"en":"I, wretched and stricken with shame,"},{"id":"semetey-1-2013:p0405:b004:l011","ordinal":107947,"en":"Summered in that cold place."},{"id":"semetey-1-2013:p0405:b004:l012","ordinal":107948,"en":"My heart burned in secret."},{"id":"semetey-1-2013:p0405:b004:l013","ordinal":107949,"en":"To your empty-headed father"},{"id":"semetey-1-2013:p0405:b004:l014","ordinal":107950,"en":"I gave water, calling it kymyz."},{"id":"semetey-1-2013:p0405:b004:l015","ordinal":107951,"en":"The reason I gave it was this:"},{"id":"semetey-1-2013:p0405:b004:l016","ordinal":107952,"en":"That foolish wife Akylai,"},{"id":"semetey-1-2013:p0405:b004:l017","ordinal":107953,"en":"That witless wretch,"},{"id":"semetey-1-2013:p0405:b004:l018","ordinal":107954,"en":"Had sliced him horse-belly fat and given him honey,"},{"id":"semetey-1-2013:p0405:b004:l019","ordinal":107955,"en":"Sliced rump meat and given him neck fat,"},{"id":"semetey-1-2013:p0405:b004:l020","ordinal":107956,"en":"Fat lamb and a delicious head,"},{"id":"semetey-1-2013:p0405:b004:l021","ordinal":107957,"en":"Meat boiled through and through,"},{"id":"semetey-1-2013:p0405:b004:l022","ordinal":107958,"en":"Plenty of fattening food."},{"id":"semetey-1-2013:p0405:b004:l023","ordinal":107959,"en":"That witless mother of yours,"},{"id":"semetey-1-2013:p0405:b004:l024","ordinal":107960,"en":"Clinging constantly to Manas,"},{"id":"semetey-1-2013:p0405:b004:l025","ordinal":107961,"en":"Had made him terribly fat."},{"id":"semetey-1-2013:p0405:b004:l026","ordinal":107962,"en":"At the pass of Yrgaity,"},{"id":"semetey-1-2013:p0405:b004:l027","ordinal":107963,"en":"When they grappled to and fro,"},{"id":"semetey-1-2013:p0405:b004:l028","ordinal":107964,"en":"Your father, Khan Manas,"},{"id":"semetey-1-2013:p0405:b004:l029","ordinal":107965,"en":"Stood swollen with all that flesh."},{"id":"semetey-1-2013:p0405:b004:l030","ordinal":107966,"en":"Your father had grown so fat,"},{"id":"semetey-1-2013:p0405:b004:l031","ordinal":107967,"en":"So vast he could not bend."},{"id":"semetey-1-2013:p0405:b004:l032","ordinal":107968,"en":"Skillful Saikal struck him with her spear."},{"id":"semetey-1-2013:p0405:b004:l033","ordinal":107969,"en":"Your father had grown so fat"},{"id":"semetey-1-2013:p0405:b004:l034","ordinal":107970,"en":"That he could not bend."},{"id":"semetey-1-2013:p0405:b004:l035","ordinal":107971,"en":"In anguish I, poor soul, went there"},{"id":"semetey-1-2013:p0405:b004:l036","ordinal":107972,"en":"And summered in Taragai."},{"id":"semetey-1-2013:p0405:b004:l037","ordinal":107973,"en":"Without his knowing, with my own hands,"},{"id":"semetey-1-2013:p0405:b004:l038","ordinal":107974,"en":"I thus kept your foolish father,"},{"id":"semetey-1-2013:p0405:b004:l039","ordinal":107975,"en":"Manas, under restraint."},{"id":"semetey-1-2013:p0406:b003:l001","ordinal":107976,"en":"Into your father Sultan Manas"},{"id":"semetey-1-2013:p0406:b003:l002","ordinal":107977,"en":"I put a carving knife, as it were."},{"id":"semetey-1-2013:p0406:b003:l003","ordinal":107978,"en":"All the fat within him,"},{"id":"semetey-1-2013:p0406:b003:l004","ordinal":107979,"en":"I, your unfortunate mother,"},{"id":"semetey-1-2013:p0406:b003:l005","ordinal":107980,"en":"Removed by my own skill alone."},{"id":"semetey-1-2013:p0406:b003:l006","ordinal":107981,"en":"Ak-kula, the horse beneath him,"},{"id":"semetey-1-2013:p0406:b003:l007","ordinal":107982,"en":"I fed barley from a hanging feedbag,"},{"id":"semetey-1-2013:p0406:b003:l008","ordinal":107983,"en":"And trained him to a sweat each month."},{"id":"semetey-1-2013:p0406:b003:l009","ordinal":107984,"en":"I fed him barnyard millet from the rice fields,"},{"id":"semetey-1-2013:p0406:b003:l010","ordinal":107985,"en":"And trained him to a sweat every day."},{"id":"semetey-1-2013:p0406:b003:l011","ordinal":107986,"en":"Your father and Ak-kula,"},{"id":"semetey-1-2013:p0406:b003:l012","ordinal":107987,"en":"I brought them both into condition,"},{"id":"semetey-1-2013:p0406:b003:l013","ordinal":107988,"en":"Restraining them by my skill."},{"id":"semetey-1-2013:p0406:b003:l014","ordinal":107989,"en":"Then I let him loose at Saikal."},{"id":"semetey-1-2013:p0406:b003:l015","ordinal":107990,"en":"They went down Sapar-bai,"},{"id":"semetey-1-2013:p0406:b003:l016","ordinal":107991,"en":"Following the Zhaman-Suu."},{"id":"semetey-1-2013:p0406:b003:l017","ordinal":107992,"en":"They spared one another nothing."},{"id":"semetey-1-2013:p0406:b003:l018","ordinal":107993,"en":"The two champions faced each other,"},{"id":"semetey-1-2013:p0406:b003:l019","ordinal":107994,"en":"Shooting without mercy,"},{"id":"semetey-1-2013:p0406:b003:l020","ordinal":107995,"en":"Shaking powder from their leather flasks,"},{"id":"semetey-1-2013:p0406:b003:l021","ordinal":107996,"en":"Turning their steeds' heads,"},{"id":"semetey-1-2013:p0406:b003:l022","ordinal":107997,"en":"Thrusting with their spears,"},{"id":"semetey-1-2013:p0406:b003:l023","ordinal":107998,"en":"Fighting long without holding back."},{"id":"semetey-1-2013:p0406:b003:l024","ordinal":107999,"en":"She lost her presence of mind:"},{"id":"semetey-1-2013:p0406:b003:l025","ordinal":108000,"en":"Karacha's Saikal"},{"id":"semetey-1-2013:p0406:b003:l026","ordinal":108001,"en":"Fled toward those Oigut people."},{"id":"semetey-1-2013:p0406:b003:l027","ordinal":108002,"en":"When they reached the shifting sands,"},{"id":"semetey-1-2013:p0406:b003:l028","ordinal":108003,"en":"He plucked Saikal from her saddle."},{"id":"semetey-1-2013:p0406:b003:l029","ordinal":108004,"en":"When they came to the downward slope,"},{"id":"semetey-1-2013:p0406:b003:l030","ordinal":108005,"en":"He made her whimper outright,"},{"id":"semetey-1-2013:p0406:b003:l031","ordinal":108006,"en":"Brought Saikal back defeated,"},{"id":"semetey-1-2013:p0406:b003:l032","ordinal":108007,"en":"Slung her behind him like a feedbag."},{"id":"semetey-1-2013:p0406:b003:l033","ordinal":108008,"en":"Pledged to seven spiritual masters,"},{"id":"semetey-1-2013:p0406:b003:l034","ordinal":108009,"en":"My leopard Manas, my wolf-like lord,"},{"id":"semetey-1-2013:p0406:b003:l035","ordinal":108010,"en":"Then plucked Saikal up and brought her back."},{"id":"semetey-1-2013:p0406:b003:l036","ordinal":108011,"en":"Raging, humiliating her,"},{"id":"semetey-1-2013:p0406:b003:l037","ordinal":108012,"en":"Your father brought Karacha's Saikal"},{"id":"semetey-1-2013:p0406:b003:l038","ordinal":108013,"en":"Back by force."},{"id":"semetey-1-2013:p0406:b003:l039","ordinal":108014,"en":"Summoning mullahs from twelve peoples,"},{"id":"semetey-1-2013:p0406:b004:l001","ordinal":108015,"en":"Karacha's Saikal"},{"id":"semetey-1-2013:p0406:b004:l002","ordinal":108016,"en":"Your father brought home as his captive."},{"id":"semetey-1-2013:p0406:b004:l003","ordinal":108017,"en":"“This raging unbeliever,"},{"id":"semetey-1-2013:p0406:b004:l004","ordinal":108018,"en":"This sort of woman, has tormented me enough!”"},{"id":"semetey-1-2013:p0406:b004:l005","ordinal":108019,"en":"(Your father Manas blustered;"},{"id":"semetey-1-2013:p0406:b004:l006","ordinal":108020,"en":"Upon Karacha's Saikal"},{"id":"semetey-1-2013:p0406:b004:l007","ordinal":108021,"en":"He then imposed his will, swaggering.)"},{"id":"semetey-1-2013:p0406:b004:l008","ordinal":108022,"en":"“I was the lion who slew unbelievers;"},{"id":"semetey-1-2013:p0406:b004:l009","ordinal":108023,"en":"The eighteen thousand worlds"},{"id":"semetey-1-2013:p0406:b004:l010","ordinal":108024,"en":"Were mine to make submit."},{"id":"semetey-1-2013:p0406:b004:l011","ordinal":108025,"en":"A woman such as this,"},{"id":"semetey-1-2013:p0406:b004:l012","ordinal":108026,"en":"This raging unbeliever,"},{"id":"semetey-1-2013:p0406:b004:l013","ordinal":108027,"en":"I shall take to bed at high noon,"},{"id":"semetey-1-2013:p0406:b004:l014","ordinal":108028,"en":"And have my pleasure."},{"id":"semetey-1-2013:p0406:b004:l015","ordinal":108029,"en":"Draw the bridal curtain here,"},{"id":"semetey-1-2013:p0406:b004:l016","ordinal":108030,"en":"Lay out a spacious bed!”"},{"id":"semetey-1-2013:p0406:b004:l017","ordinal":108031,"en":"(He swaggered, humiliating her,"},{"id":"semetey-1-2013:p0406:b004:l018","ordinal":108032,"en":"Humiliating Saikal;"}]
