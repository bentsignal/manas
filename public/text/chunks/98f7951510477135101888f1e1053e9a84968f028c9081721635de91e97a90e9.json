[{"id":"manas-2010:p0726:b001:l005","ordinal":32257,"en":"Readying itself to charge,"},{"id":"manas-2010:p0726:b001:l006","ordinal":32258,"en":"Had gone ahead of him."},{"id":"manas-2010:p0726:b001:l007","ordinal":32259,"en":"A short-tailed, wolf-maned lion,"},{"id":"manas-2010:p0726:b001:l008","ordinal":32260,"en":"The companion of your bloodthirsty hero,"},{"id":"manas-2010:p0726:b001:l009","ordinal":32261,"en":"Looking to either side,"},{"id":"manas-2010:p0726:b001:l010","ordinal":32262,"en":"Licking its lips and muzzle,"},{"id":"manas-2010:p0726:b001:l011","ordinal":32263,"en":"As though about to seize someone,"},{"id":"manas-2010:p0726:b001:l012","ordinal":32264,"en":"The lion hero's attendant,"},{"id":"manas-2010:p0726:b001:l013","ordinal":32265,"en":"Gave support from behind."},{"id":"manas-2010:p0726:b001:l014","ordinal":32266,"en":"One of the forty guardians, a gray tiger,"},{"id":"manas-2010:p0726:b001:l015","ordinal":32267,"en":"The bloodthirsty hero's attendant,"},{"id":"manas-2010:p0726:b001:l016","ordinal":32268,"en":"Accompanied him closely."},{"id":"manas-2010:p0726:b001:l017","ordinal":32269,"en":"The giant black bird, Zymyryk,"},{"id":"manas-2010:p0726:b001:l018","ordinal":32270,"en":"As though about to carry someone off,"},{"id":"manas-2010:p0726:b001:l019","ordinal":32271,"en":"Thrust its feet down from the sky."},{"id":"manas-2010:p0726:b001:l020","ordinal":32272,"en":"The forty guardians and Kydyr Niyaz,"},{"id":"manas-2010:p0726:b001:l021","ordinal":32273,"en":"Appearing like forty thousand troops,"},{"id":"manas-2010:p0726:b001:l022","ordinal":32274,"en":"Their spears swaying,"},{"id":"manas-2010:p0726:b001:l023","ordinal":32275,"en":"As though about to slaughter everyone,"},{"id":"manas-2010:p0726:b001:l024","ordinal":32276,"en":"Extended them from ridge after ridge."},{"id":"manas-2010:p0726:b001:l025","ordinal":32277,"en":"The naked saint Kydyr"},{"id":"manas-2010:p0726:b001:l026","ordinal":32278,"en":"Stood holding the bridle."},{"id":"manas-2010:p0726:b001:l027","ordinal":32279,"en":"The nine who supported him"},{"id":"manas-2010:p0726:b001:l028","ordinal":32280,"en":"Had now taken him under their protection."},{"id":"manas-2010:p0726:b001:l029","ordinal":32281,"en":"Before one could walk around a house,"},{"id":"manas-2010:p0726:b001:l030","ordinal":32282,"en":"A red willow the size of a house sprang up;"},{"id":"manas-2010:p0726:b001:l031","ordinal":32283,"en":"God became his ally from above."},{"id":"manas-2010:p0726:b001:l032","ordinal":32284,"en":"Father Shay and Kydyr, the two together,"},{"id":"manas-2010:p0726:b001:l033","ordinal":32285,"en":"Making his dun horse prance,"},{"id":"manas-2010:p0726:b001:l034","ordinal":32286,"en":"Twelve champions led it."},{"id":"manas-2010:p0726:b001:l035","ordinal":32287,"en":"A golden throne as large as a camel"},{"id":"manas-2010:p0726:b001:l036","ordinal":32288,"en":"They had loaded on Aybanboz."},{"id":"manas-2010:p0726:b001:l037","ordinal":32289,"en":"Your valiant one whom Kydyr had blessed,"},{"id":"manas-2010:p0726:b001:l038","ordinal":32290,"en":"Not merely Alöökö, but the world,"},{"id":"manas-2010:p0726:b001:l039","ordinal":32291,"en":"He had the strength to overturn."},{"id":"manas-2010:p0726:b001:l040","ordinal":32292,"en":"Looking from the ridges,"},{"id":"manas-2010:p0726:b001:l041","ordinal":32293,"en":"Of dear, valiant Manas,"},{"id":"manas-2010:p0726:b001:l042","ordinal":32294,"en":"His formidable bearing could be seen,"},{"id":"manas-2010:p0727:b001:l001","ordinal":32295,"en":"‘He is a hero, he is a lion."},{"id":"manas-2010:p0727:b001:l002","ordinal":32296,"en":"While the valiant wolf-maned one is here,"},{"id":"manas-2010:p0727:b001:l003","ordinal":32297,"en":"Not merely Alöökö, but the world,"},{"id":"manas-2010:p0727:b001:l004","ordinal":32298,"en":"He has the power to conquer."},{"id":"manas-2010:p0727:b001:l005","ordinal":32299,"en":"Who has traveled so blessed by Kydyr?"},{"id":"manas-2010:p0727:b001:l006","ordinal":32300,"en":"Not merely Alöökö, but upon the world,"},{"id":"manas-2010:p0727:b001:l007","ordinal":32301,"en":"Your wolf-maned lion Manas"},{"id":"manas-2010:p0727:b001:l008","ordinal":32302,"en":"Will unleash a mighty turmoil."},{"id":"manas-2010:p0727:b001:l009","ordinal":32303,"en":"Akkula beneath him"},{"id":"manas-2010:p0727:b001:l010","ordinal":32304,"en":"Is a beast given by Allah."},{"id":"manas-2010:p0727:b001:l011","ordinal":32305,"en":"Khan Manas upon him"},{"id":"manas-2010:p0727:b001:l012","ordinal":32306,"en":"This whole vast world"},{"id":"manas-2010:p0727:b001:l013","ordinal":32307,"en":"Is a man able to rule."},{"id":"manas-2010:p0727:b001:l014","ordinal":32308,"en":"His signs are clearly visible."},{"id":"manas-2010:p0727:b001:l015","ordinal":32309,"en":"Who has walked like this champion?"},{"id":"manas-2010:p0727:b001:l016","ordinal":32310,"en":"I have been afraid for nothing."},{"id":"manas-2010:p0727:b001:l017","ordinal":32311,"en":"Upon those who confront him, this Manas"},{"id":"manas-2010:p0727:b001:l018","ordinal":32312,"en":"Will unleash a mighty turmoil."},{"id":"manas-2010:p0727:b001:l019","ordinal":32313,"en":"Against the seething Chinese,"},{"id":"manas-2010:p0727:b001:l020","ordinal":32314,"en":"Let me try charging alongside him."},{"id":"manas-2010:p0727:b001:l021","ordinal":32315,"en":"For your bloodthirsty hero himself,"},{"id":"manas-2010:p0727:b001:l022","ordinal":32316,"en":"Let me be a support."},{"id":"manas-2010:p0727:b001:l023","ordinal":32317,"en":"Let me somehow find a way,"},{"id":"manas-2010:p0727:b001:l024","ordinal":32318,"en":"Fighting with skill,"},{"id":"manas-2010:p0727:b001:l025","ordinal":32319,"en":"Let me keep my dear Manas safe."},{"id":"manas-2010:p0727:b001:l026","ordinal":32320,"en":"While my lion Manas stands here,"},{"id":"manas-2010:p0727:b001:l027","ordinal":32321,"en":"Not just the Chinese, but the world's"},{"id":"manas-2010:p0727:b001:l028","ordinal":32322,"en":"Khanly power let me seize."},{"id":"manas-2010:p0727:b001:l029","ordinal":32323,"en":"Alöökö seems an unbeliever;"},{"id":"manas-2010:p0727:b001:l030","ordinal":32324,"en":"Let me grapple with him.’"},{"id":"manas-2010:p0727:b001:l031","ordinal":32325,"en":"Thus speaking, mighty Bakay,"},{"id":"manas-2010:p0727:b001:l032","ordinal":32326,"en":"Rejoicing at the sight of Manas,"},{"id":"manas-2010:p0727:b001:l033","ordinal":32327,"en":"Said this to the warrior lion:"},{"id":"manas-2010:p0727:b001:l034","ordinal":32328,"en":"‘Your raid has found good fortune."},{"id":"manas-2010:p0727:b001:l035","ordinal":32329,"en":"What you seek has camped upon the road."},{"id":"manas-2010:p0727:b001:l036","ordinal":32330,"en":"My valiant one whom Kydyr has blessed,"},{"id":"manas-2010:p0727:b001:l037","ordinal":32331,"en":"The time has come to slaughter one another."},{"id":"manas-2010:p0727:b001:l038","ordinal":32332,"en":"My hawk who will see us through,"},{"id":"manas-2010:p0727:b001:l039","ordinal":32333,"en":"The moment has come to die together."},{"id":"manas-2010:p0727:b001:l040","ordinal":32334,"en":"What you seek has camped upon the road;"},{"id":"manas-2010:p0727:b001:l041","ordinal":32335,"en":"Your raid has found good fortune."},{"id":"manas-2010:p0727:b001:l042","ordinal":32336,"en":"My stately bloodthirsty one,"},{"id":"manas-2010:p0728:b001:l001","ordinal":32337,"en":"Did you see what I saw?"},{"id":"manas-2010:p0728:b001:l002","ordinal":32338,"en":"Did you learn what I learned?"},{"id":"manas-2010:p0728:b001:l003","ordinal":32339,"en":"My hawk, not born for nothing,"},{"id":"manas-2010:p0728:b001:l004","ordinal":32340,"en":"God has granted your desire."},{"id":"manas-2010:p0728:b001:l005","ordinal":32341,"en":"Your chosen enemy, Alöökö,"},{"id":"manas-2010:p0728:b001:l006","ordinal":32342,"en":"Has come straight before you."},{"id":"manas-2010:p0728:b001:l007","ordinal":32343,"en":"Did you see what I saw?"},{"id":"manas-2010:p0728:b001:l008","ordinal":32344,"en":"Did you perceive what I perceived?"},{"id":"manas-2010:p0728:b001:l009","ordinal":32345,"en":"The one you would pursue as far as Beijing,"},{"id":"manas-2010:p0728:b001:l010","ordinal":32346,"en":"Your tent with golden pillars,"},{"id":"manas-2010:p0728:b001:l011","ordinal":32347,"en":"Has appeared before you,"},{"id":"manas-2010:p0728:b001:l012","ordinal":32348,"en":"Your warrior, hero Alöökö."},{"id":"manas-2010:p0728:b001:l013","ordinal":32349,"en":"Yesterday, in the hollow of Zhylgynduu,"},{"id":"manas-2010:p0728:b001:l014","ordinal":32350,"en":"Beside broad Talas,"},{"id":"manas-2010:p0728:b001:l015","ordinal":32351,"en":"Not only Talas, but many places,"},{"id":"manas-2010:p0728:b001:l016","ordinal":32352,"en":"Grinding them like meal, across much land,"},{"id":"manas-2010:p0728:b001:l017","ordinal":32353,"en":"You said you would guard your realm."},{"id":"manas-2010:p0728:b001:l018","ordinal":32354,"en":"“If I encounter Alöökö,"},{"id":"manas-2010:p0728:b001:l019","ordinal":32355,"en":"Without letting him say this or that,"},{"id":"manas-2010:p0728:b001:l020","ordinal":32356,"en":"I will suck him dry,” you said."},{"id":"manas-2010:p0728:b001:l021","ordinal":32357,"en":"If you enter the throng, here is the dust!"},{"id":"manas-2010:p0728:b001:l022","ordinal":32358,"en":"If you would slaughter, there are the Chinese!"},{"id":"manas-2010:p0728:b001:l023","ordinal":32359,"en":"Since you migrated from Altay,"},{"id":"manas-2010:p0728:b001:l024","ordinal":32360,"en":"Your fame has been Generous."},{"id":"manas-2010:p0728:b001:l025","ordinal":32361,"en":"Attacking Alöökö,"},{"id":"manas-2010:p0728:b001:l026","ordinal":32362,"en":"Your strife has grown, warrior."},{"id":"manas-2010:p0728:b001:l027","ordinal":32363,"en":"Khan Alöökö is a hero;"},{"id":"manas-2010:p0728:b001:l028","ordinal":32364,"en":"The soldiers he has gathered"},{"id":"manas-2010:p0728:b001:l029","ordinal":32365,"en":"Are more numerous than ants.’"},{"id":"manas-2010:p0728:b001:l030","ordinal":32366,"en":"While Bakay was speaking,"},{"id":"manas-2010:p0728:b001:l031","ordinal":32367,"en":"Their elders with Kyrgyl at their head,"},{"id":"manas-2010:p0728:b001:l032","ordinal":32368,"en":"To raise a cry and attack,"},{"id":"manas-2010:p0728:b001:l033","ordinal":32369,"en":"Quivered then,"},{"id":"manas-2010:p0728:b001:l034","ordinal":32370,"en":"All the forty champions."},{"id":"manas-2010:p0728:b001:l035","ordinal":32371,"en":"While he was speaking to Manas,"},{"id":"manas-2010:p0728:b001:l036","ordinal":32372,"en":"While he offered much counsel,"},{"id":"manas-2010:p0728:b001:l037","ordinal":32373,"en":"From the ridge of Kashalay,"},{"id":"manas-2010:p0728:b001:l038","ordinal":32374,"en":"The lookout had come fleeing."},{"id":"manas-2010:p0728:b001:l039","ordinal":32375,"en":"To warrior Khan Alöökö,"},{"id":"manas-2010:p0728:b001:l040","ordinal":32376,"en":"To the unbeliever full of vigor,"},{"id":"manas-2010:p0728:b001:l041","ordinal":32377,"en":"He had brought an urgent report."},{"id":"manas-2010:p0728:b001:l042","ordinal":32378,"en":"Hurrying, stumbling in alarm,"},{"id":"manas-2010:p0729:b001:l001","ordinal":32379,"en":"Trampling over his guards,"},{"id":"manas-2010:p0729:b001:l002","ordinal":32380,"en":"All the champions"},{"id":"manas-2010:p0729:b001:l003","ordinal":32381,"en":"Scolding, ‘Make ready!’"},{"id":"manas-2010:p0729:b001:l004","ordinal":32382,"en":"To the tent with golden pillars,"},{"id":"manas-2010:p0729:b001:l005","ordinal":32383,"en":"The lookouts brought their report,"},{"id":"manas-2010:p0729:b001:l006","ordinal":32384,"en":"To a warrior like Alöökö."},{"id":"manas-2010:p0729:b001:l007","ordinal":32385,"en":"‘Hero Alöökö, warrior khan,"},{"id":"manas-2010:p0729:b001:l008","ordinal":32386,"en":"Did you see what I saw?"},{"id":"manas-2010:p0729:b001:l009","ordinal":32387,"en":"Did you learn what I learned?"},{"id":"manas-2010:p0729:b001:l010","ordinal":32388,"en":"Does sleeping not satisfy sleep?"},{"id":"manas-2010:p0729:b001:l011","ordinal":32389,"en":"Does lying down not weary the hips?"},{"id":"manas-2010:p0729:b001:l012","ordinal":32390,"en":"Send a letter flying to Great Beijing."},{"id":"manas-2010:p0729:b001:l013","ordinal":32391,"en":"If you send a letter, send it swiftly!"},{"id":"manas-2010:p0729:b001:l014","ordinal":32392,"en":"A deeply dug pit has come,"},{"id":"manas-2010:p0729:b001:l015","ordinal":32393,"en":"Seething misery has come."},{"id":"manas-2010:p0729:b001:l016","ordinal":32394,"en":"From the side where the sun sets,"},{"id":"manas-2010:p0729:b001:l017","ordinal":32395,"en":"Dust rose in surging clouds."},{"id":"manas-2010:p0729:b001:l018","ordinal":32396,"en":"Unable to withstand the dust,"},{"id":"manas-2010:p0729:b001:l019","ordinal":32397,"en":"Consider it: my soul left me."},{"id":"manas-2010:p0729:b001:l020","ordinal":32398,"en":"Wearing a gray lynx-fur cap,"},{"id":"manas-2010:p0729:b001:l021","ordinal":32399,"en":"Riding a horse like a gray wondrous steed,"},{"id":"manas-2010:p0729:b001:l022","ordinal":32400,"en":"One had come out on patrol."},{"id":"manas-2010:p0729:b001:l023","ordinal":32401,"en":"Your secrets and your true condition,"},{"id":"manas-2010:p0729:b001:l024","ordinal":32402,"en":"He had examined and assessed."},{"id":"manas-2010:p0729:b001:l025","ordinal":32403,"en":"While that one was watching,"},{"id":"manas-2010:p0729:b001:l026","ordinal":32404,"en":"Wearing coats no bullet could pierce,"},{"id":"manas-2010:p0729:b001:l027","ordinal":32405,"en":"Riding horses no bullet could catch,"},{"id":"manas-2010:p0729:b001:l028","ordinal":32406,"en":"Forty-one men appeared on the ridge."},{"id":"manas-2010:p0729:b001:l029","ordinal":32407,"en":"When I observed his manner,"},{"id":"manas-2010:p0729:b001:l030","ordinal":32408,"en":"It was the daughter-damned bloodthirsty one himself."},{"id":"manas-2010:p0729:b001:l031","ordinal":32409,"en":"Relentlessly following your trail,"},{"id":"manas-2010:p0729:b001:l032","ordinal":32410,"en":"He has pursued you till he wastes away."},{"id":"manas-2010:p0729:b001:l033","ordinal":32411,"en":"If you flee to your right,"},{"id":"manas-2010:p0729:b001:l034","ordinal":32412,"en":"You come to a desert where men perish."},{"id":"manas-2010:p0729:b001:l035","ordinal":32413,"en":"If you flee to your left,"},{"id":"manas-2010:p0729:b001:l036","ordinal":32414,"en":"There is no path for slipping away;"},{"id":"manas-2010:p0729:b001:l037","ordinal":32415,"en":"You come to a ridge where you will die trapped."},{"id":"manas-2010:p0729:b001:l038","ordinal":32416,"en":"Khan Alöökö, ready your horse!"},{"id":"manas-2010:p0729:b001:l039","ordinal":32417,"en":"Devastating bows and painted arrows,"},{"id":"manas-2010:p0729:b001:l040","ordinal":32418,"en":"We shall see them over the moving caravan."},{"id":"manas-2010:p0729:b001:l041","ordinal":32419,"en":"Ready your soldiers swiftly!’"},{"id":"manas-2010:p0729:b001:l042","ordinal":32420,"en":"After the messenger said this,"},{"id":"manas-2010:p0730:b001:l001","ordinal":32421,"en":"The warrior Khan Alöökö,"},{"id":"manas-2010:p0730:b001:l002","ordinal":32422,"en":"To Khan Kutka beside him,"},{"id":"manas-2010:p0730:b001:l003","ordinal":32423,"en":"Alöökö sent word,"},{"id":"manas-2010:p0730:b001:l004","ordinal":32424,"en":"And to all the champions."},{"id":"manas-2010:p0730:b001:l005","ordinal":32425,"en":"Summoning a thousand soldiers,"},{"id":"manas-2010:p0730:b001:l006","ordinal":32426,"en":"Alöökö's signal"},{"id":"manas-2010:p0730:b001:l007","ordinal":32427,"en":"Was a drum of elephant hide,"},{"id":"manas-2010:p0730:b001:l008","ordinal":32428,"en":"Four armspans in girth."},{"id":"manas-2010:p0730:b001:l009","ordinal":32429,"en":"If you hear its voice, flee far!"},{"id":"manas-2010:p0730:b001:l010","ordinal":32430,"en":"His champion beats it in a crisis;"},{"id":"manas-2010:p0730:b001:l011","ordinal":32431,"en":"An ordinary ear"},{"id":"manas-2010:p0730:b001:l012","ordinal":32432,"en":"Is simply torn to shreds."},{"id":"manas-2010:p0730:b001:l013","ordinal":32433,"en":"The drum was beaten hard."},{"id":"manas-2010:p0730:b001:l014","ordinal":32434,"en":"Those who tended pack beasts and loaded baggage"},{"id":"manas-2010:p0730:b001:l015","ordinal":32435,"en":"Rushed each to his camel."},{"id":"manas-2010:p0730:b001:l016","ordinal":32436,"en":"To warrior Alöökö,"},{"id":"manas-2010:p0730:b001:l017","ordinal":32437,"en":"The alarm appeared grave."},{"id":"manas-2010:p0730:b001:l018","ordinal":32438,"en":"The boiling traveling pot"},{"id":"manas-2010:p0730:b001:l019","ordinal":32439,"en":"Was spilled upon the hearth."},{"id":"manas-2010:p0730:b001:l020","ordinal":32440,"en":"The governors prepared to mount."},{"id":"manas-2010:p0730:b001:l021","ordinal":32441,"en":"Torguts and Manchus raised a clamor,"},{"id":"manas-2010:p0730:b001:l022","ordinal":32442,"en":"And rushed each to his horse."},{"id":"manas-2010:p0730:b001:l023","ordinal":32443,"en":"Beside Alöökö,"},{"id":"manas-2010:p0730:b001:l024","ordinal":32444,"en":"His chief official Tagylyk,"},{"id":"manas-2010:p0730:b001:l025","ordinal":32445,"en":"Of ill-omened unbelievers,"},{"id":"manas-2010:p0730:b001:l026","ordinal":32446,"en":"Many officials swarmed about."},{"id":"manas-2010:p0730:b001:l027","ordinal":32447,"en":"Long trumpets and reed horns sounded."},{"id":"manas-2010:p0730:b001:l028","ordinal":32448,"en":"Gold was loaded on the rhinoceroses."},{"id":"manas-2010:p0730:b001:l029","ordinal":32449,"en":"The champions, scurrying,"},{"id":"manas-2010:p0730:b001:l030","ordinal":32450,"en":"Ran in haste,"},{"id":"manas-2010:p0730:b001:l031","ordinal":32451,"en":"Surging in utter confusion,"},{"id":"manas-2010:p0730:b001:l032","ordinal":32452,"en":"Calling out, ‘Move along!’"},{"id":"manas-2010:p0730:b001:l033","ordinal":32453,"en":"Hurrying, stumbling in alarm,"},{"id":"manas-2010:p0730:b001:l034","ordinal":32454,"en":"All the wretched ones,"},{"id":"manas-2010:p0730:b001:l035","ordinal":32455,"en":"Unable to find their own mounts,"},{"id":"manas-2010:p0730:b001:l036","ordinal":32456,"en":"Clung to other horses."},{"id":"manas-2010:p0730:b001:l037","ordinal":32457,"en":"Their quarrels grew fierce."},{"id":"manas-2010:p0730:b001:l038","ordinal":32458,"en":"‘Find your own horse and ride it!’ they said,"},{"id":"manas-2010:p0730:b001:l039","ordinal":32459,"en":"And those who mounted another man's horse,"},{"id":"manas-2010:p0730:b001:l040","ordinal":32460,"en":"They pulled down rolling."},{"id":"manas-2010:p0730:b001:l041","ordinal":32461,"en":"Spears wavering in their hands,"},{"id":"manas-2010:p0730:b001:l042","ordinal":32462,"en":"They lurched and staggered,"},{"id":"manas-2010:p0731:b001:l001","ordinal":32463,"en":"Unable to load their gold,"},{"id":"manas-2010:p0731:b001:l002","ordinal":32464,"en":"Some of it taking two men together."},{"id":"manas-2010:p0731:b001:l003","ordinal":32465,"en":"Some babbled,"},{"id":"manas-2010:p0731:b001:l004","ordinal":32466,"en":"‘The gold has been left behind!’"},{"id":"manas-2010:p0731:b001:l005","ordinal":32467,"en":"Leading their unladen horses,"},{"id":"manas-2010:p0731:b001:l006","ordinal":32468,"en":"Helpless, they hurried,"},{"id":"manas-2010:p0731:b001:l007","ordinal":32469,"en":"Fleeing this way and that,"},{"id":"manas-2010:p0731:b001:l008","ordinal":32470,"en":"Finding no grave to enter,"},{"id":"manas-2010:p0731:b001:l009","ordinal":32471,"en":"Finding no place to flee."},{"id":"manas-2010:p0731:b001:l010","ordinal":32472,"en":"Terrible havoc, a great quarrel,"},{"id":"manas-2010:p0731:b001:l011","ordinal":32473,"en":"Now broke out."},{"id":"manas-2010:p0731:b001:l012","ordinal":32474,"en":"A shout came from in front."},{"id":"manas-2010:p0731:b001:l013","ordinal":32475,"en":"Forty-one men emerged from the cliff,"},{"id":"manas-2010:p0731:b001:l014","ordinal":32476,"en":"Raising the battle cry, ‘Manas!’"},{"id":"manas-2010:p0731:b001:l015","ordinal":32477,"en":"The shouting deafened ears."},{"id":"manas-2010:p0731:b001:l016","ordinal":32478,"en":"The white standard became their banner."},{"id":"manas-2010:p0731:b001:l017","ordinal":32479,"en":"The campaign against Alöökö"},{"id":"manas-2010:p0731:b001:l018","ordinal":32480,"en":"Became a shouting uproar."},{"id":"manas-2010:p0731:b001:l019","ordinal":32481,"en":"Shrill cries and fierce cheering!"},{"id":"manas-2010:p0731:b001:l020","ordinal":32482,"en":"Speeding on his gray wondrous steed,"},{"id":"manas-2010:p0731:b001:l021","ordinal":32483,"en":"Bearing a blue-mottled banner,"},{"id":"manas-2010:p0731:b001:l022","ordinal":32484,"en":"Your elder, wolf-maned Bakay,"},{"id":"manas-2010:p0731:b001:l023","ordinal":32485,"en":"Appeared at the very front."},{"id":"manas-2010:p0731:b001:l024","ordinal":32486,"en":"From behind came a shout."},{"id":"manas-2010:p0731:b001:l025","ordinal":32487,"en":"Riding his mountain-sized dun horse,"},{"id":"manas-2010:p0731:b001:l026","ordinal":32488,"en":"Wolf-maned Khan Manas wheeled about,"},{"id":"manas-2010:p0731:b001:l027","ordinal":32489,"en":"Raising the battle cry, ‘Manas!’"},{"id":"manas-2010:p0731:b001:l028","ordinal":32490,"en":"His pieces of war gear numbered eighty-four;"},{"id":"manas-2010:p0731:b001:l029","ordinal":32491,"en":"Wherever he struck was red fire."},{"id":"manas-2010:p0731:b001:l030","ordinal":32492,"en":"The Gray Belt that descended from the sky,"},{"id":"manas-2010:p0731:b001:l031","ordinal":32493,"en":"Girding on the Gray Belt,"},{"id":"manas-2010:p0731:b001:l032","ordinal":32494,"en":"Into the tent with golden pillars,"},{"id":"manas-2010:p0731:b001:l033","ordinal":32495,"en":"Against a warrior like Alöökö,"},{"id":"manas-2010:p0731:b001:l034","ordinal":32496,"en":"Manas charged in attack."},{"id":"manas-2010:p0731:b001:l035","ordinal":32497,"en":"From the near approach, Azhybay"},{"id":"manas-2010:p0731:b001:l036","ordinal":32498,"en":"Shouted and thrust his spear."},{"id":"manas-2010:p0731:b001:l037","ordinal":32499,"en":"Shrill cries and fierce cheering!"},{"id":"manas-2010:p0731:b001:l038","ordinal":32500,"en":"Your elder Bakay, bringing good fortune,"},{"id":"manas-2010:p0731:b001:l039","ordinal":32501,"en":"His belt firmly girded,"},{"id":"manas-2010:p0731:b001:l040","ordinal":32502,"en":"Against the Manchus covering the ground,"},{"id":"manas-2010:p0731:b001:l041","ordinal":32503,"en":"Had reached them and attacked."},{"id":"manas-2010:p0731:b001:l042","ordinal":32504,"en":"Bakay was no less than Manas,"},{"id":"manas-2010:p0732:b001:l001","ordinal":32505,"en":"He was no hero to be slighted."},{"id":"manas-2010:p0732:b001:l002","ordinal":32506,"en":"Earth flew, dust boiled,"},{"id":"manas-2010:p0732:b001:l003","ordinal":32507,"en":"Heroes died, eyes flashed."},{"id":"manas-2010:p0732:b001:l004","ordinal":32508,"en":"Standing face to face,"},{"id":"manas-2010:p0732:b001:l005","ordinal":32509,"en":"Firing guns and drawing bows,"},{"id":"manas-2010:p0732:b001:l006","ordinal":32510,"en":"They battled with booming blows."},{"id":"manas-2010:p0732:b001:l007","ordinal":32511,"en":"The bloodthirsty lion beloved by God,"},{"id":"manas-2010:p0732:b001:l008","ordinal":32512,"en":"That was where he wrought havoc."}]
