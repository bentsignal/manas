[{"id":"manas-2010:p1679:b001:l018","ordinal":72193,"en":"The ravenous-mouthed white short musket"},{"id":"manas-2010:p1679:b001:l019","ordinal":72194,"en":"He seized and fired a thousand times;"},{"id":"manas-2010:p1679:b001:l020","ordinal":72195,"en":"Kojozhash did not tire."},{"id":"manas-2010:p1679:b001:l021","ordinal":72196,"en":"The lacquered musket in his hand,"},{"id":"manas-2010:p1679:b001:l022","ordinal":72197,"en":"Almambet moved with it;"},{"id":"manas-2010:p1679:b001:l023","ordinal":72198,"en":"Leaning right, he fired once,"},{"id":"manas-2010:p1679:b001:l024","ordinal":72199,"en":"Felling ten or more;"},{"id":"manas-2010:p1679:b001:l025","ordinal":72200,"en":"Leaning left, he fired once,"},{"id":"manas-2010:p1679:b001:l026","ordinal":72201,"en":"Dear Alma felled their sultans."},{"id":"manas-2010:p1679:b001:l027","ordinal":72202,"en":"The distant black unbelievers"},{"id":"manas-2010:p1679:b001:l028","ordinal":72203,"en":"He struck with his musket;"},{"id":"manas-2010:p1679:b001:l029","ordinal":72204,"en":"Those who came close before him,"},{"id":"manas-2010:p1679:b001:l030","ordinal":72205,"en":"Your Alma stabbed with his lacquered lance."},{"id":"manas-2010:p1679:b001:l031","ordinal":72206,"en":"A banner of mottled gray appeared;"},{"id":"manas-2010:p1679:b001:l032","ordinal":72207,"en":"The Chinese raised a din of lamentation."},{"id":"manas-2010:p1679:b001:l033","ordinal":72208,"en":"The Chinese fled in confusion,"},{"id":"manas-2010:p1679:b001:l034","ordinal":72209,"en":"Pleading with wretched Kojozhash."},{"id":"manas-2010:p1679:b001:l035","ordinal":72210,"en":"Howling, the Chinese ran;"},{"id":"manas-2010:p1679:b001:l036","ordinal":72211,"en":"At the sight of Almambet's bearing,"},{"id":"manas-2010:p1679:b001:l037","ordinal":72212,"en":"They despaired of their dear lives."},{"id":"manas-2010:p1679:b001:l038","ordinal":72213,"en":"The lacquered lance with its steel tip,"},{"id":"manas-2010:p1679:b001:l039","ordinal":72214,"en":"Your mighty lord Alma"},{"id":"manas-2010:p1679:b001:l040","ordinal":72215,"en":"Firmly gripped and swung,"},{"id":"manas-2010:p1679:b001:l041","ordinal":72216,"en":"The pockmarked Chinese army's countless"},{"id":"manas-2010:p1679:b001:l042","ordinal":72217,"en":"Ranks he broke apart,"},{"id":"manas-2010:p1680:b001:l001","ordinal":72218,"en":"He crushed six thousand,"},{"id":"manas-2010:p1680:b001:l002","ordinal":72219,"en":"Calling, “Where is the fighting swine?”"},{"id":"manas-2010:p1680:b001:l003","ordinal":72220,"en":"He crushed seven thousand,"},{"id":"manas-2010:p1680:b001:l004","ordinal":72221,"en":"Calling, “Where is that consummate one,"},{"id":"manas-2010:p1680:b001:l005","ordinal":72222,"en":"That fool Kojozhash?”"},{"id":"manas-2010:p1680:b001:l006","ordinal":72223,"en":"The whole world was stirred;"},{"id":"manas-2010:p1680:b001:l007","ordinal":72224,"en":"Kalmyks and countless governors were slaughtered,"},{"id":"manas-2010:p1680:b001:l008","ordinal":72225,"en":"Their uproar rose in dust."},{"id":"manas-2010:p1680:b001:l009","ordinal":72226,"en":"The formidable Chinese pressed harder,"},{"id":"manas-2010:p1680:b001:l010","ordinal":72227,"en":"Stirring all the way from Beijing."},{"id":"manas-2010:p1680:b001:l011","ordinal":72228,"en":"Kojozhash, son of Karazhoy,"},{"id":"manas-2010:p1680:b001:l012","ordinal":72229,"en":"Stood in fury."},{"id":"manas-2010:p1680:b001:l013","ordinal":72230,"en":"Against your khan, lord Alma,"},{"id":"manas-2010:p1680:b001:l014","ordinal":72231,"en":"He devised a fierce stratagem."},{"id":"manas-2010:p1680:b001:l015","ordinal":72232,"en":"The reason for his fierce stratagem:"},{"id":"manas-2010:p1680:b001:l016","ordinal":72233,"en":"Kojozhash, son of Karazhoy,"},{"id":"manas-2010:p1680:b001:l017","ordinal":72234,"en":"Had become Beijing's support."},{"id":"manas-2010:p1680:b001:l018","ordinal":72235,"en":"He saddled his gray filly;"},{"id":"manas-2010:p1680:b001:l019","ordinal":72236,"en":"Before dear Alma, Kojozhash"},{"id":"manas-2010:p1680:b001:l020","ordinal":72237,"en":"Had studied some three months earlier."},{"id":"manas-2010:p1680:b001:l021","ordinal":72238,"en":"He was the expert hero,"},{"id":"manas-2010:p1680:b001:l022","ordinal":72239,"en":"A master horseman, fleet on foot;"},{"id":"manas-2010:p1680:b001:l023","ordinal":72240,"en":"Now was his time to use his arts."},{"id":"manas-2010:p1680:b001:l024","ordinal":72241,"en":"For sixty days they exchanged fire;"},{"id":"manas-2010:p1680:b001:l025","ordinal":72242,"en":"Dear Alma would not be overcome."},{"id":"manas-2010:p1680:b001:l026","ordinal":72243,"en":"Look, and nothing met the eye;"},{"id":"manas-2010:p1680:b001:l027","ordinal":72244,"en":"The unbelievers' Kojozhash,"},{"id":"manas-2010:p1680:b001:l028","ordinal":72245,"en":"Where he was could not be known."},{"id":"manas-2010:p1680:b001:l029","ordinal":72246,"en":"His strength gone, reeling,"},{"id":"manas-2010:p1680:b001:l030","ordinal":72247,"en":"Azizkhan's Almambet—"},{"id":"manas-2010:p1680:b001:l031","ordinal":72248,"en":"Sarala beneath him"},{"id":"manas-2010:p1680:b001:l032","ordinal":72249,"en":"Could not lower his head to the ground;"},{"id":"manas-2010:p1680:b001:l033","ordinal":72250,"en":"His former stride,"},{"id":"manas-2010:p1680:b001:l034","ordinal":72251,"en":"The noble Sarala could no longer take."},{"id":"manas-2010:p1680:b001:l035","ordinal":72252,"en":"Dust swept up from the earth,"},{"id":"manas-2010:p1680:b001:l036","ordinal":72253,"en":"Dear Alma's strength ebbed away."},{"id":"manas-2010:p1680:b001:l037","ordinal":72254,"en":"Hero Manas was not there;"},{"id":"manas-2010:p1680:b001:l038","ordinal":72255,"en":"United when tiny as lice,"},{"id":"manas-2010:p1680:b001:l039","ordinal":72256,"en":"Joined when small as thumbs,"},{"id":"manas-2010:p1680:b001:l040","ordinal":72257,"en":"His companions, he saw, were not there."},{"id":"manas-2010:p1680:b001:l041","ordinal":72258,"en":"Akbaltay's Chubak was not there."},{"id":"manas-2010:p1680:b001:l042","ordinal":72259,"en":"When such affliction came,"},{"id":"manas-2010:p1681:b001:l001","ordinal":72260,"en":"The one who would rescue him,"},{"id":"manas-2010:p1681:b001:l002","ordinal":72261,"en":"Auspicious Syrgak, was not there either."},{"id":"manas-2010:p1681:b001:l003","ordinal":72262,"en":"The unflinching people of forty khans"},{"id":"manas-2010:p1681:b001:l004","ordinal":72263,"en":"Pressed your Alma hard;"},{"id":"manas-2010:p1681:b001:l005","ordinal":72264,"en":"Now was their time to encircle him."},{"id":"manas-2010:p1681:b001:l006","ordinal":72265,"en":"The raging unbelievers,"},{"id":"manas-2010:p1681:b001:l007","ordinal":72266,"en":"Kojozhash, son of Karazhoy,"},{"id":"manas-2010:p1681:b001:l008","ordinal":72267,"en":"Now enclosed him in their midst."},{"id":"manas-2010:p1681:b001:l009","ordinal":72268,"en":"His prophet true, his faith true,"},{"id":"manas-2010:p1681:b001:l010","ordinal":72269,"en":"Your king Alma, the dear lion—"},{"id":"manas-2010:p1681:b001:l011","ordinal":72270,"en":"Forty tribes of Chinese were slaughtered"},{"id":"manas-2010:p1681:b001:l012","ordinal":72271,"en":"When your mighty Alma came."},{"id":"manas-2010:p1681:b001:l013","ordinal":72272,"en":"Their dead were heaped like mountains,"},{"id":"manas-2010:p1681:b001:l014","ordinal":72273,"en":"The Chinese he met screamed."},{"id":"manas-2010:p1681:b001:l015","ordinal":72274,"en":"Though Almambet was alone,"},{"id":"manas-2010:p1681:b001:l016","ordinal":72275,"en":"Those who came before him,"},{"id":"manas-2010:p1681:b001:l017","ordinal":72276,"en":"The Chinese, fled thundering away."},{"id":"manas-2010:p1681:b001:l018","ordinal":72277,"en":"When lion-like dear Alma"},{"id":"manas-2010:p1681:b001:l019","ordinal":72278,"en":"Came driving them before him,"},{"id":"manas-2010:p1681:b001:l020","ordinal":72279,"en":"They scattered in separate groups."},{"id":"manas-2010:p1681:b001:l021","ordinal":72280,"en":"Reducing them utterly to dust,"},{"id":"manas-2010:p1681:b001:l022","ordinal":72281,"en":"Driving the unbelievers without pause,"},{"id":"manas-2010:p1681:b001:l023","ordinal":72282,"en":"“Trust in God!” he cried,"},{"id":"manas-2010:p1681:b001:l024","ordinal":72283,"en":"And swept them toward Beijing."},{"id":"manas-2010:p1681:b001:l025","ordinal":72284,"en":"Taking courage, the emperor's"},{"id":"manas-2010:p1681:b001:l026","ordinal":72285,"en":"Chinese multitude assembled."},{"id":"manas-2010:p1681:b001:l027","ordinal":72286,"en":"When they counted the people,"},{"id":"manas-2010:p1681:b001:l028","ordinal":72287,"en":"With Ezkara foremost,"},{"id":"manas-2010:p1681:b001:l029","ordinal":72288,"en":"Forty thousand champions had been slain."},{"id":"manas-2010:p1681:b001:l030","ordinal":72289,"en":"The Chinese, a people with a homeland,"},{"id":"manas-2010:p1681:b001:l031","ordinal":72290,"en":"How could their fighting cease?"},{"id":"manas-2010:p1681:b001:l032","ordinal":72291,"en":"Against your lone, distinguished Alma,"},{"id":"manas-2010:p1681:b001:l033","ordinal":72292,"en":"All the Chinese assembled."},{"id":"manas-2010:p1681:b001:l034","ordinal":72293,"en":"Swarming without restraint,"},{"id":"manas-2010:p1681:b001:l035","ordinal":72294,"en":"The lone champion Alma's"},{"id":"manas-2010:p1681:b001:l036","ordinal":72295,"en":"Head they beset with hardship."},{"id":"manas-2010:p1681:b001:l037","ordinal":72296,"en":"The black-edged hungry steel"},{"id":"manas-2010:p1681:b001:l038","ordinal":72297,"en":"Rang in his hand."},{"id":"manas-2010:p1681:b001:l039","ordinal":72298,"en":"Kojozhash and Kongurbay—"},{"id":"manas-2010:p1681:b001:l040","ordinal":72299,"en":"Anyone other than those two"},{"id":"manas-2010:p1681:b001:l041","ordinal":72300,"en":"He held worth less than his boot-leg,"},{"id":"manas-2010:p1681:b001:l042","ordinal":72301,"en":"As dear Alma rushed ringing on."},{"id":"manas-2010:p1682:b001:l001","ordinal":72302,"en":"Drawing bows, raining arrows,"},{"id":"manas-2010:p1682:b001:l002","ordinal":72303,"en":"All the Chinese swarmed."},{"id":"manas-2010:p1682:b001:l003","ordinal":72304,"en":"The Fleet-Footed and Dagger-Hands"},{"id":"manas-2010:p1682:b001:l004","ordinal":72305,"en":"Prepared upon one side;"},{"id":"manas-2010:p1682:b001:l005","ordinal":72306,"en":"For sixty days they fought."},{"id":"manas-2010:p1682:b001:l006","ordinal":72307,"en":"On another side was Karazhoy;"},{"id":"manas-2010:p1682:b001:l007","ordinal":72308,"en":"The Chinese lay in wait."},{"id":"manas-2010:p1682:b001:l008","ordinal":72309,"en":"That great battlefield of combat"},{"id":"manas-2010:p1682:b001:l009","ordinal":72310,"en":"Was the desert forty days across;"},{"id":"manas-2010:p1682:b001:l010","ordinal":72311,"en":"Almambet's death came due,"},{"id":"manas-2010:p1682:b001:l011","ordinal":72312,"en":"There was the place of his ruin."},{"id":"manas-2010:p1682:b001:l012","ordinal":72313,"en":"Cotton sash and wide boots,"},{"id":"manas-2010:p1682:b001:l013","ordinal":72314,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1682:b001:l014","ordinal":72315,"en":"Came proudly from the mountain slope."},{"id":"manas-2010:p1682:b001:l015","ordinal":72316,"en":"At the sight of Kongurbay,"},{"id":"manas-2010:p1682:b001:l016","ordinal":72317,"en":"Khan Almambet, that lone soul,"},{"id":"manas-2010:p1682:b001:l017","ordinal":72318,"en":"Could not stand still in his fury."},{"id":"manas-2010:p1682:b001:l018","ordinal":72319,"en":"“If I live, grant me gathered wealth;"},{"id":"manas-2010:p1682:b001:l019","ordinal":72320,"en":"If I die, grant me faith.”"},{"id":"manas-2010:p1682:b001:l020","ordinal":72321,"en":"Sending Sarala streaming onward,"},{"id":"manas-2010:p1682:b001:l021","ordinal":72322,"en":"Illustrious Almambet,"},{"id":"manas-2010:p1682:b001:l022","ordinal":72323,"en":"In the opening and closing of an eye,"},{"id":"manas-2010:p1682:b001:l023","ordinal":72324,"en":"Before this or that could be said,"},{"id":"manas-2010:p1682:b001:l024","ordinal":72325,"en":"Reached Kongurbay."},{"id":"manas-2010:p1682:b001:l025","ordinal":72326,"en":"Upon reaching him, your lion Alma,"},{"id":"manas-2010:p1682:b001:l026","ordinal":72327,"en":"From Algara's back"},{"id":"manas-2010:p1682:b001:l027","ordinal":72328,"en":"The Manzhuu khan of the monks"},{"id":"manas-2010:p1682:b001:l028","ordinal":72329,"en":"Thrust down as he passed."},{"id":"manas-2010:p1682:b001:l029","ordinal":72330,"en":"Turning with Sarala,"},{"id":"manas-2010:p1682:b001:l030","ordinal":72331,"en":"Before dear Khan Alma could reach him,"},{"id":"manas-2010:p1682:b001:l031","ordinal":72332,"en":"The noble Sarala ran;"},{"id":"manas-2010:p1682:b001:l032","ordinal":72333,"en":"When his destined due arrived,"},{"id":"manas-2010:p1682:b001:l033","ordinal":72334,"en":"Sarala, swiftest among beasts,"},{"id":"manas-2010:p1682:b001:l034","ordinal":72335,"en":"Bent his knees to the ground."},{"id":"manas-2010:p1682:b001:l035","ordinal":72336,"en":"Falling short, stumbling,"},{"id":"manas-2010:p1682:b001:l036","ordinal":72337,"en":"When he tripped,"},{"id":"manas-2010:p1682:b001:l037","ordinal":72338,"en":"The golden shield upon his head"},{"id":"manas-2010:p1682:b001:l038","ordinal":72339,"en":"Flew down to the ground."},{"id":"manas-2010:p1682:b001:l039","ordinal":72340,"en":"A master horseman, fleet on foot,"},{"id":"manas-2010:p1682:b001:l040","ordinal":72341,"en":"The great royal marksman,"},{"id":"manas-2010:p1682:b001:l041","ordinal":72342,"en":"Kojozhash, son of Karazhoy,"},{"id":"manas-2010:p1682:b001:l042","ordinal":72343,"en":"The finest in marksmanship,"},{"id":"manas-2010:p1683:b001:l001","ordinal":72344,"en":"Steadily held his lacquered musket,"},{"id":"manas-2010:p1683:b001:l002","ordinal":72345,"en":"Its trigger ready."},{"id":"manas-2010:p1683:b001:l003","ordinal":72346,"en":"The golden shield from his head,"},{"id":"manas-2010:p1683:b001:l004","ordinal":72347,"en":"Your distinguished champion Alma,"},{"id":"manas-2010:p1683:b001:l005","ordinal":72348,"en":"Before he could lift it onto his head,"},{"id":"manas-2010:p1683:b001:l006","ordinal":72349,"en":"Secure his life held in trust,"},{"id":"manas-2010:p1683:b001:l007","ordinal":72350,"en":"And make himself firmly ready,"},{"id":"manas-2010:p1683:b001:l008","ordinal":72351,"en":"Kojozhash fired;"},{"id":"manas-2010:p1683:b001:l009","ordinal":72352,"en":"The noble head was shattered."},{"id":"manas-2010:p1683:b001:l010","ordinal":72353,"en":"When dear Alma fell to the bullet,"},{"id":"manas-2010:p1683:b001:l011","ordinal":72354,"en":"Pitch-black night descended;"},{"id":"manas-2010:p1683:b001:l012","ordinal":72355,"en":"An irreversible day of anguish came."},{"id":"manas-2010:p1683:b001:l013","ordinal":72356,"en":"Parted from the earth that sheltered him,"},{"id":"manas-2010:p1683:b001:l014","ordinal":72357,"en":"When dear Alma passed away,"},{"id":"manas-2010:p1683:b001:l015","ordinal":72358,"en":"Bereft of their dear lion,"},{"id":"manas-2010:p1683:b001:l016","ordinal":72359,"en":"The Muslims mourned."},{"id":"manas-2010:p1683:b001:l017","ordinal":72360,"en":"When Khan Almambet died,"},{"id":"manas-2010:p1683:b001:l018","ordinal":72361,"en":"The people wept, wept tears of blood,"},{"id":"manas-2010:p1683:b001:l019","ordinal":72362,"en":"All the Muslims wept."},{"id":"manas-2010:p1683:b001:l020","ordinal":72363,"en":"Saddle and saddlecloth still upon him,"},{"id":"manas-2010:p1683:b001:l021","ordinal":72364,"en":"Sarala bounded free."},{"id":"manas-2010:p1683:b001:l022","ordinal":72365,"en":"Struck by a bullet in the hip,"},{"id":"manas-2010:p1683:b001:l023","ordinal":72366,"en":"Running upon three legs,"},{"id":"manas-2010:p1683:b001:l024","ordinal":72367,"en":"His life held in trust, like this,"},{"id":"manas-2010:p1683:b001:l025","ordinal":72368,"en":"Sarala bore forth in pain."},{"id":"manas-2010:p1683:b001:l026","ordinal":72369,"en":"Cropping the tips of the fescue,"},{"id":"manas-2010:p1683:b001:l027","ordinal":72370,"en":"Sarala went grazing."},{"id":"manas-2010:p1683:b001:l028","ordinal":72371,"en":"As though his foal had been left behind,"},{"id":"manas-2010:p1683:b001:l029","ordinal":72372,"en":"Stopping and neighing,"},{"id":"manas-2010:p1683:b001:l030","ordinal":72373,"en":"Sarala went lamenting!"},{"id":"manas-2010:p1683:b001:l032","ordinal":72374,"en":"All their mighty men","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p1683:b001:l033","ordinal":72375,"en":"Taken as gifts for the Chinese,"},{"id":"manas-2010:p1683:b001:l034","ordinal":72376,"en":"Affliction came upon their dear heads;"},{"id":"manas-2010:p1683:b001:l035","ordinal":72377,"en":"The sun was hidden, night descended."},{"id":"manas-2010:p1683:b001:l036","ordinal":72378,"en":"Having entered Beijing and turned back,"},{"id":"manas-2010:p1683:b001:l037","ordinal":72379,"en":"Bereft of their champions,"},{"id":"manas-2010:p1683:b001:l038","ordinal":72380,"en":"They had no cliff a goose could not circle."},{"id":"manas-2010:p1683:b001:l039","ordinal":72381,"en":"The Muslims who suffered ruin,"},{"id":"manas-2010:p1683:b001:l040","ordinal":72382,"en":"To rescue them,"},{"id":"manas-2010:p1683:b001:l041","ordinal":72383,"en":"Look—"},{"id":"manas-2010:p1683:b001:l042","ordinal":72384,"en":"Had no mountain, hero Almambet."},{"id":"manas-2010:p1684:b001:l001","ordinal":72385,"en":"“The handful of Muslims"},{"id":"manas-2010:p1684:b001:l002","ordinal":72386,"en":"Have suffered so much torment,” they said."},{"id":"manas-2010:p1684:b001:l003","ordinal":72387,"en":"With six swift horses,"},{"id":"manas-2010:p1684:b001:l004","ordinal":72388,"en":"With a letter small as a palm,"},{"id":"manas-2010:p1684:b001:l005","ordinal":72389,"en":"They sent a rider to brave Manas."},{"id":"manas-2010:p1684:b001:l006","ordinal":72390,"en":"Yraman's Singer Son,"},{"id":"manas-2010:p1684:b001:l007","ordinal":72391,"en":"With his tasselled, four-jointed drawstring,"},{"id":"manas-2010:p1684:b001:l008","ordinal":72392,"en":"Raised his voice and spoke:"},{"id":"manas-2010:p1684:b001:l009","ordinal":72393,"en":"“Lion Manas!” he said,"},{"id":"manas-2010:p1684:b001:l010","ordinal":72394,"en":"“The supports we relied upon,"},{"id":"manas-2010:p1684:b001:l011","ordinal":72395,"en":"Renowned leopard Manas,"},{"id":"manas-2010:p1684:b001:l012","ordinal":72396,"en":"Our noble lions—we have lost them."},{"id":"manas-2010:p1684:b001:l013","ordinal":72397,"en":"From the desert of It-Ölbös"},{"id":"manas-2010:p1684:b001:l014","ordinal":72398,"en":"We turned back while fighting."},{"id":"manas-2010:p1684:b001:l015","ordinal":72399,"en":"Almambet and Chubak, the lion heroes,"},{"id":"manas-2010:p1684:b001:l016","ordinal":72400,"en":"Ulak Khan's brave Syrgak—"},{"id":"manas-2010:p1684:b001:l017","ordinal":72401,"en":"Among the forty champions,"},{"id":"manas-2010:p1684:b001:l018","ordinal":72402,"en":"We have lost twelve."},{"id":"manas-2010:p1684:b001:l019","ordinal":72403,"en":"They have dug your trench deep,"},{"id":"manas-2010:p1684:b001:l020","ordinal":72404,"en":"They have boiled up your misery like this;"},{"id":"manas-2010:p1684:b001:l021","ordinal":72405,"en":"They have killed your great Alma."},{"id":"manas-2010:p1684:b001:l022","ordinal":72406,"en":"‘I shall pursue you to Mecca,’ they say."},{"id":"manas-2010:p1684:b001:l023","ordinal":72407,"en":"The formidable Chinese multitude"},{"id":"manas-2010:p1684:b001:l024","ordinal":72408,"en":"Has brought such marvels upon us."},{"id":"manas-2010:p1684:b001:l025","ordinal":72409,"en":"They have destroyed your support,"},{"id":"manas-2010:p1684:b001:l026","ordinal":72410,"en":"Reducing everything to dust,"},{"id":"manas-2010:p1684:b001:l027","ordinal":72411,"en":"They have slaughtered your Muslim people."},{"id":"manas-2010:p1684:b001:l028","ordinal":72412,"en":"My mighty Alma is no more;"},{"id":"manas-2010:p1684:b001:l029","ordinal":72413,"en":"My hero, who will hold your defenses?"},{"id":"manas-2010:p1684:b001:l030","ordinal":72414,"en":"The people of forty khans have risen;"},{"id":"manas-2010:p1684:b001:l031","ordinal":72415,"en":"The unbelievers have grown furious."},{"id":"manas-2010:p1684:b001:l032","ordinal":72416,"en":"At the emperor's Beijing,"},{"id":"manas-2010:p1684:b001:l033","ordinal":72417,"en":"No one who meets them fares well."},{"id":"manas-2010:p1684:b001:l034","ordinal":72418,"en":"Muzburchak and Khan Kökchö died;"},{"id":"manas-2010:p1684:b001:l035","ordinal":72419,"en":"Everyone who met this Beijing died."},{"id":"manas-2010:p1684:b001:l036","ordinal":72420,"en":"The Chinese have grown stronger now;"},{"id":"manas-2010:p1684:b001:l037","ordinal":72421,"en":"Not one of us will return alive."},{"id":"manas-2010:p1684:b001:l038","ordinal":72422,"en":"The Flood had never swept in there;"},{"id":"manas-2010:p1684:b001:l039","ordinal":72423,"en":"A hellish people are these Chinese."},{"id":"manas-2010:p1684:b001:l040","ordinal":72424,"en":"Unless we halt them, we cannot withdraw safely.”"},{"id":"manas-2010:p1684:b001:l041","ordinal":72425,"en":"Thus he spoke those words,"},{"id":"manas-2010:p1684:b001:l042","ordinal":72426,"en":"Still living, not yet dead, hanging weakly."},{"id":"manas-2010:p1685:b001:l001","ordinal":72427,"en":"The letter written small as a palm,"},{"id":"manas-2010:p1685:b001:l002","ordinal":72428,"en":"Manas stared at wide-eyed."},{"id":"manas-2010:p1685:b001:l003","ordinal":72429,"en":"It was a letter dear Alma had written;"},{"id":"manas-2010:p1685:b001:l004","ordinal":72430,"en":"When he looked intently at the letter,"},{"id":"manas-2010:p1685:b001:l005","ordinal":72431,"en":"The dear lion had written in sorrow,"},{"id":"manas-2010:p1685:b001:l006","ordinal":72432,"en":"In the name of Islam."},{"id":"manas-2010:p1685:b001:l007","ordinal":72433,"en":"“Khan Manas,"},{"id":"manas-2010:p1685:b001:l008","ordinal":72434,"en":"In Beijing, where my birth-blood fell,"},{"id":"manas-2010:p1685:b001:l009","ordinal":72435,"en":"The blood of my body has been shed."},{"id":"manas-2010:p1685:b001:l010","ordinal":72436,"en":"Lion Manas, my soul's friend,"},{"id":"manas-2010:p1685:b001:l011","ordinal":72437,"en":"Saddle your horse well and come;"},{"id":"manas-2010:p1685:b001:l012","ordinal":72438,"en":"‘My lion friend is dead,’ say,"},{"id":"manas-2010:p1685:b001:l013","ordinal":72439,"en":"And recite the Quran well for me."},{"id":"manas-2010:p1685:b001:l014","ordinal":72440,"en":"Storm its sunless city,"},{"id":"manas-2010:p1685:b001:l015","ordinal":72441,"en":"Without lingering long here,"},{"id":"manas-2010:p1685:b001:l016","ordinal":72442,"en":"Give up your hope of me and go!”"},{"id":"manas-2010:p1685:b001:l017","ordinal":72443,"en":"When he saw dear Alma's letter,"},{"id":"manas-2010:p1685:b001:l018","ordinal":72444,"en":"Raging, his words choked off,"},{"id":"manas-2010:p1685:b001:l019","ordinal":72445,"en":"Manas stared and moaned,"},{"id":"manas-2010:p1685:b001:l020","ordinal":72446,"en":"Grief burned deep within him."},{"id":"manas-2010:p1685:b001:l021","ordinal":72447,"en":"Your hero, famed as hero Manas,"},{"id":"manas-2010:p1685:b001:l022","ordinal":72448,"en":"The dear lion turned about;"}]
