[{"id":"manas-2010:p0469:b001:l001","ordinal":21505,"en":"He drew near Kara-Kyr."},{"id":"manas-2010:p0469:b001:l002","ordinal":21506,"en":"To the marsh of Kara-Kyr,"},{"id":"manas-2010:p0469:b001:l003","ordinal":21507,"en":"The great army approached."},{"id":"manas-2010:p0469:b001:l004","ordinal":21508,"en":"In the dark, rough marsh,"},{"id":"manas-2010:p0469:b001:l005","ordinal":21509,"en":"When the great army made camp,"},{"id":"manas-2010:p0469:b001:l006","ordinal":21510,"en":"They had the horses tied to tethering lines,"},{"id":"manas-2010:p0469:b001:l007","ordinal":21511,"en":"Had stone hearth supports arranged,"},{"id":"manas-2010:p0469:b001:l008","ordinal":21512,"en":"Made fires in groups of ten,"},{"id":"manas-2010:p0469:b001:l009","ordinal":21513,"en":"And boiled their traveling pots."},{"id":"manas-2010:p0469:b001:l010","ordinal":21514,"en":"All the fine racers"},{"id":"manas-2010:p0469:b001:l011","ordinal":21515,"en":"They tied along the tethering lines."},{"id":"manas-2010:p0469:b001:l012","ordinal":21516,"en":"Your capable elder Koshoy,"},{"id":"manas-2010:p0469:b001:l013","ordinal":21517,"en":"Across from great Altay,"},{"id":"manas-2010:p0469:b001:l014","ordinal":21518,"en":"At the mountain narrows of Keng-Özön,"},{"id":"manas-2010:p0469:b001:l015","ordinal":21519,"en":"Beside the clear, broad-flowing water,"},{"id":"manas-2010:p0469:b001:l016","ordinal":21520,"en":"In the fresh pasture of Kara-Kyya,"},{"id":"manas-2010:p0469:b001:l017","ordinal":21521,"en":"The people's father, your khan elder,"},{"id":"manas-2010:p0469:b001:l018","ordinal":21522,"en":"Lay down to camp that day."},{"id":"manas-2010:p0469:b001:l019","ordinal":21523,"en":"Koshoy had made camp,"},{"id":"manas-2010:p0469:b001:l020","ordinal":21524,"en":"His countless troops resting for the night."},{"id":"manas-2010:p0469:b001:l021","ordinal":21525,"en":"Now let us tell"},{"id":"manas-2010:p0469:b001:l022","ordinal":21526,"en":"The tale of the bloodstained lion."},{"id":"manas-2010:p0469:b003:l001","ordinal":21527,"en":"When true dawn broke,"},{"id":"manas-2010:p0469:b003:l002","ordinal":21528,"en":"When daybreak swelled,"},{"id":"manas-2010:p0469:b003:l003","ordinal":21529,"en":"Have you seen the Kytay's tumult?"},{"id":"manas-2010:p0469:b003:l004","ordinal":21530,"en":"The Kytay seethed and filled the land;"},{"id":"manas-2010:p0469:b003:l005","ordinal":21531,"en":"The Kytay boiled and swarmed,"},{"id":"manas-2010:p0469:b003:l006","ordinal":21532,"en":"Becoming like ants."},{"id":"manas-2010:p0469:b003:l007","ordinal":21533,"en":"For those clamoring unbelievers,"},{"id":"manas-2010:p0469:b003:l008","ordinal":21534,"en":"For the heroes Ezkara and Zholoy,"},{"id":"manas-2010:p0469:b003:l009","ordinal":21535,"en":"The time to charge had come."},{"id":"manas-2010:p0469:b003:l010","ordinal":21536,"en":"Their lords and stone-badged men,"},{"id":"manas-2010:p0469:b003:l011","ordinal":21537,"en":"The Kytay had gathered them:"},{"id":"manas-2010:p0469:b003:l012","ordinal":21538,"en":"The great, the strong and the leaders."},{"id":"manas-2010:p0469:b003:l013","ordinal":21539,"en":"To advance and overwhelm them,"},{"id":"manas-2010:p0469:b003:l014","ordinal":21540,"en":"The warriors Manas and Kutubiy,"},{"id":"manas-2010:p0469:b003:l015","ordinal":21541,"en":"To charge straight in and destroy them utterly,"},{"id":"manas-2010:p0470:b001:l001","ordinal":21542,"en":"Their governors prepared."},{"id":"manas-2010:p0470:b001:l002","ordinal":21543,"en":"For a span of six days,"},{"id":"manas-2010:p0470:b001:l003","ordinal":21544,"en":"The great Kytay host pressed in."},{"id":"manas-2010:p0470:b001:l004","ordinal":21545,"en":"Drawing bows to rain arrows,"},{"id":"manas-2010:p0470:b001:l005","ordinal":21546,"en":"The Kytay swarmed in, looming."},{"id":"manas-2010:p0470:b001:l006","ordinal":21547,"en":"Champions as numerous as a cow's hairs"},{"id":"manas-2010:p0470:b001:l007","ordinal":21548,"en":"Surrounded them and pressed in."},{"id":"manas-2010:p0470:b001:l008","ordinal":21549,"en":"The champions came in a frenzy;"},{"id":"manas-2010:p0470:b001:l009","ordinal":21550,"en":"Upon the brave one standing there,"},{"id":"manas-2010:p0470:b001:l010","ordinal":21551,"en":"They swarmed in full force."},{"id":"manas-2010:p0470:b001:l011","ordinal":21552,"en":"When the unbelievers charged,"},{"id":"manas-2010:p0470:b001:l012","ordinal":21553,"en":"The wrathful hero Zholoy's"},{"id":"manas-2010:p0470:b001:l013","ordinal":21554,"en":"War drum beat fiercely."},{"id":"manas-2010:p0470:b001:l014","ordinal":21555,"en":"All his Tyrgoots gathered;"},{"id":"manas-2010:p0470:b001:l015","ordinal":21556,"en":"Their khans wearing arm guards,"},{"id":"manas-2010:p0470:b001:l016","ordinal":21557,"en":"Drawing bows to rain arrows,"},{"id":"manas-2010:p0470:b001:l017","ordinal":21558,"en":"Upon your leopard, the lion Manas,"},{"id":"manas-2010:p0470:b001:l018","ordinal":21559,"en":"They advanced in a sweeping charge,"},{"id":"manas-2010:p0470:b001:l019","ordinal":21560,"en":"Intent on bringing him utterly to ruin,"},{"id":"manas-2010:p0470:b001:l020","ordinal":21561,"en":"If the bloodstained one fell into their hands,"},{"id":"manas-2010:p0470:b001:l021","ordinal":21562,"en":"To bind him and take him to the Kakan."},{"id":"manas-2010:p0470:b001:l022","ordinal":21563,"en":"Look at the embers covering the earth!"},{"id":"manas-2010:p0470:b001:l023","ordinal":21564,"en":"Look at the shots that strike home!"},{"id":"manas-2010:p0470:b001:l024","ordinal":21565,"en":"The Kytay swarmed and attacked;"},{"id":"manas-2010:p0470:b001:l025","ordinal":21566,"en":"The war drums sounded in full."},{"id":"manas-2010:p0470:b001:l026","ordinal":21567,"en":"The many Kytay lords charged."},{"id":"manas-2010:p0470:b001:l027","ordinal":21568,"en":"When the Kytay spread everywhere,"},{"id":"manas-2010:p0470:b001:l028","ordinal":21569,"en":"When they attacked together,"},{"id":"manas-2010:p0470:b001:l029","ordinal":21570,"en":"Bloodstained Manas, the mighty lion,"},{"id":"manas-2010:p0470:b001:l030","ordinal":21571,"en":"Raised tumult in that place."},{"id":"manas-2010:p0470:b001:l031","ordinal":21572,"en":"Girding a leather belt round his waist,"},{"id":"manas-2010:p0470:b001:l032","ordinal":21573,"en":"Into the unbelievers covering the earth,"},{"id":"manas-2010:p0470:b001:l033","ordinal":21574,"en":"He plunged alone and attacked."},{"id":"manas-2010:p0470:b001:l034","ordinal":21575,"en":"Those who came near to grapple,"},{"id":"manas-2010:p0470:b001:l035","ordinal":21576,"en":"He brought down with his spear;"},{"id":"manas-2010:p0470:b001:l036","ordinal":21577,"en":"Those who came nearer still,"},{"id":"manas-2010:p0470:b001:l037","ordinal":21578,"en":"He felled with blows of his battle-axe."},{"id":"manas-2010:p0470:b001:l038","ordinal":21579,"en":"Breaking their flank, opening a way,"},{"id":"manas-2010:p0470:b001:l039","ordinal":21580,"en":"Driving them apart and attacking,"},{"id":"manas-2010:p0470:b001:l040","ordinal":21581,"en":"The Manzhuu, countless as a cow's hairs,"},{"id":"manas-2010:p0470:b001:l041","ordinal":21582,"en":"He threw into utter confusion."},{"id":"manas-2010:p0470:b001:l042","ordinal":21583,"en":"Thus Manas slaughtered them."},{"id":"manas-2010:p0471:b001:l001","ordinal":21584,"en":"He drove in and sent them scattering;"},{"id":"manas-2010:p0471:b001:l002","ordinal":21585,"en":"Those who came before him,"},{"id":"manas-2010:p0471:b001:l003","ordinal":21586,"en":"He struck across the back and hurled aside."},{"id":"manas-2010:p0471:b001:l004","ordinal":21587,"en":"Spearing wherever he reached,"},{"id":"manas-2010:p0471:b001:l005","ordinal":21588,"en":"'Where is the one so eager to bind me,"},{"id":"manas-2010:p0471:b001:l006","ordinal":21589,"en":"That abased Zholoy?' he cried."},{"id":"manas-2010:p0471:b001:l007","ordinal":21590,"en":"Cutting six thousand of them to pieces,"},{"id":"manas-2010:p0471:b001:l008","ordinal":21591,"en":"The Kytay who came before him,"},{"id":"manas-2010:p0471:b001:l009","ordinal":21592,"en":"He drove into a huddle and speared."},{"id":"manas-2010:p0471:b001:l010","ordinal":21593,"en":"'The one who would bind me for the Kakan,"},{"id":"manas-2010:p0471:b001:l011","ordinal":21594,"en":"Who would seize and destroy me,"},{"id":"manas-2010:p0471:b001:l012","ordinal":21595,"en":"Where is that fool Ezkara?' he cried."},{"id":"manas-2010:p0471:b001:l013","ordinal":21596,"en":"Roaring in wrath,"},{"id":"manas-2010:p0471:b001:l014","ordinal":21597,"en":"The surging Kytay's"},{"id":"manas-2010:p0471:b001:l015","ordinal":21598,"en":"Ranks he broke and scattered."},{"id":"manas-2010:p0471:b001:l016","ordinal":21599,"en":"Among the scattered Kytay"},{"id":"manas-2010:p0471:b001:l017","ordinal":21600,"en":"Were lords and khans,"},{"id":"manas-2010:p0471:b001:l018","ordinal":21601,"en":"And champions too."},{"id":"manas-2010:p0471:b001:l019","ordinal":21602,"en":"Sharp shouts and shrill battle cries—"},{"id":"manas-2010:p0471:b001:l020","ordinal":21603,"en":"Your generous hero raised a great tumult."},{"id":"manas-2010:p0471:b001:l021","ordinal":21604,"en":"Behind him, Kutubiy,"},{"id":"manas-2010:p0471:b001:l022","ordinal":21605,"en":"Your generous hero's support,"},{"id":"manas-2010:p0471:b001:l023","ordinal":21606,"en":"Gave mighty encouragement."},{"id":"manas-2010:p0471:b001:l024","ordinal":21607,"en":"They began a terrible battle;"},{"id":"manas-2010:p0471:b001:l025","ordinal":21608,"en":"The valiant Manas and Kutubiy"},{"id":"manas-2010:p0471:b001:l026","ordinal":21609,"en":"Slaughtered a great many."},{"id":"manas-2010:p0471:b001:l027","ordinal":21610,"en":"When they drove the Kytay onward,"},{"id":"manas-2010:p0471:b001:l028","ordinal":21611,"en":"Right in Altay's valley,"},{"id":"manas-2010:p0471:b001:l029","ordinal":21612,"en":"Many lives were lost in slaughter."},{"id":"manas-2010:p0471:b001:l030","ordinal":21613,"en":"There is Altay's Kara-Suu;"},{"id":"manas-2010:p0471:b001:l031","ordinal":21614,"en":"Here was a crossing of great difficulty."},{"id":"manas-2010:p0471:b001:l032","ordinal":21615,"en":"Into that river's depths,"},{"id":"manas-2010:p0471:b001:l033","ordinal":21616,"en":"A rope cast down cannot reach the bottom."},{"id":"manas-2010:p0471:b001:l034","ordinal":21617,"en":"If a fine steed is sent into it,"},{"id":"manas-2010:p0471:b001:l035","ordinal":21618,"en":"It cannot find footing to the farther bank."},{"id":"manas-2010:p0471:b001:l036","ordinal":21619,"en":"Those who fall within it"},{"id":"manas-2010:p0471:b001:l037","ordinal":21620,"en":"Do not expect to remain alive."},{"id":"manas-2010:p0471:b001:l038","ordinal":21621,"en":"When they reached Kara-Suu,"},{"id":"manas-2010:p0471:b001:l039","ordinal":21622,"en":"They hemmed in the governors."},{"id":"manas-2010:p0471:b001:l040","ordinal":21623,"en":"At Kara-Suu, the Kalmyks,"},{"id":"manas-2010:p0471:b001:l041","ordinal":21624,"en":"Valiant Manas and Kutubiy"},{"id":"manas-2010:p0471:b001:l042","ordinal":21625,"en":"Slaughtered them in a massacre."},{"id":"manas-2010:p0472:b001:l001","ordinal":21626,"en":"When they slaughtered the Kytay,"},{"id":"manas-2010:p0472:b001:l002","ordinal":21627,"en":"When the gray-maned hero unleashed hell,"},{"id":"manas-2010:p0472:b001:l003","ordinal":21628,"en":"Throwing them into turmoil,"},{"id":"manas-2010:p0472:b001:l004","ordinal":21629,"en":"Scattering and slaughtering them,"},{"id":"manas-2010:p0472:b001:l005","ordinal":21630,"en":"Resourceful Zholoy, Ezkara,"},{"id":"manas-2010:p0472:b001:l006","ordinal":21631,"en":"And Karazhoy on his pale mare,"},{"id":"manas-2010:p0472:b001:l007","ordinal":21632,"en":"With at least three thousand troops,"},{"id":"manas-2010:p0472:b001:l008","ordinal":21633,"en":"Escaped from that river."},{"id":"manas-2010:p0472:b001:l009","ordinal":21634,"en":"At the spur of Orok-Kyr,"},{"id":"manas-2010:p0472:b001:l010","ordinal":21635,"en":"Tash-Kechüü, which Zholoy had seen,"},{"id":"manas-2010:p0472:b001:l011","ordinal":21636,"en":"A ford familiar to hero Zholoy—"},{"id":"manas-2010:p0472:b001:l012","ordinal":21637,"en":"Zholoy led the crossing."},{"id":"manas-2010:p0472:b001:l013","ordinal":21638,"en":"Of the short-coated Kytay,"},{"id":"manas-2010:p0472:b001:l014","ordinal":21639,"en":"The strong escaped alive"},{"id":"manas-2010:p0472:b001:l015","ordinal":21640,"en":"And blocked the ford."},{"id":"manas-2010:p0472:b001:l016","ordinal":21641,"en":"They put up a fierce fight."},{"id":"manas-2010:p0472:b001:l017","ordinal":21642,"en":"The imposing great marksman,"},{"id":"manas-2010:p0472:b001:l018","ordinal":21643,"en":"Karazhoy, barred the way."},{"id":"manas-2010:p0472:b001:l019","ordinal":21644,"en":"To encourage Karazhoy,"},{"id":"manas-2010:p0472:b001:l020","ordinal":21645,"en":"Ezkara and Zholoy spoke:"},{"id":"manas-2010:p0472:b001:l021","ordinal":21646,"en":"“He is a champion, he is a lion;"},{"id":"manas-2010:p0472:b001:l022","ordinal":21647,"en":"Manas is a warrior beyond the world."},{"id":"manas-2010:p0472:b001:l023","ordinal":21648,"en":"No fearsome marksman remains."},{"id":"manas-2010:p0472:b001:l024","ordinal":21649,"en":"This ill-omened Burut,"},{"id":"manas-2010:p0472:b001:l025","ordinal":21650,"en":"Of the stone-badged Kytay,"},{"id":"manas-2010:p0472:b001:l026","ordinal":21651,"en":"Devoured the shaven-headed men."},{"id":"manas-2010:p0472:b001:l027","ordinal":21652,"en":"The strong men in short coats died;"},{"id":"manas-2010:p0472:b001:l028","ordinal":21653,"en":"The shaven men wearing stones died."},{"id":"manas-2010:p0472:b001:l029","ordinal":21654,"en":"Among the lords, many khans died."},{"id":"manas-2010:p0472:b001:l030","ordinal":21655,"en":"That damned bloodstained one,"},{"id":"manas-2010:p0472:b001:l031","ordinal":21656,"en":"Everyone who met him died."},{"id":"manas-2010:p0472:b001:l032","ordinal":21657,"en":"The people who fought him died;"},{"id":"manas-2010:p0472:b001:l033","ordinal":21658,"en":"Not a soul remained unharmed."},{"id":"manas-2010:p0472:b001:l034","ordinal":21659,"en":"We have let so many be slaughtered."},{"id":"manas-2010:p0472:b001:l035","ordinal":21660,"en":"What will Esenkan say?"},{"id":"manas-2010:p0472:b001:l036","ordinal":21661,"en":"Those bearing iron ropes and nets"},{"id":"manas-2010:p0472:b001:l037","ordinal":21662,"en":"Have all been slaughtered."},{"id":"manas-2010:p0472:b001:l038","ordinal":21663,"en":"All my men with daggers in hand—"},{"id":"manas-2010:p0472:b001:l039","ordinal":21664,"en":"Even wrestling, our strength cannot suffice."},{"id":"manas-2010:p0472:b001:l040","ordinal":21665,"en":"Against bloodstained Manas, bringer of grief,"},{"id":"manas-2010:p0472:b001:l041","ordinal":21666,"en":"Even grappling, our power cannot suffice."},{"id":"manas-2010:p0472:b001:l042","ordinal":21667,"en":"To that deceiver of terrifying might,"},{"id":"manas-2010:p0473:b001:l001","ordinal":21668,"en":"Letting him throw the south into turmoil,"},{"id":"manas-2010:p0473:b001:l002","ordinal":21669,"en":"All these troops,"},{"id":"manas-2010:p0473:b001:l003","ordinal":21670,"en":"How can we return without shame,"},{"id":"manas-2010:p0473:b001:l004","ordinal":21671,"en":"Having lost them to one Burut?”"},{"id":"manas-2010:p0473:b001:l005","ordinal":21672,"en":"Roaring, hero Zholoy"},{"id":"manas-2010:p0473:b001:l006","ordinal":21673,"en":"Turned Achbuudan's head."},{"id":"manas-2010:p0473:b001:l007","ordinal":21674,"en":"The long forelock hanging down his back,"},{"id":"manas-2010:p0473:b001:l008","ordinal":21675,"en":"He tore and plucked it all out."},{"id":"manas-2010:p0473:b001:l009","ordinal":21676,"en":"Wrathful and rumbling,"},{"id":"manas-2010:p0473:b001:l010","ordinal":21677,"en":"God now struck Zholoy down!"},{"id":"manas-2010:p0473:b001:l011","ordinal":21678,"en":"He unleashed terrible wrath;"},{"id":"manas-2010:p0473:b001:l012","ordinal":21679,"en":"Bristling and raging,"},{"id":"manas-2010:p0473:b001:l013","ordinal":21680,"en":"All his remaining troops,"},{"id":"manas-2010:p0473:b001:l014","ordinal":21681,"en":"He nearly slaughtered them."},{"id":"manas-2010:p0473:b001:l015","ordinal":21682,"en":"The hair on his crown bristled;"},{"id":"manas-2010:p0473:b001:l016","ordinal":21683,"en":"Roaring with wrath,"},{"id":"manas-2010:p0473:b001:l017","ordinal":21684,"en":"'Die together, every one!' he cried,"},{"id":"manas-2010:p0473:b001:l018","ordinal":21685,"en":"Summoning his governors."},{"id":"manas-2010:p0473:b001:l019","ordinal":21686,"en":"He tugged and tore his mustache,"},{"id":"manas-2010:p0473:b001:l020","ordinal":21687,"en":"Plucked his beard and flung it away."},{"id":"manas-2010:p0473:b001:l021","ordinal":21688,"en":"May God never let you see it:"},{"id":"manas-2010:p0473:b001:l022","ordinal":21689,"en":"As though an evil spirit had struck his wife,"},{"id":"manas-2010:p0473:b001:l023","ordinal":21690,"en":"As though his fugitive had escaped nearby,"},{"id":"manas-2010:p0473:b001:l024","ordinal":21691,"en":"He spoke wildly, flinging harsh words,"},{"id":"manas-2010:p0473:b001:l025","ordinal":21692,"en":"Beginning speeches of every kind:"},{"id":"manas-2010:p0473:b001:l026","ordinal":21693,"en":"“Wrathful, bloodstained Manas's—"},{"id":"manas-2010:p0473:b001:l027","ordinal":21694,"en":"Stand firm, champions, do not flee—"},{"id":"manas-2010:p0473:b001:l028","ordinal":21695,"en":"Let us witness his terrible fury."},{"id":"manas-2010:p0473:b001:l029","ordinal":21696,"en":"Fighting without pause for six months,"},{"id":"manas-2010:p0473:b001:l030","ordinal":21697,"en":"Let us spill his blood this way!"},{"id":"manas-2010:p0473:b001:l031","ordinal":21698,"en":"Fleeing, fearing and fighting,"},{"id":"manas-2010:p0473:b001:l032","ordinal":21699,"en":"From that Burut filled with wrath,"},{"id":"manas-2010:p0473:b001:l033","ordinal":21700,"en":"What inheritance shall we gain?"},{"id":"manas-2010:p0473:b001:l034","ordinal":21701,"en":"'The Burut was alone, we were a myriad;"},{"id":"manas-2010:p0473:b001:l035","ordinal":21702,"en":"We let the undertaking be ruined,' saying this,"},{"id":"manas-2010:p0473:b001:l036","ordinal":21703,"en":"To Esenkan of Beejin,"},{"id":"manas-2010:p0473:b001:l037","ordinal":21704,"en":"How can we turn back and go?"},{"id":"manas-2010:p0473:b001:l038","ordinal":21705,"en":"Rather than suffer such humiliation,"},{"id":"manas-2010:p0473:b001:l039","ordinal":21706,"en":"Better than this, champions,"},{"id":"manas-2010:p0473:b001:l040","ordinal":21707,"en":"Let us perish in the slaughter!”"},{"id":"manas-2010:p0473:b001:l041","ordinal":21708,"en":"Shouting and rumbling,"},{"id":"manas-2010:p0473:b001:l042","ordinal":21709,"en":"Stamping like a drunken elephant,"},{"id":"manas-2010:p0474:b001:l001","ordinal":21710,"en":"He unleashed terrible wrath."},{"id":"manas-2010:p0474:b001:l002","ordinal":21711,"en":"His remaining troops, hero Zholoy"},{"id":"manas-2010:p0474:b001:l003","ordinal":21712,"en":"Nearly slaughtered them."},{"id":"manas-2010:p0474:b001:l004","ordinal":21713,"en":"He seized the faint-hearted;"},{"id":"manas-2010:p0474:b001:l005","ordinal":21714,"en":"'They break the warriors' spirit,' he said."},{"id":"manas-2010:p0474:b001:l006","ordinal":21715,"en":"He killed those who fled"},{"id":"manas-2010:p0474:b001:l007","ordinal":21716,"en":"And confined the strong."},{"id":"manas-2010:p0474:b001:l008","ordinal":21717,"en":"When they saw Zholoy's manner,"},{"id":"manas-2010:p0474:b001:l009","ordinal":21718,"en":"His lords and khans,"},{"id":"manas-2010:p0474:b001:l010","ordinal":21719,"en":"And the extraordinary marksman Karazhoy,"},{"id":"manas-2010:p0474:b001:l011","ordinal":21720,"en":"'Zholoy speaks truly,' they said,"},{"id":"manas-2010:p0474:b001:l012","ordinal":21721,"en":"And came to agreement."},{"id":"manas-2010:p0474:b001:l013","ordinal":21722,"en":"Biting his lip and narrowing his eyes,"},{"id":"manas-2010:p0474:b001:l014","ordinal":21723,"en":"He now showed boundless valor."},{"id":"manas-2010:p0474:b001:l015","ordinal":21724,"en":"Gleaming in red clothing,"},{"id":"manas-2010:p0474:b001:l016","ordinal":21725,"en":"The formidable marksman Karazhoy"},{"id":"manas-2010:p0474:b001:l017","ordinal":21726,"en":"Blocked the cliff-path."},{"id":"manas-2010:p0474:b001:l018","ordinal":21727,"en":"They stood on opposite banks,"},{"id":"manas-2010:p0474:b001:l019","ordinal":21728,"en":"Unable to reach one another with spears."},{"id":"manas-2010:p0474:b001:l020","ordinal":21729,"en":"Such was the warriors' sport:"},{"id":"manas-2010:p0474:b001:l021","ordinal":21730,"en":"They fought with guns."},{"id":"manas-2010:p0474:b001:l022","ordinal":21731,"en":"May He spare His servants"},{"id":"manas-2010:p0474:b001:l023","ordinal":21732,"en":"What the men of Beejin meted out!"},{"id":"manas-2010:p0474:b001:l024","ordinal":21733,"en":"Standing on opposite banks,"},{"id":"manas-2010:p0474:b001:l025","ordinal":21734,"en":"Firing guns and drawing bows,"},{"id":"manas-2010:p0474:b001:l026","ordinal":21735,"en":"They fought with thudding blows."},{"id":"manas-2010:p0474:b001:l027","ordinal":21736,"en":"All the armor was torn;"},{"id":"manas-2010:p0474:b001:l028","ordinal":21737,"en":"They waged fierce battle."},{"id":"manas-2010:p0474:b001:l029","ordinal":21738,"en":"Unable to reach one another with spears,"},{"id":"manas-2010:p0474:b001:l030","ordinal":21739,"en":"They remained on opposite banks."},{"id":"manas-2010:p0474:b001:l031","ordinal":21740,"en":"Standing without sparing their lives,"},{"id":"manas-2010:p0474:b001:l032","ordinal":21741,"en":"They fought in hardship."},{"id":"manas-2010:p0474:b001:l033","ordinal":21742,"en":"In the opening and shutting of an eye,"},{"id":"manas-2010:p0474:b001:l034","ordinal":21743,"en":"Before a word or two could be said,"},{"id":"manas-2010:p0474:b001:l035","ordinal":21744,"en":"Looking toward this side,"},{"id":"manas-2010:p0474:b001:l036","ordinal":21745,"en":"With an unsheathed sword strapped on,"},{"id":"manas-2010:p0474:b001:l037","ordinal":21746,"en":"Wrath spread across his face,"},{"id":"manas-2010:p0474:b001:l038","ordinal":21747,"en":"A great lord whose father was a giant,"},{"id":"manas-2010:p0474:b001:l039","ordinal":21748,"en":"A great champion full of strength,"},{"id":"manas-2010:p0474:b001:l040","ordinal":21749,"en":"Who had come ranging from the Kakan,"},{"id":"manas-2010:p0474:b001:l041","ordinal":21750,"en":"His face terrifying, his fury strong—"},{"id":"manas-2010:p0474:b001:l042","ordinal":21751,"en":"The champion who came from Kap-Too,"},{"id":"manas-2010:p0475:b001:l001","ordinal":21752,"en":"By grappling, he lays him low."},{"id":"manas-2010:p0475:b001:l002","ordinal":21753,"en":"He never leaves an attacking foe;"},{"id":"manas-2010:p0475:b001:l003","ordinal":21754,"en":"He has a reaper's nature too."},{"id":"manas-2010:p0475:b001:l004","ordinal":21755,"en":"None who grapple escape alive;"},{"id":"manas-2010:p0475:b001:l005","ordinal":21756,"en":"He has a devouring nature too."},{"id":"manas-2010:p0475:b001:l006","ordinal":21757,"en":"Before that unbeliever's fury,"},{"id":"manas-2010:p0475:b001:l007","ordinal":21758,"en":"The earth itself sagged down."},{"id":"manas-2010:p0475:b001:l008","ordinal":21759,"en":"Steel-tipped and brass-shafted,"},{"id":"manas-2010:p0475:b001:l009","ordinal":21760,"en":"He readied his spear in hand."}]
