[{"id":"manas-2010:p0462:b001:l038","ordinal":21249,"en":"Ulukman is there, and khans;"},{"id":"manas-2010:p0462:b001:l039","ordinal":21250,"en":"Among those accursed Chinese"},{"id":"manas-2010:p0462:b001:l040","ordinal":21251,"en":"Are men skilled in war."},{"id":"manas-2010:p0462:b001:l041","ordinal":21252,"en":"Thinking of it, my heart becomes a coal:"},{"id":"manas-2010:p0462:b001:l042","ordinal":21253,"en":"Among that Chinese people"}]
