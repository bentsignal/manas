[{"id":"semetey-1-2013:p0975:b003:l020","ordinal":150529,"en":"And raised the battle cry of Manas."},{"id":"semetey-1-2013:p0975:b003:l021","ordinal":150530,"en":"Overcome with joy,"},{"id":"semetey-1-2013:p0975:b003:l022","ordinal":150531,"en":"He pleaded with the two boys beside him,"},{"id":"semetey-1-2013:p0975:b003:l023","ordinal":150532,"en":"Calling, “Hurry and reach it!"},{"id":"semetey-1-2013:p0975:b003:l024","ordinal":150533,"en":"Kulchoro and Kanchoro,"},{"id":"semetey-1-2013:p0975:b003:l025","ordinal":150534,"en":"My two equal supports,"},{"id":"semetey-1-2013:p0975:b003:l026","ordinal":150535,"en":"You two, my younger brothers,"},{"id":"semetey-1-2013:p0975:b003:l027","ordinal":150536,"en":"Reach it before an arrow could;"},{"id":"semetey-1-2013:p0975:b003:l028","ordinal":150537,"en":"Get there and cut its throat."},{"id":"semetey-1-2013:p0975:b003:l029","ordinal":150538,"en":"Bind it securely again"},{"id":"semetey-1-2013:p0975:b003:l030","ordinal":150539,"en":"And fasten it to the saddle straps."},{"id":"semetey-1-2013:p0975:b003:l031","ordinal":150540,"en":"Slaughter it lawfully,"},{"id":"semetey-1-2013:p0975:b003:l032","ordinal":150541,"en":"And take it as a gift"},{"id":"semetey-1-2013:p0975:b003:l033","ordinal":150542,"en":"To my dear mother Kanykey!”"},{"id":"semetey-1-2013:p0975:b003:l034","ordinal":150543,"en":"After the falcon took it,"},{"id":"semetey-1-2013:p0975:b003:l035","ordinal":150544,"en":"Kulchoro and Kanchoro,"},{"id":"semetey-1-2013:p0975:b003:l036","ordinal":150545,"en":"The two choros, raced each other,"},{"id":"semetey-1-2013:p0975:b003:l037","ordinal":150546,"en":"Their stirrups striking together."},{"id":"semetey-1-2013:p0975:b003:l038","ordinal":150547,"en":"Before they could reach the swan,"},{"id":"semetey-1-2013:p0975:b003:l039","ordinal":150548,"en":"Wearing his handsome patterned coat,"},{"id":"semetey-1-2013:p0975:b004:l001","ordinal":150549,"en":"Semetey, brave son of Manas,"},{"id":"semetey-1-2013:p0975:b004:l002","ordinal":150550,"en":"Thundered along the road."},{"id":"semetey-1-2013:p0975:b004:l003","ordinal":150551,"en":"He made his neck turn like a stag’s;"},{"id":"semetey-1-2013:p0975:b004:l004","ordinal":150552,"en":"Buurul was a true courser,"},{"id":"semetey-1-2013:p0975:b004:l005","ordinal":150553,"en":"And when game appeared along its path,"},{"id":"semetey-1-2013:p0975:b004:l006","ordinal":150554,"en":"It sprang without delay."},{"id":"semetey-1-2013:p0975:b004:l007","ordinal":150555,"en":"He charged straight toward the swan;"},{"id":"semetey-1-2013:p0975:b004:l008","ordinal":150556,"en":"Poor Buurul’s hoofbeats"},{"id":"semetey-1-2013:p0975:b004:l009","ordinal":150557,"en":"Shattered the ground beneath him,"},{"id":"semetey-1-2013:p0975:b004:l010","ordinal":150558,"en":"And he flew roaring like a cloud."},{"id":"semetey-1-2013:p0975:b004:l011","ordinal":150559,"en":"Before one could say this or that,"},{"id":"semetey-1-2013:p0975:b004:l012","ordinal":150560,"en":"In the time it takes to blink,"},{"id":"semetey-1-2013:p0975:b004:l013","ordinal":150561,"en":"Semetey arrived like a master."},{"id":"semetey-1-2013:p0975:b004:l014","ordinal":150562,"en":"He had gone the length of a spear,"},{"id":"semetey-1-2013:p0975:b004:l015","ordinal":150563,"en":"Keeping his eyes fixed on the white swan."},{"id":"semetey-1-2013:p0975:b004:l016","ordinal":150564,"en":"Wondrous Akshunkar lay there,"},{"id":"semetey-1-2013:p0975:b004:l017","ordinal":150565,"en":"Clinging to the white swan’s neck;"},{"id":"semetey-1-2013:p0975:b004:l018","ordinal":150566,"en":"The white swan lay thrashing,"},{"id":"semetey-1-2013:p0975:b004:l019","ordinal":150567,"en":"Locked in battle with Akshunkar."},{"id":"semetey-1-2013:p0975:b004:l020","ordinal":150568,"en":"Raging, he made a sudden move,"},{"id":"semetey-1-2013:p0975:b004:l021","ordinal":150569,"en":"From tireless Buurul"},{"id":"semetey-1-2013:p0975:b004:l022","ordinal":150570,"en":"He sprang and leapt down."},{"id":"semetey-1-2013:p0975:b004:l023","ordinal":150571,"en":"The swan fled, and the falcon was gone;"},{"id":"semetey-1-2013:p0975:b004:l024","ordinal":150572,"en":"When Semetey opened his eyes,"},{"id":"semetey-1-2013:p0975:b004:l025","ordinal":150573,"en":"Such is the worthlessness of this world."},{"id":"semetey-1-2013:p0975:b004:l026","ordinal":150574,"en":"He saw the swan crawling away;"},{"id":"semetey-1-2013:p0975:b004:l027","ordinal":150575,"en":"The blue-maned tiger"},{"id":"semetey-1-2013:p0975:b004:l028","ordinal":150576,"en":"Reached out his hand to seize it,"},{"id":"semetey-1-2013:p0975:b004:l029","ordinal":150577,"en":"But caught the joint of its wing"},{"id":"semetey-1-2013:p0975:b004:l030","ordinal":150578,"en":"With an unsteady grip."},{"id":"semetey-1-2013:p0975:b004:l031","ordinal":150579,"en":"The white swan tore itself free"},{"id":"semetey-1-2013:p0975:b004:l032","ordinal":150580,"en":"And escaped into the deep water."},{"id":"semetey-1-2013:p0975:b004:l033","ordinal":150581,"en":"Where it crossed into Ala-Köl,"},{"id":"semetey-1-2013:p0975:b004:l034","ordinal":150582,"en":"The swaggering madman"},{"id":"semetey-1-2013:p0975:b004:l035","ordinal":150583,"en":"Caught it by the throat."},{"id":"semetey-1-2013:p0975:b004:l036","ordinal":150584,"en":"He pulled back in grief,"},{"id":"semetey-1-2013:p0975:b004:l037","ordinal":150585,"en":"And Semetey, still bewildered,"},{"id":"semetey-1-2013:p0975:b004:l038","ordinal":150586,"en":"Ran toward Arbuudan."},{"id":"semetey-1-2013:p0975:b004:l039","ordinal":150587,"en":"What could the desperate prince do?"},{"id":"semetey-1-2013:p0976:b003:l001","ordinal":150588,"en":"Toward Buurul, standing riderless,"},{"id":"semetey-1-2013:p0976:b003:l002","ordinal":150589,"en":"The bewildered Semetey"},{"id":"semetey-1-2013:p0976:b003:l003","ordinal":150590,"en":"Ran and mounted in haste."},{"id":"semetey-1-2013:p0976:b003:l004","ordinal":150591,"en":"That white swan would not release"},{"id":"semetey-1-2013:p0976:b003:l005","ordinal":150592,"en":"Kojosán’s falcon;"},{"id":"semetey-1-2013:p0976:b003:l006","ordinal":150593,"en":"It clenched the short leash,"},{"id":"semetey-1-2013:p0976:b003:l007","ordinal":150594,"en":"Tucked it beneath its wing,"},{"id":"semetey-1-2013:p0976:b003:l008","ordinal":150595,"en":"Beat the water with its tail,"},{"id":"semetey-1-2013:p0976:b003:l009","ordinal":150596,"en":"And thrashed the dark lake with its wings."},{"id":"semetey-1-2013:p0976:b003:l010","ordinal":150597,"en":"It went farther downward,"},{"id":"semetey-1-2013:p0976:b003:l011","ordinal":150598,"en":"Then sped away like the wind;"},{"id":"semetey-1-2013:p0976:b003:l012","ordinal":150599,"en":"When he looked, it vanished from sight."},{"id":"semetey-1-2013:p0976:b003:l013","ordinal":150600,"en":"The great white swan was escaping,"},{"id":"semetey-1-2013:p0976:b003:l014","ordinal":150601,"en":"And no one could tell which it was."},{"id":"semetey-1-2013:p0976:b003:l015","ordinal":150602,"en":"Your young, blue-maned prince"},{"id":"semetey-1-2013:p0976:b003:l016","ordinal":150603,"en":"Had a true courser beneath him,"},{"id":"semetey-1-2013:p0976:b003:l017","ordinal":150604,"en":"Which raced with a flying bird;"},{"id":"semetey-1-2013:p0976:b003:l018","ordinal":150605,"en":"The white reins steeped in tanning liquor"},{"id":"semetey-1-2013:p0976:b003:l019","ordinal":150606,"en":"Contracted within his palm."},{"id":"semetey-1-2013:p0976:b003:l020","ordinal":150607,"en":"He pursued the white swan"},{"id":"semetey-1-2013:p0976:b003:l021","ordinal":150608,"en":"Upon the true tulpar Buurul."},{"id":"semetey-1-2013:p0976:b003:l022","ordinal":150609,"en":"The white swan’s uncanny power"},{"id":"semetey-1-2013:p0976:b003:l023","ordinal":150610,"en":"Had carried the falcon away."},{"id":"semetey-1-2013:p0976:b003:l024","ordinal":150611,"en":"With a camel-like forelock and swept-back mane,"},{"id":"semetey-1-2013:p0976:b003:l025","ordinal":150612,"en":"Buurul was a true courser;"},{"id":"semetey-1-2013:p0976:b003:l026","ordinal":150613,"en":"He laid his ears flat like a wild ass,"},{"id":"semetey-1-2013:p0976:b003:l027","ordinal":150614,"en":"And with no escape in sight,"},{"id":"semetey-1-2013:p0976:b003:l028","ordinal":150615,"en":"Churned the earth like a whirlwind."},{"id":"semetey-1-2013:p0976:b003:l029","ordinal":150616,"en":"He gathered himself in bounding strides,"},{"id":"semetey-1-2013:p0976:b003:l030","ordinal":150617,"en":"And surged as though diving into a hollow."},{"id":"semetey-1-2013:p0976:b003:l031","ordinal":150618,"en":"From a ridge curved like a saddle bow,"},{"id":"semetey-1-2013:p0976:b003:l032","ordinal":150619,"en":"He bent low and entered beyond it."},{"id":"semetey-1-2013:p0976:b003:l033","ordinal":150620,"en":"They drew close;"},{"id":"semetey-1-2013:p0976:b003:l034","ordinal":150621,"en":"Your swaggering madman"},{"id":"semetey-1-2013:p0976:b003:l035","ordinal":150622,"en":"Raised the patterned spear in his hand"},{"id":"semetey-1-2013:p0976:b003:l036","ordinal":150623,"en":"And cast it badly."},{"id":"semetey-1-2013:p0976:b003:l037","ordinal":150624,"en":"Seeing that escape was impossible,"},{"id":"semetey-1-2013:p0976:b003:l038","ordinal":150625,"en":"What could poor Chürök do?"},{"id":"semetey-1-2013:p0976:b003:l039","ordinal":150626,"en":"It farted with a crack and shat with a snap,"},{"id":"semetey-1-2013:p0976:b004:l001","ordinal":150627,"en":"And cast down a walking fog."},{"id":"semetey-1-2013:p0976:b004:l002","ordinal":150628,"en":"When he looked, nothing could be seen,"},{"id":"semetey-1-2013:p0976:b004:l003","ordinal":150629,"en":"And no one knew where it was."},{"id":"semetey-1-2013:p0976:b004:l004","ordinal":150630,"en":"Clouds split open in the sky,"},{"id":"semetey-1-2013:p0976:b004:l005","ordinal":150631,"en":"And rain poured onto the earth;"},{"id":"semetey-1-2013:p0976:b004:l006","ordinal":150632,"en":"Clouds wheeled across the heavens,"},{"id":"semetey-1-2013:p0976:b004:l007","ordinal":150633,"en":"And eight months’ hail poured down."},{"id":"semetey-1-2013:p0976:b004:l008","ordinal":150634,"en":"A squall went shrieking,"},{"id":"semetey-1-2013:p0976:b004:l009","ordinal":150635,"en":"Through ravine, slope, and plain;"},{"id":"semetey-1-2013:p0976:b004:l010","ordinal":150636,"en":"A foul fog roared,"},{"id":"semetey-1-2013:p0976:b004:l011","ordinal":150637,"en":"And a walking mist descended and blinded the eyes."},{"id":"semetey-1-2013:p0976:b004:l012","ordinal":150638,"en":"Rain covered every lowland,"},{"id":"semetey-1-2013:p0976:b004:l013","ordinal":150639,"en":"Hail covered every upland,"},{"id":"semetey-1-2013:p0976:b004:l014","ordinal":150640,"en":"And the sun was hidden from view."},{"id":"semetey-1-2013:p0976:b004:l015","ordinal":150641,"en":"The falcon was carried away,"},{"id":"semetey-1-2013:p0976:b004:l016","ordinal":150642,"en":"And that Chürök escaped."},{"id":"semetey-1-2013:p0976:b004:l017","ordinal":150643,"en":"Nar Buurul opened his stride;"},{"id":"semetey-1-2013:p0976:b004:l018","ordinal":150644,"en":"The tiger, his father Manas,"},{"id":"semetey-1-2013:p0976:b004:l019","ordinal":150645,"en":"Seemed to have died that very day."},{"id":"semetey-1-2013:p0976:b004:l020","ordinal":150646,"en":"The tiger grieved,"},{"id":"semetey-1-2013:p0976:b004:l021","ordinal":150647,"en":"Having lost Akshunkar;"},{"id":"semetey-1-2013:p0976:b004:l022","ordinal":150648,"en":"His anger rose and his face darkened,"},{"id":"semetey-1-2013:p0976:b004:l023","ordinal":150649,"en":"And his dark rage swelled."},{"id":"semetey-1-2013:p0976:b004:l024","ordinal":150650,"en":"He shouted in fury,"},{"id":"semetey-1-2013:p0976:b004:l025","ordinal":150651,"en":"Calling Kulchoro and Kanchoro,"},{"id":"semetey-1-2013:p0976:b004:l026","ordinal":150652,"en":"Summoning the two of them."},{"id":"semetey-1-2013:p0976:b004:l027","ordinal":150653,"en":"His bellow split heads,"},{"id":"semetey-1-2013:p0976:b004:l028","ordinal":150654,"en":"His cry split stones;"},{"id":"semetey-1-2013:p0976:b004:l029","ordinal":150655,"en":"His eyes blazed like a lion’s,"},{"id":"semetey-1-2013:p0976:b004:l030","ordinal":150656,"en":"And bloodlust truly seized him."},{"id":"semetey-1-2013:p0976:b004:l031","ordinal":150657,"en":"He blackened in his dark fury,"},{"id":"semetey-1-2013:p0976:b004:l032","ordinal":150658,"en":"And when the exhausted prince stood there,"},{"id":"semetey-1-2013:p0976:b004:l033","ordinal":150659,"en":"Kulchoro and Kanchoro,"},{"id":"semetey-1-2013:p0976:b004:l034","ordinal":150660,"en":"The two choros, raced one another,"},{"id":"semetey-1-2013:p0976:b004:l035","ordinal":150661,"en":"Their stirrups striking together;"},{"id":"semetey-1-2013:p0976:b004:l036","ordinal":150662,"en":"They fought the bits"},{"id":"semetey-1-2013:p0976:b004:l037","ordinal":150663,"en":"Of their two equal tulpars."},{"id":"semetey-1-2013:p0976:b004:l038","ordinal":150664,"en":"When they drew near the prince,"},{"id":"semetey-1-2013:p0976:b004:l039","ordinal":150665,"en":"He poured out bitter reproaches,"},{"id":"semetey-1-2013:p0977:b003:l001","ordinal":150666,"en":"When my two equal warrior choros"},{"id":"semetey-1-2013:p0977:b003:l002","ordinal":150667,"en":"Had caused this calamity,"},{"id":"semetey-1-2013:p0977:b003:l003","ordinal":150668,"en":"Kulchoro said these words:"},{"id":"semetey-1-2013:p0977:b003:l004","ordinal":150669,"en":"“You let the swan take it—"},{"id":"semetey-1-2013:p0977:b003:l005","ordinal":150670,"en":"My poor elder, lay the blame on me!”"},{"id":"semetey-1-2013:p0977:b003:l006","ordinal":150671,"en":"Then Kanchoro stood and said:"},{"id":"semetey-1-2013:p0977:b003:l007","ordinal":150672,"en":"“It was a swan come from Mecca,"},{"id":"semetey-1-2013:p0977:b003:l008","ordinal":150673,"en":"And it had five young;"},{"id":"semetey-1-2013:p0977:b003:l009","ordinal":150674,"en":"It was a being of wondrous power."},{"id":"semetey-1-2013:p0977:b003:l010","ordinal":150675,"en":"Brave elder, lay the blame on me!”"},{"id":"semetey-1-2013:p0977:b003:l011","ordinal":150676,"en":"“Grant us as a gift, elder, grant us!” they said."},{"id":"semetey-1-2013:p0977:b003:l012","ordinal":150677,"en":"The two bastards, fierce as flames,"},{"id":"semetey-1-2013:p0977:b003:l013","ordinal":150678,"en":"Thought the prince would kill them."},{"id":"semetey-1-2013:p0977:b003:l014","ordinal":150679,"en":"Speaking pitiful, bitter words,"},{"id":"semetey-1-2013:p0977:b003:l015","ordinal":150680,"en":"They cried, “Mercy, grant us our lives!”"},{"id":"semetey-1-2013:p0977:b003:l016","ordinal":150681,"en":"And the two wretches kept pleading."},{"id":"semetey-1-2013:p0977:b003:l017","ordinal":150682,"en":"Brave Semetey then said:"},{"id":"semetey-1-2013:p0977:b003:l018","ordinal":150683,"en":"“My cliff no goose can circle,"},{"id":"semetey-1-2013:p0977:b003:l019","ordinal":150684,"en":"Kanchoro and Kulchoro,"},{"id":"semetey-1-2013:p0977:b003:l020","ordinal":150685,"en":"My mountains standing watch,"},{"id":"semetey-1-2013:p0977:b003:l021","ordinal":150686,"en":"My steel battle-axe in hand,"},{"id":"semetey-1-2013:p0977:b003:l022","ordinal":150687,"en":"Whose sight fills my belly,"},{"id":"semetey-1-2013:p0977:b003:l023","ordinal":150688,"en":"My two sheltering supports!"},{"id":"semetey-1-2013:p0977:b003:l024","ordinal":150689,"en":"I have nine thousand horses in the mountains,"},{"id":"semetey-1-2013:p0977:b003:l025","ordinal":150690,"en":"Yet no courser fit to ride the hunt."},{"id":"semetey-1-2013:p0977:b003:l026","ordinal":150691,"en":"Do not torment your elder;"},{"id":"semetey-1-2013:p0977:b003:l027","ordinal":150692,"en":"I have no kin apart from you two."},{"id":"semetey-1-2013:p0977:b003:l028","ordinal":150693,"en":"You kicked together like young colts,"},{"id":"semetey-1-2013:p0977:b003:l029","ordinal":150694,"en":"Can such a calamity befall us,"},{"id":"semetey-1-2013:p0977:b003:l030","ordinal":150695,"en":"You who struggled for the same breast?"},{"id":"semetey-1-2013:p0977:b003:l031","ordinal":150696,"en":"My fortunate choros, both of you, listen!"},{"id":"semetey-1-2013:p0977:b003:l032","ordinal":150697,"en":"Many people have flown falcons,"},{"id":"semetey-1-2013:p0977:b003:l033","ordinal":150698,"en":"And many mortals have tasted joy."},{"id":"semetey-1-2013:p0977:b003:l034","ordinal":150699,"en":"Our dream has broken apart."},{"id":"semetey-1-2013:p0977:b003:l035","ordinal":150700,"en":"Trace this grievous event"},{"id":"semetey-1-2013:p0977:b003:l036","ordinal":150701,"en":"Through the lines of tradition;"},{"id":"semetey-1-2013:p0977:b003:l037","ordinal":150702,"en":"Ask the learned men"},{"id":"semetey-1-2013:p0977:b003:l038","ordinal":150703,"en":"About this affliction we have seen!"},{"id":"semetey-1-2013:p0977:b003:l039","ordinal":150704,"en":"Tell the long-lived elders,"},{"id":"semetey-1-2013:p0977:b005:l001","ordinal":150705,"en":"Tell those whose ears hear far."},{"id":"semetey-1-2013:p0977:b005:l002","ordinal":150706,"en":"They used to say that when a bird was flown at a swan,"},{"id":"semetey-1-2013:p0977:b005:l003","ordinal":150707,"en":"If the falcon was a true killer,"},{"id":"semetey-1-2013:p0977:b005:l004","ordinal":150708,"en":"It would take its swan;"},{"id":"semetey-1-2013:p0977:b005:l005","ordinal":150709,"en":"If that falcon failed to take it,"},{"id":"semetey-1-2013:p0977:b005:l006","ordinal":150710,"en":"The swan would escape into the sky"},{"id":"semetey-1-2013:p0977:b005:l007","ordinal":150711,"en":"And the bird itself would remain."},{"id":"semetey-1-2013:p0977:b005:l008","ordinal":150712,"en":"The swan is gone, and so is the bird—"},{"id":"semetey-1-2013:p0977:b005:l009","ordinal":150713,"en":"Is this a day of God’s punishment?"},{"id":"semetey-1-2013:p0977:b005:l010","ordinal":150714,"en":"Was the falcon’s flight away"},{"id":"semetey-1-2013:p0977:b005:l011","ordinal":150715,"en":"Some enchantment that blinded our eyes?"},{"id":"semetey-1-2013:p0977:b005:l012","ordinal":150716,"en":"My two companion equals,"},{"id":"semetey-1-2013:p0977:b005:l013","ordinal":150717,"en":"Because of what has happened,"},{"id":"semetey-1-2013:p0977:b005:l014","ordinal":150718,"en":"Because of Akshunkar,"},{"id":"semetey-1-2013:p0977:b005:l015","ordinal":150719,"en":"I shall scour the whole earth on horseback."},{"id":"semetey-1-2013:p0977:b005:l016","ordinal":150720,"en":"Of the eighteen thousand worlds,"},{"id":"semetey-1-2013:p0977:b005:l017","ordinal":150721,"en":"I shall leave none unvisited."},{"id":"semetey-1-2013:p0977:b005:l018","ordinal":150722,"en":"From Kakan and Beijing,"},{"id":"semetey-1-2013:p0977:b005:l019","ordinal":150723,"en":"From the Black Chinese and the Solon,"},{"id":"semetey-1-2013:p0977:b005:l020","ordinal":150724,"en":"From the bearded Russians,"},{"id":"semetey-1-2013:p0977:b005:l021","ordinal":150725,"en":"And from the muskets before our brows,"},{"id":"semetey-1-2013:p0977:b005:l022","ordinal":150726,"en":"I shall seek news everywhere"},{"id":"semetey-1-2013:p0977:b005:l023","ordinal":150727,"en":"Concerning Akshunkar."},{"id":"semetey-1-2013:p0977:b005:l024","ordinal":150728,"en":"I shall gird my waist firmly;"},{"id":"semetey-1-2013:p0977:b005:l025","ordinal":150729,"en":"Because of Akshunkar,"},{"id":"semetey-1-2013:p0977:b005:l026","ordinal":150730,"en":"I shall raise an uproar wherever I confront a foe."},{"id":"semetey-1-2013:p0977:b005:l027","ordinal":150731,"en":"I shall put on armor no bullet can pierce;"},{"id":"semetey-1-2013:p0977:b005:l028","ordinal":150732,"en":"Because of this falcon,"},{"id":"semetey-1-2013:p0977:b005:l029","ordinal":150733,"en":"I shall grapple with every mighty man."},{"id":"semetey-1-2013:p0977:b005:l030","ordinal":150734,"en":"Because of what has happened,"},{"id":"semetey-1-2013:p0977:b005:l031","ordinal":150735,"en":"Because of Akshunkar,"},{"id":"semetey-1-2013:p0977:b005:l032","ordinal":150736,"en":"I shall scatter as tribute"},{"id":"semetey-1-2013:p0977:b005:l033","ordinal":150737,"en":"The countless gold coins left by Manas."},{"id":"semetey-1-2013:p0977:b005:l034","ordinal":150738,"en":"I shall gird my renowned waist;"},{"id":"semetey-1-2013:p0977:b005:l035","ordinal":150739,"en":"Because of this falcon,"},{"id":"semetey-1-2013:p0977:b005:l036","ordinal":150740,"en":"I shall lay hands upon whoever stands against me.”"},{"id":"semetey-1-2013:p0977:b005:l037","ordinal":150741,"en":"Kulchoro and Kanchoro"},{"id":"semetey-1-2013:p0977:b005:l038","ordinal":150742,"en":"Went to tell my tiger elder Bakay"},{"id":"semetey-1-2013:p0977:b005:l039","ordinal":150743,"en":"That Akshunkar had flown away,"},{"id":"semetey-1-2013:p0978:b003:l001","ordinal":150744,"en":"It was a wondrous slave-woman—"},{"id":"semetey-1-2013:p0978:b003:l002","ordinal":150745,"en":"Tell my wretched mother, the fierce one!"},{"id":"semetey-1-2013:p0978:b003:l003","ordinal":150746,"en":"Tell Sarykan of the bowl-shaped eyes,"},{"id":"semetey-1-2013:p0978:b003:l004","ordinal":150747,"en":"Tell my wise elder, the hero!"},{"id":"semetey-1-2013:p0978:b003:l005","ordinal":150748,"en":"Tell Jamgyrchy of the Esheks,"},{"id":"semetey-1-2013:p0978:b003:l006","ordinal":150749,"en":"Tell the sage who has seen so much!"},{"id":"semetey-1-2013:p0978:b003:l007","ordinal":150750,"en":"Tell the broad-backed woman"},{"id":"semetey-1-2013:p0978:b003:l008","ordinal":150751,"en":"Who once tangled herself in my reins"},{"id":"semetey-1-2013:p0978:b003:l009","ordinal":150752,"en":"And remained screaming and weeping!"},{"id":"semetey-1-2013:p0978:b003:l010","ordinal":150753,"en":"If she knows news of the falcon,"},{"id":"semetey-1-2013:p0978:b003:l011","ordinal":150754,"en":"Let her tell it swiftly, without delay;"},{"id":"semetey-1-2013:p0978:b003:l012","ordinal":150755,"en":"Let her speak at once, without grieving a soul."},{"id":"semetey-1-2013:p0978:b003:l013","ordinal":150756,"en":"If she knows where the falcon went,"},{"id":"semetey-1-2013:p0978:b003:l014","ordinal":150757,"en":"And tells its secret plainly,"},{"id":"semetey-1-2013:p0978:b003:l015","ordinal":150758,"en":"Then I shall not raise my whip"},{"id":"semetey-1-2013:p0978:b003:l016","ordinal":150759,"en":"Against your sister-in-law again;"},{"id":"semetey-1-2013:p0978:b003:l017","ordinal":150760,"en":"I shall say neither this nor that,"},{"id":"semetey-1-2013:p0978:b003:l018","ordinal":150761,"en":"And shall not take another wife beneath her."},{"id":"semetey-1-2013:p0978:b003:l019","ordinal":150762,"en":"If she says the falcon went by this road,"},{"id":"semetey-1-2013:p0978:b003:l020","ordinal":150763,"en":"And afterward I deny my word,"},{"id":"semetey-1-2013:p0978:b003:l021","ordinal":150764,"en":"May the open sky strike her crown!"},{"id":"semetey-1-2013:p0978:b003:l022","ordinal":150765,"en":"May the hairy earth strike her breast!"},{"id":"semetey-1-2013:p0978:b003:l023","ordinal":150766,"en":"May God Almighty strike her!"},{"id":"semetey-1-2013:p0978:b003:l024","ordinal":150767,"en":"May Akkelte’s bullet strike her!"},{"id":"semetey-1-2013:p0978:b003:l025","ordinal":150768,"en":"If that woman makes an empty boast,"},{"id":"semetey-1-2013:p0978:b003:l026","ordinal":150769,"en":"May the oath I have spoken strike her!”"},{"id":"semetey-1-2013:p0978:b003:l027","ordinal":150770,"en":"Speaking words of greeting and prayer,"},{"id":"semetey-1-2013:p0978:b003:l028","ordinal":150771,"en":"And voicing his bitter lament,"},{"id":"semetey-1-2013:p0978:b003:l029","ordinal":150772,"en":"Semetey, the son of Manas,"},{"id":"semetey-1-2013:p0978:b003:l030","ordinal":150773,"en":"As though his father, the lion Manas,"},{"id":"semetey-1-2013:p0978:b003:l031","ordinal":150774,"en":"Had died that very day,"},{"id":"semetey-1-2013:p0978:b003:l032","ordinal":150775,"en":"Removed the saddle from camel-like Buurul"},{"id":"semetey-1-2013:p0978:b003:l033","ordinal":150776,"en":"And left him bare,"},{"id":"semetey-1-2013:p0978:b003:l034","ordinal":150777,"en":"Hobbled and tethered him,"},{"id":"semetey-1-2013:p0978:b003:l035","ordinal":150778,"en":"Set the leather saddle cloth and blue pad"},{"id":"semetey-1-2013:p0978:b003:l036","ordinal":150779,"en":"Against his own hip,"},{"id":"semetey-1-2013:p0978:b003:l037","ordinal":150780,"en":"Appealed to the Creator,"},{"id":"semetey-1-2013:p0978:b003:l038","ordinal":150781,"en":"And made the Akkangky his pillow."},{"id":"semetey-1-2013:p0978:b003:l039","ordinal":150782,"en":"The noble man’s brave son"},{"id":"semetey-1-2013:p0978:b004:l001","ordinal":150783,"en":"Lay with his head toward the qibla,"},{"id":"semetey-1-2013:p0978:b004:l002","ordinal":150784,"en":"Wrapped himself in the Akolpok,"}]
