[{"id":"semetey-2-2013:p1290:b003:l004","ordinal":285953,"en":"Hero, you are comrades of the same age."},{"id":"semetey-2-2013:p1290:b003:l005","ordinal":285954,"en":"Spear him as you see fit;"},{"id":"semetey-2-2013:p1290:b003:l006","ordinal":285955,"en":"Hero, bind your enemy."},{"id":"semetey-2-2013:p1290:b003:l007","ordinal":285956,"en":"These teeming black-clad Jediger—"},{"id":"semetey-2-2013:p1290:b003:l008","ordinal":285957,"en":"I will not contest them with you;"},{"id":"semetey-2-2013:p1290:b003:l009","ordinal":285958,"en":"Take their khanship for yourself."},{"id":"semetey-2-2013:p1290:b003:l010","ordinal":285959,"en":"Hero, do whatever the occasion demands."},{"id":"semetey-2-2013:p1290:b003:l011","ordinal":285960,"en":"Hero, Kanchoro and Külchoro,"},{"id":"semetey-2-2013:p1290:b003:l012","ordinal":285961,"en":"You are confidants who grew up together;"},{"id":"semetey-2-2013:p1290:b003:l013","ordinal":285962,"en":"United when you were no bigger than lice,"},{"id":"semetey-2-2013:p1290:b003:l014","ordinal":285963,"en":"Joined when you were no bigger than thumbs."},{"id":"semetey-2-2013:p1290:b003:l015","ordinal":285964,"en":"Your sheep shared the same fold,"},{"id":"semetey-2-2013:p1290:b003:l016","ordinal":285965,"en":"Your heads shared the same fellowship;"},{"id":"semetey-2-2013:p1290:b003:l017","ordinal":285966,"en":"Whatever you found, you gathered together."},{"id":"semetey-2-2013:p1290:b003:l018","ordinal":285967,"en":"I know the hero’s secret—"},{"id":"semetey-2-2013:p1290:b003:l019","ordinal":285968,"en":"Spear him yourself!”"},{"id":"semetey-2-2013:p1290:b003:l020","ordinal":285969,"en":"So spoke brave Kyyaz;"},{"id":"semetey-2-2013:p1290:b003:l021","ordinal":285970,"en":"Terrified by the hero’s venom,"},{"id":"semetey-2-2013:p1290:b003:l022","ordinal":285971,"en":"Brave Kyyaz stood in anguish,"},{"id":"semetey-2-2013:p1290:b003:l023","ordinal":285972,"en":"Pleading with Kanchoro."},{"id":"semetey-2-2013:p1290:b003:l024","ordinal":285973,"en":"When Kanchoro heard this,"},{"id":"semetey-2-2013:p1290:b003:l025","ordinal":285974,"en":"He bristled in wrath,"},{"id":"semetey-2-2013:p1290:b003:l026","ordinal":285975,"en":"Swelling boldly with resolve;"},{"id":"semetey-2-2013:p1290:b003:l027","ordinal":285976,"en":"His eyes gaped like an opened pit,"},{"id":"semetey-2-2013:p1290:b003:l028","ordinal":285977,"en":"His face gleamed like oiled wheat."},{"id":"semetey-2-2013:p1290:b003:l029","ordinal":285978,"en":"His two cheeks hung loose,"},{"id":"semetey-2-2013:p1290:b003:l030","ordinal":285979,"en":"Enough to feast two giants;"},{"id":"semetey-2-2013:p1290:b003:l031","ordinal":285980,"en":"When the savage grew enraged,"},{"id":"semetey-2-2013:p1290:b003:l032","ordinal":285981,"en":"He seemed ready to slaughter anyone he fought."},{"id":"semetey-2-2013:p1290:b003:l033","ordinal":285982,"en":"With a steel haft and a keen edge,"},{"id":"semetey-2-2013:p1290:b003:l034","ordinal":285983,"en":"He strapped on his battle-axe,"},{"id":"semetey-2-2013:p1290:b003:l035","ordinal":285984,"en":"Put on his arrow-proof coat,"},{"id":"semetey-2-2013:p1290:b003:l036","ordinal":285985,"en":"And his hostile intent became plain."},{"id":"semetey-2-2013:p1290:b003:l037","ordinal":285986,"en":"That broad-jawed battle-axe,"},{"id":"semetey-2-2013:p1290:b003:l038","ordinal":285987,"en":"Its steel edge honed sharp,"},{"id":"semetey-2-2013:p1290:b003:l039","ordinal":285988,"en":"Its handle wound with gold,"},{"id":"semetey-2-2013:p1290:b004:l001","ordinal":285989,"en":"Destined for the enemy he would fight,"},{"id":"semetey-2-2013:p1290:b004:l002","ordinal":285990,"en":"Was fashioned in every splendid form"},{"id":"semetey-2-2013:p1290:b004:l003","ordinal":285991,"en":"By the master of masters, the great smith,"},{"id":"semetey-2-2013:p1290:b004:l004","ordinal":285992,"en":"By Bölökbay himself."},{"id":"semetey-2-2013:p1290:b004:l005","ordinal":285993,"en":"When it came time to temper it,"},{"id":"semetey-2-2013:p1290:b004:l006","ordinal":285994,"en":"The waters of the Black Spring were drained;"},{"id":"semetey-2-2013:p1290:b004:l007","ordinal":285995,"en":"The smith perfected its edge."},{"id":"semetey-2-2013:p1290:b004:l008","ordinal":285996,"en":"Unable to supply enough charcoal,"},{"id":"semetey-2-2013:p1290:b004:l009","ordinal":285997,"en":"A forest of plane trees was destroyed;"},{"id":"semetey-2-2013:p1290:b004:l010","ordinal":285998,"en":"No creature could endure the bellows’ demands,"},{"id":"semetey-2-2013:p1290:b004:l011","ordinal":285999,"en":"So a blue bull was slaughtered."},{"id":"semetey-2-2013:p1290:b004:l012","ordinal":286000,"en":"Such was the battle-axe."},{"id":"semetey-2-2013:p1290:b004:l013","ordinal":286001,"en":"He slipped it over his bare forearm;"},{"id":"semetey-2-2013:p1290:b004:l014","ordinal":286002,"en":"Look closely, and Kanchoro"},{"id":"semetey-2-2013:p1290:b004:l015","ordinal":286003,"en":"Raged like a white tiger,"},{"id":"semetey-2-2013:p1290:b004:l016","ordinal":286004,"en":"Growling and working himself into fury."},{"id":"semetey-2-2013:p1290:b004:l017","ordinal":286005,"en":"The wretch strode forth"},{"id":"semetey-2-2013:p1290:b004:l018","ordinal":286006,"en":"And addressed Külchoro."},{"id":"semetey-2-2013:p1290:b004:l019","ordinal":286007,"en":"But poor Külchoro"},{"id":"semetey-2-2013:p1290:b004:l020","ordinal":286008,"en":"Had no strength left to exchange blows,"},{"id":"semetey-2-2013:p1290:b004:l021","ordinal":286009,"en":"No means left there to wrestle,"},{"id":"semetey-2-2013:p1290:b004:l022","ordinal":286010,"en":"No power left to grapple."},{"id":"semetey-2-2013:p1290:b004:l023","ordinal":286011,"en":"All strength had deserted the hero;"},{"id":"semetey-2-2013:p1290:b004:l024","ordinal":286012,"en":"He stood there in angry anguish,"},{"id":"semetey-2-2013:p1290:b004:l025","ordinal":286013,"en":"The poor man,"},{"id":"semetey-2-2013:p1290:b004:l026","ordinal":286014,"en":"Pleading with Kanchoro:"},{"id":"semetey-2-2013:p1290:b004:l027","ordinal":286015,"en":"“Oh, my dear Kanchoro,"},{"id":"semetey-2-2013:p1290:b004:l028","ordinal":286016,"en":"You have known me from our earliest days—"},{"id":"semetey-2-2013:p1290:b004:l029","ordinal":286017,"en":"My warrior who took the socketed spear"},{"id":"semetey-2-2013:p1290:b004:l030","ordinal":286018,"en":"And shattered armies beyond number!"},{"id":"semetey-2-2013:p1290:b004:l031","ordinal":286019,"en":"Today, elder brother and khan,"},{"id":"semetey-2-2013:p1290:b004:l032","ordinal":286020,"en":"I am a wretch fallen into your hands."},{"id":"semetey-2-2013:p1290:b004:l033","ordinal":286021,"en":"Like grass swept into a wildfire,"},{"id":"semetey-2-2013:p1290:b004:l034","ordinal":286022,"en":"Robbed of every protector,"},{"id":"semetey-2-2013:p1290:b004:l035","ordinal":286023,"en":"I bow my neck to death."},{"id":"semetey-2-2013:p1290:b004:l036","ordinal":286024,"en":"We were foster brothers from the beginning;"},{"id":"semetey-2-2013:p1290:b004:l037","ordinal":286025,"en":"My lord, I stand in your hands."},{"id":"semetey-2-2013:p1290:b004:l038","ordinal":286026,"en":"Hero, if you stiffen in wrath,"},{"id":"semetey-2-2013:p1290:b004:l039","ordinal":286027,"en":"I will not resist—slaughter me."},{"id":"semetey-2-2013:p1291:b003:l001","ordinal":286028,"en":"Yet if we truly were foster brothers,"},{"id":"semetey-2-2013:p1291:b003:l002","ordinal":286029,"en":"Spare me and leave me alive."},{"id":"semetey-2-2013:p1291:b003:l003","ordinal":286030,"en":"Were we not slopes upon the same mountain pass,"},{"id":"semetey-2-2013:p1291:b003:l004","ordinal":286031,"en":"Foster brothers sharing a single soul?"},{"id":"semetey-2-2013:p1291:b003:l005","ordinal":286032,"en":"Whatever we found, we gathered together;"},{"id":"semetey-2-2013:p1291:b003:l006","ordinal":286033,"en":"We grew up together, companions of one age."},{"id":"semetey-2-2013:p1291:b003:l007","ordinal":286034,"en":"We kicked and tussled like colt and yearling,"},{"id":"semetey-2-2013:p1291:b003:l008","ordinal":286035,"en":"And quarreled as we suckled the same breast."},{"id":"semetey-2-2013:p1291:b003:l009","ordinal":286036,"en":"We slept in the same bed"},{"id":"semetey-2-2013:p1291:b003:l010","ordinal":286037,"en":"And shared the same delights."},{"id":"semetey-2-2013:p1291:b003:l011","ordinal":286038,"en":"We gathered our allotted herds together,"},{"id":"semetey-2-2013:p1291:b003:l012","ordinal":286039,"en":"And grew like twins, companions of one age.”"},{"id":"semetey-2-2013:p1291:b003:l013","ordinal":286040,"en":"Thus he spoke these words,"},{"id":"semetey-2-2013:p1291:b003:l014","ordinal":286041,"en":"And Külchoro stood in anguish."},{"id":"semetey-2-2013:p1291:b003:l015","ordinal":286042,"en":"Kanchoro, that once-noble hero,"},{"id":"semetey-2-2013:p1291:b003:l016","ordinal":286043,"en":"Stood enraged and ready;"},{"id":"semetey-2-2013:p1291:b003:l017","ordinal":286044,"en":"No pleading could save a life."},{"id":"semetey-2-2013:p1291:b003:l018","ordinal":286045,"en":"He would destroy everything there was—"},{"id":"semetey-2-2013:p1291:b003:l019","ordinal":286046,"en":"Kanchoro the khan felt no regret."},{"id":"semetey-2-2013:p1291:b003:l020","ordinal":286047,"en":"Its steel haft was thick as a fist:"},{"id":"semetey-2-2013:p1291:b003:l021","ordinal":286048,"en":"Such was the battle-axe."},{"id":"semetey-2-2013:p1291:b003:l022","ordinal":286049,"en":"His waist sagging, his back bent,"},{"id":"semetey-2-2013:p1291:b003:l023","ordinal":286050,"en":"His eyes rolling and bulging,"},{"id":"semetey-2-2013:p1291:b003:l024","ordinal":286051,"en":"He gripped his black-steel axe"},{"id":"semetey-2-2013:p1291:b003:l025","ordinal":286052,"en":"In both hands and swung it round."},{"id":"semetey-2-2013:p1291:b003:l026","ordinal":286053,"en":"Kanchoro gathered all his fury:"},{"id":"semetey-2-2013:p1291:b003:l027","ordinal":286054,"en":"“The cleft of his shoulder blades is the spot—"},{"id":"semetey-2-2013:p1291:b003:l028","ordinal":286055,"en":"Here is where this raging false slave"},{"id":"semetey-2-2013:p1291:b003:l029","ordinal":286056,"en":"Shall meet his death!”"},{"id":"semetey-2-2013:p1291:b003:l030","ordinal":286057,"en":"He seized his blood-drinking axe"},{"id":"semetey-2-2013:p1291:b003:l031","ordinal":286058,"en":"And swung it round;"},{"id":"semetey-2-2013:p1291:b003:l032","ordinal":286059,"en":"He charged the hero"},{"id":"semetey-2-2013:p1291:b003:l033","ordinal":286060,"en":"And struck at the nape of his neck."},{"id":"semetey-2-2013:p1291:b003:l034","ordinal":286061,"en":"Then, shouting in rage,"},{"id":"semetey-2-2013:p1291:b003:l035","ordinal":286062,"en":"“Surround and bind him, wrestlers!”"},{"id":"semetey-2-2013:p1291:b003:l036","ordinal":286063,"en":"He summoned his champions,"},{"id":"semetey-2-2013:p1291:b003:l037","ordinal":286064,"en":"And Kanchoro stood facing him."},{"id":"semetey-2-2013:p1291:b003:l038","ordinal":286065,"en":"As Kanchoro confronted him,"},{"id":"semetey-2-2013:p1291:b003:l039","ordinal":286066,"en":"The peerlessly agile,"},{"id":"semetey-2-2013:p1291:b005:l001","ordinal":286067,"en":"Clashing lion-hero,"},{"id":"semetey-2-2013:p1291:b005:l002","ordinal":286068,"en":"The merciless warrior who had subdued the world,"},{"id":"semetey-2-2013:p1291:b005:l003","ordinal":286069,"en":"Stood ready."},{"id":"semetey-2-2013:p1291:b005:l004","ordinal":286070,"en":"Yesterday, while leopard Manas yet lived,"},{"id":"semetey-2-2013:p1291:b005:l005","ordinal":286071,"en":"A wondrous blade had come to him by fate"},{"id":"semetey-2-2013:p1291:b005:l006","ordinal":286072,"en":"From the heights of the Mediyan Desert,"},{"id":"semetey-2-2013:p1291:b005:l007","ordinal":286073,"en":"From a sheer ridge facing the traveler,"},{"id":"semetey-2-2013:p1291:b005:l008","ordinal":286074,"en":"From a crag where mountains vanished,"},{"id":"semetey-2-2013:p1291:b005:l009","ordinal":286075,"en":"From the jutting brow of a stooping peak:"},{"id":"semetey-2-2013:p1291:b005:l010","ordinal":286076,"en":"The Six-Edged Blade that fell from heaven,"},{"id":"semetey-2-2013:p1291:b005:l011","ordinal":286077,"en":"The finest and most deadly of swords,"},{"id":"semetey-2-2013:p1291:b005:l012","ordinal":286078,"en":"The strongest of living steel."},{"id":"semetey-2-2013:p1291:b005:l013","ordinal":286079,"en":"When drawn from its sheath with a battle cry,"},{"id":"semetey-2-2013:p1291:b005:l014","ordinal":286080,"en":"It never went idle without drinking blood;"},{"id":"semetey-2-2013:p1291:b005:l015","ordinal":286081,"en":"Until it had drunk its fill of blood,"},{"id":"semetey-2-2013:p1291:b005:l016","ordinal":286082,"en":"It would not return to its sheath."},{"id":"semetey-2-2013:p1291:b005:l017","ordinal":286083,"en":"Laid upon grass, it kindled fire;"},{"id":"semetey-2-2013:p1291:b005:l018","ordinal":286084,"en":"Whoever it marked was swiftly destroyed."},{"id":"semetey-2-2013:p1291:b005:l019","ordinal":286085,"en":"Drawn from its sheath, it glowed red;"},{"id":"semetey-2-2013:p1291:b005:l020","ordinal":286086,"en":"When swung at the foe with a cry,"},{"id":"semetey-2-2013:p1291:b005:l021","ordinal":286087,"en":"It lengthened to forty fathoms."},{"id":"semetey-2-2013:p1291:b005:l022","ordinal":286088,"en":"The renowned Six-Edged Blade—"},{"id":"semetey-2-2013:p1291:b005:l023","ordinal":286089,"en":"Külchoro grasped its scabbard,"},{"id":"semetey-2-2013:p1291:b005:l024","ordinal":286090,"en":"Drew it by the hilt,"},{"id":"semetey-2-2013:p1291:b005:l025","ordinal":286091,"en":"And before Kanchoro could pull back,"},{"id":"semetey-2-2013:p1291:b005:l026","ordinal":286092,"en":"The ever-ready Külchoro"},{"id":"semetey-2-2013:p1291:b005:l027","ordinal":286093,"en":"Had the sword in hand."},{"id":"semetey-2-2013:p1291:b005:l028","ordinal":286094,"en":"Before Kanchoro could twist away,"},{"id":"semetey-2-2013:p1291:b005:l029","ordinal":286095,"en":"Turn and draw back,"},{"id":"semetey-2-2013:p1291:b005:l030","ordinal":286096,"en":"Külchoro flared in rage;"},{"id":"semetey-2-2013:p1291:b005:l031","ordinal":286097,"en":"He caught the slave upright"},{"id":"semetey-2-2013:p1291:b005:l032","ordinal":286098,"en":"By the bottom hem."},{"id":"semetey-2-2013:p1291:b005:l033","ordinal":286099,"en":"The falcon warrior drew the blade crosswise"},{"id":"semetey-2-2013:p1291:b005:l034","ordinal":286100,"en":"And stood brandishing it;"},{"id":"semetey-2-2013:p1291:b005:l035","ordinal":286101,"en":"The slave’s right coat-tail"},{"id":"semetey-2-2013:p1291:b005:l036","ordinal":286102,"en":"He sliced clean away."},{"id":"semetey-2-2013:p1291:b005:l037","ordinal":286103,"en":"One thigh of Akborchuk"},{"id":"semetey-2-2013:p1291:b005:l038","ordinal":286104,"en":"He hewed through to the bone,"},{"id":"semetey-2-2013:p1291:b005:l039","ordinal":286105,"en":"And one thigh of Kökborchuk"},{"id":"semetey-2-2013:p1292:b003:l001","ordinal":286106,"en":"He hewed through to the bone."},{"id":"semetey-2-2013:p1292:b003:l002","ordinal":286107,"en":"Before the hero could recover,"},{"id":"semetey-2-2013:p1292:b003:l003","ordinal":286108,"en":"Before he could wreak destruction upon them,"},{"id":"semetey-2-2013:p1292:b003:l004","ordinal":286109,"en":"The teeming black-clad Jediger"},{"id":"semetey-2-2013:p1292:b003:l005","ordinal":286110,"en":"And bloodthirsty lion, brave Kyyaz,"},{"id":"semetey-2-2013:p1292:b003:l006","ordinal":286111,"en":"Fell upon the hero."},{"id":"semetey-2-2013:p1292:b003:l007","ordinal":286112,"en":"Their toughest veteran wrestlers,"},{"id":"semetey-2-2013:p1292:b003:l008","ordinal":286113,"en":"Every one of their champions,"},{"id":"semetey-2-2013:p1292:b003:l009","ordinal":286114,"en":"Raised shouts from every side;"},{"id":"semetey-2-2013:p1292:b003:l010","ordinal":286115,"en":"From all directions"},{"id":"semetey-2-2013:p1292:b003:l011","ordinal":286116,"en":"They cried their battle cry, “Kıyır!”"},{"id":"semetey-2-2013:p1292:b003:l012","ordinal":286117,"en":"They loosed their bows like pouring rain,"},{"id":"semetey-2-2013:p1292:b003:l013","ordinal":286118,"en":"Shooting volleys of many kinds."},{"id":"semetey-2-2013:p1292:b003:l014","ordinal":286119,"en":"The arrows from bows hissed,"},{"id":"semetey-2-2013:p1292:b003:l015","ordinal":286120,"en":"The musket balls shrieked,"},{"id":"semetey-2-2013:p1292:b003:l016","ordinal":286121,"en":"The cannon shot thundered;"},{"id":"semetey-2-2013:p1292:b003:l017","ordinal":286122,"en":"Now they waged a boundless battle."},{"id":"semetey-2-2013:p1292:b003:l018","ordinal":286123,"en":"The ever-ready hero"},{"id":"semetey-2-2013:p1292:b003:l019","ordinal":286124,"en":"Spent all his strength and lost his power;"},{"id":"semetey-2-2013:p1292:b003:l020","ordinal":286125,"en":"Dark blood poured from his body,"},{"id":"semetey-2-2013:p1292:b003:l021","ordinal":286126,"en":"And Külchoro’s strength ebbed away."},{"id":"semetey-2-2013:p1292:b003:l022","ordinal":286127,"en":"The peerless warrior’s two arms"},{"id":"semetey-2-2013:p1292:b003:l023","ordinal":286128,"en":"Could no longer rise and hung paralyzed;"},{"id":"semetey-2-2013:p1292:b003:l024","ordinal":286129,"en":"His breast filled with black blood."},{"id":"semetey-2-2013:p1292:b003:l025","ordinal":286130,"en":"He had no swift steed to bear him away,"},{"id":"semetey-2-2013:p1292:b003:l026","ordinal":286131,"en":"No kinsman in that land to lead him home."},{"id":"semetey-2-2013:p1292:b003:l027","ordinal":286132,"en":"Alone amid the Jediger host—"},{"id":"semetey-2-2013:p1292:b003:l028","ordinal":286133,"en":"Such, indeed, is this worthless world."},{"id":"semetey-2-2013:p1292:b003:l029","ordinal":286134,"en":"The great pit dug for him"},{"id":"semetey-2-2013:p1292:b003:l030","ordinal":286135,"en":"Now began to boil with misery."},{"id":"semetey-2-2013:p1292:b003:l031","ordinal":286136,"en":"Thrusting spears and striking axes,"},{"id":"semetey-2-2013:p1292:b003:l032","ordinal":286137,"en":"They engulfed him there."},{"id":"semetey-2-2013:p1292:b003:l033","ordinal":286138,"en":"Those armed with ropes and armored coats,"},{"id":"semetey-2-2013:p1292:b003:l034","ordinal":286139,"en":"All the men with iron gauntlets,"},{"id":"semetey-2-2013:p1292:b003:l035","ordinal":286140,"en":"The champions who thrust spears,"},{"id":"semetey-2-2013:p1292:b003:l036","ordinal":286141,"en":"The heroes who struck with battle-axes,"},{"id":"semetey-2-2013:p1292:b003:l037","ordinal":286142,"en":"Those most skilled with swords,"},{"id":"semetey-2-2013:p1292:b003:l038","ordinal":286143,"en":"The strongest of the mighty,"},{"id":"semetey-2-2013:p1292:b003:l039","ordinal":286144,"en":"Surrounded him."},{"id":"semetey-2-2013:p1292:b004:l001","ordinal":286145,"en":"On that occasion, the hero"},{"id":"semetey-2-2013:p1292:b004:l002","ordinal":286146,"en":"Passed through desperate torment;"},{"id":"semetey-2-2013:p1292:b004:l003","ordinal":286147,"en":"The Jediger ringed him round"},{"id":"semetey-2-2013:p1292:b004:l004","ordinal":286148,"en":"And cast him into a net of iron."},{"id":"semetey-2-2013:p1292:b004:l005","ordinal":286149,"en":"Over poor Külchoro,"},{"id":"semetey-2-2013:p1292:b004:l006","ordinal":286150,"en":"The heroes Kanchoro and Kyyaz"},{"id":"semetey-2-2013:p1292:b004:l007","ordinal":286151,"en":"Stiffened in wrath,"},{"id":"semetey-2-2013:p1292:b004:l008","ordinal":286152,"en":"Roared in harsh fury,"},{"id":"semetey-2-2013:p1292:b004:l009","ordinal":286153,"en":"Thundered in anger,"},{"id":"semetey-2-2013:p1292:b004:l010","ordinal":286154,"en":"And growled like lions."},{"id":"semetey-2-2013:p1292:b004:l011","ordinal":286155,"en":"At the sight of their terrible bearing,"},{"id":"semetey-2-2013:p1292:b004:l012","ordinal":286156,"en":"Men’s bodies trembled;"},{"id":"semetey-2-2013:p1292:b004:l013","ordinal":286157,"en":"Their courage was like a wild boar’s rage,"},{"id":"semetey-2-2013:p1292:b004:l014","ordinal":286158,"en":"Like creatures that would leave nothing alive."},{"id":"semetey-2-2013:p1292:b004:l015","ordinal":286159,"en":"Shouting in frenzy,"},{"id":"semetey-2-2013:p1292:b004:l016","ordinal":286160,"en":"They summoned their warriors."},{"id":"semetey-2-2013:p1292:b004:l017","ordinal":286161,"en":"Enraged, Kanchoro"},{"id":"semetey-2-2013:p1292:b004:l018","ordinal":286162,"en":"Now issued his command to the multitude."},{"id":"semetey-2-2013:p1292:b004:l019","ordinal":286163,"en":"Jerking with every violent movement,"},{"id":"semetey-2-2013:p1292:b004:l020","ordinal":286164,"en":"This warrior Kanchoro,"},{"id":"semetey-2-2013:p1292:b004:l021","ordinal":286165,"en":"This black-hearted wretch,"},{"id":"semetey-2-2013:p1292:b004:l022","ordinal":286166,"en":"Drove the teeming black-clad Jediger"},{"id":"semetey-2-2013:p1292:b004:l023","ordinal":286167,"en":"Forward without leaving one behind."},{"id":"semetey-2-2013:p1292:b004:l024","ordinal":286168,"en":"As they surged upon the hero,"},{"id":"semetey-2-2013:p1292:b004:l025","ordinal":286169,"en":"The earth split with a roar."},{"id":"semetey-2-2013:p1292:b004:l026","ordinal":286170,"en":"Kanchoro swelled in menace,"},{"id":"semetey-2-2013:p1292:b004:l027","ordinal":286171,"en":"Roaring in a hundred ways;"},{"id":"semetey-2-2013:p1292:b004:l028","ordinal":286172,"en":"He raged like a ravenous stallion,"},{"id":"semetey-2-2013:p1292:b004:l029","ordinal":286173,"en":"Ready to seize"},{"id":"semetey-2-2013:p1292:b004:l030","ordinal":286174,"en":"An extravagant prize."},{"id":"semetey-2-2013:p1292:b004:l031","ordinal":286175,"en":"He stamped about in frenzy,"},{"id":"semetey-2-2013:p1292:b004:l032","ordinal":286176,"en":"Roaring like a demon,"},{"id":"semetey-2-2013:p1292:b004:l033","ordinal":286177,"en":"Wearing an unsheathed sword,"},{"id":"semetey-2-2013:p1292:b004:l034","ordinal":286178,"en":"Strutting and keeping watch."},{"id":"semetey-2-2013:p1292:b004:l035","ordinal":286179,"en":"The savage stood there,"},{"id":"semetey-2-2013:p1292:b004:l036","ordinal":286180,"en":"Boasting before the Jediger:"},{"id":"semetey-2-2013:p1292:b004:l037","ordinal":286181,"en":"“Teeming black-clad Jediger,"},{"id":"semetey-2-2013:p1292:b004:l038","ordinal":286182,"en":"If you flee, you have eaten filth!"},{"id":"semetey-2-2013:p1292:b004:l039","ordinal":286183,"en":"Your khan and beks are wailing—"},{"id":"semetey-2-2013:p1293:b003:l001","ordinal":286184,"en":"What else did you say?"},{"id":"semetey-2-2013:p1293:b003:l002","ordinal":286185,"en":"With your hero Kyyaz at your head,"},{"id":"semetey-2-2013:p1293:b003:l003","ordinal":286186,"en":"You flustered Jediger"},{"id":"semetey-2-2013:p1293:b003:l004","ordinal":286187,"en":"Stand there trembling,"},{"id":"semetey-2-2013:p1293:b003:l005","ordinal":286188,"en":"Thinking foolish thoughts."},{"id":"semetey-2-2013:p1293:b003:l006","ordinal":286189,"en":"All of you clamor together,"},{"id":"semetey-2-2013:p1293:b003:l007","ordinal":286190,"en":"Looking ready to flee;"},{"id":"semetey-2-2013:p1293:b003:l008","ordinal":286191,"en":"Your khan and beks assembled"},{"id":"semetey-2-2013:p1293:b003:l009","ordinal":286192,"en":"And said they would run away."},{"id":"semetey-2-2013:p1293:b003:l010","ordinal":286193,"en":"Damn you, Jediger!"},{"id":"semetey-2-2013:p1293:b003:l011","ordinal":286194,"en":"You have taken Kanchoro as your protector."},{"id":"semetey-2-2013:p1293:b003:l012","ordinal":286195,"en":"Jediger, for you this valiant hero"},{"id":"semetey-2-2013:p1293:b003:l013","ordinal":286196,"en":"Is one of the true gray wolves,"},{"id":"semetey-2-2013:p1293:b003:l014","ordinal":286197,"en":"The bright night granted by Providence,"},{"id":"semetey-2-2013:p1293:b003:l015","ordinal":286198,"en":"A hero not found even in a month’s search."},{"id":"semetey-2-2013:p1293:b003:l016","ordinal":286199,"en":"You boast and bluster, Jediger—"},{"id":"semetey-2-2013:p1293:b003:l017","ordinal":286200,"en":"Here is your champion who will devise a plan."},{"id":"semetey-2-2013:p1293:b003:l018","ordinal":286201,"en":"If Kanchoro finds the way,"},{"id":"semetey-2-2013:p1293:b003:l019","ordinal":286202,"en":"What complaint can you Jediger have?"},{"id":"semetey-2-2013:p1293:b003:l020","ordinal":286203,"en":"Keep it in mind, Jediger:"},{"id":"semetey-2-2013:p1293:b003:l021","ordinal":286204,"en":"Kanchoro is your champion."},{"id":"semetey-2-2013:p1293:b003:l022","ordinal":286205,"en":"While Kanchoro remains alive,"},{"id":"semetey-2-2013:p1293:b003:l023","ordinal":286206,"en":"Six mighty rivers cannot divide you."},{"id":"semetey-2-2013:p1293:b003:l024","ordinal":286207,"en":"Let all the world attack in force—"},{"id":"semetey-2-2013:p1293:b003:l025","ordinal":286208,"en":"For you Jediger there will be no death."}]
