[{"id":"manas-2010:p0903:b001:l001","ordinal":39681,"en":"Now my anxiety has gone."},{"id":"manas-2010:p0903:b001:l002","ordinal":39682,"en":"Akbaltay's champion"},{"id":"manas-2010:p0903:b001:l003","ordinal":39683,"en":"You have now placed in my hands;"},{"id":"manas-2010:p0903:b001:l004","ordinal":39684,"en":"My beloved God!"},{"id":"manas-2010:p0903:b001:l005","ordinal":39685,"en":"Chubak was found on the plain;"},{"id":"manas-2010:p0903:b001:l006","ordinal":39686,"en":"What a fortunate man I am!"},{"id":"manas-2010:p0903:b001:l007","ordinal":39687,"en":"Grateful to God,"},{"id":"manas-2010:p0903:b001:l008","ordinal":39688,"en":"Lion Lord Manas's"},{"id":"manas-2010:p0903:b001:l009","ordinal":39689,"en":"Single self had become five."},{"id":"manas-2010:p0903:b001:l010","ordinal":39690,"en":"'How mighty my Chubak is,'"},{"id":"manas-2010:p0903:b001:l011","ordinal":39691,"en":"I knew long ago."},{"id":"manas-2010:p0903:b001:l012","ordinal":39692,"en":"'When will Chubak come?' I said,"},{"id":"manas-2010:p0903:b001:l013","ordinal":39693,"en":"And waited upon your road!”"},{"id":"manas-2010:p0903:b001:l014","ordinal":39694,"en":"When Manas said this,"},{"id":"manas-2010:p0903:b001:l015","ordinal":39695,"en":"Valiant Chubak rose."},{"id":"manas-2010:p0903:b001:l016","ordinal":39696,"en":"The companion to his lord"},{"id":"manas-2010:p0903:b001:l017","ordinal":39697,"en":"Now rendered service."},{"id":"manas-2010:p0903:b001:l018","ordinal":39698,"en":"Dark spirits at the saddle straps,"},{"id":"manas-2010:p0903:b001:l019","ordinal":39699,"en":"Spirits in a Kalmyk leather flask—"},{"id":"manas-2010:p0903:b001:l020","ordinal":39700,"en":"Hero Chubak leaped up"},{"id":"manas-2010:p0903:b001:l021","ordinal":39701,"en":"And from beside Khan Bakay"},{"id":"manas-2010:p0903:b001:l022","ordinal":39702,"en":"Took and untied it."},{"id":"manas-2010:p0903:b001:l023","ordinal":39703,"en":"A dark wooden bowl as big as a cow's head"},{"id":"manas-2010:p0903:b001:l024","ordinal":39704,"en":"They filled to the brim."},{"id":"manas-2010:p0903:b001:l025","ordinal":39705,"en":"The lords brought it over,"},{"id":"manas-2010:p0903:b001:l026","ordinal":39706,"en":"Pouring until they were overwhelmed;"},{"id":"manas-2010:p0903:b001:l027","ordinal":39707,"en":"They brought it then"},{"id":"manas-2010:p0903:b001:l028","ordinal":39708,"en":"And offered it with a mighty rush."},{"id":"manas-2010:p0903:b001:l029","ordinal":39709,"en":"Drinking spirits and growing merry,"},{"id":"manas-2010:p0903:b001:l030","ordinal":39710,"en":"The lions upon the open plain"},{"id":"manas-2010:p0903:b001:l031","ordinal":39711,"en":"Had sweat trickling from their brows."},{"id":"manas-2010:p0903:b001:l032","ordinal":39712,"en":"All their faces brightened,"},{"id":"manas-2010:p0903:b001:l033","ordinal":39713,"en":"All their sorrows scattered."},{"id":"manas-2010:p0903:b001:l034","ordinal":39714,"en":"Then Manas stood grandly,"},{"id":"manas-2010:p0903:b001:l035","ordinal":39715,"en":"Rejoicing greatly and striding about:"},{"id":"manas-2010:p0903:b001:l036","ordinal":39716,"en":"“My bloodstained Bakay, Ajybay,"},{"id":"manas-2010:p0903:b001:l037","ordinal":39717,"en":"When my noble Chubak stands beside me,"},{"id":"manas-2010:p0903:b001:l038","ordinal":39718,"en":"My red spear and Zulpukor"},{"id":"manas-2010:p0903:b001:l039","ordinal":39719,"en":"I shall draw from the sheath with a shout."},{"id":"manas-2010:p0903:b001:l040","ordinal":39720,"en":"Not merely the Chinese—I myself"},{"id":"manas-2010:p0903:b001:l041","ordinal":39721,"en":"Shall bring slaughter to the nations!"},{"id":"manas-2010:p0903:b001:l042","ordinal":39722,"en":"My single self has become a thousand;"},{"id":"manas-2010:p0904:b001:l001","ordinal":39723,"en":"It is the Creator's gift."},{"id":"manas-2010:p0904:b001:l002","ordinal":39724,"en":"Let me pray to God:"},{"id":"manas-2010:p0904:b001:l003","ordinal":39725,"en":"Chubak, who shares my soul, has come!"},{"id":"manas-2010:p0904:b001:l004","ordinal":39726,"en":"Though I ride Akkula for six months,"},{"id":"manas-2010:p0904:b001:l005","ordinal":39727,"en":"My thoroughbred will not grow lean."},{"id":"manas-2010:p0904:b001:l006","ordinal":39728,"en":"I may give myself in devotion to God:"},{"id":"manas-2010:p0904:b001:l007","ordinal":39729,"en":"The child born to Akbaltay"},{"id":"manas-2010:p0904:b001:l008","ordinal":39730,"en":"Is my brother who will ease my distress."},{"id":"manas-2010:p0904:b001:l009","ordinal":39731,"en":"With my noble Chubak beside me,"},{"id":"manas-2010:p0904:b001:l010","ordinal":39732,"en":"I shall bring slaughter to the Kalmyks."},{"id":"manas-2010:p0904:b001:l011","ordinal":39733,"en":"As long as my precious life remains,"},{"id":"manas-2010:p0904:b001:l012","ordinal":39734,"en":"I shall break and conquer the emperor's land!"},{"id":"manas-2010:p0904:b001:l013","ordinal":39735,"en":"If Muslims heed my words,"},{"id":"manas-2010:p0904:b001:l014","ordinal":39736,"en":"I shall win their submission through speech;"},{"id":"manas-2010:p0904:b001:l015","ordinal":39737,"en":"The dark infidels who know no faith"},{"id":"manas-2010:p0904:b001:l016","ordinal":39738,"en":"I shall force into submission!”"},{"id":"manas-2010:p0904:b001:l017","ordinal":39739,"en":"Thus spoke the hero Manas."},{"id":"manas-2010:p0904:b001:l018","ordinal":39740,"en":"That Chubak was truly Chubak,"},{"id":"manas-2010:p0904:b001:l019","ordinal":39741,"en":"Your mighty Manas now knew."},{"id":"manas-2010:p0904:b001:l020","ordinal":39742,"en":"His fine moustache quivered,"},{"id":"manas-2010:p0904:b001:l021","ordinal":39743,"en":"And he smiled beneath it."},{"id":"manas-2010:p0904:b001:l022","ordinal":39744,"en":"Pleased, the hero Chubak"},{"id":"manas-2010:p0904:b001:l023","ordinal":39745,"en":"Left aside the present talk,"},{"id":"manas-2010:p0904:b001:l024","ordinal":39746,"en":"And to lion Manas himself"},{"id":"manas-2010:p0904:b001:l025","ordinal":39747,"en":"Began telling what he had seen."},{"id":"manas-2010:p0904:b001:l026","ordinal":39748,"en":"“Until I reached twelve years of age,"},{"id":"manas-2010:p0904:b001:l027","ordinal":39749,"en":"I studied in Mecca."},{"id":"manas-2010:p0904:b001:l028","ordinal":39750,"en":"When I was in Mecca,"},{"id":"manas-2010:p0904:b001:l029","ordinal":39751,"en":"You appeared in my dream, my brother!"},{"id":"manas-2010:p0904:b001:l030","ordinal":39752,"en":"Of the one Creator, God,"},{"id":"manas-2010:p0904:b001:l031","ordinal":39753,"en":"I had been asking this."},{"id":"manas-2010:p0904:b001:l032","ordinal":39754,"en":"When I saw my father Akbaltay's face,"},{"id":"manas-2010:p0904:b001:l033","ordinal":39755,"en":"When I returned from Mecca,"},{"id":"manas-2010:p0904:b001:l034","ordinal":39756,"en":"I turned Kögala's head"},{"id":"manas-2010:p0904:b001:l035","ordinal":39757,"en":"And before my father"},{"id":"manas-2010:p0904:b001:l036","ordinal":39758,"en":"Stayed only a little while."},{"id":"manas-2010:p0904:b001:l037","ordinal":39759,"en":"That people's, those Noygut's,"},{"id":"manas-2010:p0904:b001:l038","ordinal":39760,"en":"Ways do not soothe the soul;"},{"id":"manas-2010:p0904:b001:l039","ordinal":39761,"en":"Their deeds do not gladden the heart."},{"id":"manas-2010:p0904:b001:l040","ordinal":39762,"en":"They had no claim to press in a quarrel;"},{"id":"manas-2010:p0904:b001:l041","ordinal":39763,"en":"The Noygut lay there"},{"id":"manas-2010:p0904:b001:l042","ordinal":39764,"en":"With no enemy to exchange shots with,"},{"id":"manas-2010:p0905:b001:l001","ordinal":39765,"en":"Their animals numerous, their herds abundant,"},{"id":"manas-2010:p0905:b001:l002","ordinal":39766,"en":"With no care beyond that:"},{"id":"manas-2010:p0905:b001:l003","ordinal":39767,"en":"So lay the Noygut people."},{"id":"manas-2010:p0905:b001:l004","ordinal":39768,"en":"Their Alay was a hilly land;"},{"id":"manas-2010:p0905:b001:l005","ordinal":39769,"en":"The Noygut in Alay"},{"id":"manas-2010:p0905:b001:l006","ordinal":39770,"en":"Were a people almost like animals."},{"id":"manas-2010:p0905:b001:l007","ordinal":39771,"en":"I had no support to rely upon,"},{"id":"manas-2010:p0905:b001:l008","ordinal":39772,"en":"No warrior like yourself to lean upon,"},{"id":"manas-2010:p0905:b001:l009","ordinal":39773,"en":"No warrior to bind to my side."},{"id":"manas-2010:p0905:b001:l010","ordinal":39774,"en":"While I was in Mecca,"},{"id":"manas-2010:p0905:b001:l011","ordinal":39775,"en":"Alabek, khan of Kashgar,"},{"id":"manas-2010:p0905:b001:l012","ordinal":39776,"en":"Had raised a mighty conflict."},{"id":"manas-2010:p0905:b001:l013","ordinal":39777,"en":"My khan father's horses"},{"id":"manas-2010:p0905:b001:l014","ordinal":39778,"en":"He had raided and taken, every one."},{"id":"manas-2010:p0905:b001:l015","ordinal":39779,"en":"The men of Kashgar came out with violence"},{"id":"manas-2010:p0905:b001:l016","ordinal":39780,"en":"And laid tribute upon the Argyn."},{"id":"manas-2010:p0905:b001:l017","ordinal":39781,"en":"Leaving nothing of the Argyn's,"},{"id":"manas-2010:p0905:b001:l018","ordinal":39782,"en":"They gathered everything away."},{"id":"manas-2010:p0905:b001:l019","ordinal":39783,"en":"My noble father Akbaltay"},{"id":"manas-2010:p0905:b001:l020","ordinal":39784,"en":"Laid his head upon a pillow"},{"id":"manas-2010:p0905:b001:l021","ordinal":39785,"en":"And remained there without rising."},{"id":"manas-2010:p0905:b001:l022","ordinal":39786,"en":"The many Noygut in Alay,"},{"id":"manas-2010:p0905:b001:l023","ordinal":39787,"en":"When their elder was in that state,"},{"id":"manas-2010:p0905:b001:l024","ordinal":39788,"en":"Lost the food from their cauldrons,"},{"id":"manas-2010:p0905:b001:l025","ordinal":39789,"en":"Lost their heads to the infidels."},{"id":"manas-2010:p0905:b001:l026","ordinal":39790,"en":"None heeded another's words,"},{"id":"manas-2010:p0905:b001:l027","ordinal":39791,"en":"None could bear the sight of another."},{"id":"manas-2010:p0905:b001:l028","ordinal":39792,"en":"Cawing like hooded crows,"},{"id":"manas-2010:p0905:b001:l029","ordinal":39793,"en":"They mounted and rode out,"},{"id":"manas-2010:p0905:b001:l030","ordinal":39794,"en":"Heroes only within their village."},{"id":"manas-2010:p0905:b001:l031","ordinal":39795,"en":"Unable to stay idling among the Noygut,"},{"id":"manas-2010:p0905:b001:l032","ordinal":39796,"en":"I tightened my belt about me."},{"id":"manas-2010:p0905:b001:l033","ordinal":39797,"en":"Against surging Kashgar"},{"id":"manas-2010:p0905:b001:l034","ordinal":39798,"en":"I launched nine attacks."},{"id":"manas-2010:p0905:b001:l035","ordinal":39799,"en":"I broke the Afghans and took ten;"},{"id":"manas-2010:p0905:b001:l036","ordinal":39800,"en":"I attacked great peoples:"},{"id":"manas-2010:p0905:b001:l037","ordinal":39801,"en":"The famed sacred capital of sheikhs,"},{"id":"manas-2010:p0905:b001:l038","ordinal":39802,"en":"Great Kokand and Margalan;"},{"id":"manas-2010:p0905:b001:l039","ordinal":39803,"en":"I went to Samarkand and took three."},{"id":"manas-2010:p0905:b001:l040","ordinal":39804,"en":"I girded my waist firmly"},{"id":"manas-2010:p0905:b001:l041","ordinal":39805,"en":"And scouted the face of the earth."},{"id":"manas-2010:p0905:b001:l042","ordinal":39806,"en":"Great Bukhara with its twelve gates—"},{"id":"manas-2010:p0906:b001:l001","ordinal":39807,"en":"I went to lay siege to it."},{"id":"manas-2010:p0906:b001:l002","ordinal":39808,"en":"When I turned Kögala's head,"},{"id":"manas-2010:p0906:b001:l003","ordinal":39809,"en":"When I stood besieging Bukhara,"},{"id":"manas-2010:p0906:b001:l004","ordinal":39810,"en":"She was still a little girl,"},{"id":"manas-2010:p0906:b001:l005","ordinal":39811,"en":"Her hair not yet long enough to braid,"},{"id":"manas-2010:p0906:b001:l006","ordinal":39812,"en":"Her age no more than fourteen,"},{"id":"manas-2010:p0906:b001:l007","ordinal":39813,"en":"The youngest of twelve girls:"},{"id":"manas-2010:p0906:b001:l008","ordinal":39814,"en":"Formidable Kanykey,"},{"id":"manas-2010:p0906:b001:l009","ordinal":39815,"en":"A servant beloved of God,"},{"id":"manas-2010:p0906:b001:l010","ordinal":39816,"en":"The beauty among the dusky-complexioned,"},{"id":"manas-2010:p0906:b001:l011","ordinal":39817,"en":"The radiant one among Muslims."},{"id":"manas-2010:p0906:b001:l012","ordinal":39818,"en":"In Bukhara I saw a lion among girls;"},{"id":"manas-2010:p0906:b001:l013","ordinal":39819,"en":"May it be denied me if I lie, leopard,"},{"id":"manas-2010:p0906:b001:l014","ordinal":39820,"en":"I saw a warrior worth whole nations."},{"id":"manas-2010:p0906:b001:l015","ordinal":39821,"en":"On broad Bukhara's battlefield,"},{"id":"manas-2010:p0906:b001:l016","ordinal":39822,"en":"When I turned my steed's head,"},{"id":"manas-2010:p0906:b001:l017","ordinal":39823,"en":"On broad Bukhara's battlefield,"},{"id":"manas-2010:p0906:b001:l018","ordinal":39824,"en":"When I came out to single combat,"},{"id":"manas-2010:p0906:b001:l019","ordinal":39825,"en":"When I reached her and thrust my spear,"},{"id":"manas-2010:p0906:b001:l020","ordinal":39826,"en":"Kanykey stood there and I struck."},{"id":"manas-2010:p0906:b001:l021","ordinal":39827,"en":"It rang and rang; she did not care."},{"id":"manas-2010:p0906:b001:l022","ordinal":39828,"en":"Kanykey was a mighty champion;"},{"id":"manas-2010:p0906:b001:l023","ordinal":39829,"en":"She did not rate me equal to her trouser hem."},{"id":"manas-2010:p0906:b001:l024","ordinal":39830,"en":"She was a child with a radiant form;"},{"id":"manas-2010:p0906:b001:l025","ordinal":39831,"en":"For you, lion lord,"},{"id":"manas-2010:p0906:b001:l026","ordinal":39832,"en":"She was a fitting person!"},{"id":"manas-2010:p0906:b001:l027","ordinal":39833,"en":"The most capable among the long-haired,"},{"id":"manas-2010:p0906:b001:l028","ordinal":39834,"en":"The finest among women,"},{"id":"manas-2010:p0906:b001:l029","ordinal":39835,"en":"The choicest among the wide-robed,"},{"id":"manas-2010:p0906:b001:l030","ordinal":39836,"en":"The sovereign among women."},{"id":"manas-2010:p0906:b001:l031","ordinal":39837,"en":"There can be no person like her."},{"id":"manas-2010:p0906:b001:l032","ordinal":39838,"en":"If you do not marry Kanykey,"},{"id":"manas-2010:p0906:b001:l033","ordinal":39839,"en":"Your affairs will never prosper!"},{"id":"manas-2010:p0906:b001:l034","ordinal":39840,"en":"If you make that fierce woman your chief wife,"},{"id":"manas-2010:p0906:b001:l035","ordinal":39841,"en":"Her speech is sweet, her words are honey;"},{"id":"manas-2010:p0906:b001:l036","ordinal":39842,"en":"Even in grief no such person can be found."},{"id":"manas-2010:p0906:b001:l037","ordinal":39843,"en":"She is skillful among spear fighters,"},{"id":"manas-2010:p0906:b001:l038","ordinal":39844,"en":"A master who knows the enemy's stratagems."},{"id":"manas-2010:p0906:b001:l039","ordinal":39845,"en":"She is a queen among girls with a royal court;"},{"id":"manas-2010:p0906:b001:l040","ordinal":39846,"en":"If she were a male child,"},{"id":"manas-2010:p0906:b001:l041","ordinal":39847,"en":"She would be one to break the Oyrat."},{"id":"manas-2010:p0906:b001:l042","ordinal":39848,"en":"When I looked to her right,"},{"id":"manas-2010:p0907:b001:l001","ordinal":39849,"en":"What would happen six months hence"},{"id":"manas-2010:p0907:b001:l002","ordinal":39850,"en":"Could be told this instant"},{"id":"manas-2010:p0907:b001:l003","ordinal":39851,"en":"By a naked child there."},{"id":"manas-2010:p0907:b001:l004","ordinal":39852,"en":"It was one of her sacred powers;"},{"id":"manas-2010:p0907:b001:l005","ordinal":39853,"en":"When I looked, it was the Night of Power."},{"id":"manas-2010:p0907:b001:l006","ordinal":39854,"en":"Her renown is exceptional, her force fierce;"},{"id":"manas-2010:p0907:b001:l007","ordinal":39855,"en":"For you yourself, my bloodstained warrior,"},{"id":"manas-2010:p0907:b001:l008","ordinal":39856,"en":"She is a fitting girl."},{"id":"manas-2010:p0907:b001:l009","ordinal":39857,"en":"If we seek and take Kanykey,"},{"id":"manas-2010:p0907:b001:l010","ordinal":39858,"en":"She will be a treasure that gathers wealth."},{"id":"manas-2010:p0907:b001:l011","ordinal":39859,"en":"Who fought and escaped—"},{"id":"manas-2010:p0907:b001:l012","ordinal":39860,"en":"These are the words of Khan Chubak!"},{"id":"manas-2010:p0907:b001:l013","ordinal":39861,"en":"If you choose and take Kanykey,"},{"id":"manas-2010:p0907:b001:l014","ordinal":39862,"en":"She is the very dark-eyed beauty!"},{"id":"manas-2010:p0907:b001:l015","ordinal":39863,"en":"Listen to my words:"},{"id":"manas-2010:p0907:b001:l016","ordinal":39864,"en":"Karakan's daughter Kanykey"},{"id":"manas-2010:p0907:b001:l017","ordinal":39865,"en":"Take as your bride!"},{"id":"manas-2010:p0907:b001:l018","ordinal":39866,"en":"If you marry Kanykey, my warrior,"},{"id":"manas-2010:p0907:b001:l019","ordinal":39867,"en":"Your prosperity will grow,"},{"id":"manas-2010:p0907:b001:l020","ordinal":39868,"en":"Your suffering will end."},{"id":"manas-2010:p0907:b001:l021","ordinal":39869,"en":"Your fortune will blossom,"},{"id":"manas-2010:p0907:b001:l022","ordinal":39870,"en":"Your throne will be of gold."},{"id":"manas-2010:p0907:b001:l023","ordinal":39871,"en":"Spend wealth and give livestock;"},{"id":"manas-2010:p0907:b001:l024","ordinal":39872,"en":"Understand what I have said!"},{"id":"manas-2010:p0907:b001:l025","ordinal":39873,"en":"Greathearted lord, heed my words!"},{"id":"manas-2010:p0907:b001:l026","ordinal":39874,"en":"I stood in single combat; she struck,"},{"id":"manas-2010:p0907:b001:l027","ordinal":39875,"en":"And her spear broke into splinters."},{"id":"manas-2010:p0907:b001:l028","ordinal":39876,"en":"Chubak, like a towering mountain,"},{"id":"manas-2010:p0907:b001:l029","ordinal":39877,"en":"Was left helpless, crying out."},{"id":"manas-2010:p0907:b001:l030","ordinal":39878,"en":"My backside left the saddle,"},{"id":"manas-2010:p0907:b001:l031","ordinal":39879,"en":"My feet left the stirrups,"},{"id":"manas-2010:p0907:b001:l032","ordinal":39880,"en":"My backside slipped from the saddle;"},{"id":"manas-2010:p0907:b001:l033","ordinal":39881,"en":"From wretched Chubak"},{"id":"manas-2010:p0907:b001:l034","ordinal":39882,"en":"Sense departed, consciousness reeled."},{"id":"manas-2010:p0907:b001:l035","ordinal":39883,"en":"The two skirts of my coat fluttered;"},{"id":"manas-2010:p0907:b001:l036","ordinal":39884,"en":"'Save me, God, save me!' I cried."},{"id":"manas-2010:p0907:b001:l037","ordinal":39885,"en":"Clutching the crupper in anguish,"},{"id":"manas-2010:p0907:b001:l038","ordinal":39886,"en":"With embers burning me within and without,"},{"id":"manas-2010:p0907:b001:l039","ordinal":39887,"en":"The blue Naiman star eclipsed in the sky,"},{"id":"manas-2010:p0907:b001:l040","ordinal":39888,"en":"Kögala beneath me"},{"id":"manas-2010:p0907:b001:l041","ordinal":39889,"en":"I lashed this way and that,"},{"id":"manas-2010:p0907:b001:l042","ordinal":39890,"en":"Spurring on either side,"},{"id":"manas-2010:p0908:b001:l001","ordinal":39891,"en":"From the city of broad Bukhara"},{"id":"manas-2010:p0908:b001:l002","ordinal":39892,"en":"I fled openly and escaped."},{"id":"manas-2010:p0908:b001:l003","ordinal":39893,"en":"She began to rage fiercely;"},{"id":"manas-2010:p0908:b001:l004","ordinal":39894,"en":"Draped in a blue-flowered coat,"},{"id":"manas-2010:p0908:b001:l005","ordinal":39895,"en":"When I looked, Kanykey"},{"id":"manas-2010:p0908:b001:l006","ordinal":39896,"en":"Was raging like a blue tiger."},{"id":"manas-2010:p0908:b001:l007","ordinal":39897,"en":"She began to rage fiercely;"},{"id":"manas-2010:p0908:b001:l008","ordinal":39898,"en":"Her countless troops behind her"},{"id":"manas-2010:p0908:b001:l009","ordinal":39899,"en":"Swept forward in a rush."},{"id":"manas-2010:p0908:b001:l010","ordinal":39900,"en":"A blue spear struck my rump;"},{"id":"manas-2010:p0908:b001:l011","ordinal":39901,"en":"When she was about to drive it deep,"},{"id":"manas-2010:p0908:b001:l012","ordinal":39902,"en":"Kögala proved my salvation."},{"id":"manas-2010:p0908:b001:l013","ordinal":39903,"en":"Her splendid hair, like a girth strap,"},{"id":"manas-2010:p0908:b001:l014","ordinal":39904,"en":"She bound close upon her head."},{"id":"manas-2010:p0908:b001:l015","ordinal":39905,"en":"When she chased and drove me from behind,"},{"id":"manas-2010:p0908:b001:l016","ordinal":39906,"en":"With a deadly bow and smooth arrows,"},{"id":"manas-2010:p0908:b001:l017","ordinal":39907,"en":"When she chased and drove me from behind,"},{"id":"manas-2010:p0908:b001:l018","ordinal":39908,"en":"Had you not appeared ahead of me,"},{"id":"manas-2010:p0908:b001:l019","ordinal":39909,"en":"Would she not have drawn the line?"},{"id":"manas-2010:p0908:b001:l020","ordinal":39910,"en":"Chasing me all the way to Alay,"},{"id":"manas-2010:p0908:b001:l021","ordinal":39911,"en":"Would she not have made a spectacle?"},{"id":"manas-2010:p0908:b001:l022","ordinal":39912,"en":"Would she not have made my fate known?"},{"id":"manas-2010:p0908:b001:l023","ordinal":39913,"en":"She would have wrecked my village."},{"id":"manas-2010:p0908:b001:l024","ordinal":39914,"en":"If you take that fierce woman,"},{"id":"manas-2010:p0908:b001:l025","ordinal":39915,"en":"I saw her in Bukhara,"},{"id":"manas-2010:p0908:b001:l026","ordinal":39916,"en":"That infidel of terrible majesty."},{"id":"manas-2010:p0908:b001:l027","ordinal":39917,"en":"Upon your Chubak's head"},{"id":"manas-2010:p0908:b001:l028","ordinal":39918,"en":"She brought the end of the world.”"},{"id":"manas-2010:p0908:b001:l029","ordinal":39919,"en":"Making known what they did not know,"},{"id":"manas-2010:p0908:b001:l030","ordinal":39920,"en":"Knowledgeable Chubak said this."},{"id":"manas-2010:p0908:b001:l031","ordinal":39921,"en":"When Chubak said this,"},{"id":"manas-2010:p0908:b001:l032","ordinal":39922,"en":"Mighty Bakay, whom you have seen,"},{"id":"manas-2010:p0908:b001:l033","ordinal":39923,"en":"Spoke softly, weighing his words."},{"id":"manas-2010:p0908:b001:l034","ordinal":39924,"en":"Fierce Bakay, the caring warrior,"},{"id":"manas-2010:p0908:b001:l035","ordinal":39925,"en":"The great lion who knew so much,"},{"id":"manas-2010:p0908:b001:l036","ordinal":39926,"en":"This elder Bakay of yours"},{"id":"manas-2010:p0908:b001:l037","ordinal":39927,"en":"Prepared like a hawk,"},{"id":"manas-2010:p0908:b001:l038","ordinal":39928,"en":"Finding counsel from the unseen:"},{"id":"manas-2010:p0908:b001:l039","ordinal":39929,"en":"“The four corners of the round world,"},{"id":"manas-2010:p0908:b001:l040","ordinal":39930,"en":"Lord Chubak, hero Manas,"},{"id":"manas-2010:p0908:b001:l041","ordinal":39931,"en":"Let us scout on four circuits;"},{"id":"manas-2010:p0908:b001:l042","ordinal":39932,"en":"Let us find the livestock for a holy campaign!"},{"id":"manas-2010:p0909:b001:l001","ordinal":39933,"en":"When the following year comes,"},{"id":"manas-2010:p0909:b001:l002","ordinal":39934,"en":"Loading gold coins on eighty camels,"},{"id":"manas-2010:p0909:b001:l003","ordinal":39935,"en":"To the khan's city of Bukhara,"},{"id":"manas-2010:p0909:b001:l004","ordinal":39936,"en":"Before Temirkan,"}]
