[{"id":"manas-2010:p1165:b001:l025","ordinal":50689,"en":"Are poised to bring turmoil.”"},{"id":"manas-2010:p1165:b001:l026","ordinal":50690,"en":"Thinking this, your fox"},{"id":"manas-2010:p1165:b001:l027","ordinal":50691,"en":"Leapt off the rock and darted away."},{"id":"manas-2010:p1165:b001:l028","ordinal":50692,"en":"Almambet lying in wait,"},{"id":"manas-2010:p1165:b001:l029","ordinal":50693,"en":"Readying the musket to fire,"},{"id":"manas-2010:p1165:b001:l030","ordinal":50694,"en":"At the fleeing fox"},{"id":"manas-2010:p1165:b001:l031","ordinal":50695,"en":"Fired once from the side."},{"id":"manas-2010:p1165:b001:l032","ordinal":50696,"en":"Missing the place he aimed at,"},{"id":"manas-2010:p1165:b001:l033","ordinal":50697,"en":"He grazed one of its forelegs."},{"id":"manas-2010:p1165:b001:l034","ordinal":50698,"en":"Despairing of its life,"},{"id":"manas-2010:p1165:b001:l035","ordinal":50699,"en":"Gathering itself like a bird,"},{"id":"manas-2010:p1165:b001:l036","ordinal":50700,"en":"The wretched creature fled,"},{"id":"manas-2010:p1165:b001:l037","ordinal":50701,"en":"Running on three legs."},{"id":"manas-2010:p1165:b001:l038","ordinal":50702,"en":"From the pale, sloping hillside,"},{"id":"manas-2010:p1165:b001:l039","ordinal":50703,"en":"Almambet came shouting,"},{"id":"manas-2010:p1165:b001:l040","ordinal":50704,"en":"His cry splitting the mountain,"},{"id":"manas-2010:p1165:b001:l041","ordinal":50705,"en":"Calling, “Brave Syrgak!”"},{"id":"manas-2010:p1165:b001:l042","ordinal":50706,"en":"Kartküröng, whose rein he held,"},{"id":"manas-2010:p1166:b001:l001","ordinal":50707,"en":"He cast off toward the slope."},{"id":"manas-2010:p1166:b001:l002","ordinal":50708,"en":"“Go!” he cried, flying onward."},{"id":"manas-2010:p1166:b001:l003","ordinal":50709,"en":"Making him bound like a roe,"},{"id":"manas-2010:p1166:b001:l004","ordinal":50710,"en":"Kökchebich beneath him,"},{"id":"manas-2010:p1166:b001:l005","ordinal":50711,"en":"Whipping right and left,"},{"id":"manas-2010:p1166:b001:l006","ordinal":50712,"en":"Spurring on both sides,"},{"id":"manas-2010:p1166:b001:l007","ordinal":50713,"en":"The smooth spear at his forearm"},{"id":"manas-2010:p1166:b001:l008","ordinal":50714,"en":"He seized in his right hand."},{"id":"manas-2010:p1166:b001:l009","ordinal":50715,"en":"Delighted to see the fox,"},{"id":"manas-2010:p1166:b001:l010","ordinal":50716,"en":"Never blinking his fixed gaze,"},{"id":"manas-2010:p1166:b001:l011","ordinal":50717,"en":"He rode unerringly on!"},{"id":"manas-2010:p1166:b001:l012","ordinal":50718,"en":"Taking the path along the slope,"},{"id":"manas-2010:p1166:b001:l013","ordinal":50719,"en":"He drew within sight of it,"},{"id":"manas-2010:p1166:b001:l014","ordinal":50720,"en":"Into the dust raised by the fox"},{"id":"manas-2010:p1166:b001:l015","ordinal":50721,"en":"He plunged."},{"id":"manas-2010:p1166:b001:l016","ordinal":50722,"en":"On the hollow of the pass,"},{"id":"manas-2010:p1166:b001:l017","ordinal":50723,"en":"On the level stretch of fescue,"},{"id":"manas-2010:p1166:b001:l018","ordinal":50724,"en":"Driving his steed at speed,"},{"id":"manas-2010:p1166:b001:l019","ordinal":50725,"en":"Just as he reached the fox,"},{"id":"manas-2010:p1166:b001:l020","ordinal":50726,"en":"When winged Kökchebich"},{"id":"manas-2010:p1166:b001:l021","ordinal":50727,"en":"Was about to pass alongside,"},{"id":"manas-2010:p1166:b001:l022","ordinal":50728,"en":"“God, grant me the cunning one!” he said,"},{"id":"manas-2010:p1166:b001:l023","ordinal":50729,"en":"And raised his smooth spear."},{"id":"manas-2010:p1166:b001:l024","ordinal":50730,"en":"The fox urged itself and darted off."},{"id":"manas-2010:p1166:b001:l025","ordinal":50731,"en":"Into caragana, bushes and thick forest,"},{"id":"manas-2010:p1166:b001:l026","ordinal":50732,"en":"As the fox fled to enter,"},{"id":"manas-2010:p1166:b001:l027","ordinal":50733,"en":"Your leopard champion Syrgak"},{"id":"manas-2010:p1166:b001:l028","ordinal":50734,"en":"Struck it once from the side."},{"id":"manas-2010:p1166:b001:l029","ordinal":50735,"en":"Its flank-fur twisted;"},{"id":"manas-2010:p1166:b001:l030","ordinal":50736,"en":"Its back broke apart."},{"id":"manas-2010:p1166:b001:l031","ordinal":50737,"en":"In a sign of joy,"},{"id":"manas-2010:p1166:b001:l032","ordinal":50738,"en":"Almambet, born a champion,"},{"id":"manas-2010:p1166:b001:l033","ordinal":50739,"en":"Came behind him rejoicing."},{"id":"manas-2010:p1166:b001:l034","ordinal":50740,"en":"“My dear Syrgak!” he said,"},{"id":"manas-2010:p1166:b001:l035","ordinal":50741,"en":"Tears streaming in ten courses."},{"id":"manas-2010:p1166:b001:l036","ordinal":50742,"en":"“We have slain the fox on the plain!"},{"id":"manas-2010:p1166:b001:l037","ordinal":50743,"en":"My dear Syrgak,"},{"id":"manas-2010:p1166:b001:l038","ordinal":50744,"en":"Not only my herds and treasures—"},{"id":"manas-2010:p1166:b001:l039","ordinal":50745,"en":"For a champion youth like you,"},{"id":"manas-2010:p1166:b001:l040","ordinal":50746,"en":"May my own head be a sacrifice!”"},{"id":"manas-2010:p1166:b001:l041","ordinal":50747,"en":"Springing down from his horse,"},{"id":"manas-2010:p1166:b001:l042","ordinal":50748,"en":"Azizkan's Almambet"},{"id":"manas-2010:p1167:b001:l001","ordinal":50749,"en":"Ran up to the fox."},{"id":"manas-2010:p1167:b001:l002","ordinal":50750,"en":"The black steel Narkesken"},{"id":"manas-2010:p1167:b001:l003","ordinal":50751,"en":"He drew from its sheath,"},{"id":"manas-2010:p1167:b001:l004","ordinal":50752,"en":"And cut it into six pieces,"},{"id":"manas-2010:p1167:b001:l005","ordinal":50753,"en":"Drenching the fox in blood."},{"id":"manas-2010:p1167:b001:l006","ordinal":50754,"en":"Caragana branches and masses of rocks—"},{"id":"manas-2010:p1167:b001:l007","ordinal":50755,"en":"From among those rocks,"},{"id":"manas-2010:p1167:b001:l008","ordinal":50756,"en":"A rawhide bag like a resting camel,"},{"id":"manas-2010:p1167:b001:l009","ordinal":50757,"en":"Azizkan's Almambet"},{"id":"manas-2010:p1167:b001:l010","ordinal":50758,"en":"Before brave Syrgak"},{"id":"manas-2010:p1167:b001:l011","ordinal":50759,"en":"Brought, carrying it aloft."},{"id":"manas-2010:p1167:b001:l012","ordinal":50760,"en":"When he cut it open and looked,"},{"id":"manas-2010:p1167:b001:l013","ordinal":50761,"en":"For the fearsome warrior Kongurbay"},{"id":"manas-2010:p1167:b001:l014","ordinal":50762,"en":"It was a coat laid ready,"},{"id":"manas-2010:p1167:b001:l015","ordinal":50763,"en":"When he came to the watch-post,"},{"id":"manas-2010:p1167:b001:l016","ordinal":50764,"en":"A coat for him to wear."},{"id":"manas-2010:p1167:b001:l017","ordinal":50765,"en":"Vowing a sheep to Khorasan,"},{"id":"manas-2010:p1167:b001:l018","ordinal":50766,"en":"Offering a prayer to Bahauddin,"},{"id":"manas-2010:p1167:b001:l019","ordinal":50767,"en":"Vowing a horse with moon-white hooves,"},{"id":"manas-2010:p1167:b001:l020","ordinal":50768,"en":"Almambet stood rejoicing."},{"id":"manas-2010:p1167:b001:l021","ordinal":50769,"en":"The rawhide bag like a resting camel"},{"id":"manas-2010:p1167:b001:l022","ordinal":50770,"en":"He slashed open,"},{"id":"manas-2010:p1167:b001:l023","ordinal":50771,"en":"And Kongurbay's disguise coat"},{"id":"manas-2010:p1167:b001:l024","ordinal":50772,"en":"Almambet took and put on."},{"id":"manas-2010:p1167:b001:l025","ordinal":50773,"en":"When he had put on the coat,"},{"id":"manas-2010:p1167:b001:l026","ordinal":50774,"en":"Almambet stood resplendent."},{"id":"manas-2010:p1167:b001:l027","ordinal":50775,"en":"Brave Syrgak watched,"},{"id":"manas-2010:p1167:b001:l028","ordinal":50776,"en":"Marveling at Almambet."},{"id":"manas-2010:p1167:b001:l029","ordinal":50777,"en":"Gold gleamed from ring after ring;"},{"id":"manas-2010:p1167:b001:l030","ordinal":50778,"en":"A coral stone as large as a leather flask"},{"id":"manas-2010:p1167:b001:l031","ordinal":50779,"en":"Shone upon his head."},{"id":"manas-2010:p1167:b001:l032","ordinal":50780,"en":"Seen from outside,"},{"id":"manas-2010:p1167:b001:l033","ordinal":50781,"en":"A cotton sash and broad boots—"},{"id":"manas-2010:p1167:b001:l034","ordinal":50782,"en":"If you looked at his appearance,"},{"id":"manas-2010:p1167:b001:l035","ordinal":50783,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1167:b001:l036","ordinal":50784,"en":"Your Almambet had now become that very man."},{"id":"manas-2010:p1167:b001:l037","ordinal":50785,"en":"The smoking pipe in his hand,"},{"id":"manas-2010:p1167:b001:l038","ordinal":50786,"en":"A smooth pipe with a golden crescent—"},{"id":"manas-2010:p1167:b001:l039","ordinal":50787,"en":"When viewed from the front,"},{"id":"manas-2010:p1167:b001:l040","ordinal":50788,"en":"A fearsome giant big as a hut."},{"id":"manas-2010:p1167:b001:l041","ordinal":50789,"en":"Then, when they had come from vast Talas,"},{"id":"manas-2010:p1167:b001:l042","ordinal":50790,"en":"Crying out, moving up and down,"},{"id":"manas-2010:p1168:b001:l001","ordinal":50791,"en":"Had she not given it in agitation?"},{"id":"manas-2010:p1168:b001:l002","ordinal":50792,"en":"A saddlebag as a gift,"},{"id":"manas-2010:p1168:b001:l003","ordinal":50793,"en":"Your heroic sister-in-law Kanykey,"},{"id":"manas-2010:p1168:b001:l004","ordinal":50794,"en":"Had she not given it weeping?"},{"id":"manas-2010:p1168:b001:l005","ordinal":50795,"en":"“My husband's friend, strap it on if you go to Beijing."},{"id":"manas-2010:p1168:b001:l006","ordinal":50796,"en":"‘My heroic sister-in-law gave this,’ say,"},{"id":"manas-2010:p1168:b001:l007","ordinal":50797,"en":"And take it as a gift."},{"id":"manas-2010:p1168:b001:l008","ordinal":50798,"en":"If you go to the Chinese realm's Beijing,"},{"id":"manas-2010:p1168:b001:l009","ordinal":50799,"en":"They say the Chinese are like grass;"},{"id":"manas-2010:p1168:b001:l010","ordinal":50800,"en":"They say its calamities are many.”"},{"id":"manas-2010:p1168:b001:l011","ordinal":50801,"en":"“When he brings trouble upon Beijing,"},{"id":"manas-2010:p1168:b001:l012","ordinal":50802,"en":"Let him carry it as a gift,” she thought."},{"id":"manas-2010:p1168:b001:l013","ordinal":50803,"en":"Resourceful Kanykey"},{"id":"manas-2010:p1168:b001:l014","ordinal":50804,"en":"Had she not fashioned it?"},{"id":"manas-2010:p1168:b001:l015","ordinal":50805,"en":"Kongurbay's Algara,"},{"id":"manas-2010:p1168:b001:l016","ordinal":50806,"en":"Ear for ear,"},{"id":"manas-2010:p1168:b001:l017","ordinal":50807,"en":"Hoof for hoof,"},{"id":"manas-2010:p1168:b001:l018","ordinal":50808,"en":"Making it exactly so,"},{"id":"manas-2010:p1168:b001:l019","ordinal":50809,"en":"Had she not fashioned it?"},{"id":"manas-2010:p1168:b001:l020","ordinal":50810,"en":"The inner side of the covering"},{"id":"manas-2010:p1168:b001:l021","ordinal":50811,"en":"She had bound with fiber."},{"id":"manas-2010:p1168:b001:l022","ordinal":50812,"en":"The outer side, where the hair would lie,"},{"id":"manas-2010:p1168:b001:l023","ordinal":50813,"en":"She had covered with black horsehair."},{"id":"manas-2010:p1168:b001:l024","ordinal":50814,"en":"Placing it in the saddlebag and stitching it up,"},{"id":"manas-2010:p1168:b001:l025","ordinal":50815,"en":"She entrusted it with instructions."},{"id":"manas-2010:p1168:b001:l026","ordinal":50816,"en":"Poor Kanykey said:"},{"id":"manas-2010:p1168:b001:l027","ordinal":50817,"en":"“If you go to Beijing, take it."},{"id":"manas-2010:p1168:b001:l028","ordinal":50818,"en":"Do not think it a burden, my husband's friend;"},{"id":"manas-2010:p1168:b001:l029","ordinal":50819,"en":"Strap it to your saddle-strings."},{"id":"manas-2010:p1168:b001:l030","ordinal":50820,"en":"This disguise coat here"},{"id":"manas-2010:p1168:b001:l031","ordinal":50821,"en":"I give as a gift; take it.”"},{"id":"manas-2010:p1168:b001:l032","ordinal":50822,"en":"Heroic Kanykey,"},{"id":"manas-2010:p1168:b001:l033","ordinal":50823,"en":"The disguise coat she had given as a gift—"},{"id":"manas-2010:p1168:b001:l034","ordinal":50824,"en":"Your champion Almambet, the leopard,"},{"id":"manas-2010:p1168:b001:l035","ordinal":50825,"en":"From Sarala beneath him"},{"id":"manas-2010:p1168:b001:l036","ordinal":50826,"en":"Removed the saddle, leaving him bare."},{"id":"manas-2010:p1168:b001:l037","ordinal":50827,"en":"He showed his prowess:"},{"id":"manas-2010:p1168:b001:l038","ordinal":50828,"en":"The disguise coat Kanykey had given"},{"id":"manas-2010:p1168:b001:l039","ordinal":50829,"en":"He put upon Sarala."},{"id":"manas-2010:p1168:b001:l040","ordinal":50830,"en":"When that disguise coat was on,"},{"id":"manas-2010:p1168:b001:l041","ordinal":50831,"en":"The swift Sarala in his disguise,"},{"id":"manas-2010:p1168:b001:l042","ordinal":50832,"en":"His Sarala vanished;"},{"id":"manas-2010:p1169:b001:l001","ordinal":50833,"en":"Kongurbay's Algara—"},{"id":"manas-2010:p1169:b001:l002","ordinal":50834,"en":"He became Algara in appearance."},{"id":"manas-2010:p1169:b001:l003","ordinal":50835,"en":"He tossed his forelock to the sky;"},{"id":"manas-2010:p1169:b001:l004","ordinal":50836,"en":"He drove his hooves into the earth;"},{"id":"manas-2010:p1169:b001:l005","ordinal":50837,"en":"He rattled his bit."},{"id":"manas-2010:p1169:b001:l006","ordinal":50838,"en":"His tail like strands of silk"},{"id":"manas-2010:p1169:b001:l007","ordinal":50839,"en":"He lashed against his hindquarters."},{"id":"manas-2010:p1169:b001:l008","ordinal":50840,"en":"When mounted, Sarala"},{"id":"manas-2010:p1169:b001:l009","ordinal":50841,"en":"Tossed and strained like Algara."},{"id":"manas-2010:p1169:b001:l010","ordinal":50842,"en":"Here and there Sarala"},{"id":"manas-2010:p1169:b001:l011","ordinal":50843,"en":"Leapt forward and jerked about."},{"id":"manas-2010:p1169:b001:l012","ordinal":50844,"en":"Almambet held his neck high like a rooster;"},{"id":"manas-2010:p1169:b001:l013","ordinal":50845,"en":"His sword rang at his side."},{"id":"manas-2010:p1169:b001:l014","ordinal":50846,"en":"When he set off obliquely,"},{"id":"manas-2010:p1169:b001:l015","ordinal":50847,"en":"Among the Chinese with red tassels,"},{"id":"manas-2010:p1169:b001:l016","ordinal":50848,"en":"He strode splendidly as their mighty one."},{"id":"manas-2010:p1169:b001:l017","ordinal":50849,"en":"Truly, there is no death for you,"},{"id":"manas-2010:p1169:b001:l018","ordinal":50850,"en":"Of the Chinese with cap rank-buttons,"},{"id":"manas-2010:p1169:b001:l019","ordinal":50851,"en":"Taking the shape of their finest,"},{"id":"manas-2010:p1169:b001:l020","ordinal":50852,"en":"Across a pass like a saddle-bow,"},{"id":"manas-2010:p1169:b001:l021","ordinal":50853,"en":"He emerged in dust—did you see?"},{"id":"manas-2010:p1169:b001:l022","ordinal":50854,"en":"The cunning wild ram was just ahead."},{"id":"manas-2010:p1169:b001:l023","ordinal":50855,"en":"Taking Kongurbay's shape,"},{"id":"manas-2010:p1169:b001:l024","ordinal":50856,"en":"Your Almambet came forth deceiving—did you see?"},{"id":"manas-2010:p1169:b001:l025","ordinal":50857,"en":"“A dragon lies on the ridge;"},{"id":"manas-2010:p1169:b001:l026","ordinal":50858,"en":"Your cunning fox lies there—do you see?"},{"id":"manas-2010:p1169:b001:l027","ordinal":50859,"en":"At the place where I stationed the watch,"},{"id":"manas-2010:p1169:b001:l028","ordinal":50860,"en":"My champion lies in my fortress;"},{"id":"manas-2010:p1169:b001:l029","ordinal":50861,"en":"My duck lies on my lake."},{"id":"manas-2010:p1169:b001:l030","ordinal":50862,"en":"Damn your father's grave, White Ram!"},{"id":"manas-2010:p1169:b001:l031","ordinal":50863,"en":"There is no ship on the dark water."},{"id":"manas-2010:p1169:b001:l032","ordinal":50864,"en":"As long as my dear head lives,"},{"id":"manas-2010:p1169:b001:l033","ordinal":50865,"en":"There is none to oppose me."},{"id":"manas-2010:p1169:b001:l034","ordinal":50866,"en":"There is no division in the water across the way."},{"id":"manas-2010:p1169:b001:l035","ordinal":50867,"en":"As long as my goshawk head lives,"},{"id":"manas-2010:p1169:b001:l036","ordinal":50868,"en":"Keep standing there, cunning ram."},{"id":"manas-2010:p1169:b001:l037","ordinal":50869,"en":"Look now, cunning ram,"},{"id":"manas-2010:p1169:b001:l038","ordinal":50870,"en":"My lion standing watch!"},{"id":"manas-2010:p1169:b001:l039","ordinal":50871,"en":"For so many years,"},{"id":"manas-2010:p1169:b001:l040","ordinal":50872,"en":"As a lookout for me,"},{"id":"manas-2010:p1169:b001:l041","ordinal":50873,"en":"You have remained guarding the road."},{"id":"manas-2010:p1169:b001:l042","ordinal":50874,"en":"That I never put you with wild ewes—"},{"id":"manas-2010:p1170:b001:l001","ordinal":50875,"en":"That regret belongs to me."},{"id":"manas-2010:p1170:b001:l002","ordinal":50876,"en":"From Karykan's presence,"},{"id":"manas-2010:p1170:b001:l003","ordinal":50877,"en":"I shall choose six wild ewes."},{"id":"manas-2010:p1170:b001:l004","ordinal":50878,"en":"In this way, from you"},{"id":"manas-2010:p1170:b001:l005","ordinal":50879,"en":"I shall again obtain offspring.”"},{"id":"manas-2010:p1170:b001:l006","ordinal":50880,"en":"When it heard this,"},{"id":"manas-2010:p1170:b001:l007","ordinal":50881,"en":"Leaving its place, it darted off,"},{"id":"manas-2010:p1170:b001:l008","ordinal":50882,"en":"Before your Almambet,"},{"id":"manas-2010:p1170:b001:l009","ordinal":50883,"en":"Thinking, “It is my Kongurbay,”"},{"id":"manas-2010:p1170:b001:l010","ordinal":50884,"en":"It came racing up."},{"id":"manas-2010:p1170:b001:l011","ordinal":50885,"en":"When it stood broadside,"},{"id":"manas-2010:p1170:b001:l012","ordinal":50886,"en":"Your Almambet having tricked the ram,"},{"id":"manas-2010:p1170:b001:l013","ordinal":50887,"en":"The brim of the black felt hat—"},{"id":"manas-2010:p1170:b001:l014","ordinal":50888,"en":"Have you heard of him?—"},{"id":"manas-2010:p1170:b001:l015","ordinal":50889,"en":"Khan Manas's Syrgak,"},{"id":"manas-2010:p1170:b001:l016","ordinal":50890,"en":"The short gun in his hand"},{"id":"manas-2010:p1170:b001:l017","ordinal":50891,"en":"He aimed and fired once."},{"id":"manas-2010:p1170:b001:l018","ordinal":50892,"en":"Thus he brought down the wild ram."},{"id":"manas-2010:p1170:b001:l019","ordinal":50893,"en":"Young Syrgak, the outstanding warrior,"},{"id":"manas-2010:p1170:b001:l020","ordinal":50894,"en":"Laid it low where he fired."},{"id":"manas-2010:p1170:b001:l021","ordinal":50895,"en":"He shot and slaughtered the cunning ram;"},{"id":"manas-2010:p1170:b001:l022","ordinal":50896,"en":"The two ate their fill of its meat."},{"id":"manas-2010:p1170:b001:l023","ordinal":50897,"en":"Traveling without pity,"},{"id":"manas-2010:p1170:b001:l024","ordinal":50898,"en":"Riding far, sparing no horses,"},{"id":"manas-2010:p1170:b001:l025","ordinal":50899,"en":"Over land with no mountain even an ankle-bone high,"},{"id":"manas-2010:p1170:b001:l026","ordinal":50900,"en":"With no hollow big enough for a saddlecloth,"},{"id":"manas-2010:p1170:b001:l027","ordinal":50901,"en":"Through desert where no dog had passed,"},{"id":"manas-2010:p1170:b001:l028","ordinal":50902,"en":"Along a winding road,"},{"id":"manas-2010:p1170:b001:l029","ordinal":50903,"en":"He turned his horse's head."},{"id":"manas-2010:p1170:b001:l030","ordinal":50904,"en":"Your poor Almambet"},{"id":"manas-2010:p1170:b001:l031","ordinal":50905,"en":"Stood there troubled,"},{"id":"manas-2010:p1170:b001:l032","ordinal":50906,"en":"And to Syrgak beside him"},{"id":"manas-2010:p1170:b001:l033","ordinal":50907,"en":"Spoke these words:"},{"id":"manas-2010:p1170:b001:l034","ordinal":50908,"en":"“On the bluff ahead,"},{"id":"manas-2010:p1170:b001:l035","ordinal":50909,"en":"There is a path for a single horse."},{"id":"manas-2010:p1170:b001:l036","ordinal":50910,"en":"The duck has left the lake."},{"id":"manas-2010:p1170:b001:l037","ordinal":50911,"en":"For not arriving two days earlier,"},{"id":"manas-2010:p1170:b001:l038","ordinal":50912,"en":"Misfortune falls on Almambet."},{"id":"manas-2010:p1170:b001:l039","ordinal":50913,"en":"Six days ahead,"},{"id":"manas-2010:p1170:b001:l040","ordinal":50914,"en":"There is the mighty one called Great Malgun."},{"id":"manas-2010:p1170:b001:l041","ordinal":50915,"en":"He has a club as big as a hut,"},{"id":"manas-2010:p1170:b001:l042","ordinal":50916,"en":"And hands with which to wrestle."},{"id":"manas-2010:p1171:b001:l001","ordinal":50917,"en":"The forty monks standing before him"},{"id":"manas-2010:p1171:b001:l002","ordinal":50918,"en":"Have their chief at the watchpost."},{"id":"manas-2010:p1171:b001:l003","ordinal":50919,"en":"Before Great Malgun"},{"id":"manas-2010:p1171:b001:l004","ordinal":50920,"en":"Lies a sacred text in Chinese."},{"id":"manas-2010:p1171:b001:l005","ordinal":50921,"en":"For the unbeliever Malgun to ride,"},{"id":"manas-2010:p1171:b001:l006","ordinal":50922,"en":"They mount him on a gray mule."},{"id":"manas-2010:p1171:b001:l007","ordinal":50923,"en":"That great donkey, swifter than other beasts—"},{"id":"manas-2010:p1171:b001:l008","ordinal":50924,"en":"No animal can match its running;"},{"id":"manas-2010:p1171:b001:l009","ordinal":50925,"en":"And Malgun upon its back,"},{"id":"manas-2010:p1171:b001:l010","ordinal":50926,"en":"None can overcome, however they wrestle him."},{"id":"manas-2010:p1171:b001:l011","ordinal":50927,"en":"If you ask what Malgun is like,"},{"id":"manas-2010:p1171:b001:l012","ordinal":50928,"en":"His speech is unlike a human's."},{"id":"manas-2010:p1171:b001:l013","ordinal":50929,"en":"Looking at him from the front,"},{"id":"manas-2010:p1171:b001:l014","ordinal":50930,"en":"He has one eye as large as a milk pail."},{"id":"manas-2010:p1171:b001:l015","ordinal":50931,"en":"That is the stronghold of Outer Beijing;"},{"id":"manas-2010:p1171:b001:l016","ordinal":50932,"en":"The immeasurably huge Malgun"},{"id":"manas-2010:p1171:b001:l017","ordinal":50933,"en":"Is its one-eyed khan."},{"id":"manas-2010:p1171:b001:l018","ordinal":50934,"en":"What times, what nights await us,"},{"id":"manas-2010:p1171:b001:l019","ordinal":50935,"en":"Leopard Syrgak, my champion?"},{"id":"manas-2010:p1171:b001:l020","ordinal":50936,"en":"For the two of us upon this road,"},{"id":"manas-2010:p1171:b001:l021","ordinal":50937,"en":"What days shall there be?"},{"id":"manas-2010:p1171:b001:l022","ordinal":50938,"en":"What frightens me, what I fear,"},{"id":"manas-2010:p1171:b001:l023","ordinal":50939,"en":"Is that unbeliever Great Malgun."},{"id":"manas-2010:p1171:b001:l024","ordinal":50940,"en":"He spares none who grapple with him;"},{"id":"manas-2010:p1171:b001:l025","ordinal":50941,"en":"The meat of a single pig"},{"id":"manas-2010:p1171:b001:l026","ordinal":50942,"en":"Will never fill him at one meal."},{"id":"manas-2010:p1171:b001:l027","ordinal":50943,"en":"Consider my words carefully;"},{"id":"manas-2010:p1171:b001:l028","ordinal":50944,"en":"Such is what your Alake says."}]
