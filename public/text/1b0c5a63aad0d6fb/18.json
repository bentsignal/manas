[{"id":"manas-2010:p0112:b002:l015","ordinal":4609,"en":"Slaughtering livestock when his wife gives birth,"},{"id":"manas-2010:p0112:b002:l016","ordinal":4610,"en":"Laying out all the wealth he has,"},{"id":"manas-2010:p0112:b002:l017","ordinal":4611,"en":"That blustering Burut—"},{"id":"manas-2010:p0112:b002:l018","ordinal":4612,"en":"Look how powerful he has grown!”"},{"id":"manas-2010:p0112:b002:l019","ordinal":4613,"en":"The many Kalmyks spread whispers."},{"id":"manas-2010:p0112:b002:l020","ordinal":4614,"en":"Accursed is life without one's people!"},{"id":"manas-2010:p0112:b002:l021","ordinal":4615,"en":"A great burden fell on Jakyp."},{"id":"manas-2010:p0112:b002:l022","ordinal":4616,"en":"“Slaughtering livestock like an emperor,"},{"id":"manas-2010:p0112:b002:l023","ordinal":4617,"en":"Jakyp is no ordinary rich man."},{"id":"manas-2010:p0112:b002:l024","ordinal":4618,"en":"At the birth, livestock were slaughtered;"},{"id":"manas-2010:p0112:b002:l025","ordinal":4619,"en":"This child is no ordinary child!"},{"id":"manas-2010:p0112:b002:l026","ordinal":4620,"en":"The child's name is Chong Jindi;"},{"id":"manas-2010:p0112:b002:l027","ordinal":4621,"en":"Who knows his other name!"},{"id":"manas-2010:p0112:b002:l028","ordinal":4622,"en":"His child may be burning poison;"},{"id":"manas-2010:p0112:b002:l029","ordinal":4623,"en":"If he lives and grows,"},{"id":"manas-2010:p0112:b002:l030","ordinal":4624,"en":"He may be turmoil born for Beijing!"},{"id":"manas-2010:p0112:b002:l031","ordinal":4625,"en":"Wide Kakanchyn-Bakburchun—"},{"id":"manas-2010:p0112:b002:l032","ordinal":4626,"en":"We came and saw this people's"},{"id":"manas-2010:p0112:b002:l033","ordinal":4627,"en":"Who has slaughtered such livestock?"},{"id":"manas-2010:p0112:b002:l034","ordinal":4628,"en":"Their deed of slaughtering stock."},{"id":"manas-2010:p0112:b002:l035","ordinal":4629,"en":"Let it be written in the great register,"},{"id":"manas-2010:p0112:b002:l036","ordinal":4630,"en":"Jakyp's slaughtering of livestock,"},{"id":"manas-2010:p0112:b002:l037","ordinal":4631,"en":"Let Chin-Beijing be informed."},{"id":"manas-2010:p0112:b002:l038","ordinal":4632,"en":"Slaughtering stock like an emperor,"},{"id":"manas-2010:p0112:b002:l039","ordinal":4633,"en":"What is the meaning of this Burut,"},{"id":"manas-2010:p0112:b002:l040","ordinal":4634,"en":"Of this people called Burut?"},{"id":"manas-2010:p0112:b002:l041","ordinal":4635,"en":"He slaughtered five hundred mares;"},{"id":"manas-2010:p0112:b002:l042","ordinal":4636,"en":"This Burut is a champion."},{"id":"manas-2010:p0112:b002:l043","ordinal":4637,"en":"Their lower lips drooping,"},{"id":"manas-2010:p0112:b002:l044","ordinal":4638,"en":"Their two humps towering,"},{"id":"manas-2010:p0112:b002:l045","ordinal":4639,"en":"He slaughtered five hundred camels."},{"id":"manas-2010:p0112:b002:l046","ordinal":4640,"en":"He devised plans no one could conceive,"},{"id":"manas-2010:p0112:b002:l047","ordinal":4641,"en":"Held a feast reaching the whole world."},{"id":"manas-2010:p0112:b002:l048","ordinal":4642,"en":"Ears have heard, eyes have seen—"},{"id":"manas-2010:p0113:b002:l001","ordinal":4643,"en":"Who has held such a feast?!"},{"id":"manas-2010:p0113:b002:l002","ordinal":4644,"en":"Since he came to this Altai,"},{"id":"manas-2010:p0113:b002:l003","ordinal":4645,"en":"Many years have passed."},{"id":"manas-2010:p0113:b002:l004","ordinal":4646,"en":"This Burut's wealth"},{"id":"manas-2010:p0113:b002:l005","ordinal":4647,"en":"Has surpassed the world's."},{"id":"manas-2010:p0113:b002:l006","ordinal":4648,"en":"Holding a feast when his wife gives birth,"},{"id":"manas-2010:p0113:b002:l007","ordinal":4649,"en":"Such is this Burut's boldness!"},{"id":"manas-2010:p0113:b002:l008","ordinal":4650,"en":"Slaughtering mares without distinction,"},{"id":"manas-2010:p0113:b002:l009","ordinal":4651,"en":"Slaughtering all four kinds of stock alike,"},{"id":"manas-2010:p0113:b002:l010","ordinal":4652,"en":"In this city of Kakan,"},{"id":"manas-2010:p0113:b002:l011","ordinal":4653,"en":"Who has slaughtered such livestock?"},{"id":"manas-2010:p0113:b002:l012","ordinal":4654,"en":"Those who went to his feast were sated;"},{"id":"manas-2010:p0113:b002:l013","ordinal":4655,"en":"In this city of Kakan,"},{"id":"manas-2010:p0113:b002:l014","ordinal":4656,"en":"There is no man like the Burut."},{"id":"manas-2010:p0113:b002:l015","ordinal":4657,"en":"His liquor and his kymyz"},{"id":"manas-2010:p0113:b002:l016","ordinal":4658,"en":"Were too much for the world to hold."},{"id":"manas-2010:p0113:b002:l017","ordinal":4659,"en":"Ulungtung, Dang-Shang, Bakburchun,"},{"id":"manas-2010:p0113:b002:l018","ordinal":4660,"en":"We have seen this people's rulers."},{"id":"manas-2010:p0113:b002:l019","ordinal":4661,"en":"He devised plans no one had seen;"},{"id":"manas-2010:p0113:b002:l020","ordinal":4662,"en":"Of the jacket-wearing Chinese,"},{"id":"manas-2010:p0113:b002:l021","ordinal":4663,"en":"Above even the strongest,"},{"id":"manas-2010:p0113:b002:l022","ordinal":4664,"en":"This Burut held his feast."},{"id":"manas-2010:p0113:b002:l023","ordinal":4665,"en":"People settled at his feast;"},{"id":"manas-2010:p0113:b002:l024","ordinal":4666,"en":"The Black Kalmyks' and Manchus'"},{"id":"manas-2010:p0113:b002:l025","ordinal":4667,"en":"Children had rump portions tied on for them."},{"id":"manas-2010:p0113:b002:l026","ordinal":4668,"en":"Full-grown livestock were slaughtered for his feast;"},{"id":"manas-2010:p0113:b002:l027","ordinal":4669,"en":"If you ask the child's name,"},{"id":"manas-2010:p0113:b002:l028","ordinal":4670,"en":"He was named Chong Jindi."},{"id":"manas-2010:p0113:b002:l029","ordinal":4671,"en":"Holding a feast when his wife gives birth,"},{"id":"manas-2010:p0113:b002:l030","ordinal":4672,"en":"Devising plans no one had seen,"},{"id":"manas-2010:p0113:b002:l031","ordinal":4673,"en":"This Burut has gone mad!"},{"id":"manas-2010:p0113:b002:l032","ordinal":4674,"en":"In the great, paradise-like city of Beijing,"},{"id":"manas-2010:p0113:b002:l033","ordinal":4675,"en":"Our ruler Esenkan—"},{"id":"manas-2010:p0113:b002:l034","ordinal":4676,"en":"Let us send word to him."},{"id":"manas-2010:p0113:b002:l035","ordinal":4677,"en":"Of this Burut Kyrgyz who slaughtered livestock,"},{"id":"manas-2010:p0113:b002:l036","ordinal":4678,"en":"Let us tell the news.”"},{"id":"manas-2010:p0113:b002:l037","ordinal":4679,"en":"From the Black Kalmyks and Manchus,"},{"id":"manas-2010:p0113:b002:l038","ordinal":4680,"en":"All their people gathered."},{"id":"manas-2010:p0113:b002:l039","ordinal":4681,"en":"To Esenkan of Beijing,"},{"id":"manas-2010:p0113:b002:l040","ordinal":4682,"en":"To the kakan's stronghold,"},{"id":"manas-2010:p0113:b002:l041","ordinal":4683,"en":"To the swarming Chinese people,"},{"id":"manas-2010:p0113:b002:l042","ordinal":4684,"en":"To his house ringed with fortifications,"},{"id":"manas-2010:p0113:b002:l043","ordinal":4685,"en":"To his tightly secured city,"},{"id":"manas-2010:p0113:b002:l044","ordinal":4686,"en":"To Esenkan of Beijing,"},{"id":"manas-2010:p0113:b002:l045","ordinal":4687,"en":"The Kalmyk people, their goodwill gone,"},{"id":"manas-2010:p0113:b002:l046","ordinal":4688,"en":"Gave six swift horses,"},{"id":"manas-2010:p0113:b002:l047","ordinal":4689,"en":"Gave a letter the size of a palm,"},{"id":"manas-2010:p0113:b002:l048","ordinal":4690,"en":"And a kettledrum made of copper."},{"id":"manas-2010:p0114:b002:l001","ordinal":4691,"en":"Gripping its handle and swinging it,"},{"id":"manas-2010:p0114:b002:l002","ordinal":4692,"en":"To the kakan's city"},{"id":"manas-2010:p0114:b002:l003","ordinal":4693,"en":"They sent a great executioner."},{"id":"manas-2010:p0114:b002:l004","ordinal":4694,"en":"Then that great executioner,"},{"id":"manas-2010:p0114:b002:l005","ordinal":4695,"en":"Traveling day and night,"},{"id":"manas-2010:p0114:b002:l006","ordinal":4696,"en":"Riding far without sparing his horses,"},{"id":"manas-2010:p0114:b002:l007","ordinal":4697,"en":"Fording surging waters,"},{"id":"manas-2010:p0114:b002:l008","ordinal":4698,"en":"Crossing many looming mountains,"},{"id":"manas-2010:p0114:b002:l009","ordinal":4699,"en":"Hurrying along the road,"},{"id":"manas-2010:p0114:b002:l010","ordinal":4700,"en":"Riding far without sparing his horses,"},{"id":"manas-2010:p0114:b002:l011","ordinal":4701,"en":"Traveling many days between,"},{"id":"manas-2010:p0114:b002:l012","ordinal":4702,"en":"Appearing through the haze,"},{"id":"manas-2010:p0114:b002:l013","ordinal":4703,"en":"To the settlement of Outer Beijing,"},{"id":"manas-2010:p0114:b002:l014","ordinal":4704,"en":"That executioner arrived,"},{"id":"manas-2010:p0114:b002:l015","ordinal":4705,"en":"At Esenkan's settlement."},{"id":"manas-2010:p0114:b002:l016","ordinal":4706,"en":"Outer Beijing with forty gates—"},{"id":"manas-2010:p0114:b002:l017","ordinal":4707,"en":"Its jaysang guarding the gate,"},{"id":"manas-2010:p0114:b002:l018","ordinal":4708,"en":"One of those at the entrance,"},{"id":"manas-2010:p0114:b002:l019","ordinal":4709,"en":"Its monastery where monks lived—"},{"id":"manas-2010:p0114:b002:l020","ordinal":4710,"en":"Do not ask about that monastery."},{"id":"manas-2010:p0114:b002:l021","ordinal":4711,"en":"His ox grows old, he himself dies;"},{"id":"manas-2010:p0114:b002:l022","ordinal":4712,"en":"Of the person who has died,"},{"id":"manas-2010:p0114:b002:l023","ordinal":4713,"en":"They measure out and divide his livestock."},{"id":"manas-2010:p0114:b002:l024","ordinal":4714,"en":"They consecrate his lead goat;"},{"id":"manas-2010:p0114:b002:l025","ordinal":4715,"en":"The horse he rides is sacred."},{"id":"manas-2010:p0114:b002:l026","ordinal":4716,"en":"Look at this people's practices:"},{"id":"manas-2010:p0114:b002:l027","ordinal":4717,"en":"He does not consort with women."},{"id":"manas-2010:p0114:b002:l028","ordinal":4718,"en":"He saddles an unbroken horse;"},{"id":"manas-2010:p0114:b002:l029","ordinal":4719,"en":"Look at this people's practices:"},{"id":"manas-2010:p0114:b002:l030","ordinal":4720,"en":"A great idol made of bronze,"},{"id":"manas-2010:p0114:b002:l031","ordinal":4721,"en":"They bow to it, calling it God."},{"id":"manas-2010:p0114:b002:l032","ordinal":4722,"en":"Beside Esenkan,"},{"id":"manas-2010:p0114:b002:l033","ordinal":4723,"en":"Some thousand monks stand."},{"id":"manas-2010:p0114:b002:l034","ordinal":4724,"en":"That great executioner who had arrived,"},{"id":"manas-2010:p0114:b002:l035","ordinal":4725,"en":"Hurrying, scurrying, stumbling,"},{"id":"manas-2010:p0114:b002:l036","ordinal":4726,"en":"As if a demon had struck his wife,"},{"id":"manas-2010:p0114:b002:l037","ordinal":4727,"en":"As if he fled with pursuers close behind,"},{"id":"manas-2010:p0114:b002:l038","ordinal":4728,"en":"Before Esenkan"},{"id":"manas-2010:p0114:b002:l039","ordinal":4729,"en":"He began to stir up trouble,"},{"id":"manas-2010:p0114:b002:l040","ordinal":4730,"en":"Came in telling the wonder:"},{"id":"manas-2010:p0114:b002:l041","ordinal":4731,"en":"“Of the Burut driven into exile,"},{"id":"manas-2010:p0114:b002:l042","ordinal":4732,"en":"He came and settled in Altai."},{"id":"manas-2010:p0114:b002:l043","ordinal":4733,"en":"Wandering from his people,"},{"id":"manas-2010:p0114:b002:l044","ordinal":4734,"en":"He became our subject."},{"id":"manas-2010:p0114:b002:l045","ordinal":4735,"en":"His heart swelled and grew at ease;"},{"id":"manas-2010:p0114:b002:l046","ordinal":4736,"en":"He grew rich mainly by sowing grain."},{"id":"manas-2010:p0114:b002:l047","ordinal":4737,"en":"When that Jakyp grew rich,"},{"id":"manas-2010:p0114:b002:l048","ordinal":4738,"en":"He devised plans no one could conceive,"},{"id":"manas-2010:p0115:b002:l001","ordinal":4739,"en":"Slaughtering livestock like an emperor,"},{"id":"manas-2010:p0115:b002:l002","ordinal":4740,"en":"He held a feast when his wife gave birth.”"},{"id":"manas-2010:p0115:b002:l003","ordinal":4741,"en":"As the great executioner spoke,"},{"id":"manas-2010:p0115:b002:l004","ordinal":4742,"en":"Esenkan grew angry:"},{"id":"manas-2010:p0115:b002:l005","ordinal":4743,"en":"“To hold a feast when one has a child"},{"id":"manas-2010:p0115:b002:l006","ordinal":4744,"en":"Is the custom of all peoples."},{"id":"manas-2010:p0115:b002:l007","ordinal":4745,"en":"That Burut driven into exile,"},{"id":"manas-2010:p0115:b002:l008","ordinal":4746,"en":"If his four kinds of stock thrive,"},{"id":"manas-2010:p0115:b002:l009","ordinal":4747,"en":"Damn your fathers' graves, Kalmyk people,"},{"id":"manas-2010:p0115:b002:l010","ordinal":4748,"en":"If he came among you and grew rich,"},{"id":"manas-2010:p0115:b002:l011","ordinal":4749,"en":"Should not a man with stock slaughter his stock?"},{"id":"manas-2010:p0115:b002:l012","ordinal":4750,"en":"At any time there is some in the ditch—"},{"id":"manas-2010:p0115:b002:l013","ordinal":4751,"en":"Should not the people name the child?"},{"id":"manas-2010:p0115:b002:l014","ordinal":4752,"en":"Rich Jakyp has livestock;"},{"id":"manas-2010:p0115:b002:l015","ordinal":4753,"en":"‘He slaughtered stock like an emperor,’ you say—"},{"id":"manas-2010:p0115:b002:l016","ordinal":4754,"en":"Why have you become so frenzied?"},{"id":"manas-2010:p0115:b002:l017","ordinal":4755,"en":"Should he not slaughter the stock in his hands?"},{"id":"manas-2010:p0115:b002:l018","ordinal":4756,"en":"Should those at his feast not eat their fill?"},{"id":"manas-2010:p0115:b002:l019","ordinal":4757,"en":"Should the people not gather"},{"id":"manas-2010:p0115:b002:l020","ordinal":4758,"en":"And name the child?!"},{"id":"manas-2010:p0115:b002:l021","ordinal":4759,"en":"That Burut who has a child,"},{"id":"manas-2010:p0115:b002:l022","ordinal":4760,"en":"Will he look his livestock in the eye?"},{"id":"manas-2010:p0115:b002:l023","ordinal":4761,"en":"‘He slaughtered much livestock,’ you say—"},{"id":"manas-2010:p0115:b002:l024","ordinal":4762,"en":"Is it right to come to me with that?"},{"id":"manas-2010:p0115:b002:l025","ordinal":4763,"en":"‘A subject slaughtered his livestock’—"},{"id":"manas-2010:p0115:b002:l026","ordinal":4764,"en":"Why should I grow upset?"},{"id":"manas-2010:p0115:b002:l027","ordinal":4765,"en":"‘My Burut slaughtered his livestock’—"},{"id":"manas-2010:p0115:b002:l028","ordinal":4766,"en":"Why should I be jealous?"},{"id":"manas-2010:p0115:b002:l029","ordinal":4767,"en":"If my subject holds a feast,"},{"id":"manas-2010:p0115:b002:l030","ordinal":4768,"en":"Can a man who resents it prosper?"},{"id":"manas-2010:p0115:b002:l031","ordinal":4769,"en":"You ate your fill at his feast and went mad;"},{"id":"manas-2010:p0115:b002:l032","ordinal":4770,"en":"You rushed here greedily."},{"id":"manas-2010:p0115:b002:l033","ordinal":4771,"en":"Can one called a man prosper so?"},{"id":"manas-2010:p0115:b002:l034","ordinal":4772,"en":"Can a human being be like you?”"},{"id":"manas-2010:p0115:b002:l035","ordinal":4773,"en":"He drove the executioner away,"},{"id":"manas-2010:p0115:b002:l036","ordinal":4774,"en":"Humming without a care,"},{"id":"manas-2010:p0115:b002:l037","ordinal":4775,"en":"Esenkan lay down."},{"id":"manas-2010:p0115:b002:l038","ordinal":4776,"en":"The words the man had brought,"},{"id":"manas-2010:p0115:b002:l039","ordinal":4777,"en":"He did not value as much as a trouser-leg."},{"id":"manas-2010:p0115:b002:l040","ordinal":4778,"en":"Then the hero Manas,"},{"id":"manas-2010:p0115:b002:l041","ordinal":4779,"en":"Day after day passed,"},{"id":"manas-2010:p0115:b002:l042","ordinal":4780,"en":"The appointed time arrived."},{"id":"manas-2010:p0115:b002:l043","ordinal":4781,"en":"Mighty Manas reached seven years;"},{"id":"manas-2010:p0115:b002:l044","ordinal":4782,"en":"His given name was Chong Jindi."},{"id":"manas-2010:p0115:b002:l045","ordinal":4783,"en":"Of that dark-maned sultan,"},{"id":"manas-2010:p0115:b002:l046","ordinal":4784,"en":"Who knew he was a lion?"},{"id":"manas-2010:p0115:b002:l047","ordinal":4785,"en":"Reaching eight, he grew lively;"},{"id":"manas-2010:p0115:b002:l048","ordinal":4786,"en":"He did not follow the proper path."},{"id":"manas-2010:p0116:b002:l001","ordinal":4787,"en":"Whatever anyone said,"},{"id":"manas-2010:p0116:b002:l002","ordinal":4788,"en":"He paid it no heed;"},{"id":"manas-2010:p0116:b002:l003","ordinal":4789,"en":"He took no notice of people's words."},{"id":"manas-2010:p0116:b002:l004","ordinal":4790,"en":"“He truly is Chong Jindi,”"},{"id":"manas-2010:p0116:b002:l005","ordinal":4791,"en":"The Black Kalmyks and Manchu people said,"},{"id":"manas-2010:p0116:b002:l006","ordinal":4792,"en":"Making him their laughingstock."},{"id":"manas-2010:p0116:b002:l007","ordinal":4793,"en":"He did not hurry about like other children;"},{"id":"manas-2010:p0116:b002:l008","ordinal":4794,"en":"Until he reached the age of five,"},{"id":"manas-2010:p0116:b002:l009","ordinal":4795,"en":"Your valiant Manas did not walk."},{"id":"manas-2010:p0116:b002:l010","ordinal":4796,"en":"Chong Jindi was the name they called him;"},{"id":"manas-2010:p0116:b002:l011","ordinal":4797,"en":"Who knew his true name was Manas?"},{"id":"manas-2010:p0116:b002:l012","ordinal":4798,"en":"The Black Kalmyks and Manchu people"},{"id":"manas-2010:p0116:b002:l013","ordinal":4799,"en":"Called him “Jakyp's crippled son.”"},{"id":"manas-2010:p0116:b002:l014","ordinal":4800,"en":"Whenever the Kalmyks saw him,"},{"id":"manas-2010:p0116:b002:l015","ordinal":4801,"en":"They kept on mocking him."},{"id":"manas-2010:p0116:b002:l016","ordinal":4802,"en":"Peerless Manas, wild and reckless,"},{"id":"manas-2010:p0116:b002:l017","ordinal":4803,"en":"When he reached the age of five,"},{"id":"manas-2010:p0116:b002:l018","ordinal":4804,"en":"Drew his feet beneath him and walked."},{"id":"manas-2010:p0116:b002:l019","ordinal":4805,"en":"From seven years to eight,"},{"id":"manas-2010:p0116:b002:l020","ordinal":4806,"en":"When the boy had grown,"},{"id":"manas-2010:p0116:b002:l021","ordinal":4807,"en":"He became a burning ember;"},{"id":"manas-2010:p0116:b002:l022","ordinal":4808,"en":"Among the forty Kyrgyz households"},{"id":"manas-2010:p0116:b002:l023","ordinal":4809,"en":"There was no such unruly child."},{"id":"manas-2010:p0116:b002:l024","ordinal":4810,"en":"He played with the other children;"},{"id":"manas-2010:p0116:b002:l025","ordinal":4811,"en":"Once that warrior began to play,"},{"id":"manas-2010:p0116:b002:l026","ordinal":4812,"en":"He would not stop his games."},{"id":"manas-2010:p0116:b002:l027","ordinal":4813,"en":"Of the children who played with him,"},{"id":"manas-2010:p0116:b002:l028","ordinal":4814,"en":"Many were left crawling."},{"id":"manas-2010:p0116:b002:l029","ordinal":4815,"en":"If he seized them in anger,"},{"id":"manas-2010:p0116:b002:l030","ordinal":4816,"en":"The children shrieked and screamed."},{"id":"manas-2010:p0116:b002:l031","ordinal":4817,"en":"If he truly gripped them hard,"},{"id":"manas-2010:p0116:b002:l032","ordinal":4818,"en":"They crumbled like ground grain."},{"id":"manas-2010:p0116:b002:l033","ordinal":4819,"en":"One day Manas the leopard,"},{"id":"manas-2010:p0116:b002:l034","ordinal":4820,"en":"Unable to restrain his excitement,"},{"id":"manas-2010:p0116:b002:l035","ordinal":4821,"en":"Gathered forty boys from forty households,"},{"id":"manas-2010:p0116:b002:l036","ordinal":4822,"en":"All those precious children together."},{"id":"manas-2010:p0116:b002:l037","ordinal":4823,"en":"On the plain of Great Altai"},{"id":"manas-2010:p0116:b002:l038","ordinal":4824,"en":"They gathered and began to play."},{"id":"manas-2010:p0116:b002:l039","ordinal":4825,"en":"These sons of forty Kyrgyz households"},{"id":"manas-2010:p0116:b002:l040","ordinal":4826,"en":"Played their boisterous games;"},{"id":"manas-2010:p0116:b002:l041","ordinal":4827,"en":"Valiant Manas was among them,"},{"id":"manas-2010:p0116:b002:l042","ordinal":4828,"en":"Distinguishing himself in play."},{"id":"manas-2010:p0116:b002:l043","ordinal":4829,"en":"From the Black Kalmyks and Manchus,"},{"id":"manas-2010:p0116:b002:l044","ordinal":4830,"en":"Aged fifteen or sixteen,"},{"id":"manas-2010:p0116:b002:l045","ordinal":4831,"en":"Somewhere between those two ages,"},{"id":"manas-2010:p0116:b002:l046","ordinal":4832,"en":"Eighty boys arrived."},{"id":"manas-2010:p0116:b002:l047","ordinal":4833,"en":"Among those boys"},{"id":"manas-2010:p0116:b002:l048","ordinal":4834,"en":"Was the Gray Kalmyk's eldest son,"},{"id":"manas-2010:p0117:b002:l001","ordinal":4835,"en":"Both headstrong and bold."},{"id":"manas-2010:p0117:b002:l002","ordinal":4836,"en":"Those eighty boys behaved wickedly;"},{"id":"manas-2010:p0117:b002:l003","ordinal":4837,"en":"Calling them “fucking Buruts,”"},{"id":"manas-2010:p0117:b002:l004","ordinal":4838,"en":"They humiliated the children."},{"id":"manas-2010:p0117:b002:l005","ordinal":4839,"en":"Then those boys cried out:"},{"id":"manas-2010:p0117:b002:l006","ordinal":4840,"en":"“Wandering Buruts who have come here!"},{"id":"manas-2010:p0117:b002:l007","ordinal":4841,"en":"These children of the Buruts—"},{"id":"manas-2010:p0117:b002:l008","ordinal":4842,"en":"Crush them and wipe them out!”"},{"id":"manas-2010:p0117:b002:l009","ordinal":4843,"en":"The eighty boys charged,"},{"id":"manas-2010:p0117:b002:l010","ordinal":4844,"en":"Setting upon the forty;"},{"id":"manas-2010:p0117:b002:l011","ordinal":4845,"en":"The forty children screamed,"},{"id":"manas-2010:p0117:b002:l012","ordinal":4846,"en":"With scarcely any life left in them."},{"id":"manas-2010:p0117:b002:l013","ordinal":4847,"en":"All forty boys"},{"id":"manas-2010:p0117:b002:l014","ordinal":4848,"en":"Bent their knees to the ground"},{"id":"manas-2010:p0117:b002:l015","ordinal":4849,"en":"Before those other children;"},{"id":"manas-2010:p0117:b002:l016","ordinal":4850,"en":"The forty, fearing for their lives,"},{"id":"manas-2010:p0117:b002:l017","ordinal":4851,"en":"Before the eighty boys"},{"id":"manas-2010:p0117:b002:l018","ordinal":4852,"en":"Bowed like young brides."},{"id":"manas-2010:p0117:b002:l019","ordinal":4853,"en":"“Good sirs, spare our lives!” they cried,"},{"id":"manas-2010:p0117:b002:l020","ordinal":4854,"en":"Despairing of their fly-sized souls."},{"id":"manas-2010:p0117:b002:l021","ordinal":4855,"en":"Look at those forty boys:"},{"id":"manas-2010:p0117:b002:l022","ordinal":4856,"en":"The strength had left their arms,"},{"id":"manas-2010:p0117:b002:l023","ordinal":4857,"en":"The courage had left their hearts."},{"id":"manas-2010:p0117:b002:l024","ordinal":4858,"en":"Screaming, running away,"},{"id":"manas-2010:p0117:b002:l025","ordinal":4859,"en":"Despairing of their fly-sized souls—"},{"id":"manas-2010:p0117:b002:l026","ordinal":4860,"en":"Such was the children's plight."},{"id":"manas-2010:p0117:b002:l027","ordinal":4861,"en":"The eighty beat the forty,"},{"id":"manas-2010:p0117:b002:l028","ordinal":4862,"en":"Unmoved by their pleading."},{"id":"manas-2010:p0117:b002:l029","ordinal":4863,"en":"Their ragged coats were torn apart,"},{"id":"manas-2010:p0117:b002:l030","ordinal":4864,"en":"Their noses streamed with blood."}]
