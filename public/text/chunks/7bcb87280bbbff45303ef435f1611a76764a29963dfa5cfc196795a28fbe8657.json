[{"id":"semetey-1-2013:p1309:b004:l017","ordinal":177153,"en":"As though about to leave this world,"},{"id":"semetey-1-2013:p1309:b004:l018","ordinal":177154,"en":"He lost his wits."},{"id":"semetey-1-2013:p1309:b004:l019","ordinal":177155,"en":"Lion Toltoy then"},{"id":"semetey-1-2013:p1309:b004:l020","ordinal":177156,"en":"Fled away from his people."},{"id":"semetey-1-2013:p1309:b004:l021","ordinal":177157,"en":"He fled like a woman—away he went,"},{"id":"semetey-1-2013:p1309:b004:l022","ordinal":177158,"en":"Toltoy of the Jediger, their noble"},{"id":"semetey-1-2013:p1309:b004:l023","ordinal":177159,"en":"lion."},{"id":"semetey-1-2013:p1309:b004:l024","ordinal":177160,"en":"Roaring in fury,"},{"id":"semetey-1-2013:p1309:b004:l025","ordinal":177161,"en":"When he saw Khan Toltoy,"},{"id":"semetey-1-2013:p1309:b004:l026","ordinal":177162,"en":"Lion-prince Külchoro"},{"id":"semetey-1-2013:p1309:b004:l027","ordinal":177163,"en":"Shouted the battle cry “Manas!”"},{"id":"semetey-1-2013:p1309:b004:l028","ordinal":177164,"en":"“Do not flee like a woman,"},{"id":"semetey-1-2013:p1309:b004:l029","ordinal":177165,"en":"Toltoy!” he shouted."},{"id":"semetey-1-2013:p1309:b004:l030","ordinal":177166,"en":"A ridge shaped like a saddleback—"},{"id":"semetey-1-2013:p1309:b004:l031","ordinal":177167,"en":"Toltoy came crossing it."},{"id":"semetey-1-2013:p1309:b004:l032","ordinal":177168,"en":"Glancing about in fear,"},{"id":"semetey-1-2013:p1309:b004:l033","ordinal":177169,"en":"Toltoy came fleeing."},{"id":"semetey-1-2013:p1309:b004:l034","ordinal":177170,"en":"Without looking around,"},{"id":"semetey-1-2013:p1309:b004:l035","ordinal":177171,"en":"With no care for his own life,"},{"id":"semetey-1-2013:p1309:b004:l036","ordinal":177172,"en":"Külchoro pursued him."},{"id":"semetey-1-2013:p1309:b004:l037","ordinal":177173,"en":"Brave Toltoy's Surkoyon"},{"id":"semetey-1-2013:p1309:b004:l038","ordinal":177174,"en":"Was no beast that could let him catch up,"},{"id":"semetey-1-2013:p1309:b004:l039","ordinal":177175,"en":"And Külchoro's Aktelki—"},{"id":"semetey-1-2013:p1310:b003:l001","ordinal":177176,"en":"Was no beast that could quite catch him."},{"id":"semetey-1-2013:p1310:b003:l002","ordinal":177177,"en":"Skimming over the face of the earth,"},{"id":"semetey-1-2013:p1310:b003:l003","ordinal":177178,"en":"Circling Khan Akun's city,"},{"id":"semetey-1-2013:p1310:b003:l004","ordinal":177179,"en":"He harried Toltoy."},{"id":"semetey-1-2013:p1310:b003:l005","ordinal":177180,"en":"Around the marsh of Üyrülmö"},{"id":"semetey-1-2013:p1310:b003:l006","ordinal":177181,"en":"He chased him three times."},{"id":"semetey-1-2013:p1310:b003:l007","ordinal":177182,"en":"Around the marsh of Chogulma"},{"id":"semetey-1-2013:p1310:b003:l008","ordinal":177183,"en":"He chased him in a full circuit."},{"id":"semetey-1-2013:p1310:b003:l009","ordinal":177184,"en":"At the foot of the mountains"},{"id":"semetey-1-2013:p1310:b003:l010","ordinal":177185,"en":"Of Keng-Opol he pursued him;"},{"id":"semetey-1-2013:p1310:b003:l011","ordinal":177186,"en":"Along the water of broad Ürgönch"},{"id":"semetey-1-2013:p1310:b003:l012","ordinal":177187,"en":"He pursued him."},{"id":"semetey-1-2013:p1310:b003:l013","ordinal":177188,"en":"Across boundless Ak-Chiy,"},{"id":"semetey-1-2013:p1310:b003:l014","ordinal":177189,"en":"He went after him;"},{"id":"semetey-1-2013:p1310:b003:l015","ordinal":177190,"en":"Along the edge of the rolling plain,"},{"id":"semetey-1-2013:p1310:b003:l016","ordinal":177191,"en":"He pursued him."},{"id":"semetey-1-2013:p1310:b003:l017","ordinal":177192,"en":"At the far end of the swelling mountain,"},{"id":"semetey-1-2013:p1310:b003:l018","ordinal":177193,"en":"He pursued him,"},{"id":"semetey-1-2013:p1310:b003:l019","ordinal":177194,"en":"And beside Akun's exhausted city,"},{"id":"semetey-1-2013:p1310:b003:l020","ordinal":177195,"en":"He pursued him."},{"id":"semetey-1-2013:p1310:b003:l021","ordinal":177196,"en":"He chased him around six times."},{"id":"semetey-1-2013:p1310:b003:l022","ordinal":177197,"en":"Watching from atop the tower,"},{"id":"semetey-1-2013:p1310:b003:l023","ordinal":177198,"en":"Ayçürök"},{"id":"semetey-1-2013:p1310:b003:l024","ordinal":177199,"en":"Mocked Toltoy."},{"id":"semetey-1-2013:p1310:b003:l025","ordinal":177200,"en":"“Ayrok, ayrok!” she cried,"},{"id":"semetey-1-2013:p1310:b003:l026","ordinal":177201,"en":"God has struck Chürök mad."},{"id":"semetey-1-2013:p1310:b003:l027","ordinal":177202,"en":"“Rather than flee in a panic"},{"id":"semetey-1-2013:p1310:b003:l028","ordinal":177203,"en":"From nine-year-old Külchoro,"},{"id":"semetey-1-2013:p1310:b003:l029","ordinal":177204,"en":"Mountain-like Toltoy, you should die"},{"id":"semetey-1-2013:p1310:b003:l030","ordinal":177205,"en":"And behold Judgment Day!"},{"id":"semetey-1-2013:p1310:b003:l031","ordinal":177206,"en":"Can there be a hero like you?"},{"id":"semetey-1-2013:p1310:b003:l032","ordinal":177207,"en":"You blustering brute,"},{"id":"semetey-1-2013:p1310:b003:l033","ordinal":177208,"en":"Is it right to call you a hero?"},{"id":"semetey-1-2013:p1310:b003:l034","ordinal":177209,"en":"Rather than scurry away, you should die;"},{"id":"semetey-1-2013:p1310:b003:l035","ordinal":177210,"en":"Can there be a fool like you?"},{"id":"semetey-1-2013:p1310:b003:l036","ordinal":177211,"en":"Külchoro is twelve,"},{"id":"semetey-1-2013:p1310:b003:l037","ordinal":177212,"en":"Brave Toltoy is thirty-five,"},{"id":"semetey-1-2013:p1310:b003:l038","ordinal":177213,"en":"Yet you have fled in terror—"},{"id":"semetey-1-2013:p1310:b003:l039","ordinal":177214,"en":"Ayrok, fool, ayrok!” she cried."},{"id":"semetey-1-2013:p1310:b004:l001","ordinal":177215,"en":"“Shame, fool, shame!” she cried."},{"id":"semetey-1-2013:p1310:b004:l002","ordinal":177216,"en":"“You should behold Judgment Day;"},{"id":"semetey-1-2013:p1310:b004:l003","ordinal":177217,"en":"Rather than flee about like this,"},{"id":"semetey-1-2013:p1310:b004:l004","ordinal":177218,"en":"You should strangle on your trouser cord!"},{"id":"semetey-1-2013:p1310:b004:l005","ordinal":177219,"en":"You are no proper man,"},{"id":"semetey-1-2013:p1310:b004:l006","ordinal":177220,"en":"Fleeing from a mere youth."},{"id":"semetey-1-2013:p1310:b004:l007","ordinal":177221,"en":"You fool akin to a beast,"},{"id":"semetey-1-2013:p1310:b004:l008","ordinal":177222,"en":"You are fleeing from a child."},{"id":"semetey-1-2013:p1310:b004:l009","ordinal":177223,"en":"Instead of going off fleeing from a child,"},{"id":"semetey-1-2013:p1310:b004:l010","ordinal":177224,"en":"Your wineskin nose bulging,"},{"id":"semetey-1-2013:p1310:b004:l011","ordinal":177225,"en":"Is there meat to set upon the platter?"},{"id":"semetey-1-2013:p1310:b004:l012","ordinal":177226,"en":"Royal bridegroom, have you any shame?"},{"id":"semetey-1-2013:p1310:b004:l013","ordinal":177227,"en":"You came to fight only in pretense,"},{"id":"semetey-1-2013:p1310:b004:l014","ordinal":177228,"en":"And proved to be careless;"},{"id":"semetey-1-2013:p1310:b004:l015","ordinal":177229,"en":"Ready to flee at the sight of a figure,"},{"id":"semetey-1-2013:p1310:b004:l016","ordinal":177230,"en":"You are a phantom Toltoy."},{"id":"semetey-1-2013:p1310:b004:l017","ordinal":177231,"en":"Unable to face a child,"},{"id":"semetey-1-2013:p1310:b004:l018","ordinal":177232,"en":"You are a womanly Toltoy."},{"id":"semetey-1-2013:p1310:b004:l019","ordinal":177233,"en":"Rather than flee about like this,"},{"id":"semetey-1-2013:p1310:b004:l020","ordinal":177234,"en":"Accursed Toltoy, you should die"},{"id":"semetey-1-2013:p1310:b004:l021","ordinal":177235,"en":"And behold Judgment Day!"},{"id":"semetey-1-2013:p1310:b004:l022","ordinal":177236,"en":"Rather than run away flapping,"},{"id":"semetey-1-2013:p1310:b004:l023","ordinal":177237,"en":"You should wheel and thrust your spear!"},{"id":"semetey-1-2013:p1310:b004:l024","ordinal":177238,"en":"Rather than scurry away,"},{"id":"semetey-1-2013:p1310:b004:l025","ordinal":177239,"en":"You should move and drive your spear!"},{"id":"semetey-1-2013:p1310:b004:l026","ordinal":177240,"en":"Hurl the child from your spear"},{"id":"semetey-1-2013:p1310:b004:l027","ordinal":177241,"en":"And make me your bride!"},{"id":"semetey-1-2013:p1310:b004:l028","ordinal":177242,"en":"Oh, bridegroom, shame on me!"},{"id":"semetey-1-2013:p1310:b004:l029","ordinal":177243,"en":"Failing as a bridegroom, drop dead;"},{"id":"semetey-1-2013:p1310:b004:l030","ordinal":177244,"en":"Sink and die without offspring!"},{"id":"semetey-1-2013:p1310:b004:l031","ordinal":177245,"en":"Rather than this, you fool,"},{"id":"semetey-1-2013:p1310:b004:l032","ordinal":177246,"en":"Do not remain alive—drop dead!”"},{"id":"semetey-1-2013:p1310:b004:l033","ordinal":177247,"en":"After hearing this from Chürök,"},{"id":"semetey-1-2013:p1310:b004:l034","ordinal":177248,"en":"He stiffened in rage,"},{"id":"semetey-1-2013:p1310:b004:l035","ordinal":177249,"en":"And wheeled around"},{"id":"semetey-1-2013:p1310:b004:l036","ordinal":177250,"en":"Surkoyon beneath him."},{"id":"semetey-1-2013:p1310:b004:l037","ordinal":177251,"en":"He brandished and took in hand"},{"id":"semetey-1-2013:p1310:b004:l038","ordinal":177252,"en":"His steel spear with a knobbed shaft."},{"id":"semetey-1-2013:p1310:b004:l039","ordinal":177253,"en":"Poor Toltoy then"},{"id":"semetey-1-2013:p1311:b003:l001","ordinal":177254,"en":"Thunderously thrust his spear."},{"id":"semetey-1-2013:p1311:b003:l002","ordinal":177255,"en":"From the other side Külchoro"},{"id":"semetey-1-2013:p1311:b003:l003","ordinal":177256,"en":"Also readied his spear."},{"id":"semetey-1-2013:p1311:b003:l004","ordinal":177257,"en":"Your warrior born a lion"},{"id":"semetey-1-2013:p1311:b003:l005","ordinal":177258,"en":"Charged and thrust his spear."},{"id":"semetey-1-2013:p1311:b003:l006","ordinal":177259,"en":"Spurring on in fury,"},{"id":"semetey-1-2013:p1311:b003:l007","ordinal":177260,"en":"The lion-prince reached him."},{"id":"semetey-1-2013:p1311:b003:l008","ordinal":177261,"en":"Skillful Toltoy, your blue-maned wolf,"},{"id":"semetey-1-2013:p1311:b003:l009","ordinal":177262,"en":"Also drove his spear."},{"id":"semetey-1-2013:p1311:b003:l010","ordinal":177263,"en":"They stood without fleeing and jousted,"},{"id":"semetey-1-2013:p1311:b003:l011","ordinal":177264,"en":"Meeting one another with spears;"},{"id":"semetey-1-2013:p1311:b003:l012","ordinal":177265,"en":"When they faced each other,"},{"id":"semetey-1-2013:p1311:b003:l013","ordinal":177266,"en":"They were utterly battered."},{"id":"semetey-1-2013:p1311:b003:l014","ordinal":177267,"en":"Their spears could avail them no more,"},{"id":"semetey-1-2013:p1311:b003:l015","ordinal":177268,"en":"Their jousting ceased,"},{"id":"semetey-1-2013:p1311:b003:l016","ordinal":177269,"en":"And they fought with battle-axes."},{"id":"semetey-1-2013:p1311:b003:l017","ordinal":177270,"en":"The battle-axes went shrieking,"},{"id":"semetey-1-2013:p1311:b003:l018","ordinal":177271,"en":"Leaving their hafts in their hands."},{"id":"semetey-1-2013:p1311:b003:l019","ordinal":177272,"en":"They fought with swords,"},{"id":"semetey-1-2013:p1311:b003:l020","ordinal":177273,"en":"And all the swords shattered,"},{"id":"semetey-1-2013:p1311:b003:l021","ordinal":177274,"en":"Leaving the scabbards in their hands."},{"id":"semetey-1-2013:p1311:b003:l022","ordinal":177275,"en":"They seized each other's collars,"},{"id":"semetey-1-2013:p1311:b003:l023","ordinal":177276,"en":"Tearing at whatever they grasped."},{"id":"semetey-1-2013:p1311:b003:l024","ordinal":177277,"en":"When nothing else availed them,"},{"id":"semetey-1-2013:p1311:b003:l025","ordinal":177278,"en":"They dismounted."},{"id":"semetey-1-2013:p1311:b003:l026","ordinal":177279,"en":"They seized each other's wrists,"},{"id":"semetey-1-2013:p1311:b003:l027","ordinal":177280,"en":"Wrestling like champions,"},{"id":"semetey-1-2013:p1311:b003:l028","ordinal":177281,"en":"Tearing whatever flesh showed,"},{"id":"semetey-1-2013:p1311:b003:l029","ordinal":177282,"en":"Butting like blue bulls."},{"id":"semetey-1-2013:p1311:b003:l030","ordinal":177283,"en":"They heaved worse than camels,"},{"id":"semetey-1-2013:p1311:b003:l031","ordinal":177284,"en":"And grappled worse than stallions."},{"id":"semetey-1-2013:p1311:b003:l032","ordinal":177285,"en":"Neither could overcome the other,"},{"id":"semetey-1-2013:p1311:b003:l033","ordinal":177286,"en":"Neither could throw the other;"},{"id":"semetey-1-2013:p1311:b003:l034","ordinal":177287,"en":"While they stood unable to prevail,"},{"id":"semetey-1-2013:p1311:b003:l035","ordinal":177288,"en":"Making Buurul surge,"},{"id":"semetey-1-2013:p1311:b003:l036","ordinal":177289,"en":"Looming like Opol-Too,"},{"id":"semetey-1-2013:p1311:b003:l037","ordinal":177290,"en":"Venom pouring from his mouth,"},{"id":"semetey-1-2013:p1311:b003:l038","ordinal":177291,"en":"Semetey suddenly appeared."},{"id":"semetey-1-2013:p1311:b003:l039","ordinal":177292,"en":"“The elder and younger brother"},{"id":"semetey-1-2013:p1311:b004:l001","ordinal":177293,"en":"Will join against me,” he thought,"},{"id":"semetey-1-2013:p1311:b004:l002","ordinal":177294,"en":"“They will kill me and reach my end,”"},{"id":"semetey-1-2013:p1311:b004:l003","ordinal":177295,"en":"And his heart sank."},{"id":"semetey-1-2013:p1311:b004:l004","ordinal":177296,"en":"Drawing his sword grimly,"},{"id":"semetey-1-2013:p1311:b004:l005","ordinal":177297,"en":"Semetey reached them."},{"id":"semetey-1-2013:p1311:b004:l006","ordinal":177298,"en":"Toltoy of the Jediger"},{"id":"semetey-1-2013:p1311:b004:l007","ordinal":177299,"en":"Had fallen and lay there."},{"id":"semetey-1-2013:p1311:b004:l008","ordinal":177300,"en":"“When he reaches Judgment Day,"},{"id":"semetey-1-2013:p1311:b004:l009","ordinal":177301,"en":"Let him not say two attacked him;"},{"id":"semetey-1-2013:p1311:b004:l010","ordinal":177302,"en":"Because you would not spare his precious life,"},{"id":"semetey-1-2013:p1311:b004:l011","ordinal":177303,"en":"Let him not say you joined against him."},{"id":"semetey-1-2013:p1311:b004:l012","ordinal":177304,"en":"Give Toltoy's blood to me,”"},{"id":"semetey-1-2013:p1311:b004:l013","ordinal":177305,"en":"Külchoro asked."},{"id":"semetey-1-2013:p1311:b004:l014","ordinal":177306,"en":"Without Semetey charging with his sword,"},{"id":"semetey-1-2013:p1311:b004:l015","ordinal":177307,"en":"He yielded the man's blood to the boy."},{"id":"semetey-1-2013:p1311:b004:l016","ordinal":177308,"en":"He lifted and struck Toltoy,"},{"id":"semetey-1-2013:p1311:b004:l017","ordinal":177309,"en":"Twisted and flung away his mustache,"},{"id":"semetey-1-2013:p1311:b004:l018","ordinal":177310,"en":"And tore and scattered his beard."},{"id":"semetey-1-2013:p1311:b004:l019","ordinal":177311,"en":"He began the slaughter;"},{"id":"semetey-1-2013:p1311:b004:l020","ordinal":177312,"en":"From the weapon at his side,"},{"id":"semetey-1-2013:p1311:b004:l021","ordinal":177313,"en":"Drawing it from its sheath,"},{"id":"semetey-1-2013:p1311:b004:l022","ordinal":177314,"en":"He cut off the head"},{"id":"semetey-1-2013:p1311:b004:l023","ordinal":177315,"en":"Of Toltoy, son of Bagysh."},{"id":"semetey-1-2013:p1311:b004:l024","ordinal":177316,"en":"Dragging it onto the road,"},{"id":"semetey-1-2013:p1311:b004:l025","ordinal":177317,"en":"He displayed it to the Dangyt,"},{"id":"semetey-1-2013:p1311:b004:l026","ordinal":177318,"en":"Taking at last his vengeance"},{"id":"semetey-1-2013:p1311:b004:l027","ordinal":177319,"en":"On the swine Toltoy the warrior."},{"id":"semetey-1-2013:p1311:b004:l028","ordinal":177320,"en":"Brave Toltoy's Surkoyon—"},{"id":"semetey-1-2013:p1311:b004:l029","ordinal":177321,"en":"This Koyon was a peerless courser—"},{"id":"semetey-1-2013:p1311:b004:l030","ordinal":177322,"en":"Would let neither hand near"},{"id":"semetey-1-2013:p1311:b004:l031","ordinal":177323,"en":"The reins tied in a knot,"},{"id":"semetey-1-2013:p1311:b004:l032","ordinal":177324,"en":"And seized them in his mouth."},{"id":"semetey-1-2013:p1311:b004:l033","ordinal":177325,"en":"Wheeling around, he sped off,"},{"id":"semetey-1-2013:p1311:b004:l034","ordinal":177326,"en":"Heading toward the Jediger."},{"id":"semetey-1-2013:p1311:b004:l035","ordinal":177327,"en":"He had crossed"},{"id":"semetey-1-2013:p1311:b004:l036","ordinal":177328,"en":"The saddle-shaped ridge."},{"id":"semetey-1-2013:p1311:b004:l037","ordinal":177329,"en":"No wind matched his gallop,"},{"id":"semetey-1-2013:p1311:b004:l038","ordinal":177330,"en":"No beast matched his stride;"},{"id":"semetey-1-2013:p1311:b004:l039","ordinal":177331,"en":"Thus he fled away."},{"id":"semetey-1-2013:p1312:b003:l001","ordinal":177332,"en":"Peerless courser Surkoyon,"},{"id":"semetey-1-2013:p1312:b003:l002","ordinal":177333,"en":"When he came downhill,"},{"id":"semetey-1-2013:p1312:b003:l003","ordinal":177334,"en":"Stretched his forelegs like a roe deer;"},{"id":"semetey-1-2013:p1312:b003:l004","ordinal":177335,"en":"When he leaned into an ascent,"},{"id":"semetey-1-2013:p1312:b003:l005","ordinal":177336,"en":"His mane and tail spread wide."},{"id":"semetey-1-2013:p1312:b003:l006","ordinal":177337,"en":"Flattening his ears like a kulan,"},{"id":"semetey-1-2013:p1312:b003:l007","ordinal":177338,"en":"He swept the earth like a whirlwind."},{"id":"semetey-1-2013:p1312:b003:l008","ordinal":177339,"en":"That lion-like man,"},{"id":"semetey-1-2013:p1312:b003:l009","ordinal":177340,"en":"Making the earth's surface thunder,"},{"id":"semetey-1-2013:p1312:b003:l010","ordinal":177341,"en":"Urged Arbuu rul onward,"},{"id":"semetey-1-2013:p1312:b003:l011","ordinal":177342,"en":"Putting grass on the gray trail,"},{"id":"semetey-1-2013:p1312:b003:l012","ordinal":177343,"en":"And pursued him relentlessly."},{"id":"semetey-1-2013:p1312:b003:l013","ordinal":177344,"en":"Putting grass on the yellow trail,"},{"id":"semetey-1-2013:p1312:b003:l014","ordinal":177345,"en":"He pursued until he turned pale."},{"id":"semetey-1-2013:p1312:b003:l015","ordinal":177346,"en":"Taibuurul beneath him"},{"id":"semetey-1-2013:p1312:b003:l016","ordinal":177347,"en":"Arched his neck like a stag."},{"id":"semetey-1-2013:p1312:b003:l017","ordinal":177348,"en":"Without slowing, he leaped"},{"id":"semetey-1-2013:p1312:b003:l018","ordinal":177349,"en":"Ravines a spear's length wide."},{"id":"semetey-1-2013:p1312:b003:l019","ordinal":177350,"en":"His neck bent like an argali's;"},{"id":"semetey-1-2013:p1312:b003:l020","ordinal":177351,"en":"When a ravine a rope's length wide appeared,"},{"id":"semetey-1-2013:p1312:b003:l021","ordinal":177352,"en":"He gathered himself and cleared it unfailingly."},{"id":"semetey-1-2013:p1312:b003:l022","ordinal":177353,"en":"When brave Toltoy's Surkoyon"},{"id":"semetey-1-2013:p1312:b003:l023","ordinal":177354,"en":"Reached the seven ridges,"},{"id":"semetey-1-2013:p1312:b003:l024","ordinal":177355,"en":"Semetey came from behind,"},{"id":"semetey-1-2013:p1312:b003:l025","ordinal":177356,"en":"Faster than an arrow."},{"id":"semetey-1-2013:p1312:b003:l026","ordinal":177357,"en":"When Semetey caught him,"},{"id":"semetey-1-2013:p1312:b003:l027","ordinal":177358,"en":"He seized the reins then"},{"id":"semetey-1-2013:p1312:b003:l028","ordinal":177359,"en":"And took him away as spoil."},{"id":"semetey-1-2013:p1312:b003:l029","ordinal":177360,"en":"He pursued and caught him;"},{"id":"semetey-1-2013:p1312:b003:l030","ordinal":177361,"en":"His anger flared greatly."},{"id":"semetey-1-2013:p1312:b003:l031","ordinal":177362,"en":"The lion-prince, that brave man,"},{"id":"semetey-1-2013:p1312:b003:l032","ordinal":177363,"en":"Thinking of nothing else,"},{"id":"semetey-1-2013:p1312:b003:l033","ordinal":177364,"en":"Put on the splendid Kyrgyz saddle."},{"id":"semetey-1-2013:p1312:b003:l034","ordinal":177365,"en":"Because of this, Surkoyon"},{"id":"semetey-1-2013:p1312:b003:l035","ordinal":177366,"en":"Kept vengeance in his heart, saying,"},{"id":"semetey-1-2013:p1312:b003:l036","ordinal":177367,"en":"“I will meet you in a place of hardship.”"},{"id":"semetey-1-2013:p1312:b003:l037","ordinal":177368,"en":"Taking the narrow road as a shortcut,"},{"id":"semetey-1-2013:p1312:b003:l038","ordinal":177369,"en":"Leading Arbuurul,"},{"id":"semetey-1-2013:p1312:b003:l039","ordinal":177370,"en":"Their elder brother came escorting them."},{"id":"semetey-1-2013:p1312:b004:l001","ordinal":177371,"en":"When the two choros saw him,"},{"id":"semetey-1-2013:p1312:b004:l002","ordinal":177372,"en":"The two choros begged for a gift,"},{"id":"semetey-1-2013:p1312:b004:l003","ordinal":177373,"en":"Their knees bending toward the ground,"},{"id":"semetey-1-2013:p1312:b004:l004","ordinal":177374,"en":"And both ran side by side."},{"id":"semetey-1-2013:p1312:b004:l005","ordinal":177375,"en":"Their stirrups struck together."},{"id":"semetey-1-2013:p1312:b004:l006","ordinal":177376,"en":"“Uncle whom I hold in a father's place,"},{"id":"semetey-1-2013:p1312:b004:l007","ordinal":177377,"en":"My uncle like a father, give him to me,” they said."},{"id":"semetey-1-2013:p1312:b004:l008","ordinal":177378,"en":"“Placed before me, he would be good fortune;"},{"id":"semetey-1-2013:p1312:b004:l009","ordinal":177379,"en":"Placed behind me, he would be like a vast army."},{"id":"semetey-1-2013:p1312:b004:l010","ordinal":177380,"en":"Uncle, give him to me as a gift,” they said."},{"id":"semetey-1-2013:p1312:b004:l011","ordinal":177381,"en":"Both ran side by side,"},{"id":"semetey-1-2013:p1312:b004:l012","ordinal":177382,"en":"Bounding like roe deer,"},{"id":"semetey-1-2013:p1312:b004:l013","ordinal":177383,"en":"And the two raced up."},{"id":"semetey-1-2013:p1312:b004:l014","ordinal":177384,"en":"He swung the knotted reins"},{"id":"semetey-1-2013:p1312:b004:l015","ordinal":177385,"en":"Back toward Külchoro"},{"id":"semetey-1-2013:p1312:b004:l016","ordinal":177386,"en":"And tossed them."},{"id":"semetey-1-2013:p1312:b004:l017","ordinal":177387,"en":"Before Kanchoro, Külchoro"},{"id":"semetey-1-2013:p1312:b004:l018","ordinal":177388,"en":"Was the first to take the reins."},{"id":"semetey-1-2013:p1312:b004:l019","ordinal":177389,"en":"At this, Kanchoro"},{"id":"semetey-1-2013:p1312:b004:l020","ordinal":177390,"en":"Thought, “Father, curse you,”"},{"id":"semetey-1-2013:p1312:b004:l021","ordinal":177391,"en":"And resentment remained in his heart."},{"id":"semetey-1-2013:p1312:b004:l022","ordinal":177392,"en":"“He does not regard me as he does Külchoro,” he thought;"},{"id":"semetey-1-2013:p1312:b004:l023","ordinal":177393,"en":"“Father, empty-headed butcher, curse you,”"},{"id":"semetey-1-2013:p1312:b004:l024","ordinal":177394,"en":"He muttered without saying it openly,"},{"id":"semetey-1-2013:p1312:b004:l025","ordinal":177395,"en":"Seething behind them."},{"id":"semetey-1-2013:p1312:b004:l026","ordinal":177396,"en":"I will find the waist you have girded,"},{"id":"semetey-1-2013:p1312:b004:l027","ordinal":177397,"en":"Find the place where you lie entrenched,"},{"id":"semetey-1-2013:p1312:b004:l028","ordinal":177398,"en":"And destroy what you had before;"},{"id":"semetey-1-2013:p1312:b004:l029","ordinal":177399,"en":"I will unleash calamity upon you!"},{"id":"semetey-1-2013:p1312:b004:l030","ordinal":177400,"en":"I will set fire to your home;"},{"id":"semetey-1-2013:p1312:b004:l031","ordinal":177401,"en":"Brooding and waiting,"},{"id":"semetey-1-2013:p1312:b004:l032","ordinal":177402,"en":"My butcher, one day I will reach your end!"},{"id":"semetey-1-2013:p1312:b004:l033","ordinal":177403,"en":"I will break open your treasury;"},{"id":"semetey-1-2013:p1312:b004:l034","ordinal":177404,"en":"Upon Buurul whom you deny when asked,"},{"id":"semetey-1-2013:p1312:b004:l035","ordinal":177405,"en":"I will cast a cold lasso."},{"id":"semetey-1-2013:p1312:b004:l036","ordinal":177406,"en":"I will tighten your tether,"},{"id":"semetey-1-2013:p1312:b004:l037","ordinal":177407,"en":"And tirelessly load your burdens."},{"id":"semetey-1-2013:p1312:b004:l038","ordinal":177408,"en":"I will abandon you and get away,"}]
