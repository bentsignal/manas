[{"id":"semetey-1-2013:p1148:b004:l021","ordinal":163841,"en":"He had the dread of a thousand men."},{"id":"semetey-1-2013:p1148:b004:l022","ordinal":163842,"en":"Preparing his weapons and gear,"},{"id":"semetey-1-2013:p1148:b004:l023","ordinal":163843,"en":"If you saw your gray wolf,"},{"id":"semetey-1-2013:p1148:b004:l024","ordinal":163844,"en":"He raged like a blue tiger."},{"id":"semetey-1-2013:p1148:b004:l025","ordinal":163845,"en":"Making his dun horse prance,"},{"id":"semetey-1-2013:p1148:b004:l026","ordinal":163846,"en":"He split straight through the center"},{"id":"semetey-1-2013:p1148:b004:l027","ordinal":163847,"en":"Of the seething infidels."},{"id":"semetey-1-2013:p1148:b004:l028","ordinal":163848,"en":"Toward Zholoy and Ezkara,"},{"id":"semetey-1-2013:p1148:b004:l029","ordinal":163849,"en":"Those calamity-bringers,"},{"id":"semetey-1-2013:p1148:b004:l030","ordinal":163850,"en":"He turned his horse's head."},{"id":"semetey-1-2013:p1148:b004:l031","ordinal":163851,"en":"Khan Manas rode through"},{"id":"semetey-1-2013:p1148:b004:l032","ordinal":163852,"en":"And stood wrathfully"},{"id":"semetey-1-2013:p1148:b004:l033","ordinal":163853,"en":"Beside those two:"},{"id":"semetey-1-2013:p1148:b004:l034","ordinal":163854,"en":"“You assembled Chinese people,"},{"id":"semetey-1-2013:p1148:b004:l035","ordinal":163855,"en":"This is Kökötöy's feast."},{"id":"semetey-1-2013:p1148:b004:l036","ordinal":163856,"en":"The Burut are not a headless people;"},{"id":"semetey-1-2013:p1148:b004:l037","ordinal":163857,"en":"Gray-wolf Manas is their head!"},{"id":"semetey-1-2013:p1148:b004:l038","ordinal":163858,"en":"I honored you with an invitation;"},{"id":"semetey-1-2013:p1148:b004:l039","ordinal":163859,"en":"Eat your meat with honor."},{"id":"semetey-1-2013:p1149:b003:l001","ordinal":163860,"en":"You are not a Kalmyk who will take;"},{"id":"semetey-1-2013:p1149:b003:l002","ordinal":163861,"en":"I am not a Kyrgyz who will surrender."},{"id":"semetey-1-2013:p1149:b003:l003","ordinal":163862,"en":"You are not Chinese who will strike;"},{"id":"semetey-1-2013:p1149:b003:l004","ordinal":163863,"en":"I am not Kyrgyz who will be struck!"},{"id":"semetey-1-2013:p1149:b003:l005","ordinal":163864,"en":"Lay aside force and eat your feast, Chinese;"},{"id":"semetey-1-2013:p1149:b003:l006","ordinal":163865,"en":"Otherwise you will contend with me!"},{"id":"semetey-1-2013:p1149:b003:l007","ordinal":163866,"en":"Until the soft reeds ripen,"},{"id":"semetey-1-2013:p1149:b003:l008","ordinal":163867,"en":"Until the law's ashes fly,"},{"id":"semetey-1-2013:p1149:b003:l009","ordinal":163868,"en":"I will fight firmly for six months."},{"id":"semetey-1-2013:p1149:b003:l010","ordinal":163869,"en":"When I was twelve years old,"},{"id":"semetey-1-2013:p1149:b003:l011","ordinal":163870,"en":"Khan Zholoy of the Kalmyks,"},{"id":"semetey-1-2013:p1149:b003:l012","ordinal":163871,"en":"When you brought havoc upon Altai,"},{"id":"semetey-1-2013:p1149:b003:l013","ordinal":163872,"en":"I slaughtered six thousand of your men, Zholoy;"},{"id":"semetey-1-2013:p1149:b003:l014","ordinal":163873,"en":"I raided sixty of your villages,"},{"id":"semetey-1-2013:p1149:b003:l015","ordinal":163874,"en":"Zholoy."},{"id":"semetey-1-2013:p1149:b003:l016","ordinal":163875,"en":"When you gave your stubbornness free rein, Zholoy,"},{"id":"semetey-1-2013:p1149:b003:l017","ordinal":163876,"en":"When I captured your monk,"},{"id":"semetey-1-2013:p1149:b003:l018","ordinal":163877,"en":"When he would not speak,"},{"id":"semetey-1-2013:p1149:b003:l019","ordinal":163878,"en":"I cut off his kекес,"},{"id":"semetey-1-2013:p1149:b003:l020","ordinal":163879,"en":"When havoc arose yesterday,"},{"id":"semetey-1-2013:p1149:b003:l021","ordinal":163880,"en":"I was the one who went to battle."},{"id":"semetey-1-2013:p1149:b003:l022","ordinal":163881,"en":"Seizing it as plunder,"},{"id":"semetey-1-2013:p1149:b003:l023","ordinal":163882,"en":"I took a thousand camel-loads of your tea."},{"id":"semetey-1-2013:p1149:b003:l024","ordinal":163883,"en":"All thousand of your wrestlers"},{"id":"semetey-1-2013:p1149:b003:l025","ordinal":163884,"en":"I had slaughtered,"},{"id":"semetey-1-2013:p1149:b003:l026","ordinal":163885,"en":"Zholoy."},{"id":"semetey-1-2013:p1149:b003:l027","ordinal":163886,"en":"Have you become a man here, Zholoy?"},{"id":"semetey-1-2013:p1149:b003:l028","ordinal":163887,"en":"In the hollow of Ükürchü,"},{"id":"semetey-1-2013:p1149:b003:l029","ordinal":163888,"en":"Along Üch-Kapkak,"},{"id":"semetey-1-2013:p1149:b003:l030","ordinal":163889,"en":"I brought devastation."},{"id":"semetey-1-2013:p1149:b003:l031","ordinal":163890,"en":"Not only your horses—"},{"id":"semetey-1-2013:p1149:b003:l032","ordinal":163891,"en":"I seized your whole herd, Zholoy."},{"id":"semetey-1-2013:p1149:b003:l033","ordinal":163892,"en":"Have you only now become a man, Zholoy?"},{"id":"semetey-1-2013:p1149:b003:l034","ordinal":163893,"en":"Have you mounted a horse upright, Zholoy?"},{"id":"semetey-1-2013:p1149:b003:l035","ordinal":163894,"en":"I summoned you to my feast, Zholoy,"},{"id":"semetey-1-2013:p1149:b003:l036","ordinal":163895,"en":"But you launched an attack upon me!"},{"id":"semetey-1-2013:p1149:b003:l037","ordinal":163896,"en":"You became a guest at my feast, Zholoy,"},{"id":"semetey-1-2013:p1149:b003:l038","ordinal":163897,"en":"But brought humiliation upon my wishes."},{"id":"semetey-1-2013:p1149:b003:l039","ordinal":163898,"en":"I will fight without dying, Zholoy!"},{"id":"semetey-1-2013:p1149:b004:l001","ordinal":163899,"en":"Until the soft reeds ripen,"},{"id":"semetey-1-2013:p1149:b004:l002","ordinal":163900,"en":"Until the law's ashes fly,"},{"id":"semetey-1-2013:p1149:b004:l003","ordinal":163901,"en":"I will fight firmly for six months, Zholoy."},{"id":"semetey-1-2013:p1149:b004:l004","ordinal":163902,"en":"If you came to the feast, state your intent, Zholoy;"},{"id":"semetey-1-2013:p1149:b004:l005","ordinal":163903,"en":"If you mean to shoot, speak the truth,"},{"id":"semetey-1-2013:p1149:b004:l006","ordinal":163904,"en":"Zholoy."},{"id":"semetey-1-2013:p1149:b004:l007","ordinal":163905,"en":"If you mean to wrestle, give your answer,"},{"id":"semetey-1-2013:p1149:b004:l008","ordinal":163906,"en":"Zholoy!"},{"id":"semetey-1-2013:p1149:b004:l009","ordinal":163907,"en":"If we stand opposed,"},{"id":"semetey-1-2013:p1149:b004:l010","ordinal":163908,"en":"Firing guns and drawing bows,"},{"id":"semetey-1-2013:p1149:b004:l011","ordinal":163909,"en":"And fight with smashing blows,"},{"id":"semetey-1-2013:p1149:b004:l012","ordinal":163910,"en":"I will show a fearsome face;"},{"id":"semetey-1-2013:p1149:b004:l013","ordinal":163911,"en":"I will remain until we are spent,"},{"id":"semetey-1-2013:p1149:b004:l014","ordinal":163912,"en":"And fight to your very end."},{"id":"semetey-1-2013:p1149:b004:l015","ordinal":163913,"en":"I have armor no bullet pierces, Zholoy;"},{"id":"semetey-1-2013:p1149:b004:l016","ordinal":163914,"en":"I have a horse no bullet reaches, Zholoy."},{"id":"semetey-1-2013:p1149:b004:l017","ordinal":163915,"en":"You have your Kalcha Kongurbai, Zholoy;"},{"id":"semetey-1-2013:p1149:b004:l018","ordinal":163916,"en":"Let us fight in earnest."},{"id":"semetey-1-2013:p1149:b004:l019","ordinal":163917,"en":"How many khans have you who can fight, Zholoy?"},{"id":"semetey-1-2013:p1149:b004:l020","ordinal":163918,"en":"I learned your numbers long ago, Zholoy;"},{"id":"semetey-1-2013:p1149:b004:l021","ordinal":163919,"en":"I have long wished to meet you."},{"id":"semetey-1-2013:p1149:b004:l022","ordinal":163920,"en":"If you will shoot, state your true intent."},{"id":"semetey-1-2013:p1149:b004:l023","ordinal":163921,"en":"You are not a Kalmyk who can frighten me."},{"id":"semetey-1-2013:p1149:b004:l024","ordinal":163922,"en":"Turning your back, Zholoy,"},{"id":"semetey-1-2013:p1149:b004:l025","ordinal":163923,"en":"You have come to destroy each other!”"},{"id":"semetey-1-2013:p1149:b004:l026","ordinal":163924,"en":"When Manas displayed his wrath,"},{"id":"semetey-1-2013:p1149:b004:l027","ordinal":163925,"en":"Khan Manas and the Kalmyks"},{"id":"semetey-1-2013:p1149:b004:l028","ordinal":163926,"en":"Began to quarrel."},{"id":"semetey-1-2013:p1149:b004:l029","ordinal":163927,"en":"That was when I stood watching."},{"id":"semetey-1-2013:p1149:b004:l030","ordinal":163928,"en":"This will bring disaster upon you;"},{"id":"semetey-1-2013:p1149:b004:l031","ordinal":163929,"en":"I have said much—hear me, Kozho.”"},{"id":"semetey-1-2013:p1149:b004:l032","ordinal":163930,"en":"At Khan Kökötöy's memorial feast,"},{"id":"semetey-1-2013:p1149:b004:l033","ordinal":163931,"en":"Before the great gathering,"},{"id":"semetey-1-2013:p1149:b004:l034","ordinal":163932,"en":"I saw bloodthirsty Manas the leopard"},{"id":"semetey-1-2013:p1149:b004:l035","ordinal":163933,"en":"Protect the people."},{"id":"semetey-1-2013:p1149:b004:l036","ordinal":163934,"en":"I saw him drain"},{"id":"semetey-1-2013:p1149:b004:l037","ordinal":163935,"en":"The Black Chinese and Manchus."},{"id":"semetey-1-2013:p1149:b004:l038","ordinal":163936,"en":"How can you go to the son"},{"id":"semetey-1-2013:p1149:b004:l039","ordinal":163937,"en":"Of such a Manas,"},{"id":"semetey-1-2013:p1150:b003:l001","ordinal":163938,"en":"How can you take his bride?"},{"id":"semetey-1-2013:p1150:b003:l002","ordinal":163939,"en":"If you continue like this, my Kozho,"},{"id":"semetey-1-2013:p1150:b003:l003","ordinal":163940,"en":"You will fall into calamity!"},{"id":"semetey-1-2013:p1150:b003:l004","ordinal":163941,"en":"When bloodthirsty Manas the leopard"},{"id":"semetey-1-2013:p1150:b003:l005","ordinal":163942,"en":"Found the Black Kalmyks and Manchus"},{"id":"semetey-1-2013:p1150:b003:l006","ordinal":163943,"en":"Lying there in arrogance,"},{"id":"semetey-1-2013:p1150:b003:l007","ordinal":163944,"en":"Letting them plunder meat from the hearths"},{"id":"semetey-1-2013:p1150:b003:l008","ordinal":163945,"en":"And beat many Kalmyks with pokers,"},{"id":"semetey-1-2013:p1150:b003:l009","ordinal":163946,"en":"Baymyrza came like a khan,"},{"id":"semetey-1-2013:p1150:b003:l010","ordinal":163947,"en":"In turmoil and dust."},{"id":"semetey-1-2013:p1150:b003:l011","ordinal":163948,"en":"“Do as you please, even if you slaughter them,"},{"id":"semetey-1-2013:p1150:b003:l012","ordinal":163949,"en":"Alas, Manas, as your heart desires!”"},{"id":"semetey-1-2013:p1150:b003:l013","ordinal":163950,"en":"Baymyrza stood and said this:"},{"id":"semetey-1-2013:p1150:b003:l014","ordinal":163951,"en":"“We held Khan Kökötöy's feast, Manas;"},{"id":"semetey-1-2013:p1150:b003:l015","ordinal":163952,"en":"We held a feast mixed with turmoil, Manas!"},{"id":"semetey-1-2013:p1150:b003:l016","ordinal":163953,"en":"We alarmed many and gathered the people;"},{"id":"semetey-1-2013:p1150:b003:l017","ordinal":163954,"en":"We have caused excessive suffering, Manas!"},{"id":"semetey-1-2013:p1150:b003:l018","ordinal":163955,"en":"In the eyes of the Black Kalmyks and Manchus"},{"id":"semetey-1-2013:p1150:b003:l019","ordinal":163956,"en":"There was a hostile glare."},{"id":"semetey-1-2013:p1150:b003:l020","ordinal":163957,"en":"If these dogs have the strength,"},{"id":"semetey-1-2013:p1150:b003:l021","ordinal":163958,"en":"They are ready to strike me."},{"id":"semetey-1-2013:p1150:b003:l022","ordinal":163959,"en":"They brought turmoil upon my feast"},{"id":"semetey-1-2013:p1150:b003:l023","ordinal":163960,"en":"And hell upon my mind."},{"id":"semetey-1-2013:p1150:b003:l024","ordinal":163961,"en":"Fed full on meat, they went mad"},{"id":"semetey-1-2013:p1150:b003:l025","ordinal":163962,"en":"And grew eager to attack."},{"id":"semetey-1-2013:p1150:b004:l001","ordinal":163963,"en":"How could my wretched head escape"},{"id":"semetey-1-2013:p1150:b004:l002","ordinal":163964,"en":"The seething infidels?"},{"id":"semetey-1-2013:p1150:b004:l003","ordinal":163965,"en":"Perhaps they will bind our heroes;"},{"id":"semetey-1-2013:p1150:b004:l004","ordinal":163966,"en":"These infidels, like a flood,"},{"id":"semetey-1-2013:p1150:b004:l005","ordinal":163967,"en":"May bring hell upon our heads."},{"id":"semetey-1-2013:p1150:b004:l006","ordinal":163968,"en":"Perhaps they will do as they please"},{"id":"semetey-1-2013:p1150:b004:l007","ordinal":163969,"en":"And slaughter every soul."},{"id":"semetey-1-2013:p1150:b004:l008","ordinal":163970,"en":"They seized the hearths"},{"id":"semetey-1-2013:p1150:b004:l009","ordinal":163971,"en":"And set out causing turmoil.”"},{"id":"semetey-1-2013:p1150:b004:l010","ordinal":163972,"en":"While Baymyrza spoke,"},{"id":"semetey-1-2013:p1150:b004:l011","ordinal":163973,"en":"Baymyrza, the rich man's son,"},{"id":"semetey-1-2013:p1150:b004:l012","ordinal":163974,"en":"Lost heart."},{"id":"semetey-1-2013:p1150:b004:l013","ordinal":163975,"en":"His eyes darted wildly;"},{"id":"semetey-1-2013:p1150:b004:l014","ordinal":163976,"en":"His joints went limp."},{"id":"semetey-1-2013:p1150:b004:l015","ordinal":163977,"en":"Baymyrza fled in grief;"},{"id":"semetey-1-2013:p1150:b004:l016","ordinal":163978,"en":"Suffering pressure from the infidels,"},{"id":"semetey-1-2013:p1150:b004:l017","ordinal":163979,"en":"He despaired of his entrusted life"},{"id":"semetey-1-2013:p1150:b004:l018","ordinal":163980,"en":"And ran toward Manas,"},{"id":"semetey-1-2013:p1150:b004:l019","ordinal":163981,"en":"Hoping there might be a way."},{"id":"semetey-1-2013:p1150:b004:l020","ordinal":163982,"en":"Seeing this, mighty Manas—"},{"id":"semetey-1-2013:p1150:b004:l021","ordinal":163983,"en":"Mighty Manas, who had never suffered humiliation,"},{"id":"semetey-1-2013:p1150:b004:l022","ordinal":163984,"en":"Saw a dreadful sight"},{"id":"semetey-1-2013:p1150:b004:l023","ordinal":163985,"en":"When his people came weeping;"},{"id":"semetey-1-2013:p1150:b004:l024","ordinal":163986,"en":"Mighty Manas suffered humiliation"},{"id":"semetey-1-2013:p1150:b004:l025","ordinal":163987,"en":"From the Black Chinese and Manchus."},{"id":"semetey-1-2013:p1150:b006:l001","ordinal":163988,"en":"“Rather than see this humiliation,"},{"id":"semetey-1-2013:p1150:b006:l002","ordinal":163989,"en":"May I sink away unborn;"},{"id":"semetey-1-2013:p1150:b006:l003","ordinal":163990,"en":"Rather than this, may I die and not live."},{"id":"semetey-1-2013:p1150:b006:l004","ordinal":163991,"en":"Let me witness this humiliation"},{"id":"semetey-1-2013:p1150:b006:l005","ordinal":163992,"en":"From the seething Chinese and Manchus."},{"id":"semetey-1-2013:p1150:b006:l006","ordinal":163993,"en":"Bring Aybanboz; I will mount him."},{"id":"semetey-1-2013:p1150:b006:l007","ordinal":163994,"en":"I will drive the seething Chinese"},{"id":"semetey-1-2013:p1150:b006:l008","ordinal":163995,"en":"As far as Kakan.”"},{"id":"semetey-1-2013:p1150:b006:l009","ordinal":163996,"en":"Thus brave Manas spoke."},{"id":"semetey-1-2013:p1150:b007:l001","ordinal":163997,"en":"His eyes flashed like fire;"},{"id":"semetey-1-2013:p1150:b007:l002","ordinal":163998,"en":"His thirst for blood truly seized him."},{"id":"semetey-1-2013:p1150:b007:l003","ordinal":163999,"en":"When he advanced in earnest,"},{"id":"semetey-1-2013:p1150:b007:l004","ordinal":164000,"en":"Venom poured from his face"},{"id":"semetey-1-2013:p1150:b007:l005","ordinal":164001,"en":"And his heroic form appeared."},{"id":"semetey-1-2013:p1150:b007:l006","ordinal":164002,"en":"“Golden-cheeked battle-ax—"},{"id":"semetey-1-2013:p1150:b007:l007","ordinal":164003,"en":"You have come seeking a fight."},{"id":"semetey-1-2013:p1150:b007:l008","ordinal":164004,"en":"Great Kalcha, huge as a yurt,"},{"id":"semetey-1-2013:p1150:b007:l009","ordinal":164005,"en":"The people you beat are of another kind."}]
