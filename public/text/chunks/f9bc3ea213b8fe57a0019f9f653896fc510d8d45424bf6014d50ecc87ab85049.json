[{"id":"semetey-1-2013:p1085:b003:l031","ordinal":158977,"en":"And kept flogging him."},{"id":"semetey-1-2013:p1085:b003:l032","ordinal":158978,"en":"Such were Alööke's deeds:"},{"id":"semetey-1-2013:p1085:b003:l033","ordinal":158979,"en":"When anyone went to Alööke,"},{"id":"semetey-1-2013:p1085:b003:l034","ordinal":158980,"en":"Every person who went"},{"id":"semetey-1-2013:p1085:b003:l035","ordinal":158981,"en":"Paid homage and bowed."},{"id":"semetey-1-2013:p1085:b003:l036","ordinal":158982,"en":"Alööke's deeds"},{"id":"semetey-1-2013:p1085:b003:l037","ordinal":158983,"en":"Became clearly known"},{"id":"semetey-1-2013:p1085:b003:l038","ordinal":158984,"en":"To magnanimous Sultan Manas."},{"id":"semetey-1-2013:p1085:b003:l039","ordinal":158985,"en":"With Khan Bakai and Manas at their head,"},{"id":"semetey-1-2013:p1085:b004:l001","ordinal":158986,"en":"When they launched an assault"},{"id":"semetey-1-2013:p1085:b004:l002","ordinal":158987,"en":"Against Alööke,"},{"id":"semetey-1-2013:p1085:b004:l003","ordinal":158988,"en":"And heard reports from those who came,"},{"id":"semetey-1-2013:p1085:b004:l004","ordinal":158989,"en":"Brave Manas went to meet him"},{"id":"semetey-1-2013:p1085:b004:l005","ordinal":158990,"en":"And, they heard, burned everything down."},{"id":"semetey-1-2013:p1085:b004:l006","ordinal":158991,"en":"All his possessions were scattered;"},{"id":"semetey-1-2013:p1085:b004:l007","ordinal":158992,"en":"Scorched by the fire, Alööke"},{"id":"semetey-1-2013:p1085:b004:l008","ordinal":158993,"en":"Fled toward Beijing."},{"id":"semetey-1-2013:p1085:b004:l009","ordinal":158994,"en":"From where he settled, Alööke"},{"id":"semetey-1-2013:p1085:b004:l010","ordinal":158995,"en":"Overran broad Kashgar."},{"id":"semetey-1-2013:p1085:b004:l011","ordinal":158996,"en":"When he reached Great Aksy"},{"id":"semetey-1-2013:p1085:b004:l012","ordinal":158997,"en":"And crossed Kum-Aryk,"},{"id":"semetey-1-2013:p1085:b004:l013","ordinal":158998,"en":"At the edge of broad Ak-Chiy,"},{"id":"semetey-1-2013:p1085:b004:l014","ordinal":158999,"en":"Alööke posted his sentries"},{"id":"semetey-1-2013:p1085:b004:l015","ordinal":159000,"en":"And made camp."},{"id":"semetey-1-2013:p1085:b004:l016","ordinal":159001,"en":"Brave Manas bore down on him"},{"id":"semetey-1-2013:p1085:b004:l017","ordinal":159002,"en":"From above"},{"id":"semetey-1-2013:p1085:b004:l018","ordinal":159003,"en":"And scattered all four kinds of his livestock."},{"id":"semetey-1-2013:p1085:b004:l019","ordinal":159004,"en":"He caught up with him and seized him,"},{"id":"semetey-1-2013:p1085:b004:l020","ordinal":159005,"en":"And slaughtered him as a sacrifice."},{"id":"semetey-1-2013:p1085:b004:l021","ordinal":159006,"en":"Saying, “Manas slaughtered my father,”"},{"id":"semetey-1-2013:p1085:b004:l022","ordinal":159007,"en":"Alööke's son Kongurbai"},{"id":"semetey-1-2013:p1085:b004:l023","ordinal":159008,"en":"Came to bear a grudge"},{"id":"semetey-1-2013:p1085:b004:l024","ordinal":159009,"en":"Against noble, magnanimous Manas."},{"id":"semetey-1-2013:p1085:b004:l025","ordinal":159010,"en":"Manas was such a hero:"},{"id":"semetey-1-2013:p1085:b004:l026","ordinal":159011,"en":"For the mere handful of Muslims,"},{"id":"semetey-1-2013:p1085:b004:l027","ordinal":159012,"en":"Magnanimous Manas the leopard"},{"id":"semetey-1-2013:p1085:b004:l028","ordinal":159013,"en":"Was a fortress that protected them."},{"id":"semetey-1-2013:p1085:b004:l029","ordinal":159014,"en":"What twelve ages had never wrought,"},{"id":"semetey-1-2013:p1085:b004:l030","ordinal":159015,"en":"Ruining Sultan Manas did;"},{"id":"semetey-1-2013:p1085:b004:l031","ordinal":159016,"en":"In that bygone age,"},{"id":"semetey-1-2013:p1085:b004:l032","ordinal":159017,"en":"Not a stick for a horse-catching pole remained."},{"id":"semetey-1-2013:p1085:b004:l033","ordinal":159018,"en":"Manas was such a hero;"},{"id":"semetey-1-2013:p1085:b004:l034","ordinal":159019,"en":"His fortune was complete."},{"id":"semetey-1-2013:p1085:b004:l035","ordinal":159020,"en":"When one looked within him,"},{"id":"semetey-1-2013:p1085:b004:l036","ordinal":159021,"en":"He was broader than the face of the earth."},{"id":"semetey-1-2013:p1085:b004:l037","ordinal":159022,"en":"A hero like Manas,"},{"id":"semetey-1-2013:p1085:b004:l038","ordinal":159023,"en":"For the Muslim people—"},{"id":"semetey-1-2013:p1086:b003:l001","ordinal":159024,"en":"The Creator would surely never grant another."},{"id":"semetey-1-2013:p1086:b003:l002","ordinal":159025,"en":"Where the racehorse Akkula had not trodden,"},{"id":"semetey-1-2013:p1086:b003:l003","ordinal":159026,"en":"Nothing on earth remained whole."},{"id":"semetey-1-2013:p1086:b003:l004","ordinal":159027,"en":"Where Manas's hand had not reached,"},{"id":"semetey-1-2013:p1086:b003:l005","ordinal":159028,"en":"No people remained whole."},{"id":"semetey-1-2013:p1086:b003:l006","ordinal":159029,"en":"Was it not Manas whose every deed"},{"id":"semetey-1-2013:p1086:b003:l007","ordinal":159030,"en":"Pleased mortal men?"},{"id":"semetey-1-2013:p1086:b003:l008","ordinal":159031,"en":"Did Manas not raise"},{"id":"semetey-1-2013:p1086:b003:l009","ordinal":159032,"en":"The tiny band of Muslims"},{"id":"semetey-1-2013:p1086:b003:l010","ordinal":159033,"en":"Among infidels of another father?"},{"id":"semetey-1-2013:p1086:b003:l011","ordinal":159034,"en":"The one he pinched was Bakburchun;"},{"id":"semetey-1-2013:p1086:b004:l001","ordinal":159035,"en":"The foe he fought in earnest was Kakan-Chyn."},{"id":"semetey-1-2013:p1086:b004:l002","ordinal":159036,"en":"When many saints spread their hands in prayer,"},{"id":"semetey-1-2013:p1086:b004:l003","ordinal":159037,"en":"Hero Manas was their blessing."},{"id":"semetey-1-2013:p1086:b004:l004","ordinal":159038,"en":"When the Chinese swept over the land,"},{"id":"semetey-1-2013:p1086:b004:l005","ordinal":159039,"en":"To the Muslim people"},{"id":"semetey-1-2013:p1086:b004:l006","ordinal":159040,"en":"Hero Manas was a father."},{"id":"semetey-1-2013:p1086:b004:l007","ordinal":159041,"en":"He was called the hero Manas;"},{"id":"semetey-1-2013:p1086:b004:l008","ordinal":159042,"en":"I have seen what he was"},{"id":"semetey-1-2013:p1086:b004:l009","ordinal":159043,"en":"Upon the face of the world."},{"id":"semetey-1-2013:p1086:b004:l010","ordinal":159044,"en":"I have seen that he was a fortress"},{"id":"semetey-1-2013:p1086:b004:l011","ordinal":159045,"en":"Through which no wind reached the Muslims."},{"id":"semetey-1-2013:p1086:b006:l001","ordinal":159046,"en":"Yesterday—was there such a deed in your tidings?"},{"id":"semetey-1-2013:p1086:b006:l002","ordinal":159047,"en":"Dear Kozho, listen!"},{"id":"semetey-1-2013:p1086:b006:l003","ordinal":159048,"en":"Yesterday, at Kökötöy's funeral feast,"},{"id":"semetey-1-2013:p1086:b006:l004","ordinal":159049,"en":"Before the great gathering,"},{"id":"semetey-1-2013:p1086:b006:l005","ordinal":159050,"en":"Koshoy went, and I went."},{"id":"semetey-1-2013:p1086:b006:l006","ordinal":159051,"en":"Chynkozho, son of Shygay,"},{"id":"semetey-1-2013:p1086:b006:l007","ordinal":159052,"en":"When did you go with them?"},{"id":"semetey-1-2013:p1086:b006:l008","ordinal":159053,"en":"Yesterday, when Khan Kökötöy passed away,"},{"id":"semetey-1-2013:p1086:b006:l009","ordinal":159054,"en":"When he went without turning back"},{"id":"semetey-1-2013:p1086:b006:l010","ordinal":159055,"en":"To the land from which none return,"},{"id":"semetey-1-2013:p1086:b006:l011","ordinal":159056,"en":"There was a man named Kökötöy;"},{"id":"semetey-1-2013:p1086:b006:l012","ordinal":159057,"en":"In the world, Kökötöy"},{"id":"semetey-1-2013:p1086:b006:l013","ordinal":159058,"en":"Had been a wealthy pillar."},{"id":"semetey-1-2013:p1086:b006:l014","ordinal":159059,"en":"He was a rich man dwelling"},{"id":"semetey-1-2013:p1086:b006:l015","ordinal":159060,"en":"In old Tashken and Chyyrchyk."},{"id":"semetey-1-2013:p1086:b006:l016","ordinal":159061,"en":"Of all the peoples of the age"},{"id":"semetey-1-2013:p1086:b006:l017","ordinal":159062,"en":"That ears had heard and eyes had seen,"},{"id":"semetey-1-2013:p1086:b006:l018","ordinal":159063,"en":"Kökötöy was the wealthiest."},{"id":"semetey-1-2013:p1086:b006:l019","ordinal":159064,"en":"He was a khan with forty rooms"},{"id":"semetey-1-2013:p1086:b006:l020","ordinal":159065,"en":"Filled with red coins and yellow gold."},{"id":"semetey-1-2013:p1086:b006:l021","ordinal":159066,"en":"So there was one named Kökötöy."},{"id":"semetey-1-2013:p1086:b006:l022","ordinal":159067,"en":"To all four quarters,"},{"id":"semetey-1-2013:p1086:b007:l001","ordinal":159068,"en":"Kökötöy's wealth"},{"id":"semetey-1-2013:p1086:b007:l002","ordinal":159069,"en":"Spread and brimmed like a lake."},{"id":"semetey-1-2013:p1086:b007:l003","ordinal":159070,"en":"He tended all four kinds of livestock;"},{"id":"semetey-1-2013:p1086:b007:l004","ordinal":159071,"en":"Upon the hairy-breasted black earth,"},{"id":"semetey-1-2013:p1086:b007:l005","ordinal":159072,"en":"Kökötöy's worldly herds"},{"id":"semetey-1-2013:p1086:b007:l006","ordinal":159073,"en":"Had sprung from the strongest stock."},{"id":"semetey-1-2013:p1086:b007:l007","ordinal":159074,"en":"Kökötöy, father of the people,"},{"id":"semetey-1-2013:p1086:b007:l008","ordinal":159075,"en":"Had grown very old;"},{"id":"semetey-1-2013:p1086:b007:l009","ordinal":159076,"en":"His wealth was complete,"},{"id":"semetey-1-2013:p1086:b007:l010","ordinal":159077,"en":"Yet Kökötöy, father of the people,"},{"id":"semetey-1-2013:p1086:b007:l011","ordinal":159078,"en":"Had remained childless."},{"id":"semetey-1-2013:p1086:b007:l012","ordinal":159079,"en":"Trusting in his wealth, Kökötöy"},{"id":"semetey-1-2013:p1086:b007:l013","ordinal":159080,"en":"Had taken seven wives;"},{"id":"semetey-1-2013:p1086:b007:l014","ordinal":159081,"en":"Until he reached seventy-five,"},{"id":"semetey-1-2013:p1086:b007:l015","ordinal":159082,"en":"He had remained without seeing a child."},{"id":"semetey-1-2013:p1086:b007:l016","ordinal":159083,"en":"When he reached seventy-five,"},{"id":"semetey-1-2013:p1086:b007:l017","ordinal":159084,"en":"He took seventy young men as attendants,"},{"id":"semetey-1-2013:p1086:b007:l018","ordinal":159085,"en":"Hunting wild asses and pursuing gazelles,"},{"id":"semetey-1-2013:p1086:b007:l019","ordinal":159086,"en":"And went on a great hunt."},{"id":"semetey-1-2013:p1086:b007:l020","ordinal":159087,"en":"As he journeyed on his travels,"},{"id":"semetey-1-2013:p1086:b007:l021","ordinal":159088,"en":"From Kayypchy's ridge,"},{"id":"semetey-1-2013:p1086:b007:l022","ordinal":159089,"en":"From the desert of Mediyan,"},{"id":"semetey-1-2013:p1087:b003:l001","ordinal":159090,"en":"Bokmurun, who gave the feast,"},{"id":"semetey-1-2013:p1087:b003:l002","ordinal":159091,"en":"Was found out on the steppe."},{"id":"semetey-1-2013:p1087:b003:l003","ordinal":159092,"en":"For the child he had found,"},{"id":"semetey-1-2013:p1087:b003:l004","ordinal":159093,"en":"He slaughtered nine thousand mares."},{"id":"semetey-1-2013:p1087:b003:l005","ordinal":159094,"en":"The four corners of the world,"},{"id":"semetey-1-2013:p1087:b003:l006","ordinal":159095,"en":"The forty corners of the qibla,"},{"id":"semetey-1-2013:p1087:b003:l007","ordinal":159096,"en":"Kökötöy gathered together;"},{"id":"semetey-1-2013:p1087:b003:l008","ordinal":159097,"en":"At Kökötöy's feast,"},{"id":"semetey-1-2013:p1087:b003:l009","ordinal":159098,"en":"Everyone who came ate his fill."},{"id":"semetey-1-2013:p1087:b003:l010","ordinal":159099,"en":"The great multitude that came to the feast"},{"id":"semetey-1-2013:p1087:b003:l011","ordinal":159100,"en":"Came to the feast and ate its fill."},{"id":"semetey-1-2013:p1087:b003:l012","ordinal":159101,"en":"After he had eaten his fill,"},{"id":"semetey-1-2013:p1087:b003:l013","ordinal":159102,"en":"They named him Bokmurun."},{"id":"semetey-1-2013:p1087:b003:l014","ordinal":159103,"en":"Thus Bokmurun"},{"id":"semetey-1-2013:p1087:b003:l015","ordinal":159104,"en":"Became Kökötöy's son."},{"id":"semetey-1-2013:p1087:b003:l016","ordinal":159105,"en":"Until he reached six years of age,"},{"id":"semetey-1-2013:p1087:b003:l017","ordinal":159106,"en":"What did wealthy Kökötöy do?"},{"id":"semetey-1-2013:p1087:b003:l018","ordinal":159107,"en":"Upon the child's head"},{"id":"semetey-1-2013:p1087:b003:l019","ordinal":159108,"en":"He fastened a waving owl-feather plume."},{"id":"semetey-1-2013:p1087:b003:l020","ordinal":159109,"en":"Kökötöy's seven wives"},{"id":"semetey-1-2013:p1087:b003:l021","ordinal":159110,"en":"Led the child about and raised him."},{"id":"semetey-1-2013:p1087:b003:l022","ordinal":159111,"en":"For Bokmurun, Kökötöy's"},{"id":"semetey-1-2013:p1087:b003:l023","ordinal":159112,"en":"Heart melted with affection;"},{"id":"semetey-1-2013:p1087:b003:l024","ordinal":159113,"en":"But in truth this Bokmurun"},{"id":"semetey-1-2013:p1087:b003:l025","ordinal":159114,"en":"Was the son of Er Töshtük."},{"id":"semetey-1-2013:p1087:b003:l026","ordinal":159115,"en":"His spoiling was extreme."},{"id":"semetey-1-2013:p1087:b003:l027","ordinal":159116,"en":"While Bokmurun slept,"},{"id":"semetey-1-2013:p1087:b003:l028","ordinal":159117,"en":"Each morning Kökötöy"},{"id":"semetey-1-2013:p1087:b003:l029","ordinal":159118,"en":"Would open the treasury,"},{"id":"semetey-1-2013:p1087:b003:l030","ordinal":159119,"en":"And as a sacrifice for him,"},{"id":"semetey-1-2013:p1087:b003:l031","ordinal":159120,"en":"Would bring out red gold and white silver"},{"id":"semetey-1-2013:p1087:b003:l032","ordinal":159121,"en":"And scatter it like seed"},{"id":"semetey-1-2013:p1087:b003:l033","ordinal":159122,"en":"Across whole provinces."},{"id":"semetey-1-2013:p1087:b003:l034","ordinal":159123,"en":"On every side, Kökötöy,"},{"id":"semetey-1-2013:p1087:b003:l035","ordinal":159124,"en":"Saying, \"Someone may do him harm,\""},{"id":"semetey-1-2013:p1087:b003:l036","ordinal":159125,"en":"Would set a strong guard."},{"id":"semetey-1-2013:p1087:b003:l037","ordinal":159126,"en":"For every day he passed the night unharmed,"},{"id":"semetey-1-2013:p1087:b003:l038","ordinal":159127,"en":"Six wethers and four kids"},{"id":"semetey-1-2013:p1087:b003:l039","ordinal":159128,"en":"Would be slaughtered as a sacrifice."},{"id":"semetey-1-2013:p1087:b004:l001","ordinal":159129,"en":"So great was the care with which he raised him;"},{"id":"semetey-1-2013:p1087:b004:l002","ordinal":159130,"en":"At twelve, Bokmurun"},{"id":"semetey-1-2013:p1087:b004:l003","ordinal":159131,"en":"Was Kökötöy's son."},{"id":"semetey-1-2013:p1087:b004:l004","ordinal":159132,"en":"Growing up this way and that,"},{"id":"semetey-1-2013:p1087:b004:l005","ordinal":159133,"en":"His daily affairs prospered."},{"id":"semetey-1-2013:p1087:b004:l006","ordinal":159134,"en":"When Kökötöy's Bokmurun"},{"id":"semetey-1-2013:p1087:b004:l007","ordinal":159135,"en":"Reached twelve years of age,"},{"id":"semetey-1-2013:p1087:b004:l008","ordinal":159136,"en":"He became a blazing ember,"},{"id":"semetey-1-2013:p1087:b004:l009","ordinal":159137,"en":"And wealthy Kökötöy's son"},{"id":"semetey-1-2013:p1087:b004:l010","ordinal":159138,"en":"Became a mischief-maker unmatched in the world."},{"id":"semetey-1-2013:p1087:b004:l011","ordinal":159139,"en":"Kökötöy's Bokmurun"},{"id":"semetey-1-2013:p1087:b004:l012","ordinal":159140,"en":"Found no mountain to strike,"},{"id":"semetey-1-2013:p1087:b004:l013","ordinal":159141,"en":"Found no enemy to fight;"},{"id":"semetey-1-2013:p1087:b004:l014","ordinal":159142,"en":"He had merchants beaten,"},{"id":"semetey-1-2013:p1087:b004:l015","ordinal":159143,"en":"And caravan men imprisoned."},{"id":"semetey-1-2013:p1087:b004:l016","ordinal":159144,"en":"Wherever his hand could reach,"},{"id":"semetey-1-2013:p1087:b004:l017","ordinal":159145,"en":"He had plunder seized,"},{"id":"semetey-1-2013:p1087:b004:l018","ordinal":159146,"en":"And caused much disorder."},{"id":"semetey-1-2013:p1087:b004:l019","ordinal":159147,"en":"He ate barren yearling mares,"},{"id":"semetey-1-2013:p1087:b004:l020","ordinal":159148,"en":"And ate frozen goat fat;"},{"id":"semetey-1-2013:p1087:b004:l021","ordinal":159149,"en":"Bokmurun had grown wanton."},{"id":"semetey-1-2013:p1087:b004:l022","ordinal":159150,"en":"\"They say my father Kökötöy's"},{"id":"semetey-1-2013:p1087:b004:l023","ordinal":159151,"en":"Wealth has been seen by the whole age;"},{"id":"semetey-1-2013:p1087:b004:l024","ordinal":159152,"en":"They say Kökötöy's vast riches"},{"id":"semetey-1-2013:p1087:b004:l025","ordinal":159153,"en":"Will die like grass in spring."},{"id":"semetey-1-2013:p1087:b004:l026","ordinal":159154,"en":"They say this world is worthless;"},{"id":"semetey-1-2013:p1087:b004:l027","ordinal":159155,"en":"Why should I keep tending"},{"id":"semetey-1-2013:p1087:b004:l028","ordinal":159156,"en":"Great herds that bring no benefit?"},{"id":"semetey-1-2013:p1087:b004:l029","ordinal":159157,"en":"Even if I lose a great deal of livestock,"},{"id":"semetey-1-2013:p1087:b004:l030","ordinal":159158,"en":"My dear father's vast riches"},{"id":"semetey-1-2013:p1087:b004:l031","ordinal":159159,"en":"Will last me until I die,\" he said."},{"id":"semetey-1-2013:p1087:b004:l032","ordinal":159160,"en":"Such were Bokmurun's deeds:"},{"id":"semetey-1-2013:p1087:b004:l033","ordinal":159161,"en":"Making their fangs protrude,"},{"id":"semetey-1-2013:p1087:b004:l034","ordinal":159162,"en":"Making their lower lips hang,"},{"id":"semetey-1-2013:p1087:b004:l035","ordinal":159163,"en":"Making their humps stand high,"},{"id":"semetey-1-2013:p1087:b004:l036","ordinal":159164,"en":"He had a thousand male camels saddled,"},{"id":"semetey-1-2013:p1087:b004:l037","ordinal":159165,"en":"Had all their coverings put in order,"},{"id":"semetey-1-2013:p1087:b004:l038","ordinal":159166,"en":"Had them drawn along with ropes,"},{"id":"semetey-1-2013:p1087:b004:l039","ordinal":159167,"en":"And loaded with riches of red gold."},{"id":"semetey-1-2013:p1088:b003:l001","ordinal":159168,"en":"He had them splendidly loaded,"},{"id":"semetey-1-2013:p1088:b003:l002","ordinal":159169,"en":"Had their necks rubbed raw,"},{"id":"semetey-1-2013:p1088:b003:l003","ordinal":159170,"en":"And sent them roaming over the whole world;"},{"id":"semetey-1-2013:p1088:b003:l004","ordinal":159171,"en":"He would survey the face of the earth."},{"id":"semetey-1-2013:p1088:b003:l005","ordinal":159172,"en":"Growing tyrannical, Bokmurun"},{"id":"semetey-1-2013:p1088:b003:l006","ordinal":159173,"en":"Would have maidens sought for him."},{"id":"semetey-1-2013:p1088:b003:l007","ordinal":159174,"en":"Traveling among the common people,"},{"id":"semetey-1-2013:p1088:b003:l008","ordinal":159175,"en":"He would look upon dark-eyed maidens."},{"id":"semetey-1-2013:p1088:b003:l009","ordinal":159176,"en":"Whether or not he liked the girl,"},{"id":"semetey-1-2013:p1088:b003:l010","ordinal":159177,"en":"He would give her father"},{"id":"semetey-1-2013:p1088:b003:l011","ordinal":159178,"en":"A camel-load of gold."},{"id":"semetey-1-2013:p1088:b003:l012","ordinal":159179,"en":"Of all that ears had heard and eyes had seen,"},{"id":"semetey-1-2013:p1088:b003:l013","ordinal":159180,"en":"His fame thundered abroad,"},{"id":"semetey-1-2013:p1088:b003:l014","ordinal":159181,"en":"And they called Bokmurun a manap."},{"id":"semetey-1-2013:p1088:b003:l015","ordinal":159182,"en":"Though still a child, Bokmurun"},{"id":"semetey-1-2013:p1088:b003:l016","ordinal":159183,"en":"Had livestock led wherever he went;"},{"id":"semetey-1-2013:p1088:b003:l017","ordinal":159184,"en":"Roaming through many cities,"},{"id":"semetey-1-2013:p1088:b003:l018","ordinal":159185,"en":"He overran many peoples,"},{"id":"semetey-1-2013:p1088:b003:l019","ordinal":159186,"en":"And squandered and scattered"},{"id":"semetey-1-2013:p1088:b003:l020","ordinal":159187,"en":"All his great wealth."},{"id":"semetey-1-2013:p1088:b003:l021","ordinal":159188,"en":"When Kökötöy's Bokmurun"},{"id":"semetey-1-2013:p1088:b003:l022","ordinal":159189,"en":"Mounted Maaniker,"},{"id":"semetey-1-2013:p1088:b003:l023","ordinal":159190,"en":"He traveled four circuits"},{"id":"semetey-1-2013:p1088:b003:l024","ordinal":159191,"en":"Around the world's four corners."},{"id":"semetey-1-2013:p1088:b003:l025","ordinal":159192,"en":"When he went seeking a wife,"},{"id":"semetey-1-2013:p1088:b003:l026","ordinal":159193,"en":"When he traversed many lands,"},{"id":"semetey-1-2013:p1088:b003:l027","ordinal":159194,"en":"When he squandered and scattered"},{"id":"semetey-1-2013:p1088:b003:l028","ordinal":159195,"en":"Great wealth and countless herds,"},{"id":"semetey-1-2013:p1088:b003:l029","ordinal":159196,"en":"When he mounted the wind-surpassing horse"},{"id":"semetey-1-2013:p1088:b003:l030","ordinal":159197,"en":"And went seeking a wife,"},{"id":"semetey-1-2013:p1088:b003:l031","ordinal":159198,"en":"Khan Kökötöy died."},{"id":"semetey-1-2013:p1088:b003:l032","ordinal":159199,"en":"As Kökötöy lay dead,"},{"id":"semetey-1-2013:p1088:b003:l033","ordinal":159200,"en":"Bokmurun returned."},{"id":"semetey-1-2013:p1088:b003:l034","ordinal":159201,"en":"\"My khan-father has died,\" he said,"},{"id":"semetey-1-2013:p1088:b003:l035","ordinal":159202,"en":"And summoned the great men,"},{"id":"semetey-1-2013:p1088:b003:l036","ordinal":159203,"en":"The troublemakers among the people."},{"id":"semetey-1-2013:p1088:b003:l037","ordinal":159204,"en":"\"My dear father has died,\" he cried,"},{"id":"semetey-1-2013:p1088:b003:l038","ordinal":159205,"en":"Wailing in grief,"},{"id":"semetey-1-2013:p1088:b003:l039","ordinal":159206,"en":"And summoned all the people"},{"id":"semetey-1-2013:p1088:b004:l001","ordinal":159207,"en":"To his mourning feast."},{"id":"semetey-1-2013:p1088:b004:l002","ordinal":159208,"en":"He had the finest racehorses tethered,"},{"id":"semetey-1-2013:p1088:b004:l003","ordinal":159209,"en":"And had countless khojas and ishans"},{"id":"semetey-1-2013:p1088:b004:l004","ordinal":159210,"en":"Driven there by force,"},{"id":"semetey-1-2013:p1088:b004:l005","ordinal":159211,"en":"Saying, \"Let them come receive their share.\""},{"id":"semetey-1-2013:p1088:b004:l006","ordinal":159212,"en":"He made their camel calves cry out;"},{"id":"semetey-1-2013:p1088:b004:l007","ordinal":159213,"en":"Saying, \"The mourning feast of Khan Kökötöy,\""},{"id":"semetey-1-2013:p1088:b004:l008","ordinal":159214,"en":"He had gray cattle slaughtered,"},{"id":"semetey-1-2013:p1088:b004:l009","ordinal":159215,"en":"Had foals left orphaned,"},{"id":"semetey-1-2013:p1088:b004:l010","ordinal":159216,"en":"And had the mares slaughtered wholesale."},{"id":"semetey-1-2013:p1088:b004:l011","ordinal":159217,"en":"He slaughtered sheep and male camels,"},{"id":"semetey-1-2013:p1088:b004:l012","ordinal":159218,"en":"Saying, \"This is merit for my khan-father,\""},{"id":"semetey-1-2013:p1088:b004:l013","ordinal":159219,"en":"And slaughtered many cattle and horses."},{"id":"semetey-1-2013:p1088:b004:l014","ordinal":159220,"en":"He had all the giants brought,"},{"id":"semetey-1-2013:p1088:b004:l015","ordinal":159221,"en":"And placed his father's remains"},{"id":"semetey-1-2013:p1088:b004:l016","ordinal":159222,"en":"In the hands of sixty giants."},{"id":"semetey-1-2013:p1088:b004:l017","ordinal":159223,"en":"He tethered ninety gray horses for the funeral gifts,"},{"id":"semetey-1-2013:p1088:b004:l018","ordinal":159224,"en":"And tethered all the rest in groups of a thousand,"},{"id":"semetey-1-2013:p1088:b004:l019","ordinal":159225,"en":"Had bells fastened to them,"},{"id":"semetey-1-2013:p1088:b004:l020","ordinal":159226,"en":"And costly carpets spread over them."},{"id":"semetey-1-2013:p1088:b004:l021","ordinal":159227,"en":"He tethered six thousand pack camels and male camels;"},{"id":"semetey-1-2013:p1088:b004:l022","ordinal":159228,"en":"His champions shouted,"},{"id":"semetey-1-2013:p1088:b004:l023","ordinal":159229,"en":"\"Qalandars, paupers, dervishes,"},{"id":"semetey-1-2013:p1088:b004:l024","ordinal":159230,"en":"Let not one of you stay behind!\""},{"id":"semetey-1-2013:p1088:b004:l025","ordinal":159231,"en":"He summoned the people"},{"id":"semetey-1-2013:p1088:b004:l026","ordinal":159232,"en":"And had the funeral prayer recited."}]
