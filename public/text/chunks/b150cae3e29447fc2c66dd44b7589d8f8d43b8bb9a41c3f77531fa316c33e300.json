[{"id":"semetey-1-2013:p1092:b004:l031","ordinal":160513,"en":"Many mortals wandering about agape,"},{"id":"semetey-1-2013:p1092:b004:l032","ordinal":160514,"en":"Who know neither feasts nor horses."},{"id":"semetey-1-2013:p1092:b004:l033","ordinal":160515,"en":"I shall devise something worse than a raid:"},{"id":"semetey-1-2013:p1092:b004:l034","ordinal":160516,"en":"Let the gathered people be ruined;"},{"id":"semetey-1-2013:p1092:b004:l035","ordinal":160517,"en":"I shall hold a feast for Kökötöy."},{"id":"semetey-1-2013:p1092:b004:l036","ordinal":160518,"en":"If Kökötöy's great herds"},{"id":"semetey-1-2013:p1092:b004:l037","ordinal":160519,"en":"Unexpectedly prove insufficient,"},{"id":"semetey-1-2013:p1092:b004:l038","ordinal":160520,"en":"Upon the thundering Muslims,"},{"id":"semetey-1-2013:p1092:b004:l039","ordinal":160521,"en":"For my dear father's feast,"},{"id":"semetey-1-2013:p1093:b003:l001","ordinal":160522,"en":"I shall levy a tax upon every hearth;"},{"id":"semetey-1-2013:p1093:b003:l002","ordinal":160523,"en":"I shall discipline and beat them all,"},{"id":"semetey-1-2013:p1093:b003:l003","ordinal":160524,"en":"And gather everything, leaving nothing."},{"id":"semetey-1-2013:p1093:b003:l004","ordinal":160525,"en":"Uncle Koshoy, hear my words!"},{"id":"semetey-1-2013:p1093:b003:l005","ordinal":160526,"en":"Among the sheep is a sacred he-goat"},{"id":"semetey-1-2013:p1093:b003:l006","ordinal":160527,"en":"That never stirs from the flock."},{"id":"semetey-1-2013:p1093:b003:l007","ordinal":160528,"en":"Maintained by the treasury,"},{"id":"semetey-1-2013:p1093:b003:l008","ordinal":160529,"en":"In my dear father's palace"},{"id":"semetey-1-2013:p1093:b003:l009","ordinal":160530,"en":"Are two hundred pampered maidens."},{"id":"semetey-1-2013:p1093:b003:l010","ordinal":160531,"en":"Their bodies are richly adorned;"},{"id":"semetey-1-2013:p1093:b003:l011","ordinal":160532,"en":"I intend to stake them all"},{"id":"semetey-1-2013:p1093:b003:l012","ordinal":160533,"en":"As prizes.\""},{"id":"semetey-1-2013:p1093:b003:l013","ordinal":160534,"en":"Then, as though pierced in a gland,"},{"id":"semetey-1-2013:p1093:b003:l014","ordinal":160535,"en":"Hero Koshoy sprang up:"},{"id":"semetey-1-2013:p1093:b003:l015","ordinal":160536,"en":"\"My child, he who gives a feast incurs blame;"},{"id":"semetey-1-2013:p1093:b003:l016","ordinal":160537,"en":"He who gives a feast incurs sin."},{"id":"semetey-1-2013:p1093:b003:l017","ordinal":160538,"en":"Steel will strike on the descent,"},{"id":"semetey-1-2013:p1093:b003:l018","ordinal":160539,"en":"And we Kyrgyz will be few."},{"id":"semetey-1-2013:p1093:b003:l019","ordinal":160540,"en":"The black Chinese and Manchu people"},{"id":"semetey-1-2013:p1093:b003:l020","ordinal":160541,"en":"Will be enemies to our people."},{"id":"semetey-1-2013:p1093:b003:l021","ordinal":160542,"en":"There is the teeming black Chinese"},{"id":"semetey-1-2013:p1093:b003:l022","ordinal":160543,"en":"People of Kakan-Chyn;"},{"id":"semetey-1-2013:p1093:b003:l023","ordinal":160544,"en":"If they attack, they have the custom"},{"id":"semetey-1-2013:p1093:b003:l024","ordinal":160545,"en":"Of drinking Kyrgyz blood."},{"id":"semetey-1-2013:p1093:b003:l025","ordinal":160546,"en":"There is a crooked people;"},{"id":"semetey-1-2013:p1093:b003:l026","ordinal":160547,"en":"To straighten their perversity,"},{"id":"semetey-1-2013:p1093:b003:l027","ordinal":160548,"en":"There is the hellish wolf Zholoy."},{"id":"semetey-1-2013:p1093:b003:l028","ordinal":160549,"en":"There are black Chinese and many Manchus,"},{"id":"semetey-1-2013:p1093:b003:l029","ordinal":160550,"en":"Infidels seething in multitudes;"},{"id":"semetey-1-2013:p1093:b003:l030","ordinal":160551,"en":"Over all of them"},{"id":"semetey-1-2013:p1093:b003:l031","ordinal":160552,"en":"There is the hero Khan Kongurbay."},{"id":"semetey-1-2013:p1093:b003:l032","ordinal":160553,"en":"When his wrath seizes him,"},{"id":"semetey-1-2013:p1093:b003:l033","ordinal":160554,"en":"Might he not unleash havoc?"},{"id":"semetey-1-2013:p1093:b003:l034","ordinal":160555,"en":"The reason he would unleash havoc is this:"},{"id":"semetey-1-2013:p1093:b003:l035","ordinal":160556,"en":"Bloodthirsty Manas killed"},{"id":"semetey-1-2013:p1093:b003:l036","ordinal":160557,"en":"His father, Khan Alööke."},{"id":"semetey-1-2013:p1093:b003:l037","ordinal":160558,"en":"Might he not begin battle at the feast"},{"id":"semetey-1-2013:p1093:b003:l038","ordinal":160559,"en":"And inflict a single calamity?"},{"id":"semetey-1-2013:p1093:b003:l039","ordinal":160560,"en":"There is the capable Boroonchu,"},{"id":"semetey-1-2013:p1093:b004:l001","ordinal":160561,"en":"Who went and joined the Kakan;"},{"id":"semetey-1-2013:p1093:b004:l002","ordinal":160562,"en":"And Bozkertik of Tokushker—"},{"id":"semetey-1-2013:p1093:b004:l003","ordinal":160563,"en":"Those three are brothers."},{"id":"semetey-1-2013:p1093:b004:l004","ordinal":160564,"en":"Seeking to attack"},{"id":"semetey-1-2013:p1093:b004:l005","ordinal":160565,"en":"The tiger, bloodthirsty Manas,"},{"id":"semetey-1-2013:p1093:b004:l006","ordinal":160566,"en":"They too lost their father."},{"id":"semetey-1-2013:p1093:b004:l007","ordinal":160567,"en":"The steadfast black Chinese"},{"id":"semetey-1-2013:p1093:b004:l008","ordinal":160568,"en":"Have an unending vengeance."},{"id":"semetey-1-2013:p1093:b004:l009","ordinal":160569,"en":"If you summon the peoples"},{"id":"semetey-1-2013:p1093:b004:l010","ordinal":160570,"en":"To your khan-father Kökötöy's feast,"},{"id":"semetey-1-2013:p1093:b004:l011","ordinal":160571,"en":"They have lions who will fight us."},{"id":"semetey-1-2013:p1093:b004:l012","ordinal":160572,"en":"There is the elder Khan Kökötöy;"},{"id":"semetey-1-2013:p1093:b004:l013","ordinal":160573,"en":"Here are all"},{"id":"semetey-1-2013:p1093:b004:l014","ordinal":160574,"en":"The Kyrgyz khans' sons."},{"id":"semetey-1-2013:p1093:b004:l015","ordinal":160575,"en":"When Karakan arose from the Kyrgyz,"},{"id":"semetey-1-2013:p1093:b004:l016","ordinal":160576,"en":"Reigned as khan, and died,"},{"id":"semetey-1-2013:p1093:b004:l017","ordinal":160577,"en":"When he passed to the other world,"},{"id":"semetey-1-2013:p1093:b004:l018","ordinal":160578,"en":"All eight of Karakan's sons"},{"id":"semetey-1-2013:p1093:b004:l019","ordinal":160579,"en":"Were left powerless and bewildered,"},{"id":"semetey-1-2013:p1093:b004:l020","ordinal":160580,"en":"Left as crawling children."},{"id":"semetey-1-2013:p1093:b004:l021","ordinal":160581,"en":"The struggle for the khanate is a hard affair."},{"id":"semetey-1-2013:p1093:b004:l022","ordinal":160582,"en":"When they brought havoc upon"},{"id":"semetey-1-2013:p1093:b004:l023","ordinal":160583,"en":"These many Kyrgyz people"},{"id":"semetey-1-2013:p1093:b004:l024","ordinal":160584,"en":"And scattered those who resisted,"},{"id":"semetey-1-2013:p1093:b004:l025","ordinal":160585,"en":"When the Chinese day dawned,"},{"id":"semetey-1-2013:p1093:b004:l026","ordinal":160586,"en":"They pursued with gunfire"},{"id":"semetey-1-2013:p1093:b004:l027","ordinal":160587,"en":"Those who resisted."},{"id":"semetey-1-2013:p1093:b004:l028","ordinal":160588,"en":"When the fighting people"},{"id":"semetey-1-2013:p1093:b004:l029","ordinal":160589,"en":"Died enduring humiliation,"},{"id":"semetey-1-2013:p1093:b004:l030","ordinal":160590,"en":"Whoever fell into the Chinese hands—"},{"id":"semetey-1-2013:p1093:b004:l031","ordinal":160591,"en":"They drove one away to a hero"},{"id":"semetey-1-2013:p1093:b004:l032","ordinal":160592,"en":"And cast another into a ravine."},{"id":"semetey-1-2013:p1093:b004:l033","ordinal":160593,"en":"They drove one into captivity"},{"id":"semetey-1-2013:p1093:b004:l034","ordinal":160594,"en":"And another to Altay."},{"id":"semetey-1-2013:p1093:b004:l035","ordinal":160595,"en":"Zhakyp was exiled to Altay;"},{"id":"semetey-1-2013:p1093:b004:l036","ordinal":160596,"en":"The lion Manas, the bloodthirsty beast,"},{"id":"semetey-1-2013:p1093:b004:l037","ordinal":160597,"en":"Was born while they wandered in exile."},{"id":"semetey-1-2013:p1093:b004:l038","ordinal":160598,"en":"Born with perfect fortune,"},{"id":"semetey-1-2013:p1093:b004:l039","ordinal":160599,"en":"The dark gray wolf Manas"},{"id":"semetey-1-2013:p1094:b003:l001","ordinal":160600,"en":"Was born to dark-hearted Zhakyp,"},{"id":"semetey-1-2013:p1094:b003:l002","ordinal":160601,"en":"A dark-piebald lion."},{"id":"semetey-1-2013:p1094:b003:l003","ordinal":160602,"en":"When he reached twelve,"},{"id":"semetey-1-2013:p1094:b003:l004","ordinal":160603,"en":"He broke citadels and took booty."},{"id":"semetey-1-2013:p1094:b003:l005","ordinal":160604,"en":"No mortal like him had ever been;"},{"id":"semetey-1-2013:p1094:b003:l006","ordinal":160605,"en":"The enemies he faced slunk away."},{"id":"semetey-1-2013:p1094:b003:l007","ordinal":160606,"en":"When enraged, he seized them,"},{"id":"semetey-1-2013:p1094:b003:l008","ordinal":160607,"en":"And chewed those he seized."},{"id":"semetey-1-2013:p1094:b003:l009","ordinal":160608,"en":"Among the black Chinese and Manchus,"},{"id":"semetey-1-2013:p1094:b003:l010","ordinal":160609,"en":"No enemy remained to fight him."},{"id":"semetey-1-2013:p1094:b003:l011","ordinal":160610,"en":"When they heard the force of his courage,"},{"id":"semetey-1-2013:p1094:b003:l012","ordinal":160611,"en":"Khan Esenkan wept."},{"id":"semetey-1-2013:p1094:b003:l013","ordinal":160612,"en":"If you hold a feast for Kökötöy,"},{"id":"semetey-1-2013:p1094:b003:l014","ordinal":160613,"en":"Send a scout to Talas;"},{"id":"semetey-1-2013:p1094:b003:l015","ordinal":160614,"en":"Send word, my colt,"},{"id":"semetey-1-2013:p1094:b003:l016","ordinal":160615,"en":"To black-maned Manas!"},{"id":"semetey-1-2013:p1094:b003:l017","ordinal":160616,"en":"Hey, Bokmurun, think carefully:"},{"id":"semetey-1-2013:p1094:b003:l018","ordinal":160617,"en":"He is the support on whom to rely."},{"id":"semetey-1-2013:p1094:b003:l019","ordinal":160618,"en":"If you hold a feast for Kökötöy,"},{"id":"semetey-1-2013:p1094:b003:l020","ordinal":160619,"en":"He is the hero who will be your aid"},{"id":"semetey-1-2013:p1094:b003:l021","ordinal":160620,"en":"And the girding at your waist."},{"id":"semetey-1-2013:p1094:b003:l022","ordinal":160621,"en":"If you do not send word to Manas,"},{"id":"semetey-1-2013:p1094:b003:l023","ordinal":160622,"en":"May he not dig a well in your place,"},{"id":"semetey-1-2013:p1094:b003:l024","ordinal":160623,"en":"May he not surely trample you underfoot,"},{"id":"semetey-1-2013:p1094:b003:l025","ordinal":160624,"en":"May he not scatter your four kinds of livestock;"},{"id":"semetey-1-2013:p1094:b003:l026","ordinal":160625,"en":"May the Chinese day not dawn"},{"id":"semetey-1-2013:p1094:b003:l027","ordinal":160626,"en":"And slaughter every last person"},{"id":"semetey-1-2013:p1094:b003:l028","ordinal":160627,"en":"Who went to the feast."},{"id":"semetey-1-2013:p1094:b003:l029","ordinal":160628,"en":"Hairy-soled Tükübay,"},{"id":"semetey-1-2013:p1094:b003:l030","ordinal":160629,"en":"The remnant champion of the Chinese,"},{"id":"semetey-1-2013:p1094:b003:l031","ordinal":160630,"en":"Yearns to finish off"},{"id":"semetey-1-2013:p1094:b003:l032","ordinal":160631,"en":"The dwindling Burut;"},{"id":"semetey-1-2013:p1094:b003:l033","ordinal":160632,"en":"Yes, Kongurbay and Tükübay"},{"id":"semetey-1-2013:p1094:b003:l034","ordinal":160633,"en":"Carry this longing within them."},{"id":"semetey-1-2013:p1094:b003:l035","ordinal":160634,"en":"At their flank is Börüköz,"},{"id":"semetey-1-2013:p1094:b003:l036","ordinal":160635,"en":"A great Chinese champion;"},{"id":"semetey-1-2013:p1094:b003:l037","ordinal":160636,"en":"The lean diviner Ezkara"},{"id":"semetey-1-2013:p1094:b003:l038","ordinal":160637,"en":"Keeps watching us,"},{"id":"semetey-1-2013:p1094:b003:l039","ordinal":160638,"en":"Seeking to unleash havoc."},{"id":"semetey-1-2013:p1094:b004:l001","ordinal":160639,"en":"\"Anger is the devil, reason a friend\"—"},{"id":"semetey-1-2013:p1094:b004:l002","ordinal":160640,"en":"Oh, my colt Bokmurun!"},{"id":"semetey-1-2013:p1094:b004:l003","ordinal":160641,"en":"Add wisdom to your thought."},{"id":"semetey-1-2013:p1094:b004:l004","ordinal":160642,"en":"Do not gather the handful of Kyrgyz"},{"id":"semetey-1-2013:p1094:b004:l005","ordinal":160643,"en":"By saying you will hold a feast;"},{"id":"semetey-1-2013:p1094:b004:l006","ordinal":160644,"en":"Without renowned Manas,"},{"id":"semetey-1-2013:p1094:b004:l007","ordinal":160645,"en":"Do not bring ruin upon other peoples."},{"id":"semetey-1-2013:p1094:b004:l008","ordinal":160646,"en":"Oh, my colt Bokmurun!"},{"id":"semetey-1-2013:p1094:b004:l009","ordinal":160647,"en":"Do not rely upon your wealth,"},{"id":"semetey-1-2013:p1094:b004:l010","ordinal":160648,"en":"And do not hand the handful of Muslims"},{"id":"semetey-1-2013:p1094:b004:l011","ordinal":160649,"en":"Over to the Chinese"},{"id":"semetey-1-2013:p1094:b004:l012","ordinal":160650,"en":"And fall into calamity."},{"id":"semetey-1-2013:p1094:b004:l013","ordinal":160651,"en":"You are a son intoxicated by livestock;"},{"id":"semetey-1-2013:p1094:b004:l014","ordinal":160652,"en":"If you do not heed these words of mine,"},{"id":"semetey-1-2013:p1094:b004:l015","ordinal":160653,"en":"By summoning all the peoples,"},{"id":"semetey-1-2013:p1094:b004:l016","ordinal":160654,"en":"You will bring them into calamity."},{"id":"semetey-1-2013:p1094:b004:l017","ordinal":160655,"en":"The black Chinese and many Manchus"},{"id":"semetey-1-2013:p1094:b004:l018","ordinal":160656,"en":"Are no people who understand a feast."},{"id":"semetey-1-2013:p1094:b004:l019","ordinal":160657,"en":"When he hears the news and gathers his host,"},{"id":"semetey-1-2013:p1094:b004:l020","ordinal":160658,"en":"Might Khan Kongurbay not arrive?"},{"id":"semetey-1-2013:p1094:b004:l021","ordinal":160659,"en":"Without the tiger Manas,"},{"id":"semetey-1-2013:p1094:b004:l022","ordinal":160660,"en":"Might he not utterly slaughter"},{"id":"semetey-1-2013:p1094:b004:l023","ordinal":160661,"en":"Your vast black people?\""},{"id":"semetey-1-2013:p1094:b004:l024","ordinal":160662,"en":"When Koshoy had spoken thus,"},{"id":"semetey-1-2013:p1094:b004:l025","ordinal":160663,"en":"Bokmurun shook with agitation"},{"id":"semetey-1-2013:p1094:b004:l026","ordinal":160664,"en":"And sprang up:"},{"id":"semetey-1-2013:p1094:b004:l027","ordinal":160665,"en":"\"Uncle Koshoy, hear my words."},{"id":"semetey-1-2013:p1094:b004:l028","ordinal":160666,"en":"It is known among the people"},{"id":"semetey-1-2013:p1094:b004:l029","ordinal":160667,"en":"That Khan Kökötöy lived,"},{"id":"semetey-1-2013:p1094:b004:l030","ordinal":160668,"en":"And that Kökötöy's vast riches"},{"id":"semetey-1-2013:p1094:b004:l031","ordinal":160669,"en":"Filled the face of the earth."},{"id":"semetey-1-2013:p1094:b004:l032","ordinal":160670,"en":"Now I shall open their lock"},{"id":"semetey-1-2013:p1094:b004:l033","ordinal":160671,"en":"And scatter them among all the people,"},{"id":"semetey-1-2013:p1094:b004:l034","ordinal":160672,"en":"Leaving none of them out."},{"id":"semetey-1-2013:p1094:b004:l035","ordinal":160673,"en":"To all the people,"},{"id":"semetey-1-2013:p1094:b004:l036","ordinal":160674,"en":"To carry word,"},{"id":"semetey-1-2013:p1094:b004:l037","ordinal":160675,"en":"There is the swift horse Maaniker;"},{"id":"semetey-1-2013:p1094:b004:l038","ordinal":160676,"en":"For infidel and Muslim alike,"},{"id":"semetey-1-2013:p1094:b004:l039","ordinal":160677,"en":"To feast all the people,"},{"id":"semetey-1-2013:p1095:b003:l001","ordinal":160678,"en":"There is wealth in abundance."},{"id":"semetey-1-2013:p1095:b003:l002","ordinal":160679,"en":"I will send word to the people;"},{"id":"semetey-1-2013:p1095:b003:l003","ordinal":160680,"en":"While my dear head is still alive,"},{"id":"semetey-1-2013:p1095:b003:l004","ordinal":160681,"en":"I will gather everything in full."},{"id":"semetey-1-2013:p1095:b003:l005","ordinal":160682,"en":"Today I offered many prizes;"},{"id":"semetey-1-2013:p1095:b003:l006","ordinal":160683,"en":"Tomorrow I will offer great prizes."},{"id":"semetey-1-2013:p1095:b003:l007","ordinal":160684,"en":"Uncle Koshoy, wise man,"},{"id":"semetey-1-2013:p1095:b003:l008","ordinal":160685,"en":"Wisdom comes from an elder,"},{"id":"semetey-1-2013:p1095:b003:l009","ordinal":160686,"en":"From a hero like you."},{"id":"semetey-1-2013:p1095:b003:l010","ordinal":160687,"en":"If I cannot hold my father's memorial feast,"},{"id":"semetey-1-2013:p1095:b003:l011","ordinal":160688,"en":"My dear khan and uncle,"},{"id":"semetey-1-2013:p1095:b003:l012","ordinal":160689,"en":"Where can I go and hide?"},{"id":"semetey-1-2013:p1095:b003:l013","ordinal":160690,"en":"Between the Manchu and the Kyrgyz,"},{"id":"semetey-1-2013:p1095:b003:l014","ordinal":160691,"en":"I will dig hearths into the ground."},{"id":"semetey-1-2013:p1095:b003:l015","ordinal":160692,"en":"Infidel and Muslim alike,"},{"id":"semetey-1-2013:p1095:b003:l016","ordinal":160693,"en":"Everyone who comes to the feast,"},{"id":"semetey-1-2013:p1095:b003:l017","ordinal":160694,"en":"I will fill with pure white fat."},{"id":"semetey-1-2013:p1095:b003:l018","ordinal":160695,"en":"For my dear father's memorial feast,"},{"id":"semetey-1-2013:p1095:b003:l019","ordinal":160696,"en":"I will have autumn rice planted."},{"id":"semetey-1-2013:p1095:b003:l020","ordinal":160697,"en":"Great wealth and countless livestock,"},{"id":"semetey-1-2013:p1095:b003:l021","ordinal":160698,"en":"For my dear father's feast,"},{"id":"semetey-1-2013:p1095:b003:l022","ordinal":160699,"en":"I will scatter and display it all."},{"id":"semetey-1-2013:p1095:b003:l023","ordinal":160700,"en":"If I do not gather the four corners"},{"id":"semetey-1-2013:p1095:b003:l024","ordinal":160701,"en":"Of the whole world four times over,"},{"id":"semetey-1-2013:p1095:b003:l025","ordinal":160702,"en":"If I do not make such merriment"},{"id":"semetey-1-2013:p1095:b003:l026","ordinal":160703,"en":"At my princely father's memorial feast,"},{"id":"semetey-1-2013:p1095:b003:l027","ordinal":160704,"en":"May I die before I become Bokmurun."},{"id":"semetey-1-2013:p1095:b003:l028","ordinal":160705,"en":"Rather than walk about alive,"},{"id":"semetey-1-2013:p1095:b003:l029","ordinal":160706,"en":"May I sink away as though never born!"},{"id":"semetey-1-2013:p1095:b003:l030","ordinal":160707,"en":"Whoever crosses my stubborn will,"},{"id":"semetey-1-2013:p1095:b003:l031","ordinal":160708,"en":"I will strike down and kill."},{"id":"semetey-1-2013:p1095:b003:l032","ordinal":160709,"en":"For my dear father's memorial feast,"},{"id":"semetey-1-2013:p1095:b003:l033","ordinal":160710,"en":"I will make meat as high as Ala-Too,"},{"id":"semetey-1-2013:p1095:b003:l034","ordinal":160711,"en":"And broth as vast as Ala-Köl."},{"id":"semetey-1-2013:p1095:b003:l035","ordinal":160712,"en":"I will slaughter livestock beyond counting"},{"id":"semetey-1-2013:p1095:b003:l036","ordinal":160713,"en":"And feed everyone gathered around."},{"id":"semetey-1-2013:p1095:b003:l037","ordinal":160714,"en":"I will display my riches;"},{"id":"semetey-1-2013:p1095:b003:l038","ordinal":160715,"en":"I will distribute gold like stones."},{"id":"semetey-1-2013:p1095:b003:l039","ordinal":160716,"en":"I will cover the face of the earth in dust;"},{"id":"semetey-1-2013:p1095:b004:l001","ordinal":160717,"en":"Calling it “Khan Kökötöy's memorial feast,”"},{"id":"semetey-1-2013:p1095:b004:l002","ordinal":160718,"en":"I will make it renowned among the people."},{"id":"semetey-1-2013:p1095:b004:l003","ordinal":160719,"en":"Uncle Koshoy, wise man,"},{"id":"semetey-1-2013:p1095:b004:l004","ordinal":160720,"en":"I stand asking counsel"},{"id":"semetey-1-2013:p1095:b004:l005","ordinal":160721,"en":"From a hero like you."},{"id":"semetey-1-2013:p1095:b004:l006","ordinal":160722,"en":"Since my valiant father died,"},{"id":"semetey-1-2013:p1095:b004:l007","ordinal":160723,"en":"After Khan Kökötöy saw"},{"id":"semetey-1-2013:p1095:b004:l008","ordinal":160724,"en":"The world that never looks back,"},{"id":"semetey-1-2013:p1095:b004:l009","ordinal":160725,"en":"How should the village make camp?"},{"id":"semetey-1-2013:p1095:b004:l010","ordinal":160726,"en":"How should our encampment be arranged?"},{"id":"semetey-1-2013:p1095:b004:l011","ordinal":160727,"en":"Uncle Koshoy, find us wisdom;"},{"id":"semetey-1-2013:p1095:b004:l012","ordinal":160728,"en":"What course should we take?"},{"id":"semetey-1-2013:p1095:b004:l013","ordinal":160729,"en":"How shall we hold his memorial feast?"},{"id":"semetey-1-2013:p1095:b004:l014","ordinal":160730,"en":"How shall we race the horses?"},{"id":"semetey-1-2013:p1095:b004:l015","ordinal":160731,"en":"How shall we find the right counsel?"},{"id":"semetey-1-2013:p1095:b004:l016","ordinal":160732,"en":"We will bend our necks to skill;"},{"id":"semetey-1-2013:p1095:b004:l017","ordinal":160733,"en":"How shall we arrange its splendor?"},{"id":"semetey-1-2013:p1095:b004:l018","ordinal":160734,"en":"Uncle Koshoy, elder!"},{"id":"semetey-1-2013:p1095:b004:l019","ordinal":160735,"en":"Among the sons of men today,"},{"id":"semetey-1-2013:p1095:b004:l020","ordinal":160736,"en":"You were born a saint above the rest."},{"id":"semetey-1-2013:p1095:b004:l021","ordinal":160737,"en":"Bereft of my father,"},{"id":"semetey-1-2013:p1095:b004:l022","ordinal":160738,"en":"I am the one left an orphan."},{"id":"semetey-1-2013:p1095:b004:l023","ordinal":160739,"en":"Your help has often reached the people;"},{"id":"semetey-1-2013:p1095:b004:l024","ordinal":160740,"en":"You are a true saint,"},{"id":"semetey-1-2013:p1095:b004:l025","ordinal":160741,"en":"And I am truly an orphan."},{"id":"semetey-1-2013:p1095:b004:l026","ordinal":160742,"en":"Koshoy, hero who opened the market"},{"id":"semetey-1-2013:p1095:b004:l027","ordinal":160743,"en":"For warriors fallen into bondage,"},{"id":"semetey-1-2013:p1095:b004:l028","ordinal":160744,"en":"Koshoy, hero who restored the fortune"},{"id":"semetey-1-2013:p1095:b004:l029","ordinal":160745,"en":"Of a market held in bonds,"},{"id":"semetey-1-2013:p1095:b004:l030","ordinal":160746,"en":"Khan Koshoy whom all desire,"},{"id":"semetey-1-2013:p1095:b004:l031","ordinal":160747,"en":"Our dear elder and uncle—"},{"id":"semetey-1-2013:p1095:b004:l032","ordinal":160748,"en":"You are the mainstay of the multitude,"},{"id":"semetey-1-2013:p1095:b004:l033","ordinal":160749,"en":"A saint who has stood among us."},{"id":"semetey-1-2013:p1095:b004:l034","ordinal":160750,"en":"In a waterless place where the sun boils,"},{"id":"semetey-1-2013:p1095:b004:l035","ordinal":160751,"en":"You are a poplar, brave Koshoy;"},{"id":"semetey-1-2013:p1095:b004:l036","ordinal":160752,"en":"For the many people of the forty Kyrgyz tribes,"},{"id":"semetey-1-2013:p1095:b004:l037","ordinal":160753,"en":"You are their yurt wall, brave Koshoy."},{"id":"semetey-1-2013:p1095:b004:l038","ordinal":160754,"en":"Dear land like Chech-Döbö,"},{"id":"semetey-1-2013:p1095:b004:l039","ordinal":160755,"en":"With your skill you made it a homeland;"},{"id":"semetey-1-2013:p1096:b003:l001","ordinal":160756,"en":"The Kyrgyz of Zheti-Suu,"},{"id":"semetey-1-2013:p1096:b003:l002","ordinal":160757,"en":"With your skill you made into a people."},{"id":"semetey-1-2013:p1096:b003:l003","ordinal":160758,"en":"Of surging hell,"},{"id":"semetey-1-2013:p1096:b003:l004","ordinal":160759,"en":"You have seen its very eye, brave Koshoy;"},{"id":"semetey-1-2013:p1096:b003:l005","ordinal":160760,"en":"Of the teeming Black Chinese,"},{"id":"semetey-1-2013:p1096:b003:l006","ordinal":160761,"en":"You have seen their very eye, brave Koshoy."},{"id":"semetey-1-2013:p1096:b003:l007","ordinal":160762,"en":"Of the entrenched foe,"},{"id":"semetey-1-2013:p1096:b003:l008","ordinal":160763,"en":"You have seen his stronghold, brave Koshoy."},{"id":"semetey-1-2013:p1096:b003:l009","ordinal":160764,"en":"Infidels and Muslims,"},{"id":"semetey-1-2013:p1096:b003:l010","ordinal":160765,"en":"Clans where peoples gathered—"},{"id":"semetey-1-2013:p1096:b003:l011","ordinal":160766,"en":"You have seen most of them, brave Koshoy."},{"id":"semetey-1-2013:p1096:b003:l012","ordinal":160767,"en":"Relentless havoc"},{"id":"semetey-1-2013:p1096:b003:l013","ordinal":160768,"en":"You have wrought, brave Koshoy."}]
