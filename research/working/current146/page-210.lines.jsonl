{"id": "sayakbay-ms-current146:pdf210:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 210, "folio": 593, "line_in_page": 6, "raw": "Алтын казык чок мурада,", "text": "Алтын казык чок мурада,", "en": "At the golden stake, in the glowing inheritance,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf210:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 210, "folio": 593, "line_in_page": 7, "raw": "Аларда багып жери алып,", "text": "Аларда багып жери алып,", "en": "They took the land that had nurtured them.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf210:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 210, "folio": 593, "line_in_page": 8, "raw": "Баатыр Кенен эрди алып,", "text": "Баатыр Кенен эрди алып,", "en": "They seized hero Kenen.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf210:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 210, "folio": 593, "line_in_page": 9, "raw": "Басып кыргыз элин алып,", "text": "Басып кыргыз элин алып,", "en": "They invaded and took the Kyrgyz people.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf210:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 210, "folio": 593, "line_in_page": 10, "raw": "Кызына мушкул кол салып,", "text": "Кызына мушкул кол салып,", "en": "They laid a grievous hand upon his daughter.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf210:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 210, "folio": 593, "line_in_page": 11, "raw": "Эңкейген карган элден жап,", "text": "Эңкейген карган элден жап,", "en": "From the bowed and aged people, gather them all.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, name, or idiomatic interpretation requires later witness collation.", "bbox": null}
