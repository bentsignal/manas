[{"id":"manas-2010:p1343:b001:l019","ordinal":58113,"en":"Eating bread, they were never filled;"},{"id":"manas-2010:p1343:b001:l020","ordinal":58114,"en":"They spared nothing they encountered."},{"id":"manas-2010:p1343:b001:l021","ordinal":58115,"en":"Be it beast or human,"},{"id":"manas-2010:p1343:b001:l022","ordinal":58116,"en":"They ate whatever they encountered."},{"id":"manas-2010:p1343:b001:l023","ordinal":58117,"en":"Agile on horseback, swift on foot,"},{"id":"manas-2010:p1343:b001:l024","ordinal":58118,"en":"Who emerge when the Chinese face destruction,"},{"id":"manas-2010:p1343:b001:l025","ordinal":58119,"en":"They were a people called the Swift Foot-Runners."},{"id":"manas-2010:p1343:b001:l026","ordinal":58120,"en":"Their khans were"},{"id":"manas-2010:p1343:b001:l027","ordinal":58121,"en":"The giant Mangkush with an iron forehead,"},{"id":"manas-2010:p1343:b001:l028","ordinal":58122,"en":"The giant Kutan with iron ears,"},{"id":"manas-2010:p1343:b001:l029","ordinal":58123,"en":"The giant Kazan behind them."},{"id":"manas-2010:p1343:b001:l030","ordinal":58124,"en":"The Chinese crowded in, steeped in blood,"},{"id":"manas-2010:p1343:b001:l031","ordinal":58125,"en":"All the Chinese were there."},{"id":"manas-2010:p1343:b001:l032","ordinal":58126,"en":"With no Manas to give support,"},{"id":"manas-2010:p1343:b001:l033","ordinal":58127,"en":"At Muzburchak, Kökchö and Töshtük,"},{"id":"manas-2010:p1343:b001:l034","ordinal":58128,"en":"At old warrior Koshoy,"},{"id":"manas-2010:p1343:b001:l035","ordinal":58129,"en":"Those Chinese swarmed."},{"id":"manas-2010:p1343:b001:l036","ordinal":58130,"en":"“Capture them alive!” they said."},{"id":"manas-2010:p1343:b001:l037","ordinal":58131,"en":"“Take them to Beijing,"},{"id":"manas-2010:p1343:b001:l038","ordinal":58132,"en":"Make them interpreters!” they said."},{"id":"manas-2010:p1343:b001:l039","ordinal":58133,"en":"“The Burut who attacked us themselves,"},{"id":"manas-2010:p1343:b001:l040","ordinal":58134,"en":"Destroy them root and branch!” they said."},{"id":"manas-2010:p1343:b001:l041","ordinal":58135,"en":"Kozubek of Kokand,"},{"id":"manas-2010:p1343:b001:l042","ordinal":58136,"en":"The Sart khan, he encountered."},{"id":"manas-2010:p1344:b001:l001","ordinal":58137,"en":"Making the Sarts cry, “Father!”"},{"id":"manas-2010:p1344:b001:l002","ordinal":58138,"en":"The giant Mangkush drove them on."},{"id":"manas-2010:p1344:b001:l003","ordinal":58139,"en":"Anyone who fell into his hands,"},{"id":"manas-2010:p1344:b001:l004","ordinal":58140,"en":"Seizing him in his hands,"},{"id":"manas-2010:p1344:b001:l005","ordinal":58141,"en":"The giant Mangkush chewed as he went."},{"id":"manas-2010:p1344:b001:l006","ordinal":58142,"en":"Glorious and fortunate,"},{"id":"manas-2010:p1344:b001:l007","ordinal":58143,"en":"Like a vast army against a grappling foe,"},{"id":"manas-2010:p1344:b001:l008","ordinal":58144,"en":"Khan Bakay came out before him."},{"id":"manas-2010:p1344:b001:l009","ordinal":58145,"en":"Whipping in fury,"},{"id":"manas-2010:p1344:b001:l010","ordinal":58146,"en":"Khan Bakay came hemming them in."},{"id":"manas-2010:p1344:b001:l011","ordinal":58147,"en":"Making the blows crack upon the Sarts,"},{"id":"manas-2010:p1344:b001:l012","ordinal":58148,"en":"Khan Bakay came beating them:"},{"id":"manas-2010:p1344:b001:l013","ordinal":58149,"en":"“Hey, Kokand! Hey, Kokand!"},{"id":"manas-2010:p1344:b001:l014","ordinal":58150,"en":"Rein your horse in, Kokand!"},{"id":"manas-2010:p1344:b001:l015","ordinal":58151,"en":"You will fight beyond your strength,"},{"id":"manas-2010:p1344:b001:l016","ordinal":58152,"en":"You will end up dead."},{"id":"manas-2010:p1344:b001:l017","ordinal":58153,"en":"Tal-Choku with its dark ridges"},{"id":"manas-2010:p1344:b001:l018","ordinal":58154,"en":"Is no pass a man can cross."},{"id":"manas-2010:p1344:b001:l019","ordinal":58155,"en":"Beijing's people, untouched by the Four Companions,"},{"id":"manas-2010:p1344:b001:l020","ordinal":58156,"en":"Are no people within your strength."},{"id":"manas-2010:p1344:b001:l021","ordinal":58157,"en":"Against the Chinese beyond your match,"},{"id":"manas-2010:p1344:b001:l022","ordinal":58158,"en":"You are not the one to contend!”"},{"id":"manas-2010:p1344:b001:l023","ordinal":58159,"en":"Bakay raised his shout."},{"id":"manas-2010:p1344:b001:l024","ordinal":58160,"en":"Blocking him from the front, warrior Bakay"},{"id":"manas-2010:p1344:b001:l025","ordinal":58161,"en":"Waged a tremendous battle."},{"id":"manas-2010:p1344:b001:l026","ordinal":58162,"en":"Confronting him, grappling,"},{"id":"manas-2010:p1344:b001:l027","ordinal":58163,"en":"Champion Bakay, the leopard,"},{"id":"manas-2010:p1344:b001:l028","ordinal":58164,"en":"When the iron-browed giant Mangkush"},{"id":"manas-2010:p1344:b001:l029","ordinal":58165,"en":"Roared and thrust his spear,"},{"id":"manas-2010:p1344:b001:l030","ordinal":58166,"en":"Warrior Bakay, skilled in combat,"},{"id":"manas-2010:p1344:b001:l031","ordinal":58167,"en":"The giant Mangkush's spear,"},{"id":"manas-2010:p1344:b001:l032","ordinal":58168,"en":"He slashed across and shattered."},{"id":"manas-2010:p1344:b001:l033","ordinal":58169,"en":"He found the way to deal with the enemy."},{"id":"manas-2010:p1344:b001:l034","ordinal":58170,"en":"A life fell under pressure;"},{"id":"manas-2010:p1344:b001:l035","ordinal":58171,"en":"They mingled in the dry dust."},{"id":"manas-2010:p1344:b001:l036","ordinal":58172,"en":"While Bakay was grappling,"},{"id":"manas-2010:p1344:b001:l037","ordinal":58173,"en":"With a golden forelock, a tasselled sash,"},{"id":"manas-2010:p1344:b001:l038","ordinal":58174,"en":"Azizkan's Almambet,"},{"id":"manas-2010:p1344:b001:l039","ordinal":58175,"en":"Riding a horse like Sarala,"},{"id":"manas-2010:p1344:b001:l040","ordinal":58176,"en":"Wearing yellow leather trousers,"},{"id":"manas-2010:p1344:b001:l041","ordinal":58177,"en":"Taking a spear without a plume,"},{"id":"manas-2010:p1344:b001:l042","ordinal":58178,"en":"Girding steel at his side,"},{"id":"manas-2010:p1345:b001:l001","ordinal":58179,"en":"The unbelievers on the upper side,"},{"id":"manas-2010:p1345:b001:l002","ordinal":58180,"en":"Wherever Almambet charged,"},{"id":"manas-2010:p1345:b001:l003","ordinal":58181,"en":"He scattered them like sand."},{"id":"manas-2010:p1345:b001:l004","ordinal":58182,"en":"Without entering the very middle,"},{"id":"manas-2010:p1345:b001:l005","ordinal":58183,"en":"Your Alma came along the edge."},{"id":"manas-2010:p1345:b001:l006","ordinal":58184,"en":"“If only I reach the giant Mangkush,” he said."},{"id":"manas-2010:p1345:b001:l007","ordinal":58185,"en":"Your Alma came straight toward him."},{"id":"manas-2010:p1345:b001:l008","ordinal":58186,"en":"In the blink of an eye,"},{"id":"manas-2010:p1345:b001:l009","ordinal":58187,"en":"Before one could say this or that,"},{"id":"manas-2010:p1345:b001:l010","ordinal":58188,"en":"Champion Almambet had arrived."},{"id":"manas-2010:p1345:b001:l011","ordinal":58189,"en":"Iron-browed Mangkush,"},{"id":"manas-2010:p1345:b001:l012","ordinal":58190,"en":"Behind Khan Bakay,"},{"id":"manas-2010:p1345:b001:l013","ordinal":58191,"en":"He thrust down as he passed."},{"id":"manas-2010:p1345:b001:l014","ordinal":58192,"en":"Giants such as that,"},{"id":"manas-2010:p1345:b001:l015","ordinal":58193,"en":"He had seen many of them before;"},{"id":"manas-2010:p1345:b001:l016","ordinal":58194,"en":"Was Bakay not accustomed to them?"},{"id":"manas-2010:p1345:b001:l017","ordinal":58195,"en":"Before Mangkush's champions"},{"id":"manas-2010:p1345:b001:l018","ordinal":58196,"en":"Could lift him onto his horse,"},{"id":"manas-2010:p1345:b001:l019","ordinal":58197,"en":"Blue-maned Bakay arrived."},{"id":"manas-2010:p1345:b001:l020","ordinal":58198,"en":"Taking Achbolot in his hand,"},{"id":"manas-2010:p1345:b001:l021","ordinal":58199,"en":"As soon as he reached Mangkush,"},{"id":"manas-2010:p1345:b001:l022","ordinal":58200,"en":"He struck off his head as he passed."},{"id":"manas-2010:p1345:b001:l023","ordinal":58201,"en":"When your Alma speared Mangkush,"},{"id":"manas-2010:p1345:b001:l024","ordinal":58202,"en":"The giant Kutan noticed."},{"id":"manas-2010:p1345:b001:l025","ordinal":58203,"en":"To spear Almambet,"},{"id":"manas-2010:p1345:b001:l026","ordinal":58204,"en":"The giant Kutan had drawn near."},{"id":"manas-2010:p1345:b001:l027","ordinal":58205,"en":"Leveling his spear, roaring,"},{"id":"manas-2010:p1345:b001:l028","ordinal":58206,"en":"When they saw the unbeliever's wrath,"},{"id":"manas-2010:p1345:b001:l029","ordinal":58207,"en":"Unable to bear his voice,"},{"id":"manas-2010:p1345:b001:l030","ordinal":58208,"en":"The Muslims who had been swarming in"},{"id":"manas-2010:p1345:b001:l031","ordinal":58209,"en":"Split right apart with a roar."},{"id":"manas-2010:p1345:b001:l032","ordinal":58210,"en":"When he saw the unbeliever's form,"},{"id":"manas-2010:p1345:b001:l033","ordinal":58211,"en":"Without closing his open eyes,"},{"id":"manas-2010:p1345:b001:l034","ordinal":58212,"en":"Without standing there watching him,"},{"id":"manas-2010:p1345:b001:l035","ordinal":58213,"en":"The edge of black steel,"},{"id":"manas-2010:p1345:b001:l036","ordinal":58214,"en":"Charging, drawing nearer,"},{"id":"manas-2010:p1345:b001:l037","ordinal":58215,"en":"Came Khan Manas's Syrgak."},{"id":"manas-2010:p1345:b001:l038","ordinal":58216,"en":"Not letting him reach Almambet,"},{"id":"manas-2010:p1345:b001:l039","ordinal":58217,"en":"He arrived before him."},{"id":"manas-2010:p1345:b001:l040","ordinal":58218,"en":"As soon as he reached him, warrior Syrgak,"},{"id":"manas-2010:p1345:b001:l041","ordinal":58219,"en":"From atop the gray mule,"},{"id":"manas-2010:p1345:b001:l042","ordinal":58220,"en":"The mountain-like unbeliever,"},{"id":"manas-2010:p1346:b001:l001","ordinal":58221,"en":"He thrust down as he passed."},{"id":"manas-2010:p1346:b001:l002","ordinal":58222,"en":"Khan Bakay had just arrived;"},{"id":"manas-2010:p1346:b001:l003","ordinal":58223,"en":"As he was about to cut off this one's head too,"},{"id":"manas-2010:p1346:b001:l004","ordinal":58224,"en":"The swift foot-runners who stood ready,"},{"id":"manas-2010:p1346:b001:l005","ordinal":58225,"en":"All the champions,"},{"id":"manas-2010:p1346:b001:l006","ordinal":58226,"en":"They encircled them all like iron,"},{"id":"manas-2010:p1346:b001:l007","ordinal":58227,"en":"They swarmed upon them together."},{"id":"manas-2010:p1346:b001:l008","ordinal":58228,"en":"God's decree,"},{"id":"manas-2010:p1346:b001:l009","ordinal":58229,"en":"They saw that such it was."},{"id":"manas-2010:p1346:b001:l010","ordinal":58230,"en":"Almambet and Syrgak,"},{"id":"manas-2010:p1346:b001:l011","ordinal":58231,"en":"The renowned elder Bakay,"},{"id":"manas-2010:p1346:b001:l012","ordinal":58232,"en":"They scattered and separated them."},{"id":"manas-2010:p1346:b001:l013","ordinal":58233,"en":"In the confusion,"},{"id":"manas-2010:p1346:b001:l014","ordinal":58234,"en":"Syrgak went onto one ridge."},{"id":"manas-2010:p1346:b001:l015","ordinal":58235,"en":"In a tumult of dust,"},{"id":"manas-2010:p1346:b001:l016","ordinal":58236,"en":"With the Chinese army pouring in,"},{"id":"manas-2010:p1346:b001:l017","ordinal":58237,"en":"His dear head stunned,"},{"id":"manas-2010:p1346:b001:l018","ordinal":58238,"en":"Almambet went off apart."},{"id":"manas-2010:p1346:b001:l019","ordinal":58239,"en":"Without tiring of striking,"},{"id":"manas-2010:p1346:b001:l020","ordinal":58240,"en":"Without wearying of shooting,"},{"id":"manas-2010:p1346:b001:l021","ordinal":58241,"en":"The black spear, Achbolot,"},{"id":"manas-2010:p1346:b001:l022","ordinal":58242,"en":"Khan Bakay kept drawing them."},{"id":"manas-2010:p1346:b001:l023","ordinal":58243,"en":"Making a desert in the vast army,"},{"id":"manas-2010:p1346:b001:l024","ordinal":58244,"en":"Dazing the Chinese,"},{"id":"manas-2010:p1346:b001:l025","ordinal":58245,"en":"Khan Bakay went kneading them."},{"id":"manas-2010:p1346:b001:l026","ordinal":58246,"en":"Shouting “Manas!”"},{"id":"manas-2010:p1346:b001:l027","ordinal":58247,"en":"The forty companions emerged from one side."},{"id":"manas-2010:p1346:b001:l028","ordinal":58248,"en":"Calling their battle cries,"},{"id":"manas-2010:p1346:b001:l029","ordinal":58249,"en":"There were the khans Koshoy and Töshtük,"},{"id":"manas-2010:p1346:b001:l030","ordinal":58250,"en":"Kökötöy's Bokmurun was there as well."},{"id":"manas-2010:p1346:b001:l031","ordinal":58251,"en":"Muzburchak and Kökchö as khans,"},{"id":"manas-2010:p1346:b001:l032","ordinal":58252,"en":"Dipping their hands in blood,"},{"id":"manas-2010:p1346:b001:l033","ordinal":58253,"en":"Refusing to draw back,"},{"id":"manas-2010:p1346:b001:l034","ordinal":58254,"en":"They fought a fierce battle."},{"id":"manas-2010:p1346:b001:l035","ordinal":58255,"en":"Then your Sultan Manas"},{"id":"manas-2010:p1346:b001:l036","ordinal":58256,"en":"Waged a terrible battle."},{"id":"manas-2010:p1346:b001:l037","ordinal":58257,"en":"The teeming Chinese unbelievers,"},{"id":"manas-2010:p1346:b001:l038","ordinal":58258,"en":"He scattered toward Beijing."},{"id":"manas-2010:p1346:b001:l039","ordinal":58259,"en":"Their champion Kalcha among them,"},{"id":"manas-2010:p1346:b001:l040","ordinal":58260,"en":"The many Chinese, not turning to fight,"},{"id":"manas-2010:p1346:b001:l041","ordinal":58261,"en":"Unable to withstand Khan Manas,"},{"id":"manas-2010:p1346:b001:l042","ordinal":58262,"en":"Had fled back."},{"id":"manas-2010:p1347:b001:l001","ordinal":58263,"en":"Without mercy, your generous Manas"},{"id":"manas-2010:p1347:b001:l002","ordinal":58264,"en":"Pursued them, grimly determined."},{"id":"manas-2010:p1347:b001:l003","ordinal":58265,"en":"Prowling like a hungry lion,"},{"id":"manas-2010:p1347:b001:l004","ordinal":58266,"en":"He brought immense slaughter."},{"id":"manas-2010:p1347:b001:l005","ordinal":58267,"en":"The many troops under siege"},{"id":"manas-2010:p1347:b001:l006","ordinal":58268,"en":"Had seen the blood-drinking one."},{"id":"manas-2010:p1347:b001:l007","ordinal":58269,"en":"When they saw your generous hero,"},{"id":"manas-2010:p1347:b001:l008","ordinal":58270,"en":"As though they had seen their father,"},{"id":"manas-2010:p1347:b001:l009","ordinal":58271,"en":"All took heart,"},{"id":"manas-2010:p1347:b001:l010","ordinal":58272,"en":"Old Koshoy among them."},{"id":"manas-2010:p1347:b001:l011","ordinal":58273,"en":"If you looked at some,"},{"id":"manas-2010:p1347:b001:l012","ordinal":58274,"en":"They shouted, “Bahauddin!”"},{"id":"manas-2010:p1347:b001:l013","ordinal":58275,"en":"If you looked at others,"},{"id":"manas-2010:p1347:b001:l014","ordinal":58276,"en":"“I shall sacrifice myself for the warrior!” they said."},{"id":"manas-2010:p1347:b001:l015","ordinal":58277,"en":"Crying out, “Our king!”"},{"id":"manas-2010:p1347:b001:l016","ordinal":58278,"en":"Behind Khan Manas,"},{"id":"manas-2010:p1347:b001:l017","ordinal":58279,"en":"Into six tümen of Chinese,"},{"id":"manas-2010:p1347:b001:l018","ordinal":58280,"en":"They were plunging."},{"id":"manas-2010:p1347:b001:l019","ordinal":58281,"en":"The Chinese before them,"},{"id":"manas-2010:p1347:b001:l020","ordinal":58282,"en":"They were wounding."},{"id":"manas-2010:p1347:b001:l021","ordinal":58283,"en":"Not sparing his toil-worn life,"},{"id":"manas-2010:p1347:b001:l022","ordinal":58284,"en":"Your blue-maned champion Chubak"},{"id":"manas-2010:p1347:b001:l023","ordinal":58285,"en":"Was plunging among them."},{"id":"manas-2010:p1347:b001:l024","ordinal":58286,"en":"When that Chubak entered,"},{"id":"manas-2010:p1347:b001:l025","ordinal":58287,"en":"There, before Manas,"},{"id":"manas-2010:p1347:b001:l026","ordinal":58288,"en":"Blood flowed like running water;"},{"id":"manas-2010:p1347:b001:l027","ordinal":58289,"en":"That was where it streamed."},{"id":"manas-2010:p1347:b001:l028","ordinal":58290,"en":"With devastating Manas at their head,"},{"id":"manas-2010:p1347:b001:l029","ordinal":58291,"en":"All the Kyrgyz together,"},{"id":"manas-2010:p1347:b001:l030","ordinal":58292,"en":"That was where they joined."},{"id":"manas-2010:p1347:b001:l031","ordinal":58293,"en":"The many Chinese warriors,"},{"id":"manas-2010:p1347:b001:l032","ordinal":58294,"en":"With blood-drinking Manas at their head,"},{"id":"manas-2010:p1347:b001:l033","ordinal":58295,"en":"The troops of twelve khans"},{"id":"manas-2010:p1347:b001:l034","ordinal":58296,"en":"Pursued and scattered back."},{"id":"manas-2010:p1347:b001:l035","ordinal":58297,"en":"Shattering the middle,"},{"id":"manas-2010:p1347:b001:l036","ordinal":58298,"en":"Your lion, chief Manas,"},{"id":"manas-2010:p1347:b001:l037","ordinal":58299,"en":"Hewed through and slaughtered."},{"id":"manas-2010:p1347:b001:l038","ordinal":58300,"en":"Around the edges, the forty companions"},{"id":"manas-2010:p1347:b001:l039","ordinal":58301,"en":"Came slaughtering."},{"id":"manas-2010:p1347:b001:l040","ordinal":58302,"en":"The governor's side, Khan Bakay"},{"id":"manas-2010:p1347:b001:l041","ordinal":58303,"en":"Came hemming in."},{"id":"manas-2010:p1347:b001:l042","ordinal":58304,"en":"The Solon side, warrior Töshtük"},{"id":"manas-2010:p1348:b001:l001","ordinal":58305,"en":"Drove and pursued."},{"id":"manas-2010:p1348:b001:l002","ordinal":58306,"en":"Toward Beijing, the many Chinese,"},{"id":"manas-2010:p1348:b001:l003","ordinal":58307,"en":"Unable to summon any courage,"},{"id":"manas-2010:p1348:b001:l004","ordinal":58308,"en":"Fled away in swarms."},{"id":"manas-2010:p1348:b001:l005","ordinal":58309,"en":"When the Chinese fled,"},{"id":"manas-2010:p1348:b001:l006","ordinal":58310,"en":"You could not tell if it was day;"},{"id":"manas-2010:p1348:b001:l007","ordinal":58311,"en":"You could not tell if it was night."},{"id":"manas-2010:p1348:b001:l008","ordinal":58312,"en":"The sky was clear, the earth overcast;"},{"id":"manas-2010:p1348:b001:l009","ordinal":58313,"en":"The face of the earth could not be seen."},{"id":"manas-2010:p1348:b001:l010","ordinal":58314,"en":"Sky and earth became dark dust."},{"id":"manas-2010:p1348:b001:l011","ordinal":58315,"en":"All the people were stunned."},{"id":"manas-2010:p1348:b001:l012","ordinal":58316,"en":"The Chinese were slaughtered and destroyed;"},{"id":"manas-2010:p1348:b001:l013","ordinal":58317,"en":"The whole plain became blood."},{"id":"manas-2010:p1348:b001:l014","ordinal":58318,"en":"The Chinese crowded together;"},{"id":"manas-2010:p1348:b001:l015","ordinal":58319,"en":"Slaughtered, they filled valley after valley."},{"id":"manas-2010:p1348:b001:l016","ordinal":58320,"en":"The Chinese fled, crying out."},{"id":"manas-2010:p1348:b001:l017","ordinal":58321,"en":"Kongurbay could muster no courage,"},{"id":"manas-2010:p1348:b001:l018","ordinal":58322,"en":"Could not halt his teeming people,"},{"id":"manas-2010:p1348:b001:l019","ordinal":58323,"en":"Could not gather his wits."},{"id":"manas-2010:p1348:b001:l020","ordinal":58324,"en":"Kongurbay lost his senses."},{"id":"manas-2010:p1348:b001:l021","ordinal":58325,"en":"“If I do not find a way against Manas,"},{"id":"manas-2010:p1348:b001:l022","ordinal":58326,"en":"If I do not do what must be done!”"},{"id":"manas-2010:p1348:b001:l023","ordinal":58327,"en":"At that time, upon the Chinese,"},{"id":"manas-2010:p1348:b001:l024","ordinal":58328,"en":"The troops of twelve khans"},{"id":"manas-2010:p1348:b001:l025","ordinal":58329,"en":"Had charged, hemming them in."},{"id":"manas-2010:p1348:b001:l026","ordinal":58330,"en":"Into Kürpüldök's yellow water,"},{"id":"manas-2010:p1348:b001:l027","ordinal":58331,"en":"They had driven them."},{"id":"manas-2010:p1348:b001:l028","ordinal":58332,"en":"The great river Kürpüldök,"},{"id":"manas-2010:p1348:b001:l029","ordinal":58333,"en":"When they reached the great river,"},{"id":"manas-2010:p1348:b001:l030","ordinal":58334,"en":"Alöökö's Kongurbay,"},{"id":"manas-2010:p1348:b001:l031","ordinal":58335,"en":"Separating from his army,"},{"id":"manas-2010:p1348:b001:l032","ordinal":58336,"en":"Before Khan Manas,"},{"id":"manas-2010:p1348:b001:l033","ordinal":58337,"en":"Kongurbay, looming large,"},{"id":"manas-2010:p1348:b001:l034","ordinal":58338,"en":"Came out into view."},{"id":"manas-2010:p1348:b001:l035","ordinal":58339,"en":"When he saw Kongurbay,"},{"id":"manas-2010:p1348:b001:l036","ordinal":58340,"en":"Your generous hero grew wrathful."},{"id":"manas-2010:p1348:b001:l037","ordinal":58341,"en":"Your champion, Khan Manas,"},{"id":"manas-2010:p1348:b001:l038","ordinal":58342,"en":"Wind pouring from his mouth,"},{"id":"manas-2010:p1348:b001:l039","ordinal":58343,"en":"Fire coming from his eyes,"},{"id":"manas-2010:p1348:b001:l040","ordinal":58344,"en":"“The other Chinese, the countless governors,"},{"id":"manas-2010:p1348:b001:l041","ordinal":58345,"en":"Why should I attack those wretches?"},{"id":"manas-2010:p1348:b001:l042","ordinal":58346,"en":"Cotton sash, wide boots,"},{"id":"manas-2010:p1349:b001:l001","ordinal":58347,"en":"Let me reach that swaggering dog!”"},{"id":"manas-2010:p1349:b001:l002","ordinal":58348,"en":"Thinking this, hero Manas,"},{"id":"manas-2010:p1349:b001:l003","ordinal":58349,"en":"Without turning back, the mighty lion,"},{"id":"manas-2010:p1349:b001:l004","ordinal":58350,"en":"The hero who stood untroubled,"},{"id":"manas-2010:p1349:b001:l005","ordinal":58351,"en":"At the Fierce One as huge as a hut,"},{"id":"manas-2010:p1349:b001:l006","ordinal":58352,"en":"Roaring, leveled his lance."},{"id":"manas-2010:p1349:b001:l007","ordinal":58353,"en":"His face like buttered wheat,"},{"id":"manas-2010:p1349:b001:l008","ordinal":58354,"en":"His eyes like mist at dusk,"},{"id":"manas-2010:p1349:b001:l009","ordinal":58355,"en":"Above that lance"},{"id":"manas-2010:p1349:b001:l010","ordinal":58356,"en":"Holding his steel blade as well,"},{"id":"manas-2010:p1349:b001:l011","ordinal":58357,"en":"The peerless steed Akkula—"},{"id":"manas-2010:p1349:b001:l012","ordinal":58358,"en":"He gave him his head."},{"id":"manas-2010:p1349:b001:l013","ordinal":58359,"en":"The Fierce One saw his valor;"},{"id":"manas-2010:p1349:b001:l014","ordinal":58360,"en":"Unable to endure his heat,"},{"id":"manas-2010:p1349:b001:l015","ordinal":58361,"en":"Unable to bear his rushing force,"},{"id":"manas-2010:p1349:b001:l016","ordinal":58362,"en":"On the lone path beside the water"},{"id":"manas-2010:p1349:b001:l017","ordinal":58363,"en":"He wheeled and darted aside."},{"id":"manas-2010:p1349:b001:l018","ordinal":58364,"en":"Dodging like a fox,"},{"id":"manas-2010:p1349:b001:l019","ordinal":58365,"en":"He fled back and slipped away."},{"id":"manas-2010:p1349:b001:l020","ordinal":58366,"en":"Akkula, a steed among beasts,"},{"id":"manas-2010:p1349:b001:l021","ordinal":58367,"en":"Had not yet been ridden much against the foe;"},{"id":"manas-2010:p1349:b001:l022","ordinal":58368,"en":"He had regained his flesh, curse him,"}]
