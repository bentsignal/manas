[{"id":"semetey-1-2013:p1146:b003:l010","ordinal":164609,"en":"The breast holds many sorrows."},{"id":"semetey-1-2013:p1146:b003:l011","ordinal":164610,"en":"We have come and attacked a numerous people;"},{"id":"semetey-1-2013:p1146:b003:l012","ordinal":164611,"en":"Such is this treacherous false world."},{"id":"semetey-1-2013:p1146:b003:l013","ordinal":164612,"en":"Of the sons of Muslims,"},{"id":"semetey-1-2013:p1146:b003:l014","ordinal":164613,"en":"Exactly a thousand souls remain."},{"id":"semetey-1-2013:p1146:b003:l015","ordinal":164614,"en":"Taking wives from the Chinese,"},{"id":"semetey-1-2013:p1146:b003:l016","ordinal":164615,"en":"There remains Turkan;"},{"id":"semetey-1-2013:p1146:b003:l017","ordinal":164616,"en":"If you ask, you will find him,"},{"id":"semetey-1-2013:p1146:b003:l018","ordinal":164617,"en":"The true Muslim Turdana."},{"id":"semetey-1-2013:p1146:b003:l019","ordinal":164618,"en":"If we lament, great sorrow comes forth;"},{"id":"semetey-1-2013:p1146:b003:l020","ordinal":164619,"en":"If you ask, you will find"},{"id":"semetey-1-2013:p1146:b003:l021","ordinal":164620,"en":"True Kyrgyz descendants"},{"id":"semetey-1-2013:p1146:b003:l022","ordinal":164621,"en":"In Beijing of Kakanchyn,"},{"id":"semetey-1-2013:p1146:b003:l023","ordinal":164622,"en":"A people called Salaalyk."},{"id":"semetey-1-2013:p1146:b003:l024","ordinal":164623,"en":"Calling it Kökötöy's feast,"},{"id":"semetey-1-2013:p1146:b003:l025","ordinal":164624,"en":"We have come to the feast;"},{"id":"semetey-1-2013:p1146:b003:l026","ordinal":164625,"en":"If quarrels arise, we have come"},{"id":"semetey-1-2013:p1146:b003:l027","ordinal":164626,"en":"To meet what falls upon our heads."},{"id":"semetey-1-2013:p1146:b003:l028","ordinal":164627,"en":"We have come to see"},{"id":"semetey-1-2013:p1146:b003:l029","ordinal":164628,"en":"Kökötöy's festive feast;"},{"id":"semetey-1-2013:p1146:b003:l030","ordinal":164629,"en":"We have come to be plundered"},{"id":"semetey-1-2013:p1146:b003:l031","ordinal":164630,"en":"And die at the hands of the Black Chinese."},{"id":"semetey-1-2013:p1146:b003:l032","ordinal":164631,"en":"We have come to give our inheritance"},{"id":"semetey-1-2013:p1146:b003:l033","ordinal":164632,"en":"To the Enchi-Kuyun Kalmyks."},{"id":"semetey-1-2013:p1146:b003:l034","ordinal":164633,"en":"Heeding Köpkölöng's words,"},{"id":"semetey-1-2013:p1146:b003:l035","ordinal":164634,"en":"We have come here to die."},{"id":"semetey-1-2013:p1146:b003:l036","ordinal":164635,"en":"While my beard is white as a swan,"},{"id":"semetey-1-2013:p1146:b003:l037","ordinal":164636,"en":"While my journey's end is near,"},{"id":"semetey-1-2013:p1146:b003:l038","ordinal":164637,"en":"God has struck the Burut,"},{"id":"semetey-1-2013:p1146:b003:l039","ordinal":164638,"en":"For they stand trembling against us."},{"id":"semetey-1-2013:p1146:b004:l001","ordinal":164639,"en":"When my time has passed,"},{"id":"semetey-1-2013:p1146:b004:l002","ordinal":164640,"en":"God has struck the Chinese,"},{"id":"semetey-1-2013:p1146:b004:l003","ordinal":164641,"en":"For they stand opposing us."},{"id":"semetey-1-2013:p1146:b004:l004","ordinal":164642,"en":"The swaggering Kalcha, the formidable one—"},{"id":"semetey-1-2013:p1146:b004:l005","ordinal":164643,"en":"If his strength suffices, these Chinese"},{"id":"semetey-1-2013:p1146:b004:l006","ordinal":164644,"en":"Have the power to fight."},{"id":"semetey-1-2013:p1146:b004:l007","ordinal":164645,"en":"Among the seething infidels,"},{"id":"semetey-1-2013:p1146:b004:l008","ordinal":164646,"en":"With heroic Khan Kongurbai,"},{"id":"semetey-1-2013:p1146:b004:l009","ordinal":164647,"en":"There are those who know no human tongue,"},{"id":"semetey-1-2013:p1146:b004:l010","ordinal":164648,"en":"Whose words resemble beasts' cries."},{"id":"semetey-1-2013:p1146:b004:l011","ordinal":164649,"en":"There is a mountain-like cyclops"},{"id":"semetey-1-2013:p1146:b004:l012","ordinal":164650,"en":"Who crushes anyone beside him."},{"id":"semetey-1-2013:p1146:b004:l013","ordinal":164651,"en":"They have heroes of many kinds"},{"id":"semetey-1-2013:p1146:b004:l014","ordinal":164652,"en":"And revenge for their fathers."},{"id":"semetey-1-2013:p1146:b004:l015","ordinal":164653,"en":"If they find the chance,"},{"id":"semetey-1-2013:p1146:b004:l016","ordinal":164654,"en":"They have reason to fight us."},{"id":"semetey-1-2013:p1146:b004:l017","ordinal":164655,"en":"The bellowing infidels"},{"id":"semetey-1-2013:p1146:b004:l018","ordinal":164656,"en":"Have armor no bullet pierces;"},{"id":"semetey-1-2013:p1146:b004:l019","ordinal":164657,"en":"Think of their dagger-men."},{"id":"semetey-1-2013:p1146:b004:l020","ordinal":164658,"en":"The infidels came in strength,"},{"id":"semetey-1-2013:p1146:b004:l021","ordinal":164659,"en":"Their waists girded with resolve."},{"id":"semetey-1-2013:p1146:b004:l022","ordinal":164660,"en":"They have heroes held in readiness,"},{"id":"semetey-1-2013:p1146:b004:l023","ordinal":164661,"en":"Ready to cause disaster"},{"id":"semetey-1-2013:p1146:b004:l024","ordinal":164662,"en":"And confront us at this feast."},{"id":"semetey-1-2013:p1146:b004:l025","ordinal":164663,"en":"Without quarreling or disputing,"},{"id":"semetey-1-2013:p1146:b004:l026","ordinal":164664,"en":"Let us consent to their demand"},{"id":"semetey-1-2013:p1146:b004:l027","ordinal":164665,"en":"And present them Maaniker."},{"id":"semetey-1-2013:p1146:b004:l028","ordinal":164666,"en":"Let us deceive them with the horse;"},{"id":"semetey-1-2013:p1146:b004:l029","ordinal":164667,"en":"Let us find this solution.”"},{"id":"semetey-1-2013:p1146:b004:l030","ordinal":164668,"en":"Your uncle Koshoy honked loudly"},{"id":"semetey-1-2013:p1146:b004:l031","ordinal":164669,"en":"And offered these words."},{"id":"semetey-1-2013:p1146:b004:l032","ordinal":164670,"en":"After him Bokmurun"},{"id":"semetey-1-2013:p1146:b004:l033","ordinal":164671,"en":"Joined in and said:"},{"id":"semetey-1-2013:p1146:b004:l034","ordinal":164672,"en":"“They gathered and came to my feast,"},{"id":"semetey-1-2013:p1146:b004:l035","ordinal":164673,"en":"And struck my head with a club;"},{"id":"semetey-1-2013:p1146:b004:l036","ordinal":164674,"en":"They trampled my wishes"},{"id":"semetey-1-2013:p1146:b004:l037","ordinal":164675,"en":"And used force at my feast."},{"id":"semetey-1-2013:p1146:b004:l038","ordinal":164676,"en":"If we do not consent to their demand,"},{"id":"semetey-1-2013:p1146:b004:l039","ordinal":164677,"en":"Perhaps they will seize all the plunder,"},{"id":"semetey-1-2013:p1147:b003:l001","ordinal":164678,"en":"Perhaps they will bring harsh devastation,"},{"id":"semetey-1-2013:p1147:b003:l002","ordinal":164679,"en":"Overrun the village now,"},{"id":"semetey-1-2013:p1147:b003:l003","ordinal":164680,"en":"And scatter the white-gold goods."},{"id":"semetey-1-2013:p1147:b003:l004","ordinal":164681,"en":"Perhaps we will all meet our end;"},{"id":"semetey-1-2013:p1147:b003:l005","ordinal":164682,"en":"Why did we give this exhausting feast?"},{"id":"semetey-1-2013:p1147:b003:l006","ordinal":164683,"en":"Perhaps they will plunder everything."},{"id":"semetey-1-2013:p1147:b003:l007","ordinal":164684,"en":"Here is the feast if you want its spectacle;"},{"id":"semetey-1-2013:p1147:b003:l008","ordinal":164685,"en":"Saying, “You have done wrong,”"},{"id":"semetey-1-2013:p1147:b003:l009","ordinal":164686,"en":"Here is my head if you cut it off."},{"id":"semetey-1-2013:p1147:b003:l010","ordinal":164687,"en":"They have brought disaster to my house"},{"id":"semetey-1-2013:p1147:b003:l011","ordinal":164688,"en":"And will utterly end my line."},{"id":"semetey-1-2013:p1147:b003:l012","ordinal":164689,"en":"It was livestock left by my father;"},{"id":"semetey-1-2013:p1147:b003:l013","ordinal":164690,"en":"These Chinese are demanding"},{"id":"semetey-1-2013:p1147:b003:l014","ordinal":164691,"en":"The swift horse Maaniker."},{"id":"semetey-1-2013:p1147:b003:l015","ordinal":164692,"en":"If I do not give Maaniker,"},{"id":"semetey-1-2013:p1147:b003:l016","ordinal":164693,"en":"They stand ready to cause turmoil.”"},{"id":"semetey-1-2013:p1147:b003:l017","ordinal":164694,"en":"Bokmurun came weeping"},{"id":"semetey-1-2013:p1147:b003:l018","ordinal":164695,"en":"And presented Manas"},{"id":"semetey-1-2013:p1147:b003:l019","ordinal":164696,"en":"Kökötöy's great ingot, large as a bucket."},{"id":"semetey-1-2013:p1147:b003:l020","ordinal":164697,"en":"It was a great ingot."},{"id":"semetey-1-2013:p1147:b003:l021","ordinal":164698,"en":"Manas accepted the gift"},{"id":"semetey-1-2013:p1147:b003:l022","ordinal":164699,"en":"And handed it to his uncle Bakai."},{"id":"semetey-1-2013:p1147:b003:l023","ordinal":164700,"en":"His thirst for blood seized him strongly,"},{"id":"semetey-1-2013:p1147:b003:l024","ordinal":164701,"en":"And he said to Koshoy:"},{"id":"semetey-1-2013:p1147:b003:l025","ordinal":164702,"en":"“Your life has grown long;"},{"id":"semetey-1-2013:p1147:b003:l026","ordinal":164703,"en":"You have become querulous."},{"id":"semetey-1-2013:p1147:b003:l027","ordinal":164704,"en":"Strength has left your body,"},{"id":"semetey-1-2013:p1147:b003:l028","ordinal":164705,"en":"And you have grown weary."},{"id":"semetey-1-2013:p1147:b003:l029","ordinal":164706,"en":"When the Black Kalmyks pressed you,"},{"id":"semetey-1-2013:p1147:b003:l030","ordinal":164707,"en":"You have come to nothing."},{"id":"semetey-1-2013:p1147:b003:l031","ordinal":164708,"en":"Power has left your body;"},{"id":"semetey-1-2013:p1147:b003:l032","ordinal":164709,"en":"Your body has lost its power."},{"id":"semetey-1-2013:p1147:b003:l033","ordinal":164710,"en":"You have become useless."},{"id":"semetey-1-2013:p1147:b003:l034","ordinal":164711,"en":"These Chinese act as tyrants;"},{"id":"semetey-1-2013:p1147:b003:l035","ordinal":164712,"en":"I have no time to lie in the uplands."},{"id":"semetey-1-2013:p1147:b003:l036","ordinal":164713,"en":"If these Chinese bluster,"},{"id":"semetey-1-2013:p1147:b003:l037","ordinal":164714,"en":"I have no life I would spare from death."},{"id":"semetey-1-2013:p1147:b003:l038","ordinal":164715,"en":"While my dear soul lives,"},{"id":"semetey-1-2013:p1147:b003:l039","ordinal":164716,"en":"I have no livestock to offer the Chinese,"},{"id":"semetey-1-2013:p1147:b005:l001","ordinal":164717,"en":"And no time to give Maaniker."},{"id":"semetey-1-2013:p1147:b005:l002","ordinal":164718,"en":"If your infidels scowl,"},{"id":"semetey-1-2013:p1147:b005:l003","ordinal":164719,"en":"I have no soul that will shrink back."},{"id":"semetey-1-2013:p1147:b005:l004","ordinal":164720,"en":"Sense has fled your body;"},{"id":"semetey-1-2013:p1147:b005:l005","ordinal":164721,"en":"You have come to nothing."},{"id":"semetey-1-2013:p1147:b005:l006","ordinal":164722,"en":"Your courage has gone with age;"},{"id":"semetey-1-2013:p1147:b005:l007","ordinal":164723,"en":"Dear uncle and leopard,"},{"id":"semetey-1-2013:p1147:b005:l008","ordinal":164724,"en":"You have become useless."},{"id":"semetey-1-2013:p1147:b005:l009","ordinal":164725,"en":"If the Chinese scowl in anger"},{"id":"semetey-1-2013:p1147:b005:l010","ordinal":164726,"en":"And take Maaniker today,"},{"id":"semetey-1-2013:p1147:b005:l011","ordinal":164727,"en":"Growing insolent tomorrow,"},{"id":"semetey-1-2013:p1147:b005:l012","ordinal":164728,"en":"Will they not take Akkula too?"},{"id":"semetey-1-2013:p1147:b005:l013","ordinal":164729,"en":"Will they not add him as well?"},{"id":"semetey-1-2013:p1147:b005:l014","ordinal":164730,"en":"The following day they may come"},{"id":"semetey-1-2013:p1147:b005:l015","ordinal":164731,"en":"And take in the same way"},{"id":"semetey-1-2013:p1147:b005:l016","ordinal":164732,"en":"Many leopard-like racehorses."},{"id":"semetey-1-2013:p1147:b005:l017","ordinal":164733,"en":"Those many swift horses."},{"id":"semetey-1-2013:p1147:b005:l018","ordinal":164734,"en":"Will they not strip away the swift horses?"},{"id":"semetey-1-2013:p1147:b005:l019","ordinal":164735,"en":"When we are left on foot and downcast,"},{"id":"semetey-1-2013:p1147:b005:l020","ordinal":164736,"en":"Will they not bring hell every day?"},{"id":"semetey-1-2013:p1147:b005:l021","ordinal":164737,"en":"If we are parted from our racehorses,"},{"id":"semetey-1-2013:p1147:b005:l022","ordinal":164738,"en":"Will the Muslim giants not"},{"id":"semetey-1-2013:p1147:b005:l023","ordinal":164739,"en":"Carry their saddles on their backs"},{"id":"semetey-1-2013:p1147:b005:l024","ordinal":164740,"en":"And suffer bitter hardship?"},{"id":"semetey-1-2013:p1147:b005:l025","ordinal":164741,"en":"Will they not suffer?"},{"id":"semetey-1-2013:p1147:b005:l026","ordinal":164742,"en":"Will the Chinese not do as they please?"},{"id":"semetey-1-2013:p1147:b005:l027","ordinal":164743,"en":"Will God not strike us thus,"},{"id":"semetey-1-2013:p1147:b005:l028","ordinal":164744,"en":"And will they not drive us on foot and kill us?"},{"id":"semetey-1-2013:p1147:b005:l029","ordinal":164745,"en":"The seething infidels"},{"id":"semetey-1-2013:p1147:b005:l030","ordinal":164746,"en":"Will part you from your horses"},{"id":"semetey-1-2013:p1147:b005:l031","ordinal":164747,"en":"And scatter all four kinds of livestock;"},{"id":"semetey-1-2013:p1147:b005:l032","ordinal":164748,"en":"Will they not dig a well in your place of honor?"},{"id":"semetey-1-2013:p1147:b005:l033","ordinal":164749,"en":"Will they not bind your heroes?"},{"id":"semetey-1-2013:p1147:b005:l034","ordinal":164750,"en":"Once left helpless on foot,"},{"id":"semetey-1-2013:p1147:b005:l035","ordinal":164751,"en":"Will they not bring calamity?"},{"id":"semetey-1-2013:p1147:b005:l036","ordinal":164752,"en":"Will the Chinese not do as they please"},{"id":"semetey-1-2013:p1147:b005:l037","ordinal":164753,"en":"And slaughter every one of you?"},{"id":"semetey-1-2013:p1147:b005:l038","ordinal":164754,"en":"Will they not cross over your flank"},{"id":"semetey-1-2013:p1147:b005:l039","ordinal":164755,"en":"And scatter your great wealth?”"},{"id":"semetey-1-2013:p1148:b003:l001","ordinal":164756,"en":"Would they not all recognize the treachery?"},{"id":"semetey-1-2013:p1148:b003:l002","ordinal":164757,"en":"If we let the Chinese slaughter"},{"id":"semetey-1-2013:p1148:b003:l003","ordinal":164758,"en":"The mere handful of Muslims,"},{"id":"semetey-1-2013:p1148:b003:l004","ordinal":164759,"en":"On the dawn of Judgment Day,"},{"id":"semetey-1-2013:p1148:b003:l005","ordinal":164760,"en":"Will they not ride us like black donkeys?"},{"id":"semetey-1-2013:p1148:b003:l006","ordinal":164761,"en":"One day we will die in the end;"},{"id":"semetey-1-2013:p1148:b003:l007","ordinal":164762,"en":"If the creatures accuse us,"},{"id":"semetey-1-2013:p1148:b003:l008","ordinal":164763,"en":"Saying we surrendered it from fear,"},{"id":"semetey-1-2013:p1148:b003:l009","ordinal":164764,"en":"What answer will we give?"},{"id":"semetey-1-2013:p1148:b003:l010","ordinal":164765,"en":"While I possess robust strength,"},{"id":"semetey-1-2013:p1148:b003:l011","ordinal":164766,"en":"How can I give away my racehorse!"},{"id":"semetey-1-2013:p1148:b003:l012","ordinal":164767,"en":"Let me contend"},{"id":"semetey-1-2013:p1148:b003:l013","ordinal":164768,"en":"With the Chinese gathering strength."},{"id":"semetey-1-2013:p1148:b003:l014","ordinal":164769,"en":"To the Chinese infidels before me,"},{"id":"semetey-1-2013:p1148:b003:l015","ordinal":164770,"en":"While my falcon head remains,"},{"id":"semetey-1-2013:p1148:b003:l016","ordinal":164771,"en":"How can I give my thoroughbred!"},{"id":"semetey-1-2013:p1148:b003:l017","ordinal":164772,"en":"If they commit outright violence,"},{"id":"semetey-1-2013:p1148:b003:l018","ordinal":164773,"en":"Let me grapple with them!"},{"id":"semetey-1-2013:p1148:b003:l019","ordinal":164774,"en":"If the Kalmyks bring disaster,"},{"id":"semetey-1-2013:p1148:b003:l020","ordinal":164775,"en":"I will drive them toward Altai."},{"id":"semetey-1-2013:p1148:b003:l021","ordinal":164776,"en":"Now I will slice the scalp"},{"id":"semetey-1-2013:p1148:b003:l022","ordinal":164777,"en":"Of damned Zholoy!"},{"id":"semetey-1-2013:p1148:b003:l023","ordinal":164778,"en":"The seething Chinese people"},{"id":"semetey-1-2013:p1148:b003:l024","ordinal":164779,"en":"Seem eager for it;"},{"id":"semetey-1-2013:p1148:b003:l025","ordinal":164780,"en":"Let me fight them to the death!"},{"id":"semetey-1-2013:p1148:b003:l026","ordinal":164781,"en":"I will mount Akkula;"},{"id":"semetey-1-2013:p1148:b003:l027","ordinal":164782,"en":"The swine have multiplied,"},{"id":"semetey-1-2013:p1148:b003:l028","ordinal":164783,"en":"And I will drive them as far as Kakan."},{"id":"semetey-1-2013:p1148:b003:l029","ordinal":164784,"en":"Fed full at the feast, these Chinese"},{"id":"semetey-1-2013:p1148:b003:l030","ordinal":164785,"en":"Seem to have grown ravenous."},{"id":"semetey-1-2013:p1148:b003:l031","ordinal":164786,"en":"They seem to have gone mad,"},{"id":"semetey-1-2013:p1148:b003:l032","ordinal":164787,"en":"Becoming men eager to wrestle."},{"id":"semetey-1-2013:p1148:b003:l033","ordinal":164788,"en":"If the Chinese behave like this,"},{"id":"semetey-1-2013:p1148:b003:l034","ordinal":164789,"en":"I will pull out their stopper."},{"id":"semetey-1-2013:p1148:b003:l035","ordinal":164790,"en":"If the dogs start tearing at us,"},{"id":"semetey-1-2013:p1148:b003:l036","ordinal":164791,"en":"I will slaughter them utterly."},{"id":"semetey-1-2013:p1148:b003:l037","ordinal":164792,"en":"I will take the horse"},{"id":"semetey-1-2013:p1148:b003:l038","ordinal":164793,"en":"Of the infidel who acts as tyrant."},{"id":"semetey-1-2013:p1148:b003:l039","ordinal":164794,"en":"If these Chinese act as tyrants,"},{"id":"semetey-1-2013:p1148:b004:l001","ordinal":164795,"en":"I will slaughter them to the last."},{"id":"semetey-1-2013:p1148:b004:l002","ordinal":164796,"en":"If they find warfare pleasing,"},{"id":"semetey-1-2013:p1148:b004:l003","ordinal":164797,"en":"I will slaughter them until they wither."},{"id":"semetey-1-2013:p1148:b004:l004","ordinal":164798,"en":"If this is truly their intent,"},{"id":"semetey-1-2013:p1148:b004:l005","ordinal":164799,"en":"I will remain and trade spears!"},{"id":"semetey-1-2013:p1148:b004:l006","ordinal":164800,"en":"I will first offer warm words:"},{"id":"semetey-1-2013:p1148:b004:l007","ordinal":164801,"en":"‘You came as guests; stop.’"},{"id":"semetey-1-2013:p1148:b004:l008","ordinal":164802,"en":"I will go to the baldheads"},{"id":"semetey-1-2013:p1148:b004:l009","ordinal":164803,"en":"Of the stone-carrying Chinese."},{"id":"semetey-1-2013:p1148:b004:l010","ordinal":164804,"en":"If they do not heed my words,"},{"id":"semetey-1-2013:p1148:b004:l011","ordinal":164805,"en":"I will fight them to destruction.”"},{"id":"semetey-1-2013:p1148:b004:l012","ordinal":164806,"en":"Thus brave Manas spoke,"},{"id":"semetey-1-2013:p1148:b004:l013","ordinal":164807,"en":"His eyes like twilight mist,"},{"id":"semetey-1-2013:p1148:b004:l014","ordinal":164808,"en":"His face like oiled wheat,"},{"id":"semetey-1-2013:p1148:b004:l015","ordinal":164809,"en":"Venom pouring from his face,"},{"id":"semetey-1-2013:p1148:b004:l016","ordinal":164810,"en":"His form like a naked blade."},{"id":"semetey-1-2013:p1148:b004:l017","ordinal":164811,"en":"When seen from the front,"},{"id":"semetey-1-2013:p1148:b004:l018","ordinal":164812,"en":"Your magnanimous Sultan Manas"},{"id":"semetey-1-2013:p1148:b004:l019","ordinal":164813,"en":"Had the dread of a dragon."},{"id":"semetey-1-2013:p1148:b004:l020","ordinal":164814,"en":"When seen from behind,"},{"id":"semetey-1-2013:p1148:b004:l021","ordinal":164815,"en":"He had the dread of a thousand men."},{"id":"semetey-1-2013:p1148:b004:l022","ordinal":164816,"en":"Preparing his weapons and gear,"},{"id":"semetey-1-2013:p1148:b004:l023","ordinal":164817,"en":"If you saw your gray wolf,"},{"id":"semetey-1-2013:p1148:b004:l024","ordinal":164818,"en":"He raged like a blue tiger."},{"id":"semetey-1-2013:p1148:b004:l025","ordinal":164819,"en":"Making his dun horse prance,"},{"id":"semetey-1-2013:p1148:b004:l026","ordinal":164820,"en":"He split straight through the center"},{"id":"semetey-1-2013:p1148:b004:l027","ordinal":164821,"en":"Of the seething infidels."},{"id":"semetey-1-2013:p1148:b004:l028","ordinal":164822,"en":"Toward Zholoy and Ezkara,"},{"id":"semetey-1-2013:p1148:b004:l029","ordinal":164823,"en":"Those calamity-bringers,"},{"id":"semetey-1-2013:p1148:b004:l030","ordinal":164824,"en":"He turned his horse's head."},{"id":"semetey-1-2013:p1148:b004:l031","ordinal":164825,"en":"Khan Manas rode through"},{"id":"semetey-1-2013:p1148:b004:l032","ordinal":164826,"en":"And stood wrathfully"},{"id":"semetey-1-2013:p1148:b004:l033","ordinal":164827,"en":"Beside those two:"},{"id":"semetey-1-2013:p1148:b004:l034","ordinal":164828,"en":"“You assembled Chinese people,"},{"id":"semetey-1-2013:p1148:b004:l035","ordinal":164829,"en":"This is Kökötöy's feast."},{"id":"semetey-1-2013:p1148:b004:l036","ordinal":164830,"en":"The Burut are not a headless people;"},{"id":"semetey-1-2013:p1148:b004:l037","ordinal":164831,"en":"Gray-wolf Manas is their head!"},{"id":"semetey-1-2013:p1148:b004:l038","ordinal":164832,"en":"I honored you with an invitation;"},{"id":"semetey-1-2013:p1148:b004:l039","ordinal":164833,"en":"Eat your meat with honor."},{"id":"semetey-1-2013:p1149:b003:l001","ordinal":164834,"en":"You are not a Kalmyk who will take;"},{"id":"semetey-1-2013:p1149:b003:l002","ordinal":164835,"en":"I am not a Kyrgyz who will surrender."},{"id":"semetey-1-2013:p1149:b003:l003","ordinal":164836,"en":"You are not Chinese who will strike;"},{"id":"semetey-1-2013:p1149:b003:l004","ordinal":164837,"en":"I am not Kyrgyz who will be struck!"},{"id":"semetey-1-2013:p1149:b003:l005","ordinal":164838,"en":"Lay aside force and eat your feast, Chinese;"},{"id":"semetey-1-2013:p1149:b003:l006","ordinal":164839,"en":"Otherwise you will contend with me!"},{"id":"semetey-1-2013:p1149:b003:l007","ordinal":164840,"en":"Until the soft reeds ripen,"},{"id":"semetey-1-2013:p1149:b003:l008","ordinal":164841,"en":"Until the law's ashes fly,"},{"id":"semetey-1-2013:p1149:b003:l009","ordinal":164842,"en":"I will fight firmly for six months."},{"id":"semetey-1-2013:p1149:b003:l010","ordinal":164843,"en":"When I was twelve years old,"},{"id":"semetey-1-2013:p1149:b003:l011","ordinal":164844,"en":"Khan Zholoy of the Kalmyks,"},{"id":"semetey-1-2013:p1149:b003:l012","ordinal":164845,"en":"When you brought havoc upon Altai,"},{"id":"semetey-1-2013:p1149:b003:l013","ordinal":164846,"en":"I slaughtered six thousand of your men, Zholoy;"},{"id":"semetey-1-2013:p1149:b003:l014","ordinal":164847,"en":"I raided sixty of your villages,"},{"id":"semetey-1-2013:p1149:b003:l015","ordinal":164848,"en":"Zholoy."},{"id":"semetey-1-2013:p1149:b003:l016","ordinal":164849,"en":"When you gave your stubbornness free rein, Zholoy,"},{"id":"semetey-1-2013:p1149:b003:l017","ordinal":164850,"en":"When I captured your monk,"},{"id":"semetey-1-2013:p1149:b003:l018","ordinal":164851,"en":"When he would not speak,"},{"id":"semetey-1-2013:p1149:b003:l019","ordinal":164852,"en":"I cut off his kекес,"},{"id":"semetey-1-2013:p1149:b003:l020","ordinal":164853,"en":"When havoc arose yesterday,"},{"id":"semetey-1-2013:p1149:b003:l021","ordinal":164854,"en":"I was the one who went to battle."},{"id":"semetey-1-2013:p1149:b003:l022","ordinal":164855,"en":"Seizing it as plunder,"},{"id":"semetey-1-2013:p1149:b003:l023","ordinal":164856,"en":"I took a thousand camel-loads of your tea."},{"id":"semetey-1-2013:p1149:b003:l024","ordinal":164857,"en":"All thousand of your wrestlers"},{"id":"semetey-1-2013:p1149:b003:l025","ordinal":164858,"en":"I had slaughtered,"},{"id":"semetey-1-2013:p1149:b003:l026","ordinal":164859,"en":"Zholoy."},{"id":"semetey-1-2013:p1149:b003:l027","ordinal":164860,"en":"Have you become a man here, Zholoy?"},{"id":"semetey-1-2013:p1149:b003:l028","ordinal":164861,"en":"In the hollow of Ükürchü,"},{"id":"semetey-1-2013:p1149:b003:l029","ordinal":164862,"en":"Along Üch-Kapkak,"},{"id":"semetey-1-2013:p1149:b003:l030","ordinal":164863,"en":"I brought devastation."},{"id":"semetey-1-2013:p1149:b003:l031","ordinal":164864,"en":"Not only your horses—"}]
