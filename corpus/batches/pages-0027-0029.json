  "notes": {
    "manas-2010:p0027:b002:l023": "милек is uncertain in this witness; countless is the contextual antithesis of we are few, not a certified lexical reading.",
    "manas-2010:p0027:b002:l037": "жаңжуусу rendered commander; rank equivalence remains provisional.",
    "manas-2010:p0027:b002:l046": "денекул rendered slaves for life, following the source glossary sense reproduced at speak.tatar, part 62.",
    "manas-2010:p0028:b002:l012": "Эңкүгө бүткөн пас is uncertain; brought down into the depths is provisional.",
    "manas-2010:p0028:b002:l047": "The subject/object of Колго түшсө бул кытай is uncertain. Draft retains Chinese as subject of fall into my hands rather than silently changing it to we.",
    "manas-2010:p0029:b002:l039": "илек retained as ilek. Yudakhin notes its literal hundred-thousand origin but an epic indefinite multitude sense, so no exact headcount is invented.",
    "manas-2010:p0029:b002:l041": "Six ilek preserved; see the ilek note two source lines above."
  }
