[{"id":"manas-2010:p1019:b001:l018","ordinal":44545,"en":"Before even that much time had passed,"},{"id":"manas-2010:p1019:b001:l019","ordinal":44546,"en":"Before warrior Syrgak had closed his mouth,"},{"id":"manas-2010:p1019:b001:l020","ordinal":44547,"en":"Wearing a coat fit for battle,"},{"id":"manas-2010:p1019:b001:l021","ordinal":44548,"en":"Riding at an amble,"},{"id":"manas-2010:p1019:b001:l022","ordinal":44549,"en":"Mounted on a horse like Kögala,"},{"id":"manas-2010:p1019:b001:l023","ordinal":44550,"en":"His hem and sleeves spread out,"},{"id":"manas-2010:p1019:b001:l024","ordinal":44551,"en":"When he came to the downward slope,"},{"id":"manas-2010:p1019:b001:l025","ordinal":44552,"en":"He stepped in excitement, in excitement."},{"id":"manas-2010:p1019:b001:l026","ordinal":44553,"en":"His hooves sank in the sand."},{"id":"manas-2010:p1019:b001:l027","ordinal":44554,"en":"When he began climbing up,"},{"id":"manas-2010:p1019:b001:l028","ordinal":44555,"en":"The imperious courser Kögala,"},{"id":"manas-2010:p1019:b001:l029","ordinal":44556,"en":"His mane and tail spread out,"},{"id":"manas-2010:p1019:b001:l030","ordinal":44557,"en":"Kögala, who had galloped from afar,"},{"id":"manas-2010:p1019:b001:l031","ordinal":44558,"en":"Leaned upon his bear-like chest."},{"id":"manas-2010:p1019:b001:l032","ordinal":44559,"en":"His apple-shaped round head,"},{"id":"manas-2010:p1019:b001:l033","ordinal":44560,"en":"Weaving, wrapped in dust,"},{"id":"manas-2010:p1019:b001:l034","ordinal":44561,"en":"His neck curved like tongs,"},{"id":"manas-2010:p1019:b001:l035","ordinal":44562,"en":"Knowing neither uphill nor downhill,"},{"id":"manas-2010:p1019:b001:l036","ordinal":44563,"en":"He ran like a flying bird."},{"id":"manas-2010:p1019:b001:l037","ordinal":44564,"en":"Stones beneath his tread crumbled."},{"id":"manas-2010:p1019:b001:l038","ordinal":44565,"en":"Clods big as cauldrons"},{"id":"manas-2010:p1019:b001:l039","ordinal":44566,"en":"Whistled above his head."},{"id":"manas-2010:p1019:b001:l040","ordinal":44567,"en":"His ravenous mouth gaped open."},{"id":"manas-2010:p1019:b001:l041","ordinal":44568,"en":"White foam mixed with blood"},{"id":"manas-2010:p1019:b001:l042","ordinal":44569,"en":"Scattered over his chest."},{"id":"manas-2010:p1020:b001:l001","ordinal":44570,"en":"The swift steed Kögala,"},{"id":"manas-2010:p1020:b001:l002","ordinal":44571,"en":"Sending his forelock flying skyward,"},{"id":"manas-2010:p1020:b001:l003","ordinal":44572,"en":"Thrusting and plunging his hooves,"},{"id":"manas-2010:p1020:b001:l004","ordinal":44573,"en":"The stones flung from his hooves"},{"id":"manas-2010:p1020:b001:l005","ordinal":44574,"en":"He hurled sky-high."},{"id":"manas-2010:p1020:b001:l006","ordinal":44575,"en":"He lowered his head to the earth."},{"id":"manas-2010:p1020:b001:l007","ordinal":44576,"en":"“My destination is Beijing,”"},{"id":"manas-2010:p1020:b001:l008","ordinal":44577,"en":"Though a beast, he knew."},{"id":"manas-2010:p1020:b001:l009","ordinal":44578,"en":"Speeding like a fired shot,"},{"id":"manas-2010:p1020:b001:l010","ordinal":44579,"en":"His body had grown hot."},{"id":"manas-2010:p1020:b001:l011","ordinal":44580,"en":"No soul could withstand his wrath,"},{"id":"manas-2010:p1020:b001:l012","ordinal":44581,"en":"The wrath of mighty Chubak."},{"id":"manas-2010:p1020:b001:l013","ordinal":44582,"en":"The earth split with a roar,"},{"id":"manas-2010:p1020:b001:l014","ordinal":44583,"en":"He shouted like a lion,"},{"id":"manas-2010:p1020:b001:l015","ordinal":44584,"en":"Thundered like the sky."},{"id":"manas-2010:p1020:b001:l016","ordinal":44585,"en":"Golden forelock, tasseled sash,"},{"id":"manas-2010:p1020:b001:l017","ordinal":44586,"en":"Azizkan's blue-maned one,"},{"id":"manas-2010:p1020:b001:l018","ordinal":44587,"en":"At the sight of warrior Chubak,"},{"id":"manas-2010:p1020:b001:l019","ordinal":44588,"en":"Now turned his mount."},{"id":"manas-2010:p1020:b001:l020","ordinal":44589,"en":"When Chubak came in fury,"},{"id":"manas-2010:p1020:b001:l021","ordinal":44590,"en":"Blue-maned lion Almambet"},{"id":"manas-2010:p1020:b001:l022","ordinal":44591,"en":"Gave him an open greeting."},{"id":"manas-2010:p1020:b001:l023","ordinal":44592,"en":"Chubak did not return the greeting."},{"id":"manas-2010:p1020:b001:l024","ordinal":44593,"en":"Then the blue-maned one spoke:"},{"id":"manas-2010:p1020:b001:l025","ordinal":44594,"en":"‘Hero Chubak, my champion,"},{"id":"manas-2010:p1020:b001:l026","ordinal":44595,"en":"So many sins,"},{"id":"manas-2010:p1020:b001:l027","ordinal":44596,"en":"Who is your lion to shoulder and bear them?"},{"id":"manas-2010:p1020:b001:l028","ordinal":44597,"en":"You have become enraged,"},{"id":"manas-2010:p1020:b001:l029","ordinal":44598,"en":"You have drawn your sword."},{"id":"manas-2010:p1020:b001:l030","ordinal":44599,"en":"Is there an iron net spread out?"},{"id":"manas-2010:p1020:b001:l031","ordinal":44600,"en":"Is there a road running alongside?"},{"id":"manas-2010:p1020:b001:l032","ordinal":44601,"en":"Is there a road blocked off?"},{"id":"manas-2010:p1020:b001:l033","ordinal":44602,"en":"You have become terribly hurried."},{"id":"manas-2010:p1020:b001:l034","ordinal":44603,"en":"Is there an army come from Mecca?"},{"id":"manas-2010:p1020:b001:l035","ordinal":44604,"en":"Girding their waists tightly,"},{"id":"manas-2010:p1020:b001:l036","ordinal":44605,"en":"Many Chinese emerging from the flank,"},{"id":"manas-2010:p1020:b001:l037","ordinal":44606,"en":"Bringing an army without sparing any,"},{"id":"manas-2010:p1020:b001:l038","ordinal":44607,"en":"Have they arrived unexpectedly?"},{"id":"manas-2010:p1020:b001:l039","ordinal":44608,"en":"Upon the vast army lying without a watch,"},{"id":"manas-2010:p1020:b001:l040","ordinal":44609,"en":"Have they stirred up battle?"},{"id":"manas-2010:p1020:b001:l041","ordinal":44610,"en":"You have come straight toward me."},{"id":"manas-2010:p1020:b001:l042","ordinal":44611,"en":"Is there an army come from Beijing?"},{"id":"manas-2010:p1021:b001:l001","ordinal":44612,"en":"If an army has come from Beijing,"},{"id":"manas-2010:p1021:b001:l002","ordinal":44613,"en":"Let me mount Sarala."},{"id":"manas-2010:p1021:b001:l003","ordinal":44614,"en":"The Chinese come in multitudes,"},{"id":"manas-2010:p1021:b001:l004","ordinal":44615,"en":"Let me attack them alone."},{"id":"manas-2010:p1021:b001:l005","ordinal":44616,"en":"Upon Beijing where the Prophet would not go,"},{"id":"manas-2010:p1021:b001:l006","ordinal":44617,"en":"Let me bring calamity."},{"id":"manas-2010:p1021:b001:l007","ordinal":44618,"en":"Over the teeming Black Chinese,"},{"id":"manas-2010:p1021:b001:l008","ordinal":44619,"en":"My blue-maned leopard Chubak,"},{"id":"manas-2010:p1021:b001:l009","ordinal":44620,"en":"Let me raise you as khan."},{"id":"manas-2010:p1021:b001:l010","ordinal":44621,"en":"If foes have come from Mecca,"},{"id":"manas-2010:p1021:b001:l011","ordinal":44622,"en":"Give me Kögala to ride."},{"id":"manas-2010:p1021:b001:l012","ordinal":44623,"en":"Let them be a vast host, not merely many."},{"id":"manas-2010:p1021:b001:l013","ordinal":44624,"en":"Like a falcon striking jackdaws,"},{"id":"manas-2010:p1021:b001:l014","ordinal":44625,"en":"Let me attack alone and scatter them."},{"id":"manas-2010:p1021:b001:l015","ordinal":44626,"en":"Like a hobby striking jackdaws,"},{"id":"manas-2010:p1021:b001:l016","ordinal":44627,"en":"Let me slaughter them, sparing no life."},{"id":"manas-2010:p1021:b001:l017","ordinal":44628,"en":"Even if it is the world's army,"},{"id":"manas-2010:p1021:b001:l018","ordinal":44629,"en":"Making red blood flow,"},{"id":"manas-2010:p1021:b001:l019","ordinal":44630,"en":"Over the enemy that boasts of strength,"},{"id":"manas-2010:p1021:b001:l020","ordinal":44631,"en":"My mighty blue-maned Chubak,"},{"id":"manas-2010:p1021:b001:l021","ordinal":44632,"en":"Let me raise you as khan!’"},{"id":"manas-2010:p1021:b001:l022","ordinal":44633,"en":"Saying this, Almambet,"},{"id":"manas-2010:p1021:b001:l023","ordinal":44634,"en":"As though smiling beneath his mustache,"},{"id":"manas-2010:p1021:b001:l024","ordinal":44635,"en":"Stood looking sidelong."},{"id":"manas-2010:p1021:b001:l025","ordinal":44636,"en":"Your Chubak, who came wound tight,"},{"id":"manas-2010:p1021:b001:l026","ordinal":44637,"en":"Became truly angry."},{"id":"manas-2010:p1021:b001:l027","ordinal":44638,"en":"Riding Kögala, roaring,"},{"id":"manas-2010:p1021:b001:l028","ordinal":44639,"en":"Without hearing what was said,"},{"id":"manas-2010:p1021:b001:l029","ordinal":44640,"en":"Excited as though struck by wind,"},{"id":"manas-2010:p1021:b001:l030","ordinal":44641,"en":"Like a seven-headed creature:"},{"id":"manas-2010:p1021:b001:l031","ordinal":44642,"en":"‘Earlier, in broad Talas's hollow,"},{"id":"manas-2010:p1021:b001:l032","ordinal":44643,"en":"Along the tamarisk valley,"},{"id":"manas-2010:p1021:b001:l033","ordinal":44644,"en":"The teeming Argyn and many Nogoy,"},{"id":"manas-2010:p1021:b001:l034","ordinal":44645,"en":"When they were camped there,"},{"id":"manas-2010:p1021:b001:l035","ordinal":44646,"en":"Kumiss by day, girls by night,"},{"id":"manas-2010:p1021:b001:l036","ordinal":44647,"en":"When that was how things were,"},{"id":"manas-2010:p1021:b001:l037","ordinal":44648,"en":"Wearing marten-fur caps in pairs,"},{"id":"manas-2010:p1021:b001:l038","ordinal":44649,"en":"When they were swaying,"},{"id":"manas-2010:p1021:b001:l039","ordinal":44650,"en":"Together knowing the Kyrgyz,"},{"id":"manas-2010:p1021:b001:l040","ordinal":44651,"en":"When they were enjoying themselves,"},{"id":"manas-2010:p1021:b001:l041","ordinal":44652,"en":"Where is the letter written then?"},{"id":"manas-2010:p1021:b001:l042","ordinal":44653,"en":"Where is the oath sworn before God?"}]
