[{"id":"manas-2010:p0133:b002:l031","ordinal":5633,"en":"The child sultan, the leopard,"},{"id":"manas-2010:p0133:b002:l032","ordinal":5634,"en":"Look at the four boys:"},{"id":"manas-2010:p0133:b002:l033","ordinal":5635,"en":"Their strength had long departed."},{"id":"manas-2010:p0133:b002:l034","ordinal":5636,"en":"Their ribs were shattered;"},{"id":"manas-2010:p0133:b002:l035","ordinal":5637,"en":"It was God Most High's doing."},{"id":"manas-2010:p0133:b002:l036","ordinal":5638,"en":"Those four boys, that wrestler"},{"id":"manas-2010:p0133:b002:l037","ordinal":5639,"en":"Had killed them, leaving none."},{"id":"manas-2010:p0133:b002:l038","ordinal":5640,"en":"The four boys lay dead, hunched upon the earth,"},{"id":"manas-2010:p0133:b002:l039","ordinal":5641,"en":"Had departed this world."},{"id":"manas-2010:p0133:b002:l040","ordinal":5642,"en":"The fire lit to cook meat"},{"id":"manas-2010:p0133:b002:l041","ordinal":5643,"en":"Had gone out without a spark remaining."},{"id":"manas-2010:p0133:b002:l042","ordinal":5644,"en":"Then Manas, your gray-maned hero,"},{"id":"manas-2010:p0133:b002:l043","ordinal":5645,"en":"Slaughtered the giant and laid him low,"},{"id":"manas-2010:p0133:b002:l044","ordinal":5646,"en":"Wrought havoc upon that road."},{"id":"manas-2010:p0133:b002:l045","ordinal":5647,"en":"Apart from the four boys,"},{"id":"manas-2010:p0133:b002:l046","ordinal":5648,"en":"He saved the others alive."},{"id":"manas-2010:p0133:b002:l047","ordinal":5649,"en":"The wrestler who had charged so fiercely,"},{"id":"manas-2010:p0133:b002:l048","ordinal":5650,"en":"He split his head apart."},{"id":"manas-2010:p0134:b002:l001","ordinal":5651,"en":"The gray-maned leopard rushed forth;"},{"id":"manas-2010:p0134:b002:l002","ordinal":5652,"en":"This was the quarrel he brought upon the Kalmyks."},{"id":"manas-2010:p0134:b002:l003","ordinal":5653,"en":"Slaughtering the wrestler and laying him low,"},{"id":"manas-2010:p0134:b002:l004","ordinal":5654,"en":"He gathered the boys."},{"id":"manas-2010:p0134:b002:l005","ordinal":5655,"en":"Of rich Jakyp's lambs,"},{"id":"manas-2010:p0134:b002:l006","ordinal":5656,"en":"He caught and slaughtered a hundred."},{"id":"manas-2010:p0134:b002:l007","ordinal":5657,"en":"Manas called the boys:"},{"id":"manas-2010:p0134:b002:l008","ordinal":5658,"en":"“Call me ‘Lord!’” he said."},{"id":"manas-2010:p0134:b002:l009","ordinal":5659,"en":"“Your fathers' graves, forty boys!"},{"id":"manas-2010:p0134:b002:l010","ordinal":5660,"en":"Follow what I say;"},{"id":"manas-2010:p0134:b002:l011","ordinal":5661,"en":"Settle all around me;"},{"id":"manas-2010:p0134:b002:l012","ordinal":5662,"en":"Become my choro companions!”"},{"id":"manas-2010:p0134:b002:l013","ordinal":5663,"en":"Catching and slaughtering camels,"},{"id":"manas-2010:p0134:b002:l014","ordinal":5664,"en":"Slaughtering sheep headed by a mare,"},{"id":"manas-2010:p0134:b002:l015","ordinal":5665,"en":"He made merry sport."},{"id":"manas-2010:p0134:b002:l016","ordinal":5666,"en":"The fierce gray-maned leopard,"},{"id":"manas-2010:p0134:b002:l017","ordinal":5667,"en":"Though he gathered wood, had no fire."},{"id":"manas-2010:p0134:b002:l018","ordinal":5668,"en":"Of the Black Kalmyks and Manchus,"},{"id":"manas-2010:p0134:b002:l019","ordinal":5669,"en":"One whose given name was Jyrynta"},{"id":"manas-2010:p0134:b002:l020","ordinal":5670,"en":"Came looking for a lamb."},{"id":"manas-2010:p0134:b002:l021","ordinal":5671,"en":"Manas saw him come."},{"id":"manas-2010:p0134:b002:l022","ordinal":5672,"en":"“Old man, come here,” he said."},{"id":"manas-2010:p0134:b002:l023","ordinal":5673,"en":"“To kindle a fire,"},{"id":"manas-2010:p0134:b002:l024","ordinal":5674,"en":"To sustain our lives on the steppe,"},{"id":"manas-2010:p0134:b002:l025","ordinal":5675,"en":"Give me your fire steel,” he said."},{"id":"manas-2010:p0134:b002:l026","ordinal":5676,"en":"The gray-maned hero stood asking."},{"id":"manas-2010:p0134:b002:l027","ordinal":5677,"en":"“Ah, kumka Burut!” he said."},{"id":"manas-2010:p0134:b002:l028","ordinal":5678,"en":"“Ah, wretched Kyrgyz!” he said."},{"id":"manas-2010:p0134:b002:l029","ordinal":5679,"en":"He did not agree to his request."},{"id":"manas-2010:p0134:b002:l030","ordinal":5680,"en":"Your father's grave, that bald old man:"},{"id":"manas-2010:p0134:b002:l031","ordinal":5681,"en":"The old man did not give his fire steel."},{"id":"manas-2010:p0134:b002:l032","ordinal":5682,"en":"An ill-disposed infidel old man,"},{"id":"manas-2010:p0134:b002:l033","ordinal":5683,"en":"Among that Black Kalmyk people,"},{"id":"manas-2010:p0134:b002:l034","ordinal":5684,"en":"An old man braver than many,"},{"id":"manas-2010:p0134:b002:l035","ordinal":5685,"en":"A most skillful raiding old man,"},{"id":"manas-2010:p0134:b002:l036","ordinal":5686,"en":"Both wrestler and warrior,"},{"id":"manas-2010:p0134:b002:l037","ordinal":5687,"en":"Humming unconcernedly,"},{"id":"manas-2010:p0134:b002:l038","ordinal":5688,"en":"The child roaming the steppe"},{"id":"manas-2010:p0134:b002:l039","ordinal":5689,"en":"He did not value as much as his trouser cuff."},{"id":"manas-2010:p0134:b002:l040","ordinal":5690,"en":"God struck the old man now."},{"id":"manas-2010:p0134:b002:l041","ordinal":5691,"en":"From excitement he flew into frenzy;"},{"id":"manas-2010:p0134:b002:l042","ordinal":5692,"en":"Gray-maned Manas raged:"},{"id":"manas-2010:p0134:b002:l043","ordinal":5693,"en":"“Old man, upon the fire you refuse when asked,"},{"id":"manas-2010:p0134:b002:l044","ordinal":5694,"en":"I shall lay my thieving hand."},{"id":"manas-2010:p0134:b002:l045","ordinal":5695,"en":"If you show still more arrogance,"},{"id":"manas-2010:p0134:b002:l046","ordinal":5696,"en":"My obstinate Black Kalmyk,"},{"id":"manas-2010:p0134:b002:l047","ordinal":5697,"en":"I shall slaughter you as a sacrifice."},{"id":"manas-2010:p0134:b002:l048","ordinal":5698,"en":"I have need of your fire steel;"},{"id":"manas-2010:p0135:b002:l001","ordinal":5699,"en":"I shall snatch it from you like this!”"},{"id":"manas-2010:p0135:b002:l002","ordinal":5700,"en":"Saying so, he lunged,"},{"id":"manas-2010:p0135:b002:l003","ordinal":5701,"en":"Seized the old man by the belt,"},{"id":"manas-2010:p0135:b002:l004","ordinal":5702,"en":"Pulled him from his stallion,"},{"id":"manas-2010:p0135:b002:l005","ordinal":5703,"en":"Lifted him and threw him to the ground."},{"id":"manas-2010:p0135:b002:l006","ordinal":5704,"en":"The old man's belt broke;"},{"id":"manas-2010:p0135:b002:l007","ordinal":5705,"en":"His kise pouch stayed in Manas's hand."},{"id":"manas-2010:p0135:b002:l008","ordinal":5706,"en":"Your old man hurried and ran."},{"id":"manas-2010:p0135:b002:l009","ordinal":5707,"en":"“God, what will he do?” he said,"},{"id":"manas-2010:p0135:b002:l010","ordinal":5708,"en":"Despairing of his fly-like life."},{"id":"manas-2010:p0135:b002:l011","ordinal":5709,"en":"His knee bent to the ground;"},{"id":"manas-2010:p0135:b002:l012","ordinal":5710,"en":"Hurrying and flustering, the old man,"},{"id":"manas-2010:p0135:b002:l013","ordinal":5711,"en":"Springing more nimbly than a roe deer,"},{"id":"manas-2010:p0135:b002:l014","ordinal":5712,"en":"Upon the iron-tread stirrup"},{"id":"manas-2010:p0135:b002:l015","ordinal":5713,"en":"He did not step, but leaped into the saddle."},{"id":"manas-2010:p0135:b002:l016","ordinal":5714,"en":"Blood dripping from his jaw,"},{"id":"manas-2010:p0135:b002:l017","ordinal":5715,"en":"Whipping the gray stallion,"},{"id":"manas-2010:p0135:b002:l018","ordinal":5716,"en":"In a bewildering cloud of dust,"},{"id":"manas-2010:p0135:b002:l019","ordinal":5717,"en":"His head and eyes covered in blood,"},{"id":"manas-2010:p0135:b002:l020","ordinal":5718,"en":"His bellowing splitting stone,"},{"id":"manas-2010:p0135:b002:l021","ordinal":5719,"en":"His shouting splitting heads,"},{"id":"manas-2010:p0135:b002:l022","ordinal":5720,"en":"The Kalmyk went on his way."},{"id":"manas-2010:p0135:b002:l023","ordinal":5721,"en":"Chief shepherd, rich Oshpur,"},{"id":"manas-2010:p0135:b002:l024","ordinal":5722,"en":"Climbed a hill and looked,"},{"id":"manas-2010:p0135:b002:l025","ordinal":5723,"en":"Sought the forty boys:"},{"id":"manas-2010:p0135:b002:l026","ordinal":5724,"en":"Smoke parted against the sky."},{"id":"manas-2010:p0135:b002:l027","ordinal":5725,"en":"Having gathered many lambs,"},{"id":"manas-2010:p0135:b002:l028","ordinal":5726,"en":"Gray-maned Manas, the leopard,"},{"id":"manas-2010:p0135:b002:l029","ordinal":5727,"en":"Had evidently slaughtered them."},{"id":"manas-2010:p0135:b002:l030","ordinal":5728,"en":"Playing orompoy, raising dust,"},{"id":"manas-2010:p0135:b002:l031","ordinal":5729,"en":"All the forty boys"},{"id":"manas-2010:p0135:b002:l032","ordinal":5730,"en":"Surrounded Manas."},{"id":"manas-2010:p0135:b002:l033","ordinal":5731,"en":"In their midst, warrior Manas"},{"id":"manas-2010:p0135:b002:l034","ordinal":5732,"en":"Loomed like a towering mountain."},{"id":"manas-2010:p0135:b002:l035","ordinal":5733,"en":"Catching and slaughtering lambs,"},{"id":"manas-2010:p0135:b002:l036","ordinal":5734,"en":"He saw the boys apart,"},{"id":"manas-2010:p0135:b002:l037","ordinal":5735,"en":"Skewering meat and eating their fill."},{"id":"manas-2010:p0135:b002:l038","ordinal":5736,"en":"Racing young horses, playing and shouting,"},{"id":"manas-2010:p0135:b002:l039","ordinal":5737,"en":"If you heed the boys' cries,"},{"id":"manas-2010:p0135:b002:l040","ordinal":5738,"en":"They raised the battle cry “Manas!”"},{"id":"manas-2010:p0135:b002:l041","ordinal":5739,"en":"On this side was a hut;"},{"id":"manas-2010:p0135:b002:l042","ordinal":5740,"en":"If you looked at that hut,"},{"id":"manas-2010:p0135:b002:l043","ordinal":5741,"en":"A leader of the people and ten thousand souls"},{"id":"manas-2010:p0135:b002:l044","ordinal":5742,"en":"Might fit there with room to spare."},{"id":"manas-2010:p0135:b002:l045","ordinal":5743,"en":"On one side the forty boys,"},{"id":"manas-2010:p0135:b002:l046","ordinal":5744,"en":"With Manas leading them, inside it"},{"id":"manas-2010:p0135:b002:l047","ordinal":5745,"en":"Could freely play ordo."},{"id":"manas-2010:p0135:b002:l048","ordinal":5746,"en":"A black-spotted leopard"},{"id":"manas-2010:p0136:b002:l001","ordinal":5747,"en":"Beside that very child Manas,"},{"id":"manas-2010:p0136:b002:l002","ordinal":5748,"en":"Raged at his flank."},{"id":"manas-2010:p0136:b002:l003","ordinal":5749,"en":"A short-tailed, gray-maned lion,"},{"id":"manas-2010:p0136:b002:l004","ordinal":5750,"en":"As though to tear Oshpur apart,"},{"id":"manas-2010:p0136:b002:l005","ordinal":5751,"en":"Readied itself before him."},{"id":"manas-2010:p0136:b002:l006","ordinal":5752,"en":"His seki side numbered eighty-four;"},{"id":"manas-2010:p0136:b002:l007","ordinal":5753,"en":"Wherever he swept was red fire."},{"id":"manas-2010:p0136:b002:l008","ordinal":5754,"en":"Seeing this, Oshpur's"},{"id":"manas-2010:p0136:b002:l009","ordinal":5755,"en":"Rib bones trembled,"},{"id":"manas-2010:p0136:b002:l010","ordinal":5756,"en":"His shit-filled intestines shook."},{"id":"manas-2010:p0136:b002:l011","ordinal":5757,"en":"He could not help losing his senses;"},{"id":"manas-2010:p0136:b002:l012","ordinal":5758,"en":"The handle fell from his wrist."},{"id":"manas-2010:p0136:b002:l013","ordinal":5759,"en":"When he saw Manas's bearing,"},{"id":"manas-2010:p0136:b002:l014","ordinal":5760,"en":"The casing fell from his heart."},{"id":"manas-2010:p0136:b002:l015","ordinal":5761,"en":"“This mad son of Jakyp"},{"id":"manas-2010:p0136:b002:l016","ordinal":5762,"en":"Will ruin whoever provokes him,"},{"id":"manas-2010:p0136:b002:l017","ordinal":5763,"en":"Will leave no opponent unharmed."},{"id":"manas-2010:p0136:b002:l018","ordinal":5764,"en":"Thick-armed, stone-hearted,"},{"id":"manas-2010:p0136:b002:l019","ordinal":5765,"en":"An elephant-limbed, dauntless hero,"},{"id":"manas-2010:p0136:b002:l020","ordinal":5766,"en":"He has reached his full strength."},{"id":"manas-2010:p0136:b002:l021","ordinal":5767,"en":"Now he will bring great turmoil to the Kalmyks."},{"id":"manas-2010:p0136:b002:l022","ordinal":5768,"en":"One form he has is a lion;"},{"id":"manas-2010:p0136:b002:l023","ordinal":5769,"en":"When I look again, a leopard."},{"id":"manas-2010:p0136:b002:l024","ordinal":5770,"en":"He is blood-drinking itself."},{"id":"manas-2010:p0136:b002:l025","ordinal":5771,"en":"Their eyes clouded, the many Kalmyks"},{"id":"manas-2010:p0136:b002:l026","ordinal":5772,"en":"Have failed to see him at this time."},{"id":"manas-2010:p0136:b002:l027","ordinal":5773,"en":"He will bring strife to Chin-Machin."},{"id":"manas-2010:p0136:b002:l028","ordinal":5774,"en":"He will ruin whoever he seizes."},{"id":"manas-2010:p0136:b002:l029","ordinal":5775,"en":"This ill-omened Burut"},{"id":"manas-2010:p0136:b002:l030","ordinal":5776,"en":"Will leave no opponent unharmed."},{"id":"manas-2010:p0136:b002:l031","ordinal":5777,"en":"He has planted in the ground"},{"id":"manas-2010:p0136:b002:l032","ordinal":5778,"en":"His spear with a thickened socket."},{"id":"manas-2010:p0136:b002:l033","ordinal":5779,"en":"It will bring strife to the world,"},{"id":"manas-2010:p0136:b002:l034","ordinal":5780,"en":"This child's resourcefulness."},{"id":"manas-2010:p0136:b002:l035","ordinal":5781,"en":"Ah, this son of a wretch,"},{"id":"manas-2010:p0136:b002:l036","ordinal":5782,"en":"When he rages and his madness seizes him,"},{"id":"manas-2010:p0136:b002:l037","ordinal":5783,"en":"He is a lion who will destroy the Oirats."},{"id":"manas-2010:p0136:b002:l038","ordinal":5784,"en":"Whatever he pleased upon the steppe,"},{"id":"manas-2010:p0136:b002:l039","ordinal":5785,"en":"He has gone and done it."},{"id":"manas-2010:p0136:b002:l040","ordinal":5786,"en":"Rich Jakyp's lambs,"},{"id":"manas-2010:p0136:b002:l041","ordinal":5787,"en":"Every one alike, leaving none,"},{"id":"manas-2010:p0136:b002:l042","ordinal":5788,"en":"He has gone and slaughtered them!"},{"id":"manas-2010:p0136:b002:l043","ordinal":5789,"en":"‘Why did you slaughter the lambs?’"},{"id":"manas-2010:p0136:b002:l044","ordinal":5790,"en":"If I should happen to ask,"},{"id":"manas-2010:p0136:b002:l045","ordinal":5791,"en":"If he catches my hem, he will ruin me,"},{"id":"manas-2010:p0136:b002:l046","ordinal":5792,"en":"He surely will not leave me unharmed."},{"id":"manas-2010:p0136:b002:l047","ordinal":5793,"en":"Why should I stay here?"},{"id":"manas-2010:p0136:b002:l048","ordinal":5794,"en":"‘Restrain your child,’ I shall say;"},{"id":"manas-2010:p0137:b002:l001","ordinal":5795,"en":"Let me reach rich Jakyp!"},{"id":"manas-2010:p0137:b002:l002","ordinal":5796,"en":"Unless I bring his father,"},{"id":"manas-2010:p0137:b002:l003","ordinal":5797,"en":"And then see what happens,"},{"id":"manas-2010:p0137:b002:l004","ordinal":5798,"en":"He will hasten my death,"},{"id":"manas-2010:p0137:b002:l005","ordinal":5799,"en":"He will strip me of my means this instant.”"},{"id":"manas-2010:p0137:b002:l006","ordinal":5800,"en":"Saying this, warrior Oshpur"},{"id":"manas-2010:p0137:b002:l007","ordinal":5801,"en":"Dashed off toward Jakyp,"},{"id":"manas-2010:p0137:b002:l008","ordinal":5802,"en":"Charged without sparing himself."},{"id":"manas-2010:p0137:b002:l009","ordinal":5803,"en":"The stallion beneath him,"},{"id":"manas-2010:p0137:b002:l010","ordinal":5804,"en":"He whipped it right and left,"},{"id":"manas-2010:p0137:b002:l011","ordinal":5805,"en":"Spurred it this way and that,"},{"id":"manas-2010:p0137:b002:l012","ordinal":5806,"en":"Breaking the steppe and plain beneath him,"},{"id":"manas-2010:p0137:b002:l013","ordinal":5807,"en":"Galloping upon his stallion,"},{"id":"manas-2010:p0137:b002:l014","ordinal":5808,"en":"Hurrying and flustering without stopping,"},{"id":"manas-2010:p0137:b002:l015","ordinal":5809,"en":"Of those accursed many sheep,"},{"id":"manas-2010:p0137:b002:l016","ordinal":5810,"en":"Not counting how many had died."},{"id":"manas-2010:p0137:b002:l017","ordinal":5811,"en":"What could dear Oshpur do?"},{"id":"manas-2010:p0137:b002:l018","ordinal":5812,"en":"Hurrying and flustering without stopping,"},{"id":"manas-2010:p0137:b002:l019","ordinal":5813,"en":"As though an evil spirit had seized his wife,"},{"id":"manas-2010:p0137:b002:l020","ordinal":5814,"en":"As though fleeing with pursuers near,"},{"id":"manas-2010:p0137:b002:l021","ordinal":5815,"en":"As though his pursuers chased close behind,"},{"id":"manas-2010:p0137:b002:l022","ordinal":5816,"en":"As though his wife had borne a son,"},{"id":"manas-2010:p0137:b002:l023","ordinal":5817,"en":"At rich Jakyp's court"},{"id":"manas-2010:p0137:b002:l024","ordinal":5818,"en":"Rich Oshpur arrived and dismounted."},{"id":"manas-2010:p0137:b002:l025","ordinal":5819,"en":"Words of calamity and horror"},{"id":"manas-2010:p0137:b002:l026","ordinal":5820,"en":"Rich Oshpur poured out as he dismounted:"},{"id":"manas-2010:p0137:b002:l027","ordinal":5821,"en":"“Your son Manas has become a warrior."},{"id":"manas-2010:p0137:b002:l028","ordinal":5822,"en":"When I spoke, his ears did not listen."},{"id":"manas-2010:p0137:b002:l029","ordinal":5823,"en":"All those who went to him,"},{"id":"manas-2010:p0137:b002:l030","ordinal":5824,"en":"He drove to crouch like hares on the ground."},{"id":"manas-2010:p0137:b002:l031","ordinal":5825,"en":"Forty boys as companions,"},{"id":"manas-2010:p0137:b002:l032","ordinal":5826,"en":"Your intrepid child has gathered."},{"id":"manas-2010:p0137:b002:l033","ordinal":5827,"en":"As though wolves had slaughtered them,"},{"id":"manas-2010:p0137:b002:l034","ordinal":5828,"en":"He has slaughtered sheep upon the steppe."},{"id":"manas-2010:p0137:b002:l035","ordinal":5829,"en":"There is no soul like your child."},{"id":"manas-2010:p0137:b002:l036","ordinal":5830,"en":"The companion at his side"},{"id":"manas-2010:p0137:b002:l037","ordinal":5831,"en":"Is a gray tiger licking its lips."},{"id":"manas-2010:p0137:b002:l038","ordinal":5832,"en":"It is pointless to speak:"},{"id":"manas-2010:p0137:b002:l039","ordinal":5833,"en":"A black-spotted leopard"},{"id":"manas-2010:p0137:b002:l040","ordinal":5834,"en":"Is your son's retainer."},{"id":"manas-2010:p0137:b002:l041","ordinal":5835,"en":"On the open steppe, the forty boys"},{"id":"manas-2010:p0137:b002:l042","ordinal":5836,"en":"Have built huts."},{"id":"manas-2010:p0137:b002:l043","ordinal":5837,"en":"In their midst, your mad son"},{"id":"manas-2010:p0137:b002:l044","ordinal":5838,"en":"Has become a sultan."},{"id":"manas-2010:p0137:b002:l045","ordinal":5839,"en":"The forty boys, full of meat,"},{"id":"manas-2010:p0137:b002:l046","ordinal":5840,"en":"Race on foot as young horses and shout."},{"id":"manas-2010:p0137:b002:l047","ordinal":5841,"en":"The boys who come in front"},{"id":"manas-2010:p0137:b002:l048","ordinal":5842,"en":"Raise the battle cry ‘Manas!’"},{"id":"manas-2010:p0138:b002:l001","ordinal":5843,"en":"Your son's name is Chong Jindi;"},{"id":"manas-2010:p0138:b002:l002","ordinal":5844,"en":"Who knew his name Manas?"},{"id":"manas-2010:p0138:b002:l003","ordinal":5845,"en":"Your son has slaughtered lambs."},{"id":"manas-2010:p0138:b002:l004","ordinal":5846,"en":"All forty boys gathered,"},{"id":"manas-2010:p0138:b002:l005","ordinal":5847,"en":"And bestowed the name Manas on him."},{"id":"manas-2010:p0138:b002:l006","ordinal":5848,"en":"You bore no mere child, Chyyyrdy;"},{"id":"manas-2010:p0138:b002:l007","ordinal":5849,"en":"You have borne a hero."},{"id":"manas-2010:p0138:b002:l008","ordinal":5850,"en":"One who cannot drink his fill of blood,"},{"id":"manas-2010:p0138:b002:l009","ordinal":5851,"en":"You have borne an infidel."},{"id":"manas-2010:p0138:b002:l010","ordinal":5852,"en":"He will not let you turn your plow."},{"id":"manas-2010:p0138:b002:l011","ordinal":5853,"en":"If this son of yours goes on like this,"},{"id":"manas-2010:p0138:b002:l012","ordinal":5854,"en":"He will not let us stay in this Altay."},{"id":"manas-2010:p0138:b002:l013","ordinal":5855,"en":"This son of yours will cause trouble;"},{"id":"manas-2010:p0138:b002:l014","ordinal":5856,"en":"Spearheads will clash."},{"id":"manas-2010:p0138:b002:l015","ordinal":5857,"en":"He has reached twelve years;"},{"id":"manas-2010:p0138:b002:l016","ordinal":5858,"en":"With the Black Kalmyk people"},{"id":"manas-2010:p0138:b002:l017","ordinal":5859,"en":"He will fight this very day."},{"id":"manas-2010:p0138:b002:l018","ordinal":5860,"en":"Had you heard of it yesterday?"},{"id":"manas-2010:p0138:b002:l019","ordinal":5861,"en":"Esenkan's envoy,"},{"id":"manas-2010:p0138:b002:l020","ordinal":5862,"en":"The sorcerer had known:"},{"id":"manas-2010:p0138:b002:l021","ordinal":5863,"en":"‘Manas will arise from the Burut,’"},{"id":"manas-2010:p0138:b002:l022","ordinal":5864,"en":"And had long been searching."},{"id":"manas-2010:p0138:b002:l023","ordinal":5865,"en":"He was born here in Altay;"},{"id":"manas-2010:p0138:b002:l024","ordinal":5866,"en":"He is the very Manas foretold."},{"id":"manas-2010:p0138:b002:l025","ordinal":5867,"en":"Beyond Manas himself,"},{"id":"manas-2010:p0138:b002:l026","ordinal":5868,"en":"These are his very watching black eyes."},{"id":"manas-2010:p0138:b002:l027","ordinal":5869,"en":"You, Jakyp, have blazed up,"},{"id":"manas-2010:p0138:b002:l028","ordinal":5870,"en":"Turned your thoughts to deceit."},{"id":"manas-2010:p0138:b002:l029","ordinal":5871,"en":"‘My son's name is Jindi,’ you said,"},{"id":"manas-2010:p0138:b002:l030","ordinal":5872,"en":"And did not name your child Manas."},{"id":"manas-2010:p0138:b002:l031","ordinal":5873,"en":"Cut your river willows down;"},{"id":"manas-2010:p0138:b002:l032","ordinal":5874,"en":"He is going to burn Altay."},{"id":"manas-2010:p0138:b002:l033","ordinal":5875,"en":"Restrain that child of yours!"},{"id":"manas-2010:p0138:b002:l034","ordinal":5876,"en":"When he sees a Kalmyk, he corners him;"},{"id":"manas-2010:p0138:b002:l035","ordinal":5877,"en":"When he sees a Manchu, he beats him."},{"id":"manas-2010:p0138:b002:l036","ordinal":5878,"en":"I, Oshpur, who tend the sheep,"},{"id":"manas-2010:p0138:b002:l037","ordinal":5879,"en":"Am tired of your child's wildness."},{"id":"manas-2010:p0138:b002:l038","ordinal":5880,"en":"There are rumors among the people:"},{"id":"manas-2010:p0138:b002:l039","ordinal":5881,"en":"The chief horse herder, great Kanjar,"},{"id":"manas-2010:p0138:b002:l040","ordinal":5882,"en":"Even him, your troublesome son Manas"},{"id":"manas-2010:p0138:b002:l041","ordinal":5883,"en":"Seems to have killed."},{"id":"manas-2010:p0138:b002:l042","ordinal":5884,"en":"Unless you restrain this son,"},{"id":"manas-2010:p0138:b002:l043","ordinal":5885,"en":"The Black Kalmyk and Manchu peoples,"},{"id":"manas-2010:p0138:b002:l044","ordinal":5886,"en":"Look at their numbers, like black insects."},{"id":"manas-2010:p0138:b002:l045","ordinal":5887,"en":"The saying is like this:"},{"id":"manas-2010:p0138:b002:l046","ordinal":5888,"en":"Seven wolves, one sheep:"}]
