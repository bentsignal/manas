[{"id":"semetey-1-2013:p0697:b005:l014","ordinal":130305,"en":"Found her honor restored in this;"},{"id":"semetey-1-2013:p0697:b005:l015","ordinal":130306,"en":"Her exposed places were covered."},{"id":"semetey-1-2013:p0697:b005:l016","ordinal":130307,"en":"Her clouded brow cleared;"},{"id":"semetey-1-2013:p0697:b005:l017","ordinal":130308,"en":"All her sorrow scattered."},{"id":"semetey-1-2013:p0697:b005:l018","ordinal":130309,"en":"Her brow grew bright and clear;"},{"id":"semetey-1-2013:p0697:b005:l019","ordinal":130310,"en":"All her sorrow scattered."},{"id":"semetey-1-2013:p0697:b005:l020","ordinal":130311,"en":"Her grieving heart opened."},{"id":"semetey-1-2013:p0697:b005:l021","ordinal":130312,"en":"What was severed was joined;"},{"id":"semetey-1-2013:p0697:b005:l022","ordinal":130313,"en":"What was scattered was gathered."},{"id":"semetey-1-2013:p0697:b005:l023","ordinal":130314,"en":"Since God had granted her wish,"},{"id":"semetey-1-2013:p0697:b005:l024","ordinal":130315,"en":"Since Semetey had come here,"},{"id":"semetey-1-2013:p0697:b005:l025","ordinal":130316,"en":"Burulcha poured out her lament:"},{"id":"semetey-1-2013:p0697:b005:l026","ordinal":130317,"en":"This was Burulcha's tale."},{"id":"semetey-1-2013:p0697:b005:l027","ordinal":130318,"en":"Let us leave this here;"},{"id":"semetey-1-2013:p0697:b005:l028","ordinal":130319,"en":"With Almambet's orphan,"},{"id":"semetey-1-2013:p0697:b005:l029","ordinal":130320,"en":"Kulchoro, let us begin."},{"id":"semetey-1-2013:p0697:b005:l030","ordinal":130321,"en":"Abyke, Kobosh, the six villains,"},{"id":"semetey-1-2013:p0697:b005:l031","ordinal":130322,"en":"To make the six-year-old child"},{"id":"semetey-1-2013:p0697:b005:l032","ordinal":130323,"en":"A dependent servant,"},{"id":"semetey-1-2013:p0697:b005:l033","ordinal":130324,"en":"Bound his hands to break him in,"},{"id":"semetey-1-2013:p0697:b005:l034","ordinal":130325,"en":"Dragged and beat him."},{"id":"semetey-1-2013:p0697:b005:l035","ordinal":130326,"en":"God had struck those dogs;"},{"id":"semetey-1-2013:p0697:b005:l036","ordinal":130327,"en":"The warrior son of Almambet,"},{"id":"semetey-1-2013:p0697:b005:l037","ordinal":130328,"en":"All those dogs gathered round,"},{"id":"semetey-1-2013:p0697:b005:l038","ordinal":130329,"en":"And made him red with blood,"},{"id":"semetey-1-2013:p0697:b005:l039","ordinal":130330,"en":"Tormenting, beating and striking him."},{"id":"semetey-1-2013:p0698:b003:l001","ordinal":130331,"en":"Such was the havoc they wrought."},{"id":"semetey-1-2013:p0698:b003:l002","ordinal":130332,"en":"That six-year-old warrior,"},{"id":"semetey-1-2013:p0698:b003:l003","ordinal":130333,"en":"Without a cap, bareheaded,"},{"id":"semetey-1-2013:p0698:b003:l004","ordinal":130334,"en":"Without a shirt, naked,"},{"id":"semetey-1-2013:p0698:b003:l005","ordinal":130335,"en":"Shrieked, crying, “Uncle!”"},{"id":"semetey-1-2013:p0698:b003:l006","ordinal":130336,"en":"His voice unheard by God,"},{"id":"semetey-1-2013:p0698:b003:l007","ordinal":130337,"en":"The wretched orphan sobbed."},{"id":"semetey-1-2013:p0698:b003:l008","ordinal":130338,"en":"Seen today, gone tomorrow—"},{"id":"semetey-1-2013:p0698:b003:l009","ordinal":130339,"en":"Khan Almambet's only son!"},{"id":"semetey-1-2013:p0698:b003:l010","ordinal":130340,"en":"Damn it, this world is shit!"},{"id":"semetey-1-2013:p0698:b003:l011","ordinal":130341,"en":"Bruised blue in countless places,"},{"id":"semetey-1-2013:p0698:b003:l012","ordinal":130342,"en":"The flesh of his thighs torn apart,"},{"id":"semetey-1-2013:p0698:b003:l013","ordinal":130343,"en":"Upon the six-year-old child"},{"id":"semetey-1-2013:p0698:b003:l014","ordinal":130344,"en":"They poured their merciless wrath."},{"id":"semetey-1-2013:p0698:b003:l015","ordinal":130345,"en":"Abyke and Kobosh's"},{"id":"semetey-1-2013:p0698:b003:l016","ordinal":130346,"en":"Doglike cruelty was plain to see."},{"id":"semetey-1-2013:p0698:b003:l017","ordinal":130347,"en":"Six-year-old Kulchoro"},{"id":"semetey-1-2013:p0698:b003:l018","ordinal":130348,"en":"Felt his heart breaking;"},{"id":"semetey-1-2013:p0698:b003:l019","ordinal":130349,"en":"“O wolf-maned father, do not die!” he cried,"},{"id":"semetey-1-2013:p0698:b003:l020","ordinal":130350,"en":"Tears streaming from his eyes."},{"id":"semetey-1-2013:p0698:b003:l021","ordinal":130351,"en":"His soles battered upon stones,"},{"id":"semetey-1-2013:p0698:b003:l022","ordinal":130352,"en":"His brow scorched by the sun,"},{"id":"semetey-1-2013:p0698:b003:l023","ordinal":130353,"en":"Fleeing Urbus, he went on foot,"},{"id":"semetey-1-2013:p0698:b003:l024","ordinal":130354,"en":"He went far for many days."},{"id":"semetey-1-2013:p0698:b003:l025","ordinal":130355,"en":"Red ridges and sheer ranges"},{"id":"semetey-1-2013:p0698:b003:l026","ordinal":130356,"en":"He crossed in hardship for a day."},{"id":"semetey-1-2013:p0698:b003:l027","ordinal":130357,"en":"The son of a hero blessed by Khidr"},{"id":"semetey-1-2013:p0698:b003:l028","ordinal":130358,"en":"Lay suffering one day,"},{"id":"semetey-1-2013:p0698:b003:l029","ordinal":130359,"en":"Taking shelter in a dark cave."},{"id":"semetey-1-2013:p0698:b003:l030","ordinal":130360,"en":"He lay in that dark cave;"},{"id":"semetey-1-2013:p0698:b003:l031","ordinal":130361,"en":"The orphan endured sorrow."},{"id":"semetey-1-2013:p0698:b003:l032","ordinal":130362,"en":"In that place, for hiding,"},{"id":"semetey-1-2013:p0698:b003:l033","ordinal":130363,"en":"There was no shelter but the cave."},{"id":"semetey-1-2013:p0698:b003:l034","ordinal":130364,"en":"For Almambet's only son,"},{"id":"semetey-1-2013:p0698:b003:l035","ordinal":130365,"en":"There was no food to devour."},{"id":"semetey-1-2013:p0698:b003:l036","ordinal":130366,"en":"Before much time had passed,"},{"id":"semetey-1-2013:p0698:b003:l037","ordinal":130367,"en":"Before this or that could be said,"},{"id":"semetey-1-2013:p0698:b003:l038","ordinal":130368,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p0698:b003:l039","ordinal":130369,"en":"God brought him hardship."},{"id":"semetey-1-2013:p0698:b004:l001","ordinal":130370,"en":"The wandering orphan"},{"id":"semetey-1-2013:p0698:b004:l002","ordinal":130371,"en":"Was met—oh, wonder!—"},{"id":"semetey-1-2013:p0698:b004:l003","ordinal":130372,"en":"By a dervish riding a gray bull."},{"id":"semetey-1-2013:p0698:b004:l004","ordinal":130373,"en":"At one glance, the dervish"},{"id":"semetey-1-2013:p0698:b004:l005","ordinal":130374,"en":"Divided into forty men;"},{"id":"semetey-1-2013:p0698:b004:l006","ordinal":130375,"en":"At another glance, the dervish"},{"id":"semetey-1-2013:p0698:b004:l007","ordinal":130376,"en":"Appeared as a thousand people."},{"id":"semetey-1-2013:p0698:b004:l008","ordinal":130377,"en":"It was Kozhosan himself,"},{"id":"semetey-1-2013:p0698:b004:l009","ordinal":130378,"en":"The very presence of the Forty Saints."},{"id":"semetey-1-2013:p0698:b004:l010","ordinal":130379,"en":"For blessed Almam's son,"},{"id":"semetey-1-2013:p0698:b004:l011","ordinal":130380,"en":"The hour to meet him had come."},{"id":"semetey-1-2013:p0698:b004:l012","ordinal":130381,"en":"His protector Kozhosan"},{"id":"semetey-1-2013:p0698:b004:l013","ordinal":130382,"en":"Took the orphan under his protection."},{"id":"semetey-1-2013:p0698:b004:l014","ordinal":130383,"en":"The Forty Saints who gave their hands"},{"id":"semetey-1-2013:p0698:b004:l015","ordinal":130384,"en":"Raised the orphan up."},{"id":"semetey-1-2013:p0698:b004:l016","ordinal":130385,"en":"Father Baabedin cried aloud"},{"id":"semetey-1-2013:p0698:b004:l017","ordinal":130386,"en":"And opened a clear path for him."},{"id":"semetey-1-2013:p0698:b004:l018","ordinal":130387,"en":"Barefoot Saint Kyzyr,"},{"id":"semetey-1-2013:p0698:b004:l019","ordinal":130388,"en":"Twice, three times,"},{"id":"semetey-1-2013:p0698:b004:l020","ordinal":130389,"en":"Gave that child his hand!"},{"id":"semetey-1-2013:p0698:b004:l021","ordinal":130390,"en":"“Son, never flinch from a shouting enemy;"},{"id":"semetey-1-2013:p0698:b004:l023","ordinal":130391,"en":"Never turn back from death;"},{"id":"semetey-1-2013:p0698:b004:l024","ordinal":130392,"en":"Never shrink a hair's breadth from your appointed end!"},{"id":"semetey-1-2013:p0698:b004:l025","ordinal":130393,"en":"Son, placed in front, a bringer of good fortune,"},{"id":"semetey-1-2013:p0698:b004:l026","ordinal":130394,"en":"Leading onward, worth a vast army,"},{"id":"semetey-1-2013:p0698:b004:l027","ordinal":130395,"en":"You have your saintly uncle Bakai."},{"id":"semetey-1-2013:p0698:b004:l028","ordinal":130396,"en":"His forefathers were all khans,"},{"id":"semetey-1-2013:p0698:b004:l029","ordinal":130397,"en":"Blessed by Khidr from the root,"},{"id":"semetey-1-2013:p0698:b004:l030","ordinal":130398,"en":"Descended from mighty-rooted Manas,"},{"id":"semetey-1-2013:p0698:b004:l031","ordinal":130399,"en":"He has reached twelve years."},{"id":"semetey-1-2013:p0698:b004:l032","ordinal":130400,"en":"That is the lion to be your companion,"},{"id":"semetey-1-2013:p0698:b004:l033","ordinal":130401,"en":"That is the hero to understand your ways,"},{"id":"semetey-1-2013:p0698:b004:l034","ordinal":130402,"en":"That is the hero to receive you,"},{"id":"semetey-1-2013:p0698:b004:l035","ordinal":130403,"en":"That is the lion to know your heart."},{"id":"semetey-1-2013:p0698:b004:l036","ordinal":130404,"en":"He has reached twelve years;"},{"id":"semetey-1-2013:p0698:b004:l037","ordinal":130405,"en":"This year is the time for him to come.”"},{"id":"semetey-1-2013:p0698:b004:l038","ordinal":130406,"en":"Saying this, the dervish"},{"id":"semetey-1-2013:p0698:b004:l039","ordinal":130407,"en":"Vanished from sight."},{"id":"semetey-1-2013:p0699:b003:l001","ordinal":130408,"en":"After hearing this, Kulchoro"},{"id":"semetey-1-2013:p0699:b003:l002","ordinal":130409,"en":"Woke with a start from sleep."},{"id":"semetey-1-2013:p0699:b003:l003","ordinal":130410,"en":"The boy ran in excitement,"},{"id":"semetey-1-2013:p0699:b003:l004","ordinal":130411,"en":"Bounding faster than a roe deer."},{"id":"semetey-1-2013:p0699:b003:l005","ordinal":130412,"en":"He went among the cowherds,"},{"id":"semetey-1-2013:p0699:b003:l006","ordinal":130413,"en":"To his mother Burulcha's hut;"},{"id":"semetey-1-2013:p0699:b003:l007","ordinal":130414,"en":"Taking shelter in that hut,"},{"id":"semetey-1-2013:p0699:b003:l008","ordinal":130415,"en":"Kulchoro lived there,"},{"id":"semetey-1-2013:p0699:b003:l009","ordinal":130416,"en":"Barefoot and bareheaded,"},{"id":"semetey-1-2013:p0699:b003:l010","ordinal":130417,"en":"Without clothes, naked,"},{"id":"semetey-1-2013:p0699:b003:l011","ordinal":130418,"en":"Immersed in play."},{"id":"semetey-1-2013:p0699:b003:l012","ordinal":130419,"en":"The cowherds' children"},{"id":"semetey-1-2013:p0699:b003:l013","ordinal":130420,"en":"Kulchoro gathered together,"},{"id":"semetey-1-2013:p0699:b003:l014","ordinal":130421,"en":"And played at shooting knucklebones."},{"id":"semetey-1-2013:p0699:b003:l015","ordinal":130422,"en":"Then your orphan"},{"id":"semetey-1-2013:p0699:b003:l016","ordinal":130423,"en":"Wept and sobbed bitterly,"},{"id":"semetey-1-2013:p0699:b003:l017","ordinal":130424,"en":"Pleading with the cowherds' children:"},{"id":"semetey-1-2013:p0699:b003:l018","ordinal":130425,"en":"“O cowherds' children,"},{"id":"semetey-1-2013:p0699:b003:l019","ordinal":130426,"en":"My dear children!"},{"id":"semetey-1-2013:p0699:b003:l020","ordinal":130427,"en":"God creates the soul;"},{"id":"semetey-1-2013:p0699:b003:l021","ordinal":130428,"en":"All you children, please come here—"},{"id":"semetey-1-2013:p0699:b003:l022","ordinal":130429,"en":"My soul is leaving me."},{"id":"semetey-1-2013:p0699:b003:l023","ordinal":130430,"en":"My whole being is crushed,"},{"id":"semetey-1-2013:p0699:b003:l024","ordinal":130431,"en":"My flesh and nails are stretched apart."},{"id":"semetey-1-2013:p0699:b003:l025","ordinal":130432,"en":"Has God granted it now?"},{"id":"semetey-1-2013:p0699:b003:l026","ordinal":130433,"en":"Has what I lost been found,"},{"id":"semetey-1-2013:p0699:b003:l027","ordinal":130434,"en":"My shame covered this way—"},{"id":"semetey-1-2013:p0699:b003:l028","ordinal":130435,"en":"Has my companion, my elder brother, come?!"},{"id":"semetey-1-2013:p0699:b003:l029","ordinal":130436,"en":"To Temirkan's city"},{"id":"semetey-1-2013:p0699:b003:l030","ordinal":130437,"en":"I hear he went wandering;"},{"id":"semetey-1-2013:p0699:b003:l031","ordinal":130438,"en":"Has my oceanlike brother come?!"},{"id":"semetey-1-2013:p0699:b003:l032","ordinal":130439,"en":"When our fathers died together,"},{"id":"semetey-1-2013:p0699:b003:l033","ordinal":130440,"en":"The vast wealth left by our fathers"},{"id":"semetey-1-2013:p0699:b003:l034","ordinal":130441,"en":"The six villains divided as they pleased."},{"id":"semetey-1-2013:p0699:b003:l035","ordinal":130442,"en":"When they seized the plunder,"},{"id":"semetey-1-2013:p0699:b003:l036","ordinal":130443,"en":"And wrought this havoc,"},{"id":"semetey-1-2013:p0699:b003:l037","ordinal":130444,"en":"They broke into the treasury, grabbing;"},{"id":"semetey-1-2013:p0699:b003:l038","ordinal":130445,"en":"Those witless dogs swaggered,"},{"id":"semetey-1-2013:p0699:b003:l039","ordinal":130446,"en":"And broke into the treasury."},{"id":"semetey-1-2013:p0699:b005:l001","ordinal":130447,"en":"Whole otter pelts"},{"id":"semetey-1-2013:p0699:b005:l002","ordinal":130448,"en":"They split apart,"},{"id":"semetey-1-2013:p0699:b005:l003","ordinal":130449,"en":"And put them round their boot tops."},{"id":"semetey-1-2013:p0699:b005:l004","ordinal":130450,"en":"Their hearts fattened, they ran wild,"},{"id":"semetey-1-2013:p0699:b005:l005","ordinal":130451,"en":"Greedy as slaves whose master had died."},{"id":"semetey-1-2013:p0699:b005:l006","ordinal":130452,"en":"While they plundered the palace,"},{"id":"semetey-1-2013:p0699:b005:l007","ordinal":130453,"en":"When the six villains wrought their havoc fully,"},{"id":"semetey-1-2013:p0699:b005:l009","ordinal":130454,"en":"‘She will settle in an unsuitable place,’ they said;"},{"id":"semetey-1-2013:p0699:b005:l010","ordinal":130455,"en":"‘For a woman whose husband has died,"},{"id":"semetey-1-2013:p0699:b005:l011","ordinal":130456,"en":"Her birth family is close,’ they said."},{"id":"semetey-1-2013:p0699:b005:l012","ordinal":130457,"en":"To Karakan's city"},{"id":"semetey-1-2013:p0699:b005:l013","ordinal":130458,"en":"I heard she had fled;"},{"id":"semetey-1-2013:p0699:b005:l014","ordinal":130459,"en":"To Temirkan's city"},{"id":"semetey-1-2013:p0699:b005:l015","ordinal":130460,"en":"I heard he had gone wandering."},{"id":"semetey-1-2013:p0699:b005:l016","ordinal":130461,"en":"I pieced it together from the tales,"},{"id":"semetey-1-2013:p0699:b005:l017","ordinal":130462,"en":"And asked those who knew."},{"id":"semetey-1-2013:p0699:b005:l018","ordinal":130463,"en":"They say God has granted the wish;"},{"id":"semetey-1-2013:p0699:b005:l019","ordinal":130464,"en":"They say my brother has turned twelve this year."},{"id":"semetey-1-2013:p0699:b005:l020","ordinal":130465,"en":"My dear children,"},{"id":"semetey-1-2013:p0699:b005:l021","ordinal":130466,"en":"Blue-gray haze parts in the sky."},{"id":"semetey-1-2013:p0699:b005:l022","ordinal":130467,"en":"Of father and mother,"},{"id":"semetey-1-2013:p0699:b005:l023","ordinal":130468,"en":"To an orphan left utterly bereft,"},{"id":"semetey-1-2013:p0699:b005:l024","ordinal":130469,"en":"Something seems to be happening."},{"id":"semetey-1-2013:p0699:b005:l025","ordinal":130470,"en":"My dear children,"},{"id":"semetey-1-2013:p0699:b005:l026","ordinal":130471,"en":"To undo dire misfortune,"},{"id":"semetey-1-2013:p0699:b005:l027","ordinal":130472,"en":"My season seems to have come."},{"id":"semetey-1-2013:p0699:b005:l028","ordinal":130473,"en":"Blessed by Khidr from the root,"},{"id":"semetey-1-2013:p0699:b005:l029","ordinal":130474,"en":"My dear children,"},{"id":"semetey-1-2013:p0699:b005:l030","ordinal":130475,"en":"My lord seems to have come!"},{"id":"semetey-1-2013:p0699:b005:l031","ordinal":130476,"en":"To shine light upon my head,"},{"id":"semetey-1-2013:p0699:b005:l032","ordinal":130477,"en":"My moon seems to have come!"},{"id":"semetey-1-2013:p0699:b005:l033","ordinal":130478,"en":"For wishes, the one Night"},{"id":"semetey-1-2013:p0699:b005:l034","ordinal":130479,"en":"Of Power seems to have come!"},{"id":"semetey-1-2013:p0699:b005:l035","ordinal":130480,"en":"To rekindle my extinguished fire,"},{"id":"semetey-1-2013:p0699:b005:l036","ordinal":130481,"en":"To revive my dead soul,"},{"id":"semetey-1-2013:p0699:b005:l037","ordinal":130482,"en":"My dear children,"},{"id":"semetey-1-2013:p0699:b005:l038","ordinal":130483,"en":"My sun seems to have come!"},{"id":"semetey-1-2013:p0699:b005:l039","ordinal":130484,"en":"My dear children,"},{"id":"semetey-1-2013:p0700:b003:l001","ordinal":130485,"en":"A dark ridge to lean upon,"},{"id":"semetey-1-2013:p0700:b003:l002","ordinal":130486,"en":"My support seems to have come."},{"id":"semetey-1-2013:p0700:b003:l003","ordinal":130487,"en":"To take as my support,"},{"id":"semetey-1-2013:p0700:b003:l004","ordinal":130488,"en":"My lion seems to have come!"},{"id":"semetey-1-2013:p0700:b003:l005","ordinal":130489,"en":"My brow will clear today;"},{"id":"semetey-1-2013:p0700:b003:l006","ordinal":130490,"en":"My dear children,"},{"id":"semetey-1-2013:p0700:b003:l007","ordinal":130491,"en":"My grieving heart will be soothed."},{"id":"semetey-1-2013:p0700:b003:l008","ordinal":130492,"en":"The reason it will be soothed—"},{"id":"semetey-1-2013:p0700:b003:l009","ordinal":130493,"en":"Take heed, children—"},{"id":"semetey-1-2013:p0700:b003:l010","ordinal":130494,"en":"From my mother's hut,"},{"id":"semetey-1-2013:p0700:b003:l011","ordinal":130495,"en":"From the hut's roof ring,"},{"id":"semetey-1-2013:p0700:b003:l012","ordinal":130496,"en":"From the wretched house where no fire burns,"},{"id":"semetey-1-2013:p0700:b003:l013","ordinal":130497,"en":"Smoke rises billowing."},{"id":"semetey-1-2013:p0700:b003:l014","ordinal":130498,"en":"For so long, children,"},{"id":"semetey-1-2013:p0700:b003:l015","ordinal":130499,"en":"At the bare post where no horse was tethered,"},{"id":"semetey-1-2013:p0700:b003:l016","ordinal":130500,"en":"Two winged steeds appear."},{"id":"semetey-1-2013:p0700:b003:l017","ordinal":130501,"en":"My mother, who has had no share of fortune,"},{"id":"semetey-1-2013:p0700:b003:l018","ordinal":130502,"en":"Her shrill voice rings out;"},{"id":"semetey-1-2013:p0700:b003:l019","ordinal":130503,"en":"Her piercing voice comes strong."},{"id":"semetey-1-2013:p0700:b003:l020","ordinal":130504,"en":"At the end of her cries,"},{"id":"semetey-1-2013:p0700:b003:l021","ordinal":130505,"en":"She truly cries, ‘My lord!’"},{"id":"semetey-1-2013:p0700:b003:l022","ordinal":130506,"en":"Today is Allah's blessed day."},{"id":"semetey-1-2013:p0700:b003:l024","ordinal":130507,"en":"When I hear that sorrowful voice,"},{"id":"semetey-1-2013:p0700:b003:l025","ordinal":130508,"en":"It is my wretched mother Burulcha's voice."},{"id":"semetey-1-2013:p0700:b003:l026","ordinal":130509,"en":"Of the two souls who came to this desolate house,"},{"id":"semetey-1-2013:p0700:b003:l027","ordinal":130510,"en":"It is my elder brother Semetey himself,"},{"id":"semetey-1-2013:p0700:b003:l028","ordinal":130511,"en":"His very own dark-eyed self,"},{"id":"semetey-1-2013:p0700:b003:l029","ordinal":130512,"en":"‘Where is my orphan?’ he asks;"},{"id":"semetey-1-2013:p0700:b003:l030","ordinal":130513,"en":"He has come in search of me."},{"id":"semetey-1-2013:p0700:b003:l031","ordinal":130514,"en":"The companion at his side,"},{"id":"semetey-1-2013:p0700:b003:l032","ordinal":130515,"en":"My dear children,"},{"id":"semetey-1-2013:p0700:b003:l033","ordinal":130516,"en":"Let me describe him too:"},{"id":"semetey-1-2013:p0700:b003:l034","ordinal":130517,"en":"The protector left by our fathers,"},{"id":"semetey-1-2013:p0700:b003:l035","ordinal":130518,"en":"The saintly elder Bakai."},{"id":"semetey-1-2013:p0700:b003:l036","ordinal":130519,"en":"When our fathers were alive,"},{"id":"semetey-1-2013:p0700:b003:l037","ordinal":130520,"en":"He was appointed governor in many places;"},{"id":"semetey-1-2013:p0700:b003:l038","ordinal":130521,"en":"He too is just such a saint."},{"id":"semetey-1-2013:p0700:b003:l039","ordinal":130522,"en":"When his lord Manas died,"},{"id":"semetey-1-2013:p0700:b004:l001","ordinal":130523,"en":"I heard he tended camels."},{"id":"semetey-1-2013:p0700:b004:l002","ordinal":130524,"en":"When his horse grew thin,"},{"id":"semetey-1-2013:p0700:b004:l003","ordinal":130525,"en":"Mighty Bakai, finding no way out,"},{"id":"semetey-1-2013:p0700:b004:l004","ordinal":130526,"en":"I heard he tended them on foot."},{"id":"semetey-1-2013:p0700:b004:l005","ordinal":130527,"en":"Koktulpar beneath him,"},{"id":"semetey-1-2013:p0700:b004:l006","ordinal":130528,"en":"I heard, had grown thin."},{"id":"semetey-1-2013:p0700:b004:l007","ordinal":130529,"en":"Mighty Bakai upon him,"},{"id":"semetey-1-2013:p0700:b004:l008","ordinal":130530,"en":"I heard, had become wretched."},{"id":"semetey-1-2013:p0700:b004:l009","ordinal":130531,"en":"On a rise like a saddle's ridge,"},{"id":"semetey-1-2013:p0700:b004:l010","ordinal":130532,"en":"I hear he stops."},{"id":"semetey-1-2013:p0700:b004:l011","ordinal":130533,"en":"‘Wretched beasts with no master,’"},{"id":"semetey-1-2013:p0700:b004:l012","ordinal":130534,"en":"I hear him curse them."},{"id":"semetey-1-2013:p0700:b004:l013","ordinal":130535,"en":"Among those camels,"},{"id":"semetey-1-2013:p0700:b004:l014","ordinal":130536,"en":"A dark nar with a broad hump,"},{"id":"semetey-1-2013:p0700:b004:l015","ordinal":130537,"en":"Zhelmaian, left by his khan Manas—"},{"id":"semetey-1-2013:p0700:b004:l016","ordinal":130538,"en":"They say twelve years are complete this year;"},{"id":"semetey-1-2013:p0700:b004:l017","ordinal":130539,"en":"They say it has been twelve years"},{"id":"semetey-1-2013:p0700:b004:l018","ordinal":130540,"en":"That he has mourned, bellowing."},{"id":"semetey-1-2013:p0700:b004:l019","ordinal":130541,"en":"Not rising, wailing,"},{"id":"semetey-1-2013:p0700:b004:l020","ordinal":130542,"en":"His neck hair falling in scorched-looking strands,"},{"id":"semetey-1-2013:p0700:b004:l021","ordinal":130543,"en":"Tears streaming from his eyes,"},{"id":"semetey-1-2013:p0700:b004:l022","ordinal":130544,"en":"He laid his neck upon the ground."},{"id":"semetey-1-2013:p0700:b004:l023","ordinal":130545,"en":"Not rising, Zhelmaian"},{"id":"semetey-1-2013:p0700:b004:l024","ordinal":130546,"en":"Lay there bellowing."},{"id":"semetey-1-2013:p0700:b004:l025","ordinal":130547,"en":"Pulling grass from feather grass to feed him,"},{"id":"semetey-1-2013:p0700:b004:l026","ordinal":130548,"en":"Giving water in a leather pail,"},{"id":"semetey-1-2013:p0700:b004:l027","ordinal":130549,"en":"I heard Bakai went about lamenting."},{"id":"semetey-1-2013:p0700:b004:l028","ordinal":130550,"en":"My uncle Bakai may die;"},{"id":"semetey-1-2013:p0700:b004:l029","ordinal":130551,"en":"If my uncle Bakai does not die,"},{"id":"semetey-1-2013:p0700:b004:l030","ordinal":130552,"en":"Bringing my elder brother with him,"},{"id":"semetey-1-2013:p0700:b004:l031","ordinal":130553,"en":"He will come here."},{"id":"semetey-1-2013:p0700:b004:l032","ordinal":130554,"en":"O cowherds' children,"},{"id":"semetey-1-2013:p0700:b004:l033","ordinal":130555,"en":"My dear children!"},{"id":"semetey-1-2013:p0700:b004:l034","ordinal":130556,"en":"If I do not see him, my wretched soul will die."},{"id":"semetey-1-2013:p0700:b004:l035","ordinal":130557,"en":"My honor will be restored today;"},{"id":"semetey-1-2013:p0700:b004:l036","ordinal":130558,"en":"My exposed back will be covered!”"},{"id":"semetey-1-2013:p0700:b004:l037","ordinal":130559,"en":"So said Kulchoro;"},{"id":"semetey-1-2013:p0700:b004:l038","ordinal":130560,"en":"Bending his knees toward the ground,"}]
