{"id": "sayakbay-ms-current146:pdf188:l001", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 188, "folio": 571, "line_in_page": 1, "raw": "Каш бугу сыбаса,", "text": "Каш бугу сыбаса,", "en": "If the browed maral did not yield,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, name, or idiomatic interpretation requires later witness collation.", "bbox": null}
