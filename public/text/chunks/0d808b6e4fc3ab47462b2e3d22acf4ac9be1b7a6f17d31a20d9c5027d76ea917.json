[{"id":"semetey-1-2013:p1276:b003:l020","ordinal":173569,"en":"With no tebetei on their heads,"},{"id":"semetey-1-2013:p1276:b003:l021","ordinal":173570,"en":"Barefoot and bareheaded,"},{"id":"semetey-1-2013:p1276:b003:l022","ordinal":173571,"en":"Many fled."},{"id":"semetey-1-2013:p1276:b003:l023","ordinal":173572,"en":"Wandering in groups of five and ten,"},{"id":"semetey-1-2013:p1276:b003:l024","ordinal":173573,"en":"Many scattered apart."},{"id":"semetey-1-2013:p1276:b003:l025","ordinal":173574,"en":"Many appeared"},{"id":"semetey-1-2013:p1276:b003:l026","ordinal":173575,"en":"With swift horses beneath them."},{"id":"semetey-1-2013:p1276:b003:l027","ordinal":173576,"en":"Many sought out their own torment"},{"id":"semetey-1-2013:p1276:b003:l028","ordinal":173577,"en":"And became entangled."},{"id":"semetey-1-2013:p1276:b003:l029","ordinal":173578,"en":"Unable to gather their senses,"},{"id":"semetey-1-2013:p1276:b003:l030","ordinal":173579,"en":"They abandoned and cast off their horses;"},{"id":"semetey-1-2013:p1276:b003:l031","ordinal":173580,"en":"Many became trapped"},{"id":"semetey-1-2013:p1276:b003:l032","ordinal":173581,"en":"In pits and hollows."},{"id":"semetey-1-2013:p1276:b003:l033","ordinal":173582,"en":"The Jediger people shrieked."},{"id":"semetey-1-2013:p1276:b003:l034","ordinal":173583,"en":"When the lion prince Semetey"},{"id":"semetey-1-2013:p1276:b003:l035","ordinal":173584,"en":"Charged through the army,"},{"id":"semetey-1-2013:p1276:b003:l036","ordinal":173585,"en":"They lost their wits"},{"id":"semetey-1-2013:p1276:b003:l037","ordinal":173586,"en":"And fled shrieking."},{"id":"semetey-1-2013:p1276:b003:l038","ordinal":173587,"en":"Wherever his spear reached,"},{"id":"semetey-1-2013:p1276:b003:l039","ordinal":173588,"en":"He slaughtered them with the spear."},{"id":"semetey-1-2013:p1276:b004:l001","ordinal":173589,"en":"It was a time when he did"},{"id":"semetey-1-2013:p1276:b004:l002","ordinal":173590,"en":"Wonders no person had seen."},{"id":"semetey-1-2013:p1276:b004:l003","ordinal":173591,"en":"Wherever his sword reached,"},{"id":"semetey-1-2013:p1276:b004:l004","ordinal":173592,"en":"He hacked them with the sword;"},{"id":"semetey-1-2013:p1276:b004:l005","ordinal":173593,"en":"It was a time when he slaughtered them."},{"id":"semetey-1-2013:p1276:b004:l006","ordinal":173594,"en":"It was a time when he did to them"},{"id":"semetey-1-2013:p1276:b004:l007","ordinal":173595,"en":"What had never been done."},{"id":"semetey-1-2013:p1276:b004:l008","ordinal":173596,"en":"The surging Jediger"},{"id":"semetey-1-2013:p1276:b004:l009","ordinal":173597,"en":"Had fallen into panic."},{"id":"semetey-1-2013:p1276:b004:l010","ordinal":173598,"en":"Unable to gather their senses"},{"id":"semetey-1-2013:p1276:b004:l011","ordinal":173599,"en":"Before the leopard prince and sultan,"},{"id":"semetey-1-2013:p1276:b004:l012","ordinal":173600,"en":"They had fled."},{"id":"semetey-1-2013:p1276:b004:l013","ordinal":173601,"en":"Let us leave that there"},{"id":"semetey-1-2013:p1276:b004:l014","ordinal":173602,"en":"And begin the tale"},{"id":"semetey-1-2013:p1276:b004:l015","ordinal":173603,"en":"Of Kulchoro, son of Almambet:"},{"id":"semetey-1-2013:p1276:b004:l016","ordinal":173604,"en":"Raising high"},{"id":"semetey-1-2013:p1276:b004:l017","ordinal":173605,"en":"The red banner left by Manas,"},{"id":"semetey-1-2013:p1276:b004:l018","ordinal":173606,"en":"Shouting, “Manas! Manas!”"},{"id":"semetey-1-2013:p1276:b004:l019","ordinal":173607,"en":"And crying Manas's battle cry,"},{"id":"semetey-1-2013:p1276:b004:l020","ordinal":173608,"en":"Facing Khan Toltoy's army,"},{"id":"semetey-1-2013:p1276:b004:l021","ordinal":173609,"en":"The leopard boy Kulchoro"},{"id":"semetey-1-2013:p1276:b004:l022","ordinal":173610,"en":"Drove in and scattered them."},{"id":"semetey-1-2013:p1276:b004:l023","ordinal":173611,"en":"Looking all around,"},{"id":"semetey-1-2013:p1276:b004:l024","ordinal":173612,"en":"Licking his lips and nose,"},{"id":"semetey-1-2013:p1276:b004:l025","ordinal":173613,"en":"His two eyes darting,"},{"id":"semetey-1-2013:p1276:b004:l026","ordinal":173614,"en":"His two legs dangling,"},{"id":"semetey-1-2013:p1276:b004:l027","ordinal":173615,"en":"He darted in from the side."},{"id":"semetey-1-2013:p1276:b004:l028","ordinal":173616,"en":"When they came before him,"},{"id":"semetey-1-2013:p1276:b004:l029","ordinal":173617,"en":"Kulchoro thrust again and again"},{"id":"semetey-1-2013:p1276:b004:l030","ordinal":173618,"en":"And flung them with his spear."},{"id":"semetey-1-2013:p1276:b004:l031","ordinal":173619,"en":"Did you see the consummate skill"},{"id":"semetey-1-2013:p1276:b004:l032","ordinal":173620,"en":"Of Choro, Almambet's son?!"},{"id":"semetey-1-2013:p1276:b004:l033","ordinal":173621,"en":"Did you see the earth-filling Jediger"},{"id":"semetey-1-2013:p1276:b004:l034","ordinal":173622,"en":"Reduced to nothing?"},{"id":"semetey-1-2013:p1276:b004:l035","ordinal":173623,"en":"Choro appeared like a wolf;"},{"id":"semetey-1-2013:p1276:b004:l036","ordinal":173624,"en":"When he plunged among them,"},{"id":"semetey-1-2013:p1276:b004:l037","ordinal":173625,"en":"All the Jediger"},{"id":"semetey-1-2013:p1276:b004:l038","ordinal":173626,"en":"Split into separate groups."},{"id":"semetey-1-2013:p1276:b004:l039","ordinal":173627,"en":"Wounded, they went away,"},{"id":"semetey-1-2013:p1277:b003:l001","ordinal":173628,"en":"All fleeing in a stream."},{"id":"semetey-1-2013:p1277:b003:l002","ordinal":173629,"en":"As though they could rescue them,"},{"id":"semetey-1-2013:p1277:b003:l003","ordinal":173630,"en":"They all together"},{"id":"semetey-1-2013:p1277:b003:l004","ordinal":173631,"en":"Took refuge with Khan Toltoy."},{"id":"semetey-1-2013:p1277:b003:l005","ordinal":173632,"en":"Kulchoro raged,"},{"id":"semetey-1-2013:p1277:b003:l006","ordinal":173633,"en":"Darting in from the side;"},{"id":"semetey-1-2013:p1277:b003:l007","ordinal":173634,"en":"As though skewering tebetei hats,"},{"id":"semetey-1-2013:p1277:b003:l008","ordinal":173635,"en":"With the tip of his spear"},{"id":"semetey-1-2013:p1277:b003:l009","ordinal":173636,"en":"He whirled and flung them."},{"id":"semetey-1-2013:p1277:b003:l010","ordinal":173637,"en":"Crushing his golden face,"},{"id":"semetey-1-2013:p1277:b003:l011","ordinal":173638,"en":"He made ready like a lion,"},{"id":"semetey-1-2013:p1277:b003:l012","ordinal":173639,"en":"Hounding the foul Toltoy,"},{"id":"semetey-1-2013:p1277:b003:l013","ordinal":173640,"en":"Crushing seven hundred faces."},{"id":"semetey-1-2013:p1277:b003:l014","ordinal":173641,"en":"Kulchoro, fierce as an executioner,"},{"id":"semetey-1-2013:p1277:b003:l015","ordinal":173642,"en":"Hounded the raging Toltoy."},{"id":"semetey-1-2013:p1277:b003:l016","ordinal":173643,"en":"Toltoy, who killed those who grappled him—"},{"id":"semetey-1-2013:p1277:b003:l017","ordinal":173644,"en":"Kulchoro hounded that infidel."},{"id":"semetey-1-2013:p1277:b003:l018","ordinal":173645,"en":"Toltoy, who came to seize a wife—"},{"id":"semetey-1-2013:p1277:b003:l019","ordinal":173646,"en":"Kulchoro hounded that hero."},{"id":"semetey-1-2013:p1277:b003:l020","ordinal":173647,"en":"Toltoy, who drove the Jediger army—"},{"id":"semetey-1-2013:p1277:b003:l021","ordinal":173648,"en":"Kulchoro hounded that skillful man."},{"id":"semetey-1-2013:p1277:b003:l022","ordinal":173649,"en":"Toltoy, who took maidens as booty—"},{"id":"semetey-1-2013:p1277:b003:l023","ordinal":173650,"en":"Kulchoro hounded that mighty man."},{"id":"semetey-1-2013:p1277:b003:l024","ordinal":173651,"en":"Toltoy, who bore the Alengir bow and bronze arrow—"},{"id":"semetey-1-2013:p1277:b003:l025","ordinal":173652,"en":"Kulchoro hounded him."},{"id":"semetey-1-2013:p1277:b003:l026","ordinal":173653,"en":"Toltoy would not come to fight;"},{"id":"semetey-1-2013:p1277:b003:l027","ordinal":173654,"en":"He took refuge and hid."},{"id":"semetey-1-2013:p1277:b003:l028","ordinal":173655,"en":"Scattering the Jediger,"},{"id":"semetey-1-2013:p1277:b003:l029","ordinal":173656,"en":"Kulchoro raged"},{"id":"semetey-1-2013:p1277:b003:l030","ordinal":173657,"en":"And drove Khan Toltoy away."},{"id":"semetey-1-2013:p1277:b003:l031","ordinal":173658,"en":"His wits gone in confusion,"},{"id":"semetey-1-2013:p1277:b003:l032","ordinal":173659,"en":"Kulchoro hounded the panicked Toltoy."},{"id":"semetey-1-2013:p1277:b003:l033","ordinal":173660,"en":"Taking refuge worse than a woman,"},{"id":"semetey-1-2013:p1277:b003:l034","ordinal":173661,"en":"Kulchoro hounded the fleeing Toltoy."},{"id":"semetey-1-2013:p1277:b003:l035","ordinal":173662,"en":"Girding the jekene belt at his waist,"},{"id":"semetey-1-2013:p1277:b003:l036","ordinal":173663,"en":"He charged alone through"},{"id":"semetey-1-2013:p1277:b003:l037","ordinal":173664,"en":"The countless black Jediger."},{"id":"semetey-1-2013:p1277:b003:l038","ordinal":173665,"en":"Girding a white kise belt at his waist,"},{"id":"semetey-1-2013:p1277:b003:l039","ordinal":173666,"en":"The lion boy Kulchoro"},{"id":"semetey-1-2013:p1277:b004:l001","ordinal":173667,"en":"Attacked the countless black Jediger"},{"id":"semetey-1-2013:p1277:b004:l002","ordinal":173668,"en":"And threw them into turmoil."},{"id":"semetey-1-2013:p1277:b004:l003","ordinal":173669,"en":"His bulletproof mail shirt"},{"id":"semetey-1-2013:p1277:b004:l004","ordinal":173670,"en":"Showing upon his chest,"},{"id":"semetey-1-2013:p1277:b004:l005","ordinal":173671,"en":"The twelve-year-old Kulchoro—"},{"id":"semetey-1-2013:p1277:b004:l006","ordinal":173672,"en":"The Jediger host saw"},{"id":"semetey-1-2013:p1277:b004:l007","ordinal":173673,"en":"That he would destroy them."},{"id":"semetey-1-2013:p1277:b004:l008","ordinal":173674,"en":"Dust billowed into the sky;"},{"id":"semetey-1-2013:p1277:b004:l009","ordinal":173675,"en":"The great black Jediger"},{"id":"semetey-1-2013:p1277:b004:l010","ordinal":173676,"en":"All fled shrieking."},{"id":"semetey-1-2013:p1277:b004:l011","ordinal":173677,"en":"Noble Kulchoro"},{"id":"semetey-1-2013:p1277:b004:l012","ordinal":173678,"en":"Was an unmoving lion."},{"id":"semetey-1-2013:p1277:b004:l013","ordinal":173679,"en":"He was a hero who could slaughter"},{"id":"semetey-1-2013:p1277:b004:l014","ordinal":173680,"en":"Not merely the Jediger, but the whole age alone."},{"id":"semetey-1-2013:p1277:b004:l015","ordinal":173681,"en":"His father, blue-maned Almambet,"},{"id":"semetey-1-2013:p1277:b004:l016","ordinal":173682,"en":"Was a lion born surpassing all."},{"id":"semetey-1-2013:p1277:b004:l017","ordinal":173683,"en":"The horse he rode was gray;"},{"id":"semetey-1-2013:p1277:b004:l018","ordinal":173684,"en":"His fortunes were complete."},{"id":"semetey-1-2013:p1277:b004:l019","ordinal":173685,"en":"He was a lion born surpassing"},{"id":"semetey-1-2013:p1277:b004:l020","ordinal":173686,"en":"The lion prince Alman."},{"id":"semetey-1-2013:p1277:b004:l021","ordinal":173687,"en":"His turmoil reached the whole world."},{"id":"semetey-1-2013:p1277:b004:l022","ordinal":173688,"en":"When he went on campaign to Kakan,"},{"id":"semetey-1-2013:p1277:b004:l023","ordinal":173689,"en":"He had left in Aruuke's womb"},{"id":"semetey-1-2013:p1277:b004:l024","ordinal":173690,"en":"A fetus of three months."},{"id":"semetey-1-2013:p1277:b004:l025","ordinal":173691,"en":"Your blue-maned lord Alman"},{"id":"semetey-1-2013:p1277:b004:l026","ordinal":173692,"en":"Joined their hands"},{"id":"semetey-1-2013:p1277:b004:l027","ordinal":173693,"en":"And entrusted him to the lions,"},{"id":"semetey-1-2013:p1277:b004:l028","ordinal":173694,"en":"Saying, “Name him Choro.”"},{"id":"semetey-1-2013:p1277:b004:l029","ordinal":173695,"en":"Spring of the mountain pass,"},{"id":"semetey-1-2013:p1277:b004:l030","ordinal":173696,"en":"Driving the Jediger,"},{"id":"semetey-1-2013:p1277:b004:l031","ordinal":173697,"en":"He was Almambet's lamp."},{"id":"semetey-1-2013:p1277:b004:l032","ordinal":173698,"en":"He began the great slaughter;"},{"id":"semetey-1-2013:p1277:b004:l033","ordinal":173699,"en":"Fierce-born Kulchoro"},{"id":"semetey-1-2013:p1277:b004:l034","ordinal":173700,"en":"Slaughtered half"},{"id":"semetey-1-2013:p1277:b004:l035","ordinal":173701,"en":"The great black Jediger."},{"id":"semetey-1-2013:p1277:b004:l036","ordinal":173702,"en":"Raging and shouting,"},{"id":"semetey-1-2013:p1277:b004:l037","ordinal":173703,"en":"Khan Toltoy's great army—"},{"id":"semetey-1-2013:p1277:b004:l038","ordinal":173704,"en":"To Jangyryk's Jar-Kyya,"},{"id":"semetey-1-2013:p1277:b004:l039","ordinal":173705,"en":"In a single-file stream of horses,"},{"id":"semetey-1-2013:p1278:b003:l001","ordinal":173706,"en":"He drove them all together and crushed them."},{"id":"semetey-1-2013:p1278:b003:l002","ordinal":173707,"en":"The Jediger army gave way;"},{"id":"semetey-1-2013:p1278:b003:l003","ordinal":173708,"en":"The raging Kulchoro"},{"id":"semetey-1-2013:p1278:b003:l004","ordinal":173709,"en":"Drove and chased"},{"id":"semetey-1-2013:p1278:b003:l005","ordinal":173710,"en":"The countless Jediger host"},{"id":"semetey-1-2013:p1278:b003:l006","ordinal":173711,"en":"And packed them into Jar-Kyya."},{"id":"semetey-1-2013:p1278:b003:l007","ordinal":173712,"en":"The young prince Kulchoro—"},{"id":"semetey-1-2013:p1278:b003:l008","ordinal":173713,"en":"As he drove the Jediger,"},{"id":"semetey-1-2013:p1278:b003:l009","ordinal":173714,"en":"Their tusks jutting out,"},{"id":"semetey-1-2013:p1278:b003:l010","ordinal":173715,"en":"The horse corpses formed a mountain."},{"id":"semetey-1-2013:p1278:b003:l011","ordinal":173716,"en":"Their mustaches drooping,"},{"id":"semetey-1-2013:p1278:b003:l012","ordinal":173717,"en":"The warriors' corpses formed a heap."},{"id":"semetey-1-2013:p1278:b003:l013","ordinal":173718,"en":"Raging, he shouted;"},{"id":"semetey-1-2013:p1278:b003:l014","ordinal":173719,"en":"The great black Jediger"},{"id":"semetey-1-2013:p1278:b003:l015","ordinal":173720,"en":"Struck back and scattered."},{"id":"semetey-1-2013:p1278:b003:l016","ordinal":173721,"en":"From fear, the Jediger"},{"id":"semetey-1-2013:p1278:b003:l017","ordinal":173722,"en":"Split into many different groups;"},{"id":"semetey-1-2013:p1278:b003:l018","ordinal":173723,"en":"Those whose deaths had come"},{"id":"semetey-1-2013:p1278:b003:l019","ordinal":173724,"en":"Spilled their blood upon the plain."},{"id":"semetey-1-2013:p1278:b003:l020","ordinal":173725,"en":"Let us leave that there"},{"id":"semetey-1-2013:p1278:b003:l021","ordinal":173726,"en":"And begin from this side:"},{"id":"semetey-1-2013:p1278:b003:l022","ordinal":173727,"en":"Kulchoro of Almambet,"},{"id":"semetey-1-2013:p1278:b003:l023","ordinal":173728,"en":"Baitaylak of Khan Bakai,"},{"id":"semetey-1-2013:p1278:b003:l024","ordinal":173729,"en":"Kalyk of Sary Khan,"},{"id":"semetey-1-2013:p1278:b003:l025","ordinal":173730,"en":"Shayyymbet of Jamgyrchy—"},{"id":"semetey-1-2013:p1278:b003:l026","ordinal":173731,"en":"All were khans' sons."},{"id":"semetey-1-2013:p1278:b003:l027","ordinal":173732,"en":"Raising the white standard as their banner,"},{"id":"semetey-1-2013:p1278:b003:l028","ordinal":173733,"en":"Raising a clamorous battle cry,"},{"id":"semetey-1-2013:p1278:b003:l029","ordinal":173734,"en":"The blue-maned lions now charged"},{"id":"semetey-1-2013:p1278:b003:l030","ordinal":173735,"en":"Into brave Töshtük's army,"},{"id":"semetey-1-2013:p1278:b003:l031","ordinal":173736,"en":"Onto the road where slaughter would come."},{"id":"semetey-1-2013:p1278:b003:l032","ordinal":173737,"en":"Standing face to face,"},{"id":"semetey-1-2013:p1278:b003:l033","ordinal":173738,"en":"Firing guns and drawing bows,"},{"id":"semetey-1-2013:p1278:b003:l034","ordinal":173739,"en":"They fought with snarling fury."},{"id":"semetey-1-2013:p1278:b003:l035","ordinal":173740,"en":"The heroes grappled in battle,"},{"id":"semetey-1-2013:p1278:b003:l036","ordinal":173741,"en":"Driving birchwood spears"},{"id":"semetey-1-2013:p1278:b003:l037","ordinal":173742,"en":"Into the very heart."},{"id":"semetey-1-2013:p1278:b003:l038","ordinal":173743,"en":"The living suffered humiliation;"},{"id":"semetey-1-2013:p1278:b003:l039","ordinal":173744,"en":"Those whose deaths had come died."},{"id":"semetey-1-2013:p1278:b004:l001","ordinal":173745,"en":"The sword-bearing Jediger"},{"id":"semetey-1-2013:p1278:b004:l002","ordinal":173746,"en":"Fought with scabbards and all;"},{"id":"semetey-1-2013:p1278:b004:l003","ordinal":173747,"en":"The battle-ax-bearing Jediger"},{"id":"semetey-1-2013:p1278:b004:l004","ordinal":173748,"en":"Fought with whatever they had."},{"id":"semetey-1-2013:p1278:b004:l005","ordinal":173749,"en":"Brave Toltoy of the Jediger"},{"id":"semetey-1-2013:p1278:b004:l006","ordinal":173750,"en":"Began battle early."},{"id":"semetey-1-2013:p1278:b004:l007","ordinal":173751,"en":"What could dear Tölök do?"},{"id":"semetey-1-2013:p1278:b004:l008","ordinal":173752,"en":"Raising the white standard as his banner,"},{"id":"semetey-1-2013:p1278:b004:l009","ordinal":173753,"en":"Crying “Aziret!” and raising a clamor,"},{"id":"semetey-1-2013:p1278:b004:l010","ordinal":173754,"en":"Arrows from bows shrieked;"},{"id":"semetey-1-2013:p1278:b004:l011","ordinal":173755,"en":"Bullets from short guns clattered."},{"id":"semetey-1-2013:p1278:b004:l012","ordinal":173756,"en":"Spear points clashed;"},{"id":"semetey-1-2013:p1278:b004:l013","ordinal":173757,"en":"They raised a raiding clamor;"},{"id":"semetey-1-2013:p1278:b004:l014","ordinal":173758,"en":"The warriors' heads knocked together."},{"id":"semetey-1-2013:p1278:b004:l015","ordinal":173759,"en":"They fought face to face,"},{"id":"semetey-1-2013:p1278:b004:l016","ordinal":173760,"en":"Standing pressed against one another."},{"id":"semetey-1-2013:p1278:b004:l017","ordinal":173761,"en":"They stared each other down and fought long,"},{"id":"semetey-1-2013:p1278:b004:l018","ordinal":173762,"en":"Wrestling with battle cries;"},{"id":"semetey-1-2013:p1278:b004:l019","ordinal":173763,"en":"Those fated to die died."},{"id":"semetey-1-2013:p1278:b004:l020","ordinal":173764,"en":"They confronted each other face to face,"},{"id":"semetey-1-2013:p1278:b004:l021","ordinal":173765,"en":"Standing and straining hard,"},{"id":"semetey-1-2013:p1278:b004:l022","ordinal":173766,"en":"Fighting beyond mortal measure."},{"id":"semetey-1-2013:p1278:b004:l023","ordinal":173767,"en":"Tölöbay, son of Tölök,"},{"id":"semetey-1-2013:p1278:b004:l024","ordinal":173768,"en":"Charged with a shout from the flank,"},{"id":"semetey-1-2013:p1278:b004:l025","ordinal":173769,"en":"Raising the battle cry of Khan Kozho."},{"id":"semetey-1-2013:p1278:b004:l026","ordinal":173770,"en":"The most skillful with the battle-ax—"},{"id":"semetey-1-2013:p1278:b004:l027","ordinal":173771,"en":"Such was Tölöbay,"},{"id":"semetey-1-2013:p1278:b004:l028","ordinal":173772,"en":"The finest of the gray youths."},{"id":"semetey-1-2013:p1278:b004:l029","ordinal":173773,"en":"Renowned for striking with the battle-ax,"},{"id":"semetey-1-2013:p1278:b004:l030","ordinal":173774,"en":"Skillful at striking with the whip,"},{"id":"semetey-1-2013:p1278:b004:l031","ordinal":173775,"en":"The finest among so many,"},{"id":"semetey-1-2013:p1278:b004:l032","ordinal":173776,"en":"With dust billowing into the sky,"},{"id":"semetey-1-2013:p1278:b004:l033","ordinal":173777,"en":"Crying Toltoy's battle cry,"},{"id":"semetey-1-2013:p1278:b004:l034","ordinal":173778,"en":"Tölöbay charged shrieking."},{"id":"semetey-1-2013:p1278:b004:l035","ordinal":173779,"en":"Riding only dun-gray horses,"},{"id":"semetey-1-2013:p1278:b004:l036","ordinal":173780,"en":"Wearing bulletproof coats,"},{"id":"semetey-1-2013:p1278:b004:l037","ordinal":173781,"en":"Raging and seething,"},{"id":"semetey-1-2013:p1278:b004:l038","ordinal":173782,"en":"Tölöbay's great army"},{"id":"semetey-1-2013:p1278:b004:l039","ordinal":173783,"en":"Engulfed Afghanistan, shrieking,"},{"id":"semetey-1-2013:p1279:b003:l001","ordinal":173784,"en":"Just as they were about to surge over them,"},{"id":"semetey-1-2013:p1279:b003:l002","ordinal":173785,"en":"Upon one flank of the Jediger,"},{"id":"semetey-1-2013:p1279:b003:l003","ordinal":173786,"en":"About to reach their root together,"},{"id":"semetey-1-2013:p1279:b003:l004","ordinal":173787,"en":"About to slaughter their champions,"},{"id":"semetey-1-2013:p1279:b003:l005","ordinal":173788,"en":"And take their daughters as tribute,"},{"id":"semetey-1-2013:p1279:b003:l006","ordinal":173789,"en":"When they had drawn near the city,"},{"id":"semetey-1-2013:p1279:b003:l007","ordinal":173790,"en":"Tümönbay, son of Tülkü,"},{"id":"semetey-1-2013:p1279:b003:l008","ordinal":173791,"en":"Leading many formations of troops,"},{"id":"semetey-1-2013:p1279:b003:l009","ordinal":173792,"en":"Mounted a black-blazed argamak"},{"id":"semetey-1-2013:p1279:b003:l010","ordinal":173793,"en":"And strained for battle,"},{"id":"semetey-1-2013:p1279:b003:l011","ordinal":173794,"en":"Praying to the Almighty,"},{"id":"semetey-1-2013:p1279:b003:l012","ordinal":173795,"en":"His wrapped turban wound around him."},{"id":"semetey-1-2013:p1279:b003:l013","ordinal":173796,"en":"The brass horn shrilled,"},{"id":"semetey-1-2013:p1279:b003:l014","ordinal":173797,"en":"The drum boomed,"},{"id":"semetey-1-2013:p1279:b003:l015","ordinal":173798,"en":"The surnai clattered,"},{"id":"semetey-1-2013:p1279:b003:l016","ordinal":173799,"en":"And spear points flashed."},{"id":"semetey-1-2013:p1279:b003:l017","ordinal":173800,"en":"Tümönbay, son of Tülkü,"},{"id":"semetey-1-2013:p1279:b003:l018","ordinal":173801,"en":"Raised the patterned spear"},{"id":"semetey-1-2013:p1279:b003:l019","ordinal":173802,"en":"And faced Tölöbay,"},{"id":"semetey-1-2013:p1279:b003:l020","ordinal":173803,"en":"Making his argamak prance,"},{"id":"semetey-1-2013:p1279:b003:l021","ordinal":173804,"en":"His blue skullcap perched high."},{"id":"semetey-1-2013:p1279:b003:l022","ordinal":173805,"en":"Reckless and pounding in the chest,"},{"id":"semetey-1-2013:p1279:b003:l023","ordinal":173806,"en":"Proud and thundering in the lungs,"},{"id":"semetey-1-2013:p1279:b003:l024","ordinal":173807,"en":"Weak in command but himself a hero,"},{"id":"semetey-1-2013:p1279:b003:l025","ordinal":173808,"en":"He faced Tölöbay;"},{"id":"semetey-1-2013:p1279:b003:l026","ordinal":173809,"en":"That was where slaughter began."},{"id":"semetey-1-2013:p1279:b003:l027","ordinal":173810,"en":"Afghan and Jediger"},{"id":"semetey-1-2013:p1279:b003:l028","ordinal":173811,"en":"Met face to face"},{"id":"semetey-1-2013:p1279:b003:l029","ordinal":173812,"en":"And fought beyond mortal measure."},{"id":"semetey-1-2013:p1279:b003:l030","ordinal":173813,"en":"Spears struck and horses died;"},{"id":"semetey-1-2013:p1279:b003:l031","ordinal":173814,"en":"Brave men quickly died."},{"id":"semetey-1-2013:p1279:b003:l032","ordinal":173815,"en":"They stood slaughtering one another"},{"id":"semetey-1-2013:p1279:b003:l033","ordinal":173816,"en":"And fought with terrible fury."},{"id":"semetey-1-2013:p1279:b003:l034","ordinal":173817,"en":"Straining against one another,"},{"id":"semetey-1-2013:p1279:b003:l035","ordinal":173818,"en":"Firing guns and drawing bows,"},{"id":"semetey-1-2013:p1279:b003:l036","ordinal":173819,"en":"They fought with crashing blows."},{"id":"semetey-1-2013:p1279:b003:l037","ordinal":173820,"en":"Mounting stallions from the tethering line,"},{"id":"semetey-1-2013:p1279:b003:l038","ordinal":173821,"en":"Taking poles up from the ground,"},{"id":"semetey-1-2013:p1279:b003:l039","ordinal":173822,"en":"Shouting, “Japyrim!” as they fought—"},{"id":"semetey-1-2013:p1279:b004:l001","ordinal":173823,"en":"Now it became a terrible battle."},{"id":"semetey-1-2013:p1279:b004:l002","ordinal":173824,"en":"They fought with spears;"}]
