[{"id":"semetey-1-2013:p1132:b004:l030","ordinal":163585,"en":"Kökötöy's arrogant son Bokmurun,"},{"id":"semetey-1-2013:p1132:b004:l031","ordinal":163586,"en":"When Khan Kökötöy died,"},{"id":"semetey-1-2013:p1132:b004:l032","ordinal":163587,"en":"Had hastened to gather a multitude."},{"id":"semetey-1-2013:p1132:b004:l033","ordinal":163588,"en":"Receiving no news and hearing no account,"},{"id":"semetey-1-2013:p1132:b004:l034","ordinal":163589,"en":"Khan Manas remained offended."},{"id":"semetey-1-2013:p1132:b004:l035","ordinal":163590,"en":"His eyes blazed like fire;"},{"id":"semetey-1-2013:p1132:b004:l036","ordinal":163591,"en":"If you had seen the leopard,"},{"id":"semetey-1-2013:p1132:b004:l037","ordinal":163592,"en":"His thirst for blood had seized him."},{"id":"semetey-1-2013:p1132:b004:l038","ordinal":163593,"en":"In all the eighteen thousand worlds,"},{"id":"semetey-1-2013:p1132:b004:l039","ordinal":163594,"en":"For righteous, bloodthirsty Manas—"},{"id":"semetey-1-2013:p1133:b003:l001","ordinal":163595,"en":"Not even a stick for a horse-catching pole remained."},{"id":"semetey-1-2013:p1133:b003:l002","ordinal":163596,"en":"Khan Manas's royal encampment,"},{"id":"semetey-1-2013:p1133:b003:l003","ordinal":163597,"en":"Kanykei's white palace,"},{"id":"semetey-1-2013:p1133:b003:l004","ordinal":163598,"en":"Its gate of solid tin,"},{"id":"semetey-1-2013:p1133:b003:l005","ordinal":163599,"en":"Was a place no person brought news to,"},{"id":"semetey-1-2013:p1133:b003:l006","ordinal":163600,"en":"And no soul visited."},{"id":"semetey-1-2013:p1133:b003:l007","ordinal":163601,"en":"Of anyone who went without an answer,"},{"id":"semetey-1-2013:p1133:b003:l008","ordinal":163602,"en":"Not one remained alive."},{"id":"semetey-1-2013:p1133:b003:l009","ordinal":163603,"en":"Before its door,"},{"id":"semetey-1-2013:p1133:b003:l010","ordinal":163604,"en":"Standing sternly with swords in hand,"},{"id":"semetey-1-2013:p1133:b003:l011","ordinal":163605,"en":"Were exactly forty wrestler guards;"},{"id":"semetey-1-2013:p1133:b003:l012","ordinal":163606,"en":"Its gatekeepers were beyond number."},{"id":"semetey-1-2013:p1133:b003:l013","ordinal":163607,"en":"They wore human noses and ears"},{"id":"semetey-1-2013:p1133:b003:l014","ordinal":163608,"en":"As amulets,"},{"id":"semetey-1-2013:p1133:b003:l015","ordinal":163609,"en":"And were covered in the hides"},{"id":"semetey-1-2013:p1133:b003:l016","ordinal":163610,"en":"Of seventy executioners."},{"id":"semetey-1-2013:p1133:b003:l017","ordinal":163611,"en":"At the mouth of that doorway"},{"id":"semetey-1-2013:p1133:b003:l018","ordinal":163612,"en":"Was a war drum for announcing news;"},{"id":"semetey-1-2013:p1133:b003:l019","ordinal":163613,"en":"When any enemy approached,"},{"id":"semetey-1-2013:p1133:b003:l020","ordinal":163614,"en":"His wrestlers beat it."},{"id":"semetey-1-2013:p1133:b003:l021","ordinal":163615,"en":"When they heard the drum's sound,"},{"id":"semetey-1-2013:p1133:b003:l022","ordinal":163616,"en":"With brave Manas at their head,"},{"id":"semetey-1-2013:p1133:b003:l023","ordinal":163617,"en":"When all forty companions came forth,"},{"id":"semetey-1-2013:p1133:b003:l024","ordinal":163618,"en":"The courage utterly left"},{"id":"semetey-1-2013:p1133:b003:l025","ordinal":163619,"en":"Anyone who drew near."},{"id":"semetey-1-2013:p1133:b003:l026","ordinal":163620,"en":"They had made Talas their homeland"},{"id":"semetey-1-2013:p1133:b003:l027","ordinal":163621,"en":"And settled there, he thought;"},{"id":"semetey-1-2013:p1133:b003:l028","ordinal":163622,"en":"Young Aydar stood amazed,"},{"id":"semetey-1-2013:p1133:b003:l029","ordinal":163623,"en":"Thinking they had become a whole world,"},{"id":"semetey-1-2013:p1133:b003:l030","ordinal":163624,"en":"Let alone merely Chinese."},{"id":"semetey-1-2013:p1133:b003:l031","ordinal":163625,"en":"Manas the keen-eyed leopard"},{"id":"semetey-1-2013:p1133:b003:l032","ordinal":163626,"en":"Was at the point of unleashing"},{"id":"semetey-1-2013:p1133:b003:l033","ordinal":163627,"en":"Festivities upon the Chinese."},{"id":"semetey-1-2013:p1133:b003:l034","ordinal":163628,"en":"If nocturnal Beijing and Kakanchyn"},{"id":"semetey-1-2013:p1133:b003:l035","ordinal":163629,"en":"Attacked with all their might,"},{"id":"semetey-1-2013:p1133:b003:l036","ordinal":163630,"en":"He was at the point of taking them all,"},{"id":"semetey-1-2013:p1133:b003:l037","ordinal":163631,"en":"Leaving not a hair behind."},{"id":"semetey-1-2013:p1133:b003:l038","ordinal":163632,"en":"Young Aydar saw Manas"},{"id":"semetey-1-2013:p1133:b003:l039","ordinal":163633,"en":"And, saying, “He looks fearsome,”"},{"id":"semetey-1-2013:p1133:b004:l001","ordinal":163634,"en":"Rejoiced with all his soul!"},{"id":"semetey-1-2013:p1133:b004:l002","ordinal":163635,"en":"“Brave Manas the leopard"},{"id":"semetey-1-2013:p1133:b004:l003","ordinal":163636,"en":"Is broad across the right shoulder."},{"id":"semetey-1-2013:p1133:b004:l004","ordinal":163637,"en":"For the mere handful of Muslims,"},{"id":"semetey-1-2013:p1133:b004:l005","ordinal":163638,"en":"He is a lion who will remain"},{"id":"semetey-1-2013:p1133:b004:l006","ordinal":163639,"en":"As their supporting pillar!"},{"id":"semetey-1-2013:p1133:b004:l007","ordinal":163640,"en":"Kökötöy's son Bokmurun"},{"id":"semetey-1-2013:p1133:b004:l008","ordinal":163641,"en":"Has grown arrogant,"},{"id":"semetey-1-2013:p1133:b004:l009","ordinal":163642,"en":"Failing to send word to the gray wolf!"},{"id":"semetey-1-2013:p1133:b004:l010","ordinal":163643,"en":"I wore down my horse's flanks;"},{"id":"semetey-1-2013:p1133:b004:l011","ordinal":163644,"en":"Among all people upon the earth,"},{"id":"semetey-1-2013:p1133:b004:l012","ordinal":163645,"en":"I visited every one."},{"id":"semetey-1-2013:p1133:b004:l013","ordinal":163646,"en":"When I saw Manas's form,"},{"id":"semetey-1-2013:p1133:b004:l014","ordinal":163647,"en":"My mind was deeply shaken."},{"id":"semetey-1-2013:p1133:b004:l015","ordinal":163648,"en":"Among infidels and Muslims,"},{"id":"semetey-1-2013:p1133:b004:l016","ordinal":163649,"en":"Among all the giants on earth,"},{"id":"semetey-1-2013:p1133:b004:l017","ordinal":163650,"en":"Where has another like him appeared!"},{"id":"semetey-1-2013:p1133:b004:l018","ordinal":163651,"en":"His fortune is complete;"},{"id":"semetey-1-2013:p1133:b004:l019","ordinal":163652,"en":"He is a hero who receives and protects"},{"id":"semetey-1-2013:p1133:b004:l020","ordinal":163653,"en":"The wretched people without making them wander."},{"id":"semetey-1-2013:p1133:b004:l021","ordinal":163654,"en":"His brow is high and his face venomous;"},{"id":"semetey-1-2013:p1133:b004:l022","ordinal":163655,"en":"What soul survives when the bloodthirsty one kills?"},{"id":"semetey-1-2013:p1133:b004:l023","ordinal":163656,"en":"His face is like oiled wheat,"},{"id":"semetey-1-2013:p1133:b004:l024","ordinal":163657,"en":"His eyes like twilight mist."},{"id":"semetey-1-2013:p1133:b004:l025","ordinal":163658,"en":"The madman who confronts him—"},{"id":"semetey-1-2013:p1133:b004:l026","ordinal":163659,"en":"The way he faces becomes a red fire."},{"id":"semetey-1-2013:p1133:b004:l027","ordinal":163660,"en":"His courage is formidable, his venom strong;"},{"id":"semetey-1-2013:p1133:b004:l028","ordinal":163661,"en":"He lays flat whoever attacks him!”"},{"id":"semetey-1-2013:p1133:b004:l029","ordinal":163662,"en":"His prince sat firm as a camel;"},{"id":"semetey-1-2013:p1133:b004:l030","ordinal":163663,"en":"With mighty Bakai at their head,"},{"id":"semetey-1-2013:p1133:b004:l031","ordinal":163664,"en":"Twenty were on his right."},{"id":"semetey-1-2013:p1133:b004:l032","ordinal":163665,"en":"Each was worth a thousand,"},{"id":"semetey-1-2013:p1133:b004:l033","ordinal":163666,"en":"All gray-wolf champions of noble stock."},{"id":"semetey-1-2013:p1133:b004:l034","ordinal":163667,"en":"With Khan Almanbet at their head,"},{"id":"semetey-1-2013:p1133:b004:l035","ordinal":163668,"en":"Twenty were on his left."},{"id":"semetey-1-2013:p1133:b004:l036","ordinal":163669,"en":"Their waists girded for single combat,"},{"id":"semetey-1-2013:p1133:b004:l037","ordinal":163670,"en":"Against an army of seven countless hosts,"},{"id":"semetey-1-2013:p1133:b004:l038","ordinal":163671,"en":"They charged alone through its midst,"},{"id":"semetey-1-2013:p1133:b004:l039","ordinal":163672,"en":"A brood like monsters."},{"id":"semetey-1-2013:p1134:b003:l001","ordinal":163673,"en":"Khan Manas's forty companions—"},{"id":"semetey-1-2013:p1134:b003:l002","ordinal":163674,"en":"The most cunning of spearmen."},{"id":"semetey-1-2013:p1134:b003:l003","ordinal":163675,"en":"Among those companions,"},{"id":"semetey-1-2013:p1134:b003:l004","ordinal":163676,"en":"Azhibai and Chubak were the strongest."},{"id":"semetey-1-2013:p1134:b003:l005","ordinal":163677,"en":"Khan Manas's forty companions—"},{"id":"semetey-1-2013:p1134:b003:l006","ordinal":163678,"en":"The sight of them divides one's attention;"},{"id":"semetey-1-2013:p1134:b003:l007","ordinal":163679,"en":"Most looked like naked blades."},{"id":"semetey-1-2013:p1134:b003:l008","ordinal":163680,"en":"Told to take a hat, they cut off a head;"},{"id":"semetey-1-2013:p1134:b003:l009","ordinal":163681,"en":"Told to drink water, they drank poison."},{"id":"semetey-1-2013:p1134:b003:l010","ordinal":163682,"en":"Each was a gray-wolf peerless champion,"},{"id":"semetey-1-2013:p1134:b003:l011","ordinal":163683,"en":"Forty distinguished men"},{"id":"semetey-1-2013:p1134:b003:l012","ordinal":163684,"en":"Who came from forty different places."},{"id":"semetey-1-2013:p1134:b003:l013","ordinal":163685,"en":"Each of the forty had a different way,"},{"id":"semetey-1-2013:p1134:b003:l014","ordinal":163686,"en":"With barbed spears and red caps,"},{"id":"semetey-1-2013:p1134:b003:l015","ordinal":163687,"en":"Like blazing red fire."},{"id":"semetey-1-2013:p1134:b003:l016","ordinal":163688,"en":"The forty companions, wolves of war:"},{"id":"semetey-1-2013:p1134:b003:l017","ordinal":163689,"en":"Tölömön's diviner"},{"id":"semetey-1-2013:p1134:b003:l018","ordinal":163690,"en":"Cast omens at their head;"},{"id":"semetey-1-2013:p1134:b003:l019","ordinal":163691,"en":"Yrchyuul, son of Yraman,"},{"id":"semetey-1-2013:p1134:b003:l020","ordinal":163692,"en":"Sang beside them."},{"id":"semetey-1-2013:p1134:b003:l021","ordinal":163693,"en":"Their wrath turned outward;"},{"id":"semetey-1-2013:p1134:b003:l022","ordinal":163694,"en":"Khan Manas's forty companions"},{"id":"semetey-1-2013:p1134:b003:l023","ordinal":163695,"en":"Bound on swords without scabbards."},{"id":"semetey-1-2013:p1134:b003:l024","ordinal":163696,"en":"Beside Khan Manas,"},{"id":"semetey-1-2013:p1134:b003:l025","ordinal":163697,"en":"They stood raging,"},{"id":"semetey-1-2013:p1134:b003:l026","ordinal":163698,"en":"Finding no mountain to strike,"},{"id":"semetey-1-2013:p1134:b003:l027","ordinal":163699,"en":"Finding no enemy to fight,"},{"id":"semetey-1-2013:p1134:b003:l028","ordinal":163700,"en":"Gathering themselves with a growl."},{"id":"semetey-1-2013:p1134:b003:l029","ordinal":163701,"en":"The forty companions wore"},{"id":"semetey-1-2013:p1134:b003:l030","ordinal":163702,"en":"Blue-lynx and sable hats;"},{"id":"semetey-1-2013:p1134:b003:l031","ordinal":163703,"en":"The way they faced was red fire."},{"id":"semetey-1-2013:p1134:b003:l032","ordinal":163704,"en":"Young Aydar walked"},{"id":"semetey-1-2013:p1134:b003:l033","ordinal":163705,"en":"Before valiant Manas,"},{"id":"semetey-1-2013:p1134:b003:l034","ordinal":163706,"en":"Giving him six swift horses"},{"id":"semetey-1-2013:p1134:b003:l035","ordinal":163707,"en":"And a palm-sized letter:"},{"id":"semetey-1-2013:p1134:b003:l036","ordinal":163708,"en":"“Koshoy and Töshtük are your khans;"},{"id":"semetey-1-2013:p1134:b003:l037","ordinal":163709,"en":"Our souls are sorely afflicted."},{"id":"semetey-1-2013:p1134:b003:l038","ordinal":163710,"en":"At Khan Kökötöy's memorial feast,"},{"id":"semetey-1-2013:p1134:b003:l039","ordinal":163711,"en":"A great gathering assembled,"},{"id":"semetey-1-2013:p1134:b004:l001","ordinal":163712,"en":"And we are all about to be slaughtered."},{"id":"semetey-1-2013:p1134:b004:l002","ordinal":163713,"en":"Gray-wolf Manas, go"},{"id":"semetey-1-2013:p1134:b004:l003","ordinal":163714,"en":"To Kökötöy's memorial feast."},{"id":"semetey-1-2013:p1134:b004:l004","ordinal":163715,"en":"The Muslims lie in humiliation;"},{"id":"semetey-1-2013:p1134:b004:l005","ordinal":163716,"en":"Rescue them"},{"id":"semetey-1-2013:p1134:b004:l006","ordinal":163717,"en":"From the Black Chinese and Manchus!"},{"id":"semetey-1-2013:p1134:b004:l007","ordinal":163718,"en":"If you do not rescue them,"},{"id":"semetey-1-2013:p1134:b004:l008","ordinal":163719,"en":"The fearsome Black Chinese"},{"id":"semetey-1-2013:p1134:b004:l009","ordinal":163720,"en":"Will bring hardship upon their heads"},{"id":"semetey-1-2013:p1134:b004:l010","ordinal":163721,"en":"And strike them down to the last."},{"id":"semetey-1-2013:p1134:b004:l011","ordinal":163722,"en":"Koshoy and Töshtük may die;"},{"id":"semetey-1-2013:p1134:b004:l012","ordinal":163723,"en":"The Black Chinese and Manchus"},{"id":"semetey-1-2013:p1134:b004:l013","ordinal":163724,"en":"May divide all the Muslims"},{"id":"semetey-1-2013:p1134:b004:l014","ordinal":163725,"en":"Into shares measured by the whip."},{"id":"semetey-1-2013:p1134:b004:l015","ordinal":163726,"en":"They may slaughter every one, leaving none;"},{"id":"semetey-1-2013:p1134:b004:l016","ordinal":163727,"en":"Kalcha, Zholoy, and Ezkara—"},{"id":"semetey-1-2013:p1134:b004:l017","ordinal":163728,"en":"These three have joined together"},{"id":"semetey-1-2013:p1134:b004:l018","ordinal":163729,"en":"And may do whatever they please."},{"id":"semetey-1-2013:p1134:b004:l019","ordinal":163730,"en":"At our very hearth we suffered humiliation;"},{"id":"semetey-1-2013:p1134:b004:l020","ordinal":163731,"en":"Among the Black Chinese and Manchus,"},{"id":"semetey-1-2013:p1134:b004:l021","ordinal":163732,"en":"We saw a tyrant named Kongurbai."},{"id":"semetey-1-2013:p1134:b004:l022","ordinal":163733,"en":"Zholoy used his force,"},{"id":"semetey-1-2013:p1134:b004:l023","ordinal":163734,"en":"Demanding that Maaniker be given him;"},{"id":"semetey-1-2013:p1134:b004:l024","ordinal":163735,"en":"Ezkara inflicted humiliation."},{"id":"semetey-1-2013:p1134:b004:l025","ordinal":163736,"en":"They were ready to make us taste salt,"},{"id":"semetey-1-2013:p1134:b004:l026","ordinal":163737,"en":"And ready to plunder the girls."},{"id":"semetey-1-2013:p1134:b004:l027","ordinal":163738,"en":"They seized and ate the meat;"},{"id":"semetey-1-2013:p1134:b004:l028","ordinal":163739,"en":"They were ready to destroy every face."},{"id":"semetey-1-2013:p1134:b004:l029","ordinal":163740,"en":"If you, the burdened one, do not go,"},{"id":"semetey-1-2013:p1134:b004:l030","ordinal":163741,"en":"They may cast a cold catching-pole"},{"id":"semetey-1-2013:p1134:b004:l031","ordinal":163742,"en":"Upon the racehorse that would not be given when asked."},{"id":"semetey-1-2013:p1134:b004:l032","ordinal":163743,"en":"They may leave all the Muslim giants"},{"id":"semetey-1-2013:p1134:b004:l033","ordinal":163744,"en":"Entirely on foot"},{"id":"semetey-1-2013:p1134:b004:l034","ordinal":163745,"en":"And seize their horses."},{"id":"semetey-1-2013:p1134:b004:l035","ordinal":163746,"en":"Before all the other peoples, those Chinese,"},{"id":"semetey-1-2013:p1134:b004:l036","ordinal":163747,"en":"If allowed to have their way,"},{"id":"semetey-1-2013:p1134:b004:l037","ordinal":163748,"en":"May use force at the feast."},{"id":"semetey-1-2013:p1134:b004:l038","ordinal":163749,"en":"I saw it with my own eyes."},{"id":"semetey-1-2013:p1134:b004:l039","ordinal":163750,"en":"They besieged the Muslims,"},{"id":"semetey-1-2013:p1135:b003:l001","ordinal":163751,"en":"The black Kalmyks plundered"},{"id":"semetey-1-2013:p1135:b003:l002","ordinal":163752,"en":"Kökötöy's fatty meat."},{"id":"semetey-1-2013:p1135:b003:l003","ordinal":163753,"en":"Unable to restrain the many infidels,"},{"id":"semetey-1-2013:p1135:b003:l004","ordinal":163754,"en":"The Muslims grew weary."},{"id":"semetey-1-2013:p1135:b003:l005","ordinal":163755,"en":"From Ezkara came a challenge;"},{"id":"semetey-1-2013:p1135:b003:l006","ordinal":163756,"en":"From Zholoy the black Kalmyk"},{"id":"semetey-1-2013:p1135:b003:l007","ordinal":163757,"en":"Came fierce turmoil and strife."},{"id":"semetey-1-2013:p1135:b003:l008","ordinal":163758,"en":"If you truly are a hero,"},{"id":"semetey-1-2013:p1135:b003:l009","ordinal":163759,"en":"Go now, Manas;"},{"id":"semetey-1-2013:p1135:b003:l010","ordinal":163760,"en":"The Muslims are about to be destroyed—"},{"id":"semetey-1-2013:p1135:b003:l011","ordinal":163761,"en":"Go and separate them!"},{"id":"semetey-1-2013:p1135:b003:l012","ordinal":163762,"en":"You are a khan, a tiger!"},{"id":"semetey-1-2013:p1135:b003:l013","ordinal":163763,"en":"Here is the city with many towers;"},{"id":"semetey-1-2013:p1135:b003:l014","ordinal":163764,"en":"Here am I, if you would cut off my head!"},{"id":"semetey-1-2013:p1135:b003:l015","ordinal":163765,"en":"Külaiym, seated in mourning for Kökötöy—"},{"id":"semetey-1-2013:p1135:b003:l016","ordinal":163766,"en":"The infidel stretched out his hand,"},{"id":"semetey-1-2013:p1135:b003:l017","ordinal":163767,"en":"Laid hands upon the bereaved woman,"},{"id":"semetey-1-2013:p1135:b003:l018","ordinal":163768,"en":"And God struck the Kalmyk."},{"id":"semetey-1-2013:p1135:b003:l019","ordinal":163769,"en":"With hero Kongurbay at their head,"},{"id":"semetey-1-2013:p1135:b003:l020","ordinal":163770,"en":"The Chinese girded their waists firmly,"},{"id":"semetey-1-2013:p1135:b003:l021","ordinal":163771,"en":"Ready, if they found the means,"},{"id":"semetey-1-2013:p1135:b003:l022","ordinal":163772,"en":"To pursue Alööke's blood-price,"},{"id":"semetey-1-2013:p1135:b003:l023","ordinal":163773,"en":"To raid the villages of the Muslims"},{"id":"semetey-1-2013:p1135:b003:l024","ordinal":163774,"en":"Who had gone to the feast;"},{"id":"semetey-1-2013:p1135:b003:l025","ordinal":163775,"en":"Zholoy of the Kalmyks"},{"id":"semetey-1-2013:p1135:b003:l026","ordinal":163776,"en":"Was ready to bring utter destruction."},{"id":"semetey-1-2013:p1135:b003:l027","ordinal":163777,"en":"Bloodthirsty Manas, the tiger,"},{"id":"semetey-1-2013:p1135:b003:l028","ordinal":163778,"en":"If you truly are a khan,"},{"id":"semetey-1-2013:p1135:b003:l029","ordinal":163779,"en":"You will rise in courage."},{"id":"semetey-1-2013:p1135:b003:l030","ordinal":163780,"en":"When you aim at the Manchu whose turn has come,"},{"id":"semetey-1-2013:p1135:b003:l031","ordinal":163781,"en":"You will reach him, Manas."},{"id":"semetey-1-2013:p1135:b003:l032","ordinal":163782,"en":"At Khan Kökötöy's feast,"},{"id":"semetey-1-2013:p1135:b003:l033","ordinal":163783,"en":"You, tiger Manas, were absent."},{"id":"semetey-1-2013:p1135:b003:l034","ordinal":163784,"en":"We struck the Koroson firestone"},{"id":"semetey-1-2013:p1135:b003:l035","ordinal":163785,"en":"Infidel and Muslim alike,"},{"id":"semetey-1-2013:p1135:b003:l036","ordinal":163786,"en":"We summoned every one of them."},{"id":"semetey-1-2013:p1135:b003:l037","ordinal":163787,"en":"The people gathered in a mass;"},{"id":"semetey-1-2013:p1135:b003:l038","ordinal":163788,"en":"Dust flew into the sky."},{"id":"semetey-1-2013:p1135:b003:l039","ordinal":163789,"en":"Swarming like black worms,"},{"id":"semetey-1-2013:p1135:b004:l001","ordinal":163790,"en":"They escaped the eye when one looked,"},{"id":"semetey-1-2013:p1135:b004:l002","ordinal":163791,"en":"And none could tell which was which;"},{"id":"semetey-1-2013:p1135:b004:l003","ordinal":163792,"en":"Infidel and Muslim alike"},{"id":"semetey-1-2013:p1135:b004:l004","ordinal":163793,"en":"Seethed and filled the place in agitation."},{"id":"semetey-1-2013:p1135:b004:l005","ordinal":163794,"en":"Kökötöy's great riches"},{"id":"semetey-1-2013:p1135:b004:l006","ordinal":163795,"en":"Were squandered and scattered;"},{"id":"semetey-1-2013:p1135:b004:l007","ordinal":163796,"en":"All the abundant gold"},{"id":"semetey-1-2013:p1135:b004:l008","ordinal":163797,"en":"Was trampled underfoot."},{"id":"semetey-1-2013:p1135:b004:l009","ordinal":163798,"en":"Among all those possessions,"},{"id":"semetey-1-2013:p1135:b004:l010","ordinal":163799,"en":"Ezkara attacked"},{"id":"semetey-1-2013:p1135:b004:l011","ordinal":163800,"en":"The swift horse Maaniker."},{"id":"semetey-1-2013:p1135:b004:l012","ordinal":163801,"en":"Bokmurun, giver of the feast,"},{"id":"semetey-1-2013:p1135:b004:l013","ordinal":163802,"en":"Bolted out from among the people;"},{"id":"semetey-1-2013:p1135:b004:l014","ordinal":163803,"en":"I saw the place where he fled."},{"id":"semetey-1-2013:p1135:b004:l015","ordinal":163804,"en":"My uncle Koshoy lost his bearings;"},{"id":"semetey-1-2013:p1135:b004:l016","ordinal":163805,"en":"I saw the place where he panicked."},{"id":"semetey-1-2013:p1135:b004:l017","ordinal":163806,"en":"There were Muzburchak and Khan Kökchö,"},{"id":"semetey-1-2013:p1135:b004:l018","ordinal":163807,"en":"And all the Muslim giants."},{"id":"semetey-1-2013:p1135:b004:l019","ordinal":163808,"en":"There was Akun Khan of Afghanistan,"},{"id":"semetey-1-2013:p1135:b004:l020","ordinal":163809,"en":"And all the mighty men."},{"id":"semetey-1-2013:p1135:b004:l021","ordinal":163810,"en":"There was Kökbörü, son of Urumkan,"},{"id":"semetey-1-2013:p1135:b004:l022","ordinal":163811,"en":"The lion among heroes."},{"id":"semetey-1-2013:p1135:b004:l023","ordinal":163812,"en":"Unable to withstand anyone,"},{"id":"semetey-1-2013:p1135:b004:l024","ordinal":163813,"en":"Before infidels as numerous as cow hairs,"},{"id":"semetey-1-2013:p1135:b004:l025","ordinal":163814,"en":"They had a time of reeling in panic."},{"id":"semetey-1-2013:p1135:b004:l026","ordinal":163815,"en":"Sour ayran, blue kurut—"},{"id":"semetey-1-2013:p1135:b004:l027","ordinal":163816,"en":"He wrought an end-of-time deed,"},{"id":"semetey-1-2013:p1135:b004:l028","ordinal":163817,"en":"Bokmurun, Kökötöy's foul urine,"},{"id":"semetey-1-2013:p1135:b004:l029","ordinal":163818,"en":"Trusting in the abundance of gold,"},{"id":"semetey-1-2013:p1135:b004:l030","ordinal":163819,"en":"Against the very roots of the Muslim people.\""},{"id":"semetey-1-2013:p1135:b004:l031","ordinal":163820,"en":"After the boy had spoken thus,"},{"id":"semetey-1-2013:p1135:b004:l032","ordinal":163821,"en":"Manas then said:"},{"id":"semetey-1-2013:p1135:b004:l033","ordinal":163822,"en":"\"Damn your father's grave, young Aydar;"},{"id":"semetey-1-2013:p1135:b004:l034","ordinal":163823,"en":"You and Bokmurun are drunk, Aydar!"},{"id":"semetey-1-2013:p1135:b004:l035","ordinal":163824,"en":"You have no loyalty, hostile Aydar!"},{"id":"semetey-1-2013:p1135:b004:l036","ordinal":163825,"en":"After Khan Kökötöy died"},{"id":"semetey-1-2013:p1135:b004:l037","ordinal":163826,"en":"And saw the true world,"},{"id":"semetey-1-2013:p1135:b004:l038","ordinal":163827,"en":"Why did you not send word?"},{"id":"semetey-1-2013:p1135:b004:l039","ordinal":163828,"en":"At the feast you began, Aydar,"},{"id":"semetey-1-2013:p1136:b003:l001","ordinal":163829,"en":"May calamity rise before you, Aydar!"},{"id":"semetey-1-2013:p1136:b003:l002","ordinal":163830,"en":"May the masses dig your pit, Aydar;"},{"id":"semetey-1-2013:p1136:b003:l003","ordinal":163831,"en":"May dogs tear your flesh, Aydar;"},{"id":"semetey-1-2013:p1136:b003:l004","ordinal":163832,"en":"Who would wish to see your face, Aydar!"},{"id":"semetey-1-2013:p1136:b003:l005","ordinal":163833,"en":"May Kalmyks eat your head, Aydar;"},{"id":"semetey-1-2013:p1136:b003:l006","ordinal":163834,"en":"May infidels eat your feast, Aydar!"},{"id":"semetey-1-2013:p1136:b003:l007","ordinal":163835,"en":"Who would listen to your words, Aydar?"},{"id":"semetey-1-2013:p1136:b003:l008","ordinal":163836,"en":"Let a single dark night listen, Aydar!"},{"id":"semetey-1-2013:p1136:b003:l009","ordinal":163837,"en":"When force came, your chance to come—"},{"id":"semetey-1-2013:p1136:b003:l010","ordinal":163838,"en":"Did you not see from the beginning"},{"id":"semetey-1-2013:p1136:b003:l011","ordinal":163839,"en":"Beijing where blood was spilled, Aydar?\""},{"id":"semetey-1-2013:p1136:b003:l012","ordinal":163840,"en":"Bloodthirsty Manas swelled,"}]
