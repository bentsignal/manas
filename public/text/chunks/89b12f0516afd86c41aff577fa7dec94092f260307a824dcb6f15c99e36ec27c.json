[{"id":"semetey-1-2013:p0717:b004:l034","ordinal":131329,"en":"If they beat her, will they leave her carcass?"},{"id":"semetey-1-2013:p0717:b004:l035","ordinal":131330,"en":"Surrounding her, Ylama"},{"id":"semetey-1-2013:p0717:b004:l036","ordinal":131331,"en":"At last seized her."},{"id":"semetey-1-2013:p0717:b004:l037","ordinal":131332,"en":"Your ocean-like elder sister Kardygach"},{"id":"semetey-1-2013:p0717:b004:l038","ordinal":131333,"en":"Had been taken captive."},{"id":"semetey-1-2013:p0717:b004:l039","ordinal":131334,"en":"When Kardygach was captured,"},{"id":"semetey-1-2013:p0718:b003:l001","ordinal":131335,"en":"With beaded cap ornaments and coral stones,"},{"id":"semetey-1-2013:p0718:b003:l002","ordinal":131336,"en":"They summoned the zungtung khan."},{"id":"semetey-1-2013:p0718:b003:l003","ordinal":131337,"en":"Babbling to Ylama,"},{"id":"semetey-1-2013:p0718:b003:l004","ordinal":131338,"en":"That day they performed the marriage rite."},{"id":"semetey-1-2013:p0718:b003:l005","ordinal":131339,"en":"The pig Ylama took Kardygach."},{"id":"semetey-1-2013:p0718:b003:l006","ordinal":131340,"en":"They mounted her on a mule,"},{"id":"semetey-1-2013:p0718:b003:l007","ordinal":131341,"en":"Taking her as spoil toward Beijing."},{"id":"semetey-1-2013:p0718:b003:l008","ordinal":131342,"en":"Five hundred escorted her away,"},{"id":"semetey-1-2013:p0718:b003:l009","ordinal":131343,"en":"Returning with their captive."},{"id":"semetey-1-2013:p0718:b003:l010","ordinal":131344,"en":"Leopard Manas and warrior Bakai,"},{"id":"semetey-1-2013:p0718:b003:l011","ordinal":131345,"en":"Akbaltai's Chubak,"},{"id":"semetey-1-2013:p0718:b003:l012","ordinal":131346,"en":"The seething infidels"},{"id":"semetey-1-2013:p0718:b003:l013","ordinal":131347,"en":"They speared toward the khakan."},{"id":"semetey-1-2013:p0718:b003:l014","ordinal":131348,"en":"In those days, when the Kyrgyz sun rose,"},{"id":"semetey-1-2013:p0718:b003:l015","ordinal":131349,"en":"They brought torment upon the infidels"},{"id":"semetey-1-2013:p0718:b003:l016","ordinal":131350,"en":"And pursued them toward Beijing."},{"id":"semetey-1-2013:p0718:b003:l017","ordinal":131351,"en":"The people of Beijing fled in panic,"},{"id":"semetey-1-2013:p0718:b003:l018","ordinal":131352,"en":"Surging toward Beijing."},{"id":"semetey-1-2013:p0718:b003:l019","ordinal":131353,"en":"They passed Issyk-Kul,"},{"id":"semetey-1-2013:p0718:b003:l020","ordinal":131354,"en":"Crossed Kyzyl-Kyia,"},{"id":"semetey-1-2013:p0718:b003:l021","ordinal":131355,"en":"Surged along Karkyra."},{"id":"semetey-1-2013:p0718:b003:l022","ordinal":131356,"en":"The multitude of infidels fled."},{"id":"semetey-1-2013:p0718:b003:l023","ordinal":131357,"en":"Those damned Chinese,"},{"id":"semetey-1-2013:p0718:b003:l024","ordinal":131358,"en":"Down through Echki-Ölös,"},{"id":"semetey-1-2013:p0718:b003:l025","ordinal":131359,"en":"They speared without measure."},{"id":"semetey-1-2013:p0718:b003:l026","ordinal":131360,"en":"They went down Mangkan,"},{"id":"semetey-1-2013:p0718:b003:l027","ordinal":131361,"en":"Galloped down Kordoi,"},{"id":"semetey-1-2013:p0718:b003:l028","ordinal":131362,"en":"Fighting like dogs,"},{"id":"semetey-1-2013:p0718:b003:l029","ordinal":131363,"en":"Pursuing them like dogs."},{"id":"semetey-1-2013:p0718:b003:l030","ordinal":131364,"en":"Köngüz and Tekes"},{"id":"semetey-1-2013:p0718:b003:l031","ordinal":131365,"en":"They turned upside down."},{"id":"semetey-1-2013:p0718:b003:l032","ordinal":131366,"en":"Üch-Aral at the head of the Ile,"},{"id":"semetey-1-2013:p0718:b003:l033","ordinal":131367,"en":"They wheeled round in pursuit."},{"id":"semetey-1-2013:p0718:b003:l034","ordinal":131368,"en":"To Ögüz-Ashuu and Tai-Ashuu,"},{"id":"semetey-1-2013:p0718:b003:l035","ordinal":131369,"en":"They drove them onward."},{"id":"semetey-1-2013:p0718:b003:l036","ordinal":131370,"en":"At Chara-Tash of Tai-Ashuu,"},{"id":"semetey-1-2013:p0718:b003:l037","ordinal":131371,"en":"With narrow ground on either side,"},{"id":"semetey-1-2013:p0718:b003:l038","ordinal":131372,"en":"We were hemmed in together;"},{"id":"semetey-1-2013:p0718:b003:l039","ordinal":131373,"en":"We fought a great mêlée."},{"id":"semetey-1-2013:p0718:b004:l001","ordinal":131374,"en":"Leopard Manas, the generous lion,"},{"id":"semetey-1-2013:p0718:b004:l002","ordinal":131375,"en":"The precious warrior gone to the next world,"},{"id":"semetey-1-2013:p0718:b004:l003","ordinal":131376,"en":"The young mare's foal,"},{"id":"semetey-1-2013:p0718:b004:l004","ordinal":131377,"en":"Against the multitude of Chinese infidels,"},{"id":"semetey-1-2013:p0718:b004:l005","ordinal":131378,"en":"That lion had shown his valor."},{"id":"semetey-1-2013:p0718:b004:l006","ordinal":131379,"en":"Among those Chinese,"},{"id":"semetey-1-2013:p0718:b004:l007","ordinal":131380,"en":"The mighty Kongurbai,"},{"id":"semetey-1-2013:p0718:b004:l008","ordinal":131381,"en":"Tikenalp and Shypshaidar,"},{"id":"semetey-1-2013:p0718:b004:l009","ordinal":131382,"en":"Boronchu and warrior Joloi,"},{"id":"semetey-1-2013:p0718:b004:l010","ordinal":131383,"en":"Warrior Börüköz and Ezkara—"},{"id":"semetey-1-2013:p0718:b004:l011","ordinal":131384,"en":"All their giants were there."},{"id":"semetey-1-2013:p0718:b004:l012","ordinal":131385,"en":"They faced us, fighting without cease,"},{"id":"semetey-1-2013:p0718:b004:l013","ordinal":131386,"en":"Bringing torment upon one another,"},{"id":"semetey-1-2013:p0718:b004:l014","ordinal":131387,"en":"Drenched in bloody blood,"},{"id":"semetey-1-2013:p0718:b004:l015","ordinal":131388,"en":"Fighting without fleeing,"},{"id":"semetey-1-2013:p0718:b004:l016","ordinal":131389,"en":"Holding their spears straight to thrust,"},{"id":"semetey-1-2013:p0718:b004:l017","ordinal":131390,"en":"Firing guns and drawing bows,"},{"id":"semetey-1-2013:p0718:b004:l018","ordinal":131391,"en":"Fighting to exhaustion,"},{"id":"semetey-1-2013:p0718:b004:l019","ordinal":131392,"en":"The giants sparing not their lives,"},{"id":"semetey-1-2013:p0718:b004:l020","ordinal":131393,"en":"Afflicting one another."},{"id":"semetey-1-2013:p0718:b004:l021","ordinal":131394,"en":"Infidel and Muslim"},{"id":"semetey-1-2013:p0718:b004:l022","ordinal":131395,"en":"Matched their valor against each other."},{"id":"semetey-1-2013:p0718:b004:l023","ordinal":131396,"en":"They faced each other without retreat,"},{"id":"semetey-1-2013:p0718:b004:l024","ordinal":131397,"en":"Fought without fleeing."},{"id":"semetey-1-2013:p0718:b004:l025","ordinal":131398,"en":"Warrior Manas, gone to the next world,"},{"id":"semetey-1-2013:p0718:b004:l026","ordinal":131399,"en":"Was a lion of surpassing fortune."},{"id":"semetey-1-2013:p0718:b004:l027","ordinal":131400,"en":"Into this world, the Almighty"},{"id":"semetey-1-2013:p0718:b004:l028","ordinal":131401,"en":"Had created such a warrior only once."},{"id":"semetey-1-2013:p0718:b004:l029","ordinal":131402,"en":"His fortune was complete."},{"id":"semetey-1-2013:p0718:b004:l030","ordinal":131403,"en":"If you looked within him,"},{"id":"semetey-1-2013:p0718:b004:l031","ordinal":131404,"en":"He was broader than the face of the earth."},{"id":"semetey-1-2013:p0718:b004:l032","ordinal":131405,"en":"When they came to face him,"},{"id":"semetey-1-2013:p0718:b004:l033","ordinal":131406,"en":"Valiant Lord Manas—"},{"id":"semetey-1-2013:p0718:b004:l034","ordinal":131407,"en":"No mortal could trouble him."},{"id":"semetey-1-2013:p0718:b004:l035","ordinal":131408,"en":"Of the mortals dwelling on earth,"},{"id":"semetey-1-2013:p0718:b004:l036","ordinal":131409,"en":"None remained to turn a lasso pole against him."},{"id":"semetey-1-2013:p0718:b004:l037","ordinal":131410,"en":"The Chinese swarmed and crowded in;"},{"id":"semetey-1-2013:p0718:b004:l038","ordinal":131411,"en":"A great slaughter ensued."},{"id":"semetey-1-2013:p0718:b004:l039","ordinal":131412,"en":"They drew bows, making a rain of arrows,"},{"id":"semetey-1-2013:p0719:b003:l001","ordinal":131413,"en":"Firing shot like hail,"},{"id":"semetey-1-2013:p0719:b003:l002","ordinal":131414,"en":"Spearheads clashing,"},{"id":"semetey-1-2013:p0719:b003:l003","ordinal":131415,"en":"Human heads colliding."},{"id":"semetey-1-2013:p0719:b003:l004","ordinal":131416,"en":"They surged like ants,"},{"id":"semetey-1-2013:p0719:b003:l005","ordinal":131417,"en":"Swarmed and teemed like worms."},{"id":"semetey-1-2013:p0719:b003:l006","ordinal":131418,"en":"The sky was clear, the earth obscured;"},{"id":"semetey-1-2013:p0719:b003:l007","ordinal":131419,"en":"Soil engulfed us, dust flew."},{"id":"semetey-1-2013:p0719:b003:l008","ordinal":131420,"en":"For nine days we fought together."},{"id":"semetey-1-2013:p0719:b003:l009","ordinal":131421,"en":"Our elder Bakai held the banner;"},{"id":"semetey-1-2013:p0719:b003:l010","ordinal":131422,"en":"All of us were scattered and torn."},{"id":"semetey-1-2013:p0719:b003:l011","ordinal":131423,"en":"In dust that hid the ground,"},{"id":"semetey-1-2013:p0719:b003:l012","ordinal":131424,"en":"When full battle raged,"},{"id":"semetey-1-2013:p0719:b003:l013","ordinal":131425,"en":"We struggled for our lives."},{"id":"semetey-1-2013:p0719:b003:l014","ordinal":131426,"en":"When all the Chinese drew their bows,"},{"id":"semetey-1-2013:p0719:b003:l015","ordinal":131427,"en":"The arrows shrieked;"},{"id":"semetey-1-2013:p0719:b003:l016","ordinal":131428,"en":"Whatever they struck burst apart."},{"id":"semetey-1-2013:p0719:b003:l017","ordinal":131429,"en":"Then those whose hour had come died."},{"id":"semetey-1-2013:p0719:b003:l018","ordinal":131430,"en":"Where the arrows struck, flesh burst apart;"},{"id":"semetey-1-2013:p0719:b003:l019","ordinal":131431,"en":"Blood poured out in streams."},{"id":"semetey-1-2013:p0719:b003:l020","ordinal":131432,"en":"Those whose hour had come died,"},{"id":"semetey-1-2013:p0719:b003:l021","ordinal":131433,"en":"And saw the face of the next world."},{"id":"semetey-1-2013:p0719:b003:l022","ordinal":131434,"en":"When that battle took place,"},{"id":"semetey-1-2013:p0719:b003:l023","ordinal":131435,"en":"White-bearded elders died."},{"id":"semetey-1-2013:p0719:b003:l024","ordinal":131436,"en":"Among Chinese and Burut,"},{"id":"semetey-1-2013:p0719:b003:l025","ordinal":131437,"en":"Many more people died."},{"id":"semetey-1-2013:p0719:b003:l026","ordinal":131438,"en":"They fought in bitter anguish,"},{"id":"semetey-1-2013:p0719:b003:l027","ordinal":131439,"en":"Struggled to save their lives,"},{"id":"semetey-1-2013:p0719:b003:l028","ordinal":131440,"en":"Faced each other, staring hard,"},{"id":"semetey-1-2013:p0719:b003:l029","ordinal":131441,"en":"Thrust their spears and shouted,"},{"id":"semetey-1-2013:p0719:b003:l030","ordinal":131442,"en":"Felled those who faced them."},{"id":"semetey-1-2013:p0719:b003:l031","ordinal":131443,"en":"Without rest by day,"},{"id":"semetey-1-2013:p0719:b003:l032","ordinal":131444,"en":"Without sleep by night,"},{"id":"semetey-1-2013:p0719:b003:l033","ordinal":131445,"en":"They fought with all their strength."},{"id":"semetey-1-2013:p0719:b003:l034","ordinal":131446,"en":"Your elder Khan Bakai among them,"},{"id":"semetey-1-2013:p0719:b003:l035","ordinal":131447,"en":"They wrought havoc."},{"id":"semetey-1-2013:p0719:b003:l036","ordinal":131448,"en":"There was Khan Manas, blessed by Khizir;"},{"id":"semetey-1-2013:p0719:b003:l037","ordinal":131449,"en":"All forty companions were there."},{"id":"semetey-1-2013:p0719:b003:l038","ordinal":131450,"en":"Shrill battle cries, fierce rallying shouts—"},{"id":"semetey-1-2013:p0719:b003:l039","ordinal":131451,"en":"Whom a lion's teeth could not pierce,"},{"id":"semetey-1-2013:p0719:b004:l001","ordinal":131452,"en":"Whom the world could not overpower,"},{"id":"semetey-1-2013:p0719:b004:l002","ordinal":131453,"en":"Akbalta's Chubak was there."},{"id":"semetey-1-2013:p0719:b004:l003","ordinal":131454,"en":"Light on a horse, suited to a yearling,"},{"id":"semetey-1-2013:p0719:b004:l004","ordinal":131455,"en":"Sleepless, watchful on the road,"},{"id":"semetey-1-2013:p0719:b004:l005","ordinal":131456,"en":"Ulakkan's son Syrgak was there."},{"id":"semetey-1-2013:p0719:b004:l006","ordinal":131457,"en":"Greater than them all,"},{"id":"semetey-1-2013:p0719:b004:l007","ordinal":131458,"en":"Fortunate Manas, the bloodthirsty lion,"},{"id":"semetey-1-2013:p0719:b004:l008","ordinal":131459,"en":"Untiringly upon the black Chinese"},{"id":"semetey-1-2013:p0719:b004:l009","ordinal":131460,"en":"Wrought destruction there."},{"id":"semetey-1-2013:p0719:b004:l010","ordinal":131461,"en":"They stood without tiring,"},{"id":"semetey-1-2013:p0719:b004:l011","ordinal":131462,"en":"Fought, shattering one another."},{"id":"semetey-1-2013:p0719:b004:l012","ordinal":131463,"en":"They stood facing each other,"},{"id":"semetey-1-2013:p0719:b004:l013","ordinal":131464,"en":"Girded themselves and fought,"},{"id":"semetey-1-2013:p0719:b004:l014","ordinal":131465,"en":"Came out to single combat."},{"id":"semetey-1-2013:p0719:b004:l015","ordinal":131466,"en":"If they had the strength, each other"},{"id":"semetey-1-2013:p0719:b004:l016","ordinal":131467,"en":"They thrust beneath the earth."},{"id":"semetey-1-2013:p0719:b004:l017","ordinal":131468,"en":"As they faced each other in battle,"},{"id":"semetey-1-2013:p0719:b004:l018","ordinal":131469,"en":"Bringing torment upon one another,"},{"id":"semetey-1-2013:p0719:b004:l019","ordinal":131470,"en":"There was the multitude of Chinese."},{"id":"semetey-1-2013:p0719:b004:l020","ordinal":131471,"en":"Of the Manchu Chinese lineage,"},{"id":"semetey-1-2013:p0719:b004:l021","ordinal":131472,"en":"There was the giant Great Döngö."},{"id":"semetey-1-2013:p0719:b004:l022","ordinal":131473,"en":"That Döngö himself"},{"id":"semetey-1-2013:p0719:b004:l023","ordinal":131474,"en":"They mounted on a noble mule."},{"id":"semetey-1-2013:p0719:b004:l024","ordinal":131475,"en":"All iron, with lark-eye mesh,"},{"id":"semetey-1-2013:p0719:b004:l025","ordinal":131476,"en":"They clad him in blue-steel armor."},{"id":"semetey-1-2013:p0719:b004:l026","ordinal":131477,"en":"In that infidel's hand"},{"id":"semetey-1-2013:p0719:b004:l027","ordinal":131478,"en":"Was a painted spear twelve fathoms long."},{"id":"semetey-1-2013:p0719:b004:l028","ordinal":131479,"en":"No mortal could endure his wrath."},{"id":"semetey-1-2013:p0719:b004:l029","ordinal":131480,"en":"He emerged from a ravine."},{"id":"semetey-1-2013:p0719:b004:l030","ordinal":131481,"en":"The bloodthirsty one rode to war."},{"id":"semetey-1-2013:p0719:b004:l031","ordinal":131482,"en":"If you ask about Döngö,"},{"id":"semetey-1-2013:p0719:b004:l032","ordinal":131483,"en":"Of Beijing's khakan khan"},{"id":"semetey-1-2013:p0719:b004:l033","ordinal":131484,"en":"He was entered in the register."},{"id":"semetey-1-2013:p0719:b004:l034","ordinal":131485,"en":"To the forty Chinese tribes, the many people,"},{"id":"semetey-1-2013:p0719:b004:l035","ordinal":131486,"en":"That Döngö who had come—"},{"id":"semetey-1-2013:p0719:b004:l036","ordinal":131487,"en":"His worth was known."},{"id":"semetey-1-2013:p0719:b004:l037","ordinal":131488,"en":"His wrath made blood flow;"},{"id":"semetey-1-2013:p0719:b004:l038","ordinal":131489,"en":"His might made souls depart."},{"id":"semetey-1-2013:p0719:b004:l039","ordinal":131490,"en":"For seven years he walked without rest,"},{"id":"semetey-1-2013:p0720:b003:l001","ordinal":131491,"en":"On this side of Kap-Too,"},{"id":"semetey-1-2013:p0720:b003:l002","ordinal":131492,"en":"He had killed seventy giants."},{"id":"semetey-1-2013:p0720:b003:l003","ordinal":131493,"en":"For six years he walked on foot,"},{"id":"semetey-1-2013:p0720:b003:l004","ordinal":131494,"en":"He wetted and greased his spear,"},{"id":"semetey-1-2013:p0720:b003:l005","ordinal":131495,"en":"Have you heard of them:"},{"id":"semetey-1-2013:p0720:b003:l006","ordinal":131496,"en":"Iron-eared giant Kutan,"},{"id":"semetey-1-2013:p0720:b003:l007","ordinal":131497,"en":"Iron-naveled giant Kiten,"},{"id":"semetey-1-2013:p0720:b003:l008","ordinal":131498,"en":"Iron-browed giant Mangush,"},{"id":"semetey-1-2013:p0720:b003:l009","ordinal":131499,"en":"Giant Kaman riding Karager,"},{"id":"semetey-1-2013:p0720:b003:l010","ordinal":131500,"en":"Giant Sazan riding Saryker?"},{"id":"semetey-1-2013:p0720:b003:l011","ordinal":131501,"en":"Against these five, Great Döngö"},{"id":"semetey-1-2013:p0720:b003:l012","ordinal":131502,"en":"Faced them and thrust his spear,"},{"id":"semetey-1-2013:p0720:b003:l013","ordinal":131503,"en":"Fighting without rest for seven days."},{"id":"semetey-1-2013:p0720:b003:l014","ordinal":131504,"en":"Such was the valor he displayed."},{"id":"semetey-1-2013:p0720:b003:l015","ordinal":131505,"en":"On this side of Kap-Too,"},{"id":"semetey-1-2013:p0720:b003:l016","ordinal":131506,"en":"Of a mountain called Suuk-Tör,"},{"id":"semetey-1-2013:p0720:b003:l017","ordinal":131507,"en":"At its farthest end,"},{"id":"semetey-1-2013:p0720:b003:l018","ordinal":131508,"en":"Eighty giants, wrestlers of noble stock,"},{"id":"semetey-1-2013:p0720:b003:l019","ordinal":131509,"en":"He slaughtered them all."},{"id":"semetey-1-2013:p0720:b003:l020","ordinal":131510,"en":"Ah, that accursed wrestler, Great Döngö,"},{"id":"semetey-1-2013:p0720:b003:l021","ordinal":131511,"en":"Displayed boundless valor."},{"id":"semetey-1-2013:p0720:b003:l022","ordinal":131512,"en":"Five of those eighty,"},{"id":"semetey-1-2013:p0720:b003:l023","ordinal":131513,"en":"To the khan of Khakanchyn,"},{"id":"semetey-1-2013:p0720:b003:l024","ordinal":131514,"en":"He brought alive and bound."},{"id":"semetey-1-2013:p0720:b003:l025","ordinal":131515,"en":"To Beijing's Kary Khan,"},{"id":"semetey-1-2013:p0720:b003:l026","ordinal":131516,"en":"He presented them as tribute."},{"id":"semetey-1-2013:p0720:b003:l027","ordinal":131517,"en":"Then his khan took a liking to Döngö."},{"id":"semetey-1-2013:p0720:b003:l028","ordinal":131518,"en":"The five he brought bound"},{"id":"semetey-1-2013:p0720:b003:l029","ordinal":131519,"en":"He had maintained by the treasury."},{"id":"semetey-1-2013:p0720:b003:l030","ordinal":131520,"en":"Of the forty Chinese tribes,"},{"id":"semetey-1-2013:p0720:b003:l031","ordinal":131521,"en":"Of that damned Beijing,"},{"id":"semetey-1-2013:p0720:b003:l032","ordinal":131522,"en":"Which deeds shall I tell?"},{"id":"semetey-1-2013:p0720:b003:l033","ordinal":131523,"en":"Devising plans no man could conceive,"},{"id":"semetey-1-2013:p0720:b003:l034","ordinal":131524,"en":"They feasted eighty-four days."},{"id":"semetey-1-2013:p0720:b003:l035","ordinal":131525,"en":"The Chinese gathered at the feast,"},{"id":"semetey-1-2013:p0720:b003:l036","ordinal":131526,"en":"Had their booming instruments struck,"},{"id":"semetey-1-2013:p0720:b003:l037","ordinal":131527,"en":"Drums deafening the ears,"},{"id":"semetey-1-2013:p0720:b003:l038","ordinal":131528,"en":"Had their shawms sound shrilly,"},{"id":"semetey-1-2013:p0720:b003:l039","ordinal":131529,"en":"Had their bells rung."},{"id":"semetey-1-2013:p0720:b004:l001","ordinal":131530,"en":"A great idol made of bronze"},{"id":"semetey-1-2013:p0720:b004:l002","ordinal":131531,"en":"They had brought, tied up and suspended."},{"id":"semetey-1-2013:p0720:b004:l003","ordinal":131532,"en":"They made their people stream beneath it,"},{"id":"semetey-1-2013:p0720:b004:l004","ordinal":131533,"en":"Creating such commotion."},{"id":"semetey-1-2013:p0720:b004:l005","ordinal":131534,"en":"At its foot they inscribed Chinese writing,"},{"id":"semetey-1-2013:p0720:b004:l006","ordinal":131535,"en":"And named him Khan Döngö."},{"id":"semetey-1-2013:p0720:b004:l007","ordinal":131536,"en":"They placed a golden crown upon him."},{"id":"semetey-1-2013:p0720:b004:l008","ordinal":131537,"en":"That Döngö alone"},{"id":"semetey-1-2013:p0720:b004:l009","ordinal":131538,"en":"They seated on a golden throne."},{"id":"semetey-1-2013:p0720:b004:l010","ordinal":131539,"en":"They had their seers examine him,"},{"id":"semetey-1-2013:p0720:b004:l011","ordinal":131540,"en":"Their singers sing of him,"},{"id":"semetey-1-2013:p0720:b004:l012","ordinal":131541,"en":"Made the people accept his words,"},{"id":"semetey-1-2013:p0720:b004:l013","ordinal":131542,"en":"Of Beijing's forty Chinese tribes,"},{"id":"semetey-1-2013:p0720:b004:l014","ordinal":131543,"en":"They made him lord over half."},{"id":"semetey-1-2013:p0720:b004:l015","ordinal":131544,"en":"Making his sleeveless jacket bulge,"},{"id":"semetey-1-2013:p0720:b004:l016","ordinal":131545,"en":"That Döngö himself"},{"id":"semetey-1-2013:p0720:b004:l017","ordinal":131546,"en":"They clothed in a mighty man's robe."},{"id":"semetey-1-2013:p0720:b004:l018","ordinal":131547,"en":"His armored arm-guards spreading wide,"},{"id":"semetey-1-2013:p0720:b004:l019","ordinal":131548,"en":"They clothed him in his khan's robe."},{"id":"semetey-1-2013:p0720:b004:l020","ordinal":131549,"en":"They tended him in a cool place,"},{"id":"semetey-1-2013:p0720:b004:l021","ordinal":131550,"en":"Taking a liking to Döngö."},{"id":"semetey-1-2013:p0720:b004:l022","ordinal":131551,"en":"Their seers foresaw:"},{"id":"semetey-1-2013:p0720:b004:l023","ordinal":131552,"en":"‘That raging madman Manas of the Burut,"},{"id":"semetey-1-2013:p0720:b004:l025","ordinal":131553,"en":"Döngö will capture him for us,’"},{"id":"semetey-1-2013:p0720:b004:l026","ordinal":131554,"en":"And cherished that hope."},{"id":"semetey-1-2013:p0720:b004:l027","ordinal":131555,"en":"When they sent Döngö this way,"},{"id":"semetey-1-2013:p0720:b004:l028","ordinal":131556,"en":"Kary Khan and Esen Khan,"},{"id":"semetey-1-2013:p0720:b004:l029","ordinal":131557,"en":"Ai-Jangjung and Kün-Jangjung,"},{"id":"semetey-1-2013:p0720:b004:l030","ordinal":131558,"en":"And Azyz Khan—five khans they were."},{"id":"semetey-1-2013:p0720:b004:l031","ordinal":131559,"en":"Of Khakanchyn Beijing,"},{"id":"semetey-1-2013:p0720:b004:l032","ordinal":131560,"en":"He was its great ruler."},{"id":"semetey-1-2013:p0720:b004:l033","ordinal":131561,"en":"‘This Manas, khan of the Kyrgyz,"},{"id":"semetey-1-2013:p0720:b004:l034","ordinal":131562,"en":"Great Döngö will capture him for us,’"},{"id":"semetey-1-2013:p0720:b004:l035","ordinal":131563,"en":"They held that great hope."},{"id":"semetey-1-2013:p0720:b004:l036","ordinal":131564,"en":"Ask not about Döngö!"},{"id":"semetey-1-2013:p0720:b004:l037","ordinal":131565,"en":"Receiving word from his khan,"},{"id":"semetey-1-2013:p0720:b004:l038","ordinal":131566,"en":"His courage overflowed:"},{"id":"semetey-1-2013:p0720:b004:l039","ordinal":131567,"en":"‘To the Burut's mad Manas,"},{"id":"semetey-1-2013:p0721:b003:l001","ordinal":131568,"en":"I shall bring terrible trouble,’ he said."},{"id":"semetey-1-2013:p0721:b003:l002","ordinal":131569,"en":"That self-important Manas—"},{"id":"semetey-1-2013:p0721:b003:l003","ordinal":131570,"en":"‘I shall face him and capture him."},{"id":"semetey-1-2013:p0721:b003:l004","ordinal":131571,"en":"For the daughters of Chynmachyn,"},{"id":"semetey-1-2013:p0721:b003:l005","ordinal":131572,"en":"I shall capture him and use him as a stallion.’"},{"id":"semetey-1-2013:p0721:b003:l006","ordinal":131573,"en":"Great Döngö had made firm preparations;"},{"id":"semetey-1-2013:p0721:b003:l007","ordinal":131574,"en":"Now he had arrived."},{"id":"semetey-1-2013:p0721:b003:l008","ordinal":131575,"en":"If you ask about Döngö,"},{"id":"semetey-1-2013:p0721:b003:l009","ordinal":131576,"en":"He was as big as a mountain,"},{"id":"semetey-1-2013:p0721:b003:l010","ordinal":131577,"en":"Seeming ready to devour any challenger."},{"id":"semetey-1-2013:p0721:b003:l011","ordinal":131578,"en":"His appearance was unlike a human's."},{"id":"semetey-1-2013:p0721:b003:l012","ordinal":131579,"en":"His attacks made blood flow;"},{"id":"semetey-1-2013:p0721:b003:l013","ordinal":131580,"en":"His might made souls depart."},{"id":"semetey-1-2013:p0721:b003:l014","ordinal":131581,"en":"His mule trampled the earth."},{"id":"semetey-1-2013:p0721:b003:l015","ordinal":131582,"en":"Khan Kongurbai and Joloi"},{"id":"semetey-1-2013:p0721:b003:l016","ordinal":131583,"en":"He scolded as though they were his wives:"},{"id":"semetey-1-2013:p0721:b003:l017","ordinal":131584,"en":"‘To this day, the Burut Manas"}]
