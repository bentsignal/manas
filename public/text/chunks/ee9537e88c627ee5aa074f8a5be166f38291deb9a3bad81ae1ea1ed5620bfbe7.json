[{"id":"semetey-1-2013:p1138:b004:l024","ordinal":163073,"en":"And made to the measure of all forty."},{"id":"semetey-1-2013:p1138:b004:l025","ordinal":163074,"en":"If there were an enemy before them,"},{"id":"semetey-1-2013:p1138:b004:l026","ordinal":163075,"en":"If he struck hard,"},{"id":"semetey-1-2013:p1138:b004:l027","ordinal":163076,"en":"Untimely death might come;"},{"id":"semetey-1-2013:p1138:b004:l028","ordinal":163077,"en":"Leaving them unprepared would be futile."},{"id":"semetey-1-2013:p1138:b004:l029","ordinal":163078,"en":"The forty armors she made for your forty"},{"id":"semetey-1-2013:p1138:b004:l030","ordinal":163079,"en":"Revealed their costliness."},{"id":"semetey-1-2013:p1138:b004:l031","ordinal":163080,"en":"She brought forty armors from the treasury"},{"id":"semetey-1-2013:p1138:b004:l032","ordinal":163081,"en":"And dressed the forty companions,"},{"id":"semetey-1-2013:p1138:b004:l033","ordinal":163082,"en":"Your formidable sister-in-law Kanykey"},{"id":"semetey-1-2013:p1138:b004:l034","ordinal":163083,"en":"Making their costliness known."},{"id":"semetey-1-2013:p1138:b004:l035","ordinal":163084,"en":"She had nine clasps apiece"},{"id":"semetey-1-2013:p1138:b004:l036","ordinal":163085,"en":"Fastened across the chest;"},{"id":"semetey-1-2013:p1138:b004:l037","ordinal":163086,"en":"Your mighty sister-in-law Kanykey"},{"id":"semetey-1-2013:p1138:b004:l038","ordinal":163087,"en":"Then dressed the forty companions"},{"id":"semetey-1-2013:p1138:b004:l039","ordinal":163088,"en":"In armor no arrow could pierce."},{"id":"semetey-1-2013:p1139:b003:l001","ordinal":163089,"en":"Helmets of blue iron—"},{"id":"semetey-1-2013:p1139:b003:l002","ordinal":163090,"en":"So the heroic youths would not stand idle"},{"id":"semetey-1-2013:p1139:b003:l003","ordinal":163091,"en":"If an enemy came from a known place,"},{"id":"semetey-1-2013:p1139:b003:l004","ordinal":163092,"en":"But would go to face him;"},{"id":"semetey-1-2013:p1139:b003:l005","ordinal":163093,"en":"If they stood brow to brow,"},{"id":"semetey-1-2013:p1139:b003:l006","ordinal":163094,"en":"Struck with battle-axes,"},{"id":"semetey-1-2013:p1139:b003:l007","ordinal":163095,"en":"And fought with cries,"},{"id":"semetey-1-2013:p1139:b003:l008","ordinal":163096,"en":"A battle-axe might strike them"},{"id":"semetey-1-2013:p1139:b003:l009","ordinal":163097,"en":"And death come needlessly."},{"id":"semetey-1-2013:p1139:b003:l010","ordinal":163098,"en":"The forty helmets she made for the forty"},{"id":"semetey-1-2013:p1139:b003:l011","ordinal":163099,"en":"Made their strength known;"},{"id":"semetey-1-2013:p1139:b003:l012","ordinal":163100,"en":"She overturned them onto their heads."},{"id":"semetey-1-2013:p1139:b003:l013","ordinal":163101,"en":"The kandagay she made for the forty"},{"id":"semetey-1-2013:p1139:b003:l014","ordinal":163102,"en":"Was of Ashagan-Mashagan hide,"},{"id":"semetey-1-2013:p1139:b003:l015","ordinal":163103,"en":"Fashioned by your cunning sister-in-law."},{"id":"semetey-1-2013:p1139:b003:l016","ordinal":163104,"en":"She had it steeped in dressing,"},{"id":"semetey-1-2013:p1139:b003:l017","ordinal":163105,"en":"And saturated with measured dye,"},{"id":"semetey-1-2013:p1139:b003:l018","ordinal":163106,"en":"Immersed in many preparations,"},{"id":"semetey-1-2013:p1139:b003:l019","ordinal":163107,"en":"And laid in the shade."},{"id":"semetey-1-2013:p1139:b003:l020","ordinal":163108,"en":"She gave a horse for each month,"},{"id":"semetey-1-2013:p1139:b003:l021","ordinal":163109,"en":"And gold and jewels by the measure each day."},{"id":"semetey-1-2013:p1139:b003:l022","ordinal":163110,"en":"From men who came without peer,"},{"id":"semetey-1-2013:p1139:b003:l023","ordinal":163111,"en":"Marksmen of evident perfect skill"},{"id":"semetey-1-2013:p1139:b003:l024","ordinal":163112,"en":"Who could shoot an eye,"},{"id":"semetey-1-2013:p1139:b003:l025","ordinal":163113,"en":"She had provisions loaded upon bil"},{"id":"semetey-1-2013:p1139:b003:l026","ordinal":163114,"en":"And sent them to survey the earth."},{"id":"semetey-1-2013:p1139:b003:l027","ordinal":163115,"en":"Hearing from many people"},{"id":"semetey-1-2013:p1139:b003:l028","ordinal":163116,"en":"That the hide of the ibex of Too-Kuygak"},{"id":"semetey-1-2013:p1139:b003:l029","ordinal":163117,"en":"Was thick,"},{"id":"semetey-1-2013:p1139:b003:l030","ordinal":163118,"en":"She placed the sewing of the kandagay"},{"id":"semetey-1-2013:p1139:b003:l031","ordinal":163119,"en":"Under Aruuke's direction;"},{"id":"semetey-1-2013:p1139:b003:l032","ordinal":163120,"en":"Exactly ninety-five champions"},{"id":"semetey-1-2013:p1139:b003:l033","ordinal":163121,"en":"Worked the hide for ninety days."},{"id":"semetey-1-2013:p1139:b003:l034","ordinal":163122,"en":"She had its inside lined with silk"},{"id":"semetey-1-2013:p1139:b003:l035","ordinal":163123,"en":"And gathered skilled women and girls"},{"id":"semetey-1-2013:p1139:b003:l036","ordinal":163124,"en":"To bite and soften it."},{"id":"semetey-1-2013:p1139:b003:l037","ordinal":163125,"en":"She had its unfit parts cut away;"},{"id":"semetey-1-2013:p1139:b003:l038","ordinal":163126,"en":"So that bullets would glance aside,"},{"id":"semetey-1-2013:p1139:b003:l039","ordinal":163127,"en":"She had plate upon plate of steel"},{"id":"semetey-1-2013:p1139:b005:l001","ordinal":163128,"en":"Poured into its middle."},{"id":"semetey-1-2013:p1139:b005:l002","ordinal":163129,"en":"The kandagay was fashioned"},{"id":"semetey-1-2013:p1139:b005:l003","ordinal":163130,"en":"To fit the forty companions exactly."},{"id":"semetey-1-2013:p1139:b005:l004","ordinal":163131,"en":"It satisfied the heart when seen;"},{"id":"semetey-1-2013:p1139:b005:l005","ordinal":163132,"en":"Whole beaver skins"},{"id":"semetey-1-2013:p1139:b005:l006","ordinal":163133,"en":"She split open,"},{"id":"semetey-1-2013:p1139:b005:l007","ordinal":163134,"en":"And had a full span"},{"id":"semetey-1-2013:p1139:b005:l008","ordinal":163135,"en":"Set at the ends of the sleeves."},{"id":"semetey-1-2013:p1139:b005:l009","ordinal":163136,"en":"At the sleeve ends,"},{"id":"semetey-1-2013:p1139:b005:l010","ordinal":163137,"en":"The fearsome beaver trim"},{"id":"semetey-1-2013:p1139:b005:l011","ordinal":163138,"en":"At the bend of the knee,"},{"id":"semetey-1-2013:p1139:b005:l012","ordinal":163139,"en":"So it would never slip,"},{"id":"semetey-1-2013:p1139:b005:l013","ordinal":163140,"en":"Was embroidered with pure gold."},{"id":"semetey-1-2013:p1139:b005:l014","ordinal":163141,"en":"Let whoever jousts stagger;"},{"id":"semetey-1-2013:p1139:b005:l015","ordinal":163142,"en":"Infidel and Muslim alike"},{"id":"semetey-1-2013:p1139:b005:l016","ordinal":163143,"en":"Would know it was Kökötöy's feast,"},{"id":"semetey-1-2013:p1139:b005:l017","ordinal":163144,"en":"And whoever saw it would marvel."},{"id":"semetey-1-2013:p1139:b005:l018","ordinal":163145,"en":"It was named kandagay;"},{"id":"semetey-1-2013:p1139:b005:l019","ordinal":163146,"en":"Come, boys, put it on openly"},{"id":"semetey-1-2013:p1139:b005:l020","ordinal":163147,"en":"And know the gray-wolf courage"},{"id":"semetey-1-2013:p1139:b005:l021","ordinal":163148,"en":"Of your unfortunate sister-in-law."},{"id":"semetey-1-2013:p1139:b005:l022","ordinal":163149,"en":"The matter is hard as I tell it;"},{"id":"semetey-1-2013:p1139:b005:l023","ordinal":163150,"en":"I shall give another article."},{"id":"semetey-1-2013:p1139:b005:l024","ordinal":163151,"en":"Come, boys, put it on."},{"id":"semetey-1-2013:p1139:b005:l025","ordinal":163152,"en":"If you ask its origin,"},{"id":"semetey-1-2013:p1139:b005:l026","ordinal":163153,"en":"It is costly leather."},{"id":"semetey-1-2013:p1139:b005:l027","ordinal":163154,"en":"I thought my forty falcons"},{"id":"semetey-1-2013:p1139:b005:l028","ordinal":163155,"en":"Would recognize this labor;"},{"id":"semetey-1-2013:p1139:b005:l029","ordinal":163156,"en":"I knew of this matter long ago."},{"id":"semetey-1-2013:p1139:b005:l030","ordinal":163157,"en":"At Kökötöy's feast,"},{"id":"semetey-1-2013:p1139:b005:l031","ordinal":163158,"en":"Before the great gathering,"},{"id":"semetey-1-2013:p1139:b005:l032","ordinal":163159,"en":"I thought you would wear"},{"id":"semetey-1-2013:p1139:b005:l033","ordinal":163160,"en":"The ceremonial boots."},{"id":"semetey-1-2013:p1139:b005:l034","ordinal":163161,"en":"Passing them from master to master,"},{"id":"semetey-1-2013:p1139:b005:l035","ordinal":163162,"en":"Having experts assess them,"},{"id":"semetey-1-2013:p1139:b005:l036","ordinal":163163,"en":"For the price of one boot"},{"id":"semetey-1-2013:p1139:b005:l037","ordinal":163164,"en":"I had given one horse."},{"id":"semetey-1-2013:p1139:b005:l038","ordinal":163165,"en":"For all forty I gave forty horses;"},{"id":"semetey-1-2013:p1139:b005:l039","ordinal":163166,"en":"Every bootmaker gathered,"},{"id":"semetey-1-2013:p1140:b003:l001","ordinal":163167,"en":"And built each upper separately."},{"id":"semetey-1-2013:p1140:b003:l002","ordinal":163168,"en":"They satisfied whoever saw them;"},{"id":"semetey-1-2013:p1140:b003:l003","ordinal":163169,"en":"They fitted yellow brass"},{"id":"semetey-1-2013:p1140:b003:l004","ordinal":163170,"en":"As heels upon their soles."},{"id":"semetey-1-2013:p1140:b003:l005","ordinal":163171,"en":"When you go among the multitude, wear them;"},{"id":"semetey-1-2013:p1140:b003:l006","ordinal":163172,"en":"Know that your mother is noble,"},{"id":"semetey-1-2013:p1140:b003:l007","ordinal":163173,"en":"And recognize this labor of mine."},{"id":"semetey-1-2013:p1140:b003:l008","ordinal":163174,"en":"Your accomplished sister-in-law Kanykey,"},{"id":"semetey-1-2013:p1140:b003:l009","ordinal":163175,"en":"Displaying her mastery,"},{"id":"semetey-1-2013:p1140:b003:l010","ordinal":163176,"en":"Dressed the executioner-like companions"},{"id":"semetey-1-2013:p1140:b003:l011","ordinal":163177,"en":"In coats for the swift."},{"id":"semetey-1-2013:p1140:b003:l012","ordinal":163178,"en":"The forty companions' forty racehorses—"},{"id":"semetey-1-2013:p1140:b003:l013","ordinal":163179,"en":"Your precious sister-in-law Kanykey"},{"id":"semetey-1-2013:p1140:b003:l014","ordinal":163180,"en":"Had tethered them in a row"},{"id":"semetey-1-2013:p1140:b003:l015","ordinal":163181,"en":"In your magnanimous lord's stable,"},{"id":"semetey-1-2013:p1140:b003:l016","ordinal":163182,"en":"With Akkula at their head."},{"id":"semetey-1-2013:p1140:b003:l017","ordinal":163183,"en":"She fed them selected rice grain"},{"id":"semetey-1-2013:p1140:b003:l018","ordinal":163184,"en":"And drew their sweat each day;"},{"id":"semetey-1-2013:p1140:b003:l019","ordinal":163185,"en":"She fed them rich barley grain"},{"id":"semetey-1-2013:p1140:b003:l020","ordinal":163186,"en":"And drew their sweat each month."},{"id":"semetey-1-2013:p1140:b003:l021","ordinal":163187,"en":"The learned woman Kanykey,"},{"id":"semetey-1-2013:p1140:b003:l022","ordinal":163188,"en":"Knowing Kökötöy's feast would come"},{"id":"semetey-1-2013:p1140:b003:l023","ordinal":163189,"en":"And the people would fill it seething,"},{"id":"semetey-1-2013:p1140:b003:l024","ordinal":163190,"en":"Knowing lance shafts would bend"},{"id":"semetey-1-2013:p1140:b003:l025","ordinal":163191,"en":"When heroic men jousted,"},{"id":"semetey-1-2013:p1140:b003:l026","ordinal":163192,"en":"Feared the horses would grow too fat,"},{"id":"semetey-1-2013:p1140:b003:l027","ordinal":163193,"en":"Would become \"fat-swallowed,\""},{"id":"semetey-1-2013:p1140:b003:l028","ordinal":163194,"en":"And calamity strike the racehorses,"},{"id":"semetey-1-2013:p1140:b003:l029","ordinal":163195,"en":"Bringing mange upon them as well;"},{"id":"semetey-1-2013:p1140:b003:l030","ordinal":163196,"en":"They would lose mane and tail,"},{"id":"semetey-1-2013:p1140:b003:l031","ordinal":163197,"en":"Bringing disgrace,"},{"id":"semetey-1-2013:p1140:b003:l032","ordinal":163198,"en":"And all together"},{"id":"semetey-1-2013:p1140:b003:l033","ordinal":163199,"en":"Would mount crippled horses."},{"id":"semetey-1-2013:p1140:b003:l034","ordinal":163200,"en":"She feared incurable disgrace"},{"id":"semetey-1-2013:p1140:b003:l035","ordinal":163201,"en":"Would come from that."},{"id":"semetey-1-2013:p1140:b003:l036","ordinal":163202,"en":"The forty companions' forty racehorses,"},{"id":"semetey-1-2013:p1140:b003:l037","ordinal":163203,"en":"With Akkula at their head,"},{"id":"semetey-1-2013:p1140:b003:l038","ordinal":163204,"en":"She had brought from Khan-Zhaylak,"},{"id":"semetey-1-2013:p1140:b003:l039","ordinal":163205,"en":"Had their reins fitted firmly,"},{"id":"semetey-1-2013:p1140:b004:l001","ordinal":163206,"en":"Had felt coverings spread over them,"},{"id":"semetey-1-2013:p1140:b004:l002","ordinal":163207,"en":"And had the horses raised unseen."},{"id":"semetey-1-2013:p1140:b004:l003","ordinal":163208,"en":"Such are the deeds I have done."},{"id":"semetey-1-2013:p1140:b004:l004","ordinal":163209,"en":"Hear of my labor;"},{"id":"semetey-1-2013:p1140:b004:l005","ordinal":163210,"en":"Know my precious worth."},{"id":"semetey-1-2013:p1140:b004:l006","ordinal":163211,"en":"Each of you mount, dear boys,"},{"id":"semetey-1-2013:p1140:b004:l007","ordinal":163212,"en":"His own horse."},{"id":"semetey-1-2013:p1140:b004:l008","ordinal":163213,"en":"When khans swarm together"},{"id":"semetey-1-2013:p1140:b004:l009","ordinal":163214,"en":"Like black worms,"},{"id":"semetey-1-2013:p1140:b004:l010","ordinal":163215,"en":"What will the feast be like?"},{"id":"semetey-1-2013:p1140:b004:l011","ordinal":163216,"en":"What will become of the leaders"},{"id":"semetey-1-2013:p1140:b004:l012","ordinal":163217,"en":"Of the black Chinese and Manchus?"},{"id":"semetey-1-2013:p1140:b004:l013","ordinal":163218,"en":"A guest who brings calamity bears obligations—"},{"id":"semetey-1-2013:p1140:b004:l014","ordinal":163219,"en":"What will the feast be like?"},{"id":"semetey-1-2013:p1140:b004:l015","ordinal":163220,"en":"From within broad Talas,"},{"id":"semetey-1-2013:p1140:b004:l016","ordinal":163221,"en":"For riding if conflict began,"},{"id":"semetey-1-2013:p1140:b004:l017","ordinal":163222,"en":"He took six swift horses"},{"id":"semetey-1-2013:p1140:b004:l018","ordinal":163223,"en":"And had ammunition loaded on elephants."},{"id":"semetey-1-2013:p1140:b004:l019","ordinal":163224,"en":"He received the pledge of young Aydar"},{"id":"semetey-1-2013:p1140:b004:l020","ordinal":163225,"en":"That the handful of Muslims"},{"id":"semetey-1-2013:p1140:b004:l021","ordinal":163226,"en":"Had been utterly plundered."},{"id":"semetey-1-2013:p1140:b004:l022","ordinal":163227,"en":"He heard words from the messenger:"},{"id":"semetey-1-2013:p1140:b004:l023","ordinal":163228,"en":"At Khan Kökötöy's feast,"},{"id":"semetey-1-2013:p1140:b004:l024","ordinal":163229,"en":"The black Chinese and Manchus"},{"id":"semetey-1-2013:p1140:b004:l025","ordinal":163230,"en":"Had utterly slaughtered"},{"id":"semetey-1-2013:p1140:b004:l026","ordinal":163231,"en":"The handful of Muslims."},{"id":"semetey-1-2013:p1140:b004:l027","ordinal":163232,"en":"He heard that the handful of Muslims"},{"id":"semetey-1-2013:p1140:b004:l028","ordinal":163233,"en":"Had been plundered;"},{"id":"semetey-1-2013:p1140:b004:l029","ordinal":163234,"en":"He heard that, beginning with Khan Koshoy,"},{"id":"semetey-1-2013:p1140:b004:l030","ordinal":163235,"en":"They had been beaten."},{"id":"semetey-1-2013:p1140:b004:l031","ordinal":163236,"en":"He heard that the Chinese had inflicted"},{"id":"semetey-1-2013:p1140:b004:l032","ordinal":163237,"en":"Humiliation upon noble Koshoy;"},{"id":"semetey-1-2013:p1140:b004:l033","ordinal":163238,"en":"That hero Töshtük, son of Eleman,"},{"id":"semetey-1-2013:p1140:b004:l034","ordinal":163239,"en":"Had lost his wits;"},{"id":"semetey-1-2013:p1140:b004:l035","ordinal":163240,"en":"That Bokmurun, giver of the feast,"},{"id":"semetey-1-2013:p1140:b004:l036","ordinal":163241,"en":"Had fled from among the people;"},{"id":"semetey-1-2013:p1140:b004:l037","ordinal":163242,"en":"That the black Chinese had seized"},{"id":"semetey-1-2013:p1140:b004:l038","ordinal":163243,"en":"All the vast riches;"},{"id":"semetey-1-2013:p1140:b004:l039","ordinal":163244,"en":"That they had begun the spectacle;"},{"id":"semetey-1-2013:p1141:b003:l001","ordinal":163245,"en":"That the Chinese had plundered and taken"},{"id":"semetey-1-2013:p1141:b003:l002","ordinal":163246,"en":"Kökötöy's vast riches;"},{"id":"semetey-1-2013:p1141:b003:l003","ordinal":163247,"en":"That the many Manchus tirelessly"},{"id":"semetey-1-2013:p1141:b003:l004","ordinal":163248,"en":"Had begun the spectacle."},{"id":"semetey-1-2013:p1141:b003:l005","ordinal":163249,"en":"Before Chinese as numerous as cow hairs,"},{"id":"semetey-1-2013:p1141:b003:l006","ordinal":163250,"en":"We had grown terrified."},{"id":"semetey-1-2013:p1141:b003:l007","ordinal":163251,"en":"Then tiger Manas,"},{"id":"semetey-1-2013:p1141:b003:l008","ordinal":163252,"en":"Burning in anger,"},{"id":"semetey-1-2013:p1141:b003:l009","ordinal":163253,"en":"Donned Akolpok,"},{"id":"semetey-1-2013:p1141:b003:l010","ordinal":163254,"en":"Girded on his gray cartridge belt,"},{"id":"semetey-1-2013:p1141:b003:l011","ordinal":163255,"en":"And prayed to the one God."},{"id":"semetey-1-2013:p1141:b003:l012","ordinal":163256,"en":"Saying the people had been ruined,"},{"id":"semetey-1-2013:p1141:b003:l013","ordinal":163257,"en":"Bloodthirsty Manas prepared;"},{"id":"semetey-1-2013:p1141:b003:l014","ordinal":163258,"en":"Alarmed for the Muslims,"},{"id":"semetey-1-2013:p1141:b003:l015","ordinal":163259,"en":"Hero Manas then"},{"id":"semetey-1-2013:p1141:b003:l016","ordinal":163260,"en":"Saddled Akkula."},{"id":"semetey-1-2013:p1141:b003:l017","ordinal":163261,"en":"If you ask of Akkula's nature,"},{"id":"semetey-1-2013:p1141:b003:l018","ordinal":163262,"en":"It was a true racehorse:"},{"id":"semetey-1-2013:p1141:b003:l019","ordinal":163263,"en":"Its splayed hooves were like ravines,"},{"id":"semetey-1-2013:p1141:b003:l020","ordinal":163264,"en":"Its forehead bore a white blaze,"},{"id":"semetey-1-2013:p1141:b003:l021","ordinal":163265,"en":"Forged like steel."},{"id":"semetey-1-2013:p1141:b003:l022","ordinal":163266,"en":"When its hoof struck the earth,"},{"id":"semetey-1-2013:p1141:b003:l023","ordinal":163267,"en":"It was like an overturned basin."},{"id":"semetey-1-2013:p1141:b003:l024","ordinal":163268,"en":"The breadth of its croup"},{"id":"semetey-1-2013:p1141:b003:l025","ordinal":163269,"en":"Was like a field where colts raced."},{"id":"semetey-1-2013:p1141:b003:l026","ordinal":163270,"en":"Your hero's Akkula"},{"id":"semetey-1-2013:p1141:b003:l027","ordinal":163271,"en":"Was the tiger's very self,"},{"id":"semetey-1-2013:p1141:b003:l028","ordinal":163272,"en":"Perfectly formed and swift,"},{"id":"semetey-1-2013:p1141:b003:l029","ordinal":163273,"en":"The foal of a yearling mare,"},{"id":"semetey-1-2013:p1141:b003:l030","ordinal":163274,"en":"A tulpar among black horses."},{"id":"semetey-1-2013:p1141:b003:l031","ordinal":163275,"en":"It did not falter when ridden into battle,"},{"id":"semetey-1-2013:p1141:b003:l032","ordinal":163276,"en":"Nor grow sick when ridden with the baggage train."},{"id":"semetey-1-2013:p1141:b003:l033","ordinal":163277,"en":"They dressed it in all its gear"},{"id":"semetey-1-2013:p1141:b003:l034","ordinal":163278,"en":"And mounted the enraged bloodthirsty hero"},{"id":"semetey-1-2013:p1141:b003:l035","ordinal":163279,"en":"Upon Akkula."},{"id":"semetey-1-2013:p1141:b003:l036","ordinal":163280,"en":"The spirit of whoever saw him failed;"},{"id":"semetey-1-2013:p1141:b003:l037","ordinal":163281,"en":"The gray-wolf lord, the tiger,"},{"id":"semetey-1-2013:p1141:b003:l038","ordinal":163282,"en":"Appeared like Mount Opol."},{"id":"semetey-1-2013:p1141:b003:l039","ordinal":163283,"en":"Dressed in a yellow buulum robe,"},{"id":"semetey-1-2013:p1141:b004:l001","ordinal":163284,"en":"Kanykey of Khan Manas"},{"id":"semetey-1-2013:p1141:b004:l002","ordinal":163285,"en":"Had a black-blazed argamak"},{"id":"semetey-1-2013:p1141:b004:l003","ordinal":163286,"en":"And mounted the argamak."},{"id":"semetey-1-2013:p1141:b004:l004","ordinal":163287,"en":"To see Kökötöy's vast riches,"},{"id":"semetey-1-2013:p1141:b004:l005","ordinal":163288,"en":"To see the great wealth,"},{"id":"semetey-1-2013:p1141:b004:l006","ordinal":163289,"en":"The beautiful lioness Kanykey"},{"id":"semetey-1-2013:p1141:b004:l007","ordinal":163290,"en":"Went along"},{"id":"semetey-1-2013:p1141:b004:l008","ordinal":163291,"en":"To direct the feast."},{"id":"semetey-1-2013:p1141:b004:l009","ordinal":163292,"en":"Azhybay and Bakay were twin khans;"},{"id":"semetey-1-2013:p1141:b004:l010","ordinal":163293,"en":"Almambet and Chubak were twin heroes;"},{"id":"semetey-1-2013:p1141:b004:l011","ordinal":163294,"en":"Serek and Syrgak were equal heroes."},{"id":"semetey-1-2013:p1141:b004:l012","ordinal":163295,"en":"All the forty companions were there,"},{"id":"semetey-1-2013:p1141:b004:l013","ordinal":163296,"en":"The most skillful spear-thrusters,"},{"id":"semetey-1-2013:p1141:b004:l014","ordinal":163297,"en":"The finest battle-axe wielders."},{"id":"semetey-1-2013:p1141:b004:l015","ordinal":163298,"en":"If attacked, they brought ruin upon a people;"},{"id":"semetey-1-2013:p1141:b004:l016","ordinal":163299,"en":"Where they swarmed was red fire."},{"id":"semetey-1-2013:p1141:b004:l017","ordinal":163300,"en":"Manas surged forward"},{"id":"semetey-1-2013:p1141:b004:l018","ordinal":163301,"en":"And set out for the feast."},{"id":"semetey-1-2013:p1141:b004:l019","ordinal":163302,"en":"Before a gray wolf great as a mountain,"},{"id":"semetey-1-2013:p1141:b004:l020","ordinal":163303,"en":"Could a mountain stand firm?"},{"id":"semetey-1-2013:p1141:b004:l021","ordinal":163304,"en":"Could any mortal meet and defeat him!"},{"id":"semetey-1-2013:p1141:b004:l022","ordinal":163305,"en":"Khan Manas's nature was of another kind:"},{"id":"semetey-1-2013:p1141:b004:l023","ordinal":163306,"en":"His brow was high, his venom strong;"},{"id":"semetey-1-2013:p1141:b004:l024","ordinal":163307,"en":"He leveled whoever attacked."},{"id":"semetey-1-2013:p1141:b004:l025","ordinal":163308,"en":"Have you heard the tale?"},{"id":"semetey-1-2013:p1141:b004:l026","ordinal":163309,"en":"Born in Altay, he grew mighty;"},{"id":"semetey-1-2013:p1141:b004:l027","ordinal":163310,"en":"Whoever exchanged fire with him"},{"id":"semetey-1-2013:p1141:b004:l028","ordinal":163311,"en":"Was humiliated."},{"id":"semetey-1-2013:p1141:b004:l029","ordinal":163312,"en":"He never stood idle without fighting;"},{"id":"semetey-1-2013:p1141:b004:l030","ordinal":163313,"en":"When he heard the news,"},{"id":"semetey-1-2013:p1141:b004:l031","ordinal":163314,"en":"The Kakan's khan wept."},{"id":"semetey-1-2013:p1141:b004:l032","ordinal":163315,"en":"The sorcerer who came from Beijing"},{"id":"semetey-1-2013:p1141:b004:l033","ordinal":163316,"en":"Judged the hero from his lineage."},{"id":"semetey-1-2013:p1141:b004:l034","ordinal":163317,"en":"When he reached twelve,"},{"id":"semetey-1-2013:p1141:b004:l035","ordinal":163318,"en":"He broke a citadel and took booty,"},{"id":"semetey-1-2013:p1141:b004:l036","ordinal":163319,"en":"And brought conflict to fortified peoples."},{"id":"semetey-1-2013:p1141:b004:l037","ordinal":163320,"en":"He never watched without drinking blood;"},{"id":"semetey-1-2013:p1141:b004:l038","ordinal":163321,"en":"Calling him the bloodthirsty Burut,"},{"id":"semetey-1-2013:p1141:b004:l039","ordinal":163322,"en":"The Kalmyk khan wept."},{"id":"semetey-1-2013:p1142:b003:l001","ordinal":163323,"en":"When he migrated from Altay,"},{"id":"semetey-1-2013:p1142:b003:l002","ordinal":163324,"en":"The Kalmyks who fought him were laid low."},{"id":"semetey-1-2013:p1142:b003:l003","ordinal":163325,"en":"The tiger gathered forty companions"},{"id":"semetey-1-2013:p1142:b003:l004","ordinal":163326,"en":"And became a wolf-khan in Talas."},{"id":"semetey-1-2013:p1142:b003:l005","ordinal":163327,"en":"The mortal who struggled with him"},{"id":"semetey-1-2013:p1142:b003:l006","ordinal":163328,"en":"Became bread."}]
