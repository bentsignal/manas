[{"id":"semetey-1-2013:p0985:b003:l008","ordinal":151297,"en":"From the pampered woman."},{"id":"semetey-1-2013:p0985:b003:l009","ordinal":151298,"en":"Chachykey’s white palace"},{"id":"semetey-1-2013:p0985:b003:l010","ordinal":151299,"en":"Had a gate of solid iron and tin;"},{"id":"semetey-1-2013:p0985:b003:l011","ordinal":151300,"en":"The pampered daughter-in-law’s"},{"id":"semetey-1-2013:p0985:b003:l012","ordinal":151301,"en":"Splendor was exceedingly great."},{"id":"semetey-1-2013:p0985:b003:l013","ordinal":151302,"en":"No one dared approach it,"},{"id":"semetey-1-2013:p0985:b003:l014","ordinal":151303,"en":"And whoever did was amazed;"},{"id":"semetey-1-2013:p0985:b003:l015","ordinal":151304,"en":"No traveler dared go there,"},{"id":"semetey-1-2013:p0985:b003:l016","ordinal":151305,"en":"And whoever looked was amazed."},{"id":"semetey-1-2013:p0985:b003:l017","ordinal":151306,"en":"At Chachykey’s encampment,"},{"id":"semetey-1-2013:p0985:b003:l018","ordinal":151307,"en":"Acting as mediators there,"},{"id":"semetey-1-2013:p0985:b003:l019","ordinal":151308,"en":"The three senior wives entered"},{"id":"semetey-1-2013:p0985:b003:l020","ordinal":151309,"en":"To learn what had become"},{"id":"semetey-1-2013:p0985:b003:l021","ordinal":151310,"en":"Of the falcon that had flown away."},{"id":"semetey-1-2013:p0985:b003:l022","ordinal":151311,"en":"Körpöjan, wife of Khan Bakay,"},{"id":"semetey-1-2013:p0985:b003:l023","ordinal":151312,"en":"Moved like a goose with young,"},{"id":"semetey-1-2013:p0985:b003:l024","ordinal":151313,"en":"Walked inside, and began speaking:"},{"id":"semetey-1-2013:p0985:b003:l025","ordinal":151314,"en":"“You were once a younger child;"},{"id":"semetey-1-2013:p0985:b003:l026","ordinal":151315,"en":"Ah, delight who shares my life!"},{"id":"semetey-1-2013:p0985:b003:l027","ordinal":151316,"en":"Now, my child, tell the truth."},{"id":"semetey-1-2013:p0985:b003:l028","ordinal":151317,"en":"They opened their horses’ stride;"},{"id":"semetey-1-2013:p0985:b003:l029","ordinal":151318,"en":"Along the shore of Ala-Köl,"},{"id":"semetey-1-2013:p0985:b003:l030","ordinal":151319,"en":"Prince Semetey the lion"},{"id":"semetey-1-2013:p0985:b003:l031","ordinal":151320,"en":"Lost Akshunkar."},{"id":"semetey-1-2013:p0985:b003:l032","ordinal":151321,"en":"Take wisdom worth red gold;"},{"id":"semetey-1-2013:p0985:b003:l033","ordinal":151322,"en":"My precious child, heed my words!"},{"id":"semetey-1-2013:p0985:b003:l034","ordinal":151323,"en":"We followed the chain of tradition,"},{"id":"semetey-1-2013:p0985:b003:l035","ordinal":151324,"en":"Asked the learned men,"},{"id":"semetey-1-2013:p0985:b003:l036","ordinal":151325,"en":"And heard words from men of counsel:"},{"id":"semetey-1-2013:p0985:b003:l037","ordinal":151326,"en":"My colt, we heard that you know"},{"id":"semetey-1-2013:p0985:b003:l038","ordinal":151327,"en":"Of the falcon that was carried away."},{"id":"semetey-1-2013:p0985:b003:l039","ordinal":151328,"en":"Ah, my colt Chachykey,"},{"id":"semetey-1-2013:p0985:b005:l001","ordinal":151329,"en":"Tell the song you have sung,"},{"id":"semetey-1-2013:p0985:b005:l002","ordinal":151330,"en":"And speak your secret faithfully!"},{"id":"semetey-1-2013:p0985:b005:l003","ordinal":151331,"en":"If you tell your secret, you will prosper"},{"id":"semetey-1-2013:p0985:b005:l004","ordinal":151332,"en":"And become a pure senior wife."},{"id":"semetey-1-2013:p0985:b005:l005","ordinal":151333,"en":"If you are human, tell the truth:"},{"id":"semetey-1-2013:p0985:b005:l006","ordinal":151334,"en":"How did you sleep, and what dream did you see?"},{"id":"semetey-1-2013:p0985:b005:l007","ordinal":151335,"en":"What manner of event did you witness?"},{"id":"semetey-1-2013:p0985:b005:l008","ordinal":151336,"en":"Tell the truth, my colt!"},{"id":"semetey-1-2013:p0985:b005:l009","ordinal":151337,"en":"Think upon what came before and after;"},{"id":"semetey-1-2013:p0985:b005:l010","ordinal":151338,"en":"If you do not tell it, your blue lord"},{"id":"semetey-1-2013:p0985:b005:l011","ordinal":151339,"en":"May mock you for nothing."},{"id":"semetey-1-2013:p0985:b005:l012","ordinal":151340,"en":"A man’s work is solid iron,"},{"id":"semetey-1-2013:p0985:b005:l013","ordinal":151341,"en":"My child, but your name is woman;"},{"id":"semetey-1-2013:p0985:b005:l014","ordinal":151342,"en":"One needs skill to melt it."},{"id":"semetey-1-2013:p0985:b005:l015","ordinal":151343,"en":"If you do not tell, shame and reproach"},{"id":"semetey-1-2013:p0985:b005:l016","ordinal":151344,"en":"Will fall upon your own head."},{"id":"semetey-1-2013:p0985:b005:l017","ordinal":151345,"en":"If you do not tell, my colt,"},{"id":"semetey-1-2013:p0985:b005:l018","ordinal":151346,"en":"What can I say of every deed"},{"id":"semetey-1-2013:p0985:b005:l019","ordinal":151347,"en":"Of your dark-hearted prince,"},{"id":"semetey-1-2013:p0985:b005:l020","ordinal":151348,"en":"The true son of the tiger,"},{"id":"semetey-1-2013:p0985:b005:l021","ordinal":151349,"en":"Descendant of the mighty"},{"id":"semetey-1-2013:p0985:b005:l022","ordinal":151350,"en":"Who smoked whenever he was spent"},{"id":"semetey-1-2013:p0985:b005:l023","ordinal":151351,"en":"And grew fiercer whenever he died?"},{"id":"semetey-1-2013:p0985:b005:l024","ordinal":151352,"en":"If you do not tell, suddenly,"},{"id":"semetey-1-2013:p0985:b005:l025","ordinal":151353,"en":"When that desperate man’s anger rises,"},{"id":"semetey-1-2013:p0985:b005:l026","ordinal":151354,"en":"A man’s affairs are perilous."},{"id":"semetey-1-2013:p0985:b005:l027","ordinal":151355,"en":"May he not stretch out the hair at your temples,"},{"id":"semetey-1-2013:p0985:b005:l028","ordinal":151356,"en":"Or give you the divorce of a cast-off wife!"},{"id":"semetey-1-2013:p0985:b005:l029","ordinal":151357,"en":"Do not be obstinate; hear my words."},{"id":"semetey-1-2013:p0985:b005:l030","ordinal":151358,"en":"My daughter-in-law, heed me now."},{"id":"semetey-1-2013:p0985:b005:l031","ordinal":151359,"en":"If you disobey and your sorrow boils,"},{"id":"semetey-1-2013:p0985:b005:l032","ordinal":151360,"en":"He may put a kementei upon you,"},{"id":"semetey-1-2013:p0985:b005:l033","ordinal":151361,"en":"Mount you on a bay mare,"},{"id":"semetey-1-2013:p0985:b005:l034","ordinal":151362,"en":"And drive you toward your father."},{"id":"semetey-1-2013:p0985:b005:l035","ordinal":151363,"en":"When your father gave you,"},{"id":"semetey-1-2013:p0985:b005:l036","ordinal":151364,"en":"When you came here as a bride,"},{"id":"semetey-1-2013:p0985:b005:l037","ordinal":151365,"en":"You shone in a kete coat,"},{"id":"semetey-1-2013:p0985:b005:l038","ordinal":151366,"en":"Rode proudly upon a bay pacer,"},{"id":"semetey-1-2013:p0985:b005:l039","ordinal":151367,"en":"And shone in a supa coat,"},{"id":"semetey-1-2013:p0986:b003:l001","ordinal":151368,"en":"And rode proudly on a gray pacer."},{"id":"semetey-1-2013:p0986:b003:l002","ordinal":151369,"en":"If you make trouble, my colt,"},{"id":"semetey-1-2013:p0986:b003:l003","ordinal":151370,"en":"How will you depart,"},{"id":"semetey-1-2013:p0986:b003:l004","ordinal":151371,"en":"Flapping in a kementei,"},{"id":"semetey-1-2013:p0986:b003:l005","ordinal":151372,"en":"Swaggering on a bay mare?"},{"id":"semetey-1-2013:p0986:b003:l006","ordinal":151373,"en":"Know that this would be a great shame."},{"id":"semetey-1-2013:p0986:b003:l007","ordinal":151374,"en":"How will you wander away,"},{"id":"semetey-1-2013:p0986:b003:l008","ordinal":151375,"en":"Swaggering on a gray mare,"},{"id":"semetey-1-2013:p0986:b003:l009","ordinal":151376,"en":"Flapping in a hide coat?"},{"id":"semetey-1-2013:p0986:b003:l010","ordinal":151377,"en":"My child, heed these words of mine:"},{"id":"semetey-1-2013:p0986:b003:l011","ordinal":151378,"en":"All the people blessed by Kydyr are here;"},{"id":"semetey-1-2013:p0986:b003:l012","ordinal":151379,"en":"Dear old Bakay is here;"},{"id":"semetey-1-2013:p0986:b003:l013","ordinal":151380,"en":"Sarykan of the bowl-shaped eyes,"},{"id":"semetey-1-2013:p0986:b003:l014","ordinal":151381,"en":"The khan of sacred power, is here;"},{"id":"semetey-1-2013:p0986:b003:l015","ordinal":151382,"en":"And Jamgyrchy, hero of the Esheks,"},{"id":"semetey-1-2013:p0986:b003:l016","ordinal":151383,"en":"Is also here.”"},{"id":"semetey-1-2013:p0986:b003:l017","ordinal":151384,"en":"When the senior wife said this,"},{"id":"semetey-1-2013:p0986:b003:l018","ordinal":151385,"en":"The witless woman Chachykey"},{"id":"semetey-1-2013:p0986:b003:l019","ordinal":151386,"en":"Now stood and seethed,"},{"id":"semetey-1-2013:p0986:b003:l020","ordinal":151387,"en":"And spoke in an altogether different way"},{"id":"semetey-1-2013:p0986:b003:l021","ordinal":151388,"en":"To the khans of the Esheks:"},{"id":"semetey-1-2013:p0986:b003:l022","ordinal":151389,"en":"“Women who came as mediators,"},{"id":"semetey-1-2013:p0986:b003:l023","ordinal":151390,"en":"Leave now, you wretches!"},{"id":"semetey-1-2013:p0986:b003:l024","ordinal":151391,"en":"Dig your deep graves—"},{"id":"semetey-1-2013:p0986:b003:l025","ordinal":151392,"en":"I shall boil your suffering!"},{"id":"semetey-1-2013:p0986:b003:l026","ordinal":151393,"en":"You came here seeking support"},{"id":"semetey-1-2013:p0986:b003:l027","ordinal":151394,"en":"From your sprawling elder Bakay."},{"id":"semetey-1-2013:p0986:b003:l028","ordinal":151395,"en":"I know all of you perfectly:"},{"id":"semetey-1-2013:p0986:b003:l029","ordinal":151396,"en":"Your white-bearded old Bakay,"},{"id":"semetey-1-2013:p0986:b003:l030","ordinal":151397,"en":"You three women, his playthings,"},{"id":"semetey-1-2013:p0986:b003:l031","ordinal":151398,"en":"And your hairless bald man"},{"id":"semetey-1-2013:p0986:b003:l032","ordinal":151399,"en":"Whom you sit worshiping as a saint."},{"id":"semetey-1-2013:p0986:b003:l033","ordinal":151400,"en":"I know what you are doing,"},{"id":"semetey-1-2013:p0986:b003:l034","ordinal":151401,"en":"And the one you chose to bring,"},{"id":"semetey-1-2013:p0986:b003:l035","ordinal":151402,"en":"Your witless, lowborn fellow"},{"id":"semetey-1-2013:p0986:b003:l036","ordinal":151403,"en":"Called Jamgyrchy."},{"id":"semetey-1-2013:p0986:b003:l037","ordinal":151404,"en":"May God strike down"},{"id":"semetey-1-2013:p0986:b003:l038","ordinal":151405,"en":"All you old ones with swan-white beards!”"},{"id":"semetey-1-2013:p0986:b003:l039","ordinal":151406,"en":"The poor woman did not know"},{"id":"semetey-1-2013:p0986:b004:l001","ordinal":151407,"en":"That Bakay was listening nearby;"},{"id":"semetey-1-2013:p0986:b004:l002","ordinal":151408,"en":"Beginning with Khan Bakay,"},{"id":"semetey-1-2013:p0986:b004:l003","ordinal":151409,"en":"She cursed every one of them."},{"id":"semetey-1-2013:p0986:b004:l004","ordinal":151410,"en":"The three senior wives led the way"},{"id":"semetey-1-2013:p0986:b004:l005","ordinal":151411,"en":"And fled outside in a rush,"},{"id":"semetey-1-2013:p0986:b004:l006","ordinal":151412,"en":"Their necks stretching like geese,"},{"id":"semetey-1-2013:p0986:b004:l007","ordinal":151413,"en":"Both cheeks turning red."},{"id":"semetey-1-2013:p0986:b004:l008","ordinal":151414,"en":"There was no cure to be found:"},{"id":"semetey-1-2013:p0986:b004:l009","ordinal":151415,"en":"“She has insulted the khan,” they said,"},{"id":"semetey-1-2013:p0986:b004:l010","ordinal":151416,"en":"And all pinched their own faces."},{"id":"semetey-1-2013:p0986:b004:l011","ordinal":151417,"en":"Old Bakay heard"},{"id":"semetey-1-2013:p0986:b004:l012","ordinal":151418,"en":"Her vicious torrent of abuse,"},{"id":"semetey-1-2013:p0986:b004:l013","ordinal":151419,"en":"And all that had been said."},{"id":"semetey-1-2013:p0986:b004:l014","ordinal":151420,"en":"Misery fell upon Bakay."},{"id":"semetey-1-2013:p0986:b004:l015","ordinal":151421,"en":"The three khans sat drooping,"},{"id":"semetey-1-2013:p0986:b004:l016","ordinal":151422,"en":"Hunched like frozen camels,"},{"id":"semetey-1-2013:p0986:b004:l017","ordinal":151423,"en":"Unable to die from shame,"},{"id":"semetey-1-2013:p0986:b004:l018","ordinal":151424,"en":"Or enter the grave in death,"},{"id":"semetey-1-2013:p0986:b004:l019","ordinal":151425,"en":"Unable to understand"},{"id":"semetey-1-2013:p0986:b004:l020","ordinal":151426,"en":"What manner of woman this loud daughter-in-law was."},{"id":"semetey-1-2013:p0986:b004:l021","ordinal":151427,"en":"Since Bakay first became Bakay,"},{"id":"semetey-1-2013:p0986:b004:l022","ordinal":151428,"en":"Since Bakay first mounted a horse,"},{"id":"semetey-1-2013:p0986:b004:l023","ordinal":151429,"en":"Since he stretched himself and became a man,"},{"id":"semetey-1-2013:p0986:b004:l024","ordinal":151430,"en":"Standing equal with the sons of heroes,"},{"id":"semetey-1-2013:p0986:b004:l025","ordinal":151431,"en":"Since Bakay first mounted a horse"},{"id":"semetey-1-2013:p0986:b004:l026","ordinal":151432,"en":"And became a pillar of the people,"},{"id":"semetey-1-2013:p0986:b004:l027","ordinal":151433,"en":"He had never died when fate reached him;"},{"id":"semetey-1-2013:p0986:b004:l028","ordinal":151434,"en":"Bakay was no woman,"},{"id":"semetey-1-2013:p0986:b004:l029","ordinal":151435,"en":"Yet he had never seen such treatment from a man."},{"id":"semetey-1-2013:p0986:b004:l030","ordinal":151436,"en":"To witness this judgment-day affair,"},{"id":"semetey-1-2013:p0986:b004:l031","ordinal":151437,"en":"To have his beard and head reviled—"},{"id":"semetey-1-2013:p0986:b004:l032","ordinal":151438,"en":"It was the death of Khan Bakay."},{"id":"semetey-1-2013:p0986:b004:l033","ordinal":151439,"en":"Prince Bakay the tiger,"},{"id":"semetey-1-2013:p0986:b004:l034","ordinal":151440,"en":"Who had mustered armies and struck the Kalmyks,"},{"id":"semetey-1-2013:p0986:b004:l035","ordinal":151441,"en":"Your elder Prince Bakay,"},{"id":"semetey-1-2013:p0986:b004:l036","ordinal":151442,"en":"Broke down and spoke in a low voice:"},{"id":"semetey-1-2013:p0986:b004:l037","ordinal":151443,"en":"“In the time when our fortune remained safe,"},{"id":"semetey-1-2013:p0986:b004:l038","ordinal":151444,"en":"When the tiger Manas lived,"},{"id":"semetey-1-2013:p0986:b004:l039","ordinal":151445,"en":"Kara-Shaar and Kambyl—"},{"id":"semetey-1-2013:p0987:b003:l001","ordinal":151446,"en":"When I had the Kalmyks surrounded,"},{"id":"semetey-1-2013:p0987:b003:l002","ordinal":151447,"en":"And struck them with resounding blows,"},{"id":"semetey-1-2013:p0987:b003:l003","ordinal":151448,"en":"While I was beating them,"},{"id":"semetey-1-2013:p0987:b003:l004","ordinal":151449,"en":"Why did I not die there?"},{"id":"semetey-1-2013:p0987:b003:l005","ordinal":151450,"en":"Alas, when Manas lived,"},{"id":"semetey-1-2013:p0987:b003:l006","ordinal":151451,"en":"When the swaggering Kojo stood before me,"},{"id":"semetey-1-2013:p0987:b003:l007","ordinal":151452,"en":"My hand could reach him."},{"id":"semetey-1-2013:p0987:b003:l008","ordinal":151453,"en":"When I faced Kakan and Keng-Tung,"},{"id":"semetey-1-2013:p0987:b003:l009","ordinal":151454,"en":"And had them surrounded,"},{"id":"semetey-1-2013:p0987:b003:l010","ordinal":151455,"en":"And was beating"},{"id":"semetey-1-2013:p0987:b003:l011","ordinal":151456,"en":"The bald men of seething China,"},{"id":"semetey-1-2013:p0987:b003:l012","ordinal":151457,"en":"Each carrying a stone,"},{"id":"semetey-1-2013:p0987:b003:l013","ordinal":151458,"en":"Why did I not die there?"},{"id":"semetey-1-2013:p0987:b003:l014","ordinal":151459,"en":"When my wise Manas lived,"},{"id":"semetey-1-2013:p0987:b003:l015","ordinal":151460,"en":"When I cast turmoil"},{"id":"semetey-1-2013:p0987:b003:l016","ordinal":151461,"en":"Across the face of the earth,"},{"id":"semetey-1-2013:p0987:b003:l017","ordinal":151462,"en":"Whoever stood in defiance,"},{"id":"semetey-1-2013:p0987:b003:l018","ordinal":151463,"en":"I seized and offered up,"},{"id":"semetey-1-2013:p0987:b003:l019","ordinal":151464,"en":"And slaughtered him as a sacrifice,"},{"id":"semetey-1-2013:p0987:b003:l020","ordinal":151465,"en":"Why did I not die there?"},{"id":"semetey-1-2013:p0987:b003:l021","ordinal":151466,"en":"This life I live is an evil name."},{"id":"semetey-1-2013:p0987:b003:l022","ordinal":151467,"en":"My courser Manas, take me with you!”"},{"id":"semetey-1-2013:p0987:b003:l023","ordinal":151468,"en":"Bakay stood and said these words."},{"id":"semetey-1-2013:p0987:b003:l024","ordinal":151469,"en":"Your dear woman Kanykey"},{"id":"semetey-1-2013:p0987:b003:l025","ordinal":151470,"en":"Took gifts and pacers for the three khans,"},{"id":"semetey-1-2013:p0987:b003:l026","ordinal":151471,"en":"And grasped a golden staff."},{"id":"semetey-1-2013:p0987:b003:l027","ordinal":151472,"en":"She cried out in fury"},{"id":"semetey-1-2013:p0987:b003:l028","ordinal":151473,"en":"And summoned the two twins:"},{"id":"semetey-1-2013:p0987:b003:l029","ordinal":151474,"en":"“Kulchoro and Kanchoro,"},{"id":"semetey-1-2013:p0987:b003:l030","ordinal":151475,"en":"You whom I nursed in turn five times"},{"id":"semetey-1-2013:p0987:b003:l031","ordinal":151476,"en":"Before the five Argakar stars had set—"},{"id":"semetey-1-2013:p0987:b003:l032","ordinal":151477,"en":"By your fathers’ graves, you two wretches,"},{"id":"semetey-1-2013:p0987:b003:l033","ordinal":151478,"en":"Has almighty God struck you?"},{"id":"semetey-1-2013:p0987:b003:l034","ordinal":151479,"en":"Sink down never to be born,"},{"id":"semetey-1-2013:p0987:b003:l035","ordinal":151480,"en":"Die rather than walk alive!"},{"id":"semetey-1-2013:p0987:b003:l036","ordinal":151481,"en":"When a horse dies, wretches,"},{"id":"semetey-1-2013:p0987:b003:l037","ordinal":151482,"en":"Its hide is needed;"},{"id":"semetey-1-2013:p0987:b003:l038","ordinal":151483,"en":"When an elder brother dies, wretches,"},{"id":"semetey-1-2013:p0987:b003:l039","ordinal":151484,"en":"A sister-in-law is needed."},{"id":"semetey-1-2013:p0987:b005:l001","ordinal":151485,"en":"When an elder brother loses his sight,"},{"id":"semetey-1-2013:p0987:b005:l002","ordinal":151486,"en":"And his wife becomes unruly,"},{"id":"semetey-1-2013:p0987:b005:l003","ordinal":151487,"en":"His younger brothers restrain her fury."},{"id":"semetey-1-2013:p0987:b005:l004","ordinal":151488,"en":"Go and gouge out her blinding eyes;"},{"id":"semetey-1-2013:p0987:b005:l005","ordinal":151489,"en":"Slaughter as a sacrifice"},{"id":"semetey-1-2013:p0987:b005:l006","ordinal":151490,"en":"The wretch who insulted the khan!"},{"id":"semetey-1-2013:p0987:b005:l007","ordinal":151491,"en":"I myself shall face"},{"id":"semetey-1-2013:p0987:b005:l008","ordinal":151492,"en":"Whatever calamity comes from it."},{"id":"semetey-1-2013:p0987:b005:l009","ordinal":151493,"en":"She and I were born together,"},{"id":"semetey-1-2013:p0987:b005:l010","ordinal":151494,"en":"Our fortunes born equal;"},{"id":"semetey-1-2013:p0987:b005:l011","ordinal":151495,"en":"I myself shall give the rival wife,"},{"id":"semetey-1-2013:p0987:b005:l012","ordinal":151496,"en":"And whatever disaster follows,"},{"id":"semetey-1-2013:p0987:b005:l013","ordinal":151497,"en":"I alone shall face it!”"},{"id":"semetey-1-2013:p0987:b005:l014","ordinal":151498,"en":"She girded her waist belt,"},{"id":"semetey-1-2013:p0987:b005:l015","ordinal":151499,"en":"Shouted in anger,"},{"id":"semetey-1-2013:p0987:b005:l016","ordinal":151500,"en":"And summoned Kulchoro."},{"id":"semetey-1-2013:p0987:b005:l017","ordinal":151501,"en":"Taking the golden staff in hand,"},{"id":"semetey-1-2013:p0987:b005:l018","ordinal":151502,"en":"She struck Kulchoro once."},{"id":"semetey-1-2013:p0987:b005:l019","ordinal":151503,"en":"Having taken a blow from his mother,"},{"id":"semetey-1-2013:p0987:b005:l020","ordinal":151504,"en":"Capable Kulchoro—"},{"id":"semetey-1-2013:p0987:b005:l021","ordinal":151505,"en":"He was a hero of twelve years;"},{"id":"semetey-1-2013:p0987:b005:l022","ordinal":151506,"en":"Do not ask of his blazing ardor."},{"id":"semetey-1-2013:p0987:b005:l023","ordinal":151507,"en":"He seized the black-jawed whip,"},{"id":"semetey-1-2013:p0987:b005:l024","ordinal":151508,"en":"Bent it double in his hand,"},{"id":"semetey-1-2013:p0987:b005:l025","ordinal":151509,"en":"Forced his knee toward the ground,"},{"id":"semetey-1-2013:p0987:b005:l026","ordinal":151510,"en":"And ran toward Chachykey"},{"id":"semetey-1-2013:p0987:b005:l027","ordinal":151511,"en":"To tell what had become of the falcon,"},{"id":"semetey-1-2013:p0987:b005:l028","ordinal":151512,"en":"And to call the foul-tongued woman"},{"id":"semetey-1-2013:p0987:b005:l029","ordinal":151513,"en":"To account before returning."},{"id":"semetey-1-2013:p0987:b005:l030","ordinal":151514,"en":"When he drew near the fortress,"},{"id":"semetey-1-2013:p0987:b005:l031","ordinal":151515,"en":"Chachykey’s forty daughters-in-law"},{"id":"semetey-1-2013:p0987:b005:l032","ordinal":151516,"en":"Had fastened the gate"},{"id":"semetey-1-2013:p0987:b005:l033","ordinal":151517,"en":"And stood holding the door."},{"id":"semetey-1-2013:p0987:b005:l034","ordinal":151518,"en":"He bellowed and shouted,"},{"id":"semetey-1-2013:p0987:b005:l035","ordinal":151519,"en":"Calling, “Open the door!”"},{"id":"semetey-1-2013:p0987:b005:l036","ordinal":151520,"en":"And Kulchoro now arrived."},{"id":"semetey-1-2013:p0987:b005:l037","ordinal":151521,"en":"At the door they had barred securely,"},{"id":"semetey-1-2013:p0987:b005:l038","ordinal":151522,"en":"The brave-born Kulchoro"},{"id":"semetey-1-2013:p0987:b005:l039","ordinal":151523,"en":"Struck, broke through, and entered."}]
