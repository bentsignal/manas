[{"id":"semetey-1-2013:p0243:b005:l016","ordinal":95489,"en":"Had left it unbraided."},{"id":"semetey-1-2013:p0243:b005:l017","ordinal":95490,"en":"Manas, her betrothed—"},{"id":"semetey-1-2013:p0243:b005:l018","ordinal":95491,"en":"Yearning to see him once,"},{"id":"semetey-1-2013:p0243:b005:l019","ordinal":95492,"en":"For twelve long years,"},{"id":"semetey-1-2013:p0243:b005:l020","ordinal":95493,"en":"Your mother had not seen him."},{"id":"semetey-1-2013:p0243:b005:l021","ordinal":95494,"en":"Crying out on the mountaintop,"},{"id":"semetey-1-2013:p0243:b005:l022","ordinal":95495,"en":"Your mother had become a snowcock."},{"id":"semetey-1-2013:p0243:b005:l023","ordinal":95496,"en":"Her mountain, the leopard Manas,"},{"id":"semetey-1-2013:p0243:b005:l024","ordinal":95497,"en":"Planted there in the world,"},{"id":"semetey-1-2013:p0243:b005:l025","ordinal":95498,"en":"Had been a plane tree."},{"id":"semetey-1-2013:p0243:b005:l026","ordinal":95499,"en":"To see her true lord,"},{"id":"semetey-1-2013:p0243:b005:l027","ordinal":95500,"en":"Your dear mother Kanykei"},{"id":"semetey-1-2013:p0243:b005:l028","ordinal":95501,"en":"Had longed so deeply."},{"id":"semetey-1-2013:p0243:b005:l029","ordinal":95502,"en":"Unable to turn Akborchuk's head,"},{"id":"semetey-1-2013:p0243:b005:l030","ordinal":95503,"en":"Your noble sister-in-law Kanykei,"},{"id":"semetey-1-2013:p0243:b005:l031","ordinal":95504,"en":"When she saw his very spirit,"},{"id":"semetey-1-2013:p0243:b005:l032","ordinal":95505,"en":"Could not stand without crying out;"},{"id":"semetey-1-2013:p0243:b005:l033","ordinal":95506,"en":"She wept and sobbed aloud:"},{"id":"semetey-1-2013:p0243:b005:l034","ordinal":95507,"en":"\"My betrothed lord, my fierce warrior,"},{"id":"semetey-1-2013:p0243:b005:l035","ordinal":95508,"en":"Take me with you!\" she shrieked."},{"id":"semetey-1-2013:p0243:b005:l036","ordinal":95509,"en":"\"My sultan, when the moon is dark,"},{"id":"semetey-1-2013:p0243:b005:l037","ordinal":95510,"en":"Is the night like this?"},{"id":"semetey-1-2013:p0243:b005:l038","ordinal":95511,"en":"When one loses one's betrothed,"},{"id":"semetey-1-2013:p0243:b005:l039","ordinal":95512,"en":"Are the days like this?"},{"id":"semetey-1-2013:p0244:b003:l001","ordinal":95513,"en":"Bloody tears flow from my eyes;"},{"id":"semetey-1-2013:p0244:b003:l002","ordinal":95514,"en":"Is a flood like this?"},{"id":"semetey-1-2013:p0244:b003:l003","ordinal":95515,"en":"Bereft of her leopard,"},{"id":"semetey-1-2013:p0244:b003:l004","ordinal":95516,"en":"When a woman wanders grieving,"},{"id":"semetey-1-2013:p0244:b003:l005","ordinal":95517,"en":"Is this how it must be?"},{"id":"semetey-1-2013:p0244:b003:l006","ordinal":95518,"en":"Misfortune fell upon my head;"},{"id":"semetey-1-2013:p0244:b003:l007","ordinal":95519,"en":"Carrying my child away,"},{"id":"semetey-1-2013:p0244:b003:l008","ordinal":95520,"en":"To my father's city,"},{"id":"semetey-1-2013:p0244:b003:l009","ordinal":95521,"en":"Has anyone fled as I have?"},{"id":"semetey-1-2013:p0244:b003:l010","ordinal":95522,"en":"Alas, my sultan, my leopard,"},{"id":"semetey-1-2013:p0244:b003:l011","ordinal":95523,"en":"My saint gone to the other world,"},{"id":"semetey-1-2013:p0244:b003:l012","ordinal":95524,"en":"Tie me to your saddle thongs and take me;"},{"id":"semetey-1-2013:p0244:b003:l013","ordinal":95525,"en":"Do not leave me grieving and wailing."},{"id":"semetey-1-2013:p0244:b003:l014","ordinal":95526,"en":"Have pity, take me with you!"},{"id":"semetey-1-2013:p0244:b003:l015","ordinal":95527,"en":"My shirts of many kinds,"},{"id":"semetey-1-2013:p0244:b003:l016","ordinal":95528,"en":"When I pull them up, do not reach my neck."},{"id":"semetey-1-2013:p0244:b003:l017","ordinal":95529,"en":"Do not wear me out, my sultan;"},{"id":"semetey-1-2013:p0244:b003:l018","ordinal":95530,"en":"Draw me into your embrace."},{"id":"semetey-1-2013:p0244:b003:l019","ordinal":95531,"en":"My shirt mingled with blue,"},{"id":"semetey-1-2013:p0244:b003:l020","ordinal":95532,"en":"Though I wear it often, does not reach my neck."},{"id":"semetey-1-2013:p0244:b003:l021","ordinal":95533,"en":"This raging woman who wanders—"},{"id":"semetey-1-2013:p0244:b003:l022","ordinal":95534,"en":"Leopard, keep her in your thoughts!"},{"id":"semetey-1-2013:p0244:b003:l023","ordinal":95535,"en":"Do not make my broad world narrow;"},{"id":"semetey-1-2013:p0244:b003:l024","ordinal":95536,"en":"This grieving, unfortunate woman—"},{"id":"semetey-1-2013:p0244:b003:l025","ordinal":95537,"en":"Do not make her scream with longing.\""},{"id":"semetey-1-2013:p0244:b003:l026","ordinal":95538,"en":"So spoke your mother."},{"id":"semetey-1-2013:p0244:b003:l027","ordinal":95539,"en":"From her dear, quail-like eyes,"},{"id":"semetey-1-2013:p0244:b003:l028","ordinal":95540,"en":"Tears flowed in separate streams."},{"id":"semetey-1-2013:p0244:b003:l029","ordinal":95541,"en":"Unable to collect herself,"},{"id":"semetey-1-2013:p0244:b003:l030","ordinal":95542,"en":"She turned about, weeping and crying,"},{"id":"semetey-1-2013:p0244:b003:l031","ordinal":95543,"en":"Wailing and sobbing aloud."},{"id":"semetey-1-2013:p0244:b003:l032","ordinal":95544,"en":"Her poor heart was torn;"},{"id":"semetey-1-2013:p0244:b003:l033","ordinal":95545,"en":"Tears poured from her eyes."},{"id":"semetey-1-2013:p0244:b003:l034","ordinal":95546,"en":"The lord she saw before her,"},{"id":"semetey-1-2013:p0244:b003:l035","ordinal":95547,"en":"Her fierce warrior, dear Manas,"},{"id":"semetey-1-2013:p0244:b003:l036","ordinal":95548,"en":"Appeared just as he had in life."},{"id":"semetey-1-2013:p0244:b003:l037","ordinal":95549,"en":"When she saw her plane-tree garden,"},{"id":"semetey-1-2013:p0244:b003:l038","ordinal":95550,"en":"The hair down her back, in six—"},{"id":"semetey-1-2013:p0244:b003:l039","ordinal":95551,"en":"Would your sister-in-law leave it unbraided?"},{"id":"semetey-1-2013:p0244:b004:l001","ordinal":95552,"en":"\"Take me with you!\" she cried."},{"id":"semetey-1-2013:p0244:b004:l002","ordinal":95553,"en":"Your noble mother Kanykei,"},{"id":"semetey-1-2013:p0244:b004:l003","ordinal":95554,"en":"Wailing and sobbing again and again,"},{"id":"semetey-1-2013:p0244:b004:l004","ordinal":95555,"en":"Now raised a piercing cry."},{"id":"semetey-1-2013:p0244:b004:l005","ordinal":95556,"en":"When she saw that plane-tree garden,"},{"id":"semetey-1-2013:p0244:b004:l006","ordinal":95557,"en":"At her white cheeks round as cups,"},{"id":"semetey-1-2013:p0244:b004:l007","ordinal":95558,"en":"\"My true lord, take me!\" she said,"},{"id":"semetey-1-2013:p0244:b004:l008","ordinal":95559,"en":"And tore at them again and again."},{"id":"semetey-1-2013:p0244:b004:l009","ordinal":95560,"en":"As she tore, dark blood flowed;"},{"id":"semetey-1-2013:p0244:b004:l010","ordinal":95561,"en":"Your mother's strength ebbed away."},{"id":"semetey-1-2013:p0244:b004:l011","ordinal":95562,"en":"Akborchuk continued pacing;"},{"id":"semetey-1-2013:p0244:b004:l012","ordinal":95563,"en":"From Akborchuk's mane—"},{"id":"semetey-1-2013:p0244:b004:l013","ordinal":95564,"en":"The poor world had turned upside down—"},{"id":"semetey-1-2013:p0244:b004:l014","ordinal":95565,"en":"Bloody tears mixed with blood"},{"id":"semetey-1-2013:p0244:b004:l015","ordinal":95566,"en":"Streamed down in rivulets."},{"id":"semetey-1-2013:p0244:b004:l016","ordinal":95567,"en":"The very spirit of Manas"},{"id":"semetey-1-2013:p0244:b004:l017","ordinal":95568,"en":"She had almost seen;"},{"id":"semetey-1-2013:p0244:b004:l018","ordinal":95569,"en":"Kanykei, shrieking and weeping,"},{"id":"semetey-1-2013:p0244:b004:l019","ordinal":95570,"en":"Almost died."},{"id":"semetey-1-2013:p0244:b004:l020","ordinal":95571,"en":"She turned Akborchuk's head,"},{"id":"semetey-1-2013:p0244:b004:l021","ordinal":95572,"en":"Tore her cheeks with both hands."},{"id":"semetey-1-2013:p0244:b004:l022","ordinal":95573,"en":"As she tore, dark blood flowed;"},{"id":"semetey-1-2013:p0244:b004:l023","ordinal":95574,"en":"Your sister-in-law's strength ebbed away."},{"id":"semetey-1-2013:p0244:b004:l024","ordinal":95575,"en":"Her dear hair, thick as a girth,"},{"id":"semetey-1-2013:p0244:b004:l025","ordinal":95576,"en":"She brought down to her breast"},{"id":"semetey-1-2013:p0244:b004:l026","ordinal":95577,"en":"And almost braided it."},{"id":"semetey-1-2013:p0244:b004:l027","ordinal":95578,"en":"Blood flowed from both cheeks;"},{"id":"semetey-1-2013:p0244:b004:l028","ordinal":95579,"en":"Your sister-in-law's strength ebbed away,"},{"id":"semetey-1-2013:p0244:b004:l029","ordinal":95580,"en":"And she almost died."},{"id":"semetey-1-2013:p0244:b004:l030","ordinal":95581,"en":"Akborchuk continued pacing;"},{"id":"semetey-1-2013:p0244:b004:l031","ordinal":95582,"en":"From Akborchuk's mane,"},{"id":"semetey-1-2013:p0244:b004:l032","ordinal":95583,"en":"Bloody tears mixed with blood"},{"id":"semetey-1-2013:p0244:b004:l033","ordinal":95584,"en":"Streamed down in rivulets."},{"id":"semetey-1-2013:p0244:b004:l034","ordinal":95585,"en":"Unable to collect herself,"},{"id":"semetey-1-2013:p0244:b004:l035","ordinal":95586,"en":"Hoarse with weeping, crying out,"},{"id":"semetey-1-2013:p0244:b004:l036","ordinal":95587,"en":"Manas, gone to the other world—"},{"id":"semetey-1-2013:p0244:b004:l037","ordinal":95588,"en":"She implored his spirit"},{"id":"semetey-1-2013:p0244:b004:l038","ordinal":95589,"en":"And stood wailing and sobbing."},{"id":"semetey-1-2013:p0244:b004:l039","ordinal":95590,"en":"From that ridge shaped like a saddle's waist,"},{"id":"semetey-1-2013:p0245:b003:l001","ordinal":95591,"en":"Unable to find any way out,"},{"id":"semetey-1-2013:p0245:b003:l002","ordinal":95592,"en":"She turned its little wheel,"},{"id":"semetey-1-2013:p0245:b003:l003","ordinal":95593,"en":"Manas's very telescope—"},{"id":"semetey-1-2013:p0245:b003:l004","ordinal":95594,"en":"And set it firmly to her eye."},{"id":"semetey-1-2013:p0245:b003:l005","ordinal":95595,"en":"Her dear eyes like blackcurrants,"},{"id":"semetey-1-2013:p0245:b003:l006","ordinal":95596,"en":"She turned and wiped them now."},{"id":"semetey-1-2013:p0245:b003:l007","ordinal":95597,"en":"There were no Kyrgyz to support her."},{"id":"semetey-1-2013:p0245:b003:l008","ordinal":95598,"en":"Then your mother Kanykei"},{"id":"semetey-1-2013:p0245:b003:l009","ordinal":95599,"en":"Summoned her courage."},{"id":"semetey-1-2013:p0245:b003:l010","ordinal":95600,"en":"Drawing the telescope back,"},{"id":"semetey-1-2013:p0245:b003:l011","ordinal":95601,"en":"She set it to her dear eye."},{"id":"semetey-1-2013:p0245:b003:l012","ordinal":95602,"en":"She turned her noble steed's head."},{"id":"semetey-1-2013:p0245:b003:l013","ordinal":95603,"en":"Your sister-in-law could not stop weeping;"},{"id":"semetey-1-2013:p0245:b003:l014","ordinal":95604,"en":"She aimed the telescope at the horses"},{"id":"semetey-1-2013:p0245:b003:l015","ordinal":95605,"en":"And looked carefully."},{"id":"semetey-1-2013:p0245:b003:l016","ordinal":95606,"en":"At the mouth of the broad, jutting mountain,"},{"id":"semetey-1-2013:p0245:b003:l017","ordinal":95607,"en":"On the ridge of the broad pass,"},{"id":"semetey-1-2013:p0245:b003:l018","ordinal":95608,"en":"Taytoru was coming,"},{"id":"semetey-1-2013:p0245:b003:l019","ordinal":95609,"en":"Behind six racers."},{"id":"semetey-1-2013:p0245:b003:l020","ordinal":95610,"en":"The wind could not match his gallop;"},{"id":"semetey-1-2013:p0245:b003:l021","ordinal":95611,"en":"He ran at full speed."},{"id":"semetey-1-2013:p0245:b003:l022","ordinal":95612,"en":"No other horse could match his stride;"},{"id":"semetey-1-2013:p0245:b003:l023","ordinal":95613,"en":"He ran as something apart."},{"id":"semetey-1-2013:p0245:b003:l024","ordinal":95614,"en":"When she saw Taytoru,"},{"id":"semetey-1-2013:p0245:b003:l025","ordinal":95615,"en":"That poor woman who had suffered hardship,"},{"id":"semetey-1-2013:p0245:b003:l026","ordinal":95616,"en":"Your mourning sister-in-law Kanykei,"},{"id":"semetey-1-2013:p0245:b003:l027","ordinal":95617,"en":"Unable to stand there grieving,"},{"id":"semetey-1-2013:p0245:b003:l028","ordinal":95618,"en":"Now took her chance."},{"id":"semetey-1-2013:p0245:b003:l029","ordinal":95619,"en":"Firmly girding herself for hell,"},{"id":"semetey-1-2013:p0245:b003:l030","ordinal":95620,"en":"She could not keep still."},{"id":"semetey-1-2013:p0245:b003:l031","ordinal":95621,"en":"\"The command Allah has sent—"},{"id":"semetey-1-2013:p0245:b003:l032","ordinal":95622,"en":"Let me see it as it is."},{"id":"semetey-1-2013:p0245:b003:l033","ordinal":95623,"en":"This true racer of the unseen world,"},{"id":"semetey-1-2013:p0245:b003:l034","ordinal":95624,"en":"Let me urge him on still harder."},{"id":"semetey-1-2013:p0245:b003:l035","ordinal":95625,"en":"My father Temir Khan's Aktulpar"},{"id":"semetey-1-2013:p0245:b003:l036","ordinal":95626,"en":"Was a swift horse by nature."},{"id":"semetey-1-2013:p0245:b003:l037","ordinal":95627,"en":"A Karabair warhorse,"},{"id":"semetey-1-2013:p0245:b003:l038","ordinal":95628,"en":"With sieve-like lungs and copper forelegs,"},{"id":"semetey-1-2013:p0245:b003:l039","ordinal":95629,"en":"He was a creature with wings."},{"id":"semetey-1-2013:p0245:b004:l001","ordinal":95630,"en":"To the prize in this race,"},{"id":"semetey-1-2013:p0245:b004:l002","ordinal":95631,"en":"Will he run without letting anyone catch him?"},{"id":"semetey-1-2013:p0245:b004:l003","ordinal":95632,"en":"Of this Bukhara here,"},{"id":"semetey-1-2013:p0245:b004:l004","ordinal":95633,"en":"Will he win the first prize?"},{"id":"semetey-1-2013:p0245:b004:l005","ordinal":95634,"en":"Will Taytoru die a worthless death"},{"id":"semetey-1-2013:p0245:b004:l006","ordinal":95635,"en":"And finish behind another?"},{"id":"semetey-1-2013:p0245:b004:l007","ordinal":95636,"en":"'Though a woman, she ruined the nation—"},{"id":"semetey-1-2013:p0245:b004:l008","ordinal":95637,"en":"The shameless one's horse!' they may say."},{"id":"semetey-1-2013:p0245:b004:l009","ordinal":95638,"en":"Will the people gather"},{"id":"semetey-1-2013:p0245:b004:l010","ordinal":95639,"en":"And put me to shame?"},{"id":"semetey-1-2013:p0245:b004:l011","ordinal":95640,"en":"Will God dig my pit?"},{"id":"semetey-1-2013:p0245:b004:l012","ordinal":95641,"en":"Will the one God make boil"},{"id":"semetey-1-2013:p0245:b004:l013","ordinal":95642,"en":"My misfortune that has gone so far?"},{"id":"semetey-1-2013:p0245:b004:l014","ordinal":95643,"en":"Will the one God show me"},{"id":"semetey-1-2013:p0245:b004:l015","ordinal":95644,"en":"A wonder no mortal could endure?"},{"id":"semetey-1-2013:p0245:b004:l016","ordinal":95645,"en":"From that ridge shaped like a saddle's waist,"},{"id":"semetey-1-2013:p0245:b004:l017","ordinal":95646,"en":"When he comes down the slope,"},{"id":"semetey-1-2013:p0245:b004:l018","ordinal":95647,"en":"For a racer like Taytoru,"},{"id":"semetey-1-2013:p0245:b004:l019","ordinal":95648,"en":"Let me raise a cry of encouragement."},{"id":"semetey-1-2013:p0245:b004:l020","ordinal":95649,"en":"Crying out, let me take the lead rope;"},{"id":"semetey-1-2013:p0245:b004:l021","ordinal":95650,"en":"Let me open my mouth like a gaping maw."},{"id":"semetey-1-2013:p0245:b004:l022","ordinal":95651,"en":"The mallet-like flesh of my white breasts,"},{"id":"semetey-1-2013:p0245:b004:l023","ordinal":95652,"en":"Let me bring down and press."},{"id":"semetey-1-2013:p0245:b004:l024","ordinal":95653,"en":"Let me urge my Taytoru on."},{"id":"semetey-1-2013:p0245:b004:l025","ordinal":95654,"en":"If Tory does not win here,"},{"id":"semetey-1-2013:p0245:b004:l026","ordinal":95655,"en":"Let me die before my appointed death."},{"id":"semetey-1-2013:p0245:b004:l027","ordinal":95656,"en":"The measured weapon, Aktinte,"},{"id":"semetey-1-2013:p0245:b004:l028","ordinal":95657,"en":"Let me draw from its sheath."},{"id":"semetey-1-2013:p0245:b004:l029","ordinal":95658,"en":"Rather than hear, 'That damned woman,'"},{"id":"semetey-1-2013:p0245:b004:l030","ordinal":95659,"en":"And become gossip among the sovereign's people,"},{"id":"semetey-1-2013:p0245:b004:l031","ordinal":95660,"en":"This life of mine here,"},{"id":"semetey-1-2013:p0245:b004:l032","ordinal":95661,"en":"Let me offer as a sacrifice.\""},{"id":"semetey-1-2013:p0245:b004:l033","ordinal":95662,"en":"So spoke your sister-in-law"},{"id":"semetey-1-2013:p0245:b004:l034","ordinal":95663,"en":"And summoned her courage."},{"id":"semetey-1-2013:p0245:b004:l035","ordinal":95664,"en":"Yesterday, when valiant Manas died,"},{"id":"semetey-1-2013:p0245:b004:l036","ordinal":95665,"en":"When your mother suffered anguish,"},{"id":"semetey-1-2013:p0245:b004:l037","ordinal":95666,"en":"The base dogs whose hearts had turned wicked,"},{"id":"semetey-1-2013:p0245:b004:l038","ordinal":95667,"en":"The countless riches left by the warrior—"},{"id":"semetey-1-2013:p0245:b004:l039","ordinal":95668,"en":"When they divided them every which way,"},{"id":"semetey-1-2013:p0246:b003:l001","ordinal":95669,"en":"Your valiant mother Kanykei,"},{"id":"semetey-1-2013:p0246:b003:l002","ordinal":95670,"en":"When she suffered such anguish,"},{"id":"semetey-1-2013:p0246:b003:l003","ordinal":95671,"en":"When her leopard died,"},{"id":"semetey-1-2013:p0246:b003:l004","ordinal":95672,"en":"Those accursed fools"},{"id":"semetey-1-2013:p0246:b003:l005","ordinal":95673,"en":"Drew their bows like rain,"},{"id":"semetey-1-2013:p0246:b003:l006","ordinal":95674,"en":"Fired their shots like hail."},{"id":"semetey-1-2013:p0246:b003:l007","ordinal":95675,"en":"The countless riches left by the lion,"},{"id":"semetey-1-2013:p0246:b003:l008","ordinal":95676,"en":"Those foolish dogs divided."},{"id":"semetey-1-2013:p0246:b003:l009","ordinal":95677,"en":"Countless humiliations—"},{"id":"semetey-1-2013:p0246:b003:l010","ordinal":95678,"en":"When your poor mother suffered them,"},{"id":"semetey-1-2013:p0246:b003:l011","ordinal":95679,"en":"She firmly devised her plan."},{"id":"semetey-1-2013:p0246:b003:l012","ordinal":95680,"en":"\"You will not marry me?\" he said, dragging her;"},{"id":"semetey-1-2013:p0246:b003:l013","ordinal":95681,"en":"When he struck and split her breast,"},{"id":"semetey-1-2013:p0246:b003:l014","ordinal":95682,"en":"Your noble mother Kanykei"},{"id":"semetey-1-2013:p0246:b003:l015","ordinal":95683,"en":"Merciless terror"},{"id":"semetey-1-2013:p0246:b003:l016","ordinal":95684,"en":"Did indeed inflict."},{"id":"semetey-1-2013:p0246:b003:l017","ordinal":95685,"en":"Unable to find Manas's Akkelte,"},{"id":"semetey-1-2013:p0246:b003:l018","ordinal":95686,"en":"Almambet's Syrbarang,"},{"id":"semetey-1-2013:p0246:b003:l019","ordinal":95687,"en":"Leaning upon it as a staff,"},{"id":"semetey-1-2013:p0246:b003:l020","ordinal":95688,"en":"Your noble mother Kanykei"},{"id":"semetey-1-2013:p0246:b003:l021","ordinal":95689,"en":"Had brought along!"},{"id":"semetey-1-2013:p0246:b003:l022","ordinal":95690,"en":"Left behind then,"},{"id":"semetey-1-2013:p0246:b003:l023","ordinal":95691,"en":"Bereft of her fierce warrior,"},{"id":"semetey-1-2013:p0246:b003:l024","ordinal":95692,"en":"At the age of thirty-two,"},{"id":"semetey-1-2013:p0246:b003:l025","ordinal":95693,"en":"The five who faced her"},{"id":"semetey-1-2013:p0246:b003:l026","ordinal":95694,"en":"She had indeed slain."},{"id":"semetey-1-2013:p0246:b003:l027","ordinal":95695,"en":"Long-suffering Kanykei,"},{"id":"semetey-1-2013:p0246:b003:l028","ordinal":95696,"en":"\"I shall keep it as a keepsake,\" she said."},{"id":"semetey-1-2013:p0246:b003:l029","ordinal":95697,"en":"Almambet's Syrbarang—"},{"id":"semetey-1-2013:p0246:b003:l030","ordinal":95698,"en":"Your sister-in-law deliberately"},{"id":"semetey-1-2013:p0246:b003:l031","ordinal":95699,"en":"Had brought it along!"},{"id":"semetey-1-2013:p0246:b003:l032","ordinal":95700,"en":"When slung across the back, Syrbarang"},{"id":"semetey-1-2013:p0246:b003:l033","ordinal":95701,"en":"Was the mirror of the shoulder blades."},{"id":"semetey-1-2013:p0246:b003:l034","ordinal":95702,"en":"When going out to exchange fire with the foe,"},{"id":"semetey-1-2013:p0246:b003:l035","ordinal":95703,"en":"It was the comfort of a life held in trust."},{"id":"semetey-1-2013:p0246:b003:l036","ordinal":95704,"en":"The thick-mouthed Apple-Head,"},{"id":"semetey-1-2013:p0246:b003:l037","ordinal":95705,"en":"Made no distinction between near and far;"},{"id":"semetey-1-2013:p0246:b003:l038","ordinal":95706,"en":"It grew stronger with every shot."},{"id":"semetey-1-2013:p0246:b003:l039","ordinal":95707,"en":"The invading enemy fled hard,"},{"id":"semetey-1-2013:p0246:b004:l001","ordinal":95708,"en":"Yet never left it unchallenged."},{"id":"semetey-1-2013:p0246:b004:l002","ordinal":95709,"en":"It made no distinction between near and far."},{"id":"semetey-1-2013:p0246:b004:l003","ordinal":95710,"en":"When the true exchange of fire began,"},{"id":"semetey-1-2013:p0246:b004:l004","ordinal":95711,"en":"No enemy remained without fleeing."},{"id":"semetey-1-2013:p0246:b004:l005","ordinal":95712,"en":"Leaning to the right, he fired once"},{"id":"semetey-1-2013:p0246:b004:l006","ordinal":95713,"en":"And felled the one he aimed at."},{"id":"semetey-1-2013:p0246:b004:l007","ordinal":95714,"en":"Beaded hat-buttons and coral stones,"},{"id":"semetey-1-2013:p0246:b004:l008","ordinal":95715,"en":"With the lungtung khan among them,"},{"id":"semetey-1-2013:p0246:b004:l009","ordinal":95716,"en":"Making his golden throne greasy,"},{"id":"semetey-1-2013:p0246:b004:l010","ordinal":95717,"en":"Dear Almambet, beginning with his father,"},{"id":"semetey-1-2013:p0246:b004:l011","ordinal":95718,"en":"Slew six hundred."},{"id":"semetey-1-2013:p0246:b004:l012","ordinal":95719,"en":"Dear Almambet fled Beijing;"},{"id":"semetey-1-2013:p0246:b004:l013","ordinal":95720,"en":"Heaps of treasure, countless gold,"},{"id":"semetey-1-2013:p0246:b004:l014","ordinal":95721,"en":"Your Almambet scattered as he fled."},{"id":"semetey-1-2013:p0246:b004:l015","ordinal":95722,"en":"Fighting ninety days without rest,"},{"id":"semetey-1-2013:p0246:b004:l016","ordinal":95723,"en":"When your Almambet escaped,"},{"id":"semetey-1-2013:p0246:b004:l017","ordinal":95724,"en":"Growing stronger when brought into a firefight,"},{"id":"semetey-1-2013:p0246:b004:l018","ordinal":95725,"en":"Almambet's Syrbarang"},{"id":"semetey-1-2013:p0246:b004:l019","ordinal":95726,"en":"Was the lock that guarded a life held in trust."},{"id":"semetey-1-2013:p0246:b004:l020","ordinal":95727,"en":"Upon Beijing, dear Almambet,"},{"id":"semetey-1-2013:p0246:b004:l021","ordinal":95728,"en":"Terror such as no one had seen,"},{"id":"semetey-1-2013:p0246:b004:l022","ordinal":95729,"en":"Had indeed brought down then."},{"id":"semetey-1-2013:p0246:b004:l023","ordinal":95730,"en":"The wondrous incantation,"},{"id":"semetey-1-2013:p0246:b004:l024","ordinal":95731,"en":"As your Almambet recited it,"},{"id":"semetey-1-2013:p0246:b004:l025","ordinal":95732,"en":"Karykan, khan of Kakan,"},{"id":"semetey-1-2013:p0246:b004:l026","ordinal":95733,"en":"Came in alarm."},{"id":"semetey-1-2013:p0246:b004:l027","ordinal":95734,"en":"Two reins and one lead rope,"},{"id":"semetey-1-2013:p0246:b004:l028","ordinal":95735,"en":"When he managed to take them in hand,"},{"id":"semetey-1-2013:p0246:b004:l029","ordinal":95736,"en":"\"I too am a khan's son,\" he said."},{"id":"semetey-1-2013:p0246:b004:l030","ordinal":95737,"en":"In the Kakan khan's Beijing,"},{"id":"semetey-1-2013:p0246:b004:l031","ordinal":95738,"en":"When he wrought a terrible slaughter,"},{"id":"semetey-1-2013:p0246:b004:l032","ordinal":95739,"en":"Contending for the khanship,"},{"id":"semetey-1-2013:p0246:b004:l033","ordinal":95740,"en":"The Chinese who worshipped stone,"},{"id":"semetey-1-2013:p0246:b004:l034","ordinal":95741,"en":"When he slew them utterly,"},{"id":"semetey-1-2013:p0246:b004:l035","ordinal":95742,"en":"The Chinese in sleeveless coats,"},{"id":"semetey-1-2013:p0246:b004:l036","ordinal":95743,"en":"Fighting the strongest among them,"},{"id":"semetey-1-2013:p0246:b004:l037","ordinal":95744,"en":"When dear Almambet was in Beijing,"}]
