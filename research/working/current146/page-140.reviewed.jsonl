{"id": "sayakbay-ms-current146:pdf140:l001", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 1, "raw": "Байла улукман дөөсүн,", "text": "Байла улукман дөөсүн,", "en": "Bind their great, hulking champion,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Manuscript cursive or lexical variant differs from, or is less certain than, the secure printed sequence; reading is provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l002", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 2, "raw": "Чыгаргыла бу журттун,", "text": "Чыгаргыла бу журттун,", "en": "Exact from these people,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l003", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 3, "raw": "Качанкы кеткен кээсин!", "text": "Качанкы кеткен кээсин!", "en": "The ancient grudge long left unpaid!", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l004", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 4, "raw": "Кол кайтарса кокуздан,", "text": "Кол кайтарса кокуздан,", "en": "If they resist with insolence,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Manuscript cursive or lexical variant differs from, or is less certain than, the secure printed sequence; reading is provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l005", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 5, "raw": "Жаңжалдашса окуздан,", "text": "Жаңжалдашса окуздан,", "en": "If they start a quarrel like oxen,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Manuscript cursive or lexical variant differs from, or is less certain than, the secure printed sequence; reading is provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 6, "raw": "Жайната мушта мээсин.", "text": "Жайната мушта мээсин.", "en": "Beat their brains to pulp.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 7, "raw": "Жаңжалдашып минткиле,", "text": "Жаңжалдашып минткиле,", "en": "Do this as you wage the quarrel,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 8, "raw": "Чамасы канча журт экен,", "text": "Чамасы канча журт экен,", "en": "See how numerous these people are,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 9, "raw": "Бир бокчосун тинткиле.", "text": "Бир бокчосун тинткиле.", "en": "Search every one of their bundles.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 10, "raw": "Канын карап кылгыла,", "text": "Канын карап кылгыла,", "en": "Act according to their khan,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Manuscript cursive or lexical variant differs from, or is less certain than, the secure printed sequence; reading is provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 11, "raw": "Калтырбай калкын кыргыла,", "text": "Калтырбай калкын кыргыла,", "en": "Slaughter their people without leaving one behind,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 12, "raw": "Ажарлуусун сөккүлө,", "text": "Ажарлуусун сөккүлө,", "en": "Revile those of beautiful appearance,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l013", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 13, "raw": "Абийирин күлдөй төккүлө,", "text": "Абийирин күлдөй төккүлө,", "en": "Scatter their honor like ashes,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 14, "raw": "Кармашты катуу салгыла,", "text": "Кармашты катуу салгыла,", "en": "Press the battle fiercely,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 15, "raw": "Качанкы кекти алгыла!", "text": "Качанкы кекти алгыла!", "en": "Take vengeance for the ancient grudge!", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 16, "raw": "Өзү чулдур тилинде,", "text": "Өзү чулдур тилинде,", "en": "Their own speech is halting,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 17, "raw": "Бизге душман зилинде,", "text": "Бизге душман зилинде,", "en": "Their very nature is hostile to us,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 18, "raw": "Башы кара, буту айры,", "text": "Башы кара, буту айры,", "en": "Black-headed and cloven-footed,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 19, "raw": "Малга катар жаманын,", "text": "Малга катар жаманын,", "en": "Count their wretches among the livestock,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 20, "raw": "Басмырлап кул кылгыла,", "text": "Басмырлап кул кылгыла,", "en": "Humiliate them and make them slaves,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 21, "raw": "Кайыр берчү баатырын,", "text": "Кайыр берчү баатырын,", "en": "As for their champions who would strike back,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 22, "raw": "Калтырбай бирин кыргыла.", "text": "Калтырбай бирин кыргыла.", "en": "Kill every one without exception.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 23, "raw": "Болжоп жаңжал салгыла,", "text": "Болжоп жаңжал салгыла,", "en": "Deliberately stir up conflict,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l024", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 24, "raw": "Бооз катынды жаргыла,", "text": "Бооз катынды жаргыла,", "en": "Cut open the pregnant women,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 25, "raw": "Түтүнү жок күйгүзүп,", "text": "Түтүнү жок күйгүзүп,", "en": "Burn them until no hearth-smoke remains,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 26, "raw": "Тукумсуз кылып сойгула,", "text": "Тукумсуз кылып сойгула,", "en": "Slaughter them and leave no descendants,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 27, "raw": "Туураланган баатырын,", "text": "Туураланган баатырын,", "en": "Their chosen champions,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 28, "raw": "Кайрадан көзүн ойгула!", "text": "Кайрадан көзүн ойгула!", "en": "Gouge out their eyes in turn!", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Manuscript cursive or lexical variant differs from, or is less certain than, the secure printed sequence; reading is provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 29, "raw": "Эсебин эптеп тапкыла,", "text": "Эсебин эптеп тапкыла,", "en": "Find and settle their account by any means,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 30, "raw": "Эзелки шайтан чоң жинин,", "text": "Эзелки шайтан чоң жинин,", "en": "The great demonic fury of old,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 31, "raw": "Эс кетире каккыла!", "text": "Эс кетире каккыла!", "en": "Beat it out of them until they lose their senses!", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 32, "raw": "Кайраттуусун бөлгүлө,", "text": "Кайраттуусун бөлгүлө,", "en": "Separate out the courageous ones,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 33, "raw": "Казына мүлкүн көргүлө,", "text": "Казына мүлкүн көргүлө,", "en": "Inspect their treasury and property,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf140:l034", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 140, "folio": 523, "line_in_page": 34, "raw": "Бокчо, куржун таңгыла.", "text": "Бокчо, куржун таңгыла.", "en": "Tie up their bundles and saddlebags.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Manuscript cursive or lexical variant differs from, or is less certain than, the secure printed sequence; reading is provisional.", "bbox": null}
