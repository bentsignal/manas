[{"id":"manas-2010:p1288:b001:l013","ordinal":55809,"en":"The black-jawed steel blade—"},{"id":"manas-2010:p1288:b001:l014","ordinal":55810,"en":"Who will fit it without bending it back?"},{"id":"manas-2010:p1288:b001:l015","ordinal":55811,"en":"My sacred, beloved people—"},{"id":"manas-2010:p1288:b001:l016","ordinal":55812,"en":"Who will lead them without putting them to flight?”"},{"id":"manas-2010:p1288:b001:l017","ordinal":55813,"en":"Thus hero Manas spoke,"},{"id":"manas-2010:p1288:b001:l018","ordinal":55814,"en":"Biting into his lip,"},{"id":"manas-2010:p1288:b001:l019","ordinal":55815,"en":"Fire flaring from both eyes,"},{"id":"manas-2010:p1288:b001:l020","ordinal":55816,"en":"Bristling like a dragon."},{"id":"manas-2010:p1288:b001:l021","ordinal":55817,"en":"He headed toward Tal-Choku,"},{"id":"manas-2010:p1288:b001:l022","ordinal":55818,"en":"Bearing his saddle on his back."},{"id":"manas-2010:p1288:b001:l023","ordinal":55819,"en":"Ever since he had been hero Manas,"},{"id":"manas-2010:p1288:b001:l024","ordinal":55820,"en":"From childhood he had never panicked."},{"id":"manas-2010:p1288:b001:l025","ordinal":55821,"en":"With such a day fallen upon him,"},{"id":"manas-2010:p1288:b001:l026","ordinal":55822,"en":"Deprived of the horse he rode,"},{"id":"manas-2010:p1288:b001:l027","ordinal":55823,"en":"He had never walked on foot like this."},{"id":"manas-2010:p1288:b001:l028","ordinal":55824,"en":"Since his birth, hero Manas"},{"id":"manas-2010:p1288:b001:l029","ordinal":55825,"en":"Had never turned his back on an enemy,"},{"id":"manas-2010:p1288:b001:l030","ordinal":55826,"en":"Or fled a foe in fear."},{"id":"manas-2010:p1288:b001:l031","ordinal":55827,"en":"Walking on, lamenting,"},{"id":"manas-2010:p1288:b001:l032","ordinal":55828,"en":"He stopped to think"},{"id":"manas-2010:p1288:b001:l033","ordinal":55829,"en":"And mourned Akkula's absence."},{"id":"manas-2010:p1288:b001:l034","ordinal":55830,"en":"“Curse my foolish life,"},{"id":"manas-2010:p1288:b001:l035","ordinal":55831,"en":"My habit of not heeding words!"},{"id":"manas-2010:p1288:b001:l036","ordinal":55832,"en":"Akkula, left with the baggage train,"},{"id":"manas-2010:p1288:b001:l037","ordinal":55833,"en":"Is always my pair of wings."},{"id":"manas-2010:p1288:b001:l038","ordinal":55834,"en":"When the Chinese come without parley,"},{"id":"manas-2010:p1288:b001:l039","ordinal":55835,"en":"When they press upon me,"},{"id":"manas-2010:p1288:b001:l040","ordinal":55836,"en":"If Akkula were beneath me,"},{"id":"manas-2010:p1288:b001:l041","ordinal":55837,"en":"If my armor Akkolpok were upon me,"},{"id":"manas-2010:p1288:b001:l042","ordinal":55838,"en":"If my musket Akkelte were upon my shoulder,"},{"id":"manas-2010:p1289:b001:l001","ordinal":55839,"en":"Would I not give him his turn?"},{"id":"manas-2010:p1289:b001:l002","ordinal":55840,"en":"That renowned, uncircumcised Fierce One—"},{"id":"manas-2010:p1289:b001:l003","ordinal":55841,"en":"Would I not find a way to deal with him?”"},{"id":"manas-2010:p1289:b001:l004","ordinal":55842,"en":"Saying this, hero Manas"},{"id":"manas-2010:p1289:b001:l005","ordinal":55843,"en":"Walked farther uphill."},{"id":"manas-2010:p1289:b001:l006","ordinal":55844,"en":"When Manas was left on foot,"},{"id":"manas-2010:p1289:b001:l007","ordinal":55845,"en":"The Chinese swept up to them,"},{"id":"manas-2010:p1289:b001:l008","ordinal":55846,"en":"Taking the four heroes in their midst,"},{"id":"manas-2010:p1289:b001:l009","ordinal":55847,"en":"Surrounding them twelvefold."},{"id":"manas-2010:p1289:b001:l010","ordinal":55848,"en":"When the infidels brought destruction,"},{"id":"manas-2010:p1289:b001:l011","ordinal":55849,"en":"From among the infidels,"},{"id":"manas-2010:p1289:b001:l012","ordinal":55850,"en":"A champion of swift foot-runners,"},{"id":"manas-2010:p1289:b001:l013","ordinal":55851,"en":"A Chinese giant named Mady,"},{"id":"manas-2010:p1289:b001:l014","ordinal":55852,"en":"Cried “On!” and headed for Manas."},{"id":"manas-2010:p1289:b001:l015","ordinal":55853,"en":"At that moment Kongurbay"},{"id":"manas-2010:p1289:b001:l016","ordinal":55854,"en":"Said, “Seize him by the hem!"},{"id":"manas-2010:p1289:b001:l017","ordinal":55855,"en":"This way, Manas—"},{"id":"manas-2010:p1289:b001:l018","ordinal":55856,"en":"Hurl him over here!”"},{"id":"manas-2010:p1289:b001:l019","ordinal":55857,"en":"The swine stood shouting."},{"id":"manas-2010:p1289:b001:l020","ordinal":55858,"en":"When he heard Kongurbay's words,"},{"id":"manas-2010:p1289:b001:l021","ordinal":55859,"en":"Mady ran up."},{"id":"manas-2010:p1289:b001:l022","ordinal":55860,"en":"Black night had fallen upon them;"},{"id":"manas-2010:p1289:b001:l023","ordinal":55861,"en":"Their sovereign Manas—"},{"id":"manas-2010:p1289:b001:l024","ordinal":55862,"en":"When Mady came close,"},{"id":"manas-2010:p1289:b001:l025","ordinal":55863,"en":"Almambet and Syrgak, the two lions,"},{"id":"manas-2010:p1289:b001:l026","ordinal":55864,"en":"At that moment, of Manas"},{"id":"manas-2010:p1289:b001:l027","ordinal":55865,"en":"Truly despaired."},{"id":"manas-2010:p1289:b001:l028","ordinal":55866,"en":"Their many worries could not fit in their breasts."},{"id":"manas-2010:p1289:b001:l029","ordinal":55867,"en":"Chubak, who stood watching,"},{"id":"manas-2010:p1289:b001:l030","ordinal":55868,"en":"Wept tears in ten streams."},{"id":"manas-2010:p1289:b001:l031","ordinal":55869,"en":"Azizkhan's Almambet"},{"id":"manas-2010:p1289:b001:l032","ordinal":55870,"en":"Could find no way to act."},{"id":"manas-2010:p1289:b001:l033","ordinal":55871,"en":"When the champion ran forward,"},{"id":"manas-2010:p1289:b001:l034","ordinal":55872,"en":"Syrgak, son of Ulak Khan,"},{"id":"manas-2010:p1289:b001:l035","ordinal":55873,"en":"For his nest-mate Manas"},{"id":"manas-2010:p1289:b001:l036","ordinal":55874,"en":"Could devise no help at all."},{"id":"manas-2010:p1289:b001:l037","ordinal":55875,"en":"As Mady was about to reach him,"},{"id":"manas-2010:p1289:b001:l038","ordinal":55876,"en":"As he was about to seize the lowest hem,"},{"id":"manas-2010:p1289:b001:l039","ordinal":55877,"en":"Downward, Manas—"},{"id":"manas-2010:p1289:b001:l040","ordinal":55878,"en":"Just as he was about to fling him,"},{"id":"manas-2010:p1289:b001:l041","ordinal":55879,"en":"Everything favored him:"},{"id":"manas-2010:p1289:b001:l042","ordinal":55880,"en":"Manas was indeed a mighty lion,"},{"id":"manas-2010:p1290:b001:l001","ordinal":55881,"en":"A black-eared lion indeed."},{"id":"manas-2010:p1290:b001:l002","ordinal":55882,"en":"(A tale of sorrow for the listener.)"},{"id":"manas-2010:p1290:b001:l003","ordinal":55883,"en":"A battle-axe with a steel point"},{"id":"manas-2010:p1290:b001:l004","ordinal":55884,"en":"Was in his right hand."},{"id":"manas-2010:p1290:b001:l005","ordinal":55885,"en":"Readying the battle-axe,"},{"id":"manas-2010:p1290:b001:l006","ordinal":55886,"en":"He gripped it and swung it around."},{"id":"manas-2010:p1290:b001:l007","ordinal":55887,"en":"Without sparing himself, hero Manas"},{"id":"manas-2010:p1290:b001:l008","ordinal":55888,"en":"Exerted all his strength."},{"id":"manas-2010:p1290:b001:l009","ordinal":55889,"en":"When he struck with the battle-axe,"},{"id":"manas-2010:p1290:b001:l010","ordinal":55890,"en":"Mady, who had come boasting of his might,"},{"id":"manas-2010:p1290:b001:l011","ordinal":55891,"en":"Lost his head in a burst;"},{"id":"manas-2010:p1290:b001:l012","ordinal":55892,"en":"His life departed with a scream."},{"id":"manas-2010:p1290:b001:l013","ordinal":55893,"en":"Downward, great Mady"},{"id":"manas-2010:p1290:b001:l014","ordinal":55894,"en":"Came tumbling in a rush."},{"id":"manas-2010:p1290:b001:l015","ordinal":55895,"en":"To Mady as he fell,"},{"id":"manas-2010:p1290:b001:l016","ordinal":55896,"en":"Young Syrgak rushed."},{"id":"manas-2010:p1290:b001:l017","ordinal":55897,"en":"The moment hero Syrgak reached him,"},{"id":"manas-2010:p1290:b001:l018","ordinal":55898,"en":"His belly as broad as a door"},{"id":"manas-2010:p1290:b001:l019","ordinal":55899,"en":"He slashed open again and again as he passed."},{"id":"manas-2010:p1290:b001:l020","ordinal":55900,"en":"After Mady had died,"},{"id":"manas-2010:p1290:b001:l021","ordinal":55901,"en":"All the Chinese together,"},{"id":"manas-2010:p1290:b001:l022","ordinal":55902,"en":"Their young and their old,"},{"id":"manas-2010:p1290:b001:l023","ordinal":55903,"en":"Joined in the battle."},{"id":"manas-2010:p1290:b001:l024","ordinal":55904,"en":"Almambet, Chubak and hero Syrgak,"},{"id":"manas-2010:p1290:b001:l025","ordinal":55905,"en":"Again not sparing their lives,"},{"id":"manas-2010:p1290:b001:l026","ordinal":55906,"en":"Fought a fierce battle."},{"id":"manas-2010:p1290:b001:l027","ordinal":55907,"en":"“The Chinese, fierce in their faith—"},{"id":"manas-2010:p1290:b001:l028","ordinal":55908,"en":"How can we submit to their force?"},{"id":"manas-2010:p1290:b001:l029","ordinal":55909,"en":"While watching our fierce-maned lord,"},{"id":"manas-2010:p1290:b001:l030","ordinal":55910,"en":"How can we surrender him alive?"},{"id":"manas-2010:p1290:b001:l031","ordinal":55911,"en":"We shall die before Manas"},{"id":"manas-2010:p1290:b001:l032","ordinal":55912,"en":"And go as sacrifices!”"},{"id":"manas-2010:p1290:b001:l033","ordinal":55913,"en":"So the three champions"},{"id":"manas-2010:p1290:b001:l034","ordinal":55914,"en":"Gripped their lances and swung them."},{"id":"manas-2010:p1290:b001:l035","ordinal":55915,"en":"“Fight without sparing yourself,” they said,"},{"id":"manas-2010:p1290:b001:l036","ordinal":55916,"en":"And sent Khan Chubak forth."},{"id":"manas-2010:p1290:b001:l037","ordinal":55917,"en":"(Ah, Akbaltay's Chubak!"},{"id":"manas-2010:p1290:b001:l038","ordinal":55918,"en":"Who made the whole world cry out,"},{"id":"manas-2010:p1290:b001:l039","ordinal":55919,"en":"His precious fierce-maned darling!)"},{"id":"manas-2010:p1290:b001:l040","ordinal":55920,"en":"No man's strength could overcome him in combat;"},{"id":"manas-2010:p1290:b001:l041","ordinal":55921,"en":"A lion's teeth could not pierce him."},{"id":"manas-2010:p1290:b001:l042","ordinal":55922,"en":"Fearing and shrinking from the countless troops,"},{"id":"manas-2010:p1291:b001:l001","ordinal":55923,"en":"He had never fled backward."},{"id":"manas-2010:p1291:b001:l002","ordinal":55924,"en":"A fire unlike other men,"},{"id":"manas-2010:p1291:b001:l003","ordinal":55925,"en":"When sent forward, equal to countless troops,"},{"id":"manas-2010:p1291:b001:l004","ordinal":55926,"en":"Fortunate on a distant journey,"},{"id":"manas-2010:p1291:b001:l005","ordinal":55927,"en":"Broad-shouldered, stooping as he came—"},{"id":"manas-2010:p1291:b001:l006","ordinal":55928,"en":"Surely you have heard of him,"},{"id":"manas-2010:p1291:b001:l007","ordinal":55929,"en":"Chubak, son of Khan Baltay."},{"id":"manas-2010:p1291:b001:l008","ordinal":55930,"en":"Chubak, the fierce-maned champion,"},{"id":"manas-2010:p1291:b001:l009","ordinal":55931,"en":"Now entered the battle."},{"id":"manas-2010:p1291:b001:l010","ordinal":55932,"en":"Six thousand champions, a thousand governors,"},{"id":"manas-2010:p1291:b001:l011","ordinal":55933,"en":"Their renowned Kongurbay,"},{"id":"manas-2010:p1291:b001:l012","ordinal":55934,"en":"Rushed shouting upon him."},{"id":"manas-2010:p1291:b001:l013","ordinal":55935,"en":"Börüköz with a thousand champions"},{"id":"manas-2010:p1291:b001:l014","ordinal":55936,"en":"Came from one side;"},{"id":"manas-2010:p1291:b001:l015","ordinal":55937,"en":"The multitude of the Chinese emperor's people"},{"id":"manas-2010:p1291:b001:l016","ordinal":55938,"en":"All swept upon him."},{"id":"manas-2010:p1291:b001:l017","ordinal":55939,"en":"Fighting for seven days,"},{"id":"manas-2010:p1291:b001:l018","ordinal":55940,"en":"Wounded in seventy places,"},{"id":"manas-2010:p1291:b001:l019","ordinal":55941,"en":"Chubak emerged covered in blood."},{"id":"manas-2010:p1291:b001:l020","ordinal":55942,"en":"His whole body could not stir,"},{"id":"manas-2010:p1291:b001:l021","ordinal":55943,"en":"Numb as though paralyzed."},{"id":"manas-2010:p1291:b001:l022","ordinal":55944,"en":"At that moment, that man of old,"},{"id":"manas-2010:p1291:b001:l023","ordinal":55945,"en":"Who had fled the infidels and become a stranger,"},{"id":"manas-2010:p1291:b001:l024","ordinal":55946,"en":"Who had become pure from the dark faith,"},{"id":"manas-2010:p1291:b001:l025","ordinal":55947,"en":"Who had scattered his gathered wealth,"},{"id":"manas-2010:p1291:b001:l026","ordinal":55948,"en":"Who sought the root of his faith, said:"},{"id":"manas-2010:p1291:b001:l027","ordinal":55949,"en":"“Toward looming Beijing"},{"id":"manas-2010:p1291:b001:l028","ordinal":55950,"en":"Let me level my tasseled lance."},{"id":"manas-2010:p1291:b001:l029","ordinal":55951,"en":"From that accursed hell of torment"},{"id":"manas-2010:p1291:b001:l030","ordinal":55952,"en":"Let me free my soul."},{"id":"manas-2010:p1291:b001:l031","ordinal":55953,"en":"Toward the swarming multitude of Chinese"},{"id":"manas-2010:p1291:b001:l032","ordinal":55954,"en":"Let me extend my lance wide."},{"id":"manas-2010:p1291:b001:l033","ordinal":55955,"en":"When Khan Chubak has returned like this,"},{"id":"manas-2010:p1291:b001:l034","ordinal":55956,"en":"How can I stand here alive?"},{"id":"manas-2010:p1291:b001:l035","ordinal":55957,"en":"If I die, grant me faith;"},{"id":"manas-2010:p1291:b001:l036","ordinal":55958,"en":"You, the one God, support me!”"},{"id":"manas-2010:p1291:b001:l037","ordinal":55959,"en":"Speaking thus, Almambet"},{"id":"manas-2010:p1291:b001:l038","ordinal":55960,"en":"Entered the battle in earnest."},{"id":"manas-2010:p1291:b001:l039","ordinal":55961,"en":"When dear Almambet waged war,"},{"id":"manas-2010:p1291:b001:l040","ordinal":55962,"en":"Look at the ants, look at the insects!"},{"id":"manas-2010:p1291:b001:l041","ordinal":55963,"en":"Look at the people, thick as sand!"},{"id":"manas-2010:p1291:b001:l042","ordinal":55964,"en":"The sky was clear, the earth overcast;"},{"id":"manas-2010:p1292:b001:l001","ordinal":55965,"en":"One could not tell whether it was day,"},{"id":"manas-2010:p1292:b001:l002","ordinal":55966,"en":"Or whether it was night."},{"id":"manas-2010:p1292:b001:l003","ordinal":55967,"en":"Haze settled and dust flew."},{"id":"manas-2010:p1292:b001:l004","ordinal":55968,"en":"Over these Chinese,"},{"id":"manas-2010:p1292:b001:l005","ordinal":55969,"en":"Unable to pass to the other side,"},{"id":"manas-2010:p1292:b001:l006","ordinal":55970,"en":"A winged bird turned and flew back."},{"id":"manas-2010:p1292:b001:l007","ordinal":55971,"en":"That Manas had been left on foot,"},{"id":"manas-2010:p1292:b001:l008","ordinal":55972,"en":"Kongurbay of the Chinese"},{"id":"manas-2010:p1292:b001:l009","ordinal":55973,"en":"To the khan of Innermost Beijing"},{"id":"manas-2010:p1292:b001:l010","ordinal":55974,"en":"Had sent the news."},{"id":"manas-2010:p1292:b001:l011","ordinal":55975,"en":"When they heard this news,"},{"id":"manas-2010:p1292:b001:l012","ordinal":55976,"en":"The Chinese people of forty khans,"},{"id":"manas-2010:p1292:b001:l013","ordinal":55977,"en":"Surging forth, not a soul remaining,"},{"id":"manas-2010:p1292:b001:l014","ordinal":55978,"en":"All rode out."},{"id":"manas-2010:p1292:b001:l015","ordinal":55979,"en":"Yielding to none in the whole wide world,"},{"id":"manas-2010:p1292:b001:l016","ordinal":55980,"en":"Their giants had arrived."},{"id":"manas-2010:p1292:b001:l017","ordinal":55981,"en":"Trained without being mounted on horses,"},{"id":"manas-2010:p1292:b001:l018","ordinal":55982,"en":"Their foot-runners had come."},{"id":"manas-2010:p1292:b001:l019","ordinal":55983,"en":"The countless Chinese of forty khans"},{"id":"manas-2010:p1292:b001:l020","ordinal":55984,"en":"Had all arrived."},{"id":"manas-2010:p1292:b001:l021","ordinal":55985,"en":"With no Muslim people there,"},{"id":"manas-2010:p1292:b001:l022","ordinal":55986,"en":"Upon the four champions"},{"id":"manas-2010:p1292:b001:l023","ordinal":55987,"en":"The infidels brought torment."},{"id":"manas-2010:p1292:b001:l024","ordinal":55988,"en":"A separate company of skilled horsemen"},{"id":"manas-2010:p1292:b001:l025","ordinal":55989,"en":"Came rushing forward."},{"id":"manas-2010:p1292:b001:l026","ordinal":55990,"en":"Seeing this, Almambet"},{"id":"manas-2010:p1292:b001:l027","ordinal":55991,"en":"Despaired of his life."},{"id":"manas-2010:p1292:b001:l028","ordinal":55992,"en":"The reason for his despair:"},{"id":"manas-2010:p1292:b001:l029","ordinal":55993,"en":"He was the poplar of the few Buruts,"},{"id":"manas-2010:p1292:b001:l030","ordinal":55994,"en":"Hero Manas's, since long ago,"},{"id":"manas-2010:p1292:b001:l031","ordinal":55995,"en":"At the people's border, before the foe,"},{"id":"manas-2010:p1292:b001:l032","ordinal":55996,"en":"The support on which he relied."},{"id":"manas-2010:p1292:b001:l033","ordinal":55997,"en":"While Manas was left on foot,"},{"id":"manas-2010:p1292:b001:l034","ordinal":55998,"en":"The shouting Chinese"},{"id":"manas-2010:p1292:b001:l035","ordinal":55999,"en":"Had their chance to seize him."},{"id":"manas-2010:p1292:b001:l036","ordinal":56000,"en":"Becoming a surging black flood,"},{"id":"manas-2010:p1292:b001:l037","ordinal":56001,"en":"A people raising clouds of dust,"},{"id":"manas-2010:p1292:b001:l038","ordinal":56002,"en":"Tal-Choku's high ridge"},{"id":"manas-2010:p1292:b001:l039","ordinal":56003,"en":"They trampled like straw."},{"id":"manas-2010:p1292:b001:l040","ordinal":56004,"en":"Heading straight for Almambet,"},{"id":"manas-2010:p1292:b001:l041","ordinal":56005,"en":"The Chinese, countless as ants,"},{"id":"manas-2010:p1292:b001:l042","ordinal":56006,"en":"Swept over him like a flood."},{"id":"manas-2010:p1293:b001:l001","ordinal":56007,"en":"When the Chinese swept upon him,"},{"id":"manas-2010:p1293:b001:l002","ordinal":56008,"en":"Almambet, the fierce-maned champion,"},{"id":"manas-2010:p1293:b001:l003","ordinal":56009,"en":"Girded with a silver pouch-belt,"},{"id":"manas-2010:p1293:b001:l004","ordinal":56010,"en":"Smiled and stood like a lion,"},{"id":"manas-2010:p1293:b001:l005","ordinal":56011,"en":"Taking no account of the Chinese multitude,"},{"id":"manas-2010:p1293:b001:l006","ordinal":56012,"en":"Light touching his sunlike face."},{"id":"manas-2010:p1293:b001:l007","ordinal":56013,"en":"Girded with a golden pouch-belt,"},{"id":"manas-2010:p1293:b001:l008","ordinal":56014,"en":"Almambet, son of Azizkhan,"},{"id":"manas-2010:p1293:b001:l009","ordinal":56015,"en":"When countless armies swept upon him,"},{"id":"manas-2010:p1293:b001:l010","ordinal":56016,"en":"Did not lose his courage,"},{"id":"manas-2010:p1293:b001:l011","ordinal":56017,"en":"Did not turn and flee in fright."},{"id":"manas-2010:p1293:b001:l012","ordinal":56018,"en":"Light touched his moonlike face."},{"id":"manas-2010:p1293:b001:l013","ordinal":56019,"en":"A true champion, a splendid hero,"},{"id":"manas-2010:p1293:b001:l014","ordinal":56020,"en":"Into the swaying Chinese multitude,"},{"id":"manas-2010:p1293:b001:l015","ordinal":56021,"en":"The fierce-maned lion entered without looking back."},{"id":"manas-2010:p1293:b001:l016","ordinal":56022,"en":"Becoming pure from the dark faith,"},{"id":"manas-2010:p1293:b001:l017","ordinal":56023,"en":"Your Almam had not feared to come."},{"id":"manas-2010:p1293:b001:l018","ordinal":56024,"en":"When the infidels surged forth,"},{"id":"manas-2010:p1293:b001:l019","ordinal":56025,"en":"Sparing his own life,"},{"id":"manas-2010:p1293:b001:l020","ordinal":56026,"en":"Your Almam did not fear death."},{"id":"manas-2010:p1293:b001:l021","ordinal":56027,"en":"Have you heard of it?"},{"id":"manas-2010:p1293:b001:l022","ordinal":56028,"en":"He had stained his golden throne with blood,"},{"id":"manas-2010:p1293:b001:l023","ordinal":56029,"en":"Your Almam had killed his father,"},{"id":"manas-2010:p1293:b001:l024","ordinal":56030,"en":"Had laid Azizkhan low."},{"id":"manas-2010:p1293:b001:l025","ordinal":56031,"en":"The khans who opposed him"},{"id":"manas-2010:p1293:b001:l026","ordinal":56032,"en":"Almambet cut down as he passed."},{"id":"manas-2010:p1293:b001:l027","ordinal":56033,"en":"Shattering those he encountered,"},{"id":"manas-2010:p1293:b001:l028","ordinal":56034,"en":"Almambet mowed them down."},{"id":"manas-2010:p1293:b001:l029","ordinal":56035,"en":"Those who came before him"},{"id":"manas-2010:p1293:b001:l030","ordinal":56036,"en":"Almambet slaughtered."},{"id":"manas-2010:p1293:b001:l031","ordinal":56037,"en":"Whatever he knew how to do in battle,"},{"id":"manas-2010:p1293:b001:l032","ordinal":56038,"en":"Almambet was doing."},{"id":"manas-2010:p1293:b001:l033","ordinal":56039,"en":"Breaking apart every place he charged,"},{"id":"manas-2010:p1293:b001:l034","ordinal":56040,"en":"Carpeting the earth with corpses,"},{"id":"manas-2010:p1293:b001:l035","ordinal":56041,"en":"Almambet kept destroying them."},{"id":"manas-2010:p1293:b001:l036","ordinal":56042,"en":"Almambet's fighting"},{"id":"manas-2010:p1293:b001:l037","ordinal":56043,"en":"Old Zholoy saw."},{"id":"manas-2010:p1293:b001:l038","ordinal":56044,"en":"Without sparing themselves, they swept upon him,"},{"id":"manas-2010:p1293:b001:l039","ordinal":56045,"en":"All the spearmen."},{"id":"manas-2010:p1293:b001:l040","ordinal":56046,"en":"In gravelly sand waist-deep,"},{"id":"manas-2010:p1293:b001:l041","ordinal":56047,"en":"Raising an uproar amid the sand,"},{"id":"manas-2010:p1293:b001:l042","ordinal":56048,"en":"The multitude of Chinese waged war."},{"id":"manas-2010:p1294:b001:l001","ordinal":56049,"en":"The Chinese of every kind"},{"id":"manas-2010:p1294:b001:l002","ordinal":56050,"en":"Stirred from their very depths,"},{"id":"manas-2010:p1294:b001:l003","ordinal":56051,"en":"And all became turmoil and dust."},{"id":"manas-2010:p1294:b001:l004","ordinal":56052,"en":"By command of their khan,"},{"id":"manas-2010:p1294:b001:l005","ordinal":56053,"en":"The famed marksman Karazhoy"},{"id":"manas-2010:p1294:b001:l006","ordinal":56054,"en":"Had also arrived."},{"id":"manas-2010:p1294:b001:l007","ordinal":56055,"en":"He had studied with Almambet himself;"},{"id":"manas-2010:p1294:b001:l008","ordinal":56056,"en":"They had learned their lessons together."},{"id":"manas-2010:p1294:b001:l009","ordinal":56057,"en":"He was a true marksman."},{"id":"manas-2010:p1294:b001:l010","ordinal":56058,"en":"Karazhoy entered without holding back,"},{"id":"manas-2010:p1294:b001:l011","ordinal":56059,"en":"Shooting at Almambet,"},{"id":"manas-2010:p1294:b001:l012","ordinal":56060,"en":"Drawing his bow like falling rain,"},{"id":"manas-2010:p1294:b001:l013","ordinal":56061,"en":"Firing shot like hail."},{"id":"manas-2010:p1294:b001:l014","ordinal":56062,"en":"Fighting among them for nine days,"},{"id":"manas-2010:p1294:b001:l015","ordinal":56063,"en":"Wounded in ninety places,"},{"id":"manas-2010:p1294:b001:l016","ordinal":56064,"en":"Almambet returned exhausted,"}]
