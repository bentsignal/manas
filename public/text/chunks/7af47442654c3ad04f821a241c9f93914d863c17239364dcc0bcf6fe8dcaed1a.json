[{"id":"semetey-1-2013:p1272:b004:l037","ordinal":173313,"en":"The red banner with golden finial"},{"id":"semetey-1-2013:p1272:b004:l038","ordinal":173314,"en":"Appeared from his horde."},{"id":"semetey-1-2013:p1272:b004:l039","ordinal":173315,"en":"Raising a gray-piebald banner,"},{"id":"semetey-1-2013:p1273:b003:l001","ordinal":173316,"en":"Calling the battle cry \"Khan Akun!\""},{"id":"semetey-1-2013:p1273:b003:l002","ordinal":173317,"en":"The karnay blared,"},{"id":"semetey-1-2013:p1273:b003:l003","ordinal":173318,"en":"The brass horn clattered,"},{"id":"semetey-1-2013:p1273:b003:l004","ordinal":173319,"en":"And dust curled into the sky."},{"id":"semetey-1-2013:p1273:b003:l005","ordinal":173320,"en":"The great host, frightened at first,"},{"id":"semetey-1-2013:p1273:b003:l006","ordinal":173321,"en":"Gathered to the last man."},{"id":"semetey-1-2013:p1273:b003:l007","ordinal":173322,"en":"Would the deftest with battle-axes,"},{"id":"semetey-1-2013:p1273:b003:l008","ordinal":173323,"en":"The strongest Afghans,"},{"id":"semetey-1-2013:p1273:b003:l009","ordinal":173324,"en":"Stand watching without fighting to the death?"},{"id":"semetey-1-2013:p1273:b003:l010","ordinal":173325,"en":"The gray-piebald banner became their standard,"},{"id":"semetey-1-2013:p1273:b003:l011","ordinal":173326,"en":"And a wailing clamor arose."},{"id":"semetey-1-2013:p1273:b003:l012","ordinal":173327,"en":"The finest spearmen stood apart,"},{"id":"semetey-1-2013:p1273:b003:l013","ordinal":173328,"en":"And the best men appeared."},{"id":"semetey-1-2013:p1273:b003:l014","ordinal":173329,"en":"The inside of the city closed down;"},{"id":"semetey-1-2013:p1273:b003:l015","ordinal":173330,"en":"All the bloodletters gathered."},{"id":"semetey-1-2013:p1273:b003:l016","ordinal":173331,"en":"The old men stayed bowed at home;"},{"id":"semetey-1-2013:p1273:b003:l017","ordinal":173332,"en":"All the Afghans"},{"id":"semetey-1-2013:p1273:b003:l018","ordinal":173333,"en":"Set their army in motion."},{"id":"semetey-1-2013:p1273:b003:l019","ordinal":173334,"en":"From the treasury horde"},{"id":"semetey-1-2013:p1273:b003:l020","ordinal":173335,"en":"Khan Akun's army appeared."},{"id":"semetey-1-2013:p1273:b003:l021","ordinal":173336,"en":"Tumenbay, son of Tulku,"},{"id":"semetey-1-2013:p1273:b003:l022","ordinal":173337,"en":"Was a hero with a Turkic spirit."},{"id":"semetey-1-2013:p1273:b003:l023","ordinal":173338,"en":"At Jeti-Ozon, the Jediger"},{"id":"semetey-1-2013:p1273:b003:l024","ordinal":173339,"en":"Would meet them face to face and fight;"},{"id":"semetey-1-2013:p1273:b003:l025","ordinal":173340,"en":"That was where they would reach their end."},{"id":"semetey-1-2013:p1273:b003:l026","ordinal":173341,"en":"Little wisdom and much courage—"},{"id":"semetey-1-2013:p1273:b003:l027","ordinal":173342,"en":"That Tumenbay, son of Tulku,"},{"id":"semetey-1-2013:p1273:b003:l028","ordinal":173343,"en":"Was a harsh-tempered hero,"},{"id":"semetey-1-2013:p1273:b003:l029","ordinal":173344,"en":"A lion who stood out plainly."},{"id":"semetey-1-2013:p1273:b003:l030","ordinal":173345,"en":"He fought trusting fate"},{"id":"semetey-1-2013:p1273:b003:l031","ordinal":173346,"en":"And was one who broke formations."},{"id":"semetey-1-2013:p1273:b003:l032","ordinal":173347,"en":"He girded the jekene at his waist;"},{"id":"semetey-1-2013:p1273:b003:l033","ordinal":173348,"en":"If the seven divisions of Jediger"},{"id":"semetey-1-2013:p1273:b003:l034","ordinal":173349,"en":"Suddenly engulfed him,"},{"id":"semetey-1-2013:p1273:b003:l035","ordinal":173350,"en":"He attacked alone."},{"id":"semetey-1-2013:p1273:b003:l036","ordinal":173351,"en":"He did not fear death by a penny;"},{"id":"semetey-1-2013:p1273:b003:l037","ordinal":173352,"en":"Barely having escaped death,"},{"id":"semetey-1-2013:p1273:b003:l038","ordinal":173353,"en":"The teeming Jediger"},{"id":"semetey-1-2013:p1273:b003:l039","ordinal":173354,"en":"Had surged in yesterday;"},{"id":"semetey-1-2013:p1273:b005:l001","ordinal":173355,"en":"Before this, Tumenbay"},{"id":"semetey-1-2013:p1273:b005:l002","ordinal":173356,"en":"Had fought them many times."},{"id":"semetey-1-2013:p1273:b005:l003","ordinal":173357,"en":"Driving after him,"},{"id":"semetey-1-2013:p1273:b005:l004","ordinal":173358,"en":"Because of desire for Aychurok,"},{"id":"semetey-1-2013:p1273:b005:l005","ordinal":173359,"en":"Yesterday Toltoy of the Jediger"},{"id":"semetey-1-2013:p1273:b005:l006","ordinal":173360,"en":"Drew his bow like rain"},{"id":"semetey-1-2013:p1273:b005:l007","ordinal":173361,"en":"And fired bullets like hail."},{"id":"semetey-1-2013:p1273:b005:l008","ordinal":173362,"en":"Saying, \"He will not obey my demand,\""},{"id":"semetey-1-2013:p1273:b005:l009","ordinal":173363,"en":"He began a great tumult;"},{"id":"semetey-1-2013:p1273:b005:l010","ordinal":173364,"en":"Saying, \"He will not give his old daughter,\""},{"id":"semetey-1-2013:p1273:b005:l011","ordinal":173365,"en":"He slaughtered the people."},{"id":"semetey-1-2013:p1273:b005:l012","ordinal":173366,"en":"They stood in single combat;"},{"id":"semetey-1-2013:p1273:b005:l013","ordinal":173367,"en":"Not once, but seven times"},{"id":"semetey-1-2013:p1273:b005:l014","ordinal":173368,"en":"The Jediger fought."},{"id":"semetey-1-2013:p1273:b005:l015","ordinal":173369,"en":"They fought horse to horse,"},{"id":"semetey-1-2013:p1273:b005:l016","ordinal":173370,"en":"Jousted with spears,"},{"id":"semetey-1-2013:p1273:b005:l017","ordinal":173371,"en":"And struck with swords."},{"id":"semetey-1-2013:p1273:b005:l018","ordinal":173372,"en":"Because of Aychurok,"},{"id":"semetey-1-2013:p1273:b005:l019","ordinal":173373,"en":"They found much slaughter."},{"id":"semetey-1-2013:p1273:b005:l020","ordinal":173374,"en":"The truest of them was Chynkojo,"},{"id":"semetey-1-2013:p1273:b005:l021","ordinal":173375,"en":"Like tempered red iron."},{"id":"semetey-1-2013:p1273:b005:l022","ordinal":173376,"en":"His courage was different, his venom strong;"},{"id":"semetey-1-2013:p1273:b005:l023","ordinal":173377,"en":"He could devour whomever he met,"},{"id":"semetey-1-2013:p1273:b005:l024","ordinal":173378,"en":"And his bulk was half a mountain."},{"id":"semetey-1-2013:p1273:b005:l025","ordinal":173379,"en":"Kojo, son of Shygay,"},{"id":"semetey-1-2013:p1273:b005:l026","ordinal":173380,"en":"Had a black cap like a cauldron."},{"id":"semetey-1-2013:p1273:b005:l027","ordinal":173381,"en":"He had the will to slaughter"},{"id":"semetey-1-2013:p1273:b005:l028","ordinal":173382,"en":"Not only Afghanistan but the world."},{"id":"semetey-1-2013:p1273:b005:l029","ordinal":173383,"en":"He had received instruction"},{"id":"semetey-1-2013:p1273:b005:l030","ordinal":173384,"en":"From blessed Manas's spirit."},{"id":"semetey-1-2013:p1273:b005:l031","ordinal":173385,"en":"That was the hero and the warrior,"},{"id":"semetey-1-2013:p1273:b005:l032","ordinal":173386,"en":"A cunning and wise man,"},{"id":"semetey-1-2013:p1273:b005:l033","ordinal":173387,"en":"A lion who knew perfectly"},{"id":"semetey-1-2013:p1273:b005:l034","ordinal":173388,"en":"The enemy's devices."},{"id":"semetey-1-2013:p1273:b005:l035","ordinal":173389,"en":"Yesterday, when Almambet fell to a bullet,"},{"id":"semetey-1-2013:p1273:b005:l036","ordinal":173390,"en":"Did he not unleash"},{"id":"semetey-1-2013:p1273:b005:l037","ordinal":173391,"en":"A merciless turmoil?"},{"id":"semetey-1-2013:p1273:b005:l038","ordinal":173392,"en":"Chynkojo the expert"},{"id":"semetey-1-2013:p1273:b005:l039","ordinal":173393,"en":"Had taken Almambet's magic stone,"},{"id":"semetey-1-2013:p1274:b003:l001","ordinal":173394,"en":"Had he not seized it?"},{"id":"semetey-1-2013:p1274:b003:l002","ordinal":173395,"en":"Before, fighting six times,"},{"id":"semetey-1-2013:p1274:b003:l003","ordinal":173396,"en":"He had caused much strife in Afghanistan."},{"id":"semetey-1-2013:p1274:b003:l004","ordinal":173397,"en":"The peoples of the world gathered;"},{"id":"semetey-1-2013:p1274:b003:l005","ordinal":173398,"en":"Many of the palmful of Afghans"},{"id":"semetey-1-2013:p1274:b003:l006","ordinal":173399,"en":"Were slaughtered."},{"id":"semetey-1-2013:p1274:b003:l007","ordinal":173400,"en":"Akun's army stood apart."},{"id":"semetey-1-2013:p1274:b003:l008","ordinal":173401,"en":"What could dear Akun do?"},{"id":"semetey-1-2013:p1274:b003:l009","ordinal":173402,"en":"He wrapped his belt as a turban"},{"id":"semetey-1-2013:p1274:b003:l010","ordinal":173403,"en":"And implored the Almighty:"},{"id":"semetey-1-2013:p1274:b003:l011","ordinal":173404,"en":"\"If death comes, I will die;"},{"id":"semetey-1-2013:p1274:b003:l012","ordinal":173405,"en":"What God has written,"},{"id":"semetey-1-2013:p1274:b003:l013","ordinal":173406,"en":"If it falls upon my neck, I will see."},{"id":"semetey-1-2013:p1274:b003:l014","ordinal":173407,"en":"I will become support"},{"id":"semetey-1-2013:p1274:b003:l015","ordinal":173408,"en":"For the orphaned son of Manas."},{"id":"semetey-1-2013:p1274:b003:l016","ordinal":173409,"en":"If the Jediger falls into my hands,"},{"id":"semetey-1-2013:p1274:b003:l017","ordinal":173410,"en":"I will offer them as sacrifices!\""},{"id":"semetey-1-2013:p1274:b003:l018","ordinal":173411,"en":"Khan Akun came out straining."},{"id":"semetey-1-2013:p1274:b003:l019","ordinal":173412,"en":"What could dear Akun do?"},{"id":"semetey-1-2013:p1274:b003:l020","ordinal":173413,"en":"He prepared for war."},{"id":"semetey-1-2013:p1274:b003:l021","ordinal":173414,"en":"His spear was truly pointed,"},{"id":"semetey-1-2013:p1274:b003:l022","ordinal":173415,"en":"His sword exceptionally sharp."},{"id":"semetey-1-2013:p1274:b003:l023","ordinal":173416,"en":"The hero skilled with the battle-axe,"},{"id":"semetey-1-2013:p1274:b003:l024","ordinal":173417,"en":"Tumenbay, son of Tulku,"},{"id":"semetey-1-2013:p1274:b003:l025","ordinal":173418,"en":"Was the valiant Afghan."},{"id":"semetey-1-2013:p1274:b003:l026","ordinal":173419,"en":"If an army engulfed them,"},{"id":"semetey-1-2013:p1274:b003:l027","ordinal":173420,"en":"If a dug pit lay before them,"},{"id":"semetey-1-2013:p1274:b003:l028","ordinal":173421,"en":"If a hazy fire struck,"},{"id":"semetey-1-2013:p1274:b003:l029","ordinal":173422,"en":"If an unbroken bullet struck,"},{"id":"semetey-1-2013:p1274:b003:l030","ordinal":173423,"en":"He was the hero who would ward it off."},{"id":"semetey-1-2013:p1274:b003:l031","ordinal":173424,"en":"\"I will endure the Jediger's humiliation"},{"id":"semetey-1-2013:p1274:b003:l032","ordinal":173425,"en":"Through hardship;"},{"id":"semetey-1-2013:p1274:b003:l033","ordinal":173426,"en":"I will become support"},{"id":"semetey-1-2013:p1274:b003:l034","ordinal":173427,"en":"For the young lord and tiger.\""},{"id":"semetey-1-2013:p1274:b003:l035","ordinal":173428,"en":"The valiant man's mount"},{"id":"semetey-1-2013:p1274:b003:l036","ordinal":173429,"en":"Was a black-blazed courser."},{"id":"semetey-1-2013:p1274:b003:l037","ordinal":173430,"en":"Surging upon the courser,"},{"id":"semetey-1-2013:p1274:b003:l038","ordinal":173431,"en":"He drove the great common host"},{"id":"semetey-1-2013:p1274:b003:l039","ordinal":173432,"en":"And spoke to the Afghans:"},{"id":"semetey-1-2013:p1274:b004:l001","ordinal":173433,"en":"\"Do not lose your wits;"},{"id":"semetey-1-2013:p1274:b004:l002","ordinal":173434,"en":"Damn you, Afghans,"},{"id":"semetey-1-2013:p1274:b004:l003","ordinal":173435,"en":"Do not flee as before!"},{"id":"semetey-1-2013:p1274:b004:l004","ordinal":173436,"en":"You have a ridge of refuge,"},{"id":"semetey-1-2013:p1274:b004:l005","ordinal":173437,"en":"And heroes girded for battle."},{"id":"semetey-1-2013:p1274:b004:l006","ordinal":173438,"en":"The great Jediger host"},{"id":"semetey-1-2013:p1274:b004:l007","ordinal":173439,"en":"Engulfed Afghanistan"},{"id":"semetey-1-2013:p1274:b004:l008","ordinal":173440,"en":"And often raided your migrations;"},{"id":"semetey-1-2013:p1274:b004:l009","ordinal":173441,"en":"Leopard Khan Semetey"},{"id":"semetey-1-2013:p1274:b004:l010","ordinal":173442,"en":"Will take your revenge."},{"id":"semetey-1-2013:p1274:b004:l011","ordinal":173443,"en":"Support has come to you, Afghans;"},{"id":"semetey-1-2013:p1274:b004:l012","ordinal":173444,"en":"A lion to make a host has come!\""},{"id":"semetey-1-2013:p1274:b004:l013","ordinal":173445,"en":"Shouting, \"Baabedin!\""},{"id":"semetey-1-2013:p1274:b004:l014","ordinal":173446,"en":"Calling the Afghan battle cry,"},{"id":"semetey-1-2013:p1274:b004:l015","ordinal":173447,"en":"They became a vast, accomplished army,"},{"id":"semetey-1-2013:p1274:b004:l016","ordinal":173448,"en":"So numerous the earth bent."},{"id":"semetey-1-2013:p1274:b004:l017","ordinal":173449,"en":"All mounted tulpar horses"},{"id":"semetey-1-2013:p1274:b004:l018","ordinal":173450,"en":"And tightly knotted their hair tails."},{"id":"semetey-1-2013:p1274:b004:l019","ordinal":173451,"en":"The earth filled with their numbers;"},{"id":"semetey-1-2013:p1274:b004:l020","ordinal":173452,"en":"They were a people spread across the land."},{"id":"semetey-1-2013:p1274:b004:l021","ordinal":173453,"en":"His courser thundered;"},{"id":"semetey-1-2013:p1274:b004:l022","ordinal":173454,"en":"He slung the alengir bow"},{"id":"semetey-1-2013:p1274:b004:l023","ordinal":173455,"en":"And patterned arrows,"},{"id":"semetey-1-2013:p1274:b004:l024","ordinal":173456,"en":"Roaring, \"Advance!\""},{"id":"semetey-1-2013:p1274:b004:l025","ordinal":173457,"en":"They streamed like ants."},{"id":"semetey-1-2013:p1274:b004:l026","ordinal":173458,"en":"When his army suddenly emerged"},{"id":"semetey-1-2013:p1274:b004:l027","ordinal":173459,"en":"Upon the earthen ridge,"},{"id":"semetey-1-2013:p1274:b004:l028","ordinal":173460,"en":"The Jediger on the far side"},{"id":"semetey-1-2013:p1274:b004:l029","ordinal":173461,"en":"Were coming in a surging mass."},{"id":"semetey-1-2013:p1274:b004:l030","ordinal":173462,"en":"Spearpoints struck one another,"},{"id":"semetey-1-2013:p1274:b004:l031","ordinal":173463,"en":"And human heads collided."},{"id":"semetey-1-2013:p1274:b004:l032","ordinal":173464,"en":"They drew bows like rain"},{"id":"semetey-1-2013:p1274:b004:l033","ordinal":173465,"en":"And fired bullets like hail."},{"id":"semetey-1-2013:p1274:b004:l034","ordinal":173466,"en":"Closing in toward the city,"},{"id":"semetey-1-2013:p1274:b004:l035","ordinal":173467,"en":"Prepared for mass battle,"},{"id":"semetey-1-2013:p1274:b004:l036","ordinal":173468,"en":"The remaining Jediger"},{"id":"semetey-1-2013:p1274:b004:l037","ordinal":173469,"en":"Drew bows like rain"},{"id":"semetey-1-2013:p1274:b004:l038","ordinal":173470,"en":"And fired bullets like hail."},{"id":"semetey-1-2013:p1274:b004:l039","ordinal":173471,"en":"Without tiring, the people engulfed them,"},{"id":"semetey-1-2013:p1275:b003:l001","ordinal":173472,"en":"An immeasurable flood engulfing them—"},{"id":"semetey-1-2013:p1275:b003:l002","ordinal":173473,"en":"Unless the heroes come out to meet it,"},{"id":"semetey-1-2013:p1275:b003:l003","ordinal":173474,"en":"It is coming to trample Afghanistan"},{"id":"semetey-1-2013:p1275:b003:l004","ordinal":173475,"en":"And reduce it to nothing."},{"id":"semetey-1-2013:p1275:b003:l005","ordinal":173476,"en":"The road-hardened Jediger"},{"id":"semetey-1-2013:p1275:b003:l006","ordinal":173477,"en":"Are coming to engulf Afghanistan"},{"id":"semetey-1-2013:p1275:b003:l007","ordinal":173478,"en":"And grind it to powder."},{"id":"semetey-1-2013:p1275:b003:l008","ordinal":173479,"en":"The army split at the front;"},{"id":"semetey-1-2013:p1275:b003:l009","ordinal":173480,"en":"Lion Kozho, who brought great strife"},{"id":"semetey-1-2013:p1275:b003:l010","ordinal":173481,"en":"Upon the world, was at the flank."},{"id":"semetey-1-2013:p1275:b003:l011","ordinal":173482,"en":"Carrying a gold banner with a crescent,"},{"id":"semetey-1-2013:p1275:b003:l012","ordinal":173483,"en":"Raising every kind of clamor,"},{"id":"semetey-1-2013:p1275:b003:l013","ordinal":173484,"en":"When Kozho drew near,"},{"id":"semetey-1-2013:p1275:b003:l014","ordinal":173485,"en":"The sight made the heart recoil."},{"id":"semetey-1-2013:p1275:b003:l015","ordinal":173486,"en":"His majesty was fierce, his wrath strong;"},{"id":"semetey-1-2013:p1275:b003:l016","ordinal":173487,"en":"The leopard prince then"},{"id":"semetey-1-2013:p1275:b003:l017","ordinal":173488,"en":"Looked as vast as Ala-Too."},{"id":"semetey-1-2013:p1275:b003:l018","ordinal":173489,"en":"A blue-mottled cloud appeared in the sky;"},{"id":"semetey-1-2013:p1275:b003:l019","ordinal":173490,"en":"Semetey, son of the blue-maned lion,"},{"id":"semetey-1-2013:p1275:b003:l020","ordinal":173491,"en":"Made Buurul bound and thrash,"},{"id":"semetey-1-2013:p1275:b003:l021","ordinal":173492,"en":"Rearing and lunging,"},{"id":"semetey-1-2013:p1275:b003:l022","ordinal":173493,"en":"And visibly rode out to meet him"},{"id":"semetey-1-2013:p1275:b003:l023","ordinal":173494,"en":"Before Chynkozho."},{"id":"semetey-1-2013:p1275:b003:l024","ordinal":173495,"en":"Arbuurul beneath him,"},{"id":"semetey-1-2013:p1275:b003:l025","ordinal":173496,"en":"A creature beyond ordinary livestock,"},{"id":"semetey-1-2013:p1275:b003:l026","ordinal":173497,"en":"Pricked its extraordinary ears."},{"id":"semetey-1-2013:p1275:b003:l027","ordinal":173498,"en":"The white blaze on its brow, broad as teeth,"},{"id":"semetey-1-2013:p1275:b003:l028","ordinal":173499,"en":"Seemed covered in steel;"},{"id":"semetey-1-2013:p1275:b003:l029","ordinal":173500,"en":"The breadth of its pelvis"},{"id":"semetey-1-2013:p1275:b003:l030","ordinal":173501,"en":"Was like a ravine filled with firewood."},{"id":"semetey-1-2013:p1275:b003:l031","ordinal":173502,"en":"His fearsome waist girded,"},{"id":"semetey-1-2013:p1275:b003:l032","ordinal":173503,"en":"Semetey charged"},{"id":"semetey-1-2013:p1275:b003:l033","ordinal":173504,"en":"Into Chynkozho's army."},{"id":"semetey-1-2013:p1275:b003:l034","ordinal":173505,"en":"His father was a surpassing blue-maned lion;"},{"id":"semetey-1-2013:p1275:b003:l035","ordinal":173506,"en":"Lion-like Semetey"},{"id":"semetey-1-2013:p1275:b003:l036","ordinal":173507,"en":"Unleashed turmoil there."},{"id":"semetey-1-2013:p1275:b003:l037","ordinal":173508,"en":"Girding a gray kise belt at his waist,"},{"id":"semetey-1-2013:p1275:b003:l038","ordinal":173509,"en":"He charged, swaying heavily."},{"id":"semetey-1-2013:p1275:b003:l039","ordinal":173510,"en":"His hero's gift,"},{"id":"semetey-1-2013:p1275:b005:l001","ordinal":173511,"en":"His renowned red banner,"},{"id":"semetey-1-2013:p1275:b005:l002","ordinal":173512,"en":"He planted wherever he faced;"},{"id":"semetey-1-2013:p1275:b005:l003","ordinal":173513,"en":"Semetey drove straight in,"},{"id":"semetey-1-2013:p1275:b005:l004","ordinal":173514,"en":"Slaughtering the side he faced."},{"id":"semetey-1-2013:p1275:b005:l005","ordinal":173515,"en":"The playful blue-maned hero"},{"id":"semetey-1-2013:p1275:b005:l006","ordinal":173516,"en":"Wrought destruction there."},{"id":"semetey-1-2013:p1275:b005:l007","ordinal":173517,"en":"He made the white standard his banner,"},{"id":"semetey-1-2013:p1275:b005:l008","ordinal":173518,"en":"Filled the side he faced with clamor,"},{"id":"semetey-1-2013:p1275:b005:l009","ordinal":173519,"en":"And set out to drive these people away."},{"id":"semetey-1-2013:p1275:b005:l010","ordinal":173520,"en":"When Semetey entered,"},{"id":"semetey-1-2013:p1275:b005:l011","ordinal":173521,"en":"He darted in like a falcon;"},{"id":"semetey-1-2013:p1275:b005:l012","ordinal":173522,"en":"The great black Jediger host"},{"id":"semetey-1-2013:p1275:b005:l013","ordinal":173523,"en":"Fled shrieking like crows."},{"id":"semetey-1-2013:p1275:b005:l014","ordinal":173524,"en":"Making Taybuurul dance,"},{"id":"semetey-1-2013:p1275:b005:l015","ordinal":173525,"en":"Those he reached then"},{"id":"semetey-1-2013:p1275:b005:l016","ordinal":173526,"en":"He measured out with his spear."},{"id":"semetey-1-2013:p1275:b005:l017","ordinal":173527,"en":"Many were witless with panic;"},{"id":"semetey-1-2013:p1275:b005:l018","ordinal":173528,"en":"Many ran in confusion."},{"id":"semetey-1-2013:p1275:b005:l019","ordinal":173529,"en":"Saying, “Elder, we submit,”"},{"id":"semetey-1-2013:p1275:b005:l020","ordinal":173530,"en":"Many could not gather their senses"},{"id":"semetey-1-2013:p1275:b005:l021","ordinal":173531,"en":"And ran away."},{"id":"semetey-1-2013:p1275:b005:l022","ordinal":173532,"en":"Many threw down their spears"},{"id":"semetey-1-2013:p1275:b005:l023","ordinal":173533,"en":"And stampeded."},{"id":"semetey-1-2013:p1275:b005:l024","ordinal":173534,"en":"They threw away every one"},{"id":"semetey-1-2013:p1275:b005:l025","ordinal":173535,"en":"Of their swords, guns, and weapons."},{"id":"semetey-1-2013:p1275:b005:l026","ordinal":173536,"en":"Saying, “Come, let us preserve"},{"id":"semetey-1-2013:p1275:b005:l027","ordinal":173537,"en":"The lives entrusted to us,” many fled."},{"id":"semetey-1-2013:p1275:b005:l028","ordinal":173538,"en":"In terror they could not pull in the reins;"},{"id":"semetey-1-2013:p1275:b005:l029","ordinal":173539,"en":"Their horses all bucked,"},{"id":"semetey-1-2013:p1275:b005:l030","ordinal":173540,"en":"And many could not stop them."},{"id":"semetey-1-2013:p1275:b005:l031","ordinal":173541,"en":"Saying, “We shall die without seeing"},{"id":"semetey-1-2013:p1275:b005:l032","ordinal":173542,"en":"A wicked wife or young child,”"},{"id":"semetey-1-2013:p1275:b005:l033","ordinal":173543,"en":"Many fled weeping."},{"id":"semetey-1-2013:p1275:b005:l034","ordinal":173544,"en":"The saddles of many swift horses"},{"id":"semetey-1-2013:p1275:b005:l035","ordinal":173545,"en":"Slipped beneath their bellies;"},{"id":"semetey-1-2013:p1275:b005:l036","ordinal":173546,"en":"Many went careering about."},{"id":"semetey-1-2013:p1275:b005:l037","ordinal":173547,"en":"Saying, “My dear lost brother"},{"id":"semetey-1-2013:p1275:b005:l038","ordinal":173548,"en":"Died in such-and-such a place,”"},{"id":"semetey-1-2013:p1275:b005:l039","ordinal":173549,"en":"Many went weeping."},{"id":"semetey-1-2013:p1276:b003:l001","ordinal":173550,"en":"On seeing their dead,"},{"id":"semetey-1-2013:p1276:b003:l002","ordinal":173551,"en":"Many went about in anguish."},{"id":"semetey-1-2013:p1276:b003:l003","ordinal":173552,"en":"Saying, “That fucking dog Kozho"},{"id":"semetey-1-2013:p1276:b003:l004","ordinal":173553,"en":"Has done this to us,”"},{"id":"semetey-1-2013:p1276:b003:l005","ordinal":173554,"en":"Many went weeping."},{"id":"semetey-1-2013:p1276:b003:l006","ordinal":173555,"en":"They dismounted and crowded forward,"},{"id":"semetey-1-2013:p1276:b003:l007","ordinal":173556,"en":"Hanging their belts around their necks;"},{"id":"semetey-1-2013:p1276:b003:l008","ordinal":173557,"en":"Before Semetey then,"},{"id":"semetey-1-2013:p1276:b003:l009","ordinal":173558,"en":"Many begged for their lives in supplication"},{"id":"semetey-1-2013:p1276:b003:l010","ordinal":173559,"en":"And witnessed"},{"id":"semetey-1-2013:p1276:b003:l011","ordinal":173560,"en":"The Creator's command."},{"id":"semetey-1-2013:p1276:b003:l012","ordinal":173561,"en":"Many merely swooned and fell,"},{"id":"semetey-1-2013:p1276:b003:l013","ordinal":173562,"en":"Lying as though dead."},{"id":"semetey-1-2013:p1276:b003:l014","ordinal":173563,"en":"Many wandered about"},{"id":"semetey-1-2013:p1276:b003:l015","ordinal":173564,"en":"With their saddles around their necks."},{"id":"semetey-1-2013:p1276:b003:l016","ordinal":173565,"en":"Their girths had broken;"},{"id":"semetey-1-2013:p1276:b003:l017","ordinal":173566,"en":"Their eyes darted about,"},{"id":"semetey-1-2013:p1276:b003:l018","ordinal":173567,"en":"Their legs hung limp,"},{"id":"semetey-1-2013:p1276:b003:l019","ordinal":173568,"en":"And many ran in panic."}]
