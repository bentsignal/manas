[{"id":"semetey-1-2013:p0278:b004:l004","ordinal":98049,"en":"There is no choice but to bear it."},{"id":"semetey-1-2013:p0278:b004:l005","ordinal":98050,"en":"What you desire today is gone tomorrow."},{"id":"semetey-1-2013:p0278:b004:l006","ordinal":98051,"en":"Such is the wretched ember."},{"id":"semetey-1-2013:p0278:b004:l007","ordinal":98052,"en":"Little brother, I was at ease, then withered and faded."},{"id":"semetey-1-2013:p0278:b004:l008","ordinal":98053,"en":"The Creator marked out this deed."},{"id":"semetey-1-2013:p0278:b004:l009","ordinal":98054,"en":"Little brother, I wandered and settled in Bukhara."},{"id":"semetey-1-2013:p0278:b004:l010","ordinal":98055,"en":"All the people around"},{"id":"semetey-1-2013:p0278:b004:l011","ordinal":98056,"en":"Were made to call me ‘a wandering woman.’"},{"id":"semetey-1-2013:p0278:b004:l012","ordinal":98057,"en":"I came to have a bad name."},{"id":"semetey-1-2013:p0278:b004:l013","ordinal":98058,"en":"Consider this matter, younger brother,"},{"id":"semetey-1-2013:p0278:b004:l014","ordinal":98059,"en":"My forehead bone is curved back."},{"id":"semetey-1-2013:p0278:b004:l015","ordinal":98060,"en":"When your brother-in-law passed away,"},{"id":"semetey-1-2013:p0278:b004:l016","ordinal":98061,"en":"There was not a speck of good fortune."},{"id":"semetey-1-2013:p0278:b004:l017","ordinal":98062,"en":"My means of living were scant."},{"id":"semetey-1-2013:p0278:b004:l018","ordinal":98063,"en":"For one who has fled here,"},{"id":"semetey-1-2013:p0278:b004:l019","ordinal":98064,"en":"Bukhara is a good place."},{"id":"semetey-1-2013:p0278:b004:l020","ordinal":98065,"en":"The common people of Bukhara,"},{"id":"semetey-1-2013:p0278:b004:l021","ordinal":98066,"en":"Who speak many impious words,"},{"id":"semetey-1-2013:p0278:b004:l022","ordinal":98067,"en":"Have become so corrupt a people."},{"id":"semetey-1-2013:p0278:b004:l023","ordinal":98068,"en":"‘Into Temir Khan's city,"},{"id":"semetey-1-2013:p0278:b004:l024","ordinal":98069,"en":"This one came wandering,"},{"id":"semetey-1-2013:p0278:b004:l025","ordinal":98070,"en":"Settling with her household in Bukhara,"},{"id":"semetey-1-2013:p0278:b004:l026","ordinal":98071,"en":"A shameless woman,’ they say."},{"id":"semetey-1-2013:p0278:b004:l027","ordinal":98072,"en":"Wandering to Bukhara,"},{"id":"semetey-1-2013:p0278:b004:l028","ordinal":98073,"en":"I came and settled to save my life."},{"id":"semetey-1-2013:p0278:b004:l029","ordinal":98074,"en":"They have called me ‘a runaway woman.’"},{"id":"semetey-1-2013:p0278:b004:l030","ordinal":98075,"en":"My dear little brother,"},{"id":"semetey-1-2013:p0278:b004:l031","ordinal":98076,"en":"This year I have acquired a bad name."},{"id":"semetey-1-2013:p0278:b004:l032","ordinal":98077,"en":"If you heed me, little brother,"},{"id":"semetey-1-2013:p0278:b004:l033","ordinal":98078,"en":"Come from time to time."},{"id":"semetey-1-2013:p0278:b004:l034","ordinal":98079,"en":"Ride over and call at the house."},{"id":"semetey-1-2013:p0278:b004:l035","ordinal":98080,"en":"Does a widow have no food?"},{"id":"semetey-1-2013:p0278:b004:l036","ordinal":98081,"en":"Come and eat when you can."},{"id":"semetey-1-2013:p0278:b004:l037","ordinal":98082,"en":"Step across my threshold and come in."},{"id":"semetey-1-2013:p0278:b004:l038","ordinal":98083,"en":"Whatever robe my hands can make,"},{"id":"semetey-1-2013:p0278:b004:l039","ordinal":98084,"en":"Regard it as a great gift,"},{"id":"semetey-1-2013:p0279:b003:l001","ordinal":98085,"en":"And wear that robe of mine."},{"id":"semetey-1-2013:p0279:b003:l002","ordinal":98086,"en":"How your elder sister has suffered,"},{"id":"semetey-1-2013:p0279:b003:l003","ordinal":98087,"en":"My dear little brother,"},{"id":"semetey-1-2013:p0279:b003:l004","ordinal":98088,"en":"From now on, know it."},{"id":"semetey-1-2013:p0279:b003:l005","ordinal":98089,"en":"Come and sit in conversation."},{"id":"semetey-1-2013:p0279:b003:l006","ordinal":98090,"en":"A widow like me,"},{"id":"semetey-1-2013:p0279:b003:l007","ordinal":98091,"en":"Keep asking how she fares."},{"id":"semetey-1-2013:p0279:b003:l008","ordinal":98092,"en":"Come to our home."},{"id":"semetey-1-2013:p0279:b003:l009","ordinal":98093,"en":"‘How are you faring?’ ask,"},{"id":"semetey-1-2013:p0279:b003:l010","ordinal":98094,"en":"And cast your eyes upon me."},{"id":"semetey-1-2013:p0279:b003:l011","ordinal":98095,"en":"Little brother, when your valiant brother-in-law lived,"},{"id":"semetey-1-2013:p0279:b003:l012","ordinal":98096,"en":"We too were khans like you."},{"id":"semetey-1-2013:p0279:b003:l013","ordinal":98097,"en":"Sending off people, receiving guests,"},{"id":"semetey-1-2013:p0279:b003:l014","ordinal":98098,"en":"We were as good as anyone."},{"id":"semetey-1-2013:p0279:b003:l015","ordinal":98099,"en":"Your brother-in-law Manas was a hero."},{"id":"semetey-1-2013:p0279:b003:l016","ordinal":98100,"en":"One like your brother-in-law, the one God,"},{"id":"semetey-1-2013:p0279:b003:l017","ordinal":98101,"en":"In creating a living mortal,"},{"id":"semetey-1-2013:p0279:b003:l018","ordinal":98102,"en":"Will never create again."},{"id":"semetey-1-2013:p0279:b003:l019","ordinal":98103,"en":"That brother-in-law amassed the gold."},{"id":"semetey-1-2013:p0279:b003:l020","ordinal":98104,"en":"I, your elder sister, bore the suffering."},{"id":"semetey-1-2013:p0279:b003:l021","ordinal":98105,"en":"The six villains enjoyed its worth."},{"id":"semetey-1-2013:p0279:b003:l022","ordinal":98106,"en":"That brother-in-law amassed the silver."},{"id":"semetey-1-2013:p0279:b003:l023","ordinal":98107,"en":"This elder sister bore the grief."},{"id":"semetey-1-2013:p0279:b003:l024","ordinal":98108,"en":"The six villains enjoyed its benefit."},{"id":"semetey-1-2013:p0279:b003:l025","ordinal":98109,"en":"Little brother, my gold became like coal."},{"id":"semetey-1-2013:p0279:b003:l026","ordinal":98110,"en":"The forty champions left by your brother-in-law Manas,"},{"id":"semetey-1-2013:p0279:b003:l028","ordinal":98111,"en":"Grown fat, they raided my settlement."},{"id":"semetey-1-2013:p0279:b003:l029","ordinal":98112,"en":"My silver turned to coal."},{"id":"semetey-1-2013:p0279:b003:l030","ordinal":98113,"en":"Sharing a father with your brother-in-law,"},{"id":"semetey-1-2013:p0279:b003:l031","ordinal":98114,"en":"Those dogs of mine grew fat, knowing nothing of grief."},{"id":"semetey-1-2013:p0279:b003:l032","ordinal":98115,"en":"They ate my well-fed foal."},{"id":"semetey-1-2013:p0279:b003:l033","ordinal":98116,"en":"When they came spurring up,"},{"id":"semetey-1-2013:p0279:b003:l034","ordinal":98117,"en":"Those base-born dogs of mine"},{"id":"semetey-1-2013:p0279:b003:l035","ordinal":98118,"en":"Said, ‘I am an equal-born brother.’"},{"id":"semetey-1-2013:p0279:b003:l036","ordinal":98119,"en":"My homespun silk became like felt."},{"id":"semetey-1-2013:p0279:b003:l037","ordinal":98120,"en":"They did not value me in the end."},{"id":"semetey-1-2013:p0279:b003:l038","ordinal":98121,"en":"My wealth became like felt."},{"id":"semetey-1-2013:p0279:b003:l039","ordinal":98122,"en":"After your brother-in-law passed away,"},{"id":"semetey-1-2013:p0279:b004:l001","ordinal":98123,"en":"The six villains ruined my wealth in the end."},{"id":"semetey-1-2013:p0279:b004:l002","ordinal":98124,"en":"They brought violence and strife to my court."},{"id":"semetey-1-2013:p0279:b004:l003","ordinal":98125,"en":"They put the widow to such a test."},{"id":"semetey-1-2013:p0279:b004:l004","ordinal":98126,"en":"Raiding my migrating camp from Talas,"},{"id":"semetey-1-2013:p0279:b004:l005","ordinal":98127,"en":"A curse upon being a woman,"},{"id":"semetey-1-2013:p0279:b004:l006","ordinal":98128,"en":"With no male child left behind,"},{"id":"semetey-1-2013:p0279:b004:l007","ordinal":98129,"en":"I left without taking revenge upon the dogs."},{"id":"semetey-1-2013:p0279:b004:l008","ordinal":98130,"en":"In Talas they slaughtered my Sart."},{"id":"semetey-1-2013:p0279:b004:l009","ordinal":98131,"en":"A curse upon widowhood,"},{"id":"semetey-1-2013:p0279:b004:l010","ordinal":98132,"en":"Against the villain who rose in frenzy,"},{"id":"semetey-1-2013:p0279:b004:l011","ordinal":98133,"en":"I could not take revenge."},{"id":"semetey-1-2013:p0279:b004:l012","ordinal":98134,"en":"My dear little brother,"},{"id":"semetey-1-2013:p0279:b004:l013","ordinal":98135,"en":"Ride over and call at the house."},{"id":"semetey-1-2013:p0279:b004:l014","ordinal":98136,"en":"Come and sit in conversation."},{"id":"semetey-1-2013:p0279:b004:l015","ordinal":98137,"en":"‘How are things with you?’ ask."},{"id":"semetey-1-2013:p0279:b004:l016","ordinal":98138,"en":"Ask about my wretched life."},{"id":"semetey-1-2013:p0279:b004:l017","ordinal":98139,"en":"Set your horse's saddle right before you go."},{"id":"semetey-1-2013:p0279:b004:l018","ordinal":98140,"en":"For your brother-in-law gone to the other world,"},{"id":"semetey-1-2013:p0279:b004:l019","ordinal":98141,"en":"Recite the Quran well before you go."},{"id":"semetey-1-2013:p0279:b004:l020","ordinal":98142,"en":"Step across the threshold and come in."},{"id":"semetey-1-2013:p0279:b004:l021","ordinal":98143,"en":"Your lamenting elder sister,"},{"id":"semetey-1-2013:p0279:b004:l022","ordinal":98144,"en":"Learn how she lives and fares.”"},{"id":"semetey-1-2013:p0279:b004:l023","ordinal":98145,"en":"Speaking these words then,"},{"id":"semetey-1-2013:p0279:b004:l024","ordinal":98146,"en":"The beauty among the dusky-complexioned,"},{"id":"semetey-1-2013:p0279:b004:l025","ordinal":98147,"en":"My dear elder sister Kanykey,"},{"id":"semetey-1-2013:p0279:b004:l026","ordinal":98148,"en":"The radiant one among Muslims,"},{"id":"semetey-1-2013:p0279:b004:l027","ordinal":98149,"en":"The youngest of twelve daughters,"},{"id":"semetey-1-2013:p0279:b004:l028","ordinal":98150,"en":"God's beloved mortal,"},{"id":"semetey-1-2013:p0279:b004:l029","ordinal":98151,"en":"My wretched elder sister Kanykey,"},{"id":"semetey-1-2013:p0279:b004:l030","ordinal":98152,"en":"Who had been khan over all the people,"},{"id":"semetey-1-2013:p0279:b004:l031","ordinal":98153,"en":"Had become thin."},{"id":"semetey-1-2013:p0279:b004:l032","ordinal":98154,"en":"When the king passed away,"},{"id":"semetey-1-2013:p0279:b004:l033","ordinal":98155,"en":"Wandering to Bukhara,"},{"id":"semetey-1-2013:p0279:b004:l034","ordinal":98156,"en":"My poor elder sister Kanykey"},{"id":"semetey-1-2013:p0279:b004:l035","ordinal":98157,"en":"Had become destitute."},{"id":"semetey-1-2013:p0279:b004:l036","ordinal":98158,"en":"Weeping, speaking, taking the direct path,"},{"id":"semetey-1-2013:p0279:b004:l037","ordinal":98159,"en":"Calling her own child ‘younger brother,’"},{"id":"semetey-1-2013:p0279:b004:l038","ordinal":98160,"en":"Your impassioned mother Kanykey"},{"id":"semetey-1-2013:p0279:b004:l039","ordinal":98161,"en":"Led Semetey along."},{"id":"semetey-1-2013:p0280:b003:l001","ordinal":98162,"en":"On the ridge of great Bukhara,"},{"id":"semetey-1-2013:p0280:b003:l002","ordinal":98163,"en":"Your dear elder sister Kanykey,"},{"id":"semetey-1-2013:p0280:b003:l003","ordinal":98164,"en":"Though she was a widow,"},{"id":"semetey-1-2013:p0280:b003:l004","ordinal":98165,"en":"Did not abandon her rank as khan."},{"id":"semetey-1-2013:p0280:b003:l005","ordinal":98166,"en":"Seven hundred households were under her hand."},{"id":"semetey-1-2013:p0280:b003:l006","ordinal":98167,"en":"The reason they were under her hand—"},{"id":"semetey-1-2013:p0280:b003:l007","ordinal":98168,"en":"Dividing her hair behind into ten,"},{"id":"semetey-1-2013:p0280:b003:l008","ordinal":98169,"en":"Was she not your sister-in-law who braided it?"},{"id":"semetey-1-2013:p0280:b003:l009","ordinal":98170,"en":"While her Magnanimous One lived,"},{"id":"semetey-1-2013:p0280:b003:l010","ordinal":98171,"en":"Reaching out to all the world's people,"},{"id":"semetey-1-2013:p0280:b003:l011","ordinal":98172,"en":"Was she not your sister-in-law accustomed to it?"},{"id":"semetey-1-2013:p0280:b003:l012","ordinal":98173,"en":"Who had learned from Manas,"},{"id":"semetey-1-2013:p0280:b003:l013","ordinal":98174,"en":"Was she not your skillful sister-in-law?"},{"id":"semetey-1-2013:p0280:b003:l014","ordinal":98175,"en":"A tigress among the people,"},{"id":"semetey-1-2013:p0280:b003:l015","ordinal":98176,"en":"Was she not your mighty sister-in-law?"},{"id":"semetey-1-2013:p0280:b003:l016","ordinal":98177,"en":"Walking slowly, taking the direct path,"},{"id":"semetey-1-2013:p0280:b003:l017","ordinal":98178,"en":"Her orphan clear as glass,"},{"id":"semetey-1-2013:p0280:b003:l018","ordinal":98179,"en":"Without revealing she was his mother,"},{"id":"semetey-1-2013:p0280:b003:l019","ordinal":98180,"en":"She led him, calling him ‘younger brother.’"},{"id":"semetey-1-2013:p0280:b003:l020","ordinal":98181,"en":"When he stopped, in distress,"},{"id":"semetey-1-2013:p0280:b003:l021","ordinal":98182,"en":"She pleaded, ‘Little brother.’"},{"id":"semetey-1-2013:p0280:b003:l022","ordinal":98183,"en":"Kanykey's white palace,"},{"id":"semetey-1-2013:p0280:b003:l023","ordinal":98184,"en":"Its doors iron, solid tin,"},{"id":"semetey-1-2013:p0280:b003:l024","ordinal":98185,"en":"Though she was a widow,"},{"id":"semetey-1-2013:p0280:b003:l025","ordinal":98186,"en":"Its splendor was far greater."},{"id":"semetey-1-2013:p0280:b003:l026","ordinal":98187,"en":"Fierce men bearing iron-headed maces,"},{"id":"semetey-1-2013:p0280:b003:l027","ordinal":98188,"en":"There were four to guard the gate."},{"id":"semetey-1-2013:p0280:b003:l028","ordinal":98189,"en":"From the skillful spearmen,"},{"id":"semetey-1-2013:p0280:b003:l029","ordinal":98190,"en":"From the unsparing mighty men,"},{"id":"semetey-1-2013:p0280:b003:l030","ordinal":98191,"en":"Farther on there were six."},{"id":"semetey-1-2013:p0280:b003:l031","ordinal":98192,"en":"Marksmen who never missed,"},{"id":"semetey-1-2013:p0280:b003:l032","ordinal":98193,"en":"Tall and broad-shouldered,"},{"id":"semetey-1-2013:p0280:b003:l033","ordinal":98194,"en":"Wrestlers and lions alike,"},{"id":"semetey-1-2013:p0280:b003:l034","ordinal":98195,"en":"There were seven guards."},{"id":"semetey-1-2013:p0280:b003:l036","ordinal":98196,"en":"She had it driven in by the threshold.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0280:b003:l037","ordinal":98197,"en":"Every part of them well formed,"},{"id":"semetey-1-2013:p0280:b003:l038","ordinal":98198,"en":"Akborchuk and Taytoru"},{"id":"semetey-1-2013:p0280:b003:l039","ordinal":98199,"en":"Stood tethered there."},{"id":"semetey-1-2013:p0280:b004:l001","ordinal":98200,"en":"The dear lion, proud as a rooster,"},{"id":"semetey-1-2013:p0280:b004:l002","ordinal":98201,"en":"Firmly turning his thoughts,"},{"id":"semetey-1-2013:p0280:b004:l003","ordinal":98202,"en":"Pleading hard, calling him ‘younger brother,’"},{"id":"semetey-1-2013:p0280:b004:l004","ordinal":98203,"en":"She kept deceiving her son."},{"id":"semetey-1-2013:p0280:b004:l005","ordinal":98204,"en":"At the entrance to the white palace,"},{"id":"semetey-1-2013:p0280:b004:l006","ordinal":98205,"en":"She quietly took his horse."},{"id":"semetey-1-2013:p0280:b004:l007","ordinal":98206,"en":"Kanykey walked over,"},{"id":"semetey-1-2013:p0280:b004:l008","ordinal":98207,"en":"Long accustomed to seeing guests off,"},{"id":"semetey-1-2013:p0280:b004:l009","ordinal":98208,"en":"Your dear, dauntless mother,"},{"id":"semetey-1-2013:p0280:b004:l010","ordinal":98209,"en":"Among the swift steeds,"},{"id":"semetey-1-2013:p0280:b004:l011","ordinal":98210,"en":"Tethered Aktulpar."},{"id":"semetey-1-2013:p0280:b004:l012","ordinal":98211,"en":"Into Kanykey's palace,"},{"id":"semetey-1-2013:p0280:b004:l013","ordinal":98212,"en":"The carefree boy,"},{"id":"semetey-1-2013:p0280:b004:l014","ordinal":98213,"en":"She led him along."},{"id":"semetey-1-2013:p0280:b004:l015","ordinal":98214,"en":"The gate had a cord."},{"id":"semetey-1-2013:p0280:b004:l016","ordinal":98215,"en":"Your dear sister-in-law Kanykey"},{"id":"semetey-1-2013:p0280:b004:l017","ordinal":98216,"en":"Pulled it with a clang."},{"id":"semetey-1-2013:p0280:b004:l018","ordinal":98217,"en":"Making herself known as his elder sister,"},{"id":"semetey-1-2013:p0280:b004:l019","ordinal":98218,"en":"Into the palace like paradise,"},{"id":"semetey-1-2013:p0280:b004:l020","ordinal":98219,"en":"She brought Semetey."},{"id":"semetey-1-2013:p0280:b004:l021","ordinal":98220,"en":"After the boy entered the palace:"},{"id":"semetey-1-2013:p0280:b004:l022","ordinal":98221,"en":"‘My orphan left by my khan,"},{"id":"semetey-1-2013:p0280:b004:l023","ordinal":98222,"en":"Will not turn and come back out,’ she said."},{"id":"semetey-1-2013:p0280:b004:l024","ordinal":98223,"en":"‘He will not hear my wailing voice,’ she said."},{"id":"semetey-1-2013:p0280:b004:l025","ordinal":98224,"en":"When Semetey entered that house,"},{"id":"semetey-1-2013:p0280:b004:l026","ordinal":98225,"en":"The steel door, the great gate,"},{"id":"semetey-1-2013:p0280:b004:l027","ordinal":98226,"en":"Once fastened, could never open."},{"id":"semetey-1-2013:p0280:b004:l028","ordinal":98227,"en":"The valiant one's cord,"},{"id":"semetey-1-2013:p0280:b004:l029","ordinal":98228,"en":"She fastened it with a clang,"},{"id":"semetey-1-2013:p0280:b004:l030","ordinal":98229,"en":"And shut the boy inside."},{"id":"semetey-1-2013:p0280:b004:l031","ordinal":98230,"en":"The poor king's wife"},{"id":"semetey-1-2013:p0280:b004:l032","ordinal":98231,"en":"Now raised a screaming cry."},{"id":"semetey-1-2013:p0280:b004:l033","ordinal":98232,"en":"From her dear quail-like eyes,"},{"id":"semetey-1-2013:p0280:b004:l034","ordinal":98233,"en":"Tears fell drop after drop."},{"id":"semetey-1-2013:p0280:b004:l035","ordinal":98234,"en":"From her dear currant-like eyes,"},{"id":"semetey-1-2013:p0280:b004:l036","ordinal":98235,"en":"Tears streamed a whip's length."},{"id":"semetey-1-2013:p0280:b004:l037","ordinal":98236,"en":"She wept and screamed."},{"id":"semetey-1-2013:p0280:b004:l038","ordinal":98237,"en":"To God whose decree is mighty,"},{"id":"semetey-1-2013:p0280:b004:l039","ordinal":98238,"en":"Your dear mother Kanykey"},{"id":"semetey-1-2013:p0281:b003:l001","ordinal":98239,"en":"Sobbed in prayer:"},{"id":"semetey-1-2013:p0281:b003:l002","ordinal":98240,"en":"“The dear bird called a wild duck"},{"id":"semetey-1-2013:p0281:b003:l003","ordinal":98241,"en":"Wheels in flight toward the steppe."},{"id":"semetey-1-2013:p0281:b003:l004","ordinal":98242,"en":"How much was I to endure, ah,"},{"id":"semetey-1-2013:p0281:b003:l005","ordinal":98243,"en":"God, for the child born from my womb!"},{"id":"semetey-1-2013:p0281:b003:l006","ordinal":98244,"en":"The dear bird called a little bustard"},{"id":"semetey-1-2013:p0281:b003:l007","ordinal":98245,"en":"Flies swiftly for food."},{"id":"semetey-1-2013:p0281:b003:l008","ordinal":98246,"en":"I was to bear hardship, ah,"},{"id":"semetey-1-2013:p0281:b003:l009","ordinal":98247,"en":"For you, left by the valiant one."},{"id":"semetey-1-2013:p0281:b003:l010","ordinal":98248,"en":"I let a bird devour the swan,"},{"id":"semetey-1-2013:p0281:b003:l011","ordinal":98249,"en":"The orphan born from my womb,"},{"id":"semetey-1-2013:p0281:b003:l012","ordinal":98250,"en":"The light left by my companion."},{"id":"semetey-1-2013:p0281:b003:l013","ordinal":98251,"en":"Oh God, what shall I do with this grief?"},{"id":"semetey-1-2013:p0281:b003:l014","ordinal":98252,"en":"You had him called the son of Sarts."},{"id":"semetey-1-2013:p0281:b003:l015","ordinal":98253,"en":"What shall I do, God, a grievous ordeal,"},{"id":"semetey-1-2013:p0281:b003:l016","ordinal":98254,"en":"You let a bird devour the goose."},{"id":"semetey-1-2013:p0281:b003:l017","ordinal":98255,"en":"The orphan born from my womb,"},{"id":"semetey-1-2013:p0281:b003:l018","ordinal":98256,"en":"When I fled to Bukhara,"},{"id":"semetey-1-2013:p0281:b003:l019","ordinal":98257,"en":"You had him called another man's son."},{"id":"semetey-1-2013:p0281:b003:l020","ordinal":98258,"en":"God, you have shattered my thoughts."},{"id":"semetey-1-2013:p0281:b003:l021","ordinal":98259,"en":"You had him called another man's son,"},{"id":"semetey-1-2013:p0281:b003:l022","ordinal":98260,"en":"This child who came from my body."},{"id":"semetey-1-2013:p0281:b003:l023","ordinal":98261,"en":"The steed poised to spring,"},{"id":"semetey-1-2013:p0281:b003:l024","ordinal":98262,"en":"You made me call him ‘little brother,’"},{"id":"semetey-1-2013:p0281:b003:l025","ordinal":98263,"en":"The light bestowed by fortune."},{"id":"semetey-1-2013:p0281:b003:l026","ordinal":98264,"en":"You have divided my thoughts every way."},{"id":"semetey-1-2013:p0281:b003:l027","ordinal":98265,"en":"You had him called other men's son,"},{"id":"semetey-1-2013:p0281:b003:l028","ordinal":98266,"en":"My dear one God,"},{"id":"semetey-1-2013:p0281:b003:l029","ordinal":98267,"en":"My boy left by the Magnanimous One."},{"id":"semetey-1-2013:p0281:b003:l030","ordinal":98268,"en":"You closed the wide world and made it narrow."},{"id":"semetey-1-2013:p0281:b003:l031","ordinal":98269,"en":"My boy bestowed by fate,"},{"id":"semetey-1-2013:p0281:b003:l032","ordinal":98270,"en":"My dear one God,"},{"id":"semetey-1-2013:p0281:b003:l033","ordinal":98271,"en":"You made me yearn for a single sight of him."},{"id":"semetey-1-2013:p0281:b003:l034","ordinal":98272,"en":"Let me scream and weep,"},{"id":"semetey-1-2013:p0281:b003:l035","ordinal":98273,"en":"My dear one God,"},{"id":"semetey-1-2013:p0281:b003:l036","ordinal":98274,"en":"Sitting here weeping in earnest,"},{"id":"semetey-1-2013:p0281:b003:l037","ordinal":98275,"en":"What desire shall I attain?"},{"id":"semetey-1-2013:p0281:b003:l038","ordinal":98276,"en":"‘He may happen to hear my screaming voice,’ I think."},{"id":"semetey-1-2013:p0281:b003:l039","ordinal":98277,"en":"‘My orphan may be unable to bear it and come out,’ I think."},{"id":"semetey-1-2013:p0281:b005:l001","ordinal":98278,"en":"Digging my pit deep,"},{"id":"semetey-1-2013:p0281:b005:l002","ordinal":98279,"en":"If he should happen to suspect,"},{"id":"semetey-1-2013:p0281:b005:l003","ordinal":98280,"en":"Will he make my misery boil?"},{"id":"semetey-1-2013:p0281:b005:l004","ordinal":98281,"en":"May he not bring upon my head"},{"id":"semetey-1-2013:p0281:b005:l005","ordinal":98282,"en":"A calamity no person would inflict.”"},{"id":"semetey-1-2013:p0281:b005:l006","ordinal":98283,"en":"Speaking thus, Kanykey,"},{"id":"semetey-1-2013:p0281:b005:l007","ordinal":98284,"en":"The tears from her quail-like eyes,"},{"id":"semetey-1-2013:p0281:b005:l008","ordinal":98285,"en":"Now wiped them separately."},{"id":"semetey-1-2013:p0281:b005:l009","ordinal":98286,"en":"Her tears a whip's length,"},{"id":"semetey-1-2013:p0281:b005:l010","ordinal":98287,"en":"Your dear mother Kanykey,"},{"id":"semetey-1-2013:p0281:b005:l011","ordinal":98288,"en":"Turned and wiped them away."},{"id":"semetey-1-2013:p0281:b005:l012","ordinal":98289,"en":"The white palace with iron doors,"},{"id":"semetey-1-2013:p0281:b005:l013","ordinal":98290,"en":"Your dear sister-in-law Kanykey"},{"id":"semetey-1-2013:p0281:b005:l014","ordinal":98291,"en":"Went back inside."},{"id":"semetey-1-2013:p0281:b005:l015","ordinal":98292,"en":"Then the boy Semetey,"},{"id":"semetey-1-2013:p0281:b005:l016","ordinal":98293,"en":"The boy stood bewildered, not moving."},{"id":"semetey-1-2013:p0281:b005:l017","ordinal":98294,"en":"Your royal, impassioned mother's"},{"id":"semetey-1-2013:p0281:b005:l018","ordinal":98295,"en":"Vast, well-ordered possessions,"},{"id":"semetey-1-2013:p0281:b005:l019","ordinal":98296,"en":"The boy regarded with troubled wonder."},{"id":"semetey-1-2013:p0281:b005:l020","ordinal":98297,"en":"Beyond the edge of the threshold,"},{"id":"semetey-1-2013:p0281:b005:l021","ordinal":98298,"en":"He had not yet passed."},{"id":"semetey-1-2013:p0281:b005:l022","ordinal":98299,"en":"The gold-patterned carpet,"},{"id":"semetey-1-2013:p0281:b005:l023","ordinal":98300,"en":"The noble orphan boy"},{"id":"semetey-1-2013:p0281:b005:l024","ordinal":98301,"en":"Had not yet stepped upon."},{"id":"semetey-1-2013:p0281:b005:l025","ordinal":98302,"en":"If you look on this side,"},{"id":"semetey-1-2013:p0281:b005:l026","ordinal":98303,"en":"It was carved from ruby,"},{"id":"semetey-1-2013:p0281:b005:l027","ordinal":98304,"en":"Satisfying the heart of anyone who saw it."}]
