[{"id":"semetey-1-2013:p1220:b003:l004","ordinal":169217,"en":"It seems the hand"},{"id":"semetey-1-2013:p1220:b003:l005","ordinal":169218,"en":"Of screeching Manas struck me."},{"id":"semetey-1-2013:p1220:b003:l006","ordinal":169219,"en":"Those squealing Buruts—"},{"id":"semetey-1-2013:p1220:b003:l007","ordinal":169220,"en":"It seems their road reached me;"},{"id":"semetey-1-2013:p1220:b003:l008","ordinal":169221,"en":"It seems the hand"},{"id":"semetey-1-2013:p1220:b003:l009","ordinal":169222,"en":"Of shrieking Manas reached me.”"},{"id":"semetey-1-2013:p1220:b003:l010","ordinal":169223,"en":"Before Joloy could close his mouth,"},{"id":"semetey-1-2013:p1220:b003:l011","ordinal":169224,"en":"Hero Manas carved through"},{"id":"semetey-1-2013:p1220:b003:l012","ordinal":169225,"en":"Their center."},{"id":"semetey-1-2013:p1220:b003:l013","ordinal":169226,"en":"Almambet cut his way"},{"id":"semetey-1-2013:p1220:b003:l014","ordinal":169227,"en":"Around their flanks."},{"id":"semetey-1-2013:p1220:b003:l015","ordinal":169228,"en":"Hero Chubak hemmed in"},{"id":"semetey-1-2013:p1220:b003:l016","ordinal":169229,"en":"Their very center."},{"id":"semetey-1-2013:p1220:b003:l017","ordinal":169230,"en":"Khan Bakai raided"},{"id":"semetey-1-2013:p1220:b003:l018","ordinal":169231,"en":"One of their wings."},{"id":"semetey-1-2013:p1220:b003:l019","ordinal":169232,"en":"Hero Syrgak crushed"},{"id":"semetey-1-2013:p1220:b003:l020","ordinal":169233,"en":"Their outermost edge."},{"id":"semetey-1-2013:p1220:b003:l021","ordinal":169234,"en":"Agybay pierced"},{"id":"semetey-1-2013:p1220:b003:l022","ordinal":169235,"en":"One of their flanks."},{"id":"semetey-1-2013:p1220:b003:l023","ordinal":169236,"en":"Hero Kyrgylchal drove through"},{"id":"semetey-1-2013:p1220:b003:l024","ordinal":169237,"en":"The side by their throats."},{"id":"semetey-1-2013:p1220:b003:l025","ordinal":169238,"en":"Hero Shuutu laid waste"},{"id":"semetey-1-2013:p1220:b003:l026","ordinal":169239,"en":"One of their wings."},{"id":"semetey-1-2013:p1220:b003:l027","ordinal":169240,"en":"Raising the gray-mottled banner,"},{"id":"semetey-1-2013:p1220:b003:l028","ordinal":169241,"en":"The Chinese raised a wailing clamor."},{"id":"semetey-1-2013:p1220:b003:l029","ordinal":169242,"en":"Though it was said they would drive them off with blows,"},{"id":"semetey-1-2013:p1220:b003:l030","ordinal":169243,"en":"They slaughtered them as they drove them;"},{"id":"semetey-1-2013:p1220:b003:l031","ordinal":169244,"en":"Almambet, son of Aziz Khan,"},{"id":"semetey-1-2013:p1220:b003:l032","ordinal":169245,"en":"Unleashed extraordinary turmoil."},{"id":"semetey-1-2013:p1220:b003:l033","ordinal":169246,"en":"Khan Manas's forty companions—"},{"id":"semetey-1-2013:p1220:b003:l034","ordinal":169247,"en":"Told to take a cap, they took a head;"},{"id":"semetey-1-2013:p1220:b003:l035","ordinal":169248,"en":"Told to spill blood, they spilled demons;"},{"id":"semetey-1-2013:p1220:b003:l036","ordinal":169249,"en":"Told to drink water, they drank poison."},{"id":"semetey-1-2013:p1220:b003:l037","ordinal":169250,"en":"They unleashed a wondrous massacre;"},{"id":"semetey-1-2013:p1220:b003:l038","ordinal":169251,"en":"Every Chinese upon the plain"},{"id":"semetey-1-2013:p1220:b003:l039","ordinal":169252,"en":"Lay sprawled dead."},{"id":"semetey-1-2013:p1220:b004:l001","ordinal":169253,"en":"They unleashed the great slaughter."},{"id":"semetey-1-2013:p1220:b004:l002","ordinal":169254,"en":"They captured horses"},{"id":"semetey-1-2013:p1220:b004:l003","ordinal":169255,"en":"Worth a thousand times the prize."},{"id":"semetey-1-2013:p1220:b004:l004","ordinal":169256,"en":"Those who advanced to the front"},{"id":"semetey-1-2013:p1220:b004:l005","ordinal":169257,"en":"Each took seven thousand captured horses;"},{"id":"semetey-1-2013:p1220:b004:l006","ordinal":169258,"en":"The meek who could not reach them"},{"id":"semetey-1-2013:p1220:b004:l007","ordinal":169259,"en":"Each took seven hundred horses."},{"id":"semetey-1-2013:p1220:b004:l008","ordinal":169260,"en":"The crust of the earth was torn open;"},{"id":"semetey-1-2013:p1220:b004:l009","ordinal":169261,"en":"The Muslims went away"},{"id":"semetey-1-2013:p1220:b004:l010","ordinal":169262,"en":"Sated with prizes."},{"id":"semetey-1-2013:p1220:b004:l011","ordinal":169263,"en":"Standing face to face,"},{"id":"semetey-1-2013:p1220:b004:l012","ordinal":169264,"en":"Firing guns and drawing bows,"},{"id":"semetey-1-2013:p1220:b004:l013","ordinal":169265,"en":"They fought without fleeing."},{"id":"semetey-1-2013:p1220:b004:l014","ordinal":169266,"en":"Seven banners brought from Mecca"},{"id":"semetey-1-2013:p1220:b004:l015","ordinal":169267,"en":"They planted in seven places,"},{"id":"semetey-1-2013:p1220:b004:l016","ordinal":169268,"en":"Slaughtering wherever they reached."},{"id":"semetey-1-2013:p1220:b004:l017","ordinal":169269,"en":"Among the Black Chinese and Manchus,"},{"id":"semetey-1-2013:p1220:b004:l018","ordinal":169270,"en":"Only a few common folk"},{"id":"semetey-1-2013:p1220:b004:l019","ordinal":169271,"en":"Escaped by fleeing."},{"id":"semetey-1-2013:p1220:b004:l020","ordinal":169272,"en":"Manas found the booty"},{"id":"semetey-1-2013:p1220:b004:l021","ordinal":169273,"en":"And ten thousand Kalmyk households"},{"id":"semetey-1-2013:p1220:b004:l022","ordinal":169274,"en":"He raided and devastated."},{"id":"semetey-1-2013:p1220:b004:l023","ordinal":169275,"en":"They took the gold as booty"},{"id":"semetey-1-2013:p1220:b004:l024","ordinal":169276,"en":"And drove off the livestock, fully sated."},{"id":"semetey-1-2013:p1220:b004:l025","ordinal":169277,"en":"So many camel colts, so many goods—"},{"id":"semetey-1-2013:p1220:b004:l026","ordinal":169278,"en":"They could not load them all;"},{"id":"semetey-1-2013:p1220:b004:l027","ordinal":169279,"en":"So many noble young wives and beautiful girls—"},{"id":"semetey-1-2013:p1220:b004:l028","ordinal":169280,"en":"They could not divide them all."},{"id":"semetey-1-2013:p1220:b004:l029","ordinal":169281,"en":"The Kalmyks who faced them"},{"id":"semetey-1-2013:p1220:b004:l030","ordinal":169282,"en":"Stood on opposite banks;"},{"id":"semetey-1-2013:p1220:b004:l031","ordinal":169283,"en":"Between them lay a great river."},{"id":"semetey-1-2013:p1220:b004:l032","ordinal":169284,"en":"Unable to reach with spears,"},{"id":"semetey-1-2013:p1220:b004:l033","ordinal":169285,"en":"They fought with guns."},{"id":"semetey-1-2013:p1220:b004:l034","ordinal":169286,"en":"As they exchanged battle cries,"},{"id":"semetey-1-2013:p1220:b004:l035","ordinal":169287,"en":"The expert Almambet"},{"id":"semetey-1-2013:p1220:b004:l036","ordinal":169288,"en":"Shot Joloy's Achbuudan"},{"id":"semetey-1-2013:p1220:b004:l037","ordinal":169289,"en":"On the farther bank,"},{"id":"semetey-1-2013:p1220:b004:l038","ordinal":169290,"en":"Trapping many of them,"},{"id":"semetey-1-2013:p1220:b004:l039","ordinal":169291,"en":"Some ten thousand Kalmyk households."},{"id":"semetey-1-2013:p1221:b003:l001","ordinal":169292,"en":"He had Khan Manas plunder them."},{"id":"semetey-1-2013:p1221:b003:l002","ordinal":169293,"en":"They had gone as guests"},{"id":"semetey-1-2013:p1221:b003:l003","ordinal":169294,"en":"To Kökötöy's feast and turned back,"},{"id":"semetey-1-2013:p1221:b003:l004","ordinal":169295,"en":"Intending to use force,"},{"id":"semetey-1-2013:p1221:b003:l005","ordinal":169296,"en":"Only to lose Achbuudan."},{"id":"semetey-1-2013:p1221:b003:l006","ordinal":169297,"en":"Many men fell to bullets;"},{"id":"semetey-1-2013:p1221:b003:l007","ordinal":169298,"en":"Many had their hands bound."},{"id":"semetey-1-2013:p1221:b003:l008","ordinal":169299,"en":"Many Black Kalmyks and Manchus"},{"id":"semetey-1-2013:p1221:b003:l009","ordinal":169300,"en":"Who had come against Manas"},{"id":"semetey-1-2013:p1221:b003:l010","ordinal":169301,"en":"Were captured as booty."},{"id":"semetey-1-2013:p1221:b003:l011","ordinal":169302,"en":"The bloodthirsty lion Manas the leopard"},{"id":"semetey-1-2013:p1221:b003:l012","ordinal":169303,"en":"Made a massacre there"},{"id":"semetey-1-2013:p1221:b003:l013","ordinal":169304,"en":"Of the teeming Chinese and Manchus."},{"id":"semetey-1-2013:p1221:b003:l014","ordinal":169305,"en":"While the falcon Manas lived,"},{"id":"semetey-1-2013:p1221:b003:l015","ordinal":169306,"en":"He brought great turmoil upon the Chinese;"},{"id":"semetey-1-2013:p1221:b003:l016","ordinal":169307,"en":"It was plain that he was a hero."},{"id":"semetey-1-2013:p1221:b003:l017","ordinal":169308,"en":"“Bloodthirsty Manas the leopard"},{"id":"semetey-1-2013:p1221:b003:l018","ordinal":169309,"en":"Will devour us,” they said,"},{"id":"semetey-1-2013:p1221:b003:l019","ordinal":169310,"en":"And the khan of the Black Kalmyks and Manchus"},{"id":"semetey-1-2013:p1221:b003:l020","ordinal":169311,"en":"Despaired of his life."},{"id":"semetey-1-2013:p1221:b003:l021","ordinal":169312,"en":"His turmoil became known to the people."},{"id":"semetey-1-2013:p1221:b003:l022","ordinal":169313,"en":"Had that Manas not been there,"},{"id":"semetey-1-2013:p1221:b003:l023","ordinal":169314,"en":"At Kökötöy's feast"},{"id":"semetey-1-2013:p1221:b003:l024","ordinal":169315,"en":"They would have cropped ears short,"},{"id":"semetey-1-2013:p1221:b003:l025","ordinal":169316,"en":"Dug deep pits,"},{"id":"semetey-1-2013:p1221:b003:l026","ordinal":169317,"en":"And brewed utter misery."},{"id":"semetey-1-2013:p1221:b003:l027","ordinal":169318,"en":"When they were about to dig a well in the place of honor"},{"id":"semetey-1-2013:p1221:b003:l028","ordinal":169319,"en":"And scatter the four kinds of livestock,"},{"id":"semetey-1-2013:p1221:b003:l029","ordinal":169320,"en":"Would they not have unleashed"},{"id":"semetey-1-2013:p1221:b003:l030","ordinal":169321,"en":"Unsparing turmoil?"},{"id":"semetey-1-2013:p1221:b003:l031","ordinal":169322,"en":"Did he not save the palm-sized Muslims"},{"id":"semetey-1-2013:p1221:b003:l032","ordinal":169323,"en":"And keep those Chinese"},{"id":"semetey-1-2013:p1221:b003:l033","ordinal":169324,"en":"From slaughtering them?"},{"id":"semetey-1-2013:p1221:b003:l034","ordinal":169325,"en":"The Chinese did not quell their strife;"},{"id":"semetey-1-2013:p1221:b003:l035","ordinal":169326,"en":"When they were about to slaughter everyone,"},{"id":"semetey-1-2013:p1221:b003:l036","ordinal":169327,"en":"Manas the leopard protected them."},{"id":"semetey-1-2013:p1221:b003:l037","ordinal":169328,"en":"Their cuirasses hanging loose,"},{"id":"semetey-1-2013:p1221:b003:l038","ordinal":169329,"en":"I saw all their khans"},{"id":"semetey-1-2013:p1221:b003:l039","ordinal":169330,"en":"In the place where they panicked."},{"id":"semetey-1-2013:p1221:b004:l001","ordinal":169331,"en":"I saw the place where Sultan Manas the bloodthirsty"},{"id":"semetey-1-2013:p1221:b004:l002","ordinal":169332,"en":"Suppressed"},{"id":"semetey-1-2013:p1221:b004:l003","ordinal":169333,"en":"Their murderous turmoil."},{"id":"semetey-1-2013:p1221:b004:l004","ordinal":169334,"en":"I saw the place where he brought"},{"id":"semetey-1-2013:p1221:b004:l005","ordinal":169335,"en":"Turmoil upon the whole world."},{"id":"semetey-1-2013:p1221:b004:l006","ordinal":169336,"en":"I saw the place where he separated"},{"id":"semetey-1-2013:p1221:b004:l007","ordinal":169337,"en":"The palm-sized Muslims"},{"id":"semetey-1-2013:p1221:b004:l008","ordinal":169338,"en":"From the Chinese and rescued them."},{"id":"semetey-1-2013:p1221:b004:l009","ordinal":169339,"en":"Had that Manas not been there,"},{"id":"semetey-1-2013:p1221:b004:l010","ordinal":169340,"en":"Would the Black Manchus and Chinese"},{"id":"semetey-1-2013:p1221:b004:l011","ordinal":169341,"en":"Not have drawn the line"},{"id":"semetey-1-2013:p1221:b004:l012","ordinal":169342,"en":"And made sport of them?"},{"id":"semetey-1-2013:p1221:b004:l013","ordinal":169343,"en":"They would have driven them away into slavery"},{"id":"semetey-1-2013:p1221:b004:l014","ordinal":169344,"en":"And brought them to their end."},{"id":"semetey-1-2013:p1221:b004:l015","ordinal":169345,"en":"When they were about to slaughter"},{"id":"semetey-1-2013:p1221:b004:l016","ordinal":169346,"en":"The Muslim giants,"},{"id":"semetey-1-2013:p1221:b004:l017","ordinal":169347,"en":"Khan Koshoi of the Katagan"},{"id":"semetey-1-2013:p1221:b004:l018","ordinal":169348,"en":"Fled out from among the people."},{"id":"semetey-1-2013:p1221:b004:l019","ordinal":169349,"en":"Jamgyrchy of the Eshtek"},{"id":"semetey-1-2013:p1221:b004:l020","ordinal":169350,"en":"Despaired of his own life"},{"id":"semetey-1-2013:p1221:b004:l021","ordinal":169351,"en":"And panicked helplessly."},{"id":"semetey-1-2013:p1221:b004:l022","ordinal":169352,"en":"I saw then that dear blue-maned Manas"},{"id":"semetey-1-2013:p1221:b004:l023","ordinal":169353,"en":"Was a lion."},{"id":"semetey-1-2013:p1221:b004:l024","ordinal":169354,"en":"I saw that he was a hero,"},{"id":"semetey-1-2013:p1221:b004:l025","ordinal":169355,"en":"Different and surpassing other mortals."},{"id":"semetey-1-2013:p1221:b004:l026","ordinal":169356,"en":"Blaze-headed thoroughbred among horses—"},{"id":"semetey-1-2013:p1221:b004:l027","ordinal":169357,"en":"Amid that massacre,"},{"id":"semetey-1-2013:p1221:b004:l028","ordinal":169358,"en":"Agybay, Bakai, and Almambet,"},{"id":"semetey-1-2013:p1221:b004:l029","ordinal":169359,"en":"Along with Chubak,"},{"id":"semetey-1-2013:p1221:b004:l030","ordinal":169360,"en":"Were heroes born for honor."},{"id":"semetey-1-2013:p1221:b004:l031","ordinal":169361,"en":"You keep saying, Chynkozho,"},{"id":"semetey-1-2013:p1221:b004:l032","ordinal":169362,"en":"“I will seize"},{"id":"semetey-1-2013:p1221:b004:l033","ordinal":169363,"en":"Famous blue-maned Manas's daughter-in-law.”"},{"id":"semetey-1-2013:p1221:b004:l034","ordinal":169364,"en":"“God-stricken words!"},{"id":"semetey-1-2013:p1221:b004:l035","ordinal":169365,"en":"You have acted by force, Chynkozho."},{"id":"semetey-1-2013:p1221:b004:l036","ordinal":169366,"en":"Will Semetey, born of Manas,"},{"id":"semetey-1-2013:p1221:b004:l037","ordinal":169367,"en":"Submit to your violence?"},{"id":"semetey-1-2013:p1221:b004:l038","ordinal":169368,"en":"Let it go, Chynkozho;"},{"id":"semetey-1-2013:p1221:b004:l039","ordinal":169369,"en":"Will he give us his wife?"},{"id":"semetey-1-2013:p1222:b003:l001","ordinal":169370,"en":"His dwelling place is broad Talas;"},{"id":"semetey-1-2013:p1222:b003:l002","ordinal":169371,"en":"That is no cheap land."},{"id":"semetey-1-2013:p1222:b003:l003","ordinal":169372,"en":"Would he give us his wife?"},{"id":"semetey-1-2013:p1222:b003:l004","ordinal":169373,"en":"Semetey is no easy hero."},{"id":"semetey-1-2013:p1222:b003:l005","ordinal":169374,"en":"You have courage, wretched slave;"},{"id":"semetey-1-2013:p1222:b003:l006","ordinal":169375,"en":"You are the very strongest."},{"id":"semetey-1-2013:p1222:b003:l007","ordinal":169376,"en":"Parted in your bewilderment"},{"id":"semetey-1-2013:p1222:b003:l008","ordinal":169377,"en":"From your ancient Kyrgyz people,"},{"id":"semetey-1-2013:p1222:b003:l009","ordinal":169378,"en":"What have you become, commoner?"},{"id":"semetey-1-2013:p1222:b003:l010","ordinal":169379,"en":"Manas was no ordinary khan;"},{"id":"semetey-1-2013:p1222:b003:l011","ordinal":169380,"en":"Semetey, son of Manas,"},{"id":"semetey-1-2013:p1222:b003:l012","ordinal":169381,"en":"Will not give us his wife."},{"id":"semetey-1-2013:p1222:b003:l013","ordinal":169382,"en":"Today we shall seize"},{"id":"semetey-1-2013:p1222:b003:l014","ordinal":169383,"en":"And take Aychürök by force;"},{"id":"semetey-1-2013:p1222:b003:l015","ordinal":169384,"en":"Tomorrow, watch and see,"},{"id":"semetey-1-2013:p1222:b003:l016","ordinal":169385,"en":"We shall all fall into torment."},{"id":"semetey-1-2013:p1222:b003:l017","ordinal":169386,"en":"Brave Bakai, son of a saint,"},{"id":"semetey-1-2013:p1222:b003:l018","ordinal":169387,"en":"Will not leave you unharmed if you live;"},{"id":"semetey-1-2013:p1222:b003:l019","ordinal":169388,"en":"He was a man who had seen much."},{"id":"semetey-1-2013:p1222:b003:l020","ordinal":169389,"en":"If Bakai comes, he will not leave us unharmed."},{"id":"semetey-1-2013:p1222:b003:l021","ordinal":169390,"en":"Let it go, Kozho, my dear friend;"},{"id":"semetey-1-2013:p1222:b003:l022","ordinal":169391,"en":"There is a great flaw in your words."},{"id":"semetey-1-2013:p1222:b003:l023","ordinal":169392,"en":"Will he agree to what you say?"},{"id":"semetey-1-2013:p1222:b003:l024","ordinal":169393,"en":"Will he give us his widow?"},{"id":"semetey-1-2013:p1222:b003:l025","ordinal":169394,"en":"Chynkozho, son of Shygay,"},{"id":"semetey-1-2013:p1222:b003:l026","ordinal":169395,"en":"These words of yours are not right."},{"id":"semetey-1-2013:p1222:b003:l027","ordinal":169396,"en":"Semetey, son of Manas,"},{"id":"semetey-1-2013:p1222:b003:l028","ordinal":169397,"en":"Is no slave who would give us his wife."},{"id":"semetey-1-2013:p1222:b003:l029","ordinal":169398,"en":"All the saints came together;"},{"id":"semetey-1-2013:p1222:b003:l030","ordinal":169399,"en":"He is a son formed by their sovereign."},{"id":"semetey-1-2013:p1222:b003:l031","ordinal":169400,"en":"Kanykei and Manas together"},{"id":"semetey-1-2013:p1222:b003:l032","ordinal":169401,"en":"Pieced this son together."},{"id":"semetey-1-2013:p1222:b003:l033","ordinal":169402,"en":"Before the multitude, he was a son"},{"id":"semetey-1-2013:p1222:b003:l034","ordinal":169403,"en":"They asked God to grant."},{"id":"semetey-1-2013:p1222:b003:l035","ordinal":169404,"en":"He is the spring flowing from the valley,"},{"id":"semetey-1-2013:p1222:b003:l036","ordinal":169405,"en":"The lamp that blue-maned Manas himself"},{"id":"semetey-1-2013:p1222:b003:l037","ordinal":169406,"en":"Desired and received."},{"id":"semetey-1-2013:p1222:b003:l038","ordinal":169407,"en":"If we seize and take his wife,"},{"id":"semetey-1-2013:p1222:b003:l039","ordinal":169408,"en":"Will he stand watching without a quarrel?"},{"id":"semetey-1-2013:p1222:b004:l001","ordinal":169409,"en":"Kozho, you have blustering words"},{"id":"semetey-1-2013:p1222:b004:l002","ordinal":169410,"en":"That bring you disgrace."},{"id":"semetey-1-2013:p1222:b004:l003","ordinal":169411,"en":"If we take his wife,"},{"id":"semetey-1-2013:p1222:b004:l004","ordinal":169412,"en":"Semetey, son of Manas,"},{"id":"semetey-1-2013:p1222:b004:l005","ordinal":169413,"en":"May bring a great slaughter upon us."},{"id":"semetey-1-2013:p1222:b004:l006","ordinal":169414,"en":"If we seize and take Chürök,"},{"id":"semetey-1-2013:p1222:b004:l007","ordinal":169415,"en":"When Semetey comes tomorrow,"},{"id":"semetey-1-2013:p1222:b004:l008","ordinal":169416,"en":"Will he not make"},{"id":"semetey-1-2013:p1222:b004:l009","ordinal":169417,"en":"Your great Kyrgyz settlement boil in misery?"},{"id":"semetey-1-2013:p1222:b004:l010","ordinal":169418,"en":"When Semetey sweeps down upon us,"},{"id":"semetey-1-2013:p1222:b004:l011","ordinal":169419,"en":"Will he not show us wonders?"},{"id":"semetey-1-2013:p1222:b004:l012","ordinal":169420,"en":"Let us not fall into calamity;"},{"id":"semetey-1-2013:p1222:b004:l013","ordinal":169421,"en":"Poor Kozho, heed my words,"},{"id":"semetey-1-2013:p1222:b004:l014","ordinal":169422,"en":"Let us not take Aychürök."},{"id":"semetey-1-2013:p1222:b004:l015","ordinal":169423,"en":"What shall we do with Chürök?"},{"id":"semetey-1-2013:p1222:b004:l016","ordinal":169424,"en":"While we are safe and sound,"},{"id":"semetey-1-2013:p1222:b004:l017","ordinal":169425,"en":"Come, Kozho, let us leave."},{"id":"semetey-1-2013:p1222:b004:l018","ordinal":169426,"en":"Let us not take the beautiful girl Chürök;"},{"id":"semetey-1-2013:p1222:b004:l019","ordinal":169427,"en":"Let us not fall into calamity."},{"id":"semetey-1-2013:p1222:b004:l020","ordinal":169428,"en":"You have courage, laughable man;"},{"id":"semetey-1-2013:p1222:b004:l021","ordinal":169429,"en":"You say you are Manas's equal."},{"id":"semetey-1-2013:p1222:b004:l022","ordinal":169430,"en":"Many Argyn fill Jeti-Özön;"},{"id":"semetey-1-2013:p1222:b004:l023","ordinal":169431,"en":"You are truly accomplished,"},{"id":"semetey-1-2013:p1222:b004:l024","ordinal":169432,"en":"So what have you become, commoner?"},{"id":"semetey-1-2013:p1222:b004:l025","ordinal":169433,"en":"For now, while you swagger,"},{"id":"semetey-1-2013:p1222:b004:l026","ordinal":169434,"en":"Let us not seize Aychürök."},{"id":"semetey-1-2013:p1222:b004:l027","ordinal":169435,"en":"Setting out to take Aychürök,"},{"id":"semetey-1-2013:p1222:b004:l028","ordinal":169436,"en":"We are only a small people;"},{"id":"semetey-1-2013:p1222:b004:l029","ordinal":169437,"en":"Let us not all fall into torment.”"},{"id":"semetey-1-2013:p1222:b004:l030","ordinal":169438,"en":"When Toltoy said this,"},{"id":"semetey-1-2013:p1222:b004:l031","ordinal":169439,"en":"Chynkozho, son of Shygay,"},{"id":"semetey-1-2013:p1222:b004:l032","ordinal":169440,"en":"Flared up in anger,"},{"id":"semetey-1-2013:p1222:b004:l033","ordinal":169441,"en":"Made ready like a hawk,"},{"id":"semetey-1-2013:p1222:b004:l034","ordinal":169442,"en":"And found a quarrel where none existed."},{"id":"semetey-1-2013:p1222:b004:l035","ordinal":169443,"en":"“Look at what"},{"id":"semetey-1-2013:p1222:b004:l036","ordinal":169444,"en":"That fucking Toltoy is doing!"},{"id":"semetey-1-2013:p1222:b004:l037","ordinal":169445,"en":"Thinking the Jediger of Jeti-Özön"},{"id":"semetey-1-2013:p1222:b004:l038","ordinal":169446,"en":"Were a true people, I came here;"},{"id":"semetey-1-2013:p1222:b004:l039","ordinal":169447,"en":"When you migrated from your homeland,"},{"id":"semetey-1-2013:p1223:b003:l001","ordinal":169448,"en":"You buried-in-earth Toltoi,"},{"id":"semetey-1-2013:p1223:b003:l002","ordinal":169449,"en":"I came thinking you were a lion."},{"id":"semetey-1-2013:p1223:b003:l003","ordinal":169450,"en":"If an enemy faced us,"},{"id":"semetey-1-2013:p1223:b003:l004","ordinal":169451,"en":"I came thinking you would be our support;"},{"id":"semetey-1-2013:p1223:b003:l005","ordinal":169452,"en":"But you think of impossible things—"},{"id":"semetey-1-2013:p1223:b003:l006","ordinal":169453,"en":"You are infidel Toltoi."},{"id":"semetey-1-2013:p1223:b003:l007","ordinal":169454,"en":"Fleeing from a woman in a stagger,"},{"id":"semetey-1-2013:p1223:b003:l008","ordinal":169455,"en":"You are womanly Toltoi."},{"id":"semetey-1-2013:p1223:b003:l009","ordinal":169456,"en":"Paying no heed to salt and bread,"},{"id":"semetey-1-2013:p1223:b003:l010","ordinal":169457,"en":"You are a Toltoi who has prospered."},{"id":"semetey-1-2013:p1223:b003:l011","ordinal":169458,"en":"Thinking of every kind of thing,"},{"id":"semetey-1-2013:p1223:b003:l012","ordinal":169459,"en":"You are fine Toltoi;"},{"id":"semetey-1-2013:p1223:b003:l013","ordinal":169460,"en":"Frightened today by yesterday's dream,"},{"id":"semetey-1-2013:p1223:b003:l014","ordinal":169461,"en":"You are shaman Toltoi."},{"id":"semetey-1-2013:p1223:b003:l015","ordinal":169462,"en":"At Kökötöi's feast,"},{"id":"semetey-1-2013:p1223:b003:l016","ordinal":169463,"en":"A great sage who saw much—"},{"id":"semetey-1-2013:p1223:b003:l017","ordinal":169464,"en":"You are old Toltoi;"},{"id":"semetey-1-2013:p1223:b003:l018","ordinal":169465,"en":"Knowing well that you will die,"},{"id":"semetey-1-2013:p1223:b003:l019","ordinal":169466,"en":"You are saint Toltoi."},{"id":"semetey-1-2013:p1223:b003:l020","ordinal":169467,"en":"While standing at Zheti-Özön,"},{"id":"semetey-1-2013:p1223:b003:l021","ordinal":169468,"en":"Saying you would take a wife,"},{"id":"semetey-1-2013:p1223:b003:l022","ordinal":169469,"en":"You are industrious Toltoi."},{"id":"semetey-1-2013:p1223:b003:l023","ordinal":169470,"en":"Knowing that you yourself will die,"},{"id":"semetey-1-2013:p1223:b003:l024","ordinal":169471,"en":"You are dreamer Toltoi."},{"id":"semetey-1-2013:p1223:b003:l025","ordinal":169472,"en":"Toltoi has indeed gone about"}]
