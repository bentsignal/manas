[{"id":"seytek-2012:p0926:b003:l020","ordinal":367873,"en":"Buttoned her armor over her whole body"},{"id":"seytek-2012:p0926:b003:l021","ordinal":367874,"en":"And covered her full face."},{"id":"seytek-2012:p0926:b003:l022","ordinal":367875,"en":"Her lionhearted nature became clear;"},{"id":"seytek-2012:p0926:b003:l023","ordinal":367876,"en":"She donned arrow-proof steel."},{"id":"seytek-2012:p0926:b003:l024","ordinal":367877,"en":"She rejoiced at the word “enemy”;"},{"id":"seytek-2012:p0926:b003:l025","ordinal":367878,"en":"The warrior maiden by name"},{"id":"seytek-2012:p0926:b003:l026","ordinal":367879,"en":"Unleashed a great battle."},{"id":"seytek-2012:p0926:b003:l027","ordinal":367880,"en":"What regret could such a noble soul have?"},{"id":"seytek-2012:p0926:b003:l028","ordinal":367881,"en":"Her valor was renowned,"},{"id":"seytek-2012:p0926:b003:l029","ordinal":367882,"en":"Her wolf-like courage plain to see."},{"id":"seytek-2012:p0926:b003:l030","ordinal":367883,"en":"At the sight of the foe, her eyes blazed;"},{"id":"seytek-2012:p0926:b003:l031","ordinal":367884,"en":"Bloodlust gripped her firmly,"},{"id":"seytek-2012:p0926:b003:l032","ordinal":367885,"en":"And she ground her teeth with a crack."},{"id":"seytek-2012:p0926:b003:l033","ordinal":367886,"en":"Her apple-round neck stretched,"},{"id":"seytek-2012:p0926:b003:l034","ordinal":367887,"en":"Her eyes reddened like a lion's;"},{"id":"seytek-2012:p0926:b003:l035","ordinal":367888,"en":"She girded her slender waist,"},{"id":"seytek-2012:p0926:b003:l036","ordinal":367889,"en":"Cantered forth and left the army."},{"id":"seytek-2012:p0926:b003:l037","ordinal":367890,"en":"Her bearing and majesty,"},{"id":"seytek-2012:p0926:b003:l038","ordinal":367891,"en":"Her proud and fearsome countenance,"},{"id":"seytek-2012:p0926:b003:l039","ordinal":367892,"en":"Made her seem like a ravening beast."},{"id":"seytek-2012:p0926:b003:l040","ordinal":367893,"en":"She took up her weapons, eager for battle."},{"id":"seytek-2012:p0927:b002:l001","ordinal":367894,"en":"Glancing to either side,"},{"id":"seytek-2012:p0927:b002:l002","ordinal":367895,"en":"The fierce warrior of old"},{"id":"seytek-2012:p0927:b002:l003","ordinal":367896,"en":"Licked her lips,"},{"id":"seytek-2012:p0927:b002:l004","ordinal":367897,"en":"Writhing like a dragon,"},{"id":"seytek-2012:p0927:b002:l005","ordinal":367898,"en":"Crouching like a lion,"},{"id":"seytek-2012:p0927:b002:l006","ordinal":367899,"en":"Gathering her wrath and making ready,"},{"id":"seytek-2012:p0927:b002:l007","ordinal":367900,"en":"She prayed to the Creator:"},{"id":"seytek-2012:p0927:b002:l008","ordinal":367901,"en":"“Let me spill the madman’s blood;"},{"id":"seytek-2012:p0927:b002:l009","ordinal":367902,"en":"Do not let me be utterly disgraced,"},{"id":"seytek-2012:p0927:b002:l010","ordinal":367903,"en":"God, grant me honor."},{"id":"seytek-2012:p0927:b002:l011","ordinal":367904,"en":"If at the madman’s hands"},{"id":"seytek-2012:p0927:b002:l012","ordinal":367905,"en":"I fall, I shall die without renown;"},{"id":"seytek-2012:p0927:b002:l013","ordinal":367906,"en":"‘The wretched champion died,’ they will say,"},{"id":"seytek-2012:p0927:b002:l014","ordinal":367907,"en":"And I have no people to bury me with honor."},{"id":"seytek-2012:p0927:b002:l015","ordinal":367908,"en":"My heart is heavy, my breast aflame;"},{"id":"seytek-2012:p0927:b002:l016","ordinal":367909,"en":"No grief is worse than sorrow."},{"id":"seytek-2012:p0927:b002:l017","ordinal":367910,"en":"Almighty God, Creator,"},{"id":"seytek-2012:p0927:b002:l018","ordinal":367911,"en":"There is no recourse but You."},{"id":"seytek-2012:p0927:b002:l019","ordinal":367912,"en":"Sarybay is the one I shall confront;"},{"id":"seytek-2012:p0927:b002:l020","ordinal":367913,"en":"I have begun a savage fight."},{"id":"seytek-2012:p0927:b002:l021","ordinal":367914,"en":"I have no support to rely on,"},{"id":"seytek-2012:p0927:b002:l022","ordinal":367915,"en":"No trusted comrades at my side,"},{"id":"seytek-2012:p0927:b002:l023","ordinal":367916,"en":"No people in whom to place my hope."},{"id":"seytek-2012:p0927:b002:l024","ordinal":367917,"en":"Against this infidel in his full strength"},{"id":"seytek-2012:p0927:b002:l025","ordinal":367918,"en":"I have entered combat—God, aid me!"},{"id":"seytek-2012:p0927:b002:l026","ordinal":367919,"en":"We are but women by name;"},{"id":"seytek-2012:p0927:b002:l027","ordinal":367920,"en":"God, aid this sorrowing one!”"},{"id":"seytek-2012:p0927:b002:l028","ordinal":367921,"en":"So saying, Kuyaly"},{"id":"seytek-2012:p0927:b002:l029","ordinal":367922,"en":"Did not glance around,"},{"id":"seytek-2012:p0927:b002:l030","ordinal":367923,"en":"Never thinking she might die,"},{"id":"seytek-2012:p0927:b002:l031","ordinal":367924,"en":"Did not look from side to side,"},{"id":"seytek-2012:p0927:b002:l032","ordinal":367925,"en":"And spared not her thread-thin life."},{"id":"seytek-2012:p0927:b002:l033","ordinal":367926,"en":"Beneath her was Zhelzhetpes;"},{"id":"seytek-2012:p0927:b002:l034","ordinal":367927,"en":"She drove him right and left,"},{"id":"seytek-2012:p0927:b002:l035","ordinal":367928,"en":"Lashing him on either flank."},{"id":"seytek-2012:p0927:b002:l036","ordinal":367929,"en":"At her cry the charger thundered,"},{"id":"seytek-2012:p0927:b002:l037","ordinal":367930,"en":"And wherever his body struck,"},{"id":"seytek-2012:p0927:b002:l038","ordinal":367931,"en":"The earth burst into ridges."},{"id":"seytek-2012:p0927:b002:l039","ordinal":367932,"en":"The warrior maiden upon him,"},{"id":"seytek-2012:p0927:b002:l040","ordinal":367933,"en":"Whose opponent was Sarybay,"},{"id":"seytek-2012:p0927:b003:l001","ordinal":367934,"en":"Faced a notorious foe such as this."},{"id":"seytek-2012:p0927:b003:l002","ordinal":367935,"en":"Her charger gathered beneath her,"},{"id":"seytek-2012:p0927:b003:l003","ordinal":367936,"en":"While the warrior maiden above"},{"id":"seytek-2012:p0927:b003:l004","ordinal":367937,"en":"Frowned without blinking,"},{"id":"seytek-2012:p0927:b003:l005","ordinal":367938,"en":"Laughed aloud in delight,"},{"id":"seytek-2012:p0927:b003:l006","ordinal":367939,"en":"And rode on blithely, ringing like steel."},{"id":"seytek-2012:p0927:b003:l007","ordinal":367940,"en":"Though they called Sarybay a champion,"},{"id":"seytek-2012:p0927:b003:l008","ordinal":367941,"en":"She did not count him worth her boot-tip."},{"id":"seytek-2012:p0927:b003:l009","ordinal":367942,"en":"Courage and lionheartedness,"},{"id":"seytek-2012:p0927:b003:l010","ordinal":367943,"en":"Cunning and dexterity,"},{"id":"seytek-2012:p0927:b003:l011","ordinal":367944,"en":"A mind well cultivated and eyes keen,"},{"id":"seytek-2012:p0927:b003:l012","ordinal":367945,"en":"And unstinting inspiration—"},{"id":"seytek-2012:p0927:b003:l013","ordinal":367946,"en":"All these the Almighty"},{"id":"seytek-2012:p0927:b003:l014","ordinal":367947,"en":"Had bestowed upon this girl beyond measure."},{"id":"seytek-2012:p0927:b003:l015","ordinal":367948,"en":"She looked neither up nor down,"},{"id":"seytek-2012:p0927:b003:l016","ordinal":367949,"en":"Never thinking she might die."},{"id":"seytek-2012:p0927:b003:l017","ordinal":367950,"en":"The peerless warrior maiden"},{"id":"seytek-2012:p0927:b003:l018","ordinal":367951,"en":"Rejoiced at the thought of death,"},{"id":"seytek-2012:p0927:b003:l019","ordinal":367952,"en":"Showing herself a true hero."},{"id":"seytek-2012:p0927:b003:l020","ordinal":367953,"en":"When she turned her charger’s head,"},{"id":"seytek-2012:p0927:b003:l021","ordinal":367954,"en":"Her well-shafted spear was steel;"},{"id":"seytek-2012:p0927:b003:l022","ordinal":367955,"en":"When she leveled it with a thunderous roar,"},{"id":"seytek-2012:p0927:b003:l023","ordinal":367956,"en":"The one she would fight was Sarybay,"},{"id":"seytek-2012:p0927:b003:l024","ordinal":367957,"en":"The one she would confront was such a foe."},{"id":"seytek-2012:p0927:b003:l025","ordinal":367958,"en":"A fierce one with stony courage,"},{"id":"seytek-2012:p0927:b003:l026","ordinal":367959,"en":"A hero at heart with a warrior’s arm,"},{"id":"seytek-2012:p0927:b003:l027","ordinal":367960,"en":"To that infidel Sarybay"},{"id":"seytek-2012:p0927:b003:l028","ordinal":367961,"en":"She became a crushing menace."},{"id":"seytek-2012:p0927:b003:l029","ordinal":367962,"en":"With no regret even in death,"},{"id":"seytek-2012:p0927:b003:l030","ordinal":367963,"en":"Kuyaly unleashed a mighty battle."},{"id":"seytek-2012:p0927:b003:l031","ordinal":367964,"en":"The renowned warrior maiden,"},{"id":"seytek-2012:p0927:b003:l032","ordinal":367965,"en":"Through countless contests and countless feuds,"},{"id":"seytek-2012:p0927:b003:l033","ordinal":367966,"en":"Had met foes and spread havoc."},{"id":"seytek-2012:p0927:b003:l034","ordinal":367967,"en":"She had won acclaim in many lands"},{"id":"seytek-2012:p0927:b003:l035","ordinal":367968,"en":"And was called the lioness."},{"id":"seytek-2012:p0927:b003:l036","ordinal":367969,"en":"God made straight her path;"},{"id":"seytek-2012:p0927:b003:l037","ordinal":367970,"en":"The spirit of the road and Shayaba"},{"id":"seytek-2012:p0927:b003:l038","ordinal":367971,"en":"Both upheld her together,"},{"id":"seytek-2012:p0927:b003:l039","ordinal":367972,"en":"Guiding her wherever she advanced,"},{"id":"seytek-2012:p0927:b003:l040","ordinal":367973,"en":"And strengthening her whenever foes confronted her."},{"id":"seytek-2012:p0928:b002:l001","ordinal":367974,"en":"Her name was heard throughout the world;"},{"id":"seytek-2012:p0928:b002:l002","ordinal":367975,"en":"Many who had heard with their ears and seen with their eyes"},{"id":"seytek-2012:p0928:b002:l003","ordinal":367976,"en":"Knew well"},{"id":"seytek-2012:p0928:b002:l004","ordinal":367977,"en":"That none like her had ever been."},{"id":"seytek-2012:p0928:b002:l005","ordinal":367978,"en":"She charged straight at Sarybay,"},{"id":"seytek-2012:p0928:b002:l006","ordinal":367979,"en":"Raising her weapon like Zulfiqar,"},{"id":"seytek-2012:p0928:b002:l007","ordinal":367980,"en":"Her spear made ready,"},{"id":"seytek-2012:p0928:b002:l008","ordinal":367981,"en":"Straining and crouching for the charge."},{"id":"seytek-2012:p0928:b002:l009","ordinal":367982,"en":"“I shall reach him before an arrow,” she thought,"},{"id":"seytek-2012:p0928:b002:l010","ordinal":367983,"en":"And rushed forward with leveled spear;"},{"id":"seytek-2012:p0928:b002:l011","ordinal":367984,"en":"“I shall smash him utterly.”"},{"id":"seytek-2012:p0928:b002:l012","ordinal":367985,"en":"No sooner conceived than done:"},{"id":"seytek-2012:p0928:b002:l013","ordinal":367986,"en":"Power boiled and strength swelled,"},{"id":"seytek-2012:p0928:b002:l014","ordinal":367987,"en":"And the formidable champion transformed,"},{"id":"seytek-2012:p0928:b002:l015","ordinal":367988,"en":"Shouting at the madman"},{"id":"seytek-2012:p0928:b002:l016","ordinal":367989,"en":"As she unleashed her terrible wrath."},{"id":"seytek-2012:p0928:b002:l017","ordinal":367990,"en":"The life given by Almighty God"},{"id":"seytek-2012:p0928:b002:l018","ordinal":367991,"en":"She valued not even as a hair, the wretched girl,"},{"id":"seytek-2012:p0928:b002:l019","ordinal":367992,"en":"But cast it away as though tied to a thread."},{"id":"seytek-2012:p0928:b002:l020","ordinal":367993,"en":"When she turned her charger’s head"},{"id":"seytek-2012:p0928:b002:l021","ordinal":367994,"en":"Toward her foe, brave Sarybay,"},{"id":"seytek-2012:p0928:b002:l022","ordinal":367995,"en":"And now leveled her spear,"},{"id":"seytek-2012:p0928:b002:l023","ordinal":367996,"en":"She bent low at the waist."},{"id":"seytek-2012:p0928:b002:l024","ordinal":367997,"en":"Her two eyes blazed with fire,"},{"id":"seytek-2012:p0928:b002:l025","ordinal":367998,"en":"Bulging and gleaming through the gloom;"},{"id":"seytek-2012:p0928:b002:l026","ordinal":367999,"en":"Her great spine and ribs"},{"id":"seytek-2012:p0928:b002:l027","ordinal":368000,"en":"Stood starkly apart,"},{"id":"seytek-2012:p0928:b002:l028","ordinal":368001,"en":"And blood-red embers mixed with gore"},{"id":"seytek-2012:p0928:b002:l029","ordinal":368002,"en":"Poured like flame from her mouth."},{"id":"seytek-2012:p0928:b002:l030","ordinal":368003,"en":"Her prowess and courage"},{"id":"seytek-2012:p0928:b002:l031","ordinal":368004,"en":"Appeared extraordinary to the eye."},{"id":"seytek-2012:p0928:b002:l032","ordinal":368005,"en":"Breaking free of all restraint,"},{"id":"seytek-2012:p0928:b002:l033","ordinal":368006,"en":"Shattering the ground beneath his hooves,"},{"id":"seytek-2012:p0928:b002:l034","ordinal":368007,"en":"Zhelzhetpes flew like a cloud,"},{"id":"seytek-2012:p0928:b002:l035","ordinal":368008,"en":"Racing with the thoroughbred,"},{"id":"seytek-2012:p0928:b002:l036","ordinal":368009,"en":"Breaking a path with his hooves"},{"id":"seytek-2012:p0928:b002:l037","ordinal":368010,"en":"Toward wrathful Sarybay,"},{"id":"seytek-2012:p0928:b002:l038","ordinal":368011,"en":"Striking at the marauder."},{"id":"seytek-2012:p0928:b002:l039","ordinal":368012,"en":"Then Kuyaly,"},{"id":"seytek-2012:p0928:b002:l040","ordinal":368013,"en":"Tall and broad-shouldered,"},{"id":"seytek-2012:p0928:b003:l001","ordinal":368014,"en":"A mighty champion and keen warrior,"},{"id":"seytek-2012:p0928:b003:l002","ordinal":368015,"en":"Was herself one of the great heroes."},{"id":"seytek-2012:p0928:b003:l003","ordinal":368016,"en":"Before one could cry out,"},{"id":"seytek-2012:p0928:b003:l004","ordinal":368017,"en":"In the blink of an eye,"},{"id":"seytek-2012:p0928:b003:l005","ordinal":368018,"en":"Her Zhelzhetpes grew wild,"},{"id":"seytek-2012:p0928:b003:l006","ordinal":368019,"en":"Soaring like a cloud in fury,"},{"id":"seytek-2012:p0928:b003:l007","ordinal":368020,"en":"And reached him sooner than an arrow."},{"id":"seytek-2012:p0928:b003:l008","ordinal":368021,"en":"Kuyaly, a master of the spear,"},{"id":"seytek-2012:p0928:b003:l009","ordinal":368022,"en":"Spoke the words she had long kept,"},{"id":"seytek-2012:p0928:b003:l010","ordinal":368023,"en":"And to the hero Sarybay"},{"id":"seytek-2012:p0928:b003:l011","ordinal":368024,"en":"She said this:"},{"id":"seytek-2012:p0928:b003:l012","ordinal":368025,"en":"“For as long as anyone remembers,"},{"id":"seytek-2012:p0928:b003:l013","ordinal":368026,"en":"You have plotted violence,"},{"id":"seytek-2012:p0928:b003:l014","ordinal":368027,"en":"Roaming among nations and spilling blood,"},{"id":"seytek-2012:p0928:b003:l015","ordinal":368028,"en":"Never ceasing your strife."},{"id":"seytek-2012:p0928:b003:l016","ordinal":368029,"en":"If you continue so, madman,"},{"id":"seytek-2012:p0928:b003:l017","ordinal":368030,"en":"You will never prosper in this world."},{"id":"seytek-2012:p0928:b003:l018","ordinal":368031,"en":"Even a dog is far better than you;"},{"id":"seytek-2012:p0928:b003:l019","ordinal":368032,"en":"You have never ceased your doggish ways."},{"id":"seytek-2012:p0928:b003:l020","ordinal":368033,"en":"Your violence has reached many;"},{"id":"seytek-2012:p0928:b003:l021","ordinal":368034,"en":"Many innocent souls have died."},{"id":"seytek-2012:p0928:b003:l022","ordinal":368035,"en":"This one is human, and you are human—"},{"id":"seytek-2012:p0928:b003:l023","ordinal":368036,"en":"What you have done is truly evil."},{"id":"seytek-2012:p0928:b003:l024","ordinal":368037,"en":"You have put out the hearth-fires"},{"id":"seytek-2012:p0928:b003:l025","ordinal":368038,"en":"Of peaceful folk dwelling in their summer camps,"},{"id":"seytek-2012:p0928:b003:l026","ordinal":368039,"en":"And driven them all away."},{"id":"seytek-2012:p0928:b003:l027","ordinal":368040,"en":"You destroyed the trees of their homeland,"},{"id":"seytek-2012:p0928:b003:l028","ordinal":368041,"en":"Left their little children orphaned,"},{"id":"seytek-2012:p0928:b003:l029","ordinal":368042,"en":"And cast them into misery."},{"id":"seytek-2012:p0928:b003:l030","ordinal":368043,"en":"You have no ancestral feud to avenge;"},{"id":"seytek-2012:p0928:b003:l031","ordinal":368044,"en":"For what fault of the Kyrgyz"},{"id":"seytek-2012:p0928:b003:l032","ordinal":368045,"en":"Have you tormented their lives so cruelly?"},{"id":"seytek-2012:p0928:b003:l033","ordinal":368046,"en":"For as long as anyone remembers,"},{"id":"seytek-2012:p0928:b003:l034","ordinal":368047,"en":"Your frenzy has never ceased,"},{"id":"seytek-2012:p0928:b003:l035","ordinal":368048,"en":"Nor have you had your fill of drinking blood."},{"id":"seytek-2012:p0928:b003:l036","ordinal":368049,"en":"Plundering tribes and slaughtering people,"},{"id":"seytek-2012:p0928:b003:l037","ordinal":368050,"en":"You have never ceased your strife."},{"id":"seytek-2012:p0928:b003:l038","ordinal":368051,"en":"You steeped your spear in blood"},{"id":"seytek-2012:p0928:b003:l039","ordinal":368052,"en":"And would heed no word spoken to you."},{"id":"seytek-2012:p0928:b003:l040","ordinal":368053,"en":"You crossed ridges and mountain passes,"},{"id":"seytek-2012:p0929:b002:l001","ordinal":368054,"en":"Sowing turmoil and strife."},{"id":"seytek-2012:p0929:b002:l002","ordinal":368055,"en":"However often I warned you, you would not change;"},{"id":"seytek-2012:p0929:b002:l003","ordinal":368056,"en":"For as long as anyone remembers,"},{"id":"seytek-2012:p0929:b002:l004","ordinal":368057,"en":"You have never ceased your violence."},{"id":"seytek-2012:p0929:b002:l005","ordinal":368058,"en":"As I searched for you through turmoil,"},{"id":"seytek-2012:p0929:b002:l006","ordinal":368059,"en":"You came yourself, Sarybay;"},{"id":"seytek-2012:p0929:b002:l007","ordinal":368060,"en":"The time has come to clash"},{"id":"seytek-2012:p0929:b002:l008","ordinal":368061,"en":"And joust with me, Sarybay."},{"id":"seytek-2012:p0929:b002:l009","ordinal":368062,"en":"Eager to unleash another battle,"},{"id":"seytek-2012:p0929:b002:l010","ordinal":368063,"en":"Your eyes straining wide,"},{"id":"seytek-2012:p0929:b002:l011","ordinal":368064,"en":"You came yourself, Sarybay."},{"id":"seytek-2012:p0929:b002:l012","ordinal":368065,"en":"The time has come to strike unfalteringly with the sword"},{"id":"seytek-2012:p0929:b002:l013","ordinal":368066,"en":"And stand amid the havoc,"},{"id":"seytek-2012:p0929:b002:l014","ordinal":368067,"en":"The time has come, Sarybay."},{"id":"seytek-2012:p0929:b002:l015","ordinal":368068,"en":"Rousing the people and gathering an army,"},{"id":"seytek-2012:p0929:b002:l016","ordinal":368069,"en":"Swelling your host to myriad ranks,"},{"id":"seytek-2012:p0929:b002:l017","ordinal":368070,"en":"You came yourself, Sarybay."},{"id":"seytek-2012:p0929:b002:l018","ordinal":368071,"en":"Now the time has come for you to fall and die,"},{"id":"seytek-2012:p0929:b002:l019","ordinal":368072,"en":"To behold the broad realm"},{"id":"seytek-2012:p0929:b002:l020","ordinal":368073,"en":"From which none return,"},{"id":"seytek-2012:p0929:b002:l021","ordinal":368074,"en":"The time has come, Sarybay."},{"id":"seytek-2012:p0929:b002:l022","ordinal":368075,"en":"Called the son of a demon,"},{"id":"seytek-2012:p0929:b002:l023","ordinal":368076,"en":"Your fame spread among the people;"},{"id":"seytek-2012:p0929:b002:l024","ordinal":368077,"en":"You subjugated the whole world,"},{"id":"seytek-2012:p0929:b002:l025","ordinal":368078,"en":"And your violence overflowed."},{"id":"seytek-2012:p0929:b002:l026","ordinal":368079,"en":"I shall answer your violence;"},{"id":"seytek-2012:p0929:b002:l027","ordinal":368080,"en":"My name is Kuyaly,"},{"id":"seytek-2012:p0929:b002:l028","ordinal":368081,"en":"And I have come from afar to find you thus."},{"id":"seytek-2012:p0929:b002:l029","ordinal":368082,"en":"May your oath strike you—stand your ground!"},{"id":"seytek-2012:p0929:b002:l030","ordinal":368083,"en":"If you are a hero and a warrior,"},{"id":"seytek-2012:p0929:b002:l031","ordinal":368084,"en":"If you are brave Sarybay,"},{"id":"seytek-2012:p0929:b002:l032","ordinal":368085,"en":"Do not lose your wits,"},{"id":"seytek-2012:p0929:b002:l033","ordinal":368086,"en":"And do not flee from what lies ahead!”"},{"id":"seytek-2012:p0929:b002:l034","ordinal":368087,"en":"So saying, Kuyaly"},{"id":"seytek-2012:p0929:b002:l035","ordinal":368088,"en":"Gripped her deadly steel spear,"},{"id":"seytek-2012:p0929:b002:l036","ordinal":368089,"en":"Twisting it firmly in her hand."},{"id":"seytek-2012:p0929:b002:l037","ordinal":368090,"en":"“The flesh of his breast is my mark,"},{"id":"seytek-2012:p0929:b002:l038","ordinal":368091,"en":"The edge of his lung my measure;"},{"id":"seytek-2012:p0929:b002:l039","ordinal":368092,"en":"His heart has fallen into my hand,"},{"id":"seytek-2012:p0929:b002:l040","ordinal":368093,"en":"And this swaggering boar"},{"id":"seytek-2012:p0929:b004:l001","ordinal":368094,"en":"Shall fall at this very spot,” she said,"},{"id":"seytek-2012:p0929:b004:l002","ordinal":368095,"en":"And Kuyaly thrust her spear."},{"id":"seytek-2012:p0929:b004:l003","ordinal":368096,"en":"Then Sarybay,"},{"id":"seytek-2012:p0929:b004:l004","ordinal":368097,"en":"Bellowing and roaring,"},{"id":"seytek-2012:p0929:b004:l005","ordinal":368098,"en":"Bent down the spearhead."},{"id":"seytek-2012:p0929:b004:l006","ordinal":368099,"en":"His weapon was a steel battle-axe;"},{"id":"seytek-2012:p0929:b004:l007","ordinal":368100,"en":"The demon-born infidel’s"},{"id":"seytek-2012:p0929:b004:l008","ordinal":368101,"en":"Strength was formidable."},{"id":"seytek-2012:p0929:b004:l009","ordinal":368102,"en":"He seized the battle-axe"},{"id":"seytek-2012:p0929:b004:l010","ordinal":368103,"en":"And, not letting the spear approach,"},{"id":"seytek-2012:p0929:b004:l011","ordinal":368104,"en":"Beat it aside and held his ground."},{"id":"seytek-2012:p0929:b004:l012","ordinal":368105,"en":"When the deflected spear passed by"},{"id":"seytek-2012:p0929:b004:l013","ordinal":368106,"en":"And Sarybay had escaped it,"},{"id":"seytek-2012:p0929:b004:l014","ordinal":368107,"en":"Sarybay bristled with menace"},{"id":"seytek-2012:p0929:b004:l015","ordinal":368108,"en":"And grew furious."},{"id":"seytek-2012:p0929:b004:l016","ordinal":368109,"en":"He overcame"},{"id":"seytek-2012:p0929:b004:l017","ordinal":368110,"en":"Every danger before him."},{"id":"seytek-2012:p0929:b004:l018","ordinal":368111,"en":"Hissing like a dragon,"},{"id":"seytek-2012:p0929:b004:l019","ordinal":368112,"en":"He roared threateningly;"},{"id":"seytek-2012:p0929:b004:l020","ordinal":368113,"en":"His shout seemed to split heads,"},{"id":"seytek-2012:p0929:b004:l021","ordinal":368114,"en":"And the raging boar’s"},{"id":"seytek-2012:p0929:b004:l022","ordinal":368115,"en":"Bellow seemed to split stones."},{"id":"seytek-2012:p0929:b004:l023","ordinal":368116,"en":"His savage wrath poured forth,"},{"id":"seytek-2012:p0929:b004:l024","ordinal":368117,"en":"His venom set him apart—"},{"id":"seytek-2012:p0929:b004:l025","ordinal":368118,"en":"Ask no more of Sarybay’s state."},{"id":"seytek-2012:p0929:b004:l026","ordinal":368119,"en":"Raging and straining,"},{"id":"seytek-2012:p0929:b004:l027","ordinal":368120,"en":"He made ready with leveled spear."},{"id":"seytek-2012:p0929:b004:l028","ordinal":368121,"en":"“You infidel who ruins nations!"},{"id":"seytek-2012:p0929:b004:l029","ordinal":368122,"en":"You woman I shall seize!” he cried,"},{"id":"seytek-2012:p0929:b004:l030","ordinal":368123,"en":"And raged in a frenzy,"},{"id":"seytek-2012:p0929:b004:l031","ordinal":368124,"en":"While his host surged without rest."},{"id":"seytek-2012:p0929:b004:l032","ordinal":368125,"en":"He braced himself and took aim,"},{"id":"seytek-2012:p0929:b004:l033","ordinal":368126,"en":"His mouth like a burning ember,"},{"id":"seytek-2012:p0929:b004:l034","ordinal":368127,"en":"His valor fierce, his skill supreme,"},{"id":"seytek-2012:p0929:b004:l035","ordinal":368128,"en":"His cunning deep, his power unmatched."}]
