[{"id":"manas-2010:p1160:b001:l003","ordinal":50433,"en":"Deceiving the sorcerers,"},{"id":"manas-2010:p1160:b001:l004","ordinal":50434,"en":"I learned all their arts,"},{"id":"manas-2010:p1160:b001:l005","ordinal":50435,"en":"And had every one beheaded."},{"id":"manas-2010:p1160:b001:l006","ordinal":50436,"en":"The spells fixed in place,"},{"id":"manas-2010:p1160:b001:l007","ordinal":50437,"en":"I undid them—did you see?"},{"id":"manas-2010:p1160:b001:l008","ordinal":50438,"en":"Now let me tell my secret."},{"id":"manas-2010:p1160:b001:l009","ordinal":50439,"en":"What a palace-house of gold!"},{"id":"manas-2010:p1160:b001:l010","ordinal":50440,"en":"What a man who mounts the throne!"},{"id":"manas-2010:p1160:b001:l011","ordinal":50441,"en":"God Himself, His servants—"},{"id":"manas-2010:p1160:b001:l012","ordinal":50442,"en":"He creates them in all their different forms!"},{"id":"manas-2010:p1160:b001:l013","ordinal":50443,"en":"Esenkan's daughter Burulcha—"},{"id":"manas-2010:p1160:b001:l014","ordinal":50444,"en":"‘When will my Almambet come?’"},{"id":"manas-2010:p1160:b001:l015","ordinal":50445,"en":"What of her, if she is weeping so?"},{"id":"manas-2010:p1160:b001:l016","ordinal":50446,"en":"Unable to reach my weeping beloved,"},{"id":"manas-2010:p1160:b001:l017","ordinal":50447,"en":"In the vast, bare desert,"},{"id":"manas-2010:p1160:b001:l018","ordinal":50448,"en":"What of me, wandering pale?"},{"id":"manas-2010:p1160:b001:l019","ordinal":50449,"en":"Esenkan's Burulcha"},{"id":"manas-2010:p1160:b001:l020","ordinal":50450,"en":"May have stretched her silk dress this year."},{"id":"manas-2010:p1160:b001:l021","ordinal":50451,"en":"Perhaps in her heart, despairing,"},{"id":"manas-2010:p1160:b001:l022","ordinal":50452,"en":"Thinking that I will not come,"},{"id":"manas-2010:p1160:b001:l023","ordinal":50453,"en":"She has given up all hope!"},{"id":"manas-2010:p1160:b001:l024","ordinal":50454,"en":"Esenkan's daughter Burulcha,"},{"id":"manas-2010:p1160:b001:l025","ordinal":50455,"en":"She was the daughter of Light;"},{"id":"manas-2010:p1160:b001:l026","ordinal":50456,"en":"I was the son of Light."},{"id":"manas-2010:p1160:b001:l027","ordinal":50457,"en":"Each of us"},{"id":"manas-2010:p1160:b001:l028","ordinal":50458,"en":"Longed to see the other."},{"id":"manas-2010:p1160:b001:l029","ordinal":50459,"en":"When I left Beijing,"},{"id":"manas-2010:p1160:b001:l030","ordinal":50460,"en":"Assuring her I would return,"},{"id":"manas-2010:p1160:b001:l031","ordinal":50461,"en":"I had made many promises."},{"id":"manas-2010:p1160:b001:l032","ordinal":50462,"en":"What of her, left in confinement?"},{"id":"manas-2010:p1160:b001:l033","ordinal":50463,"en":"Unable to return and reach her,"},{"id":"manas-2010:p1160:b001:l034","ordinal":50464,"en":"What of me, who fled here?"},{"id":"manas-2010:p1160:b001:l035","ordinal":50465,"en":"From that day to this,"},{"id":"manas-2010:p1160:b001:l036","ordinal":50466,"en":"Counting the days with dung-pellets,"},{"id":"manas-2010:p1160:b001:l037","ordinal":50467,"en":"What of the soul that pines?"},{"id":"manas-2010:p1160:b001:l038","ordinal":50468,"en":"A curse upon this wretched love!"},{"id":"manas-2010:p1160:b001:l039","ordinal":50469,"en":"Spread thick before us,"},{"id":"manas-2010:p1160:b001:l040","ordinal":50470,"en":"How many hosts of Chinese are there?"},{"id":"manas-2010:p1160:b001:l041","ordinal":50471,"en":"When Burulcha comes to mind,"},{"id":"manas-2010:p1160:b001:l042","ordinal":50472,"en":"My fly-like soul cannot hold together."},{"id":"manas-2010:p1161:b001:l001","ordinal":50473,"en":"When I came out of Beijing,"},{"id":"manas-2010:p1161:b001:l002","ordinal":50474,"en":"Many Chinese fought us;"},{"id":"manas-2010:p1161:b001:l003","ordinal":50475,"en":"Were they not laid waste?"},{"id":"manas-2010:p1161:b001:l004","ordinal":50476,"en":"Esenkan's Burulcha,"},{"id":"manas-2010:p1161:b001:l005","ordinal":50477,"en":"Entwined in my lead-rope,"},{"id":"manas-2010:p1161:b001:l006","ordinal":50478,"en":"‘Be safe and come back soon!’ she said."},{"id":"manas-2010:p1161:b001:l007","ordinal":50479,"en":"Refusing to let Sarala go,"},{"id":"manas-2010:p1161:b001:l008","ordinal":50480,"en":"Holding the reins with both hands,"},{"id":"manas-2010:p1161:b001:l009","ordinal":50481,"en":"Was she not left weeping?"},{"id":"manas-2010:p1161:b001:l010","ordinal":50482,"en":"From those who come, I hear news."},{"id":"manas-2010:p1161:b001:l011","ordinal":50483,"en":"Gathering the peoples of six khans,"},{"id":"manas-2010:p1161:b001:l012","ordinal":50484,"en":"‘Give me Burulcha,’ he said."},{"id":"manas-2010:p1161:b001:l013","ordinal":50485,"en":"Alöökö's Kongurbay,"},{"id":"manas-2010:p1161:b001:l014","ordinal":50486,"en":"To Esenkan this very year,"},{"id":"manas-2010:p1161:b001:l015","ordinal":50487,"en":"Has sent a marriage proposal, I hear."},{"id":"manas-2010:p1161:b001:l016","ordinal":50488,"en":"The dress with its slit hem,"},{"id":"manas-2010:p1161:b001:l017","ordinal":50489,"en":"She refused to wear, I hear."},{"id":"manas-2010:p1161:b001:l018","ordinal":50490,"en":"She refused to agree, I hear."},{"id":"manas-2010:p1161:b001:l019","ordinal":50491,"en":"The six khans who intervened,"},{"id":"manas-2010:p1161:b001:l020","ordinal":50492,"en":"Alöökö's Kongurbay,"},{"id":"manas-2010:p1161:b001:l021","ordinal":50493,"en":"And Esenkan, khan of the Chinese,"},{"id":"manas-2010:p1161:b001:l022","ordinal":50494,"en":"Because of Burulcha,"},{"id":"manas-2010:p1161:b001:l023","ordinal":50495,"en":"Could not agree as one people,"},{"id":"manas-2010:p1161:b001:l024","ordinal":50496,"en":"And became enemies, I hear.”"},{"id":"manas-2010:p1161:b001:l025","ordinal":50497,"en":"Of Kara Kezek, in a white felt hat,"},{"id":"manas-2010:p1161:b001:l026","ordinal":50498,"en":"Brave Syrgak grew angry."},{"id":"manas-2010:p1161:b001:l027","ordinal":50499,"en":"When he heard of Burulcha,"},{"id":"manas-2010:p1161:b001:l028","ordinal":50500,"en":"Unable to contain himself, stirring restlessly,"},{"id":"manas-2010:p1161:b001:l029","ordinal":50501,"en":"The noble blue-maned lion Syrgak said:"},{"id":"manas-2010:p1161:b001:l030","ordinal":50502,"en":"“Almambet, if these words are true,"},{"id":"manas-2010:p1161:b001:l031","ordinal":50503,"en":"Give me your coat to wear underneath;"},{"id":"manas-2010:p1161:b001:l032","ordinal":50504,"en":"Give me your clear answer now."},{"id":"manas-2010:p1161:b001:l033","ordinal":50505,"en":"Let me mount my Kökchebich,"},{"id":"manas-2010:p1161:b001:l034","ordinal":50506,"en":"In the Chinese realm's Beijing,"},{"id":"manas-2010:p1161:b001:l035","ordinal":50507,"en":"Stiffening the Chinese with terror,"},{"id":"manas-2010:p1161:b001:l036","ordinal":50508,"en":"I shall drive and chase them from Beijing."},{"id":"manas-2010:p1161:b001:l037","ordinal":50509,"en":"Upon Beijing, unreachable by the Flood,"},{"id":"manas-2010:p1161:b001:l038","ordinal":50510,"en":"I shall truly bring hell."},{"id":"manas-2010:p1161:b001:l039","ordinal":50511,"en":"Esenkan's daughter Burulcha,"},{"id":"manas-2010:p1161:b001:l040","ordinal":50512,"en":"I shall seize from the Chinese."},{"id":"manas-2010:p1161:b001:l041","ordinal":50513,"en":"Taking her round the bare forearm,"},{"id":"manas-2010:p1161:b001:l042","ordinal":50514,"en":"Seating her behind me,"},{"id":"manas-2010:p1162:b001:l001","ordinal":50515,"en":"I shall set her on the horse's rump!”"},{"id":"manas-2010:p1162:b001:l002","ordinal":50516,"en":"When he heard these words,"},{"id":"manas-2010:p1162:b001:l003","ordinal":50517,"en":"Azizkan's Almambet,"},{"id":"manas-2010:p1162:b001:l004","ordinal":50518,"en":"Like a man stabbed in a gland,"},{"id":"manas-2010:p1162:b001:l005","ordinal":50519,"en":"The dark-maned warrior sprang up."},{"id":"manas-2010:p1162:b001:l006","ordinal":50520,"en":"“You wretched Syrgak, what are you saying?"},{"id":"manas-2010:p1162:b001:l007","ordinal":50521,"en":"That great looming height"},{"id":"manas-2010:p1162:b001:l008","ordinal":50522,"en":"Is no pass to cross as though it were level."},{"id":"manas-2010:p1162:b001:l009","ordinal":50523,"en":"Those fearsome Chinese"},{"id":"manas-2010:p1162:b001:l010","ordinal":50524,"en":"Are no people to charge straight into."},{"id":"manas-2010:p1162:b001:l011","ordinal":50525,"en":"They have a pass on which they rely;"},{"id":"manas-2010:p1162:b001:l012","ordinal":50526,"en":"They have a place well fortified."},{"id":"manas-2010:p1162:b001:l013","ordinal":50527,"en":"Their fox lies on the ridge;"},{"id":"manas-2010:p1162:b001:l014","ordinal":50528,"en":"Their duck lies on the lake;"},{"id":"manas-2010:p1162:b001:l015","ordinal":50529,"en":"Their wild ram stands tall"},{"id":"manas-2010:p1162:b001:l016","ordinal":50530,"en":"At the place where it was stationed."},{"id":"manas-2010:p1162:b001:l017","ordinal":50531,"en":"Beyond that,"},{"id":"manas-2010:p1162:b001:l018","ordinal":50532,"en":"With forty monks beside him,"},{"id":"manas-2010:p1162:b001:l019","ordinal":50533,"en":"He has a throne set up of stone."},{"id":"manas-2010:p1162:b001:l020","ordinal":50534,"en":"No human can match him in wrestling:"},{"id":"manas-2010:p1162:b001:l021","ordinal":50535,"en":"There is also one called Great Malgun."},{"id":"manas-2010:p1162:b001:l022","ordinal":50536,"en":"In Beijing's heart, beyond all counting,"},{"id":"manas-2010:p1162:b001:l023","ordinal":50537,"en":"Their people swarm."},{"id":"manas-2010:p1162:b001:l024","ordinal":50538,"en":"To Beijing, six months away,"},{"id":"manas-2010:p1162:b001:l025","ordinal":50539,"en":"Bringing six days' news,"},{"id":"manas-2010:p1162:b001:l026","ordinal":50540,"en":"Reaching it alone to deliver it,"},{"id":"manas-2010:p1162:b001:l027","ordinal":50541,"en":"There is a bright-red, dark-marked fox."},{"id":"manas-2010:p1162:b001:l028","ordinal":50542,"en":"It catches a scent from ten days away;"},{"id":"manas-2010:p1162:b001:l029","ordinal":50543,"en":"Over a long road of six days,"},{"id":"manas-2010:p1162:b001:l030","ordinal":50544,"en":"Its eyes see clearly from afar."},{"id":"manas-2010:p1162:b001:l031","ordinal":50545,"en":"If we catch that fox,"},{"id":"manas-2010:p1162:b001:l032","ordinal":50546,"en":"We shall scatter the Chinese herds."},{"id":"manas-2010:p1162:b001:l033","ordinal":50547,"en":"If that fox escapes us,"},{"id":"manas-2010:p1162:b001:l034","ordinal":50548,"en":"We shall return beset by trouble."},{"id":"manas-2010:p1162:b001:l035","ordinal":50549,"en":"My banner chosen for me,"},{"id":"manas-2010:p1162:b001:l036","ordinal":50550,"en":"Be still and do not grow angry,"},{"id":"manas-2010:p1162:b001:l037","ordinal":50551,"en":"My gift, dear to me!"},{"id":"manas-2010:p1162:b001:l038","ordinal":50552,"en":"That looming shape you see,"},{"id":"manas-2010:p1162:b001:l039","ordinal":50553,"en":"The level spur of the mountain,"},{"id":"manas-2010:p1162:b001:l040","ordinal":50554,"en":"The great plain where fescue grows,"},{"id":"manas-2010:p1162:b001:l041","ordinal":50555,"en":"The mountain promontory where one takes tea—"},{"id":"manas-2010:p1162:b001:l042","ordinal":50556,"en":"To one who knows, that promontory"},{"id":"manas-2010:p1163:b001:l001","ordinal":50557,"en":"Is the pass of Kan-Zhaylak,"},{"id":"manas-2010:p1163:b001:l002","ordinal":50558,"en":"The fox stationed as a lookout—"},{"id":"manas-2010:p1163:b001:l003","ordinal":50559,"en":"That is the place where it will flee."},{"id":"manas-2010:p1163:b001:l004","ordinal":50560,"en":"When you reach that place,"},{"id":"manas-2010:p1163:b001:l005","ordinal":50561,"en":"There is no furrow cut by a plow,"},{"id":"manas-2010:p1163:b001:l006","ordinal":50562,"en":"No burrow dug by a marmot."},{"id":"manas-2010:p1163:b001:l007","ordinal":50563,"en":"When you reach that place,"},{"id":"manas-2010:p1163:b001:l008","ordinal":50564,"en":"If you encounter the fox,"},{"id":"manas-2010:p1163:b001:l009","ordinal":50565,"en":"Do not look around you;"},{"id":"manas-2010:p1163:b001:l010","ordinal":50566,"en":"Do not spare your life at all."},{"id":"manas-2010:p1163:b001:l011","ordinal":50567,"en":"Do not look up or down;"},{"id":"manas-2010:p1163:b001:l012","ordinal":50568,"en":"Do not think, ‘I shall die.’"},{"id":"manas-2010:p1163:b001:l013","ordinal":50569,"en":"Kökchebich beneath you—"},{"id":"manas-2010:p1163:b001:l014","ordinal":50570,"en":"Let me tell you of that swift horse."},{"id":"manas-2010:p1163:b001:l015","ordinal":50571,"en":"A Karabayyr steed of battle,"},{"id":"manas-2010:p1163:b001:l016","ordinal":50572,"en":"With sieve-like lungs and copper forelegs,"},{"id":"manas-2010:p1163:b001:l017","ordinal":50573,"en":"He will not tire if ridden scouting;"},{"id":"manas-2010:p1163:b001:l018","ordinal":50574,"en":"He will not sicken if ridden with the baggage."},{"id":"manas-2010:p1163:b001:l019","ordinal":50575,"en":"If you ride a punishing road,"},{"id":"manas-2010:p1163:b001:l020","ordinal":50576,"en":"His urine will not stop or be blocked."},{"id":"manas-2010:p1163:b001:l021","ordinal":50577,"en":"When the creature runs,"},{"id":"manas-2010:p1163:b001:l022","ordinal":50578,"en":"No winged bird can escape."},{"id":"manas-2010:p1163:b001:l023","ordinal":50579,"en":"Do not turn another way;"},{"id":"manas-2010:p1163:b001:l024","ordinal":50580,"en":"Do not leave the place I named."},{"id":"manas-2010:p1163:b001:l025","ordinal":50581,"en":"If the fox is in its place,"},{"id":"manas-2010:p1163:b001:l026","ordinal":50582,"en":"I shall drive and chase it before me."},{"id":"manas-2010:p1163:b001:l027","ordinal":50583,"en":"Then I shall shout aloud:"},{"id":"manas-2010:p1163:b001:l028","ordinal":50584,"en":"‘Syrgak, come!’ I shall call."},{"id":"manas-2010:p1163:b001:l029","ordinal":50585,"en":"Do not rest upon your elbows;"},{"id":"manas-2010:p1163:b001:l030","ordinal":50586,"en":"Do not take even a brief sleep."},{"id":"manas-2010:p1163:b001:l031","ordinal":50587,"en":"If we catch the fox,"},{"id":"manas-2010:p1163:b001:l032","ordinal":50588,"en":"The countless Chinese people's"},{"id":"manas-2010:p1163:b001:l033","ordinal":50589,"en":"Treasures and herds we shall scatter.”"},{"id":"manas-2010:p1163:b001:l034","ordinal":50590,"en":"Saying this, Almambet"},{"id":"manas-2010:p1163:b001:l035","ordinal":50591,"en":"Took Syrgak by the hand,"},{"id":"manas-2010:p1163:b001:l036","ordinal":50592,"en":"Clasping it firmly again and again."},{"id":"manas-2010:p1163:b001:l037","ordinal":50593,"en":"“Do not move from here,”"},{"id":"manas-2010:p1163:b001:l038","ordinal":50594,"en":"He charged him time after time."},{"id":"manas-2010:p1163:b001:l039","ordinal":50595,"en":"Turning sharply, he darted off;"},{"id":"manas-2010:p1163:b001:l040","ordinal":50596,"en":"He sped away on Sarala."},{"id":"manas-2010:p1163:b001:l041","ordinal":50597,"en":"Sending hail upon the foothills,"},{"id":"manas-2010:p1163:b001:l042","ordinal":50598,"en":"Turning day into night,"},{"id":"manas-2010:p1164:b001:l001","ordinal":50599,"en":"Bringing down a foul mist,"},{"id":"manas-2010:p1164:b001:l002","ordinal":50600,"en":"Turning the summer day to winter,"},{"id":"manas-2010:p1164:b001:l003","ordinal":50601,"en":"The Kalmyks at the watch-post"},{"id":"manas-2010:p1164:b001:l004","ordinal":50602,"en":"He caught in snow and blizzard."},{"id":"manas-2010:p1164:b001:l005","ordinal":50603,"en":"Upon the valley where the fox lay,"},{"id":"manas-2010:p1164:b001:l006","ordinal":50604,"en":"He darkened the sky and sent down hail."},{"id":"manas-2010:p1164:b001:l007","ordinal":50605,"en":"He hemmed in the lookout."},{"id":"manas-2010:p1164:b001:l008","ordinal":50606,"en":"Making it cower, unable to come out,"},{"id":"manas-2010:p1164:b001:l009","ordinal":50607,"en":"The fox lay in its burrow,"},{"id":"manas-2010:p1164:b001:l010","ordinal":50608,"en":"Afraid of the rain, unable to rise."},{"id":"manas-2010:p1164:b001:l011","ordinal":50609,"en":"The spells that work the weather,"},{"id":"manas-2010:p1164:b001:l012","ordinal":50610,"en":"Almambet came reciting;"},{"id":"manas-2010:p1164:b001:l013","ordinal":50611,"en":"Countless hosts of Chinese,"},{"id":"manas-2010:p1164:b001:l014","ordinal":50612,"en":"Almambet had slaughtered."},{"id":"manas-2010:p1164:b001:l015","ordinal":50613,"en":"Leaving no Chinese secret unknown,"},{"id":"manas-2010:p1164:b001:l016","ordinal":50614,"en":"Almambet had learned them all."},{"id":"manas-2010:p1164:b001:l017","ordinal":50615,"en":"The Chinese road, the difficult road,"},{"id":"manas-2010:p1164:b001:l018","ordinal":50616,"en":"Almambet had seen it."},{"id":"manas-2010:p1164:b001:l019","ordinal":50617,"en":"Golden forelock and tasseled sash,"},{"id":"manas-2010:p1164:b001:l020","ordinal":50618,"en":"Azizkan's only son,"},{"id":"manas-2010:p1164:b001:l021","ordinal":50619,"en":"Your renowned champion sultan,"},{"id":"manas-2010:p1164:b001:l022","ordinal":50620,"en":"Taking his smooth musket in hand,"},{"id":"manas-2010:p1164:b001:l023","ordinal":50621,"en":"Rode out onto the saddle of the ridge,"},{"id":"manas-2010:p1164:b001:l024","ordinal":50622,"en":"Overlooking their flourishing people,"},{"id":"manas-2010:p1164:b001:l025","ordinal":50623,"en":"To the place where the fox"},{"id":"manas-2010:p1164:b001:l026","ordinal":50624,"en":"Always came out to keep watch."},{"id":"manas-2010:p1164:b001:l027","ordinal":50625,"en":"Watching alertly for the fox,"},{"id":"manas-2010:p1164:b001:l028","ordinal":50626,"en":"Resting it across a stone,"},{"id":"manas-2010:p1164:b001:l029","ordinal":50627,"en":"He held the musket ready."},{"id":"manas-2010:p1164:b001:l030","ordinal":50628,"en":"At that moment the cunning fox"},{"id":"manas-2010:p1164:b001:l031","ordinal":50629,"en":"Lowered its head to the earth."},{"id":"manas-2010:p1164:b001:l032","ordinal":50630,"en":"“Why this unseasonable rain?” it thought."},{"id":"manas-2010:p1164:b001:l033","ordinal":50631,"en":"“What sort of day has come?"},{"id":"manas-2010:p1164:b001:l034","ordinal":50632,"en":"Cloudy by day and clear by night—"},{"id":"manas-2010:p1164:b001:l035","ordinal":50633,"en":"It seems to be Almambet's weather magic."},{"id":"manas-2010:p1164:b001:l036","ordinal":50634,"en":"Let me go to the watch-post and look,"},{"id":"manas-2010:p1164:b001:l037","ordinal":50635,"en":"Then turn back and return."},{"id":"manas-2010:p1164:b001:l038","ordinal":50636,"en":"Let me trot along the bluff."},{"id":"manas-2010:p1164:b001:l039","ordinal":50637,"en":"To the forty monks on watch,"},{"id":"manas-2010:p1164:b001:l040","ordinal":50638,"en":"Let me go and bring the news."},{"id":"manas-2010:p1164:b001:l041","ordinal":50639,"en":"Karykan in Beijing"},{"id":"manas-2010:p1164:b001:l042","ordinal":50640,"en":"Had spoken a definite word:"},{"id":"manas-2010:p1165:b001:l001","ordinal":50641,"en":"The blue-maned champion Almambet,"},{"id":"manas-2010:p1165:b001:l002","ordinal":50642,"en":"To make a journey to Beijing,"},{"id":"manas-2010:p1165:b001:l003","ordinal":50643,"en":"Was due to come this year.”"},{"id":"manas-2010:p1165:b001:l004","ordinal":50644,"en":"Thinking this, the cunning fox"},{"id":"manas-2010:p1165:b001:l005","ordinal":50645,"en":"Gathered itself with frantic haste,"},{"id":"manas-2010:p1165:b001:l006","ordinal":50646,"en":"Ran swift as an arrow,"},{"id":"manas-2010:p1165:b001:l007","ordinal":50647,"en":"And rushed to the watch-post."},{"id":"manas-2010:p1165:b001:l008","ordinal":50648,"en":"Raising its muzzle,"},{"id":"manas-2010:p1165:b001:l009","ordinal":50649,"en":"It sniffed all around."},{"id":"manas-2010:p1165:b001:l010","ordinal":50650,"en":"The four corners of the world,"},{"id":"manas-2010:p1165:b001:l011","ordinal":50651,"en":"It surveyed without missing any."},{"id":"manas-2010:p1165:b001:l012","ordinal":50652,"en":"The rough ridge and gray plain"},{"id":"manas-2010:p1165:b001:l013","ordinal":50653,"en":"Came into view once more."},{"id":"manas-2010:p1165:b001:l014","ordinal":50654,"en":"“Speeding his Sarala,"},{"id":"manas-2010:p1165:b001:l015","ordinal":50655,"en":"Almambet has ridden here."},{"id":"manas-2010:p1165:b001:l016","ordinal":50656,"en":"Bringing an army that covers the earth,"},{"id":"manas-2010:p1165:b001:l017","ordinal":50657,"en":"Almambet has come."},{"id":"manas-2010:p1165:b001:l018","ordinal":50658,"en":"On the broad ridge and steep promontory,"},{"id":"manas-2010:p1165:b001:l019","ordinal":50659,"en":"There are tracks of three steeds."},{"id":"manas-2010:p1165:b001:l020","ordinal":50660,"en":"Whatever the case, to reconnoiter,"},{"id":"manas-2010:p1165:b001:l021","ordinal":50661,"en":"To scout and gather news,"},{"id":"manas-2010:p1165:b001:l022","ordinal":50662,"en":"Someone has arrived."},{"id":"manas-2010:p1165:b001:l023","ordinal":50663,"en":"This year great ranks"},{"id":"manas-2010:p1165:b001:l024","ordinal":50664,"en":"Upon the Chinese realm's Beijing"},{"id":"manas-2010:p1165:b001:l025","ordinal":50665,"en":"Are poised to bring turmoil.”"},{"id":"manas-2010:p1165:b001:l026","ordinal":50666,"en":"Thinking this, your fox"},{"id":"manas-2010:p1165:b001:l027","ordinal":50667,"en":"Leapt off the rock and darted away."},{"id":"manas-2010:p1165:b001:l028","ordinal":50668,"en":"Almambet lying in wait,"},{"id":"manas-2010:p1165:b001:l029","ordinal":50669,"en":"Readying the musket to fire,"},{"id":"manas-2010:p1165:b001:l030","ordinal":50670,"en":"At the fleeing fox"},{"id":"manas-2010:p1165:b001:l031","ordinal":50671,"en":"Fired once from the side."},{"id":"manas-2010:p1165:b001:l032","ordinal":50672,"en":"Missing the place he aimed at,"},{"id":"manas-2010:p1165:b001:l033","ordinal":50673,"en":"He grazed one of its forelegs."},{"id":"manas-2010:p1165:b001:l034","ordinal":50674,"en":"Despairing of its life,"},{"id":"manas-2010:p1165:b001:l035","ordinal":50675,"en":"Gathering itself like a bird,"},{"id":"manas-2010:p1165:b001:l036","ordinal":50676,"en":"The wretched creature fled,"},{"id":"manas-2010:p1165:b001:l037","ordinal":50677,"en":"Running on three legs."},{"id":"manas-2010:p1165:b001:l038","ordinal":50678,"en":"From the pale, sloping hillside,"},{"id":"manas-2010:p1165:b001:l039","ordinal":50679,"en":"Almambet came shouting,"},{"id":"manas-2010:p1165:b001:l040","ordinal":50680,"en":"His cry splitting the mountain,"},{"id":"manas-2010:p1165:b001:l041","ordinal":50681,"en":"Calling, “Brave Syrgak!”"},{"id":"manas-2010:p1165:b001:l042","ordinal":50682,"en":"Kartküröng, whose rein he held,"},{"id":"manas-2010:p1166:b001:l001","ordinal":50683,"en":"He cast off toward the slope."},{"id":"manas-2010:p1166:b001:l002","ordinal":50684,"en":"“Go!” he cried, flying onward."},{"id":"manas-2010:p1166:b001:l003","ordinal":50685,"en":"Making him bound like a roe,"},{"id":"manas-2010:p1166:b001:l004","ordinal":50686,"en":"Kökchebich beneath him,"},{"id":"manas-2010:p1166:b001:l005","ordinal":50687,"en":"Whipping right and left,"},{"id":"manas-2010:p1166:b001:l006","ordinal":50688,"en":"Spurring on both sides,"}]
