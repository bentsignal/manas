[{"id":"semetey-1-2013:p1038:b004:l021","ordinal":155393,"en":"When driven to true fury,"},{"id":"semetey-1-2013:p1038:b004:l022","ordinal":155394,"en":"They say, the madman slaughters his father;"},{"id":"semetey-1-2013:p1038:b004:l023","ordinal":155395,"en":"However excellent you may be,"},{"id":"semetey-1-2013:p1038:b004:l024","ordinal":155396,"en":"Among the six Kyrgyz tribes"},{"id":"semetey-1-2013:p1038:b004:l025","ordinal":155397,"en":"They say there is no fool like you!"},{"id":"semetey-1-2013:p1038:b004:l026","ordinal":155398,"en":"To a husband born unruly,"},{"id":"semetey-1-2013:p1038:b004:l027","ordinal":155399,"en":"Let me stand yearning and speak:"},{"id":"semetey-1-2013:p1038:b004:l028","ordinal":155400,"en":"If you will not take me, do not, my murderer;"},{"id":"semetey-1-2013:p1038:b004:l029","ordinal":155401,"en":"I too shall find my equal and leave!\""},{"id":"semetey-1-2013:p1038:b004:l030","ordinal":155402,"en":"Saying this and tormenting him, Aychürök"},{"id":"semetey-1-2013:p1038:b004:l031","ordinal":155403,"en":"Was deeply hurt by the hero,"},{"id":"semetey-1-2013:p1038:b004:l032","ordinal":155404,"en":"And sobbed and wept bitterly."},{"id":"semetey-1-2013:p1038:b004:l033","ordinal":155405,"en":"Unable to draw back the mucus from her nose,"},{"id":"semetey-1-2013:p1038:b004:l034","ordinal":155406,"en":"Unable to wipe the tears from her eyes—"},{"id":"semetey-1-2013:p1038:b004:l035","ordinal":155407,"en":"Whose first ancestor was Tügöl Khan,"},{"id":"semetey-1-2013:p1038:b004:l036","ordinal":155408,"en":"Whose root was blessed by Khydyr,"},{"id":"semetey-1-2013:p1038:b004:l037","ordinal":155409,"en":"Descendant of the deathless one,"},{"id":"semetey-1-2013:p1038:b004:l038","ordinal":155410,"en":"Growing stronger whenever one died,"},{"id":"semetey-1-2013:p1038:b004:l039","ordinal":155411,"en":"Descendant of a sovereign hero:"}]
