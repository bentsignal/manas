[{"id":"manas-2010:p1318:b001:l003","ordinal":57089,"en":"Far away, you and the Magnanimous One,"},{"id":"manas-2010:p1318:b001:l004","ordinal":57090,"en":"Into the swarming infidels'"},{"id":"manas-2010:p1318:b001:l005","ordinal":57091,"en":"Seething place,"},{"id":"manas-2010:p1318:b001:l006","ordinal":57092,"en":"My leopard, you go."},{"id":"manas-2010:p1318:b001:l007","ordinal":57093,"en":"I entrust you to the one God!"},{"id":"manas-2010:p1318:b001:l008","ordinal":57094,"en":"Baychoro beside you,"},{"id":"manas-2010:p1318:b001:l009","ordinal":57095,"en":"He was a wolf in battle."},{"id":"manas-2010:p1318:b001:l010","ordinal":57096,"en":"Your other companion, Boz Uul,"},{"id":"manas-2010:p1318:b001:l011","ordinal":57097,"en":"Was an open-hearted man."},{"id":"manas-2010:p1318:b001:l012","ordinal":57098,"en":"Yraman's Singer's Son,"},{"id":"manas-2010:p1318:b001:l013","ordinal":57099,"en":"Who never retreated from the enemy,"},{"id":"manas-2010:p1318:b001:l014","ordinal":57100,"en":"Was a hero born a tiger."},{"id":"manas-2010:p1318:b001:l015","ordinal":57101,"en":"When he came in fury,"},{"id":"manas-2010:p1318:b001:l016","ordinal":57102,"en":"When his anger rose,"},{"id":"manas-2010:p1318:b001:l017","ordinal":57103,"en":"He brought alarming news with force;"},{"id":"manas-2010:p1318:b001:l018","ordinal":57104,"en":"He could knock down a camel with a blow."},{"id":"manas-2010:p1318:b001:l019","ordinal":57105,"en":"Five of you go to the lord."},{"id":"manas-2010:p1318:b001:l020","ordinal":57106,"en":"Akkula, entrusted to you,"},{"id":"manas-2010:p1318:b001:l021","ordinal":57107,"en":"The wings of your Magnanimous One,"},{"id":"manas-2010:p1318:b001:l022","ordinal":57108,"en":"You will lead him alongside."},{"id":"manas-2010:p1318:b001:l023","ordinal":57109,"en":"Unless you turn your face toward death,"},{"id":"manas-2010:p1318:b001:l024","ordinal":57110,"en":"Unless you show true courage,"},{"id":"manas-2010:p1318:b001:l025","ordinal":57111,"en":"This is the counsel I give:"},{"id":"manas-2010:p1318:b001:l026","ordinal":57112,"en":"Before seeing the champion's eyes,"},{"id":"manas-2010:p1318:b001:l027","ordinal":57113,"en":"You will fall into their hands.’"},{"id":"manas-2010:p1318:b001:l028","ordinal":57114,"en":"So said Khan Bakay then,"},{"id":"manas-2010:p1318:b001:l029","ordinal":57115,"en":"Speaking in this way,"},{"id":"manas-2010:p1318:b001:l030","ordinal":57116,"en":"Grasping his hand tightly."},{"id":"manas-2010:p1318:b001:l031","ordinal":57117,"en":"Akkula and the white padded armor,"},{"id":"manas-2010:p1318:b001:l032","ordinal":57118,"en":"Akkelte and the gray ammunition belt,"},{"id":"manas-2010:p1318:b001:l033","ordinal":57119,"en":"He entrusted to the five champions."},{"id":"manas-2010:p1318:b001:l034","ordinal":57120,"en":"Taking a shortcut along the mountain goat's path,"},{"id":"manas-2010:p1318:b001:l035","ordinal":57121,"en":"Ajybay set out, five men together."},{"id":"manas-2010:p1318:b001:l036","ordinal":57122,"en":"Leading Akkula,"},{"id":"manas-2010:p1318:b001:l037","ordinal":57123,"en":"He took no rest by day;"},{"id":"manas-2010:p1318:b001:l038","ordinal":57124,"en":"Ajybay traveled through the days."},{"id":"manas-2010:p1318:b001:l039","ordinal":57125,"en":"Taking not even a brief sleep,"},{"id":"manas-2010:p1318:b001:l040","ordinal":57126,"en":"Not resting upon an elbow,"},{"id":"manas-2010:p1318:b001:l041","ordinal":57127,"en":"Ajybay traveled through the nights."},{"id":"manas-2010:p1318:b001:l042","ordinal":57128,"en":"Traveling without sparing the horses,"},{"id":"manas-2010:p1319:b001:l001","ordinal":57129,"en":"Traveling far by day and night,"},{"id":"manas-2010:p1319:b001:l002","ordinal":57130,"en":"Crossing so many ridges,"},{"id":"manas-2010:p1319:b001:l003","ordinal":57131,"en":"Fording swiftly flowing waters,"},{"id":"manas-2010:p1319:b001:l004","ordinal":57132,"en":"Traversing many distant roads,"},{"id":"manas-2010:p1319:b001:l005","ordinal":57133,"en":"When midnight came,"},{"id":"manas-2010:p1319:b001:l006","ordinal":57134,"en":"Among the seething Chinese,"},{"id":"manas-2010:p1319:b001:l007","ordinal":57135,"en":"Ajybay arrived."},{"id":"manas-2010:p1319:b001:l008","ordinal":57136,"en":"Looming, massed in mounds,"},{"id":"manas-2010:p1319:b001:l009","ordinal":57137,"en":"What seemed a forest was a flood."},{"id":"manas-2010:p1319:b001:l010","ordinal":57138,"en":"Rustling and swishing,"},{"id":"manas-2010:p1319:b001:l011","ordinal":57139,"en":"What seemed reeds were spears."},{"id":"manas-2010:p1319:b001:l012","ordinal":57140,"en":"Swarming like ants,"},{"id":"manas-2010:p1319:b001:l013","ordinal":57141,"en":"It was the Chinese army encamped."},{"id":"manas-2010:p1319:b001:l014","ordinal":57142,"en":"Appearing through a haze,"},{"id":"manas-2010:p1319:b001:l015","ordinal":57143,"en":"It was not dust, but a multitude of people."},{"id":"manas-2010:p1319:b001:l016","ordinal":57144,"en":"When Aybanboz could go no farther,"},{"id":"manas-2010:p1319:b001:l017","ordinal":57145,"en":"The Chinese arrived in crowds;"},{"id":"manas-2010:p1319:b001:l018","ordinal":57146,"en":"They firmly barred his way."},{"id":"manas-2010:p1319:b001:l019","ordinal":57147,"en":"To the Chinese surrounding him,"},{"id":"manas-2010:p1319:b001:l020","ordinal":57148,"en":"He rattled away like a Kalmyk,"},{"id":"manas-2010:p1319:b001:l021","ordinal":57149,"en":"Babbled like a Chinese man."},{"id":"manas-2010:p1319:b001:l022","ordinal":57150,"en":"Your champion Ajy grew excited."},{"id":"manas-2010:p1319:b001:l023","ordinal":57151,"en":"They were neither Kalmyks nor Chinese;"},{"id":"manas-2010:p1319:b001:l024","ordinal":57152,"en":"He had met the Torgut."},{"id":"manas-2010:p1319:b001:l025","ordinal":57153,"en":"Among the Torgut with rank buttons on their caps,"},{"id":"manas-2010:p1319:b001:l026","ordinal":57154,"en":"He spoke as one of their finest."},{"id":"manas-2010:p1319:b001:l027","ordinal":57155,"en":"Among the Torgut with red cap tufts,"},{"id":"manas-2010:p1319:b001:l028","ordinal":57156,"en":"He rattled away like one of their mighty men."},{"id":"manas-2010:p1319:b001:l029","ordinal":57157,"en":"Broad of jaw, broad of tongue,"},{"id":"manas-2010:p1319:b001:l030","ordinal":57158,"en":"Ajybay, who made no mistake,"},{"id":"manas-2010:p1319:b001:l031","ordinal":57159,"en":"Like a governor-general's son,"},{"id":"manas-2010:p1319:b001:l032","ordinal":57160,"en":"Parted the Chinese as he went."},{"id":"manas-2010:p1319:b001:l033","ordinal":57161,"en":"All the Torgut gazed at him,"},{"id":"manas-2010:p1319:b001:l034","ordinal":57162,"en":"‘They must be half-khans,’ they said,"},{"id":"manas-2010:p1319:b001:l035","ordinal":57163,"en":"Bowing and babbling."},{"id":"manas-2010:p1319:b001:l036","ordinal":57164,"en":"Then Ajybay,"},{"id":"manas-2010:p1319:b001:l037","ordinal":57165,"en":"Of the Chinese seated upon thrones,"},{"id":"manas-2010:p1319:b001:l038","ordinal":57166,"en":"Assumed the bearing of the finest;"},{"id":"manas-2010:p1319:b001:l039","ordinal":57167,"en":"Of the Chinese with red cap tufts,"},{"id":"manas-2010:p1319:b001:l040","ordinal":57168,"en":"He spoke like their champion."},{"id":"manas-2010:p1319:b001:l041","ordinal":57169,"en":"When his horse could go no farther,"},{"id":"manas-2010:p1319:b001:l042","ordinal":57170,"en":"‘Perish, you ignorant Chinese!"},{"id":"manas-2010:p1320:b001:l001","ordinal":57171,"en":"You cannot swarm forward and reach him!"},{"id":"manas-2010:p1320:b001:l002","ordinal":57172,"en":"Manas, as big as a hut,"},{"id":"manas-2010:p1320:b001:l003","ordinal":57173,"en":"You still have not captured him!"},{"id":"manas-2010:p1320:b001:l004","ordinal":57174,"en":"Capturing Manas,"},{"id":"manas-2010:p1320:b001:l005","ordinal":57175,"en":"The Burut who came surging here,"},{"id":"manas-2010:p1320:b001:l006","ordinal":57176,"en":"You still have not destroyed them."},{"id":"manas-2010:p1320:b001:l007","ordinal":57177,"en":"The peoples of forty khans gathered,"},{"id":"manas-2010:p1320:b001:l008","ordinal":57178,"en":"Swarming like ants,"},{"id":"manas-2010:p1320:b001:l009","ordinal":57179,"en":"Yet against Manas, left on foot,"},{"id":"manas-2010:p1320:b001:l010","ordinal":57180,"en":"None of you dares advance."},{"id":"manas-2010:p1320:b001:l011","ordinal":57181,"en":"If a mighty Burut army should come,"},{"id":"manas-2010:p1320:b001:l012","ordinal":57182,"en":"In what grave will you find room?"},{"id":"manas-2010:p1320:b001:l013","ordinal":57183,"en":"Let me bring trouble upon them!"},{"id":"manas-2010:p1320:b001:l014","ordinal":57184,"en":"You governors-general and Manchu,"},{"id":"manas-2010:p1320:b001:l015","ordinal":57185,"en":"You Sibe and Torgut,"},{"id":"manas-2010:p1320:b001:l016","ordinal":57186,"en":"All of you, stay here!"},{"id":"manas-2010:p1320:b001:l017","ordinal":57187,"en":"I myself shall go and bind Manas"},{"id":"manas-2010:p1320:b001:l018","ordinal":57188,"en":"And bring him back."},{"id":"manas-2010:p1320:b001:l019","ordinal":57189,"en":"Let us all revel in the spoils."},{"id":"manas-2010:p1320:b001:l020","ordinal":57190,"en":"Once their champion falls into our hands,"},{"id":"manas-2010:p1320:b001:l021","ordinal":57191,"en":"Let us devastate the Burut,"},{"id":"manas-2010:p1320:b001:l022","ordinal":57192,"en":"Slaughtering them, sparing none!’"},{"id":"manas-2010:p1320:b001:l023","ordinal":57193,"en":"So said Ajybay;"},{"id":"manas-2010:p1320:b001:l024","ordinal":57194,"en":"While he stood raging,"},{"id":"manas-2010:p1320:b001:l025","ordinal":57195,"en":"The many infidels, a dark mass,"},{"id":"manas-2010:p1320:b001:l026","ordinal":57196,"en":"Opened his road, trembling."},{"id":"manas-2010:p1320:b001:l027","ordinal":57197,"en":"They all opened his road,"},{"id":"manas-2010:p1320:b001:l028","ordinal":57198,"en":"Hurrying out of the way."},{"id":"manas-2010:p1320:b001:l029","ordinal":57199,"en":"Showing reverence, astonished,"},{"id":"manas-2010:p1320:b001:l030","ordinal":57200,"en":"Still more bowed down."},{"id":"manas-2010:p1320:b001:l031","ordinal":57201,"en":"‘The governor-general has come!’"},{"id":"manas-2010:p1320:b001:l032","ordinal":57202,"en":"Still more were thrown into confusion."},{"id":"manas-2010:p1320:b001:l033","ordinal":57203,"en":"While the Chinese were like this,"},{"id":"manas-2010:p1320:b001:l034","ordinal":57204,"en":"Khan Zholoy, khan of the infidels,"},{"id":"manas-2010:p1320:b001:l035","ordinal":57205,"en":"Grew furious."},{"id":"manas-2010:p1320:b001:l036","ordinal":57206,"en":"‘Seize them and bring them here!’"},{"id":"manas-2010:p1320:b001:l037","ordinal":57207,"en":"He sent word to the army."},{"id":"manas-2010:p1320:b001:l038","ordinal":57208,"en":"The Chinese were a people with armies;"},{"id":"manas-2010:p1320:b001:l039","ordinal":57209,"en":"When their fury rose,"},{"id":"manas-2010:p1320:b001:l040","ordinal":57210,"en":"Not merely the five who came alone,"},{"id":"manas-2010:p1320:b001:l041","ordinal":57211,"en":"But the whole wide world,"},{"id":"manas-2010:p1320:b001:l042","ordinal":57212,"en":"They were a flood that could engulf it."},{"id":"manas-2010:p1321:b001:l001","ordinal":57213,"en":"The Chinese in the narrow pass"},{"id":"manas-2010:p1321:b001:l002","ordinal":57214,"en":"Swarmed in and pressed upon them."},{"id":"manas-2010:p1321:b001:l003","ordinal":57215,"en":"The swift runners crowded them hard,"},{"id":"manas-2010:p1321:b001:l004","ordinal":57216,"en":"Swarming to seize them."},{"id":"manas-2010:p1321:b001:l005","ordinal":57217,"en":"Ajybay, Argynkan's son,"},{"id":"manas-2010:p1321:b001:l006","ordinal":57218,"en":"He too was a mighty hero."},{"id":"manas-2010:p1321:b001:l007","ordinal":57219,"en":"If the watchful Chinese swarmed in,"},{"id":"manas-2010:p1321:b001:l008","ordinal":57220,"en":"Agayar, who lifted camels,"},{"id":"manas-2010:p1321:b001:l009","ordinal":57221,"en":"Was a lion who could bring slaughter."},{"id":"manas-2010:p1321:b001:l010","ordinal":57222,"en":"Never turning back from death,"},{"id":"manas-2010:p1321:b001:l011","ordinal":57223,"en":"He was a surpassingly mighty one."},{"id":"manas-2010:p1321:b001:l012","ordinal":57224,"en":"Turmoil that would long be spoken of,"},{"id":"manas-2010:p1321:b001:l013","ordinal":57225,"en":"Had he not come bringing it?"},{"id":"manas-2010:p1321:b001:l014","ordinal":57226,"en":"“To be a companion to my lord,”"},{"id":"manas-2010:p1321:b001:l015","ordinal":57227,"en":"From her own kin, Ayar,"},{"id":"manas-2010:p1321:b001:l016","ordinal":57228,"en":"Had she not brought him?"},{"id":"manas-2010:p1321:b001:l017","ordinal":57229,"en":"If the Chinese swarmed from every side,"},{"id":"manas-2010:p1321:b001:l018","ordinal":57230,"en":"If they swarmed, saying, ‘I shall seize them,’"},{"id":"manas-2010:p1321:b001:l019","ordinal":57231,"en":"Those who came before him,"},{"id":"manas-2010:p1321:b001:l020","ordinal":57232,"en":"He stabbed with his spear."},{"id":"manas-2010:p1321:b001:l021","ordinal":57233,"en":"Those who came at his flank,"},{"id":"manas-2010:p1321:b001:l022","ordinal":57234,"en":"He struck with its butt."},{"id":"manas-2010:p1321:b001:l023","ordinal":57235,"en":"The densely massed Chinese,"},{"id":"manas-2010:p1321:b001:l024","ordinal":57236,"en":"He fired upon with his musket."},{"id":"manas-2010:p1321:b001:l025","ordinal":57237,"en":"Those who drew close,"},{"id":"manas-2010:p1321:b001:l026","ordinal":57238,"en":"He struck with his sword."},{"id":"manas-2010:p1321:b001:l027","ordinal":57239,"en":"Their goal was Tal-Choku;"},{"id":"manas-2010:p1321:b001:l028","ordinal":57240,"en":"To the Chinese massed like a lake,"},{"id":"manas-2010:p1321:b001:l029","ordinal":57241,"en":"These five would not yield."},{"id":"manas-2010:p1321:b001:l030","ordinal":57242,"en":"So many straits like these,"},{"id":"manas-2010:p1321:b001:l031","ordinal":57243,"en":"Were they not companions who had seen them?"},{"id":"manas-2010:p1321:b001:l032","ordinal":57244,"en":"So many massacres and battles,"},{"id":"manas-2010:p1321:b001:l033","ordinal":57245,"en":"Were they not companions who had seen them?"},{"id":"manas-2010:p1321:b001:l034","ordinal":57246,"en":"So much gold and silver,"},{"id":"manas-2010:p1321:b001:l035","ordinal":57247,"en":"Were they not companions who had shared it?"},{"id":"manas-2010:p1321:b001:l036","ordinal":57248,"en":"Well versed in shooting,"},{"id":"manas-2010:p1321:b001:l037","ordinal":57249,"en":"Not flinching from a charge,"},{"id":"manas-2010:p1321:b001:l038","ordinal":57250,"en":"Not shrinking from an enemy,"},{"id":"manas-2010:p1321:b001:l039","ordinal":57251,"en":"Khan Manas's forty companions,"},{"id":"manas-2010:p1321:b001:l040","ordinal":57252,"en":"All forty were heroes."},{"id":"manas-2010:p1321:b001:l041","ordinal":57253,"en":"Not to be found elsewhere upon earth,"},{"id":"manas-2010:p1321:b001:l042","ordinal":57254,"en":"Every one of them was a lion."},{"id":"manas-2010:p1322:b001:l001","ordinal":57255,"en":"Told to take a cap, they cut off a head;"},{"id":"manas-2010:p1322:b001:l002","ordinal":57256,"en":"Told to drink water, they drank poison;"},{"id":"manas-2010:p1322:b001:l003","ordinal":57257,"en":"Told to spill blood, they spilled guts."},{"id":"manas-2010:p1322:b001:l004","ordinal":57258,"en":"All forty were fierce wolves."},{"id":"manas-2010:p1322:b001:l005","ordinal":57259,"en":"Their mighty lives were hard pressed;"},{"id":"manas-2010:p1322:b001:l006","ordinal":57260,"en":"At Tal-Choku, Manas"},{"id":"manas-2010:p1322:b001:l007","ordinal":57261,"en":"It was time to rescue."},{"id":"manas-2010:p1322:b001:l008","ordinal":57262,"en":"Ajybay entered the fight,"},{"id":"manas-2010:p1322:b001:l009","ordinal":57263,"en":"Destroyed sixty of them,"},{"id":"manas-2010:p1322:b001:l010","ordinal":57264,"en":"And came safely out from the Chinese."},{"id":"manas-2010:p1322:b001:l011","ordinal":57265,"en":"The Singer entered battle,"},{"id":"manas-2010:p1322:b001:l012","ordinal":57266,"en":"Destroyed seventy of them,"},{"id":"manas-2010:p1322:b001:l013","ordinal":57267,"en":"And came safely out of battle."},{"id":"manas-2010:p1322:b001:l014","ordinal":57268,"en":"Boz Uul entered battle,"},{"id":"manas-2010:p1322:b001:l015","ordinal":57269,"en":"Destroyed forty, thirty of them;"},{"id":"manas-2010:p1322:b001:l016","ordinal":57270,"en":"His head a bucket of blood,"},{"id":"manas-2010:p1322:b001:l017","ordinal":57271,"en":"His entire body numb,"},{"id":"manas-2010:p1322:b001:l018","ordinal":57272,"en":"He too came out of battle."},{"id":"manas-2010:p1322:b001:l019","ordinal":57273,"en":"Look at them, these five wolves:"},{"id":"manas-2010:p1322:b001:l020","ordinal":57274,"en":"Ajybay, the wise one,"},{"id":"manas-2010:p1322:b001:l021","ordinal":57275,"en":"Agayar, born a lion,"},{"id":"manas-2010:p1322:b001:l022","ordinal":57276,"en":"Baychoro, strong of hand,"},{"id":"manas-2010:p1322:b001:l023","ordinal":57277,"en":"With Akkula tugging fiercely,"},{"id":"manas-2010:p1322:b001:l024","ordinal":57278,"en":"Unable to master his mouth,"},{"id":"manas-2010:p1322:b001:l025","ordinal":57279,"en":"Jerking as though his rider had died,"},{"id":"manas-2010:p1322:b001:l026","ordinal":57280,"en":"They all emerged unharmed."},{"id":"manas-2010:p1322:b001:l027","ordinal":57281,"en":"Fighting their way out of the vast host,"},{"id":"manas-2010:p1322:b001:l028","ordinal":57282,"en":"Breaking and shattering the infidels,"},{"id":"manas-2010:p1322:b001:l029","ordinal":57283,"en":"Ajybay emerged, leaning back."},{"id":"manas-2010:p1322:b001:l030","ordinal":57284,"en":"How could the heroes hold back?"},{"id":"manas-2010:p1322:b001:l031","ordinal":57285,"en":"When midnight had passed,"},{"id":"manas-2010:p1322:b001:l032","ordinal":57286,"en":"They reached Tal-Choku."},{"id":"manas-2010:p1322:b001:l033","ordinal":57287,"en":"Its rocky path was terribly narrow;"},{"id":"manas-2010:p1322:b001:l034","ordinal":57288,"en":"In some places upon the peak,"},{"id":"manas-2010:p1322:b001:l035","ordinal":57289,"en":"There were places where one could die."},{"id":"manas-2010:p1322:b001:l036","ordinal":57290,"en":"Its surroundings formed a fortress."},{"id":"manas-2010:p1322:b001:l037","ordinal":57291,"en":"Unless Heaven itself took one's life,"},{"id":"manas-2010:p1322:b001:l038","ordinal":57292,"en":"It was a place where a soul could be saved."},{"id":"manas-2010:p1322:b001:l039","ordinal":57293,"en":"It was a ridge with a precious rocky path;"},{"id":"manas-2010:p1322:b001:l040","ordinal":57294,"en":"Not only the Chinese, but the whole world could not take it."},{"id":"manas-2010:p1322:b001:l041","ordinal":57295,"en":"It was a place like Judgment Day."},{"id":"manas-2010:p1322:b001:l042","ordinal":57296,"en":"Perish, tormenting world!"},{"id":"manas-2010:p1323:b001:l001","ordinal":57297,"en":"It was no place to leave without looking back."},{"id":"manas-2010:p1323:b001:l002","ordinal":57298,"en":"Fierce Manas, the dear lion,"},{"id":"manas-2010:p1323:b001:l003","ordinal":57299,"en":"Was no hero one could abandon."},{"id":"manas-2010:p1323:b001:l004","ordinal":57300,"en":"He himself was the support of the faith,"},{"id":"manas-2010:p1323:b001:l005","ordinal":57301,"en":"The mainstay of all Muslims."},{"id":"manas-2010:p1323:b001:l006","ordinal":57302,"en":"His valor was extraordinary;"},{"id":"manas-2010:p1323:b001:l007","ordinal":57303,"en":"He was set apart from humankind."},{"id":"manas-2010:p1323:b001:l008","ordinal":57304,"en":"His fortune was complete."},{"id":"manas-2010:p1323:b001:l009","ordinal":57305,"en":"Even if his gold flowed away,"},{"id":"manas-2010:p1323:b001:l010","ordinal":57306,"en":"His heart was broader than a lake."},{"id":"manas-2010:p1323:b001:l011","ordinal":57307,"en":"The five did not stand watching;"},{"id":"manas-2010:p1323:b001:l012","ordinal":57308,"en":"They headed toward Khan Manas."},{"id":"manas-2010:p1323:b001:l013","ordinal":57309,"en":"Akkula, led alongside,"},{"id":"manas-2010:p1323:b001:l014","ordinal":57310,"en":"They brought with them as they escaped."},{"id":"manas-2010:p1323:b001:l015","ordinal":57311,"en":"Passing through the narrow road,"},{"id":"manas-2010:p1323:b001:l016","ordinal":57312,"en":"When the five champions reached him,"},{"id":"manas-2010:p1323:b001:l017","ordinal":57313,"en":"Aybanboz, who had ceased to go,"},{"id":"manas-2010:p1323:b001:l018","ordinal":57314,"en":"When he saw Akkula,"},{"id":"manas-2010:p1323:b001:l019","ordinal":57315,"en":"Like a foal seeing its mother,"},{"id":"manas-2010:p1323:b001:l020","ordinal":57316,"en":"Neighed with a ringing cry."},{"id":"manas-2010:p1323:b001:l021","ordinal":57317,"en":"Out before Ajybay,"},{"id":"manas-2010:p1323:b001:l022","ordinal":57318,"en":"He trotted, crying loudly."},{"id":"manas-2010:p1323:b001:l023","ordinal":57319,"en":"Seeing Aybanboz,"},{"id":"manas-2010:p1323:b001:l024","ordinal":57320,"en":"Ajybay grew angry."},{"id":"manas-2010:p1323:b001:l025","ordinal":57321,"en":"‘You braying gray mule!"},{"id":"manas-2010:p1323:b001:l026","ordinal":57322,"en":"May the raven recite the Quran over you!"},{"id":"manas-2010:p1323:b001:l027","ordinal":57323,"en":"May the saddle sores never leave your back;"},{"id":"manas-2010:p1323:b001:l028","ordinal":57324,"en":"Let the piebald ones peck at his crown!"},{"id":"manas-2010:p1323:b001:l029","ordinal":57325,"en":"May the wolf eat your belly!"},{"id":"manas-2010:p1323:b001:l030","ordinal":57326,"en":"May God find your ailment!"},{"id":"manas-2010:p1323:b001:l031","ordinal":57327,"en":"Unable to go upon a level road,"},{"id":"manas-2010:p1323:b001:l032","ordinal":57328,"en":"What trouble have you brought upon us?"},{"id":"manas-2010:p1323:b001:l033","ordinal":57329,"en":"Useless in a crisis,"},{"id":"manas-2010:p1323:b001:l034","ordinal":57330,"en":"You brought Judgment Day upon us."},{"id":"manas-2010:p1323:b001:l035","ordinal":57331,"en":"I was a cloud; you made me a road."},{"id":"manas-2010:p1323:b001:l036","ordinal":57332,"en":"Making him suffer terrible torment,"},{"id":"manas-2010:p1323:b001:l037","ordinal":57333,"en":"Loading him with his broad-pommeled saddle,"},{"id":"manas-2010:p1323:b001:l038","ordinal":57334,"en":"Making my Magnanimous One go on foot,"},{"id":"manas-2010:p1323:b001:l039","ordinal":57335,"en":"You shamed him exceedingly!’"},{"id":"manas-2010:p1323:b001:l040","ordinal":57336,"en":"Saying this, Ajybay"},{"id":"manas-2010:p1323:b001:l041","ordinal":57337,"en":"Passed without turning."},{"id":"manas-2010:p1323:b001:l042","ordinal":57338,"en":"Yraman's Singer's Son,"},{"id":"manas-2010:p1324:b001:l001","ordinal":57339,"en":"The battle-axe with golden blade,"},{"id":"manas-2010:p1324:b001:l002","ordinal":57340,"en":"He took and swung,"},{"id":"manas-2010:p1324:b001:l003","ordinal":57341,"en":"Struck him down as he passed."},{"id":"manas-2010:p1324:b001:l004","ordinal":57342,"en":"With Akkula tugging fiercely,"},{"id":"manas-2010:p1324:b001:l005","ordinal":57343,"en":"To the magnanimous hero Manas,"},{"id":"manas-2010:p1324:b001:l006","ordinal":57344,"en":"As he lay at Tal-Choku,"}]
