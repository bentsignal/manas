[{"id":"semetey-1-2013:p0185:b005:l013","ordinal":90881,"en":"The nobleman's child,"},{"id":"semetey-1-2013:p0185:b005:l014","ordinal":90882,"en":"Ismayil, how would it be if I entrusted him to you?"},{"id":"semetey-1-2013:p0185:b005:l015","ordinal":90883,"en":"I have cut his twig;"},{"id":"semetey-1-2013:p0185:b005:l016","ordinal":90884,"en":"Let me perform every rite.’"},{"id":"semetey-1-2013:p0185:b005:l017","ordinal":90885,"en":"She made him pass over the dog's bowl,"},{"id":"semetey-1-2013:p0185:b005:l018","ordinal":90886,"en":"Made him step across the sword's edge,"},{"id":"semetey-1-2013:p0185:b005:l019","ordinal":90887,"en":"And performed his rite."},{"id":"semetey-1-2013:p0185:b005:l020","ordinal":90888,"en":"‘May I perish if I call him my child;"},{"id":"semetey-1-2013:p0185:b005:l021","ordinal":90889,"en":"If I call this one my camel calf,"},{"id":"semetey-1-2013:p0185:b005:l022","ordinal":90890,"en":"May I never prosper!’"},{"id":"semetey-1-2013:p0185:b005:l023","ordinal":90891,"en":"Your noble sister-in-law Kanykei,"},{"id":"semetey-1-2013:p0185:b005:l024","ordinal":90892,"en":"When she gave Semetey to Ismayil,"},{"id":"semetey-1-2013:p0185:b005:l025","ordinal":90893,"en":"Chewed white wheat flour"},{"id":"semetey-1-2013:p0185:b005:l026","ordinal":90894,"en":"And held the sacred Quran."},{"id":"semetey-1-2013:p0185:b005:l027","ordinal":90895,"en":"Kanykei had come in mourning;"},{"id":"semetey-1-2013:p0185:b005:l028","ordinal":90896,"en":"Semetey had come in flight."},{"id":"semetey-1-2013:p0185:b005:l029","ordinal":90897,"en":"Of this deceitful, abundant world,"},{"id":"semetey-1-2013:p0185:b005:l030","ordinal":90898,"en":"She had seen the falsehood now."},{"id":"semetey-1-2013:p0185:b005:l031","ordinal":90899,"en":"Performing many rites,"},{"id":"semetey-1-2013:p0185:b005:l032","ordinal":90900,"en":"She gave the child to Ismayil."},{"id":"semetey-1-2013:p0185:b005:l033","ordinal":90901,"en":"Ismayil took the child,"},{"id":"semetey-1-2013:p0185:b005:l034","ordinal":90902,"en":"Still in his cradle days."},{"id":"semetey-1-2013:p0185:b005:l035","ordinal":90903,"en":"As a rite for the child,"},{"id":"semetey-1-2013:p0185:b005:l036","ordinal":90904,"en":"He dressed him in a coat of mail"},{"id":"semetey-1-2013:p0185:b005:l037","ordinal":90905,"en":"And set the lucky swaddled one"},{"id":"semetey-1-2013:p0185:b005:l038","ordinal":90906,"en":"Upon his great brown horse."},{"id":"semetey-1-2013:p0185:b005:l039","ordinal":90907,"en":"Traveling by night, not by day,"},{"id":"semetey-1-2013:p0186:b003:l001","ordinal":90908,"en":"When they reached Bukhara,"},{"id":"semetey-1-2013:p0186:b003:l002","ordinal":90909,"en":"They feasted for seventeen days,"},{"id":"semetey-1-2013:p0186:b003:l003","ordinal":90910,"en":"Their poles bending,"},{"id":"semetey-1-2013:p0186:b003:l004","ordinal":90911,"en":"Their heroes jousting."},{"id":"semetey-1-2013:p0186:b003:l005","ordinal":90912,"en":"Calling it ‘Semetey's feast,’"},{"id":"semetey-1-2013:p0186:b003:l006","ordinal":90913,"en":"The treasury of four kinds of livestock,"},{"id":"semetey-1-2013:p0186:b003:l007","ordinal":90914,"en":"Ismayil the lord"},{"id":"semetey-1-2013:p0186:b003:l008","ordinal":90915,"en":"Opened wide from the top."},{"id":"semetey-1-2013:p0186:b003:l009","ordinal":90916,"en":"All four kinds of livestock"},{"id":"semetey-1-2013:p0186:b003:l010","ordinal":90917,"en":"He spent and scattered generously."},{"id":"semetey-1-2013:p0186:b003:l011","ordinal":90918,"en":"Russians ate at the feast and departed,"},{"id":"semetey-1-2013:p0186:b003:l012","ordinal":90919,"en":"Saying, ‘If this son of yours lives,"},{"id":"semetey-1-2013:p0186:b003:l013","ordinal":90920,"en":"He will overthrow the Oirats.’"},{"id":"semetey-1-2013:p0186:b003:l014","ordinal":90921,"en":"At Semetey's feast,"},{"id":"semetey-1-2013:p0186:b003:l015","ordinal":90922,"en":"Chinese ate and departed,"},{"id":"semetey-1-2013:p0186:b003:l016","ordinal":90923,"en":"Saying, ‘If this child lives,"},{"id":"semetey-1-2013:p0186:b003:l017","ordinal":90924,"en":"He will overthrow the world.’"},{"id":"semetey-1-2013:p0186:b003:l018","ordinal":90925,"en":"All the long, malicious talk"},{"id":"semetey-1-2013:p0186:b003:l019","ordinal":90926,"en":"Had its mouth shut completely."},{"id":"semetey-1-2013:p0186:b003:l020","ordinal":90927,"en":"Your orphan left by Manas"},{"id":"semetey-1-2013:p0186:b003:l021","ordinal":90928,"en":"Entered Bukhara and was raised there."},{"id":"semetey-1-2013:p0186:b003:l022","ordinal":90929,"en":"Temir Khan, the khan of Bukhara,"},{"id":"semetey-1-2013:p0186:b003:l023","ordinal":90930,"en":"He too, Kanykei's father,"},{"id":"semetey-1-2013:p0186:b003:l024","ordinal":90931,"en":"Wore a golden crown"},{"id":"semetey-1-2013:p0186:b003:l025","ordinal":90932,"en":"And sat upon a golden throne."},{"id":"semetey-1-2013:p0186:b003:l026","ordinal":90933,"en":"He heard from Ismayil:"},{"id":"semetey-1-2013:p0186:b003:l027","ordinal":90934,"en":"‘Dear child Kanykei,"},{"id":"semetey-1-2013:p0186:b003:l028","ordinal":90935,"en":"Parted from Khan Manas,"},{"id":"semetey-1-2013:p0186:b003:l029","ordinal":90936,"en":"The countless riches Manas left,"},{"id":"semetey-1-2013:p0186:b003:l030","ordinal":90937,"en":"She scattered and came,’ he heard."},{"id":"semetey-1-2013:p0186:b003:l031","ordinal":90938,"en":"‘With no kin to look to,"},{"id":"semetey-1-2013:p0186:b003:l032","ordinal":90939,"en":"Carrying the child upon her back,"},{"id":"semetey-1-2013:p0186:b003:l033","ordinal":90940,"en":"She wandered astray and came,’ he heard."},{"id":"semetey-1-2013:p0186:b003:l034","ordinal":90941,"en":"Without slippers, in stockings,"},{"id":"semetey-1-2013:p0186:b003:l035","ordinal":90942,"en":"Her poor soul did not die of grief."},{"id":"semetey-1-2013:p0186:b003:l036","ordinal":90943,"en":"Without boots, in stockings,"},{"id":"semetey-1-2013:p0186:b003:l037","ordinal":90944,"en":"If her angel of death has not come,"},{"id":"semetey-1-2013:p0186:b003:l038","ordinal":90945,"en":"Her poor soul will not die of sobbing."},{"id":"semetey-1-2013:p0186:b003:l039","ordinal":90946,"en":"‘All the property they had gathered,"},{"id":"semetey-1-2013:p0186:b004:l001","ordinal":90947,"en":"My wretched child Kanykei"},{"id":"semetey-1-2013:p0186:b004:l002","ordinal":90948,"en":"Scattered and came, I heard."},{"id":"semetey-1-2013:p0186:b004:l003","ordinal":90949,"en":"When leopard Manas died,"},{"id":"semetey-1-2013:p0186:b004:l004","ordinal":90950,"en":"She fled and came, I heard."},{"id":"semetey-1-2013:p0186:b004:l005","ordinal":90951,"en":"Her felt coat flapping,"},{"id":"semetey-1-2013:p0186:b004:l006","ordinal":90952,"en":"Riding a brown mare and jolting,"},{"id":"semetey-1-2013:p0186:b004:l007","ordinal":90953,"en":"Hurting her heels,"},{"id":"semetey-1-2013:p0186:b004:l008","ordinal":90954,"en":"Chafing the soles of her feet,"},{"id":"semetey-1-2013:p0186:b004:l009","ordinal":90955,"en":"Her legs losing strength at every step,"},{"id":"semetey-1-2013:p0186:b004:l010","ordinal":90956,"en":"Dark blood flowing from her soles,"},{"id":"semetey-1-2013:p0186:b004:l011","ordinal":90957,"en":"Left all on her own,"},{"id":"semetey-1-2013:p0186:b004:l012","ordinal":90958,"en":"Parted from her bloodthirsty hero,"},{"id":"semetey-1-2013:p0186:b004:l013","ordinal":90959,"en":"At thirty-two years of age,"},{"id":"semetey-1-2013:p0186:b004:l014","ordinal":90960,"en":"Though she lamented, God would not take her."},{"id":"semetey-1-2013:p0186:b004:l015","ordinal":90961,"en":"The slave Abyke's whip"},{"id":"semetey-1-2013:p0186:b004:l016","ordinal":90962,"en":"Left no part of her fleshy buttocks untouched."},{"id":"semetey-1-2013:p0186:b004:l017","ordinal":90963,"en":"My child Kanykei,"},{"id":"semetey-1-2013:p0186:b004:l018","ordinal":90964,"en":"Youngest of twelve daughters,"},{"id":"semetey-1-2013:p0186:b004:l019","ordinal":90965,"en":"God's beloved mortal,"},{"id":"semetey-1-2013:p0186:b004:l020","ordinal":90966,"en":"Beauty of the dark-complexioned,"},{"id":"semetey-1-2013:p0186:b004:l021","ordinal":90967,"en":"My foal, radiant among Muslims."},{"id":"semetey-1-2013:p0186:b004:l022","ordinal":90968,"en":"When she reached six,"},{"id":"semetey-1-2013:p0186:b004:l023","ordinal":90969,"en":"My noble child Kanykei,"},{"id":"semetey-1-2013:p0186:b004:l024","ordinal":90970,"en":"I cherished her and braided her hair."},{"id":"semetey-1-2013:p0186:b004:l025","ordinal":90971,"en":"When she reached nine,"},{"id":"semetey-1-2013:p0186:b004:l026","ordinal":90972,"en":"More than ninety ranks of sons,"},{"id":"semetey-1-2013:p0186:b004:l027","ordinal":90973,"en":"I loved her, as I still do today."},{"id":"semetey-1-2013:p0186:b004:l028","ordinal":90974,"en":"When she reached ten,"},{"id":"semetey-1-2013:p0186:b004:l029","ordinal":90975,"en":"My plane tree, my fortress with gates."},{"id":"semetey-1-2013:p0186:b004:l030","ordinal":90976,"en":"When she reached twelve,"},{"id":"semetey-1-2013:p0186:b004:l031","ordinal":90977,"en":"Though a girl, Kanykei"},{"id":"semetey-1-2013:p0186:b004:l032","ordinal":90978,"en":"Was my dark-browed hawk."},{"id":"semetey-1-2013:p0186:b004:l033","ordinal":90979,"en":"As she neared thirteen,"},{"id":"semetey-1-2013:p0186:b004:l034","ordinal":90980,"en":"She shook the world and stirred the people."},{"id":"semetey-1-2013:p0186:b004:l035","ordinal":90981,"en":"When she reached fourteen,"},{"id":"semetey-1-2013:p0186:b004:l036","ordinal":90982,"en":"Her courage made her bold;"},{"id":"semetey-1-2013:p0186:b004:l037","ordinal":90983,"en":"She met Hero Manas."},{"id":"semetey-1-2013:p0186:b004:l038","ordinal":90984,"en":"When she reached fifteen,"},{"id":"semetey-1-2013:p0186:b004:l039","ordinal":90985,"en":"Renowned Manas—"},{"id":"semetey-1-2013:p0187:b003:l001","ordinal":90986,"en":"She planted him and made a garden,"},{"id":"semetey-1-2013:p0187:b003:l002","ordinal":90987,"en":"Joined what had been severed,"},{"id":"semetey-1-2013:p0187:b003:l003","ordinal":90988,"en":"Gathered what had been scattered,"},{"id":"semetey-1-2013:p0187:b003:l004","ordinal":90989,"en":"Kindled his extinguished fire,"},{"id":"semetey-1-2013:p0187:b003:l005","ordinal":90990,"en":"Revived his deadened soul."},{"id":"semetey-1-2013:p0187:b003:l006","ordinal":90991,"en":"She pursued claims together with him;"},{"id":"semetey-1-2013:p0187:b003:l007","ordinal":90992,"en":"If there were foes, she fought them with him."},{"id":"semetey-1-2013:p0187:b003:l008","ordinal":90993,"en":"Manas, whom Khizyr had touched,"},{"id":"semetey-1-2013:p0187:b003:l009","ordinal":90994,"en":"My precious daughter met him."},{"id":"semetey-1-2013:p0187:b003:l010","ordinal":90995,"en":"Manas, whom the prophet had touched,"},{"id":"semetey-1-2013:p0187:b003:l011","ordinal":90996,"en":"My sovereign daughter encountered him."},{"id":"semetey-1-2013:p0187:b003:l012","ordinal":90997,"en":"This child of mine, Kanykei,"},{"id":"semetey-1-2013:p0187:b003:l013","ordinal":90998,"en":"When she stayed with Khan Manas,"},{"id":"semetey-1-2013:p0187:b003:l014","ordinal":90999,"en":"Was a firmly established house."},{"id":"semetey-1-2013:p0187:b003:l015","ordinal":91000,"en":"The sovereign among women,"},{"id":"semetey-1-2013:p0187:b003:l016","ordinal":91001,"en":"My child was khan to the world."},{"id":"semetey-1-2013:p0187:b003:l017","ordinal":91002,"en":"Two reins and a single lead rope,"},{"id":"semetey-1-2013:p0187:b003:l018","ordinal":91003,"en":"Held firmly about her wrist,"},{"id":"semetey-1-2013:p0187:b003:l019","ordinal":91004,"en":"This was the child who took them up."},{"id":"semetey-1-2013:p0187:b003:l020","ordinal":91005,"en":"Kneading the people like dough,"},{"id":"semetey-1-2013:p0187:b003:l021","ordinal":91006,"en":"This was the child who ruled them."},{"id":"semetey-1-2013:p0187:b003:l022","ordinal":91007,"en":"An iron rope across her path—"},{"id":"semetey-1-2013:p0187:b003:l023","ordinal":91008,"en":"Have you seen it become a snare?"},{"id":"semetey-1-2013:p0187:b003:l024","ordinal":91009,"en":"Parted from her ocean,"},{"id":"semetey-1-2013:p0187:b003:l026","ordinal":91010,"en":"Wandering into Bukhara,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0187:b003:l027","ordinal":91011,"en":"Have you seen her humiliated?"},{"id":"semetey-1-2013:p0187:b003:l028","ordinal":91012,"en":"Alas, her forehead bone was curved;"},{"id":"semetey-1-2013:p0187:b003:l029","ordinal":91013,"en":"After the hero passed away,"},{"id":"semetey-1-2013:p0187:b003:l030","ordinal":91014,"en":"My child's prospect of living was meager."},{"id":"semetey-1-2013:p0187:b003:l031","ordinal":91015,"en":"The hair down her back was like grass;"},{"id":"semetey-1-2013:p0187:b003:l032","ordinal":91016,"en":"Her ruin outweighed her happiness"},{"id":"semetey-1-2013:p0187:b003:l033","ordinal":91017,"en":"By many a spear's length."},{"id":"semetey-1-2013:p0187:b003:l034","ordinal":91018,"en":"Though a girl, Kanykei"},{"id":"semetey-1-2013:p0187:b003:l035","ordinal":91019,"en":"Had everything in balance;"},{"id":"semetey-1-2013:p0187:b003:l036","ordinal":91020,"en":"She was a lion protected by Shay."},{"id":"semetey-1-2013:p0187:b003:l037","ordinal":91021,"en":"Gathering harriers and making hunting birds,"},{"id":"semetey-1-2013:p0187:b003:l038","ordinal":91022,"en":"She was one of those wretched slavewomen."},{"id":"semetey-1-2013:p0187:b003:l039","ordinal":91023,"en":"This wretched child of mine, Kanykei,"},{"id":"semetey-1-2013:p0187:b005:l001","ordinal":91024,"en":"Gathered mixed peoples and made a nation,"},{"id":"semetey-1-2013:p0187:b005:l002","ordinal":91025,"en":"Raised small falcons into hunting birds,"},{"id":"semetey-1-2013:p0187:b005:l003","ordinal":91026,"en":"Gathered wanderers and made a people."},{"id":"semetey-1-2013:p0187:b005:l004","ordinal":91027,"en":"If someone came without strength,"},{"id":"semetey-1-2013:p0187:b005:l005","ordinal":91028,"en":"With wild-sheep feet and copper forelegs,"},{"id":"semetey-1-2013:p0187:b005:l006","ordinal":91029,"en":"A Karabair battle steed,"},{"id":"semetey-1-2013:p0187:b005:l007","ordinal":91030,"en":"With sieve-like lungs and copper forelegs,"},{"id":"semetey-1-2013:p0187:b005:l008","ordinal":91031,"en":"She mounted him upon the finest horse."},{"id":"semetey-1-2013:p0187:b005:l009","ordinal":91032,"en":"To the person who came without a coat,"},{"id":"semetey-1-2013:p0187:b005:l010","ordinal":91033,"en":"With golden collar and copper sleeves,"},{"id":"semetey-1-2013:p0187:b005:l011","ordinal":91034,"en":"Double mail with lark-eye rings,"},{"id":"semetey-1-2013:p0187:b005:l012","ordinal":91035,"en":"A fine-cloth jacket with broad collar,"},{"id":"semetey-1-2013:p0187:b005:l013","ordinal":91036,"en":"She gave the finest coat to wear."},{"id":"semetey-1-2013:p0187:b005:l014","ordinal":91037,"en":"To the person who came without a home,"},{"id":"semetey-1-2013:p0187:b005:l015","ordinal":91038,"en":"With golden roof-ring and copper ties,"},{"id":"semetey-1-2013:p0187:b005:l016","ordinal":91039,"en":"She gave entry to a white palace-yurt."},{"id":"semetey-1-2013:p0187:b005:l017","ordinal":91040,"en":"To the person who came without faith,"},{"id":"semetey-1-2013:p0187:b005:l018","ordinal":91041,"en":"She found a way to bring him to the faith."},{"id":"semetey-1-2013:p0187:b005:l019","ordinal":91042,"en":"To the man who came without a wife,"},{"id":"semetey-1-2013:p0187:b005:l020","ordinal":91043,"en":"With thimble mouth and camel-calf eyes,"},{"id":"semetey-1-2013:p0187:b005:l021","ordinal":91044,"en":"With roving dark eyes,"},{"id":"semetey-1-2013:p0187:b005:l022","ordinal":91045,"en":"A crimson dress and moon-slender waist,"},{"id":"semetey-1-2013:p0187:b005:l023","ordinal":91046,"en":"Adorned hips and broad braid ornaments,"},{"id":"semetey-1-2013:p0187:b005:l024","ordinal":91047,"en":"Graceful, with camel-calf eyes,"},{"id":"semetey-1-2013:p0187:b005:l025","ordinal":91048,"en":"Kanykei procured a wife for him."},{"id":"semetey-1-2013:p0187:b005:l026","ordinal":91049,"en":"If someone came without livestock,"},{"id":"semetey-1-2013:p0187:b005:l027","ordinal":91050,"en":"Mountain horses with mottled heads,"},{"id":"semetey-1-2013:p0187:b005:l028","ordinal":91051,"en":"Noble steeds and chargers among them,"},{"id":"semetey-1-2013:p0187:b005:l029","ordinal":91052,"en":"Kanykei gave him livestock."},{"id":"semetey-1-2013:p0187:b005:l030","ordinal":91053,"en":"If someone came without position,"},{"id":"semetey-1-2013:p0187:b005:l031","ordinal":91054,"en":"She crowned him with a golden crown,"},{"id":"semetey-1-2013:p0187:b005:l032","ordinal":91055,"en":"Seated him upon a golden throne,"},{"id":"semetey-1-2013:p0187:b005:l033","ordinal":91056,"en":"Over the palm-sized Kyrgyz people,"},{"id":"semetey-1-2013:p0187:b005:l034","ordinal":91057,"en":"Kanykei bestowed the khanship."},{"id":"semetey-1-2013:p0187:b005:l035","ordinal":91058,"en":"Rarely encountered in the darkness,"},{"id":"semetey-1-2013:p0187:b005:l036","ordinal":91059,"en":"She was the Night of Power itself."},{"id":"semetey-1-2013:p0187:b005:l037","ordinal":91060,"en":"When bloodthirsty Manas lived,"},{"id":"semetey-1-2013:p0187:b005:l038","ordinal":91061,"en":"She was a woman sovereign, a slavewoman;"},{"id":"semetey-1-2013:p0187:b005:l039","ordinal":91062,"en":"My formidable child Kanykei,"},{"id":"semetey-1-2013:p0188:b003:l001","ordinal":91063,"en":"She was a saint herself;"},{"id":"semetey-1-2013:p0188:b003:l002","ordinal":91064,"en":"Indeed, this woman"},{"id":"semetey-1-2013:p0188:b003:l003","ordinal":91065,"en":"Was the very dark pupil of his eye."},{"id":"semetey-1-2013:p0188:b003:l004","ordinal":91066,"en":"When her lord Manas died,"},{"id":"semetey-1-2013:p0188:b003:l005","ordinal":91067,"en":"All her worldly wealth—"},{"id":"semetey-1-2013:p0188:b003:l006","ordinal":91068,"en":"Look how she scattered it."},{"id":"semetey-1-2013:p0188:b003:l007","ordinal":91069,"en":"Barefoot and bareheaded,"},{"id":"semetey-1-2013:p0188:b003:l008","ordinal":91070,"en":"Thinking that when a woman's husband dies"},{"id":"semetey-1-2013:p0188:b003:l009","ordinal":91071,"en":"Her birth family is her nearest refuge,"},{"id":"semetey-1-2013:p0188:b003:l010","ordinal":91072,"en":"My dear child Kanykei—"},{"id":"semetey-1-2013:p0188:b003:l011","ordinal":91073,"en":"Look how she fled!"},{"id":"semetey-1-2013:p0188:b003:l012","ordinal":91074,"en":"Crying like a hunting hound,"},{"id":"semetey-1-2013:p0188:b003:l013","ordinal":91075,"en":"Look how she hurried along."},{"id":"semetey-1-2013:p0188:b003:l014","ordinal":91076,"en":"Hardship fell upon her;"},{"id":"semetey-1-2013:p0188:b003:l015","ordinal":91077,"en":"Fleeing Talas, wandering on foot,"},{"id":"semetey-1-2013:p0188:b003:l016","ordinal":91078,"en":"Look how my child has come."},{"id":"semetey-1-2013:p0188:b003:l017","ordinal":91079,"en":"When things go well, this shitty, false world—"},{"id":"semetey-1-2013:p0188:b003:l018","ordinal":91080,"en":"See how sweet as sugar it seems!"},{"id":"semetey-1-2013:p0188:b003:l019","ordinal":91081,"en":"The household of a mighty khan"},{"id":"semetey-1-2013:p0188:b003:l020","ordinal":91082,"en":"Wanders wearily to Bukhara:"},{"id":"semetey-1-2013:p0188:b003:l021","ordinal":91083,"en":"This deceitful world—"},{"id":"semetey-1-2013:p0188:b003:l022","ordinal":91084,"en":"Look how worthless it is."},{"id":"semetey-1-2013:p0188:b003:l023","ordinal":91085,"en":"Only yesterday, in Jylgynduu,"},{"id":"semetey-1-2013:p0188:b003:l024","ordinal":91086,"en":"In the valley of Keng-Kol,"},{"id":"semetey-1-2013:p0188:b003:l025","ordinal":91087,"en":"Along the broad Talas,"},{"id":"semetey-1-2013:p0188:b003:l026","ordinal":91088,"en":"Fortune had settled upon her, resounding—"},{"id":"semetey-1-2013:p0188:b003:l027","ordinal":91089,"en":"Such was my child's prosperity."},{"id":"semetey-1-2013:p0188:b003:l028","ordinal":91090,"en":"Bereft of her sovereign,"},{"id":"semetey-1-2013:p0188:b003:l029","ordinal":91091,"en":"To the city of the khan who has children,"},{"id":"semetey-1-2013:p0188:b003:l030","ordinal":91092,"en":"She has wandered on foot:"},{"id":"semetey-1-2013:p0188:b003:l031","ordinal":91093,"en":"This is the suffering God has sent."},{"id":"semetey-1-2013:p0188:b003:l032","ordinal":91094,"en":"Kanykei, like a brown doe—"},{"id":"semetey-1-2013:p0188:b003:l033","ordinal":91095,"en":"My unfortunate child had no luck in Keng-Kol,"},{"id":"semetey-1-2013:p0188:b003:l035","ordinal":91096,"en":"Or she would never have come to Bukhara."},{"id":"semetey-1-2013:p0188:b003:l036","ordinal":91097,"en":"My stately child,"},{"id":"semetey-1-2013:p0188:b003:l037","ordinal":91098,"en":"Bereft of Khan Manas—"},{"id":"semetey-1-2013:p0188:b003:l038","ordinal":91099,"en":"This child of mine has no luck."},{"id":"semetey-1-2013:p0188:b003:l039","ordinal":91100,"en":"Alas, she had no luck in Talas!"},{"id":"semetey-1-2013:p0188:b004:l001","ordinal":91101,"en":"Wandering tirelessly from Talas,"},{"id":"semetey-1-2013:p0188:b004:l002","ordinal":91102,"en":"She has arrived in this very plight:"},{"id":"semetey-1-2013:p0188:b004:l003","ordinal":91103,"en":"This child of mine has no luck."},{"id":"semetey-1-2013:p0188:b004:l004","ordinal":91104,"en":"Summer's green grass, broad pasture—"},{"id":"semetey-1-2013:p0188:b004:l005","ordinal":91105,"en":"Who would not move camp there?"},{"id":"semetey-1-2013:p0188:b004:l006","ordinal":91106,"en":"If grievous trouble fell upon their head,"},{"id":"semetey-1-2013:p0188:b004:l007","ordinal":91107,"en":"Who would not end up like this?"},{"id":"semetey-1-2013:p0188:b004:l008","ordinal":91108,"en":"With a marten-fur cap upon their head,"},{"id":"semetey-1-2013:p0188:b004:l009","ordinal":91109,"en":"Who would not wear it jauntily?"},{"id":"semetey-1-2013:p0188:b004:l010","ordinal":91110,"en":"When their fortunate hour is upon them,"},{"id":"semetey-1-2013:p0188:b004:l011","ordinal":91111,"en":"Who has not strode about in splendor?"},{"id":"semetey-1-2013:p0188:b004:l012","ordinal":91112,"en":"When he heard the news"},{"id":"semetey-1-2013:p0188:b004:l013","ordinal":91113,"en":"Of this child of mine, Kanykei,"},{"id":"semetey-1-2013:p0188:b004:l014","ordinal":91114,"en":"Even the khan of Kakan was shaken."},{"id":"semetey-1-2013:p0188:b004:l015","ordinal":91115,"en":"My dignified child Kanykei,"},{"id":"semetey-1-2013:p0188:b004:l016","ordinal":91116,"en":"Though a woman, my dear foal,"},{"id":"semetey-1-2013:p0188:b004:l017","ordinal":91117,"en":"Found words in an unexpected crisis,"},{"id":"semetey-1-2013:p0188:b004:l018","ordinal":91118,"en":"Found eyes to see in darkness."},{"id":"semetey-1-2013:p0188:b004:l019","ordinal":91119,"en":"Her fame was known among the people;"},{"id":"semetey-1-2013:p0188:b004:l020","ordinal":91120,"en":"The goodness of my child"},{"id":"semetey-1-2013:p0188:b004:l021","ordinal":91121,"en":"In Beijing and its Kakan's realm,"},{"id":"semetey-1-2013:p0188:b004:l022","ordinal":91122,"en":"Was entered in the registers."},{"id":"semetey-1-2013:p0188:b004:l023","ordinal":91123,"en":"'What a fearsome, fiery woman!' he said;"},{"id":"semetey-1-2013:p0188:b004:l024","ordinal":91124,"en":"Once he knew her great worth,"},{"id":"semetey-1-2013:p0188:b004:l025","ordinal":91125,"en":"Even the khan of Beijing grieved."},{"id":"semetey-1-2013:p0188:b004:l026","ordinal":91126,"en":"The reason he grieved was this:"},{"id":"semetey-1-2013:p0188:b004:l027","ordinal":91127,"en":"Khan Manas's forty lords—"},{"id":"semetey-1-2013:p0188:b004:l028","ordinal":91128,"en":"She had mounted them on matching noble steeds."},{"id":"semetey-1-2013:p0188:b004:l029","ordinal":91129,"en":"Musket bullets could not pierce them—"},{"id":"semetey-1-2013:p0188:b004:l030","ordinal":91130,"en":"The matching coats she clothed them in."},{"id":"semetey-1-2013:p0188:b004:l031","ordinal":91131,"en":"Their prince spent summers in Talas;"},{"id":"semetey-1-2013:p0188:b004:l032","ordinal":91132,"en":"Whoever roused his anger,"},{"id":"semetey-1-2013:p0188:b004:l033","ordinal":91133,"en":"He caught in his fangs and chewed."},{"id":"semetey-1-2013:p0188:b004:l034","ordinal":91134,"en":"Alas, should a prince's wife"},{"id":"semetey-1-2013:p0188:b004:l035","ordinal":91135,"en":"Have had to come here in flight?"},{"id":"semetey-1-2013:p0188:b004:l036","ordinal":91136,"en":"Upon that honorable khan's household,"}]
