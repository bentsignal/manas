[{"id":"semetey-1-2013:p0620:b004:l015","ordinal":124417,"en":"The only son of Khan Azyz,"},{"id":"semetey-1-2013:p0620:b004:l016","ordinal":124418,"en":"Almambet, must have come."},{"id":"semetey-1-2013:p0620:b004:l017","ordinal":124419,"en":"Embracing the Magnanimous One,"},{"id":"semetey-1-2013:p0620:b004:l018","ordinal":124420,"en":"He too must be lying with him."},{"id":"semetey-1-2013:p0620:b004:l019","ordinal":124421,"en":"The mighty man on his left—"},{"id":"semetey-1-2013:p0620:b004:l020","ordinal":124422,"en":"Stars stirred in the heavens."},{"id":"semetey-1-2013:p0620:b004:l021","ordinal":124423,"en":"To your formidable sultan father"},{"id":"semetey-1-2013:p0620:b004:l022","ordinal":124424,"en":"He had been a friend twelve times."},{"id":"semetey-1-2013:p0620:b004:l023","ordinal":124425,"en":"Akbaltai's Chubak,"},{"id":"semetey-1-2013:p0620:b004:l024","ordinal":124426,"en":"For your fierce-maned lion father,"},{"id":"semetey-1-2013:p0620:b004:l025","ordinal":124427,"en":"Was that dear, resourceful one."},{"id":"semetey-1-2013:p0620:b004:l026","ordinal":124428,"en":"Because he found a way,"},{"id":"semetey-1-2013:p0620:b004:l027","ordinal":124429,"en":"He was your magnanimous father's support."},{"id":"semetey-1-2013:p0620:b004:l028","ordinal":124430,"en":"Long ago, against the Manchu and Black Chinese,"},{"id":"semetey-1-2013:p0620:b004:l029","ordinal":124431,"en":"When they unleashed great slaughter,"},{"id":"semetey-1-2013:p0620:b004:l030","ordinal":124432,"en":"Chubak, all alone,"},{"id":"semetey-1-2013:p0620:b004:l031","ordinal":124433,"en":"The Manchu khan Ezkara"},{"id":"semetey-1-2013:p0620:b004:l032","ordinal":124434,"en":"And the forty nobles beside him,"},{"id":"semetey-1-2013:p0620:b004:l033","ordinal":124435,"en":"When he brought them bound by himself—"},{"id":"semetey-1-2013:p0620:b004:l034","ordinal":124436,"en":"Such courage as Chubak's"},{"id":"semetey-1-2013:p0620:b004:l035","ordinal":124437,"en":"Could be found in no other mortal,"},{"id":"semetey-1-2013:p0620:b004:l036","ordinal":124438,"en":"That dark, fierce-maned dear one."},{"id":"semetey-1-2013:p0620:b004:l037","ordinal":124439,"en":"Without killing or losing them,"},{"id":"semetey-1-2013:p0620:b004:l038","ordinal":124440,"en":"He bent them over in pairs,"},{"id":"semetey-1-2013:p0620:b004:l039","ordinal":124441,"en":"Bound and brought them alive,"},{"id":"semetey-1-2013:p0621:b003:l001","ordinal":124442,"en":"And loaded each onto a horse."},{"id":"semetey-1-2013:p0621:b003:l002","ordinal":124443,"en":"His reach extended to Talas."},{"id":"semetey-1-2013:p0621:b003:l003","ordinal":124444,"en":"With Ezkara at their head,"},{"id":"semetey-1-2013:p0621:b003:l004","ordinal":124445,"en":"The forty Chinese nobles"},{"id":"semetey-1-2013:p0621:b003:l005","ordinal":124446,"en":"He presented to your father Sultan Manas."},{"id":"semetey-1-2013:p0621:b003:l006","ordinal":124447,"en":"He broke the Chinese backbone,"},{"id":"semetey-1-2013:p0621:b003:l007","ordinal":124448,"en":"And gave your fierce-maned father peace."},{"id":"semetey-1-2013:p0621:b003:l008","ordinal":124449,"en":"When people die"},{"id":"semetey-1-2013:p0621:b003:l009","ordinal":124450,"en":"He was a most important khan."},{"id":"semetey-1-2013:p0621:b003:l010","ordinal":124451,"en":"On Ezkara's account,"},{"id":"semetey-1-2013:p0621:b003:l011","ordinal":124452,"en":"They put a golden crown upon him."},{"id":"semetey-1-2013:p0621:b003:l012","ordinal":124453,"en":"The people of Beijing offered their throne,"},{"id":"semetey-1-2013:p0621:b003:l013","ordinal":124454,"en":"And seated your father upon it."},{"id":"semetey-1-2013:p0621:b003:l014","ordinal":124455,"en":"Otherwise the Chinese swarmed like grass."},{"id":"semetey-1-2013:p0621:b003:l015","ordinal":124456,"en":"The forty giants headed by Ezkara—"},{"id":"semetey-1-2013:p0621:b003:l016","ordinal":124457,"en":"Chubak alone bound them, they said."},{"id":"semetey-1-2013:p0621:b003:l017","ordinal":124458,"en":"“For my sake the Chinese submitted"},{"id":"semetey-1-2013:p0621:b003:l018","ordinal":124459,"en":"In that campaign of turmoil.”"},{"id":"semetey-1-2013:p0621:b003:l019","ordinal":124460,"en":"Your valiant father returned."},{"id":"semetey-1-2013:p0621:b003:l020","ordinal":124461,"en":"In the slaughter of the Great Campaign"},{"id":"semetey-1-2013:p0621:b003:l021","ordinal":124462,"en":"He lost his Chubak."},{"id":"semetey-1-2013:p0621:b003:l022","ordinal":124463,"en":"To your lion father's side,"},{"id":"semetey-1-2013:p0621:b003:l023","ordinal":124464,"en":"His companion for the next world,"},{"id":"semetey-1-2013:p0621:b003:l024","ordinal":124465,"en":"That man Chubak must have come."},{"id":"semetey-1-2013:p0621:b003:l025","ordinal":124466,"en":"Suffering and torment"},{"id":"semetey-1-2013:p0621:b003:l026","ordinal":124467,"en":"They had endured together."},{"id":"semetey-1-2013:p0621:b003:l027","ordinal":124468,"en":"Embracing your father,"},{"id":"semetey-1-2013:p0621:b003:l028","ordinal":124469,"en":"Chubak, the lion-like warrior,"},{"id":"semetey-1-2013:p0621:b003:l029","ordinal":124470,"en":"Must be lying with him."},{"id":"semetey-1-2013:p0621:b003:l030","ordinal":124471,"en":"Like mist in the heavens,"},{"id":"semetey-1-2013:p0621:b003:l031","ordinal":124472,"en":"They must have streamed together."},{"id":"semetey-1-2013:p0621:b003:l032","ordinal":124473,"en":"Companions for the next world,"},{"id":"semetey-1-2013:p0621:b003:l033","ordinal":124474,"en":"They must have joined together."},{"id":"semetey-1-2013:p0621:b003:l034","ordinal":124475,"en":"The man lying at his feet—"},{"id":"semetey-1-2013:p0621:b003:l035","ordinal":124476,"en":"His strength matched the world."},{"id":"semetey-1-2013:p0621:b003:l036","ordinal":124477,"en":"Your father and that fierce-maned warrior"},{"id":"semetey-1-2013:p0621:b003:l037","ordinal":124478,"en":"Were sons of two brothers."},{"id":"semetey-1-2013:p0621:b003:l038","ordinal":124479,"en":"Light on a horse, fit even for a colt,"},{"id":"semetey-1-2013:p0621:b003:l039","ordinal":124480,"en":"Sleepless, watchful on the road,"},{"id":"semetey-1-2013:p0621:b004:l001","ordinal":124481,"en":"He never rested upon his elbow,"},{"id":"semetey-1-2013:p0621:b004:l002","ordinal":124482,"en":"Never took even a moment's nap,"},{"id":"semetey-1-2013:p0621:b004:l003","ordinal":124483,"en":"Peerless among sixty,"},{"id":"semetey-1-2013:p0621:b004:l004","ordinal":124484,"en":"The mightiest of the forty companions."},{"id":"semetey-1-2013:p0621:b004:l005","ordinal":124485,"en":"All their giants,"},{"id":"semetey-1-2013:p0621:b004:l006","ordinal":124486,"en":"When Syrgak shattered and slew them,"},{"id":"semetey-1-2013:p0621:b004:l007","ordinal":124487,"en":"The supreme marksman of the Chinese,"},{"id":"semetey-1-2013:p0621:b004:l008","ordinal":124488,"en":"A skilled horseman and swift runner,"},{"id":"semetey-1-2013:p0621:b004:l009","ordinal":124489,"en":"The great royal marksman himself,"},{"id":"semetey-1-2013:p0621:b004:l010","ordinal":124490,"en":"Having his dutar played,"},{"id":"semetey-1-2013:p0621:b004:l011","ordinal":124491,"en":"From the gate of Outer Beijing,"},{"id":"semetey-1-2013:p0621:b004:l012","ordinal":124492,"en":"Kojozhash was made to shoot him."},{"id":"semetey-1-2013:p0621:b004:l013","ordinal":124493,"en":"Felled in the prime of his days,"},{"id":"semetey-1-2013:p0621:b004:l014","ordinal":124494,"en":"Struck down while young,"},{"id":"semetey-1-2013:p0621:b004:l015","ordinal":124495,"en":"He died a martyr on campaign."},{"id":"semetey-1-2013:p0621:b004:l016","ordinal":124496,"en":"At the shrine called Shyiykoo"},{"id":"semetey-1-2013:p0621:b004:l017","ordinal":124497,"en":"They laid Syrgak to rest."},{"id":"semetey-1-2013:p0621:b004:l018","ordinal":124498,"en":"From that day to this,"},{"id":"semetey-1-2013:p0621:b004:l019","ordinal":124499,"en":"Through this, Shyiykoo"},{"id":"semetey-1-2013:p0621:b004:l020","ordinal":124500,"en":"Became a great shrine."},{"id":"semetey-1-2013:p0621:b004:l021","ordinal":124501,"en":"The one lying at his feet,"},{"id":"semetey-1-2013:p0621:b004:l022","ordinal":124502,"en":"The noble lion, the mighty conqueror,"},{"id":"semetey-1-2013:p0621:b004:l023","ordinal":124503,"en":"Syrgak must have come."},{"id":"semetey-1-2013:p0621:b004:l024","ordinal":124504,"en":"Who threw the whole world into confusion,"},{"id":"semetey-1-2013:p0621:b004:l025","ordinal":124505,"en":"That dear one must have come."},{"id":"semetey-1-2013:p0621:b004:l026","ordinal":124506,"en":"Beside his uncle, magnanimous Manas,"},{"id":"semetey-1-2013:p0621:b004:l027","ordinal":124507,"en":"He must be lying too."},{"id":"semetey-1-2013:p0621:b004:l028","ordinal":124508,"en":"The beautiful girl in his embrace—"},{"id":"semetey-1-2013:p0621:b004:l029","ordinal":124509,"en":"Let me tell you about her."},{"id":"semetey-1-2013:p0621:b004:l030","ordinal":124510,"en":"Toward Old Turpan,"},{"id":"semetey-1-2013:p0621:b004:l031","ordinal":124511,"en":"On this side of Barbar,"},{"id":"semetey-1-2013:p0621:b004:l032","ordinal":124512,"en":"In the Mediyan desert itself,"},{"id":"semetey-1-2013:p0621:b004:l033","ordinal":124513,"en":"Along the bank of the Lop River,"},{"id":"semetey-1-2013:p0621:b004:l034","ordinal":124514,"en":"Of a Kyrgyz lineage too,"},{"id":"semetey-1-2013:p0621:b004:l035","ordinal":124515,"en":"Also a son of saintly wisdom,"},{"id":"semetey-1-2013:p0621:b004:l036","ordinal":124516,"en":"Among the Oigut people"},{"id":"semetey-1-2013:p0621:b004:l037","ordinal":124517,"en":"A khan named Karacha arose."},{"id":"semetey-1-2013:p0621:b004:l038","ordinal":124518,"en":"Karacha's Khan Saikal—"},{"id":"semetey-1-2013:p0621:b004:l039","ordinal":124519,"en":"Lives were lost through her wrath."},{"id":"semetey-1-2013:p0622:b003:l001","ordinal":124520,"en":"Her watchmen listened across the land."},{"id":"semetey-1-2013:p0622:b003:l002","ordinal":124521,"en":"No one went there willingly."},{"id":"semetey-1-2013:p0622:b003:l003","ordinal":124522,"en":"Those who ventured there did not live."},{"id":"semetey-1-2013:p0622:b003:l004","ordinal":124523,"en":"No one dared approach."},{"id":"semetey-1-2013:p0622:b003:l005","ordinal":124524,"en":"Those who encountered her did not survive."},{"id":"semetey-1-2013:p0622:b003:l006","ordinal":124525,"en":"In his playful childhood,"},{"id":"semetey-1-2013:p0622:b003:l007","ordinal":124526,"en":"Alooke's Konurbai"},{"id":"semetey-1-2013:p0622:b003:l008","ordinal":124527,"en":"Had encountered Saikal."},{"id":"semetey-1-2013:p0622:b003:l009","ordinal":124528,"en":"Barely escaping death,"},{"id":"semetey-1-2013:p0622:b003:l010","ordinal":124529,"en":"For many days and many nights"},{"id":"semetey-1-2013:p0622:b003:l011","ordinal":124530,"en":"She fought Konurbai with spears."},{"id":"semetey-1-2013:p0622:b003:l012","ordinal":124531,"en":"The Oigut people mounted their horses,"},{"id":"semetey-1-2013:p0622:b003:l013","ordinal":124532,"en":"And crushed and slaughtered the Chinese."},{"id":"semetey-1-2013:p0622:b003:l014","ordinal":124533,"en":"Though a girl, her good deeds,"},{"id":"semetey-1-2013:p0622:b003:l015","ordinal":124534,"en":"Her light reached all the peoples."},{"id":"semetey-1-2013:p0622:b003:l016","ordinal":124535,"en":"Was called Talas."},{"id":"semetey-1-2013:p0622:b003:l017","ordinal":124536,"en":"Its steeds were born from kulans."},{"id":"semetey-1-2013:p0622:b003:l018","ordinal":124537,"en":"Khan Manas's Akkula,"},{"id":"semetey-1-2013:p0622:b003:l019","ordinal":124538,"en":"The foal of a young mare,"},{"id":"semetey-1-2013:p0622:b003:l020","ordinal":124539,"en":"The Duldul among ordinary horses,"},{"id":"semetey-1-2013:p0622:b003:l021","ordinal":124540,"en":"Was a foal from there too."},{"id":"semetey-1-2013:p0622:b003:l022","ordinal":124541,"en":"Konurbai's black horse—"},{"id":"semetey-1-2013:p0622:b003:l023","ordinal":124542,"en":"That black horse had"},{"id":"semetey-1-2013:p0622:b003:l024","ordinal":124543,"en":"Wings upon its flanks."},{"id":"semetey-1-2013:p0622:b003:l025","ordinal":124544,"en":"If they gave poods of gold and jewels,"},{"id":"semetey-1-2013:p0622:b003:l026","ordinal":124545,"en":"Her father Karacha"},{"id":"semetey-1-2013:p0622:b003:l027","ordinal":124546,"en":"Without choosing among his steeds"},{"id":"semetey-1-2013:p0622:b003:l028","ordinal":124547,"en":"Had the custom of selling them."},{"id":"semetey-1-2013:p0622:b003:l029","ordinal":124548,"en":"Konurbai's Algara"},{"id":"semetey-1-2013:p0622:b003:l030","ordinal":124549,"en":"Was a foal from there too."},{"id":"semetey-1-2013:p0622:b003:l031","ordinal":124550,"en":"Warrior Toshtuk's Chalkuiruk"},{"id":"semetey-1-2013:p0622:b003:l032","ordinal":124551,"en":"Was a foal from there too."},{"id":"semetey-1-2013:p0622:b003:l033","ordinal":124552,"en":"Warrior Koshoi's Kuu Kazyk"},{"id":"semetey-1-2013:p0622:b003:l034","ordinal":124553,"en":"Was a foal from there too."},{"id":"semetey-1-2013:p0622:b003:l035","ordinal":124554,"en":"Warrior Syrgak's Kokchebich"},{"id":"semetey-1-2013:p0622:b003:l036","ordinal":124555,"en":"Was a foal from there too."},{"id":"semetey-1-2013:p0622:b003:l037","ordinal":124556,"en":"Kokotoy's Maaniker"},{"id":"semetey-1-2013:p0622:b003:l038","ordinal":124557,"en":"Was a foal from there too."},{"id":"semetey-1-2013:p0622:b003:l039","ordinal":124558,"en":"Azhibai's Kartkurong"},{"id":"semetey-1-2013:p0622:b004:l001","ordinal":124559,"en":"Was a foal from there as well."},{"id":"semetey-1-2013:p0622:b004:l002","ordinal":124560,"en":"The two girls rode him and fell to bullets—"},{"id":"semetey-1-2013:p0622:b004:l003","ordinal":124561,"en":"Telkyzyl, ridden on scouting missions,"},{"id":"semetey-1-2013:p0622:b004:l004","ordinal":124562,"en":"Was a foal from there as well."},{"id":"semetey-1-2013:p0622:b004:l005","ordinal":124563,"en":"Long ago, turning his neck like a stag,"},{"id":"semetey-1-2013:p0622:b004:l006","ordinal":124564,"en":"If a ditch a bowshot wide appeared,"},{"id":"semetey-1-2013:p0622:b004:l007","ordinal":124565,"en":"He raced on without hesitation."},{"id":"semetey-1-2013:p0622:b004:l008","ordinal":124566,"en":"Knowing him to be a splendid steed,"},{"id":"semetey-1-2013:p0622:b004:l009","ordinal":124567,"en":"Offering poods of gold and jewels,"},{"id":"semetey-1-2013:p0622:b004:l010","ordinal":124568,"en":"Whoever came asked for him."},{"id":"semetey-1-2013:p0622:b004:l011","ordinal":124569,"en":"He was not given to those who asked."},{"id":"semetey-1-2013:p0622:b004:l012","ordinal":124570,"en":"Far from giving him to them,"},{"id":"semetey-1-2013:p0622:b004:l013","ordinal":124571,"en":"No one without ritual ablution rode him."},{"id":"semetey-1-2013:p0622:b004:l014","ordinal":124572,"en":"A karabair, a noble steed,"},{"id":"semetey-1-2013:p0622:b004:l015","ordinal":124573,"en":"With sieve-like lungs and bronze forelegs,"},{"id":"semetey-1-2013:p0622:b004:l016","ordinal":124574,"en":"Chosen and set apart for you,"},{"id":"semetey-1-2013:p0622:b004:l017","ordinal":124575,"en":"Your very own Taibuurul"},{"id":"semetey-1-2013:p0622:b004:l018","ordinal":124576,"en":"Was a foal from there too."},{"id":"semetey-1-2013:p0622:b004:l019","ordinal":124577,"en":"Long ago, your father Khan Manas,"},{"id":"semetey-1-2013:p0622:b004:l020","ordinal":124578,"en":"Wearing out horses and scouting the land,"},{"id":"semetey-1-2013:p0622:b004:l021","ordinal":124579,"en":"Loosing hounds and flying hawks,"},{"id":"semetey-1-2013:p0622:b004:l022","ordinal":124580,"en":"Finding no mountain to collide with,"},{"id":"semetey-1-2013:p0622:b004:l023","ordinal":124581,"en":"No enemy to fight,"},{"id":"semetey-1-2013:p0622:b004:l024","ordinal":124582,"en":"With Almambet and Syrgak both there,"},{"id":"semetey-1-2013:p0622:b004:l025","ordinal":124583,"en":"With Azhibai and Bakai there too—"},{"id":"semetey-1-2013:p0622:b004:l026","ordinal":124584,"en":"Let me tell you, my child,"},{"id":"semetey-1-2013:p0622:b004:l027","ordinal":124585,"en":"All the champions were there."},{"id":"semetey-1-2013:p0622:b004:l028","ordinal":124586,"en":"To scout the Oigut people,"},{"id":"semetey-1-2013:p0622:b004:l029","ordinal":124587,"en":"To take Karacha's Saikal"},{"id":"semetey-1-2013:p0622:b004:l030","ordinal":124588,"en":"As his bride,"},{"id":"semetey-1-2013:p0622:b004:l031","ordinal":124589,"en":"Manas persistently led them under guard,"},{"id":"semetey-1-2013:p0622:b004:l032","ordinal":124590,"en":"When he caused great distress,"},{"id":"semetey-1-2013:p0622:b004:l033","ordinal":124591,"en":"To Karacha's Saikal,"},{"id":"semetey-1-2013:p0622:b004:l034","ordinal":124592,"en":"With sixty strongmen, warrior Manas"},{"id":"semetey-1-2013:p0622:b004:l035","ordinal":124593,"en":"Went, saying, ‘I shall take her.’"},{"id":"semetey-1-2013:p0622:b004:l036","ordinal":124594,"en":"At Yrgaity Pass,"},{"id":"semetey-1-2013:p0622:b004:l037","ordinal":124595,"en":"In the It-Zhurbos desert,"},{"id":"semetey-1-2013:p0622:b004:l038","ordinal":124596,"en":"On this side of the Lop River's forest,"},{"id":"semetey-1-2013:p0622:b004:l039","ordinal":124597,"en":"Along its ridge edge,"},{"id":"semetey-1-2013:p0623:b003:l001","ordinal":124598,"en":"On the spur of the towering mountain,"},{"id":"semetey-1-2013:p0623:b003:l002","ordinal":124599,"en":"Then I saw Maiden Saikal."},{"id":"semetey-1-2013:p0623:b003:l003","ordinal":124600,"en":"Her precious long, thick hair"},{"id":"semetey-1-2013:p0623:b003:l004","ordinal":124601,"en":"She had bound tightly atop her head."},{"id":"semetey-1-2013:p0623:b003:l005","ordinal":124602,"en":"She wore a giant warrior's clothing."},{"id":"semetey-1-2013:p0623:b003:l006","ordinal":124603,"en":"She too had ridden out on patrol."},{"id":"semetey-1-2013:p0623:b003:l007","ordinal":124604,"en":"I, Bakai, was the one who saw her."},{"id":"semetey-1-2013:p0623:b003:l008","ordinal":124605,"en":"Then Saikal said:"},{"id":"semetey-1-2013:p0623:b003:l009","ordinal":124606,"en":"‘Elders, where have you come from,"},{"id":"semetey-1-2013:p0623:b003:l010","ordinal":124607,"en":"Wearing out horses, scouting the land,"},{"id":"semetey-1-2013:p0623:b003:l011","ordinal":124608,"en":"All of you looking grim,"},{"id":"semetey-1-2013:p0623:b003:l012","ordinal":124609,"en":"Mounted on well-trained steeds,"},{"id":"semetey-1-2013:p0623:b003:l013","ordinal":124610,"en":"Tiring your horses, riding hard,"},{"id":"semetey-1-2013:p0623:b003:l014","ordinal":124611,"en":"With your hearts turned to some other purpose,"},{"id":"semetey-1-2013:p0623:b003:l015","ordinal":124612,"en":"Your conduct seeming hostile?"},{"id":"semetey-1-2013:p0623:b003:l016","ordinal":124613,"en":"You have entered my land,"},{"id":"semetey-1-2013:p0623:b003:l017","ordinal":124614,"en":"Come to take the measure of my people."},{"id":"semetey-1-2013:p0623:b003:l018","ordinal":124615,"en":"You dwell in Talas."},{"id":"semetey-1-2013:p0623:b003:l019","ordinal":124616,"en":"You have urged him on and brought him,"},{"id":"semetey-1-2013:p0623:b003:l020","ordinal":124617,"en":"Zhakyp's only son, Manas."},{"id":"semetey-1-2013:p0623:b003:l021","ordinal":124618,"en":"You are Kyrgyz, and I am Kyrgyz."},{"id":"semetey-1-2013:p0623:b003:l022","ordinal":124619,"en":"Your fine coats no bullet can pierce,"},{"id":"semetey-1-2013:p0623:b003:l023","ordinal":124620,"en":"You have come out wearing them."},{"id":"semetey-1-2013:p0623:b003:l024","ordinal":124621,"en":"There are no Chinese here on the right."},{"id":"semetey-1-2013:p0623:b003:l025","ordinal":124622,"en":"You have come out to pick a quarrel."},{"id":"semetey-1-2013:p0623:b003:l026","ordinal":124623,"en":"Is there a grievance troubling you?"},{"id":"semetey-1-2013:p0623:b003:l027","ordinal":124624,"en":"Bakai, blessed by Kydyr, tell the truth."},{"id":"semetey-1-2013:p0623:b003:l028","ordinal":124625,"en":"Has an enemy come from the Chinese?’"},{"id":"semetey-1-2013:p0623:b003:l029","ordinal":124626,"en":"So said Maiden Saikal,"},{"id":"semetey-1-2013:p0623:b003:l030","ordinal":124627,"en":"As she stood gathering her strength."},{"id":"semetey-1-2013:p0623:b003:l031","ordinal":124628,"en":"Khan Manas's forty companions,"},{"id":"semetey-1-2013:p0623:b003:l032","ordinal":124629,"en":"Told to drink water, drank poison;"},{"id":"semetey-1-2013:p0623:b003:l033","ordinal":124630,"en":"Told to spill blood, spilled entrails;"},{"id":"semetey-1-2013:p0623:b003:l034","ordinal":124631,"en":"Told to take a cap, cut off a head."},{"id":"semetey-1-2013:p0623:b003:l035","ordinal":124632,"en":"All those reckless warriors"},{"id":"semetey-1-2013:p0623:b003:l036","ordinal":124633,"en":"Struck their steeds once,"},{"id":"semetey-1-2013:p0623:b003:l037","ordinal":124634,"en":"Raised Manas as their battle cry,"},{"id":"semetey-1-2013:p0623:b003:l038","ordinal":124635,"en":"And attacked Maiden Saikal."},{"id":"semetey-1-2013:p0623:b003:l039","ordinal":124636,"en":"When all forty charged up,"},{"id":"semetey-1-2013:p0623:b004:l001","ordinal":124637,"en":"When each of the forty thrust his spear,"},{"id":"semetey-1-2013:p0623:b004:l002","ordinal":124638,"en":"Maiden Saikal did not turn her head,"},{"id":"semetey-1-2013:p0623:b004:l003","ordinal":124639,"en":"Did not stir, paying them no heed."},{"id":"semetey-1-2013:p0623:b004:l004","ordinal":124640,"en":"Though she bore the flaw of being female,"},{"id":"semetey-1-2013:p0623:b004:l005","ordinal":124641,"en":"The forty companions' spears"},{"id":"semetey-1-2013:p0623:b004:l006","ordinal":124642,"en":"She held worth no more than a scrap of hide."},{"id":"semetey-1-2013:p0623:b004:l007","ordinal":124643,"en":"My Lord, the Almighty,"},{"id":"semetey-1-2013:p0623:b004:l008","ordinal":124644,"en":"To Karacha's Saikal"},{"id":"semetey-1-2013:p0623:b004:l009","ordinal":124645,"en":"Had given courage without measure."},{"id":"semetey-1-2013:p0623:b004:l010","ordinal":124646,"en":"Then Saikal said:"},{"id":"semetey-1-2013:p0623:b004:l011","ordinal":124647,"en":"‘Khan Manas's forty madmen!"},{"id":"semetey-1-2013:p0623:b004:l012","ordinal":124648,"en":"You have freely crossed the land and made your way."},{"id":"semetey-1-2013:p0623:b004:l013","ordinal":124649,"en":"I am not your enemy to torment."},{"id":"semetey-1-2013:p0623:b004:l014","ordinal":124650,"en":"All forty of you attacked at once."},{"id":"semetey-1-2013:p0623:b004:l015","ordinal":124651,"en":"Is it amusement you seek,"},{"id":"semetey-1-2013:p0623:b004:l016","ordinal":124652,"en":"Or mischief you are looking for?’"},{"id":"semetey-1-2013:p0623:b004:l017","ordinal":124653,"en":"So saying, Maiden Saikal"},{"id":"semetey-1-2013:p0623:b004:l018","ordinal":124654,"en":"Charged and attacked us."},{"id":"semetey-1-2013:p0623:b004:l019","ordinal":124655,"en":"We barely escaped death."},{"id":"semetey-1-2013:p0623:b004:l020","ordinal":124656,"en":"In the It-Baspas desert,"},{"id":"semetey-1-2013:p0623:b004:l021","ordinal":124657,"en":"We were sixty, she alone."},{"id":"semetey-1-2013:p0623:b004:l022","ordinal":124658,"en":"Each of us was worth a thousand troops,"},{"id":"semetey-1-2013:p0623:b004:l023","ordinal":124659,"en":"Yet we fought Maiden Saikal with spears."},{"id":"semetey-1-2013:p0623:b004:l024","ordinal":124660,"en":"Let me tell the rest."},{"id":"semetey-1-2013:p0623:b004:l025","ordinal":124661,"en":"Struck from the vulnerable flank,"},{"id":"semetey-1-2013:p0623:b004:l026","ordinal":124662,"en":"The forty companions who boasted of their might"},{"id":"semetey-1-2013:p0623:b004:l027","ordinal":124663,"en":"Were overcome by Maiden Saikal."},{"id":"semetey-1-2013:p0623:b004:l028","ordinal":124664,"en":"Karacha's Saikal"},{"id":"semetey-1-2013:p0623:b004:l029","ordinal":124665,"en":"Wrought great turmoil."},{"id":"semetey-1-2013:p0623:b004:l030","ordinal":124666,"en":"I, your uncle, bloodthirsty Bakai,"},{"id":"semetey-1-2013:p0623:b004:l031","ordinal":124667,"en":"Survived by cunning,"},{"id":"semetey-1-2013:p0623:b004:l032","ordinal":124668,"en":"And barely preserved my life."},{"id":"semetey-1-2013:p0623:b004:l033","ordinal":124669,"en":"When Khan Manas's forty companions"},{"id":"semetey-1-2013:p0623:b004:l034","ordinal":124670,"en":"Fought with spears on the open plain,"},{"id":"semetey-1-2013:p0623:b004:l035","ordinal":124671,"en":"Each was left without a horse,"},{"id":"semetey-1-2013:p0623:b004:l036","ordinal":124672,"en":"Stranded on foot and helpless."}]
