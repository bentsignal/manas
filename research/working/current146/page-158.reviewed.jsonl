{"id": "sayakbay-ms-current146:pdf158:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 158, "folio": 541, "line_in_page": 10, "raw": "Түрүндөн мурун жан кетип,", "text": "Түрүндөн мурун жан кетип,", "en": "Life left him before his face had changed,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf158:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 158, "folio": 541, "line_in_page": 11, "raw": "Ажал ок тийди чекеге,", "text": "Ажал ок тийди чекеге,", "en": "Death’s bullet struck his temple,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf158:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 158, "folio": 541, "line_in_page": 12, "raw": "Кайран Көбөй абабыз,", "text": "Кайран Көбөй абабыз,", "en": "Our dear elder Köböy,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
