[{"id":"semetey-1-2013:p1283:b003:l036","ordinal":175105,"en":"Kadyrbay, son of Kalcha,"},{"id":"semetey-1-2013:p1283:b003:l037","ordinal":175106,"en":"Bearing seven sacred standards,"},{"id":"semetey-1-2013:p1283:b003:l038","ordinal":175107,"en":"Raising an earth-splitting clamor,"},{"id":"semetey-1-2013:p1283:b003:l039","ordinal":175108,"en":"With dust curling into the sky,"},{"id":"semetey-1-2013:p1283:b005:l001","ordinal":175109,"en":"Poured in from the flank"},{"id":"semetey-1-2013:p1283:b005:l002","ordinal":175110,"en":"And began battle anew."},{"id":"semetey-1-2013:p1283:b005:l003","ordinal":175111,"en":"Tümönbay, son of Tülkü,"},{"id":"semetey-1-2013:p1283:b005:l004","ordinal":175112,"en":"And Ajybay, son of Ajy,"},{"id":"semetey-1-2013:p1283:b005:l005","ordinal":175113,"en":"Had gathered an exceptional army;"},{"id":"semetey-1-2013:p1283:b005:l006","ordinal":175114,"en":"They too had an answer"},{"id":"semetey-1-2013:p1283:b005:l007","ordinal":175115,"en":"To give the Jediger."},{"id":"semetey-1-2013:p1283:b005:l008","ordinal":175116,"en":"Many heroes stood side by side;"},{"id":"semetey-1-2013:p1283:b005:l009","ordinal":175117,"en":"Ajybay, son of Ajy,"},{"id":"semetey-1-2013:p1283:b005:l010","ordinal":175118,"en":"And broad-throated Kadyrbay"},{"id":"semetey-1-2013:p1283:b005:l011","ordinal":175119,"en":"Now made a spectacle."},{"id":"semetey-1-2013:p1283:b005:l012","ordinal":175120,"en":"Girding on his Oroipo cartridge pouch,"},{"id":"semetey-1-2013:p1283:b005:l013","ordinal":175121,"en":"Ajybay, son of Ajy,"},{"id":"semetey-1-2013:p1283:b005:l014","ordinal":175122,"en":"Charged in without sparing himself."},{"id":"semetey-1-2013:p1283:b005:l015","ordinal":175123,"en":"They stood face to face,"},{"id":"semetey-1-2013:p1283:b005:l016","ordinal":175124,"en":"Leveling their spears in silence;"},{"id":"semetey-1-2013:p1283:b005:l017","ordinal":175125,"en":"No bungler was allowed to flee,"},{"id":"semetey-1-2013:p1283:b005:l018","ordinal":175126,"en":"And heroes emerged after thrusting foes."},{"id":"semetey-1-2013:p1283:b005:l019","ordinal":175127,"en":"It became a clumsy, brutal battle;"},{"id":"semetey-1-2013:p1283:b005:l020","ordinal":175128,"en":"Black muskets cracked,"},{"id":"semetey-1-2013:p1283:b005:l021","ordinal":175129,"en":"Fierce guns boomed."},{"id":"semetey-1-2013:p1283:b005:l022","ordinal":175130,"en":"Slaughter spread starkly;"},{"id":"semetey-1-2013:p1283:b005:l023","ordinal":175131,"en":"Many precious heroes"},{"id":"semetey-1-2013:p1283:b005:l024","ordinal":175132,"en":"Lay dead and outstretched."},{"id":"semetey-1-2013:p1283:b005:l025","ordinal":175133,"en":"The earth became hazy with vapor;"},{"id":"semetey-1-2013:p1283:b005:l026","ordinal":175134,"en":"The armies seethed in uproar."},{"id":"semetey-1-2013:p1283:b005:l027","ordinal":175135,"en":"For those who knew and saw it,"},{"id":"semetey-1-2013:p1283:b005:l028","ordinal":175136,"en":"The tumult never healed."},{"id":"semetey-1-2013:p1283:b005:l029","ordinal":175137,"en":"Many brave men died;"},{"id":"semetey-1-2013:p1283:b005:l030","ordinal":175138,"en":"Those who remained alive"},{"id":"semetey-1-2013:p1283:b005:l031","ordinal":175139,"en":"Were drenched in black blood."},{"id":"semetey-1-2013:p1283:b005:l032","ordinal":175140,"en":"The host glittered and heaved,"},{"id":"semetey-1-2013:p1283:b005:l033","ordinal":175141,"en":"Having entered the clamor."},{"id":"semetey-1-2013:p1283:b005:l034","ordinal":175142,"en":"Many who had not hastened before"},{"id":"semetey-1-2013:p1283:b005:l035","ordinal":175143,"en":"Now entered the tumult."},{"id":"semetey-1-2013:p1283:b005:l036","ordinal":175144,"en":"The brave roared,"},{"id":"semetey-1-2013:p1283:b005:l037","ordinal":175145,"en":"While cowards trembled at the edge."},{"id":"semetey-1-2013:p1283:b005:l038","ordinal":175146,"en":"The grief-stricken cowards"},{"id":"semetey-1-2013:p1283:b005:l039","ordinal":175147,"en":"Fled away one by one."},{"id":"semetey-1-2013:p1284:b003:l001","ordinal":175148,"en":"Every throat was filled with dust;"},{"id":"semetey-1-2013:p1284:b003:l002","ordinal":175149,"en":"Human heads were covered in blood."},{"id":"semetey-1-2013:p1284:b003:l003","ordinal":175150,"en":"The soil spread as drifting dust;"},{"id":"semetey-1-2013:p1284:b003:l004","ordinal":175151,"en":"The sky was clear, but the earth overcast."},{"id":"semetey-1-2013:p1284:b003:l005","ordinal":175152,"en":"Not a blade on earth could be seen."},{"id":"semetey-1-2013:p1284:b003:l006","ordinal":175153,"en":"How many souls lay dying;"},{"id":"semetey-1-2013:p1284:b003:l007","ordinal":175154,"en":"Not a single person could be distinguished."},{"id":"semetey-1-2013:p1284:b003:l008","ordinal":175155,"en":"The people seethed and gathered;"},{"id":"semetey-1-2013:p1284:b003:l009","ordinal":175156,"en":"Those whose doom had come were slaughtered."},{"id":"semetey-1-2013:p1284:b003:l010","ordinal":175157,"en":"Let us leave that there"},{"id":"semetey-1-2013:p1284:b003:l011","ordinal":175158,"en":"And begin the tale"},{"id":"semetey-1-2013:p1284:b003:l012","ordinal":175159,"en":"Of hero Semey, son of Manas,"},{"id":"semetey-1-2013:p1284:b003:l013","ordinal":175160,"en":"The man of surpassing courage:"},{"id":"semetey-1-2013:p1284:b003:l014","ordinal":175161,"en":"Striking Buurul once with his heel,"},{"id":"semetey-1-2013:p1284:b003:l015","ordinal":175162,"en":"Scowling in wrath,"},{"id":"semetey-1-2013:p1284:b003:l016","ordinal":175163,"en":"Against the khoja's host, a whole division,"},{"id":"semetey-1-2013:p1284:b003:l017","ordinal":175164,"en":"Semetey charged."},{"id":"semetey-1-2013:p1284:b003:l018","ordinal":175165,"en":"Born surpassing"},{"id":"semetey-1-2013:p1284:b003:l019","ordinal":175166,"en":"His father, gray wolf Manas."},{"id":"semetey-1-2013:p1284:b003:l020","ordinal":175167,"en":"Which of his deeds can one tell?"},{"id":"semetey-1-2013:p1284:b003:l021","ordinal":175168,"en":"The seven banners that came from Mecca—"},{"id":"semetey-1-2013:p1284:b003:l022","ordinal":175169,"en":"He stationed them in seven places;"},{"id":"semetey-1-2013:p1284:b003:l023","ordinal":175170,"en":"It was the time your accomplished one charged,"},{"id":"semetey-1-2013:p1284:b003:l024","ordinal":175171,"en":"Slaughtering wherever he reached."},{"id":"semetey-1-2013:p1284:b003:l025","ordinal":175172,"en":"The six banners that came from Mecca—"},{"id":"semetey-1-2013:p1284:b003:l026","ordinal":175173,"en":"He stationed them in six places;"},{"id":"semetey-1-2013:p1284:b003:l027","ordinal":175174,"en":"The lion entered like the moon,"},{"id":"semetey-1-2013:p1284:b003:l028","ordinal":175175,"en":"Slaughtering at the first word."},{"id":"semetey-1-2013:p1284:b003:l029","ordinal":175176,"en":"The brave were cut down;"},{"id":"semetey-1-2013:p1284:b003:l030","ordinal":175177,"en":"Cowards stretched out in flight."},{"id":"semetey-1-2013:p1284:b003:l031","ordinal":175178,"en":"Born surpassing"},{"id":"semetey-1-2013:p1284:b003:l032","ordinal":175179,"en":"His father, gray wolf Manas,"},{"id":"semetey-1-2013:p1284:b003:l033","ordinal":175180,"en":"Your wretched hero pursued them roaring;"},{"id":"semetey-1-2013:p1284:b003:l034","ordinal":175181,"en":"The great black Jediger"},{"id":"semetey-1-2013:p1284:b003:l035","ordinal":175182,"en":"Fled in a thundering mass."},{"id":"semetey-1-2013:p1284:b003:l036","ordinal":175183,"en":"Wherever his spear reached,"},{"id":"semetey-1-2013:p1284:b003:l037","ordinal":175184,"en":"He slaughtered them with the spear;"},{"id":"semetey-1-2013:p1284:b003:l038","ordinal":175185,"en":"Thus Semetey took them."},{"id":"semetey-1-2013:p1284:b003:l039","ordinal":175186,"en":"Wherever his sword reached,"},{"id":"semetey-1-2013:p1284:b004:l001","ordinal":175187,"en":"He struck once with the sword;"},{"id":"semetey-1-2013:p1284:b004:l002","ordinal":175188,"en":"Thus Semetey left them behind."},{"id":"semetey-1-2013:p1284:b004:l003","ordinal":175189,"en":"Turning their turmoil into dust,"},{"id":"semetey-1-2013:p1284:b004:l004","ordinal":175190,"en":"He pursued without stopping;"},{"id":"semetey-1-2013:p1284:b004:l005","ordinal":175191,"en":"Shattering their stone fortress,"},{"id":"semetey-1-2013:p1284:b004:l006","ordinal":175192,"en":"He drove them away entirely."},{"id":"semetey-1-2013:p1284:b004:l007","ordinal":175193,"en":"He split them into groups of five and ten."},{"id":"semetey-1-2013:p1284:b004:l008","ordinal":175194,"en":"Those doomed to die died;"},{"id":"semetey-1-2013:p1284:b004:l009","ordinal":175195,"en":"Those who remained alive"},{"id":"semetey-1-2013:p1284:b004:l010","ordinal":175196,"en":"Suffered humiliation like dogs."},{"id":"semetey-1-2013:p1284:b004:l011","ordinal":175197,"en":"All the Jediger"},{"id":"semetey-1-2013:p1284:b004:l012","ordinal":175198,"en":"Fled in a frenzy."},{"id":"semetey-1-2013:p1284:b004:l013","ordinal":175199,"en":"As though seeking to enter the earth,"},{"id":"semetey-1-2013:p1284:b004:l014","ordinal":175200,"en":"They fled in wild panic."},{"id":"semetey-1-2013:p1284:b004:l015","ordinal":175201,"en":"Overflowing with grief,"},{"id":"semetey-1-2013:p1284:b004:l016","ordinal":175202,"en":"All the Jediger"},{"id":"semetey-1-2013:p1284:b004:l017","ordinal":175203,"en":"Despaired of their entrusted lives."},{"id":"semetey-1-2013:p1284:b004:l018","ordinal":175204,"en":"The survivors fled distraught,"},{"id":"semetey-1-2013:p1284:b004:l019","ordinal":175205,"en":"Crying, “Hero, we submit!”"},{"id":"semetey-1-2013:p1284:b004:l020","ordinal":175206,"en":"And pleading with Semetey."},{"id":"semetey-1-2013:p1284:b004:l021","ordinal":175207,"en":"Some, bewildered,"},{"id":"semetey-1-2013:p1284:b004:l022","ordinal":175208,"en":"Quickly dismounted"},{"id":"semetey-1-2013:p1284:b004:l023","ordinal":175209,"en":"And cried, “Ah, hero Semetey,"},{"id":"semetey-1-2013:p1284:b004:l024","ordinal":175210,"en":"Was not our khan the fool?"},{"id":"semetey-1-2013:p1284:b004:l025","ordinal":175211,"en":"What guilt lies upon the multitude?"},{"id":"semetey-1-2013:p1284:b004:l026","ordinal":175212,"en":"We were driven after him"},{"id":"semetey-1-2013:p1284:b004:l027","ordinal":175213,"en":"By one fool who fled his village,"},{"id":"semetey-1-2013:p1284:b004:l028","ordinal":175214,"en":"Through the affliction of the foolish khoja."},{"id":"semetey-1-2013:p1284:b004:l029","ordinal":175215,"en":"Lion son of Manas,"},{"id":"semetey-1-2013:p1284:b004:l030","ordinal":175216,"en":"Here is the commanding city;"},{"id":"semetey-1-2013:p1284:b004:l031","ordinal":175217,"en":"If you would take heads, here are ours!"},{"id":"semetey-1-2013:p1284:b004:l032","ordinal":175218,"en":"If you would dig deep, here is the pit;"},{"id":"semetey-1-2013:p1284:b004:l033","ordinal":175219,"en":"If you would boil us, here is the brine!"},{"id":"semetey-1-2013:p1284:b004:l034","ordinal":175220,"en":"Slaughter every one of us;"},{"id":"semetey-1-2013:p1284:b004:l035","ordinal":175221,"en":"Here is the army that came prepared!"},{"id":"semetey-1-2013:p1284:b004:l036","ordinal":175222,"en":"Do not bring misery upon the meek;"},{"id":"semetey-1-2013:p1284:b004:l037","ordinal":175223,"en":"If you would grapple, here is mighty Khoja!"},{"id":"semetey-1-2013:p1284:b004:l038","ordinal":175224,"en":"Add us to the khoja in humiliation;"},{"id":"semetey-1-2013:p1284:b004:l039","ordinal":175225,"en":"Boil us by force in bitter brine—"},{"id":"semetey-1-2013:p1285:b003:l001","ordinal":175226,"en":"If you would slaughter us, here is the army!”"},{"id":"semetey-1-2013:p1285:b003:l002","ordinal":175227,"en":"The people closed in with cries;"},{"id":"semetey-1-2013:p1285:b003:l003","ordinal":175228,"en":"The great black Jediger"},{"id":"semetey-1-2013:p1285:b003:l004","ordinal":175229,"en":"Dismounted and surrendered."},{"id":"semetey-1-2013:p1285:b003:l005","ordinal":175230,"en":"They cast down spears and swords;"},{"id":"semetey-1-2013:p1285:b003:l006","ordinal":175231,"en":"The strongest men of renowned name,"},{"id":"semetey-1-2013:p1285:b003:l007","ordinal":175232,"en":"Keeping out of Semetey's sight,"},{"id":"semetey-1-2013:p1285:b003:l008","ordinal":175233,"en":"Began to flee toward their villages."},{"id":"semetey-1-2013:p1285:b003:l009","ordinal":175234,"en":"Once the common folk stood thus,"},{"id":"semetey-1-2013:p1285:b003:l010","ordinal":175235,"en":"He did not attack the black multitude"},{"id":"semetey-1-2013:p1285:b003:l011","ordinal":175236,"en":"Nor assault"},{"id":"semetey-1-2013:p1285:b003:l012","ordinal":175237,"en":"The people who had surrendered;"},{"id":"semetey-1-2013:p1285:b003:l013","ordinal":175238,"en":"He stood hearing the lament"},{"id":"semetey-1-2013:p1285:b003:l014","ordinal":175239,"en":"Of the many weeping people."},{"id":"semetey-1-2013:p1285:b003:l015","ordinal":175240,"en":"“It was Khoja who caused the ruin.”"},{"id":"semetey-1-2013:p1285:b003:l016","ordinal":175241,"en":"He flicked his coiled whip;"},{"id":"semetey-1-2013:p1285:b003:l017","ordinal":175242,"en":"His wrath rose and he stiffened,"},{"id":"semetey-1-2013:p1285:b003:l018","ordinal":175243,"en":"His eyes blazing like fire,"},{"id":"semetey-1-2013:p1285:b003:l019","ordinal":175244,"en":"Bloodlust seizing him fiercely."},{"id":"semetey-1-2013:p1285:b003:l020","ordinal":175245,"en":"He moved apart in anger;"},{"id":"semetey-1-2013:p1285:b003:l021","ordinal":175246,"en":"The lion prince Semetey"},{"id":"semetey-1-2013:p1285:b003:l022","ordinal":175247,"en":"Appeared in the form of a lion."},{"id":"semetey-1-2013:p1285:b003:l023","ordinal":175248,"en":"His armed garments numbered eighty-four;"},{"id":"semetey-1-2013:p1285:b003:l024","ordinal":175249,"en":"Semetey, son of the gray wolf—"},{"id":"semetey-1-2013:p1285:b003:l025","ordinal":175250,"en":"Wherever he struck, red fire flared."},{"id":"semetey-1-2013:p1285:b003:l026","ordinal":175251,"en":"From his fathers and forefathers,"},{"id":"semetey-1-2013:p1285:b003:l027","ordinal":175252,"en":"No mortal came against them;"},{"id":"semetey-1-2013:p1285:b003:l028","ordinal":175253,"en":"None who faced them defeated them."},{"id":"semetey-1-2013:p1285:b003:l029","ordinal":175254,"en":"His wrath loomed visibly;"},{"id":"semetey-1-2013:p1285:b003:l030","ordinal":175255,"en":"Those who came saying they would oppose him"},{"id":"semetey-1-2013:p1285:b003:l031","ordinal":175256,"en":"Spilled their darkening blood."},{"id":"semetey-1-2013:p1285:b003:l032","ordinal":175257,"en":"He girded the jekene at his waist;"},{"id":"semetey-1-2013:p1285:b003:l033","ordinal":175258,"en":"His accomplished father Manas,"},{"id":"semetey-1-2013:p1285:b003:l034","ordinal":175259,"en":"Even against seven divisions of black troops,"},{"id":"semetey-1-2013:p1285:b003:l035","ordinal":175260,"en":"Had entered alone among them and attacked."},{"id":"semetey-1-2013:p1285:b003:l036","ordinal":175261,"en":"He did not spare those who fought him,"},{"id":"semetey-1-2013:p1285:b003:l037","ordinal":175262,"en":"Nor drink his fill of blood."},{"id":"semetey-1-2013:p1285:b003:l038","ordinal":175263,"en":"An enemy who came to battle"},{"id":"semetey-1-2013:p1285:b003:l039","ordinal":175264,"en":"He slaughtered without turning back."},{"id":"semetey-1-2013:p1285:b004:l001","ordinal":175265,"en":"From his fathers and forefathers,"},{"id":"semetey-1-2013:p1285:b004:l002","ordinal":175266,"en":"When enemies looked upon them,"},{"id":"semetey-1-2013:p1285:b004:l003","ordinal":175267,"en":"Those born of other fathers"},{"id":"semetey-1-2013:p1285:b004:l004","ordinal":175268,"en":"Could offer no resistance."},{"id":"semetey-1-2013:p1285:b004:l005","ordinal":175269,"en":"His root ancestor was wholly a khan,"},{"id":"semetey-1-2013:p1285:b004:l006","ordinal":175270,"en":"Blessed by Khizir from the root;"},{"id":"semetey-1-2013:p1285:b004:l007","ordinal":175271,"en":"Every forefather was a khan,"},{"id":"semetey-1-2013:p1285:b004:l008","ordinal":175272,"en":"Blessed by Khizir from the beginning."},{"id":"semetey-1-2013:p1285:b004:l009","ordinal":175273,"en":"He burned grassy lands,"},{"id":"semetey-1-2013:p1285:b004:l010","ordinal":175274,"en":"And set reed-filled lands aflame."},{"id":"semetey-1-2013:p1285:b004:l011","ordinal":175275,"en":"He poured blood into black water,"},{"id":"semetey-1-2013:p1285:b004:l012","ordinal":175276,"en":"And greased valleys with streams;"},{"id":"semetey-1-2013:p1285:b004:l013","ordinal":175277,"en":"When provoked in enmity,"},{"id":"semetey-1-2013:p1285:b004:l014","ordinal":175278,"en":"He laid low his own father."},{"id":"semetey-1-2013:p1285:b004:l015","ordinal":175279,"en":"When they crossed him,"},{"id":"semetey-1-2013:p1285:b004:l016","ordinal":175280,"en":"He “honored” the forty companions."},{"id":"semetey-1-2013:p1285:b004:l017","ordinal":175281,"en":"He overturned Abyke"},{"id":"semetey-1-2013:p1285:b004:l018","ordinal":175282,"en":"And sent Köbösh into the grave,"},{"id":"semetey-1-2013:p1285:b004:l019","ordinal":175283,"en":"Making his gray-wolf nature known."},{"id":"semetey-1-2013:p1285:b004:l020","ordinal":175284,"en":"He rejoiced at the word “enemy,”"},{"id":"semetey-1-2013:p1285:b004:l021","ordinal":175285,"en":"And drank blood as though it were water."},{"id":"semetey-1-2013:p1285:b004:l022","ordinal":175286,"en":"He greased his white steel;"},{"id":"semetey-1-2013:p1285:b004:l023","ordinal":175287,"en":"When they angered him,"},{"id":"semetey-1-2013:p1285:b004:l024","ordinal":175288,"en":"He laid low his own elder brother."},{"id":"semetey-1-2013:p1285:b004:l025","ordinal":175289,"en":"The foe who faced him halted;"},{"id":"semetey-1-2013:p1285:b004:l026","ordinal":175290,"en":"Before the hero's son,"},{"id":"semetey-1-2013:p1285:b004:l027","ordinal":175291,"en":"There remained no man to face him."},{"id":"semetey-1-2013:p1285:b004:l028","ordinal":175292,"en":"Among spearmen he became a lion;"},{"id":"semetey-1-2013:p1285:b004:l029","ordinal":175293,"en":"For the prince, son of a lion,"},{"id":"semetey-1-2013:p1285:b004:l030","ordinal":175294,"en":"The black earth became his only opponent."},{"id":"semetey-1-2013:p1285:b004:l031","ordinal":175295,"en":"His fame spread through the world;"},{"id":"semetey-1-2013:p1285:b004:l032","ordinal":175296,"en":"Prince Semetey became a hero."},{"id":"semetey-1-2013:p1285:b004:l033","ordinal":175297,"en":"He greased his keen steel"},{"id":"semetey-1-2013:p1285:b004:l034","ordinal":175298,"en":"And laid low the foe who fought him."},{"id":"semetey-1-2013:p1285:b004:l035","ordinal":175299,"en":"He greased his tempered steel"},{"id":"semetey-1-2013:p1285:b004:l036","ordinal":175300,"en":"And laid low those who pursued him."},{"id":"semetey-1-2013:p1285:b004:l037","ordinal":175301,"en":"The blessing of Khan Koshoy—"},{"id":"semetey-1-2013:p1285:b004:l038","ordinal":175302,"en":"Do you know the tale"},{"id":"semetey-1-2013:p1285:b004:l039","ordinal":175303,"en":"Of Semetey's father?"},{"id":"semetey-1-2013:p1286:b003:l001","ordinal":175304,"en":"Scowling, he girded his waist;"},{"id":"semetey-1-2013:p1286:b003:l002","ordinal":175305,"en":"From Beijing beyond Solomon's reach,"},{"id":"semetey-1-2013:p1286:b003:l003","ordinal":175306,"en":"He exacted judgment and took the throne."},{"id":"semetey-1-2013:p1286:b003:l004","ordinal":175307,"en":"Upon Beijing beyond the reach of Noah's flood,"},{"id":"semetey-1-2013:p1286:b003:l005","ordinal":175308,"en":"He unleashed turmoil and took its blood."},{"id":"semetey-1-2013:p1286:b003:l006","ordinal":175309,"en":"From Beijing beyond Alexander's reach,"},{"id":"semetey-1-2013:p1286:b003:l007","ordinal":175310,"en":"His need arose and he took its craftsmen."},{"id":"semetey-1-2013:p1286:b003:l008","ordinal":175311,"en":"He took beautiful maidens as plunder."},{"id":"semetey-1-2013:p1286:b003:l009","ordinal":175312,"en":"His valor became known among the people;"},{"id":"semetey-1-2013:p1286:b003:l010","ordinal":175313,"en":"He was called bloodthirsty Manas"},{"id":"semetey-1-2013:p1286:b003:l011","ordinal":175314,"en":"And inscribed in the register"},{"id":"semetey-1-2013:p1286:b003:l012","ordinal":175315,"en":"Of Kakan-Chyn's Beijing."},{"id":"semetey-1-2013:p1286:b003:l013","ordinal":175316,"en":"Semetey, left as a gift"},{"id":"semetey-1-2013:p1286:b003:l014","ordinal":175317,"en":"By the valiant gray wolf Manas,"},{"id":"semetey-1-2013:p1286:b003:l015","ordinal":175318,"en":"Rode out facing battle"},{"id":"semetey-1-2013:p1286:b003:l016","ordinal":175319,"en":"And stood amid calamity."},{"id":"semetey-1-2013:p1286:b003:l017","ordinal":175320,"en":"His father had left him as a gift;"},{"id":"semetey-1-2013:p1286:b003:l018","ordinal":175321,"en":"Khan Akun was his father-in-law,"},{"id":"semetey-1-2013:p1286:b003:l019","ordinal":175322,"en":"And Aychürök the wife he would take."},{"id":"semetey-1-2013:p1286:b003:l020","ordinal":175323,"en":"The hero supported by the spirits—"},{"id":"semetey-1-2013:p1286:b003:l021","ordinal":175324,"en":"Saying they would seize his wife,"},{"id":"semetey-1-2013:p1286:b003:l022","ordinal":175325,"en":"The empty-heads whose doom had come,"},{"id":"semetey-1-2013:p1286:b003:l023","ordinal":175326,"en":"Chynkojo and Toltoy, had brought disgrace."},{"id":"semetey-1-2013:p1286:b003:l024","ordinal":175327,"en":"Argyn and Kyrgyz were kin;"},{"id":"semetey-1-2013:p1286:b003:l025","ordinal":175328,"en":"Chynkojo and Semetey"},{"id":"semetey-1-2013:p1286:b003:l026","ordinal":175329,"en":"Were born from equal branches."},{"id":"semetey-1-2013:p1286:b003:l027","ordinal":175330,"en":"He was fire sprung from the core;"},{"id":"semetey-1-2013:p1286:b003:l028","ordinal":175331,"en":"Khoja himself was doomed to die."},{"id":"semetey-1-2013:p1286:b003:l029","ordinal":175332,"en":"Of separate minds but sharing life,"},{"id":"semetey-1-2013:p1286:b003:l030","ordinal":175333,"en":"With the foolish dog Khoja,"},{"id":"semetey-1-2013:p1286:b003:l031","ordinal":175334,"en":"They tended their mingled livestock together."},{"id":"semetey-1-2013:p1286:b003:l032","ordinal":175335,"en":"Their battle cry and encouragement were one;"},{"id":"semetey-1-2013:p1286:b003:l033","ordinal":175336,"en":"Were it not for his foolishness,"},{"id":"semetey-1-2013:p1286:b003:l034","ordinal":175337,"en":"Their wishes and sacrificial rites were one."},{"id":"semetey-1-2013:p1286:b003:l035","ordinal":175338,"en":"They gathered the treasury together,"},{"id":"semetey-1-2013:p1286:b003:l036","ordinal":175339,"en":"Children of one father,"},{"id":"semetey-1-2013:p1286:b003:l037","ordinal":175340,"en":"Seeds of one grain,"},{"id":"semetey-1-2013:p1286:b003:l038","ordinal":175341,"en":"Descendants of one man."},{"id":"semetey-1-2013:p1286:b003:l039","ordinal":175342,"en":"His own kinsman became his enemy;"},{"id":"semetey-1-2013:p1286:b004:l001","ordinal":175343,"en":"Within hero Semetey"},{"id":"semetey-1-2013:p1286:b004:l002","ordinal":175344,"en":"Walked a hostile foe."},{"id":"semetey-1-2013:p1286:b004:l003","ordinal":175345,"en":"The mount beneath him"},{"id":"semetey-1-2013:p1286:b004:l004","ordinal":175346,"en":"Was a charger fit for six months' riding;"},{"id":"semetey-1-2013:p1286:b004:l005","ordinal":175347,"en":"The hero he would fight"},{"id":"semetey-1-2013:p1286:b004:l006","ordinal":175348,"en":"Was his foolish kinsman Khoja,"},{"id":"semetey-1-2013:p1286:b004:l007","ordinal":175349,"en":"Who had escaped from the village."},{"id":"semetey-1-2013:p1286:b004:l008","ordinal":175350,"en":"A mighty tumult beyond a spear's reach—"},{"id":"semetey-1-2013:p1286:b004:l009","ordinal":175351,"en":"That was Chynkojo's doing."},{"id":"semetey-1-2013:p1286:b004:l010","ordinal":175352,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1286:b004:l011","ordinal":175353,"en":"The khoja whose deeds were bold."},{"id":"semetey-1-2013:p1286:b004:l012","ordinal":175354,"en":"Khoja's fortune was complete;"},{"id":"semetey-1-2013:p1286:b004:l013","ordinal":175355,"en":"Were it not for his devilry,"},{"id":"semetey-1-2013:p1286:b004:l014","ordinal":175356,"en":"He was a hero supported by the spirits."},{"id":"semetey-1-2013:p1286:b004:l015","ordinal":175357,"en":"He had a black hat large as a cauldron;"},{"id":"semetey-1-2013:p1286:b004:l016","ordinal":175358,"en":"Dear Khoja was a mighty one."},{"id":"semetey-1-2013:p1286:b004:l017","ordinal":175359,"en":"Across the whole world,"},{"id":"semetey-1-2013:p1286:b004:l018","ordinal":175360,"en":"Whatever he wished, he had power to do."}]
