[{"id":"seytek-1991-continuation:p0345:b006:l042","ordinal":389377,"en":"Before he could use his great skill"},{"id":"seytek-1991-continuation:p0345:b006:l043","ordinal":389378,"en":"And cunning against the fearsome khan—"},{"id":"seytek-1991-continuation:p0345:b006:l044","ordinal":389379,"en":"Do not ask what Chyntengir was like:"},{"id":"seytek-1991-continuation:p0345:b006:l045","ordinal":389380,"en":"He had an armor-clad body,"},{"id":"seytek-1991-continuation:p0345:b006:l046","ordinal":389381,"en":"And endless speech."},{"id":"seytek-1991-continuation:p0345:b006:l047","ordinal":389382,"en":"His stone-hearted people"},{"id":"seytek-1991-continuation:p0345:b006:l048","ordinal":389383,"en":"Had strength where one equaled a thousand."},{"id":"seytek-1991-continuation:p0345:b006:l049","ordinal":389384,"en":"He had giants whose hunger no feast could sate."},{"id":"seytek-1991-continuation:p0346:b001:l001","ordinal":389385,"en":"Even if a mountain came instead of a man,"},{"id":"seytek-1991-continuation:p0346:b001:l002","ordinal":389386,"en":"They had strength enough to crush it."},{"id":"seytek-1991-continuation:p0346:b001:l003","ordinal":389387,"en":"He had a multitude of marksmen as companions;"},{"id":"seytek-1991-continuation:p0346:b001:l004","ordinal":389388,"en":"The finest of those companions"},{"id":"seytek-1991-continuation:p0346:b001:l005","ordinal":389389,"en":"Was Yengkor of the royal treasury,"},{"id":"seytek-1991-continuation:p0346:b001:l006","ordinal":389390,"en":"The ablest of spearmen,"},{"id":"seytek-1991-continuation:p0346:b001:l007","ordinal":389391,"en":"The finest deviser of stratagems."},{"id":"seytek-1991-continuation:p0346:b001:l008","ordinal":389392,"en":"None could match his horsemanship;"},{"id":"seytek-1991-continuation:p0346:b001:l009","ordinal":389393,"en":"If he narrowed his eye and took aim,"},{"id":"seytek-1991-continuation:p0346:b001:l010","ordinal":389394,"en":"No winged creature escaped alive."},{"id":"seytek-1991-continuation:p0346:b001:l011","ordinal":389395,"en":"He was calamity incarnate,"},{"id":"seytek-1991-continuation:p0346:b001:l012","ordinal":389396,"en":"The trusted support"},{"id":"seytek-1991-continuation:p0346:b001:l013","ordinal":389397,"en":"Of murderous Chyntengir."},{"id":"seytek-1991-continuation:p0346:b001:l014","ordinal":389398,"en":"He was now advancing,"},{"id":"seytek-1991-continuation:p0346:b001:l015","ordinal":389399,"en":"Ready to cast his eye"},{"id":"seytek-1991-continuation:p0346:b001:l016","ordinal":389400,"en":"Upon the gray-maned wolf, Er Kenen."},{"id":"seytek-1991-continuation:p0346:b001:l017","ordinal":389401,"en":"Er Kenen's Kertulpar"},{"id":"seytek-1991-continuation:p0346:b001:l018","ordinal":389402,"en":"Trailed a tail like a parrot's."},{"id":"seytek-1991-continuation:p0346:b001:l019","ordinal":389403,"en":"If a ninety-day desert lay ahead,"},{"id":"seytek-1991-continuation:p0346:b001:l020","ordinal":389404,"en":"He galloped without slowing."},{"id":"seytek-1991-continuation:p0346:b001:l021","ordinal":389405,"en":"He was a beast close to a demon,"},{"id":"seytek-1991-continuation:p0346:b001:l022","ordinal":389406,"en":"Endowed with the nature of a tulpar."},{"id":"seytek-1991-continuation:p0346:b001:l023","ordinal":389407,"en":"Yengkor aimed at Kertulpar,"},{"id":"seytek-1991-continuation:p0346:b001:l024","ordinal":389408,"en":"Taking the shoulder blade as his mark,"},{"id":"seytek-1991-continuation:p0346:b001:l025","ordinal":389409,"en":"The edge of the thick neck,"},{"id":"seytek-1991-continuation:p0346:b001:l026","ordinal":389410,"en":"The place where the spine would break,"},{"id":"seytek-1991-continuation:p0346:b001:l027","ordinal":389411,"en":"The very center of his measure,"},{"id":"seytek-1991-continuation:p0346:b001:l028","ordinal":389412,"en":"The dark pupil of death."},{"id":"seytek-1991-continuation:p0346:b001:l029","ordinal":389413,"en":"He measured carefully and fired."},{"id":"seytek-1991-continuation:p0346:b001:l030","ordinal":389414,"en":"Kertulpar beneath Kenen"},{"id":"seytek-1991-continuation:p0346:b001:l031","ordinal":389415,"en":"Reared and crashed down."},{"id":"seytek-1991-continuation:p0346:b001:l032","ordinal":389416,"en":"Stricken with boundless grief,"},{"id":"seytek-1991-continuation:p0346:b001:l033","ordinal":389417,"en":"Parted from Kertulpar,"},{"id":"seytek-1991-continuation:p0346:b001:l034","ordinal":389418,"en":"Surrounded on every side by troops,"},{"id":"seytek-1991-continuation:p0346:b001:l035","ordinal":389419,"en":"With abundant misery boiling,"},{"id":"seytek-1991-continuation:p0346:b001:l036","ordinal":389420,"en":"With neither battle cry nor people,"},{"id":"seytek-1991-continuation:p0346:b001:l037","ordinal":389421,"en":"Er Kenen stood alone in the fight."},{"id":"seytek-1991-continuation:p0346:b001:l038","ordinal":389422,"en":"He had no sheltering people around him,"},{"id":"seytek-1991-continuation:p0346:b001:l039","ordinal":389423,"en":"No stallion to mount when wearied,"},{"id":"seytek-1991-continuation:p0346:b001:l040","ordinal":389424,"en":"No Ebegey or Kogoy,"},{"id":"seytek-1991-continuation:p0346:b001:l041","ordinal":389425,"en":"Those heroes who waged mighty battle"},{"id":"seytek-1991-continuation:p0346:b001:l042","ordinal":389426,"en":"And came to rescue him."},{"id":"seytek-1991-continuation:p0346:b001:l043","ordinal":389427,"en":"He despaired of his dear life."},{"id":"seytek-1991-continuation:p0346:b001:l044","ordinal":389428,"en":"“Now I will capture this shameless man"},{"id":"seytek-1991-continuation:p0346:b001:l045","ordinal":389429,"en":"Who has been left without a horse,”"},{"id":"seytek-1991-continuation:p0346:b001:l046","ordinal":389430,"en":"Thought the boastful hero Yengkor."},{"id":"seytek-1991-continuation:p0346:b001:l047","ordinal":389431,"en":"Thinking himself a lion,"},{"id":"seytek-1991-continuation:p0346:b001:l048","ordinal":389432,"en":"That madman believed himself alone"},{"id":"seytek-1991-continuation:p0346:b001:l049","ordinal":389433,"en":"Equal to the whole world,"},{"id":"seytek-1991-continuation:p0346:b003:l001","ordinal":389434,"en":"And came striding near."},{"id":"seytek-1991-continuation:p0346:b003:l002","ordinal":389435,"en":"The lion Kenen saw him."},{"id":"seytek-1991-continuation:p0346:b003:l003","ordinal":389436,"en":"His nar-kesken was in his hand;"},{"id":"seytek-1991-continuation:p0346:b003:l004","ordinal":389437,"en":"He seized it firmly by the hilt"},{"id":"seytek-1991-continuation:p0346:b003:l005","ordinal":389438,"en":"And drew the sword"},{"id":"seytek-1991-continuation:p0346:b003:l006","ordinal":389439,"en":"From its sheath."},{"id":"seytek-1991-continuation:p0346:b003:l007","ordinal":389440,"en":"The hero and lion without a steed"},{"id":"seytek-1991-continuation:p0346:b003:l008","ordinal":389441,"en":"Neither hurried nor faltered."},{"id":"seytek-1991-continuation:p0346:b003:l009","ordinal":389442,"en":"Thinking, “Here at last is death,”"},{"id":"seytek-1991-continuation:p0346:b003:l010","ordinal":389443,"en":"He valued torment and death"},{"id":"seytek-1991-continuation:p0346:b003:l011","ordinal":389444,"en":"No more than a trouser cuff,"},{"id":"seytek-1991-continuation:p0346:b003:l012","ordinal":389445,"en":"For the Lord himself"},{"id":"seytek-1991-continuation:p0346:b003:l013","ordinal":389446,"en":"Had bestowed upon him"},{"id":"seytek-1991-continuation:p0346:b003:l014","ordinal":389447,"en":"Measureless courage."},{"id":"seytek-1991-continuation:p0346:b003:l015","ordinal":389448,"en":"He gripped and whirled the sword."},{"id":"seytek-1991-continuation:p0346:b003:l016","ordinal":389449,"en":"When the boar-like swine"},{"id":"seytek-1991-continuation:p0346:b003:l017","ordinal":389450,"en":"Came within cutting distance,"},{"id":"seytek-1991-continuation:p0346:b003:l018","ordinal":389451,"en":"He struck him across the neck."},{"id":"seytek-1991-continuation:p0346:b003:l019","ordinal":389452,"en":"The sword reached him with a whistle;"},{"id":"seytek-1991-continuation:p0346:b003:l020","ordinal":389453,"en":"From artery and neck flesh"},{"id":"seytek-1991-continuation:p0346:b003:l021","ordinal":389454,"en":"Black blood hissed."},{"id":"seytek-1991-continuation:p0346:b003:l022","ordinal":389455,"en":"His head, huge as a yurt,"},{"id":"seytek-1991-continuation:p0346:b003:l023","ordinal":389456,"en":"Tumbled rattling to the ground;"},{"id":"seytek-1991-continuation:p0346:b003:l024","ordinal":389457,"en":"Yengkor fell dead."},{"id":"seytek-1991-continuation:p0346:b003:l025","ordinal":389458,"en":"Fearsome Tengir saw"},{"id":"seytek-1991-continuation:p0346:b003:l026","ordinal":389459,"en":"That Yengkor had died."},{"id":"seytek-1991-continuation:p0346:b003:l027","ordinal":389460,"en":"He threw the whole world into panic,"},{"id":"seytek-1991-continuation:p0346:b003:l028","ordinal":389461,"en":"Spurring onward Kula-ker beneath him."},{"id":"seytek-1991-continuation:p0346:b003:l029","ordinal":389462,"en":"He shouted to his mace-men,"},{"id":"seytek-1991-continuation:p0346:b003:l030","ordinal":389463,"en":"Calling his great champions:"},{"id":"seytek-1991-continuation:p0346:b003:l031","ordinal":389464,"en":"“There is one Burut and a multitude of you;"},{"id":"seytek-1991-continuation:p0346:b003:l032","ordinal":389465,"en":"What kind of people are the tribal Chinese?"},{"id":"seytek-1991-continuation:p0346:b003:l033","ordinal":389466,"en":"Surge, Manchus, surge!"},{"id":"seytek-1991-continuation:p0346:b003:l034","ordinal":389467,"en":"Knead him into the earth and trample him!”"},{"id":"seytek-1991-continuation:p0346:b003:l035","ordinal":389468,"en":"Shouting for his spear of greatest havoc,"},{"id":"seytek-1991-continuation:p0346:b003:l036","ordinal":389469,"en":"The huge spear made by Ebegey,"},{"id":"seytek-1991-continuation:p0346:b003:l037","ordinal":389470,"en":"He bellowed and cried,"},{"id":"seytek-1991-continuation:p0346:b003:l038","ordinal":389471,"en":"Bending and flattening birch and willow,"},{"id":"seytek-1991-continuation:p0346:b003:l039","ordinal":389472,"en":"And summoned his countless champions."},{"id":"seytek-1991-continuation:p0346:b003:l040","ordinal":389473,"en":"At the horseless, weakened Kenen,"},{"id":"seytek-1991-continuation:p0346:b003:l041","ordinal":389474,"en":"To deprive him of every escape,"},{"id":"seytek-1991-continuation:p0346:b003:l042","ordinal":389475,"en":"Chyntengir strained and aimed,"},{"id":"seytek-1991-continuation:p0346:b003:l043","ordinal":389476,"en":"Taking the place beneath the heart,"},{"id":"seytek-1991-continuation:p0346:b003:l044","ordinal":389477,"en":"The measured edge of the lung,"},{"id":"seytek-1991-continuation:p0346:b003:l045","ordinal":389478,"en":"The exact center of his aim:"},{"id":"seytek-1991-continuation:p0346:b003:l046","ordinal":389479,"en":"“Even if he had a hundred thousand lives,"},{"id":"seytek-1991-continuation:p0346:b003:l047","ordinal":389480,"en":"They would all fly out here.”"},{"id":"seytek-1991-continuation:p0346:b003:l048","ordinal":389481,"en":"He turned his stallion's head,"},{"id":"seytek-1991-continuation:p0346:b003:l049","ordinal":389482,"en":"And his eyes blazed like fire."},{"id":"seytek-1991-continuation:p0347:b001:l001","ordinal":389483,"en":"His raging fury boiled over."},{"id":"seytek-1991-continuation:p0347:b001:l002","ordinal":389484,"en":"As he was about to strike with his spear,"},{"id":"seytek-1991-continuation:p0347:b001:l003","ordinal":389485,"en":"The hero and lion,"},{"id":"seytek-1991-continuation:p0347:b001:l004","ordinal":389486,"en":"Swift beyond measure,"},{"id":"seytek-1991-continuation:p0347:b001:l005","ordinal":389487,"en":"The most perceptive sage,"},{"id":"seytek-1991-continuation:p0347:b001:l006","ordinal":389488,"en":"Ground his teeth like millstones."},{"id":"seytek-1991-continuation:p0347:b001:l007","ordinal":389489,"en":"His eyes flashed like a lion's;"},{"id":"seytek-1991-continuation:p0347:b001:l008","ordinal":389490,"en":"He thrust and whirled the sword."},{"id":"seytek-1991-continuation:p0347:b001:l009","ordinal":389491,"en":"Er Kenen struck the dun horse"},{"id":"seytek-1991-continuation:p0347:b001:l010","ordinal":389492,"en":"At the place the poor hero had chosen,"},{"id":"seytek-1991-continuation:p0347:b001:l011","ordinal":389493,"en":"Drawing the blade across it."},{"id":"seytek-1991-continuation:p0347:b001:l012","ordinal":389494,"en":"When Kenen performed that feat,"},{"id":"seytek-1991-continuation:p0347:b001:l013","ordinal":389495,"en":"When he brought the sword down true,"},{"id":"seytek-1991-continuation:p0347:b001:l014","ordinal":389496,"en":"The champion Chyntengir's"},{"id":"seytek-1991-continuation:p0347:b001:l015","ordinal":389497,"en":"True stallion toppled."},{"id":"seytek-1991-continuation:p0347:b001:l016","ordinal":389498,"en":"Its house-sized head fell;"},{"id":"seytek-1991-continuation:p0347:b001:l017","ordinal":389499,"en":"As if a mountain had collapsed,"},{"id":"seytek-1991-continuation:p0347:b001:l018","ordinal":389500,"en":"The dun horse pitched over and lay still."},{"id":"seytek-1991-continuation:p0347:b001:l019","ordinal":389501,"en":"When Chyntengir was left on foot,"},{"id":"seytek-1991-continuation:p0347:b001:l020","ordinal":389502,"en":"Your father, the dear gray-maned hero,"},{"id":"seytek-1991-continuation:p0347:b001:l021","ordinal":389503,"en":"Hewed with his sword"},{"id":"seytek-1991-continuation:p0347:b002:l001","ordinal":389504,"en":"And shouted as he waged battle."},{"id":"seytek-1991-continuation:p0347:b003:l001","ordinal":389505,"en":"The sword shattered on the swine,"},{"id":"seytek-1991-continuation:p0347:b003:l002","ordinal":389506,"en":"Leaving only the hilt in his hand."},{"id":"seytek-1991-continuation:p0347:b003:l003","ordinal":389507,"en":"The Kaldays and chiefs,"},{"id":"seytek-1991-continuation:p0347:b003:l004","ordinal":389508,"en":"Men with iron lariat nets,"},{"id":"seytek-1991-continuation:p0347:b003:l005","ordinal":389509,"en":"All armed in iron,"},{"id":"seytek-1991-continuation:p0347:b003:l006","ordinal":389510,"en":"Fully armed infidels,"},{"id":"seytek-1991-continuation:p0347:b003:l007","ordinal":389511,"en":"Heroes who had come from Kakan,"},{"id":"seytek-1991-continuation:p0347:b003:l008","ordinal":389512,"en":"Mounted Chyntengir again"},{"id":"seytek-1991-continuation:p0347:b003:l009","ordinal":389513,"en":"On another swift stallion."},{"id":"seytek-1991-continuation:p0347:b003:l010","ordinal":389514,"en":"They put their khan on horseback,"},{"id":"seytek-1991-continuation:p0347:b003:l011","ordinal":389515,"en":"Burning Kenen's soul with anguish."},{"id":"seytek-1991-continuation:p0347:b003:l012","ordinal":389516,"en":"Then they cast iron lariat nets"},{"id":"seytek-1991-continuation:p0347:b003:l013","ordinal":389517,"en":"Over Kenen,"},{"id":"seytek-1991-continuation:p0347:b003:l014","ordinal":389518,"en":"Surrounded and attacked him,"},{"id":"seytek-1991-continuation:p0347:b003:l015","ordinal":389519,"en":"And truly robbed him of escape."},{"id":"seytek-1991-continuation:p0347:b003:l016","ordinal":389520,"en":"They firmly bound his hands."},{"id":"seytek-1991-continuation:p0347:b003:l017","ordinal":389521,"en":"Poor Kenen the leopard,"},{"id":"seytek-1991-continuation:p0347:b003:l018","ordinal":389522,"en":"The champion on whom hopes rested,"},{"id":"seytek-1991-continuation:p0347:b003:l019","ordinal":389523,"en":"The renowned hero of the Kyrgyz,"},{"id":"seytek-1991-continuation:p0347:b003:l020","ordinal":389524,"en":"Sultan of the white-capped people—"},{"id":"seytek-1991-continuation:p0347:b003:l021","ordinal":389525,"en":"Kenen was alone and the Chinese were a thousand."},{"id":"seytek-1991-continuation:p0347:b003:l022","ordinal":389526,"en":"They tore and ruined his coat,"},{"id":"seytek-1991-continuation:p0347:b003:l023","ordinal":389527,"en":"Displaying their great force,"},{"id":"seytek-1991-continuation:p0347:b003:l024","ordinal":389528,"en":"Tormenting his fly-like soul."},{"id":"seytek-1991-continuation:p0347:b003:l025","ordinal":389529,"en":"They wound his hands and feet tightly;"},{"id":"seytek-1991-continuation:p0347:b003:l026","ordinal":389530,"en":"Chyntengir bound and enclosed"},{"id":"seytek-1991-continuation:p0347:b003:l027","ordinal":389531,"en":"His entire body in chains."},{"id":"seytek-1991-continuation:p0347:b004:l001","ordinal":389532,"en":"They jerked him until his back bent,"},{"id":"seytek-1991-continuation:p0347:b004:l002","ordinal":389533,"en":"Loaded him upon a gray mule,"},{"id":"seytek-1991-continuation:p0347:b005:l001","ordinal":389534,"en":"And ordered, “Avenge your forefather!”"},{"id":"seytek-1991-continuation:p0347:b006:l001","ordinal":389535,"en":"They had their champions beat him"},{"id":"seytek-1991-continuation:p0347:b006:l002","ordinal":389536,"en":"And drove him before their khan."},{"id":"seytek-1991-continuation:p0347:b006:l003","ordinal":389537,"en":"Poor Kenen saw"},{"id":"seytek-1991-continuation:p0347:b006:l004","ordinal":389538,"en":"A cold and merciless black night."},{"id":"seytek-1991-continuation:p0347:b006:l005","ordinal":389539,"en":"“If you are a hero and a lion,"},{"id":"seytek-1991-continuation:p0347:b006:l006","ordinal":389540,"en":"Descendant of your Kalmyk forefather Kongurbay,"},{"id":"seytek-1991-continuation:p0347:b006:l007","ordinal":389541,"en":"Loosen my hands for a moment."},{"id":"seytek-1991-continuation:p0347:b006:l008","ordinal":389542,"en":"Let me see your heroism,"},{"id":"seytek-1991-continuation:p0347:b006:l009","ordinal":389543,"en":"And then I will take your head."},{"id":"seytek-1991-continuation:p0347:b006:l010","ordinal":389544,"en":"Release my hands,"},{"id":"seytek-1991-continuation:p0347:b006:l011","ordinal":389545,"en":"Then hear my answer."},{"id":"seytek-1991-continuation:p0347:b006:l012","ordinal":389546,"en":"While my eyelashes still move,"},{"id":"seytek-1991-continuation:p0347:b006:l013","ordinal":389547,"en":"How can you bend my back?"},{"id":"seytek-1991-continuation:p0347:b006:l014","ordinal":389548,"en":"How could I surrender my people?”"},{"id":"seytek-1991-continuation:p0347:b006:l015","ordinal":389549,"en":"Hearing this, Chyntengir said:"},{"id":"seytek-1991-continuation:p0347:b006:l016","ordinal":389550,"en":"“The Ala-Too is no land for us;"},{"id":"seytek-1991-continuation:p0347:b006:l017","ordinal":389551,"en":"The old enemy, the vile Burut,"},{"id":"seytek-1991-continuation:p0347:b006:l018","ordinal":389552,"en":"Will never be a people to us."},{"id":"seytek-1991-continuation:p0347:b006:l019","ordinal":389553,"en":"Inflict harsh torment;"},{"id":"seytek-1991-continuation:p0347:b006:l020","ordinal":389554,"en":"Silence his tongue without delay."},{"id":"seytek-1991-continuation:p0347:b006:l021","ordinal":389555,"en":"Bring his death upon him now,"},{"id":"seytek-1991-continuation:p0347:b006:l022","ordinal":389556,"en":"Deprive him of every recourse."},{"id":"seytek-1991-continuation:p0347:b006:l023","ordinal":389557,"en":"Cut strips of hide from his back;"},{"id":"seytek-1991-continuation:p0347:b006:l024","ordinal":389558,"en":"You blood-drinking champions,"},{"id":"seytek-1991-continuation:p0347:b006:l025","ordinal":389559,"en":"Seize him and take his life!"},{"id":"seytek-1991-continuation:p0347:b006:l026","ordinal":389560,"en":"Cut off his sheep-like head;"},{"id":"seytek-1991-continuation:p0347:b006:l027","ordinal":389561,"en":"Rip open his melon-like belly!”"},{"id":"seytek-1991-continuation:p0347:b006:l028","ordinal":389562,"en":"Thus Chyntengir spoke,"},{"id":"seytek-1991-continuation:p0347:b006:l029","ordinal":389563,"en":"Urging and dispatching"},{"id":"seytek-1991-continuation:p0347:b006:l030","ordinal":389564,"en":"His champions and giants,"},{"id":"seytek-1991-continuation:p0347:b006:l031","ordinal":389565,"en":"Rousing and dispatching"},{"id":"seytek-1991-continuation:p0347:b006:l032","ordinal":389566,"en":"His strongest heroes."},{"id":"seytek-1991-continuation:p0347:b006:l033","ordinal":389567,"en":"His champions and warriors"},{"id":"seytek-1991-continuation:p0347:b006:l034","ordinal":389568,"en":"Now began to trample and beat him,"},{"id":"seytek-1991-continuation:p0347:b006:l035","ordinal":389569,"en":"Inflicting every torture they knew."},{"id":"seytek-1991-continuation:p0347:b006:l036","ordinal":389570,"en":"They tormented and took his life,"},{"id":"seytek-1991-continuation:p0347:b006:l037","ordinal":389571,"en":"Cutting off his hands and feet."},{"id":"seytek-1991-continuation:p0347:b006:l038","ordinal":389572,"en":"The champions attacked"},{"id":"seytek-1991-continuation:p0347:b006:l039","ordinal":389573,"en":"The noble gray-maned hero"},{"id":"seytek-1991-continuation:p0347:b006:l040","ordinal":389574,"en":"And took his precious head;"},{"id":"seytek-1991-continuation:p0347:b006:l041","ordinal":389575,"en":"They finished him then and there."},{"id":"seytek-1991-continuation:p0347:b006:l042","ordinal":389576,"en":"“We slaughtered and destroyed the champion"},{"id":"seytek-1991-continuation:p0347:b006:l043","ordinal":389577,"en":"Whose stars crossed ours.”"},{"id":"seytek-1991-continuation:p0347:b006:l044","ordinal":389578,"en":"Breaking through the dead end and opening a road,"},{"id":"seytek-1991-continuation:p0347:b006:l045","ordinal":389579,"en":"The Chinese army attacked directly"},{"id":"seytek-1991-continuation:p0347:b006:l046","ordinal":389580,"en":"Against the true Black Kyrgyz."},{"id":"seytek-1991-continuation:p0348:b001:l001","ordinal":389581,"en":"Alymsaryk and hero Kulan,"},{"id":"seytek-1991-continuation:p0348:b001:l002","ordinal":389582,"en":"Defenders of all the people,"},{"id":"seytek-1991-continuation:p0348:b001:l003","ordinal":389583,"en":"Fought a vicious fight,"},{"id":"seytek-1991-continuation:p0348:b001:l004","ordinal":389584,"en":"Standing face-to-face,"},{"id":"seytek-1991-continuation:p0348:b001:l005","ordinal":389585,"en":"Fighting turn by turn,"},{"id":"seytek-1991-continuation:p0348:b001:l006","ordinal":389586,"en":"Locked in a bloody struggle."},{"id":"seytek-1991-continuation:p0348:b001:l007","ordinal":389587,"en":"Their father, gray-maned Jeljetpes,"},{"id":"seytek-1991-continuation:p0348:b001:l008","ordinal":389588,"en":"Was protecting the twin heroes,"},{"id":"seytek-1991-continuation:p0348:b001:l009","ordinal":389589,"en":"So the champion's line might endure."},{"id":"seytek-1991-continuation:p0348:b001:l010","ordinal":389590,"en":"He turned summer's day into winter,"},{"id":"seytek-1991-continuation:p0348:b001:l011","ordinal":389591,"en":"And plunged the Chinese and Kakan troops"},{"id":"seytek-1991-continuation:p0348:b001:l012","ordinal":389592,"en":"Who came against them into calamity."},{"id":"seytek-1991-continuation:p0348:b001:l013","ordinal":389593,"en":"He sent a flood and made it water."},{"id":"seytek-1991-continuation:p0348:b001:l014","ordinal":389594,"en":"The three heroes raised an uproar,"},{"id":"seytek-1991-continuation:p0348:b001:l015","ordinal":389595,"en":"Cutting through the standing Chinese host."},{"id":"seytek-1991-continuation:p0348:b001:l016","ordinal":389596,"en":"Supporting one another,"},{"id":"seytek-1991-continuation:p0348:b001:l017","ordinal":389597,"en":"They were drenched in bloody dust,"},{"id":"seytek-1991-continuation:p0348:b001:l018","ordinal":389598,"en":"And fought without turning back."},{"id":"seytek-1991-continuation:p0348:b001:l019","ordinal":389599,"en":"Jeljetpes moved through their midst;"},{"id":"seytek-1991-continuation:p0348:b001:l020","ordinal":389600,"en":"Wounded in seven places,"},{"id":"seytek-1991-continuation:p0348:b001:l021","ordinal":389601,"en":"He had a net spread before him."},{"id":"seytek-1991-continuation:p0348:b001:l022","ordinal":389602,"en":"After countless heroes"},{"id":"seytek-1991-continuation:p0348:b001:l023","ordinal":389603,"en":"From the Beijing host thrust at him,"},{"id":"seytek-1991-continuation:p0348:b001:l024","ordinal":389604,"en":"His life was truly scorched."},{"id":"seytek-1991-continuation:p0348:b002:l001","ordinal":389605,"en":"He was snatched from certain death,"},{"id":"seytek-1991-continuation:p0348:b002:l002","ordinal":389606,"en":"Caught in the fatal net,"},{"id":"seytek-1991-continuation:p0348:b002:l003","ordinal":389607,"en":"Yet Jeljetpes broke free and escaped."},{"id":"seytek-1991-continuation:p0348:b002:l004","ordinal":389608,"en":"Alymsaryk and Kulansaryk,"},{"id":"seytek-1991-continuation:p0348:b002:l005","ordinal":389609,"en":"Two fair heroes with rhyming names,"},{"id":"seytek-1991-continuation:p0348:b002:l006","ordinal":389610,"en":"Passed through the solitary foe."},{"id":"seytek-1991-continuation:p0348:b002:l007","ordinal":389611,"en":"Their muscular flesh was torn,"},{"id":"seytek-1991-continuation:p0348:b002:l008","ordinal":389612,"en":"And the flesh of their ribs ripped away;"},{"id":"seytek-1991-continuation:p0348:b002:l009","ordinal":389613,"en":"The two reached a quiet place."},{"id":"seytek-1991-continuation:p0348:b002:l010","ordinal":389614,"en":"Climbing to a mountain pass, they leaned down,"},{"id":"seytek-1991-continuation:p0348:b002:l011","ordinal":389615,"en":"And on a truly sacred hill"},{"id":"seytek-1991-continuation:p0348:b002:l012","ordinal":389616,"en":"They dozed and fell asleep."},{"id":"seytek-1991-continuation:p0348:b002:l013","ordinal":389617,"en":"Their closed eyes would not open,"},{"id":"seytek-1991-continuation:p0348:b002:l014","ordinal":389618,"en":"Their outstretched legs would not draw in,"},{"id":"seytek-1991-continuation:p0348:b002:l015","ordinal":389619,"en":"And their deep snoring did not cease."},{"id":"seytek-1991-continuation:p0348:b002:l016","ordinal":389620,"en":"They sank into a giant's sleep."},{"id":"seytek-1991-continuation:p0348:b002:l017","ordinal":389621,"en":"Jeljetpes and the twin heroes"},{"id":"seytek-1991-continuation:p0348:b002:l018","ordinal":389622,"en":"Let the horses they had ridden to war"},{"id":"seytek-1991-continuation:p0348:b002:l019","ordinal":389623,"en":"Cool fully and drink their fill."},{"id":"seytek-1991-continuation:p0348:b002:l020","ordinal":389624,"en":"They grazed them on feather grass,"},{"id":"seytek-1991-continuation:p0348:b002:l021","ordinal":389625,"en":"Led them a little while,"},{"id":"seytek-1991-continuation:p0348:b002:l022","ordinal":389626,"en":"And filled their throats with grass;"},{"id":"seytek-1991-continuation:p0348:b002:l023","ordinal":389627,"en":"Led them a long while,"},{"id":"seytek-1991-continuation:p0348:b002:l024","ordinal":389628,"en":"And filled their chests with grass."},{"id":"sayakbay-ms-current144:pdf007:l001","ordinal":389629,"en":"[Uncertain: this was …]"},{"id":"sayakbay-ms-current144:pdf007:l002","ordinal":389630,"en":"Who met the Night of Power."},{"id":"sayakbay-ms-current144:pdf007:l003","ordinal":389631,"en":"The people's wish, for the nation,"},{"id":"sayakbay-ms-current144:pdf007:l004","ordinal":389632,"en":"The leopard-like hero protecting the people."}]
