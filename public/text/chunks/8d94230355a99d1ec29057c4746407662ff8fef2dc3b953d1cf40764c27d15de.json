[{"id":"semetey-1-2013:p0833:b005:l038","ordinal":140033,"en":"Gave a letter the size of a palm,"},{"id":"semetey-1-2013:p0833:b005:l039","ordinal":140034,"en":"Devised much treachery,"},{"id":"semetey-1-2013:p0834:b003:l001","ordinal":140035,"en":"Kyrgylchal, leader of the forty—"},{"id":"semetey-1-2013:p0834:b003:l002","ordinal":140036,"en":"They sent Kyrgylchal riding."},{"id":"semetey-1-2013:p0834:b003:l003","ordinal":140037,"en":"Dwelling in Chambyl-Bel"},{"id":"semetey-1-2013:p0834:b003:l004","ordinal":140038,"en":"Were Janaaly and the hero Karach."},{"id":"semetey-1-2013:p0834:b003:l006","ordinal":140039,"en":"For killing Koenaaly,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0834:b003:l007","ordinal":140040,"en":"He too had a vengeance against Semetey."},{"id":"semetey-1-2013:p0834:b003:l008","ordinal":140041,"en":"They had sent him word;"},{"id":"semetey-1-2013:p0834:b003:l009","ordinal":140042,"en":"Kozubek’s army"},{"id":"semetey-1-2013:p0834:b003:l010","ordinal":140043,"en":"He had joined."},{"id":"semetey-1-2013:p0834:b003:l011","ordinal":140044,"en":"The peoples of four khans gathered,"},{"id":"semetey-1-2013:p0834:b003:l012","ordinal":140045,"en":"The lord’s orphan son"},{"id":"semetey-1-2013:p0834:b003:l013","ordinal":140046,"en":"They clamored to overwhelm."},{"id":"semetey-1-2013:p0834:b003:l014","ordinal":140047,"en":"“Do not lose your wits,” they said;"},{"id":"semetey-1-2013:p0834:b003:l015","ordinal":140048,"en":"“Not one of you turn back,” they said."},{"id":"semetey-1-2013:p0834:b003:l016","ordinal":140049,"en":"They chewed white wheat flour,"},{"id":"semetey-1-2013:p0834:b003:l017","ordinal":140050,"en":"Held the Holy Koran,"},{"id":"semetey-1-2013:p0834:b003:l018","ordinal":140051,"en":"Licked an oath unto death,"},{"id":"semetey-1-2013:p0834:b003:l019","ordinal":140052,"en":"Swore a vow to die."},{"id":"semetey-1-2013:p0834:b003:l020","ordinal":140053,"en":"“Do not crowd together; spread out,” they said;"},{"id":"semetey-1-2013:p0834:b003:l021","ordinal":140054,"en":"“Go abreast, all in one line,” they said."},{"id":"semetey-1-2013:p0834:b003:l022","ordinal":140055,"en":"Stretching along the edge, swaying,"},{"id":"semetey-1-2013:p0834:b003:l023","ordinal":140056,"en":"Moving in rows, undulating,"},{"id":"semetey-1-2013:p0834:b003:l024","ordinal":140057,"en":"Their spearheads struck together;"},{"id":"semetey-1-2013:p0834:b003:l025","ordinal":140058,"en":"The men’s heads knocked together."},{"id":"semetey-1-2013:p0834:b003:l026","ordinal":140059,"en":"Look at the reeds, look at the flood;"},{"id":"semetey-1-2013:p0834:b003:l027","ordinal":140060,"en":"Look at the Sart people surging forward!"},{"id":"semetey-1-2013:p0834:b003:l028","ordinal":140061,"en":"All alike as starlings,"},{"id":"semetey-1-2013:p0834:b003:l029","ordinal":140062,"en":"Those riding gray horses formed one group."},{"id":"semetey-1-2013:p0834:b003:l030","ordinal":140063,"en":"Fattened on maize,"},{"id":"semetey-1-2013:p0834:b003:l032","ordinal":140064,"en":"Riding stallions, making them pant,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0834:b003:l033","ordinal":140065,"en":"Making them lunge like a widow in grief,"},{"id":"semetey-1-2013:p0834:b003:l034","ordinal":140066,"en":"Many more suffered thus."},{"id":"semetey-1-2013:p0834:b003:l035","ordinal":140067,"en":"Their necks hunched,"},{"id":"semetey-1-2013:p0834:b003:l036","ordinal":140068,"en":"Their ears pricked,"},{"id":"semetey-1-2013:p0834:b003:l037","ordinal":140069,"en":"Their tails firmly knotted,"},{"id":"semetey-1-2013:p0834:b003:l038","ordinal":140070,"en":"Genuine stout riding horses—"},{"id":"semetey-1-2013:p0834:b003:l039","ordinal":140071,"en":"Those mounted on them formed one group."},{"id":"semetey-1-2013:p0834:b004:l001","ordinal":140072,"en":"Pale banners became their standards;"},{"id":"semetey-1-2013:p0834:b004:l002","ordinal":140073,"en":"Cries of “Boy-boy!” rose in uproar."},{"id":"semetey-1-2013:p0834:b004:l003","ordinal":140074,"en":"Their shouting split the earth;"},{"id":"semetey-1-2013:p0834:b004:l004","ordinal":140075,"en":"Crying the battle cry “Kokand!”"},{"id":"semetey-1-2013:p0834:b004:l005","ordinal":140076,"en":"Their thousand champions yelled,"},{"id":"semetey-1-2013:p0834:b004:l006","ordinal":140077,"en":"Their arrows whistled,"},{"id":"semetey-1-2013:p0834:b004:l007","ordinal":140078,"en":"And all came rushing in."},{"id":"semetey-1-2013:p0834:b004:l008","ordinal":140079,"en":"Your dear mother Kanykei"},{"id":"semetey-1-2013:p0834:b004:l009","ordinal":140080,"en":"Her black hair, thick as a girth,"},{"id":"semetey-1-2013:p0834:b004:l010","ordinal":140081,"en":"Had tied tightly atop her head."},{"id":"semetey-1-2013:p0834:b004:l011","ordinal":140082,"en":"“If my death has come, I shall die;"},{"id":"semetey-1-2013:p0834:b004:l012","ordinal":140083,"en":"If I can, for my only son"},{"id":"semetey-1-2013:p0834:b004:l013","ordinal":140084,"en":"I shall be a shelter,” she said."},{"id":"semetey-1-2013:p0834:b004:l014","ordinal":140085,"en":"Her black, blaze-faced thoroughbred—"},{"id":"semetey-1-2013:p0834:b004:l015","ordinal":140086,"en":"She tightened its girth firmly."},{"id":"semetey-1-2013:p0834:b004:l016","ordinal":140087,"en":"Beside her, Sary Khan,"},{"id":"semetey-1-2013:p0834:b004:l017","ordinal":140088,"en":"His fiery eyes blazing brightly,"},{"id":"semetey-1-2013:p0834:b004:l018","ordinal":140089,"en":"His mighty teeth like a door,"},{"id":"semetey-1-2013:p0834:b004:l019","ordinal":140090,"en":"Gnashed them hard, again and again."},{"id":"semetey-1-2013:p0834:b004:l020","ordinal":140091,"en":"Beneath him was Tuuchunak;"},{"id":"semetey-1-2013:p0834:b004:l021","ordinal":140092,"en":"He had that outstanding noble steed,"},{"id":"semetey-1-2013:p0834:b004:l022","ordinal":140093,"en":"Seasoned in fighting the enemy."},{"id":"semetey-1-2013:p0834:b004:l023","ordinal":140094,"en":"That splendid noble beast,"},{"id":"semetey-1-2013:p0834:b004:l024","ordinal":140095,"en":"Tuuchunak, a true thoroughbred—"},{"id":"semetey-1-2013:p0834:b004:l025","ordinal":140096,"en":"They drew the reins and turned,"},{"id":"semetey-1-2013:p0834:b004:l026","ordinal":140097,"en":"And at the thousand troops before them"},{"id":"semetey-1-2013:p0834:b004:l027","ordinal":140098,"en":"They stood astonished."},{"id":"semetey-1-2013:p0834:b004:l028","ordinal":140099,"en":"One spoke to the other:"},{"id":"semetey-1-2013:p0834:b004:l029","ordinal":140100,"en":"“Do you see, Sary Khan?"},{"id":"semetey-1-2013:p0834:b004:l031","ordinal":140101,"en":"If my only son falls into their hands,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0834:b004:l032","ordinal":140102,"en":"These fools seem unlikely to leave him alive."},{"id":"semetey-1-2013:p0834:b004:l033","ordinal":140103,"en":"Pale banners, red standards,"},{"id":"semetey-1-2013:p0834:b004:l034","ordinal":140104,"en":"Cries of ‘Boy-boy!’ and uproar—"},{"id":"semetey-1-2013:p0834:b004:l037","ordinal":140105,"en":"A sweeping gale is coming;","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0834:b004:l038","ordinal":140106,"en":"A vast, tumultuous people is coming!”"},{"id":"semetey-1-2013:p0834:b004:l039","ordinal":140107,"en":"When those two spoke thus,"},{"id":"semetey-1-2013:p0835:b003:l001","ordinal":140108,"en":"Semetey stood and said:"},{"id":"semetey-1-2013:p0835:b003:l002","ordinal":140109,"en":"“If they act as enemies,"},{"id":"semetey-1-2013:p0835:b003:l003","ordinal":140110,"en":"Let us endure the trouble they bring."},{"id":"semetey-1-2013:p0835:b003:l004","ordinal":140111,"en":"If they attack where we meet,"},{"id":"semetey-1-2013:p0835:b003:l005","ordinal":140112,"en":"Then let us give them our greeting."},{"id":"semetey-1-2013:p0835:b003:l006","ordinal":140113,"en":"If we eagerly exchange fire,"},{"id":"semetey-1-2013:p0835:b003:l008","ordinal":140114,"en":"If they themselves come lumbering to attack,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0835:b003:l009","ordinal":140115,"en":"Then let us strike."},{"id":"semetey-1-2013:p0835:b003:l010","ordinal":140116,"en":"The duty of a Muslim—"},{"id":"semetey-1-2013:p0835:b003:l011","ordinal":140117,"en":"My mother and my uncle,"},{"id":"semetey-1-2013:p0835:b003:l012","ordinal":140118,"en":"Let us first discharge it!"},{"id":"semetey-1-2013:p0835:b003:l013","ordinal":140119,"en":"If we attack without cause,"},{"id":"semetey-1-2013:p0835:b003:l014","ordinal":140120,"en":"If we begin the turmoil,"},{"id":"semetey-1-2013:p0835:b003:l015","ordinal":140121,"en":"If we slaughter them unawares,"},{"id":"semetey-1-2013:p0835:b003:l016","ordinal":140122,"en":"They too are children of Muslims."},{"id":"semetey-1-2013:p0835:b003:l017","ordinal":140123,"en":"In the end, one day we shall die;"},{"id":"semetey-1-2013:p0835:b003:l018","ordinal":140124,"en":"If what is told is true,"},{"id":"semetey-1-2013:p0835:b003:l019","ordinal":140125,"en":"On the coming Day of Resurrection,"},{"id":"semetey-1-2013:p0835:b003:l020","ordinal":140126,"en":"If the faithful demand justice for their blood,"},{"id":"semetey-1-2013:p0835:b003:l021","ordinal":140127,"en":"What answer shall we give?"},{"id":"semetey-1-2013:p0835:b003:l023","ordinal":140128,"en":"These Muslims coming toward us","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0835:b003:l024","ordinal":140129,"en":"Are no people come from China."},{"id":"semetey-1-2013:p0835:b003:l025","ordinal":140130,"en":"My mother and my uncle,"},{"id":"semetey-1-2013:p0835:b003:l026","ordinal":140131,"en":"Take the road and go on."},{"id":"semetey-1-2013:p0835:b003:l027","ordinal":140132,"en":"If they have an embassy’s purpose,"},{"id":"semetey-1-2013:p0835:b003:l028","ordinal":140133,"en":"Let me listen carefully and understand."},{"id":"semetey-1-2013:p0835:b003:l029","ordinal":140134,"en":"If they come out to crush me in battle,"},{"id":"semetey-1-2013:p0835:b003:l030","ordinal":140135,"en":"Let me kill and put them in the earth."},{"id":"semetey-1-2013:p0835:b003:l031","ordinal":140136,"en":"If Muslims exchange fire with me,"},{"id":"semetey-1-2013:p0835:b003:l032","ordinal":140137,"en":"Let me die if my time has come."},{"id":"semetey-1-2013:p0835:b003:l033","ordinal":140138,"en":"Their friendship or hostility—"},{"id":"semetey-1-2013:p0835:b003:l034","ordinal":140139,"en":"Let me carefully discern it."},{"id":"semetey-1-2013:p0835:b003:l035","ordinal":140140,"en":"If they face me as enemies,"},{"id":"semetey-1-2013:p0835:b003:l036","ordinal":140141,"en":"Even enemies come from Mecca,"},{"id":"semetey-1-2013:p0835:b003:l037","ordinal":140142,"en":"Let me face and fight them,"},{"id":"semetey-1-2013:p0835:b003:l038","ordinal":140143,"en":"And drive them as far as Mecca."},{"id":"semetey-1-2013:p0835:b003:l039","ordinal":140144,"en":"Even mountains no generation has crossed,"},{"id":"semetey-1-2013:p0835:b005:l001","ordinal":140145,"en":"Even enemies come from China—"},{"id":"semetey-1-2013:p0835:b005:l002","ordinal":140146,"en":"Then let me slaughter them all."},{"id":"semetey-1-2013:p0835:b005:l003","ordinal":140147,"en":"Perhaps they come in friendship;"},{"id":"semetey-1-2013:p0835:b005:l004","ordinal":140148,"en":"Let me somehow hear their answer."},{"id":"semetey-1-2013:p0835:b005:l005","ordinal":140149,"en":"If they come pursuing and fighting,"},{"id":"semetey-1-2013:p0835:b005:l006","ordinal":140150,"en":"Let me kill and put them in the earth.”"},{"id":"semetey-1-2013:p0835:b005:l007","ordinal":140151,"en":"Having said this, Semetey"},{"id":"semetey-1-2013:p0835:b005:l008","ordinal":140152,"en":"His mother and his uncle"},{"id":"semetey-1-2013:p0835:b005:l009","ordinal":140153,"en":"Sent ahead."},{"id":"semetey-1-2013:p0835:b005:l011","ordinal":140154,"en":"He drew the reins and turned;","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0835:b005:l012","ordinal":140155,"en":"Your orphan, Manas’s son,"},{"id":"semetey-1-2013:p0835:b005:l013","ordinal":140156,"en":"Stood watching without weariness."},{"id":"semetey-1-2013:p0835:b005:l014","ordinal":140157,"en":"At the sight, hearts were troubled;"},{"id":"semetey-1-2013:p0835:b005:l015","ordinal":140158,"en":"Fierce, lion Manas—"},{"id":"semetey-1-2013:p0835:b005:l016","ordinal":140159,"en":"He looked exactly like him."},{"id":"semetey-1-2013:p0835:b005:l017","ordinal":140160,"en":"That dear lion, like a quiver,"},{"id":"semetey-1-2013:p0835:b005:l018","ordinal":140161,"en":"Stood motionless in that place."},{"id":"semetey-1-2013:p0835:b005:l019","ordinal":140162,"en":"The thousand champions surging toward him"},{"id":"semetey-1-2013:p0835:b005:l020","ordinal":140163,"en":"Were deeply troubled at heart."},{"id":"semetey-1-2013:p0835:b005:l021","ordinal":140164,"en":"Your orphan, Manas’s son,"},{"id":"semetey-1-2013:p0835:b005:l022","ordinal":140165,"en":"Appeared like Mount Opol."},{"id":"semetey-1-2013:p0835:b005:l023","ordinal":140166,"en":"When the boy faced them,"},{"id":"semetey-1-2013:p0835:b005:l024","ordinal":140167,"en":"He had a dragon’s appearance;"},{"id":"semetey-1-2013:p0835:b005:l025","ordinal":140168,"en":"When the boy turned his back,"},{"id":"semetey-1-2013:p0835:b005:l026","ordinal":140169,"en":"He had a lion’s majesty."},{"id":"semetey-1-2013:p0835:b005:l027","ordinal":140170,"en":"Challenging a blessed hero,"},{"id":"semetey-1-2013:p0835:b005:l028","ordinal":140171,"en":"Entangling themselves in death—"},{"id":"semetey-1-2013:p0835:b005:l029","ordinal":140172,"en":"These Sarts must have a demon in them."},{"id":"semetey-1-2013:p0835:b005:l030","ordinal":140173,"en":"The champions surged toward the boy,"},{"id":"semetey-1-2013:p0835:b005:l031","ordinal":140174,"en":"Intending to make a great spectacle of him."},{"id":"semetey-1-2013:p0835:b005:l032","ordinal":140175,"en":"Attacking him all together,"},{"id":"semetey-1-2013:p0835:b005:l033","ordinal":140176,"en":"They intended great havoc."},{"id":"semetey-1-2013:p0835:b005:l034","ordinal":140177,"en":"All the champions,"},{"id":"semetey-1-2013:p0835:b005:l035","ordinal":140178,"en":"Janaaly and their elder Karach,"},{"id":"semetey-1-2013:p0835:b005:l036","ordinal":140179,"en":"Four champions who lifted camels,"},{"id":"semetey-1-2013:p0835:b005:l037","ordinal":140180,"en":"Five champions who punched camels,"},{"id":"semetey-1-2013:p0835:b005:l038","ordinal":140181,"en":"All the champions"},{"id":"semetey-1-2013:p0835:b005:l039","ordinal":140182,"en":"Cried, “Do not flee! Do not flee! Do not flee!”"},{"id":"semetey-1-2013:p0836:b003:l001","ordinal":140183,"en":"Their roaring split stone;"},{"id":"semetey-1-2013:p0836:b003:l002","ordinal":140184,"en":"Their shouting split heads."},{"id":"semetey-1-2013:p0836:b003:l003","ordinal":140185,"en":"“Manas’s orphan slave,"},{"id":"semetey-1-2013:p0836:b003:l004","ordinal":140186,"en":"Even if you have forty-five lives,"},{"id":"semetey-1-2013:p0836:b003:l005","ordinal":140187,"en":"Behold the face of Judgment!” they cried."},{"id":"semetey-1-2013:p0836:b003:l006","ordinal":140188,"en":"All the thousand champions"},{"id":"semetey-1-2013:p0836:b003:l007","ordinal":140189,"en":"Leveled their spears together;"},{"id":"semetey-1-2013:p0836:b003:l008","ordinal":140190,"en":"As their signal for battle,"},{"id":"semetey-1-2013:p0836:b003:l009","ordinal":140191,"en":"They beat the drums."},{"id":"semetey-1-2013:p0836:b003:l010","ordinal":140192,"en":"They drew their bows, raining arrows,"},{"id":"semetey-1-2013:p0836:b003:l011","ordinal":140193,"en":"Fired shots like hail."},{"id":"semetey-1-2013:p0836:b003:l012","ordinal":140194,"en":"The champions rushed in separate groups,"},{"id":"semetey-1-2013:p0836:b003:l013","ordinal":140195,"en":"Shouting here and there."},{"id":"semetey-1-2013:p0836:b003:l014","ordinal":140196,"en":"One wing came forward,"},{"id":"semetey-1-2013:p0836:b003:l015","ordinal":140197,"en":"Roaring “Hindustan!”"},{"id":"semetey-1-2013:p0836:b003:l016","ordinal":140198,"en":"Another wing came forward,"},{"id":"semetey-1-2013:p0836:b003:l017","ordinal":140199,"en":"Crying “Chambyl-Bel!”"},{"id":"semetey-1-2013:p0836:b003:l018","ordinal":140200,"en":"The great mass in the center came,"},{"id":"semetey-1-2013:p0836:b003:l019","ordinal":140201,"en":"Crying the battle cry “Kokand!”"},{"id":"semetey-1-2013:p0836:b003:l020","ordinal":140202,"en":"If you looked at this wing,"},{"id":"semetey-1-2013:p0836:b003:l021","ordinal":140203,"en":"They rushed about crying “Samarkand!”"},{"id":"semetey-1-2013:p0836:b003:l022","ordinal":140204,"en":"If you looked at that wing,"},{"id":"semetey-1-2013:p0836:b003:l023","ordinal":140205,"en":"They advanced crying “Andijan!”"},{"id":"semetey-1-2013:p0836:b003:l024","ordinal":140206,"en":"On every side was shouting;"},{"id":"semetey-1-2013:p0836:b003:l025","ordinal":140207,"en":"Observing each of them,"},{"id":"semetey-1-2013:p0836:b003:l026","ordinal":140208,"en":"They cried the battle cries of their own lands."},{"id":"semetey-1-2013:p0836:b003:l027","ordinal":140209,"en":"Semetey stood astonished,"},{"id":"semetey-1-2013:p0836:b003:l029","ordinal":140210,"en":"Shrill cries and fierce rallying shouts,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0836:b003:l030","ordinal":140211,"en":"Their clamor deafening the ears,"},{"id":"semetey-1-2013:p0836:b003:l031","ordinal":140212,"en":"They yelled and leveled their spears,"},{"id":"semetey-1-2013:p0836:b003:l032","ordinal":140213,"en":"As though to reap and gather him,"},{"id":"semetey-1-2013:p0836:b003:l033","ordinal":140214,"en":"Manas’s orphan son—"},{"id":"semetey-1-2013:p0836:b003:l034","ordinal":140215,"en":"As though to cut off his head!"},{"id":"semetey-1-2013:p0836:b003:l035","ordinal":140216,"en":"Striking their horses on the flank,"},{"id":"semetey-1-2013:p0836:b003:l036","ordinal":140217,"en":"The two khans, Janaaly and Karach,"},{"id":"semetey-1-2013:p0836:b003:l037","ordinal":140218,"en":"Reached the boy and attacked."},{"id":"semetey-1-2013:p0836:b003:l038","ordinal":140219,"en":"The two khans, Janaaly and Karach,"},{"id":"semetey-1-2013:p0836:b003:l039","ordinal":140220,"en":"Thrust side by side as they passed."},{"id":"semetey-1-2013:p0836:b004:l001","ordinal":140221,"en":"Was he not Manas’s son?"},{"id":"semetey-1-2013:p0836:b004:l002","ordinal":140222,"en":"Semetey did not bend backward."},{"id":"semetey-1-2013:p0836:b004:l003","ordinal":140223,"en":"Behind the two khans,"},{"id":"semetey-1-2013:p0836:b004:l004","ordinal":140224,"en":"The camel-lifting champions,"},{"id":"semetey-1-2013:p0836:b004:l005","ordinal":140225,"en":"Thirty reached him abreast."},{"id":"semetey-1-2013:p0836:b004:l006","ordinal":140226,"en":"At Manas’s orphan son"},{"id":"semetey-1-2013:p0836:b004:l007","ordinal":140227,"en":"The thirty struck thirty blows as they passed."},{"id":"semetey-1-2013:p0836:b004:l008","ordinal":140228,"en":"Beyond his fierce father Manas,"},{"id":"semetey-1-2013:p0836:b004:l009","ordinal":140229,"en":"Your hero was born greater still."},{"id":"semetey-1-2013:p0836:b004:l010","ordinal":140230,"en":"He took not the slightest notice;"},{"id":"semetey-1-2013:p0836:b004:l011","ordinal":140231,"en":"Though so many spears struck him,"},{"id":"semetey-1-2013:p0836:b004:l012","ordinal":140232,"en":"He counted them as nothing;"},{"id":"semetey-1-2013:p0836:b004:l013","ordinal":140233,"en":"He gave a shrug and took no heed."},{"id":"semetey-1-2013:p0836:b004:l014","ordinal":140234,"en":"Girded with a silver belt,"},{"id":"semetey-1-2013:p0836:b004:l015","ordinal":140235,"en":"His sun-like face bathed in light,"},{"id":"semetey-1-2013:p0836:b004:l016","ordinal":140236,"en":"Girded with a golden belt,"},{"id":"semetey-1-2013:p0836:b004:l017","ordinal":140237,"en":"His moon-like face bathed in light,"},{"id":"semetey-1-2013:p0836:b004:l018","ordinal":140238,"en":"His shovel-like teeth shining white,"},{"id":"semetey-1-2013:p0836:b004:l019","ordinal":140239,"en":"Smiling and standing proudly,"},{"id":"semetey-1-2013:p0836:b004:l020","ordinal":140240,"en":"Semetey held his ground."},{"id":"semetey-1-2013:p0836:b004:l021","ordinal":140241,"en":"After the spearmen thrust and passed,"},{"id":"semetey-1-2013:p0836:b004:l022","ordinal":140242,"en":"The axemen reached him."},{"id":"semetey-1-2013:p0836:b004:l023","ordinal":140243,"en":"Kokand’s twelve formidable champions—"},{"id":"semetey-1-2013:p0836:b004:l024","ordinal":140244,"en":"They were recklessly brave;"},{"id":"semetey-1-2013:p0836:b004:l025","ordinal":140245,"en":"All lunged forward and reached him,"},{"id":"semetey-1-2013:p0836:b004:l026","ordinal":140246,"en":"Striking again and again as they passed."},{"id":"semetey-1-2013:p0836:b004:l027","ordinal":140247,"en":"Semetey stood considering;"},{"id":"semetey-1-2013:p0836:b004:l028","ordinal":140248,"en":"The bloodthirsty hero’s son, that warrior,"},{"id":"semetey-1-2013:p0836:b004:l029","ordinal":140249,"en":"Was seized with anger."},{"id":"semetey-1-2013:p0836:b004:l030","ordinal":140250,"en":"His fiery eyes blazed;"},{"id":"semetey-1-2013:p0836:b004:l031","ordinal":140251,"en":"His thirst for blood took hold."},{"id":"semetey-1-2013:p0836:b004:l032","ordinal":140252,"en":"His white teeth, broad as a door,"},{"id":"semetey-1-2013:p0836:b004:l033","ordinal":140253,"en":"He gnashed with a crack."},{"id":"semetey-1-2013:p0836:b004:l034","ordinal":140254,"en":"The spearmen broke formation,"},{"id":"semetey-1-2013:p0836:b004:l035","ordinal":140255,"en":"Again leveled their spears,"},{"id":"semetey-1-2013:p0836:b004:l036","ordinal":140256,"en":"And made themselves ready."},{"id":"semetey-1-2013:p0836:b004:l037","ordinal":140257,"en":"Joining in a general melee,"},{"id":"semetey-1-2013:p0836:b004:l038","ordinal":140258,"en":"All the Sarts fell upon him."},{"id":"semetey-1-2013:p0836:b004:l039","ordinal":140259,"en":"Devastating bows and painted arrows"},{"id":"semetey-1-2013:p0837:b003:l001","ordinal":140260,"en":"They struck together from every side."},{"id":"semetey-1-2013:p0837:b003:l002","ordinal":140261,"en":"Your orphan, Manas’s son,"},{"id":"semetey-1-2013:p0837:b003:l003","ordinal":140262,"en":"Now had words for the Sarts:"},{"id":"semetey-1-2013:p0837:b003:l004","ordinal":140263,"en":"“Though I left you all in peace,"},{"id":"semetey-1-2013:p0837:b003:l005","ordinal":140264,"en":"You level your spears together,"},{"id":"semetey-1-2013:p0837:b003:l006","ordinal":140265,"en":"Beat me without respite,"},{"id":"semetey-1-2013:p0837:b003:l007","ordinal":140266,"en":"Strike with axes from every side,"},{"id":"semetey-1-2013:p0837:b003:l008","ordinal":140267,"en":"And trouble me so greatly—"},{"id":"semetey-1-2013:p0837:b003:l009","ordinal":140268,"en":"Did I drive off your dun horse and flee?"},{"id":"semetey-1-2013:p0837:b003:l010","ordinal":140269,"en":"You damned Sarts,"},{"id":"semetey-1-2013:p0837:b003:l011","ordinal":140270,"en":"Did I scatter the goods in your saddlebags?"},{"id":"semetey-1-2013:p0837:b003:l012","ordinal":140271,"en":"Did I carry off your piebald horse?"},{"id":"semetey-1-2013:p0837:b003:l013","ordinal":140272,"en":"Did I scatter your precious treasury?"},{"id":"semetey-1-2013:p0837:b003:l014","ordinal":140273,"en":"You attacked first, Muslim;"},{"id":"semetey-1-2013:p0837:b003:l015","ordinal":140274,"en":"Your own guilt be upon you,"},{"id":"semetey-1-2013:p0837:b003:l016","ordinal":140275,"en":"Your suffering upon your own dark head!"},{"id":"semetey-1-2013:p0837:b003:l017","ordinal":140276,"en":"Your thousand champions have gathered;"},{"id":"semetey-1-2013:p0837:b003:l018","ordinal":140277,"en":"Is havoc what you wish for?"},{"id":"semetey-1-2013:p0837:b003:l019","ordinal":140278,"en":"Then see what a spectacle I give you!"},{"id":"semetey-1-2013:p0837:b003:l020","ordinal":140279,"en":"Let me dig your deep pits,"},{"id":"semetey-1-2013:p0837:b003:l021","ordinal":140280,"en":"Let me boil your brine."},{"id":"semetey-1-2013:p0837:b003:l022","ordinal":140281,"en":"Let me show before your eyes"},{"id":"semetey-1-2013:p0837:b003:l023","ordinal":140282,"en":"A marvel no mortal has seen!”"},{"id":"semetey-1-2013:p0837:b003:l024","ordinal":140283,"en":"His anger rising without restraint,"},{"id":"semetey-1-2013:p0837:b003:l025","ordinal":140284,"en":"Exerting himself, bracing for battle,"},{"id":"semetey-1-2013:p0837:b003:l026","ordinal":140285,"en":"He charged the enemy before him."},{"id":"semetey-1-2013:p0837:b003:l027","ordinal":140286,"en":"Watch the hero’s deeds!"},{"id":"semetey-1-2013:p0837:b003:l028","ordinal":140287,"en":"Swaying as though struck by a peri,"},{"id":"semetey-1-2013:p0837:b003:l029","ordinal":140288,"en":"Pouncing like a lion,"}]
