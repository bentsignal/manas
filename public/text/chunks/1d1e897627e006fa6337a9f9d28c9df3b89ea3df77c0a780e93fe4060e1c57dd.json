[{"id":"manas-2010:p0689:b001:l018","ordinal":30721,"en":"This is his tale."},{"id":"manas-2010:p0689:b001:l019","ordinal":30722,"en":"To Alöökö's presence"},{"id":"manas-2010:p0689:b001:l020","ordinal":30723,"en":"No man went back and forth."},{"id":"manas-2010:p0689:b001:l021","ordinal":30724,"en":"That pig was stubborn;"},{"id":"manas-2010:p0689:b001:l022","ordinal":30725,"en":"None who met him escaped death."},{"id":"manas-2010:p0689:b001:l023","ordinal":30726,"en":"He butchered the holy lords and thinned their ranks;"},{"id":"manas-2010:p0689:b001:l024","ordinal":30727,"en":"From Alty-Shaar and Kokon"},{"id":"manas-2010:p0689:b001:l025","ordinal":30728,"en":"He seized the religious masters."},{"id":"manas-2010:p0689:b001:l026","ordinal":30729,"en":"From Alöökö's hands"},{"id":"manas-2010:p0689:b001:l027","ordinal":30730,"en":"None taken prisoner survived."},{"id":"manas-2010:p0689:b001:l028","ordinal":30731,"en":"Day by day it grows stronger,"},{"id":"manas-2010:p0689:b001:l029","ordinal":30732,"en":"The strife of Alöökö."},{"id":"manas-2010:p0689:b001:l030","ordinal":30733,"en":"Alöökö in the white dwelling,"},{"id":"manas-2010:p0689:b001:l031","ordinal":30734,"en":"His fame reached the people;"},{"id":"manas-2010:p0689:b001:l032","ordinal":30735,"en":"Every day it grows greater,"},{"id":"manas-2010:p0689:b001:l033","ordinal":30736,"en":"The trouble of Alöökö."},{"id":"manas-2010:p0689:b001:l034","ordinal":30737,"en":"Piercing cries, shrill battle shouts,"},{"id":"manas-2010:p0689:b001:l035","ordinal":30738,"en":"His menace unmatched, his venom strong—"},{"id":"manas-2010:p0689:b001:l036","ordinal":30739,"en":"If tribute was not promptly paid,"},{"id":"manas-2010:p0689:b001:l037","ordinal":30740,"en":"He slaughtered and butchered and leveled them."},{"id":"manas-2010:p0689:b001:l038","ordinal":30741,"en":"In the city of Margalang"},{"id":"manas-2010:p0689:b001:l039","ordinal":30742,"en":"He has a palace, has a throne."},{"id":"manas-2010:p0689:b001:l040","ordinal":30743,"en":"Thinking of it, we despair of life;"},{"id":"manas-2010:p0689:b001:l041","ordinal":30744,"en":"He has still greater troubles in store."},{"id":"manas-2010:p0689:b001:l042","ordinal":30745,"en":"Before his door"},{"id":"manas-2010:p0690:b001:l001","ordinal":30746,"en":"To throw men into when enraged,"},{"id":"manas-2010:p0690:b001:l002","ordinal":30747,"en":"He has a pit he had dug."},{"id":"manas-2010:p0690:b001:l003","ordinal":30748,"en":"If you look on the farther side,"},{"id":"manas-2010:p0690:b001:l004","ordinal":30749,"en":"Never releasing those who challenge him,"},{"id":"manas-2010:p0690:b001:l005","ordinal":30750,"en":"He has a mighty wrestler kept ready."},{"id":"manas-2010:p0690:b001:l006","ordinal":30751,"en":"To rush upon men when he says 'Attack!'"},{"id":"manas-2010:p0690:b001:l007","ordinal":30752,"en":"He has giants of many kinds."},{"id":"manas-2010:p0690:b001:l008","ordinal":30753,"en":"He has governors, he has khans;"},{"id":"manas-2010:p0690:b001:l009","ordinal":30754,"en":"Before Khan Alöökö"},{"id":"manas-2010:p0690:b001:l010","ordinal":30755,"en":"All the blood-drinkers are there."},{"id":"manas-2010:p0690:b001:l011","ordinal":30756,"en":"Coral hat-plumes, stones of coral,"},{"id":"manas-2010:p0690:b001:l012","ordinal":30757,"en":"In Alöökö's army"},{"id":"manas-2010:p0690:b001:l013","ordinal":30758,"en":"Heroes and wrestlers are mingled."},{"id":"manas-2010:p0690:b001:l014","ordinal":30759,"en":"To the wrestler of powerful wrath"},{"id":"manas-2010:p0690:b001:l015","ordinal":30760,"en":"No man went back and forth;"},{"id":"manas-2010:p0690:b001:l016","ordinal":30761,"en":"From that enraged pig"},{"id":"manas-2010:p0690:b001:l017","ordinal":30762,"en":"None who went returned alive."},{"id":"manas-2010:p0690:b001:l018","ordinal":30763,"en":"Alöökö's wonders—"},{"id":"manas-2010:p0690:b001:l019","ordinal":30764,"en":"Do not ask about their tale."},{"id":"manas-2010:p0690:b001:l020","ordinal":30765,"en":"He has support to rely upon;"},{"id":"manas-2010:p0690:b001:l021","ordinal":30766,"en":"Alöökö is a champion,"},{"id":"manas-2010:p0690:b001:l022","ordinal":30767,"en":"He has a strongly fortified place."},{"id":"manas-2010:p0690:b001:l023","ordinal":30768,"en":"Endless if we told it,"},{"id":"manas-2010:p0690:b001:l024","ordinal":30769,"en":"His tale is worth the world."},{"id":"manas-2010:p0690:b001:l025","ordinal":30770,"en":"He has a coat no bullet pierces;"},{"id":"manas-2010:p0690:b001:l026","ordinal":30771,"en":"That infidel who brings your ruin"},{"id":"manas-2010:p0690:b001:l027","ordinal":30772,"en":"Has an immeasurably dense host."},{"id":"manas-2010:p0690:b001:l028","ordinal":30773,"en":"There are heroes wearing mail,"},{"id":"manas-2010:p0690:b001:l029","ordinal":30774,"en":"Ready to tear apart those who come,"},{"id":"manas-2010:p0690:b001:l030","ordinal":30775,"en":"Calamitous infidels."},{"id":"manas-2010:p0690:b001:l031","ordinal":30776,"en":"Alöökö's wonders,"},{"id":"manas-2010:p0690:b001:l032","ordinal":30777,"en":"Do not ask about the wonders."},{"id":"manas-2010:p0690:b001:l033","ordinal":30778,"en":"Alöökö, whose ways are different,"},{"id":"manas-2010:p0690:b001:l034","ordinal":30779,"en":"His tiger has borne thirteen cubs."},{"id":"manas-2010:p0690:b001:l035","ordinal":30780,"en":"Its voice drives out souls;"},{"id":"manas-2010:p0690:b001:l036","ordinal":30781,"en":"To that hero Alöökö"},{"id":"manas-2010:p0690:b001:l037","ordinal":30782,"en":"No man has come near."},{"id":"manas-2010:p0690:b001:l038","ordinal":30783,"en":"When you go farther,"},{"id":"manas-2010:p0690:b001:l039","ordinal":30784,"en":"Striking people dead,"},{"id":"manas-2010:p0690:b001:l040","ordinal":30785,"en":"He has a sword-snouted elephant."},{"id":"manas-2010:p0690:b001:l041","ordinal":30786,"en":"Alöökö is no ordinary khan;"},{"id":"manas-2010:p0690:b001:l042","ordinal":30787,"en":"My precious Manas, know that."},{"id":"manas-2010:p0691:b001:l001","ordinal":30788,"en":"He has reared a hundred rhinoceroses."},{"id":"manas-2010:p0691:b001:l002","ordinal":30789,"en":"The predators in this world,"},{"id":"manas-2010:p0691:b001:l003","ordinal":30790,"en":"The mighty man has gathered them all."},{"id":"manas-2010:p0691:b001:l004","ordinal":30791,"en":"When you go farther,"},{"id":"manas-2010:p0691:b001:l005","ordinal":30792,"en":"Sucking in those who pass,"},{"id":"manas-2010:p0691:b001:l006","ordinal":30793,"en":"Twelve great black snakes."},{"id":"manas-2010:p0691:b001:l007","ordinal":30794,"en":"When you walk farther,"},{"id":"manas-2010:p0691:b001:l008","ordinal":30795,"en":"Tearing apart those who look,"},{"id":"manas-2010:p0691:b001:l009","ordinal":30796,"en":"He has reared three monstrous tigers."},{"id":"manas-2010:p0691:b001:l010","ordinal":30797,"en":"In a single monstrous tiger"},{"id":"manas-2010:p0691:b001:l011","ordinal":30798,"en":"There is the strength of nine tigers."},{"id":"manas-2010:p0691:b001:l012","ordinal":30799,"en":"Reared as marvels,"},{"id":"manas-2010:p0691:b001:l013","ordinal":30800,"en":"He has bears, he has wolves;"},{"id":"manas-2010:p0691:b001:l014","ordinal":30801,"en":"None who went returned alive,"},{"id":"manas-2010:p0691:b001:l015","ordinal":30802,"en":"He has many calamities."},{"id":"manas-2010:p0691:b001:l016","ordinal":30803,"en":"I fear Alöökö:"},{"id":"manas-2010:p0691:b001:l017","ordinal":30804,"en":"'No man approaches him,' they say,"},{"id":"manas-2010:p0691:b001:l018","ordinal":30805,"en":"'That infidel of cursed fate,"},{"id":"manas-2010:p0691:b001:l019","ordinal":30806,"en":"None who approaches survives.'"},{"id":"manas-2010:p0691:b001:l020","ordinal":30807,"en":"Kozubek of the khan of Kokon,"},{"id":"manas-2010:p0691:b001:l021","ordinal":30808,"en":"Malabek of Margalang,"},{"id":"manas-2010:p0691:b001:l022","ordinal":30809,"en":"Scouted his land and saw it."},{"id":"manas-2010:p0691:b001:l023","ordinal":30810,"en":"The wrestlers who went and saw"},{"id":"manas-2010:p0691:b001:l024","ordinal":30811,"en":"Died with their hearts leaping out."},{"id":"manas-2010:p0691:b001:l025","ordinal":30812,"en":"'You came to a land unawares,' he said;"},{"id":"manas-2010:p0691:b001:l026","ordinal":30813,"en":"Seizing them, Alöökö"},{"id":"manas-2010:p0691:b001:l027","ordinal":30814,"en":"Dealt harshly with them."},{"id":"manas-2010:p0691:b001:l028","ordinal":30815,"en":"'I shall measure and scout his land,' each said,"},{"id":"manas-2010:p0691:b001:l029","ordinal":30816,"en":"And squandered their own wealth."},{"id":"manas-2010:p0691:b001:l030","ordinal":30817,"en":"All who went were slaughtered;"},{"id":"manas-2010:p0691:b001:l031","ordinal":30818,"en":"A few people escaped."},{"id":"manas-2010:p0691:b001:l032","ordinal":30819,"en":"Of the hero Khan Alöökö"},{"id":"manas-2010:p0691:b001:l033","ordinal":30820,"en":"Everyone learned the news."},{"id":"manas-2010:p0691:b001:l034","ordinal":30821,"en":"The people who went there,"},{"id":"manas-2010:p0691:b001:l035","ordinal":30822,"en":"As though stricken by slaughter,"},{"id":"manas-2010:p0691:b001:l036","ordinal":30823,"en":"Were shattered and died together."},{"id":"manas-2010:p0691:b001:l037","ordinal":30824,"en":"As if he would reach their very roots,"},{"id":"manas-2010:p0691:b001:l038","ordinal":30825,"en":"As if he would slaughter them utterly."},{"id":"manas-2010:p0691:b001:l039","ordinal":30826,"en":"Alöökö's army,"},{"id":"manas-2010:p0691:b001:l040","ordinal":30827,"en":"When it marches, dust rises."},{"id":"manas-2010:p0691:b001:l041","ordinal":30828,"en":"'Alöökö will unleash his wrath,' they say;"},{"id":"manas-2010:p0691:b001:l042","ordinal":30829,"en":"The thought drives the soul from a person."},{"id":"manas-2010:p0692:b001:l001","ordinal":30830,"en":"Dwelling in Anzhyian,"},{"id":"manas-2010:p0692:b001:l002","ordinal":30831,"en":"I am Father Aykozho."},{"id":"manas-2010:p0692:b001:l003","ordinal":30832,"en":"Since coming, I have heard the news:"},{"id":"manas-2010:p0692:b001:l004","ordinal":30833,"en":"Gathering his people and taking land,"},{"id":"manas-2010:p0692:b001:l005","ordinal":30834,"en":"The slaughterer Manas, the leopard,"},{"id":"manas-2010:p0692:b001:l006","ordinal":30835,"en":"Had come to Talas, I heard."},{"id":"manas-2010:p0692:b001:l007","ordinal":30836,"en":"Alöökö is the one you must fight;"},{"id":"manas-2010:p0692:b001:l008","ordinal":30837,"en":"Inflict abundant slaughter."},{"id":"manas-2010:p0692:b001:l009","ordinal":30838,"en":"The famed sacred capital of sheikhs,"},{"id":"manas-2010:p0692:b001:l010","ordinal":30839,"en":"Great Kokon and Margalang—"},{"id":"manas-2010:p0692:b001:l011","ordinal":30840,"en":"If you are truly a hero,"},{"id":"manas-2010:p0692:b001:l012","ordinal":30841,"en":"From Alöökö's hands"},{"id":"manas-2010:p0692:b001:l013","ordinal":30842,"en":"Set them free."},{"id":"manas-2010:p0692:b001:l014","ordinal":30843,"en":"Alöökö is the one you must battle;"},{"id":"manas-2010:p0692:b001:l015","ordinal":30844,"en":"For your small Muslim people"},{"id":"manas-2010:p0692:b001:l016","ordinal":30845,"en":"Now find a way!'"},{"id":"manas-2010:p0692:b001:l017","ordinal":30846,"en":"Aykozho in a striped robe"},{"id":"manas-2010:p0692:b001:l018","ordinal":30847,"en":"Stood saying these words."},{"id":"manas-2010:p0692:b001:l019","ordinal":30848,"en":"Khan Manas's forty companions,"},{"id":"manas-2010:p0692:b001:l020","ordinal":30849,"en":"With precious Bakay at their head,"},{"id":"manas-2010:p0692:b001:l021","ordinal":30850,"en":"Thundered to and fro."},{"id":"manas-2010:p0692:b001:l022","ordinal":30851,"en":"Alöökö was the one to grapple with;"},{"id":"manas-2010:p0692:b001:l023","ordinal":30852,"en":"The mass of people stirred now."},{"id":"manas-2010:p0692:b001:l024","ordinal":30853,"en":"Unwearied by six months of riding,"},{"id":"manas-2010:p0692:b001:l025","ordinal":30854,"en":"Your magnanimous one's Akkula—"},{"id":"manas-2010:p0692:b001:l026","ordinal":30855,"en":"To Küldür and Boz Uul, the capable lads,"},{"id":"manas-2010:p0692:b001:l027","ordinal":30856,"en":"He looked with a proud bearing,"},{"id":"manas-2010:p0692:b001:l028","ordinal":30857,"en":"Had the great dun horse saddled."},{"id":"manas-2010:p0692:b001:l029","ordinal":30858,"en":"The leopard grew wrathful,"},{"id":"manas-2010:p0692:b001:l030","ordinal":30859,"en":"Frightening the populace."},{"id":"manas-2010:p0692:b001:l031","ordinal":30860,"en":"At the sight, their attention was drawn,"},{"id":"manas-2010:p0692:b001:l032","ordinal":30861,"en":"His wolf-maned nature showed."},{"id":"manas-2010:p0692:b001:l033","ordinal":30862,"en":"Such is the manner of the great beast—"},{"id":"manas-2010:p0692:b001:l034","ordinal":30863,"en":"His aspect different, his venom strong,"},{"id":"manas-2010:p0692:b001:l035","ordinal":30864,"en":"His heroism unlike any other,"},{"id":"manas-2010:p0692:b001:l036","ordinal":30865,"en":"The marked hero of surpassing fortune"},{"id":"manas-2010:p0692:b001:l037","ordinal":30866,"en":"Lays low those who fight him."},{"id":"manas-2010:p0692:b001:l038","ordinal":30867,"en":"While the hero stood like this,"},{"id":"manas-2010:p0692:b001:l039","ordinal":30868,"en":"His uncle, wolf-maned Bakay,"},{"id":"manas-2010:p0692:b001:l040","ordinal":30869,"en":"Mounted the gray winged steed and prepared."},{"id":"manas-2010:p0692:b001:l041","ordinal":30870,"en":"From your uncle, wolf-maned Bakay,"},{"id":"manas-2010:p0692:b001:l042","ordinal":30871,"en":"Much counsel came forth:"},{"id":"manas-2010:p0693:b001:l001","ordinal":30872,"en":"'Alöökö in the white dwelling"},{"id":"manas-2010:p0693:b001:l002","ordinal":30873,"en":"Has imprisoned many souls,"},{"id":"manas-2010:p0693:b001:l003","ordinal":30874,"en":"Has taken much of their property."},{"id":"manas-2010:p0693:b001:l004","ordinal":30875,"en":"Those who swaggered in defiance,"},{"id":"manas-2010:p0693:b001:l005","ordinal":30876,"en":"He has slaughtered them."},{"id":"manas-2010:p0693:b001:l006","ordinal":30877,"en":"Alöökö has grown excited;"},{"id":"manas-2010:p0693:b001:l007","ordinal":30878,"en":"Let us go to that daughter-damned bastard,"},{"id":"manas-2010:p0693:b001:l008","ordinal":30879,"en":"Let us slaughter one another."},{"id":"manas-2010:p0693:b001:l009","ordinal":30880,"en":"Against that hero Alöökö,"},{"id":"manas-2010:p0693:b001:l010","ordinal":30881,"en":"If our skill suffices and strength prevails,"},{"id":"manas-2010:p0693:b001:l011","ordinal":30882,"en":"Alty-Shaar and Margalang,"},{"id":"manas-2010:p0693:b001:l012","ordinal":30883,"en":"As far as Kokon and Samarkan,"},{"id":"manas-2010:p0693:b001:l013","ordinal":30884,"en":"From the enemy raging mad,"},{"id":"manas-2010:p0693:b001:l014","ordinal":30885,"en":"Let us set them free!"},{"id":"manas-2010:p0693:b001:l015","ordinal":30886,"en":"Before the supple dry stalks ripen,"},{"id":"manas-2010:p0693:b001:l016","ordinal":30887,"en":"Before the autumn gossamer flies,"},{"id":"manas-2010:p0693:b001:l017","ordinal":30888,"en":"Let us go to that pig."},{"id":"manas-2010:p0693:b001:l018","ordinal":30889,"en":"Standing with spears against each other,"},{"id":"manas-2010:p0693:b001:l019","ordinal":30890,"en":"Shouting and fighting,"},{"id":"manas-2010:p0693:b001:l020","ordinal":30891,"en":"Firing small cannon and drawing bows,"},{"id":"manas-2010:p0693:b001:l021","ordinal":30892,"en":"Let us raise fierce strife."},{"id":"manas-2010:p0693:b001:l022","ordinal":30893,"en":"From that boar who burns your soul,"},{"id":"manas-2010:p0693:b001:l023","ordinal":30894,"en":"The small people who are burning,"},{"id":"manas-2010:p0693:b001:l024","ordinal":30895,"en":"Let us set them free!"},{"id":"manas-2010:p0693:b001:l025","ordinal":30896,"en":"Let us inflict great grief."},{"id":"manas-2010:p0693:b001:l026","ordinal":30897,"en":"Alöökö has grown powerful;"},{"id":"manas-2010:p0693:b001:l027","ordinal":30898,"en":"Let us clash and rage together."},{"id":"manas-2010:p0693:b001:l028","ordinal":30899,"en":"Alöökö of surpassing venom,"},{"id":"manas-2010:p0693:b001:l029","ordinal":30900,"en":"Let us go shouting at him,"},{"id":"manas-2010:p0693:b001:l030","ordinal":30901,"en":"Let us make a wondrous slaughter."},{"id":"manas-2010:p0693:b001:l031","ordinal":30902,"en":"All the forty companions,"},{"id":"manas-2010:p0693:b001:l032","ordinal":30903,"en":"Their elders Kyrgyl and Bakay,"},{"id":"manas-2010:p0693:b001:l033","ordinal":30904,"en":"As though stricken by slaughter,"},{"id":"manas-2010:p0693:b001:l034","ordinal":30905,"en":"Against that daughter-damned pig,"},{"id":"manas-2010:p0693:b001:l035","ordinal":30906,"en":"Let us fall shattered together!"},{"id":"manas-2010:p0693:b001:l036","ordinal":30907,"en":"Your father's grave, forty companions!"},{"id":"manas-2010:p0693:b001:l037","ordinal":30908,"en":"Not forty warriors—forty drinking friends!"},{"id":"manas-2010:p0693:b001:l038","ordinal":30909,"en":"Since coming to this Talas,"},{"id":"manas-2010:p0693:b001:l039","ordinal":30910,"en":"Whenever your bellies grew hungry,"},{"id":"manas-2010:p0693:b001:l040","ordinal":30911,"en":"You kept cutting and eating horse-rump meat."},{"id":"manas-2010:p0693:b001:l041","ordinal":30912,"en":"'If Manas is beside me,' you said,"},{"id":"manas-2010:p0693:b001:l042","ordinal":30913,"en":"All of you clamoring together,"},{"id":"manas-2010:p0694:b001:l001","ordinal":30914,"en":"'I will overthrow the governor-general,' you kept saying."},{"id":"manas-2010:p0694:b001:l002","ordinal":30915,"en":"Whenever your stomachs grew hungry,"},{"id":"manas-2010:p0694:b001:l003","ordinal":30916,"en":"Forty companions, full of wrath,"},{"id":"manas-2010:p0694:b001:l004","ordinal":30917,"en":"You kept cutting and eating horse-belly fat."},{"id":"manas-2010:p0694:b001:l005","ordinal":30918,"en":"'If Manas is beside me,"},{"id":"manas-2010:p0694:b001:l006","ordinal":30919,"en":"I will overthrow the governor,' you kept saying."},{"id":"manas-2010:p0694:b001:l007","ordinal":30920,"en":"God loved you, fortune drove you,"},{"id":"manas-2010:p0694:b001:l008","ordinal":30921,"en":"Prosperity and luck came before you."},{"id":"manas-2010:p0694:b001:l009","ordinal":30922,"en":"For your elders Kyrgyl and Bakay,"},{"id":"manas-2010:p0694:b001:l010","ordinal":30923,"en":"The time has come to be slaughtered."},{"id":"manas-2010:p0694:b001:l011","ordinal":30924,"en":"The horses grew fat and fit,"},{"id":"manas-2010:p0694:b001:l012","ordinal":30925,"en":"The men grew fat and stifled."},{"id":"manas-2010:p0694:b001:l013","ordinal":30926,"en":"Know that upon Prince Manas"},{"id":"manas-2010:p0694:b001:l014","ordinal":30927,"en":"Fortune like Ala-Too has settled."},{"id":"manas-2010:p0694:b001:l015","ordinal":30928,"en":"Eager lads and swift horses,"},{"id":"manas-2010:p0694:b001:l016","ordinal":30929,"en":"The time has come for them to be useful."},{"id":"manas-2010:p0694:b001:l017","ordinal":30930,"en":"Alöökö, who acts the lord,"},{"id":"manas-2010:p0694:b001:l018","ordinal":30931,"en":"They call him a great khan of the Chinese."},{"id":"manas-2010:p0694:b001:l019","ordinal":30932,"en":"Alty-Shaar and Margalang,"},{"id":"manas-2010:p0694:b001:l020","ordinal":30933,"en":"At the farther end Samarkan,"},{"id":"manas-2010:p0694:b001:l021","ordinal":30934,"en":"Between those two"},{"id":"manas-2010:p0694:b001:l022","ordinal":30935,"en":"He has established his white dwelling."},{"id":"manas-2010:p0694:b001:l023","ordinal":30936,"en":"Abundant wealth and many livestock,"},{"id":"manas-2010:p0694:b001:l024","ordinal":30937,"en":"He has taken them by force."},{"id":"manas-2010:p0694:b001:l025","ordinal":30938,"en":"He throws those who challenge him into turmoil;"},{"id":"manas-2010:p0694:b001:l026","ordinal":30939,"en":"A khan of formidable fame, they say."},{"id":"manas-2010:p0694:b001:l027","ordinal":30940,"en":"Alöökö himself"},{"id":"manas-2010:p0694:b001:l028","ordinal":30941,"en":"Has, born of his own body,"},{"id":"manas-2010:p0694:b001:l029","ordinal":30942,"en":"Sixty sons, they say."},{"id":"manas-2010:p0694:b001:l030","ordinal":30943,"en":"Terrible in menace, strong in venom,"},{"id":"manas-2010:p0694:b001:l031","ordinal":30944,"en":"Such is the news of Alöökö."},{"id":"manas-2010:p0694:b001:l032","ordinal":30945,"en":"Let us go closer;"},{"id":"manas-2010:p0694:b001:l033","ordinal":30946,"en":"With that fiercely raging dog,"},{"id":"manas-2010:p0694:b001:l034","ordinal":30947,"en":"Let us wage a savage battle."},{"id":"manas-2010:p0694:b001:l035","ordinal":30948,"en":"'The khan heard the news,' he said."},{"id":"manas-2010:p0694:b001:l036","ordinal":30949,"en":"'In Alöökö's army"},{"id":"manas-2010:p0694:b001:l037","ordinal":30950,"en":"There are wrestlers held ready,' he said."},{"id":"manas-2010:p0694:b001:l038","ordinal":30951,"en":"Against that domineering infidel"},{"id":"manas-2010:p0694:b001:l039","ordinal":30952,"en":"Let us stand face to face."},{"id":"manas-2010:p0694:b001:l040","ordinal":30953,"en":"Grappling with that dog,"},{"id":"manas-2010:p0694:b001:l041","ordinal":30954,"en":"Let us chase him as far as Kakan."},{"id":"manas-2010:p0694:b001:l042","ordinal":30955,"en":"Grappling and fighting,"},{"id":"manas-2010:p0695:b001:l001","ordinal":30956,"en":"Alöökö has grown powerful—"},{"id":"manas-2010:p0695:b001:l002","ordinal":30957,"en":"Let us drive his fury far away."},{"id":"manas-2010:p0695:b001:l003","ordinal":30958,"en":"'Wait,' he says, with his wonders;"},{"id":"manas-2010:p0695:b001:l004","ordinal":30959,"en":"Let us imprison him among the wonders."},{"id":"manas-2010:p0695:b001:l005","ordinal":30960,"en":"If you want possessions, there they are."},{"id":"manas-2010:p0695:b001:l006","ordinal":30961,"en":"Your father's grave, forty companions,"},{"id":"manas-2010:p0695:b001:l007","ordinal":30962,"en":"Let us plunder his gold."},{"id":"manas-2010:p0695:b001:l008","ordinal":30963,"en":"Even if you searched six months without rest,"},{"id":"manas-2010:p0695:b001:l009","ordinal":30964,"en":"You would not find such an opponent."},{"id":"manas-2010:p0695:b001:l010","ordinal":30965,"en":"With the slaughterer leading, forty companions,"},{"id":"manas-2010:p0695:b001:l011","ordinal":30966,"en":"Let us go ourselves,"},{"id":"manas-2010:p0695:b001:l012","ordinal":30967,"en":"A great, incurable uproar"},{"id":"manas-2010:p0695:b001:l013","ordinal":30968,"en":"Let us inflict on Alöökö."},{"id":"manas-2010:p0695:b001:l014","ordinal":30969,"en":"The winged steed he rides scouting,"},{"id":"manas-2010:p0695:b001:l015","ordinal":30970,"en":"Let us make it unable to trot."},{"id":"manas-2010:p0695:b001:l016","ordinal":30971,"en":"That daughter-damned pig,"},{"id":"manas-2010:p0695:b001:l017","ordinal":30972,"en":"Back here from Kakan,"},{"id":"manas-2010:p0695:b001:l018","ordinal":30973,"en":"Let us make him unable to return!"},{"id":"manas-2010:p0695:b001:l019","ordinal":30974,"en":"All of us advancing,"},{"id":"manas-2010:p0695:b001:l020","ordinal":30975,"en":"While hero Manas is here,"},{"id":"manas-2010:p0695:b001:l021","ordinal":30976,"en":"Let us bind them by their fetlocks,"}]
