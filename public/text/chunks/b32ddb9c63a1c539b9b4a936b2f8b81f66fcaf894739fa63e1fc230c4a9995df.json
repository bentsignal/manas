[{"id":"seytek-2012:p0925:b003:l015","ordinal":366593,"en":"Her bare white teeth"},{"id":"seytek-2012:p0925:b003:l016","ordinal":366594,"en":"Gnashed again and again,"},{"id":"seytek-2012:p0925:b003:l017","ordinal":366595,"en":"And her lion eyes blazed."},{"id":"seytek-2012:p0925:b003:l018","ordinal":366596,"en":"She slung the Adi-makpys bag"},{"id":"seytek-2012:p0925:b003:l019","ordinal":366597,"en":"Across herself and sprang forth."},{"id":"seytek-2012:p0925:b003:l020","ordinal":366598,"en":"Zhelzhetpes beneath her"},{"id":"seytek-2012:p0925:b003:l021","ordinal":366599,"en":"Was covered with a caparison;"},{"id":"seytek-2012:p0925:b003:l022","ordinal":366600,"en":"She tightened the flank girth firmly"},{"id":"seytek-2012:p0925:b003:l023","ordinal":366601,"en":"And drew the crupper tight."},{"id":"seytek-2012:p0925:b003:l024","ordinal":366602,"en":"Her eyes reddened like a wild ram's;"},{"id":"seytek-2012:p0925:b003:l025","ordinal":366603,"en":"The beautiful Kuyaly"},{"id":"seytek-2012:p0925:b003:l026","ordinal":366604,"en":"Shone like the rising moon."},{"id":"seytek-2012:p0925:b003:l027","ordinal":366605,"en":"Her human qualities were unmatched,"},{"id":"seytek-2012:p0925:b003:l028","ordinal":366606,"en":"A peerless wonder surpassing the world."},{"id":"seytek-2012:p0925:b003:l029","ordinal":366607,"en":"Sarybai was the one she would face;"},{"id":"seytek-2012:p0925:b003:l030","ordinal":366608,"en":"Such was her valor."},{"id":"seytek-2012:p0925:b003:l031","ordinal":366609,"en":"Time and time again,"},{"id":"seytek-2012:p0925:b003:l032","ordinal":366610,"en":"They had shattered lances in combat,"},{"id":"seytek-2012:p0925:b003:l033","ordinal":366611,"en":"Torn at each other many times,"},{"id":"seytek-2012:p0925:b003:l034","ordinal":366612,"en":"Until strength left their apple-round heads"},{"id":"seytek-2012:p0925:b003:l035","ordinal":366613,"en":"And blood drained from their fair bodies;"},{"id":"seytek-2012:p0925:b003:l036","ordinal":366614,"en":"Thus had they fought each other."},{"id":"seytek-2012:p0925:b003:l037","ordinal":366615,"en":"They climbed the ridge and faced one another,"},{"id":"seytek-2012:p0925:b003:l038","ordinal":366616,"en":"Calling and dividing their forces."},{"id":"seytek-2012:p0925:b003:l039","ordinal":366617,"en":"Time and time again,"},{"id":"seytek-2012:p0925:b003:l040","ordinal":366618,"en":"They had battled to the death,"},{"id":"seytek-2012:p0926:b002:l001","ordinal":366619,"en":"Against enemies they encountered,"},{"id":"seytek-2012:p0926:b002:l002","ordinal":366620,"en":"Against exceedingly wrathful warriors,"},{"id":"seytek-2012:p0926:b002:l003","ordinal":366621,"en":"Against overbearing champions."},{"id":"seytek-2012:p0926:b002:l004","ordinal":366622,"en":"Into the monster's black eyes,"},{"id":"seytek-2012:p0926:b002:l005","ordinal":366623,"en":"Ready to die if death arrived,"},{"id":"seytek-2012:p0926:b002:l006","ordinal":366624,"en":"If the Almighty desired her life,"},{"id":"seytek-2012:p0926:b002:l007","ordinal":366625,"en":"Ready to surrender her entrusted soul,"},{"id":"seytek-2012:p0926:b002:l008","ordinal":366626,"en":"Ready to unleash a mighty battle—"},{"id":"seytek-2012:p0926:b002:l009","ordinal":366627,"en":"She, offspring of lionhearted heroes,"},{"id":"seytek-2012:p0926:b002:l010","ordinal":366628,"en":"Sought from the fierce one's hands,"},{"id":"seytek-2012:p0926:b002:l011","ordinal":366629,"en":"From death's opposing snare,"},{"id":"seytek-2012:p0926:b002:l012","ordinal":366630,"en":"From that great menace and mighty venom,"},{"id":"seytek-2012:p0926:b002:l013","ordinal":366631,"en":"From Sarybai's hands,"},{"id":"seytek-2012:p0926:b002:l014","ordinal":366632,"en":"To wrest her people free."},{"id":"seytek-2012:p0926:b002:l015","ordinal":366633,"en":"This was the mighty tumult,"},{"id":"seytek-2012:p0926:b002:l016","ordinal":366634,"en":"To be unleashed upon Sarybai:"},{"id":"seytek-2012:p0926:b002:l017","ordinal":366635,"en":"To meet him face-to-face,"},{"id":"seytek-2012:p0926:b002:l018","ordinal":366636,"en":"And clash in crushing combat."},{"id":"seytek-2012:p0926:b002:l019","ordinal":366637,"en":"Her eager eyes burned fiercely;"},{"id":"seytek-2012:p0926:b002:l020","ordinal":366638,"en":"Alas, the champion Kuyaly"},{"id":"seytek-2012:p0926:b002:l021","ordinal":366639,"en":"Watched with both eyes doubled,"},{"id":"seytek-2012:p0926:b002:l022","ordinal":366640,"en":"And wrathfully made ready."},{"id":"seytek-2012:p0926:b002:l023","ordinal":366641,"en":"She put on all her battle gear,"},{"id":"seytek-2012:p0926:b002:l024","ordinal":366642,"en":"Strapped on her naked sword,"},{"id":"seytek-2012:p0926:b002:l025","ordinal":366643,"en":"And leveled a gleaming spear,"},{"id":"seytek-2012:p0926:b002:l026","ordinal":366644,"en":"Ready once more."},{"id":"seytek-2012:p0926:b002:l027","ordinal":366645,"en":"She seized the black-shafted weighted whip"},{"id":"seytek-2012:p0926:b002:l028","ordinal":366646,"en":"And swung it around;"},{"id":"seytek-2012:p0926:b002:l029","ordinal":366647,"en":"Zhelzhetpes, swift as a boat,"},{"id":"seytek-2012:p0926:b002:l030","ordinal":366648,"en":"She gripped tightly with her knees."},{"id":"seytek-2012:p0926:b002:l031","ordinal":366649,"en":"Crying “Allah!” she raised her spear"},{"id":"seytek-2012:p0926:b002:l032","ordinal":366650,"en":"And charged straight at Sarybai;"},{"id":"seytek-2012:p0926:b002:l033","ordinal":366651,"en":"Now she made the struggle fierce."},{"id":"seytek-2012:p0926:b002:l034","ordinal":366652,"en":"The war drum was the signal of battle;"},{"id":"seytek-2012:p0926:b002:l035","ordinal":366653,"en":"Such was that war drum:"},{"id":"seytek-2012:p0926:b002:l036","ordinal":366654,"en":"It was made of elephant hide,"},{"id":"seytek-2012:p0926:b002:l037","ordinal":366655,"en":"And when struck once with a battle-axe,"},{"id":"seytek-2012:p0926:b002:l038","ordinal":366656,"en":"The very heavens seemed to shift,"},{"id":"seytek-2012:p0926:b002:l039","ordinal":366657,"en":"And the breadth of the earth resounded."},{"id":"seytek-2012:p0926:b002:l040","ordinal":366658,"en":"In battle, champions fled before it;"},{"id":"seytek-2012:p0926:b003:l001","ordinal":366659,"en":"It was the army's foremost shield,"},{"id":"seytek-2012:p0926:b003:l002","ordinal":366660,"en":"The herald of Kuyaly's battle."},{"id":"seytek-2012:p0926:b003:l003","ordinal":366661,"en":"When she struck the war drum,"},{"id":"seytek-2012:p0926:b003:l004","ordinal":366662,"en":"Her stalwart champions followed behind."},{"id":"seytek-2012:p0926:b003:l005","ordinal":366663,"en":"After giving this signal,"},{"id":"seytek-2012:p0926:b003:l006","ordinal":366664,"en":"She drove her deep-throated, secret spear"},{"id":"seytek-2012:p0926:b003:l007","ordinal":366665,"en":"Forward with a thunderous blow;"},{"id":"seytek-2012:p0926:b003:l008","ordinal":366666,"en":"Even that failed to bring him down,"},{"id":"seytek-2012:p0926:b003:l009","ordinal":366667,"en":"So she struck again with a roar."},{"id":"seytek-2012:p0926:b003:l010","ordinal":366668,"en":"The earth broke into clouds of dust,"},{"id":"seytek-2012:p0926:b003:l011","ordinal":366669,"en":"And all who saw it were bewildered."},{"id":"seytek-2012:p0926:b003:l012","ordinal":366670,"en":"Every warrior grew excited,"},{"id":"seytek-2012:p0926:b003:l013","ordinal":366671,"en":"Every hero was stirred;"},{"id":"seytek-2012:p0926:b003:l014","ordinal":366672,"en":"The courageous and lionhearted"},{"id":"seytek-2012:p0926:b003:l015","ordinal":366673,"en":"Showed the valor with which they entered holy war."},{"id":"seytek-2012:p0926:b003:l016","ordinal":366674,"en":"It became known to all the people,"},{"id":"seytek-2012:p0926:b003:l017","ordinal":366675,"en":"And the people despaired of life"},{"id":"seytek-2012:p0926:b003:l018","ordinal":366676,"en":"As they crowded around to watch."},{"id":"seytek-2012:p0926:b003:l019","ordinal":366677,"en":"Then Kuyaly"},{"id":"seytek-2012:p0926:b003:l020","ordinal":366678,"en":"Buttoned her armor over her whole body"},{"id":"seytek-2012:p0926:b003:l021","ordinal":366679,"en":"And covered her full face."},{"id":"seytek-2012:p0926:b003:l022","ordinal":366680,"en":"Her lionhearted nature became clear;"},{"id":"seytek-2012:p0926:b003:l023","ordinal":366681,"en":"She donned arrow-proof steel."},{"id":"seytek-2012:p0926:b003:l024","ordinal":366682,"en":"She rejoiced at the word “enemy”;"},{"id":"seytek-2012:p0926:b003:l025","ordinal":366683,"en":"The warrior maiden by name"},{"id":"seytek-2012:p0926:b003:l026","ordinal":366684,"en":"Unleashed a great battle."},{"id":"seytek-2012:p0926:b003:l027","ordinal":366685,"en":"What regret could such a noble soul have?"},{"id":"seytek-2012:p0926:b003:l028","ordinal":366686,"en":"Her valor was renowned,"},{"id":"seytek-2012:p0926:b003:l029","ordinal":366687,"en":"Her wolf-like courage plain to see."},{"id":"seytek-2012:p0926:b003:l030","ordinal":366688,"en":"At the sight of the foe, her eyes blazed;"},{"id":"seytek-2012:p0926:b003:l031","ordinal":366689,"en":"Bloodlust gripped her firmly,"},{"id":"seytek-2012:p0926:b003:l032","ordinal":366690,"en":"And she ground her teeth with a crack."},{"id":"seytek-2012:p0926:b003:l033","ordinal":366691,"en":"Her apple-round neck stretched,"},{"id":"seytek-2012:p0926:b003:l034","ordinal":366692,"en":"Her eyes reddened like a lion's;"},{"id":"seytek-2012:p0926:b003:l035","ordinal":366693,"en":"She girded her slender waist,"},{"id":"seytek-2012:p0926:b003:l036","ordinal":366694,"en":"Cantered forth and left the army."},{"id":"seytek-2012:p0926:b003:l037","ordinal":366695,"en":"Her bearing and majesty,"},{"id":"seytek-2012:p0926:b003:l038","ordinal":366696,"en":"Her proud and fearsome countenance,"},{"id":"seytek-2012:p0926:b003:l039","ordinal":366697,"en":"Made her seem like a ravening beast."},{"id":"seytek-2012:p0926:b003:l040","ordinal":366698,"en":"She took up her weapons, eager for battle."},{"id":"seytek-2012:p0927:b002:l001","ordinal":366699,"en":"Glancing to either side,"},{"id":"seytek-2012:p0927:b002:l002","ordinal":366700,"en":"The fierce warrior of old"},{"id":"seytek-2012:p0927:b002:l003","ordinal":366701,"en":"Licked her lips,"},{"id":"seytek-2012:p0927:b002:l004","ordinal":366702,"en":"Writhing like a dragon,"},{"id":"seytek-2012:p0927:b002:l005","ordinal":366703,"en":"Crouching like a lion,"},{"id":"seytek-2012:p0927:b002:l006","ordinal":366704,"en":"Gathering her wrath and making ready,"},{"id":"seytek-2012:p0927:b002:l007","ordinal":366705,"en":"She prayed to the Creator:"},{"id":"seytek-2012:p0927:b002:l008","ordinal":366706,"en":"“Let me spill the madman’s blood;"},{"id":"seytek-2012:p0927:b002:l009","ordinal":366707,"en":"Do not let me be utterly disgraced,"},{"id":"seytek-2012:p0927:b002:l010","ordinal":366708,"en":"God, grant me honor."},{"id":"seytek-2012:p0927:b002:l011","ordinal":366709,"en":"If at the madman’s hands"},{"id":"seytek-2012:p0927:b002:l012","ordinal":366710,"en":"I fall, I shall die without renown;"},{"id":"seytek-2012:p0927:b002:l013","ordinal":366711,"en":"‘The wretched champion died,’ they will say,"},{"id":"seytek-2012:p0927:b002:l014","ordinal":366712,"en":"And I have no people to bury me with honor."},{"id":"seytek-2012:p0927:b002:l015","ordinal":366713,"en":"My heart is heavy, my breast aflame;"},{"id":"seytek-2012:p0927:b002:l016","ordinal":366714,"en":"No grief is worse than sorrow."},{"id":"seytek-2012:p0927:b002:l017","ordinal":366715,"en":"Almighty God, Creator,"},{"id":"seytek-2012:p0927:b002:l018","ordinal":366716,"en":"There is no recourse but You."},{"id":"seytek-2012:p0927:b002:l019","ordinal":366717,"en":"Sarybay is the one I shall confront;"},{"id":"seytek-2012:p0927:b002:l020","ordinal":366718,"en":"I have begun a savage fight."},{"id":"seytek-2012:p0927:b002:l021","ordinal":366719,"en":"I have no kin to gird my waist,"},{"id":"seytek-2012:p0927:b002:l022","ordinal":366720,"en":"No trusted comrades at my side,"},{"id":"seytek-2012:p0927:b002:l023","ordinal":366721,"en":"No people in whom to place my hope."},{"id":"seytek-2012:p0927:b002:l024","ordinal":366722,"en":"Against this infidel in his full strength"},{"id":"seytek-2012:p0927:b002:l025","ordinal":366723,"en":"I have entered combat—God, aid me!"},{"id":"seytek-2012:p0927:b002:l026","ordinal":366724,"en":"We are but women by name;"},{"id":"seytek-2012:p0927:b002:l027","ordinal":366725,"en":"God, aid this sorrowing one!”"},{"id":"seytek-2012:p0927:b002:l028","ordinal":366726,"en":"So saying, Kuyaly"},{"id":"seytek-2012:p0927:b002:l029","ordinal":366727,"en":"Did not glance around,"},{"id":"seytek-2012:p0927:b002:l030","ordinal":366728,"en":"Never thinking she might die,"},{"id":"seytek-2012:p0927:b002:l031","ordinal":366729,"en":"Did not look from side to side,"},{"id":"seytek-2012:p0927:b002:l032","ordinal":366730,"en":"And spared not her thread-thin life."},{"id":"seytek-2012:p0927:b002:l033","ordinal":366731,"en":"Beneath her was Zhelzhetpes;"},{"id":"seytek-2012:p0927:b002:l034","ordinal":366732,"en":"She drove him right and left,"},{"id":"seytek-2012:p0927:b002:l035","ordinal":366733,"en":"Lashing him on either flank."},{"id":"seytek-2012:p0927:b002:l036","ordinal":366734,"en":"At her cry the charger thundered,"},{"id":"seytek-2012:p0927:b002:l037","ordinal":366735,"en":"And wherever his body struck,"},{"id":"seytek-2012:p0927:b002:l038","ordinal":366736,"en":"The earth burst into ridges."},{"id":"seytek-2012:p0927:b002:l039","ordinal":366737,"en":"The warrior maiden upon him,"},{"id":"seytek-2012:p0927:b002:l040","ordinal":366738,"en":"Whose opponent was Sarybay,"},{"id":"seytek-2012:p0927:b003:l001","ordinal":366739,"en":"Faced a notorious foe such as this."},{"id":"seytek-2012:p0927:b003:l002","ordinal":366740,"en":"Her charger gathered beneath her,"},{"id":"seytek-2012:p0927:b003:l003","ordinal":366741,"en":"While the warrior maiden above"},{"id":"seytek-2012:p0927:b003:l004","ordinal":366742,"en":"Frowned without blinking,"},{"id":"seytek-2012:p0927:b003:l005","ordinal":366743,"en":"Laughed aloud in delight,"},{"id":"seytek-2012:p0927:b003:l006","ordinal":366744,"en":"And rode on blithely, ringing like steel."},{"id":"seytek-2012:p0927:b003:l007","ordinal":366745,"en":"Though they called Sarybay a champion,"},{"id":"seytek-2012:p0927:b003:l008","ordinal":366746,"en":"She did not count him worth her boot-tip."},{"id":"seytek-2012:p0927:b003:l009","ordinal":366747,"en":"Courage and lionheartedness,"},{"id":"seytek-2012:p0927:b003:l010","ordinal":366748,"en":"Cunning and dexterity,"},{"id":"seytek-2012:p0927:b003:l011","ordinal":366749,"en":"A mind well cultivated and eyes keen,"},{"id":"seytek-2012:p0927:b003:l012","ordinal":366750,"en":"And unstinting inspiration—"},{"id":"seytek-2012:p0927:b003:l013","ordinal":366751,"en":"All these the Almighty"},{"id":"seytek-2012:p0927:b003:l014","ordinal":366752,"en":"Had bestowed upon this girl beyond measure."},{"id":"seytek-2012:p0927:b003:l015","ordinal":366753,"en":"She looked neither up nor down,"},{"id":"seytek-2012:p0927:b003:l016","ordinal":366754,"en":"Never thinking she might die."},{"id":"seytek-2012:p0927:b003:l017","ordinal":366755,"en":"The peerless warrior maiden"},{"id":"seytek-2012:p0927:b003:l018","ordinal":366756,"en":"Rejoiced at the thought of death,"},{"id":"seytek-2012:p0927:b003:l019","ordinal":366757,"en":"Showing herself a true hero."},{"id":"seytek-2012:p0927:b003:l020","ordinal":366758,"en":"When she turned her charger’s head,"},{"id":"seytek-2012:p0927:b003:l021","ordinal":366759,"en":"Her well-shafted spear was steel;"},{"id":"seytek-2012:p0927:b003:l022","ordinal":366760,"en":"When she leveled it with a thunderous roar,"},{"id":"seytek-2012:p0927:b003:l023","ordinal":366761,"en":"The one she would fight was Sarybay,"},{"id":"seytek-2012:p0927:b003:l024","ordinal":366762,"en":"The one she would confront was such a foe."},{"id":"seytek-2012:p0927:b003:l025","ordinal":366763,"en":"A fierce one with stony courage,"},{"id":"seytek-2012:p0927:b003:l026","ordinal":366764,"en":"A hero at heart with a warrior’s arm,"},{"id":"seytek-2012:p0927:b003:l027","ordinal":366765,"en":"To that infidel Sarybay"},{"id":"seytek-2012:p0927:b003:l028","ordinal":366766,"en":"She became a crushing menace."},{"id":"seytek-2012:p0927:b003:l029","ordinal":366767,"en":"With no regret even in death,"},{"id":"seytek-2012:p0927:b003:l030","ordinal":366768,"en":"Kuyaly unleashed a mighty battle."},{"id":"seytek-2012:p0927:b003:l031","ordinal":366769,"en":"The renowned warrior maiden,"},{"id":"seytek-2012:p0927:b003:l032","ordinal":366770,"en":"Through countless contests and countless feuds,"},{"id":"seytek-2012:p0927:b003:l033","ordinal":366771,"en":"Had met foes and spread havoc."},{"id":"seytek-2012:p0927:b003:l034","ordinal":366772,"en":"She had won acclaim in many lands"},{"id":"seytek-2012:p0927:b003:l035","ordinal":366773,"en":"And was called the lioness."},{"id":"seytek-2012:p0927:b003:l036","ordinal":366774,"en":"God made straight her path;"},{"id":"seytek-2012:p0927:b003:l037","ordinal":366775,"en":"The spirit of the road and Shayaba"},{"id":"seytek-2012:p0927:b003:l038","ordinal":366776,"en":"Both upheld her together,"},{"id":"seytek-2012:p0927:b003:l039","ordinal":366777,"en":"Guiding her wherever she advanced,"},{"id":"seytek-2012:p0927:b003:l040","ordinal":366778,"en":"And strengthening her whenever foes confronted her."},{"id":"seytek-2012:p0928:b002:l001","ordinal":366779,"en":"Her name was heard throughout the world;"},{"id":"seytek-2012:p0928:b002:l002","ordinal":366780,"en":"Many who had heard with their ears and seen with their eyes"},{"id":"seytek-2012:p0928:b002:l003","ordinal":366781,"en":"Knew well"},{"id":"seytek-2012:p0928:b002:l004","ordinal":366782,"en":"That none like her had ever been."},{"id":"seytek-2012:p0928:b002:l005","ordinal":366783,"en":"She charged straight at Sarybay,"},{"id":"seytek-2012:p0928:b002:l006","ordinal":366784,"en":"Raising her weapon like Zulfiqar,"},{"id":"seytek-2012:p0928:b002:l007","ordinal":366785,"en":"Her spear made ready,"},{"id":"seytek-2012:p0928:b002:l008","ordinal":366786,"en":"Straining and crouching for the charge."},{"id":"seytek-2012:p0928:b002:l009","ordinal":366787,"en":"“I shall reach him before an arrow,” she thought,"},{"id":"seytek-2012:p0928:b002:l010","ordinal":366788,"en":"And rushed forward with leveled spear;"},{"id":"seytek-2012:p0928:b002:l011","ordinal":366789,"en":"“I shall smash him utterly.”"},{"id":"seytek-2012:p0928:b002:l012","ordinal":366790,"en":"No sooner conceived than done:"},{"id":"seytek-2012:p0928:b002:l013","ordinal":366791,"en":"Power boiled and strength swelled,"},{"id":"seytek-2012:p0928:b002:l014","ordinal":366792,"en":"And the formidable champion transformed,"},{"id":"seytek-2012:p0928:b002:l015","ordinal":366793,"en":"Shouting at the madman"},{"id":"seytek-2012:p0928:b002:l016","ordinal":366794,"en":"As she unleashed her terrible wrath."},{"id":"seytek-2012:p0928:b002:l017","ordinal":366795,"en":"The life given by Almighty God"},{"id":"seytek-2012:p0928:b002:l018","ordinal":366796,"en":"She valued not even as a hair, the wretched girl,"},{"id":"seytek-2012:p0928:b002:l019","ordinal":366797,"en":"But cast it away as though tied to a thread."},{"id":"seytek-2012:p0928:b002:l020","ordinal":366798,"en":"When she turned her charger’s head"},{"id":"seytek-2012:p0928:b002:l021","ordinal":366799,"en":"Toward her foe, brave Sarybay,"},{"id":"seytek-2012:p0928:b002:l022","ordinal":366800,"en":"And now leveled her spear,"},{"id":"seytek-2012:p0928:b002:l023","ordinal":366801,"en":"She bent low at the waist."},{"id":"seytek-2012:p0928:b002:l024","ordinal":366802,"en":"Her two eyes blazed with fire,"},{"id":"seytek-2012:p0928:b002:l025","ordinal":366803,"en":"Bulging and gleaming through the gloom;"},{"id":"seytek-2012:p0928:b002:l026","ordinal":366804,"en":"Her great spine and ribs"},{"id":"seytek-2012:p0928:b002:l027","ordinal":366805,"en":"Stood starkly apart,"},{"id":"seytek-2012:p0928:b002:l028","ordinal":366806,"en":"And blood-red embers mixed with gore"},{"id":"seytek-2012:p0928:b002:l029","ordinal":366807,"en":"Poured like flame from her mouth."},{"id":"seytek-2012:p0928:b002:l030","ordinal":366808,"en":"Her prowess and courage"},{"id":"seytek-2012:p0928:b002:l031","ordinal":366809,"en":"Appeared extraordinary to the eye."},{"id":"seytek-2012:p0928:b002:l032","ordinal":366810,"en":"Breaking free of all restraint,"},{"id":"seytek-2012:p0928:b002:l033","ordinal":366811,"en":"Shattering the ground beneath his hooves,"},{"id":"seytek-2012:p0928:b002:l034","ordinal":366812,"en":"Zhelzhetpes flew like a cloud,"},{"id":"seytek-2012:p0928:b002:l035","ordinal":366813,"en":"Racing with the thoroughbred,"},{"id":"seytek-2012:p0928:b002:l036","ordinal":366814,"en":"Breaking a path with his hooves"},{"id":"seytek-2012:p0928:b002:l037","ordinal":366815,"en":"Toward wrathful Sarybay,"},{"id":"seytek-2012:p0928:b002:l038","ordinal":366816,"en":"Striking at the marauder."},{"id":"seytek-2012:p0928:b002:l039","ordinal":366817,"en":"Then Kuyaly,"},{"id":"seytek-2012:p0928:b002:l040","ordinal":366818,"en":"Tall and broad-shouldered,"},{"id":"seytek-2012:p0928:b003:l001","ordinal":366819,"en":"A mighty champion and keen warrior,"},{"id":"seytek-2012:p0928:b003:l002","ordinal":366820,"en":"Was herself one of the great heroes."},{"id":"seytek-2012:p0928:b003:l003","ordinal":366821,"en":"Before one could cry out,"},{"id":"seytek-2012:p0928:b003:l004","ordinal":366822,"en":"In the blink of an eye,"},{"id":"seytek-2012:p0928:b003:l005","ordinal":366823,"en":"Her Zhelzhetpes grew wild,"},{"id":"seytek-2012:p0928:b003:l006","ordinal":366824,"en":"Soaring like a cloud in fury,"},{"id":"seytek-2012:p0928:b003:l007","ordinal":366825,"en":"And reached him sooner than an arrow."},{"id":"seytek-2012:p0928:b003:l008","ordinal":366826,"en":"Kuyaly, a master of the spear,"},{"id":"seytek-2012:p0928:b003:l009","ordinal":366827,"en":"Spoke the words she had long kept,"},{"id":"seytek-2012:p0928:b003:l010","ordinal":366828,"en":"And to the hero Sarybay"},{"id":"seytek-2012:p0928:b003:l011","ordinal":366829,"en":"She said this:"},{"id":"seytek-2012:p0928:b003:l012","ordinal":366830,"en":"“For as long as anyone remembers,"},{"id":"seytek-2012:p0928:b003:l013","ordinal":366831,"en":"You have plotted violence,"},{"id":"seytek-2012:p0928:b003:l014","ordinal":366832,"en":"Roaming among nations and spilling blood,"},{"id":"seytek-2012:p0928:b003:l015","ordinal":366833,"en":"Never ceasing your strife."},{"id":"seytek-2012:p0928:b003:l016","ordinal":366834,"en":"If you continue so, madman,"},{"id":"seytek-2012:p0928:b003:l017","ordinal":366835,"en":"You will never prosper in this world."},{"id":"seytek-2012:p0928:b003:l018","ordinal":366836,"en":"Even a dog is far better than you;"},{"id":"seytek-2012:p0928:b003:l019","ordinal":366837,"en":"You have never ceased your doggish ways."},{"id":"seytek-2012:p0928:b003:l020","ordinal":366838,"en":"Your violence has reached many;"},{"id":"seytek-2012:p0928:b003:l021","ordinal":366839,"en":"Many innocent souls have died."},{"id":"seytek-2012:p0928:b003:l022","ordinal":366840,"en":"This one is human, and you are human—"},{"id":"seytek-2012:p0928:b003:l023","ordinal":366841,"en":"What you have done is truly evil."},{"id":"seytek-2012:p0928:b003:l024","ordinal":366842,"en":"You have put out the hearth-fires"},{"id":"seytek-2012:p0928:b003:l025","ordinal":366843,"en":"Of peaceful folk dwelling in their summer camps,"},{"id":"seytek-2012:p0928:b003:l026","ordinal":366844,"en":"And driven them all away."},{"id":"seytek-2012:p0928:b003:l027","ordinal":366845,"en":"You destroyed the trees of their homeland,"},{"id":"seytek-2012:p0928:b003:l028","ordinal":366846,"en":"Left their little children orphaned,"},{"id":"seytek-2012:p0928:b003:l029","ordinal":366847,"en":"And cast them into misery."},{"id":"seytek-2012:p0928:b003:l030","ordinal":366848,"en":"You have no ancestral feud to avenge;"}]
