[{"id":"semetey-1-2013:p0871:b005:l017","ordinal":143617,"en":"However much Kanykei spoke,"},{"id":"semetey-1-2013:p0871:b005:l018","ordinal":143618,"en":"The offspring of the disobedient one,"},{"id":"semetey-1-2013:p0871:b005:l019","ordinal":143619,"en":"Semetey would not listen."},{"id":"semetey-1-2013:p0871:b005:l020","ordinal":143620,"en":"He remained utterly unconcerned."},{"id":"semetey-1-2013:p0871:b005:l021","ordinal":143621,"en":"Abyke and Kobosh's"},{"id":"semetey-1-2013:p0871:b005:l022","ordinal":143622,"en":"However innumerable their armies,"},{"id":"semetey-1-2013:p0871:b005:l023","ordinal":143623,"en":"He did not consider them worth a thing."},{"id":"semetey-1-2013:p0871:b005:l024","ordinal":143624,"en":"The young lord, the leopard,"},{"id":"semetey-1-2013:p0871:b005:l025","ordinal":143625,"en":"Lay down without a care."},{"id":"semetey-1-2013:p0871:b005:l026","ordinal":143626,"en":"In the gated royal court,"},{"id":"semetey-1-2013:p0871:b005:l027","ordinal":143627,"en":"In the fortress with iron doors,"},{"id":"semetey-1-2013:p0871:b005:l028","ordinal":143628,"en":"Amid the games of girls and brides,"},{"id":"semetey-1-2013:p0871:b005:l029","ordinal":143629,"en":"He lay down there,"},{"id":"semetey-1-2013:p0871:b005:l030","ordinal":143630,"en":"In Chachykei's embrace."},{"id":"semetey-1-2013:p0871:b005:l031","ordinal":143631,"en":"Both his mothers wept,"},{"id":"semetey-1-2013:p0871:b005:l032","ordinal":143632,"en":"Unable to say, ‘Get up, child,’"},{"id":"semetey-1-2013:p0871:b005:l033","ordinal":143633,"en":"The poor child born a goshawk,"},{"id":"semetey-1-2013:p0871:b005:l034","ordinal":143634,"en":"They would not disappoint him."},{"id":"semetey-1-2013:p0871:b005:l035","ordinal":143635,"en":"Unable to say, ‘Oh, child,’"},{"id":"semetey-1-2013:p0871:b005:l036","ordinal":143636,"en":"To the orphan born a lion,"},{"id":"semetey-1-2013:p0872:b003:l001","ordinal":143637,"en":"They would not disappoint him at all."},{"id":"semetey-1-2013:p0872:b003:l002","ordinal":143638,"en":"Both his mothers wept,"},{"id":"semetey-1-2013:p0872:b003:l003","ordinal":143639,"en":"For the support left by Manas,"},{"id":"semetey-1-2013:p0872:b003:l004","ordinal":143640,"en":"Weeping in anxious care."},{"id":"semetey-1-2013:p0872:b003:l005","ordinal":143641,"en":"Your dear mother Kanykei said,"},{"id":"semetey-1-2013:p0872:b003:l006","ordinal":143642,"en":"‘If the villains come and fight,"},{"id":"semetey-1-2013:p0872:b003:l007","ordinal":143643,"en":"What will become of us?"},{"id":"semetey-1-2013:p0872:b003:l008","ordinal":143644,"en":"What will happen to my child gained through mortal suffering?’"},{"id":"semetey-1-2013:p0872:b003:l010","ordinal":143645,"en":"Her hair down her back, divided into ten,"},{"id":"semetey-1-2013:p0872:b003:l011","ordinal":143646,"en":"Was it not your sister-in-law who braided it?"},{"id":"semetey-1-2013:p0872:b003:l012","ordinal":143647,"en":"While magnanimous Manas lived,"},{"id":"semetey-1-2013:p0872:b003:l013","ordinal":143648,"en":"She grappled with all sorts of foes."},{"id":"semetey-1-2013:p0872:b003:l014","ordinal":143649,"en":"To the ways of war, more firmly,"},{"id":"semetey-1-2013:p0872:b003:l015","ordinal":143650,"en":"Was it not your sister-in-law who grew accustomed?"},{"id":"semetey-1-2013:p0872:b003:l016","ordinal":143651,"en":"Fighting against so many lions,"},{"id":"semetey-1-2013:p0872:b003:l017","ordinal":143652,"en":"While Khan Manas lived,"},{"id":"semetey-1-2013:p0872:b003:l018","ordinal":143653,"en":"Was it not your sister-in-law who saw it all?"},{"id":"semetey-1-2013:p0872:b003:l019","ordinal":143654,"en":"Before their army swept upon them,"},{"id":"semetey-1-2013:p0872:b003:l020","ordinal":143655,"en":"Before Abyke, Kobosh and the six villains"},{"id":"semetey-1-2013:p0872:b003:l021","ordinal":143656,"en":"Swept upon them together,"},{"id":"semetey-1-2013:p0872:b003:l022","ordinal":143657,"en":"For Buurul, as great as a camel,"},{"id":"semetey-1-2013:p0872:b003:l023","ordinal":143658,"en":"She had a bridle brought and fastened on."},{"id":"semetey-1-2013:p0872:b003:l024","ordinal":143659,"en":"Its inside worked in silk,"},{"id":"semetey-1-2013:p0872:b003:l025","ordinal":143660,"en":"For seven years she had bitten patterns without pause."},{"id":"semetey-1-2013:p0872:b003:l026","ordinal":143661,"en":"Close the door carefully."},{"id":"semetey-1-2013:p0872:b003:l027","ordinal":143662,"en":"Upon Buurul, as great as a camel,"},{"id":"semetey-1-2013:p0872:b003:l028","ordinal":143663,"en":"So that no bullet would strike him,"},{"id":"semetey-1-2013:p0872:b003:l029","ordinal":143664,"en":"She had the protective covering laid."},{"id":"semetey-1-2013:p0872:b003:l030","ordinal":143665,"en":"Above that covering,"},{"id":"semetey-1-2013:p0872:b003:l031","ordinal":143666,"en":"A leather sweatcloth and blue saddle pad"},{"id":"semetey-1-2013:p0872:b003:l032","ordinal":143667,"en":"She laid, crying aloud."},{"id":"semetey-1-2013:p0872:b003:l033","ordinal":143668,"en":"Your dear mother Kanykei"},{"id":"semetey-1-2013:p0872:b003:l034","ordinal":143669,"en":"Sobbed to the one God."},{"id":"semetey-1-2013:p0872:b003:l035","ordinal":143670,"en":"She made ready the equipment,"},{"id":"semetey-1-2013:p0872:b003:l036","ordinal":143671,"en":"‘God, protect my only son!’ she said,"},{"id":"semetey-1-2013:p0872:b003:l037","ordinal":143672,"en":"Pleading with the Creator."},{"id":"semetey-1-2013:p0872:b003:l038","ordinal":143673,"en":"For Buurul, as great as a camel,"},{"id":"semetey-1-2013:p0872:b003:l039","ordinal":143674,"en":"It was a solemn trust;"},{"id":"semetey-1-2013:p0872:b004:l001","ordinal":143675,"en":"Covered with elephant hide,"},{"id":"semetey-1-2013:p0872:b004:l002","ordinal":143676,"en":"For fifteen years in this fashion,"},{"id":"semetey-1-2013:p0872:b004:l003","ordinal":143677,"en":"Mighty Bakai had kept it safe."},{"id":"semetey-1-2013:p0872:b004:l004","ordinal":143678,"en":"Its pommel had never touched the ground;"},{"id":"semetey-1-2013:p0872:b004:l005","ordinal":143679,"en":"No one without ritual ablution had ridden it;"},{"id":"semetey-1-2013:p0872:b004:l006","ordinal":143680,"en":"No stranger knew its worth."},{"id":"semetey-1-2013:p0872:b004:l007","ordinal":143681,"en":"Akkanqy, made by Almambet,"},{"id":"semetey-1-2013:p0872:b004:l008","ordinal":143682,"en":"A saddle fit for the noble steed,"},{"id":"semetey-1-2013:p0872:b004:l009","ordinal":143683,"en":"Its front pommel pure gold,"},{"id":"semetey-1-2013:p0872:b004:l010","ordinal":143684,"en":"Its rear pommel solid silver,"},{"id":"semetey-1-2013:p0872:b004:l011","ordinal":143685,"en":"Its two sides broad iron—"},{"id":"semetey-1-2013:p0872:b004:l012","ordinal":143686,"en":"From the valiant Sultan Alma,"},{"id":"semetey-1-2013:p0872:b004:l013","ordinal":143687,"en":"Akkanqy had remained as a gift."},{"id":"semetey-1-2013:p0872:b004:l014","ordinal":143688,"en":"Fearing the villains,"},{"id":"semetey-1-2013:p0872:b004:l015","ordinal":143689,"en":"Your lion-mother Kanykei"},{"id":"semetey-1-2013:p0872:b004:l016","ordinal":143690,"en":"Saddled the noble steed."},{"id":"semetey-1-2013:p0872:b004:l017","ordinal":143691,"en":"She had it fastened with adornments."},{"id":"semetey-1-2013:p0872:b004:l018","ordinal":143692,"en":"The bear is tall and white"},{"id":"semetey-1-2013:p0872:b004:l019","ordinal":143693,"en":"Upon Akkanqy,"},{"id":"semetey-1-2013:p0872:b004:l020","ordinal":143694,"en":"She had it fitted and secured."},{"id":"semetey-1-2013:p0872:b004:l021","ordinal":143695,"en":"Its girth was set with jeweled ornaments;"},{"id":"semetey-1-2013:p0872:b004:l022","ordinal":143696,"en":"The broad piece of its crupper"},{"id":"semetey-1-2013:p0872:b004:l023","ordinal":143697,"en":"Bore precious stones and mirrors."},{"id":"semetey-1-2013:p0872:b004:l024","ordinal":143698,"en":"Your dear, unfortunate mother's"},{"id":"semetey-1-2013:p0872:b004:l025","ordinal":143699,"en":"Heart was greatly troubled."},{"id":"semetey-1-2013:p0872:b004:l026","ordinal":143700,"en":"‘My child lying unaware—"},{"id":"semetey-1-2013:p0872:b004:l027","ordinal":143701,"en":"The villains may overwhelm him,"},{"id":"semetey-1-2013:p0872:b004:l028","ordinal":143702,"en":"And his death may come needlessly,’ she thought."},{"id":"semetey-1-2013:p0872:b004:l029","ordinal":143703,"en":"Your dear, fierce mother"},{"id":"semetey-1-2013:p0872:b004:l030","ordinal":143704,"en":"Had not the slightest strength remaining."},{"id":"semetey-1-2013:p0872:b004:l031","ordinal":143705,"en":"‘My precious orphan will ride him,’ she said,"},{"id":"semetey-1-2013:p0872:b004:l032","ordinal":143706,"en":"And prepared the noble steed."},{"id":"semetey-1-2013:p0872:b004:l033","ordinal":143707,"en":"Its collar gold, its sleeves copper,"},{"id":"semetey-1-2013:p0872:b004:l034","ordinal":143708,"en":"Double mail, with dung-pellet-sized rings,"},{"id":"semetey-1-2013:p0872:b004:l035","ordinal":143709,"en":"No spear could pierce it in a lance fight."},{"id":"semetey-1-2013:p0872:b004:l036","ordinal":143710,"en":"‘Let the orphan wear this,’ she said,"},{"id":"semetey-1-2013:p0872:b004:l037","ordinal":143711,"en":"And prepared Akolpok."},{"id":"semetey-1-2013:p0872:b004:l038","ordinal":143712,"en":"Your dear mother Kanykei"},{"id":"semetey-1-2013:p0872:b004:l039","ordinal":143713,"en":"Took Khan Manas's Akkelte—"},{"id":"semetey-1-2013:p0873:b003:l001","ordinal":143714,"en":"That wondrous creature, when slung upon him,"},{"id":"semetey-1-2013:p0873:b003:l002","ordinal":143715,"en":"Was the mirror of his shoulder blade."},{"id":"semetey-1-2013:p0873:b003:l003","ordinal":143716,"en":"When fired at a fighting foe,"},{"id":"semetey-1-2013:p0873:b003:l004","ordinal":143717,"en":"It comforted the life entrusted to him."},{"id":"semetey-1-2013:p0873:b003:l005","ordinal":143718,"en":"The living gun Akkelte—"},{"id":"semetey-1-2013:p0873:b003:l006","ordinal":143719,"en":"Your dear mother Kanykei"},{"id":"semetey-1-2013:p0873:b003:l007","ordinal":143720,"en":"Scraped it with its cleaning tool,"},{"id":"semetey-1-2013:p0873:b003:l008","ordinal":143721,"en":"And rubbed it with red sand."},{"id":"semetey-1-2013:p0873:b003:l009","ordinal":143722,"en":"She worked it with the ramrod,"},{"id":"semetey-1-2013:p0873:b003:l010","ordinal":143723,"en":"Wiping its inside clean."},{"id":"semetey-1-2013:p0873:b003:l011","ordinal":143724,"en":"Your wretched, unfortunate mother"},{"id":"semetey-1-2013:p0873:b003:l012","ordinal":143725,"en":"Took the powder from its box,"},{"id":"semetey-1-2013:p0873:b003:l013","ordinal":143726,"en":"And poured it down with a rumble."},{"id":"semetey-1-2013:p0873:b003:l014","ordinal":143727,"en":"Taking a bullet from the pouch,"},{"id":"semetey-1-2013:p0873:b003:l015","ordinal":143728,"en":"Into Akkelte's mouth"},{"id":"semetey-1-2013:p0873:b003:l016","ordinal":143729,"en":"She drove it with a clatter."},{"id":"semetey-1-2013:p0873:b003:l017","ordinal":143730,"en":"Making the weapons ready,"},{"id":"semetey-1-2013:p0873:b003:l018","ordinal":143731,"en":"Chiyyrdy now held them."},{"id":"semetey-1-2013:p0873:b003:l019","ordinal":143732,"en":"Her black hair, thick as a girth,"},{"id":"semetey-1-2013:p0873:b003:l020","ordinal":143733,"en":"She bound tightly atop her head."},{"id":"semetey-1-2013:p0873:b003:l021","ordinal":143734,"en":"She put on men's clothing,"},{"id":"semetey-1-2013:p0873:b003:l022","ordinal":143735,"en":"And, fearful, recited her prayer."},{"id":"semetey-1-2013:p0873:b003:l023","ordinal":143736,"en":"The Karakashka thoroughbred"},{"id":"semetey-1-2013:p0873:b003:l024","ordinal":143737,"en":"She saddled within the court."},{"id":"semetey-1-2013:p0873:b003:l025","ordinal":143738,"en":"As though about to enter battle,"},{"id":"semetey-1-2013:p0873:b003:l026","ordinal":143739,"en":"Your tiger-mother made ready."},{"id":"semetey-1-2013:p0873:b003:l027","ordinal":143740,"en":"‘Let the quarrel begin with them,’ she said,"},{"id":"semetey-1-2013:p0873:b003:l028","ordinal":143741,"en":"Pleading with the Creator."},{"id":"semetey-1-2013:p0873:b003:l029","ordinal":143742,"en":"Semetey lay sleeping,"},{"id":"semetey-1-2013:p0873:b003:l030","ordinal":143743,"en":"And Kanykei was making ready."},{"id":"semetey-1-2013:p0873:b003:l031","ordinal":143744,"en":"Let us leave them thus,"},{"id":"semetey-1-2013:p0873:b003:l032","ordinal":143745,"en":"And take up the other side."},{"id":"semetey-1-2013:p0873:b003:l033","ordinal":143746,"en":"The red banner with pale markings"},{"id":"semetey-1-2013:p0873:b003:l034","ordinal":143747,"en":"They had the hero Kochkor carry."},{"id":"semetey-1-2013:p0873:b003:l035","ordinal":143748,"en":"Slashing at the rear of the army,"},{"id":"semetey-1-2013:p0873:b003:l036","ordinal":143749,"en":"They had Khan Kobosh drive it onward."},{"id":"semetey-1-2013:p0873:b003:l037","ordinal":143750,"en":"The axemen were on the flank,"},{"id":"semetey-1-2013:p0873:b003:l038","ordinal":143751,"en":"Lion Kobosh at the front,"},{"id":"semetey-1-2013:p0873:b003:l039","ordinal":143752,"en":"White standards and red banners,"},{"id":"semetey-1-2013:p0873:b005:l001","ordinal":143753,"en":"Shouting and roaring tumult."},{"id":"semetey-1-2013:p0873:b005:l002","ordinal":143754,"en":"The marksmen who fired guns"},{"id":"semetey-1-2013:p0873:b005:l003","ordinal":143755,"en":"They separated onto the flank."},{"id":"semetey-1-2013:p0873:b005:l004","ordinal":143756,"en":"With an army of some six thousand,"},{"id":"semetey-1-2013:p0873:b005:l005","ordinal":143757,"en":"Abyke rode along."},{"id":"semetey-1-2013:p0873:b005:l006","ordinal":143758,"en":"His six thousand marksmen"},{"id":"semetey-1-2013:p0873:b005:l007","ordinal":143759,"en":"He set apart upon the hills."},{"id":"semetey-1-2013:p0873:b005:l008","ordinal":143760,"en":"The leader of those marksmen"},{"id":"semetey-1-2013:p0873:b005:l009","ordinal":143761,"en":"Was Abyke."},{"id":"semetey-1-2013:p0873:b005:l010","ordinal":143762,"en":"On the nearer side of them,"},{"id":"semetey-1-2013:p0873:b005:l011","ordinal":143763,"en":"Their horses, every one,"},{"id":"semetey-1-2013:p0873:b005:l012","ordinal":143764,"en":"Were all alike, dun-colored,"},{"id":"semetey-1-2013:p0873:b005:l013","ordinal":143765,"en":"With amulet-shaped marks upon their brows,"},{"id":"semetey-1-2013:p0873:b005:l014","ordinal":143766,"en":"All outstanding, peerless steeds."},{"id":"semetey-1-2013:p0873:b005:l015","ordinal":143767,"en":"Roaring as they sang their olen,"},{"id":"semetey-1-2013:p0873:b005:l016","ordinal":143768,"en":"The Kazakh army formed a separate body."},{"id":"semetey-1-2013:p0873:b005:l017","ordinal":143769,"en":"Having lost their Urbu,"},{"id":"semetey-1-2013:p0873:b005:l018","ordinal":143770,"en":"Sighing and grieving,"},{"id":"semetey-1-2013:p0873:b005:l019","ordinal":143771,"en":"Like clouds about to rain again,"},{"id":"semetey-1-2013:p0873:b005:l020","ordinal":143772,"en":"They wheeled this way and that."},{"id":"semetey-1-2013:p0873:b005:l021","ordinal":143773,"en":"Dark battle-axes and Zulfiqar swords"},{"id":"semetey-1-2013:p0873:b005:l022","ordinal":143774,"en":"They fastened at their sides."},{"id":"semetey-1-2013:p0873:b005:l023","ordinal":143775,"en":"The earth grew misty with their pounding;"},{"id":"semetey-1-2013:p0873:b005:l024","ordinal":143776,"en":"Their cries split stones,"},{"id":"semetey-1-2013:p0873:b005:l025","ordinal":143777,"en":"Their clamorous uproar split heads."},{"id":"semetey-1-2013:p0873:b005:l026","ordinal":143778,"en":"The Kipchak army was a separate body."},{"id":"semetey-1-2013:p0873:b005:l027","ordinal":143779,"en":"Riding Karabair horses,"},{"id":"semetey-1-2013:p0873:b005:l028","ordinal":143780,"en":"Wearing dark coats no bullet could pierce,"},{"id":"semetey-1-2013:p0873:b005:l029","ordinal":143781,"en":"Full of courage, fierce in wrath,"},{"id":"semetey-1-2013:p0873:b005:l030","ordinal":143782,"en":"Leveling all whom they encountered,"},{"id":"semetey-1-2013:p0873:b005:l031","ordinal":143783,"en":"Muzburchak's Buyanbek"},{"id":"semetey-1-2013:p0873:b005:l032","ordinal":143784,"en":"Came straight on with his army,"},{"id":"semetey-1-2013:p0873:b005:l033","ordinal":143785,"en":"He too with four thousand troops."},{"id":"semetey-1-2013:p0873:b005:l034","ordinal":143786,"en":"Alabek of the Six Cities,"},{"id":"semetey-1-2013:p0873:b005:l035","ordinal":143787,"en":"Riding stallions, mules and horses,"},{"id":"semetey-1-2013:p0873:b005:l036","ordinal":143788,"en":"Their beards jutting out,"},{"id":"semetey-1-2013:p0873:b005:l037","ordinal":143789,"en":"They spoke to one another,"},{"id":"semetey-1-2013:p0873:b005:l038","ordinal":143790,"en":"Calling ‘elder brother,’ gathering fervor,"},{"id":"semetey-1-2013:p0873:b005:l039","ordinal":143791,"en":"Making ready, thinking themselves adept,"},{"id":"semetey-1-2013:p0874:b003:l001","ordinal":143792,"en":"Dark maces and battle-axes"},{"id":"semetey-1-2013:p0874:b003:l002","ordinal":143793,"en":"They fastened at their sides."},{"id":"semetey-1-2013:p0874:b003:l003","ordinal":143794,"en":"Their beards spread out,"},{"id":"semetey-1-2013:p0874:b003:l004","ordinal":143795,"en":"Their bare chests showed plainly."},{"id":"semetey-1-2013:p0874:b003:l005","ordinal":143796,"en":"They had their flutes played,"},{"id":"semetey-1-2013:p0874:b003:l006","ordinal":143797,"en":"And the strongmen riding camel saddles"},{"id":"semetey-1-2013:p0874:b003:l007","ordinal":143798,"en":"They all had sing songs."},{"id":"semetey-1-2013:p0874:b003:l008","ordinal":143799,"en":"Alabek swept forward."},{"id":"semetey-1-2013:p0874:b003:l009","ordinal":143800,"en":"Heeding Abyke and Kobosh's"},{"id":"semetey-1-2013:p0874:b003:l010","ordinal":143801,"en":"Words, these men"},{"id":"semetey-1-2013:p0874:b003:l011","ordinal":143802,"en":"Had been struck by Heaven."},{"id":"semetey-1-2013:p0874:b003:l012","ordinal":143803,"en":"Skirting Kum-Kyya,"},{"id":"semetey-1-2013:p0874:b003:l013","ordinal":143804,"en":"They came spreading out."},{"id":"semetey-1-2013:p0874:b003:l014","ordinal":143805,"en":"Swarming like ants,"},{"id":"semetey-1-2013:p0874:b003:l015","ordinal":143806,"en":"They came boiling forth."},{"id":"semetey-1-2013:p0874:b003:l016","ordinal":143807,"en":"All the army, the forty warriors,"},{"id":"semetey-1-2013:p0874:b003:l017","ordinal":143808,"en":"Those dear, seasoned men,"},{"id":"semetey-1-2013:p0874:b003:l018","ordinal":143809,"en":"Were driving forward."},{"id":"semetey-1-2013:p0874:b003:l019","ordinal":143810,"en":"Over the lower slopes of Tash-Moinok,"},{"id":"semetey-1-2013:p0874:b003:l020","ordinal":143811,"en":"They came striding across."},{"id":"semetey-1-2013:p0874:b003:l021","ordinal":143812,"en":"Across the lower slopes of great Talas,"},{"id":"semetey-1-2013:p0874:b003:l022","ordinal":143813,"en":"The vast army swarmed,"},{"id":"semetey-1-2013:p0874:b003:l023","ordinal":143814,"en":"And came sweeping onward."},{"id":"semetey-1-2013:p0874:b003:l024","ordinal":143815,"en":"Spear points bobbed,"},{"id":"semetey-1-2013:p0874:b003:l025","ordinal":143816,"en":"Men's heads jutted up."},{"id":"semetey-1-2013:p0874:b003:l026","ordinal":143817,"en":"The worthless were within,"},{"id":"semetey-1-2013:p0874:b003:l027","ordinal":143818,"en":"The capable upon the flanks."},{"id":"semetey-1-2013:p0874:b003:l028","ordinal":143819,"en":"The would-be fugitives were within,"},{"id":"semetey-1-2013:p0874:b003:l029","ordinal":143820,"en":"The worthy upon the flanks."},{"id":"semetey-1-2013:p0874:b003:l030","ordinal":143821,"en":"The eye could not take them all in—"},{"id":"semetey-1-2013:p0874:b003:l031","ordinal":143822,"en":"God, do not let us see their faces!"},{"id":"semetey-1-2013:p0874:b003:l032","ordinal":143823,"en":"One could not tell who was who."},{"id":"semetey-1-2013:p0874:b003:l033","ordinal":143824,"en":"See the reeds, see the flood,"},{"id":"semetey-1-2013:p0874:b003:l034","ordinal":143825,"en":"Look at the teeming multitude!"},{"id":"semetey-1-2013:p0874:b003:l035","ordinal":143826,"en":"Those who marched with flags"},{"id":"semetey-1-2013:p0874:b003:l036","ordinal":143827,"en":"Trampled and churned the earth,"},{"id":"semetey-1-2013:p0874:b003:l037","ordinal":143828,"en":"Upon Manas's only orphan,"},{"id":"semetey-1-2013:p0874:b003:l038","ordinal":143829,"en":"Sweeping as though to devour him."},{"id":"semetey-1-2013:p0874:b003:l039","ordinal":143830,"en":"Striking the war drums with a crash,"},{"id":"semetey-1-2013:p0874:b004:l001","ordinal":143831,"en":"All were struck together by their broken oath."},{"id":"semetey-1-2013:p0874:b004:l002","ordinal":143832,"en":"Abyke and Kobosh drove the army;"},{"id":"semetey-1-2013:p0874:b004:l003","ordinal":143833,"en":"All six villains"},{"id":"semetey-1-2013:p0874:b004:l004","ordinal":143834,"en":"Drove the arriving troops together."},{"id":"semetey-1-2013:p0874:b004:l005","ordinal":143835,"en":"Against Manas's only orphan,"},{"id":"semetey-1-2013:p0874:b004:l006","ordinal":143836,"en":"They meant to rise, bringing misery upon themselves."},{"id":"semetey-1-2013:p0874:b004:l007","ordinal":143837,"en":"As though I had carried off their wealth,"},{"id":"semetey-1-2013:p0874:b004:l008","ordinal":143838,"en":"God now struck the fools,"},{"id":"semetey-1-2013:p0874:b004:l009","ordinal":143839,"en":"As though their bright treasury had been scattered."},{"id":"semetey-1-2013:p0874:b004:l010","ordinal":143840,"en":"The earth grew misty and shimmering."},{"id":"semetey-1-2013:p0874:b004:l011","ordinal":143841,"en":"Toward Semetey's court,"},{"id":"semetey-1-2013:p0874:b004:l012","ordinal":143842,"en":"The army drew near to enter."},{"id":"semetey-1-2013:p0874:b004:l013","ordinal":143843,"en":"Khan Manas's forty warriors"},{"id":"semetey-1-2013:p0874:b004:l014","ordinal":143844,"en":"Were truly struck by God."},{"id":"semetey-1-2013:p0874:b004:l015","ordinal":143845,"en":"They began to waver,"},{"id":"semetey-1-2013:p0874:b004:l016","ordinal":143846,"en":"And fell into dispute."},{"id":"semetey-1-2013:p0874:b004:l017","ordinal":143847,"en":"Divided, they spread about,"},{"id":"semetey-1-2013:p0874:b004:l018","ordinal":143848,"en":"Grasping one another,"},{"id":"semetey-1-2013:p0874:b004:l019","ordinal":143849,"en":"Laying their words before the gathering,"},{"id":"semetey-1-2013:p0874:b004:l020","ordinal":143850,"en":"And raising an uproar."},{"id":"semetey-1-2013:p0874:b004:l021","ordinal":143851,"en":"They divided by their fathers' lines."},{"id":"semetey-1-2013:p0874:b004:l022","ordinal":143852,"en":"Among those warriors who had come,"},{"id":"semetey-1-2013:p0874:b004:l023","ordinal":143853,"en":"The good and honest-hearted"},{"id":"semetey-1-2013:p0874:b004:l024","ordinal":143854,"en":"Shed tears from their eyes."},{"id":"semetey-1-2013:p0874:b004:l025","ordinal":143855,"en":"Gathering by their fathers' lines,"},{"id":"semetey-1-2013:p0874:b004:l026","ordinal":143856,"en":"They began to talk."},{"id":"semetey-1-2013:p0874:b004:l027","ordinal":143857,"en":"Reining in beside one another, they halted,"},{"id":"semetey-1-2013:p0874:b004:l028","ordinal":143858,"en":"And mourned the old days."},{"id":"semetey-1-2013:p0874:b004:l029","ordinal":143859,"en":"They reasoned with each other,"},{"id":"semetey-1-2013:p0874:b004:l030","ordinal":143860,"en":"And remained there embracing,"},{"id":"semetey-1-2013:p0874:b004:l031","ordinal":143861,"en":"And stopped midway."},{"id":"semetey-1-2013:p0874:b004:l032","ordinal":143862,"en":"Quite a few of the warriors"},{"id":"semetey-1-2013:p0874:b004:l033","ordinal":143863,"en":"At Abyke and Kobosh"},{"id":"semetey-1-2013:p0874:b004:l034","ordinal":143864,"en":"Hurled the foulest abuse."},{"id":"semetey-1-2013:p0874:b004:l035","ordinal":143865,"en":"Falling into dispute,"},{"id":"semetey-1-2013:p0874:b004:l036","ordinal":143866,"en":"Growing red in the face,"},{"id":"semetey-1-2013:p0874:b004:l037","ordinal":143867,"en":"The forty warriors, in separate groups,"},{"id":"semetey-1-2013:p0874:b004:l038","ordinal":143868,"en":"Stood divided."},{"id":"semetey-1-2013:p0874:b004:l039","ordinal":143869,"en":"The treachery of the villains—"},{"id":"semetey-1-2013:p0875:b003:l001","ordinal":143870,"en":"When it stood revealed,"},{"id":"semetey-1-2013:p0875:b003:l002","ordinal":143871,"en":"Their hearts were greatly troubled,"},{"id":"semetey-1-2013:p0875:b003:l003","ordinal":143872,"en":"And tears flowed from their eyes."}]
