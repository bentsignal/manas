[{"id":"manas-2010:p0505:b001:l036","ordinal":23041,"en":"The dense army that filled the earth,"},{"id":"manas-2010:p0505:b001:l037","ordinal":23042,"en":"Utterly slaughtered, not one remaining,"},{"id":"manas-2010:p0505:b001:l038","ordinal":23043,"en":"Our misfortune has hardened upon us."},{"id":"manas-2010:p0505:b001:l039","ordinal":23044,"en":"Alas, Manas was a lion indeed,"},{"id":"manas-2010:p0505:b001:l040","ordinal":23045,"en":"One who would bring calamity."},{"id":"manas-2010:p0505:b001:l041","ordinal":23046,"en":"When our khan gave the command,"},{"id":"manas-2010:p0505:b001:l042","ordinal":23047,"en":"We used to advance with countless troops,"},{"id":"manas-2010:p0506:b001:l001","ordinal":23048,"en":"All who provoked us"},{"id":"manas-2010:p0506:b001:l002","ordinal":23049,"en":"We would slaughter utterly."},{"id":"manas-2010:p0506:b001:l003","ordinal":23050,"en":"We will suffer greatly;"},{"id":"manas-2010:p0506:b001:l004","ordinal":23051,"en":"‘We let the army be slaughtered’—"},{"id":"manas-2010:p0506:b001:l005","ordinal":23052,"en":"To a lord like Esenkan,"},{"id":"manas-2010:p0506:b001:l006","ordinal":23053,"en":"How can we now say this?”"},{"id":"manas-2010:p0506:b001:l007","ordinal":23054,"en":"Zholoy went in grief, his great frame swaying,"},{"id":"manas-2010:p0506:b001:l008","ordinal":23055,"en":"Traveling without sparing the horses,"},{"id":"manas-2010:p0506:b001:l009","ordinal":23056,"en":"Going no short way, but far,"},{"id":"manas-2010:p0506:b001:l010","ordinal":23057,"en":"He had brought dreadful news."},{"id":"manas-2010:p0506:b001:l011","ordinal":23058,"en":"Before Esenkan,"},{"id":"manas-2010:p0506:b001:l012","ordinal":23059,"en":"Hurrying, panicking, stumbling,"},{"id":"manas-2010:p0506:b001:l013","ordinal":23060,"en":"The four had arrived."},{"id":"manas-2010:p0506:b001:l014","ordinal":23061,"en":"At Esenkan's gateway"},{"id":"manas-2010:p0506:b001:l015","ordinal":23062,"en":"His governor-khan stood on watch;"},{"id":"manas-2010:p0506:b001:l016","ordinal":23063,"en":"All the guards were there."},{"id":"manas-2010:p0506:b001:l017","ordinal":23064,"en":"No man dared draw near,"},{"id":"manas-2010:p0506:b001:l018","ordinal":23065,"en":"None who met him survived."},{"id":"manas-2010:p0506:b001:l019","ordinal":23066,"en":"His courage fierce, his wrath strong,"},{"id":"manas-2010:p0506:b001:l020","ordinal":23067,"en":"Esenkan was a mighty lord."},{"id":"manas-2010:p0506:b001:l021","ordinal":23068,"en":"Abandon hope of this infidel!"},{"id":"manas-2010:p0506:b001:l022","ordinal":23069,"en":"When the four wrestlers entered,"},{"id":"manas-2010:p0506:b001:l023","ordinal":23070,"en":"He woke with a start from sleep."},{"id":"manas-2010:p0506:b001:l024","ordinal":23071,"en":"From his royal throne,"},{"id":"manas-2010:p0506:b001:l025","ordinal":23072,"en":"Turning in menace,"},{"id":"manas-2010:p0506:b001:l026","ordinal":23073,"en":"Draping on his blue coat of mail—"},{"id":"manas-2010:p0506:b001:l027","ordinal":23074,"en":"If you could see Esenkan,"},{"id":"manas-2010:p0506:b001:l028","ordinal":23075,"en":"Rousing himself like a blue tiger!"},{"id":"manas-2010:p0506:b001:l029","ordinal":23076,"en":"Lights were lit upon the tower,"},{"id":"manas-2010:p0506:b001:l030","ordinal":23077,"en":"The bell was struck loudly."},{"id":"manas-2010:p0506:b001:l031","ordinal":23078,"en":"The soldiers panicked, the people surged;"},{"id":"manas-2010:p0506:b001:l032","ordinal":23079,"en":"Havoc arose, dust flew."},{"id":"manas-2010:p0506:b001:l033","ordinal":23080,"en":"His guards and wrestlers"},{"id":"manas-2010:p0506:b001:l034","ordinal":23081,"en":"Shouted as though an enemy had come."},{"id":"manas-2010:p0506:b001:l035","ordinal":23082,"en":"The war drums deafened ears;"},{"id":"manas-2010:p0506:b001:l036","ordinal":23083,"en":"Battle-axes struck and splintered..."},{"id":"manas-2010:p0506:b003:l001","ordinal":23084,"en":"His governors, his lesser khans,"},{"id":"manas-2010:p0507:b001:l001","ordinal":23085,"en":"Popped up in utter confusion."},{"id":"manas-2010:p0507:b001:l002","ordinal":23086,"en":"His monks and giants,"},{"id":"manas-2010:p0507:b001:l003","ordinal":23087,"en":"Unable to find a way, gaped in fear."},{"id":"manas-2010:p0507:b001:l004","ordinal":23088,"en":"His gem-badged officials and khans,"},{"id":"manas-2010:p0507:b001:l005","ordinal":23089,"en":"‘What has happened here?’ they said,"},{"id":"manas-2010:p0507:b001:l006","ordinal":23090,"en":"Stunned, stumbling in haste—"},{"id":"manas-2010:p0507:b001:l007","ordinal":23091,"en":"Esenkan's people."},{"id":"manas-2010:p0507:b001:l008","ordinal":23092,"en":"The tower beyond the eye's reach"},{"id":"manas-2010:p0507:b001:l009","ordinal":23093,"en":"Looked exceedingly high."},{"id":"manas-2010:p0507:b001:l010","ordinal":23094,"en":"Any person who caught sight of it"},{"id":"manas-2010:p0507:b001:l011","ordinal":23095,"en":"Had his heart badly shaken."},{"id":"manas-2010:p0507:b001:l012","ordinal":23096,"en":"The hair at his nape bristling,"},{"id":"manas-2010:p0507:b001:l013","ordinal":23097,"en":"The hair on his crown standing thick,"},{"id":"manas-2010:p0507:b001:l014","ordinal":23098,"en":"Esenkan was a mighty lord."},{"id":"manas-2010:p0507:b001:l015","ordinal":23099,"en":"He raged from the tower."},{"id":"manas-2010:p0507:b001:l016","ordinal":23100,"en":"These four, at their wits' end,"},{"id":"manas-2010:p0507:b001:l017","ordinal":23101,"en":"Prepared to give their account."},{"id":"manas-2010:p0507:b001:l018","ordinal":23102,"en":"“Bearing a banner that bowed the earth,"},{"id":"manas-2010:p0507:b001:l019","ordinal":23103,"en":"To seize the Burut"},{"id":"manas-2010:p0507:b001:l020","ordinal":23104,"en":"We turned and waged war."},{"id":"manas-2010:p0507:b001:l021","ordinal":23105,"en":"Against that bastard Burut,"},{"id":"manas-2010:p0507:b001:l022","ordinal":23106,"en":"Without looking back, we fought forty days,"},{"id":"manas-2010:p0507:b001:l023","ordinal":23107,"en":"And suffered slaughter."},{"id":"manas-2010:p0507:b001:l024","ordinal":23108,"en":"Manas unleashed his fury;"},{"id":"manas-2010:p0507:b001:l025","ordinal":23109,"en":"Those who fled were laid sprawling,"},{"id":"manas-2010:p0507:b001:l026","ordinal":23110,"en":"His companions laid them low."},{"id":"manas-2010:p0507:b001:l027","ordinal":23111,"en":"Beholding the face of Judgment Day,"},{"id":"manas-2010:p0507:b001:l028","ordinal":23112,"en":"We fled wounded,"},{"id":"manas-2010:p0507:b001:l029","ordinal":23113,"en":"Dying at Khan Manas's hands."},{"id":"manas-2010:p0507:b001:l030","ordinal":23114,"en":"The battle-axe with golden cheeks,"},{"id":"manas-2010:p0507:b001:l031","ordinal":23115,"en":"The painted spear in his hand,"},{"id":"manas-2010:p0507:b001:l032","ordinal":23116,"en":"He seized and swung."},{"id":"manas-2010:p0507:b001:l033","ordinal":23117,"en":"With one thrust he split Orgo"},{"id":"manas-2010:p0507:b001:l034","ordinal":23118,"en":"Into two pieces."},{"id":"manas-2010:p0507:b001:l035","ordinal":23119,"en":"In the battle as we drew back,"},{"id":"manas-2010:p0507:b001:l036","ordinal":23120,"en":"He brought us grievous trouble indeed."},{"id":"manas-2010:p0507:b001:l037","ordinal":23121,"en":"Toruchaar stumbled."},{"id":"manas-2010:p0507:b001:l038","ordinal":23122,"en":"The headlong blue-maned one's"},{"id":"manas-2010:p0507:b001:l039","ordinal":23123,"en":"Toruchaar beneath him—"},{"id":"manas-2010:p0507:b001:l040","ordinal":23124,"en":"Karazhoy shot it down."},{"id":"manas-2010:p0507:b001:l041","ordinal":23125,"en":"Those bearing nets of iron rope,"},{"id":"manas-2010:p0507:b001:l042","ordinal":23126,"en":"As we gathered them all,"},{"id":"manas-2010:p0508:b001:l001","ordinal":23127,"en":"As we were about to seize him,"},{"id":"manas-2010:p0508:b001:l002","ordinal":23128,"en":"A roar arose before us."},{"id":"manas-2010:p0508:b001:l003","ordinal":23129,"en":"Shouting the battle cry ‘Manas!’"},{"id":"manas-2010:p0508:b001:l004","ordinal":23130,"en":"He began a terrible slaughter."},{"id":"manas-2010:p0508:b001:l005","ordinal":23131,"en":"Khan Koshoy of the Katagan"},{"id":"manas-2010:p0508:b001:l006","ordinal":23132,"en":"Joined that blood-drinker"},{"id":"manas-2010:p0508:b001:l007","ordinal":23133,"en":"And slaughtered us utterly."},{"id":"manas-2010:p0508:b001:l008","ordinal":23134,"en":"This Manas of the Burut"},{"id":"manas-2010:p0508:b001:l009","ordinal":23135,"en":"Could conquer the world."},{"id":"manas-2010:p0508:b001:l010","ordinal":23136,"en":"Let a murderous people surge upon him—"},{"id":"manas-2010:p0508:b001:l011","ordinal":23137,"en":"That wretched Burut is mighty enough"},{"id":"manas-2010:p0508:b001:l012","ordinal":23138,"en":"To slaughter them all."},{"id":"manas-2010:p0508:b001:l013","ordinal":23139,"en":"When the champions faced him,"},{"id":"manas-2010:p0508:b001:l014","ordinal":23140,"en":"Of lord Manas the champion"},{"id":"manas-2010:p0508:b001:l015","ordinal":23141,"en":"I saw the terrible unrest."},{"id":"manas-2010:p0508:b001:l016","ordinal":23142,"en":"He unleashed a fierce fury;"},{"id":"manas-2010:p0508:b001:l017","ordinal":23143,"en":"The wrestler who approached him"},{"id":"manas-2010:p0508:b001:l018","ordinal":23144,"en":"He split through the waist."},{"id":"manas-2010:p0508:b001:l019","ordinal":23145,"en":"His menace fierce, his wrath strong,"},{"id":"manas-2010:p0508:b001:l020","ordinal":23146,"en":"That bastard Burut of yours"},{"id":"manas-2010:p0508:b001:l021","ordinal":23147,"en":"Slaughtered us outright."},{"id":"manas-2010:p0508:b001:l022","ordinal":23148,"en":"He unleashed a fierce fury."},{"id":"manas-2010:p0508:b001:l023","ordinal":23149,"en":"We were an army of so many tümen;"},{"id":"manas-2010:p0508:b001:l024","ordinal":23150,"en":"All who had gone,"},{"id":"manas-2010:p0508:b001:l025","ordinal":23151,"en":"He slaughtered to the last."},{"id":"manas-2010:p0508:b001:l026","ordinal":23152,"en":"This Manas of the Burut"},{"id":"manas-2010:p0508:b001:l027","ordinal":23153,"en":"Is no ordinary boy,"},{"id":"manas-2010:p0508:b001:l028","ordinal":23154,"en":"The Chinese, the people of forty khans,"},{"id":"manas-2010:p0508:b001:l029","ordinal":23155,"en":"He is no slave who would spare them from ruin."},{"id":"manas-2010:p0508:b001:l030","ordinal":23156,"en":"He is renowned, he is a lion."},{"id":"manas-2010:p0508:b001:l031","ordinal":23157,"en":"No mortal can defeat him."},{"id":"manas-2010:p0508:b001:l032","ordinal":23158,"en":"No man who faces him remains"},{"id":"manas-2010:p0508:b001:l033","ordinal":23159,"en":"Alive and well, turned this way."},{"id":"manas-2010:p0508:b001:l034","ordinal":23160,"en":"Fighting through for six days,"},{"id":"manas-2010:p0508:b001:l035","ordinal":23161,"en":"Ezkara came out covered in blood,"},{"id":"manas-2010:p0508:b001:l036","ordinal":23162,"en":"Wounded in sixty places."},{"id":"manas-2010:p0508:b001:l037","ordinal":23163,"en":"Zholoy entered the fray,"},{"id":"manas-2010:p0508:b001:l038","ordinal":23164,"en":"Fighting through for seven days,"},{"id":"manas-2010:p0508:b001:l039","ordinal":23165,"en":"Wounded in seventy places."},{"id":"manas-2010:p0508:b001:l040","ordinal":23166,"en":"We barely came here to die;"},{"id":"manas-2010:p0508:b001:l041","ordinal":23167,"en":"We met a grievous ordeal,"},{"id":"manas-2010:p0508:b001:l042","ordinal":23168,"en":"To behold the face of Judgment Day."},{"id":"manas-2010:p0509:b001:l001","ordinal":23169,"en":"We have come before you."},{"id":"manas-2010:p0509:b001:l002","ordinal":23170,"en":"The Burut brought the suffering."},{"id":"manas-2010:p0509:b001:l003","ordinal":23171,"en":"Your fine men wearing gemstones,"},{"id":"manas-2010:p0509:b001:l004","ordinal":23172,"en":"He slaughtered to the last."},{"id":"manas-2010:p0509:b001:l005","ordinal":23173,"en":"He made your affairs a calamity,"},{"id":"manas-2010:p0509:b001:l006","ordinal":23174,"en":"He destroyed many of your men."},{"id":"manas-2010:p0509:b001:l007","ordinal":23175,"en":"He showed us a dreadful spectacle;"},{"id":"manas-2010:p0509:b001:l008","ordinal":23176,"en":"He smashed your army to pieces."},{"id":"manas-2010:p0509:b001:l009","ordinal":23177,"en":"We stood exchanging blows,"},{"id":"manas-2010:p0509:b001:l010","ordinal":23178,"en":"Firing guns, drawing bows,"},{"id":"manas-2010:p0509:b001:l011","ordinal":23179,"en":"Clashing in battle."},{"id":"manas-2010:p0509:b001:l012","ordinal":23180,"en":"He laid your governor sprawling."},{"id":"manas-2010:p0509:b001:l013","ordinal":23181,"en":"The wrestler Orgo you sent,"},{"id":"manas-2010:p0509:b001:l014","ordinal":23182,"en":"With one thrust he laid him wide."},{"id":"manas-2010:p0509:b001:l015","ordinal":23183,"en":"He wrought tremendous ruin,"},{"id":"manas-2010:p0509:b001:l016","ordinal":23184,"en":"Destroying all he encountered,"},{"id":"manas-2010:p0509:b001:l017","ordinal":23185,"en":"Slaughtering them to the last."},{"id":"manas-2010:p0509:b001:l018","ordinal":23186,"en":"He brought far-reaching sorrow."},{"id":"manas-2010:p0509:b001:l019","ordinal":23187,"en":"If a monk fell into his hands,"},{"id":"manas-2010:p0509:b001:l020","ordinal":23188,"en":"That stubborn, wretched Burut"},{"id":"manas-2010:p0509:b001:l021","ordinal":23189,"en":"Slaughtered him, leaving him stiff."},{"id":"manas-2010:p0509:b001:l022","ordinal":23190,"en":"Grief and anguish in the heart—"},{"id":"manas-2010:p0509:b001:l023","ordinal":23191,"en":"We had failed to see"},{"id":"manas-2010:p0509:b001:l024","ordinal":23192,"en":"The enemy born in Altay."},{"id":"manas-2010:p0509:b001:l025","ordinal":23193,"en":"His fortune is complete."},{"id":"manas-2010:p0509:b001:l026","ordinal":23194,"en":"That Heaven-struck Burut"},{"id":"manas-2010:p0509:b001:l027","ordinal":23195,"en":"Is a hero beyond all the world."},{"id":"manas-2010:p0509:b001:l028","ordinal":23196,"en":"Kara-Suu of broad Altay—"},{"id":"manas-2010:p0509:b001:l029","ordinal":23197,"en":"This one cannot come of humankind."},{"id":"manas-2010:p0509:b001:l030","ordinal":23198,"en":"Slaughtering, butchering, destroying,"},{"id":"manas-2010:p0509:b001:l031","ordinal":23199,"en":"He brought uproar upon the wrestlers."},{"id":"manas-2010:p0509:b001:l032","ordinal":23200,"en":"Consider, my khan, think it over;"},{"id":"manas-2010:p0509:b001:l033","ordinal":23201,"en":"This one cannot come of mortals!"},{"id":"manas-2010:p0509:b001:l034","ordinal":23202,"en":"None who met him survived."},{"id":"manas-2010:p0509:b001:l035","ordinal":23203,"en":"The fierce-wrathed blood-drinker—"},{"id":"manas-2010:p0509:b001:l036","ordinal":23204,"en":"No wrestler dared approach him."},{"id":"manas-2010:p0509:b001:l037","ordinal":23205,"en":"Shaping a plan, pondering a thought,"},{"id":"manas-2010:p0509:b001:l038","ordinal":23206,"en":"To shoot his horse down"},{"id":"manas-2010:p0509:b001:l039","ordinal":23207,"en":"And then seize him,"},{"id":"manas-2010:p0509:b001:l040","ordinal":23208,"en":"We readied a swift foot-runner."},{"id":"manas-2010:p0509:b001:l041","ordinal":23209,"en":"Karazhoy was resourceful;"},{"id":"manas-2010:p0509:b001:l042","ordinal":23210,"en":"He unleashed a fierce fury,"},{"id":"manas-2010:p0510:b001:l001","ordinal":23211,"en":"Leaving Toruchaar in a heap,"},{"id":"manas-2010:p0510:b001:l002","ordinal":23212,"en":"He shot it down then."},{"id":"manas-2010:p0510:b001:l003","ordinal":23213,"en":"When the great fellow was left on foot,"},{"id":"manas-2010:p0510:b001:l004","ordinal":23214,"en":"To bring him bound to you,"},{"id":"manas-2010:p0510:b001:l005","ordinal":23215,"en":"To offer the Burut as tribute"},{"id":"manas-2010:p0510:b001:l006","ordinal":23216,"en":"And give him to you yourself,"},{"id":"manas-2010:p0510:b001:l007","ordinal":23217,"en":"We shouted and leveled our spears."},{"id":"manas-2010:p0510:b001:l008","ordinal":23218,"en":"Day and night for seven days,"},{"id":"manas-2010:p0510:b001:l009","ordinal":23219,"en":"We fought him as he stood on foot."},{"id":"manas-2010:p0510:b001:l010","ordinal":23220,"en":"When he lunged, he was a gray tiger;"},{"id":"manas-2010:p0510:b001:l011","ordinal":23221,"en":"Thinking of it, no such soul could exist."},{"id":"manas-2010:p0510:b001:l012","ordinal":23222,"en":"That bastard blood-drinker,"},{"id":"manas-2010:p0510:b001:l013","ordinal":23223,"en":"That deceiver who ruins the world—"},{"id":"manas-2010:p0510:b001:l014","ordinal":23224,"en":"When we look at him, our hearts falter."},{"id":"manas-2010:p0510:b001:l015","ordinal":23225,"en":"He looks unlike a mortal."},{"id":"manas-2010:p0510:b001:l016","ordinal":23226,"en":"At one glance, one man;"},{"id":"manas-2010:p0510:b001:l017","ordinal":23227,"en":"That bastard blood-drinker of yours,"},{"id":"manas-2010:p0510:b001:l018","ordinal":23228,"en":"At another glance, a thousand men."},{"id":"manas-2010:p0510:b001:l019","ordinal":23229,"en":"When he charges head-on,"},{"id":"manas-2010:p0510:b001:l020","ordinal":23230,"en":"None facing him can hold firm;"},{"id":"manas-2010:p0510:b001:l021","ordinal":23231,"en":"He has the form of a dragon."},{"id":"manas-2010:p0510:b001:l022","ordinal":23232,"en":"When seen from behind,"},{"id":"manas-2010:p0510:b001:l023","ordinal":23233,"en":"He has the menace of six thousand heroes."},{"id":"manas-2010:p0510:b001:l024","ordinal":23234,"en":"We returned unable to take Manas."},{"id":"manas-2010:p0510:b001:l025","ordinal":23235,"en":"He is a falcon, he is a lion;"},{"id":"manas-2010:p0510:b001:l026","ordinal":23236,"en":"His deeds different, his wrath fierce,"},{"id":"manas-2010:p0510:b001:l027","ordinal":23237,"en":"He is a hero who ruins the world."},{"id":"manas-2010:p0510:b001:l028","ordinal":23238,"en":"Turning about, his great frame looming,"},{"id":"manas-2010:p0510:b001:l029","ordinal":23239,"en":"The Burut was left on foot."},{"id":"manas-2010:p0510:b001:l030","ordinal":23240,"en":"The elders of profound wisdom,"},{"id":"manas-2010:p0510:b001:l031","ordinal":23241,"en":"We drove in against Manas,"},{"id":"manas-2010:p0510:b001:l032","ordinal":23242,"en":"All the wrestlers."},{"id":"manas-2010:p0510:b001:l033","ordinal":23243,"en":"Those bearing nets of iron rope,"},{"id":"manas-2010:p0510:b001:l034","ordinal":23244,"en":"We drove them all in and went,"},{"id":"manas-2010:p0510:b001:l035","ordinal":23245,"en":"All those with daggers in their hands."},{"id":"manas-2010:p0510:b001:l036","ordinal":23246,"en":"When we launched the mass attack,"},{"id":"manas-2010:p0510:b001:l037","ordinal":23247,"en":"When we sent up the shouting,"},{"id":"manas-2010:p0510:b001:l038","ordinal":23248,"en":"To seize the blood-drinker,"},{"id":"manas-2010:p0510:b001:l039","ordinal":23249,"en":"When we summoned our courage,"},{"id":"manas-2010:p0510:b001:l040","ordinal":23250,"en":"When shouting, we leveled our spears,"},{"id":"manas-2010:p0510:b001:l041","ordinal":23251,"en":"They broke through the middle and shortened;"},{"id":"manas-2010:p0510:b001:l042","ordinal":23252,"en":"Those bearing nets of iron rope,"},{"id":"manas-2010:p0511:b001:l001","ordinal":23253,"en":"All those with daggers in their hands"},{"id":"manas-2010:p0511:b001:l002","ordinal":23254,"en":"Died, stretched out stiff."},{"id":"manas-2010:p0511:b001:l003","ordinal":23255,"en":"Thrusting spears, firing shots,"},{"id":"manas-2010:p0511:b001:l004","ordinal":23256,"en":"Grappling, unable to prevail,"},{"id":"manas-2010:p0511:b001:l005","ordinal":23257,"en":"We two, Ezkara and Zholoy,"},{"id":"manas-2010:p0511:b001:l006","ordinal":23258,"en":"Were left standing alone."},{"id":"manas-2010:p0511:b001:l007","ordinal":23259,"en":"The blood-drinker born in Altay,"},{"id":"manas-2010:p0511:b001:l008","ordinal":23260,"en":"His slaughter and crushing of wrestlers—"},{"id":"manas-2010:p0511:b001:l009","ordinal":23261,"en":"As I observe his bearing,"},{"id":"manas-2010:p0511:b001:l010","ordinal":23262,"en":"He is Kakan-Chin's enemy."},{"id":"manas-2010:p0511:b001:l011","ordinal":23263,"en":"He unleashed a fierce fury."},{"id":"manas-2010:p0511:b001:l012","ordinal":23264,"en":"Khan Esenkan, hear these words:"},{"id":"manas-2010:p0511:b001:l013","ordinal":23265,"en":"The soldiers like black jackdaws,"},{"id":"manas-2010:p0511:b001:l014","ordinal":23266,"en":"He slaughtered, leaving none."},{"id":"manas-2010:p0511:b001:l015","ordinal":23267,"en":"The khan who claimed greatness died."},{"id":"manas-2010:p0511:b001:l016","ordinal":23268,"en":"At that bastard Burut's hands,"},{"id":"manas-2010:p0511:b001:l017","ordinal":23269,"en":"All those many souls died."},{"id":"manas-2010:p0511:b001:l018","ordinal":23270,"en":"None he met withdrew without dying;"},{"id":"manas-2010:p0511:b001:l019","ordinal":23271,"en":"None who faced him returned alive."},{"id":"manas-2010:p0511:b001:l020","ordinal":23272,"en":"Many of the monks died."},{"id":"manas-2010:p0511:b001:l021","ordinal":23273,"en":"At that bastard Burut's hands,"},{"id":"manas-2010:p0511:b001:l022","ordinal":23274,"en":"Every soul he met died."},{"id":"manas-2010:p0511:b001:l023","ordinal":23275,"en":"Where in Altay was he born,"},{"id":"manas-2010:p0511:b001:l024","ordinal":23276,"en":"Your father's grave! This Burut,"},{"id":"manas-2010:p0511:b001:l025","ordinal":23277,"en":"Who brought uproar upon the world!"},{"id":"manas-2010:p0511:b001:l026","ordinal":23278,"en":"That wretched Burut is beyond measure."},{"id":"manas-2010:p0511:b001:l027","ordinal":23279,"en":"Anywhere ears have heard or eyes have seen,"},{"id":"manas-2010:p0511:b001:l028","ordinal":23280,"en":"No such dog has ever arisen!"},{"id":"manas-2010:p0511:b001:l029","ordinal":23281,"en":"He is no boy who will spare a soul."},{"id":"manas-2010:p0511:b001:l030","ordinal":23282,"en":"Kakan-Chin and Beijing,"},{"id":"manas-2010:p0511:b001:l031","ordinal":23283,"en":"He is no slave who will leave them in peace."},{"id":"manas-2010:p0511:b001:l032","ordinal":23284,"en":"On the plain of broad Altay,"},{"id":"manas-2010:p0511:b001:l033","ordinal":23285,"en":"We fought with the blood-drinker"},{"id":"manas-2010:p0511:b001:l034","ordinal":23286,"en":"In the mild, cool autumn."},{"id":"manas-2010:p0511:b001:l035","ordinal":23287,"en":"We fired many volleys,"},{"id":"manas-2010:p0511:b001:l036","ordinal":23288,"en":"We kept launching mass attacks."},{"id":"manas-2010:p0511:b001:l037","ordinal":23289,"en":"Firing guns, drawing bows,"},{"id":"manas-2010:p0511:b001:l038","ordinal":23290,"en":"We surged fiercely in battle."},{"id":"manas-2010:p0511:b001:l039","ordinal":23291,"en":"Many a champion khan died."},{"id":"manas-2010:p0511:b001:l040","ordinal":23292,"en":"He girded his waist with a leather belt;"},{"id":"manas-2010:p0511:b001:l041","ordinal":23293,"en":"When an army filled the land,"},{"id":"manas-2010:p0511:b001:l042","ordinal":23294,"en":"He entered alone and attacked."},{"id":"manas-2010:p0512:b001:l001","ordinal":23295,"en":"Humming, he pays no heed."},{"id":"manas-2010:p0512:b001:l002","ordinal":23296,"en":"The great lords and giants,"}]
