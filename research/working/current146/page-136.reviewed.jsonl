{"id": "sayakbay-ms-current146:pdf136:l001", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 1, "raw": "Асыл жанды күйгүзүп,", "text": "Асыл жанды күйгүзүп,", "en": "Letting noble souls burn with grief,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l002", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 2, "raw": "Кан башыңды кор кылып,", "text": "Кан башыңды кор кылып,", "en": "Bringing disgrace upon your royal head,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct manuscript reading; this expanded or variant line lacks a secure exact printed counterpart, or contains ambiguous cursive.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l003", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 3, "raw": "Эки бетти кага кылып,", "text": "Эки бетти кага кылып,", "en": "Turning both cheeks pale,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct manuscript reading; this expanded or variant line lacks a secure exact printed counterpart, or contains ambiguous cursive.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l004", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 4, "raw": "Ага душман доңузду,", "text": "Ага душман доңузду,", "en": "That enemy swine,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct manuscript reading; this expanded or variant line lacks a secure exact printed counterpart, or contains ambiguous cursive.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l005", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 5, "raw": "Бу кыргызга доо кылып,", "text": "Бу кыргызга доо кылып,", "en": "Inflicting harm upon these Kyrgyz,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct manuscript reading; this expanded or variant line lacks a secure exact printed counterpart, or contains ambiguous cursive.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 6, "raw": "Бузулган күндү көргүчө,", "text": "Бузулган күндү көргүчө,", "en": "Rather than see the day of ruin,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 7, "raw": "Бир күндө миң жол өлгүчө,", "text": "Бир күндө миң жол өлгүчө,", "en": "Rather than die a thousand deaths in one day,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 8, "raw": "Бу кордукту көргүчө,", "text": "Бу кордукту көргүчө,", "en": "Rather than witness this humiliation,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 9, "raw": "Берекелүү колу алып,", "text": "Берекелүү колу алып,", "en": "Taking away the blessed host,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct manuscript reading; this expanded or variant line lacks a secure exact printed counterpart, or contains ambiguous cursive.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 10, "raw": "Кара болгон кан кылып,", "text": "Кара болгон кан кылып,", "en": "Turning the khan’s fate black,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct manuscript reading; this expanded or variant line lacks a secure exact printed counterpart, or contains ambiguous cursive.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 11, "raw": "Эки колун шал кылып,", "text": "Эки колун шал кылып,", "en": "Paralyzing both his arms,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct manuscript reading; this expanded or variant line lacks a secure exact printed counterpart, or contains ambiguous cursive.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 12, "raw": "Чөп отоого мал кылып,", "text": "Чөп отоого мал кылып,", "en": "Making him livestock that grazes grass,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct manuscript reading; this expanded or variant line lacks a secure exact printed counterpart, or contains ambiguous cursive.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l013", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 13, "raw": "Айлаганы кор кылып,", "text": "Айлаганы кор кылып,", "en": "Reducing all he does to disgrace,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct manuscript reading; this expanded or variant line lacks a secure exact printed counterpart, or contains ambiguous cursive.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 14, "raw": "Ак калпак журтту кор кылып,", "text": "Ак калпак журтту кор кылып,", "en": "Making the white-kalpak people wretched,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 15, "raw": "Душманга элди бергиче,", "text": "Душманга элди бергиче,", "en": "Rather than surrender the people to the enemy,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 16, "raw": "Жазуу ушундай көрөйүн,", "text": "Жазуу ушундай көрөйүн,", "en": "Let me meet the fate written thus,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 17, "raw": "Курган журттун алдына,", "text": "Курган журттун алдына,", "en": "Before my suffering people,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 18, "raw": "Курман болуп өлөйүн,", "text": "Курман болуп өлөйүн,", "en": "Let me die as a sacrifice,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 19, "raw": "Кутурган кара калдайга,", "text": "Кутурган кара калдайга,", "en": "Before the rabid black kalday,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 20, "raw": "Кара тажаал кордугуна,", "text": "Кара тажаал кордугуна,", "en": "Before the humiliation of that black fiend,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct manuscript reading; this expanded or variant line lacks a secure exact printed counterpart, or contains ambiguous cursive.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 21, "raw": "Маңдайлашып көрөйүн!", "text": "Маңдайлашып көрөйүн!", "en": "Let me face him head-on!", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 22, "raw": "Эңдирсем элди беремин,", "text": "Эңдирсем элди беремин,", "en": "If I let myself be driven back, I will yield my people,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 23, "raw": "Шам чырактай кайран көз,", "text": "Шам чырактай кайран көз,", "en": "These precious eyes, bright as a lamp,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l024", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 24, "raw": "Тештирсем элим беремин,", "text": "Тештирсем элим беремин,", "en": "If I let them be pierced, I will yield my people,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 25, "raw": "Алтын сындуу кайран баш,", "text": "Алтын сындуу кайран баш,", "en": "This precious head, like gold,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 26, "raw": "Кестирсем элим беремин.", "text": "Кестирсем элим беремин.", "en": "If I let it be cut off, I will yield my people.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 27, "raw": "Чатакташпай, чырдашпай,", "text": "Чатакташпай, чырдашпай,", "en": "Without clashing and contending,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 28, "raw": "Маңдайлашып турушпай,", "text": "Маңдайлашып турушпай,", "en": "Without standing face-to-face,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 29, "raw": "Кыйкырып айза сунушпай,", "text": "Кыйкырып айза сунушпай,", "en": "Without shouting and leveling spears,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 30, "raw": "Кыйын чатак кылышпай,", "text": "Кыйын чатак кылышпай,", "en": "Without waging a fierce struggle,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 31, "raw": "Кайраты канча көрүшпөй,", "text": "Кайраты канча көрүшпөй,", "en": "Without testing how great his courage is,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 32, "raw": "Карсылдашып өлүшпөй,", "text": "Карсылдашып өлүшпөй,", "en": "Without crashing together and dying in battle,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf136:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 136, "folio": 519, "line_in_page": 33, "raw": "Кантип журтум беремин!?", "text": "Кантип журтум беремин!?", "en": "How could I surrender my people!?", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
