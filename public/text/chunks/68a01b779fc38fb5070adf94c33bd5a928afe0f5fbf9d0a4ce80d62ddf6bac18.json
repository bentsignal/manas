[{"id":"manas-2010:p1598:b001:l033","ordinal":68865,"en":"For eight years, without dying or perishing,"},{"id":"manas-2010:p1598:b001:l034","ordinal":68866,"en":"I heard he suffered a lingering, incurable illness."},{"id":"manas-2010:p1598:b001:l035","ordinal":68867,"en":"If he recovers from his illness"},{"id":"manas-2010:p1598:b001:l036","ordinal":68868,"en":"And comes here,"},{"id":"manas-2010:p1598:b001:l037","ordinal":68869,"en":"He will leave none of us well;"},{"id":"manas-2010:p1598:b001:l038","ordinal":68870,"en":"He will spare none of us unharmed."},{"id":"manas-2010:p1598:b001:l039","ordinal":68871,"en":"An acrobat on horseback, a swift runner,"},{"id":"manas-2010:p1598:b001:l040","ordinal":68872,"en":"Who emerges when China is breaking apart,"},{"id":"manas-2010:p1598:b001:l041","ordinal":68873,"en":"The state's great marksman!”"},{"id":"manas-2010:p1598:b001:l042","ordinal":68874,"en":"Lamenting, he told Manas;"},{"id":"manas-2010:p1599:b001:l001","ordinal":68875,"en":"Before he could close his mouth,"},{"id":"manas-2010:p1599:b001:l002","ordinal":68876,"en":"Pale, mottled pennants and a red banner,"},{"id":"manas-2010:p1599:b001:l003","ordinal":68877,"en":"At that moment among the Chinese,"},{"id":"manas-2010:p1599:b001:l004","ordinal":68878,"en":"An uproar of cries arose."},{"id":"manas-2010:p1599:b001:l005","ordinal":68879,"en":"They had begun playing reed pipes;"},{"id":"manas-2010:p1599:b001:l006","ordinal":68880,"en":"For the Chinese to rejoice,"},{"id":"manas-2010:p1599:b001:l007","ordinal":68881,"en":"Their day had dawned."},{"id":"manas-2010:p1599:b001:l008","ordinal":68882,"en":"The spiritually powerful marksman Kojozhash"},{"id":"manas-2010:p1599:b001:l009","ordinal":68883,"en":"Had truly arrived."},{"id":"manas-2010:p1599:b003:l001","ordinal":68884,"en":"Khan Manas's forty companions,"},{"id":"manas-2010:p1599:b003:l002","ordinal":68885,"en":"Almambet and Chubak among them,"},{"id":"manas-2010:p1599:b003:l003","ordinal":68886,"en":"Entered battle in earnest;"},{"id":"manas-2010:p1599:b003:l004","ordinal":68887,"en":"The two khans, Muzburchak and Kökchö,"},{"id":"manas-2010:p1599:b003:l005","ordinal":68888,"en":"Entered battle again."},{"id":"manas-2010:p1599:b003:l006","ordinal":68889,"en":"“Into darkly looming Beijing,"},{"id":"manas-2010:p1599:b003:l007","ordinal":68890,"en":"I shall go straight and thrust my spear,” they said;"},{"id":"manas-2010:p1599:b003:l008","ordinal":68891,"en":"“From hell with its grievous burdens,"},{"id":"manas-2010:p1599:b003:l009","ordinal":68892,"en":"I shall free my soul,” they said."},{"id":"manas-2010:p1599:b003:l010","ordinal":68893,"en":"Serek and Syrgak, the two lions,"},{"id":"manas-2010:p1599:b003:l011","ordinal":68894,"en":"They too entered battle."},{"id":"manas-2010:p1599:b003:l012","ordinal":68895,"en":"The Muslims did not stand watching;"},{"id":"manas-2010:p1599:b003:l013","ordinal":68896,"en":"All entered battle."},{"id":"manas-2010:p1599:b003:l014","ordinal":68897,"en":"Raising dust in their center,"},{"id":"manas-2010:p1599:b003:l015","ordinal":68898,"en":"Your lordly Alma, your champion,"},{"id":"manas-2010:p1599:b003:l016","ordinal":68899,"en":"Bored his way forward."},{"id":"manas-2010:p1599:b003:l017","ordinal":68900,"en":"The massed Chinese,"},{"id":"manas-2010:p1599:b003:l018","ordinal":68901,"en":"Scattering and smashing their ranks,"},{"id":"manas-2010:p1599:b003:l019","ordinal":68902,"en":"“Trust to fate!” your Syrgak said,"},{"id":"manas-2010:p1599:b003:l020","ordinal":68903,"en":"And came slaughtering them."},{"id":"manas-2010:p1599:b003:l021","ordinal":68904,"en":"Of the Chinese wearing rank buttons,"},{"id":"manas-2010:p1599:b003:l022","ordinal":68905,"en":"Separating the finest,"},{"id":"manas-2010:p1599:b003:l023","ordinal":68906,"en":"Almambet, Azizkan's son,"},{"id":"manas-2010:p1599:b003:l024","ordinal":68907,"en":"Drove them before him in pursuit;"},{"id":"manas-2010:p1599:b003:l025","ordinal":68908,"en":"Riding Kögala and shouting,"},{"id":"manas-2010:p1599:b003:l026","ordinal":68909,"en":"Calling the battle cry, “Manas!”"},{"id":"manas-2010:p1599:b003:l027","ordinal":68910,"en":"The seething Chinese and Manchus,"},{"id":"manas-2010:p1600:b001:l001","ordinal":68911,"en":"Again barring and scattering them,"},{"id":"manas-2010:p1600:b001:l002","ordinal":68912,"en":"“If death is due, I shall die,” they said;"},{"id":"manas-2010:p1600:b001:l003","ordinal":68913,"en":"“If I remain alive,"},{"id":"manas-2010:p1600:b001:l004","ordinal":68914,"en":"To Almambet, Chubak and Syrgak,"},{"id":"manas-2010:p1600:b001:l005","ordinal":68915,"en":"I shall give support,” they said."},{"id":"manas-2010:p1600:b001:l006","ordinal":68916,"en":"Old Kyrgyl, chief of the forty,"},{"id":"manas-2010:p1600:b001:l007","ordinal":68917,"en":"Shuutu, with his cap like a yurt's felt covering,"},{"id":"manas-2010:p1600:b001:l008","ordinal":68918,"en":"Ajybay, Argynkan's son,"},{"id":"manas-2010:p1600:b001:l009","ordinal":68919,"en":"Yraman's Singer's Son,"},{"id":"manas-2010:p1600:b001:l010","ordinal":68920,"en":"Strong-armed Baychoro,"},{"id":"manas-2010:p1600:b001:l011","ordinal":68921,"en":"Agayar, breaker of ranks,"},{"id":"manas-2010:p1600:b001:l012","ordinal":68922,"en":"Serek, darting about,"},{"id":"manas-2010:p1600:b001:l013","ordinal":68923,"en":"The agile one who sprang into action,"},{"id":"manas-2010:p1600:b001:l014","ordinal":68924,"en":"Kara Tölök, the diviner,"},{"id":"manas-2010:p1600:b001:l015","ordinal":68925,"en":"When a day of need came to the Muslims,"},{"id":"manas-2010:p1600:b001:l016","ordinal":68926,"en":"Those dear lives were needed."},{"id":"manas-2010:p1600:b001:l017","ordinal":68927,"en":"The forty companions together,"},{"id":"manas-2010:p1600:b001:l018","ordinal":68928,"en":"Making a road wherever they encountered the foe,"},{"id":"manas-2010:p1600:b001:l019","ordinal":68929,"en":"Meeting them without sparing their own lives,"},{"id":"manas-2010:p1600:b001:l020","ordinal":68930,"en":"Attacking and slaughtering the Chinese,"},{"id":"manas-2010:p1600:b001:l021","ordinal":68931,"en":"Never drawing back from death,"},{"id":"manas-2010:p1600:b001:l022","ordinal":68932,"en":"Never sated with red blood,"},{"id":"manas-2010:p1600:b001:l023","ordinal":68933,"en":"When the battle grew fierce,"},{"id":"manas-2010:p1600:b001:l024","ordinal":68934,"en":"Never shrinking and fleeing,"},{"id":"manas-2010:p1600:b001:l025","ordinal":68935,"en":"Had come to settle in Talas,"},{"id":"manas-2010:p1600:b001:l026","ordinal":68936,"en":"Had become Manas's companions."},{"id":"manas-2010:p1600:b001:l027","ordinal":68937,"en":"Girding their waists securely,"},{"id":"manas-2010:p1600:b001:l028","ordinal":68938,"en":"If seven vast hosts came,"},{"id":"manas-2010:p1600:b001:l029","ordinal":68939,"en":"They attacked with coats flung loose;"},{"id":"manas-2010:p1600:b001:l030","ordinal":68940,"en":"Khan Manas's forty companions,"},{"id":"manas-2010:p1600:b001:l031","ordinal":68941,"en":"Not only the Chinese people—"},{"id":"manas-2010:p1600:b001:l032","ordinal":68942,"en":"Before this, the forty companions"},{"id":"manas-2010:p1600:b001:l033","ordinal":68943,"en":"Had taken spoils from seventy lands,"},{"id":"manas-2010:p1600:b001:l034","ordinal":68944,"en":"Made bloody all whom they met,"},{"id":"manas-2010:p1600:b001:l035","ordinal":68945,"en":"And majestic Manas"},{"id":"manas-2010:p1600:b001:l036","ordinal":68946,"en":"Had made khan upon the earth."},{"id":"manas-2010:p1600:b001:l037","ordinal":68947,"en":"When Manas gave the command,"},{"id":"manas-2010:p1600:b001:l038","ordinal":68948,"en":"Told to take a cap, they cut off a head;"},{"id":"manas-2010:p1600:b001:l039","ordinal":68949,"en":"Told to spill blood, they spilled stomach contents;"},{"id":"manas-2010:p1600:b001:l040","ordinal":68950,"en":"Told to drink water, they drank poison;"},{"id":"manas-2010:p1600:b001:l041","ordinal":68951,"en":"Set grass-grown land ablaze,"},{"id":"manas-2010:p1600:b001:l042","ordinal":68952,"en":"Burned the grassy meadows,"},{"id":"manas-2010:p1601:b001:l001","ordinal":68953,"en":"Pouring blood into clear water,"},{"id":"manas-2010:p1601:b001:l002","ordinal":68954,"en":"Raising an uproar wherever they grappled,"},{"id":"manas-2010:p1601:b001:l003","ordinal":68955,"en":"Khan Manas's forty companions,"},{"id":"manas-2010:p1601:b001:l004","ordinal":68956,"en":"Into the multitude of Chinese,"},{"id":"manas-2010:p1601:b001:l005","ordinal":68957,"en":"Entered to fight."},{"id":"manas-2010:p1601:b001:l006","ordinal":68958,"en":"The palm-sized Muslim force,"},{"id":"manas-2010:p1601:b001:l007","ordinal":68959,"en":"Those who survived the dead,"},{"id":"manas-2010:p1601:b001:l008","ordinal":68960,"en":"All entered battle."},{"id":"manas-2010:p1601:b001:l009","ordinal":68961,"en":"Muzburchak and Kökchö, their names in harmony,"},{"id":"manas-2010:p1601:b001:l010","ordinal":68962,"en":"With so many, many troops,"},{"id":"manas-2010:p1601:b001:l011","ordinal":68963,"en":"Entered battle again."},{"id":"manas-2010:p1601:b001:l012","ordinal":68964,"en":"Among beasts, peerless horses died;"},{"id":"manas-2010:p1601:b001:l013","ordinal":68965,"en":"Among men, lions died;"},{"id":"manas-2010:p1601:b001:l014","ordinal":68966,"en":"Those who remained alive"},{"id":"manas-2010:p1601:b001:l015","ordinal":68967,"en":"Were covered in black blood."},{"id":"manas-2010:p1601:b001:l016","ordinal":68968,"en":"With battle-axes, they grew weary;"},{"id":"manas-2010:p1601:b001:l017","ordinal":68969,"en":"The warriors who had courage,"},{"id":"manas-2010:p1601:b001:l018","ordinal":68970,"en":"Standing without fleeing, meeting the spear,"},{"id":"manas-2010:p1601:b001:l019","ordinal":68971,"en":"Thrust right into the heart."},{"id":"manas-2010:p1601:b001:l020","ordinal":68972,"en":"Their heroes stood out;"},{"id":"manas-2010:p1601:b001:l021","ordinal":68973,"en":"So many had their blood spilled."},{"id":"manas-2010:p1601:b001:l022","ordinal":68974,"en":"The utter cowards straggled,"},{"id":"manas-2010:p1601:b001:l023","ordinal":68975,"en":"Sheltering their bare lives,"},{"id":"manas-2010:p1601:b001:l024","ordinal":68976,"en":"Separating into the middle,"},{"id":"manas-2010:p1601:b001:l025","ordinal":68977,"en":"Flailing about in pretense,"},{"id":"manas-2010:p1601:b001:l026","ordinal":68978,"en":"Making a show of being heroes;"},{"id":"manas-2010:p1601:b001:l027","ordinal":68979,"en":"Those who did not stir when a spear struck,"},{"id":"manas-2010:p1601:b001:l028","ordinal":68980,"en":"Their lions stood apart."},{"id":"manas-2010:p1601:b001:l029","ordinal":68981,"en":"Roaring as they fought,"},{"id":"manas-2010:p1601:b001:l030","ordinal":68982,"en":"Not sparing their own lives,"},{"id":"manas-2010:p1601:b001:l031","ordinal":68983,"en":"On many, many steeds,"},{"id":"manas-2010:p1601:b001:l032","ordinal":68984,"en":"The saddlecloths hung upon their necks."},{"id":"manas-2010:p1601:b001:l033","ordinal":68985,"en":"Many, many steeds,"},{"id":"manas-2010:p1601:b001:l034","ordinal":68986,"en":"Even more men led as spare mounts;"},{"id":"manas-2010:p1601:b001:l035","ordinal":68987,"en":"“My dear kinsman, so-and-so,"},{"id":"manas-2010:p1601:b001:l036","ordinal":68988,"en":"Died at such-and-such a place,” they said;"},{"id":"manas-2010:p1601:b001:l037","ordinal":68989,"en":"Even more went about lamenting."},{"id":"manas-2010:p1601:b001:l038","ordinal":68990,"en":"So many fine warriors"},{"id":"manas-2010:p1601:b001:l039","ordinal":68991,"en":"Had their cruppers break;"},{"id":"manas-2010:p1601:b001:l040","ordinal":68992,"en":"Many could not stitch them together;"},{"id":"manas-2010:p1601:b001:l041","ordinal":68993,"en":"Their saddle-girths snapped:"},{"id":"manas-2010:p1601:b001:l042","ordinal":68994,"en":"“If they overrun us, we are dead,” they said,"},{"id":"manas-2010:p1602:b001:l001","ordinal":68995,"en":"Many lay unable to manage it."},{"id":"manas-2010:p1602:b001:l002","ordinal":68996,"en":"Struck by spears, they reeled,"},{"id":"manas-2010:p1602:b001:l003","ordinal":68997,"en":"Unable to walk, they staggered,"},{"id":"manas-2010:p1602:b001:l004","ordinal":68998,"en":"Their lives departing, they trembled,"},{"id":"manas-2010:p1602:b001:l005","ordinal":68999,"en":"Unable to gather their wits,"},{"id":"manas-2010:p1602:b001:l006","ordinal":69000,"en":"Still more were fleeing."},{"id":"manas-2010:p1602:b001:l007","ordinal":69001,"en":"Making their winged steeds prance,"},{"id":"manas-2010:p1602:b001:l008","ordinal":69002,"en":"Still more were bounding about:"},{"id":"manas-2010:p1602:b001:l009","ordinal":69003,"en":"“Without returning to our homes,"},{"id":"manas-2010:p1602:b001:l010","ordinal":69004,"en":"Without escaping safe and sound,"},{"id":"manas-2010:p1602:b001:l011","ordinal":69005,"en":"We are doomed to die out here!”"},{"id":"manas-2010:p1602:b001:l012","ordinal":69006,"en":"Still more were weeping."},{"id":"manas-2010:p1602:b001:l013","ordinal":69007,"en":"Grasping spears, breaking ranks,"},{"id":"manas-2010:p1602:b001:l014","ordinal":69008,"en":"Struck by bullets when death came,"},{"id":"manas-2010:p1602:b001:l015","ordinal":69009,"en":"To die while fighting—"},{"id":"manas-2010:p1602:b001:l016","ordinal":69010,"en":"Still more rejoiced in that."},{"id":"manas-2010:p1602:b001:l017","ordinal":69011,"en":"Trenches had been dug in layers,"},{"id":"manas-2010:p1602:b001:l018","ordinal":69012,"en":"Misery had been set to boil;"},{"id":"manas-2010:p1602:b001:l019","ordinal":69013,"en":"They never tired of swarming in,"},{"id":"manas-2010:p1602:b001:l020","ordinal":69014,"en":"The peoples of forty khans together."},{"id":"manas-2010:p1602:b001:l021","ordinal":69015,"en":"A lion supported by sacred powers,"},{"id":"manas-2010:p1602:b001:l022","ordinal":69016,"en":"Alöökö's Kongurbay"},{"id":"manas-2010:p1602:b001:l023","ordinal":69017,"en":"Was a hero born exceptional."},{"id":"manas-2010:p1602:b001:l024","ordinal":69018,"en":"The Chinese khan Ay Jangjung,"},{"id":"manas-2010:p1602:b001:l025","ordinal":69019,"en":"To join the grim-faced one,"},{"id":"manas-2010:p1602:b001:l026","ordinal":69020,"en":"Had arrived by then."},{"id":"manas-2010:p1602:b001:l027","ordinal":69021,"en":"In the thick of battle,"},{"id":"manas-2010:p1602:b001:l028","ordinal":69022,"en":"At Kökchö, Aydarkan's son,"},{"id":"manas-2010:p1602:b001:l029","ordinal":69023,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1602:b001:l030","ordinal":69024,"en":"Came before he could cry “Ah!”"},{"id":"manas-2010:p1602:b001:l031","ordinal":69025,"en":"Reaching Kökchö there,"},{"id":"manas-2010:p1602:b001:l032","ordinal":69026,"en":"From Kögala's back"},{"id":"manas-2010:p1602:b001:l033","ordinal":69027,"en":"He knocked him down as he passed."},{"id":"manas-2010:p1602:b001:l034","ordinal":69028,"en":"You could not tell if they were worms,"},{"id":"manas-2010:p1602:b001:l035","ordinal":69029,"en":"You could not tell if they were sand;"},{"id":"manas-2010:p1602:b001:l036","ordinal":69030,"en":"The countless Chinese behind him"},{"id":"manas-2010:p1602:b001:l037","ordinal":69031,"en":"That hero born exceptional, Kökchö,"},{"id":"manas-2010:p1602:b001:l038","ordinal":69032,"en":"They surrounded on every side."},{"id":"manas-2010:p1602:b001:l039","ordinal":69033,"en":"Seeing this, Almambet,"},{"id":"manas-2010:p1602:b001:l040","ordinal":69034,"en":"Without looking around,"},{"id":"manas-2010:p1602:b001:l041","ordinal":69035,"en":"Without sparing his life at all,"},{"id":"manas-2010:p1602:b001:l042","ordinal":69036,"en":"In the opening and closing of an eye,"},{"id":"manas-2010:p1603:b001:l001","ordinal":69037,"en":"Before a word could be said,"},{"id":"manas-2010:p1603:b001:l002","ordinal":69038,"en":"Striking each of them a blow,"},{"id":"manas-2010:p1603:b001:l003","ordinal":69039,"en":"He plunged among the Chinese,"},{"id":"manas-2010:p1603:b001:l004","ordinal":69040,"en":"Drove them fleeing, attacked them;"},{"id":"manas-2010:p1603:b001:l005","ordinal":69041,"en":"Kökchö, taken captive—"},{"id":"manas-2010:p1603:b001:l006","ordinal":69042,"en":"Before Almambet could snatch him up,"},{"id":"manas-2010:p1603:b001:l007","ordinal":69043,"en":"Have you heard of him?"},{"id":"manas-2010:p1603:b001:l008","ordinal":69044,"en":"A trick rider, swift on foot,"},{"id":"manas-2010:p1603:b001:l009","ordinal":69045,"en":"The state's great marksman,"},{"id":"manas-2010:p1603:b001:l010","ordinal":69046,"en":"Not to be subdued by a weakling,"},{"id":"manas-2010:p1603:b001:l011","ordinal":69047,"en":"In darkness, a needle's"},{"id":"manas-2010:p1603:b001:l012","ordinal":69048,"en":"Eye he could shoot without missing,"},{"id":"manas-2010:p1603:b001:l013","ordinal":69049,"en":"Whom no man could pass before,"},{"id":"manas-2010:p1603:b001:l014","ordinal":69050,"en":"Whose bullets never went to waste,"},{"id":"manas-2010:p1603:b001:l015","ordinal":69051,"en":"Kojozhash, Karazhoy's son,"},{"id":"manas-2010:p1603:b001:l016","ordinal":69052,"en":"Clad in green, came rushing up;"},{"id":"manas-2010:p1603:b001:l017","ordinal":69053,"en":"Aydarkan's Kökchö"},{"id":"manas-2010:p1603:b001:l018","ordinal":69054,"en":"He struck through the temple,"},{"id":"manas-2010:p1603:b001:l019","ordinal":69055,"en":"Bringing Kökchö down with a bullet."},{"id":"manas-2010:p1603:b001:l020","ordinal":69056,"en":"Their hearts were deeply troubled,"},{"id":"manas-2010:p1603:b001:l021","ordinal":69057,"en":"The Muslims grieved bitterly;"},{"id":"manas-2010:p1603:b001:l022","ordinal":69058,"en":"The Chinese, peoples of forty khans,"},{"id":"manas-2010:p1603:b001:l023","ordinal":69059,"en":"Laughed aloud in their joy."},{"id":"manas-2010:p1603:b001:l024","ordinal":69060,"en":"While the Chinese stood thus,"},{"id":"manas-2010:p1603:b001:l025","ordinal":69061,"en":"Plunging among them on Sarala,"},{"id":"manas-2010:p1603:b001:l026","ordinal":69062,"en":"Your Alma began the slaughter."},{"id":"manas-2010:p1603:b001:l027","ordinal":69063,"en":"Kojozhash, Karazhoy's son—"},{"id":"manas-2010:p1603:b001:l028","ordinal":69064,"en":"With his fearsome sword in hand,"},{"id":"manas-2010:p1603:b001:l029","ordinal":69065,"en":"He slashed him lengthwise."},{"id":"manas-2010:p1603:b001:l030","ordinal":69066,"en":"Struck by the sword's flat,"},{"id":"manas-2010:p1603:b001:l031","ordinal":69067,"en":"A coral stone the size of a flask"},{"id":"manas-2010:p1603:b001:l032","ordinal":69068,"en":"Shattered into fragments."},{"id":"manas-2010:p1603:b001:l033","ordinal":69069,"en":"Unable to withstand his fury,"},{"id":"manas-2010:p1603:b001:l034","ordinal":69070,"en":"The countless Manchus, the many Chinese,"},{"id":"manas-2010:p1603:b001:l035","ordinal":69071,"en":"Fled in a scattering rush."},{"id":"manas-2010:p1603:b001:l036","ordinal":69072,"en":"The Chinese khan Ay Jangjung"},{"id":"manas-2010:p1603:b001:l037","ordinal":69073,"en":"Drew across his path;"},{"id":"manas-2010:p1603:b001:l038","ordinal":69074,"en":"With golden forelock, tasseled belt,"},{"id":"manas-2010:p1603:b001:l039","ordinal":69075,"en":"Azizkan's only son"},{"id":"manas-2010:p1603:b001:l040","ordinal":69076,"en":"Jangjung, barring his way,"},{"id":"manas-2010:p1603:b001:l041","ordinal":69077,"en":"He flung aside as he passed."},{"id":"manas-2010:p1603:b001:l042","ordinal":69078,"en":"Behind him, the hero Syrgak,"},{"id":"manas-2010:p1604:b001:l001","ordinal":69079,"en":"Before six thousand Chinese, a thousand governors"},{"id":"manas-2010:p1604:b001:l002","ordinal":69080,"en":"Could lift him onto a horse,"},{"id":"manas-2010:p1604:b001:l003","ordinal":69081,"en":"From Jangjung, the Chinese khan,"},{"id":"manas-2010:p1604:b001:l004","ordinal":69082,"en":"Cut off his head."},{"id":"manas-2010:p1604:b001:l005","ordinal":69083,"en":"No man's strength could match him,"},{"id":"manas-2010:p1604:b001:l006","ordinal":69084,"en":"No lion's teeth could pierce him,"},{"id":"manas-2010:p1604:b001:l007","ordinal":69085,"en":"Tall of body, broad of shoulder,"},{"id":"manas-2010:p1604:b001:l008","ordinal":69086,"en":"Chubak, Akbaltay's son—"},{"id":"manas-2010:p1604:b001:l009","ordinal":69087,"en":"Ezkara, riding a great bay,"},{"id":"manas-2010:p1604:b001:l010","ordinal":69088,"en":"Was the khan of the Manchus;"},{"id":"manas-2010:p1604:b001:l011","ordinal":69089,"en":"Where he stood across the way,"},{"id":"manas-2010:p1604:b001:l012","ordinal":69090,"en":"Chubak, Akbaltay's son,"},{"id":"manas-2010:p1604:b001:l013","ordinal":69091,"en":"Knocked him down as he passed."},{"id":"manas-2010:p1604:b001:l014","ordinal":69092,"en":"Kanjar Kol, riding a swift runner,"},{"id":"manas-2010:p1604:b001:l015","ordinal":69093,"en":"Before he could shout and mount him,"},{"id":"manas-2010:p1604:b001:l016","ordinal":69094,"en":"Before he could save him alive,"},{"id":"manas-2010:p1604:b001:l017","ordinal":69095,"en":"Your fierce Alma reached them."},{"id":"manas-2010:p1604:b001:l018","ordinal":69096,"en":"Ezkara, the Chinese khan,"},{"id":"manas-2010:p1604:b001:l019","ordinal":69097,"en":"He cut into forty-two pieces,"},{"id":"manas-2010:p1604:b001:l020","ordinal":69098,"en":"And sixty of his noble officers"},{"id":"manas-2010:p1604:b001:l021","ordinal":69099,"en":"He struck down along with him."},{"id":"manas-2010:p1604:b001:l022","ordinal":69100,"en":"Look at the dust rising underfoot,"},{"id":"manas-2010:p1604:b001:l023","ordinal":69101,"en":"Look at the flowing blood,"},{"id":"manas-2010:p1604:b001:l024","ordinal":69102,"en":"Mixed with blood, face down,"},{"id":"manas-2010:p1604:b001:l025","ordinal":69103,"en":"Look at the fallen men!"},{"id":"manas-2010:p1604:b001:l026","ordinal":69104,"en":"You cannot catch sight of them."},{"id":"manas-2010:p1604:b001:l027","ordinal":69105,"en":"As though tumbleweeds had blown away,"},{"id":"manas-2010:p1604:b001:l028","ordinal":69106,"en":"You cannot tell where they are."},{"id":"manas-2010:p1604:b001:l029","ordinal":69107,"en":"The sky is clear, the earth overcast,"},{"id":"manas-2010:p1604:b001:l030","ordinal":69108,"en":"Not a single blade shows on the ground."},{"id":"manas-2010:p1604:b001:l031","ordinal":69109,"en":"Earth flies up, dust boils,"},{"id":"manas-2010:p1604:b001:l032","ordinal":69110,"en":"Meeting them in countless clashes,"},{"id":"manas-2010:p1604:b001:l033","ordinal":69111,"en":"They hold them back, misery boiling."},{"id":"manas-2010:p1604:b001:l034","ordinal":69112,"en":"Winged steeds die in swathes,"},{"id":"manas-2010:p1604:b001:l035","ordinal":69113,"en":"Mixed with the earth,"},{"id":"manas-2010:p1604:b001:l036","ordinal":69114,"en":"Ashen gray, heroes die."},{"id":"manas-2010:p1604:b001:l037","ordinal":69115,"en":"When the Chinese swarm over them,"},{"id":"manas-2010:p1604:b001:l038","ordinal":69116,"en":"When they inflict terrible torment,"},{"id":"manas-2010:p1604:b001:l039","ordinal":69117,"en":"Spearheads clash together,"},{"id":"manas-2010:p1604:b001:l040","ordinal":69118,"en":"Swords clash against swords;"},{"id":"manas-2010:p1604:b001:l041","ordinal":69119,"en":"Without turning back, the noble heroes,"},{"id":"manas-2010:p1604:b001:l042","ordinal":69120,"en":"Without rest by night or day,"}]
