{"id": "sayakbay-ms-current146:pdf201:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 201, "folio": 584, "line_in_page": 32, "raw": "Найза менен урду да,", "text": "Найза менен урду да,", "en": "He struck with the spear,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf201:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 201, "folio": 584, "line_in_page": 33, "raw": "Ары балбан, ары шер.", "text": "Ары балбан, ары шер.", "en": "Both a champion and a lion-hearted hero.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
