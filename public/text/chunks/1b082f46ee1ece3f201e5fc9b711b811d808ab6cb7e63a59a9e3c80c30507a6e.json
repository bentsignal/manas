[{"id":"semetey-1-2013:p1223:b004:l037","ordinal":170497,"en":"Surkoyon, touched by angels,"},{"id":"semetey-1-2013:p1223:b004:l038","ordinal":170498,"en":"Whom he had saddled five times over,"},{"id":"semetey-1-2013:p1223:b004:l039","ordinal":170499,"en":"Could not be caught at a blink,"},{"id":"semetey-1-2013:p1224:b003:l001","ordinal":170500,"en":"No beast could match him in a race."},{"id":"semetey-1-2013:p1224:b003:l002","ordinal":170501,"en":"With a camel-stallion forelock and low mane,"},{"id":"semetey-1-2013:p1224:b003:l003","ordinal":170502,"en":"His swiftness was plain;"},{"id":"semetey-1-2013:p1224:b003:l004","ordinal":170503,"en":"When tethered, he pulled the post"},{"id":"semetey-1-2013:p1224:b003:l005","ordinal":170504,"en":"Over with its head."},{"id":"semetey-1-2013:p1224:b003:l006","ordinal":170505,"en":"His muscles were like a bull's back,"},{"id":"semetey-1-2013:p1224:b003:l007","ordinal":170506,"en":"And his gait like the wind of the steppe."},{"id":"semetey-1-2013:p1224:b003:l008","ordinal":170507,"en":"His eyes shone like an argali's;"},{"id":"semetey-1-2013:p1224:b003:l009","ordinal":170508,"en":"When he ran at full stride,"},{"id":"semetey-1-2013:p1224:b003:l010","ordinal":170509,"en":"No horse could keep pace."},{"id":"semetey-1-2013:p1224:b003:l011","ordinal":170510,"en":"Hero Toltoi's Surkoyon"},{"id":"semetey-1-2013:p1224:b003:l012","ordinal":170511,"en":"Never tired when ridden scouting,"},{"id":"semetey-1-2013:p1224:b003:l013","ordinal":170512,"en":"Nor suffered when ridden with the baggage train;"},{"id":"semetey-1-2013:p1224:b003:l014","ordinal":170513,"en":"He did not weary if ridden six months."},{"id":"semetey-1-2013:p1224:b003:l015","ordinal":170514,"en":"That surpassing swift thoroughbred,"},{"id":"semetey-1-2013:p1224:b003:l016","ordinal":170515,"en":"Until he reached sixty years,"},{"id":"semetey-1-2013:p1224:b003:l017","ordinal":170516,"en":"Would not age or loosen his fangs."},{"id":"semetey-1-2013:p1224:b003:l018","ordinal":170517,"en":"To go as a bridegroom,"},{"id":"semetey-1-2013:p1224:b003:l019","ordinal":170518,"en":"To raid the Afghan city,"},{"id":"semetey-1-2013:p1224:b003:l020","ordinal":170519,"en":"To eat meat from one platter"},{"id":"semetey-1-2013:p1224:b003:l021","ordinal":170520,"en":"And face one another upon one bed,"},{"id":"semetey-1-2013:p1224:b003:l022","ordinal":170521,"en":"If Chürök proved kind,"},{"id":"semetey-1-2013:p1224:b003:l023","ordinal":170522,"en":"To weigh out gold by the foot"},{"id":"semetey-1-2013:p1224:b003:l024","ordinal":170523,"en":"And give it as the sister-in-law's fee;"},{"id":"semetey-1-2013:p1224:b003:l025","ordinal":170524,"en":"If Chürök proved cruel,"},{"id":"semetey-1-2013:p1224:b003:l026","ordinal":170525,"en":"He was about to enter the upheaval."},{"id":"semetey-1-2013:p1224:b003:l027","ordinal":170526,"en":"Toltoi's ninety youths"},{"id":"semetey-1-2013:p1224:b003:l028","ordinal":170527,"en":"Were skillful spearmen,"},{"id":"semetey-1-2013:p1224:b003:l029","ordinal":170528,"en":"Champions who knew without mercy"},{"id":"semetey-1-2013:p1224:b003:l030","ordinal":170529,"en":"The enemy's stratagems."},{"id":"semetey-1-2013:p1224:b003:l031","ordinal":170530,"en":"When a black gun cracked,"},{"id":"semetey-1-2013:p1224:b003:l032","ordinal":170531,"en":"They were heroes who did not flee;"},{"id":"semetey-1-2013:p1224:b003:l033","ordinal":170532,"en":"When a fierce gun snapped,"},{"id":"semetey-1-2013:p1224:b003:l034","ordinal":170533,"en":"They were heroes who did not start."},{"id":"semetey-1-2013:p1224:b003:l035","ordinal":170534,"en":"Hero Toltoi's Surkoyon"},{"id":"semetey-1-2013:p1224:b003:l036","ordinal":170535,"en":"Was fed rice and rice-chaff,"},{"id":"semetey-1-2013:p1224:b003:l037","ordinal":170536,"en":"And had his sweat drawn every day;"},{"id":"semetey-1-2013:p1224:b003:l038","ordinal":170537,"en":"He was fed his fill of barley,"},{"id":"semetey-1-2013:p1224:b003:l039","ordinal":170538,"en":"And had his sweat drawn every month."},{"id":"semetey-1-2013:p1224:b004:l001","ordinal":170539,"en":"He raced with birds in flight;"},{"id":"semetey-1-2013:p1224:b004:l002","ordinal":170540,"en":"Hero Toltoi's Surkoyon,"},{"id":"semetey-1-2013:p1224:b004:l003","ordinal":170541,"en":"His flank-flesh that would yield rump-fat"},{"id":"semetey-1-2013:p1224:b004:l004","ordinal":170542,"en":"Clung close to the ribs."},{"id":"semetey-1-2013:p1224:b004:l005","ordinal":170543,"en":"At the sight of a shape, he darted;"},{"id":"semetey-1-2013:p1224:b004:l006","ordinal":170544,"en":"When Surkoyon saw a figure,"},{"id":"semetey-1-2013:p1224:b004:l007","ordinal":170545,"en":"At a bird's flight, he started."},{"id":"semetey-1-2013:p1224:b004:l008","ordinal":170546,"en":"Then Toltoi grew excited;"},{"id":"semetey-1-2013:p1224:b004:l009","ordinal":170547,"en":"The dear hero grew wrathful"},{"id":"semetey-1-2013:p1224:b004:l010","ordinal":170548,"en":"And spoke to the Zhediger:"},{"id":"semetey-1-2013:p1224:b004:l011","ordinal":170549,"en":"\"If I go today, I shall die;"},{"id":"semetey-1-2013:p1224:b004:l012","ordinal":170550,"en":"Great Black Zhediger,"},{"id":"semetey-1-2013:p1224:b004:l013","ordinal":170551,"en":"I shall behold the face of the other world."},{"id":"semetey-1-2013:p1224:b004:l014","ordinal":170552,"en":"I have left; now I shall not prosper,"},{"id":"semetey-1-2013:p1224:b004:l015","ordinal":170553,"en":"Nor return alive and well!\""},{"id":"semetey-1-2013:p1224:b004:l016","ordinal":170554,"en":"Surkoyon, saddled five times over,"},{"id":"semetey-1-2013:p1224:b004:l017","ordinal":170555,"en":"Chewed a bit of steel,"},{"id":"semetey-1-2013:p1224:b004:l018","ordinal":170556,"en":"His eyes shining like a camel calf's."},{"id":"semetey-1-2013:p1224:b004:l019","ordinal":170557,"en":"The afflicted courser Surkoyon"},{"id":"semetey-1-2013:p1224:b004:l020","ordinal":170558,"en":"He saddled unsparingly"},{"id":"semetey-1-2013:p1224:b004:l021","ordinal":170559,"en":"With a bearskin saddlecloth and white felt pad,"},{"id":"semetey-1-2013:p1224:b004:l022","ordinal":170560,"en":"Warning the great Black Zhediger,"},{"id":"semetey-1-2013:p1224:b004:l023","ordinal":170561,"en":"\"I shall not return!\""},{"id":"semetey-1-2013:p1224:b004:l024","ordinal":170562,"en":"He drew the rear girth tight"},{"id":"semetey-1-2013:p1224:b004:l025","ordinal":170563,"en":"On the courser Surkoyon,"},{"id":"semetey-1-2013:p1224:b004:l026","ordinal":170564,"en":"And shortened the crupper."},{"id":"semetey-1-2013:p1224:b004:l027","ordinal":170565,"en":"Having made Surkoyon ready,"},{"id":"semetey-1-2013:p1224:b004:l028","ordinal":170566,"en":"Zheldet brought him;"},{"id":"semetey-1-2013:p1224:b004:l029","ordinal":170567,"en":"Lion Toltoi saw"},{"id":"semetey-1-2013:p1224:b004:l030","ordinal":170568,"en":"That his horse was prepared."},{"id":"semetey-1-2013:p1224:b004:l031","ordinal":170569,"en":"He put on twelve layers"},{"id":"semetey-1-2013:p1224:b004:l032","ordinal":170570,"en":"Of his bulletproof coat."},{"id":"semetey-1-2013:p1224:b004:l033","ordinal":170571,"en":"He placed a blue-iron helmet"},{"id":"semetey-1-2013:p1224:b004:l034","ordinal":170572,"en":"Upside down upon his head;"},{"id":"semetey-1-2013:p1224:b004:l035","ordinal":170573,"en":"What could dear Toltoi do?"},{"id":"semetey-1-2013:p1224:b004:l036","ordinal":170574,"en":"He donned the ribbed mail armor,*"},{"id":"semetey-1-2013:p1224:b004:l037","ordinal":170575,"en":"Put on iron from head to foot,"},{"id":"semetey-1-2013:p1224:b004:l038","ordinal":170576,"en":"Buttoning it over his whole body,"},{"id":"semetey-1-2013:p1224:b004:l039","ordinal":170577,"en":"And covered all his broad face"},{"id":"semetey-1-2013:p1225:b003:l001","ordinal":170578,"en":"With blue iron."},{"id":"semetey-1-2013:p1225:b003:l002","ordinal":170579,"en":"Adorned and splendidly arrayed,"},{"id":"semetey-1-2013:p1225:b003:l003","ordinal":170580,"en":"What did valiant Toltoi do?"},{"id":"semetey-1-2013:p1225:b003:l004","ordinal":170581,"en":"He swayed as though struck from this side,"},{"id":"semetey-1-2013:p1225:b003:l005","ordinal":170582,"en":"Roaring in his wrath;"},{"id":"semetey-1-2013:p1225:b003:l006","ordinal":170583,"en":"Dear Toltoi thundered,"},{"id":"semetey-1-2013:p1225:b003:l007","ordinal":170584,"en":"Growling in excitement,"},{"id":"semetey-1-2013:p1225:b003:l008","ordinal":170585,"en":"And spoke to the Zhediger:"},{"id":"semetey-1-2013:p1225:b003:l009","ordinal":170586,"en":"\"Is there anything better than a dog's drink?"},{"id":"semetey-1-2013:p1225:b003:l010","ordinal":170587,"en":"They say vodka is nourishment;"},{"id":"semetey-1-2013:p1225:b003:l011","ordinal":170588,"en":"Let me drink that vodka"},{"id":"semetey-1-2013:p1225:b003:l012","ordinal":170589,"en":"And ride shouting against the enemy."},{"id":"semetey-1-2013:p1225:b003:l013","ordinal":170590,"en":"If my death has come, let me die;"},{"id":"semetey-1-2013:p1225:b003:l014","ordinal":170591,"en":"Whatever command Allah has laid down,"},{"id":"semetey-1-2013:p1225:b003:l015","ordinal":170592,"en":"Let me meet it."},{"id":"semetey-1-2013:p1225:b003:l016","ordinal":170593,"en":"Black vodka in the Kalmak fashion,"},{"id":"semetey-1-2013:p1225:b003:l017","ordinal":170594,"en":"One leather flask of vodka—"},{"id":"semetey-1-2013:p1225:b003:l018","ordinal":170595,"en":"Saying, 'Pour out that dog-drink,'"},{"id":"semetey-1-2013:p1225:b003:l019","ordinal":170596,"en":"They poured him the vodka."},{"id":"semetey-1-2013:p1225:b003:l020","ordinal":170597,"en":"He struck down four bowls of vodka"},{"id":"semetey-1-2013:p1225:b003:l021","ordinal":170598,"en":"One after another."},{"id":"semetey-1-2013:p1225:b003:l022","ordinal":170599,"en":"Drinking vodka, he grew excited,"},{"id":"semetey-1-2013:p1225:b003:l023","ordinal":170600,"en":"Not knowing that he himself would die;"},{"id":"semetey-1-2013:p1225:b003:l024","ordinal":170601,"en":"He cursed without pause"},{"id":"semetey-1-2013:p1225:b003:l025","ordinal":170602,"en":"Both the Zhediger and Kojo."},{"id":"semetey-1-2013:p1225:b004:l001","ordinal":170603,"en":"He girded on his unsheathed sword;"},{"id":"semetey-1-2013:p1225:b004:l002","ordinal":170604,"en":"Like a cloud about to rain again,"},{"id":"semetey-1-2013:p1225:b004:l003","ordinal":170605,"en":"Wrath spread across his face."},{"id":"semetey-1-2013:p1225:b004:l004","ordinal":170606,"en":"The sight arrested the heart;"},{"id":"semetey-1-2013:p1225:b004:l005","ordinal":170607,"en":"Toltoi grew wrathful,"},{"id":"semetey-1-2013:p1225:b004:l006","ordinal":170608,"en":"And anger poured from his mouth."},{"id":"semetey-1-2013:p1225:b004:l007","ordinal":170609,"en":"When your Toltoi showed his true nature,"},{"id":"semetey-1-2013:p1225:b004:l008","ordinal":170610,"en":"He was like taut red iron;"},{"id":"semetey-1-2013:p1225:b004:l009","ordinal":170611,"en":"When Khan Toltoi grew angry,"},{"id":"semetey-1-2013:p1225:b004:l010","ordinal":170612,"en":"His bulk equaled half a mountain."},{"id":"semetey-1-2013:p1225:b004:l011","ordinal":170613,"en":"He took a blue-mottled spear in hand,"},{"id":"semetey-1-2013:p1225:b004:l012","ordinal":170614,"en":"Slung a short blue gun,"},{"id":"semetey-1-2013:p1225:b004:l013","ordinal":170615,"en":"And his war gear stood out;"},{"id":"semetey-1-2013:p1225:b004:l014","ordinal":170616,"en":"He loomed like Opol-Too,"},{"id":"semetey-1-2013:p1225:b004:l015","ordinal":170617,"en":"Overcoming the hearts of all who saw."},{"id":"semetey-1-2013:p1225:b004:l016","ordinal":170618,"en":"To raid the Afghan city,"},{"id":"semetey-1-2013:p1225:b004:l017","ordinal":170619,"en":"To go as bridegroom"},{"id":"semetey-1-2013:p1225:b004:l018","ordinal":170620,"en":"For Akun's daughter Aichürök,"},{"id":"semetey-1-2013:p1225:b004:l019","ordinal":170621,"en":"Dear Toltoi then"},{"id":"semetey-1-2013:p1225:b004:l020","ordinal":170622,"en":"Loomed like Opol-Too."},{"id":"semetey-1-2013:p1225:b004:l021","ordinal":170623,"en":"Roaring in his wrath"},{"id":"semetey-1-2013:p1225:b004:l022","ordinal":170624,"en":"And gathering himself like a blue tiger,"},{"id":"semetey-1-2013:p1225:b004:l023","ordinal":170625,"en":"As the sun was sinking low"},{"id":"semetey-1-2013:p1225:b004:l024","ordinal":170626,"en":"And the people lay down,"},{"id":"semetey-1-2013:p1225:b004:l025","ordinal":170627,"en":"Dear Toltoi mounted his horse."},{"id":"semetey-1-2013:p1225:b006:l001","ordinal":170628,"en":"Tölök and Tölöbai"},{"id":"semetey-1-2013:p1225:b006:l002","ordinal":170629,"en":"Both shouted out"},{"id":"semetey-1-2013:p1225:b006:l003","ordinal":170630,"en":"To remain and give their blessing."},{"id":"semetey-1-2013:p1225:b006:l004","ordinal":170631,"en":"They called to Toltoi of the Zhediger,"},{"id":"semetey-1-2013:p1225:b006:l005","ordinal":170632,"en":"\"Wait a while!\""},{"id":"semetey-1-2013:p1225:b006:l006","ordinal":170633,"en":"When they called, Toltoi cursed them:"},{"id":"semetey-1-2013:p1225:b006:l007","ordinal":170634,"en":"\"Tölök and Tölöbai,"},{"id":"semetey-1-2013:p1225:b006:l008","ordinal":170635,"en":"May you sink into the earth with your blessing!"},{"id":"semetey-1-2013:p1225:b006:l009","ordinal":170636,"en":"I now go to meet"},{"id":"semetey-1-2013:p1225:b008:l001","ordinal":170637,"en":"What fate has laid down;"},{"id":"semetey-1-2013:p1225:b008:l002","ordinal":170638,"en":"Even if you give a thousand blessings,"},{"id":"semetey-1-2013:p1225:b008:l003","ordinal":170639,"en":"I go to die."},{"id":"semetey-1-2013:p1225:b008:l004","ordinal":170640,"en":"If I go today, I shall not prosper;"},{"id":"semetey-1-2013:p1225:b008:l005","ordinal":170641,"en":"Look closely—I shall not survive today."},{"id":"semetey-1-2013:p1225:b008:l006","ordinal":170642,"en":"Give your heart or withhold your heart;"},{"id":"semetey-1-2013:p1225:b008:l007","ordinal":170643,"en":"Let me behold humiliation in full,"},{"id":"semetey-1-2013:p1225:b008:l008","ordinal":170644,"en":"And die when death reaches me."},{"id":"semetey-1-2013:p1225:b008:l009","ordinal":170645,"en":"Challenging a lion blessed by Khizr,"},{"id":"semetey-1-2013:p1226:b003:l001","ordinal":170646,"en":"Will any man remain alive?"},{"id":"semetey-1-2013:p1226:b003:l002","ordinal":170647,"en":"O black-bearded men, this is a distant road;"},{"id":"semetey-1-2013:p1226:b003:l003","ordinal":170648,"en":"Will I die without returning?"},{"id":"semetey-1-2013:p1226:b003:l004","ordinal":170649,"en":"Farewell, my dear people!"},{"id":"semetey-1-2013:p1226:b003:l005","ordinal":170650,"en":"God knows whether one dies;"},{"id":"semetey-1-2013:p1226:b003:l006","ordinal":170651,"en":"God knows whether your Toltoi"},{"id":"semetey-1-2013:p1226:b003:l007","ordinal":170652,"en":"Will return to you alive!\""},{"id":"semetey-1-2013:p1226:b003:l008","ordinal":170653,"en":"Hero Toltoi spoke of"},{"id":"semetey-1-2013:p1226:b003:l009","ordinal":170654,"en":"A fatal calamity,"},{"id":"semetey-1-2013:p1226:b003:l010","ordinal":170655,"en":"Pouring himself recklessly into drink;"},{"id":"semetey-1-2013:p1226:b003:l011","ordinal":170656,"en":"Hero Toltoi raised the uproar."},{"id":"semetey-1-2013:p1226:b003:l012","ordinal":170657,"en":"He raced upon his gray horse;"},{"id":"semetey-1-2013:p1226:b003:l013","ordinal":170658,"en":"Sultan Toltoi spurred forward,"},{"id":"semetey-1-2013:p1226:b003:l014","ordinal":170659,"en":"The earth splitting in a mirage,"},{"id":"semetey-1-2013:p1226:b003:l015","ordinal":170660,"en":"And Toltoi drew near"},{"id":"semetey-1-2013:p1226:b003:l016","ordinal":170661,"en":"The city of broad Afghanistan."},{"id":"semetey-1-2013:p1226:b003:l017","ordinal":170662,"en":"Was he not capable Toltoi,"},{"id":"semetey-1-2013:p1226:b003:l018","ordinal":170663,"en":"Who knew much of the whole world?"},{"id":"semetey-1-2013:p1226:b003:l019","ordinal":170664,"en":"Was he not renowned Toltoi,"},{"id":"semetey-1-2013:p1226:b003:l020","ordinal":170665,"en":"Who knew perfectly what was and was not?"},{"id":"semetey-1-2013:p1226:b003:l021","ordinal":170666,"en":"Was Toltoi not exceedingly"},{"id":"semetey-1-2013:p1226:b003:l022","ordinal":170667,"en":"Skillful among spearmen?"},{"id":"semetey-1-2013:p1226:b003:l023","ordinal":170668,"en":"When his company stood complete,"},{"id":"semetey-1-2013:p1226:b003:l024","ordinal":170669,"en":"Was Toltoi not the foremost champion"},{"id":"semetey-1-2013:p1226:b003:l025","ordinal":170670,"en":"At breaking enemy ranks?"},{"id":"semetey-1-2013:p1226:b003:l026","ordinal":170671,"en":"He reconnoitered the capable road"},{"id":"semetey-1-2013:p1226:b003:l027","ordinal":170672,"en":"Leading to Kashgar;"},{"id":"semetey-1-2013:p1226:b003:l028","ordinal":170673,"en":"Finding no track there,"},{"id":"semetey-1-2013:p1226:b003:l029","ordinal":170674,"en":"He turned back again."},{"id":"semetey-1-2013:p1226:b003:l030","ordinal":170675,"en":"He reconnoitered the direct road"},{"id":"semetey-1-2013:p1226:b003:l031","ordinal":170676,"en":"Leading to Turpan;"},{"id":"semetey-1-2013:p1226:b003:l032","ordinal":170677,"en":"Unable to find a track there,"},{"id":"semetey-1-2013:p1226:b003:l033","ordinal":170678,"en":"He turned back again."},{"id":"semetey-1-2013:p1226:b003:l034","ordinal":170679,"en":"He reconnoitered the safe road"},{"id":"semetey-1-2013:p1226:b003:l035","ordinal":170680,"en":"Leading to Beijing;"},{"id":"semetey-1-2013:p1226:b003:l036","ordinal":170681,"en":"Finding no track there,"},{"id":"semetey-1-2013:p1226:b003:l037","ordinal":170682,"en":"He turned back again."},{"id":"semetey-1-2013:p1226:b003:l038","ordinal":170683,"en":"The winding road of Toguz-Zhol,"},{"id":"semetey-1-2013:p1226:b003:l039","ordinal":170684,"en":"The trail of wolf and sheep,"},{"id":"semetey-1-2013:p1226:b004:l001","ordinal":170685,"en":"The side-road leading to Andizhan—"},{"id":"semetey-1-2013:p1226:b004:l002","ordinal":170686,"en":"He reconnoitered that road;"},{"id":"semetey-1-2013:p1226:b004:l003","ordinal":170687,"en":"Finding no track there,"},{"id":"semetey-1-2013:p1226:b004:l004","ordinal":170688,"en":"He turned back again."},{"id":"semetey-1-2013:p1226:b004:l005","ordinal":170689,"en":"The woeful road entering Koton,"},{"id":"semetey-1-2013:p1226:b004:l006","ordinal":170690,"en":"The seven roads sinking into the earth—"},{"id":"semetey-1-2013:p1226:b004:l007","ordinal":170691,"en":"He reached and reconnoitered them;"},{"id":"semetey-1-2013:p1226:b004:l008","ordinal":170692,"en":"Finding no track there,"},{"id":"semetey-1-2013:p1226:b004:l009","ordinal":170693,"en":"He turned back again."},{"id":"semetey-1-2013:p1226:b004:l010","ordinal":170694,"en":"Echoing Zhar-Kyya,"},{"id":"semetey-1-2013:p1226:b004:l011","ordinal":170695,"en":"Where a single horse-track wound on—"},{"id":"semetey-1-2013:p1226:b004:l012","ordinal":170696,"en":"That was the road to Talas."},{"id":"semetey-1-2013:p1226:b004:l013","ordinal":170697,"en":"Those who knew would know it;"},{"id":"semetey-1-2013:p1226:b004:l014","ordinal":170698,"en":"All who did not know"},{"id":"semetey-1-2013:p1226:b004:l015","ordinal":170699,"en":"Would follow the former road."},{"id":"semetey-1-2013:p1226:b004:l016","ordinal":170700,"en":"When he came to that road,"},{"id":"semetey-1-2013:p1226:b004:l017","ordinal":170701,"en":"A whirlwind spun;"},{"id":"semetey-1-2013:p1226:b004:l018","ordinal":170702,"en":"The black road lay under a curse."},{"id":"semetey-1-2013:p1226:b004:l019","ordinal":170703,"en":"Nothing caught the eye,"},{"id":"semetey-1-2013:p1226:b004:l020","ordinal":170704,"en":"And one could not tell which road it was."},{"id":"semetey-1-2013:p1226:b004:l021","ordinal":170705,"en":"Toltoi's sight was bound:"},{"id":"semetey-1-2013:p1226:b004:l022","ordinal":170706,"en":"Aichürök, daughter of the hero,"},{"id":"semetey-1-2013:p1226:b004:l023","ordinal":170707,"en":"Recited words in Arabic"},{"id":"semetey-1-2013:p1226:b004:l024","ordinal":170708,"en":"And cast a ground fog;"},{"id":"semetey-1-2013:p1226:b004:l025","ordinal":170709,"en":"Thus that road"},{"id":"semetey-1-2013:p1226:b004:l026","ordinal":170710,"en":"Vanished entirely from sight."},{"id":"semetey-1-2013:p1226:b004:l027","ordinal":170711,"en":"Clouds formed in the hollows,"},{"id":"semetey-1-2013:p1226:b004:l028","ordinal":170712,"en":"And ground fog descended and closed in;"},{"id":"semetey-1-2013:p1226:b004:l029","ordinal":170713,"en":"The accursed woman Aichürök's"},{"id":"semetey-1-2013:p1226:b004:l030","ordinal":170714,"en":"Weather-working power appeared."},{"id":"semetey-1-2013:p1226:b004:l031","ordinal":170715,"en":"Fine rain separated through the air,"},{"id":"semetey-1-2013:p1226:b004:l032","ordinal":170716,"en":"And cloud covered the moon;"},{"id":"semetey-1-2013:p1226:b004:l033","ordinal":170717,"en":"Toltoi of the Zhediger"},{"id":"semetey-1-2013:p1226:b004:l034","ordinal":170718,"en":"Lost his wits."},{"id":"semetey-1-2013:p1226:b004:l035","ordinal":170719,"en":"Then Toltoi grew excited"},{"id":"semetey-1-2013:p1226:b004:l036","ordinal":170720,"en":"And spoke to himself:"},{"id":"semetey-1-2013:p1226:b004:l037","ordinal":170721,"en":"\"Before these benighted eyes,"},{"id":"semetey-1-2013:p1226:b004:l038","ordinal":170722,"en":"Everything looks dark."},{"id":"semetey-1-2013:p1226:b004:l039","ordinal":170723,"en":"From fording too much water at night,"},{"id":"semetey-1-2013:p1227:b003:l001","ordinal":170724,"en":"Has God struck my eyes?"},{"id":"semetey-1-2013:p1227:b003:l002","ordinal":170725,"en":"Before these benighted eyes,"},{"id":"semetey-1-2013:p1227:b003:l003","ordinal":170726,"en":"Everything appears black."},{"id":"semetey-1-2013:p1227:b003:l004","ordinal":170727,"en":"From fording water in the darkness,"},{"id":"semetey-1-2013:p1227:b003:l005","ordinal":170728,"en":"It seems the water has risen into my eyes."},{"id":"semetey-1-2013:p1227:b003:l006","ordinal":170729,"en":"What can this be?\" he said,"},{"id":"semetey-1-2013:p1227:b003:l007","ordinal":170730,"en":"And quickly dismounted."},{"id":"semetey-1-2013:p1227:b003:l008","ordinal":170731,"en":"Along the single horse-track"},{"id":"semetey-1-2013:p1227:b003:l009","ordinal":170732,"en":"He reached down and felt with his hand."},{"id":"semetey-1-2013:p1227:b003:l010","ordinal":170733,"en":"A track met his hand;"},{"id":"semetey-1-2013:p1227:b003:l011","ordinal":170734,"en":"The places struck by the hooves"},{"id":"semetey-1-2013:p1227:b003:l012","ordinal":170735,"en":"Were hollowed like a ravine,"},{"id":"semetey-1-2013:p1227:b003:l013","ordinal":170736,"en":"Carved as deep as an irrigation ditch."},{"id":"semetey-1-2013:p1227:b003:l014","ordinal":170737,"en":"Had a giant walked"},{"id":"semetey-1-2013:p1227:b003:l015","ordinal":170738,"en":"Upon this desolate road?"},{"id":"semetey-1-2013:p1227:b003:l016","ordinal":170739,"en":"Had those pursuing reached it?"},{"id":"semetey-1-2013:p1227:b003:l017","ordinal":170740,"en":"Or had a monster"},{"id":"semetey-1-2013:p1227:b003:l018","ordinal":170741,"en":"Passed along this road?"},{"id":"semetey-1-2013:p1227:b003:l019","ordinal":170742,"en":"Had those who were coming truly arrived,"},{"id":"semetey-1-2013:p1227:b003:l020","ordinal":170743,"en":"And had my appointed death come?"},{"id":"semetey-1-2013:p1227:b003:l021","ordinal":170744,"en":"Drinking vodka, he grew excited;"},{"id":"semetey-1-2013:p1227:b003:l022","ordinal":170745,"en":"Hero Toltoi, heated with drink,"},{"id":"semetey-1-2013:p1227:b003:l023","ordinal":170746,"en":"Spoke without knowing he would die."},{"id":"semetey-1-2013:p1227:b003:l024","ordinal":170747,"en":"Dear Toltoi the leopard"},{"id":"semetey-1-2013:p1227:b003:l025","ordinal":170748,"en":"Roared in his anger"},{"id":"semetey-1-2013:p1227:b003:l026","ordinal":170749,"en":"And thundered with courage:"},{"id":"semetey-1-2013:p1227:b003:l027","ordinal":170750,"en":"\"If they call me a hero, a hero I am;"},{"id":"semetey-1-2013:p1227:b003:l028","ordinal":170751,"en":"If a teeming great enemy appears,"},{"id":"semetey-1-2013:p1227:b003:l029","ordinal":170752,"en":"I shall enter alone and test them."}]
