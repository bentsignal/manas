{"id": "sayakbay-ms-current146:pdf158:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 158, "folio": 541, "line_in_page": 7, "raw": "Казоодо байлап өтүштү,", "text": "Казоодо байлап өтүштү,", "en": "They bound it in battle and passed on,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf158:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 158, "folio": 541, "line_in_page": 8, "raw": "Чын ажалга байлаптыр,", "text": "Чын ажалга байлаптыр,", "en": "They had bound him to true death,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
