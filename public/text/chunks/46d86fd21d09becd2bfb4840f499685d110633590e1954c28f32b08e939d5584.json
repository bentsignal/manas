[{"id":"manas-2010:p0475:b001:l010","ordinal":21761,"en":"As though to flay his opponent,"},{"id":"manas-2010:p0475:b001:l011","ordinal":21762,"en":"His face turned fierce with rage."},{"id":"manas-2010:p0475:b001:l012","ordinal":21763,"en":"If you ask his name,"},{"id":"manas-2010:p0475:b001:l013","ordinal":21764,"en":"They call him Orgo the champion."},{"id":"manas-2010:p0475:b001:l014","ordinal":21765,"en":"He leaves no one he meets unharmed,"},{"id":"manas-2010:p0475:b001:l015","ordinal":21766,"en":"Mowing, crushing, devouring them."},{"id":"manas-2010:p0475:b001:l016","ordinal":21767,"en":"Raging and running wild,"},{"id":"manas-2010:p0475:b001:l017","ordinal":21768,"en":"He lashed his mule."},{"id":"manas-2010:p0475:b001:l018","ordinal":21769,"en":"A hero of boundless strength,"},{"id":"manas-2010:p0475:b001:l019","ordinal":21770,"en":"He surged out from Kakan."},{"id":"manas-2010:p0475:b001:l020","ordinal":21771,"en":"Clad all in blue-black iron,"},{"id":"manas-2010:p0475:b001:l021","ordinal":21772,"en":"When he swung his painted spear,"},{"id":"manas-2010:p0475:b001:l022","ordinal":21773,"en":"It bent like a slender switch."},{"id":"manas-2010:p0475:b001:l023","ordinal":21774,"en":"The mule beneath him"},{"id":"manas-2010:p0475:b001:l024","ordinal":21775,"en":"Shattered the stones it trod."},{"id":"manas-2010:p0475:b001:l025","ordinal":21776,"en":"The flames from his mouth"},{"id":"manas-2010:p0475:b001:l026","ordinal":21777,"en":"Scorched his mustache, sizzling."},{"id":"manas-2010:p0475:b001:l027","ordinal":21778,"en":"Hero Orgo was coming there."},{"id":"manas-2010:p0475:b001:l028","ordinal":21779,"en":"Orgo was an enormous warrior,"},{"id":"manas-2010:p0475:b001:l029","ordinal":21780,"en":"Set by Kakan-chyn at Beejin"},{"id":"manas-2010:p0475:b001:l030","ordinal":21781,"en":"To stand there as a fortress."},{"id":"manas-2010:p0475:b001:l031","ordinal":21782,"en":"High-browed, with a fine face—"},{"id":"manas-2010:p0475:b001:l032","ordinal":21783,"en":"See his strength and flee far off!"},{"id":"manas-2010:p0475:b001:l033","ordinal":21784,"en":"A single mustache hair"},{"id":"manas-2010:p0475:b001:l034","ordinal":21785,"en":"Was like a skull-breaking axe's haft."},{"id":"manas-2010:p0475:b001:l035","ordinal":21786,"en":"The great bulk of his nose"},{"id":"manas-2010:p0475:b001:l036","ordinal":21787,"en":"Was like a broad sword's sheath."},{"id":"manas-2010:p0475:b001:l037","ordinal":21788,"en":"The hollows of his two eyes"},{"id":"manas-2010:p0475:b001:l038","ordinal":21789,"en":"Were like a grave whose roof collapsed."},{"id":"manas-2010:p0475:b001:l039","ordinal":21790,"en":"Looking at his broad forehead,"},{"id":"manas-2010:p0475:b001:l040","ordinal":21791,"en":"It seemed a separate upland hollow."},{"id":"manas-2010:p0475:b001:l041","ordinal":21792,"en":"The Manzhuu knew his prowess:"},{"id":"manas-2010:p0475:b001:l042","ordinal":21793,"en":"A cast-iron mace of twelve batmans"},{"id":"manas-2010:p0476:b001:l001","ordinal":21794,"en":"Hung from his wrist."},{"id":"manas-2010:p0476:b001:l002","ordinal":21795,"en":"At the sight, your heart faltered;"},{"id":"manas-2010:p0476:b001:l003","ordinal":21796,"en":"The others were mere little fish."},{"id":"manas-2010:p0476:b001:l004","ordinal":21797,"en":"Great Orgo came onward,"},{"id":"manas-2010:p0476:b001:l005","ordinal":21798,"en":"Looming like a mighty mountain."},{"id":"manas-2010:p0476:b001:l006","ordinal":21799,"en":"A great, shot-proof sash"},{"id":"manas-2010:p0476:b001:l007","ordinal":21800,"en":"Your warrior girded round his waist."},{"id":"manas-2010:p0476:b001:l008","ordinal":21801,"en":"The earth split with a roar."},{"id":"manas-2010:p0476:b001:l009","ordinal":21802,"en":"He struck his mule's thigh once."},{"id":"manas-2010:p0476:b001:l010","ordinal":21803,"en":"If you ask about Orgo,"},{"id":"manas-2010:p0476:b001:l011","ordinal":21804,"en":"In great Beejin of forty gates,"},{"id":"manas-2010:p0476:b001:l012","ordinal":21805,"en":"He was Karykan's champion."},{"id":"manas-2010:p0476:b001:l013","ordinal":21806,"en":"When one met him in combat,"},{"id":"manas-2010:p0476:b001:l014","ordinal":21807,"en":"He tore that person's life to shreds."},{"id":"manas-2010:p0476:b001:l015","ordinal":21808,"en":"The mule beneath him"},{"id":"manas-2010:p0476:b001:l016","ordinal":21809,"en":"Came flying up with a clatter."},{"id":"manas-2010:p0476:b001:l017","ordinal":21810,"en":"Zholoy and Ezkara,"},{"id":"manas-2010:p0476:b001:l018","ordinal":21811,"en":"These khans, with Karazhoy leading,"},{"id":"manas-2010:p0476:b001:l019","ordinal":21812,"en":"Bowed to him, crying out."},{"id":"manas-2010:p0476:b001:l020","ordinal":21813,"en":"He paid no heed to their bows."},{"id":"manas-2010:p0476:b001:l021","ordinal":21814,"en":"Now God had truly struck them!"},{"id":"manas-2010:p0476:b001:l022","ordinal":21815,"en":"He whirred onward, quite untroubled,"},{"id":"manas-2010:p0476:b001:l023","ordinal":21816,"en":"Regarding the Kara-Kytay and Manzhuu"},{"id":"manas-2010:p0476:b001:l024","ordinal":21817,"en":"As worth less than his trouser leg."},{"id":"manas-2010:p0476:b001:l025","ordinal":21818,"en":"He wanted the leopard;"},{"id":"manas-2010:p0476:b001:l026","ordinal":21819,"en":"He sought to fight Khan Manas."},{"id":"manas-2010:p0476:b001:l027","ordinal":21820,"en":"Unstopped by the Kara-Suu—"},{"id":"manas-2010:p0476:b001:l028","ordinal":21821,"en":"Here was a fiend indeed!"},{"id":"manas-2010:p0476:b001:l029","ordinal":21822,"en":"His black-jawed heavy whip"},{"id":"manas-2010:p0476:b001:l030","ordinal":21823,"en":"He seized and swung around."},{"id":"manas-2010:p0476:b001:l031","ordinal":21824,"en":"His mule, leaning back,"},{"id":"manas-2010:p0476:b001:l032","ordinal":21825,"en":"He lashed across its flank."},{"id":"manas-2010:p0476:b001:l033","ordinal":21826,"en":"When the lash struck its belly,"},{"id":"manas-2010:p0476:b001:l034","ordinal":21827,"en":"It twisted its neck without turning."},{"id":"manas-2010:p0476:b001:l035","ordinal":21828,"en":"The gray mule could not endure it;"},{"id":"manas-2010:p0476:b001:l036","ordinal":21829,"en":"It strained and charged ahead."},{"id":"manas-2010:p0476:b001:l037","ordinal":21830,"en":"A champion and warrior indeed,"},{"id":"manas-2010:p0476:b001:l038","ordinal":21831,"en":"There stood your hero Orgo."},{"id":"manas-2010:p0476:b001:l039","ordinal":21832,"en":"When he saw Khan Manas,"},{"id":"manas-2010:p0476:b001:l040","ordinal":21833,"en":"His bloodlust gripped him hard."},{"id":"manas-2010:p0476:b001:l041","ordinal":21834,"en":"He had no care for his skin;"},{"id":"manas-2010:p0476:b001:l042","ordinal":21835,"en":"He thundered on, untroubled."},{"id":"manas-2010:p0477:b001:l001","ordinal":21836,"en":"Straight toward your magnanimous one,"},{"id":"manas-2010:p0477:b001:l002","ordinal":21837,"en":"He thrust his spear without measuring."},{"id":"manas-2010:p0477:b001:l003","ordinal":21838,"en":"His prowess was extraordinary."},{"id":"manas-2010:p0477:b001:l004","ordinal":21839,"en":"His eyes reddened, as if to swallow him."},{"id":"manas-2010:p0477:b001:l005","ordinal":21840,"en":"His button-loops numbered nine;"},{"id":"manas-2010:p0477:b001:l006","ordinal":21841,"en":"He undid those fastenings."},{"id":"manas-2010:p0477:b001:l007","ordinal":21842,"en":"He loomed in blue mail,"},{"id":"manas-2010:p0477:b001:l008","ordinal":21843,"en":"Its skirts flapping loose."},{"id":"manas-2010:p0477:b001:l009","ordinal":21844,"en":"He was a reckless warrior,"},{"id":"manas-2010:p0477:b001:l010","ordinal":21845,"en":"Called Orgo the champion."},{"id":"manas-2010:p0477:b001:l011","ordinal":21846,"en":"The lion Manas, touched by Khizir,"},{"id":"manas-2010:p0477:b001:l012","ordinal":21847,"en":"Had fought many days without rest,"},{"id":"manas-2010:p0477:b001:l013","ordinal":21848,"en":"That dear warrior who had seen slaughter."},{"id":"manas-2010:p0477:b001:l014","ordinal":21849,"en":"Born with all twelve members complete,"},{"id":"manas-2010:p0477:b001:l015","ordinal":21850,"en":"Born a lion, companion to forty chiltens,"},{"id":"manas-2010:p0477:b001:l016","ordinal":21851,"en":"He struck Toruchaar's thigh once,"},{"id":"manas-2010:p0477:b001:l017","ordinal":21852,"en":"Took his painted spear in hand,"},{"id":"manas-2010:p0477:b001:l018","ordinal":21853,"en":"And firmly confronting Orgo,"},{"id":"manas-2010:p0477:b001:l019","ordinal":21854,"en":"Your warrior Manas drew near."},{"id":"manas-2010:p0477:b001:l020","ordinal":21855,"en":"As he neared the warrior,"},{"id":"manas-2010:p0477:b001:l021","ordinal":21856,"en":"Steel-tipped and brass-shafted,"},{"id":"manas-2010:p0477:b001:l022","ordinal":21857,"en":"His accursed, mountain-sized spear"},{"id":"manas-2010:p0477:b001:l023","ordinal":21858,"en":"Straight toward hero Manas"},{"id":"manas-2010:p0477:b001:l024","ordinal":21859,"en":"Orgo swung as he passed."},{"id":"manas-2010:p0477:b001:l025","ordinal":21860,"en":"Upon Toruchaar, the leopard"},{"id":"manas-2010:p0477:b001:l026","ordinal":21861,"en":"Leaned aside just then."},{"id":"manas-2010:p0477:b001:l027","ordinal":21862,"en":"The spear did not strike squarely;"},{"id":"manas-2010:p0477:b001:l028","ordinal":21863,"en":"It slid and glanced away."},{"id":"manas-2010:p0477:b001:l029","ordinal":21864,"en":"Setting his spear right in hand,"},{"id":"manas-2010:p0477:b001:l030","ordinal":21865,"en":"Devastating Manas, the leopard,"},{"id":"manas-2010:p0477:b001:l031","ordinal":21866,"en":"Surpassing champion and lion,"},{"id":"manas-2010:p0477:b001:l032","ordinal":21867,"en":"That dear warrior of mighty terror,"},{"id":"manas-2010:p0477:b001:l033","ordinal":21868,"en":"His steel-edged painted spear"},{"id":"manas-2010:p0477:b001:l034","ordinal":21869,"en":"He aimed and swung around."},{"id":"manas-2010:p0477:b001:l035","ordinal":21870,"en":"Without missing his chosen mark,"},{"id":"manas-2010:p0477:b001:l036","ordinal":21871,"en":"Against unmeasured Orgo"},{"id":"manas-2010:p0477:b001:l037","ordinal":21872,"en":"He drove a mighty thrust."},{"id":"manas-2010:p0477:b001:l038","ordinal":21873,"en":"Through the center of his heart"},{"id":"manas-2010:p0477:b001:l039","ordinal":21874,"en":"It tore its way through."},{"id":"manas-2010:p0477:b001:l040","ordinal":21875,"en":"Through the marrow of his backbone"},{"id":"manas-2010:p0477:b001:l041","ordinal":21876,"en":"It tore its way through."},{"id":"manas-2010:p0477:b001:l042","ordinal":21877,"en":"Then great Orgo,"},{"id":"manas-2010:p0478:b001:l001","ordinal":21878,"en":"From atop the gray mule—"},{"id":"manas-2010:p0478:b001:l002","ordinal":21879,"en":"The warrior slipped from his saddle,"},{"id":"manas-2010:p0478:b001:l003","ordinal":21880,"en":"His feet slipped from the stirrups."},{"id":"manas-2010:p0478:b001:l004","ordinal":21881,"en":"That hero who vaunted his prowess,"},{"id":"manas-2010:p0478:b001:l005","ordinal":21882,"en":"Who thundered and struck hearts with fear,"},{"id":"manas-2010:p0478:b001:l006","ordinal":21883,"en":"That unbeliever of potent venom,"},{"id":"manas-2010:p0478:b001:l007","ordinal":21884,"en":"That skilled man with his pointed spear,"},{"id":"manas-2010:p0478:b001:l008","ordinal":21885,"en":"Who drove all the world"},{"id":"manas-2010:p0478:b001:l009","ordinal":21886,"en":"Before him, slaughtering as he went,"},{"id":"manas-2010:p0478:b001:l010","ordinal":21887,"en":"The mighty, renowned Orgo—"},{"id":"manas-2010:p0478:b001:l011","ordinal":21888,"en":"The spear struck, and blood poured out;"},{"id":"manas-2010:p0478:b001:l012","ordinal":21889,"en":"Life departed from great Orgo."},{"id":"manas-2010:p0478:b001:l013","ordinal":21890,"en":"His eyes rolled wildly;"},{"id":"manas-2010:p0478:b001:l014","ordinal":21891,"en":"His legs dangled loose."},{"id":"manas-2010:p0478:b001:l015","ordinal":21892,"en":"The steel-tipped painted spear"},{"id":"manas-2010:p0478:b001:l016","ordinal":21893,"en":"He aimed and swung around."},{"id":"manas-2010:p0478:b001:l017","ordinal":21894,"en":"The blood-drinking, bloodthirsty, ready lion,"},{"id":"manas-2010:p0478:b001:l018","ordinal":21895,"en":"When he met with Orgo,"},{"id":"manas-2010:p0478:b001:l019","ordinal":21896,"en":"From atop his mule"},{"id":"manas-2010:p0478:b001:l020","ordinal":21897,"en":"Had thrust him tumbling down."},{"id":"manas-2010:p0478:b001:l021","ordinal":21898,"en":"His blue helmet and plated armor"},{"id":"manas-2010:p0478:b001:l022","ordinal":21899,"en":"Flew off his head."},{"id":"manas-2010:p0478:b001:l023","ordinal":21900,"en":"Behind him came Kutubiy,"},{"id":"manas-2010:p0478:b001:l024","ordinal":21901,"en":"Manas, Manas's retainer,"},{"id":"manas-2010:p0478:b001:l025","ordinal":21902,"en":"Arriving before an arrow could."},{"id":"manas-2010:p0478:b001:l026","ordinal":21903,"en":"A trick rider, swift on foot,"},{"id":"manas-2010:p0478:b001:l027","ordinal":21904,"en":"Before they could pull Orgo free,"},{"id":"manas-2010:p0478:b001:l028","ordinal":21905,"en":"Kutubiy, standing ready,"},{"id":"manas-2010:p0478:b001:l029","ordinal":21906,"en":"Cut his head off and went."},{"id":"manas-2010:p0478:b001:l030","ordinal":21907,"en":"When Orgo fell from his mount,"},{"id":"manas-2010:p0478:b001:l031","ordinal":21908,"en":"His lord Ezkara saw,"},{"id":"manas-2010:p0478:b001:l032","ordinal":21909,"en":"And gave a grieving roar:"},{"id":"manas-2010:p0478:b001:l033","ordinal":21910,"en":"“Orgo Khan of the Kytay has died!”"},{"id":"manas-2010:p0478:b001:l034","ordinal":21911,"en":"It was not Orgo who died then:"},{"id":"manas-2010:p0478:b001:l035","ordinal":21912,"en":"All of Beejin died."},{"id":"manas-2010:p0478:b001:l036","ordinal":21913,"en":"The back they leaned upon died;"},{"id":"manas-2010:p0478:b001:l037","ordinal":21914,"en":"The renowned lion Orgo died."},{"id":"manas-2010:p0478:b001:l038","ordinal":21915,"en":"Such was Orgo's nature:"},{"id":"manas-2010:p0478:b001:l039","ordinal":21916,"en":"He wore an iron coat;"},{"id":"manas-2010:p0478:b001:l040","ordinal":21917,"en":"He led a host of ten thousand."},{"id":"manas-2010:p0478:b001:l041","ordinal":21918,"en":"Throughout the whole world,"},{"id":"manas-2010:p0478:b001:l042","ordinal":21919,"en":"Renowned Orgo was mighty."},{"id":"manas-2010:p0479:b001:l001","ordinal":21920,"en":"Such was Orgo's greatness:"},{"id":"manas-2010:p0479:b001:l002","ordinal":21921,"en":"He was the net that shielded Kakan."},{"id":"manas-2010:p0479:b001:l003","ordinal":21922,"en":"This bloodthirsty one who destroyed Orgo—"},{"id":"manas-2010:p0479:b001:l004","ordinal":21923,"en":"Could anyone match him in battle?"},{"id":"manas-2010:p0479:b001:l005","ordinal":21924,"en":"Could any man beat him with spears?"},{"id":"manas-2010:p0479:b001:l006","ordinal":21925,"en":"Ezkara flew into a rage,"},{"id":"manas-2010:p0479:b001:l007","ordinal":21926,"en":"To rush upon Manas."},{"id":"manas-2010:p0479:b001:l008","ordinal":21927,"en":"The raging wretch pressed forward,"},{"id":"manas-2010:p0479:b001:l009","ordinal":21928,"en":"To surround and overwhelm him."},{"id":"manas-2010:p0479:b001:l010","ordinal":21929,"en":"He drove his great host onward,"},{"id":"manas-2010:p0479:b001:l011","ordinal":21930,"en":"Spreading out before him"},{"id":"manas-2010:p0479:b001:l012","ordinal":21931,"en":"His iron ropes and blue nets."},{"id":"manas-2010:p0479:b001:l013","ordinal":21932,"en":"Furious, gathering his force,"},{"id":"manas-2010:p0479:b001:l014","ordinal":21933,"en":"He spoke to Karazhoy:"},{"id":"manas-2010:p0479:b001:l015","ordinal":21934,"en":"“You were a peerless marksman;"},{"id":"manas-2010:p0479:b001:l016","ordinal":21935,"en":"Aim your shot at an exposed spot."},{"id":"manas-2010:p0479:b001:l017","ordinal":21936,"en":"Why should I speak of anything else?"},{"id":"manas-2010:p0479:b001:l018","ordinal":21937,"en":"That hellish, bloodthirsty Burut's"},{"id":"manas-2010:p0479:b001:l019","ordinal":21938,"en":"Toruchaar—shoot him dead!"},{"id":"manas-2010:p0479:b001:l020","ordinal":21939,"en":"Unless we leave him horseless,"},{"id":"manas-2010:p0479:b001:l021","ordinal":21940,"en":"And kill him after that,"},{"id":"manas-2010:p0479:b001:l022","ordinal":21941,"en":"He will reach us, uprooting all,"},{"id":"manas-2010:p0479:b001:l023","ordinal":21942,"en":"Pursue us to the very end,"},{"id":"manas-2010:p0479:b001:l024","ordinal":21943,"en":"And wipe us out entirely."},{"id":"manas-2010:p0479:b001:l025","ordinal":21944,"en":"I cannot match him in fighting,"},{"id":"manas-2010:p0479:b001:l026","ordinal":21945,"en":"Nor beat him in wrestling."},{"id":"manas-2010:p0479:b001:l027","ordinal":21946,"en":"Against that accursed Burut,"},{"id":"manas-2010:p0479:b001:l028","ordinal":21947,"en":"Put all your strength to work!”"},{"id":"manas-2010:p0479:b001:l029","ordinal":21948,"en":"Thus speaking, Ezkara"},{"id":"manas-2010:p0479:b001:l030","ordinal":21949,"en":"Shouted to every governor,"},{"id":"manas-2010:p0479:b001:l031","ordinal":21950,"en":"Summoned every khan."},{"id":"manas-2010:p0479:b001:l032","ordinal":21951,"en":"From the side, Ezkara,"},{"id":"manas-2010:p0479:b001:l033","ordinal":21952,"en":"Shouting with his thick host,"},{"id":"manas-2010:p0479:b001:l034","ordinal":21953,"en":"Charged and thrust his spear."},{"id":"manas-2010:p0479:b001:l035","ordinal":21954,"en":"From the flank, Khan Zholoy"},{"id":"manas-2010:p0479:b001:l036","ordinal":21955,"en":"Launched his raiding charge."},{"id":"manas-2010:p0479:b001:l037","ordinal":21956,"en":"From the ridge, great Döödür"},{"id":"manas-2010:p0479:b001:l038","ordinal":21957,"en":"Swept in with his mighty giants."},{"id":"manas-2010:p0479:b001:l039","ordinal":21958,"en":"Taking swords and shouting,"},{"id":"manas-2010:p0479:b001:l040","ordinal":21959,"en":"All the seething Kytay"},{"id":"manas-2010:p0479:b001:l041","ordinal":21960,"en":"Surged down from every ridge."},{"id":"manas-2010:p0479:b001:l042","ordinal":21961,"en":"Karazhoy, the skilled marksman,"},{"id":"manas-2010:p0480:b001:l001","ordinal":21962,"en":"Watched for a shot at the magnanimous one."},{"id":"manas-2010:p0480:b001:l002","ordinal":21963,"en":"A dark mist became a flood;"},{"id":"manas-2010:p0480:b001:l003","ordinal":21964,"en":"The Kytay people swept over him."},{"id":"manas-2010:p0480:b001:l004","ordinal":21965,"en":"Manas was alone, the Kytay a thousand."},{"id":"manas-2010:p0480:b001:l005","ordinal":21966,"en":"They roared and thrust their spears;"},{"id":"manas-2010:p0480:b001:l006","ordinal":21967,"en":"Your lone hero Manas"},{"id":"manas-2010:p0480:b001:l007","ordinal":21968,"en":"They utterly hemmed in."},{"id":"manas-2010:p0480:b001:l008","ordinal":21969,"en":"See the reeds, see the flood!"},{"id":"manas-2010:p0480:b001:l009","ordinal":21970,"en":"See the people sweeping over him!"},{"id":"manas-2010:p0480:b001:l010","ordinal":21971,"en":"See the swirling flood!"},{"id":"manas-2010:p0480:b001:l011","ordinal":21972,"en":"See the people fighting!"},{"id":"manas-2010:p0480:b001:l012","ordinal":21973,"en":"See the hazy, misty dust!"},{"id":"manas-2010:p0480:b001:l013","ordinal":21974,"en":"With their spears jutting out,"},{"id":"manas-2010:p0480:b001:l014","ordinal":21975,"en":"Their battle-axes looming large,"},{"id":"manas-2010:p0480:b001:l015","ordinal":21976,"en":"See the people sweeping in!"},{"id":"manas-2010:p0480:b001:l016","ordinal":21977,"en":"The dust drifting in a haze"},{"id":"manas-2010:p0480:b001:l017","ordinal":21978,"en":"Enveloped the crowded lives."},{"id":"manas-2010:p0480:b001:l018","ordinal":21979,"en":"See the haze, see the embers!"},{"id":"manas-2010:p0480:b001:l019","ordinal":21980,"en":"See the cannon striking with a boom!"},{"id":"manas-2010:p0480:b001:l020","ordinal":21981,"en":"Bursting out from the cannon,"},{"id":"manas-2010:p0480:b001:l021","ordinal":21982,"en":"See the shot raining like hail!"},{"id":"manas-2010:p0480:b001:l022","ordinal":21983,"en":"Their champions swirled in confusion."},{"id":"manas-2010:p0480:b001:l023","ordinal":21984,"en":"“Hero Orgo is dead!” they cried."},{"id":"manas-2010:p0480:b001:l024","ordinal":21985,"en":"On account of that Orgo,"},{"id":"manas-2010:p0480:b001:l025","ordinal":21986,"en":"Sparing not their own lives,"},{"id":"manas-2010:p0480:b001:l026","ordinal":21987,"en":"They kept on surging forward."},{"id":"manas-2010:p0480:b001:l027","ordinal":21988,"en":"Arrows covered him like rain, they say."},{"id":"manas-2010:p0480:b001:l028","ordinal":21989,"en":"Fighting without sparing life,"},{"id":"manas-2010:p0480:b001:l029","ordinal":21990,"en":"The Kytay now pressed over him."},{"id":"manas-2010:p0480:b001:l030","ordinal":21991,"en":"The war drum thundered loudly."},{"id":"manas-2010:p0480:b001:l031","ordinal":21992,"en":"The seething Kytay"},{"id":"manas-2010:p0480:b001:l032","ordinal":21993,"en":"Swept in together."},{"id":"manas-2010:p0480:b001:l033","ordinal":21994,"en":"With no care for his skin,"},{"id":"manas-2010:p0480:b001:l034","ordinal":21995,"en":"Counting death as less than a hair,"},{"id":"manas-2010:p0480:b001:l035","ordinal":21996,"en":"Cutting a path wherever he faced,"},{"id":"manas-2010:p0480:b001:l036","ordinal":21997,"en":"Against the Kytay swarming over the earth,"},{"id":"manas-2010:p0480:b001:l037","ordinal":21998,"en":"The lone blue-maned wolf attacked."},{"id":"manas-2010:p0480:b001:l038","ordinal":21999,"en":"Maneuvering with Toruchaar,"},{"id":"manas-2010:p0480:b001:l039","ordinal":22000,"en":"The surging Kytay and Manzhuu—"},{"id":"manas-2010:p0480:b001:l040","ordinal":22001,"en":"He broke their ranks and drove them crawling."},{"id":"manas-2010:p0480:b001:l041","ordinal":22002,"en":"On that day, the noble creature,"},{"id":"manas-2010:p0480:b001:l042","ordinal":22003,"en":"Toruchaar, the peerless steed among beasts,"},{"id":"manas-2010:p0481:b001:l001","ordinal":22004,"en":"Was worthy of the lion."},{"id":"manas-2010:p0481:b001:l002","ordinal":22005,"en":"Manas and Toruchaar"},{"id":"manas-2010:p0481:b001:l003","ordinal":22006,"en":"Were both born on one day."},{"id":"manas-2010:p0481:b001:l004","ordinal":22007,"en":"While your valiant Manas lived,"},{"id":"manas-2010:p0481:b001:l005","ordinal":22008,"en":"He brought tumult to the Kytay."},{"id":"manas-2010:p0481:b001:l006","ordinal":22009,"en":"Your bloodthirsty hero's Toruchaar,"},{"id":"manas-2010:p0481:b001:l007","ordinal":22010,"en":"Ridden to battle, would never flinch;"},{"id":"manas-2010:p0481:b001:l008","ordinal":22011,"en":"Ridden with the baggage, would never ail;"},{"id":"manas-2010:p0481:b001:l009","ordinal":22012,"en":"Ridden scouting, would never tire."},{"id":"manas-2010:p0481:b001:l010","ordinal":22013,"en":"Hoe-hoofed, broad-rumped,"},{"id":"manas-2010:p0481:b001:l011","ordinal":22014,"en":"The swift steed of the open land,"},{"id":"manas-2010:p0481:b001:l012","ordinal":22015,"en":"On that battlefield"},{"id":"manas-2010:p0481:b001:l013","ordinal":22016,"en":"Lowered his neck to the earth"}]
