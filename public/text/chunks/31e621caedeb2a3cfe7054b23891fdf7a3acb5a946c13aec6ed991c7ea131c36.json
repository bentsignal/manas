[{"id":"semetey-1-2013:p0744:b004:l021","ordinal":133377,"en":"The forty warriors lay there."},{"id":"semetey-1-2013:p0744:b004:l022","ordinal":133378,"en":"What could dear Shuutu do?"},{"id":"semetey-1-2013:p0744:b004:l023","ordinal":133379,"en":"Leaving the forty warriors,"},{"id":"semetey-1-2013:p0744:b004:l024","ordinal":133380,"en":"Toward Bakai, visited by Khizr,"},{"id":"semetey-1-2013:p0744:b004:l025","ordinal":133381,"en":"He could be seen coming."},{"id":"semetey-1-2013:p0744:b004:l026","ordinal":133382,"en":"What could poor Shuutu do?"},{"id":"semetey-1-2013:p0744:b004:l027","ordinal":133383,"en":"A man as large as a camel stood on the hill,"},{"id":"semetey-1-2013:p0744:b004:l028","ordinal":133384,"en":"His white beard like fine cambric,"},{"id":"semetey-1-2013:p0744:b004:l029","ordinal":133385,"en":"His white teeth like pistachios,"},{"id":"semetey-1-2013:p0744:b004:l030","ordinal":133386,"en":"His broad ears like shields,"},{"id":"semetey-1-2013:p0744:b004:l031","ordinal":133387,"en":"His wide eyes like the morning star."},{"id":"semetey-1-2013:p0744:b004:l032","ordinal":133388,"en":"His limbs and bones—"},{"id":"semetey-1-2013:p0744:b004:l033","ordinal":133389,"en":"When one looked closely—"},{"id":"semetey-1-2013:p0744:b004:l034","ordinal":133390,"en":"Were unlike those of people today."},{"id":"semetey-1-2013:p0744:b004:l035","ordinal":133391,"en":"Whatever deed one considered,"},{"id":"semetey-1-2013:p0744:b004:l036","ordinal":133392,"en":"Your elder Bakai was outstanding."},{"id":"semetey-1-2013:p0744:b004:l037","ordinal":133393,"en":"Wondering, \"Is that Bakai?\""},{"id":"semetey-1-2013:p0744:b004:l038","ordinal":133394,"en":"Poor Shuutu stood amazed."},{"id":"semetey-1-2013:p0744:b004:l039","ordinal":133395,"en":"When he surveyed his whole appearance,"},{"id":"semetey-1-2013:p0745:b003:l001","ordinal":133396,"en":"His look was unlike Bakai's."},{"id":"semetey-1-2013:p0745:b003:l002","ordinal":133397,"en":"When he gazed and gazed closely,"},{"id":"semetey-1-2013:p0745:b003:l003","ordinal":133398,"en":"His blood had drained; only bones remained."},{"id":"semetey-1-2013:p0745:b003:l004","ordinal":133399,"en":"He seemed to have grown destitute."},{"id":"semetey-1-2013:p0745:b003:l005","ordinal":133400,"en":"The old man Bakai, worn out,"},{"id":"semetey-1-2013:p0745:b003:l006","ordinal":133401,"en":"Seemed to have grown thin."},{"id":"semetey-1-2013:p0745:b003:l007","ordinal":133402,"en":"When leopard Manas had died,"},{"id":"semetey-1-2013:p0745:b003:l008","ordinal":133403,"en":"Bakai had suffered humiliation."},{"id":"semetey-1-2013:p0745:b003:l009","ordinal":133404,"en":"When lord Manas died,"},{"id":"semetey-1-2013:p0745:b003:l010","ordinal":133405,"en":"Great Bakai suffered humiliation."},{"id":"semetey-1-2013:p0745:b003:l011","ordinal":133406,"en":"For twelve years he tended camels;"},{"id":"semetey-1-2013:p0745:b003:l012","ordinal":133407,"en":"Great Bakai suffered oppression."},{"id":"semetey-1-2013:p0745:b003:l013","ordinal":133408,"en":"When Shuutu used to see him,"},{"id":"semetey-1-2013:p0745:b003:l014","ordinal":133409,"en":"The blue-gray winged steed beneath him"},{"id":"semetey-1-2013:p0745:b003:l016","ordinal":133410,"en":"My noble blue-gray winged steed","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0745:b003:l017","ordinal":133411,"en":"Had not yet been named the short-tailed gray,"},{"id":"semetey-1-2013:p0745:b003:l018","ordinal":133412,"en":"Had not yet acquired that bad name."},{"id":"semetey-1-2013:p0745:b003:l019","ordinal":133413,"en":"Great Bakai upon him"},{"id":"semetey-1-2013:p0745:b003:l020","ordinal":133414,"en":"Grieved as he tended camels."},{"id":"semetey-1-2013:p0745:b003:l021","ordinal":133415,"en":"The blue-gray winged steed beneath him"},{"id":"semetey-1-2013:p0745:b003:l022","ordinal":133416,"en":"Had lost its mane and tail."},{"id":"semetey-1-2013:p0745:b003:l023","ordinal":133417,"en":"It had been named the short-tailed gray;"},{"id":"semetey-1-2013:p0745:b003:l024","ordinal":133418,"en":"It had acquired that bad name."},{"id":"semetey-1-2013:p0745:b003:l025","ordinal":133419,"en":"Bakai, riding upon him,"},{"id":"semetey-1-2013:p0745:b003:l026","ordinal":133420,"en":"Wore a goatskin coat on his body,"},{"id":"semetey-1-2013:p0745:b003:l027","ordinal":133421,"en":"And leather trousers on his backside."},{"id":"semetey-1-2013:p0745:b003:l028","ordinal":133422,"en":"To Bakai, grown destitute,"},{"id":"semetey-1-2013:p0745:b003:l029","ordinal":133423,"en":"Like stars in the sky,"},{"id":"semetey-1-2013:p0745:b003:l030","ordinal":133424,"en":"Shuutu the servant drew close."},{"id":"semetey-1-2013:p0745:b003:l031","ordinal":133425,"en":"To tell him of his sorrows,"},{"id":"semetey-1-2013:p0745:b003:l032","ordinal":133426,"en":"Shuutu the servant greeted him warmly."},{"id":"semetey-1-2013:p0745:b003:l033","ordinal":133427,"en":"When Shuutu saw Bakai,"},{"id":"semetey-1-2013:p0745:b003:l034","ordinal":133428,"en":"His heart was deeply troubled."},{"id":"semetey-1-2013:p0745:b003:l035","ordinal":133429,"en":"What could dear Shuutu do?"},{"id":"semetey-1-2013:p0745:b003:l036","ordinal":133430,"en":"When he saw Khan Bakai,"},{"id":"semetey-1-2013:p0745:b003:l037","ordinal":133431,"en":"Tears poured from his eyes."},{"id":"semetey-1-2013:p0745:b003:l038","ordinal":133432,"en":"His valiant elder Bakai"},{"id":"semetey-1-2013:p0745:b003:l039","ordinal":133433,"en":"Seemed the equal of Mecca."},{"id":"semetey-1-2013:p0745:b005:l001","ordinal":133434,"en":"When he saw Khan Bakai,"},{"id":"semetey-1-2013:p0745:b005:l002","ordinal":133435,"en":"His eyes darted in distress,"},{"id":"semetey-1-2013:p0745:b005:l003","ordinal":133436,"en":"His joints lost all their strength."},{"id":"semetey-1-2013:p0745:b005:l004","ordinal":133437,"en":"He wept bitterly and ached."},{"id":"semetey-1-2013:p0745:b005:l005","ordinal":133438,"en":"These were the words Shuutu spoke:"},{"id":"semetey-1-2013:p0745:b005:l006","ordinal":133439,"en":"\"Peace, peace be upon you, elder!\""},{"id":"semetey-1-2013:p0745:b005:l007","ordinal":133440,"en":"Then Bakai said:"},{"id":"semetey-1-2013:p0745:b005:l008","ordinal":133441,"en":"\"And peace upon you, my son!"},{"id":"semetey-1-2013:p0745:b005:l009","ordinal":133442,"en":"Shall I say I have grown destitute, my son?"},{"id":"semetey-1-2013:p0745:b005:l010","ordinal":133443,"en":"Are your six khan-lords well, my son?"},{"id":"semetey-1-2013:p0745:b005:l012","ordinal":133444,"en":"Here is your destitute Bakai."},{"id":"semetey-1-2013:p0745:b005:l013","ordinal":133445,"en":"Shall I say I wander grieving?"},{"id":"semetey-1-2013:p0745:b005:l014","ordinal":133446,"en":"My grief has vanished from within."},{"id":"semetey-1-2013:p0745:b005:l015","ordinal":133447,"en":"Is that aged Kyrgyl well?"},{"id":"semetey-1-2013:p0745:b005:l016","ordinal":133448,"en":"That aged Kyrgyl will not disappear."},{"id":"semetey-1-2013:p0745:b005:l017","ordinal":133449,"en":"While Tazbaimat remains alive,"},{"id":"semetey-1-2013:p0745:b005:l018","ordinal":133450,"en":"Your affairs, forty warriors, will not improve."},{"id":"semetey-1-2013:p0745:b005:l019","ordinal":133451,"en":"My darling Shuutu, servant,"},{"id":"semetey-1-2013:p0745:b005:l020","ordinal":133452,"en":"I was lord Bakai,"},{"id":"semetey-1-2013:p0745:b005:l021","ordinal":133453,"en":"And you were lord Shuutu."},{"id":"semetey-1-2013:p0745:b005:l022","ordinal":133454,"en":"When lord Manas lived,"},{"id":"semetey-1-2013:p0745:b005:l023","ordinal":133455,"en":"Lordship reached you all."},{"id":"semetey-1-2013:p0745:b005:l024","ordinal":133456,"en":"Humbled by tending camels,"},{"id":"semetey-1-2013:p0745:b005:l025","ordinal":133457,"en":"Tell your old Bakai the truth."},{"id":"semetey-1-2013:p0745:b005:l026","ordinal":133458,"en":"My darling hero Shuutu,"},{"id":"semetey-1-2013:p0745:b005:l027","ordinal":133459,"en":"Is there ill intent in your eyes?"},{"id":"semetey-1-2013:p0745:b005:l028","ordinal":133460,"en":"Is there evasiveness within you?"},{"id":"semetey-1-2013:p0745:b005:l029","ordinal":133461,"en":"Is there deceit in your eyes?"},{"id":"semetey-1-2013:p0745:b005:l030","ordinal":133462,"en":"Is there treachery within you?\""},{"id":"semetey-1-2013:p0745:b005:l031","ordinal":133463,"en":"When Bakai spoke thus,"},{"id":"semetey-1-2013:p0745:b005:l032","ordinal":133464,"en":"Too many cares filled his breast;"},{"id":"semetey-1-2013:p0745:b005:l033","ordinal":133465,"en":"His tears streamed in all directions."},{"id":"semetey-1-2013:p0745:b005:l034","ordinal":133466,"en":"\"My dear khan and elder,"},{"id":"semetey-1-2013:p0745:b005:l035","ordinal":133467,"en":"Listen to my words."},{"id":"semetey-1-2013:p0745:b005:l036","ordinal":133468,"en":"Do not make me weep."},{"id":"semetey-1-2013:p0745:b005:l037","ordinal":133469,"en":"The fetter put on both my hands—"},{"id":"semetey-1-2013:p0745:b005:l038","ordinal":133470,"en":"Do you think it became a hobble?"},{"id":"semetey-1-2013:p0745:b005:l039","ordinal":133471,"en":"Those dogs like ravens,"},{"id":"semetey-1-2013:p0746:b003:l001","ordinal":133472,"en":"Do you think they made me a lord?"},{"id":"semetey-1-2013:p0746:b003:l002","ordinal":133473,"en":"Since my lord Manas passed away,"},{"id":"semetey-1-2013:p0746:b003:l003","ordinal":133474,"en":"May I never prosper if I love a lord!"},{"id":"semetey-1-2013:p0746:b003:l004","ordinal":133475,"en":"Those six God-stricken dogs—"},{"id":"semetey-1-2013:p0746:b003:l005","ordinal":133476,"en":"If I call them lords,"},{"id":"semetey-1-2013:p0746:b003:l006","ordinal":133477,"en":"May I not be a Muslim!"},{"id":"semetey-1-2013:p0746:b003:l007","ordinal":133478,"en":"Is there news, is there word?"},{"id":"semetey-1-2013:p0746:b003:l008","ordinal":133479,"en":"My dear, beloved elder,"},{"id":"semetey-1-2013:p0746:b003:l009","ordinal":133480,"en":"Is there a night like the Night of Power?"},{"id":"semetey-1-2013:p0746:b003:l010","ordinal":133481,"en":"Khan Manas's only son—"},{"id":"semetey-1-2013:p0746:b003:l011","ordinal":133482,"en":"Will the day come when Semetey arrives?"},{"id":"semetey-1-2013:p0746:b003:l012","ordinal":133483,"en":"Elder, have you searched through Bukhara?"},{"id":"semetey-1-2013:p0746:b003:l013","ordinal":133484,"en":"Have you heard news of the orphan?"},{"id":"semetey-1-2013:p0746:b003:l014","ordinal":133485,"en":"Fortunate elder Bakai,"},{"id":"semetey-1-2013:p0746:b003:l015","ordinal":133486,"en":"Like a mighty army when set in front,"},{"id":"semetey-1-2013:p0746:b003:l016","ordinal":133487,"en":"Is there news, is there a night,"},{"id":"semetey-1-2013:p0746:b003:l017","ordinal":133488,"en":"Is there a day when my orphan will come?"},{"id":"semetey-1-2013:p0746:b003:l018","ordinal":133489,"en":"My grieving heart and swollen breast—"},{"id":"semetey-1-2013:p0746:b003:l019","ordinal":133490,"en":"Khan and elder, when will they be soothed?"},{"id":"semetey-1-2013:p0746:b003:l020","ordinal":133491,"en":"When my orphan comes here,"},{"id":"semetey-1-2013:p0746:b003:l021","ordinal":133492,"en":"When will my bleak brow brighten?"},{"id":"semetey-1-2013:p0746:b003:l022","ordinal":133493,"en":"Elder Bakai, my good fortune,"},{"id":"semetey-1-2013:p0746:b003:l023","ordinal":133494,"en":"My darling, my mighty army!"},{"id":"semetey-1-2013:p0746:b003:l024","ordinal":133495,"en":"You are truly Bakai,"},{"id":"semetey-1-2013:p0746:b003:l025","ordinal":133496,"en":"And I am grieving Shuutu."},{"id":"semetey-1-2013:p0746:b003:l026","ordinal":133497,"en":"Humbled by tending camels,"},{"id":"semetey-1-2013:p0746:b003:l027","ordinal":133498,"en":"You were lord Bakai."},{"id":"semetey-1-2013:p0746:b003:l028","ordinal":133499,"en":"With ears that heard far and eyes that saw,"},{"id":"semetey-1-2013:p0746:b003:l029","ordinal":133500,"en":"You were a hero like a saint."},{"id":"semetey-1-2013:p0746:b003:l030","ordinal":133501,"en":"Did you turn toward Bukhara?"},{"id":"semetey-1-2013:p0746:b003:l031","ordinal":133502,"en":"Did you get news of the orphan?"},{"id":"semetey-1-2013:p0746:b003:l032","ordinal":133503,"en":"I burn with sorrow, thinking of sister-in-law Kanykei."},{"id":"semetey-1-2013:p0746:b003:l033","ordinal":133504,"en":"I keep pondering the orphan."},{"id":"semetey-1-2013:p0746:b003:l034","ordinal":133505,"en":"If my orphan lives in safety,"},{"id":"semetey-1-2013:p0746:b003:l035","ordinal":133506,"en":"Twelve years must have passed;"},{"id":"semetey-1-2013:p0746:b003:l036","ordinal":133507,"en":"This year he must be twelve years old."},{"id":"semetey-1-2013:p0746:b003:l037","ordinal":133508,"en":"My khan and elder Bakai, listen:"},{"id":"semetey-1-2013:p0746:b003:l038","ordinal":133509,"en":"Let me count the years;"},{"id":"semetey-1-2013:p0746:b003:l039","ordinal":133510,"en":"Let me count them out for you."},{"id":"semetey-1-2013:p0746:b004:l001","ordinal":133511,"en":"There was Mouse, there was Ox,"},{"id":"semetey-1-2013:p0746:b004:l002","ordinal":133512,"en":"Then Tiger, then Hare,"},{"id":"semetey-1-2013:p0746:b004:l003","ordinal":133513,"en":"There was Fish, there was Snake,"},{"id":"semetey-1-2013:p0746:b004:l004","ordinal":133514,"en":"Then Horse, then Sheep,"},{"id":"semetey-1-2013:p0746:b004:l005","ordinal":133515,"en":"Then Monkey, then Hen,"},{"id":"semetey-1-2013:p0746:b004:l006","ordinal":133516,"en":"Then Dog, then Pig."},{"id":"semetey-1-2013:p0746:b004:l007","ordinal":133517,"en":"My orphan left by Manas"},{"id":"semetey-1-2013:p0746:b004:l008","ordinal":133518,"en":"Must have turned twelve."},{"id":"semetey-1-2013:p0746:b004:l009","ordinal":133519,"en":"This very year, my orphan"},{"id":"semetey-1-2013:p0746:b004:l010","ordinal":133520,"en":"Has grown mature, become a man,"},{"id":"semetey-1-2013:p0746:b004:l011","ordinal":133521,"en":"Become the equal of a hero's son.\""},{"id":"semetey-1-2013:p0746:b004:l012","ordinal":133522,"en":"When hero Shuutu asked about the orphan,"},{"id":"semetey-1-2013:p0746:b004:l013","ordinal":133523,"en":"Then Bakai said:"},{"id":"semetey-1-2013:p0746:b004:l014","ordinal":133524,"en":"\"Ah, my darling Shuutu, servant,"},{"id":"semetey-1-2013:p0746:b004:l015","ordinal":133525,"en":"Today our honor has been restored."},{"id":"semetey-1-2013:p0746:b004:l016","ordinal":133526,"en":"Our exposed flesh has been covered."},{"id":"semetey-1-2013:p0746:b004:l017","ordinal":133527,"en":"When leopard Manas died,"},{"id":"semetey-1-2013:p0746:b004:l018","ordinal":133528,"en":"The steel I held was chipped."},{"id":"semetey-1-2013:p0746:b004:l019","ordinal":133529,"en":"Today I stand here,"},{"id":"semetey-1-2013:p0746:b004:l020","ordinal":133530,"en":"My darling Shuutu, servant,"},{"id":"semetey-1-2013:p0746:b004:l021","ordinal":133531,"en":"My orphan has arrived, grown to maturity."},{"id":"semetey-1-2013:p0746:b004:l022","ordinal":133532,"en":"Before twelve years had passed,"},{"id":"semetey-1-2013:p0746:b004:l023","ordinal":133533,"en":"My darling Shuutu, servant,"},{"id":"semetey-1-2013:p0746:b004:l024","ordinal":133534,"en":"The orphan left by Manas,"},{"id":"semetey-1-2013:p0746:b004:l025","ordinal":133535,"en":"Saying, 'I shall lose my strength,'"},{"id":"semetey-1-2013:p0746:b004:l026","ordinal":133536,"en":"I sent fleeing from Talas on foot."},{"id":"semetey-1-2013:p0746:b004:l027","ordinal":133537,"en":"Saying, 'Those dogs will not let him prosper,'"},{"id":"semetey-1-2013:p0746:b004:l028","ordinal":133538,"en":"I sent him wandering toward Temir."},{"id":"semetey-1-2013:p0746:b004:l029","ordinal":133539,"en":"Old Bakai gazed forlornly."},{"id":"semetey-1-2013:p0746:b004:l030","ordinal":133540,"en":"For twelve years,"},{"id":"semetey-1-2013:p0746:b004:l031","ordinal":133541,"en":"I languished, tending camels."},{"id":"semetey-1-2013:p0746:b004:l032","ordinal":133542,"en":"This very day, Shuutu, servant,"},{"id":"semetey-1-2013:p0746:b004:l033","ordinal":133543,"en":"My orphan came and I recovered."},{"id":"semetey-1-2013:p0746:b004:l034","ordinal":133544,"en":"Good news, Shuutu, good news!"},{"id":"semetey-1-2013:p0746:b004:l035","ordinal":133545,"en":"Led by the six scoundrels, the forty warriors"},{"id":"semetey-1-2013:p0746:b004:l036","ordinal":133546,"en":"Raided my migrating camp at Keng-Kol."},{"id":"semetey-1-2013:p0746:b004:l037","ordinal":133547,"en":"Today, from those swaggering dogs,"},{"id":"semetey-1-2013:p0746:b004:l038","ordinal":133548,"en":"I, Bakai, can gain full satisfaction"},{"id":"semetey-1-2013:p0746:b004:l039","ordinal":133549,"en":"And take my revenge."},{"id":"semetey-1-2013:p0747:b003:l001","ordinal":133550,"en":"All the fools joined together"},{"id":"semetey-1-2013:p0747:b003:l003","ordinal":133551,"en":"Having no mountain to lean upon,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0747:b003:l004","ordinal":133552,"en":"I could not settle my grievance with those dogs."},{"id":"semetey-1-2013:p0747:b003:l005","ordinal":133553,"en":"My orphan came, and I was restored."},{"id":"semetey-1-2013:p0747:b003:l006","ordinal":133554,"en":"I joined the ranks again."},{"id":"semetey-1-2013:p0747:b003:l007","ordinal":133555,"en":"The wealth they would not give when asked—"},{"id":"semetey-1-2013:p0747:b003:l008","ordinal":133556,"en":"I shall seize it by force,"},{"id":"semetey-1-2013:p0747:b003:l009","ordinal":133557,"en":"From those sprawled-out dogs"},{"id":"semetey-1-2013:p0747:b003:l011","ordinal":133558,"en":"When Bakai spoke thus,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0747:b003:l012","ordinal":133559,"en":"The hero Shuutu said:"},{"id":"semetey-1-2013:p0747:b003:l013","ordinal":133560,"en":"\"If there is a day that brings us honor,"},{"id":"semetey-1-2013:p0747:b003:l014","ordinal":133561,"en":"If there is such a renowned night,"},{"id":"semetey-1-2013:p0747:b003:l015","ordinal":133562,"en":"Elder Bakai, hear my words!"},{"id":"semetey-1-2013:p0747:b003:l016","ordinal":133563,"en":"This very day hero Kobosh,"},{"id":"semetey-1-2013:p0747:b003:l017","ordinal":133564,"en":"Coughing in great bursts,"},{"id":"semetey-1-2013:p0747:b003:l018","ordinal":133565,"en":"Lifting his head from his bed,"},{"id":"semetey-1-2013:p0747:b003:l019","ordinal":133566,"en":"Like one stricken by God,"},{"id":"semetey-1-2013:p0747:b003:l020","ordinal":133567,"en":"Has lain there, refusing to rise."},{"id":"semetey-1-2013:p0747:b003:l021","ordinal":133568,"en":"Know his lordship by this:"},{"id":"semetey-1-2013:p0747:b003:l022","ordinal":133569,"en":"All the forty warriors,"},{"id":"semetey-1-2013:p0747:b003:l023","ordinal":133570,"en":"The elders with Kyrgyl at their head,"},{"id":"semetey-1-2013:p0747:b003:l024","ordinal":133571,"en":"Those God-stricken dogs"},{"id":"semetey-1-2013:p0747:b003:l025","ordinal":133572,"en":"Have made their lords."},{"id":"semetey-1-2013:p0747:b003:l026","ordinal":133573,"en":"Upon all the forty warriors"},{"id":"semetey-1-2013:p0747:b003:l027","ordinal":133574,"en":"They have brought cruel upheaval."},{"id":"semetey-1-2013:p0747:b003:l028","ordinal":133575,"en":"All the forty warriors"},{"id":"semetey-1-2013:p0747:b003:l029","ordinal":133576,"en":"Can no longer utter a peep."},{"id":"semetey-1-2013:p0747:b003:l030","ordinal":133577,"en":"The damned forty warriors"},{"id":"semetey-1-2013:p0747:b003:l031","ordinal":133578,"en":"Have surrendered their unity."},{"id":"semetey-1-2013:p0747:b003:l032","ordinal":133579,"en":"In the late morning,"},{"id":"semetey-1-2013:p0747:b003:l033","ordinal":133580,"en":"Such are Kobosh's deeds,"},{"id":"semetey-1-2013:p0747:b003:l034","ordinal":133581,"en":"Such is his wicked disposition:"},{"id":"semetey-1-2013:p0747:b003:l035","ordinal":133582,"en":"Barefoot and bareheaded,"},{"id":"semetey-1-2013:p0747:b003:l036","ordinal":133583,"en":"Dear Khan Kobosh comes out."},{"id":"semetey-1-2013:p0747:b003:l037","ordinal":133584,"en":"If he lets out one shout,"},{"id":"semetey-1-2013:p0747:b003:l038","ordinal":133585,"en":"The forty warriors are scared to death."},{"id":"semetey-1-2013:p0747:b003:l039","ordinal":133586,"en":"If you want a spectacle, look here:"},{"id":"semetey-1-2013:p0747:b005:l001","ordinal":133587,"en":"The elders with Kyrgyl at their head"},{"id":"semetey-1-2013:p0747:b005:l002","ordinal":133588,"en":"Run as though they were dying."},{"id":"semetey-1-2013:p0747:b005:l003","ordinal":133589,"en":"When they come close before him,"},{"id":"semetey-1-2013:p0747:b005:l004","ordinal":133590,"en":"Their knees bend to the ground."},{"id":"semetey-1-2013:p0747:b005:l005","ordinal":133591,"en":"Before that fool,"},{"id":"semetey-1-2013:p0747:b005:l006","ordinal":133592,"en":"They bow like Kalmyks."},{"id":"semetey-1-2013:p0747:b005:l007","ordinal":133593,"en":"If you ask how Kobosh fares:"},{"id":"semetey-1-2013:p0747:b005:l008","ordinal":133594,"en":"Eating yearlings of barren mares,"},{"id":"semetey-1-2013:p0747:b005:l009","ordinal":133595,"en":"Eating frozen goat fat,"},{"id":"semetey-1-2013:p0747:b005:l010","ordinal":133596,"en":"The six scoundrels revel in arrogance."},{"id":"semetey-1-2013:p0747:b005:l011","ordinal":133597,"en":"Akolpok, left by Manas—"},{"id":"semetey-1-2013:p0747:b005:l012","ordinal":133598,"en":"If you ask about that coat,"},{"id":"semetey-1-2013:p0747:b005:l013","ordinal":133599,"en":"When leopard Manas lived,"},{"id":"semetey-1-2013:p0747:b005:l014","ordinal":133600,"en":"Double mail with rings like larks' eyes,"},{"id":"semetey-1-2013:p0747:b005:l015","ordinal":133601,"en":"Worn in battle, no bullet could pierce it;"},{"id":"semetey-1-2013:p0747:b005:l016","ordinal":133602,"en":"When thrust at, no spear could pierce it."},{"id":"semetey-1-2013:p0747:b005:l017","ordinal":133603,"en":"That dear woman Kanykei"},{"id":"semetey-1-2013:p0747:b005:l018","ordinal":133604,"en":"With skeins of golden steel"},{"id":"semetey-1-2013:p0747:b005:l019","ordinal":133605,"en":"Had it tightly wound,"},{"id":"semetey-1-2013:p0747:b005:l020","ordinal":133606,"en":"Dazzling the eyes when one gazed."},{"id":"semetey-1-2013:p0747:b005:l021","ordinal":133607,"en":"Poor lord Manas's"},{"id":"semetey-1-2013:p0747:b005:l022","ordinal":133608,"en":"Joy she satisfied in this way."},{"id":"semetey-1-2013:p0747:b005:l023","ordinal":133609,"en":"Kelte's bullet could not cut through it."},{"id":"semetey-1-2013:p0747:b005:l024","ordinal":133610,"en":"Alas, this world!"},{"id":"semetey-1-2013:p0747:b005:l025","ordinal":133611,"en":"Even if six thousand Chinese attacked from behind,"},{"id":"semetey-1-2013:p0747:b005:l027","ordinal":133612,"en":"No cutting blade could slash through it;"},{"id":"semetey-1-2013:p0747:b005:l028","ordinal":133613,"en":"No thrusting spear could pierce it."},{"id":"semetey-1-2013:p0747:b005:l029","ordinal":133614,"en":"A precious fabric of esteemed worth,"},{"id":"semetey-1-2013:p0747:b005:l030","ordinal":133615,"en":"Khan Manas's Akolpok—"},{"id":"semetey-1-2013:p0747:b005:l031","ordinal":133616,"en":"They have taken it as booty."},{"id":"semetey-1-2013:p0747:b005:l032","ordinal":133617,"en":"The six scoundrels, raised as commoners,"},{"id":"semetey-1-2013:p0747:b005:l033","ordinal":133618,"en":"They have put it on carelessly."},{"id":"semetey-1-2013:p0747:b005:l034","ordinal":133619,"en":"This Akolpok of Manas—"},{"id":"semetey-1-2013:p0747:b005:l035","ordinal":133620,"en":"They have taken it as booty."},{"id":"semetey-1-2013:p0747:b005:l036","ordinal":133621,"en":"For the orphan, the Bloodthirsty One's son,"},{"id":"semetey-1-2013:p0747:b005:l037","ordinal":133622,"en":"Ask for it and obtain it."},{"id":"semetey-1-2013:p0747:b005:l038","ordinal":133623,"en":"If they refuse when you ask,"},{"id":"semetey-1-2013:p0747:b005:l039","ordinal":133624,"en":"Then unleash an upheaval."},{"id":"semetey-1-2013:p0748:b003:l001","ordinal":133625,"en":"I will not die burning with grief."},{"id":"semetey-1-2013:p0748:b003:l002","ordinal":133626,"en":"The magnanimous khan's Akolpok—"},{"id":"semetey-1-2013:p0748:b003:l003","ordinal":133627,"en":"I cannot bear to see those dogs have it."},{"id":"semetey-1-2013:p0748:b003:l004","ordinal":133628,"en":"Ask for it as a gift and take it away."},{"id":"semetey-1-2013:p0748:b003:l005","ordinal":133629,"en":"Listen, elder, there is more."},{"id":"semetey-1-2013:p0748:b003:l006","ordinal":133630,"en":"Once, from the pass of Kum-Bulak,"},{"id":"semetey-1-2013:p0748:b003:l007","ordinal":133631,"en":"Leopard Manas, the bloodthirsty lion,"},{"id":"semetey-1-2013:p0748:b003:l008","ordinal":133632,"en":"While out on a raid,"}]
