[{"id":"manas-2010:p1294:b001:l017","ordinal":56065,"en":"His whole body covered in blood."},{"id":"manas-2010:p1294:b001:l018","ordinal":56066,"en":"When dear Almambet returned like this,"},{"id":"manas-2010:p1294:b001:l019","ordinal":56067,"en":"To battle, hero Syrgak,"},{"id":"manas-2010:p1294:b001:l020","ordinal":56068,"en":"Against the surging infidels,"},{"id":"manas-2010:p1294:b001:l021","ordinal":56069,"en":"Hero Syrgak launched his charge."},{"id":"manas-2010:p1294:b001:l022","ordinal":56070,"en":"Kökchebich beneath him,"},{"id":"manas-2010:p1294:b001:l023","ordinal":56071,"en":"He made him prance as he entered their midst."},{"id":"manas-2010:p1294:b001:l024","ordinal":56072,"en":"The moment he entered, hero Syrgak"},{"id":"manas-2010:p1294:b001:l025","ordinal":56073,"en":"Shouted, “Islam!”"},{"id":"manas-2010:p1294:b001:l026","ordinal":56074,"en":"Raising “Manas!” as his battle-cry,"},{"id":"manas-2010:p1294:b001:l027","ordinal":56075,"en":"With Kongurbay at their head,"},{"id":"manas-2010:p1294:b001:l028","ordinal":56076,"en":"Onto Kürpüldök's plain,"},{"id":"manas-2010:p1294:b001:l029","ordinal":56077,"en":"The great Chinese army"},{"id":"manas-2010:p1294:b001:l030","ordinal":56078,"en":"He drove in a scattering rush."},{"id":"manas-2010:p1294:b001:l031","ordinal":56079,"en":"When Syrgak struck them,"},{"id":"manas-2010:p1294:b001:l032","ordinal":56080,"en":"With Khan Kongurbay at their head,"},{"id":"manas-2010:p1294:b001:l033","ordinal":56081,"en":"The multitude of Chinese fled back,"},{"id":"manas-2010:p1294:b001:l034","ordinal":56082,"en":"Unable to stand courageously against Syrgak,"},{"id":"manas-2010:p1294:b001:l035","ordinal":56083,"en":"Unable to find any stratagem,"},{"id":"manas-2010:p1294:b001:l036","ordinal":56084,"en":"Unable to hold their ground."},{"id":"manas-2010:p1294:b001:l037","ordinal":56085,"en":"From the Chinese emperor's Beijing,"},{"id":"manas-2010:p1294:b001:l038","ordinal":56086,"en":"The Chinese who had swept upon them—"},{"id":"manas-2010:p1294:b001:l039","ordinal":56087,"en":"He was driving them back."},{"id":"manas-2010:p1294:b001:l040","ordinal":56088,"en":"Gathering them round,"},{"id":"manas-2010:p1294:b001:l041","ordinal":56089,"en":"Making their world shrivel,"},{"id":"manas-2010:p1294:b001:l042","ordinal":56090,"en":"He rounded them up and drove them on."},{"id":"manas-2010:p1295:b001:l001","ordinal":56091,"en":"Like jackdaws struck by a falcon,"},{"id":"manas-2010:p1295:b001:l002","ordinal":56092,"en":"Riding out beyond them,"},{"id":"manas-2010:p1295:b001:l003","ordinal":56093,"en":"Riding out on this side,"},{"id":"manas-2010:p1295:b001:l004","ordinal":56094,"en":"He kept driving them onward."},{"id":"manas-2010:p1295:b001:l005","ordinal":56095,"en":"Like a wolf among sheep,"},{"id":"manas-2010:p1295:b001:l006","ordinal":56096,"en":"Taking no account of the countless troops,"},{"id":"manas-2010:p1295:b001:l007","ordinal":56097,"en":"He went on slaughtering them."},{"id":"manas-2010:p1295:b001:l008","ordinal":56098,"en":"Like larks struck by a merlin,"},{"id":"manas-2010:p1295:b001:l009","ordinal":56099,"en":"With his lance, the Chinese"},{"id":"manas-2010:p1295:b001:l010","ordinal":56100,"en":"He hooked and carried along."},{"id":"manas-2010:p1295:b001:l011","ordinal":56101,"en":"Like crows struck by a saker falcon,"},{"id":"manas-2010:p1295:b001:l012","ordinal":56102,"en":"Whatever he knew how to do, hero Syrgak"},{"id":"manas-2010:p1295:b001:l013","ordinal":56103,"en":"Went on doing."},{"id":"manas-2010:p1295:b001:l014","ordinal":56104,"en":"Roaring like a hungry lion,"},{"id":"manas-2010:p1295:b001:l015","ordinal":56105,"en":"Swooping like a white falcon,"},{"id":"manas-2010:p1295:b001:l016","ordinal":56106,"en":"Seeing no man as a match for him,"},{"id":"manas-2010:p1295:b001:l017","ordinal":56107,"en":"At his own will, the Chinese"},{"id":"manas-2010:p1295:b001:l018","ordinal":56108,"en":"He went on tearing through."},{"id":"manas-2010:p1295:b001:l019","ordinal":56109,"en":"Kürpüldök's Sary-Suu—"},{"id":"manas-2010:p1295:b001:l020","ordinal":56110,"en":"To the banks of Sary-Suu,"},{"id":"manas-2010:p1295:b001:l021","ordinal":56111,"en":"Driving the Chinese away"},{"id":"manas-2010:p1295:b001:l022","ordinal":56112,"en":"From Manas at Tal-Choku,"},{"id":"manas-2010:p1295:b001:l023","ordinal":56113,"en":"A journey of ten days,"},{"id":"manas-2010:p1295:b001:l024","ordinal":56114,"en":"When he came to Kürpüldök,"},{"id":"manas-2010:p1295:b001:l025","ordinal":56115,"en":"Hero Syrgak, son of Ulak Khan,"},{"id":"manas-2010:p1295:b001:l026","ordinal":56116,"en":"As though he had only just attacked,"},{"id":"manas-2010:p1295:b001:l027","ordinal":56117,"en":"Gathered strength and waged war."},{"id":"manas-2010:p1295:b001:l028","ordinal":56118,"en":"Making the Chinese thunder along,"},{"id":"manas-2010:p1295:b001:l029","ordinal":56119,"en":"To the banks of Kürpüldök"},{"id":"manas-2010:p1295:b001:l030","ordinal":56120,"en":"He chased and drove them."},{"id":"manas-2010:p1295:b001:l031","ordinal":56121,"en":"When he saw the Chinese hemmed in,"},{"id":"manas-2010:p1295:b001:l032","ordinal":56122,"en":"When he saw them gathered,"},{"id":"manas-2010:p1295:b001:l033","ordinal":56123,"en":"From the great host of soldiers,"},{"id":"manas-2010:p1295:b001:l034","ordinal":56124,"en":"By young Syrgak alone,"},{"id":"manas-2010:p1295:b001:l035","ordinal":56125,"en":"When he saw them slaughtered,"},{"id":"manas-2010:p1295:b001:l036","ordinal":56126,"en":"Kongurbay grew furious."},{"id":"manas-2010:p1295:b001:l037","ordinal":56127,"en":"A means to deal with Syrgak"},{"id":"manas-2010:p1295:b001:l038","ordinal":56128,"en":"Kongurbay could not find."},{"id":"manas-2010:p1295:b001:l039","ordinal":56129,"en":"On the banks of Sary-Suu,"},{"id":"manas-2010:p1295:b001:l040","ordinal":56130,"en":"Kongurbay thrashed about,"},{"id":"manas-2010:p1295:b001:l041","ordinal":56131,"en":"Unable to find a course of action."},{"id":"manas-2010:p1295:b001:l042","ordinal":56132,"en":"“Syrgak has ruined every stratagem;"},{"id":"manas-2010:p1296:b001:l001","ordinal":56133,"en":"He has finished slaughtering the Chinese!”"},{"id":"manas-2010:p1296:b001:l002","ordinal":56134,"en":"Kongurbay went about weeping."},{"id":"manas-2010:p1296:b001:l003","ordinal":56135,"en":"Kongurbay's roaring"},{"id":"manas-2010:p1296:b001:l004","ordinal":56136,"en":"And weeping, when he saw it,"},{"id":"manas-2010:p1296:b001:l005","ordinal":56137,"en":"Syrgak thought to himself:"},{"id":"manas-2010:p1296:b001:l006","ordinal":56138,"en":"“Sweeping, driving and pursuing them,"},{"id":"manas-2010:p1296:b001:l007","ordinal":56139,"en":"I have killed the lesser Chinese."},{"id":"manas-2010:p1296:b001:l008","ordinal":56140,"en":"By going on killing their lesser men,"},{"id":"manas-2010:p1296:b001:l009","ordinal":56141,"en":"What inheritance shall I gain?"},{"id":"manas-2010:p1296:b001:l010","ordinal":56142,"en":"Beijing's mighty one, Kongurbay—"},{"id":"manas-2010:p1296:b001:l011","ordinal":56143,"en":"Let me face him once."},{"id":"manas-2010:p1296:b001:l012","ordinal":56144,"en":"The shot-proof undergarment,"},{"id":"manas-2010:p1296:b001:l013","ordinal":56145,"en":"Let me put it closely over myself."},{"id":"manas-2010:p1296:b001:l014","ordinal":56146,"en":"If I kill Kongurbay,"},{"id":"manas-2010:p1296:b001:l015","ordinal":56147,"en":"The remaining Chinese multitude"},{"id":"manas-2010:p1296:b001:l016","ordinal":56148,"en":"I shall drive as far as Beijing."},{"id":"manas-2010:p1296:b001:l017","ordinal":56149,"en":"Of this champion Fierce One,"},{"id":"manas-2010:p1296:b001:l018","ordinal":56150,"en":"Let me learn his worth.”"},{"id":"manas-2010:p1296:b001:l019","ordinal":56151,"en":"Saying this, hero Syrgak—"},{"id":"manas-2010:p1296:b001:l020","ordinal":56152,"en":"Covered in elephant hide,"},{"id":"manas-2010:p1296:b001:l021","ordinal":56153,"en":"By the lame smith Bölökbay"},{"id":"manas-2010:p1296:b001:l022","ordinal":56154,"en":"Skillfully fitted,"},{"id":"manas-2010:p1296:b001:l023","ordinal":56155,"en":"Wrapped outside in copper,"},{"id":"manas-2010:p1296:b001:l024","ordinal":56156,"en":"With steel joined to its tip,"},{"id":"manas-2010:p1296:b001:l025","ordinal":56157,"en":"So that the place it struck would not stay sound,"},{"id":"manas-2010:p1296:b001:l026","ordinal":56158,"en":"But fester until its victim died,"},{"id":"manas-2010:p1296:b001:l027","ordinal":56159,"en":"In a dragon's venom"},{"id":"manas-2010:p1296:b001:l028","ordinal":56160,"en":"Six times it had been steeped—"},{"id":"manas-2010:p1296:b001:l029","ordinal":56161,"en":"Hero Syrgak's lacquered lance,"},{"id":"manas-2010:p1296:b001:l030","ordinal":56162,"en":"Spitting into his hand,"},{"id":"manas-2010:p1296:b001:l031","ordinal":56163,"en":"He gripped it firmly by the butt."},{"id":"manas-2010:p1296:b001:l032","ordinal":56164,"en":"“Kongurbay, khan of the shaven-headed ones,"},{"id":"manas-2010:p1296:b001:l033","ordinal":56165,"en":"Come here, if you are a hero!"},{"id":"manas-2010:p1296:b001:l034","ordinal":56166,"en":"Do not keep fleeing!” he cried, gripping it."},{"id":"manas-2010:p1296:b001:l035","ordinal":56167,"en":"“If you keep fleeing, Kongurbay,"},{"id":"manas-2010:p1296:b001:l036","ordinal":56168,"en":"Without sparing myself or stopping,"},{"id":"manas-2010:p1296:b001:l037","ordinal":56169,"en":"I ride the winged steed Kökchebich;"},{"id":"manas-2010:p1296:b001:l038","ordinal":56170,"en":"Pursuing you without falling behind,"},{"id":"manas-2010:p1296:b001:l039","ordinal":56171,"en":"I shall drive you all the way to Beijing!"},{"id":"manas-2010:p1296:b001:l040","ordinal":56172,"en":"Forget Outer Beijing!"},{"id":"manas-2010:p1296:b001:l041","ordinal":56173,"en":"Pursuing you without mercy,"},{"id":"manas-2010:p1296:b001:l042","ordinal":56174,"en":"I shall enter Innermost Beijing!”"},{"id":"manas-2010:p1297:b001:l001","ordinal":56175,"en":"At that moment Kongurbay,"},{"id":"manas-2010:p1297:b001:l002","ordinal":56176,"en":"When he saw Syrgak's fury,"},{"id":"manas-2010:p1297:b001:l003","ordinal":56177,"en":"His ribs trembling,"},{"id":"manas-2010:p1297:b001:l004","ordinal":56178,"en":"His living heart quaking,"},{"id":"manas-2010:p1297:b001:l005","ordinal":56179,"en":"Unable to endure his heat,"},{"id":"manas-2010:p1297:b001:l006","ordinal":56180,"en":"Unable to stand his fearsome presence,"},{"id":"manas-2010:p1297:b001:l007","ordinal":56181,"en":"He would not hold back from combat;"},{"id":"manas-2010:p1297:b001:l008","ordinal":56182,"en":"There was no other way with Syrgak."},{"id":"manas-2010:p1297:b001:l009","ordinal":56183,"en":"For the Fierce One, even flight"},{"id":"manas-2010:p1297:b001:l010","ordinal":56184,"en":"Would bring not a fingernail's worth of benefit."},{"id":"manas-2010:p1297:b001:l011","ordinal":56185,"en":"Thinking this, Kongurbay"},{"id":"manas-2010:p1297:b001:l012","ordinal":56186,"en":"Summoned his courage."},{"id":"manas-2010:p1297:b001:l013","ordinal":56187,"en":"Roaring like a boar,"},{"id":"manas-2010:p1297:b001:l014","ordinal":56188,"en":"Turning back and clenching his teeth,"},{"id":"manas-2010:p1297:b001:l015","ordinal":56189,"en":"He stood looking at Syrgak."},{"id":"manas-2010:p1297:b001:l016","ordinal":56190,"en":"At that moment hero Syrgak"},{"id":"manas-2010:p1297:b001:l017","ordinal":56191,"en":"Spoke to Kongurbay;"},{"id":"manas-2010:p1297:b001:l018","ordinal":56192,"en":"When he spoke, he said:"},{"id":"manas-2010:p1297:b001:l019","ordinal":56193,"en":"“So that you will not be left regretting it,"},{"id":"manas-2010:p1297:b001:l020","ordinal":56194,"en":"Take your turn,” he said."},{"id":"manas-2010:p1297:b001:l021","ordinal":56195,"en":"Hearing this, Kongurbay"},{"id":"manas-2010:p1297:b001:l022","ordinal":56196,"en":"Said, “Very well, Syrgak.”"},{"id":"manas-2010:p1297:b001:l023","ordinal":56197,"en":"The warrior Fierce One charged."},{"id":"manas-2010:p1297:b001:l024","ordinal":56198,"en":"The force of Kongurbay's rush"},{"id":"manas-2010:p1297:b001:l025","ordinal":56199,"en":"Became a roaring wind."},{"id":"manas-2010:p1297:b001:l026","ordinal":56200,"en":"Before an eye could open and close,"},{"id":"manas-2010:p1297:b001:l027","ordinal":56201,"en":"The magnificent Fierce One arrived."},{"id":"manas-2010:p1297:b001:l028","ordinal":56202,"en":"At Syrgak, as soon as he reached him,"},{"id":"manas-2010:p1297:b001:l029","ordinal":56203,"en":"His lance made of reed—"},{"id":"manas-2010:p1297:b001:l030","ordinal":56204,"en":"Its working was formidable."},{"id":"manas-2010:p1297:b001:l031","ordinal":56205,"en":"When he came and thrust at Syrgak,"},{"id":"manas-2010:p1297:b001:l032","ordinal":56206,"en":"The lance burst apart,"},{"id":"manas-2010:p1297:b001:l033","ordinal":56207,"en":"Splintering into forty pieces."},{"id":"manas-2010:p1297:b001:l034","ordinal":56208,"en":"Hero Syrgak launched his charge,"},{"id":"manas-2010:p1297:b001:l035","ordinal":56209,"en":"Rushing toward the Fierce One."},{"id":"manas-2010:p1297:b001:l036","ordinal":56210,"en":"Kongurbay stood watching,"},{"id":"manas-2010:p1297:b001:l037","ordinal":56211,"en":"Looming there with his flank exposed."},{"id":"manas-2010:p1297:b001:l038","ordinal":56212,"en":"As charging Syrgak was about to reach him,"},{"id":"manas-2010:p1297:b001:l039","ordinal":56213,"en":"With his lance, the Fierce One,"},{"id":"manas-2010:p1297:b001:l040","ordinal":56214,"en":"As he was about to thrust into his flank,"},{"id":"manas-2010:p1297:b001:l041","ordinal":56215,"en":"The all-cutting blade in its sheath,"},{"id":"manas-2010:p1297:b001:l042","ordinal":56216,"en":"He gripped close and swung;"},{"id":"manas-2010:p1298:b001:l001","ordinal":56217,"en":"Hero Syrgak's lacquered lance"},{"id":"manas-2010:p1298:b001:l002","ordinal":56218,"en":"He slashed across and severed."},{"id":"manas-2010:p1298:b001:l003","ordinal":56219,"en":"The two were left without lances."},{"id":"manas-2010:p1298:b001:l004","ordinal":56220,"en":"Seizing each other by the lowest hems,"},{"id":"manas-2010:p1298:b001:l005","ordinal":56221,"en":"Tugging and wrenching,"},{"id":"manas-2010:p1298:b001:l006","ordinal":56222,"en":"Heaving but finding no advantage,"},{"id":"manas-2010:p1298:b001:l007","ordinal":56223,"en":"Standing with their feet braced,"},{"id":"manas-2010:p1298:b001:l008","ordinal":56224,"en":"On the banks of Kürpüldök,"},{"id":"manas-2010:p1298:b001:l009","ordinal":56225,"en":"They fought with shattering blows."},{"id":"manas-2010:p1298:b001:l010","ordinal":56226,"en":"They were soaked in dark blood;"},{"id":"manas-2010:p1298:b001:l011","ordinal":56227,"en":"They fought standing firm, without fleeing."},{"id":"manas-2010:p1298:b001:l012","ordinal":56228,"en":"They made their steeds rear and plunge."},{"id":"manas-2010:p1298:b001:l013","ordinal":56229,"en":"The two lions were like prized goshawks;"},{"id":"manas-2010:p1298:b001:l014","ordinal":56230,"en":"They stood without sparing their lives."},{"id":"manas-2010:p1298:b001:l015","ordinal":56231,"en":"The shields upon them,"},{"id":"manas-2010:p1298:b001:l016","ordinal":56232,"en":"The helmets on their heads,"},{"id":"manas-2010:p1298:b001:l017","ordinal":56233,"en":"They tore like wool"},{"id":"manas-2010:p1298:b001:l018","ordinal":56234,"en":"And smashed to pieces."},{"id":"manas-2010:p1298:b001:l019","ordinal":56235,"en":"Kongurbay lost his strength,"},{"id":"manas-2010:p1298:b001:l020","ordinal":56236,"en":"Unable to find a stratagem;"},{"id":"manas-2010:p1298:b001:l021","ordinal":56237,"en":"His hair was torn out, leaving him bald."},{"id":"manas-2010:p1298:b001:l022","ordinal":56238,"en":"Cotton belt and broad boots—"},{"id":"manas-2010:p1298:b001:l023","ordinal":56239,"en":"The infidel khan of the shaven-headed ones,"},{"id":"manas-2010:p1298:b001:l024","ordinal":56240,"en":"That imposing warrior,"},{"id":"manas-2010:p1298:b001:l025","ordinal":56241,"en":"Decided to deceive Syrgak."},{"id":"manas-2010:p1298:b001:l026","ordinal":56242,"en":"He meant to bring torment upon"},{"id":"manas-2010:p1298:b001:l027","ordinal":56243,"en":"That headstrong young fellow."},{"id":"manas-2010:p1298:b001:l028","ordinal":56244,"en":"Swinging his battle-axe,"},{"id":"manas-2010:p1298:b001:l029","ordinal":56245,"en":"Kongurbay stood ready."},{"id":"manas-2010:p1298:b001:l030","ordinal":56246,"en":"Speaking thus to hero Syrgak,"},{"id":"manas-2010:p1298:b001:l031","ordinal":56247,"en":"Kongurbay sought to deceive him:"},{"id":"manas-2010:p1298:b001:l032","ordinal":56248,"en":"“You are a lion, hero Syrgak!"},{"id":"manas-2010:p1298:b001:l033","ordinal":56249,"en":"May lions offer themselves for you!"},{"id":"manas-2010:p1298:b001:l034","ordinal":56250,"en":"You are a hero, hero Syrgak!"},{"id":"manas-2010:p1298:b001:l035","ordinal":56251,"en":"May heroes offer themselves for you!"},{"id":"manas-2010:p1298:b001:l036","ordinal":56252,"en":"Grappling on the road,"},{"id":"manas-2010:p1298:b001:l037","ordinal":56253,"en":"You made Algara rear and plunge."},{"id":"manas-2010:p1298:b001:l038","ordinal":56254,"en":"The Chinese people of forty khans,"},{"id":"manas-2010:p1298:b001:l039","ordinal":56255,"en":"You slaughtered without mercy;"},{"id":"manas-2010:p1298:b001:l040","ordinal":56256,"en":"You shattered my people and land."},{"id":"manas-2010:p1298:b001:l041","ordinal":56257,"en":"You split my ribs apart;"},{"id":"manas-2010:p1298:b001:l042","ordinal":56258,"en":"My multitude of people is ruined."},{"id":"manas-2010:p1299:b001:l001","ordinal":56259,"en":"You made a river of blood pour out;"},{"id":"manas-2010:p1299:b001:l002","ordinal":56260,"en":"Showing surpassing valor,"},{"id":"manas-2010:p1299:b001:l003","ordinal":56261,"en":"You have grievously shattered my heart."},{"id":"manas-2010:p1299:b001:l004","ordinal":56262,"en":"If I say a few words, will you agree?"},{"id":"manas-2010:p1299:b001:l005","ordinal":56263,"en":"Will you grant me seven days' respite?"},{"id":"manas-2010:p1299:b001:l006","ordinal":56264,"en":"Let me go farther from here;"},{"id":"manas-2010:p1299:b001:l007","ordinal":56265,"en":"Karykan, khan of Beijing—"},{"id":"manas-2010:p1299:b001:l008","ordinal":56266,"en":"Let me gather his marksmen."},{"id":"manas-2010:p1299:b001:l009","ordinal":56267,"en":"Then against you"},{"id":"manas-2010:p1299:b001:l010","ordinal":56268,"en":"I shall wage war without holding back."},{"id":"manas-2010:p1299:b001:l011","ordinal":56269,"en":"Go to your Manas;"},{"id":"manas-2010:p1299:b001:l012","ordinal":56270,"en":"Receive Manas's blessing!"},{"id":"manas-2010:p1299:b001:l013","ordinal":56271,"en":"Put on a shot-proof coat,"},{"id":"manas-2010:p1299:b001:l014","ordinal":56272,"en":"Mount another horse properly,"},{"id":"manas-2010:p1299:b001:l015","ordinal":56273,"en":"Then come again."},{"id":"manas-2010:p1299:b001:l016","ordinal":56274,"en":"Without bringing anyone else,"},{"id":"manas-2010:p1299:b001:l017","ordinal":56275,"en":"Let us fight one against one."},{"id":"manas-2010:p1299:b001:l018","ordinal":56276,"en":"If you thrust and defeat me,"},{"id":"manas-2010:p1299:b001:l019","ordinal":56277,"en":"I shall go and settle in Talas;"},{"id":"manas-2010:p1299:b001:l020","ordinal":56278,"en":"Obeying your spoken word,"},{"id":"manas-2010:p1299:b001:l021","ordinal":56279,"en":"I shall become a Muslim."},{"id":"manas-2010:p1299:b001:l022","ordinal":56280,"en":"Warrior Syrgak, young lad,"},{"id":"manas-2010:p1299:b001:l023","ordinal":56281,"en":"If I thrust and defeat you,"},{"id":"manas-2010:p1299:b001:l024","ordinal":56282,"en":"Go and settle in Beijing."},{"id":"manas-2010:p1299:b001:l025","ordinal":56283,"en":"Made with my own hands,"},{"id":"manas-2010:p1299:b001:l026","ordinal":56284,"en":"The idol I fashioned of bronze—"},{"id":"manas-2010:p1299:b001:l027","ordinal":56285,"en":"Say it is the true God"},{"id":"manas-2010:p1299:b001:l028","ordinal":56286,"en":"And enter my pure faith!”"},{"id":"manas-2010:p1299:b001:l029","ordinal":56287,"en":"When the Fierce One spoke like this,"},{"id":"manas-2010:p1299:b001:l030","ordinal":56288,"en":"“I grant you seven days' respite,” he said;"},{"id":"manas-2010:p1299:b001:l031","ordinal":56289,"en":"Your Syrgak grew carried away."},{"id":"manas-2010:p1299:b001:l032","ordinal":56290,"en":"Seeing the Fierce One as one of his own people,"},{"id":"manas-2010:p1299:b001:l033","ordinal":56291,"en":"Dear Syrgak relaxed."},{"id":"manas-2010:p1299:b001:l034","ordinal":56292,"en":"His eyes closed for a brief moment;"},{"id":"manas-2010:p1299:b001:l035","ordinal":56293,"en":"Dear Syrgak fell asleep."},{"id":"manas-2010:p1299:b001:l036","ordinal":56294,"en":"Once Syrgak had fallen asleep,"},{"id":"manas-2010:p1299:b001:l037","ordinal":56295,"en":"Cotton belt and broad boots—"},{"id":"manas-2010:p1299:b001:l038","ordinal":56296,"en":"Kongurbay, khan of the shaven-headed ones,"},{"id":"manas-2010:p1299:b001:l039","ordinal":56297,"en":"To sleeping Syrgak"},{"id":"manas-2010:p1299:b001:l040","ordinal":56298,"en":"Came up at that moment."},{"id":"manas-2010:p1299:b001:l041","ordinal":56299,"en":"The battle-axe with its golden handle,"},{"id":"manas-2010:p1299:b001:l042","ordinal":56300,"en":"He seized and swung,"},{"id":"manas-2010:p1300:b001:l001","ordinal":56301,"en":"Taking careful aim at Syrgak,"},{"id":"manas-2010:p1300:b001:l002","ordinal":56302,"en":"He struck his temple as he passed."},{"id":"manas-2010:p1300:b001:l003","ordinal":56303,"en":"When he struck with the battle-axe,"},{"id":"manas-2010:p1300:b001:l004","ordinal":56304,"en":"The horse wheeled and darted aside;"},{"id":"manas-2010:p1300:b001:l005","ordinal":56305,"en":"Kökchebich, a true swift steed,"},{"id":"manas-2010:p1300:b001:l006","ordinal":56306,"en":"Made the blow at Syrgak go astray,"},{"id":"manas-2010:p1300:b001:l007","ordinal":56307,"en":"Wheeling and flashing aside."},{"id":"manas-2010:p1300:b001:l008","ordinal":56308,"en":"The Fierce One who had come prepared"},{"id":"manas-2010:p1300:b001:l009","ordinal":56309,"en":"Had struck off his mark."},{"id":"manas-2010:p1300:b001:l010","ordinal":56310,"en":"Kökchebich beneath him,"},{"id":"manas-2010:p1300:b001:l011","ordinal":56311,"en":"Through armies beyond all counting,"},{"id":"manas-2010:p1300:b001:l012","ordinal":56312,"en":"Not letting Syrgak be captured,"},{"id":"manas-2010:p1300:b001:l013","ordinal":56313,"en":"Galloped through their midst."},{"id":"manas-2010:p1300:b001:l014","ordinal":56314,"en":"From hero Syrgak's temple"},{"id":"manas-2010:p1300:b001:l015","ordinal":56315,"en":"Dark crimson blood poured."},{"id":"manas-2010:p1300:b001:l016","ordinal":56316,"en":"Fainting and growing weak,"},{"id":"manas-2010:p1300:b001:l017","ordinal":56317,"en":"Hero Syrgak lost his strength."},{"id":"manas-2010:p1300:b001:l018","ordinal":56318,"en":"Hero Syrgak's Kökchebich,"},{"id":"manas-2010:p1300:b001:l019","ordinal":56319,"en":"Shattering the ground wherever he trod,"},{"id":"manas-2010:p1300:b001:l020","ordinal":56320,"en":"Clods as big as great cauldrons"}]
