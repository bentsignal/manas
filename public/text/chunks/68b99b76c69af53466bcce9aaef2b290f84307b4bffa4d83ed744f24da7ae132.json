[{"id":"semetey-1-2013:p0864:b004:l020","ordinal":143105,"en":"Flew off to the ground."},{"id":"semetey-1-2013:p0864:b004:l021","ordinal":143106,"en":"In a terrible hurry, Tazbaimat,"},{"id":"semetey-1-2013:p0864:b004:l022","ordinal":143107,"en":"Before he could take his shield in hand,"},{"id":"semetey-1-2013:p0864:b004:l023","ordinal":143108,"en":"Before he could save his life,"},{"id":"semetey-1-2013:p0864:b004:l024","ordinal":143109,"en":"Your ready uncle Sary,"},{"id":"semetey-1-2013:p0864:b004:l025","ordinal":143110,"en":"Drawing his cutting sword from its sheath,"},{"id":"semetey-1-2013:p0864:b004:l026","ordinal":143111,"en":"Arrived before an arrow could;"},{"id":"semetey-1-2013:p0864:b004:l027","ordinal":143112,"en":"Where he reached Baimat,"},{"id":"semetey-1-2013:p0864:b004:l028","ordinal":143113,"en":"He cut off his head as he passed."},{"id":"semetey-1-2013:p0864:b004:l029","ordinal":143114,"en":"Kokcho's son Umotoy"},{"id":"semetey-1-2013:p0864:b004:l030","ordinal":143115,"en":"Rushed upon his flank;"},{"id":"semetey-1-2013:p0864:b004:l031","ordinal":143116,"en":"Muzburchak's son Buyanbek"},{"id":"semetey-1-2013:p0864:b004:l032","ordinal":143117,"en":"Made ready on this side."},{"id":"semetey-1-2013:p0864:b004:l033","ordinal":143118,"en":"Khan Manas's forty companions,"},{"id":"semetey-1-2013:p0864:b004:l034","ordinal":143119,"en":"Drawing bows like falling rain,"},{"id":"semetey-1-2013:p0864:b004:l035","ordinal":143120,"en":"Firing shots like hail,"},{"id":"semetey-1-2013:p0864:b004:l036","ordinal":143121,"en":"Rushed at him from every side."},{"id":"semetey-1-2013:p0864:b004:l037","ordinal":143122,"en":"“Seize the bald man, seize him!”"},{"id":"semetey-1-2013:p0864:b004:l038","ordinal":143123,"en":"“Seize him and kill him!”"},{"id":"semetey-1-2013:p0864:b004:l039","ordinal":143124,"en":"Kyrgylchal came bellowing,"},{"id":"semetey-1-2013:p0865:b003:l001","ordinal":143125,"en":"Shouting “Kobosh!” as his battle cry."},{"id":"semetey-1-2013:p0865:b003:l002","ordinal":143126,"en":"(King Manas's name had faded;"},{"id":"semetey-1-2013:p0865:b003:l003","ordinal":143127,"en":"It had become “Giant Kobosh.”)"},{"id":"semetey-1-2013:p0865:b003:l004","ordinal":143128,"en":"Kyrgylchal, head of the forty,"},{"id":"semetey-1-2013:p0865:b003:l005","ordinal":143129,"en":"The mad old man who grew proud at forty,"},{"id":"semetey-1-2013:p0865:b003:l006","ordinal":143130,"en":"Who thought up a thousand misdeeds—"},{"id":"semetey-1-2013:p0865:b003:l007","ordinal":143131,"en":"Manas, that fleet steed,"},{"id":"semetey-1-2013:p0865:b003:l008","ordinal":143132,"en":"Had never said, “He has caused trouble.”"},{"id":"semetey-1-2013:p0865:b003:l009","ordinal":143133,"en":"What did dear Sary do?"},{"id":"semetey-1-2013:p0865:b003:l010","ordinal":143134,"en":"Toward Kyrgylchal,"},{"id":"semetey-1-2013:p0865:b003:l011","ordinal":143135,"en":"Without looking up or down,"},{"id":"semetey-1-2013:p0865:b003:l012","ordinal":143136,"en":"Without thinking he might die,"},{"id":"semetey-1-2013:p0865:b003:l013","ordinal":143137,"en":"The extraordinary hero Sary Khan,"},{"id":"semetey-1-2013:p0865:b003:l014","ordinal":143138,"en":"To Tuuchunak beneath him,"},{"id":"semetey-1-2013:p0865:b003:l015","ordinal":143139,"en":"Applied his whip left and right,"},{"id":"semetey-1-2013:p0865:b003:l016","ordinal":143140,"en":"Spurred him on both sides."},{"id":"semetey-1-2013:p0865:b003:l017","ordinal":143141,"en":"Sary Khan was skillful;"},{"id":"semetey-1-2013:p0865:b003:l018","ordinal":143142,"en":"Now he reached Kyrgylchal."},{"id":"semetey-1-2013:p0865:b003:l019","ordinal":143143,"en":"Stirring strife throughout the world,"},{"id":"semetey-1-2013:p0865:b003:l020","ordinal":143144,"en":"Was he not your uncle who divided it?"},{"id":"semetey-1-2013:p0865:b003:l021","ordinal":143145,"en":"Fighting every enemy,"},{"id":"semetey-1-2013:p0865:b003:l022","ordinal":143146,"en":"Was your uncle not accustomed to it!"},{"id":"semetey-1-2013:p0865:b003:l023","ordinal":143147,"en":"When he saw Kyrgylchal,"},{"id":"semetey-1-2013:p0865:b003:l024","ordinal":143148,"en":"Without looking around,"},{"id":"semetey-1-2013:p0865:b003:l025","ordinal":143149,"en":"Without sparing his life at all,"},{"id":"semetey-1-2013:p0865:b003:l026","ordinal":143150,"en":"Without looking from side to side,"},{"id":"semetey-1-2013:p0865:b003:l027","ordinal":143151,"en":"Without sparing his life a hair's breadth,"},{"id":"semetey-1-2013:p0865:b003:l028","ordinal":143152,"en":"Roaring in fury,"},{"id":"semetey-1-2013:p0865:b003:l029","ordinal":143153,"en":"Shouting “Manas!” as his battle cry,"},{"id":"semetey-1-2013:p0865:b003:l030","ordinal":143154,"en":"“The middle of the beard,” he said,"},{"id":"semetey-1-2013:p0865:b003:l031","ordinal":143155,"en":"“The edge of the gullet,” he said."},{"id":"semetey-1-2013:p0865:b003:l032","ordinal":143156,"en":"What did your accomplished uncle do?"},{"id":"semetey-1-2013:p0865:b003:l033","ordinal":143157,"en":"Kyrgyl, whom you saw,"},{"id":"semetey-1-2013:p0865:b003:l034","ordinal":143158,"en":"He reached and struck as he passed."},{"id":"semetey-1-2013:p0865:b003:l035","ordinal":143159,"en":"Without moving or wavering,"},{"id":"semetey-1-2013:p0865:b003:l036","ordinal":143160,"en":"Without shifting from the spot he fixed his gaze on,"},{"id":"semetey-1-2013:p0865:b003:l037","ordinal":143161,"en":"The point of the lance passed through,"},{"id":"semetey-1-2013:p0865:b003:l038","ordinal":143162,"en":"Reached the gullet;"},{"id":"semetey-1-2013:p0865:b003:l039","ordinal":143163,"en":"The first neck vertebra and the back of the skull"},{"id":"semetey-1-2013:p0865:b005:l001","ordinal":143164,"en":"It grazed as it passed."},{"id":"semetey-1-2013:p0865:b005:l002","ordinal":143165,"en":"What did your Kyrgylchal do?"},{"id":"semetey-1-2013:p0865:b005:l003","ordinal":143166,"en":"From Narkyzyl's back"},{"id":"semetey-1-2013:p0865:b005:l004","ordinal":143167,"en":"He fell with a rumble."},{"id":"semetey-1-2013:p0865:b005:l005","ordinal":143168,"en":"Two companions and one hero"},{"id":"semetey-1-2013:p0865:b005:l006","ordinal":143169,"en":"Had died at the khan's hands."},{"id":"semetey-1-2013:p0865:b005:l007","ordinal":143170,"en":"Making Tuuchunak rear,"},{"id":"semetey-1-2013:p0865:b005:l008","ordinal":143171,"en":"Dear hero Sary Khan"},{"id":"semetey-1-2013:p0865:b005:l009","ordinal":143172,"en":"Shattered whoever he encountered."},{"id":"semetey-1-2013:p0865:b005:l010","ordinal":143173,"en":"Moving back and forth,"},{"id":"semetey-1-2013:p0865:b005:l011","ordinal":143174,"en":"Sating themselves on blood without restraint,"},{"id":"semetey-1-2013:p0865:b005:l012","ordinal":143175,"en":"Drenched in dark blood,"},{"id":"semetey-1-2013:p0865:b005:l013","ordinal":143176,"en":"They fought without fleeing,"},{"id":"semetey-1-2013:p0865:b005:l014","ordinal":143177,"en":"Battled with their lances,"},{"id":"semetey-1-2013:p0865:b005:l015","ordinal":143178,"en":"Shouted their war cries,"},{"id":"semetey-1-2013:p0865:b005:l016","ordinal":143179,"en":"Drew bows and fired,"},{"id":"semetey-1-2013:p0865:b005:l017","ordinal":143180,"en":"Plunged from one fierce excitement into another,"},{"id":"semetey-1-2013:p0865:b005:l018","ordinal":143181,"en":"Like Chinese and Kyrgyz,"},{"id":"semetey-1-2013:p0865:b005:l019","ordinal":143182,"en":"They faced one another."},{"id":"semetey-1-2013:p0865:b005:l020","ordinal":143183,"en":"Suffering hardship,"},{"id":"semetey-1-2013:p0865:b005:l021","ordinal":143184,"en":"They fought fiercely face to face,"},{"id":"semetey-1-2013:p0865:b005:l022","ordinal":143185,"en":"Mounted stallions from the tethering line,"},{"id":"semetey-1-2013:p0865:b005:l023","ordinal":143186,"en":"Took up poles from the ground,"},{"id":"semetey-1-2013:p0865:b005:l024","ordinal":143187,"en":"Cried, “Oh, my patron!” and struck."},{"id":"semetey-1-2013:p0865:b005:l025","ordinal":143188,"en":"Now there was a terrible battle."},{"id":"semetey-1-2013:p0865:b005:l026","ordinal":143189,"en":"Bowshot rattled,"},{"id":"semetey-1-2013:p0865:b005:l027","ordinal":143190,"en":"Arrowheads whistled;"},{"id":"semetey-1-2013:p0865:b005:l028","ordinal":143191,"en":"And camped beyond seven ridges,"},{"id":"semetey-1-2013:p0865:b005:l029","ordinal":143192,"en":"They meant to devour your uncle."},{"id":"semetey-1-2013:p0865:b005:l030","ordinal":143193,"en":"Seven wolves and one sheep—"},{"id":"semetey-1-2013:p0865:b005:l031","ordinal":143194,"en":"When they attack, will they leave its carcass?"},{"id":"semetey-1-2013:p0865:b005:l032","ordinal":143195,"en":"One accomplished man—"},{"id":"semetey-1-2013:p0865:b005:l033","ordinal":143196,"en":"If they beat him, will they leave his body?"},{"id":"semetey-1-2013:p0865:b005:l034","ordinal":143197,"en":"Five thousand men led by Kobosh"},{"id":"semetey-1-2013:p0865:b005:l035","ordinal":143198,"en":"Rushed at his throat;"},{"id":"semetey-1-2013:p0865:b005:l036","ordinal":143199,"en":"Six thousand led by Abyke"},{"id":"semetey-1-2013:p0865:b005:l037","ordinal":143200,"en":"Made ready on one side;"},{"id":"semetey-1-2013:p0865:b005:l038","ordinal":143201,"en":"Argyn and Kyrgyz mingled together,"},{"id":"semetey-1-2013:p0865:b005:l039","ordinal":143202,"en":"All forty companions,"},{"id":"semetey-1-2013:p0866:b003:l001","ordinal":143203,"en":"Rushed upon Sary Khan."},{"id":"semetey-1-2013:p0866:b003:l002","ordinal":143204,"en":"“Seize the bald man, seize him!”"},{"id":"semetey-1-2013:p0866:b003:l003","ordinal":143205,"en":"“Seize him and kill him!”"},{"id":"semetey-1-2013:p0866:b003:l004","ordinal":143206,"en":"“Saddle his Tuuchunak!”"},{"id":"semetey-1-2013:p0866:b003:l005","ordinal":143207,"en":"“Gouge out his two eyes!”"},{"id":"semetey-1-2013:p0866:b003:l006","ordinal":143208,"en":"There were white banners,"},{"id":"semetey-1-2013:p0866:b003:l007","ordinal":143209,"en":"There was shouting tumult;"},{"id":"semetey-1-2013:p0866:b003:l008","ordinal":143210,"en":"Like tumbleweed flying,"},{"id":"semetey-1-2013:p0866:b003:l009","ordinal":143211,"en":"No one could tell who was who."},{"id":"semetey-1-2013:p0866:b003:l010","ordinal":143212,"en":"Now there was a mighty battle."},{"id":"semetey-1-2013:p0866:b003:l011","ordinal":143213,"en":"Of the companions left by Manas,"},{"id":"semetey-1-2013:p0866:b003:l012","ordinal":143214,"en":"Tazbaimat and old Kyrgyl had died;"},{"id":"semetey-1-2013:p0866:b003:l013","ordinal":143215,"en":"Of the khans they had summoned,"},{"id":"semetey-1-2013:p0866:b003:l014","ordinal":143216,"en":"Eloquent Urbu had died."},{"id":"semetey-1-2013:p0866:b003:l015","ordinal":143217,"en":"Because all three had died,"},{"id":"semetey-1-2013:p0866:b003:l016","ordinal":143218,"en":"Abyke charged in fiercely."},{"id":"semetey-1-2013:p0866:b003:l017","ordinal":143219,"en":"If you ask about Abyke,"},{"id":"semetey-1-2013:p0866:b003:l018","ordinal":143220,"en":"He was an outstanding marksman;"},{"id":"semetey-1-2013:p0866:b003:l019","ordinal":143221,"en":"If you ask about Kobosh,"},{"id":"semetey-1-2013:p0866:b003:l020","ordinal":143222,"en":"He was a thundering fellow."},{"id":"semetey-1-2013:p0866:b003:l021","ordinal":143223,"en":"Khan Manas's forty companions,"},{"id":"semetey-1-2013:p0866:b003:l022","ordinal":143224,"en":"Told to take a cap, cut off a head;"},{"id":"semetey-1-2013:p0866:b003:l023","ordinal":143225,"en":"Told to shed blood, spilled stomach contents;"},{"id":"semetey-1-2013:p0866:b003:l024","ordinal":143226,"en":"Told to drink water, drank poison."},{"id":"semetey-1-2013:p0866:b003:l025","ordinal":143227,"en":"Skilled among the lancers,"},{"id":"semetey-1-2013:p0866:b003:l026","ordinal":143228,"en":"Experts who knew the enemy's tactics,"},{"id":"semetey-1-2013:p0866:b003:l027","ordinal":143229,"en":"Shouting “Kobosh!” as their battle cry,"},{"id":"semetey-1-2013:p0866:b003:l028","ordinal":143230,"en":"The forty companions thrust their lances."},{"id":"semetey-1-2013:p0866:b003:l029","ordinal":143231,"en":"Tuuchunak and Sary Khan"},{"id":"semetey-1-2013:p0866:b003:l030","ordinal":143232,"en":"Were caught in their midst!"},{"id":"semetey-1-2013:p0866:b003:l031","ordinal":143233,"en":"Do not ask what Tuuchunak was like:"},{"id":"semetey-1-2013:p0866:b003:l032","ordinal":143234,"en":"His tail was sparse, his mane scant;"},{"id":"semetey-1-2013:p0866:b003:l033","ordinal":143235,"en":"He would not let an onager escape across the desert."},{"id":"semetey-1-2013:p0866:b003:l034","ordinal":143236,"en":"At the sight of such encircling enemies,"},{"id":"semetey-1-2013:p0866:b003:l035","ordinal":143237,"en":"He was immensely swift, intelligent and practiced."},{"id":"semetey-1-2013:p0866:b003:l036","ordinal":143238,"en":"When a lance was thrust, he did not flinch;"},{"id":"semetey-1-2013:p0866:b003:l037","ordinal":143239,"en":"He also had the steadiness of a working mount."},{"id":"semetey-1-2013:p0866:b003:l038","ordinal":143240,"en":"When his mouth was given freedom, he thundered away;"},{"id":"semetey-1-2013:p0866:b003:l039","ordinal":143241,"en":"He also had a racer's speed."},{"id":"semetey-1-2013:p0866:b004:l001","ordinal":143242,"en":"The wind could not catch his trot;"},{"id":"semetey-1-2013:p0866:b004:l002","ordinal":143243,"en":"The wind-spirit beast"},{"id":"semetey-1-2013:p0866:b004:l003","ordinal":143244,"en":"No beast could match his pace,"},{"id":"semetey-1-2013:p0866:b004:l004","ordinal":143245,"en":"An extraordinary racing creature."},{"id":"semetey-1-2013:p0866:b004:l005","ordinal":143246,"en":"Allah's sun clouded over in the sky;"},{"id":"semetey-1-2013:p0866:b004:l006","ordinal":143247,"en":"When the villains pressed around him,"},{"id":"semetey-1-2013:p0866:b004:l007","ordinal":143248,"en":"Sixty hardships descended on his head at once."},{"id":"semetey-1-2013:p0866:b004:l009","ordinal":143249,"en":"There was a pit already dug;"},{"id":"semetey-1-2013:p0866:b004:l010","ordinal":143250,"en":"All the villains stirred."},{"id":"semetey-1-2013:p0866:b004:l011","ordinal":143251,"en":"Great sorrow lay before him."},{"id":"semetey-1-2013:p0866:b004:l012","ordinal":143252,"en":"When he looked around,"},{"id":"semetey-1-2013:p0866:b004:l013","ordinal":143253,"en":"There was a net no bird could escape."},{"id":"semetey-1-2013:p0866:b004:l014","ordinal":143254,"en":"The sun was eclipsed and darkened;"},{"id":"semetey-1-2013:p0866:b004:l015","ordinal":143255,"en":"Upon your uncle Sary's head"},{"id":"semetey-1-2013:p0866:b004:l016","ordinal":143256,"en":"Sixty cares descended at once."},{"id":"semetey-1-2013:p0866:b004:l017","ordinal":143257,"en":"The villains had overwhelmed him;"},{"id":"semetey-1-2013:p0866:b004:l018","ordinal":143258,"en":"Upon your uncle Sary's head"},{"id":"semetey-1-2013:p0866:b004:l019","ordinal":143259,"en":"They had brought the end of the world."},{"id":"semetey-1-2013:p0866:b004:l020","ordinal":143260,"en":"“If I fall into these dogs' hands,"},{"id":"semetey-1-2013:p0866:b004:l021","ordinal":143261,"en":"Will I die a wretched death,"},{"id":"semetey-1-2013:p0866:b004:l022","ordinal":143262,"en":"Will I see Judgment Day?"},{"id":"semetey-1-2013:p0866:b004:l023","ordinal":143263,"en":"That plump, gray-mottled hen-goshawk,"},{"id":"semetey-1-2013:p0866:b004:l024","ordinal":143264,"en":"That gray hawk, that morning star—"},{"id":"semetey-1-2013:p0866:b004:l025","ordinal":143265,"en":"Will I see Semetey?"},{"id":"semetey-1-2013:p0866:b004:l026","ordinal":143266,"en":"Bakai, my refuge, is not here;"},{"id":"semetey-1-2013:p0866:b004:l027","ordinal":143267,"en":"The Argyn, my support, are not here."},{"id":"semetey-1-2013:p0866:b004:l028","ordinal":143268,"en":"Am I to die in disgrace?"},{"id":"semetey-1-2013:p0866:b004:l029","ordinal":143269,"en":"Saying I would be a messenger,"},{"id":"semetey-1-2013:p0866:b004:l030","ordinal":143270,"en":"I have come to be cut down."},{"id":"semetey-1-2013:p0866:b004:l031","ordinal":143271,"en":"Intending to come as a mediator,"},{"id":"semetey-1-2013:p0866:b004:l032","ordinal":143272,"en":"I have come to be taken."},{"id":"semetey-1-2013:p0866:b004:l033","ordinal":143273,"en":"If I keep fighting them,"},{"id":"semetey-1-2013:p0866:b004:l034","ordinal":143274,"en":"I shall die a wretched death."},{"id":"semetey-1-2013:p0866:b004:l035","ordinal":143275,"en":"Whimpering like a young puppy,"},{"id":"semetey-1-2013:p0866:b004:l036","ordinal":143276,"en":"I shall die with difficulty."},{"id":"semetey-1-2013:p0866:b004:l037","ordinal":143277,"en":"By setting myself against them,"},{"id":"semetey-1-2013:p0866:b004:l038","ordinal":143278,"en":"Why should I try to match them?"},{"id":"semetey-1-2013:p0866:b004:l039","ordinal":143279,"en":"My ocean, orphan Semetey—"},{"id":"semetey-1-2013:p0867:b003:l001","ordinal":143280,"en":"Let me flee more quickly,"},{"id":"semetey-1-2013:p0867:b003:l002","ordinal":143281,"en":"Let me die a more honorable death."},{"id":"semetey-1-2013:p0867:b003:l003","ordinal":143282,"en":"My noble uncle Bakai—"},{"id":"semetey-1-2013:p0867:b003:l004","ordinal":143283,"en":"Let me see his face."},{"id":"semetey-1-2013:p0867:b003:l005","ordinal":143284,"en":"Lamenting, let me tell my sorrow,"},{"id":"semetey-1-2013:p0867:b003:l006","ordinal":143285,"en":"And then let me die!”"},{"id":"semetey-1-2013:p0867:b003:l007","ordinal":143286,"en":"So saying, Sary Khan"},{"id":"semetey-1-2013:p0867:b003:l008","ordinal":143287,"en":"Took his dark-sided heavy whip,"},{"id":"semetey-1-2013:p0867:b003:l009","ordinal":143288,"en":"Whose blow could deafen the ears,"},{"id":"semetey-1-2013:p0867:b003:l010","ordinal":143289,"en":"Seized it and swung it,"},{"id":"semetey-1-2013:p0867:b003:l011","ordinal":143290,"en":"Made the courser cry out"},{"id":"semetey-1-2013:p0867:b003:l012","ordinal":143291,"en":"With a stroke across its flank."},{"id":"semetey-1-2013:p0867:b003:l013","ordinal":143292,"en":"White reins woven in a special braid,"},{"id":"semetey-1-2013:p0867:b003:l014","ordinal":143293,"en":"Reins fitted to Tuuchunak—"},{"id":"semetey-1-2013:p0867:b003:l015","ordinal":143294,"en":"Steadying him, he let the reins go."},{"id":"semetey-1-2013:p0867:b003:l016","ordinal":143295,"en":"The heroic khan's Tuuchunak"},{"id":"semetey-1-2013:p0867:b003:l017","ordinal":143296,"en":"Lowered his head to the ground,"},{"id":"semetey-1-2013:p0867:b003:l018","ordinal":143297,"en":"Took strides like a mountain sheep,"},{"id":"semetey-1-2013:p0867:b003:l019","ordinal":143298,"en":"Dust billowing behind him."},{"id":"semetey-1-2013:p0867:b003:l020","ordinal":143299,"en":"Clods from his four hooves"},{"id":"semetey-1-2013:p0867:b003:l021","ordinal":143300,"en":"Whistled a lance's length into the air;"},{"id":"semetey-1-2013:p0867:b003:l022","ordinal":143301,"en":"The ground he trod burst apart."},{"id":"semetey-1-2013:p0867:b003:l023","ordinal":143302,"en":"At first they saw him once,"},{"id":"semetey-1-2013:p0867:b003:l024","ordinal":143303,"en":"Then they saw him once again;"},{"id":"semetey-1-2013:p0867:b003:l025","ordinal":143304,"en":"After that, who saw him?"},{"id":"semetey-1-2013:p0867:b003:l026","ordinal":143305,"en":"Before they could utter a sound,"},{"id":"semetey-1-2013:p0867:b003:l027","ordinal":143306,"en":"Before an eye could open and close,"},{"id":"semetey-1-2013:p0867:b003:l028","ordinal":143307,"en":"A blue-mottled cloud gathered in the sky;"},{"id":"semetey-1-2013:p0867:b003:l029","ordinal":143308,"en":"Sary Khan, born a fierce wolf,"},{"id":"semetey-1-2013:p0867:b003:l030","ordinal":143309,"en":"Fled in plain sight and escaped."},{"id":"semetey-1-2013:p0867:b003:l031","ordinal":143310,"en":"To Chachykei's fortress,"},{"id":"semetey-1-2013:p0867:b003:l032","ordinal":143311,"en":"To Kanykei's royal camp,"},{"id":"semetey-1-2013:p0867:b003:l033","ordinal":143312,"en":"Below Tort-Kul,"},{"id":"semetey-1-2013:p0867:b003:l034","ordinal":143313,"en":"To the side of lord Bakai,"},{"id":"semetey-1-2013:p0867:b003:l035","ordinal":143314,"en":"When the dawn broke clear,"},{"id":"semetey-1-2013:p0867:b003:l036","ordinal":143315,"en":"When light fell upon the earth,"},{"id":"semetey-1-2013:p0867:b003:l037","ordinal":143316,"en":"Your uncle Sary reached Talas."},{"id":"semetey-1-2013:p0867:b003:l038","ordinal":143317,"en":"Tuuchunak beneath him"},{"id":"semetey-1-2013:p0867:b003:l039","ordinal":143318,"en":"Had grown hot in the flesh,"},{"id":"semetey-1-2013:p0867:b005:l001","ordinal":143319,"en":"Tossing wildly and struggling,"},{"id":"semetey-1-2013:p0867:b005:l002","ordinal":143320,"en":"Straining as though his man had died,"},{"id":"semetey-1-2013:p0867:b005:l003","ordinal":143321,"en":"Had lowered his head to the ground."},{"id":"semetey-1-2013:p0867:b005:l004","ordinal":143322,"en":"Sary Khan upon him"},{"id":"semetey-1-2013:p0867:b005:l005","ordinal":143323,"en":"Could not gather up the reins and check him;"},{"id":"semetey-1-2013:p0867:b005:l006","ordinal":143324,"en":"He was in great difficulty."},{"id":"semetey-1-2013:p0867:b005:l007","ordinal":143325,"en":"He was covered in swirling dust;"},{"id":"semetey-1-2013:p0867:b005:l008","ordinal":143326,"en":"His whole body, every part,"},{"id":"semetey-1-2013:p0867:b005:l009","ordinal":143327,"en":"Was dark, dusky blood."},{"id":"semetey-1-2013:p0867:b005:l010","ordinal":143328,"en":"If you looked at Sary Khan,"},{"id":"semetey-1-2013:p0867:b005:l011","ordinal":143329,"en":"His two flailing arms"},{"id":"semetey-1-2013:p0867:b005:l012","ordinal":143330,"en":"Could not rise; they were paralyzed."},{"id":"semetey-1-2013:p0867:b005:l013","ordinal":143331,"en":"His dear head, as large as a herdsman's tent—"},{"id":"semetey-1-2013:p0867:b005:l014","ordinal":143332,"en":"May this world be ruined!—"},{"id":"semetey-1-2013:p0867:b005:l015","ordinal":143333,"en":"Was dark, dusky blood."},{"id":"semetey-1-2013:p0867:b005:l016","ordinal":143334,"en":"Fierce-wolf Bakai asked him for news,"},{"id":"semetey-1-2013:p0867:b005:l017","ordinal":143335,"en":"Asked insistently about his suffering:"},{"id":"semetey-1-2013:p0867:b005:l018","ordinal":143336,"en":"“Oh, Sary Khan, my hero,"},{"id":"semetey-1-2013:p0867:b005:l019","ordinal":143337,"en":"What did you see?” he asked."},{"id":"semetey-1-2013:p0867:b005:l020","ordinal":143338,"en":"What he had seen and learned,"},{"id":"semetey-1-2013:p0867:b005:l021","ordinal":143339,"en":"Sary Khan began to tell:"},{"id":"semetey-1-2013:p0867:b005:l022","ordinal":143340,"en":"“Lion Bakai, hear my words."},{"id":"semetey-1-2013:p0867:b005:l023","ordinal":143341,"en":"The Argyn and the Kyrgyz—"},{"id":"semetey-1-2013:p0867:b005:l024","ordinal":143342,"en":"We had come to see them;"},{"id":"semetey-1-2013:p0867:b005:l025","ordinal":143343,"en":"Going as a mediator, I, Sary Khan,"},{"id":"semetey-1-2013:p0867:b005:l026","ordinal":143344,"en":"Had gone to my death."},{"id":"semetey-1-2013:p0867:b005:l027","ordinal":143345,"en":"I saw cliffs no goose could circle,"},{"id":"semetey-1-2013:p0867:b005:l028","ordinal":143346,"en":"I saw seething myriads of enemies."},{"id":"semetey-1-2013:p0867:b005:l029","ordinal":143347,"en":"I saw the land on reaching Urbus;"},{"id":"semetey-1-2013:p0867:b005:l030","ordinal":143348,"en":"I saw heroes Abyke and Kobosh."},{"id":"semetey-1-2013:p0867:b005:l031","ordinal":143349,"en":"An envious multitude"},{"id":"semetey-1-2013:p0867:b005:l032","ordinal":143350,"en":"Of people they had gathered;"},{"id":"semetey-1-2013:p0867:b005:l033","ordinal":143351,"en":"Those who would split lungs and take gall,"},{"id":"semetey-1-2013:p0867:b005:l034","ordinal":143352,"en":"Khans they had gathered."},{"id":"semetey-1-2013:p0867:b005:l035","ordinal":143353,"en":"There were trenches already dug,"},{"id":"semetey-1-2013:p0867:b005:l036","ordinal":143354,"en":"Their army stirred in tens of thousands."},{"id":"semetey-1-2013:p0867:b005:l037","ordinal":143355,"en":"Seven banners came,"},{"id":"semetey-1-2013:p0867:b005:l038","ordinal":143356,"en":"An army that bent the earth came."},{"id":"semetey-1-2013:p0867:b005:l039","ordinal":143357,"en":"If that army sweeps over us,"},{"id":"semetey-1-2013:p0868:b003:l001","ordinal":143358,"en":"Great peril will come upon our dear lives."},{"id":"semetey-1-2013:p0868:b003:l002","ordinal":143359,"en":"The two of us, khan uncle,"},{"id":"semetey-1-2013:p0868:b003:l003","ordinal":143360,"en":"They mean to seize if we fall into their hands,"}]
