[{"id":"semetey-1-2013:p0727:b004:l007","ordinal":132609,"en":"Valiant Chubak, your fierce one,"},{"id":"semetey-1-2013:p0727:b004:l008","ordinal":132610,"en":"Those who saw his bearing were afraid."},{"id":"semetey-1-2013:p0727:b004:l009","ordinal":132611,"en":"Five times in the city of Mecca,"},{"id":"semetey-1-2013:p0727:b004:l010","ordinal":132612,"en":"Valiant Chubak studied."},{"id":"semetey-1-2013:p0727:b004:l011","ordinal":132613,"en":"When he finished his studies,"},{"id":"semetey-1-2013:p0727:b004:l012","ordinal":132614,"en":"When Chubak reached twelve,"},{"id":"semetey-1-2013:p0727:b004:l013","ordinal":132615,"en":"He entered the caliph's presence and received a document,"},{"id":"semetey-1-2013:p0727:b004:l014","ordinal":132616,"en":"Received a blessing from the prince,"},{"id":"semetey-1-2013:p0727:b004:l015","ordinal":132617,"en":"Pledged himself to twelve spiritual guides,"},{"id":"semetey-1-2013:p0727:b004:l016","ordinal":132618,"en":"Was called a conquering lord."},{"id":"semetey-1-2013:p0727:b004:l017","ordinal":132619,"en":"When he finished his studies,"},{"id":"semetey-1-2013:p0727:b004:l018","ordinal":132620,"en":"When he reached twelve,"},{"id":"semetey-1-2013:p0727:b004:l019","ordinal":132621,"en":"To his father's home,"},{"id":"semetey-1-2013:p0727:b004:l020","ordinal":132622,"en":"Chubak returned."},{"id":"semetey-1-2013:p0727:b004:l021","ordinal":132623,"en":"Akbalta's countless horses—"},{"id":"semetey-1-2013:p0727:b004:l022","ordinal":132624,"en":"What could precious Chubak do?"},{"id":"semetey-1-2013:p0727:b004:l023","ordinal":132625,"en":"He gathered them from the hills."},{"id":"semetey-1-2013:p0727:b004:l024","ordinal":132626,"en":"“Father, among your horses,"},{"id":"semetey-1-2013:p0727:b004:l025","ordinal":132627,"en":"Is there a mount to ride in battle?"},{"id":"semetey-1-2013:p0727:b004:l026","ordinal":132628,"en":"Is there anyone who will not fight?"},{"id":"semetey-1-2013:p0727:b004:l027","ordinal":132629,"en":"Is there a mount to ride on a raid?"},{"id":"semetey-1-2013:p0727:b004:l028","ordinal":132630,"en":"Is there anyone who will not clash with us?"},{"id":"semetey-1-2013:p0727:b004:l029","ordinal":132631,"en":"On the lowland side are Russians;"},{"id":"semetey-1-2013:p0727:b004:l030","ordinal":132632,"en":"Beyond you are Chinese."},{"id":"semetey-1-2013:p0727:b004:l031","ordinal":132633,"en":"There are many enemies to destroy."},{"id":"semetey-1-2013:p0727:b004:l032","ordinal":132634,"en":"On the upper side are Barangs;"},{"id":"semetey-1-2013:p0727:b004:l033","ordinal":132635,"en":"There are many enemies to contend with.”"},{"id":"semetey-1-2013:p0727:b004:l034","ordinal":132636,"en":"So spoke warrior Chubak."},{"id":"semetey-1-2013:p0727:b004:l035","ordinal":132637,"en":"Akbaltai's horses,"},{"id":"semetey-1-2013:p0727:b004:l036","ordinal":132638,"en":"He gathered them all."},{"id":"semetey-1-2013:p0727:b004:l037","ordinal":132639,"en":"For eighty days, day and night,"},{"id":"semetey-1-2013:p0727:b004:l038","ordinal":132640,"en":"He had them led past in a long file."},{"id":"semetey-1-2013:p0727:b004:l039","ordinal":132641,"en":"He had the horse judges examine them,"},{"id":"semetey-1-2013:p0728:b003:l001","ordinal":132642,"en":"As your mighty Chubak stood there,"},{"id":"semetey-1-2013:p0728:b003:l002","ordinal":132643,"en":"Finding no horse to ride in battle,"},{"id":"semetey-1-2013:p0728:b003:l003","ordinal":132644,"en":"Finding no mount to ride in combat,"},{"id":"semetey-1-2013:p0728:b003:l004","ordinal":132645,"en":"Grieving and worn with distress,"},{"id":"semetey-1-2013:p0728:b003:l005","ordinal":132646,"en":"What could precious Chubak do?"},{"id":"semetey-1-2013:p0728:b003:l006","ordinal":132647,"en":"He took offense at Akbaltai."},{"id":"semetey-1-2013:p0728:b003:l007","ordinal":132648,"en":"“Father, my beloved khan father,"},{"id":"semetey-1-2013:p0728:b003:l008","ordinal":132649,"en":"More than the many Kyrgyz,"},{"id":"semetey-1-2013:p0728:b003:l009","ordinal":132650,"en":"You have tended your horses."},{"id":"semetey-1-2013:p0728:b003:l010","ordinal":132651,"en":"Yet there is not one horse to ride on patrol!"},{"id":"semetey-1-2013:p0728:b003:l011","ordinal":132652,"en":"These wretched horses,"},{"id":"semetey-1-2013:p0728:b003:l012","ordinal":132653,"en":"You have reared them in vain."},{"id":"semetey-1-2013:p0728:b003:l013","ordinal":132654,"en":"With pasterns a handbreadth long—"},{"id":"semetey-1-2013:p0728:b003:l014","ordinal":132655,"en":"Warrior father, hear my words!"},{"id":"semetey-1-2013:p0728:b003:l015","ordinal":132656,"en":"You have reared frogs!"},{"id":"semetey-1-2013:p0728:b003:l016","ordinal":132657,"en":"With heels a handbreadth long,"},{"id":"semetey-1-2013:p0728:b003:l017","ordinal":132658,"en":"Father, you have reared nags!"},{"id":"semetey-1-2013:p0728:b003:l018","ordinal":132659,"en":"Where are horses like these lacking?"},{"id":"semetey-1-2013:p0728:b003:l019","ordinal":132660,"en":"There is no use in these horses of yours.”"},{"id":"semetey-1-2013:p0728:b003:l020","ordinal":132661,"en":"Chubak spoke, working himself into a frenzy."},{"id":"semetey-1-2013:p0728:b003:l021","ordinal":132662,"en":"In the wilderness of Mediyan,"},{"id":"semetey-1-2013:p0728:b003:l022","ordinal":132663,"en":"He went wandering in agitation,"},{"id":"semetey-1-2013:p0728:b003:l023","ordinal":132664,"en":"Grieving and worn with distress,"},{"id":"semetey-1-2013:p0728:b003:l024","ordinal":132665,"en":"Offended at Khan Baltai."},{"id":"semetey-1-2013:p0728:b003:l025","ordinal":132666,"en":"There was no crow flying and cawing,"},{"id":"semetey-1-2013:p0728:b003:l026","ordinal":132667,"en":"No raven croaking,"},{"id":"semetey-1-2013:p0728:b003:l027","ordinal":132668,"en":"No blade of grass to nibble,"},{"id":"semetey-1-2013:p0728:b003:l028","ordinal":132669,"en":"No drop of water anywhere."},{"id":"semetey-1-2013:p0728:b003:l029","ordinal":132670,"en":"In the wilderness of Mediyan,"},{"id":"semetey-1-2013:p0728:b003:l030","ordinal":132671,"en":"No living shape was beside him."},{"id":"semetey-1-2013:p0728:b003:l031","ordinal":132672,"en":"There was no warrior like Chubak."},{"id":"semetey-1-2013:p0728:b003:l032","ordinal":132673,"en":"As he entered in his frenzy,"},{"id":"semetey-1-2013:p0728:b003:l033","ordinal":132674,"en":"At the edge of that wilderness,"},{"id":"semetey-1-2013:p0728:b003:l034","ordinal":132675,"en":"On its northern side,"},{"id":"semetey-1-2013:p0728:b003:l035","ordinal":132676,"en":"Racing with wild asses,"},{"id":"semetey-1-2013:p0728:b003:l036","ordinal":132677,"en":"Born of Jelkaiyp,"},{"id":"semetey-1-2013:p0728:b003:l037","ordinal":132678,"en":"High-backed, yet low in stature,"},{"id":"semetey-1-2013:p0728:b003:l038","ordinal":132679,"en":"Never faltering when sent over hills,"},{"id":"semetey-1-2013:p0728:b003:l039","ordinal":132680,"en":"Never tiring when ridden on raids,"},{"id":"semetey-1-2013:p0728:b004:l001","ordinal":132681,"en":"Never ailing when ridden with the baggage train,"},{"id":"semetey-1-2013:p0728:b004:l002","ordinal":132682,"en":"With a lovely forelock and scant mane,"},{"id":"semetey-1-2013:p0728:b004:l003","ordinal":132683,"en":"A true noble steed of peerless form,"},{"id":"semetey-1-2013:p0728:b004:l004","ordinal":132684,"en":"To Khan Baltai's Chubak"},{"id":"semetey-1-2013:p0728:b004:l005","ordinal":132685,"en":"It came while he raged."},{"id":"semetey-1-2013:p0728:b004:l006","ordinal":132686,"en":"To God's beloved servant,"},{"id":"semetey-1-2013:p0728:b004:l007","ordinal":132687,"en":"To poor Baltai's son,"},{"id":"semetey-1-2013:p0728:b004:l008","ordinal":132688,"en":"It came from an unknown place."},{"id":"semetey-1-2013:p0728:b004:l009","ordinal":132689,"en":"In his fifth year, Kökala"},{"id":"semetey-1-2013:p0728:b004:l010","ordinal":132690,"en":"Was found by that Chubak."},{"id":"semetey-1-2013:p0728:b004:l011","ordinal":132691,"en":"Akbaltai's Chubak"},{"id":"semetey-1-2013:p0728:b004:l012","ordinal":132692,"en":"Put on a bridle and rejoiced."},{"id":"semetey-1-2013:p0728:b004:l013","ordinal":132693,"en":"He examined Kökala."},{"id":"semetey-1-2013:p0728:b004:l014","ordinal":132694,"en":"“No overgrown frog within your hoof,"},{"id":"semetey-1-2013:p0728:b004:l015","ordinal":132695,"en":"My dear creature Kökala,"},{"id":"semetey-1-2013:p0728:b004:l016","ordinal":132696,"en":"You are a true noble steed!"},{"id":"semetey-1-2013:p0728:b004:l017","ordinal":132697,"en":"With no hair on their foreheads,"},{"id":"semetey-1-2013:p0728:b004:l018","ordinal":132698,"en":"You are indeed a noble steed!”"},{"id":"semetey-1-2013:p0728:b004:l019","ordinal":132699,"en":"Chubak put on a blue padded coat."},{"id":"semetey-1-2013:p0728:b004:l020","ordinal":132700,"en":"He mounted Kökala,"},{"id":"semetey-1-2013:p0728:b004:l021","ordinal":132701,"en":"Received Khan Baltai's blessing,"},{"id":"semetey-1-2013:p0728:b004:l022","ordinal":132702,"en":"And Chubak rode off to battle."},{"id":"semetey-1-2013:p0728:b004:l023","ordinal":132703,"en":"Finding no mountain to hurl himself against,"},{"id":"semetey-1-2013:p0728:b004:l024","ordinal":132704,"en":"Finding no enemy to fight,"},{"id":"semetey-1-2013:p0728:b004:l025","ordinal":132705,"en":"Thus Chubak trained himself."},{"id":"semetey-1-2013:p0728:b004:l026","ordinal":132706,"en":"When he reached twelve,"},{"id":"semetey-1-2013:p0728:b004:l027","ordinal":132707,"en":"He matured and became a warrior,"},{"id":"semetey-1-2013:p0728:b004:l028","ordinal":132708,"en":"The equal of grown warriors."},{"id":"semetey-1-2013:p0728:b004:l029","ordinal":132709,"en":"He besieged Kashgar and took it six times."},{"id":"semetey-1-2013:p0728:b004:l030","ordinal":132710,"en":"When Kashgar submitted,"},{"id":"semetey-1-2013:p0728:b004:l031","ordinal":132711,"en":"He ravaged Hindustan and took it four times."},{"id":"semetey-1-2013:p0728:b004:l032","ordinal":132712,"en":"He besieged Afghanistan and took it ten times."},{"id":"semetey-1-2013:p0728:b004:l033","ordinal":132713,"en":"That son of Akbaltai"},{"id":"semetey-1-2013:p0728:b004:l034","ordinal":132714,"en":"Raised strife wherever he played."},{"id":"semetey-1-2013:p0728:b004:l035","ordinal":132715,"en":"Causing great uproar,"},{"id":"semetey-1-2013:p0728:b004:l036","ordinal":132716,"en":"He was given the name Chubak."},{"id":"semetey-1-2013:p0728:b004:l037","ordinal":132717,"en":"Wrathful, a spiller of blood,"},{"id":"semetey-1-2013:p0728:b004:l038","ordinal":132718,"en":"He was given the name Chunak."},{"id":"semetey-1-2013:p0728:b004:l039","ordinal":132719,"en":"He advanced on Kökala."},{"id":"semetey-1-2013:p0729:b003:l001","ordinal":132720,"en":"He wielded blue-steel axe and sword;"},{"id":"semetey-1-2013:p0729:b003:l002","ordinal":132721,"en":"Those who challenged Chubak crawled away."},{"id":"semetey-1-2013:p0729:b003:l003","ordinal":132722,"en":"Akbaltai's Chubak,"},{"id":"semetey-1-2013:p0729:b003:l004","ordinal":132723,"en":"That wretch—your father's grave!—"},{"id":"semetey-1-2013:p0729:b003:l005","ordinal":132724,"en":"Besieged Andijan."},{"id":"semetey-1-2013:p0729:b003:l006","ordinal":132725,"en":"“Pay the tribute in full!” he said,"},{"id":"semetey-1-2013:p0729:b003:l007","ordinal":132726,"en":"And struck the people of Kokand."},{"id":"semetey-1-2013:p0729:b003:l008","ordinal":132727,"en":"Unable to endure his wrath,"},{"id":"semetey-1-2013:p0729:b003:l009","ordinal":132728,"en":"The city of Samarkand was worn down."},{"id":"semetey-1-2013:p0729:b003:l010","ordinal":132729,"en":"He turned Bukhara upside down,"},{"id":"semetey-1-2013:p0729:b003:l011","ordinal":132730,"en":"Wrought such mischief,"},{"id":"semetey-1-2013:p0729:b003:l012","ordinal":132731,"en":"And plundered its wealth."},{"id":"semetey-1-2013:p0729:b003:l013","ordinal":132732,"en":"Akbaltai's Chubak"},{"id":"semetey-1-2013:p0729:b003:l014","ordinal":132733,"en":"Was creating turmoil."},{"id":"semetey-1-2013:p0729:b003:l015","ordinal":132734,"en":"Unable to endure his turmoil,"},{"id":"semetey-1-2013:p0729:b003:l016","ordinal":132735,"en":"Then Kanykei, Temir Khan's daughter,"},{"id":"semetey-1-2013:p0729:b003:l017","ordinal":132736,"en":"That skilled woman,"},{"id":"semetey-1-2013:p0729:b003:l018","ordinal":132737,"en":"Had reached fourteen years"},{"id":"semetey-1-2013:p0729:b003:l019","ordinal":132738,"en":"And now came forth."},{"id":"semetey-1-2013:p0729:b003:l020","ordinal":132739,"en":"Her precious hair, like meadow grass,"},{"id":"semetey-1-2013:p0729:b003:l021","ordinal":132740,"en":"She bound tightly upon her crown."},{"id":"semetey-1-2013:p0729:b003:l022","ordinal":132741,"en":"She put on a shot-proof coat."},{"id":"semetey-1-2013:p0729:b003:l023","ordinal":132742,"en":"Her black, blaze-faced thoroughbred"},{"id":"semetey-1-2013:p0729:b003:l024","ordinal":132743,"en":"She covered, saddled and mounted."},{"id":"semetey-1-2013:p0729:b003:l025","ordinal":132744,"en":"On the great field of broad Bukhara,"},{"id":"semetey-1-2013:p0729:b003:l026","ordinal":132745,"en":"Coming proudly from a great ravine,"},{"id":"semetey-1-2013:p0729:b003:l027","ordinal":132746,"en":"They fought a spear duel."},{"id":"semetey-1-2013:p0729:b003:l028","ordinal":132747,"en":"Chubak and Kanykei,"},{"id":"semetey-1-2013:p0729:b003:l029","ordinal":132748,"en":"Against one another, those two"},{"id":"semetey-1-2013:p0729:b003:l030","ordinal":132749,"en":"Shouted and thrust their spears."},{"id":"semetey-1-2013:p0729:b003:l031","ordinal":132750,"en":"For six days, those two"},{"id":"semetey-1-2013:p0729:b003:l032","ordinal":132751,"en":"Could not overcome one another."},{"id":"semetey-1-2013:p0729:b003:l033","ordinal":132752,"en":"At broad Ak-Chiy of broad Bukhara,"},{"id":"semetey-1-2013:p0729:b003:l034","ordinal":132753,"en":"Shouting, they thrust their spears,"},{"id":"semetey-1-2013:p0729:b003:l035","ordinal":132754,"en":"Thrust in turn,"},{"id":"semetey-1-2013:p0729:b003:l036","ordinal":132755,"en":"Broke sixty spears,"},{"id":"semetey-1-2013:p0729:b003:l037","ordinal":132756,"en":"And fought their duel."},{"id":"semetey-1-2013:p0729:b003:l038","ordinal":132757,"en":"When six days had passed,"},{"id":"semetey-1-2013:p0729:b003:l039","ordinal":132758,"en":"Kanykei, the tale—"},{"id":"semetey-1-2013:p0729:b005:l001","ordinal":132759,"en":"Was about to tell it."},{"id":"semetey-1-2013:p0729:b005:l002","ordinal":132760,"en":"For one thrust, she made four,"},{"id":"semetey-1-2013:p0729:b005:l003","ordinal":132761,"en":"And was about to overcome him."},{"id":"semetey-1-2013:p0729:b005:l004","ordinal":132762,"en":"Warrior Chubak, who thought himself a hero,"},{"id":"semetey-1-2013:p0729:b005:l005","ordinal":132763,"en":"Was thrown into confusion."},{"id":"semetey-1-2013:p0729:b005:l006","ordinal":132764,"en":"Turning his mount, he urged it on,"},{"id":"semetey-1-2013:p0729:b005:l007","ordinal":132765,"en":"Dashing toward his father Akbaltai,"},{"id":"semetey-1-2013:p0729:b005:l008","ordinal":132766,"en":"His wits scattered."},{"id":"semetey-1-2013:p0729:b005:l009","ordinal":132767,"en":"Warrior Chubak, in headlong panic,"},{"id":"semetey-1-2013:p0729:b005:l010","ordinal":132768,"en":"Fled toward the Oigut."},{"id":"semetey-1-2013:p0729:b005:l011","ordinal":132769,"en":"Around the jutting mountain's spurs,"},{"id":"semetey-1-2013:p0729:b005:l012","ordinal":132770,"en":"Around its looming promontories,"},{"id":"semetey-1-2013:p0729:b005:l013","ordinal":132771,"en":"Kanykei pursued him."},{"id":"semetey-1-2013:p0729:b005:l014","ordinal":132772,"en":"When they began to climb,"},{"id":"semetey-1-2013:p0729:b005:l015","ordinal":132773,"en":"Warrior Chubak's Kökala"},{"id":"semetey-1-2013:p0729:b005:l016","ordinal":132774,"en":"Spread his mane and tail."},{"id":"semetey-1-2013:p0729:b005:l017","ordinal":132775,"en":"When they reached descending ground,"},{"id":"semetey-1-2013:p0729:b005:l018","ordinal":132776,"en":"Kanykei's black, blaze-faced thoroughbred"},{"id":"semetey-1-2013:p0729:b005:l019","ordinal":132777,"en":"Planted its forelegs like a roe deer."},{"id":"semetey-1-2013:p0729:b005:l020","ordinal":132778,"en":"The earth wheeled and blurred."},{"id":"semetey-1-2013:p0729:b005:l021","ordinal":132779,"en":"Kanykei's thoroughbred,"},{"id":"semetey-1-2013:p0729:b005:l022","ordinal":132780,"en":"Warrior Chubak's Kökala—"},{"id":"semetey-1-2013:p0729:b005:l023","ordinal":132781,"en":"She pressed close, about to catch him."},{"id":"semetey-1-2013:p0729:b005:l024","ordinal":132782,"en":"They became like bride and groom,"},{"id":"semetey-1-2013:p0729:b005:l025","ordinal":132783,"en":"Performing such a spectacle."},{"id":"semetey-1-2013:p0729:b005:l026","ordinal":132784,"en":"Then warrior Chubak's Kökala,"},{"id":"semetey-1-2013:p0729:b005:l027","ordinal":132785,"en":"Steam billowing beneath his forelegs,"},{"id":"semetey-1-2013:p0729:b005:l028","ordinal":132786,"en":"Smoke billowing from his nostrils,"},{"id":"semetey-1-2013:p0729:b005:l029","ordinal":132787,"en":"When he trod upon black stones,"},{"id":"semetey-1-2013:p0729:b005:l030","ordinal":132788,"en":"They crumbled like millet."},{"id":"semetey-1-2013:p0729:b005:l031","ordinal":132789,"en":"His hooves thundered on the ground."},{"id":"semetey-1-2013:p0729:b005:l032","ordinal":132790,"en":"The black-steel bit"},{"id":"semetey-1-2013:p0729:b005:l033","ordinal":132791,"en":"Clattered deep in his mouth."},{"id":"semetey-1-2013:p0729:b005:l034","ordinal":132792,"en":"Kökala beneath him"},{"id":"semetey-1-2013:p0729:b005:l035","ordinal":132793,"en":"Raced with flying birds."},{"id":"semetey-1-2013:p0729:b005:l036","ordinal":132794,"en":"When his body warmed,"},{"id":"semetey-1-2013:p0729:b005:l037","ordinal":132795,"en":"Warrior Chubak upon him"},{"id":"semetey-1-2013:p0729:b005:l038","ordinal":132796,"en":"Struggled to rein him in,"},{"id":"semetey-1-2013:p0729:b005:l039","ordinal":132797,"en":"Kökala, swift as an arrow,"},{"id":"semetey-1-2013:p0730:b003:l001","ordinal":132798,"en":"Flew billowing like a cloud."},{"id":"semetey-1-2013:p0730:b003:l002","ordinal":132799,"en":"Great clods as big as small tents"},{"id":"semetey-1-2013:p0730:b003:l003","ordinal":132800,"en":"Whistled above Chubak's head."},{"id":"semetey-1-2013:p0730:b003:l004","ordinal":132801,"en":"Beyond Andijan,"},{"id":"semetey-1-2013:p0730:b003:l005","ordinal":132802,"en":"Under the arm of Kokand's khan,"},{"id":"semetey-1-2013:p0730:b003:l006","ordinal":132803,"en":"Into the moon-yellow plain,"},{"id":"semetey-1-2013:p0730:b003:l007","ordinal":132804,"en":"When he drove his mount,"},{"id":"semetey-1-2013:p0730:b003:l008","ordinal":132805,"en":"Kanykei was about"},{"id":"semetey-1-2013:p0730:b003:l009","ordinal":132806,"en":"To perform a mighty deed."},{"id":"semetey-1-2013:p0730:b003:l010","ordinal":132807,"en":"Akbalta's Chubak,"},{"id":"semetey-1-2013:p0730:b003:l011","ordinal":132808,"en":"Pursuing him as far as the Oigut,"},{"id":"semetey-1-2013:p0730:b003:l012","ordinal":132809,"en":"She was about to overcome him."},{"id":"semetey-1-2013:p0730:b003:l013","ordinal":132810,"en":"Then Manas, blessed by Khizir, the precious lion,"},{"id":"semetey-1-2013:p0730:b003:l015","ordinal":132811,"en":"And mighty Bakai, those two,"},{"id":"semetey-1-2013:p0730:b003:l016","ordinal":132812,"en":"Chubak, who came fleeing,"},{"id":"semetey-1-2013:p0730:b003:l017","ordinal":132813,"en":"Caught him on the plain."},{"id":"semetey-1-2013:p0730:b003:l018","ordinal":132814,"en":"When Khan Manas caught Chubak,"},{"id":"semetey-1-2013:p0730:b003:l020","ordinal":132815,"en":"Kanykei, who had heard of him,"},{"id":"semetey-1-2013:p0730:b003:l021","ordinal":132816,"en":"Your wretch, his craving roused,"},{"id":"semetey-1-2013:p0730:b003:l022","ordinal":132817,"en":"Knowing that he had come to Manas,"},{"id":"semetey-1-2013:p0730:b003:l023","ordinal":132818,"en":"Turned back and darted away."},{"id":"semetey-1-2013:p0730:b003:l024","ordinal":132819,"en":"Wise, unfortunate Kanykei"},{"id":"semetey-1-2013:p0730:b003:l025","ordinal":132820,"en":"Darted toward Bukhara."},{"id":"semetey-1-2013:p0730:b003:l026","ordinal":132821,"en":"The blue, fearsome star was eclipsed in the sky."},{"id":"semetey-1-2013:p0730:b003:l027","ordinal":132822,"en":"Kanykei openly fled and escaped."},{"id":"semetey-1-2013:p0730:b003:l028","ordinal":132823,"en":"Bakai and warrior Manas"},{"id":"semetey-1-2013:p0730:b003:l029","ordinal":132824,"en":"Had caught Chubak."},{"id":"semetey-1-2013:p0730:b003:l030","ordinal":132825,"en":"They chewed white wheat flour,"},{"id":"semetey-1-2013:p0730:b003:l031","ordinal":132826,"en":"Held to the sacred profession of faith,"},{"id":"semetey-1-2013:p0730:b003:l032","ordinal":132827,"en":"Made an oath binding unto death,"},{"id":"semetey-1-2013:p0730:b003:l033","ordinal":132828,"en":"Confirmed their pledge."},{"id":"semetey-1-2013:p0730:b003:l034","ordinal":132829,"en":"They dismounted upon the plain,"},{"id":"semetey-1-2013:p0730:b003:l035","ordinal":132830,"en":"A flask of liquor between them,"},{"id":"semetey-1-2013:p0730:b003:l036","ordinal":132831,"en":"Swore an oath and drank."},{"id":"semetey-1-2013:p0730:b003:l037","ordinal":132832,"en":"He came and settled in Talas,"},{"id":"semetey-1-2013:p0730:b003:l038","ordinal":132833,"en":"Became Manas's companion."},{"id":"semetey-1-2013:p0730:b003:l039","ordinal":132834,"en":"Your sheep together in one fold,"},{"id":"semetey-1-2013:p0730:b004:l001","ordinal":132835,"en":"Your food shared in fellowship—"},{"id":"semetey-1-2013:p0730:b004:l002","ordinal":132836,"en":"Is my lion Chubak safe?!"},{"id":"semetey-1-2013:p0730:b004:l003","ordinal":132837,"en":"All forty companions,"},{"id":"semetey-1-2013:p0730:b004:l004","ordinal":132838,"en":"With old Kyrgyl at their head,"},{"id":"semetey-1-2013:p0730:b004:l005","ordinal":132839,"en":"Argin Khan's Ajybai,"},{"id":"semetey-1-2013:p0730:b004:l006","ordinal":132840,"en":"Warrior Shuutu, with a cap like a yurt covering,"},{"id":"semetey-1-2013:p0730:b004:l007","ordinal":132841,"en":"Yraman's singer son,"},{"id":"semetey-1-2013:p0730:b004:l008","ordinal":132842,"en":"Strong-armed Baichoro—"},{"id":"semetey-1-2013:p0730:b004:l009","ordinal":132843,"en":"Alas, is Bozuul safe?"},{"id":"semetey-1-2013:p0730:b004:l010","ordinal":132844,"en":"The ones to whom I turned fond thoughts,"},{"id":"semetey-1-2013:p0730:b004:l011","ordinal":132845,"en":"Whom I loved more than Manas,"},{"id":"semetey-1-2013:p0730:b004:l012","ordinal":132846,"en":"Warrior elder, hear my words!"},{"id":"semetey-1-2013:p0730:b004:l013","ordinal":132847,"en":"Are all forty champions safe?!"},{"id":"semetey-1-2013:p0730:b004:l014","ordinal":132848,"en":"So many days since I went,"},{"id":"semetey-1-2013:p0730:b004:l015","ordinal":132849,"en":"So many years since I left!"},{"id":"semetey-1-2013:p0730:b004:l016","ordinal":132850,"en":"Jarmanas, to whom you gave me,"},{"id":"semetey-1-2013:p0730:b004:l017","ordinal":132851,"en":"Was the giant of that wicked people."},{"id":"semetey-1-2013:p0730:b004:l018","ordinal":132852,"en":"Your younger sister Kardygach"},{"id":"semetey-1-2013:p0730:b004:l019","ordinal":132853,"en":"Became ruler of the multitude."},{"id":"semetey-1-2013:p0730:b004:l020","ordinal":132854,"en":"Gathering harriers, making them hawks,"},{"id":"semetey-1-2013:p0730:b004:l021","ordinal":132855,"en":"Gathering scattered folk, making them a people,"},{"id":"semetey-1-2013:p0730:b004:l022","ordinal":132856,"en":"Rearing fostered birds, making them hawks,"},{"id":"semetey-1-2013:p0730:b004:l023","ordinal":132857,"en":"Gathering wanderers, making them a people,"},{"id":"semetey-1-2013:p0730:b004:l024","ordinal":132858,"en":"Keeping a court, becoming a khan,"},{"id":"semetey-1-2013:p0730:b004:l025","ordinal":132859,"en":"Becoming like a saint,"},{"id":"semetey-1-2013:p0730:b004:l026","ordinal":132860,"en":"Gathering people from every place,"},{"id":"semetey-1-2013:p0730:b004:l027","ordinal":132861,"en":"While I was worn with toil,"},{"id":"semetey-1-2013:p0730:b004:l028","ordinal":132862,"en":"The giants Kökdöö and Akdöö appeared."},{"id":"semetey-1-2013:p0730:b004:l029","ordinal":132863,"en":"No horse could bear them; they came on foot."},{"id":"semetey-1-2013:p0730:b004:l030","ordinal":132864,"en":"Dust rose from their walking;"}]
