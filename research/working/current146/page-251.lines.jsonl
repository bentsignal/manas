{"id": "sayakbay-ms-current146:pdf251:l001", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 251, "folio": 632, "line_in_page": 1, "raw": "Барыш толкуп шыбырап,", "text": "Барыш толкуп шыбырап,", "en": "The leopard surged and whispered.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The opening noun is a provisional reading of difficult cursive.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf251:l002", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 251, "folio": 632, "line_in_page": 2, "raw": "Амандан булут бузулуп,", "text": "Амандан булут бузулуп,", "en": "Clouds broke apart in the clear sky.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf251:l003", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 251, "folio": 632, "line_in_page": 3, "raw": "Шамал айдап кубулган,", "text": "Шамал айдап кубулган,", "en": "Driven by the wind, they changed shape.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf251:l004", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 251, "folio": 632, "line_in_page": 4, "raw": "Күнү-түнү жел айдап,", "text": "Күнү-түнү жел айдап,", "en": "Day and night the wind drove on.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf251:l005", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 251, "folio": 632, "line_in_page": 5, "raw": "Тил байлантып, шор калкып,", "text": "Тил байлантып, шор калкып,", "en": "Tongues were bound as misery rose.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The middle idiom is provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf251:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 251, "folio": 632, "line_in_page": 6, "raw": "Эрендер тартып жашуусу,", "text": "Эрендер тартып жашуусу,", "en": "The heroes endured their span of life.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The final noun is difficult cursive and interpreted as lifespan.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf251:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 251, "folio": 632, "line_in_page": 7, "raw": "Малы экен, башы аман,", "text": "Малы экен, башы аман,", "en": "Their livestock remained, and their heads were safe.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf251:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 251, "folio": 632, "line_in_page": 8, "raw": "Тагаша Кудай түз буйруп,", "text": "Тагаша Кудай түз буйруп,", "en": "God ordained Tagasha’s course straight.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The proper name Tagasha is provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf251:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 251, "folio": 632, "line_in_page": 9, "raw": "Эки ара жайга жолукту,", "text": "Эки ара жайга жолукту,", "en": "Between the two they came upon a pasture.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf251:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 251, "folio": 632, "line_in_page": 10, "raw": "Көрсө, күтүп мал айдап,", "text": "Көрсө, күтүп мал айдап,", "en": "When he looked, they waited while driving the livestock.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Punctuation and subject relation are provisional.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf251:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 251, "folio": 632, "line_in_page": 11, "raw": "Оокат кылып, дан чайкап,", "text": "Оокат кылып, дан чайкап,", "en": "They made their living and winnowed grain.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf251:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 251, "folio": 632, "line_in_page": 12, "raw": "Жаткан жери мында ушул.", "text": "Жаткан жери мында ушул.", "en": "The place where they settled was here.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
