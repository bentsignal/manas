[{"id":"semetey-1-2013:p0473:b003:l002","ordinal":113153,"en":"If poisoned Manas drank it,"},{"id":"semetey-1-2013:p0473:b003:l003","ordinal":113154,"en":"His pain would subside,"},{"id":"semetey-1-2013:p0473:b003:l004","ordinal":113155,"en":"His eyes would open wide."},{"id":"semetey-1-2013:p0473:b003:l005","ordinal":113156,"en":"Rare indeed for anyone to find,"},{"id":"semetey-1-2013:p0473:b003:l006","ordinal":113157,"en":"That was the true healing medicine."},{"id":"semetey-1-2013:p0473:b003:l007","ordinal":113158,"en":"To the khan of Baghdad"},{"id":"semetey-1-2013:p0473:b003:l008","ordinal":113159,"en":"I sent poods of gold and precious metal."},{"id":"semetey-1-2013:p0473:b003:l009","ordinal":113160,"en":"Traveling by night, resting by day,"},{"id":"semetey-1-2013:p0473:b003:l010","ordinal":113161,"en":"In places heard of but never seen,"},{"id":"semetey-1-2013:p0473:b003:l011","ordinal":113162,"en":"I had the face of the earth searched."},{"id":"semetey-1-2013:p0473:b003:l012","ordinal":113163,"en":"Spending all my wealth,"},{"id":"semetey-1-2013:p0473:b003:l013","ordinal":113164,"en":"Sparing not my own life,"},{"id":"semetey-1-2013:p0473:b003:l014","ordinal":113165,"en":"I had it brought from broad Baghdad."},{"id":"semetey-1-2013:p0473:b003:l015","ordinal":113166,"en":"For your poisoned lion-hearted father,"},{"id":"semetey-1-2013:p0473:b003:l016","ordinal":113167,"en":"I stirred it in a mortar."},{"id":"semetey-1-2013:p0473:b003:l017","ordinal":113168,"en":"I saw how potent it was"},{"id":"semetey-1-2013:p0473:b003:l018","ordinal":113169,"en":"And measured it out by the spoonful."},{"id":"semetey-1-2013:p0473:b003:l019","ordinal":113170,"en":"Whenever your khan father drank it,"},{"id":"semetey-1-2013:p0473:b003:l020","ordinal":113171,"en":"His pain would subside,"},{"id":"semetey-1-2013:p0473:b003:l021","ordinal":113172,"en":"His eyes would open wide."},{"id":"semetey-1-2013:p0473:b003:l022","ordinal":113173,"en":"When your father retched, “Oh!”"},{"id":"semetey-1-2013:p0473:b003:l023","ordinal":113174,"en":"Gush after gush of poison came out,"},{"id":"semetey-1-2013:p0473:b003:l024","ordinal":113175,"en":"And your mother's strength ebbed away."},{"id":"semetey-1-2013:p0473:b003:l025","ordinal":113176,"en":"Whenever he drank the medicine,"},{"id":"semetey-1-2013:p0473:b003:l026","ordinal":113177,"en":"From your father's mouth"},{"id":"semetey-1-2013:p0473:b003:l027","ordinal":113178,"en":"Came handfuls upon handfuls of poison."},{"id":"semetey-1-2013:p0473:b003:l028","ordinal":113179,"en":"The poison's potency abated;"},{"id":"semetey-1-2013:p0473:b003:l029","ordinal":113180,"en":"Then your lion-hearted father's"},{"id":"semetey-1-2013:p0473:b003:l030","ordinal":113181,"en":"Eyes opened wide."},{"id":"semetey-1-2013:p0473:b003:l031","ordinal":113182,"en":"Stricken by that poisonous sickness,"},{"id":"semetey-1-2013:p0473:b003:l032","ordinal":113183,"en":"Your father Manas was a lion."},{"id":"semetey-1-2013:p0473:b003:l033","ordinal":113184,"en":"He barely recovered from death,"},{"id":"semetey-1-2013:p0473:b003:l034","ordinal":113185,"en":"Pierced in forty places."},{"id":"semetey-1-2013:p0473:b003:l035","ordinal":113186,"en":"Taking no rest by day,"},{"id":"semetey-1-2013:p0473:b003:l036","ordinal":113187,"en":"Thus I nursed your father."},{"id":"semetey-1-2013:p0473:b003:l037","ordinal":113188,"en":"Getting no sleep at night,"},{"id":"semetey-1-2013:p0473:b003:l038","ordinal":113189,"en":"Thus I nursed your father."},{"id":"semetey-1-2013:p0473:b003:l039","ordinal":113190,"en":"I, your ill-fated mother,"},{"id":"semetey-1-2013:p0473:b005:l001","ordinal":113191,"en":"Thinking it would heal the holes,"},{"id":"semetey-1-2013:p0473:b005:l002","ordinal":113192,"en":"All the poison within him,"},{"id":"semetey-1-2013:p0473:b005:l003","ordinal":113193,"en":"I thought it would draw outside."},{"id":"semetey-1-2013:p0473:b005:l004","ordinal":113194,"en":"Forty young unfoaled mares—"},{"id":"semetey-1-2013:p0473:b005:l005","ordinal":113195,"en":"I had them all slaughtered."},{"id":"semetey-1-2013:p0473:b005:l006","ordinal":113196,"en":"I had their belly fat cut out."},{"id":"semetey-1-2013:p0473:b005:l007","ordinal":113197,"en":"Thus I, your mother, sustained him."},{"id":"semetey-1-2013:p0473:b005:l008","ordinal":113198,"en":"Your lion-hearted father himself,"},{"id":"semetey-1-2013:p0473:b005:l009","ordinal":113199,"en":"Until sixty days had passed,"},{"id":"semetey-1-2013:p0473:b005:l010","ordinal":113200,"en":"I wrapped in horse fat day and night."},{"id":"semetey-1-2013:p0473:b005:l011","ordinal":113201,"en":"Thus I brought him back to his senses."},{"id":"semetey-1-2013:p0473:b005:l012","ordinal":113202,"en":"For the “Green-Black” medicine"},{"id":"semetey-1-2013:p0473:b005:l013","ordinal":113203,"en":"I caused many people to be killed."},{"id":"semetey-1-2013:p0473:b005:l014","ordinal":113204,"en":"If I speak, I have still more to tell."},{"id":"semetey-1-2013:p0473:b005:l015","ordinal":113205,"en":"Upon me, your wretched mother,"},{"id":"semetey-1-2013:p0473:b005:l016","ordinal":113206,"en":"For those I destroyed though innocent,"},{"id":"semetey-1-2013:p0473:b005:l017","ordinal":113207,"en":"Lies the blood of many believers."},{"id":"semetey-1-2013:p0473:b005:l018","ordinal":113208,"en":"I, your wretched mother,"},{"id":"semetey-1-2013:p0473:b005:l019","ordinal":113209,"en":"My valiant son, listen,"},{"id":"semetey-1-2013:p0473:b005:l020","ordinal":113210,"en":"Have an endless tale to tell."},{"id":"semetey-1-2013:p0473:b005:l021","ordinal":113211,"en":"On the coming Day of Resurrection,"},{"id":"semetey-1-2013:p0473:b005:l022","ordinal":113212,"en":"If what is said is true,"},{"id":"semetey-1-2013:p0473:b005:l023","ordinal":113213,"en":"This fierce mother of yours"},{"id":"semetey-1-2013:p0473:b005:l024","ordinal":113214,"en":"May well become a black donkey."},{"id":"semetey-1-2013:p0473:b005:l025","ordinal":113215,"en":"My only one, one day I too must die."},{"id":"semetey-1-2013:p0473:b005:l026","ordinal":113216,"en":"Upon Judgment Day's narrow path,"},{"id":"semetey-1-2013:p0473:b005:l027","ordinal":113217,"en":"If those believers demand their blood,"},{"id":"semetey-1-2013:p0473:b005:l028","ordinal":113218,"en":"What answer shall I give them?"},{"id":"semetey-1-2013:p0473:b005:l029","ordinal":113219,"en":"My precious son, listen"},{"id":"semetey-1-2013:p0473:b005:l030","ordinal":113220,"en":"To the blessing bestowed on you by a saint."},{"id":"semetey-1-2013:p0473:b005:l031","ordinal":113221,"en":"I, your unhappy mother,"},{"id":"semetey-1-2013:p0473:b005:l032","ordinal":113222,"en":"Bore your father's suffering."},{"id":"semetey-1-2013:p0473:b005:l033","ordinal":113223,"en":"Your father was a gray-maned khan."},{"id":"semetey-1-2013:p0473:b005:l034","ordinal":113224,"en":"When confronted, he acted:"},{"id":"semetey-1-2013:p0473:b005:l035","ordinal":113225,"en":"Such was his valor."},{"id":"semetey-1-2013:p0473:b005:l036","ordinal":113226,"en":"Your father Manas was a lion."},{"id":"semetey-1-2013:p0473:b005:l037","ordinal":113227,"en":"A soul like your father"},{"id":"semetey-1-2013:p0473:b005:l038","ordinal":113228,"en":"God will never create again."},{"id":"semetey-1-2013:p0473:b005:l039","ordinal":113229,"en":"The suffering of your father Manas—"},{"id":"semetey-1-2013:p0474:b003:l001","ordinal":113230,"en":"Almighty Allah ordained it;"},{"id":"semetey-1-2013:p0474:b003:l002","ordinal":113231,"en":"I was the one who bore that suffering."},{"id":"semetey-1-2013:p0474:b003:l003","ordinal":113232,"en":"They made me endure terrible hardship,"},{"id":"semetey-1-2013:p0474:b003:l004","ordinal":113233,"en":"Those Kalmyks to whom he had given a share."},{"id":"semetey-1-2013:p0474:b003:l005","ordinal":113234,"en":"I, your wretched, fierce mother,"},{"id":"semetey-1-2013:p0474:b003:l006","ordinal":113235,"en":"Had my breast torn open by a shot."},{"id":"semetey-1-2013:p0474:b003:l007","ordinal":113236,"en":"Your father Manas was a warrior."},{"id":"semetey-1-2013:p0474:b003:l008","ordinal":113237,"en":"Unbelievers who knew no faith"},{"id":"semetey-1-2013:p0474:b003:l009","ordinal":113238,"en":"He bound and taught the faith."},{"id":"semetey-1-2013:p0474:b003:l010","ordinal":113239,"en":"The obstinate who would not obey"},{"id":"semetey-1-2013:p0474:b003:l011","ordinal":113240,"en":"He drove before him and subdued."},{"id":"semetey-1-2013:p0474:b003:l012","ordinal":113241,"en":"He emptied the bullets from his pouch."},{"id":"semetey-1-2013:p0474:b003:l013","ordinal":113242,"en":"Wherever foes came out to shoot,"},{"id":"semetey-1-2013:p0474:b003:l014","ordinal":113243,"en":"Your father struck terror into all the world."},{"id":"semetey-1-2013:p0474:b003:l015","ordinal":113244,"en":"He dwelt in Great Talas."},{"id":"semetey-1-2013:p0474:b003:l016","ordinal":113245,"en":"When enemies came out to fight,"},{"id":"semetey-1-2013:p0474:b003:l017","ordinal":113246,"en":"He drove them before him."},{"id":"semetey-1-2013:p0474:b003:l018","ordinal":113247,"en":"Those who provoked his anger"},{"id":"semetey-1-2013:p0474:b003:l019","ordinal":113248,"en":"He crushed between his fangs."},{"id":"semetey-1-2013:p0474:b003:l020","ordinal":113249,"en":"The renowned Manas became khan."},{"id":"semetey-1-2013:p0474:b003:l021","ordinal":113250,"en":"His voice alone could kill."},{"id":"semetey-1-2013:p0474:b003:l022","ordinal":113251,"en":"He set the grassy land ablaze,"},{"id":"semetey-1-2013:p0474:b003:l023","ordinal":113252,"en":"Kindled the lands covered in dry grass."},{"id":"semetey-1-2013:p0474:b003:l024","ordinal":113253,"en":"He melted those he charged against;"},{"id":"semetey-1-2013:p0474:b003:l025","ordinal":113254,"en":"Where he set his gaze, he raised a tumult."},{"id":"semetey-1-2013:p0474:b003:l026","ordinal":113255,"en":"He chased white deer and made them cattle."},{"id":"semetey-1-2013:p0474:b003:l027","ordinal":113256,"en":"Thus he threw the world into confusion."},{"id":"semetey-1-2013:p0474:b003:l028","ordinal":113257,"en":"He reared gray deer and made them cattle."},{"id":"semetey-1-2013:p0474:b003:l029","ordinal":113258,"en":"Wherever he aimed, he threw it into confusion."},{"id":"semetey-1-2013:p0474:b003:l030","ordinal":113259,"en":"He grew hardened, drinking blood,"},{"id":"semetey-1-2013:p0474:b003:l031","ordinal":113260,"en":"Won the name of gray-maned leopard."},{"id":"semetey-1-2013:p0474:b003:l032","ordinal":113261,"en":"He wrecked strongholds and took booty,"},{"id":"semetey-1-2013:p0474:b003:l033","ordinal":113262,"en":"Raided Omsk and opened a road."},{"id":"semetey-1-2013:p0474:b003:l034","ordinal":113263,"en":"Such was your father Manas."},{"id":"semetey-1-2013:p0474:b003:l035","ordinal":113264,"en":"None upon whom he set his gaze escaped unhurt."},{"id":"semetey-1-2013:p0474:b003:l036","ordinal":113265,"en":"Your father Manas, the gray-maned warrior,"},{"id":"semetey-1-2013:p0474:b003:l037","ordinal":113266,"en":"Turned and bristled like a lion."},{"id":"semetey-1-2013:p0474:b003:l038","ordinal":113267,"en":"When he heard your father's fame,"},{"id":"semetey-1-2013:p0474:b003:l039","ordinal":113268,"en":"The khan of Beijing awoke."},{"id":"semetey-1-2013:p0474:b004:l001","ordinal":113269,"en":"Because your gray-maned father Manas"},{"id":"semetey-1-2013:p0474:b004:l002","ordinal":113270,"en":"Would not recover,"},{"id":"semetey-1-2013:p0474:b004:l003","ordinal":113271,"en":"I searched all manner of places"},{"id":"semetey-1-2013:p0474:b004:l004","ordinal":113272,"en":"And obtained a thousand kinds of medicine."},{"id":"semetey-1-2013:p0474:b004:l005","ordinal":113273,"en":"I cut out horse fat and wrapped him in it."},{"id":"semetey-1-2013:p0474:b004:l006","ordinal":113274,"en":"I eased his aching wounds."},{"id":"semetey-1-2013:p0474:b004:l007","ordinal":113275,"en":"Your ruin-bringing, gray-maned father's"},{"id":"semetey-1-2013:p0474:b004:l008","ordinal":113276,"en":"Eyes I made open wide."},{"id":"semetey-1-2013:p0474:b004:l009","ordinal":113277,"en":"I showed my resourcefulness."},{"id":"semetey-1-2013:p0474:b004:l010","ordinal":113278,"en":"After nursing him in hardship forty-one days,"},{"id":"semetey-1-2013:p0474:b004:l011","ordinal":113279,"en":"I got your father onto a horse."},{"id":"semetey-1-2013:p0474:b004:l012","ordinal":113280,"en":"Your khan father recovered."},{"id":"semetey-1-2013:p0474:b004:l013","ordinal":113281,"en":"I wrested your khan father back from death;"},{"id":"semetey-1-2013:p0474:b004:l014","ordinal":113282,"en":"After lying long, he barely recovered."},{"id":"semetey-1-2013:p0474:b004:l015","ordinal":113283,"en":"Let us leave that aside"},{"id":"semetey-1-2013:p0474:b004:l016","ordinal":113284,"en":"Kozkaman, who caused that suffering—"},{"id":"semetey-1-2013:p0474:b004:l017","ordinal":113285,"en":"Let us begin to tell of that villain."},{"id":"semetey-1-2013:p0474:b004:l018","ordinal":113286,"en":"Although he was an unbeliever,"},{"id":"semetey-1-2013:p0474:b004:l019","ordinal":113287,"en":"Let us not belittle that swine."},{"id":"semetey-1-2013:p0474:b004:l020","ordinal":113288,"en":"A slave skilled among spearmen,"},{"id":"semetey-1-2013:p0474:b004:l021","ordinal":113289,"en":"A capable slave who knew the enemy's stratagems,"},{"id":"semetey-1-2013:p0474:b004:l023","ordinal":113290,"en":"He too had been a khan guarding the Khagan."},{"id":"semetey-1-2013:p0474:b004:l024","ordinal":113291,"en":"No Chinese dared answer him back."},{"id":"semetey-1-2013:p0474:b004:l025","ordinal":113292,"en":"He too had been a khan who amassed treasure."},{"id":"semetey-1-2013:p0474:b004:l026","ordinal":113293,"en":"He rode Konkulboz in his revels,"},{"id":"semetey-1-2013:p0474:b004:l027","ordinal":113294,"en":"Spared no enemy he faced."},{"id":"semetey-1-2013:p0474:b004:l028","ordinal":113295,"en":"“Valiant Manas has died,"},{"id":"semetey-1-2013:p0474:b004:l029","ordinal":113296,"en":"He has seen Judgment Day,”"},{"id":"semetey-1-2013:p0474:b004:l030","ordinal":113297,"en":"That Kalmyk thought."},{"id":"semetey-1-2013:p0474:b004:l031","ordinal":113298,"en":"The treasure stores, countless riches—"},{"id":"semetey-1-2013:p0474:b004:l032","ordinal":113299,"en":"He plundered all the wealth."},{"id":"semetey-1-2013:p0474:b004:l033","ordinal":113300,"en":"He wrought thorough destruction,"},{"id":"semetey-1-2013:p0474:b004:l034","ordinal":113301,"en":"Overpowered everyone he encountered."},{"id":"semetey-1-2013:p0474:b004:l035","ordinal":113302,"en":"The vast treasure, the yellow gold,"},{"id":"semetey-1-2013:p0474:b004:l036","ordinal":113303,"en":"He loaded onto his mule."},{"id":"semetey-1-2013:p0474:b004:l037","ordinal":113304,"en":"Akayar, who had been fighting him,"},{"id":"semetey-1-2013:p0474:b004:l038","ordinal":113305,"en":"“Might carry word to the Kyrgyz,” he thought:"},{"id":"semetey-1-2013:p0474:b004:l039","ordinal":113306,"en":"He bound him instead of killing him."},{"id":"semetey-1-2013:p0475:b003:l001","ordinal":113307,"en":"A great dungeon, forty rope-lengths deep,"},{"id":"semetey-1-2013:p0475:b003:l002","ordinal":113308,"en":"He had dug in Great Talas"},{"id":"semetey-1-2013:p0475:b003:l003","ordinal":113309,"en":"And cast him into it alive."},{"id":"semetey-1-2013:p0475:b003:l004","ordinal":113310,"en":"The cunning men among the Kalmyks"},{"id":"semetey-1-2013:p0475:b003:l005","ordinal":113311,"en":"Thus took their revenge."},{"id":"semetey-1-2013:p0475:b003:l006","ordinal":113312,"en":"Any guard who emerged alive,"},{"id":"semetey-1-2013:p0475:b003:l007","ordinal":113313,"en":"Without letting anyone see,"},{"id":"semetey-1-2013:p0475:b003:l008","ordinal":113314,"en":"Without letting anyone know,"},{"id":"semetey-1-2013:p0475:b003:l009","ordinal":113315,"en":"They seized, slaughtered, and disposed of."},{"id":"semetey-1-2013:p0475:b003:l010","ordinal":113316,"en":"All the treasure"},{"id":"semetey-1-2013:p0475:b003:l011","ordinal":113317,"en":"They meant to carry off as booty,"},{"id":"semetey-1-2013:p0475:b003:l012","ordinal":113318,"en":"And all the Kyrgyz living there"},{"id":"semetey-1-2013:p0475:b003:l013","ordinal":113319,"en":"They meant utterly to destroy."},{"id":"semetey-1-2013:p0475:b003:l014","ordinal":113320,"en":"Rare gold and precious gems,"},{"id":"semetey-1-2013:p0475:b003:l015","ordinal":113321,"en":"The treasury of Khan Manas,"},{"id":"semetey-1-2013:p0475:b003:l016","ordinal":113322,"en":"He loaded onto his mule."},{"id":"semetey-1-2013:p0475:b003:l017","ordinal":113323,"en":"He crossed Kotormo,"},{"id":"semetey-1-2013:p0475:b003:l018","ordinal":113324,"en":"Traveled along Suusamyr,"},{"id":"semetey-1-2013:p0475:b003:l019","ordinal":113325,"en":"Skirted the misty mountain,"},{"id":"semetey-1-2013:p0475:b003:l020","ordinal":113326,"en":"Made his way through the foothills."},{"id":"semetey-1-2013:p0475:b003:l021","ordinal":113327,"en":"He traveled far, sparing no horse,"},{"id":"semetey-1-2013:p0475:b003:l022","ordinal":113328,"en":"Kept his guards watching closely,"},{"id":"semetey-1-2013:p0475:b003:l023","ordinal":113329,"en":"Had any sleeper beaten,"},{"id":"semetey-1-2013:p0475:b003:l024","ordinal":113330,"en":"And hurried on in haste."},{"id":"semetey-1-2013:p0475:b003:l025","ordinal":113331,"en":"“We have slaughtered their generous lord,” he said,"},{"id":"semetey-1-2013:p0475:b003:l026","ordinal":113332,"en":"Traveling by night, resting by day."},{"id":"semetey-1-2013:p0475:b003:l027","ordinal":113333,"en":"He traveled over the mountain heights,"},{"id":"semetey-1-2013:p0475:b003:l028","ordinal":113334,"en":"Went far, sparing no horse,"},{"id":"semetey-1-2013:p0475:b003:l029","ordinal":113335,"en":"Skirted the precipitous slopes,"},{"id":"semetey-1-2013:p0475:b003:l030","ordinal":113336,"en":"Follow the Black Hand,"},{"id":"semetey-1-2013:p0475:b003:l031","ordinal":113337,"en":"Descended Echki-Olbos,"},{"id":"semetey-1-2013:p0475:b003:l032","ordinal":113338,"en":"And made camp at Eki-Chat,"},{"id":"semetey-1-2013:p0475:b003:l033","ordinal":113339,"en":"Kozkaman, that day."},{"id":"semetey-1-2013:p0475:b003:l034","ordinal":113340,"en":"Konkulboz, a tulpar among horses,"},{"id":"semetey-1-2013:p0475:b003:l035","ordinal":113341,"en":"He unsaddled and left barebacked."},{"id":"semetey-1-2013:p0475:b003:l036","ordinal":113342,"en":"The twisted golden hobbles"},{"id":"semetey-1-2013:p0475:b003:l037","ordinal":113343,"en":"He brought and fastened above its hooves."},{"id":"semetey-1-2013:p0475:b003:l038","ordinal":113344,"en":"The Kalmyk pillowed his head on his saddle,"},{"id":"semetey-1-2013:p0475:b003:l039","ordinal":113345,"en":"Laying his head toward the sunrise,"},{"id":"semetey-1-2013:p0475:b005:l001","ordinal":113346,"en":"And fell into a warrior's deep sleep."},{"id":"semetey-1-2013:p0475:b005:l002","ordinal":113347,"en":"For many days and many nights"},{"id":"semetey-1-2013:p0475:b005:l003","ordinal":113348,"en":"He slept without tiring of it."},{"id":"semetey-1-2013:p0475:b005:l004","ordinal":113349,"en":"Among horses, a tulpar with a blazed head—"},{"id":"semetey-1-2013:p0475:b005:l005","ordinal":113350,"en":"Setting stakes and playing ordo,"},{"id":"semetey-1-2013:p0475:b005:l006","ordinal":113351,"en":"Amid the merry games,"},{"id":"semetey-1-2013:p0475:b005:l007","ordinal":113352,"en":"Together with Almambet and Chubak,"},{"id":"semetey-1-2013:p0475:b005:l008","ordinal":113353,"en":"Hearing rumors, whispered talk,"},{"id":"semetey-1-2013:p0475:b005:l009","ordinal":113354,"en":"How the Chinese deceived him and gave him poison,"},{"id":"semetey-1-2013:p0475:b005:l010","ordinal":113355,"en":"And hearing that Manas had died,"},{"id":"semetey-1-2013:p0475:b005:l011","ordinal":113356,"en":"Kyrgylchal, leader of the forty—"},{"id":"semetey-1-2013:p0475:b005:l012","ordinal":113357,"en":"That wild old man, swaggering among the forty,"},{"id":"semetey-1-2013:p0475:b005:l013","ordinal":113358,"en":"Always thinking up mischievous words—"},{"id":"semetey-1-2013:p0475:b005:l014","ordinal":113359,"en":"Even if he caused a thousand troubles,"},{"id":"semetey-1-2013:p0475:b005:l015","ordinal":113360,"en":"The leopard Manas, that noble lion,"},{"id":"semetey-1-2013:p0475:b005:l016","ordinal":113361,"en":"Never blamed him for the damage."},{"id":"semetey-1-2013:p0475:b005:l017","ordinal":113362,"en":"Ker-kuron was his winged mount."},{"id":"semetey-1-2013:p0475:b005:l018","ordinal":113363,"en":"Each of the forty companions"},{"id":"semetey-1-2013:p0475:b005:l019","ordinal":113364,"en":"Took his turn on guard:"},{"id":"semetey-1-2013:p0475:b005:l020","ordinal":113365,"en":"Such was their custom."},{"id":"semetey-1-2013:p0475:b005:l021","ordinal":113366,"en":"Along the broad Talas,"},{"id":"semetey-1-2013:p0475:b005:l022","ordinal":113367,"en":"Into the hollow of Zhylygynduu,"},{"id":"semetey-1-2013:p0475:b005:l023","ordinal":113368,"en":"To Kainar's dark spring-eye,"},{"id":"semetey-1-2013:p0475:b005:l024","ordinal":113369,"en":"To the very plane tree,"},{"id":"semetey-1-2013:p0475:b005:l025","ordinal":113370,"en":"Kyrgylchal came riding."},{"id":"semetey-1-2013:p0475:b005:l026","ordinal":113371,"en":"No crow cawed,"},{"id":"semetey-1-2013:p0475:b005:l027","ordinal":113372,"en":"No raven croaked."},{"id":"semetey-1-2013:p0475:b005:l028","ordinal":113373,"en":"Kanykei's white palace,"},{"id":"semetey-1-2013:p0475:b005:l029","ordinal":113374,"en":"Its doors of iron and solid tin—"},{"id":"semetey-1-2013:p0475:b005:l030","ordinal":113375,"en":"Though she was a woman, that ill-fated one"},{"id":"semetey-1-2013:p0475:b005:l031","ordinal":113376,"en":"Had possessed great splendor."},{"id":"semetey-1-2013:p0475:b005:l032","ordinal":113377,"en":"From Kanykei's palace"},{"id":"semetey-1-2013:p0475:b005:l033","ordinal":113378,"en":"They had pulled out the supporting pillar."},{"id":"semetey-1-2013:p0475:b005:l034","ordinal":113379,"en":"Sixty of the guards"},{"id":"semetey-1-2013:p0475:b005:l035","ordinal":113380,"en":"They had slaughtered as a sacrifice."},{"id":"semetey-1-2013:p0475:b005:l036","ordinal":113381,"en":"Wearing human noses and ears"},{"id":"semetey-1-2013:p0475:b005:l037","ordinal":113382,"en":"As amulets upon themselves,"},{"id":"semetey-1-2013:p0475:b005:l038","ordinal":113383,"en":"Subduing all who saw them,"},{"id":"semetey-1-2013:p0475:b005:l039","ordinal":113384,"en":"There had been seven demonic beings,"},{"id":"semetey-1-2013:p0476:b003:l001","ordinal":113385,"en":"Before her doorway;"},{"id":"semetey-1-2013:p0476:b003:l002","ordinal":113386,"en":"They had slaughtered them all."},{"id":"semetey-1-2013:p0476:b003:l003","ordinal":113387,"en":"They had plundered the wealth,"},{"id":"semetey-1-2013:p0476:b003:l004","ordinal":113388,"en":"Wrought thorough destruction,"},{"id":"semetey-1-2013:p0476:b003:l005","ordinal":113389,"en":"Broken into the treasury,"},{"id":"semetey-1-2013:p0476:b003:l006","ordinal":113390,"en":"Long since brought them to ruin."},{"id":"semetey-1-2013:p0476:b003:l007","ordinal":113391,"en":"The smiting God had struck them,"},{"id":"semetey-1-2013:p0476:b003:l008","ordinal":113392,"en":"Left them like an extinguished fire."},{"id":"semetey-1-2013:p0476:b003:l009","ordinal":113393,"en":"They had pulled out the pillar and toppled it,"},{"id":"semetey-1-2013:p0476:b003:l010","ordinal":113394,"en":"Cut down the plane tree and laid it low."},{"id":"semetey-1-2013:p0476:b003:l011","ordinal":113395,"en":"They had shown themselves true enemies."},{"id":"semetey-1-2013:p0476:b003:l012","ordinal":113396,"en":"All their dark eyes plunged into grief,"},{"id":"semetey-1-2013:p0476:b003:l013","ordinal":113397,"en":"Bereft of Khan Manas,"},{"id":"semetey-1-2013:p0476:b003:l014","ordinal":113398,"en":"They had long since met their ruin."},{"id":"semetey-1-2013:p0476:b003:l015","ordinal":113399,"en":"Breaking and wrecking the treasury,"},{"id":"semetey-1-2013:p0476:b003:l016","ordinal":113400,"en":"They had utterly sacked it."},{"id":"semetey-1-2013:p0476:b003:l017","ordinal":113401,"en":"Seeing this, Kyrgylchal"},{"id":"semetey-1-2013:p0476:b003:l018","ordinal":113402,"en":"Roared loud enough to split a rock,"},{"id":"semetey-1-2013:p0476:b003:l019","ordinal":113403,"en":"Cried loud enough to split a head,"},{"id":"semetey-1-2013:p0476:b003:l020","ordinal":113404,"en":"Tore out his mustache and flung it away,"},{"id":"semetey-1-2013:p0476:b003:l021","ordinal":113405,"en":"Plucked out his beard and flung it away:"},{"id":"semetey-1-2013:p0476:b003:l022","ordinal":113406,"en":"“Has the smiting God struck us,"},{"id":"semetey-1-2013:p0476:b003:l023","ordinal":113407,"en":"Crushed him from above?"},{"id":"semetey-1-2013:p0476:b003:l024","ordinal":113408,"en":"While he lay sleeping,"}]
