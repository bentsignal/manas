[{"id":"semetey-1-2013:p0332:b004:l005","ordinal":102145,"en":"He has been raising,” he said,"},{"id":"semetey-1-2013:p0332:b004:l006","ordinal":102146,"en":"Resenting his elder brother Temir Khan."},{"id":"semetey-1-2013:p0332:b004:l007","ordinal":102147,"en":"When he heard this news,"},{"id":"semetey-1-2013:p0332:b004:l008","ordinal":102148,"en":"The boy-sultan, that wretched servant,"},{"id":"semetey-1-2013:p0332:b004:l009","ordinal":102149,"en":"Semetey rose from his place,"},{"id":"semetey-1-2013:p0332:b004:l010","ordinal":102150,"en":"Pleading with the one God."},{"id":"semetey-1-2013:p0332:b004:l011","ordinal":102151,"en":"Hearing the words of Koloy Khan,"},{"id":"semetey-1-2013:p0332:b004:l012","ordinal":102152,"en":"Hearing, “His homeland is elsewhere.”"},{"id":"semetey-1-2013:p0332:b004:l013","ordinal":102153,"en":"“Baabedin!” he cried as he ran."},{"id":"semetey-1-2013:p0332:b004:l014","ordinal":102154,"en":"Manas Khan, gone to the other world,"},{"id":"semetey-1-2013:p0332:b004:l015","ordinal":102155,"en":"Was clearly known to be his father."},{"id":"semetey-1-2013:p0332:b004:l016","ordinal":102156,"en":"Hearing many words from the fool,"},{"id":"semetey-1-2013:p0332:b004:l018","ordinal":102157,"en":"Your destroyer gone to the other world,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0332:b004:l019","ordinal":102158,"en":"He heard that he was his father."},{"id":"semetey-1-2013:p0332:b004:l020","ordinal":102159,"en":"“Talas is truly his land,” he heard,"},{"id":"semetey-1-2013:p0332:b004:l021","ordinal":102160,"en":"“The Kyrgyz are truly his people,” he heard."},{"id":"semetey-1-2013:p0332:b004:l022","ordinal":102161,"en":"He rose from his place and ran,"},{"id":"semetey-1-2013:p0332:b004:l023","ordinal":102162,"en":"His heart leaping from its case."},{"id":"semetey-1-2013:p0332:b004:l024","ordinal":102163,"en":"Semetey's wish was granted,"},{"id":"semetey-1-2013:p0332:b004:l025","ordinal":102164,"en":"As though his mother Kanykey had borne a son."},{"id":"semetey-1-2013:p0332:b004:l026","ordinal":102165,"en":"Would the boy stay in Bukhara?"},{"id":"semetey-1-2013:p0332:b004:l027","ordinal":102166,"en":"Hearing the truth from Koloy,"},{"id":"semetey-1-2013:p0332:b004:l028","ordinal":102167,"en":"Now Semetey believed,"},{"id":"semetey-1-2013:p0332:b004:l029","ordinal":102168,"en":"Hearing that Manas was his father."},{"id":"semetey-1-2013:p0332:b004:l030","ordinal":102169,"en":"The gray pouch-belt left by Manas,"},{"id":"semetey-1-2013:p0332:b004:l031","ordinal":102170,"en":"He fitted closely around his neck."},{"id":"semetey-1-2013:p0332:b004:l032","ordinal":102171,"en":"“Sary Taz in the forest"},{"id":"semetey-1-2013:p0332:b004:l033","ordinal":102172,"en":"Had spoken the truth,” he said."},{"id":"semetey-1-2013:p0332:b004:l034","ordinal":102173,"en":"Pleading with his elder:"},{"id":"semetey-1-2013:p0332:b004:l035","ordinal":102174,"en":"“From an elder like you, Sary Taz,"},{"id":"semetey-1-2013:p0332:b004:l036","ordinal":102175,"en":"From my father gone to the other world,"},{"id":"semetey-1-2013:p0332:b004:l037","ordinal":102176,"en":"May I turn around them in devotion,"},{"id":"semetey-1-2013:p0332:b004:l038","ordinal":102177,"en":"From my blessing-giving elder Koshoy,"},{"id":"semetey-1-2013:p0332:b004:l039","ordinal":102178,"en":"From the old man who made it possible,"},{"id":"semetey-1-2013:p0333:b003:l001","ordinal":102179,"en":"May I devote myself to all!"},{"id":"semetey-1-2013:p0333:b003:l002","ordinal":102180,"en":"Before I knew, my wish was,"},{"id":"semetey-1-2013:p0333:b003:l003","ordinal":102181,"en":"‘If only I were Manas's son,’"},{"id":"semetey-1-2013:p0333:b003:l004","ordinal":102182,"en":"I kept praying to God."},{"id":"semetey-1-2013:p0333:b003:l005","ordinal":102183,"en":"Ismayyl in Bukhara,"},{"id":"semetey-1-2013:p0333:b003:l006","ordinal":102184,"en":"I called you father; you are my mother's brother."},{"id":"semetey-1-2013:p0333:b003:l007","ordinal":102185,"en":"Temir Khan, khan of Bukhara,"},{"id":"semetey-1-2013:p0333:b003:l008","ordinal":102186,"en":"I thought he was father; he is my mother's father."},{"id":"semetey-1-2013:p0333:b003:l009","ordinal":102187,"en":"Oh mighty power, Baabedin,"},{"id":"semetey-1-2013:p0333:b003:l010","ordinal":102188,"en":"Let me go to my mother Kanykey."},{"id":"semetey-1-2013:p0333:b003:l011","ordinal":102189,"en":"Finding a way with the old woman,"},{"id":"semetey-1-2013:p0333:b003:l012","ordinal":102190,"en":"Let me ask and learn the truth."},{"id":"semetey-1-2013:p0333:b003:l013","ordinal":102191,"en":"The noble Kyrgyz are our people."},{"id":"semetey-1-2013:p0333:b003:l014","ordinal":102192,"en":"After that, let me go."},{"id":"semetey-1-2013:p0333:b003:l015","ordinal":102193,"en":"If an enemy comes out to fight,"},{"id":"semetey-1-2013:p0333:b003:l016","ordinal":102194,"en":"Let me dwell in the midst of Keng-Kol."},{"id":"semetey-1-2013:p0333:b003:l017","ordinal":102195,"en":"Let me drive them before me."},{"id":"semetey-1-2013:p0333:b003:l018","ordinal":102196,"en":"If Temir Khan provokes my anger,"},{"id":"semetey-1-2013:p0333:b003:l019","ordinal":102197,"en":"Let me slay my grandfather too.”"},{"id":"semetey-1-2013:p0333:b003:l020","ordinal":102198,"en":"Speaking thus, Semetey,"},{"id":"semetey-1-2013:p0333:b003:l021","ordinal":102199,"en":"His wits flying, in great haste,"},{"id":"semetey-1-2013:p0333:b003:l022","ordinal":102200,"en":"The wild fellow born of Manas,"},{"id":"semetey-1-2013:p0333:b003:l023","ordinal":102201,"en":"Leaning on his battle-axe,"},{"id":"semetey-1-2013:p0333:b003:l024","ordinal":102202,"en":"Walking toward his mother Kanykey,"},{"id":"semetey-1-2013:p0333:b003:l025","ordinal":102203,"en":"From iron-gated Bukhara,"},{"id":"semetey-1-2013:p0333:b003:l026","ordinal":102204,"en":"He left the city."},{"id":"semetey-1-2013:p0333:b003:l027","ordinal":102205,"en":"To the famous gray hill's"},{"id":"semetey-1-2013:p0333:b003:l028","ordinal":102206,"en":"Open ground he came."},{"id":"semetey-1-2013:p0333:b003:l029","ordinal":102207,"en":"The people of Bukhara crowded round, bewildered,"},{"id":"semetey-1-2013:p0333:b003:l030","ordinal":102208,"en":"The multitude of walled Bukhara,"},{"id":"semetey-1-2013:p0333:b003:l031","ordinal":102209,"en":"“What will he do when he sees his mother?” they said,"},{"id":"semetey-1-2013:p0333:b003:l032","ordinal":102210,"en":"Astonished at Semetey."},{"id":"semetey-1-2013:p0333:b003:l033","ordinal":102211,"en":"Then Semetey,"},{"id":"semetey-1-2013:p0333:b003:l034","ordinal":102212,"en":"That son of the king,"},{"id":"semetey-1-2013:p0333:b003:l035","ordinal":102213,"en":"His neck held high like a rooster's,"},{"id":"semetey-1-2013:p0333:b003:l036","ordinal":102214,"en":"Towering like Opol-Too,"},{"id":"semetey-1-2013:p0333:b003:l037","ordinal":102215,"en":"Touched by Kydyr, stretching proudly,"},{"id":"semetey-1-2013:p0333:b003:l038","ordinal":102216,"en":"Appearing extraordinary to the eye,"},{"id":"semetey-1-2013:p0333:b003:l039","ordinal":102217,"en":"Girded with a silver belt,"},{"id":"semetey-1-2013:p0333:b004:l001","ordinal":102218,"en":"The prince's only son,"},{"id":"semetey-1-2013:p0333:b004:l002","ordinal":102219,"en":"His sunlike face touched by radiance,"},{"id":"semetey-1-2013:p0333:b004:l003","ordinal":102220,"en":"Girded with a golden belt,"},{"id":"semetey-1-2013:p0333:b004:l004","ordinal":102221,"en":"His moonlike face touched by radiance."},{"id":"semetey-1-2013:p0333:b004:l005","ordinal":102222,"en":"His early words becoming late,"},{"id":"semetey-1-2013:p0333:b004:l006","ordinal":102223,"en":"Longing to see his mother,"},{"id":"semetey-1-2013:p0333:b004:l007","ordinal":102224,"en":"His two eyes becoming four,"},{"id":"semetey-1-2013:p0333:b004:l008","ordinal":102225,"en":"Semetey walked along."},{"id":"semetey-1-2013:p0333:b004:l009","ordinal":102226,"en":"Let us leave the boy there for now."},{"id":"semetey-1-2013:p0333:b004:l010","ordinal":102227,"en":"The leopard mother Kanykey,"},{"id":"semetey-1-2013:p0333:b004:l011","ordinal":102228,"en":"Let us begin to tell of her."},{"id":"semetey-1-2013:p0333:b004:l012","ordinal":102229,"en":"Staying in Bukhara, she heard the news:"},{"id":"semetey-1-2013:p0333:b004:l013","ordinal":102230,"en":"“For twelve days Semetey,"},{"id":"semetey-1-2013:p0333:b004:l014","ordinal":102231,"en":"Eating food, tasting nothing,"},{"id":"semetey-1-2013:p0333:b004:l015","ordinal":102232,"en":"Lies ill,” she heard."},{"id":"semetey-1-2013:p0333:b004:l016","ordinal":102233,"en":"Her rib bones coming apart,"},{"id":"semetey-1-2013:p0333:b004:l017","ordinal":102234,"en":"Tears pouring from her eyes,"},{"id":"semetey-1-2013:p0333:b004:l018","ordinal":102235,"en":"Unable to stay still, wailing and sobbing,"},{"id":"semetey-1-2013:p0333:b004:l019","ordinal":102236,"en":"Unable to restrain her tears,"},{"id":"semetey-1-2013:p0333:b004:l020","ordinal":102237,"en":"Her poor heart torn apart,"},{"id":"semetey-1-2013:p0333:b004:l021","ordinal":102238,"en":"When she heard news of her only son,"},{"id":"semetey-1-2013:p0333:b004:l022","ordinal":102239,"en":"Helpless, sobbing,"},{"id":"semetey-1-2013:p0333:b004:l023","ordinal":102240,"en":"To God whose decree is mighty,"},{"id":"semetey-1-2013:p0333:b004:l024","ordinal":102241,"en":"She prayed and cried aloud."},{"id":"semetey-1-2013:p0333:b004:l025","ordinal":102242,"en":"To reach Semetey,"},{"id":"semetey-1-2013:p0333:b004:l026","ordinal":102243,"en":"For the orphan granted in her last extremity,"},{"id":"semetey-1-2013:p0333:b004:l027","ordinal":102244,"en":"To offer herself as a sacrifice,"},{"id":"semetey-1-2013:p0333:b004:l028","ordinal":102245,"en":"Despairing of all the world,"},{"id":"semetey-1-2013:p0333:b004:l029","ordinal":102246,"en":"Your royal mother Kanykey"},{"id":"semetey-1-2013:p0333:b004:l030","ordinal":102247,"en":"Ran in great haste."},{"id":"semetey-1-2013:p0333:b004:l031","ordinal":102248,"en":"To see Semetey,"},{"id":"semetey-1-2013:p0333:b004:l032","ordinal":102249,"en":"If his illness was real,"},{"id":"semetey-1-2013:p0333:b004:l033","ordinal":102250,"en":"To die before her destined death."},{"id":"semetey-1-2013:p0333:b004:l034","ordinal":102251,"en":"To run and reach Semetey,"},{"id":"semetey-1-2013:p0333:b004:l035","ordinal":102252,"en":"Her two eyes becoming four,"},{"id":"semetey-1-2013:p0333:b004:l036","ordinal":102253,"en":"For the orphan left by her companion,"},{"id":"semetey-1-2013:p0333:b004:l037","ordinal":102254,"en":"If his illness was true,"},{"id":"semetey-1-2013:p0333:b004:l038","ordinal":102255,"en":"To offer herself as a sacrifice,"},{"id":"semetey-1-2013:p0333:b004:l039","ordinal":102256,"en":"For six calves and four yearling horses,"},{"id":"semetey-1-2013:p0334:b003:l001","ordinal":102257,"en":"The bright knife she had bought,"},{"id":"semetey-1-2013:p0334:b003:l002","ordinal":102258,"en":"To draw it from its sheath,"},{"id":"semetey-1-2013:p0334:b003:l003","ordinal":102259,"en":"To offer this damned life"},{"id":"semetey-1-2013:p0334:b003:l004","ordinal":102260,"en":"As a sacrifice."},{"id":"semetey-1-2013:p0334:b003:l005","ordinal":102261,"en":"Running breathlessly over the pass,"},{"id":"semetey-1-2013:p0334:b003:l006","ordinal":102262,"en":"Hurrying along on foot,"},{"id":"semetey-1-2013:p0334:b003:l007","ordinal":102263,"en":"The one God had granted"},{"id":"semetey-1-2013:p0334:b003:l008","ordinal":102264,"en":"What she had asked for."},{"id":"semetey-1-2013:p0334:b003:l010","ordinal":102265,"en":"Pale and bewildered,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0334:b003:l011","ordinal":102266,"en":"The hilt slipping from her hand,"},{"id":"semetey-1-2013:p0334:b003:l012","ordinal":102267,"en":"The covering slipping from her heart,"},{"id":"semetey-1-2013:p0334:b003:l013","ordinal":102268,"en":"The red blood draining from her face,"},{"id":"semetey-1-2013:p0334:b003:l014","ordinal":102269,"en":"Her senses fled, her strength was gone."},{"id":"semetey-1-2013:p0334:b003:l015","ordinal":102270,"en":"Your dear mother Kanykey"},{"id":"semetey-1-2013:p0334:b003:l016","ordinal":102271,"en":"Had come directly before"},{"id":"semetey-1-2013:p0334:b003:l017","ordinal":102272,"en":"Her own child."},{"id":"semetey-1-2013:p0334:b003:l018","ordinal":102273,"en":"When he saw his mother,"},{"id":"semetey-1-2013:p0334:b003:l019","ordinal":102274,"en":"The orphan could not restrain his excitement,"},{"id":"semetey-1-2013:p0334:b003:l020","ordinal":102275,"en":"There he beheld his mother."},{"id":"semetey-1-2013:p0334:b003:l021","ordinal":102276,"en":"Before him was his refuge;"},{"id":"semetey-1-2013:p0334:b003:l022","ordinal":102277,"en":"He beheld her brow."},{"id":"semetey-1-2013:p0334:b003:l023","ordinal":102278,"en":"The one he would approach in worship,"},{"id":"semetey-1-2013:p0334:b003:l024","ordinal":102279,"en":"His beloved object of devotion, he beheld."},{"id":"semetey-1-2013:p0334:b003:l025","ordinal":102280,"en":"The one God had truly"},{"id":"semetey-1-2013:p0334:b003:l026","ordinal":102281,"en":"Granted what he had asked."},{"id":"semetey-1-2013:p0334:b003:l027","ordinal":102282,"en":"Plainly recognizing his mother,"},{"id":"semetey-1-2013:p0334:b003:l028","ordinal":102283,"en":"The heroic orphan Manas left behind"},{"id":"semetey-1-2013:p0334:b003:l029","ordinal":102284,"en":"Had truly seen her!"},{"id":"semetey-1-2013:p0334:b003:l030","ordinal":102285,"en":"He stretched out his hand and spoke:"},{"id":"semetey-1-2013:p0334:b003:l031","ordinal":102286,"en":"“My shelter, my mother,” he said."},{"id":"semetey-1-2013:p0334:b003:l032","ordinal":102287,"en":"“The dark ridge stretching before me—"},{"id":"semetey-1-2013:p0334:b003:l033","ordinal":102288,"en":"You are my net to catch the wild game,"},{"id":"semetey-1-2013:p0334:b003:l034","ordinal":102289,"en":"My mother who has sheltered me—"},{"id":"semetey-1-2013:p0334:b003:l035","ordinal":102290,"en":"I thought you my sister, but you are my mother!"},{"id":"semetey-1-2013:p0334:b003:l036","ordinal":102291,"en":"You are my Night of Power when I wish,"},{"id":"semetey-1-2013:p0334:b003:l037","ordinal":102292,"en":"You are my one and only before me."},{"id":"semetey-1-2013:p0334:b003:l038","ordinal":102293,"en":"When my ocean-like father died,"},{"id":"semetey-1-2013:p0334:b003:l039","ordinal":102294,"en":"My countless treasures and riches"},{"id":"semetey-1-2013:p0334:b004:l001","ordinal":102295,"en":"You came away scattering."},{"id":"semetey-1-2013:p0334:b004:l002","ordinal":102296,"en":"Wandering to your birth family, Mother,"},{"id":"semetey-1-2013:p0334:b004:l003","ordinal":102297,"en":"You came away in flight."},{"id":"semetey-1-2013:p0334:b004:l004","ordinal":102298,"en":"With all reason gone from your heart,"},{"id":"semetey-1-2013:p0334:b004:l005","ordinal":102299,"en":"You came away in haste."},{"id":"semetey-1-2013:p0334:b004:l006","ordinal":102300,"en":"Is there cause for a khan's"},{"id":"semetey-1-2013:p0334:b004:l007","ordinal":102301,"en":"Only child to go in flight?"},{"id":"semetey-1-2013:p0334:b004:l008","ordinal":102302,"en":"Alas, Mother, where are our people?"},{"id":"semetey-1-2013:p0334:b004:l009","ordinal":102303,"en":"Is there cause for a lord's"},{"id":"semetey-1-2013:p0334:b004:l010","ordinal":102304,"en":"Only child to wander abroad?"},{"id":"semetey-1-2013:p0334:b004:l011","ordinal":102305,"en":"My valiant mother, where are our people?"},{"id":"semetey-1-2013:p0334:b004:l012","ordinal":102306,"en":"When will we reach our people?"},{"id":"semetey-1-2013:p0334:b004:l013","ordinal":102307,"en":"Wandering to Bukhara for support,"},{"id":"semetey-1-2013:p0334:b004:l014","ordinal":102308,"en":"You came and lodged with Khan Temir;"},{"id":"semetey-1-2013:p0334:b004:l015","ordinal":102309,"en":"You came and settled with your birth family."},{"id":"semetey-1-2013:p0334:b004:l016","ordinal":102310,"en":"You made them call me Manas's wandering son,"},{"id":"semetey-1-2013:p0334:b004:l017","ordinal":102311,"en":"You gave me a bad name."},{"id":"semetey-1-2013:p0334:b004:l018","ordinal":102312,"en":"Is there cause to wander"},{"id":"semetey-1-2013:p0334:b004:l019","ordinal":102313,"en":"In Khan Temir's city?"},{"id":"semetey-1-2013:p0334:b004:l020","ordinal":102314,"en":"My ocean-like mother, where are our people?"},{"id":"semetey-1-2013:p0334:b004:l021","ordinal":102315,"en":"Is there cause to flee and lodge"},{"id":"semetey-1-2013:p0334:b004:l022","ordinal":102316,"en":"In Khan Ismayyl's city?"},{"id":"semetey-1-2013:p0334:b004:l023","ordinal":102317,"en":"Where are the honored Kyrgyz people?"},{"id":"semetey-1-2013:p0334:b004:l024","ordinal":102318,"en":"Alas, my mother Kanykey,"},{"id":"semetey-1-2013:p0334:b004:l025","ordinal":102319,"en":"When will we reach our people?"},{"id":"semetey-1-2013:p0334:b004:l026","ordinal":102320,"en":"Akolpok, left by my father,"},{"id":"semetey-1-2013:p0334:b004:l027","ordinal":102321,"en":"The costly coat with its golden collar,"},{"id":"semetey-1-2013:p0334:b004:l028","ordinal":102322,"en":"Mother, you came without wearing it."},{"id":"semetey-1-2013:p0334:b004:l029","ordinal":102323,"en":"Such is your womanly folly:"},{"id":"semetey-1-2013:p0334:b004:l030","ordinal":102324,"en":"Fleeing and wandering to Bukhara,"},{"id":"semetey-1-2013:p0334:b004:l031","ordinal":102325,"en":"You came without understanding."},{"id":"semetey-1-2013:p0334:b004:l032","ordinal":102326,"en":"My father's own brother,"},{"id":"semetey-1-2013:p0334:b004:l033","ordinal":102327,"en":"My uncle Abyke,"},{"id":"semetey-1-2013:p0334:b004:l034","ordinal":102328,"en":"You came without marrying him."},{"id":"semetey-1-2013:p0334:b004:l035","ordinal":102329,"en":"You came and settled in Bukhara;"},{"id":"semetey-1-2013:p0334:b004:l036","ordinal":102330,"en":"‘This orphan came here wandering,’ they say—"},{"id":"semetey-1-2013:p0334:b004:l037","ordinal":102331,"en":"You have given us a bad name!”"},{"id":"semetey-1-2013:p0334:b004:l038","ordinal":102332,"en":"So Semetey said,"},{"id":"semetey-1-2013:p0334:b004:l039","ordinal":102333,"en":"And when he had spoken,"},{"id":"semetey-1-2013:p0335:b003:l001","ordinal":102334,"en":"When he had uttered"},{"id":"semetey-1-2013:p0335:b003:l002","ordinal":102335,"en":"Those very grievous, painful words:"},{"id":"semetey-1-2013:p0335:b003:l003","ordinal":102336,"en":"“Oh, my dear little brother,"},{"id":"semetey-1-2013:p0335:b003:l004","ordinal":102337,"en":"May that foul mouth fill with blood!"},{"id":"semetey-1-2013:p0335:b003:l005","ordinal":102338,"en":"What creature says such things?"},{"id":"semetey-1-2013:p0335:b003:l006","ordinal":102339,"en":"Oh, little brother, stop!” she said."},{"id":"semetey-1-2013:p0335:b003:l007","ordinal":102340,"en":"The impetuous woman sprang up."},{"id":"semetey-1-2013:p0335:b003:l008","ordinal":102341,"en":"Semetey stretched out"},{"id":"semetey-1-2013:p0335:b003:l009","ordinal":102342,"en":"His hand toward his mother."},{"id":"semetey-1-2013:p0335:b003:l010","ordinal":102343,"en":"In her haste, Kanykey"},{"id":"semetey-1-2013:p0335:b003:l011","ordinal":102344,"en":"Gave the boy her hand."},{"id":"semetey-1-2013:p0335:b003:l012","ordinal":102345,"en":"Without a slip in her words,"},{"id":"semetey-1-2013:p0335:b003:l013","ordinal":102346,"en":"Calling him little brother, deceiving him greatly,"},{"id":"semetey-1-2013:p0335:b003:l014","ordinal":102347,"en":"Kanykey answered him."},{"id":"semetey-1-2013:p0335:b003:l015","ordinal":102348,"en":"Now the boy heard her false words;"},{"id":"semetey-1-2013:p0335:b003:l016","ordinal":102349,"en":"Semetey, left by the hero,"},{"id":"semetey-1-2013:p0335:b003:l017","ordinal":102350,"en":"Now burned with rage!"},{"id":"semetey-1-2013:p0335:b003:l018","ordinal":102351,"en":"The khan's only child"},{"id":"semetey-1-2013:p0335:b003:l019","ordinal":102352,"en":"Seized her hand;"},{"id":"semetey-1-2013:p0335:b003:l020","ordinal":102353,"en":"The ill-fated orphan slave"},{"id":"semetey-1-2013:p0335:b003:l021","ordinal":102354,"en":"Clutched it hard."},{"id":"semetey-1-2013:p0335:b003:l022","ordinal":102355,"en":"Unable to endure his grip,"},{"id":"semetey-1-2013:p0335:b003:l023","ordinal":102356,"en":"Burning with pain and shrieking,"},{"id":"semetey-1-2013:p0335:b003:l024","ordinal":102357,"en":"Helpless and in agony,"},{"id":"semetey-1-2013:p0335:b003:l025","ordinal":102358,"en":"She burst out sobbing:"},{"id":"semetey-1-2013:p0335:b003:l026","ordinal":102359,"en":"“Let go of my hand, orphan!"},{"id":"semetey-1-2013:p0335:b003:l027","ordinal":102360,"en":"My foal, do not dig my pit!"},{"id":"semetey-1-2013:p0335:b003:l028","ordinal":102361,"en":"My foal, do not keep stirring up"},{"id":"semetey-1-2013:p0335:b003:l029","ordinal":102362,"en":"My far-off misery."},{"id":"semetey-1-2013:p0335:b003:l030","ordinal":102363,"en":"Now I shall sing my song;"},{"id":"semetey-1-2013:p0335:b003:l031","ordinal":102364,"en":"Alas, orphan, let go!"},{"id":"semetey-1-2013:p0335:b003:l032","ordinal":102365,"en":"Now I shall tell my truth."},{"id":"semetey-1-2013:p0335:b003:l033","ordinal":102366,"en":"When your father Manas died,"},{"id":"semetey-1-2013:p0335:b003:l034","ordinal":102367,"en":"You, the male child left behind, were young;"},{"id":"semetey-1-2013:p0335:b003:l035","ordinal":102368,"en":"All the scoundrels were enemies."},{"id":"semetey-1-2013:p0335:b003:l036","ordinal":102369,"en":"When they plundered my possessions,"},{"id":"semetey-1-2013:p0335:b003:l037","ordinal":102370,"en":"When the dogs wrought havoc,"},{"id":"semetey-1-2013:p0335:b003:l038","ordinal":102371,"en":"The drop flowing from Alai,"},{"id":"semetey-1-2013:p0335:b003:l039","ordinal":102372,"en":"Has not yet left my fat rump—"},{"id":"semetey-1-2013:p0335:b004:l001","ordinal":102373,"en":"My foal, the slave Abyke's whip."},{"id":"semetey-1-2013:p0335:b004:l002","ordinal":102374,"en":"I have more words to tell:"},{"id":"semetey-1-2013:p0335:b004:l003","ordinal":102375,"en":"I, your disgraced, hapless mother,"},{"id":"semetey-1-2013:p0335:b004:l004","ordinal":102376,"en":"Where the six scoundrels struck,"},{"id":"semetey-1-2013:p0335:b004:l005","ordinal":102377,"en":"Still bear the mark upon my breast."},{"id":"semetey-1-2013:p0335:b004:l006","ordinal":102378,"en":"Will God take me if I lament?"},{"id":"semetey-1-2013:p0335:b004:l007","ordinal":102379,"en":"Back then, when I carried you,"},{"id":"semetey-1-2013:p0335:b004:l008","ordinal":102380,"en":"Fleeing in grief and wandering,"},{"id":"semetey-1-2013:p0335:b004:l009","ordinal":102381,"en":"When I wandered away in winter,"},{"id":"semetey-1-2013:p0335:b004:l010","ordinal":102382,"en":"Through the great Syr-Darya's waters,"},{"id":"semetey-1-2013:p0335:b004:l011","ordinal":102383,"en":"When I trudged across forty-two times,"},{"id":"semetey-1-2013:p0335:b004:l012","ordinal":102384,"en":"God confounding my thoughts,"},{"id":"semetey-1-2013:p0335:b004:l013","ordinal":102385,"en":"Clasping the child to my breast,"},{"id":"semetey-1-2013:p0335:b004:l014","ordinal":102386,"en":"My widowhood made plain,"},{"id":"semetey-1-2013:p0335:b004:l015","ordinal":102387,"en":"I put my mother on my shoulders,"},{"id":"semetey-1-2013:p0335:b004:l016","ordinal":102388,"en":"That poor unfortunate woman."},{"id":"semetey-1-2013:p0335:b004:l017","ordinal":102389,"en":"Will God take me if I lament?"},{"id":"semetey-1-2013:p0335:b004:l018","ordinal":102390,"en":"Will the ice that formed on my calves"},{"id":"semetey-1-2013:p0335:b004:l019","ordinal":102391,"en":"Ever leave my very bones?"},{"id":"semetey-1-2013:p0335:b004:l020","ordinal":102392,"en":"My foal, Abyke and Kobosh, two scoundrels,"},{"id":"semetey-1-2013:p0335:b004:l021","ordinal":102393,"en":"From these I suffered humiliation."},{"id":"semetey-1-2013:p0335:b004:l022","ordinal":102394,"en":"Chyybyt and Kochkor, four scoundrels,"},{"id":"semetey-1-2013:p0335:b004:l023","ordinal":102395,"en":"From those I suffered arrogance."},{"id":"semetey-1-2013:p0335:b004:l024","ordinal":102396,"en":"Adybay and Kolbay, six scoundrels,"},{"id":"semetey-1-2013:p0335:b004:l025","ordinal":102397,"en":"I truly suffered humiliation, my son."},{"id":"semetey-1-2013:p0335:b004:l026","ordinal":102398,"en":"Back then, I, your mother Kanykey,"},{"id":"semetey-1-2013:p0335:b004:l027","ordinal":102399,"en":"Could not cross Kuyuk Pass,"},{"id":"semetey-1-2013:p0335:b004:l028","ordinal":102400,"en":"Could not walk, grieving and wandering,"}]
