[{"id":"semetey-1-2013:p1429:b004:l025","ordinal":185345,"en":"The gray-wolf warrior lay down in wait."},{"id":"semetey-1-2013:p1429:b004:l026","ordinal":185346,"en":"Let us leave him there for now;"},{"id":"semetey-1-2013:p1429:b004:l027","ordinal":185347,"en":"Karagul, a man of fierce courage,"},{"id":"semetey-1-2013:p1429:b004:l028","ordinal":185348,"en":"Was the khan of the herdsmen—"},{"id":"semetey-1-2013:p1429:b004:l029","ordinal":185349,"en":"Let us begin the tale of him."},{"id":"semetey-2-2013:p0003:b004:l001","ordinal":185350,"en":"Its roof-ring was gold, its ropes were copper—"},{"id":"semetey-2-2013:p0003:b004:l002","ordinal":185351,"en":"Karagul's house broad as a millstone."},{"id":"semetey-2-2013:p0003:b004:l003","ordinal":185352,"en":"Swaying like a blue tiger,"},{"id":"semetey-2-2013:p0003:b004:l004","ordinal":185353,"en":"The youngest of the herdsmen,"},{"id":"semetey-2-2013:p0003:b004:l005","ordinal":185354,"en":"Bozbala, awoke in fright."},{"id":"semetey-2-2013:p0003:b004:l006","ordinal":185355,"en":"To the tent with golden poles,"},{"id":"semetey-2-2013:p0003:b004:l007","ordinal":185356,"en":"He resolved to tell what he had seen"},{"id":"semetey-2-2013:p0003:b004:l008","ordinal":185357,"en":"To hero Karagul."},{"id":"semetey-2-2013:p0003:b004:l009","ordinal":185358,"en":"Bozbala rose and spoke,"},{"id":"semetey-2-2013:p0003:b004:l010","ordinal":185359,"en":"Telling a horror no one knew,"},{"id":"semetey-2-2013:p0003:b004:l011","ordinal":185360,"en":"Speaking no lie but the truth."},{"id":"semetey-2-2013:p0003:b004:l012","ordinal":185361,"en":"When Bozbala entered,"},{"id":"semetey-2-2013:p0003:b004:l013","ordinal":185362,"en":"Karagul, son of Katal—"},{"id":"semetey-2-2013:p0003:b004:l014","ordinal":185363,"en":"Here was the dark hour."},{"id":"semetey-2-2013:p0003:b004:l015","ordinal":185364,"en":"Look at that raging slave!"},{"id":"semetey-2-2013:p0003:b004:l016","ordinal":185365,"en":"Both cunning and a hero,"},{"id":"semetey-2-2013:p0003:b004:l017","ordinal":185366,"en":"His name and fame were heard"},{"id":"semetey-2-2013:p0003:b004:l018","ordinal":185367,"en":"Throughout the Kakan people;"},{"id":"semetey-2-2013:p0003:b004:l019","ordinal":185368,"en":"He was a greater hero than Kongurbai."},{"id":"semetey-2-2013:p0003:b004:l020","ordinal":185369,"en":"He made his old age harshly known:"},{"id":"semetey-2-2013:p0003:b004:l021","ordinal":185370,"en":"When his bladder ached,"},{"id":"semetey-2-2013:p0003:b004:l022","ordinal":185371,"en":"Forty-two nobles"},{"id":"semetey-2-2013:p0003:b004:l023","ordinal":185372,"en":"Lifted that accursed swine"},{"id":"semetey-2-2013:p0003:b004:l024","ordinal":185373,"en":"And carried him out to urinate."},{"id":"semetey-2-2013:p0003:b004:l025","ordinal":185374,"en":"They slaughtered a barren, milk-fed foal,"},{"id":"semetey-2-2013:p0003:b004:l026","ordinal":185375,"en":"Cut horse-rib fat and set out mane fat,"},{"id":"semetey-2-2013:p0003:b004:l027","ordinal":185376,"en":"And laid out food and provisions"},{"id":"semetey-2-2013:p0003:b004:l028","ordinal":185377,"en":"For that wretched slave himself."},{"id":"semetey-2-2013:p0003:b004:l029","ordinal":185378,"en":"Black liquor from a leather flask"},{"id":"semetey-2-2013:p0003:b004:l030","ordinal":185379,"en":"Was what that accursed slave"},{"id":"semetey-2-2013:p0003:b004:l031","ordinal":185380,"en":"Drank to quench his thirst,"},{"id":"semetey-2-2013:p0003:b006:l001","ordinal":185381,"en":"Liquor mixed with küpsör."},{"id":"semetey-2-2013:p0003:b006:l002","ordinal":185382,"en":"That ruined slave,"},{"id":"semetey-2-2013:p0003:b006:l003","ordinal":185383,"en":"As though he were ill,"},{"id":"semetey-2-2013:p0003:b006:l004","ordinal":185384,"en":"Sat enjoying luxury"},{"id":"semetey-2-2013:p0003:b006:l005","ordinal":185385,"en":"Like Prince Khan Kongurbai."},{"id":"semetey-2-2013:p0003:b006:l006","ordinal":185386,"en":"Look at the accursed one,"},{"id":"semetey-2-2013:p0003:b006:l007","ordinal":185387,"en":"Drinking liquor and heaving;"},{"id":"semetey-2-2013:p0003:b006:l008","ordinal":185388,"en":"Do not ask about the accursed one,"},{"id":"semetey-2-2013:p0003:b006:l009","ordinal":185389,"en":"Flapping like a blue vulture."},{"id":"semetey-2-2013:p0003:b006:l010","ordinal":185390,"en":"He prolonged the conversation,"},{"id":"semetey-2-2013:p0003:b006:l011","ordinal":185391,"en":"Making some sixty herdsmen"},{"id":"semetey-2-2013:p0003:b006:l012","ordinal":185392,"en":"Tell their tales in turn."},{"id":"semetey-2-2013:p0003:b006:l013","ordinal":185393,"en":"He had someone who angered him"},{"id":"semetey-2-2013:p0003:b006:l014","ordinal":185394,"en":"Tan fresh hide,"},{"id":"semetey-2-2013:p0003:b006:l015","ordinal":185395,"en":"And made twelve Kalmaks"},{"id":"semetey-2-2013:p0003:b006:l016","ordinal":185396,"en":"Dance awkwardly before him."},{"id":"semetey-2-2013:p0003:b006:l017","ordinal":185397,"en":"Karagul, source of ruin—"},{"id":"semetey-2-2013:p0003:b006:l018","ordinal":185398,"en":"Look at his appearance!"},{"id":"semetey-2-2013:p0003:b006:l019","ordinal":185399,"en":"That was the wretched slave himself;"},{"id":"semetey-2-2013:p0003:b006:l020","ordinal":185400,"en":"Those were Karagul's eyes!"},{"id":"semetey-2-2013:p0003:b006:l021","ordinal":185401,"en":"Before Karagul"},{"id":"semetey-2-2013:p0003:b006:l022","ordinal":185402,"en":"Bozbala came."},{"id":"semetey-2-2013:p0003:b006:l023","ordinal":185403,"en":"His knee bent to the ground,"},{"id":"semetey-2-2013:p0003:b006:l024","ordinal":185404,"en":"And he bowed like a bride,"},{"id":"semetey-2-2013:p0003:b006:l025","ordinal":185405,"en":"Straining his throat as he roared,"},{"id":"semetey-2-2013:p0003:b006:l026","ordinal":185406,"en":"Shouting in alarm,"},{"id":"semetey-2-2013:p0003:b006:l027","ordinal":185407,"en":"Calling, “Abygyi!”"},{"id":"semetey-2-2013:p0003:b006:l028","ordinal":185408,"en":"“Last night as I slept, I dreamed;"},{"id":"semetey-2-2013:p0003:b006:l029","ordinal":185409,"en":"Abygyi, I shall tell you."},{"id":"semetey-2-2013:p0003:b006:l030","ordinal":185410,"en":"In my dream I saw a wondrous thing!"},{"id":"semetey-2-2013:p0003:b006:l031","ordinal":185411,"en":"My dream last night was terrifying,"},{"id":"semetey-2-2013:p0004:b003:l001","ordinal":185412,"en":"A dream that made my heart leap!"},{"id":"semetey-2-2013:p0004:b003:l002","ordinal":185413,"en":"My dream last night will not leave me well;"},{"id":"semetey-2-2013:p0004:b003:l003","ordinal":185414,"en":"When I consider last night's dream,"},{"id":"semetey-2-2013:p0004:b003:l004","ordinal":185415,"en":"There were eighty-four armed men,"},{"id":"semetey-2-2013:p0004:b003:l005","ordinal":185416,"en":"And wherever they struck was red fire."},{"id":"semetey-2-2013:p0004:b003:l006","ordinal":185417,"en":"His face turned dark with fury:"},{"id":"semetey-2-2013:p0004:b003:l007","ordinal":185418,"en":"Semetey, son of Manas,"},{"id":"semetey-2-2013:p0004:b003:l008","ordinal":185419,"en":"Had come in the dark hour,"},{"id":"semetey-2-2013:p0004:b003:l009","ordinal":185420,"en":"Thick-armed and stone-hearted,"},{"id":"semetey-2-2013:p0004:b003:l010","ordinal":185421,"en":"A great elephant-limbed brute."},{"id":"semetey-2-2013:p0004:b003:l011","ordinal":185422,"en":"His broad-socketed patterned spear"},{"id":"semetey-2-2013:p0004:b003:l012","ordinal":185423,"en":"Was shod with steel at its base."},{"id":"semetey-2-2013:p0004:b003:l013","ordinal":185424,"en":"Against the mortals who clashed with him,"},{"id":"semetey-2-2013:p0004:b003:l014","ordinal":185425,"en":"He showed no fear and gave no opening."},{"id":"semetey-2-2013:p0004:b003:l015","ordinal":185426,"en":"He began a terrible rage;"},{"id":"semetey-2-2013:p0004:b003:l016","ordinal":185427,"en":"Stretching all of us out,"},{"id":"semetey-2-2013:p0004:b003:l017","ordinal":185428,"en":"He seized and slaughtered us."},{"id":"semetey-2-2013:p0004:b003:l018","ordinal":185429,"en":"He gouged out our eyes,"},{"id":"semetey-2-2013:p0004:b003:l019","ordinal":185430,"en":"Slaughtered us in a massacre,"},{"id":"semetey-2-2013:p0004:b003:l020","ordinal":185431,"en":"And made our heads roll;"},{"id":"semetey-2-2013:p0004:b003:l021","ordinal":185432,"en":"The crows drank their fill of blood."},{"id":"semetey-2-2013:p0004:b003:l022","ordinal":185433,"en":"He gathered and seized the herdsmen,"},{"id":"semetey-2-2013:p0004:b003:l023","ordinal":185434,"en":"Led by the great hero,"},{"id":"semetey-2-2013:p0004:b003:l024","ordinal":185435,"en":"Destroyed all of us together,"},{"id":"semetey-2-2013:p0004:b003:l025","ordinal":185436,"en":"And carried out a massacre."},{"id":"semetey-2-2013:p0004:b003:l026","ordinal":185437,"en":"What can this mean?"},{"id":"semetey-2-2013:p0004:b003:l027","ordinal":185438,"en":"Interpret this dream for me!"},{"id":"semetey-2-2013:p0004:b003:l028","ordinal":185439,"en":"Looming like a lion,"},{"id":"semetey-2-2013:p0004:b003:l029","ordinal":185440,"en":"He strode out from the hut;"},{"id":"semetey-2-2013:p0004:b003:l030","ordinal":185441,"en":"Crushing whatever stirred,"},{"id":"semetey-2-2013:p0004:b003:l031","ordinal":185442,"en":"He smashed it with a battle-axe."},{"id":"semetey-2-2013:p0004:b003:l032","ordinal":185443,"en":"What can this mean?"},{"id":"semetey-2-2013:p0004:b003:l033","ordinal":185444,"en":"Interpret this dream for me!"},{"id":"semetey-2-2013:p0004:b003:l034","ordinal":185445,"en":"A flood came against Beijing,"},{"id":"semetey-2-2013:p0004:b003:l035","ordinal":185446,"en":"Shattered the stone fortress,"},{"id":"semetey-2-2013:p0004:b003:l036","ordinal":185447,"en":"And utterly destroyed it."},{"id":"semetey-2-2013:p0004:b003:l037","ordinal":185448,"en":"All its willows lay fallen;"},{"id":"semetey-2-2013:p0004:b003:l038","ordinal":185449,"en":"All the buildings"},{"id":"semetey-2-2013:p0004:b003:l039","ordinal":185450,"en":"Of this Beijing collapsed."},{"id":"semetey-2-2013:p0004:b003:l040","ordinal":185451,"en":"What can this mean?"},{"id":"semetey-2-2013:p0004:b003:l041","ordinal":185452,"en":"Interpret this dream for me!"},{"id":"semetey-2-2013:p0004:b005:l001","ordinal":185453,"en":"Fire came from the west"},{"id":"semetey-2-2013:p0004:b005:l002","ordinal":185454,"en":"And burned all the mighty men."},{"id":"semetey-2-2013:p0004:b005:l003","ordinal":185455,"en":"Caught in the blazing fire,"},{"id":"semetey-2-2013:p0004:b005:l004","ordinal":185456,"en":"You yourself burned away."},{"id":"semetey-2-2013:p0004:b005:l005","ordinal":185457,"en":"What can this mean?"},{"id":"semetey-2-2013:p0004:b005:l006","ordinal":185458,"en":"Interpret this dream for me!"},{"id":"semetey-2-2013:p0004:b005:l007","ordinal":185459,"en":"Semetey, son of Manas,"},{"id":"semetey-2-2013:p0004:b005:l008","ordinal":185460,"en":"Champion of the Buruts,"},{"id":"semetey-2-2013:p0004:b005:l009","ordinal":185461,"en":"Destroyed wherever he reached,"},{"id":"semetey-2-2013:p0004:b005:l010","ordinal":185462,"en":"And his conflict struck us!"},{"id":"semetey-2-2013:p0004:b005:l011","ordinal":185463,"en":"His menace was fierce, his wrath strong;"},{"id":"semetey-2-2013:p0004:b005:l012","ordinal":185464,"en":"He seized and slaughtered, laying all flat."},{"id":"semetey-2-2013:p0004:b005:l013","ordinal":185465,"en":"I fear for your horses;"},{"id":"semetey-2-2013:p0004:b005:l014","ordinal":185466,"en":"I despair of my life."},{"id":"semetey-2-2013:p0004:b005:l015","ordinal":185467,"en":"Countless men led by Manas"},{"id":"semetey-2-2013:p0004:b005:l016","ordinal":185468,"en":"Surged over us,"},{"id":"semetey-2-2013:p0004:b005:l017","ordinal":185469,"en":"And a thousand men led by Bakai"},{"id":"semetey-2-2013:p0004:b005:l018","ordinal":185470,"en":"Thronged around us."},{"id":"semetey-2-2013:p0004:b005:l019","ordinal":185471,"en":"I utterly despaired of life."},{"id":"semetey-2-2013:p0004:b005:l020","ordinal":185472,"en":"Before them"},{"id":"semetey-2-2013:p0004:b005:l021","ordinal":185473,"en":"Rode a man upon a red-gray horse,"},{"id":"semetey-2-2013:p0004:b005:l022","ordinal":185474,"en":"Its hair tail knotted tight:"},{"id":"semetey-2-2013:p0004:b005:l023","ordinal":185475,"en":"Tall and broad-shouldered,"},{"id":"semetey-2-2013:p0004:b005:l024","ordinal":185476,"en":"With a face like oiled wheat,"},{"id":"semetey-2-2013:p0004:b005:l025","ordinal":185477,"en":"Eyes like twilight mist,"},{"id":"semetey-2-2013:p0004:b005:l026","ordinal":185478,"en":"Wide-mouthed and cliff-browed,"},{"id":"semetey-2-2013:p0004:b005:l027","ordinal":185479,"en":"A man resembling an executioner,"},{"id":"semetey-2-2013:p0004:b005:l028","ordinal":185480,"en":"Both champion and hero,"},{"id":"semetey-2-2013:p0004:b005:l029","ordinal":185481,"en":"Who would subjugate the world—"},{"id":"semetey-2-2013:p0004:b005:l030","ordinal":185482,"en":"That hero was a blood-drinking warrior."},{"id":"semetey-2-2013:p0004:b005:l031","ordinal":185483,"en":"He rode a horse no bullet could catch"},{"id":"semetey-2-2013:p0004:b005:l032","ordinal":185484,"en":"And wore armor no bullet could pierce;"},{"id":"semetey-2-2013:p0004:b005:l033","ordinal":185485,"en":"His muscles were like a bull's back,"},{"id":"semetey-2-2013:p0004:b005:l034","ordinal":185486,"en":"As though he would defeat anyone who grappled him."},{"id":"semetey-2-2013:p0004:b005:l035","ordinal":185487,"en":"No mortal could go against him;"},{"id":"semetey-2-2013:p0004:b005:l036","ordinal":185488,"en":"None who struck him remained alive."},{"id":"semetey-2-2013:p0004:b005:l037","ordinal":185489,"en":"His eyes blazed like fire;"},{"id":"semetey-2-2013:p0004:b005:l038","ordinal":185490,"en":"He gnashed his teeth and chewed up heroes."},{"id":"semetey-2-2013:p0004:b005:l039","ordinal":185491,"en":"He himself followed the faith of Islam:"},{"id":"semetey-2-2013:p0004:b005:l040","ordinal":185492,"en":"Semetey, son of Manas,"},{"id":"semetey-2-2013:p0004:b005:l041","ordinal":185493,"en":"Had come and lay there,"},{"id":"semetey-2-2013:p0005:b003:l001","ordinal":185494,"en":"Bearing enmity toward us."},{"id":"semetey-2-2013:p0005:b003:l002","ordinal":185495,"en":"Semetey, son of Manas,"},{"id":"semetey-2-2013:p0005:b003:l003","ordinal":185496,"en":"That mighty hero, had come;"},{"id":"semetey-2-2013:p0005:b003:l004","ordinal":185497,"en":"He had brought splendid slaughter."},{"id":"semetey-2-2013:p0005:b003:l005","ordinal":185498,"en":"Beginning with you, Abygyi,"},{"id":"semetey-2-2013:p0005:b003:l006","ordinal":185499,"en":"He cut off heads with his sword!"},{"id":"semetey-2-2013:p0005:b003:l007","ordinal":185500,"en":"What can this mean?"},{"id":"semetey-2-2013:p0005:b003:l008","ordinal":185501,"en":"Interpret this dream for me!"},{"id":"semetey-2-2013:p0005:b003:l009","ordinal":185502,"en":"He shattered the people among the rocks"},{"id":"semetey-2-2013:p0005:b003:l010","ordinal":185503,"en":"And brought splendid slaughter;"},{"id":"semetey-2-2013:p0005:b003:l011","ordinal":185504,"en":"Beating them into a spectacle,"},{"id":"semetey-2-2013:p0005:b003:l012","ordinal":185505,"en":"He slaughtered upon the road"},{"id":"semetey-2-2013:p0005:b003:l013","ordinal":185506,"en":"All who challenged him"},{"id":"semetey-2-2013:p0005:b003:l014","ordinal":185507,"en":"And divided them among the Dangyts!"},{"id":"semetey-2-2013:p0005:b003:l015","ordinal":185508,"en":"What can this mean?"},{"id":"semetey-2-2013:p0005:b003:l016","ordinal":185509,"en":"Interpret this dream for me!”"},{"id":"semetey-2-2013:p0005:b003:l017","ordinal":185510,"en":"His anger flared and bristled;"},{"id":"semetey-2-2013:p0005:b003:l018","ordinal":185511,"en":"When Karagul heard this,"},{"id":"semetey-2-2013:p0005:b003:l019","ordinal":185512,"en":"He rose in towering rage."},{"id":"semetey-2-2013:p0005:b003:l020","ordinal":185513,"en":"The hair on his crown stood on end;"},{"id":"semetey-2-2013:p0005:b003:l021","ordinal":185514,"en":"Karagul, who descended upon you,"},{"id":"semetey-2-2013:p0005:b003:l022","ordinal":185515,"en":"Had hair bristling at his nape."},{"id":"semetey-2-2013:p0005:b003:l023","ordinal":185516,"en":"He raged against the boy,"},{"id":"semetey-2-2013:p0005:b003:l024","ordinal":185517,"en":"Had him confined in the broad house,"},{"id":"semetey-2-2013:p0005:b003:l025","ordinal":185518,"en":"And blocked his way, Karagul."},{"id":"semetey-2-2013:p0005:b003:l026","ordinal":185519,"en":"For saying he had dreamed, he had him butchered,"},{"id":"semetey-2-2013:p0005:b003:l027","ordinal":185520,"en":"Clubbed and beaten,"},{"id":"semetey-2-2013:p0005:b003:l028","ordinal":185521,"en":"His hands and feet bound,"},{"id":"semetey-2-2013:p0005:b003:l029","ordinal":185522,"en":"And beaten from head to foot."},{"id":"semetey-2-2013:p0005:b003:l030","ordinal":185523,"en":"He had him driven about with blows,"},{"id":"semetey-2-2013:p0005:b003:l031","ordinal":185524,"en":"Had all his clothing torn,"},{"id":"semetey-2-2013:p0005:b003:l032","ordinal":185525,"en":"And made him swallow nine bowls of water"},{"id":"semetey-2-2013:p0005:b003:l033","ordinal":185526,"en":"One after another."},{"id":"semetey-2-2013:p0005:b003:l034","ordinal":185527,"en":"Giving him an ankle bone, he tortured him;"},{"id":"semetey-2-2013:p0005:b003:l035","ordinal":185528,"en":"For saying he had dreamed,"},{"id":"semetey-2-2013:p0005:b003:l036","ordinal":185529,"en":"They all tormented the boy together,"},{"id":"semetey-2-2013:p0005:b003:l037","ordinal":185530,"en":"Dragged him by the ears,"},{"id":"semetey-2-2013:p0005:b003:l038","ordinal":185531,"en":"Had the boy clubbed,"},{"id":"semetey-2-2013:p0005:b003:l039","ordinal":185532,"en":"And had the herdsmen beat him."},{"id":"semetey-2-2013:p0005:b005:l001","ordinal":185533,"en":"Bozbala, who thought himself clever,"},{"id":"semetey-2-2013:p0005:b005:l002","ordinal":185534,"en":"The youngest of the herdsmen,"},{"id":"semetey-2-2013:p0005:b005:l003","ordinal":185535,"en":"Was made to learn his reckoning thus:"},{"id":"semetey-2-2013:p0005:b005:l004","ordinal":185536,"en":"When he bent over,"},{"id":"semetey-2-2013:p0005:b005:l005","ordinal":185537,"en":"The prince had a whip laid across his backside."},{"id":"semetey-2-2013:p0005:b005:l006","ordinal":185538,"en":"“Your dream is fox dung,” he said,"},{"id":"semetey-2-2013:p0005:b005:l007","ordinal":185539,"en":"“And you yourself are my dung."},{"id":"semetey-2-2013:p0005:b005:l008","ordinal":185540,"en":"I am the one who deceived"},{"id":"semetey-2-2013:p0005:b005:l009","ordinal":185541,"en":"His father, bloodthirsty Manas, six times!"},{"id":"semetey-2-2013:p0005:b005:l010","ordinal":185542,"en":"What profit is there in turning back?"},{"id":"semetey-2-2013:p0005:b005:l011","ordinal":185543,"en":"While I, Abygyi, stand here,"},{"id":"semetey-2-2013:p0005:b005:l012","ordinal":185544,"en":"How could the Burut come!"},{"id":"semetey-2-2013:p0005:b005:l013","ordinal":185545,"en":"Look how brazen he is,"},{"id":"semetey-2-2013:p0005:b005:l014","ordinal":185546,"en":"Saying, ‘In my dream I saw"},{"id":"semetey-2-2013:p0005:b005:l015","ordinal":185547,"en":"The orphan son of Manas’!"},{"id":"semetey-2-2013:p0005:b005:l016","ordinal":185548,"en":"Look how worthless he is,"},{"id":"semetey-2-2013:p0005:b005:l017","ordinal":185549,"en":"Saying, ‘I saw Oen's son’!"},{"id":"semetey-2-2013:p0005:b005:l018","ordinal":185550,"en":"Look how useless"},{"id":"semetey-2-2013:p0005:b005:l019","ordinal":185551,"en":"Accursed Bozbala is,"},{"id":"semetey-2-2013:p0005:b005:l020","ordinal":185552,"en":"Saying, ‘I saw the son of Manas’!"},{"id":"semetey-2-2013:p0005:b005:l021","ordinal":185553,"en":"He beat the dreamer like a dog;"},{"id":"semetey-2-2013:p0005:b005:l022","ordinal":185554,"en":"Now no one remained who would dream."},{"id":"semetey-2-2013:p0005:b005:l023","ordinal":185555,"en":"The two-eyed, clairvoyant boy—"},{"id":"semetey-2-2013:p0005:b005:l024","ordinal":185556,"en":"Was he not a bakshy,"},{"id":"semetey-2-2013:p0005:b005:l025","ordinal":185557,"en":"Saying, ‘I saw the son of Manas,’"},{"id":"semetey-2-2013:p0005:b005:l026","ordinal":185558,"en":"And, ‘I learned all that is and is not’?"},{"id":"semetey-2-2013:p0005:b005:l027","ordinal":185559,"en":"Was he not a good boy!"},{"id":"semetey-2-2013:p0005:b005:l028","ordinal":185560,"en":"The accursed Burut"},{"id":"semetey-2-2013:p0005:b005:l029","ordinal":185561,"en":"Has no power to come to China."},{"id":"semetey-2-2013:p0005:b005:l030","ordinal":185562,"en":"All the heroes who would bring"},{"id":"semetey-2-2013:p0005:b005:l031","ordinal":185563,"en":"Splendid slaughter are gone!"},{"id":"semetey-2-2013:p0005:b005:l032","ordinal":185564,"en":"He has no pass on which to set his resolve;"},{"id":"semetey-2-2013:p0005:b005:l033","ordinal":185565,"en":"That orphan who wandered away"},{"id":"semetey-2-2013:p0005:b005:l034","ordinal":185566,"en":"To the city of Temir Khan"},{"id":"semetey-2-2013:p0005:b005:l035","ordinal":185567,"en":"Has no reason to come here!”"},{"id":"semetey-2-2013:p0005:b005:l036","ordinal":185568,"en":"Because Bozbala said he had dreamed,"},{"id":"semetey-2-2013:p0005:b005:l037","ordinal":185569,"en":"Karagul saw it as an evil burden."},{"id":"semetey-2-2013:p0005:b005:l038","ordinal":185570,"en":"His shouting deafened the ears;"},{"id":"semetey-2-2013:p0005:b005:l039","ordinal":185571,"en":"Karagul lay there that day."},{"id":"semetey-2-2013:p0006:b004:l001","ordinal":185572,"en":"Bright dawn broke,"},{"id":"semetey-2-2013:p0006:b004:l002","ordinal":185573,"en":"And light fell upon the earth."},{"id":"semetey-2-2013:p0006:b004:l003","ordinal":185574,"en":"Alööke's Kongurbai"},{"id":"semetey-2-2013:p0006:b004:l004","ordinal":185575,"en":"Rode the length of his horse,"},{"id":"semetey-2-2013:p0006:b004:l005","ordinal":185576,"en":"Traveling four times around"},{"id":"semetey-2-2013:p0006:b004:l006","ordinal":185577,"en":"The four corners of the world."},{"id":"semetey-2-2013:p0006:b004:l007","ordinal":185578,"en":"He exhausted his horse, surveying the land,"},{"id":"semetey-2-2013:p0006:b004:l008","ordinal":185579,"en":"Watching the patrol and tracking signs."},{"id":"semetey-2-2013:p0006:b004:l009","ordinal":185580,"en":"He jerked the golden reins"},{"id":"semetey-2-2013:p0006:b004:l010","ordinal":185581,"en":"And made his horse Algara lunge."},{"id":"semetey-2-2013:p0006:b004:l011","ordinal":185582,"en":"His great boots thrust forward,"},{"id":"semetey-2-2013:p0006:b004:l012","ordinal":185583,"en":"His neck craned like a rooster's;"},{"id":"semetey-2-2013:p0006:b004:l013","ordinal":185584,"en":"He wrapped himself in blue armor."},{"id":"semetey-2-2013:p0006:b004:l014","ordinal":185585,"en":"If you had seen Kongurbai,"},{"id":"semetey-2-2013:p0006:b004:l015","ordinal":185586,"en":"He raged like a blue tiger."},{"id":"semetey-2-2013:p0006:b004:l016","ordinal":185587,"en":"With his gold-tipped patterned pipe,"},{"id":"semetey-2-2013:p0006:b004:l017","ordinal":185588,"en":"The Kalcha huge as a hut,"},{"id":"semetey-2-2013:p0006:b004:l018","ordinal":185589,"en":"With sixty champions and forty kaldays,"},{"id":"semetey-2-2013:p0006:b004:l019","ordinal":185590,"en":"Their elder Kongurbai"},{"id":"semetey-2-2013:p0006:b004:l020","ordinal":185591,"en":"Hurried the herdsmen."},{"id":"semetey-2-2013:p0006:b004:l021","ordinal":185592,"en":"He made his Black Horse rear"},{"id":"semetey-2-2013:p0006:b004:l022","ordinal":185593,"en":"And pace over rise and hollow;"},{"id":"semetey-2-2013:p0006:b004:l023","ordinal":185594,"en":"Such was the sight."},{"id":"semetey-2-2013:p0006:b004:l024","ordinal":185595,"en":"The blue-gray-bearded swine's"},{"id":"semetey-2-2013:p0006:b004:l025","ordinal":185596,"en":"Chest button was the size of a fist."},{"id":"semetey-2-2013:p0006:b004:l026","ordinal":185597,"en":"At his waist was a düngürchök;"},{"id":"semetey-2-2013:p0006:b004:l027","ordinal":185598,"en":"He put his hand into the düngürchök"},{"id":"semetey-2-2013:p0006:b004:l028","ordinal":185599,"en":"And took tobacco from it."},{"id":"semetey-2-2013:p0006:b004:l029","ordinal":185600,"en":"He stuffed in five handfuls,"}]
