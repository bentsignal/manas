[{"id":"semetey-1-2013:p1359:b003:l009","ordinal":179969,"en":"May my Lord prosper your undertaking;"},{"id":"semetey-1-2013:p1359:b003:l010","ordinal":179970,"en":"May Khizir support your road!"},{"id":"semetey-1-2013:p1359:b003:l011","ordinal":179971,"en":"May your tiger father charge forth"},{"id":"semetey-1-2013:p1359:b003:l012","ordinal":179972,"en":"And appear on your road to support you!"},{"id":"semetey-1-2013:p1359:b003:l013","ordinal":179973,"en":"I have this precious thing;"},{"id":"semetey-1-2013:p1359:b003:l014","ordinal":179974,"en":"My blessed son, listen well!"},{"id":"semetey-1-2013:p1359:b003:l015","ordinal":179975,"en":"Buttoning its front,"},{"id":"semetey-1-2013:p1359:b003:l016","ordinal":179976,"en":"Covering his broad chest,"},{"id":"semetey-1-2013:p1359:b003:l017","ordinal":179977,"en":"So my son might wear it when breaking the host,"},{"id":"semetey-1-2013:p1359:b003:l018","ordinal":179978,"en":"Roaring and taking the risk,"},{"id":"semetey-1-2013:p1359:b003:l019","ordinal":179979,"en":"So he might strike the foe without stopping,"},{"id":"semetey-1-2013:p1359:b003:l020","ordinal":179980,"en":"Break apart the Chinese host,"},{"id":"semetey-1-2013:p1359:b003:l021","ordinal":179981,"en":"And drive them as far as the khagan,"},{"id":"semetey-1-2013:p1359:b003:l022","ordinal":179982,"en":"I made four articles for you four;"},{"id":"semetey-1-2013:p1359:b003:l023","ordinal":179983,"en":"Prince Bakai, the work was hard!"},{"id":"semetey-1-2013:p1359:b003:l024","ordinal":179984,"en":"That you would bring turmoil"},{"id":"semetey-1-2013:p1359:b003:l025","ordinal":179985,"en":"Upon Kakan-Chyn, I knew long ago."},{"id":"semetey-1-2013:p1359:b003:l026","ordinal":179986,"en":"That you would lead your boys"},{"id":"semetey-1-2013:p1359:b003:l027","ordinal":179987,"en":"Against the teeming Chinese,"},{"id":"semetey-1-2013:p1359:b003:l028","ordinal":179988,"en":"I knew long ago;"},{"id":"semetey-1-2013:p1359:b003:l029","ordinal":179989,"en":"That you would unleash calamity and horror,"},{"id":"semetey-1-2013:p1359:b003:l030","ordinal":179990,"en":"I knew long ago."},{"id":"semetey-1-2013:p1359:b003:l031","ordinal":179991,"en":"So he might wear it against his body,"},{"id":"semetey-1-2013:p1359:b003:l032","ordinal":179992,"en":"And face and strike the enemy,"},{"id":"semetey-1-2013:p1359:b003:l033","ordinal":179993,"en":"I have a short coat of plate armor."},{"id":"semetey-1-2013:p1359:b003:l034","ordinal":179994,"en":"When I tell it, it holds such wonders."},{"id":"semetey-1-2013:p1359:b003:l035","ordinal":179995,"en":"Whoever wears it need have little regret;"},{"id":"semetey-1-2013:p1359:b003:l036","ordinal":179996,"en":"If the gray wolves put it on"},{"id":"semetey-1-2013:p1359:b003:l037","ordinal":179997,"en":"And take it to China, there will be great conflict."},{"id":"semetey-1-2013:p1359:b003:l038","ordinal":179998,"en":"This barren, slippery world—"},{"id":"semetey-1-2013:p1359:b003:l039","ordinal":179999,"en":"If they should raid the horses,"},{"id":"semetey-1-2013:p1359:b004:l001","ordinal":180000,"en":"And fight one-on-one"},{"id":"semetey-1-2013:p1359:b004:l002","ordinal":180001,"en":"With mighty hero Kongurbai,"},{"id":"semetey-1-2013:p1359:b004:l003","ordinal":180002,"en":"I feared a spear thrust might pass through."},{"id":"semetey-1-2013:p1359:b004:l004","ordinal":180003,"en":"I, black-faced Kanykey,"},{"id":"semetey-1-2013:p1359:b004:l005","ordinal":180004,"en":"Would have labored in vain if I had not foreseen it;"},{"id":"semetey-1-2013:p1359:b004:l006","ordinal":180005,"en":"Long ago I prepared"},{"id":"semetey-1-2013:p1359:b004:l007","ordinal":180006,"en":"This bulletproof armor."},{"id":"semetey-1-2013:p1359:b004:l008","ordinal":180007,"en":"Across the front of the shoulder,"},{"id":"semetey-1-2013:p1359:b004:l009","ordinal":180008,"en":"Along the edge of the ribs,"},{"id":"semetey-1-2013:p1359:b004:l010","ordinal":180009,"en":"I had fitted and fashioned"},{"id":"semetey-1-2013:p1359:b004:l011","ordinal":180010,"en":"Iron reinforcing bands."},{"id":"semetey-1-2013:p1359:b004:l012","ordinal":180011,"en":"It has nine buttons;"},{"id":"semetey-1-2013:p1359:b004:l013","ordinal":180012,"en":"So he might wear it buttoned,"},{"id":"semetey-1-2013:p1359:b004:l014","ordinal":180013,"en":"And go without stopping to strike"},{"id":"semetey-1-2013:p1359:b004:l015","ordinal":180014,"en":"Enemies who roll against him;"},{"id":"semetey-1-2013:p1359:b004:l016","ordinal":180015,"en":"So upon the foe he faces"},{"id":"semetey-1-2013:p1359:b004:l017","ordinal":180016,"en":"He might firmly bring hardship;"},{"id":"semetey-1-2013:p1359:b004:l018","ordinal":180017,"en":"So my orphan might enter boldly"},{"id":"semetey-1-2013:p1359:b004:l019","ordinal":180018,"en":"And avenge his father Manas,"},{"id":"semetey-1-2013:p1359:b004:l020","ordinal":180019,"en":"I surpassed myself in the making."},{"id":"semetey-1-2013:p1359:b004:l021","ordinal":180020,"en":"To wear into battle,"},{"id":"semetey-1-2013:p1359:b004:l022","ordinal":180021,"en":"For you four I made four coats of armor,"},{"id":"semetey-1-2013:p1359:b004:l023","ordinal":180022,"en":"Prince, uncle Bakai,"},{"id":"semetey-1-2013:p1359:b004:l024","ordinal":180023,"en":"Fitted to each of you!"},{"id":"semetey-1-2013:p1359:b004:l025","ordinal":180024,"en":"So the heroes might wear these,"},{"id":"semetey-1-2013:p1359:b004:l026","ordinal":180025,"en":"And face and strike the enemy."},{"id":"semetey-1-2013:p1359:b004:l027","ordinal":180026,"en":"I have coats I made with care;"},{"id":"semetey-1-2013:p1359:b004:l028","ordinal":180027,"en":"I give them as gifts—put them on,"},{"id":"semetey-1-2013:p1359:b004:l029","ordinal":180028,"en":"And face and strike the enemy!"},{"id":"semetey-1-2013:p1359:b004:l030","ordinal":180029,"en":"Make war upon Beijing;"},{"id":"semetey-1-2013:p1359:b004:l031","ordinal":180030,"en":"Recall the works"},{"id":"semetey-1-2013:p1359:b004:l032","ordinal":180031,"en":"Your unfortunate valiant woman"},{"id":"semetey-1-2013:p1359:b004:l033","ordinal":180032,"en":"Prepared for you!"},{"id":"semetey-1-2013:p1359:b004:l034","ordinal":180033,"en":"And now, my son, listen well!"},{"id":"semetey-1-2013:p1359:b004:l035","ordinal":180034,"en":"Again I pondered, for the task was hard;"},{"id":"semetey-1-2013:p1359:b004:l036","ordinal":180035,"en":"Again, by my will, I made"},{"id":"semetey-1-2013:p1359:b004:l037","ordinal":180036,"en":"Four articles for you four!"},{"id":"semetey-1-2013:p1359:b004:l038","ordinal":180037,"en":"To obtain sharp iron,"},{"id":"semetey-1-2013:p1359:b004:l039","ordinal":180038,"en":"I opened all my livestock stores,"},{"id":"semetey-1-2013:p1360:b003:l001","ordinal":180039,"en":"I, your mother Kanykei,"},{"id":"semetey-1-2013:p1360:b003:l002","ordinal":180040,"en":"Sent men through many cities."},{"id":"semetey-1-2013:p1360:b003:l003","ordinal":180041,"en":"Bölökbai’s forty Kalchas"},{"id":"semetey-1-2013:p1360:b003:l004","ordinal":180042,"en":"I sent roaming over many lands;"},{"id":"semetey-1-2013:p1360:b003:l005","ordinal":180043,"en":"I had every place searched."},{"id":"semetey-1-2013:p1360:b003:l006","ordinal":180044,"en":"I, ill-fated and disgraced,"},{"id":"semetey-1-2013:p1360:b003:l007","ordinal":180045,"en":"Had them bring the keenest iron."},{"id":"semetey-1-2013:p1360:b003:l008","ordinal":180046,"en":"When it came to making charcoal,"},{"id":"semetey-1-2013:p1360:b003:l009","ordinal":180047,"en":"A whole bay of green forest was cleared;"},{"id":"semetey-1-2013:p1360:b003:l010","ordinal":180048,"en":"At the forge no living soul could endure."},{"id":"semetey-1-2013:p1360:b003:l011","ordinal":180049,"en":"Alman dismounted from the argymak,"},{"id":"semetey-1-2013:p1360:b003:l012","ordinal":180050,"en":"And a blue bullock was slaughtered;"},{"id":"semetey-1-2013:p1360:b003:l013","ordinal":180051,"en":"Hammering with sledge and mallet,"},{"id":"semetey-1-2013:p1360:b003:l014","ordinal":180052,"en":"The forty Kalchas wore hollows in their hands."},{"id":"semetey-1-2013:p1360:b003:l015","ordinal":180053,"en":"The master smith Bölökbai,"},{"id":"semetey-1-2013:p1360:b003:l016","ordinal":180054,"en":"After eating, set to work;"},{"id":"semetey-1-2013:p1360:b003:l017","ordinal":180055,"en":"He was a friend of the prophet David—"},{"id":"semetey-1-2013:p1360:b003:l018","ordinal":180056,"en":"That poor man fashioned it."},{"id":"semetey-1-2013:p1360:b003:l019","ordinal":180057,"en":"He stretched gold along its hilt,"},{"id":"semetey-1-2013:p1360:b003:l020","ordinal":180058,"en":"And filled its edge with sharpness;"},{"id":"semetey-1-2013:p1360:b003:l021","ordinal":180059,"en":"Bölökbai, the accomplished smith,"},{"id":"semetey-1-2013:p1360:b003:l022","ordinal":180060,"en":"Barely finished it in seven years."},{"id":"semetey-1-2013:p1360:b003:l023","ordinal":180061,"en":"This wondrous treasure of mine—"},{"id":"semetey-1-2013:p1360:b003:l024","ordinal":180062,"en":"That single dagger"},{"id":"semetey-1-2013:p1360:b003:l025","ordinal":180063,"en":"Is worth forty-five camels."},{"id":"semetey-1-2013:p1360:b003:l026","ordinal":180064,"en":"When you wreak slaughter among the Chinese,"},{"id":"semetey-1-2013:p1360:b003:l027","ordinal":180065,"en":"When you confront the giants"},{"id":"semetey-1-2013:p1360:b003:l028","ordinal":180066,"en":"And close with them rein to rein,"},{"id":"semetey-1-2013:p1360:b003:l029","ordinal":180067,"en":"Draw it from its sheath,"},{"id":"semetey-1-2013:p1360:b003:l030","ordinal":180068,"en":"And plunge it between their ribs."},{"id":"semetey-1-2013:p1360:b003:l031","ordinal":180069,"en":"Its hilt fits within the fist,"},{"id":"semetey-1-2013:p1360:b003:l032","ordinal":180070,"en":"And to carry it against the body"},{"id":"semetey-1-2013:p1360:b003:l033","ordinal":180071,"en":"It has a special case."},{"id":"semetey-1-2013:p1360:b003:l034","ordinal":180072,"en":"I give four treasures to you four;"},{"id":"semetey-1-2013:p1360:b003:l035","ordinal":180073,"en":"Fasten them at your waists."},{"id":"semetey-1-2013:p1360:b003:l036","ordinal":180074,"en":"Accept them as gifts, saying,"},{"id":"semetey-1-2013:p1360:b003:l037","ordinal":180075,"en":"“Our valiant mother gave them.”"},{"id":"semetey-1-2013:p1360:b003:l038","ordinal":180076,"en":"Your destination is the Kakanchin;"},{"id":"semetey-1-2013:p1360:b003:l039","ordinal":180077,"en":"Face them and wreak slaughter!"},{"id":"semetey-1-2013:p1360:b004:l001","ordinal":180078,"en":"I learned this from the transmitters,"},{"id":"semetey-1-2013:p1360:b004:l002","ordinal":180079,"en":"And asked those who knew."},{"id":"semetey-1-2013:p1360:b004:l003","ordinal":180080,"en":"They say Beijing is a hot land,"},{"id":"semetey-1-2013:p1360:b004:l004","ordinal":180081,"en":"Whose heat gives no respite,"},{"id":"semetey-1-2013:p1360:b004:l005","ordinal":180082,"en":"Whose heat boils like fire;"},{"id":"semetey-1-2013:p1360:b004:l006","ordinal":180083,"en":"Whoever meets that heat"},{"id":"semetey-1-2013:p1360:b004:l007","ordinal":180084,"en":"Is left without strength or power."},{"id":"semetey-1-2013:p1360:b004:l008","ordinal":180085,"en":"They say its desert is forty days across,"},{"id":"semetey-1-2013:p1360:b004:l009","ordinal":180086,"en":"A land of surpassing severity."},{"id":"semetey-1-2013:p1360:b004:l010","ordinal":180087,"en":"None has brought it under my sway;"},{"id":"semetey-1-2013:p1360:b004:l011","ordinal":180088,"en":"No one has endured the journey there."},{"id":"semetey-1-2013:p1360:b004:l012","ordinal":180089,"en":"Its land is distant and its people many;"},{"id":"semetey-1-2013:p1360:b004:l013","ordinal":180090,"en":"If my champions set out upon the road,"},{"id":"semetey-1-2013:p1360:b004:l014","ordinal":180091,"en":"Shame on me if I did not foresee"},{"id":"semetey-1-2013:p1360:b004:l015","ordinal":180092,"en":"That their strength would fail."},{"id":"semetey-1-2013:p1360:b004:l016","ordinal":180093,"en":"Far Egypt and broad Jerusalem—"},{"id":"semetey-1-2013:p1360:b004:l017","ordinal":180094,"en":"I had those cities searched,"},{"id":"semetey-1-2013:p1360:b004:l018","ordinal":180095,"en":"And the travel rations found there"},{"id":"semetey-1-2013:p1360:b004:l019","ordinal":180096,"en":"I bought for their weight in worked gold,"},{"id":"semetey-1-2013:p1360:b004:l020","ordinal":180097,"en":"Barely obtaining them at death’s door."},{"id":"semetey-1-2013:p1360:b004:l021","ordinal":180098,"en":"I wrapped the outside in rawhide,"},{"id":"semetey-1-2013:p1360:b004:l022","ordinal":180099,"en":"And destined them for the clash"},{"id":"semetey-1-2013:p1360:b004:l023","ordinal":180100,"en":"With Kakanchin’s Beijing."},{"id":"semetey-1-2013:p1360:b004:l024","ordinal":180101,"en":"How much this poor head has learned!"},{"id":"semetey-1-2013:p1360:b004:l025","ordinal":180102,"en":"Food for the tulpar and food for the hero,"},{"id":"semetey-1-2013:p1360:b004:l026","ordinal":180103,"en":"With nourishing herbs all mixed within."},{"id":"semetey-1-2013:p1360:b004:l027","ordinal":180104,"en":"For each of you four, a separate portion—"},{"id":"semetey-1-2013:p1360:b004:l028","ordinal":180105,"en":"I prepared them long ago."},{"id":"semetey-1-2013:p1360:b004:l029","ordinal":180106,"en":"As the prince’s faithful wife,"},{"id":"semetey-1-2013:p1360:b004:l030","ordinal":180107,"en":"I entrust this treasure to you."},{"id":"semetey-1-2013:p1360:b004:l031","ordinal":180108,"en":"Fasten it behind your saddle,"},{"id":"semetey-1-2013:p1360:b004:l032","ordinal":180109,"en":"And in that forty-day desert"},{"id":"semetey-1-2013:p1360:b004:l033","ordinal":180110,"en":"Pour it straight upon your palate!"},{"id":"semetey-1-2013:p1360:b004:l034","ordinal":180111,"en":"So that in crushing battle with the Chinese"},{"id":"semetey-1-2013:p1360:b004:l035","ordinal":180112,"en":"You may unleash havoc,"},{"id":"semetey-1-2013:p1360:b004:l036","ordinal":180113,"en":"Fight six months without tiring,"},{"id":"semetey-1-2013:p1360:b004:l037","ordinal":180114,"en":"And avenge the noble hero,"},{"id":"semetey-1-2013:p1360:b004:l038","ordinal":180115,"en":"I prepared these travel rations,"},{"id":"semetey-1-2013:p1360:b004:l039","ordinal":180116,"en":"For the valiant heroes themselves"},{"id":"semetey-1-2013:p1361:b003:l001","ordinal":180117,"en":"I prepared and entrusted them;"},{"id":"semetey-1-2013:p1361:b003:l002","ordinal":180118,"en":"Take them gladly as a gift!”"},{"id":"semetey-1-2013:p1361:b003:l003","ordinal":180119,"en":"Your valiant mother Kanykei"},{"id":"semetey-1-2013:p1361:b003:l004","ordinal":180120,"en":"Gave travel rations to all four."},{"id":"semetey-1-2013:p1361:b003:l005","ordinal":180121,"en":"Great Beijing was six months away;"},{"id":"semetey-1-2013:p1361:b003:l006","ordinal":180122,"en":"Those who went to Beijing died—"},{"id":"semetey-1-2013:p1361:b003:l007","ordinal":180123,"en":"Unless mighty Allah watched over them,"},{"id":"semetey-1-2013:p1361:b003:l008","ordinal":180124,"en":"What living soul could return alive?!"},{"id":"semetey-1-2013:p1361:b003:l009","ordinal":180125,"en":"Lest their clothes become infested with lice,"},{"id":"semetey-1-2013:p1361:b003:l010","ordinal":180126,"en":"There was a separate change of clothing for lice;"},{"id":"semetey-1-2013:p1361:b003:l011","ordinal":180127,"en":"Lest their clothes become filthy,"},{"id":"semetey-1-2013:p1361:b003:l012","ordinal":180128,"en":"There was a separate change for dirt."},{"id":"semetey-1-2013:p1361:b003:l013","ordinal":180129,"en":"My heart burns, my liver is embers;"},{"id":"semetey-1-2013:p1361:b003:l014","ordinal":180130,"en":"In this mother’s hands,"},{"id":"semetey-1-2013:p1361:b003:l015","ordinal":180131,"en":"What was there, and what was not!"},{"id":"semetey-1-2013:p1361:b003:l016","ordinal":180132,"en":"Your opponent is the Kakanchin;"},{"id":"semetey-1-2013:p1361:b003:l017","ordinal":180133,"en":"Should you clash in a great conflict,"},{"id":"semetey-1-2013:p1361:b003:l018","ordinal":180134,"en":"For every hero I prepared"},{"id":"semetey-1-2013:p1361:b003:l019","ordinal":180135,"en":"Twelve shirts and ten pairs of trousers,"},{"id":"semetey-1-2013:p1361:b003:l020","ordinal":180136,"en":"Satin, silk, and fine-cloth shirts—"},{"id":"semetey-1-2013:p1361:b003:l021","ordinal":180137,"en":"So that you could pursue the blood-price,"},{"id":"semetey-1-2013:p1361:b003:l022","ordinal":180138,"en":"I foresaw it long ago,"},{"id":"semetey-1-2013:p1361:b003:l023","ordinal":180139,"en":"Gathered and obtained them all,"},{"id":"semetey-1-2013:p1361:b004:l001","ordinal":180140,"en":"And into the bottom of a great saddlebag"},{"id":"semetey-1-2013:p1361:b004:l002","ordinal":180141,"en":"Placed them together."},{"id":"semetey-1-2013:p1361:b004:l003","ordinal":180142,"en":"For you four I made four saddlebags,"},{"id":"semetey-1-2013:p1361:b004:l004","ordinal":180143,"en":"Green and blue in color,"},{"id":"semetey-1-2013:p1361:b004:l005","ordinal":180144,"en":"Of exceedingly great value,"},{"id":"semetey-1-2013:p1361:b004:l006","ordinal":180145,"en":"Saddlebags holding abundant goods."},{"id":"semetey-1-2013:p1361:b004:l007","ordinal":180146,"en":"I reinforced their mouths with steel,"},{"id":"semetey-1-2013:p1361:b004:l008","ordinal":180147,"en":"Stitched them with hidden seams,"},{"id":"semetey-1-2013:p1361:b004:l009","ordinal":180148,"en":"And made those saddlebags ready."},{"id":"semetey-1-2013:p1361:b004:l010","ordinal":180149,"en":"They contain powder and shot,"},{"id":"semetey-1-2013:p1361:b004:l011","ordinal":180150,"en":"Enough to last twelve months,"},{"id":"semetey-1-2013:p1361:b004:l012","ordinal":180151,"en":"So that they would not run out;"},{"id":"semetey-1-2013:p1361:b004:l013","ordinal":180152,"en":"I, disgraced Kanykei,"},{"id":"semetey-1-2013:p1361:b004:l014","ordinal":180153,"en":"Measured it truly for that need!"},{"id":"semetey-1-2013:p1361:b004:l015","ordinal":180154,"en":"So you can stand on opposite banks,"},{"id":"semetey-1-2013:p1361:b004:l016","ordinal":180155,"en":"And when the spear cannot reach,"},{"id":"semetey-1-2013:p1361:b004:l017","ordinal":180156,"en":"Strike with the gun,"},{"id":"semetey-1-2013:p1361:b004:l018","ordinal":180157,"en":"I strengthened their mouths firmly!"},{"id":"semetey-1-2013:p1361:b004:l019","ordinal":180158,"en":"I prepared them for the holy campaign!"},{"id":"semetey-1-2013:p1361:b004:l020","ordinal":180159,"en":"Accept them as gifts, saying,"},{"id":"semetey-1-2013:p1361:b004:l021","ordinal":180160,"en":"“The fierce valiant lady gave them!”"},{"id":"semetey-1-2013:p1361:b004:l022","ordinal":180161,"en":"Set them upon your saddle cushion,"},{"id":"semetey-1-2013:p1361:b004:l023","ordinal":180162,"en":"Close beside your own body!"},{"id":"semetey-1-2013:p1361:b006:l001","ordinal":180163,"en":"From the iron-gated fortress"},{"id":"semetey-1-2013:p1361:b006:l002","ordinal":180164,"en":"Semetey could no longer be restrained."},{"id":"semetey-1-2013:p1361:b006:l003","ordinal":180165,"en":"Loading bullets upon the elephant,"},{"id":"semetey-1-2013:p1361:b006:l004","ordinal":180166,"en":"Taking fourteen horses together,"},{"id":"semetey-1-2013:p1361:b006:l005","ordinal":180167,"en":"Saying, “I shall gird my waist firmly;"},{"id":"semetey-1-2013:p1361:b006:l006","ordinal":180168,"en":"Kongurbai there in Beijing—"},{"id":"semetey-1-2013:p1361:b006:l007","ordinal":180169,"en":"I shall pursue my father’s blood-price,”"},{"id":"semetey-1-2013:p1361:b006:l008","ordinal":180170,"en":"He made his arms and armor ready."},{"id":"semetey-1-2013:p1361:b006:l009","ordinal":180171,"en":"Zulpukor, left by Manas,"},{"id":"semetey-1-2013:p1361:b006:l010","ordinal":180172,"en":"He fastened close against his body;"},{"id":"semetey-1-2013:p1361:b006:l011","ordinal":180173,"en":"Akkelte, entrusted to him"},{"id":"semetey-1-2013:p1361:b006:l012","ordinal":180174,"en":"By his father, gray-wolf Manas,"},{"id":"semetey-1-2013:p1361:b008:l001","ordinal":180175,"en":"Was visible upon his shoulder."},{"id":"semetey-1-2013:p1361:b008:l002","ordinal":180176,"en":"When he entered a shooting battle,"},{"id":"semetey-1-2013:p1361:b008:l003","ordinal":180177,"en":"It was the treasure left as a gift"},{"id":"semetey-1-2013:p1361:b008:l004","ordinal":180178,"en":"By valiant Lord Manas."},{"id":"semetey-1-2013:p1361:b008:l005","ordinal":180179,"en":"Semetey, son of Manas,"},{"id":"semetey-1-2013:p1361:b008:l006","ordinal":180180,"en":"Put on Akolpok"},{"id":"semetey-1-2013:p1361:b008:l007","ordinal":180181,"en":"And now buckled the gray kise at his waist;"},{"id":"semetey-1-2013:p1361:b008:l008","ordinal":180182,"en":"The Forty Saints now supported"},{"id":"semetey-1-2013:p1361:b008:l009","ordinal":180183,"en":"The fortunate, heaven-born prince."},{"id":"semetey-1-2013:p1361:b008:l010","ordinal":180184,"en":"The many treasures Kanykei had given"},{"id":"semetey-1-2013:p1361:b008:l011","ordinal":180185,"en":"Were folded separately,"},{"id":"semetey-1-2013:p1361:b008:l012","ordinal":180186,"en":"And among the fourteen horses"},{"id":"semetey-1-2013:p1362:b003:l001","ordinal":180187,"en":"Loaded upon each bay horse."},{"id":"semetey-1-2013:p1362:b003:l002","ordinal":180188,"en":"When all was ready,"},{"id":"semetey-1-2013:p1362:b003:l003","ordinal":180189,"en":"The dear hero stood tall;"},{"id":"semetey-1-2013:p1362:b003:l004","ordinal":180190,"en":"The steadfast, beloved warrior"},{"id":"semetey-1-2013:p1362:b003:l005","ordinal":180191,"en":"Made his weapons ready,"},{"id":"semetey-1-2013:p1362:b003:l006","ordinal":180192,"en":"Prepared to confront the Kakanchin,"},{"id":"semetey-1-2013:p1362:b003:l007","ordinal":180193,"en":"And remained ready to depart."},{"id":"semetey-1-2013:p1362:b003:l008","ordinal":180194,"en":"The inheritance left by his father—"},{"id":"semetey-1-2013:p1362:b003:l009","ordinal":180195,"en":"Lion Bakai, the keen warrior."},{"id":"semetey-1-2013:p1362:b003:l010","ordinal":180196,"en":"He put on a blue lynx-fur cap"},{"id":"semetey-1-2013:p1362:b003:l011","ordinal":180197,"en":"And flourished his blue-gray shield."},{"id":"semetey-1-2013:p1362:b003:l012","ordinal":180198,"en":"Its crown was a life-protecting coat of mail,"},{"id":"semetey-1-2013:p1362:b003:l013","ordinal":180199,"en":"Its foot was shod with a thousand pieces of gold."},{"id":"semetey-1-2013:p1362:b003:l014","ordinal":180200,"en":"He who flourished the blue-gray shield"},{"id":"semetey-1-2013:p1362:b003:l015","ordinal":180201,"en":"Never tired of the foe he faced."},{"id":"semetey-1-2013:p1362:b003:l016","ordinal":180202,"en":"Bakai Khan, the rich man’s son,"},{"id":"semetey-1-2013:p1362:b003:l017","ordinal":180203,"en":"Had rinsed his mouth with honey;"},{"id":"semetey-1-2013:p1362:b003:l018","ordinal":180204,"en":"He found sight in darkness"},{"id":"semetey-1-2013:p1362:b003:l019","ordinal":180205,"en":"And found words in sudden peril,"},{"id":"semetey-1-2013:p1362:b003:l020","ordinal":180206,"en":"A confidant when taking the road,"},{"id":"semetey-1-2013:p1362:b003:l021","ordinal":180207,"en":"A comrade of tiger Manas."},{"id":"semetey-1-2013:p1362:b003:l022","ordinal":180208,"en":"Bracing himself like a leopard,"},{"id":"semetey-1-2013:p1362:b003:l023","ordinal":180209,"en":"Your dear uncle Bakai"},{"id":"semetey-1-2013:p1362:b003:l024","ordinal":180210,"en":"Received wisdom from the unseen."},{"id":"semetey-1-2013:p1362:b003:l025","ordinal":180211,"en":"His coat of ring mail gleamed;"},{"id":"semetey-1-2013:p1362:b003:l026","ordinal":180212,"en":"Your uncle, lion Bakai,"},{"id":"semetey-1-2013:p1362:b003:l027","ordinal":180213,"en":"Had a white beard that shone,"},{"id":"semetey-1-2013:p1362:b003:l028","ordinal":180214,"en":"And cried like a visiting goose;"},{"id":"semetey-1-2013:p1362:b003:l029","ordinal":180215,"en":"Your heroic uncle Bakai"},{"id":"semetey-1-2013:p1362:b003:l030","ordinal":180216,"en":"Thundered like a prophet."},{"id":"semetey-1-2013:p1362:b003:l031","ordinal":180217,"en":"He raised the gold-crescent banner;"},{"id":"semetey-1-2013:p1362:b003:l032","ordinal":180218,"en":"Your uncle Bakai made ready,"},{"id":"semetey-1-2013:p1362:b003:l033","ordinal":180219,"en":"Raising the cry, “Aziret!”"},{"id":"semetey-1-2013:p1362:b003:l034","ordinal":180220,"en":"A safeguard for his entrusted life,"},{"id":"semetey-1-2013:p1362:b003:l035","ordinal":180221,"en":"A gift from my sworn father Almambet—"},{"id":"semetey-1-2013:p1362:b003:l036","ordinal":180222,"en":"Tall and broad-shouldered,"},{"id":"semetey-1-2013:p1362:b003:l037","ordinal":180223,"en":"Both wrestler and warrior,"},{"id":"semetey-1-2013:p1362:b003:l038","ordinal":180224,"en":"Külchoro, son of Almambet,"}]
