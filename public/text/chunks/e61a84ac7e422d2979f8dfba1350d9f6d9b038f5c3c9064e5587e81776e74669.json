[{"id":"semetey-1-2013:p1112:b003:l010","ordinal":161025,"en":"If he does not come to this feast of mine,"},{"id":"semetey-1-2013:p1112:b003:l011","ordinal":161026,"en":"If he does not see these festivities,"},{"id":"semetey-1-2013:p1112:b003:l012","ordinal":161027,"en":"I will bear down from above"},{"id":"semetey-1-2013:p1112:b003:l013","ordinal":161028,"en":"On the Manchu who attacks you from above;"},{"id":"semetey-1-2013:p1112:b003:l014","ordinal":161029,"en":"I will overrun his city"},{"id":"semetey-1-2013:p1112:b003:l015","ordinal":161030,"en":"And scatter all four kinds of his livestock!"},{"id":"semetey-1-2013:p1112:b003:l016","ordinal":161031,"en":"When you travel farther on,"},{"id":"semetey-1-2013:p1112:b003:l017","ordinal":161032,"en":"There is the famous city of Kakanchyn."},{"id":"semetey-1-2013:p1112:b003:l018","ordinal":161033,"en":"In Kakanchyn there are khanly tribes,"},{"id":"semetey-1-2013:p1112:b003:l019","ordinal":161034,"en":"And many seething chiefs."},{"id":"semetey-1-2013:p1112:b003:l020","ordinal":161035,"en":"There are mines in the mountains where tea is gathered;"},{"id":"semetey-1-2013:p1112:b003:l021","ordinal":161036,"en":"Far-famed Beijing is a mighty realm."},{"id":"semetey-1-2013:p1112:b003:l022","ordinal":161037,"en":"There is a people called the Tyrgoot;"},{"id":"semetey-1-2013:p1112:b003:l023","ordinal":161038,"en":"Among the seething Chinese"},{"id":"semetey-1-2013:p1112:b003:l024","ordinal":161039,"en":"There are many kinds of souls."},{"id":"semetey-1-2013:p1112:b003:l025","ordinal":161040,"en":"Those infidel Tyrgoot"},{"id":"semetey-1-2013:p1112:b003:l026","ordinal":161041,"en":"Have a woman set up as their khan."},{"id":"semetey-1-2013:p1112:b003:l027","ordinal":161042,"en":"When that woman grows wrathful,"},{"id":"semetey-1-2013:p1112:b003:l028","ordinal":161043,"en":"If she chances to ride out to joust,"},{"id":"semetey-1-2013:p1112:b003:l029","ordinal":161044,"en":"She has the strength of nine thousand souls."},{"id":"semetey-1-2013:p1112:b003:l030","ordinal":161045,"en":"The woman's name is Kanyshay,"},{"id":"semetey-1-2013:p1112:b003:l031","ordinal":161046,"en":"A huge woman whose buttocks fill an embrace."},{"id":"semetey-1-2013:p1112:b003:l032","ordinal":161047,"en":"Her wrestling strength is immense,"},{"id":"semetey-1-2013:p1112:b003:l033","ordinal":161048,"en":"A peerless champion born a woman."},{"id":"semetey-1-2013:p1112:b003:l034","ordinal":161049,"en":"Her dwelling was a building set upon the steppe;"},{"id":"semetey-1-2013:p1112:b003:l035","ordinal":161050,"en":"Such was that woman's domain."},{"id":"semetey-1-2013:p1112:b003:l036","ordinal":161051,"en":"She became a mighty khan over the Tyrgoot;"},{"id":"semetey-1-2013:p1112:b003:l037","ordinal":161052,"en":"Seeking to seize her khanate,"},{"id":"semetey-1-2013:p1112:b003:l038","ordinal":161053,"en":"Many Chinese giants were laid low."},{"id":"semetey-1-2013:p1112:b003:l039","ordinal":161054,"en":"Her chosen husband is Muzkindik,"},{"id":"semetey-1-2013:p1112:b004:l001","ordinal":161055,"en":"Those who know him speak his name."},{"id":"semetey-1-2013:p1112:b004:l002","ordinal":161056,"en":"She is Muzkindik's wife;"},{"id":"semetey-1-2013:p1112:b004:l003","ordinal":161057,"en":"Reach her and deliver the message."},{"id":"semetey-1-2013:p1112:b004:l004","ordinal":161058,"en":"Say that the instant she hears,"},{"id":"semetey-1-2013:p1112:b004:l005","ordinal":161059,"en":"She must come to Kökötöy's memorial feast."},{"id":"semetey-1-2013:p1112:b004:l006","ordinal":161060,"en":"If she does not come the instant she hears,"},{"id":"semetey-1-2013:p1112:b004:l007","ordinal":161061,"en":"Say she will see Kökötöy's red banner"},{"id":"semetey-1-2013:p1112:b004:l008","ordinal":161062,"en":"Above her own dwelling."},{"id":"semetey-1-2013:p1112:b004:l009","ordinal":161063,"en":"Say it will utterly destroy"},{"id":"semetey-1-2013:p1112:b004:l010","ordinal":161064,"en":"And smoothly sweep away the Tyrgoot people!"},{"id":"semetey-1-2013:p1112:b004:l011","ordinal":161065,"en":"When you travel farther on,"},{"id":"semetey-1-2013:p1112:b004:l012","ordinal":161066,"en":"By the mines where gold is dug,"},{"id":"semetey-1-2013:p1112:b004:l013","ordinal":161067,"en":"On the banks of the Sary-Suu,"},{"id":"semetey-1-2013:p1112:b004:l014","ordinal":161068,"en":"The roaring Sary-Suu of Kürpüldök,"},{"id":"semetey-1-2013:p1112:b004:l015","ordinal":161069,"en":"Along the Sary-Suu,"},{"id":"semetey-1-2013:p1112:b004:l016","ordinal":161070,"en":"The looming monastery appears."},{"id":"semetey-1-2013:p1112:b004:l017","ordinal":161071,"en":"When you reach that monastery,"},{"id":"semetey-1-2013:p1112:b004:l018","ordinal":161072,"en":"There is the Chinese holy man"},{"id":"semetey-1-2013:p1112:b004:l019","ordinal":161073,"en":"With a red beard and a cap,"},{"id":"semetey-1-2013:p1112:b004:l020","ordinal":161074,"en":"Who never wears trousers"},{"id":"semetey-1-2013:p1112:b004:l021","ordinal":161075,"en":"And never squats to urinate."},{"id":"semetey-1-2013:p1112:b004:l022","ordinal":161076,"en":"In that monastery lives the kechil;"},{"id":"semetey-1-2013:p1112:b004:l023","ordinal":161077,"en":"Such is the kechil's custom:"},{"id":"semetey-1-2013:p1112:b004:l024","ordinal":161078,"en":"When his ox ages and he himself dies,"},{"id":"semetey-1-2013:p1112:b004:l025","ordinal":161079,"en":"It is the infidel's custom"},{"id":"semetey-1-2013:p1112:b004:l026","ordinal":161080,"en":"To divide the dead man's property equally."},{"id":"semetey-1-2013:p1112:b004:l027","ordinal":161081,"en":"He raises his billy goat as a sacred offering."},{"id":"semetey-1-2013:p1112:b004:l028","ordinal":161082,"en":"The horse he rides is holy;"},{"id":"semetey-1-2013:p1112:b004:l029","ordinal":161083,"en":"Taking no wife, the Lama"},{"id":"semetey-1-2013:p1112:b004:l030","ordinal":161084,"en":"Is a stranger to women."},{"id":"semetey-1-2013:p1112:b004:l031","ordinal":161085,"en":"He saddles his unbroken horse,"},{"id":"semetey-1-2013:p1112:b004:l032","ordinal":161086,"en":"Ties on his staff, saying “God,”"},{"id":"semetey-1-2013:p1112:b004:l033","ordinal":161087,"en":"And bows down to that very thing."},{"id":"semetey-1-2013:p1112:b004:l034","ordinal":161088,"en":"With a cotton sash and broad boots,"},{"id":"semetey-1-2013:p1112:b004:l035","ordinal":161089,"en":"An imposing peerless champion,"},{"id":"semetey-1-2013:p1112:b004:l036","ordinal":161090,"en":"Kongurbai is khan of the kechil."},{"id":"semetey-1-2013:p1112:b004:l037","ordinal":161091,"en":"Tell the most cunning of the spearmen,"},{"id":"semetey-1-2013:p1112:b004:l038","ordinal":161092,"en":"Tell the strongest man,"},{"id":"semetey-1-2013:p1112:b004:l039","ordinal":161093,"en":"The one who knows the enemy's stratagems."},{"id":"semetey-1-2013:p1112:b004:l040","ordinal":161094,"en":"Kökötöy's son Bokmurun—"},{"id":"semetey-1-2013:p1113:b003:l001","ordinal":161095,"en":"Say he has camped at Üch-Karkyra;"},{"id":"semetey-1-2013:p1113:b003:l002","ordinal":161096,"en":"If Kongurbai is a hero,"},{"id":"semetey-1-2013:p1113:b003:l003","ordinal":161097,"en":"Let him not miss this feast of mine,"},{"id":"semetey-1-2013:p1113:b003:l004","ordinal":161098,"en":"Nor, by failing to come,"},{"id":"semetey-1-2013:p1113:b003:l005","ordinal":161099,"en":"Bring harsh calamity upon his own head."},{"id":"semetey-1-2013:p1113:b003:l006","ordinal":161100,"en":"Say he must come to this feast of mine,"},{"id":"semetey-1-2013:p1113:b003:l007","ordinal":161101,"en":"And see these festivities."},{"id":"semetey-1-2013:p1113:b003:l008","ordinal":161102,"en":"If he does not come to this feast of mine,"},{"id":"semetey-1-2013:p1113:b003:l009","ordinal":161103,"en":"If he does not see these festivities,"},{"id":"semetey-1-2013:p1113:b003:l010","ordinal":161104,"en":"Say he will see the bloodthirsty Burut at the head"},{"id":"semetey-1-2013:p1113:b003:l011","ordinal":161105,"en":"Of a scene of devastation!"},{"id":"semetey-1-2013:p1113:b003:l012","ordinal":161106,"en":"When you travel farther on,"},{"id":"semetey-1-2013:p1113:b003:l013","ordinal":161107,"en":"There is the giant called Döödür Alp,"},{"id":"semetey-1-2013:p1113:b003:l014","ordinal":161108,"en":"Tiken Alp and Mungush Alp,"},{"id":"semetey-1-2013:p1113:b003:l015","ordinal":161109,"en":"And the great wrestler Tükübay,"},{"id":"semetey-1-2013:p1113:b003:l016","ordinal":161110,"en":"Grim of face and strong of venom,"},{"id":"semetey-1-2013:p1113:b003:l017","ordinal":161111,"en":"Who lays his opponents flat."},{"id":"semetey-1-2013:p1113:b003:l018","ordinal":161112,"en":"Tell all these giants.”"},{"id":"semetey-1-2013:p1113:b004:l001","ordinal":161113,"en":"Having spoken and arranged it thus, Bokmurun"},{"id":"semetey-1-2013:p1113:b004:l002","ordinal":161114,"en":"Had him mount Maaniker,"},{"id":"semetey-1-2013:p1113:b004:l003","ordinal":161115,"en":"Had him don a mail coat,"},{"id":"semetey-1-2013:p1113:b004:l004","ordinal":161116,"en":"And strike the Koroson fire-steel,"},{"id":"semetey-1-2013:p1113:b004:l005","ordinal":161117,"en":"Inviting every one,"},{"id":"semetey-1-2013:p1113:b004:l006","ordinal":161118,"en":"Infidel and Muslim alike."},{"id":"semetey-1-2013:p1113:b004:l007","ordinal":161119,"en":"Kökötöy's many royal yurts"},{"id":"semetey-1-2013:p1113:b004:l008","ordinal":161120,"en":"Were raised side by side in rows."},{"id":"semetey-1-2013:p1113:b004:l009","ordinal":161121,"en":"Kökötöy's son Bokmurun"},{"id":"semetey-1-2013:p1113:b004:l010","ordinal":161122,"en":"Made festivities for the ages."},{"id":"semetey-1-2013:p1113:b004:l011","ordinal":161123,"en":"When the great encampment"},{"id":"semetey-1-2013:p1113:b004:l012","ordinal":161124,"en":"Of wealthy Khan Kökötöy settled,"},{"id":"semetey-1-2013:p1113:b004:l013","ordinal":161125,"en":"When the people gathered and filled it,"},{"id":"semetey-1-2013:p1113:b004:l014","ordinal":161126,"en":"I saw Manas's bearing."},{"id":"semetey-1-2013:p1113:b004:l015","ordinal":161127,"en":"I saw the fierce, formidable might"},{"id":"semetey-1-2013:p1113:b004:l016","ordinal":161128,"en":"By which Manas surpassed all others."},{"id":"semetey-1-2013:p1113:b004:l017","ordinal":161129,"en":"I saw Manas stand as a barrier"},{"id":"semetey-1-2013:p1113:b004:l018","ordinal":161130,"en":"Protecting the Muslim people."},{"id":"semetey-1-2013:p1113:b006:l001","ordinal":161131,"en":"Kökötöy's son Bokmurun"},{"id":"semetey-1-2013:p1113:b006:l002","ordinal":161132,"en":"Made festivities for the people;"},{"id":"semetey-1-2013:p1113:b006:l003","ordinal":161133,"en":"Exulting that he would hold a feast,"},{"id":"semetey-1-2013:p1113:b006:l004","ordinal":161134,"en":"He cast the world into turmoil."},{"id":"semetey-1-2013:p1113:b006:l005","ordinal":161135,"en":"Traveling along the road"},{"id":"semetey-1-2013:p1113:b006:l006","ordinal":161136,"en":"My father, brave Bagysh, had ridden,"},{"id":"semetey-1-2013:p1113:b006:l007","ordinal":161137,"en":"When he went to Karkyra"},{"id":"semetey-1-2013:p1113:b006:l008","ordinal":161138,"en":"And the people were counted,"},{"id":"semetey-1-2013:p1113:b006:l009","ordinal":161139,"en":"He had an army of twelve thousand."},{"id":"semetey-1-2013:p1113:b006:l010","ordinal":161140,"en":"Zhортуулчу, riding Zhooruker,"},{"id":"semetey-1-2013:p1113:b006:l011","ordinal":161141,"en":"Came down along the road"},{"id":"semetey-1-2013:p1113:b006:l012","ordinal":161142,"en":"With many armies spread across the land."},{"id":"semetey-1-2013:p1113:b006:l013","ordinal":161143,"en":"Zhügörü, khan of Koton,"},{"id":"semetey-1-2013:p1113:b006:l014","ordinal":161144,"en":"Also came in a dense mass,"},{"id":"semetey-1-2013:p1113:b006:l015","ordinal":161145,"en":"Dust flying to the sky."},{"id":"semetey-1-2013:p1113:b006:l016","ordinal":161146,"en":"Akun Khan, khan of the Afghans,"},{"id":"semetey-1-2013:p1113:b006:l017","ordinal":161147,"en":"Came with tasseled spears fluttering,"},{"id":"semetey-1-2013:p1113:b008:l001","ordinal":161148,"en":"His great fur cap swaying."},{"id":"semetey-1-2013:p1113:b008:l002","ordinal":161149,"en":"The Afghans came along the road"},{"id":"semetey-1-2013:p1113:b008:l003","ordinal":161150,"en":"With an army of twelve thousand."},{"id":"semetey-1-2013:p1113:b008:l004","ordinal":161151,"en":"Dust came from the lands between;"},{"id":"semetey-1-2013:p1113:b008:l005","ordinal":161152,"en":"As if that were not enough,"},{"id":"semetey-1-2013:p1113:b008:l006","ordinal":161153,"en":"They also came from India."},{"id":"semetey-1-2013:p1113:b008:l007","ordinal":161154,"en":"With resident sheikhs and blue-clad khojas,"},{"id":"semetey-1-2013:p1113:b008:l008","ordinal":161155,"en":"From prominent Kokand and Margalan,"},{"id":"semetey-1-2013:p1113:b008:l009","ordinal":161156,"en":"His thoroughbred snorting,"},{"id":"semetey-1-2013:p1113:b008:l010","ordinal":161157,"en":"His mottled breast heaving,"},{"id":"semetey-1-2013:p1113:b008:l011","ordinal":161158,"en":"Came Synzhybek, fork-bearded lord of Andizhan."},{"id":"semetey-1-2013:p1113:b008:l012","ordinal":161159,"en":"They divided into varied companies,"},{"id":"semetey-1-2013:p1113:b008:l013","ordinal":161160,"en":"And looked grim in appearance."},{"id":"semetey-1-2013:p1113:b008:l014","ordinal":161161,"en":"Those who came had no sense;"},{"id":"semetey-1-2013:p1113:b008:l015","ordinal":161162,"en":"The white-nosed men of Andizhan,"},{"id":"semetey-1-2013:p1113:b008:l016","ordinal":161163,"en":"Their horses all stallions,"},{"id":"semetey-1-2013:p1113:b008:l017","ordinal":161164,"en":"Had no cruppers at all."},{"id":"semetey-1-2013:p1114:b003:l001","ordinal":161165,"en":"Sanchybek of Samarkand"},{"id":"semetey-1-2013:p1114:b003:l002","ordinal":161166,"en":"Also came along the road;"},{"id":"semetey-1-2013:p1114:b003:l003","ordinal":161167,"en":"He came rolling onward"},{"id":"semetey-1-2013:p1114:b003:l004","ordinal":161168,"en":"With an army of some ten thousand."},{"id":"semetey-1-2013:p1114:b003:l005","ordinal":161169,"en":"Biting their whips firmly,"},{"id":"semetey-1-2013:p1114:b003:l006","ordinal":161170,"en":"Urging on their lone horses,"},{"id":"semetey-1-2013:p1114:b003:l007","ordinal":161171,"en":"Kozubek of the Kokand khan,"},{"id":"semetey-1-2013:p1114:b003:l008","ordinal":161172,"en":"Malabek of Margalan,"},{"id":"semetey-1-2013:p1114:b003:l009","ordinal":161173,"en":"Alabek of the Six Cities,"},{"id":"semetey-1-2013:p1114:b003:l010","ordinal":161174,"en":"And Temirkhan, khan of Bukhara—"},{"id":"semetey-1-2013:p1114:b003:l011","ordinal":161175,"en":"From there came armies in abundance."},{"id":"semetey-1-2013:p1114:b003:l012","ordinal":161176,"en":"The armies of the four khans mingled,"},{"id":"semetey-1-2013:p1114:b003:l013","ordinal":161177,"en":"Coming together in great numbers."},{"id":"semetey-1-2013:p1114:b003:l014","ordinal":161178,"en":"An army of some twenty thousand came."},{"id":"semetey-1-2013:p1114:b003:l015","ordinal":161179,"en":"The four divided into four,"},{"id":"semetey-1-2013:p1114:b003:l016","ordinal":161180,"en":"Their princely bearing apparent."},{"id":"semetey-1-2013:p1114:b003:l017","ordinal":161181,"en":"Among those four"},{"id":"semetey-1-2013:p1114:b003:l018","ordinal":161182,"en":"Were khojas in motley robes"},{"id":"semetey-1-2013:p1114:b003:l019","ordinal":161183,"en":"And mullahs in white turbans."},{"id":"semetey-1-2013:p1114:b003:l020","ordinal":161184,"en":"They had great komuzes broad as an embrace"},{"id":"semetey-1-2013:p1114:b003:l021","ordinal":161185,"en":"And had their dutars played;"},{"id":"semetey-1-2013:p1114:b003:l022","ordinal":161186,"en":"They had some sixty young men"},{"id":"semetey-1-2013:p1114:b003:l023","ordinal":161187,"en":"Sing their akysh songs."},{"id":"semetey-1-2013:p1114:b003:l024","ordinal":161188,"en":"From beyond them,"},{"id":"semetey-1-2013:p1114:b003:l025","ordinal":161189,"en":"Turning toward the great din,"},{"id":"semetey-1-2013:p1114:b003:l026","ordinal":161190,"en":"Spears striking against spears,"},{"id":"semetey-1-2013:p1114:b003:l027","ordinal":161191,"en":"Those with spears growing excited,"},{"id":"semetey-1-2013:p1114:b003:l028","ordinal":161192,"en":"Those with battle-axes exulting,"},{"id":"semetey-1-2013:p1114:b003:l029","ordinal":161193,"en":"From the heights of Chambyl-Bel,"},{"id":"semetey-1-2013:p1114:b003:l030","ordinal":161194,"en":"From the banks of Belendi,"},{"id":"semetey-1-2013:p1114:b003:l031","ordinal":161195,"en":"Zhanaaly and Karachal came."},{"id":"semetey-1-2013:p1114:b003:l032","ordinal":161196,"en":"Calling it Khan Kökötöy's memorial feast,"},{"id":"semetey-1-2013:p1114:b003:l033","ordinal":161197,"en":"Calling it the brow of the great gathering,"},{"id":"semetey-1-2013:p1114:b003:l034","ordinal":161198,"en":"They came by the Kyzyl-Kyya road"},{"id":"semetey-1-2013:p1114:b003:l035","ordinal":161199,"en":"With an army numbering ten thousand."},{"id":"semetey-1-2013:p1114:b003:l036","ordinal":161200,"en":"From beyond them,"},{"id":"semetey-1-2013:p1114:b003:l037","ordinal":161201,"en":"Carrying an iron-rope net,"},{"id":"semetey-1-2013:p1114:b003:l038","ordinal":161202,"en":"Taking shelter like blue iron,"},{"id":"semetey-1-2013:p1114:b003:l039","ordinal":161203,"en":"Carrying a spear without a tassel,"},{"id":"semetey-1-2013:p1114:b004:l001","ordinal":161204,"en":"Riding the racehorse Kuu-Azyk,"},{"id":"semetey-1-2013:p1114:b004:l002","ordinal":161205,"en":"Its hair tail tied tight,"},{"id":"semetey-1-2013:p1114:b004:l003","ordinal":161206,"en":"Banner and spears rattling,"},{"id":"semetey-1-2013:p1114:b004:l004","ordinal":161207,"en":"Kökbörü came along the road"},{"id":"semetey-1-2013:p1114:b004:l005","ordinal":161208,"en":"With an army of some ten thousand."},{"id":"semetey-1-2013:p1114:b004:l006","ordinal":161209,"en":"From beyond them,"},{"id":"semetey-1-2013:p1114:b004:l007","ordinal":161210,"en":"The war drum deafening ears,"},{"id":"semetey-1-2013:p1114:b004:l008","ordinal":161211,"en":"Their polished spears made of sharp steel"},{"id":"semetey-1-2013:p1114:b004:l009","ordinal":161212,"en":"Thrust forward from every side,"},{"id":"semetey-1-2013:p1114:b004:l010","ordinal":161213,"en":"With an armful of weapons and gear,"},{"id":"semetey-1-2013:p1114:b004:l011","ordinal":161214,"en":"Riding a horse like Telkyzyl,"},{"id":"semetey-1-2013:p1114:b004:l012","ordinal":161215,"en":"Muzburchak, son of Buudayyk,"},{"id":"semetey-1-2013:p1114:b004:l013","ordinal":161216,"en":"From beyond the heights of Bukhara,"},{"id":"semetey-1-2013:p1114:b004:l014","ordinal":161217,"en":"From the ruined land of Chambyl,"},{"id":"semetey-1-2013:p1114:b004:l015","ordinal":161218,"en":"Saying he would go in ceremony"},{"id":"semetey-1-2013:p1114:b004:l016","ordinal":161219,"en":"To see Khan Kökötöy's great feast,"},{"id":"semetey-1-2013:p1114:b004:l017","ordinal":161220,"en":"Saying if the Black Chinese and Manchus fought,"},{"id":"semetey-1-2013:p1114:b004:l018","ordinal":161221,"en":"He would spill their blood,"},{"id":"semetey-1-2013:p1114:b004:l019","ordinal":161222,"en":"He too came down then"},{"id":"semetey-1-2013:p1114:b004:l020","ordinal":161223,"en":"Along the banks of Karkyra,"},{"id":"semetey-1-2013:p1114:b004:l021","ordinal":161224,"en":"To Khan Kökötöy's feast."},{"id":"semetey-1-2013:p1114:b004:l022","ordinal":161225,"en":"Crossing passes and treading stones,"},{"id":"semetey-1-2013:p1114:b004:l023","ordinal":161226,"en":"Hurrying in great agitation,"},{"id":"semetey-1-2013:p1114:b004:l024","ordinal":161227,"en":"From the land of the Lop River,"},{"id":"semetey-1-2013:p1114:b004:l025","ordinal":161228,"en":"From the Oygut people opposite,"},{"id":"semetey-1-2013:p1114:b004:l026","ordinal":161229,"en":"Carrying a gray-mottled banner,"},{"id":"semetey-1-2013:p1114:b004:l027","ordinal":161230,"en":"Raising a clamorous cry,"},{"id":"semetey-1-2013:p1114:b004:l028","ordinal":161231,"en":"Choosing a horse from among the thoroughbreds,"},{"id":"semetey-1-2013:p1114:b004:l029","ordinal":161232,"en":"Bearing a letter from young Aydar,"},{"id":"semetey-1-2013:p1114:b004:l030","ordinal":161233,"en":"Along the banks of Karkyra,"},{"id":"semetey-1-2013:p1114:b004:l031","ordinal":161234,"en":"To Khan Kökötöy's feast,"},{"id":"semetey-1-2013:p1114:b004:l032","ordinal":161235,"en":"Karacha came along the road"},{"id":"semetey-1-2013:p1114:b004:l033","ordinal":161236,"en":"With an army of some nine thousand."},{"id":"semetey-1-2013:p1114:b004:l034","ordinal":161237,"en":"If you look toward the qibla side,"},{"id":"semetey-1-2013:p1114:b004:l035","ordinal":161238,"en":"Brave Ürbü of Eybit Khan,"},{"id":"semetey-1-2013:p1114:b004:l036","ordinal":161239,"en":"Who knew many kinds of languages,"},{"id":"semetey-1-2013:p1114:b004:l037","ordinal":161240,"en":"With gathered good fortune,"},{"id":"semetey-1-2013:p1114:b004:l038","ordinal":161241,"en":"With a people assembled from many tribes,"},{"id":"semetey-1-2013:p1114:b004:l039","ordinal":161242,"en":"Along a road branching to the side—"},{"id":"semetey-1-2013:p1115:b003:l001","ordinal":161243,"en":"With an army of some six thousand,"},{"id":"semetey-1-2013:p1115:b003:l002","ordinal":161244,"en":"To Khan Kökötöy's memorial feast,"},{"id":"semetey-1-2013:p1115:b003:l003","ordinal":161245,"en":"To the edge of the great gathering,"},{"id":"semetey-1-2013:p1115:b003:l004","ordinal":161246,"en":"Ürbü came down along the road"},{"id":"semetey-1-2013:p1115:b003:l005","ordinal":161247,"en":"With an army of some six thousand."},{"id":"semetey-1-2013:p1115:b003:l006","ordinal":161248,"en":"From this side of them,"},{"id":"semetey-1-2013:p1115:b003:l007","ordinal":161249,"en":"Dwelling in Sary-Arka,"},{"id":"semetey-1-2013:p1115:b003:l008","ordinal":161250,"en":"Men called formidable and grave,"},{"id":"semetey-1-2013:p1115:b003:l009","ordinal":161251,"en":"Their horses splendid dun racers,"},{"id":"semetey-1-2013:p1115:b003:l010","ordinal":161252,"en":"With white blazes on their brows like amulets,"},{"id":"semetey-1-2013:p1115:b003:l011","ordinal":161253,"en":"All of them peerless thoroughbreds."},{"id":"semetey-1-2013:p1115:b003:l012","ordinal":161254,"en":"Their racehorses pranced and snorted;"},{"id":"semetey-1-2013:p1115:b003:l013","ordinal":161255,"en":"Their men were of another order,"},{"id":"semetey-1-2013:p1115:b003:l014","ordinal":161256,"en":"Their mottled breasts heaving."},{"id":"semetey-1-2013:p1115:b003:l015","ordinal":161257,"en":"Dust billowed overhead;"},{"id":"semetey-1-2013:p1115:b003:l016","ordinal":161258,"en":"The many Kazakhs of Aydarkhan"},{"id":"semetey-1-2013:p1115:b003:l017","ordinal":161259,"en":"Came shouting and singing ölöng songs."},{"id":"semetey-1-2013:p1115:b003:l018","ordinal":161260,"en":"Wearing a coat of blue iron,"},{"id":"semetey-1-2013:p1115:b003:l019","ordinal":161261,"en":"Kökchö, khan of the Kazakhs,"},{"id":"semetey-1-2013:p1115:b003:l020","ordinal":161262,"en":"Rode a blue-mottled racehorse,"},{"id":"semetey-1-2013:p1115:b003:l021","ordinal":161263,"en":"Waving a blue-mottled banner."},{"id":"semetey-1-2013:p1115:b003:l022","ordinal":161264,"en":"Kökchö came along the road"},{"id":"semetey-1-2013:p1115:b003:l023","ordinal":161265,"en":"With an army numbering forty thousand."},{"id":"semetey-1-2013:p1115:b003:l024","ordinal":161266,"en":"After the Muslim army arrived,"},{"id":"semetey-1-2013:p1115:b003:l025","ordinal":161267,"en":"Dust curled into the sky."},{"id":"semetey-1-2013:p1115:b003:l026","ordinal":161268,"en":"The Muslim army assembled,"},{"id":"semetey-1-2013:p1115:b003:l027","ordinal":161269,"en":"And set aside the old and aged livestock"},{"id":"semetey-1-2013:p1115:b003:l028","ordinal":161270,"en":"For the Kalmyks."},{"id":"semetey-1-2013:p1115:b003:l029","ordinal":161271,"en":"Hearth pits were hollowed out;"},{"id":"semetey-1-2013:p1115:b003:l030","ordinal":161272,"en":"Milk-fed camel calves and barren yearlings"},{"id":"semetey-1-2013:p1115:b003:l031","ordinal":161273,"en":"Were slaughtered for those who came."},{"id":"semetey-1-2013:p1115:b003:l032","ordinal":161274,"en":"The arrivals hastened about,"},{"id":"semetey-1-2013:p1115:b003:l033","ordinal":161275,"en":"And saying, “May a son be like this,”"},{"id":"semetey-1-2013:p1115:b003:l034","ordinal":161276,"en":"They bowed gratefully"},{"id":"semetey-1-2013:p1115:b003:l035","ordinal":161277,"en":"Before Kökötöy's son Bokmurun."},{"id":"semetey-1-2013:p1115:b003:l036","ordinal":161278,"en":"Alas, Kozho, my soul's friend,"},{"id":"semetey-1-2013:p1115:b003:l037","ordinal":161279,"en":"Those were the eyes that saw it;"},{"id":"semetey-1-2013:p1115:b003:l038","ordinal":161280,"en":"Those were the words that were spoken."}]
