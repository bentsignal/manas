[{"id":"sayakbay-ms-current145:pdf088:l011","ordinal":397313,"en":"The red-eyed one who came to that"},{"id":"sayakbay-ms-current145:pdf088:l012","ordinal":397314,"en":"Taking burden-bearers by the thousand"},{"id":"sayakbay-ms-current145:pdf088:l015","ordinal":397315,"en":"Joy filled him like milk"},{"id":"sayakbay-ms-current145:pdf088:l016","ordinal":397316,"en":"He became a hero to those who came"},{"id":"sayakbay-ms-current145:pdf088:l017","ordinal":397317,"en":"My sacred eyes found peace"},{"id":"sayakbay-ms-current145:pdf088:l021","ordinal":397318,"en":"To the peri-born Beybak"},{"id":"sayakbay-ms-current145:pdf088:l028","ordinal":397319,"en":"Her mouth opened in anguish"},{"id":"sayakbay-ms-current145:pdf088:l029","ordinal":397320,"en":"When the pain came, the earth groaned"},{"id":"sayakbay-ms-current145:pdf088:l030","ordinal":397321,"en":"Tears filled both eyes"},{"id":"sayakbay-ms-current145:pdf088:l031","ordinal":397322,"en":"Uzunkan fell into sorrow"},{"id":"sayakbay-ms-current145:pdf089:l002","ordinal":397323,"en":"Truly sobbing upon the ground"},{"id":"sayakbay-ms-current145:pdf089:l003","ordinal":397324,"en":"The messenger ran swiftly"},{"id":"sayakbay-ms-current145:pdf089:l006","ordinal":397325,"en":"Her cries carried toward Talas"},{"id":"sayakbay-ms-current145:pdf089:l008","ordinal":397326,"en":"Her dear soul was shaken"},{"id":"sayakbay-ms-current145:pdf089:l011","ordinal":397327,"en":"Her labor tightened"},{"id":"sayakbay-ms-current145:pdf089:l012","ordinal":397328,"en":"It bewildered her mind"},{"id":"sayakbay-ms-current145:pdf089:l013","ordinal":397329,"en":"Her elder’s throat went dry"},{"id":"sayakbay-ms-current145:pdf089:l015","ordinal":397330,"en":"From the agony and chill"},{"id":"sayakbay-ms-current145:pdf089:l016","ordinal":397331,"en":"The attendants seized her in distress"},{"id":"sayakbay-ms-current145:pdf089:l017","ordinal":397332,"en":"Weeping, they begged for help"},{"id":"sayakbay-ms-current145:pdf089:l018","ordinal":397333,"en":"Pleading to the Creator"},{"id":"sayakbay-ms-current145:pdf089:l019","ordinal":397334,"en":"Clinging to her tiny life"},{"id":"sayakbay-ms-current145:pdf089:l020","ordinal":397335,"en":"O Creator, one God"},{"id":"sayakbay-ms-current145:pdf089:l021","ordinal":397336,"en":"Grant aid to one lying in grievous sorrow"},{"id":"sayakbay-ms-current145:pdf089:l022","ordinal":397337,"en":"If her life ends, grant her faith"},{"id":"sayakbay-ms-current145:pdf089:l023","ordinal":397338,"en":"Coming and appearing before their eyes"},{"id":"sayakbay-ms-current145:pdf089:l024","ordinal":397339,"en":"Without stopping the blue roan"},{"id":"sayakbay-ms-current145:pdf089:l025","ordinal":397340,"en":"Do not torment her unto death"},{"id":"sayakbay-ms-current145:pdf089:l026","ordinal":397341,"en":"You brought this upon her in youth"},{"id":"sayakbay-ms-current145:pdf089:l027","ordinal":397342,"en":"She fell into fierce pain"},{"id":"sayakbay-ms-current145:pdf089:l028","ordinal":397343,"en":"O Creator of black and dappled things"},{"id":"sayakbay-ms-current145:pdf089:l029","ordinal":397344,"en":"Pleading to you alone"},{"id":"sayakbay-ms-current145:pdf089:l030","ordinal":397345,"en":"May there be light beyond her life"},{"id":"sayakbay-ms-current145:pdf089:l031","ordinal":397346,"en":"Her bones ache and sorrow grows"},{"id":"sayakbay-ms-current145:pdf089:l032","ordinal":397347,"en":"Her palate dried and her strength departed"},{"id":"sayakbay-ms-current145:pdf090:l001","ordinal":397348,"en":"Her whole flesh softened"},{"id":"sayakbay-ms-current145:pdf090:l002","ordinal":397349,"en":"Casting her into care and sorrow"},{"id":"sayakbay-ms-current145:pdf090:l003","ordinal":397350,"en":"The travail became plain to see"},{"id":"sayakbay-ms-current145:pdf090:l004","ordinal":397351,"en":"Could they cease making prayers"},{"id":"sayakbay-ms-current145:pdf090:l005","ordinal":397352,"en":"Her tongue formed its words"},{"id":"sayakbay-ms-current145:pdf090:l006","ordinal":397353,"en":"Care upon care divided her thoughts"},{"id":"sayakbay-ms-current145:pdf090:l007","ordinal":397354,"en":"The Uyghur gathered and took the standard"},{"id":"sayakbay-ms-current145:pdf090:l008","ordinal":397355,"en":"Her soul appeared to flutter"},{"id":"sayakbay-ms-current145:pdf090:l009","ordinal":397356,"en":"Her watching eyes filled with tears"},{"id":"sayakbay-ms-current145:pdf090:l010","ordinal":397357,"en":"Sickness gripped all who remained"},{"id":"sayakbay-ms-current145:pdf090:l011","ordinal":397358,"en":"Saying the living still have strength"},{"id":"sayakbay-ms-current145:pdf090:l012","ordinal":397359,"en":"What the Creator placed upon her"},{"id":"sayakbay-ms-current145:pdf090:l013","ordinal":397360,"en":"Let the people hear and know"},{"id":"sayakbay-ms-current145:pdf090:l014","ordinal":397361,"en":"So the other one spoke"},{"id":"sayakbay-ms-current145:pdf090:l015","ordinal":397362,"en":"The peri-born Beybak"},{"id":"sayakbay-ms-current145:pdf090:l016","ordinal":397363,"en":"All the people waited"},{"id":"sayakbay-ms-current145:pdf090:l017","ordinal":397364,"en":"In the narrowness of her pain"},{"id":"sayakbay-ms-current145:pdf090:l018","ordinal":397365,"en":"Appearing hateful to the eye"},{"id":"sayakbay-ms-current145:pdf090:l019","ordinal":397366,"en":"Tears flowed from dear eyes"},{"id":"sayakbay-ms-current145:pdf090:l020","ordinal":397367,"en":"Bloody, washing her collar"},{"id":"sayakbay-ms-current145:pdf090:l021","ordinal":397368,"en":"Crying fiercely, gripping her waist"},{"id":"sayakbay-ms-current145:pdf090:l022","ordinal":397369,"en":"Smoke curled from her mouth"},{"id":"sayakbay-ms-current145:pdf090:l023","ordinal":397370,"en":"From this fatherless world"},{"id":"sayakbay-ms-current145:pdf090:l024","ordinal":397371,"en":"She neared the point of not remaining"},{"id":"sayakbay-ms-current145:pdf090:l025","ordinal":397372,"en":"Those watching gathered around"},{"id":"sayakbay-ms-current145:pdf090:l026","ordinal":397373,"en":"Standing there without cease"},{"id":"sayakbay-ms-current145:pdf090:l027","ordinal":397374,"en":"Clinging to poles in anguish"},{"id":"sayakbay-ms-current145:pdf090:l028","ordinal":397375,"en":"This plea went to God"},{"id":"sayakbay-ms-current145:pdf090:l029","ordinal":397376,"en":"Pleading to him alone"},{"id":"sayakbay-ms-current145:pdf090:l030","ordinal":397377,"en":"Her prayer was her only remedy"},{"id":"sayakbay-ms-current145:pdf090:l031","ordinal":397378,"en":"The dear soul they had found"},{"id":"sayakbay-ms-current145:pdf090:l032","ordinal":397379,"en":"Truly lay there in travail"},{"id":"sayakbay-ms-current145:pdf090:l033","ordinal":397380,"en":"Giving strength to her tiny life"},{"id":"sayakbay-ms-current145:pdf091:l001","ordinal":397381,"en":"The poor soul was filled with worry,"},{"id":"sayakbay-ms-current145:pdf091:l002","ordinal":397382,"en":"The seventy-year-old dervish Kydyr,"},{"id":"sayakbay-ms-current145:pdf091:l003","ordinal":397383,"en":"Whose turban was as large as a cauldron,"},{"id":"sayakbay-ms-current145:pdf091:l004","ordinal":397384,"en":"Whose shout sounded like the call to prayer,"},{"id":"sayakbay-ms-current145:pdf091:l005","ordinal":397385,"en":"Taking charge of the matter,"},{"id":"sayakbay-ms-current145:pdf091:l006","ordinal":397386,"en":"He spoke, saying, “Do not grieve,”"},{"id":"sayakbay-ms-current145:pdf091:l007","ordinal":397387,"en":"Speaking of what he perceived in the child,"},{"id":"sayakbay-ms-current145:pdf091:l008","ordinal":397388,"en":"The dervish of ninety tribes,"},{"id":"sayakbay-ms-current145:pdf091:l009","ordinal":397389,"en":"Reciting sacred words four at a time,"},{"id":"sayakbay-ms-current145:pdf091:l010","ordinal":397390,"en":"When they looked, it was Kydyr himself,"},{"id":"sayakbay-ms-current145:pdf091:l011","ordinal":397391,"en":"For the unfortunate Perizaada,"},{"id":"sayakbay-ms-current145:pdf091:l012","ordinal":397392,"en":"The time had come for him to be a firm companion,"},{"id":"sayakbay-ms-current145:pdf091:l013","ordinal":397393,"en":"Her supporter was Kydyr himself,"},{"id":"sayakbay-ms-current145:pdf091:l014","ordinal":397394,"en":"A fortunate means and occasion,"},{"id":"sayakbay-ms-current145:pdf091:l015","ordinal":397395,"en":"The time had come to leave what was bestowed,"},{"id":"sayakbay-ms-current145:pdf091:l016","ordinal":397396,"en":"The unfortunate Perizaada,"},{"id":"sayakbay-ms-current145:pdf091:l017","ordinal":397397,"en":"If she did not stray from the path,"},{"id":"sayakbay-ms-current145:pdf091:l018","ordinal":397398,"en":"The time had come for her protector to depart,"},{"id":"sayakbay-ms-current145:pdf091:l019","ordinal":397399,"en":"Straining himself over the child,"},{"id":"sayakbay-ms-current145:pdf091:l020","ordinal":397400,"en":"The time had come to give his blessing;"},{"id":"sayakbay-ms-current145:pdf091:l021","ordinal":397401,"en":"Saying, “Repent, Bermet, repent,”"},{"id":"sayakbay-ms-current145:pdf091:l022","ordinal":397402,"en":"Entrusting himself to Providence,"},{"id":"sayakbay-ms-current145:pdf091:l023","ordinal":397403,"en":"For the unfortunate Kydyr, [?],"},{"id":"sayakbay-ms-current145:pdf091:l024","ordinal":397404,"en":"He named him [?],"},{"id":"sayakbay-ms-current145:pdf091:l025","ordinal":397405,"en":"His whole body tingling upward,"},{"id":"sayakbay-ms-current145:pdf091:l026","ordinal":397406,"en":"Hearing the suddenly uttered command,"},{"id":"sayakbay-ms-current145:pdf091:l027","ordinal":397407,"en":"A person without an elder brother—oh, elder sister,"},{"id":"sayakbay-ms-current145:pdf091:l028","ordinal":397408,"en":"This is the deed that remained from then."},{"id":"sayakbay-ms-current145:pdf091:l029","ordinal":397409,"en":"The transience of the world,"},{"id":"sayakbay-ms-current145:pdf091:l030","ordinal":397410,"en":"May he become a shield for the people,"},{"id":"sayakbay-ms-current145:pdf091:l031","ordinal":397411,"en":"You are the lamb of the Undying One,"},{"id":"sayakbay-ms-current145:pdf091:l032","ordinal":397412,"en":"Protecting the people when the multitude is thrown into turmoil,"},{"id":"sayakbay-ms-current145:pdf092:l001","ordinal":397413,"en":"A resounding voice came from the hero,"},{"id":"sayakbay-ms-current145:pdf092:l002","ordinal":397414,"en":"A sacred voice rang out,"},{"id":"sayakbay-ms-current145:pdf092:l003","ordinal":397415,"en":"Thus he spoke words about the child,"},{"id":"sayakbay-ms-current145:pdf092:l004","ordinal":397416,"en":"When they looked, he could not be seen,"},{"id":"sayakbay-ms-current145:pdf092:l005","ordinal":397417,"en":"No one knew where he was,"},{"id":"sayakbay-ms-current145:pdf092:l006","ordinal":397418,"en":"Kydyr had bestowed the name,"},{"id":"sayakbay-ms-current145:pdf092:l007","ordinal":397419,"en":"Their hearts ached, but he was gone,"},{"id":"sayakbay-ms-current145:pdf092:l008","ordinal":397420,"en":"The man who had spoken these words,"},{"id":"sayakbay-ms-current145:pdf092:l009","ordinal":397421,"en":"Had vanished from sight."},{"id":"sayakbay-ms-current145:pdf092:l010","ordinal":397422,"en":"Kydyr [?],"},{"id":"sayakbay-ms-current145:pdf092:l011","ordinal":397423,"en":"On the stirring Nights of Power,"},{"id":"sayakbay-ms-current145:pdf092:l012","ordinal":397424,"en":"The unfortunate Perizaada,"},{"id":"sayakbay-ms-current145:pdf092:l013","ordinal":397425,"en":"Rose suddenly to her feet,"},{"id":"sayakbay-ms-current145:pdf092:l014","ordinal":397426,"en":"Before one could say a word,"},{"id":"sayakbay-ms-current145:pdf092:l015","ordinal":397427,"en":"In the blink of an eye,"},{"id":"sayakbay-ms-current145:pdf092:l016","ordinal":397428,"en":"While she stood looking at her child,"},{"id":"sayakbay-ms-current145:pdf092:l017","ordinal":397429,"en":"He vanished from sight,"},{"id":"sayakbay-ms-current145:pdf092:l018","ordinal":397430,"en":"“As I see it, that is how it was.”"},{"id":"sayakbay-ms-current145:pdf092:l019","ordinal":397431,"en":"Giving Bermet a blessing,"},{"id":"sayakbay-ms-current145:pdf092:l020","ordinal":397432,"en":"The time had come for it to settle upon her;"},{"id":"sayakbay-ms-current145:pdf092:l021","ordinal":397433,"en":"Taking the radiant child,"},{"id":"sayakbay-ms-current145:pdf092:l025","ordinal":397434,"en":"At the very midpoint [?],"},{"id":"sayakbay-ms-current145:pdf092:l028","ordinal":397435,"en":"Kydyr parted from them for paradise,"},{"id":"sayakbay-ms-current145:pdf092:l029","ordinal":397436,"en":"Like dung [?],"},{"id":"sayakbay-ms-current145:pdf092:l030","ordinal":397437,"en":"Wondrous was the deed wrought by Kydyr,"},{"id":"sayakbay-ms-current145:pdf093:l001","ordinal":397438,"en":"Dismounting at Makooluk,"},{"id":"sayakbay-ms-current145:pdf093:l002","ordinal":397439,"en":"The sun shone overhead,"},{"id":"sayakbay-ms-current145:pdf093:l003","ordinal":397440,"en":"Day and night appeared bright,"},{"id":"sayakbay-ms-current145:pdf093:l004","ordinal":397441,"en":"The clouding of the sun vanished,"},{"id":"sayakbay-ms-current145:pdf093:l005","ordinal":397442,"en":"Then Zholtoi quickly saw,"},{"id":"sayakbay-ms-current145:pdf093:l008","ordinal":397443,"en":"The child descended, beaming,"},{"id":"sayakbay-ms-current145:pdf093:l009","ordinal":397444,"en":"Thundering as though struck with force,"},{"id":"sayakbay-ms-current145:pdf093:l012","ordinal":397445,"en":"The unmoving host of enemies,"},{"id":"sayakbay-ms-current145:pdf093:l022","ordinal":397446,"en":"“Distinct from all the others,”"},{"id":"sayakbay-ms-current145:pdf093:l023","ordinal":397447,"en":"“There is a fully formed son,”"},{"id":"sayakbay-ms-current145:pdf093:l032","ordinal":397448,"en":"Settle among the people made pale,"},{"id":"sayakbay-ms-current145:pdf093:l033","ordinal":397449,"en":"Settle among the clamoring people too,"},{"id":"sayakbay-ms-current145:pdf094:l001","ordinal":397450,"en":"While the child stood crying loudly,"},{"id":"sayakbay-ms-current145:pdf094:l002","ordinal":397451,"en":"The people entering the house saw him,"},{"id":"sayakbay-ms-current145:pdf094:l003","ordinal":397452,"en":"Twelve old women, because of the child,"},{"id":"sayakbay-ms-current145:pdf094:l004","ordinal":397453,"en":"Sat with their hearts overcome,"},{"id":"sayakbay-ms-current145:pdf094:l005","ordinal":397454,"en":"His young companions hurried,"},{"id":"sayakbay-ms-current145:pdf094:l006","ordinal":397455,"en":"The children gathered to play,"},{"id":"sayakbay-ms-current145:pdf094:l007","ordinal":397456,"en":"Many young women reached out their hands,"},{"id":"sayakbay-ms-current145:pdf094:l008","ordinal":397457,"en":"They fluttered about radiantly."},{"id":"sayakbay-ms-current145:pdf094:l011","ordinal":397458,"en":"Each cried out and spoke distinctly,"},{"id":"sayakbay-ms-current145:pdf094:l012","ordinal":397459,"en":"A song for springtime play,"},{"id":"sayakbay-ms-current145:pdf094:l013","ordinal":397460,"en":"The sovereign of campaigns and war,"},{"id":"sayakbay-ms-current145:pdf094:l016","ordinal":397461,"en":"Black waters came from many sides,"},{"id":"sayakbay-ms-current145:pdf094:l017","ordinal":397462,"en":"Dust rose as a lamb-flock moved,"},{"id":"sayakbay-ms-current145:pdf094:l019","ordinal":397463,"en":"For the rite of noble Alake,"},{"id":"sayakbay-ms-current145:pdf094:l021","ordinal":397464,"en":"And to the one upon that plain,"},{"id":"sayakbay-ms-current145:pdf094:l026","ordinal":397465,"en":"And went to the people of Kemin."},{"id":"sayakbay-ms-current145:pdf095:l001","ordinal":397466,"en":"Fashioned at the center of the earth"},{"id":"sayakbay-ms-current145:pdf095:l002","ordinal":397467,"en":"Today the appointed time had come"},{"id":"sayakbay-ms-current145:pdf095:l004","ordinal":397468,"en":"He was a warrior who roamed in struggle"},{"id":"sayakbay-ms-current145:pdf095:l005","ordinal":397469,"en":"His companion would be at his side"},{"id":"sayakbay-ms-current145:pdf095:l006","ordinal":397470,"en":"Now was the moment of sudden clangor"},{"id":"sayakbay-ms-current145:pdf095:l007","ordinal":397471,"en":"Saying, look beneath the earth"},{"id":"sayakbay-ms-current145:pdf095:l012","ordinal":397472,"en":"Hero Kenen stood gripping it"},{"id":"sayakbay-ms-current145:pdf095:l013","ordinal":397473,"en":"Ancient and true faith"},{"id":"sayakbay-ms-current145:pdf095:l017","ordinal":397474,"en":"This cry rang out"},{"id":"sayakbay-ms-current145:pdf095:l018","ordinal":397475,"en":"Black blood in his right hand"},{"id":"sayakbay-ms-current145:pdf095:l019","ordinal":397476,"en":"Shouting, he called upon the faith"},{"id":"sayakbay-ms-current145:pdf095:l020","ordinal":397477,"en":"His voice was heard by God"},{"id":"sayakbay-ms-current145:pdf095:l021","ordinal":397478,"en":"A soul who made wealth of the cauldron"},{"id":"sayakbay-ms-current145:pdf095:l022","ordinal":397479,"en":"Falling upon his breast"},{"id":"sayakbay-ms-current145:pdf095:l023","ordinal":397480,"en":"No bridle was placed upon another"},{"id":"sayakbay-ms-current145:pdf095:l024","ordinal":397481,"en":"Drive on, that child"},{"id":"sayakbay-ms-current145:pdf095:l025","ordinal":397482,"en":"As though to seize his face"},{"id":"sayakbay-ms-current145:pdf095:l026","ordinal":397483,"en":"The people screamed and the land stirred"},{"id":"sayakbay-ms-current145:pdf096:l008","ordinal":397484,"en":"His fortune rose from the young peak"},{"id":"sayakbay-ms-current145:pdf096:l011","ordinal":397485,"en":"What he said of the remaining time"},{"id":"sayakbay-ms-current145:pdf096:l014","ordinal":397486,"en":"Kenen’s majesty before the blue-clad people"},{"id":"sayakbay-ms-current145:pdf096:l018","ordinal":397487,"en":"When he spoke openly and fully"},{"id":"sayakbay-ms-current145:pdf096:l023","ordinal":397488,"en":"The valley’s moment had arrived"},{"id":"sayakbay-ms-current145:pdf096:l027","ordinal":397489,"en":"What he said of keeping his own secret"},{"id":"sayakbay-ms-current145:pdf096:l028","ordinal":397490,"en":"If it struck the evident stranger"},{"id":"sayakbay-ms-current145:pdf097:l002","ordinal":397491,"en":"Divine strength came to the banner"},{"id":"sayakbay-ms-current145:pdf097:l005","ordinal":397492,"en":"Making his birth a blessed seat of honor"},{"id":"sayakbay-ms-current145:pdf097:l006","ordinal":397493,"en":"Taking command of the people’s host"},{"id":"sayakbay-ms-current145:pdf097:l008","ordinal":397494,"en":"Kenen’s age would span much of the world"},{"id":"sayakbay-ms-current145:pdf097:l009","ordinal":397495,"en":"Saying God had given him to us"},{"id":"sayakbay-ms-current145:pdf097:l010","ordinal":397496,"en":"The people around the Amu"},{"id":"sayakbay-ms-current145:pdf097:l014","ordinal":397497,"en":"Smiling toward Perizada"},{"id":"sayakbay-ms-current145:pdf097:l016","ordinal":397498,"en":"When this companion of yours knew"},{"id":"sayakbay-ms-current145:pdf097:l017","ordinal":397499,"en":"The people’s questioning ended"},{"id":"sayakbay-ms-current145:pdf097:l018","ordinal":397500,"en":"A pouch was hung around his neck"},{"id":"sayakbay-ms-current145:pdf097:l019","ordinal":397501,"en":"So saying, they opened their hands in prayer"},{"id":"sayakbay-ms-current145:pdf097:l020","ordinal":397502,"en":"Pleading to the Creator"},{"id":"sayakbay-ms-current145:pdf097:l021","ordinal":397503,"en":"They held the feast under his rule"},{"id":"sayakbay-ms-current145:pdf097:l023","ordinal":397504,"en":"The people cried out and gathered"},{"id":"sayakbay-ms-current145:pdf097:l026","ordinal":397505,"en":"The people gathered around him"},{"id":"sayakbay-ms-current145:pdf097:l027","ordinal":397506,"en":"Shouting with a mighty roar"},{"id":"sayakbay-ms-current145:pdf097:l028","ordinal":397507,"en":"The people raised an immeasurable tumult"},{"id":"sayakbay-ms-current145:pdf097:l029","ordinal":397508,"en":"Paying no heed to their livestock"},{"id":"sayakbay-ms-current145:pdf097:l030","ordinal":397509,"en":"Slaughtering animals and piling meat"},{"id":"sayakbay-ms-current145:pdf097:l031","ordinal":397510,"en":"At the people’s center slaughtering gray stock"},{"id":"sayakbay-ms-current145:pdf098:l001","ordinal":397511,"en":"Heroes beyond counting"},{"id":"sayakbay-ms-current145:pdf098:l002","ordinal":397512,"en":"Two households moving as one"},{"id":"sayakbay-ms-current145:pdf098:l003","ordinal":397513,"en":"Slaughtering sheep for the contenders"},{"id":"sayakbay-ms-current145:pdf098:l004","ordinal":397514,"en":"Setting the people in order and holding a feast"},{"id":"sayakbay-ms-current145:pdf098:l005","ordinal":397515,"en":"The celebration grew vast"},{"id":"sayakbay-ms-current145:pdf098:l006","ordinal":397516,"en":"Kenen surged toward Kene"},{"id":"sayakbay-ms-current145:pdf098:l007","ordinal":397517,"en":"The arriving people gathered"},{"id":"sayakbay-ms-current145:pdf098:l008","ordinal":397518,"en":"Saying, may his son be a hero"},{"id":"sayakbay-ms-current145:pdf098:l009","ordinal":397519,"en":"They stood with hands raised"},{"id":"sayakbay-ms-current145:pdf098:l010","ordinal":397520,"en":"Cups upon cups of liquor"},{"id":"sayakbay-ms-current145:pdf098:l011","ordinal":397521,"en":"Saying, I am a warrior like you"},{"id":"sayakbay-ms-current145:pdf098:l012","ordinal":397522,"en":"They went about in celebration"},{"id":"sayakbay-ms-current145:pdf098:l013","ordinal":397523,"en":"The feast animals were slaughtered"},{"id":"sayakbay-ms-current145:pdf098:l014","ordinal":397524,"en":"The spoken consent was heard"},{"id":"sayakbay-ms-current145:pdf098:l015","ordinal":397525,"en":"Their old grudges were forgotten"},{"id":"sayakbay-ms-current145:pdf098:l016","ordinal":397526,"en":"Let no price be set above yours"},{"id":"sayakbay-ms-current145:pdf098:l017","ordinal":397527,"en":"Saying, go a little ahead"},{"id":"sayakbay-ms-current145:pdf098:l018","ordinal":397528,"en":"The sword shifted on his shoulder"},{"id":"sayakbay-ms-current145:pdf098:l019","ordinal":397529,"en":"Words flowed from the ground"},{"id":"sayakbay-ms-current145:pdf098:l020","ordinal":397530,"en":"Entering the tumult, they wrestled"},{"id":"sayakbay-ms-current145:pdf098:l021","ordinal":397531,"en":"A spectacle among the beasts"},{"id":"sayakbay-ms-current145:pdf098:l022","ordinal":397532,"en":"They plunged into the commotion"},{"id":"sayakbay-ms-current145:pdf098:l023","ordinal":397533,"en":"They joined in this talk"},{"id":"sayakbay-ms-current145:pdf098:l024","ordinal":397534,"en":"Knowing much without knowing all"},{"id":"sayakbay-ms-current145:pdf098:l025","ordinal":397535,"en":"They kept the words going"},{"id":"sayakbay-ms-current145:pdf098:l026","ordinal":397536,"en":"Companion Joltoy spoke"},{"id":"sayakbay-ms-current145:pdf098:l027","ordinal":397537,"en":"His two wishes were keen"},{"id":"sayakbay-ms-current145:pdf098:l028","ordinal":397538,"en":"They played the kok-boru game"},{"id":"sayakbay-ms-current145:pdf098:l029","ordinal":397539,"en":"Without lagging behind the colts"},{"id":"sayakbay-ms-current145:pdf098:l030","ordinal":397540,"en":"Testing themselves before the onlookers"},{"id":"sayakbay-ms-current145:pdf098:l031","ordinal":397541,"en":"Leading their swift hounds"},{"id":"sayakbay-ms-current145:pdf098:l032","ordinal":397542,"en":"The gray wolf spoke to the people"},{"id":"sayakbay-ms-current145:pdf099:l001","ordinal":397543,"en":"Driving back the raging ones"},{"id":"sayakbay-ms-current145:pdf099:l002","ordinal":397544,"en":"A thousand horses that had not gone out"},{"id":"sayakbay-ms-current145:pdf099:l003","ordinal":397545,"en":"Ninety red racers and camels"},{"id":"sayakbay-ms-current145:pdf099:l004","ordinal":397546,"en":"Loading them upon ninety camels"},{"id":"sayakbay-ms-current145:pdf099:l005","ordinal":397547,"en":"There was precious gold and ornament"},{"id":"sayakbay-ms-current145:pdf099:l006","ordinal":397548,"en":"There were amulets and clamor among the sheep"},{"id":"sayakbay-ms-current145:pdf099:l007","ordinal":397549,"en":"Take the world upon your fingertip"},{"id":"sayakbay-ms-current145:pdf099:l008","ordinal":397550,"en":"Fine posts for tethering horses"},{"id":"sayakbay-ms-current145:pdf099:l009","ordinal":397551,"en":"Fields for racing horses"},{"id":"sayakbay-ms-current145:pdf099:l010","ordinal":397552,"en":"Entrust livestock to livestock"},{"id":"sayakbay-ms-current145:pdf099:l011","ordinal":397553,"en":"Ride together and take my bird"},{"id":"sayakbay-ms-current145:pdf099:l012","ordinal":397554,"en":"Ask from land to land"},{"id":"sayakbay-ms-current145:pdf099:l013","ordinal":397555,"en":"As a father, raise the battle cry"},{"id":"sayakbay-ms-current145:pdf099:l014","ordinal":397556,"en":"Let your voice ring to the sky"},{"id":"sayakbay-ms-current145:pdf099:l015","ordinal":397557,"en":"A man turns back and freezes them"},{"id":"sayakbay-ms-current145:pdf099:l016","ordinal":397558,"en":"Such red kumys"},{"id":"sayakbay-ms-current145:pdf099:l017","ordinal":397559,"en":"I set camels by thousands and hundreds"},{"id":"sayakbay-ms-current145:pdf099:l018","ordinal":397560,"en":"After the Creator gave a child"},{"id":"sayakbay-ms-current145:pdf099:l019","ordinal":397561,"en":"I arrayed countless hosts equally"},{"id":"sayakbay-ms-current145:pdf099:l020","ordinal":397562,"en":"I set out herds abundant as spring"},{"id":"sayakbay-ms-current145:pdf099:l021","ordinal":397563,"en":"I offered abundant stock and worldly wealth"},{"id":"sayakbay-ms-current145:pdf099:l022","ordinal":397564,"en":"The people appointed Bermet"},{"id":"sayakbay-ms-current145:pdf099:l023","ordinal":397565,"en":"Making both humps stand high"},{"id":"sayakbay-ms-current145:pdf099:l024","ordinal":397566,"en":"Arching its neck like a duck"},{"id":"sayakbay-ms-current145:pdf099:l025","ordinal":397567,"en":"Choosing camels from the mountain"},{"id":"sayakbay-ms-current145:pdf099:l026","ordinal":397568,"en":"The greatest and finest among them"}]
