[{"id":"semetey-1-2013:p1210:b004:l027","ordinal":169473,"en":"Upon the black thigh never struck by a whip."},{"id":"semetey-1-2013:p1210:b004:l028","ordinal":169474,"en":"Its sheep-like flesh divided,"},{"id":"semetey-1-2013:p1210:b004:l029","ordinal":169475,"en":"And its back straightened like a hare's;"},{"id":"semetey-1-2013:p1210:b004:l030","ordinal":169476,"en":"Its foal-like flesh stood out,"},{"id":"semetey-1-2013:p1210:b004:l031","ordinal":169477,"en":"And its coat smoothed like a sighthound's."},{"id":"semetey-1-2013:p1210:b004:l032","ordinal":169478,"en":"Its cavernous mouth opened;"},{"id":"semetey-1-2013:p1210:b004:l033","ordinal":169479,"en":"Its contracted hooves"},{"id":"semetey-1-2013:p1210:b004:l034","ordinal":169480,"en":"Spread as broad as great platters."},{"id":"semetey-1-2013:p1210:b004:l035","ordinal":169481,"en":"White foam mixed with blood"},{"id":"semetey-1-2013:p1210:b004:l036","ordinal":169482,"en":"Splashed upon its chest."},{"id":"semetey-1-2013:p1210:b004:l037","ordinal":169483,"en":"Beneath the clouded sky,"},{"id":"semetey-1-2013:p1210:b004:l038","ordinal":169484,"en":"Over the rippling grass,"},{"id":"semetey-1-2013:p1210:b004:l039","ordinal":169485,"en":"It now flew away with a roar."},{"id":"semetey-1-2013:p1211:b003:l001","ordinal":169486,"en":"The earth split in shimmering waves;"},{"id":"semetey-1-2013:p1211:b003:l002","ordinal":169487,"en":"Khan Joloy's Achbuudan"},{"id":"semetey-1-2013:p1211:b003:l003","ordinal":169488,"en":"Came in hard at Akkula's heels."},{"id":"semetey-1-2013:p1211:b003:l004","ordinal":169489,"en":"The forelock of Maaniker—"},{"id":"semetey-1-2013:p1211:b003:l005","ordinal":169490,"en":"It was steeped in ill fortune;"},{"id":"semetey-1-2013:p1211:b003:l006","ordinal":169491,"en":"For the tulpar driven in a race,"},{"id":"semetey-1-2013:p1211:b003:l007","ordinal":169492,"en":"There was no prize ahead."},{"id":"semetey-1-2013:p1211:b003:l008","ordinal":169493,"en":"For not racing Maaniker,"},{"id":"semetey-1-2013:p1211:b003:l009","ordinal":169494,"en":"Bokmurun of Kökötöy"},{"id":"semetey-1-2013:p1211:b003:l010","ordinal":169495,"en":"Had no sense at all."},{"id":"semetey-1-2013:p1211:b003:l011","ordinal":169496,"en":"See the ants, see the worms;"},{"id":"semetey-1-2013:p1211:b003:l012","ordinal":169497,"en":"The people like swarming Chinese worms"},{"id":"semetey-1-2013:p1211:b003:l013","ordinal":169498,"en":"Had gone to urge on the horses."},{"id":"semetey-1-2013:p1211:b003:l014","ordinal":169499,"en":"When one looked, nothing met the eye;"},{"id":"semetey-1-2013:p1211:b003:l015","ordinal":169500,"en":"Soil flew and dust burned,"},{"id":"semetey-1-2013:p1211:b003:l016","ordinal":169501,"en":"The sky clear but the earth overcast,"},{"id":"semetey-1-2013:p1211:b003:l017","ordinal":169502,"en":"And no one could tell which was which."},{"id":"semetey-1-2013:p1211:b003:l018","ordinal":169503,"en":"They were exceptional chargers—"},{"id":"semetey-1-2013:p1211:b003:l019","ordinal":169504,"en":"Akkula and Achbuudan,"},{"id":"semetey-1-2013:p1211:b003:l020","ordinal":169505,"en":"As alike as rabbits."},{"id":"semetey-1-2013:p1211:b003:l021","ordinal":169506,"en":"Among the Black Chinese and Manchus,"},{"id":"semetey-1-2013:p1211:b003:l022","ordinal":169507,"en":"Just as Akkula was about to be caught,"},{"id":"semetey-1-2013:p1211:b003:l023","ordinal":169508,"en":"When Khan Kongurbai was coming,"},{"id":"semetey-1-2013:p1211:b003:l024","ordinal":169509,"en":"When he was about to see Akkula,"},{"id":"semetey-1-2013:p1211:b003:l025","ordinal":169510,"en":"When turmoil was about to break,"},{"id":"semetey-1-2013:p1211:b003:l026","ordinal":169511,"en":"When Achbuudan was about to kick and fling him,"},{"id":"semetey-1-2013:p1211:b003:l027","ordinal":169512,"en":"Dear lion Almam, the falcon,"},{"id":"semetey-1-2013:p1211:b003:l028","ordinal":169513,"en":"With pearl otogot and coral stones"},{"id":"semetey-1-2013:p1211:b003:l029","ordinal":169514,"en":"Glittering on his head,"},{"id":"semetey-1-2013:p1211:b003:l030","ordinal":169515,"en":"Gathering himself like a blue tiger,"},{"id":"semetey-1-2013:p1211:b003:l031","ordinal":169516,"en":"Donned Chinese clothing."},{"id":"semetey-1-2013:p1211:b003:l032","ordinal":169517,"en":"Elder Ala turned toward the people;"},{"id":"semetey-1-2013:p1211:b003:l033","ordinal":169518,"en":"His ancestor Chylaba"},{"id":"semetey-1-2013:p1211:b003:l034","ordinal":169519,"en":"Had left a great emblem there:"},{"id":"semetey-1-2013:p1211:b003:l035","ordinal":169520,"en":"The tail of a parrot,"},{"id":"semetey-1-2013:p1211:b003:l036","ordinal":169521,"en":"Worked in nine colors."},{"id":"semetey-1-2013:p1211:b003:l037","ordinal":169522,"en":"Seething like the Chinese,"},{"id":"semetey-1-2013:p1211:b003:l038","ordinal":169523,"en":"Roaring in wrath,"},{"id":"semetey-1-2013:p1211:b003:l039","ordinal":169524,"en":"He raised the khagan's battle cry."},{"id":"semetey-1-2013:p1211:b005:l001","ordinal":169525,"en":"Khan Manas's Akkula—"},{"id":"semetey-1-2013:p1211:b005:l002","ordinal":169526,"en":"He urged it on with the khagan's cry."},{"id":"semetey-1-2013:p1211:b005:l003","ordinal":169527,"en":"Pearl otogot and coral stones,"},{"id":"semetey-1-2013:p1211:b005:l004","ordinal":169528,"en":"Together with the khan of the Zungars,"},{"id":"semetey-1-2013:p1211:b005:l005","ordinal":169529,"en":"All the great Chinese host,"},{"id":"semetey-1-2013:p1211:b005:l006","ordinal":169530,"en":"When they saw elder Ala,"},{"id":"semetey-1-2013:p1211:b005:l007","ordinal":169531,"en":"Thinking him one of their famous khans,"},{"id":"semetey-1-2013:p1211:b005:l008","ordinal":169532,"en":"Urged without restraint."},{"id":"semetey-1-2013:p1211:b005:l009","ordinal":169533,"en":"They raised a great shout."},{"id":"semetey-1-2013:p1211:b005:l010","ordinal":169534,"en":"The Chinese people shouted together"},{"id":"semetey-1-2013:p1211:b005:l011","ordinal":169535,"en":"And entered the tumult."},{"id":"semetey-1-2013:p1211:b005:l012","ordinal":169536,"en":"Fiercely urging the kula horse,"},{"id":"semetey-1-2013:p1211:b005:l013","ordinal":169537,"en":"They entered the clamor."},{"id":"semetey-1-2013:p1211:b005:l014","ordinal":169538,"en":"Deceived by Almambet,"},{"id":"semetey-1-2013:p1211:b005:l015","ordinal":169539,"en":"They entered the uproar."},{"id":"semetey-1-2013:p1211:b005:l016","ordinal":169540,"en":"Into a haze no man could see through,"},{"id":"semetey-1-2013:p1211:b005:l017","ordinal":169541,"en":"They plunged amid the dust."},{"id":"semetey-1-2013:p1211:b005:l018","ordinal":169542,"en":"Alman broke away from the Chinese"},{"id":"semetey-1-2013:p1211:b005:l019","ordinal":169543,"en":"And appeared among the Kalmaks."},{"id":"semetey-1-2013:p1211:b005:l020","ordinal":169544,"en":"When he reached the Kalmaks,"},{"id":"semetey-1-2013:p1211:b005:l021","ordinal":169545,"en":"He raised the Kalmak urging cry."},{"id":"semetey-1-2013:p1211:b005:l022","ordinal":169546,"en":"Champion lion Almam"},{"id":"semetey-1-2013:p1211:b005:l023","ordinal":169547,"en":"Sent his horse down the slope"},{"id":"semetey-1-2013:p1211:b005:l024","ordinal":169548,"en":"And took up the cry of “Möndü!”"},{"id":"semetey-1-2013:p1211:b005:l025","ordinal":169549,"en":"The Sarala beneath him—"},{"id":"semetey-1-2013:p1211:b005:l026","ordinal":169550,"en":"He whipped it right and left,"},{"id":"semetey-1-2013:p1211:b005:l027","ordinal":169551,"en":"And spurred from both sides."},{"id":"semetey-1-2013:p1211:b005:l028","ordinal":169552,"en":"He was a khan of the Black Kalmaks,"},{"id":"semetey-1-2013:p1211:b005:l029","ordinal":169553,"en":"One who donned the khan's attire;"},{"id":"semetey-1-2013:p1211:b005:l030","ordinal":169554,"en":"Wearing a Kaldai coat,"},{"id":"semetey-1-2013:p1211:b005:l031","ordinal":169555,"en":"“Möndü, möndü, möndü!” he cried,"},{"id":"semetey-1-2013:p1211:b005:l032","ordinal":169556,"en":"Urging them with the Möndü cry."},{"id":"semetey-1-2013:p1211:b005:l033","ordinal":169557,"en":"“Jaghy, jaghy, jaghy!” he cried,"},{"id":"semetey-1-2013:p1211:b005:l034","ordinal":169558,"en":"Urging them with the Jaghy cry."},{"id":"semetey-1-2013:p1211:b005:l035","ordinal":169559,"en":"The many glittering Kalmaks"},{"id":"semetey-1-2013:p1211:b005:l036","ordinal":169560,"en":"Now urged on together."},{"id":"semetey-1-2013:p1211:b005:l037","ordinal":169561,"en":"The Kalmaks came thundering,"},{"id":"semetey-1-2013:p1211:b005:l038","ordinal":169562,"en":"Their hair streaming behind them."},{"id":"semetey-1-2013:p1211:b005:l039","ordinal":169563,"en":"While lion Almam lived,"},{"id":"semetey-1-2013:p1212:b003:l001","ordinal":169564,"en":"He deceived the Kalmaks while urging the horse."},{"id":"semetey-1-2013:p1212:b003:l002","ordinal":169565,"en":"While champion Almam lived,"},{"id":"semetey-1-2013:p1212:b003:l003","ordinal":169566,"en":"He deceived the Chinese while urging the horse."},{"id":"semetey-1-2013:p1212:b003:l004","ordinal":169567,"en":"The seething multitude"},{"id":"semetey-1-2013:p1212:b003:l005","ordinal":169568,"en":"Entered among the Solon."},{"id":"semetey-1-2013:p1212:b003:l006","ordinal":169569,"en":"He raised the Solon battle cry"},{"id":"semetey-1-2013:p1212:b003:l007","ordinal":169570,"en":"And urged past the Solon;"},{"id":"semetey-1-2013:p1212:b003:l008","ordinal":169571,"en":"He raised the Shivei battle cry"},{"id":"semetey-1-2013:p1212:b003:l009","ordinal":169572,"en":"And now urged past the Shivei."},{"id":"semetey-1-2013:p1212:b003:l010","ordinal":169573,"en":"While champion Almam lived,"},{"id":"semetey-1-2013:p1212:b003:l011","ordinal":169574,"en":"He truly carried out a difficult stratagem."},{"id":"semetey-1-2013:p1212:b003:l012","ordinal":169575,"en":"Failing to recognize Akkula,"},{"id":"semetey-1-2013:p1212:b003:l013","ordinal":169576,"en":"He threw the Chinese into confusion."},{"id":"semetey-1-2013:p1212:b003:l014","ordinal":169577,"en":"The heroism"},{"id":"semetey-1-2013:p1212:b003:l015","ordinal":169578,"en":"Of valiant gray wolf Almam became known."},{"id":"semetey-1-2013:p1212:b003:l016","ordinal":169579,"en":"As he went farther on,"},{"id":"semetey-1-2013:p1212:b003:l017","ordinal":169580,"en":"He reached the people of Islam."},{"id":"semetey-1-2013:p1212:b003:l018","ordinal":169581,"en":"Khan Manas's forty companions"},{"id":"semetey-1-2013:p1212:b003:l019","ordinal":169582,"en":"Now remained shouting encouragement in ruin."},{"id":"semetey-1-2013:p1212:b003:l020","ordinal":169583,"en":"This creature Akkula"},{"id":"semetey-1-2013:p1212:b003:l021","ordinal":169584,"en":"Had lowered his head to the ground."},{"id":"semetey-1-2013:p1212:b003:l022","ordinal":169585,"en":"The forty companions who urged him on"},{"id":"semetey-1-2013:p1212:b003:l023","ordinal":169586,"en":"Failed to see"},{"id":"semetey-1-2013:p1212:b003:l024","ordinal":169587,"en":"That Akkula had broken away."},{"id":"semetey-1-2013:p1212:b003:l025","ordinal":169588,"en":"They did not notice Akkula leaving."},{"id":"semetey-1-2013:p1212:b003:l026","ordinal":169589,"en":"Let us leave that there"},{"id":"semetey-1-2013:p1212:b003:l027","ordinal":169590,"en":"And begin the tale"},{"id":"semetey-1-2013:p1212:b003:l028","ordinal":169591,"en":"Of the open-hearted noble lion."},{"id":"semetey-1-2013:p1212:b003:l029","ordinal":169592,"en":"Upon Aybanboz, streaming along,"},{"id":"semetey-1-2013:p1212:b003:l030","ordinal":169593,"en":"Noble lion Manas"},{"id":"semetey-1-2013:p1212:b003:l031","ordinal":169594,"en":"Had entered the clamor."},{"id":"semetey-1-2013:p1212:b003:l032","ordinal":169595,"en":"Making his gray horse leap,"},{"id":"semetey-1-2013:p1212:b003:l033","ordinal":169596,"en":"Hero lion Manas,"},{"id":"semetey-1-2013:p1212:b003:l034","ordinal":169597,"en":"Within that tumult,"},{"id":"semetey-1-2013:p1212:b003:l035","ordinal":169598,"en":"Caught sight of Achbuudan."},{"id":"semetey-1-2013:p1212:b003:l036","ordinal":169599,"en":"The lion raged;"},{"id":"semetey-1-2013:p1212:b003:l037","ordinal":169600,"en":"His eyes blazed like fire,"},{"id":"semetey-1-2013:p1212:b003:l038","ordinal":169601,"en":"His anguish smoked fiercely,"},{"id":"semetey-1-2013:p1212:b003:l039","ordinal":169602,"en":"And bloodlust seized him."},{"id":"semetey-1-2013:p1212:b004:l001","ordinal":169603,"en":"Hero Joloy's Achbuudan"},{"id":"semetey-1-2013:p1212:b004:l002","ordinal":169604,"en":"Ran out in front;"},{"id":"semetey-1-2013:p1212:b004:l003","ordinal":169605,"en":"How could it be left behind?"},{"id":"semetey-1-2013:p1212:b004:l004","ordinal":169606,"en":"Kökötöy's countless prizes—"},{"id":"semetey-1-2013:p1212:b004:l005","ordinal":169607,"en":"How could the Black Kalmaks and Manchus"},{"id":"semetey-1-2013:p1212:b004:l006","ordinal":169608,"en":"Be allowed to take them?"},{"id":"semetey-1-2013:p1212:b004:l007","ordinal":169609,"en":"Rather than give the prize to China,"},{"id":"semetey-1-2013:p1212:b004:l008","ordinal":169610,"en":"Let us die and cease living;"},{"id":"semetey-1-2013:p1212:b004:l009","ordinal":169611,"en":"Let us sink away as though unborn."},{"id":"semetey-1-2013:p1212:b004:l010","ordinal":169612,"en":"Akkula, raced with honor,"},{"id":"semetey-1-2013:p1212:b004:l011","ordinal":169613,"en":"That gliding creature fit for slaughter,"},{"id":"semetey-1-2013:p1212:b004:l012","ordinal":169614,"en":"Was a beast unlike other horses;"},{"id":"semetey-1-2013:p1212:b004:l013","ordinal":169615,"en":"Kökötöy's red banner—"},{"id":"semetey-1-2013:p1212:b004:l014","ordinal":169616,"en":"This year was the time for him to win it."},{"id":"semetey-1-2013:p1212:b004:l015","ordinal":169617,"en":"Were his fetlocks only a handspan,"},{"id":"semetey-1-2013:p1212:b004:l016","ordinal":169618,"en":"Had he become a frog?"},{"id":"semetey-1-2013:p1212:b004:l017","ordinal":169619,"en":"Were his heels only a handspan,"},{"id":"semetey-1-2013:p1212:b004:l018","ordinal":169620,"en":"Had he become a pig?"},{"id":"semetey-1-2013:p1212:b004:l019","ordinal":169621,"en":"Yesterday, when we fled from Altai,"},{"id":"semetey-1-2013:p1212:b004:l020","ordinal":169622,"en":"When I scattered my countless wealth,"},{"id":"semetey-1-2013:p1212:b004:l021","ordinal":169623,"en":"Against the Black Kalmak people,"},{"id":"semetey-1-2013:p1212:b004:l022","ordinal":169624,"en":"Lying on opposite banks,"},{"id":"semetey-1-2013:p1212:b004:l023","ordinal":169625,"en":"Exchanging musket fire,"},{"id":"semetey-1-2013:p1212:b004:l024","ordinal":169626,"en":"Waging fierce battle,"},{"id":"semetey-1-2013:p1212:b004:l025","ordinal":169627,"en":"When Toruchaar fell to a bullet,"},{"id":"semetey-1-2013:p1212:b004:l026","ordinal":169628,"en":"When the great Chinese and Manchu host"},{"id":"semetey-1-2013:p1212:b004:l027","ordinal":169629,"en":"Surged upon us and brought turmoil,"},{"id":"semetey-1-2013:p1212:b004:l028","ordinal":169630,"en":"When Toruchaar was shot down"},{"id":"semetey-1-2013:p1212:b004:l029","ordinal":169631,"en":"And I was left looming on foot,"},{"id":"semetey-1-2013:p1212:b004:l030","ordinal":169632,"en":"Khan Koshoy of Katagan"},{"id":"semetey-1-2013:p1212:b004:l031","ordinal":169633,"en":"Gave Telkyzyl as a gift."},{"id":"semetey-1-2013:p1212:b004:l032","ordinal":169634,"en":"When I mounted Telkyzyl,"},{"id":"semetey-1-2013:p1212:b004:l033","ordinal":169635,"en":"No tulpar could match him;"},{"id":"semetey-1-2013:p1212:b004:l034","ordinal":169636,"en":"To preserve my life,"},{"id":"semetey-1-2013:p1212:b004:l035","ordinal":169637,"en":"Stars were eclipsed in the sky,"},{"id":"semetey-1-2013:p1212:b004:l036","ordinal":169638,"en":"The saintly spirits supported me,"},{"id":"semetey-1-2013:p1212:b004:l037","ordinal":169639,"en":"And from the Black Chinese and Manchus"},{"id":"semetey-1-2013:p1212:b004:l038","ordinal":169640,"en":"I barely escaped alive,"},{"id":"semetey-1-2013:p1212:b004:l039","ordinal":169641,"en":"To raid the Kyzylbash,"},{"id":"semetey-1-2013:p1213:b003:l001","ordinal":169642,"en":"When they set out on campaign,"},{"id":"semetey-1-2013:p1213:b003:l002","ordinal":169643,"en":"In the desert of Mediyan,"},{"id":"semetey-1-2013:p1213:b003:l003","ordinal":169644,"en":"It appeared from the unseen,"},{"id":"semetey-1-2013:p1213:b003:l004","ordinal":169645,"en":"Found upon the open steppe."},{"id":"semetey-1-2013:p1213:b003:l005","ordinal":169646,"en":"When Akkula was honored with a feast,"},{"id":"semetey-1-2013:p1213:b003:l006","ordinal":169647,"en":"Ninety mares were slaughtered;"},{"id":"semetey-1-2013:p1213:b003:l007","ordinal":169648,"en":"The name Akkula was given him."},{"id":"semetey-1-2013:p1213:b003:l008","ordinal":169649,"en":"This year was the time"},{"id":"semetey-1-2013:p1213:b003:l009","ordinal":169650,"en":"For him to lower his head and run,"},{"id":"semetey-1-2013:p1213:b003:l010","ordinal":169651,"en":"The time to win"},{"id":"semetey-1-2013:p1213:b003:l011","ordinal":169652,"en":"Kökötöi’s grand prize."},{"id":"semetey-1-2013:p1213:b003:l012","ordinal":169653,"en":"After Akkula fell behind,"},{"id":"semetey-1-2013:p1213:b003:l013","ordinal":169654,"en":"What was I to do when this infidel’s Achbuudan"},{"id":"semetey-1-2013:p1213:b003:l014","ordinal":169655,"en":"Surged to the front?"},{"id":"semetey-1-2013:p1213:b003:l015","ordinal":169656,"en":"Before he could get away,"},{"id":"semetey-1-2013:p1213:b003:l016","ordinal":169657,"en":"If strength allowed, I would reach his end."},{"id":"semetey-1-2013:p1213:b003:l017","ordinal":169658,"en":"Lion Manas flared up,"},{"id":"semetey-1-2013:p1213:b003:l018","ordinal":169659,"en":"Raging in fury,"},{"id":"semetey-1-2013:p1213:b003:l019","ordinal":169660,"en":"Buckled on the gray kise,"},{"id":"semetey-1-2013:p1213:b003:l020","ordinal":169661,"en":"And struck Aibanboz once."},{"id":"semetey-1-2013:p1213:b003:l021","ordinal":169662,"en":"When Khan Manas came from below,"},{"id":"semetey-1-2013:p1213:b003:l022","ordinal":169663,"en":"He charged from the flank,"},{"id":"semetey-1-2013:p1213:b003:l023","ordinal":169664,"en":"Aiming below the ribs,"},{"id":"semetey-1-2013:p1213:b003:l024","ordinal":169665,"en":"At the edge of the kidney."},{"id":"semetey-1-2013:p1213:b003:l025","ordinal":169666,"en":"Charging in fury,"},{"id":"semetey-1-2013:p1213:b003:l026","ordinal":169667,"en":"Khan Manas kicked Achbuudan"},{"id":"semetey-1-2013:p1213:b003:l027","ordinal":169668,"en":"Across the flank."},{"id":"semetey-1-2013:p1213:b003:l028","ordinal":169669,"en":"The creature that came surging,"},{"id":"semetey-1-2013:p1213:b003:l029","ordinal":169670,"en":"When Manas struck in force,"},{"id":"semetey-1-2013:p1213:b003:l030","ordinal":169671,"en":"Stumbled away."},{"id":"semetey-1-2013:p1213:b003:l031","ordinal":169672,"en":"Three rows in succession"},{"id":"semetey-1-2013:p1213:b003:l032","ordinal":169673,"en":"He knocked aside as he fell."},{"id":"semetey-1-2013:p1213:b003:l033","ordinal":169674,"en":"Manas strained in fury;"},{"id":"semetey-1-2013:p1213:b003:l034","ordinal":169675,"en":"The place where Achbuudan fell"},{"id":"semetey-1-2013:p1213:b003:l035","ordinal":169676,"en":"From that day to this"},{"id":"semetey-1-2013:p1213:b003:l036","ordinal":169677,"en":"Became known as Ak-Zhar."},{"id":"semetey-1-2013:p1213:b003:l037","ordinal":169678,"en":"As Achbuudan lay fallen,"},{"id":"semetey-1-2013:p1213:b003:l038","ordinal":169679,"en":"Kongurbai took advantage—"},{"id":"semetey-1-2013:p1213:b003:l039","ordinal":169680,"en":"Now God struck him."},{"id":"semetey-1-2013:p1213:b004:l001","ordinal":169681,"en":"His accursed Algara—"},{"id":"semetey-1-2013:p1213:b004:l002","ordinal":169682,"en":"No living soul could match its blink;"},{"id":"semetey-1-2013:p1213:b004:l003","ordinal":169683,"en":"Unless it were a flying crow,"},{"id":"semetey-1-2013:p1213:b004:l004","ordinal":169684,"en":"No four-footed creature could match it."},{"id":"semetey-1-2013:p1213:b004:l005","ordinal":169685,"en":"Achbuudan, lying fallen,"},{"id":"semetey-1-2013:p1213:b004:l006","ordinal":169686,"en":"Now saw the accursed horse."},{"id":"semetey-1-2013:p1213:b004:l007","ordinal":169687,"en":"As though black doom had struck his wife,"},{"id":"semetey-1-2013:p1213:b004:l008","ordinal":169688,"en":"Kongurbai grew furious."},{"id":"semetey-1-2013:p1213:b004:l009","ordinal":169689,"en":"“The many prizes gathered by the people—"},{"id":"semetey-1-2013:p1213:b004:l010","ordinal":169690,"en":"Why should I not take them?"},{"id":"semetey-1-2013:p1213:b004:l011","ordinal":169691,"en":"If they do not give me that prize,"},{"id":"semetey-1-2013:p1213:b004:l012","ordinal":169692,"en":"Why should I not bring upon"},{"id":"semetey-1-2013:p1213:b004:l013","ordinal":169693,"en":"The accursed Burut"},{"id":"semetey-1-2013:p1213:b004:l014","ordinal":169694,"en":"A slaughter no man wishes to see?”"},{"id":"semetey-1-2013:p1213:b004:l015","ordinal":169695,"en":"Speaking thus, Kongurbai"},{"id":"semetey-1-2013:p1213:b004:l016","ordinal":169696,"en":"Roared in fury;"},{"id":"semetey-1-2013:p1213:b004:l017","ordinal":169697,"en":"At the Kalcha’s might,"},{"id":"semetey-1-2013:p1213:b004:l018","ordinal":169698,"en":"The earth broke and thundered."},{"id":"semetey-1-2013:p1213:b004:l019","ordinal":169699,"en":"At the Kalcha’s might,"},{"id":"semetey-1-2013:p1213:b004:l020","ordinal":169700,"en":"The many Chinese and Manchus"},{"id":"semetey-1-2013:p1213:b004:l021","ordinal":169701,"en":"Split open with a crash."},{"id":"semetey-1-2013:p1213:b004:l022","ordinal":169702,"en":"Algara beneath him"},{"id":"semetey-1-2013:p1213:b004:l023","ordinal":169703,"en":"Was a true tulpar, a wondrous beast;"},{"id":"semetey-1-2013:p1213:b004:l024","ordinal":169704,"en":"The mighty Kalcha, a powerful hero,"},{"id":"semetey-1-2013:p1213:b004:l025","ordinal":169705,"en":"Now raised a shout."},{"id":"semetey-1-2013:p1213:b004:l026","ordinal":169706,"en":"Before one could say a word,"},{"id":"semetey-1-2013:p1213:b004:l027","ordinal":169707,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p1213:b004:l028","ordinal":169708,"en":"The loop-knotted reins"},{"id":"semetey-1-2013:p1213:b004:l029","ordinal":169709,"en":"He pressed against its belly."},{"id":"semetey-1-2013:p1213:b004:l030","ordinal":169710,"en":"Trained upon level ground,"},{"id":"semetey-1-2013:p1213:b004:l031","ordinal":169711,"en":"He had mastered the stallion,"},{"id":"semetey-1-2013:p1213:b004:l032","ordinal":169712,"en":"Dragging others like a cap."},{"id":"semetey-1-2013:p1213:b004:l033","ordinal":169713,"en":"Making it plunge downward,"},{"id":"semetey-1-2013:p1213:b004:l034","ordinal":169714,"en":"Sending it flying like tumbleweed,"},{"id":"semetey-1-2013:p1213:b004:l035","ordinal":169715,"en":"Kongurbai, son of Alööke,"},{"id":"semetey-1-2013:p1213:b004:l036","ordinal":169716,"en":"Dragged along"},{"id":"semetey-1-2013:p1213:b004:l037","ordinal":169717,"en":"Hero Zholoi’s stallion with immense force."},{"id":"semetey-1-2013:p1213:b004:l038","ordinal":169718,"en":"He had trained it on level ground;"},{"id":"semetey-1-2013:p1213:b004:l039","ordinal":169719,"en":"Kongurbai, the peerless wrestler,"},{"id":"semetey-1-2013:p1214:b003:l001","ordinal":169720,"en":"Dragged it like a cap."},{"id":"semetey-1-2013:p1214:b003:l002","ordinal":169721,"en":"He had trained it on slopes;"},{"id":"semetey-1-2013:p1214:b003:l003","ordinal":169722,"en":"On descending ground Kongurbai"},{"id":"semetey-1-2013:p1214:b003:l004","ordinal":169723,"en":"Dragged it like tumbleweed."},{"id":"semetey-1-2013:p1214:b003:l005","ordinal":169724,"en":"When one stallion urged another,"},{"id":"semetey-1-2013:p1214:b003:l006","ordinal":169725,"en":"It ran without turning, shimmering like a mirage;"},{"id":"semetey-1-2013:p1214:b003:l007","ordinal":169726,"en":"Behind the leader, Achbuudan"},{"id":"semetey-1-2013:p1214:b003:l008","ordinal":169727,"en":"Was now drawing close."},{"id":"semetey-1-2013:p1214:b003:l009","ordinal":169728,"en":"Kulatai, tiny as a young tick,"}]
