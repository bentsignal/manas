[{"id":"seytek-1991-continuation:p0341:b003:l043","ordinal":386817,"en":"On the head of the fully armed infidel,"},{"id":"seytek-1991-continuation:p0341:b003:l044","ordinal":386818,"en":"The hero Khan Odukan."},{"id":"seytek-1991-continuation:p0341:b003:l045","ordinal":386819,"en":"He thrust and sent the shield flying."},{"id":"seytek-1991-continuation:p0341:b003:l046","ordinal":386820,"en":"The peerless champion Jeljetpes"},{"id":"seytek-1991-continuation:p0341:b003:l047","ordinal":386821,"en":"Had his axe bound in leather,"},{"id":"seytek-1991-continuation:p0341:b003:l048","ordinal":386822,"en":"Its handle fitted with twisted gold;"},{"id":"seytek-1991-continuation:p0341:b003:l049","ordinal":386823,"en":"When laid on grass, it started a fire,"},{"id":"seytek-1991-continuation:p0342:b001:l001","ordinal":386824,"en":"When swung, its head blazed like an ember."},{"id":"seytek-1991-continuation:p0342:b001:l002","ordinal":386825,"en":"When he swung it in fury,"},{"id":"seytek-1991-continuation:p0342:b001:l003","ordinal":386826,"en":"It never rested without drinking blood."},{"id":"seytek-1991-continuation:p0342:b001:l004","ordinal":386827,"en":"Its edge glowed red with fire;"},{"id":"seytek-1991-continuation:p0342:b001:l005","ordinal":386828,"en":"Though its handle was rather short,"},{"id":"seytek-1991-continuation:p0342:b001:l006","ordinal":386829,"en":"When he swung it in fury"},{"id":"seytek-1991-continuation:p0342:b001:l007","ordinal":386830,"en":"It lengthened to a full fathom."},{"id":"seytek-1991-continuation:p0342:b001:l008","ordinal":386831,"en":"Those who saw its wrath panicked;"},{"id":"seytek-1991-continuation:p0342:b001:l009","ordinal":386832,"en":"Those who heard its name grieved."},{"id":"seytek-1991-continuation:p0342:b001:l010","ordinal":386833,"en":"Any stubborn enemy who faced it"},{"id":"seytek-1991-continuation:p0342:b001:l011","ordinal":386834,"en":"Despaired of his dark life."},{"id":"seytek-1991-continuation:p0342:b001:l012","ordinal":386835,"en":"He seized the blood-spilling axe,"},{"id":"seytek-1991-continuation:p0342:b001:l013","ordinal":386836,"en":"Whirled it around,"},{"id":"seytek-1991-continuation:p0342:b001:l014","ordinal":386837,"en":"And strained forward with both hands."},{"id":"seytek-1991-continuation:p0342:b001:l015","ordinal":386838,"en":"At Odukan, huge as a mountain,"},{"id":"seytek-1991-continuation:p0342:b001:l016","ordinal":386839,"en":"The infidel of matchless strength,"},{"id":"seytek-1991-continuation:p0342:b001:l017","ordinal":386840,"en":"The hero never sated with blood,"},{"id":"seytek-1991-continuation:p0342:b001:l018","ordinal":386841,"en":"Calling him the accursed one,"},{"id":"seytek-1991-continuation:p0342:b001:l019","ordinal":386842,"en":"Taking the dark pupil as his measure,"},{"id":"seytek-1991-continuation:p0342:b001:l020","ordinal":386843,"en":"And the crown of the head as his mark,"},{"id":"seytek-1991-continuation:p0342:b001:l021","ordinal":386844,"en":"He aimed carefully and struck,"},{"id":"seytek-1991-continuation:p0342:b001:l022","ordinal":386845,"en":"Swinging with perfect accuracy."},{"id":"seytek-1991-continuation:p0342:b001:l023","ordinal":386846,"en":"When it struck, Odu was no more;"},{"id":"seytek-1991-continuation:p0342:b001:l024","ordinal":386847,"en":"The poison-tempered battle-axe"},{"id":"seytek-1991-continuation:p0342:b001:l025","ordinal":386848,"en":"Sank in to its socket."},{"id":"seytek-1991-continuation:p0342:b001:l026","ordinal":386849,"en":"When the axe struck Odu,"},{"id":"seytek-1991-continuation:p0342:b001:l027","ordinal":386850,"en":"His cry was heard in the sky,"},{"id":"seytek-1991-continuation:p0342:b001:l028","ordinal":386851,"en":"And he fell embracing the earth."},{"id":"seytek-1991-continuation:p0342:b001:l029","ordinal":386852,"en":"His head plunged into a hollow;"},{"id":"seytek-1991-continuation:p0342:b001:l030","ordinal":386853,"en":"Dust and soil"},{"id":"seytek-1991-continuation:p0342:b001:l031","ordinal":386854,"en":"Choked his mouth and nose,"},{"id":"seytek-1991-continuation:p0342:b001:l032","ordinal":386855,"en":"And no fly-like breath remained."},{"id":"seytek-1991-continuation:p0342:b001:l033","ordinal":386856,"en":"When Odukan and Choyun had died,"},{"id":"seytek-1991-continuation:p0342:b001:l034","ordinal":386857,"en":"Their warriors of every kind,"},{"id":"seytek-1991-continuation:p0342:b001:l035","ordinal":386858,"en":"Their foremost rabble,"},{"id":"seytek-1991-continuation:p0342:b001:l036","ordinal":386859,"en":"Strong mounted and on foot,"},{"id":"seytek-1991-continuation:p0342:b001:l037","ordinal":386860,"en":"Their racers unsurpassed in the world,"},{"id":"seytek-1991-continuation:p0342:b001:l038","ordinal":386861,"en":"Commanders over tens,"},{"id":"seytek-1991-continuation:p0342:b001:l039","ordinal":386862,"en":"Champions over thousands,"},{"id":"seytek-1991-continuation:p0342:b001:l040","ordinal":386863,"en":"Their Kaldays and stone-hearted men,"},{"id":"seytek-1991-continuation:p0342:b001:l041","ordinal":386864,"en":"All rushed in with an uproar,"},{"id":"seytek-1991-continuation:p0342:b001:l042","ordinal":386865,"en":"Their spears held firmly forward."},{"id":"seytek-1991-continuation:p0342:b001:l043","ordinal":386866,"en":"The earth split into dust;"},{"id":"seytek-1991-continuation:p0342:b001:l044","ordinal":386867,"en":"The ground became a pit that trapped feet."},{"id":"seytek-1991-continuation:p0342:b001:l045","ordinal":386868,"en":"The vast army surged in,"},{"id":"seytek-1991-continuation:p0342:b001:l046","ordinal":386869,"en":"And boundless misery boiled over."},{"id":"seytek-1991-continuation:p0342:b001:l047","ordinal":386870,"en":"As the Chinese closed around them,"},{"id":"seytek-1991-continuation:p0342:b001:l048","ordinal":386871,"en":"When oppression and violent calamity"},{"id":"seytek-1991-continuation:p0342:b001:l049","ordinal":386872,"en":"Were about to descend upon their heads,"},{"id":"seytek-1991-continuation:p0342:b003:l001","ordinal":386873,"en":"Calling them fugitives from China,"},{"id":"seytek-1991-continuation:p0342:b003:l002","ordinal":386874,"en":"When they were about to hang them by the elbows,"},{"id":"seytek-1991-continuation:p0342:b003:l003","ordinal":386875,"en":"Cut reins from their backs,"},{"id":"seytek-1991-continuation:p0342:b003:l004","ordinal":386876,"en":"Pierce them through from the saddle,"},{"id":"seytek-1991-continuation:p0342:b003:l005","ordinal":386877,"en":"And hang them dangling"},{"id":"seytek-1991-continuation:p0342:b003:l006","ordinal":386878,"en":"From the end of a tree,"},{"id":"seytek-1991-continuation:p0342:b003:l007","ordinal":386879,"en":"Truly tormenting their souls,"},{"id":"seytek-1991-continuation:p0342:b003:l008","ordinal":386880,"en":"The exceedingly resourceful Ebegey"},{"id":"seytek-1991-continuation:p0342:b003:l009","ordinal":386881,"en":"Mounted Jeljetpes"},{"id":"seytek-1991-continuation:p0342:b003:l010","ordinal":386882,"en":"On the rhinoceros he had drawn near,"},{"id":"seytek-1991-continuation:p0342:b003:l011","ordinal":386883,"en":"Reviving the life that was about to die."},{"id":"seytek-1991-continuation:p0342:b003:l012","ordinal":386884,"en":"He showed the loyalty"},{"id":"seytek-1991-continuation:p0342:b003:l013","ordinal":386885,"en":"Of a wise peer and comrade."},{"id":"seytek-1991-continuation:p0342:b003:l014","ordinal":386886,"en":"Though caught by the woeful army,"},{"id":"seytek-1991-continuation:p0342:b003:l015","ordinal":386887,"en":"Er Jeljetpes escaped."},{"id":"seytek-1991-continuation:p0342:b003:l016","ordinal":386888,"en":"He turned the rhinoceros's head,"},{"id":"seytek-1991-continuation:p0342:b003:l017","ordinal":386889,"en":"Called up the Cloud Horse,"},{"id":"seytek-1991-continuation:p0342:b003:l018","ordinal":386890,"en":"And conjured weather in midsummer."},{"id":"seytek-1991-continuation:p0342:b003:l019","ordinal":386891,"en":"Gorges flew and cliffs collapsed;"},{"id":"seytek-1991-continuation:p0342:b003:l020","ordinal":386892,"en":"He devastated the broad land"},{"id":"seytek-1991-continuation:p0342:b003:l021","ordinal":386893,"en":"And revealed his sorcery."},{"id":"seytek-1991-continuation:p0342:b004:l001","ordinal":386894,"en":"Fog rose from the hollows;"},{"id":"seytek-1991-continuation:p0342:b005:l001","ordinal":386895,"en":"Clouds covered the mountains."},{"id":"seytek-1991-continuation:p0342:b005:l002","ordinal":386896,"en":"Over foothill, slope, and plain,"},{"id":"seytek-1991-continuation:p0342:b005:l003","ordinal":386897,"en":"Black banks of mist divided."},{"id":"seytek-1991-continuation:p0342:b005:l004","ordinal":386898,"en":"Looking toward the sky,"},{"id":"seytek-1991-continuation:p0342:b005:l005","ordinal":386899,"en":"One saw hail pour down in six streams."},{"id":"seytek-1991-continuation:p0342:b005:l006","ordinal":386900,"en":"Across hills, knolls, and ravines,"},{"id":"seytek-1991-continuation:p0342:b005:l007","ordinal":386901,"en":"It smashed and swept away all traces,"},{"id":"seytek-1991-continuation:p0342:b005:l008","ordinal":386902,"en":"And choked the level uplands."},{"id":"seytek-1991-continuation:p0342:b005:l009","ordinal":386903,"en":"Beasts and living creatures"},{"id":"seytek-1991-continuation:p0342:b005:l010","ordinal":386904,"en":"Were disturbed and destroyed."},{"id":"seytek-1991-continuation:p0342:b005:l011","ordinal":386905,"en":"The army gathered with frantic cries;"},{"id":"seytek-1991-continuation:p0342:b005:l012","ordinal":386906,"en":"Ravens croaked and perished."},{"id":"seytek-1991-continuation:p0342:b005:l013","ordinal":386907,"en":"Wild asses fled and escaped;"},{"id":"seytek-1991-continuation:p0342:b005:l014","ordinal":386908,"en":"Creatures that entered their dens"},{"id":"seytek-1991-continuation:p0342:b005:l015","ordinal":386909,"en":"Survived without dying,"},{"id":"seytek-1991-continuation:p0342:b005:l016","ordinal":386910,"en":"While animals above the earth"},{"id":"seytek-1991-continuation:p0342:b005:l017","ordinal":386911,"en":"Were all seized by death."},{"id":"seytek-1991-continuation:p0342:b005:l018","ordinal":386912,"en":"He loosed a storm of extraordinary force."},{"id":"seytek-1991-continuation:p0342:b005:l019","ordinal":386913,"en":"Along slopes, gullies, and cliffs,"},{"id":"seytek-1991-continuation:p0342:b005:l020","ordinal":386914,"en":"Bare rocks fell and streamed down,"},{"id":"seytek-1991-continuation:p0342:b005:l021","ordinal":386915,"en":"Carrying away at their edge"},{"id":"seytek-1991-continuation:p0342:b005:l022","ordinal":386916,"en":"The seething Chinese host."},{"id":"seytek-1991-continuation:p0342:b005:l023","ordinal":386917,"en":"He unleashed the weather without measure,"},{"id":"seytek-1991-continuation:p0342:b005:l024","ordinal":386918,"en":"Blinding eyes and binding hands,"},{"id":"seytek-1991-continuation:p0342:b005:l025","ordinal":386919,"en":"Plainly barring the road."},{"id":"seytek-1991-continuation:p0342:b005:l026","ordinal":386920,"en":"Jeljetpes, who had seen much,"},{"id":"seytek-1991-continuation:p0342:b005:l027","ordinal":386921,"en":"Was an invincible sorcerer."},{"id":"seytek-1991-continuation:p0343:b001:l001","ordinal":386922,"en":"Thus he cast his spell,"},{"id":"seytek-1991-continuation:p0343:b001:l002","ordinal":386923,"en":"Blocking the road"},{"id":"seytek-1991-continuation:p0343:b001:l003","ordinal":386924,"en":"Of the surging infidels,"},{"id":"seytek-1991-continuation:p0343:b001:l004","ordinal":386925,"en":"Turning aside the arrow"},{"id":"seytek-1991-continuation:p0343:b001:l005","ordinal":386926,"en":"Of the overwhelming, fatal calamity,"},{"id":"seytek-1991-continuation:p0343:b001:l006","ordinal":386927,"en":"And barring the very heart"},{"id":"seytek-1991-continuation:p0343:b001:l007","ordinal":386928,"en":"Of the fiercely raging disaster."},{"id":"seytek-1991-continuation:p0343:b001:l008","ordinal":386929,"en":"Looking through the mingled dust,"},{"id":"seytek-1991-continuation:p0343:b001:l009","ordinal":386930,"en":"Longing for his people to be safe,"},{"id":"seytek-1991-continuation:p0343:b001:l010","ordinal":386931,"en":"His fly-like life cried out;"},{"id":"seytek-1991-continuation:p0343:b001:l011","ordinal":386932,"en":"Every bone cracked."},{"id":"seytek-1991-continuation:p0343:b001:l012","ordinal":386933,"en":"His whole body was covered in blood;"},{"id":"seytek-1991-continuation:p0343:b001:l013","ordinal":386934,"en":"The two hands that had served him"},{"id":"seytek-1991-continuation:p0343:b001:l014","ordinal":386935,"en":"Would not rise and were paralyzed."},{"id":"seytek-1991-continuation:p0343:b001:l015","ordinal":386936,"en":"His precious head, dear in life,"},{"id":"seytek-1991-continuation:p0343:b001:l016","ordinal":386937,"en":"Was a red bucket of blood."},{"id":"seytek-1991-continuation:p0343:b001:l017","ordinal":386938,"en":"The broad world narrowed;"},{"id":"seytek-1991-continuation:p0343:b001:l018","ordinal":386939,"en":"Even saliva, life's sustenance,"},{"id":"seytek-1991-continuation:p0343:b001:l019","ordinal":386940,"en":"Was too hard for him to swallow."},{"id":"seytek-1991-continuation:p0343:b001:l020","ordinal":386941,"en":"His unbending back bent,"},{"id":"seytek-1991-continuation:p0343:b001:l021","ordinal":386942,"en":"And he despaired of his precious life."},{"id":"seytek-1991-continuation:p0343:b001:l022","ordinal":386943,"en":"The cold lasso, death's bullet,"},{"id":"seytek-1991-continuation:p0343:b001:l023","ordinal":386944,"en":"Was loaded and poised above his head."},{"id":"seytek-1991-continuation:p0343:b001:l024","ordinal":386945,"en":"His fly-like soul cried out;"},{"id":"seytek-1991-continuation:p0343:b001:l025","ordinal":386946,"en":"All his flesh and bones"},{"id":"seytek-1991-continuation:p0343:b001:l026","ordinal":386947,"en":"Cracked and crumbled to powder."},{"id":"seytek-1991-continuation:p0343:b001:l027","ordinal":386948,"en":"Ebegey fought on,"},{"id":"seytek-1991-continuation:p0343:b001:l028","ordinal":386949,"en":"For many days and many nights,"},{"id":"seytek-1991-continuation:p0343:b001:l029","ordinal":386950,"en":"Standing there in fury."},{"id":"seytek-1991-continuation:p0343:b001:l030","ordinal":386951,"en":"In Yengkor's sight,"},{"id":"seytek-1991-continuation:p0343:b001:l031","ordinal":386952,"en":"Ebegey's ribs"},{"id":"seytek-1991-continuation:p0343:b001:l032","ordinal":386953,"en":"Appeared faintly through the haze."},{"id":"seytek-1991-continuation:p0343:b001:l033","ordinal":386954,"en":"An ember as large as a yurt glowed at the match;"},{"id":"seytek-1991-continuation:p0343:b001:l034","ordinal":386955,"en":"There was no other infidel like him in the world."},{"id":"seytek-1991-continuation:p0343:b001:l035","ordinal":386956,"en":"He brought the gold-trimmed sight"},{"id":"seytek-1991-continuation:p0343:b001:l036","ordinal":386957,"en":"Up to his glass-like eye,"},{"id":"seytek-1991-continuation:p0343:b001:l037","ordinal":386958,"en":"Then pulled and fired."},{"id":"seytek-1991-continuation:p0343:b001:l038","ordinal":386959,"en":"The gun boomed and cracked;"},{"id":"seytek-1991-continuation:p0343:b001:l039","ordinal":386960,"en":"“Lie there, wretched Burut!” he said."},{"id":"seytek-1991-continuation:p0343:b001:l040","ordinal":386961,"en":"From the edge of the ribs,"},{"id":"seytek-1991-continuation:p0343:b001:l041","ordinal":386962,"en":"From the very front of the lung,"},{"id":"seytek-1991-continuation:p0343:b001:l042","ordinal":386963,"en":"Blood gushed and gushed."},{"id":"seytek-1991-continuation:p0343:b001:l043","ordinal":386964,"en":"His fine mustache drooped,"},{"id":"seytek-1991-continuation:p0343:b001:l044","ordinal":386965,"en":"And his ruddy face grew pale;"},{"id":"seytek-1991-continuation:p0343:b001:l045","ordinal":386966,"en":"His breast filled with blood."},{"id":"seytek-1991-continuation:p0343:b001:l046","ordinal":386967,"en":"Ebegey, father of the people,"},{"id":"seytek-1991-continuation:p0343:b001:l047","ordinal":386968,"en":"Was sacrificed for his nation."},{"id":"seytek-1991-continuation:p0343:b001:l048","ordinal":386969,"en":"Blood-handed Yengkor declared,"},{"id":"seytek-1991-continuation:p0343:b001:l049","ordinal":386970,"en":"“I have shattered the mountain ridge"},{"id":"seytek-1991-continuation:p0343:b003:l001","ordinal":386971,"en":"Of the steadfast Burut,"},{"id":"seytek-1991-continuation:p0343:b003:l002","ordinal":386972,"en":"And taken control of the road;"},{"id":"seytek-1991-continuation:p0343:b003:l003","ordinal":386973,"en":"I have brought down a peak like Kap-Too"},{"id":"seytek-1991-continuation:p0343:b003:l004","ordinal":386974,"en":"And cast the world into black night.”"},{"id":"seytek-1991-continuation:p0343:b003:l005","ordinal":386975,"en":"He went to bear glad tidings"},{"id":"seytek-1991-continuation:p0343:b003:l006","ordinal":386976,"en":"To crowned Chyntengir,"},{"id":"seytek-1991-continuation:p0343:b003:l007","ordinal":386977,"en":"Great khan of the Kakan."},{"id":"seytek-1991-continuation:p0343:b004:l001","ordinal":386978,"en":"Now he saw that hero Yengkor"},{"id":"seytek-1991-continuation:p0343:b004:l002","ordinal":386979,"en":"Was truly a man,"},{"id":"seytek-1991-continuation:p0343:b004:l003","ordinal":386980,"en":"And recognized his marksmanship."},{"id":"seytek-1991-continuation:p0343:b004:l004","ordinal":386981,"en":"Without openly rejoicing, he smiled,"},{"id":"seytek-1991-continuation:p0343:b004:l005","ordinal":386982,"en":"His mustache barely twitching,"},{"id":"seytek-1991-continuation:p0343:b004:l006","ordinal":386983,"en":"And laughed almost imperceptibly:"},{"id":"seytek-1991-continuation:p0343:b004:l007","ordinal":386984,"en":"“He was a khan named Ebegey;"},{"id":"seytek-1991-continuation:p0343:b004:l008","ordinal":386985,"en":"You have taken blood for blood."},{"id":"seytek-1991-continuation:p0343:b004:l009","ordinal":386986,"en":"He was a match for our Er Odu."},{"id":"seytek-1991-continuation:p0343:b004:l010","ordinal":386987,"en":"You have broken the enemy's back"},{"id":"seytek-1991-continuation:p0343:b004:l011","ordinal":386988,"en":"And set Chyntengir's heart at rest!"},{"id":"seytek-1991-continuation:p0343:b005:l001","ordinal":386989,"en":"I have heard news from those who came:"},{"id":"seytek-1991-continuation:p0343:b005:l002","ordinal":386990,"en":"They say Er Kenen on Kertulpar"},{"id":"seytek-1991-continuation:p0343:b005:l003","ordinal":386991,"en":"Still stands fighting."},{"id":"seytek-1991-continuation:p0343:b005:l004","ordinal":386992,"en":"Strong men in coats,"},{"id":"seytek-1991-continuation:p0343:b005:l005","ordinal":386993,"en":"Shaven warriors girded with stones,"},{"id":"seytek-1991-continuation:p0343:b005:l006","ordinal":386994,"en":"Thick-armed heroes,"},{"id":"seytek-1991-continuation:p0343:b005:l007","ordinal":386995,"en":"Men deft and skilled with the spear,"},{"id":"seytek-1991-continuation:p0343:b005:l008","ordinal":386996,"en":"Fully armed Kaldays,"},{"id":"seytek-1991-continuation:p0343:b005:l009","ordinal":386997,"en":"Strong men swift in wrestling—"},{"id":"seytek-1991-continuation:p0343:b005:l010","ordinal":386998,"en":"They say these fell in turmoil."},{"id":"seytek-1991-continuation:p0343:b005:l011","ordinal":386999,"en":"They say he destroys without pause,"},{"id":"seytek-1991-continuation:p0343:b005:l012","ordinal":387000,"en":"And keeps inflicting hell."},{"id":"seytek-1991-continuation:p0343:b005:l013","ordinal":387001,"en":"They say he crushes the strong"},{"id":"seytek-1991-continuation:p0343:b005:l014","ordinal":387002,"en":"And beats the rage"},{"id":"seytek-1991-continuation:p0343:b005:l015","ordinal":387003,"en":"Out of courageous Kaldays."},{"id":"seytek-1991-continuation:p0343:b005:l016","ordinal":387004,"en":"May fire burst from your bones!"},{"id":"seytek-1991-continuation:p0343:b005:l017","ordinal":387005,"en":"An enemy has risen from among you:"},{"id":"seytek-1991-continuation:p0343:b005:l018","ordinal":387006,"en":"Jeljetpes has gone over to the Kyrgyz"},{"id":"seytek-1991-continuation:p0343:b005:l019","ordinal":387007,"en":"And become a rebel."},{"id":"seytek-1991-continuation:p0343:b005:l020","ordinal":387008,"en":"He has brought a day of dire disaster"},{"id":"seytek-1991-continuation:p0343:b005:l021","ordinal":387009,"en":"Upon the people of China's forty khans,"},{"id":"seytek-1991-continuation:p0343:b005:l022","ordinal":387010,"en":"And reached their very foundations."},{"id":"seytek-1991-continuation:p0343:b005:l023","ordinal":387011,"en":"Thus that black demon"},{"id":"seytek-1991-continuation:p0343:b005:l024","ordinal":387012,"en":"Has become an enemy."},{"id":"seytek-1991-continuation:p0343:b005:l025","ordinal":387013,"en":"That accursed Jeljetpes"},{"id":"seytek-1991-continuation:p0343:b005:l026","ordinal":387014,"en":"Has ruined my undertaking."},{"id":"seytek-1991-continuation:p0343:b005:l027","ordinal":387015,"en":"He has broken my back,"},{"id":"seytek-1991-continuation:p0343:b005:l028","ordinal":387016,"en":"And openly destroyed"},{"id":"seytek-1991-continuation:p0343:b005:l029","ordinal":387017,"en":"Er Odukan and Choyun Alp,"},{"id":"seytek-1991-continuation:p0343:b005:l030","ordinal":387018,"en":"Heroes such as these.”"},{"id":"seytek-1991-continuation:p0344:b001:l001","ordinal":387019,"en":"“You are the support on whom I rely,"},{"id":"seytek-1991-continuation:p0344:b001:l002","ordinal":387020,"en":"The marksman who is a shield"},{"id":"seytek-1991-continuation:p0344:b001:l003","ordinal":387021,"en":"For the Kakan of Chin-Machin."},{"id":"seytek-1991-continuation:p0344:b001:l004","ordinal":387022,"en":"Even if Jeljetpes descends underground,"},{"id":"seytek-1991-continuation:p0344:b001:l005","ordinal":387023,"en":"Capture him and bring him here."},{"id":"seytek-1991-continuation:p0344:b001:l006","ordinal":387024,"en":"Bind both his hands;"},{"id":"seytek-1991-continuation:p0344:b001:l007","ordinal":387025,"en":"Gouge out both his eyes."},{"id":"seytek-1991-continuation:p0344:b001:l008","ordinal":387026,"en":"Cut out his tongue so he cannot speak,"},{"id":"seytek-1991-continuation:p0344:b001:l009","ordinal":387027,"en":"And pierce him through the nape."},{"id":"seytek-1991-continuation:p0344:b001:l010","ordinal":387028,"en":"Put a billowing robe on him,"},{"id":"seytek-1991-continuation:p0344:b001:l011","ordinal":387029,"en":"Seat him backward on a mule,"},{"id":"seytek-1991-continuation:p0344:b001:l012","ordinal":387030,"en":"Letting him sway helplessly,"},{"id":"seytek-1991-continuation:p0344:b001:l013","ordinal":387031,"en":"And drive him here to me!"},{"id":"seytek-1991-continuation:p0344:b001:l014","ordinal":387032,"en":"He too is a champion and a lion."},{"id":"seytek-1991-continuation:p0344:b001:l015","ordinal":387033,"en":"As for Kenen, chief of the Buruts,"},{"id":"seytek-1991-continuation:p0344:b001:l016","ordinal":387034,"en":"Pure as sparkling water,"},{"id":"seytek-1991-continuation:p0344:b001:l017","ordinal":387035,"en":"The precious bringer of good fortune,"},{"id":"seytek-1991-continuation:p0344:b001:l018","ordinal":387036,"en":"Huge as the Ala-Too,"},{"id":"seytek-1991-continuation:p0344:b001:l019","ordinal":387037,"en":"A fortress like Mount Kap,"},{"id":"seytek-1991-continuation:p0344:b001:l020","ordinal":387038,"en":"Who consumes those he fights,"},{"id":"seytek-1991-continuation:p0344:b001:l021","ordinal":387039,"en":"Thick-armed and stone-hearted,"},{"id":"seytek-1991-continuation:p0344:b001:l022","ordinal":387040,"en":"A massive, well-built terror,"},{"id":"seytek-1991-continuation:p0344:b001:l023","ordinal":387041,"en":"Formidable as Alaskar,"},{"id":"seytek-1991-continuation:p0344:b001:l024","ordinal":387042,"en":"The finest of the white-capped people—"},{"id":"seytek-1991-continuation:p0344:b001:l025","ordinal":387043,"en":"Go and destroy Er Kenen;"},{"id":"seytek-1991-continuation:p0344:b001:l026","ordinal":387044,"en":"Find a way and capture him!"},{"id":"seytek-1991-continuation:p0344:b001:l027","ordinal":387045,"en":"No bullet pierces what he wears;"},{"id":"seytek-1991-continuation:p0344:b001:l028","ordinal":387046,"en":"No arrow catches what he rides."},{"id":"seytek-1991-continuation:p0344:b001:l029","ordinal":387047,"en":"Kertulpar flew like a cloud,"},{"id":"seytek-1991-continuation:p0344:b001:l030","ordinal":387048,"en":"While the champion wore his armor,"},{"id":"seytek-1991-continuation:p0344:b001:l031","ordinal":387049,"en":"And circled all Five Beijings."},{"id":"seytek-1991-continuation:p0344:b001:l032","ordinal":387050,"en":"He is a beast fit for"},{"id":"seytek-1991-continuation:p0344:b001:l033","ordinal":387051,"en":"Your champion khan Chyntengir to ride;"},{"id":"seytek-1991-continuation:p0344:b001:l034","ordinal":387052,"en":"Winged Kertulpar"},{"id":"seytek-1991-continuation:p0344:b001:l035","ordinal":387053,"en":"Is a creature worth taking as plunder.”"},{"id":"seytek-1991-continuation:p0344:b001:l036","ordinal":387054,"en":"Saying, “Remember these words,”"},{"id":"seytek-1991-continuation:p0344:b001:l037","ordinal":387055,"en":"He spoke thus to his marksman,"},{"id":"seytek-1991-continuation:p0344:b001:l038","ordinal":387056,"en":"Gave him this terrible sign,"},{"id":"seytek-1991-continuation:p0344:b001:l039","ordinal":387057,"en":"And firmly sent him against Kenen,"},{"id":"seytek-1991-continuation:p0344:b001:l040","ordinal":387058,"en":"To bring distress upon the champion,"},{"id":"seytek-1991-continuation:p0344:b001:l041","ordinal":387059,"en":"The khan of the Ala-Too."},{"id":"seytek-1991-continuation:p0344:b001:l042","ordinal":387060,"en":"Chyntengir took pride"},{"id":"seytek-1991-continuation:p0344:b001:l043","ordinal":387061,"en":"In having champion Yengkor."},{"id":"seytek-1991-continuation:p0344:b001:l044","ordinal":387062,"en":"When Yengkor chose his shot"},{"id":"seytek-1991-continuation:p0344:b001:l045","ordinal":387063,"en":"And watched for his mark,"},{"id":"seytek-1991-continuation:p0344:b001:l046","ordinal":387064,"en":"He ordered the host to surge past without stooping,"},{"id":"seytek-1991-continuation:p0344:b001:l047","ordinal":387065,"en":"To encircle him,"},{"id":"seytek-1991-continuation:p0344:b001:l048","ordinal":387066,"en":"To reach his very foundation,"},{"id":"seytek-1991-continuation:p0344:b001:l049","ordinal":387067,"en":"And spill his blood by the spoonful."},{"id":"seytek-1991-continuation:p0344:b003:l001","ordinal":387068,"en":"He ordered them to press down from the crown,"},{"id":"seytek-1991-continuation:p0344:b003:l002","ordinal":387069,"en":"And gave him a countless army"},{"id":"seytek-1991-continuation:p0344:b003:l003","ordinal":387070,"en":"Of iron lariats and nets,"},{"id":"seytek-1991-continuation:p0344:b003:l004","ordinal":387071,"en":"And men armed throughout with daggers—"},{"id":"seytek-1991-continuation:p0344:b003:l005","ordinal":387072,"en":"Gave lavishly, holding no troops back."}]
