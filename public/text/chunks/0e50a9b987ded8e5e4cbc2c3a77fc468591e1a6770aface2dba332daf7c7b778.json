[{"id":"semetey-1-2013:p1210:b003:l016","ordinal":168449,"en":"Your padishah's Akkula"},{"id":"semetey-1-2013:p1210:b003:l017","ordinal":168450,"en":"Ran with an impossible stride."},{"id":"semetey-1-2013:p1210:b003:l018","ordinal":168451,"en":"When he came to a descent,"},{"id":"semetey-1-2013:p1210:b003:l019","ordinal":168452,"en":"His forelegs thrust like a roe deer's;"},{"id":"semetey-1-2013:p1210:b003:l020","ordinal":168453,"en":"When he leaned into an ascent,"},{"id":"semetey-1-2013:p1210:b003:l021","ordinal":168454,"en":"Mighty racehorse Akkula's"},{"id":"semetey-1-2013:p1210:b003:l022","ordinal":168455,"en":"Mane and tail streamed out."},{"id":"semetey-1-2013:p1210:b003:l023","ordinal":168456,"en":"When he reached open steppe,"},{"id":"semetey-1-2013:p1210:b003:l024","ordinal":168457,"en":"His hooves thundered on the ground."},{"id":"semetey-1-2013:p1210:b003:l025","ordinal":168458,"en":"When he champed"},{"id":"semetey-1-2013:p1210:b003:l026","ordinal":168459,"en":"The black-steel bit,"},{"id":"semetey-1-2013:p1210:b003:l027","ordinal":168460,"en":"It clattered in his throat."},{"id":"semetey-1-2013:p1210:b003:l028","ordinal":168461,"en":"His forelock parted toward the sky,"},{"id":"semetey-1-2013:p1210:b003:l029","ordinal":168462,"en":"And his tulpar form appeared."},{"id":"semetey-1-2013:p1210:b003:l030","ordinal":168463,"en":"He flattened his ears like a kulan"},{"id":"semetey-1-2013:p1210:b003:l031","ordinal":168464,"en":"And swept the earth like a whirlwind."},{"id":"semetey-1-2013:p1210:b003:l032","ordinal":168465,"en":"When he came into view,"},{"id":"semetey-1-2013:p1210:b003:l033","ordinal":168466,"en":"Valiant noble Almam"},{"id":"semetey-1-2013:p1210:b003:l034","ordinal":168467,"en":"Watched and marked him carefully."},{"id":"semetey-1-2013:p1210:b003:l035","ordinal":168468,"en":"Stones burst beneath his tread;"},{"id":"semetey-1-2013:p1210:b003:l036","ordinal":168469,"en":"Hero Joloy's Achbuudan"},{"id":"semetey-1-2013:p1210:b003:l037","ordinal":168470,"en":"Came flying with a roar."},{"id":"semetey-1-2013:p1210:b003:l038","ordinal":168471,"en":"He was behind Akkula."},{"id":"semetey-1-2013:p1210:b003:l039","ordinal":168472,"en":"When young Aydar of the flowing forelock"},{"id":"semetey-1-2013:p1210:b004:l001","ordinal":168473,"en":"Drove away the horses,"},{"id":"semetey-1-2013:p1210:b004:l002","ordinal":168474,"en":"Kokotoy's Bokmurun"},{"id":"semetey-1-2013:p1210:b004:l003","ordinal":168475,"en":"Had used much cunning."},{"id":"semetey-1-2013:p1210:b004:l004","ordinal":168476,"en":"Heeding his words, young Aydar"},{"id":"semetey-1-2013:p1210:b004:l005","ordinal":168477,"en":"Tied Maaniker firmly"},{"id":"semetey-1-2013:p1210:b004:l006","ordinal":168478,"en":"And slept for three days."},{"id":"semetey-1-2013:p1210:b004:l007","ordinal":168479,"en":"After three days, young Aydar"},{"id":"semetey-1-2013:p1210:b004:l008","ordinal":168480,"en":"Woke in alarm from sleep,"},{"id":"semetey-1-2013:p1210:b004:l009","ordinal":168481,"en":"Turned onto his right side,"},{"id":"semetey-1-2013:p1210:b004:l010","ordinal":168482,"en":"Dipped his hands in water"},{"id":"semetey-1-2013:p1210:b004:l011","ordinal":168483,"en":"And performed ablution for his hands;"},{"id":"semetey-1-2013:p1210:b004:l012","ordinal":168484,"en":"He dipped his feet in water"},{"id":"semetey-1-2013:p1210:b004:l013","ordinal":168485,"en":"And performed ablution for his feet."},{"id":"semetey-1-2013:p1210:b004:l014","ordinal":168486,"en":"He hurriedly recited namaz,"},{"id":"semetey-1-2013:p1210:b004:l015","ordinal":168487,"en":"Saddled Maaniker,"},{"id":"semetey-1-2013:p1210:b004:l016","ordinal":168488,"en":"Opened his eyes wide as grain mash,"},{"id":"semetey-1-2013:p1210:b004:l017","ordinal":168489,"en":"And all sleep scattered away."},{"id":"semetey-1-2013:p1210:b004:l018","ordinal":168490,"en":"When he stood high and looked,"},{"id":"semetey-1-2013:p1210:b004:l019","ordinal":168491,"en":"There was no raven croaking,"},{"id":"semetey-1-2013:p1210:b004:l020","ordinal":168492,"en":"No crow cawing."},{"id":"semetey-1-2013:p1210:b004:l021","ordinal":168493,"en":"Nothing caught his eye;"},{"id":"semetey-1-2013:p1210:b004:l022","ordinal":168494,"en":"He could not tell where"},{"id":"semetey-1-2013:p1210:b004:l023","ordinal":168495,"en":"The people beside him had gone."},{"id":"semetey-1-2013:p1210:b004:l024","ordinal":168496,"en":"Then young Aydar"},{"id":"semetey-1-2013:p1210:b004:l025","ordinal":168497,"en":"Struck the whip hard"},{"id":"semetey-1-2013:p1210:b004:l026","ordinal":168498,"en":"Against a tulpar like Maaniker,"},{"id":"semetey-1-2013:p1210:b004:l027","ordinal":168499,"en":"Upon the black thigh never struck by a whip."},{"id":"semetey-1-2013:p1210:b004:l028","ordinal":168500,"en":"Its sheep-like flesh divided,"},{"id":"semetey-1-2013:p1210:b004:l029","ordinal":168501,"en":"And its back straightened like a hare's;"},{"id":"semetey-1-2013:p1210:b004:l030","ordinal":168502,"en":"Its foal-like flesh stood out,"},{"id":"semetey-1-2013:p1210:b004:l031","ordinal":168503,"en":"And its coat smoothed like a sighthound's."},{"id":"semetey-1-2013:p1210:b004:l032","ordinal":168504,"en":"Its cavernous mouth opened;"},{"id":"semetey-1-2013:p1210:b004:l033","ordinal":168505,"en":"Its contracted hooves"},{"id":"semetey-1-2013:p1210:b004:l034","ordinal":168506,"en":"Spread as broad as great platters."},{"id":"semetey-1-2013:p1210:b004:l035","ordinal":168507,"en":"White foam mixed with blood"},{"id":"semetey-1-2013:p1210:b004:l036","ordinal":168508,"en":"Splashed upon its chest."},{"id":"semetey-1-2013:p1210:b004:l037","ordinal":168509,"en":"Beneath the clouded sky,"},{"id":"semetey-1-2013:p1210:b004:l038","ordinal":168510,"en":"Over the rippling grass,"},{"id":"semetey-1-2013:p1210:b004:l039","ordinal":168511,"en":"It now flew away with a roar."}]
