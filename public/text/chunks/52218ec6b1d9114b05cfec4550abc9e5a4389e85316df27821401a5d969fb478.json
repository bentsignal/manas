[{"id":"manas-2010:p0878:b001:l037","ordinal":38657,"en":"All the twelve khans"},{"id":"manas-2010:p0878:b001:l038","ordinal":38658,"en":"Thrust their raiding spears."},{"id":"manas-2010:p0878:b001:l039","ordinal":38659,"en":"When they saw the mighty giants,"},{"id":"manas-2010:p0878:b001:l040","ordinal":38660,"en":"Damn the people of Bukhara!"},{"id":"manas-2010:p0878:b001:l041","ordinal":38661,"en":"When they lost their senses,"},{"id":"manas-2010:p0878:b001:l042","ordinal":38662,"en":"When they fled toward the palace,"},{"id":"manas-2010:p0879:b001:l001","ordinal":38663,"en":"In striped robes, bare-chested,"},{"id":"manas-2010:p0879:b001:l002","ordinal":38664,"en":"Some were still upon the road."},{"id":"manas-2010:p0879:b001:l003","ordinal":38665,"en":"Among those fleeing, some had no saddles;"},{"id":"manas-2010:p0879:b001:l004","ordinal":38666,"en":"Some rode on camel pads."},{"id":"manas-2010:p0879:b001:l005","ordinal":38667,"en":"When I saw the people's weakness,"},{"id":"manas-2010:p0879:b001:l006","ordinal":38668,"en":"“These wretched, ruined people—"},{"id":"manas-2010:p0879:b001:l007","ordinal":38669,"en":"They will destroy them utterly,” I thought."},{"id":"manas-2010:p0879:b001:l008","ordinal":38670,"en":"“Taking their girls and women as spoils,"},{"id":"manas-2010:p0879:b001:l009","ordinal":38671,"en":"They will devastate and raid them,” I thought."},{"id":"manas-2010:p0879:b001:l010","ordinal":38672,"en":"Burning with fury, I, the fierce woman,"},{"id":"manas-2010:p0879:b001:l011","ordinal":38673,"en":"Made my woman's self a warrior,"},{"id":"manas-2010:p0879:b001:l012","ordinal":38674,"en":"Made my maiden's self a lion."},{"id":"manas-2010:p0879:b001:l013","ordinal":38675,"en":"My loose, flying hair"},{"id":"manas-2010:p0879:b001:l014","ordinal":38676,"en":"I bound tightly on my head."},{"id":"manas-2010:p0879:b001:l015","ordinal":38677,"en":"I donned a blood-drinker's clothing."},{"id":"manas-2010:p0879:b001:l016","ordinal":38678,"en":"Stained with black blood,"},{"id":"manas-2010:p0879:b001:l017","ordinal":38679,"en":"A dark-blue spear I took in hand."},{"id":"manas-2010:p0879:b001:l018","ordinal":38680,"en":"Against the oppressive enemy"},{"id":"manas-2010:p0879:b001:l019","ordinal":38681,"en":"I myself entered single combat."},{"id":"manas-2010:p0879:b001:l020","ordinal":38682,"en":"I girded my narrow waist,"},{"id":"manas-2010:p0879:b001:l021","ordinal":38683,"en":"Crushing them terribly,"},{"id":"manas-2010:p0879:b001:l022","ordinal":38684,"en":"I pursued the twelve khans."},{"id":"manas-2010:p0879:b001:l023","ordinal":38685,"en":"Winding it tight, I girded my waist."},{"id":"manas-2010:p0879:b001:l024","ordinal":38686,"en":"The khans who brought confusion—"},{"id":"manas-2010:p0879:b001:l025","ordinal":38687,"en":"I turned their tumult to dust,"},{"id":"manas-2010:p0879:b001:l026","ordinal":38688,"en":"Drove them away scattered to dust."},{"id":"manas-2010:p0879:b001:l027","ordinal":38689,"en":"I attacked and made a fight,"},{"id":"manas-2010:p0879:b001:l028","ordinal":38690,"en":"Toppled them from their horses,"},{"id":"manas-2010:p0879:b001:l029","ordinal":38691,"en":"Humiliated the khans."},{"id":"manas-2010:p0879:b001:l030","ordinal":38692,"en":"Their steeds, then,"},{"id":"manas-2010:p0879:b001:l031","ordinal":38693,"en":"I took every one as spoils."},{"id":"manas-2010:p0879:b001:l032","ordinal":38694,"en":"I cooled and quelled their pride."},{"id":"manas-2010:p0879:b001:l033","ordinal":38695,"en":"The khans who came to seize things—"},{"id":"manas-2010:p0879:b001:l034","ordinal":38696,"en":"I scattered their own wealth."},{"id":"manas-2010:p0879:b001:l035","ordinal":38697,"en":"Turning toward Bukhara,"},{"id":"manas-2010:p0879:b001:l036","ordinal":38698,"en":"I made them unable to trot this way."},{"id":"manas-2010:p0879:b001:l037","ordinal":38699,"en":"To this place again,"},{"id":"manas-2010:p0879:b001:l038","ordinal":38700,"en":"I made them unable to return."},{"id":"manas-2010:p0879:b001:l039","ordinal":38701,"en":"To those who know my worth,"},{"id":"manas-2010:p0879:b001:l040","ordinal":38702,"en":"I am a dark-eyed queen."},{"id":"manas-2010:p0879:b001:l041","ordinal":38703,"en":"To a person who fights me with whips,"},{"id":"manas-2010:p0879:b001:l042","ordinal":38704,"en":"Charging, never sated with blood,"},{"id":"manas-2010:p0880:b001:l001","ordinal":38705,"en":"I am a tigress."},{"id":"manas-2010:p0880:b001:l002","ordinal":38706,"en":"Thinking yourself a champion, a warrior,"},{"id":"manas-2010:p0880:b001:l003","ordinal":38707,"en":"You have trotted straight toward me."},{"id":"manas-2010:p0880:b001:l004","ordinal":38708,"en":"In your arrogance,"},{"id":"manas-2010:p0880:b001:l005","ordinal":38709,"en":"This Bukhara standing here—"},{"id":"manas-2010:p0880:b001:l006","ordinal":38710,"en":"You came saying you would take it."},{"id":"manas-2010:p0880:b001:l007","ordinal":38711,"en":"I have seen the arrogant;"},{"id":"manas-2010:p0880:b001:l008","ordinal":38712,"en":"Coming swollen with pride to attack,"},{"id":"manas-2010:p0880:b001:l009","ordinal":38713,"en":"I have seen many die."},{"id":"manas-2010:p0880:b001:l010","ordinal":38714,"en":"“She is a warrior among maidens,”"},{"id":"manas-2010:p0880:b001:l011","ordinal":38715,"en":"Tell your people."},{"id":"manas-2010:p0880:b001:l012","ordinal":38716,"en":"Without disputes or quarrels,"},{"id":"manas-2010:p0880:b001:l013","ordinal":38717,"en":"Return safe and sound."},{"id":"manas-2010:p0880:b001:l014","ordinal":38718,"en":"Come with all sixty of your giants;"},{"id":"manas-2010:p0880:b001:l015","ordinal":38719,"en":"You cannot match me in combat."},{"id":"manas-2010:p0880:b001:l016","ordinal":38720,"en":"The reason you cannot match me:"},{"id":"manas-2010:p0880:b001:l017","ordinal":38721,"en":"I am a lion among women,"},{"id":"manas-2010:p0880:b001:l018","ordinal":38722,"en":"Of this Bukhara standing here"},{"id":"manas-2010:p0880:b001:l019","ordinal":38723,"en":"I am the warrior charged to guard it."},{"id":"manas-2010:p0880:b001:l020","ordinal":38724,"en":"Giving no peace to those with jaws,"},{"id":"manas-2010:p0880:b001:l021","ordinal":38725,"en":"Yielding to no bareback horse,"},{"id":"manas-2010:p0880:b001:l022","ordinal":38726,"en":"Giving no livestock to raiders,"},{"id":"manas-2010:p0880:b001:l023","ordinal":38727,"en":"Giving no blood to spearmen,"},{"id":"manas-2010:p0880:b001:l024","ordinal":38728,"en":"I am Kanykey herself."},{"id":"manas-2010:p0880:b001:l025","ordinal":38729,"en":"From what people say,"},{"id":"manas-2010:p0880:b001:l026","ordinal":38730,"en":"I hear scattered rumors:"},{"id":"manas-2010:p0880:b001:l027","ordinal":38731,"en":"From evil-minded Jakyp,"},{"id":"manas-2010:p0880:b001:l028","ordinal":38732,"en":"A leopard was born in Altay."},{"id":"manas-2010:p0880:b001:l029","ordinal":38733,"en":"Breaking palaces, taking spoils,"},{"id":"manas-2010:p0880:b001:l030","ordinal":38734,"en":"He wrought destruction, I heard."},{"id":"manas-2010:p0880:b001:l031","ordinal":38735,"en":"Upon the Black Chinese and Manchus,"},{"id":"manas-2010:p0880:b001:l032","ordinal":38736,"en":"Upon the warrior Khan Alöökö,"},{"id":"manas-2010:p0880:b001:l033","ordinal":38737,"en":"He worked wonders, I heard."},{"id":"manas-2010:p0880:b001:l034","ordinal":38738,"en":"His wandering and scattered people"},{"id":"manas-2010:p0880:b001:l035","ordinal":38739,"en":"He brought back, I heard."},{"id":"manas-2010:p0880:b001:l036","ordinal":38740,"en":"Upon Altay, devastation"},{"id":"manas-2010:p0880:b001:l037","ordinal":38741,"en":"He brought, I heard."},{"id":"manas-2010:p0880:b001:l038","ordinal":38742,"en":"Taking Talas as his land,"},{"id":"manas-2010:p0880:b001:l039","ordinal":38743,"en":"The Argyn and the Kyrgyz"},{"id":"manas-2010:p0880:b001:l040","ordinal":38744,"en":"He united into one people."},{"id":"manas-2010:p0880:b001:l041","ordinal":38745,"en":"Establishing a court, becoming khan,"},{"id":"manas-2010:p0880:b001:l042","ordinal":38746,"en":"He settled along Talas, they say."},{"id":"manas-2010:p0881:b001:l001","ordinal":38747,"en":"The warrior Khan Alöökö,"},{"id":"manas-2010:p0881:b001:l002","ordinal":38748,"en":"As he fled toward Kakan,"},{"id":"manas-2010:p0881:b001:l003","ordinal":38749,"en":"He caught and butchered, they say."},{"id":"manas-2010:p0881:b001:l004","ordinal":38750,"en":"The sons of the Muslim faith"},{"id":"manas-2010:p0881:b001:l005","ordinal":38751,"en":"Alöökö's countless riches"},{"id":"manas-2010:p0881:b001:l006","ordinal":38752,"en":"Plundered to their fill, they say."},{"id":"manas-2010:p0881:b001:l007","ordinal":38753,"en":"Unless you are the dark, blue-maned leopard,"},{"id":"manas-2010:p0881:b001:l008","ordinal":38754,"en":"Blood-drinking Manas,"},{"id":"manas-2010:p0881:b001:l009","ordinal":38755,"en":"You cannot match me in battle,"},{"id":"manas-2010:p0881:b001:l010","ordinal":38756,"en":"You have not the strength to grapple!’"},{"id":"manas-2010:p0881:b001:l011","ordinal":38757,"en":"When Kanykey said this,"},{"id":"manas-2010:p0881:b001:l012","ordinal":38758,"en":"Now God struck Chubak."},{"id":"manas-2010:p0881:b001:l013","ordinal":38759,"en":"Raging and springing,"},{"id":"manas-2010:p0881:b001:l014","ordinal":38760,"en":"Now God struck the reckless fellow."},{"id":"manas-2010:p0881:b001:l015","ordinal":38761,"en":"At that time warrior Chubak"},{"id":"manas-2010:p0881:b001:l016","ordinal":38762,"en":"Had not yet settled in Talas,"},{"id":"manas-2010:p0881:b001:l017","ordinal":38763,"en":"Had not become Manas's companion."},{"id":"manas-2010:p0881:b001:l018","ordinal":38764,"en":"‘Is Alay less than Talas?"},{"id":"manas-2010:p0881:b001:l019","ordinal":38765,"en":"Is Manas braver than Chubak?"},{"id":"manas-2010:p0881:b001:l020","ordinal":38766,"en":"This is boasting on your part."},{"id":"manas-2010:p0881:b001:l021","ordinal":38767,"en":"Is Manas the one you trust?"},{"id":"manas-2010:p0881:b001:l022","ordinal":38768,"en":"Stand right there!"},{"id":"manas-2010:p0881:b001:l023","ordinal":38769,"en":"Not knowing she was a girl,"},{"id":"manas-2010:p0881:b001:l024","ordinal":38770,"en":"I made a spectacle before the world,’ he said."},{"id":"manas-2010:p0881:b001:l025","ordinal":38771,"en":"Burning with desire, unable to stop,"},{"id":"manas-2010:p0881:b001:l026","ordinal":38772,"en":"God struck Chubak,"},{"id":"manas-2010:p0881:b001:l027","ordinal":38773,"en":"Who routed the world's people,"},{"id":"manas-2010:p0881:b001:l028","ordinal":38774,"en":"That damned Chubak,"},{"id":"manas-2010:p0881:b001:l029","ordinal":38775,"en":"Wrathful madman, great troublemaker,"},{"id":"manas-2010:p0881:b001:l030","ordinal":38776,"en":"The reckless fellow who would not listen."},{"id":"manas-2010:p0881:b001:l031","ordinal":38777,"en":"Striking Kögala's flank once,"},{"id":"manas-2010:p0881:b001:l032","ordinal":38778,"en":"Taking the blue spear in hand,"},{"id":"manas-2010:p0881:b001:l033","ordinal":38779,"en":"He readied himself, thrusting the spear forward."},{"id":"manas-2010:p0881:b001:l034","ordinal":38780,"en":"When they saw Chubak's appearance,"},{"id":"manas-2010:p0881:b001:l035","ordinal":38781,"en":"‘This unbeliever will do something terrible,’"},{"id":"manas-2010:p0881:b001:l036","ordinal":38782,"en":"The vast people of Bukhara thought;"},{"id":"manas-2010:p0881:b001:l037","ordinal":38783,"en":"Not a shred of sense remained."},{"id":"manas-2010:p0881:b001:l038","ordinal":38784,"en":"Then Kanykey,"},{"id":"manas-2010:p0881:b001:l039","ordinal":38785,"en":"Unmoving, unconcerned,"},{"id":"manas-2010:p0881:b001:l040","ordinal":38786,"en":"The mighty warrior Chubak"},{"id":"manas-2010:p0881:b001:l041","ordinal":38787,"en":"Valued less than her trouser leg."},{"id":"manas-2010:p0881:b001:l042","ordinal":38788,"en":"‘Do not hold back, Chubak, do not hold back!"},{"id":"manas-2010:p0882:b001:l001","ordinal":38789,"en":"Stretch out and thrust your spear;"},{"id":"manas-2010:p0882:b001:l002","ordinal":38790,"en":"Take your revenge on me!’"},{"id":"manas-2010:p0882:b001:l003","ordinal":38791,"en":"Thus Kanykey spoke."},{"id":"manas-2010:p0882:b001:l004","ordinal":38792,"en":"Her black, white-blazed thoroughbred—"},{"id":"manas-2010:p0882:b001:l005","ordinal":38793,"en":"She drew the reins and turned it."},{"id":"manas-2010:p0882:b001:l006","ordinal":38794,"en":"‘Take your turn!’ she said,"},{"id":"manas-2010:p0882:b001:l007","ordinal":38795,"en":"Standing tall and watching."},{"id":"manas-2010:p0882:b001:l008","ordinal":38796,"en":"While the people grieved, Kanykey"},{"id":"manas-2010:p0882:b001:l009","ordinal":38797,"en":"Went smiling openly,"},{"id":"manas-2010:p0882:b001:l010","ordinal":38798,"en":"Her sunlike face radiant,"},{"id":"manas-2010:p0882:b001:l011","ordinal":38799,"en":"Her spade-like teeth gleaming."},{"id":"manas-2010:p0882:b001:l012","ordinal":38800,"en":"She gave Chubak his turn,"},{"id":"manas-2010:p0882:b001:l013","ordinal":38801,"en":"The reckless fellow who would stretch out and strike."},{"id":"manas-2010:p0882:b001:l014","ordinal":38802,"en":"With a piercing cry, a wild battle shout,"},{"id":"manas-2010:p0882:b001:l015","ordinal":38803,"en":"Akbaltay's Chubak,"},{"id":"manas-2010:p0882:b001:l016","ordinal":38804,"en":"Who routed the whole wide world,"},{"id":"manas-2010:p0882:b001:l017","ordinal":38805,"en":"That outstanding reckless fellow,"},{"id":"manas-2010:p0882:b001:l018","ordinal":38806,"en":"To whom twelve together had given their hands—"},{"id":"manas-2010:p0882:b001:l019","ordinal":38807,"en":"He too was one of the lions."},{"id":"manas-2010:p0882:b001:l020","ordinal":38808,"en":"He thrust his spear at the fierce woman,"},{"id":"manas-2010:p0882:b001:l021","ordinal":38809,"en":"Without looking around,"},{"id":"manas-2010:p0882:b001:l022","ordinal":38810,"en":"Without sparing his life at all."},{"id":"manas-2010:p0882:b001:l023","ordinal":38811,"en":"He raised a shout then,"},{"id":"manas-2010:p0882:b001:l024","ordinal":38812,"en":"Without scanning about,"},{"id":"manas-2010:p0882:b001:l025","ordinal":38813,"en":"Without sparing his threadlike life."},{"id":"manas-2010:p0882:b001:l026","ordinal":38814,"en":"When he turned Kögala,"},{"id":"manas-2010:p0882:b001:l027","ordinal":38815,"en":"When he shouted and thrust the spear,"},{"id":"manas-2010:p0882:b001:l028","ordinal":38816,"en":"His waist bent forward,"},{"id":"manas-2010:p0882:b001:l029","ordinal":38817,"en":"His eyes bulged wide."},{"id":"manas-2010:p0882:b001:l030","ordinal":38818,"en":"Before one could say this or that,"},{"id":"manas-2010:p0882:b001:l031","ordinal":38819,"en":"Before an eye could open and close,"},{"id":"manas-2010:p0882:b001:l032","ordinal":38820,"en":"He arrived sooner than an arrow."},{"id":"manas-2010:p0882:b001:l033","ordinal":38821,"en":"Upon reaching her, warrior Chubak,"},{"id":"manas-2010:p0882:b001:l034","ordinal":38822,"en":"‘Here is beneath the breast,’ he thought,"},{"id":"manas-2010:p0882:b001:l035","ordinal":38823,"en":"‘Exactly where the lungs are,’ he thought,"},{"id":"manas-2010:p0882:b001:l036","ordinal":38824,"en":"And struck as he swept past."},{"id":"manas-2010:p0882:b001:l037","ordinal":38825,"en":"His spear did not pass inside—"},{"id":"manas-2010:p0882:b001:l038","ordinal":38826,"en":"Akbaltay's Chubak."},{"id":"manas-2010:p0882:b001:l039","ordinal":38827,"en":"Warrior Chubak's spear"},{"id":"manas-2010:p0882:b001:l040","ordinal":38828,"en":"Shattered utterly into fragments."},{"id":"manas-2010:p0882:b001:l041","ordinal":38829,"en":"White fibers big as a horse's head"},{"id":"manas-2010:p0882:b001:l042","ordinal":38830,"en":"Flew fluttering and scattering."},{"id":"manas-2010:p0883:b001:l001","ordinal":38831,"en":"‘God has struck the unbeliever!’"},{"id":"manas-2010:p0883:b001:l002","ordinal":38832,"en":"The watching people of Bukhara"},{"id":"manas-2010:p0883:b001:l003","ordinal":38833,"en":"Raised a shrill shout."},{"id":"manas-2010:p0883:b001:l004","ordinal":38834,"en":"Then Kanykey,"},{"id":"manas-2010:p0883:b001:l005","ordinal":38835,"en":"Whose valor was extraordinary—"},{"id":"manas-2010:p0883:b001:l006","ordinal":38836,"en":"While still a maiden, Kanykey"},{"id":"manas-2010:p0883:b001:l007","ordinal":38837,"en":"Shook the world and shattered peoples."},{"id":"manas-2010:p0883:b001:l008","ordinal":38838,"en":"An outstanding warrior among girls,"},{"id":"manas-2010:p0883:b001:l009","ordinal":38839,"en":"She felt no fear of death."},{"id":"manas-2010:p0883:b001:l010","ordinal":38840,"en":"At warrior Chubak's spear,"},{"id":"manas-2010:p0883:b001:l011","ordinal":38841,"en":"She did not so much as twitch a brow."},{"id":"manas-2010:p0883:b001:l012","ordinal":38842,"en":"Akbaltay's Chubak"},{"id":"manas-2010:p0883:b001:l013","ordinal":38843,"en":"Turned Kögala's head."},{"id":"manas-2010:p0883:b001:l014","ordinal":38844,"en":"‘Come now, thrust!’ he said,"},{"id":"manas-2010:p0883:b001:l015","ordinal":38845,"en":"To that fierce woman Kanykey,"},{"id":"manas-2010:p0883:b001:l016","ordinal":38846,"en":"Giving her her turn."},{"id":"manas-2010:p0883:b001:l017","ordinal":38847,"en":"The black, white-blazed thoroughbred—"},{"id":"manas-2010:p0883:b001:l018","ordinal":38848,"en":"That Kanykey, the capable slave girl,"},{"id":"manas-2010:p0883:b001:l019","ordinal":38849,"en":"Whipped it on either side,"},{"id":"manas-2010:p0883:b001:l020","ordinal":38850,"en":"Spurred it right and left."},{"id":"manas-2010:p0883:b001:l021","ordinal":38851,"en":"Her painted spear, iron-edged,"},{"id":"manas-2010:p0883:b001:l022","ordinal":38852,"en":"She angled and thrust forward."},{"id":"manas-2010:p0883:b001:l023","ordinal":38853,"en":"‘The pommel of his white saddle,’ she thought,"},{"id":"manas-2010:p0883:b001:l024","ordinal":38854,"en":"‘The top of his heart,’ she thought,"},{"id":"manas-2010:p0883:b001:l025","ordinal":38855,"en":"‘Here is his mortal spot,’ she thought,"},{"id":"manas-2010:p0883:b001:l026","ordinal":38856,"en":"And shouted, thrusting her spear."},{"id":"manas-2010:p0883:b001:l027","ordinal":38857,"en":"Sooner than an arrow, Kanykey—"},{"id":"manas-2010:p0883:b001:l028","ordinal":38858,"en":"Such was her skill—"},{"id":"manas-2010:p0883:b001:l029","ordinal":38859,"en":"To Akbaltay's Chubak"},{"id":"manas-2010:p0883:b001:l030","ordinal":38860,"en":"She reached and struck with her spear."},{"id":"manas-2010:p0883:b001:l031","ordinal":38861,"en":"When she reached and struck him,"},{"id":"manas-2010:p0883:b001:l032","ordinal":38862,"en":"The steed Kögala reared."},{"id":"manas-2010:p0883:b001:l033","ordinal":38863,"en":"When her spear struck,"},{"id":"manas-2010:p0883:b001:l034","ordinal":38864,"en":"It shattered into eighty pieces."},{"id":"manas-2010:p0883:b001:l035","ordinal":38865,"en":"Ill-omened Kanykey"},{"id":"manas-2010:p0883:b001:l036","ordinal":38866,"en":"Unleashed fierce wrath."},{"id":"manas-2010:p0883:b001:l037","ordinal":38867,"en":"Khan Baltay's Chubak,"},{"id":"manas-2010:p0883:b001:l038","ordinal":38868,"en":"From Kögala's back,"},{"id":"manas-2010:p0883:b001:l039","ordinal":38869,"en":"Nearly tumbled down."},{"id":"manas-2010:p0883:b001:l040","ordinal":38870,"en":"Since Chubak had been Chubak,"},{"id":"manas-2010:p0883:b001:l041","ordinal":38871,"en":"Since Chubak had mounted a horse,"},{"id":"manas-2010:p0883:b001:l042","ordinal":38872,"en":"With a piercing cry, a wild battle shout,"},{"id":"manas-2010:p0884:b001:l001","ordinal":38873,"en":"No one had shouted and thrust a spear,"},{"id":"manas-2010:p0884:b001:l002","ordinal":38874,"en":"Against Akbaltay's Chubak"},{"id":"manas-2010:p0884:b001:l003","ordinal":38875,"en":"No one had come out to face him."},{"id":"manas-2010:p0884:b001:l004","ordinal":38876,"en":"Taking a spear against him,"},{"id":"manas-2010:p0884:b001:l005","ordinal":38877,"en":"No son of man had trotted to meet him."},{"id":"manas-2010:p0884:b001:l006","ordinal":38878,"en":"Akbaltay's Chubak"},{"id":"manas-2010:p0884:b001:l007","ordinal":38879,"en":"Such a hardship as this"},{"id":"manas-2010:p0884:b001:l008","ordinal":38880,"en":"Had never seen in all his life."},{"id":"manas-2010:p0884:b001:l009","ordinal":38881,"en":"Her blow began an upheaval."},{"id":"manas-2010:p0884:b001:l010","ordinal":38882,"en":"The withered girl's spear"},{"id":"manas-2010:p0884:b001:l011","ordinal":38883,"en":"Warrior Chubak the lion,"},{"id":"manas-2010:p0884:b001:l012","ordinal":38884,"en":"From Kögala's back,"},{"id":"manas-2010:p0884:b001:l013","ordinal":38885,"en":"Nearly threw him off."},{"id":"manas-2010:p0884:b001:l014","ordinal":38886,"en":"When the unrestrained hapless girl struck,"},{"id":"manas-2010:p0884:b001:l015","ordinal":38887,"en":"His backside left the saddle,"},{"id":"manas-2010:p0884:b001:l016","ordinal":38888,"en":"His foot left the stirrup."},{"id":"manas-2010:p0884:b001:l017","ordinal":38889,"en":"For the time it takes to boil tea, warrior Chubak"},{"id":"manas-2010:p0884:b001:l018","ordinal":38890,"en":"Stood bereft of strength."},{"id":"manas-2010:p0884:b001:l019","ordinal":38891,"en":"For the time it takes to cook a meal, warrior Chubak"},{"id":"manas-2010:p0884:b001:l020","ordinal":38892,"en":"Stood bereft of strength."},{"id":"manas-2010:p0884:b001:l021","ordinal":38893,"en":"Then Kanykey,"},{"id":"manas-2010:p0884:b001:l022","ordinal":38894,"en":"Her rib bones bending,"},{"id":"manas-2010:p0884:b001:l023","ordinal":38895,"en":"As though she had struck stone,"},{"id":"manas-2010:p0884:b001:l024","ordinal":38896,"en":"When she speared warrior Chubak,"},{"id":"manas-2010:p0884:b001:l025","ordinal":38897,"en":"The reckless slave girl felt the strain."},{"id":"manas-2010:p0884:b001:l026","ordinal":38898,"en":"Her black, white-blazed thoroughbred—"},{"id":"manas-2010:p0884:b001:l027","ordinal":38899,"en":"She held the reins and turned it,"},{"id":"manas-2010:p0884:b001:l028","ordinal":38900,"en":"Astonished at Chubak,"},{"id":"manas-2010:p0884:b001:l029","ordinal":38901,"en":"She watched him carefully."},{"id":"manas-2010:p0884:b001:l030","ordinal":38902,"en":"Then warrior Chubak,"},{"id":"manas-2010:p0884:b001:l031","ordinal":38903,"en":"Raging and struggling,"},{"id":"manas-2010:p0884:b001:l032","ordinal":38904,"en":"Implored the Creator:"},{"id":"manas-2010:p0884:b001:l033","ordinal":38905,"en":"‘Father, you made me a lion who slaughters unbelievers,"},{"id":"manas-2010:p0884:b001:l034","ordinal":38906,"en":"You made all twelve of my limbs complete."},{"id":"manas-2010:p0884:b001:l035","ordinal":38907,"en":"Unable to overcome a woman—"},{"id":"manas-2010:p0884:b001:l036","ordinal":38908,"en":"Why did you make me so deficient?’"},{"id":"manas-2010:p0884:b001:l037","ordinal":38909,"en":"Thus warrior Chubak spoke."},{"id":"manas-2010:p0884:b001:l038","ordinal":38910,"en":"His breast could not hold his many cares,"},{"id":"manas-2010:p0884:b001:l039","ordinal":38911,"en":"His tears streamed in ten directions,"},{"id":"manas-2010:p0884:b001:l040","ordinal":38912,"en":"He lamented greatly to God."}]
