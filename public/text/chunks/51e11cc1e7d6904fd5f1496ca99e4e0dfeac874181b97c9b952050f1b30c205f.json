[{"id":"manas-2010:p0444:b001:l021","ordinal":20481,"en":"We came of the strongest, we came as heroes."},{"id":"manas-2010:p0444:b001:l022","ordinal":20482,"en":"Each one worth a thousand,"},{"id":"manas-2010:p0444:b001:l023","ordinal":20483,"en":"We came as equals among the strongest!"},{"id":"manas-2010:p0444:b001:l024","ordinal":20484,"en":"‘The blood-drinker defeated us’—"},{"id":"manas-2010:p0444:b001:l025","ordinal":20485,"en":"Before Khan Esen,"},{"id":"manas-2010:p0444:b001:l026","ordinal":20486,"en":"How can we give that answer?"},{"id":"manas-2010:p0444:b001:l027","ordinal":20487,"en":"Humiliation like this,"},{"id":"manas-2010:p0444:b001:l028","ordinal":20488,"en":"How can we witness it alive!"},{"id":"manas-2010:p0444:b001:l029","ordinal":20489,"en":"Rather than merely remain alive,"},{"id":"manas-2010:p0444:b001:l030","ordinal":20490,"en":"We will die in slaughter!"},{"id":"manas-2010:p0444:b001:l031","ordinal":20491,"en":"Here is the great counsel I offer."},{"id":"manas-2010:p0444:b001:l032","ordinal":20492,"en":"Take heed, all my wrestlers."},{"id":"manas-2010:p0444:b001:l033","ordinal":20493,"en":"‘Grant three days' respite,’ I said,"},{"id":"manas-2010:p0444:b001:l034","ordinal":20494,"en":"And headlong Manas"},{"id":"manas-2010:p0444:b001:l035","ordinal":20495,"en":"I somehow managed to deceive."},{"id":"manas-2010:p0444:b001:l036","ordinal":20496,"en":"Do not show any mercy."},{"id":"manas-2010:p0444:b001:l037","ordinal":20497,"en":"From that headlong simpleton"},{"id":"manas-2010:p0444:b001:l038","ordinal":20498,"en":"Do not withhold your battle!"},{"id":"manas-2010:p0444:b001:l039","ordinal":20499,"en":"Beyond the khan of Kakan-Chin,"},{"id":"manas-2010:p0444:b001:l040","ordinal":20500,"en":"You were a support of greater courage."},{"id":"manas-2010:p0444:b001:l041","ordinal":20501,"en":"The one we looked to and relied upon,"},{"id":"manas-2010:p0444:b001:l042","ordinal":20502,"en":"A trick rider, a swift foot-runner,"},{"id":"manas-2010:p0445:b001:l001","ordinal":20503,"en":"A great marksman in royal service—"},{"id":"manas-2010:p0445:b001:l002","ordinal":20504,"en":"You were the one I trusted!"},{"id":"manas-2010:p0445:b001:l003","ordinal":20505,"en":"If you are a magician, if you are a hero,"},{"id":"manas-2010:p0445:b001:l004","ordinal":20506,"en":"Who can confound the world,"},{"id":"manas-2010:p0445:b001:l005","ordinal":20507,"en":"If you are my great marksman,"},{"id":"manas-2010:p0445:b001:l006","ordinal":20508,"en":"The Burut's horse is a tulpar."},{"id":"manas-2010:p0445:b001:l007","ordinal":20509,"en":"Aim at his horse and pin it with a shot."},{"id":"manas-2010:p0445:b001:l008","ordinal":20510,"en":"If you have the strength, Karazhoy,"},{"id":"manas-2010:p0445:b001:l009","ordinal":20511,"en":"That headlong blood-drinker,"},{"id":"manas-2010:p0445:b001:l010","ordinal":20512,"en":"Leave him no life; shoot him dead!"},{"id":"manas-2010:p0445:b001:l011","ordinal":20513,"en":"Grip your bow firmly."},{"id":"manas-2010:p0445:b001:l012","ordinal":20514,"en":"The blood-drinker whose wrath is different,"},{"id":"manas-2010:p0445:b001:l013","ordinal":20515,"en":"Shoot him in the temple and lay him low!"},{"id":"manas-2010:p0445:b001:l014","ordinal":20516,"en":"Since I became Ezkara,"},{"id":"manas-2010:p0445:b001:l015","ordinal":20517,"en":"Since I won the name of khan,"},{"id":"manas-2010:p0445:b001:l016","ordinal":20518,"en":"I have never seen such a hero."},{"id":"manas-2010:p0445:b001:l017","ordinal":20519,"en":"Unless you lay him low and slaughter him,"},{"id":"manas-2010:p0445:b001:l018","ordinal":20520,"en":"He will make whatever trouble he knows."},{"id":"manas-2010:p0445:b001:l019","ordinal":20521,"en":"If this blood-drinker keeps riding,"},{"id":"manas-2010:p0445:b001:l020","ordinal":20522,"en":"He will slaughter all, leaving not one soul."},{"id":"manas-2010:p0445:b001:l021","ordinal":20523,"en":"Unless we slaughter him first,"},{"id":"manas-2010:p0445:b001:l022","ordinal":20524,"en":"That bastard blood-drinker,"},{"id":"manas-2010:p0445:b001:l023","ordinal":20525,"en":"Unless we put an end to him,"},{"id":"manas-2010:p0445:b001:l024","ordinal":20526,"en":"All of us in the assembled army,"},{"id":"manas-2010:p0445:b001:l025","ordinal":20527,"en":"He will trample us from above."},{"id":"manas-2010:p0445:b001:l026","ordinal":20528,"en":"Chasing us as far as Kakan,"},{"id":"manas-2010:p0445:b001:l027","ordinal":20529,"en":"He will butcher us and scatter blood!"},{"id":"manas-2010:p0445:b001:l028","ordinal":20530,"en":"Devise an extraordinary stratagem."},{"id":"manas-2010:p0445:b001:l029","ordinal":20531,"en":"Gather the resourceful heroes."},{"id":"manas-2010:p0445:b001:l030","ordinal":20532,"en":"Khan Zholoy of the Kalmyks,"},{"id":"manas-2010:p0445:b001:l031","ordinal":20533,"en":"Great Döödür of the Chinese,"},{"id":"manas-2010:p0445:b001:l032","ordinal":20534,"en":"Stand on opposite sides."},{"id":"manas-2010:p0445:b001:l033","ordinal":20535,"en":"Without fleeing or panicking, the blood-drinker"},{"id":"manas-2010:p0445:b001:l034","ordinal":20536,"en":"Face and fight!"},{"id":"manas-2010:p0445:b001:l035","ordinal":20537,"en":"While he is distracted by the army,"},{"id":"manas-2010:p0445:b001:l036","ordinal":20538,"en":"Resourceful marksman Karazhoy,"},{"id":"manas-2010:p0445:b001:l037","ordinal":20539,"en":"You were the resourceful marksman;"},{"id":"manas-2010:p0445:b001:l038","ordinal":20540,"en":"Keep watch upon his flank!"},{"id":"manas-2010:p0445:b001:l039","ordinal":20541,"en":"Seven thousand wrestlers, like a san host,"},{"id":"manas-2010:p0445:b001:l040","ordinal":20542,"en":"Attacking from every side,"},{"id":"manas-2010:p0445:b001:l041","ordinal":20543,"en":"I myself will watch and come up."},{"id":"manas-2010:p0445:b001:l042","ordinal":20544,"en":"Shouting, thrusting my spear once,"},{"id":"manas-2010:p0446:b001:l001","ordinal":20545,"en":"With the headlong blood-drinker"},{"id":"manas-2010:p0446:b001:l002","ordinal":20546,"en":"Let me plunge into the fray!"},{"id":"manas-2010:p0446:b001:l003","ordinal":20547,"en":"Let me level my spear without mercy."},{"id":"manas-2010:p0446:b001:l004","ordinal":20548,"en":"Distracting him, tying up his hands,"},{"id":"manas-2010:p0446:b001:l005","ordinal":20549,"en":"Let me wear him down!"},{"id":"manas-2010:p0446:b001:l006","ordinal":20550,"en":"Let Khan Zholoy emerge from the flank."},{"id":"manas-2010:p0446:b001:l007","ordinal":20551,"en":"Let us keep grappling;"},{"id":"manas-2010:p0446:b001:l008","ordinal":20552,"en":"Let us make such a spectacle."},{"id":"manas-2010:p0446:b001:l009","ordinal":20553,"en":"The mount beneath him—"},{"id":"manas-2010:p0446:b001:l010","ordinal":20554,"en":"A deep-ribbed noble steed,"},{"id":"manas-2010:p0446:b001:l011","ordinal":20555,"en":"It is a true tulpar itself,"},{"id":"manas-2010:p0446:b001:l012","ordinal":20556,"en":"One that no shot can reach."},{"id":"manas-2010:p0446:b001:l013","ordinal":20557,"en":"He has a tulpar beyond a bow's reach."},{"id":"manas-2010:p0446:b001:l014","ordinal":20558,"en":"That Burut, may your house burn,"},{"id":"manas-2010:p0446:b001:l015","ordinal":20559,"en":"Is such a valiant one."},{"id":"manas-2010:p0446:b001:l016","ordinal":20560,"en":"His weight formidable, his wrath fierce—"},{"id":"manas-2010:p0446:b001:l017","ordinal":20561,"en":"Unless we carry out this stratagem,"},{"id":"manas-2010:p0446:b001:l018","ordinal":20562,"en":"He will level all who joust with him!"},{"id":"manas-2010:p0446:b001:l019","ordinal":20563,"en":"Depriving him of his tulpar,"},{"id":"manas-2010:p0446:b001:l020","ordinal":20564,"en":"Unless we bring torment straight upon him,"},{"id":"manas-2010:p0446:b001:l021","ordinal":20565,"en":"Depriving him of his wings,"},{"id":"manas-2010:p0446:b001:l022","ordinal":20566,"en":"Unless we overwhelm and bind him,"},{"id":"manas-2010:p0446:b001:l023","ordinal":20567,"en":"Manas is no hero to be toyed with,"},{"id":"manas-2010:p0446:b001:l024","ordinal":20568,"en":"No lion who gives an easy way."},{"id":"manas-2010:p0446:b001:l025","ordinal":20569,"en":"He can gird his waist firmly,"},{"id":"manas-2010:p0446:b001:l026","ordinal":20570,"en":"Destroy those who face him,"},{"id":"manas-2010:p0446:b001:l027","ordinal":20571,"en":"And chase them as far as Beijing."},{"id":"manas-2010:p0446:b001:l028","ordinal":20572,"en":"Take aim, Karazhoy!”"},{"id":"manas-2010:p0446:b001:l029","ordinal":20573,"en":"Ezkara spoke still more forcefully."},{"id":"manas-2010:p0446:b001:l030","ordinal":20574,"en":"He was a sharp, eloquent soul."},{"id":"manas-2010:p0446:b001:l031","ordinal":20575,"en":"Ezkara, burning with fury,"},{"id":"manas-2010:p0446:b001:l032","ordinal":20576,"en":"Rich in wisdom, full of cunning,"},{"id":"manas-2010:p0446:b001:l033","ordinal":20577,"en":"Was a merciless soul."},{"id":"manas-2010:p0446:b001:l034","ordinal":20578,"en":"Having spoken many words, Ezkara"},{"id":"manas-2010:p0446:b001:l035","ordinal":20579,"en":"Now turned Chong-Küröng's head."},{"id":"manas-2010:p0446:b001:l036","ordinal":20580,"en":"When they heard Ezkara's words,"},{"id":"manas-2010:p0446:b001:l037","ordinal":20581,"en":"His great lords and heroes,"},{"id":"manas-2010:p0446:b001:l038","ordinal":20582,"en":"His strong men in sleeveless coats,"},{"id":"manas-2010:p0446:b001:l039","ordinal":20583,"en":"Deemed Ezkara's words fitting."},{"id":"manas-2010:p0446:b001:l040","ordinal":20584,"en":"His wrestler Zholoy gathered his force."},{"id":"manas-2010:p0446:b001:l041","ordinal":20585,"en":"Not one failed to summon courage and gird himself,"},{"id":"manas-2010:p0446:b001:l042","ordinal":20586,"en":"Not one remained unprepared."},{"id":"manas-2010:p0447:b001:l001","ordinal":20587,"en":"Preparing their equipment,"},{"id":"manas-2010:p0447:b001:l002","ordinal":20588,"en":"The many great lords gathered there"},{"id":"manas-2010:p0447:b001:l003","ordinal":20589,"en":"Fastened on their weapons of war."},{"id":"manas-2010:p0447:b001:l004","ordinal":20590,"en":"Their great khans and village headmen,"},{"id":"manas-2010:p0447:b001:l005","ordinal":20591,"en":"Their men who fancied themselves warriors,"},{"id":"manas-2010:p0447:b001:l006","ordinal":20592,"en":"Their heroes skilled with the spear,"},{"id":"manas-2010:p0447:b001:l007","ordinal":20593,"en":"Their treasuries of wisdom,"},{"id":"manas-2010:p0447:b001:l008","ordinal":20594,"en":"Deemed Ezkara's words fitting."},{"id":"manas-2010:p0447:b001:l009","ordinal":20595,"en":"“Whether said or unsaid, is it false?"},{"id":"manas-2010:p0447:b001:l010","ordinal":20596,"en":"My honored khan Esenkan"},{"id":"manas-2010:p0447:b001:l011","ordinal":20597,"en":"Chose us and sent us."},{"id":"manas-2010:p0447:b001:l012","ordinal":20598,"en":"‘Firing guns and drawing bows,"},{"id":"manas-2010:p0447:b001:l013","ordinal":20599,"en":"They will lay him out,’ he said, and sent us."},{"id":"manas-2010:p0447:b001:l014","ordinal":20600,"en":"‘When they clash with the blood-drinker,"},{"id":"manas-2010:p0447:b001:l015","ordinal":20601,"en":"They will slaughter him,’ he said, and sent us."},{"id":"manas-2010:p0447:b001:l016","ordinal":20602,"en":"‘Without retreating, those they encounter"},{"id":"manas-2010:p0447:b001:l017","ordinal":20603,"en":"They will seize,’ he said, and sent us."},{"id":"manas-2010:p0447:b001:l018","ordinal":20604,"en":"‘Leaving none they fight unharmed,"},{"id":"manas-2010:p0447:b001:l019","ordinal":20605,"en":"They will lay them low,’ he said, and sent us."},{"id":"manas-2010:p0447:b001:l020","ordinal":20606,"en":"Driven before the blood-drinker,"},{"id":"manas-2010:p0447:b001:l021","ordinal":20607,"en":"How can we return empty-handed?"},{"id":"manas-2010:p0447:b001:l022","ordinal":20608,"en":"‘We fled from the Burut,’ we must say."},{"id":"manas-2010:p0447:b001:l023","ordinal":20609,"en":"Before your mountain-like Esenkan,"},{"id":"manas-2010:p0447:b001:l024","ordinal":20610,"en":"How can we find a way?"},{"id":"manas-2010:p0447:b001:l025","ordinal":20611,"en":"That headlong Burut,"},{"id":"manas-2010:p0447:b001:l026","ordinal":20612,"en":"Let us try overwhelming him together."},{"id":"manas-2010:p0447:b001:l027","ordinal":20613,"en":"Rather than go about fleeing in fear,"},{"id":"manas-2010:p0447:b001:l028","ordinal":20614,"en":"Let us face him and fight."},{"id":"manas-2010:p0447:b001:l029","ordinal":20615,"en":"Shall we simply meet our death?”"},{"id":"manas-2010:p0447:b001:l030","ordinal":20616,"en":"Summoning courage, standing stiffly,"},{"id":"manas-2010:p0447:b001:l031","ordinal":20617,"en":"No soldier remained unprepared."},{"id":"manas-2010:p0447:b001:l032","ordinal":20618,"en":"Furious, blustering,"},{"id":"manas-2010:p0447:b001:l033","ordinal":20619,"en":"They unleashed their wrath!"},{"id":"manas-2010:p0447:b001:l034","ordinal":20620,"en":"“If the Burut comes, we will eat him!”"},{"id":"manas-2010:p0447:b001:l035","ordinal":20621,"en":"They turned about in fury,"},{"id":"manas-2010:p0447:b001:l036","ordinal":20622,"en":"Fastening on their weapons of war."},{"id":"manas-2010:p0447:b001:l037","ordinal":20623,"en":"The many seething wrestlers"},{"id":"manas-2010:p0447:b001:l038","ordinal":20624,"en":"All took up their clubs."},{"id":"manas-2010:p0447:b001:l039","ordinal":20625,"en":"From their exhaustion, the wrestlers"},{"id":"manas-2010:p0447:b001:l040","ordinal":20626,"en":"Were growing wild-eyed."},{"id":"manas-2010:p0447:b001:l041","ordinal":20627,"en":"They fastened on their maces."},{"id":"manas-2010:p0447:b001:l042","ordinal":20628,"en":"“If Manas slaughters us, let him!”"},{"id":"manas-2010:p0448:b001:l001","ordinal":20629,"en":"Fiercely stirring their sense of honor,"},{"id":"manas-2010:p0448:b001:l002","ordinal":20630,"en":"“Come what may!” they said, without stopping;"},{"id":"manas-2010:p0448:b001:l003","ordinal":20631,"en":"The army surged in waves."},{"id":"manas-2010:p0448:b001:l004","ordinal":20632,"en":"The hellish Zholoy and Ezkara,"},{"id":"manas-2010:p0448:b001:l005","ordinal":20633,"en":"Their many wrestlers gathered there,"},{"id":"manas-2010:p0448:b001:l006","ordinal":20634,"en":"Turning their faces to wrath,"},{"id":"manas-2010:p0448:b001:l007","ordinal":20635,"en":"Fastening on golden bows,"},{"id":"manas-2010:p0448:b001:l008","ordinal":20636,"en":"Mounting fine-looking horses,"},{"id":"manas-2010:p0448:b001:l009","ordinal":20637,"en":"Tying their broad tails tight,"},{"id":"manas-2010:p0448:b001:l010","ordinal":20638,"en":"Clad in red and motley colors,"},{"id":"manas-2010:p0448:b001:l011","ordinal":20639,"en":"Karazhoy of the Chinese"},{"id":"manas-2010:p0448:b001:l012","ordinal":20640,"en":"Rejoiced at the word “enemy.”"},{"id":"manas-2010:p0448:b001:l013","ordinal":20641,"en":"A marksman beyond all others,"},{"id":"manas-2010:p0448:b001:l014","ordinal":20642,"en":"If he came to a broad yellow plain,"},{"id":"manas-2010:p0448:b001:l015","ordinal":20643,"en":"He hid behind half a dry stalk."},{"id":"manas-2010:p0448:b001:l016","ordinal":20644,"en":"If ill was spoken, it would not stick to him."},{"id":"manas-2010:p0448:b001:l017","ordinal":20645,"en":"From a well-tracked target,"},{"id":"manas-2010:p0448:b001:l018","ordinal":20646,"en":"From the exposed tip of a spear,"},{"id":"manas-2010:p0448:b001:l019","ordinal":20647,"en":"The pig would not miss when he shot."},{"id":"manas-2010:p0448:b001:l020","ordinal":20648,"en":"Running on foot, he was very swift."},{"id":"manas-2010:p0448:b001:l021","ordinal":20649,"en":"Confounding those who provoked him,"},{"id":"manas-2010:p0448:b001:l022","ordinal":20650,"en":"He would bring great havoc on the world."},{"id":"manas-2010:p0448:b001:l023","ordinal":20651,"en":"Clad in red and motley colors,"},{"id":"manas-2010:p0448:b001:l024","ordinal":20652,"en":"That infidel, may your house burn,"},{"id":"manas-2010:p0448:b001:l025","ordinal":20653,"en":"Bounded along like a roe deer."},{"id":"manas-2010:p0448:b001:l026","ordinal":20654,"en":"Karazhoy came prepared."},{"id":"manas-2010:p0448:b001:l027","ordinal":20655,"en":"Many great lords made ready."},{"id":"manas-2010:p0448:b001:l028","ordinal":20656,"en":"Their resourceful men and khans,"},{"id":"manas-2010:p0448:b001:l029","ordinal":20657,"en":"Amid havoc and uproar,"},{"id":"manas-2010:p0448:b001:l030","ordinal":20658,"en":"Prepared, measuring out the ground."},{"id":"manas-2010:p0448:b001:l031","ordinal":20659,"en":"The purpose of bringing such suffering—"},{"id":"manas-2010:p0448:b001:l032","ordinal":20660,"en":"To make the naive hero go on foot,"},{"id":"manas-2010:p0448:b001:l033","ordinal":20661,"en":"And bind him for Beijing."},{"id":"manas-2010:p0448:b001:l034","ordinal":20662,"en":"He spoke weighty, grave words."},{"id":"manas-2010:p0448:b001:l035","ordinal":20663,"en":"He made the promise firm."},{"id":"manas-2010:p0448:b001:l036","ordinal":20664,"en":"They prepared their maces;"},{"id":"manas-2010:p0448:b001:l037","ordinal":20665,"en":"Not one soul remained unprepared."},{"id":"manas-2010:p0448:b001:l038","ordinal":20666,"en":"From the army that had accompanied them,"},{"id":"manas-2010:p0448:b001:l039","ordinal":20667,"en":"They slaughtered a thousand apiece."},{"id":"manas-2010:p0448:b001:l040","ordinal":20668,"en":"“Let this be the fate of a fugitive,” they said."},{"id":"manas-2010:p0448:b001:l041","ordinal":20669,"en":"Their bronze-cast idol"},{"id":"manas-2010:p0448:b001:l042","ordinal":20670,"en":"They set firmly against their breasts."},{"id":"manas-2010:p0449:b001:l001","ordinal":20671,"en":"Ezkara and Zholoy, the two khans,"},{"id":"manas-2010:p0449:b001:l002","ordinal":20672,"en":"“If we flee, slaughter us,” they said."},{"id":"manas-2010:p0449:b001:l003","ordinal":20673,"en":"Many souls made a pledge."},{"id":"manas-2010:p0449:b001:l004","ordinal":20674,"en":"Breaking off stone, making a fortress,"},{"id":"manas-2010:p0449:b001:l005","ordinal":20675,"en":"Blocking the route so none could leave,"},{"id":"manas-2010:p0449:b001:l006","ordinal":20676,"en":"Their great lords and khans,"},{"id":"manas-2010:p0449:b001:l007","ordinal":20677,"en":"The Chinese, their honor aroused,"},{"id":"manas-2010:p0449:b001:l008","ordinal":20678,"en":"Not one remained unprepared."},{"id":"manas-2010:p0449:b001:l009","ordinal":20679,"en":"Against Manas visited by Kydyr,"},{"id":"manas-2010:p0449:b001:l010","ordinal":20680,"en":"Such was the Chinese people's fierce battle."},{"id":"manas-2010:p0449:b001:l011","ordinal":20681,"en":"They slaughtered animals for provisions."},{"id":"manas-2010:p0449:b001:l012","ordinal":20682,"en":"From the Manchus and Kalmyks"},{"id":"manas-2010:p0449:b001:l013","ordinal":20683,"en":"They set a strong guard."},{"id":"manas-2010:p0449:b001:l014","ordinal":20684,"en":"Until the appointed days were over,"},{"id":"manas-2010:p0449:b001:l015","ordinal":20685,"en":"The countless Chinese who came surging"},{"id":"manas-2010:p0449:b001:l016","ordinal":20686,"en":"Stayed in their encampment."},{"id":"manas-2010:p0449:b001:l017","ordinal":20687,"en":"Now let us tell,"},{"id":"manas-2010:p0449:b001:l018","ordinal":20688,"en":"Before the slaughter and battle,"},{"id":"manas-2010:p0449:b001:l019","ordinal":20689,"en":"Before the Chinese swarm to fullness,"},{"id":"manas-2010:p0449:b001:l020","ordinal":20690,"en":"The tale of your uncle, hero Koshoy."},{"id":"manas-2010:p0449:b003:l001","ordinal":20691,"en":"Preparing a white standard and banner,"},{"id":"manas-2010:p0449:b003:l002","ordinal":20692,"en":"When people moved to higher ground,"},{"id":"manas-2010:p0449:b003:l003","ordinal":20693,"en":"In the season when horses' tongues turn black,"},{"id":"manas-2010:p0449:b003:l004","ordinal":20694,"en":"Within all the tulpars,"},{"id":"manas-2010:p0449:b003:l005","ordinal":20695,"en":"Rib fat formed and fat filled them."},{"id":"manas-2010:p0449:b003:l006","ordinal":20696,"en":"Your uncle, champion Koshoy,"},{"id":"manas-2010:p0449:b003:l007","ordinal":20697,"en":"An exceptional wrestler, an exceptional lion,"},{"id":"manas-2010:p0449:b003:l008","ordinal":20698,"en":"A sage rich in wisdom."},{"id":"manas-2010:p0449:b003:l009","ordinal":20699,"en":"Your tiger uncle, Khan Koshoy,"},{"id":"manas-2010:p0449:b003:l010","ordinal":20700,"en":"Though wind struck, no flood could strike;"},{"id":"manas-2010:p0449:b003:l011","ordinal":20701,"en":"He also had the shelter of a canopy."},{"id":"manas-2010:p0449:b003:l012","ordinal":20702,"en":"Your uncle, the wolf of war,"},{"id":"manas-2010:p0449:b003:l013","ordinal":20703,"en":"Also possessed heroism."},{"id":"manas-2010:p0449:b003:l014","ordinal":20704,"en":"Koshoy, a judge of the people,"},{"id":"manas-2010:p0449:b003:l015","ordinal":20705,"en":"Also held a spiritual master's standing."},{"id":"manas-2010:p0449:b003:l016","ordinal":20706,"en":"Rich in wisdom, a great magician,"},{"id":"manas-2010:p0449:b003:l017","ordinal":20707,"en":"Your uncle, the warrior Koshoy,"},{"id":"manas-2010:p0450:b001:l001","ordinal":20708,"en":"Also possessed eloquence."},{"id":"manas-2010:p0450:b001:l002","ordinal":20709,"en":"Your aged uncle Koshoy"},{"id":"manas-2010:p0450:b001:l003","ordinal":20710,"en":"Possessed every kind of skill."},{"id":"manas-2010:p0450:b001:l004","ordinal":20711,"en":"A banner for a great people,"},{"id":"manas-2010:p0450:b001:l005","ordinal":20712,"en":"Your saintly uncle Koshoy"},{"id":"manas-2010:p0450:b001:l006","ordinal":20713,"en":"Also possessed a princely court."},{"id":"manas-2010:p0450:b001:l007","ordinal":20714,"en":"Your extraordinary uncle Koshoy"},{"id":"manas-2010:p0450:b001:l008","ordinal":20715,"en":"Also possessed a mullah's learning."},{"id":"manas-2010:p0450:b001:l009","ordinal":20716,"en":"Holding a spear, breaking the ranks,"},{"id":"manas-2010:p0450:b001:l010","ordinal":20717,"en":"He also possessed skill."},{"id":"manas-2010:p0450:b001:l011","ordinal":20718,"en":"Riding a tulpar, bearing a banner,"},{"id":"manas-2010:p0450:b001:l012","ordinal":20719,"en":"Your falcon uncle Koshoy"},{"id":"manas-2010:p0450:b001:l013","ordinal":20720,"en":"Also possessed excellence."},{"id":"manas-2010:p0450:b001:l014","ordinal":20721,"en":"There were heroes, there were khans;"},{"id":"manas-2010:p0450:b001:l015","ordinal":20722,"en":"Every soul of understanding was there."},{"id":"manas-2010:p0450:b001:l016","ordinal":20723,"en":"Aykhozho of Andijan,"},{"id":"manas-2010:p0450:b001:l017","ordinal":20724,"en":"There were spiritual masters, Sufis, and elders."},{"id":"manas-2010:p0450:b001:l018","ordinal":20725,"en":"Beside your uncle Koshoy"},{"id":"manas-2010:p0450:b001:l019","ordinal":20726,"en":"There were all those many people."},{"id":"manas-2010:p0450:b001:l020","ordinal":20727,"en":"Your aged uncle Koshoy,"},{"id":"manas-2010:p0450:b001:l021","ordinal":20728,"en":"The saint upon whom they relied,"},{"id":"manas-2010:p0450:b001:l022","ordinal":20729,"en":"Entered the caliph's presence and received a letter,"},{"id":"manas-2010:p0450:b001:l023","ordinal":20730,"en":"Received a prince's blessing."},{"id":"manas-2010:p0450:b001:l024","ordinal":20731,"en":"Giving allegiance together with twelve,"},{"id":"manas-2010:p0450:b001:l025","ordinal":20732,"en":"Your leopard uncle Koshoy"},{"id":"manas-2010:p0450:b001:l026","ordinal":20733,"en":"Was called the Supremely Renowned."},{"id":"manas-2010:p0450:b001:l027","ordinal":20734,"en":"Your uncle Koshoy grew excited;"},{"id":"manas-2010:p0450:b001:l028","ordinal":20735,"en":"A profound thought entered his head."},{"id":"manas-2010:p0450:b001:l029","ordinal":20736,"en":"He stopped at Chech-Töbö."}]
