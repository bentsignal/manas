[{"id":"semetey-1-2013:p0564:b003:l010","ordinal":119809,"en":"When they came to grapple,"},{"id":"semetey-1-2013:p0564:b003:l011","ordinal":119810,"en":"He bent their spears,"},{"id":"semetey-1-2013:p0564:b003:l012","ordinal":119811,"en":"Took them all alive without killing them,"},{"id":"semetey-1-2013:p0564:b003:l013","ordinal":119812,"en":"And loaded them upon their horses."},{"id":"semetey-1-2013:p0564:b003:l014","ordinal":119813,"en":"Intending to go to Talas,"},{"id":"semetey-1-2013:p0564:b003:l015","ordinal":119814,"en":"He presented the forty nobles,"},{"id":"semetey-1-2013:p0564:b003:l016","ordinal":119815,"en":"With Ezkara at their head,"},{"id":"semetey-1-2013:p0564:b003:l017","ordinal":119816,"en":"He presented them to Manas."},{"id":"semetey-1-2013:p0564:b003:l018","ordinal":119817,"en":"Into Beijing, lying dark,"},{"id":"semetey-1-2013:p0564:b003:l019","ordinal":119818,"en":"He too went straight, extending his spear."},{"id":"semetey-1-2013:p0564:b003:l020","ordinal":119819,"en":"The grim-looking Chinese and many Manchus,"},{"id":"semetey-1-2013:p0564:b003:l021","ordinal":119820,"en":"He exhausted them and broke their backs."},{"id":"semetey-1-2013:p0564:b003:l022","ordinal":119821,"en":"Against this seething Kakan,"},{"id":"semetey-1-2013:p0564:b003:l023","ordinal":119822,"en":"He charged, extending his spear."},{"id":"semetey-1-2013:p0564:b003:l024","ordinal":119823,"en":"The swarming Chinese and many Manchus,"},{"id":"semetey-1-2013:p0564:b003:l025","ordinal":119824,"en":"Thus he broke their backs."},{"id":"semetey-1-2013:p0564:b003:l026","ordinal":119825,"en":"My precious mother Kanykei,"},{"id":"semetey-1-2013:p0564:b003:l027","ordinal":119826,"en":"Having him mounted on Kökala,"},{"id":"semetey-1-2013:p0564:b003:l028","ordinal":119827,"en":"Having him clothed in blue rep,"},{"id":"semetey-1-2013:p0564:b003:l029","ordinal":119828,"en":"Making the Chinese cry out,"},{"id":"semetey-1-2013:p0564:b003:l030","ordinal":119829,"en":"Driving them toward Beijing,"},{"id":"semetey-1-2013:p0564:b003:l031","ordinal":119830,"en":"My godfather Chubak,"},{"id":"semetey-1-2013:p0564:b003:l032","ordinal":119831,"en":"Thus she clearly portrayed him in the picture."},{"id":"semetey-1-2013:p0564:b003:l034","ordinal":119832,"en":"When he looked this way again,"},{"id":"semetey-1-2013:p0564:b003:l035","ordinal":119833,"en":"The finest of sixty,"},{"id":"semetey-1-2013:p0564:b003:l036","ordinal":119834,"en":"The champion of forty jaisangs,"},{"id":"semetey-1-2013:p0564:b003:l037","ordinal":119835,"en":"Wearing a coat blue as iron,"},{"id":"semetey-1-2013:p0564:b003:l038","ordinal":119836,"en":"Riding a splendid courser,"},{"id":"semetey-1-2013:p0564:b003:l039","ordinal":119837,"en":"Holding a sword in quiet readiness,"},{"id":"semetey-1-2013:p0564:b004:l001","ordinal":119838,"en":"The way he took his spear was something apart,"},{"id":"semetey-1-2013:p0564:b004:l002","ordinal":119839,"en":"Stealthy as a lion."},{"id":"semetey-1-2013:p0564:b004:l003","ordinal":119840,"en":"He too was short of stature, broad of shoulder,"},{"id":"semetey-1-2013:p0564:b004:l005","ordinal":119841,"en":"He too had stately dark eyes,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0564:b004:l006","ordinal":119842,"en":"The trusty support of the Karakalpaks,"},{"id":"semetey-1-2013:p0564:b004:l007","ordinal":119843,"en":"Syrgak of my khan father, Khan Manas."},{"id":"semetey-1-2013:p0564:b004:l008","ordinal":119844,"en":"He never drew back from fire;"},{"id":"semetey-1-2013:p0564:b004:l009","ordinal":119845,"en":"He never recoiled a hair's breadth from death."},{"id":"semetey-1-2013:p0564:b004:l010","ordinal":119846,"en":"He girded his waist firmly;"},{"id":"semetey-1-2013:p0564:b004:l011","ordinal":119847,"en":"If seventy thousand enemies came,"},{"id":"semetey-1-2013:p0564:b004:l012","ordinal":119848,"en":"He entered the attack with his coat thrown open."},{"id":"semetey-1-2013:p0564:b004:l013","ordinal":119849,"en":"Light upon a horse, fit for a foal,"},{"id":"semetey-1-2013:p0564:b004:l014","ordinal":119850,"en":"Sleepless, alert upon the road,"},{"id":"semetey-1-2013:p0564:b004:l015","ordinal":119851,"en":"Never resting upon an elbow,"},{"id":"semetey-1-2013:p0564:b004:l016","ordinal":119852,"en":"Never taking even a brief nap."},{"id":"semetey-1-2013:p0564:b004:l017","ordinal":119853,"en":"If an enemy leveled a weapon,"},{"id":"semetey-1-2013:p0564:b004:l018","ordinal":119854,"en":"None he met remained alive."},{"id":"semetey-1-2013:p0564:b004:l019","ordinal":119855,"en":"His strength reached through this world."},{"id":"semetey-1-2013:p0564:b004:l020","ordinal":119856,"en":"Manas and this wolf-man"},{"id":"semetey-1-2013:p0564:b004:l021","ordinal":119857,"en":"Were sons of elder and younger brothers."},{"id":"semetey-1-2013:p0564:b004:l022","ordinal":119858,"en":"The samovars are gold, the tea is cheap;"},{"id":"semetey-1-2013:p0564:b004:l023","ordinal":119859,"en":"Among the cities of Islam"},{"id":"semetey-1-2013:p0564:b004:l024","ordinal":119860,"en":"There is no city like Samarkand."},{"id":"semetey-1-2013:p0564:b004:l025","ordinal":119861,"en":"If you look at a hero in jousting,"},{"id":"semetey-1-2013:p0564:b004:l026","ordinal":119862,"en":"There is no young man like dear Syrgak."},{"id":"semetey-1-2013:p0564:b004:l027","ordinal":119863,"en":"When Alman went scouting,"},{"id":"semetey-1-2013:p0564:b004:l028","ordinal":119864,"en":"All his giants were there."},{"id":"semetey-1-2013:p0564:b004:l029","ordinal":119865,"en":"My khan father, departed for eternity,"},{"id":"semetey-1-2013:p0564:b004:l030","ordinal":119866,"en":"With the forty companions at their head,"},{"id":"semetey-1-2013:p0564:b004:l031","ordinal":119867,"en":"The handful of the Islamic faithful"},{"id":"semetey-1-2013:p0564:b004:l032","ordinal":119868,"en":"When he sent them out in a long line,"},{"id":"semetey-1-2013:p0564:b004:l033","ordinal":119869,"en":"Then, a saint with second sight,"},{"id":"semetey-1-2013:p0564:b004:l034","ordinal":119870,"en":"My godfather Almambet,"},{"id":"semetey-1-2013:p0564:b004:l035","ordinal":119871,"en":"When he chose Syrgak,"},{"id":"semetey-1-2013:p0564:b004:l036","ordinal":119872,"en":"When they scattered the unbelievers' livestock,"},{"id":"semetey-1-2013:p0564:b004:l038","ordinal":119873,"en":"Countless cattle gathered as customs dues,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0564:b004:l039","ordinal":119874,"en":"The myriad livestock in Beijing,"},{"id":"semetey-1-2013:p0565:b003:l001","ordinal":119875,"en":"When they raided and fled from Keng-Shor,"},{"id":"semetey-1-2013:p0565:b003:l002","ordinal":119876,"en":"No yearling or two-year-old left roaming the plain,"},{"id":"semetey-1-2013:p0565:b003:l003","ordinal":119877,"en":"When Almam scattered every one,"},{"id":"semetey-1-2013:p0565:b003:l004","ordinal":119878,"en":"When, with loud cries, the horses"},{"id":"semetey-1-2013:p0565:b003:l005","ordinal":119879,"en":"Were all driven away,"},{"id":"semetey-1-2013:p0565:b003:l006","ordinal":119880,"en":"Drizzle turning to snow in gusting wind,"},{"id":"semetey-1-2013:p0565:b003:l007","ordinal":119881,"en":"Cloudy by day, clear by night,"},{"id":"semetey-1-2013:p0565:b003:l008","ordinal":119882,"en":"When Almambet worked his weather magic,"},{"id":"semetey-1-2013:p0565:b003:l009","ordinal":119883,"en":"Castrated from a stallion to a gelding,"},{"id":"semetey-1-2013:p0565:b003:l010","ordinal":119884,"en":"A Karabair warhorse,"},{"id":"semetey-1-2013:p0565:b003:l011","ordinal":119885,"en":"Sieve-lunged and copper-limbed,"},{"id":"semetey-1-2013:p0565:b003:l012","ordinal":119886,"en":"When Kartküröng began leading the herd,"},{"id":"semetey-1-2013:p0565:b003:l014","ordinal":119887,"en":"The countless Chinese and myriad Manchus,"},{"id":"semetey-1-2013:p0565:b003:l015","ordinal":119888,"en":"Alööke's Konurbai,"},{"id":"semetey-1-2013:p0565:b003:l016","ordinal":119889,"en":"Shypshaidar, Soorunduk's son,"},{"id":"semetey-1-2013:p0565:b003:l017","ordinal":119890,"en":"All the wrestlers charging,"},{"id":"semetey-1-2013:p0565:b003:l018","ordinal":119891,"en":"Along the route Konurbai had scouted,"},{"id":"semetey-1-2013:p0565:b003:l019","ordinal":119892,"en":"With an army of many tens of thousands,"},{"id":"semetey-1-2013:p0565:b003:l020","ordinal":119893,"en":"When they charged and began battle,"},{"id":"semetey-1-2013:p0565:b003:l021","ordinal":119894,"en":"The swift and skillful horseman,"},{"id":"semetey-1-2013:p0565:b003:l022","ordinal":119895,"en":"The most skilled among spearmen,"},{"id":"semetey-1-2013:p0565:b003:l023","ordinal":119896,"en":"Konurbai, above them all,"},{"id":"semetey-1-2013:p0565:b003:l024","ordinal":119897,"en":"The finest in knowing the enemy's tricks,"},{"id":"semetey-1-2013:p0565:b003:l025","ordinal":119898,"en":"When all the Chinese people swept forward,"},{"id":"semetey-1-2013:p0565:b003:l026","ordinal":119899,"en":"About to catch up,"},{"id":"semetey-1-2013:p0565:b003:l027","ordinal":119900,"en":"When they were about to wrest away the herd"},{"id":"semetey-1-2013:p0565:b003:l028","ordinal":119901,"en":"And take it off,"},{"id":"semetey-1-2013:p0565:b003:l029","ordinal":119902,"en":"At that time Muzburchak and Khan Kökchö were absent;"},{"id":"semetey-1-2013:p0565:b003:l031","ordinal":119903,"en":"All the Muslims were absent."},{"id":"semetey-1-2013:p0565:b003:l032","ordinal":119904,"en":"Refusing to give up that herd,"},{"id":"semetey-1-2013:p0565:b003:l033","ordinal":119905,"en":"Bloodied and steeped in blood,"},{"id":"semetey-1-2013:p0565:b003:l034","ordinal":119906,"en":"Standing their ground and fighting,"},{"id":"semetey-1-2013:p0565:b003:l035","ordinal":119907,"en":"Fighting in turn,"},{"id":"semetey-1-2013:p0565:b003:l036","ordinal":119908,"en":"Wheeling their horses away,"},{"id":"semetey-1-2013:p0565:b003:l037","ordinal":119909,"en":"Sparing none of their lives,"},{"id":"semetey-1-2013:p0565:b003:l038","ordinal":119910,"en":"The Chinese and many Manchus,"},{"id":"semetey-1-2013:p0565:b003:l039","ordinal":119911,"en":"When the Chinese swarmed upon them,"},{"id":"semetey-1-2013:p0565:b004:l001","ordinal":119912,"en":"Drawing bows like falling rain,"},{"id":"semetey-1-2013:p0565:b004:l002","ordinal":119913,"en":"Firing shots like hail,"},{"id":"semetey-1-2013:p0565:b004:l003","ordinal":119914,"en":"When the Chinese swept forward,"},{"id":"semetey-1-2013:p0565:b004:l004","ordinal":119915,"en":"Khan Alman, seeing their onrush,"},{"id":"semetey-1-2013:p0565:b004:l005","ordinal":119916,"en":"Summoned his courage."},{"id":"semetey-1-2013:p0565:b004:l006","ordinal":119917,"en":"Leaning down, he speared warriors,"},{"id":"semetey-1-2013:p0565:b004:l007","ordinal":119918,"en":"Spearing two or three at once."},{"id":"semetey-1-2013:p0565:b004:l008","ordinal":119919,"en":"Seven, with the warrior Joloi at their head,"},{"id":"semetey-1-2013:p0565:b004:l009","ordinal":119920,"en":"When he speared them in a row,"},{"id":"semetey-1-2013:p0565:b004:l010","ordinal":119921,"en":"What warriors those seven were!"},{"id":"semetey-1-2013:p0565:b004:l011","ordinal":119922,"en":"Spearing all seven in succession,"},{"id":"semetey-1-2013:p0565:b004:l012","ordinal":119923,"en":"What a lion my Alake was!"},{"id":"semetey-1-2013:p0565:b004:l013","ordinal":119924,"en":"The seven put a terrible strain upon him;"},{"id":"semetey-1-2013:p0565:b004:l014","ordinal":119925,"en":"His resources fled, his strength was gone,"},{"id":"semetey-1-2013:p0565:b004:l015","ordinal":119926,"en":"He slipped backward from his saddle,"},{"id":"semetey-1-2013:p0565:b004:l016","ordinal":119927,"en":"His feet slipped from the stirrups."},{"id":"semetey-1-2013:p0565:b004:l017","ordinal":119928,"en":"The white reins woven in okoro fashion"},{"id":"semetey-1-2013:p0565:b004:l018","ordinal":119929,"en":"He could not grasp properly."},{"id":"semetey-1-2013:p0565:b004:l019","ordinal":119930,"en":"Into the golden-footed stirrups"},{"id":"semetey-1-2013:p0565:b004:l020","ordinal":119931,"en":"He could not set his feet."},{"id":"semetey-1-2013:p0565:b004:l021","ordinal":119932,"en":"While Almam had not recovered his senses,"},{"id":"semetey-1-2013:p0565:b004:l022","ordinal":119933,"en":"A fellow skilled among spearmen,"},{"id":"semetey-1-2013:p0565:b004:l023","ordinal":119934,"en":"A mighty fellow who knew the enemy's tricks,"},{"id":"semetey-1-2013:p0565:b004:l025","ordinal":119935,"en":"Khan Konurbai, the precious lion,"},{"id":"semetey-1-2013:p0565:b004:l026","ordinal":119936,"en":"Upon Almambet, havoc—"},{"id":"semetey-1-2013:p0565:b004:l027","ordinal":119937,"en":"That was the place he brought it."},{"id":"semetey-1-2013:p0565:b004:l028","ordinal":119938,"en":"Striking Alkara with his whip,"},{"id":"semetey-1-2013:p0565:b004:l029","ordinal":119939,"en":"The warrior Konurbai arrived."},{"id":"semetey-1-2013:p0565:b004:l030","ordinal":119940,"en":"Among the countless wrestlers,"},{"id":"semetey-1-2013:p0565:b004:l031","ordinal":119941,"en":"When he reached Almam,"},{"id":"semetey-1-2013:p0565:b004:l032","ordinal":119942,"en":"From Sarala's back"},{"id":"semetey-1-2013:p0565:b004:l033","ordinal":119943,"en":"He struck him down as he passed."},{"id":"semetey-1-2013:p0565:b004:l034","ordinal":119944,"en":"Thundering like Mount Opol,"},{"id":"semetey-1-2013:p0565:b004:l035","ordinal":119945,"en":"Almam the leopard, the precious lion,"},{"id":"semetey-1-2013:p0565:b004:l036","ordinal":119946,"en":"Fell to the earth."},{"id":"semetey-1-2013:p0565:b004:l037","ordinal":119947,"en":"When Almam fell from his horse,"},{"id":"semetey-1-2013:p0565:b004:l038","ordinal":119948,"en":"He gave an order,"},{"id":"semetey-1-2013:p0565:b004:l039","ordinal":119949,"en":"Konurbai to his wrestler—"},{"id":"semetey-1-2013:p0566:b003:l001","ordinal":119950,"en":"He had given the command,"},{"id":"semetey-1-2013:p0566:b003:l002","ordinal":119951,"en":"Upon Almambet's head"},{"id":"semetey-1-2013:p0566:b003:l003","ordinal":119952,"en":"He had brought this horror:"},{"id":"semetey-1-2013:p0566:b003:l004","ordinal":119953,"en":"“Surround the dismounted Burut"},{"id":"semetey-1-2013:p0566:b003:l005","ordinal":119954,"en":"This very moment;"},{"id":"semetey-1-2013:p0566:b003:l006","ordinal":119955,"en":"To Karykan of Beijing"},{"id":"semetey-1-2013:p0566:b003:l007","ordinal":119956,"en":"Take him bound and alive."},{"id":"semetey-1-2013:p0566:b003:l008","ordinal":119957,"en":"Of half the realm of Beijing,"},{"id":"semetey-1-2013:p0566:b003:l009","ordinal":119958,"en":"Ask for the khan's rule."},{"id":"semetey-1-2013:p0566:b003:l010","ordinal":119959,"en":"Into a dungeon forty rope-lengths deep,"},{"id":"semetey-1-2013:p0566:b003:l011","ordinal":119960,"en":"Binding both his hands,"},{"id":"semetey-1-2013:p0566:b003:l012","ordinal":119961,"en":"Gouging out both his eyes,"},{"id":"semetey-1-2013:p0566:b003:l013","ordinal":119962,"en":"Into that pit they have dug,"},{"id":"semetey-1-2013:p0566:b003:l014","ordinal":119963,"en":"Take him and cast him alive."},{"id":"semetey-1-2013:p0566:b003:l015","ordinal":119964,"en":"On the fool who fled to the Buruts,"},{"id":"semetey-1-2013:p0566:b003:l016","ordinal":119965,"en":"Take your revenge this way!”"},{"id":"semetey-1-2013:p0566:b003:l017","ordinal":119966,"en":"His warriors heard the order;"},{"id":"semetey-1-2013:p0566:b003:l018","ordinal":119967,"en":"Swarming thick as ants,"},{"id":"semetey-1-2013:p0566:b003:l019","ordinal":119968,"en":"Teeming like mosquitoes,"},{"id":"semetey-1-2013:p0566:b003:l020","ordinal":119969,"en":"The Chinese closed upon him."},{"id":"semetey-1-2013:p0566:b003:l021","ordinal":119970,"en":"Their lasso-men cast their lassos,"},{"id":"semetey-1-2013:p0566:b003:l022","ordinal":119971,"en":"Their spearmen thrust their spears;"},{"id":"semetey-1-2013:p0566:b003:l023","ordinal":119972,"en":"Mail-clad men with iron ropes"},{"id":"semetey-1-2013:p0566:b003:l024","ordinal":119973,"en":"Surrounded my Almam,"},{"id":"semetey-1-2013:p0566:b003:l025","ordinal":119974,"en":"All those dagger-handed men."},{"id":"semetey-1-2013:p0566:b003:l026","ordinal":119975,"en":"When the Chinese pressed him hard,"},{"id":"semetey-1-2013:p0566:b003:l027","ordinal":119976,"en":"He had no cliff where geese wheeled,"},{"id":"semetey-1-2013:p0566:b003:l028","ordinal":119977,"en":"To stand as his shelter,"},{"id":"semetey-1-2013:p0566:b003:l029","ordinal":119978,"en":"To break him free—"},{"id":"semetey-1-2013:p0566:b003:l030","ordinal":119979,"en":"No mountain, Manas the leopard;"},{"id":"semetey-1-2013:p0566:b003:l031","ordinal":119980,"en":"No Chubak, Akbaltai's son;"},{"id":"semetey-1-2013:p0566:b003:l032","ordinal":119981,"en":"No Ajybai, no Bakai khan;"},{"id":"semetey-1-2013:p0566:b003:l033","ordinal":119982,"en":"None of the forty heroes."},{"id":"semetey-1-2013:p0566:b003:l034","ordinal":119983,"en":"Your lion Almam lamented,"},{"id":"semetey-1-2013:p0566:b003:l035","ordinal":119984,"en":"Standing there among the Chinese!"},{"id":"semetey-1-2013:p0566:b003:l036","ordinal":119985,"en":"“Their horses, raided and driven off,"},{"id":"semetey-1-2013:p0566:b003:l037","ordinal":119986,"en":"It seems I came to divide;"},{"id":"semetey-1-2013:p0566:b003:l038","ordinal":119987,"en":"My death has come from the infidels;"},{"id":"semetey-1-2013:p0566:b003:l039","ordinal":119988,"en":"With my blood spilled here,"},{"id":"semetey-1-2013:p0566:b004:l001","ordinal":119989,"en":"It seems I came to die,"},{"id":"semetey-1-2013:p0566:b004:l002","ordinal":119990,"en":"Humiliation no human ever sees—"},{"id":"semetey-1-2013:p0566:b004:l003","ordinal":119991,"en":"It seems I came to see it.”"},{"id":"semetey-1-2013:p0566:b004:l004","ordinal":119992,"en":"Giving his last wishes, reciting the creed,"},{"id":"semetey-1-2013:p0566:b004:l005","ordinal":119993,"en":"Despairing of life, saying, “I am lost,”"},{"id":"semetey-1-2013:p0566:b004:l006","ordinal":119994,"en":"He fought without yielding;"},{"id":"semetey-1-2013:p0566:b004:l007","ordinal":119995,"en":"My leopard Almam, that dear lion,"},{"id":"semetey-1-2013:p0566:b004:l008","ordinal":119996,"en":"Struggled to save his life,"},{"id":"semetey-1-2013:p0566:b004:l009","ordinal":119997,"en":"Not letting the lasso-men catch him,"},{"id":"semetey-1-2013:p0566:b004:l010","ordinal":119998,"en":"By mail-clad men with iron ropes"},{"id":"semetey-1-2013:p0566:b004:l011","ordinal":119999,"en":"Not letting himself be ringed."},{"id":"semetey-1-2013:p0566:b004:l012","ordinal":120000,"en":"While your Alake stood thus,"},{"id":"semetey-1-2013:p0566:b004:l013","ordinal":120001,"en":"Syrgak the leopard, the renowned hero,"},{"id":"semetey-1-2013:p0566:b004:l014","ordinal":120002,"en":"Whose presence was unlike any other's,"},{"id":"semetey-1-2013:p0566:b004:l015","ordinal":120003,"en":"His fly-like soul shriveling,"},{"id":"semetey-1-2013:p0566:b004:l016","ordinal":120004,"en":"Dark tears streaming from his eyes"},{"id":"semetey-1-2013:p0566:b004:l017","ordinal":120005,"en":"And rolling down his collarbone:"},{"id":"semetey-1-2013:p0566:b004:l018","ordinal":120006,"en":"“The massed Chinese have engulfed him;"},{"id":"semetey-1-2013:p0566:b004:l019","ordinal":120007,"en":"Let me reach my Alake,"},{"id":"semetey-1-2013:p0566:b004:l020","ordinal":120008,"en":"Rather than remain alive, before him"},{"id":"semetey-1-2013:p0566:b004:l021","ordinal":120009,"en":"Let me fall in sacrifice."},{"id":"semetey-1-2013:p0566:b004:l022","ordinal":120010,"en":"Let me arrive before Almam;"},{"id":"semetey-1-2013:p0566:b004:l023","ordinal":120011,"en":"Parted from my Alake,"},{"id":"semetey-1-2013:p0566:b004:l024","ordinal":120012,"en":"My twin lamb, my companion,"},{"id":"semetey-1-2013:p0566:b004:l025","ordinal":120013,"en":"Having devoured my twin,"},{"id":"semetey-1-2013:p0566:b004:l026","ordinal":120014,"en":"How could I leave without longing?"},{"id":"semetey-1-2013:p0566:b004:l027","ordinal":120015,"en":"Against the red-naveled Chinese,"},{"id":"semetey-1-2013:p0566:b004:l028","ordinal":120016,"en":"The infidels of the dark faith,"},{"id":"semetey-1-2013:p0566:b004:l029","ordinal":120017,"en":"The head-severing warriors,"},{"id":"semetey-1-2013:p0566:b004:l030","ordinal":120018,"en":"Let me come with my waist girded,"},{"id":"semetey-1-2013:p0566:b004:l031","ordinal":120019,"en":"Charge alone and attack,"},{"id":"semetey-1-2013:p0566:b004:l032","ordinal":120020,"en":"Till the yielding stalks ripen,"},{"id":"semetey-1-2013:p0566:b004:l033","ordinal":120021,"en":"Till autumn's gossamer flies,"},{"id":"semetey-1-2013:p0566:b004:l034","ordinal":120022,"en":"Let me fight hard and wreak slaughter,"},{"id":"semetey-1-2013:p0566:b004:l035","ordinal":120023,"en":"And my fierce Almam the leopard—"},{"id":"semetey-1-2013:p0566:b004:l036","ordinal":120024,"en":"Let me break him free!”"},{"id":"semetey-1-2013:p0566:b004:l037","ordinal":120025,"en":"Kokchebich beneath him,"},{"id":"semetey-1-2013:p0566:b004:l038","ordinal":120026,"en":"He whipped now right, now left,"},{"id":"semetey-1-2013:p0566:b004:l039","ordinal":120027,"en":"And spurred on either side,"},{"id":"semetey-1-2013:p0567:b003:l001","ordinal":120028,"en":"Roaring in fury,"},{"id":"semetey-1-2013:p0567:b003:l002","ordinal":120029,"en":"Calling, “Alake, leopard!”"},{"id":"semetey-1-2013:p0567:b003:l003","ordinal":120030,"en":"Into the Chinese ahead, the many warriors,"},{"id":"semetey-1-2013:p0567:b003:l004","ordinal":120031,"en":"Your Syrgak charged without wavering and attacked."},{"id":"semetey-1-2013:p0567:b003:l006","ordinal":120032,"en":"Those he met were killed;"},{"id":"semetey-1-2013:p0567:b003:l007","ordinal":120033,"en":"Those he met shed their blood."},{"id":"semetey-1-2013:p0567:b003:l008","ordinal":120034,"en":"Those within reach of his spear"},{"id":"semetey-1-2013:p0567:b003:l009","ordinal":120035,"en":"He felled with the spear;"},{"id":"semetey-1-2013:p0567:b003:l010","ordinal":120036,"en":"Those who came nearer"},{"id":"semetey-1-2013:p0567:b003:l011","ordinal":120037,"en":"He struck down with his sword."},{"id":"semetey-1-2013:p0567:b003:l012","ordinal":120038,"en":"He smashed seven hundred,"},{"id":"semetey-1-2013:p0567:b003:l013","ordinal":120039,"en":"Thrusting wherever he reached,"},{"id":"semetey-1-2013:p0567:b003:l014","ordinal":120040,"en":"Crying, “Where is my accomplished Almam?”"},{"id":"semetey-1-2013:p0567:b003:l015","ordinal":120041,"en":"His head all bloody,"},{"id":"semetey-1-2013:p0567:b003:l016","ordinal":120042,"en":"His two flailing arms"},{"id":"semetey-1-2013:p0567:b003:l017","ordinal":120043,"en":"Unable to rise, hanging limp."},{"id":"semetey-1-2013:p0567:b003:l018","ordinal":120044,"en":"Shouting, “Islam!”"},{"id":"semetey-1-2013:p0567:b003:l019","ordinal":120045,"en":"The seething Chinese"},{"id":"semetey-1-2013:p0567:b003:l020","ordinal":120046,"en":"He routed, drove and scattered."},{"id":"semetey-1-2013:p0567:b003:l021","ordinal":120047,"en":"My Almam, left on foot,"},{"id":"semetey-1-2013:p0567:b003:l022","ordinal":120048,"en":"The warrior barely standing—"},{"id":"semetey-1-2013:p0567:b003:l023","ordinal":120049,"en":"He reached him faster than an arrow."},{"id":"semetey-1-2013:p0567:b003:l024","ordinal":120050,"en":"Where he reached my Almam,"},{"id":"semetey-1-2013:p0567:b003:l025","ordinal":120051,"en":"Showing his lion's courage,"},{"id":"semetey-1-2013:p0567:b003:l026","ordinal":120052,"en":"Seizing him by the shoulder blade,"},{"id":"semetey-1-2013:p0567:b003:l027","ordinal":120053,"en":"Young Syrgak, the fierce hero,"},{"id":"semetey-1-2013:p0567:b003:l028","ordinal":120054,"en":"Hoisted him onto his right knee."},{"id":"semetey-1-2013:p0567:b003:l029","ordinal":120055,"en":"In a frantic haste,"},{"id":"semetey-1-2013:p0567:b003:l030","ordinal":120056,"en":"Splitting the countless Chinese apart,"},{"id":"semetey-1-2013:p0567:b003:l031","ordinal":120057,"en":"Dear Syrgak carried your Alake away."},{"id":"semetey-1-2013:p0567:b003:l032","ordinal":120058,"en":"He reached there faster than an arrow;"},{"id":"semetey-1-2013:p0567:b003:l033","ordinal":120059,"en":"At the place he reached was Sarala."},{"id":"semetey-1-2013:p0567:b003:l034","ordinal":120060,"en":"He mounted him on Sarala,"},{"id":"semetey-1-2013:p0567:b003:l035","ordinal":120061,"en":"Rekindled his extinguished fire,"},{"id":"semetey-1-2013:p0567:b003:l036","ordinal":120062,"en":"Revived his dead soul,"},{"id":"semetey-1-2013:p0567:b003:l037","ordinal":120063,"en":"And havoc upon Kakan"},{"id":"semetey-1-2013:p0567:b003:l038","ordinal":120064,"en":"He wrought, standing without retreat."}]
