{"id": "sayakbay-ms-current146:pdf201:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 201, "folio": 584, "line_in_page": 27, "raw": "Сен миң жаны болсо да,", "text": "Сен миң жаны болсо да,", "en": "Even if you had a thousand lives,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
