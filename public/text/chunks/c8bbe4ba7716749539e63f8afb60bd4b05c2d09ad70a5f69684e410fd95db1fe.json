[{"id":"semetey-2-2013:p0934:b004:l008","ordinal":258561,"en":"Semetey, the ancient enemy"},{"id":"semetey-2-2013:p0934:b004:l009","ordinal":258562,"en":"You are a close brother"},{"id":"semetey-2-2013:p0934:b004:l010","ordinal":258563,"en":"There was a crowd."},{"id":"semetey-2-2013:p0934:b004:l011","ordinal":258564,"en":"Dear Konurbay,"},{"id":"semetey-2-2013:p0934:b004:l012","ordinal":258565,"en":"If you're blood,"},{"id":"semetey-2-2013:p0934:b004:l013","ordinal":258566,"en":"Your character is in your head"},{"id":"semetey-2-2013:p0934:b004:l014","ordinal":258567,"en":"If you exist,"},{"id":"semetey-2-2013:p0934:b004:l015","ordinal":258568,"en":"Get used to the mind"},{"id":"semetey-2-2013:p0934:b004:l016","ordinal":258569,"en":"Give the day of Aikol Manas!"},{"id":"semetey-2-2013:p0934:b004:l017","ordinal":258570,"en":"The whole world"},{"id":"semetey-2-2013:p0934:b004:l018","ordinal":258571,"en":"Put it on this killer."},{"id":"semetey-2-2013:p0934:b004:l019","ordinal":258572,"en":"Gather all Kyrgyz"},{"id":"semetey-2-2013:p0934:b004:l020","ordinal":258573,"en":"Don't worry too much,"},{"id":"semetey-2-2013:p0934:b004:l021","ordinal":258574,"en":"Take this as an explanation."},{"id":"semetey-2-2013:p0934:b004:l022","ordinal":258575,"en":"Get used to the saying,"},{"id":"semetey-2-2013:p0934:b004:l023","ordinal":258576,"en":"A bronze idol"},{"id":"semetey-2-2013:p0934:b004:l024","ordinal":258577,"en":"Please give it!"},{"id":"semetey-2-2013:p0934:b004:l025","ordinal":258578,"en":"To us, Kulchoro is a true relative."},{"id":"semetey-2-2013:p0934:b004:l026","ordinal":258579,"en":"The people of Chimmachyn are angry with us."},{"id":"semetey-2-2013:p0934:b004:l027","ordinal":258580,"en":"Keep believing."},{"id":"semetey-2-2013:p0934:b004:l028","ordinal":258581,"en":"That I had real Chinese,"},{"id":"semetey-2-2013:p0934:b004:l029","ordinal":258582,"en":"Believe it or not."},{"id":"semetey-2-2013:p0934:b004:l030","ordinal":258583,"en":"A lot of words in the heart"},{"id":"semetey-2-2013:p0934:b004:l031","ordinal":258584,"en":"Throw away the laundry."},{"id":"semetey-2-2013:p0934:b004:l032","ordinal":258585,"en":"Click the button like this,"},{"id":"semetey-2-2013:p0934:b004:l033","ordinal":258586,"en":"My relative has just arrived,"},{"id":"semetey-2-2013:p0934:b004:l034","ordinal":258587,"en":"Unlock the word!”"},{"id":"semetey-2-2013:p0934:b004:l035","ordinal":258588,"en":"A large bronze idol"},{"id":"semetey-2-2013:p0934:b004:l036","ordinal":258589,"en":"Hearing this, Konurbay"},{"id":"semetey-2-2013:p0934:b004:l037","ordinal":258590,"en":"He took it as a slave,"},{"id":"semetey-2-2013:p0934:b004:l038","ordinal":258591,"en":"Until you repent"},{"id":"semetey-2-2013:p0934:b004:l039","ordinal":258592,"en":"Kulchoro was pulled out."},{"id":"semetey-2-2013:p0935:b003:l001","ordinal":258593,"en":"He showed that he was a lion among heroes,"},{"id":"semetey-2-2013:p0935:b003:l002","ordinal":258594,"en":"Not once, but a thousand times,"},{"id":"semetey-2-2013:p0935:b003:l003","ordinal":258595,"en":"The idol made of bronze"},{"id":"semetey-2-2013:p0935:b003:l004","ordinal":258596,"en":"To win the Chinese people’s favor,"},{"id":"semetey-2-2013:p0935:b003:l005","ordinal":258597,"en":"He pressed it to his breast a thousand times."},{"id":"semetey-2-2013:p0935:b003:l006","ordinal":258598,"en":"No clear thought remained,"},{"id":"semetey-2-2013:p0935:b003:l007","ordinal":258599,"en":"The valiant falcon Külchoro"},{"id":"semetey-2-2013:p0935:b003:l008","ordinal":258600,"en":"Took the Chinese idol in his hands"},{"id":"semetey-2-2013:p0935:b003:l009","ordinal":258601,"en":"And cleverly deceived the Chinese."},{"id":"semetey-2-2013:p0935:b003:l010","ordinal":258602,"en":"Ezkara had taken the idol,"},{"id":"semetey-2-2013:p0935:b003:l011","ordinal":258603,"en":"But from Ezkara’s hands"},{"id":"semetey-2-2013:p0935:b003:l012","ordinal":258604,"en":"Külchoro had snatched it away."},{"id":"semetey-2-2013:p0935:b003:l013","ordinal":258605,"en":"Among the spear-wielding warriors,"},{"id":"semetey-2-2013:p0935:b003:l014","ordinal":258606,"en":"His resourcefulness proved genuine;"},{"id":"semetey-2-2013:p0935:b003:l015","ordinal":258607,"en":"Seeking out the Chinese people on purpose,"},{"id":"semetey-2-2013:p0935:b003:l016","ordinal":258608,"en":"The warrior who had come after wandering astray"},{"id":"semetey-2-2013:p0935:b003:l017","ordinal":258609,"en":"Proved truly mighty."},{"id":"semetey-2-2013:p0935:b003:l018","ordinal":258610,"en":"His fortune was complete."},{"id":"semetey-2-2013:p0935:b003:l019","ordinal":258611,"en":"For the falcon who came from the Kyrgyz,"},{"id":"semetey-2-2013:p0935:b003:l020","ordinal":258612,"en":"Brave Kongurbay found a champion;"},{"id":"semetey-2-2013:p0935:b003:l021","ordinal":258613,"en":"Fleeing the Kyrgyz and becoming a stranger,"},{"id":"semetey-2-2013:p0935:b003:l022","ordinal":258614,"en":"He found the countless Chinese nation."},{"id":"semetey-2-2013:p0935:b003:l023","ordinal":258615,"en":"Who could endure the desert?"},{"id":"semetey-2-2013:p0935:b003:l024","ordinal":258616,"en":"The warrior who never faltered in the wastes"},{"id":"semetey-2-2013:p0935:b003:l025","ordinal":258617,"en":"Proved a true thoroughbred;"},{"id":"semetey-2-2013:p0935:b003:l026","ordinal":258618,"en":"The fierce falcon who came saying,"},{"id":"semetey-2-2013:p0935:b003:l027","ordinal":258619,"en":"“The Chinese are my people,”"},{"id":"semetey-2-2013:p0935:b003:l028","ordinal":258620,"en":"Proved truly their kinsman."},{"id":"semetey-2-2013:p0935:b003:l029","ordinal":258621,"en":"Kongurbay and Ezkara,"},{"id":"semetey-2-2013:p0935:b003:l030","ordinal":258622,"en":"And all the Chinese,"},{"id":"semetey-2-2013:p0935:b003:l031","ordinal":258623,"en":"Grew excited and raised an uproar;"},{"id":"semetey-2-2013:p0935:b003:l032","ordinal":258624,"en":"They all plunged into the clamor."},{"id":"semetey-2-2013:p0935:b003:l033","ordinal":258625,"en":"Heeding no man and hearing no counsel,"},{"id":"semetey-2-2013:p0935:b003:l034","ordinal":258626,"en":"They all plunged into frenzy."},{"id":"semetey-2-2013:p0935:b003:l035","ordinal":258627,"en":"Into ceaseless, wild commotion,"},{"id":"semetey-2-2013:p0935:b003:l036","ordinal":258628,"en":"Into the tumult they all plunged—"},{"id":"semetey-2-2013:p0935:b003:l037","ordinal":258629,"en":"Ah, valiant falcon Külchoro!"},{"id":"semetey-2-2013:p0935:b003:l038","ordinal":258630,"en":"The son born of Almambet"},{"id":"semetey-2-2013:p0935:b003:l039","ordinal":258631,"en":"Proved a true lion;"},{"id":"semetey-2-2013:p0935:b004:l001","ordinal":258632,"en":"Parted from the Kyrgyz people,"},{"id":"semetey-2-2013:p0935:b004:l002","ordinal":258633,"en":"He turned toward the Chinese nation."},{"id":"semetey-2-2013:p0935:b004:l003","ordinal":258634,"en":"This warrior who deemed himself formidable"},{"id":"semetey-2-2013:p0935:b004:l004","ordinal":258635,"en":"Had truly found his place."},{"id":"semetey-2-2013:p0935:b004:l005","ordinal":258636,"en":"No hero like him exists in all the world;"},{"id":"semetey-2-2013:p0935:b004:l006","ordinal":258637,"en":"He proved a true lion."},{"id":"semetey-2-2013:p0935:b004:l007","ordinal":258638,"en":"The idol he called the true God"},{"id":"semetey-2-2013:p0935:b004:l008","ordinal":258639,"en":"He had truly found;"},{"id":"semetey-2-2013:p0935:b004:l009","ordinal":258640,"en":"He was a mighty champion and a lion."},{"id":"semetey-2-2013:p0935:b004:l010","ordinal":258641,"en":"They clad him in armor,"},{"id":"semetey-2-2013:p0935:b004:l011","ordinal":258642,"en":"Proclaimed him throughout royal Beijing,"},{"id":"semetey-2-2013:p0935:b004:l012","ordinal":258643,"en":"And found him worthy to be raised as khan."},{"id":"semetey-2-2013:p0935:b004:l013","ordinal":258644,"en":"“We shed blood and became enemies—"},{"id":"semetey-2-2013:p0935:b004:l014","ordinal":258645,"en":"Those intentions were all in vain;"},{"id":"semetey-2-2013:p0935:b004:l015","ordinal":258646,"en":"Kongurbay and Ezkara,"},{"id":"semetey-2-2013:p0935:b004:l016","ordinal":258647,"en":"He stands above both of you."},{"id":"semetey-2-2013:p0935:b004:l017","ordinal":258648,"en":"Ah, that God-stricken falcon!"},{"id":"semetey-2-2013:p0935:b004:l018","ordinal":258649,"en":"That he should have gone back to the Kyrgyz"},{"id":"semetey-2-2013:p0935:b004:l019","ordinal":258650,"en":"Is a God-accursed thing."},{"id":"semetey-2-2013:p0935:b004:l020","ordinal":258651,"en":"Here in Beijing where we stand,"},{"id":"semetey-2-2013:p0935:b004:l021","ordinal":258652,"en":"That damned, firmly planted"},{"id":"semetey-2-2013:p0935:b004:l022","ordinal":258653,"en":"Iron-barred fortress is impregnable."},{"id":"semetey-2-2013:p0935:b004:l023","ordinal":258654,"en":"If he were set upon the throne,"},{"id":"semetey-2-2013:p0935:b004:l024","ordinal":258655,"en":"He is one who could become khan;"},{"id":"semetey-2-2013:p0935:b004:l025","ordinal":258656,"en":"Here in Beijing where we stand,"},{"id":"semetey-2-2013:p0935:b004:l026","ordinal":258657,"en":"He could be a lord and a prince,"},{"id":"semetey-2-2013:p0935:b004:l027","ordinal":258658,"en":"A hero fit to become khan."},{"id":"semetey-2-2013:p0935:b004:l028","ordinal":258659,"en":"Above the giants Orgo and Döödür,"},{"id":"semetey-2-2013:p0935:b004:l029","ordinal":258660,"en":"This warrior holds supremacy."},{"id":"semetey-2-2013:p0935:b004:l030","ordinal":258661,"en":"For the people he left behind,"},{"id":"semetey-2-2013:p0935:b004:l031","ordinal":258662,"en":"He was both hero and lion;"},{"id":"semetey-2-2013:p0935:b004:l032","ordinal":258663,"en":"Against all the giants of Beijing,"},{"id":"semetey-2-2013:p0935:b004:l033","ordinal":258664,"en":"Though storms beat upon it, no wind could pierce it—"},{"id":"semetey-2-2013:p0935:b004:l034","ordinal":258665,"en":"He is a fortress of dense cornered woods."},{"id":"semetey-2-2013:p0935:b004:l035","ordinal":258666,"en":"The forty tribes of great Chinese Beijing"},{"id":"semetey-2-2013:p0935:b004:l036","ordinal":258667,"en":"Have found the hero who can guard them."},{"id":"semetey-2-2013:p0935:b004:l037","ordinal":258668,"en":"He truly regarded the Chinese"},{"id":"semetey-2-2013:p0935:b004:l038","ordinal":258669,"en":"As a great nation,"},{"id":"semetey-2-2013:p0935:b004:l039","ordinal":258670,"en":"And without looking back, the Burut came to China—"},{"id":"semetey-2-2013:p0936:b003:l001","ordinal":258671,"en":"He truly came among them."},{"id":"semetey-2-2013:p0936:b003:l002","ordinal":258672,"en":"He stands above many"},{"id":"semetey-2-2013:p0936:b003:l003","ordinal":258673,"en":"Of the stone-armored Chinese,"},{"id":"semetey-2-2013:p0936:b003:l004","ordinal":258674,"en":"Above the strongest"},{"id":"semetey-2-2013:p0936:b003:l005","ordinal":258675,"en":"Of the jacketed Manchus."},{"id":"semetey-2-2013:p0936:b003:l006","ordinal":258676,"en":"He is a mighty champion and a lion;"},{"id":"semetey-2-2013:p0936:b003:l007","ordinal":258677,"en":"When fastened firmly at his waist,"},{"id":"semetey-2-2013:p0936:b003:l008","ordinal":258678,"en":"He is a hero like an iron mace."},{"id":"semetey-2-2013:p0936:b003:l009","ordinal":258679,"en":"No such man is granted to mortals;"},{"id":"semetey-2-2013:p0936:b003:l010","ordinal":258680,"en":"This surpassing falcon of a warrior"},{"id":"semetey-2-2013:p0936:b003:l011","ordinal":258681,"en":"Cannot be found among mankind."},{"id":"semetey-2-2013:p0936:b003:l012","ordinal":258682,"en":"Spreading slaughter across the world,"},{"id":"semetey-2-2013:p0936:b003:l013","ordinal":258683,"en":"He is a man fit to take the road;"},{"id":"semetey-2-2013:p0936:b003:l014","ordinal":258684,"en":"Gripping his spear and crushing the foe,"},{"id":"semetey-2-2013:p0936:b003:l015","ordinal":258685,"en":"He is a son fit to march with an army."},{"id":"semetey-2-2013:p0936:b003:l016","ordinal":258686,"en":"When fire boils like hail,"},{"id":"semetey-2-2013:p0936:b003:l017","ordinal":258687,"en":"He is a son who can endure the embers."},{"id":"semetey-2-2013:p0936:b003:l018","ordinal":258688,"en":"Though an army of six hundred thousand comes,"},{"id":"semetey-2-2013:p0936:b003:l019","ordinal":258689,"en":"Surging forward without sparing life,"},{"id":"semetey-2-2013:p0936:b003:l020","ordinal":258690,"en":"He is a son who can withstand their bullets."},{"id":"semetey-2-2013:p0936:b003:l021","ordinal":258691,"en":"When spears are leveled and men cry out,"},{"id":"semetey-2-2013:p0936:b003:l022","ordinal":258692,"en":"He is a son fit to face the massed host."},{"id":"semetey-2-2013:p0936:b003:l023","ordinal":258693,"en":"Smashing all before him and clearing a path,"},{"id":"semetey-2-2013:p0936:b003:l024","ordinal":258694,"en":"He is a son upon whom one may rely."},{"id":"semetey-2-2013:p0936:b003:l025","ordinal":258695,"en":"Stopping it and not letting it flow onward,"},{"id":"semetey-2-2013:p0936:b003:l026","ordinal":258696,"en":"He is a son fit to withstand a flood."},{"id":"semetey-2-2013:p0936:b003:l027","ordinal":258697,"en":"Among all round-headed mortals,"},{"id":"semetey-2-2013:p0936:b003:l028","ordinal":258698,"en":"Could there be another champion like this?"},{"id":"semetey-2-2013:p0936:b003:l029","ordinal":258699,"en":"He is a mighty champion and a lion."},{"id":"semetey-2-2013:p0936:b003:l030","ordinal":258700,"en":"Would it be right to speak of him otherwise?"},{"id":"semetey-2-2013:p0936:b003:l031","ordinal":258701,"en":"His fierce courage is formidable indeed;"},{"id":"semetey-2-2013:p0936:b003:l032","ordinal":258702,"en":"He is both a great lord and a lion."},{"id":"semetey-2-2013:p0936:b003:l033","ordinal":258703,"en":"He bowed eighty times before the idol;"},{"id":"semetey-2-2013:p0936:b003:l034","ordinal":258704,"en":"The time has come for him to become Chinese with us."},{"id":"semetey-2-2013:p0936:b003:l035","ordinal":258705,"en":"The jeweled necklace of the warrior"},{"id":"semetey-2-2013:p0936:b003:l036","ordinal":258706,"en":"Is one this son is worthy to wear;"},{"id":"semetey-2-2013:p0936:b003:l037","ordinal":258707,"en":"The many-tribed Chinese nation—"},{"id":"semetey-2-2013:p0936:b003:l038","ordinal":258708,"en":"Without bringing shame upon this people—"},{"id":"semetey-2-2013:p0936:b003:l039","ordinal":258709,"en":"He is one who can govern them."},{"id":"semetey-2-2013:p0936:b004:l001","ordinal":258710,"en":"In strength and heroism,"},{"id":"semetey-2-2013:p0936:b004:l002","ordinal":258711,"en":"He is a man complete in every way."},{"id":"semetey-2-2013:p0936:b004:l003","ordinal":258712,"en":"If we raise him as khan over the Khaganate,"},{"id":"semetey-2-2013:p0936:b004:l004","ordinal":258713,"en":"How could Kongurbay compare with him?"},{"id":"semetey-2-2013:p0936:b004:l005","ordinal":258714,"en":"He is like a shower of steel bullets;"},{"id":"semetey-2-2013:p0936:b004:l006","ordinal":258715,"en":"There is none like him even in hell!”"},{"id":"semetey-2-2013:p0936:b004:l007","ordinal":258716,"en":"So they raised an uproar,"},{"id":"semetey-2-2013:p0936:b004:l008","ordinal":258717,"en":"And the judges put him to the test."},{"id":"semetey-2-2013:p0936:b004:l009","ordinal":258718,"en":"The multitude of Chinese khagans"},{"id":"semetey-2-2013:p0936:b004:l010","ordinal":258719,"en":"Rejoiced greatly and clamored."},{"id":"semetey-2-2013:p0936:b004:l011","ordinal":258720,"en":"“This is the heir of khans,” they said,"},{"id":"semetey-2-2013:p0936:b004:l012","ordinal":258721,"en":"“The master of Eselek,"},{"id":"semetey-2-2013:p0936:b004:l013","ordinal":258722,"en":"The lord of this Beijing.”"},{"id":"semetey-2-2013:p0936:b004:l014","ordinal":258723,"en":"Driven wild with joy,"},{"id":"semetey-2-2013:p0936:b004:l015","ordinal":258724,"en":"They rang the bells with all their might;"},{"id":"semetey-2-2013:p0936:b004:l016","ordinal":258725,"en":"The people of forty khanates seethed,"},{"id":"semetey-2-2013:p0936:b004:l017","ordinal":258726,"en":"And closed in with mighty shouts."},{"id":"semetey-2-2013:p0936:b004:l018","ordinal":258727,"en":"Drinking spirits and holding a feast,"},{"id":"semetey-2-2013:p0936:b004:l019","ordinal":258728,"en":"The heroes gathered in boundless numbers."},{"id":"semetey-2-2013:p0936:b004:l020","ordinal":258729,"en":"“A kinsman has come from the Kyrgyz,” they said,"},{"id":"semetey-2-2013:p0936:b004:l021","ordinal":258730,"en":"“God has given him to us.”"},{"id":"semetey-2-2013:p0936:b004:l022","ordinal":258731,"en":"They bound upright with ropes"},{"id":"semetey-2-2013:p0936:b004:l023","ordinal":258732,"en":"An enormous idol as large as a house,"},{"id":"semetey-2-2013:p0936:b004:l024","ordinal":258733,"en":"And staged an extraordinary spectacle"},{"id":"semetey-2-2013:p0936:b004:l025","ordinal":258734,"en":"In the midst of the army."},{"id":"semetey-2-2013:p0936:b004:l026","ordinal":258735,"en":"They brought forth ninety kinds"},{"id":"semetey-2-2013:p0936:b004:l027","ordinal":258736,"en":"Of parrot-tail feathers,"},{"id":"semetey-2-2013:p0936:b004:l028","ordinal":258737,"en":"And had them splendidly set"},{"id":"semetey-2-2013:p0936:b004:l029","ordinal":258738,"en":"Upon the crest of his armor."},{"id":"semetey-2-2013:p0936:b004:l030","ordinal":258739,"en":"They sent word to the Khagan,"},{"id":"semetey-2-2013:p0936:b004:l031","ordinal":258740,"en":"Adorning it with magpie-tail feathers:"},{"id":"semetey-2-2013:p0936:b004:l032","ordinal":258741,"en":"“Külchoro is needed as khan,”"},{"id":"semetey-2-2013:p0936:b004:l033","ordinal":258742,"en":"And had these splendid things brought."},{"id":"semetey-2-2013:p0936:b004:l034","ordinal":258743,"en":"The standards dipped and clamor filled the air;"},{"id":"semetey-2-2013:p0936:b004:l035","ordinal":258744,"en":"The people cried out and made their plans."},{"id":"semetey-2-2013:p0936:b004:l036","ordinal":258745,"en":"All beneath the vault of heaven"},{"id":"semetey-2-2013:p0936:b004:l037","ordinal":258746,"en":"Held a feast to make Külchoro khan."},{"id":"semetey-2-2013:p0936:b004:l038","ordinal":258747,"en":"They purified him and robed him in ceremonial dress,"},{"id":"semetey-2-2013:p0936:b004:l039","ordinal":258748,"en":"Then into a great pavilion with golden poles and copper ropes—"},{"id":"semetey-2-2013:p0937:b003:l001","ordinal":258749,"en":"They led him inside."},{"id":"semetey-2-2013:p0937:b003:l002","ordinal":258750,"en":"The heroes and lions"},{"id":"semetey-2-2013:p0937:b003:l003","ordinal":258751,"en":"They roused into a frenzy;"},{"id":"semetey-2-2013:p0937:b003:l004","ordinal":258752,"en":"They made the longing old men"},{"id":"semetey-2-2013:p0937:b003:l005","ordinal":258753,"en":"Dance at the celebration."},{"id":"semetey-2-2013:p0937:b003:l006","ordinal":258754,"en":"They raised an unceasing tumult,"},{"id":"semetey-2-2013:p0937:b003:l007","ordinal":258755,"en":"A royal commotion of frantic haste;"},{"id":"semetey-2-2013:p0937:b003:l008","ordinal":258756,"en":"Holding such a feast for the warrior,"},{"id":"semetey-2-2013:p0937:b003:l009","ordinal":258757,"en":"The gathered people stood there."},{"id":"semetey-2-2013:p0937:b003:l010","ordinal":258758,"en":"The strongmen surged and pressed together,"},{"id":"semetey-2-2013:p0937:b003:l011","ordinal":258759,"en":"The great drum thundered loudly;"},{"id":"semetey-2-2013:p0937:b003:l012","ordinal":258760,"en":"The multitude of excited nobles"},{"id":"semetey-2-2013:p0937:b003:l013","ordinal":258761,"en":"Honored him amid a roaring commotion."},{"id":"semetey-2-2013:p0937:b003:l014","ordinal":258762,"en":"As the people stood thus,"},{"id":"semetey-2-2013:p0937:b003:l015","ordinal":258763,"en":"Broad-jawed and eloquent,"},{"id":"semetey-2-2013:p0937:b003:l016","ordinal":258764,"en":"The unerring lion-warrior,"},{"id":"semetey-2-2013:p0937:b003:l017","ordinal":258765,"en":"Whose smile made the sun rise,"},{"id":"semetey-2-2013:p0937:b003:l018","ordinal":258766,"en":"Whose face glowed red as the sun,"},{"id":"semetey-2-2013:p0937:b003:l019","ordinal":258767,"en":"Whose sight gladdened every beholder—"},{"id":"semetey-2-2013:p0937:b003:l020","ordinal":258768,"en":"The gray wolf Külchoro—"},{"id":"semetey-2-2013:p0937:b003:l021","ordinal":258769,"en":"A nimble and keen-edged hero,"},{"id":"semetey-2-2013:p0937:b003:l022","ordinal":258770,"en":"If you ask about that fierce man’s nature,"},{"id":"semetey-2-2013:p0937:b003:l023","ordinal":258771,"en":"Was just such a sage."},{"id":"semetey-2-2013:p0937:b003:l024","ordinal":258772,"en":"Speaking softly but with great weight,"},{"id":"semetey-2-2013:p0937:b003:l025","ordinal":258773,"en":"Külchoro began to speak:"},{"id":"semetey-2-2013:p0937:b003:l026","ordinal":258774,"en":"“Great and small are gathered here;"},{"id":"semetey-2-2013:p0937:b003:l027","ordinal":258775,"en":"Your elders stand here."},{"id":"semetey-2-2013:p0937:b003:l028","ordinal":258776,"en":"Khan Ezkara and Kongurbay,"},{"id":"semetey-2-2013:p0937:b003:l029","ordinal":258777,"en":"All of you stand here."},{"id":"semetey-2-2013:p0937:b003:l030","ordinal":258778,"en":"Your elders of forty tribes,"},{"id":"semetey-2-2013:p0937:b003:l031","ordinal":258779,"en":"Countless as ants, stand here;"},{"id":"semetey-2-2013:p0937:b003:l032","ordinal":258780,"en":"All your warriors who boast of valor"},{"id":"semetey-2-2013:p0937:b003:l033","ordinal":258781,"en":"Stand here."},{"id":"semetey-2-2013:p0937:b003:l034","ordinal":258782,"en":"Those most skilled in the stratagems of war,"},{"id":"semetey-2-2013:p0937:b003:l035","ordinal":258783,"en":"Your champions stand here."},{"id":"semetey-2-2013:p0937:b003:l036","ordinal":258784,"en":"Among the spear-wielding warriors,"},{"id":"semetey-2-2013:p0937:b003:l037","ordinal":258785,"en":"Your most capable men stand here,"},{"id":"semetey-2-2013:p0937:b003:l038","ordinal":258786,"en":"Ready now to look upon"},{"id":"semetey-2-2013:p0937:b003:l039","ordinal":258787,"en":"The ordeal of a six-month journey—"},{"id":"semetey-2-2013:p0937:b005:l001","ordinal":258788,"en":"Your mighty one stands here."},{"id":"semetey-2-2013:p0937:b005:l002","ordinal":258789,"en":"Your wise one is your khan."},{"id":"semetey-2-2013:p0937:b005:l003","ordinal":258790,"en":"All of you, great and small,"},{"id":"semetey-2-2013:p0937:b005:l004","ordinal":258791,"en":"Are wondrously capable,"},{"id":"semetey-2-2013:p0937:b005:l005","ordinal":258792,"en":"Mighty cultivators of wisdom."},{"id":"semetey-2-2013:p0937:b005:l006","ordinal":258793,"en":"My child, the valiant blood-spiller Semetey,"},{"id":"semetey-2-2013:p0937:b005:l007","ordinal":258794,"en":"Son of Manas, had said:"},{"id":"semetey-2-2013:p0937:b005:l008","ordinal":258795,"en":"“Bring me my uncle’s idol;"},{"id":"semetey-2-2013:p0937:b005:l009","ordinal":258796,"en":"Before the fair-faced Chinese"},{"id":"semetey-2-2013:p0937:b005:l010","ordinal":258797,"en":"I shall truly bow in reverence.”"},{"id":"semetey-2-2013:p0937:b005:l011","ordinal":258798,"en":"Your graybeard, old Kalcha,"},{"id":"semetey-2-2013:p0937:b005:l012","ordinal":258799,"en":"Take heed, all you people!"},{"id":"semetey-2-2013:p0937:b005:l013","ordinal":258800,"en":"What kind of idol is he going for,"},{"id":"semetey-2-2013:p0937:b005:l014","ordinal":258801,"en":"Or what kind of idol has he left behind?"},{"id":"semetey-2-2013:p0937:b005:l015","ordinal":258802,"en":"When a bronze-shafted spear strikes,"},{"id":"semetey-2-2013:p0937:b005:l016","ordinal":258803,"en":"And a grave, weighty deed is at hand,"},{"id":"semetey-2-2013:p0937:b005:l017","ordinal":258804,"en":"What use is caution?"},{"id":"semetey-2-2013:p0937:b005:l018","ordinal":258805,"en":"What kind of idol is he going for?"},{"id":"semetey-2-2013:p0937:b005:l019","ordinal":258806,"en":"Mighty Bakai and Semetey,"},{"id":"semetey-2-2013:p0937:b005:l020","ordinal":258807,"en":"The two khans, had said:"},{"id":"semetey-2-2013:p0937:b005:l021","ordinal":258808,"en":"“If he counts us as kin,"},{"id":"semetey-2-2013:p0937:b005:l022","ordinal":258809,"en":"And does not call us Buruts,"},{"id":"semetey-2-2013:p0937:b005:l023","ordinal":258810,"en":"He will heed the words we speak."},{"id":"semetey-2-2013:p0937:b005:l024","ordinal":258811,"en":"If his spoken word is true,"},{"id":"semetey-2-2013:p0937:b005:l025","ordinal":258812,"en":"If what he says is bright and pure,"},{"id":"semetey-2-2013:p0937:b005:l026","ordinal":258813,"en":"If the revered Kongurbai"},{"id":"semetey-2-2013:p0937:b005:l027","ordinal":258814,"en":"Is truly a khan,"},{"id":"semetey-2-2013:p0937:b005:l028","ordinal":258815,"en":"If there truly is"},{"id":"semetey-2-2013:p0937:b005:l029","ordinal":258816,"en":"Some sacred power within him,"}]
