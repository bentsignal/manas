[{"id":"semetey-2-2013:p1412:b003:l039","ordinal":295425,"en":"Küzhürmön, who came out to joust,"},{"id":"semetey-2-2013:p1412:b004:l001","ordinal":295426,"en":"Was a lion full of courage,"},{"id":"semetey-2-2013:p1412:b004:l002","ordinal":295427,"en":"Merciless, unmatched on foot,"},{"id":"semetey-2-2013:p1412:b004:l003","ordinal":295428,"en":"And a master upon a horse."},{"id":"semetey-2-2013:p1412:b004:l004","ordinal":295429,"en":"He never fled from fire or attack,"},{"id":"semetey-2-2013:p1412:b004:l005","ordinal":295430,"en":"And thrust his spear from afar;"},{"id":"semetey-2-2013:p1412:b004:l006","ordinal":295431,"en":"Formidable wrestler Küzhürmön"},{"id":"semetey-2-2013:p1412:b004:l007","ordinal":295432,"en":"Had won in many contests."},{"id":"semetey-2-2013:p1412:b004:l008","ordinal":295433,"en":"In wrestling he spared no wrestler;"},{"id":"semetey-2-2013:p1412:b004:l009","ordinal":295434,"en":"One young horse nursed by a barren mare"},{"id":"semetey-2-2013:p1412:b004:l010","ordinal":295435,"en":"Could not satisfy him for a single meal."},{"id":"semetey-2-2013:p1412:b004:l011","ordinal":295436,"en":"When Küzhürmön became aroused,"},{"id":"semetey-2-2013:p1412:b004:l012","ordinal":295437,"en":"Many men trembled,"},{"id":"semetey-2-2013:p1412:b004:l013","ordinal":295438,"en":"Lost their senses and stood still,"},{"id":"semetey-2-2013:p1412:b004:l014","ordinal":295439,"en":"Their two eyes widening."},{"id":"semetey-2-2013:p1412:b004:l015","ordinal":295440,"en":"He was a terror surpassing the world;"},{"id":"semetey-2-2013:p1412:b004:l016","ordinal":295441,"en":"Whoever approached him stopped."},{"id":"semetey-2-2013:p1412:b004:l017","ordinal":295442,"en":"Taking a spear with a steel shaft,"},{"id":"semetey-2-2013:p1412:b004:l018","ordinal":295443,"en":"This villain had long prepared"},{"id":"semetey-2-2013:p1412:b004:l019","ordinal":295444,"en":"To shed blood—"},{"id":"semetey-2-2013:p1412:b004:l020","ordinal":295445,"en":"Such was Küzhürmön's nature."},{"id":"semetey-2-2013:p1412:b004:l021","ordinal":295446,"en":"When unbeliever and Muslim"},{"id":"semetey-2-2013:p1412:b004:l022","ordinal":295447,"en":"Clashed in battle,"},{"id":"semetey-2-2013:p1412:b004:l023","ordinal":295448,"en":"He performed dreadful deeds."},{"id":"semetey-2-2013:p1412:b004:l024","ordinal":295449,"en":"When a Chinese giant ravaged"},{"id":"semetey-2-2013:p1412:b004:l025","ordinal":295450,"en":"And slaughtered the Kyrgyz people,"},{"id":"semetey-2-2013:p1412:b004:l026","ordinal":295451,"en":"Riding a black rhinoceros,"},{"id":"semetey-2-2013:p1412:b004:l027","ordinal":295452,"en":"The dark, stubborn champion on foot"},{"id":"semetey-2-2013:p1412:b004:l028","ordinal":295453,"en":"Had come out in single combat;"},{"id":"semetey-2-2013:p1412:b004:l029","ordinal":295454,"en":"The hero Küzhürmön"},{"id":"semetey-2-2013:p1412:b004:l030","ordinal":295455,"en":"Thrust his spear in that duel,"},{"id":"semetey-2-2013:p1412:b004:l031","ordinal":295456,"en":"Toppled the black, stubborn warrior"},{"id":"semetey-2-2013:p1412:b004:l032","ordinal":295457,"en":"From the back of his rhinoceros,"},{"id":"semetey-2-2013:p1412:b004:l033","ordinal":295458,"en":"And cut off his head."},{"id":"semetey-2-2013:p1412:b004:l034","ordinal":295459,"en":"The khan and all the people marveled:"},{"id":"semetey-2-2013:p1412:b004:l035","ordinal":295460,"en":"“Küzhürmön is this mighty;"},{"id":"semetey-2-2013:p1412:b004:l036","ordinal":295461,"en":"He has destroyed the giant he fought"},{"id":"semetey-2-2013:p1412:b004:l037","ordinal":295462,"en":"And driven that terror into the earth."},{"id":"semetey-2-2013:p1412:b004:l038","ordinal":295463,"en":"He is both a hero and a lion;"},{"id":"semetey-2-2013:p1412:b004:l039","ordinal":295464,"en":"Among all sons of men who took up spears,"},{"id":"semetey-2-2013:p1413:b003:l001","ordinal":295465,"en":"He long ago surpassed them all."},{"id":"semetey-2-2013:p1413:b003:l002","ordinal":295466,"en":"He buried every sworn enemy"},{"id":"semetey-2-2013:p1413:b003:l003","ordinal":295467,"en":"In the earth without digging a grave;"},{"id":"semetey-2-2013:p1413:b003:l004","ordinal":295468,"en":"He is the mightiest among the people.”"},{"id":"semetey-2-2013:p1413:b003:l005","ordinal":295469,"en":"Against enemies in bitter combat"},{"id":"semetey-2-2013:p1413:b003:l006","ordinal":295470,"en":"He had caused many a conflict."},{"id":"semetey-2-2013:p1413:b003:l007","ordinal":295471,"en":"Of your elder Külchoro the slave,"},{"id":"semetey-2-2013:p1413:b003:l008","ordinal":295472,"en":"Küzhürmön had cut open"},{"id":"semetey-2-2013:p1413:b003:l009","ordinal":295473,"en":"Both rows of his shoulder blades,"},{"id":"semetey-2-2013:p1413:b003:l010","ordinal":295474,"en":"Breaking through the forest to make a road;"},{"id":"semetey-2-2013:p1413:b003:l011","ordinal":295475,"en":"He humiliated my elder,"},{"id":"semetey-2-2013:p1413:b003:l012","ordinal":295476,"en":"Külchoro, lion among men,"},{"id":"semetey-2-2013:p1413:b003:l013","ordinal":295477,"en":"Opening those wounds,"},{"id":"semetey-2-2013:p1413:b003:l014","ordinal":295478,"en":"Inflicting calamity,"},{"id":"semetey-2-2013:p1413:b003:l015","ordinal":295479,"en":"Dealing him humiliation,"},{"id":"semetey-2-2013:p1413:b003:l016","ordinal":295480,"en":"And beginning his violence."},{"id":"semetey-2-2013:p1413:b003:l017","ordinal":295481,"en":"If one keeps telling it, it never ends;"},{"id":"semetey-2-2013:p1413:b003:l018","ordinal":295482,"en":"There is still much in the unfinished tale."},{"id":"semetey-2-2013:p1413:b003:l019","ordinal":295483,"en":"But the young hero Karadöö"},{"id":"semetey-2-2013:p1413:b003:l020","ordinal":295484,"en":"Was there to joust with him."},{"id":"semetey-2-2013:p1413:b003:l021","ordinal":295485,"en":"Beyond lay Keng-Sai and Alai;"},{"id":"semetey-2-2013:p1413:b003:l022","ordinal":295486,"en":"The Karadöö you see"},{"id":"semetey-2-2013:p1413:b003:l023","ordinal":295487,"en":"Held much within his heart:"},{"id":"semetey-2-2013:p1413:b003:l024","ordinal":295488,"en":"If the spear cast as an omen"},{"id":"semetey-2-2013:p1413:b003:l025","ordinal":295489,"en":"Found its proper chance, he would"},{"id":"semetey-2-2013:p1413:b003:l026","ordinal":295490,"en":"Offer Küzhürmön as a sacrifice,"},{"id":"semetey-2-2013:p1413:b003:l027","ordinal":295491,"en":"Drive his spear in to the shaft,"},{"id":"semetey-2-2013:p1413:b003:l028","ordinal":295492,"en":"And plunge it wherever he faced."},{"id":"semetey-2-2013:p1413:b003:l029","ordinal":295493,"en":"His insides had long burned with misery"},{"id":"semetey-2-2013:p1413:b003:l030","ordinal":295494,"en":"To avenge Külchoro;"},{"id":"semetey-2-2013:p1413:b003:l031","ordinal":295495,"en":"Such was the poor man's state."},{"id":"semetey-2-2013:p1413:b003:l032","ordinal":295496,"en":"Taking the contest as his omen,"},{"id":"semetey-2-2013:p1413:b003:l033","ordinal":295497,"en":"Karadöö's heroic heart was troubled;"},{"id":"semetey-2-2013:p1413:b003:l034","ordinal":295498,"en":"Tears flowed down both cheeks"},{"id":"semetey-2-2013:p1413:b003:l035","ordinal":295499,"en":"And poured over his collarbones."},{"id":"semetey-2-2013:p1413:b003:l036","ordinal":295500,"en":"He looked at nothing around him,"},{"id":"semetey-2-2013:p1413:b003:l037","ordinal":295501,"en":"Gave no thought to his own death;"},{"id":"semetey-2-2013:p1413:b003:l038","ordinal":295502,"en":"Taking up the spear without concern,"},{"id":"semetey-2-2013:p1413:b003:l039","ordinal":295503,"en":"He counted Kyyaz's massed host"},{"id":"semetey-2-2013:p1413:b004:l001","ordinal":295504,"en":"As less than the hem of his garment."},{"id":"semetey-2-2013:p1413:b004:l002","ordinal":295505,"en":"He wore a gray brocade coat"},{"id":"semetey-2-2013:p1413:b004:l003","ordinal":295506,"en":"And rode a gray Badam horse;"},{"id":"semetey-2-2013:p1413:b004:l004","ordinal":295507,"en":"He adorned and tightly knotted"},{"id":"semetey-2-2013:p1413:b004:l005","ordinal":295508,"en":"The tail of his swift mount."},{"id":"semetey-2-2013:p1413:b004:l006","ordinal":295509,"en":"Like a molting vulture he glowered,"},{"id":"semetey-2-2013:p1413:b004:l007","ordinal":295510,"en":"Like a crouching tiger he advanced."},{"id":"semetey-2-2013:p1413:b004:l008","ordinal":295511,"en":"When Küzhürmön entered the contest,"},{"id":"semetey-2-2013:p1413:b004:l009","ordinal":295512,"en":"The sight dismayed the heart;"},{"id":"semetey-2-2013:p1413:b004:l010","ordinal":295513,"en":"His build and great size"},{"id":"semetey-2-2013:p1413:b004:l011","ordinal":295514,"en":"Looked like a gray hill."},{"id":"semetey-2-2013:p1413:b004:l012","ordinal":295515,"en":"He sprang like a tiger;"},{"id":"semetey-2-2013:p1413:b004:l013","ordinal":295516,"en":"None who fought him would survive."},{"id":"semetey-2-2013:p1413:b004:l014","ordinal":295517,"en":"He charged like a wild boar,"},{"id":"semetey-2-2013:p1413:b004:l015","ordinal":295518,"en":"Tore like a wolf,"},{"id":"semetey-2-2013:p1413:b004:l016","ordinal":295519,"en":"And lumbered like a bear."},{"id":"semetey-2-2013:p1413:b004:l017","ordinal":295520,"en":"Küzhürmön came to strike with his spear"},{"id":"semetey-2-2013:p1413:b004:l018","ordinal":295521,"en":"Before one could even cry, “Speak!”"},{"id":"semetey-2-2013:p1413:b004:l019","ordinal":295522,"en":"He could sling anyone he met"},{"id":"semetey-2-2013:p1413:b004:l020","ordinal":295523,"en":"Across his saddle and descend the ridge;"},{"id":"semetey-2-2013:p1413:b004:l021","ordinal":295524,"en":"If anyone turned aside,"},{"id":"semetey-2-2013:p1413:b004:l022","ordinal":295525,"en":"He could catch him even at a furious gallop."},{"id":"semetey-2-2013:p1413:b004:l023","ordinal":295526,"en":"Enraged, he seemed to pursue the fleeing;"},{"id":"semetey-2-2013:p1413:b004:l024","ordinal":295527,"en":"Küzhürmön would seize and crush"},{"id":"semetey-2-2013:p1413:b004:l025","ordinal":295528,"en":"Anyone who opposed him."},{"id":"semetey-2-2013:p1413:b004:l026","ordinal":295529,"en":"His face was hard as iron,"},{"id":"semetey-2-2013:p1413:b004:l027","ordinal":295530,"en":"His exertion solid as a cliff;"},{"id":"semetey-2-2013:p1413:b004:l028","ordinal":295531,"en":"His surging seemed to shake the world,"},{"id":"semetey-2-2013:p1413:b004:l029","ordinal":295532,"en":"As though he would swallow anyone who turned."},{"id":"semetey-2-2013:p1413:b004:l030","ordinal":295533,"en":"He seemed able to win"},{"id":"semetey-2-2013:p1413:b004:l031","ordinal":295534,"en":"The offered prize without a word."},{"id":"semetey-2-2013:p1413:b004:l032","ordinal":295535,"en":"Küzhürmön had come;"},{"id":"semetey-2-2013:p1413:b004:l033","ordinal":295536,"en":"Huge and well matched to a hero,"},{"id":"semetey-2-2013:p1413:b004:l034","ordinal":295537,"en":"He entered the spear contest that time,"},{"id":"semetey-2-2013:p1413:b004:l035","ordinal":295538,"en":"And possessed immense strength."},{"id":"semetey-2-2013:p1413:b004:l036","ordinal":295539,"en":"He had jostled the whole world;"},{"id":"semetey-2-2013:p1413:b004:l037","ordinal":295540,"en":"In contests with the spear,"},{"id":"semetey-2-2013:p1413:b004:l038","ordinal":295541,"en":"The madman had won every prize"},{"id":"semetey-2-2013:p1413:b004:l039","ordinal":295542,"en":"Without letting anyone utter a sound."},{"id":"semetey-2-2013:p1414:b003:l001","ordinal":295543,"en":"He held sway over Zheti-Özön."},{"id":"semetey-2-2013:p1414:b003:l002","ordinal":295544,"en":"He began the struggle fiercely;"},{"id":"semetey-2-2013:p1414:b003:l003","ordinal":295545,"en":"Whenever he met a sworn enemy,"},{"id":"semetey-2-2013:p1414:b003:l004","ordinal":295546,"en":"That hulking, brutish slave"},{"id":"semetey-2-2013:p1414:b003:l005","ordinal":295547,"en":"Tore him limb from limb."},{"id":"semetey-2-2013:p1414:b003:l006","ordinal":295548,"en":"All who saw his figure marveled."},{"id":"semetey-2-2013:p1414:b003:l007","ordinal":295549,"en":"His spear was wound with brass;"},{"id":"semetey-2-2013:p1414:b003:l008","ordinal":295550,"en":"Whoever fought him collapsed."},{"id":"semetey-2-2013:p1414:b003:l009","ordinal":295551,"en":"Many wrestlers, encountering Küzhürmön,"},{"id":"semetey-2-2013:p1414:b003:l010","ordinal":295552,"en":"Had crawled away."},{"id":"semetey-2-2013:p1414:b003:l011","ordinal":295553,"en":"From among the people Küzhürmön"},{"id":"semetey-2-2013:p1414:b003:l012","ordinal":295554,"en":"Whipped on his Badam horse,"},{"id":"semetey-2-2013:p1414:b003:l013","ordinal":295555,"en":"Taking a pine-like spear;"},{"id":"semetey-2-2013:p1414:b003:l014","ordinal":295556,"en":"Enraged and fully prepared,"},{"id":"semetey-2-2013:p1414:b003:l015","ordinal":295557,"en":"Onto the marked bank and stony field"},{"id":"semetey-2-2013:p1414:b003:l016","ordinal":295558,"en":"He burst into the contest,"},{"id":"semetey-2-2013:p1414:b003:l017","ordinal":295559,"en":"Making his accursed champion steed"},{"id":"semetey-2-2013:p1414:b003:l018","ordinal":295560,"en":"Rear and surge beneath him."},{"id":"semetey-2-2013:p1414:b003:l019","ordinal":295561,"en":"If you ask about Karadöö,"},{"id":"semetey-2-2013:p1414:b003:l020","ordinal":295562,"en":"He was still somewhat childish and awkward,"},{"id":"semetey-2-2013:p1414:b003:l021","ordinal":295563,"en":"Still unseasoned in every speech."},{"id":"semetey-2-2013:p1414:b003:l022","ordinal":295564,"en":"Leaning against the gray mountain ridge,"},{"id":"semetey-2-2013:p1414:b003:l023","ordinal":295565,"en":"Wrapped in gray-mottled dust,"},{"id":"semetey-2-2013:p1414:b003:l024","ordinal":295566,"en":"He had never before competed for a prize,"},{"id":"semetey-2-2013:p1414:b003:l025","ordinal":295567,"en":"Never speared a man face to face,"},{"id":"semetey-2-2013:p1414:b003:l026","ordinal":295568,"en":"And had not yet won fame among the people."},{"id":"semetey-2-2013:p1414:b003:l027","ordinal":295569,"en":"The hardy warhorse,"},{"id":"semetey-2-2013:p1414:b003:l028","ordinal":295570,"en":"With sieve-like lungs and copper forelegs,"},{"id":"semetey-2-2013:p1414:b003:l029","ordinal":295571,"en":"The gray five-year-old fit for battle,"},{"id":"semetey-2-2013:p1414:b003:l030","ordinal":295572,"en":"Had been trained from birth"},{"id":"semetey-2-2013:p1414:b003:l031","ordinal":295573,"en":"And kept for Karadöö,"},{"id":"semetey-2-2013:p1414:b003:l032","ordinal":295574,"en":"For it was a true champion steed."},{"id":"semetey-2-2013:p1414:b003:l033","ordinal":295575,"en":"Its parrot-like tail streamed behind;"},{"id":"semetey-2-2013:p1414:b003:l034","ordinal":295576,"en":"The brass-beaked spirit woman"},{"id":"semetey-2-2013:p1414:b003:l035","ordinal":295577,"en":"Had tested and recognized it"},{"id":"semetey-2-2013:p1414:b003:l036","ordinal":295578,"en":"As an unfailing racer."},{"id":"semetey-2-2013:p1414:b003:l037","ordinal":295579,"en":"Many judges and skilled experts"},{"id":"semetey-2-2013:p1414:b003:l038","ordinal":295580,"en":"Had it raised unseen by the people."},{"id":"semetey-2-2013:p1414:b003:l039","ordinal":295581,"en":"At its birth Khan Koshoy,"},{"id":"semetey-2-2013:p1414:b004:l001","ordinal":295582,"en":"The aged father of the people,"},{"id":"semetey-2-2013:p1414:b004:l002","ordinal":295583,"en":"The saint who outlived generations,"},{"id":"semetey-2-2013:p1414:b004:l003","ordinal":295584,"en":"Saw and approved it."},{"id":"semetey-2-2013:p1414:b004:l004","ordinal":295585,"en":"Bilerik came from afar"},{"id":"semetey-2-2013:p1414:b004:l005","ordinal":295586,"en":"And repeatedly asked for it."},{"id":"semetey-2-2013:p1414:b004:l006","ordinal":295587,"en":"The gray-maned sultan Semetey"},{"id":"semetey-2-2013:p1414:b004:l007","ordinal":295588,"en":"Would not give it when asked:"},{"id":"semetey-2-2013:p1414:b004:l008","ordinal":295589,"en":"“Let this gray horse of Kambar-Ata"},{"id":"semetey-2-2013:p1414:b004:l009","ordinal":295590,"en":"Run among the herds;"},{"id":"semetey-2-2013:p1414:b004:l010","ordinal":295591,"en":"If hardship comes upon us,"},{"id":"semetey-2-2013:p1414:b004:l011","ordinal":295592,"en":"If a precious life is hard pressed,"},{"id":"semetey-2-2013:p1414:b004:l012","ordinal":295593,"en":"Unknown Karadöö,"},{"id":"semetey-2-2013:p1414:b004:l013","ordinal":295594,"en":"My falcon, shall ride it."},{"id":"semetey-2-2013:p1414:b004:l014","ordinal":295595,"en":"He will be my heir;"},{"id":"semetey-2-2013:p1414:b004:l015","ordinal":295596,"en":"Karadöö will mourn and weep for me,"},{"id":"semetey-2-2013:p1414:b004:l016","ordinal":295597,"en":"And grieve when I am gone."},{"id":"semetey-2-2013:p1414:b004:l017","ordinal":295598,"en":"It is a falcon no man should see,"},{"id":"semetey-2-2013:p1414:b004:l018","ordinal":295599,"en":"A steed surpassing many others."},{"id":"semetey-2-2013:p1414:b004:l019","ordinal":295600,"en":"Its back is high and its belly low;"},{"id":"semetey-2-2013:p1414:b004:l020","ordinal":295601,"en":"Wherever one rides it, it never tires."},{"id":"semetey-2-2013:p1414:b004:l021","ordinal":295602,"en":"Holding its reins never wearies the hand."},{"id":"semetey-2-2013:p1414:b004:l022","ordinal":295603,"en":"If a stallion charges into battle,"},{"id":"semetey-2-2013:p1414:b004:l023","ordinal":295604,"en":"It will not surrender its rider to the foe."},{"id":"semetey-2-2013:p1414:b004:l024","ordinal":295605,"en":"It must be kin to the kulan-chasing"},{"id":"semetey-2-2013:p1414:b004:l025","ordinal":295606,"en":"Karager of old Kaiyp,"},{"id":"semetey-2-2013:p1414:b004:l026","ordinal":295607,"en":"Zhoruger of the raider,"},{"id":"semetey-2-2013:p1414:b004:l027","ordinal":295608,"en":"And Er Töshtük's Chalkuiruk."},{"id":"semetey-2-2013:p1414:b004:l028","ordinal":295609,"en":"It must be kin to all of those."},{"id":"semetey-2-2013:p1414:b004:l029","ordinal":295610,"en":"It is a perfect, peerless steed;"},{"id":"semetey-2-2013:p1414:b004:l030","ordinal":295611,"en":"Those four princely horses are one kin,"},{"id":"semetey-2-2013:p1414:b004:l031","ordinal":295612,"en":"Children of the wind-spirit.”"},{"id":"semetey-2-2013:p1414:b004:l032","ordinal":295613,"en":"Encountered in the unseen,"},{"id":"semetey-2-2013:p1414:b004:l033","ordinal":295614,"en":"White-bearded old Kydyr,"},{"id":"semetey-2-2013:p1414:b004:l034","ordinal":295615,"en":"From old Kydyr's hands,"},{"id":"semetey-2-2013:p1414:b004:l035","ordinal":295616,"en":"From beyond Arabanty and Buura,"},{"id":"semetey-2-2013:p1414:b004:l036","ordinal":295617,"en":"Below those places,"},{"id":"semetey-2-2013:p1414:b004:l037","ordinal":295618,"en":"Beyond Andizhan"},{"id":"semetey-2-2013:p1414:b004:l038","ordinal":295619,"en":"And this side of Marghilan,"},{"id":"semetey-2-2013:p1414:b004:l039","ordinal":295620,"en":"The madcap, while still a foal,"},{"id":"semetey-2-2013:p1415:b003:l001","ordinal":295621,"en":"Had been found for Külchoro."},{"id":"semetey-2-2013:p1415:b003:l002","ordinal":295622,"en":"Its tail streamed even as a yearling;"},{"id":"semetey-2-2013:p1415:b003:l003","ordinal":295623,"en":"Knowing it would be an heir in hard times,"},{"id":"semetey-2-2013:p1415:b003:l004","ordinal":295624,"en":"Your wise mother Kanykei,"},{"id":"semetey-2-2013:p1415:b003:l005","ordinal":295625,"en":"That discerning woman, had tested it."},{"id":"semetey-2-2013:p1415:b003:l006","ordinal":295626,"en":"She had it covered carefully with a blanket"},{"id":"semetey-2-2013:p1415:b003:l007","ordinal":295627,"en":"And raised out of the people's sight."},{"id":"semetey-2-2013:p1415:b003:l008","ordinal":295628,"en":"Such was the gray five-year-old's story."},{"id":"semetey-2-2013:p1415:b003:l009","ordinal":295629,"en":"When the gray-maned hero vanished,"},{"id":"semetey-2-2013:p1415:b003:l010","ordinal":295630,"en":"Kanchoro seized Külchoro"},{"id":"semetey-2-2013:p1415:b003:l011","ordinal":295631,"en":"And gouged his right shoulder."},{"id":"semetey-2-2013:p1415:b003:l012","ordinal":295632,"en":"When sixty women and widowed sisters-in-law"},{"id":"semetey-2-2013:p1415:b003:l013","ordinal":295633,"en":"Were violently plundered,"},{"id":"semetey-2-2013:p1415:b003:l014","ordinal":295634,"en":"The hero Kutu of the Zhediger,"},{"id":"semetey-2-2013:p1415:b003:l015","ordinal":295635,"en":"A man of honest heart,"},{"id":"semetey-2-2013:p1415:b003:l016","ordinal":295636,"en":"Without letting any person know,"},{"id":"semetey-2-2013:p1415:b003:l017","ordinal":295637,"en":"Without letting anyone touch it,"},{"id":"semetey-2-2013:p1415:b003:l018","ordinal":295638,"en":"Without letting anyone consume it,"},{"id":"semetey-2-2013:p1415:b003:l019","ordinal":295639,"en":"Without letting it be called another's booty,"},{"id":"semetey-2-2013:p1415:b003:l020","ordinal":295640,"en":"Dressed Karadöö in the bulletproof mail"},{"id":"semetey-2-2013:p1415:b003:l021","ordinal":295641,"en":"The gray steed no bullet could reach,"},{"id":"semetey-2-2013:p1415:b003:l022","ordinal":295642,"en":"He mounted Karadöö upon it."},{"id":"semetey-2-2013:p1415:b003:l023","ordinal":295643,"en":"Thus the hero Kutu took him in,"},{"id":"semetey-2-2013:p1415:b003:l024","ordinal":295644,"en":"Named him Karadöö,"},{"id":"semetey-2-2013:p1415:b003:l025","ordinal":295645,"en":"And raised him."},{"id":"semetey-2-2013:p1415:b003:l026","ordinal":295646,"en":"Look upon Karadöö!"},{"id":"semetey-2-2013:p1415:b003:l027","ordinal":295647,"en":"If you ask about Karadöö,"},{"id":"semetey-2-2013:p1415:b003:l028","ordinal":295648,"en":"He was the very son of the hero Kutu."},{"id":"semetey-2-2013:p1415:b003:l029","ordinal":295649,"en":"There is much that could be told;"},{"id":"semetey-2-2013:p1415:b003:l030","ordinal":295650,"en":"Within Karadöö"},{"id":"semetey-2-2013:p1415:b003:l031","ordinal":295651,"en":"Were words as vast as Alaskar Mountain."},{"id":"semetey-2-2013:p1415:b003:l032","ordinal":295652,"en":"If you ask about Karadöö,"},{"id":"semetey-2-2013:p1415:b003:l033","ordinal":295653,"en":"Common iron is not keen steel,"},{"id":"semetey-2-2013:p1415:b003:l034","ordinal":295654,"en":"And a falcon raised elsewhere is no true kinsman."},{"id":"semetey-2-2013:p1415:b003:l035","ordinal":295655,"en":"If you ask about Karagul,"},{"id":"semetey-2-2013:p1415:b003:l036","ordinal":295656,"en":"Ambush lay within his words,"},{"id":"semetey-2-2013:p1415:b003:l037","ordinal":295657,"en":"And mischief moved in his eyes."},{"id":"semetey-2-2013:p1415:b003:l038","ordinal":295658,"en":"Malice moved in his eyes,"},{"id":"semetey-2-2013:p1415:b003:l039","ordinal":295659,"en":"Crookedness dwelt within him,"},{"id":"semetey-2-2013:p1415:b004:l001","ordinal":295660,"en":"And his gaze was askew."},{"id":"semetey-2-2013:p1415:b004:l002","ordinal":295661,"en":"If Karadöö found the opportunity,"},{"id":"semetey-2-2013:p1415:b004:l003","ordinal":295662,"en":"He meant to strike the hero Kyyaz himself."},{"id":"semetey-2-2013:p1415:b004:l004","ordinal":295663,"en":"Then Karadöö"},{"id":"semetey-2-2013:p1415:b004:l005","ordinal":295664,"en":"Girded on a bare, sheathless sword;"},{"id":"semetey-2-2013:p1415:b004:l006","ordinal":295665,"en":"Like a cloud returning with rain,"},{"id":"semetey-2-2013:p1415:b004:l007","ordinal":295666,"en":"Wrath spread across his face."},{"id":"semetey-2-2013:p1415:b004:l008","ordinal":295667,"en":"Thick-wristed and stone-hearted,"},{"id":"semetey-2-2013:p1415:b004:l009","ordinal":295668,"en":"That perfectly built champion"},{"id":"semetey-2-2013:p1415:b004:l010","ordinal":295669,"en":"Raised his cavernous spear"},{"id":"semetey-2-2013:p1415:b004:l011","ordinal":295670,"en":"High overhead."},{"id":"semetey-2-2013:p1415:b004:l012","ordinal":295671,"en":"When he drove it home,"},{"id":"semetey-2-2013:p1415:b004:l013","ordinal":295672,"en":"He crushed a man into ground the size of a sheep;"},{"id":"semetey-2-2013:p1415:b004:l014","ordinal":295673,"en":"When he charged in close,"},{"id":"semetey-2-2013:p1415:b004:l015","ordinal":295674,"en":"He never opened his armpit in fear."},{"id":"semetey-2-2013:p1415:b004:l016","ordinal":295675,"en":"His stratagems were stern, his venom strong;"},{"id":"semetey-2-2013:p1415:b004:l017","ordinal":295676,"en":"He laid flat anyone who challenged him."},{"id":"semetey-2-2013:p1415:b004:l018","ordinal":295677,"en":"His youth was extraordinary,"},{"id":"semetey-2-2013:p1415:b004:l019","ordinal":295678,"en":"His courage immense—"},{"id":"semetey-2-2013:p1415:b004:l020","ordinal":295679,"en":"Ask no more about Karadöö!"},{"id":"semetey-2-2013:p1415:b004:l021","ordinal":295680,"en":"His tread raised dust;"}]
