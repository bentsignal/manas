{"id": "sayakbay-ms-current146:pdf022:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 22, "folio": 405, "line_in_page": 14, "raw": "Иштин көрүп күлүптүр,", "text": "Иштин көрүп күлүптүр,", "en": "Seeing the affair, he laughed,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The first word may have a different case ending; күлүптүр is the clearest reading of the final word.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf022:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 22, "folio": 405, "line_in_page": 15, "raw": "Айбаттанса чочуптур,", "text": "Айбаттанса чочуптур,", "en": "When he showed his might, they recoiled in fear,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The final word is faint but most closely resembles чочуптур.", "bbox": null}
