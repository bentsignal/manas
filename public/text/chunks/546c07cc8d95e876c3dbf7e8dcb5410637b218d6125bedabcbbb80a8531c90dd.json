[{"id":"manas-2010:p1635:b001:l021","ordinal":70401,"en":"With his wings broken,"},{"id":"manas-2010:p1635:b001:l022","ordinal":70402,"en":"At that moment your Chubak"},{"id":"manas-2010:p1635:b001:l023","ordinal":70403,"en":"Was parted from Kögala."},{"id":"manas-2010:p1635:b001:l024","ordinal":70404,"en":"An iron net encircled him;"},{"id":"manas-2010:p1635:b001:l025","ordinal":70405,"en":"Calling the war cry, “Möndü!”"},{"id":"manas-2010:p1635:b001:l026","ordinal":70406,"en":"The mighty host swept over him."},{"id":"manas-2010:p1635:b001:l027","ordinal":70407,"en":"It became seething misfortune;"},{"id":"manas-2010:p1635:b001:l028","ordinal":70408,"en":"All around him was a bellowing army."},{"id":"manas-2010:p1635:b001:l029","ordinal":70409,"en":"The Chinese had come in throngs."},{"id":"manas-2010:p1635:b001:l030","ordinal":70410,"en":"Sarala with the cow-like tail-root—"},{"id":"manas-2010:p1635:b001:l031","ordinal":70411,"en":"Herding and smashing them,"},{"id":"manas-2010:p1635:b001:l032","ordinal":70412,"en":"Your Almambet kept driving them together."},{"id":"manas-2010:p1635:b001:l033","ordinal":70413,"en":"“Where is my twin Chubak?” he said."},{"id":"manas-2010:p1635:b001:l034","ordinal":70414,"en":"Leaning down and fighting,"},{"id":"manas-2010:p1635:b001:l035","ordinal":70415,"en":"Your Almambet kept seeking him!"},{"id":"manas-2010:p1635:b001:l036","ordinal":70416,"en":"Smashing their center,"},{"id":"manas-2010:p1635:b001:l037","ordinal":70417,"en":"Your Almambet kept battering them."},{"id":"manas-2010:p1635:b001:l038","ordinal":70418,"en":"“Where is my mighty Chubak?” he said."},{"id":"manas-2010:p1635:b001:l039","ordinal":70419,"en":"Your Almambet kept looking then."},{"id":"manas-2010:p1635:b001:l040","ordinal":70420,"en":"Within the bloody slaughter,"},{"id":"manas-2010:p1635:b001:l041","ordinal":70421,"en":"Your Almambet kept stopping."},{"id":"manas-2010:p1635:b001:l042","ordinal":70422,"en":"“Where has my twin gone?” he said."},{"id":"manas-2010:p1636:b001:l001","ordinal":70423,"en":"Your Almambet kept seeking him!"},{"id":"manas-2010:p1636:b001:l002","ordinal":70424,"en":"From the hollow curved like a saddle-pass,"},{"id":"manas-2010:p1636:b001:l003","ordinal":70425,"en":"Your dear Almambet, outstanding one,"},{"id":"manas-2010:p1636:b001:l004","ordinal":70426,"en":"Came out and looked."},{"id":"manas-2010:p1636:b001:l005","ordinal":70427,"en":"The many shapes spread before him—"},{"id":"manas-2010:p1636:b001:l006","ordinal":70428,"en":"What he took for a forest was people."},{"id":"manas-2010:p1636:b001:l007","ordinal":70429,"en":"What gleamed there, dimly burning—"},{"id":"manas-2010:p1636:b001:l008","ordinal":70430,"en":"What he took for stars was embers."},{"id":"manas-2010:p1636:b001:l009","ordinal":70431,"en":"The many darkly burning flashes—"},{"id":"manas-2010:p1636:b001:l010","ordinal":70432,"en":"What he took for tumbleweed was bullets."},{"id":"manas-2010:p1636:b001:l011","ordinal":70433,"en":"What appeared dark and looming"},{"id":"manas-2010:p1636:b001:l012","ordinal":70434,"en":"Was a swelling black army."},{"id":"manas-2010:p1636:b001:l013","ordinal":70435,"en":"Chubak could not be seen then;"},{"id":"manas-2010:p1636:b001:l014","ordinal":70436,"en":"That was Almambet’s misfortune."},{"id":"manas-2010:p1636:b001:l015","ordinal":70437,"en":"What stood up tall before him—"},{"id":"manas-2010:p1636:b001:l016","ordinal":70438,"en":"What he took for reeds was people."},{"id":"manas-2010:p1636:b001:l017","ordinal":70439,"en":"Khan Baltay’s Chubak"},{"id":"manas-2010:p1636:b001:l018","ordinal":70440,"en":"They had surrounded then!"},{"id":"manas-2010:p1636:b001:l019","ordinal":70441,"en":"The Chinese of forty tribes, that dear people,"},{"id":"manas-2010:p1636:b001:l020","ordinal":70442,"en":"Raised their voices in shouts."},{"id":"manas-2010:p1636:b001:l021","ordinal":70443,"en":"Their mighty Mangküsh and Kongurbay"},{"id":"manas-2010:p1636:b001:l022","ordinal":70444,"en":"Had encircled him."},{"id":"manas-2010:p1636:b001:l023","ordinal":70445,"en":"Parted from Kögala,"},{"id":"manas-2010:p1636:b001:l024","ordinal":70446,"en":"Your fierce Chubak, the leopard,"},{"id":"manas-2010:p1636:b001:l025","ordinal":70447,"en":"Into the hands of the swarming Chinese"},{"id":"manas-2010:p1636:b001:l026","ordinal":70448,"en":"Had fallen!"},{"id":"manas-2010:p1636:b001:l027","ordinal":70449,"en":"All the archers"},{"id":"manas-2010:p1636:b001:l028","ordinal":70450,"en":"Made ready like takers of souls."},{"id":"manas-2010:p1636:b001:l029","ordinal":70451,"en":"With brave Kalcha their foremost man,"},{"id":"manas-2010:p1636:b001:l030","ordinal":70452,"en":"They swarmed over Chubak alone."},{"id":"manas-2010:p1636:b001:l031","ordinal":70453,"en":"All the lasso-men"},{"id":"manas-2010:p1636:b001:l032","ordinal":70454,"en":"Made ready, saying, “I shall bind him.”"},{"id":"manas-2010:p1636:b001:l033","ordinal":70455,"en":"The champions ran in throngs;"},{"id":"manas-2010:p1636:b001:l034","ordinal":70456,"en":"Pressure fell upon Chubak;"},{"id":"manas-2010:p1636:b001:l035","ordinal":70457,"en":"The poor bastard despaired of life."},{"id":"manas-2010:p1636:b001:l036","ordinal":70458,"en":"As the Chinese swarmed over him,"},{"id":"manas-2010:p1636:b001:l037","ordinal":70459,"en":"Your leopard hero Almambet said,"},{"id":"manas-2010:p1636:b001:l038","ordinal":70460,"en":"“Let me reach Khan Chubak!"},{"id":"manas-2010:p1636:b001:l039","ordinal":70461,"en":"If I can manage, from the Chinese,"},{"id":"manas-2010:p1636:b001:l040","ordinal":70462,"en":"The leopard Chubak, the eagle—"},{"id":"manas-2010:p1636:b001:l041","ordinal":70463,"en":"Mighty Chubak, my twin!”"},{"id":"manas-2010:p1636:b001:l042","ordinal":70464,"en":"Your outstanding eagle Almambet"},{"id":"manas-2010:p1637:b001:l001","ordinal":70465,"en":"Raised a shout then."},{"id":"manas-2010:p1637:b001:l002","ordinal":70466,"en":"He arrived ahead of an arrow;"},{"id":"manas-2010:p1637:b001:l003","ordinal":70467,"en":"As soon as he reached his Chubak,"},{"id":"manas-2010:p1637:b001:l004","ordinal":70468,"en":"He slung him up and fled past."},{"id":"manas-2010:p1637:b001:l005","ordinal":70469,"en":"Kindling his extinguished fire,"},{"id":"manas-2010:p1637:b001:l006","ordinal":70470,"en":"Akbaltay’s Chubak—"},{"id":"manas-2010:p1637:b001:l007","ordinal":70471,"en":"Restoring his deadened life,"},{"id":"manas-2010:p1637:b001:l008","ordinal":70472,"en":"He set him on his right knee."},{"id":"manas-2010:p1637:b001:l009","ordinal":70473,"en":"Sarala beneath him,"},{"id":"manas-2010:p1637:b001:l010","ordinal":70474,"en":"He whipped on either side,"},{"id":"manas-2010:p1637:b001:l011","ordinal":70475,"en":"Spurred right and left."},{"id":"manas-2010:p1637:b001:l012","ordinal":70476,"en":"For the sake of that entrusted life,"},{"id":"manas-2010:p1637:b001:l013","ordinal":70477,"en":"He hurried out, did you see?"},{"id":"manas-2010:p1637:b001:l014","ordinal":70478,"en":"Carrying off his Chubak,"},{"id":"manas-2010:p1637:b001:l015","ordinal":70479,"en":"He escaped, did you see?"},{"id":"manas-2010:p1637:b001:l016","ordinal":70480,"en":"Kögala standing on their path—"},{"id":"manas-2010:p1637:b001:l017","ordinal":70481,"en":"Your tiger Almambet reached him."},{"id":"manas-2010:p1637:b001:l018","ordinal":70482,"en":"As soon as he reached him, Chubak"},{"id":"manas-2010:p1637:b001:l019","ordinal":70483,"en":"He set upon him and fled past."},{"id":"manas-2010:p1637:b001:l020","ordinal":70484,"en":"Once Chubak was mounted,"},{"id":"manas-2010:p1637:b001:l021","ordinal":70485,"en":"Once the reins were in his hands,"},{"id":"manas-2010:p1637:b001:l022","ordinal":70486,"en":"See the reeds, see the flood!"},{"id":"manas-2010:p1637:b001:l023","ordinal":70487,"en":"Bellowing their battle cry,"},{"id":"manas-2010:p1637:b001:l024","ordinal":70488,"en":"See the Chinese people sweeping on."},{"id":"manas-2010:p1637:b001:l025","ordinal":70489,"en":"See the forest, see the host!"},{"id":"manas-2010:p1637:b001:l026","ordinal":70490,"en":"See the bullets striking without cease!"},{"id":"manas-2010:p1637:b001:l027","ordinal":70491,"en":"See the deep-dug pit!"},{"id":"manas-2010:p1637:b001:l028","ordinal":70492,"en":"With their champion Kalcha at their head,"},{"id":"manas-2010:p1637:b001:l029","ordinal":70493,"en":"See the Chinese people coming!"},{"id":"manas-2010:p1637:b001:l030","ordinal":70494,"en":"The Chinese were a people in ilek;"},{"id":"manas-2010:p1637:b001:l031","ordinal":70495,"en":"His Holiness Aaly, the lion,"},{"id":"manas-2010:p1637:b001:l032","ordinal":70496,"en":"Had traveled through this land."},{"id":"manas-2010:p1637:b001:l033","ordinal":70497,"en":"Where the Flood never rushed in,"},{"id":"manas-2010:p1637:b001:l034","ordinal":70498,"en":"The Chinese people filled the land."},{"id":"manas-2010:p1637:b001:l035","ordinal":70499,"en":"The Muslims, small as a knucklebone,"},{"id":"manas-2010:p1637:b001:l036","ordinal":70500,"en":"Were about to fall captive."},{"id":"manas-2010:p1637:b001:l037","ordinal":70501,"en":"The more they died, the more they multiplied—"},{"id":"manas-2010:p1637:b001:l038","ordinal":70502,"en":"Such were the mighty Chinese people!"},{"id":"manas-2010:p1637:b001:l039","ordinal":70503,"en":"They had no support to rely on;"},{"id":"manas-2010:p1637:b001:l040","ordinal":70504,"en":"To bind a bandage about their waists,"},{"id":"manas-2010:p1637:b001:l041","ordinal":70505,"en":"Their renowned lion Manas was absent."},{"id":"manas-2010:p1637:b001:l042","ordinal":70506,"en":"They had no crag that geese could not circle,"},{"id":"manas-2010:p1638:b001:l001","ordinal":70507,"en":"They had no mighty black mountain,"},{"id":"manas-2010:p1638:b001:l002","ordinal":70508,"en":"No secure pass to hold."},{"id":"manas-2010:p1638:b001:l003","ordinal":70509,"en":"A grievous task, bearing hardship—"},{"id":"manas-2010:p1638:b001:l004","ordinal":70510,"en":"Their renowned lion Manas was absent!"},{"id":"manas-2010:p1638:b001:l005","ordinal":70511,"en":"They had no mountain that geese could not circle,"},{"id":"manas-2010:p1638:b001:l006","ordinal":70512,"en":"No dark crag of strength,"},{"id":"manas-2010:p1638:b001:l007","ordinal":70513,"en":"Their khans Muzburchak and Kökchö were absent."},{"id":"manas-2010:p1638:b001:l008","ordinal":70514,"en":"Now it had become a grievous task;"},{"id":"manas-2010:p1638:b001:l009","ordinal":70515,"en":"All the Muslims were absent!"},{"id":"manas-2010:p1638:b001:l010","ordinal":70516,"en":"When he saw this absence,"},{"id":"manas-2010:p1638:b001:l011","ordinal":70517,"en":"From beardless Beijing,"},{"id":"manas-2010:p1638:b001:l012","ordinal":70518,"en":"Its lord had arrived."},{"id":"manas-2010:p1638:b001:l013","ordinal":70519,"en":"Its champions Kalcha and Kozhozhash,"},{"id":"manas-2010:p1638:b001:l014","ordinal":70520,"en":"Its heroes had arrived."},{"id":"manas-2010:p1638:b001:l015","ordinal":70521,"en":"Karazhoy’s son Kozhozhash,"},{"id":"manas-2010:p1638:b001:l016","ordinal":70522,"en":"A skilled horseman, a swift foot-runner,"},{"id":"manas-2010:p1638:b001:l017","ordinal":70523,"en":"A great marksman in the treasury’s service."},{"id":"manas-2010:p1638:b001:l018","ordinal":70524,"en":"He had saddled his gray filly."},{"id":"manas-2010:p1638:b001:l019","ordinal":70525,"en":"Once six thousand boys had gone together;"},{"id":"manas-2010:p1638:b001:l020","ordinal":70526,"en":"Six thousand boys had perished,"},{"id":"manas-2010:p1638:b001:l021","ordinal":70527,"en":"And six boys had remained together."},{"id":"manas-2010:p1638:b001:l022","ordinal":70528,"en":"The wondrous arts"},{"id":"manas-2010:p1638:b001:l023","ordinal":70529,"en":"While he was studying,"},{"id":"manas-2010:p1638:b001:l024","ordinal":70530,"en":"The gray filly beneath him,"},{"id":"manas-2010:p1638:b001:l025","ordinal":70531,"en":"The gray filly he saddled—"},{"id":"manas-2010:p1638:b001:l026","ordinal":70532,"en":"This eagle, ahead of your Almambet,"},{"id":"manas-2010:p1638:b001:l027","ordinal":70533,"en":"Had studied six months earlier."},{"id":"manas-2010:p1638:b001:l028","ordinal":70534,"en":"For his inner flesh, bulletproof protection,"},{"id":"manas-2010:p1638:b001:l029","ordinal":70535,"en":"Had he not put it on then?"},{"id":"manas-2010:p1638:b001:l030","ordinal":70536,"en":"Beyond your Almambet,"},{"id":"manas-2010:p1638:b001:l031","ordinal":70537,"en":"The dragon’s teaching,"},{"id":"manas-2010:p1638:b001:l032","ordinal":70538,"en":"Had he not come to know it?"},{"id":"manas-2010:p1638:b001:l033","ordinal":70539,"en":"He had heard news from those who came:"},{"id":"manas-2010:p1638:b001:l034","ordinal":70540,"en":"Kozhozhash had not died or perished;"},{"id":"manas-2010:p1638:b001:l035","ordinal":70541,"en":"In Beijing with its kakan,"},{"id":"manas-2010:p1638:b001:l036","ordinal":70542,"en":"He had heard he was merely ill with fever."},{"id":"manas-2010:p1638:b001:l037","ordinal":70543,"en":"For the Chinese who had known no joy,"},{"id":"manas-2010:p1638:b001:l038","ordinal":70544,"en":"Their day had dawned."},{"id":"manas-2010:p1638:b001:l039","ordinal":70545,"en":"Into that slaughter,"},{"id":"manas-2010:p1638:b001:l040","ordinal":70546,"en":"The skilled horseman, swift foot-runner,"},{"id":"manas-2010:p1638:b001:l041","ordinal":70547,"en":"Kozhozhash had arrived."},{"id":"manas-2010:p1638:b001:l042","ordinal":70548,"en":"He was support to rely on,"},{"id":"manas-2010:p1639:b001:l001","ordinal":70549,"en":"A lion who came out of Beijing."},{"id":"manas-2010:p1639:b001:l002","ordinal":70550,"en":"Whoever he struck did not return alive;"},{"id":"manas-2010:p1639:b001:l003","ordinal":70551,"en":"No living man could withdraw."},{"id":"manas-2010:p1639:b001:l004","ordinal":70552,"en":"When he saw Kozhozhash,"},{"id":"manas-2010:p1639:b001:l005","ordinal":70553,"en":"With golden forelock and tasseled sash,"},{"id":"manas-2010:p1639:b001:l006","ordinal":70554,"en":"Azizkan’s only son"},{"id":"manas-2010:p1639:b001:l007","ordinal":70555,"en":"Karykan’s weather-stone"},{"id":"manas-2010:p1639:b001:l008","ordinal":70556,"en":"Took out from beside his groin."},{"id":"manas-2010:p1639:b001:l009","ordinal":70557,"en":"A cupful of plain water"},{"id":"manas-2010:p1639:b001:l010","ordinal":70558,"en":"He made roar aloud."},{"id":"manas-2010:p1639:b001:l011","ordinal":70559,"en":"Rain fell on all the lowlands;"},{"id":"manas-2010:p1639:b001:l012","ordinal":70560,"en":"Hail fell on all the foothills."},{"id":"manas-2010:p1639:b001:l013","ordinal":70561,"en":"He made a summer day into winter;"},{"id":"manas-2010:p1639:b001:l014","ordinal":70562,"en":"The thinly clad Chinese,"},{"id":"manas-2010:p1639:b001:l015","ordinal":70563,"en":"He made whimper like girls."},{"id":"manas-2010:p1639:b001:l016","ordinal":70564,"en":"Shouting, “Islam!”"},{"id":"manas-2010:p1639:b001:l017","ordinal":70565,"en":"At those Chinese before him,"},{"id":"manas-2010:p1639:b001:l018","ordinal":70566,"en":"Almambet turned back"},{"id":"manas-2010:p1639:b001:l019","ordinal":70567,"en":"And drove them, scattering them."},{"id":"manas-2010:p1639:b001:l020","ordinal":70568,"en":"Their center, your Almambet"},{"id":"manas-2010:p1639:b001:l021","ordinal":70569,"en":"Carved out as he came."},{"id":"manas-2010:p1639:b001:l022","ordinal":70570,"en":"Those around him, your Chubak"},{"id":"manas-2010:p1639:b001:l023","ordinal":70571,"en":"Slaughtered as he came."},{"id":"manas-2010:p1639:b001:l024","ordinal":70572,"en":"Those at the very edge, the forty companions"},{"id":"manas-2010:p1639:b001:l025","ordinal":70573,"en":"Slaughtered as they came."},{"id":"manas-2010:p1639:b001:l026","ordinal":70574,"en":"The treasure of the forty companions,"},{"id":"manas-2010:p1639:b001:l027","ordinal":70575,"en":"Old Kyrgyl, leader of the forty,"},{"id":"manas-2010:p1639:b001:l028","ordinal":70576,"en":"And the mighty hero Shuutu were there."},{"id":"manas-2010:p1639:b001:l029","ordinal":70577,"en":"Argynkan’s Azhybay,"},{"id":"manas-2010:p1639:b001:l030","ordinal":70578,"en":"Akbaltay’s Chubak was there."},{"id":"manas-2010:p1639:b001:l031","ordinal":70579,"en":"Akayar, who lifted a camel,"},{"id":"manas-2010:p1639:b001:l032","ordinal":70580,"en":"All the champions were there."},{"id":"manas-2010:p1639:b001:l033","ordinal":70581,"en":"The khans Koshoy and Töshtük were there;"},{"id":"manas-2010:p1639:b001:l034","ordinal":70582,"en":"All of Islam was there."},{"id":"manas-2010:p1639:b001:l035","ordinal":70583,"en":"Among horses, the wondrous Alabash;"},{"id":"manas-2010:p1639:b001:l036","ordinal":70584,"en":"Almambet and Chubak together,"},{"id":"manas-2010:p1639:b001:l037","ordinal":70585,"en":"Girding leather belts about their waists,"},{"id":"manas-2010:p1639:b001:l038","ordinal":70586,"en":"Against seven san of Black Chinese,"},{"id":"manas-2010:p1639:b001:l039","ordinal":70587,"en":"Plunged in alone to attack."},{"id":"manas-2010:p1639:b001:l040","ordinal":70588,"en":"Without looking around them,"},{"id":"manas-2010:p1639:b001:l041","ordinal":70589,"en":"Without sparing their lives at all,"},{"id":"manas-2010:p1639:b001:l042","ordinal":70590,"en":"Without looking along the ranks,"},{"id":"manas-2010:p1640:b001:l001","ordinal":70591,"en":"Without sparing their threadlike lives,"},{"id":"manas-2010:p1640:b001:l002","ordinal":70592,"en":"Without resting even on an elbow,"},{"id":"manas-2010:p1640:b001:l003","ordinal":70593,"en":"Without a moment’s sleep,"},{"id":"manas-2010:p1640:b001:l004","ordinal":70594,"en":"They took no rest by day;"},{"id":"manas-2010:p1640:b001:l005","ordinal":70595,"en":"They took no rest at night."},{"id":"manas-2010:p1640:b001:l006","ordinal":70596,"en":"Beijing with its kakan,"},{"id":"manas-2010:p1640:b001:l007","ordinal":70597,"en":"Making its Chinese howl,"},{"id":"manas-2010:p1640:b001:l008","ordinal":70598,"en":"Into Munaryk’s desert"},{"id":"manas-2010:p1640:b001:l009","ordinal":70599,"en":"They split them off and drove them."},{"id":"manas-2010:p1640:b001:l010","ordinal":70600,"en":"See the hair dragging along!"},{"id":"manas-2010:p1640:b001:l011","ordinal":70601,"en":"See the severed heads!"},{"id":"manas-2010:p1640:b001:l012","ordinal":70602,"en":"See the flood flowing!"},{"id":"manas-2010:p1640:b001:l013","ordinal":70603,"en":"See the Chinese people slaughtered!"},{"id":"manas-2010:p1640:b001:l014","ordinal":70604,"en":"See the grass upon the earth!"},{"id":"manas-2010:p1640:b001:l015","ordinal":70605,"en":"See the Chinese as numerous as grass!"},{"id":"manas-2010:p1640:b001:l016","ordinal":70606,"en":"Iskender had left no footprint there;"},{"id":"manas-2010:p1640:b001:l017","ordinal":70607,"en":"From this Beijing before them"},{"id":"manas-2010:p1640:b001:l018","ordinal":70608,"en":"Sulayman had taken no account."},{"id":"manas-2010:p1640:b001:l019","ordinal":70609,"en":"The more they were depleted, the more they rose—"},{"id":"manas-2010:p1640:b001:l020","ordinal":70610,"en":"Such were the deeply rooted people of Beijing."},{"id":"manas-2010:p1640:b001:l021","ordinal":70611,"en":"The faith of Islam, small as a palm,"},{"id":"manas-2010:p1640:b001:l022","ordinal":70612,"en":"Was about to be exhausted."},{"id":"manas-2010:p1640:b001:l023","ordinal":70613,"en":"From the Chinese in Beijing,"},{"id":"manas-2010:p1640:b001:l024","ordinal":70614,"en":"A khan named Alöökö had arisen."},{"id":"manas-2010:p1640:b001:l025","ordinal":70615,"en":"Alöökö’s Kongurbay,"},{"id":"manas-2010:p1640:b001:l026","ordinal":70616,"en":"His voice drove out men’s souls."},{"id":"manas-2010:p1640:b001:l027","ordinal":70617,"en":"With cotton sash and broad boots,"},{"id":"manas-2010:p1640:b001:l028","ordinal":70618,"en":"Kongurbay, khan of the shaven ones,"},{"id":"manas-2010:p1640:b001:l029","ordinal":70619,"en":"That pig who knew the enemy’s stratagems!"},{"id":"manas-2010:p1640:b001:l030","ordinal":70620,"en":"The bastard’s black horse,"},{"id":"manas-2010:p1640:b001:l031","ordinal":70621,"en":"His black horse had"},{"id":"manas-2010:p1640:b001:l032","ordinal":70622,"en":"Wings upon its flanks."},{"id":"manas-2010:p1640:b001:l033","ordinal":70623,"en":"Whenever it came to the world,"},{"id":"manas-2010:p1640:b001:l034","ordinal":70624,"en":"Alöökö’s Kongurbay"},{"id":"manas-2010:p1640:b001:l035","ordinal":70625,"en":"Was accustomed to churn it like ground grain."},{"id":"manas-2010:p1640:b001:l036","ordinal":70626,"en":"His roar splitting stone,"},{"id":"manas-2010:p1640:b001:l037","ordinal":70627,"en":"His shout splitting heads,"},{"id":"manas-2010:p1640:b001:l038","ordinal":70628,"en":"Algara’s mouth,"},{"id":"manas-2010:p1640:b001:l039","ordinal":70629,"en":"Your warrior drew in."},{"id":"manas-2010:p1640:b001:l040","ordinal":70630,"en":"Six san of Black Kalmyks"},{"id":"manas-2010:p1640:b001:l041","ordinal":70631,"en":"He turned back and drove along."},{"id":"manas-2010:p1640:b001:l042","ordinal":70632,"en":"Of the Chinese wearing jackets,"},{"id":"manas-2010:p1641:b001:l001","ordinal":70633,"en":"He separated out the strongest."},{"id":"manas-2010:p1641:b001:l002","ordinal":70634,"en":"Of the Chinese officials with rank beads,"},{"id":"manas-2010:p1641:b001:l003","ordinal":70635,"en":"He separated out the best."},{"id":"manas-2010:p1641:b001:l004","ordinal":70636,"en":"Those who girded sashes and boasted of strength,"},{"id":"manas-2010:p1641:b001:l005","ordinal":70637,"en":"His warriors, he separated out."},{"id":"manas-2010:p1641:b001:l006","ordinal":70638,"en":"Those skilled at thrusting lances"},{"id":"manas-2010:p1641:b001:l007","ordinal":70639,"en":"He set apart on the hills."},{"id":"manas-2010:p1641:b001:l008","ordinal":70640,"en":"The marksmen who never missed"},{"id":"manas-2010:p1641:b001:l009","ordinal":70641,"en":"He separated into another band."},{"id":"manas-2010:p1641:b001:l010","ordinal":70642,"en":"All the choice champions"},{"id":"manas-2010:p1641:b001:l011","ordinal":70643,"en":"Spread out along the edges;"},{"id":"manas-2010:p1641:b001:l012","ordinal":70644,"en":"All the utter weaklings,"},{"id":"manas-2010:p1641:b001:l013","ordinal":70645,"en":"Drooping as though jaundiced,"},{"id":"manas-2010:p1641:b001:l014","ordinal":70646,"en":"Were penned in the middle."},{"id":"manas-2010:p1641:b001:l015","ordinal":70647,"en":"All the heroes grew frenzied;"},{"id":"manas-2010:p1641:b001:l016","ordinal":70648,"en":"All the lions"},{"id":"manas-2010:p1641:b001:l017","ordinal":70649,"en":"Raged along the edges."},{"id":"manas-2010:p1641:b001:l018","ordinal":70650,"en":"The commanders of ten bobbed along;"},{"id":"manas-2010:p1641:b001:l019","ordinal":70651,"en":"The heroes commanding fifty,"},{"id":"manas-2010:p1641:b001:l020","ordinal":70652,"en":"Their lances stuck up."},{"id":"manas-2010:p1641:b001:l021","ordinal":70653,"en":"The commanders of a hundred ran;"},{"id":"manas-2010:p1641:b001:l022","ordinal":70654,"en":"The governors commanding a thousand"},{"id":"manas-2010:p1641:b001:l023","ordinal":70655,"en":"Despaired of their dear lives."},{"id":"manas-2010:p1641:b001:l024","ordinal":70656,"en":"Clad in mottled red,"}]
