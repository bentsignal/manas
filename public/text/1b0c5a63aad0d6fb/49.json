[{"id":"manas-2010:p0278:b001:l020","ordinal":12545,"en":"How could I fail to reach it?"},{"id":"manas-2010:p0278:b001:l021","ordinal":12546,"en":"Once humiliation fell upon my head,"},{"id":"manas-2010:p0278:b001:l022","ordinal":12547,"en":"How could I, Koshoy, in misery,"},{"id":"manas-2010:p0278:b001:l023","ordinal":12548,"en":"Fail to go away!"},{"id":"manas-2010:p0278:b001:l024","ordinal":12549,"en":"Back then the Black Kalmyks and Manchus"},{"id":"manas-2010:p0278:b001:l025","ordinal":12550,"en":"Raided my migrating people at the ford."},{"id":"manas-2010:p0278:b001:l026","ordinal":12551,"en":"While my head still rests free,"},{"id":"manas-2010:p0278:b001:l027","ordinal":12552,"en":"Against the quarrelsome Chinese"},{"id":"manas-2010:p0278:b001:l028","ordinal":12553,"en":"I have yet to take my revenge."},{"id":"manas-2010:p0278:b001:l029","ordinal":12554,"en":"They raided my migrating people on the steppe;"},{"id":"manas-2010:p0278:b001:l030","ordinal":12555,"en":"Against the swaggering Black Kalmyks"},{"id":"manas-2010:p0278:b001:l031","ordinal":12556,"en":"I have yet to take my revenge!"},{"id":"manas-2010:p0278:b001:l032","ordinal":12557,"en":"When the Chinese brought slaughter,"},{"id":"manas-2010:p0278:b001:l033","ordinal":12558,"en":"Slaughtered the Kyrgyz,"},{"id":"manas-2010:p0278:b001:l034","ordinal":12559,"en":"And made them dependent,"},{"id":"manas-2010:p0278:b001:l035","ordinal":12560,"en":"When they killed the mighty,"},{"id":"manas-2010:p0278:b001:l036","ordinal":12561,"en":"When the weak and feeble"},{"id":"manas-2010:p0278:b001:l037","ordinal":12562,"en":"Were bound alive,"},{"id":"manas-2010:p0278:b001:l038","ordinal":12563,"en":"When your father Jakyp and Baltay,"},{"id":"manas-2010:p0278:b001:l039","ordinal":12564,"en":"As booty, to Altay"},{"id":"manas-2010:p0278:b001:l040","ordinal":12565,"en":"Were driven away,"},{"id":"manas-2010:p0278:b001:l041","ordinal":12566,"en":"The blue, fearsome star was eclipsed in the sky."},{"id":"manas-2010:p0278:b001:l042","ordinal":12567,"en":"Your wolf-maned elder Koshoy"},{"id":"manas-2010:p0278:b001:l043","ordinal":12568,"en":"Escaped by fleeing openly,"},{"id":"manas-2010:p0278:b001:l044","ordinal":12569,"en":"Leaving this land of mine,"},{"id":"manas-2010:p0278:b001:l045","ordinal":12570,"en":"Losing the flesh of my muscles,"},{"id":"manas-2010:p0278:b001:l046","ordinal":12571,"en":"Facing a deep-dug trench,"},{"id":"manas-2010:p0278:b001:l047","ordinal":12572,"en":"Suffering such violence from unbelievers,"},{"id":"manas-2010:p0278:b001:l048","ordinal":12573,"en":"Suffering humiliation like a sheep,"},{"id":"manas-2010:p0279:b001:l001","ordinal":12574,"en":"When a spearman, a commander,"},{"id":"manas-2010:p0279:b001:l002","ordinal":12575,"en":"Died at the hands of the Manchus,"},{"id":"manas-2010:p0279:b001:l003","ordinal":12576,"en":"I entered Mecca, wretched soul,"},{"id":"manas-2010:p0279:b001:l004","ordinal":12577,"en":"Exiled and wandering then,"},{"id":"manas-2010:p0279:b001:l005","ordinal":12578,"en":"I entered alone, wretched soul."},{"id":"manas-2010:p0279:b001:l006","ordinal":12579,"en":"Returning without dying or vanishing,"},{"id":"manas-2010:p0279:b001:l007","ordinal":12580,"en":"Your elder brought beyond all bounds,"},{"id":"manas-2010:p0279:b001:l008","ordinal":12581,"en":"Bereft of heroes,"},{"id":"manas-2010:p0279:b001:l009","ordinal":12582,"en":"I went and settled in Mecca,"},{"id":"manas-2010:p0279:b001:l010","ordinal":12583,"en":"I stayed there five years."},{"id":"manas-2010:p0279:b001:l011","ordinal":12584,"en":"I studied in Mecca five years,"},{"id":"manas-2010:p0279:b001:l012","ordinal":12585,"en":"Received a letter from the caliph,"},{"id":"manas-2010:p0279:b001:l013","ordinal":12586,"en":"Received a blessing from a prince,"},{"id":"manas-2010:p0279:b001:l014","ordinal":12587,"en":"Gave my hand to twelve spiritual guides,"},{"id":"manas-2010:p0279:b001:l015","ordinal":12588,"en":"And was named zayypurush."},{"id":"manas-2010:p0279:b001:l016","ordinal":12589,"en":"When I went beyond Mecca,"},{"id":"manas-2010:p0279:b001:l017","ordinal":12590,"en":"I entered Egypt, poor soul,"},{"id":"manas-2010:p0279:b001:l018","ordinal":12591,"en":"And trembled at its grandeur."},{"id":"manas-2010:p0279:b001:l019","ordinal":12592,"en":"I studied in Egypt five years."},{"id":"manas-2010:p0279:b001:l020","ordinal":12593,"en":"Turning and going back,"},{"id":"manas-2010:p0279:b001:l021","ordinal":12594,"en":"I entered Baghdad, poor soul."},{"id":"manas-2010:p0279:b001:l022","ordinal":12595,"en":"Staying in Baghdad, poor soul,"},{"id":"manas-2010:p0279:b001:l023","ordinal":12596,"en":"Of the Black Chinese and Manchus"},{"id":"manas-2010:p0279:b001:l024","ordinal":12597,"en":"I was terribly afraid."},{"id":"manas-2010:p0279:b001:l025","ordinal":12598,"en":"I studied in Baghdad five years."},{"id":"manas-2010:p0279:b001:l026","ordinal":12599,"en":"When I went beneath the chin,"},{"id":"manas-2010:p0279:b001:l027","ordinal":12600,"en":"I entered Tikken, wretched soul,"},{"id":"manas-2010:p0279:b001:l028","ordinal":12601,"en":"I studied in Tikken five years."},{"id":"manas-2010:p0279:b001:l029","ordinal":12602,"en":"Before the ancient elder"},{"id":"manas-2010:p0279:b001:l030","ordinal":12603,"en":"I stepped in and received a blessing."},{"id":"manas-2010:p0279:b001:l031","ordinal":12604,"en":"At old Baabedin's feast,"},{"id":"manas-2010:p0279:b001:l032","ordinal":12605,"en":"Throwing his forty wrestlers at once,"},{"id":"manas-2010:p0279:b001:l033","ordinal":12606,"en":"I was named Koshoy the Wrestler."},{"id":"manas-2010:p0279:b001:l034","ordinal":12607,"en":"I, a wretched soul visited by Kydyr,"},{"id":"manas-2010:p0279:b001:l035","ordinal":12608,"en":"Knew that you were mighty."},{"id":"manas-2010:p0279:b001:l036","ordinal":12609,"en":"My precious Manas, my champion,"},{"id":"manas-2010:p0279:b001:l037","ordinal":12610,"en":"Wondering when you would appear,"},{"id":"manas-2010:p0279:b001:l038","ordinal":12611,"en":"I kept praying to God."},{"id":"manas-2010:p0279:b001:l039","ordinal":12612,"en":"I went to many places;"},{"id":"manas-2010:p0279:b001:l040","ordinal":12613,"en":"In humiliation I, Koshoy,"},{"id":"manas-2010:p0279:b001:l041","ordinal":12614,"en":"Passed my days in this way!"},{"id":"manas-2010:p0279:b001:l042","ordinal":12615,"en":"Where Ker-Kabylan had not trodden,"},{"id":"manas-2010:p0279:b001:l043","ordinal":12616,"en":"No untouched land remained;"},{"id":"manas-2010:p0279:b001:l044","ordinal":12617,"en":"Whom wretched Koshoy had not struck,"},{"id":"manas-2010:p0279:b001:l045","ordinal":12618,"en":"No people remained intact."},{"id":"manas-2010:p0279:b001:l046","ordinal":12619,"en":"That the pale falcon has not struck,"},{"id":"manas-2010:p0279:b001:l047","ordinal":12620,"en":"Is there an unscathed swan?"},{"id":"manas-2010:p0279:b001:l048","ordinal":12621,"en":"Whom wretched Koshoy has not struck,"},{"id":"manas-2010:p0280:b001:l001","ordinal":12622,"en":"Are there any people left intact?"},{"id":"manas-2010:p0280:b001:l002","ordinal":12623,"en":"Seeking free and open land,"},{"id":"manas-2010:p0280:b001:l003","ordinal":12624,"en":"Seeking a people to stand by me,"},{"id":"manas-2010:p0280:b001:l004","ordinal":12625,"en":"A shirt of sup cloth from Mecca"},{"id":"manas-2010:p0280:b001:l005","ordinal":12626,"en":"I put on next to my skin."},{"id":"manas-2010:p0280:b001:l006","ordinal":12627,"en":"Turning back in a frenzy,"},{"id":"manas-2010:p0280:b001:l007","ordinal":12628,"en":"I encountered the Kyzylbash,"},{"id":"manas-2010:p0280:b001:l008","ordinal":12629,"en":"And picked a fight with them."},{"id":"manas-2010:p0280:b001:l009","ordinal":12630,"en":"I set many an uproar going;"},{"id":"manas-2010:p0280:b001:l010","ordinal":12631,"en":"The khans in their courts"},{"id":"manas-2010:p0280:b001:l011","ordinal":12632,"en":"I slaughtered beyond all bounds."},{"id":"manas-2010:p0280:b001:l012","ordinal":12633,"en":"I took a craftswoman as a gift of booty,"},{"id":"manas-2010:p0280:b001:l013","ordinal":12634,"en":"I took twelve beautiful girls."},{"id":"manas-2010:p0280:b001:l014","ordinal":12635,"en":"Turning back in a frenzy,"},{"id":"manas-2010:p0280:b001:l015","ordinal":12636,"en":"The purest of humankind,"},{"id":"manas-2010:p0280:b001:l016","ordinal":12637,"en":"The foremost of Muslims,"},{"id":"manas-2010:p0280:b001:l017","ordinal":12638,"en":"I grew frenzied with my own prowess."},{"id":"manas-2010:p0280:b001:l018","ordinal":12639,"en":"Who had not beaten me in battle,"},{"id":"manas-2010:p0280:b001:l019","ordinal":12640,"en":"Who dwelt in Chambyl-Bel,"},{"id":"manas-2010:p0280:b001:l020","ordinal":12641,"en":"The two khans Zhanaaly and Karach,"},{"id":"manas-2010:p0280:b001:l021","ordinal":12642,"en":"Themselves Turkmen Muslims,"},{"id":"manas-2010:p0280:b001:l022","ordinal":12643,"en":"Shooting arrows like rain,"},{"id":"manas-2010:p0280:b001:l023","ordinal":12644,"en":"Firing bullets like hail,"},{"id":"manas-2010:p0280:b001:l024","ordinal":12645,"en":"Came out before me again."},{"id":"manas-2010:p0280:b001:l025","ordinal":12646,"en":"I began a fierce onslaught,"},{"id":"manas-2010:p0280:b001:l026","ordinal":12647,"en":"And, grappling with them then,"},{"id":"manas-2010:p0280:b001:l027","ordinal":12648,"en":"I slaughtered their people."},{"id":"manas-2010:p0280:b001:l028","ordinal":12649,"en":"Clouds gathered in the sky;"},{"id":"manas-2010:p0280:b001:l029","ordinal":12650,"en":"Beyond Chambyl-Bel"},{"id":"manas-2010:p0280:b001:l030","ordinal":12651,"en":"I escaped up into a great mountain."},{"id":"manas-2010:p0280:b001:l031","ordinal":12652,"en":"Your aged elder Koshoy"},{"id":"manas-2010:p0280:b001:l032","ordinal":12653,"en":"Has more words to tell:"},{"id":"manas-2010:p0280:b001:l033","ordinal":12654,"en":"I slaughtered people guilty of no crime."},{"id":"manas-2010:p0280:b001:l034","ordinal":12655,"en":"Tomorrow, on the Day of Judgment,"},{"id":"manas-2010:p0280:b001:l035","ordinal":12656,"en":"There is the blood of many people upon me."},{"id":"manas-2010:p0280:b001:l036","ordinal":12657,"en":"I entered many lands,"},{"id":"manas-2010:p0280:b001:l037","ordinal":12658,"en":"For many years, for many days,"},{"id":"manas-2010:p0280:b001:l038","ordinal":12659,"en":"‘Famous, fortunate Manas,"},{"id":"manas-2010:p0280:b001:l039","ordinal":12660,"en":"Like a san of troops when placed in the lead,"},{"id":"manas-2010:p0280:b001:l040","ordinal":12661,"en":"When will the lion hero come?’ I wondered,"},{"id":"manas-2010:p0280:b001:l041","ordinal":12662,"en":"And kept waiting for you!"},{"id":"manas-2010:p0280:b001:l042","ordinal":12663,"en":"Your aged elder Koshoy grieved,"},{"id":"manas-2010:p0280:b001:l043","ordinal":12664,"en":"Bereft of his dear people,"},{"id":"manas-2010:p0280:b001:l044","ordinal":12665,"en":"Hurried along the edges,"},{"id":"manas-2010:p0280:b001:l045","ordinal":12666,"en":"All his finest steeds"},{"id":"manas-2010:p0280:b001:l046","ordinal":12667,"en":"Shoeing anew,"},{"id":"manas-2010:p0280:b001:l047","ordinal":12668,"en":"Looking toward rough ground, seeking ridges,"},{"id":"manas-2010:p0280:b001:l048","ordinal":12669,"en":"Seeking a lion like you, my steed,"},{"id":"manas-2010:p0281:b001:l001","ordinal":12670,"en":"Unable to find a lion, with no choice,"},{"id":"manas-2010:p0281:b001:l002","ordinal":12671,"en":"I made Chech-Töbö my homeland,"},{"id":"manas-2010:p0281:b001:l003","ordinal":12672,"en":"I gathered wanderers and made a people!"},{"id":"manas-2010:p0281:b001:l004","ordinal":12673,"en":"I trained a harrier and made a hunting bird,"},{"id":"manas-2010:p0281:b001:l005","ordinal":12674,"en":"I gathered scattered folk and made a nation!"},{"id":"manas-2010:p0281:b001:l006","ordinal":12675,"en":"I was poor and became rich,"},{"id":"manas-2010:p0281:b001:l007","ordinal":12676,"en":"I was alone and became many!"},{"id":"manas-2010:p0281:b001:l008","ordinal":12677,"en":"A dear land like Zheti-Özön"},{"id":"manas-2010:p0281:b001:l009","ordinal":12678,"en":"I skillfully made my home;"},{"id":"manas-2010:p0281:b001:l010","ordinal":12679,"en":"The Kyrgyz of Zheti-Özön"},{"id":"manas-2010:p0281:b001:l011","ordinal":12680,"en":"I managed to make a people."},{"id":"manas-2010:p0281:b001:l012","ordinal":12681,"en":"I gathered stalwarts, gathered heroes,"},{"id":"manas-2010:p0281:b001:l013","ordinal":12682,"en":"Testing heroes among the people's sons,"},{"id":"manas-2010:p0281:b001:l014","ordinal":12683,"en":"I gathered lions of many kinds."},{"id":"manas-2010:p0281:b001:l015","ordinal":12684,"en":"For you, valiant Manas,"},{"id":"manas-2010:p0281:b001:l016","ordinal":12685,"en":"I did not stand idly watching."},{"id":"manas-2010:p0281:b001:l017","ordinal":12686,"en":"I joined account to account;"},{"id":"manas-2010:p0281:b001:l018","ordinal":12687,"en":"Not lying idle, I, Koshoy,"},{"id":"manas-2010:p0281:b001:l019","ordinal":12688,"en":"Asked those who knew."},{"id":"manas-2010:p0281:b001:l020","ordinal":12689,"en":"I heard news from those who came:"},{"id":"manas-2010:p0281:b001:l021","ordinal":12690,"en":"Manas had been born in Altay;"},{"id":"manas-2010:p0281:b001:l022","ordinal":12691,"en":"When you reached twelve,"},{"id":"manas-2010:p0281:b001:l023","ordinal":12692,"en":"You broke courts and took booty,"},{"id":"manas-2010:p0281:b001:l024","ordinal":12693,"en":"Raised an uproar among the Chinese."},{"id":"manas-2010:p0281:b001:l025","ordinal":12694,"en":"On the slopes of the ridged mountains,"},{"id":"manas-2010:p0281:b001:l026","ordinal":12695,"en":"At the edge of towering Altay,"},{"id":"manas-2010:p0281:b001:l027","ordinal":12696,"en":"Slaughtering the giants of the Chinese,"},{"id":"manas-2010:p0281:b001:l028","ordinal":12697,"en":"You seized their waists and bent them double."},{"id":"manas-2010:p0281:b001:l029","ordinal":12698,"en":"Taking their gold as booty,"},{"id":"manas-2010:p0281:b001:l030","ordinal":12699,"en":"You loaded it on gelded camels."},{"id":"manas-2010:p0281:b001:l031","ordinal":12700,"en":"I heard of that, brave Manas!"},{"id":"manas-2010:p0281:b001:l032","ordinal":12701,"en":"To die when death arrives,"},{"id":"manas-2010:p0281:b001:l033","ordinal":12702,"en":"The command decreed by Allah,"},{"id":"manas-2010:p0281:b001:l034","ordinal":12703,"en":"To face it when it falls upon one's head—"},{"id":"manas-2010:p0281:b001:l035","ordinal":12704,"en":"I too knew of you,"},{"id":"manas-2010:p0281:b001:l036","ordinal":12705,"en":"‘Will he come without delay?’ I thought,"},{"id":"manas-2010:p0281:b001:l037","ordinal":12706,"en":"And waited for that."},{"id":"manas-2010:p0281:b001:l038","ordinal":12707,"en":"‘Let me die when death arrives;"},{"id":"manas-2010:p0281:b001:l039","ordinal":12708,"en":"If there is a way, let me, Koshoy,"},{"id":"manas-2010:p0281:b001:l040","ordinal":12709,"en":"For Jakyp's only son Manas"},{"id":"manas-2010:p0281:b001:l041","ordinal":12710,"en":"Become a protector,’ I thought."},{"id":"manas-2010:p0281:b001:l042","ordinal":12711,"en":"Oh, my dear, that is my wish, my foal!"},{"id":"manas-2010:p0281:b001:l043","ordinal":12712,"en":"From the Black Manchus in Altay,"},{"id":"manas-2010:p0281:b001:l044","ordinal":12713,"en":"From the Black Kalmyks and Torgut,"},{"id":"manas-2010:p0281:b001:l045","ordinal":12714,"en":"From the Sibe and Solon,"},{"id":"manas-2010:p0281:b001:l046","ordinal":12715,"en":"From Kakan-Chin's Beijing,"},{"id":"manas-2010:p0281:b001:l047","ordinal":12716,"en":"Of those Black Chinese people,"},{"id":"manas-2010:p0281:b001:l048","ordinal":12717,"en":"From the place where they swarm and seethe,"},{"id":"manas-2010:p0282:b001:l001","ordinal":12718,"en":"‘I would strike hard in battle,’ I thought,"},{"id":"manas-2010:p0282:b001:l002","ordinal":12719,"en":"‘From Chin-Machin, from Altay,"},{"id":"manas-2010:p0282:b001:l003","ordinal":12720,"en":"From the Kanggay people of Chin-Beijing,"},{"id":"manas-2010:p0282:b001:l004","ordinal":12721,"en":"Having truly trained my steed,"},{"id":"manas-2010:p0282:b001:l005","ordinal":12722,"en":"I would make a journey to Beijing,"},{"id":"manas-2010:p0282:b001:l006","ordinal":12723,"en":"For my kin, for my people,"},{"id":"manas-2010:p0282:b001:l007","ordinal":12724,"en":"I would destroy and bring slaughter,"},{"id":"manas-2010:p0282:b001:l008","ordinal":12725,"en":"Akbaltay, Jakyp, brave Manas—"},{"id":"manas-2010:p0282:b001:l009","ordinal":12726,"en":"I would find their whereabouts,’"},{"id":"manas-2010:p0282:b001:l010","ordinal":12727,"en":"These were the thoughts I kept."},{"id":"manas-2010:p0282:b001:l011","ordinal":12728,"en":"If he truly is a lion,"},{"id":"manas-2010:p0282:b001:l012","ordinal":12729,"en":"My dear leopard Manas,"},{"id":"manas-2010:p0282:b001:l013","ordinal":12730,"en":"To take me as his support,"},{"id":"manas-2010:p0282:b001:l014","ordinal":12731,"en":"Against the Chinese like black spiders"},{"id":"manas-2010:p0282:b001:l015","ordinal":12732,"en":"To strike hard in battle,"},{"id":"manas-2010:p0282:b001:l016","ordinal":12733,"en":"His aged elder Koshoy"},{"id":"manas-2010:p0282:b001:l017","ordinal":12734,"en":"To take as his support,"},{"id":"manas-2010:p0282:b001:l018","ordinal":12735,"en":"Against the Black Chinese and Manchus"},{"id":"manas-2010:p0282:b001:l019","ordinal":12736,"en":"To strike firmly in battle,"},{"id":"manas-2010:p0282:b001:l020","ordinal":12737,"en":"I knew that you would come."},{"id":"manas-2010:p0282:b001:l021","ordinal":12738,"en":"‘If my blood-spiller was born a leopard,"},{"id":"manas-2010:p0282:b001:l022","ordinal":12739,"en":"If these words are true,"},{"id":"manas-2010:p0282:b001:l023","ordinal":12740,"en":"Surely he will come,’ I thought!"},{"id":"manas-2010:p0282:b001:l024","ordinal":12741,"en":"To go searching if you did not come,"},{"id":"manas-2010:p0282:b001:l025","ordinal":12742,"en":"Of the scattered, destitute Kyrgyz"},{"id":"manas-2010:p0282:b001:l026","ordinal":12743,"en":"I gathered the heroes."},{"id":"manas-2010:p0282:b001:l027","ordinal":12744,"en":"I settled along Chech-Töbö,"},{"id":"manas-2010:p0282:b001:l028","ordinal":12745,"en":"I became proud and free."},{"id":"manas-2010:p0282:b001:l029","ordinal":12746,"en":"Horses grew fat and ready,"},{"id":"manas-2010:p0282:b001:l030","ordinal":12747,"en":"Heroes grew restless and pent-up,"},{"id":"manas-2010:p0282:b001:l031","ordinal":12748,"en":"All the heroes packed in thickly,"},{"id":"manas-2010:p0282:b001:l032","ordinal":12749,"en":"All the heroes grew excited."},{"id":"manas-2010:p0282:b001:l033","ordinal":12750,"en":"Those who would not shrink from death,"},{"id":"manas-2010:p0282:b001:l034","ordinal":12751,"en":"The foremost warriors gathered."},{"id":"manas-2010:p0282:b001:l035","ordinal":12752,"en":"Along Chech-Töbö"},{"id":"manas-2010:p0282:b001:l036","ordinal":12753,"en":"We had settled with an uproar;"},{"id":"manas-2010:p0282:b001:l037","ordinal":12754,"en":"On the marsh of Üyürmö"},{"id":"manas-2010:p0282:b001:l038","ordinal":12755,"en":"We held an assembly for three days."},{"id":"manas-2010:p0282:b001:l039","ordinal":12756,"en":"Shouting “Chase! Flee!” and pursuing,"},{"id":"manas-2010:p0282:b001:l040","ordinal":12757,"en":"Seeking one another out and meeting,"},{"id":"manas-2010:p0282:b001:l041","ordinal":12758,"en":"Creeping into the sedge marsh,"},{"id":"manas-2010:p0282:b001:l042","ordinal":12759,"en":"Taking sound counsel together,"},{"id":"manas-2010:p0282:b001:l043","ordinal":12760,"en":"I did not stand idly watching."},{"id":"manas-2010:p0282:b001:l044","ordinal":12761,"en":"Of the wolves of the forty Kyrgyz tribes"},{"id":"manas-2010:p0282:b001:l045","ordinal":12762,"en":"I gathered the mightiest."},{"id":"manas-2010:p0282:b001:l046","ordinal":12763,"en":"‘Against the Kalmyks in Altay"},{"id":"manas-2010:p0282:b001:l047","ordinal":12764,"en":"I would bring great slaughter,"},{"id":"manas-2010:p0282:b001:l048","ordinal":12765,"en":"I would die if death arrived,"},{"id":"manas-2010:p0283:b001:l001","ordinal":12766,"en":"If I could, the forty households"},{"id":"manas-2010:p0283:b001:l002","ordinal":12767,"en":"I would free and bring back,’ I thought."},{"id":"manas-2010:p0283:b001:l003","ordinal":12768,"en":"Choosing the skilled among the Argyn,"},{"id":"manas-2010:p0283:b001:l004","ordinal":12769,"en":"The mighty, cultivators of wisdom,"},{"id":"manas-2010:p0283:b001:l005","ordinal":12770,"en":"Choosing the powerful among the Kyrgyz,"},{"id":"manas-2010:p0283:b001:l006","ordinal":12771,"en":"Who never bowed to the world,"},{"id":"manas-2010:p0283:b001:l007","ordinal":12772,"en":"The broad-chested wrestlers,"},{"id":"manas-2010:p0283:b001:l008","ordinal":12773,"en":"Who did not pause when told “Go!”"},{"id":"manas-2010:p0283:b001:l009","ordinal":12774,"en":"But brought upheaval to the world,"},{"id":"manas-2010:p0283:b001:l010","ordinal":12775,"en":"Who did not know they would die,"},{"id":"manas-2010:p0283:b001:l011","ordinal":12776,"en":"The heedless, swaggering men,"},{"id":"manas-2010:p0283:b001:l012","ordinal":12777,"en":"When a black gun crashed,"},{"id":"manas-2010:p0283:b001:l013","ordinal":12778,"en":"The heroes who would not flee,"},{"id":"manas-2010:p0283:b001:l014","ordinal":12779,"en":"When a fearsome gun cracked,"},{"id":"manas-2010:p0283:b001:l015","ordinal":12780,"en":"The valiant men who did not flinch,"},{"id":"manas-2010:p0283:b001:l016","ordinal":12781,"en":"Shouting “I trust my fate to God!”"},{"id":"manas-2010:p0283:b001:l017","ordinal":12782,"en":"Those who charged the enemy without stopping,"},{"id":"manas-2010:p0283:b001:l018","ordinal":12783,"en":"The heroes who broke the ranks,"},{"id":"manas-2010:p0283:b001:l019","ordinal":12784,"en":"Who stood unafraid of bullets,"},{"id":"manas-2010:p0283:b001:l020","ordinal":12785,"en":"The valiant who would break the ranks,"},{"id":"manas-2010:p0283:b001:l021","ordinal":12786,"en":"The skilled men with courage,"},{"id":"manas-2010:p0283:b001:l022","ordinal":12787,"en":"The mighty men rich in valor,"},{"id":"manas-2010:p0283:b001:l023","ordinal":12788,"en":"The thick-armed wrestlers,"},{"id":"manas-2010:p0283:b001:l024","ordinal":12789,"en":"The leaders of surpassing knowledge,"},{"id":"manas-2010:p0283:b001:l025","ordinal":12790,"en":"The skilled, mighty swordsmen,"},{"id":"manas-2010:p0283:b001:l026","ordinal":12791,"en":"Who attacked without looking back,"},{"id":"manas-2010:p0283:b001:l027","ordinal":12792,"en":"The red-necked mighty men,"},{"id":"manas-2010:p0283:b001:l028","ordinal":12793,"en":"I gathered them all."},{"id":"manas-2010:p0283:b001:l029","ordinal":12794,"en":"My son Manas, for you,"},{"id":"manas-2010:p0283:b001:l030","ordinal":12795,"en":"Your aged elder Koshoy,"},{"id":"manas-2010:p0283:b001:l031","ordinal":12796,"en":"I prepared all of this."},{"id":"manas-2010:p0283:b001:l032","ordinal":12797,"en":"I knew long ago you would come;"},{"id":"manas-2010:p0283:b001:l033","ordinal":12798,"en":"Hoping that I might meet you,"},{"id":"manas-2010:p0283:b001:l034","ordinal":12799,"en":"I kept asking for this."},{"id":"manas-2010:p0283:b001:l035","ordinal":12800,"en":"Is this the moment God has granted?"}]
