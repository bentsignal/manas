[{"id":"semetey-1-2013:p0145:b003:l024","ordinal":87809,"en":"My child, this deed of yours is ill-famed!"},{"id":"semetey-1-2013:p0145:b003:l025","ordinal":87810,"en":"Until his age reaches twelve,"},{"id":"semetey-1-2013:p0145:b003:l026","ordinal":87811,"en":"O Kanykei, my foal,"},{"id":"semetey-1-2013:p0145:b003:l027","ordinal":87812,"en":"My orphan is entrusted to you!"},{"id":"semetey-1-2013:p0145:b003:l028","ordinal":87813,"en":"What I saw was a dark night."},{"id":"semetey-1-2013:p0145:b003:l029","ordinal":87814,"en":"From the orphan left by the gray-maned hero,"},{"id":"semetey-1-2013:p0145:b003:l030","ordinal":87815,"en":"Parted like this in plain sight,"},{"id":"semetey-1-2013:p0145:b003:l031","ordinal":87816,"en":"Was this the day for Bakai to die so?"},{"id":"semetey-1-2013:p0145:b003:l032","ordinal":87817,"en":"What is seen today is gone tomorrow."},{"id":"semetey-1-2013:p0145:b003:l033","ordinal":87818,"en":"Alas, this shitty world has deceived us."},{"id":"semetey-1-2013:p0145:b003:l034","ordinal":87819,"en":"My worthless son Baitaylak,"},{"id":"semetey-1-2013:p0145:b003:l035","ordinal":87820,"en":"Kanykei and Semetey—"},{"id":"semetey-1-2013:p0145:b003:l036","ordinal":87821,"en":"My child, I have no support but you."},{"id":"semetey-1-2013:p0145:b003:l037","ordinal":87822,"en":"I shall know your sacred worth."},{"id":"semetey-1-2013:p0145:b003:l038","ordinal":87823,"en":"Until twelve years have passed,"},{"id":"semetey-1-2013:p0145:b003:l039","ordinal":87824,"en":"My child, I shall go on herding camels."},{"id":"semetey-1-2013:p0145:b005:l001","ordinal":87825,"en":"Among the camels, the black riding camel—"},{"id":"semetey-1-2013:p0145:b005:l002","ordinal":87826,"en":"I shall guard Jelmaiyan."},{"id":"semetey-1-2013:p0145:b005:l003","ordinal":87827,"en":"Who had pledged his hand to the twelve patrons,"},{"id":"semetey-1-2013:p0145:b005:l004","ordinal":87828,"en":"My only one, gone to the other world—"},{"id":"semetey-1-2013:p0145:b005:l005","ordinal":87829,"en":"I shall repay Manas's salt."},{"id":"semetey-1-2013:p0145:b005:l006","ordinal":87830,"en":"Who brought slaughter upon so many,"},{"id":"semetey-1-2013:p0145:b005:l007","ordinal":87831,"en":"My twin Manas, remain alive!"},{"id":"semetey-1-2013:p0145:b005:l008","ordinal":87832,"en":"Father of the people, King Bakai,"},{"id":"semetey-1-2013:p0145:b005:l009","ordinal":87833,"en":"To the orphan who fled in distress,"},{"id":"semetey-1-2013:p0145:b005:l010","ordinal":87834,"en":"May you never come bringing provisions now!"},{"id":"semetey-1-2013:p0145:b005:l011","ordinal":87835,"en":"When the broad world was narrow,"},{"id":"semetey-1-2013:p0145:b005:l012","ordinal":87836,"en":"When my gray-maned Manas was alive,"},{"id":"semetey-1-2013:p0145:b005:l013","ordinal":87837,"en":"Breaking Ombu and taking booty,"},{"id":"semetey-1-2013:p0145:b005:l014","ordinal":87838,"en":"Breaking through its midst and opening a road,"},{"id":"semetey-1-2013:p0145:b005:l015","ordinal":87839,"en":"All this world—"},{"id":"semetey-1-2013:p0145:b005:l016","ordinal":87840,"en":"When I was trampling across it,"},{"id":"semetey-1-2013:p0145:b005:l017","ordinal":87841,"en":"The whole face of the earth—"},{"id":"semetey-1-2013:p0145:b005:l018","ordinal":87842,"en":"When I held it in my power,"},{"id":"semetey-1-2013:p0145:b005:l019","ordinal":87843,"en":"Why did I not die then?"},{"id":"semetey-1-2013:p0145:b005:l020","ordinal":87844,"en":"Making a road through contested places,"},{"id":"semetey-1-2013:p0145:b005:l021","ordinal":87845,"en":"Humiliating many peoples,"},{"id":"semetey-1-2013:p0145:b005:l022","ordinal":87846,"en":"Going to raid Kokand,"},{"id":"semetey-1-2013:p0145:b005:l023","ordinal":87847,"en":"Raiding and taking elephants as booty,"},{"id":"semetey-1-2013:p0145:b005:l024","ordinal":87848,"en":"Taking a thousand dark-eyed captives,"},{"id":"semetey-1-2013:p0145:b005:l025","ordinal":87849,"en":"The marten-fur hat upon my brow—"},{"id":"semetey-1-2013:p0145:b005:l026","ordinal":87850,"en":"When I was making it sway,"},{"id":"semetey-1-2013:p0145:b005:l027","ordinal":87851,"en":"Ruling as khan over boundless lands,"},{"id":"semetey-1-2013:p0145:b005:l028","ordinal":87852,"en":"When I was living in delight,"},{"id":"semetey-1-2013:p0145:b005:l029","ordinal":87853,"en":"When my gray-maned Manas was alive,"},{"id":"semetey-1-2013:p0145:b005:l030","ordinal":87854,"en":"Why did I not die then?"},{"id":"semetey-1-2013:p0145:b005:l031","ordinal":87855,"en":"The looming city of Great Beijing—"},{"id":"semetey-1-2013:p0145:b005:l032","ordinal":87856,"en":"When I was trampling through it,"},{"id":"semetey-1-2013:p0145:b005:l033","ordinal":87857,"en":"Chai-Too, where gold was mined—"},{"id":"semetey-1-2013:p0145:b005:l034","ordinal":87858,"en":"When I held it in my power,"},{"id":"semetey-1-2013:p0145:b005:l035","ordinal":87859,"en":"The black-buttoned kaldai—"},{"id":"semetey-1-2013:p0145:b005:l036","ordinal":87860,"en":"When I had him in my grasp,"},{"id":"semetey-1-2013:p0145:b005:l037","ordinal":87861,"en":"The kaldai and his Manchus—"},{"id":"semetey-1-2013:p0145:b005:l038","ordinal":87862,"en":"When I was beating them,"},{"id":"semetey-1-2013:p0145:b005:l039","ordinal":87863,"en":"When the leopard Manas was alive,"},{"id":"semetey-1-2013:p0146:b003:l001","ordinal":87864,"en":"Why did I not die then?"},{"id":"semetey-1-2013:p0146:b003:l002","ordinal":87865,"en":"Built walls and royal palaces—"},{"id":"semetey-1-2013:p0146:b003:l003","ordinal":87866,"en":"When I was taking them,"},{"id":"semetey-1-2013:p0146:b003:l004","ordinal":87867,"en":"Those who talked back,"},{"id":"semetey-1-2013:p0146:b003:l005","ordinal":87868,"en":"Like ordinary sheep,"},{"id":"semetey-1-2013:p0146:b003:l006","ordinal":87869,"en":"When I was splitting them open,"},{"id":"semetey-1-2013:p0146:b003:l007","ordinal":87870,"en":"When Bakai ruled as khan,"},{"id":"semetey-1-2013:p0146:b003:l008","ordinal":87871,"en":"Beijing with its khakan—"},{"id":"semetey-1-2013:p0146:b003:l009","ordinal":87872,"en":"When I was making it bow,"},{"id":"semetey-1-2013:p0146:b003:l010","ordinal":87873,"en":"The gold of taxes and tribute—"},{"id":"semetey-1-2013:p0146:b003:l011","ordinal":87874,"en":"When I was levying it,"},{"id":"semetey-1-2013:p0146:b003:l012","ordinal":87875,"en":"The dark city of Great Beijing—"},{"id":"semetey-1-2013:p0146:b003:l013","ordinal":87876,"en":"When I held it in my grasp,"},{"id":"semetey-1-2013:p0146:b003:l014","ordinal":87877,"en":"Its lungtungs, its lesser khans—"},{"id":"semetey-1-2013:p0146:b003:l015","ordinal":87878,"en":"When I was beating them,"},{"id":"semetey-1-2013:p0146:b003:l016","ordinal":87879,"en":"Why did I not die then?"},{"id":"semetey-1-2013:p0146:b003:l017","ordinal":87880,"en":"My gray-maned Manas, remain alive;"},{"id":"semetey-1-2013:p0146:b003:l018","ordinal":87881,"en":"Bakai, may you never see humiliation!"},{"id":"semetey-1-2013:p0146:b003:l019","ordinal":87882,"en":"Lady of a noble lord,"},{"id":"semetey-1-2013:p0146:b003:l020","ordinal":87883,"en":"Were you meant to flee in terror?"},{"id":"semetey-1-2013:p0146:b003:l021","ordinal":87884,"en":"Unable to find you in the known place,"},{"id":"semetey-1-2013:p0146:b003:l022","ordinal":87885,"en":"O Kanykei, my foal,"},{"id":"semetey-1-2013:p0146:b003:l023","ordinal":87886,"en":"Was I meant to tear out my beard?"},{"id":"semetey-1-2013:p0146:b003:l024","ordinal":87887,"en":"O Kanykei, my foal!”"},{"id":"semetey-1-2013:p0146:b003:l025","ordinal":87888,"en":"The noble lord's child"},{"id":"semetey-1-2013:p0146:b003:l026","ordinal":87889,"en":"Had fled in terror."},{"id":"semetey-1-2013:p0146:b003:l027","ordinal":87890,"en":"Your valiant uncle Bakai"},{"id":"semetey-1-2013:p0146:b003:l028","ordinal":87891,"en":"Had fallen into grievous torment."},{"id":"semetey-1-2013:p0146:b003:l029","ordinal":87892,"en":"That brown two-year-old wether taken for provisions,"},{"id":"semetey-1-2013:p0146:b003:l030","ordinal":87893,"en":"His mother Chyiyrdy,"},{"id":"semetey-1-2013:p0146:b003:l031","ordinal":87894,"en":"His daughter-in-law Kanykei—"},{"id":"semetey-1-2013:p0146:b003:l032","ordinal":87895,"en":"After he had brought it as a gift,"},{"id":"semetey-1-2013:p0146:b003:l033","ordinal":87896,"en":"After they had climbed onto the ridge,"},{"id":"semetey-1-2013:p0146:b003:l034","ordinal":87897,"en":"That gray-maned uncle's"},{"id":"semetey-1-2013:p0146:b003:l035","ordinal":87898,"en":"Wether given as a gift—"},{"id":"semetey-1-2013:p0146:b003:l036","ordinal":87899,"en":"Until death, the heart would not forget"},{"id":"semetey-1-2013:p0146:b003:l037","ordinal":87900,"en":"The deeds of the six villains in Talas!"},{"id":"semetey-1-2013:p0146:b003:l038","ordinal":87901,"en":"Our old uncle Bakai,"},{"id":"semetey-1-2013:p0146:b003:l039","ordinal":87902,"en":"The saint upheld by the holy patron,"},{"id":"semetey-1-2013:p0146:b004:l001","ordinal":87903,"en":"Kindled their extinguished fire,"},{"id":"semetey-1-2013:p0146:b004:l002","ordinal":87904,"en":"Revived their deadened lives,"},{"id":"semetey-1-2013:p0146:b004:l003","ordinal":87905,"en":"Gathered what had scattered,"},{"id":"semetey-1-2013:p0146:b004:l004","ordinal":87906,"en":"Gladdened their lives, like wooden tubs."},{"id":"semetey-1-2013:p0146:b004:l005","ordinal":87907,"en":"Their scorched hearts recovered."},{"id":"semetey-1-2013:p0146:b004:l006","ordinal":87908,"en":"When they saw King Bakai,"},{"id":"semetey-1-2013:p0146:b004:l007","ordinal":87909,"en":"It was as though they saw their khan Manas;"},{"id":"semetey-1-2013:p0146:b004:l008","ordinal":87910,"en":"All their sorrow vanished."},{"id":"semetey-1-2013:p0146:b004:l010","ordinal":87911,"en":"When she saw the hero Bakai,"},{"id":"semetey-1-2013:p0146:b004:l011","ordinal":87912,"en":"Your fierce mother's"},{"id":"semetey-1-2013:p0146:b004:l012","ordinal":87913,"en":"Aching places grew quiet."},{"id":"semetey-1-2013:p0146:b004:l013","ordinal":87914,"en":"Then the woman Kanykei's"},{"id":"semetey-1-2013:p0146:b004:l014","ordinal":87915,"en":"Eyes, small as dough pellets, opened."},{"id":"semetey-1-2013:p0146:b004:l015","ordinal":87916,"en":"Into those widows' hands"},{"id":"semetey-1-2013:p0146:b004:l016","ordinal":87917,"en":"Your peerless uncle Bakai,"},{"id":"semetey-1-2013:p0146:b004:l017","ordinal":87918,"en":"For provisions to drink,"},{"id":"semetey-1-2013:p0146:b004:l018","ordinal":87919,"en":"Gave six skins of milk."},{"id":"semetey-1-2013:p0146:b004:l019","ordinal":87920,"en":"To ride away into the distance,"},{"id":"semetey-1-2013:p0146:b004:l020","ordinal":87921,"en":"He gave two well-fed horses."},{"id":"semetey-1-2013:p0146:b004:l021","ordinal":87922,"en":"Then, kindling their extinguished fire,"},{"id":"semetey-1-2013:p0146:b004:l022","ordinal":87923,"en":"Your tiger, old Bakai,"},{"id":"semetey-1-2013:p0146:b004:l023","ordinal":87924,"en":"Revived their deadened lives."},{"id":"semetey-1-2013:p0146:b004:l024","ordinal":87925,"en":"Chyiyrdy was on his right."},{"id":"semetey-1-2013:p0146:b004:l025","ordinal":87926,"en":"The saint, old Bakai,"},{"id":"semetey-1-2013:p0146:b004:l026","ordinal":87927,"en":"Thinking and weeping, could not remain still."},{"id":"semetey-1-2013:p0146:b004:l027","ordinal":87928,"en":"Kanykei was on his left."},{"id":"semetey-1-2013:p0146:b004:l028","ordinal":87929,"en":"Upon his looming dark head,"},{"id":"semetey-1-2013:p0146:b004:l029","ordinal":87930,"en":"His bloody face was torn."},{"id":"semetey-1-2013:p0146:b004:l030","ordinal":87931,"en":"Unable to muster firm courage,"},{"id":"semetey-1-2013:p0146:b004:l031","ordinal":87932,"en":"Your uncle, the leopard Bakai's"},{"id":"semetey-1-2013:p0146:b004:l032","ordinal":87933,"en":"Heart burned with sorrow."},{"id":"semetey-1-2013:p0146:b004:l033","ordinal":87934,"en":"Unable to stand for grief,"},{"id":"semetey-1-2013:p0146:b004:l034","ordinal":87935,"en":"“May you always remain safe,”"},{"id":"semetey-1-2013:p0146:b004:l035","ordinal":87936,"en":"Said King Bakai then,"},{"id":"semetey-1-2013:p0146:b004:l036","ordinal":87937,"en":"Giving his hand to his mother Chyiyrdy."},{"id":"semetey-1-2013:p0146:b004:l037","ordinal":87938,"en":"“Wear it on your way to Bukhara,” he said,"},{"id":"semetey-1-2013:p0146:b004:l038","ordinal":87939,"en":"And to his child Kanykei"},{"id":"semetey-1-2013:p0146:b004:l039","ordinal":87940,"en":"Gave a coat that would keep out the cold."},{"id":"semetey-1-2013:p0147:b003:l001","ordinal":87941,"en":"Sobbing, weeping, embracing them,"},{"id":"semetey-1-2013:p0147:b003:l002","ordinal":87942,"en":"Semetey, left by the noble steed,"},{"id":"semetey-1-2013:p0147:b003:l003","ordinal":87943,"en":"He entrusted to the two ladies."},{"id":"semetey-1-2013:p0147:b003:l004","ordinal":87944,"en":"“O Kanykei, my foal,"},{"id":"semetey-1-2013:p0147:b003:l005","ordinal":87945,"en":"You will reach Temir Khan and settle;"},{"id":"semetey-1-2013:p0147:b003:l006","ordinal":87946,"en":"You will make your home beside your father."},{"id":"semetey-1-2013:p0147:b003:l007","ordinal":87947,"en":"Braid the hair upon your back."},{"id":"semetey-1-2013:p0147:b003:l008","ordinal":87948,"en":"The little one you cradle before you,"},{"id":"semetey-1-2013:p0147:b003:l009","ordinal":87949,"en":"Give him to your brother Ismail."},{"id":"semetey-1-2013:p0147:b003:l010","ordinal":87950,"en":"Kanykei, my child, keep yourself apart;"},{"id":"semetey-1-2013:p0147:b003:l012","ordinal":87951,"en":"Turn your thoughts another way."},{"id":"semetey-1-2013:p0147:b003:l013","ordinal":87952,"en":"Until your child grows and mounts a horse,"},{"id":"semetey-1-2013:p0147:b003:l014","ordinal":87953,"en":"Do not dress him in your arrow-proof coat."},{"id":"semetey-1-2013:p0147:b003:l015","ordinal":87954,"en":"That Manas, gone to the other world,"},{"id":"semetey-1-2013:p0147:b003:l016","ordinal":87955,"en":"Is his father, my foal, do not let him know."},{"id":"semetey-1-2013:p0147:b003:l017","ordinal":87956,"en":"When his age reaches twelve,"},{"id":"semetey-1-2013:p0147:b003:l018","ordinal":87957,"en":"Send him to the Kyrgyz, to Talas."},{"id":"semetey-1-2013:p0147:b003:l019","ordinal":87958,"en":"Have the Quran recited, Kanykei,"},{"id":"semetey-1-2013:p0147:b003:l020","ordinal":87959,"en":"For my companion, Sultan Manas."},{"id":"semetey-1-2013:p0147:b003:l021","ordinal":87960,"en":"When his age reaches twelve,"},{"id":"semetey-1-2013:p0147:b003:l022","ordinal":87961,"en":"I shall scout the heights of the cliffs."},{"id":"semetey-1-2013:p0147:b003:l023","ordinal":87962,"en":"If Bakai does not die of suffering,"},{"id":"semetey-1-2013:p0147:b003:l024","ordinal":87963,"en":"If he does not see the Last Judgment,"},{"id":"semetey-1-2013:p0147:b003:l025","ordinal":87964,"en":"The gift left by the mighty warrior"},{"id":"semetey-1-2013:p0147:b003:l026","ordinal":87965,"en":"I shall take as my companion."},{"id":"semetey-1-2013:p0147:b003:l027","ordinal":87966,"en":"Teaching him the things he does not know,"},{"id":"semetey-1-2013:p0147:b003:l028","ordinal":87967,"en":"I, knowledgeable old Bakai,"},{"id":"semetey-1-2013:p0147:b003:l029","ordinal":87968,"en":"Shall make him understand what he has not grasped."},{"id":"semetey-1-2013:p0147:b003:l030","ordinal":87969,"en":"I, falcon-like old Bakai,"},{"id":"semetey-1-2013:p0147:b003:l031","ordinal":87970,"en":"Shall lead him with me and make him a hero,"},{"id":"semetey-1-2013:p0147:b003:l032","ordinal":87971,"en":"Make him equal to the sons of warriors,"},{"id":"semetey-1-2013:p0147:b003:l033","ordinal":87972,"en":"To the leopard, gray-maned Manas,"},{"id":"semetey-1-2013:p0147:b003:l034","ordinal":87973,"en":"I shall make him equal in every way."},{"id":"semetey-1-2013:p0147:b003:l035","ordinal":87974,"en":"I shall help gird his waist firmly;"},{"id":"semetey-1-2013:p0147:b003:l036","ordinal":87975,"en":"From the Kara-Khitai in Beijing"},{"id":"semetey-1-2013:p0147:b003:l037","ordinal":87976,"en":"I shall seek the blood-price of the valiant one."},{"id":"semetey-1-2013:p0147:b003:l038","ordinal":87977,"en":"If my orphan comes safely,"},{"id":"semetey-1-2013:p0147:b003:l039","ordinal":87978,"en":"I shall set the grassy land afire,"},{"id":"semetey-1-2013:p0147:b005:l001","ordinal":87979,"en":"I shall pour blood into the running water,"},{"id":"semetey-1-2013:p0147:b005:l002","ordinal":87980,"en":"Make the people accept his words."},{"id":"semetey-1-2013:p0147:b005:l003","ordinal":87981,"en":"If my orphan survives,"},{"id":"semetey-1-2013:p0147:b005:l004","ordinal":87982,"en":"I shall make him a mighty fortress for the people."},{"id":"semetey-1-2013:p0147:b005:l005","ordinal":87983,"en":"The poor orphan child,"},{"id":"semetey-1-2013:p0147:b005:l006","ordinal":87984,"en":"If God lets him see Talas,"},{"id":"semetey-1-2013:p0147:b005:l007","ordinal":87985,"en":"I shall place my golden crown upon him."},{"id":"semetey-1-2013:p0147:b005:l008","ordinal":87986,"en":"If the orphan survives,"},{"id":"semetey-1-2013:p0147:b005:l009","ordinal":87987,"en":"I shall seat him on a golden throne."},{"id":"semetey-1-2013:p0147:b005:l010","ordinal":87988,"en":"If his orphan comes safely,"},{"id":"semetey-1-2013:p0147:b005:l011","ordinal":87989,"en":"Bakai will have seen his day."},{"id":"semetey-1-2013:p0147:b005:l012","ordinal":87990,"en":"If the orphan does not come safely,"},{"id":"semetey-1-2013:p0147:b005:l013","ordinal":87991,"en":"King Bakai will be dead!"},{"id":"semetey-1-2013:p0147:b005:l014","ordinal":87992,"en":"If Semetey comes safely,"},{"id":"semetey-1-2013:p0147:b005:l015","ordinal":87993,"en":"Bakai will remain in joy."},{"id":"semetey-1-2013:p0147:b005:l016","ordinal":87994,"en":"If Kanykei is delayed,"},{"id":"semetey-1-2013:p0147:b005:l017","ordinal":87995,"en":"God will have struck Bakai down!"},{"id":"semetey-1-2013:p0147:b005:l018","ordinal":87996,"en":"Until you return safely,"},{"id":"semetey-1-2013:p0147:b005:l019","ordinal":87997,"en":"Until you see the old man,"},{"id":"semetey-1-2013:p0147:b005:l020","ordinal":87998,"en":"I, the noble leopard Bakai,"},{"id":"semetey-1-2013:p0147:b005:l021","ordinal":87999,"en":"Shall fare by herding camels,"},{"id":"semetey-1-2013:p0147:b005:l022","ordinal":88000,"en":"A goatskin coat upon my body,"},{"id":"semetey-1-2013:p0147:b005:l023","ordinal":88001,"en":"Leather trousers upon my backside;"},{"id":"semetey-1-2013:p0147:b005:l024","ordinal":88002,"en":"I shall bear a lowly name!”"},{"id":"semetey-1-2013:p0147:b005:l025","ordinal":88003,"en":"Mighty Bakai wept in sorrow."},{"id":"semetey-1-2013:p0147:b005:l026","ordinal":88004,"en":"It was God's decree;"},{"id":"semetey-1-2013:p0147:b005:l027","ordinal":88005,"en":"He submitted to that word now."},{"id":"semetey-1-2013:p0147:b005:l028","ordinal":88006,"en":"When the leopard Manas had died,"},{"id":"semetey-1-2013:p0147:b005:l029","ordinal":88007,"en":"When his wretched life had known sorrow,"},{"id":"semetey-1-2013:p0147:b005:l030","ordinal":88008,"en":"It had been a famed swift horse,"},{"id":"semetey-1-2013:p0147:b005:l031","ordinal":88009,"en":"Which Koshoi, khan of the Katagan,"},{"id":"semetey-1-2013:p0147:b005:l032","ordinal":88010,"en":"Had given in mourning."},{"id":"semetey-1-2013:p0147:b005:l033","ordinal":88011,"en":"“My orphan and my widow,"},{"id":"semetey-1-2013:p0147:b005:l034","ordinal":88012,"en":"If they journey far away,"},{"id":"semetey-1-2013:p0147:b005:l035","ordinal":88013,"en":"Let them ride it openly,”"},{"id":"semetey-1-2013:p0147:b005:l036","ordinal":88014,"en":"Such had been my wish."},{"id":"semetey-1-2013:p0147:b005:l037","ordinal":88015,"en":"“God has granted my wish,” said"},{"id":"semetey-1-2013:p0147:b005:l038","ordinal":88016,"en":"The aged, old Bakai."},{"id":"semetey-1-2013:p0147:b005:l039","ordinal":88017,"en":"(However far he had journeyed,"},{"id":"semetey-1-2013:p0148:b003:l001","ordinal":88018,"en":"He was a resourceful saint.)"},{"id":"semetey-1-2013:p0148:b003:l002","ordinal":88019,"en":"Of the noble steed Taitoru,"},{"id":"semetey-1-2013:p0148:b003:l003","ordinal":88020,"en":"He tightened the rear belly-girth firmly."},{"id":"semetey-1-2013:p0148:b003:l004","ordinal":88021,"en":"Of the spirit-like steed,"},{"id":"semetey-1-2013:p0148:b003:l005","ordinal":88022,"en":"He lengthened the crupper."},{"id":"semetey-1-2013:p0148:b003:l006","ordinal":88023,"en":"King Bakai, the noble lion,"},{"id":"semetey-1-2013:p0148:b003:l007","ordinal":88024,"en":"Fastened the saddle-girth,"},{"id":"semetey-1-2013:p0148:b003:l008","ordinal":88025,"en":"And all the equipment he possessed"},{"id":"semetey-1-2013:p0148:b003:l009","ordinal":88026,"en":"He had fitted upon Taitoru."},{"id":"semetey-1-2013:p0148:b003:l010","ordinal":88027,"en":"With an easy ambling gait, gentle to ride,"},{"id":"semetey-1-2013:p0148:b003:l011","ordinal":88028,"en":"Akborchuk was good for the road."},{"id":"semetey-1-2013:p0148:b003:l012","ordinal":88029,"en":"Grieving and weeping bitterly,"},{"id":"semetey-1-2013:p0148:b003:l013","ordinal":88030,"en":"In her old age,"},{"id":"semetey-1-2013:p0148:b003:l014","ordinal":88031,"en":"He set it aside for his mother Chyiyrdy."},{"id":"semetey-1-2013:p0148:b003:l015","ordinal":88032,"en":"“If she rides Akborchuk on her journey,"},{"id":"semetey-1-2013:p0148:b003:l016","ordinal":88033,"en":"May she attain her wish,” he thought."},{"id":"semetey-1-2013:p0148:b003:l017","ordinal":88034,"en":"“The orphan left by the gray-maned hero,"},{"id":"semetey-1-2013:p0148:b003:l018","ordinal":88035,"en":"May Chyiyrdy, safe and sound,"},{"id":"semetey-1-2013:p0148:b003:l019","ordinal":88036,"en":"Carry him away in flight,” he thought."},{"id":"semetey-1-2013:p0148:b003:l020","ordinal":88037,"en":"Old Bakai the lion,"},{"id":"semetey-1-2013:p0148:b003:l021","ordinal":88038,"en":"The saint who had seen so much,"},{"id":"semetey-1-2013:p0148:b003:l022","ordinal":88039,"en":"When he went in search of provisions,"},{"id":"semetey-1-2013:p0148:b003:l023","ordinal":88040,"en":"Merciless trouble—"},{"id":"semetey-1-2013:p0148:b003:l024","ordinal":88041,"en":"Had he not brought it?"},{"id":"semetey-1-2013:p0148:b003:l025","ordinal":88042,"en":"Akborchuk, expressly"},{"id":"semetey-1-2013:p0148:b003:l026","ordinal":88043,"en":"For his poor mother to ride,"},{"id":"semetey-1-2013:p0148:b003:l027","ordinal":88044,"en":"Had he not brought it?"},{"id":"semetey-1-2013:p0148:b003:l028","ordinal":88045,"en":"Akborchuk, whom his mother would ride,"},{"id":"semetey-1-2013:p0148:b003:l029","ordinal":88046,"en":"Had its girth fastened."},{"id":"semetey-1-2013:p0148:b003:l030","ordinal":88047,"en":"Beneath its bridle"},{"id":"semetey-1-2013:p0148:b003:l031","ordinal":88048,"en":"Was a white halter tied in the okoro knot,"},{"id":"semetey-1-2013:p0148:b003:l032","ordinal":88049,"en":"Suitable for a journey,"},{"id":"semetey-1-2013:p0148:b003:l033","ordinal":88050,"en":"A halter that fitted Akborchuk."},{"id":"semetey-1-2013:p0148:b003:l034","ordinal":88051,"en":"The valiant old Bakai,"},{"id":"semetey-1-2013:p0148:b003:l035","ordinal":88052,"en":"Showing his gray-maned valor,"},{"id":"semetey-1-2013:p0148:b003:l036","ordinal":88053,"en":"Speaking words of farewell,"},{"id":"semetey-1-2013:p0148:b003:l037","ordinal":88054,"en":"His heart burning fiercely,"},{"id":"semetey-1-2013:p0148:b003:l038","ordinal":88055,"en":"Acting as a father to them both,"},{"id":"semetey-1-2013:p0148:b003:l039","ordinal":88056,"en":"Had brought two winged steeds."},{"id":"semetey-1-2013:p0148:b004:l001","ordinal":88057,"en":"From his mother Chyiyrdy"},{"id":"semetey-1-2013:p0148:b004:l002","ordinal":88058,"en":"Bakai now received a blessing."},{"id":"semetey-1-2013:p0148:b004:l003","ordinal":88059,"en":"The wretched fugitive's"},{"id":"semetey-1-2013:p0148:b004:l004","ordinal":88060,"en":"Widowhood he had seen."},{"id":"semetey-1-2013:p0148:b004:l005","ordinal":88061,"en":"Taitoru and Akborchuk"},{"id":"semetey-1-2013:p0148:b004:l006","ordinal":88062,"en":"To the two fleeing ladies"},{"id":"semetey-1-2013:p0148:b004:l007","ordinal":88063,"en":"He gave as gifts."},{"id":"semetey-1-2013:p0148:b004:l008","ordinal":88064,"en":"That hero of yours, Bakai,"}]
