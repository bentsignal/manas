[{"id":"seytek-2012:p0516:b002:l030","ordinal":334081,"en":"Leaving not one of you,"},{"id":"seytek-2012:p0516:b002:l031","ordinal":334082,"en":"But putting you all to the sword."},{"id":"seytek-2012:p0516:b002:l032","ordinal":334083,"en":"Let me hear of your courage!"},{"id":"seytek-2012:p0516:b002:l033","ordinal":334084,"en":"Though we fight for months and years,"},{"id":"seytek-2012:p0516:b002:l034","ordinal":334085,"en":"I shall kill and bury you in the earth!"},{"id":"seytek-2012:p0516:b002:l035","ordinal":334086,"en":"I shall trample your encampment"},{"id":"seytek-2012:p0516:b002:l036","ordinal":334087,"en":"And sweep away your champions."},{"id":"seytek-2012:p0516:b002:l037","ordinal":334088,"en":"Without sparing my dark life,"},{"id":"seytek-2012:p0516:b002:l038","ordinal":334089,"en":"I shall pour out my fiercest wrath."},{"id":"seytek-2012:p0516:b002:l039","ordinal":334090,"en":"You infidel, son of the monster,"},{"id":"seytek-2012:p0516:b002:l040","ordinal":334091,"en":"I shall tear apart your ribs!”"},{"id":"seytek-2012:p0516:b003:l001","ordinal":334092,"en":"Toward the lone marauder of deadly venom,"},{"id":"seytek-2012:p0516:b003:l002","ordinal":334093,"en":"Toward the giant Sarybai,"},{"id":"seytek-2012:p0516:b003:l003","ordinal":334094,"en":"Toward death itself,"},{"id":"seytek-2012:p0516:b003:l004","ordinal":334095,"en":"Toward the true devourer’s eye,"},{"id":"seytek-2012:p0516:b003:l005","ordinal":334096,"en":"He pressed on to test himself."},{"id":"seytek-2012:p0516:b003:l006","ordinal":334097,"en":"Along the stony ridge,"},{"id":"seytek-2012:p0516:b003:l007","ordinal":334098,"en":"The tireless lone wolf arrived"},{"id":"seytek-2012:p0516:b003:l008","ordinal":334099,"en":"At the place where they would crush each other."},{"id":"seytek-2012:p0516:b003:l009","ordinal":334100,"en":"At the white ravine of the reedy slope,"},{"id":"seytek-2012:p0516:b003:l010","ordinal":334101,"en":"They faced each other on the battlefield."},{"id":"seytek-2012:p0516:b003:l011","ordinal":334102,"en":"Cutting a road through the army,"},{"id":"seytek-2012:p0516:b003:l012","ordinal":334103,"en":"Külchoro, upheld by the spirits,"},{"id":"seytek-2012:p0516:b003:l013","ordinal":334104,"en":"Assailed Sarybai."},{"id":"seytek-2012:p0516:b003:l014","ordinal":334105,"en":"From this nearer side,"},{"id":"seytek-2012:p0516:b003:l015","ordinal":334106,"en":"At the champions’ outer edge,"},{"id":"seytek-2012:p0516:b003:l016","ordinal":334107,"en":"He tightened his well-fitted belt"},{"id":"seytek-2012:p0516:b003:l017","ordinal":334108,"en":"And charged straight in."},{"id":"seytek-2012:p0516:b003:l018","ordinal":334109,"en":"Spearing all he encountered,"},{"id":"seytek-2012:p0516:b003:l019","ordinal":334110,"en":"He sought everywhere"},{"id":"seytek-2012:p0516:b003:l020","ordinal":334111,"en":"For Sarybai, the monster’s son."},{"id":"seytek-2012:p0516:b003:l021","ordinal":334112,"en":"Such was his lion-hearted valor:"},{"id":"seytek-2012:p0516:b003:l022","ordinal":334113,"en":"Those within reach of his spear"},{"id":"seytek-2012:p0516:b003:l023","ordinal":334114,"en":"He struck down with his spear;"},{"id":"seytek-2012:p0516:b003:l024","ordinal":334115,"en":"Those within reach of his battle-axe"},{"id":"seytek-2012:p0516:b003:l025","ordinal":334116,"en":"He hacked and felled;"},{"id":"seytek-2012:p0516:b003:l026","ordinal":334117,"en":"Those who pressed hard upon his sword"},{"id":"seytek-2012:p0516:b003:l027","ordinal":334118,"en":"He hewed down;"},{"id":"seytek-2012:p0516:b003:l028","ordinal":334119,"en":"Those who came before him"},{"id":"seytek-2012:p0516:b003:l029","ordinal":334120,"en":"He laid waste and struck aside."},{"id":"seytek-2012:p0516:b003:l030","ordinal":334121,"en":"The sky was clear, but the earth grew dark;"},{"id":"seytek-2012:p0516:b003:l031","ordinal":334122,"en":"The ground churned as night descended."},{"id":"seytek-2012:p0516:b003:l032","ordinal":334123,"en":"The armies on either side"},{"id":"seytek-2012:p0516:b003:l033","ordinal":334124,"en":"Mingled together."},{"id":"seytek-2012:p0516:b003:l034","ordinal":334125,"en":"They fought amid battle cries—"},{"id":"seytek-2012:p0516:b003:l035","ordinal":334126,"en":"Who had ever seen such a struggle?"},{"id":"seytek-2012:p0516:b003:l036","ordinal":334127,"en":"The fainthearted withdrew,"},{"id":"seytek-2012:p0516:b003:l037","ordinal":334128,"en":"While every champion confronted the foe."},{"id":"seytek-2012:p0516:b003:l038","ordinal":334129,"en":"Spears shattered and straps fell,"},{"id":"seytek-2012:p0516:b003:l039","ordinal":334130,"en":"Horses fell as though mountains collapsed;"},{"id":"seytek-2012:p0516:b003:l040","ordinal":334131,"en":"A merciless battle raged."},{"id":"seytek-2012:p0517:b002:l001","ordinal":334132,"en":"Pouring out his wrath, he bristled,"},{"id":"seytek-2012:p0517:b002:l002","ordinal":334133,"en":"I have long awaited our clash."},{"id":"seytek-2012:p0517:b002:l003","ordinal":334134,"en":"Now that my mortal enemy,"},{"id":"seytek-2012:p0517:b002:l004","ordinal":334135,"en":"Who would tear out lungs and seize gall, has come,"},{"id":"seytek-2012:p0517:b002:l005","ordinal":334136,"en":"How could I spare my life!"},{"id":"seytek-2012:p0517:b002:l006","ordinal":334137,"en":"Ever since I became Külchoro,"},{"id":"seytek-2012:p0517:b002:l007","ordinal":334138,"en":"I have subdued the whole world,"},{"id":"seytek-2012:p0517:b002:l008","ordinal":334139,"en":"Driving, slaughtering, and despoiling it."},{"id":"seytek-2012:p0517:b002:l009","ordinal":334140,"en":"I donned armor no bullet could pierce,"},{"id":"seytek-2012:p0517:b002:l010","ordinal":334141,"en":"I slaughtered a thousand men like you;"},{"id":"seytek-2012:p0517:b002:l011","ordinal":334142,"en":"Where, then, is my death?!"},{"id":"seytek-2012:p0517:b002:l012","ordinal":334143,"en":"At last, Sarybai,"},{"id":"seytek-2012:p0517:b002:l013","ordinal":334144,"en":"I have met you in your fury."},{"id":"seytek-2012:p0517:b002:l014","ordinal":334145,"en":"Let us make our combat supreme,"},{"id":"seytek-2012:p0517:b002:l015","ordinal":334146,"en":"Fighting without mercy,"},{"id":"seytek-2012:p0517:b002:l016","ordinal":334147,"en":"Let us cry out and thrust our spears!"},{"id":"seytek-2012:p0517:b002:l017","ordinal":334148,"en":"Let us stake our knuckle-sized heads,"},{"id":"seytek-2012:p0517:b002:l018","ordinal":334149,"en":"And swallow lives as great as mountains,"},{"id":"seytek-2012:p0517:b002:l019","ordinal":334150,"en":"Roaming freely over the pasture,"},{"id":"seytek-2012:p0517:b002:l020","ordinal":334151,"en":"And, when we remember, drain each other's lives."},{"id":"seytek-2012:p0517:b002:l021","ordinal":334152,"en":"Let us test the champions,"},{"id":"seytek-2012:p0517:b002:l022","ordinal":334153,"en":"Let us intensify the strife."},{"id":"seytek-2012:p0517:b002:l023","ordinal":334154,"en":"Let us make our fame manifest,"},{"id":"seytek-2012:p0517:b002:l024","ordinal":334155,"en":"And spread the conflict far."},{"id":"seytek-2012:p0517:b002:l025","ordinal":334156,"en":"You began the campaign and war,"},{"id":"seytek-2012:p0517:b002:l026","ordinal":334157,"en":"In which the people were massacred and died;"},{"id":"seytek-2012:p0517:b002:l027","ordinal":334158,"en":"You have grown fond of such deeds!"},{"id":"seytek-2012:p0517:b002:l028","ordinal":334159,"en":"Now behold valor and heroism,"},{"id":"seytek-2012:p0517:b002:l029","ordinal":334160,"en":"Behold such a feat."},{"id":"seytek-2012:p0517:b002:l030","ordinal":334161,"en":"Let our sovereign souls blaze,"},{"id":"seytek-2012:p0517:b002:l031","ordinal":334162,"en":"Let us rouse all our strength,"},{"id":"seytek-2012:p0517:b002:l032","ordinal":334163,"en":"And wage war once more!"},{"id":"seytek-2012:p0517:b002:l033","ordinal":334164,"en":"Our champions and our khans,"},{"id":"seytek-2012:p0517:b002:l034","ordinal":334165,"en":"As though struck by slaughter,"},{"id":"seytek-2012:p0517:b002:l035","ordinal":334166,"en":"Have all been laid waste."},{"id":"seytek-2012:p0517:b002:l036","ordinal":334167,"en":"Our heroes who boasted of valor—"},{"id":"seytek-2012:p0517:b002:l037","ordinal":334168,"en":"May our mighty backs be broken."},{"id":"seytek-2012:p0517:b002:l038","ordinal":334169,"en":"What are turmoil and strife?"},{"id":"seytek-2012:p0517:b002:l039","ordinal":334170,"en":"If you wish, behold them here!”"},{"id":"seytek-2012:p0517:b002:l040","ordinal":334171,"en":"So saying, Külchoro continued:"},{"id":"seytek-2012:p0517:b003:l001","ordinal":334172,"en":"“I shall spill your blood like water."},{"id":"seytek-2012:p0517:b003:l002","ordinal":334173,"en":"I shall bring your life to a clean end,"},{"id":"seytek-2012:p0517:b003:l003","ordinal":334174,"en":"Cutting off your head like this,"},{"id":"seytek-2012:p0517:b003:l004","ordinal":334175,"en":"And offer up your young life."},{"id":"seytek-2012:p0517:b003:l005","ordinal":334176,"en":"Sarybai, son of the ogre,"},{"id":"seytek-2012:p0517:b003:l006","ordinal":334177,"en":"Why are you so wildly enraged?"},{"id":"seytek-2012:p0517:b003:l007","ordinal":334178,"en":"Why rage and stir up strife,"},{"id":"seytek-2012:p0517:b003:l008","ordinal":334179,"en":"When we have not carried off your land,"},{"id":"seytek-2012:p0517:b003:l009","ordinal":334180,"en":"Nor scattered your treasure,"},{"id":"seytek-2012:p0517:b003:l010","ordinal":334181,"en":"Nor raised an uproar in war,"},{"id":"seytek-2012:p0517:b003:l011","ordinal":334182,"en":"Nor overrun your teeming people?"},{"id":"seytek-2012:p0517:b003:l012","ordinal":334183,"en":"As though we had drained your beloved,"},{"id":"seytek-2012:p0517:b003:l013","ordinal":334184,"en":"As though we had reaped your grain unripe,"},{"id":"seytek-2012:p0517:b003:l014","ordinal":334185,"en":"As though we had plundered the domains"},{"id":"seytek-2012:p0517:b003:l015","ordinal":334186,"en":"Of seven generations of ogre chieftains!"},{"id":"seytek-2012:p0517:b003:l016","ordinal":334187,"en":"Why do you make trouble,"},{"id":"seytek-2012:p0517:b003:l017","ordinal":334188,"en":"Descendant of warriors and heroes,"},{"id":"seytek-2012:p0517:b003:l018","ordinal":334189,"en":"Why do you stand against us?"},{"id":"seytek-2012:p0517:b003:l019","ordinal":334190,"en":"Is Talas such an easy land"},{"id":"seytek-2012:p0517:b003:l020","ordinal":334191,"en":"That you might slaughter it,"},{"id":"seytek-2012:p0517:b003:l021","ordinal":334192,"en":"Take it as spoil,"},{"id":"seytek-2012:p0517:b003:l022","ordinal":334193,"en":"And dig out its roots before departing?"},{"id":"seytek-2012:p0517:b003:l023","ordinal":334194,"en":"No migration of yours crossed the Seven Valleys,"},{"id":"seytek-2012:p0517:b003:l024","ordinal":334195,"en":"You have no vengeance from seventy forefathers."},{"id":"seytek-2012:p0517:b003:l025","ordinal":334196,"en":"Do you possess the might, Sarybai,"},{"id":"seytek-2012:p0517:b003:l026","ordinal":334197,"en":"To bring utter calamity?"},{"id":"seytek-2012:p0517:b003:l027","ordinal":334198,"en":"Do you have the fury, Sarybai,"},{"id":"seytek-2012:p0517:b003:l028","ordinal":334199,"en":"To fight until one of us is ended?"},{"id":"seytek-2012:p0517:b003:l029","ordinal":334200,"en":"Did we tether mares in your valley,"},{"id":"seytek-2012:p0517:b003:l030","ordinal":334201,"en":"Or settle upon your people’s land?"},{"id":"seytek-2012:p0517:b003:l031","ordinal":334202,"en":"Did we massacre and despoil your village,"},{"id":"seytek-2012:p0517:b003:l032","ordinal":334203,"en":"That you should glower so?"},{"id":"seytek-2012:p0517:b003:l033","ordinal":334204,"en":"Did we slaughter your people,"},{"id":"seytek-2012:p0517:b003:l034","ordinal":334205,"en":"That you should swagger and provoke strife?"},{"id":"seytek-2012:p0517:b003:l035","ordinal":334206,"en":"If you are the hero Sarybai,"},{"id":"seytek-2012:p0517:b003:l036","ordinal":334207,"en":"And I am the hero Külchoro,"},{"id":"seytek-2012:p0517:b003:l037","ordinal":334208,"en":"A hero was the foe I sought;"},{"id":"seytek-2012:p0517:b003:l038","ordinal":334209,"en":"What I asked of God,"},{"id":"seytek-2012:p0517:b003:l039","ordinal":334210,"en":"What I prayed for, was you:"},{"id":"seytek-2012:p0517:b003:l040","ordinal":334211,"en":"‘I knew of your enmity,"},{"id":"seytek-2012:p0518:b002:l001","ordinal":334212,"en":"They advanced with noses running,"},{"id":"seytek-2012:p0518:b002:l002","ordinal":334213,"en":"Their weapons numbering eighty-four,"},{"id":"seytek-2012:p0518:b002:l003","ordinal":334214,"en":"Their onslaught blazing like fire."},{"id":"seytek-2012:p0518:b002:l004","ordinal":334215,"en":"When my father, the Ogre,"},{"id":"seytek-2012:p0518:b002:l005","ordinal":334216,"en":"Saw Manas’s bearing,"},{"id":"seytek-2012:p0518:b002:l006","ordinal":334217,"en":"He found no ridge to flee across,"},{"id":"seytek-2012:p0518:b002:l007","ordinal":334218,"en":"No black earth to enter,"},{"id":"seytek-2012:p0518:b002:l008","ordinal":334219,"en":"No grave in which to lie."},{"id":"seytek-2012:p0518:b002:l009","ordinal":334220,"en":"When eagle Bakai and hero Koshoy"},{"id":"seytek-2012:p0518:b002:l010","ordinal":334221,"en":"Blocked the valley of Kerüüchö"},{"id":"seytek-2012:p0518:b002:l011","ordinal":334222,"en":"Without letting anyone stir,"},{"id":"seytek-2012:p0518:b002:l012","ordinal":334223,"en":"When Almambet wrought havoc,"},{"id":"seytek-2012:p0518:b002:l013","ordinal":334224,"en":"And Chubak and hero Syrgak speared"},{"id":"seytek-2012:p0518:b002:l014","ordinal":334225,"en":"The champions who shot in ranks"},{"id":"seytek-2012:p0518:b002:l015","ordinal":334226,"en":"And plundered my countless wealth,"},{"id":"seytek-2012:p0518:b002:l016","ordinal":334227,"en":"When my father, the Ogre,"},{"id":"seytek-2012:p0518:b002:l017","ordinal":334228,"en":"Was slain by hero Manas,"},{"id":"seytek-2012:p0518:b002:l018","ordinal":334229,"en":"They broke open my treasury and made a road through it,"},{"id":"seytek-2012:p0518:b002:l019","ordinal":334230,"en":"And subdued my warriors,"},{"id":"seytek-2012:p0518:b002:l020","ordinal":334231,"en":"Loading all my heaped-up riches"},{"id":"seytek-2012:p0518:b002:l021","ordinal":334232,"en":"Upon my own elephants."},{"id":"seytek-2012:p0518:b002:l022","ordinal":334233,"en":"They tormented my very soul,"},{"id":"seytek-2012:p0518:b002:l023","ordinal":334234,"en":"And plundered all my livestock."},{"id":"seytek-2012:p0518:b002:l024","ordinal":334235,"en":"They bewildered my people,"},{"id":"seytek-2012:p0518:b002:l025","ordinal":334236,"en":"And bent my back many times."},{"id":"seytek-2012:p0518:b002:l026","ordinal":334237,"en":"They tasted much of my salt,"},{"id":"seytek-2012:p0518:b002:l027","ordinal":334238,"en":"Then plundered and carried away"},{"id":"seytek-2012:p0518:b002:l028","ordinal":334239,"en":"My needle-mouthed, camel-eyed,"},{"id":"seytek-2012:p0518:b002:l029","ordinal":334240,"en":"Restless dark-eyed"},{"id":"seytek-2012:p0518:b002:l030","ordinal":334241,"en":"Daughter, beautiful as this,"},{"id":"seytek-2012:p0518:b002:l031","ordinal":334242,"en":"The strength around which I girded my belt,"},{"id":"seytek-2012:p0518:b002:l032","ordinal":334243,"en":"And my people, diminished sixfold."},{"id":"seytek-2012:p0518:b002:l033","ordinal":334244,"en":"After long ruin I recovered,"},{"id":"seytek-2012:p0518:b002:l034","ordinal":334245,"en":"I grew up while still in swaddling clothes."},{"id":"seytek-2012:p0518:b002:l035","ordinal":334246,"en":"I am a warrior and a hero;"},{"id":"seytek-2012:p0518:b002:l036","ordinal":334247,"en":"I am Sarybai the champion!"},{"id":"seytek-2012:p0518:b002:l037","ordinal":334248,"en":"I crush whoever challenges me,"},{"id":"seytek-2012:p0518:b002:l038","ordinal":334249,"en":"I devour whoever meets me;"},{"id":"seytek-2012:p0518:b002:l039","ordinal":334250,"en":"I am the black scourge itself!”"},{"id":"seytek-2012:p0518:b002:l040","ordinal":334251,"en":"Skilled in the ways of war,"},{"id":"seytek-2012:p0518:b003:l001","ordinal":334252,"en":"Külchoro said this to Sarybai,"},{"id":"seytek-2012:p0518:b003:l002","ordinal":334253,"en":"And fierce fury seized him."},{"id":"seytek-2012:p0518:b003:l003","ordinal":334254,"en":"He ground apart"},{"id":"seytek-2012:p0518:b003:l004","ordinal":334255,"en":"His broad, gate-like front teeth;"},{"id":"seytek-2012:p0518:b003:l005","ordinal":334256,"en":"His eyes became burning embers,"},{"id":"seytek-2012:p0518:b003:l006","ordinal":334257,"en":"His lashes blazing fire."},{"id":"seytek-2012:p0518:b003:l007","ordinal":334258,"en":"The warrior could not restrain"},{"id":"seytek-2012:p0518:b003:l008","ordinal":334259,"en":"His surge, like a rushing river:"},{"id":"seytek-2012:p0518:b003:l009","ordinal":334260,"en":"Sarybai was ready to fight."},{"id":"seytek-2012:p0518:b003:l010","ordinal":334261,"en":"Would a gray wolf hold back?"},{"id":"seytek-2012:p0518:b003:l011","ordinal":334262,"en":"After Külchoro spoke thus,"},{"id":"seytek-2012:p0518:b003:l012","ordinal":334263,"en":"The Ogre’s son answered,"},{"id":"seytek-2012:p0518:b003:l013","ordinal":334264,"en":"Utterly dreadful words:"},{"id":"seytek-2012:p0518:b003:l014","ordinal":334265,"en":"“If I do not slaughter your whole lineage,"},{"id":"seytek-2012:p0518:b003:l015","ordinal":334266,"en":"If I do not do all the harm I know,"},{"id":"seytek-2012:p0518:b003:l016","ordinal":334267,"en":"If I heed your words when you plead,"},{"id":"seytek-2012:p0518:b003:l017","ordinal":334268,"en":"If I fail to avenge myself,"},{"id":"seytek-2012:p0518:b003:l018","ordinal":334269,"en":"May I die unworthy of the name Sarybai;"},{"id":"seytek-2012:p0518:b003:l019","ordinal":334270,"en":"May I sink into the depths unborn,"},{"id":"seytek-2012:p0518:b003:l020","ordinal":334271,"en":"As though never born of the Ogre!"},{"id":"seytek-2012:p0518:b003:l021","ordinal":334272,"en":"I have many words to tell,"},{"id":"seytek-2012:p0518:b003:l022","ordinal":334273,"en":"And if you consider the horses wearied and lives tormented,"},{"id":"seytek-2012:p0518:b003:l023","ordinal":334274,"en":"You will see how great my grievance is."},{"id":"seytek-2012:p0518:b003:l024","ordinal":334275,"en":"In Zhelpinish lived Jarmanas,"},{"id":"seytek-2012:p0518:b003:l025","ordinal":334276,"en":"Whose wife was Karjygach;"},{"id":"seytek-2012:p0518:b003:l026","ordinal":334277,"en":"She and Khan Manas were siblings."},{"id":"seytek-2012:p0518:b003:l027","ordinal":334278,"en":"They camped along the cliffs,"},{"id":"seytek-2012:p0518:b003:l028","ordinal":334279,"en":"And, coming to Karjygach’s aid,"},{"id":"seytek-2012:p0518:b003:l029","ordinal":334280,"en":"Gathered an army from the Kyrgyz."},{"id":"seytek-2012:p0518:b003:l030","ordinal":334281,"en":"The noble Bakai and hero Koshoy"},{"id":"seytek-2012:p0518:b003:l031","ordinal":334282,"en":"Led an army such as this,"},{"id":"seytek-2012:p0518:b003:l032","ordinal":334283,"en":"Loosing arrows in punishment,"},{"id":"seytek-2012:p0518:b003:l033","ordinal":334284,"en":"Hiding by night and not marching by day."},{"id":"seytek-2012:p0518:b003:l034","ordinal":334285,"en":"They were warriors of many kinds,"},{"id":"seytek-2012:p0518:b003:l035","ordinal":334286,"en":"Great Manas at the army’s head,"},{"id":"seytek-2012:p0518:b003:l036","ordinal":334287,"en":"And Karjygach behind the host."},{"id":"seytek-2012:p0518:b003:l037","ordinal":334288,"en":"Plumed standards rose and banners thronged,"},{"id":"seytek-2012:p0518:b003:l038","ordinal":334289,"en":"A dark and dreadful tumult arose,"},{"id":"seytek-2012:p0518:b003:l039","ordinal":334290,"en":"Throwing the whole world into panic."},{"id":"seytek-2012:p0518:b003:l040","ordinal":334291,"en":"Beneath him, the great horse Kula"},{"id":"seytek-2012:p0519:b002:l001","ordinal":334292,"en":"Made the earth thunder and mountains shift,"},{"id":"seytek-2012:p0519:b002:l002","ordinal":334293,"en":"Tormenting every soul who heard,"},{"id":"seytek-2012:p0519:b002:l003","ordinal":334294,"en":"As Sarybai sat astride it."},{"id":"seytek-2012:p0519:b002:l004","ordinal":334295,"en":"That infidel Sarybai"},{"id":"seytek-2012:p0519:b002:l005","ordinal":334296,"en":"Charged like a wild boar."},{"id":"seytek-2012:p0519:b002:l006","ordinal":334297,"en":"The fierce courage of that swine"},{"id":"seytek-2012:p0519:b002:l007","ordinal":334298,"en":"Was like a wind that shattered mountains and rocks."},{"id":"seytek-2012:p0519:b002:l008","ordinal":334299,"en":"His ferocity was like a quagmire;"},{"id":"seytek-2012:p0519:b002:l009","ordinal":334300,"en":"All but the hero Külchoro"},{"id":"seytek-2012:p0519:b002:l010","ordinal":334301,"en":"Seemed to collapse and fall."},{"id":"seytek-2012:p0519:b002:l011","ordinal":334302,"en":"Such was the warrior’s state,"},{"id":"seytek-2012:p0519:b002:l012","ordinal":334303,"en":"The ruthless devourer Sarybai."},{"id":"seytek-2012:p0519:b002:l013","ordinal":334304,"en":"The infidel’s fury overflowed;"},{"id":"seytek-2012:p0519:b002:l014","ordinal":334305,"en":"His roaring shook the valley."},{"id":"seytek-2012:p0519:b002:l015","ordinal":334306,"en":"Despairing of life and thinking themselves dead,"},{"id":"seytek-2012:p0519:b002:l016","ordinal":334307,"en":"The teeming Argyn and Kyrgyz people,"},{"id":"seytek-2012:p0519:b002:l017","ordinal":334308,"en":"Unable to collect their wits,"},{"id":"seytek-2012:p0519:b002:l018","ordinal":334309,"en":"Fled amid the thunder."},{"id":"seytek-2012:p0519:b002:l019","ordinal":334310,"en":"Sarybai, son of the Ogre,"},{"id":"seytek-2012:p0519:b002:l020","ordinal":334311,"en":"Seemed ready to reap destruction;"},{"id":"seytek-2012:p0519:b002:l021","ordinal":334312,"en":"If the scoundrel had his way,"},{"id":"seytek-2012:p0519:b002:l022","ordinal":334313,"en":"He would stuff the entire world"},{"id":"seytek-2012:p0519:b002:l023","ordinal":334314,"en":"Into a single saddlebag."},{"id":"seytek-2012:p0519:b002:l024","ordinal":334315,"en":"His savage fury seemed all-consuming,"},{"id":"seytek-2012:p0519:b002:l025","ordinal":334316,"en":"His strength ready to swallow lives."},{"id":"seytek-2012:p0519:b002:l026","ordinal":334317,"en":"Each hair upon his face"},{"id":"seytek-2012:p0519:b002:l027","ordinal":334318,"en":"Was like the haft of a battle-ax."},{"id":"seytek-2012:p0519:b002:l028","ordinal":334319,"en":"The fierce courage of that swine"},{"id":"seytek-2012:p0519:b002:l029","ordinal":334320,"en":"Was like flame burning across the uplands."},{"id":"seytek-2012:p0519:b002:l030","ordinal":334321,"en":"Such was Sarybai,"},{"id":"seytek-2012:p0519:b002:l031","ordinal":334322,"en":"That blazing boar."},{"id":"seytek-2012:p0519:b002:l032","ordinal":334323,"en":"The earth split with a crash,"},{"id":"seytek-2012:p0519:b002:l033","ordinal":334324,"en":"As he roared as though to devour them."},{"id":"seytek-2012:p0519:b002:l034","ordinal":334325,"en":"Like a crumbling mountain ledge,"},{"id":"seytek-2012:p0519:b002:l035","ordinal":334326,"en":"Like a flood pouring down a slope,"},{"id":"seytek-2012:p0519:b002:l036","ordinal":334327,"en":"Like a deep-dug grave,"},{"id":"seytek-2012:p0519:b002:l037","ordinal":334328,"en":"The madman came upon them."},{"id":"seytek-2012:p0519:b002:l038","ordinal":334329,"en":"Firing his musket and drawing his bow,"},{"id":"seytek-2012:p0519:b002:l039","ordinal":334330,"en":"Sarybai spared not his life;"},{"id":"seytek-2012:p0519:b002:l040","ordinal":334331,"en":"He cursed again and showered arrows,"},{"id":"seytek-2012:p0519:b003:l001","ordinal":334332,"en":"Never sated though he drank blood."},{"id":"seytek-2012:p0519:b003:l002","ordinal":334333,"en":"My resting place beneath the earth"},{"id":"seytek-2012:p0519:b003:l003","ordinal":334334,"en":"Was there beside Zhelpinish."},{"id":"seytek-2012:p0519:b003:l004","ordinal":334335,"en":"“To unleash a terrible slaughter,"},{"id":"seytek-2012:p0519:b003:l005","ordinal":334336,"en":"To avenge my father—"}]
