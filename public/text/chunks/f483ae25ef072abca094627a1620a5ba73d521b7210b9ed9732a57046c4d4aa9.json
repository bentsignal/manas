[{"id":"semetey-1-2013:p0553:b003:l017","ordinal":119297,"en":"Merging with the face of the earth,"},{"id":"semetey-1-2013:p0553:b003:l018","ordinal":119298,"en":"Unbelievers and Muslims,"},{"id":"semetey-1-2013:p0553:b003:l019","ordinal":119299,"en":"My mother painted their clash."},{"id":"semetey-1-2013:p0553:b003:l020","ordinal":119300,"en":"Such was the unbelievers' appearance;"},{"id":"semetey-1-2013:p0553:b003:l021","ordinal":119301,"en":"Your orphan, standing and looking,"},{"id":"semetey-1-2013:p0553:b003:l022","ordinal":119302,"en":"When he turned his eyes toward Islam,"},{"id":"semetey-1-2013:p0553:b003:l023","ordinal":119303,"en":"The wolf-man lion who departed for eternity,"},{"id":"semetey-1-2013:p0553:b003:l024","ordinal":119304,"en":"The dark wolf-man leopard,"},{"id":"semetey-1-2013:p0553:b003:l025","ordinal":119305,"en":"Riding a horse like Akkula,"},{"id":"semetey-1-2013:p0553:b003:l026","ordinal":119306,"en":"Wearing a coat like Akkolpok,"},{"id":"semetey-1-2013:p0553:b003:l027","ordinal":119307,"en":"Having plentiful ammunition loaded,"},{"id":"semetey-1-2013:p0553:b003:l028","ordinal":119308,"en":"Lest a stray shot should strike,"},{"id":"semetey-1-2013:p0553:b003:l029","ordinal":119309,"en":"The boundlessly swift Akkula"},{"id":"semetey-1-2013:p0553:b003:l030","ordinal":119310,"en":"He had covered with a patterned horsecloth."},{"id":"semetey-1-2013:p0553:b003:l031","ordinal":119311,"en":"Lest distant journeys prove impossible,"},{"id":"semetey-1-2013:p0553:b003:l032","ordinal":119312,"en":"Upon all four hooves"},{"id":"semetey-1-2013:p0553:b003:l033","ordinal":119313,"en":"He had golden horseshoes nailed."},{"id":"semetey-1-2013:p0553:b003:l034","ordinal":119314,"en":"Of middle stature, broad of shoulder,"},{"id":"semetey-1-2013:p0553:b003:l035","ordinal":119315,"en":"Both a wrestler and a lion,"},{"id":"semetey-1-2013:p0553:b003:l036","ordinal":119316,"en":"My sultan father, Manas the hero."},{"id":"semetey-1-2013:p0553:b003:l037","ordinal":119317,"en":"Nine were his protectors,"},{"id":"semetey-1-2013:p0553:b003:l038","ordinal":119318,"en":"Gathering beneath his arms,"},{"id":"semetey-1-2013:p0553:b003:l039","ordinal":119319,"en":"Nine were those who gave him aid,"},{"id":"semetey-1-2013:p0553:b005:l001","ordinal":119320,"en":"Gathering on every side,"},{"id":"semetey-1-2013:p0553:b005:l002","ordinal":119321,"en":"A black-spotted leopard"},{"id":"semetey-1-2013:p0553:b005:l003","ordinal":119322,"en":"Raging at his flank."},{"id":"semetey-1-2013:p0553:b005:l004","ordinal":119323,"en":"A short-tailed, shaggy-maned lion,"},{"id":"semetey-1-2013:p0553:b005:l005","ordinal":119324,"en":"My father's spiritual patrons"},{"id":"semetey-1-2013:p0553:b005:l006","ordinal":119325,"en":"Readied themselves on every side."},{"id":"semetey-1-2013:p0553:b005:l007","ordinal":119326,"en":"My father's Boz Kise belt gleaming at his waist,"},{"id":"semetey-1-2013:p0553:b005:l008","ordinal":119327,"en":"Akkelte, brought into gunfire,"},{"id":"semetey-1-2013:p0553:b005:l009","ordinal":119328,"en":"Gleaming upon my father's back."},{"id":"semetey-1-2013:p0553:b005:l010","ordinal":119329,"en":"Six keen blades descended from heaven,"},{"id":"semetey-1-2013:p0553:b005:l011","ordinal":119330,"en":"The finest of the swords,"},{"id":"semetey-1-2013:p0553:b005:l012","ordinal":119331,"en":"Zulpukor, which Khan Manas acquired,"},{"id":"semetey-1-2013:p0553:b005:l013","ordinal":119332,"en":"Gleaming at his wrist."},{"id":"semetey-1-2013:p0553:b005:l014","ordinal":119333,"en":"The lacquered spear made by his friend Bölökbai"},{"id":"semetey-1-2013:p0553:b005:l015","ordinal":119334,"en":"Showing beneath his right thigh,"},{"id":"semetey-1-2013:p0553:b005:l016","ordinal":119335,"en":"A helmet of blue iron"},{"id":"semetey-1-2013:p0553:b005:l017","ordinal":119336,"en":"Set down over his head,"},{"id":"semetey-1-2013:p0553:b005:l018","ordinal":119337,"en":"The Chinese and Manchus who tormented them"},{"id":"semetey-1-2013:p0553:b005:l019","ordinal":119338,"en":"He drove off, forcing them to flee."},{"id":"semetey-1-2013:p0553:b005:l020","ordinal":119339,"en":"The blood-shedding leopard, the precious lion,"},{"id":"semetey-1-2013:p0553:b005:l021","ordinal":119340,"en":"My father she painted in the picture."},{"id":"semetey-1-2013:p0553:b005:l022","ordinal":119341,"en":"On the nearer side of him,"},{"id":"semetey-1-2013:p0553:b005:l023","ordinal":119342,"en":"Wearing a blue-gray lynx-fur cap,"},{"id":"semetey-1-2013:p0553:b005:l024","ordinal":119343,"en":"Riding a horse like a blue-gray courser,"},{"id":"semetey-1-2013:p0553:b005:l025","ordinal":119344,"en":"Wielding a mottled blue shield,"},{"id":"semetey-1-2013:p0553:b005:l026","ordinal":119345,"en":"Finding words when taken by surprise,"},{"id":"semetey-1-2013:p0553:b005:l027","ordinal":119346,"en":"Finding sight in the dark of night,"},{"id":"semetey-1-2013:p0553:b005:l028","ordinal":119347,"en":"Islam's young foal,"},{"id":"semetey-1-2013:p0553:b005:l029","ordinal":119348,"en":"The very son of saintliness,"},{"id":"semetey-1-2013:p0553:b005:l030","ordinal":119349,"en":"The most skilled of those who took up spears,"},{"id":"semetey-1-2013:p0553:b005:l031","ordinal":119350,"en":"The finest of common men,"},{"id":"semetey-1-2013:p0553:b005:l032","ordinal":119351,"en":"The wrestler among the forty companions,"},{"id":"semetey-1-2013:p0553:b005:l033","ordinal":119352,"en":"Khan Manas's warrior,"},{"id":"semetey-1-2013:p0553:b005:l034","ordinal":119353,"en":"The Muslims' resourceful champion,"},{"id":"semetey-1-2013:p0553:b005:l035","ordinal":119354,"en":"My uncle Bakai, a surpassing lion,"},{"id":"semetey-1-2013:p0553:b005:l036","ordinal":119355,"en":"Driving off the outlying Chinese troops,"},{"id":"semetey-1-2013:p0553:b005:l037","ordinal":119356,"en":"My father's red banner with its golden crescent"},{"id":"semetey-1-2013:p0553:b005:l039","ordinal":119357,"en":"Placed in Khan Bakai's grasp,"},{"id":"semetey-1-2013:p0554:b003:l001","ordinal":119358,"en":"Driving the Chinese people before him,"},{"id":"semetey-1-2013:p0554:b003:l002","ordinal":119359,"en":"She painted Bakai in the picture."},{"id":"semetey-1-2013:p0554:b003:l003","ordinal":119360,"en":"When he looked this way,"},{"id":"semetey-1-2013:p0554:b003:l004","ordinal":119361,"en":"Golden forelock and tasseled sash,"},{"id":"semetey-1-2013:p0554:b003:l005","ordinal":119362,"en":"Aziz Khan's only son,"},{"id":"semetey-1-2013:p0554:b003:l006","ordinal":119363,"en":"A bringer of good fortune when sent ahead,"},{"id":"semetey-1-2013:p0554:b003:l007","ordinal":119364,"en":"Like countless troops when leading the way,"},{"id":"semetey-1-2013:p0554:b003:l008","ordinal":119365,"en":"A bringer of good fortune when giving shelter,"},{"id":"semetey-1-2013:p0554:b003:l009","ordinal":119366,"en":"The handsome sultan, like countless troops."},{"id":"semetey-1-2013:p0554:b003:l010","ordinal":119367,"en":"This infidel, had sprung."},{"id":"semetey-1-2013:p0554:b003:l011","ordinal":119368,"en":"Upon Kakancha's golden throne,"},{"id":"semetey-1-2013:p0554:b003:l012","ordinal":119369,"en":"At the time he sat enthroned,"},{"id":"semetey-1-2013:p0554:b003:l013","ordinal":119370,"en":"The forty tribes of China, the countless people,"},{"id":"semetey-1-2013:p0554:b003:l014","ordinal":119371,"en":"Alake kept from wavering,"},{"id":"semetey-1-2013:p0554:b003:l015","ordinal":119372,"en":"At the time he ruled them."},{"id":"semetey-1-2013:p0554:b003:l016","ordinal":119373,"en":"On Friday's sacred night,"},{"id":"semetey-1-2013:p0554:b003:l017","ordinal":119374,"en":"At the time he slept,"},{"id":"semetey-1-2013:p0554:b003:l018","ordinal":119375,"en":"Bringing news to his side,"},{"id":"semetey-1-2013:p0554:b003:l019","ordinal":119376,"en":"A saint had come."},{"id":"semetey-1-2013:p0554:b003:l020","ordinal":119377,"en":"Through that being's intervention,"},{"id":"semetey-1-2013:p0554:b003:l021","ordinal":119378,"en":"He saw the workings of heaven and hell."},{"id":"semetey-1-2013:p0554:b003:l022","ordinal":119379,"en":"The saint Alman, the precious lion,"},{"id":"semetey-1-2013:p0554:b003:l023","ordinal":119380,"en":"Pure in spirit from birth,"},{"id":"semetey-1-2013:p0554:b003:l024","ordinal":119381,"en":"A true saint, that unfortunate hero,"},{"id":"semetey-1-2013:p0554:b003:l025","ordinal":119382,"en":"The cow-tailed Sarala"},{"id":"semetey-1-2013:p0554:b003:l026","ordinal":119383,"en":"He did not saddle as the Manchus did;"},{"id":"semetey-1-2013:p0554:b003:l027","ordinal":119384,"en":"His idol as large as a house"},{"id":"semetey-1-2013:p0554:b003:l028","ordinal":119385,"en":"He did not worship and bow before."},{"id":"semetey-1-2013:p0554:b003:l029","ordinal":119386,"en":"Renouncing his idols,"},{"id":"semetey-1-2013:p0554:b003:l030","ordinal":119387,"en":"Leaving his Chinese people,"},{"id":"semetey-1-2013:p0554:b003:l031","ordinal":119388,"en":"Scattering what he had amassed,"},{"id":"semetey-1-2013:p0554:b003:l032","ordinal":119389,"en":"Seeking only his faith,"},{"id":"semetey-1-2013:p0554:b003:l033","ordinal":119390,"en":"He smeared his golden throne with grease;"},{"id":"semetey-1-2013:p0554:b003:l034","ordinal":119391,"en":"Because he would not enter the Muslim faith,"},{"id":"semetey-1-2013:p0554:b003:l035","ordinal":119392,"en":"He killed his own father,"},{"id":"semetey-1-2013:p0554:b003:l036","ordinal":119393,"en":"Bloodied his silver throne,"},{"id":"semetey-1-2013:p0554:b003:l037","ordinal":119394,"en":"Killed his father Kün Jangjung."},{"id":"semetey-1-2013:p0554:b003:l038","ordinal":119395,"en":"Having yellow willows planted,"},{"id":"semetey-1-2013:p0554:b003:l039","ordinal":119396,"en":"He abandoned his willows utterly;"},{"id":"semetey-1-2013:p0554:b004:l001","ordinal":119397,"en":"Made of pure gold,"},{"id":"semetey-1-2013:p0554:b004:l002","ordinal":119398,"en":"He abandoned his throne utterly."},{"id":"semetey-1-2013:p0554:b004:l003","ordinal":119399,"en":"When God created Almam,"},{"id":"semetey-1-2013:p0554:b004:l004","ordinal":119400,"en":"Alas, when his wretched mother gave birth,"},{"id":"semetey-1-2013:p0554:b004:l005","ordinal":119401,"en":"The tips of his ears were pierced,"},{"id":"semetey-1-2013:p0554:b004:l006","ordinal":119402,"en":"His foreskin already circumcised,"},{"id":"semetey-1-2013:p0554:b004:l007","ordinal":119403,"en":"His twelve bodily members troubled,"},{"id":"semetey-1-2013:p0554:b004:l008","ordinal":119404,"en":"With a sign like a prophet's,"},{"id":"semetey-1-2013:p0554:b004:l009","ordinal":119405,"en":"His forehead reached the ground."},{"id":"semetey-1-2013:p0554:b004:l010","ordinal":119406,"en":"When Alake was being born,"},{"id":"semetey-1-2013:p0554:b004:l011","ordinal":119407,"en":"The weather broke, rain fell,"},{"id":"semetey-1-2013:p0554:b004:l012","ordinal":119408,"en":"Through Kakancha's Beijing"},{"id":"semetey-1-2013:p0554:b004:l013","ordinal":119409,"en":"Water flowed for eighty days,"},{"id":"semetey-1-2013:p0554:b004:l014","ordinal":119410,"en":"And earthquakes came."},{"id":"semetey-1-2013:p0554:b004:l015","ordinal":119411,"en":"Reading in their laws,"},{"id":"semetey-1-2013:p0554:b004:l016","ordinal":119412,"en":"The Chinese diviners said,"},{"id":"semetey-1-2013:p0554:b004:l017","ordinal":119413,"en":"“Which is the child Almam?"},{"id":"semetey-1-2013:p0554:b004:l018","ordinal":119414,"en":"Upon the whole wide world"},{"id":"semetey-1-2013:p0554:b004:l019","ordinal":119415,"en":"Which child has brought turmoil?"},{"id":"semetey-1-2013:p0554:b004:l020","ordinal":119416,"en":"With pierced ears from his mother"},{"id":"semetey-1-2013:p0554:b004:l021","ordinal":119417,"en":"Which child was born?"},{"id":"semetey-1-2013:p0554:b004:l022","ordinal":119418,"en":"Who will draw tight a double girth,"},{"id":"semetey-1-2013:p0554:b004:l023","ordinal":119419,"en":"Which is the child with girth-straps?"},{"id":"semetey-1-2013:p0554:b004:l024","ordinal":119420,"en":"Who will raise rebellion in Beijing,"},{"id":"semetey-1-2013:p0554:b004:l025","ordinal":119421,"en":"Which is the child of omens?"},{"id":"semetey-1-2013:p0554:b004:l026","ordinal":119422,"en":"Precious eyes like blackcurrants—"},{"id":"semetey-1-2013:p0554:b004:l027","ordinal":119423,"en":"Which child will gouge them out?"},{"id":"semetey-1-2013:p0554:b004:l028","ordinal":119424,"en":"Crushing Kakan's people,"},{"id":"semetey-1-2013:p0554:b004:l029","ordinal":119425,"en":"Which child will slaughter them?"},{"id":"semetey-1-2013:p0554:b004:l030","ordinal":119426,"en":"Named at his birth,"},{"id":"semetey-1-2013:p0554:b004:l031","ordinal":119427,"en":"Which is the child Almam?"},{"id":"semetey-1-2013:p0554:b004:l032","ordinal":119428,"en":"Upon the whole wide world"},{"id":"semetey-1-2013:p0554:b004:l033","ordinal":119429,"en":"Which child has brought turmoil?”"},{"id":"semetey-1-2013:p0554:b004:l034","ordinal":119430,"en":"The Chinese began to search;"},{"id":"semetey-1-2013:p0554:b004:l035","ordinal":119431,"en":"God had struck them down."},{"id":"semetey-1-2013:p0554:b004:l036","ordinal":119432,"en":"His mother, the wise Altynai,"},{"id":"semetey-1-2013:p0554:b004:l037","ordinal":119433,"en":"“They will tear him from my hands,"},{"id":"semetey-1-2013:p0554:b004:l038","ordinal":119434,"en":"He will go before their diviner,"},{"id":"semetey-1-2013:p0554:b004:l039","ordinal":119435,"en":"My little one, whom I gained through mortal hardship,"},{"id":"semetey-1-2013:p0555:b003:l001","ordinal":119436,"en":"The unbelievers will seize him"},{"id":"semetey-1-2013:p0555:b003:l002","ordinal":119437,"en":"And put him to death,” she said."},{"id":"semetey-1-2013:p0555:b003:l003","ordinal":119438,"en":"Hanging an amulet about his neck,"},{"id":"semetey-1-2013:p0555:b003:l004","ordinal":119439,"en":"The wise woman Altynai"},{"id":"semetey-1-2013:p0555:b003:l005","ordinal":119440,"en":"Had her father Sooronduk rear him."},{"id":"semetey-1-2013:p0555:b003:l006","ordinal":119441,"en":"When the amulet was hung about his neck,"},{"id":"semetey-1-2013:p0555:b003:l007","ordinal":119442,"en":"From his grandfather Sooronduk's hands,"},{"id":"semetey-1-2013:p0555:b003:l008","ordinal":119443,"en":"Giving gold and precious metal by the pood,"},{"id":"semetey-1-2013:p0555:b003:l009","ordinal":119444,"en":"When he died, she took him back."},{"id":"semetey-1-2013:p0555:b003:l010","ordinal":119445,"en":"Before his father Aziz Khan,"},{"id":"semetey-1-2013:p0555:b003:l011","ordinal":119446,"en":"“I have borne a son!” she said,"},{"id":"semetey-1-2013:p0555:b003:l012","ordinal":119447,"en":"And went to bring the joyful news."},{"id":"semetey-1-2013:p0555:b003:l013","ordinal":119448,"en":"Aziz Khan in Beijing"},{"id":"semetey-1-2013:p0555:b003:l014","ordinal":119449,"en":"In his unfortunate mother"},{"id":"semetey-1-2013:p0555:b003:l015","ordinal":119450,"en":"Put little trust."},{"id":"semetey-1-2013:p0555:b003:l016","ordinal":119451,"en":"“She is the most beautiful of women,"},{"id":"semetey-1-2013:p0555:b003:l017","ordinal":119452,"en":"A girl who turned seventeen this year;"},{"id":"semetey-1-2013:p0555:b003:l018","ordinal":119453,"en":"It is not a year since I took her,"},{"id":"semetey-1-2013:p0555:b003:l019","ordinal":119454,"en":"It is not a month since I saw her;"},{"id":"semetey-1-2013:p0555:b003:l020","ordinal":119455,"en":"Her time to give birth has not come,"},{"id":"semetey-1-2013:p0555:b003:l021","ordinal":119456,"en":"The moment to bear her child has not come.”"},{"id":"semetey-1-2013:p0555:b003:l022","ordinal":119457,"en":"Nursing dark suspicion, Aziz Khan thought:"},{"id":"semetey-1-2013:p0555:b003:l023","ordinal":119458,"en":"“One who never wore drawers,"},{"id":"semetey-1-2013:p0555:b003:l024","ordinal":119459,"en":"Never sat down to urinate,"},{"id":"semetey-1-2013:p0555:b003:l025","ordinal":119460,"en":"Whose ox grew old and died by itself,"},{"id":"semetey-1-2013:p0555:b003:l026","ordinal":119461,"en":"Who divided the dead man's livestock equally,"},{"id":"semetey-1-2013:p0555:b003:l027","ordinal":119462,"en":"Who consecrated his goat,"},{"id":"semetey-1-2013:p0555:b003:l028","ordinal":119463,"en":"Who rode an unbroken horse,"},{"id":"semetey-1-2013:p0555:b003:l029","ordinal":119464,"en":"Who was a stranger to women—"},{"id":"semetey-1-2013:p0555:b003:l030","ordinal":119465,"en":"Could she have borne him by a monk?"},{"id":"semetey-1-2013:p0555:b003:l031","ordinal":119466,"en":"Or by one who often roamed at night,"},{"id":"semetey-1-2013:p0555:b003:l032","ordinal":119467,"en":"Could she have borne him by a wrestler?"},{"id":"semetey-1-2013:p0555:b003:l033","ordinal":119468,"en":"If he is another man's son,"},{"id":"semetey-1-2013:p0555:b003:l034","ordinal":119469,"en":"Let me cut off his head at once;"},{"id":"semetey-1-2013:p0555:b003:l035","ordinal":119470,"en":"If he is my own son,"},{"id":"semetey-1-2013:p0555:b003:l036","ordinal":119471,"en":"Let me rear him very well.”"},{"id":"semetey-1-2013:p0555:b003:l037","ordinal":119472,"en":"Saying this, Aziz Khan"},{"id":"semetey-1-2013:p0555:b003:l038","ordinal":119473,"en":"Summoned his calculator,"},{"id":"semetey-1-2013:p0555:b003:l039","ordinal":119474,"en":"Who reckoned the days,"},{"id":"semetey-1-2013:p0555:b005:l001","ordinal":119475,"en":"Dividing the reckoning of years a thousandfold,"},{"id":"semetey-1-2013:p0555:b005:l002","ordinal":119476,"en":"Comparing year with year,"},{"id":"semetey-1-2013:p0555:b005:l003","ordinal":119477,"en":"Dividing the reckoning of months a thousandfold,"},{"id":"semetey-1-2013:p0555:b005:l004","ordinal":119478,"en":"Comparing month with month."},{"id":"semetey-1-2013:p0555:b005:l005","ordinal":119479,"en":"“Since I took this wife,"},{"id":"semetey-1-2013:p0555:b005:l006","ordinal":119480,"en":"Nine months are complete,” he said."},{"id":"semetey-1-2013:p0555:b005:l007","ordinal":119481,"en":"“This child she has borne"},{"id":"semetey-1-2013:p0555:b005:l008","ordinal":119482,"en":"Has proved to be my own son.”"},{"id":"semetey-1-2013:p0555:b005:l009","ordinal":119483,"en":"Beating drums, holding a feast,"},{"id":"semetey-1-2013:p0555:b005:l010","ordinal":119484,"en":"The people of the world gathered,"},{"id":"semetey-1-2013:p0555:b005:l011","ordinal":119485,"en":"The Chinese people held a feast."},{"id":"semetey-1-2013:p0555:b005:l012","ordinal":119486,"en":"Rain scattered from the heavens,"},{"id":"semetey-1-2013:p0555:b005:l013","ordinal":119487,"en":"God's radiance opened upon the earth,"},{"id":"semetey-1-2013:p0555:b005:l014","ordinal":119488,"en":"Blessings poured forth in abundance,"},{"id":"semetey-1-2013:p0555:b005:l015","ordinal":119489,"en":"Receiving food sufficient for forty years,"},{"id":"semetey-1-2013:p0555:b005:l016","ordinal":119490,"en":"The people of Beijing ate their fill."},{"id":"semetey-1-2013:p0555:b005:l017","ordinal":119491,"en":"He was given the name Almambet."},{"id":"semetey-1-2013:p0555:b005:l018","ordinal":119492,"en":"Sarala, the horse beneath him,"},{"id":"semetey-1-2013:p0555:b005:l019","ordinal":119493,"en":"Joined him when he was as small as a thumb,"},{"id":"semetey-1-2013:p0555:b005:l020","ordinal":119494,"en":"United with him when he was tiny as a louse,"},{"id":"semetey-1-2013:p0555:b005:l021","ordinal":119495,"en":"Girding his waist firmly,"},{"id":"semetey-1-2013:p0555:b005:l022","ordinal":119496,"en":"The two were born upon one day."},{"id":"semetey-1-2013:p0555:b005:l023","ordinal":119497,"en":"Aziz Khan in Beijing said:"},{"id":"semetey-1-2013:p0555:b005:l024","ordinal":119498,"en":"“Before this I took sixty wives,"},{"id":"semetey-1-2013:p0555:b005:l026","ordinal":119499,"en":"But never saw an offspring."},{"id":"semetey-1-2013:p0555:b005:l027","ordinal":119500,"en":"In my eighty-ninth year"},{"id":"semetey-1-2013:p0555:b005:l028","ordinal":119501,"en":"I have gained this Almambet.”"},{"id":"semetey-1-2013:p0555:b005:l029","ordinal":119502,"en":"Hanging an amulet about his neck,"},{"id":"semetey-1-2013:p0555:b005:l030","ordinal":119503,"en":"He had the sixty poor wives"},{"id":"semetey-1-2013:p0555:b005:l031","ordinal":119504,"en":"Rear him as their child."},{"id":"semetey-1-2013:p0555:b005:l032","ordinal":119505,"en":"While he lived with Aziz Khan,"},{"id":"semetey-1-2013:p0555:b005:l033","ordinal":119506,"en":"He had not yet entered the faith;"},{"id":"semetey-1-2013:p0555:b005:l034","ordinal":119507,"en":"Alake had not yet learned what was true."},{"id":"semetey-1-2013:p0555:b005:l035","ordinal":119508,"en":"Naked, without a shirt,"},{"id":"semetey-1-2013:p0555:b005:l036","ordinal":119509,"en":"His precious hair as black as coal,"},{"id":"semetey-1-2013:p0555:b005:l037","ordinal":119510,"en":"He had reached the age of six."},{"id":"semetey-1-2013:p0555:b005:l038","ordinal":119511,"en":"When his age reached six,"},{"id":"semetey-1-2013:p0555:b005:l039","ordinal":119512,"en":"Sarala had grown into a mature horse,"},{"id":"semetey-1-2013:p0556:b003:l001","ordinal":119513,"en":"He saddled Sarala."},{"id":"semetey-1-2013:p0556:b003:l002","ordinal":119514,"en":"“This is our God,” he said,"},{"id":"semetey-1-2013:p0556:b003:l003","ordinal":119515,"en":"And read Chinese writings."},{"id":"semetey-1-2013:p0556:b003:l004","ordinal":119516,"en":"In the fortress of Beijing,"},{"id":"semetey-1-2013:p0556:b003:l005","ordinal":119517,"en":"When his age reached six,"},{"id":"semetey-1-2013:p0556:b003:l006","ordinal":119518,"en":"Aziz Khan in Beijing"},{"id":"semetey-1-2013:p0556:b003:l007","ordinal":119519,"en":"Had drawn the line,"},{"id":"semetey-1-2013:p0556:b003:l008","ordinal":119520,"en":"Upon Alake Khan's head"},{"id":"semetey-1-2013:p0556:b003:l009","ordinal":119521,"en":"Had begun to bring turmoil."},{"id":"semetey-1-2013:p0556:b003:l010","ordinal":119522,"en":"Roaring in anger,"},{"id":"semetey-1-2013:p0556:b003:l011","ordinal":119523,"en":"“My foal, come here!” he said,"},{"id":"semetey-1-2013:p0556:b003:l012","ordinal":119524,"en":"Calling my precious Alake."},{"id":"semetey-1-2013:p0556:b003:l013","ordinal":119525,"en":"“Almambet, my spring that feeds a flowing river,"},{"id":"semetey-1-2013:p0556:b003:l014","ordinal":119526,"en":"My little one, whom I gained through mortal hardship!"},{"id":"semetey-1-2013:p0556:b003:l015","ordinal":119527,"en":"Alööke Khan, Aziz Khan,"},{"id":"semetey-1-2013:p0556:b003:l016","ordinal":119528,"en":"Karykan, khan of Beijing,"},{"id":"semetey-1-2013:p0556:b003:l017","ordinal":119529,"en":"And Esen—the four are brothers."},{"id":"semetey-1-2013:p0556:b003:l018","ordinal":119530,"en":"From the hearth came an ember;"},{"id":"semetey-1-2013:p0556:b003:l019","ordinal":119531,"en":"From Alööke, Konurbai"},{"id":"semetey-1-2013:p0556:b003:l020","ordinal":119532,"en":"Emerged a merciless tyrant."},{"id":"semetey-1-2013:p0556:b003:l021","ordinal":119533,"en":"My source of tea,"},{"id":"semetey-1-2013:p0556:b003:l022","ordinal":119534,"en":"My land he seized,"},{"id":"semetey-1-2013:p0556:b003:l023","ordinal":119535,"en":"And I suffered humiliation from him!"},{"id":"semetey-1-2013:p0556:b003:l024","ordinal":119536,"en":"Börüköz, Esen Khan's son,"},{"id":"semetey-1-2013:p0556:b003:l025","ordinal":119537,"en":"My mine where gold was dug,"},{"id":"semetey-1-2013:p0556:b003:l026","ordinal":119538,"en":"That swine seized it."},{"id":"semetey-1-2013:p0556:b003:l027","ordinal":119539,"en":"Your white beard"},{"id":"semetey-1-2013:p0556:b003:l028","ordinal":119540,"en":"He too took away my people,"},{"id":"semetey-1-2013:p0556:b003:l029","ordinal":119541,"en":"And I suffered humiliation from him!"},{"id":"semetey-1-2013:p0556:b003:l030","ordinal":119542,"en":"Grow to maturity, become a hero,"},{"id":"semetey-1-2013:p0556:b003:l031","ordinal":119543,"en":"Alake, become the equal of a hero's son."},{"id":"semetey-1-2013:p0556:b003:l032","ordinal":119544,"en":"Alööke's Konurbai—"},{"id":"semetey-1-2013:p0556:b003:l033","ordinal":119545,"en":"Make him call you Aziz Khan's son;"},{"id":"semetey-1-2013:p0556:b003:l034","ordinal":119546,"en":"Bring great havoc upon him,"},{"id":"semetey-1-2013:p0556:b003:l035","ordinal":119547,"en":"The tea-producing land he seized,"},{"id":"semetey-1-2013:p0556:b003:l036","ordinal":119548,"en":"Wrest it back from the scoundrel for me."},{"id":"semetey-1-2013:p0556:b003:l037","ordinal":119549,"en":"If Kalcha falls into your hands,"},{"id":"semetey-1-2013:p0556:b003:l038","ordinal":119550,"en":"Bring great havoc upon him."},{"id":"semetey-1-2013:p0556:b003:l039","ordinal":119551,"en":"If you truly are my son,"},{"id":"semetey-1-2013:p0556:b004:l001","ordinal":119552,"en":"My child, avenge me far and wide!"}]
