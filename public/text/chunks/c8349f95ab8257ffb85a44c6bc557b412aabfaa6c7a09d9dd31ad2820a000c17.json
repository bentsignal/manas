[{"id":"sayakbay-ms-current144:pdf097:l021","ordinal":391169,"en":"[It is not the ruined Burut nation,]"},{"id":"sayakbay-ms-current144:pdf097:l022","ordinal":391170,"en":"Even if the world's khans gather,"},{"id":"sayakbay-ms-current144:pdf097:l023","ordinal":391171,"en":"I have strength to subdue them."},{"id":"sayakbay-ms-current144:pdf097:l024","ordinal":391172,"en":"If life should remain by chance,"},{"id":"sayakbay-ms-current144:pdf097:l025","ordinal":391173,"en":"If death should strike unexpectedly,"},{"id":"sayakbay-ms-current144:pdf097:l026","ordinal":391174,"en":"[I possess formidable, untouchable strength,]"},{"id":"sayakbay-ms-current144:pdf097:l027","ordinal":391175,"en":"[One who asks of your condition,]"},{"id":"sayakbay-ms-current144:pdf097:l028","ordinal":391176,"en":"You have the renowned khan Kiche."},{"id":"sayakbay-ms-current144:pdf097:l029","ordinal":391177,"en":"While that Kiche stands,"},{"id":"sayakbay-ms-current144:pdf097:l030","ordinal":391178,"en":"[I have my people in Kayser.]"},{"id":"sayakbay-ms-current144:pdf098:l001","ordinal":391179,"en":"Subduing the whole world,"},{"id":"sayakbay-ms-current144:pdf098:l002","ordinal":391180,"en":"I have strength to take it all."},{"id":"sayakbay-ms-current144:pdf098:l003","ordinal":391181,"en":"[Swaggering and boasting,]"},{"id":"sayakbay-ms-current144:pdf098:l005","ordinal":391182,"en":"[Raging against the whole world,]"},{"id":"sayakbay-ms-current144:pdf098:l006","ordinal":391183,"en":"[Right there where the waters met,]"},{"id":"sayakbay-ms-current144:pdf098:l007","ordinal":391184,"en":"[Directing the enemy straight upward,]"},{"id":"sayakbay-ms-current144:pdf098:l008","ordinal":391185,"en":"Driving them back and forth,"},{"id":"sayakbay-ms-current144:pdf098:l009","ordinal":391186,"en":"[Making the blood he trampled a grievance,]"},{"id":"sayakbay-ms-current144:pdf098:l010","ordinal":391187,"en":"Sending his champions around,"},{"id":"sayakbay-ms-current144:pdf098:l011","ordinal":391188,"en":"Taking the entire horse herd,"},{"id":"sayakbay-ms-current144:pdf098:l013","ordinal":391189,"en":"He roamed with a rumbling din,"},{"id":"sayakbay-ms-current144:pdf098:l015","ordinal":391190,"en":"Let us leave this here,"},{"id":"sayakbay-ms-current144:pdf098:l017","ordinal":391191,"en":"The equally bold warrior Seytek,"},{"id":"sayakbay-ms-current144:pdf098:l019","ordinal":391192,"en":"[Those who remained pondering,]"},{"id":"sayakbay-ms-current144:pdf098:l020","ordinal":391193,"en":"Hearing news from the herdsman,"},{"id":"sayakbay-ms-current144:pdf098:l021","ordinal":391194,"en":"The meaning of the herdsman's words,"},{"id":"sayakbay-ms-current144:pdf098:l022","ordinal":391195,"en":"[Much weighed upon their thoughts,]"},{"id":"sayakbay-ms-current144:pdf098:l023","ordinal":391196,"en":"Erbay, son of Eshidin,"},{"id":"sayakbay-ms-current144:pdf098:l024","ordinal":391197,"en":"[Escaped when that one died.]"},{"id":"sayakbay-ms-current144:pdf098:l025","ordinal":391198,"en":"Making the seven crossroads resound,"},{"id":"sayakbay-ms-current144:pdf098:l027","ordinal":391199,"en":"Finding a plan, he departed,"},{"id":"sayakbay-ms-current144:pdf098:l028","ordinal":391200,"en":"[Escaping when that one died,]"},{"id":"sayakbay-ms-current144:pdf098:l029","ordinal":391201,"en":"Crying out for Talas,"},{"id":"sayakbay-ms-current144:pdf099:l001","ordinal":391202,"en":"[Saying they had reached the very roots together,]"},{"id":"sayakbay-ms-current144:pdf099:l002","ordinal":391203,"en":"Your entire horse herd,"},{"id":"sayakbay-ms-current144:pdf099:l003","ordinal":391204,"en":"Utterly disturbing your sleep,"},{"id":"sayakbay-ms-current144:pdf099:l006","ordinal":391205,"en":"[The swine driving off your horses,]"},{"id":"sayakbay-ms-current144:pdf099:l007","ordinal":391206,"en":"Destroying your property behind you,"},{"id":"sayakbay-ms-current144:pdf099:l008","ordinal":391207,"en":"[Bringing ruin upon your nephew,]"},{"id":"sayakbay-ms-current144:pdf099:l010","ordinal":391208,"en":"[It was the moment of the raid,]"},{"id":"sayakbay-ms-current144:pdf099:l013","ordinal":391209,"en":"Of the Black Chinese and Manchu,"},{"id":"sayakbay-ms-current144:pdf099:l014","ordinal":391210,"en":"[The devastating might of that infidel,]"},{"id":"sayakbay-ms-current144:pdf099:l016","ordinal":391211,"en":"[His dark watching eyes,]"},{"id":"sayakbay-ms-current144:pdf099:l018","ordinal":391212,"en":"Coming and going, scouting the land,"},{"id":"sayakbay-ms-current144:pdf099:l019","ordinal":391213,"en":"He had now arrived,"},{"id":"sayakbay-ms-current144:pdf099:l020","ordinal":391214,"en":"He had a magnificent steed,"},{"id":"sayakbay-ms-current144:pdf099:l022","ordinal":391215,"en":"He alone had the strength of a thousand."},{"id":"sayakbay-ms-current144:pdf099:l024","ordinal":391216,"en":"[That restless infidel's,]"},{"id":"sayakbay-ms-current144:pdf099:l026","ordinal":391217,"en":"Would the enemy refrain from advancing?"},{"id":"sayakbay-ms-current144:pdf099:l029","ordinal":391218,"en":"[He had a hulking, reckless appearance,]"},{"id":"sayakbay-ms-current144:pdf100:l001","ordinal":391219,"en":"[I could not discern his true nature,]"},{"id":"sayakbay-ms-current144:pdf100:l028","ordinal":391220,"en":"Tying its flowing tail tightly,"},{"id":"sayakbay-ms-current144:pdf100:l029","ordinal":391221,"en":"His valor plain to see,"},{"id":"sayakbay-ms-current144:pdf101:l002","ordinal":391222,"en":"[He rejoiced intensely,]"},{"id":"sayakbay-ms-current144:pdf101:l003","ordinal":391223,"en":"Putting on his battle dress,"},{"id":"sayakbay-ms-current144:pdf101:l004","ordinal":391224,"en":"[The noble warrior who faced the foe,]"},{"id":"sayakbay-ms-current144:pdf101:l005","ordinal":391225,"en":"Rejoicing at the mention of death,"},{"id":"sayakbay-ms-current144:pdf101:l006","ordinal":391226,"en":"[From the broad plain where no loud sound reached,]"},{"id":"sayakbay-ms-current144:pdf101:l007","ordinal":391227,"en":"From the wide ravine where no bird flew,"},{"id":"sayakbay-ms-current144:pdf101:l008","ordinal":391228,"en":"[The hero, drawing the brass shaft from the ridge,]"},{"id":"sayakbay-ms-current144:pdf101:l011","ordinal":391229,"en":"Our elder set out on the road,"},{"id":"sayakbay-ms-current144:pdf101:l012","ordinal":391230,"en":"Choking with wrath,"},{"id":"sayakbay-ms-current144:pdf101:l013","ordinal":391231,"en":"Fashioned from blue iron,"},{"id":"sayakbay-ms-current144:pdf101:l014","ordinal":391232,"en":"[With its firmly secured crest,]"},{"id":"sayakbay-ms-current144:pdf101:l015","ordinal":391233,"en":"[Its cheekpiece fitted and ready,]"},{"id":"sayakbay-ms-current144:pdf101:l017","ordinal":391234,"en":"Everything fitted and tied,"},{"id":"sayakbay-ms-current144:pdf101:l018","ordinal":391235,"en":"[Securing its corners tightly,]"},{"id":"sayakbay-ms-current144:pdf101:l019","ordinal":391236,"en":"[Tucked beneath his throat.]"},{"id":"sayakbay-ms-current144:pdf101:l020","ordinal":391237,"en":"Your elder Joltoy, stirred to fury,"},{"id":"sayakbay-ms-current144:pdf101:l021","ordinal":391238,"en":"Dressed in arrow-proof armor,"},{"id":"sayakbay-ms-current144:pdf101:l022","ordinal":391239,"en":"Making Kulansur prance,"},{"id":"sayakbay-ms-current144:pdf101:l024","ordinal":391240,"en":"[Thundering without looking aside,]"},{"id":"sayakbay-ms-current144:pdf101:l026","ordinal":391241,"en":"Rumbled without pause,"},{"id":"sayakbay-ms-current144:pdf101:l027","ordinal":391242,"en":"Like the rush of a surging river,"},{"id":"sayakbay-ms-current144:pdf101:l028","ordinal":391243,"en":"[Such was his strength,]"},{"id":"sayakbay-ms-current144:pdf102:l001","ordinal":391244,"en":"Akjoltoy, son of Kutubiy,"},{"id":"sayakbay-ms-current144:pdf102:l002","ordinal":391245,"en":"[He was Seytek's inheritance,]"},{"id":"sayakbay-ms-current144:pdf102:l003","ordinal":391246,"en":"[The falcon he himself roused,]"},{"id":"sayakbay-ms-current144:pdf102:l004","ordinal":391247,"en":"If hardship befell their dear heads,"},{"id":"sayakbay-ms-current144:pdf102:l006","ordinal":391248,"en":"[He would stand beneath their banner.]"},{"id":"sayakbay-ms-current144:pdf102:l007","ordinal":391249,"en":"Akjoltoy raised his battle cry,"},{"id":"sayakbay-ms-current144:pdf102:l008","ordinal":391250,"en":"Appearing in wondrous forms,"},{"id":"sayakbay-ms-current144:pdf102:l009","ordinal":391251,"en":"He alone was worth countless troops,"},{"id":"sayakbay-ms-current144:pdf102:l011","ordinal":391252,"en":"[His bearing majestic and weighty,]"},{"id":"sayakbay-ms-current144:pdf102:l013","ordinal":391253,"en":"Tall as a tower,"},{"id":"sayakbay-ms-current144:pdf102:l016","ordinal":391254,"en":"No enemy had broken his wrath,"},{"id":"sayakbay-ms-current144:pdf102:l017","ordinal":391255,"en":"[Talas, held among his people,]"},{"id":"sayakbay-ms-current144:pdf102:l018","ordinal":391256,"en":"No one had overrun it,"},{"id":"sayakbay-ms-current144:pdf102:l019","ordinal":391257,"en":"No one had seized and ruled it,"},{"id":"sayakbay-ms-current144:pdf102:l020","ordinal":391258,"en":"No mortal had called it a calamity,"},{"id":"sayakbay-ms-current144:pdf102:l021","ordinal":391259,"en":"Since he began ruling Talas,"},{"id":"sayakbay-ms-current144:pdf102:l022","ordinal":391260,"en":"[No grievous enemy, piercing like water,]"},{"id":"sayakbay-ms-current144:pdf102:l027","ordinal":391261,"en":"To break and cut through his assault,"},{"id":"sayakbay-ms-current144:pdf102:l029","ordinal":391262,"en":"Traveling by night rather than day,"},{"id":"sayakbay-ms-current144:pdf102:l031","ordinal":391263,"en":"His prowess and bravery,"},{"id":"sayakbay-ms-current144:pdf103:l003","ordinal":391264,"en":"[Crying his battle cry like a mighty one,]"},{"id":"sayakbay-ms-current144:pdf103:l004","ordinal":391265,"en":"Gathering force in fury,"},{"id":"sayakbay-ms-current144:pdf103:l005","ordinal":391266,"en":"The horse flew like a whirlwind,"},{"id":"sayakbay-ms-current144:pdf103:l007","ordinal":391267,"en":"Ever since I became Akjoltoy,"},{"id":"sayakbay-ms-current144:pdf103:l008","ordinal":391268,"en":"Ever since I bore the name Akjoltoy,"},{"id":"sayakbay-ms-current144:pdf103:l011","ordinal":391269,"en":"I left you idle and fed you grain,"},{"id":"sayakbay-ms-current144:pdf103:l012","ordinal":391270,"en":"So I might ride you on campaign,"},{"id":"sayakbay-ms-current144:pdf103:l013","ordinal":391271,"en":"You came to me from the unseen realm,"},{"id":"sayakbay-ms-current144:pdf103:l015","ordinal":391272,"en":"Traveling hard upon the road,"},{"id":"sayakbay-ms-current144:pdf103:l016","ordinal":391273,"en":"[You had not known sweat-soaked saddle straps,]"},{"id":"sayakbay-ms-current144:pdf103:l017","ordinal":391274,"en":"O dear creature, Kulansur,"},{"id":"sayakbay-ms-current144:pdf103:l018","ordinal":391275,"en":"Your companion who shares your mortal fate,"},{"id":"sayakbay-ms-current144:pdf103:l019","ordinal":391276,"en":"You lower your head to the earth,"},{"id":"sayakbay-ms-current144:pdf103:l020","ordinal":391277,"en":"[You lengthen your stride to your strength,]"},{"id":"sayakbay-ms-current144:pdf103:l021","ordinal":391278,"en":"The people behind us are our support,"},{"id":"sayakbay-ms-current144:pdf103:l023","ordinal":391279,"en":"[A warrior's nature is different,]"},{"id":"sayakbay-ms-current144:pdf103:l024","ordinal":391280,"en":"Now let us descend onto the plain,"},{"id":"sayakbay-ms-current144:pdf103:l026","ordinal":391281,"en":"Raising dust along the people's frontier,"},{"id":"sayakbay-ms-current144:pdf103:l027","ordinal":391282,"en":"Come forth for my people, Kulansur,"},{"id":"sayakbay-ms-current144:pdf103:l028","ordinal":391283,"en":"[As a true animal companion,]"},{"id":"sayakbay-ms-current144:pdf103:l029","ordinal":391284,"en":"[Come forth to your reward, Kulansur.]"},{"id":"sayakbay-ms-current144:pdf103:l030","ordinal":391285,"en":"So saying, Akjoltoy,"},{"id":"sayakbay-ms-current144:pdf104:l001","ordinal":391286,"en":"[Eagerly holding his mortal life,]"},{"id":"sayakbay-ms-current144:pdf104:l002","ordinal":391287,"en":"For honor, for dignity,"},{"id":"sayakbay-ms-current144:pdf104:l003","ordinal":391288,"en":"[He bound it to his resolve.]"},{"id":"sayakbay-ms-current144:pdf104:l008","ordinal":391289,"en":"To stand exchanging blows,"},{"id":"sayakbay-ms-current144:pdf104:l009","ordinal":391290,"en":"[His resolve became steely,]"},{"id":"sayakbay-ms-current144:pdf104:l010","ordinal":391291,"en":"[Against the fully mighty infidel,]"},{"id":"sayakbay-ms-current144:pdf104:l013","ordinal":391292,"en":"To unleash his fierce wrath,"},{"id":"sayakbay-ms-current144:pdf104:l015","ordinal":391293,"en":"To wrest them back,"},{"id":"sayakbay-ms-current144:pdf104:l016","ordinal":391294,"en":"If Akjoltoy could not take them,"},{"id":"sayakbay-ms-current144:pdf104:l017","ordinal":391295,"en":"[He saw a path from which he would not return.]"},{"id":"sayakbay-ms-current144:pdf104:l019","ordinal":391296,"en":"He was ready to give his life."},{"id":"sayakbay-ms-current144:pdf104:l020","ordinal":391297,"en":"[Attacking without counting the odds,]"},{"id":"sayakbay-ms-current144:pdf104:l021","ordinal":391298,"en":"Testing their strength against each other."},{"id":"sayakbay-ms-current144:pdf104:l025","ordinal":391299,"en":"Straining without pause,"},{"id":"sayakbay-ms-current144:pdf104:l027","ordinal":391300,"en":"Urging Kulansur with angry words,"},{"id":"sayakbay-ms-current144:pdf104:l028","ordinal":391301,"en":"[The dark-lashed, loop-handled whip,]"},{"id":"sayakbay-ms-current144:pdf104:l029","ordinal":391302,"en":"[Setting that whip to work,]"},{"id":"sayakbay-ms-current144:pdf104:l030","ordinal":391303,"en":"[His palm … turning,]"},{"id":"sayakbay-ms-current144:pdf105:l001","ordinal":391304,"en":"[Its wrist loop a single sleeve,]"},{"id":"sayakbay-ms-current144:pdf105:l002","ordinal":391305,"en":"[The hide that could turn a head aside,]"},{"id":"sayakbay-ms-current144:pdf105:l003","ordinal":391306,"en":"[Threaded through its core,]"},{"id":"sayakbay-ms-current144:pdf105:l004","ordinal":391307,"en":"The skin of a yellow-spotted wether goat,"},{"id":"sayakbay-ms-current144:pdf105:l005","ordinal":391308,"en":"Packed tightly and braided."},{"id":"sayakbay-ms-current144:pdf105:l007","ordinal":391309,"en":"Its braiding packed and fashioned,"},{"id":"sayakbay-ms-current144:pdf105:l009","ordinal":391310,"en":"The dark-lashed, loop-handled whip,"},{"id":"sayakbay-ms-current144:pdf105:l010","ordinal":391311,"en":"When it struck, ears were deafened,"},{"id":"sayakbay-ms-current144:pdf105:l011","ordinal":391312,"en":"Gripping it firmly, bracing himself,"},{"id":"sayakbay-ms-current144:pdf105:l012","ordinal":391313,"en":"The whip struck Kulansur,"},{"id":"sayakbay-ms-current144:pdf105:l013","ordinal":391314,"en":"He drew his knees tight against it."},{"id":"sayakbay-ms-current144:pdf105:l015","ordinal":391315,"en":"After the sharp whip struck,"},{"id":"sayakbay-ms-current144:pdf105:l016","ordinal":391316,"en":"[Its flesh parting like mutton,]"},{"id":"sayakbay-ms-current144:pdf105:l017","ordinal":391317,"en":"[Its spirit and back straightening,]"},{"id":"sayakbay-ms-current144:pdf105:l018","ordinal":391318,"en":"Its mouth opened with a roar,"},{"id":"sayakbay-ms-current144:pdf105:l020","ordinal":391319,"en":"[Scattering like mountain-sized houses.]"},{"id":"sayakbay-ms-current144:pdf105:l023","ordinal":391320,"en":"Rattling behind it,"},{"id":"sayakbay-ms-current144:pdf105:l025","ordinal":391321,"en":"[It drew near to hem him in.]"},{"id":"sayakbay-ms-current144:pdf105:l026","ordinal":391322,"en":"Why would Ichig hold back?"},{"id":"sayakbay-ms-current144:pdf105:l027","ordinal":391323,"en":"Towering Ala-Too,"},{"id":"sayakbay-ms-current144:pdf105:l028","ordinal":391324,"en":"[Leaning against its foothills,]"},{"id":"sayakbay-ms-current144:pdf105:l029","ordinal":391325,"en":"He was about to reach Ichig,"},{"id":"sayakbay-ms-current144:pdf105:l030","ordinal":391326,"en":"Before the blood-drinker's eyes,"},{"id":"sayakbay-ms-current144:pdf106:l001","ordinal":391327,"en":"Before the raider himself,"},{"id":"sayakbay-ms-current144:pdf106:l002","ordinal":391328,"en":"Before the scorpion who ravaged the people,"},{"id":"sayakbay-ms-current144:pdf106:l003","ordinal":391329,"en":"Traveling all the way from Beijing,"},{"id":"sayakbay-ms-current144:pdf106:l004","ordinal":391330,"en":"Before the scorpion who raided horses,"},{"id":"sayakbay-ms-current144:pdf106:l005","ordinal":391331,"en":"Before that fire-cursed wretch himself,"},{"id":"sayakbay-ms-current144:pdf106:l006","ordinal":391332,"en":"Before the raging one's eyes,"},{"id":"sayakbay-ms-current144:pdf106:l007","ordinal":391333,"en":"Dust rose above their heads,"},{"id":"sayakbay-ms-current144:pdf106:l008","ordinal":391334,"en":"The horses appeared dimly through it,"},{"id":"sayakbay-ms-current144:pdf106:l009","ordinal":391335,"en":"That sage was a mighty warrior,"},{"id":"sayakbay-ms-current144:pdf106:l010","ordinal":391336,"en":"Of the horses raided from strangers,"},{"id":"sayakbay-ms-current144:pdf106:l011","ordinal":391337,"en":"He had disturbed their sleep,"},{"id":"sayakbay-ms-current144:pdf106:l012","ordinal":391338,"en":"[The creatures reared by others,]"},{"id":"sayakbay-ms-current144:pdf106:l013","ordinal":391339,"en":"[They were now the Beijing man's livestock,]"},{"id":"sayakbay-ms-current144:pdf106:l014","ordinal":391340,"en":"The black mare leading the herd,"},{"id":"sayakbay-ms-current144:pdf106:l015","ordinal":391341,"en":"Leaving none of the scrawny ones,"},{"id":"sayakbay-ms-current144:pdf106:l016","ordinal":391342,"en":"He had slaughtered them all."},{"id":"sayakbay-ms-current144:pdf106:l017","ordinal":391343,"en":"He let out a loud battle cry,"},{"id":"sayakbay-ms-current144:pdf106:l018","ordinal":391344,"en":"[Like a strip upon a tethering frame,]"},{"id":"sayakbay-ms-current144:pdf106:l019","ordinal":391345,"en":"He swept through and slaughtered them,"},{"id":"sayakbay-ms-current144:pdf106:l020","ordinal":391346,"en":"Making the mares whinny,"},{"id":"sayakbay-ms-current144:pdf106:l021","ordinal":391347,"en":"The gap-toothed one drove them away."},{"id":"sayakbay-ms-current144:pdf106:l022","ordinal":391348,"en":"[The wretched herd had not rested,]"},{"id":"sayakbay-ms-current144:pdf106:l024","ordinal":391349,"en":"All the fat ones, rich with flesh,"},{"id":"sayakbay-ms-current144:pdf106:l025","ordinal":391350,"en":"He drove away without exception."},{"id":"sayakbay-ms-current144:pdf106:l026","ordinal":391351,"en":"He killed the herdsman,"},{"id":"sayakbay-ms-current144:pdf106:l027","ordinal":391352,"en":"Leaving not a trace of that herd,"},{"id":"sayakbay-ms-current144:pdf106:l028","ordinal":391353,"en":"He drove it away in its entirety."},{"id":"sayakbay-ms-current144:pdf106:l029","ordinal":391354,"en":"The day was clear, the night overcast,"},{"id":"sayakbay-ms-current144:pdf106:l030","ordinal":391355,"en":"That dog-sick madman,"},{"id":"sayakbay-ms-current144:pdf107:l001","ordinal":391356,"en":"He had plunged them into hardship,"},{"id":"sayakbay-ms-current144:pdf107:l002","ordinal":391357,"en":"Suddenly fog closed in,"},{"id":"sayakbay-ms-current144:pdf107:l003","ordinal":391358,"en":"The lofty peaks of Ala-Too,"},{"id":"sayakbay-ms-current144:pdf107:l004","ordinal":391359,"en":"[Four layers covered the foothills,]"},{"id":"sayakbay-ms-current144:pdf107:l005","ordinal":391360,"en":"Clouds divided along the ravines,"},{"id":"sayakbay-ms-current144:pdf107:l006","ordinal":391361,"en":"Blue-white hail poured from the sky,"},{"id":"sayakbay-ms-current144:pdf107:l007","ordinal":391362,"en":"The ravine's icy wind,"},{"id":"sayakbay-ms-current144:pdf107:l008","ordinal":391363,"en":"Rose from its very depths,"},{"id":"sayakbay-ms-current144:pdf107:l009","ordinal":391364,"en":"That devastating Kalmyk swine,"},{"id":"sayakbay-ms-current144:pdf107:l010","ordinal":391365,"en":"Showed his weather-working powers."},{"id":"sayakbay-ms-current144:pdf107:l011","ordinal":391366,"en":"Black stones, sheep-sized and house-sized,"},{"id":"sayakbay-ms-current144:pdf107:l012","ordinal":391367,"en":"He sent crashing like a flood,"},{"id":"sayakbay-ms-current144:pdf107:l013","ordinal":391368,"en":"He had blocked the road."},{"id":"sayakbay-ms-current144:pdf107:l014","ordinal":391369,"en":"The day clouded over, obscured,"},{"id":"sayakbay-ms-current144:pdf107:l015","ordinal":391370,"en":"[Ravines and pits split open,]"},{"id":"sayakbay-ms-current144:pdf107:l016","ordinal":391371,"en":"Breaking apart, allowing no passage,"},{"id":"sayakbay-ms-current144:pdf107:l017","ordinal":391372,"en":"Sleet lashed against the face,"},{"id":"sayakbay-ms-current144:pdf107:l018","ordinal":391373,"en":"If you looked at the foothills,"},{"id":"sayakbay-ms-current144:pdf107:l019","ordinal":391374,"en":"Ground fog crept along,"},{"id":"sayakbay-ms-current144:pdf107:l020","ordinal":391375,"en":"He drove horses through clear ground ahead,"},{"id":"sayakbay-ms-current144:pdf107:l021","ordinal":391376,"en":"While night fell behind him,"},{"id":"sayakbay-ms-current144:pdf107:l022","ordinal":391377,"en":"Working wondrous illusions,"},{"id":"sayakbay-ms-current144:pdf107:l023","ordinal":391378,"en":"He was an extraordinary weather sorcerer,"},{"id":"sayakbay-ms-current144:pdf107:l024","ordinal":391379,"en":"[Mounted or afoot, Küchük …,]"},{"id":"sayakbay-ms-current144:pdf107:l025","ordinal":391380,"en":"He was a son born a marksman."},{"id":"sayakbay-ms-current144:pdf107:l026","ordinal":391381,"en":"He was Kakan's fortress,"},{"id":"sayakbay-ms-current144:pdf107:l027","ordinal":391382,"en":"His warrior father was Kojojash,"},{"id":"sayakbay-ms-current144:pdf107:l028","ordinal":391383,"en":"[A life sprung from his ribs,]"},{"id":"sayakbay-ms-current144:pdf107:l029","ordinal":391384,"en":"He was a warrior descended from Kojojash."},{"id":"sayakbay-ms-current144:pdf107:l030","ordinal":391385,"en":"Bracing and straining himself,"},{"id":"sayakbay-ms-current144:pdf107:l031","ordinal":391386,"en":"Of that ill-fated infidel,"},{"id":"sayakbay-ms-current144:pdf108:l001","ordinal":391387,"en":"The time had come to shed blood."},{"id":"sayakbay-ms-current144:pdf108:l003","ordinal":391388,"en":"Kulansur beneath him,"},{"id":"sayakbay-ms-current144:pdf108:l005","ordinal":391389,"en":"Spurring right and left,"},{"id":"sayakbay-ms-current144:pdf108:l006","ordinal":391390,"en":"Akjoltoy was no ordinary warrior."},{"id":"sayakbay-ms-current144:pdf108:l007","ordinal":391391,"en":"The spells Akjoltoy recited,"},{"id":"sayakbay-ms-current144:pdf108:l008","ordinal":391392,"en":"Were no less than the great sage's."},{"id":"sayakbay-ms-current144:pdf108:l009","ordinal":391393,"en":"Rich in wisdom, clear in memory,"},{"id":"sayakbay-ms-current144:pdf108:l010","ordinal":391394,"en":"A champion and a mighty hero,"},{"id":"sayakbay-ms-current144:pdf108:l011","ordinal":391395,"en":"His cunning surpassed the other's,"},{"id":"sayakbay-ms-current144:pdf108:l012","ordinal":391396,"en":"His spear was like a pine tree,"},{"id":"sayakbay-ms-current144:pdf108:l013","ordinal":391397,"en":"When he roamed the world,"},{"id":"sayakbay-ms-current144:pdf108:l014","ordinal":391398,"en":"When bringing justice to his people,"},{"id":"sayakbay-ms-current144:pdf108:l015","ordinal":391399,"en":"He had faced armies in many lands,"},{"id":"sayakbay-ms-current144:pdf108:l016","ordinal":391400,"en":"He had seen many champions and peoples,"},{"id":"sayakbay-ms-current144:pdf108:l017","ordinal":391401,"en":"[Traveling among peoples, pressing them hard,]"},{"id":"sayakbay-ms-current144:pdf108:l018","ordinal":391402,"en":"[Ranging across the lands and peoples.]"},{"id":"sayakbay-ms-current144:pdf108:l019","ordinal":391403,"en":"Swooping like a hawk,"},{"id":"sayakbay-ms-current144:pdf108:l020","ordinal":391404,"en":"[Reared to match many thousands,]"},{"id":"sayakbay-ms-current144:pdf108:l021","ordinal":391405,"en":"Charging against many armies,"},{"id":"sayakbay-ms-current144:pdf108:l022","ordinal":391406,"en":"[Sweeping across the ground he trod,]"},{"id":"sayakbay-ms-current144:pdf108:l023","ordinal":391407,"en":"[Champning his bronze bit,]"},{"id":"sayakbay-ms-current144:pdf108:l024","ordinal":391408,"en":"See the mighty steed, behold it,"},{"id":"sayakbay-ms-current144:pdf108:l025","ordinal":391409,"en":"See the warrior, behold the lion,"},{"id":"sayakbay-ms-current144:pdf108:l026","ordinal":391410,"en":"Catching up with the raider,"},{"id":"sayakbay-ms-current144:pdf108:l027","ordinal":391411,"en":"See the warrior ready to taunt him."},{"id":"sayakbay-ms-current144:pdf108:l028","ordinal":391412,"en":"God forbid you face him,"},{"id":"sayakbay-ms-current144:pdf108:l029","ordinal":391413,"en":"[Ninety sages against this one man,]"},{"id":"sayakbay-ms-current144:pdf108:l030","ordinal":391414,"en":"[He had strength nearly matching a thousand.]"},{"id":"sayakbay-ms-current144:pdf109:l001","ordinal":391415,"en":"Supporting him from many sides,"},{"id":"sayakbay-ms-current144:pdf109:l002","ordinal":391416,"en":"He also had the forty chiltens."},{"id":"sayakbay-ms-current144:pdf109:l003","ordinal":391417,"en":"A fierce battle cry, a mighty shout,"},{"id":"sayakbay-ms-current144:pdf109:l004","ordinal":391418,"en":"[Akjoltoy roared, his blood surging.]"},{"id":"sayakbay-ms-current144:pdf109:l005","ordinal":391419,"en":"A warrior flourishing since childhood,"},{"id":"sayakbay-ms-current144:pdf109:l006","ordinal":391420,"en":"Through shooting, fighting, and spear combat,"},{"id":"sayakbay-ms-current144:pdf109:l007","ordinal":391421,"en":"Dangers of many kinds,"},{"id":"sayakbay-ms-current144:pdf109:l008","ordinal":391422,"en":"He had known since his youth,"},{"id":"sayakbay-ms-current144:pdf109:l009","ordinal":391423,"en":"The elder among brave men,"},{"id":"sayakbay-ms-current144:pdf109:l010","ordinal":391424,"en":"The forefather of young warriors,"}]
