[{"id":"semetey-2-2013:p0033:b003:l038","ordinal":188673,"en":"Pursued the infidel son of Katal"},{"id":"semetey-2-2013:p0033:b003:l039","ordinal":188674,"en":"Bare-backed and without tiring."},{"id":"semetey-2-2013:p0033:b005:l001","ordinal":188675,"en":"A mighty plain beyond the reach of sight,"},{"id":"semetey-2-2013:p0033:b005:l002","ordinal":188676,"en":"No small plain, but a vast one."},{"id":"semetey-2-2013:p0033:b005:l003","ordinal":188677,"en":"Across the face of that plain"},{"id":"semetey-2-2013:p0033:b005:l004","ordinal":188678,"en":"There was no hillock as large as an ankle-bone,"},{"id":"semetey-2-2013:p0033:b005:l005","ordinal":188679,"en":"No sunken hollow or ravine."},{"id":"semetey-2-2013:p0033:b005:l006","ordinal":188680,"en":"No ordinary creature could endure it;"},{"id":"semetey-2-2013:p0033:b005:l007","ordinal":188681,"en":"Unless it were a swift courser"},{"id":"semetey-2-2013:p0033:b005:l008","ordinal":188682,"en":"That would not tire when ridden for six months,"},{"id":"semetey-2-2013:p0033:b005:l009","ordinal":188683,"en":"No other creature"},{"id":"semetey-2-2013:p0033:b005:l010","ordinal":188684,"en":"Could withstand the journey."},{"id":"semetey-2-2013:p0033:b005:l011","ordinal":188685,"en":"None who encountered it remained alive—"},{"id":"semetey-2-2013:p0033:b005:l012","ordinal":188686,"en":"Kyzyl-Kum, beyond the reach of sight."},{"id":"semetey-2-2013:p0033:b005:l013","ordinal":188687,"en":"This is the burning plain:"},{"id":"semetey-2-2013:p0033:b005:l014","ordinal":188688,"en":"If a creature traveled there, its ears burned;"},{"id":"semetey-2-2013:p0033:b005:l015","ordinal":188689,"en":"If a wild ass stepped there, its hooves burned."},{"id":"semetey-2-2013:p0033:b005:l016","ordinal":188690,"en":"It was a scorched desert,"},{"id":"semetey-2-2013:p0033:b005:l017","ordinal":188691,"en":"With no grass to pinch off and eat,"},{"id":"semetey-2-2013:p0033:b005:l018","ordinal":188692,"en":"No water to sip even a drop."},{"id":"semetey-2-2013:p0033:b005:l019","ordinal":188693,"en":"A goose in flight grew exhausted;"},{"id":"semetey-2-2013:p0033:b005:l020","ordinal":188694,"en":"When a black vulture flew,"},{"id":"semetey-2-2013:p0033:b005:l021","ordinal":188695,"en":"Its wings drooped"},{"id":"semetey-2-2013:p0033:b005:l022","ordinal":188696,"en":"And it tired midway across."},{"id":"semetey-2-2013:p0033:b005:l023","ordinal":188697,"en":"It was an exceedingly harsh desert;"},{"id":"semetey-2-2013:p0033:b005:l024","ordinal":188698,"en":"The many Chinese in Beijing,"},{"id":"semetey-2-2013:p0033:b005:l025","ordinal":188699,"en":"From that day to this,"},{"id":"semetey-2-2013:p0033:b005:l026","ordinal":188700,"en":"Called it Dyngsha-Talaa."},{"id":"semetey-2-2013:p0033:b005:l027","ordinal":188701,"en":"When they reached that desert,"},{"id":"semetey-2-2013:p0033:b005:l028","ordinal":188702,"en":"Karagul, son of Katal,"},{"id":"semetey-2-2013:p0033:b005:l029","ordinal":188703,"en":"Whipped Algara"},{"id":"semetey-2-2013:p0033:b005:l030","ordinal":188704,"en":"And fled onward in haste."},{"id":"semetey-2-2013:p0033:b005:l031","ordinal":188705,"en":"Semetey’s horse Buurul"},{"id":"semetey-2-2013:p0033:b005:l032","ordinal":188706,"en":"Redoubled his surging stride"},{"id":"semetey-2-2013:p0033:b005:l033","ordinal":188707,"en":"And swept onward."},{"id":"semetey-2-2013:p0033:b005:l034","ordinal":188708,"en":"When Kongurbai’s Algara"},{"id":"semetey-2-2013:p0033:b005:l035","ordinal":188709,"en":"Reached descending ground,"},{"id":"semetey-2-2013:p0033:b005:l036","ordinal":188710,"en":"He ran far ahead, shimmering like a mirage;"},{"id":"semetey-2-2013:p0033:b005:l037","ordinal":188711,"en":"When Semetey’s horse Buurul"},{"id":"semetey-2-2013:p0033:b005:l038","ordinal":188712,"en":"Started up the slope,"},{"id":"semetey-2-2013:p0033:b005:l039","ordinal":188713,"en":"He was about to reach his heels."},{"id":"semetey-2-2013:p0034:b003:l001","ordinal":188714,"en":"After they had crossed that plain,"},{"id":"semetey-2-2013:p0034:b003:l002","ordinal":188715,"en":"The tale and tumult grew wondrous."},{"id":"semetey-2-2013:p0034:b003:l003","ordinal":188716,"en":"When they journeyed farther,"},{"id":"semetey-2-2013:p0034:b003:l004","ordinal":188717,"en":"They neared the host lying at Dyngsha"},{"id":"semetey-2-2013:p0034:b003:l005","ordinal":188718,"en":"Of Kichi-Beijing, in the place"},{"id":"semetey-2-2013:p0034:b003:l006","ordinal":188719,"en":"Called Chok-Tabylgy—"},{"id":"semetey-2-2013:p0034:b003:l007","ordinal":188720,"en":"The force belonging to the infidel son of Kaldai,"},{"id":"semetey-2-2013:p0034:b003:l008","ordinal":188721,"en":"To hero Khan Kongurbai."},{"id":"semetey-2-2013:p0034:b003:l009","ordinal":188722,"en":"They had drawn close to it."},{"id":"semetey-2-2013:p0034:b003:l010","ordinal":188723,"en":"It was a tower built for keeping watch;"},{"id":"semetey-2-2013:p0034:b003:l011","ordinal":188724,"en":"He was the mighty khan of the Kechil."},{"id":"semetey-2-2013:p0034:b003:l012","ordinal":188725,"en":"If a man died and left his ox behind,"},{"id":"semetey-2-2013:p0034:b003:l013","ordinal":188726,"en":"Kongurbai divided"},{"id":"semetey-2-2013:p0034:b003:l014","ordinal":188727,"en":"The dead man’s property equally."},{"id":"semetey-2-2013:p0034:b003:l015","ordinal":188728,"en":"They raised their seter goat,"},{"id":"semetey-2-2013:p0034:b003:l016","ordinal":188729,"en":"And the mount they rode was a sacred horse;"},{"id":"semetey-2-2013:p0034:b003:l017","ordinal":188730,"en":"Such was the rite of the Kechil:"},{"id":"semetey-2-2013:p0034:b003:l018","ordinal":188731,"en":"All of them went without trousers"},{"id":"semetey-2-2013:p0034:b003:l019","ordinal":188732,"en":"And slept with women."},{"id":"semetey-2-2013:p0034:b003:l020","ordinal":188733,"en":"Upon the hazy ridge of Bozorgo—"},{"id":"semetey-2-2013:p0034:b003:l021","ordinal":188734,"en":"Have you heard?—"},{"id":"semetey-2-2013:p0034:b003:l022","ordinal":188735,"en":"Khan Kongurbai was in the fortress."