[{"id":"semetey-1-2013:p0978:b004:l003","ordinal":150785,"en":"And if you had seen Semetey,"},{"id":"semetey-1-2013:p0978:b004:l004","ordinal":150786,"en":"He raged like a lion,"},{"id":"semetey-1-2013:p0978:b004:l005","ordinal":150787,"en":"Flame sputtering from his mouth,"},{"id":"semetey-1-2013:p0978:b004:l006","ordinal":150788,"en":"Sobbing, “My falcon!”"},{"id":"semetey-1-2013:p0978:b004:l007","ordinal":150789,"en":"He scattered as though seeing darkest night,"},{"id":"semetey-1-2013:p0978:b004:l008","ordinal":150790,"en":"Having lost Akshunkar."},{"id":"semetey-1-2013:p0978:b004:l009","ordinal":150791,"en":"The dear lion, huge as a fighting cock,"},{"id":"semetey-1-2013:p0978:b004:l010","ordinal":150792,"en":"Lay motionless upon the plain."},{"id":"semetey-1-2013:p0978:b004:l011","ordinal":150793,"en":"He grasped the bulungur brass flute"},{"id":"semetey-1-2013:p0978:b004:l012","ordinal":150794,"en":"By its corner and drew it close."},{"id":"semetey-1-2013:p0978:b004:l013","ordinal":150795,"en":"The sorrowing woman Chachykey"},{"id":"semetey-1-2013:p0978:b004:l014","ordinal":150796,"en":"Had sent her two younger brothers;"},{"id":"semetey-1-2013:p0978:b004:l015","ordinal":150797,"en":"Semetey lay in grief,"},{"id":"semetey-1-2013:p0978:b004:l016","ordinal":150798,"en":"As though Kanykey herself had died."},{"id":"semetey-1-2013:p0978:b004:l017","ordinal":150799,"en":"His outstretched leg would not draw in,"},{"id":"semetey-1-2013:p0978:b004:l018","ordinal":150800,"en":"His closed eyes would not open,"},{"id":"semetey-1-2013:p0978:b004:l019","ordinal":150801,"en":"And his sighing would not cease;"},{"id":"semetey-1-2013:p0978:b004:l020","ordinal":150802,"en":"Your blue-maned champion lay sprawled."},{"id":"semetey-1-2013:p0978:b004:l021","ordinal":150803,"en":"He tied Buurul at the grazing line,"},{"id":"semetey-1-2013:p0978:b004:l022","ordinal":150804,"en":"And your magnanimous hero lay swollen with grief."},{"id":"semetey-1-2013:p0978:b004:l023","ordinal":150805,"en":"The two choros were warrior choros,"},{"id":"semetey-1-2013:p0978:b004:l024","ordinal":150806,"en":"As though born as twins;"},{"id":"semetey-1-2013:p0978:b004:l025","ordinal":150807,"en":"The two were equal as a single hair,"},{"id":"semetey-1-2013:p0978:b004:l026","ordinal":150808,"en":"Choros like burning red embers,"},{"id":"semetey-1-2013:p0978:b004:l027","ordinal":150809,"en":"Choros like arrows shot from a bow,"},{"id":"semetey-1-2013:p0978:b004:l028","ordinal":150810,"en":"Calamities loosed upon the world."},{"id":"semetey-1-2013:p0978:b004:l029","ordinal":150811,"en":"When they advanced, they were his supports,"},{"id":"semetey-1-2013:p0978:b004:l030","ordinal":150812,"en":"Setting the grassy land aflame,"},{"id":"semetey-1-2013:p0978:b004:l031","ordinal":150813,"en":"The pillars of Tügöngür."},{"id":"semetey-1-2013:p0978:b004:l032","ordinal":150814,"en":"If your magnanimous Semetey remained safe,"},{"id":"semetey-1-2013:p0978:b004:l033","ordinal":150815,"en":"These boys were the wings"},{"id":"semetey-1-2013:p0978:b004:l034","ordinal":150816,"en":"With which he circled in flight;"},{"id":"semetey-1-2013:p0978:b004:l035","ordinal":150817,"en":"If seven thousand foes appeared,"},{"id":"semetey-1-2013:p0978:b004:l036","ordinal":150818,"en":"It was their custom to strike without wavering."},{"id":"semetey-1-2013:p0978:b004:l037","ordinal":150819,"en":"Kulchoro and Kanchoro—"},{"id":"semetey-1-2013:p0978:b004:l038","ordinal":150820,"en":"From noble Almambet"},{"id":"semetey-1-2013:p0978:b004:l039","ordinal":150821,"en":"Kulchoro was born afterward,"},{"id":"semetey-1-2013:p0979:b003:l001","ordinal":150822,"en":"Kanchoro was born afterward"},{"id":"semetey-1-2013:p0979:b003:l002","ordinal":150823,"en":"To his namesake father Chubak."},{"id":"semetey-1-2013:p0979:b003:l003","ordinal":150824,"en":"Abyke’s Aktelki"},{"id":"semetey-1-2013:p0979:b003:l004","ordinal":150825,"en":"Was the horse Kulchoro rode;"},{"id":"semetey-1-2013:p0979:b003:l005","ordinal":150826,"en":"The horse Kanchoro rode"},{"id":"semetey-1-2013:p0979:b003:l006","ordinal":150827,"en":"Was Khan Köbösh’s Köktelki."},{"id":"semetey-1-2013:p0979:b003:l007","ordinal":150828,"en":"The two truly raced one another,"},{"id":"semetey-1-2013:p0979:b003:l008","ordinal":150829,"en":"And rode out in anger,"},{"id":"semetey-1-2013:p0979:b003:l009","ordinal":150830,"en":"Taking from Semetey’s own mouth"},{"id":"semetey-1-2013:p0979:b003:l010","ordinal":150831,"en":"His firm promise and oath,"},{"id":"semetey-1-2013:p0979:b003:l011","ordinal":150832,"en":"And carrying the letter their elder had written."},{"id":"semetey-1-2013:p0979:b003:l012","ordinal":150833,"en":"When the sun was sinking red,"},{"id":"semetey-1-2013:p0979:b003:l013","ordinal":150834,"en":"Before the people had gone to rest,"},{"id":"semetey-1-2013:p0979:b003:l014","ordinal":150835,"en":"They came below Tört-Kül,"},{"id":"semetey-1-2013:p0979:b003:l015","ordinal":150836,"en":"To Prince Manas’s orchard,"},{"id":"semetey-1-2013:p0979:b003:l016","ordinal":150837,"en":"To the dark eye of the spring,"},{"id":"semetey-1-2013:p0979:b003:l017","ordinal":150838,"en":"To the solitary plane tree,"},{"id":"semetey-1-2013:p0979:b003:l018","ordinal":150839,"en":"To Kanykey’s encampment,"},{"id":"semetey-1-2013:p0979:b003:l019","ordinal":150840,"en":"To Chachykey’s fortress with its gate."},{"id":"semetey-1-2013:p0979:b003:l020","ordinal":150841,"en":"The boys now entered."},{"id":"semetey-1-2013:p0979:b003:l021","ordinal":150842,"en":"The two choros matched their pace;"},{"id":"semetey-1-2013:p0979:b003:l022","ordinal":150843,"en":"Unable to find a way forward,"},{"id":"semetey-1-2013:p0979:b003:l023","ordinal":150844,"en":"The boys whispered together,"},{"id":"semetey-1-2013:p0979:b003:l024","ordinal":150845,"en":"Chatted and laughed softly."},{"id":"semetey-1-2013:p0979:b003:l025","ordinal":150846,"en":"They had long known"},{"id":"semetey-1-2013:p0979:b003:l026","ordinal":150847,"en":"Their sister-in-law’s fierce temper;"},{"id":"semetey-1-2013:p0979:b003:l027","ordinal":150848,"en":"They made a firm agreement,"},{"id":"semetey-1-2013:p0979:b003:l028","ordinal":150849,"en":"And stood without exchanging blessings."},{"id":"semetey-1-2013:p0979:b003:l029","ordinal":150850,"en":"The delicate woman Chachykey"},{"id":"semetey-1-2013:p0979:b003:l030","ordinal":150851,"en":"Had a delicacy all her own,"},{"id":"semetey-1-2013:p0979:b003:l031","ordinal":150852,"en":"Her scarf like a golden amulet,"},{"id":"semetey-1-2013:p0979:b003:l032","ordinal":150853,"en":"A troubled, beautiful white brow."},{"id":"semetey-1-2013:p0979:b003:l033","ordinal":150854,"en":"No man went boldly before her;"},{"id":"semetey-1-2013:p0979:b003:l034","ordinal":150855,"en":"Whoever saw the cherished woman marveled."},{"id":"semetey-1-2013:p0979:b003:l035","ordinal":150856,"en":"No stranger entered her chamber,"},{"id":"semetey-1-2013:p0979:b003:l036","ordinal":150857,"en":"And no soul apart from Semetey"},{"id":"semetey-1-2013:p0979:b003:l037","ordinal":150858,"en":"Walked openly beside her."},{"id":"semetey-1-2013:p0979:b003:l038","ordinal":150859,"en":"Her brow was high and her venom strong—"},{"id":"semetey-1-2013:p0979:b003:l039","ordinal":150860,"en":"Do not ask about your sister-in-law’s nature."},{"id":"semetey-1-2013:p0979:b005:l001","ordinal":150861,"en":"This was one of those dark days,"},{"id":"semetey-1-2013:p0979:b005:l002","ordinal":150862,"en":"The day when her true fury was touched"},{"id":"semetey-1-2013:p0979:b005:l003","ordinal":150863,"en":"And she poured out her wrath."},{"id":"semetey-1-2013:p0979:b005:l004","ordinal":150864,"en":"No traveler came to her,"},{"id":"semetey-1-2013:p0979:b005:l005","ordinal":150865,"en":"And she received no news from me;"},{"id":"semetey-1-2013:p0979:b005:l006","ordinal":150866,"en":"This was one of those dark days."},{"id":"semetey-1-2013:p0979:b005:l007","ordinal":150867,"en":"Beside Chachykey were"},{"id":"semetey-1-2013:p0979:b005:l008","ordinal":150868,"en":"Thirty daughters-in-law and thirty girls,"},{"id":"semetey-1-2013:p0979:b005:l009","ordinal":150869,"en":"A retinue of no small splendor,"},{"id":"semetey-1-2013:p0979:b005:l010","ordinal":150870,"en":"Her attendants gathered for amusement."},{"id":"semetey-1-2013:p0979:b005:l011","ordinal":150871,"en":"Around their throats hung"},{"id":"semetey-1-2013:p0979:b005:l012","ordinal":150872,"en":"Golden earrings and amulets;"},{"id":"semetey-1-2013:p0979:b005:l013","ordinal":150873,"en":"All were stately and beautiful young women."},{"id":"semetey-1-2013:p0979:b005:l014","ordinal":150874,"en":"Semetey had a tower,"},{"id":"semetey-1-2013:p0979:b005:l015","ordinal":150875,"en":"And from the top of that tower"},{"id":"semetey-1-2013:p0979:b005:l016","ordinal":150876,"en":"Your poor sister-in-law Chachykey"},{"id":"semetey-1-2013:p0979:b005:l017","ordinal":150877,"en":"Stood keeping watch."},{"id":"semetey-1-2013:p0979:b005:l018","ordinal":150878,"en":"Realizing that Semetey was absent,"},{"id":"semetey-1-2013:p0979:b005:l019","ordinal":150879,"en":"She cried out wildly—"},{"id":"semetey-1-2013:p0979:b005:l020","ordinal":150880,"en":"God had struck the woman."},{"id":"semetey-1-2013:p0979:b005:l021","ordinal":150881,"en":"Chachykey’s forty daughters-in-law,"},{"id":"semetey-1-2013:p0979:b005:l022","ordinal":150882,"en":"All of them skilled women,"},{"id":"semetey-1-2013:p0979:b005:l023","ordinal":150883,"en":"Stood surrounding her."},{"id":"semetey-1-2013:p0979:b005:l024","ordinal":150884,"en":"Now God had struck the woman;"},{"id":"semetey-1-2013:p0979:b005:l025","ordinal":150885,"en":"The delicate Chachykey"},{"id":"semetey-1-2013:p0979:b005:l026","ordinal":150886,"en":"Spoke to the daughters-in-law:"},{"id":"semetey-1-2013:p0979:b005:l027","ordinal":150887,"en":"“The end time has surely come!"},{"id":"semetey-1-2013:p0979:b005:l028","ordinal":150888,"en":"Some accursed man seeking a master"},{"id":"semetey-1-2013:p0979:b005:l029","ordinal":150889,"en":"Must have taken away"},{"id":"semetey-1-2013:p0979:b005:l030","ordinal":150890,"en":"Badisha’s falcon.”"},{"id":"semetey-1-2013:p0979:b005:l031","ordinal":150891,"en":"Grieving when she saw the boys,"},{"id":"semetey-1-2013:p0979:b005:l032","ordinal":150892,"en":"The delicate woman Chachykey"},{"id":"semetey-1-2013:p0979:b005:l033","ordinal":150893,"en":"Rushed down from the tower"},{"id":"semetey-1-2013:p0979:b005:l034","ordinal":150894,"en":"And came hurtling below."},{"id":"semetey-1-2013:p0979:b005:l035","ordinal":150895,"en":"“The accursed thing has led him astray"},{"id":"semetey-1-2013:p0979:b005:l036","ordinal":150896,"en":"And taken it in the end,” she said."},{"id":"semetey-1-2013:p0979:b005:l037","ordinal":150897,"en":"Her dear eyes, like a quail’s,"},{"id":"semetey-1-2013:p0979:b005:l038","ordinal":150898,"en":"Shed tears in separate streams;"},{"id":"semetey-1-2013:p0979:b005:l039","ordinal":150899,"en":"She sobbed and wept uncontrollably,"},{"id":"semetey-1-2013:p0980:b003:l001","ordinal":150900,"en":"She sobbed beyond measure."},{"id":"semetey-1-2013:p0980:b003:l002","ordinal":150901,"en":"Her attendants beside her,"},{"id":"semetey-1-2013:p0980:b003:l003","ordinal":150902,"en":"Chachykey’s forty daughters-in-law,"},{"id":"semetey-1-2013:p0980:b003:l004","ordinal":150903,"en":"Girls and married women mingled together—"},{"id":"semetey-1-2013:p0980:b003:l005","ordinal":150904,"en":"Among those women"},{"id":"semetey-1-2013:p0980:b003:l006","ordinal":150905,"en":"There was every kind and none lacking:"},{"id":"semetey-1-2013:p0980:b003:l007","ordinal":150906,"en":"Some had handspan waists and moonlike faces,"},{"id":"semetey-1-2013:p0980:b003:l008","ordinal":150907,"en":"Some were radiant beauties,"},{"id":"semetey-1-2013:p0980:b003:l009","ordinal":150908,"en":"Some spoke words sweet as honey,"},{"id":"semetey-1-2013:p0980:b003:l010","ordinal":150909,"en":"Some had wide, fawn-like eyes,"},{"id":"semetey-1-2013:p0980:b003:l011","ordinal":150910,"en":"Some had black hair like meadow grass,"},{"id":"semetey-1-2013:p0980:b003:l012","ordinal":150911,"en":"And some had finely drawn black brows."},{"id":"semetey-1-2013:p0980:b003:l013","ordinal":150912,"en":"Your imperious sister-in-law Chachykey"},{"id":"semetey-1-2013:p0980:b003:l014","ordinal":150913,"en":"Moved with an extraordinary bearing."},{"id":"semetey-1-2013:p0980:b003:l015","ordinal":150914,"en":"Her attendants beside her"},{"id":"semetey-1-2013:p0980:b003:l016","ordinal":150915,"en":"Would not let her feet touch the ground;"},{"id":"semetey-1-2013:p0980:b003:l017","ordinal":150916,"en":"They spread Semetey’s great carpet"},{"id":"semetey-1-2013:p0980:b003:l018","ordinal":150917,"en":"Upon the black earth,"},{"id":"semetey-1-2013:p0980:b003:l019","ordinal":150918,"en":"And would not let her tread God’s bare ground."},{"id":"semetey-1-2013:p0980:b003:l020","ordinal":150919,"en":"The imperious woman Chachykey"},{"id":"semetey-1-2013:p0980:b003:l021","ordinal":150920,"en":"Approached the gated fortress"},{"id":"semetey-1-2013:p0980:b003:l022","ordinal":150921,"en":"And filed inside;"},{"id":"semetey-1-2013:p0980:b003:l023","ordinal":150922,"en":"The boys had not yet arrived from the field."},{"id":"semetey-1-2013:p0980:b003:l024","ordinal":150923,"en":"Kulchoro and Kanchoro"},{"id":"semetey-1-2013:p0980:b003:l025","ordinal":150924,"en":"Could not retreat after hearing her words,"},{"id":"semetey-1-2013:p0980:b003:l026","ordinal":150925,"en":"Nor tell the broad-backed wretch"},{"id":"semetey-1-2013:p0980:b003:l027","ordinal":150926,"en":"What had become of the falcon."},{"id":"semetey-1-2013:p0980:b003:l028","ordinal":150927,"en":"They could not endure"},{"id":"semetey-1-2013:p0980:b003:l029","ordinal":150928,"en":"The heat of that truly formidable woman,"},{"id":"semetey-1-2013:p0980:b003:l030","ordinal":150929,"en":"Could not go before her and speak,"},{"id":"semetey-1-2013:p0980:b003:l031","ordinal":150930,"en":"Yet could not turn back without entering."},{"id":"semetey-1-2013:p0980:b003:l032","ordinal":150931,"en":"The twin choros"},{"id":"semetey-1-2013:p0980:b003:l033","ordinal":150932,"en":"Stood taking counsel,"},{"id":"semetey-1-2013:p0980:b003:l034","ordinal":150933,"en":"Shaped their words carefully,"},{"id":"semetey-1-2013:p0980:b003:l035","ordinal":150934,"en":"And neither would yield to the other."},{"id":"semetey-1-2013:p0980:b003:l036","ordinal":150935,"en":"Unable to enter the encampment"},{"id":"semetey-1-2013:p0980:b003:l037","ordinal":150936,"en":"Of the woman whose wrath was fierce,"},{"id":"semetey-1-2013:p0980:b003:l038","ordinal":150937,"en":"Unable to meet her or withdraw,"},{"id":"semetey-1-2013:p0980:b003:l039","ordinal":150938,"en":"They could not say,"},{"id":"semetey-1-2013:p0980:b004:l001","ordinal":150939,"en":"“We lost Akshunkar,”"},{"id":"semetey-1-2013:p0980:b004:l002","ordinal":150940,"en":"Or explain what had happened."},{"id":"semetey-1-2013:p0980:b004:l003","ordinal":150941,"en":"They stood braced together,"},{"id":"semetey-1-2013:p0980:b004:l004","ordinal":150942,"en":"Having brought this misery upon themselves."},{"id":"semetey-1-2013:p0980:b004:l005","ordinal":150943,"en":"Kanchoro, the son of Chubak, said:"},{"id":"semetey-1-2013:p0980:b004:l006","ordinal":150944,"en":"“Ah, my dear Kulchoro,"},{"id":"semetey-1-2013:p0980:b004:l007","ordinal":150945,"en":"Heed these words of mine, choro."},{"id":"semetey-1-2013:p0980:b004:l008","ordinal":150946,"en":"Go to your sister-in-law, choro,"},{"id":"semetey-1-2013:p0980:b004:l009","ordinal":150947,"en":"And tell her plainly,"},{"id":"semetey-1-2013:p0980:b004:l010","ordinal":150948,"en":"‘We have lost Akshunkar!’"},{"id":"semetey-1-2013:p0980:b004:l011","ordinal":150949,"en":"Ask whether she knows the falcon,"},{"id":"semetey-1-2013:p0980:b004:l012","ordinal":150950,"en":"And learn where she thinks it may be."},{"id":"semetey-1-2013:p0980:b004:l013","ordinal":150951,"en":"You have a gentle face and fluent tongue,"},{"id":"semetey-1-2013:p0980:b004:l014","ordinal":150952,"en":"And were always a man who did not misspeak."},{"id":"semetey-1-2013:p0980:b004:l015","ordinal":150953,"en":"You are a nimble orator and quick thinker,"},{"id":"semetey-1-2013:p0980:b004:l016","ordinal":150954,"en":"A boy accomplished in speech,"},{"id":"semetey-1-2013:p0980:b004:l017","ordinal":150955,"en":"One who could always find a way with words."},{"id":"semetey-1-2013:p0980:b004:l018","ordinal":150956,"en":"Go to your sister-in-law."},{"id":"semetey-1-2013:p0980:b004:l019","ordinal":150957,"en":"Ask whether she knows of the falcon,"},{"id":"semetey-1-2013:p0980:b004:l020","ordinal":150958,"en":"And approach her with tactful words."},{"id":"semetey-1-2013:p0980:b004:l021","ordinal":150959,"en":"Whether she knows or does not,"},{"id":"semetey-1-2013:p0980:b004:l022","ordinal":150960,"en":"You are a man, my choro—go."},{"id":"semetey-1-2013:p0980:b004:l023","ordinal":150961,"en":"To that devilish woman,"},{"id":"semetey-1-2013:p0980:b004:l024","ordinal":150962,"en":"That impetuous wretch,"},{"id":"semetey-1-2013:p0980:b004:l025","ordinal":150963,"en":"My Kulchoro, go."},{"id":"semetey-1-2013:p0980:b004:l026","ordinal":150964,"en":"Tell her what followed Akshunkar;"},{"id":"semetey-1-2013:p0980:b004:l027","ordinal":150965,"en":"Tell of the suffering that befell it"},{"id":"semetey-1-2013:p0980:b004:l028","ordinal":150966,"en":"Along the shore of Ala-Köl."},{"id":"semetey-1-2013:p0980:b004:l029","ordinal":150967,"en":"She who has licked the edge of a sword—"},{"id":"semetey-1-2013:p0980:b004:l030","ordinal":150968,"en":"If she tells where the falcon is,"},{"id":"semetey-1-2013:p0980:b004:l031","ordinal":150969,"en":"Tell her of your magnanimous lord’s pain!”"},{"id":"semetey-1-2013:p0980:b004:l032","ordinal":150970,"en":"While Kanchoro spoke,"},{"id":"semetey-1-2013:p0980:b004:l033","ordinal":150971,"en":"“Very well, elder, very well,” he said,"},{"id":"semetey-1-2013:p0980:b004:l034","ordinal":150972,"en":"Bending his knee to the ground."},{"id":"semetey-1-2013:p0980:b004:l035","ordinal":150973,"en":"From atop Akborchuk"},{"id":"semetey-1-2013:p0980:b004:l036","ordinal":150974,"en":"He ran down at speed,"},{"id":"semetey-1-2013:p0980:b004:l037","ordinal":150975,"en":"And Kulchoro flew like an arrow,"},{"id":"semetey-1-2013:p0980:b004:l038","ordinal":150976,"en":"Looking to either side"},{"id":"semetey-1-2013:p0980:b004:l039","ordinal":150977,"en":"And licking his lips."},{"id":"semetey-1-2013:p0981:b003:l001","ordinal":150978,"en":"Almambet’s only son"},{"id":"semetey-1-2013:p0981:b003:l002","ordinal":150979,"en":"Was broad across the right shoulder,"},{"id":"semetey-1-2013:p0981:b003:l003","ordinal":150980,"en":"A lion who came from Ogoi,"},{"id":"semetey-1-2013:p0981:b003:l004","ordinal":150981,"en":"Thick-armed and stone-hearted,"},{"id":"semetey-1-2013:p0981:b003:l005","ordinal":150982,"en":"Exceedingly handsome and also a lion,"},{"id":"semetey-1-2013:p0981:b003:l006","ordinal":150983,"en":"A sturdy man of every limb."},{"id":"semetey-1-2013:p0981:b003:l007","ordinal":150984,"en":"He hung his blue sword at his side;"},{"id":"semetey-1-2013:p0981:b003:l008","ordinal":150985,"en":"If you had seen Kulchoro,"},{"id":"semetey-1-2013:p0981:b003:l009","ordinal":150986,"en":"He raged like a blue tiger."},{"id":"semetey-1-2013:p0981:b003:l010","ordinal":150987,"en":"The sight of him divided one’s thoughts;"},{"id":"semetey-1-2013:p0981:b003:l011","ordinal":150988,"en":"Now he plainly reached"},{"id":"semetey-1-2013:p0981:b003:l012","ordinal":150989,"en":"The utterly spoiled beauty."},{"id":"semetey-1-2013:p0981:b003:l013","ordinal":150990,"en":"Before that excitable wretch,"},{"id":"semetey-1-2013:p0981:b003:l014","ordinal":150991,"en":"That exceedingly pampered woman,"},{"id":"semetey-1-2013:p0981:b003:l015","ordinal":150992,"en":"He came crying and ready,"},{"id":"semetey-1-2013:p0981:b003:l016","ordinal":150993,"en":"Swaying as though struck from this side."},{"id":"semetey-1-2013:p0981:b003:l017","ordinal":150994,"en":"Before the stubborn, spoiled wretch,"},{"id":"semetey-1-2013:p0981:b003:l018","ordinal":150995,"en":"Before the boy could speak to her face,"},{"id":"semetey-1-2013:p0981:b003:l019","ordinal":150996,"en":"Your grieving, delicate sister-in-law"},{"id":"semetey-1-2013:p0981:b003:l020","ordinal":150997,"en":"Pranced like a spirited horse,"},{"id":"semetey-1-2013:p0981:b003:l021","ordinal":150998,"en":"And began speaking first,"},{"id":"semetey-1-2013:p0981:b003:l022","ordinal":150999,"en":"Voicing her words slowly and firmly:"},{"id":"semetey-1-2013:p0981:b003:l023","ordinal":151000,"en":"“Your unruly elder Semetey—"},{"id":"semetey-1-2013:p0981:b003:l024","ordinal":151001,"en":"Is that wild man safe and well?"},{"id":"semetey-1-2013:p0981:b003:l025","ordinal":151002,"en":"Is the tulpar beneath him"},{"id":"semetey-1-2013:p0981:b003:l026","ordinal":151003,"en":"Safe and sound,"},{"id":"semetey-1-2013:p0981:b003:l027","ordinal":151004,"en":"And the falcon upon his hand?”"},{"id":"semetey-1-2013:p0981:b003:l028","ordinal":151005,"en":"When your sister-in-law said this,"},{"id":"semetey-1-2013:p0981:b003:l029","ordinal":151006,"en":"The choro stood and replied:"},{"id":"semetey-1-2013:p0981:b003:l030","ordinal":151007,"en":"“Noble sister-in-law Chachykey!"},{"id":"semetey-1-2013:p0981:b003:l031","ordinal":151008,"en":"Your hardship has passed,"},{"id":"semetey-1-2013:p0981:b003:l032","ordinal":151009,"en":"And your fortune has overflowed."},{"id":"semetey-1-2013:p0981:b003:l033","ordinal":151010,"en":"Tell where the sword fits its sheath;"},{"id":"semetey-1-2013:p0981:b003:l034","ordinal":151011,"en":"Sister blessed by Kydyr,"},{"id":"semetey-1-2013:p0981:b003:l035","ordinal":151012,"en":"This time tell the truth!"},{"id":"semetey-1-2013:p0981:b003:l036","ordinal":151013,"en":"Think and tell of every kind"},{"id":"semetey-1-2013:p0981:b003:l037","ordinal":151014,"en":"Of suffering and death."},{"id":"semetey-1-2013:p0981:b003:l038","ordinal":151015,"en":"If you possess knowledge, sister-in-law,"},{"id":"semetey-1-2013:p0981:b003:l039","ordinal":151016,"en":"Leave nothing out when you speak."},{"id":"semetey-1-2013:p0981:b004:l001","ordinal":151017,"en":"We opened tireless Buurul’s stride;"},{"id":"semetey-1-2013:p0981:b004:l002","ordinal":151018,"en":"Along the shore of Ala-Köl"},{"id":"semetey-1-2013:p0981:b004:l003","ordinal":151019,"en":"We lost Akshunkar!"},{"id":"semetey-1-2013:p0981:b004:l004","ordinal":151020,"en":"We heard words from men of counsel:"},{"id":"semetey-1-2013:p0981:b004:l005","ordinal":151021,"en":"Unless you refuse out of obstinacy,"},{"id":"semetey-1-2013:p0981:b004:l006","ordinal":151022,"en":"We heard that you would know."},{"id":"semetey-1-2013:p0981:b004:l007","ordinal":151023,"en":"My elder Semetey,"},{"id":"semetey-1-2013:p0981:b004:l008","ordinal":151024,"en":"If you tell us of the falcon,"},{"id":"semetey-1-2013:p0981:b004:l009","ordinal":151025,"en":"He will say neither this nor that,"},{"id":"semetey-1-2013:p0981:b004:l010","ordinal":151026,"en":"Will not raise his whip against you,"},{"id":"semetey-1-2013:p0981:b004:l011","ordinal":151027,"en":"And will not take another wife after you."},{"id":"semetey-1-2013:p0981:b004:l012","ordinal":151028,"en":"Made an extraordinary promise;"},{"id":"semetey-1-2013:p0981:b004:l013","ordinal":151029,"en":"Tell me, sister-in-law, what does this mean?”"},{"id":"semetey-1-2013:p0981:b004:l014","ordinal":151030,"en":"When the boy had said this,"},{"id":"semetey-1-2013:p0981:b004:l015","ordinal":151031,"en":"Semetey’s wayward, pampered wife"},{"id":"semetey-1-2013:p0981:b004:l016","ordinal":151032,"en":"Burst into a frenzy:"},{"id":"semetey-1-2013:p0981:b004:l017","ordinal":151033,"en":"“Shame, shame upon your face!"},{"id":"semetey-1-2013:p0981:b004:l018","ordinal":151034,"en":"You have spoken cold, ugly words."},{"id":"semetey-1-2013:p0981:b004:l019","ordinal":151035,"en":"The man in the field"},{"id":"semetey-1-2013:p0981:b004:l020","ordinal":151036,"en":"Has business with his bird;"},{"id":"semetey-1-2013:p0981:b004:l021","ordinal":151037,"en":"The woman inside the house"},{"id":"semetey-1-2013:p0981:b004:l022","ordinal":151038,"en":"Has business with her food."},{"id":"semetey-1-2013:p0981:b004:l023","ordinal":151039,"en":"As for the falcon that was lost,"},{"id":"semetey-1-2013:p0981:b004:l024","ordinal":151040,"en":"What business could"}]
