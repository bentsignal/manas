[{"id":"semetey-1-2013:p0784:b003:l026","ordinal":136961,"en":"Have you understood that billowing dust?"},{"id":"semetey-1-2013:p0784:b003:l027","ordinal":136962,"en":"When I look ahead of the dust,"},{"id":"semetey-1-2013:p0784:b003:l028","ordinal":136963,"en":"My heart grows tender and troubled:"},{"id":"semetey-1-2013:p0784:b003:l029","ordinal":136964,"en":"Your horse Narbuurul comes into view."},{"id":"semetey-1-2013:p0784:b003:l030","ordinal":136965,"en":"When leopard Manas died,"},{"id":"semetey-1-2013:p0784:b003:l031","ordinal":136966,"en":"When the bereft one knew grief,"},{"id":"semetey-1-2013:p0784:b003:l032","ordinal":136967,"en":"Mourning and wailing,"},{"id":"semetey-1-2013:p0784:b003:l033","ordinal":136968,"en":"Crying loudly in torment,"},{"id":"semetey-1-2013:p0784:b003:l034","ordinal":136969,"en":"Neighing and pawing the ground,"},{"id":"semetey-1-2013:p0784:b003:l035","ordinal":136970,"en":"Though an animal, that living creature,"},{"id":"semetey-1-2013:p0784:b003:l036","ordinal":136971,"en":"His tail and mane disheveled,"},{"id":"semetey-1-2013:p0784:b003:l037","ordinal":136972,"en":"The tears pouring from his eyes,"},{"id":"semetey-1-2013:p0784:b003:l038","ordinal":136973,"en":"Roamed the mountaintops,"},{"id":"semetey-1-2013:p0784:b003:l039","ordinal":136974,"en":"Wandered among the sacred graves."},{"id":"semetey-1-2013:p0784:b004:l001","ordinal":136975,"en":"Unknown to any person,"},{"id":"semetey-1-2013:p0784:b004:l002","ordinal":136976,"en":"Unseen by anyone,"},{"id":"semetey-1-2013:p0784:b004:l003","ordinal":136977,"en":"Leading eighty swift horses,"},{"id":"semetey-1-2013:p0784:b004:l004","ordinal":136978,"en":"Narbuudan vanished."},{"id":"semetey-1-2013:p0784:b004:l005","ordinal":136979,"en":"In this manner Narbuudan"},{"id":"semetey-1-2013:p0784:b004:l006","ordinal":136980,"en":"Attained his desire."},{"id":"semetey-1-2013:p0784:b004:l007","ordinal":136981,"en":"Vanishing from sight,"},{"id":"semetey-1-2013:p0784:b004:l008","ordinal":136982,"en":"Narbuudan went away."},{"id":"semetey-1-2013:p0784:b004:l009","ordinal":136983,"en":"He drove away any foal that came,"},{"id":"semetey-1-2013:p0784:b004:l010","ordinal":136984,"en":"Sought ridges covered in fescue,"},{"id":"semetey-1-2013:p0784:b004:l011","ordinal":136985,"en":"Sought places no mortal could travel."},{"id":"semetey-1-2013:p0784:b004:l012","ordinal":136986,"en":"In the hottest days of summer"},{"id":"semetey-1-2013:p0784:b004:l013","ordinal":136987,"en":"He stayed on the mountaintops,"},{"id":"semetey-1-2013:p0784:b004:l014","ordinal":136988,"en":"Grazed at Toguz-Döbö."},{"id":"semetey-1-2013:p0784:b004:l015","ordinal":136989,"en":"As autumn approached,"},{"id":"semetey-1-2013:p0784:b004:l016","ordinal":136990,"en":"When the grass reached its full strength,"},{"id":"semetey-1-2013:p0784:b004:l017","ordinal":136991,"en":"When the supple grass ripened,"},{"id":"semetey-1-2013:p0784:b004:l018","ordinal":136992,"en":"When autumn gossamer flew,"},{"id":"semetey-1-2013:p0784:b004:l019","ordinal":136993,"en":"The splendid steed Narbuurul"},{"id":"semetey-1-2013:p0784:b004:l020","ordinal":136994,"en":"Stayed at Jyltyrgan,"},{"id":"semetey-1-2013:p0784:b004:l021","ordinal":136995,"en":"And grazed on tumbleweed."},{"id":"semetey-1-2013:p0784:b004:l022","ordinal":136996,"en":"As winter approached,"},{"id":"semetey-1-2013:p0784:b004:l023","ordinal":136997,"en":"When the ground froze hard,"},{"id":"semetey-1-2013:p0784:b004:l024","ordinal":136998,"en":"When springs bubbled and ice froze,"},{"id":"semetey-1-2013:p0784:b004:l025","ordinal":136999,"en":"Swaying across the hills,"},{"id":"semetey-1-2013:p0784:b004:l026","ordinal":137000,"en":"When bitterly cold winds blew,"},{"id":"semetey-1-2013:p0784:b004:l027","ordinal":137001,"en":"When the deep winter creaked with frost,"},{"id":"semetey-1-2013:p0784:b004:l028","ordinal":137002,"en":"When the cold reached its cracking height,"},{"id":"semetey-1-2013:p0784:b004:l029","ordinal":137003,"en":"He stayed upon the open plains,"},{"id":"semetey-1-2013:p0784:b004:l030","ordinal":137004,"en":"And grazed on fescue."},{"id":"semetey-1-2013:p0784:b004:l031","ordinal":137005,"en":"At the sight of a figure he darted away."},{"id":"semetey-1-2013:p0784:b004:l032","ordinal":137006,"en":"He must have known you would come this year;"},{"id":"semetey-1-2013:p0784:b004:l033","ordinal":137007,"en":"To Suurma-Kök in Suusamyr,"},{"id":"semetey-1-2013:p0784:b004:l034","ordinal":137008,"en":"To Suurma-Kök he has come."},{"id":"semetey-1-2013:p0784:b004:l035","ordinal":137009,"en":"From the slaughtered horse"},{"id":"semetey-1-2013:p0784:b004:l036","ordinal":137010,"en":"He had been wandering in distress,"},{"id":"semetey-1-2013:p0784:b004:l037","ordinal":137011,"en":"Saying, ‘My protector, the orphan, will come,’"},{"id":"semetey-1-2013:p0784:b004:l038","ordinal":137012,"en":"He had been waiting to meet you."},{"id":"semetey-1-2013:p0784:b004:l039","ordinal":137013,"en":"If you would ride, that is the horse;"},{"id":"semetey-1-2013:p0785:b003:l001","ordinal":137014,"en":"High-backed, yet low in stature,"},{"id":"semetey-1-2013:p0785:b003:l002","ordinal":137015,"en":"A dark Karabair, a battle steed,"},{"id":"semetey-1-2013:p0785:b003:l003","ordinal":137016,"en":"With sieve-like lungs and copper forelegs."},{"id":"semetey-1-2013:p0785:b003:l004","ordinal":137017,"en":"The space between his hind thighs like a ravine,"},{"id":"semetey-1-2013:p0785:b003:l005","ordinal":137018,"en":"His white front teeth"},{"id":"semetey-1-2013:p0785:b003:l006","ordinal":137019,"en":"Like tempered steel,"},{"id":"semetey-1-2013:p0785:b003:l007","ordinal":137020,"en":"His arms were longer than plane trees."},{"id":"semetey-1-2013:p0785:b003:l008","ordinal":137021,"en":"Though he traveled six months without rest,"},{"id":"semetey-1-2013:p0785:b003:l009","ordinal":137022,"en":"His back and head would not grow sore."},{"id":"semetey-1-2013:p0785:b003:l010","ordinal":137023,"en":"He did not panic at a battle cry;"},{"id":"semetey-1-2013:p0785:b003:l011","ordinal":137024,"en":"In the moon's darkness"},{"id":"semetey-1-2013:p0785:b003:l012","ordinal":137025,"en":"He never misplaced a step."},{"id":"semetey-1-2013:p0785:b003:l013","ordinal":137026,"en":"Alas, while your father was alive,"},{"id":"semetey-1-2013:p0785:b003:l014","ordinal":137027,"en":"He had deer drag his lead-rope."},{"id":"semetey-1-2013:p0785:b003:l015","ordinal":137028,"en":"That the hand will be bronze*,"},{"id":"semetey-1-2013:p0785:b003:l016","ordinal":137029,"en":"Wherever the ground was rough and hilly,"},{"id":"semetey-1-2013:p0785:b003:l017","ordinal":137030,"en":"He took him there to train him."},{"id":"semetey-1-2013:p0785:b003:l018","ordinal":137031,"en":"He never panicked in the tumult;"},{"id":"semetey-1-2013:p0785:b003:l019","ordinal":137032,"en":"Stumbled,"},{"id":"semetey-1-2013:p0785:b003:l020","ordinal":137033,"en":"In the moon's darkness"},{"id":"semetey-1-2013:p0785:b003:l021","ordinal":137034,"en":"He never set a foot wrong."},{"id":"semetey-1-2013:p0785:b003:l022","ordinal":137035,"en":"Camel-forelocked, short-maned,"},{"id":"semetey-1-2013:p0785:b003:l023","ordinal":137036,"en":"A deep-ribbed battle steed."},{"id":"semetey-1-2013:p0785:b003:l024","ordinal":137037,"en":"No wild ass he chased could escape;"},{"id":"semetey-1-2013:p0785:b003:l025","ordinal":137038,"en":"No overgrown frog within his hoof,"},{"id":"semetey-1-2013:p0785:b003:l026","ordinal":137039,"en":"A true noble steed, that creature."},{"id":"semetey-1-2013:p0785:b003:l027","ordinal":137040,"en":"Far above Algara,"},{"id":"semetey-1-2013:p0785:b003:l028","ordinal":137041,"en":"Far above Akkula,"},{"id":"semetey-1-2013:p0785:b003:l029","ordinal":137042,"en":"Much higher than Kuukazyk,"},{"id":"semetey-1-2013:p0785:b003:l030","ordinal":137043,"en":"Higher still than Maaniker,"},{"id":"semetey-1-2013:p0785:b003:l031","ordinal":137044,"en":"Far above Chalkuiruk."},{"id":"semetey-1-2013:p0785:b003:l032","ordinal":137045,"en":"If you reach him and ride, my orphan,"},{"id":"semetey-1-2013:p0785:b003:l033","ordinal":137046,"en":"That is a thoroughly swift horse."},{"id":"semetey-1-2013:p0785:b003:l034","ordinal":137047,"en":"A cloud cannot be caught in the sky;"},{"id":"semetey-1-2013:p0785:b003:l035","ordinal":137048,"en":"No four-footed creature"},{"id":"semetey-1-2013:p0785:b003:l036","ordinal":137049,"en":"Can flee and escape him."},{"id":"semetey-1-2013:p0785:b003:l037","ordinal":137050,"en":"If you ride him, he is well-tried,"},{"id":"semetey-1-2013:p0785:b003:l038","ordinal":137051,"en":"A support left by your father Manas;"},{"id":"semetey-1-2013:p0785:b003:l039","ordinal":137052,"en":"The sight of him moves the heart."},{"id":"semetey-1-2013:p0785:b005:l001","ordinal":137053,"en":"That creature, Buurul,"},{"id":"semetey-1-2013:p0785:b005:l002","ordinal":137054,"en":"Seems to have come out to meet you."},{"id":"semetey-1-2013:p0785:b005:l003","ordinal":137055,"en":"‘Twelve years have passed,’ he says,"},{"id":"semetey-1-2013:p0785:b005:l004","ordinal":137056,"en":"‘This year my dear companion will ride me to war;"},{"id":"semetey-1-2013:p0785:b005:l005","ordinal":137057,"en":"It is time for him to come,’ he says,"},{"id":"semetey-1-2013:p0785:b005:l006","ordinal":137058,"en":"And has been waiting to meet you."},{"id":"semetey-1-2013:p0785:b005:l007","ordinal":137059,"en":"Before the boy,"},{"id":"semetey-1-2013:p0785:b005:l008","ordinal":137060,"en":"The red-roan, short-maned horse,"},{"id":"semetey-1-2013:p0785:b005:l009","ordinal":137061,"en":"The precious steed Narbuurul,"},{"id":"semetey-1-2013:p0785:b005:l010","ordinal":137062,"en":"Flung his forelock toward the sky;"},{"id":"semetey-1-2013:p0785:b005:l011","ordinal":137063,"en":"The crust of the dark earth"},{"id":"semetey-1-2013:p0785:b005:l012","ordinal":137064,"en":"He pawed and tossed away."},{"id":"semetey-1-2013:p0785:b005:l013","ordinal":137065,"en":"His tail and mane disheveled,"},{"id":"semetey-1-2013:p0785:b005:l014","ordinal":137066,"en":"Tears pouring from his eyes,"},{"id":"semetey-1-2013:p0785:b005:l015","ordinal":137067,"en":"He had no tongue to speak."},{"id":"semetey-1-2013:p0785:b005:l016","ordinal":137068,"en":"Though an animal, the horse Buurul"},{"id":"semetey-1-2013:p0785:b005:l017","ordinal":137069,"en":"Neighed and trembled,"},{"id":"semetey-1-2013:p0785:b005:l018","ordinal":137070,"en":"Drew in his belly and shook."},{"id":"semetey-1-2013:p0785:b005:l019","ordinal":137071,"en":"His ears stood like candles,"},{"id":"semetey-1-2013:p0785:b005:l020","ordinal":137072,"en":"Tears poured from his eyes."},{"id":"semetey-1-2013:p0785:b005:l021","ordinal":137073,"en":"His father, who had died long ago,"},{"id":"semetey-1-2013:p0785:b005:l022","ordinal":137074,"en":"Appeared before him like a vision."},{"id":"semetey-1-2013:p0785:b005:l023","ordinal":137075,"en":"A golden-cheeked battle-axe"},{"id":"semetey-1-2013:p0785:b005:l024","ordinal":137076,"en":"Your orphan, the son of Manas,"},{"id":"semetey-1-2013:p0785:b005:l025","ordinal":137077,"en":"Against his right side,"},{"id":"semetey-1-2013:p0785:b005:l026","ordinal":137078,"en":"Wept, ‘My mighty father!’"},{"id":"semetey-1-2013:p0785:b005:l027","ordinal":137079,"en":"And raised a wailing cry."},{"id":"semetey-1-2013:p0785:b005:l028","ordinal":137080,"en":"When he saw the horse Buurul,"},{"id":"semetey-1-2013:p0785:b005:l029","ordinal":137081,"en":"‘My fleet-footed father, do not die!’"},{"id":"semetey-1-2013:p0785:b005:l030","ordinal":137082,"en":"Your boy sobbed in bitter grief."},{"id":"semetey-1-2013:p0785:b005:l031","ordinal":137083,"en":"‘When my fleet-footed father died,"},{"id":"semetey-1-2013:p0785:b005:l032","ordinal":137084,"en":"This animal kept mourning."},{"id":"semetey-1-2013:p0785:b005:l033","ordinal":137085,"en":"Yet I, a human, poor wretch,"},{"id":"semetey-1-2013:p0785:b005:l034","ordinal":137086,"en":"To Temirkan's city"},{"id":"semetey-1-2013:p0785:b005:l035","ordinal":137087,"en":"Wandered away in disgrace."},{"id":"semetey-1-2013:p0785:b005:l036","ordinal":137088,"en":"Do not leave your world to stagger;"},{"id":"semetey-1-2013:p0785:b005:l037","ordinal":137089,"en":"My ocean-like father, take it with you."},{"id":"semetey-1-2013:p0785:b005:l038","ordinal":137090,"en":"To Karakan's city"},{"id":"semetey-1-2013:p0785:b005:l039","ordinal":137091,"en":"I wandered away in disgrace."},{"id":"semetey-1-2013:p0786:b003:l001","ordinal":137092,"en":"You have left so much of your wealth to wander;"},{"id":"semetey-1-2013:p0786:b003:l002","ordinal":137093,"en":"My leopard father, take it with you!"},{"id":"semetey-1-2013:p0786:b003:l003","ordinal":137094,"en":"Leaving your child an orphan,"},{"id":"semetey-1-2013:p0786:b003:l004","ordinal":137095,"en":"Leaving your wife a widow,"},{"id":"semetey-1-2013:p0786:b003:l005","ordinal":137096,"en":"The desolate world lies in disgrace."},{"id":"semetey-1-2013:p0786:b003:l006","ordinal":137097,"en":"My dear horse Buurul,"},{"id":"semetey-1-2013:p0786:b003:l007","ordinal":137098,"en":"Twelve years without seeing my people—"},{"id":"semetey-1-2013:p0786:b003:l008","ordinal":137099,"en":"Is there a wretch like me?"},{"id":"semetey-1-2013:p0786:b003:l009","ordinal":137100,"en":"Twelve years without seeing your land—"},{"id":"semetey-1-2013:p0786:b003:l010","ordinal":137101,"en":"Is there a wretch like you?"},{"id":"semetey-1-2013:p0786:b003:l011","ordinal":137102,"en":"To Karakan's city,"},{"id":"semetey-1-2013:p0786:b003:l012","ordinal":137103,"en":"My dear horse Buurul,"},{"id":"semetey-1-2013:p0786:b003:l013","ordinal":137104,"en":"I, poor wretch, fled."},{"id":"semetey-1-2013:p0786:b003:l014","ordinal":137105,"en":"Chipping your hooves on the stones,"},{"id":"semetey-1-2013:p0786:b003:l015","ordinal":137106,"en":"Wondering, ‘When will my falcon come?’"},{"id":"semetey-1-2013:p0786:b003:l016","ordinal":137107,"en":"Though an animal, a living creature,"},{"id":"semetey-1-2013:p0786:b003:l017","ordinal":137108,"en":"You, poor wretch, wandered in anguish."},{"id":"semetey-1-2013:p0786:b003:l018","ordinal":137109,"en":"My kin became my enemies,"},{"id":"semetey-1-2013:p0786:b003:l019","ordinal":137110,"en":"My sorrow remained within me."},{"id":"semetey-1-2013:p0786:b003:l020","ordinal":137111,"en":"My dear horse Buurul,"},{"id":"semetey-1-2013:p0786:b003:l021","ordinal":137112,"en":"The place you fled to was a dark cliff;"},{"id":"semetey-1-2013:p0786:b003:l022","ordinal":137113,"en":"My own kin became my foes."},{"id":"semetey-1-2013:p0786:b003:l023","ordinal":137114,"en":"While I was still a babe in the cradle,"},{"id":"semetey-1-2013:p0786:b003:l024","ordinal":137115,"en":"Was made to learn his reckoning thus:"},{"id":"semetey-1-2013:p0786:b003:l025","ordinal":137116,"en":"My fierce mother Kanykei"},{"id":"semetey-1-2013:p0786:b003:l026","ordinal":137117,"en":"Had her breast slashed open."},{"id":"semetey-1-2013:p0786:b003:l027","ordinal":137118,"en":"To my grandfather Temir's city"},{"id":"semetey-1-2013:p0786:b003:l028","ordinal":137119,"en":"I, poor wretch, wandered away."},{"id":"semetey-1-2013:p0786:b003:l029","ordinal":137120,"en":"For twelve years,"},{"id":"semetey-1-2013:p0786:b003:l030","ordinal":137121,"en":"Unable to see the many herds,"},{"id":"semetey-1-2013:p0786:b003:l031","ordinal":137122,"en":"You, poor wretch, roamed in flight."},{"id":"semetey-1-2013:p0786:b003:l032","ordinal":137123,"en":"When my khan father died,"},{"id":"semetey-1-2013:p0786:b003:l033","ordinal":137124,"en":"My dear Narbuudan,"},{"id":"semetey-1-2013:p0786:b003:l034","ordinal":137125,"en":"Did you become known as a vanished horse?"},{"id":"semetey-1-2013:p0786:b003:l035","ordinal":137126,"en":"Did you fall into disgrace?"},{"id":"semetey-1-2013:p0786:b003:l036","ordinal":137127,"en":"My dear horse Buurul,"},{"id":"semetey-1-2013:p0786:b003:l037","ordinal":137128,"en":"For you, who remembered and came,"},{"id":"semetey-1-2013:p0786:b003:l038","ordinal":137129,"en":"May I be a sacrifice,"},{"id":"semetey-1-2013:p0786:b003:l039","ordinal":137130,"en":"For your two shining eyes."},{"id":"semetey-1-2013:p0786:b004:l001","ordinal":137131,"en":"Twisting his neck like a wild ass,"},{"id":"semetey-1-2013:p0786:b004:l002","ordinal":137132,"en":"Though an animal, horse Buurul,"},{"id":"semetey-1-2013:p0786:b004:l003","ordinal":137133,"en":"You are the swift steed left by my father."},{"id":"semetey-1-2013:p0786:b004:l004","ordinal":137134,"en":"Closer than my six elder kinsmen"},{"id":"semetey-1-2013:p0786:b004:l005","ordinal":137135,"en":"You stand to me."},{"id":"semetey-1-2013:p0786:b004:l006","ordinal":137136,"en":"My learning, my book of lessons,"},{"id":"semetey-1-2013:p0786:b004:l007","ordinal":137137,"en":"My support left by my father,"},{"id":"semetey-1-2013:p0786:b004:l008","ordinal":137138,"en":"My wings that fly without strain,"},{"id":"semetey-1-2013:p0786:b004:l009","ordinal":137139,"en":"My swift one, proven before the people,"},{"id":"semetey-1-2013:p0786:b004:l010","ordinal":137140,"en":"From my mighty father Manas,"},{"id":"semetey-1-2013:p0786:b004:l011","ordinal":137141,"en":"The support I have inherited."},{"id":"semetey-1-2013:p0786:b004:l012","ordinal":137142,"en":"The magnanimous lion who went to the other world"},{"id":"semetey-1-2013:p0786:b004:l013","ordinal":137143,"en":"Took thought for those left behind:"},{"id":"semetey-1-2013:p0786:b004:l014","ordinal":137144,"en":"‘My only son who remains after me,"},{"id":"semetey-1-2013:p0786:b004:l015","ordinal":137145,"en":"My dear Narbuudan,"},{"id":"semetey-1-2013:p0786:b004:l016","ordinal":137146,"en":"Let him ride you as his mount,’ he said."},{"id":"semetey-1-2013:p0786:b004:l017","ordinal":137147,"en":"When I think of my fierce father,"},{"id":"semetey-1-2013:p0786:b004:l018","ordinal":137148,"en":"Grief never leaves my breast."},{"id":"semetey-1-2013:p0786:b004:l019","ordinal":137149,"en":"For a swift steed like you, Taibuurul,"},{"id":"semetey-1-2013:p0786:b004:l020","ordinal":137150,"en":"May all my livestock be sacrificed!”"},{"id":"semetey-1-2013:p0786:b004:l021","ordinal":137151,"en":"Your orphan, the ocean's son,"},{"id":"semetey-1-2013:p0786:b004:l022","ordinal":137152,"en":"Without looking around,"},{"id":"semetey-1-2013:p0786:b004:l023","ordinal":137153,"en":"When he saw Taibuurul,"},{"id":"semetey-1-2013:p0786:b004:l024","ordinal":137154,"en":"Sparing himself nothing,"},{"id":"semetey-1-2013:p0786:b004:l025","ordinal":137155,"en":"As though God had granted his wish,"},{"id":"semetey-1-2013:p0786:b004:l026","ordinal":137156,"en":"As though his father Manas"},{"id":"semetey-1-2013:p0786:b004:l027","ordinal":137157,"en":"Had risen and come to life today,"},{"id":"semetey-1-2013:p0786:b004:l028","ordinal":137158,"en":"As he stood looking at Buurul,"},{"id":"semetey-1-2013:p0786:b004:l029","ordinal":137159,"en":"As though he had seen Manas,"},{"id":"semetey-1-2013:p0786:b004:l030","ordinal":137160,"en":"Buurul, that greatest of beasts,"},{"id":"semetey-1-2013:p0786:b004:l031","ordinal":137161,"en":"He clasped around the neck and sobbed,"},{"id":"semetey-1-2013:p0786:b004:l032","ordinal":137162,"en":"And breathed in the scent of his cheek."},{"id":"semetey-1-2013:p0786:b004:l033","ordinal":137163,"en":"Your orphan, the son of Manas,"},{"id":"semetey-1-2013:p0786:b004:l034","ordinal":137164,"en":"Raised a wailing cry."},{"id":"semetey-1-2013:p0786:b004:l035","ordinal":137165,"en":"His elder, old Bakai,"},{"id":"semetey-1-2013:p0786:b004:l036","ordinal":137166,"en":"The sorrowful sage,"},{"id":"semetey-1-2013:p0786:b004:l037","ordinal":137167,"en":"Parted from his twin companion,"},{"id":"semetey-1-2013:p0786:b004:l038","ordinal":137168,"en":"The sage who had been close to death,"},{"id":"semetey-1-2013:p0786:b004:l039","ordinal":137169,"en":"At seeing the horse Buurul,"},{"id":"semetey-1-2013:p0787:b003:l001","ordinal":137170,"en":"What could sorrowful Bakai do?"},{"id":"semetey-1-2013:p0787:b003:l002","ordinal":137171,"en":"As though he had seen his companion in grief,"},{"id":"semetey-1-2013:p0787:b003:l003","ordinal":137172,"en":"Prince Manas, who had died before,"},{"id":"semetey-1-2013:p0787:b003:l004","ordinal":137173,"en":"As though he had seen his old comrade,"},{"id":"semetey-1-2013:p0787:b003:l005","ordinal":137174,"en":"As though valiant Manas had risen"},{"id":"semetey-1-2013:p0787:b003:l006","ordinal":137175,"en":"And appeared before him today,"},{"id":"semetey-1-2013:p0787:b003:l007","ordinal":137176,"en":"What could your valiant Bakai do?"},{"id":"semetey-1-2013:p0787:b003:l008","ordinal":137177,"en":"Seeing Buurul, Khan Bakai"},{"id":"semetey-1-2013:p0787:b003:l009","ordinal":137178,"en":"Held his forelock and breathed in his scent,"},{"id":"semetey-1-2013:p0787:b003:l010","ordinal":137179,"en":"Snuffling, he breathed it in deeply."},{"id":"semetey-1-2013:p0787:b003:l011","ordinal":137180,"en":"Though Buurul was an animal,"},{"id":"semetey-1-2013:p0787:b003:l012","ordinal":137181,"en":"He wept, ‘He remains from my comrade.’"},{"id":"semetey-1-2013:p0787:b003:l013","ordinal":137182,"en":"The birches wept, the willows wept,"},{"id":"semetey-1-2013:p0787:b003:l014","ordinal":137183,"en":"Every living onlooker wept."},{"id":"semetey-1-2013:p0787:b003:l015","ordinal":137184,"en":"Bakai and Semetey"},{"id":"semetey-1-2013:p0787:b003:l016","ordinal":137185,"en":"Wept side by side in anguish."},{"id":"semetey-1-2013:p0787:b003:l017","ordinal":137186,"en":"The many horses left by Manas,"},{"id":"semetey-1-2013:p0787:b003:l018","ordinal":137187,"en":"As though they would trample them,"},{"id":"semetey-1-2013:p0787:b003:l019","ordinal":137188,"en":"Circled round and neighed."},{"id":"semetey-1-2013:p0787:b003:l020","ordinal":137189,"en":"Since God had granted this,"},{"id":"semetey-1-2013:p0787:b003:l021","ordinal":137190,"en":"Since Buurul had come himself,"},{"id":"semetey-1-2013:p0787:b003:l022","ordinal":137191,"en":"The white reins, plaited in round knots,"},{"id":"semetey-1-2013:p0787:b003:l023","ordinal":137192,"en":"Were left by your mighty Manas,"},{"id":"semetey-1-2013:p0787:b003:l024","ordinal":137193,"en":"Reins that fitted Akkula."},{"id":"semetey-1-2013:p0787:b003:l025","ordinal":137194,"en":"A mercenary murderer"},{"id":"semetey-1-2013:p0787:b003:l026","ordinal":137195,"en":"With a steel bit,"},{"id":"semetey-1-2013:p0787:b003:l027","ordinal":137196,"en":"The great bridle left by mighty Manas,"},{"id":"semetey-1-2013:p0787:b003:l028","ordinal":137197,"en":"Semetey, saying ‘In God's name,’"},{"id":"semetey-1-2013:p0787:b003:l029","ordinal":137198,"en":"Now fastened upon the horse Buurul."},{"id":"semetey-1-2013:p0787:b003:l030","ordinal":137199,"en":"Like the stars in the sky,"},{"id":"semetey-1-2013:p0787:b003:l031","ordinal":137200,"en":"They gathered together."},{"id":"semetey-1-2013:p0787:b003:l032","ordinal":137201,"en":"Animals and people united,"},{"id":"semetey-1-2013:p0787:b003:l033","ordinal":137202,"en":"They streamed together."},{"id":"semetey-1-2013:p0787:b003:l034","ordinal":137203,"en":"Like flour of white wheat,"},{"id":"semetey-1-2013:p0787:b003:l035","ordinal":137204,"en":"They mingled together."},{"id":"semetey-1-2013:p0787:b003:l036","ordinal":137205,"en":"Like the hair of a white antelope,"},{"id":"semetey-1-2013:p0787:b003:l037","ordinal":137206,"en":"They slipped free together."},{"id":"semetey-1-2013:p0787:b003:l038","ordinal":137207,"en":"Like strained curds mixed for food,"},{"id":"semetey-1-2013:p0787:b003:l039","ordinal":137208,"en":"They mingled together."},{"id":"semetey-1-2013:p0787:b005:l001","ordinal":137209,"en":"Before even that much time had passed,"},{"id":"semetey-1-2013:p0787:b005:l002","ordinal":137210,"en":"There was another marvel."},{"id":"semetey-1-2013:p0787:b005:l003","ordinal":137211,"en":"When the horse Buurul vanished,"},{"id":"semetey-1-2013:p0787:b005:l004","ordinal":137212,"en":"When he fled from this Talas,"},{"id":"semetey-1-2013:p0787:b005:l005","ordinal":137213,"en":"Leading eighty swift horses,"},{"id":"semetey-1-2013:p0787:b005:l006","ordinal":137214,"en":"Wandering the land,"},{"id":"semetey-1-2013:p0787:b005:l007","ordinal":137215,"en":"Then Kambarata and great Bozbee,"},{"id":"semetey-1-2013:p0787:b005:l008","ordinal":137216,"en":"Khan Manas's own livestock,"}]
