{"id": "sayakbay-ms-current146:pdf034:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 34, "folio": 417, "line_in_page": 29, "raw": "Кылча жери кем болбой,", "text": "Кылча жери кем болбой,", "en": "He fell short of them not by a hair,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
