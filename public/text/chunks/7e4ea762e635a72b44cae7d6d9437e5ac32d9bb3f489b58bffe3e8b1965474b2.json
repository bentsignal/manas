[{"id":"semetey-1-2013:p1048:b004:l034","ordinal":156161,"en":"They appeared like ravenous devourers."},{"id":"semetey-1-2013:p1048:b004:l035","ordinal":156162,"en":"The dense black Zhediger"},{"id":"semetey-1-2013:p1048:b004:l036","ordinal":156163,"en":"Separated into division after division,"},{"id":"semetey-1-2013:p1048:b004:l037","ordinal":156164,"en":"And split into distinct groups."},{"id":"semetey-1-2013:p1048:b004:l038","ordinal":156165,"en":"Upon the face of Bolbogur,"},{"id":"semetey-1-2013:p1048:b004:l039","ordinal":156166,"en":"At the edge rode one upon a gray horse,"},{"id":"semetey-1-2013:p1049:b003:l001","ordinal":156167,"en":"The bravest was at the front,"},{"id":"semetey-1-2013:p1049:b003:l002","ordinal":156168,"en":"And the black-horse rider at the edge."},{"id":"semetey-1-2013:p1049:b003:l003","ordinal":156169,"en":"All those bearing spears"},{"id":"semetey-1-2013:p1049:b003:l004","ordinal":156170,"en":"Rode ahead and separated;"},{"id":"semetey-1-2013:p1049:b003:l005","ordinal":156171,"en":"Champions who struck with battle-axes"},{"id":"semetey-1-2013:p1049:b003:l006","ordinal":156172,"en":"Appeared along either flank."},{"id":"semetey-1-2013:p1049:b003:l007","ordinal":156173,"en":"Those skilled at drawing bows,"},{"id":"semetey-1-2013:p1049:b003:l008","ordinal":156174,"en":"The finest marksmen with guns,"},{"id":"semetey-1-2013:p1049:b003:l009","ordinal":156175,"en":"Spread out and inflicted hardship."},{"id":"semetey-1-2013:p1049:b003:l010","ordinal":156176,"en":"Those who would not bend beneath a whip"},{"id":"semetey-1-2013:p1049:b003:l011","ordinal":156177,"en":"He separated as champions;"},{"id":"semetey-1-2013:p1049:b003:l012","ordinal":156178,"en":"Those who would not flinch beneath a sword"},{"id":"semetey-1-2013:p1049:b003:l013","ordinal":156179,"en":"He separated as formidable men;"},{"id":"semetey-1-2013:p1049:b003:l014","ordinal":156180,"en":"Those who would not flee"},{"id":"semetey-1-2013:p1049:b003:l015","ordinal":156181,"en":"When a black musket cracked,"},{"id":"semetey-1-2013:p1049:b003:l016","ordinal":156182,"en":"Those who would not start"},{"id":"semetey-1-2013:p1049:b003:l017","ordinal":156183,"en":"When a fierce gun snapped,"},{"id":"semetey-1-2013:p1049:b003:l018","ordinal":156184,"en":"He gathered and drove together."},{"id":"semetey-1-2013:p1049:b003:l019","ordinal":156185,"en":"Chynkozho, son of Shygay,"},{"id":"semetey-1-2013:p1049:b003:l020","ordinal":156186,"en":"Kozho, resolute in his deeds,"},{"id":"semetey-1-2013:p1049:b003:l021","ordinal":156187,"en":"Had begun a great upheaval."},{"id":"semetey-1-2013:p1049:b003:l022","ordinal":156188,"en":"If we do not give Chürök in tribute,"},{"id":"semetey-1-2013:p1049:b003:l023","ordinal":156189,"en":"An army comes that will overrun us;"},{"id":"semetey-1-2013:p1049:b003:l024","ordinal":156190,"en":"When he rages and attacks,"},{"id":"semetey-1-2013:p1049:b003:l025","ordinal":156191,"en":"Mighty Toltoy comes,"},{"id":"semetey-1-2013:p1049:b003:l026","ordinal":156192,"en":"One who will begin the great tumult."},{"id":"semetey-1-2013:p1049:b003:l027","ordinal":156193,"en":"All the Zhediger,"},{"id":"semetey-1-2013:p1049:b003:l028","ordinal":156194,"en":"With the accomplished elder Tölök,"},{"id":"semetey-1-2013:p1049:b003:l029","ordinal":156195,"en":"Brandishing their spears,"},{"id":"semetey-1-2013:p1049:b003:l030","ordinal":156196,"en":"Had made themselves ready."},{"id":"semetey-1-2013:p1049:b003:l031","ordinal":156197,"en":"The Zhediger had gathered"},{"id":"semetey-1-2013:p1049:b003:l032","ordinal":156198,"en":"Around Buloo Khan."},{"id":"semetey-1-2013:p1049:b003:l033","ordinal":156199,"en":"If we do not accept his demand,"},{"id":"semetey-1-2013:p1049:b003:l034","ordinal":156200,"en":"If we do not give Aychürök,"},{"id":"semetey-1-2013:p1049:b003:l035","ordinal":156201,"en":"They will overrun us utterly and attack,"},{"id":"semetey-1-2013:p1049:b003:l036","ordinal":156202,"en":"Turn water into their orchards,"},{"id":"semetey-1-2013:p1049:b003:l037","ordinal":156203,"en":"And make gardens of our land;"},{"id":"semetey-1-2013:p1049:b003:l038","ordinal":156204,"en":"They will channel water all around,"},{"id":"semetey-1-2013:p1049:b003:l039","ordinal":156205,"en":"And every one of them will spur in,"},{"id":"semetey-1-2013:p1049:b005:l001","ordinal":156206,"en":"And emerge everywhere alike."},{"id":"semetey-1-2013:p1049:b005:l002","ordinal":156207,"en":"If we do not give Aychürök,"},{"id":"semetey-1-2013:p1049:b005:l003","ordinal":156208,"en":"If we do not accept his words,"},{"id":"semetey-1-2013:p1049:b005:l004","ordinal":156209,"en":"They will demolish every house,"},{"id":"semetey-1-2013:p1049:b005:l005","ordinal":156210,"en":"Cut down and topple the willows,"},{"id":"semetey-1-2013:p1049:b005:l006","ordinal":156211,"en":"And raze it all smooth."},{"id":"semetey-1-2013:p1049:b005:l007","ordinal":156212,"en":"In Akun's old age,"},{"id":"semetey-1-2013:p1049:b005:l008","ordinal":156213,"en":"Saying, \"He will not give his old maid daughter,\""},{"id":"semetey-1-2013:p1049:b005:l009","ordinal":156214,"en":"They will humiliate him!"},{"id":"semetey-1-2013:p1049:b005:l010","ordinal":156215,"en":"Azhybay and Tümönbay—"},{"id":"semetey-1-2013:p1049:b005:l011","ordinal":156216,"en":"They will enslave us both"},{"id":"semetey-1-2013:p1049:b005:l012","ordinal":156217,"en":"And send us to tend their horses!\""},{"id":"semetey-1-2013:p1049:b005:l013","ordinal":156218,"en":"So saying and tormenting himself, Azhybay,"},{"id":"semetey-1-2013:p1049:b005:l014","ordinal":156219,"en":"After he had seen this,"},{"id":"semetey-1-2013:p1049:b005:l015","ordinal":156220,"en":"Lost the strength of his arms,"},{"id":"semetey-1-2013:p1049:b005:l016","ordinal":156221,"en":"And the courage left his heart."},{"id":"semetey-1-2013:p1049:b005:l017","ordinal":156222,"en":"The Zhediger had begun their affliction;"},{"id":"semetey-1-2013:p1049:b005:l018","ordinal":156223,"en":"When he saw this display,"},{"id":"semetey-1-2013:p1049:b005:l019","ordinal":156224,"en":"Azhybay proved a coward"},{"id":"semetey-1-2013:p1049:b005:l020","ordinal":156225,"en":"And nearly fell"},{"id":"semetey-1-2013:p1049:b005:l021","ordinal":156226,"en":"From the top of the tower."},{"id":"semetey-1-2013:p1049:b005:l022","ordinal":156227,"en":"Taking the shortcut down the tower,"},{"id":"semetey-1-2013:p1049:b005:l023","ordinal":156228,"en":"Tümönbay led Azhybay down,"},{"id":"semetey-1-2013:p1049:b005:l024","ordinal":156229,"en":"With the greatest struggle,"},{"id":"semetey-1-2013:p1049:b005:l025","ordinal":156230,"en":"Until he had brought him below."},{"id":"semetey-1-2013:p1049:b005:l026","ordinal":156231,"en":"Azhybay, terrified and distraught,"},{"id":"semetey-1-2013:p1049:b005:l027","ordinal":156232,"en":"Pleaded with Tümönbay:"},{"id":"semetey-1-2013:p1049:b005:l028","ordinal":156233,"en":"\"My dear Tümönbay!"},{"id":"semetey-1-2013:p1049:b005:l029","ordinal":156234,"en":"Because of Aychürök,"},{"id":"semetey-1-2013:p1049:b005:l030","ordinal":156235,"en":"Mortal danger has come upon us;"},{"id":"semetey-1-2013:p1049:b005:l031","ordinal":156236,"en":"With mighty Kozho at their head,"},{"id":"semetey-1-2013:p1049:b005:l032","ordinal":156237,"en":"An army comes that will overrun us."},{"id":"semetey-1-2013:p1049:b005:l033","ordinal":156238,"en":"If we do not go out to meet them,"},{"id":"semetey-1-2013:p1049:b005:l034","ordinal":156239,"en":"Driving eighty fat barren mares,"},{"id":"semetey-1-2013:p1049:b005:l035","ordinal":156240,"en":"All of them matching gray beasts,"},{"id":"semetey-1-2013:p1049:b005:l036","ordinal":156241,"en":"And carry them as tribute,"},{"id":"semetey-1-2013:p1049:b005:l037","ordinal":156242,"en":"Halt their great army,"},{"id":"semetey-1-2013:p1049:b005:l038","ordinal":156243,"en":"And gain a seven-day reprieve,"},{"id":"semetey-1-2013:p1049:b005:l039","ordinal":156244,"en":"The dense black Zhediger"},{"id":"semetey-1-2013:p1050:b003:l001","ordinal":156245,"en":"If we do not accept what he says,"},{"id":"semetey-1-2013:p1050:b003:l002","ordinal":156246,"en":"If we do not give Aychürök"},{"id":"semetey-1-2013:p1050:b003:l003","ordinal":156247,"en":"To Toltoy as tribute,"},{"id":"semetey-1-2013:p1050:b003:l004","ordinal":156248,"en":"He will act with great cruelty."},{"id":"semetey-1-2013:p1050:b003:l005","ordinal":156249,"en":"Chynkozho, son of Shygay,"},{"id":"semetey-1-2013:p1050:b003:l006","ordinal":156250,"en":"Kozho, resolute in his deeds,"},{"id":"semetey-1-2013:p1050:b003:l007","ordinal":156251,"en":"Will slaughter us and only then be satisfied!"},{"id":"semetey-1-2013:p1050:b003:l008","ordinal":156252,"en":"If we do not give Aychürök in tribute,"},{"id":"semetey-1-2013:p1050:b003:l009","ordinal":156253,"en":"If we do not go and settle it that way,"},{"id":"semetey-1-2013:p1050:b003:l010","ordinal":156254,"en":"He will cut off our heads without ceasing,"},{"id":"semetey-1-2013:p1050:b003:l011","ordinal":156255,"en":"Reach down to our very roots,"},{"id":"semetey-1-2013:p1050:b003:l012","ordinal":156256,"en":"Plunder all our goods,"},{"id":"semetey-1-2013:p1050:b003:l013","ordinal":156257,"en":"And inflict grievous ruin."},{"id":"semetey-1-2013:p1050:b003:l014","ordinal":156258,"en":"For the aging maiden Chürök,"},{"id":"semetey-1-2013:p1050:b003:l015","ordinal":156259,"en":"If we do not go to meet him,"},{"id":"semetey-1-2013:p1050:b003:l016","ordinal":156260,"en":"He will begin the great tumult"},{"id":"semetey-1-2013:p1050:b003:l017","ordinal":156261,"en":"And utterly slaughter"},{"id":"semetey-1-2013:p1050:b003:l018","ordinal":156262,"en":"The dense black Afghans!\""},{"id":"semetey-1-2013:p1050:b003:l019","ordinal":156263,"en":"When Azhybay said this,"},{"id":"semetey-1-2013:p1050:b003:l020","ordinal":156264,"en":"Many people before the others"},{"id":"semetey-1-2013:p1050:b003:l021","ordinal":156265,"en":"Began to clamor;"},{"id":"semetey-1-2013:p1050:b003:l022","ordinal":156266,"en":"Many people took fright"},{"id":"semetey-1-2013:p1050:b003:l023","ordinal":156267,"en":"And quickly agreed."},{"id":"semetey-1-2013:p1050:b003:l024","ordinal":156268,"en":"Their knees bent,"},{"id":"semetey-1-2013:p1050:b003:l025","ordinal":156269,"en":"And their young men ran."},{"id":"semetey-1-2013:p1050:b003:l026","ordinal":156270,"en":"From Khan Akun's court,"},{"id":"semetey-1-2013:p1050:b003:l027","ordinal":156271,"en":"As tribute for Toltoy,"},{"id":"semetey-1-2013:p1050:b003:l028","ordinal":156272,"en":"They drove some forty red camels;"},{"id":"semetey-1-2013:p1050:b003:l029","ordinal":156273,"en":"As tribute for Kozho,"},{"id":"semetey-1-2013:p1050:b003:l030","ordinal":156274,"en":"They drove eighty-eight gray beasts,"},{"id":"semetey-1-2013:p1050:b003:l031","ordinal":156275,"en":"All of them fat and barren."},{"id":"semetey-1-2013:p1050:b003:l032","ordinal":156276,"en":"They took men with the tribute"},{"id":"semetey-1-2013:p1050:b003:l033","ordinal":156277,"en":"And many head of livestock,"},{"id":"semetey-1-2013:p1050:b003:l034","ordinal":156278,"en":"Prepared their white banner,"},{"id":"semetey-1-2013:p1050:b003:l035","ordinal":156279,"en":"And bound it high as the sky."},{"id":"semetey-1-2013:p1050:b003:l036","ordinal":156280,"en":"They now went out to meet"},{"id":"semetey-1-2013:p1050:b003:l037","ordinal":156281,"en":"The Zhediger."},{"id":"semetey-1-2013:p1050:b003:l038","ordinal":156282,"en":"Together with their livestock,"},{"id":"semetey-1-2013:p1050:b003:l039","ordinal":156283,"en":"Before warrior Kozho,"},{"id":"semetey-1-2013:p1050:b004:l001","ordinal":156284,"en":"They now brought the tribute."},{"id":"semetey-1-2013:p1050:b004:l002","ordinal":156285,"en":"Azhybay and Tümönbay"},{"id":"semetey-1-2013:p1050:b004:l003","ordinal":156286,"en":"Folded their hands across their bellies"},{"id":"semetey-1-2013:p1050:b004:l004","ordinal":156287,"en":"And bowed in submission."},{"id":"semetey-1-2013:p1050:b004:l005","ordinal":156288,"en":"When he saw this tribute,"},{"id":"semetey-1-2013:p1050:b004:l006","ordinal":156289,"en":"Chynkozho, son of Shygay,"},{"id":"semetey-1-2013:p1050:b004:l007","ordinal":156290,"en":"Kozho, resolute in his deeds—"},{"id":"semetey-1-2013:p1050:b004:l008","ordinal":156291,"en":"When his wrath took hold,"},{"id":"semetey-1-2013:p1050:b004:l009","ordinal":156292,"en":"His custom was to begin a great tumult;"},{"id":"semetey-1-2013:p1050:b004:l010","ordinal":156293,"en":"When he entered battle against an enemy,"},{"id":"semetey-1-2013:p1050:b004:l011","ordinal":156294,"en":"His black horse flew into the sky;"},{"id":"semetey-1-2013:p1050:b004:l012","ordinal":156295,"en":"His custom was to lay waste"},{"id":"semetey-1-2013:p1050:b004:l013","ordinal":156296,"en":"All those he fought."},{"id":"semetey-1-2013:p1050:b004:l014","ordinal":156297,"en":"Chynkozho, son of Shygay,"},{"id":"semetey-1-2013:p1050:b004:l015","ordinal":156298,"en":"Born a khan surpassing the Argyn,"},{"id":"semetey-1-2013:p1050:b004:l016","ordinal":156299,"en":"When his wrath took hold,"},{"id":"semetey-1-2013:p1050:b004:l017","ordinal":156300,"en":"Life fled from the Zhediger."},{"id":"semetey-1-2013:p1050:b004:l018","ordinal":156301,"en":"Raging and roaring,"},{"id":"semetey-1-2013:p1050:b004:l019","ordinal":156302,"en":"Mighty Kozho thundered;"},{"id":"semetey-1-2013:p1050:b004:l020","ordinal":156303,"en":"Roaring in anger,"},{"id":"semetey-1-2013:p1050:b004:l021","ordinal":156304,"en":"He called Toltoy of the Zhediger"},{"id":"semetey-1-2013:p1050:b004:l022","ordinal":156305,"en":"And ordered him to come near."},{"id":"semetey-1-2013:p1050:b004:l023","ordinal":156306,"en":"When Toltoy approached,"},{"id":"semetey-1-2013:p1050:b004:l024","ordinal":156307,"en":"Mighty Kozho glared in anger"},{"id":"semetey-1-2013:p1050:b004:l025","ordinal":156308,"en":"And began to speak:"},{"id":"semetey-1-2013:p1050:b004:l026","ordinal":156309,"en":"\"Your father's grave, warrior Toltoy!"},{"id":"semetey-1-2013:p1050:b004:l027","ordinal":156310,"en":"We became pale stars in the sky,"},{"id":"semetey-1-2013:p1050:b004:l028","ordinal":156311,"en":"And friends until Judgment Day."},{"id":"semetey-1-2013:p1050:b004:l029","ordinal":156312,"en":"At this time, oh Toltoy,"},{"id":"semetey-1-2013:p1050:b004:l030","ordinal":156313,"en":"While my dear head remains,"},{"id":"semetey-1-2013:p1050:b004:l031","ordinal":156314,"en":"If an enemy comes to challenge us,"},{"id":"semetey-1-2013:p1050:b004:l032","ordinal":156315,"en":"I shall slaughter them utterly."},{"id":"semetey-1-2013:p1050:b004:l033","ordinal":156316,"en":"While my own head remains,"},{"id":"semetey-1-2013:p1050:b004:l034","ordinal":156317,"en":"If you heed my words, oh Toltoy,"},{"id":"semetey-1-2013:p1050:b004:l035","ordinal":156318,"en":"Over the whole world"},{"id":"semetey-1-2013:p1050:b004:l036","ordinal":156319,"en":"I shall raise you up as khan!"},{"id":"semetey-1-2013:p1050:b004:l037","ordinal":156320,"en":"Do you understand, oh Toltoy?"},{"id":"semetey-1-2013:p1050:b004:l038","ordinal":156321,"en":"The Afghans have submitted;"},{"id":"semetey-1-2013:p1050:b004:l039","ordinal":156322,"en":"Do you see that all have come?"}]
