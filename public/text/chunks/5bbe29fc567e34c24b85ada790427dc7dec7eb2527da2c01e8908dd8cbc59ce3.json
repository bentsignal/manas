[{"id":"seytek-2012:p1136:b002:l032","ordinal":381953,"en":"Standing upside down,"},{"id":"seytek-2012:p1136:b002:l033","ordinal":381954,"en":"Shooting a gun, shooting a bow,"},{"id":"seytek-2012:p1136:b002:l034","ordinal":381955,"en":"Arguing with each other"},{"id":"seytek-2012:p1136:b002:l035","ordinal":381956,"en":"Aigai has put a lot of"},{"id":"seytek-2012:p1136:b002:l036","ordinal":381957,"en":"A wise man,"},{"id":"seytek-2012:p1136:b002:l037","ordinal":381958,"en":"From Akzholtoy's hands"},{"id":"seytek-2012:p1136:b002:l038","ordinal":381959,"en":"Disconnected now."},{"id":"seytek-2012:p1136:b002:l039","ordinal":381960,"en":"If God doesn't back down,"},{"id":"seytek-2012:p1136:b002:l040","ordinal":381961,"en":"Will this be the case."},{"id":"seytek-2012:p1136:b003:l001","ordinal":381962,"en":"Ninety-four souls are one soul"},{"id":"seytek-2012:p1136:b003:l002","ordinal":381963,"en":"Add the sabasa tarpin."},{"id":"seytek-2012:p1136:b003:l003","ordinal":381964,"en":"It's raining,"},{"id":"seytek-2012:p1136:b003:l004","ordinal":381965,"en":"Shoot a hail of bullets,"},{"id":"seytek-2012:p1136:b003:l005","ordinal":381966,"en":"Aiza reached out and hit the ax,"},{"id":"seytek-2012:p1136:b003:l006","ordinal":381967,"en":"A very difficult quarrel,"},{"id":"seytek-2012:p1136:b003:l007","ordinal":381968,"en":"Kenebes Zholtoy air"},{"id":"seytek-2012:p1136:b003:l008","ordinal":381969,"en":"Attack without turn,"},{"id":"seytek-2012:p1136:b003:l009","ordinal":381970,"en":"Blindfolded,"},{"id":"seytek-2012:p1136:b003:l010","ordinal":381971,"en":"You see, this is a difficult task,"},{"id":"seytek-2012:p1136:b003:l011","ordinal":381972,"en":"Kojjal China is closed."},{"id":"seytek-2012:p1136:b003:l012","ordinal":381973,"en":"Kulunsur below,"},{"id":"seytek-2012:p1136:b003:l013","ordinal":381974,"en":"Moon animal is real,"},{"id":"seytek-2012:p1136:b003:l014","ordinal":381975,"en":"An animal is an animal"},{"id":"seytek-2012:p1136:b003:l015","ordinal":381976,"en":"Dear brother,"},{"id":"seytek-2012:p1136:b003:l016","ordinal":381977,"en":"Faced with the moon"},{"id":"seytek-2012:p1136:b003:l017","ordinal":381978,"en":"Shine brightly,"},{"id":"seytek-2012:p1136:b003:l018","ordinal":381979,"en":"If it rains and makes rainbows,"},{"id":"seytek-2012:p1136:b003:l019","ordinal":381980,"en":"Pay attention to the crooked nose,"},{"id":"seytek-2012:p1136:b003:l020","ordinal":381981,"en":"Your air is like a fight,"},{"id":"seytek-2012:p1136:b003:l021","ordinal":381982,"en":"Who has seen such work."},{"id":"seytek-2012:p1136:b003:l022","ordinal":381983,"en":"What happened to the body"},{"id":"seytek-2012:p1136:b003:l023","ordinal":381984,"en":"Trouble with children is a big scandal"},{"id":"seytek-2012:p1136:b003:l024","ordinal":381985,"en":"It's time for Akjoltoy,"},{"id":"seytek-2012:p1136:b003:l025","ordinal":381986,"en":"All the blood is swallowed,"},{"id":"seytek-2012:p1136:b003:l026","ordinal":381987,"en":"All tone is torn,"},{"id":"seytek-2012:p1136:b003:l027","ordinal":381988,"en":"Iron rope, nets"},{"id":"seytek-2012:p1136:b003:l028","ordinal":381989,"en":"When closing the net,"},{"id":"seytek-2012:p1136:b003:l029","ordinal":381990,"en":"Famous horse Kulunsur"},{"id":"seytek-2012:p1136:b003:l030","ordinal":381991,"en":"Joltoy ran away"},{"id":"seytek-2012:p1136:b003:l031","ordinal":381992,"en":"An extended broadside"},{"id":"seytek-2012:p1136:b003:l032","ordinal":381993,"en":"Where did the animals come from?"},{"id":"seytek-2012:p1136:b003:l033","ordinal":381994,"en":"A stone necklace on the head,"},{"id":"seytek-2012:p1136:b003:l034","ordinal":381995,"en":"It's the way of a horse."},{"id":"seytek-2012:p1136:b003:l035","ordinal":381996,"en":"Leaning on the air like a road,"},{"id":"seytek-2012:p1136:b003:l036","ordinal":381997,"en":"Surrounded by"},{"id":"seytek-2012:p1136:b003:l037","ordinal":381998,"en":"Climb up the hill and escape"},{"id":"seytek-2012:p1136:b003:l038","ordinal":381999,"en":"Aiza stretched out and bandaged,"},{"id":"seytek-2012:p1136:b003:l039","ordinal":382000,"en":"Amanat blesses the soul,"},{"id":"seytek-2012:p1136:b003:l040","ordinal":382001,"en":"Desperate like a fly"},{"id":"seytek-2012:p1137:b002:l001","ordinal":382002,"en":"The reason he had lost all hope:"},{"id":"seytek-2012:p1137:b002:l002","ordinal":382003,"en":"His two arms that once gave strength"},{"id":"seytek-2012:p1137:b002:l003","ordinal":382004,"en":"Hung motionless and paralyzed;"},{"id":"seytek-2012:p1137:b002:l004","ordinal":382005,"en":"His noble head, the guide of life,"},{"id":"seytek-2012:p1137:b002:l005","ordinal":382006,"en":"Was drenched in crimson blood;"},{"id":"seytek-2012:p1137:b002:l006","ordinal":382007,"en":"His entire body"},{"id":"seytek-2012:p1137:b002:l007","ordinal":382008,"en":"Lay utterly still and helpless."},{"id":"seytek-2012:p1137:b002:l008","ordinal":382009,"en":"The dear Kyrgyz folk in white felt caps"},{"id":"seytek-2012:p1137:b002:l009","ordinal":382010,"en":"Yearned desperately to see Joltoi."},{"id":"seytek-2012:p1137:b002:l010","ordinal":382011,"en":"They had no crag beyond the wild goose’s flight,"},{"id":"seytek-2012:p1137:b002:l011","ordinal":382012,"en":"No mountain to shelter them."},{"id":"seytek-2012:p1137:b002:l012","ordinal":382013,"en":"They had no ridge from which to face the foe;"},{"id":"seytek-2012:p1137:b002:l013","ordinal":382014,"en":"When all recourse was gone,"},{"id":"seytek-2012:p1137:b002:l014","ordinal":382015,"en":"Their champion Seytek was nowhere in sight."},{"id":"seytek-2012:p1137:b002:l015","ordinal":382016,"en":"“Has the marauding Chinese triumphed?"},{"id":"seytek-2012:p1137:b002:l016","ordinal":382017,"en":"Has he crushed my flank?"},{"id":"seytek-2012:p1137:b002:l017","ordinal":382018,"en":"Our mighty wrestler Akjoltoy—"},{"id":"seytek-2012:p1137:b002:l018","ordinal":382019,"en":"Father, by God’s decree,"},{"id":"seytek-2012:p1137:b002:l019","ordinal":382020,"en":"Must he die at an infidel’s hands?"},{"id":"seytek-2012:p1137:b002:l020","ordinal":382021,"en":"Must he take the road of no return?"},{"id":"seytek-2012:p1137:b002:l021","ordinal":382022,"en":"Must a golden life, dearer than the world,"},{"id":"seytek-2012:p1137:b002:l022","ordinal":382023,"en":"Be snuffed out by a firebrand?”"},{"id":"seytek-2012:p1137:b002:l023","ordinal":382024,"en":"Biting their thumbs and shaking their heads,"},{"id":"seytek-2012:p1137:b002:l024","ordinal":382025,"en":"They all spoke of the dreadful news:"},{"id":"seytek-2012:p1137:b002:l025","ordinal":382026,"en":"“Alas, what can I do with this grief?"},{"id":"seytek-2012:p1137:b002:l026","ordinal":382027,"en":"Oh, this loneliness!” they cried."},{"id":"seytek-2012:p1137:b002:l027","ordinal":382028,"en":"“Have I met these raiders"},{"id":"seytek-2012:p1137:b002:l028","ordinal":382029,"en":"Only to meet my death upon the ridge?"},{"id":"seytek-2012:p1137:b002:l029","ordinal":382030,"en":"Will these fortunate Chinese"},{"id":"seytek-2012:p1137:b002:l030","ordinal":382031,"en":"Settle freely upon Jonok?"},{"id":"seytek-2012:p1137:b002:l031","ordinal":382032,"en":"With blood drained and senses reeling,"},{"id":"seytek-2012:p1137:b002:l032","ordinal":382033,"en":"When every means is exhausted,"},{"id":"seytek-2012:p1137:b002:l033","ordinal":382034,"en":"There is no kinsman,” he said faintly."},{"id":"seytek-2012:p1137:b002:l034","ordinal":382035,"en":"As Joltoy stood in this plight,"},{"id":"seytek-2012:p1137:b002:l035","ordinal":382036,"en":"Brave Seytek, the hero’s son,"},{"id":"seytek-2012:p1137:b002:l036","ordinal":382037,"en":"Could scarcely rein Kulansur’s mouth:"},{"id":"seytek-2012:p1137:b002:l037","ordinal":382038,"en":"“God, preserve him!"},{"id":"seytek-2012:p1137:b002:l038","ordinal":382039,"en":"Where is Joltoy, my joy?” he cried."},{"id":"seytek-2012:p1137:b002:l039","ordinal":382040,"en":"The gray-maned hero could not remain still."},{"id":"seytek-2012:p1137:b002:l040","ordinal":382041,"en":"Clad in his splendid golden coat,"},{"id":"seytek-2012:p1137:b004:l001","ordinal":382042,"en":"Mounted on his sleek, water-smooth steed,"},{"id":"seytek-2012:p1137:b004:l002","ordinal":382043,"en":"He traveled day and night,"},{"id":"seytek-2012:p1137:b004:l003","ordinal":382044,"en":"Exhausting his horse as he searched the land,"},{"id":"seytek-2012:p1137:b004:l004","ordinal":382045,"en":"Seizing his spear in wrath,"},{"id":"seytek-2012:p1137:b004:l005","ordinal":382046,"en":"Setting his firearm ready,"},{"id":"seytek-2012:p1137:b004:l006","ordinal":382047,"en":"Scanning the passes and searching the ground,"},{"id":"seytek-2012:p1137:b004:l007","ordinal":382048,"en":"Driving the sweat from his horse’s coat,"},{"id":"seytek-2012:p1137:b004:l008","ordinal":382049,"en":"He followed the trail where the two giants,"},{"id":"seytek-2012:p1137:b004:l009","ordinal":382050,"en":"Akjoltoy and Bilgich, had given chase."},{"id":"seytek-2012:p1137:b004:l010","ordinal":382051,"en":"Growling and gathering fury,"},{"id":"seytek-2012:p1137:b004:l011","ordinal":382052,"en":"Taking on the aspect of a hungry lion,"},{"id":"seytek-2012:p1137:b004:l012","ordinal":382053,"en":"His majesty swelling into rage,"},{"id":"seytek-2012:p1137:b004:l013","ordinal":382054,"en":"He resolved to ride as far as Kakan,"},{"id":"seytek-2012:p1137:b004:l014","ordinal":382055,"en":"To discover whether Joltoy"},{"id":"seytek-2012:p1137:b004:l015","ordinal":382056,"en":"Was dead or alive."},{"id":"seytek-2012:p1137:b004:l016","ordinal":382057,"en":"He aimed the wretched steed"},{"id":"seytek-2012:p1137:b004:l017","ordinal":382058,"en":"Along the very road of the chase:"},{"id":"seytek-2012:p1137:b004:l018","ordinal":382059,"en":"“If Akjoltoy, whom I seek,"},{"id":"seytek-2012:p1137:b004:l019","ordinal":382060,"en":"Has not died but still lives,"},{"id":"seytek-2012:p1137:b004:l020","ordinal":382061,"en":"May I stir up a mighty conflict behind me"},{"id":"seytek-2012:p1137:b004:l021","ordinal":382062,"en":"And win myself renown."},{"id":"seytek-2012:p1137:b004:l022","ordinal":382063,"en":"That bravest hero, worthy of the name,"},{"id":"seytek-2012:p1137:b004:l023","ordinal":382064,"en":"That peerless falcon,"},{"id":"seytek-2012:p1137:b004:l024","ordinal":382065,"en":"Was accomplished, a true man;"},{"id":"seytek-2012:p1137:b004:l025","ordinal":382066,"en":"His valor was unsurpassed."},{"id":"seytek-2012:p1137:b004:l026","ordinal":382067,"en":"It seems he went forth, sparing not his life,"},{"id":"seytek-2012:p1137:b004:l027","ordinal":382068,"en":"Chasing after the cunning Bilgich;"},{"id":"seytek-2012:p1137:b004:l028","ordinal":382069,"en":"Ill-fated Akjoltoy"},{"id":"seytek-2012:p1137:b004:l029","ordinal":382070,"en":"Seems to have gone as far as Kakan."},{"id":"seytek-2012:p1137:b004:l030","ordinal":382071,"en":"He was a kinsman who gave us shelter,"},{"id":"seytek-2012:p1137:b004:l031","ordinal":382072,"en":"A man untouched by sorrow,"},{"id":"seytek-2012:p1137:b004:l032","ordinal":382073,"en":"The bulwark of our dear people here."},{"id":"seytek-2012:p1137:b004:l033","ordinal":382074,"en":"If enemies came from right and left,"},{"id":"seytek-2012:p1137:b004:l034","ordinal":382075,"en":"If challengers encircled him tenfold,"},{"id":"seytek-2012:p1137:b004:l035","ordinal":382076,"en":"In the crush of clashing battle,"},{"id":"seytek-2012:p1137:b004:l036","ordinal":382077,"en":"Where blood was spilled,"},{"id":"seytek-2012:p1137:b004:l037","ordinal":382078,"en":"His presence always shielded us."},{"id":"seytek-2012:p1137:b004:l038","ordinal":382079,"en":"Almighty God who created living souls,"},{"id":"seytek-2012:p1137:b004:l039","ordinal":382080,"en":"May God preserve Joltoy!"},{"id":"seytek-2012:p1137:b004:l040","ordinal":382081,"en":"Joltoy was the very eye of fortune,"},{"id":"seytek-2012:p1138:b002:l001","ordinal":382082,"en":"The true source of prosperity,"},{"id":"seytek-2012:p1138:b002:l002","ordinal":382083,"en":"The root of all abundance."},{"id":"seytek-2012:p1138:b002:l003","ordinal":382084,"en":"He was a hero who never grieved,"},{"id":"seytek-2012:p1138:b002:l004","ordinal":382085,"en":"One of the fierce black-maned wolves."},{"id":"seytek-2012:p1138:b002:l005","ordinal":382086,"en":"May God preserve Joltoy!"},{"id":"seytek-2012:p1138:b002:l006","ordinal":382087,"en":"If I do not see him alive,"},{"id":"seytek-2012:p1138:b002:l007","ordinal":382088,"en":"If I do not come to shield him,"},{"id":"seytek-2012:p1138:b002:l008","ordinal":382089,"en":"They will say, ‘The wretched son of Semetey—"},{"id":"seytek-2012:p1138:b002:l009","ordinal":382090,"en":"Weak-backed, feeble Seytek—"},{"id":"seytek-2012:p1138:b002:l010","ordinal":382091,"en":"Knows well his own helplessness;"},{"id":"seytek-2012:p1138:b002:l011","ordinal":382092,"en":"He surrendered me into the hands"},{"id":"seytek-2012:p1138:b002:l012","ordinal":382093,"en":"Of infidels without a protector,’"},{"id":"seytek-2012:p1138:b002:l013","ordinal":382094,"en":"And he will hold my death against me."},{"id":"seytek-2012:p1138:b002:l014","ordinal":382095,"en":"For failing to be his shield and support,"},{"id":"seytek-2012:p1138:b002:l015","ordinal":382096,"en":"God will strike Seytek down!”"},{"id":"seytek-2012:p1138:b002:l016","ordinal":382097,"en":"So spoke that lionhearted man,"},{"id":"seytek-2012:p1138:b002:l017","ordinal":382098,"en":"Grieving and lamenting, that brave hero."},{"id":"seytek-2012:p1138:b002:l018","ordinal":382099,"en":"Beneath him Kulansur"},{"id":"seytek-2012:p1138:b002:l019","ordinal":382100,"en":"Sped ever farther beyond the eye’s reach,"},{"id":"seytek-2012:p1138:b002:l020","ordinal":382101,"en":"Pinning back his ears like a wild ass,"},{"id":"seytek-2012:p1138:b002:l021","ordinal":382102,"en":"Sweeping the earth like a whirlwind."},{"id":"seytek-2012:p1138:b002:l022","ordinal":382103,"en":"The black steel bit"},{"id":"seytek-2012:p1138:b002:l023","ordinal":382104,"en":"Struck against his throat;"},{"id":"seytek-2012:p1138:b002:l024","ordinal":382105,"en":"As the beast ran straight and true,"},{"id":"seytek-2012:p1138:b002:l025","ordinal":382106,"en":"His willow-silk tail"},{"id":"seytek-2012:p1138:b002:l026","ordinal":382107,"en":"Lashed against his flanks."},{"id":"seytek-2012:p1138:b002:l027","ordinal":382108,"en":"He seemed as slender as a spear;"},{"id":"seytek-2012:p1138:b002:l028","ordinal":382109,"en":"Over the broken black earth"},{"id":"seytek-2012:p1138:b002:l029","ordinal":382110,"en":"The creature flew with a roar,"},{"id":"seytek-2012:p1138:b002:l030","ordinal":382111,"en":"Leaving all others behind."},{"id":"seytek-2012:p1138:b002:l031","ordinal":382112,"en":"He flung his forelock toward the sky,"},{"id":"seytek-2012:p1138:b002:l032","ordinal":382113,"en":"Driving his hooves deep into the track,"},{"id":"seytek-2012:p1138:b002:l033","ordinal":382114,"en":"Racing onward without pause,"},{"id":"seytek-2012:p1138:b002:l034","ordinal":382115,"en":"Hurling clouds of dust as large as houses"},{"id":"seytek-2012:p1138:b002:l035","ordinal":382116,"en":"High into the heavens."},{"id":"seytek-2012:p1138:b002:l036","ordinal":382117,"en":"The flesh of his haunches rippled,"},{"id":"seytek-2012:p1138:b002:l037","ordinal":382118,"en":"And the unmistakable excellence"},{"id":"seytek-2012:p1138:b002:l038","ordinal":382119,"en":"Of the racehorse bestowed by Perizat showed."},{"id":"seytek-2012:p1138:b002:l039","ordinal":382120,"en":"Across the black earth’s open plain"},{"id":"seytek-2012:p1138:b002:l040","ordinal":382121,"en":"He thundered onward,"},{"id":"seytek-2012:p1138:b003:l001","ordinal":382122,"en":"Like his father, that valiant gray wolf,"},{"id":"seytek-2012:p1138:b003:l002","ordinal":382123,"en":"Throwing the whole world into alarm."},{"id":"seytek-2012:p1138:b003:l003","ordinal":382124,"en":"Following the yellowed trail"},{"id":"seytek-2012:p1138:b003:l004","ordinal":382125,"en":"Of the two giants in pursuit,"},{"id":"seytek-2012:p1138:b003:l005","ordinal":382126,"en":"He chased until he himself turned pale."},{"id":"seytek-2012:p1138:b003:l006","ordinal":382127,"en":"Following their ashen trail,"},{"id":"seytek-2012:p1138:b003:l007","ordinal":382128,"en":"He chased until all color left him."},{"id":"seytek-2012:p1138:b003:l008","ordinal":382129,"en":"The mountains vanished into level ground;"},{"id":"seytek-2012:p1138:b003:l009","ordinal":382130,"en":"So grievous was his ordeal."},{"id":"seytek-2012:p1138:b003:l010","ordinal":382131,"en":"He leaned against the saddle’s ridge;"},{"id":"seytek-2012:p1138:b003:l011","ordinal":382132,"en":"No firm ground remained upon the plain,"},{"id":"seytek-2012:p1138:b003:l012","ordinal":382133,"en":"And he was engulfed in deep mire."},{"id":"seytek-2012:p1138:b003:l013","ordinal":382134,"en":"His mouth gaped wide,"},{"id":"seytek-2012:p1138:b003:l014","ordinal":382135,"en":"And white foam mixed with blood"},{"id":"seytek-2012:p1138:b003:l015","ordinal":382136,"en":"Scattered across the breast"},{"id":"seytek-2012:p1138:b003:l016","ordinal":382137,"en":"Of mighty, peerless Seytek."},{"id":"seytek-2012:p1138:b003:l017","ordinal":382138,"en":"Rough hills became mere ridges;"},{"id":"seytek-2012:p1138:b003:l018","ordinal":382139,"en":"Traveling onward without sparing himself,"},{"id":"seytek-2012:p1138:b003:l019","ordinal":382140,"en":"He satisfied Kulansur’s yearning"},{"id":"seytek-2012:p1138:b003:l020","ordinal":382141,"en":"And unleashed the horse’s full strength."},{"id":"seytek-2012:p1138:b003:l021","ordinal":382142,"en":"His fury rose fiercely;"},{"id":"seytek-2012:p1138:b003:l022","ordinal":382143,"en":"The hero, precious as an eagle,"},{"id":"seytek-2012:p1138:b003:l023","ordinal":382144,"en":"Hung his life upon a single hair."},{"id":"seytek-2012:p1138:b003:l024","ordinal":382145,"en":"Tormented by worry for Joltoy, he thought:"},{"id":"seytek-2012:p1138:b003:l025","ordinal":382146,"en":"“Where shall I find that noble man?"},{"id":"seytek-2012:p1138:b003:l026","ordinal":382147,"en":"If noble Joltoy is lost,"},{"id":"seytek-2012:p1138:b003:l027","ordinal":382148,"en":"How many years must I wage war"},{"id":"seytek-2012:p1138:b003:l028","ordinal":382149,"en":"And raid the Kakan?"},{"id":"seytek-2012:p1138:b003:l029","ordinal":382150,"en":"How many years must spears of pine be bound"},{"id":"seytek-2012:p1138:b003:l030","ordinal":382151,"en":"As I battle the enemy,"},{"id":"seytek-2012:p1138:b003:l031","ordinal":382152,"en":"Making blood flow through the valleys?"},{"id":"seytek-2012:p1138:b003:l032","ordinal":382153,"en":"If I do not renounce this borrowed life,"},{"id":"seytek-2012:p1138:b003:l033","ordinal":382154,"en":"May I die unworthy of the name Seytek;"},{"id":"seytek-2012:p1138:b003:l034","ordinal":382155,"en":"May I sink away as though never born."},{"id":"seytek-2012:p1138:b003:l035","ordinal":382156,"en":"I shall journey as far as Kakan"},{"id":"seytek-2012:p1138:b003:l036","ordinal":382157,"en":"And charge upon them in fury."},{"id":"seytek-2012:p1138:b003:l037","ordinal":382158,"en":"If he has died, I shall load his body"},{"id":"seytek-2012:p1138:b003:l038","ordinal":382159,"en":"Upon my horse and carry it home."},{"id":"seytek-2012:p1138:b003:l039","ordinal":382160,"en":"If Joltoy is alive,"},{"id":"seytek-2012:p1138:b003:l040","ordinal":382161,"en":"I shall see him safe and well;"},{"id":"seytek-2012:p1139:b002:l001","ordinal":382162,"en":"For noble, valiant Joltoy"},{"id":"seytek-2012:p1139:b002:l002","ordinal":382163,"en":"I shall give this life held only in trust!"},{"id":"seytek-2012:p1139:b002:l003","ordinal":382164,"en":"Stricken with sorrow and distress,"},{"id":"seytek-2012:p1139:b002:l004","ordinal":382165,"en":"Fire blazing from his wrath,"},{"id":"seytek-2012:p1139:b002:l005","ordinal":382166,"en":"As the sun darkened and the weather closed in,"},{"id":"seytek-2012:p1139:b002:l006","ordinal":382167,"en":"Seytek pressed onward without pause."},{"id":"seytek-2012:p1139:b002:l007","ordinal":382168,"en":"With all his gear made ready,"},{"id":"seytek-2012:p1139:b002:l008","ordinal":382169,"en":"He circled the hills and knolls"},{"id":"seytek-2012:p1139:b002:l009","ordinal":382170,"en":"Sixty times."},{"id":"seytek-2012:p1139:b002:l010","ordinal":382171,"en":"Below lay Echki-Ölbös,"},{"id":"seytek-2012:p1139:b002:l011","ordinal":382172,"en":"And at the head of the Ili, Üch-Aral;"},{"id":"seytek-2012:p1139:b002:l012","ordinal":382173,"en":"He forded the edge"},{"id":"seytek-2012:p1139:b002:l013","ordinal":382174,"en":"Of the river divided into three branches."},{"id":"seytek-2012:p1139:b002:l014","ordinal":382175,"en":"When the sun reached noon,"},{"id":"seytek-2012:p1139:b002:l015","ordinal":382176,"en":"A towering peak appeared;"},{"id":"seytek-2012:p1139:b002:l016","ordinal":382177,"en":"Its heights were shrouded in haze."},{"id":"seytek-2012:p1139:b002:l017","ordinal":382178,"en":"The earth seemed split and water plunged down,"},{"id":"seytek-2012:p1139:b002:l018","ordinal":382179,"en":"As though the land itself had been destroyed;"},{"id":"seytek-2012:p1139:b002:l019","ordinal":382180,"en":"Mist covered everything around it,"},{"id":"seytek-2012:p1139:b002:l020","ordinal":382181,"en":"And Seytek saw it looming ahead."},{"id":"seytek-2012:p1139:b002:l021","ordinal":382182,"en":"The zamburak guns boomed,"},{"id":"seytek-2012:p1139:b002:l022","ordinal":382183,"en":"The firearm’s bullets shrieked,"},{"id":"seytek-2012:p1139:b002:l023","ordinal":382184,"en":"The great war drums thundered,"},{"id":"seytek-2012:p1139:b002:l024","ordinal":382185,"en":"And battle cries rang out in front."},{"id":"seytek-2012:p1139:b002:l025","ordinal":382186,"en":"From the sound of those cries,"},{"id":"seytek-2012:p1139:b002:l026","ordinal":382187,"en":"It seemed the enemy was advancing in force,"},{"id":"seytek-2012:p1139:b002:l027","ordinal":382188,"en":"Now shouting the war cry “Kakan!”"},{"id":"seytek-2012:p1139:b002:l028","ordinal":382189,"en":"Ninety giants swarmed there."},{"id":"seytek-2012:p1139:b002:l029","ordinal":382190,"en":"They had neither rope nor cord,"},{"id":"seytek-2012:p1139:b002:l030","ordinal":382191,"en":"No road by which to overrun him,"},{"id":"seytek-2012:p1139:b002:l031","ordinal":382192,"en":"No net to cast upon him,"},{"id":"seytek-2012:p1139:b002:l032","ordinal":382193,"en":"Yet they raised a tremendous clamor."},{"id":"seytek-2012:p1139:b002:l033","ordinal":382194,"en":"They had seized your elder Akjoltoy,"},{"id":"seytek-2012:p1139:b002:l034","ordinal":382195,"en":"Binding him without any rope;"},{"id":"seytek-2012:p1139:b002:l035","ordinal":382196,"en":"They had plunged him openly into misery"},{"id":"seytek-2012:p1139:b002:l036","ordinal":382197,"en":"And embroiled him in boundless calamity."},{"id":"seytek-2012:p1139:b002:l037","ordinal":382198,"en":"The time had come for him to behold"},{"id":"seytek-2012:p1139:b002:l038","ordinal":382199,"en":"The true road from which none return;"},{"id":"seytek-2012:p1139:b002:l039","ordinal":382200,"en":"Accursed death had drawn near,"},{"id":"seytek-2012:p1139:b002:l040","ordinal":382201,"en":"And its appointed hour had come."},{"id":"seytek-2012:p1139:b004:l001","ordinal":382202,"en":"All means exhausted, Akjoltoy"},{"id":"seytek-2012:p1139:b004:l002","ordinal":382203,"en":"Stood utterly without recourse."},{"id":"seytek-2012:p1139:b004:l003","ordinal":382204,"en":"Unable to find any shelter,"},{"id":"seytek-2012:p1139:b004:l004","ordinal":382205,"en":"My noble elder was undone."},{"id":"seytek-2012:p1139:b004:l005","ordinal":382206,"en":"Kulansur was reduced to a lark,"},{"id":"seytek-2012:p1139:b004:l006","ordinal":382207,"en":"My doomed elder to a willow switch;"},{"id":"seytek-2012:p1139:b004:l007","ordinal":382208,"en":"His shadow remained, but strength was gone—"}]
