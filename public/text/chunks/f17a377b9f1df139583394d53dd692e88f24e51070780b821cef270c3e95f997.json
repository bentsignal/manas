[{"id":"semetey-1-2013:p0213:b004:l039","ordinal":93185,"en":"Walk behind her,"},{"id":"semetey-1-2013:p0214:b003:l001","ordinal":93186,"en":"To all the world's people,"},{"id":"semetey-1-2013:p0214:b003:l002","ordinal":93187,"en":"That woman Kanykey then"},{"id":"semetey-1-2013:p0214:b003:l003","ordinal":93188,"en":"Had shown her lion's courage."},{"id":"semetey-1-2013:p0214:b003:l004","ordinal":93189,"en":"The red-tasseled Chinese,"},{"id":"semetey-1-2013:p0214:b003:l005","ordinal":93190,"en":"Dividing their forty tribes into five,"},{"id":"semetey-1-2013:p0214:b003:l006","ordinal":93191,"en":"Had she not welcomed them as guests?"},{"id":"semetey-1-2013:p0214:b003:l007","ordinal":93192,"en":"Handling the people with skill,"},{"id":"semetey-1-2013:p0214:b003:l008","ordinal":93193,"en":"Managing to gain the land,"},{"id":"semetey-1-2013:p0214:b003:l009","ordinal":93194,"en":"Directing the memorial feast and the people—"},{"id":"semetey-1-2013:p0214:b003:l010","ordinal":93195,"en":"Was she not your sister-in-law who had known it?"},{"id":"semetey-1-2013:p0214:b003:l011","ordinal":93196,"en":"Though sixty thousand people came at once,"},{"id":"semetey-1-2013:p0214:b003:l012","ordinal":93197,"en":"Their food, as though for one person,"},{"id":"semetey-1-2013:p0214:b003:l013","ordinal":93198,"en":"Was she not your sister-in-law who served it?"},{"id":"semetey-1-2013:p0214:b003:l014","ordinal":93199,"en":"All the whole world,"},{"id":"semetey-1-2013:p0214:b003:l015","ordinal":93200,"en":"Was she not your sister-in-law who knew it?"},{"id":"semetey-1-2013:p0214:b003:l016","ordinal":93201,"en":"While her Magnanimous Manas lived,"},{"id":"semetey-1-2013:p0214:b003:l017","ordinal":93202,"en":"Directing khans and governing people—"},{"id":"semetey-1-2013:p0214:b003:l018","ordinal":93203,"en":"Was she not your sister-in-law who knew it?"},{"id":"semetey-1-2013:p0214:b003:l019","ordinal":93204,"en":"Learning from Manas,"},{"id":"semetey-1-2013:p0214:b003:l020","ordinal":93205,"en":"Your sister-in-law had seen much."},{"id":"semetey-1-2013:p0214:b003:l021","ordinal":93206,"en":"When she shouted toward the lowlands,"},{"id":"semetey-1-2013:p0214:b003:l022","ordinal":93207,"en":"When she called, “Drive the horses!”"},{"id":"semetey-1-2013:p0214:b003:l023","ordinal":93208,"en":"Not one soul remained in the lowlands."},{"id":"semetey-1-2013:p0214:b003:l024","ordinal":93209,"en":"When she shouted toward the mountains,"},{"id":"semetey-1-2013:p0214:b003:l025","ordinal":93210,"en":"When she called, “Drive the horses!”"},{"id":"semetey-1-2013:p0214:b003:l026","ordinal":93211,"en":"Not one soul remained in the mountains."},{"id":"semetey-1-2013:p0214:b003:l027","ordinal":93212,"en":"Then your fiery sister-in-law"},{"id":"semetey-1-2013:p0214:b003:l028","ordinal":93213,"en":"Would have no regrets even in death."},{"id":"semetey-1-2013:p0214:b003:l029","ordinal":93214,"en":"The contestants who raced horses,"},{"id":"semetey-1-2013:p0214:b003:l030","ordinal":93215,"en":"The trainers who tethered horses,"},{"id":"semetey-1-2013:p0214:b003:l031","ordinal":93216,"en":"Taking shortcuts along the roads,"},{"id":"semetey-1-2013:p0214:b003:l032","ordinal":93217,"en":"The eight khans—may their journey prosper—"},{"id":"semetey-1-2013:p0214:b003:l033","ordinal":93218,"en":"Leading their horses,"},{"id":"semetey-1-2013:p0214:b003:l034","ordinal":93219,"en":"Going to and fro,"},{"id":"semetey-1-2013:p0214:b003:l035","ordinal":93220,"en":"Calling “Aha! Aha!” in haste,"},{"id":"semetey-1-2013:p0214:b003:l036","ordinal":93221,"en":"The leaders of ten bobbing along,"},{"id":"semetey-1-2013:p0214:b003:l037","ordinal":93222,"en":"The leaders of fifty shouting rough commands,"},{"id":"semetey-1-2013:p0214:b003:l038","ordinal":93223,"en":"The great holy city of sheikhs,"},{"id":"semetey-1-2013:p0214:b003:l039","ordinal":93224,"en":"The multitudes of Kokand and Margalang,"},{"id":"semetey-1-2013:p0214:b004:l001","ordinal":93225,"en":"Synchybek of Andijan,"},{"id":"semetey-1-2013:p0214:b004:l002","ordinal":93226,"en":"Kokand's Kushbegi,"},{"id":"semetey-1-2013:p0214:b004:l003","ordinal":93227,"en":"Their mounts were stallions."},{"id":"semetey-1-2013:p0214:b004:l004","ordinal":93228,"en":"Bukhara was filled with Sarts."},{"id":"semetey-1-2013:p0214:b004:l005","ordinal":93229,"en":"All their mounts were stallions;"},{"id":"semetey-1-2013:p0214:b004:l006","ordinal":93230,"en":"Those on the ridges were more numerous still."},{"id":"semetey-1-2013:p0214:b004:l007","ordinal":93231,"en":"Many had no saddles,"},{"id":"semetey-1-2013:p0214:b004:l008","ordinal":93232,"en":"With rope cruppers and rope girths;"},{"id":"semetey-1-2013:p0214:b004:l009","ordinal":93233,"en":"Those on pack pads were more numerous still."},{"id":"semetey-1-2013:p0214:b004:l010","ordinal":93234,"en":"Those who came had no sense."},{"id":"semetey-1-2013:p0214:b004:l011","ordinal":93235,"en":"All their horses were stallions,"},{"id":"semetey-1-2013:p0214:b004:l012","ordinal":93236,"en":"With no cruppers at all."},{"id":"semetey-1-2013:p0214:b004:l013","ordinal":93237,"en":"Their thoroughbreds holding their heads high,"},{"id":"semetey-1-2013:p0214:b004:l014","ordinal":93238,"en":"Sticking out their little blue overshoes,"},{"id":"semetey-1-2013:p0214:b004:l015","ordinal":93239,"en":"Hurrying till their strength gave out,"},{"id":"semetey-1-2013:p0214:b004:l016","ordinal":93240,"en":"They went to parade the horses."},{"id":"semetey-1-2013:p0214:b004:l017","ordinal":93241,"en":"They were the people of eight khans."},{"id":"semetey-1-2013:p0214:b004:l018","ordinal":93242,"en":"Many people had gathered."},{"id":"semetey-1-2013:p0214:b004:l019","ordinal":93243,"en":"Spearheads clashed together,"},{"id":"semetey-1-2013:p0214:b004:l020","ordinal":93244,"en":"People's heads knocked together."},{"id":"semetey-1-2013:p0214:b004:l021","ordinal":93245,"en":"Drawing along the edge, swaying,"},{"id":"semetey-1-2013:p0214:b004:l022","ordinal":93246,"en":"Moving in rows, rocking,"},{"id":"semetey-1-2013:p0214:b004:l023","ordinal":93247,"en":"All Bukhara heaving,"},{"id":"semetey-1-2013:p0214:b004:l024","ordinal":93248,"en":"Seething with people,"},{"id":"semetey-1-2013:p0214:b004:l025","ordinal":93249,"en":"All Bukhara filled with dust,"},{"id":"semetey-1-2013:p0214:b004:l026","ordinal":93250,"en":"Earth flying, dust spreading,"},{"id":"semetey-1-2013:p0214:b004:l027","ordinal":93251,"en":"The people covered Bukhara."},{"id":"semetey-1-2013:p0214:b004:l028","ordinal":93252,"en":"Looking, one could not make things out;"},{"id":"semetey-1-2013:p0214:b004:l029","ordinal":93253,"en":"Where things were could not be known."},{"id":"semetey-1-2013:p0214:b004:l030","ordinal":93254,"en":"People filled it in dense masses;"},{"id":"semetey-1-2013:p0214:b004:l031","ordinal":93255,"en":"Their people came in full throngs."},{"id":"semetey-1-2013:p0214:b004:l032","ordinal":93256,"en":"Though a woman, such as this,"},{"id":"semetey-1-2013:p0214:b004:l033","ordinal":93257,"en":"Was Kanykey not a khan?"},{"id":"semetey-1-2013:p0214:b004:l034","ordinal":93258,"en":"Among the multitude,"},{"id":"semetey-1-2013:p0214:b004:l035","ordinal":93259,"en":"She began issuing orders:"},{"id":"semetey-1-2013:p0214:b004:l036","ordinal":93260,"en":"“Enter the horses in writing."},{"id":"semetey-1-2013:p0214:b004:l037","ordinal":93261,"en":"Take a count of the horses."},{"id":"semetey-1-2013:p0214:b004:l038","ordinal":93262,"en":"Show your skill in this way."},{"id":"semetey-1-2013:p0214:b004:l039","ordinal":93263,"en":"Once you have registered the horses,"},{"id":"semetey-1-2013:p0215:b003:l001","ordinal":93264,"en":"Then race them."},{"id":"semetey-1-2013:p0215:b003:l002","ordinal":93265,"en":"If you do not heed this counsel,"},{"id":"semetey-1-2013:p0215:b003:l003","ordinal":93266,"en":"If you do not race the horses thus,"},{"id":"semetey-1-2013:p0215:b003:l004","ordinal":93267,"en":"Horses among the argamaks may die,"},{"id":"semetey-1-2013:p0215:b003:l005","ordinal":93268,"en":"Men among the brave may die."},{"id":"semetey-1-2013:p0215:b003:l006","ordinal":93269,"en":"Let the blame not be grievous!”"},{"id":"semetey-1-2013:p0215:b003:l007","ordinal":93270,"en":"She gave this order."},{"id":"semetey-1-2013:p0215:b003:l008","ordinal":93271,"en":"Your noble sister-in-law Kanykey,"},{"id":"semetey-1-2013:p0215:b003:l009","ordinal":93272,"en":"The skilled riders,"},{"id":"semetey-1-2013:p0215:b003:l010","ordinal":93273,"en":"The finest among the brave,"},{"id":"semetey-1-2013:p0215:b003:l011","ordinal":93274,"en":"Gathered them all in rows."},{"id":"semetey-1-2013:p0215:b003:l012","ordinal":93275,"en":"Without regarding her as a woman,"},{"id":"semetey-1-2013:p0215:b003:l013","ordinal":93276,"en":"The people obeyed her word:"},{"id":"semetey-1-2013:p0215:b003:l014","ordinal":93277,"en":"“She is the khan of khans,” they said."},{"id":"semetey-1-2013:p0215:b003:l015","ordinal":93278,"en":"That whole multitude,"},{"id":"semetey-1-2013:p0215:b003:l016","ordinal":93279,"en":"At a fiery woman like your sister-in-law,"},{"id":"semetey-1-2013:p0215:b003:l017","ordinal":93280,"en":"Was left astonished."},{"id":"semetey-1-2013:p0215:b003:l018","ordinal":93281,"en":"People were moving everywhere;"},{"id":"semetey-1-2013:p0215:b003:l019","ordinal":93282,"en":"All Bukhara was filled with dust."},{"id":"semetey-1-2013:p0215:b003:l020","ordinal":93283,"en":"Moldosan of Bukhara"},{"id":"semetey-1-2013:p0215:b003:l021","ordinal":93284,"en":"Was an exceptionally skilled young scribe."},{"id":"semetey-1-2013:p0215:b003:l022","ordinal":93285,"en":"He registered the horses."},{"id":"semetey-1-2013:p0215:b003:l023","ordinal":93286,"en":"When they looked after a while,"},{"id":"semetey-1-2013:p0215:b003:l024","ordinal":93287,"en":"White paper was filled with writing."},{"id":"semetey-1-2013:p0215:b003:l025","ordinal":93288,"en":"When the woman read and looked,"},{"id":"semetey-1-2013:p0215:b003:l026","ordinal":93289,"en":"The swift horses to race in Bukhara"},{"id":"semetey-1-2013:p0215:b003:l027","ordinal":93290,"en":"Were six hundred forty-three."},{"id":"semetey-1-2013:p0215:b003:l028","ordinal":93291,"en":"Then your noble sister-in-law Kanykey:"},{"id":"semetey-1-2013:p0215:b003:l029","ordinal":93292,"en":"“When the moon grows dark,"},{"id":"semetey-1-2013:p0215:b003:l030","ordinal":93293,"en":"What will my night be like?” she said."},{"id":"semetey-1-2013:p0215:b003:l031","ordinal":93294,"en":"“If Taytoru falls behind,"},{"id":"semetey-1-2013:p0215:b003:l032","ordinal":93295,"en":"What will my days be like?” she said."},{"id":"semetey-1-2013:p0215:b003:l033","ordinal":93296,"en":"“I have no support to rely upon."},{"id":"semetey-1-2013:p0215:b003:l034","ordinal":93297,"en":"My Kyrgyz people are not here."},{"id":"semetey-1-2013:p0215:b003:l035","ordinal":93298,"en":"Were you like this, you shitty world?”"},{"id":"semetey-1-2013:p0215:b003:l036","ordinal":93299,"en":"In this world her words were plain;"},{"id":"semetey-1-2013:p0215:b003:l037","ordinal":93300,"en":"Until she died, your sister-in-law"},{"id":"semetey-1-2013:p0215:b003:l038","ordinal":93301,"en":"Was an outstanding judge with seeing eyes."},{"id":"semetey-1-2013:p0215:b003:l039","ordinal":93302,"en":"“With bits made of iron,"},{"id":"semetey-1-2013:p0215:b004:l001","ordinal":93303,"en":"Are there swift horses to champ them?"},{"id":"semetey-1-2013:p0215:b004:l002","ordinal":93304,"en":"On the uphill slopes, wrenching out their lungs,"},{"id":"semetey-1-2013:p0215:b004:l003","ordinal":93305,"en":"God, are there swift horses to contend?"},{"id":"semetey-1-2013:p0215:b004:l004","ordinal":93306,"en":"On rolling hills, rises, and sandy ground,"},{"id":"semetey-1-2013:p0215:b004:l005","ordinal":93307,"en":"Are there swift horses to champ them?"},{"id":"semetey-1-2013:p0215:b004:l006","ordinal":93308,"en":"Running for honor at the front,"},{"id":"semetey-1-2013:p0215:b004:l007","ordinal":93309,"en":"Are there swift horses to vie?”"},{"id":"semetey-1-2013:p0215:b004:l008","ordinal":93310,"en":"So saying, Kanykey,"},{"id":"semetey-1-2013:p0215:b004:l009","ordinal":93311,"en":"Girding her waist firmly,"},{"id":"semetey-1-2013:p0215:b004:l010","ordinal":93312,"en":"Urged Akborchuk once,"},{"id":"semetey-1-2013:p0215:b004:l011","ordinal":93313,"en":"Speaking with sorrow,"},{"id":"semetey-1-2013:p0215:b004:l012","ordinal":93314,"en":"At the steeds filing past,"},{"id":"semetey-1-2013:p0215:b004:l013","ordinal":93315,"en":"She watched, casting her gaze."},{"id":"semetey-1-2013:p0215:b004:l014","ordinal":93316,"en":"All were outstanding steeds;"},{"id":"semetey-1-2013:p0215:b004:l015","ordinal":93317,"en":"She began observing them."},{"id":"semetey-1-2013:p0215:b004:l016","ordinal":93318,"en":"Of the six hundred forty-three steeds,"},{"id":"semetey-1-2013:p0215:b004:l017","ordinal":93319,"en":"Your sister-in-law left not one out;"},{"id":"semetey-1-2013:p0215:b004:l018","ordinal":93320,"en":"She judged them all."},{"id":"semetey-1-2013:p0215:b004:l019","ordinal":93321,"en":"She turned Akborchuk's head,"},{"id":"semetey-1-2013:p0215:b004:l020","ordinal":93322,"en":"And stood watching carefully."},{"id":"semetey-1-2013:p0215:b004:l021","ordinal":93323,"en":"From the Kazakhs, sons of the Three Hordes,"},{"id":"semetey-1-2013:p0215:b004:l022","ordinal":93324,"en":"From the khans of the Kangdy,"},{"id":"semetey-1-2013:p0215:b004:l023","ordinal":93325,"en":"Dwelling in Sary-Arka,"},{"id":"semetey-1-2013:p0215:b004:l024","ordinal":93326,"en":"Called a weighty, formidable hero,"},{"id":"semetey-1-2013:p0215:b004:l025","ordinal":93327,"en":"Who husked his millet, stones and all,"},{"id":"semetey-1-2013:p0215:b004:l026","ordinal":93328,"en":"Who praised his wife like a maiden,"},{"id":"semetey-1-2013:p0215:b004:l027","ordinal":93329,"en":"Whose yurt lattice was of wood,"},{"id":"semetey-1-2013:p0215:b004:l028","ordinal":93330,"en":"Whose first ancestor was Alaychan,"},{"id":"semetey-1-2013:p0215:b004:l029","ordinal":93331,"en":"The heel of the blue boot,"},{"id":"semetey-1-2013:p0215:b004:l030","ordinal":93332,"en":"Kokcho of Aydarkan—"},{"id":"semetey-1-2013:p0215:b004:l031","ordinal":93333,"en":"Kokcho's son Umetoy."},{"id":"semetey-1-2013:p0215:b004:l032","ordinal":93334,"en":"Summering in Sary-Arka,"},{"id":"semetey-1-2013:p0215:b004:l033","ordinal":93335,"en":"He had tethered many swift horses."},{"id":"semetey-1-2013:p0215:b004:l034","ordinal":93336,"en":"His swift horses were dun,"},{"id":"semetey-1-2013:p0215:b004:l035","ordinal":93337,"en":"Their forehead blazes like amulets,"},{"id":"semetey-1-2013:p0215:b004:l036","ordinal":93338,"en":"Hoe-wide rumps and broad hooves,"},{"id":"semetey-1-2013:p0215:b004:l037","ordinal":93339,"en":"Every one like a steed."},{"id":"semetey-1-2013:p0215:b004:l038","ordinal":93340,"en":"He was one of the eight khans."},{"id":"semetey-1-2013:p0215:b004:l039","ordinal":93341,"en":"He had come to race horses,"},{"id":"semetey-1-2013:p0216:b003:l001","ordinal":93342,"en":"That was his horse;"},{"id":"semetey-1-2013:p0216:b003:l002","ordinal":93343,"en":"When she looked this way,"},{"id":"semetey-1-2013:p0216:b003:l003","ordinal":93344,"en":"From Andijan had come"},{"id":"semetey-1-2013:p0216:b003:l004","ordinal":93345,"en":"A Karabair swift steed."},{"id":"semetey-1-2013:p0216:b003:l005","ordinal":93346,"en":"From the broad lower Alai had come"},{"id":"semetey-1-2013:p0216:b003:l006","ordinal":93347,"en":"One with sieve-like lungs and copper forelegs."},{"id":"semetey-1-2013:p0216:b003:l007","ordinal":93348,"en":"From broad Crimea had come"},{"id":"semetey-1-2013:p0216:b003:l008","ordinal":93349,"en":"One with a round neck like a wild ram’s."},{"id":"semetey-1-2013:p0216:b003:l009","ordinal":93350,"en":"From Zheti-Suu had come"},{"id":"semetey-1-2013:p0216:b003:l010","ordinal":93351,"en":"One with a boar’s rump and owl-like feet."},{"id":"semetey-1-2013:p0216:b003:l011","ordinal":93352,"en":"From Chambyl-Bel had come"},{"id":"semetey-1-2013:p0216:b003:l012","ordinal":93353,"en":"A splendid, fleet-footed thoroughbred."},{"id":"semetey-1-2013:p0216:b003:l013","ordinal":93354,"en":"From broad Kashgar had come"},{"id":"semetey-1-2013:p0216:b003:l014","ordinal":93355,"en":"Short-necked Tuuchunak."},{"id":"semetey-1-2013:p0216:b003:l015","ordinal":93356,"en":"Other swift steeds had come,"},{"id":"semetey-1-2013:p0216:b003:l016","ordinal":93357,"en":"Black-necked coursers."},{"id":"semetey-1-2013:p0216:b003:l017","ordinal":93358,"en":"Other swift steeds had come,"},{"id":"semetey-1-2013:p0216:b003:l018","ordinal":93359,"en":"With sieve-like lungs and copper forelegs."},{"id":"semetey-1-2013:p0216:b003:l019","ordinal":93360,"en":"Bits of black steel—"},{"id":"semetey-1-2013:p0216:b003:l020","ordinal":93361,"en":"Oh God, horses able to champ them had come."},{"id":"semetey-1-2013:p0216:b003:l021","ordinal":93362,"en":"Six days without rest, without drinking water,"},{"id":"semetey-1-2013:p0216:b003:l022","ordinal":93363,"en":"Horses able to contend had come."},{"id":"semetey-1-2013:p0216:b003:l023","ordinal":93364,"en":"Broad-chested, short-maned,"},{"id":"semetey-1-2013:p0216:b003:l024","ordinal":93365,"en":"Renowned steeds had come."},{"id":"semetey-1-2013:p0216:b003:l025","ordinal":93366,"en":"Handsome, great coursers"},{"id":"semetey-1-2013:p0216:b003:l026","ordinal":93367,"en":"Had come, each different from the next."},{"id":"semetey-1-2013:p0216:b003:l027","ordinal":93368,"en":"When she saw those horses,"},{"id":"semetey-1-2013:p0216:b003:l028","ordinal":93369,"en":"We shall sell our coursers and pay tribute;"},{"id":"semetey-1-2013:p0216:b003:l029","ordinal":93370,"en":"Praying to the true God,"},{"id":"semetey-1-2013:p0216:b003:l030","ordinal":93371,"en":"My poor one wept aloud."},{"id":"semetey-1-2013:p0216:b003:l031","ordinal":93372,"en":"Your sister-in-law wept in distress,"},{"id":"semetey-1-2013:p0216:b003:l032","ordinal":93373,"en":"Praying to the one God,"},{"id":"semetey-1-2013:p0216:b003:l033","ordinal":93374,"en":"“Grant it to me,” she pleaded."},{"id":"semetey-1-2013:p0216:b003:l034","ordinal":93375,"en":"When she looked at Taitoru:"},{"id":"semetey-1-2013:p0216:b003:l035","ordinal":93376,"en":"Laying his right ear back,"},{"id":"semetey-1-2013:p0216:b003:l036","ordinal":93377,"en":"The crust of the dark earth,"},{"id":"semetey-1-2013:p0216:b003:l037","ordinal":93378,"en":"He flung above his head—"},{"id":"semetey-1-2013:p0216:b003:l038","ordinal":93379,"en":"Such was Taitoru."},{"id":"semetey-1-2013:p0216:b003:l039","ordinal":93380,"en":"His bit of black steel,"},{"id":"semetey-1-2013:p0216:b004:l001","ordinal":93381,"en":"He knocked against his throat;"},{"id":"semetey-1-2013:p0216:b004:l002","ordinal":93382,"en":"His tail like a strand of silk,"},{"id":"semetey-1-2013:p0216:b004:l003","ordinal":93383,"en":"He lashed against his thighs—"},{"id":"semetey-1-2013:p0216:b004:l004","ordinal":93384,"en":"Such was Taitoru."},{"id":"semetey-1-2013:p0216:b004:l005","ordinal":93385,"en":"Sweat parted his coat into furrows;"},{"id":"semetey-1-2013:p0216:b004:l006","ordinal":93386,"en":"His eyes looked like a wild sheep’s—"},{"id":"semetey-1-2013:p0216:b004:l007","ordinal":93387,"en":"Such was Taitoru."},{"id":"semetey-1-2013:p0216:b004:l008","ordinal":93388,"en":"The creature tossed his head,"},{"id":"semetey-1-2013:p0216:b004:l009","ordinal":93389,"en":"Flung his forelock toward the sky,"},{"id":"semetey-1-2013:p0216:b004:l010","ordinal":93390,"en":"And plunged his hooves into the earth—"},{"id":"semetey-1-2013:p0216:b004:l011","ordinal":93391,"en":"Such was Taitoru."},{"id":"semetey-1-2013:p0216:b004:l012","ordinal":93392,"en":"“Alas, ill fortune was written on my brow;"},{"id":"semetey-1-2013:p0216:b004:l014","ordinal":93393,"en":"When my king passed away,"},{"id":"semetey-1-2013:p0216:b004:l015","ordinal":93394,"en":"A hard life lay ahead of me."},{"id":"semetey-1-2013:p0216:b004:l016","ordinal":93395,"en":"Unless my ill fortune stands in the way,"},{"id":"semetey-1-2013:p0216:b004:l017","ordinal":93396,"en":"Today my Taitoru"},{"id":"semetey-1-2013:p0216:b004:l018","ordinal":93397,"en":"Will lower his head to the ground;"},{"id":"semetey-1-2013:p0216:b004:l019","ordinal":93398,"en":"Here in this Bukhara,"},{"id":"semetey-1-2013:p0216:b004:l020","ordinal":93399,"en":"Oh God, he will take the first prize!"},{"id":"semetey-1-2013:p0216:b004:l021","ordinal":93400,"en":"God will open my fortune;"},{"id":"semetey-1-2013:p0216:b004:l022","ordinal":93401,"en":"The many griefs that fill my heart,"},{"id":"semetey-1-2013:p0216:b004:l023","ordinal":93402,"en":"God will scatter them today!"},{"id":"semetey-1-2013:p0216:b004:l024","ordinal":93403,"en":"Otherwise, if Taitoru falls behind,"},{"id":"semetey-1-2013:p0216:b004:l025","ordinal":93404,"en":"Kanykei, exhausted,"},{"id":"semetey-1-2013:p0216:b004:l026","ordinal":93405,"en":"The luckless woman will die of shame!"},{"id":"semetey-1-2013:p0216:b004:l027","ordinal":93406,"en":"In sorrow, this woman"},{"id":"semetey-1-2013:p0216:b004:l028","ordinal":93407,"en":"Will see the face of Judgment Day."},{"id":"semetey-1-2013:p0216:b004:l029","ordinal":93408,"en":"The one God is whom I pray to;"},{"id":"semetey-1-2013:p0216:b004:l030","ordinal":93409,"en":"Or else my Taitoru will come out ahead!"},{"id":"semetey-1-2013:p0216:b004:l031","ordinal":93410,"en":"Rivers and springs coursing through valleys,"},{"id":"semetey-1-2013:p0216:b004:l032","ordinal":93411,"en":"The lonely child won through such suffering—"},{"id":"semetey-1-2013:p0216:b004:l033","ordinal":93412,"en":"Today his luckless mother will see him!”"},{"id":"semetey-1-2013:p0216:b004:l034","ordinal":93413,"en":"So many cares, her breast could not contain them;"},{"id":"semetey-1-2013:p0216:b004:l035","ordinal":93414,"en":"As your mother spoke these words,"},{"id":"semetey-1-2013:p0216:b004:l036","ordinal":93415,"en":"Her tears ran across ten plains."},{"id":"semetey-1-2013:p0216:b004:l037","ordinal":93416,"en":"“When the moon goes dark,"},{"id":"semetey-1-2013:p0216:b004:l038","ordinal":93417,"en":"What will become of the night?” she said."},{"id":"semetey-1-2013:p0216:b004:l039","ordinal":93418,"en":"“If Taitoru falls behind,"},{"id":"semetey-1-2013:p0217:b003:l001","ordinal":93419,"en":"Oh God, what will become of the day?” she said."},{"id":"semetey-1-2013:p0217:b003:l002","ordinal":93420,"en":"“Who would show love"},{"id":"semetey-1-2013:p0217:b003:l003","ordinal":93421,"en":"To a widow like me?"},{"id":"semetey-1-2013:p0217:b003:l004","ordinal":93422,"en":"Oh God, I entered in the race as an omen"},{"id":"semetey-1-2013:p0217:b003:l005","ordinal":93423,"en":"My swift horse Taitoru."},{"id":"semetey-1-2013:p0217:b003:l006","ordinal":93424,"en":"If you come in front, my courser,"},{"id":"semetey-1-2013:p0217:b003:l007","ordinal":93425,"en":"I shall see my orphan child."},{"id":"semetey-1-2013:p0217:b003:l008","ordinal":93426,"en":"If you fall behind, Taitoru,"},{"id":"semetey-1-2013:p0217:b003:l009","ordinal":93427,"en":"I shall spill worthless blood."},{"id":"semetey-1-2013:p0217:b003:l010","ordinal":93428,"en":"Then load me upon a thoroughbred!"},{"id":"semetey-1-2013:p0217:b003:l011","ordinal":93429,"en":"My darling Taitoru,"},{"id":"semetey-1-2013:p0217:b003:l012","ordinal":93430,"en":"I am a poor soul who has strayed from her village."},{"id":"semetey-1-2013:p0217:b003:l013","ordinal":93431,"en":"I have no renowned champion, no support;"},{"id":"semetey-1-2013:p0217:b003:l014","ordinal":93432,"en":"To cheer you firmly onward,"},{"id":"semetey-1-2013:p0217:b003:l015","ordinal":93433,"en":"I have none of my renowned Kyrgyz people."},{"id":"semetey-1-2013:p0217:b003:l016","ordinal":93434,"en":"I have no forest to flee into;"},{"id":"semetey-1-2013:p0217:b003:l017","ordinal":93435,"en":"To stand beside me as support,"},{"id":"semetey-1-2013:p0217:b003:l018","ordinal":93436,"en":"No Nogai of my khan’s is left."},{"id":"semetey-1-2013:p0217:b003:l019","ordinal":93437,"en":"My darling Taitoru,"},{"id":"semetey-1-2013:p0217:b003:l020","ordinal":93438,"en":"Lengthen your stride!"},{"id":"semetey-1-2013:p0217:b003:l021","ordinal":93439,"en":"Open your mouth like a devouring maw,"},{"id":"semetey-1-2013:p0217:b003:l022","ordinal":93440,"en":"My darling courser,"}]
