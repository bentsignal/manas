[{"id":"semetey-1-2013:p0253:b004:l006","ordinal":96257,"en":"The great kettledrum,"},{"id":"semetey-1-2013:p0253:b004:l007","ordinal":96258,"en":"The headstrong boy Semetey"},{"id":"semetey-1-2013:p0253:b004:l008","ordinal":96259,"en":"Struck with a clang."},{"id":"semetey-1-2013:p0253:b004:l009","ordinal":96260,"en":"All his strongmen,"},{"id":"semetey-1-2013:p0253:b004:l010","ordinal":96261,"en":"Readying themselves as though enemies had come,"},{"id":"semetey-1-2013:p0253:b004:l011","ordinal":96262,"en":"The boy Semetey"},{"id":"semetey-1-2013:p0253:b004:l012","ordinal":96263,"en":"Stood surrounding."},{"id":"semetey-1-2013:p0253:b004:l013","ordinal":96264,"en":"Upon lips that had never spoken Manas,"},{"id":"semetey-1-2013:p0253:b004:l014","ordinal":96265,"en":"The poor orphan boy's lips,"},{"id":"semetey-1-2013:p0253:b004:l015","ordinal":96266,"en":"Manas now appeared."},{"id":"semetey-1-2013:p0253:b004:l016","ordinal":96267,"en":"Upon lips that had never spoken a homeland,"},{"id":"semetey-1-2013:p0253:b004:l017","ordinal":96268,"en":"Talas now appeared."},{"id":"semetey-1-2013:p0253:b004:l018","ordinal":96269,"en":"Khizyr visited the boy,"},{"id":"semetey-1-2013:p0253:b004:l019","ordinal":96270,"en":"And Kyrgyz now appeared."},{"id":"semetey-1-2013:p0253:b004:l020","ordinal":96271,"en":"His blood drew him irresistibly;"},{"id":"semetey-1-2013:p0253:b004:l021","ordinal":96272,"en":"That courageous young lad,"},{"id":"semetey-1-2013:p0253:b004:l022","ordinal":96273,"en":"Upon lips that had never said 'Mother,'"},{"id":"semetey-1-2013:p0253:b004:l023","ordinal":96274,"en":"'Mother' now appeared:"},{"id":"semetey-1-2013:p0253:b004:l024","ordinal":96275,"en":"\"My dear strongmen,"},{"id":"semetey-1-2013:p0253:b004:l025","ordinal":96276,"en":"The people we have yet to reach—"},{"id":"semetey-1-2013:p0253:b004:l026","ordinal":96277,"en":"Let us put them to the test, strongmen."},{"id":"semetey-1-2013:p0253:b004:l027","ordinal":96278,"en":"Against those thundering khans today,"},{"id":"semetey-1-2013:p0253:b004:l028","ordinal":96279,"en":"Let us stir up a quarrel, strongmen!"},{"id":"semetey-1-2013:p0253:b004:l029","ordinal":96280,"en":"All the horses that have owners,"},{"id":"semetey-1-2013:p0253:b004:l030","ordinal":96281,"en":"Now, strongmen, hear my words:"},{"id":"semetey-1-2013:p0253:b004:l031","ordinal":96282,"en":"Let us catch them at the bank."},{"id":"semetey-1-2013:p0253:b004:l032","ordinal":96283,"en":"Leaving not a single one alive,"},{"id":"semetey-1-2013:p0253:b004:l033","ordinal":96284,"en":"Let us slaughter them all."},{"id":"semetey-1-2013:p0253:b004:l034","ordinal":96285,"en":"Gathering every last one,"},{"id":"semetey-1-2013:p0253:b004:l035","ordinal":96286,"en":"Let us offer them in sacrifice!"},{"id":"semetey-1-2013:p0253:b004:l036","ordinal":96287,"en":"Now, strongmen, hear my words:"},{"id":"semetey-1-2013:p0253:b004:l037","ordinal":96288,"en":"My unlucky elder sister's"},{"id":"semetey-1-2013:p0253:b004:l038","ordinal":96289,"en":"Horse Taytoru—if he appears,"},{"id":"semetey-1-2013:p0253:b004:l039","ordinal":96290,"en":"Let us urge that one onward."},{"id":"semetey-1-2013:p0254:b003:l001","ordinal":96291,"en":"Let us slaughter the horses that have owners."},{"id":"semetey-1-2013:p0254:b003:l002","ordinal":96292,"en":"If my elder sister's horse appears,"},{"id":"semetey-1-2013:p0254:b003:l003","ordinal":96293,"en":"Roaring, 'Manas! Manas!'"},{"id":"semetey-1-2013:p0254:b003:l004","ordinal":96294,"en":"Raising the battle cry, 'Manas!'"},{"id":"semetey-1-2013:p0254:b003:l005","ordinal":96295,"en":"Let us urge him onward."},{"id":"semetey-1-2013:p0254:b003:l006","ordinal":96296,"en":"If God grants it, to Bukhara,"},{"id":"semetey-1-2013:p0254:b003:l007","ordinal":96297,"en":"Let us urge him on with cries of 'Manas!'"},{"id":"semetey-1-2013:p0254:b003:l008","ordinal":96298,"en":"My dear strongmen,"},{"id":"semetey-1-2013:p0254:b003:l009","ordinal":96299,"en":"All the valleys and mountains,"},{"id":"semetey-1-2013:p0254:b003:l010","ordinal":96300,"en":"Let us make them seem to run."},{"id":"semetey-1-2013:p0254:b003:l011","ordinal":96301,"en":"My dear brother-in-law, gone to the other world,"},{"id":"semetey-1-2013:p0254:b003:l012","ordinal":96302,"en":"Awaking again where he lies,"},{"id":"semetey-1-2013:p0254:b003:l013","ordinal":96303,"en":"Let us make it seem my brother-in-law has risen!"},{"id":"semetey-1-2013:p0254:b003:l014","ordinal":96304,"en":"All the valleys and mountains crying 'Manas!'"},{"id":"semetey-1-2013:p0254:b003:l015","ordinal":96305,"en":"Let us make them seem to run."},{"id":"semetey-1-2013:p0254:b003:l016","ordinal":96306,"en":"The rugged, rolling hills,"},{"id":"semetey-1-2013:p0254:b003:l017","ordinal":96307,"en":"Let us make them like a plain."},{"id":"semetey-1-2013:p0254:b003:l018","ordinal":96308,"en":"That elder sister of mine, so full of sorrow,"},{"id":"semetey-1-2013:p0254:b003:l019","ordinal":96309,"en":"The poor woman whose strength is spent,"},{"id":"semetey-1-2013:p0254:b003:l020","ordinal":96310,"en":"Let us make her feel she has a child."},{"id":"semetey-1-2013:p0254:b003:l021","ordinal":96311,"en":"The ill-hearted people,"},{"id":"semetey-1-2013:p0254:b003:l022","ordinal":96312,"en":"When they see it,"},{"id":"semetey-1-2013:p0254:b003:l023","ordinal":96313,"en":"Let us make them despair of life!"},{"id":"semetey-1-2013:p0254:b003:l024","ordinal":96314,"en":"Valleys and mountains joining,"},{"id":"semetey-1-2013:p0254:b003:l025","ordinal":96315,"en":"'That is Manas!' they will say;"},{"id":"semetey-1-2013:p0254:b003:l026","ordinal":96316,"en":"Let us make them seem to run!"},{"id":"semetey-1-2013:p0254:b003:l027","ordinal":96317,"en":"Roaring, 'Manas! Manas!'"},{"id":"semetey-1-2013:p0254:b003:l028","ordinal":96318,"en":"Raising the battle cry, 'Manas!'"},{"id":"semetey-1-2013:p0254:b003:l029","ordinal":96319,"en":"The racer Taytoru,"},{"id":"semetey-1-2013:p0254:b003:l030","ordinal":96320,"en":"Let us urge onward to Bukhara."},{"id":"semetey-1-2013:p0254:b003:l031","ordinal":96321,"en":"The countless livestock offered as prizes,"},{"id":"semetey-1-2013:p0254:b003:l032","ordinal":96322,"en":"Treasure filling seven houses,"},{"id":"semetey-1-2013:p0254:b003:l033","ordinal":96323,"en":"A thousand dark camels,"},{"id":"semetey-1-2013:p0254:b003:l034","ordinal":96324,"en":"A thousand black mares with blazes,"},{"id":"semetey-1-2013:p0254:b003:l035","ordinal":96325,"en":"Gold weighed out in poods,"},{"id":"semetey-1-2013:p0254:b003:l036","ordinal":96326,"en":"Let us take possession of it all!"},{"id":"semetey-1-2013:p0254:b003:l037","ordinal":96327,"en":"Do not think narrowly, young men."},{"id":"semetey-1-2013:p0254:b003:l038","ordinal":96328,"en":"The racer Taytoru has no human sense;"},{"id":"semetey-1-2013:p0254:b003:l039","ordinal":96329,"en":"He has no master apart from us."},{"id":"semetey-1-2013:p0254:b004:l001","ordinal":96330,"en":"If Taytoru comes out ahead,"},{"id":"semetey-1-2013:p0254:b004:l002","ordinal":96331,"en":"If God grants our very wish,"},{"id":"semetey-1-2013:p0254:b004:l003","ordinal":96332,"en":"I shall agree to what you say,"},{"id":"semetey-1-2013:p0254:b004:l004","ordinal":96333,"en":"My dear strongmen."},{"id":"semetey-1-2013:p0254:b004:l005","ordinal":96334,"en":"Keeping not a coin for myself,"},{"id":"semetey-1-2013:p0254:b004:l006","ordinal":96335,"en":"Again, strongmen, listen:"},{"id":"semetey-1-2013:p0254:b004:l007","ordinal":96336,"en":"All the prizes,"},{"id":"semetey-1-2013:p0254:b004:l008","ordinal":96337,"en":"I shall share out among you."},{"id":"semetey-1-2013:p0254:b004:l009","ordinal":96338,"en":"If I dispute a prize with you,"},{"id":"semetey-1-2013:p0254:b004:l010","ordinal":96339,"en":"If I lose my reason,"},{"id":"semetey-1-2013:p0254:b004:l011","ordinal":96340,"en":"Like a horse-tethering post,"},{"id":"semetey-1-2013:p0254:b004:l012","ordinal":96341,"en":"May I live utterly barren."},{"id":"semetey-1-2013:p0254:b004:l013","ordinal":96342,"en":"Never seeing God's face,"},{"id":"semetey-1-2013:p0254:b004:l014","ordinal":96343,"en":"My dear strongmen,"},{"id":"semetey-1-2013:p0254:b004:l015","ordinal":96344,"en":"May I remain an unbeliever!"},{"id":"semetey-1-2013:p0254:b004:l016","ordinal":96345,"en":"I do not covet the prize;"},{"id":"semetey-1-2013:p0254:b004:l017","ordinal":96346,"en":"Let the fame belong to Manas!"},{"id":"semetey-1-2013:p0254:b004:l018","ordinal":96347,"en":"Think, strongmen:"},{"id":"semetey-1-2013:p0254:b004:l019","ordinal":96348,"en":"Here today, gone tomorrow,"},{"id":"semetey-1-2013:p0254:b004:l020","ordinal":96349,"en":"Such is this shitty world!"},{"id":"semetey-1-2013:p0254:b004:l021","ordinal":96350,"en":"Consider, strongmen:"},{"id":"semetey-1-2013:p0254:b004:l022","ordinal":96351,"en":"The marten-fur cap upon one's head,"},{"id":"semetey-1-2013:p0254:b004:l023","ordinal":96352,"en":"Who has not worn it jauntily?"},{"id":"semetey-1-2013:p0254:b004:l024","ordinal":96353,"en":"When fortune was upon them,"},{"id":"semetey-1-2013:p0254:b004:l025","ordinal":96354,"en":"Who has not strode about in splendor?"},{"id":"semetey-1-2013:p0254:b004:l026","ordinal":96355,"en":"At the sight of my brother-in-law, Khan Manas,"},{"id":"semetey-1-2013:p0254:b004:l027","ordinal":96356,"en":"Not only Muslims, but those"},{"id":"semetey-1-2013:p0254:b004:l028","ordinal":96357,"en":"Chinese people trembled."},{"id":"semetey-1-2013:p0254:b004:l029","ordinal":96358,"en":"The Russians on his right,"},{"id":"semetey-1-2013:p0254:b004:l030","ordinal":96359,"en":"My brother-in-law mowed down."},{"id":"semetey-1-2013:p0254:b004:l031","ordinal":96360,"en":"The Chinese on the uplands,"},{"id":"semetey-1-2013:p0254:b004:l032","ordinal":96361,"en":"My brother-in-law slaughtered."},{"id":"semetey-1-2013:p0254:b004:l033","ordinal":96362,"en":"His own will throughout the world,"},{"id":"semetey-1-2013:p0254:b004:l034","ordinal":96363,"en":"My brother-in-law carried out."},{"id":"semetey-1-2013:p0254:b004:l035","ordinal":96364,"en":"This Muslim faith, Islam,"},{"id":"semetey-1-2013:p0254:b004:l036","ordinal":96365,"en":"My brother-in-law protected."},{"id":"semetey-1-2013:p0254:b004:l037","ordinal":96366,"en":"He received a letter from the caliph,"},{"id":"semetey-1-2013:p0254:b004:l038","ordinal":96367,"en":"He himself received Khan-Khoja's blessing."},{"id":"semetey-1-2013:p0254:b004:l039","ordinal":96368,"en":"My dear brother-in-law, gone to the other world,"},{"id":"semetey-1-2013:p0255:b003:l001","ordinal":96369,"en":"Was called the renowned conqueror."},{"id":"semetey-1-2013:p0255:b003:l002","ordinal":96370,"en":"He raided Ombu and took spoils,"},{"id":"semetey-1-2013:p0255:b003:l003","ordinal":96371,"en":"Shattered many a land,"},{"id":"semetey-1-2013:p0255:b003:l004","ordinal":96372,"en":"Devastated without measure and took spoils."},{"id":"semetey-1-2013:p0255:b003:l005","ordinal":96373,"en":"My brother-in-law Manas, the leopard,"},{"id":"semetey-1-2013:p0255:b003:l006","ordinal":96374,"en":"Went and raided the Afghans."},{"id":"semetey-1-2013:p0255:b003:l007","ordinal":96375,"en":"Untouched by my brother-in-law's hand,"},{"id":"semetey-1-2013:p0255:b003:l008","ordinal":96376,"en":"How could Margalang have remained unharmed?"},{"id":"semetey-1-2013:p0255:b003:l009","ordinal":96377,"en":"Untrodden by his horse Akkula,"},{"id":"semetey-1-2013:p0255:b003:l010","ordinal":96378,"en":"No whole tract of land remained."},{"id":"semetey-1-2013:p0255:b003:l011","ordinal":96379,"en":"Without having heard his battle cry,"},{"id":"semetey-1-2013:p0255:b003:l012","ordinal":96380,"en":"No whole people remained."},{"id":"semetey-1-2013:p0255:b003:l013","ordinal":96381,"en":"My brother-in-law, seized by his valor,"},{"id":"semetey-1-2013:p0255:b003:l014","ordinal":96382,"en":"Gathered the Muslim people."},{"id":"semetey-1-2013:p0255:b003:l015","ordinal":96383,"en":"Into dark, looming Beijing,"},{"id":"semetey-1-2013:p0255:b003:l016","ordinal":96384,"en":"He went straight, thrusting his spear firmly."},{"id":"semetey-1-2013:p0255:b003:l017","ordinal":96385,"en":"With four hundred thousand troops, my brother-in-law"},{"id":"semetey-1-2013:p0255:b003:l018","ordinal":96386,"en":"Smashed and slaughtered the Chinese."},{"id":"semetey-1-2013:p0255:b003:l019","ordinal":96387,"en":"Ruling Beijing,"},{"id":"semetey-1-2013:p0255:b003:l020","ordinal":96388,"en":"He held inquiries for six months."},{"id":"semetey-1-2013:p0255:b003:l021","ordinal":96389,"en":"That brother-in-law of mine has died."},{"id":"semetey-1-2013:p0255:b003:l022","ordinal":96390,"en":"The countless riches he left,"},{"id":"semetey-1-2013:p0255:b003:l023","ordinal":96391,"en":"All those foolish dogs"},{"id":"semetey-1-2013:p0255:b003:l024","ordinal":96392,"en":"Divided, measuring shares with a whip."},{"id":"semetey-1-2013:p0255:b003:l025","ordinal":96393,"en":"Horses with pied heads on the hills,"},{"id":"semetey-1-2013:p0255:b003:l026","ordinal":96394,"en":"Thoroughbreds and racers mingled—"},{"id":"semetey-1-2013:p0255:b003:l027","ordinal":96395,"en":"When my brother-in-law passed away,"},{"id":"semetey-1-2013:p0255:b003:l028","ordinal":96396,"en":"There was no way to catch and ride one."},{"id":"semetey-1-2013:p0255:b003:l029","ordinal":96397,"en":"When my leopard brother-in-law passed away,"},{"id":"semetey-1-2013:p0255:b003:l030","ordinal":96398,"en":"No son remained behind."},{"id":"semetey-1-2013:p0255:b003:l031","ordinal":96399,"en":"She trotted like a hunting hound;"},{"id":"semetey-1-2013:p0255:b003:l032","ordinal":96400,"en":"Hardship fell upon her head."},{"id":"semetey-1-2013:p0255:b003:l033","ordinal":96401,"en":"Wandering from Talas, my elder sister"},{"id":"semetey-1-2013:p0255:b003:l034","ordinal":96402,"en":"Came to broad Bukhara."},{"id":"semetey-1-2013:p0255:b003:l035","ordinal":96403,"en":"When my leopard brother-in-law died,"},{"id":"semetey-1-2013:p0255:b003:l036","ordinal":96404,"en":"My dear elder sister Kanykei,"},{"id":"semetey-1-2013:p0255:b003:l037","ordinal":96405,"en":"How much humiliation she suffered!"},{"id":"semetey-1-2013:p0255:b003:l038","ordinal":96406,"en":"When my valiant brother-in-law died,"},{"id":"semetey-1-2013:p0255:b003:l039","ordinal":96407,"en":"The countless riches left by the warrior,"},{"id":"semetey-1-2013:p0255:b004:l001","ordinal":96408,"en":"Those base, wicked-hearted dogs"},{"id":"semetey-1-2013:p0255:b004:l002","ordinal":96409,"en":"Divided, measuring shares with a whip."},{"id":"semetey-1-2013:p0255:b004:l003","ordinal":96410,"en":"She came wandering to settle in Bukhara;"},{"id":"semetey-1-2013:p0255:b004:l004","ordinal":96411,"en":"This elder sister of mine was slandered."},{"id":"semetey-1-2013:p0255:b004:l005","ordinal":96412,"en":"What God lays upon one's head,"},{"id":"semetey-1-2013:p0255:b004:l006","ordinal":96413,"en":"There is no choice but to bear."},{"id":"semetey-1-2013:p0255:b004:l007","ordinal":96414,"en":"When my fierce brother-in-law died,"},{"id":"semetey-1-2013:p0255:b004:l008","ordinal":96415,"en":"When my elder sister came wandering,"},{"id":"semetey-1-2013:p0255:b004:l009","ordinal":96416,"en":"No son remained behind."},{"id":"semetey-1-2013:p0255:b004:l010","ordinal":96417,"en":"The broad valley among rolling hills,"},{"id":"semetey-1-2013:p0255:b004:l011","ordinal":96418,"en":"Let us not leave it without a spring."},{"id":"semetey-1-2013:p0255:b004:l012","ordinal":96419,"en":"My unlucky elder sister,"},{"id":"semetey-1-2013:p0255:b004:l013","ordinal":96420,"en":"Let us not leave her as though without offspring."},{"id":"semetey-1-2013:p0255:b004:l014","ordinal":96421,"en":"My fierce, valiant elder sister"},{"id":"semetey-1-2013:p0255:b004:l015","ordinal":96422,"en":"Has no waist to gird herself with,"},{"id":"semetey-1-2013:p0255:b004:l016","ordinal":96423,"en":"She has no support left by her khan,"},{"id":"semetey-1-2013:p0255:b004:l017","ordinal":96424,"en":"No renowned Kyrgyz people."},{"id":"semetey-1-2013:p0255:b004:l018","ordinal":96425,"en":"Once the Creator lays it upon one's head,"},{"id":"semetey-1-2013:p0255:b004:l019","ordinal":96426,"en":"There is no choice but to bear."},{"id":"semetey-1-2013:p0255:b004:l020","ordinal":96427,"en":"To cherish, left by the fierce warrior,"},{"id":"semetey-1-2013:p0255:b004:l021","ordinal":96428,"en":"There is no child remaining behind."},{"id":"semetey-1-2013:p0255:b004:l022","ordinal":96429,"en":"This wretched world, so scant of fidelity—"},{"id":"semetey-1-2013:p0255:b004:l023","ordinal":96430,"en":"Listen without shame, strongmen:"},{"id":"semetey-1-2013:p0255:b004:l024","ordinal":96431,"en":"Such is this wretched world."},{"id":"semetey-1-2013:p0255:b004:l025","ordinal":96432,"en":"I heard news from those who came."},{"id":"semetey-1-2013:p0255:b004:l026","ordinal":96433,"en":"My dear elder sister Kanykei,"},{"id":"semetey-1-2013:p0255:b004:l027","ordinal":96434,"en":"As a test of fate in Bukhara,"},{"id":"semetey-1-2013:p0255:b004:l028","ordinal":96435,"en":"Has entered Taytoru in the race, I heard."},{"id":"semetey-1-2013:p0255:b004:l029","ordinal":96436,"en":"If Taytoru comes to the front,"},{"id":"semetey-1-2013:p0255:b004:l030","ordinal":96437,"en":"Let us urge him onward without reserve."},{"id":"semetey-1-2013:p0255:b004:l031","ordinal":96438,"en":"Let us raise the battle cry, 'Manas!'"},{"id":"semetey-1-2013:p0255:b004:l032","ordinal":96439,"en":"Wherever Taytoru may be,"},{"id":"semetey-1-2013:p0255:b004:l033","ordinal":96440,"en":"Let us urge only him onward."},{"id":"semetey-1-2013:p0255:b004:l034","ordinal":96441,"en":"My father's Aktulpar,"},{"id":"semetey-1-2013:p0255:b004:l035","ordinal":96442,"en":"If he comes to the front, let us slaughter him."},{"id":"semetey-1-2013:p0255:b004:l036","ordinal":96443,"en":"Without sparing Bukhara's four noble steeds,"},{"id":"semetey-1-2013:p0255:b004:l037","ordinal":96444,"en":"Let us slaughter them all."},{"id":"semetey-1-2013:p0255:b004:l038","ordinal":96445,"en":"All the horses that have owners,"},{"id":"semetey-1-2013:p0255:b004:l039","ordinal":96446,"en":"Let us slaughter every one."},{"id":"semetey-1-2013:p0256:b003:l001","ordinal":96447,"en":"If my elder sister's horse is there,"},{"id":"semetey-1-2013:p0256:b003:l002","ordinal":96448,"en":"Let us leave that one alive."},{"id":"semetey-1-2013:p0256:b003:l003","ordinal":96449,"en":"Today let us cry our battle cry, 'Manas!'"},{"id":"semetey-1-2013:p0256:b003:l004","ordinal":96450,"en":"Let us cheer Taytoru on."},{"id":"semetey-1-2013:p0256:b003:l005","ordinal":96451,"en":"If I start such a quarrel,"},{"id":"semetey-1-2013:p0256:b003:l006","ordinal":96452,"en":"If I kill their horses,"},{"id":"semetey-1-2013:p0256:b003:l007","ordinal":96453,"en":"Lasting torment and great quarrel—"},{"id":"semetey-1-2013:p0256:b003:l008","ordinal":96454,"en":"Swear on the Quran that I shall not bear them."},{"id":"semetey-1-2013:p0256:b003:l009","ordinal":96455,"en":"A single word such as this—"},{"id":"semetey-1-2013:p0256:b003:l010","ordinal":96456,"en":"Swear on the Quran that you shall not tell it!'"},{"id":"semetey-1-2013:p0256:b003:l011","ordinal":96457,"en":"Then Semetey spoke thus"},{"id":"semetey-1-2013:p0256:b003:l012","ordinal":96458,"en":"And turned his courser's head."},{"id":"semetey-1-2013:p0256:b003:l013","ordinal":96459,"en":"Unable to stand still, from the champions"},{"id":"semetey-1-2013:p0256:b003:l014","ordinal":96460,"en":"He demanded an oath."},{"id":"semetey-1-2013:p0256:b003:l015","ordinal":96461,"en":"All the champions—"},{"id":"semetey-1-2013:p0256:b003:l016","ordinal":96462,"en":"With the boy standing thus,"},{"id":"semetey-1-2013:p0256:b003:l017","ordinal":96463,"en":"How could they refuse assent?"},{"id":"semetey-1-2013:p0256:b003:l018","ordinal":96464,"en":"The champions dismounted,"},{"id":"semetey-1-2013:p0256:b003:l019","ordinal":96465,"en":"Chewed grains of white wheat,"},{"id":"semetey-1-2013:p0256:b003:l020","ordinal":96466,"en":"Saying, 'We shall not tell,'"},{"id":"semetey-1-2013:p0256:b003:l021","ordinal":96467,"en":"And swore by the holy creed."},{"id":"semetey-1-2013:p0256:b003:l022","ordinal":96468,"en":"Licking deadly poison,"},{"id":"semetey-1-2013:p0256:b003:l023","ordinal":96469,"en":"They swore a deathly oath:"},{"id":"semetey-1-2013:p0256:b003:l024","ordinal":96470,"en":"'Let it be as you say, hero!"},{"id":"semetey-1-2013:p0256:b003:l025","ordinal":96471,"en":"If we let this matter out,"},{"id":"semetey-1-2013:p0256:b003:l026","ordinal":96472,"en":"May seven generations of our fathers be infidels!'"},{"id":"semetey-1-2013:p0256:b003:l027","ordinal":96473,"en":"Semetey, at twelve,"},{"id":"semetey-1-2013:p0256:b003:l028","ordinal":96474,"en":"Revealed his terrible might,"},{"id":"semetey-1-2013:p0256:b003:l029","ordinal":96475,"en":"And made the formidable champions"},{"id":"semetey-1-2013:p0256:b003:l030","ordinal":96476,"en":"Obey him in this fashion."},{"id":"semetey-1-2013:p0256:b003:l031","ordinal":96477,"en":"His blue robe of light baran cloth"},{"id":"semetey-1-2013:p0256:b003:l032","ordinal":96478,"en":"He took off again and folded."},{"id":"semetey-1-2013:p0256:b003:l033","ordinal":96479,"en":"Ill-omened Semetey,"},{"id":"semetey-1-2013:p0256:b003:l034","ordinal":96480,"en":"In his haste, secured the robe"},{"id":"semetey-1-2013:p0256:b003:l035","ordinal":96481,"en":"To his saddle straps."},{"id":"semetey-1-2013:p0256:b003:l036","ordinal":96482,"en":"He arrayed his arms for war,"},{"id":"semetey-1-2013:p0256:b003:l037","ordinal":96483,"en":"With a broad banner and painted spear,"},{"id":"semetey-1-2013:p0256:b003:l038","ordinal":96484,"en":"Arming himself as of old."},{"id":"semetey-1-2013:p0256:b003:l039","ordinal":96485,"en":"His mighty, gate-sized teeth"},{"id":"semetey-1-2013:p0256:b004:l001","ordinal":96486,"en":"Broke into pieces like grains of millet."},{"id":"semetey-1-2013:p0256:b004:l002","ordinal":96487,"en":"Of his father, Sultan Manas,"},{"id":"semetey-1-2013:p0256:b004:l003","ordinal":96488,"en":"He looked the very image."},{"id":"semetey-1-2013:p0256:b004:l004","ordinal":96489,"en":"Surpassing his father, fierce Manas,"},{"id":"semetey-1-2013:p0256:b004:l005","ordinal":96490,"en":"Was this marvel of a son."},{"id":"semetey-1-2013:p0256:b004:l006","ordinal":96491,"en":"Semetey was in haste"},{"id":"semetey-1-2013:p0256:b004:l007","ordinal":96492,"en":"To cheer Taytoru on;"},{"id":"semetey-1-2013:p0256:b004:l008","ordinal":96493,"en":"If another horse were ahead,"},{"id":"semetey-1-2013:p0256:b004:l009","ordinal":96494,"en":"His frenzy would seize him hard:"},{"id":"semetey-1-2013:p0256:b004:l010","ordinal":96495,"en":"He would kill them all."},{"id":"semetey-1-2013:p0256:b004:l011","ordinal":96496,"en":"Drawn by his blood, unable to stop,"},{"id":"semetey-1-2013:p0256:b004:l012","ordinal":96497,"en":"The dear boy could not keep still."},{"id":"semetey-1-2013:p0256:b004:l013","ordinal":96498,"en":"The mount beneath him"},{"id":"semetey-1-2013:p0256:b004:l014","ordinal":96499,"en":"Was Temir Khan's courser;"},{"id":"semetey-1-2013:p0256:b004:l015","ordinal":96500,"en":"What he held in his hand"},{"id":"semetey-1-2013:p0256:b004:l016","ordinal":96501,"en":"Was Ysmayyl's steel."},{"id":"semetey-1-2013:p0256:b004:l017","ordinal":96502,"en":"Settling himself, he stood upon his honor,"},{"id":"semetey-1-2013:p0256:b004:l018","ordinal":96503,"en":"With Arkesken girt at his side."},{"id":"semetey-1-2013:p0256:b004:l019","ordinal":96504,"en":"Stretching like a lion,"},{"id":"semetey-1-2013:p0256:b004:l020","ordinal":96505,"en":"Unable to restrain his excitement,"},{"id":"semetey-1-2013:p0256:b004:l021","ordinal":96506,"en":"He was ready to draw a line,"},{"id":"semetey-1-2013:p0256:b004:l022","ordinal":96507,"en":"Slaughtering and smashing the horses:"},{"id":"semetey-1-2013:p0256:b004:l023","ordinal":96508,"en":"The boy was ready to make a spectacle."},{"id":"semetey-1-2013:p0256:b004:l024","ordinal":96509,"en":"If Taytoru were left behind,"},{"id":"semetey-1-2013:p0256:b004:l025","ordinal":96510,"en":"He would plunder their possessions."},{"id":"semetey-1-2013:p0256:b004:l026","ordinal":96511,"en":"The boy raged, unable to stop,"},{"id":"semetey-1-2013:p0256:b004:l027","ordinal":96512,"en":"Ready to wreak utter havoc."}]
