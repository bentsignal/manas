[{"id":"semetey-1-2013:p1098:b007:l002","ordinal":160001,"en":"And that Karkyra, the place for his feast,"},{"id":"semetey-1-2013:p1098:b007:l003","ordinal":160002,"en":"Had every blessing in full."},{"id":"semetey-1-2013:p1098:b007:l004","ordinal":160003,"en":"Kökötöy's son Bokmurun"},{"id":"semetey-1-2013:p1098:b007:l005","ordinal":160004,"en":"Issued a decree to the Kyrgyz in Tashkent,"},{"id":"semetey-1-2013:p1098:b007:l006","ordinal":160005,"en":"Gathering his strength,"},{"id":"semetey-1-2013:p1098:b007:l007","ordinal":160006,"en":"And whoever refused to heed him—"},{"id":"semetey-1-2013:p1099:b003:l001","ordinal":160007,"en":"He put each household in proper order,"},{"id":"semetey-1-2013:p1099:b003:l002","ordinal":160008,"en":"The fires of the teeming multitude"},{"id":"semetey-1-2013:p1099:b003:l003","ordinal":160009,"en":"He had extinguished,"},{"id":"semetey-1-2013:p1099:b003:l004","ordinal":160010,"en":"And moved them all together."},{"id":"semetey-1-2013:p1099:b003:l005","ordinal":160011,"en":"He had the ornate gray yurts'"},{"id":"semetey-1-2013:p1099:b003:l006","ordinal":160012,"en":"Wall frames and roof poles folded,"},{"id":"semetey-1-2013:p1099:b003:l007","ordinal":160013,"en":"And loaded them on red camels."},{"id":"semetey-1-2013:p1099:b003:l008","ordinal":160014,"en":"They dismantled the yurts without straying,"},{"id":"semetey-1-2013:p1099:b003:l009","ordinal":160015,"en":"And crossed the water without delay;"},{"id":"semetey-1-2013:p1099:b003:l010","ordinal":160016,"en":"They drew the red camels' tails"},{"id":"semetey-1-2013:p1099:b003:l011","ordinal":160017,"en":"Diagonally up the slope."},{"id":"semetey-1-2013:p1099:b003:l012","ordinal":160018,"en":"Calling it Khan Kökötöy's migration,"},{"id":"semetey-1-2013:p1099:b003:l013","ordinal":160019,"en":"He made all the people"},{"id":"semetey-1-2013:p1099:b003:l014","ordinal":160020,"en":"See its splendor."},{"id":"semetey-1-2013:p1099:b003:l015","ordinal":160021,"en":"Kökötöy's great wealth"},{"id":"semetey-1-2013:p1099:b003:l016","ordinal":160022,"en":"He had loaded on countless gelded camels."},{"id":"semetey-1-2013:p1099:b003:l017","ordinal":160023,"en":"He arrayed them all in splendor"},{"id":"semetey-1-2013:p1099:b003:l018","ordinal":160024,"en":"And covered them with robes of honor."},{"id":"semetey-1-2013:p1099:b003:l019","ordinal":160025,"en":"He dressed the graceful girls"},{"id":"semetey-1-2013:p1099:b003:l020","ordinal":160026,"en":"In red robes,"},{"id":"semetey-1-2013:p1099:b003:l021","ordinal":160027,"en":"Letting the hems of their red robes"},{"id":"semetey-1-2013:p1099:b003:l022","ordinal":160028,"en":"Trail diagonally upon the ground,"},{"id":"semetey-1-2013:p1099:b003:l023","ordinal":160029,"en":"And Kökötöy's son Bokmurun"},{"id":"semetey-1-2013:p1099:b003:l024","ordinal":160030,"en":"Made his prowess known."},{"id":"semetey-1-2013:p1099:b003:l025","ordinal":160031,"en":"He dressed the brides in kete cloth,"},{"id":"semetey-1-2013:p1099:b003:l026","ordinal":160032,"en":"Letting the hems of their kete coats"},{"id":"semetey-1-2013:p1099:b003:l027","ordinal":160033,"en":"Spread wide and touch the ground,"},{"id":"semetey-1-2013:p1099:b003:l028","ordinal":160034,"en":"And Kökötöy's son Bokmurun"},{"id":"semetey-1-2013:p1099:b003:l029","ordinal":160035,"en":"Made his generosity known to the people."},{"id":"semetey-1-2013:p1099:b003:l030","ordinal":160036,"en":"He had the swift horse Maaniker"},{"id":"semetey-1-2013:p1099:b003:l031","ordinal":160037,"en":"Tethered beneath a rich caparison."},{"id":"semetey-1-2013:p1099:b003:l032","ordinal":160038,"en":"He opened up forty rooms of yellow gold"},{"id":"semetey-1-2013:p1099:b003:l033","ordinal":160039,"en":"And spread it all on display."},{"id":"semetey-1-2013:p1099:b003:l034","ordinal":160040,"en":"He had all that gold"},{"id":"semetey-1-2013:p1099:b003:l035","ordinal":160041,"en":"Folded into great bundles"},{"id":"semetey-1-2013:p1099:b003:l036","ordinal":160042,"en":"And loaded on yellow gelded camels."},{"id":"semetey-1-2013:p1099:b003:l037","ordinal":160043,"en":"He extinguished the fires lit"},{"id":"semetey-1-2013:p1099:b003:l038","ordinal":160044,"en":"By the Kyrgyz of Tashkent"},{"id":"semetey-1-2013:p1099:b003:l039","ordinal":160045,"en":"And moved them all together."},{"id":"semetey-1-2013:p1099:b005:l001","ordinal":160046,"en":"He raised skyward"},{"id":"semetey-1-2013:p1099:b005:l002","ordinal":160047,"en":"The red banner with its golden finial;"},{"id":"semetey-1-2013:p1099:b005:l003","ordinal":160048,"en":"Infidels and Muslims alike,"},{"id":"semetey-1-2013:p1099:b005:l004","ordinal":160049,"en":"Toward the frontier at Karkyra,"},{"id":"semetey-1-2013:p1099:b005:l005","ordinal":160050,"en":"He set them heading for Karkyra."},{"id":"semetey-1-2013:p1099:b005:l006","ordinal":160051,"en":"When Kökötöy's son Bokmurun"},{"id":"semetey-1-2013:p1099:b005:l007","ordinal":160052,"en":"Moved out from Tashkent,"},{"id":"semetey-1-2013:p1099:b005:l008","ordinal":160053,"en":"He had me mounted on a dappled bay pacer,"},{"id":"semetey-1-2013:p1099:b005:l009","ordinal":160054,"en":"Dressed me in a robe of silk,"},{"id":"semetey-1-2013:p1099:b005:l010","ordinal":160055,"en":"And led me along to the feast."},{"id":"semetey-1-2013:p1099:b005:l011","ordinal":160056,"en":"He had me mounted on a yellow-dappled pacer,"},{"id":"semetey-1-2013:p1099:b005:l012","ordinal":160057,"en":"Dressed me in a robe of honor,"},{"id":"semetey-1-2013:p1099:b005:l013","ordinal":160058,"en":"And led me among the multitude."},{"id":"semetey-1-2013:p1099:b005:l014","ordinal":160059,"en":"At that time my head"},{"id":"semetey-1-2013:p1099:b005:l015","ordinal":160060,"en":"Barely rose above the saddle basket;"},{"id":"semetey-1-2013:p1099:b005:l016","ordinal":160061,"en":"At that time my age"},{"id":"semetey-1-2013:p1099:b005:l017","ordinal":160062,"en":"Had barely reached six years."},{"id":"semetey-1-2013:p1099:b005:l018","ordinal":160063,"en":"At Kökötöy's memorial feast,"},{"id":"semetey-1-2013:p1099:b005:l019","ordinal":160064,"en":"Koshoy went and I went;"},{"id":"semetey-1-2013:p1099:b005:l020","ordinal":160065,"en":"Alas, you are Kozho—"},{"id":"semetey-1-2013:p1099:b005:l021","ordinal":160066,"en":"When did you ever go with us?"},{"id":"semetey-1-2013:p1099:b005:l022","ordinal":160067,"en":"These are the words I have spoken,"},{"id":"semetey-1-2013:p1099:b005:l023","ordinal":160068,"en":"Saying you are an extraordinary Kozho."},{"id":"semetey-1-2013:p1099:b005:l024","ordinal":160069,"en":"That was the time I went and saw"},{"id":"semetey-1-2013:p1099:b005:l025","ordinal":160070,"en":"Kökötöy's great multitude."},{"id":"semetey-1-2013:p1099:b005:l026","ordinal":160071,"en":"Tens of thousands of massed camels,"},{"id":"semetey-1-2013:p1099:b005:l027","ordinal":160072,"en":"And joining those camels,"},{"id":"semetey-1-2013:p1099:b005:l028","ordinal":160073,"en":"Many more camels in abundance."},{"id":"semetey-1-2013:p1099:b005:l029","ordinal":160074,"en":"Everyone who saw"},{"id":"semetey-1-2013:p1099:b005:l030","ordinal":160075,"en":"Kökötöy's caravan was amazed,"},{"id":"semetey-1-2013:p1099:b005:l031","ordinal":160076,"en":"And many people asked one another:"},{"id":"semetey-1-2013:p1099:b005:l032","ordinal":160077,"en":"“Good people, whose are these countless camels?"},{"id":"semetey-1-2013:p1099:b005:l033","ordinal":160078,"en":"They are the camels of heroic Khan Kökötöy,"},{"id":"semetey-1-2013:p1099:b005:l034","ordinal":160079,"en":"The camels that carry rice."},{"id":"semetey-1-2013:p1099:b005:l035","ordinal":160080,"en":"Whose are these countless men on foot?"},{"id":"semetey-1-2013:p1099:b005:l036","ordinal":160081,"en":"They are Kökötöy's footmen,"},{"id":"semetey-1-2013:p1099:b005:l037","ordinal":160082,"en":"Who render service.”"},{"id":"semetey-1-2013:p1099:b005:l038","ordinal":160083,"en":"His wife Külayym—"},{"id":"semetey-1-2013:p1099:b005:l039","ordinal":160084,"en":"He dressed her in sweeping black,"},{"id":"semetey-1-2013:p1100:b003:l001","ordinal":160085,"en":"Making Khan Kökötöy's funeral honors"},{"id":"semetey-1-2013:p1100:b003:l002","ordinal":160086,"en":"Known to the people,"},{"id":"semetey-1-2013:p1100:b003:l003","ordinal":160087,"en":"He had baggage loaded on gelded camels"},{"id":"semetey-1-2013:p1100:b003:l004","ordinal":160088,"en":"And had some sixty women"},{"id":"semetey-1-2013:p1100:b003:l005","ordinal":160089,"en":"All sing the lament."},{"id":"semetey-1-2013:p1100:b003:l006","ordinal":160090,"en":"Boys and old men drove the livestock,"},{"id":"semetey-1-2013:p1100:b003:l007","ordinal":160091,"en":"Rushing in from every side."},{"id":"semetey-1-2013:p1100:b003:l008","ordinal":160092,"en":"At the head of the caravan was Külayym;"},{"id":"semetey-1-2013:p1100:b003:l009","ordinal":160093,"en":"Sixty women lamenters"},{"id":"semetey-1-2013:p1100:b003:l010","ordinal":160094,"en":"All wailed and wept."},{"id":"semetey-1-2013:p1100:b003:l011","ordinal":160095,"en":"Her trailing hem swept the ground,"},{"id":"semetey-1-2013:p1100:b003:l012","ordinal":160096,"en":"And her solitary lament split heads."},{"id":"semetey-1-2013:p1100:b003:l013","ordinal":160097,"en":"They migrated, covering the land,"},{"id":"semetey-1-2013:p1100:b003:l014","ordinal":160098,"en":"Tethering foals and yearlings together,"},{"id":"semetey-1-2013:p1100:b003:l015","ordinal":160099,"en":"And tying mares as they moved."},{"id":"semetey-1-2013:p1100:b003:l016","ordinal":160100,"en":"All the camel calves roared;"},{"id":"semetey-1-2013:p1100:b003:l017","ordinal":160101,"en":"All the foals whinnied."},{"id":"semetey-1-2013:p1100:b003:l018","ordinal":160102,"en":"When one looked at the festive caravan,"},{"id":"semetey-1-2013:p1100:b003:l019","ordinal":160103,"en":"Kökötöy's migration"},{"id":"semetey-1-2013:p1100:b003:l020","ordinal":160104,"en":"Was a spectacle to all who saw it."},{"id":"semetey-1-2013:p1100:b003:l021","ordinal":160105,"en":"Kökötöy's son Bokmurun"},{"id":"semetey-1-2013:p1100:b003:l022","ordinal":160106,"en":"Departed without seeking counsel"},{"id":"semetey-1-2013:p1100:b003:l023","ordinal":160107,"en":"From imposing Manas."},{"id":"semetey-1-2013:p1100:b003:l024","ordinal":160108,"en":"He passed Aulie-Ata and Talas"},{"id":"semetey-1-2013:p1100:b003:l025","ordinal":160109,"en":"One after the other."},{"id":"semetey-1-2013:p1100:b003:l026","ordinal":160110,"en":"There was no mountain as small as an ankle bone,"},{"id":"semetey-1-2013:p1100:b003:l027","ordinal":160111,"en":"No hollow where a saddle blanket could sink;"},{"id":"semetey-1-2013:p1100:b003:l028","ordinal":160112,"en":"The whole caravan spread across the land"},{"id":"semetey-1-2013:p1100:b003:l029","ordinal":160113,"en":"And entered the broad valley."},{"id":"semetey-1-2013:p1100:b003:l030","ordinal":160114,"en":"The earth grew dim and clouded;"},{"id":"semetey-1-2013:p1100:b003:l031","ordinal":160115,"en":"Kökötöy's countless livestock"},{"id":"semetey-1-2013:p1100:b003:l032","ordinal":160116,"en":"Became one with the face of the earth."},{"id":"semetey-1-2013:p1100:b003:l033","ordinal":160117,"en":"The grass growing upon the ground"},{"id":"semetey-1-2013:p1100:b003:l034","ordinal":160118,"en":"Was erased beneath their hooves;"},{"id":"semetey-1-2013:p1100:b003:l035","ordinal":160119,"en":"His wealth surpassed all men's,"},{"id":"semetey-1-2013:p1100:b003:l036","ordinal":160120,"en":"And his tusked beasts fed their fill."},{"id":"semetey-1-2013:p1100:b003:l037","ordinal":160121,"en":"Livestock of every kind streamed along;"},{"id":"semetey-1-2013:p1100:b003:l038","ordinal":160122,"en":"People of every kind streamed along."},{"id":"semetey-1-2013:p1100:b003:l039","ordinal":160123,"en":"At the head of the caravan, red camels,"},{"id":"semetey-1-2013:p1100:b004:l001","ordinal":160124,"en":"Their throats like leather buckets,"},{"id":"semetey-1-2013:p1100:b004:l002","ordinal":160125,"en":"Their tusks thrust outward,"},{"id":"semetey-1-2013:p1100:b004:l003","ordinal":160126,"en":"Their lower lips drooping,"},{"id":"semetey-1-2013:p1100:b004:l004","ordinal":160127,"en":"Striding ponderously,"},{"id":"semetey-1-2013:p1100:b004:l005","ordinal":160128,"en":"Their manes covered in dust—"},{"id":"semetey-1-2013:p1100:b004:l006","ordinal":160129,"en":"Many camels streamed along."},{"id":"semetey-1-2013:p1100:b004:l007","ordinal":160130,"en":"Their foals whinnying,"},{"id":"semetey-1-2013:p1100:b004:l008","ordinal":160131,"en":"Their bellies sweeping the ground,"},{"id":"semetey-1-2013:p1100:b004:l009","ordinal":160132,"en":"Many mares streamed along."},{"id":"semetey-1-2013:p1100:b004:l010","ordinal":160133,"en":"Skimming over the earth,"},{"id":"semetey-1-2013:p1100:b004:l011","ordinal":160134,"en":"Roaming along the cool valley,"},{"id":"semetey-1-2013:p1100:b004:l012","ordinal":160135,"en":"Their mighty horns thrust outward,"},{"id":"semetey-1-2013:p1100:b004:l013","ordinal":160136,"en":"Many cattle streamed along."},{"id":"semetey-1-2013:p1100:b004:l014","ordinal":160137,"en":"At Kozu-Bashy and Kopo,"},{"id":"semetey-1-2013:p1100:b004:l015","ordinal":160138,"en":"They fattened sheep there;"},{"id":"semetey-1-2013:p1100:b004:l016","ordinal":160139,"en":"They crossed every lovely place"},{"id":"semetey-1-2013:p1100:b004:l017","ordinal":160140,"en":"And passed along the mountain passes."},{"id":"semetey-1-2013:p1100:b004:l018","ordinal":160141,"en":"The caravan's qibla side"},{"id":"semetey-1-2013:p1100:b004:l019","ordinal":160142,"en":"Went along Kegen,"},{"id":"semetey-1-2013:p1100:b004:l020","ordinal":160143,"en":"And Bokmurun reached"},{"id":"semetey-1-2013:p1100:b004:l021","ordinal":160144,"en":"The broad plain of Karkyra."},{"id":"semetey-1-2013:p1100:b004:l022","ordinal":160145,"en":"He enclosed it from end to end,"},{"id":"semetey-1-2013:p1100:b004:l023","ordinal":160146,"en":"And Kökötöy's great royal pavilion"},{"id":"semetey-1-2013:p1100:b004:l024","ordinal":160147,"en":"He brought to the plain of Karkyra,"},{"id":"semetey-1-2013:p1100:b004:l025","ordinal":160148,"en":"Raised it, and set it in place."},{"id":"semetey-1-2013:p1100:b004:l026","ordinal":160149,"en":"Calling it Khan Kökötöy's feast,"},{"id":"semetey-1-2013:p1100:b004:l027","ordinal":160150,"en":"Calling it the banks of Karkyra,"},{"id":"semetey-1-2013:p1100:b004:l028","ordinal":160151,"en":"He covered the earth in dust"},{"id":"semetey-1-2013:p1100:b004:l029","ordinal":160152,"en":"And made it renowned among the people."},{"id":"semetey-1-2013:p1100:b004:l030","ordinal":160153,"en":"He had all his wealth made ready;"},{"id":"semetey-1-2013:p1100:b004:l031","ordinal":160154,"en":"Kökötöy's many young men"},{"id":"semetey-1-2013:p1100:b004:l032","ordinal":160155,"en":"Prepared firewood without pause."},{"id":"semetey-1-2013:p1100:b004:l033","ordinal":160156,"en":"At Kara-Saz in Karkyra,"},{"id":"semetey-1-2013:p1100:b004:l034","ordinal":160157,"en":"Becoming friends with Kalday,"},{"id":"semetey-1-2013:p1100:b004:l035","ordinal":160158,"en":"He boiled salt and obtained it."},{"id":"semetey-1-2013:p1100:b004:l036","ordinal":160159,"en":"Along Great Karkyra,"},{"id":"semetey-1-2013:p1100:b004:l037","ordinal":160160,"en":"His surging people now made camp."},{"id":"semetey-1-2013:p1100:b004:l038","ordinal":160161,"en":"For Khan Kökötöy's memorial feast,"},{"id":"semetey-1-2013:p1100:b004:l039","ordinal":160162,"en":"Infidels and Muslims alike—"},{"id":"semetey-1-2013:p1101:b003:l001","ordinal":160163,"en":"Their time to come had now arrived."},{"id":"semetey-1-2013:p1101:b003:l002","ordinal":160164,"en":"At Küdür in Ükürchü,"},{"id":"semetey-1-2013:p1101:b003:l003","ordinal":160165,"en":"He had the cattle driven out to graze."},{"id":"semetey-1-2013:p1101:b003:l004","ordinal":160166,"en":"Below Aygyr-Zhal,"},{"id":"semetey-1-2013:p1101:b003:l005","ordinal":160167,"en":"He had a great tethering line stretched."},{"id":"semetey-1-2013:p1101:b003:l006","ordinal":160168,"en":"Along Üch-Kapkak,"},{"id":"semetey-1-2013:p1101:b003:l007","ordinal":160169,"en":"For Kökötöy's cooking pits,"},{"id":"semetey-1-2013:p1101:b003:l008","ordinal":160170,"en":"He had the hearth pits dug."},{"id":"semetey-1-2013:p1101:b003:l009","ordinal":160171,"en":"To spacious Küdür,"},{"id":"semetey-1-2013:p1101:b003:l010","ordinal":160172,"en":"He had horses brought in."},{"id":"semetey-1-2013:p1101:b003:l011","ordinal":160173,"en":"On the far side of those horses,"},{"id":"semetey-1-2013:p1101:b003:l012","ordinal":160174,"en":"He had the heroes slaughter them."},{"id":"semetey-1-2013:p1101:b003:l013","ordinal":160175,"en":"For Kökötöy's feast,"},{"id":"semetey-1-2013:p1101:b003:l014","ordinal":160176,"en":"This was suitable food."},{"id":"semetey-1-2013:p1101:b003:l015","ordinal":160177,"en":"For the Shibee and the Kalmyks,"},{"id":"semetey-1-2013:p1101:b003:l016","ordinal":160178,"en":"So they might eat it when they came,"},{"id":"semetey-1-2013:p1101:b003:l017","ordinal":160179,"en":"He slaughtered mighty-horned oxen and cows."},{"id":"semetey-1-2013:p1101:b003:l018","ordinal":160180,"en":"For the Manchus and Black Chinese,"},{"id":"semetey-1-2013:p1101:b003:l019","ordinal":160181,"en":"So they might eat these when they came,"},{"id":"semetey-1-2013:p1101:b003:l020","ordinal":160182,"en":"He slaughtered camels suited to them."},{"id":"semetey-1-2013:p1101:b003:l021","ordinal":160183,"en":"For the Kyrgyz and Oyguts,"},{"id":"semetey-1-2013:p1101:b003:l022","ordinal":160184,"en":"He made merry and slaughtered mares."},{"id":"semetey-1-2013:p1101:b003:l023","ordinal":160185,"en":"Kökötöy's son Bokmurun"},{"id":"semetey-1-2013:p1101:b003:l024","ordinal":160186,"en":"Made it splendid and spacious,"},{"id":"semetey-1-2013:p1101:b003:l025","ordinal":160187,"en":"Devoting all his wealth equally."},{"id":"semetey-1-2013:p1101:b003:l026","ordinal":160188,"en":"He marked the midpoint"},{"id":"semetey-1-2013:p1101:b003:l027","ordinal":160189,"en":"Between the Black Kalmyks and Kyrgyz,"},{"id":"semetey-1-2013:p1101:b003:l028","ordinal":160190,"en":"And made this feast of Kökötöy"},{"id":"semetey-1-2013:p1101:b003:l029","ordinal":160191,"en":"Unforgettable to the people"},{"id":"semetey-1-2013:p1101:b003:l030","ordinal":160192,"en":"Until the end of time,"},{"id":"semetey-1-2013:p1101:b003:l031","ordinal":160193,"en":"Making meat as high as Ala-Too."},{"id":"semetey-1-2013:p1101:b003:l032","ordinal":160194,"en":"Leading the people,"},{"id":"semetey-1-2013:p1101:b003:l033","ordinal":160195,"en":"Your elder uncle Koshoy"},{"id":"semetey-1-2013:p1101:b003:l034","ordinal":160196,"en":"Raised the standard with its golden finial"},{"id":"semetey-1-2013:p1101:b003:l035","ordinal":160197,"en":"And sent it soaring into the sky."},{"id":"semetey-1-2013:p1101:b003:l036","ordinal":160198,"en":"The turmoil Bokmurun"},{"id":"semetey-1-2013:p1101:b003:l037","ordinal":160199,"en":"Brought upon the people!"},{"id":"semetey-1-2013:p1101:b003:l038","ordinal":160200,"en":"Your uncle came riding"},{"id":"semetey-1-2013:p1101:b003:l039","ordinal":160201,"en":"His swift Kerkabylan."},{"id":"semetey-1-2013:p1101:b004:l001","ordinal":160202,"en":"All his weapons made ready,"},{"id":"semetey-1-2013:p1101:b004:l002","ordinal":160203,"en":"He fitted the golden-cheeked battle-ax"},{"id":"semetey-1-2013:p1101:b004:l003","ordinal":160204,"en":"To his wrist."},{"id":"semetey-1-2013:p1101:b004:l004","ordinal":160205,"en":"His brow was high and his face imposing;"},{"id":"semetey-1-2013:p1101:b004:l005","ordinal":160206,"en":"Those who looked at him marveled."},{"id":"semetey-1-2013:p1101:b004:l006","ordinal":160207,"en":"Tall and broad-shouldered,"},{"id":"semetey-1-2013:p1101:b004:l007","ordinal":160208,"en":"Kökbörü, son of Urumkhan,"},{"id":"semetey-1-2013:p1101:b004:l008","ordinal":160209,"en":"Came from among those I had seen."},{"id":"semetey-1-2013:p1101:b004:l009","ordinal":160210,"en":"If you ask who came after him,"},{"id":"semetey-1-2013:p1101:b004:l010","ordinal":160211,"en":"Wearing a coat called chayingi,"},{"id":"semetey-1-2013:p1101:b004:l011","ordinal":160212,"en":"Riding a horse like Chalkuyruk,"},{"id":"semetey-1-2013:p1101:b004:l012","ordinal":160213,"en":"Carrying a spear without a tassel,"},{"id":"semetey-1-2013:p1101:b004:l013","ordinal":160214,"en":"With only a sword at his side,"},{"id":"semetey-1-2013:p1101:b004:l014","ordinal":160215,"en":"The youngest of nine sons,"},{"id":"semetey-1-2013:p1101:b004:l015","ordinal":160216,"en":"Eleman's cherished son,"},{"id":"semetey-1-2013:p1101:b004:l016","ordinal":160217,"en":"A servant of the one God."},{"id":"semetey-1-2013:p1101:b004:l017","ordinal":160218,"en":"It had been seven years"},{"id":"semetey-1-2013:p1101:b004:l018","ordinal":160219,"en":"Since he descended beneath the earth;"},{"id":"semetey-1-2013:p1101:b004:l019","ordinal":160220,"en":"It had been only seven days"},{"id":"semetey-1-2013:p1101:b004:l020","ordinal":160221,"en":"Since he emerged upon the earth."},{"id":"semetey-1-2013:p1101:b004:l021","ordinal":160222,"en":"When the seven-headed witch"},{"id":"semetey-1-2013:p1101:b004:l022","ordinal":160223,"en":"Worked her perfect spell,"},{"id":"semetey-1-2013:p1101:b004:l023","ordinal":160224,"en":"She frightened his father Eleman."},{"id":"semetey-1-2013:p1101:b004:l024","ordinal":160225,"en":"That old woman imprisoned Eleman"},{"id":"semetey-1-2013:p1101:b004:l025","ordinal":160226,"en":"For seven days,"},{"id":"semetey-1-2013:p1101:b004:l026","ordinal":160227,"en":"Tore out and flung away his beard,"},{"id":"semetey-1-2013:p1101:b004:l027","ordinal":160228,"en":"Yanked out and flung away his mustache,"},{"id":"semetey-1-2013:p1101:b004:l028","ordinal":160229,"en":"And beat him for seven days."},{"id":"semetey-1-2013:p1101:b004:l029","ordinal":160230,"en":"Softened like a worked hide,"},{"id":"semetey-1-2013:p1101:b004:l030","ordinal":160231,"en":"The wretched old man was exhausted."},{"id":"semetey-1-2013:p1101:b004:l031","ordinal":160232,"en":"She took brave Töshtük's knucklebone"},{"id":"semetey-1-2013:p1101:b004:l032","ordinal":160233,"en":"From his daughter-in-law."},{"id":"semetey-1-2013:p1101:b004:l033","ordinal":160234,"en":"Begging for his life, Eleman"},{"id":"semetey-1-2013:p1101:b004:l034","ordinal":160235,"en":"Went before the old woman."},{"id":"semetey-1-2013:p1101:b004:l035","ordinal":160236,"en":"Because his knucklebone had been left behind,"},{"id":"semetey-1-2013:p1101:b004:l036","ordinal":160237,"en":"Eleman's brave Töshtük"},{"id":"semetey-1-2013:p1101:b004:l037","ordinal":160238,"en":"Came the following day."},{"id":"semetey-1-2013:p1101:b004:l038","ordinal":160239,"en":"Beside that knucklebone,"},{"id":"semetey-1-2013:p1101:b004:l039","ordinal":160240,"en":"The seven-headed old woman saw him."},{"id":"semetey-1-2013:p1102:b003:l001","ordinal":160241,"en":"When she saw brave Töshtük,"},{"id":"semetey-1-2013:p1102:b003:l002","ordinal":160242,"en":"The old woman neighed,"},{"id":"semetey-1-2013:p1102:b003:l003","ordinal":160243,"en":"“Reap, my reaper, reap!”"},{"id":"semetey-1-2013:p1102:b003:l004","ordinal":160244,"en":"And made ready to reap him down."},{"id":"semetey-1-2013:p1102:b003:l005","ordinal":160245,"en":"Giving him no choice,"},{"id":"semetey-1-2013:p1102:b003:l006","ordinal":160246,"en":"The Töshtük who had come—"},{"id":"semetey-1-2013:p1102:b003:l007","ordinal":160247,"en":"She made ready to suck him dry."},{"id":"semetey-1-2013:p1102:b003:l008","ordinal":160248,"en":"The old woman grew wrathful"},{"id":"semetey-1-2013:p1102:b003:l009","ordinal":160249,"en":"And made ready to imprison him."},{"id":"semetey-1-2013:p1102:b003:l010","ordinal":160250,"en":"She made ready to beat Töshtük"},{"id":"semetey-1-2013:p1102:b003:l011","ordinal":160251,"en":"With resounding blows."},{"id":"semetey-1-2013:p1102:b003:l012","ordinal":160252,"en":"Unable to withstand her strength,"},{"id":"semetey-1-2013:p1102:b003:l013","ordinal":160253,"en":"Dear Töshtük grew alarmed."},{"id":"semetey-1-2013:p1102:b003:l014","ordinal":160254,"en":"He whipped Chalkuyruk beneath him"},{"id":"semetey-1-2013:p1102:b003:l015","ordinal":160255,"en":"This way and that,"},{"id":"semetey-1-2013:p1102:b003:l016","ordinal":160256,"en":"Spurring him on both sides."}]
