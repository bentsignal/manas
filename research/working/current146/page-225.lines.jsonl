{"id": "sayakbay-ms-current146:pdf225:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 225, "folio": 608, "line_in_page": 6, "raw": "Ордолуу элден айрылып,", "text": "Ордолуу элден айрылып,", "en": "Separated from the people of the royal camp.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf225:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 225, "folio": 608, "line_in_page": 7, "raw": "Жолго кирди жигит Достан,", "text": "Жолго кирди жигит Достан,", "en": "The young man Dostan took the road.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf225:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 225, "folio": 608, "line_in_page": 8, "raw": "Кайрылып адам тартпаган,", "text": "Кайрылып адам тартпаган,", "en": "He never turned and drew another man along.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
