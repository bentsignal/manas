[{"id":"seytek-2012:p0509:b002:l018","ordinal":332545,"en":"Abandoning these lives and dying."},{"id":"seytek-2012:p0509:b002:l019","ordinal":332546,"en":"Let us go into the fray;"},{"id":"seytek-2012:p0509:b002:l020","ordinal":332547,"en":"How can we lie grieving"},{"id":"seytek-2012:p0509:b002:l021","ordinal":332548,"en":"Now that Sarybay has come?"},{"id":"seytek-2012:p0509:b002:l022","ordinal":332549,"en":"We shall cast off humiliation like sheep."},{"id":"seytek-2012:p0509:b002:l023","ordinal":332550,"en":"If he overruns the encampment,"},{"id":"seytek-2012:p0509:b002:l024","ordinal":332551,"en":"Warrior, it will seem that we were afraid."},{"id":"seytek-2012:p0509:b002:l025","ordinal":332552,"en":"Let us unleash a dreadful conflict."},{"id":"seytek-2012:p0509:b002:l026","ordinal":332553,"en":"Against the infidel whose strength is full,"},{"id":"seytek-2012:p0509:b002:l027","ordinal":332554,"en":"Against the warrior who came desiring"},{"id":"seytek-2012:p0509:b002:l028","ordinal":332555,"en":"Battle, turmoil, and devastation,"},{"id":"seytek-2012:p0509:b002:l029","ordinal":332556,"en":"Let us march to holy war!"},{"id":"seytek-2012:p0509:b002:l030","ordinal":332557,"en":"If hostile death arrives, let us die;"},{"id":"seytek-2012:p0509:b002:l031","ordinal":332558,"en":"Let us test ourselves in combat.”"},{"id":"seytek-2012:p0509:b002:l032","ordinal":332559,"en":"So spoke Külchoro,"},{"id":"seytek-2012:p0509:b002:l033","ordinal":332560,"en":"And when the champion said these words,"},{"id":"seytek-2012:p0509:b002:l034","ordinal":332561,"en":"They agreed, accepting them as true."},{"id":"seytek-2012:p0509:b002:l035","ordinal":332562,"en":"All the weak-hearted grieved,"},{"id":"seytek-2012:p0509:b002:l036","ordinal":332563,"en":"But all the champions"},{"id":"seytek-2012:p0509:b002:l037","ordinal":332564,"en":"Rejoiced at the word of battle."},{"id":"seytek-2012:p0509:b002:l038","ordinal":332565,"en":"They donned their bulletproof coats,"},{"id":"seytek-2012:p0509:b002:l039","ordinal":332566,"en":"And girded on their finely tempered steel."},{"id":"seytek-2012:p0509:b002:l040","ordinal":332567,"en":"They arranged all their weapons,"},{"id":"seytek-2012:p0509:b003:l001","ordinal":332568,"en":"Preparing to scatter the four kinds of livestock,"},{"id":"seytek-2012:p0509:b003:l002","ordinal":332569,"en":"To bring disaster upon the people,"},{"id":"seytek-2012:p0509:b003:l003","ordinal":332570,"en":"And to put forward without exception"},{"id":"seytek-2012:p0509:b003:l004","ordinal":332571,"en":"Their cherished men and chiefs."},{"id":"seytek-2012:p0509:b003:l005","ordinal":332572,"en":"They meant to raid the ravines and seize possessions,"},{"id":"seytek-2012:p0509:b003:l006","ordinal":332573,"en":"Burn the narrow valleys and drive off the horses,"},{"id":"seytek-2012:p0509:b003:l007","ordinal":332574,"en":"To overtake those not yet claimed by death,"},{"id":"seytek-2012:p0509:b003:l008","ordinal":332575,"en":"And carry away as spoils"},{"id":"seytek-2012:p0509:b003:l009","ordinal":332576,"en":"The village beauties and widowed brides."},{"id":"seytek-2012:p0509:b003:l010","ordinal":332577,"en":"They fixed their hatred and prepared,"},{"id":"seytek-2012:p0509:b003:l011","ordinal":332578,"en":"Equipping themselves with weapons."},{"id":"seytek-2012:p0509:b003:l012","ordinal":332579,"en":"From the desert of El-Zhürbös"},{"id":"seytek-2012:p0509:b003:l013","ordinal":332580,"en":"And the pass of At-Baspas,"},{"id":"seytek-2012:p0509:b003:l014","ordinal":332581,"en":"They encountered the Black Giant."},{"id":"seytek-2012:p0509:b003:l015","ordinal":332582,"en":"Hostile death overtook the Black Giant;"},{"id":"seytek-2012:p0509:b003:l016","ordinal":332583,"en":"He clashed with them and was struck down,"},{"id":"seytek-2012:p0509:b003:l017","ordinal":332584,"en":"And thus the Black Giant died."},{"id":"seytek-2012:p0509:b003:l018","ordinal":332585,"en":"The warriors who remained"},{"id":"seytek-2012:p0509:b003:l019","ordinal":332586,"en":"Came fleeing in terror."},{"id":"seytek-2012:p0509:b003:l020","ordinal":332587,"en":"“Sarybay has slaughtered the people,” they said,"},{"id":"seytek-2012:p0509:b003:l021","ordinal":332588,"en":"“He has brought upon us"},{"id":"seytek-2012:p0509:b003:l022","ordinal":332589,"en":"Every strife and great conflict that accursed one knows.”"},{"id":"seytek-2012:p0509:b003:l023","ordinal":332590,"en":"They abandoned all their possessions,"},{"id":"seytek-2012:p0509:b003:l024","ordinal":332591,"en":"And many fled in panic."},{"id":"seytek-2012:p0509:b003:l025","ordinal":332592,"en":"The news had only just arrived,"},{"id":"seytek-2012:p0509:b003:l026","ordinal":332593,"en":"And the renowned men gathered."},{"id":"seytek-2012:p0509:b003:l027","ordinal":332594,"en":"When they beheld Sarybay’s fury,"},{"id":"seytek-2012:p0509:b003:l028","ordinal":332595,"en":"Some did not engage him in battle,"},{"id":"seytek-2012:p0509:b003:l029","ordinal":332596,"en":"Nor stand against him face-to-face."},{"id":"seytek-2012:p0509:b003:l030","ordinal":332597,"en":"The hearts of some men"},{"id":"seytek-2012:p0509:b003:l031","ordinal":332598,"en":"Utterly failed, and they died."},{"id":"seytek-2012:p0509:b003:l032","ordinal":332599,"en":"These very eyes beheld their deaths."},{"id":"seytek-2012:p0509:b003:l033","ordinal":332600,"en":"However fearsome Sarybay may be,"},{"id":"seytek-2012:p0509:b003:l034","ordinal":332601,"en":"Let us overwhelm him and unleash battle."},{"id":"seytek-2012:p0509:b003:l035","ordinal":332602,"en":"Let us go and bar the road"},{"id":"seytek-2012:p0509:b003:l036","ordinal":332603,"en":"Of that arrogant swine."},{"id":"seytek-2012:p0509:b003:l037","ordinal":332604,"en":"If he is a champion, let us fight him,"},{"id":"seytek-2012:p0509:b003:l038","ordinal":332605,"en":"Strip to the waist and spill blood,"},{"id":"seytek-2012:p0509:b003:l039","ordinal":332606,"en":"And stand amid the desperate struggle."},{"id":"seytek-2012:p0509:b003:l040","ordinal":332607,"en":"If Sarybay proves weak,"},{"id":"seytek-2012:p0510:b002:l001","ordinal":332608,"en":"They grasped the stout shafts"},{"id":"seytek-2012:p0510:b002:l002","ordinal":332609,"en":"Of their true-steel spears,"},{"id":"seytek-2012:p0510:b002:l003","ordinal":332610,"en":"While war banners rippled in their hands"},{"id":"seytek-2012:p0510:b002:l004","ordinal":332611,"en":"And black-steel Zulfikar swords"},{"id":"seytek-2012:p0510:b002:l005","ordinal":332612,"en":"Flashed in every hand."},{"id":"seytek-2012:p0510:b002:l006","ordinal":332613,"en":"Traveling by night and not by day,"},{"id":"seytek-2012:p0510:b002:l007","ordinal":332614,"en":"They raised war cries and a mighty clamor,"},{"id":"seytek-2012:p0510:b002:l008","ordinal":332615,"en":"Preparing the army and leading the host,"},{"id":"seytek-2012:p0510:b002:l009","ordinal":332616,"en":"Gathering all their forces together."},{"id":"seytek-2012:p0510:b002:l010","ordinal":332617,"en":"The earth shook beneath their streaming banners,"},{"id":"seytek-2012:p0510:b002:l011","ordinal":332618,"en":"And the uproar deafened every ear,"},{"id":"seytek-2012:p0510:b002:l012","ordinal":332619,"en":"Throwing the whole world into alarm."},{"id":"seytek-2012:p0510:b002:l013","ordinal":332620,"en":"He made Buurul beneath him"},{"id":"seytek-2012:p0510:b002:l014","ordinal":332621,"en":"Stride forward proudly."},{"id":"seytek-2012:p0510:b002:l015","ordinal":332622,"en":"A warrior’s courage split stones,"},{"id":"seytek-2012:p0510:b002:l016","ordinal":332623,"en":"And his battle cry split heads."},{"id":"seytek-2012:p0510:b002:l017","ordinal":332624,"en":"His great banner rippled,"},{"id":"seytek-2012:p0510:b002:l018","ordinal":332625,"en":"As the earth cracked and mountains fell,"},{"id":"seytek-2012:p0510:b002:l019","ordinal":332626,"en":"And the battle standards billowed,"},{"id":"seytek-2012:p0510:b002:l020","ordinal":332627,"en":"While the courageous thundered onward."},{"id":"seytek-2012:p0510:b002:l021","ordinal":332628,"en":"The marksmen whose shots never missed,"},{"id":"seytek-2012:p0510:b002:l022","ordinal":332629,"en":"He drove forward against the enemy’s flank,"},{"id":"seytek-2012:p0510:b002:l023","ordinal":332630,"en":"Along with the deftest spearmen"},{"id":"seytek-2012:p0510:b002:l024","ordinal":332631,"en":"And the strongest battle-axe wielders."},{"id":"seytek-2012:p0510:b002:l025","ordinal":332632,"en":"He sent onto the road"},{"id":"seytek-2012:p0510:b002:l026","ordinal":332633,"en":"Warriors who were wolves in battle"},{"id":"seytek-2012:p0510:b002:l027","ordinal":332634,"en":"And champions who knew the enemy’s stratagems."},{"id":"seytek-2012:p0510:b002:l028","ordinal":332635,"en":"The fleeing multitudes surged and scattered,"},{"id":"seytek-2012:p0510:b002:l029","ordinal":332636,"en":"And the solitary figure of one man"},{"id":"seytek-2012:p0510:b002:l030","ordinal":332637,"en":"Appeared as great as a thousand."},{"id":"seytek-2012:p0510:b002:l031","ordinal":332638,"en":"They donned bulletproof coats"},{"id":"seytek-2012:p0510:b002:l032","ordinal":332639,"en":"And chose to mount"},{"id":"seytek-2012:p0510:b002:l033","ordinal":332640,"en":"Stallions too swift for bullets to reach."},{"id":"seytek-2012:p0510:b002:l034","ordinal":332641,"en":"They selected and sharpened their spears,"},{"id":"seytek-2012:p0510:b002:l035","ordinal":332642,"en":"And the valiant warriors bound"},{"id":"seytek-2012:p0510:b002:l036","ordinal":332643,"en":"Their entrusted lives to a thread."},{"id":"seytek-2012:p0510:b002:l037","ordinal":332644,"en":"They leveled their muskets and fired,"},{"id":"seytek-2012:p0510:b002:l038","ordinal":332645,"en":"And the muskets’ reports rolled and boomed."},{"id":"seytek-2012:p0510:b002:l039","ordinal":332646,"en":"The host that rode out was ten thousand strong,"},{"id":"seytek-2012:p0510:b003:l001","ordinal":332647,"en":"Shouting, “Khan Manas!”"},{"id":"seytek-2012:p0510:b003:l002","ordinal":332648,"en":"Their champions led the way,"},{"id":"seytek-2012:p0510:b003:l003","ordinal":332649,"en":"The brass pipes blaring,"},{"id":"seytek-2012:p0510:b003:l004","ordinal":332650,"en":"And the trumpets sounding sharply."},{"id":"seytek-2012:p0510:b003:l005","ordinal":332651,"en":"No bird could fly through the broad valley"},{"id":"seytek-2012:p0510:b003:l006","ordinal":332652,"en":"As shrill notes rang from the brass horns."},{"id":"seytek-2012:p0510:b003:l007","ordinal":332653,"en":"The kettledrums deafened every ear,"},{"id":"seytek-2012:p0510:b003:l008","ordinal":332654,"en":"And courage poured from the champions,"},{"id":"seytek-2012:p0510:b003:l009","ordinal":332655,"en":"While their warriors and lions"},{"id":"seytek-2012:p0510:b003:l010","ordinal":332656,"en":"Spread out across the ridges."},{"id":"seytek-2012:p0510:b003:l011","ordinal":332657,"en":"They were a countless throng."},{"id":"seytek-2012:p0510:b003:l012","ordinal":332658,"en":"Beneath the banner rode Semetey,"},{"id":"seytek-2012:p0510:b003:l013","ordinal":332659,"en":"With Külchoro beside him,"},{"id":"seytek-2012:p0510:b003:l014","ordinal":332660,"en":"While dust covered the sky."},{"id":"seytek-2012:p0510:b003:l015","ordinal":332661,"en":"Brave Seytek led the host,"},{"id":"seytek-2012:p0510:b003:l016","ordinal":332662,"en":"Immovable as dark-blue steel."},{"id":"seytek-2012:p0510:b003:l017","ordinal":332663,"en":"Upon his head he wore"},{"id":"seytek-2012:p0510:b003:l018","ordinal":332664,"en":"A Kyrgyz cap with layered sable trim."},{"id":"seytek-2012:p0510:b003:l019","ordinal":332665,"en":"Surveying all, he led the army,"},{"id":"seytek-2012:p0510:b003:l020","ordinal":332666,"en":"Drawing the converging troops together."},{"id":"seytek-2012:p0510:b003:l021","ordinal":332667,"en":"Brave Seytek, commander of the host,"},{"id":"seytek-2012:p0510:b003:l022","ordinal":332668,"en":"Bore a steel-edged, ornamented spear,"},{"id":"seytek-2012:p0510:b003:l023","ordinal":332669,"en":"Marching against the warrior who made the earth split,"},{"id":"seytek-2012:p0510:b003:l024","ordinal":332670,"en":"The infidel Sarybay’s son."},{"id":"seytek-2012:p0510:b003:l025","ordinal":332671,"en":"He went to wage a fierce campaign"},{"id":"seytek-2012:p0510:b003:l026","ordinal":332672,"en":"And avenge the Black Giant."},{"id":"seytek-2012:p0510:b003:l027","ordinal":332673,"en":"Dust rose high enough to split the sky,"},{"id":"seytek-2012:p0510:b003:l028","ordinal":332674,"en":"As gray-wolf Seytek took the lead,"},{"id":"seytek-2012:p0510:b003:l029","ordinal":332675,"en":"Raising a wondrous tumult to behold"},{"id":"seytek-2012:p0510:b003:l030","ordinal":332676,"en":"And filling the earth with clamor."},{"id":"seytek-2012:p0510:b003:l031","ordinal":332677,"en":"Steel-tipped spears crossed,"},{"id":"seytek-2012:p0510:b003:l032","ordinal":332678,"en":"And a mighty battle began."},{"id":"seytek-2012:p0510:b003:l033","ordinal":332679,"en":"For the glory of the fray, precious lives"},{"id":"seytek-2012:p0510:b003:l034","ordinal":332680,"en":"Were bound and cast upon a thread."},{"id":"seytek-2012:p0510:b003:l035","ordinal":332681,"en":"They raised a wondrous tumult and strife,"},{"id":"seytek-2012:p0510:b003:l036","ordinal":332682,"en":"Making it a trial for the gathered people."},{"id":"seytek-2012:p0510:b003:l037","ordinal":332683,"en":"They pledged their lives for the nation,"},{"id":"seytek-2012:p0510:b003:l038","ordinal":332684,"en":"To unleash a dreadful battle,"},{"id":"seytek-2012:p0510:b003:l039","ordinal":332685,"en":"And lead the valiant Kyrgyz and Argyn onward."},{"id":"seytek-2012:p0511:b002:l001","ordinal":332686,"en":"To rescue him,"},{"id":"seytek-2012:p0511:b002:l002","ordinal":332687,"en":"To die if death should come,"},{"id":"seytek-2012:p0511:b002:l003","ordinal":332688,"en":"To grapple with"},{"id":"seytek-2012:p0511:b002:l004","ordinal":332689,"en":"The fearsome champion Sarybai."},{"id":"seytek-2012:p0511:b002:l005","ordinal":332690,"en":"To defeat the cruel foe,"},{"id":"seytek-2012:p0511:b002:l006","ordinal":332691,"en":"To shatter his stone city—"},{"id":"seytek-2012:p0511:b002:l007","ordinal":332692,"en":"Seytek’s mind is set"},{"id":"seytek-2012:p0511:b002:l008","ordinal":332693,"en":"On rescuing Kara Döö,"},{"id":"seytek-2012:p0511:b002:l009","ordinal":332694,"en":"If he is still alive."},{"id":"seytek-2012:p0511:b002:l010","ordinal":332695,"en":"Before the army, brave Seytek"},{"id":"seytek-2012:p0511:b002:l011","ordinal":332696,"en":"Leveled his white gun and fired,"},{"id":"seytek-2012:p0511:b002:l012","ordinal":332697,"en":"Raised a clamor like Khan Manas,"},{"id":"seytek-2012:p0511:b002:l013","ordinal":332698,"en":"With a hungry shout that split stone,"},{"id":"seytek-2012:p0511:b002:l014","ordinal":332699,"en":"With fierce courage that broke heads;"},{"id":"seytek-2012:p0511:b002:l015","ordinal":332700,"en":"Whoever saw him stood amazed:"},{"id":"seytek-2012:p0511:b002:l016","ordinal":332701,"en":"He loomed like a blue mountain."},{"id":"seytek-2012:p0511:b002:l017","ordinal":332702,"en":"His lashes were burning embers,"},{"id":"seytek-2012:p0511:b002:l018","ordinal":332703,"en":"His wrath became an arrow;"},{"id":"seytek-2012:p0511:b002:l019","ordinal":332704,"en":"When he saw the foe he must fight,"},{"id":"seytek-2012:p0511:b002:l020","ordinal":332705,"en":"How could he remain still?"},{"id":"seytek-2012:p0511:b002:l021","ordinal":332706,"en":"Tumult rose before the army,"},{"id":"seytek-2012:p0511:b002:l022","ordinal":332707,"en":"And a lion’s roar rang out."},{"id":"seytek-2012:p0511:b002:l023","ordinal":332708,"en":"Could dear young Seytek,"},{"id":"seytek-2012:p0511:b002:l024","ordinal":332709,"en":"True son of the bloodthirsty khan,"},{"id":"seytek-2012:p0511:b002:l025","ordinal":332710,"en":"Ever flee from battle?"},{"id":"seytek-2012:p0511:b002:l026","ordinal":332711,"en":"Behold how the spirits"},{"id":"seytek-2012:p0511:b002:l027","ordinal":332712,"en":"Of his fathers upheld him!"},{"id":"seytek-2012:p0511:b002:l028","ordinal":332713,"en":"A black-mottled leopard"},{"id":"seytek-2012:p0511:b002:l029","ordinal":332714,"en":"Crouched at his side,"},{"id":"seytek-2012:p0511:b002:l030","ordinal":332715,"en":"As if about to tear flesh;"},{"id":"seytek-2012:p0511:b002:l031","ordinal":332716,"en":"A black-maned lion"},{"id":"seytek-2012:p0511:b002:l032","ordinal":332717,"en":"Waited close beside him,"},{"id":"seytek-2012:p0511:b002:l033","ordinal":332718,"en":"As if ready to spring and strike."},{"id":"seytek-2012:p0511:b002:l034","ordinal":332719,"en":"A gray tiger went before him—"},{"id":"seytek-2012:p0511:b002:l035","ordinal":332720,"en":"No living creature was its equal."},{"id":"seytek-2012:p0511:b002:l036","ordinal":332721,"en":"Looming like a blue mountain,"},{"id":"seytek-2012:p0511:b002:l037","ordinal":332722,"en":"The giant Zymyrik black eagle"},{"id":"seytek-2012:p0511:b002:l038","ordinal":332723,"en":"Seemed ready to swoop,"},{"id":"seytek-2012:p0511:b002:l039","ordinal":332724,"en":"Stretching out its talons"},{"id":"seytek-2012:p0511:b003:l001","ordinal":332725,"en":"As though about to seize him,"},{"id":"seytek-2012:p0511:b003:l002","ordinal":332726,"en":"Carry the world’s hero away,"},{"id":"seytek-2012:p0511:b003:l003","ordinal":332727,"en":"And cross the rocky peaks."},{"id":"seytek-2012:p0511:b003:l004","ordinal":332728,"en":"It thrust its talons wide:"},{"id":"seytek-2012:p0511:b003:l005","ordinal":332729,"en":"One of the seven black eagles"},{"id":"seytek-2012:p0511:b003:l006","ordinal":332730,"en":"Truly stood protecting him."},{"id":"seytek-2012:p0511:b003:l007","ordinal":332731,"en":"Forty tigers lined the ridge—"},{"id":"seytek-2012:p0511:b003:l008","ordinal":332732,"en":"No creatures like them had long been seen."},{"id":"seytek-2012:p0511:b003:l009","ordinal":332733,"en":"What he faced became flame,"},{"id":"seytek-2012:p0511:b003:l010","ordinal":332734,"en":"His spirit became a glowing coal;"},{"id":"seytek-2012:p0511:b003:l011","ordinal":332735,"en":"Once he saw the fearsome foe,"},{"id":"seytek-2012:p0511:b003:l012","ordinal":332736,"en":"How could the valiant son"},{"id":"seytek-2012:p0511:b003:l013","ordinal":332737,"en":"Of his father remain still?"},{"id":"seytek-2012:p0511:b003:l014","ordinal":332738,"en":"The dappled bay with swaying ornaments,"},{"id":"seytek-2012:p0511:b003:l015","ordinal":332739,"en":"The heavy, hostile dappled bay;"},{"id":"seytek-2012:p0511:b003:l016","ordinal":332740,"en":"His foe in combat was Sarybai—"},{"id":"seytek-2012:p0511:b003:l017","ordinal":332741,"en":"His splendor was of another kind."},{"id":"seytek-2012:p0511:b003:l018","ordinal":332742,"en":"His fury was mountain-like,"},{"id":"seytek-2012:p0511:b003:l019","ordinal":332743,"en":"As though he might devour"},{"id":"seytek-2012:p0511:b003:l020","ordinal":332744,"en":"The whole wide world at once."},{"id":"seytek-2012:p0511:b003:l021","ordinal":332745,"en":"He sprang like a tiger;"},{"id":"seytek-2012:p0511:b003:l022","ordinal":332746,"en":"None survived his blows."},{"id":"seytek-2012:p0511:b003:l023","ordinal":332747,"en":"The army roared, filling the fortress,"},{"id":"seytek-2012:p0511:b003:l024","ordinal":332748,"en":"Surging and blazing like fire."},{"id":"seytek-2012:p0511:b003:l025","ordinal":332749,"en":"They stirred to close in combat;"},{"id":"seytek-2012:p0511:b003:l026","ordinal":332750,"en":"The troops clamored, covering the earth,"},{"id":"seytek-2012:p0511:b003:l027","ordinal":332751,"en":"Crossing their steel-tipped spears,"},{"id":"seytek-2012:p0511:b003:l028","ordinal":332752,"en":"Binding their lone fly-like lives"},{"id":"seytek-2012:p0511:b003:l029","ordinal":332753,"en":"To a single hair,"},{"id":"seytek-2012:p0511:b003:l030","ordinal":332754,"en":"They crossed the mountain pass"},{"id":"seytek-2012:p0511:b003:l031","ordinal":332755,"en":"And descended onward"},{"id":"seytek-2012:p0511:b003:l032","ordinal":332756,"en":"Into the plain of El-Jürbös."},{"id":"seytek-2012:p0511:b003:l033","ordinal":332757,"en":"The army settled amid a roar,"},{"id":"seytek-2012:p0511:b003:l034","ordinal":332758,"en":"Set out food and slaughtered colts,"},{"id":"seytek-2012:p0511:b003:l035","ordinal":332759,"en":"And had all the coursing steeds"},{"id":"seytek-2012:p0511:b003:l036","ordinal":332760,"en":"Tethered along the lines."},{"id":"seytek-2012:p0511:b003:l037","ordinal":332761,"en":"From barren, well-fed young mares"},{"id":"seytek-2012:p0511:b003:l038","ordinal":332762,"en":"They boiled their meal."},{"id":"seytek-2012:p0511:b003:l039","ordinal":332763,"en":"They finely dressed and slaughtered colts,"},{"id":"seytek-2012:p0511:b003:l040","ordinal":332764,"en":"Then calmly laid out the feast."},{"id":"seytek-2012:p0512:b002:l001","ordinal":332765,"en":"The whole army murmured,"},{"id":"seytek-2012:p0512:b002:l002","ordinal":332766,"en":"The host clamored and buzzed,"},{"id":"seytek-2012:p0512:b002:l003","ordinal":332767,"en":"Dozing with heads on elbows,"},{"id":"seytek-2012:p0512:b003:l001","ordinal":332768,"en":"Resting in brief sleep,"},{"id":"seytek-2012:p0512:b003:l002","ordinal":332769,"en":"Lying until their hips grew weary,"},{"id":"seytek-2012:p0512:b003:l003","ordinal":332770,"en":"Reclining until sleep was satisfied."},{"id":"seytek-2012:p0512:b004:l001","ordinal":332771,"en":"THE TALE OF SARYBAI, SON OF THE MONSTER"},{"id":"seytek-2012:p0512:b005:l001","ordinal":332772,"en":"Beaten down by Sarybai,"},{"id":"seytek-2012:p0512:b005:l002","ordinal":332773,"en":"They had no time to gather their wits,"},{"id":"seytek-2012:p0512:b005:l003","ordinal":332774,"en":"No chance to fight with manly courage;"},{"id":"seytek-2012:p0512:b005:l004","ordinal":332775,"en":"Many champions panicked."},{"id":"seytek-2012:p0512:b005:l005","ordinal":332776,"en":"Of the many vaunting warriors,"},{"id":"seytek-2012:p0512:b005:l006","ordinal":332777,"en":"Some fled back again,"},{"id":"seytek-2012:p0512:b005:l007","ordinal":332778,"en":"While those fated to die were slain."},{"id":"seytek-2012:p0512:b005:l008","ordinal":332779,"en":"Some champions whose death had not come"},{"id":"seytek-2012:p0512:b005:l009","ordinal":332780,"en":"Were swallowed in swirling dust,"},{"id":"seytek-2012:p0512:b005:l010","ordinal":332781,"en":"Their heads like buckets of blood;"},{"id":"seytek-2012:p0512:b005:l011","ordinal":332782,"en":"Many champions panicked."},{"id":"seytek-2012:p0512:b005:l012","ordinal":332783,"en":"They went intending slaughter,"},{"id":"seytek-2012:p0512:b005:l013","ordinal":332784,"en":"But met with bitter disaster,"},{"id":"seytek-2012:p0512:b005:l014","ordinal":332785,"en":"And felt Sarybai’s might."},{"id":"seytek-2012:p0512:b005:l015","ordinal":332786,"en":"The boastful, swaggering men,"},{"id":"seytek-2012:p0512:b005:l016","ordinal":332787,"en":"Those who called themselves heroes,"},{"id":"seytek-2012:p0512:b005:l017","ordinal":332788,"en":"With their mottled bellies thumping,"},{"id":"seytek-2012:p0512:b005:l018","ordinal":332789,"en":"Their blustering chests rumbling,"},{"id":"seytek-2012:p0512:b005:l019","ordinal":332790,"en":"Those witless braggarts,"},{"id":"seytek-2012:p0512:b005:l020","ordinal":332791,"en":"Failed to meet the foe they sought"},{"id":"seytek-2012:p0512:b005:l021","ordinal":332792,"en":"And met the one they had not sought;"},{"id":"seytek-2012:p0512:b005:l022","ordinal":332793,"en":"Many champions were destroyed."},{"id":"seytek-2012:p0512:b005:l023","ordinal":332794,"en":"All those who fell"},{"id":"seytek-2012:p0512:b005:l024","ordinal":332795,"en":"Were hotheaded braggarts,"},{"id":"seytek-2012:p0512:b005:l025","ordinal":332796,"en":"Empty-chested, broad-flanked men"},{"id":"seytek-2012:p0512:b005:l026","ordinal":332797,"en":"Who had strutted in arrogance."},{"id":"seytek-2012:p0512:b005:l027","ordinal":332798,"en":"They cast away their lives;"},{"id":"seytek-2012:p0512:b005:l028","ordinal":332799,"en":"Those who were not killed"},{"id":"seytek-2012:p0512:b005:l029","ordinal":332800,"en":"Retreated and fled again."}]
