[{"id":"semetey-2-2013:p1342:b004:l034","ordinal":289025,"en":"Who would not yield a companion’s life,"},{"id":"semetey-2-2013:p1342:b004:l035","ordinal":289026,"en":"Were gone."},{"id":"semetey-2-2013:p1342:b004:l036","ordinal":289027,"en":"The Jediger flooded in,"},{"id":"semetey-2-2013:p1342:b004:l037","ordinal":289028,"en":"Showing no pity for those dear lives,"},{"id":"semetey-2-2013:p1342:b004:l038","ordinal":289029,"en":"Paying no heed"},{"id":"semetey-2-2013:p1342:b004:l039","ordinal":289030,"en":"That they were widows and orphans."},{"id":"semetey-2-2013:p1343:b003:l001","ordinal":289031,"en":"They drew bows like pouring rain,"},{"id":"semetey-2-2013:p1343:b003:l002","ordinal":289032,"en":"Shot arrows like falling hail;"},{"id":"semetey-2-2013:p1343:b003:l003","ordinal":289033,"en":"The musket balls whistled,"},{"id":"semetey-2-2013:p1343:b003:l004","ordinal":289034,"en":"The bowstrings’ arrows hissed,"},{"id":"semetey-2-2013:p1343:b003:l005","ordinal":289035,"en":"The short guns’ balls glowed red."},{"id":"semetey-2-2013:p1343:b003:l006","ordinal":289036,"en":"They came and struck the palace,"},{"id":"semetey-2-2013:p1343:b003:l007","ordinal":289037,"en":"Bullets scattering like hail,"},{"id":"semetey-2-2013:p1343:b003:l008","ordinal":289038,"en":"The musket balls plainly visible."},{"id":"semetey-2-2013:p1343:b003:l009","ordinal":289039,"en":"When the Jediger closed in,"},{"id":"semetey-2-2013:p1343:b003:l010","ordinal":289040,"en":"Old women and young wives"},{"id":"semetey-2-2013:p1343:b003:l011","ordinal":289041,"en":"Had no strength to show courage;"},{"id":"semetey-2-2013:p1343:b003:l012","ordinal":289042,"en":"There was no male child of the khan,"},{"id":"semetey-2-2013:p1343:b003:l013","ordinal":289043,"en":"No champion girded for action,"},{"id":"semetey-2-2013:p1343:b003:l014","ordinal":289044,"en":"No people on whom to rely,"},{"id":"semetey-2-2013:p1343:b003:l015","ordinal":289045,"en":"No forest to give them shelter,"},{"id":"semetey-2-2013:p1343:b003:l016","ordinal":289046,"en":"No homeland into which to flee."},{"id":"semetey-2-2013:p1343:b003:l017","ordinal":289047,"en":"When God destroys one’s equal,"},{"id":"semetey-2-2013:p1343:b003:l018","ordinal":289048,"en":"This world is born as filth indeed."},{"id":"semetey-2-2013:p1343:b003:l019","ordinal":289049,"en":"Its gate was pierced with firing holes;"},{"id":"semetey-2-2013:p1343:b003:l020","ordinal":289050,"en":"The keepers at the gate,"},{"id":"semetey-2-2013:p1343:b003:l021","ordinal":289051,"en":"Fighting as men who had escaped death,"},{"id":"semetey-2-2013:p1343:b003:l022","ordinal":289052,"en":"Fired guns and drew bows,"},{"id":"semetey-2-2013:p1343:b003:l023","ordinal":289053,"en":"Clashing together in combat;"},{"id":"semetey-2-2013:p1343:b003:l024","ordinal":289054,"en":"Dark blood flowed like water"},{"id":"semetey-2-2013:p1343:b003:l025","ordinal":289055,"en":"As they fought to bar the gate."},{"id":"semetey-2-2013:p1343:b003:l026","ordinal":289056,"en":"What could the poor gatekeepers do?"},{"id":"semetey-2-2013:p1343:b003:l027","ordinal":289057,"en":"They stood giving ground,"},{"id":"semetey-2-2013:p1343:b003:l028","ordinal":289058,"en":"They stood without yielding passage,"},{"id":"semetey-2-2013:p1343:b003:l029","ordinal":289059,"en":"Weary beyond all measure."},{"id":"semetey-2-2013:p1343:b003:l030","ordinal":289060,"en":"With steel shafts and sharpened points,"},{"id":"semetey-2-2013:p1343:b003:l031","ordinal":289061,"en":"Fletched with black hair,"},{"id":"semetey-2-2013:p1343:b003:l032","ordinal":289062,"en":"The bloodthirsty lord had armed the gate"},{"id":"semetey-2-2013:p1343:b003:l033","ordinal":289063,"en":"With keen, unsheathed steel."},{"id":"semetey-2-2013:p1343:b003:l034","ordinal":289064,"en":"Men lay sprawled before the gate;"},{"id":"semetey-2-2013:p1343:b003:l035","ordinal":289065,"en":"The Jediger’s hearts were crushed,"},{"id":"semetey-2-2013:p1343:b003:l036","ordinal":289066,"en":"For those who ventured near the gate"},{"id":"semetey-2-2013:p1343:b003:l037","ordinal":289067,"en":"Lay stretched out dead."},{"id":"semetey-2-2013:p1343:b003:l038","ordinal":289068,"en":"The seasoned guards,"},{"id":"semetey-2-2013:p1343:b003:l039","ordinal":289069,"en":"Those appointed to keep the gate,"},{"id":"semetey-2-2013:p1343:b004:l001","ordinal":289070,"en":"Took up red-steel spears,"},{"id":"semetey-2-2013:p1343:b004:l002","ordinal":289071,"en":"Faced outward at every loophole,"},{"id":"semetey-2-2013:p1343:b004:l003","ordinal":289072,"en":"Raised battle-axes and spears,"},{"id":"semetey-2-2013:p1343:b004:l004","ordinal":289073,"en":"And fired at chosen targets."},{"id":"semetey-2-2013:p1343:b004:l005","ordinal":289074,"en":"Whenever the Jediger closed in,"},{"id":"semetey-2-2013:p1343:b004:l006","ordinal":289075,"en":"They struck whoever came near"},{"id":"semetey-2-2013:p1343:b004:l007","ordinal":289076,"en":"Right beneath the armpit."},{"id":"semetey-2-2013:p1343:b004:l008","ordinal":289077,"en":"The massed black Jediger"},{"id":"semetey-2-2013:p1343:b004:l009","ordinal":289078,"en":"Tried courageously to storm the gate,"},{"id":"semetey-2-2013:p1343:b004:l010","ordinal":289079,"en":"Yet stood afraid to advance and fire"},{"id":"semetey-2-2013:p1343:b004:l011","ordinal":289080,"en":"Against the wrestlers and heroes."},{"id":"semetey-2-2013:p1343:b004:l012","ordinal":289081,"en":"The gate was strong, guarded by lions;"},{"id":"semetey-2-2013:p1343:b004:l013","ordinal":289082,"en":"Unable to overrun the gate,"},{"id":"semetey-2-2013:p1343:b004:l014","ordinal":289083,"en":"Those Jediger were dumbfounded."},{"id":"semetey-2-2013:p1343:b004:l015","ordinal":289084,"en":"The watchmen and guards grew fierce;"},{"id":"semetey-2-2013:p1343:b004:l016","ordinal":289085,"en":"Unable to flood into the stronghold,"},{"id":"semetey-2-2013:p1343:b004:l017","ordinal":289086,"en":"The massed black Jediger"},{"id":"semetey-2-2013:p1343:b004:l018","ordinal":289087,"en":"Took on the look of men about to flee."},{"id":"semetey-2-2013:p1343:b004:l019","ordinal":289088,"en":"Their warriors were speared from the gate,"},{"id":"semetey-2-2013:p1343:b004:l020","ordinal":289089,"en":"Taken suddenly by surprise;"},{"id":"semetey-2-2013:p1343:b004:l021","ordinal":289090,"en":"The Jediger went about grieving,"},{"id":"semetey-2-2013:p1343:b004:l022","ordinal":289091,"en":"Saying, “Our dear man has died;"},{"id":"semetey-2-2013:p1343:b004:l023","ordinal":289092,"en":"The dear hero has seen"},{"id":"semetey-2-2013:p1343:b004:l024","ordinal":289093,"en":"The true place from which none returns.”"},{"id":"semetey-2-2013:p1343:b004:l025","ordinal":289094,"en":"The people broke into separate bands;"},{"id":"semetey-2-2013:p1343:b004:l026","ordinal":289095,"en":"The massed black Jediger"},{"id":"semetey-2-2013:p1343:b004:l027","ordinal":289096,"en":"Were gathering themselves together,"},{"id":"semetey-2-2013:p1343:b004:l028","ordinal":289097,"en":"Lamenting, “Our dear kinsman"},{"id":"semetey-2-2013:p1343:b004:l029","ordinal":289098,"en":"Died in such-and-such a place.”"},{"id":"semetey-2-2013:p1343:b004:l030","ordinal":289099,"en":"This was when they raised their lament."},{"id":"semetey-2-2013:p1343:b004:l031","ordinal":289100,"en":"Brave Kyyaz of the Jediger,"},{"id":"semetey-2-2013:p1343:b004:l032","ordinal":289101,"en":"To send his people surging forward,"},{"id":"semetey-2-2013:p1343:b004:l033","ordinal":289102,"en":"Struck the great war drum."},{"id":"semetey-2-2013:p1343:b004:l034","ordinal":289103,"en":"The host, poised to flee, halted;"},{"id":"semetey-2-2013:p1343:b004:l035","ordinal":289104,"en":"The people stood divided."},{"id":"semetey-2-2013:p1343:b004:l036","ordinal":289105,"en":"Those who had turned to retreat"},{"id":"semetey-2-2013:p1343:b004:l037","ordinal":289106,"en":"Now came streaming out again;"},{"id":"semetey-2-2013:p1343:b004:l038","ordinal":289107,"en":"Every last one thundered forth—"},{"id":"semetey-2-2013:p1343:b004:l039","ordinal":289108,"en":"The accursed-looking Jediger."},{"id":"semetey-2-2013:p1344:b003:l001","ordinal":289109,"en":"“Go forward, every last one of you,"},{"id":"semetey-2-2013:p1344:b003:l002","ordinal":289110,"en":"Young and old alike!"},{"id":"semetey-2-2013:p1344:b003:l003","ordinal":289111,"en":"Fire muskets and draw bows;"},{"id":"semetey-2-2013:p1344:b003:l004","ordinal":289112,"en":"All you black Jediger,"},{"id":"semetey-2-2013:p1344:b003:l005","ordinal":289113,"en":"Attack together as one!"},{"id":"semetey-2-2013:p1344:b003:l006","ordinal":289114,"en":"Overwhelm and plunder"},{"id":"semetey-2-2013:p1344:b003:l007","ordinal":289115,"en":"The helpless women and young children."},{"id":"semetey-2-2013:p1344:b003:l008","ordinal":289116,"en":"Break the stronghold, take the spoils,"},{"id":"semetey-2-2013:p1344:b003:l009","ordinal":289117,"en":"Seize the swaying beauties—"},{"id":"semetey-2-2013:p1344:b003:l010","ordinal":289118,"en":"Fight the battle in this way!"},{"id":"semetey-2-2013:p1344:b003:l011","ordinal":289119,"en":"You massed black Jediger,"},{"id":"semetey-2-2013:p1344:b003:l012","ordinal":289120,"en":"From ancient times until now"},{"id":"semetey-2-2013:p1344:b003:l013","ordinal":289121,"en":"You have lived by conquest;"},{"id":"semetey-2-2013:p1344:b003:l014","ordinal":289122,"en":"Why do you retreat like this"},{"id":"semetey-2-2013:p1344:b003:l015","ordinal":289123,"en":"From gatekeepers and women?"},{"id":"semetey-2-2013:p1344:b003:l016","ordinal":289124,"en":"What will you do if the lost gray wolf is found"},{"id":"semetey-2-2013:p1344:b003:l017","ordinal":289125,"en":"And Semetey returns?"},{"id":"semetey-2-2013:p1344:b003:l018","ordinal":289126,"en":"Jediger, divide among yourselves"},{"id":"semetey-2-2013:p1344:b003:l019","ordinal":289127,"en":"The property left to the women!"},{"id":"semetey-2-2013:p1344:b003:l020","ordinal":289128,"en":"Rather than flee the gatekeepers,"},{"id":"semetey-2-2013:p1344:b003:l021","ordinal":289129,"en":"Rather than lie here facing death,"},{"id":"semetey-2-2013:p1344:b003:l022","ordinal":289130,"en":"You should die, Jediger!"},{"id":"semetey-2-2013:p1344:b003:l023","ordinal":289131,"en":"Rather than the courageous Kanchoro"},{"id":"semetey-2-2013:p1344:b003:l024","ordinal":289132,"en":"Flying into a rage"},{"id":"semetey-2-2013:p1344:b003:l025","ordinal":289133,"en":"And starting this calamity outright,"},{"id":"semetey-2-2013:p1344:b003:l026","ordinal":289134,"en":"Charging with a battle cry"},{"id":"semetey-2-2013:p1344:b003:l027","ordinal":289135,"en":"And having the Jediger slaughtered."},{"id":"semetey-2-2013:p1344:b003:l028","ordinal":289136,"en":"Rather than return without breaking the gate,"},{"id":"semetey-2-2013:p1344:b003:l029","ordinal":289137,"en":"Rather than stand frightened of women—"},{"id":"semetey-2-2013:p1344:b003:l030","ordinal":289138,"en":"Jediger, lower than women—"},{"id":"semetey-2-2013:p1344:b003:l031","ordinal":289139,"en":"Rather than flee the gatekeepers,"},{"id":"semetey-2-2013:p1344:b003:l032","ordinal":289140,"en":"May Kyyaz your leader die;"},{"id":"semetey-2-2013:p1344:b003:l033","ordinal":289141,"en":"You massed black Jediger,"},{"id":"semetey-2-2013:p1344:b003:l034","ordinal":289142,"en":"You snarling curs, may all of you die!"},{"id":"semetey-2-2013:p1344:b003:l035","ordinal":289143,"en":"You witless black Jediger,"},{"id":"semetey-2-2013:p1344:b003:l036","ordinal":289144,"en":"Could a hero be like you?"},{"id":"semetey-2-2013:p1344:b003:l037","ordinal":289145,"en":"All of you are a wretched, cowardly people;"},{"id":"semetey-2-2013:p1344:b003:l038","ordinal":289146,"en":"Is it any wonder you are called cowards?"},{"id":"semetey-2-2013:p1344:b003:l039","ordinal":289147,"en":"Had I not been here, Jediger,"},{"id":"semetey-2-2013:p1344:b004:l001","ordinal":289148,"en":"Külchoro would have entered alone"},{"id":"semetey-2-2013:p1344:b004:l002","ordinal":289149,"en":"And destroyed your people"},{"id":"semetey-2-2013:p1344:b004:l003","ordinal":289150,"en":"In your free land of Jeti-Özön;"},{"id":"semetey-2-2013:p1344:b004:l004","ordinal":289151,"en":"He would have cooled your ardor,"},{"id":"semetey-2-2013:p1344:b004:l005","ordinal":289152,"en":"Broken your backs,"},{"id":"semetey-2-2013:p1344:b004:l006","ordinal":289153,"en":"And hacked your lion,"},{"id":"semetey-2-2013:p1344:b004:l007","ordinal":289154,"en":"Kyyaz your khan, to pieces.”"},{"id":"semetey-2-2013:p1344:b004:l008","ordinal":289155,"en":"He began his wrathful tirade;"},{"id":"semetey-2-2013:p1344:b004:l009","ordinal":289156,"en":"With piercing cries and rallying shouts,"},{"id":"semetey-2-2013:p1344:b004:l010","ordinal":289157,"en":"Raising a furious clamor,"},{"id":"semetey-2-2013:p1344:b004:l011","ordinal":289158,"en":"He sent the massed black Jediger"},{"id":"semetey-2-2013:p1344:b004:l012","ordinal":289159,"en":"Charging to their slaughter."},{"id":"semetey-2-2013:p1344:b004:l013","ordinal":289160,"en":"Again and again he spoke;"},{"id":"semetey-2-2013:p1344:b004:l014","ordinal":289161,"en":"The treacherous kinsman Kanchoro—"},{"id":"semetey-2-2013:p1344:b004:l015","ordinal":289162,"en":"May he never prosper or multiply,"},{"id":"semetey-2-2013:p1344:b004:l016","ordinal":289163,"en":"May he never thrive—"},{"id":"semetey-2-2013:p1344:b004:l017","ordinal":289164,"en":"Roused the Jediger."},{"id":"semetey-2-2013:p1344:b004:l018","ordinal":289165,"en":"Every last man thundered;"},{"id":"semetey-2-2013:p1344:b004:l019","ordinal":289166,"en":"The entire Jediger host"},{"id":"semetey-2-2013:p1344:b004:l020","ordinal":289167,"en":"Launched its roaring assault."},{"id":"semetey-2-2013:p1344:b004:l021","ordinal":289168,"en":"Kanchoro drove in"},{"id":"semetey-2-2013:p1344:b004:l022","ordinal":289169,"en":"The skillful spearmen,"},{"id":"semetey-2-2013:p1344:b004:l023","ordinal":289170,"en":"The strongest of the Jediger,"},{"id":"semetey-2-2013:p1344:b004:l024","ordinal":289171,"en":"And hemmed in the palace."},{"id":"semetey-2-2013:p1344:b004:l025","ordinal":289172,"en":"They wrought havoc at the palace;"},{"id":"semetey-2-2013:p1344:b004:l026","ordinal":289173,"en":"The eye could not follow them,"},{"id":"semetey-2-2013:p1344:b004:l027","ordinal":289174,"en":"Nor tell which man was which,"},{"id":"semetey-2-2013:p1344:b004:l028","ordinal":289175,"en":"Like tumbleweed flying in the wind."},{"id":"semetey-2-2013:p1344:b004:l029","ordinal":289176,"en":"May God spare us the sight—"},{"id":"semetey-2-2013:p1344:b004:l030","ordinal":289177,"en":"They stood surrounding the gate."},{"id":"semetey-2-2013:p1344:b004:l031","ordinal":289178,"en":"The executioners barring the gate"},{"id":"semetey-2-2013:p1344:b004:l032","ordinal":289179,"en":"Fought without rest for seven days;"},{"id":"semetey-2-2013:p1344:b004:l033","ordinal":289180,"en":"Who had ever seen such a struggle?"},{"id":"semetey-2-2013:p1344:b004:l034","ordinal":289181,"en":"Talas rose like a mountain before their departure;"},{"id":"semetey-2-2013:p1344:b004:l035","ordinal":289182,"en":"Her own son born from her body—"},{"id":"semetey-2-2013:p1344:b004:l036","ordinal":289183,"en":"To tell it fully is a great calamity—"},{"id":"semetey-2-2013:p1344:b004:l037","ordinal":289184,"en":"Kanchoro had become an infidel foe."},{"id":"semetey-2-2013:p1344:b004:l038","ordinal":289185,"en":"A destroyer had arisen within,"},{"id":"semetey-2-2013:p1344:b004:l039","ordinal":289186,"en":"A man who brought ruin upon the people."},{"id":"semetey-2-2013:p1345:b003:l001","ordinal":289187,"en":"They fired bullets into the palace city,"},{"id":"semetey-2-2013:p1345:b003:l002","ordinal":289188,"en":"Becoming enemies of the bloodthirsty khan."},{"id":"semetey-2-2013:p1345:b003:l003","ordinal":289189,"en":"This infidel Kanchoro"},{"id":"semetey-2-2013:p1345:b003:l004","ordinal":289190,"en":"Was the foster son of that bloodthirsty lord;"},{"id":"semetey-2-2013:p1345:b003:l005","ordinal":289191,"en":"They had kicked together like colt and yearling,"},{"id":"semetey-2-2013:p1345:b003:l006","ordinal":289192,"en":"And quarreled as they sucked the same breast."},{"id":"semetey-2-2013:p1345:b003:l007","ordinal":289193,"en":"Behold that kinship!"},{"id":"semetey-2-2013:p1345:b003:l008","ordinal":289194,"en":"Behold the treachery of the choro"},{"id":"semetey-2-2013:p1345:b003:l009","ordinal":289195,"en":"Who turned against his kinsman like an enemy"},{"id":"semetey-2-2013:p1345:b003:l010","ordinal":289196,"en":"And died corrupted!"},{"id":"semetey-2-2013:p1345:b003:l011","ordinal":289197,"en":"From the top of the tower,"},{"id":"semetey-2-2013:p1345:b003:l012","ordinal":289198,"en":"Poor Aychürök, the woman,"},{"id":"semetey-2-2013:p1345:b003:l013","ordinal":289199,"en":"Her proud dark head bowed,"},{"id":"semetey-2-2013:p1345:b003:l014","ordinal":289200,"en":"Her bloodied face torn open,"},{"id":"semetey-2-2013:p1345:b003:l015","ordinal":289201,"en":"Burning and blazing into embers,"},{"id":"semetey-2-2013:p1345:b003:l016","ordinal":289202,"en":"Turned by grief into fire,"},{"id":"semetey-2-2013:p1345:b003:l017","ordinal":289203,"en":"Her knees bending to the ground,"},{"id":"semetey-2-2013:p1345:b003:l018","ordinal":289204,"en":"Shrieking, weeping, and screaming,"},{"id":"semetey-2-2013:p1345:b003:l019","ordinal":289205,"en":"Burst in upon true Kanykey,"},{"id":"semetey-2-2013:p1345:b003:l020","ordinal":289206,"en":"Wailing and sobbing."},{"id":"semetey-2-2013:p1345:b003:l021","ordinal":289207,"en":"When she saw Aychürök’s condition,"},{"id":"semetey-2-2013:p1345:b003:l022","ordinal":289208,"en":"Her grandmother Chyyyrdy,"},{"id":"semetey-2-2013:p1345:b003:l023","ordinal":289209,"en":"That elder wife, understood"},{"id":"semetey-2-2013:p1345:b003:l024","ordinal":289210,"en":"That her one cherished man had died."},{"id":"semetey-2-2013:p1345:b003:l025","ordinal":289211,"en":"Thinking, “How can I live bereft of my only one?"},{"id":"semetey-2-2013:p1345:b003:l026","ordinal":289212,"en":"I will drive a knife into myself,”"},{"id":"semetey-2-2013:p1345:b003:l027","ordinal":289213,"en":"Within a white saddlebag,"},{"id":"semetey-2-2013:p1345:b003:l028","ordinal":289214,"en":"Bought for six thousand camels and a thousand colts,"},{"id":"semetey-2-2013:p1345:b003:l029","ordinal":289215,"en":"Was the white blade she had purchased."},{"id":"semetey-2-2013:p1345:b003:l030","ordinal":289216,"en":"She seized its handle"},{"id":"semetey-2-2013:p1345:b003:l031","ordinal":289217,"en":"And drew it from its sheath."},{"id":"semetey-2-2013:p1345:b003:l032","ordinal":289218,"en":"“It is the pennon fixed to the spear,"},{"id":"semetey-2-2013:p1345:b003:l033","ordinal":289219,"en":"A special keepsake left"},{"id":"semetey-2-2013:p1345:b003:l034","ordinal":289220,"en":"By magnanimous Manas, the radiant one,” she said."},{"id":"semetey-2-2013:p1345:b003:l035","ordinal":289221,"en":"She shrieked, wept, and grieved,"},{"id":"semetey-2-2013:p1345:b003:l036","ordinal":289222,"en":"Bereft of two sons in succession."},{"id":"semetey-2-2013:p1345:b003:l037","ordinal":289223,"en":"“How can I remain now?"},{"id":"semetey-2-2013:p1345:b003:l038","ordinal":289224,"en":"Though God may refuse to take me,"},{"id":"semetey-2-2013:p1345:b003:l039","ordinal":289225,"en":"I will go in this way today.”"},{"id":"semetey-2-2013:p1345:b005:l001","ordinal":289226,"en":"The fine blade, solid steel with a golden hilt,"},{"id":"semetey-2-2013:p1345:b005:l002","ordinal":289227,"en":"Was steel through and through;"},{"id":"semetey-2-2013:p1345:b005:l003","ordinal":289228,"en":"She grasped and turned it in her hand,"},{"id":"semetey-2-2013:p1345:b005:l004","ordinal":289229,"en":"Then plunged the white blade"},{"id":"semetey-2-2013:p1345:b005:l005","ordinal":289230,"en":"Into the thick flesh of her living heart."},{"id":"semetey-2-2013:p1345:b005:l006","ordinal":289231,"en":"Chyyyrdy herself"},{"id":"semetey-2-2013:p1345:b005:l007","ordinal":289232,"en":"Cut herself open."},{"id":"semetey-2-2013:p1345:b005:l008","ordinal":289233,"en":"Poor Aychürök, the woman,"},{"id":"semetey-2-2013:p1345:b005:l009","ordinal":289234,"en":"Saw with her own eyes"},{"id":"semetey-2-2013:p1345:b005:l010","ordinal":289235,"en":"That her grandmother had died."},{"id":"semetey-2-2013:p1345:b005:l011","ordinal":289236,"en":"Her mind was pierced and split apart;"},{"id":"semetey-2-2013:p1345:b005:l012","ordinal":289237,"en":"Twelve afflictions and a thousand cares"},{"id":"semetey-2-2013:p1345:b005:l013","ordinal":289238,"en":"Appeared above her head."},{"id":"semetey-2-2013:p1345:b005:l014","ordinal":289239,"en":"Fire that burns through the grass is terrible;"},{"id":"semetey-2-2013:p1345:b005:l015","ordinal":289240,"en":"Worse is Kanchoro sprung from one’s own people,"},{"id":"semetey-2-2013:p1345:b005:l016","ordinal":289241,"en":"An enemy gone rabid."},{"id":"semetey-2-2013:p1345:b005:l017","ordinal":289242,"en":"When the cruel enemy surged in"},{"id":"semetey-2-2013:p1345:b005:l018","ordinal":289243,"en":"And plundered all beneath them,"},{"id":"semetey-2-2013:p1345:b005:l019","ordinal":289244,"en":"When orphan, widow, and aged soul"},{"id":"semetey-2-2013:p1345:b005:l020","ordinal":289245,"en":"Were thrown into a dug pit,"},{"id":"semetey-2-2013:p1345:b005:l021","ordinal":289246,"en":"“The dogs will take her if we plead;"},{"id":"semetey-2-2013:p1345:b005:l022","ordinal":289247,"en":"Before the five bright stars,"},{"id":"semetey-2-2013:p1345:b005:l023","ordinal":289248,"en":"Golden rubies in the radiant firmament, have set—"},{"id":"semetey-2-2013:p1345:b005:l024","ordinal":289249,"en":"My mother who suckled me on five separate journeys,"},{"id":"semetey-2-2013:p1345:b005:l025","ordinal":289250,"en":"Who widened her narrow womb,"},{"id":"semetey-2-2013:p1345:b005:l026","ordinal":289251,"en":"Who emptied her stone-hard breasts,"},{"id":"semetey-2-2013:p1345:b005:l027","ordinal":289252,"en":"And raised us to maturity—"},{"id":"semetey-2-2013:p1345:b005:l028","ordinal":289253,"en":"When they plunder us,"},{"id":"semetey-2-2013:p1345:b005:l029","ordinal":289254,"en":"My dearest mother,"},{"id":"semetey-2-2013:p1345:b005:l030","ordinal":289255,"en":"If she suddenly disappears,"},{"id":"semetey-2-2013:p1345:b005:l031","ordinal":289256,"en":"If by chance she lies unburied,"},{"id":"semetey-2-2013:p1345:b005:l032","ordinal":289257,"en":"If Kanchoro sees her,"},{"id":"semetey-2-2013:p1345:b005:l033","ordinal":289258,"en":"Shameless before breast milk and salt,"},{"id":"semetey-2-2013:p1345:b005:l034","ordinal":289259,"en":"Will he acknowledge my mother?"},{"id":"semetey-2-2013:p1345:b005:l035","ordinal":289260,"en":"Will he call her kin to the leopard,"},{"id":"semetey-2-2013:p1345:b005:l036","ordinal":289261,"en":"Or an old raving infidel"},{"id":"semetey-2-2013:p1345:b005:l037","ordinal":289262,"en":"Who has lived too long,"},{"id":"semetey-2-2013:p1345:b005:l038","ordinal":289263,"en":"Drag her along the road,"},{"id":"semetey-2-2013:p1345:b005:l039","ordinal":289264,"en":"And hand her to the Dangyt?"},{"id":"semetey-2-2013:p1346:b003:l001","ordinal":289265,"en":"As though taking vengeance on a corpse,"},{"id":"semetey-2-2013:p1346:b003:l002","ordinal":289266,"en":"Will he subject her to this humiliation?"},{"id":"semetey-2-2013:p1346:b003:l003","ordinal":289267,"en":"Will God strike down the choro"},{"id":"semetey-2-2013:p1346:b003:l004","ordinal":289268,"en":"Whose conduct is strange and whose salt is accursed?”"},{"id":"semetey-2-2013:p1346:b003:l005","ordinal":289269,"en":"So spoke Aychürök."},{"id":"semetey-2-2013:p1346:b003:l006","ordinal":289270,"en":"Some people say"},{"id":"semetey-2-2013:p1346:b003:l007","ordinal":289271,"en":"That renowned Chürök"},{"id":"semetey-2-2013:p1346:b003:l008","ordinal":289272,"en":"Was a daughter of the peri."},{"id":"semetey-2-2013:p1346:b003:l009","ordinal":289273,"en":"Wise in counsel, honored as night,"},{"id":"semetey-2-2013:p1346:b003:l010","ordinal":289274,"en":"My wondrous sister-in-law—"},{"id":"semetey-2-2013:p1346:b003:l011","ordinal":289275,"en":"After Kanchoro heaped disgrace on her,"},{"id":"semetey-2-2013:p1346:b003:l012","ordinal":289276,"en":"After the massed black Jediger"},{"id":"semetey-2-2013:p1346:b003:l013","ordinal":289277,"en":"Surrounded the palace,"},{"id":"semetey-2-2013:p1346:b003:l014","ordinal":289278,"en":"Poor Chürök pondered"},{"id":"semetey-2-2013:p1346:b003:l015","ordinal":289279,"en":"Her many grievous cares:"},{"id":"semetey-2-2013:p1346:b003:l016","ordinal":289280,"en":"“If the lion born as son"}]
