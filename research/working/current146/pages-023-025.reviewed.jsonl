{"id": "sayakbay-ms-current146:pdf023:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 23, "folio": 406, "line_in_page": 22, "raw": "Калтырбай бала салтырар,", "text": "Калтырбай бала салтырар,", "en": "Leaving none behind, he would send the youths,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The last word is provisionally read салтырар; its exact consonants are indistinct.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf023:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 23, "folio": 406, "line_in_page": 23, "raw": "Кырк эшигин Бежиндин,", "text": "Кырк эшигин Бежиндин,", "en": "The forty gates of Beijing,", "classification": "narrative", "transcription_status": "visually_transcribed", "bbox": null}
