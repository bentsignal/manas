[{"id":"semetey-1-2013:p1029:b004:l004","ordinal":155649,"en":"Caught them in his fangs and chewed them."},{"id":"semetey-1-2013:p1029:b004:l005","ordinal":155650,"en":"Watching him, Choro's"},{"id":"semetey-1-2013:p1029:b004:l006","ordinal":155651,"en":"Heart was deeply troubled."},{"id":"semetey-1-2013:p1029:b004:l007","ordinal":155652,"en":"Driving fourteen swift horses,"},{"id":"semetey-1-2013:p1029:b004:l008","ordinal":155653,"en":"The doomed man seemed to have come"},{"id":"semetey-1-2013:p1029:b004:l009","ordinal":155654,"en":"To cross to the farther bank."},{"id":"semetey-1-2013:p1029:b004:l010","ordinal":155655,"en":"Kulchoro started in alarm."},{"id":"semetey-1-2013:p1029:b004:l012","ordinal":155656,"en":"He ran toward Buurul,","gapBefore":"[Passage withheld: sexual content involving a minor]"},{"id":"semetey-1-2013:p1029:b004:l013","ordinal":155657,"en":"Despairing of his entrusted life;"},{"id":"semetey-1-2013:p1029:b004:l014","ordinal":155658,"en":"Distraught, he caught Buurul."},{"id":"semetey-1-2013:p1029:b004:l015","ordinal":155659,"en":"Kulchoro laughed openly"},{"id":"semetey-1-2013:p1029:b004:l016","ordinal":155660,"en":"And pleaded with Aichurok:"},{"id":"semetey-1-2013:p1029:b004:l017","ordinal":155661,"en":"\"My dear sister-in-law!"},{"id":"semetey-1-2013:p1029:b004:l018","ordinal":155662,"en":"The enraged lion"},{"id":"semetey-1-2013:p1029:b004:l019","ordinal":155663,"en":"May kill me for nothing;"},{"id":"semetey-1-2013:p1029:b004:l020","ordinal":155664,"en":"Go smiling openly"},{"id":"semetey-1-2013:p1029:b004:l021","ordinal":155665,"en":"To that bloodthirsty man who loves his wife."},{"id":"semetey-1-2013:p1029:b004:l022","ordinal":155666,"en":"My dear sister-in-law!"},{"id":"semetey-1-2013:p1029:b004:l023","ordinal":155667,"en":"Beg him to spare my blood."},{"id":"semetey-1-2013:p1029:b004:l024","ordinal":155668,"en":"If you do not ask, it will not end well;"},{"id":"semetey-1-2013:p1029:b004:l025","ordinal":155669,"en":"My sultan will not leave me unharmed!\""},{"id":"semetey-1-2013:p1029:b004:l026","ordinal":155670,"en":"Having said this, Kulchoro"},{"id":"semetey-1-2013:p1029:b004:l027","ordinal":155671,"en":"Stood holding the steed."},{"id":"semetey-1-2013:p1029:b004:l028","ordinal":155672,"en":"Seeing her lord, Aichurok"},{"id":"semetey-1-2013:p1029:b004:l029","ordinal":155673,"en":"Stood watching from the riverbank;"},{"id":"semetey-1-2013:p1029:b004:l030","ordinal":155674,"en":"Thirty brides and thirty maidens"},{"id":"semetey-1-2013:p1029:b004:l031","ordinal":155675,"en":"Watched together in wonder."},{"id":"semetey-1-2013:p1029:b004:l032","ordinal":155676,"en":"Beating the fourteen horses,"},{"id":"semetey-1-2013:p1029:b004:l033","ordinal":155677,"en":"Your swaggering unfortunate man"},{"id":"semetey-1-2013:p1029:b004:l034","ordinal":155678,"en":"Made ready to enter the Urgench."},{"id":"semetey-1-2013:p1029:b004:l035","ordinal":155679,"en":"To keep his lord from entering the water,"},{"id":"semetey-1-2013:p1029:b004:l036","ordinal":155680,"en":"Speaking gently in his distress,"},{"id":"semetey-1-2013:p1029:b004:l037","ordinal":155681,"en":"Kanchoro came to his lord"},{"id":"semetey-1-2013:p1029:b004:l038","ordinal":155682,"en":"And pleaded, calling him \"dear uncle\":"},{"id":"semetey-1-2013:p1029:b004:l039","ordinal":155683,"en":"\"I shall babble and tell you one thing:"},{"id":"semetey-1-2013:p1030:b003:l001","ordinal":155684,"en":"Understand my babbling words;"},{"id":"semetey-1-2013:p1030:b003:l002","ordinal":155685,"en":"My fortunate elder brother, heed what I say."},{"id":"semetey-1-2013:p1030:b003:l003","ordinal":155686,"en":"Silver-eyed and sun-faced,"},{"id":"semetey-1-2013:p1030:b003:l004","ordinal":155687,"en":"My thundering elder brother;"},{"id":"semetey-1-2013:p1030:b003:l005","ordinal":155688,"en":"Golden-eyed and moon-faced,"},{"id":"semetey-1-2013:p1030:b003:l006","ordinal":155689,"en":"My dear lordly brother—"},{"id":"semetey-1-2013:p1030:b003:l007","ordinal":155690,"en":"Before us lies this water,"},{"id":"semetey-1-2013:p1030:b003:l008","ordinal":155691,"en":"And here is a manifest enemy."},{"id":"semetey-1-2013:p1030:b003:l009","ordinal":155692,"en":"Let us not be swept away by chance,"},{"id":"semetey-1-2013:p1030:b003:l010","ordinal":155693,"en":"Overtaken suddenly by death,"},{"id":"semetey-1-2013:p1030:b003:l011","ordinal":155694,"en":"And perish in destruction."},{"id":"semetey-1-2013:p1030:b003:l012","ordinal":155695,"en":"Precious lives that did not die by an enemy—"},{"id":"semetey-1-2013:p1030:b003:l013","ordinal":155696,"en":"Let us not lose them to speechless water!"},{"id":"semetey-1-2013:p1030:b003:l014","ordinal":155697,"en":"My dear khan and elder brother,"},{"id":"semetey-1-2013:p1030:b003:l015","ordinal":155698,"en":"Let us line up the fourteen horses;"},{"id":"semetey-1-2013:p1030:b003:l016","ordinal":155699,"en":"Along this immoderately rushing river,"},{"id":"semetey-1-2013:p1030:b003:l017","ordinal":155700,"en":"Let us search apart for a crossing,"},{"id":"semetey-1-2013:p1030:b003:l018","ordinal":155701,"en":"Find a shallow channel,"},{"id":"semetey-1-2013:p1030:b003:l019","ordinal":155702,"en":"And somehow make our way across.\""},{"id":"semetey-1-2013:p1030:b003:l020","ordinal":155703,"en":"When Kanchoro had said this,"},{"id":"semetey-1-2013:p1030:b003:l021","ordinal":155704,"en":"His lord's anger rose;"},{"id":"semetey-1-2013:p1030:b003:l022","ordinal":155705,"en":"He began a tumult"},{"id":"semetey-1-2013:p1030:b003:l023","ordinal":155706,"en":"And nearly swallowed Choro"},{"id":"semetey-1-2013:p1030:b003:l024","ordinal":155707,"en":"Together with his horse:"},{"id":"semetey-1-2013:p1030:b003:l025","ordinal":155708,"en":"\"Damn you, Kanchoro!"},{"id":"semetey-1-2013:p1030:b003:l026","ordinal":155709,"en":"Is it right to fear death?"},{"id":"semetey-1-2013:p1030:b003:l027","ordinal":155710,"en":"In a world where none lives forever,"},{"id":"semetey-1-2013:p1030:b003:l028","ordinal":155711,"en":"Can anyone have a spine of iron?"},{"id":"semetey-1-2013:p1030:b003:l029","ordinal":155712,"en":"You fear the rushing water;"},{"id":"semetey-1-2013:p1030:b003:l030","ordinal":155713,"en":"If ten thousand human enemies appeared,"},{"id":"semetey-1-2013:p1030:b003:l031","ordinal":155714,"en":"How could you not fear them?"},{"id":"semetey-1-2013:p1030:b003:l032","ordinal":155715,"en":"You fear the swollen water;"},{"id":"semetey-1-2013:p1030:b003:l033","ordinal":155716,"en":"When spear points sway,"},{"id":"semetey-1-2013:p1030:b003:l034","ordinal":155717,"en":"When human heads roll,"},{"id":"semetey-1-2013:p1030:b003:l035","ordinal":155718,"en":"If sixty human enemies appeared,"},{"id":"semetey-1-2013:p1030:b003:l036","ordinal":155719,"en":"How could you not fear them?"},{"id":"semetey-1-2013:p1030:b003:l037","ordinal":155720,"en":"You have feared the floodwater;"},{"id":"semetey-1-2013:p1030:b003:l038","ordinal":155721,"en":"May God strike you!"},{"id":"semetey-1-2013:p1030:b003:l039","ordinal":155722,"en":"Does the angel Gabriel,"},{"id":"semetey-1-2013:p1030:b004:l001","ordinal":155723,"en":"Thinking, 'These men will cross the water,'"},{"id":"semetey-1-2013:p1030:b004:l002","ordinal":155724,"en":"Spread out his five fingers,"},{"id":"semetey-1-2013:p1030:b004:l003","ordinal":155725,"en":"Ready his knife and loom there,"},{"id":"semetey-1-2013:p1030:b004:l004","ordinal":155726,"en":"Watching from the farther bank?"},{"id":"semetey-1-2013:p1030:b004:l005","ordinal":155727,"en":"You fear the rushing water;"},{"id":"semetey-1-2013:p1030:b004:l006","ordinal":155728,"en":"Do not babble, you rascal—"},{"id":"semetey-1-2013:p1030:b004:l007","ordinal":155729,"en":"Turn back and go away!"},{"id":"semetey-1-2013:p1030:b004:l008","ordinal":155730,"en":"Will thirty brides and thirty maidens,"},{"id":"semetey-1-2013:p1030:b004:l009","ordinal":155731,"en":"With your sister-in-law among them,"},{"id":"semetey-1-2013:p1030:b004:l010","ordinal":155732,"en":"Not say, 'White divers have come,'"},{"id":"semetey-1-2013:p1030:b004:l011","ordinal":155733,"en":"And devour us without mercy?"},{"id":"semetey-1-2013:p1030:b004:l012","ordinal":155734,"en":"Will they not say, 'Caravan men have come,'"},{"id":"semetey-1-2013:p1030:b004:l013","ordinal":155735,"en":"And torment us with mockery?"},{"id":"semetey-1-2013:p1030:b004:l014","ordinal":155736,"en":"Will they not sing their taunting song,"},{"id":"semetey-1-2013:p1030:b004:l015","ordinal":155737,"en":"And will brave, manly warriors"},{"id":"semetey-1-2013:p1030:b004:l016","ordinal":155738,"en":"Not suffer disgrace from shame?"},{"id":"semetey-1-2013:p1030:b004:l017","ordinal":155739,"en":"May God strike those maidens—"},{"id":"semetey-1-2013:p1030:b004:l018","ordinal":155740,"en":"Will they not mimic us endlessly?"},{"id":"semetey-1-2013:p1030:b004:l019","ordinal":155741,"en":"Will they not recognize our cowardice"},{"id":"semetey-1-2013:p1030:b004:l020","ordinal":155742,"en":"And laugh at us in scorn?"},{"id":"semetey-1-2013:p1030:b004:l021","ordinal":155743,"en":"'Kulchoro was a falcon;"},{"id":"semetey-1-2013:p1030:b004:l022","ordinal":155744,"en":"He entered the water straight on,' they will say."},{"id":"semetey-1-2013:p1030:b004:l023","ordinal":155745,"en":"'Those men did not dare remain;"},{"id":"semetey-1-2013:p1030:b004:l024","ordinal":155746,"en":"They wandered seeking a ford,' they will say."},{"id":"semetey-1-2013:p1030:b004:l025","ordinal":155747,"en":"'Kulchoro was a hero;"},{"id":"semetey-1-2013:p1030:b004:l026","ordinal":155748,"en":"He rode directly into the water,' they will say."},{"id":"semetey-1-2013:p1030:b004:l027","ordinal":155749,"en":"'The caravan man with an aching head"},{"id":"semetey-1-2013:p1030:b004:l028","ordinal":155750,"en":"Wandered seeking a ford,' they will say."},{"id":"semetey-1-2013:p1030:b004:l029","ordinal":155751,"en":"Will they not say, 'Weaklings have come,'"},{"id":"semetey-1-2013:p1030:b004:l030","ordinal":155752,"en":"And devour us with shrill derision?\""},{"id":"semetey-1-2013:p1030:b004:l031","ordinal":155753,"en":"Saying this in fury,"},{"id":"semetey-1-2013:p1030:b004:l032","ordinal":155754,"en":"He hemmed in the horses;"},{"id":"semetey-1-2013:p1030:b004:l033","ordinal":155755,"en":"Without stopping, making the blows crack,"},{"id":"semetey-1-2013:p1030:b004:l034","ordinal":155756,"en":"He began beating the horses."},{"id":"semetey-1-2013:p1030:b004:l035","ordinal":155757,"en":"The bloodthirsty man unleashed his rage;"},{"id":"semetey-1-2013:p1030:b004:l036","ordinal":155758,"en":"Your sovereign utterly beat"},{"id":"semetey-1-2013:p1030:b004:l037","ordinal":155759,"en":"The fourteen horses from Talas"},{"id":"semetey-1-2013:p1030:b004:l038","ordinal":155760,"en":"And left them slaughtered."},{"id":"semetey-1-2013:p1030:b004:l039","ordinal":155761,"en":"The fourteen horses that came from Ogoi,"},{"id":"semetey-1-2013:p1031:b003:l001","ordinal":155762,"en":"Among the fourteen horses were"},{"id":"semetey-1-2013:p1031:b003:l002","ordinal":155763,"en":"The mighty swift horse Buurul;"},{"id":"semetey-1-2013:p1031:b003:l003","ordinal":155764,"en":"Kanykei's courser Karakaska;"},{"id":"semetey-1-2013:p1031:b003:l004","ordinal":155765,"en":"Sarykan's Tuuchunak;"},{"id":"semetey-1-2013:p1031:b003:l005","ordinal":155766,"en":"Kobosh Khan's Kokborchuk;"},{"id":"semetey-1-2013:p1031:b003:l006","ordinal":155767,"en":"Abyke's Aktelki;"},{"id":"semetey-1-2013:p1031:b003:l007","ordinal":155768,"en":"The sturdy Archa-Toru;"},{"id":"semetey-1-2013:p1031:b003:l008","ordinal":155769,"en":"Chyiyrdy's Bozjorgo;"},{"id":"semetey-1-2013:p1031:b003:l009","ordinal":155770,"en":"The spotted red and the blue with a mane;"},{"id":"semetey-1-2013:p1031:b003:l010","ordinal":155771,"en":"Khan Bakai's Kokcholok;"},{"id":"semetey-1-2013:p1031:b003:l011","ordinal":155772,"en":"Taitoru, who came in mourning"},{"id":"semetey-1-2013:p1031:b003:l012","ordinal":155773,"en":"When noble Manas died;"},{"id":"semetey-1-2013:p1031:b003:l013","ordinal":155774,"en":"Bagysh Khan's Surkiyik;"},{"id":"semetey-1-2013:p1031:b003:l014","ordinal":155775,"en":"Muzburchak's Telkyzyl;"},{"id":"semetey-1-2013:p1031:b003:l015","ordinal":155776,"en":"Shaiymbet's Akkokul;"},{"id":"semetey-1-2013:p1031:b003:l016","ordinal":155777,"en":"The maiden's red pacer;"},{"id":"semetey-1-2013:p1031:b003:l017","ordinal":155778,"en":"And Chachykei's Tik-Toru."},{"id":"semetey-1-2013:p1031:b003:l018","ordinal":155779,"en":"He hemmed in the fourteen horses;"},{"id":"semetey-1-2013:p1031:b003:l019","ordinal":155780,"en":"The lion roared"},{"id":"semetey-1-2013:p1031:b003:l020","ordinal":155781,"en":"And beat them without restraint."},{"id":"semetey-1-2013:p1031:b003:l021","ordinal":155782,"en":"Shouting in fury,"},{"id":"semetey-1-2013:p1031:b003:l022","ordinal":155783,"en":"He called, \"Khan Bakai's Kokcholok"},{"id":"semetey-1-2013:p1031:b003:l023","ordinal":155784,"en":"Must lead!\""},{"id":"semetey-1-2013:p1031:b003:l024","ordinal":155785,"en":"Then Khan Bakai's Kokcholok"},{"id":"semetey-1-2013:p1031:b003:l025","ordinal":155786,"en":"Outstripped the horses and led the way."},{"id":"semetey-1-2013:p1031:b003:l026","ordinal":155787,"en":"At the sound of the uproar he sprang apart;"},{"id":"semetey-1-2013:p1031:b003:l027","ordinal":155788,"en":"He had no tongue with which to tell it,"},{"id":"semetey-1-2013:p1031:b003:l028","ordinal":155789,"en":"But the marks of a true courser showed."},{"id":"semetey-1-2013:p1031:b003:l029","ordinal":155790,"en":"He reached the swiftly flowing Urgench"},{"id":"semetey-1-2013:p1031:b003:l030","ordinal":155791,"en":"And entered it at the head of the line."},{"id":"semetey-1-2013:p1031:b003:l031","ordinal":155792,"en":"When Kokcholok entered the water,"},{"id":"semetey-1-2013:p1031:b003:l032","ordinal":155793,"en":"All fourteen horses pitched forward"},{"id":"semetey-1-2013:p1031:b003:l033","ordinal":155794,"en":"And plunged fully into the river."},{"id":"semetey-1-2013:p1031:b003:l034","ordinal":155795,"en":"At the place where they entered, the Great Urgench"},{"id":"semetey-1-2013:p1031:b003:l035","ordinal":155796,"en":"Drove all fourteen horses"},{"id":"semetey-1-2013:p1031:b003:l036","ordinal":155797,"en":"As though pursuing an enemy."},{"id":"semetey-1-2013:p1031:b003:l037","ordinal":155798,"en":"The Urgench flowed with a thunderous roar;"},{"id":"semetey-1-2013:p1031:b003:l038","ordinal":155799,"en":"Its fierce current showed plainly."},{"id":"semetey-1-2013:p1031:b003:l039","ordinal":155800,"en":"All fourteen horses"},{"id":"semetey-1-2013:p1031:b004:l001","ordinal":155801,"en":"Were swept along, floundering like kids,"},{"id":"semetey-1-2013:p1031:b004:l002","ordinal":155802,"en":"And separated from one another."},{"id":"semetey-1-2013:p1031:b004:l003","ordinal":155803,"en":"Your unfortunate lion of a lord,"},{"id":"semetey-1-2013:p1031:b004:l004","ordinal":155804,"en":"When the horses entered the water,"},{"id":"semetey-1-2013:p1031:b004:l005","ordinal":155805,"en":"Entered the river with them."},{"id":"semetey-1-2013:p1031:b004:l006","ordinal":155806,"en":"His hands were soaked in the water;"},{"id":"semetey-1-2013:p1031:b004:l007","ordinal":155807,"en":"Then the lion-like lord"},{"id":"semetey-1-2013:p1031:b004:l008","ordinal":155808,"en":"Pleaded with the one God."},{"id":"semetey-1-2013:p1031:b004:l009","ordinal":155809,"en":"Behind him came Kanchoro:"},{"id":"semetey-1-2013:p1031:b004:l010","ordinal":155810,"en":"\"If I am left and parted from my elder brother,"},{"id":"semetey-1-2013:p1031:b004:l011","ordinal":155811,"en":"To what grave can I go?\" he thought."},{"id":"semetey-1-2013:p1031:b004:l012","ordinal":155812,"en":"He placed his belt around his neck,"},{"id":"semetey-1-2013:p1031:b004:l013","ordinal":155813,"en":"Caught hold of the hem, crying, \"Elder brother!\""},{"id":"semetey-1-2013:p1031:b004:l014","ordinal":155814,"en":"And entered with him, pleading."},{"id":"semetey-1-2013:p1031:b004:l015","ordinal":155815,"en":"All fourteen horses"},{"id":"semetey-1-2013:p1031:b004:l016","ordinal":155816,"en":"Strained to swim upstream;"},{"id":"semetey-1-2013:p1031:b004:l017","ordinal":155817,"en":"Semetey went on then,"},{"id":"semetey-1-2013:p1031:b004:l018","ordinal":155818,"en":"Struggling with the fourteen horses."},{"id":"semetey-1-2013:p1031:b004:l019","ordinal":155819,"en":"Zulpukor, the gift left to him"},{"id":"semetey-1-2013:p1031:b004:l020","ordinal":155820,"en":"By his gray-maned father Manas—"},{"id":"semetey-1-2013:p1031:b004:l021","ordinal":155821,"en":"He drew the sword from its sheath and swung it,"},{"id":"semetey-1-2013:p1031:b004:l022","ordinal":155822,"en":"And the wave that came straight at him"},{"id":"semetey-1-2013:p1031:b004:l023","ordinal":155823,"en":"He cut clean across."},{"id":"semetey-1-2013:p1031:b004:l024","ordinal":155824,"en":"They resisted the water,"},{"id":"semetey-1-2013:p1031:b004:l025","ordinal":155825,"en":"Fighting against the flowing current."},{"id":"semetey-1-2013:p1031:b004:l026","ordinal":155826,"en":"He gathered force like a cuckoo;"},{"id":"semetey-1-2013:p1031:b004:l027","ordinal":155827,"en":"The lion emerged from the water,"},{"id":"semetey-1-2013:p1031:b004:l028","ordinal":155828,"en":"Scolding Kulchoro."},{"id":"semetey-1-2013:p1031:b004:l029","ordinal":155829,"en":"Putting forth all his strength,"},{"id":"semetey-1-2013:p1031:b004:l030","ordinal":155830,"en":"The lion barely made it out, as you see;"},{"id":"semetey-1-2013:p1031:b004:l031","ordinal":155831,"en":"The fourteen horses that came from Ogoi"},{"id":"semetey-1-2013:p1031:b004:l032","ordinal":155832,"en":"Emerged alive, as you see."},{"id":"semetey-1-2013:p1031:b004:l033","ordinal":155833,"en":"Looming at the head of them,"},{"id":"semetey-1-2013:p1031:b004:l034","ordinal":155834,"en":"The hero came out of the Urgench."},{"id":"semetey-1-2013:p1031:b004:l035","ordinal":155835,"en":"His chosen Kyrgyz companions"},{"id":"semetey-1-2013:p1031:b004:l036","ordinal":155836,"en":"Numbered twenty-five souls;"},{"id":"semetey-1-2013:p1031:b004:l037","ordinal":155837,"en":"Each was a tiger worth a thousand men,"},{"id":"semetey-1-2013:p1031:b004:l038","ordinal":155838,"en":"And they emerged alive from the Urgench."},{"id":"semetey-1-2013:p1031:b004:l039","ordinal":155839,"en":"The lion, falcon, bloodthirsty champion,"},{"id":"semetey-1-2013:p1032:b003:l001","ordinal":155840,"en":"Without saying, \"These are in-laws I have never seen,\""},{"id":"semetey-1-2013:p1032:b003:l002","ordinal":155841,"en":"The poor hero grew furious."},{"id":"semetey-1-2013:p1032:b003:l003","ordinal":155842,"en":"He drew himself up in a surge of power,"},{"id":"semetey-1-2013:p1032:b003:l004","ordinal":155843,"en":"Scolding Kulchoro."},{"id":"semetey-1-2013:p1032:b003:l005","ordinal":155844,"en":"Your gray-maned hero went onward,"},{"id":"semetey-1-2013:p1032:b003:l006","ordinal":155845,"en":"Water streaming from the tops of his boots."},{"id":"semetey-1-2013:p1032:b003:l007","ordinal":155846,"en":"All the maidens and brides"},{"id":"semetey-1-2013:p1032:b003:l008","ordinal":155847,"en":"Cried out then"},{"id":"semetey-1-2013:p1032:b003:l009","ordinal":155848,"en":"And took shelter in their pavilion."},{"id":"semetey-1-2013:p1032:b003:l010","ordinal":155849,"en":"His eyes reddened like a lion's;"},{"id":"semetey-1-2013:p1032:b003:l011","ordinal":155850,"en":"The hero Semetey advanced,"},{"id":"semetey-1-2013:p1032:b003:l012","ordinal":155851,"en":"Giving voice to his anger."},{"id":"semetey-1-2013:p1032:b003:l013","ordinal":155852,"en":"Chilled through, the fourteen horses"},{"id":"semetey-1-2013:p1032:b003:l014","ordinal":155853,"en":"Reared and played,"},{"id":"semetey-1-2013:p1032:b003:l015","ordinal":155854,"en":"Stamping the black earth."},{"id":"semetey-1-2013:p1032:b003:l016","ordinal":155855,"en":"Semetey raged"},{"id":"semetey-1-2013:p1032:b003:l017","ordinal":155856,"en":"And then berated Kulchoro."},{"id":"semetey-1-2013:p1032:b003:l018","ordinal":155857,"en":"Furious and surging with wrath,"},{"id":"semetey-1-2013:p1032:b003:l019","ordinal":155858,"en":"Without caring that the people stood there,"},{"id":"semetey-1-2013:p1032:b003:l020","ordinal":155859,"en":"He scolded Kulchoro:"},{"id":"semetey-1-2013:p1032:b003:l021","ordinal":155860,"en":"\"You are a ruinous boy!"},{"id":"semetey-1-2013:p1032:b003:l022","ordinal":155861,"en":"When will you seek the ford?"},{"id":"semetey-1-2013:p1032:b003:l023","ordinal":155862,"en":"Whenever you find a bedraggled maiden,"},{"id":"semetey-1-2013:p1032:b003:l024","ordinal":155863,"en":"You linger and play with her!"},{"id":"semetey-1-2013:p1032:b003:l025","ordinal":155864,"en":"If you carry on this way, you wretch,"},{"id":"semetey-1-2013:p1032:b003:l026","ordinal":155865,"en":"You will bring disaster upon me!"},{"id":"semetey-1-2013:p1032:b003:l027","ordinal":155866,"en":"You are a calamitous boy;"},{"id":"semetey-1-2013:p1032:b003:l028","ordinal":155867,"en":"Beside a maiden before you,"},{"id":"semetey-1-2013:p1032:b003:l029","ordinal":155868,"en":"You stretch yourself out and lie there."},{"id":"semetey-1-2013:p1032:b003:l030","ordinal":155869,"en":"If you carry on this way, you wretch,"},{"id":"semetey-1-2013:p1032:b003:l031","ordinal":155870,"en":"You will bring disaster upon me!"},{"id":"semetey-1-2013:p1032:b003:l032","ordinal":155871,"en":"Whenever there are maidens riding a swing,"},{"id":"semetey-1-2013:p1032:b003:l033","ordinal":155872,"en":"You stay to frolic and play;"},{"id":"semetey-1-2013:p1032:b003:l034","ordinal":155873,"en":"Whenever there are maidens digging dye,"},{"id":"semetey-1-2013:p1032:b003:l035","ordinal":155874,"en":"You play with them improperly!"},{"id":"semetey-1-2013:p1032:b003:l036","ordinal":155875,"en":"If you continue like this, little brat,"},{"id":"semetey-1-2013:p1032:b003:l037","ordinal":155876,"en":"You will bring disaster upon me!"},{"id":"semetey-1-2013:p1032:b003:l038","ordinal":155877,"en":"Whenever there are maidens gathering reeds,"},{"id":"semetey-1-2013:p1032:b003:l039","ordinal":155878,"en":"You stay there playing eagerly;"},{"id":"semetey-1-2013:p1032:b004:l001","ordinal":155879,"en":"Whenever there are maidens gathering dung,"},{"id":"semetey-1-2013:p1032:b004:l002","ordinal":155880,"en":"You stay there playing foolishly!"},{"id":"semetey-1-2013:p1032:b004:l003","ordinal":155881,"en":"If you encounter a caravan maiden,"},{"id":"semetey-1-2013:p1032:b004:l004","ordinal":155882,"en":"Without saying, 'My elder brother will grieve,'"},{"id":"semetey-1-2013:p1032:b004:l005","ordinal":155883,"en":"You remain there playing senselessly."},{"id":"semetey-1-2013:p1032:b004:l006","ordinal":155884,"en":"If you do not abandon this conduct,"},{"id":"semetey-1-2013:p1032:b004:l007","ordinal":155885,"en":"You will bring disaster upon me!"},{"id":"semetey-1-2013:p1032:b004:l008","ordinal":155886,"en":"When you mount Buurul, you dash away"},{"id":"semetey-1-2013:p1032:b004:l009","ordinal":155887,"en":"And vanish in a frenzy;"},{"id":"semetey-1-2013:p1032:b004:l010","ordinal":155888,"en":"Without once turning to think,"},{"id":"semetey-1-2013:p1032:b004:l011","ordinal":155889,"en":"'My elder brother, my champion, was left behind,'"},{"id":"semetey-1-2013:p1032:b004:l012","ordinal":155890,"en":"You forget him entirely!"},{"id":"semetey-1-2013:p1032:b004:l013","ordinal":155891,"en":"You beg deceitfully for a horse to ride"},{"id":"semetey-1-2013:p1032:b004:l014","ordinal":155892,"en":"And then begin"},{"id":"semetey-1-2013:p1032:b004:l015","ordinal":155893,"en":"An uproar beyond all restraint!"},{"id":"semetey-1-2013:p1032:b004:l016","ordinal":155894,"en":"Upon a bare and windswept ridge,"},{"id":"semetey-1-2013:p1032:b004:l017","ordinal":155895,"en":"You leave me looming like a frozen camel"},{"id":"semetey-1-2013:p1032:b004:l018","ordinal":155896,"en":"And ride away!"},{"id":"semetey-1-2013:p1032:b004:l019","ordinal":155897,"en":"When you see a maiden, you whine,"},{"id":"semetey-1-2013:p1032:b004:l020","ordinal":155898,"en":"And follow alongside her;"},{"id":"semetey-1-2013:p1032:b004:l021","ordinal":155899,"en":"You forget your elder brother, great as a mountain,"},{"id":"semetey-1-2013:p1032:b004:l022","ordinal":155900,"en":"In the barren steppe,"},{"id":"semetey-1-2013:p1032:b004:l023","ordinal":155901,"en":"And deceive him and leave!"},{"id":"semetey-1-2013:p1032:b004:l024","ordinal":155902,"en":"You do not ride your own horse;"},{"id":"semetey-1-2013:p1032:b004:l025","ordinal":155903,"en":"You doomed wretch,"},{"id":"semetey-1-2013:p1032:b004:l026","ordinal":155904,"en":"You never go about speaking the truth!"}]
