[{"id":"semetey-1-2013:p0834:b004:l020","ordinal":140801,"en":"Beneath him was Tuuchunak;"},{"id":"semetey-1-2013:p0834:b004:l021","ordinal":140802,"en":"He had that outstanding noble steed,"},{"id":"semetey-1-2013:p0834:b004:l022","ordinal":140803,"en":"Seasoned in fighting the enemy."},{"id":"semetey-1-2013:p0834:b004:l023","ordinal":140804,"en":"That splendid noble beast,"},{"id":"semetey-1-2013:p0834:b004:l024","ordinal":140805,"en":"Tuuchunak, a true thoroughbred—"},{"id":"semetey-1-2013:p0834:b004:l025","ordinal":140806,"en":"They drew the reins and turned,"},{"id":"semetey-1-2013:p0834:b004:l026","ordinal":140807,"en":"And at the thousand troops before them"},{"id":"semetey-1-2013:p0834:b004:l027","ordinal":140808,"en":"They stood astonished."},{"id":"semetey-1-2013:p0834:b004:l028","ordinal":140809,"en":"One spoke to the other:"},{"id":"semetey-1-2013:p0834:b004:l029","ordinal":140810,"en":"“Do you see, Sary Khan?"},{"id":"semetey-1-2013:p0834:b004:l030","ordinal":140811,"en":"Don't guess up and down,"},{"id":"semetey-1-2013:p0834:b004:l031","ordinal":140812,"en":"If my only son falls into their hands,"},{"id":"semetey-1-2013:p0834:b004:l032","ordinal":140813,"en":"These fools seem unlikely to leave him alive."},{"id":"semetey-1-2013:p0834:b004:l033","ordinal":140814,"en":"Pale banners, red standards,"},{"id":"semetey-1-2013:p0834:b004:l034","ordinal":140815,"en":"Cries of ‘Boy-boy!’ and uproar—"},{"id":"semetey-1-2013:p0834:b004:l035","ordinal":140816,"en":"There is no bulging mountain,"},{"id":"semetey-1-2013:p0834:b004:l036","ordinal":140817,"en":"No one has returned from their side."},{"id":"semetey-1-2013:p0834:b004:l037","ordinal":140818,"en":"A sweeping gale is coming;"},{"id":"semetey-1-2013:p0834:b004:l038","ordinal":140819,"en":"A vast, tumultuous people is coming!”"},{"id":"semetey-1-2013:p0834:b004:l039","ordinal":140820,"en":"When those two spoke thus,"},{"id":"semetey-1-2013:p0835:b003:l001","ordinal":140821,"en":"Semetey stood and said:"},{"id":"semetey-1-2013:p0835:b003:l002","ordinal":140822,"en":"“If they act as enemies,"},{"id":"semetey-1-2013:p0835:b003:l003","ordinal":140823,"en":"Let us endure the trouble they bring."},{"id":"semetey-1-2013:p0835:b003:l004","ordinal":140824,"en":"If they attack where we meet,"},{"id":"semetey-1-2013:p0835:b003:l005","ordinal":140825,"en":"Then let us give them our greeting."},{"id":"semetey-1-2013:p0835:b003:l006","ordinal":140826,"en":"If we eagerly exchange fire,"},{"id":"semetey-1-2013:p0835:b003:l007","ordinal":140827,"en":"Get rid of wrestling,"},{"id":"semetey-1-2013:p0835:b003:l008","ordinal":140828,"en":"If they themselves come lumbering to attack,"},{"id":"semetey-1-2013:p0835:b003:l009","ordinal":140829,"en":"Then let us strike."},{"id":"semetey-1-2013:p0835:b003:l010","ordinal":140830,"en":"The duty of a Muslim—"},{"id":"semetey-1-2013:p0835:b003:l011","ordinal":140831,"en":"My mother and my uncle,"},{"id":"semetey-1-2013:p0835:b003:l012","ordinal":140832,"en":"Let us first discharge it!"},{"id":"semetey-1-2013:p0835:b003:l013","ordinal":140833,"en":"If we attack without cause,"},{"id":"semetey-1-2013:p0835:b003:l014","ordinal":140834,"en":"If we begin the turmoil,"},{"id":"semetey-1-2013:p0835:b003:l015","ordinal":140835,"en":"If we slaughter them unawares,"},{"id":"semetey-1-2013:p0835:b003:l016","ordinal":140836,"en":"They too are children of Muslims."},{"id":"semetey-1-2013:p0835:b003:l017","ordinal":140837,"en":"In the end, one day we shall die;"},{"id":"semetey-1-2013:p0835:b003:l018","ordinal":140838,"en":"If what is told is true,"},{"id":"semetey-1-2013:p0835:b003:l019","ordinal":140839,"en":"On the coming Day of Resurrection,"},{"id":"semetey-1-2013:p0835:b003:l020","ordinal":140840,"en":"If the faithful demand justice for their blood,"},{"id":"semetey-1-2013:p0835:b003:l021","ordinal":140841,"en":"What answer shall we give?"},{"id":"semetey-1-2013:p0835:b003:l022","ordinal":140842,"en":"You were the more resourceful one,"},{"id":"semetey-1-2013:p0835:b003:l023","ordinal":140843,"en":"These Muslims coming toward us"},{"id":"semetey-1-2013:p0835:b003:l024","ordinal":140844,"en":"Are no people come from China."},{"id":"semetey-1-2013:p0835:b003:l025","ordinal":140845,"en":"My mother and my uncle,"},{"id":"semetey-1-2013:p0835:b003:l026","ordinal":140846,"en":"Take the road and go on."},{"id":"semetey-1-2013:p0835:b003:l027","ordinal":140847,"en":"If they have an embassy’s purpose,"},{"id":"semetey-1-2013:p0835:b003:l028","ordinal":140848,"en":"Let me listen carefully and understand."},{"id":"semetey-1-2013:p0835:b003:l029","ordinal":140849,"en":"If they come out to crush me in battle,"},{"id":"semetey-1-2013:p0835:b003:l030","ordinal":140850,"en":"Let me kill and put them in the earth."},{"id":"semetey-1-2013:p0835:b003:l031","ordinal":140851,"en":"If Muslims exchange fire with me,"},{"id":"semetey-1-2013:p0835:b003:l032","ordinal":140852,"en":"Let me die if my time has come."},{"id":"semetey-1-2013:p0835:b003:l033","ordinal":140853,"en":"Their friendship or hostility—"},{"id":"semetey-1-2013:p0835:b003:l034","ordinal":140854,"en":"Let me carefully discern it."},{"id":"semetey-1-2013:p0835:b003:l035","ordinal":140855,"en":"If they face me as enemies,"},{"id":"semetey-1-2013:p0835:b003:l036","ordinal":140856,"en":"Even enemies come from Mecca,"},{"id":"semetey-1-2013:p0835:b003:l037","ordinal":140857,"en":"Let me face and fight them,"},{"id":"semetey-1-2013:p0835:b003:l038","ordinal":140858,"en":"And drive them as far as Mecca."},{"id":"semetey-1-2013:p0835:b003:l039","ordinal":140859,"en":"Even mountains no generation has crossed,"},{"id":"semetey-1-2013:p0835:b005:l001","ordinal":140860,"en":"Even enemies come from China—"},{"id":"semetey-1-2013:p0835:b005:l002","ordinal":140861,"en":"Then let me slaughter them all."},{"id":"semetey-1-2013:p0835:b005:l003","ordinal":140862,"en":"Perhaps they come in friendship;"},{"id":"semetey-1-2013:p0835:b005:l004","ordinal":140863,"en":"Let me somehow hear their answer."},{"id":"semetey-1-2013:p0835:b005:l005","ordinal":140864,"en":"If they come pursuing and fighting,"},{"id":"semetey-1-2013:p0835:b005:l006","ordinal":140865,"en":"Let me kill and put them in the earth.”"},{"id":"semetey-1-2013:p0835:b005:l007","ordinal":140866,"en":"Having said this, Semetey"},{"id":"semetey-1-2013:p0835:b005:l008","ordinal":140867,"en":"His mother and his uncle"},{"id":"semetey-1-2013:p0835:b005:l009","ordinal":140868,"en":"Sent ahead."},{"id":"semetey-1-2013:p0835:b005:l010","ordinal":140869,"en":"And seized the bridle"},{"id":"semetey-1-2013:p0835:b005:l011","ordinal":140870,"en":"He drew the reins and turned;"},{"id":"semetey-1-2013:p0835:b005:l012","ordinal":140871,"en":"Your orphan, Manas’s son,"},{"id":"semetey-1-2013:p0835:b005:l013","ordinal":140872,"en":"Stood watching without weariness."},{"id":"semetey-1-2013:p0835:b005:l014","ordinal":140873,"en":"At the sight, hearts were troubled;"},{"id":"semetey-1-2013:p0835:b005:l015","ordinal":140874,"en":"Fierce, lion Manas—"},{"id":"semetey-1-2013:p0835:b005:l016","ordinal":140875,"en":"He looked exactly like him."},{"id":"semetey-1-2013:p0835:b005:l017","ordinal":140876,"en":"That dear lion, like a quiver,"},{"id":"semetey-1-2013:p0835:b005:l018","ordinal":140877,"en":"Stood motionless in that place."},{"id":"semetey-1-2013:p0835:b005:l019","ordinal":140878,"en":"The thousand champions surging toward him"},{"id":"semetey-1-2013:p0835:b005:l020","ordinal":140879,"en":"Were deeply troubled at heart."},{"id":"semetey-1-2013:p0835:b005:l021","ordinal":140880,"en":"Your orphan, Manas’s son,"},{"id":"semetey-1-2013:p0835:b005:l022","ordinal":140881,"en":"Appeared like Mount Opol."},{"id":"semetey-1-2013:p0835:b005:l023","ordinal":140882,"en":"When the boy faced them,"},{"id":"semetey-1-2013:p0835:b005:l024","ordinal":140883,"en":"He had a dragon’s appearance;"},{"id":"semetey-1-2013:p0835:b005:l025","ordinal":140884,"en":"When the boy turned his back,"},{"id":"semetey-1-2013:p0835:b005:l026","ordinal":140885,"en":"He had a lion’s majesty."},{"id":"semetey-1-2013:p0835:b005:l027","ordinal":140886,"en":"Challenging a blessed hero,"},{"id":"semetey-1-2013:p0835:b005:l028","ordinal":140887,"en":"Entangling themselves in death—"},{"id":"semetey-1-2013:p0835:b005:l029","ordinal":140888,"en":"These Sarts must have a demon in them."},{"id":"semetey-1-2013:p0835:b005:l030","ordinal":140889,"en":"The champions surged toward the boy,"},{"id":"semetey-1-2013:p0835:b005:l031","ordinal":140890,"en":"Intending to make a great spectacle of him."},{"id":"semetey-1-2013:p0835:b005:l032","ordinal":140891,"en":"Attacking him all together,"},{"id":"semetey-1-2013:p0835:b005:l033","ordinal":140892,"en":"They intended great havoc."},{"id":"semetey-1-2013:p0835:b005:l034","ordinal":140893,"en":"All the champions,"},{"id":"semetey-1-2013:p0835:b005:l035","ordinal":140894,"en":"Janaaly and their elder Karach,"},{"id":"semetey-1-2013:p0835:b005:l036","ordinal":140895,"en":"Four champions who lifted camels,"},{"id":"semetey-1-2013:p0835:b005:l037","ordinal":140896,"en":"Five champions who punched camels,"},{"id":"semetey-1-2013:p0835:b005:l038","ordinal":140897,"en":"All the champions"},{"id":"semetey-1-2013:p0835:b005:l039","ordinal":140898,"en":"Cried, “Do not flee! Do not flee! Do not flee!”"},{"id":"semetey-1-2013:p0836:b003:l001","ordinal":140899,"en":"Their roaring split stone;"},{"id":"semetey-1-2013:p0836:b003:l002","ordinal":140900,"en":"Their shouting split heads."},{"id":"semetey-1-2013:p0836:b003:l003","ordinal":140901,"en":"“Manas’s orphan slave,"},{"id":"semetey-1-2013:p0836:b003:l004","ordinal":140902,"en":"Even if you have forty-five lives,"},{"id":"semetey-1-2013:p0836:b003:l005","ordinal":140903,"en":"Behold the face of Judgment!” they cried."},{"id":"semetey-1-2013:p0836:b003:l006","ordinal":140904,"en":"All the thousand champions"},{"id":"semetey-1-2013:p0836:b003:l007","ordinal":140905,"en":"Leveled their spears together;"},{"id":"semetey-1-2013:p0836:b003:l008","ordinal":140906,"en":"As their signal for battle,"},{"id":"semetey-1-2013:p0836:b003:l009","ordinal":140907,"en":"They beat the drums."},{"id":"semetey-1-2013:p0836:b003:l010","ordinal":140908,"en":"They drew their bows, raining arrows,"},{"id":"semetey-1-2013:p0836:b003:l011","ordinal":140909,"en":"Fired shots like hail."},{"id":"semetey-1-2013:p0836:b003:l012","ordinal":140910,"en":"The champions rushed in separate groups,"},{"id":"semetey-1-2013:p0836:b003:l013","ordinal":140911,"en":"Shouting here and there."},{"id":"semetey-1-2013:p0836:b003:l014","ordinal":140912,"en":"One wing came forward,"},{"id":"semetey-1-2013:p0836:b003:l015","ordinal":140913,"en":"Roaring “Hindustan!”"},{"id":"semetey-1-2013:p0836:b003:l016","ordinal":140914,"en":"Another wing came forward,"},{"id":"semetey-1-2013:p0836:b003:l017","ordinal":140915,"en":"Crying “Chambyl-Bel!”"},{"id":"semetey-1-2013:p0836:b003:l018","ordinal":140916,"en":"The great mass in the center came,"},{"id":"semetey-1-2013:p0836:b003:l019","ordinal":140917,"en":"Crying the battle cry “Kokand!”"},{"id":"semetey-1-2013:p0836:b003:l020","ordinal":140918,"en":"If you looked at this wing,"},{"id":"semetey-1-2013:p0836:b003:l021","ordinal":140919,"en":"They rushed about crying “Samarkand!”"},{"id":"semetey-1-2013:p0836:b003:l022","ordinal":140920,"en":"If you looked at that wing,"},{"id":"semetey-1-2013:p0836:b003:l023","ordinal":140921,"en":"They advanced crying “Andijan!”"},{"id":"semetey-1-2013:p0836:b003:l024","ordinal":140922,"en":"On every side was shouting;"},{"id":"semetey-1-2013:p0836:b003:l025","ordinal":140923,"en":"Observing each of them,"},{"id":"semetey-1-2013:p0836:b003:l026","ordinal":140924,"en":"They cried the battle cries of their own lands."},{"id":"semetey-1-2013:p0836:b003:l027","ordinal":140925,"en":"Semetey stood astonished,"},{"id":"semetey-1-2013:p0836:b003:l028","ordinal":140926,"en":"Staring, dumbfounded with wonder."},{"id":"semetey-1-2013:p0836:b003:l029","ordinal":140927,"en":"Shrill cries and fierce rallying shouts,"},{"id":"semetey-1-2013:p0836:b003:l030","ordinal":140928,"en":"Their clamor deafening the ears,"},{"id":"semetey-1-2013:p0836:b003:l031","ordinal":140929,"en":"They yelled and leveled their spears,"},{"id":"semetey-1-2013:p0836:b003:l032","ordinal":140930,"en":"As though to reap and gather him,"},{"id":"semetey-1-2013:p0836:b003:l033","ordinal":140931,"en":"Manas’s orphan son—"},{"id":"semetey-1-2013:p0836:b003:l034","ordinal":140932,"en":"As though to cut off his head!"},{"id":"semetey-1-2013:p0836:b003:l035","ordinal":140933,"en":"Striking their horses on the flank,"},{"id":"semetey-1-2013:p0836:b003:l036","ordinal":140934,"en":"The two khans, Janaaly and Karach,"},{"id":"semetey-1-2013:p0836:b003:l037","ordinal":140935,"en":"Reached the boy and attacked."},{"id":"semetey-1-2013:p0836:b003:l038","ordinal":140936,"en":"The two khans, Janaaly and Karach,"},{"id":"semetey-1-2013:p0836:b003:l039","ordinal":140937,"en":"Thrust side by side as they passed."},{"id":"semetey-1-2013:p0836:b004:l001","ordinal":140938,"en":"Was he not Manas’s son?"},{"id":"semetey-1-2013:p0836:b004:l002","ordinal":140939,"en":"Semetey did not bend backward."},{"id":"semetey-1-2013:p0836:b004:l003","ordinal":140940,"en":"Behind the two khans,"},{"id":"semetey-1-2013:p0836:b004:l004","ordinal":140941,"en":"The camel-lifting champions,"},{"id":"semetey-1-2013:p0836:b004:l005","ordinal":140942,"en":"Thirty reached him abreast."},{"id":"semetey-1-2013:p0836:b004:l006","ordinal":140943,"en":"At Manas’s orphan son"},{"id":"semetey-1-2013:p0836:b004:l007","ordinal":140944,"en":"The thirty struck thirty blows as they passed."},{"id":"semetey-1-2013:p0836:b004:l008","ordinal":140945,"en":"Beyond his fierce father Manas,"},{"id":"semetey-1-2013:p0836:b004:l009","ordinal":140946,"en":"Your hero was born greater still."},{"id":"semetey-1-2013:p0836:b004:l010","ordinal":140947,"en":"He took not the slightest notice;"},{"id":"semetey-1-2013:p0836:b004:l011","ordinal":140948,"en":"Though so many spears struck him,"},{"id":"semetey-1-2013:p0836:b004:l012","ordinal":140949,"en":"He counted them as nothing;"},{"id":"semetey-1-2013:p0836:b004:l013","ordinal":140950,"en":"He gave a shrug and took no heed."},{"id":"semetey-1-2013:p0836:b004:l014","ordinal":140951,"en":"Girded with a silver belt,"},{"id":"semetey-1-2013:p0836:b004:l015","ordinal":140952,"en":"His sun-like face bathed in light,"},{"id":"semetey-1-2013:p0836:b004:l016","ordinal":140953,"en":"Girded with a golden belt,"},{"id":"semetey-1-2013:p0836:b004:l017","ordinal":140954,"en":"His moon-like face bathed in light,"},{"id":"semetey-1-2013:p0836:b004:l018","ordinal":140955,"en":"His shovel-like teeth shining white,"},{"id":"semetey-1-2013:p0836:b004:l019","ordinal":140956,"en":"Smiling and standing proudly,"},{"id":"semetey-1-2013:p0836:b004:l020","ordinal":140957,"en":"Semetey held his ground."},{"id":"semetey-1-2013:p0836:b004:l021","ordinal":140958,"en":"After the spearmen thrust and passed,"},{"id":"semetey-1-2013:p0836:b004:l022","ordinal":140959,"en":"The axemen reached him."},{"id":"semetey-1-2013:p0836:b004:l023","ordinal":140960,"en":"Kokand’s twelve formidable champions—"},{"id":"semetey-1-2013:p0836:b004:l024","ordinal":140961,"en":"They were recklessly brave;"},{"id":"semetey-1-2013:p0836:b004:l025","ordinal":140962,"en":"All lunged forward and reached him,"},{"id":"semetey-1-2013:p0836:b004:l026","ordinal":140963,"en":"Striking again and again as they passed."},{"id":"semetey-1-2013:p0836:b004:l027","ordinal":140964,"en":"Semetey stood considering;"},{"id":"semetey-1-2013:p0836:b004:l028","ordinal":140965,"en":"The bloodthirsty hero’s son, that warrior,"},{"id":"semetey-1-2013:p0836:b004:l029","ordinal":140966,"en":"Was seized with anger."},{"id":"semetey-1-2013:p0836:b004:l030","ordinal":140967,"en":"His fiery eyes blazed;"},{"id":"semetey-1-2013:p0836:b004:l031","ordinal":140968,"en":"His thirst for blood took hold."},{"id":"semetey-1-2013:p0836:b004:l032","ordinal":140969,"en":"His white teeth, broad as a door,"},{"id":"semetey-1-2013:p0836:b004:l033","ordinal":140970,"en":"He gnashed with a crack."},{"id":"semetey-1-2013:p0836:b004:l034","ordinal":140971,"en":"The spearmen broke formation,"},{"id":"semetey-1-2013:p0836:b004:l035","ordinal":140972,"en":"Again leveled their spears,"},{"id":"semetey-1-2013:p0836:b004:l036","ordinal":140973,"en":"And made themselves ready."},{"id":"semetey-1-2013:p0836:b004:l037","ordinal":140974,"en":"Joining in a general melee,"},{"id":"semetey-1-2013:p0836:b004:l038","ordinal":140975,"en":"All the Sarts fell upon him."},{"id":"semetey-1-2013:p0836:b004:l039","ordinal":140976,"en":"Devastating bows and painted arrows"},{"id":"semetey-1-2013:p0837:b003:l001","ordinal":140977,"en":"They struck together from every side."},{"id":"semetey-1-2013:p0837:b003:l002","ordinal":140978,"en":"Your orphan, Manas’s son,"},{"id":"semetey-1-2013:p0837:b003:l003","ordinal":140979,"en":"Now had words for the Sarts:"},{"id":"semetey-1-2013:p0837:b003:l004","ordinal":140980,"en":"“Though I left you all in peace,"},{"id":"semetey-1-2013:p0837:b003:l005","ordinal":140981,"en":"You level your spears together,"},{"id":"semetey-1-2013:p0837:b003:l006","ordinal":140982,"en":"Beat me without respite,"},{"id":"semetey-1-2013:p0837:b003:l007","ordinal":140983,"en":"Strike with axes from every side,"},{"id":"semetey-1-2013:p0837:b003:l008","ordinal":140984,"en":"And trouble me so greatly—"},{"id":"semetey-1-2013:p0837:b003:l009","ordinal":140985,"en":"Did I drive off your dun horse and flee?"},{"id":"semetey-1-2013:p0837:b003:l010","ordinal":140986,"en":"You damned Sarts,"},{"id":"semetey-1-2013:p0837:b003:l011","ordinal":140987,"en":"Did I scatter the goods in your saddlebags?"},{"id":"semetey-1-2013:p0837:b003:l012","ordinal":140988,"en":"Did I carry off your piebald horse?"},{"id":"semetey-1-2013:p0837:b003:l013","ordinal":140989,"en":"Did I scatter your precious treasury?"},{"id":"semetey-1-2013:p0837:b003:l014","ordinal":140990,"en":"You attacked first, Muslim;"},{"id":"semetey-1-2013:p0837:b003:l015","ordinal":140991,"en":"Your own guilt be upon you,"},{"id":"semetey-1-2013:p0837:b003:l016","ordinal":140992,"en":"Your suffering upon your own dark head!"},{"id":"semetey-1-2013:p0837:b003:l017","ordinal":140993,"en":"Your thousand champions have gathered;"},{"id":"semetey-1-2013:p0837:b003:l018","ordinal":140994,"en":"Is havoc what you wish for?"},{"id":"semetey-1-2013:p0837:b003:l019","ordinal":140995,"en":"Then see what a spectacle I give you!"},{"id":"semetey-1-2013:p0837:b003:l020","ordinal":140996,"en":"Let me dig your deep pits,"},{"id":"semetey-1-2013:p0837:b003:l021","ordinal":140997,"en":"Let me boil your brine."},{"id":"semetey-1-2013:p0837:b003:l022","ordinal":140998,"en":"Let me show before your eyes"},{"id":"semetey-1-2013:p0837:b003:l023","ordinal":140999,"en":"A marvel no mortal has seen!”"},{"id":"semetey-1-2013:p0837:b003:l024","ordinal":141000,"en":"His anger rising without restraint,"},{"id":"semetey-1-2013:p0837:b003:l025","ordinal":141001,"en":"Exerting himself, bracing for battle,"},{"id":"semetey-1-2013:p0837:b003:l026","ordinal":141002,"en":"He charged the enemy before him."},{"id":"semetey-1-2013:p0837:b003:l027","ordinal":141003,"en":"Watch the hero’s deeds!"},{"id":"semetey-1-2013:p0837:b003:l028","ordinal":141004,"en":"Swaying as though struck by a peri,"},{"id":"semetey-1-2013:p0837:b003:l029","ordinal":141005,"en":"Pouncing like a lion,"},{"id":"semetey-1-2013:p0837:b003:l030","ordinal":141006,"en":"Readying his painted spear,"},{"id":"semetey-1-2013:p0837:b003:l031","ordinal":141007,"en":"To Manas, gone to the other world,"},{"id":"semetey-1-2013:p0837:b003:l032","ordinal":141008,"en":"He prayed for his spirit’s aid."},{"id":"semetey-1-2013:p0837:b003:l033","ordinal":141009,"en":"Shouting “Manas!”"},{"id":"semetey-1-2013:p0837:b003:l034","ordinal":141010,"en":"Crying “Manas!” as his battle cry,"},{"id":"semetey-1-2013:p0837:b003:l035","ordinal":141011,"en":"He struck Arbuudan on the flank,"},{"id":"semetey-1-2013:p0837:b003:l036","ordinal":141012,"en":"Attacked the champions."},{"id":"semetey-1-2013:p0837:b003:l037","ordinal":141013,"en":"Semetey, Manas’s son,"},{"id":"semetey-1-2013:p0837:b003:l038","ordinal":141014,"en":"Played with them a little;"},{"id":"semetey-1-2013:p0837:b003:l039","ordinal":141015,"en":"As he played, ten champions"},{"id":"semetey-1-2013:p0837:b004:l001","ordinal":141016,"en":"Lay dead."},{"id":"semetey-1-2013:p0837:b004:l002","ordinal":141017,"en":"A thousand champions had come to challenge him,"},{"id":"semetey-1-2013:p0837:b004:l003","ordinal":141018,"en":"Entangling themselves in death."},{"id":"semetey-1-2013:p0837:b004:l004","ordinal":141019,"en":"Taking Zulpukor in hand,"},{"id":"semetey-1-2013:p0837:b004:l005","ordinal":141020,"en":"Attacking the champions,"},{"id":"semetey-1-2013:p0837:b004:l006","ordinal":141021,"en":"Without looking about him,"},{"id":"semetey-1-2013:p0837:b004:l007","ordinal":141022,"en":"Without sparing his own life,"},{"id":"semetey-1-2013:p0837:b004:l008","ordinal":141023,"en":"Entwined with the champions,"},{"id":"semetey-1-2013:p0837:b004:l009","ordinal":141024,"en":"He joined the general melee."},{"id":"semetey-1-2013:p0837:b004:l010","ordinal":141025,"en":"Thirty of their beks, in one place,"},{"id":"semetey-1-2013:p0837:b004:l011","ordinal":141026,"en":"Lay dead together."},{"id":"semetey-1-2013:p0837:b004:l012","ordinal":141027,"en":"Raising a mighty cry,"},{"id":"semetey-1-2013:p0837:b004:l013","ordinal":141028,"en":"When he fought that fierce battle,"},{"id":"semetey-1-2013:p0837:b004:l014","ordinal":141029,"en":"Forty champions died in one place."},{"id":"semetey-1-2013:p0837:b004:l015","ordinal":141030,"en":"Roaring in wrath,"},{"id":"semetey-1-2013:p0837:b004:l016","ordinal":141031,"en":"Attacking right and left,"},{"id":"semetey-1-2013:p0837:b004:l017","ordinal":141032,"en":"Thrusting his spear this way and that,"},{"id":"semetey-1-2013:p0837:b004:l018","ordinal":141033,"en":"Wherever his spear could reach,"},{"id":"semetey-1-2013:p0837:b004:l019","ordinal":141034,"en":"He struck down with the spear;"},{"id":"semetey-1-2013:p0837:b004:l020","ordinal":141035,"en":"Wherever his sword could reach,"},{"id":"semetey-1-2013:p0837:b004:l021","ordinal":141036,"en":"He slashed and felled them."},{"id":"semetey-1-2013:p0837:b004:l022","ordinal":141037,"en":"As he swung this way and that,"},{"id":"semetey-1-2013:p0837:b004:l023","ordinal":141038,"en":"They died five or ten at a time."},{"id":"semetey-1-2013:p0837:b004:l024","ordinal":141039,"en":"When they met him face to face,"},{"id":"semetey-1-2013:p0837:b004:l025","ordinal":141040,"en":"Khans Janaaly and Karach died."},{"id":"semetey-1-2013:p0837:b004:l026","ordinal":141041,"en":"Their khojas in motley robes,"},{"id":"semetey-1-2013:p0837:b004:l027","ordinal":141042,"en":"Their mullahs in white turbans,"},{"id":"semetey-1-2013:p0837:b004:l028","ordinal":141043,"en":"He drove before him."},{"id":"semetey-1-2013:p0837:b004:l029","ordinal":141044,"en":"Of the thousand champions who came,"},{"id":"semetey-1-2013:p0837:b004:l030","ordinal":141045,"en":"Many had died;"},{"id":"semetey-1-2013:p0837:b004:l031","ordinal":141046,"en":"The champions, all together,"},{"id":"semetey-1-2013:p0837:b004:l032","ordinal":141047,"en":"The boy brought to their end."},{"id":"semetey-1-2013:p0837:b004:l033","ordinal":141048,"en":"Among the thousand champions,"},{"id":"semetey-1-2013:p0837:b004:l034","ordinal":141049,"en":"Their cruppers broken,"},{"id":"semetey-1-2013:p0837:b004:l035","ordinal":141050,"en":"Many were in distress;"},{"id":"semetey-1-2013:p0837:b004:l036","ordinal":141051,"en":"Opening their mouths to the sky,"},{"id":"semetey-1-2013:p0837:b004:l037","ordinal":141052,"en":"Many went howling."},{"id":"semetey-1-2013:p0837:b004:l038","ordinal":141053,"en":"Their girths broken,"},{"id":"semetey-1-2013:p0837:b004:l039","ordinal":141054,"en":"Many were in a panic."},{"id":"semetey-1-2013:p0838:b003:l001","ordinal":141055,"en":"“We have fallen into calamity,” they cried;"},{"id":"semetey-1-2013:p0838:b003:l002","ordinal":141056,"en":"Many were fleeing."}]
