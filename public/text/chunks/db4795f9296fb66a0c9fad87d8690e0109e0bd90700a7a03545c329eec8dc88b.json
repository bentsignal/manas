[{"id":"manas-2010:p1067:b001:l041","ordinal":46593,"en":"In all the different Chinese styles,"},{"id":"manas-2010:p1067:b001:l042","ordinal":46594,"en":"They clothed my mother,"},{"id":"manas-2010:p1068:b001:l001","ordinal":46595,"en":"Taking her into the embrace"},{"id":"manas-2010:p1068:b001:l002","ordinal":46596,"en":"Of my dear father, they placed her there."},{"id":"manas-2010:p1068:b001:l003","ordinal":46597,"en":"When they left Great Beijing,"},{"id":"manas-2010:p1068:b001:l004","ordinal":46598,"en":"My father journeyed six months,"},{"id":"manas-2010:p1068:b001:l005","ordinal":46599,"en":"Traveling far by day and night."},{"id":"manas-2010:p1068:b001:l006","ordinal":46600,"en":"To the city of Tash-Köpürö"},{"id":"manas-2010:p1068:b001:l007","ordinal":46601,"en":"He brought my mother."},{"id":"manas-2010:p1068:b001:l008","ordinal":46602,"en":"After he had brought my mother,"},{"id":"manas-2010:p1068:b001:l009","ordinal":46603,"en":"Alöökö's Kongurbay"},{"id":"manas-2010:p1068:b001:l010","ordinal":46604,"en":"Went to the town that supplied tea."},{"id":"manas-2010:p1068:b001:l011","ordinal":46605,"en":"Sarala's mother,"},{"id":"manas-2010:p1068:b001:l012","ordinal":46606,"en":"A bay mare whose udder had swollen,"},{"id":"manas-2010:p1068:b001:l013","ordinal":46607,"en":"He caught in the forest."},{"id":"manas-2010:p1068:b001:l014","ordinal":46608,"en":"He trotted along the foothills,"},{"id":"manas-2010:p1068:b001:l015","ordinal":46609,"en":"He came to Azizkan:"},{"id":"manas-2010:p1068:b001:l016","ordinal":46610,"en":"“She will bear a fine horse,” he said,"},{"id":"manas-2010:p1068:b001:l017","ordinal":46611,"en":"“Take good care of her,” he said,"},{"id":"manas-2010:p1068:b001:l018","ordinal":46612,"en":"And gave her as a gift."},{"id":"manas-2010:p1068:b001:l019","ordinal":46613,"en":"Around the bay mare's neck"},{"id":"manas-2010:p1068:b001:l020","ordinal":46614,"en":"A collar of gold was fastened."},{"id":"manas-2010:p1068:b001:l021","ordinal":46615,"en":"My dear mother and the bay mare,"},{"id":"manas-2010:p1068:b001:l022","ordinal":46616,"en":"Khan Manas, both were tended alike."},{"id":"manas-2010:p1068:b001:l023","ordinal":46617,"en":"Nine months were completed."},{"id":"manas-2010:p1068:b001:l024","ordinal":46618,"en":"My dear mother's time had come;"},{"id":"manas-2010:p1068:b001:l025","ordinal":46619,"en":"The hour of birth had arrived."},{"id":"manas-2010:p1068:b001:l026","ordinal":46620,"en":"When she stood, her back ached,"},{"id":"manas-2010:p1068:b001:l027","ordinal":46621,"en":"Her whole body ached,"},{"id":"manas-2010:p1068:b001:l028","ordinal":46622,"en":"Both her great thighs ached."},{"id":"manas-2010:p1068:b001:l029","ordinal":46623,"en":"Writhing as she lay in labor,"},{"id":"manas-2010:p1068:b001:l030","ordinal":46624,"en":"Unable to bear it, she wailed."},{"id":"manas-2010:p1068:b001:l031","ordinal":46625,"en":"Unable to give birth for six days,"},{"id":"manas-2010:p1068:b001:l032","ordinal":46626,"en":"Her spine and back aching,"},{"id":"manas-2010:p1068:b001:l033","ordinal":46627,"en":"Doubled up by labor pains,"},{"id":"manas-2010:p1068:b001:l034","ordinal":46628,"en":"Unable to give birth for six days,"},{"id":"manas-2010:p1068:b001:l035","ordinal":46629,"en":"Despairing of her fly-like soul:"},{"id":"manas-2010:p1068:b001:l036","ordinal":46630,"en":"“If death has come, I shall die,” she said,"},{"id":"manas-2010:p1068:b001:l037","ordinal":46631,"en":"“If it falls upon me, I shall face it,” she said,"},{"id":"manas-2010:p1068:b001:l038","ordinal":46632,"en":"And ran out into the open country."},{"id":"manas-2010:p1068:b001:l039","ordinal":46633,"en":"I have begun the plain truth of the story."},{"id":"manas-2010:p1068:b001:l040","ordinal":46634,"en":"My Mazhik, who came with me,"},{"id":"manas-2010:p1068:b001:l041","ordinal":46635,"en":"Then herded cattle for a Chinese man."},{"id":"manas-2010:p1068:b001:l042","ordinal":46636,"en":"Let me tell you about Mazhik."},{"id":"manas-2010:p1069:b001:l001","ordinal":46637,"en":"Sixty pious elder merchants"},{"id":"manas-2010:p1069:b001:l002","ordinal":46638,"en":"Had come toward Beijing."},{"id":"manas-2010:p1069:b001:l003","ordinal":46639,"en":"Kalcha saw them from a ridge."},{"id":"manas-2010:p1069:b001:l004","ordinal":46640,"en":"All those merchants"},{"id":"manas-2010:p1069:b001:l005","ordinal":46641,"en":"Died at Kongurbay's hands."},{"id":"manas-2010:p1069:b001:l006","ordinal":46642,"en":"My Mazhik, six years old,"},{"id":"manas-2010:p1069:b001:l007","ordinal":46643,"en":"Was brought there then as a captive."},{"id":"manas-2010:p1069:b001:l008","ordinal":46644,"en":"Alöökö's Kongurbay"},{"id":"manas-2010:p1069:b001:l009","ordinal":46645,"en":"Gave him to my father Azizkan."},{"id":"manas-2010:p1069:b001:l010","ordinal":46646,"en":"My Mazhik, who tended cows,"},{"id":"manas-2010:p1069:b001:l011","ordinal":46647,"en":"Had reached seventeen then."},{"id":"manas-2010:p1069:b001:l012","ordinal":46648,"en":"When that time came,"},{"id":"manas-2010:p1069:b001:l013","ordinal":46649,"en":"My champion Mazhik, my mighty one,"},{"id":"manas-2010:p1069:b001:l014","ordinal":46650,"en":"Had not forgotten the Muslim faith."},{"id":"manas-2010:p1069:b001:l015","ordinal":46651,"en":"My mother cried out shrilly,"},{"id":"manas-2010:p1069:b001:l016","ordinal":46652,"en":"Looking to Mazhik for support,"},{"id":"manas-2010:p1069:b001:l017","ordinal":46653,"en":"Calling, “Come here!”"},{"id":"manas-2010:p1069:b001:l018","ordinal":46654,"en":"“Companion who gathers what we scatter,"},{"id":"manas-2010:p1069:b001:l019","ordinal":46655,"en":"Companion in faith if we die,"},{"id":"manas-2010:p1069:b001:l020","ordinal":46656,"en":"Turn your horse toward me!"},{"id":"manas-2010:p1069:b001:l021","ordinal":46657,"en":"Oh, son, hear my anguished voice,"},{"id":"manas-2010:p1069:b001:l022","ordinal":46658,"en":"Climb up to Kök-Bulung."},{"id":"manas-2010:p1069:b001:l023","ordinal":46659,"en":"Trot there on Kögala,"},{"id":"manas-2010:p1069:b001:l024","ordinal":46660,"en":"From the sacred shrine"},{"id":"manas-2010:p1069:b001:l025","ordinal":46661,"en":"Bring me a staff."},{"id":"manas-2010:p1069:b001:l026","ordinal":46662,"en":"Without stopping, here"},{"id":"manas-2010:p1069:b001:l027","ordinal":46663,"en":"Give it to me quickly.”"},{"id":"manas-2010:p1069:b001:l028","ordinal":46664,"en":"When he heard these words,"},{"id":"manas-2010:p1069:b001:l029","ordinal":46665,"en":"Mazhik truly sped away."},{"id":"manas-2010:p1069:b001:l030","ordinal":46666,"en":"From Kök-Bulung's forest,"},{"id":"manas-2010:p1069:b001:l031","ordinal":46667,"en":"In the blink of an eye,"},{"id":"manas-2010:p1069:b001:l032","ordinal":46668,"en":"From the sacred shrine,"},{"id":"manas-2010:p1069:b001:l033","ordinal":46669,"en":"Into my dear mother's hand"},{"id":"manas-2010:p1069:b001:l034","ordinal":46670,"en":"He brought and gave a staff."},{"id":"manas-2010:p1069:b001:l035","ordinal":46671,"en":"She took the staff in her hand,"},{"id":"manas-2010:p1069:b001:l036","ordinal":46672,"en":"She raised her voice and cried out."},{"id":"manas-2010:p1069:b001:l037","ordinal":46673,"en":"Things began to go well for her."},{"id":"manas-2010:p1069:b001:l038","ordinal":46674,"en":"Hidden in the night,"},{"id":"manas-2010:p1069:b001:l039","ordinal":46675,"en":"Without letting anyone know,"},{"id":"manas-2010:p1069:b001:l040","ordinal":46676,"en":"She gave birth to wretched me."},{"id":"manas-2010:p1069:b001:l041","ordinal":46677,"en":"When God made me Almam,"},{"id":"manas-2010:p1069:b001:l042","ordinal":46678,"en":"When my poor mother gave birth,"},{"id":"manas-2010:p1070:b001:l001","ordinal":46679,"en":"The tips of my ears were pierced."},{"id":"manas-2010:p1070:b001:l002","ordinal":46680,"en":"I came out of the womb"},{"id":"manas-2010:p1070:b001:l003","ordinal":46681,"en":"Already cut in circumcision."},{"id":"manas-2010:p1070:b001:l004","ordinal":46682,"en":"A black snake parted away."},{"id":"manas-2010:p1070:b001:l005","ordinal":46683,"en":"When they lifted me from the ground,"},{"id":"manas-2010:p1070:b001:l006","ordinal":46684,"en":"From both my hands"},{"id":"manas-2010:p1070:b001:l007","ordinal":46685,"en":"Dark blood went pouring."},{"id":"manas-2010:p1070:b001:l008","ordinal":46686,"en":"When I came out of the womb,"},{"id":"manas-2010:p1070:b001:l009","ordinal":46687,"en":"My forehead touched the ground."},{"id":"manas-2010:p1070:b001:l010","ordinal":46688,"en":"In Kakan-Chin's Beijing"},{"id":"manas-2010:p1070:b001:l011","ordinal":46689,"en":"Rain fell for seventy days,"},{"id":"manas-2010:p1070:b001:l012","ordinal":46690,"en":"The earth began to quake."},{"id":"manas-2010:p1070:b001:l013","ordinal":46691,"en":"“Which is the mighty child,” they said,"},{"id":"manas-2010:p1070:b001:l014","ordinal":46692,"en":"“Upon the world a turmoil—"},{"id":"manas-2010:p1070:b001:l015","ordinal":46693,"en":"Which child has brought it?” they said."},{"id":"manas-2010:p1070:b001:l016","ordinal":46694,"en":"Into Kakan-Chin's Beijing"},{"id":"manas-2010:p1070:b001:l017","ordinal":46695,"en":"Commotion had descended."},{"id":"manas-2010:p1070:b001:l018","ordinal":46696,"en":"From Beijing they sought the child;"},{"id":"manas-2010:p1070:b001:l019","ordinal":46697,"en":"Calamity had descended."},{"id":"manas-2010:p1070:b001:l020","ordinal":46698,"en":"“The black-hearted Chinese,"},{"id":"manas-2010:p1070:b001:l021","ordinal":46699,"en":"If they see my child,"},{"id":"manas-2010:p1070:b001:l022","ordinal":46700,"en":"Will bring some calamity,” she said."},{"id":"manas-2010:p1070:b001:l023","ordinal":46701,"en":"Having an amulet hung on my neck,"},{"id":"manas-2010:p1070:b001:l024","ordinal":46702,"en":"Without letting a single person know,"},{"id":"manas-2010:p1070:b001:l025","ordinal":46703,"en":"She had my grandfather Soorondük rear me."},{"id":"manas-2010:p1070:b001:l026","ordinal":46704,"en":"My grandfather had tended me"},{"id":"manas-2010:p1070:b001:l027","ordinal":46705,"en":"For just three full months,"},{"id":"manas-2010:p1070:b001:l028","ordinal":46706,"en":"When my mother Altynay"},{"id":"manas-2010:p1070:b001:l029","ordinal":46707,"en":"Sent word to Beijing."},{"id":"manas-2010:p1070:b001:l030","ordinal":46708,"en":"Giving gold by the pood,"},{"id":"manas-2010:p1070:b001:l031","ordinal":46709,"en":"She took me from my grandfather."},{"id":"manas-2010:p1070:b001:l032","ordinal":46710,"en":"See my mother's resourcefulness,"},{"id":"manas-2010:p1070:b001:l033","ordinal":46711,"en":"The keenness of her mind:"},{"id":"manas-2010:p1070:b001:l034","ordinal":46712,"en":"“I have borne a son,” she said."},{"id":"manas-2010:p1070:b001:l035","ordinal":46713,"en":"When nine months were completed,"},{"id":"manas-2010:p1070:b001:l036","ordinal":46714,"en":"Before Azizkan"},{"id":"manas-2010:p1070:b001:l037","ordinal":46715,"en":"She brought me at last."},{"id":"manas-2010:p1070:b001:l038","ordinal":46716,"en":"Thinking warily, Azizkan"},{"id":"manas-2010:p1070:b001:l039","ordinal":46717,"en":"Against my noble mother"},{"id":"manas-2010:p1070:b001:l040","ordinal":46718,"en":"Harbored a foul suspicion:"},{"id":"manas-2010:p1070:b001:l041","ordinal":46719,"en":"“If she is a beauty among women,"},{"id":"manas-2010:p1070:b001:l042","ordinal":46720,"en":"If she is a grown young girl,"},{"id":"manas-2010:p1071:b001:l001","ordinal":46721,"en":"One who roams much in the dark,"},{"id":"manas-2010:p1071:b001:l002","ordinal":46722,"en":"She has borne a governor's child,” he said."},{"id":"manas-2010:p1071:b001:l003","ordinal":46723,"en":"“In a blue robe worn flowing,"},{"id":"manas-2010:p1071:b001:l004","ordinal":46724,"en":"She has borne a monk's child,” he said."},{"id":"manas-2010:p1071:b001:l005","ordinal":46725,"en":"“If he truly is my son,"},{"id":"manas-2010:p1071:b001:l006","ordinal":46726,"en":"To all the Chinese in the world"},{"id":"manas-2010:p1071:b001:l007","ordinal":46727,"en":"Let me send certain news,"},{"id":"manas-2010:p1071:b001:l008","ordinal":46728,"en":"Let me gather the people."},{"id":"manas-2010:p1071:b001:l009","ordinal":46729,"en":"If he truly is my own son,"},{"id":"manas-2010:p1071:b001:l010","ordinal":46730,"en":"Let me rear him especially well."},{"id":"manas-2010:p1071:b001:l011","ordinal":46731,"en":"If he is bastard piss,"},{"id":"manas-2010:p1071:b001:l012","ordinal":46732,"en":"Let me cut off his head.”"},{"id":"manas-2010:p1071:b001:l013","ordinal":46733,"en":"Then he shouted for his diviners,"},{"id":"manas-2010:p1071:b001:l014","ordinal":46734,"en":"He summoned his record-keeper."},{"id":"manas-2010:p1071:b001:l015","ordinal":46735,"en":"Counting out the days,"},{"id":"manas-2010:p1071:b001:l016","ordinal":46736,"en":"Counting out the months,"},{"id":"manas-2010:p1071:b001:l017","ordinal":46737,"en":"Since he had taken this wife:"},{"id":"manas-2010:p1071:b001:l018","ordinal":46738,"en":"“Nine months are completed,” he said."},{"id":"manas-2010:p1071:b001:l019","ordinal":46739,"en":"“The child she bore today"},{"id":"manas-2010:p1071:b001:l020","ordinal":46740,"en":"Truly came from me,” he said."},{"id":"manas-2010:p1071:b001:l021","ordinal":46741,"en":"“Before this, I myself"},{"id":"manas-2010:p1071:b001:l022","ordinal":46742,"en":"Took sixty wives,” he said."},{"id":"manas-2010:p1071:b001:l023","ordinal":46743,"en":"“I remained without a child,” he said."},{"id":"manas-2010:p1071:b001:l024","ordinal":46744,"en":"“A spring flowing through the valley,” he said."},{"id":"manas-2010:p1071:b001:l025","ordinal":46745,"en":"Azizkan thought and pondered."},{"id":"manas-2010:p1071:b001:l026","ordinal":46746,"en":"Then Beijing gathered."},{"id":"manas-2010:p1071:b001:l027","ordinal":46747,"en":"Having gold and silver scattered,"},{"id":"manas-2010:p1071:b001:l028","ordinal":46748,"en":"Having the treasury opened,"},{"id":"manas-2010:p1071:b001:l029","ordinal":46749,"en":"In Kakan-Chin's Beijing"},{"id":"manas-2010:p1071:b001:l030","ordinal":46750,"en":"The teeming Chinese held a feast."},{"id":"manas-2010:p1071:b001:l031","ordinal":46751,"en":"Holding a feast for the whole world,"},{"id":"manas-2010:p1071:b001:l032","ordinal":46752,"en":"Many Chinese ate their fill."},{"id":"manas-2010:p1071:b001:l033","ordinal":46753,"en":"Among the people of Deep Beijing"},{"id":"manas-2010:p1071:b001:l034","ordinal":46754,"en":"Many goods were scattered."},{"id":"manas-2010:p1071:b001:l035","ordinal":46755,"en":"The dust upon the earth settled,"},{"id":"manas-2010:p1071:b001:l036","ordinal":46756,"en":"The sky cleared overhead."},{"id":"manas-2010:p1071:b001:l037","ordinal":46757,"en":"When they held the feast for me,"},{"id":"manas-2010:p1071:b001:l038","ordinal":46758,"en":"The face of the earth was hollowed out."},{"id":"manas-2010:p1071:b001:l039","ordinal":46759,"en":"They held a feast of seventy years;"},{"id":"manas-2010:p1071:b001:l040","ordinal":46760,"en":"Chinese who had lacked were filled."},{"id":"manas-2010:p1071:b001:l041","ordinal":46761,"en":"My waist bent supple as silk."},{"id":"manas-2010:p1071:b001:l042","ordinal":46762,"en":"“Azizkan has had a child,” they said,"},{"id":"manas-2010:p1072:b001:l001","ordinal":46763,"en":"The khan of all Beijing rejoiced."},{"id":"manas-2010:p1072:b001:l002","ordinal":46764,"en":"My father Azizkan:"},{"id":"manas-2010:p1072:b001:l003","ordinal":46765,"en":"“A spring flowing through the valley,” he said,"},{"id":"manas-2010:p1072:b001:l004","ordinal":46766,"en":"“When I have reached seventy,"},{"id":"manas-2010:p1072:b001:l005","ordinal":46767,"en":"A little one gained at death's door,” he said."},{"id":"manas-2010:p1072:b001:l006","ordinal":46768,"en":"My father Azizkan"},{"id":"manas-2010:p1072:b001:l007","ordinal":46769,"en":"Put me together with my mother"},{"id":"manas-2010:p1072:b001:l008","ordinal":46770,"en":"Into his two-wheeled carriage."},{"id":"manas-2010:p1072:b001:l009","ordinal":46771,"en":"“I shall have him named,” he said."},{"id":"manas-2010:p1072:b001:l010","ordinal":46772,"en":"To Karykan in Beijing,"},{"id":"manas-2010:p1072:b001:l011","ordinal":46773,"en":"My father took me there."},{"id":"manas-2010:p1072:b001:l012","ordinal":46774,"en":"In Kakan-Chin's Beijing"},{"id":"manas-2010:p1072:b001:l013","ordinal":46775,"en":"The people of forty khans gathered,"},{"id":"manas-2010:p1072:b001:l014","ordinal":46776,"en":"For forty days they held a mighty feast."},{"id":"manas-2010:p1072:b001:l015","ordinal":46777,"en":"When he placed me in his lap:"},{"id":"manas-2010:p1072:b001:l016","ordinal":46778,"en":"“Give him a name!” he said,"},{"id":"manas-2010:p1072:b001:l017","ordinal":46779,"en":"Before Karykan."},{"id":"manas-2010:p1072:b001:l018","ordinal":46780,"en":"My father Azizkan,"},{"id":"manas-2010:p1072:b001:l019","ordinal":46781,"en":"Holding me up, stood watching."},{"id":"manas-2010:p1072:b001:l020","ordinal":46782,"en":"Beijing's khan Karykan"},{"id":"manas-2010:p1072:b001:l021","ordinal":46783,"en":"Took me into his hands."},{"id":"manas-2010:p1072:b001:l022","ordinal":46784,"en":"“This child will come to no good,” he said,"},{"id":"manas-2010:p1072:b001:l023","ordinal":46785,"en":"And harbored an evil thought."},{"id":"manas-2010:p1072:b001:l024","ordinal":46786,"en":"Straight into the black well"},{"id":"manas-2010:p1072:b001:l025","ordinal":46787,"en":"He took and cast me."},{"id":"manas-2010:p1072:b001:l026","ordinal":46788,"en":"That remarkable black well"},{"id":"manas-2010:p1072:b001:l027","ordinal":46789,"en":"Of the teeming Chinese people,"},{"id":"manas-2010:p1072:b001:l028","ordinal":46790,"en":"Let me tell the assembly"},{"id":"manas-2010:p1072:b001:l029","ordinal":46791,"en":"The marvel of their well."},{"id":"manas-2010:p1072:b001:l030","ordinal":46792,"en":"When they cast a soul into the well,"},{"id":"manas-2010:p1072:b001:l031","ordinal":46793,"en":"To Kakan-Chin’s Beijing,"},{"id":"manas-2010:p1072:b001:l032","ordinal":46794,"en":"One who would submit it would spare."},{"id":"manas-2010:p1072:b001:l033","ordinal":46795,"en":"When they cast in one who would not submit,"},{"id":"manas-2010:p1072:b001:l034","ordinal":46796,"en":"It would burn him utterly."},{"id":"manas-2010:p1072:b001:l035","ordinal":46797,"en":"Without letting them reach their prime,"},{"id":"manas-2010:p1072:b001:l036","ordinal":46798,"en":"While they were still children,"},{"id":"manas-2010:p1072:b001:l037","ordinal":46799,"en":"The well would swallow many."},{"id":"manas-2010:p1072:b001:l038","ordinal":46800,"en":"When they cast me into the well,"},{"id":"manas-2010:p1072:b001:l039","ordinal":46801,"en":"An angel shed its light."},{"id":"manas-2010:p1072:b001:l040","ordinal":46802,"en":"Before I reached the well,"},{"id":"manas-2010:p1072:b001:l041","ordinal":46803,"en":"Closing the mouth of the well,"},{"id":"manas-2010:p1072:b001:l042","ordinal":46804,"en":"A black cloud like roof-felt covered it."},{"id":"manas-2010:p1073:b001:l001","ordinal":46805,"en":"When I survived and did not die,"},{"id":"manas-2010:p1073:b001:l002","ordinal":46806,"en":"“He is one of our people,” they said,"},{"id":"manas-2010:p1073:b001:l003","ordinal":46807,"en":"Sending word to the kakan,"},{"id":"manas-2010:p1073:b001:l004","ordinal":46808,"en":"And they pulled me back out."},{"id":"manas-2010:p1073:b001:l005","ordinal":46809,"en":"Then Karykan stood there,"},{"id":"manas-2010:p1073:b001:l006","ordinal":46810,"en":"Taking a liking to wretched me,"},{"id":"manas-2010:p1073:b001:l007","ordinal":46811,"en":"Thinking of dying,"},{"id":"manas-2010:p1073:b001:l008","ordinal":46812,"en":"Spending his wealth,"},{"id":"manas-2010:p1073:b001:l009","ordinal":46813,"en":"For the Chinese people of Beijing"},{"id":"manas-2010:p1073:b001:l010","ordinal":46814,"en":"He held a feast for seventy days."},{"id":"manas-2010:p1073:b001:l011","ordinal":46815,"en":"The teeming people pondered long,"},{"id":"manas-2010:p1073:b001:l012","ordinal":46816,"en":"Unable to name me “Oybo,”"},{"id":"manas-2010:p1073:b001:l013","ordinal":46817,"en":"Or to give me the name “Shoybo.”"},{"id":"manas-2010:p1073:b001:l014","ordinal":46818,"en":"The Black Chinese, the teeming people,"},{"id":"manas-2010:p1073:b001:l015","ordinal":46819,"en":"Were put to trouble."},{"id":"manas-2010:p1073:b001:l016","ordinal":46820,"en":"At that time, running,"},{"id":"manas-2010:p1073:b001:l017","ordinal":46821,"en":"There came among the many people"},{"id":"manas-2010:p1073:b001:l018","ordinal":46822,"en":"A white-bearded wandering holy man."},{"id":"manas-2010:p1073:b001:l019","ordinal":46823,"en":"“Give me the child a moment,” he said,"},{"id":"manas-2010:p1073:b001:l020","ordinal":46824,"en":"And from my dear mother's hands"},{"id":"manas-2010:p1073:b001:l021","ordinal":46825,"en":"He took me into his own."},{"id":"manas-2010:p1073:b001:l022","ordinal":46826,"en":"He stroked my forehead,"},{"id":"manas-2010:p1073:b001:l023","ordinal":46827,"en":"He gave me the name “Almambet.”"},{"id":"manas-2010:p1073:b001:l024","ordinal":46828,"en":"When they heard my name “Almambet,”"},{"id":"manas-2010:p1073:b001:l025","ordinal":46829,"en":"From the mass of Chinese"},{"id":"manas-2010:p1073:b001:l026","ordinal":46830,"en":"Swift runners swarmed in crowds."},{"id":"manas-2010:p1073:b001:l027","ordinal":46831,"en":"“What ominous creature is this?” they said."},{"id":"manas-2010:p1073:b001:l028","ordinal":46832,"en":"Then they seized him,"},{"id":"manas-2010:p1073:b001:l029","ordinal":46833,"en":"And as they were about to slaughter the holy man,"},{"id":"manas-2010:p1073:b001:l030","ordinal":46834,"en":"The white-bearded wandering holy man"},{"id":"manas-2010:p1073:b001:l031","ordinal":46835,"en":"Vanished from sight."},{"id":"manas-2010:p1073:b001:l032","ordinal":46836,"en":"Your Alake, blessed by the lion-like elder,"},{"id":"manas-2010:p1073:b001:l033","ordinal":46837,"en":"Was given the name “Almambet.”"},{"id":"manas-2010:p1073:b001:l034","ordinal":46838,"en":"Turning back toward his people,"},{"id":"manas-2010:p1073:b001:l035","ordinal":46839,"en":"My father returned to his land."},{"id":"manas-2010:p1073:b001:l036","ordinal":46840,"en":"“How many cares have scattered,” he said,"},{"id":"manas-2010:p1073:b001:l037","ordinal":46841,"en":"“My child gained at death's door,” he said."},{"id":"manas-2010:p1073:b001:l038","ordinal":46842,"en":"Cherishing me, around my neck"},{"id":"manas-2010:p1073:b001:l039","ordinal":46843,"en":"He hung a golden idol."},{"id":"manas-2010:p1073:b001:l040","ordinal":46844,"en":"My sixty stepmothers"},{"id":"manas-2010:p1073:b001:l041","ordinal":46845,"en":"Lulled and tended me."},{"id":"manas-2010:p1073:b001:l042","ordinal":46846,"en":"At that time the bay mare"},{"id":"manas-2010:p1074:b001:l001","ordinal":46847,"en":"Gave birth to Sarala."},{"id":"manas-2010:p1074:b001:l002","ordinal":46848,"en":"Racing when he was a two-year-old,"}]
