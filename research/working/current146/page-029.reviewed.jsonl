{"id": "sayakbay-ms-current146:pdf029:l005", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 29, "folio": 412, "line_in_page": 5, "raw": "Көркөмүн көрсөң ушундай,", "text": "Көркөмүн көрсөң ушундай,", "en": "Such was the splendor of his appearance,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf029:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 29, "folio": 412, "line_in_page": 6, "raw": "Кехардан топчу муштумдай,", "text": "Кехардан топчу муштумдай,", "en": "With a fist-sized button of precious stone,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The manuscript hand and published counterpart support Кехардан; the rare material term is rendered contextually.", "bbox": null}
