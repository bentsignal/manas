{"id": "sayakbay-ms-current146:pdf023:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 23, "folio": 406, "line_in_page": 19, "raw": "Көк камалын өзүнөн,", "text": "Көк камалын өзүнөн,", "en": "From his blue fortress itself,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "камалын is a provisional reading of a faint central word.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf023:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 23, "folio": 406, "line_in_page": 20, "raw": "Кайтарбай жайкап салтырды,", "text": "Кайтарбай жайкап салтырды,", "en": "Without turning back, he had them swept away,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The middle verb appears to be жайкап; the causative ending is faint.", "bbox": null}
