[{"id":"semetey-1-2013:p0724:b003:l022","ordinal":132353,"en":"Sweeping them toward Beijing."},{"id":"semetey-1-2013:p0724:b003:l023","ordinal":132354,"en":"Their warrior's head was cut off;"},{"id":"semetey-1-2013:p0724:b003:l024","ordinal":132355,"en":"The Chinese met with torment."},{"id":"semetey-1-2013:p0724:b003:l025","ordinal":132356,"en":"When their mighty Döngö died,"},{"id":"semetey-1-2013:p0724:b003:l026","ordinal":132357,"en":"When the Chinese knew grief,"},{"id":"semetey-1-2013:p0724:b003:l027","ordinal":132358,"en":"We pursued and drove them on."},{"id":"semetey-1-2013:p0724:b003:l028","ordinal":132359,"en":"From beyond Jyldyz,"},{"id":"semetey-1-2013:p0724:b003:l029","ordinal":132360,"en":"From the edge of Ak-Talaa,"},{"id":"semetey-1-2013:p0724:b003:l030","ordinal":132361,"en":"From the ridge of Kyran-Kyr,"},{"id":"semetey-1-2013:p0724:b003:l031","ordinal":132362,"en":"From Ylama's hands,"},{"id":"semetey-1-2013:p0724:b003:l032","ordinal":132363,"en":"From the seething infidels'"},{"id":"semetey-1-2013:p0724:b003:l033","ordinal":132364,"en":"Net of iron ropes—"},{"id":"semetey-1-2013:p0724:b003:l034","ordinal":132365,"en":"When Surkyzyl was shot down,"},{"id":"semetey-1-2013:p0724:b003:l035","ordinal":132366,"en":"Manas's younger sister Kardygach"},{"id":"semetey-1-2013:p0724:b003:l036","ordinal":132367,"en":"Had been taken captive."},{"id":"semetey-1-2013:p0724:b003:l037","ordinal":132368,"en":"With a net of iron ropes,"},{"id":"semetey-1-2013:p0724:b003:l038","ordinal":132369,"en":"She had been caught in a net."},{"id":"semetey-1-2013:p0724:b003:l039","ordinal":132370,"en":"Upon the seething Chinese"},{"id":"semetey-1-2013:p0724:b004:l001","ordinal":132371,"en":"We had brought havoc."},{"id":"semetey-1-2013:p0724:b004:l002","ordinal":132372,"en":"From the great infidel Ylama,"},{"id":"semetey-1-2013:p0724:b004:l003","ordinal":132373,"en":"Thus we wrested Kardygach away."},{"id":"semetey-1-2013:p0724:b004:l005","ordinal":132374,"en":"Not yielding to the Chinese,"},{"id":"semetey-1-2013:p0724:b004:l006","ordinal":132375,"en":"Such were the deeds we wrought."},{"id":"semetey-1-2013:p0724:b004:l007","ordinal":132376,"en":"When we came and settled in Talas,"},{"id":"semetey-1-2013:p0724:b004:l008","ordinal":132377,"en":"Precious child Kardygach"},{"id":"semetey-1-2013:p0724:b004:l009","ordinal":132378,"en":"Became the object of slander."},{"id":"semetey-1-2013:p0724:b004:l010","ordinal":132379,"en":"Warrior Manas stood and said:"},{"id":"semetey-1-2013:p0724:b004:l011","ordinal":132380,"en":"‘The people's mouths have no sieve."},{"id":"semetey-1-2013:p0724:b004:l012","ordinal":132381,"en":"She will hear it from thoughtless people,"},{"id":"semetey-1-2013:p0724:b004:l013","ordinal":132382,"en":"And that day her soul will depart."},{"id":"semetey-1-2013:p0724:b004:l014","ordinal":132383,"en":"If she hears the people's gossip,"},{"id":"semetey-1-2013:p0724:b004:l015","ordinal":132384,"en":"That very day she will die."},{"id":"semetey-1-2013:p0724:b004:l016","ordinal":132385,"en":"My younger sister, still young,"},{"id":"semetey-1-2013:p0724:b004:l017","ordinal":132386,"en":"Will see the face of the next world.’"},{"id":"semetey-1-2013:p0724:b004:l018","ordinal":132387,"en":"That she would be slandered,"},{"id":"semetey-1-2013:p0724:b004:l019","ordinal":132388,"en":"Blessed Manas foresaw."},{"id":"semetey-1-2013:p0724:b004:l020","ordinal":132389,"en":"Jelpinish at the ends of the earth,"},{"id":"semetey-1-2013:p0724:b004:l021","ordinal":132390,"en":"To the one who dwelt in Jelpinish,"},{"id":"semetey-1-2013:p0724:b004:l022","ordinal":132391,"en":"The ruler of that wicked people,"},{"id":"semetey-1-2013:p0724:b004:l023","ordinal":132392,"en":"Their giant called Jarmanas,"},{"id":"semetey-1-2013:p0724:b004:l024","ordinal":132393,"en":"We gave her to Jarmanas."},{"id":"semetey-1-2013:p0724:b004:l025","ordinal":132394,"en":"Since we gave her to Jarmanas,"},{"id":"semetey-1-2013:p0724:b004:l026","ordinal":132395,"en":"No one had traveled there;"},{"id":"semetey-1-2013:p0724:b004:l027","ordinal":132396,"en":"No one had received news of her."},{"id":"semetey-1-2013:p0724:b004:l028","ordinal":132397,"en":"If we piece the tradition together,"},{"id":"semetey-1-2013:p0724:b004:l029","ordinal":132398,"en":"There is no one who knows."},{"id":"semetey-1-2013:p0724:b004:l030","ordinal":132399,"en":"That rider on the dark-brown horse"},{"id":"semetey-1-2013:p0724:b004:l031","ordinal":132400,"en":"Is Kardygach herself."},{"id":"semetey-1-2013:p0724:b004:l032","ordinal":132401,"en":"Her elder brother, Khan Manas,"},{"id":"semetey-1-2013:p0724:b004:l033","ordinal":132402,"en":"She has come to see.’"},{"id":"semetey-1-2013:p0724:b004:l034","ordinal":132403,"en":"So spoke Khan Bakai."},{"id":"semetey-1-2013:p0724:b004:l035","ordinal":132404,"en":"Before he could close his mouth,"},{"id":"semetey-1-2013:p0724:b004:l036","ordinal":132405,"en":"The younger sister Kardygach,"},{"id":"semetey-1-2013:p0724:b004:l037","ordinal":132406,"en":"Her heart sorely troubled,"},{"id":"semetey-1-2013:p0724:b004:l038","ordinal":132407,"en":"Tears streaming from her eyes,"},{"id":"semetey-1-2013:p0724:b004:l039","ordinal":132408,"en":"Her thoughts torn by anguish,"},{"id":"semetey-1-2013:p0725:b003:l001","ordinal":132409,"en":"Tears in stream upon stream"},{"id":"semetey-1-2013:p0725:b003:l002","ordinal":132410,"en":"Poured down her precious face."},{"id":"semetey-1-2013:p0725:b003:l003","ordinal":132411,"en":"What could unfortunate Kardygach do?"},{"id":"semetey-1-2013:p0725:b003:l004","ordinal":132412,"en":"When she looked upon Bakai's face,"},{"id":"semetey-1-2013:p0725:b003:l005","ordinal":132413,"en":"A goatskin coat was on his body,"},{"id":"semetey-1-2013:p0725:b003:l006","ordinal":132414,"en":"Hide trousers upon his rear."},{"id":"semetey-1-2013:p0725:b003:l007","ordinal":132415,"en":"His beard had whitened;"},{"id":"semetey-1-2013:p0725:b003:l008","ordinal":132416,"en":"His journey was drawing near."},{"id":"semetey-1-2013:p0725:b003:l009","ordinal":132417,"en":"The flower that bloomed above his head"},{"id":"semetey-1-2013:p0725:b003:l010","ordinal":132418,"en":"Had long since faded away."},{"id":"semetey-1-2013:p0725:b003:l011","ordinal":132419,"en":"Upon Khan Bakai's head"},{"id":"semetey-1-2013:p0725:b003:l012","ordinal":132420,"en":"The semblance of death had come."},{"id":"semetey-1-2013:p0725:b003:l013","ordinal":132421,"en":"Fierce old Bakai—"},{"id":"semetey-1-2013:p0725:b003:l014","ordinal":132422,"en":"His eyes were filled with pus,"},{"id":"semetey-1-2013:p0725:b003:l015","ordinal":132423,"en":"His chest had begun to rattle,"},{"id":"semetey-1-2013:p0725:b003:l016","ordinal":132424,"en":"His joints had grown loose,"},{"id":"semetey-1-2013:p0725:b003:l017","ordinal":132425,"en":"His eyes gleamed from deep within,"},{"id":"semetey-1-2013:p0725:b003:l018","ordinal":132426,"en":"His beard was white as a swan."},{"id":"semetey-1-2013:p0725:b003:l019","ordinal":132427,"en":"His time to perish had come—"},{"id":"semetey-1-2013:p0725:b003:l020","ordinal":132428,"en":"Such had Khan Bakai become."},{"id":"semetey-1-2013:p0725:b003:l021","ordinal":132429,"en":"As Kardygach gazed,"},{"id":"semetey-1-2013:p0725:b003:l022","ordinal":132430,"en":"Upon warrior Bakai's head"},{"id":"semetey-1-2013:p0725:b003:l023","ordinal":132431,"en":"Death's wrath had descended."},{"id":"semetey-1-2013:p0725:b003:l024","ordinal":132432,"en":"The signs of life"},{"id":"semetey-1-2013:p0725:b003:l025","ordinal":132433,"en":"Had long since passed away."},{"id":"semetey-1-2013:p0725:b003:l026","ordinal":132434,"en":"Seeing Bakai, she wept bitterly,"},{"id":"semetey-1-2013:p0725:b003:l027","ordinal":132435,"en":"Screaming in anguish:"},{"id":"semetey-1-2013:p0725:b003:l028","ordinal":132436,"en":"‘Ah, leopard Bakai, my khan elder!"},{"id":"semetey-1-2013:p0725:b003:l029","ordinal":132437,"en":"The marten cap upon his head—"},{"id":"semetey-1-2013:p0725:b003:l030","ordinal":132438,"en":"Who has not worn it, tossing his head?"},{"id":"semetey-1-2013:p0725:b003:l031","ordinal":132439,"en":"While fortune rested upon him,"},{"id":"semetey-1-2013:p0725:b003:l032","ordinal":132440,"en":"Who has not stridden about roaring?"},{"id":"semetey-1-2013:p0725:b003:l033","ordinal":132441,"en":"When men saw Khan Bakai,"},{"id":"semetey-1-2013:p0725:b003:l034","ordinal":132442,"en":"They trembled, unable to face him."},{"id":"semetey-1-2013:p0725:b003:l035","ordinal":132443,"en":"Valiant Khan Bakai, my elder,"},{"id":"semetey-1-2013:p0725:b003:l036","ordinal":132444,"en":"Have you come to this?!"},{"id":"semetey-1-2013:p0725:b003:l037","ordinal":132445,"en":"Wandering far away,"},{"id":"semetey-1-2013:p0725:b003:l038","ordinal":132446,"en":"Have I come to this?!"},{"id":"semetey-1-2013:p0725:b003:l039","ordinal":132447,"en":"Elder Bakai, the leopard,"},{"id":"semetey-1-2013:p0725:b004:l001","ordinal":132448,"en":"My beloved saint,"},{"id":"semetey-1-2013:p0725:b004:l002","ordinal":132449,"en":"Known to all the people,"},{"id":"semetey-1-2013:p0725:b004:l003","ordinal":132450,"en":"The just judge of this world,"},{"id":"semetey-1-2013:p0725:b004:l004","ordinal":132451,"en":"Whom mountain floods could not wear away,"},{"id":"semetey-1-2013:p0725:b004:l005","ordinal":132452,"en":"Of my mountain-like elder brother Manas,"},{"id":"semetey-1-2013:p0725:b004:l006","ordinal":132453,"en":"The mountain-like golden pillar!"},{"id":"semetey-1-2013:p0725:b004:l007","ordinal":132454,"en":"Helplessly driven to wander,"},{"id":"semetey-1-2013:p0725:b004:l008","ordinal":132455,"en":"I was the one who went far away."},{"id":"semetey-1-2013:p0725:b004:l009","ordinal":132456,"en":"When a storm came, no wind could reach through—"},{"id":"semetey-1-2013:p0725:b004:l010","ordinal":132457,"en":"You were a dense forest thicket."},{"id":"semetey-1-2013:p0725:b004:l011","ordinal":132458,"en":"Bewildered, hearing no news,"},{"id":"semetey-1-2013:p0725:b004:l012","ordinal":132459,"en":"I was the wretch bowed with grief."},{"id":"semetey-1-2013:p0725:b004:l013","ordinal":132460,"en":"I have returned to Talas."},{"id":"semetey-1-2013:p0725:b004:l014","ordinal":132461,"en":"Are your Kyrgyz people well?"},{"id":"semetey-1-2013:p0725:b004:l015","ordinal":132462,"en":"Tell me the news, elder."},{"id":"semetey-1-2013:p0725:b004:l016","ordinal":132463,"en":"Is your lion Manas safe?"},{"id":"semetey-1-2013:p0725:b004:l017","ordinal":132464,"en":"When the eyes behold, the belly seethes."},{"id":"semetey-1-2013:p0725:b004:l018","ordinal":132465,"en":"Your lands, Keng-Özön and Keng-Kol—"},{"id":"semetey-1-2013:p0725:b004:l019","ordinal":132466,"en":"I ask, are they safe and well,"},{"id":"semetey-1-2013:p0725:b004:l020","ordinal":132467,"en":"Your widespread Argin people?"},{"id":"semetey-1-2013:p0725:b004:l021","ordinal":132468,"en":"Do not distress me, elder; tell me quickly."},{"id":"semetey-1-2013:p0725:b004:l022","ordinal":132469,"en":"Is he safe and well,"},{"id":"semetey-1-2013:p0725:b004:l023","ordinal":132470,"en":"Your lion Manas of old?"},{"id":"semetey-1-2013:p0725:b004:l024","ordinal":132471,"en":"Our tethering line stretched in Keng-Kol—"},{"id":"semetey-1-2013:p0725:b004:l025","ordinal":132472,"en":"Is she alive, not gone to the next world,"},{"id":"semetey-1-2013:p0725:b004:l026","ordinal":132473,"en":"Our aged mother Chiyyrdy?"},{"id":"semetey-1-2013:p0725:b004:l027","ordinal":132474,"en":"She was the skilled one among women,"},{"id":"semetey-1-2013:p0725:b004:l028","ordinal":132475,"en":"The daughter of Temir Khan."},{"id":"semetey-1-2013:p0725:b004:l029","ordinal":132476,"en":"Joined together when thumb-sized,"},{"id":"semetey-1-2013:p0725:b004:l030","ordinal":132477,"en":"United when tiny as lice."},{"id":"semetey-1-2013:p0725:b004:l031","ordinal":132478,"en":"My sister-in-law Kanykei, who knew my secrets—"},{"id":"semetey-1-2013:p0725:b004:l032","ordinal":132479,"en":"Is my mighty one safe and well?’"},{"id":"semetey-1-2013:p0725:b004:l033","ordinal":132480,"en":"So Kardygach spoke,"},{"id":"semetey-1-2013:p0725:b004:l034","ordinal":132481,"en":"Asking after the people."},{"id":"semetey-1-2013:p0725:b004:l035","ordinal":132482,"en":"Honored Manas, the bloodthirsty lion,"},{"id":"semetey-1-2013:p0725:b004:l036","ordinal":132483,"en":"And all forty companions,"},{"id":"semetey-1-2013:p0725:b004:l037","ordinal":132484,"en":"She asked about them equally."},{"id":"semetey-1-2013:p0725:b004:l038","ordinal":132485,"en":"‘Elder Bakai, hear my words!"},{"id":"semetey-1-2013:p0725:b004:l039","ordinal":132486,"en":"The mighty one among the forty companions,"},{"id":"semetey-1-2013:p0726:b003:l001","ordinal":132487,"en":"The foremost among sixty,"},{"id":"semetey-1-2013:p0726:b003:l002","ordinal":132488,"en":"He stained his golden throne,"},{"id":"semetey-1-2013:p0726:b003:l003","ordinal":132489,"en":"Saying, “I have become a true Muslim,”"},{"id":"semetey-1-2013:p0726:b003:l004","ordinal":132490,"en":"He killed his father, Khan Azoozil."},{"id":"semetey-1-2013:p0726:b003:l005","ordinal":132491,"en":"He stained his silver throne,"},{"id":"semetey-1-2013:p0726:b003:l006","ordinal":132492,"en":"He slew his father, the haughty khan."},{"id":"semetey-1-2013:p0726:b003:l007","ordinal":132493,"en":"His gathered wealth fit in his palm;"},{"id":"semetey-1-2013:p0726:b003:l008","ordinal":132494,"en":"Faith alone was what he desired."},{"id":"semetey-1-2013:p0726:b003:l009","ordinal":132495,"en":"Yellow willows he had planted—"},{"id":"semetey-1-2013:p0726:b003:l010","ordinal":132496,"en":"His willows remained in Beijing."},{"id":"semetey-1-2013:p0726:b003:l011","ordinal":132497,"en":"Made of pure gold,"},{"id":"semetey-1-2013:p0726:b003:l012","ordinal":132498,"en":"His throne remained in Beijing."},{"id":"semetey-1-2013:p0726:b003:l013","ordinal":132499,"en":"“Among the infidels of another faith,"},{"id":"semetey-1-2013:p0726:b003:l014","ordinal":132500,"en":"How can I remain?” he said."},{"id":"semetey-1-2013:p0726:b003:l015","ordinal":132501,"en":"“From those terrible afflictions,"},{"id":"semetey-1-2013:p0726:b003:l016","ordinal":132502,"en":"I shall set my soul free.”"},{"id":"semetey-1-2013:p0726:b003:l017","ordinal":132503,"en":"In those days he fled his village and wandered."},{"id":"semetey-1-2013:p0726:b003:l018","ordinal":132504,"en":"Against the seething infidels,"},{"id":"semetey-1-2013:p0726:b003:l019","ordinal":132505,"en":"For six years he contested the khanship."},{"id":"semetey-1-2013:p0726:b003:l020","ordinal":132506,"en":"Your champion fled the Chinese,"},{"id":"semetey-1-2013:p0726:b003:l021","ordinal":132507,"en":"Came and settled in Talas,"},{"id":"semetey-1-2013:p0726:b003:l022","ordinal":132508,"en":"Became Manas's companion."},{"id":"semetey-1-2013:p0726:b003:l023","ordinal":132509,"en":"With golden forelock and tasseled sash,"},{"id":"semetey-1-2013:p0726:b003:l024","ordinal":132510,"en":"The only son of Beijing's Khan Azoozil,"},{"id":"semetey-1-2013:p0726:b003:l026","ordinal":132511,"en":"Is fierce Almambet safe?"},{"id":"semetey-1-2013:p0726:b003:l027","ordinal":132512,"en":"Light on a horse, suited to a yearling,"},{"id":"semetey-1-2013:p0726:b003:l028","ordinal":132513,"en":"Sleepless, watchful on the road,"},{"id":"semetey-1-2013:p0726:b003:l029","ordinal":132514,"en":"Never resting upon his elbows,"},{"id":"semetey-1-2013:p0726:b003:l030","ordinal":132515,"en":"Never sleeping a wink,"},{"id":"semetey-1-2013:p0726:b003:l031","ordinal":132516,"en":"Never drawing back what he extended,"},{"id":"semetey-1-2013:p0726:b003:l032","ordinal":132517,"en":"Never returning downcast from the foe,"},{"id":"semetey-1-2013:p0726:b003:l033","ordinal":132518,"en":"The edge of black steel,"},{"id":"semetey-1-2013:p0726:b003:l034","ordinal":132519,"en":"Khan Manas's Syrgak—"},{"id":"semetey-1-2013:p0726:b003:l035","ordinal":132520,"en":"Is my precious younger brother safe?"},{"id":"semetey-1-2013:p0726:b003:l036","ordinal":132521,"en":"Khan elder Bakai, tell me the truth!"},{"id":"semetey-1-2013:p0726:b003:l037","ordinal":132522,"en":"Dwelling in broad Alai,"},{"id":"semetey-1-2013:p0726:b003:l038","ordinal":132523,"en":"Akbaltai, khan of the Noigut,"},{"id":"semetey-1-2013:p0726:b003:l039","ordinal":132524,"en":"Was called a warrior like a saint."},{"id":"semetey-1-2013:p0726:b004:l001","ordinal":132525,"en":"He gathered and kept all four kinds of livestock."},{"id":"semetey-1-2013:p0726:b004:l002","ordinal":132526,"en":"That Baltai was called rich;"},{"id":"semetey-1-2013:p0726:b004:l003","ordinal":132527,"en":"His wisdom was spread among the people."},{"id":"semetey-1-2013:p0726:b004:l004","ordinal":132528,"en":"In Akbaltai's household,"},{"id":"semetey-1-2013:p0726:b004:l005","ordinal":132529,"en":"They said there were sixty wives."},{"id":"semetey-1-2013:p0726:b004:l006","ordinal":132530,"en":"What could Baltai do in old age?"},{"id":"semetey-1-2013:p0726:b004:l007","ordinal":132531,"en":"He had taken sixty wives."},{"id":"semetey-1-2013:p0726:b004:l008","ordinal":132532,"en":"None of the sixty bore a child;"},{"id":"semetey-1-2013:p0726:b004:l009","ordinal":132533,"en":"He had not seen a single child."},{"id":"semetey-1-2013:p0726:b004:l010","ordinal":132534,"en":"Were sixty wives a delight?"},{"id":"semetey-1-2013:p0726:b004:l011","ordinal":132535,"en":"He had taken wives for a child."},{"id":"semetey-1-2013:p0726:b004:l012","ordinal":132536,"en":"Until he reached eighty,"},{"id":"semetey-1-2013:p0726:b004:l013","ordinal":132537,"en":"He had not seen a child."},{"id":"semetey-1-2013:p0726:b004:l014","ordinal":132538,"en":"He spent nights in summer pastures."},{"id":"semetey-1-2013:p0726:b004:l015","ordinal":132539,"en":"What could precious Baltai do?"},{"id":"semetey-1-2013:p0726:b004:l016","ordinal":132540,"en":"All his four kinds of livestock,"},{"id":"semetey-1-2013:p0726:b004:l017","ordinal":132541,"en":"He spent and gave away."},{"id":"semetey-1-2013:p0726:b004:l018","ordinal":132542,"en":"Setting no store by his livestock,"},{"id":"semetey-1-2013:p0726:b004:l019","ordinal":132543,"en":"He begged God for a child."},{"id":"semetey-1-2013:p0726:b004:l020","ordinal":132544,"en":"The troubles of this world"},{"id":"semetey-1-2013:p0726:b004:l021","ordinal":132545,"en":"He was destined to see."},{"id":"semetey-1-2013:p0726:b004:l022","ordinal":132546,"en":"Khan Baltai was bowed with grief;"},{"id":"semetey-1-2013:p0726:b004:l023","ordinal":132547,"en":"He was destined to see."},{"id":"semetey-1-2013:p0726:b004:l024","ordinal":132548,"en":"Amazed at this treacherous world,"},{"id":"semetey-1-2013:p0726:b004:l025","ordinal":132549,"en":"Lamenting, “I have no child,”"},{"id":"semetey-1-2013:p0726:b004:l026","ordinal":132550,"en":"In those days, when the people moved uphill,"},{"id":"semetey-1-2013:p0726:b004:l027","ordinal":132551,"en":"When summer came and horses’ tongues darkened,"},{"id":"semetey-1-2013:p0726:b004:l028","ordinal":132552,"en":"Then Akbaltai"},{"id":"semetey-1-2013:p0726:b004:l029","ordinal":132553,"en":"Gathered sixty marksmen."},{"id":"semetey-1-2013:p0726:b004:l030","ordinal":132554,"en":"He scouted far along the road."},{"id":"semetey-1-2013:p0726:b004:l031","ordinal":132555,"en":"To a ridge like a saddle's back,"},{"id":"semetey-1-2013:p0726:b004:l032","ordinal":132556,"en":"When he descended,"},{"id":"semetey-1-2013:p0726:b004:l033","ordinal":132557,"en":"Of the wilderness of Mediyan,"},{"id":"semetey-1-2013:p0726:b004:l034","ordinal":132558,"en":"When he came down upon its expanse,"},{"id":"semetey-1-2013:p0726:b004:l035","ordinal":132559,"en":"Placed in white saddlebags,"},{"id":"semetey-1-2013:p0726:b004:l036","ordinal":132560,"en":"Upon Akbaltai's gray she-camel,"},{"id":"semetey-1-2013:p0726:b004:l037","ordinal":132561,"en":"Tied to her hump—"},{"id":"semetey-1-2013:p0726:b004:l038","ordinal":132562,"en":"What could precious Baltai do?"},{"id":"semetey-1-2013:p0726:b004:l039","ordinal":132563,"en":"He turned his horse's head,"},{"id":"semetey-1-2013:p0727:b003:l001","ordinal":132564,"en":"The child tied to the hump"},{"id":"semetey-1-2013:p0727:b003:l002","ordinal":132565,"en":"Was crying aloud."},{"id":"semetey-1-2013:p0727:b003:l003","ordinal":132566,"en":"Finding him, Akbaltai"},{"id":"semetey-1-2013:p0727:b003:l004","ordinal":132567,"en":"Rejoiced beyond all the world,"},{"id":"semetey-1-2013:p0727:b003:l005","ordinal":132568,"en":"Against his bare white breast"},{"id":"semetey-1-2013:p0727:b003:l006","ordinal":132569,"en":"He placed the fair child."},{"id":"semetey-1-2013:p0727:b003:l007","ordinal":132570,"en":"He pledged a sheep to Koroson,"},{"id":"semetey-1-2013:p0727:b003:l008","ordinal":132571,"en":"Quickly invoked Baabedin."},{"id":"semetey-1-2013:p0727:b003:l009","ordinal":132572,"en":"To God Almighty Allah,"},{"id":"semetey-1-2013:p0727:b003:l010","ordinal":132573,"en":"He recited his pledge of a moon-hoofed beast."},{"id":"semetey-1-2013:p0727:b003:l011","ordinal":132574,"en":"The troubles and grief within his heart,"},{"id":"semetey-1-2013:p0727:b003:l012","ordinal":132575,"en":"He scattered them all, leaving none."},{"id":"semetey-1-2013:p0727:b003:l013","ordinal":132576,"en":"Hurrying, Akbaltai"},{"id":"semetey-1-2013:p0727:b003:l014","ordinal":132577,"en":"Returned toward his home."},{"id":"semetey-1-2013:p0727:b003:l015","ordinal":132578,"en":"The eldest of sixty wives,"},{"id":"semetey-1-2013:p0727:b003:l016","ordinal":132579,"en":"The most radiant of them all,"},{"id":"semetey-1-2013:p0727:b003:l017","ordinal":132580,"en":"Was a skilled woman,"},{"id":"semetey-1-2013:p0727:b003:l018","ordinal":132581,"en":"The daughter of Aigan Khan,"},{"id":"semetey-1-2013:p0727:b003:l019","ordinal":132582,"en":"Of good repute, Kanyshai."},{"id":"semetey-1-2013:p0727:b003:l020","ordinal":132583,"en":"“My senior wife has borne a son!”"},{"id":"semetey-1-2013:p0727:b003:l021","ordinal":132584,"en":"He had it proclaimed to the people."},{"id":"semetey-1-2013:p0727:b003:l022","ordinal":132585,"en":"When Akbaltai gave the feast,"},{"id":"semetey-1-2013:p0727:b003:l023","ordinal":132586,"en":"He slaughtered ninety barren mares."},{"id":"semetey-1-2013:p0727:b003:l024","ordinal":132587,"en":"He gathered the learned men,"},{"id":"semetey-1-2013:p0727:b003:l025","ordinal":132588,"en":"And named the child Chubak."},{"id":"semetey-1-2013:p0727:b003:l026","ordinal":132589,"en":"Thus Khan Chubak,"},{"id":"semetey-1-2013:p0727:b003:l027","ordinal":132590,"en":"Until he reached six years,"},{"id":"semetey-1-2013:p0727:b003:l028","ordinal":132591,"en":"Wore an amulet about his neck."},{"id":"semetey-1-2013:p0727:b003:l029","ordinal":132592,"en":"Sixty wives cradled him"},{"id":"semetey-1-2013:p0727:b003:l030","ordinal":132593,"en":"And reared that Chubak."},{"id":"semetey-1-2013:p0727:b003:l031","ordinal":132594,"en":"That Chubak grew unruly."},{"id":"semetey-1-2013:p0727:b003:l032","ordinal":132595,"en":"If he pushed the children,"},{"id":"semetey-1-2013:p0727:b003:l033","ordinal":132596,"en":"He caused their deaths."},{"id":"semetey-1-2013:p0727:b003:l034","ordinal":132597,"en":"“This pale one is unruly!”"},{"id":"semetey-1-2013:p0727:b003:l035","ordinal":132598,"en":"All the other people"},{"id":"semetey-1-2013:p0727:b003:l036","ordinal":132599,"en":"Gave him the name Bolot."},{"id":"semetey-1-2013:p0727:b003:l037","ordinal":132600,"en":"“Someone's evil eye will strike him;"},{"id":"semetey-1-2013:p0727:b003:l038","ordinal":132601,"en":"He will meet with harm,” they said."},{"id":"semetey-1-2013:p0727:b003:l039","ordinal":132602,"en":"Gold by the pood, red goldwork,"},{"id":"semetey-1-2013:p0727:b004:l001","ordinal":132603,"en":"They loaded upon pack animals."},{"id":"semetey-1-2013:p0727:b004:l002","ordinal":132604,"en":"To Mecca, where the scholars dwelt,"},{"id":"semetey-1-2013:p0727:b004:l003","ordinal":132605,"en":"They prepared and gave him ample provisions,"},{"id":"semetey-1-2013:p0727:b004:l004","ordinal":132606,"en":"Entrusted him to a mullah."},{"id":"semetey-1-2013:p0727:b004:l005","ordinal":132607,"en":"To the renowned city of Mecca,"},{"id":"semetey-1-2013:p0727:b004:l006","ordinal":132608,"en":"Leopard Chubak departed."}]
