[{"id":"semetey-1-2013:p0286:b003:l038","ordinal":98817,"en":"Scattered all four kinds of livestock!"},{"id":"semetey-1-2013:p0286:b003:l039","ordinal":98818,"en":"Hot upon their trail,"},{"id":"semetey-1-2013:p0286:b004:l001","ordinal":98819,"en":"Oh, Almambet, my master of hidden arts,"},{"id":"semetey-1-2013:p0286:b004:l002","ordinal":98820,"en":"Let us pursue them relentlessly."},{"id":"semetey-1-2013:p0286:b004:l003","ordinal":98821,"en":"Upon the countless Chinese,"},{"id":"semetey-1-2013:p0286:b004:l004","ordinal":98822,"en":"Let us bring slaughter in a narrow place."},{"id":"semetey-1-2013:p0286:b004:l005","ordinal":98823,"en":"The two maidens who went on watch—"},{"id":"semetey-1-2013:p0286:b004:l006","ordinal":98824,"en":"Bringing slaughter in the narrow place,"},{"id":"semetey-1-2013:p0286:b004:l007","ordinal":98825,"en":"Let us rescue them.”"},{"id":"semetey-1-2013:p0286:b004:l008","ordinal":98826,"en":"Having spoken these words,"},{"id":"semetey-1-2013:p0286:b004:l009","ordinal":98827,"en":"Prince Bakai, the leopard,"},{"id":"semetey-1-2013:p0286:b004:l010","ordinal":98828,"en":"And Almambet, son of Khan Azyz,"},{"id":"semetey-1-2013:p0286:b004:l011","ordinal":98829,"en":"Grappled with the Chinese,"},{"id":"semetey-1-2013:p0286:b004:l012","ordinal":98830,"en":"My saintly master of skill."},{"id":"semetey-1-2013:p0286:b004:l013","ordinal":98831,"en":"Wind-driven drizzle turning into snow—"},{"id":"semetey-1-2013:p0286:b004:l014","ordinal":98832,"en":"Your Almambet worked his weather magic."},{"id":"semetey-1-2013:p0286:b004:l015","ordinal":98833,"en":"Gray haze, low-lying fog,"},{"id":"semetey-1-2013:p0286:b004:l016","ordinal":98834,"en":"Cloudy by day, clear by night,"},{"id":"semetey-1-2013:p0286:b004:l017","ordinal":98835,"en":"The weather’s temper was upset."},{"id":"semetey-1-2013:p0286:b004:l018","ordinal":98836,"en":"Fleeing across to the far side,"},{"id":"semetey-1-2013:p0286:b004:l019","ordinal":98837,"en":"Alooke’s Kongurbay,"},{"id":"semetey-1-2013:p0286:b004:l020","ordinal":98838,"en":"Sixty Chinese, countless governors—"},{"id":"semetey-1-2013:p0286:b004:l021","ordinal":98839,"en":"When these men pursued them,"},{"id":"semetey-1-2013:p0286:b004:l022","ordinal":98840,"en":"He fled across and escaped."},{"id":"semetey-1-2013:p0286:b004:l023","ordinal":98841,"en":"Sixty Chinese and a great governor"},{"id":"semetey-1-2013:p0286:b004:l024","ordinal":98842,"en":"Were captured there."},{"id":"semetey-1-2013:p0286:b004:l025","ordinal":98843,"en":"A thousand wrestlers, led by the governor,"},{"id":"semetey-1-2013:p0286:b004:l026","ordinal":98844,"en":"Bakai took prisoner."},{"id":"semetey-1-2013:p0286:b004:l027","ordinal":98845,"en":"Leaving not one alive,"},{"id":"semetey-1-2013:p0286:b004:l028","ordinal":98846,"en":"Almambet, son of Khan Azyz,"},{"id":"semetey-1-2013:p0286:b004:l029","ordinal":98847,"en":"Your hero born surpassing others,"},{"id":"semetey-1-2013:p0286:b004:l030","ordinal":98848,"en":"Offered them up as sacrifices."},{"id":"semetey-1-2013:p0286:b004:l031","ordinal":98849,"en":"The two distraught maidens,"},{"id":"semetey-1-2013:p0286:b004:l032","ordinal":98850,"en":"The mighty ones on watch,"},{"id":"semetey-1-2013:p0286:b004:l033","ordinal":98851,"en":"These men rescued them."},{"id":"semetey-1-2013:p0286:b004:l034","ordinal":98852,"en":"Khan Saikal, daughter of Karacha,"},{"id":"semetey-1-2013:p0286:b004:l035","ordinal":98853,"en":"They returned to her father."},{"id":"semetey-1-2013:p0286:b004:l036","ordinal":98854,"en":"Manas’s sister Kardygach,"},{"id":"semetey-1-2013:p0286:b004:l037","ordinal":98855,"en":"At the world’s end, Zhelpinish,"},{"id":"semetey-1-2013:p0286:b004:l038","ordinal":98856,"en":"To Zharmanas of the ill-famed people,"},{"id":"semetey-1-2013:p0286:b004:l039","ordinal":98857,"en":"To Zharmanas they gave her."},{"id":"semetey-1-2013:p0287:b003:l001","ordinal":98858,"en":"“She bore one son, a lion champion;"},{"id":"semetey-1-2013:p0287:b003:l002","ordinal":98859,"en":"My mother who lies here"},{"id":"semetey-1-2013:p0287:b003:l003","ordinal":98860,"en":"Bore one daughter, a warrior.”"},{"id":"semetey-1-2013:p0287:b003:l004","ordinal":98861,"en":"Having spoken these words,"},{"id":"semetey-1-2013:p0287:b003:l005","ordinal":98862,"en":"Telling of the lion champion who had passed away,"},{"id":"semetey-1-2013:p0287:b003:l006","ordinal":98863,"en":"Speaking of where to strike their flank,"},{"id":"semetey-1-2013:p0287:b003:l007","ordinal":98864,"en":"Calling her own son little brother,"},{"id":"semetey-1-2013:p0287:b003:l008","ordinal":98865,"en":"“Whom have I but you?” she said."},{"id":"semetey-1-2013:p0287:b003:l009","ordinal":98866,"en":"“For a widow like me,"},{"id":"semetey-1-2013:p0287:b003:l010","ordinal":98867,"en":"Apart from you, little brother,"},{"id":"semetey-1-2013:p0287:b003:l011","ordinal":98868,"en":"Who is there to look after me?” she said."},{"id":"semetey-1-2013:p0287:b003:l012","ordinal":98869,"en":"Kanykei turned and walked."},{"id":"semetey-1-2013:p0287:b003:l013","ordinal":98870,"en":"On this side of the lattice wall,"},{"id":"semetey-1-2013:p0287:b003:l014","ordinal":98871,"en":"On the far side of the curtain,"},{"id":"semetey-1-2013:p0287:b003:l015","ordinal":98872,"en":"Upon the bed,"},{"id":"semetey-1-2013:p0287:b003:l016","ordinal":98873,"en":"The old woman lay hunched,"},{"id":"semetey-1-2013:p0287:b003:l017","ordinal":98874,"en":"The saintly one upheld by her patron,"},{"id":"semetey-1-2013:p0287:b003:l018","ordinal":98875,"en":"The venerable old Chyiyrdy,"},{"id":"semetey-1-2013:p0287:b003:l019","ordinal":98876,"en":"The elder who had borne Manas."},{"id":"semetey-1-2013:p0287:b003:l020","ordinal":98877,"en":"God had granted her wish;"},{"id":"semetey-1-2013:p0287:b003:l021","ordinal":98878,"en":"She had reached ninety-five."},{"id":"semetey-1-2013:p0287:b003:l022","ordinal":98879,"en":"Bent over like a quail,"},{"id":"semetey-1-2013:p0287:b003:l023","ordinal":98880,"en":"She had huddled into herself."},{"id":"semetey-1-2013:p0287:b003:l024","ordinal":98881,"en":"When her royal son had died,"},{"id":"semetey-1-2013:p0287:b003:l025","ordinal":98882,"en":"“My king!” she had wept and wept."},{"id":"semetey-1-2013:p0287:b003:l026","ordinal":98883,"en":"With no strength to rise,"},{"id":"semetey-1-2013:p0287:b003:l027","ordinal":98884,"en":"The old woman had sunk down."},{"id":"semetey-1-2013:p0287:b003:l028","ordinal":98885,"en":"Her eyes had filled with pus;"},{"id":"semetey-1-2013:p0287:b003:l029","ordinal":98886,"en":"Her chest had begun to rattle."},{"id":"semetey-1-2013:p0287:b003:l030","ordinal":98887,"en":"All twelve bones of her frame"},{"id":"semetey-1-2013:p0287:b003:l031","ordinal":98888,"en":"Trembled without cease."},{"id":"semetey-1-2013:p0287:b003:l032","ordinal":98889,"en":"Call her dead—she was not in the grave;"},{"id":"semetey-1-2013:p0287:b003:l033","ordinal":98890,"en":"Call her alive—she was not among their number."},{"id":"semetey-1-2013:p0287:b003:l034","ordinal":98891,"en":"Seen today, gone tomorrow:"},{"id":"semetey-1-2013:p0287:b003:l035","ordinal":98892,"en":"Such is this world of shit."},{"id":"semetey-1-2013:p0287:b003:l036","ordinal":98893,"en":"The elder was ninety-five,"},{"id":"semetey-1-2013:p0287:b003:l037","ordinal":98894,"en":"Without the strength to stand."},{"id":"semetey-1-2013:p0287:b003:l038","ordinal":98895,"en":"Your dear mother Kanykei,"},{"id":"semetey-1-2013:p0287:b003:l039","ordinal":98896,"en":"The old woman lying there in sorrow,"},{"id":"semetey-1-2013:p0287:b004:l001","ordinal":98897,"en":"Took her firmly by the forearm."},{"id":"semetey-1-2013:p0287:b004:l002","ordinal":98898,"en":"That same dear mother Kanykei"},{"id":"semetey-1-2013:p0287:b004:l003","ordinal":98899,"en":"Spoke to her loudly:"},{"id":"semetey-1-2013:p0287:b004:l004","ordinal":98900,"en":"“Venerable old woman, my sacred mother,"},{"id":"semetey-1-2013:p0287:b004:l005","ordinal":98901,"en":"My darling mother!"},{"id":"semetey-1-2013:p0287:b004:l006","ordinal":98902,"en":"Seeing you, my heart is deeply content;"},{"id":"semetey-1-2013:p0287:b004:l007","ordinal":98903,"en":"Mother, I have no sacred refuge but you."},{"id":"semetey-1-2013:p0287:b004:l008","ordinal":98904,"en":"God has granted your wish;"},{"id":"semetey-1-2013:p0287:b004:l009","ordinal":98905,"en":"Lift your head and rise, Mother:"},{"id":"semetey-1-2013:p0287:b004:l010","ordinal":98906,"en":"Your young in-law has come."},{"id":"semetey-1-2013:p0287:b004:l011","ordinal":98907,"en":"Rise and greet him, Mother!"},{"id":"semetey-1-2013:p0287:b004:l012","ordinal":98908,"en":"Your lamenting split the stones;"},{"id":"semetey-1-2013:p0287:b004:l013","ordinal":98909,"en":"My darling mother,"},{"id":"semetey-1-2013:p0287:b004:l014","ordinal":98910,"en":"You were like a crying snowcock."},{"id":"semetey-1-2013:p0287:b004:l015","ordinal":98911,"en":"‘If only I could see that in-law,’ you said;"},{"id":"semetey-1-2013:p0287:b004:l016","ordinal":98912,"en":"Mother, you had longed for him.”"},{"id":"semetey-1-2013:p0287:b004:l017","ordinal":98913,"en":"Then Chyiyrdy,"},{"id":"semetey-1-2013:p0287:b004:l018","ordinal":98914,"en":"When she heard this news,"},{"id":"semetey-1-2013:p0287:b004:l019","ordinal":98915,"en":"Coughing in deep, repeated bursts,"},{"id":"semetey-1-2013:p0287:b004:l020","ordinal":98916,"en":"Raised her head from the bed."},{"id":"semetey-1-2013:p0287:b004:l021","ordinal":98917,"en":"Coughing in sharp, repeated bursts,"},{"id":"semetey-1-2013:p0287:b004:l022","ordinal":98918,"en":"Raised her head from the pillow."},{"id":"semetey-1-2013:p0287:b004:l023","ordinal":98919,"en":"Taking a golden staff in her hand,"},{"id":"semetey-1-2013:p0287:b004:l024","ordinal":98920,"en":"She barely managed to straighten up,"},{"id":"semetey-1-2013:p0287:b004:l025","ordinal":98921,"en":"Turning toward her only one, Semetey."},{"id":"semetey-1-2013:p0287:b004:l026","ordinal":98922,"en":"Her dry eyes, so full of dignity,"},{"id":"semetey-1-2013:p0287:b004:l027","ordinal":98923,"en":"Your mother turned and wiped."},{"id":"semetey-1-2013:p0287:b004:l028","ordinal":98924,"en":"For the time it takes meat to cook,"},{"id":"semetey-1-2013:p0287:b004:l029","ordinal":98925,"en":"She gazed at the boy without tiring."},{"id":"semetey-1-2013:p0287:b004:l030","ordinal":98926,"en":"Watching the boy, full of longing,"},{"id":"semetey-1-2013:p0287:b004:l031","ordinal":98927,"en":"Chyiyrdy began,"},{"id":"semetey-1-2013:p0287:b004:l032","ordinal":98928,"en":"Pleading then with Kanykei:"},{"id":"semetey-1-2013:p0287:b004:l033","ordinal":98929,"en":"“Oh, Kanykei, my foal,"},{"id":"semetey-1-2013:p0287:b004:l034","ordinal":98930,"en":"Who would not tire if ridden for six months,"},{"id":"semetey-1-2013:p0287:b004:l035","ordinal":98931,"en":"Even upon reaching sixty mature years,"},{"id":"semetey-1-2013:p0287:b004:l036","ordinal":98932,"en":"Would not wear down her teeth and grow old—"},{"id":"semetey-1-2013:p0287:b004:l037","ordinal":98933,"en":"Oh, Kanykei, my foal,"},{"id":"semetey-1-2013:p0287:b004:l038","ordinal":98934,"en":"My tireless black steed with the white blaze,"},{"id":"semetey-1-2013:p0287:b004:l039","ordinal":98935,"en":"Let me speak what lies within my belly,"},{"id":"semetey-1-2013:p0288:b003:l001","ordinal":98936,"en":"My darling foal!"},{"id":"semetey-1-2013:p0288:b003:l002","ordinal":98937,"en":"When my foal Manas died,"},{"id":"semetey-1-2013:p0288:b003:l003","ordinal":98938,"en":"When my wretched head suffered plunder,"},{"id":"semetey-1-2013:p0288:b003:l004","ordinal":98939,"en":"When I ran like a hunting hound,"},{"id":"semetey-1-2013:p0288:b003:l005","ordinal":98940,"en":"Suffering hardship, my afflicted head,"},{"id":"semetey-1-2013:p0288:b003:l006","ordinal":98941,"en":"When I came wandering from Talas,"},{"id":"semetey-1-2013:p0288:b003:l007","ordinal":98942,"en":"God drove me under escort,"},{"id":"semetey-1-2013:p0288:b003:l008","ordinal":98943,"en":"I came to Bukhara and settled,"},{"id":"semetey-1-2013:p0288:b003:l009","ordinal":98944,"en":"Wearing a loose, flapping felt cloak,"},{"id":"semetey-1-2013:p0288:b003:l010","ordinal":98945,"en":"Riding a bay mare, swaying along,"},{"id":"semetey-1-2013:p0288:b003:l011","ordinal":98946,"en":"Finding even yearling sheep's fat frozen,"},{"id":"semetey-1-2013:p0288:b003:l012","ordinal":98947,"en":"Suffering such great torment,"},{"id":"semetey-1-2013:p0288:b003:l013","ordinal":98948,"en":"To Temir Khan's city"},{"id":"semetey-1-2013:p0288:b003:l014","ordinal":98949,"en":"I came wandering to make my living."},{"id":"semetey-1-2013:p0288:b003:l015","ordinal":98950,"en":"When I settled as a wanderer in Bukhara,"},{"id":"semetey-1-2013:p0288:b003:l016","ordinal":98951,"en":"Having them call me a wandering woman,"},{"id":"semetey-1-2013:p0288:b003:l017","ordinal":98952,"en":"My child, when I gained an ill name,"},{"id":"semetey-1-2013:p0288:b003:l018","ordinal":98953,"en":"Born when we arrived,"},{"id":"semetey-1-2013:p0288:b003:l019","ordinal":98954,"en":"Countless people gave him a name,"},{"id":"semetey-1-2013:p0288:b003:l020","ordinal":98955,"en":"Held a great feast and slaughtered mares."},{"id":"semetey-1-2013:p0288:b003:l021","ordinal":98956,"en":"A levy was raised in Bukhara,"},{"id":"semetey-1-2013:p0288:b003:l022","ordinal":98957,"en":"Countless fifth-year she-camels slaughtered."},{"id":"semetey-1-2013:p0288:b003:l023","ordinal":98958,"en":"The people gathered, and his own name"},{"id":"semetey-1-2013:p0288:b003:l024","ordinal":98959,"en":"Was given as the warrior Semetey."},{"id":"semetey-1-2013:p0288:b003:l025","ordinal":98960,"en":"Afghans ate at his feast and departed,"},{"id":"semetey-1-2013:p0288:b003:l026","ordinal":98961,"en":"'If this child lives unharmed,"},{"id":"semetey-1-2013:p0288:b003:l027","ordinal":98962,"en":"He will shatter the Oirats,' they said and left."},{"id":"semetey-1-2013:p0288:b003:l028","ordinal":98963,"en":"Kyrgyz ate at his feast and departed,"},{"id":"semetey-1-2013:p0288:b003:l029","ordinal":98964,"en":"'If this child lives unharmed,"},{"id":"semetey-1-2013:p0288:b003:l030","ordinal":98965,"en":"He will be worth the whole world,' they said and left."},{"id":"semetey-1-2013:p0288:b003:l031","ordinal":98966,"en":"Is he the bird upon your hand,"},{"id":"semetey-1-2013:p0288:b003:l032","ordinal":98967,"en":"Who lately became the new khan in Bukhara?"},{"id":"semetey-1-2013:p0288:b003:l033","ordinal":98968,"en":"My dear Kanykei,"},{"id":"semetey-1-2013:p0288:b003:l034","ordinal":98969,"en":"Is this your little brother?"},{"id":"semetey-1-2013:p0288:b003:l035","ordinal":98970,"en":"The people gathered to speak,"},{"id":"semetey-1-2013:p0288:b003:l036","ordinal":98971,"en":"Placed a golden crown upon him,"},{"id":"semetey-1-2013:p0288:b003:l037","ordinal":98972,"en":"Seated him on a golden throne,"},{"id":"semetey-1-2013:p0288:b003:l038","ordinal":98973,"en":"The people loved him and made him their lord."},{"id":"semetey-1-2013:p0288:b003:l039","ordinal":98974,"en":"Roused by honor, that child"},{"id":"semetey-1-2013:p0288:b004:l001","ordinal":98975,"en":"Began to wreak havoc."},{"id":"semetey-1-2013:p0288:b004:l002","ordinal":98976,"en":"When he reached twelve this year,"},{"id":"semetey-1-2013:p0288:b004:l003","ordinal":98977,"en":"One arm of Toobalban"},{"id":"semetey-1-2013:p0288:b004:l004","ordinal":98978,"en":"He tore clean out."},{"id":"semetey-1-2013:p0288:b004:l005","ordinal":98979,"en":"No one brought him trouble;"},{"id":"semetey-1-2013:p0288:b004:l006","ordinal":98980,"en":"Among the peoples of eight khans"},{"id":"semetey-1-2013:p0288:b004:l007","ordinal":98981,"en":"None remained who could answer back."},{"id":"semetey-1-2013:p0288:b004:l008","ordinal":98982,"en":"He kept a court and became khan,"},{"id":"semetey-1-2013:p0288:b004:l009","ordinal":98983,"en":"Became an established judge."},{"id":"semetey-1-2013:p0288:b004:l010","ordinal":98984,"en":"In renowned Bukhara,"},{"id":"semetey-1-2013:p0288:b004:l011","ordinal":98985,"en":"At twelve years old he became khan."},{"id":"semetey-1-2013:p0288:b004:l012","ordinal":98986,"en":"Whoever answered him defiantly,"},{"id":"semetey-1-2013:p0288:b004:l013","ordinal":98987,"en":"He seized and twisted their neck."},{"id":"semetey-1-2013:p0288:b004:l014","ordinal":98988,"en":"The many people of populous Bukhara"},{"id":"semetey-1-2013:p0288:b004:l015","ordinal":98989,"en":"He ruled at twelve."},{"id":"semetey-1-2013:p0288:b004:l016","ordinal":98990,"en":"Is Bukhara the land where you dwell,"},{"id":"semetey-1-2013:p0288:b004:l017","ordinal":98991,"en":"Who made so many fervent wishes?"},{"id":"semetey-1-2013:p0288:b004:l018","ordinal":98992,"en":"My dear Kanykei,"},{"id":"semetey-1-2013:p0288:b004:l019","ordinal":98993,"en":"Is this your little brother?"},{"id":"semetey-1-2013:p0288:b004:l020","ordinal":98994,"en":"When fortune has left our heads,"},{"id":"semetey-1-2013:p0288:b004:l021","ordinal":98995,"en":"My young kinsman by marriage, is this a time to rise to the heights?"},{"id":"semetey-1-2013:p0288:b004:l022","ordinal":98996,"en":"You became lord of your people."},{"id":"semetey-1-2013:p0288:b004:l023","ordinal":98997,"en":"Though I have not seen or known you,"},{"id":"semetey-1-2013:p0288:b004:l024","ordinal":98998,"en":"My dear young kinsman by marriage, are you well?"},{"id":"semetey-1-2013:p0288:b004:l025","ordinal":98999,"en":"Young kinsman, ride over and visit our home."},{"id":"semetey-1-2013:p0288:b004:l026","ordinal":99000,"en":"'How are you faring?' ask,"},{"id":"semetey-1-2013:p0288:b004:l027","ordinal":99001,"en":"And visit this dark-fated soul!"},{"id":"semetey-1-2013:p0288:b004:l028","ordinal":99002,"en":"Do not let the whip-bearer strike me,"},{"id":"semetey-1-2013:p0288:b004:l029","ordinal":99003,"en":"Do not let the winged one beat me."},{"id":"semetey-1-2013:p0288:b004:l030","ordinal":99004,"en":"This lonely head of golden worth,"},{"id":"semetey-1-2013:p0288:b004:l031","ordinal":99005,"en":"Do not let the grasping bird devour it."},{"id":"semetey-1-2013:p0288:b004:l032","ordinal":99006,"en":"They are such a gossiping people:"},{"id":"semetey-1-2013:p0288:b004:l033","ordinal":99007,"en":"Here in Bukhara,"},{"id":"semetey-1-2013:p0288:b004:l034","ordinal":99008,"en":"Do not let them call me a wandering woman."},{"id":"semetey-1-2013:p0288:b004:l035","ordinal":99009,"en":"Let me see your face."},{"id":"semetey-1-2013:p0288:b004:l036","ordinal":99010,"en":"'Kinswoman by marriage, how do you fare?'"},{"id":"semetey-1-2013:p0288:b004:l037","ordinal":99011,"en":"Keep asking after me."},{"id":"semetey-1-2013:p0288:b004:l038","ordinal":99012,"en":"Ride over and call at our home,"},{"id":"semetey-1-2013:p0288:b004:l039","ordinal":99013,"en":"Keep asking how I fare."},{"id":"semetey-1-2013:p0289:b003:l001","ordinal":99014,"en":"Temir Khan, khan of Bukhara,"},{"id":"semetey-1-2013:p0289:b003:l002","ordinal":99015,"en":"Ismail and Semetey,"},{"id":"semetey-1-2013:p0289:b003:l003","ordinal":99016,"en":"Upon you three in Bukhara"},{"id":"semetey-1-2013:p0289:b003:l004","ordinal":99017,"en":"We rely for support."},{"id":"semetey-1-2013:p0289:b003:l005","ordinal":99018,"en":"Poor widows like us"},{"id":"semetey-1-2013:p0289:b003:l006","ordinal":99019,"en":"Find peace when you ride over to visit."},{"id":"semetey-1-2013:p0289:b003:l007","ordinal":99020,"en":"'May all three stay safe and well,'"},{"id":"semetey-1-2013:p0289:b003:l008","ordinal":99021,"en":"We keep asking God!'"},{"id":"semetey-1-2013:p0289:b003:l009","ordinal":99022,"en":"Speaking without letting her secret show,"},{"id":"semetey-1-2013:p0289:b003:l010","ordinal":99023,"en":"Voicing a secret no one could know,"},{"id":"semetey-1-2013:p0289:b003:l011","ordinal":99024,"en":"Grasping him firmly about the neck,"},{"id":"semetey-1-2013:p0289:b003:l012","ordinal":99025,"en":"Burning him with her words,"},{"id":"semetey-1-2013:p0289:b003:l013","ordinal":99026,"en":"Her mouth to his throat"},{"id":"semetey-1-2013:p0289:b003:l014","ordinal":99027,"en":"She touched ever so lightly."},{"id":"semetey-1-2013:p0289:b003:l015","ordinal":99028,"en":"Drawing in his scent with a deep sniff,"},{"id":"semetey-1-2013:p0289:b003:l016","ordinal":99029,"en":"The old mistress left in misery"},{"id":"semetey-1-2013:p0289:b003:l017","ordinal":99030,"en":"Had no way to speak openly."},{"id":"semetey-1-2013:p0289:b003:l018","ordinal":99031,"en":"She breathed his scent deeply."},{"id":"semetey-1-2013:p0289:b003:l019","ordinal":99032,"en":"Helpless, without recourse,"},{"id":"semetey-1-2013:p0289:b003:l020","ordinal":99033,"en":"'The only one left by the magnanimous hero,' she thought."},{"id":"semetey-1-2013:p0289:b003:l021","ordinal":99034,"en":"Your noble mother Chiyrdy"},{"id":"semetey-1-2013:p0289:b003:l022","ordinal":99035,"en":"Could not burst out wailing."},{"id":"semetey-1-2013:p0289:b003:l023","ordinal":99036,"en":"Letting go of the child,"},{"id":"semetey-1-2013:p0289:b003:l024","ordinal":99037,"en":"Your mother then sank into troubled thoughts."},{"id":"semetey-1-2013:p0289:b003:l025","ordinal":99038,"en":"The spring flowing from the ridge,"},{"id":"semetey-1-2013:p0289:b003:l026","ordinal":99039,"en":"She looked him in the face,"},{"id":"semetey-1-2013:p0289:b003:l027","ordinal":99040,"en":"The orphan left by the champion."},{"id":"semetey-1-2013:p0289:b003:l028","ordinal":99041,"en":"Her thoughts more deeply troubled,"},{"id":"semetey-1-2013:p0289:b003:l029","ordinal":99042,"en":"Chiyrdy beheld as a living memento"},{"id":"semetey-1-2013:p0289:b003:l030","ordinal":99043,"en":"That child left by the champion."},{"id":"semetey-1-2013:p0289:b003:l031","ordinal":99044,"en":"When she beheld his blessing,"},{"id":"semetey-1-2013:p0289:b003:l032","ordinal":99045,"en":"Her rib bones came apart."},{"id":"semetey-1-2013:p0289:b003:l033","ordinal":99046,"en":"The old woman at death's door"},{"id":"semetey-1-2013:p0289:b003:l034","ordinal":99047,"en":"Felt her heart sorely torn."},{"id":"semetey-1-2013:p0289:b003:l035","ordinal":99048,"en":"Every bone ached piercingly."},{"id":"semetey-1-2013:p0289:b003:l036","ordinal":99049,"en":"There was no way to weep openly."},{"id":"semetey-1-2013:p0289:b003:l037","ordinal":99050,"en":"'The orphan left by the ocean,' she thought,"},{"id":"semetey-1-2013:p0289:b003:l038","ordinal":99051,"en":"And the old woman turned away,"},{"id":"semetey-1-2013:p0289:b003:l039","ordinal":99052,"en":"Wailing and sobbing."},{"id":"semetey-1-2013:p0289:b005:l001","ordinal":99053,"en":"Her poor heart torn apart,"},{"id":"semetey-1-2013:p0289:b005:l002","ordinal":99054,"en":"At the place where she saw the child,"},{"id":"semetey-1-2013:p0289:b005:l003","ordinal":99055,"en":"Bloody tears mixed with blood"},{"id":"semetey-1-2013:p0289:b005:l004","ordinal":99056,"en":"Poured upon her breast."},{"id":"semetey-1-2013:p0289:b005:l005","ordinal":99057,"en":"As the old woman wailed,"},{"id":"semetey-1-2013:p0289:b005:l006","ordinal":99058,"en":"Her voice reached God."},{"id":"semetey-1-2013:p0289:b005:l007","ordinal":99059,"en":"Your venerable grandmother,"},{"id":"semetey-1-2013:p0289:b005:l008","ordinal":99060,"en":"The old mistress staggered"},{"id":"semetey-1-2013:p0289:b005:l009","ordinal":99061,"en":"And fell, turning away."},{"id":"semetey-1-2013:p0289:b005:l010","ordinal":99062,"en":"Unable to keep looking at her ocean,"},{"id":"semetey-1-2013:p0289:b005:l011","ordinal":99063,"en":"The old mistress lost consciousness."},{"id":"semetey-1-2013:p0289:b005:l012","ordinal":99064,"en":"As though she would face the Last Judgment,"},{"id":"semetey-1-2013:p0289:b005:l013","ordinal":99065,"en":"A hard day fell upon her,"},{"id":"semetey-1-2013:p0289:b005:l014","ordinal":99066,"en":"As though she would die in an instant."},{"id":"semetey-1-2013:p0289:b005:l015","ordinal":99067,"en":"Her voice reached God."},{"id":"semetey-1-2013:p0289:b005:l016","ordinal":99068,"en":"The poor old mistress"},{"id":"semetey-1-2013:p0289:b005:l017","ordinal":99069,"en":"Fell upon the bed."},{"id":"semetey-1-2013:p0289:b005:l018","ordinal":99070,"en":"Hunching like a quail,"},{"id":"semetey-1-2013:p0289:b005:l019","ordinal":99071,"en":"The old mistress curled up."},{"id":"semetey-1-2013:p0289:b005:l020","ordinal":99072,"en":"Bending double,"}]
