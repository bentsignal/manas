[{"id":"manas-2010:p1471:b001:l035","ordinal":63489,"en":"Their battle-axes jingled."},{"id":"manas-2010:p1471:b001:l036","ordinal":63490,"en":"The multitude of Chinese set out,"},{"id":"manas-2010:p1471:b001:l037","ordinal":63491,"en":"Their banners fluttering,"},{"id":"manas-2010:p1471:b001:l038","ordinal":63492,"en":"Their shields clattering."},{"id":"manas-2010:p1471:b001:l039","ordinal":63493,"en":"With Kongurbay at their head,"},{"id":"manas-2010:p1471:b001:l040","ordinal":63494,"en":"All their giants there,"},{"id":"manas-2010:p1471:b001:l041","ordinal":63495,"en":"The multitude of Chinese set out."},{"id":"manas-2010:p1471:b001:l042","ordinal":63496,"en":"Almambet, Chubak and hero Syrgak"},{"id":"manas-2010:p1472:b001:l001","ordinal":63497,"en":"Came to Manas’s side."},{"id":"manas-2010:p1472:b001:l002","ordinal":63498,"en":"Pale, mottled pennants and a red banner,"},{"id":"manas-2010:p1472:b001:l003","ordinal":63499,"en":"Over hero Manas,"},{"id":"manas-2010:p1472:b001:l004","ordinal":63500,"en":"An uproar of cries of woe."},{"id":"manas-2010:p1472:b001:l005","ordinal":63501,"en":"His fine mustache drooping,"},{"id":"manas-2010:p1472:b001:l006","ordinal":63502,"en":"Like one bound for Judgment Day,"},{"id":"manas-2010:p1472:b001:l007","ordinal":63503,"en":"Your fierce, blue-maned Manas"},{"id":"manas-2010:p1472:b001:l008","ordinal":63504,"en":"Had become gravely ill."},{"id":"manas-2010:p1472:b001:l009","ordinal":63505,"en":"Between his back and neck,"},{"id":"manas-2010:p1472:b001:l010","ordinal":63506,"en":"The place had festered,"},{"id":"manas-2010:p1472:b001:l011","ordinal":63507,"en":"The wound struck by the battle-axe."},{"id":"manas-2010:p1472:b001:l012","ordinal":63508,"en":"Rust had seized his blue steel;"},{"id":"manas-2010:p1472:b001:l013","ordinal":63509,"en":"Ajybay had failed to see,"},{"id":"manas-2010:p1472:b001:l014","ordinal":63510,"en":"His two eyes darkened."},{"id":"manas-2010:p1472:b001:l015","ordinal":63511,"en":"He had the gateway closed;"},{"id":"manas-2010:p1472:b001:l016","ordinal":63512,"en":"The magnanimous one standing for the call to prayer,"},{"id":"manas-2010:p1472:b001:l017","ordinal":63513,"en":"Ajybay had failed to watch,"},{"id":"manas-2010:p1472:b001:l018","ordinal":63514,"en":"And Alöökö’s son Kongurbay"},{"id":"manas-2010:p1472:b001:l019","ordinal":63515,"en":"He had let strike unexpectedly."},{"id":"manas-2010:p1472:b001:l020","ordinal":63516,"en":"He had broken the Muslims’ backs;"},{"id":"manas-2010:p1472:b001:l021","ordinal":63517,"en":"He had ruled alone"},{"id":"manas-2010:p1472:b001:l022","ordinal":63518,"en":"The multitude of Manchu and Chinese,"},{"id":"manas-2010:p1472:b001:l023","ordinal":63519,"en":"Whose hearts he now put at ease."},{"id":"manas-2010:p1472:b001:l025","ordinal":63520,"en":"Of fierce Sultan Manas,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p1472:b001:l026","ordinal":63521,"en":"The forty companions, not watching,"},{"id":"manas-2010:p1472:b001:l027","ordinal":63522,"en":"Let the Chinese split his head."},{"id":"manas-2010:p1472:b001:l028","ordinal":63523,"en":"His lion-friend Almambet,"},{"id":"manas-2010:p1472:b001:l029","ordinal":63524,"en":"Your experienced champion,"},{"id":"manas-2010:p1472:b001:l030","ordinal":63525,"en":"In Beijing of the multitude of Chinese,"},{"id":"manas-2010:p1472:b001:l031","ordinal":63526,"en":"So much slaughter and calamity,"},{"id":"manas-2010:p1472:b001:l032","ordinal":63527,"en":"Had he not brought it!"},{"id":"manas-2010:p1472:b001:l033","ordinal":63528,"en":"The medicine called “Aid,”"},{"id":"manas-2010:p1472:b001:l034","ordinal":63529,"en":"Had he not brought it!"},{"id":"manas-2010:p1472:b001:l035","ordinal":63530,"en":"Watching, Almambet,"},{"id":"manas-2010:p1472:b001:l036","ordinal":63531,"en":"Grieving for Khan Manas,"},{"id":"manas-2010:p1472:b001:l037","ordinal":63532,"en":"His heart deeply anguished,"},{"id":"manas-2010:p1472:b001:l038","ordinal":63533,"en":"His two eyes like a falcon’s,"},{"id":"manas-2010:p1472:b001:l039","ordinal":63534,"en":"Unblinking, filling with tears,"},{"id":"manas-2010:p1472:b001:l040","ordinal":63535,"en":"Looking again, Almambet"},{"id":"manas-2010:p1472:b001:l041","ordinal":63536,"en":"Stood tearful, his voice ringing:"},{"id":"manas-2010:p1472:b001:l042","ordinal":63537,"en":"“The fortress of the Muslim people,"},{"id":"manas-2010:p1473:b001:l001","ordinal":63538,"en":"While my friend Manas was there,"},{"id":"manas-2010:p1473:b001:l002","ordinal":63539,"en":"Through so many formidable foes,"},{"id":"manas-2010:p1473:b001:l003","ordinal":63540,"en":"‘I shall make a road,’ I used to say."},{"id":"manas-2010:p1473:b001:l004","ordinal":63541,"en":"‘Not merely the Chinese, but the whole world"},{"id":"manas-2010:p1473:b001:l005","ordinal":63542,"en":"I shall attack,’ I used to say!"},{"id":"manas-2010:p1473:b001:l006","ordinal":63543,"en":"Did this wretched soul, rejoicing,"},{"id":"manas-2010:p1473:b001:l007","ordinal":63544,"en":"Grow full with a seething heart?"},{"id":"manas-2010:p1473:b001:l008","ordinal":63545,"en":"Did that thought unexpectedly"},{"id":"manas-2010:p1473:b001:l009","ordinal":63546,"en":"Become a curse upon me!"},{"id":"manas-2010:p1473:b001:l010","ordinal":63547,"en":"When I entered battle without looking back,"},{"id":"manas-2010:p1473:b001:l011","ordinal":63548,"en":"When my fierce Manas stood there,"},{"id":"manas-2010:p1473:b001:l012","ordinal":63549,"en":"I devoured those who faced me."},{"id":"manas-2010:p1473:b001:l013","ordinal":63550,"en":"While my champion Manas was there,"},{"id":"manas-2010:p1473:b001:l014","ordinal":63551,"en":"‘There is no death for me,’ I used to say!"},{"id":"manas-2010:p1473:b001:l015","ordinal":63552,"en":"Though its rocky passage was hard-won,"},{"id":"manas-2010:p1473:b001:l016","ordinal":63553,"en":"Though there was even a sweeping flood,"},{"id":"manas-2010:p1473:b001:l017","ordinal":63554,"en":"Though an army pressed upon us,"},{"id":"manas-2010:p1473:b001:l018","ordinal":63555,"en":"While Manas was before me,"},{"id":"manas-2010:p1473:b001:l019","ordinal":63556,"en":"‘From the sky and dark earth"},{"id":"manas-2010:p1473:b001:l020","ordinal":63557,"en":"I shall raise dust,’ I used to say."},{"id":"manas-2010:p1473:b001:l021","ordinal":63558,"en":"However formidable they were,"},{"id":"manas-2010:p1473:b001:l022","ordinal":63559,"en":"Fighting amid the dust,"},{"id":"manas-2010:p1473:b001:l023","ordinal":63560,"en":"‘I shall draw blood,’ I used to say.”"},{"id":"manas-2010:p1473:b001:l024","ordinal":63561,"en":"“What is seen today is gone tomorrow;"},{"id":"manas-2010:p1473:b001:l025","ordinal":63562,"en":"So shamelessly deceitful,"},{"id":"manas-2010:p1473:b001:l026","ordinal":63563,"en":"Faithless, false world—embers!”"},{"id":"manas-2010:p1473:b001:l027","ordinal":63564,"en":"The medicine called “Aid,”"},{"id":"manas-2010:p1473:b001:l028","ordinal":63565,"en":"Upon your champion’s head,"},{"id":"manas-2010:p1473:b001:l029","ordinal":63566,"en":"He applied five times in succession."},{"id":"manas-2010:p1473:b001:l030","ordinal":63567,"en":"The medicine called “Remedy,”"},{"id":"manas-2010:p1473:b001:l031","ordinal":63568,"en":"He sprinkled upon it."},{"id":"manas-2010:p1473:b001:l032","ordinal":63569,"en":"After applying so much medicine,"},{"id":"manas-2010:p1473:b001:l033","ordinal":63570,"en":"After drawing out the poison within,"},{"id":"manas-2010:p1473:b001:l034","ordinal":63571,"en":"Blue-maned Sultan Manas’s"},{"id":"manas-2010:p1473:b001:l035","ordinal":63572,"en":"Pain subsided;"},{"id":"manas-2010:p1473:b001:l036","ordinal":63573,"en":"His eyes opened fully awake."},{"id":"manas-2010:p1473:b001:l037","ordinal":63574,"en":"He lacked his former strength;"},{"id":"manas-2010:p1473:b001:l038","ordinal":63575,"en":"His blood diminished, he grew pale."},{"id":"manas-2010:p1473:b001:l039","ordinal":63576,"en":"Even then, Almambet"},{"id":"manas-2010:p1473:b001:l040","ordinal":63577,"en":"Kept treating him every day."},{"id":"manas-2010:p1473:b001:l041","ordinal":63578,"en":"Having lasting road provisions mixed into liquid,"},{"id":"manas-2010:p1473:b001:l042","ordinal":63579,"en":"He had them given as a drink."},{"id":"manas-2010:p1474:b001:l001","ordinal":63580,"en":"Having medicine laid on and tended,"},{"id":"manas-2010:p1474:b001:l002","ordinal":63581,"en":"The rib fat of a young mare"},{"id":"manas-2010:p1474:b001:l003","ordinal":63582,"en":"He had applied to the wound."},{"id":"manas-2010:p1474:b001:l004","ordinal":63583,"en":"Restoring his senses as before,"},{"id":"manas-2010:p1474:b001:l005","ordinal":63584,"en":"He mounted the bloodthirsty one upon a horse."},{"id":"manas-2010:p1474:b001:l006","ordinal":63585,"en":"To tamarisk-lined Keng-Kol,"},{"id":"manas-2010:p1474:b001:l007","ordinal":63586,"en":"To the hollow of broad Talas,"},{"id":"manas-2010:p1474:b001:l008","ordinal":63587,"en":"“Go and see your only child,” he said,"},{"id":"manas-2010:p1474:b001:l009","ordinal":63588,"en":"And sent Khan Manas on his way."},{"id":"manas-2010:p1474:b001:l010","ordinal":63589,"en":"He gave abundant food and provisions;"},{"id":"manas-2010:p1474:b001:l011","ordinal":63590,"en":"As companions for Manas,"},{"id":"manas-2010:p1474:b001:l012","ordinal":63591,"en":"He gave many thousands of troops."},{"id":"manas-2010:p1474:b001:l013","ordinal":63592,"en":"Traveling without sparing the horses,"},{"id":"manas-2010:p1474:b001:l014","ordinal":63593,"en":"Traveling for many days,"},{"id":"manas-2010:p1474:b001:l015","ordinal":63594,"en":"Then Manas, the fierce lion,"},{"id":"manas-2010:p1474:b001:l016","ordinal":63595,"en":"The hawk-like hero thought a thought:"},{"id":"manas-2010:p1474:b001:l017","ordinal":63596,"en":"“Yesterday I had the people"},{"id":"manas-2010:p1474:b001:l018","ordinal":63597,"en":"Say of Beijing in Kakan-Chin,"},{"id":"manas-2010:p1474:b001:l019","ordinal":63598,"en":"‘He has taken it under siege.’"},{"id":"manas-2010:p1474:b001:l020","ordinal":63599,"en":"Now let my people not say,"},{"id":"manas-2010:p1474:b001:l021","ordinal":63600,"en":"The womenfolk and the multitude,"},{"id":"manas-2010:p1474:b001:l022","ordinal":63601,"en":"‘He fled away,’"},{"id":"manas-2010:p1474:b001:l023","ordinal":63602,"en":"Of its gold, silver and gold coins,"},{"id":"manas-2010:p1474:b001:l024","ordinal":63603,"en":"‘He scattered them and left,’"},{"id":"manas-2010:p1474:b001:l025","ordinal":63604,"en":"‘Struck on the head with a battle-axe,"},{"id":"manas-2010:p1474:b001:l026","ordinal":63605,"en":"Afraid of the multitude of Chinese,"},{"id":"manas-2010:p1474:b001:l027","ordinal":63606,"en":"He hurried away.’"},{"id":"manas-2010:p1474:b001:l028","ordinal":63607,"en":"Having gathered my people,"},{"id":"manas-2010:p1474:b001:l029","ordinal":63608,"en":"Having all my multitude"},{"id":"manas-2010:p1474:b001:l030","ordinal":63609,"en":"Slaughtered as far as Mecca,"},{"id":"manas-2010:p1474:b001:l031","ordinal":63610,"en":"Without facing the Chinese,"},{"id":"manas-2010:p1474:b001:l032","ordinal":63611,"en":"How can I simply go!"},{"id":"manas-2010:p1474:b001:l033","ordinal":63612,"en":"If my death has come, let me die;"},{"id":"manas-2010:p1474:b001:l034","ordinal":63613,"en":"The command Allah has ordained,"},{"id":"manas-2010:p1474:b001:l035","ordinal":63614,"en":"If it falls upon my neck, let me endure it!"},{"id":"manas-2010:p1474:b001:l036","ordinal":63615,"en":"Shouting and breaking their ranks,"},{"id":"manas-2010:p1474:b001:l037","ordinal":63616,"en":"If fate comes, struck by a shot,"},{"id":"manas-2010:p1474:b001:l038","ordinal":63617,"en":"Whatever becomes of me, let it be!”"},{"id":"manas-2010:p1474:b001:l039","ordinal":63618,"en":"Saying this, Khan Manas"},{"id":"manas-2010:p1474:b001:l040","ordinal":63619,"en":"Gave orders to the vast host:"},{"id":"manas-2010:p1474:b001:l041","ordinal":63620,"en":"“I have halted here!"},{"id":"manas-2010:p1474:b001:l042","ordinal":63621,"en":"Do not complain, Muslims,"},{"id":"manas-2010:p1475:b001:l001","ordinal":63622,"en":"‘He did not tell us at the start.’"},{"id":"manas-2010:p1475:b001:l002","ordinal":63623,"en":"Whoever says, ‘My horse is thin,’"},{"id":"manas-2010:p1475:b001:l003","ordinal":63624,"en":"I shall have his horse slaughtered now."},{"id":"manas-2010:p1475:b001:l004","ordinal":63625,"en":"Whoever says, ‘I am alone,’"},{"id":"manas-2010:p1475:b001:l005","ordinal":63626,"en":"I shall slaughter and kill him himself!"},{"id":"manas-2010:p1475:b001:l006","ordinal":63627,"en":"Whoever provokes my wrath,"},{"id":"manas-2010:p1475:b001:l007","ordinal":63628,"en":"My common people,"},{"id":"manas-2010:p1475:b001:l008","ordinal":63629,"en":"I shall slaughter without mercy!"},{"id":"manas-2010:p1475:b001:l009","ordinal":63630,"en":"Without regard for your faith,"},{"id":"manas-2010:p1475:b001:l010","ordinal":63631,"en":"I shall treat you worse than the Chinese!”"},{"id":"manas-2010:p1475:b001:l011","ordinal":63632,"en":"Hearing these words from Manas,"},{"id":"manas-2010:p1475:b001:l012","ordinal":63633,"en":"All the standing army heard;"},{"id":"manas-2010:p1475:b001:l013","ordinal":63634,"en":"At the crosswise ridge before them,"},{"id":"manas-2010:p1475:b001:l014","ordinal":63635,"en":"They all dismounted."},{"id":"manas-2010:p1475:b001:l015","ordinal":63636,"en":"The steeds, six by six,"},{"id":"manas-2010:p1475:b001:l016","ordinal":63637,"en":"They had tethered spaced apart."},{"id":"manas-2010:p1475:b001:l017","ordinal":63638,"en":"The experienced mighty army,"},{"id":"manas-2010:p1475:b001:l018","ordinal":63639,"en":"Dividing into sixes and tens,"},{"id":"manas-2010:p1475:b001:l019","ordinal":63640,"en":"Boiled their food."},{"id":"manas-2010:p1475:b001:l020","ordinal":63641,"en":"The champions lay stretched out;"},{"id":"manas-2010:p1475:b001:l021","ordinal":63642,"en":"Their chosen steeds grew restless."},{"id":"manas-2010:p1475:b001:l022","ordinal":63643,"en":"Playing a circle game of kicks, making a din,"},{"id":"manas-2010:p1475:b001:l023","ordinal":63644,"en":"Playing one-legged games, raising dust,"},{"id":"manas-2010:p1475:b001:l024","ordinal":63645,"en":"As though that were not enough, the mighty host"},{"id":"manas-2010:p1475:b001:l025","ordinal":63646,"en":"Set up a knucklebone game,"},{"id":"manas-2010:p1475:b001:l026","ordinal":63647,"en":"Forty young mares each as winnings,"},{"id":"manas-2010:p1475:b001:l027","ordinal":63648,"en":"They staked as prizes."},{"id":"manas-2010:p1475:b001:l028","ordinal":63649,"en":"Shooting wild asses from the hills,"},{"id":"manas-2010:p1475:b001:l029","ordinal":63650,"en":"Pursuing wild ewes and rams,"},{"id":"manas-2010:p1475:b001:l030","ordinal":63651,"en":"They immersed themselves in amusement."},{"id":"manas-2010:p1475:b001:l031","ordinal":63652,"en":"Tethering their steeds crosswise,"},{"id":"manas-2010:p1475:b001:l032","ordinal":63653,"en":"“If the multitude of Chinese comes,"},{"id":"manas-2010:p1475:b001:l033","ordinal":63654,"en":"What will become of the bloodthirsty one?” they said."},{"id":"manas-2010:p1475:b001:l034","ordinal":63655,"en":"Building a line of stone defenses,"},{"id":"manas-2010:p1475:b001:l035","ordinal":63656,"en":"Holding the surroundings firmly,"},{"id":"manas-2010:p1475:b001:l036","ordinal":63657,"en":"All alike bustling,"},{"id":"manas-2010:p1475:b001:l037","ordinal":63658,"en":"Preparing for the enemy’s work,"},{"id":"manas-2010:p1475:b001:l038","ordinal":63659,"en":"The mighty host encamped."},{"id":"manas-2010:p1475:b001:l039","ordinal":63660,"en":"Where the marksmen would stand,"},{"id":"manas-2010:p1475:b001:l040","ordinal":63661,"en":"They placed stones in front;"},{"id":"manas-2010:p1475:b001:l041","ordinal":63662,"en":"For the skilled spearmen,"},{"id":"manas-2010:p1475:b001:l042","ordinal":63663,"en":"They chose an open plain."},{"id":"manas-2010:p1476:b001:l001","ordinal":63664,"en":"For the mighty wielders of battle-axes,"},{"id":"manas-2010:p1476:b001:l002","ordinal":63665,"en":"They selected hilly ground;"},{"id":"manas-2010:p1476:b001:l003","ordinal":63666,"en":"For the formidable swordsmen,"},{"id":"manas-2010:p1476:b001:l004","ordinal":63667,"en":"Where no plow had made a furrow,"},{"id":"manas-2010:p1476:b001:l005","ordinal":63668,"en":"Where no marmot had dug a burrow,"},{"id":"manas-2010:p1476:b001:l006","ordinal":63669,"en":"The moon-like sandy plain,"},{"id":"manas-2010:p1476:b001:l007","ordinal":63670,"en":"They marked that out."},{"id":"manas-2010:p1476:b001:l008","ordinal":63671,"en":"Placing Manas in the middle,"},{"id":"manas-2010:p1476:b001:l009","ordinal":63672,"en":"They strengthened those defenses,"},{"id":"manas-2010:p1476:b001:l010","ordinal":63673,"en":"Appointed their guards,"},{"id":"manas-2010:p1476:b001:l011","ordinal":63674,"en":"Made their scouts alert."},{"id":"manas-2010:p1476:b001:l012","ordinal":63675,"en":"Then, to Beijing,"},{"id":"manas-2010:p1476:b001:l013","ordinal":63676,"en":"To the place where Manas stood,"},{"id":"manas-2010:p1476:b001:l014","ordinal":63677,"en":"The great army, the multitude of Chinese,"},{"id":"manas-2010:p1476:b001:l015","ordinal":63678,"en":"With Kongurbay at their head,"},{"id":"manas-2010:p1476:b001:l016","ordinal":63679,"en":"Arrived in teeming ranks,"},{"id":"manas-2010:p1476:b001:l017","ordinal":63680,"en":"At the city where Manas lay."},{"id":"manas-2010:p1476:b001:l018","ordinal":63681,"en":"They enclosed it in ten rings."},{"id":"manas-2010:p1476:b001:l019","ordinal":63682,"en":"When the Chinese swarmed in,"},{"id":"manas-2010:p1476:b001:l020","ordinal":63683,"en":"Where Chubak had mounted the throne as khan,"},{"id":"manas-2010:p1476:b001:l021","ordinal":63684,"en":"The Muslim army"},{"id":"manas-2010:p1476:b001:l022","ordinal":63685,"en":"Was making merry,"},{"id":"manas-2010:p1476:b001:l023","ordinal":63686,"en":"Was feasting then."},{"id":"manas-2010:p1476:b001:l024","ordinal":63687,"en":"Without preparing a hero’s weapons,"},{"id":"manas-2010:p1476:b001:l025","ordinal":63688,"en":"Without readying for an enemy’s coming,"},{"id":"manas-2010:p1476:b001:l026","ordinal":63689,"en":"Almambet, Azizkan’s son,"},{"id":"manas-2010:p1476:b001:l027","ordinal":63690,"en":"Was lying unaware then."},{"id":"manas-2010:p1476:b001:l028","ordinal":63691,"en":"From the gilded doorway,"},{"id":"manas-2010:p1476:b001:l029","ordinal":63692,"en":"Of Esenkan’s palace,"},{"id":"manas-2010:p1476:b001:l030","ordinal":63693,"en":"Through a shaded opening,"},{"id":"manas-2010:p1476:b001:l031","ordinal":63694,"en":"As Almambet looked,"},{"id":"manas-2010:p1476:b001:l032","ordinal":63695,"en":"The Chinese girls,"},{"id":"manas-2010:p1476:b001:l033","ordinal":63696,"en":"Running two by two,"},{"id":"manas-2010:p1476:b001:l034","ordinal":63697,"en":"All alike rejoicing,"},{"id":"manas-2010:p1476:b001:l035","ordinal":63698,"en":"Matched their steps;"},{"id":"manas-2010:p1476:b001:l036","ordinal":63699,"en":"All alike took counsel."},{"id":"manas-2010:p1476:b001:l037","ordinal":63700,"en":"“The Burut’s khan Manas,"},{"id":"manas-2010:p1476:b001:l038","ordinal":63701,"en":"Kongurbay, lying hidden,"},{"id":"manas-2010:p1476:b001:l039","ordinal":63702,"en":"Struck with a battle-axe, they say."},{"id":"manas-2010:p1476:b001:l040","ordinal":63703,"en":"When he was about to die,"},{"id":"manas-2010:p1476:b001:l041","ordinal":63704,"en":"Manas fled to Talas, they say."},{"id":"manas-2010:p1476:b001:l042","ordinal":63705,"en":"The Chinese army is gathering, they say;"},{"id":"manas-2010:p1477:b001:l001","ordinal":63706,"en":"Today or tomorrow, elder sister,"},{"id":"manas-2010:p1477:b001:l002","ordinal":63707,"en":"Facing the Burut,"},{"id":"manas-2010:p1477:b001:l003","ordinal":63708,"en":"There will be a slaughtering battle, she says."},{"id":"manas-2010:p1477:b001:l004","ordinal":63709,"en":"Why should we stay here?"},{"id":"manas-2010:p1477:b001:l005","ordinal":63710,"en":"Let us get home early!”"},{"id":"manas-2010:p1477:b001:l006","ordinal":63711,"en":"Hearing this, Almambet"},{"id":"manas-2010:p1477:b001:l007","ordinal":63712,"en":"Was astonished at what she said;"},{"id":"manas-2010:p1477:b001:l008","ordinal":63713,"en":"He prepared to face the enemy,"},{"id":"manas-2010:p1477:b001:l009","ordinal":63714,"en":"Sending word to his people,"},{"id":"manas-2010:p1477:b001:l010","ordinal":63715,"en":"To all the Muslims."},{"id":"manas-2010:p1477:b001:l011","ordinal":63716,"en":"When they heard these words,"},{"id":"manas-2010:p1477:b001:l012","ordinal":63717,"en":"The forty companions, wolves of war,"},{"id":"manas-2010:p1477:b001:l013","ordinal":63718,"en":"To Almambet’s side"},{"id":"manas-2010:p1477:b001:l014","ordinal":63719,"en":"All came gathering:"},{"id":"manas-2010:p1477:b001:l015","ordinal":63720,"en":"“Valiant Almam, my sultan,"},{"id":"manas-2010:p1477:b001:l016","ordinal":63721,"en":"You have grown wrathful."},{"id":"manas-2010:p1477:b001:l017","ordinal":63722,"en":"Is there a mountain you cannot cross?"},{"id":"manas-2010:p1477:b001:l018","ordinal":63723,"en":"Is there an enemy lying in wait?"},{"id":"manas-2010:p1477:b001:l019","ordinal":63724,"en":"Is there misfortune boiling up?"},{"id":"manas-2010:p1477:b001:l020","ordinal":63725,"en":"Bellowing their battle cry,"},{"id":"manas-2010:p1477:b001:l021","ordinal":63726,"en":"Is a Chinese army sweeping upon us?”"},{"id":"manas-2010:p1477:b001:l022","ordinal":63727,"en":"When the companions said this,"},{"id":"manas-2010:p1477:b001:l023","ordinal":63728,"en":"Azizkan's Almambet"},{"id":"manas-2010:p1477:b001:l024","ordinal":63729,"en":"Spoke these words:"},{"id":"manas-2010:p1477:b001:l025","ordinal":63730,"en":"“My lions, forty fierce companions,"},{"id":"manas-2010:p1477:b001:l026","ordinal":63731,"en":"Untouched even by the venerable Ali,"},{"id":"manas-2010:p1477:b001:l027","ordinal":63732,"en":"This is the tormenting land of Beijing;"},{"id":"manas-2010:p1477:b001:l028","ordinal":63733,"en":"Letting no living soul escape,"},{"id":"manas-2010:p1477:b001:l029","ordinal":63734,"en":"These are the fierce Chinese people!"},{"id":"manas-2010:p1477:b001:l030","ordinal":63735,"en":"Knowing their nature from the beginning,"},{"id":"manas-2010:p1477:b001:l031","ordinal":63736,"en":"I am the one who kept silent!"},{"id":"manas-2010:p1477:b001:l032","ordinal":63737,"en":"Against the countless Chinese and Manchus,"},{"id":"manas-2010:p1477:b001:l033","ordinal":63738,"en":"God knows whether we shall die"},{"id":"manas-2010:p1477:b001:l034","ordinal":63739,"en":"Or survive without dying."},{"id":"manas-2010:p1477:b001:l035","ordinal":63740,"en":"Will not one whose time has come die?"},{"id":"manas-2010:p1477:b001:l036","ordinal":63741,"en":"Will not one suffer if suffering is his lot?"},{"id":"manas-2010:p1477:b001:l037","ordinal":63742,"en":"The decree the Lord has sent—"},{"id":"manas-2010:p1477:b001:l038","ordinal":63743,"en":"If it is thus, let us face it;"},{"id":"manas-2010:p1477:b001:l039","ordinal":63744,"en":"In Kakan-Chin's Beijing,"}]
