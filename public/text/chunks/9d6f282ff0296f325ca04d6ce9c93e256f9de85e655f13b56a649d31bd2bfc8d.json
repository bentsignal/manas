[{"id":"manas-2010:p0811:b001:l024","ordinal":35841,"en":"Make cattle of your white deer,"},{"id":"manas-2010:p0811:b001:l025","ordinal":35842,"en":"Herd them off in a rout!"},{"id":"manas-2010:p0811:b001:l026","ordinal":35843,"en":"I have much to say, if I tell it."},{"id":"manas-2010:p0811:b001:l027","ordinal":35844,"en":"The blood-drinker has a grievance against you."},{"id":"manas-2010:p0811:b001:l028","ordinal":35845,"en":"The reason for his grievance:"},{"id":"manas-2010:p0811:b001:l029","ordinal":35846,"en":"Those inhabiting broad Alay,"},{"id":"manas-2010:p0811:b001:l030","ordinal":35847,"en":"The people there called Noygut."},{"id":"manas-2010:p0811:b001:l031","ordinal":35848,"en":"Taking twelve hosts of ten thousand,"},{"id":"manas-2010:p0811:b001:l032","ordinal":35849,"en":"You devastated the Noygut,"},{"id":"manas-2010:p0811:b001:l033","ordinal":35850,"en":"Wrecked their lives,"},{"id":"manas-2010:p0811:b001:l034","ordinal":35851,"en":"And made yourself a warrior."},{"id":"manas-2010:p0811:b001:l035","ordinal":35852,"en":"Did those Noygut in Alay"},{"id":"manas-2010:p0811:b001:l036","ordinal":35853,"en":"Carry off your piebald horse?"},{"id":"manas-2010:p0811:b001:l037","ordinal":35854,"en":"Did they scatter your silver coins and goods?"},{"id":"manas-2010:p0811:b001:l038","ordinal":35855,"en":"If they did not chase your wild asses away,"},{"id":"manas-2010:p0811:b001:l039","ordinal":35856,"en":"If they did not scatter the goods in your saddlebags,"},{"id":"manas-2010:p0811:b001:l040","ordinal":35857,"en":"You attacked a guiltless people,"},{"id":"manas-2010:p0811:b001:l041","ordinal":35858,"en":"Entangled your own head in trouble."},{"id":"manas-2010:p0811:b001:l042","ordinal":35859,"en":"Oh, Khan Shooruk, now you"},{"id":"manas-2010:p0812:b001:l001","ordinal":35860,"en":"Will understand plain words."},{"id":"manas-2010:p0812:b001:l002","ordinal":35861,"en":"If you glare and quarrel,"},{"id":"manas-2010:p0812:b001:l003","ordinal":35862,"en":"You will wear the Noygut's coat."},{"id":"manas-2010:p0812:b001:l004","ordinal":35863,"en":"You pounded them like meal, struck them like stones."},{"id":"manas-2010:p0812:b001:l005","ordinal":35864,"en":"Upon the Noygut, simply,"},{"id":"manas-2010:p0812:b001:l006","ordinal":35865,"en":"You heaped bitter humiliation."},{"id":"manas-2010:p0812:b001:l007","ordinal":35866,"en":"Breaking their lattice walls and roof poles,"},{"id":"manas-2010:p0812:b001:l008","ordinal":35867,"en":"Making their brides and daughters weep—"},{"id":"manas-2010:p0812:b001:l009","ordinal":35868,"en":"Can strife be a simple thing?"},{"id":"manas-2010:p0812:b001:l010","ordinal":35869,"en":"You stirred up terrible strife."},{"id":"manas-2010:p0812:b001:l011","ordinal":35870,"en":"Destroying a guiltless people,"},{"id":"manas-2010:p0812:b001:l012","ordinal":35871,"en":"You showed how formidable you are."},{"id":"manas-2010:p0812:b001:l013","ordinal":35872,"en":"Through this, around your neck"},{"id":"manas-2010:p0812:b001:l014","ordinal":35873,"en":"Disgrace has been hung."},{"id":"manas-2010:p0812:b001:l015","ordinal":35874,"en":"To slaughter your people, leaving none,"},{"id":"manas-2010:p0812:b001:l016","ordinal":35875,"en":"To do whatever he sees fit,"},{"id":"manas-2010:p0812:b001:l017","ordinal":35876,"en":"He stands ready, straining to go:"},{"id":"manas-2010:p0812:b001:l018","ordinal":35877,"en":"I have my leopard, the lion Manas."},{"id":"manas-2010:p0812:b001:l019","ordinal":35878,"en":"If you truly are a khan,"},{"id":"manas-2010:p0812:b001:l020","ordinal":35879,"en":"Look at me, you Shooruk;"},{"id":"manas-2010:p0812:b001:l021","ordinal":35880,"en":"I have words to tell you."},{"id":"manas-2010:p0812:b001:l022","ordinal":35881,"en":"The words that I speak—"},{"id":"manas-2010:p0812:b001:l023","ordinal":35882,"en":"Do you understand them, Shooruk?"},{"id":"manas-2010:p0812:b001:l024","ordinal":35883,"en":"Into the Muslim faith—"},{"id":"manas-2010:p0812:b001:l025","ordinal":35884,"en":"Will you enter it, Shooruk?"},{"id":"manas-2010:p0812:b001:l026","ordinal":35885,"en":"Be cleansed of the dark religion;"},{"id":"manas-2010:p0812:b001:l027","ordinal":35886,"en":"Flee the unbelievers and become their stranger."},{"id":"manas-2010:p0812:b001:l028","ordinal":35887,"en":"Scatter everything you have gathered;"},{"id":"manas-2010:p0812:b001:l029","ordinal":35888,"en":"Seek faith alone."},{"id":"manas-2010:p0812:b001:l030","ordinal":35889,"en":"A faithful person is a warrior;"},{"id":"manas-2010:p0812:b001:l031","ordinal":35890,"en":"The road to Judgment is difficult,"},{"id":"manas-2010:p0812:b001:l032","ordinal":35891,"en":"Your faith is closer than your worldly goods."},{"id":"manas-2010:p0812:b001:l033","ordinal":35892,"en":"My words are wise counsel."},{"id":"manas-2010:p0812:b001:l034","ordinal":35893,"en":"On going to the hereafter,"},{"id":"manas-2010:p0812:b001:l035","ordinal":35894,"en":"A faithless person is a miser."},{"id":"manas-2010:p0812:b001:l036","ordinal":35895,"en":"Cast away sorrow and care;"},{"id":"manas-2010:p0812:b001:l037","ordinal":35896,"en":"Seek and know the one God."},{"id":"manas-2010:p0812:b001:l038","ordinal":35897,"en":"Learn faith from me."},{"id":"manas-2010:p0812:b001:l039","ordinal":35898,"en":"These words I now speak—"},{"id":"manas-2010:p0812:b001:l040","ordinal":35899,"en":"Why not understand them, Khan Shooruk?"},{"id":"manas-2010:p0812:b001:l041","ordinal":35900,"en":"Saying, “In the name of God,”"},{"id":"manas-2010:p0812:b001:l042","ordinal":35901,"en":"Into the Muslim heart—"},{"id":"manas-2010:p0813:b001:l001","ordinal":35902,"en":"Why not enter, Khan Shooruk?"},{"id":"manas-2010:p0813:b001:l002","ordinal":35903,"en":"Let your hoarded goods scatter over the fields;"},{"id":"manas-2010:p0813:b001:l003","ordinal":35904,"en":"May your faith be accepted."},{"id":"manas-2010:p0813:b001:l004","ordinal":35905,"en":"Let me tell you all I know,"},{"id":"manas-2010:p0813:b001:l005","ordinal":35906,"en":"So your suffering is not on my conscience."},{"id":"manas-2010:p0813:b001:l006","ordinal":35907,"en":"If you do not turn your efforts to religion,"},{"id":"manas-2010:p0813:b001:l007","ordinal":35908,"en":"If you do not heed these words,"},{"id":"manas-2010:p0813:b001:l008","ordinal":35909,"en":"Your own guilt be upon you,"},{"id":"manas-2010:p0813:b001:l009","ordinal":35910,"en":"Your suffering upon your own black crown!"},{"id":"manas-2010:p0813:b001:l010","ordinal":35911,"en":"Crushing all when he charges—"},{"id":"manas-2010:p0813:b001:l011","ordinal":35912,"en":"There is Khan Manas the blood-drinker."},{"id":"manas-2010:p0813:b001:l012","ordinal":35913,"en":"Finding the word at an unforeseen moment—"},{"id":"manas-2010:p0813:b001:l013","ordinal":35914,"en":"There is also leopard Bakay."},{"id":"manas-2010:p0813:b001:l014","ordinal":35915,"en":"The mighty ones among the forty companions—"},{"id":"manas-2010:p0813:b001:l015","ordinal":35916,"en":"If their formidable Manas shouts,"},{"id":"manas-2010:p0813:b001:l016","ordinal":35917,"en":"Leaving not the smallest thing of yours,"},{"id":"manas-2010:p0813:b001:l017","ordinal":35918,"en":"Destroying and slaughtering as they go—"},{"id":"manas-2010:p0813:b001:l018","ordinal":35919,"en":"He has his forty companions too."},{"id":"manas-2010:p0813:b001:l019","ordinal":35920,"en":"All the forty companions,"},{"id":"manas-2010:p0813:b001:l020","ordinal":35921,"en":"Their elders led by Kyrgyl."},{"id":"manas-2010:p0813:b001:l021","ordinal":35922,"en":"Reared in war, thrusting spears—"},{"id":"manas-2010:p0813:b001:l022","ordinal":35923,"en":"There are skillful companions too."},{"id":"manas-2010:p0813:b001:l023","ordinal":35924,"en":"Each alone worth a vast army—"},{"id":"manas-2010:p0813:b001:l024","ordinal":35925,"en":"There are mighty companions too."},{"id":"manas-2010:p0813:b001:l025","ordinal":35926,"en":"Springing like blue tigers,"},{"id":"manas-2010:p0813:b001:l026","ordinal":35927,"en":"There are companions who strike men down;"},{"id":"manas-2010:p0813:b001:l027","ordinal":35928,"en":"Leaving none they pierce unharmed,"},{"id":"manas-2010:p0813:b001:l028","ordinal":35929,"en":"Upon your head confusion—"},{"id":"manas-2010:p0813:b001:l029","ordinal":35930,"en":"There are companions to bring it."},{"id":"manas-2010:p0813:b001:l030","ordinal":35931,"en":"The mounts of the forty companions"},{"id":"manas-2010:p0813:b001:l031","ordinal":35932,"en":"Are all winged steeds."},{"id":"manas-2010:p0813:b001:l032","ordinal":35933,"en":"The whole wide world, the forty companions"},{"id":"manas-2010:p0813:b001:l033","ordinal":35934,"en":"Are accustomed to conquering."},{"id":"manas-2010:p0813:b001:l034","ordinal":35935,"en":"If the forty companions charge in,"},{"id":"manas-2010:p0813:b001:l035","ordinal":35936,"en":"How could the enemy prosper?"},{"id":"manas-2010:p0813:b001:l036","ordinal":35937,"en":"If you do not accept these words,"},{"id":"manas-2010:p0813:b001:l037","ordinal":35938,"en":"All your people will disappear."},{"id":"manas-2010:p0813:b001:l038","ordinal":35939,"en":"Make yourself a Muslim,"},{"id":"manas-2010:p0813:b001:l039","ordinal":35940,"en":"Meet him beforehand and bargain."},{"id":"manas-2010:p0813:b001:l040","ordinal":35941,"en":"Thimble-mouthed, camel-eyed,"},{"id":"manas-2010:p0813:b001:l041","ordinal":35942,"en":"From among your swaying daughters,"},{"id":"manas-2010:p0813:b001:l042","ordinal":35943,"en":"Make a gift to Khan Manas!"},{"id":"manas-2010:p0814:b001:l001","ordinal":35944,"en":"If you have the heart to exchange fire,"},{"id":"manas-2010:p0814:b001:l002","ordinal":35945,"en":"Tell us the strength you rely on,"},{"id":"manas-2010:p0814:b001:l003","ordinal":35946,"en":"Tell us the place you have fortified."},{"id":"manas-2010:p0814:b001:l004","ordinal":35947,"en":"If you will fight, tell us your forces;"},{"id":"manas-2010:p0814:b001:l005","ordinal":35948,"en":"Answer without groaning!"},{"id":"manas-2010:p0814:b001:l006","ordinal":35949,"en":"If you have the heart to grapple,"},{"id":"manas-2010:p0814:b001:l007","ordinal":35950,"en":"Choose your swift horse and come out."},{"id":"manas-2010:p0814:b001:l008","ordinal":35951,"en":"If you have the heart to contend,"},{"id":"manas-2010:p0814:b001:l009","ordinal":35952,"en":"Ready your warriors and come out!’"},{"id":"manas-2010:p0814:b001:l010","ordinal":35953,"en":"Every sign of Manas"},{"id":"manas-2010:p0814:b001:l011","ordinal":35954,"en":"Azhybay described."},{"id":"manas-2010:p0814:b001:l012","ordinal":35955,"en":"At Azhybay's words,"},{"id":"manas-2010:p0814:b001:l013","ordinal":35956,"en":"That Khan Shooruk marveled."},{"id":"manas-2010:p0814:b001:l014","ordinal":35957,"en":"A tower built of iron—"},{"id":"manas-2010:p0814:b001:l015","ordinal":35958,"en":"Do not ask how high it was!"},{"id":"manas-2010:p0814:b001:l016","ordinal":35959,"en":"His knees bent to the ground,"},{"id":"manas-2010:p0814:b001:l017","ordinal":35960,"en":"He descended from his throne and ran,"},{"id":"manas-2010:p0814:b001:l018","ordinal":35961,"en":"Now climbing up the tower."},{"id":"manas-2010:p0814:b001:l019","ordinal":35962,"en":"When he looked out from the tower,"},{"id":"manas-2010:p0814:b001:l020","ordinal":35963,"en":"Wishing his people safety,"},{"id":"manas-2010:p0814:b001:l021","ordinal":35964,"en":"The sight unsettled his heart."},{"id":"manas-2010:p0814:b001:l022","ordinal":35965,"en":"Mounted on a horse like Akkula,"},{"id":"manas-2010:p0814:b001:l023","ordinal":35966,"en":"Fierce in his majesty, potent in his wrath,"},{"id":"manas-2010:p0814:b001:l024","ordinal":35967,"en":"A formidable man appeared."},{"id":"manas-2010:p0814:b001:l025","ordinal":35968,"en":"His protector was Kozhosan,"},{"id":"manas-2010:p0814:b001:l026","ordinal":35969,"en":"The forty hidden saints lent him their hands."},{"id":"manas-2010:p0814:b001:l027","ordinal":35970,"en":"His fortune was complete;"},{"id":"manas-2010:p0814:b001:l028","ordinal":35971,"en":"He was a lion protected by Shay."},{"id":"manas-2010:p0814:b001:l029","ordinal":35972,"en":"His right shoulder was broad;"},{"id":"manas-2010:p0814:b001:l030","ordinal":35973,"en":"He was a lion who would shatter the Oirat."},{"id":"manas-2010:p0814:b001:l031","ordinal":35974,"en":"On his head a black hat big as a cauldron;"},{"id":"manas-2010:p0814:b001:l032","ordinal":35975,"en":"With the whole wide world"},{"id":"manas-2010:p0814:b001:l033","ordinal":35976,"en":"He could do as he pleased."},{"id":"manas-2010:p0814:b001:l034","ordinal":35977,"en":"He was utterly accomplished."},{"id":"manas-2010:p0814:b001:l035","ordinal":35978,"en":"Among round-headed mortals,"},{"id":"manas-2010:p0814:b001:l036","ordinal":35979,"en":"Such a being could indeed exist."},{"id":"manas-2010:p0814:b001:l037","ordinal":35980,"en":"Khan Shooruk saw and marveled:"},{"id":"manas-2010:p0814:b001:l038","ordinal":35981,"en":"‘Under what circumstances was he born?"},{"id":"manas-2010:p0814:b001:l039","ordinal":35982,"en":"This ill-omened Manas—"},{"id":"manas-2010:p0814:b001:l040","ordinal":35983,"en":"If one attacks him, he brings an uproar."},{"id":"manas-2010:p0814:b001:l041","ordinal":35984,"en":"He is a lion touched by Kydyr;"},{"id":"manas-2010:p0814:b001:l042","ordinal":35985,"en":"The forty lords beside him—"},{"id":"manas-2010:p0815:b001:l001","ordinal":35986,"en":"All forty are equal to a hair."},{"id":"manas-2010:p0815:b001:l002","ordinal":35987,"en":"Blue-maned Manas, all of them,"},{"id":"manas-2010:p0815:b001:l003","ordinal":35988,"en":"Their elder, warrior Bakay—"},{"id":"manas-2010:p0815:b001:l004","ordinal":35989,"en":"All stand side by side as equals,"},{"id":"manas-2010:p0815:b001:l005","ordinal":35990,"en":"All the forty companions."},{"id":"manas-2010:p0815:b001:l006","ordinal":35991,"en":"Front teeth like a doorway,"},{"id":"manas-2010:p0815:b001:l007","ordinal":35992,"en":"Teeth unlike other people's:"},{"id":"manas-2010:p0815:b001:l008","ordinal":35993,"en":"When he clenches those great teeth,"},{"id":"manas-2010:p0815:b001:l009","ordinal":35994,"en":"They crumble like millet."},{"id":"manas-2010:p0815:b001:l010","ordinal":35995,"en":"Blue flame issuing from his mouth"},{"id":"manas-2010:p0815:b001:l011","ordinal":35996,"en":"Simply surges forth,"},{"id":"manas-2010:p0815:b001:l012","ordinal":35997,"en":"Hissing a spear's length."},{"id":"manas-2010:p0815:b001:l013","ordinal":35998,"en":"If Azhybay gave the signal,"},{"id":"manas-2010:p0815:b001:l014","ordinal":35999,"en":"They would sweep forward,"},{"id":"manas-2010:p0815:b001:l015","ordinal":36000,"en":"Leaving not one unharmed,"},{"id":"manas-2010:p0815:b001:l016","ordinal":36001,"en":"Slaughtering as they passed."},{"id":"manas-2010:p0815:b001:l017","ordinal":36002,"en":"Girded with a silver belt,"},{"id":"manas-2010:p0815:b001:l018","ordinal":36003,"en":"The thundering sultan's"},{"id":"manas-2010:p0815:b001:l019","ordinal":36004,"en":"Sunlike face is struck by radiance."},{"id":"manas-2010:p0815:b001:l020","ordinal":36005,"en":"He is a champion and a lion,"},{"id":"manas-2010:p0815:b001:l021","ordinal":36006,"en":"The whole world—"},{"id":"manas-2010:p0815:b001:l022","ordinal":36007,"en":"He is a warrior who will conquer it."},{"id":"manas-2010:p0815:b001:l023","ordinal":36008,"en":"Let me accept his words;"},{"id":"manas-2010:p0815:b001:l024","ordinal":36009,"en":"Without a needless slaughter,"},{"id":"manas-2010:p0815:b001:l025","ordinal":36010,"en":"The blood-drinker with a wolf’s path—"},{"id":"manas-2010:p0815:b001:l026","ordinal":36011,"en":"Let me give whatever he desires!’"},{"id":"manas-2010:p0815:b001:l027","ordinal":36012,"en":"When he saw Manas's wrath,"},{"id":"manas-2010:p0815:b001:l028","ordinal":36013,"en":"His senses began to fail."},{"id":"manas-2010:p0815:b001:l029","ordinal":36014,"en":"From the tower Khan Shooruk"},{"id":"manas-2010:p0815:b001:l030","ordinal":36015,"en":"Nearly tumbled down."},{"id":"manas-2010:p0815:b001:l031","ordinal":36016,"en":"When he saw the blood-drinking warrior,"},{"id":"manas-2010:p0815:b001:l032","ordinal":36017,"en":"The strength left his wrist,"},{"id":"manas-2010:p0815:b001:l033","ordinal":36018,"en":"The covering left his heart."},{"id":"manas-2010:p0815:b001:l034","ordinal":36019,"en":"When he looked this way,"},{"id":"manas-2010:p0815:b001:l035","ordinal":36020,"en":"Accompanying the blood-drinker"},{"id":"manas-2010:p0815:b001:l036","ordinal":36021,"en":"Were Kozhoy and Kydyr together."},{"id":"manas-2010:p0815:b001:l037","ordinal":36022,"en":"His dun horse pranced,"},{"id":"manas-2010:p0815:b001:l038","ordinal":36023,"en":"Led by twelve companions."},{"id":"manas-2010:p0815:b001:l039","ordinal":36024,"en":"Looking then,"},{"id":"manas-2010:p0815:b001:l040","ordinal":36025,"en":"Your warrior, Khan Shooruk,"},{"id":"manas-2010:p0815:b001:l041","ordinal":36026,"en":"Having seen Manas,"},{"id":"manas-2010:p0815:b001:l042","ordinal":36027,"en":"Had no strength to utter ‘Ah,’"},{"id":"manas-2010:p0816:b001:l001","ordinal":36028,"en":"No sense left to utter ‘Eh,’"},{"id":"manas-2010:p0816:b001:l002","ordinal":36029,"en":"And came down from his throne."},{"id":"manas-2010:p0816:b001:l003","ordinal":36030,"en":"To the warrior Azhybay:"},{"id":"manas-2010:p0816:b001:l004","ordinal":36031,"en":"‘I agree, my Azhy, I agree!’"},{"id":"manas-2010:p0816:b001:l005","ordinal":36032,"en":"Khan Shooruk recited the creed:"},{"id":"manas-2010:p0816:b001:l006","ordinal":36033,"en":"‘I have become a Muslim,’ he said."},{"id":"manas-2010:p0816:b001:l007","ordinal":36034,"en":"Your blue-maned warrior had besieged"},{"id":"manas-2010:p0816:b001:l008","ordinal":36035,"en":"Khan Shooruk's city;"},{"id":"manas-2010:p0816:b001:l009","ordinal":36036,"en":"Now he had encamped there."},{"id":"manas-2010:p0816:b001:l010","ordinal":36037,"en":"A true Muslim, that Shooruk"},{"id":"manas-2010:p0816:b001:l011","ordinal":36038,"en":"Had now become."},{"id":"manas-2010:p0816:b001:l012","ordinal":36039,"en":"Cleansed of the dark religion,"},{"id":"manas-2010:p0816:b001:l013","ordinal":36040,"en":"Fleeing the unbelievers, becoming their stranger,"},{"id":"manas-2010:p0816:b001:l014","ordinal":36041,"en":"The faith within his breast"},{"id":"manas-2010:p0816:b001:l015","ordinal":36042,"en":"Had now filled it completely."},{"id":"manas-2010:p0816:b001:l016","ordinal":36043,"en":"The devastating sultan Manas"},{"id":"manas-2010:p0816:b001:l017","ordinal":36044,"en":"Thus showed his lion prowess,"},{"id":"manas-2010:p0816:b001:l018","ordinal":36045,"en":"Of Shooruk’s city with its palace,"},{"id":"manas-2010:p0816:b001:l019","ordinal":36046,"en":"He brought the khan into the faith,"},{"id":"manas-2010:p0816:b001:l020","ordinal":36047,"en":"Leaving none of his people out,"},{"id":"manas-2010:p0816:b001:l021","ordinal":36048,"en":"Bringing them all into the faith."},{"id":"manas-2010:p0816:b001:l022","ordinal":36049,"en":"‘We submit!’ they cried,"},{"id":"manas-2010:p0816:b001:l023","ordinal":36050,"en":"All beginning to speak."},{"id":"manas-2010:p0816:b001:l024","ordinal":36051,"en":"Before Azhybay,"},{"id":"manas-2010:p0816:b001:l025","ordinal":36052,"en":"Swords, guns, every weapon—"},{"id":"manas-2010:p0816:b001:l026","ordinal":36053,"en":"They gathered and cast them all down."},{"id":"manas-2010:p0816:b001:l027","ordinal":36054,"en":"He looked and nearly lost his life;"},{"id":"manas-2010:p0816:b001:l028","ordinal":36055,"en":"Khan Shooruk, terrified,"},{"id":"manas-2010:p0816:b001:l029","ordinal":36056,"en":"Poured out words to Azhybay:"},{"id":"manas-2010:p0816:b001:l030","ordinal":36057,"en":"‘Oh, Azhybay, my sultan,"},{"id":"manas-2010:p0816:b001:l031","ordinal":36058,"en":"If you will reign upon the throne,"},{"id":"manas-2010:p0816:b001:l032","ordinal":36059,"en":"Here are the people of a city with a palace."},{"id":"manas-2010:p0816:b001:l033","ordinal":36060,"en":"If you will devastate me,"},{"id":"manas-2010:p0816:b001:l034","ordinal":36061,"en":"Here am I, devastating Shooruk!"},{"id":"manas-2010:p0816:b001:l035","ordinal":36062,"en":"Here is a royal city and its land;"},{"id":"manas-2010:p0816:b001:l036","ordinal":36063,"en":"If you will take my head, here am I!"},{"id":"manas-2010:p0816:b001:l037","ordinal":36064,"en":"My women, my beauties,"},{"id":"manas-2010:p0816:b001:l038","ordinal":36065,"en":"My precious, beautiful daughters,"},{"id":"manas-2010:p0816:b001:l039","ordinal":36066,"en":"Leaving none, root and all,"},{"id":"manas-2010:p0816:b001:l040","ordinal":36067,"en":"I shall give them all to you."},{"id":"manas-2010:p0816:b001:l041","ordinal":36068,"en":"Do not dig my pit deep:"},{"id":"manas-2010:p0816:b001:l042","ordinal":36069,"en":"Go and tell him, “He has submitted”;"},{"id":"manas-2010:p0817:b001:l001","ordinal":36070,"en":"Do not send your troops sweeping in!"},{"id":"manas-2010:p0817:b001:l002","ordinal":36071,"en":"I have beauties to offer,"},{"id":"manas-2010:p0817:b001:l003","ordinal":36072,"en":"Thimble-mouthed, camel-eyed,"},{"id":"manas-2010:p0817:b001:l004","ordinal":36073,"en":"Swaying, dark-eyed,"},{"id":"manas-2010:p0817:b001:l005","ordinal":36074,"en":"With my Akylay at their head:"},{"id":"manas-2010:p0817:b001:l006","ordinal":36075,"en":"I have eighty beautiful daughters."},{"id":"manas-2010:p0817:b001:l007","ordinal":36076,"en":"Let me accept your words,"},{"id":"manas-2010:p0817:b001:l008","ordinal":36077,"en":"Let me give my daughters as gifts."},{"id":"manas-2010:p0817:b001:l009","ordinal":36078,"en":"My many Kalcha, my populous nation,"},{"id":"manas-2010:p0817:b001:l010","ordinal":36079,"en":"Let me give them with my people."},{"id":"manas-2010:p0817:b001:l011","ordinal":36080,"en":"Everything you wish for,"},{"id":"manas-2010:p0817:b001:l012","ordinal":36081,"en":"Let me lay it before you."},{"id":"manas-2010:p0817:b001:l013","ordinal":36082,"en":"Let me send word to my people."},{"id":"manas-2010:p0817:b001:l014","ordinal":36083,"en":"If you wish, over my people"},{"id":"manas-2010:p0817:b001:l015","ordinal":36084,"en":"Your leopard Manas—"},{"id":"manas-2010:p0817:b001:l016","ordinal":36085,"en":"Let me raise him as khan."},{"id":"manas-2010:p0817:b001:l017","ordinal":36086,"en":"I have offered my golden throne;"},{"id":"manas-2010:p0817:b001:l018","ordinal":36087,"en":"Let me give everything, leaving nothing,"},{"id":"manas-2010:p0817:b001:l019","ordinal":36088,"en":"All that you say you need."},{"id":"manas-2010:p0817:b001:l020","ordinal":36089,"en":"Warrior, do not cut short my life."},{"id":"manas-2010:p0817:b001:l021","ordinal":36090,"en":"Leave my file, take my whetstone."},{"id":"manas-2010:p0817:b001:l022","ordinal":36091,"en":"If you should regret it, Azhybay,"},{"id":"manas-2010:p0817:b001:l023","ordinal":36092,"en":"Leave two of mine, take one;"},{"id":"manas-2010:p0817:b001:l024","ordinal":36093,"en":"Leave my child, take my wife!"},{"id":"manas-2010:p0817:b001:l025","ordinal":36094,"en":"Know that this is what I say."},{"id":"manas-2010:p0817:b001:l026","ordinal":36095,"en":"My lion Azhy, heed my words."},{"id":"manas-2010:p0817:b001:l027","ordinal":36096,"en":"If you travel hungry,"}]
