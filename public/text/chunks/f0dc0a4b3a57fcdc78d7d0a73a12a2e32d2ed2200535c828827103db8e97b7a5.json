[{"id":"semetey-1-2013:p0523:b005:l019","ordinal":116737,"en":"Ten thrust at him as they passed."},{"id":"semetey-1-2013:p0523:b005:l020","ordinal":116738,"en":"He had no fear of death;"},{"id":"semetey-1-2013:p0523:b005:l021","ordinal":116739,"en":"That accursed one's offspring"},{"id":"semetey-1-2013:p0523:b005:l022","ordinal":116740,"en":"Did not care whether they struck him."},{"id":"semetey-1-2013:p0523:b005:l023","ordinal":116741,"en":"His thoroughbred thundering,"},{"id":"semetey-1-2013:p0523:b005:l024","ordinal":116742,"en":"Broad-lunged and wheezing,"},{"id":"semetey-1-2013:p0523:b005:l025","ordinal":116743,"en":"Fork-bearded Akbalban"},{"id":"semetey-1-2013:p0523:b005:l026","ordinal":116744,"en":"Took his sword in his hand."},{"id":"semetey-1-2013:p0523:b005:l027","ordinal":116745,"en":"The only one visited by Kyzyr—"},{"id":"semetey-1-2013:p0523:b005:l028","ordinal":116746,"en":"The swordsmen reached the boy,"},{"id":"semetey-1-2013:p0523:b005:l029","ordinal":116747,"en":"Ten struck in succession,"},{"id":"semetey-1-2013:p0523:b005:l030","ordinal":116748,"en":"And passed on again."},{"id":"semetey-1-2013:p0523:b005:l031","ordinal":116749,"en":"They did not distract his thoughts a hair's breadth."},{"id":"semetey-1-2013:p0523:b005:l032","ordinal":116750,"en":"The swordsmen's blows"},{"id":"semetey-1-2013:p0523:b005:l033","ordinal":116751,"en":"The boy did not rate as much as a mosquito."},{"id":"semetey-1-2013:p0523:b005:l034","ordinal":116752,"en":"Thus the swordsmen passed,"},{"id":"semetey-1-2013:p0523:b005:l035","ordinal":116753,"en":"As if an evil spirit had struck their wives,"},{"id":"semetey-1-2013:p0523:b005:l036","ordinal":116754,"en":"As if their quarry were fleeing close by,"},{"id":"semetey-1-2013:p0523:b005:l037","ordinal":116755,"en":"As if hot on the heels of their quarry,"},{"id":"semetey-1-2013:p0523:b005:l038","ordinal":116756,"en":"As if their wives had borne sons,"},{"id":"semetey-1-2013:p0523:b005:l039","ordinal":116757,"en":"Flustered, crying “Go!”"},{"id":"semetey-1-2013:p0524:b003:l001","ordinal":116758,"en":"Sticking out their blue overshoes,"},{"id":"semetey-1-2013:p0524:b003:l003","ordinal":116759,"en":"Those white saddles of Kokand","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0524:b003:l004","ordinal":116760,"en":"Had no cruppers at all."},{"id":"semetey-1-2013:p0524:b003:l005","ordinal":116761,"en":"All their horses were stallions."},{"id":"semetey-1-2013:p0524:b003:l006","ordinal":116762,"en":"These Sarts who attacked the lion protected by Kyzyr"},{"id":"semetey-1-2013:p0524:b003:l007","ordinal":116763,"en":"Had no sense."},{"id":"semetey-1-2013:p0524:b003:l008","ordinal":116764,"en":"Hurrying and stumbling in confusion,"},{"id":"semetey-1-2013:p0524:b003:l009","ordinal":116765,"en":"Their marksmen swarmed up."},{"id":"semetey-1-2013:p0524:b003:l010","ordinal":116766,"en":"With stocked, mighty guns,"},{"id":"semetey-1-2013:p0524:b003:l011","ordinal":116767,"en":"Ten wrestlers from among the marksmen"},{"id":"semetey-1-2013:p0524:b003:l012","ordinal":116768,"en":"Fired in succession as they passed."},{"id":"semetey-1-2013:p0524:b003:l013","ordinal":116769,"en":"The orphan hummed along, heedless."},{"id":"semetey-1-2013:p0524:b003:l014","ordinal":116770,"en":"The wrestlers' shooting,"},{"id":"semetey-1-2013:p0524:b003:l015","ordinal":116771,"en":"The havoc they were wreaking,"},{"id":"semetey-1-2013:p0524:b003:l016","ordinal":116772,"en":"That only son of Manas"},{"id":"semetey-1-2013:p0524:b003:l017","ordinal":116773,"en":"He valued less than a trouser hem."},{"id":"semetey-1-2013:p0524:b003:l018","ordinal":116774,"en":"A mottled wrestler on a flaxen-chestnut horse,"},{"id":"semetey-1-2013:p0524:b003:l019","ordinal":116775,"en":"And a gray wrestler with a curly beard,"},{"id":"semetey-1-2013:p0524:b003:l020","ordinal":116776,"en":"Swarmed up from behind."},{"id":"semetey-1-2013:p0524:b003:l021","ordinal":116777,"en":"The wrestlers with battle-axes,"},{"id":"semetey-1-2013:p0524:b003:l022","ordinal":116778,"en":"Each one in turn,"},{"id":"semetey-1-2013:p0524:b003:l023","ordinal":116779,"en":"Struck as they passed."},{"id":"semetey-1-2013:p0524:b003:l024","ordinal":116780,"en":"The orphan did not tilt or stir."},{"id":"semetey-1-2013:p0524:b003:l025","ordinal":116781,"en":"The offspring of the lion protected by Kyzyr"},{"id":"semetey-1-2013:p0524:b003:l026","ordinal":116782,"en":"Did not flinch before the wrestlers."},{"id":"semetey-1-2013:p0524:b003:l027","ordinal":116783,"en":"The great wrestlers carrying iron-headed maces"},{"id":"semetey-1-2013:p0524:b003:l028","ordinal":116784,"en":"All reached him together."},{"id":"semetey-1-2013:p0524:b003:l029","ordinal":116785,"en":"Each one in turn"},{"id":"semetey-1-2013:p0524:b003:l030","ordinal":116786,"en":"Struck the boy as he passed."},{"id":"semetey-1-2013:p0524:b003:l031","ordinal":116787,"en":"Curly-bearded Buka the Sart,"},{"id":"semetey-1-2013:p0524:b003:l032","ordinal":116788,"en":"That craggy great wrestler,"},{"id":"semetey-1-2013:p0524:b003:l033","ordinal":116789,"en":"He too struck as he passed."},{"id":"semetey-1-2013:p0524:b003:l034","ordinal":116790,"en":"His iron-headed mace"},{"id":"semetey-1-2013:p0524:b003:l035","ordinal":116791,"en":"Into the poor goshawk boy's"},{"id":"semetey-1-2013:p0524:b003:l036","ordinal":116792,"en":"Bones struck painfully."},{"id":"semetey-1-2013:p0524:b003:l038","ordinal":116793,"en":"To the wrestler in front,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0524:b003:l039","ordinal":116794,"en":"Your fierce one was about to give something to talk about!"},{"id":"semetey-1-2013:p0524:b004:l001","ordinal":116795,"en":"Striking Aktulpar once on the thigh,"},{"id":"semetey-1-2013:p0524:b004:l002","ordinal":116796,"en":"His two eyes blazing,"},{"id":"semetey-1-2013:p0524:b004:l003","ordinal":116797,"en":"His splendid teeth like gates,"},{"id":"semetey-1-2013:p0524:b004:l004","ordinal":116798,"en":"Those many Sart wrestlers'"},{"id":"semetey-1-2013:p0524:b004:l005","ordinal":116799,"en":"Deeds were dreadful trouble."},{"id":"semetey-1-2013:p0524:b004:l006","ordinal":116800,"en":"He chewed over and over."},{"id":"semetey-1-2013:p0524:b004:l007","ordinal":116801,"en":"The orphan grew wrathful;"},{"id":"semetey-1-2013:p0524:b004:l008","ordinal":116802,"en":"His thirst for blood seized him."},{"id":"semetey-1-2013:p0524:b004:l009","ordinal":116803,"en":"To shrink back from no stone,"},{"id":"semetey-1-2013:p0524:b004:l010","ordinal":116804,"en":"His anger rose with deadly focus,"},{"id":"semetey-1-2013:p0524:b004:l011","ordinal":116805,"en":"To shrink back from no death."},{"id":"semetey-1-2013:p0524:b004:l012","ordinal":116806,"en":"“I honored them as Muslims."},{"id":"semetey-1-2013:p0524:b004:l013","ordinal":116807,"en":"Though I never stole their piebald horse,"},{"id":"semetey-1-2013:p0524:b004:l014","ordinal":116808,"en":"Every one of them beats me—"},{"id":"semetey-1-2013:p0524:b004:l015","ordinal":116809,"en":"What are they doing?"},{"id":"semetey-1-2013:p0524:b004:l016","ordinal":116810,"en":"Let me put an end to them all."},{"id":"semetey-1-2013:p0524:b004:l017","ordinal":116811,"en":"If they will not heed my words,"},{"id":"semetey-1-2013:p0524:b004:l018","ordinal":116812,"en":"These Sarts standing here,"},{"id":"semetey-1-2013:p0524:b004:l019","ordinal":116813,"en":"Let me slaughter them all."},{"id":"semetey-1-2013:p0524:b004:l020","ordinal":116814,"en":"That hairy-chested wretch,"},{"id":"semetey-1-2013:p0524:b004:l021","ordinal":116815,"en":"Let me put an end to him thus."},{"id":"semetey-1-2013:p0524:b004:l022","ordinal":116816,"en":"Let me make sport in my fury;"},{"id":"semetey-1-2013:p0524:b004:l023","ordinal":116817,"en":"The wrestler who struck first,"},{"id":"semetey-1-2013:p0524:b004:l024","ordinal":116818,"en":"Let me give him sport and trouble!”"},{"id":"semetey-1-2013:p0524:b004:l025","ordinal":116819,"en":"Saying this, Semetey,"},{"id":"semetey-1-2013:p0524:b004:l026","ordinal":116820,"en":"The orphan burst out shouting,"},{"id":"semetey-1-2013:p0524:b004:l027","ordinal":116821,"en":"Calling to the wrestlers:"},{"id":"semetey-1-2013:p0524:b004:l028","ordinal":116822,"en":"“Do not stick out your blue overshoes,"},{"id":"semetey-1-2013:p0524:b004:l029","ordinal":116823,"en":"Foul-looking men of Kokand!"},{"id":"semetey-1-2013:p0524:b004:l031","ordinal":116824,"en":"Hey, Kokand! Hey, Kokand!","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0524:b004:l032","ordinal":116825,"en":"Rein in your horse, Kokand!"},{"id":"semetey-1-2013:p0524:b004:l033","ordinal":116826,"en":"You will all be slaughtered."},{"id":"semetey-1-2013:p0524:b004:l034","ordinal":116827,"en":"Heed my words; turn back, Kokand!"},{"id":"semetey-1-2013:p0524:b004:l035","ordinal":116828,"en":"Damn your father's grave, Sart of Kokand!"},{"id":"semetey-1-2013:p0524:b004:l036","ordinal":116829,"en":"I came as a guest, and you beat me,"},{"id":"semetey-1-2013:p0524:b004:l037","ordinal":116830,"en":"Putting bitter pain within me."},{"id":"semetey-1-2013:p0524:b004:l038","ordinal":116831,"en":"Damn your father's grave, hey, Kokand!"},{"id":"semetey-1-2013:p0524:b004:l039","ordinal":116832,"en":"For all of you to thrust spears,"},{"id":"semetey-1-2013:p0525:b003:l001","ordinal":116833,"en":"For you to surround me,"},{"id":"semetey-1-2013:p0525:b003:l002","ordinal":116834,"en":"For you to take such firm revenge,"},{"id":"semetey-1-2013:p0525:b003:l003","ordinal":116835,"en":"Did I run off with your piebald horse,"},{"id":"semetey-1-2013:p0525:b003:l004","ordinal":116836,"en":"Shameless Sart of Kokand?"},{"id":"semetey-1-2013:p0525:b003:l005","ordinal":116837,"en":"Did I scatter your wealth of white silver coins?"},{"id":"semetey-1-2013:p0525:b003:l006","ordinal":116838,"en":"For all of you to come and surround me,"},{"id":"semetey-1-2013:p0525:b003:l007","ordinal":116839,"en":"For you to beat me so hard,"},{"id":"semetey-1-2013:p0525:b003:l008","ordinal":116840,"en":"Did I drive off your dun horse?"},{"id":"semetey-1-2013:p0525:b003:l009","ordinal":116841,"en":"Hey, God-forsaken Sart of Kokand,"},{"id":"semetey-1-2013:p0525:b003:l010","ordinal":116842,"en":"Did I scatter the valuables in your saddlebags?"},{"id":"semetey-1-2013:p0525:b003:l011","ordinal":116843,"en":"Before this, hey, Kokand,"},{"id":"semetey-1-2013:p0525:b003:l012","ordinal":116844,"en":"I did not plunder your wealth;"},{"id":"semetey-1-2013:p0525:b003:l013","ordinal":116845,"en":"I did not cause havoc before."},{"id":"semetey-1-2013:p0525:b003:l014","ordinal":116846,"en":"You stubborn wrestler,"},{"id":"semetey-1-2013:p0525:b003:l015","ordinal":116847,"en":"Calling all the devils together,"},{"id":"semetey-1-2013:p0525:b003:l016","ordinal":116848,"en":"Why have you attacked me so?"},{"id":"semetey-1-2013:p0525:b003:l017","ordinal":116849,"en":"Damn your father's grave, wrestler!"},{"id":"semetey-1-2013:p0525:b003:l018","ordinal":116850,"en":"Your guilt is on your own head;"},{"id":"semetey-1-2013:p0525:b003:l019","ordinal":116851,"en":"May your suffering fall upon your dark crown!"},{"id":"semetey-1-2013:p0525:b003:l020","ordinal":116852,"en":"If I leave you to your will, you will not stop."},{"id":"semetey-1-2013:p0525:b003:l021","ordinal":116853,"en":"Each of you strikes ten times;"},{"id":"semetey-1-2013:p0525:b003:l022","ordinal":116854,"en":"Nor do you leave me to my harmless thoughts."},{"id":"semetey-1-2013:p0525:b003:l023","ordinal":116855,"en":"Is havoc what you seek"},{"id":"semetey-1-2013:p0525:b003:l024","ordinal":116856,"en":"From Manas's orphan son?"},{"id":"semetey-1-2013:p0525:b003:l025","ordinal":116857,"en":"Now, my wrestlers,"},{"id":"semetey-1-2013:p0525:b003:l026","ordinal":116858,"en":"See what sport awaits!"},{"id":"semetey-1-2013:p0525:b003:l027","ordinal":116859,"en":"Is havoc what you want?"},{"id":"semetey-1-2013:p0525:b003:l028","ordinal":116860,"en":"If blood drives you, attack;"},{"id":"semetey-1-2013:p0525:b003:l029","ordinal":116861,"en":"Now see what sport I give you!”"},{"id":"semetey-1-2013:p0525:b003:l030","ordinal":116862,"en":"Saying this, Semetey,"},{"id":"semetey-1-2013:p0525:b003:l031","ordinal":116863,"en":"Wrathful, seized by blood-thirst,"},{"id":"semetey-1-2013:p0525:b003:l032","ordinal":116864,"en":"Was gripped by his fit."},{"id":"semetey-1-2013:p0525:b003:l033","ordinal":116865,"en":"Aktulpar beneath him,"},{"id":"semetey-1-2013:p0525:b003:l034","ordinal":116866,"en":"He lashed with his whip on either side,"},{"id":"semetey-1-2013:p0525:b003:l035","ordinal":116867,"en":"Spurring to right and left."},{"id":"semetey-1-2013:p0525:b003:l036","ordinal":116868,"en":"The wretched orphan left by generous Manas,"},{"id":"semetey-1-2013:p0525:b003:l037","ordinal":116869,"en":"Raging like a lion,"},{"id":"semetey-1-2013:p0525:b003:l038","ordinal":116870,"en":"Attacking the wrestlers,"},{"id":"semetey-1-2013:p0525:b003:l039","ordinal":116871,"en":"Semetey charged in, wild with excitement."},{"id":"semetey-1-2013:p0525:b004:l001","ordinal":116872,"en":"He raged and shouted,"},{"id":"semetey-1-2013:p0525:b004:l002","ordinal":116873,"en":"Drew his steel blade from its sheath,"},{"id":"semetey-1-2013:p0525:b004:l003","ordinal":116874,"en":"Cried “Manas!” as his battle cry."},{"id":"semetey-1-2013:p0525:b004:l004","ordinal":116875,"en":"That dauntless one, girded with the gray pouch-belt,"},{"id":"semetey-1-2013:p0525:b004:l005","ordinal":116876,"en":"Attacked the wrestlers,"},{"id":"semetey-1-2013:p0525:b004:l006","ordinal":116877,"en":"Striking each one once."},{"id":"semetey-1-2013:p0525:b004:l007","ordinal":116878,"en":"He made sport of them again and again."},{"id":"semetey-1-2013:p0525:b004:l008","ordinal":116879,"en":"Ten died where he made sport."},{"id":"semetey-1-2013:p0525:b004:l009","ordinal":116880,"en":"Four or five of the wrestlers"},{"id":"semetey-1-2013:p0525:b004:l010","ordinal":116881,"en":"Died on the ridge where they faced him."},{"id":"semetey-1-2013:p0525:b004:l011","ordinal":116882,"en":"Six or seven of their wrestlers"},{"id":"semetey-1-2013:p0525:b004:l012","ordinal":116883,"en":"Died where he made that sport."},{"id":"semetey-1-2013:p0525:b004:l013","ordinal":116884,"en":"When he reached Boz-Moynok,"},{"id":"semetey-1-2013:p0525:b004:l014","ordinal":116885,"en":"The wrestlers themselves stopped."},{"id":"semetey-1-2013:p0525:b004:l015","ordinal":116886,"en":"Having attacked the boy without cause,"},{"id":"semetey-1-2013:p0525:b004:l016","ordinal":116887,"en":"Sixty wrestlers perished through this."},{"id":"semetey-1-2013:p0525:b004:l018","ordinal":116888,"en":"Whatever he pleased in Kokand—"},{"id":"semetey-1-2013:p0525:b004:l019","ordinal":116889,"en":"Did you see your orphan do it?"},{"id":"semetey-1-2013:p0525:b004:l020","ordinal":116890,"en":"Some sixty wrestlers—"},{"id":"semetey-1-2013:p0525:b004:l021","ordinal":116891,"en":"Did you see Semetey slaughter them?"},{"id":"semetey-1-2013:p0525:b004:l022","ordinal":116892,"en":"They saw the face of Judgment Day."},{"id":"semetey-1-2013:p0525:b004:l023","ordinal":116893,"en":"Attacking the lion protected by Kyzyr,"},{"id":"semetey-1-2013:p0525:b004:l024","ordinal":116894,"en":"Those accursed wrestlers died."},{"id":"semetey-1-2013:p0525:b004:l025","ordinal":116895,"en":"Hearing the terrible news,"},{"id":"semetey-1-2013:p0525:b004:l026","ordinal":116896,"en":"That some sixty wrestlers"},{"id":"semetey-1-2013:p0525:b004:l027","ordinal":116897,"en":"Khan Manas's orphan"},{"id":"semetey-1-2013:p0525:b004:l028","ordinal":116898,"en":"Had slaughtered,"},{"id":"semetey-1-2013:p0525:b004:l029","ordinal":116899,"en":"No one went after him."},{"id":"semetey-1-2013:p0525:b004:l030","ordinal":116900,"en":"The people of Kokand feared his might;"},{"id":"semetey-1-2013:p0525:b004:l031","ordinal":116901,"en":"They did not avenge the wrestlers."},{"id":"semetey-1-2013:p0525:b004:l032","ordinal":116902,"en":"Against the twelve-year-old boy"},{"id":"semetey-1-2013:p0525:b004:l033","ordinal":116903,"en":"None remained who could withstand him."},{"id":"semetey-1-2013:p0525:b004:l034","ordinal":116904,"en":"For the only son born of Manas,"},{"id":"semetey-1-2013:p0525:b004:l035","ordinal":116905,"en":"Now there was no lament over the dead."},{"id":"semetey-1-2013:p0525:b004:l036","ordinal":116906,"en":"“Semetey will slaughter us,” they said."},{"id":"semetey-1-2013:p0525:b004:l037","ordinal":116907,"en":"Of the city of Kokand,"},{"id":"semetey-1-2013:p0525:b004:l038","ordinal":116908,"en":"Not a soul remained in the open country."},{"id":"semetey-1-2013:p0525:b004:l039","ordinal":116909,"en":"Mounting camel saddles, running on foot,"},{"id":"semetey-1-2013:p0526:b003:l001","ordinal":116910,"en":"The people of Kokand hurried inside."},{"id":"semetey-1-2013:p0526:b003:l002","ordinal":116911,"en":"Shutting the gate tight,"},{"id":"semetey-1-2013:p0526:b003:l003","ordinal":116912,"en":"The people of Kokand fled within."},{"id":"semetey-1-2013:p0526:b003:l004","ordinal":116913,"en":"Without turning back toward Kokand,"},{"id":"semetey-1-2013:p0526:b003:l005","ordinal":116914,"en":"Kozhosan's only son"},{"id":"semetey-1-2013:p0526:b003:l006","ordinal":116915,"en":"Stayed upon his journey."},{"id":"semetey-1-2013:p0526:b003:l007","ordinal":116916,"en":"Along Aman-Zhol, where his mother had come,"},{"id":"semetey-1-2013:p0526:b003:l008","ordinal":116917,"en":"Not a crow was heard cawing,"},{"id":"semetey-1-2013:p0526:b003:l009","ordinal":116918,"en":"Not a raven croaking."},{"id":"semetey-1-2013:p0526:b003:l010","ordinal":116919,"en":"There was no furrow touched by a plow,"},{"id":"semetey-1-2013:p0526:b003:l011","ordinal":116920,"en":"No burrow dug by a marmot,"},{"id":"semetey-1-2013:p0526:b003:l012","ordinal":116921,"en":"No pit to stumble into,"},{"id":"semetey-1-2013:p0526:b003:l013","ordinal":116922,"en":"No stump to trip a horse."},{"id":"semetey-1-2013:p0526:b003:l014","ordinal":116923,"en":"He traveled down Aman-Zhol,"},{"id":"semetey-1-2013:p0526:b003:l015","ordinal":116924,"en":"Went far, sparing no horse,"},{"id":"semetey-1-2013:p0526:b003:l016","ordinal":116925,"en":"Journeyed without sparing himself."},{"id":"semetey-1-2013:p0526:b003:l017","ordinal":116926,"en":"“If death comes, I shall die,” he thought."},{"id":"semetey-1-2013:p0526:b003:l018","ordinal":116927,"en":"“What Allah has ordained,"},{"id":"semetey-1-2013:p0526:b003:l019","ordinal":116928,"en":"Whatever it may be, I shall face."},{"id":"semetey-1-2013:p0526:b003:l020","ordinal":116929,"en":"For my khan father, Manas the Lion,"},{"id":"semetey-1-2013:p0526:b003:l021","ordinal":116930,"en":"I am going to recite the Qur'an."},{"id":"semetey-1-2013:p0526:b003:l022","ordinal":116931,"en":"The Argyn and Kyrgyz people in Talas"},{"id":"semetey-1-2013:p0526:b003:l023","ordinal":116932,"en":"Are the people my father left behind."},{"id":"semetey-1-2013:p0526:b003:l024","ordinal":116933,"en":"This year I shall see their faces.”"},{"id":"semetey-1-2013:p0526:b003:l025","ordinal":116934,"en":"He crossed the mottled, hilly land,"},{"id":"semetey-1-2013:p0526:b003:l026","ordinal":116935,"en":"Passed over gray, uneven ridges,"},{"id":"semetey-1-2013:p0526:b003:l027","ordinal":116936,"en":"Traversed the ranks of mountains,"},{"id":"semetey-1-2013:p0526:b003:l028","ordinal":116937,"en":"Followed along their edges."},{"id":"semetey-1-2013:p0526:b003:l029","ordinal":116938,"en":"The gray, mist-shrouded slopes"},{"id":"semetey-1-2013:p0526:b003:l030","ordinal":116939,"en":"He traveled along."},{"id":"semetey-1-2013:p0526:b003:l031","ordinal":116940,"en":"Crossing the Syr Darya, he pressed on,"},{"id":"semetey-1-2013:p0526:b003:l032","ordinal":116941,"en":"Crossed passes and trod over stones."},{"id":"semetey-1-2013:p0526:b003:l033","ordinal":116942,"en":"The boy's mind was troubled."},{"id":"semetey-1-2013:p0526:b003:l034","ordinal":116943,"en":"Hurrying on in haste,"},{"id":"semetey-1-2013:p0526:b003:l035","ordinal":116944,"en":"He journeyed toward Talas,"},{"id":"semetey-1-2013:p0526:b003:l036","ordinal":116945,"en":"Traveled far without tiring,"},{"id":"semetey-1-2013:p0526:b003:l037","ordinal":116946,"en":"Saw pass after separate pass,"},{"id":"semetey-1-2013:p0526:b003:l038","ordinal":116947,"en":"Saw many stretches of foothills,"},{"id":"semetey-1-2013:p0526:b003:l039","ordinal":116948,"en":"Passed through slender willows."},{"id":"semetey-1-2013:p0526:b004:l001","ordinal":116949,"en":"Chyiyrchyk and Salar, the two rivers—"},{"id":"semetey-1-2013:p0526:b004:l002","ordinal":116950,"en":"He traveled along their banks."},{"id":"semetey-1-2013:p0526:b004:l003","ordinal":116951,"en":"He journeyed without turning back,"},{"id":"semetey-1-2013:p0526:b004:l004","ordinal":116952,"en":"Went far, sparing no horse,"},{"id":"semetey-1-2013:p0526:b004:l005","ordinal":116953,"en":"Traveled day after day and night after night."},{"id":"semetey-1-2013:p0526:b004:l006","ordinal":116954,"en":"Not lying down at night, he rode through the darkness."},{"id":"semetey-1-2013:p0526:b004:l007","ordinal":116955,"en":"He took no rest propped on his elbow,"},{"id":"semetey-1-2013:p0526:b004:l008","ordinal":116956,"en":"Not even a brief nap."},{"id":"semetey-1-2013:p0526:b004:l009","ordinal":116957,"en":"He did not let Aktulpar stop to graze,"},{"id":"semetey-1-2013:p0526:b004:l010","ordinal":116958,"en":"Nor lie down himself to sleep his fill."},{"id":"semetey-1-2013:p0526:b004:l011","ordinal":116959,"en":"Old Tashkent and Chaldybar—"},{"id":"semetey-1-2013:p0526:b004:l012","ordinal":116960,"en":"The orphan descended and passed them."},{"id":"semetey-1-2013:p0526:b004:l013","ordinal":116961,"en":"The vast plain of Kazy-Kurt—"},{"id":"semetey-1-2013:p0526:b004:l014","ordinal":116962,"en":"When he came to that open plain,"},{"id":"semetey-1-2013:p0526:b004:l015","ordinal":116963,"en":"He saw the broad back of the earth."},{"id":"semetey-1-2013:p0526:b004:l016","ordinal":116964,"en":"There was no mountain even the size of a knucklebone,"},{"id":"semetey-1-2013:p0526:b004:l017","ordinal":116965,"en":"No hollow to crouch down into."},{"id":"semetey-1-2013:p0526:b004:l018","ordinal":116966,"en":"On its hills were wild sheep,"},{"id":"semetey-1-2013:p0526:b004:l019","ordinal":116967,"en":"On its terraces were ibex."},{"id":"semetey-1-2013:p0526:b004:l020","ordinal":116968,"en":"Snakes crawled down from the hills."},{"id":"semetey-1-2013:p0526:b004:l021","ordinal":116969,"en":"If you looked across its level plain,"},{"id":"semetey-1-2013:p0526:b004:l022","ordinal":116970,"en":"Kulans without tails or manes,"},{"id":"semetey-1-2013:p0526:b004:l023","ordinal":116971,"en":"Young two-year-olds ran and played."},{"id":"semetey-1-2013:p0526:b004:l024","ordinal":116972,"en":"The orphan could not tire of the sights."},{"id":"semetey-1-2013:p0526:b004:l025","ordinal":116973,"en":"Along the road his mother had fled,"},{"id":"semetey-1-2013:p0526:b004:l026","ordinal":116974,"en":"The orphan traveled without wearying."},{"id":"semetey-1-2013:p0526:b004:l027","ordinal":116975,"en":"A salt-black desert, heaps of sand,"},{"id":"semetey-1-2013:p0526:b004:l028","ordinal":116976,"en":"Not a blade of grass to nibble,"},{"id":"semetey-1-2013:p0526:b004:l029","ordinal":116977,"en":"Not a drop of water to drink,"},{"id":"semetey-1-2013:p0526:b004:l030","ordinal":116978,"en":"An empty plain, scorched sand—"},{"id":"semetey-1-2013:p0526:b004:l031","ordinal":116979,"en":"The orphan traveled without wearying."},{"id":"semetey-1-2013:p0526:b004:l032","ordinal":116980,"en":"Kaiypchy's dark cave,"},{"id":"semetey-1-2013:p0526:b004:l033","ordinal":116981,"en":"A true cave that was itself a shrine,"},{"id":"semetey-1-2013:p0526:b004:l034","ordinal":116982,"en":"Where no one without ritual ablution stayed,"},{"id":"semetey-1-2013:p0526:b004:l035","ordinal":116983,"en":"The wandering poor and destitute,"},{"id":"semetey-1-2013:p0526:b004:l036","ordinal":116984,"en":"The gaunt one unable to find food,"},{"id":"semetey-1-2013:p0526:b004:l038","ordinal":116985,"en":"My poor mother Kanykei, weighed down by misery—","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0527:b003:l001","ordinal":116986,"en":"Gave protection like a father."},{"id":"semetey-1-2013:p0527:b003:l002","ordinal":116987,"en":"The widow took shelter and hid there."},{"id":"semetey-1-2013:p0527:b003:l003","ordinal":116988,"en":"Bakai came to her aid,"},{"id":"semetey-1-2013:p0527:b003:l004","ordinal":116989,"en":"Roasted the meat of wild game."},{"id":"semetey-1-2013:p0527:b003:l005","ordinal":116990,"en":"The thin horse grew fat,"},{"id":"semetey-1-2013:p0527:b003:l006","ordinal":116991,"en":"The hungry belly was filled."},{"id":"semetey-1-2013:p0527:b003:l007","ordinal":116992,"en":"Kaiypchy's dark cave where my mother had stayed—"}]
