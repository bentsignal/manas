[{"id":"manas-2010:p1820:b001:l004","ordinal":78081,"en":"The son left behind is young;"},{"id":"manas-2010:p1820:b001:l005","ordinal":78082,"en":"What will become of his days?"},{"id":"manas-2010:p1820:b001:l006","ordinal":78083,"en":"The six kinsmen—"},{"id":"manas-2010:p1820:b001:l007","ordinal":78084,"en":"Treachery stands in their eyes."},{"id":"manas-2010:p1820:b001:l008","ordinal":78085,"en":"If they find the chance,"},{"id":"manas-2010:p1820:b001:l009","ordinal":78086,"en":"They are poised to trip me up.”"},{"id":"manas-2010:p1820:b001:l010","ordinal":78087,"en":"Unable to find a way,"},{"id":"manas-2010:p1820:b001:l011","ordinal":78088,"en":"Khan Koshoi stood bewildered."},{"id":"manas-2010:p1820:b001:l012","ordinal":78089,"en":"“This is the world's end,” he said;"},{"id":"manas-2010:p1820:b001:l013","ordinal":78090,"en":"Toshtuk too was filled with sorrow."},{"id":"manas-2010:p1820:b001:l014","ordinal":78091,"en":"Then your sister-in-law Kanykei,"},{"id":"manas-2010:p1820:b001:l015","ordinal":78092,"en":"In the midst of the night,"},{"id":"manas-2010:p1820:b001:l016","ordinal":78093,"en":"Led them all along."},{"id":"manas-2010:p1820:b001:l017","ordinal":78094,"en":"A man of sacred power had come;"},{"id":"manas-2010:p1820:b001:l018","ordinal":78095,"en":"From lower golden Mecca"},{"id":"manas-2010:p1820:b001:l019","ordinal":78096,"en":"He had come as an imam to Islam."},{"id":"manas-2010:p1820:b001:l020","ordinal":78097,"en":"She led out the mighty Koshoi and Toshtuk,"},{"id":"manas-2010:p1820:b001:l021","ordinal":78098,"en":"Brought them in a file from the court,"},{"id":"manas-2010:p1820:b001:l022","ordinal":78099,"en":"Kokboru and Koyonaaly on foot."},{"id":"manas-2010:p1820:b001:l023","ordinal":78100,"en":"She brought them out in a file,"},{"id":"manas-2010:p1820:b001:l024","ordinal":78101,"en":"Those forty holy men on foot."},{"id":"manas-2010:p1820:b001:l025","ordinal":78102,"en":"The body of sovereign Khan Manas—"},{"id":"manas-2010:p1820:b001:l026","ordinal":78103,"en":"She had Khans Koshoi and Toshtuk"},{"id":"manas-2010:p1820:b001:l027","ordinal":78104,"en":"Wash it in ritual purity,"},{"id":"manas-2010:p1820:b001:l028","ordinal":78105,"en":"Wrap it in fine white cloth,"},{"id":"manas-2010:p1820:b001:l029","ordinal":78106,"en":"And laid it upon the bier."},{"id":"manas-2010:p1820:b001:l030","ordinal":78107,"en":"Kanykei, newly clad in mourning,"},{"id":"manas-2010:p1820:b001:l031","ordinal":78108,"en":"And the little cradle-child Semetey—"},{"id":"manas-2010:p1820:b001:l032","ordinal":78109,"en":"Six thousand, headed by horses,"},{"id":"manas-2010:p1820:b001:l033","ordinal":78110,"en":"She had made ready for his absolution rite,"},{"id":"manas-2010:p1820:b001:l034","ordinal":78111,"en":"Had Khan Koshoi recite his funeral prayer."},{"id":"manas-2010:p1820:b001:l035","ordinal":78112,"en":"She had him bound head to foot in a carpet."},{"id":"manas-2010:p1820:b001:l036","ordinal":78113,"en":"Your noble sister-in-law Kanykei"},{"id":"manas-2010:p1820:b001:l037","ordinal":78114,"en":"Mounted Taibuurul;"},{"id":"manas-2010:p1820:b001:l038","ordinal":78115,"en":"Taking a gem-lit lamp in her hand,"},{"id":"manas-2010:p1820:b001:l039","ordinal":78116,"en":"She went ahead to lead the way."},{"id":"manas-2010:p1820:b001:l040","ordinal":78117,"en":"In the rock of Echkilik,"},{"id":"manas-2010:p1820:b001:l041","ordinal":78118,"en":"Before Manas had died,"},{"id":"manas-2010:p1820:b001:l042","ordinal":78119,"en":"She had prepared a resting-place beforehand."},{"id":"manas-2010:p1821:b001:l001","ordinal":78120,"en":"Kanykei had dug its entrance"},{"id":"manas-2010:p1821:b001:l002","ordinal":78121,"en":"To admit a single person."},{"id":"manas-2010:p1821:b001:l003","ordinal":78122,"en":"She had the space beyond hollowed out"},{"id":"manas-2010:p1821:b001:l004","ordinal":78123,"en":"To hold six thousand sheep."},{"id":"manas-2010:p1821:b001:l005","ordinal":78124,"en":"Its interior was bright and clear."},{"id":"manas-2010:p1821:b001:l006","ordinal":78125,"en":"Rubies and precious gems,"},{"id":"manas-2010:p1821:b001:l007","ordinal":78126,"en":"She had set shining together;"},{"id":"manas-2010:p1821:b001:l008","ordinal":78127,"en":"In all its six corners"},{"id":"manas-2010:p1821:b001:l009","ordinal":78128,"en":"She had light cast from them."},{"id":"manas-2010:p1821:b001:l010","ordinal":78129,"en":"“Lest the roof collapse,” she said,"},{"id":"manas-2010:p1821:b001:l011","ordinal":78130,"en":"At sixty selected places"},{"id":"manas-2010:p1821:b001:l012","ordinal":78131,"en":"She had golden pillars erected."},{"id":"manas-2010:p1821:b001:l013","ordinal":78132,"en":"“Lest the interior turn soggy,” she said,"},{"id":"manas-2010:p1821:b001:l014","ordinal":78133,"en":"She had a passage broken with iron crowbars,"},{"id":"manas-2010:p1821:b001:l015","ordinal":78134,"en":"Showing her skill;"},{"id":"manas-2010:p1821:b001:l016","ordinal":78135,"en":"The spring-water overhead"},{"id":"manas-2010:p1821:b001:l017","ordinal":78136,"en":"She made flow through the cave."},{"id":"manas-2010:p1821:b001:l018","ordinal":78137,"en":"Where the warrior was to lie,"},{"id":"manas-2010:p1821:b001:l019","ordinal":78138,"en":"She had a bed of gold made."},{"id":"manas-2010:p1821:b001:l020","ordinal":78139,"en":"“Lest the underside rot,” she said,"},{"id":"manas-2010:p1821:b001:l021","ordinal":78140,"en":"She had juniper ashes spread."},{"id":"manas-2010:p1821:b001:l022","ordinal":78141,"en":"Soaked in water forty years,"},{"id":"manas-2010:p1821:b001:l023","ordinal":78142,"en":"Its edges would not fade at all;"},{"id":"manas-2010:p1821:b001:l024","ordinal":78143,"en":"Soaked in water eighty years,"},{"id":"manas-2010:p1821:b001:l025","ordinal":78144,"en":"Its edges would not fray."},{"id":"manas-2010:p1821:b001:l026","ordinal":78145,"en":"The carpet with its golden patterns,"},{"id":"manas-2010:p1821:b001:l027","ordinal":78146,"en":"She had spread snugly beneath him."},{"id":"manas-2010:p1821:b001:l028","ordinal":78147,"en":"Precious Kanykei"},{"id":"manas-2010:p1821:b001:l029","ordinal":78148,"en":"Had made it a paradise upon this earth."},{"id":"manas-2010:p1821:b001:l030","ordinal":78149,"en":"The elders Koshoi and Toshtuk"},{"id":"manas-2010:p1821:b001:l031","ordinal":78150,"en":"Entered the cave,"},{"id":"manas-2010:p1821:b001:l032","ordinal":78151,"en":"With all the forty holy men present."},{"id":"manas-2010:p1821:b001:l033","ordinal":78152,"en":"Planting their spears and wailing,"},{"id":"manas-2010:p1821:b001:l034","ordinal":78153,"en":"Allah, whose decree is precious—"},{"id":"manas-2010:p1821:b001:l035","ordinal":78154,"en":"Grieving even at his decree,"},{"id":"manas-2010:p1821:b001:l036","ordinal":78155,"en":"There they laid your swift steed Manas to rest."},{"id":"manas-2010:p1821:b001:l037","ordinal":78156,"en":"Submitting to his decree,"},{"id":"manas-2010:p1821:b001:l038","ordinal":78157,"en":"The Quran's chapter “Tappat”"},{"id":"manas-2010:p1821:b001:l039","ordinal":78158,"en":"They recited with care."},{"id":"manas-2010:p1821:b001:l040","ordinal":78159,"en":"Khan Koshoi of the Katagan"},{"id":"manas-2010:p1821:b001:l041","ordinal":78160,"en":"Stood looking on in distress,"},{"id":"manas-2010:p1821:b001:l042","ordinal":78161,"en":"Then implored Kanykei:"},{"id":"manas-2010:p1822:b001:l001","ordinal":78162,"en":"“My child Kanykei, fairest of the dark-complexioned,"},{"id":"manas-2010:p1822:b001:l002","ordinal":78163,"en":"Radiant one among the Muslims,"},{"id":"manas-2010:p1822:b001:l003","ordinal":78164,"en":"My child, may whoever calls you a mere woman come to no good!"},{"id":"manas-2010:p1822:b001:l004","ordinal":78165,"en":"Whoever calls you a mere female,"},{"id":"manas-2010:p1822:b001:l005","ordinal":78166,"en":"May nothing he does ever prosper!”"},{"id":"manas-2010:p1822:b001:l006","ordinal":78167,"en":"Saying these words then,"},{"id":"manas-2010:p1822:b001:l007","ordinal":78168,"en":"The khans filed out."},{"id":"manas-2010:p1822:b001:l008","ordinal":78169,"en":"Grieving deeply for Manas,"},{"id":"manas-2010:p1822:b001:l009","ordinal":78170,"en":"Behind those filing out,"},{"id":"manas-2010:p1822:b001:l010","ordinal":78171,"en":"The khans came forth crying aloud."},{"id":"manas-2010:p1822:b001:l011","ordinal":78172,"en":"Walking sorrowfully without stopping,"},{"id":"manas-2010:p1822:b001:l012","ordinal":78173,"en":"The precious khan lamented:"},{"id":"manas-2010:p1822:b001:l013","ordinal":78174,"en":"“While Manas was here,"},{"id":"manas-2010:p1822:b001:l014","ordinal":78175,"en":"Islam's heart was at peace."},{"id":"manas-2010:p1822:b001:l015","ordinal":78176,"en":"Bereft of the leopard,"},{"id":"manas-2010:p1822:b001:l016","ordinal":78177,"en":"Not the slightest blessing remains for us."},{"id":"manas-2010:p1822:b001:l017","ordinal":78178,"en":"Honored Manas's eyes have closed."},{"id":"manas-2010:p1822:b001:l018","ordinal":78179,"en":"You few followers of Islam,"},{"id":"manas-2010:p1822:b001:l019","ordinal":78180,"en":"Parted from your Manas,"},{"id":"manas-2010:p1822:b001:l020","ordinal":78181,"en":"Has your soul found peace now?"},{"id":"manas-2010:p1822:b001:l021","ordinal":78182,"en":"Your Blood-Shedder Manas has fallen."},{"id":"manas-2010:p1822:b001:l022","ordinal":78183,"en":"We are finished, Muslims;"},{"id":"manas-2010:p1822:b001:l023","ordinal":78184,"en":"The deeply rooted plane tree has fallen.”"},{"id":"manas-2010:p1822:b001:l024","ordinal":78185,"en":"Before the pale dawn broke,"},{"id":"manas-2010:p1822:b001:l025","ordinal":78186,"en":"They turned back."},{"id":"manas-2010:p1822:b001:l026","ordinal":78187,"en":"To Khan Manas's court"},{"id":"manas-2010:p1822:b001:l027","ordinal":78188,"en":"Your people returned."},{"id":"manas-2010:p1822:b001:l028","ordinal":78189,"en":"Bakai the lion, boundlessly skilled,"},{"id":"manas-2010:p1822:b001:l029","ordinal":78190,"en":"Had cut down a poplar"},{"id":"manas-2010:p1822:b001:l030","ordinal":78191,"en":"And fashioned a towering figure,"},{"id":"manas-2010:p1822:b001:l031","ordinal":78192,"en":"An effigy exactly like Manas."},{"id":"manas-2010:p1822:b001:l032","ordinal":78193,"en":"Matching hand to hand,"},{"id":"manas-2010:p1822:b001:l033","ordinal":78194,"en":"Shaping foot to foot,"},{"id":"manas-2010:p1822:b001:l034","ordinal":78195,"en":"Wrapping it in fine white cloth,"},{"id":"manas-2010:p1822:b001:l035","ordinal":78196,"en":"Having it covered with leather,"},{"id":"manas-2010:p1822:b001:l036","ordinal":78197,"en":"Draping it in white felt,"},{"id":"manas-2010:p1822:b001:l037","ordinal":78198,"en":"Making it just like Manas,"},{"id":"manas-2010:p1822:b001:l038","ordinal":78199,"en":"He had laid it upon the bier."},{"id":"manas-2010:p1822:b001:l039","ordinal":78200,"en":"A thousand black camels"},{"id":"manas-2010:p1822:b001:l040","ordinal":78201,"en":"He had tied for the absolution rite."},{"id":"manas-2010:p1822:b001:l041","ordinal":78202,"en":"Andijan's yellow-patterned cloth with its costly weft,"},{"id":"manas-2010:p1822:b001:l042","ordinal":78203,"en":"Bukhara's costly dark-patterned cloth,"},{"id":"manas-2010:p1823:b001:l001","ordinal":78204,"en":"He had torn into mourning gifts."},{"id":"manas-2010:p1823:b001:l002","ordinal":78205,"en":"Six hundred, headed by horses,"},{"id":"manas-2010:p1823:b001:l003","ordinal":78206,"en":"He gave to the holy man in white."},{"id":"manas-2010:p1823:b001:l004","ordinal":78207,"en":"Nine hundred, headed by camels,"},{"id":"manas-2010:p1823:b001:l005","ordinal":78208,"en":"He gave to the forty holy men."},{"id":"manas-2010:p1823:b001:l006","ordinal":78209,"en":"To those owed small debts,"},{"id":"manas-2010:p1823:b001:l007","ordinal":78210,"en":"He gave sleek mares."},{"id":"manas-2010:p1823:b001:l008","ordinal":78211,"en":"To khans pressing claims,"},{"id":"manas-2010:p1823:b001:l009","ordinal":78212,"en":"He gave fine gold by the pood."},{"id":"manas-2010:p1823:b001:l010","ordinal":78213,"en":"Manas escaped the torment of Judgment Day."},{"id":"manas-2010:p1823:b001:l011","ordinal":78214,"en":"The sovereign remained uncleared"},{"id":"manas-2010:p1823:b001:l012","ordinal":78215,"en":"Of a small transgression harbored in his bosom."},{"id":"manas-2010:p1823:b001:l013","ordinal":78216,"en":"Otherwise, precious Kanykei"},{"id":"manas-2010:p1823:b001:l014","ordinal":78217,"en":"Had rescued Manas"},{"id":"manas-2010:p1823:b001:l015","ordinal":78218,"en":"From the torment he would face in the other world."},{"id":"manas-2010:p1823:b001:l016","ordinal":78219,"en":"His heedless drinking of grain beer,"},{"id":"manas-2010:p1823:b001:l017","ordinal":78220,"en":"His beating a holy man till he wailed,"},{"id":"manas-2010:p1823:b001:l018","ordinal":78221,"en":"His taking liquor and drinking it,"},{"id":"manas-2010:p1823:b001:l019","ordinal":78222,"en":"His lying with a prostitute beautiful as glass—"},{"id":"manas-2010:p1823:b001:l020","ordinal":78223,"en":"She freed him from their punishment."},{"id":"manas-2010:p1823:b001:l021","ordinal":78224,"en":"When the six scoundrels entered,"},{"id":"manas-2010:p1823:b001:l022","ordinal":78225,"en":"She consented to what they said."},{"id":"manas-2010:p1823:b001:l023","ordinal":78226,"en":"Placing Manas upon the bier,"},{"id":"manas-2010:p1823:b001:l024","ordinal":78227,"en":"To the Argyn and Kyrgyz,"},{"id":"manas-2010:p1823:b001:l025","ordinal":78228,"en":"To the six scoundrels, she handed him over."},{"id":"manas-2010:p1823:b001:l026","ordinal":78229,"en":"They carried him away wailing,"},{"id":"manas-2010:p1823:b001:l027","ordinal":78230,"en":"Booming, “My Greathearted One!”"},{"id":"manas-2010:p1823:b001:l028","ordinal":78231,"en":"To Khan Manas's enclosure,"},{"id":"manas-2010:p1823:b001:l029","ordinal":78232,"en":"To the enclosure they brought him."},{"id":"manas-2010:p1823:b001:l030","ordinal":78233,"en":"Crying, “My Greathearted One!” they set it sprawled out"},{"id":"manas-2010:p1823:b001:l031","ordinal":78234,"en":"And buried the wooden figure."},{"id":"manas-2010:p1823:b001:l032","ordinal":78235,"en":"Koshoi and Toshtuk stood there,"},{"id":"manas-2010:p1823:b001:l033","ordinal":78236,"en":"Swearing an oath upon their lives,"},{"id":"manas-2010:p1823:b001:l034","ordinal":78237,"en":"Chewing white wheat flour,"},{"id":"manas-2010:p1823:b001:l035","ordinal":78238,"en":"Holding the Holy Quran,"},{"id":"manas-2010:p1823:b001:l036","ordinal":78239,"en":"Making their promise firm,"},{"id":"manas-2010:p1823:b001:l037","ordinal":78240,"en":"Pledging themselves unto death."},{"id":"manas-2010:p1823:b001:l038","ordinal":78241,"en":"Horses of every kind have piebald heads;"},{"id":"manas-2010:p1823:b001:l039","ordinal":78242,"en":"The greathearted one's son left behind is young."},{"id":"manas-2010:p1823:b001:l040","ordinal":78243,"en":"“Let us serve him faithfully,"},{"id":"manas-2010:p1823:b001:l041","ordinal":78244,"en":"Making his fame known to the great people."},{"id":"manas-2010:p1823:b001:l042","ordinal":78245,"en":"Let us stand together at Manas's memorial feast;"},{"id":"manas-2010:p1824:b001:l001","ordinal":78246,"en":"Let us take counsel together."},{"id":"manas-2010:p1824:b001:l002","ordinal":78247,"en":"If anyone should harbor enmity,"},{"id":"manas-2010:p1824:b001:l003","ordinal":78248,"en":"Let us trample upon his head,"},{"id":"manas-2010:p1824:b001:l004","ordinal":78249,"en":"Scatter his four kinds of livestock,"},{"id":"manas-2010:p1824:b001:l005","ordinal":78250,"en":"Raid his mares."},{"id":"manas-2010:p1824:b001:l006","ordinal":78251,"en":"If he comes near, let us strike his brains out,"},{"id":"manas-2010:p1824:b001:l007","ordinal":78252,"en":"Let us drive them out thus,"},{"id":"manas-2010:p1824:b001:l008","ordinal":78253,"en":"Even those from far away."},{"id":"manas-2010:p1824:b001:l009","ordinal":78254,"en":"Binding many of their mighty men,"},{"id":"manas-2010:p1824:b001:l010","ordinal":78255,"en":"Let us strike their brains out."},{"id":"manas-2010:p1824:b001:l011","ordinal":78256,"en":"Making their children scream,"},{"id":"manas-2010:p1824:b001:l012","ordinal":78257,"en":"If they oppress the orphan,"},{"id":"manas-2010:p1824:b001:l013","ordinal":78258,"en":"Let us burn to the ground"},{"id":"manas-2010:p1824:b001:l014","ordinal":78259,"en":"The city of those who attack him."},{"id":"manas-2010:p1824:b001:l015","ordinal":78260,"en":"Let us fasten banners to our spears."},{"id":"manas-2010:p1824:b001:l016","ordinal":78261,"en":"This greathearted one's child,"},{"id":"manas-2010:p1824:b001:l017","ordinal":78262,"en":"Until he reaches twelve,"},{"id":"manas-2010:p1824:b001:l018","ordinal":78263,"en":"Let us watch over and raise him."},{"id":"manas-2010:p1824:b001:l019","ordinal":78264,"en":"Kokboru, son of Urumkan,"},{"id":"manas-2010:p1824:b001:l020","ordinal":78265,"en":"At the people's frontier, keep watch;"},{"id":"manas-2010:p1824:b001:l021","ordinal":78266,"en":"Let word come from you."},{"id":"manas-2010:p1824:b001:l022","ordinal":78267,"en":"You who dwell in Maseyil,"},{"id":"manas-2010:p1824:b001:l023","ordinal":78268,"en":"Called the warrior mightier than all,"},{"id":"manas-2010:p1824:b001:l024","ordinal":78269,"en":"Keep watch upon Talas."},{"id":"manas-2010:p1824:b001:l025","ordinal":78270,"en":"Keep within your care"},{"id":"manas-2010:p1824:b001:l026","ordinal":78271,"en":"Manas, born a leopard."},{"id":"manas-2010:p1824:b001:l027","ordinal":78272,"en":"Saikal, daughter of Karacha,"},{"id":"manas-2010:p1824:b001:l028","ordinal":78273,"en":"Make your pledge:"},{"id":"manas-2010:p1824:b001:l029","ordinal":78274,"en":"When Manas's memorial feast is held,"},{"id":"manas-2010:p1824:b001:l030","ordinal":78275,"en":"Stand beneath the standard."},{"id":"manas-2010:p1824:b001:l031","ordinal":78276,"en":"For Manas, whom you cared for,"},{"id":"manas-2010:p1824:b001:l032","ordinal":78277,"en":"Render this service!"},{"id":"manas-2010:p1824:b001:l033","ordinal":78278,"en":"Khan Koshoi, father of the people,"},{"id":"manas-2010:p1824:b001:l034","ordinal":78279,"en":"For your leopard Manas,"},{"id":"manas-2010:p1824:b001:l035","ordinal":78280,"en":"Preside over the memorial feast."},{"id":"manas-2010:p1824:b001:l036","ordinal":78281,"en":"Its wings reaching the people,"},{"id":"manas-2010:p1824:b001:l037","ordinal":78282,"en":"Beyond Khan Kokotoy's feast"},{"id":"manas-2010:p1824:b001:l038","ordinal":78283,"en":"Let its magnificence rise!"},{"id":"manas-2010:p1824:b001:l039","ordinal":78284,"en":"Spearing many mighty warriors,"},{"id":"manas-2010:p1824:b001:l040","ordinal":78285,"en":"Spearing many formidable foes,"},{"id":"manas-2010:p1824:b001:l041","ordinal":78286,"en":"Let us send word to the people."},{"id":"manas-2010:p1824:b001:l042","ordinal":78287,"en":"This memorial feast of Khan Manas—"},{"id":"manas-2010:p1825:b001:l001","ordinal":78288,"en":"If we live, let us hold it before we rest."},{"id":"manas-2010:p1825:b001:l002","ordinal":78289,"en":"For your lion gone to Judgment Day,"},{"id":"manas-2010:p1825:b001:l003","ordinal":78290,"en":"If we live, let us render service."},{"id":"manas-2010:p1825:b001:l004","ordinal":78291,"en":"Without making a wondrous spectacle for the world,"},{"id":"manas-2010:p1825:b001:l005","ordinal":78292,"en":"How can we stand and look on?"},{"id":"manas-2010:p1825:b001:l006","ordinal":78293,"en":"Let us not settle along the river,"},{"id":"manas-2010:p1825:b001:l007","ordinal":78294,"en":"All dying when our khan has died;"},{"id":"manas-2010:p1825:b001:l008","ordinal":78295,"en":"Let us not become like an extinguished fire!"},{"id":"manas-2010:p1825:b001:l009","ordinal":78296,"en":"From the hairy-mouthed Russians,"},{"id":"manas-2010:p1825:b001:l010","ordinal":78297,"en":"Let us gather twelve peoples."},{"id":"manas-2010:p1825:b001:l011","ordinal":78298,"en":"From the red-tufted Chinese,"},{"id":"manas-2010:p1825:b001:l012","ordinal":78299,"en":"Let us gather forty tribes."},{"id":"manas-2010:p1825:b001:l013","ordinal":78300,"en":"Red gold and countless livestock,"},{"id":"manas-2010:p1825:b001:l014","ordinal":78301,"en":"Let us not hesitate to spend."},{"id":"manas-2010:p1825:b001:l015","ordinal":78302,"en":"Take heed, my friends:"},{"id":"manas-2010:p1825:b001:l016","ordinal":78303,"en":"Those scoundrels Abyke and Kobosh"},{"id":"manas-2010:p1825:b001:l017","ordinal":78304,"en":"Have treachery in their eyes."},{"id":"manas-2010:p1825:b001:l018","ordinal":78305,"en":"If they find the chance, the six scoundrels"},{"id":"manas-2010:p1825:b001:l019","ordinal":78306,"en":"Are poised to trip you up."},{"id":"manas-2010:p1825:b001:l020","ordinal":78307,"en":"Crookedness lies in their words,"},{"id":"manas-2010:p1825:b001:l021","ordinal":78308,"en":"Malice stands in their eyes."},{"id":"manas-2010:p1825:b001:l022","ordinal":78309,"en":"In their thoughts, the six scoundrels,"},{"id":"manas-2010:p1825:b001:l023","ordinal":78310,"en":"Never obeying a directing word,"},{"id":"manas-2010:p1825:b001:l024","ordinal":78311,"en":"Are bent on acting against me.”"},{"id":"manas-2010:p1825:b001:l025","ordinal":78312,"en":"Then, at that time,"},{"id":"manas-2010:p1825:b001:l026","ordinal":78313,"en":"Moaning and weeping without cease,"},{"id":"manas-2010:p1825:b001:l027","ordinal":78314,"en":"Koshoi returned to his people."},{"id":"manas-2010:p1825:b001:l028","ordinal":78315,"en":"“Renowned Manas, do not die!” he cried."},{"id":"manas-2010:p1825:b001:l029","ordinal":78316,"en":"Grieving still more, without cease,"},{"id":"manas-2010:p1825:b001:l030","ordinal":78317,"en":"Toshtuk departed for his land."},{"id":"manas-2010:p1825:b001:l031","ordinal":78318,"en":"Saikal, daughter of Karacha,"},{"id":"manas-2010:p1825:b001:l032","ordinal":78319,"en":"Bereft of her Blood-Shedder,"},{"id":"manas-2010:p1825:b001:l033","ordinal":78320,"en":"Turned back in grief."},{"id":"manas-2010:p1825:b001:l034","ordinal":78321,"en":"At that time maiden Saikal,"},{"id":"manas-2010:p1825:b001:l035","ordinal":78322,"en":"Her bloody face torn,"},{"id":"manas-2010:p1825:b001:l036","ordinal":78323,"en":"Her black hair loose,"},{"id":"manas-2010:p1825:b001:l037","ordinal":78324,"en":"Her horse Algara pacing,"},{"id":"manas-2010:p1825:b001:l038","ordinal":78325,"en":"Blood mingled with bloody tears"},{"id":"manas-2010:p1825:b001:l039","ordinal":78326,"en":"Streamed down to her horse's knees."},{"id":"manas-2010:p1825:b001:l040","ordinal":78327,"en":"From her dear quail-like eyes,"},{"id":"manas-2010:p1825:b001:l041","ordinal":78328,"en":"Karacha's daughter Saikal"},{"id":"manas-2010:p1825:b001:l042","ordinal":78329,"en":"Shed tears in separate streams."},{"id":"manas-2010:p1826:b001:l001","ordinal":78330,"en":"Her dear saker-like eyes"},{"id":"manas-2010:p1826:b001:l002","ordinal":78331,"en":"Shed tears with every blink."},{"id":"manas-2010:p1826:b001:l003","ordinal":78332,"en":"From her honored, limpid eyes,"},{"id":"manas-2010:p1826:b001:l004","ordinal":78333,"en":"When she wept freely,"},{"id":"manas-2010:p1826:b001:l005","ordinal":78334,"en":"Tears ran a whip's length."},{"id":"manas-2010:p1826:b001:l006","ordinal":78335,"en":"Saikal, daughter of Karacha,"},{"id":"manas-2010:p1826:b001:l007","ordinal":78336,"en":"Was a woman of sacred power."}]
