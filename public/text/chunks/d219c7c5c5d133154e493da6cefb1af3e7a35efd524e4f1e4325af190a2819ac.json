[{"id":"manas-2010:p1624:b001:l016","ordinal":69889,"en":"Had sent word."},{"id":"manas-2010:p1624:b001:l017","ordinal":69890,"en":"Along with that news,"},{"id":"manas-2010:p1624:b001:l018","ordinal":69891,"en":"For the Chinese to rejoice,"},{"id":"manas-2010:p1624:b001:l019","ordinal":69892,"en":"Their day had dawned."},{"id":"manas-2010:p1624:b001:l020","ordinal":69893,"en":"A master horseman, fleet on foot,"},{"id":"manas-2010:p1624:b001:l021","ordinal":69894,"en":"Emerging when ruin threatened the Chinese,"},{"id":"manas-2010:p1624:b001:l022","ordinal":69895,"en":"Kojozhash, son of Karazhoy—"},{"id":"manas-2010:p1624:b001:l023","ordinal":69896,"en":"When that marksman arrived,"},{"id":"manas-2010:p1624:b001:l024","ordinal":69897,"en":"Muzburchak and Khan Kökchö died."},{"id":"manas-2010:p1624:b001:l025","ordinal":69898,"en":"The brim of the black felt hat,"},{"id":"manas-2010:p1624:b001:l026","ordinal":69899,"en":"Khan Manas's Syrgak,"},{"id":"manas-2010:p1624:b001:l027","ordinal":69900,"en":"Who never withdrew what he thrust forth,"},{"id":"manas-2010:p1624:b001:l028","ordinal":69901,"en":"Who never lost his stern bearing,"},{"id":"manas-2010:p1624:b001:l029","ordinal":69902,"en":"Young Syrgak died then."},{"id":"manas-2010:p1624:b001:l030","ordinal":69903,"en":"Kökötöy's Bokmurun"},{"id":"manas-2010:p1624:b001:l031","ordinal":69904,"en":"Was struck by a bullet and died;"},{"id":"manas-2010:p1624:b001:l032","ordinal":69905,"en":"Kerimsel died, lives were lost."},{"id":"manas-2010:p1624:b001:l033","ordinal":69906,"en":"At the emperor's Beijing,"},{"id":"manas-2010:p1624:b001:l034","ordinal":69907,"en":"Everyone who met it died."},{"id":"manas-2010:p1624:b001:l035","ordinal":69908,"en":"Lance-heads struck together,"},{"id":"manas-2010:p1624:b001:l036","ordinal":69909,"en":"Men's heads knocked together,"},{"id":"manas-2010:p1624:b001:l037","ordinal":69910,"en":"All the plain turned to dust,"},{"id":"manas-2010:p1624:b001:l038","ordinal":69911,"en":"The whole multitude turned to blood."},{"id":"manas-2010:p1624:b001:l039","ordinal":69912,"en":"Kojozhash raged:"},{"id":"manas-2010:p1624:b001:l040","ordinal":69913,"en":"“I shall raise a great tumult;"},{"id":"manas-2010:p1624:b001:l041","ordinal":69914,"en":"Their khan, Sultan Manas,"},{"id":"manas-2010:p1624:b001:l042","ordinal":69915,"en":"I shall seize this moment."},{"id":"manas-2010:p1625:b001:l001","ordinal":69916,"en":"To the forty wanton women in Beijing,"},{"id":"manas-2010:p1625:b001:l002","ordinal":69917,"en":"I shall take him and keep him as a stud."},{"id":"manas-2010:p1625:b001:l003","ordinal":69918,"en":"If a son is born of Manas,"},{"id":"manas-2010:p1625:b001:l004","ordinal":69919,"en":"Without shame, in Beijing,"},{"id":"manas-2010:p1625:b001:l005","ordinal":69920,"en":"I shall raise him as khan."},{"id":"manas-2010:p1625:b001:l006","ordinal":69921,"en":"The Burut who came on campaign,"},{"id":"manas-2010:p1625:b001:l007","ordinal":69922,"en":"I shall crush beneath me;"},{"id":"manas-2010:p1625:b001:l008","ordinal":69923,"en":"I shall scatter all four kinds of their livestock."},{"id":"manas-2010:p1625:b001:l009","ordinal":69924,"en":"Seizing their mares,"},{"id":"manas-2010:p1625:b001:l010","ordinal":69925,"en":"If they come near, I shall smash their brains."},{"id":"manas-2010:p1625:b001:l011","ordinal":69926,"en":"I come to exact repayment"},{"id":"manas-2010:p1625:b001:l012","ordinal":69927,"en":"For all the Burut's old offenses!”"},{"id":"manas-2010:p1625:b001:l013","ordinal":69928,"en":"The broad trench lay dug;"},{"id":"manas-2010:p1625:b001:l014","ordinal":69929,"en":"Bellowing their battle cry,"},{"id":"manas-2010:p1625:b001:l015","ordinal":69930,"en":"That Chinese army swept upon them."},{"id":"manas-2010:p1625:b001:l016","ordinal":69931,"en":"Among horses, the white-headed steed;"},{"id":"manas-2010:p1625:b001:l017","ordinal":69932,"en":"When the Chinese raised tumult,"},{"id":"manas-2010:p1625:b001:l018","ordinal":69933,"en":"With Almambet and Chubak among them,"},{"id":"manas-2010:p1625:b001:l019","ordinal":69934,"en":"Golden forelock and tasseled belt,"},{"id":"manas-2010:p1625:b001:l020","ordinal":69935,"en":"Azizkhan's Almambet,"},{"id":"manas-2010:p1625:b001:l021","ordinal":69936,"en":"Without looking around,"},{"id":"manas-2010:p1625:b001:l022","ordinal":69937,"en":"Your champion, destined to die,"},{"id":"manas-2010:p1625:b001:l023","ordinal":69938,"en":"Sparing his life not at all,"},{"id":"manas-2010:p1625:b001:l024","ordinal":69939,"en":"Shouted out, “Islam!”"},{"id":"manas-2010:p1625:b001:l025","ordinal":69940,"en":"The ninety great hosts of Kara-Kytay"},{"id":"manas-2010:p1625:b001:l026","ordinal":69941,"en":"He scattered, breaking their ranks."},{"id":"manas-2010:p1625:b001:l027","ordinal":69942,"en":"Making them reel, the dear lion,"},{"id":"manas-2010:p1625:b001:l028","ordinal":69943,"en":"Against the vast mass of unbelievers,"},{"id":"manas-2010:p1625:b001:l029","ordinal":69944,"en":"The dear hero attacked alone."},{"id":"manas-2010:p1625:b001:l030","ordinal":69945,"en":"Forty tribes of Chinese thundered,"},{"id":"manas-2010:p1625:b001:l031","ordinal":69946,"en":"With their mighty hero, the Fierce One;"},{"id":"manas-2010:p1625:b001:l032","ordinal":69947,"en":"As they were about to reach dear Alma,"},{"id":"manas-2010:p1625:b001:l033","ordinal":69948,"en":"“If my appointed death comes, I shall die;"},{"id":"manas-2010:p1625:b001:l034","ordinal":69949,"en":"To my surpassing friend Alma,"},{"id":"manas-2010:p1625:b001:l035","ordinal":69950,"en":"I shall be a support!”"},{"id":"manas-2010:p1625:b001:l036","ordinal":69951,"en":"Tall and broad-shouldered,"},{"id":"manas-2010:p1625:b001:l037","ordinal":69952,"en":"He too was black steel,"},{"id":"manas-2010:p1625:b001:l038","ordinal":69953,"en":"Khan Baltay's Chubak,"},{"id":"manas-2010:p1625:b001:l039","ordinal":69954,"en":"The champion of the Oygut,"},{"id":"manas-2010:p1625:b001:l040","ordinal":69955,"en":"Whom no man had strength to overcome in combat,"},{"id":"manas-2010:p1625:b001:l041","ordinal":69956,"en":"Whom a lion's teeth could not pierce,"},{"id":"manas-2010:p1625:b001:l042","ordinal":69957,"en":"Girding his waist for single combat,"},{"id":"manas-2010:p1626:b001:l001","ordinal":69958,"en":"If seven great hosts came,"},{"id":"manas-2010:p1626:b001:l002","ordinal":69959,"en":"He attacked with his sleeves flung free."},{"id":"manas-2010:p1626:b001:l003","ordinal":69960,"en":"“Against the grim-faced Chinese,"},{"id":"manas-2010:p1626:b001:l004","ordinal":69961,"en":"I shall go straight in and thrust my lance."},{"id":"manas-2010:p1626:b001:l005","ordinal":69962,"en":"From this hell of grievous toil,"},{"id":"manas-2010:p1626:b001:l006","ordinal":69963,"en":"I shall free my life."},{"id":"manas-2010:p1626:b001:l007","ordinal":69964,"en":"My valiant goshawk Alma—"},{"id":"manas-2010:p1626:b001:l008","ordinal":69965,"en":"Against the shouting Chinese,"},{"id":"manas-2010:p1626:b001:l009","ordinal":69966,"en":"I shall fight and bring slaughter."},{"id":"manas-2010:p1626:b001:l010","ordinal":69967,"en":"My noble fierce-maned Alma,"},{"id":"manas-2010:p1626:b001:l011","ordinal":69968,"en":"I shall rescue him!”"},{"id":"manas-2010:p1626:b001:l012","ordinal":69969,"en":"Shouting in fury,"},{"id":"manas-2010:p1626:b001:l013","ordinal":69970,"en":"Khan Baltay's Chubak"},{"id":"manas-2010:p1626:b001:l014","ordinal":69971,"en":"Raised the battle cry, “Manas!”"},{"id":"manas-2010:p1626:b001:l015","ordinal":69972,"en":"Kögala beneath him"},{"id":"manas-2010:p1626:b001:l016","ordinal":69973,"en":"He whipped on either side,"},{"id":"manas-2010:p1626:b001:l017","ordinal":69974,"en":"Spurred right and left,"},{"id":"manas-2010:p1626:b001:l018","ordinal":69975,"en":"Looked neither up nor down,"},{"id":"manas-2010:p1626:b001:l019","ordinal":69976,"en":"Never thinking, “I shall die.”"},{"id":"manas-2010:p1626:b001:l020","ordinal":69977,"en":"Shouting in fury,"},{"id":"manas-2010:p1626:b001:l021","ordinal":69978,"en":"The black Kalmyks and Manzhuu"},{"id":"manas-2010:p1626:b001:l022","ordinal":69979,"en":"He scattered wherever he entered."},{"id":"manas-2010:p1626:b001:l023","ordinal":69980,"en":"Those his lance could reach"},{"id":"manas-2010:p1626:b001:l024","ordinal":69981,"en":"He overturned with his lance;"},{"id":"manas-2010:p1626:b001:l025","ordinal":69982,"en":"Those his sword could reach"},{"id":"manas-2010:p1626:b001:l026","ordinal":69983,"en":"He hacked apart with his sword."},{"id":"manas-2010:p1626:b001:l027","ordinal":69984,"en":"When your mighty Chubak entered,"},{"id":"manas-2010:p1626:b001:l028","ordinal":69985,"en":"All the Manzhuu and the Fierce One"},{"id":"manas-2010:p1626:b001:l029","ordinal":69986,"en":"Drew bows and rained arrows,"},{"id":"manas-2010:p1626:b001:l030","ordinal":69987,"en":"Fired shots like hail."},{"id":"manas-2010:p1626:b001:l031","ordinal":69988,"en":"See the rain, see the embers,"},{"id":"manas-2010:p1626:b001:l032","ordinal":69989,"en":"See the shots striking together,"},{"id":"manas-2010:p1626:b001:l033","ordinal":69990,"en":"See the trench they have dug,"},{"id":"manas-2010:p1626:b001:l034","ordinal":69991,"en":"See the misery stirred up,"},{"id":"manas-2010:p1626:b001:l035","ordinal":69992,"en":"With their mighty Fierce One leading,"},{"id":"manas-2010:p1626:b001:l036","ordinal":69993,"en":"See the Chinese army sweeping in!"},{"id":"manas-2010:p1626:b001:l037","ordinal":69994,"en":"From this side of it,"},{"id":"manas-2010:p1626:b001:l038","ordinal":69995,"en":"The one who never ceased grappling,"},{"id":"manas-2010:p1626:b001:l039","ordinal":69996,"en":"On the meat of a whole pig"},{"id":"manas-2010:p1626:b001:l040","ordinal":69997,"en":"Who could not sate himself at one meal,"},{"id":"manas-2010:p1626:b001:l041","ordinal":69998,"en":"Kambyl the giant of the black host,"},{"id":"manas-2010:p1626:b001:l042","ordinal":69999,"en":"Came charging up."},{"id":"manas-2010:p1627:b001:l001","ordinal":70000,"en":"Sparing not their own lives,"},{"id":"manas-2010:p1627:b001:l002","ordinal":70001,"en":"The Chinese swarmed and fought."},{"id":"manas-2010:p1627:b001:l003","ordinal":70002,"en":"The untroubled heroes"},{"id":"manas-2010:p1627:b001:l004","ordinal":70003,"en":"Faced them without fleeing,"},{"id":"manas-2010:p1627:b001:l005","ordinal":70004,"en":"Never slept upon their elbows,"},{"id":"manas-2010:p1627:b001:l006","ordinal":70005,"en":"Never took a moment's rest,"},{"id":"manas-2010:p1627:b001:l007","ordinal":70006,"en":"Never rested through the day."},{"id":"manas-2010:p1627:b001:l008","ordinal":70007,"en":"In a slaughter such as this,"},{"id":"manas-2010:p1627:b001:l009","ordinal":70008,"en":"Even in death there was no regret."},{"id":"manas-2010:p1627:b001:l010","ordinal":70009,"en":"The place they fought was It-Ölbös,"},{"id":"manas-2010:p1627:b001:l011","ordinal":70010,"en":"A desert forty days across,"},{"id":"manas-2010:p1627:b001:l012","ordinal":70011,"en":"A desert where a flying swan's"},{"id":"manas-2010:p1627:b001:l013","ordinal":70012,"en":"Wings would burn away."},{"id":"manas-2010:p1627:b001:l014","ordinal":70013,"en":"Not a mountain the size of a knucklebone,"},{"id":"manas-2010:p1627:b001:l015","ordinal":70014,"en":"Not a hollow the size of a saddlecloth,"},{"id":"manas-2010:p1627:b001:l016","ordinal":70015,"en":"Not a furrow touched by a plow,"},{"id":"manas-2010:p1627:b001:l017","ordinal":70016,"en":"Not a burrow dug by a marmot,"},{"id":"manas-2010:p1627:b001:l018","ordinal":70017,"en":"Not a drop of water anywhere,"},{"id":"manas-2010:p1627:b001:l019","ordinal":70018,"en":"Not a pinch of grass to eat;"},{"id":"manas-2010:p1627:b001:l020","ordinal":70019,"en":"It was a forty-day road."},{"id":"manas-2010:p1627:b001:l021","ordinal":70020,"en":"With the forty tribes of Chinese,"},{"id":"manas-2010:p1627:b001:l022","ordinal":70021,"en":"All the valiant heroes"},{"id":"manas-2010:p1627:b001:l023","ordinal":70022,"en":"Were fated to meet."},{"id":"manas-2010:p1627:b001:l024","ordinal":70023,"en":"In the middle of that desert,"},{"id":"manas-2010:p1627:b001:l026","ordinal":70024,"en":"The lions suffered hardship,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p1627:b001:l027","ordinal":70025,"en":"Drenched in pitch-dark blood."},{"id":"manas-2010:p1627:b001:l028","ordinal":70026,"en":"Their heads were buckets of blood,"},{"id":"manas-2010:p1627:b001:l029","ordinal":70027,"en":"Their two arms paralyzed,"},{"id":"manas-2010:p1627:b001:l030","ordinal":70028,"en":"They grappled and slaughtered one another."},{"id":"manas-2010:p1627:b001:l031","ordinal":70029,"en":"See the spectacle of the world:"},{"id":"manas-2010:p1627:b001:l032","ordinal":70030,"en":"They grappled and slaughtered one another."},{"id":"manas-2010:p1627:b001:l033","ordinal":70031,"en":"Auspicious when sent ahead,"},{"id":"manas-2010:p1627:b001:l034","ordinal":70032,"en":"Almambet and Chubak,"},{"id":"manas-2010:p1627:b001:l035","ordinal":70033,"en":"Like vast armies as they drove the foe,"},{"id":"manas-2010:p1627:b001:l036","ordinal":70034,"en":"When these men were seen,"},{"id":"manas-2010:p1627:b001:l037","ordinal":70035,"en":"With Khan Kongurbay at their head,"},{"id":"manas-2010:p1627:b001:l038","ordinal":70036,"en":"A countless multitude of Dagger-Hands,"},{"id":"manas-2010:p1627:b001:l039","ordinal":70037,"en":"The Chinese swept upon them."},{"id":"manas-2010:p1627:b001:l040","ordinal":70038,"en":"All forty tribes,"},{"id":"manas-2010:p1627:b001:l041","ordinal":70039,"en":"Making a spectacle of the champion,"},{"id":"manas-2010:p1627:b001:l042","ordinal":70040,"en":"Enclosed him in their midst."},{"id":"manas-2010:p1628:b001:l001","ordinal":70041,"en":"Of the jacket-wearing Chinese,"},{"id":"manas-2010:p1628:b001:l002","ordinal":70042,"en":"The strongest took countless lances,"},{"id":"manas-2010:p1628:b001:l003","ordinal":70043,"en":"And swept upon them in force;"},{"id":"manas-2010:p1628:b001:l004","ordinal":70044,"en":"The sun was hidden."},{"id":"manas-2010:p1628:b001:l005","ordinal":70045,"en":"Of the Chinese with rank-buttons,"},{"id":"manas-2010:p1628:b001:l006","ordinal":70046,"en":"The finest separated out."},{"id":"manas-2010:p1628:b001:l007","ordinal":70047,"en":"To the watching Muslims,"},{"id":"manas-2010:p1628:b001:l008","ordinal":70048,"en":"These Chinese seemed about to leave"},{"id":"manas-2010:p1628:b001:l009","ordinal":70049,"en":"Not one alive."},{"id":"manas-2010:p1628:b001:l010","ordinal":70050,"en":"As the people grew exhausted,"},{"id":"manas-2010:p1628:b001:l011","ordinal":70051,"en":"Your marvelous lion Alma,"},{"id":"manas-2010:p1628:b001:l012","ordinal":70052,"en":"Sarala with cowlike lean haunches,"},{"id":"manas-2010:p1628:b001:l013","ordinal":70053,"en":"The dear lion held in check."},{"id":"manas-2010:p1628:b001:l014","ordinal":70054,"en":"Cloudy by day, clear at night,"},{"id":"manas-2010:p1628:b001:l015","ordinal":70055,"en":"The dear hero worked weather spells."},{"id":"manas-2010:p1628:b001:l016","ordinal":70056,"en":"Hail fell over all the foothills,"},{"id":"manas-2010:p1628:b001:l017","ordinal":70057,"en":"Rain fell over all the lowlands,"},{"id":"manas-2010:p1628:b001:l018","ordinal":70058,"en":"Clouds were driven from the sky,"},{"id":"manas-2010:p1628:b001:l019","ordinal":70059,"en":"Clouds spread over the earth."},{"id":"manas-2010:p1628:b001:l020","ordinal":70060,"en":"Turning summer's day to winter,"},{"id":"manas-2010:p1628:b001:l021","ordinal":70061,"en":"The thinly clad Chinese"},{"id":"manas-2010:p1628:b001:l022","ordinal":70062,"en":"He made whimper like girls."},{"id":"manas-2010:p1628:b001:l023","ordinal":70063,"en":"Was Sarala not a noble steed?"},{"id":"manas-2010:p1628:b001:l024","ordinal":70064,"en":"Gripping the reins in his fists,"},{"id":"manas-2010:p1628:b001:l025","ordinal":70065,"en":"Almambet kept drawing them in."},{"id":"manas-2010:p1628:b001:l026","ordinal":70066,"en":"That great multitude of Kalmyks,"},{"id":"manas-2010:p1628:b001:l027","ordinal":70067,"en":"Throwing them right and left,"},{"id":"manas-2010:p1628:b001:l028","ordinal":70068,"en":"Almambet slew."},{"id":"manas-2010:p1628:b001:l029","ordinal":70069,"en":"His comrade Chubak at his side,"},{"id":"manas-2010:p1628:b001:l030","ordinal":70070,"en":"Argynkhan's Azhybay,"},{"id":"manas-2010:p1628:b001:l031","ordinal":70071,"en":"A companion close to his very soul,"},{"id":"manas-2010:p1628:b001:l032","ordinal":70072,"en":"Had joined with him,"},{"id":"manas-2010:p1628:b001:l033","ordinal":70073,"en":"And Khan Manas's heroes called the forty companions."},{"id":"manas-2010:p1628:b001:l034","ordinal":70074,"en":"Through their center, Almambet"},{"id":"manas-2010:p1628:b001:l035","ordinal":70075,"en":"Came gouging a path."},{"id":"manas-2010:p1628:b001:l036","ordinal":70076,"en":"Around their edges, the forty wolves"},{"id":"manas-2010:p1628:b001:l037","ordinal":70077,"en":"Came slaughtering."},{"id":"manas-2010:p1628:b001:l038","ordinal":70078,"en":"Their broad flank, Khan Chubak"},{"id":"manas-2010:p1628:b001:l039","ordinal":70079,"en":"Came hemming in."},{"id":"manas-2010:p1628:b001:l040","ordinal":70080,"en":"Their very center, the Muslims"},{"id":"manas-2010:p1628:b001:l041","ordinal":70081,"en":"Came tearing apart."},{"id":"manas-2010:p1628:b001:l042","ordinal":70082,"en":"In that ravaging battle,"},{"id":"manas-2010:p1629:b001:l001","ordinal":70083,"en":"His staring eyes like the morning star,"},{"id":"manas-2010:p1629:b001:l002","ordinal":70084,"en":"His great ears like shields,"},{"id":"manas-2010:p1629:b001:l003","ordinal":70085,"en":"Whose blessing enriched the people,"},{"id":"manas-2010:p1629:b001:l004","ordinal":70086,"en":"There was old King Koshoy;"},{"id":"manas-2010:p1629:b001:l005","ordinal":70087,"en":"Zhamgyrchy of the Eshtek,"},{"id":"manas-2010:p1629:b001:l006","ordinal":70088,"en":"Eleman's brave Töshtük—"},{"id":"manas-2010:p1629:b001:l007","ordinal":70089,"en":"Indeed, all the Muslims were there."},{"id":"manas-2010:p1629:b001:l008","ordinal":70090,"en":"In the battle they had charged into,"},{"id":"manas-2010:p1629:b001:l009","ordinal":70091,"en":"Their tusks jutting,"},{"id":"manas-2010:p1629:b001:l010","ordinal":70092,"en":"There were many dead horses;"},{"id":"manas-2010:p1629:b001:l011","ordinal":70093,"en":"Their moustaches sticking out,"},{"id":"manas-2010:p1629:b001:l012","ordinal":70094,"en":"There were many dead heroes."},{"id":"manas-2010:p1629:b001:l013","ordinal":70095,"en":"Their lances broken at the middle,"},{"id":"manas-2010:p1629:b001:l014","ordinal":70096,"en":"Utterly at their wits' end,"},{"id":"manas-2010:p1629:b001:l015","ordinal":70097,"en":"Many more hurried about."},{"id":"manas-2010:p1629:b001:l016","ordinal":70098,"en":"Their cruppers broken,"},{"id":"manas-2010:p1629:b001:l017","ordinal":70099,"en":"Their saddles slipped to their horses' necks,"},{"id":"manas-2010:p1629:b001:l018","ordinal":70100,"en":"“Now we are being slaughtered!”"},{"id":"manas-2010:p1629:b001:l019","ordinal":70101,"en":"Many more fled crying."},{"id":"manas-2010:p1629:b001:l020","ordinal":70102,"en":"Many mules and steeds,"},{"id":"manas-2010:p1629:b001:l021","ordinal":70103,"en":"Their saddles and cloths beneath their bellies,"},{"id":"manas-2010:p1629:b001:l022","ordinal":70104,"en":"Many more went leaping about."},{"id":"manas-2010:p1629:b001:l023","ordinal":70105,"en":"“My precious dear brother,"},{"id":"manas-2010:p1629:b001:l024","ordinal":70106,"en":"Where shall I see you now?”"},{"id":"manas-2010:p1629:b001:l025","ordinal":70107,"en":"Many more went weeping."},{"id":"manas-2010:p1629:b001:l026","ordinal":70108,"en":"All the brave warriors"},{"id":"manas-2010:p1629:b001:l027","ordinal":70109,"en":"Spread out along the edges;"},{"id":"manas-2010:p1629:b001:l028","ordinal":70110,"en":"All the worthless ones,"},{"id":"manas-2010:p1629:b001:l029","ordinal":70111,"en":"Untaken by God, milling about,"},{"id":"manas-2010:p1629:b001:l030","ordinal":70112,"en":"Were hemmed in at the middle."},{"id":"manas-2010:p1629:b001:l031","ordinal":70113,"en":"Giving strength to the whip,"},{"id":"manas-2010:p1629:b001:l032","ordinal":70114,"en":"All the leopards"},{"id":"manas-2010:p1629:b001:l033","ordinal":70115,"en":"Separated along the edges."},{"id":"manas-2010:p1629:b001:l034","ordinal":70116,"en":"In the great clash of battle,"},{"id":"manas-2010:p1629:b001:l035","ordinal":70117,"en":"Human blood was shed."},{"id":"manas-2010:p1629:b001:l036","ordinal":70118,"en":"See the dust of flying earth,"},{"id":"manas-2010:p1629:b001:l037","ordinal":70119,"en":"See the blood flowing away,"},{"id":"manas-2010:p1629:b001:l038","ordinal":70120,"en":"Hunched among the blood,"},{"id":"manas-2010:p1629:b001:l039","ordinal":70121,"en":"See the souls lying dead!"},{"id":"manas-2010:p1629:b001:l040","ordinal":70122,"en":"The sun flickered, hidden from view."},{"id":"manas-2010:p1629:b001:l041","ordinal":70123,"en":"The sun's face was shrouded in dust,"},{"id":"manas-2010:p1629:b001:l042","ordinal":70124,"en":"Beyond the reach of the eye,"},{"id":"manas-2010:p1630:b001:l001","ordinal":70125,"en":"That accursed mass of battle—"},{"id":"manas-2010:p1630:b001:l002","ordinal":70126,"en":"No one could tell which was which!"},{"id":"manas-2010:p1630:b001:l003","ordinal":70127,"en":"As they fought their running skirmish,"},{"id":"manas-2010:p1630:b001:l004","ordinal":70128,"en":"When the Chinese fled,"},{"id":"manas-2010:p1630:b001:l005","ordinal":70129,"en":"Shouting, drawing in his horse’s reins,"},{"id":"manas-2010:p1630:b001:l006","ordinal":70130,"en":"He gathered them, did you see?"},{"id":"manas-2010:p1630:b001:l007","ordinal":70131,"en":"His six san of Black Chinese,"},{"id":"manas-2010:p1630:b001:l008","ordinal":70132,"en":"Kongurbay turned back"},{"id":"manas-2010:p1630:b001:l009","ordinal":70133,"en":"And slaughtered them, did you see?"},{"id":"manas-2010:p1630:b001:l010","ordinal":70134,"en":"Separating out his marksmen,"},{"id":"manas-2010:p1630:b001:l011","ordinal":70135,"en":"“Slaughter whatever you face!” he said,"},{"id":"manas-2010:p1630:b001:l012","ordinal":70136,"en":"And rushed in chanting, did you see?"},{"id":"manas-2010:p1630:b001:l013","ordinal":70137,"en":"Kün Jangjung and the giant Döödür,"},{"id":"manas-2010:p1630:b001:l014","ordinal":70138,"en":"Their blood surging, sparing nothing,"},{"id":"manas-2010:p1630:b001:l015","ordinal":70139,"en":"The massed Chinese entered."},{"id":"manas-2010:p1630:b001:l016","ordinal":70140,"en":"The mighty host swept over them."},{"id":"manas-2010:p1630:b001:l017","ordinal":70141,"en":"(What you see today is gone tomorrow;"},{"id":"manas-2010:p1630:b001:l018","ordinal":70142,"en":"Such is this unruly world!)"},{"id":"manas-2010:p1630:b001:l019","ordinal":70143,"en":"The massed Manchus grew frenzied;"},{"id":"manas-2010:p1630:b001:l020","ordinal":70144,"en":"Khan Kongurbay, mighty Kalcha,"}]
