[{"id":"semetey-1-2013:p1243:b005:l033","ordinal":172033,"en":"You do not know your own brutality;"},{"id":"semetey-1-2013:p1243:b005:l034","ordinal":172034,"en":"Father and mother—"},{"id":"semetey-1-2013:p1243:b005:l035","ordinal":172035,"en":"You curse them and make them a mockery."},{"id":"semetey-1-2013:p1243:b005:l036","ordinal":172036,"en":"Crying, ‘A boy speared me,’"},{"id":"semetey-1-2013:p1243:b005:l037","ordinal":172037,"en":"You come shouting."},{"id":"semetey-1-2013:p1243:b005:l038","ordinal":172038,"en":"My blustering Toltoy,"},{"id":"semetey-1-2013:p1243:b005:l039","ordinal":172039,"en":"If you continue thus, you will die!"},{"id":"semetey-1-2013:p1244:b003:l001","ordinal":172040,"en":"Becoming a stranger to the Argyn people,"},{"id":"semetey-1-2013:p1244:b003:l002","ordinal":172041,"en":"Was it wrong that I came to your village?"},{"id":"semetey-1-2013:p1244:b003:l003","ordinal":172042,"en":"You seem to have been defeated—"},{"id":"semetey-1-2013:p1244:b003:l004","ordinal":172043,"en":"Are all twelve parts of your body whole?"},{"id":"semetey-1-2013:p1244:b003:l005","ordinal":172044,"en":"Ill-fated Khan Toltoi,"},{"id":"semetey-1-2013:p1244:b003:l006","ordinal":172045,"en":"What shall I do with your lies?"},{"id":"semetey-1-2013:p1244:b003:l007","ordinal":172046,"en":"You said countless men led by Manas"},{"id":"semetey-1-2013:p1244:b003:l008","ordinal":172047,"en":"Had emerged from Batkal—"},{"id":"semetey-1-2013:p1244:b003:l009","ordinal":172048,"en":"Was this not a lie?"},{"id":"semetey-1-2013:p1244:b003:l010","ordinal":172049,"en":"Manas blessed by Kydyr had died"},{"id":"semetey-1-2013:p1244:b003:l011","ordinal":172050,"en":"And beheld the place of Judgment."},{"id":"semetey-1-2013:p1244:b003:l012","ordinal":172051,"en":"Saying Bakai had appeared,"},{"id":"semetey-1-2013:p1244:b003:l013","ordinal":172052,"en":"You spoke meaningless words."},{"id":"semetey-1-2013:p1244:b003:l014","ordinal":172053,"en":"Lord Bakai had been a khan;"},{"id":"semetey-1-2013:p1244:b003:l015","ordinal":172054,"en":"When his prince passed away,"},{"id":"semetey-1-2013:p1244:b003:l016","ordinal":172055,"en":"Herding camels in Talas,"},{"id":"semetey-1-2013:p1244:b003:l017","ordinal":172056,"en":"He was a broken man."},{"id":"semetey-1-2013:p1244:b003:l018","ordinal":172057,"en":"Saying Almambet had appeared,"},{"id":"semetey-1-2013:p1244:b003:l019","ordinal":172058,"en":"You spoke in reckless haste;"},{"id":"semetey-1-2013:p1244:b003:l020","ordinal":172059,"en":"He went to behold the face of Judgment,"},{"id":"semetey-1-2013:p1244:b003:l021","ordinal":172060,"en":"And has long been dead."},{"id":"semetey-1-2013:p1244:b003:l022","ordinal":172061,"en":"Saying Chubak had entered,"},{"id":"semetey-1-2013:p1244:b003:l023","ordinal":172062,"en":"You spread an uproar."},{"id":"semetey-1-2013:p1244:b003:l024","ordinal":172063,"en":"A star was eclipsed in the sky;"},{"id":"semetey-1-2013:p1244:b003:l025","ordinal":172064,"en":"In cowardice, Chubak fled Beijing"},{"id":"semetey-1-2013:p1244:b003:l026","ordinal":172065,"en":"And escaped alive."},{"id":"semetey-1-2013:p1244:b003:l027","ordinal":172066,"en":"He was a coward then;"},{"id":"semetey-1-2013:p1244:b003:l028","ordinal":172067,"en":"No one knows where he went."},{"id":"semetey-1-2013:p1244:b003:l029","ordinal":172068,"en":"Speaking so many useless words,"},{"id":"semetey-1-2013:p1244:b003:l030","ordinal":172069,"en":"Toltoi, you will never prosper;"},{"id":"semetey-1-2013:p1244:b003:l031","ordinal":172070,"en":"If you continue like this, poor man,"},{"id":"semetey-1-2013:p1244:b003:l032","ordinal":172071,"en":"There will never be another like you!"},{"id":"semetey-1-2013:p1244:b003:l033","ordinal":172072,"en":"“The shameless face"},{"id":"semetey-1-2013:p1244:b003:l034","ordinal":172073,"en":"Of that accursed Toltoi,"},{"id":"semetey-1-2013:p1244:b003:l035","ordinal":172074,"en":"Who has caused so much trouble”—"},{"id":"semetey-1-2013:p1244:b003:l036","ordinal":172075,"en":"As though slaughter had struck him,"},{"id":"semetey-1-2013:p1244:b003:l037","ordinal":172076,"en":"He lay twisted aside."},{"id":"semetey-1-2013:p1244:b003:l038","ordinal":172077,"en":"Saying, “Where is his flesh?”"},{"id":"semetey-1-2013:p1244:b003:l039","ordinal":172078,"en":"Chynkojo’s wrestler,"},{"id":"semetey-1-2013:p1244:b004:l001","ordinal":172079,"en":"Receiving Khojo’s command,"},{"id":"semetey-1-2013:p1244:b004:l002","ordinal":172080,"en":"Looked upon"},{"id":"semetey-1-2013:p1244:b004:l003","ordinal":172081,"en":"Dear hero Toltoi’s wound."},{"id":"semetey-1-2013:p1244:b004:l004","ordinal":172082,"en":"Below the belt at his waist,"},{"id":"semetey-1-2013:p1244:b004:l005","ordinal":172083,"en":"The flesh was torn and flayed,"},{"id":"semetey-1-2013:p1244:b004:l006","ordinal":172084,"en":"Gouged out and blackened,"},{"id":"semetey-1-2013:p1244:b004:l007","ordinal":172085,"en":"And swollen thick"},{"id":"semetey-1-2013:p1244:b004:l008","ordinal":172086,"en":"As though become a dark-red berry."},{"id":"semetey-1-2013:p1244:b004:l009","ordinal":172087,"en":"Among the Jediger host"},{"id":"semetey-1-2013:p1244:b004:l010","ordinal":172088,"en":"His healers were more than could be counted;"},{"id":"semetey-1-2013:p1244:b004:l011","ordinal":172089,"en":"His careful physicians were even more."},{"id":"semetey-1-2013:p1244:b004:l012","ordinal":172090,"en":"The healers gathered,"},{"id":"semetey-1-2013:p1244:b004:l013","ordinal":172091,"en":"Set a cupping horn upon the wound,"},{"id":"semetey-1-2013:p1244:b004:l014","ordinal":172092,"en":"And drew out together"},{"id":"semetey-1-2013:p1244:b004:l015","ordinal":172093,"en":"Every drop of bad blood."},{"id":"semetey-1-2013:p1244:b004:l016","ordinal":172094,"en":"There was medicine called “Üpü”;"},{"id":"semetey-1-2013:p1244:b004:l017","ordinal":172095,"en":"They applied it three times."},{"id":"semetey-1-2013:p1244:b004:l018","ordinal":172096,"en":"There was medicine called “Sebep”;"},{"id":"semetey-1-2013:p1244:b004:l019","ordinal":172097,"en":"They applied that as well."},{"id":"semetey-1-2013:p1244:b004:l020","ordinal":172098,"en":"Though they treated Toltoi,"},{"id":"semetey-1-2013:p1244:b004:l021","ordinal":172099,"en":"Who had come seeking a wife,"},{"id":"semetey-1-2013:p1244:b004:l022","ordinal":172100,"en":"The wound gave off a strange vapor;"},{"id":"semetey-1-2013:p1244:b004:l023","ordinal":172101,"en":"The patterned spear that had passed through"},{"id":"semetey-1-2013:p1244:b004:l024","ordinal":172102,"en":"Carried such a terrible poison."},{"id":"semetey-1-2013:p1244:b004:l025","ordinal":172103,"en":"Its point had been sharpened and formed—"},{"id":"semetey-1-2013:p1244:b004:l026","ordinal":172104,"en":"Semetey’s patterned spear,"},{"id":"semetey-1-2013:p1244:b004:l027","ordinal":172105,"en":"Whose sight delighted a man."},{"id":"semetey-1-2013:p1244:b004:l028","ordinal":172106,"en":"So that whoever it struck would fester and die,"},{"id":"semetey-1-2013:p1244:b004:l029","ordinal":172107,"en":"It had been tempered for six full days"},{"id":"semetey-1-2013:p1244:b004:l030","ordinal":172108,"en":"In a dragon’s venom."},{"id":"semetey-1-2013:p1244:b004:l031","ordinal":172109,"en":"Whenever it made a wound,"},{"id":"semetey-1-2013:p1244:b004:l032","ordinal":172110,"en":"The wound turned foul and festered—"},{"id":"semetey-1-2013:p1244:b004:l033","ordinal":172111,"en":"Such was the patterned spear’s nature."},{"id":"semetey-1-2013:p1244:b004:l034","ordinal":172112,"en":"Khojo saw it and spoke,"},{"id":"semetey-1-2013:p1244:b004:l035","ordinal":172113,"en":"Uttering a secret marvel:"},{"id":"semetey-1-2013:p1244:b004:l036","ordinal":172114,"en":"“No hero drove that spear;"},{"id":"semetey-1-2013:p1244:b004:l037","ordinal":172115,"en":"A child must have thrust it."},{"id":"semetey-1-2013:p1244:b004:l038","ordinal":172116,"en":"A hero does not punch with a spear—"},{"id":"semetey-1-2013:p1244:b004:l039","ordinal":172117,"en":"It was only a shallow thrust."},{"id":"semetey-1-2013:p1245:b003:l001","ordinal":172118,"en":"You have wept for nothing,"},{"id":"semetey-1-2013:p1245:b003:l002","ordinal":172119,"en":"You accursed Toltoi."},{"id":"semetey-1-2013:p1245:b003:l003","ordinal":172120,"en":"If Semetey had speared you, he would not spare you;"},{"id":"semetey-1-2013:p1245:b003:l004","ordinal":172121,"en":"He would never leave you alive."},{"id":"semetey-1-2013:p1245:b003:l005","ordinal":172122,"en":"After Semetey comes Kanchoro—"},{"id":"semetey-1-2013:p1245:b003:l006","ordinal":172123,"en":"What would you do if he speared you?"},{"id":"semetey-1-2013:p1245:b003:l007","ordinal":172124,"en":"You would not remain alive, Toltoi;"},{"id":"semetey-1-2013:p1245:b003:l008","ordinal":172125,"en":"You would depart this world."},{"id":"semetey-1-2013:p1245:b003:l009","ordinal":172126,"en":"Almambet was a Chinese-born man;"},{"id":"semetey-1-2013:p1245:b003:l010","ordinal":172127,"en":"As for this wound that pierced you,"},{"id":"semetey-1-2013:p1245:b003:l011","ordinal":172128,"en":"There is an orphan named Külchoro,"},{"id":"semetey-1-2013:p1245:b003:l012","ordinal":172129,"en":"The son of Almambet."},{"id":"semetey-1-2013:p1245:b003:l013","ordinal":172130,"en":"He was the one who speared you."},{"id":"semetey-1-2013:p1245:b003:l014","ordinal":172131,"en":"Hero Toltoi of the Jediger,"},{"id":"semetey-1-2013:p1245:b003:l015","ordinal":172132,"en":"You do not recognize your own folly;"},{"id":"semetey-1-2013:p1245:b003:l016","ordinal":172133,"en":"Having taken a spear wound from a child,"},{"id":"semetey-1-2013:p1245:b003:l017","ordinal":172134,"en":"You curse everything in sight."},{"id":"semetey-1-2013:p1245:b003:l018","ordinal":172135,"en":"Jediger—damn your father’s grave—"},{"id":"semetey-1-2013:p1245:b003:l019","ordinal":172136,"en":"If you flee, you have eaten filth;"},{"id":"semetey-1-2013:p1245:b003:l020","ordinal":172137,"en":"Consulting in pairs,"},{"id":"semetey-1-2013:p1245:b003:l021","ordinal":172138,"en":"What more did you say?”"},{"id":"semetey-1-2013:p1245:b003:l022","ordinal":172139,"en":"The many Black Jediger,"},{"id":"semetey-1-2013:p1245:b003:l023","ordinal":172140,"en":"With dear Khojo at their head,"},{"id":"semetey-1-2013:p1245:b003:l024","ordinal":172141,"en":"Grieved for Toltoi"},{"id":"semetey-1-2013:p1245:b003:l025","ordinal":172142,"en":"And lay crowded around him."},{"id":"semetey-1-2013:p1245:b003:l026","ordinal":172143,"en":"Seething Khan Toltoi—"},{"id":"semetey-1-2013:p1245:b003:l027","ordinal":172144,"en":"Let us leave him thus,"},{"id":"semetey-1-2013:p1245:b003:l028","ordinal":172145,"en":"Külchoro, who failed to spear him—"},{"id":"semetey-1-2013:p1245:b003:l029","ordinal":172146,"en":"Let us begin the tale from there."},{"id":"semetey-1-2013:p1245:b003:l030","ordinal":172147,"en":"Turning back and sobbing,"},{"id":"semetey-1-2013:p1245:b003:l031","ordinal":172148,"en":"At the end of his recourse, Külchoro"},{"id":"semetey-1-2013:p1245:b003:l032","ordinal":172149,"en":"Screamed and wept in shame:"},{"id":"semetey-1-2013:p1245:b003:l033","ordinal":172150,"en":"“Oh, my deeply dug grave!"},{"id":"semetey-1-2013:p1245:b003:l034","ordinal":172151,"en":"Damn your father’s grave, false world;"},{"id":"semetey-1-2013:p1245:b003:l035","ordinal":172152,"en":"Oh, my sorrow boiling over!”"},{"id":"semetey-1-2013:p1245:b003:l036","ordinal":172153,"en":"Saying these words then,"},{"id":"semetey-1-2013:p1245:b003:l037","ordinal":172154,"en":"He heaved in fury"},{"id":"semetey-1-2013:p1245:b003:l038","ordinal":172155,"en":"And trembled in grief."},{"id":"semetey-1-2013:p1245:b003:l039","ordinal":172156,"en":"“I am a champion of twelve years;"},{"id":"semetey-1-2013:p1245:b004:l001","ordinal":172157,"en":"My death came, yet I did not die."},{"id":"semetey-1-2013:p1245:b004:l002","ordinal":172158,"en":"I was not said to have died by Toltoi"},{"id":"semetey-1-2013:p1245:b004:l003","ordinal":172159,"en":"And did not behold the next world."},{"id":"semetey-1-2013:p1245:b004:l004","ordinal":172160,"en":"Before reaching my full strength,"},{"id":"semetey-1-2013:p1245:b004:l005","ordinal":172161,"en":"I did not die belatedly."},{"id":"semetey-1-2013:p1245:b004:l006","ordinal":172162,"en":"My beloved uncle,"},{"id":"semetey-1-2013:p1245:b004:l007","ordinal":172163,"en":"Without caring for his horse’s worth,"},{"id":"semetey-1-2013:p1245:b004:l008","ordinal":172164,"en":"Gave me his horse unstintingly."},{"id":"semetey-1-2013:p1245:b004:l009","ordinal":172165,"en":"What shall I do with this hellish world?"},{"id":"semetey-1-2013:p1245:b004:l010","ordinal":172166,"en":"My mountain-like uncle,"},{"id":"semetey-1-2013:p1245:b004:l011","ordinal":172167,"en":"Without caring for his armor’s worth,"},{"id":"semetey-1-2013:p1245:b004:l012","ordinal":172168,"en":"Gave me his armor unstintingly."},{"id":"semetey-1-2013:p1245:b004:l013","ordinal":172169,"en":"Mountain-like great Toltoi"},{"id":"semetey-1-2013:p1245:b004:l014","ordinal":172170,"en":"Fled bobbing away; I speared at him—"},{"id":"semetey-1-2013:p1245:b004:l015","ordinal":172171,"en":"How can I return, unworthy?"},{"id":"semetey-1-2013:p1245:b004:l016","ordinal":172172,"en":"My heart sinks; death is just."},{"id":"semetey-1-2013:p1245:b004:l017","ordinal":172173,"en":"If I serve faithfully, my heart is pure;"},{"id":"semetey-1-2013:p1245:b004:l018","ordinal":172174,"en":"After turning back, unable to spear"},{"id":"semetey-1-2013:p1245:b004:l019","ordinal":172175,"en":"That doomed Toltoi,"},{"id":"semetey-1-2013:p1245:b004:l020","ordinal":172176,"en":"Death is better than this disgrace!"},{"id":"semetey-1-2013:p1245:b004:l021","ordinal":172177,"en":"My beloved khan and uncle,"},{"id":"semetey-1-2013:p1245:b004:l022","ordinal":172178,"en":"Saying, ‘May his heart be rich with fat,’"},{"id":"semetey-1-2013:p1245:b004:l023","ordinal":172179,"en":"Fed him thick slices from the ribs;"},{"id":"semetey-1-2013:p1245:b004:l024","ordinal":172180,"en":"When did he ever let"},{"id":"semetey-1-2013:p1245:b004:l025","ordinal":172181,"en":"Argyn or Kyrgyz call me a mere child?"},{"id":"semetey-1-2013:p1245:b004:l026","ordinal":172182,"en":"We kicked together as foals and yearlings;"},{"id":"semetey-1-2013:p1245:b004:l027","ordinal":172183,"en":"My leopard uncle and I"},{"id":"semetey-1-2013:p1245:b004:l028","ordinal":172184,"en":"Fought to suck the same breast."},{"id":"semetey-1-2013:p1245:b004:l029","ordinal":172185,"en":"The stallion that could carry Altai—"},{"id":"semetey-1-2013:p1245:b004:l030","ordinal":172186,"en":"Unable to take that fool Toltoi,"},{"id":"semetey-1-2013:p1245:b004:l031","ordinal":172187,"en":"I stand wailing and weeping."},{"id":"semetey-1-2013:p1245:b004:l032","ordinal":172188,"en":"Toltoi of the Jediger—"},{"id":"semetey-1-2013:p1245:b004:l033","ordinal":172189,"en":"I thought him a hero, but he was lesser;"},{"id":"semetey-1-2013:p1245:b004:l034","ordinal":172190,"en":"The accursed, pale Toltoi"},{"id":"semetey-1-2013:p1245:b004:l035","ordinal":172191,"en":"Was level with the black earth."},{"id":"semetey-1-2013:p1245:b004:l036","ordinal":172192,"en":"When I shouted and leveled my spear,"},{"id":"semetey-1-2013:p1245:b004:l037","ordinal":172193,"en":"Though I am twelve years old,"},{"id":"semetey-1-2013:p1245:b004:l038","ordinal":172194,"en":"I lacked the strength to take Toltoi."},{"id":"semetey-1-2013:p1245:b004:l039","ordinal":172195,"en":"When I go in to my uncle,"},{"id":"semetey-1-2013:p1246:b003:l001","ordinal":172196,"en":"I do not even have a wound to show."},{"id":"semetey-1-2013:p1246:b003:l002","ordinal":172197,"en":"Unable to match Toltoi’s strength,"},{"id":"semetey-1-2013:p1246:b003:l003","ordinal":172198,"en":"Was I to return crestfallen?"},{"id":"semetey-1-2013:p1246:b003:l004","ordinal":172199,"en":"So this is what the filthy world is."},{"id":"semetey-1-2013:p1246:b003:l005","ordinal":172200,"en":"Wishing to die but unable,"},{"id":"semetey-1-2013:p1246:b003:l006","ordinal":172201,"en":"A strange ordeal befell my head;"},{"id":"semetey-1-2013:p1246:b003:l007","ordinal":172202,"en":"I could not take my own life."},{"id":"semetey-1-2013:p1246:b003:l008","ordinal":172203,"en":"How can I go without shame"},{"id":"semetey-1-2013:p1246:b003:l009","ordinal":172204,"en":"To my mountain-like uncle"},{"id":"semetey-1-2013:p1246:b003:l010","ordinal":172205,"en":"And say, ‘Toltoi escaped’?"},{"id":"semetey-1-2013:p1246:b003:l011","ordinal":172206,"en":"Speaking thus in this way,"},{"id":"semetey-1-2013:p1246:b003:l012","ordinal":172207,"en":"His heart was grievously torn;"},{"id":"semetey-1-2013:p1246:b003:l013","ordinal":172208,"en":"Unable to cease his sorrow,"},{"id":"semetey-1-2013:p1246:b003:l014","ordinal":172209,"en":"What could dear Choro do?"},{"id":"semetey-1-2013:p1246:b003:l015","ordinal":172210,"en":"Tears poured from his eyes."},{"id":"semetey-1-2013:p1246:b003:l016","ordinal":172211,"en":"Perhaps I should take"},{"id":"semetey-1-2013:p1246:b003:l017","ordinal":172212,"en":"The gold-cheeked battle-axe now,"},{"id":"semetey-1-2013:p1246:b003:l018","ordinal":172213,"en":"Smash my own head,"},{"id":"semetey-1-2013:p1246:b003:l019","ordinal":172214,"en":"And leave myself wounded."},{"id":"semetey-1-2013:p1246:b003:l020","ordinal":172215,"en":"I could reach my uncle moaning,"},{"id":"semetey-1-2013:p1246:b003:l021","ordinal":172216,"en":"Saying, ‘Toltoi struck me without mercy!’"},{"id":"semetey-1-2013:p1246:b003:l022","ordinal":172217,"en":"When I come groaning in pain,"},{"id":"semetey-1-2013:p1246:b003:l023","ordinal":172218,"en":"Would that valley-spring, sheer cliff,"},{"id":"semetey-1-2013:p1246:b003:l024","ordinal":172219,"en":"Learn by chance that I struck myself"},{"id":"semetey-1-2013:p1246:b003:l025","ordinal":172220,"en":"With the axe?"},{"id":"semetey-1-2013:p1246:b003:l026","ordinal":172221,"en":"That double-wiled shrew"},{"id":"semetey-1-2013:p1246:b003:l027","ordinal":172222,"en":"Was a wondrous servant woman,"},{"id":"semetey-1-2013:p1246:b003:l028","ordinal":172223,"en":"One of the overbearing ones,"},{"id":"semetey-1-2013:p1246:b003:l029","ordinal":172224,"en":"A person of sacred power."},{"id":"semetey-1-2013:p1246:b003:l030","ordinal":172225,"en":"She knew today"},{"id":"semetey-1-2013:p1246:b003:l031","ordinal":172226,"en":"The suffering that would come in six months."},{"id":"semetey-1-2013:p1246:b003:l032","ordinal":172227,"en":"Rather than that, let me go to my uncle"},{"id":"semetey-1-2013:p1246:b003:l033","ordinal":172228,"en":"And tell the truth,"},{"id":"semetey-1-2013:p1246:b003:l034","ordinal":172229,"en":"Saying, ‘The hardship happened this way.’"},{"id":"semetey-1-2013:p1246:b003:l035","ordinal":172230,"en":"Like a prince sunk in sorrow,"},{"id":"semetey-1-2013:p1246:b003:l036","ordinal":172231,"en":"Young Külchoro grieved."},{"id":"semetey-1-2013:p1246:b003:l037","ordinal":172232,"en":"As though his khan father, lion Almambet,"},{"id":"semetey-1-2013:p1246:b003:l038","ordinal":172233,"en":"Had died,"},{"id":"semetey-1-2013:p1246:b003:l039","ordinal":172234,"en":"Unable to cease his lament,"},{"id":"semetey-1-2013:p1246:b004:l001","ordinal":172235,"en":"He turned back toward Afghanistan;"},{"id":"semetey-1-2013:p1246:b004:l002","ordinal":172236,"en":"Having let Khan Toltoi escape,"},{"id":"semetey-1-2013:p1246:b004:l003","ordinal":172237,"en":"Your young man returned grieving."},{"id":"semetey-1-2013:p1246:b004:l004","ordinal":172238,"en":"His heart remained torn apart;"},{"id":"semetey-1-2013:p1246:b004:l005","ordinal":172239,"en":"A spirit descended upon the orphan,"},{"id":"semetey-1-2013:p1246:b004:l006","ordinal":172240,"en":"And he looked as large as Mount Opol."},{"id":"semetey-1-2013:p1246:b004:l007","ordinal":172241,"en":"Beneath him, the great Buurul"},{"id":"semetey-1-2013:p1246:b004:l008","ordinal":172242,"en":"Pounded onward with a rolling gait,"},{"id":"semetey-1-2013:p1246:b004:l009","ordinal":172243,"en":"Loping in great bounds."},{"id":"semetey-1-2013:p1246:b004:l010","ordinal":172244,"en":"When he drew near the city,"},{"id":"semetey-1-2013:p1246:b004:l011","ordinal":172245,"en":"A star separated in the sky;"},{"id":"semetey-1-2013:p1246:b004:l012","ordinal":172246,"en":"Dawn loomed into view,"},{"id":"semetey-1-2013:p1246:b004:l013","ordinal":172247,"en":"Clouds scattered in the heavens,"},{"id":"semetey-1-2013:p1246:b004:l014","ordinal":172248,"en":"And the face of dawn opened."},{"id":"semetey-1-2013:p1246:b004:l015","ordinal":172249,"en":"As dawn drove back the dark,"},{"id":"semetey-1-2013:p1246:b004:l016","ordinal":172250,"en":"And hazy light touched the earth,"},{"id":"semetey-1-2013:p1246:b004:l017","ordinal":172251,"en":"The cold wind of morning whistled,"},{"id":"semetey-1-2013:p1246:b004:l018","ordinal":172252,"en":"Young larks chirped,"},{"id":"semetey-1-2013:p1246:b004:l019","ordinal":172253,"en":"The face of the steppe bent in light,"},{"id":"semetey-1-2013:p1246:b004:l020","ordinal":172254,"en":"Lines appeared upon the sand."},{"id":"semetey-1-2013:p1246:b004:l021","ordinal":172255,"en":"The earth appeared and dawn broke;"},{"id":"semetey-1-2013:p1246:b004:l022","ordinal":172256,"en":"When he drew near the city,"},{"id":"semetey-1-2013:p1246:b004:l023","ordinal":172257,"en":"A gaunt figure came into view."},{"id":"semetey-1-2013:p1246:b004:l024","ordinal":172258,"en":"When he saw that figure,"},{"id":"semetey-1-2013:p1246:b004:l025","ordinal":172259,"en":"Lion prince Külchoro’s"},{"id":"semetey-1-2013:p1246:b004:l026","ordinal":172260,"en":"Heart was grievously torn."},{"id":"semetey-1-2013:p1246:b004:l027","ordinal":172261,"en":"Your gray-wolf uncle Semetey,"},{"id":"semetey-1-2013:p1246:b004:l028","ordinal":172262,"en":"Unable to calm or endure his heart,"},{"id":"semetey-1-2013:p1246:b004:l029","ordinal":172263,"en":"Appeared coming to meet him."},{"id":"semetey-1-2013:p1246:b004:l030","ordinal":172264,"en":"“My twin lamb, my matching half,"},{"id":"semetey-1-2013:p1246:b004:l031","ordinal":172265,"en":"Parted from my twin,"},{"id":"semetey-1-2013:p1246:b004:l032","ordinal":172266,"en":"How can I go on now?"},{"id":"semetey-1-2013:p1246:b004:l033","ordinal":172267,"en":"Unable to cease grieving"},{"id":"semetey-1-2013:p1246:b004:l034","ordinal":172268,"en":"Over the twelve-year-old child,"},{"id":"semetey-1-2013:p1246:b004:l035","ordinal":172269,"en":"Raging and champing for battle,"},{"id":"semetey-1-2013:p1246:b004:l036","ordinal":172270,"en":"Wondering, ‘What has happened?’"},{"id":"semetey-1-2013:p1246:b004:l037","ordinal":172271,"en":"Before dawn your gray wolf"},{"id":"semetey-1-2013:p1246:b004:l038","ordinal":172272,"en":"Had mounted and ridden out."},{"id":"semetey-1-2013:p1246:b004:l039","ordinal":172273,"en":"When he saw Külchoro,"},{"id":"semetey-1-2013:p1247:b003:l001","ordinal":172274,"en":"Brave Semey, son of Manas,"},{"id":"semetey-1-2013:p1247:b003:l002","ordinal":172275,"en":"A hero vast as river and lake,"},{"id":"semetey-1-2013:p1247:b003:l003","ordinal":172276,"en":"Quickly invoking Babedin,"},{"id":"semetey-1-2013:p1247:b003:l004","ordinal":172277,"en":"To the path of the one God"},{"id":"semetey-1-2013:p1247:b003:l005","ordinal":172278,"en":"He pledged six fat horses;"},{"id":"semetey-1-2013:p1247:b003:l006","ordinal":172279,"en":"To the spirit of his father Manas"},{"id":"semetey-1-2013:p1247:b003:l007","ordinal":172280,"en":"He also pledged a white-gray mare."},{"id":"semetey-1-2013:p1247:b003:l008","ordinal":172281,"en":"To the spirit of his elder,"},{"id":"semetey-1-2013:p1247:b003:l009","ordinal":172282,"en":"He pledged a two-humped camel."},{"id":"semetey-1-2013:p1247:b003:l010","ordinal":172283,"en":"Destroying the kalday was hard work."},{"id":"semetey-1-2013:p1247:b003:l011","ordinal":172284,"en":"Gathering troops from many lands,"},{"id":"semetey-1-2013:p1247:b003:l012","ordinal":172285,"en":"When he saw Kulchoro,"},{"id":"semetey-1-2013:p1247:b003:l013","ordinal":172286,"en":"The dear prince could not remain still;"},{"id":"semetey-1-2013:p1247:b003:l014","ordinal":172287,"en":"His heart softened and he sobbed."},{"id":"semetey-1-2013:p1247:b003:l015","ordinal":172288,"en":"“I have seen your figure—"}]
