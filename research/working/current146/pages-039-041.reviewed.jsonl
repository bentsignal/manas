{"id": "sayakbay-ms-current146:pdf039:l035", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 39, "folio": 422, "line_in_page": 35, "raw": "Өзөндүүсүн бузалы,", "text": "Өзөндүүсүн бузалы,", "en": "[Uncertain: Let us devastate their valleys.]", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Өзөндүүсүн is provisional, but final verb is бузалы, not буралы.", "bbox": null}
