[{"id":"semetey-1-2013:p0246:b004:l038","ordinal":95745,"en":"On the plain of Orgo-Beijing,"},{"id":"semetey-1-2013:p0246:b004:l039","ordinal":95746,"en":"In the city on this nearer side,"},{"id":"semetey-1-2013:p0247:b003:l001","ordinal":95747,"en":"With a white musket, a red ember,"},{"id":"semetey-1-2013:p0247:b003:l002","ordinal":95748,"en":"Kongurbay, son of Alööke,"},{"id":"semetey-1-2013:p0247:b003:l003","ordinal":95749,"en":"Was their famous warrior."},{"id":"semetey-1-2013:p0247:b003:l004","ordinal":95750,"en":"In the fortress of Beijing,"},{"id":"semetey-1-2013:p0247:b003:l005","ordinal":95751,"en":"Almambet, son of Azozyl,"},{"id":"semetey-1-2013:p0247:b003:l006","ordinal":95752,"en":"When he turned twelve,"},{"id":"semetey-1-2013:p0247:b003:l007","ordinal":95753,"en":"The tip of the spear bent."},{"id":"semetey-1-2013:p0247:b003:l008","ordinal":95754,"en":"Kongurbay, son of Alööke—"},{"id":"semetey-1-2013:p0247:b003:l009","ordinal":95755,"en":"Six thousand Chinese, countless governors—"},{"id":"semetey-1-2013:p0247:b003:l010","ordinal":95756,"en":"If you ask for their greatest warrior,"},{"id":"semetey-1-2013:p0247:b003:l011","ordinal":95757,"en":"He raged upon Algara,"},{"id":"semetey-1-2013:p0247:b003:l012","ordinal":95758,"en":"Kongurbay, son of Alööke."},{"id":"semetey-1-2013:p0247:b003:l013","ordinal":95759,"en":"When God granted his wish,"},{"id":"semetey-1-2013:p0247:b003:l014","ordinal":95760,"en":"When Almambet reached twelve,"},{"id":"semetey-1-2013:p0247:b003:l016","ordinal":95761,"en":"Because of Khan-Jaylak,"},{"id":"semetey-1-2013:p0247:b003:l017","ordinal":95762,"en":"Over the matter of the gold mine,"},{"id":"semetey-1-2013:p0247:b003:l018","ordinal":95763,"en":"They barely escaped death."},{"id":"semetey-1-2013:p0247:b003:l019","ordinal":95764,"en":"Kongurbay and Almambet"},{"id":"semetey-1-2013:p0247:b003:l020","ordinal":95765,"en":"Fought with spears for twelve days."},{"id":"semetey-1-2013:p0247:b003:l021","ordinal":95766,"en":"Merciless torment,"},{"id":"semetey-1-2013:p0247:b003:l022","ordinal":95767,"en":"Your lord, dear Almambet, upon Beijing"},{"id":"semetey-1-2013:p0247:b003:l023","ordinal":95768,"en":"Had indeed inflicted."},{"id":"semetey-1-2013:p0247:b003:l024","ordinal":95769,"en":"Kongurbay, son of Alööke,"},{"id":"semetey-1-2013:p0247:b003:l025","ordinal":95770,"en":"Six times from his horse—"},{"id":"semetey-1-2013:p0247:b003:l026","ordinal":95771,"en":"Almambet, son of Azyz Khan,"},{"id":"semetey-1-2013:p0247:b003:l027","ordinal":95772,"en":"Six times upon the open plain,"},{"id":"semetey-1-2013:p0247:b003:l028","ordinal":95773,"en":"Your Almambet had unseated him with his spear."},{"id":"semetey-1-2013:p0247:b003:l029","ordinal":95774,"en":"Warrior Kongurbay, that mighty, fearsome man,"},{"id":"semetey-1-2013:p0247:b003:l030","ordinal":95775,"en":"When he had grown weary,"},{"id":"semetey-1-2013:p0247:b003:l031","ordinal":95776,"en":"At Esenkan's gate,"},{"id":"semetey-1-2013:p0247:b003:l032","ordinal":95777,"en":"Warrior Almambet, your fierce one,"},{"id":"semetey-1-2013:p0247:b003:l033","ordinal":95778,"en":"That fearsome man Kongurbay,"},{"id":"semetey-1-2013:p0247:b003:l034","ordinal":95779,"en":"When he had trapped him there,"},{"id":"semetey-1-2013:p0247:b003:l035","ordinal":95780,"en":"When he turned Sarala's head,"},{"id":"semetey-1-2013:p0247:b003:l036","ordinal":95781,"en":"Of Beijing's forty Chinese clans,"},{"id":"semetey-1-2013:p0247:b003:l037","ordinal":95782,"en":"\"Give me one khanship!\" he said."},{"id":"semetey-1-2013:p0247:b003:l038","ordinal":95783,"en":"When he advanced and laid siege,"},{"id":"semetey-1-2013:p0247:b003:l039","ordinal":95784,"en":"That your Almambet was a hero,"},{"id":"semetey-1-2013:p0247:b004:l001","ordinal":95785,"en":"They had indeed seen."},{"id":"semetey-1-2013:p0247:b004:l002","ordinal":95786,"en":"Then Syrbarang, which guarded the throne,"},{"id":"semetey-1-2013:p0247:b004:l003","ordinal":95787,"en":"The great gun of the treasury,"},{"id":"semetey-1-2013:p0247:b004:l004","ordinal":95788,"en":"As a gift, Esenkan"},{"id":"semetey-1-2013:p0247:b004:l005","ordinal":95789,"en":"To dear Almambet himself"},{"id":"semetey-1-2013:p0247:b004:l006","ordinal":95790,"en":"Had indeed given."},{"id":"semetey-1-2013:p0247:b004:l007","ordinal":95791,"en":"When she took it from her shoulder and looked,"},{"id":"semetey-1-2013:p0247:b004:l008","ordinal":95792,"en":"The outstretched leg is not pulled,"},{"id":"semetey-1-2013:p0247:b004:l009","ordinal":95793,"en":"Unfired for twelve years,"},{"id":"semetey-1-2013:p0247:b004:l010","ordinal":95794,"en":"Its inside filthy as a dog's,"},{"id":"semetey-1-2013:p0247:b004:l011","ordinal":95795,"en":"The rust within it"},{"id":"semetey-1-2013:p0247:b004:l012","ordinal":95796,"en":"Had become one with its interior:"},{"id":"semetey-1-2013:p0247:b004:l013","ordinal":95797,"en":"So Syrbarang had been left."},{"id":"semetey-1-2013:p0247:b004:l014","ordinal":95798,"en":"Then Kanykei said:"},{"id":"semetey-1-2013:p0247:b004:l015","ordinal":95799,"en":"\"My dear Syrbarang,"},{"id":"semetey-1-2013:p0247:b004:l016","ordinal":95800,"en":"You are a widow bereft of your master,"},{"id":"semetey-1-2013:p0247:b004:l017","ordinal":95801,"en":"I am a widow bereft of my husband.\""},{"id":"semetey-1-2013:p0247:b004:l018","ordinal":95802,"en":"Saying these words then,"},{"id":"semetey-1-2013:p0247:b004:l019","ordinal":95803,"en":"She, that truly capable slavewoman,"},{"id":"semetey-1-2013:p0247:b004:l020","ordinal":95804,"en":"Into Syrbarang's mouth"},{"id":"semetey-1-2013:p0247:b004:l021","ordinal":95805,"en":"Now pushed the great scraper."},{"id":"semetey-1-2013:p0247:b004:l022","ordinal":95806,"en":"She scraped with the scraper,"},{"id":"semetey-1-2013:p0247:b004:l023","ordinal":95807,"en":"Worked fiercely, scouring its inside,"},{"id":"semetey-1-2013:p0247:b004:l024","ordinal":95808,"en":"Drew the cleaning rod back and forth,"},{"id":"semetey-1-2013:p0247:b004:l025","ordinal":95809,"en":"Cleaned and wiped its inside,"},{"id":"semetey-1-2013:p0247:b004:l026","ordinal":95810,"en":"Scoured it with the ramrod."},{"id":"semetey-1-2013:p0247:b004:l027","ordinal":95811,"en":"Your tigress sister-in-law Kanykei,"},{"id":"semetey-1-2013:p0247:b004:l028","ordinal":95812,"en":"Almambet's Syrbarang,"},{"id":"semetey-1-2013:p0247:b004:l029","ordinal":95813,"en":"Worked upon it with all her strength."},{"id":"semetey-1-2013:p0247:b004:l030","ordinal":95814,"en":"The reason she could clean it was this:"},{"id":"semetey-1-2013:p0247:b004:l031","ordinal":95815,"en":"Dividing the hair down her back in ten,"},{"id":"semetey-1-2013:p0247:b004:l032","ordinal":95816,"en":"Your sister-in-law had braided it."},{"id":"semetey-1-2013:p0247:b004:l033","ordinal":95817,"en":"While her magnanimous Manas lived,"},{"id":"semetey-1-2013:p0247:b004:l034","ordinal":95818,"en":"Cleaning Akkelte,"},{"id":"semetey-1-2013:p0247:b004:l035","ordinal":95819,"en":"An expert with a gun,"},{"id":"semetey-1-2013:p0247:b004:l036","ordinal":95820,"en":"Your sister-in-law had become."},{"id":"semetey-1-2013:p0247:b004:l037","ordinal":95821,"en":"All the many things he needed,"},{"id":"semetey-1-2013:p0247:b004:l038","ordinal":95822,"en":"She had made in abundance for Manas"},{"id":"semetey-1-2013:p0247:b004:l039","ordinal":95823,"en":"And given them to him."},{"id":"semetey-1-2013:p0248:b003:l001","ordinal":95824,"en":"(She often mended what was broken,"},{"id":"semetey-1-2013:p0248:b003:l002","ordinal":95825,"en":"Often gathered what was scattered,"},{"id":"semetey-1-2013:p0248:b003:l003","ordinal":95826,"en":"Never sat idly looking on,"},{"id":"semetey-1-2013:p0248:b003:l004","ordinal":95827,"en":"But kept warrior Manas safe.)"},{"id":"semetey-1-2013:p0248:b003:l005","ordinal":95828,"en":"Having cleaned Syrbarang inside,"},{"id":"semetey-1-2013:p0248:b003:l006","ordinal":95829,"en":"Your poor, unfortunate sister-in-law"},{"id":"semetey-1-2013:p0248:b003:l007","ordinal":95830,"en":"The powder from its box"},{"id":"semetey-1-2013:p0248:b003:l008","ordinal":95831,"en":"Let fall with a rattle,"},{"id":"semetey-1-2013:p0248:b003:l009","ordinal":95832,"en":"Tipped it toward the muzzle,"},{"id":"semetey-1-2013:p0248:b003:l010","ordinal":95833,"en":"And brought Borchuk's muzzle to bear."},{"id":"semetey-1-2013:p0248:b003:l011","ordinal":95834,"en":"Preparing a blank charge,"},{"id":"semetey-1-2013:p0248:b003:l012","ordinal":95835,"en":"She poured in dry powder."},{"id":"semetey-1-2013:p0248:b003:l013","ordinal":95836,"en":"The familiar great ramrod,"},{"id":"semetey-1-2013:p0248:b003:l014","ordinal":95837,"en":"Your sister-in-law took and turned,"},{"id":"semetey-1-2013:p0248:b003:l015","ordinal":95838,"en":"And drove toward the muzzle."},{"id":"semetey-1-2013:p0248:b003:l016","ordinal":95839,"en":"Working with the ramrod,"},{"id":"semetey-1-2013:p0248:b003:l017","ordinal":95840,"en":"The cock that fired so swiftly,"},{"id":"semetey-1-2013:p0248:b003:l018","ordinal":95841,"en":"She held up and drew back."},{"id":"semetey-1-2013:p0248:b003:l019","ordinal":95842,"en":"Your sister-in-law, unhurried,"},{"id":"semetey-1-2013:p0248:b003:l020","ordinal":95843,"en":"Worked it with the ramrod,"},{"id":"semetey-1-2013:p0248:b003:l021","ordinal":95844,"en":"Tapped its great stock,"},{"id":"semetey-1-2013:p0248:b003:l022","ordinal":95845,"en":"Against the pommel of the broad saddle"},{"id":"semetey-1-2013:p0248:b003:l023","ordinal":95846,"en":"Knocking it with sharp cracks."},{"id":"semetey-1-2013:p0248:b003:l024","ordinal":95847,"en":"Leaning back in the saddle,"},{"id":"semetey-1-2013:p0248:b003:l025","ordinal":95848,"en":"The powder that came from the stock"},{"id":"semetey-1-2013:p0248:b003:l026","ordinal":95849,"en":"She broke up with her fingernail."},{"id":"semetey-1-2013:p0248:b003:l027","ordinal":95850,"en":"The Chinese fire-steel and flint,"},{"id":"semetey-1-2013:p0248:b003:l028","ordinal":95851,"en":"She struck, setting a spark,"},{"id":"semetey-1-2013:p0248:b003:l029","ordinal":95852,"en":"And lit its match."},{"id":"semetey-1-2013:p0248:b003:l030","ordinal":95853,"en":"Your noble sister-in-law Kanykei,"},{"id":"semetey-1-2013:p0248:b003:l031","ordinal":95854,"en":"Crying, \"O God!\""},{"id":"semetey-1-2013:p0248:b003:l032","ordinal":95855,"en":"Turned Akborchuk's head."},{"id":"semetey-1-2013:p0248:b003:l033","ordinal":95856,"en":"With a blank charge,"},{"id":"semetey-1-2013:p0248:b003:l034","ordinal":95857,"en":"That unfortunate woman Kanykei"},{"id":"semetey-1-2013:p0248:b003:l035","ordinal":95858,"en":"Extended Syrbarang."},{"id":"semetey-1-2013:p0248:b003:l036","ordinal":95859,"en":"Your immensely strong mother"},{"id":"semetey-1-2013:p0248:b003:l037","ordinal":95860,"en":"Judged the ground before her."},{"id":"semetey-1-2013:p0248:b003:l038","ordinal":95861,"en":"When she looked at Taytoru,"},{"id":"semetey-1-2013:p0248:b003:l039","ordinal":95862,"en":"On the ridge of Jeti-Moynok,"},{"id":"semetey-1-2013:p0248:b004:l001","ordinal":95863,"en":"Your racer was coming,"},{"id":"semetey-1-2013:p0248:b004:l002","ordinal":95864,"en":"Behind Temir Khan's three horses."},{"id":"semetey-1-2013:p0248:b004:l003","ordinal":95865,"en":"When she saw Taytoru,"},{"id":"semetey-1-2013:p0248:b004:l004","ordinal":95866,"en":"She wept and beat herself,"},{"id":"semetey-1-2013:p0248:b004:l005","ordinal":95867,"en":"Implored the one God."},{"id":"semetey-1-2013:p0248:b004:l006","ordinal":95868,"en":"To fire with a cry of encouragement,"},{"id":"semetey-1-2013:p0248:b004:l007","ordinal":95869,"en":"To draw Taytoru onward,"},{"id":"semetey-1-2013:p0248:b004:l008","ordinal":95870,"en":"She put her belt around her neck."},{"id":"semetey-1-2013:p0248:b004:l009","ordinal":95871,"en":"The poor soul wailed and wept,"},{"id":"semetey-1-2013:p0248:b004:l010","ordinal":95872,"en":"Imploring the Creator."},{"id":"semetey-1-2013:p0248:b004:l011","ordinal":95873,"en":"With a blank charge,"},{"id":"semetey-1-2013:p0248:b004:l012","ordinal":95874,"en":"That unfortunate woman Kanykei,"},{"id":"semetey-1-2013:p0248:b004:l013","ordinal":95875,"en":"Preparing herself for Taytoru,"},{"id":"semetey-1-2013:p0248:b004:l014","ordinal":95876,"en":"Struck the kettledrum once,"},{"id":"semetey-1-2013:p0248:b004:l015","ordinal":95877,"en":"Surpassing herself in valor."},{"id":"semetey-1-2013:p0248:b004:l016","ordinal":95878,"en":"Above his ears and forelock,"},{"id":"semetey-1-2013:p0248:b004:l017","ordinal":95879,"en":"Two fingerbreadths higher,"},{"id":"semetey-1-2013:p0248:b004:l018","ordinal":95880,"en":"With a blank charge,"},{"id":"semetey-1-2013:p0248:b004:l019","ordinal":95881,"en":"Your unfortunate mother Kanykei"},{"id":"semetey-1-2013:p0248:b004:l020","ordinal":95882,"en":"Fired once with a boom."},{"id":"semetey-1-2013:p0248:b004:l021","ordinal":95883,"en":"Taytoru, that extraordinary racer,"},{"id":"semetey-1-2013:p0248:b004:l022","ordinal":95884,"en":"Now lowered his head to the ground."},{"id":"semetey-1-2013:p0248:b004:l023","ordinal":95885,"en":"Pounding the dark earth,"},{"id":"semetey-1-2013:p0248:b004:l024","ordinal":95886,"en":"When he heard Syrbarang's voice,"},{"id":"semetey-1-2013:p0248:b004:l025","ordinal":95887,"en":"He darted forward again and again."},{"id":"semetey-1-2013:p0248:b004:l026","ordinal":95888,"en":"He stretched his stride like a wild ram;"},{"id":"semetey-1-2013:p0248:b004:l027","ordinal":95889,"en":"How mightily he bounded on!"},{"id":"semetey-1-2013:p0248:b004:l028","ordinal":95890,"en":"Your elder Koshoi, my mighty elder,"},{"id":"semetey-1-2013:p0248:b004:l029","ordinal":95891,"en":"Once rode to Beijing."},{"id":"semetey-1-2013:p0248:b004:l030","ordinal":95892,"en":"Manas had not yet existed then;"},{"id":"semetey-1-2013:p0248:b004:l031","ordinal":95893,"en":"Far from that, your Manas"},{"id":"semetey-1-2013:p0248:b004:l032","ordinal":95894,"en":"Had not yet come into the world."},{"id":"semetey-1-2013:p0248:b004:l033","ordinal":95895,"en":"For seven years Khan Koshoi"},{"id":"semetey-1-2013:p0248:b004:l034","ordinal":95896,"en":"Had been in Mecca,"},{"id":"semetey-1-2013:p0248:b004:l035","ordinal":95897,"en":"While the handful of Muslims"},{"id":"semetey-1-2013:p0248:b004:l036","ordinal":95898,"en":"Were ruled by the Chinese,"},{"id":"semetey-1-2013:p0248:b004:l037","ordinal":95899,"en":"Who imposed their own will"},{"id":"semetey-1-2013:p0248:b004:l038","ordinal":95900,"en":"Upon the Muslims."},{"id":"semetey-1-2013:p0248:b004:l039","ordinal":95901,"en":"Making a trough from pinewood,"},{"id":"semetey-1-2013:p0249:b003:l001","ordinal":95902,"en":"Many Chinese gathered,"},{"id":"semetey-1-2013:p0249:b003:l002","ordinal":95903,"en":"Ez-Kara, khan of the Manchu,"},{"id":"semetey-1-2013:p0249:b003:l003","ordinal":95904,"en":"Warrior Joloy, khan of the Kalmyks,"},{"id":"semetey-1-2013:p0249:b003:l004","ordinal":95905,"en":"Ylama, the Chinese giant."},{"id":"semetey-1-2013:p0249:b003:l005","ordinal":95906,"en":"Against Samarkand,"},{"id":"semetey-1-2013:p0249:b003:l006","ordinal":95907,"en":"When they fought and wrought a slaughter,"},{"id":"semetey-1-2013:p0249:b003:l007","ordinal":95908,"en":"Bilerik, son of Aikhoja,"},{"id":"semetey-1-2013:p0249:b003:l008","ordinal":95909,"en":"The Muslims' cherished only son,"},{"id":"semetey-1-2013:p0249:b003:l009","ordinal":95910,"en":"When the Chinese seized him,"},{"id":"semetey-1-2013:p0249:b003:l010","ordinal":95911,"en":"Into a great dungeon forty ropes high,"},{"id":"semetey-1-2013:p0249:b003:l011","ordinal":95912,"en":"When they took him and cast him,"},{"id":"semetey-1-2013:p0249:b003:l012","ordinal":95913,"en":"When God struck those unbelievers,"},{"id":"semetey-1-2013:p0249:b003:l013","ordinal":95914,"en":"Six thousand ingots and a thousand otter pelts"},{"id":"semetey-1-2013:p0249:b003:l014","ordinal":95915,"en":"They demanded as tribute."},{"id":"semetey-1-2013:p0249:b003:l015","ordinal":95916,"en":"At that time, Taytoru"},{"id":"semetey-1-2013:p0249:b003:l016","ordinal":95917,"en":"Was the horse that Khan Koshoi, father of the people,"},{"id":"semetey-1-2013:p0249:b003:l017","ordinal":95918,"en":"Rode on his campaign."},{"id":"semetey-1-2013:p0249:b003:l018","ordinal":95919,"en":"Having suffered humiliation from the unbelievers,"},{"id":"semetey-1-2013:p0249:b003:l019","ordinal":95920,"en":"When Koshoi rode there,"},{"id":"semetey-1-2013:p0249:b003:l020","ordinal":95921,"en":"In Kakanchyn's Beijing,"},{"id":"semetey-1-2013:p0249:b003:l021","ordinal":95922,"en":"When he fought single combats,"},{"id":"semetey-1-2013:p0249:b003:l022","ordinal":95923,"en":"The imprisoned Bilerik,"},{"id":"semetey-1-2013:p0249:b003:l023","ordinal":95924,"en":"When Koshoi won him back,"},{"id":"semetey-1-2013:p0249:b003:l024","ordinal":95925,"en":"The Manchu and Black Kalmyks,"},{"id":"semetey-1-2013:p0249:b003:l025","ordinal":95926,"en":"Their warriors broke into groups,"},{"id":"semetey-1-2013:p0249:b003:l026","ordinal":95927,"en":"Drew their bows like rain."},{"id":"semetey-1-2013:p0249:b003:l027","ordinal":95928,"en":"That slaughter then,"},{"id":"semetey-1-2013:p0249:b003:l028","ordinal":95929,"en":"Taytoru had witnessed."},{"id":"semetey-1-2013:p0249:b003:l029","ordinal":95930,"en":"So many guns and bows,"},{"id":"semetey-1-2013:p0249:b003:l030","ordinal":95931,"en":"The bullets of firing weapons,"},{"id":"semetey-1-2013:p0249:b003:l031","ordinal":95932,"en":"Taytoru had grown used to them."},{"id":"semetey-1-2013:p0249:b003:l032","ordinal":95933,"en":"When the gun's report rang out,"},{"id":"semetey-1-2013:p0249:b003:l033","ordinal":95934,"en":"Taytoru, that splendid racer,"},{"id":"semetey-1-2013:p0249:b003:l034","ordinal":95935,"en":"Now lowered his head to the ground,"},{"id":"semetey-1-2013:p0249:b003:l035","ordinal":95936,"en":"Cast his poor life aside,"},{"id":"semetey-1-2013:p0249:b003:l036","ordinal":95937,"en":"And strode like a wild ram."},{"id":"semetey-1-2013:p0249:b003:l037","ordinal":95938,"en":"When he came before her,"},{"id":"semetey-1-2013:p0249:b003:l038","ordinal":95939,"en":"If you looked closely, Taytoru"},{"id":"semetey-1-2013:p0249:b003:l039","ordinal":95940,"en":"Had broken away from Chong-Kashka;"},{"id":"semetey-1-2013:p0249:b005:l001","ordinal":95941,"en":"There was Taytoru,"},{"id":"semetey-1-2013:p0249:b005:l002","ordinal":95942,"en":"Drawing alongside Chong-Küröng."},{"id":"semetey-1-2013:p0249:b005:l003","ordinal":95943,"en":"So many worries her breast could not hold them—"},{"id":"semetey-1-2013:p0249:b005:l004","ordinal":95944,"en":"When she saw Taytoru,"},{"id":"semetey-1-2013:p0249:b005:l005","ordinal":95945,"en":"Your fierce, raging sister-in-law's"},{"id":"semetey-1-2013:p0249:b005:l006","ordinal":95946,"en":"Tears flooded ten fields!"},{"id":"semetey-1-2013:p0249:b005:l007","ordinal":95947,"en":"Unable to twist her rope-like hair,"},{"id":"semetey-1-2013:p0249:b005:l008","ordinal":95948,"en":"Unable to stand without screaming and weeping,"},{"id":"semetey-1-2013:p0249:b005:l009","ordinal":95949,"en":"Without looking round,"},{"id":"semetey-1-2013:p0249:b005:l010","ordinal":95950,"en":"That truly mighty woman,"},{"id":"semetey-1-2013:p0249:b005:l011","ordinal":95951,"en":"Sparing not her life, worth but a coin,"},{"id":"semetey-1-2013:p0249:b005:l012","ordinal":95952,"en":"Without looking this way and that,"},{"id":"semetey-1-2013:p0249:b005:l013","ordinal":95953,"en":"The poor soul was carried away."},{"id":"semetey-1-2013:p0249:b005:l014","ordinal":95954,"en":"This damned life,"},{"id":"semetey-1-2013:p0249:b005:l015","ordinal":95955,"en":"She valued not a hair, sparing it not."},{"id":"semetey-1-2013:p0249:b005:l016","ordinal":95956,"en":"Sobbing, \"O God!\""},{"id":"semetey-1-2013:p0249:b005:l017","ordinal":95957,"en":"Then crying, \"My magnanimous one!\""},{"id":"semetey-1-2013:p0249:b005:l018","ordinal":95958,"en":"Your noble sister-in-law Kanykei"},{"id":"semetey-1-2013:p0249:b005:l019","ordinal":95959,"en":"Lashed her whip this way and that,"},{"id":"semetey-1-2013:p0249:b005:l020","ordinal":95960,"en":"Spurred right and left,"},{"id":"semetey-1-2013:p0249:b005:l021","ordinal":95961,"en":"Roared like a warrior,"},{"id":"semetey-1-2013:p0249:b005:l022","ordinal":95962,"en":"Raised the battle cry, \"Manas!\""},{"id":"semetey-1-2013:p0249:b005:l023","ordinal":95963,"en":"At that moment, your sister-in-law"},{"id":"semetey-1-2013:p0249:b005:l024","ordinal":95964,"en":"Raised the full-throated battle cry."},{"id":"semetey-1-2013:p0249:b005:l025","ordinal":95965,"en":"Wherever she could reach Tory,"},{"id":"semetey-1-2013:p0249:b005:l026","ordinal":95966,"en":"The great lead rope tied in knotted loops,"},{"id":"semetey-1-2013:p0249:b005:l027","ordinal":95967,"en":"Your mother snatched up"},{"id":"semetey-1-2013:p0249:b005:l028","ordinal":95968,"en":"And struck his flank."},{"id":"semetey-1-2013:p0249:b005:l029","ordinal":95969,"en":"When your sister-in-law took the lead rope,"},{"id":"semetey-1-2013:p0249:b005:l030","ordinal":95970,"en":"Her poor heart was torn,"},{"id":"semetey-1-2013:p0249:b005:l031","ordinal":95971,"en":"Tears poured from her eyes."},{"id":"semetey-1-2013:p0249:b005:l032","ordinal":95972,"en":"Her golden earrings, big as bowls—"},{"id":"semetey-1-2013:p0249:b005:l033","ordinal":95973,"en":"Damn her womanhood!—"},{"id":"semetey-1-2013:p0249:b005:l034","ordinal":95974,"en":"Showed upon her earlobes."},{"id":"semetey-1-2013:p0249:b005:l035","ordinal":95975,"en":"When your sister-in-law took the lead rope,"},{"id":"semetey-1-2013:p0249:b005:l036","ordinal":95976,"en":"Naked Khizyr and young Aydar"},{"id":"semetey-1-2013:p0249:b005:l037","ordinal":95977,"en":"Took hold of the bridle and bit."},{"id":"semetey-1-2013:p0249:b005:l038","ordinal":95978,"en":"The forty saints, Khizyr and his khoja"},{"id":"semetey-1-2013:p0249:b005:l039","ordinal":95979,"en":"Joined in urging the horse on."},{"id":"semetey-1-2013:p0250:b003:l001","ordinal":95980,"en":"The black-spotted leopard,"},{"id":"semetey-1-2013:p0250:b003:l002","ordinal":95981,"en":"Charging beside her then,"},{"id":"semetey-1-2013:p0250:b003:l003","ordinal":95982,"en":"Raised an unseen cry of encouragement."},{"id":"semetey-1-2013:p0250:b003:l004","ordinal":95983,"en":"Manas, visited by Khizyr—"},{"id":"semetey-1-2013:p0250:b003:l005","ordinal":95984,"en":"The saints who had protected him"},{"id":"semetey-1-2013:p0250:b003:l006","ordinal":95985,"en":"Joined in urging the horse on."},{"id":"semetey-1-2013:p0250:b003:l007","ordinal":95986,"en":"(Much is false, much is true;"},{"id":"semetey-1-2013:p0250:b003:l008","ordinal":95987,"en":"Those renowned conquerors,"},{"id":"semetey-1-2013:p0250:b003:l009","ordinal":95988,"en":"No one has returned from seeing them."},{"id":"semetey-1-2013:p0250:b003:l010","ordinal":95989,"en":"Half is false, half is true;"},{"id":"semetey-1-2013:p0250:b003:l011","ordinal":95990,"en":"Unless the Creator himself knows,"},{"id":"semetey-1-2013:p0250:b003:l012","ordinal":95991,"en":"No one has returned from their side.)"},{"id":"semetey-1-2013:p0250:b003:l013","ordinal":95992,"en":"From Allah Most High alone,"},{"id":"semetey-1-2013:p0250:b003:l014","ordinal":95993,"en":"She came seeking help,"},{"id":"semetey-1-2013:p0250:b003:l015","ordinal":95994,"en":"Sparing not her fly-like life,"},{"id":"semetey-1-2013:p0250:b003:l016","ordinal":95995,"en":"Imploring the true God."},{"id":"semetey-1-2013:p0250:b003:l017","ordinal":95996,"en":"The racer Taytoru,"},{"id":"semetey-1-2013:p0250:b003:l018","ordinal":95997,"en":"Your mother came urging onward."},{"id":"semetey-1-2013:p0250:b003:l019","ordinal":95998,"en":"That truly strong, poor woman,"},{"id":"semetey-1-2013:p0250:b003:l020","ordinal":95999,"en":"Guiding him on level ground,"},{"id":"semetey-1-2013:p0250:b003:l021","ordinal":96000,"en":"Where she caught hold of Tory,"}]
