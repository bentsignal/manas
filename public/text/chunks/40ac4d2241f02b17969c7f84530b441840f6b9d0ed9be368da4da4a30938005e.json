[{"id":"semetey-1-2013:p0830:b003:l032","ordinal":139777,"en":"What soul can flee and escape?"},{"id":"semetey-1-2013:p0830:b003:l033","ordinal":139778,"en":"The dug grave will receive us;"},{"id":"semetey-1-2013:p0830:b004:l001","ordinal":139779,"en":"All eighteen thousand worlds"},{"id":"semetey-1-2013:p0830:b004:l002","ordinal":139780,"en":"The black earth will swallow."},{"id":"semetey-1-2013:p0830:b004:l003","ordinal":139781,"en":"The only son of a prince—"},{"id":"semetey-1-2013:p0830:b004:l004","ordinal":139782,"en":"Can he run away?"},{"id":"semetey-1-2013:p0830:b004:l005","ordinal":139783,"en":"The life entrusted to us in this world—"},{"id":"semetey-1-2013:p0830:b004:l006","ordinal":139784,"en":"Is it right to keep it hiding?"},{"id":"semetey-1-2013:p0830:b004:l007","ordinal":139785,"en":"Let me go to Kokand;"},{"id":"semetey-1-2013:p0830:b004:l008","ordinal":139786,"en":"If its people are well,"},{"id":"semetey-1-2013:p0830:b004:l009","ordinal":139787,"en":"Let me too greet them!”"},{"id":"semetey-1-2013:p0830:b004:l010","ordinal":139788,"en":"Your fierce one, Manas’s son,"},{"id":"semetey-1-2013:p0830:b004:l011","ordinal":139789,"en":"That dear hero like a fighting cock—"},{"id":"semetey-1-2013:p0830:b004:l012","ordinal":139790,"en":"That place saw his stirring."},{"id":"semetey-1-2013:p0830:b004:l014","ordinal":139791,"en":"He gathered up the reins,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0830:b004:l015","ordinal":139792,"en":"And toward Khan Kokand"},{"id":"semetey-1-2013:p0830:b004:l016","ordinal":139793,"en":"Your orphan cried, “Go!” and set off."},{"id":"semetey-1-2013:p0830:b004:l018","ordinal":139794,"en":"Sary Khan, with eyes like little bowls,"},{"id":"semetey-1-2013:p0830:b004:l019","ordinal":139795,"en":"Had a beast such as Tuuchunak;"},{"id":"semetey-1-2013:p0830:b004:l020","ordinal":139796,"en":"He too had the strength of a thousand men."},{"id":"semetey-1-2013:p0830:b004:l021","ordinal":139797,"en":"Thick-armed, stone-hearted,"},{"id":"semetey-1-2013:p0830:b004:l022","ordinal":139798,"en":"The fortified city of Kokand—"},{"id":"semetey-1-2013:p0830:b004:l023","ordinal":139799,"en":"If he attacked it, he would bring great trouble."},{"id":"semetey-1-2013:p0830:b004:l024","ordinal":139800,"en":"Drawing near to Khan Kokand,"},{"id":"semetey-1-2013:p0830:b004:l025","ordinal":139801,"en":"Tuuchunak flew like an arrow behind him,"},{"id":"semetey-1-2013:p0830:b004:l026","ordinal":139802,"en":"Coming at a flashing gallop."},{"id":"semetey-1-2013:p0830:b004:l027","ordinal":139803,"en":"To Kokand’s lookout post"},{"id":"semetey-1-2013:p0830:b004:l028","ordinal":139804,"en":"The two rode forward."},{"id":"semetey-1-2013:p0830:b004:l029","ordinal":139805,"en":"Kokand’s sentry,"},{"id":"semetey-1-2013:p0830:b004:l030","ordinal":139806,"en":"Seeing the boy, darted away,"},{"id":"semetey-1-2013:p0830:b004:l031","ordinal":139807,"en":"Urging his horse toward Kokand."},{"id":"semetey-1-2013:p0830:b004:l032","ordinal":139808,"en":"To Kozubek in Kokand"},{"id":"semetey-1-2013:p0830:b004:l033","ordinal":139809,"en":"He went and brought the news."},{"id":"semetey-1-2013:p0831:b004:l001","ordinal":139810,"en":"“He who began that turmoil,"},{"id":"semetey-1-2013:p0831:b004:l002","ordinal":139811,"en":"Who tore out one of Tööbalban’s arms"},{"id":"semetey-1-2013:p0831:b004:l003","ordinal":139812,"en":"Completely—"},{"id":"semetey-1-2013:p0831:b004:l004","ordinal":139813,"en":"That bastard has come,"},{"id":"semetey-1-2013:p0831:b004:l005","ordinal":139814,"en":"That whoreson has come!”"},{"id":"semetey-1-2013:p0831:b004:l006","ordinal":139815,"en":"The sentry came in great agitation,"},{"id":"semetey-1-2013:p0831:b004:l007","ordinal":139816,"en":"Speaking to Kozubek:"},{"id":"semetey-1-2013:p0831:b004:l008","ordinal":139817,"en":"“He who began the turmoil,"},{"id":"semetey-1-2013:p0831:b004:l009","ordinal":139818,"en":"When he went on from here,"},{"id":"semetey-1-2013:p0831:b004:l010","ordinal":139819,"en":"Some sixty of Kokand’s soldiers"},{"id":"semetey-1-2013:p0831:b004:l011","ordinal":139820,"en":"He slaughtered to the last man."},{"id":"semetey-1-2013:p0831:b004:l012","ordinal":139821,"en":"Growing to manhood as an orphan,"},{"id":"semetey-1-2013:p0831:b004:l013","ordinal":139822,"en":"The orphan slave is passing by."},{"id":"semetey-1-2013:p0831:b004:l014","ordinal":139823,"en":"If you do not seize him now,"},{"id":"semetey-1-2013:p0831:b004:l015","ordinal":139824,"en":"If you do not put an end to him,"},{"id":"semetey-1-2013:p0831:b004:l016","ordinal":139825,"en":"When he returns, the orphan slave"},{"id":"semetey-1-2013:p0831:b004:l017","ordinal":139826,"en":"Will imprison the wandering dervishes,"},{"id":"semetey-1-2013:p0831:b004:l018","ordinal":139827,"en":"Will he not beat the khojas?"},{"id":"semetey-1-2013:p0831:b004:l019","ordinal":139828,"en":"The turbaned khojas,"},{"id":"semetey-1-2013:p0831:b004:l020","ordinal":139829,"en":"The mullahs in the mosque—"},{"id":"semetey-1-2013:p0831:b004:l021","ordinal":139830,"en":"He will slaughter every one."},{"id":"semetey-1-2013:p0831:b004:l022","ordinal":139831,"en":"God will surely strike the orphan down;"},{"id":"semetey-1-2013:p0831:b004:l023","ordinal":139832,"en":"He will humiliate Kokand."},{"id":"semetey-1-2013:p0831:b004:l024","ordinal":139833,"en":"Sweeping up Samarkand’s people,"},{"id":"semetey-1-2013:p0831:b004:l025","ordinal":139834,"en":"He will drive them toward Talas."},{"id":"semetey-1-2013:p0831:b004:l026","ordinal":139835,"en":"He will bind Margalan,"},{"id":"semetey-1-2013:p0831:b004:l027","ordinal":139836,"en":"He will devastate Andijan."},{"id":"semetey-1-2013:p0831:b004:l028","ordinal":139837,"en":"He will take the tribute in full,"},{"id":"semetey-1-2013:p0831:b004:l029","ordinal":139838,"en":"‘My property left by my father,’ he will say,"},{"id":"semetey-1-2013:p0831:b004:l030","ordinal":139839,"en":"And torment us all together!"},{"id":"semetey-1-2013:p0831:b004:l031","ordinal":139840,"en":"He will bring us all to ruin;"},{"id":"semetey-1-2013:p0831:b004:l032","ordinal":139841,"en":"This very Kokand"},{"id":"semetey-1-2013:p0831:b004:l033","ordinal":139842,"en":"He will slaughter entirely!"},{"id":"semetey-1-2013:p0831:b004:l034","ordinal":139843,"en":"He will plunder the fine cloth,"},{"id":"semetey-1-2013:p0831:b004:l035","ordinal":139844,"en":"The boy will cause havoc!"},{"id":"semetey-1-2013:p0831:b005:l001","ordinal":139845,"en":"He will carry off as plunder","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0831:b005:l002","ordinal":139846,"en":"All the girls of Kokand!"},{"id":"semetey-1-2013:p0831:b005:l003","ordinal":139847,"en":"This orphan, Manas’s son,"},{"id":"semetey-1-2013:p0831:b005:l004","ordinal":139848,"en":"Is the very bastard,"},{"id":"semetey-1-2013:p0831:b005:l005","ordinal":139849,"en":"The very image of that reckless rogue."},{"id":"semetey-1-2013:p0831:b005:l006","ordinal":139850,"en":"Having stirred up trouble in Bukhara,"},{"id":"semetey-1-2013:p0831:b005:l007","ordinal":139851,"en":"He is now moving to Talas."},{"id":"semetey-1-2013:p0831:b005:l008","ordinal":139852,"en":"Unless we seize and slaughter him,"},{"id":"semetey-1-2013:p0831:b005:l009","ordinal":139853,"en":"Unless we wipe him out,"},{"id":"semetey-1-2013:p0831:b005:l010","ordinal":139854,"en":"He will not let us turn a plow;"},{"id":"semetey-1-2013:p0831:b005:l011","ordinal":139855,"en":"He will not let us live in Kokand."},{"id":"semetey-1-2013:p0831:b005:l012","ordinal":139856,"en":"He will not let us fit the yoke-pins,"},{"id":"semetey-1-2013:p0831:b005:l013","ordinal":139857,"en":"He will not let us sow our crops."},{"id":"semetey-1-2013:p0831:b005:l014","ordinal":139858,"en":"When summer comes,"},{"id":"semetey-1-2013:p0831:b005:l015","ordinal":139859,"en":"He will not let us ride a maned mare;"},{"id":"semetey-1-2013:p0831:b005:l016","ordinal":139860,"en":"When autumn comes,"},{"id":"semetey-1-2013:p0831:b005:l017","ordinal":139861,"en":"He will not let us eat a fat-tailed yearling sheep."},{"id":"semetey-1-2013:p0831:b005:l018","ordinal":139862,"en":"He will trample on our heads;"},{"id":"semetey-1-2013:p0831:b005:l019","ordinal":139863,"en":"Will he not scatter the four kinds of livestock?"},{"id":"semetey-1-2013:p0831:b005:l020","ordinal":139864,"en":"He will break into our treasury;"},{"id":"semetey-1-2013:p0831:b005:l021","ordinal":139865,"en":"Will he not plunge us into black night?”"},{"id":"semetey-1-2013:p0831:b005:l022","ordinal":139866,"en":"The sentry had fled in panic;"},{"id":"semetey-1-2013:p0831:b005:l023","ordinal":139867,"en":"Thus, to Kozubek,"},{"id":"semetey-1-2013:p0831:b005:l024","ordinal":139868,"en":"He spoke, maligning the boy."},{"id":"semetey-1-2013:p0831:b005:l025","ordinal":139869,"en":"‘The boy will pass through as he moves,’"},{"id":"semetey-1-2013:p0831:b005:l026","ordinal":139870,"en":"Hearing word from a messenger,"},{"id":"semetey-1-2013:p0831:b005:l027","ordinal":139871,"en":"Hearing, ‘He will go to Talas,’"},{"id":"semetey-1-2013:p0831:b005:l028","ordinal":139872,"en":"Considering carefully, thinking much,"},{"id":"semetey-1-2013:p0831:b005:l029","ordinal":139873,"en":"To kill Semetey,"},{"id":"semetey-1-2013:p0831:b005:l030","ordinal":139874,"en":"To cut off his head,"},{"id":"semetey-1-2013:p0831:b005:l031","ordinal":139875,"en":"To Abyke and Kobosh"},{"id":"semetey-1-2013:p0831:b005:l032","ordinal":139876,"en":"To bring the joyful news,"},{"id":"semetey-1-2013:p0831:b005:l033","ordinal":139877,"en":"The wealth left by Manas"},{"id":"semetey-1-2013:p0831:b005:l034","ordinal":139878,"en":"To obtain from those two,"},{"id":"semetey-1-2013:p0831:b005:l035","ordinal":139879,"en":"To receive property as a reward for the news,"},{"id":"semetey-1-2013:p0831:b005:l036","ordinal":139880,"en":"And settle down in wealth—"},{"id":"semetey-1-2013:p0832:b003:l001","ordinal":139881,"en":"The peoples of four khans gathered."},{"id":"semetey-1-2013:p0832:b003:l002","ordinal":139882,"en":"To bustling Kokand"},{"id":"semetey-1-2013:p0832:b003:l003","ordinal":139883,"en":"They flocked and held assembly;"},{"id":"semetey-1-2013:p0832:b003:l004","ordinal":139884,"en":"To crowded Kokand"},{"id":"semetey-1-2013:p0832:b003:l005","ordinal":139885,"en":"They gathered and held assembly."},{"id":"semetey-1-2013:p0832:b003:l007","ordinal":139886,"en":"Seeking, they found one another;","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0832:b003:l008","ordinal":139887,"en":"They left nothing crooked,"},{"id":"semetey-1-2013:p0832:b003:l009","ordinal":139888,"en":"Straightening and setting their affairs right."},{"id":"semetey-1-2013:p0832:b003:l010","ordinal":139889,"en":"They prepared their noble steeds,"},{"id":"semetey-1-2013:p0832:b003:l011","ordinal":139890,"en":"Made their champions ready."},{"id":"semetey-1-2013:p0832:b003:l012","ordinal":139891,"en":"Many Sarts spoke:"},{"id":"semetey-1-2013:p0832:b003:l013","ordinal":139892,"en":"“That damned orphan—"},{"id":"semetey-1-2013:p0832:b003:l014","ordinal":139893,"en":"I shall seize and slaughter him,” they said."},{"id":"semetey-1-2013:p0832:b003:l015","ordinal":139894,"en":"“That bastard boy—"},{"id":"semetey-1-2013:p0832:b003:l016","ordinal":139895,"en":"Unless we seize and slaughter him,"},{"id":"semetey-1-2013:p0832:b003:l017","ordinal":139896,"en":"Unless we gouge out his eyes,"},{"id":"semetey-1-2013:p0832:b003:l018","ordinal":139897,"en":"Unless we wipe him out,"},{"id":"semetey-1-2013:p0832:b003:l019","ordinal":139898,"en":"Unless we seize him by the arm,"},{"id":"semetey-1-2013:p0832:b003:l020","ordinal":139899,"en":"Drag him onto the road,"},{"id":"semetey-1-2013:p0832:b003:l021","ordinal":139900,"en":"And slaughter him as a sacrifice,"},{"id":"semetey-1-2013:p0832:b003:l022","ordinal":139901,"en":"‘The tribute left by my father—"},{"id":"semetey-1-2013:p0832:b003:l023","ordinal":139902,"en":"Count it out to me now,’ he will say;"},{"id":"semetey-1-2013:p0832:b003:l024","ordinal":139903,"en":"The orphan will finally stir up strife."},{"id":"semetey-1-2013:p0832:b003:l025","ordinal":139904,"en":"Before he reaches his full strength,"},{"id":"semetey-1-2013:p0832:b003:l026","ordinal":139905,"en":"Let us slaughter him without delay."},{"id":"semetey-1-2013:p0832:b003:l027","ordinal":139906,"en":"While the orphan’s bones are still cartilage,"},{"id":"semetey-1-2013:p0832:b003:l028","ordinal":139907,"en":"Let us put an end to him."},{"id":"semetey-1-2013:p0832:b003:l029","ordinal":139908,"en":"Let us take the boy’s life;"},{"id":"semetey-1-2013:p0832:b003:l030","ordinal":139909,"en":"Fierce, foolhardy Manas—"},{"id":"semetey-1-2013:p0832:b003:l031","ordinal":139910,"en":"Let us make him like an extinguished fire!”"},{"id":"semetey-1-2013:p0832:b003:l032","ordinal":139911,"en":"The peoples of four khans united,"},{"id":"semetey-1-2013:p0832:b003:l033","ordinal":139912,"en":"Made a trough of pine,"},{"id":"semetey-1-2013:p0832:b003:l034","ordinal":139913,"en":"And upon Semetey’s head"},{"id":"semetey-1-2013:p0832:b003:l036","ordinal":139914,"en":"They had prepared it all.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0832:b003:l037","ordinal":139915,"en":"A thousand champions gathered:"},{"id":"semetey-1-2013:p0832:b003:l038","ordinal":139916,"en":"“If a thousand champions surround him together,"},{"id":"semetey-1-2013:p0832:b003:l039","ordinal":139917,"en":"How can his strength suffice?"},{"id":"semetey-1-2013:p0832:b004:l001","ordinal":139918,"en":"Manas’s reckless orphan"},{"id":"semetey-1-2013:p0832:b004:l002","ordinal":139919,"en":"Will meet his death,” they said."},{"id":"semetey-1-2013:p0832:b004:l003","ordinal":139920,"en":"They considered and discussed,"},{"id":"semetey-1-2013:p0832:b004:l004","ordinal":139921,"en":"Firmly planned to kill him."},{"id":"semetey-1-2013:p0832:b004:l005","ordinal":139922,"en":"Their wise men, their elders,"},{"id":"semetey-1-2013:p0832:b004:l006","ordinal":139923,"en":"All their knowing men said:"},{"id":"semetey-1-2013:p0832:b004:l007","ordinal":139924,"en":"Seven wolves and one colt—"},{"id":"semetey-1-2013:p0832:b004:l008","ordinal":139925,"en":"If they tear at it, will they leave its carcass?"},{"id":"semetey-1-2013:p0832:b004:l009","ordinal":139926,"en":"If a thousand champions fall upon him,"},{"id":"semetey-1-2013:p0832:b004:l010","ordinal":139927,"en":"The orphan son of Manas—"},{"id":"semetey-1-2013:p0832:b004:l011","ordinal":139928,"en":"Will they leave his carcass after beating him?”"},{"id":"semetey-1-2013:p0832:b004:l012","ordinal":139929,"en":"Thus the peoples of four khans"},{"id":"semetey-1-2013:p0832:b004:l013","ordinal":139930,"en":"Prepared their noble steeds,"},{"id":"semetey-1-2013:p0832:b004:l014","ordinal":139931,"en":"Made their champions ready,"},{"id":"semetey-1-2013:p0832:b004:l015","ordinal":139932,"en":"Beat their drums."},{"id":"semetey-1-2013:p0832:b004:l016","ordinal":139933,"en":"As though their own people were not enough,"},{"id":"semetey-1-2013:p0832:b004:l017","ordinal":139934,"en":"They brought men from Hindustan."},{"id":"semetey-1-2013:p0832:b004:l018","ordinal":139935,"en":"They mounted them on horses no shot could catch,"},{"id":"semetey-1-2013:p0832:b004:l019","ordinal":139936,"en":"Clothed them in coats no shot could pierce,"},{"id":"semetey-1-2013:p0832:b004:l020","ordinal":139937,"en":"Their thoroughbreds holding their heads high,"},{"id":"semetey-1-2013:p0832:b004:l022","ordinal":139938,"en":"They made their champions ready,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0832:b004:l023","ordinal":139939,"en":"Prepared their heroes."},{"id":"semetey-1-2013:p0832:b004:l024","ordinal":139940,"en":"Hearing the sentry’s words,"},{"id":"semetey-1-2013:p0832:b004:l025","ordinal":139941,"en":"Kozubek of Khan Kokand,"},{"id":"semetey-1-2013:p0832:b004:l026","ordinal":139942,"en":"Hearing Semetey had come,"},{"id":"semetey-1-2013:p0832:b004:l027","ordinal":139943,"en":"At the treasury tower"},{"id":"semetey-1-2013:p0832:b004:l028","ordinal":139944,"en":"Tethered his noble steed."},{"id":"semetey-1-2013:p0832:b004:l029","ordinal":139945,"en":"He provided a feast from the treasury,"},{"id":"semetey-1-2013:p0832:b004:l030","ordinal":139946,"en":"Had all the rice boiled,"},{"id":"semetey-1-2013:p0832:b004:l031","ordinal":139947,"en":"Had the dutars played,"},{"id":"semetey-1-2013:p0832:b004:l032","ordinal":139948,"en":"And for all the champions"},{"id":"semetey-1-2013:p0832:b004:l033","ordinal":139949,"en":"Had songs sung throughout."},{"id":"semetey-1-2013:p0832:b004:l034","ordinal":139950,"en":"Among the thousand champions"},{"id":"semetey-1-2013:p0832:b004:l035","ordinal":139951,"en":"Were khojas in motley robes,"},{"id":"semetey-1-2013:p0832:b004:l036","ordinal":139952,"en":"Mullahs reciting lessons,"},{"id":"semetey-1-2013:p0832:b004:l037","ordinal":139953,"en":"Broad-chested warriors,"},{"id":"semetey-1-2013:p0832:b004:l038","ordinal":139954,"en":"Heroes of mighty courage."},{"id":"semetey-1-2013:p0832:b004:l039","ordinal":139955,"en":"Their datkas numbered forty-one."},{"id":"semetey-1-2013:p0833:b003:l001","ordinal":139956,"en":"Kozubek of Khan Kokand"},{"id":"semetey-1-2013:p0833:b003:l002","ordinal":139957,"en":"Had his drums beaten."},{"id":"semetey-1-2013:p0833:b003:l003","ordinal":139958,"en":"As though an enemy had come, a thousand champions"},{"id":"semetey-1-2013:p0833:b003:l004","ordinal":139959,"en":"Equipped themselves for war,"},{"id":"semetey-1-2013:p0833:b003:l005","ordinal":139960,"en":"Girded their swords at a slant."},{"id":"semetey-1-2013:p0833:b003:l006","ordinal":139961,"en":"Their leaders of ten bobbed about,"},{"id":"semetey-1-2013:p0833:b003:l007","ordinal":139962,"en":"Their leaders of fifty strode conspicuously;"},{"id":"semetey-1-2013:p0833:b003:l008","ordinal":139963,"en":"All their leaders of a hundred"},{"id":"semetey-1-2013:p0833:b003:l009","ordinal":139964,"en":"Ran about in haste."},{"id":"semetey-1-2013:p0833:b003:l010","ordinal":139965,"en":"At the tower before the khan,"},{"id":"semetey-1-2013:p0833:b003:l011","ordinal":139966,"en":"The many champions made ready;"},{"id":"semetey-1-2013:p0833:b003:l012","ordinal":139967,"en":"Before Kozubek"},{"id":"semetey-1-2013:p0833:b003:l013","ordinal":139968,"en":"They crowded to bow in homage."},{"id":"semetey-1-2013:p0833:b003:l014","ordinal":139969,"en":"When the champions came and stood there,"},{"id":"semetey-1-2013:p0833:b003:l015","ordinal":139970,"en":"To all the champions"},{"id":"semetey-1-2013:p0833:b003:l016","ordinal":139971,"en":"Kozubek gave command:"},{"id":"semetey-1-2013:p0833:b003:l017","ordinal":139972,"en":"“Your father’s grave, my champions!"},{"id":"semetey-1-2013:p0833:b003:l018","ordinal":139973,"en":"My leaders, every one excellent,"},{"id":"semetey-1-2013:p0833:b003:l019","ordinal":139974,"en":"My men, all champions!"},{"id":"semetey-1-2013:p0833:b003:l020","ordinal":139975,"en":"Of Manas’s orphan son"},{"id":"semetey-1-2013:p0833:b003:l021","ordinal":139976,"en":"I heard word from the sentry:"},{"id":"semetey-1-2013:p0833:b003:l022","ordinal":139977,"en":"Loaded with gold by the pood from Bukhara,"},{"id":"semetey-1-2013:p0833:b003:l023","ordinal":139978,"en":"He is moving here, I heard."},{"id":"semetey-1-2013:p0833:b003:l024","ordinal":139979,"en":"Champions, attend to these words:"},{"id":"semetey-1-2013:p0833:b003:l025","ordinal":139980,"en":"Advance on right and left;"},{"id":"semetey-1-2013:p0833:b003:l026","ordinal":139981,"en":"Seize and scatter his goods as plunder!"},{"id":"semetey-1-2013:p0833:b003:l027","ordinal":139982,"en":"Upon Manas’s orphan son"},{"id":"semetey-1-2013:p0833:b003:l028","ordinal":139983,"en":"Bring great calamity!"},{"id":"semetey-1-2013:p0833:b003:l029","ordinal":139984,"en":"Fight him fiercely!"},{"id":"semetey-1-2013:p0833:b003:l030","ordinal":139985,"en":"Bald Sary, with eyes like little bowls—"},{"id":"semetey-1-2013:p0833:b003:l031","ordinal":139986,"en":"If the khan falls into your hands,"},{"id":"semetey-1-2013:p0833:b003:l032","ordinal":139987,"en":"Slaughter him as a sacrifice!"},{"id":"semetey-1-2013:p0833:b003:l033","ordinal":139988,"en":"If you seize the orphan alive,"},{"id":"semetey-1-2013:p0833:b003:l034","ordinal":139989,"en":"Bind both his hands,"},{"id":"semetey-1-2013:p0833:b003:l035","ordinal":139990,"en":"Gouge out both his eyes,"},{"id":"semetey-1-2013:p0833:b003:l036","ordinal":139991,"en":"And drive him here alive!"},{"id":"semetey-1-2013:p0833:b003:l037","ordinal":139992,"en":"Manas’s orphan son—"},{"id":"semetey-1-2013:p0833:b003:l038","ordinal":139993,"en":"Let us cut off his head;"},{"id":"semetey-1-2013:p0833:b003:l039","ordinal":139994,"en":"Let us take our vengeance thus."},{"id":"semetey-1-2013:p0833:b005:l001","ordinal":139995,"en":"His aged mother Chiyyrdy—"},{"id":"semetey-1-2013:p0833:b005:l002","ordinal":139996,"en":"Let us drag her along the road"},{"id":"semetey-1-2013:p0833:b005:l003","ordinal":139997,"en":"And cast her to the full-grown dogs!"},{"id":"semetey-1-2013:p0833:b005:l004","ordinal":139998,"en":"Kanykei and Semetey—"},{"id":"semetey-1-2013:p0833:b005:l005","ordinal":139999,"en":"Let us seize those two,"},{"id":"semetey-1-2013:p0833:b005:l006","ordinal":140000,"en":"To Abyke and Kobosh"},{"id":"semetey-1-2013:p0833:b005:l007","ordinal":140001,"en":"Let us bring the joyful news."},{"id":"semetey-1-2013:p0833:b005:l008","ordinal":140002,"en":"The yellow gold left by Manas—"},{"id":"semetey-1-2013:p0833:b005:l009","ordinal":140003,"en":"Let us have it counted out to us,"},{"id":"semetey-1-2013:p0833:b005:l010","ordinal":140004,"en":"All the peoples of four khans;"},{"id":"semetey-1-2013:p0833:b005:l011","ordinal":140005,"en":"Let us settle down in wealth!”"},{"id":"semetey-1-2013:p0833:b005:l012","ordinal":140006,"en":"When they received the khan’s command,"},{"id":"semetey-1-2013:p0833:b005:l013","ordinal":140007,"en":"The champions of Andijan and Kokand"},{"id":"semetey-1-2013:p0833:b005:l014","ordinal":140008,"en":"Set out together."},{"id":"semetey-1-2013:p0833:b005:l015","ordinal":140009,"en":"At wielding spears, surpassing"},{"id":"semetey-1-2013:p0833:b005:l016","ordinal":140010,"en":"Warriors were among them;"},{"id":"semetey-1-2013:p0833:b005:l017","ordinal":140011,"en":"Who shook the whole world"},{"id":"semetey-1-2013:p0833:b005:l018","ordinal":140012,"en":"Were heroes among them too."},{"id":"semetey-1-2013:p0833:b005:l019","ordinal":140013,"en":"Their thousand champions rushed forth,"},{"id":"semetey-1-2013:p0833:b005:l020","ordinal":140014,"en":"Traveling along the road."},{"id":"semetey-1-2013:p0833:b005:l021","ordinal":140015,"en":"Many Sarts had no saddle;"},{"id":"semetey-1-2013:p0833:b005:l022","ordinal":140016,"en":"They rode on packsaddles."},{"id":"semetey-1-2013:p0833:b005:l023","ordinal":140017,"en":"The army coming had no sense;"},{"id":"semetey-1-2013:p0833:b005:l024","ordinal":140018,"en":"They rode on Andijan’s ak-kanky saddles."},{"id":"semetey-1-2013:p0833:b005:l025","ordinal":140019,"en":"All their horses were stallions;"},{"id":"semetey-1-2013:p0833:b005:l026","ordinal":140020,"en":"They had no cruppers at all."},{"id":"semetey-1-2013:p0833:b005:l027","ordinal":140021,"en":"No support to rely upon,"},{"id":"semetey-1-2013:p0833:b005:l028","ordinal":140022,"en":"No people to stand firm in combat—"},{"id":"semetey-1-2013:p0833:b005:l029","ordinal":140023,"en":"If they faced one another with spears,"},{"id":"semetey-1-2013:p0833:b005:l030","ordinal":140024,"en":"If they clashed together,"},{"id":"semetey-1-2013:p0833:b005:l031","ordinal":140025,"en":"If one or another fell from his horse,"},{"id":"semetey-1-2013:p0833:b005:l032","ordinal":140026,"en":"Giving shelter to one another—"},{"id":"semetey-1-2013:p0833:b005:l033","ordinal":140027,"en":"They were not men to pull their comrades free."},{"id":"semetey-1-2013:p0833:b005:l034","ordinal":140028,"en":"When the boy turned this way,"},{"id":"semetey-1-2013:p0833:b005:l035","ordinal":140029,"en":"When he returned toward Bukhara,"},{"id":"semetey-1-2013:p0833:b005:l036","ordinal":140030,"en":"Abyke and Kobosh, those six scoundrels,"},{"id":"semetey-1-2013:p0833:b005:l037","ordinal":140031,"en":"Gave six swift horses,"},{"id":"semetey-1-2013:p0833:b005:l038","ordinal":140032,"en":"Gave a letter the size of a palm,"}]
