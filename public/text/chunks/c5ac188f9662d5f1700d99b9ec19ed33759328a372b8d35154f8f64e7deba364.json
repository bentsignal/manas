[{"id":"semetey-1-2013:p0556:b004:l002","ordinal":119553,"en":"At that lake called Abergen,"},{"id":"semetey-1-2013:p0556:b004:l003","ordinal":119554,"en":"In the uplands of Suuk-Tör,"},{"id":"semetey-1-2013:p0556:b004:l004","ordinal":119555,"en":"In the land of the One-Eyed,"},{"id":"semetey-1-2013:p0556:b004:l005","ordinal":119556,"en":"There is a sixty-headed dragon,"},{"id":"semetey-1-2013:p0556:b004:l006","ordinal":119557,"en":"An exceedingly mighty sorcerer."},{"id":"semetey-1-2013:p0556:b004:l007","ordinal":119558,"en":"Saddle Sarala and set out;"},{"id":"semetey-1-2013:p0556:b004:l008","ordinal":119559,"en":"Go learn spells in his presence."},{"id":"semetey-1-2013:p0556:b004:l009","ordinal":119560,"en":"If you fight in darkness,"},{"id":"semetey-1-2013:p0556:b004:l010","ordinal":119561,"en":"He will teach the ways of night."},{"id":"semetey-1-2013:p0556:b004:l011","ordinal":119562,"en":"You need not fear entering a firefight;"},{"id":"semetey-1-2013:p0556:b004:l012","ordinal":119563,"en":"He will teach the ways of embers."},{"id":"semetey-1-2013:p0556:b004:l013","ordinal":119564,"en":"So you cannot be overcome in shooting,"},{"id":"semetey-1-2013:p0556:b004:l014","ordinal":119565,"en":"He will teach the ways of bullets."},{"id":"semetey-1-2013:p0556:b004:l015","ordinal":119566,"en":"By casting spells upon a summer day,"},{"id":"semetey-1-2013:p0556:b004:l016","ordinal":119567,"en":"He will teach how to make it winter."},{"id":"semetey-1-2013:p0556:b004:l017","ordinal":119568,"en":"The thinly clad Chinese,"},{"id":"semetey-1-2013:p0556:b004:l018","ordinal":119569,"en":"Making them shiver, my foal,"},{"id":"semetey-1-2013:p0556:b004:l019","ordinal":119570,"en":"He will teach a spell to turn into girls."},{"id":"semetey-1-2013:p0556:b004:l020","ordinal":119571,"en":"Many people have gone to that place;"},{"id":"semetey-1-2013:p0556:b004:l021","ordinal":119572,"en":"No one has returned.”"},{"id":"semetey-1-2013:p0556:b004:l022","ordinal":119573,"en":"Mounting him on Sarala,"},{"id":"semetey-1-2013:p0556:b004:l023","ordinal":119574,"en":"Clothing him in a bulletproof coat,"},{"id":"semetey-1-2013:p0556:b004:l024","ordinal":119575,"en":"Aziz Khan spoke:"},{"id":"semetey-1-2013:p0556:b004:l025","ordinal":119576,"en":"“Go master the spells and return;"},{"id":"semetey-1-2013:p0556:b004:l026","ordinal":119577,"en":"Go see many wonders and return."},{"id":"semetey-1-2013:p0556:b004:l027","ordinal":119578,"en":"If you are worthy, my Alake,"},{"id":"semetey-1-2013:p0556:b004:l028","ordinal":119579,"en":"Bring havoc upon them;"},{"id":"semetey-1-2013:p0556:b004:l029","ordinal":119580,"en":"Konurbai and Börüköz,"},{"id":"semetey-1-2013:p0556:b004:l030","ordinal":119581,"en":"Split them open upon the road;"},{"id":"semetey-1-2013:p0556:b004:l031","ordinal":119582,"en":"Take my vengeance far and wide upon the scoundrels!"},{"id":"semetey-1-2013:p0556:b004:l033","ordinal":119583,"en":"If you are worthless, my foal,"},{"id":"semetey-1-2013:p0556:b004:l034","ordinal":119584,"en":"It is better that I have no child."},{"id":"semetey-1-2013:p0556:b004:l035","ordinal":119585,"en":"An early childless, bereft soul—"},{"id":"semetey-1-2013:p0556:b004:l036","ordinal":119586,"en":"O child, go on from there and die."},{"id":"semetey-1-2013:p0556:b004:l037","ordinal":119587,"en":"The dragon's mighty teaching,"},{"id":"semetey-1-2013:p0556:b004:l038","ordinal":119588,"en":"My child Alake, go and see!”"},{"id":"semetey-1-2013:p0556:b004:l039","ordinal":119589,"en":"In the first year of study,"},{"id":"semetey-1-2013:p0557:b003:l001","ordinal":119590,"en":"He sent six thousand children."},{"id":"semetey-1-2013:p0557:b003:l002","ordinal":119591,"en":"When he first set off to study,"},{"id":"semetey-1-2013:p0557:b003:l003","ordinal":119592,"en":"His sixty stepmothers"},{"id":"semetey-1-2013:p0557:b003:l004","ordinal":119593,"en":"All wept and sobbed,"},{"id":"semetey-1-2013:p0557:b003:l005","ordinal":119594,"en":"Every one of them urinating blood,"},{"id":"semetey-1-2013:p0557:b003:l006","ordinal":119595,"en":"“Go into the earth with your child!”"},{"id":"semetey-1-2013:p0557:b003:l007","ordinal":119596,"en":"They cried out, “Alake!”"},{"id":"semetey-1-2013:p0557:b003:l008","ordinal":119597,"en":"From the tribute-paying Chinese,"},{"id":"semetey-1-2013:p0557:b003:l009","ordinal":119598,"en":"In the first year of study,"},{"id":"semetey-1-2013:p0557:b003:l010","ordinal":119599,"en":"Six thousand children went,"},{"id":"semetey-1-2013:p0557:b003:l011","ordinal":119600,"en":"Six thousand were slaughtered,"},{"id":"semetey-1-2013:p0557:b003:l012","ordinal":119601,"en":"Six children remained."},{"id":"semetey-1-2013:p0557:b003:l013","ordinal":119602,"en":"Seven thousand children went,"},{"id":"semetey-1-2013:p0557:b003:l014","ordinal":119603,"en":"Seven thousand were slaughtered,"},{"id":"semetey-1-2013:p0557:b003:l015","ordinal":119604,"en":"Seven children remained."},{"id":"semetey-1-2013:p0557:b003:l016","ordinal":119605,"en":"Nine thousand children went,"},{"id":"semetey-1-2013:p0557:b003:l017","ordinal":119606,"en":"Nine thousand were slaughtered,"},{"id":"semetey-1-2013:p0557:b003:l018","ordinal":119607,"en":"Nine children remained."},{"id":"semetey-1-2013:p0557:b003:l019","ordinal":119608,"en":"Ten thousand children went,"},{"id":"semetey-1-2013:p0557:b003:l020","ordinal":119609,"en":"Ten thousand children were slaughtered,"},{"id":"semetey-1-2013:p0557:b003:l021","ordinal":119610,"en":"Only ten children remained,"},{"id":"semetey-1-2013:p0557:b003:l022","ordinal":119611,"en":"Among them a lion like my Alake."},{"id":"semetey-1-2013:p0557:b003:l023","ordinal":119612,"en":"When he had finished his learning,"},{"id":"semetey-1-2013:p0557:b003:l024","ordinal":119613,"en":"When his age reached twelve,"},{"id":"semetey-1-2013:p0557:b003:l025","ordinal":119614,"en":"Finding no mountain to strike against,"},{"id":"semetey-1-2013:p0557:b003:l026","ordinal":119615,"en":"Finding no enemy to fight,"},{"id":"semetey-1-2013:p0557:b003:l027","ordinal":119616,"en":"Finding no stone to bite,"},{"id":"semetey-1-2013:p0557:b003:l028","ordinal":119617,"en":"I can't find my head,"},{"id":"semetey-1-2013:p0557:b003:l029","ordinal":119618,"en":"Finding no embers burning in a tower,"},{"id":"semetey-1-2013:p0557:b003:l030","ordinal":119619,"en":"Finding no shot that would strike unbroken,"},{"id":"semetey-1-2013:p0557:b003:l031","ordinal":119620,"en":"Sarala opened his mouth."},{"id":"semetey-1-2013:p0557:b003:l032","ordinal":119621,"en":"May I be his sacrifice!"},{"id":"semetey-1-2013:p0557:b003:l033","ordinal":119622,"en":"To Alööke's Konurbai"},{"id":"semetey-1-2013:p0557:b003:l034","ordinal":119623,"en":"He went to pick a quarrel."},{"id":"semetey-1-2013:p0557:b003:l035","ordinal":119624,"en":"When his age reached twelve,"},{"id":"semetey-1-2013:p0557:b003:l036","ordinal":119625,"en":"He brought havoc."},{"id":"semetey-1-2013:p0557:b003:l037","ordinal":119626,"en":"Alake's banner fluttering in his hand,"},{"id":"semetey-1-2013:p0557:b003:l038","ordinal":119627,"en":"Zulpukor the sword, and all his arms,"},{"id":"semetey-1-2013:p0557:b003:l039","ordinal":119628,"en":"Gleaming each in its place,"},{"id":"semetey-1-2013:p0557:b004:l001","ordinal":119629,"en":"At the sight, thoughts were stirred."},{"id":"semetey-1-2013:p0557:b004:l002","ordinal":119630,"en":"When Alake reached twelve,"},{"id":"semetey-1-2013:p0557:b004:l003","ordinal":119631,"en":"Looming like Mount Opol,"},{"id":"semetey-1-2013:p0557:b004:l004","ordinal":119632,"en":"Alööke's Konurbai,"},{"id":"semetey-1-2013:p0557:b004:l005","ordinal":119633,"en":"Sixty Chinese, countless kaldai officials,"},{"id":"semetey-1-2013:p0557:b004:l006","ordinal":119634,"en":"Konurbai, elder of the enemy,"},{"id":"semetey-1-2013:p0557:b004:l007","ordinal":119635,"en":"Coral plumes and precious coral stones,"},{"id":"semetey-1-2013:p0557:b004:l008","ordinal":119636,"en":"Among the unbelievers' wrestlers."},{"id":"semetey-1-2013:p0557:b004:l009","ordinal":119637,"en":"Raging, changing his expression,"},{"id":"semetey-1-2013:p0557:b004:l010","ordinal":119638,"en":"Speaking to the Manchus beside him,"},{"id":"semetey-1-2013:p0557:b004:l011","ordinal":119639,"en":"In the dark forest, the great thicket,"},{"id":"semetey-1-2013:p0557:b004:l012","ordinal":119640,"en":"He had organized a mighty hunt."},{"id":"semetey-1-2013:p0557:b004:l013","ordinal":119641,"en":"Sixty bears and a hundred boars"},{"id":"semetey-1-2013:p0557:b004:l014","ordinal":119642,"en":"He had shot and loaded up."},{"id":"semetey-1-2013:p0557:b004:l015","ordinal":119643,"en":"His spirits were utterly at ease;"},{"id":"semetey-1-2013:p0557:b004:l016","ordinal":119644,"en":"Kalcha felt rich in his heart,"},{"id":"semetey-1-2013:p0557:b004:l017","ordinal":119645,"en":"His great boots sticking out,"},{"id":"semetey-1-2013:p0557:b004:l018","ordinal":119646,"en":"Towering like Mount Opol."},{"id":"semetey-1-2013:p0557:b004:l019","ordinal":119647,"en":"As Konurbai stood looking,"},{"id":"semetey-1-2013:p0557:b004:l020","ordinal":119648,"en":"My Alake arrived."},{"id":"semetey-1-2013:p0557:b004:l021","ordinal":119649,"en":"“Konurbai, you too are a khan's son;"},{"id":"semetey-1-2013:p0557:b004:l022","ordinal":119650,"en":"I too am a khan's son."},{"id":"semetey-1-2013:p0557:b004:l023","ordinal":119651,"en":"Our standing is equal, kinsman;"},{"id":"semetey-1-2013:p0557:b004:l024","ordinal":119652,"en":"Our ancestry is one, we are kin!"},{"id":"semetey-1-2013:p0557:b004:l025","ordinal":119653,"en":"To the words I say,"},{"id":"semetey-1-2013:p0557:b004:l026","ordinal":119654,"en":"Will you agree, Konurbai?"},{"id":"semetey-1-2013:p0557:b004:l027","ordinal":119655,"en":"You have seized from my father"},{"id":"semetey-1-2013:p0557:b004:l028","ordinal":119656,"en":"The tea-producing land he held;"},{"id":"semetey-1-2013:p0557:b004:l029","ordinal":119657,"en":"Come, will you give it back, Konurbai?"},{"id":"semetey-1-2013:p0557:b004:l030","ordinal":119658,"en":"You petty degenerate,"},{"id":"semetey-1-2013:p0557:b004:l031","ordinal":119659,"en":"My father is half a khan;"},{"id":"semetey-1-2013:p0557:b004:l032","ordinal":119660,"en":"You insulted him, calling him childless."},{"id":"semetey-1-2013:p0557:b004:l033","ordinal":119661,"en":"And you have caused much mischief."},{"id":"semetey-1-2013:p0557:b004:l034","ordinal":119662,"en":"My father's Kan-Jailak"},{"id":"semetey-1-2013:p0557:b004:l035","ordinal":119663,"en":"You have seized by force."},{"id":"semetey-1-2013:p0557:b004:l036","ordinal":119664,"en":"A pale, hazy star from heaven—"},{"id":"semetey-1-2013:p0557:b004:l037","ordinal":119665,"en":"Let us set out, Konurbai."},{"id":"semetey-1-2013:p0557:b004:l038","ordinal":119666,"en":"We are sons of elder and younger brothers;"},{"id":"semetey-1-2013:p0557:b004:l039","ordinal":119667,"en":"Let us be friends, Konurbai."},{"id":"semetey-1-2013:p0558:b003:l001","ordinal":119668,"en":"At Beijing's dark valley, Kaiky-Tash,"},{"id":"semetey-1-2013:p0558:b003:l002","ordinal":119669,"en":"If I camp there on watch,"},{"id":"semetey-1-2013:p0558:b003:l003","ordinal":119670,"en":"At Kyrka-Tash in deep Beijing,"},{"id":"semetey-1-2013:p0558:b003:l004","ordinal":119671,"en":"If you camp guarding its ridge,"},{"id":"semetey-1-2013:p0558:b003:l005","ordinal":119672,"en":"Could any fingered man dare challenge us?"},{"id":"semetey-1-2013:p0558:b003:l006","ordinal":119673,"en":"Could he come with a cold heart?"},{"id":"semetey-1-2013:p0558:b003:l007","ordinal":119674,"en":"Could anyone face our eyes?”"},{"id":"semetey-1-2013:p0558:b003:l008","ordinal":119675,"en":"Though he spoke, Kalcha did not agree."},{"id":"semetey-1-2013:p0558:b003:l009","ordinal":119676,"en":"Let alone Kan-Jailak, Konurbai"},{"id":"semetey-1-2013:p0558:b003:l010","ordinal":119677,"en":"Would not give him a kindly word."},{"id":"semetey-1-2013:p0558:b003:l011","ordinal":119678,"en":"Humming disdainfully, paying no heed,"},{"id":"semetey-1-2013:p0558:b003:l012","ordinal":119679,"en":"These words of Almambet"},{"id":"semetey-1-2013:p0558:b003:l013","ordinal":119680,"en":"Konurbai stood there"},{"id":"semetey-1-2013:p0558:b003:l014","ordinal":119681,"en":"Valuing less than a scrap of hide."},{"id":"semetey-1-2013:p0558:b003:l015","ordinal":119682,"en":"At that moment Almambet,"},{"id":"semetey-1-2013:p0558:b003:l016","ordinal":119683,"en":"His heart burning, turned to embers,"},{"id":"semetey-1-2013:p0558:b003:l017","ordinal":119684,"en":"His eyes boiling, turned to fire."},{"id":"semetey-1-2013:p0558:b003:l018","ordinal":119685,"en":"The sixty Chinese, the countless kaldai officials—"},{"id":"semetey-1-2013:p0558:b003:l019","ordinal":119686,"en":"Without looking squarely at a single one,"},{"id":"semetey-1-2013:p0558:b003:l020","ordinal":119687,"en":"When he saw Konurbai,"},{"id":"semetey-1-2013:p0558:b003:l021","ordinal":119688,"en":"He spared not a hair's breadth of his life."},{"id":"semetey-1-2013:p0558:b003:l022","ordinal":119689,"en":"“If my death has come, let me die;"},{"id":"semetey-1-2013:p0558:b003:l023","ordinal":119690,"en":"If I have the skill, let me test it."},{"id":"semetey-1-2013:p0558:b003:l024","ordinal":119691,"en":"With this dog, the khan of monks,"},{"id":"semetey-1-2013:p0558:b003:l025","ordinal":119692,"en":"Let me try a bout of jousting."},{"id":"semetey-1-2013:p0558:b003:l026","ordinal":119693,"en":"Let me rage without mercy;"},{"id":"semetey-1-2013:p0558:b003:l027","ordinal":119694,"en":"If he falls, let me take his head."},{"id":"semetey-1-2013:p0558:b003:l028","ordinal":119695,"en":"My father's tea-producing land,"},{"id":"semetey-1-2013:p0558:b003:l029","ordinal":119696,"en":"Without resting, fighting nine battles,"},{"id":"semetey-1-2013:p0558:b003:l030","ordinal":119697,"en":"Let me seize it back."},{"id":"semetey-1-2013:p0558:b003:l031","ordinal":119698,"en":"Pursuing them as far as Kakan,"},{"id":"semetey-1-2013:p0558:b003:l032","ordinal":119699,"en":"Let me bring havoc."},{"id":"semetey-1-2013:p0558:b003:l033","ordinal":119700,"en":"Let me take vengeance far and wide."},{"id":"semetey-1-2013:p0558:b003:l034","ordinal":119701,"en":"Until the pliant reed ripens,"},{"id":"semetey-1-2013:p0558:b003:l035","ordinal":119702,"en":"Until autumn gossamer flies,"},{"id":"semetey-1-2013:p0558:b003:l036","ordinal":119703,"en":"If I press hard, fighting for six months,"},{"id":"semetey-1-2013:p0558:b003:l037","ordinal":119704,"en":"Let me reach Beijing!”"},{"id":"semetey-1-2013:p0558:b003:l038","ordinal":119705,"en":"Thinking this at that time,"},{"id":"semetey-1-2013:p0558:b003:l039","ordinal":119706,"en":"Almambet at twelve"},{"id":"semetey-1-2013:p0558:b004:l001","ordinal":119707,"en":"Struck Sarala upon the flank,"},{"id":"semetey-1-2013:p0558:b004:l002","ordinal":119708,"en":"Took the lacquered spear in hand,"},{"id":"semetey-1-2013:p0558:b004:l003","ordinal":119709,"en":"His back hunched behind him,"},{"id":"semetey-1-2013:p0558:b004:l004","ordinal":119710,"en":"His fierce eyes bulging,"},{"id":"semetey-1-2013:p0558:b004:l005","ordinal":119711,"en":"Flames hissing from his mouth,"},{"id":"semetey-1-2013:p0558:b004:l006","ordinal":119712,"en":"His mighty teeth like gates"},{"id":"semetey-1-2013:p0558:b004:l007","ordinal":119713,"en":"Clattering like grains of millet,"},{"id":"semetey-1-2013:p0558:b004:l008","ordinal":119714,"en":"And arrived ahead of an arrow."},{"id":"semetey-1-2013:p0558:b004:l009","ordinal":119715,"en":"When he reached Kalcha,"},{"id":"semetey-1-2013:p0558:b004:l010","ordinal":119716,"en":"“The pommel of the Kalmyk saddle,"},{"id":"semetey-1-2013:p0558:b004:l011","ordinal":119717,"en":"The very tip of the heart,"},{"id":"semetey-1-2013:p0558:b004:l012","ordinal":119718,"en":"The middle of the lungs—"},{"id":"semetey-1-2013:p0558:b004:l013","ordinal":119719,"en":"That is the exact measure."},{"id":"semetey-1-2013:p0558:b004:l014","ordinal":119720,"en":"This Konurbai standing here,"},{"id":"semetey-1-2013:p0558:b004:l015","ordinal":119721,"en":"If I aim my thrust at Konurbai,"},{"id":"semetey-1-2013:p0558:b004:l016","ordinal":119722,"en":"This will be the moment he dies!”"},{"id":"semetey-1-2013:p0558:b004:l017","ordinal":119723,"en":"He arrived ahead of an arrow."},{"id":"semetey-1-2013:p0558:b004:l018","ordinal":119724,"en":"When he reached Kalcha,"},{"id":"semetey-1-2013:p0558:b004:l019","ordinal":119725,"en":"Upon Alkara's back,"},{"id":"semetey-1-2013:p0558:b004:l020","ordinal":119726,"en":"He struck him full on as he passed."},{"id":"semetey-1-2013:p0558:b004:l021","ordinal":119727,"en":"Alööke's Konurbai"},{"id":"semetey-1-2013:p0558:b004:l022","ordinal":119728,"en":"Slipped backward from his saddle,"},{"id":"semetey-1-2013:p0558:b004:l023","ordinal":119729,"en":"His feet slipped from the stirrups,"},{"id":"semetey-1-2013:p0558:b004:l024","ordinal":119730,"en":"His eyes darted wildly,"},{"id":"semetey-1-2013:p0558:b004:l025","ordinal":119731,"en":"His legs dangled,"},{"id":"semetey-1-2013:p0558:b004:l026","ordinal":119732,"en":"He bent far down out of sight."},{"id":"semetey-1-2013:p0558:b004:l027","ordinal":119733,"en":"At Alkara's sacred mane,"},{"id":"semetey-1-2013:p0558:b004:l028","ordinal":119734,"en":"The skillful Konurbai"},{"id":"semetey-1-2013:p0558:b004:l029","ordinal":119735,"en":"Climbed back up and righted himself."},{"id":"semetey-1-2013:p0558:b004:l030","ordinal":119736,"en":"Sixty Chinese, countless kaldai officials,"},{"id":"semetey-1-2013:p0558:b004:l031","ordinal":119737,"en":"All of them came to his aid."},{"id":"semetey-1-2013:p0558:b004:l032","ordinal":119738,"en":"Behind the steel is tone,"},{"id":"semetey-1-2013:p0558:b004:l033","ordinal":119739,"en":"Cursed be solitude!"},{"id":"semetey-1-2013:p0558:b004:l034","ordinal":119740,"en":"A lonely person as a living soul—"},{"id":"semetey-1-2013:p0558:b004:l035","ordinal":119741,"en":"Why could God not have left him uncreated!"},{"id":"semetey-1-2013:p0558:b004:l036","ordinal":119742,"en":"Alööke's Konurbai,"},{"id":"semetey-1-2013:p0558:b004:l037","ordinal":119743,"en":"The warrior Kalcha, at his wits' end,"},{"id":"semetey-1-2013:p0558:b004:l038","ordinal":119744,"en":"Struck Algara upon the flank,"},{"id":"semetey-1-2013:p0558:b004:l039","ordinal":119745,"en":"The great Kalcha, big as a hut,"},{"id":"semetey-1-2013:p0559:b003:l001","ordinal":119746,"en":"Dashed toward Beijing,"},{"id":"semetey-1-2013:p0559:b003:l002","ordinal":119747,"en":"Shouting to his horse without sparing his life."},{"id":"semetey-1-2013:p0559:b003:l003","ordinal":119748,"en":"As Kalcha fled,"},{"id":"semetey-1-2013:p0559:b003:l004","ordinal":119749,"en":"Behind him the lion Almam"},{"id":"semetey-1-2013:p0559:b003:l005","ordinal":119750,"en":"Pursued with stubborn fury."},{"id":"semetey-1-2013:p0559:b003:l006","ordinal":119751,"en":"Upon the open plain he wrought"},{"id":"semetey-1-2013:p0559:b003:l007","ordinal":119752,"en":"Havoc that no other man could make."},{"id":"semetey-1-2013:p0559:b003:l008","ordinal":119753,"en":"Driving him toward Kakan,"},{"id":"semetey-1-2013:p0559:b003:l009","ordinal":119754,"en":"Khan Alman, taking courage,"},{"id":"semetey-1-2013:p0559:b003:l010","ordinal":119755,"en":"Waged a fierce fight."},{"id":"semetey-1-2013:p0559:b003:l011","ordinal":119756,"en":"In the great desert shrouded in haze,"},{"id":"semetey-1-2013:p0559:b003:l012","ordinal":119757,"en":"Alööke's Kalcha,"},{"id":"semetey-1-2013:p0559:b003:l013","ordinal":119758,"en":"When he himself was twelve,"},{"id":"semetey-1-2013:p0559:b003:l014","ordinal":119759,"en":"From Alkara's back"},{"id":"semetey-1-2013:p0559:b003:l015","ordinal":119760,"en":"He thrust down six times."},{"id":"semetey-1-2013:p0559:b003:l016","ordinal":119761,"en":"The wrestlers Eibi and Sheibi,"},{"id":"semetey-1-2013:p0559:b003:l017","ordinal":119762,"en":"Onto Alkara's back,"},{"id":"semetey-1-2013:p0559:b003:l018","ordinal":119763,"en":"Reached him and mounted him,"},{"id":"semetey-1-2013:p0559:b003:l019","ordinal":119764,"en":"Saving him alive."},{"id":"semetey-1-2013:p0559:b003:l020","ordinal":119765,"en":"Propping him upon the dun-bay horse,"},{"id":"semetey-1-2013:p0559:b003:l021","ordinal":119766,"en":"He drove into Beijing"},{"id":"semetey-1-2013:p0559:b003:l022","ordinal":119767,"en":"The swine, the khan of monks,"},{"id":"semetey-1-2013:p0559:b003:l023","ordinal":119768,"en":"Drenched in bright red blood."},{"id":"semetey-1-2013:p0559:b003:l024","ordinal":119769,"en":"His star was eclipsed in heaven."},{"id":"semetey-1-2013:p0559:b003:l025","ordinal":119770,"en":"Into Outer Beijing, where Esen Khan dwelt,"},{"id":"semetey-1-2013:p0559:b003:l026","ordinal":119771,"en":"Konurbai, whose horse was swift,"},{"id":"semetey-1-2013:p0559:b003:l027","ordinal":119772,"en":"Fled inside and escaped."},{"id":"semetey-1-2013:p0559:b003:l028","ordinal":119773,"en":"Covering the ground beneath his feet,"},{"id":"semetey-1-2013:p0559:b003:l029","ordinal":119774,"en":"To Esen Khan himself"},{"id":"semetey-1-2013:p0559:b003:l030","ordinal":119775,"en":"Konurbai arrived first,"},{"id":"semetey-1-2013:p0559:b003:l031","ordinal":119776,"en":"And spoke ill of Almambet:"},{"id":"semetey-1-2013:p0559:b003:l032","ordinal":119777,"en":"“From my hearth I have suffered burning coals;"},{"id":"semetey-1-2013:p0559:b003:l033","ordinal":119778,"en":"From my own kinsman I have suffered tyranny."},{"id":"semetey-1-2013:p0559:b003:l034","ordinal":119779,"en":"My precious eyes like blackcurrants"},{"id":"semetey-1-2013:p0559:b003:l035","ordinal":119780,"en":"He almost gouged out."},{"id":"semetey-1-2013:p0559:b003:l036","ordinal":119781,"en":"In the desert of Mediyan,"},{"id":"semetey-1-2013:p0559:b003:l037","ordinal":119782,"en":"On this side of Beijing,"},{"id":"semetey-1-2013:p0559:b003:l038","ordinal":119783,"en":"From Alkara's back"},{"id":"semetey-1-2013:p0559:b003:l039","ordinal":119784,"en":"He thrust me down six times."},{"id":"semetey-1-2013:p0559:b004:l001","ordinal":119785,"en":"Had my forty nobles not been near,"},{"id":"semetey-1-2013:p0559:b004:l002","ordinal":119786,"en":"He almost slaughtered your Kalcha."},{"id":"semetey-1-2013:p0559:b004:l003","ordinal":119787,"en":"Mounting my rump as though I were an ox,"},{"id":"semetey-1-2013:p0559:b004:l004","ordinal":119788,"en":"As he was about to cut off my head,"},{"id":"semetey-1-2013:p0559:b004:l005","ordinal":119789,"en":"Algara's swiftness proved my salvation."},{"id":"semetey-1-2013:p0559:b004:l006","ordinal":119790,"en":"Aziz Khan's son,"},{"id":"semetey-1-2013:p0559:b004:l007","ordinal":119791,"en":"That bastard Almambet,"},{"id":"semetey-1-2013:p0559:b004:l008","ordinal":119792,"en":"Will not let us turn the plow."},{"id":"semetey-1-2013:p0559:b004:l009","ordinal":119793,"en":"May I be denied my portion if I lie!"},{"id":"semetey-1-2013:p0559:b004:l010","ordinal":119794,"en":"He will not let us dwell in this Beijing."},{"id":"semetey-1-2013:p0559:b004:l011","ordinal":119795,"en":"If we do not slaughter him now,"},{"id":"semetey-1-2013:p0559:b004:l012","ordinal":119796,"en":"He will grind your idols to dust,"},{"id":"semetey-1-2013:p0559:b004:l013","ordinal":119797,"en":"He will destroy this people of yours!"},{"id":"semetey-1-2013:p0559:b004:l014","ordinal":119798,"en":"Now he is only twelve;"},{"id":"semetey-1-2013:p0559:b004:l015","ordinal":119799,"en":"He is still a child at play."},{"id":"semetey-1-2013:p0559:b004:l016","ordinal":119800,"en":"At fifteen he will leave us no peace;"},{"id":"semetey-1-2013:p0559:b004:l017","ordinal":119801,"en":"When his age reaches eighteen,"},{"id":"semetey-1-2013:p0559:b004:l018","ordinal":119802,"en":"My lord, he will leave none of us unharmed."},{"id":"semetey-1-2013:p0559:b004:l020","ordinal":119803,"en":"He will not let us turn the plow in the earth."},{"id":"semetey-1-2013:p0559:b004:l021","ordinal":119804,"en":"May I be denied my portion if I lie!"},{"id":"semetey-1-2013:p0559:b004:l022","ordinal":119805,"en":"He will not let us dwell in this Beijing."},{"id":"semetey-1-2013:p0559:b004:l023","ordinal":119806,"en":"So long as Almambet is alive,"},{"id":"semetey-1-2013:p0559:b004:l024","ordinal":119807,"en":"I will not stay in this Beijing;"},{"id":"semetey-1-2013:p0559:b004:l025","ordinal":119808,"en":"I will not rule the monks as khan."}]
