[{"id":"manas-2010:p1501:b001:l011","ordinal":64769,"en":"Alas for this only child, this wretched head!"},{"id":"manas-2010:p1501:b001:l012","ordinal":64770,"en":"If my bones lie unburied,"},{"id":"manas-2010:p1501:b001:l013","ordinal":64771,"en":"Vultures will shit upon them!"},{"id":"manas-2010:p1501:b001:l014","ordinal":64772,"en":"They will surround me,"},{"id":"manas-2010:p1501:b001:l015","ordinal":64773,"en":"Alas for my precious life!"},{"id":"manas-2010:p1501:b001:l016","ordinal":64774,"en":"They will plunge a dagger in my heart;"},{"id":"manas-2010:p1501:b001:l017","ordinal":64775,"en":"The vengeful Chinese and Manchus"},{"id":"manas-2010:p1501:b001:l018","ordinal":64776,"en":"Will take their vengeance upon me!"},{"id":"manas-2010:p1501:b001:l019","ordinal":64777,"en":"If only he would turn Akkula’s head,"},{"id":"manas-2010:p1501:b001:l020","ordinal":64778,"en":"If, when the Chinese pressed upon me,"},{"id":"manas-2010:p1501:b001:l021","ordinal":64779,"en":"Manas would stand and watch!"},{"id":"manas-2010:p1501:b001:l022","ordinal":64780,"en":"Then let this only child die,"},{"id":"manas-2010:p1501:b001:l023","ordinal":64781,"en":"And let Manas see it then!"},{"id":"manas-2010:p1501:b001:l024","ordinal":64782,"en":"If only they would dig my dark grave wide,"},{"id":"manas-2010:p1501:b001:l025","ordinal":64783,"en":"And the great host of Muslims"},{"id":"manas-2010:p1501:b001:l026","ordinal":64784,"en":"Would bury my dead body!"},{"id":"manas-2010:p1501:b001:l027","ordinal":64785,"en":"If only he would turn Sarala’s head,"},{"id":"manas-2010:p1501:b001:l028","ordinal":64786,"en":"Golden-crested, with a belt like embers,"},{"id":"manas-2010:p1501:b001:l029","ordinal":64787,"en":"And, while this lone soul stood thus,"},{"id":"manas-2010:p1501:b001:l030","ordinal":64788,"en":"Almambet would stand and watch!”"},{"id":"manas-2010:p1501:b001:l031","ordinal":64789,"en":"Before he had finished speaking,"},{"id":"manas-2010:p1501:b001:l032","ordinal":64790,"en":"Azizkhan’s Almambet"},{"id":"manas-2010:p1501:b001:l033","ordinal":64791,"en":"Came galloping from the foothills,"},{"id":"manas-2010:p1501:b001:l034","ordinal":64792,"en":"The Chinese who came before him"},{"id":"manas-2010:p1501:b001:l035","ordinal":64793,"en":"He slew and slaughtered and destroyed;"},{"id":"manas-2010:p1501:b001:l036","ordinal":64794,"en":"And on the nearer side of him,"},{"id":"manas-2010:p1501:b001:l037","ordinal":64795,"en":"Ulak Khan’s Syrgak"},{"id":"manas-2010:p1501:b001:l038","ordinal":64796,"en":"Had come close now,"},{"id":"manas-2010:p1501:b001:l039","ordinal":64797,"en":"Right beside Bokmurun."},{"id":"manas-2010:p1501:b001:l040","ordinal":64798,"en":"Ulak Khan’s Syrgak"},{"id":"manas-2010:p1501:b001:l041","ordinal":64799,"en":"Speared them wherever he reached,"},{"id":"manas-2010:p1501:b001:l042","ordinal":64800,"en":"Cutting seven thousand to pieces,"},{"id":"manas-2010:p1502:b001:l001","ordinal":64801,"en":"“Where is Kokotoy’s only son,"},{"id":"manas-2010:p1502:b001:l002","ordinal":64802,"en":"The warrior Bokmurun?” he cried."},{"id":"manas-2010:p1502:b001:l003","ordinal":64803,"en":"While Syrgak was doing this,"},{"id":"manas-2010:p1502:b001:l004","ordinal":64804,"en":"Your leopard Alma arrived;"},{"id":"manas-2010:p1502:b001:l005","ordinal":64805,"en":"He swept him up from the dark earth,"},{"id":"manas-2010:p1502:b001:l006","ordinal":64806,"en":"Like a sparrowhawk taking a little bird,"},{"id":"manas-2010:p1502:b001:l007","ordinal":64807,"en":"He snatched him up and carried him away."},{"id":"manas-2010:p1502:b001:l008","ordinal":64808,"en":"Showing himself a lion,"},{"id":"manas-2010:p1502:b001:l009","ordinal":64809,"en":"He bore the champion swiftly off"},{"id":"manas-2010:p1502:b001:l010","ordinal":64810,"en":"And mounted him on Maaniker."},{"id":"manas-2010:p1502:b001:l011","ordinal":64811,"en":"Before they could set themselves to rights,"},{"id":"manas-2010:p1502:b001:l012","ordinal":64812,"en":"See the reeds, see the flood,"},{"id":"manas-2010:p1502:b001:l013","ordinal":64813,"en":"See the people surging over them!"},{"id":"manas-2010:p1502:b001:l014","ordinal":64814,"en":"See the embers glowing through the haze!"},{"id":"manas-2010:p1502:b001:l015","ordinal":64815,"en":"When they looked, they could make nothing out;"},{"id":"manas-2010:p1502:b001:l016","ordinal":64816,"en":"Daytime had become black night,"},{"id":"manas-2010:p1502:b001:l017","ordinal":64817,"en":"They could not tell which was which."},{"id":"manas-2010:p1502:b001:l018","ordinal":64818,"en":"They had set the one-eyed men apart"},{"id":"manas-2010:p1502:b001:l019","ordinal":64819,"en":"And placed them before the whole host."},{"id":"manas-2010:p1502:b001:l020","ordinal":64820,"en":"The dog-eating, louse-eating Chinese people"},{"id":"manas-2010:p1502:b001:l021","ordinal":64821,"en":"Had surged upon them all together."},{"id":"manas-2010:p1502:b001:l022","ordinal":64822,"en":"When the Chinese came pouring in,"},{"id":"manas-2010:p1502:b001:l023","ordinal":64823,"en":"Almambet saw this"},{"id":"manas-2010:p1502:b001:l024","ordinal":64824,"en":"And despaired of his lone life."},{"id":"manas-2010:p1502:b001:l025","ordinal":64825,"en":"When he caught sight of the army,"},{"id":"manas-2010:p1502:b001:l026","ordinal":64826,"en":"“Now I shall trade blows!” he said,"},{"id":"manas-2010:p1502:b001:l027","ordinal":64827,"en":"And valiant Syrgak rejoiced."},{"id":"manas-2010:p1502:b001:l028","ordinal":64828,"en":"His quilted coat that bullets could not pierce,"},{"id":"manas-2010:p1502:b001:l029","ordinal":64829,"en":"Up from the level of his navel,"},{"id":"manas-2010:p1502:b001:l030","ordinal":64830,"en":"He hastily donned as he ran."},{"id":"manas-2010:p1502:b001:l031","ordinal":64831,"en":"“The countless Chinese, that deep-rooted people,"},{"id":"manas-2010:p1502:b001:l032","ordinal":64832,"en":"Will overwhelm us!” he said,"},{"id":"manas-2010:p1502:b001:l033","ordinal":64833,"en":"And Chubak stood in anguish."},{"id":"manas-2010:p1502:b001:l034","ordinal":64834,"en":"The renowned warrior Syrgak"},{"id":"manas-2010:p1502:b001:l035","ordinal":64835,"en":"Rejoiced still more than before."},{"id":"manas-2010:p1502:b001:l036","ordinal":64836,"en":"“I shall raise the battle cry against these dog-eaters,"},{"id":"manas-2010:p1502:b001:l037","ordinal":64837,"en":"Drive them, slaughter them and heap them up!"},{"id":"manas-2010:p1502:b001:l038","ordinal":64838,"en":"Grant patience to this life entrusted to me;"},{"id":"manas-2010:p1502:b001:l039","ordinal":64839,"en":"I shall drive the Chinese before me"},{"id":"manas-2010:p1502:b001:l040","ordinal":64840,"en":"And kill them, leaving not a single one!"},{"id":"manas-2010:p1502:b001:l041","ordinal":64841,"en":"The Prophet is true, my faith is true!"},{"id":"manas-2010:p1502:b001:l042","ordinal":64842,"en":"I shall wage battle in earnest."},{"id":"manas-2010:p1503:b001:l001","ordinal":64843,"en":"Alooke’s Kongurbay—"},{"id":"manas-2010:p1503:b001:l002","ordinal":64844,"en":"If that fierce man falls into my hands,"},{"id":"manas-2010:p1503:b001:l003","ordinal":64845,"en":"I shall split him open on the road,"},{"id":"manas-2010:p1503:b001:l004","ordinal":64846,"en":"Thus shall I take my vengeance!"},{"id":"manas-2010:p1503:b001:l005","ordinal":64847,"en":"If you will give me no comradeship,"},{"id":"manas-2010:p1503:b001:l006","ordinal":64848,"en":"If you will not come near, you Muslims,"},{"id":"manas-2010:p1503:b001:l007","ordinal":64849,"en":"Then go upon your way!"},{"id":"manas-2010:p1503:b001:l008","ordinal":64850,"en":"I shall fight the enemy alone,"},{"id":"manas-2010:p1503:b001:l009","ordinal":64851,"en":"And survive wherever death spares me!”"},{"id":"manas-2010:p1503:b001:l010","ordinal":64852,"en":"Saying this, the warrior Syrgak"},{"id":"manas-2010:p1503:b001:l011","ordinal":64853,"en":"Girded his waist firmly,"},{"id":"manas-2010:p1503:b001:l012","ordinal":64854,"en":"And against the Chinese surging in"},{"id":"manas-2010:p1503:b001:l013","ordinal":64855,"en":"He attacked without a pause."},{"id":"manas-2010:p1503:b001:l014","ordinal":64856,"en":"Those he struck and speared"},{"id":"manas-2010:p1503:b001:l015","ordinal":64857,"en":"He flung aside like fur caps;"},{"id":"manas-2010:p1503:b001:l016","ordinal":64858,"en":"Those who came close"},{"id":"manas-2010:p1503:b001:l017","ordinal":64859,"en":"He cut to pieces with his sword."},{"id":"manas-2010:p1503:b001:l018","ordinal":64860,"en":"Azizkhan’s Almambet"},{"id":"manas-2010:p1503:b001:l019","ordinal":64861,"en":"Also plunged into the battle,"},{"id":"manas-2010:p1503:b001:l020","ordinal":64862,"en":"Slaying, slaughtering and spearing."},{"id":"manas-2010:p1503:b001:l021","ordinal":64863,"en":"Tall in stature, broad of shoulder,"},{"id":"manas-2010:p1503:b001:l022","ordinal":64864,"en":"Like a myriad troops against a fighting foe,"},{"id":"manas-2010:p1503:b001:l023","ordinal":64865,"en":"You must have heard of him—"},{"id":"manas-2010:p1503:b001:l024","ordinal":64866,"en":"Khan Baltay’s Chubak,"},{"id":"manas-2010:p1503:b001:l025","ordinal":64867,"en":"And Yraman’s son Yrchy,"},{"id":"manas-2010:p1503:b001:l026","ordinal":64868,"en":"With the forty companions at the front,"},{"id":"manas-2010:p1503:b001:l027","ordinal":64869,"en":"Now joined the crushing battle."},{"id":"manas-2010:p1503:b001:l028","ordinal":64870,"en":"Once the Muslims lent their support,"},{"id":"manas-2010:p1503:b001:l029","ordinal":64871,"en":"From the Chinese and Manchus"},{"id":"manas-2010:p1503:b001:l030","ordinal":64872,"en":"They made red blood flow;"},{"id":"manas-2010:p1503:b001:l031","ordinal":64873,"en":"The three now wrought a slaughter."},{"id":"manas-2010:p1503:b001:l032","ordinal":64874,"en":"With no chance to exchange shots,"},{"id":"manas-2010:p1503:b001:l033","ordinal":64875,"en":"The heroes fought at close quarters;"},{"id":"manas-2010:p1503:b001:l034","ordinal":64876,"en":"Untiring in their blows,"},{"id":"manas-2010:p1503:b001:l035","ordinal":64877,"en":"A merciless slaughter"},{"id":"manas-2010:p1503:b001:l036","ordinal":64878,"en":"The heroes were inflicting."},{"id":"manas-2010:p1503:b001:l037","ordinal":64879,"en":"Not letting their coat-skirts touch the earth,"},{"id":"manas-2010:p1503:b001:l038","ordinal":64880,"en":"Not letting them break through among them,"},{"id":"manas-2010:p1503:b001:l039","ordinal":64881,"en":"Driving them back and hemming them in,"},{"id":"manas-2010:p1503:b001:l040","ordinal":64882,"en":"Shattering the many Chinese,"},{"id":"manas-2010:p1503:b001:l041","ordinal":64883,"en":"Keeping them from approaching the Muslims,"},{"id":"manas-2010:p1503:b001:l042","ordinal":64884,"en":"Warrior Syrgak stood barring their way,"},{"id":"manas-2010:p1504:b001:l001","ordinal":64885,"en":"That place was harsh indeed,"},{"id":"manas-2010:p1504:b001:l002","ordinal":64886,"en":"Without grass for a single bite,"},{"id":"manas-2010:p1504:b001:l003","ordinal":64887,"en":"Without water for a single sip;"},{"id":"manas-2010:p1504:b001:l004","ordinal":64888,"en":"This desert was all sand."},{"id":"manas-2010:p1504:b001:l005","ordinal":64889,"en":"Fighting in this desert,"},{"id":"manas-2010:p1504:b001:l006","ordinal":64890,"en":"The wide world narrowed about them."},{"id":"manas-2010:p1504:b001:l007","ordinal":64891,"en":"Springheads, springs and fescue—"},{"id":"manas-2010:p1504:b001:l008","ordinal":64892,"en":"Every man in that army"},{"id":"manas-2010:p1504:b001:l009","ordinal":64893,"en":"Longed to see them even once."},{"id":"manas-2010:p1504:b001:l010","ordinal":64894,"en":"The coursers shook their heads, refusing to go;"},{"id":"manas-2010:p1504:b001:l011","ordinal":64895,"en":"All the noble hawk-like warriors"},{"id":"manas-2010:p1504:b001:l012","ordinal":64896,"en":"Stared wide-eyed with thirst."},{"id":"manas-2010:p1504:b001:l013","ordinal":64897,"en":"Having plunged unsparingly into battle,"},{"id":"manas-2010:p1504:b001:l014","ordinal":64898,"en":"Their heads were buckets of blood;"},{"id":"manas-2010:p1504:b001:l015","ordinal":64899,"en":"Dust filled their chests,"},{"id":"manas-2010:p1504:b001:l016","ordinal":64900,"en":"And they longed to draw a breath."},{"id":"manas-2010:p1504:b001:l017","ordinal":64901,"en":"The horses barely stirred;"},{"id":"manas-2010:p1504:b001:l018","ordinal":64902,"en":"The brave men's eyes"},{"id":"manas-2010:p1504:b001:l019","ordinal":64903,"en":"Barely showed a glimmer."},{"id":"manas-2010:p1504:b001:l020","ordinal":64904,"en":"Drenched in bloody gore,"},{"id":"manas-2010:p1504:b001:l021","ordinal":64905,"en":"The leopards Chubak and Almambet,"},{"id":"manas-2010:p1504:b001:l022","ordinal":64906,"en":"And the dear mighty wolf, hero Syrgak,"},{"id":"manas-2010:p1504:b001:l023","ordinal":64907,"en":"Fought on without fleeing."},{"id":"manas-2010:p1504:b001:l024","ordinal":64908,"en":"That they endured so much"},{"id":"manas-2010:p1504:b001:l025","ordinal":64909,"en":"Was because Kanykey had known"},{"id":"manas-2010:p1504:b001:l026","ordinal":64910,"en":"From the start what would befall them."},{"id":"manas-2010:p1504:b001:l027","ordinal":64911,"en":"“When your very lives are strained,"},{"id":"manas-2010:p1504:b001:l028","ordinal":64912,"en":"My darling sons,"},{"id":"manas-2010:p1504:b001:l029","ordinal":64913,"en":"Take these provisions with you,"},{"id":"manas-2010:p1504:b001:l030","ordinal":64914,"en":"This restoring herb to feed the horses;"},{"id":"manas-2010:p1504:b001:l031","ordinal":64915,"en":"When a dark day comes upon you,"},{"id":"manas-2010:p1504:b001:l032","ordinal":64916,"en":"These will prove useful,” she had said."},{"id":"manas-2010:p1504:b001:l033","ordinal":64917,"en":"From Jerusalem and Egypt"},{"id":"manas-2010:p1504:b001:l034","ordinal":64918,"en":"She had made them seek it without fail;"},{"id":"manas-2010:p1504:b001:l035","ordinal":64919,"en":"She had sent warrior Shuutu,"},{"id":"manas-2010:p1504:b001:l036","ordinal":64920,"en":"With a letter to five holy men,"},{"id":"manas-2010:p1504:b001:l037","ordinal":64921,"en":"And had it brought as a gift."},{"id":"manas-2010:p1504:b001:l038","ordinal":64922,"en":"If a man chewed a thumb-sized piece,"},{"id":"manas-2010:p1504:b001:l039","ordinal":64923,"en":"It satisfied his longing;"},{"id":"manas-2010:p1504:b001:l040","ordinal":64924,"en":"If five stalks were taken and chewed,"},{"id":"manas-2010:p1504:b001:l041","ordinal":64925,"en":"They quenched a courser's thirst."},{"id":"manas-2010:p1504:b001:l042","ordinal":64926,"en":"Sealing it in a hide bag,"},{"id":"manas-2010:p1505:b001:l001","ordinal":64927,"en":"Had she not folded it and given it?"},{"id":"manas-2010:p1505:b001:l002","ordinal":64928,"en":"Upon the swift camel,"},{"id":"manas-2010:p1505:b001:l003","ordinal":64929,"en":"When they set out from broad Talas,"},{"id":"manas-2010:p1505:b001:l004","ordinal":64930,"en":"Had wondrous Kanykey"},{"id":"manas-2010:p1505:b001:l005","ordinal":64931,"en":"Not loaded it for them?"},{"id":"manas-2010:p1505:b001:l006","ordinal":64932,"en":"“The lions will suffer hardship,”"},{"id":"manas-2010:p1505:b001:l007","ordinal":64933,"en":"Had she not thought and provided it?"},{"id":"manas-2010:p1505:b001:l008","ordinal":64934,"en":"“If the day of the world's end comes,"},{"id":"manas-2010:p1505:b001:l009","ordinal":64935,"en":"If the night is dark and moonless,"},{"id":"manas-2010:p1505:b001:l010","ordinal":64936,"en":"The noble ones will need this.”"},{"id":"manas-2010:p1505:b001:l011","ordinal":64937,"en":"Entrusting it to them, Kanykey said,"},{"id":"manas-2010:p1505:b001:l012","ordinal":64938,"en":"“May you be safe, my wolves!”"},{"id":"manas-2010:p1505:b001:l013","ordinal":64939,"en":"Had she not wept as she gave it?"},{"id":"manas-2010:p1505:b001:l014","ordinal":64940,"en":"When the warrior tasted the provisions,"},{"id":"manas-2010:p1505:b001:l015","ordinal":64941,"en":"He grew eager, bursting with strength;"},{"id":"manas-2010:p1505:b001:l016","ordinal":64942,"en":"When the horse tasted the provisions,"},{"id":"manas-2010:p1505:b001:l017","ordinal":64943,"en":"It grew eager and ready."},{"id":"manas-2010:p1505:b001:l018","ordinal":64944,"en":"Every one of the lions,"},{"id":"manas-2010:p1505:b001:l019","ordinal":64945,"en":"When they tasted the provisions,"},{"id":"manas-2010:p1505:b001:l020","ordinal":64946,"en":"Opened their eyes wide;"},{"id":"manas-2010:p1505:b001:l021","ordinal":64947,"en":"Their aching places ceased to hurt."},{"id":"manas-2010:p1505:b001:l022","ordinal":64948,"en":"“Where are the Chinese? Where?” they cried,"},{"id":"manas-2010:p1505:b001:l023","ordinal":64949,"en":"Striking their horses with their whips."},{"id":"manas-2010:p1505:b001:l024","ordinal":64950,"en":"Vigorous young men and swift horses"},{"id":"manas-2010:p1505:b001:l025","ordinal":64951,"en":"Regained their strength;"},{"id":"manas-2010:p1505:b001:l026","ordinal":64952,"en":"Fire flashed from their black eyes,"},{"id":"manas-2010:p1505:b001:l027","ordinal":64953,"en":"And they went back into battle."},{"id":"manas-2010:p1505:b001:l028","ordinal":64954,"en":"Without resting in the day,"},{"id":"manas-2010:p1505:b001:l029","ordinal":64955,"en":"Without stopping in the night,"},{"id":"manas-2010:p1505:b001:l030","ordinal":64956,"en":"Without leaning on an elbow to rest,"},{"id":"manas-2010:p1505:b001:l031","ordinal":64957,"en":"Without even a brief doze,"},{"id":"manas-2010:p1505:b001:l032","ordinal":64958,"en":"Chinese beneath them, flowing blood,"},{"id":"manas-2010:p1505:b001:l033","ordinal":64959,"en":"So many people in distress."},{"id":"manas-2010:p1505:b001:l034","ordinal":64960,"en":"Dark blood flowed and clotted;"},{"id":"manas-2010:p1505:b001:l035","ordinal":64961,"en":"They fought on without fleeing."},{"id":"manas-2010:p1505:b001:l036","ordinal":64962,"en":"Many a noble lion died;"},{"id":"manas-2010:p1505:b001:l037","ordinal":64963,"en":"Many bodies lay shattered."},{"id":"manas-2010:p1505:b001:l038","ordinal":64964,"en":"The multitude of dead"},{"id":"manas-2010:p1505:b001:l039","ordinal":64965,"en":"Loomed like a mountain."},{"id":"manas-2010:p1505:b001:l040","ordinal":64966,"en":"Gray-bearded elders died;"},{"id":"manas-2010:p1505:b001:l041","ordinal":64967,"en":"All the coursers died;"},{"id":"manas-2010:p1505:b001:l042","ordinal":64968,"en":"The people's ranks were scattered."},{"id":"manas-2010:p1506:b001:l001","ordinal":64969,"en":"As Chinese and Muslims"},{"id":"manas-2010:p1506:b001:l002","ordinal":64970,"en":"Clashed fiercely together,"},{"id":"manas-2010:p1506:b001:l003","ordinal":64971,"en":"So many heads were cut off;"},{"id":"manas-2010:p1506:b001:l004","ordinal":64972,"en":"So many proud people died."},{"id":"manas-2010:p1506:b001:l005","ordinal":64973,"en":"Graceful as young shoots,"},{"id":"manas-2010:p1506:b001:l006","ordinal":64974,"en":"Children not yet of age died."},{"id":"manas-2010:p1506:b001:l007","ordinal":64975,"en":"Those left alive among the dead"},{"id":"manas-2010:p1506:b001:l008","ordinal":64976,"en":"Were covered in red blood;"},{"id":"manas-2010:p1506:b001:l009","ordinal":64977,"en":"Still more lay wounded."},{"id":"manas-2010:p1506:b001:l010","ordinal":64978,"en":"Barely leaning on their horses,"},{"id":"manas-2010:p1506:b001:l011","ordinal":64979,"en":"Their cruppers torn,"},{"id":"manas-2010:p1506:b001:l012","ordinal":64980,"en":"Many could not stitch them up."},{"id":"manas-2010:p1506:b001:l013","ordinal":64981,"en":"Their saddle-girths broken,"},{"id":"manas-2010:p1506:b001:l014","ordinal":64982,"en":"Their two eyes starting out,"},{"id":"manas-2010:p1506:b001:l015","ordinal":64983,"en":"Many could not put things right."},{"id":"manas-2010:p1506:b001:l016","ordinal":64984,"en":"Of many swift coursers,"},{"id":"manas-2010:p1506:b001:l017","ordinal":64985,"en":"With saddles slipped beneath their bellies,"},{"id":"manas-2010:p1506:b001:l018","ordinal":64986,"en":"Still more men led them along."},{"id":"manas-2010:p1506:b001:l019","ordinal":64987,"en":"“My precious, dear kinsman"},{"id":"manas-2010:p1506:b001:l020","ordinal":64988,"en":"Died in such a place,” they said;"},{"id":"manas-2010:p1506:b001:l021","ordinal":64989,"en":"Still more went about wailing."},{"id":"manas-2010:p1506:b001:l022","ordinal":64990,"en":"Struck in the eye with a lance,"},{"id":"manas-2010:p1506:b001:l023","ordinal":64991,"en":"Still more had lost an eye;"},{"id":"manas-2010:p1506:b001:l024","ordinal":64992,"en":"Their arms torn away by arrows,"},{"id":"manas-2010:p1506:b001:l025","ordinal":64993,"en":"Still more were maimed."},{"id":"manas-2010:p1506:b001:l026","ordinal":64994,"en":"Struck on the head with a battle-axe,"},{"id":"manas-2010:p1506:b001:l027","ordinal":64995,"en":"Still more went fleeing."},{"id":"manas-2010:p1506:b001:l028","ordinal":64996,"en":"Unable to find their wits,"},{"id":"manas-2010:p1506:b001:l029","ordinal":64997,"en":"“If only I could escape back,”"},{"id":"manas-2010:p1506:b001:l030","ordinal":64998,"en":"Still more hurried in alarm."},{"id":"manas-2010:p1506:b001:l031","ordinal":64999,"en":"Reining in their horses,"},{"id":"manas-2010:p1506:b001:l032","ordinal":65000,"en":"“This world is false,” they said,"},{"id":"manas-2010:p1506:b001:l033","ordinal":65001,"en":"Entrusting things to one another,"},{"id":"manas-2010:p1506:b001:l034","ordinal":65002,"en":"Speaking their final wishes in earnest."},{"id":"manas-2010:p1506:b001:l035","ordinal":65003,"en":"All the brave men rejoiced;"},{"id":"manas-2010:p1506:b001:l036","ordinal":65004,"en":"The foolish, wretched cowards"},{"id":"manas-2010:p1506:b001:l037","ordinal":65005,"en":"Lost their senses in distress."},{"id":"manas-2010:p1506:b001:l038","ordinal":65006,"en":"All the mighty men,"},{"id":"manas-2010:p1506:b001:l039","ordinal":65007,"en":"Without drawing back,"},{"id":"manas-2010:p1506:b001:l040","ordinal":65008,"en":"Fought with blows that thudded;"},{"id":"manas-2010:p1506:b001:l041","ordinal":65009,"en":"All the seasoned fighters"},{"id":"manas-2010:p1506:b001:l042","ordinal":65010,"en":"Seized one another by the lower hems."},{"id":"manas-2010:p1507:b001:l001","ordinal":65011,"en":"Unbelievers and Muslims"},{"id":"manas-2010:p1507:b001:l002","ordinal":65012,"en":"Faced each other without turning,"},{"id":"manas-2010:p1507:b001:l003","ordinal":65013,"en":"Fighting a thrilling battle."},{"id":"manas-2010:p1507:b001:l004","ordinal":65014,"en":"Warriors skilled with spears,"},{"id":"manas-2010:p1507:b001:l005","ordinal":65015,"en":"Champions who were true lions,"},{"id":"manas-2010:p1507:b001:l006","ordinal":65016,"en":"Made their horses race like arrows;"},{"id":"manas-2010:p1507:b001:l007","ordinal":65017,"en":"With a single thrust of the lance,"},{"id":"manas-2010:p1507:b001:l008","ordinal":65018,"en":"They toppled men from horseback,"},{"id":"manas-2010:p1507:b001:l009","ordinal":65019,"en":"Bringing them down like mountains,"},{"id":"manas-2010:p1507:b001:l010","ordinal":65020,"en":"And fought without a pause."},{"id":"manas-2010:p1507:b001:l011","ordinal":65021,"en":"Almambet and Chubak were heroes;"},{"id":"manas-2010:p1507:b001:l012","ordinal":65022,"en":"Behind them Syrgak was a lion."},{"id":"manas-2010:p1507:b001:l013","ordinal":65023,"en":"Argynkan's son Azhybay"},{"id":"manas-2010:p1507:b001:l014","ordinal":65024,"en":"Was their true support."}]
