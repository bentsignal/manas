[{"id":"semetey-1-2013:p1207:b005:l002","ordinal":169217,"en":"Kongurbay was humiliated,"},{"id":"semetey-1-2013:p1207:b005:l003","ordinal":169218,"en":"Khan Joloy was disgraced,"},{"id":"semetey-1-2013:p1207:b005:l004","ordinal":169219,"en":"And Tukubay was utterly killed."},{"id":"semetey-1-2013:p1207:b005:l005","ordinal":169220,"en":"There is the sorrow of the dark hour;"},{"id":"semetey-1-2013:p1207:b005:l006","ordinal":169221,"en":"Hear, O Muslims,"},{"id":"semetey-1-2013:p1207:b005:l007","ordinal":169222,"en":"Whose turn it is to grapple."},{"id":"semetey-1-2013:p1207:b005:l008","ordinal":169223,"en":"You have dealt terrible wrath"},{"id":"semetey-1-2013:p1207:b005:l009","ordinal":169224,"en":"To the black-worm infidel,"},{"id":"semetey-1-2013:p1207:b005:l010","ordinal":169225,"en":"To hero Khan Kongurbay."},{"id":"semetey-1-2013:p1207:b005:l011","ordinal":169226,"en":"Joloy has become vengeful;"},{"id":"semetey-1-2013:p1207:b005:l012","ordinal":169227,"en":"Tukubay died without a word."},{"id":"semetey-1-2013:p1207:b005:l013","ordinal":169228,"en":"No man has defeated by battle"},{"id":"semetey-1-2013:p1207:b005:l014","ordinal":169229,"en":"The seething Chinese host;"},{"id":"semetey-1-2013:p1207:b005:l015","ordinal":169230,"en":"These surging Chinese"},{"id":"semetey-1-2013:p1207:b005:l016","ordinal":169231,"en":"Are a flood no barrier can hold."},{"id":"semetey-1-2013:p1207:b005:l017","ordinal":169232,"en":"They are the proud Chinese people;"},{"id":"semetey-1-2013:p1207:b005:l018","ordinal":169233,"en":"They have won many prizes,"},{"id":"semetey-1-2013:p1207:b005:l019","ordinal":169234,"en":"And you have disgraced them."},{"id":"semetey-1-2013:p1207:b005:l020","ordinal":169235,"en":"Many regrets remain after a man;"},{"id":"semetey-1-2013:p1207:b005:l021","ordinal":169236,"en":"Such is this treacherous world."},{"id":"semetey-1-2013:p1207:b005:l022","ordinal":169237,"en":"We received it from learned tradition"},{"id":"semetey-1-2013:p1207:b005:l023","ordinal":169238,"en":"And asked those who know."},{"id":"semetey-1-2013:p1207:b005:l024","ordinal":169239,"en":"No man could match them;"},{"id":"semetey-1-2013:p1207:b005:l025","ordinal":169240,"en":"Whoever did did not survive."},{"id":"semetey-1-2013:p1207:b005:l026","ordinal":169241,"en":"Their lowlands were grassy,"},{"id":"semetey-1-2013:p1207:b005:l027","ordinal":169242,"en":"And their people were numerous."},{"id":"semetey-1-2013:p1207:b005:l028","ordinal":169243,"en":"Their spirit was great, their name renowned;"},{"id":"semetey-1-2013:p1207:b005:l029","ordinal":169244,"en":"Whoever fought them did not survive."},{"id":"semetey-1-2013:p1207:b005:l030","ordinal":169245,"en":"The Black Chinese creatures"},{"id":"semetey-1-2013:p1207:b005:l031","ordinal":169246,"en":"Have come to the last man"},{"id":"semetey-1-2013:p1207:b005:l032","ordinal":169247,"en":"From the people of Chynchy-Mynchy,"},{"id":"semetey-1-2013:p1207:b005:l033","ordinal":169248,"en":"From the land of the true Khagan."},{"id":"semetey-1-2013:p1207:b005:l034","ordinal":169249,"en":"The Chinese host is a flood;"},{"id":"semetey-1-2013:p1207:b005:l035","ordinal":169250,"en":"At one crooked provocation,"},{"id":"semetey-1-2013:p1207:b005:l036","ordinal":169251,"en":"It is ready to engulf us."},{"id":"semetey-1-2013:p1208:b003:l001","ordinal":169252,"en":"They have deceptive words;"},{"id":"semetey-1-2013:p1208:b003:l002","ordinal":169253,"en":"If we shriek and quarrel,"},{"id":"semetey-1-2013:p1208:b003:l003","ordinal":169254,"en":"They themselves can strike us down."},{"id":"semetey-1-2013:p1208:b003:l004","ordinal":169255,"en":"They have a people called Machin,"},{"id":"semetey-1-2013:p1208:b003:l005","ordinal":169256,"en":"Their crown hair bristling,"},{"id":"semetey-1-2013:p1208:b003:l006","ordinal":169257,"en":"Ready together to attack."},{"id":"semetey-1-2013:p1208:b003:l007","ordinal":169258,"en":"This gathering that has come"},{"id":"semetey-1-2013:p1208:b003:l008","ordinal":169259,"en":"Is Khan Kokotoy's feast;"},{"id":"semetey-1-2013:p1208:b003:l009","ordinal":169260,"en":"If we take heed, people,"},{"id":"semetey-1-2013:p1208:b003:l010","ordinal":169261,"en":"It is the start of great strife."},{"id":"semetey-1-2013:p1208:b003:l011","ordinal":169262,"en":"Your Bakay who speaks"},{"id":"semetey-1-2013:p1208:b003:l012","ordinal":169263,"en":"Has words without end."},{"id":"semetey-1-2013:p1208:b003:l013","ordinal":169264,"en":"The smoldering Chinese"},{"id":"semetey-1-2013:p1208:b003:l014","ordinal":169265,"en":"Are filled with vengeance."},{"id":"semetey-1-2013:p1208:b003:l015","ordinal":169266,"en":"When your stallion comes in,"},{"id":"semetey-1-2013:p1208:b003:l016","ordinal":169267,"en":"May they not seize its prize by force."},{"id":"semetey-1-2013:p1208:b003:l017","ordinal":169268,"en":"If I quarrel over the prize,"},{"id":"semetey-1-2013:p1208:b003:l018","ordinal":169269,"en":"May they not make sport of us."},{"id":"semetey-1-2013:p1208:b003:l019","ordinal":169270,"en":"The snarling infidels,"},{"id":"semetey-1-2013:p1208:b003:l020","ordinal":169271,"en":"The warriors of Khan Kongurbay,"},{"id":"semetey-1-2013:p1208:b003:l021","ordinal":169272,"en":"If the Muslims' stallion"},{"id":"semetey-1-2013:p1208:b003:l022","ordinal":169273,"en":"Should suddenly come in,"},{"id":"semetey-1-2013:p1208:b003:l023","ordinal":169274,"en":"May they not cause slaughter"},{"id":"semetey-1-2013:p1208:b003:l024","ordinal":169275,"en":"In a sudden frenzy."},{"id":"semetey-1-2013:p1208:b003:l025","ordinal":169276,"en":"Let us choose an envoy"},{"id":"semetey-1-2013:p1208:b003:l026","ordinal":169277,"en":"Who knows seventy foreign tongues:"},{"id":"semetey-1-2013:p1208:b003:l027","ordinal":169278,"en":"Agybay of Argyn Khan;"},{"id":"semetey-1-2013:p1208:b003:l028","ordinal":169279,"en":"Hero Urbu, son of Taz,"},{"id":"semetey-1-2013:p1208:b003:l029","ordinal":169280,"en":"Who knows seventy foreign tongues,"},{"id":"semetey-1-2013:p1208:b003:l030","ordinal":169281,"en":"Sharpens his eloquent tongue,"},{"id":"semetey-1-2013:p1208:b003:l031","ordinal":169282,"en":"And, if sent without warning,"},{"id":"semetey-1-2013:p1208:b003:l032","ordinal":169283,"en":"Speaks the Chinese language."},{"id":"semetey-1-2013:p1208:b003:l033","ordinal":169284,"en":"Almambet of Aziz Khan"},{"id":"semetey-1-2013:p1208:b003:l034","ordinal":169285,"en":"Could not be subdued by force."},{"id":"semetey-1-2013:p1208:b003:l035","ordinal":169286,"en":"His ancestor was Chylaba;"},{"id":"semetey-1-2013:p1208:b003:l036","ordinal":169287,"en":"He disputed Chylaba's khanship"},{"id":"semetey-1-2013:p1208:b003:l037","ordinal":169288,"en":"In true Beijing."},{"id":"semetey-1-2013:p1208:b003:l038","ordinal":169289,"en":"Calling him a true infidel,"},{"id":"semetey-1-2013:p1208:b003:l039","ordinal":169290,"en":"The long-haired Chinese"},{"id":"semetey-1-2013:p1208:b004:l001","ordinal":169291,"en":"Lost track of his origin."},{"id":"semetey-1-2013:p1208:b004:l002","ordinal":169292,"en":"Mighty city and powerful people—"},{"id":"semetey-1-2013:p1208:b004:l003","ordinal":169293,"en":"The noble leopard Almam,"},{"id":"semetey-1-2013:p1208:b004:l004","ordinal":169294,"en":"Because of their jealousy,"},{"id":"semetey-1-2013:p1208:b004:l005","ordinal":169295,"en":"Fought Kun Jang-jung."},{"id":"semetey-1-2013:p1208:b004:l006","ordinal":169296,"en":"He found land at the turning place;"},{"id":"semetey-1-2013:p1208:b004:l007","ordinal":169297,"en":"Unable to fit among these Chinese,"},{"id":"semetey-1-2013:p1208:b004:l008","ordinal":169298,"en":"He found a people among the Muslims."},{"id":"semetey-1-2013:p1208:b004:l009","ordinal":169299,"en":"If you explain the words"},{"id":"semetey-1-2013:p1208:b004:l010","ordinal":169300,"en":"Spoken by lion Lord Bakay,"},{"id":"semetey-1-2013:p1208:b004:l011","ordinal":169301,"en":"Put Chylaba's coat"},{"id":"semetey-1-2013:p1208:b004:l012","ordinal":169302,"en":"Upon your elder Ala;"},{"id":"semetey-1-2013:p1208:b004:l013","ordinal":169303,"en":"Send him unnoticed,"},{"id":"semetey-1-2013:p1208:b004:l014","ordinal":169304,"en":"As a Chinese of Chin-Machin,"},{"id":"semetey-1-2013:p1208:b004:l015","ordinal":169305,"en":"As a genuine Chinese."},{"id":"semetey-1-2013:p1208:b004:l016","ordinal":169306,"en":"If he prays to the true God,"},{"id":"semetey-1-2013:p1208:b004:l017","ordinal":169307,"en":"When the tulpar comes in,"},{"id":"semetey-1-2013:p1208:b004:l018","ordinal":169308,"en":"Your foreign-born leopard Almam"},{"id":"semetey-1-2013:p1208:b004:l019","ordinal":169309,"en":"Will raise the Chinese battle cry,"},{"id":"semetey-1-2013:p1208:b004:l020","ordinal":169310,"en":"Cheering, 'Chin-Machin!'"},{"id":"semetey-1-2013:p1208:b004:l021","ordinal":169311,"en":"Then truly God will grant it,"},{"id":"semetey-1-2013:p1208:b004:l022","ordinal":169312,"en":"And the Muslims will see"},{"id":"semetey-1-2013:p1208:b004:l023","ordinal":169313,"en":"The arriving tulpar safe."},{"id":"semetey-1-2013:p1208:b004:l024","ordinal":169314,"en":"If we do not use this device,"},{"id":"semetey-1-2013:p1208:b004:l025","ordinal":169315,"en":"Your tulpar that comes in"},{"id":"semetey-1-2013:p1208:b004:l026","ordinal":169316,"en":"Will die at Kongurbay's hand."},{"id":"semetey-1-2013:p1208:b004:l027","ordinal":169317,"en":"There where the horses were driven"},{"id":"semetey-1-2013:p1208:b004:l028","ordinal":169318,"en":"Is a corner of Urchuktu."},{"id":"semetey-1-2013:p1208:b004:l029","ordinal":169319,"en":"Very like Akkula,"},{"id":"semetey-1-2013:p1208:b004:l030","ordinal":169320,"en":"Hero Joloy's Surkula"},{"id":"semetey-1-2013:p1208:b004:l031","ordinal":169321,"en":"Bears this dark misfortune."},{"id":"semetey-1-2013:p1208:b004:l032","ordinal":169322,"en":"Orongu's rough-gaited bay mare,"},{"id":"semetey-1-2013:p1208:b004:l033","ordinal":169323,"en":"And young Keney's bay yearling,"},{"id":"semetey-1-2013:p1208:b004:l034","ordinal":169324,"en":"Was a yearling gone in sorrow."},{"id":"semetey-1-2013:p1208:b004:l035","ordinal":169325,"en":"It had great regret."},{"id":"semetey-1-2013:p1208:b004:l036","ordinal":169326,"en":"Do not demand it outright,"},{"id":"semetey-1-2013:p1208:b004:l037","ordinal":169327,"en":"Saying the yearling came first."},{"id":"semetey-1-2013:p1208:b004:l038","ordinal":169328,"en":"Do not tear it to pieces"},{"id":"semetey-1-2013:p1208:b004:l039","ordinal":169329,"en":"Before it reaches maturity."},{"id":"semetey-1-2013:p1209:b003:l001","ordinal":169330,"en":"Forty companions of Khan Manas,"},{"id":"semetey-1-2013:p1209:b003:l002","ordinal":169331,"en":"Choose tulpars and mount."},{"id":"semetey-1-2013:p1209:b003:l003","ordinal":169332,"en":"Against the Black Kalmyks and Manchus,"},{"id":"semetey-1-2013:p1209:b003:l004","ordinal":169333,"en":"Enter with true courage."},{"id":"semetey-1-2013:p1209:b003:l005","ordinal":169334,"en":"When they draw near the prize,"},{"id":"semetey-1-2013:p1209:b003:l006","ordinal":169335,"en":"Raise the battle cry in earnest."},{"id":"semetey-1-2013:p1209:b003:l007","ordinal":169336,"en":"There is no overcoming tulpar Akkula;"},{"id":"semetey-1-2013:p1209:b003:l008","ordinal":169337,"en":"When the stallion comes in,"},{"id":"semetey-1-2013:p1209:b003:l009","ordinal":169338,"en":"Take the grand prize!\""},{"id":"semetey-1-2013:p1209:b003:l010","ordinal":169339,"en":"Hearing these words from Bakay,"},{"id":"semetey-1-2013:p1209:b003:l011","ordinal":169340,"en":"Skirting along Karkyra"},{"id":"semetey-1-2013:p1209:b003:l012","ordinal":169341,"en":"And guarding Chong-Kegen,"},{"id":"semetey-1-2013:p1209:b003:l013","ordinal":169342,"en":"The Muslim host rushed forward,"},{"id":"semetey-1-2013:p1209:b003:l014","ordinal":169343,"en":"Crying down the valley."},{"id":"semetey-1-2013:p1209:b003:l015","ordinal":169344,"en":"Dust billowed to the sky."},{"id":"semetey-1-2013:p1209:b003:l016","ordinal":169345,"en":"To inflict severe torment"},{"id":"semetey-1-2013:p1209:b003:l017","ordinal":169346,"en":"And demand the horse,"},{"id":"semetey-1-2013:p1209:b003:l018","ordinal":169347,"en":"The Kalmyk host rushed forward."},{"id":"semetey-1-2013:p1209:b003:l019","ordinal":169348,"en":"The army spread across the steppe,"},{"id":"semetey-1-2013:p1209:b003:l020","ordinal":169349,"en":"Engulfing it not a little but greatly,"},{"id":"semetey-1-2013:p1209:b003:l021","ordinal":169350,"en":"Dividing into many kinds."},{"id":"semetey-1-2013:p1209:b003:l022","ordinal":169351,"en":"The ground cracked and thundered;"},{"id":"semetey-1-2013:p1209:b003:l023","ordinal":169352,"en":"The brass horn shrieked."},{"id":"semetey-1-2013:p1209:b003:l024","ordinal":169353,"en":"The drum was beaten loudly;"},{"id":"semetey-1-2013:p1209:b003:l025","ordinal":169354,"en":"The surging multitude of lords"},{"id":"semetey-1-2013:p1209:b003:l026","ordinal":169355,"en":"Advanced in a closed mass."},{"id":"semetey-1-2013:p1209:b003:l027","ordinal":169356,"en":"Dust flew and haze burned;"},{"id":"semetey-1-2013:p1209:b003:l028","ordinal":169357,"en":"Armored men stood apart,"},{"id":"semetey-1-2013:p1209:b003:l029","ordinal":169358,"en":"And their heroes appeared."},{"id":"semetey-1-2013:p1209:b003:l030","ordinal":169359,"en":"The multitude covered the Ili like black worms;"},{"id":"semetey-1-2013:p1209:b003:l031","ordinal":169360,"en":"When one looked,"},{"id":"semetey-1-2013:p1209:b003:l032","ordinal":169361,"en":"Flying earth and dust hid it."},{"id":"semetey-1-2013:p1209:b003:l033","ordinal":169362,"en":"Dust struck against dust"},{"id":"semetey-1-2013:p1209:b003:l034","ordinal":169363,"en":"And curled into the sky."},{"id":"semetey-1-2013:p1209:b003:l035","ordinal":169364,"en":"As though making an attack,"},{"id":"semetey-1-2013:p1209:b003:l036","ordinal":169365,"en":"The people poured toward the horses"},{"id":"semetey-1-2013:p1209:b003:l037","ordinal":169366,"en":"Like black worms."},{"id":"semetey-1-2013:p1209:b003:l038","ordinal":169367,"en":"Heads of beasts collided,"},{"id":"semetey-1-2013:p1209:b003:l039","ordinal":169368,"en":"And spearheads struck one another."},{"id":"semetey-1-2013:p1209:b005:l001","ordinal":169369,"en":"When rough hill country came,"},{"id":"semetey-1-2013:p1209:b005:l002","ordinal":169370,"en":"They crossed it with force."},{"id":"semetey-1-2013:p1209:b005:l003","ordinal":169371,"en":"Then your lion Sultan Alma"},{"id":"semetey-1-2013:p1209:b005:l004","ordinal":169372,"en":"Covered the piebald horse"},{"id":"semetey-1-2013:p1209:b005:l005","ordinal":169373,"en":"With his abay cloak."},{"id":"semetey-1-2013:p1209:b005:l006","ordinal":169374,"en":"Your elder Ala flew like an arrow,"},{"id":"semetey-1-2013:p1209:b005:l007","ordinal":169375,"en":"Riding steadily along the road,"},{"id":"semetey-1-2013:p1209:b005:l008","ordinal":169376,"en":"Making his headdress tower."},{"id":"semetey-1-2013:p1209:b005:l009","ordinal":169377,"en":"Your dear dark hero Almam—"},{"id":"semetey-1-2013:p1209:b005:l010","ordinal":169378,"en":"His ancestor was Chylaba."},{"id":"semetey-1-2013:p1209:b005:l011","ordinal":169379,"en":"Wearing Chylaba's coat,"},{"id":"semetey-1-2013:p1209:b005:l012","ordinal":169380,"en":"The poor man labored on,"},{"id":"semetey-1-2013:p1209:b005:l013","ordinal":169381,"en":"Putting on the Chinese crown."},{"id":"semetey-1-2013:p1209:b005:l014","ordinal":169382,"en":"Upon that crown"},{"id":"semetey-1-2013:p1209:b005:l015","ordinal":169383,"en":"Were coral and pearl ornaments."},{"id":"semetey-1-2013:p1209:b005:l016","ordinal":169384,"en":"The great Chinese of Kakanchyn"},{"id":"semetey-1-2013:p1209:b005:l017","ordinal":169385,"en":"Did not recognize your elder Ala,"},{"id":"semetey-1-2013:p1209:b005:l018","ordinal":169386,"en":"And their poor heads were confounded."},{"id":"semetey-1-2013:p1209:b005:l019","ordinal":169387,"en":"The spectacles of gray-maned Lord Almam"},{"id":"semetey-1-2013:p1209:b005:l020","ordinal":169388,"en":"Gleamed;"},{"id":"semetey-1-2013:p1209:b005:l021","ordinal":169389,"en":"Flask-sized coral stones"},{"id":"semetey-1-2013:p1209:b005:l022","ordinal":169390,"en":"Shone upon his crown."},{"id":"semetey-1-2013:p1209:b005:l023","ordinal":169391,"en":"The Chinese who saw him cried, \"My khan,\""},{"id":"semetey-1-2013:p1209:b005:l024","ordinal":169392,"en":"And stared in amazement."},{"id":"semetey-1-2013:p1209:b005:l025","ordinal":169393,"en":"Your elder Ala rode on,"},{"id":"semetey-1-2013:p1209:b005:l026","ordinal":169394,"en":"Preparing his feigned gait."},{"id":"semetey-1-2013:p1209:b005:l027","ordinal":169395,"en":"Foal of a bay mare,"},{"id":"semetey-1-2013:p1209:b005:l028","ordinal":169396,"en":"Tulpar of the black herd—"},{"id":"semetey-1-2013:p1209:b005:l029","ordinal":169397,"en":"If the leopard's Akkula"},{"id":"semetey-1-2013:p1209:b005:l030","ordinal":169398,"en":"Meets me head-on,"},{"id":"semetey-1-2013:p1209:b005:l031","ordinal":169399,"en":"I will charge and seize its reins,"},{"id":"semetey-1-2013:p1209:b005:l032","ordinal":169400,"en":"And bring it to my horse's side."},{"id":"semetey-1-2013:p1209:b005:l033","ordinal":169401,"en":"I will raise the battle cry"},{"id":"semetey-1-2013:p1209:b005:l034","ordinal":169402,"en":"Of the Black Chinese and Manchus,"},{"id":"semetey-1-2013:p1209:b005:l035","ordinal":169403,"en":"Lead it between"},{"id":"semetey-1-2013:p1209:b005:l036","ordinal":169404,"en":"Infidel and Muslim,"},{"id":"semetey-1-2013:p1209:b005:l037","ordinal":169405,"en":"And thus win honor."},{"id":"semetey-1-2013:p1209:b005:l038","ordinal":169406,"en":"The saddle-shaped ridge"},{"id":"semetey-1-2013:p1209:b005:l039","ordinal":169407,"en":"Your dear gray-maned Almam"},{"id":"semetey-1-2013:p1210:b003:l001","ordinal":169408,"en":"Now reached and leaned against."},{"id":"semetey-1-2013:p1210:b003:l002","ordinal":169409,"en":"He turned the piebald horse's head"},{"id":"semetey-1-2013:p1210:b003:l003","ordinal":169410,"en":"And the renowned poor hero"},{"id":"semetey-1-2013:p1210:b003:l004","ordinal":169411,"en":"Raised his spyglass."},{"id":"semetey-1-2013:p1210:b003:l005","ordinal":169412,"en":"A blue haze appeared against the sky,"},{"id":"semetey-1-2013:p1210:b003:l006","ordinal":169413,"en":"Clouded and angular,"},{"id":"semetey-1-2013:p1210:b003:l007","ordinal":169414,"en":"Pointed like a cape."},{"id":"semetey-1-2013:p1210:b003:l008","ordinal":169415,"en":"Across the churned sand,"},{"id":"semetey-1-2013:p1210:b003:l009","ordinal":169416,"en":"Dust rose in bursts."},{"id":"semetey-1-2013:p1210:b003:l010","ordinal":169417,"en":"When he looked at the surging dust,"},{"id":"semetey-1-2013:p1210:b003:l011","ordinal":169418,"en":"It was Akkula's dust."},{"id":"semetey-1-2013:p1210:b003:l012","ordinal":169419,"en":"He had lowered his head to the ground;"},{"id":"semetey-1-2013:p1210:b003:l013","ordinal":169420,"en":"Your padishah's Akkula"},{"id":"semetey-1-2013:p1210:b003:l014","ordinal":169421,"en":"Had taken a remarkable stride."},{"id":"semetey-1-2013:p1210:b003:l015","ordinal":169422,"en":"He had lowered his neck to the ground;"},{"id":"semetey-1-2013:p1210:b003:l016","ordinal":169423,"en":"Your padishah's Akkula"},{"id":"semetey-1-2013:p1210:b003:l017","ordinal":169424,"en":"Ran with an impossible stride."},{"id":"semetey-1-2013:p1210:b003:l018","ordinal":169425,"en":"When he came to a descent,"},{"id":"semetey-1-2013:p1210:b003:l019","ordinal":169426,"en":"His forelegs thrust like a roe deer's;"},{"id":"semetey-1-2013:p1210:b003:l020","ordinal":169427,"en":"When he leaned into an ascent,"},{"id":"semetey-1-2013:p1210:b003:l021","ordinal":169428,"en":"Mighty racehorse Akkula's"},{"id":"semetey-1-2013:p1210:b003:l022","ordinal":169429,"en":"Mane and tail streamed out."},{"id":"semetey-1-2013:p1210:b003:l023","ordinal":169430,"en":"When he reached open steppe,"},{"id":"semetey-1-2013:p1210:b003:l024","ordinal":169431,"en":"His hooves thundered on the ground."},{"id":"semetey-1-2013:p1210:b003:l025","ordinal":169432,"en":"When he champed"},{"id":"semetey-1-2013:p1210:b003:l026","ordinal":169433,"en":"The black-steel bit,"},{"id":"semetey-1-2013:p1210:b003:l027","ordinal":169434,"en":"It clattered in his throat."},{"id":"semetey-1-2013:p1210:b003:l028","ordinal":169435,"en":"His forelock parted toward the sky,"},{"id":"semetey-1-2013:p1210:b003:l029","ordinal":169436,"en":"And his tulpar form appeared."},{"id":"semetey-1-2013:p1210:b003:l030","ordinal":169437,"en":"He flattened his ears like a kulan"},{"id":"semetey-1-2013:p1210:b003:l031","ordinal":169438,"en":"And swept the earth like a whirlwind."},{"id":"semetey-1-2013:p1210:b003:l032","ordinal":169439,"en":"When he came into view,"},{"id":"semetey-1-2013:p1210:b003:l033","ordinal":169440,"en":"Valiant noble Almam"},{"id":"semetey-1-2013:p1210:b003:l034","ordinal":169441,"en":"Watched and marked him carefully."},{"id":"semetey-1-2013:p1210:b003:l035","ordinal":169442,"en":"Stones burst beneath his tread;"},{"id":"semetey-1-2013:p1210:b003:l036","ordinal":169443,"en":"Hero Joloy's Achbuudan"},{"id":"semetey-1-2013:p1210:b003:l037","ordinal":169444,"en":"Came flying with a roar."},{"id":"semetey-1-2013:p1210:b003:l038","ordinal":169445,"en":"He was behind Akkula."},{"id":"semetey-1-2013:p1210:b003:l039","ordinal":169446,"en":"When young Aydar of the flowing forelock"},{"id":"semetey-1-2013:p1210:b004:l001","ordinal":169447,"en":"Drove away the horses,"},{"id":"semetey-1-2013:p1210:b004:l002","ordinal":169448,"en":"Kokotoy's Bokmurun"},{"id":"semetey-1-2013:p1210:b004:l003","ordinal":169449,"en":"Had used much cunning."},{"id":"semetey-1-2013:p1210:b004:l004","ordinal":169450,"en":"Heeding his words, young Aydar"},{"id":"semetey-1-2013:p1210:b004:l005","ordinal":169451,"en":"Tied Maaniker firmly"},{"id":"semetey-1-2013:p1210:b004:l006","ordinal":169452,"en":"And slept for three days."},{"id":"semetey-1-2013:p1210:b004:l007","ordinal":169453,"en":"After three days, young Aydar"},{"id":"semetey-1-2013:p1210:b004:l008","ordinal":169454,"en":"Woke in alarm from sleep,"},{"id":"semetey-1-2013:p1210:b004:l009","ordinal":169455,"en":"Turned onto his right side,"},{"id":"semetey-1-2013:p1210:b004:l010","ordinal":169456,"en":"Dipped his hands in water"},{"id":"semetey-1-2013:p1210:b004:l011","ordinal":169457,"en":"And performed ablution for his hands;"},{"id":"semetey-1-2013:p1210:b004:l012","ordinal":169458,"en":"He dipped his feet in water"},{"id":"semetey-1-2013:p1210:b004:l013","ordinal":169459,"en":"And performed ablution for his feet."},{"id":"semetey-1-2013:p1210:b004:l014","ordinal":169460,"en":"He hurriedly recited namaz,"},{"id":"semetey-1-2013:p1210:b004:l015","ordinal":169461,"en":"Saddled Maaniker,"},{"id":"semetey-1-2013:p1210:b004:l016","ordinal":169462,"en":"Opened his eyes wide as grain mash,"},{"id":"semetey-1-2013:p1210:b004:l017","ordinal":169463,"en":"And all sleep scattered away."},{"id":"semetey-1-2013:p1210:b004:l018","ordinal":169464,"en":"When he stood high and looked,"},{"id":"semetey-1-2013:p1210:b004:l019","ordinal":169465,"en":"There was no raven croaking,"},{"id":"semetey-1-2013:p1210:b004:l020","ordinal":169466,"en":"No crow cawing."},{"id":"semetey-1-2013:p1210:b004:l021","ordinal":169467,"en":"Nothing caught his eye;"},{"id":"semetey-1-2013:p1210:b004:l022","ordinal":169468,"en":"He could not tell where"},{"id":"semetey-1-2013:p1210:b004:l023","ordinal":169469,"en":"The people beside him had gone."},{"id":"semetey-1-2013:p1210:b004:l024","ordinal":169470,"en":"Then young Aydar"},{"id":"semetey-1-2013:p1210:b004:l025","ordinal":169471,"en":"Struck the whip hard"},{"id":"semetey-1-2013:p1210:b004:l026","ordinal":169472,"en":"Against a tulpar like Maaniker,"}]
