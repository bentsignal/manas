[{"id":"semetey-1-2013:p1240:b004:l011","ordinal":171777,"en":"Against hero Toltoy and Khoja,"},{"id":"semetey-1-2013:p1240:b004:l012","ordinal":171778,"en":"Girding the jekene at my waist,"},{"id":"semetey-1-2013:p1240:b004:l013","ordinal":171779,"en":"Would that I had attacked alone,"},{"id":"semetey-1-2013:p1240:b004:l014","ordinal":171780,"en":"And before reaching my maturity,"},{"id":"semetey-1-2013:p1240:b004:l015","ordinal":171781,"en":"Died without delay!"},{"id":"semetey-1-2013:p1240:b004:l016","ordinal":171782,"en":"Against accursed Toltoy,"},{"id":"semetey-1-2013:p1240:b004:l017","ordinal":171783,"en":"Would that I had waged a wondrous war"},{"id":"semetey-1-2013:p1240:b004:l018","ordinal":171784,"en":"And split his realm in two!"},{"id":"semetey-1-2013:p1240:b004:l019","ordinal":171785,"en":"I long to camp on rugged ground;"},{"id":"semetey-1-2013:p1240:b004:l020","ordinal":171786,"en":"Against accursed Toltoy,"},{"id":"semetey-1-2013:p1240:b004:l021","ordinal":171787,"en":"Against the Khoja gone astray,"},{"id":"semetey-1-2013:p1240:b004:l022","ordinal":171788,"en":"I long to wage a wondrous war"},{"id":"semetey-1-2013:p1240:b004:l023","ordinal":171789,"en":"And be drenched red with blood."},{"id":"semetey-1-2013:p1240:b004:l024","ordinal":171790,"en":"Would that I split his head and cut it off,"},{"id":"semetey-1-2013:p1240:b004:l025","ordinal":171791,"en":"And before Semetey"},{"id":"semetey-1-2013:p1240:b004:l026","ordinal":171792,"en":"Carried it deliberately as a burden."},{"id":"semetey-1-2013:p1240:b004:l027","ordinal":171793,"en":"Against mountain-like gray wolf Toltoy,"},{"id":"semetey-1-2013:p1240:b004:l028","ordinal":171794,"en":"There is no bruise upon my body,"},{"id":"semetey-1-2013:p1240:b004:l029","ordinal":171795,"en":"No wound anywhere upon me."},{"id":"semetey-1-2013:p1240:b004:l030","ordinal":171796,"en":"Trembling worse than a woman,"},{"id":"semetey-1-2013:p1240:b004:l031","ordinal":171797,"en":"Is it right that fugitive Toltoy escaped?"},{"id":"semetey-1-2013:p1240:b004:l032","ordinal":171798,"en":"Can there be a man like me,"},{"id":"semetey-1-2013:p1240:b004:l033","ordinal":171799,"en":"Who let the fleeing foe escape?!"},{"id":"semetey-1-2013:p1240:b004:l034","ordinal":171800,"en":"Is it right to call"},{"id":"semetey-1-2013:p1240:b004:l035","ordinal":171801,"en":"A wretch like me a man?"},{"id":"semetey-1-2013:p1240:b004:l036","ordinal":171802,"en":"Curse your father's grave, world;"},{"id":"semetey-1-2013:p1240:b004:l037","ordinal":171803,"en":"Accursed childishness—"},{"id":"semetey-1-2013:p1240:b004:l038","ordinal":171804,"en":"When will this cursed immaturity"},{"id":"semetey-1-2013:p1240:b004:l039","ordinal":171805,"en":"Leave my head!"},{"id":"semetey-1-2013:p1241:b003:l001","ordinal":171806,"en":"My elder's patterned spear—"},{"id":"semetey-1-2013:p1241:b003:l002","ordinal":171807,"en":"When I gripped it and turned its neck,"},{"id":"semetey-1-2013:p1241:b003:l003","ordinal":171808,"en":"Facing toward the foe,"},{"id":"semetey-1-2013:p1241:b003:l004","ordinal":171809,"en":"When I threw myself against Toltoy,"},{"id":"semetey-1-2013:p1241:b003:l005","ordinal":171810,"en":"And thrust the spear straight,"},{"id":"semetey-1-2013:p1241:b003:l006","ordinal":171811,"en":"When we fought to exhaustion,"},{"id":"semetey-1-2013:p1241:b003:l007","ordinal":171812,"en":"I had no support on whom to rely,"},{"id":"semetey-1-2013:p1241:b003:l008","ordinal":171813,"en":"No fortified place to hold."},{"id":"semetey-1-2013:p1241:b003:l009","ordinal":171814,"en":"Standing in peril by myself,"},{"id":"semetey-1-2013:p1241:b003:l010","ordinal":171815,"en":"When we faced one another."},{"id":"semetey-1-2013:p1241:b003:l011","ordinal":171816,"en":"I had no support on whom to rely,"},{"id":"semetey-1-2013:p1241:b003:l012","ordinal":171817,"en":"No fortified place to hold."},{"id":"semetey-1-2013:p1241:b003:l013","ordinal":171818,"en":"When we faced one another,"},{"id":"semetey-1-2013:p1241:b003:l014","ordinal":171819,"en":"My renowned elder lion was absent."},{"id":"semetey-1-2013:p1241:b003:l015","ordinal":171820,"en":"I had no cliff geese could not circle,"},{"id":"semetey-1-2013:p1241:b003:l016","ordinal":171821,"en":"No rugged black mountain;"},{"id":"semetey-1-2013:p1241:b003:l017","ordinal":171822,"en":"Lion Bakai, who sat as my support,"},{"id":"semetey-1-2013:p1241:b003:l018","ordinal":171823,"en":"Was not here."},{"id":"semetey-1-2013:p1241:b003:l019","ordinal":171824,"en":"Fire from one's own core is terrible;"},{"id":"semetey-1-2013:p1241:b003:l020","ordinal":171825,"en":"An enemy from one's own kin is terrible."},{"id":"semetey-1-2013:p1241:b003:l021","ordinal":171826,"en":"Chynkojo, with whom I shared secrets,"},{"id":"semetey-1-2013:p1241:b003:l022","ordinal":171827,"en":"Will he encircle me from behind,"},{"id":"semetey-1-2013:p1241:b003:l023","ordinal":171828,"en":"Turn back his great army,"},{"id":"semetey-1-2013:p1241:b003:l024","ordinal":171829,"en":"Take Buurul from beneath me,"},{"id":"semetey-1-2013:p1241:b003:l025","ordinal":171830,"en":"Leave Semetey on foot,"},{"id":"semetey-1-2013:p1241:b003:l026","ordinal":171831,"en":"And seize him as plunder!”"},{"id":"semetey-1-2013:p1241:b003:l027","ordinal":171832,"en":"Walking heavily and exhausted,"},{"id":"semetey-1-2013:p1241:b003:l028","ordinal":171833,"en":"Leaning upon the patterned spear,"},{"id":"semetey-1-2013:p1241:b003:l029","ordinal":171834,"en":"Külchoro stood there."},{"id":"semetey-1-2013:p1241:b003:l030","ordinal":171835,"en":"Let us leave his ruined state"},{"id":"semetey-1-2013:p1241:b003:l031","ordinal":171836,"en":"And now tell"},{"id":"semetey-1-2013:p1241:b003:l032","ordinal":171837,"en":"The tale of Khan Toltoy."},{"id":"semetey-1-2013:p1241:b003:l033","ordinal":171838,"en":"Dear Toltoy flailed about,"},{"id":"semetey-1-2013:p1241:b003:l034","ordinal":171839,"en":"The two fronts of his coat flapping,"},{"id":"semetey-1-2013:p1241:b003:l035","ordinal":171840,"en":"Covered in swirling dust,"},{"id":"semetey-1-2013:p1241:b003:l036","ordinal":171841,"en":"And blood by the red bucketful."},{"id":"semetey-1-2013:p1241:b003:l037","ordinal":171842,"en":"Surkoen ambled;"},{"id":"semetey-1-2013:p1241:b003:l038","ordinal":171843,"en":"The blood flowing from his rump"},{"id":"semetey-1-2013:p1241:b003:l039","ordinal":171844,"en":"Ran in streams"},{"id":"semetey-1-2013:p1241:b005:l001","ordinal":171845,"en":"Across Surkoen's fat haunches."},{"id":"semetey-1-2013:p1241:b005:l002","ordinal":171846,"en":"At times he regained consciousness;"},{"id":"semetey-1-2013:p1241:b005:l003","ordinal":171847,"en":"At times he could not."},{"id":"semetey-1-2013:p1241:b005:l004","ordinal":171848,"en":"His time had broken apart;"},{"id":"semetey-1-2013:p1241:b005:l005","ordinal":171849,"en":"Blood flowing from his wound"},{"id":"semetey-1-2013:p1241:b005:l006","ordinal":171850,"en":"Spilled upon the black earth."},{"id":"semetey-1-2013:p1241:b005:l007","ordinal":171851,"en":"Hero Toltoy appeared"},{"id":"semetey-1-2013:p1241:b005:l008","ordinal":171852,"en":"About to depart for the true world."},{"id":"semetey-1-2013:p1241:b005:l009","ordinal":171853,"en":"His eyes darted away;"},{"id":"semetey-1-2013:p1241:b005:l010","ordinal":171854,"en":"Gray wolf Toltoy then"},{"id":"semetey-1-2013:p1241:b005:l011","ordinal":171855,"en":"Let his legs hang loose."},{"id":"semetey-1-2013:p1241:b005:l012","ordinal":171856,"en":"His spirit was sorely torn;"},{"id":"semetey-1-2013:p1241:b005:l013","ordinal":171857,"en":"He bore the look of one dying."},{"id":"semetey-1-2013:p1241:b005:l014","ordinal":171858,"en":"Surkoen ambled;"},{"id":"semetey-1-2013:p1241:b005:l015","ordinal":171859,"en":"Blood flowing from his neck"},{"id":"semetey-1-2013:p1241:b005:l016","ordinal":171860,"en":"Ran down his collar."},{"id":"semetey-1-2013:p1241:b005:l017","ordinal":171861,"en":"Raging and shouting,"},{"id":"semetey-1-2013:p1241:b005:l018","ordinal":171862,"en":"Bending down the willow tops,"},{"id":"semetey-1-2013:p1241:b005:l019","ordinal":171863,"en":"When bright dawn broke,"},{"id":"semetey-1-2013:p1241:b005:l020","ordinal":171864,"en":"When light fell upon the earth,"},{"id":"semetey-1-2013:p1241:b005:l021","ordinal":171865,"en":"Toltoy went on screaming."},{"id":"semetey-1-2013:p1241:b005:l022","ordinal":171866,"en":"His face distorted then;"},{"id":"semetey-1-2013:p1241:b005:l023","ordinal":171867,"en":"Hero Toltoy retched,"},{"id":"semetey-1-2013:p1241:b005:l024","ordinal":171868,"en":"Thudding from time to time;"},{"id":"semetey-1-2013:p1241:b005:l025","ordinal":171869,"en":"Hero Toltoy vomited."},{"id":"semetey-1-2013:p1241:b005:l026","ordinal":171870,"en":"He did not recognize his own fault"},{"id":"semetey-1-2013:p1241:b005:l027","ordinal":171871,"en":"In fleeing before the boy."},{"id":"semetey-1-2013:p1241:b005:l028","ordinal":171872,"en":"Then he cursed Chynkojo,"},{"id":"semetey-1-2013:p1241:b005:l029","ordinal":171873,"en":"Making sport of"},{"id":"semetey-1-2013:p1241:b005:l030","ordinal":171874,"en":"His father and mother:"},{"id":"semetey-1-2013:p1241:b005:l031","ordinal":171875,"en":"“Accursed Chynkojo,"},{"id":"semetey-1-2013:p1241:b005:l032","ordinal":171876,"en":"Did I not tell you before?"},{"id":"semetey-1-2013:p1241:b005:l033","ordinal":171877,"en":"Did you not hear me before!"},{"id":"semetey-1-2013:p1241:b005:l034","ordinal":171878,"en":"The deeply dug pit has come;"},{"id":"semetey-1-2013:p1241:b005:l035","ordinal":171879,"en":"Manas at their head, surging,"},{"id":"semetey-1-2013:p1241:b005:l036","ordinal":171880,"en":"The engulfing black army has come."},{"id":"semetey-1-2013:p1241:b005:l037","ordinal":171881,"en":"A dark day has pressed hard upon our lives;"},{"id":"semetey-1-2013:p1241:b005:l038","ordinal":171882,"en":"Bakai at their head, a thousand men,"},{"id":"semetey-1-2013:p1241:b005:l039","ordinal":171883,"en":"Have surged out from Batkal."},{"id":"semetey-1-2013:p1242:b003:l001","ordinal":171884,"en":"His messenger has come—give an answer!"},{"id":"semetey-1-2013:p1242:b003:l002","ordinal":171885,"en":"If you are a man, Khoja, reply!"},{"id":"semetey-1-2013:p1242:b003:l003","ordinal":171886,"en":"Leveling spears and shouting,"},{"id":"semetey-1-2013:p1242:b003:l004","ordinal":171887,"en":"How many souls came out of Batkal,"},{"id":"semetey-1-2013:p1242:b003:l005","ordinal":171888,"en":"Raising the battle cry of Manas."},{"id":"semetey-1-2013:p1242:b003:l006","ordinal":171889,"en":"Riding a red-roan horse,"},{"id":"semetey-1-2013:p1242:b003:l007","ordinal":171890,"en":"Its horsehair tail tied tight,"},{"id":"semetey-1-2013:p1242:b003:l008","ordinal":171891,"en":"A ruddy young boy"},{"id":"semetey-1-2013:p1242:b003:l009","ordinal":171892,"en":"Came shouting and thrust his spear."},{"id":"semetey-1-2013:p1242:b003:l010","ordinal":171893,"en":"When he reached me and thrust,"},{"id":"semetey-1-2013:p1242:b003:l011","ordinal":171894,"en":"I pitched backward from my saddle;"},{"id":"semetey-1-2013:p1242:b003:l012","ordinal":171895,"en":"My foot slipped from the stirrup."},{"id":"semetey-1-2013:p1242:b003:l013","ordinal":171896,"en":"My eyes darted wildly;"},{"id":"semetey-1-2013:p1242:b003:l014","ordinal":171897,"en":"My legs hung loose."},{"id":"semetey-1-2013:p1242:b003:l015","ordinal":171898,"en":"The spear struck my rump;"},{"id":"semetey-1-2013:p1242:b003:l016","ordinal":171899,"en":"From the boy who speared me,"},{"id":"semetey-1-2013:p1242:b003:l017","ordinal":171900,"en":"The reins fell from his hand—"},{"id":"semetey-1-2013:p1242:b003:l018","ordinal":171901,"en":"That alone saved me."},{"id":"semetey-1-2013:p1242:b003:l019","ordinal":171902,"en":"Had his reins not fallen to the ground,"},{"id":"semetey-1-2013:p1242:b003:l020","ordinal":171903,"en":"He would have drawn the line,"},{"id":"semetey-1-2013:p1242:b003:l021","ordinal":171904,"en":"Made a spectacle,"},{"id":"semetey-1-2013:p1242:b003:l022","ordinal":171905,"en":"Spilled my blood,"},{"id":"semetey-1-2013:p1242:b003:l023","ordinal":171906,"en":"And taken my life."},{"id":"semetey-1-2013:p1242:b003:l024","ordinal":171907,"en":"Riding a black-roan horse,"},{"id":"semetey-1-2013:p1242:b003:l025","ordinal":171908,"en":"Its tail gripped and tied tight,"},{"id":"semetey-1-2013:p1242:b003:l026","ordinal":171909,"en":"A dark-complexioned young boy"},{"id":"semetey-1-2013:p1242:b003:l027","ordinal":171910,"en":"Suddenly appeared in my path"},{"id":"semetey-1-2013:p1242:b003:l028","ordinal":171911,"en":"And brought calamity upon me."},{"id":"semetey-1-2013:p1242:b003:l029","ordinal":171912,"en":"Khan Manas at their head,"},{"id":"semetey-1-2013:p1242:b003:l030","ordinal":171913,"en":"Crying, ‘Seize the slave, seize him!’"},{"id":"semetey-1-2013:p1242:b003:l031","ordinal":171914,"en":"‘Catch him and bind his hands!"},{"id":"semetey-1-2013:p1242:b003:l032","ordinal":171915,"en":"Gouge out both his eyes"},{"id":"semetey-1-2013:p1242:b003:l033","ordinal":171916,"en":"And drive him like a donkey!"},{"id":"semetey-1-2013:p1242:b003:l034","ordinal":171917,"en":"The vile man who would take a wife—"},{"id":"semetey-1-2013:p1242:b003:l035","ordinal":171918,"en":"Seize him, seize him, seize him!"},{"id":"semetey-1-2013:p1242:b003:l036","ordinal":171919,"en":"Though the swine begs, do not relent;"},{"id":"semetey-1-2013:p1242:b003:l037","ordinal":171920,"en":"Kill him wherever he is caught!’"},{"id":"semetey-1-2013:p1242:b003:l038","ordinal":171921,"en":"Bakai urged them onward."},{"id":"semetey-1-2013:p1242:b003:l039","ordinal":171922,"en":"Beyond him,"},{"id":"semetey-1-2013:p1242:b004:l001","ordinal":171923,"en":"Among the horses were blaze-faced tulpars;"},{"id":"semetey-1-2013:p1242:b004:l002","ordinal":171924,"en":"All forty companions were there,"},{"id":"semetey-1-2013:p1242:b004:l003","ordinal":171925,"en":"Almambet and Chubak among them."},{"id":"semetey-1-2013:p1242:b004:l004","ordinal":171926,"en":"The boy beneath him"},{"id":"semetey-1-2013:p1242:b004:l005","ordinal":171927,"en":"Had taken up the urging cry;"},{"id":"semetey-1-2013:p1242:b004:l006","ordinal":171928,"en":"Chubak of Akbaltai"},{"id":"semetey-1-2013:p1242:b004:l007","ordinal":171929,"en":"Raised the shout."},{"id":"semetey-1-2013:p1242:b004:l008","ordinal":171930,"en":"His brow was high, his venom strong;"},{"id":"semetey-1-2013:p1242:b004:l009","ordinal":171931,"en":"He set right whoever attacked him."},{"id":"semetey-1-2013:p1242:b004:l010","ordinal":171932,"en":"Thick-armed and stone-hearted,"},{"id":"semetey-1-2013:p1242:b004:l011","ordinal":171933,"en":"The twelve-year-old Külchoro,"},{"id":"semetey-1-2013:p1242:b004:l012","ordinal":171934,"en":"A sturdy, full-limbed stripling,"},{"id":"semetey-1-2013:p1242:b004:l013","ordinal":171935,"en":"Whose heroism was unlike another's,"},{"id":"semetey-1-2013:p1242:b004:l014","ordinal":171936,"en":"Whose strength was extraordinary."},{"id":"semetey-1-2013:p1242:b004:l015","ordinal":171937,"en":"The deep pit dug for me,"},{"id":"semetey-1-2013:p1242:b004:l016","ordinal":171938,"en":"My bitter brine thus brought to the boil—"},{"id":"semetey-1-2013:p1242:b004:l017","ordinal":171939,"en":"He showed my eyes"},{"id":"semetey-1-2013:p1242:b004:l018","ordinal":171940,"en":"A wonder no man could accomplish."},{"id":"semetey-1-2013:p1242:b004:l019","ordinal":171941,"en":"When we migrated from Talas,"},{"id":"semetey-1-2013:p1242:b004:l020","ordinal":171942,"en":"God-struck Chynkojo,"},{"id":"semetey-1-2013:p1242:b004:l021","ordinal":171943,"en":"You bore down like a heavy load then."},{"id":"semetey-1-2013:p1242:b004:l022","ordinal":171944,"en":"Your witness taken from Talas—"},{"id":"semetey-1-2013:p1242:b004:l023","ordinal":171945,"en":"Saying, ‘I shall seize his wife,’"},{"id":"semetey-1-2013:p1242:b004:l024","ordinal":171946,"en":"You nearly reached my root."},{"id":"semetey-1-2013:p1242:b004:l025","ordinal":171947,"en":"When I said I would not go, you refused;"},{"id":"semetey-1-2013:p1242:b004:l026","ordinal":171948,"en":"You left me no choice but to go."},{"id":"semetey-1-2013:p1242:b004:l027","ordinal":171949,"en":"You brought corruption upon my head"},{"id":"semetey-1-2013:p1242:b004:l028","ordinal":171950,"en":"And meant to show me a spectacle."},{"id":"semetey-1-2013:p1242:b004:l029","ordinal":171951,"en":"You caused accursed Toltoy to be slaughtered;"},{"id":"semetey-1-2013:p1242:b004:l030","ordinal":171952,"en":"Saying you would seize the bride"},{"id":"semetey-1-2013:p1242:b004:l031","ordinal":171953,"en":"Of blessed lion Manas,"},{"id":"semetey-1-2013:p1242:b004:l032","ordinal":171954,"en":"You brought anguish upon my head."},{"id":"semetey-1-2013:p1242:b004:l033","ordinal":171955,"en":"I heeded your words"},{"id":"semetey-1-2013:p1242:b004:l034","ordinal":171956,"en":"And went to behold"},{"id":"semetey-1-2013:p1242:b004:l035","ordinal":171957,"en":"Humiliation no man had seen."},{"id":"semetey-1-2013:p1242:b004:l036","ordinal":171958,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1242:b004:l037","ordinal":171959,"en":"Your deed was bold, Khoja."},{"id":"semetey-1-2013:p1242:b004:l038","ordinal":171960,"en":"My blustering hero,"},{"id":"semetey-1-2013:p1242:b004:l039","ordinal":171961,"en":"My infidel whose mother is forsworn,"},{"id":"semetey-1-2013:p1243:b003:l001","ordinal":171962,"en":"My eyes like blackcurrants—"},{"id":"semetey-1-2013:p1243:b003:l002","ordinal":171963,"en":"You are going about having them gouged out."},{"id":"semetey-1-2013:p1243:b003:l003","ordinal":171964,"en":"Sending me broadside"},{"id":"semetey-1-2013:p1243:b003:l004","ordinal":171965,"en":"Against the bloodthirsty hero's orphan son,"},{"id":"semetey-1-2013:p1243:b003:l005","ordinal":171966,"en":"You are going about having me slaughtered."},{"id":"semetey-1-2013:p1243:b003:l006","ordinal":171967,"en":"Saying I would tell you my grievance,"},{"id":"semetey-1-2013:p1243:b003:l007","ordinal":171968,"en":"I came to see you—do you see?"},{"id":"semetey-1-2013:p1243:b003:l008","ordinal":171969,"en":"Wounded and suffering,"},{"id":"semetey-1-2013:p1243:b003:l009","ordinal":171970,"en":"I came to die—do you see?"},{"id":"semetey-1-2013:p1243:b003:l010","ordinal":171971,"en":"Blessed gray wolf Manas—"},{"id":"semetey-1-2013:p1243:b003:l011","ordinal":171972,"en":"You provoked him;"},{"id":"semetey-1-2013:p1243:b003:l012","ordinal":171973,"en":"Refusing to go peacefully and reeling crookedly,"},{"id":"semetey-1-2013:p1243:b003:l013","ordinal":171974,"en":"Accursed Khoja,"},{"id":"semetey-1-2013:p1243:b003:l014","ordinal":171975,"en":"You made your enmity known."},{"id":"semetey-1-2013:p1243:b003:l015","ordinal":171976,"en":"For the great black Jediger,"},{"id":"semetey-1-2013:p1243:b003:l016","ordinal":171977,"en":"You have incurred their blood-guilt;"},{"id":"semetey-1-2013:p1243:b003:l017","ordinal":171978,"en":"All the people,"},{"id":"semetey-1-2013:p1243:b003:l018","ordinal":171979,"en":"Ill-starred Chynkojo,"},{"id":"semetey-1-2013:p1243:b003:l019","ordinal":171980,"en":"You truly caused to be slaughtered."},{"id":"semetey-1-2013:p1243:b003:l020","ordinal":171981,"en":"You first desired corruption,"},{"id":"semetey-1-2013:p1243:b003:l021","ordinal":171982,"en":"Accursed Chynkojo;"},{"id":"semetey-1-2013:p1243:b003:l022","ordinal":171983,"en":"Saying, ‘Take his wife,’"},{"id":"semetey-1-2013:p1243:b003:l023","ordinal":171984,"en":"You drove us toward death."},{"id":"semetey-1-2013:p1243:b003:l024","ordinal":171985,"en":"You have become deranged—"},{"id":"semetey-1-2013:p1243:b003:l025","ordinal":171986,"en":"Why desire corruption so greatly?"},{"id":"semetey-1-2013:p1243:b003:l026","ordinal":171987,"en":"The one who charged and attacked me"},{"id":"semetey-1-2013:p1243:b003:l027","ordinal":171988,"en":"Was Semetey himself;"},{"id":"semetey-1-2013:p1243:b003:l028","ordinal":171989,"en":"For all the peoples of the age,"},{"id":"semetey-1-2013:p1243:b003:l029","ordinal":171990,"en":"His time to bring slaughter had come."},{"id":"semetey-1-2013:p1243:b003:l030","ordinal":171991,"en":"Aychürök, daughter of Akun,"},{"id":"semetey-1-2013:p1243:b003:l031","ordinal":171992,"en":"Had worn her horse's flanks lean,"},{"id":"semetey-1-2013:p1243:b003:l032","ordinal":171993,"en":"Traveling through the whole world;"},{"id":"semetey-1-2013:p1243:b003:l033","ordinal":171994,"en":"The time had come for her"},{"id":"semetey-1-2013:p1243:b003:l034","ordinal":171995,"en":"To bring merciless turmoil."},{"id":"semetey-1-2013:p1243:b003:l035","ordinal":171996,"en":"You foolish colt, you do not know it;"},{"id":"semetey-1-2013:p1243:b003:l036","ordinal":171997,"en":"Her husband was mighty Semetey,"},{"id":"semetey-1-2013:p1243:b003:l037","ordinal":171998,"en":"And the time had come for her"},{"id":"semetey-1-2013:p1243:b003:l038","ordinal":171999,"en":"To lead him here."},{"id":"semetey-1-2013:p1243:b003:l039","ordinal":172000,"en":"You meant to strip off my coat,"},{"id":"semetey-1-2013:p1243:b005:l001","ordinal":172001,"en":"Accursed fugitive slave;"},{"id":"semetey-1-2013:p1243:b005:l002","ordinal":172002,"en":"Listen to my answer."},{"id":"semetey-1-2013:p1243:b005:l003","ordinal":172003,"en":"You meant to show my eyes"},{"id":"semetey-1-2013:p1243:b005:l004","ordinal":172004,"en":"A wonder fit for men to see."},{"id":"semetey-1-2013:p1243:b005:l005","ordinal":172005,"en":"The son of Manas proved a lion;"},{"id":"semetey-1-2013:p1243:b005:l006","ordinal":172006,"en":"Semetey of terrible intent"},{"id":"semetey-1-2013:p1243:b005:l007","ordinal":172007,"en":"Had come to us this year—"},{"id":"semetey-1-2013:p1243:b005:l008","ordinal":172008,"en":"His time to bring slaughter had come."},{"id":"semetey-1-2013:p1243:b005:l009","ordinal":172009,"en":"While among your own people,"},{"id":"semetey-1-2013:p1243:b005:l010","ordinal":172010,"en":"You were hero Khoja;"},{"id":"semetey-1-2013:p1243:b005:l011","ordinal":172011,"en":"Stirring conflict over everything and nothing,"},{"id":"semetey-1-2013:p1243:b005:l012","ordinal":172012,"en":"You were infidel Khoja."},{"id":"semetey-1-2013:p1243:b005:l013","ordinal":172013,"en":"At Jeti-Özön, the Jediger—"},{"id":"semetey-1-2013:p1243:b005:l014","ordinal":172014,"en":"You reached and gathered them;"},{"id":"semetey-1-2013:p1243:b005:l015","ordinal":172015,"en":"Inciting this people,"},{"id":"semetey-1-2013:p1243:b005:l016","ordinal":172016,"en":"You caused them to be slaughtered."},{"id":"semetey-1-2013:p1243:b005:l017","ordinal":172017,"en":"At Kökötöy's memorial feast,"},{"id":"semetey-1-2013:p1243:b005:l018","ordinal":172018,"en":"You will not let me tell what I saw."},{"id":"semetey-1-2013:p1243:b005:l019","ordinal":172019,"en":"You bore black thoughts toward your kin;"},{"id":"semetey-1-2013:p1243:b005:l020","ordinal":172020,"en":"Indeed, Khoja, you will never prosper!"},{"id":"semetey-1-2013:p1243:b005:l021","ordinal":172021,"en":"Your senses have left you, hero Khoja;"},{"id":"semetey-1-2013:p1243:b005:l022","ordinal":172022,"en":"You understand nothing."},{"id":"semetey-1-2013:p1243:b005:l023","ordinal":172023,"en":"Father and mother—"},{"id":"semetey-1-2013:p1243:b005:l024","ordinal":172024,"en":"You curse them and make them a mockery!”"},{"id":"semetey-1-2013:p1243:b005:l025","ordinal":172025,"en":"As Toltoy stood speaking thus,"},{"id":"semetey-1-2013:p1243:b005:l026","ordinal":172026,"en":"Dear Khoja grew heated."},{"id":"semetey-1-2013:p1243:b005:l027","ordinal":172027,"en":"Now Chynkojo came forth,"},{"id":"semetey-1-2013:p1243:b005:l028","ordinal":172028,"en":"Speaking to hero Toltoy:"},{"id":"semetey-1-2013:p1243:b005:l029","ordinal":172029,"en":"“In pursuing a bride,"},{"id":"semetey-1-2013:p1243:b005:l030","ordinal":172030,"en":"You proved hero Toltoy;"},{"id":"semetey-1-2013:p1243:b005:l031","ordinal":172031,"en":"In cursing father and mother,"},{"id":"semetey-1-2013:p1243:b005:l032","ordinal":172032,"en":"You proved infidel Toltoy."}]
