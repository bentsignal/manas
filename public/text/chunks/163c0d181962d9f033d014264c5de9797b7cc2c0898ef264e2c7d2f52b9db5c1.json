[{"id":"semetey-1-2013:p1139:b003:l035","ordinal":164097,"en":"And gathered skilled women and girls"},{"id":"semetey-1-2013:p1139:b003:l036","ordinal":164098,"en":"To bite and soften it."},{"id":"semetey-1-2013:p1139:b003:l037","ordinal":164099,"en":"She had its unfit parts cut away;"},{"id":"semetey-1-2013:p1139:b003:l038","ordinal":164100,"en":"So that bullets would glance aside,"},{"id":"semetey-1-2013:p1139:b003:l039","ordinal":164101,"en":"She had plate upon plate of steel"},{"id":"semetey-1-2013:p1139:b005:l001","ordinal":164102,"en":"Poured into its middle."},{"id":"semetey-1-2013:p1139:b005:l002","ordinal":164103,"en":"The kandagay was fashioned"},{"id":"semetey-1-2013:p1139:b005:l003","ordinal":164104,"en":"To fit the forty companions exactly."},{"id":"semetey-1-2013:p1139:b005:l004","ordinal":164105,"en":"It satisfied the heart when seen;"},{"id":"semetey-1-2013:p1139:b005:l005","ordinal":164106,"en":"Whole beaver skins"},{"id":"semetey-1-2013:p1139:b005:l006","ordinal":164107,"en":"She split open,"},{"id":"semetey-1-2013:p1139:b005:l007","ordinal":164108,"en":"And had a full span"},{"id":"semetey-1-2013:p1139:b005:l008","ordinal":164109,"en":"Set at the ends of the sleeves."},{"id":"semetey-1-2013:p1139:b005:l009","ordinal":164110,"en":"At the sleeve ends,"},{"id":"semetey-1-2013:p1139:b005:l010","ordinal":164111,"en":"The fearsome beaver trim"},{"id":"semetey-1-2013:p1139:b005:l011","ordinal":164112,"en":"At the bend of the knee,"},{"id":"semetey-1-2013:p1139:b005:l012","ordinal":164113,"en":"So it would never slip,"},{"id":"semetey-1-2013:p1139:b005:l013","ordinal":164114,"en":"Was embroidered with pure gold."},{"id":"semetey-1-2013:p1139:b005:l014","ordinal":164115,"en":"Let whoever jousts stagger;"},{"id":"semetey-1-2013:p1139:b005:l015","ordinal":164116,"en":"Infidel and Muslim alike"},{"id":"semetey-1-2013:p1139:b005:l016","ordinal":164117,"en":"Would know it was Kökötöy's feast,"},{"id":"semetey-1-2013:p1139:b005:l017","ordinal":164118,"en":"And whoever saw it would marvel."},{"id":"semetey-1-2013:p1139:b005:l018","ordinal":164119,"en":"It was named kandagay;"},{"id":"semetey-1-2013:p1139:b005:l019","ordinal":164120,"en":"Come, boys, put it on openly"},{"id":"semetey-1-2013:p1139:b005:l020","ordinal":164121,"en":"And know the gray-wolf courage"},{"id":"semetey-1-2013:p1139:b005:l021","ordinal":164122,"en":"Of your unfortunate sister-in-law."},{"id":"semetey-1-2013:p1139:b005:l022","ordinal":164123,"en":"The matter is hard as I tell it;"},{"id":"semetey-1-2013:p1139:b005:l023","ordinal":164124,"en":"I shall give another article."},{"id":"semetey-1-2013:p1139:b005:l024","ordinal":164125,"en":"Come, boys, put it on."},{"id":"semetey-1-2013:p1139:b005:l025","ordinal":164126,"en":"If you ask its origin,"},{"id":"semetey-1-2013:p1139:b005:l026","ordinal":164127,"en":"It is costly leather."},{"id":"semetey-1-2013:p1139:b005:l027","ordinal":164128,"en":"I thought my forty falcons"},{"id":"semetey-1-2013:p1139:b005:l028","ordinal":164129,"en":"Would recognize this labor;"},{"id":"semetey-1-2013:p1139:b005:l029","ordinal":164130,"en":"I knew of this matter long ago."},{"id":"semetey-1-2013:p1139:b005:l030","ordinal":164131,"en":"At Kökötöy's feast,"},{"id":"semetey-1-2013:p1139:b005:l031","ordinal":164132,"en":"Before the great gathering,"},{"id":"semetey-1-2013:p1139:b005:l032","ordinal":164133,"en":"I thought you would wear"},{"id":"semetey-1-2013:p1139:b005:l033","ordinal":164134,"en":"The ceremonial boots."},{"id":"semetey-1-2013:p1139:b005:l034","ordinal":164135,"en":"Passing them from master to master,"},{"id":"semetey-1-2013:p1139:b005:l035","ordinal":164136,"en":"Having experts assess them,"},{"id":"semetey-1-2013:p1139:b005:l036","ordinal":164137,"en":"For the price of one boot"},{"id":"semetey-1-2013:p1139:b005:l037","ordinal":164138,"en":"I had given one horse."},{"id":"semetey-1-2013:p1139:b005:l038","ordinal":164139,"en":"For all forty I gave forty horses;"},{"id":"semetey-1-2013:p1139:b005:l039","ordinal":164140,"en":"Every bootmaker gathered,"},{"id":"semetey-1-2013:p1140:b003:l001","ordinal":164141,"en":"And built each upper separately."},{"id":"semetey-1-2013:p1140:b003:l002","ordinal":164142,"en":"They satisfied whoever saw them;"},{"id":"semetey-1-2013:p1140:b003:l003","ordinal":164143,"en":"They fitted yellow brass"},{"id":"semetey-1-2013:p1140:b003:l004","ordinal":164144,"en":"As heels upon their soles."},{"id":"semetey-1-2013:p1140:b003:l005","ordinal":164145,"en":"When you go among the multitude, wear them;"},{"id":"semetey-1-2013:p1140:b003:l006","ordinal":164146,"en":"Know that your mother is noble,"},{"id":"semetey-1-2013:p1140:b003:l007","ordinal":164147,"en":"And recognize this labor of mine."},{"id":"semetey-1-2013:p1140:b003:l008","ordinal":164148,"en":"Your accomplished sister-in-law Kanykey,"},{"id":"semetey-1-2013:p1140:b003:l009","ordinal":164149,"en":"Displaying her mastery,"},{"id":"semetey-1-2013:p1140:b003:l010","ordinal":164150,"en":"Dressed the executioner-like companions"},{"id":"semetey-1-2013:p1140:b003:l011","ordinal":164151,"en":"In coats for the swift."},{"id":"semetey-1-2013:p1140:b003:l012","ordinal":164152,"en":"The forty companions' forty racehorses—"},{"id":"semetey-1-2013:p1140:b003:l013","ordinal":164153,"en":"Your precious sister-in-law Kanykey"},{"id":"semetey-1-2013:p1140:b003:l014","ordinal":164154,"en":"Had tethered them in a row"},{"id":"semetey-1-2013:p1140:b003:l015","ordinal":164155,"en":"In your magnanimous lord's stable,"},{"id":"semetey-1-2013:p1140:b003:l016","ordinal":164156,"en":"With Akkula at their head."},{"id":"semetey-1-2013:p1140:b003:l017","ordinal":164157,"en":"She fed them selected rice grain"},{"id":"semetey-1-2013:p1140:b003:l018","ordinal":164158,"en":"And drew their sweat each day;"},{"id":"semetey-1-2013:p1140:b003:l019","ordinal":164159,"en":"She fed them rich barley grain"},{"id":"semetey-1-2013:p1140:b003:l020","ordinal":164160,"en":"And drew their sweat each month."},{"id":"semetey-1-2013:p1140:b003:l021","ordinal":164161,"en":"The learned woman Kanykey,"},{"id":"semetey-1-2013:p1140:b003:l022","ordinal":164162,"en":"Knowing Kökötöy's feast would come"},{"id":"semetey-1-2013:p1140:b003:l023","ordinal":164163,"en":"And the people would fill it seething,"},{"id":"semetey-1-2013:p1140:b003:l024","ordinal":164164,"en":"Knowing lance shafts would bend"},{"id":"semetey-1-2013:p1140:b003:l025","ordinal":164165,"en":"When heroic men jousted,"},{"id":"semetey-1-2013:p1140:b003:l026","ordinal":164166,"en":"Feared the horses would grow too fat,"},{"id":"semetey-1-2013:p1140:b003:l027","ordinal":164167,"en":"Would become \"fat-swallowed,\""},{"id":"semetey-1-2013:p1140:b003:l028","ordinal":164168,"en":"And calamity strike the racehorses,"},{"id":"semetey-1-2013:p1140:b003:l029","ordinal":164169,"en":"Bringing mange upon them as well;"},{"id":"semetey-1-2013:p1140:b003:l030","ordinal":164170,"en":"They would lose mane and tail,"},{"id":"semetey-1-2013:p1140:b003:l031","ordinal":164171,"en":"Bringing disgrace,"},{"id":"semetey-1-2013:p1140:b003:l032","ordinal":164172,"en":"And all together"},{"id":"semetey-1-2013:p1140:b003:l033","ordinal":164173,"en":"Would mount crippled horses."},{"id":"semetey-1-2013:p1140:b003:l034","ordinal":164174,"en":"She feared incurable disgrace"},{"id":"semetey-1-2013:p1140:b003:l035","ordinal":164175,"en":"Would come from that."},{"id":"semetey-1-2013:p1140:b003:l036","ordinal":164176,"en":"The forty companions' forty racehorses,"},{"id":"semetey-1-2013:p1140:b003:l037","ordinal":164177,"en":"With Akkula at their head,"},{"id":"semetey-1-2013:p1140:b003:l038","ordinal":164178,"en":"She had brought from Khan-Zhaylak,"},{"id":"semetey-1-2013:p1140:b003:l039","ordinal":164179,"en":"Had their reins fitted firmly,"},{"id":"semetey-1-2013:p1140:b004:l001","ordinal":164180,"en":"Had felt coverings spread over them,"},{"id":"semetey-1-2013:p1140:b004:l002","ordinal":164181,"en":"And had the horses raised unseen."},{"id":"semetey-1-2013:p1140:b004:l003","ordinal":164182,"en":"Such are the deeds I have done."},{"id":"semetey-1-2013:p1140:b004:l004","ordinal":164183,"en":"Hear of my labor;"},{"id":"semetey-1-2013:p1140:b004:l005","ordinal":164184,"en":"Know my precious worth."},{"id":"semetey-1-2013:p1140:b004:l006","ordinal":164185,"en":"Each of you mount, dear boys,"},{"id":"semetey-1-2013:p1140:b004:l007","ordinal":164186,"en":"His own horse."},{"id":"semetey-1-2013:p1140:b004:l008","ordinal":164187,"en":"When khans swarm together"},{"id":"semetey-1-2013:p1140:b004:l009","ordinal":164188,"en":"Like black worms,"},{"id":"semetey-1-2013:p1140:b004:l010","ordinal":164189,"en":"What will the feast be like?"},{"id":"semetey-1-2013:p1140:b004:l011","ordinal":164190,"en":"What will become of the leaders"},{"id":"semetey-1-2013:p1140:b004:l012","ordinal":164191,"en":"Of the black Chinese and Manchus?"},{"id":"semetey-1-2013:p1140:b004:l013","ordinal":164192,"en":"A guest who brings calamity bears obligations—"},{"id":"semetey-1-2013:p1140:b004:l014","ordinal":164193,"en":"What will the feast be like?"},{"id":"semetey-1-2013:p1140:b004:l015","ordinal":164194,"en":"From within broad Talas,"},{"id":"semetey-1-2013:p1140:b004:l016","ordinal":164195,"en":"For riding if conflict began,"},{"id":"semetey-1-2013:p1140:b004:l017","ordinal":164196,"en":"He took six swift horses"},{"id":"semetey-1-2013:p1140:b004:l018","ordinal":164197,"en":"And had ammunition loaded on elephants."},{"id":"semetey-1-2013:p1140:b004:l019","ordinal":164198,"en":"He received the pledge of young Aydar"},{"id":"semetey-1-2013:p1140:b004:l020","ordinal":164199,"en":"That the handful of Muslims"},{"id":"semetey-1-2013:p1140:b004:l021","ordinal":164200,"en":"Had been utterly plundered."},{"id":"semetey-1-2013:p1140:b004:l022","ordinal":164201,"en":"He heard words from the messenger:"},{"id":"semetey-1-2013:p1140:b004:l023","ordinal":164202,"en":"At Khan Kökötöy's feast,"},{"id":"semetey-1-2013:p1140:b004:l024","ordinal":164203,"en":"The black Chinese and Manchus"},{"id":"semetey-1-2013:p1140:b004:l025","ordinal":164204,"en":"Had utterly slaughtered"},{"id":"semetey-1-2013:p1140:b004:l026","ordinal":164205,"en":"The handful of Muslims."},{"id":"semetey-1-2013:p1140:b004:l027","ordinal":164206,"en":"He heard that the handful of Muslims"},{"id":"semetey-1-2013:p1140:b004:l028","ordinal":164207,"en":"Had been plundered;"},{"id":"semetey-1-2013:p1140:b004:l029","ordinal":164208,"en":"He heard that, beginning with Khan Koshoy,"},{"id":"semetey-1-2013:p1140:b004:l030","ordinal":164209,"en":"They had been beaten."},{"id":"semetey-1-2013:p1140:b004:l031","ordinal":164210,"en":"He heard that the Chinese had inflicted"},{"id":"semetey-1-2013:p1140:b004:l032","ordinal":164211,"en":"Humiliation upon noble Koshoy;"},{"id":"semetey-1-2013:p1140:b004:l033","ordinal":164212,"en":"That hero Töshtük, son of Eleman,"},{"id":"semetey-1-2013:p1140:b004:l034","ordinal":164213,"en":"Had lost his wits;"},{"id":"semetey-1-2013:p1140:b004:l035","ordinal":164214,"en":"That Bokmurun, giver of the feast,"},{"id":"semetey-1-2013:p1140:b004:l036","ordinal":164215,"en":"Had fled from among the people;"},{"id":"semetey-1-2013:p1140:b004:l037","ordinal":164216,"en":"That the black Chinese had seized"},{"id":"semetey-1-2013:p1140:b004:l038","ordinal":164217,"en":"All the vast riches;"},{"id":"semetey-1-2013:p1140:b004:l039","ordinal":164218,"en":"That they had begun the spectacle;"},{"id":"semetey-1-2013:p1141:b003:l001","ordinal":164219,"en":"Kökötöy's vast riches"},{"id":"semetey-1-2013:p1141:b003:l002","ordinal":164220,"en":"Were plundered and taken by the Chinese;"},{"id":"semetey-1-2013:p1141:b003:l003","ordinal":164221,"en":"That the many Manchus tirelessly"},{"id":"semetey-1-2013:p1141:b003:l004","ordinal":164222,"en":"Had begun the spectacle."},{"id":"semetey-1-2013:p1141:b003:l005","ordinal":164223,"en":"Before Chinese as numerous as cow hairs,"},{"id":"semetey-1-2013:p1141:b003:l006","ordinal":164224,"en":"We bristled up against them."},{"id":"semetey-1-2013:p1141:b003:l007","ordinal":164225,"en":"Then tiger Manas,"},{"id":"semetey-1-2013:p1141:b003:l008","ordinal":164226,"en":"Burning in anger,"},{"id":"semetey-1-2013:p1141:b003:l009","ordinal":164227,"en":"Donned Akolpok,"},{"id":"semetey-1-2013:p1141:b003:l010","ordinal":164228,"en":"Girded on his gray cartridge belt,"},{"id":"semetey-1-2013:p1141:b003:l011","ordinal":164229,"en":"And prayed to the one God."},{"id":"semetey-1-2013:p1141:b003:l012","ordinal":164230,"en":"Saying the people had been ruined,"},{"id":"semetey-1-2013:p1141:b003:l013","ordinal":164231,"en":"Bloodthirsty Manas prepared;"},{"id":"semetey-1-2013:p1141:b003:l014","ordinal":164232,"en":"Alarmed for the Muslims,"},{"id":"semetey-1-2013:p1141:b003:l015","ordinal":164233,"en":"Hero Manas then"},{"id":"semetey-1-2013:p1141:b003:l016","ordinal":164234,"en":"Saddled Akkula."},{"id":"semetey-1-2013:p1141:b003:l017","ordinal":164235,"en":"If you ask of Akkula's nature,"},{"id":"semetey-1-2013:p1141:b003:l018","ordinal":164236,"en":"It was a true racehorse:"},{"id":"semetey-1-2013:p1141:b003:l019","ordinal":164237,"en":"Its splayed hooves were like ravines,"},{"id":"semetey-1-2013:p1141:b003:l020","ordinal":164238,"en":"Its forehead bore a white blaze,"},{"id":"semetey-1-2013:p1141:b003:l021","ordinal":164239,"en":"Forged like steel."},{"id":"semetey-1-2013:p1141:b003:l022","ordinal":164240,"en":"When its hoof struck the earth,"},{"id":"semetey-1-2013:p1141:b003:l023","ordinal":164241,"en":"It was like an overturned basin."},{"id":"semetey-1-2013:p1141:b003:l024","ordinal":164242,"en":"The breadth of its croup"},{"id":"semetey-1-2013:p1141:b003:l025","ordinal":164243,"en":"Was like a field where colts raced."},{"id":"semetey-1-2013:p1141:b003:l026","ordinal":164244,"en":"Your hero's Akkula"},{"id":"semetey-1-2013:p1141:b003:l027","ordinal":164245,"en":"Was the tiger's very self,"},{"id":"semetey-1-2013:p1141:b003:l028","ordinal":164246,"en":"Perfectly formed and swift,"},{"id":"semetey-1-2013:p1141:b003:l029","ordinal":164247,"en":"The foal of a yearling mare,"},{"id":"semetey-1-2013:p1141:b003:l030","ordinal":164248,"en":"A tulpar among black horses."},{"id":"semetey-1-2013:p1141:b003:l031","ordinal":164249,"en":"It did not falter when ridden into battle,"},{"id":"semetey-1-2013:p1141:b003:l032","ordinal":164250,"en":"Nor grow sick when ridden with the baggage train."},{"id":"semetey-1-2013:p1141:b003:l033","ordinal":164251,"en":"They dressed it in all its gear"},{"id":"semetey-1-2013:p1141:b003:l034","ordinal":164252,"en":"And mounted the enraged bloodthirsty hero"},{"id":"semetey-1-2013:p1141:b003:l035","ordinal":164253,"en":"Upon Akkula."},{"id":"semetey-1-2013:p1141:b003:l036","ordinal":164254,"en":"The spirit of whoever saw him failed;"},{"id":"semetey-1-2013:p1141:b003:l037","ordinal":164255,"en":"The gray-wolf lord, the tiger,"},{"id":"semetey-1-2013:p1141:b003:l038","ordinal":164256,"en":"Appeared like Mount Opol."},{"id":"semetey-1-2013:p1141:b003:l039","ordinal":164257,"en":"Dressed in a yellow buulum robe,"},{"id":"semetey-1-2013:p1141:b004:l001","ordinal":164258,"en":"Kanykey of Khan Manas"},{"id":"semetey-1-2013:p1141:b004:l002","ordinal":164259,"en":"Had a black-blazed argamak"},{"id":"semetey-1-2013:p1141:b004:l003","ordinal":164260,"en":"And mounted the argamak."},{"id":"semetey-1-2013:p1141:b004:l004","ordinal":164261,"en":"To see Kökötöy's vast riches,"},{"id":"semetey-1-2013:p1141:b004:l005","ordinal":164262,"en":"To see the great wealth,"},{"id":"semetey-1-2013:p1141:b004:l006","ordinal":164263,"en":"The beautiful lioness Kanykey"},{"id":"semetey-1-2013:p1141:b004:l007","ordinal":164264,"en":"Went along"},{"id":"semetey-1-2013:p1141:b004:l008","ordinal":164265,"en":"To direct the feast."},{"id":"semetey-1-2013:p1141:b004:l009","ordinal":164266,"en":"Azhybay and Bakay were twin khans;"},{"id":"semetey-1-2013:p1141:b004:l010","ordinal":164267,"en":"Almambet and Chubak were twin heroes;"},{"id":"semetey-1-2013:p1141:b004:l011","ordinal":164268,"en":"Serek and Syrgak were equal heroes."},{"id":"semetey-1-2013:p1141:b004:l012","ordinal":164269,"en":"All the forty companions were there,"},{"id":"semetey-1-2013:p1141:b004:l013","ordinal":164270,"en":"The most skillful spear-thrusters,"},{"id":"semetey-1-2013:p1141:b004:l014","ordinal":164271,"en":"The finest battle-axe wielders."},{"id":"semetey-1-2013:p1141:b004:l015","ordinal":164272,"en":"If attacked, they brought ruin upon a people;"},{"id":"semetey-1-2013:p1141:b004:l016","ordinal":164273,"en":"Where they swarmed was red fire."},{"id":"semetey-1-2013:p1141:b004:l017","ordinal":164274,"en":"Manas surged forward"},{"id":"semetey-1-2013:p1141:b004:l018","ordinal":164275,"en":"And set out for the feast."},{"id":"semetey-1-2013:p1141:b004:l019","ordinal":164276,"en":"Before a gray wolf great as a mountain,"},{"id":"semetey-1-2013:p1141:b004:l020","ordinal":164277,"en":"Could a mountain stand firm?"},{"id":"semetey-1-2013:p1141:b004:l021","ordinal":164278,"en":"Could any mortal meet and defeat him!"},{"id":"semetey-1-2013:p1141:b004:l022","ordinal":164279,"en":"Khan Manas's nature was of another kind:"},{"id":"semetey-1-2013:p1141:b004:l023","ordinal":164280,"en":"His brow was high, his venom strong;"},{"id":"semetey-1-2013:p1141:b004:l024","ordinal":164281,"en":"He leveled whoever attacked."},{"id":"semetey-1-2013:p1141:b004:l025","ordinal":164282,"en":"Have you heard the tale?"},{"id":"semetey-1-2013:p1141:b004:l026","ordinal":164283,"en":"Born in Altay, he grew mighty;"},{"id":"semetey-1-2013:p1141:b004:l027","ordinal":164284,"en":"Whoever exchanged fire with him"},{"id":"semetey-1-2013:p1141:b004:l028","ordinal":164285,"en":"Was humiliated."},{"id":"semetey-1-2013:p1141:b004:l029","ordinal":164286,"en":"He never stood idle without fighting;"},{"id":"semetey-1-2013:p1141:b004:l030","ordinal":164287,"en":"When he heard the news,"},{"id":"semetey-1-2013:p1141:b004:l031","ordinal":164288,"en":"The Kakan's khan wept."},{"id":"semetey-1-2013:p1141:b004:l032","ordinal":164289,"en":"The sorcerer who came from Beijing"},{"id":"semetey-1-2013:p1141:b004:l033","ordinal":164290,"en":"Judged the hero from his lineage."},{"id":"semetey-1-2013:p1141:b004:l034","ordinal":164291,"en":"When he reached twelve,"},{"id":"semetey-1-2013:p1141:b004:l035","ordinal":164292,"en":"He broke a citadel and took booty,"},{"id":"semetey-1-2013:p1141:b004:l036","ordinal":164293,"en":"And brought conflict to fortified peoples."},{"id":"semetey-1-2013:p1141:b004:l037","ordinal":164294,"en":"He never watched without drinking blood;"},{"id":"semetey-1-2013:p1141:b004:l038","ordinal":164295,"en":"Calling him the bloodthirsty Burut,"},{"id":"semetey-1-2013:p1141:b004:l039","ordinal":164296,"en":"The Kalmyk khan wept."},{"id":"semetey-1-2013:p1142:b003:l001","ordinal":164297,"en":"When he migrated from Altay,"},{"id":"semetey-1-2013:p1142:b003:l002","ordinal":164298,"en":"The Kalmyks who fought him were laid low."},{"id":"semetey-1-2013:p1142:b003:l003","ordinal":164299,"en":"The tiger gathered forty companions"},{"id":"semetey-1-2013:p1142:b003:l004","ordinal":164300,"en":"And became a wolf-khan in Talas."},{"id":"semetey-1-2013:p1142:b003:l005","ordinal":164301,"en":"The mortal who struggled with him"},{"id":"semetey-1-2013:p1142:b003:l006","ordinal":164302,"en":"Became bread."},{"id":"semetey-1-2013:p1142:b003:l007","ordinal":164303,"en":"Yesterday, tiger Manas"},{"id":"semetey-1-2013:p1142:b003:l008","ordinal":164304,"en":"Destroyed the Kyzylbash people;"},{"id":"semetey-1-2013:p1142:b003:l009","ordinal":164305,"en":"Falcon Manas, the tiger,"},{"id":"semetey-1-2013:p1142:b003:l010","ordinal":164306,"en":"Made every place he glanced toward weep."},{"id":"semetey-1-2013:p1142:b003:l011","ordinal":164307,"en":"No person dared look"},{"id":"semetey-1-2013:p1142:b003:l012","ordinal":164308,"en":"And advance against Manas."},{"id":"semetey-1-2013:p1142:b003:l013","ordinal":164309,"en":"His fortune was complete;"},{"id":"semetey-1-2013:p1142:b003:l014","ordinal":164310,"en":"Looking into his heart,"},{"id":"semetey-1-2013:p1142:b003:l015","ordinal":164311,"en":"It was broader than the face of the earth."},{"id":"semetey-1-2013:p1142:b003:l016","ordinal":164312,"en":"Your magnanimous lion-like lord,"},{"id":"semetey-1-2013:p1142:b003:l017","ordinal":164313,"en":"The youngest of six lions,"},{"id":"semetey-1-2013:p1142:b003:l018","ordinal":164314,"en":"Your gray wolf, the mortal loved by God,"},{"id":"semetey-1-2013:p1142:b003:l019","ordinal":164315,"en":"Was the hero Zayypburush;"},{"id":"semetey-1-2013:p1142:b003:l020","ordinal":164316,"en":"His breadth was a boundless lake."},{"id":"semetey-1-2013:p1142:b003:l021","ordinal":164317,"en":"At that time Manas"},{"id":"semetey-1-2013:p1142:b003:l022","ordinal":164318,"en":"Had a hat large as a cauldron;"},{"id":"semetey-1-2013:p1142:b003:l023","ordinal":164319,"en":"Over infidel and Muslim alike,"},{"id":"semetey-1-2013:p1142:b003:l024","ordinal":164320,"en":"He had freedom to do as he wished."},{"id":"semetey-1-2013:p1142:b003:l025","ordinal":164321,"en":"Combing his black mustache,"},{"id":"semetey-1-2013:p1142:b003:l026","ordinal":164322,"en":"Looking to both sides,"},{"id":"semetey-1-2013:p1142:b003:l027","ordinal":164323,"en":"The war banner floated in his hand,"},{"id":"semetey-1-2013:p1142:b003:l028","ordinal":164324,"en":"And Akkelte flashed on his back."},{"id":"semetey-1-2013:p1142:b003:l029","ordinal":164325,"en":"A gray cartridge belt large as a foot-sack"},{"id":"semetey-1-2013:p1142:b003:l030","ordinal":164326,"en":"Rang against his right hip;"},{"id":"semetey-1-2013:p1142:b003:l031","ordinal":164327,"en":"Zulpukor too appeared,"},{"id":"semetey-1-2013:p1142:b003:l032","ordinal":164328,"en":"And the enemy's spirit failed."},{"id":"semetey-1-2013:p1142:b003:l033","ordinal":164329,"en":"At the hero's right side,"},{"id":"semetey-1-2013:p1142:b003:l034","ordinal":164330,"en":"With mighty Bakay at their head,"},{"id":"semetey-1-2013:p1142:b003:l035","ordinal":164331,"en":"Ready to swarm upon the enemy,"},{"id":"semetey-1-2013:p1142:b003:l036","ordinal":164332,"en":"They appeared without flinching,"},{"id":"semetey-1-2013:p1142:b003:l037","ordinal":164333,"en":"Ready to arrive before an arrow—"},{"id":"semetey-1-2013:p1142:b003:l038","ordinal":164334,"en":"Twenty fierce close companions."},{"id":"semetey-1-2013:p1142:b003:l039","ordinal":164335,"en":"Looking to his left,"},{"id":"semetey-1-2013:p1142:b004:l001","ordinal":164336,"en":"Wearing a robe of yellow gold,"},{"id":"semetey-1-2013:p1142:b004:l002","ordinal":164337,"en":"Mounted on the racehorse Sarala,"},{"id":"semetey-1-2013:p1142:b004:l003","ordinal":164338,"en":"With tiger Almang at their head,"},{"id":"semetey-1-2013:p1142:b004:l004","ordinal":164339,"en":"Were the twenty on his left."},{"id":"semetey-1-2013:p1142:b004:l005","ordinal":164340,"en":"Mounted on blue-mottled horses,"},{"id":"semetey-1-2013:p1142:b004:l006","ordinal":164341,"en":"Wearing blue rapis coats—"},{"id":"semetey-1-2013:p1142:b004:l007","ordinal":164342,"en":"Chubak, son of Akbaltay;"},{"id":"semetey-1-2013:p1142:b004:l008","ordinal":164343,"en":"Syrgak, son of Ulakkan,"},{"id":"semetey-1-2013:p1142:b004:l009","ordinal":164344,"en":"Who subdued the moon and world;"},{"id":"semetey-1-2013:p1142:b004:l010","ordinal":164345,"en":"Yrchyuul, son of Yraman;"},{"id":"semetey-1-2013:p1142:b004:l011","ordinal":164346,"en":"Hero Shuutu, whose cap was broad as a felt panel;"},{"id":"semetey-1-2013:p1142:b004:l012","ordinal":164347,"en":"Kyrgylchal, head of the forty;"},{"id":"semetey-1-2013:p1142:b004:l013","ordinal":164348,"en":"The formidable hero Tazbaymat;"},{"id":"semetey-1-2013:p1142:b004:l014","ordinal":164349,"en":"Men more skillful than intriguers,"},{"id":"semetey-1-2013:p1142:b004:l015","ordinal":164350,"en":"Mighty men who could shatter the world."},{"id":"semetey-1-2013:p1142:b004:l016","ordinal":164351,"en":"Holding a banner with a golden finial,"},{"id":"semetey-1-2013:p1142:b004:l017","ordinal":164352,"en":"Your uncle Bakay rode in front,"}]
