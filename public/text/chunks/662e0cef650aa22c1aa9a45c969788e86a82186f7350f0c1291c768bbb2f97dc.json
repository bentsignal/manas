[{"id":"semetey-1-2013:p0566:b004:l007","ordinal":120321,"en":"My leopard Almam, that dear lion,"},{"id":"semetey-1-2013:p0566:b004:l008","ordinal":120322,"en":"Struggled to save his life,"},{"id":"semetey-1-2013:p0566:b004:l009","ordinal":120323,"en":"Not letting the lasso-men catch him,"},{"id":"semetey-1-2013:p0566:b004:l010","ordinal":120324,"en":"By mail-clad men with iron ropes"},{"id":"semetey-1-2013:p0566:b004:l011","ordinal":120325,"en":"Not letting himself be ringed."},{"id":"semetey-1-2013:p0566:b004:l012","ordinal":120326,"en":"While your Alake stood thus,"},{"id":"semetey-1-2013:p0566:b004:l013","ordinal":120327,"en":"Syrgak the leopard, the renowned hero,"},{"id":"semetey-1-2013:p0566:b004:l014","ordinal":120328,"en":"Whose presence was unlike any other's,"},{"id":"semetey-1-2013:p0566:b004:l015","ordinal":120329,"en":"His fly-like soul shriveling,"},{"id":"semetey-1-2013:p0566:b004:l016","ordinal":120330,"en":"Dark tears streaming from his eyes"},{"id":"semetey-1-2013:p0566:b004:l017","ordinal":120331,"en":"And rolling down his collarbone:"},{"id":"semetey-1-2013:p0566:b004:l018","ordinal":120332,"en":"“The massed Chinese have engulfed him;"},{"id":"semetey-1-2013:p0566:b004:l019","ordinal":120333,"en":"Let me reach my Alake,"},{"id":"semetey-1-2013:p0566:b004:l020","ordinal":120334,"en":"Rather than remain alive, before him"},{"id":"semetey-1-2013:p0566:b004:l021","ordinal":120335,"en":"Let me fall in sacrifice."},{"id":"semetey-1-2013:p0566:b004:l022","ordinal":120336,"en":"Let me arrive before Almam;"},{"id":"semetey-1-2013:p0566:b004:l023","ordinal":120337,"en":"Parted from my Alake,"},{"id":"semetey-1-2013:p0566:b004:l024","ordinal":120338,"en":"My twin lamb, my companion,"},{"id":"semetey-1-2013:p0566:b004:l025","ordinal":120339,"en":"Having devoured my twin,"},{"id":"semetey-1-2013:p0566:b004:l026","ordinal":120340,"en":"How could I leave without longing?"},{"id":"semetey-1-2013:p0566:b004:l027","ordinal":120341,"en":"Against the red-naveled Chinese,"},{"id":"semetey-1-2013:p0566:b004:l028","ordinal":120342,"en":"The infidels of the dark faith,"},{"id":"semetey-1-2013:p0566:b004:l029","ordinal":120343,"en":"The head-severing warriors,"},{"id":"semetey-1-2013:p0566:b004:l030","ordinal":120344,"en":"Let me come with my waist girded,"},{"id":"semetey-1-2013:p0566:b004:l031","ordinal":120345,"en":"Charge alone and attack,"},{"id":"semetey-1-2013:p0566:b004:l032","ordinal":120346,"en":"Till the yielding stalks ripen,"},{"id":"semetey-1-2013:p0566:b004:l033","ordinal":120347,"en":"Till autumn's gossamer flies,"},{"id":"semetey-1-2013:p0566:b004:l034","ordinal":120348,"en":"Let me fight hard and wreak slaughter,"},{"id":"semetey-1-2013:p0566:b004:l035","ordinal":120349,"en":"And my fierce Almam the leopard—"},{"id":"semetey-1-2013:p0566:b004:l036","ordinal":120350,"en":"Let me break him free!”"},{"id":"semetey-1-2013:p0566:b004:l037","ordinal":120351,"en":"Kokchebich beneath him,"},{"id":"semetey-1-2013:p0566:b004:l038","ordinal":120352,"en":"He whipped now right, now left,"},{"id":"semetey-1-2013:p0566:b004:l039","ordinal":120353,"en":"And spurred on either side,"},{"id":"semetey-1-2013:p0567:b003:l001","ordinal":120354,"en":"Roaring in fury,"},{"id":"semetey-1-2013:p0567:b003:l002","ordinal":120355,"en":"Calling, “Alake, leopard!”"},{"id":"semetey-1-2013:p0567:b003:l003","ordinal":120356,"en":"Into the Chinese ahead, the many warriors,"},{"id":"semetey-1-2013:p0567:b003:l004","ordinal":120357,"en":"Your Syrgak charged without wavering and attacked."},{"id":"semetey-1-2013:p0567:b003:l006","ordinal":120358,"en":"Those he met were killed;"},{"id":"semetey-1-2013:p0567:b003:l007","ordinal":120359,"en":"Those he met shed their blood."},{"id":"semetey-1-2013:p0567:b003:l008","ordinal":120360,"en":"Those within reach of his spear"},{"id":"semetey-1-2013:p0567:b003:l009","ordinal":120361,"en":"He felled with the spear;"},{"id":"semetey-1-2013:p0567:b003:l010","ordinal":120362,"en":"Those who came nearer"},{"id":"semetey-1-2013:p0567:b003:l011","ordinal":120363,"en":"He struck down with his sword."},{"id":"semetey-1-2013:p0567:b003:l012","ordinal":120364,"en":"He smashed seven hundred,"},{"id":"semetey-1-2013:p0567:b003:l013","ordinal":120365,"en":"Thrusting wherever he reached,"},{"id":"semetey-1-2013:p0567:b003:l014","ordinal":120366,"en":"Crying, “Where is my accomplished Almam?”"},{"id":"semetey-1-2013:p0567:b003:l015","ordinal":120367,"en":"His head all bloody,"},{"id":"semetey-1-2013:p0567:b003:l016","ordinal":120368,"en":"His two flailing arms"},{"id":"semetey-1-2013:p0567:b003:l017","ordinal":120369,"en":"Unable to rise, hanging limp."},{"id":"semetey-1-2013:p0567:b003:l018","ordinal":120370,"en":"Shouting, “Islam!”"},{"id":"semetey-1-2013:p0567:b003:l019","ordinal":120371,"en":"The seething Chinese"},{"id":"semetey-1-2013:p0567:b003:l020","ordinal":120372,"en":"He routed, drove and scattered."},{"id":"semetey-1-2013:p0567:b003:l021","ordinal":120373,"en":"My Almam, left on foot,"},{"id":"semetey-1-2013:p0567:b003:l022","ordinal":120374,"en":"The warrior barely standing—"},{"id":"semetey-1-2013:p0567:b003:l023","ordinal":120375,"en":"He reached him faster than an arrow."},{"id":"semetey-1-2013:p0567:b003:l024","ordinal":120376,"en":"Where he reached my Almam,"},{"id":"semetey-1-2013:p0567:b003:l025","ordinal":120377,"en":"Showing his lion's courage,"},{"id":"semetey-1-2013:p0567:b003:l026","ordinal":120378,"en":"Seizing him by the shoulder blade,"},{"id":"semetey-1-2013:p0567:b003:l027","ordinal":120379,"en":"Young Syrgak, the fierce hero,"},{"id":"semetey-1-2013:p0567:b003:l028","ordinal":120380,"en":"Hoisted him onto his right knee."},{"id":"semetey-1-2013:p0567:b003:l029","ordinal":120381,"en":"In a frantic haste,"},{"id":"semetey-1-2013:p0567:b003:l030","ordinal":120382,"en":"Splitting the countless Chinese apart,"},{"id":"semetey-1-2013:p0567:b003:l031","ordinal":120383,"en":"Dear Syrgak carried your Alake away."},{"id":"semetey-1-2013:p0567:b003:l032","ordinal":120384,"en":"He reached there faster than an arrow;"},{"id":"semetey-1-2013:p0567:b003:l033","ordinal":120385,"en":"At the place he reached was Sarala."},{"id":"semetey-1-2013:p0567:b003:l034","ordinal":120386,"en":"He mounted him on Sarala,"},{"id":"semetey-1-2013:p0567:b003:l035","ordinal":120387,"en":"Rekindled his extinguished fire,"},{"id":"semetey-1-2013:p0567:b003:l036","ordinal":120388,"en":"Revived his dead soul,"},{"id":"semetey-1-2013:p0567:b003:l037","ordinal":120389,"en":"And havoc upon Kakan"},{"id":"semetey-1-2013:p0567:b003:l038","ordinal":120390,"en":"He wrought, standing without retreat."},{"id":"semetey-1-2013:p0567:b003:l039","ordinal":120391,"en":"Joining with your Alake,"},{"id":"semetey-1-2013:p0567:b004:l001","ordinal":120392,"en":"How they slaughtered the Chinese—"},{"id":"semetey-1-2013:p0567:b004:l002","ordinal":120393,"en":"He made him see his very life before his eyes."},{"id":"semetey-1-2013:p0567:b004:l003","ordinal":120394,"en":"My dear mother Kanykei"},{"id":"semetey-1-2013:p0567:b004:l004","ordinal":120395,"en":"Had drawn it in a picture:"},{"id":"semetey-1-2013:p0567:b004:l005","ordinal":120396,"en":"“Let the orphan see it when he comes;"},{"id":"semetey-1-2013:p0567:b004:l006","ordinal":120397,"en":"May their service"},{"id":"semetey-1-2013:p0567:b004:l007","ordinal":120398,"en":"Never be forgotten,” she said,"},{"id":"semetey-1-2013:p0567:b004:l008","ordinal":120399,"en":"And drew it clearly in a picture."},{"id":"semetey-1-2013:p0567:b004:l009","ordinal":120400,"en":"On this side of it,"},{"id":"semetey-1-2013:p0567:b004:l010","ordinal":120401,"en":"Their steeds with piebald heads,"},{"id":"semetey-1-2013:p0567:b004:l011","ordinal":120402,"en":"Manas khan's forty nobles—"},{"id":"semetey-1-2013:p0567:b004:l012","ordinal":120403,"en":"My dear mother Kanykei"},{"id":"semetey-1-2013:p0567:b004:l013","ordinal":120404,"en":"Had drawn them all together."},{"id":"semetey-1-2013:p0567:b004:l014","ordinal":120405,"en":"Then the boy Semetey,"},{"id":"semetey-1-2013:p0567:b004:l015","ordinal":120406,"en":"Wailing, weeping, sobbing,"},{"id":"semetey-1-2013:p0567:b004:l016","ordinal":120407,"en":"As though they might come back to life,"},{"id":"semetey-1-2013:p0567:b004:l017","ordinal":120408,"en":"The boy cried out in tears:"},{"id":"semetey-1-2013:p0567:b004:l018","ordinal":120409,"en":"When dawn splits and breaks,"},{"id":"semetey-1-2013:p0567:b004:l019","ordinal":120410,"en":"“I never became his guiding mark;"},{"id":"semetey-1-2013:p0567:b004:l020","ordinal":120411,"en":"When he wreaked havoc on Kakan,"},{"id":"semetey-1-2013:p0567:b004:l021","ordinal":120412,"en":"Joining with my father,"},{"id":"semetey-1-2013:p0567:b004:l022","ordinal":120413,"en":"I never became his companion.”"},{"id":"semetey-1-2013:p0567:b004:l023","ordinal":120414,"en":"Speaking thus, Semetey,"},{"id":"semetey-1-2013:p0567:b004:l024","ordinal":120415,"en":"For the lions gone to the other world,"},{"id":"semetey-1-2013:p0567:b004:l025","ordinal":120416,"en":"Recited the Quran for those warriors."},{"id":"semetey-1-2013:p0567:b004:l026","ordinal":120417,"en":"Unable to bear gazing at them,"},{"id":"semetey-1-2013:p0567:b004:l027","ordinal":120418,"en":"Urging them on as though alive,"},{"id":"semetey-1-2013:p0567:b004:l028","ordinal":120419,"en":"The boy made a lake of his tears."},{"id":"semetey-1-2013:p0567:b004:l029","ordinal":120420,"en":"He went farther on,"},{"id":"semetey-1-2013:p0567:b004:l030","ordinal":120421,"en":"To Bek-Jailoo at the head of Besh-Tash;"},{"id":"semetey-1-2013:p0567:b004:l031","ordinal":120422,"en":"There is a story to be told."},{"id":"semetey-1-2013:p0567:b004:l032","ordinal":120423,"en":"When Kanykei fled to Bukhara,"},{"id":"semetey-1-2013:p0567:b004:l033","ordinal":120424,"en":"With Abyke and the slave Kobosh"},{"id":"semetey-1-2013:p0567:b004:l034","ordinal":120425,"en":"Bakai fought fiercely,"},{"id":"semetey-1-2013:p0567:b004:l035","ordinal":120426,"en":"Won the name “Bloody Neck,”"},{"id":"semetey-1-2013:p0567:b004:l036","ordinal":120427,"en":"Bakai the blood-drinker battled on."},{"id":"semetey-1-2013:p0567:b004:l037","ordinal":120428,"en":"Bakai khan herded camels"},{"id":"semetey-1-2013:p0567:b004:l038","ordinal":120429,"en":"In that time of bitter suffering."},{"id":"semetey-1-2013:p0567:b004:l039","ordinal":120430,"en":"For twelve years he fought,"},{"id":"semetey-1-2013:p0568:b003:l001","ordinal":120431,"en":"In those days he shot sixty of Abyke's warriors."},{"id":"semetey-1-2013:p0568:b003:l002","ordinal":120432,"en":"Yesterday, when King Manas died,"},{"id":"semetey-1-2013:p0568:b003:l003","ordinal":120433,"en":"These were the words of his last wishes:"},{"id":"semetey-1-2013:p0568:b003:l004","ordinal":120434,"en":"“When the khan dies, to the old man"},{"id":"semetey-1-2013:p0568:b003:l005","ordinal":120435,"en":"His camels will remain close."},{"id":"semetey-1-2013:p0568:b003:l006","ordinal":120436,"en":"Herd the camels, my uncle;"},{"id":"semetey-1-2013:p0568:b003:l007","ordinal":120437,"en":"Do not camp at ease."},{"id":"semetey-1-2013:p0568:b003:l008","ordinal":120438,"en":"Now, my uncle Bakai,"},{"id":"semetey-1-2013:p0568:b003:l009","ordinal":120439,"en":"Do not live as you did before."},{"id":"semetey-1-2013:p0568:b003:l010","ordinal":120440,"en":"If you go to an assembly, you will see:"},{"id":"semetey-1-2013:p0568:b003:l011","ordinal":120441,"en":"If they call you 'White-beard Bakai,'"},{"id":"semetey-1-2013:p0568:b003:l012","ordinal":120442,"en":"Uncle Bakai, that day you will die!"},{"id":"semetey-1-2013:p0568:b003:l013","ordinal":120443,"en":"Worse than death, my khan uncle,"},{"id":"semetey-1-2013:p0568:b003:l014","ordinal":120444,"en":"You will see the face of Judgment Day!"},{"id":"semetey-1-2013:p0568:b003:l015","ordinal":120445,"en":"If you disobey, disgrace awaits;"},{"id":"semetey-1-2013:p0568:b003:l016","ordinal":120446,"en":"Beginning with this Jelmaian,"},{"id":"semetey-1-2013:p0568:b003:l017","ordinal":120447,"en":"Khan uncle, the orphan's camels are entrusted to you!”"},{"id":"semetey-1-2013:p0568:b003:l018","ordinal":120448,"en":"The camels Bakai was herding"},{"id":"semetey-1-2013:p0568:b003:l019","ordinal":120449,"en":"Had then reached seven hundred."},{"id":"semetey-1-2013:p0568:b003:l020","ordinal":120450,"en":"When he arrived that year,"},{"id":"semetey-1-2013:p0568:b003:l021","ordinal":120451,"en":"There were seven hundred camels."},{"id":"semetey-1-2013:p0568:b003:l022","ordinal":120452,"en":"At Jar-Kyia of Jangyryk,"},{"id":"semetey-1-2013:p0568:b003:l023","ordinal":120453,"en":"On the path where beasts pass singly,"},{"id":"semetey-1-2013:p0568:b003:l024","ordinal":120454,"en":"That the orphan would surely come, hey,"},{"id":"semetey-1-2013:p0568:b003:l025","ordinal":120455,"en":"The seven hundred camels knew, hey;"},{"id":"semetey-1-2013:p0568:b003:l026","ordinal":120456,"en":"They had filled Jangyryk, hey."},{"id":"semetey-1-2013:p0568:b003:l027","ordinal":120457,"en":"All the camels bellowed, hey,"},{"id":"semetey-1-2013:p0568:b003:l028","ordinal":120458,"en":"Bellowing toward Semetey, hey."},{"id":"semetey-1-2013:p0568:b003:l029","ordinal":120459,"en":"They wished to speak, hey, but had no speech;"},{"id":"semetey-1-2013:p0568:b003:l030","ordinal":120460,"en":"All together they cried out, hey."},{"id":"semetey-1-2013:p0568:b003:l031","ordinal":120461,"en":"Asy taylak, Thai taylak,"},{"id":"semetey-1-2013:p0568:b003:l032","ordinal":120462,"en":"They all ran, ah, swaying,"},{"id":"semetey-1-2013:p0568:b003:l033","ordinal":120463,"en":"Their shaggy neck-hair parting, hey,"},{"id":"semetey-1-2013:p0568:b003:l034","ordinal":120464,"en":"Their tears spilling, hey."},{"id":"semetey-1-2013:p0568:b003:l035","ordinal":120465,"en":"They surrounded him, hey, and bellowed,"},{"id":"semetey-1-2013:p0568:b003:l036","ordinal":120466,"en":"As though gathered at a salt flat, hey,"},{"id":"semetey-1-2013:p0568:b003:l037","ordinal":120467,"en":"All sniffing the orphan, hey, and bellowing."},{"id":"semetey-1-2013:p0568:b003:l039","ordinal":120468,"en":"While the camels stood thus, hey,"},{"id":"semetey-1-2013:p0568:b004:l001","ordinal":120469,"en":"The prince's heart was torn, hey."},{"id":"semetey-1-2013:p0568:b004:l002","ordinal":120470,"en":"“My father, Prince Manas, hey, do not die!” he said,"},{"id":"semetey-1-2013:p0568:b004:l003","ordinal":120471,"en":"The orphan's tears spilling, hey."},{"id":"semetey-1-2013:p0568:b004:l005","ordinal":120472,"en":"“Alas, when even his beasts are like this, hey,"},{"id":"semetey-1-2013:p0568:b004:l007","ordinal":120473,"en":"How is my human life worth sparing, hey?!”"},{"id":"semetey-1-2013:p0568:b004:l009","ordinal":120474,"en":"Semetey sobbed with the camels;"},{"id":"semetey-1-2013:p0568:b004:l010","ordinal":120475,"en":"The prince's son, hey, your dear boy,"},{"id":"semetey-1-2013:p0568:b004:l011","ordinal":120476,"en":"Stood wailing then, hey, and crying out:"},{"id":"semetey-1-2013:p0568:b004:l013","ordinal":120477,"en":"“To Temir khan's city, hey,"},{"id":"semetey-1-2013:p0568:b004:l014","ordinal":120478,"en":"Oh God, I wandered in disgrace;"},{"id":"semetey-1-2013:p0568:b004:l015","ordinal":120479,"en":"Hey, my ocean of a father, take me with you!”"},{"id":"semetey-1-2013:p0568:b004:l016","ordinal":120480,"en":"Then Semetey, weeping and wailing, hey,"},{"id":"semetey-1-2013:p0568:b004:l017","ordinal":120481,"en":"Saying, “Let me die,” hey, yet unable to die,"},{"id":"semetey-1-2013:p0568:b004:l018","ordinal":120482,"en":"Unable to take his own life!"},{"id":"semetey-1-2013:p0568:b004:l019","ordinal":120483,"en":"Then from those dear quail-like eyes"},{"id":"semetey-1-2013:p0568:b004:l020","ordinal":120484,"en":"Tears fell drop by drop, hey."},{"id":"semetey-1-2013:p0568:b004:l021","ordinal":120485,"en":"Those dear currant-like eyes, hey—"},{"id":"semetey-1-2013:p0568:b004:l022","ordinal":120486,"en":"The orphan's tears streamed a whip-length down."},{"id":"semetey-1-2013:p0568:b004:l023","ordinal":120487,"en":"The boy wept, hey, and stopped;"},{"id":"semetey-1-2013:p0568:b004:l024","ordinal":120488,"en":"The boy's two eyes, hey, had become embers."},{"id":"semetey-1-2013:p0568:b004:l025","ordinal":120489,"en":"Alas, while the orphan stood thus, hey,"},{"id":"semetey-1-2013:p0568:b004:l027","ordinal":120490,"en":"Then the camel mother, the gray she-camel in her fifth year,"},{"id":"semetey-1-2013:p0568:b004:l028","ordinal":120491,"en":"Came to the boy, hey, bellowing with him."},{"id":"semetey-1-2013:p0568:b004:l029","ordinal":120492,"en":"The camel father, hey, the gray bull,"},{"id":"semetey-1-2013:p0568:b004:l030","ordinal":120493,"en":"Came forth with them then, hey, crying out."},{"id":"semetey-1-2013:p0568:b004:l031","ordinal":120494,"en":"Behind those two, hey,"},{"id":"semetey-1-2013:p0568:b004:l032","ordinal":120495,"en":"Manas's broad-humped, hey, black hybrid camel,"},{"id":"semetey-1-2013:p0568:b004:l034","ordinal":120496,"en":"Jelmaian, left from Manas himself,"},{"id":"semetey-1-2013:p0568:b004:l036","ordinal":120497,"en":"Its front lip flapping, hey,"},{"id":"semetey-1-2013:p0568:b004:l037","ordinal":120498,"en":"Its rear hump, hey, swaying,"},{"id":"semetey-1-2013:p0568:b004:l039","ordinal":120499,"en":"Had a golden halter, hey, on its head,"},{"id":"semetey-1-2013:p0569:b003:l001","ordinal":120500,"en":"Counting its years of maturity, ah,"},{"id":"semetey-1-2013:p0569:b003:l002","ordinal":120501,"en":"It had fully reached that age."},{"id":"semetey-1-2013:p0569:b003:l003","ordinal":120502,"en":"If you looked at the creature, ah,"},{"id":"semetey-1-2013:p0569:b003:l004","ordinal":120503,"en":"It was in its ninety-ninth year, ah."},{"id":"semetey-1-2013:p0569:b003:l005","ordinal":120504,"en":"To my father, Sultan Manas, ah,"},{"id":"semetey-1-2013:p0569:b003:l006","ordinal":120505,"en":"It had come from the unseen, ah."},{"id":"semetey-1-2013:p0569:b003:l007","ordinal":120506,"en":"When Manas journeyed to Mecca,"},{"id":"semetey-1-2013:p0569:b003:l008","ordinal":120507,"en":"It was found in Lower Medina."},{"id":"semetey-1-2013:p0569:b003:l009","ordinal":120508,"en":"No wind could match its trot, ah;"},{"id":"semetey-1-2013:p0569:b003:l010","ordinal":120509,"en":"No beast could match its walk."},{"id":"semetey-1-2013:p0569:b003:l011","ordinal":120510,"en":"Trotting, it skimmed the earth, ah;"},{"id":"semetey-1-2013:p0569:b003:l012","ordinal":120511,"en":"All four corners of the round world"},{"id":"semetey-1-2013:p0569:b003:l013","ordinal":120512,"en":"It roamed in four days without tiring."},{"id":"semetey-1-2013:p0569:b003:l014","ordinal":120513,"en":"Call it a cloud, ah—it had feet;"},{"id":"semetey-1-2013:p0569:b003:l015","ordinal":120514,"en":"Call it an unseen being, ah—it was tethered."},{"id":"semetey-1-2013:p0569:b003:l016","ordinal":120515,"en":"A beast beyond all other beasts was with him;"},{"id":"semetey-1-2013:p0569:b003:l017","ordinal":120516,"en":"In battle, ah, it shared his very life."},{"id":"semetey-1-2013:p0569:b003:l018","ordinal":120517,"en":"When he waged holy war on the unbelievers,"},{"id":"semetey-1-2013:p0569:b003:l019","ordinal":120518,"en":"When countless troops went to Beijing,"},{"id":"semetey-1-2013:p0569:b003:l020","ordinal":120519,"en":"Each day they loaded it with travel rations, ah,"},{"id":"semetey-1-2013:p0569:b003:l021","ordinal":120520,"en":"Loaded it with ample ammunition, ah."},{"id":"semetey-1-2013:p0569:b003:l022","ordinal":120521,"en":"When he went to war, it was his merry fellow,"},{"id":"semetey-1-2013:p0569:b003:l023","ordinal":120522,"en":"His battle mount, ah, sharing his life:"},{"id":"semetey-1-2013:p0569:b003:l024","ordinal":120523,"en":"Zhelmayyan, left by his father Manas."},{"id":"semetey-1-2013:p0569:b003:l025","ordinal":120524,"en":"When dear Manas died,"},{"id":"semetey-1-2013:p0569:b003:l026","ordinal":120525,"en":"Poor Zhelmayyan,"},{"id":"semetey-1-2013:p0569:b003:l027","ordinal":120526,"en":"Mourning, ah, ate no grass;"},{"id":"semetey-1-2013:p0569:b003:l028","ordinal":120527,"en":"Grieving, ah, drank no water."},{"id":"semetey-1-2013:p0569:b003:l029","ordinal":120528,"en":"Mostly among the camels, ah,"},{"id":"semetey-1-2013:p0569:b003:l030","ordinal":120529,"en":"It had been wandering, ah."},{"id":"semetey-1-2013:p0569:b003:l031","ordinal":120530,"en":"“When will my orphan come?”"},{"id":"semetey-1-2013:p0569:b003:l032","ordinal":120531,"en":"It had no tongue to say the words;"},{"id":"semetey-1-2013:p0569:b003:l033","ordinal":120532,"en":"The creature had been grieving."},{"id":"semetey-1-2013:p0569:b003:l034","ordinal":120533,"en":"When it saw Semetey, ah,"},{"id":"semetey-1-2013:p0569:b003:l035","ordinal":120534,"en":"Zhelmayyan, sovereign among camels,"},{"id":"semetey-1-2013:p0569:b003:l036","ordinal":120535,"en":"Came bellowing and sobbing, ah."},{"id":"semetey-1-2013:p0569:b003:l037","ordinal":120536,"en":"Its white neck wool parted, ah;"},{"id":"semetey-1-2013:p0569:b003:l038","ordinal":120537,"en":"Tears poured from its eyes, ah."},{"id":"semetey-1-2013:p0569:b003:l039","ordinal":120538,"en":"On its head was a golden halter, ah,"},{"id":"semetey-1-2013:p0569:b005:l001","ordinal":120539,"en":"Good heavens, flashing into sight!"},{"id":"semetey-1-2013:p0569:b005:l002","ordinal":120540,"en":"The creature wept like a human, ah;"},{"id":"semetey-1-2013:p0569:b005:l003","ordinal":120541,"en":"Then tears poured from its eyes, ah."},{"id":"semetey-1-2013:p0569:b005:l004","ordinal":120542,"en":"“An inheritance left by my father, ah,”"},{"id":"semetey-1-2013:p0569:b005:l005","ordinal":120543,"en":"Said Semetey, ah, seeing it,"},{"id":"semetey-1-2013:p0569:b005:l006","ordinal":120544,"en":"His heart sorely stricken, ah."},{"id":"semetey-1-2013:p0569:b005:l007","ordinal":120545,"en":"Grieving again, ah, Zhelmayyan"},{"id":"semetey-1-2013:p0569:b005:l008","ordinal":120546,"en":"Thrust its head beneath his arm, ah;"},{"id":"semetey-1-2013:p0569:b005:l009","ordinal":120547,"en":"Zhelmayyan stood nestled close, ah,"},{"id":"semetey-1-2013:p0569:b005:l010","ordinal":120548,"en":"And, rumbling, ah, the orphan"},{"id":"semetey-1-2013:p0569:b005:l011","ordinal":120549,"en":"Zhelmayyan kept sniffing, ah."},{"id":"semetey-1-2013:p0569:b005:l012","ordinal":120550,"en":"It snuffled over his hand, ah,"},{"id":"semetey-1-2013:p0569:b005:l013","ordinal":120551,"en":"Then sniffed his neck once, ah."},{"id":"semetey-1-2013:p0569:b005:l014","ordinal":120552,"en":"Circling, ah, sobbing,"},{"id":"semetey-1-2013:p0569:b005:l015","ordinal":120553,"en":"When he saw Zhelmayyan, ah,"},{"id":"semetey-1-2013:p0569:b005:l016","ordinal":120554,"en":"The orphan's soul cried out, ah."},{"id":"semetey-1-2013:p0569:b005:l017","ordinal":120555,"en":"He and Zhelmayyan both wept, ah,"},{"id":"semetey-1-2013:p0569:b005:l018","ordinal":120556,"en":"Bellowing and crying aloud, ah."},{"id":"semetey-1-2013:p0569:b005:l019","ordinal":120557,"en":"Now see the wonder, ah:"},{"id":"semetey-1-2013:p0569:b005:l020","ordinal":120558,"en":"It circled around the boy;"},{"id":"semetey-1-2013:p0569:b005:l021","ordinal":120559,"en":"Grieving again, ah, Zhelmayyan"},{"id":"semetey-1-2013:p0569:b005:l022","ordinal":120560,"en":"It turned its neck, ah."},{"id":"semetey-1-2013:p0569:b005:l023","ordinal":120561,"en":"Over a saddle-shaped ridge, ah,"},{"id":"semetey-1-2013:p0569:b005:l024","ordinal":120562,"en":"Zhelmayyan went, ah,"},{"id":"semetey-1-2013:p0569:b005:l025","ordinal":120563,"en":"Toward Khan Manas's enclosure, ah,"},{"id":"semetey-1-2013:p0569:b005:l026","ordinal":120564,"en":"Heading for that enclosure, ah,"},{"id":"semetey-1-2013:p0569:b005:l027","ordinal":120565,"en":"Zhelmayyan ran away, ah."},{"id":"semetey-1-2013:p0569:b005:l028","ordinal":120566,"en":"Ah, no beast could match its walk;"},{"id":"semetey-1-2013:p0569:b005:l030","ordinal":120567,"en":"Ah, no wind could match its trot."},{"id":"semetey-1-2013:p0569:b005:l031","ordinal":120568,"en":"On Aktulpar beneath him,"},{"id":"semetey-1-2013:p0569:b005:l032","ordinal":120569,"en":"Lashing right and left with his whip,"},{"id":"semetey-1-2013:p0569:b005:l033","ordinal":120570,"en":"To catch up and seize it—"},{"id":"semetey-1-2013:p0569:b005:l034","ordinal":120571,"en":"That was Semetey's thought, ah,"},{"id":"semetey-1-2013:p0569:b005:l035","ordinal":120572,"en":"To catch up and head it off."},{"id":"semetey-1-2013:p0569:b005:l036","ordinal":120573,"en":"Keeping beyond Semetey's reach, ah,"},{"id":"semetey-1-2013:p0569:b005:l037","ordinal":120574,"en":"Zhelmayyan walked on, ah."},{"id":"semetey-1-2013:p0569:b005:l038","ordinal":120575,"en":"Toward Khan Manas's tomb"},{"id":"semetey-1-2013:p0569:b005:l039","ordinal":120576,"en":"Zhelmayyan ran away, ah."}]
