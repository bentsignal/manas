[{"id":"manas-2010:p1257:b001:l001","ordinal":54529,"en":"Take strides like a mountain sheep!’"},{"id":"manas-2010:p1257:b001:l002","ordinal":54530,"en":"Kökchebich beneath him"},{"id":"manas-2010:p1257:b001:l003","ordinal":54531,"en":"Bounded like a roe deer."},{"id":"manas-2010:p1257:b001:l004","ordinal":54532,"en":"The creature's body heated,"},{"id":"manas-2010:p1257:b001:l005","ordinal":54533,"en":"He ran, casting his life aside."},{"id":"manas-2010:p1257:b001:l006","ordinal":54534,"en":"Thus your gray-maned Syrgak,"},{"id":"manas-2010:p1257:b001:l007","ordinal":54535,"en":"In the blink of an eye,"},{"id":"manas-2010:p1257:b001:l008","ordinal":54536,"en":"With Kökchebich beneath him,"},{"id":"manas-2010:p1257:b001:l009","ordinal":54537,"en":"His back bent like a spring trap,"},{"id":"manas-2010:p1257:b001:l010","ordinal":54538,"en":"Over so many ridges and hillocks,"},{"id":"manas-2010:p1257:b001:l011","ordinal":54539,"en":"Bounded with them both aboard."},{"id":"manas-2010:p1257:b001:l012","ordinal":54540,"en":"At that time, that same"},{"id":"manas-2010:p1257:b001:l013","ordinal":54541,"en":"Sarala who had been fleeing,"},{"id":"manas-2010:p1257:b001:l014","ordinal":54542,"en":"Excited, alone on the plain,"},{"id":"manas-2010:p1257:b001:l015","ordinal":54543,"en":"Was grazing."},{"id":"manas-2010:p1257:b001:l016","ordinal":54544,"en":"Though a beast, his master"},{"id":"manas-2010:p1257:b001:l017","ordinal":54545,"en":"He was searching for."},{"id":"manas-2010:p1257:b001:l018","ordinal":54546,"en":"When he saw Almambet,"},{"id":"manas-2010:p1257:b001:l019","ordinal":54547,"en":"He neighed and came quickly."},{"id":"manas-2010:p1257:b001:l020","ordinal":54548,"en":"Sighing, turning broadside,"},{"id":"manas-2010:p1257:b001:l021","ordinal":54549,"en":"He offered his flank."},{"id":"manas-2010:p1257:b001:l022","ordinal":54550,"en":"Before the Chinese could reach them,"},{"id":"manas-2010:p1257:b001:l023","ordinal":54551,"en":"He sprang onto the horse."},{"id":"manas-2010:p1257:b001:l024","ordinal":54552,"en":"Kindling his extinguished fire,"},{"id":"manas-2010:p1257:b001:l025","ordinal":54553,"en":"Reviving his dead soul,"},{"id":"manas-2010:p1257:b001:l026","ordinal":54554,"en":"Ulak Khan's Syrgak"},{"id":"manas-2010:p1257:b001:l027","ordinal":54555,"en":"Sent Azizkan's gray-maned son"},{"id":"manas-2010:p1257:b001:l028","ordinal":54556,"en":"Back into battle."},{"id":"manas-2010:p1257:b001:l029","ordinal":54557,"en":"Making Sarala dance,"},{"id":"manas-2010:p1257:b001:l030","ordinal":54558,"en":"Almambet, burning within,"},{"id":"manas-2010:p1257:b001:l031","ordinal":54559,"en":"Into the swarming mass of Chinese,"},{"id":"manas-2010:p1257:b001:l032","ordinal":54560,"en":"Entered the Chinese once again,"},{"id":"manas-2010:p1257:b001:l033","ordinal":54561,"en":"Making blood flow, destroying them."},{"id":"manas-2010:p1257:b001:l034","ordinal":54562,"en":"People filled the place, seething;"},{"id":"manas-2010:p1257:b001:l035","ordinal":54563,"en":"Without regard for day or night,"},{"id":"manas-2010:p1257:b001:l036","ordinal":54564,"en":"Battle raged without rest."},{"id":"manas-2010:p1257:b001:l037","ordinal":54565,"en":"The multitude of Chinese, by stratagem,"},{"id":"manas-2010:p1257:b001:l038","ordinal":54566,"en":"Had dug a ditch; they came upon it,"},{"id":"manas-2010:p1257:b001:l039","ordinal":54567,"en":"They came upon prepared misery."},{"id":"manas-2010:p1257:b001:l040","ordinal":54568,"en":"When the countless host swarmed in,"},{"id":"manas-2010:p1257:b001:l041","ordinal":54569,"en":"The two heroes, Almambet and Syrgak,"},{"id":"manas-2010:p1257:b001:l042","ordinal":54570,"en":"Found their lives hard pressed."},{"id":"manas-2010:p1258:b001:l001","ordinal":54571,"en":"Even then, of flinching,"},{"id":"manas-2010:p1258:b001:l002","ordinal":54572,"en":"Or thinking ‘I shall die,’ he had no thought."},{"id":"manas-2010:p1258:b001:l003","ordinal":54573,"en":"Never leaning upon his elbow to rest,"},{"id":"manas-2010:p1258:b001:l004","ordinal":54574,"en":"Never taking even a brief sleep,"},{"id":"manas-2010:p1258:b001:l005","ordinal":54575,"en":"There was no youth like hero Syrgak."},{"id":"manas-2010:p1258:b001:l006","ordinal":54576,"en":"Without looking before or behind,"},{"id":"manas-2010:p1258:b001:l007","ordinal":54577,"en":"Without sparing his frail life,"},{"id":"manas-2010:p1258:b001:l008","ordinal":54578,"en":"He entered the battle again."},{"id":"manas-2010:p1258:b001:l009","ordinal":54579,"en":"When Syrgak entered battle,"},{"id":"manas-2010:p1258:b001:l010","ordinal":54580,"en":"The Chinese of Beijing—"},{"id":"manas-2010:p1258:b001:l011","ordinal":54581,"en":"Their champions had arrived."},{"id":"manas-2010:p1258:b001:l012","ordinal":54582,"en":"Seeing the champions,"},{"id":"manas-2010:p1258:b001:l013","ordinal":54583,"en":"Almambet, without flinching,"},{"id":"manas-2010:p1258:b001:l014","ordinal":54584,"en":"Braced and tensed himself."},{"id":"manas-2010:p1258:b001:l015","ordinal":54585,"en":"As though only just beginning to fight,"},{"id":"manas-2010:p1258:b001:l016","ordinal":54586,"en":"Without sparing his single life,"},{"id":"manas-2010:p1258:b001:l017","ordinal":54587,"en":"He entered battle once again."},{"id":"manas-2010:p1258:b001:l018","ordinal":54588,"en":"Almambet, steaming with heat,"},{"id":"manas-2010:p1258:b001:l019","ordinal":54589,"en":"Girded his waist tightly,"},{"id":"manas-2010:p1258:b001:l020","ordinal":54590,"en":"Rolled his sleeves back again,"},{"id":"manas-2010:p1258:b001:l021","ordinal":54591,"en":"And entered the battle, crushing them down."},{"id":"manas-2010:p1258:b001:l022","ordinal":54592,"en":"Whipping Sarala,"},{"id":"manas-2010:p1258:b001:l023","ordinal":54593,"en":"He reached them faster than an arrow."},{"id":"manas-2010:p1258:b001:l024","ordinal":54594,"en":"Upon reaching the mighty army,"},{"id":"manas-2010:p1258:b001:l025","ordinal":54595,"en":"He swept them all aside as he passed."},{"id":"manas-2010:p1258:b001:l026","ordinal":54596,"en":"Letting out a mighty shout—"},{"id":"manas-2010:p1258:b001:l027","ordinal":54597,"en":"He too was a formidable warrior—"},{"id":"manas-2010:p1258:b001:l028","ordinal":54598,"en":"Straight toward Almambet,"},{"id":"manas-2010:p1258:b001:l029","ordinal":54599,"en":"Orokkyr of the Chinese"},{"id":"manas-2010:p1258:b001:l030","ordinal":54600,"en":"Came charging out."},{"id":"manas-2010:p1258:b001:l031","ordinal":54601,"en":"Not letting him prepare, Almambet,"},{"id":"manas-2010:p1258:b001:l032","ordinal":54602,"en":"From atop Karager,"},{"id":"manas-2010:p1258:b001:l033","ordinal":54603,"en":"Speared him down as he passed."},{"id":"manas-2010:p1258:b001:l034","ordinal":54604,"en":"Before the great warrior called Kömzhü"},{"id":"manas-2010:p1258:b001:l035","ordinal":54605,"en":"Could lift him onto his horse,"},{"id":"manas-2010:p1258:b001:l036","ordinal":54606,"en":"His trusted comrade, like black steel,"},{"id":"manas-2010:p1258:b001:l037","ordinal":54607,"en":"Hero Syrgak came charging;"},{"id":"manas-2010:p1258:b001:l038","ordinal":54608,"en":"Upon reaching Orok,"},{"id":"manas-2010:p1258:b001:l039","ordinal":54609,"en":"He cut off his head as he passed."},{"id":"manas-2010:p1258:b001:l040","ordinal":54610,"en":"Then Almambet,"},{"id":"manas-2010:p1258:b001:l041","ordinal":54611,"en":"Without looking all around,"},{"id":"manas-2010:p1258:b001:l042","ordinal":54612,"en":"Without sparing his frail life,"},{"id":"manas-2010:p1259:b001:l001","ordinal":54613,"en":"Karazhoy who stood facing him,"},{"id":"manas-2010:p1259:b001:l002","ordinal":54614,"en":"And Ezkara, khan of the Manchu,"},{"id":"manas-2010:p1259:b001:l003","ordinal":54615,"en":"He reached both together."},{"id":"manas-2010:p1259:b001:l004","ordinal":54616,"en":"Upon reaching them, Almambet"},{"id":"manas-2010:p1259:b001:l005","ordinal":54617,"en":"Knocked them down as he passed."},{"id":"manas-2010:p1259:b001:l006","ordinal":54618,"en":"When both fell from their horses,"},{"id":"manas-2010:p1259:b001:l007","ordinal":54619,"en":"Over a saddle-shaped ridge"},{"id":"manas-2010:p1259:b001:l008","ordinal":54620,"en":"Young Syrgak came crossing."},{"id":"manas-2010:p1259:b001:l009","ordinal":54621,"en":"‘If only I could cut off their heads!’"},{"id":"manas-2010:p1259:b001:l010","ordinal":54622,"en":"Hero Syrgak came hurrying."},{"id":"manas-2010:p1259:b001:l011","ordinal":54623,"en":"Reaching them, their heads"},{"id":"manas-2010:p1259:b001:l012","ordinal":54624,"en":"He was about to strike with his sword,"},{"id":"manas-2010:p1259:b001:l013","ordinal":54625,"en":"At that time, watching over them,"},{"id":"manas-2010:p1259:b001:l014","ordinal":54626,"en":"There were forty nobles."},{"id":"manas-2010:p1259:b001:l015","ordinal":54627,"en":"Among those nobles,"},{"id":"manas-2010:p1259:b001:l016","ordinal":54628,"en":"The one called Zholoy,"},{"id":"manas-2010:p1259:b001:l017","ordinal":54629,"en":"Not letting hero Syrgak reach them,"},{"id":"manas-2010:p1259:b001:l018","ordinal":54630,"en":"Reached them first himself."},{"id":"manas-2010:p1259:b001:l019","ordinal":54631,"en":"He mounted them upon their horses"},{"id":"manas-2010:p1259:b001:l020","ordinal":54632,"en":"And took them away."},{"id":"manas-2010:p1259:b001:l021","ordinal":54633,"en":"If you look beyond,"},{"id":"manas-2010:p1259:b001:l022","ordinal":54634,"en":"Dust rose where he moved;"},{"id":"manas-2010:p1259:b001:l023","ordinal":54635,"en":"Blood flowed where he struck."},{"id":"manas-2010:p1259:b001:l024","ordinal":54636,"en":"Almambet, Azizkan's son,"},{"id":"manas-2010:p1259:b001:l025","ordinal":54637,"en":"Fought in earnest."},{"id":"manas-2010:p1259:b001:l026","ordinal":54638,"en":"Riding a horse like Sarala,"},{"id":"manas-2010:p1259:b001:l027","ordinal":54639,"en":"Wearing yellow-piebald leather trousers,"},{"id":"manas-2010:p1259:b001:l028","ordinal":54640,"en":"Holding a spear without a tuft,"},{"id":"manas-2010:p1259:b001:l029","ordinal":54641,"en":"Girded with a bare sword,"},{"id":"manas-2010:p1259:b001:l030","ordinal":54642,"en":"Strength flowed from his two hands;"},{"id":"manas-2010:p1259:b001:l031","ordinal":54643,"en":"Black hair bristled on his face."},{"id":"manas-2010:p1259:b001:l032","ordinal":54644,"en":"From Sarala's nostrils,"},{"id":"manas-2010:p1259:b001:l033","ordinal":54645,"en":"Steam poured like smoke from a hide-smoking pit."},{"id":"manas-2010:p1259:b001:l034","ordinal":54646,"en":"When Almambet entered among them,"},{"id":"manas-2010:p1259:b001:l035","ordinal":54647,"en":"From the Chinese before him,"},{"id":"manas-2010:p1259:b001:l036","ordinal":54648,"en":"A fearful clamor rose."},{"id":"manas-2010:p1259:b001:l037","ordinal":54649,"en":"The Chinese swarming in,"},{"id":"manas-2010:p1259:b001:l038","ordinal":54650,"en":"The eye could not make out;"},{"id":"manas-2010:p1259:b001:l039","ordinal":54651,"en":"Like flying tumbleweed,"},{"id":"manas-2010:p1259:b001:l040","ordinal":54652,"en":"One could not tell which was which."},{"id":"manas-2010:p1259:b001:l041","ordinal":54653,"en":"Amid the dust that hid all sight,"},{"id":"manas-2010:p1259:b001:l042","ordinal":54654,"en":"Almambet was to face"},{"id":"manas-2010:p1260:b001:l001","ordinal":54655,"en":"Champion Khan Zholoy."},{"id":"manas-2010:p1260:b001:l002","ordinal":54656,"en":"‘When I thrust, you thrust!’"},{"id":"manas-2010:p1260:b001:l003","ordinal":54657,"en":"The many Chinese arranged themselves."},{"id":"manas-2010:p1260:b001:l004","ordinal":54658,"en":"Beyond Zholoy,"},{"id":"manas-2010:p1260:b001:l005","ordinal":54659,"en":"They placed Ylama."},{"id":"manas-2010:p1260:b001:l006","ordinal":54660,"en":"Beyond Ylama,"},{"id":"manas-2010:p1260:b001:l007","ordinal":54661,"en":"Dressing him in iron armor,"},{"id":"manas-2010:p1260:b001:l008","ordinal":54662,"en":"Upon a gray steed from Beijing,"},{"id":"manas-2010:p1260:b001:l009","ordinal":54663,"en":"They mounted him on Kerküröng;"},{"id":"manas-2010:p1260:b001:l010","ordinal":54664,"en":"They placed Börüköz there."},{"id":"manas-2010:p1260:b001:l011","ordinal":54665,"en":"When he saw these three,"},{"id":"manas-2010:p1260:b001:l012","ordinal":54666,"en":"Unable to turn back and flee,"},{"id":"manas-2010:p1260:b001:l013","ordinal":54667,"en":"Unable to draw back his extended spear,"},{"id":"manas-2010:p1260:b001:l014","ordinal":54668,"en":"He reached all three together."},{"id":"manas-2010:p1260:b001:l015","ordinal":54669,"en":"Upon reaching them, Almambet,"},{"id":"manas-2010:p1260:b001:l016","ordinal":54670,"en":"Sending them all from their horses,"},{"id":"manas-2010:p1260:b001:l017","ordinal":54671,"en":"Knocked them down as he passed."},{"id":"manas-2010:p1260:b001:l018","ordinal":54672,"en":"When the three fell from their horses,"},{"id":"manas-2010:p1260:b001:l019","ordinal":54673,"en":"His black horse had wings—"},{"id":"manas-2010:p1260:b001:l020","ordinal":54674,"en":"Alöökö's son Kongurbay,"},{"id":"manas-2010:p1260:b001:l021","ordinal":54675,"en":"At any time, the whole world"},{"id":"manas-2010:p1260:b001:l022","ordinal":54676,"en":"He was wont to churn like ground grain."},{"id":"manas-2010:p1260:b001:l023","ordinal":54677,"en":"The finest among spearmen,"},{"id":"manas-2010:p1260:b001:l024","ordinal":54678,"en":"Skilled in knowing the enemy's stratagems,"},{"id":"manas-2010:p1260:b001:l025","ordinal":54679,"en":"He was the back on which they leaned;"},{"id":"manas-2010:p1260:b001:l026","ordinal":54680,"en":"For the Chinese in Beijing,"},{"id":"manas-2010:p1260:b001:l027","ordinal":54681,"en":"He was the lion they relied upon."},{"id":"manas-2010:p1260:b001:l028","ordinal":54682,"en":"Your renowned, grim-faced champion,"},{"id":"manas-2010:p1260:b001:l029","ordinal":54683,"en":"To bring turmoil once again,"},{"id":"manas-2010:p1260:b001:l030","ordinal":54684,"en":"Came charging,"},{"id":"manas-2010:p1260:b001:l031","ordinal":54685,"en":"At gray-maned Almambet,"},{"id":"manas-2010:p1260:b001:l032","ordinal":54686,"en":"To thrust his spear, saying, ‘The flank!’"},{"id":"manas-2010:p1260:b001:l033","ordinal":54687,"en":"Algara, swift as a shimmering breeze,"},{"id":"manas-2010:p1260:b001:l034","ordinal":54688,"en":"Was just about to reach him,"},{"id":"manas-2010:p1260:b001:l035","ordinal":54689,"en":"Almambet from his horse"},{"id":"manas-2010:p1260:b001:l036","ordinal":54690,"en":"Was about to be knocked down,"},{"id":"manas-2010:p1260:b001:l037","ordinal":54691,"en":"His trusted comrade, like black steel,"},{"id":"manas-2010:p1260:b001:l038","ordinal":54692,"en":"Looking about like a falcon,"},{"id":"manas-2010:p1260:b001:l039","ordinal":54693,"en":"Syrgak had been riding there."},{"id":"manas-2010:p1260:b001:l040","ordinal":54694,"en":"From atop Algara,"},{"id":"manas-2010:p1260:b001:l041","ordinal":54695,"en":"The raging grim-faced one"},{"id":"manas-2010:p1260:b001:l042","ordinal":54696,"en":"He knocked down as he passed."},{"id":"manas-2010:p1261:b001:l001","ordinal":54697,"en":"Kökchebich beneath him"},{"id":"manas-2010:p1261:b001:l002","ordinal":54698,"en":"Was a hard-mouthed beast."},{"id":"manas-2010:p1261:b001:l003","ordinal":54699,"en":"When the grim-faced one fell from his horse,"},{"id":"manas-2010:p1261:b001:l004","ordinal":54700,"en":"He carried his rider off beyond him."},{"id":"manas-2010:p1261:b001:l005","ordinal":54701,"en":"Helpless, he shouted,"},{"id":"manas-2010:p1261:b001:l006","ordinal":54702,"en":"‘Alake, get there!’"},{"id":"manas-2010:p1261:b001:l007","ordinal":54703,"en":"Calling to Almambet,"},{"id":"manas-2010:p1261:b001:l008","ordinal":54704,"en":"‘Get there faster than an arrow!"},{"id":"manas-2010:p1261:b001:l009","ordinal":54705,"en":"That grim-faced one lying huddled,"},{"id":"manas-2010:p1261:b001:l010","ordinal":54706,"en":"Reach him and cut off his head!’"},{"id":"manas-2010:p1261:b001:l011","ordinal":54707,"en":"Hearing this, Almambet,"},{"id":"manas-2010:p1261:b001:l012","ordinal":54708,"en":"Sarala beneath him,"},{"id":"manas-2010:p1261:b001:l013","ordinal":54709,"en":"Whipped on right and left."},{"id":"manas-2010:p1261:b001:l014","ordinal":54710,"en":"He came steadily, holding nothing back."},{"id":"manas-2010:p1261:b001:l015","ordinal":54711,"en":"Seeing Almambet,"},{"id":"manas-2010:p1261:b001:l016","ordinal":54712,"en":"The many Chinese and Manchu"},{"id":"manas-2010:p1261:b001:l017","ordinal":54713,"en":"Said, ‘Hero Kongurbay is dead!’"},{"id":"manas-2010:p1261:b001:l018","ordinal":54714,"en":"They all despaired of life."},{"id":"manas-2010:p1261:b001:l019","ordinal":54715,"en":"When your Alake was about to reach and slaughter him,"},{"id":"manas-2010:p1261:b001:l020","ordinal":54716,"en":"The trick rider, the swift runner,"},{"id":"manas-2010:p1261:b001:l021","ordinal":54717,"en":"Kutan the Giant reached him first."},{"id":"manas-2010:p1261:b001:l022","ordinal":54718,"en":"Upon reaching the grim-faced one,"},{"id":"manas-2010:p1261:b001:l023","ordinal":54719,"en":"He mounted him upon Algara"},{"id":"manas-2010:p1261:b001:l024","ordinal":54720,"en":"And took him away, supporting him."},{"id":"manas-2010:p1261:b001:l025","ordinal":54721,"en":"This time, Kongurbay,"},{"id":"manas-2010:p1261:b001:l026","ordinal":54722,"en":"From Syrgak's spear thrust,"},{"id":"manas-2010:p1261:b001:l027","ordinal":54723,"en":"Was wounded like a boar."},{"id":"manas-2010:p1261:b001:l028","ordinal":54724,"en":"Then the many Chinese"},{"id":"manas-2010:p1261:b001:l029","ordinal":54725,"en":"Beat their booming drum."},{"id":"manas-2010:p1261:b001:l030","ordinal":54726,"en":"For seven days without fighting,"},{"id":"manas-2010:p1261:b001:l031","ordinal":54727,"en":"They requested a respite."},{"id":"manas-2010:p1261:b001:l032","ordinal":54728,"en":"He agreed to their respite;"},{"id":"manas-2010:p1261:b001:l033","ordinal":54729,"en":"For seven days without fighting,"},{"id":"manas-2010:p1261:b001:l034","ordinal":54730,"en":"He gave his promise."},{"id":"manas-2010:p1261:b001:l035","ordinal":54731,"en":"Almambet and Syrgak, the two lions,"},{"id":"manas-2010:p1261:b001:l036","ordinal":54732,"en":"Upon a broad ledge, a single path,"},{"id":"manas-2010:p1261:b001:l037","ordinal":54733,"en":"With a dark willow large as a house above,"},{"id":"manas-2010:p1261:b001:l038","ordinal":54734,"en":"Lay down and slept their fill."},{"id":"manas-2010:p1261:b001:l039","ordinal":54735,"en":"Kökchebich and Sarala"},{"id":"manas-2010:p1261:b001:l040","ordinal":54736,"en":"Grazed upon fescue grass."},{"id":"manas-2010:p1261:b001:l041","ordinal":54737,"en":"Sitting and talking a little together,"},{"id":"manas-2010:p1261:b001:l042","ordinal":54738,"en":"The two nobly born lions,"},{"id":"manas-2010:p1262:b001:l001","ordinal":54739,"en":"Both their steeds,"},{"id":"manas-2010:p1262:b001:l002","ordinal":54740,"en":"They filled their bellies with grass,"},{"id":"manas-2010:p1262:b001:l003","ordinal":54741,"en":"Let them rest and settle,"},{"id":"manas-2010:p1262:b001:l004","ordinal":54742,"en":"Let them rest quietly and sleep."},{"id":"manas-2010:p1262:b001:l005","ordinal":54743,"en":"After they had rested,"},{"id":"manas-2010:p1262:b001:l006","ordinal":54744,"en":"Dear woman Kanykey,"},{"id":"manas-2010:p1262:b001:l007","ordinal":54745,"en":"Having the face of the earth searched,"},{"id":"manas-2010:p1262:b001:l008","ordinal":54746,"en":"Charm herbs and lasting travel provisions"},{"id":"manas-2010:p1262:b001:l009","ordinal":54747,"en":"Had obtained wherever they were found."},{"id":"manas-2010:p1262:b001:l010","ordinal":54748,"en":"‘My Almambet, take them!"},{"id":"manas-2010:p1262:b001:l011","ordinal":54749,"en":"I give these as a gift."},{"id":"manas-2010:p1262:b001:l012","ordinal":54750,"en":"To those who know their use,"},{"id":"manas-2010:p1262:b001:l013","ordinal":54751,"en":"These things of mine have sacred power."},{"id":"manas-2010:p1262:b001:l014","ordinal":54752,"en":"Take them upon your journey!’"},{"id":"manas-2010:p1262:b001:l015","ordinal":54753,"en":"Against his bare skin, a white camel-wool shirt,"},{"id":"manas-2010:p1262:b001:l016","ordinal":54754,"en":"Had she not given him to wear?"},{"id":"manas-2010:p1262:b001:l017","ordinal":54755,"en":"‘When you bring turmoil upon Beijing,"},{"id":"manas-2010:p1262:b001:l018","ordinal":54756,"en":"If your champion's life is hard pressed,"},{"id":"manas-2010:p1262:b001:l019","ordinal":54757,"en":"The provisions I gave as a gift,"},{"id":"manas-2010:p1262:b001:l020","ordinal":54758,"en":"Remember them!’ Had she not told him?"},{"id":"manas-2010:p1262:b001:l021","ordinal":54759,"en":"They took the lasting travel provisions,"},{"id":"manas-2010:p1262:b001:l022","ordinal":54760,"en":"Broke off lumps the size of knucklebones,"},{"id":"manas-2010:p1262:b001:l023","ordinal":54761,"en":"And put them in their traveling bowls."},{"id":"manas-2010:p1262:b001:l024","ordinal":54762,"en":"Six bowls each, seven bowls,"},{"id":"manas-2010:p1262:b001:l025","ordinal":54763,"en":"They swallowed again and again."},{"id":"manas-2010:p1262:b001:l026","ordinal":54764,"en":"Their aching places grew quiet;"},{"id":"manas-2010:p1262:b001:l027","ordinal":54765,"en":"Their eyes opened fully, clear and awake."},{"id":"manas-2010:p1262:b001:l028","ordinal":54766,"en":"They regained their strength;"},{"id":"manas-2010:p1262:b001:l029","ordinal":54767,"en":"Like newborn children,"},{"id":"manas-2010:p1262:b001:l030","ordinal":54768,"en":"They became safe and sound."},{"id":"manas-2010:p1262:b001:l031","ordinal":54769,"en":"Talking till their words were satisfied,"},{"id":"manas-2010:p1262:b001:l032","ordinal":54770,"en":"Both the steeds"},{"id":"manas-2010:p1262:b001:l033","ordinal":54771,"en":"They let graze upon the charm herb."},{"id":"manas-2010:p1262:b001:l034","ordinal":54772,"en":"When they grazed upon the charm herb,"},{"id":"manas-2010:p1262:b001:l035","ordinal":54773,"en":"The horses grew spirited and responsive,"},{"id":"manas-2010:p1262:b001:l036","ordinal":54774,"en":"As though newly arrived from Talas."},{"id":"manas-2010:p1262:b001:l037","ordinal":54775,"en":"Their flesh restored, they pranced,"},{"id":"manas-2010:p1262:b001:l038","ordinal":54776,"en":"Looked to either side,"},{"id":"manas-2010:p1262:b001:l039","ordinal":54777,"en":"Poised like darting snakes."},{"id":"manas-2010:p1262:b001:l040","ordinal":54778,"en":"If a fly flew, they frisked;"},{"id":"manas-2010:p1262:b001:l041","ordinal":54779,"en":"If released, they would not graze;"},{"id":"manas-2010:p1262:b001:l042","ordinal":54780,"en":"If tied, they would not stand still,"},{"id":"manas-2010:p1263:b001:l001","ordinal":54781,"en":"Almambet and Syrgak together,"},{"id":"manas-2010:p1263:b001:l002","ordinal":54782,"en":"Reckoning the days,"},{"id":"manas-2010:p1263:b001:l003","ordinal":54783,"en":"Making their calculations:"},{"id":"manas-2010:p1263:b001:l004","ordinal":54784,"en":"“When we left Talas,"}]
