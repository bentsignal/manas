[{"id":"semetey-2-2013:p1415:b003:l011","ordinal":294657,"en":"And gouged his right shoulder."},{"id":"semetey-2-2013:p1415:b003:l012","ordinal":294658,"en":"When sixty women and widowed sisters-in-law"},{"id":"semetey-2-2013:p1415:b003:l013","ordinal":294659,"en":"Were violently plundered,"},{"id":"semetey-2-2013:p1415:b003:l014","ordinal":294660,"en":"The hero Kutu of the Zhediger,"},{"id":"semetey-2-2013:p1415:b003:l015","ordinal":294661,"en":"A man of honest heart,"},{"id":"semetey-2-2013:p1415:b003:l016","ordinal":294662,"en":"Without letting any person know,"},{"id":"semetey-2-2013:p1415:b003:l017","ordinal":294663,"en":"Without letting anyone touch it,"},{"id":"semetey-2-2013:p1415:b003:l018","ordinal":294664,"en":"Without letting anyone consume it,"},{"id":"semetey-2-2013:p1415:b003:l019","ordinal":294665,"en":"Without letting it be called another's booty,"},{"id":"semetey-2-2013:p1415:b003:l020","ordinal":294666,"en":"Dressed Karadöö in the bulletproof mail"},{"id":"semetey-2-2013:p1415:b003:l021","ordinal":294667,"en":"The gray steed no bullet could reach,"},{"id":"semetey-2-2013:p1415:b003:l022","ordinal":294668,"en":"He mounted Karadöö upon it."},{"id":"semetey-2-2013:p1415:b003:l023","ordinal":294669,"en":"Thus the hero Kutu took him in,"},{"id":"semetey-2-2013:p1415:b003:l024","ordinal":294670,"en":"Named him Karadöö,"},{"id":"semetey-2-2013:p1415:b003:l025","ordinal":294671,"en":"And raised him."},{"id":"semetey-2-2013:p1415:b003:l026","ordinal":294672,"en":"Look upon Karadöö!"},{"id":"semetey-2-2013:p1415:b003:l027","ordinal":294673,"en":"If you ask about Karadöö,"},{"id":"semetey-2-2013:p1415:b003:l028","ordinal":294674,"en":"He was the very son of the hero Kutu."},{"id":"semetey-2-2013:p1415:b003:l029","ordinal":294675,"en":"There is much that could be told;"},{"id":"semetey-2-2013:p1415:b003:l030","ordinal":294676,"en":"Within Karadöö"},{"id":"semetey-2-2013:p1415:b003:l031","ordinal":294677,"en":"Were words as vast as Alaskar Mountain."},{"id":"semetey-2-2013:p1415:b003:l032","ordinal":294678,"en":"If you ask about Karadöö,"},{"id":"semetey-2-2013:p1415:b003:l033","ordinal":294679,"en":"Common iron is not keen steel,"},{"id":"semetey-2-2013:p1415:b003:l034","ordinal":294680,"en":"And a falcon raised elsewhere is no true kinsman."},{"id":"semetey-2-2013:p1415:b003:l035","ordinal":294681,"en":"If you ask about Karagul,"},{"id":"semetey-2-2013:p1415:b003:l036","ordinal":294682,"en":"Ambush lay within his words,"},{"id":"semetey-2-2013:p1415:b003:l037","ordinal":294683,"en":"And mischief moved in his eyes."},{"id":"semetey-2-2013:p1415:b003:l038","ordinal":294684,"en":"Malice moved in his eyes,"},{"id":"semetey-2-2013:p1415:b003:l039","ordinal":294685,"en":"Crookedness dwelt within him,"},{"id":"semetey-2-2013:p1415:b004:l001","ordinal":294686,"en":"And his gaze was askew."},{"id":"semetey-2-2013:p1415:b004:l002","ordinal":294687,"en":"If Karadöö found the opportunity,"},{"id":"semetey-2-2013:p1415:b004:l003","ordinal":294688,"en":"He meant to strike the hero Kyyaz himself."},{"id":"semetey-2-2013:p1415:b004:l004","ordinal":294689,"en":"Then Karadöö"},{"id":"semetey-2-2013:p1415:b004:l005","ordinal":294690,"en":"Girded on a bare, sheathless sword;"},{"id":"semetey-2-2013:p1415:b004:l006","ordinal":294691,"en":"Like a cloud returning with rain,"},{"id":"semetey-2-2013:p1415:b004:l007","ordinal":294692,"en":"Wrath spread across his face."},{"id":"semetey-2-2013:p1415:b004:l008","ordinal":294693,"en":"Thick-wristed and stone-hearted,"},{"id":"semetey-2-2013:p1415:b004:l009","ordinal":294694,"en":"That perfectly built champion"},{"id":"semetey-2-2013:p1415:b004:l010","ordinal":294695,"en":"Raised his cavernous spear"},{"id":"semetey-2-2013:p1415:b004:l011","ordinal":294696,"en":"High overhead."},{"id":"semetey-2-2013:p1415:b004:l012","ordinal":294697,"en":"When he drove it home,"},{"id":"semetey-2-2013:p1415:b004:l013","ordinal":294698,"en":"He crushed a man into ground the size of a sheep;"},{"id":"semetey-2-2013:p1415:b004:l014","ordinal":294699,"en":"When he charged in close,"},{"id":"semetey-2-2013:p1415:b004:l015","ordinal":294700,"en":"He never opened his armpit in fear."},{"id":"semetey-2-2013:p1415:b004:l016","ordinal":294701,"en":"His stratagems were stern, his venom strong;"},{"id":"semetey-2-2013:p1415:b004:l017","ordinal":294702,"en":"He laid flat anyone who challenged him."},{"id":"semetey-2-2013:p1415:b004:l018","ordinal":294703,"en":"His youth was extraordinary,"},{"id":"semetey-2-2013:p1415:b004:l019","ordinal":294704,"en":"His courage immense—"},{"id":"semetey-2-2013:p1415:b004:l020","ordinal":294705,"en":"Ask no more about Karadöö!"},{"id":"semetey-2-2013:p1415:b004:l021","ordinal":294706,"en":"His tread raised dust;"},{"id":"semetey-2-2013:p1415:b004:l022","ordinal":294707,"en":"His voice drove life from men."},{"id":"semetey-2-2013:p1415:b004:l023","ordinal":294708,"en":"When he advanced he scattered nations;"},{"id":"semetey-2-2013:p1415:b004:l024","ordinal":294709,"en":"His swooping was like an eagle's."},{"id":"semetey-2-2013:p1415:b004:l025","ordinal":294710,"en":"Look upon his gray-maned valor:"},{"id":"semetey-2-2013:p1415:b004:l026","ordinal":294711,"en":"It was like the very eye of Kökchö."},{"id":"semetey-2-2013:p1415:b004:l027","ordinal":294712,"en":"Karadöö, a mass of calamity,"},{"id":"semetey-2-2013:p1415:b004:l028","ordinal":294713,"en":"Was just like Semetey himself."},{"id":"semetey-2-2013:p1415:b004:l029","ordinal":294714,"en":"His early word had come late:"},{"id":"semetey-2-2013:p1415:b004:l030","ordinal":294715,"en":"Against Kyyaz, son of Bagysh,"},{"id":"semetey-2-2013:p1415:b004:l031","ordinal":294716,"en":"He now stood ready to meet him,"},{"id":"semetey-2-2013:p1415:b004:l032","ordinal":294717,"en":"Start the conflict,"},{"id":"semetey-2-2013:p1415:b004:l033","ordinal":294718,"en":"Match him and take revenge."},{"id":"semetey-2-2013:p1415:b004:l034","ordinal":294719,"en":"If his strength sufficed, he would fight;"},{"id":"semetey-2-2013:p1415:b004:l035","ordinal":294720,"en":"Karadöö's purpose, his heart's desire,"},{"id":"semetey-2-2013:p1415:b004:l036","ordinal":294721,"en":"Was to take his distant vengeance."},{"id":"semetey-2-2013:p1415:b004:l037","ordinal":294722,"en":"He mourned Semetey,"},{"id":"semetey-2-2013:p1415:b004:l038","ordinal":294723,"en":"Would make war upon the hero Kyyaz,"},{"id":"semetey-2-2013:p1415:b004:l039","ordinal":294724,"en":"Would set Külchoro free,"},{"id":"semetey-2-2013:p1416:b003:l001","ordinal":294725,"en":"And fight Kanchoro."},{"id":"semetey-2-2013:p1416:b003:l002","ordinal":294726,"en":"In Semetey's hands"},{"id":"semetey-2-2013:p1416:b003:l003","ordinal":294727,"en":"He had been a darling to cradle."},{"id":"semetey-2-2013:p1416:b003:l004","ordinal":294728,"en":"If you ask about Karadöö,"},{"id":"semetey-2-2013:p1416:b003:l005","ordinal":294729,"en":"“What will my future be?” he wondered—"},{"id":"semetey-2-2013:p1416:b003:l006","ordinal":294730,"en":"This was the omen he chose:"},{"id":"semetey-2-2013:p1416:b003:l007","ordinal":294731,"en":"“If my divination proves true,"},{"id":"semetey-2-2013:p1416:b003:l008","ordinal":294732,"en":"I shall slaughter Küzhürmön."},{"id":"semetey-2-2013:p1416:b003:l009","ordinal":294733,"en":"If my divination is false,"},{"id":"semetey-2-2013:p1416:b003:l010","ordinal":294734,"en":"I shall die at the wrestler's hand.”"},{"id":"semetey-2-2013:p1416:b003:l011","ordinal":294735,"en":"So saying, Karadöö"},{"id":"semetey-2-2013:p1416:b003:l012","ordinal":294736,"en":"Whipped the gray five-year-old beneath him"},{"id":"semetey-2-2013:p1416:b003:l013","ordinal":294737,"en":"To right and left,"},{"id":"semetey-2-2013:p1416:b003:l014","ordinal":294738,"en":"Spurred it on both sides,"},{"id":"semetey-2-2013:p1416:b003:l015","ordinal":294739,"en":"And turned the champion steed's head."},{"id":"semetey-2-2013:p1416:b003:l016","ordinal":294740,"en":"Facing Küzhürmön,"},{"id":"semetey-2-2013:p1416:b003:l017","ordinal":294741,"en":"He thundered forward and lowered his spear."},{"id":"semetey-2-2013:p1416:b003:l018","ordinal":294742,"en":"Before anyone could say a word,"},{"id":"semetey-2-2013:p1416:b003:l019","ordinal":294743,"en":"In the blink of an eye:"},{"id":"semetey-2-2013:p1416:b003:l020","ordinal":294744,"en":"“The pommel of the Akkangky saddle—"},{"id":"semetey-2-2013:p1416:b003:l021","ordinal":294745,"en":"If my spear slips beyond it,"},{"id":"semetey-2-2013:p1416:b003:l022","ordinal":294746,"en":"Let it strike the crown of his very heart!”"},{"id":"semetey-2-2013:p1416:b003:l023","ordinal":294747,"en":"He charged and struck."},{"id":"semetey-2-2013:p1416:b003:l024","ordinal":294748,"en":"God forbid anyone should behold it:"},{"id":"semetey-2-2013:p1416:b003:l025","ordinal":294749,"en":"Dust whirled everywhere,"},{"id":"semetey-2-2013:p1416:b003:l026","ordinal":294750,"en":"And the whole arena ran with blood."},{"id":"semetey-2-2013:p1416:b003:l027","ordinal":294751,"en":"To see what would become of Karadöö,"},{"id":"semetey-2-2013:p1416:b003:l028","ordinal":294752,"en":"The people cried out and filled the ground."},{"id":"semetey-2-2013:p1416:b003:l029","ordinal":294753,"en":"Such was the deed they saw."},{"id":"semetey-2-2013:p1416:b003:l030","ordinal":294754,"en":"As the two fought with spears,"},{"id":"semetey-2-2013:p1416:b003:l031","ordinal":294755,"en":"Their spears shattered noisily;"},{"id":"semetey-2-2013:p1416:b003:l032","ordinal":294756,"en":"White splinters from the spear points"},{"id":"semetey-2-2013:p1416:b003:l033","ordinal":294757,"en":"Flew buzzing into the sky."},{"id":"semetey-2-2013:p1416:b003:l034","ordinal":294758,"en":"The brutally striking spears"},{"id":"semetey-2-2013:p1416:b003:l035","ordinal":294759,"en":"Snapped across the middle."},{"id":"semetey-2-2013:p1416:b003:l036","ordinal":294760,"en":"The stirrup straps"},{"id":"semetey-2-2013:p1416:b003:l037","ordinal":294761,"en":"Were sliced to little pieces."},{"id":"semetey-2-2013:p1416:b003:l038","ordinal":294762,"en":"Küzhürmön and Karadöö"},{"id":"semetey-2-2013:p1416:b003:l039","ordinal":294763,"en":"Fought a mighty spear contest;"},{"id":"semetey-2-2013:p1416:b004:l001","ordinal":294764,"en":"The heroes staked their lives"},{"id":"semetey-2-2013:p1416:b004:l002","ordinal":294765,"en":"And crashed against each other."},{"id":"semetey-2-2013:p1416:b004:l003","ordinal":294766,"en":"The people roared in tumult,"},{"id":"semetey-2-2013:p1416:b004:l004","ordinal":294767,"en":"The women raised a black lament."},{"id":"semetey-2-2013:p1416:b004:l005","ordinal":294768,"en":"Karadöö and Küzhürmön"},{"id":"semetey-2-2013:p1416:b004:l006","ordinal":294769,"en":"Met with spears extended;"},{"id":"semetey-2-2013:p1416:b004:l007","ordinal":294770,"en":"Neither hero retreated,"},{"id":"semetey-2-2013:p1416:b004:l008","ordinal":294771,"en":"And they smashed together."},{"id":"semetey-2-2013:p1416:b004:l009","ordinal":294772,"en":"Each sought a warrior's stratagem;"},{"id":"semetey-2-2013:p1416:b004:l010","ordinal":294773,"en":"When their spears were spent,"},{"id":"semetey-2-2013:p1416:b004:l011","ordinal":294774,"en":"They hewed at each other with battle-axes."},{"id":"semetey-2-2013:p1416:b004:l012","ordinal":294775,"en":"The Alangir bow and painted arrow—"},{"id":"semetey-2-2013:p1416:b004:l013","ordinal":294776,"en":"Told aloud, it is a dreadful tale."},{"id":"semetey-2-2013:p1416:b004:l014","ordinal":294777,"en":"All their axes shattered,"},{"id":"semetey-2-2013:p1416:b004:l015","ordinal":294778,"en":"Leaving only shafts in their hands."},{"id":"semetey-2-2013:p1416:b004:l016","ordinal":294779,"en":"The people cried out in tumult;"},{"id":"semetey-2-2013:p1416:b004:l017","ordinal":294780,"en":"The nation shouted in uproar."},{"id":"semetey-2-2013:p1416:b004:l018","ordinal":294781,"en":"The blessing of a holy man had touched him:"},{"id":"semetey-2-2013:p1416:b004:l019","ordinal":294782,"en":"The hero Kutu of the Zhediger,"},{"id":"semetey-2-2013:p1416:b004:l020","ordinal":294783,"en":"Karadöö's adoptive father,"},{"id":"semetey-2-2013:p1416:b004:l021","ordinal":294784,"en":"Galloped the Surbuzul forward,"},{"id":"semetey-2-2013:p1416:b004:l022","ordinal":294785,"en":"Turned toward Karadöö,"},{"id":"semetey-2-2013:p1416:b004:l023","ordinal":294786,"en":"And handed him a fresh spear:"},{"id":"semetey-2-2013:p1416:b004:l024","ordinal":294787,"en":"“The fur collar of my coat,"},{"id":"semetey-2-2013:p1416:b004:l025","ordinal":294788,"en":"My foal, hero Karadöö!"},{"id":"semetey-2-2013:p1416:b004:l026","ordinal":294789,"en":"Be among those who survive;"},{"id":"semetey-2-2013:p1416:b004:l027","ordinal":294790,"en":"Fight the mighty wrestler Küzhürmön"},{"id":"semetey-2-2013:p1416:b004:l028","ordinal":294791,"en":"Without rest for seven days!"},{"id":"semetey-2-2013:p1416:b004:l029","ordinal":294792,"en":"If you are a hero, be a bullet;"},{"id":"semetey-2-2013:p1416:b004:l030","ordinal":294793,"en":"If you are brave, be fierce!"},{"id":"semetey-2-2013:p1416:b004:l031","ordinal":294794,"en":"Stand firm and give no ground;"},{"id":"semetey-2-2013:p1416:b004:l032","ordinal":294795,"en":"Strive for honor and every stratagem."},{"id":"semetey-2-2013:p1416:b004:l033","ordinal":294796,"en":"Ah, Karadöö, my foal,"},{"id":"semetey-2-2013:p1416:b004:l034","ordinal":294797,"en":"A bay colt fit for pursuit"},{"id":"semetey-2-2013:p1416:b004:l035","ordinal":294798,"en":"Is not born from an ordinary mare;"},{"id":"semetey-2-2013:p1416:b004:l036","ordinal":294799,"en":"When your father grows forlorn,"},{"id":"semetey-2-2013:p1416:b004:l037","ordinal":294800,"en":"No son like you, Karadöö, will be born."},{"id":"semetey-2-2013:p1416:b004:l038","ordinal":294801,"en":"Stand face to face,"},{"id":"semetey-2-2013:p1416:b004:l039","ordinal":294802,"en":"And strike your pole with all your might!"},{"id":"semetey-2-2013:p1417:b003:l001","ordinal":294803,"en":"When the great multitude of Zhediger"},{"id":"semetey-2-2013:p1417:b003:l002","ordinal":294804,"en":"Looks upon your spectacle,"},{"id":"semetey-2-2013:p1417:b003:l003","ordinal":294805,"en":"May the spear you thrust shatter;"},{"id":"semetey-2-2013:p1417:b003:l004","ordinal":294806,"en":"May the champion horse you strike squarely"},{"id":"semetey-2-2013:p1417:b003:l005","ordinal":294807,"en":"Fall stretched upon its belly."},{"id":"semetey-2-2013:p1417:b003:l006","ordinal":294808,"en":"When you advance and strike firmly,"},{"id":"semetey-2-2013:p1417:b003:l007","ordinal":294809,"en":"May the spear be hung up for measuring."},{"id":"semetey-2-2013:p1417:b003:l008","ordinal":294810,"en":"Let your fame spread openly"},{"id":"semetey-2-2013:p1417:b003:l009","ordinal":294811,"en":"Through the people, my foal:"},{"id":"semetey-2-2013:p1417:b003:l010","ordinal":294812,"en":"‘Kutu's son is mighty!’"},{"id":"semetey-2-2013:p1417:b003:l011","ordinal":294813,"en":"Let old men and all who see him"},{"id":"semetey-2-2013:p1417:b003:l012","ordinal":294814,"en":"Despair of their lives,"},{"id":"semetey-2-2013:p1417:b003:l013","ordinal":294815,"en":"Saying, ‘Küzhürmön is a wrestler!’"},{"id":"semetey-2-2013:p1417:b003:l014","ordinal":294816,"en":"You are alone—be fierce;"},{"id":"semetey-2-2013:p1417:b003:l015","ordinal":294817,"en":"Let the multitude despair of life."},{"id":"semetey-2-2013:p1417:b003:l016","ordinal":294818,"en":"Though poor, be generous;"},{"id":"semetey-2-2013:p1417:b003:l017","ordinal":294819,"en":"Be sudden enough to scorch stone,"},{"id":"semetey-2-2013:p1417:b003:l018","ordinal":294820,"en":"And let the rich despair of life."},{"id":"semetey-2-2013:p1417:b003:l019","ordinal":294821,"en":"If you are a hero, be a wrestler;"},{"id":"semetey-2-2013:p1417:b003:l020","ordinal":294822,"en":"Let the khan despair of life."},{"id":"semetey-2-2013:p1417:b003:l021","ordinal":294823,"en":"When you thrust, thrust firmly;"},{"id":"semetey-2-2013:p1417:b003:l022","ordinal":294824,"en":"Take aim and spear Küzhürmön."},{"id":"semetey-2-2013:p1417:b003:l023","ordinal":294825,"en":"Let him spend his wrathful strength;"},{"id":"semetey-2-2013:p1417:b003:l024","ordinal":294826,"en":"Let Küzhürmön, who entered for the prize,"},{"id":"semetey-2-2013:p1417:b003:l025","ordinal":294827,"en":"Cast away all care for life."},{"id":"semetey-2-2013:p1417:b003:l026","ordinal":294828,"en":"Küzhürmön, who boasts of courage—"},{"id":"semetey-2-2013:p1417:b003:l027","ordinal":294829,"en":"That champion famous among the people,"},{"id":"semetey-2-2013:p1417:b003:l028","ordinal":294830,"en":"Bull-chested and rash-tempered,"},{"id":"semetey-2-2013:p1417:b003:l029","ordinal":294831,"en":"That swaggering man swollen with pride—"},{"id":"semetey-2-2013:p1417:b003:l030","ordinal":294832,"en":"Spear him squarely and strike true;"},{"id":"semetey-2-2013:p1417:b003:l031","ordinal":294833,"en":"Take aim, seize him, and strike firmly!"},{"id":"semetey-2-2013:p1417:b003:l032","ordinal":294834,"en":"Let them shout, ‘Küzhürmön has flown from his horse!’"},{"id":"semetey-2-2013:p1417:b003:l033","ordinal":294835,"en":"Let the Kyrgyz carry this tale,"},{"id":"semetey-2-2013:p1417:b003:l034","ordinal":294836,"en":"The people shouting in excitement;"},{"id":"semetey-2-2013:p1417:b003:l035","ordinal":294837,"en":"Let your strength and courage"},{"id":"semetey-2-2013:p1417:b003:l036","ordinal":294838,"en":"Please the gathered nation."},{"id":"semetey-2-2013:p1417:b003:l037","ordinal":294839,"en":"Let it become a tale among all the people."},{"id":"semetey-2-2013:p1417:b003:l038","ordinal":294840,"en":"Extend your spear and hold your guard;"},{"id":"semetey-2-2013:p1417:b003:l039","ordinal":294841,"en":"Do not flounder, my foal,"},{"id":"semetey-2-2013:p1417:b005:l001","ordinal":294842,"en":"Hold your body firmly and do not hurry."},{"id":"semetey-2-2013:p1417:b005:l002","ordinal":294843,"en":"May Küzhürmön's strength depart"},{"id":"semetey-2-2013:p1417:b005:l003","ordinal":294844,"en":"And his clothes and armor come apart;"},{"id":"semetey-2-2013:p1417:b005:l004","ordinal":294845,"en":"Let Kutu's son be revealed,"},{"id":"semetey-2-2013:p1417:b005:l005","ordinal":294846,"en":"And Küzhürmön called a clumsy wrestler!"},{"id":"semetey-2-2013:p1417:b005:l006","ordinal":294847,"en":"Hero, add the gray kulan to the herd;"},{"id":"semetey-2-2013:p1417:b005:l007","ordinal":294848,"en":"In your father's old age,"},{"id":"semetey-2-2013:p1417:b005:l008","ordinal":294849,"en":"Let him be counted among men"},{"id":"semetey-2-2013:p1417:b005:l009","ordinal":294850,"en":"By being called the father of a wrestler!”"},{"id":"semetey-2-2013:p1417:b005:l010","ordinal":294851,"en":"Kutu came and spoke these words,"},{"id":"semetey-2-2013:p1417:b005:l011","ordinal":294852,"en":"A wondrous marvel to those who understood,"},{"id":"semetey-2-2013:p1417:b005:l012","ordinal":294853,"en":"And placed the spear in his hand."},{"id":"semetey-2-2013:p1417:b005:l013","ordinal":294854,"en":"Karadöö set out on his course."},{"id":"semetey-2-2013:p1417:b005:l014","ordinal":294855,"en":"When his father Kutu had spoken,"},{"id":"semetey-2-2013:p1417:b005:l015","ordinal":294856,"en":"Delivered his words and turned back,"},{"id":"semetey-2-2013:p1417:b005:l016","ordinal":294857,"en":"Karadöö inherited those words."},{"id":"semetey-2-2013:p1417:b005:l017","ordinal":294858,"en":"Such was Karadöö's way:"},{"id":"semetey-2-2013:p1417:b005:l018","ordinal":294859,"en":"Without looking around,"},{"id":"semetey-2-2013:p1417:b005:l019","ordinal":294860,"en":"Before the teeming Zhediger people,"},{"id":"semetey-2-2013:p1417:b005:l020","ordinal":294861,"en":"He spared his life for nothing."},{"id":"semetey-2-2013:p1417:b005:l021","ordinal":294862,"en":"Karadöö gathered his strength;"},{"id":"semetey-2-2013:p1417:b005:l022","ordinal":294863,"en":"Sparks flew from his great nostrils,"},{"id":"semetey-2-2013:p1417:b005:l023","ordinal":294864,"en":"And fire flashed from both eyes."},{"id":"semetey-2-2013:p1417:b005:l024","ordinal":294865,"en":"“Will this wretched soul not see"},{"id":"semetey-2-2013:p1417:b005:l025","ordinal":294866,"en":"The decree written upon its brow?"},{"id":"semetey-2-2013:p1417:b005:l026","ordinal":294867,"en":"When its days and water are exhausted,"},{"id":"semetey-2-2013:p1417:b005:l027","ordinal":294868,"en":"Does a person not die in the end?"},{"id":"semetey-2-2013:p1417:b005:l028","ordinal":294869,"en":"Against thundering Küzhürmön"},{"id":"semetey-2-2013:p1417:b005:l029","ordinal":294870,"en":"I shall thrust my spear with all my might;"},{"id":"semetey-2-2013:p1417:b005:l030","ordinal":294871,"en":"Against the wrestler who boasts of strength,"},{"id":"semetey-2-2013:p1417:b005:l031","ordinal":294872,"en":"I shall clash and fight with the spear"},{"id":"semetey-2-2013:p1417:b005:l032","ordinal":294873,"en":"And win one prize from him."},{"id":"semetey-2-2013:p1417:b005:l033","ordinal":294874,"en":"If I cannot do that, this wretched soul"},{"id":"semetey-2-2013:p1417:b005:l034","ordinal":294875,"en":"Shall face a wrestler like Küzhürmön"},{"id":"semetey-2-2013:p1417:b005:l035","ordinal":294876,"en":"And be cast down."},{"id":"semetey-2-2013:p1417:b005:l036","ordinal":294877,"en":"I shall dart like a merlin,"},{"id":"semetey-2-2013:p1417:b005:l037","ordinal":294878,"en":"Come out along his flank,"},{"id":"semetey-2-2013:p1417:b005:l038","ordinal":294879,"en":"And drive Küzhürmön, the people's wrestler,"},{"id":"semetey-2-2013:p1418:b003:l001","ordinal":294880,"en":"Headfirst into a pit.”"},{"id":"semetey-2-2013:p1418:b003:l002","ordinal":294881,"en":"So saying, Karadöö"},{"id":"semetey-2-2013:p1418:b003:l003","ordinal":294882,"en":"Turned the gray champion steed's head."},{"id":"semetey-2-2013:p1418:b003:l004","ordinal":294883,"en":"“The face of the elbow,"},{"id":"semetey-2-2013:p1418:b003:l005","ordinal":294884,"en":"The vulnerable dark ribs,"},{"id":"semetey-2-2013:p1418:b003:l006","ordinal":294885,"en":"The middle between them—"},{"id":"semetey-2-2013:p1418:b003:l007","ordinal":294886,"en":"That is the place to spear."},{"id":"semetey-2-2013:p1418:b003:l008","ordinal":294887,"en":"Unless Küzhürmön is a mountain,"},{"id":"semetey-2-2013:p1418:b003:l009","ordinal":294888,"en":"He cannot withstand the spear;"},{"id":"semetey-2-2013:p1418:b003:l010","ordinal":294889,"en":"This is the moment he will tumble.”"},{"id":"semetey-2-2013:p1418:b003:l011","ordinal":294890,"en":"With speed beyond reckoning,"},{"id":"semetey-2-2013:p1418:b003:l012","ordinal":294891,"en":"He reached him in a flash;"},{"id":"semetey-2-2013:p1418:b003:l013","ordinal":294892,"en":"Karadöö struck Küzhürmön"},{"id":"semetey-2-2013:p1418:b003:l014","ordinal":294893,"en":"And drove past with a booming blow."},{"id":"semetey-2-2013:p1418:b003:l015","ordinal":294894,"en":"From the place he had struck,"},{"id":"semetey-2-2013:p1418:b003:l016","ordinal":294895,"en":"Strips of fine cloth streamed out."},{"id":"semetey-2-2013:p1418:b003:l017","ordinal":294896,"en":"The people cried out in tumult"},{"id":"semetey-2-2013:p1418:b003:l018","ordinal":294897,"en":"And rejoiced for Karadöö."},{"id":"semetey-2-2013:p1418:b003:l019","ordinal":294898,"en":"The boastful Küzhürmön,"},{"id":"semetey-2-2013:p1418:b003:l020","ordinal":294899,"en":"Like a mountain falling,"},{"id":"semetey-2-2013:p1418:b003:l021","ordinal":294900,"en":"Was hurled from his champion steed"},{"id":"semetey-2-2013:p1418:b003:l022","ordinal":294901,"en":"And lay stretched along the earth."},{"id":"semetey-2-2013:p1418:b003:l023","ordinal":294902,"en":"He fell sprawling headlong"},{"id":"semetey-2-2013:p1418:b003:l024","ordinal":294903,"en":"And drove into the arena floor."},{"id":"semetey-2-2013:p1418:b003:l025","ordinal":294904,"en":"When Küzhürmön came off his horse,"},{"id":"semetey-2-2013:p1418:b003:l026","ordinal":294905,"en":"The people cried, “Karadöö has won!”"},{"id":"semetey-2-2013:p1418:b003:l027","ordinal":294906,"en":"The crowd roared in uproar,"},{"id":"semetey-2-2013:p1418:b003:l028","ordinal":294907,"en":"A tumult that split the sky."},{"id":"semetey-2-2013:p1418:b003:l029","ordinal":294908,"en":"Karadöö, son of the hero Kutu,"},{"id":"semetey-2-2013:p1418:b003:l030","ordinal":294909,"en":"Made his wrestling strength known;"},{"id":"semetey-2-2013:p1418:b003:l031","ordinal":294910,"en":"The people despaired for their lives,"},{"id":"semetey-2-2013:p1418:b003:l032","ordinal":294911,"en":"Saying he was a formidable hero."},{"id":"semetey-2-2013:p1418:b003:l033","ordinal":294912,"en":"“A broad-trousered, wide-chested"}]
