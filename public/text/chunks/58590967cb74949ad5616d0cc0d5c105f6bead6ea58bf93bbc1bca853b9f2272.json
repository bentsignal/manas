[{"id":"manas-2010:p0848:b001:l017","ordinal":37377,"en":"Summoning the great throng,"},{"id":"manas-2010:p0848:b001:l018","ordinal":37378,"en":"Akbaltay in his old age,"},{"id":"manas-2010:p0848:b001:l019","ordinal":37379,"en":"When he had reached eighty-four,"},{"id":"manas-2010:p0848:b001:l020","ordinal":37380,"en":"Had turned his face toward God."},{"id":"manas-2010:p0848:b001:l021","ordinal":37381,"en":"“My chief wife has borne a son!”"},{"id":"manas-2010:p0848:b001:l022","ordinal":37382,"en":"He proclaimed aloud."},{"id":"manas-2010:p0848:b001:l023","ordinal":37383,"en":"“A spring that rises in a valley,"},{"id":"manas-2010:p0848:b001:l024","ordinal":37384,"en":"A little one granted at death's door!"},{"id":"manas-2010:p0848:b001:l025","ordinal":37385,"en":"My beloved people,"},{"id":"manas-2010:p0848:b001:l026","ordinal":37386,"en":"Having been childless before,"},{"id":"manas-2010:p0848:b001:l027","ordinal":37387,"en":"I have been granted a child"},{"id":"manas-2010:p0848:b001:l028","ordinal":37388,"en":"At exactly eighty-four years of age."},{"id":"manas-2010:p0848:b001:l029","ordinal":37389,"en":"For this child I have seen at death's door,"},{"id":"manas-2010:p0848:b001:l030","ordinal":37390,"en":"My beloved people,"},{"id":"manas-2010:p0848:b001:l031","ordinal":37391,"en":"Choose a name."},{"id":"manas-2010:p0848:b001:l032","ordinal":37392,"en":"Sixty gifts, headed by a horse—"},{"id":"manas-2010:p0848:b001:l033","ordinal":37393,"en":"Whoever names him, take them,"},{"id":"manas-2010:p0848:b001:l034","ordinal":37394,"en":"And live in wealth!”"},{"id":"manas-2010:p0848:b001:l035","ordinal":37395,"en":"When he spread the news, excitement rose;"},{"id":"manas-2010:p0848:b001:l036","ordinal":37396,"en":"All the people"},{"id":"manas-2010:p0848:b001:l037","ordinal":37397,"en":"Had gathered there."},{"id":"manas-2010:p0848:b001:l038","ordinal":37398,"en":"White-bearded elders,"},{"id":"manas-2010:p0848:b001:l039","ordinal":37399,"en":"Those of many years,"},{"id":"manas-2010:p0848:b001:l040","ordinal":37400,"en":"Black beards and broad mustaches—"},{"id":"manas-2010:p0848:b001:l041","ordinal":37401,"en":"Every one of them assembled."},{"id":"manas-2010:p0848:b001:l042","ordinal":37402,"en":"Unable to name the child,"},{"id":"manas-2010:p0849:b001:l001","ordinal":37403,"en":"The great assembled crowd"},{"id":"manas-2010:p0849:b001:l002","ordinal":37404,"en":"Could find no one to name him."},{"id":"manas-2010:p0849:b001:l003","ordinal":37405,"en":"Their white beards gleaming,"},{"id":"manas-2010:p0849:b001:l004","ordinal":37406,"en":"The elders looked at the black-bearded men."},{"id":"manas-2010:p0849:b001:l005","ordinal":37407,"en":"All the black-bearded men"},{"id":"manas-2010:p0849:b001:l006","ordinal":37408,"en":"Looked at the youths."},{"id":"manas-2010:p0849:b001:l007","ordinal":37409,"en":"Those youths then"},{"id":"manas-2010:p0849:b001:l008","ordinal":37410,"en":"Scattered and fled together."},{"id":"manas-2010:p0849:b001:l009","ordinal":37411,"en":"With no one coming forward to name him,"},{"id":"manas-2010:p0849:b001:l010","ordinal":37412,"en":"While they stood at a loss,"},{"id":"manas-2010:p0849:b001:l011","ordinal":37413,"en":"On this side of the people,"},{"id":"manas-2010:p0849:b001:l012","ordinal":37414,"en":"At the northern edge,"},{"id":"manas-2010:p0849:b001:l013","ordinal":37415,"en":"Barefoot and bareheaded,"},{"id":"manas-2010:p0849:b001:l014","ordinal":37416,"en":"Ninety years of age,"},{"id":"manas-2010:p0849:b001:l015","ordinal":37417,"en":"With a holy staff in his hand,"},{"id":"manas-2010:p0849:b001:l016","ordinal":37418,"en":"His backside washed for prayer,"},{"id":"manas-2010:p0849:b001:l017","ordinal":37419,"en":"And faith upon his face,"},{"id":"manas-2010:p0849:b001:l018","ordinal":37420,"en":"A great old man arrived."},{"id":"manas-2010:p0849:b001:l019","ordinal":37421,"en":"He was Khizir himself;"},{"id":"manas-2010:p0849:b001:l020","ordinal":37422,"en":"To give the child a name"},{"id":"manas-2010:p0849:b001:l021","ordinal":37423,"en":"He had arrived."},{"id":"manas-2010:p0849:b001:l022","ordinal":37424,"en":"His attention was strangely drawn;"},{"id":"manas-2010:p0849:b001:l023","ordinal":37425,"en":"To Akbaltay's eyes,"},{"id":"manas-2010:p0849:b001:l024","ordinal":37426,"en":"The old man who would name the child"},{"id":"manas-2010:p0849:b001:l025","ordinal":37427,"en":"Seemed something extraordinary!"},{"id":"manas-2010:p0849:b001:l026","ordinal":37428,"en":"Facing the qibla,"},{"id":"manas-2010:p0849:b001:l027","ordinal":37429,"en":"From Markatay's hands"},{"id":"manas-2010:p0849:b001:l028","ordinal":37430,"en":"He lifted the child."},{"id":"manas-2010:p0849:b001:l029","ordinal":37431,"en":"The child spread his limbs wide,"},{"id":"manas-2010:p0849:b001:l030","ordinal":37432,"en":"As though about to apportion an inheritance."},{"id":"manas-2010:p0849:b001:l031","ordinal":37433,"en":"The holy wanderer named Khizir"},{"id":"manas-2010:p0849:b001:l032","ordinal":37434,"en":"Took that child,"},{"id":"manas-2010:p0849:b001:l033","ordinal":37435,"en":"Weighing him in both hands:"},{"id":"manas-2010:p0849:b001:l034","ordinal":37436,"en":"“Oh, Akbaltay, look!"},{"id":"manas-2010:p0849:b001:l035","ordinal":37437,"en":"Your intentions are pure."},{"id":"manas-2010:p0849:b001:l036","ordinal":37438,"en":"As I weigh him and look,"},{"id":"manas-2010:p0849:b001:l037","ordinal":37439,"en":"This is your child granted at death's door."},{"id":"manas-2010:p0849:b001:l038","ordinal":37440,"en":"Let us dispel all sorrow;"},{"id":"manas-2010:p0849:b001:l039","ordinal":37441,"en":"Let us name the child."},{"id":"manas-2010:p0849:b001:l040","ordinal":37442,"en":"Akbaltay's lion—"},{"id":"manas-2010:p0849:b001:l041","ordinal":37443,"en":"Let his name be Chubak the warrior;"},{"id":"manas-2010:p0849:b001:l042","ordinal":37444,"en":"May those he spears number ninety thousand,"},{"id":"manas-2010:p0850:b001:l001","ordinal":37445,"en":"May his distinction resound among the people!"},{"id":"manas-2010:p0850:b001:l002","ordinal":37446,"en":"Cast into fire, may he not burn;"},{"id":"manas-2010:p0850:b001:l003","ordinal":37447,"en":"Cast into water, may he not sink."},{"id":"manas-2010:p0850:b001:l004","ordinal":37448,"en":"May no mortal cause him harm;"},{"id":"manas-2010:p0850:b001:l005","ordinal":37449,"en":"May none who face him survive!"},{"id":"manas-2010:p0850:b001:l006","ordinal":37450,"en":"May no man's strength prevail against him;"},{"id":"manas-2010:p0850:b001:l007","ordinal":37451,"en":"May no lion's teeth pierce him!"},{"id":"manas-2010:p0850:b001:l008","ordinal":37452,"en":"Whoever confronts this child,"},{"id":"manas-2010:p0850:b001:l009","ordinal":37453,"en":"Whoever clashes with him, may he become black earth."},{"id":"manas-2010:p0850:b001:l010","ordinal":37454,"en":"His uproar will never cease;"},{"id":"manas-2010:p0850:b001:l011","ordinal":37455,"en":"Let his name be Chubak the warrior!"},{"id":"manas-2010:p0850:b001:l012","ordinal":37456,"en":"I have named the child."},{"id":"manas-2010:p0850:b001:l013","ordinal":37457,"en":"These words shall not be idle:"},{"id":"manas-2010:p0850:b001:l014","ordinal":37458,"en":"When he reaches twelve,"},{"id":"manas-2010:p0850:b001:l015","ordinal":37459,"en":"This son of yours, named Chubak,"},{"id":"manas-2010:p0850:b001:l016","ordinal":37460,"en":"Will be lion Manas's companion."},{"id":"manas-2010:p0850:b001:l017","ordinal":37461,"en":"He will fight Kakan-Chyn;"},{"id":"manas-2010:p0850:b001:l018","ordinal":37462,"en":"He will be Bakburchun's enemy."},{"id":"manas-2010:p0850:b001:l019","ordinal":37463,"en":"Let no mortal confront him;"},{"id":"manas-2010:p0850:b001:l020","ordinal":37464,"en":"May none who face him survive."},{"id":"manas-2010:p0850:b001:l021","ordinal":37465,"en":"He is the champion, he is the lion;"},{"id":"manas-2010:p0850:b001:l022","ordinal":37466,"en":"The one who throws the whole world into turmoil"},{"id":"manas-2010:p0850:b001:l023","ordinal":37467,"en":"Is lion Chubak the warrior."},{"id":"manas-2010:p0850:b001:l024","ordinal":37468,"en":"When he reaches twelve,"},{"id":"manas-2010:p0850:b001:l025","ordinal":37469,"en":"Let him go and settle in Talas;"},{"id":"manas-2010:p0850:b001:l026","ordinal":37470,"en":"Let him be a companion to Manas!”"},{"id":"manas-2010:p0850:b001:l027","ordinal":37471,"en":"So spoke the holy wanderer,"},{"id":"manas-2010:p0850:b001:l028","ordinal":37472,"en":"Stroking his forehead three times."},{"id":"manas-2010:p0850:b001:l029","ordinal":37473,"en":"The people now thronged around;"},{"id":"manas-2010:p0850:b001:l030","ordinal":37474,"en":"Giving the child to Baltay,"},{"id":"manas-2010:p0850:b001:l031","ordinal":37475,"en":"The wanderer who had named him"},{"id":"manas-2010:p0850:b001:l032","ordinal":37476,"en":"Vanished from sight."},{"id":"manas-2010:p0850:b001:l033","ordinal":37477,"en":"Akbaltay, granted a child,"},{"id":"manas-2010:p0850:b001:l034","ordinal":37478,"en":"Scattered all he had and grew resolute."},{"id":"manas-2010:p0850:b001:l035","ordinal":37479,"en":"“Akbaltay's Chubak,” they said,"},{"id":"manas-2010:p0850:b001:l036","ordinal":37480,"en":"“The little one who upsets the world!”"},{"id":"manas-2010:p0850:b001:l037","ordinal":37481,"en":"His formidable name became renowned."},{"id":"manas-2010:p0850:b001:l038","ordinal":37482,"en":"For Chubak, now given a name,"},{"id":"manas-2010:p0850:b001:l039","ordinal":37483,"en":"They hung an amulet around his neck."},{"id":"manas-2010:p0850:b001:l040","ordinal":37484,"en":"His sixty stepmothers"},{"id":"manas-2010:p0850:b001:l041","ordinal":37485,"en":"Cherished, tended, and raised him."},{"id":"manas-2010:p0850:b001:l042","ordinal":37486,"en":"When he reached six—"},{"id":"manas-2010:p0851:b001:l001","ordinal":37487,"en":"He emerged as a burning ember."},{"id":"manas-2010:p0851:b001:l002","ordinal":37488,"en":"For unruliness, this Chubak"},{"id":"manas-2010:p0851:b001:l003","ordinal":37489,"en":"Had no equal among the Noygut people."},{"id":"manas-2010:p0851:b001:l004","ordinal":37490,"en":"In fights he killed children,"},{"id":"manas-2010:p0851:b001:l005","ordinal":37491,"en":"And troubled Baltay."},{"id":"manas-2010:p0851:b001:l006","ordinal":37492,"en":"“My Chubak is nothing but turmoil;"},{"id":"manas-2010:p0851:b001:l007","ordinal":37493,"en":"Someone will cast the evil eye on him,” he said."},{"id":"manas-2010:p0851:b001:l008","ordinal":37494,"en":"Lamenting every day,"},{"id":"manas-2010:p0851:b001:l009","ordinal":37495,"en":"When he rose in the morning,"},{"id":"manas-2010:p0851:b001:l010","ordinal":37496,"en":"He duly performed the rites."},{"id":"manas-2010:p0851:b001:l011","ordinal":37497,"en":"Six black bulls"},{"id":"manas-2010:p0851:b001:l012","ordinal":37498,"en":"He would have cut to pieces."},{"id":"manas-2010:p0851:b001:l013","ordinal":37499,"en":"For Chubak's sake, Baltay's"},{"id":"manas-2010:p0851:b001:l014","ordinal":37500,"en":"Countless livestock were consumed."},{"id":"manas-2010:p0851:b001:l015","ordinal":37501,"en":"Though his countless livestock were consumed,"},{"id":"manas-2010:p0851:b001:l016","ordinal":37502,"en":"“Keep my only son safe,”"},{"id":"manas-2010:p0851:b001:l017","ordinal":37503,"en":"His father Akbaltay"},{"id":"manas-2010:p0851:b001:l018","ordinal":37504,"en":"Would pray to God."},{"id":"manas-2010:p0851:b001:l019","ordinal":37505,"en":"He who threw the world's people into turmoil—"},{"id":"manas-2010:p0851:b001:l020","ordinal":37506,"en":"Such was the origin"},{"id":"manas-2010:p0851:b001:l021","ordinal":37507,"en":"Of Chubak, Akbaltay's son."},{"id":"manas-2010:p0851:b001:l022","ordinal":37508,"en":"That Chubak was no common fellow."},{"id":"manas-2010:p0851:b001:l023","ordinal":37509,"en":"Of the little one who upset the world,"},{"id":"manas-2010:p0851:b001:l024","ordinal":37510,"en":"Baltay had seen the unruliness."},{"id":"manas-2010:p0851:b001:l025","ordinal":37511,"en":"When he reached six,"},{"id":"manas-2010:p0851:b001:l026","ordinal":37512,"en":"His father Akbaltay,"},{"id":"manas-2010:p0851:b001:l027","ordinal":37513,"en":"Down in the city of Mecca,"},{"id":"manas-2010:p0851:b001:l028","ordinal":37514,"en":"Entrusted him to a mullah."},{"id":"manas-2010:p0851:b001:l029","ordinal":37515,"en":"Those who saw his renown took fright."},{"id":"manas-2010:p0851:b001:l030","ordinal":37516,"en":"Akbaltay's Chubak"},{"id":"manas-2010:p0851:b001:l031","ordinal":37517,"en":"Under the learned scholars"},{"id":"manas-2010:p0851:b001:l032","ordinal":37518,"en":"Studied for six years."},{"id":"manas-2010:p0851:b001:l033","ordinal":37519,"en":"When he reached twelve,"},{"id":"manas-2010:p0851:b001:l034","ordinal":37520,"en":"He received a letter from the caliph;"},{"id":"manas-2010:p0851:b001:l035","ordinal":37521,"en":"Pledging himself to twelve spiritual guides,"},{"id":"manas-2010:p0851:b001:l036","ordinal":37522,"en":"He was named Illustrious Champion."},{"id":"manas-2010:p0851:b001:l037","ordinal":37523,"en":"While he was in Mecca,"},{"id":"manas-2010:p0851:b001:l038","ordinal":37524,"en":"He witnessed a deed of precious worth."},{"id":"manas-2010:p0851:b001:l039","ordinal":37525,"en":"As he slept, within his dream,"},{"id":"manas-2010:p0851:b001:l040","ordinal":37526,"en":"He found himself amid an uproar."},{"id":"manas-2010:p0851:b001:l041","ordinal":37527,"en":"Into a vast and unending"},{"id":"manas-2010:p0851:b001:l042","ordinal":37528,"en":"Tumult he had entered."},{"id":"manas-2010:p0852:b001:l001","ordinal":37529,"en":"As he looked into the tumult,"},{"id":"manas-2010:p0852:b001:l002","ordinal":37530,"en":"God put him to trial."},{"id":"manas-2010:p0852:b001:l003","ordinal":37531,"en":"Before him appeared"},{"id":"manas-2010:p0852:b001:l004","ordinal":37532,"en":"A white-bearded holy wanderer."},{"id":"manas-2010:p0852:b001:l005","ordinal":37533,"en":"Standing there, the wanderer said:"},{"id":"manas-2010:p0852:b001:l006","ordinal":37534,"en":"“God Most High created you,"},{"id":"manas-2010:p0852:b001:l007","ordinal":37535,"en":"And you were named Chubak;"},{"id":"manas-2010:p0852:b001:l008","ordinal":37536,"en":"He made you a lion to destroy the unbelievers."},{"id":"manas-2010:p0852:b001:l009","ordinal":37537,"en":"Born with surpassing fortune,"},{"id":"manas-2010:p0852:b001:l010","ordinal":37538,"en":"The warrior Manas in Talas,"},{"id":"manas-2010:p0852:b001:l011","ordinal":37539,"en":"The youngest of the six lions,"},{"id":"manas-2010:p0852:b001:l012","ordinal":37540,"en":"God's beloved mortal—"},{"id":"manas-2010:p0852:b001:l013","ordinal":37541,"en":"He made you his equal companion."},{"id":"manas-2010:p0852:b001:l014","ordinal":37542,"en":"The two of you will unite;"},{"id":"manas-2010:p0852:b001:l015","ordinal":37543,"en":"You will scatter the unbelievers' livestock,"},{"id":"manas-2010:p0852:b001:l016","ordinal":37544,"en":"And open the way for the faith of Islam."},{"id":"manas-2010:p0852:b001:l017","ordinal":37545,"en":"You will quell your enemies' pride,"},{"id":"manas-2010:p0852:b001:l018","ordinal":37546,"en":"And ease your kinsfolk's grief."},{"id":"manas-2010:p0852:b001:l019","ordinal":37547,"en":"Find him; that is the warrior Manas,"},{"id":"manas-2010:p0852:b001:l020","ordinal":37548,"en":"That is the lion born for good fortune."},{"id":"manas-2010:p0852:b001:l021","ordinal":37549,"en":"When you come into his hands,"},{"id":"manas-2010:p0852:b001:l022","ordinal":37550,"en":"He will ride far and wide;"},{"id":"manas-2010:p0852:b001:l023","ordinal":37551,"en":"Throughout the whole world"},{"id":"manas-2010:p0852:b001:l024","ordinal":37552,"en":"He will journey, visiting every part."},{"id":"manas-2010:p0852:b001:l025","ordinal":37553,"en":"No lion will remain untested against him;"},{"id":"manas-2010:p0852:b001:l026","ordinal":37554,"en":"No warrior will remain unchallenged with the spear."},{"id":"manas-2010:p0852:b001:l027","ordinal":37555,"en":"He is the lion you should seek;"},{"id":"manas-2010:p0852:b001:l028","ordinal":37556,"en":"He is the warrior who will brighten your face.”"},{"id":"manas-2010:p0852:b001:l029","ordinal":37557,"en":"Having spoken of Manas, the wanderer"},{"id":"manas-2010:p0852:b001:l030","ordinal":37558,"en":"Vanished from sight."},{"id":"manas-2010:p0852:b001:l031","ordinal":37559,"en":"When Chubak awoke with a start,"},{"id":"manas-2010:p0852:b001:l032","ordinal":37560,"en":"It was Khizir who had spoken;"},{"id":"manas-2010:p0852:b001:l033","ordinal":37561,"en":"It was God's doing;"},{"id":"manas-2010:p0852:b001:l034","ordinal":37562,"en":"It was a dream he had seen."},{"id":"manas-2010:p0852:b001:l035","ordinal":37563,"en":"Chubak did not yet know Manas,"},{"id":"manas-2010:p0852:b001:l036","ordinal":37564,"en":"Had not yet ridden as his companion,"},{"id":"manas-2010:p0852:b001:l037","ordinal":37565,"en":"Had not yet charged the enemy with a shout;"},{"id":"manas-2010:p0852:b001:l038","ordinal":37566,"en":"The peoples did not yet know Chubak."},{"id":"manas-2010:p0852:b001:l039","ordinal":37567,"en":"That Chubak grew wrathful,"},{"id":"manas-2010:p0852:b001:l040","ordinal":37568,"en":"And began an upheaval."},{"id":"manas-2010:p0852:b001:l041","ordinal":37569,"en":"Now the warrior Chubak girded himself"},{"id":"manas-2010:p0852:b001:l042","ordinal":37570,"en":"And left the city of Mecca."},{"id":"manas-2010:p0853:b001:l001","ordinal":37571,"en":"Traveling back from Mecca,"},{"id":"manas-2010:p0853:b001:l002","ordinal":37572,"en":"To his father, the champion Baltay,"},{"id":"manas-2010:p0853:b001:l003","ordinal":37573,"en":"Lion Chubak came."},{"id":"manas-2010:p0853:b001:l004","ordinal":37574,"en":"“Grown to maturity, become a warrior,"},{"id":"manas-2010:p0853:b001:l005","ordinal":37575,"en":"The equal of other warriors' sons,"},{"id":"manas-2010:p0853:b001:l006","ordinal":37576,"en":"My comfort, Chubak, has come,” he said."},{"id":"manas-2010:p0853:b001:l007","ordinal":37577,"en":"“Now God has granted my wish!”"},{"id":"manas-2010:p0853:b001:l008","ordinal":37578,"en":"His father gave an abundant feast."},{"id":"manas-2010:p0853:b001:l009","ordinal":37579,"en":"Standing rigid when his wrath arose,"},{"id":"manas-2010:p0853:b001:l010","ordinal":37580,"en":"Khan Baltay's Chubak,"},{"id":"manas-2010:p0853:b001:l011","ordinal":37581,"en":"Who would raise dust among the people,"},{"id":"manas-2010:p0853:b001:l012","ordinal":37582,"en":"Was the Illustrious Champion."},{"id":"manas-2010:p0853:b001:l013","ordinal":37583,"en":"Was Chubak's coming from the unseen in vain—"},{"id":"manas-2010:p0853:b001:l014","ordinal":37584,"en":"The companion of bloodthirsty Manas?"},{"id":"manas-2010:p0853:b001:l015","ordinal":37585,"en":"When he came to Khan Baltay,"},{"id":"manas-2010:p0853:b001:l016","ordinal":37586,"en":"That fiercely violent Chubak"},{"id":"manas-2010:p0853:b001:l017","ordinal":37587,"en":"Took Akbaltay's wealth"},{"id":"manas-2010:p0853:b001:l018","ordinal":37588,"en":"And scattered it as well."},{"id":"manas-2010:p0853:b001:l019","ordinal":37589,"en":"Though Akbaltay's vast herds"},{"id":"manas-2010:p0853:b001:l020","ordinal":37590,"en":"Were scattered to the last,"},{"id":"manas-2010:p0853:b001:l021","ordinal":37591,"en":"He never so much as frowned."},{"id":"manas-2010:p0853:b001:l022","ordinal":37592,"en":"Chubak, his only support,"},{"id":"manas-2010:p0853:b001:l023","ordinal":37593,"en":"Khan Baltay did not resent."},{"id":"manas-2010:p0853:b001:l024","ordinal":37594,"en":"The reason he did not resent him:"},{"id":"manas-2010:p0853:b001:l025","ordinal":37595,"en":"He was the spring flowing through his valley,"},{"id":"manas-2010:p0853:b001:l026","ordinal":37596,"en":"Of your dear old Baltay,"},{"id":"manas-2010:p0853:b001:l027","ordinal":37597,"en":"The little one granted at death's door."},{"id":"manas-2010:p0853:b001:l028","ordinal":37598,"en":"Distant peoples said of him:"},{"id":"manas-2010:p0853:b001:l029","ordinal":37599,"en":"“Chubak, Akbaltay's son,"},{"id":"manas-2010:p0853:b001:l030","ordinal":37600,"en":"Was hard-won by Akbaltay."},{"id":"manas-2010:p0853:b001:l031","ordinal":37601,"en":"If this child survives,"},{"id":"manas-2010:p0853:b001:l032","ordinal":37602,"en":"He will overturn the world!”"},{"id":"manas-2010:p0853:b001:l033","ordinal":37603,"en":"One day, while the warrior Chubak lay asleep,"},{"id":"manas-2010:p0853:b001:l034","ordinal":37604,"en":"He woke with a start,"},{"id":"manas-2010:p0853:b001:l035","ordinal":37605,"en":"And turned to his right."},{"id":"manas-2010:p0853:b001:l036","ordinal":37606,"en":"Toward Khan Baltay's court,"},{"id":"manas-2010:p0853:b001:l037","ordinal":37607,"en":"With his hands behind his back,"},{"id":"manas-2010:p0853:b001:l038","ordinal":37608,"en":"That splendid, swaggering warrior"},{"id":"manas-2010:p0853:b001:l039","ordinal":37609,"en":"Walked in, unperturbed,"},{"id":"manas-2010:p0853:b001:l040","ordinal":37610,"en":"Into Khan Baltay's court."},{"id":"manas-2010:p0853:b001:l041","ordinal":37611,"en":"There were khojas in white turbans;"},{"id":"manas-2010:p0853:b001:l042","ordinal":37612,"en":"There were mullahs reciting lessons;"},{"id":"manas-2010:p0854:b001:l001","ordinal":37613,"en":"There were learned scholars as well;"},{"id":"manas-2010:p0854:b001:l002","ordinal":37614,"en":"All the men of knowledge were there."},{"id":"manas-2010:p0854:b001:l003","ordinal":37615,"en":"Walking up then"},{"id":"manas-2010:p0854:b001:l004","ordinal":37616,"en":"To his father, Khan Baltay,"},{"id":"manas-2010:p0854:b001:l005","ordinal":37617,"en":"Leopard Chubak began to speak:"},{"id":"manas-2010:p0854:b001:l006","ordinal":37618,"en":"“Father, where is a mountain to batter?"},{"id":"manas-2010:p0854:b001:l007","ordinal":37619,"en":"Where is an enemy to fight?"},{"id":"manas-2010:p0854:b001:l008","ordinal":37620,"en":"Is there a pit already dug?"},{"id":"manas-2010:p0854:b001:l009","ordinal":37621,"en":"Is there brine already boiled?"},{"id":"manas-2010:p0854:b001:l010","ordinal":37622,"en":"Is there a coat for me to wear?"},{"id":"manas-2010:p0854:b001:l011","ordinal":37623,"en":"Is there an enemy for me to attack?"},{"id":"manas-2010:p0854:b001:l012","ordinal":37624,"en":"Father, Khan Baltay, think!"},{"id":"manas-2010:p0854:b001:l013","ordinal":37625,"en":"I have matured and become a warrior;"},{"id":"manas-2010:p0854:b001:l014","ordinal":37626,"en":"I am the equal of other warriors' sons."},{"id":"manas-2010:p0854:b001:l015","ordinal":37627,"en":"Finding no embers to wade through,"},{"id":"manas-2010:p0854:b001:l016","ordinal":37628,"en":"Finding no arrow to aim and shoot,"},{"id":"manas-2010:p0854:b001:l017","ordinal":37629,"en":"If you would hear my words, oh father,"},{"id":"manas-2010:p0854:b001:l018","ordinal":37630,"en":"I stand here in distress."},{"id":"manas-2010:p0854:b001:l019","ordinal":37631,"en":"In my dream I saw a wondrous thing;"},{"id":"manas-2010:p0854:b001:l020","ordinal":37632,"en":"Such a thing happens in no age."}]
