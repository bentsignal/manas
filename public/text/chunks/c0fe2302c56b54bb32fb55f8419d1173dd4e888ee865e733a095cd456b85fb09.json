[{"id":"semetey-1-2013:p0955:b003:l020","ordinal":148993,"en":"Called Elkin-Too Ata."},{"id":"semetey-1-2013:p0955:b003:l021","ordinal":148994,"en":"Its spring flowed, overflowing,"},{"id":"semetey-1-2013:p0955:b003:l022","ordinal":148995,"en":"A sorrowful mortal would weep there,"},{"id":"semetey-1-2013:p0955:b003:l023","ordinal":148996,"en":"Its nightingales sang and trilled."},{"id":"semetey-1-2013:p0955:b003:l024","ordinal":148997,"en":"Having seen many fine lands,"},{"id":"semetey-1-2013:p0955:b003:l025","ordinal":148998,"en":"Her heart filled with sorrow,"},{"id":"semetey-1-2013:p0955:b003:l026","ordinal":148999,"en":"With no living soul to listen,"},{"id":"semetey-1-2013:p0955:b003:l027","ordinal":149000,"en":"She told her grief to God:"},{"id":"semetey-1-2013:p0955:b003:l028","ordinal":149001,"en":"'Great Beijing, that distant city,"},{"id":"semetey-1-2013:p0955:b003:l029","ordinal":149002,"en":"I have wandered to its farthest end."},{"id":"semetey-1-2013:p0955:b003:l030","ordinal":149003,"en":"The infidels and Muslims,"},{"id":"semetey-1-2013:p0955:b003:l031","ordinal":149004,"en":"I have visited all their peoples,"},{"id":"semetey-1-2013:p0955:b003:l032","ordinal":149005,"en":"Finding no support in a renowned place."},{"id":"semetey-1-2013:p0955:b003:l033","ordinal":149006,"en":"Could anyone be as unfortunate as I,"},{"id":"semetey-1-2013:p0955:b003:l034","ordinal":149007,"en":"Finding no hero equal to herself?"},{"id":"semetey-1-2013:p0955:b003:l035","ordinal":149008,"en":"A white dress with a broad skirt,"},{"id":"semetey-1-2013:p0955:b003:l036","ordinal":149009,"en":"With what face could I wear it?"},{"id":"semetey-1-2013:p0955:b003:l037","ordinal":149010,"en":"To Toltoi of the Jediger,"},{"id":"semetey-1-2013:p0955:b003:l038","ordinal":149011,"en":"Calling him my true husband,"},{"id":"semetey-1-2013:p0955:b003:l039","ordinal":149012,"en":"With what face could I marry?"},{"id":"semetey-1-2013:p0955:b005:l001","ordinal":149013,"en":"Could anyone be as disgraced as I?"},{"id":"semetey-1-2013:p0955:b005:l002","ordinal":149014,"en":"Can a grieving person prosper?"},{"id":"semetey-1-2013:p0955:b005:l004","ordinal":149015,"en":"Finding no hero to marry,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0955:b005:l005","ordinal":149016,"en":"Could anyone be as disgraced as I?"},{"id":"semetey-1-2013:p0955:b005:l006","ordinal":149017,"en":"My father, Khan Akun's"},{"id":"semetey-1-2013:p0955:b005:l007","ordinal":149018,"en":"Determined enemy Chynkojo,"},{"id":"semetey-1-2013:p0955:b005:l008","ordinal":149019,"en":"Is like tempered red iron."},{"id":"semetey-1-2013:p0955:b005:l009","ordinal":149020,"en":"Aichurok, daughter of Akun,"},{"id":"semetey-1-2013:p0955:b005:l010","ordinal":149021,"en":"Truly flew in search of a hero—"},{"id":"semetey-1-2013:p0955:b005:l011","ordinal":149022,"en":"Let them not say she returned empty-handed."},{"id":"semetey-1-2013:p0955:b005:l012","ordinal":149023,"en":"How can my poor soul die?"},{"id":"semetey-1-2013:p0955:b005:l013","ordinal":149024,"en":"Where shall I find my equal?'"},{"id":"semetey-1-2013:p0955:b005:l014","ordinal":149025,"en":"Finding no husband among the giants,"},{"id":"semetey-1-2013:p0955:b005:l015","ordinal":149026,"en":"Her mind deeply troubled,"},{"id":"semetey-1-2013:p0955:b005:l016","ordinal":149027,"en":"Aichurok grieved greatly,"},{"id":"semetey-1-2013:p0955:b005:l017","ordinal":149028,"en":"Tears pouring from her eyes."},{"id":"semetey-1-2013:p0955:b005:l018","ordinal":149029,"en":"Sparing herself no effort, she traveled,"},{"id":"semetey-1-2013:p0955:b005:l019","ordinal":149030,"en":"Wandering the land again,"},{"id":"semetey-1-2013:p0955:b005:l020","ordinal":149031,"en":"Aichurok flew onward."},{"id":"semetey-1-2013:p0955:b005:l021","ordinal":149032,"en":"She crossed the ridge of Boot,"},{"id":"semetey-1-2013:p0955:b005:l022","ordinal":149033,"en":"Passed through Suusamyr."},{"id":"semetey-1-2013:p0955:b005:l025","ordinal":149034,"en":"'Let me cross Kotormo,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0955:b005:l026","ordinal":149035,"en":"Let me pass through broad Talas."},{"id":"semetey-1-2013:p0955:b005:l028","ordinal":149036,"en":"My father-in-law, gone to the other world—","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0955:b005:l030","ordinal":149037,"en":"Let me enter that noble land.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0955:b005:l031","ordinal":149038,"en":"My father-in-law, gone to the other world—"},{"id":"semetey-1-2013:p0955:b005:l032","ordinal":149039,"en":"Let me go honoring his spirit."},{"id":"semetey-1-2013:p0955:b005:l033","ordinal":149040,"en":"The Argyn and Kyrgyz,"},{"id":"semetey-1-2013:p0955:b005:l034","ordinal":149041,"en":"Let me learn what they are like."},{"id":"semetey-1-2013:p0955:b005:l035","ordinal":149042,"en":"If I draw upon tradition,"},{"id":"semetey-1-2013:p0955:b005:l036","ordinal":149043,"en":"If I ask the knowledgeable,"},{"id":"semetey-1-2013:p0955:b005:l037","ordinal":149044,"en":"When my sultan father-in-law died,"},{"id":"semetey-1-2013:p0955:b005:l038","ordinal":149045,"en":"When the people gathered and buried him,"},{"id":"semetey-1-2013:p0956:b003:l001","ordinal":149046,"en":"My mother-in-law departed in mourning,"},{"id":"semetey-1-2013:p0956:b003:l002","ordinal":149047,"en":"My own husband fled away."},{"id":"semetey-1-2013:p0956:b003:l003","ordinal":149048,"en":"Argyn and Kyrgyz, dear people—"},{"id":"semetey-1-2013:p0956:b003:l004","ordinal":149049,"en":"Let me see the people left without a master."},{"id":"semetey-1-2013:p0956:b003:l005","ordinal":149050,"en":"He who gave his hand to twelve spiritual guides,"},{"id":"semetey-1-2013:p0956:b003:l006","ordinal":149051,"en":"My father-in-law, departed as a holy man—"},{"id":"semetey-1-2013:p0956:b003:l007","ordinal":149052,"en":"Let me honor his ancestral spirit."},{"id":"semetey-1-2013:p0956:b004:l001","ordinal":149053,"en":"Let me fly down Talas"},{"id":"semetey-1-2013:p0956:b004:l002","ordinal":149054,"en":"And reach the great mausoleum;"},{"id":"semetey-1-2013:p0956:b004:l003","ordinal":149055,"en":"My father who went to the other world,"},{"id":"semetey-1-2013:p0956:b004:l004","ordinal":149056,"en":"Let me visit his tomb in reverence."},{"id":"semetey-1-2013:p0956:b004:l005","ordinal":149057,"en":"Then flying swiftly onward,"},{"id":"semetey-1-2013:p0956:b004:l006","ordinal":149058,"en":"Roaming down Ken-Kol,"},{"id":"semetey-1-2013:p0956:b004:l007","ordinal":149059,"en":"Unfortunate Aichurok arrived."},{"id":"semetey-1-2013:p0956:b006:l001","ordinal":149060,"en":"The great mausoleum in Talas—"},{"id":"semetey-1-2013:p0956:b006:l002","ordinal":149061,"en":"Beside that great mausoleum,"},{"id":"semetey-1-2013:p0956:b006:l003","ordinal":149062,"en":"For Manas, gone to the other world,"},{"id":"semetey-1-2013:p0956:b006:l004","ordinal":149063,"en":"She recited a blessing, saying, “Amen.”"},{"id":"semetey-1-2013:p0956:b006:l005","ordinal":149064,"en":"The surah called “Tappat”"},{"id":"semetey-1-2013:p0956:b006:l006","ordinal":149065,"en":"She recited astonishingly fast."},{"id":"semetey-1-2013:p0956:b006:l007","ordinal":149066,"en":"When she looked this way,"},{"id":"semetey-1-2013:p0956:b006:l008","ordinal":149067,"en":"Argyn and Kyrgyz had drawn toward the lowlands"},{"id":"semetey-1-2013:p0956:b006:l009","ordinal":149068,"en":"And were settled there."},{"id":"semetey-1-2013:p0956:b006:l010","ordinal":149069,"en":"Kumys by day, girls by night—"},{"id":"semetey-1-2013:p0956:b006:l011","ordinal":149070,"en":"Such were their days then."},{"id":"semetey-1-2013:p0956:b006:l013","ordinal":149071,"en":"They swayed about then;","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0956:b006:l014","ordinal":149072,"en":"Linked together, the Kyrgyz"},{"id":"semetey-1-2013:p0956:b006:l015","ordinal":149073,"en":"Were rejoicing then."},{"id":"semetey-1-2013:p0956:b006:l016","ordinal":149074,"en":"At that time the Kyrgyz people"},{"id":"semetey-1-2013:p0956:b006:l017","ordinal":149075,"en":"Had taken whole otter pelts"},{"id":"semetey-1-2013:p0956:b006:l018","ordinal":149076,"en":"And split them open lengthwise."},{"id":"semetey-1-2013:p0956:b006:l019","ordinal":149077,"en":"There was an orchard planted in Talas;"},{"id":"semetey-1-2013:p0956:b006:l021","ordinal":149078,"en":"At that time among the Kyrgyz,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0956:b006:l022","ordinal":149079,"en":"The poor man drove a thousand sheep,"},{"id":"semetey-1-2013:p0956:b006:l023","ordinal":149080,"en":"The old woman chewed fat tail."},{"id":"semetey-1-2013:p0956:b006:l024","ordinal":149081,"en":"Of the teeming Kyrgyz,"},{"id":"semetey-1-2013:p0956:b006:l025","ordinal":149082,"en":"What trouble of theirs should I tell?"},{"id":"semetey-1-2013:p0956:b006:l026","ordinal":149083,"en":"With ornamented hair-braids and broad hips,"},{"id":"semetey-1-2013:p0956:b006:l027","ordinal":149084,"en":"Beautiful were the Kyrgyz daughters-in-law."},{"id":"semetey-1-2013:p0956:b007:l001","ordinal":149085,"en":"In red dresses, with slender waists,"},{"id":"semetey-1-2013:p0956:b007:l002","ordinal":149086,"en":"Beautiful were the Kyrgyz girls."},{"id":"semetey-1-2013:p0956:b007:l003","ordinal":149087,"en":"In black coats and white felt hats,"},{"id":"semetey-1-2013:p0956:b007:l004","ordinal":149088,"en":"Handsome were the Kyrgyz people."},{"id":"semetey-1-2013:p0956:b007:l005","ordinal":149089,"en":"More rice than millet and barley,"},{"id":"semetey-1-2013:p0956:b007:l006","ordinal":149090,"en":"More silver than tin,"},{"id":"semetey-1-2013:p0956:b007:l007","ordinal":149091,"en":"More foxes than gray hares,"},{"id":"semetey-1-2013:p0956:b007:l008","ordinal":149092,"en":"Much property heaped at their thresholds;"},{"id":"semetey-1-2013:p0956:b007:l009","ordinal":149093,"en":"They wore fox fur and sable."},{"id":"semetey-1-2013:p0956:b007:l010","ordinal":149094,"en":"The orphan had grown to maturity,"},{"id":"semetey-1-2013:p0956:b007:l011","ordinal":149095,"en":"Joined his own people,"},{"id":"semetey-1-2013:p0956:b007:l012","ordinal":149096,"en":"And Semetey had become their leader."},{"id":"semetey-1-2013:p0956:b007:l013","ordinal":149097,"en":"Aichurok did not know this;"},{"id":"semetey-1-2013:p0956:b007:l014","ordinal":149098,"en":"She was astonished at what she saw."},{"id":"semetey-1-2013:p0956:b007:l015","ordinal":149099,"en":"Their fine men wore"},{"id":"semetey-1-2013:p0956:b007:l016","ordinal":149100,"en":"Black caps of blue lynx fur;"},{"id":"semetey-1-2013:p0956:b007:l017","ordinal":149101,"en":"All their fine men"},{"id":"semetey-1-2013:p0956:b007:l018","ordinal":149102,"en":"Were alike in their fearlessness."},{"id":"semetey-1-2013:p0956:b007:l019","ordinal":149103,"en":"They had winged steeds beneath them;"},{"id":"semetey-1-2013:p0956:b007:l020","ordinal":149104,"en":"When six or seven went together,"},{"id":"semetey-1-2013:p0956:b007:l021","ordinal":149105,"en":"They had strength to match Chynkojo."},{"id":"semetey-1-2013:p0956:b007:l022","ordinal":149106,"en":"All of them rode"},{"id":"semetey-1-2013:p0956:b007:l023","ordinal":149107,"en":"Karabair warhorses,"},{"id":"semetey-1-2013:p0956:b007:l024","ordinal":149108,"en":"With sieve-like lungs and copper forelegs."},{"id":"semetey-1-2013:p0956:b007:l025","ordinal":149109,"en":"Jilgynduu, Ken-Kol, and Talas—"},{"id":"semetey-1-2013:p0956:b007:l026","ordinal":149110,"en":"Delighted to see those lands,"},{"id":"semetey-1-2013:p0956:b007:l027","ordinal":149111,"en":"Aichurok now rejoiced."},{"id":"semetey-1-2013:p0957:b003:l001","ordinal":149112,"en":"Delighted to see her people,"},{"id":"semetey-1-2013:p0957:b003:l004","ordinal":149113,"en":"The backs of their spears were like hair-braids;","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0957:b003:l006","ordinal":149114,"en":"Aichurok was amazed:","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0957:b003:l007","ordinal":149115,"en":"“Are these my father-in-law's people?"},{"id":"semetey-1-2013:p0957:b003:l008","ordinal":149116,"en":"Let me go and see his horses."},{"id":"semetey-1-2013:p0957:b003:l009","ordinal":149117,"en":"When I learned from those who knew,"},{"id":"semetey-1-2013:p0957:b003:l010","ordinal":149118,"en":"When I asked the knowledgeable,"},{"id":"semetey-1-2013:p0957:b003:l011","ordinal":149119,"en":"Many people told me:"},{"id":"semetey-1-2013:p0957:b003:l012","ordinal":149120,"en":"‘His horses are red roans,’ they said."},{"id":"semetey-1-2013:p0957:b003:l014","ordinal":149121,"en":"All the people told me:"},{"id":"semetey-1-2013:p0957:b003:l015","ordinal":149122,"en":"‘Your father-in-law's horses"},{"id":"semetey-1-2013:p0957:b003:l016","ordinal":149123,"en":"Are dark roans,’ they said."},{"id":"semetey-1-2013:p0957:b003:l017","ordinal":149124,"en":"Let me find out truly and certainly,"},{"id":"semetey-1-2013:p0957:b003:l018","ordinal":149125,"en":"And of the noble man gone to the other world,"},{"id":"semetey-1-2013:p0957:b003:l019","ordinal":149126,"en":"Let me honor his ancestral spirit.”"},{"id":"semetey-1-2013:p0957:b003:l020","ordinal":149127,"en":"As a swan she cried hoarsely,"},{"id":"semetey-1-2013:p0957:b003:l021","ordinal":149128,"en":"Unable to see her companion clearly,"},{"id":"semetey-1-2013:p0957:b003:l022","ordinal":149129,"en":"Poor Churok fluttered gently."},{"id":"semetey-1-2013:p0957:b003:l023","ordinal":149130,"en":"In the hollow of Uch-Koshoi,"},{"id":"semetey-1-2013:p0957:b003:l024","ordinal":149131,"en":"Along Tash-Tulga,"},{"id":"semetey-1-2013:p0957:b003:l025","ordinal":149132,"en":"At Kara-Buura and Chatkal,"},{"id":"semetey-1-2013:p0957:b003:l026","ordinal":149133,"en":"Where the Argyn lay at ease,"},{"id":"semetey-1-2013:p0957:b003:l027","ordinal":149134,"en":"She saw ridge after hilly ridge,"},{"id":"semetey-1-2013:p0957:b003:l028","ordinal":149135,"en":"Saw wondrous places among the hills."},{"id":"semetey-1-2013:p0957:b003:l029","ordinal":149136,"en":"Grazing on those hills"},{"id":"semetey-1-2013:p0957:b003:l030","ordinal":149137,"en":"Were countless horses, a vast multitude."},{"id":"semetey-1-2013:p0957:b003:l031","ordinal":149138,"en":"In the hills were mottled-headed horses,"},{"id":"semetey-1-2013:p0957:b003:l032","ordinal":149139,"en":"Piebald and chestnut mixed together,"},{"id":"semetey-1-2013:p0957:b003:l033","ordinal":149140,"en":"Ash-gray ones with rings on their legs,"},{"id":"semetey-1-2013:p0957:b003:l034","ordinal":149141,"en":"Fat ones that had never been ridden."},{"id":"semetey-1-2013:p0957:b003:l035","ordinal":149142,"en":"Her gaze could not encompass them;"},{"id":"semetey-1-2013:p0957:b003:l036","ordinal":149143,"en":"The teeming multitude of horses—"},{"id":"semetey-1-2013:p0957:b003:l037","ordinal":149144,"en":"Their kinds could not be distinguished."},{"id":"semetey-1-2013:p0957:b003:l038","ordinal":149145,"en":"With stallions' manes and mares' bellies,"},{"id":"semetey-1-2013:p0957:b003:l039","ordinal":149146,"en":"One kind among those horses"},{"id":"semetey-1-2013:p0957:b004:l001","ordinal":149147,"en":"Were fully alike, all dun,"},{"id":"semetey-1-2013:p0957:b004:l002","ordinal":149148,"en":"With amulet-shaped marks upon their foreheads."},{"id":"semetey-1-2013:p0957:b004:l003","ordinal":149149,"en":"There were more geldings than stallions;"},{"id":"semetey-1-2013:p0957:b004:l004","ordinal":149150,"en":"All were renowned winged steeds,"},{"id":"semetey-1-2013:p0957:b004:l005","ordinal":149151,"en":"Karabair warhorses,"},{"id":"semetey-1-2013:p0957:b004:l006","ordinal":149152,"en":"Plainly different from ordinary livestock."},{"id":"semetey-1-2013:p0957:b004:l007","ordinal":149153,"en":"Their foals were like horses in their third year;"},{"id":"semetey-1-2013:p0957:b004:l008","ordinal":149154,"en":"Such wonderful beasts, curse them!"},{"id":"semetey-1-2013:p0957:b004:l009","ordinal":149155,"en":"No one who saw them could leave;"},{"id":"semetey-1-2013:p0957:b004:l010","ordinal":149156,"en":"Look at the kinds in that great herd."},{"id":"semetey-1-2013:p0957:b004:l011","ordinal":149157,"en":"One breed among the horses"},{"id":"semetey-1-2013:p0957:b004:l012","ordinal":149158,"en":"Was mottled yellow like starlings;"},{"id":"semetey-1-2013:p0957:b004:l013","ordinal":149159,"en":"One other part of the herd"},{"id":"semetey-1-2013:p0957:b004:l014","ordinal":149160,"en":"Was coal-black."},{"id":"semetey-1-2013:p0957:b004:l015","ordinal":149161,"en":"As she watched the horses,"},{"id":"semetey-1-2013:p0957:b004:l016","ordinal":149162,"en":"Smiling Churok was astonished."},{"id":"semetey-1-2013:p0957:b004:l017","ordinal":149163,"en":"“When we learned from those who knew,"},{"id":"semetey-1-2013:p0957:b004:l018","ordinal":149164,"en":"When we asked the knowledgeable,"},{"id":"semetey-1-2013:p0957:b004:l019","ordinal":149165,"en":"My father-in-law's horses"},{"id":"semetey-1-2013:p0957:b004:l020","ordinal":149166,"en":"Along this Talas"},{"id":"semetey-1-2013:p0957:b004:l021","ordinal":149167,"en":"Were said to be dark roans."},{"id":"semetey-1-2013:p0957:b004:l022","ordinal":149168,"en":"The horses of distinct appearance,"},{"id":"semetey-1-2013:p0957:b004:l023","ordinal":149169,"en":"That looked different from the rest—"},{"id":"semetey-1-2013:p0957:b004:l024","ordinal":149170,"en":"The leopard's horses"},{"id":"semetey-1-2013:p0957:b004:l025","ordinal":149171,"en":"Were said to be red roans."},{"id":"semetey-1-2013:p0957:b004:l026","ordinal":149172,"en":"When the leopard warrior died,"},{"id":"semetey-1-2013:p0957:b004:l027","ordinal":149173,"en":"When the people gathered and buried him,"},{"id":"semetey-1-2013:p0957:b004:l028","ordinal":149174,"en":"When they camped along the river,"},{"id":"semetey-1-2013:p0957:b004:l029","ordinal":149175,"en":"After the leopard passed away,"},{"id":"semetey-1-2013:p0957:b004:l030","ordinal":149176,"en":"Did all the mass of people"},{"id":"semetey-1-2013:p0957:b004:l031","ordinal":149177,"en":"Become as though their fire had gone out?"},{"id":"semetey-1-2013:p0957:b004:l032","ordinal":149178,"en":"Had they heard the news—"},{"id":"semetey-1-2013:p0957:b004:l033","ordinal":149179,"en":"The many Chinese, the great Manchu host—"},{"id":"semetey-1-2013:p0957:b004:l034","ordinal":149180,"en":"And overrun the place and settled here?"},{"id":"semetey-1-2013:p0957:b004:l035","ordinal":149181,"en":"Had they taken possession of his horses"},{"id":"semetey-1-2013:p0957:b004:l036","ordinal":149182,"en":"And put red stallions among them?"},{"id":"semetey-1-2013:p0957:b004:l037","ordinal":149183,"en":"Was it through this that his horses"},{"id":"semetey-1-2013:p0957:b004:l038","ordinal":149184,"en":"Had become all red?”"},{"id":"semetey-1-2013:p0957:b004:l039","ordinal":149185,"en":"Looking on, Aichurok"},{"id":"semetey-1-2013:p0958:b003:l001","ordinal":149186,"en":"Her sun grew overcast in the sky,"},{"id":"semetey-1-2013:p0958:b003:l002","ordinal":149187,"en":"Sixty cares came upon her at once;"},{"id":"semetey-1-2013:p0958:b003:l003","ordinal":149188,"en":"Her heart was torn,"},{"id":"semetey-1-2013:p0958:b003:l004","ordinal":149189,"en":"Her tears poured down."},{"id":"semetey-1-2013:p0958:b003:l005","ordinal":149190,"en":"At the sight of the horses, Churok's"},{"id":"semetey-1-2013:p0958:b003:l006","ordinal":149191,"en":"Heart was truly troubled:"},{"id":"semetey-1-2013:p0958:b003:l007","ordinal":149192,"en":"“Finding no support to rely upon,"},{"id":"semetey-1-2013:p0958:b003:l008","ordinal":149193,"en":"No mortal is as unfortunate as I,"},{"id":"semetey-1-2013:p0958:b003:l009","ordinal":149194,"en":"Searching hard and finding no husband!"},{"id":"semetey-1-2013:p0958:b003:l010","ordinal":149195,"en":"Shall I die seeking a husband?"},{"id":"semetey-1-2013:p0958:b003:l011","ordinal":149196,"en":"From Toltoi of the Jediger,"},{"id":"semetey-1-2013:p0958:b003:l012","ordinal":149197,"en":"Shall I suffer utter humiliation?"},{"id":"semetey-1-2013:p0958:b003:l013","ordinal":149198,"en":"In many places I have seen mighty men,"},{"id":"semetey-1-2013:p0958:b003:l014","ordinal":149199,"en":"Yet found no husband to my liking, all alone;"},{"id":"semetey-1-2013:p0958:b003:l015","ordinal":149200,"en":"My misery has boiled over."},{"id":"semetey-1-2013:p0958:b003:l017","ordinal":149201,"en":"With what face shall I wear it?","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0958:b003:l018","ordinal":149202,"en":"To Toltoi of the Jediger,"},{"id":"semetey-1-2013:p0958:b003:l019","ordinal":149203,"en":"As a wife taken in booty,"},{"id":"semetey-1-2013:p0958:b003:l020","ordinal":149204,"en":"With what face shall I be married?"},{"id":"semetey-1-2013:p0958:b003:l021","ordinal":149205,"en":"I have wandered through so many places;"},{"id":"semetey-1-2013:p0958:b003:l022","ordinal":149206,"en":"How can I go on without finding a husband?”"},{"id":"semetey-1-2013:p0958:b003:l023","ordinal":149207,"en":"Her thoughts badly troubled,"},{"id":"semetey-1-2013:p0958:b003:l024","ordinal":149208,"en":"Falteringly, Aichurok flew."},{"id":"semetey-1-2013:p0958:b003:l025","ordinal":149209,"en":"Opposite Bar-Kol,"},{"id":"semetey-1-2013:p0958:b003:l026","ordinal":149210,"en":"Aichurok alighted to keep watch."},{"id":"semetey-1-2013:p0958:b003:l027","ordinal":149211,"en":"As the day grew late, in the afternoon,"},{"id":"semetey-1-2013:p0958:b003:l028","ordinal":149212,"en":"When the coolness fell,"},{"id":"semetey-1-2013:p0958:b003:l029","ordinal":149213,"en":"She saw another wonder:"},{"id":"semetey-1-2013:p0958:b003:l030","ordinal":149214,"en":"From below Tort-Kul,"},{"id":"semetey-1-2013:p0958:b003:l031","ordinal":149215,"en":"From the orchard planted by Lord Manas,"},{"id":"semetey-1-2013:p0958:b003:l032","ordinal":149216,"en":"From Kanykei's palace,"},{"id":"semetey-1-2013:p0958:b003:l033","ordinal":149217,"en":"From Chachykei's enclosure,"},{"id":"semetey-1-2013:p0958:b003:l034","ordinal":149218,"en":"With a marten-fur cap upon his head,"},{"id":"semetey-1-2013:p0958:b003:l035","ordinal":149219,"en":"Out for a stroll had come"},{"id":"semetey-1-2013:p0958:b003:l036","ordinal":149220,"en":"Manas's son Semetey."},{"id":"semetey-1-2013:p0958:b003:l037","ordinal":149221,"en":"A warrior of impetuous spirit,"},{"id":"semetey-1-2013:p0958:b003:l038","ordinal":149222,"en":"Beyond Manas, gone to the other world,"},{"id":"semetey-1-2013:p0958:b003:l039","ordinal":149223,"en":"That lion had been born far greater."},{"id":"semetey-1-2013:p0958:b004:l001","ordinal":149224,"en":"She studied him in wonder:"},{"id":"semetey-1-2013:p0958:b004:l002","ordinal":149225,"en":"“This is my beloved,” she said,"},{"id":"semetey-1-2013:p0958:b004:l003","ordinal":149226,"en":"And Aichurok stood watching."},{"id":"semetey-1-2013:p0958:b004:l004","ordinal":149227,"en":"He rode horses hard and ranged the land,"},{"id":"semetey-1-2013:p0958:b004:l005","ordinal":149228,"en":"Loosed hounds and flew hunting birds."},{"id":"semetey-1-2013:p0958:b004:l006","ordinal":149229,"en":"His protector was Kojosan;"},{"id":"semetey-1-2013:p0958:b004:l007","ordinal":149230,"en":"Those he had pledged himself to were the forty chilten."},{"id":"semetey-1-2013:p0958:b004:l008","ordinal":149231,"en":"One of those forty chilten,"},{"id":"semetey-1-2013:p0958:b004:l009","ordinal":149232,"en":"A black-spotted leopard,"},{"id":"semetey-1-2013:p0958:b004:l010","ordinal":149233,"en":"Bounded at his side,"},{"id":"semetey-1-2013:p0958:b004:l011","ordinal":149234,"en":"With the presence of a thousand men;"},{"id":"semetey-1-2013:p0958:b004:l012","ordinal":149235,"en":"Thus it protected him."},{"id":"semetey-1-2013:p0958:b004:l013","ordinal":149236,"en":"Looking to his right,"},{"id":"semetey-1-2013:p0958:b004:l014","ordinal":149237,"en":"A bobtailed, wolf-maned lion"},{"id":"semetey-1-2013:p0958:b004:l015","ordinal":149238,"en":"Bounded close beside him,"},{"id":"semetey-1-2013:p0958:b004:l016","ordinal":149239,"en":"Thus protecting him."},{"id":"semetey-1-2013:p0958:b004:l017","ordinal":149240,"en":"A dragon, a white serpent,"},{"id":"semetey-1-2013:p0958:b004:l018","ordinal":149241,"en":"Opened its mouth and hissed,"},{"id":"semetey-1-2013:p0958:b004:l019","ordinal":149242,"en":"As though drawing breath to swallow,"},{"id":"semetey-1-2013:p0958:b004:l020","ordinal":149243,"en":"With the appearance of an immense host,"},{"id":"semetey-1-2013:p0958:b004:l021","ordinal":149244,"en":"It crawled behind him."},{"id":"semetey-1-2013:p0958:b004:l022","ordinal":149245,"en":"The giant black bird Zumuruk,"},{"id":"semetey-1-2013:p0958:b004:l023","ordinal":149246,"en":"Poised to snatch at any moment,"},{"id":"semetey-1-2013:p0958:b004:l024","ordinal":149247,"en":"Spread its legs and loomed"},{"id":"semetey-1-2013:p0958:b004:l025","ordinal":149248,"en":"Above him as he went."}]
