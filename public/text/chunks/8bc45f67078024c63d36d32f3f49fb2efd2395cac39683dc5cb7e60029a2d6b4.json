[{"id":"manas-2010:p1771:b001:l004","ordinal":76033,"en":"Driving the foe, Khan Koshoi is a vast army."},{"id":"manas-2010:p1771:b001:l005","ordinal":76034,"en":"Tell King Koshoi to come,"},{"id":"manas-2010:p1771:b001:l006","ordinal":76035,"en":"To see the hero while he lives."},{"id":"manas-2010:p1771:b001:l007","ordinal":76036,"en":"Saykal, daughter of Khan Karacha—"},{"id":"manas-2010:p1771:b001:l008","ordinal":76037,"en":"Send word to the fierce woman."},{"id":"manas-2010:p1771:b001:l009","ordinal":76038,"en":"Ajykhan and Shayyk, the two giants—"},{"id":"manas-2010:p1771:b001:l010","ordinal":76039,"en":"Send word to such heroes."},{"id":"manas-2010:p1771:b001:l011","ordinal":76040,"en":"Dear Ajy, when the moon is dark,"},{"id":"manas-2010:p1771:b001:l012","ordinal":76041,"en":"What shall we do with the night?"},{"id":"manas-2010:p1771:b001:l013","ordinal":76042,"en":"If the noble Generous One closes his eyes,"},{"id":"manas-2010:p1771:b001:l014","ordinal":76043,"en":"Hero, what shall we do with the day?!”"},{"id":"manas-2010:p1771:b001:l015","ordinal":76044,"en":"Then Ajybai stood and said:"},{"id":"manas-2010:p1771:b001:l016","ordinal":76045,"en":"“Very well, Kanykey."},{"id":"manas-2010:p1771:b001:l017","ordinal":76046,"en":"To the four corners of the world,"},{"id":"manas-2010:p1771:b001:l018","ordinal":76047,"en":"I shall send word to each."},{"id":"manas-2010:p1771:b001:l019","ordinal":76048,"en":"Lord Koshoi and Töshtük,"},{"id":"manas-2010:p1771:b001:l020","ordinal":76049,"en":"I shall gather those lords."},{"id":"manas-2010:p1771:b001:l021","ordinal":76050,"en":"To the five corners of the known land,"},{"id":"manas-2010:p1771:b001:l022","ordinal":76051,"en":"I shall carefully send word."},{"id":"manas-2010:p1771:b001:l023","ordinal":76052,"en":"All the renowned ones,"},{"id":"manas-2010:p1771:b001:l024","ordinal":76053,"en":"I shall seek out and gather."},{"id":"manas-2010:p1771:b001:l025","ordinal":76054,"en":"I obey, fierce lady; let me go!"},{"id":"manas-2010:p1771:b001:l026","ordinal":76055,"en":"Kartkurong, ridden into battle,"},{"id":"manas-2010:p1771:b001:l027","ordinal":76056,"en":"Was oldest among beasts."},{"id":"manas-2010:p1771:b001:l028","ordinal":76057,"en":"In Chambyl-Bel, Zhanaaly"},{"id":"manas-2010:p1771:b001:l029","ordinal":76058,"en":"And Karach, the two giants,"},{"id":"manas-2010:p1771:b001:l030","ordinal":76059,"en":"Were craftier than other men;"},{"id":"manas-2010:p1771:b001:l031","ordinal":76060,"en":"They were Ajybai's hostile foes."},{"id":"manas-2010:p1771:b001:l032","ordinal":76061,"en":"If I ride Kartkurong, let them not bring me down,"},{"id":"manas-2010:p1771:b001:l033","ordinal":76062,"en":"Let them not seize me at the steep bank,"},{"id":"manas-2010:p1771:b001:l034","ordinal":76063,"en":"Let them not kill me,"},{"id":"manas-2010:p1771:b001:l035","ordinal":76064,"en":"Refusing to hear my pleas."},{"id":"manas-2010:p1771:b001:l036","ordinal":76065,"en":"And, fierce Kanykey,"},{"id":"manas-2010:p1771:b001:l037","ordinal":76066,"en":"Let them not gouge out my eyes."},{"id":"manas-2010:p1771:b001:l038","ordinal":76067,"en":"Let them not bind me on my road,"},{"id":"manas-2010:p1771:b001:l039","ordinal":76068,"en":"Nor proclaim to their people:"},{"id":"manas-2010:p1771:b001:l040","ordinal":76069,"en":"‘While his khan Manas lived,"},{"id":"manas-2010:p1771:b001:l041","ordinal":76070,"en":"What great turmoil he wrought!’"},{"id":"manas-2010:p1771:b001:l042","ordinal":76071,"en":"Let them not take revenge like that."},{"id":"manas-2010:p1772:b001:l001","ordinal":76072,"en":"Let them not twist a leather rope around my neck."},{"id":"manas-2010:p1772:b001:l002","ordinal":76073,"en":"When damned affliction falls upon my head,"},{"id":"manas-2010:p1772:b001:l003","ordinal":76074,"en":"When the enemy presses hard,"},{"id":"manas-2010:p1772:b001:l004","ordinal":76075,"en":"Let Kartkurong not refuse to walk."},{"id":"manas-2010:p1772:b001:l005","ordinal":76076,"en":"If a cliff with a difficult pass appears,"},{"id":"manas-2010:p1772:b001:l006","ordinal":76077,"en":"Let me not fall from it and die."},{"id":"manas-2010:p1772:b001:l007","ordinal":76078,"en":"If a fiercely flowing river appears,"},{"id":"manas-2010:p1772:b001:l008","ordinal":76079,"en":"Kanykey, my child, let me not be swept away and die."},{"id":"manas-2010:p1772:b001:l009","ordinal":76080,"en":"If a white blizzard rises before me,"},{"id":"manas-2010:p1772:b001:l010","ordinal":76081,"en":"My child, let me not freeze to death."},{"id":"manas-2010:p1772:b001:l011","ordinal":76082,"en":"Having forded many flowing rivers,"},{"id":"manas-2010:p1772:b001:l012","ordinal":76083,"en":"Kartkurong beneath me"},{"id":"manas-2010:p1772:b001:l013","ordinal":76084,"en":"Is a wretch with worn-down hooves."},{"id":"manas-2010:p1772:b001:l014","ordinal":76085,"en":"Having crossed many mountains and passes,"},{"id":"manas-2010:p1772:b001:l015","ordinal":76086,"en":"He is a dispirited wretch."},{"id":"manas-2010:p1772:b001:l016","ordinal":76087,"en":"Kanykey, my child, give me the roan to ride;"},{"id":"manas-2010:p1772:b001:l017","ordinal":76088,"en":"Kanykey, my child, give me the fine cloth robe to wear."},{"id":"manas-2010:p1772:b001:l018","ordinal":76089,"en":"Let me gird the hungry steel blade at my waist."},{"id":"manas-2010:p1772:b001:l019","ordinal":76090,"en":"If an eager enemy confronts me,"},{"id":"manas-2010:p1772:b001:l020","ordinal":76091,"en":"Thus let me take my vengeance."},{"id":"manas-2010:p1772:b001:l021","ordinal":76092,"en":"Without sleeping propped on my elbow,"},{"id":"manas-2010:p1772:b001:l022","ordinal":76093,"en":"Without resting even in a doze,"},{"id":"manas-2010:p1772:b001:l023","ordinal":76094,"en":"I shall carry the tidings thus."},{"id":"manas-2010:p1772:b001:l024","ordinal":76095,"en":"(For my sworn friend Manas)"},{"id":"manas-2010:p1772:b001:l025","ordinal":76096,"en":"If you tell me to go, I shall go."},{"id":"manas-2010:p1772:b001:l026","ordinal":76097,"en":"Beauty among the dark-complexioned,"},{"id":"manas-2010:p1772:b001:l027","ordinal":76098,"en":"Radiant one among the Muslims,"},{"id":"manas-2010:p1772:b001:l028","ordinal":76099,"en":"I shall obey your words.”"},{"id":"manas-2010:p1772:b001:l029","ordinal":76100,"en":"When Ajybai had agreed,"},{"id":"manas-2010:p1772:b001:l030","ordinal":76101,"en":"To give him Taybuurul,"},{"id":"manas-2010:p1772:b001:l031","ordinal":76102,"en":"That noble sister-in-law Kanykey,"},{"id":"manas-2010:p1772:b001:l032","ordinal":76103,"en":"Unable to wipe the tears from her eyes—"},{"id":"manas-2010:p1772:b001:l033","ordinal":76104,"en":"Perish, treacherous world!—"},{"id":"manas-2010:p1772:b001:l034","ordinal":76105,"en":"Nor even to sniff back her running nose,"},{"id":"manas-2010:p1772:b001:l035","ordinal":76106,"en":"Went straight inside."},{"id":"manas-2010:p1772:b001:l036","ordinal":76107,"en":"The dear woman Kanykey"},{"id":"manas-2010:p1772:b001:l037","ordinal":76108,"en":"Brought him from the royal camp,"},{"id":"manas-2010:p1772:b001:l038","ordinal":76109,"en":"Leading Taybuurul."},{"id":"manas-2010:p1772:b001:l039","ordinal":76110,"en":"Then, Kökbörü being their family friend,"},{"id":"manas-2010:p1772:b001:l040","ordinal":76111,"en":"She deliberately wrote his name,"},{"id":"manas-2010:p1772:b001:l041","ordinal":76112,"en":"Wrote to Kökbörü, telling her sorrow:"},{"id":"manas-2010:p1772:b001:l042","ordinal":76113,"en":"“If he is late, so be it;"},{"id":"manas-2010:p1773:b001:l001","ordinal":76114,"en":"If Kökbörü does not come,"},{"id":"manas-2010:p1773:b001:l002","ordinal":76115,"en":"He has hurt our souls and brought us misery."},{"id":"manas-2010:p1773:b001:l003","ordinal":76116,"en":"If my dear friend will not come,"},{"id":"manas-2010:p1773:b001:l004","ordinal":76117,"en":"Then we shall know his ignorance."},{"id":"manas-2010:p1773:b001:l005","ordinal":76118,"en":"If what is told is true,"},{"id":"manas-2010:p1773:b001:l006","ordinal":76119,"en":"Tomorrow, on Judgment Day,"},{"id":"manas-2010:p1773:b001:l007","ordinal":76120,"en":"We shall make a black donkey of him."},{"id":"manas-2010:p1773:b001:l008","ordinal":76121,"en":"On Maseyil's ridge,"},{"id":"manas-2010:p1773:b001:l009","ordinal":76122,"en":"In the land called Alay,"},{"id":"manas-2010:p1773:b001:l010","ordinal":76123,"en":"Youngest of nine sons,"},{"id":"manas-2010:p1773:b001:l011","ordinal":76124,"en":"Servant of the one God,"},{"id":"manas-2010:p1773:b001:l012","ordinal":76125,"en":"Eleman's brave Töshtük—"},{"id":"manas-2010:p1773:b001:l013","ordinal":76126,"en":"Tell the old friend to come,"},{"id":"manas-2010:p1773:b001:l014","ordinal":76127,"en":"To see his friend, leopard Manas,"},{"id":"manas-2010:p1773:b001:l015","ordinal":76128,"en":"While he is alive."},{"id":"manas-2010:p1773:b001:l016","ordinal":76129,"en":"Tell the hero to turn Chalkuyruk this way,"},{"id":"manas-2010:p1773:b001:l017","ordinal":76130,"en":"When Khan Manas passes away,"},{"id":"manas-2010:p1773:b001:l018","ordinal":76131,"en":"To attend his funeral."},{"id":"manas-2010:p1773:b001:l019","ordinal":76132,"en":"Dear Ajy, tell your khan, lord Töshtük,"},{"id":"manas-2010:p1773:b001:l020","ordinal":76133,"en":"‘Lord Manas is ill,’"},{"id":"manas-2010:p1773:b001:l021","ordinal":76134,"en":"Tell all the people below."},{"id":"manas-2010:p1773:b001:l022","ordinal":76135,"en":"Tell the wise, good mullah;"},{"id":"manas-2010:p1773:b001:l023","ordinal":76136,"en":"Tell the poor man who receives absolution offerings;"},{"id":"manas-2010:p1773:b001:l024","ordinal":76137,"en":"Tell the widow who suffers want;"},{"id":"manas-2010:p1773:b001:l025","ordinal":76138,"en":"Tell the destitute wearing rawhide shoes."},{"id":"manas-2010:p1773:b001:l026","ordinal":76139,"en":"Can the dead remain alive?"},{"id":"manas-2010:p1773:b001:l027","ordinal":76140,"en":"Let the whole earth know the lesson of its king;"},{"id":"manas-2010:p1773:b001:l028","ordinal":76141,"en":"Let the poor and destitute eat their fill."},{"id":"manas-2010:p1773:b001:l029","ordinal":76142,"en":"Those with ropes about their feet,"},{"id":"manas-2010:p1773:b001:l030","ordinal":76143,"en":"Let the bound ones come here."},{"id":"manas-2010:p1773:b001:l031","ordinal":76144,"en":"Those whose possessions were taken,"},{"id":"manas-2010:p1773:b001:l032","ordinal":76145,"en":"Let those with claims against the fierce one come here."},{"id":"manas-2010:p1773:b001:l033","ordinal":76146,"en":"Those left unable to work,"},{"id":"manas-2010:p1773:b001:l034","ordinal":76147,"en":"Let the old come here."},{"id":"manas-2010:p1773:b001:l035","ordinal":76148,"en":"Khojas, mullahs, wandering holy men,"},{"id":"manas-2010:p1773:b001:l036","ordinal":76149,"en":"Let them all come here."},{"id":"manas-2010:p1773:b001:l037","ordinal":76150,"en":"Those bereft of their fathers,"},{"id":"manas-2010:p1773:b001:l038","ordinal":76151,"en":"Those orphaned and left helpless,"},{"id":"manas-2010:p1773:b001:l039","ordinal":76152,"en":"Let them also come here."},{"id":"manas-2010:p1773:b001:l040","ordinal":76153,"en":"For the hero's absolution offerings,"},{"id":"manas-2010:p1773:b001:l041","ordinal":76154,"en":"I shall give a thousand dark camels."},{"id":"manas-2010:p1773:b001:l042","ordinal":76155,"en":"For the hero's funeral,"},{"id":"manas-2010:p1774:b001:l001","ordinal":76156,"en":"I shall give a thousand black mares with white blazes."},{"id":"manas-2010:p1774:b001:l002","ordinal":76157,"en":"My wings that reach the people,"},{"id":"manas-2010:p1774:b001:l003","ordinal":76158,"en":"Beyond Khan Kökötöy's memorial feast"},{"id":"manas-2010:p1774:b001:l004","ordinal":76159,"en":"I shall make its grandeur.”"},{"id":"manas-2010:p1774:b001:l005","ordinal":76160,"en":"She spoke insistently and urgently,"},{"id":"manas-2010:p1774:b001:l006","ordinal":76161,"en":"Entrusting that errand"},{"id":"manas-2010:p1774:b001:l007","ordinal":76162,"en":"To her messenger Ajybai."},{"id":"manas-2010:p1774:b001:l008","ordinal":76163,"en":"Mounted on the roan, making it surge,"},{"id":"manas-2010:p1774:b001:l009","ordinal":76164,"en":"In a frenzy as though a husband had died,"},{"id":"manas-2010:p1774:b001:l010","ordinal":76165,"en":"Ajybai rode without turning aside."},{"id":"manas-2010:p1774:b001:l011","ordinal":76166,"en":"The mount beneath him"},{"id":"manas-2010:p1774:b001:l012","ordinal":76167,"en":"Was Khan Manas's roan;"},{"id":"manas-2010:p1774:b001:l013","ordinal":76168,"en":"What he held in his hand"},{"id":"manas-2010:p1774:b001:l014","ordinal":76169,"en":"Was dear Alma's steel."},{"id":"manas-2010:p1774:b001:l015","ordinal":76170,"en":"To Zhelpinish at the earth's end,"},{"id":"manas-2010:p1774:b001:l016","ordinal":76171,"en":"Ajybai set off."},{"id":"manas-2010:p1774:b001:l017","ordinal":76172,"en":"Since wise Khan Manas had fallen ill,"},{"id":"manas-2010:p1774:b001:l018","ordinal":76173,"en":"Across the face of the earth,"},{"id":"manas-2010:p1774:b001:l019","ordinal":76174,"en":"Ajybai set off to spread the news."},{"id":"manas-2010:p1774:b001:l020","ordinal":76175,"en":"When they entered a downward slope,"},{"id":"manas-2010:p1774:b001:l021","ordinal":76176,"en":"Brave Manas's roan"},{"id":"manas-2010:p1774:b001:l022","ordinal":76177,"en":"Set its feet like a roe deer."},{"id":"manas-2010:p1774:b001:l023","ordinal":76178,"en":"When it reached the hilly ground,"},{"id":"manas-2010:p1774:b001:l024","ordinal":76179,"en":"Its mane and tail spread wide."},{"id":"manas-2010:p1774:b001:l025","ordinal":76180,"en":"When they entered a downward slope,"},{"id":"manas-2010:p1774:b001:l026","ordinal":76181,"en":"Its soles thundered on the earth;"},{"id":"manas-2010:p1774:b001:l027","ordinal":76182,"en":"The black-steel bit"},{"id":"manas-2010:p1774:b001:l028","ordinal":76183,"en":"Clattered in its throat."},{"id":"manas-2010:p1774:b001:l029","ordinal":76184,"en":"Its ravenous mouth opened;"},{"id":"manas-2010:p1774:b001:l030","ordinal":76185,"en":"White foam mixed with blood"},{"id":"manas-2010:p1774:b001:l031","ordinal":76186,"en":"Splashed upon its breast."},{"id":"manas-2010:p1774:b001:l032","ordinal":76187,"en":"The earth it trod crumbled;"},{"id":"manas-2010:p1774:b001:l033","ordinal":76188,"en":"Clods as large as cauldrons"},{"id":"manas-2010:p1774:b001:l034","ordinal":76189,"en":"Whistled above Ajybai's head."},{"id":"manas-2010:p1774:b001:l035","ordinal":76190,"en":"Racing with flying birds,"},{"id":"manas-2010:p1774:b001:l036","ordinal":76191,"en":"The white reins with rounded joining knots"},{"id":"manas-2010:p1774:b001:l037","ordinal":76192,"en":"Stretched taut in both hands."},{"id":"manas-2010:p1774:b001:l038","ordinal":76193,"en":"It tossed its forelock to the sky,"},{"id":"manas-2010:p1774:b001:l039","ordinal":76194,"en":"Drove its hooves into the earth,"},{"id":"manas-2010:p1774:b001:l040","ordinal":76195,"en":"Clattered its bit,"},{"id":"manas-2010:p1774:b001:l041","ordinal":76196,"en":"And its tail like strands of silk"},{"id":"manas-2010:p1774:b001:l042","ordinal":76197,"en":"Beat against its hind legs."},{"id":"manas-2010:p1775:b001:l001","ordinal":76198,"en":"Argynkhan's Ajybai,"},{"id":"manas-2010:p1775:b001:l002","ordinal":76199,"en":"When he rode Taybuurul,"},{"id":"manas-2010:p1775:b001:l003","ordinal":76200,"en":"Was visible where he could be seen;"},{"id":"manas-2010:p1775:b001:l004","ordinal":76201,"en":"In the hidden low ground,"},{"id":"manas-2010:p1775:b001:l005","ordinal":76202,"en":"He dissolved into blue smoke."},{"id":"manas-2010:p1775:b001:l006","ordinal":76203,"en":"Kept in a dark place,"},{"id":"manas-2010:p1775:b001:l007","ordinal":76204,"en":"With owl feathers fixed upon its head,"},{"id":"manas-2010:p1775:b001:l008","ordinal":76205,"en":"The horse turned its neck like a stag."},{"id":"manas-2010:p1775:b001:l009","ordinal":76206,"en":"If a man-high ditch appeared,"},{"id":"manas-2010:p1775:b001:l010","ordinal":76207,"en":"It sped across without turning."},{"id":"manas-2010:p1775:b001:l011","ordinal":76208,"en":"Knowing its noble speed,"},{"id":"manas-2010:p1775:b001:l012","ordinal":76209,"en":"Offering gold ornaments by the weight,"},{"id":"manas-2010:p1775:b001:l013","ordinal":76210,"en":"The khan of lower Bukhara had asked for it."},{"id":"manas-2010:p1775:b001:l014","ordinal":76211,"en":"It was not given when he asked;"},{"id":"manas-2010:p1775:b001:l015","ordinal":76212,"en":"Far from giving the noble steed away,"},{"id":"manas-2010:p1775:b001:l016","ordinal":76213,"en":"No one without ablution had ridden it."},{"id":"manas-2010:p1775:b001:l017","ordinal":76214,"en":"Born upon sand, raised upon stone,"},{"id":"manas-2010:p1775:b001:l018","ordinal":76215,"en":"Raised differently, apart from spirit steeds."},{"id":"manas-2010:p1775:b001:l019","ordinal":76216,"en":"Its dam was a great desert charger;"},{"id":"manas-2010:p1775:b001:l021","ordinal":76217,"en":"With sieve-like lungs and copper forelegs,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p1775:b001:l022","ordinal":76218,"en":"A hardy, noble-blooded charger."},{"id":"manas-2010:p1775:b001:l023","ordinal":76219,"en":"Truly joined to the unseen,"},{"id":"manas-2010:p1775:b001:l024","ordinal":76220,"en":"After wearing Saykal down,"},{"id":"manas-2010:p1775:b001:l025","ordinal":76221,"en":"The roan horse was received as a gift."},{"id":"manas-2010:p1775:b001:l026","ordinal":76222,"en":"The deeply devoted friend, maiden Saykal,"},{"id":"manas-2010:p1775:b001:l027","ordinal":76223,"en":"Had given the roan as an inheritance."},{"id":"manas-2010:p1775:b001:l028","ordinal":76224,"en":"‘Let his son take pleasure in it,"},{"id":"manas-2010:p1775:b001:l029","ordinal":76225,"en":"Own it and ride it,’ she said."},{"id":"manas-2010:p1775:b001:l030","ordinal":76226,"en":"Thus the roan came as an inheritance."},{"id":"manas-2010:p1775:b001:l031","ordinal":76227,"en":"Talas and broad Kyrym"},{"id":"manas-2010:p1775:b001:l032","ordinal":76228,"en":"Lay forty days' journey apart."},{"id":"manas-2010:p1775:b001:l033","ordinal":76229,"en":"Ajybai traveled tirelessly;"},{"id":"manas-2010:p1775:b001:l034","ordinal":76230,"en":"To the corners of the world,"},{"id":"manas-2010:p1775:b001:l035","ordinal":76231,"en":"He brought the news."},{"id":"manas-2010:p1775:b001:l036","ordinal":76232,"en":"Kökbörü, Urumkhan's son,"},{"id":"manas-2010:p1775:b001:l037","ordinal":76233,"en":"Woke with a start from sleep,"},{"id":"manas-2010:p1775:b001:l038","ordinal":76234,"en":"Turned onto his right side,"},{"id":"manas-2010:p1775:b001:l039","ordinal":76235,"en":"Hastened to say his prayers,"},{"id":"manas-2010:p1775:b001:l040","ordinal":76236,"en":"Saddled Kuukazyk,"},{"id":"manas-2010:p1775:b001:l041","ordinal":76237,"en":"Dipped his hands in water,"},{"id":"manas-2010:p1775:b001:l042","ordinal":76238,"en":"And performed ablution for his hands."},{"id":"manas-2010:p1776:b001:l001","ordinal":76239,"en":"Pleading with the Almighty,"},{"id":"manas-2010:p1776:b001:l002","ordinal":76240,"en":"His companion and friend Manas"},{"id":"manas-2010:p1776:b001:l003","ordinal":76241,"en":"He longed for deeply."},{"id":"manas-2010:p1776:b001:l004","ordinal":76242,"en":"Hearing news from those who came,"},{"id":"manas-2010:p1776:b001:l005","ordinal":76243,"en":"That with forty-two myriads of troops"},{"id":"manas-2010:p1776:b001:l006","ordinal":76244,"en":"He had gone to Beijing,"},{"id":"manas-2010:p1776:b001:l007","ordinal":76245,"en":"Kökbörü grew troubled."},{"id":"manas-2010:p1776:b001:l008","ordinal":76246,"en":"‘If my death is due, I shall die;"},{"id":"manas-2010:p1776:b001:l009","ordinal":76247,"en":"If he is still alive,"},{"id":"manas-2010:p1776:b001:l010","ordinal":76248,"en":"My friend, fierce-maned Manas,"},{"id":"manas-2010:p1776:b001:l011","ordinal":76249,"en":"I shall go and clasp his hand,’ he said."},{"id":"manas-2010:p1776:b001:l012","ordinal":76250,"en":"Külnar, Khan Karacha's daughter,"},{"id":"manas-2010:p1776:b001:l013","ordinal":76251,"en":"Kökbörü's wife,"},{"id":"manas-2010:p1776:b001:l014","ordinal":76252,"en":"Had wisdom beyond other people's."},{"id":"manas-2010:p1776:b001:l015","ordinal":76253,"en":"It was not darkness, but night itself;"},{"id":"manas-2010:p1776:b001:l016","ordinal":76254,"en":"She herself was a wondrous handmaiden,"},{"id":"manas-2010:p1776:b001:l017","ordinal":76255,"en":"Beauty among the dark-complexioned,"},{"id":"manas-2010:p1776:b001:l018","ordinal":76256,"en":"The finest among women."},{"id":"manas-2010:p1776:b001:l019","ordinal":76257,"en":"‘My friend for the life beyond, Manas,"},{"id":"manas-2010:p1776:b001:l020","ordinal":76258,"en":"At last I shall see his face."},{"id":"manas-2010:p1776:b001:l021","ordinal":76259,"en":"If Manas has died,"},{"id":"manas-2010:p1776:b001:l022","ordinal":76260,"en":"I shall go and recite the Quran for him."},{"id":"manas-2010:p1776:b001:l023","ordinal":76261,"en":"If Kanykey is in distress,"},{"id":"manas-2010:p1776:b001:l024","ordinal":76262,"en":"I shall offer my family friend condolences."},{"id":"manas-2010:p1776:b001:l025","ordinal":76263,"en":"If he is alive,"},{"id":"manas-2010:p1776:b001:l026","ordinal":76264,"en":"For the boy Semetey,"},{"id":"manas-2010:p1776:b001:l027","ordinal":76265,"en":"I shall celebrate his birth before returning,’ she said."},{"id":"manas-2010:p1776:b001:l028","ordinal":76266,"en":"Yellow gold coins and white silver"},{"id":"manas-2010:p1776:b001:l029","ordinal":76267,"en":"They loaded upon an elephant."},{"id":"manas-2010:p1776:b001:l030","ordinal":76268,"en":"Traveling many roads tirelessly,"},{"id":"manas-2010:p1776:b001:l031","ordinal":76269,"en":"Toward Manas, Kökbörü"},{"id":"manas-2010:p1776:b001:l032","ordinal":76270,"en":"Had set out on his journey."},{"id":"manas-2010:p1776:b001:l033","ordinal":76271,"en":"During his journey,"},{"id":"manas-2010:p1776:b001:l034","ordinal":76272,"en":"Ajybai, son of the Argyn,"},{"id":"manas-2010:p1776:b001:l035","ordinal":76273,"en":"Surging on his mighty steed,"},{"id":"manas-2010:p1776:b001:l036","ordinal":76274,"en":"Toward Urumkhan's son Kökbörü,"},{"id":"manas-2010:p1776:b001:l037","ordinal":76275,"en":"Went out to meet him."},{"id":"manas-2010:p1776:b001:l038","ordinal":76276,"en":"They exchanged their due greetings;"},{"id":"manas-2010:p1776:b001:l039","ordinal":76277,"en":"Kökbörü did not stand idly."},{"id":"manas-2010:p1776:b001:l040","ordinal":76278,"en":"When he saw Ajybai,"},{"id":"manas-2010:p1776:b001:l041","ordinal":76279,"en":"He asked about all the fierce heroes."},{"id":"manas-2010:p1776:b001:l042","ordinal":76280,"en":"“Broad Talas, the tamarisk-lined river,"},{"id":"manas-2010:p1777:b001:l001","ordinal":76281,"en":"Is your land at peace?"},{"id":"manas-2010:p1777:b001:l002","ordinal":76282,"en":"The prosperous Kyrgyz and many Argyn,"},{"id":"manas-2010:p1777:b001:l003","ordinal":76283,"en":"Are your people at peace?"},{"id":"manas-2010:p1777:b001:l004","ordinal":76284,"en":"Youngest of the six lions,"},{"id":"manas-2010:p1777:b001:l005","ordinal":76285,"en":"The servant beloved of God,"},{"id":"manas-2010:p1777:b001:l006","ordinal":76286,"en":"My generous leopard Manas,"},{"id":"manas-2010:p1777:b001:l007","ordinal":76287,"en":"Is your lion well?"},{"id":"manas-2010:p1777:b001:l008","ordinal":76288,"en":"Finding sight in darkness,"}]
