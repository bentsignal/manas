[{"id":"semetey-1-2013:p0942:b004:l020","ordinal":148993,"en":"Who spare not the whole wide world—"},{"id":"semetey-1-2013:p0942:b004:l021","ordinal":148994,"en":"There are dear Kojo's people."},{"id":"semetey-1-2013:p0942:b004:l022","ordinal":148995,"en":"If you ask about Kojo,"},{"id":"semetey-1-2013:p0942:b004:l023","ordinal":148996,"en":"Thick-armed and stone-hearted,"},{"id":"semetey-1-2013:p0942:b004:l024","ordinal":148997,"en":"An elephant-built brute."},{"id":"semetey-1-2013:p0942:b004:l025","ordinal":148998,"en":"Where could he have seen Churok?"},{"id":"semetey-1-2013:p0942:b004:l026","ordinal":148999,"en":"From where could Toltoi have come?"},{"id":"semetey-1-2013:p0942:b004:l027","ordinal":149000,"en":"Akun Khan knew very well:"},{"id":"semetey-1-2013:p0942:b004:l028","ordinal":149001,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p0942:b004:l029","ordinal":149002,"en":"Kojo, vigorous in his deeds,"},{"id":"semetey-1-2013:p0942:b004:l030","ordinal":149003,"en":"Kojo, broad in the right shoulder,"},{"id":"semetey-1-2013:p0942:b004:l031","ordinal":149004,"en":"Overturned man Hip,"},{"id":"semetey-1-2013:p0942:b004:l032","ordinal":149005,"en":"Trained by Manas,"},{"id":"semetey-1-2013:p0942:b004:l033","ordinal":149006,"en":"Lion Kojo, who had seen much."},{"id":"semetey-1-2013:p0942:b004:l034","ordinal":149007,"en":"Once Kanykei had come in mourning,"},{"id":"semetey-1-2013:p0942:b004:l035","ordinal":149008,"en":"And Semetey had fled,"},{"id":"semetey-1-2013:p0942:b004:l036","ordinal":149009,"en":"Plundering my goods and prospering,"},{"id":"semetey-1-2013:p0942:b004:l037","ordinal":149010,"en":"Entered Bukhara and grown up."},{"id":"semetey-1-2013:p0942:b004:l038","ordinal":149011,"en":"The fierce hero's son, the warrior bridegroom,"},{"id":"semetey-1-2013:p0942:b004:l039","ordinal":149012,"en":"Had moved back to Talas, it seemed,"},{"id":"semetey-1-2013:p0943:b003:l001","ordinal":149013,"en":"From the orphan son of Manas,"},{"id":"semetey-1-2013:p0943:b003:l002","ordinal":149014,"en":"He must have suffered great humiliation."},{"id":"semetey-1-2013:p0943:b003:l003","ordinal":149015,"en":"You have courage, braggart—"},{"id":"semetey-1-2013:p0943:b003:l004","ordinal":149016,"en":"To Toltoi of the Jediger,"},{"id":"semetey-1-2013:p0943:b003:l005","ordinal":149017,"en":"He fled and settled as a subject,"},{"id":"semetey-1-2013:p0943:b003:l006","ordinal":149018,"en":"Told him of Churok,"},{"id":"semetey-1-2013:p0943:b003:l007","ordinal":149019,"en":"And must have begun this uproar."},{"id":"semetey-1-2013:p0943:b003:l008","ordinal":149020,"en":"Your dear Khan Akun"},{"id":"semetey-1-2013:p0943:b003:l009","ordinal":149021,"en":"Now stood considering,"},{"id":"semetey-1-2013:p0943:b003:l010","ordinal":149022,"en":"Prolonging the dispute greatly,"},{"id":"semetey-1-2013:p0943:b003:l011","ordinal":149023,"en":"He now fumed with rage:"},{"id":"semetey-1-2013:p0943:b003:l012","ordinal":149024,"en":"'When eighty days have passed,"},{"id":"semetey-1-2013:p0943:b003:l013","ordinal":149025,"en":"Seek word from us,"},{"id":"semetey-1-2013:p0943:b003:l014","ordinal":149026,"en":"And become our marriage kin."},{"id":"semetey-1-2013:p0943:b003:l015","ordinal":149027,"en":"My daughter Aichurok"},{"id":"semetey-1-2013:p0943:b003:l016","ordinal":149028,"en":"Is no child to be treated lightly."},{"id":"semetey-1-2013:p0943:b003:l017","ordinal":149029,"en":"This broad Opol"},{"id":"semetey-1-2013:p0943:b003:l018","ordinal":149030,"en":"Is no city to be trampled down."},{"id":"semetey-1-2013:p0943:b003:l019","ordinal":149031,"en":"Great host of Jediger,"},{"id":"semetey-1-2013:p0943:b003:l020","ordinal":149032,"en":"You have descended all together."},{"id":"semetey-1-2013:p0943:b003:l021","ordinal":149033,"en":"Against Toltoi and Kojo,"},{"id":"semetey-1-2013:p0943:b003:l022","ordinal":149034,"en":"I have not destroyed their honor,"},{"id":"semetey-1-2013:p0943:b003:l023","ordinal":149035,"en":"I have inflicted no such humiliation."},{"id":"semetey-1-2013:p0943:b003:l024","ordinal":149036,"en":"I have killed no warrior,"},{"id":"semetey-1-2013:p0943:b003:l025","ordinal":149037,"en":"I have inflicted no such humiliation."},{"id":"semetey-1-2013:p0943:b003:l026","ordinal":149038,"en":"Our appointed term is eighty days."},{"id":"semetey-1-2013:p0943:b003:l027","ordinal":149039,"en":"So that they do not suddenly attack,"},{"id":"semetey-1-2013:p0943:b003:l028","ordinal":149040,"en":"So that slaughter does not suddenly occur,"},{"id":"semetey-1-2013:p0943:b003:l029","ordinal":149041,"en":"Tell them to restrain their great army."},{"id":"semetey-1-2013:p0943:b003:l030","ordinal":149042,"en":"If he truly means to take a wife,"},{"id":"semetey-1-2013:p0943:b003:l031","ordinal":149043,"en":"Will he not agree to my words?"},{"id":"semetey-1-2013:p0943:b003:l032","ordinal":149044,"en":"Chynkojo's black horse—"},{"id":"semetey-1-2013:p0943:b003:l033","ordinal":149045,"en":"I shall seize and bring him bound,"},{"id":"semetey-1-2013:p0943:b003:l034","ordinal":149046,"en":"Hero Toltoi's Surkoyon—"},{"id":"semetey-1-2013:p0943:b003:l035","ordinal":149047,"en":"If he truly means to wed,"},{"id":"semetey-1-2013:p0943:b003:l036","ordinal":149048,"en":"Will he not give it as the chief gift-horse?"},{"id":"semetey-1-2013:p0943:b003:l037","ordinal":149049,"en":"Driving seven hundred red camels,"},{"id":"semetey-1-2013:p0943:b003:l038","ordinal":149050,"en":"Will he not give them as the bride-price?"},{"id":"semetey-1-2013:p0943:b003:l039","ordinal":149051,"en":"Gathering goods on six bay horses,"},{"id":"semetey-1-2013:p0943:b004:l001","ordinal":149052,"en":"Raising dust along the road ahead,"},{"id":"semetey-1-2013:p0943:b004:l002","ordinal":149053,"en":"Will Toltoi not take his wife,"},{"id":"semetey-1-2013:p0943:b004:l003","ordinal":149054,"en":"And become a bridegroom?"},{"id":"semetey-1-2013:p0943:b004:l004","ordinal":149055,"en":"He has poured and offered no tea,"},{"id":"semetey-1-2013:p0943:b004:l005","ordinal":149056,"en":"Has brought no livestock for the marriage alliance;"},{"id":"semetey-1-2013:p0943:b004:l006","ordinal":149057,"en":"Showing off his army, swaggering,"},{"id":"semetey-1-2013:p0943:b004:l007","ordinal":149058,"en":"I shall not give Churok under humiliation."},{"id":"semetey-1-2013:p0943:b004:l008","ordinal":149059,"en":"Those two horses I have named,"},{"id":"semetey-1-2013:p0943:b004:l009","ordinal":149060,"en":"Let him give them to me as gifts."},{"id":"semetey-1-2013:p0943:b004:l010","ordinal":149061,"en":"I shall not agree to his demands!'"},{"id":"semetey-1-2013:p0943:b004:l011","ordinal":149062,"en":"Hearing Akun's terms,"},{"id":"semetey-1-2013:p0943:b004:l012","ordinal":149063,"en":"Black-bearded hero Tolok"},{"id":"semetey-1-2013:p0943:b004:l013","ordinal":149064,"en":"Hurried back to his people."},{"id":"semetey-1-2013:p0943:b004:l014","ordinal":149065,"en":"To the great Jediger host,"},{"id":"semetey-1-2013:p0943:b004:l015","ordinal":149066,"en":"Their khan Toltoi, and Chynkojo,"},{"id":"semetey-1-2013:p0943:b004:l016","ordinal":149067,"en":"He brought the news joyfully."},{"id":"semetey-1-2013:p0943:b004:l017","ordinal":149068,"en":"The term of eighty days,"},{"id":"semetey-1-2013:p0943:b004:l018","ordinal":149069,"en":"They agreed to the appointed time."},{"id":"semetey-1-2013:p0943:b004:l019","ordinal":149070,"en":"When bored, they shot roe deer."},{"id":"semetey-1-2013:p0943:b004:l020","ordinal":149071,"en":"The great Jediger host"},{"id":"semetey-1-2013:p0943:b004:l021","ordinal":149072,"en":"Lay besieging Oogan."},{"id":"semetey-1-2013:p0943:b004:l022","ordinal":149073,"en":"Chynkojo brought his wrath to bear,"},{"id":"semetey-1-2013:p0943:b004:l023","ordinal":149074,"en":"And the hero Toltoi roused his strength."},{"id":"semetey-1-2013:p0943:b004:l024","ordinal":149075,"en":"There they lay besieging it."},{"id":"semetey-1-2013:p0943:b004:l025","ordinal":149076,"en":"Now let us tell"},{"id":"semetey-1-2013:p0943:b004:l026","ordinal":149077,"en":"The story of dear Churok:"},{"id":"semetey-1-2013:p0943:b004:l027","ordinal":149078,"en":"Finding no place to settle,"},{"id":"semetey-1-2013:p0943:b004:l028","ordinal":149079,"en":"Finding no hero to marry,"},{"id":"semetey-1-2013:p0943:b004:l029","ordinal":149080,"en":"'My father is old, and I am a girl."},{"id":"semetey-1-2013:p0943:b004:l030","ordinal":149081,"en":"If the Jediger come besieging us,"},{"id":"semetey-1-2013:p0943:b004:l031","ordinal":149082,"en":"The moon is dark, the night overcast;"},{"id":"semetey-1-2013:p0943:b004:l032","ordinal":149083,"en":"What will the night bring?' she thought."},{"id":"semetey-1-2013:p0943:b004:l033","ordinal":149084,"en":"'My father is old, and I am a girl."},{"id":"semetey-1-2013:p0943:b004:l034","ordinal":149085,"en":"What will the day bring?' she thought."},{"id":"semetey-1-2013:p0943:b004:l035","ordinal":149086,"en":"'Roaming the whole world,"},{"id":"semetey-1-2013:p0943:b004:l036","ordinal":149087,"en":"Across the entire wide world,"},{"id":"semetey-1-2013:p0943:b004:l037","ordinal":149088,"en":"Finding support on which to rely,"},{"id":"semetey-1-2013:p0943:b004:l038","ordinal":149089,"en":"I myself shall fly about,"},{"id":"semetey-1-2013:p0943:b004:l039","ordinal":149090,"en":"Finding a hero equal to me,"},{"id":"semetey-1-2013:p0944:b003:l001","ordinal":149091,"en":"Finding a lion whom my heart loves,"},{"id":"semetey-1-2013:p0944:b003:l002","ordinal":149092,"en":"Let me unleash turmoil."},{"id":"semetey-1-2013:p0944:b003:l003","ordinal":149093,"en":"Against Kojo, who is besieging us,"},{"id":"semetey-1-2013:p0944:b003:l004","ordinal":149094,"en":"And valorous Toltoi,"},{"id":"semetey-1-2013:p0944:b003:l005","ordinal":149095,"en":"I'll take a bite out of the cap."},{"id":"semetey-1-2013:p0944:b003:l006","ordinal":149096,"en":"Let me gird my waist,"},{"id":"semetey-1-2013:p0944:b003:l007","ordinal":149097,"en":"Let me earnestly seek my equal."},{"id":"semetey-1-2013:p0944:b003:l008","ordinal":149098,"en":"Against the frenzied Kojo and Toltoi,"},{"id":"semetey-1-2013:p0944:b003:l009","ordinal":149099,"en":"Let me take my revenge."},{"id":"semetey-1-2013:p0944:b003:l010","ordinal":149100,"en":"My precious hair, thick as a girth,"},{"id":"semetey-1-2013:p0944:b003:l011","ordinal":149101,"en":"My person has become their prize of dispute."},{"id":"semetey-1-2013:p0944:b003:l012","ordinal":149102,"en":"To Toltoi of the Jediger,"},{"id":"semetey-1-2013:p0944:b003:l013","ordinal":149103,"en":"With what face could I marry him?"},{"id":"semetey-1-2013:p0944:b003:l014","ordinal":149104,"en":"By that lusty brute who has appeared between us,"},{"id":"semetey-1-2013:p0944:b003:l015","ordinal":149105,"en":"Why should I let myself be driven away?"},{"id":"semetey-1-2013:p0944:b003:l016","ordinal":149106,"en":"The decree God has sent"},{"id":"semetey-1-2013:p0944:b003:l017","ordinal":149107,"en":"Is thus; let me face it."},{"id":"semetey-1-2013:p0944:b003:l018","ordinal":149108,"en":"Rather than bow to foolish, wretched Toltoi"},{"id":"semetey-1-2013:p0944:b003:l019","ordinal":149109,"en":"And become his wife,"},{"id":"semetey-1-2013:p0944:b003:l020","ordinal":149110,"en":"Let me die seeking a hero!"},{"id":"semetey-1-2013:p0944:b003:l021","ordinal":149111,"en":"Great Beijing, that distant city,"},{"id":"semetey-1-2013:p0944:b003:l022","ordinal":149112,"en":"Let me go to its farthest end."},{"id":"semetey-1-2013:p0944:b003:l023","ordinal":149113,"en":"With a cotton sash and broad boots,"},{"id":"semetey-1-2013:p0944:b003:l024","ordinal":149114,"en":"Kongurbai, khan of the monks—"},{"id":"semetey-1-2013:p0944:b003:l025","ordinal":149115,"en":"Traversing the face of the earth,"},{"id":"semetey-1-2013:p0944:b003:l026","ordinal":149116,"en":"The giants upon the earth,"},{"id":"semetey-1-2013:p0944:b003:l027","ordinal":149117,"en":"Let me visit every one,"},{"id":"semetey-1-2013:p0944:b003:l028","ordinal":149118,"en":"Finding support on which to rely,"},{"id":"semetey-1-2013:p0944:b003:l029","ordinal":149119,"en":"Finding a famed, mighty lion."},{"id":"semetey-1-2013:p0944:b003:l030","ordinal":149120,"en":"Upon Toltoi, who has gathered an army,"},{"id":"semetey-1-2013:p0944:b003:l031","ordinal":149121,"en":"Let me bring humiliation in this way,"},{"id":"semetey-1-2013:p0944:b003:l032","ordinal":149122,"en":"Beginning by slaughtering his Kojo,"},{"id":"semetey-1-2013:p0944:b003:l033","ordinal":149123,"en":"Let me thus take my revenge."},{"id":"semetey-1-2013:p0944:b003:l034","ordinal":149124,"en":"The four corners of the round world,"},{"id":"semetey-1-2013:p0944:b003:l035","ordinal":149125,"en":"Let me circle them four times;"},{"id":"semetey-1-2013:p0944:b003:l036","ordinal":149126,"en":"The five corners of Medina,"},{"id":"semetey-1-2013:p0944:b003:l037","ordinal":149127,"en":"Let me circle them five times,"},{"id":"semetey-1-2013:p0944:b003:l038","ordinal":149128,"en":"Seeking support in a renowned place,"},{"id":"semetey-1-2013:p0944:b003:l039","ordinal":149129,"en":"Seeking a steadfast lion."},{"id":"semetey-1-2013:p0944:b004:l001","ordinal":149130,"en":"Toltoi, who plays the lord—"},{"id":"semetey-1-2013:p0944:b004:l002","ordinal":149131,"en":"Let me have his head trampled,"},{"id":"semetey-1-2013:p0944:b004:l003","ordinal":149132,"en":"Have his four kinds of livestock scattered,"},{"id":"semetey-1-2013:p0944:b004:l004","ordinal":149133,"en":"Dig their pits deep,"},{"id":"semetey-1-2013:p0944:b004:l005","ordinal":149134,"en":"Bring utter misery upon them."},{"id":"semetey-1-2013:p0944:b004:l006","ordinal":149135,"en":"If I do not have their armies slaughtered,"},{"id":"semetey-1-2013:p0944:b004:l007","ordinal":149136,"en":"For matchless Chürök,"},{"id":"semetey-1-2013:p0944:b004:l008","ordinal":149137,"en":"Saying this,"},{"id":"semetey-1-2013:p0944:b004:l009","ordinal":149138,"en":"Uttering terribly fearsome words,"},{"id":"semetey-1-2013:p0944:b004:l010","ordinal":149139,"en":"Aichurok, daughter of Akun,"},{"id":"semetey-1-2013:p0944:b004:l011","ordinal":149140,"en":"Made herself ready and braced herself."},{"id":"semetey-1-2013:p0944:b004:l012","ordinal":149141,"en":"The wretched girl wept aloud,"},{"id":"semetey-1-2013:p0944:b004:l013","ordinal":149142,"en":"Swaying as though struck by a peri."},{"id":"semetey-1-2013:p0944:b004:l014","ordinal":149143,"en":"Upon her head was a cap made of gold;"},{"id":"semetey-1-2013:p0944:b004:l015","ordinal":149144,"en":"Born into this world,"},{"id":"semetey-1-2013:p0944:b004:l016","ordinal":149145,"en":"Akun's daughter was a wily one."},{"id":"semetey-1-2013:p0944:b004:l017","ordinal":149146,"en":"Her waist a handspan, her face like the moon,"},{"id":"semetey-1-2013:p0944:b004:l018","ordinal":149147,"en":"That ill-fated, renowned beauty."},{"id":"semetey-1-2013:p0944:b004:l019","ordinal":149148,"en":"Dear, fierce Churok—"},{"id":"semetey-1-2013:p0944:b004:l020","ordinal":149149,"en":"Which of her deeds shall we tell?"},{"id":"semetey-1-2013:p0944:b004:l021","ordinal":149150,"en":"Look at sugar, then at her words;"},{"id":"semetey-1-2013:p0944:b004:l022","ordinal":149151,"en":"Look at Venus, then at her eyes."},{"id":"semetey-1-2013:p0944:b004:l023","ordinal":149152,"en":"If blood falls upon the black earth,"},{"id":"semetey-1-2013:p0944:b004:l024","ordinal":149153,"en":"Look at her flesh, whiter than snow."},{"id":"semetey-1-2013:p0944:b004:l025","ordinal":149154,"en":"If blood falls upon snow,"},{"id":"semetey-1-2013:p0944:b004:l026","ordinal":149155,"en":"Look at the blood, then at her face."},{"id":"semetey-1-2013:p0944:b004:l027","ordinal":149156,"en":"Look at silk, then at her hair;"},{"id":"semetey-1-2013:p0944:b004:l028","ordinal":149157,"en":"Look at an apple, then at her head."},{"id":"semetey-1-2013:p0944:b004:l029","ordinal":149158,"en":"She had words spoken with cunning;"},{"id":"semetey-1-2013:p0944:b004:l030","ordinal":149159,"en":"Churok herself was a seer."},{"id":"semetey-1-2013:p0944:b004:l031","ordinal":149160,"en":"The queen worthy of a khan"},{"id":"semetey-1-2013:p0944:b004:l032","ordinal":149161,"en":"Had many kinds of words."},{"id":"semetey-1-2013:p0944:b004:l033","ordinal":149162,"en":"Above her lip,"},{"id":"semetey-1-2013:p0944:b004:l034","ordinal":149163,"en":"There was a slight upward curl,"},{"id":"semetey-1-2013:p0944:b004:l035","ordinal":149164,"en":"That ill-fated, dear Churok,"},{"id":"semetey-1-2013:p0944:b004:l036","ordinal":149165,"en":"Where was there any flaw in her?"},{"id":"semetey-1-2013:p0944:b004:l037","ordinal":149166,"en":"When she walked, her face shone;"},{"id":"semetey-1-2013:p0944:b004:l038","ordinal":149167,"en":"Sixty buttons, forty clasps,"},{"id":"semetey-1-2013:p0945:b003:l001","ordinal":149168,"en":"Upon that beautifully born dear girl's"},{"id":"semetey-1-2013:p0945:b003:l002","ordinal":149169,"en":"Breast, they jingled."},{"id":"semetey-1-2013:p0945:b003:l003","ordinal":149170,"en":"There are two traditions about her fortune,"},{"id":"semetey-1-2013:p0945:b003:l004","ordinal":149171,"en":"Unless God Himself knows,"},{"id":"semetey-1-2013:p0945:b003:l005","ordinal":149172,"en":"Akun's daughter Churok"},{"id":"semetey-1-2013:p0945:b003:l006","ordinal":149173,"en":"Has words of many kinds."},{"id":"semetey-1-2013:p0945:b003:l007","ordinal":149174,"en":"Unless God Himself knows,"},{"id":"semetey-1-2013:p0945:b003:l008","ordinal":149175,"en":"Akun's daughter Churok"},{"id":"semetey-1-2013:p0945:b003:l009","ordinal":149176,"en":"Has who knows what words."},{"id":"semetey-1-2013:p0945:b003:l010","ordinal":149177,"en":"Once, on Belendi's ridge,"},{"id":"semetey-1-2013:p0945:b003:l011","ordinal":149178,"en":"In the place where peris played,"},{"id":"semetey-1-2013:p0945:b003:l012","ordinal":149179,"en":"Khan Akun found her in a cradle."},{"id":"semetey-1-2013:p0945:b003:l013","ordinal":149180,"en":"If we listen closely, this is the tale:"},{"id":"semetey-1-2013:p0945:b003:l014","ordinal":149181,"en":"For poor Manas's son,"},{"id":"semetey-1-2013:p0945:b003:l015","ordinal":149182,"en":"A marriage alliance had been arranged."},{"id":"semetey-1-2013:p0945:b003:l016","ordinal":149183,"en":"That wily girl, a true seer,"},{"id":"semetey-1-2013:p0945:b004:l001","ordinal":149184,"en":"For Manas's only son"},{"id":"semetey-1-2013:p0945:b004:l002","ordinal":149185,"en":"Had been burning with longing."},{"id":"semetey-1-2013:p0945:b004:l003","ordinal":149186,"en":"Fortunate Toltoi—"},{"id":"semetey-1-2013:p0945:b004:l004","ordinal":149187,"en":"She knew he would become an enemy."},{"id":"semetey-1-2013:p0945:b004:l005","ordinal":149188,"en":"Manas, who had vanished—"},{"id":"semetey-1-2013:p0945:b004:l006","ordinal":149189,"en":"She had honored his spirit."},{"id":"semetey-1-2013:p0945:b004:l007","ordinal":149190,"en":"The roaring Kojo's"},{"id":"semetey-1-2013:p0945:b004:l008","ordinal":149191,"en":"Everyone learned the news."},{"id":"semetey-1-2013:p0945:b004:l009","ordinal":149192,"en":"Manas, who had gone to the other world—"},{"id":"semetey-1-2013:p0945:b004:l010","ordinal":149193,"en":"She had honored his spirit."},{"id":"semetey-1-2013:p0945:b004:l011","ordinal":149194,"en":"When Toltoi came to besiege her,"},{"id":"semetey-1-2013:p0945:b004:l012","ordinal":149195,"en":"When she suffered Kojo's humiliation,"},{"id":"semetey-1-2013:p0945:b004:l013","ordinal":149196,"en":"As her daily affairs came into order,"},{"id":"semetey-1-2013:p0945:b004:l014","ordinal":149197,"en":"To wander the whole wide world,"},{"id":"semetey-1-2013:p0945:b004:l015","ordinal":149198,"en":"The ill-fated daughter of Akun"},{"id":"semetey-1-2013:p0945:b004:l016","ordinal":149199,"en":"Resolved to disappear in flight."},{"id":"semetey-1-2013:p0945:b006:l001","ordinal":149200,"en":"Stretching like a lynx,"},{"id":"semetey-1-2013:p0945:b006:l002","ordinal":149201,"en":"Reluctant to utter words,"},{"id":"semetey-1-2013:p0945:b006:l003","ordinal":149202,"en":"With an exceedingly deep mind,"},{"id":"semetey-1-2013:p0945:b006:l004","ordinal":149203,"en":"Churok, daughter of a peri,"},{"id":"semetey-1-2013:p0945:b006:l005","ordinal":149204,"en":"Had endless things to say."},{"id":"semetey-1-2013:p0945:b006:l006","ordinal":149205,"en":"The whole world"},{"id":"semetey-1-2013:p0945:b006:l007","ordinal":149206,"en":"Was hers to wander."},{"id":"semetey-1-2013:p0945:b006:l008","ordinal":149207,"en":"No person could detect her;"},{"id":"semetey-1-2013:p0945:b006:l009","ordinal":149208,"en":"Such was her knowledge,"},{"id":"semetey-1-2013:p0945:b006:l010","ordinal":149209,"en":"No person could see her."},{"id":"semetey-1-2013:p0945:b006:l011","ordinal":149210,"en":"The four corners of the round world,"},{"id":"semetey-1-2013:p0945:b006:l012","ordinal":149211,"en":"If she circled them four times,"},{"id":"semetey-1-2013:p0945:b006:l013","ordinal":149212,"en":"She never grew weary or tired."},{"id":"semetey-1-2013:p0945:b006:l014","ordinal":149213,"en":"Even over a forty-day desert,"},{"id":"semetey-1-2013:p0945:b006:l015","ordinal":149214,"en":"She never grew tired or weary."},{"id":"semetey-1-2013:p0945:b006:l016","ordinal":149215,"en":"Whatever the many kinds of matters,"},{"id":"semetey-1-2013:p0945:b006:l017","ordinal":149216,"en":"She considered every one without exception."},{"id":"semetey-1-2013:p0945:b006:l018","ordinal":149217,"en":"Wise among women,"},{"id":"semetey-1-2013:p0945:b008:l001","ordinal":149218,"en":"No thought could flee and escape"},{"id":"semetey-1-2013:p0945:b008:l002","ordinal":149219,"en":"That infidel Churok."},{"id":"semetey-1-2013:p0945:b008:l003","ordinal":149220,"en":"Skilled was that ill-fated girl;"},{"id":"semetey-1-2013:p0945:b008:l004","ordinal":149221,"en":"Reading the Arabic tongue,"},{"id":"semetey-1-2013:p0945:b008:l005","ordinal":149222,"en":"Reciting every prayer at night,"},{"id":"semetey-1-2013:p0945:b008:l006","ordinal":149223,"en":"The day she flew was Friday,"},{"id":"semetey-1-2013:p0945:b008:l007","ordinal":149224,"en":"Her departure was on Qadr Night."},{"id":"semetey-1-2013:p0945:b008:l008","ordinal":149225,"en":"Roaming the whole world,"},{"id":"semetey-1-2013:p0945:b008:l009","ordinal":149226,"en":"Wandering over the earth,"},{"id":"semetey-1-2013:p0945:b008:l010","ordinal":149227,"en":"Chynkojo and Toltoi's"},{"id":"semetey-1-2013:p0945:b008:l011","ordinal":149228,"en":"Humiliation grieved her."},{"id":"semetey-1-2013:p0945:b008:l012","ordinal":149229,"en":"Putting on the form of a swan,"},{"id":"semetey-1-2013:p0945:b008:l013","ordinal":149230,"en":"She left Oogan, swift as a mirage."},{"id":"semetey-1-2013:p0945:b008:l014","ordinal":149231,"en":"Beating her wings, Aichurok"},{"id":"semetey-1-2013:p0945:b008:l015","ordinal":149232,"en":"Approached great Kashgar."},{"id":"semetey-1-2013:p0945:b008:l016","ordinal":149233,"en":"She saw a multitude in Kashgar;"},{"id":"semetey-1-2013:p0945:b008:l017","ordinal":149234,"en":"Your dear sister-in-law was amazed."},{"id":"semetey-1-2013:p0945:b008:l018","ordinal":149235,"en":"As she watched that people,"},{"id":"semetey-1-2013:p0946:b003:l001","ordinal":149236,"en":"They had round baked bread,"},{"id":"semetey-1-2013:p0946:b003:l002","ordinal":149237,"en":"They had four-cornered houses."},{"id":"semetey-1-2013:p0946:b003:l003","ordinal":149238,"en":"At that time, Kashgar"},{"id":"semetey-1-2013:p0946:b003:l004","ordinal":149239,"en":"Was ruled by Kangshybek."},{"id":"semetey-1-2013:p0946:b003:l005","ordinal":149240,"en":"'One of the worthy heroes,' she thought,"},{"id":"semetey-1-2013:p0946:b003:l006","ordinal":149241,"en":"And Aichurok put him to the test."},{"id":"semetey-1-2013:p0946:b003:l007","ordinal":149242,"en":"When she examined Kangshybek,"},{"id":"semetey-1-2013:p0946:b003:l008","ordinal":149243,"en":"With his bristling, tassel-like beard,"},{"id":"semetey-1-2013:p0946:b003:l009","ordinal":149244,"en":"He proved to be one of the wretched ones."},{"id":"semetey-1-2013:p0946:b003:l010","ordinal":149245,"en":"Directing his caravans,"},{"id":"semetey-1-2013:p0946:b003:l011","ordinal":149246,"en":"He was a man of the road."},{"id":"semetey-1-2013:p0946:b003:l012","ordinal":149247,"en":"Making his gray mule hold its head high,"},{"id":"semetey-1-2013:p0946:b003:l013","ordinal":149248,"en":"He rode upon a packsaddle."}]
