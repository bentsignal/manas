{"id": "sayakbay-ms-current146:pdf022:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 22, "folio": 405, "line_in_page": 17, "raw": "Артык сөзүн жаркылкан,", "text": "Артык сөзүн жаркылкан,", "en": "His noble word flashed brightly,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The final form looks like жаркылкан, perhaps a manuscript or dialectal form related to жаркылдаган; English follows that possibility.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf022:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 22, "folio": 405, "line_in_page": 18, "raw": "Түп түбүнө түрчүнүн,", "text": "Түп түбүнө түрчүнүн,", "en": "To the very root of the Türchü,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "түрчүнүн is a provisional name or ethnonym reading; the line is syntactically incomplete on its own.", "bbox": null}
