[{"id":"sayakbay-ms-current144:pdf007:l005","ordinal":389633,"en":"The blessing given [to the people?],"},{"id":"sayakbay-ms-current144:pdf007:l006","ordinal":389634,"en":"The lion, his [venerable forefather?],"},{"id":"sayakbay-ms-current144:pdf007:l007","ordinal":389635,"en":"Who cared for these dear people."},{"id":"sayakbay-ms-current144:pdf007:l008","ordinal":389636,"en":"Worthy and patient,"},{"id":"sayakbay-ms-current144:pdf007:l010","ordinal":389637,"en":"[Worthy?] in every disposition."},{"id":"sayakbay-ms-current144:pdf007:l011","ordinal":389638,"en":"The wise among the Kyrgyz,"},{"id":"sayakbay-ms-current144:pdf007:l012","ordinal":389639,"en":"The brave Kulchu, who knew the circumstances."},{"id":"sayakbay-ms-current144:pdf007:l013","ordinal":389640,"en":"The fool who knew nothing,"},{"id":"sayakbay-ms-current144:pdf007:l014","ordinal":389641,"en":"Made equal with the people's sons,"},{"id":"sayakbay-ms-current144:pdf007:l015","ordinal":389642,"en":"One person from each group,"},{"id":"sayakbay-ms-current144:pdf007:l016","ordinal":389643,"en":"Their forefather, their mainstay,"},{"id":"sayakbay-ms-current144:pdf007:l017","ordinal":389644,"en":"See his valor."},{"id":"sayakbay-ms-current144:pdf007:l018","ordinal":389645,"en":"Great and small, old and young,"},{"id":"sayakbay-ms-current144:pdf007:l019","ordinal":389646,"en":"All clamoring with one purpose."},{"id":"sayakbay-ms-current144:pdf007:l020","ordinal":389647,"en":"Should the born heroes remain behind?"},{"id":"sayakbay-ms-current144:pdf007:l021","ordinal":389648,"en":"Let us heed his words."},{"id":"sayakbay-ms-current144:pdf007:l023","ordinal":389649,"en":"Let us give them to Seytek."},{"id":"sayakbay-ms-current144:pdf007:l024","ordinal":389650,"en":"Let us notify the people,"},{"id":"sayakbay-ms-current144:pdf007:l025","ordinal":389651,"en":"[Bestowing?] the golden throne,"},{"id":"sayakbay-ms-current144:pdf007:l026","ordinal":389652,"en":"Appoint him and enthrone him,"},{"id":"sayakbay-ms-current144:pdf007:l027","ordinal":389653,"en":"Let us heed his words."},{"id":"sayakbay-ms-current144:pdf007:l028","ordinal":389654,"en":"Of the hero's surviving son,"},{"id":"sayakbay-ms-current144:pdf007:l029","ordinal":389655,"en":"Let us entrust him with authority."},{"id":"sayakbay-ms-current144:pdf007:l030","ordinal":389656,"en":"Let us notify the people,"},{"id":"sayakbay-ms-current144:pdf007:l031","ordinal":389657,"en":"The hero's surviving son,"},{"id":"sayakbay-ms-current144:pdf007:l032","ordinal":389658,"en":"For the white-capped Kyrgyz,"},{"id":"sayakbay-ms-current144:pdf007:l033","ordinal":389659,"en":"Let us raise him as khan."},{"id":"sayakbay-ms-current144:pdf008:l001","ordinal":389660,"en":"The reason for raising a khan:"},{"id":"sayakbay-ms-current144:pdf008:l002","ordinal":389661,"en":"We have the Russians [to summon?],"},{"id":"sayakbay-ms-current144:pdf008:l003","ordinal":389662,"en":"There are Kalmyks […]"},{"id":"sayakbay-ms-current144:pdf008:l004","ordinal":389663,"en":"There are mighty warriors […]"},{"id":"sayakbay-ms-current144:pdf008:l005","ordinal":389664,"en":"There are many rival enemies,"},{"id":"sayakbay-ms-current144:pdf008:l006","ordinal":389665,"en":"Ascending Ala-Too,"},{"id":"sayakbay-ms-current144:pdf008:l007","ordinal":389666,"en":"The Kyrgyz have their migrating camps."},{"id":"sayakbay-ms-current144:pdf008:l008","ordinal":389667,"en":"They would attack if able,"},{"id":"sayakbay-ms-current144:pdf008:l009","ordinal":389668,"en":"Rending lungs and spilling gall,"},{"id":"sayakbay-ms-current144:pdf008:l010","ordinal":389669,"en":"There is the populous Kyrgyz nation."},{"id":"sayakbay-ms-current144:pdf008:l011","ordinal":389670,"en":"There are many enemies to fight."},{"id":"sayakbay-ms-current144:pdf008:l015","ordinal":389671,"en":"Quickly invoking Baabedin,"},{"id":"sayakbay-ms-current144:pdf008:l017","ordinal":389672,"en":"Vast herds, worldly possessions,"},{"id":"sayakbay-ms-current144:pdf009:l001","ordinal":389673,"en":"The Kyrgyz of Ala-Too,"},{"id":"sayakbay-ms-current144:pdf009:l006","ordinal":389674,"en":"Black-bellied, blue-backed,"},{"id":"sayakbay-ms-current144:pdf009:l010","ordinal":389675,"en":"He was inscribed in their records."},{"id":"sayakbay-ms-current144:pdf010:l024","ordinal":389676,"en":"Of seething Kakanchy,"},{"id":"sayakbay-ms-current144:pdf011:l014","ordinal":389677,"en":"The youngest of sixty jaysangs,"},{"id":"sayakbay-ms-current144:pdf011:l016","ordinal":389678,"en":"The ridge’s pavilion with guy ropes,"},{"id":"sayakbay-ms-current144:pdf011:l020","ordinal":389679,"en":"Bearing a blue-steel spear,"},{"id":"sayakbay-ms-current144:pdf011:l031","ordinal":389680,"en":"Baikongur was a sovereign,"},{"id":"sayakbay-ms-current144:pdf012:l011","ordinal":389681,"en":"The once seething Kakan,"},{"id":"sayakbay-ms-current144:pdf012:l016","ordinal":389682,"en":"He ruled all Beijing,"},{"id":"sayakbay-ms-current144:pdf013:l020","ordinal":389683,"en":"While he ruled,"},{"id":"sayakbay-ms-current144:pdf013:l028","ordinal":389684,"en":"Those who opposed him,"},{"id":"sayakbay-ms-current144:pdf013:l029","ordinal":389685,"en":"The tether from their caps,"},{"id":"sayakbay-ms-current144:pdf013:l030","ordinal":389686,"en":"While he cut it away,"},{"id":"sayakbay-ms-current144:pdf013:l031","ordinal":389687,"en":"Kakanchy's golden throne,"},{"id":"sayakbay-ms-current144:pdf014:l002","ordinal":389688,"en":"While he ruled them,"},{"id":"sayakbay-ms-current144:pdf014:l006","ordinal":389689,"en":"While he ruled,"},{"id":"sayakbay-ms-current144:pdf014:l007","ordinal":389690,"en":"This wondrous, transient world,"},{"id":"sayakbay-ms-current144:pdf014:l026","ordinal":389691,"en":"Despaired of their lives,"},{"id":"sayakbay-ms-current144:pdf014:l032","ordinal":389692,"en":"When dueling with spears,"},{"id":"sayakbay-ms-current144:pdf015:l006","ordinal":389693,"en":"He had studied wondrous arts,"},{"id":"sayakbay-ms-current144:pdf015:l020","ordinal":389694,"en":"That scorched, raging wretch,"},{"id":"sayakbay-ms-current144:pdf015:l031","ordinal":389695,"en":"Despaired of their lives."},{"id":"sayakbay-ms-current144:pdf016:l016","ordinal":389696,"en":"All those who remained,"},{"id":"sayakbay-ms-current144:pdf016:l017","ordinal":389697,"en":"Fearing terrible upheaval,"},{"id":"sayakbay-ms-current144:pdf016:l018","ordinal":389698,"en":"Despaired of their lives,"},{"id":"sayakbay-ms-current144:pdf016:l020","ordinal":389699,"en":"Asking what had happened to the khan,"},{"id":"sayakbay-ms-current144:pdf016:l029","ordinal":389700,"en":"Despairing of their lives,"},{"id":"sayakbay-ms-current144:pdf017:l002","ordinal":389701,"en":"Do not ask about his tower."},{"id":"sayakbay-ms-current144:pdf017:l018","ordinal":389702,"en":"He too had assembled them."},{"id":"sayakbay-ms-current144:pdf017:l023","ordinal":389703,"en":"[Bound like a stone mist?],"},{"id":"sayakbay-ms-current144:pdf018:l005","ordinal":389704,"en":"He had poured into its foundations,"},{"id":"sayakbay-ms-current144:pdf018:l011","ordinal":389705,"en":"That scorched, raging wretch,"},{"id":"sayakbay-ms-current144:pdf018:l017","ordinal":389706,"en":"Do not ask about his tower,"},{"id":"sayakbay-ms-current144:pdf019:l003","ordinal":389707,"en":"That scorched, raging wretch,"},{"id":"sayakbay-ms-current144:pdf019:l014","ordinal":389708,"en":"The enemies who fought him,"},{"id":"sayakbay-ms-current144:pdf019:l032","ordinal":389709,"en":"[Uncertain: Bedoo's … places.]"},{"id":"sayakbay-ms-current144:pdf020:l001","ordinal":389710,"en":"[May he devastate and burn them?],"},{"id":"sayakbay-ms-current144:pdf020:l002","ordinal":389711,"en":"You have seen suffering […],"},{"id":"sayakbay-ms-current144:pdf020:l003","ordinal":389712,"en":"Without razing it utterly,"},{"id":"sayakbay-ms-current144:pdf020:l014","ordinal":389713,"en":"The sorcerer guarding the gate,"},{"id":"sayakbay-ms-current144:pdf020:l017","ordinal":389714,"en":"Speaking softly, then firmly,"},{"id":"sayakbay-ms-current144:pdf020:l018","ordinal":389715,"en":"He began his speech."},{"id":"sayakbay-ms-current144:pdf021:l016","ordinal":389716,"en":"His fortune deserted him,"},{"id":"sayakbay-ms-current144:pdf021:l021","ordinal":389717,"en":"Came through my royal father,"},{"id":"sayakbay-ms-current144:pdf021:l024","ordinal":389718,"en":"The moon waned and days passed,"},{"id":"sayakbay-ms-current144:pdf021:l031","ordinal":389719,"en":"He reached ninety-five years,"},{"id":"sayakbay-ms-current144:pdf022:l006","ordinal":389720,"en":"He pursued vengeance for Manas."},{"id":"sayakbay-ms-current144:pdf022:l018","ordinal":389721,"en":"Of this faithless world,"},{"id":"sayakbay-ms-current144:pdf022:l024","ordinal":389722,"en":"If my darling lives,"},{"id":"sayakbay-ms-current144:pdf022:l027","ordinal":389723,"en":"A father's vengeance remained,"},{"id":"sayakbay-ms-current144:pdf022:l028","ordinal":389724,"en":"His grandfather died, leaving vengeance."},{"id":"sayakbay-ms-current144:pdf023:l002","ordinal":389725,"en":"He will unleash a slaughter,"},{"id":"sayakbay-ms-current144:pdf023:l005","ordinal":389726,"en":"Deepest sorrow was revealed,"},{"id":"sayakbay-ms-current144:pdf023:l006","ordinal":389727,"en":"Saying, the Burut humiliated us,"},{"id":"sayakbay-ms-current144:pdf023:l007","ordinal":389728,"en":"We suffered disgrace and hardship,"},{"id":"sayakbay-ms-current144:pdf023:l008","ordinal":389729,"en":"All the neighboring peoples,"},{"id":"sayakbay-ms-current144:pdf023:l009","ordinal":389730,"en":"Young and old alike,"},{"id":"sayakbay-ms-current144:pdf023:l010","ordinal":389731,"en":"[Selecting them, he slaughtered the people?],"},{"id":"sayakbay-ms-current144:pdf023:l011","ordinal":389732,"en":"He wielded such a heavy fist,"},{"id":"sayakbay-ms-current144:pdf023:l012","ordinal":389733,"en":"The aftermath was a calamity,"},{"id":"sayakbay-ms-current144:pdf023:l013","ordinal":389734,"en":"He mowed down those he encountered,"},{"id":"sayakbay-ms-current144:pdf023:l014","ordinal":389735,"en":"My grandfather in his old age,"},{"id":"sayakbay-ms-current144:pdf023:l015","ordinal":389736,"en":"The attacking Kyrgyz cut down,"},{"id":"sayakbay-ms-current144:pdf023:l016","ordinal":389737,"en":"He crushed [the multitude?] severely,"},{"id":"sayakbay-ms-current144:pdf023:l017","ordinal":389738,"en":"The Chinese people of forty khans,"},{"id":"sayakbay-ms-current144:pdf023:l018","ordinal":389739,"en":"He left leaderless and poor,"},{"id":"sayakbay-ms-current144:pdf023:l019","ordinal":389740,"en":"He inflicted extreme oppression,"},{"id":"sayakbay-ms-current144:pdf023:l020","ordinal":389741,"en":"That commanding, raging wretch,"},{"id":"sayakbay-ms-current144:pdf023:l021","ordinal":389742,"en":"He acted by spreading terror,"},{"id":"sayakbay-ms-current144:pdf023:l022","ordinal":389743,"en":"He inflicted [terrible?] plunder,"},{"id":"sayakbay-ms-current144:pdf023:l023","ordinal":389744,"en":"The khans adorned with stones,"},{"id":"sayakbay-ms-current144:pdf023:l024","ordinal":389745,"en":"He smashed to pieces,"},{"id":"sayakbay-ms-current144:pdf023:l025","ordinal":389746,"en":"What devastation he wrought,"},{"id":"sayakbay-ms-current144:pdf023:l026","ordinal":389747,"en":"The grieving people cried out,"},{"id":"sayakbay-ms-current144:pdf023:l027","ordinal":389748,"en":"How many of Kakan lamented,"},{"id":"sayakbay-ms-current144:pdf023:l028","ordinal":389749,"en":"Through his fury, many souls,"},{"id":"sayakbay-ms-current144:pdf023:l029","ordinal":389750,"en":"[Had not yet looked upon it?],"},{"id":"sayakbay-ms-current144:pdf023:l031","ordinal":389751,"en":"The dignitaries adorned with stones,"},{"id":"sayakbay-ms-current144:pdf023:l032","ordinal":389752,"en":"The capable rulers of the people,"},{"id":"sayakbay-ms-current144:pdf023:l033","ordinal":389753,"en":"Kakan's foremost leaders,"},{"id":"sayakbay-ms-current144:pdf024:l001","ordinal":389754,"en":"The Burut slew them all,"},{"id":"sayakbay-ms-current144:pdf024:l002","ordinal":389755,"en":"That scorched, raging wretch,"},{"id":"sayakbay-ms-current144:pdf024:l003","ordinal":389756,"en":"Committing monstrous deeds,"},{"id":"sayakbay-ms-current144:pdf024:l004","ordinal":389757,"en":"Cold, unapproachable Beijing,"},{"id":"sayakbay-ms-current144:pdf024:l005","ordinal":389758,"en":"He leveled its ancient fortress,"},{"id":"sayakbay-ms-current144:pdf024:l006","ordinal":389759,"en":"The Chinese tribes as kin,"},{"id":"sayakbay-ms-current144:pdf024:l007","ordinal":389760,"en":"Every one endured humiliation,"},{"id":"sayakbay-ms-current144:pdf024:l008","ordinal":389761,"en":"Its khans, lords and gates,"},{"id":"sayakbay-ms-current144:pdf024:l009","ordinal":389762,"en":"His terrible fury was known,"},{"id":"sayakbay-ms-current144:pdf024:l010","ordinal":389763,"en":"The devastation wrought by the Burut,"},{"id":"sayakbay-ms-current144:pdf024:l011","ordinal":389764,"en":"From ancient times, among the Chinese,"},{"id":"sayakbay-ms-current144:pdf024:l012","ordinal":389765,"en":"Was inscribed in their records,"},{"id":"sayakbay-ms-current144:pdf024:l013","ordinal":389766,"en":"Pouring out fury, wringing out blood,"},{"id":"sayakbay-ms-current144:pdf024:l014","ordinal":389767,"en":"After bloodthirsty Manas,"},{"id":"sayakbay-ms-current144:pdf024:l015","ordinal":389768,"en":"Brave Semetey, Manas's son,"},{"id":"sayakbay-ms-current144:pdf024:l016","ordinal":389769,"en":"His enormous destruction,"},{"id":"sayakbay-ms-current144:pdf024:l017","ordinal":389770,"en":"Of the great Chinese nation,"},{"id":"sayakbay-ms-current144:pdf024:l018","ordinal":389771,"en":"Was entered in its records."},{"id":"sayakbay-ms-current144:pdf024:l020","ordinal":389772,"en":"Killing and troubling the people,"},{"id":"sayakbay-ms-current144:pdf024:l021","ordinal":389773,"en":"Of overturned Kakan,"},{"id":"sayakbay-ms-current144:pdf024:l022","ordinal":389774,"en":"Spreading nets in its forests,"},{"id":"sayakbay-ms-current144:pdf024:l023","ordinal":389775,"en":"Attacking the scattered people,"},{"id":"sayakbay-ms-current144:pdf024:l024","ordinal":389776,"en":"Wherever white yurts stood,"},{"id":"sayakbay-ms-current144:pdf024:l025","ordinal":389777,"en":"He slew your distant forefather,"},{"id":"sayakbay-ms-current144:pdf024:l026","ordinal":389778,"en":"In this ravaged Beijing,"},{"id":"sayakbay-ms-current144:pdf024:l027","ordinal":389779,"en":"Not one elder remained."},{"id":"sayakbay-ms-current144:pdf024:l032","ordinal":389780,"en":"Many [Kaldai?] who saw his bearing,"},{"id":"sayakbay-ms-current144:pdf025:l001","ordinal":389781,"en":"No one could find a remedy,"},{"id":"sayakbay-ms-current144:pdf025:l002","ordinal":389782,"en":"Despairing of their lives,"},{"id":"sayakbay-ms-current144:pdf025:l003","ordinal":389783,"en":"Before mighty Kite,"},{"id":"sayakbay-ms-current144:pdf025:l004","ordinal":389784,"en":"They gathered at his call,"},{"id":"sayakbay-ms-current144:pdf025:l005","ordinal":389785,"en":"Finding no suitable words,"},{"id":"sayakbay-ms-current144:pdf025:l006","ordinal":389786,"en":"Neither turning nor shaking their heads,"},{"id":"sayakbay-ms-current144:pdf025:l007","ordinal":389787,"en":"They despaired, thinking themselves lost,"},{"id":"sayakbay-ms-current144:pdf025:l008","ordinal":389788,"en":"Those who came murmured,"},{"id":"sayakbay-ms-current144:pdf025:l009","ordinal":389789,"en":"No one could endure his wrath,"},{"id":"sayakbay-ms-current144:pdf025:l010","ordinal":389790,"en":"They did not speak boldly to their khan,"},{"id":"sayakbay-ms-current144:pdf025:l011","ordinal":389791,"en":"Shuffling and digging at the ground,"},{"id":"sayakbay-ms-current144:pdf025:l012","ordinal":389792,"en":"Like twigs cast into water,"},{"id":"sayakbay-ms-current144:pdf025:l013","ordinal":389793,"en":"They swayed, finding no solution,"},{"id":"sayakbay-ms-current144:pdf025:l014","ordinal":389794,"en":"[The khan demanded service?],"},{"id":"sayakbay-ms-current144:pdf025:l015","ordinal":389795,"en":"Reasoned words were needed,"},{"id":"sayakbay-ms-current144:pdf025:l016","ordinal":389796,"en":"The khan, now a dragon,"},{"id":"sayakbay-ms-current144:pdf025:l017","ordinal":389797,"en":"Needed a hero to approach cautiously."},{"id":"sayakbay-ms-current144:pdf025:l018","ordinal":389798,"en":"Wondering what befell the khan,"},{"id":"sayakbay-ms-current144:pdf025:l019","ordinal":389799,"en":"The multitude witnessed his wrath,"},{"id":"sayakbay-ms-current144:pdf025:l020","ordinal":389800,"en":"He was a great man and a lion,"},{"id":"sayakbay-ms-current144:pdf025:l021","ordinal":389801,"en":"His menace extraordinary, his venom strong,"},{"id":"sayakbay-ms-current144:pdf025:l022","ordinal":389802,"en":"When told, he performed the task properly,"},{"id":"sayakbay-ms-current144:pdf025:l023","ordinal":389803,"en":"When he braced himself resolutely,"},{"id":"sayakbay-ms-current144:pdf025:l024","ordinal":389804,"en":"That wavering, god-cursed man."},{"id":"sayakbay-ms-current144:pdf025:l025","ordinal":389805,"en":"Do not ask about Kite,"},{"id":"sayakbay-ms-current144:pdf025:l026","ordinal":389806,"en":"His imposing stature did not diminish,"},{"id":"sayakbay-ms-current144:pdf026:l003","ordinal":389807,"en":"He began commanding from the tower,"},{"id":"sayakbay-ms-current144:pdf026:l008","ordinal":389808,"en":"Who could say a second word?"},{"id":"sayakbay-ms-current144:pdf026:l022","ordinal":389809,"en":"At Kentung in Kendeme,"},{"id":"sayakbay-ms-current144:pdf027:l006","ordinal":389810,"en":"Those schooled in wondrous arts,"},{"id":"sayakbay-ms-current144:pdf027:l021","ordinal":389811,"en":"Summer clouds to winter days,"},{"id":"sayakbay-ms-current144:pdf027:l023","ordinal":389812,"en":"The dark khan from Beijing,"},{"id":"sayakbay-ms-current144:pdf028:l001","ordinal":389813,"en":"The worthy rulers of the people,"},{"id":"sayakbay-ms-current144:pdf028:l002","ordinal":389814,"en":"Those of [equally?] rough conduct,"},{"id":"sayakbay-ms-current144:pdf028:l003","ordinal":389815,"en":"Bad and good gathered together,"},{"id":"sayakbay-ms-current144:pdf028:l004","ordinal":389816,"en":"Chongbilgich, schooled in wonders,"},{"id":"sayakbay-ms-current144:pdf028:l005","ordinal":389817,"en":"The mighty champion, great [Tongus?],"},{"id":"sayakbay-ms-current144:pdf028:l006","ordinal":389818,"en":"His distant forefather Kara Joy,"},{"id":"sayakbay-ms-current144:pdf028:l007","ordinal":389819,"en":"That warrior who bore the banner,"},{"id":"sayakbay-ms-current144:pdf028:l008","ordinal":389820,"en":"The people standing beneath the banner,"},{"id":"sayakbay-ms-current144:pdf028:l009","ordinal":389821,"en":"His own father Kojojash,"},{"id":"sayakbay-ms-current144:pdf028:l010","ordinal":389822,"en":"A warrior who oversaw the world,"},{"id":"sayakbay-ms-current144:pdf028:l011","ordinal":389823,"en":"Chongbilgich, descended from Kojojash,"},{"id":"sayakbay-ms-current144:pdf028:l012","ordinal":389824,"en":"Wiser still than his forefather,"},{"id":"sayakbay-ms-current144:pdf028:l013","ordinal":389825,"en":"Beyond champions and others,"},{"id":"sayakbay-ms-current144:pdf028:l014","ordinal":389826,"en":"The foremost sorcerer and distinguished man,"},{"id":"sayakbay-ms-current144:pdf028:l015","ordinal":389827,"en":"Wiser than the spearmen,"},{"id":"sayakbay-ms-current144:pdf028:l016","ordinal":389828,"en":"[He did not rage like a savage?],"},{"id":"sayakbay-ms-current144:pdf028:l017","ordinal":389829,"en":"Among khans such as these,"},{"id":"sayakbay-ms-current144:pdf028:l018","ordinal":389830,"en":"The raging wretch spared none,"},{"id":"sayakbay-ms-current144:pdf028:l019","ordinal":389831,"en":"[His head full of much wisdom?],"},{"id":"sayakbay-ms-current144:pdf028:l020","ordinal":389832,"en":"Beijing's people gathered,"},{"id":"sayakbay-ms-current144:pdf028:l021","ordinal":389833,"en":"Slaughtering mules, boars and camels,"},{"id":"sayakbay-ms-current144:pdf028:l022","ordinal":389834,"en":"[We washed in the idol temple?],"},{"id":"sayakbay-ms-current144:pdf028:l023","ordinal":389835,"en":"They held a feast for their deity,"},{"id":"sayakbay-ms-current144:pdf028:l024","ordinal":389836,"en":"[He had them tested at the tablecloth?],"},{"id":"sayakbay-ms-current144:pdf028:l025","ordinal":389837,"en":"He entrusted it to skilled craftsmen,"},{"id":"sayakbay-ms-current144:pdf028:l026","ordinal":389838,"en":"[Without appointing a lord in Beijing?],"},{"id":"sayakbay-ms-current144:pdf028:l027","ordinal":389839,"en":"Firmly fastening his collared coat,"},{"id":"sayakbay-ms-current144:pdf028:l028","ordinal":389840,"en":"Gathering many of Beijing's people,"},{"id":"sayakbay-ms-current144:pdf028:l029","ordinal":389841,"en":"He made the promise firm,"},{"id":"sayakbay-ms-current144:pdf028:l030","ordinal":389842,"en":"At the foot of the golden throne,"},{"id":"sayakbay-ms-current144:pdf028:l031","ordinal":389843,"en":"To serve the khan, he said."},{"id":"sayakbay-ms-current144:pdf029:l001","ordinal":389844,"en":"If fire consumes the earth's surface,"},{"id":"sayakbay-ms-current144:pdf029:l002","ordinal":389845,"en":"If mountains engulf all the plains,"},{"id":"sayakbay-ms-current144:pdf029:l003","ordinal":389846,"en":"If enemies conquer Beijing,"},{"id":"sayakbay-ms-current144:pdf029:l005","ordinal":389847,"en":"Without swaying or budging,"},{"id":"sayakbay-ms-current144:pdf029:l006","ordinal":389848,"en":"Let the sage stand farther back,"},{"id":"sayakbay-ms-current144:pdf029:l007","ordinal":389849,"en":"His father and grandfather,"},{"id":"sayakbay-ms-current144:pdf029:l008","ordinal":389850,"en":"Let them serve Beijing,"},{"id":"sayakbay-ms-current144:pdf029:l009","ordinal":389851,"en":"The great giant guarding the throne,"},{"id":"sayakbay-ms-current144:pdf029:l010","ordinal":389852,"en":"Let him stand motionless,"},{"id":"sayakbay-ms-current144:pdf029:l011","ordinal":389853,"en":"Raiding and raising an uproar,"},{"id":"sayakbay-ms-current144:pdf029:l012","ordinal":389854,"en":"[Exercising authority?] and making a stir,"},{"id":"sayakbay-ms-current144:pdf029:l013","ordinal":389855,"en":"Scolding those who would not obey,"},{"id":"sayakbay-ms-current144:pdf029:l014","ordinal":389856,"en":"A looming presence like Mount Kap,"},{"id":"sayakbay-ms-current144:pdf029:l015","ordinal":389857,"en":"Lest he turn to rebellion,"},{"id":"sayakbay-ms-current144:pdf029:l016","ordinal":389858,"en":"He had secured him thus,"},{"id":"sayakbay-ms-current144:pdf029:l017","ordinal":389859,"en":"The dark khan's golden throne,"},{"id":"sayakbay-ms-current144:pdf029:l018","ordinal":389860,"en":"[He secured the space before the throne?],"},{"id":"sayakbay-ms-current144:pdf029:l019","ordinal":389861,"en":"Not knowing this, great Kite,"},{"id":"sayakbay-ms-current144:pdf029:l020","ordinal":389862,"en":"Late in the afternoon,"},{"id":"sayakbay-ms-current144:pdf029:l021","ordinal":389863,"en":"Kojojash's sage,"},{"id":"sayakbay-ms-current144:pdf029:l022","ordinal":389864,"en":"[Swifter to seize than a lion?],"},{"id":"sayakbay-ms-current144:pdf029:l023","ordinal":389865,"en":"Let him leave his throne and come,"},{"id":"sayakbay-ms-current144:pdf029:l024","ordinal":389866,"en":"Let him obey these words,"},{"id":"sayakbay-ms-current144:pdf029:l025","ordinal":389867,"en":"If the learned man rules,"},{"id":"sayakbay-ms-current144:pdf029:l026","ordinal":389868,"en":"If the wretch acts proudly,"},{"id":"sayakbay-ms-current144:pdf029:l027","ordinal":389869,"en":"Of the Solon, Shibe and Manchu,"},{"id":"sayakbay-ms-current144:pdf029:l028","ordinal":389870,"en":"The dog-eating, louse-eating Chinese,"},{"id":"sayakbay-ms-current144:pdf029:l029","ordinal":389871,"en":"[Your troublesome, salt-born one?],"},{"id":"sayakbay-ms-current144:pdf029:l030","ordinal":389872,"en":"Let him witness it from his house,"},{"id":"sayakbay-ms-current144:pdf029:l031","ordinal":389873,"en":"His throne will be smashed, he said."},{"id":"sayakbay-ms-current144:pdf030:l012","ordinal":389874,"en":"Saying, these are Manchu and Chinese,"},{"id":"sayakbay-ms-current144:pdf030:l023","ordinal":389875,"en":"To the foot of Kendeme,"},{"id":"sayakbay-ms-current144:pdf031:l010","ordinal":389876,"en":"They say the Burut slew his grandfather,"},{"id":"sayakbay-ms-current144:pdf031:l011","ordinal":389877,"en":"Those who struck his forefather,"},{"id":"sayakbay-ms-current144:pdf031:l012","ordinal":389878,"en":"They say they gouged out his eyes,"},{"id":"sayakbay-ms-current144:pdf031:l013","ordinal":389879,"en":"From fierce, valiant Kalcha,"},{"id":"sayakbay-ms-current144:pdf031:l014","ordinal":389880,"en":"He was not left childless, they say,"},{"id":"sayakbay-ms-current144:pdf031:l015","ordinal":389881,"en":"When the Burut slew his father,"},{"id":"sayakbay-ms-current144:pdf031:l016","ordinal":389882,"en":"Baikongur remained, they say,"},{"id":"sayakbay-ms-current144:pdf031:l017","ordinal":389883,"en":"When he reached forty-nine,"},{"id":"sayakbay-ms-current144:pdf031:l018","ordinal":389884,"en":"God struck Kongur down, they say,"},{"id":"sayakbay-ms-current144:pdf031:l019","ordinal":389885,"en":"Kite was born of Kongur,"},{"id":"sayakbay-ms-current144:pdf031:l020","ordinal":389886,"en":"Black-headed and two-legged,"},{"id":"sayakbay-ms-current144:pdf031:l021","ordinal":389887,"en":"He became no better than a beast,"},{"id":"sayakbay-ms-current144:pdf031:l022","ordinal":389888,"en":"The people shouted in uproar,"}]
