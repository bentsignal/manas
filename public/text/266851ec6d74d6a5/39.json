[{"id":"manas-2010:p0224:b001:l045","ordinal":9985,"en":"They took swords in hand,"},{"id":"manas-2010:p0224:b001:l046","ordinal":9986,"en":"Slashed crosswise at each other."},{"id":"manas-2010:p0224:b001:l047","ordinal":9987,"en":"The swords broke and shattered;"},{"id":"manas-2010:p0224:b001:l048","ordinal":9988,"en":"Now their sheaths stood empty."},{"id":"manas-2010:p0225:b001:l001","ordinal":9989,"en":"A bitter ordeal, a great battle,"},{"id":"manas-2010:p0225:b001:l002","ordinal":9990,"en":"Now it brought slaughter to mind."},{"id":"manas-2010:p0225:b001:l003","ordinal":9991,"en":"Against giants as great as mountains,"},{"id":"manas-2010:p0225:b001:l004","ordinal":9992,"en":"What could dear Manas do?"},{"id":"manas-2010:p0225:b001:l005","ordinal":9993,"en":"He now stood facing them."},{"id":"manas-2010:p0225:b001:l006","ordinal":9994,"en":"Kaman the giant and Zhoon the giant,"},{"id":"manas-2010:p0225:b001:l007","ordinal":9995,"en":"Their strength was extraordinary."},{"id":"manas-2010:p0225:b001:l008","ordinal":9996,"en":"Those dogs, may their houses burn,"},{"id":"manas-2010:p0225:b001:l009","ordinal":9997,"en":"Their valor was considerable."},{"id":"manas-2010:p0225:b001:l010","ordinal":9998,"en":"When they stood before the khan,"},{"id":"manas-2010:p0225:b001:l011","ordinal":9999,"en":"They spared no one they met."},{"id":"manas-2010:p0225:b001:l012","ordinal":10000,"en":"No one who faced them survived;"},{"id":"manas-2010:p0225:b001:l013","ordinal":10001,"en":"No mortal dared approach them."},{"id":"manas-2010:p0225:b001:l014","ordinal":10002,"en":"‘They might do some mischief,’ they said,"},{"id":"manas-2010:p0225:b001:l015","ordinal":10003,"en":"And bound them with chains."},{"id":"manas-2010:p0225:b001:l016","ordinal":10004,"en":"They were champions, they were heroes;"},{"id":"manas-2010:p0225:b001:l017","ordinal":10005,"en":"With the valiant hero Manas,"},{"id":"manas-2010:p0225:b001:l018","ordinal":10006,"en":"They had come to grips."},{"id":"manas-2010:p0225:b001:l019","ordinal":10007,"en":"Like the wind in a gorge,"},{"id":"manas-2010:p0225:b001:l020","ordinal":10008,"en":"They thundered in wrath."},{"id":"manas-2010:p0225:b001:l021","ordinal":10009,"en":"Like the flood of a raging river,"},{"id":"manas-2010:p0225:b001:l022","ordinal":10010,"en":"The earth shook and rumbled."},{"id":"manas-2010:p0225:b001:l023","ordinal":10011,"en":"Standing face to face,"},{"id":"manas-2010:p0225:b001:l024","ordinal":10012,"en":"Manas and these giants"},{"id":"manas-2010:p0225:b001:l025","ordinal":10013,"en":"Fought unlike other mortals."},{"id":"manas-2010:p0225:b001:l026","ordinal":10014,"en":"Created a lion by God,"},{"id":"manas-2010:p0225:b001:l027","ordinal":10015,"en":"What a lion was the hero Manas!"},{"id":"manas-2010:p0225:b001:l028","ordinal":10016,"en":"Facing Manas,"},{"id":"manas-2010:p0225:b001:l029","ordinal":10017,"en":"Zhoon the giant and Kaman the giant,"},{"id":"manas-2010:p0225:b001:l030","ordinal":10018,"en":"What heroes were those two?"},{"id":"manas-2010:p0225:b001:l031","ordinal":10019,"en":"Gripping collars and pulling,"},{"id":"manas-2010:p0225:b001:l032","ordinal":10020,"en":"The swift steeds beneath them"},{"id":"manas-2010:p0225:b001:l033","ordinal":10021,"en":"Sank knee-deep into the earth."},{"id":"manas-2010:p0225:b001:l034","ordinal":10022,"en":"They tore all their coats,"},{"id":"manas-2010:p0225:b001:l035","ordinal":10023,"en":"Standing opposite each other,"},{"id":"manas-2010:p0225:b001:l036","ordinal":10024,"en":"Firing guns and drawing bows,"},{"id":"manas-2010:p0225:b001:l037","ordinal":10025,"en":"Crashing against each other in battle,"},{"id":"manas-2010:p0225:b001:l038","ordinal":10026,"en":"Standing face to face."},{"id":"manas-2010:p0225:b001:l039","ordinal":10027,"en":"With no other means remaining,"},{"id":"manas-2010:p0225:b001:l040","ordinal":10028,"en":"They fought with maces."},{"id":"manas-2010:p0225:b001:l041","ordinal":10029,"en":"Scissor-eared Kaman the giant,"},{"id":"manas-2010:p0225:b001:l042","ordinal":10030,"en":"As he reached your bloodthirsty one,"},{"id":"manas-2010:p0225:b001:l043","ordinal":10031,"en":"Wolf-maned Manas now came up."},{"id":"manas-2010:p0225:b001:l044","ordinal":10032,"en":"Before one could say this or that,"},{"id":"manas-2010:p0225:b001:l045","ordinal":10033,"en":"Before an eye could blink,"},{"id":"manas-2010:p0225:b001:l046","ordinal":10034,"en":"Your valiant Manas, the bloodthirsty lion,"},{"id":"manas-2010:p0225:b001:l047","ordinal":10035,"en":"Whipped Toruchaar"},{"id":"manas-2010:p0225:b001:l048","ordinal":10036,"en":"And reached them without stopping."},{"id":"manas-2010:p0226:b001:l001","ordinal":10037,"en":"His steel mace in his hand,"},{"id":"manas-2010:p0226:b001:l002","ordinal":10038,"en":"He drew it and rode past."},{"id":"manas-2010:p0226:b001:l003","ordinal":10039,"en":"Roaring in wrath,"},{"id":"manas-2010:p0226:b001:l004","ordinal":10040,"en":"Crying the battle cry ‘Kyrgyz!’"},{"id":"manas-2010:p0226:b001:l005","ordinal":10041,"en":"Your bloodthirsty lion Manas's"},{"id":"manas-2010:p0226:b001:l006","ordinal":10042,"en":"White teeth, like a gate,"},{"id":"manas-2010:p0226:b001:l007","ordinal":10043,"en":"Teeth unlike other people's,"},{"id":"manas-2010:p0226:b001:l008","ordinal":10044,"en":"Jutted out white and grim."},{"id":"manas-2010:p0226:b001:l009","ordinal":10045,"en":"His wrath extraordinary, his menace fierce,"},{"id":"manas-2010:p0226:b001:l010","ordinal":10046,"en":"He would lay flat whoever fought him."},{"id":"manas-2010:p0226:b001:l011","ordinal":10047,"en":"His eyes blazed like a lion's."},{"id":"manas-2010:p0226:b001:l012","ordinal":10048,"en":"Wolf-maned Manas the lion's"},{"id":"manas-2010:p0226:b001:l013","ordinal":10049,"en":"Thirst for blood seized him firmly."},{"id":"manas-2010:p0226:b001:l014","ordinal":10050,"en":"The steel mace in his hand,"},{"id":"manas-2010:p0226:b001:l015","ordinal":10051,"en":"He grasped it firmly and swung it round."},{"id":"manas-2010:p0226:b001:l016","ordinal":10052,"en":"Vulture-tailed Zhoon the giant,"},{"id":"manas-2010:p0226:b001:l017","ordinal":10053,"en":"He struck him on the crown."},{"id":"manas-2010:p0226:b001:l018","ordinal":10054,"en":"The mace shattered into fragments."},{"id":"manas-2010:p0226:b001:l019","ordinal":10055,"en":"The helmet of blue-gray iron"},{"id":"manas-2010:p0226:b001:l020","ordinal":10056,"en":"Flew whirring into the sky."},{"id":"manas-2010:p0226:b001:l021","ordinal":10057,"en":"Your vulture-tailed Zhoon the giant's"},{"id":"manas-2010:p0226:b001:l022","ordinal":10058,"en":"Life departed with a scream."},{"id":"manas-2010:p0226:b001:l023","ordinal":10059,"en":"The wolf-maned one did not leave him unhurt."},{"id":"manas-2010:p0226:b001:l024","ordinal":10060,"en":"Passing from this world, Zhoon the giant"},{"id":"manas-2010:p0226:b001:l025","ordinal":10061,"en":"Fell from his rhinoceros."},{"id":"manas-2010:p0226:b001:l026","ordinal":10062,"en":"The Chinese were many, he was alone;"},{"id":"manas-2010:p0226:b001:l027","ordinal":10063,"en":"He began a costly spectacle."},{"id":"manas-2010:p0226:b001:l028","ordinal":10064,"en":"Zhoon the giant, chief of forty zhaysangs,"},{"id":"manas-2010:p0226:b001:l029","ordinal":10065,"en":"Valiant Manas the leopard"},{"id":"manas-2010:p0226:b001:l030","ordinal":10066,"en":"Slaughtered him utterly."},{"id":"manas-2010:p0226:b001:l031","ordinal":10067,"en":"They fought a mighty battle,"},{"id":"manas-2010:p0226:b001:l032","ordinal":10068,"en":"Fought without looking back."},{"id":"manas-2010:p0226:b001:l033","ordinal":10069,"en":"He took no measure of the day's time;"},{"id":"manas-2010:p0226:b001:l034","ordinal":10070,"en":"He never rested during the day."},{"id":"manas-2010:p0226:b001:l035","ordinal":10071,"en":"Without sleeping propped on his elbow,"},{"id":"manas-2010:p0226:b001:l036","ordinal":10072,"en":"Without a moment's quiet rest,"},{"id":"manas-2010:p0226:b001:l037","ordinal":10073,"en":"Manas fought in earnest;"},{"id":"manas-2010:p0226:b001:l038","ordinal":10074,"en":"His bloodthirstiness became known."},{"id":"manas-2010:p0226:b001:l039","ordinal":10075,"en":"‘He is a blood-drinking wolf-maned one,’ they said."},{"id":"manas-2010:p0226:b001:l040","ordinal":10076,"en":"Manas's great name,"},{"id":"manas-2010:p0226:b001:l041","ordinal":10077,"en":"In Beijing's Esenkan's"},{"id":"manas-2010:p0226:b001:l042","ordinal":10078,"en":"Register it was written."},{"id":"manas-2010:p0226:b001:l043","ordinal":10079,"en":"He began a terrible slaughter."},{"id":"manas-2010:p0226:b001:l044","ordinal":10080,"en":"Esenkan's envoys,"},{"id":"manas-2010:p0226:b001:l045","ordinal":10081,"en":"His stern land-guarding wardens,"},{"id":"manas-2010:p0226:b001:l046","ordinal":10082,"en":"He slaughtered, leaving none."},{"id":"manas-2010:p0226:b001:l047","ordinal":10083,"en":"Who has known such a struggle?"},{"id":"manas-2010:p0226:b001:l048","ordinal":10084,"en":"While your valiant Manas was there,"},{"id":"manas-2010:p0227:b001:l001","ordinal":10085,"en":"He brought great turmoil upon the Chinese."},{"id":"manas-2010:p0227:b001:l002","ordinal":10086,"en":"Seeing it, there can be no regret."},{"id":"manas-2010:p0227:b001:l003","ordinal":10087,"en":"The tale of Bloodthirsty Manas,"},{"id":"manas-2010:p0227:b001:l004","ordinal":10088,"en":"The great strife he brought upon the Kalmyks."},{"id":"manas-2010:p0227:b001:l005","ordinal":10089,"en":"He himself was born in Altai."},{"id":"manas-2010:p0227:b001:l006","ordinal":10090,"en":"When he reached twelve,"},{"id":"manas-2010:p0227:b001:l007","ordinal":10091,"en":"Your mighty one raised uproar."},{"id":"manas-2010:p0227:b001:l008","ordinal":10092,"en":"The Black Kalmyks' and Manchus'"},{"id":"manas-2010:p0227:b001:l009","ordinal":10093,"en":"Little valleys he burned;"},{"id":"manas-2010:p0227:b001:l010","ordinal":10094,"en":"Their headmen he brought low."},{"id":"manas-2010:p0227:b001:l011","ordinal":10095,"en":"Their heroes, in extraordinary fashion,"},{"id":"manas-2010:p0227:b001:l012","ordinal":10096,"en":"He slaughtered them all and left them stretched out."},{"id":"manas-2010:p0227:b001:l013","ordinal":10097,"en":"He poured blood into clear water;"},{"id":"manas-2010:p0227:b001:l014","ordinal":10098,"en":"He set the grassy lands alight."},{"id":"manas-2010:p0227:b001:l015","ordinal":10099,"en":"He greased the little valleys;"},{"id":"manas-2010:p0227:b001:l016","ordinal":10100,"en":"He laid low those who opposed him."},{"id":"manas-2010:p0227:b001:l017","ordinal":10101,"en":"Manas wheeled upon the ridge."},{"id":"manas-2010:p0227:b001:l018","ordinal":10102,"en":"When they said, ‘Manas is coming,’"},{"id":"manas-2010:p0227:b001:l019","ordinal":10103,"en":"Their children old enough to understand words"},{"id":"manas-2010:p0227:b001:l020","ordinal":10104,"en":"Fell silent, not crying at all."},{"id":"manas-2010:p0227:b001:l021","ordinal":10105,"en":"No challenger remained alive."},{"id":"manas-2010:p0227:b001:l022","ordinal":10106,"en":"He brought a great struggle upon the kakan."},{"id":"manas-2010:p0227:b001:l023","ordinal":10107,"en":"Even in death there was no regret."},{"id":"manas-2010:p0227:b001:l024","ordinal":10108,"en":"Before, when Manas was not there,"},{"id":"manas-2010:p0227:b001:l025","ordinal":10109,"en":"The Black Kalmyks and those Manchus,"},{"id":"manas-2010:p0227:b001:l026","ordinal":10110,"en":"Upon the poor forty Kyrgyz households,"},{"id":"manas-2010:p0227:b001:l027","ordinal":10111,"en":"Would wreak thorough havoc."},{"id":"manas-2010:p0227:b001:l028","ordinal":10112,"en":"From their horses and beautiful daughters"},{"id":"manas-2010:p0227:b001:l029","ordinal":10113,"en":"They took tribute every year."},{"id":"manas-2010:p0227:b001:l030","ordinal":10114,"en":"If they did not give that tribute,"},{"id":"manas-2010:p0227:b001:l031","ordinal":10115,"en":"They did whatever they pleased."},{"id":"manas-2010:p0227:b001:l032","ordinal":10116,"en":"The Black Kalmyk and Manchu people"},{"id":"manas-2010:p0227:b001:l033","ordinal":10117,"en":"Beat and struck them without mercy."},{"id":"manas-2010:p0227:b001:l034","ordinal":10118,"en":"Before, when Manas reached twelve,"},{"id":"manas-2010:p0227:b001:l035","ordinal":10119,"en":"He unleashed fierce wrath."},{"id":"manas-2010:p0227:b001:l036","ordinal":10120,"en":"Those who came from Esenkan,"},{"id":"manas-2010:p0227:b001:l037","ordinal":10121,"en":"Those who kept doing violence,"},{"id":"manas-2010:p0227:b001:l038","ordinal":10122,"en":"He slaughtered and left stretched out."},{"id":"manas-2010:p0227:b001:l039","ordinal":10123,"en":"Many he slaughtered and left stiff."},{"id":"manas-2010:p0227:b001:l040","ordinal":10124,"en":"He began a terrible slaughter."},{"id":"manas-2010:p0227:b001:l041","ordinal":10125,"en":"Kochku and Döngö, their great giants,"},{"id":"manas-2010:p0227:b001:l042","ordinal":10126,"en":"He slaughtered them, leaving none."},{"id":"manas-2010:p0227:b001:l043","ordinal":10127,"en":"He raised fierce, bitter strife."},{"id":"manas-2010:p0227:b001:l044","ordinal":10128,"en":"On the Topurak ridge,"},{"id":"manas-2010:p0227:b001:l045","ordinal":10129,"en":"From hellish Zholoy's hands,"},{"id":"manas-2010:p0227:b001:l046","ordinal":10130,"en":"He took the tea on a thousand camels."},{"id":"manas-2010:p0227:b001:l047","ordinal":10131,"en":"He began a sweeping devastation,"},{"id":"manas-2010:p0227:b001:l048","ordinal":10132,"en":"Making his monks' napes jut out,"},{"id":"manas-2010:p0228:b001:l001","ordinal":10133,"en":"Those who provoked his wrath,"},{"id":"manas-2010:p0228:b001:l002","ordinal":10134,"en":"He castrated like livestock."},{"id":"manas-2010:p0228:b001:l003","ordinal":10135,"en":"He swept away the forelock-wearers,"},{"id":"manas-2010:p0228:b001:l004","ordinal":10136,"en":"Their finest bearing stone rank-badges,"},{"id":"manas-2010:p0228:b001:l005","ordinal":10137,"en":"He slaughtered to the last."},{"id":"manas-2010:p0228:b001:l006","ordinal":10138,"en":"Attacking Khan Manas,"},{"id":"manas-2010:p0228:b001:l007","ordinal":10139,"en":"A khan among their lords died,"},{"id":"manas-2010:p0228:b001:l008","ordinal":10140,"en":"Attacking the bloodthirsty lion,"},{"id":"manas-2010:p0228:b001:l009","ordinal":10141,"en":"All who grappled with him died."},{"id":"manas-2010:p0228:b001:l010","ordinal":10142,"en":"Vulture-tailed giant Joon"},{"id":"manas-2010:p0228:b001:l011","ordinal":10143,"en":"Was smashed to pieces and died,"},{"id":"manas-2010:p0228:b001:l012","ordinal":10144,"en":"The champions' deaths,"},{"id":"manas-2010:p0228:b001:l013","ordinal":10145,"en":"Scissor-eared giant Kaman"},{"id":"manas-2010:p0228:b001:l014","ordinal":10146,"en":"And Joloy saw together,"},{"id":"manas-2010:p0228:b001:l015","ordinal":10147,"en":"Seeing this, hero Joloy"},{"id":"manas-2010:p0228:b001:l016","ordinal":10148,"en":"Spoke to giant Kaman,"},{"id":"manas-2010:p0228:b001:l017","ordinal":10149,"en":"Turning Achbuudan's head,"},{"id":"manas-2010:p0228:b001:l018","ordinal":10150,"en":"To giant Kaman himself,"},{"id":"manas-2010:p0228:b001:l019","ordinal":10151,"en":"He told his grief:"},{"id":"manas-2010:p0228:b001:l020","ordinal":10152,"en":"“Since I have been Joloy,"},{"id":"manas-2010:p0228:b001:l021","ordinal":10153,"en":"Since I won the name of Joloy,"},{"id":"manas-2010:p0228:b001:l022","ordinal":10154,"en":"I was of the Black Kalmyk people,"},{"id":"manas-2010:p0228:b001:l023","ordinal":10155,"en":"Of Beejin with its Kakan,"},{"id":"manas-2010:p0228:b001:l024","ordinal":10156,"en":"I was a giant as huge as a mountain,"},{"id":"manas-2010:p0228:b001:l025","ordinal":10157,"en":"The pines of the broad valley,"},{"id":"manas-2010:p0228:b001:l026","ordinal":10158,"en":"I was Joloy who mowed them down,"},{"id":"manas-2010:p0228:b001:l027","ordinal":10159,"en":"Smashing whoever I met,"},{"id":"manas-2010:p0228:b001:l028","ordinal":10160,"en":"I was Joloy who drained them dry,"},{"id":"manas-2010:p0228:b001:l029","ordinal":10161,"en":"Holding a whole valley for myself,"},{"id":"manas-2010:p0228:b001:l030","ordinal":10162,"en":"I was Joloy who settled there,"},{"id":"manas-2010:p0228:b001:l031","ordinal":10163,"en":"Sparing none who grappled with me,"},{"id":"manas-2010:p0228:b001:l032","ordinal":10164,"en":"I was Joloy who drained them dry,"},{"id":"manas-2010:p0228:b001:l033","ordinal":10165,"en":"For Chynmachyn and the Kakan,"},{"id":"manas-2010:p0228:b001:l034","ordinal":10166,"en":"I was Joloy the fortress,"},{"id":"manas-2010:p0228:b001:l035","ordinal":10167,"en":"I was a warrior as huge as a mountain,"},{"id":"manas-2010:p0228:b001:l036","ordinal":10168,"en":"Crushing whoever I met,"},{"id":"manas-2010:p0228:b001:l037","ordinal":10169,"en":"I was a tiger-like warrior,"},{"id":"manas-2010:p0228:b001:l038","ordinal":10170,"en":"Destroying whoever I met,"},{"id":"manas-2010:p0228:b001:l039","ordinal":10171,"en":"I was Joloy the fortress."},{"id":"manas-2010:p0228:b001:l040","ordinal":10172,"en":"Today I have seen a true enemy,"},{"id":"manas-2010:p0228:b001:l041","ordinal":10173,"en":"My strength exhausted, my power gone,"},{"id":"manas-2010:p0228:b001:l042","ordinal":10174,"en":"Today I have suffered humiliation,"},{"id":"manas-2010:p0228:b001:l043","ordinal":10175,"en":"Of Beejin, where my fame was known,"},{"id":"manas-2010:p0228:b001:l044","ordinal":10176,"en":"I was the merciless giant,"},{"id":"manas-2010:p0228:b001:l045","ordinal":10177,"en":"I would go to face opponents,"},{"id":"manas-2010:p0228:b001:l046","ordinal":10178,"en":"Those whom Esenkan ordered,"},{"id":"manas-2010:p0228:b001:l047","ordinal":10179,"en":"I would confront and bind,"},{"id":"manas-2010:p0228:b001:l048","ordinal":10180,"en":"That Burut riding the spotted horse,"},{"id":"manas-2010:p0229:b001:l001","ordinal":10181,"en":"The Burut has destroyed me,"},{"id":"manas-2010:p0229:b001:l002","ordinal":10182,"en":"The surface of my right shoulder blade aches,"},{"id":"manas-2010:p0229:b001:l003","ordinal":10183,"en":"Oh, alas, what misery!"},{"id":"manas-2010:p0229:b001:l004","ordinal":10184,"en":"One edge of my lung aches."},{"id":"manas-2010:p0229:b001:l005","ordinal":10185,"en":"When I groan ‘Uu,’ from my mouth"},{"id":"manas-2010:p0229:b001:l006","ordinal":10186,"en":"Blood pours out in gushes,"},{"id":"manas-2010:p0229:b001:l007","ordinal":10187,"en":"My insides burn like fire,"},{"id":"manas-2010:p0229:b001:l008","ordinal":10188,"en":"Life has gone from your Joloy."},{"id":"manas-2010:p0229:b001:l009","ordinal":10189,"en":"Inside and out I am burning coals,"},{"id":"manas-2010:p0229:b001:l010","ordinal":10190,"en":"If he reaches me now and strikes once,"},{"id":"manas-2010:p0229:b001:l011","ordinal":10191,"en":"Mountain-like Joloy will be no more."},{"id":"manas-2010:p0229:b001:l012","ordinal":10192,"en":"Since I have been Joloy,"},{"id":"manas-2010:p0229:b001:l013","ordinal":10193,"en":"Draining dry those who faced me,"},{"id":"manas-2010:p0229:b001:l014","ordinal":10194,"en":"Eating seven batmans of wheat,"},{"id":"manas-2010:p0229:b001:l015","ordinal":10195,"en":"I was a servant smelling of grain,"},{"id":"manas-2010:p0229:b001:l016","ordinal":10196,"en":"Killing seven thousand giants,"},{"id":"manas-2010:p0229:b001:l017","ordinal":10197,"en":"I too was a warrior smelling of blood,"},{"id":"manas-2010:p0229:b001:l018","ordinal":10198,"en":"Eating eight batmans of wheat,"},{"id":"manas-2010:p0229:b001:l019","ordinal":10199,"en":"I was a son smelling of grain,"},{"id":"manas-2010:p0229:b001:l020","ordinal":10200,"en":"Slaughtering many wherever I reached,"},{"id":"manas-2010:p0229:b001:l021","ordinal":10201,"en":"I too was a warrior smelling of demons."},{"id":"manas-2010:p0229:b001:l022","ordinal":10202,"en":"I, Joloy, am close to death,"},{"id":"manas-2010:p0229:b001:l023","ordinal":10203,"en":"I stand just at the point of departure,"},{"id":"manas-2010:p0229:b001:l024","ordinal":10204,"en":"Today I am close to being extinguished,"},{"id":"manas-2010:p0229:b001:l025","ordinal":10205,"en":"My head has become a bucket of blood,"},{"id":"manas-2010:p0229:b001:l026","ordinal":10206,"en":"The whole of my body"},{"id":"manas-2010:p0229:b001:l027","ordinal":10207,"en":"Is paralyzed and cannot stir."},{"id":"manas-2010:p0229:b001:l028","ordinal":10208,"en":"I have utterly despaired of life,"},{"id":"manas-2010:p0229:b001:l029","ordinal":10209,"en":"The Burut's blood-shedder Manas,"},{"id":"manas-2010:p0229:b001:l030","ordinal":10210,"en":"Their treacherous one born for havoc,"},{"id":"manas-2010:p0229:b001:l031","ordinal":10211,"en":"Is no being to spare a life,"},{"id":"manas-2010:p0229:b001:l032","ordinal":10212,"en":"He is no child born for nothing,"},{"id":"manas-2010:p0229:b001:l033","ordinal":10213,"en":"If this Manas grows up,"},{"id":"manas-2010:p0229:b001:l034","ordinal":10214,"en":"I think he will unleash terrible wrath,"},{"id":"manas-2010:p0229:b001:l035","ordinal":10215,"en":"This Burut—may he burn to death!—"},{"id":"manas-2010:p0229:b001:l036","ordinal":10216,"en":"I think he will take vengeance far and wide,"},{"id":"manas-2010:p0229:b001:l037","ordinal":10217,"en":"Destroying whoever he meets,"},{"id":"manas-2010:p0229:b001:l038","ordinal":10218,"en":"I think he will slaughter them as sacrifices,"},{"id":"manas-2010:p0229:b001:l039","ordinal":10219,"en":"If we clash with him, we shall die,"},{"id":"manas-2010:p0229:b001:l040","ordinal":10220,"en":"Chynmachyn, Kakanchyn,"},{"id":"manas-2010:p0229:b001:l041","ordinal":10221,"en":"If we live, just wait,"},{"id":"manas-2010:p0229:b001:l042","ordinal":10222,"en":"From that Burut—may he burn!—"},{"id":"manas-2010:p0229:b001:l043","ordinal":10223,"en":"We shall suffer a dog's humiliation."},{"id":"manas-2010:p0229:b001:l044","ordinal":10224,"en":"He has fiery, destructive eyes,"},{"id":"manas-2010:p0229:b001:l045","ordinal":10225,"en":"No mortal who faces him will fare well,"},{"id":"manas-2010:p0229:b001:l046","ordinal":10226,"en":"Against that damned Burut,"},{"id":"manas-2010:p0229:b001:l047","ordinal":10227,"en":"No man who stands will remain unharmed."},{"id":"manas-2010:p0229:b001:l048","ordinal":10228,"en":"That turbulent Burut's"},{"id":"manas-2010:p0230:b001:l001","ordinal":10229,"en":"Given name is ‘Chong Jindi,’"},{"id":"manas-2010:p0230:b001:l002","ordinal":10230,"en":"That Burut—may your house burn!—"},{"id":"manas-2010:p0230:b001:l003","ordinal":10231,"en":"Who knew of this stratagem?"},{"id":"manas-2010:p0230:b001:l004","ordinal":10232,"en":"I did not come with the seer,"},{"id":"manas-2010:p0230:b001:l005","ordinal":10233,"en":"I did not see Jakyp's son,"},{"id":"manas-2010:p0230:b001:l006","ordinal":10234,"en":"I was caught unawares,"},{"id":"manas-2010:p0230:b001:l007","ordinal":10235,"en":"Not seeing his son beforehand,"},{"id":"manas-2010:p0230:b001:l008","ordinal":10236,"en":"I had been blind."},{"id":"manas-2010:p0230:b001:l009","ordinal":10237,"en":"Since I have been Joloy,"},{"id":"manas-2010:p0230:b001:l010","ordinal":10238,"en":"Since I won the name of Joloy,"},{"id":"manas-2010:p0230:b001:l011","ordinal":10239,"en":"I have seen no such calamity."},{"id":"manas-2010:p0230:b001:l012","ordinal":10240,"en":"Let us scatter our wealth,"}]
