[{"id":"manas-2010:p0805:b001:l014","ordinal":35585,"en":"Quick to grasp and know, Azhybay,"},{"id":"manas-2010:p0805:b001:l015","ordinal":35586,"en":"He never falters in speech."},{"id":"manas-2010:p0805:b001:l016","ordinal":35587,"en":"His appearance and bearing:"},{"id":"manas-2010:p0805:b001:l017","ordinal":35588,"en":"Tall in stature, broad in shoulder,"},{"id":"manas-2010:p0805:b001:l018","ordinal":35589,"en":"Both a champion and a lion,"},{"id":"manas-2010:p0805:b001:l019","ordinal":35590,"en":"Long-bearded, thick-mustached,"},{"id":"manas-2010:p0805:b001:l020","ordinal":35591,"en":"Red-faced and large-eyed,"},{"id":"manas-2010:p0805:b001:l021","ordinal":35592,"en":"The most radiant of heroic men."},{"id":"manas-2010:p0805:b001:l022","ordinal":35593,"en":"If you ask of Azhybay,"},{"id":"manas-2010:p0805:b001:l023","ordinal":35594,"en":"The handsome one of the forty champions,"},{"id":"manas-2010:p0805:b001:l024","ordinal":35595,"en":"Open-faced and cheerful,"},{"id":"manas-2010:p0805:b001:l025","ordinal":35596,"en":"Khan Manas's champion."},{"id":"manas-2010:p0805:b001:l026","ordinal":35597,"en":"When grievous difficulty came,"},{"id":"manas-2010:p0805:b001:l027","ordinal":35598,"en":"When dear life was sorely pressed,"},{"id":"manas-2010:p0805:b001:l028","ordinal":35599,"en":"Always it was Azhybay"},{"id":"manas-2010:p0805:b001:l029","ordinal":35600,"en":"Who went before the khan."},{"id":"manas-2010:p0805:b001:l030","ordinal":35601,"en":"Lion Bakay, finder of stratagems,"},{"id":"manas-2010:p0805:b001:l031","ordinal":35602,"en":"Had begun a wondrous undertaking."},{"id":"manas-2010:p0805:b001:l032","ordinal":35603,"en":"To valiant hero Azhybay,"},{"id":"manas-2010:p0805:b001:l033","ordinal":35604,"en":"He gave this command:"},{"id":"manas-2010:p0805:b001:l034","ordinal":35605,"en":"‘Argyn Khan's Azhybay,"},{"id":"manas-2010:p0805:b001:l035","ordinal":35606,"en":"To Shooruk, khan with a royal court,"},{"id":"manas-2010:p0805:b001:l036","ordinal":35607,"en":"Go without turning back and return."},{"id":"manas-2010:p0805:b001:l037","ordinal":35608,"en":"Of your rich and telling speech,"},{"id":"manas-2010:p0805:b001:l038","ordinal":35609,"en":"Now pour it forth without stint!"},{"id":"manas-2010:p0805:b001:l039","ordinal":35610,"en":"A khan's doorway is Judgment Day;"},{"id":"manas-2010:p0805:b001:l040","ordinal":35611,"en":"It takes a hero to contrive an entry."},{"id":"manas-2010:p0805:b001:l041","ordinal":35612,"en":"A hero's doorway is solid iron;"},{"id":"manas-2010:p0805:b001:l042","ordinal":35613,"en":"It takes a hero to melt it,"},{"id":"manas-2010:p0806:b001:l001","ordinal":35614,"en":"As envoy before the khan,"},{"id":"manas-2010:p0806:b001:l002","ordinal":35615,"en":"Khan Azhybay, you are needed!"},{"id":"manas-2010:p0806:b001:l003","ordinal":35616,"en":"Your bravery is considerable;"},{"id":"manas-2010:p0806:b001:l004","ordinal":35617,"en":"Your eloquence is extraordinary."},{"id":"manas-2010:p0806:b001:l005","ordinal":35618,"en":"Draw your sword and speak decisively."},{"id":"manas-2010:p0806:b001:l006","ordinal":35619,"en":"You are a destroyer, Azhybay;"},{"id":"manas-2010:p0806:b001:l007","ordinal":35620,"en":"Speak quickly, without groaning!"},{"id":"manas-2010:p0806:b001:l008","ordinal":35621,"en":"If he says, “I shall exchange shots,”"},{"id":"manas-2010:p0806:b001:l009","ordinal":35622,"en":"Let him choose his marksmen."},{"id":"manas-2010:p0806:b001:l010","ordinal":35623,"en":"Mighty Manas will exchange shots;"},{"id":"manas-2010:p0806:b001:l011","ordinal":35624,"en":"Hero Bakay will grapple."},{"id":"manas-2010:p0806:b001:l012","ordinal":35625,"en":"The forty champions will make the charge;"},{"id":"manas-2010:p0806:b001:l013","ordinal":35626,"en":"Let him have no regrets."},{"id":"manas-2010:p0806:b001:l014","ordinal":35627,"en":"Let him believe these words of yours."},{"id":"manas-2010:p0806:b001:l015","ordinal":35628,"en":"If Khan Shooruk says he will fight,"},{"id":"manas-2010:p0806:b001:l016","ordinal":35629,"en":"Tell him to come forth now,"},{"id":"manas-2010:p0806:b001:l017","ordinal":35630,"en":"To the ground where battle is to be joined."},{"id":"manas-2010:p0806:b001:l018","ordinal":35631,"en":"That Manas is bloodthirsty,"},{"id":"manas-2010:p0806:b001:l019","ordinal":35632,"en":"Tell Khan Shooruk to learn it now."},{"id":"manas-2010:p0806:b001:l020","ordinal":35633,"en":"If he has no wish to grapple,"},{"id":"manas-2010:p0806:b001:l021","ordinal":35634,"en":"Let his tongue pronounce the profession of faith,"},{"id":"manas-2010:p0806:b001:l022","ordinal":35635,"en":"Let belief enter his heart,"},{"id":"manas-2010:p0806:b001:l023","ordinal":35636,"en":"Tell him to enter the Muslim faith."},{"id":"manas-2010:p0806:b001:l024","ordinal":35637,"en":"The tough-souled bloodthirsty one's"},{"id":"manas-2010:p0806:b001:l025","ordinal":35638,"en":"Demands, tell him to obey."},{"id":"manas-2010:p0806:b001:l026","ordinal":35639,"en":"Thimble-mouthed, with eyes like a camel calf,"},{"id":"manas-2010:p0806:b001:l027","ordinal":35640,"en":"In a crimson dress, slender-waisted,"},{"id":"manas-2010:p0806:b001:l028","ordinal":35641,"en":"Tell him to give his daughter as a tribute!"},{"id":"manas-2010:p0806:b001:l029","ordinal":35642,"en":"If he does not obey those words,"},{"id":"manas-2010:p0806:b001:l030","ordinal":35643,"en":"If he does not give his daughter as a tribute,"},{"id":"manas-2010:p0806:b001:l031","ordinal":35644,"en":"Diverting water into his orchards,"},{"id":"manas-2010:p0806:b001:l032","ordinal":35645,"en":"We shall turn them into garden plots."},{"id":"manas-2010:p0806:b001:l033","ordinal":35646,"en":"Demolishing all his houses,"},{"id":"manas-2010:p0806:b001:l034","ordinal":35647,"en":"Felling all his willows,"},{"id":"manas-2010:p0806:b001:l035","ordinal":35648,"en":"Smashing his walled fort,"},{"id":"manas-2010:p0806:b001:l036","ordinal":35649,"en":"Toppling his earthen fort,"},{"id":"manas-2010:p0806:b001:l037","ordinal":35650,"en":"We shall bring utter slaughter!"},{"id":"manas-2010:p0806:b001:l038","ordinal":35651,"en":"If Khan Shooruk grows angry,"},{"id":"manas-2010:p0806:b001:l039","ordinal":35652,"en":"Mounted on wondrous steeds, breaking the ranks,"},{"id":"manas-2010:p0806:b001:l040","ordinal":35653,"en":"We shall sport at spear-fighting."},{"id":"manas-2010:p0806:b001:l041","ordinal":35654,"en":"If Shooruk strains against us,"},{"id":"manas-2010:p0806:b001:l042","ordinal":35655,"en":"We shall not spare his fly-like little soul."},{"id":"manas-2010:p0807:b001:l001","ordinal":35656,"en":"Never sated by drinking blood,"},{"id":"manas-2010:p0807:b001:l002","ordinal":35657,"en":"Named Manas, the blue-maned warrior—"},{"id":"manas-2010:p0807:b001:l003","ordinal":35658,"en":"Go tell him, ‘Your lion has come.’"},{"id":"manas-2010:p0807:b001:l004","ordinal":35659,"en":"Driving white deer like cattle,"},{"id":"manas-2010:p0807:b001:l005","ordinal":35660,"en":"Routing enemies who exchange fire,"},{"id":"manas-2010:p0807:b001:l006","ordinal":35661,"en":"The two khans Azhybay and Bakay—"},{"id":"manas-2010:p0807:b001:l007","ordinal":35662,"en":"Go tell him, ‘Your khan has come.’"},{"id":"manas-2010:p0807:b001:l008","ordinal":35663,"en":"Drinking poison when told to drink water,"},{"id":"manas-2010:p0807:b001:l009","ordinal":35664,"en":"Cutting off heads when told to take hats,"},{"id":"manas-2010:p0807:b001:l010","ordinal":35665,"en":"Khan Manas's forty mighty warriors—"},{"id":"manas-2010:p0807:b001:l011","ordinal":35666,"en":"Go tell him, ‘All have come.’"},{"id":"manas-2010:p0807:b001:l012","ordinal":35667,"en":"Without quarrels, without disputes,"},{"id":"manas-2010:p0807:b001:l013","ordinal":35668,"en":"Tell him to accept these words."},{"id":"manas-2010:p0807:b001:l014","ordinal":35669,"en":"If he will not accept these words,"},{"id":"manas-2010:p0807:b001:l015","ordinal":35670,"en":"Tell him, ‘Slaughtered without a trace,"},{"id":"manas-2010:p0807:b001:l016","ordinal":35671,"en":"You will perish, root and all!’"},{"id":"manas-2010:p0807:b001:l017","ordinal":35672,"en":"Striking the gray steed's flank once,"},{"id":"manas-2010:p0807:b001:l018","ordinal":35673,"en":"Taking the blue-mottled spear in hand,"},{"id":"manas-2010:p0807:b001:l019","ordinal":35674,"en":"I shall cry the battle cry ‘Manas!’"},{"id":"manas-2010:p0807:b001:l020","ordinal":35675,"en":"If he will not accept these words,"},{"id":"manas-2010:p0807:b001:l021","ordinal":35676,"en":"Damn your father's grave, Shooruk—"},{"id":"manas-2010:p0807:b001:l022","ordinal":35677,"en":"I shall knock all his fury out,"},{"id":"manas-2010:p0807:b001:l023","ordinal":35678,"en":"Slaughter his men of strength,"},{"id":"manas-2010:p0807:b001:l024","ordinal":35679,"en":"Do whatever I see fit."},{"id":"manas-2010:p0807:b001:l025","ordinal":35680,"en":"The daughters he refuses when asked—"},{"id":"manas-2010:p0807:b001:l026","ordinal":35681,"en":"I shall cast a cold catching pole over them."},{"id":"manas-2010:p0807:b001:l027","ordinal":35682,"en":"His city where no one sets foot—"},{"id":"manas-2010:p0807:b001:l028","ordinal":35683,"en":"I shall walk straight through it."},{"id":"manas-2010:p0807:b001:l029","ordinal":35684,"en":"His cherished daughters—"},{"id":"manas-2010:p0807:b001:l030","ordinal":35685,"en":"I shall drag them from the palace!"},{"id":"manas-2010:p0807:b001:l031","ordinal":35686,"en":"Tell him to hear these words."},{"id":"manas-2010:p0807:b001:l032","ordinal":35687,"en":"If he has the heart to fight,"},{"id":"manas-2010:p0807:b001:l033","ordinal":35688,"en":"Tell him to come out against us."},{"id":"manas-2010:p0807:b001:l034","ordinal":35689,"en":"Let them stand face to face."},{"id":"manas-2010:p0807:b001:l035","ordinal":35690,"en":"If Khan Shooruk is a warrior,"},{"id":"manas-2010:p0807:b001:l036","ordinal":35691,"en":"Let him fire guns and draw bows,"},{"id":"manas-2010:p0807:b001:l037","ordinal":35692,"en":"Fight amid the booming shots."},{"id":"manas-2010:p0807:b001:l038","ordinal":35693,"en":"If Shooruk bares his teeth,"},{"id":"manas-2010:p0807:b001:l039","ordinal":35694,"en":"There is a spear to thrust at him."},{"id":"manas-2010:p0807:b001:l040","ordinal":35695,"en":"If he will not heed these words,"},{"id":"manas-2010:p0807:b001:l041","ordinal":35696,"en":"If he will not listen to you,"},{"id":"manas-2010:p0807:b001:l042","ordinal":35697,"en":"Deliver your envoy's message and return."},{"id":"manas-2010:p0808:b001:l001","ordinal":35698,"en":"Return early, my Azhy!"},{"id":"manas-2010:p0808:b001:l002","ordinal":35699,"en":"My name is wise Bakay;"},{"id":"manas-2010:p0808:b001:l003","ordinal":35700,"en":"Let the quarrel be mine.”"},{"id":"manas-2010:p0808:b001:l004","ordinal":35701,"en":"The saintly Bakay spoke,"},{"id":"manas-2010:p0808:b001:l005","ordinal":35702,"en":"Then turned his gray steed, they say."},{"id":"manas-2010:p0808:b001:l006","ordinal":35703,"en":"His banner fluttered in his hand,"},{"id":"manas-2010:p0808:b001:l007","ordinal":35704,"en":"The battle-axe with golden cheeks"},{"id":"manas-2010:p0808:b001:l008","ordinal":35705,"en":"Flashed against his bare wrist."},{"id":"manas-2010:p0808:b001:l009","ordinal":35706,"en":"Sheltered by his blue shield,"},{"id":"manas-2010:p0808:b001:l010","ordinal":35707,"en":"If you could see Khan Bakay,"},{"id":"manas-2010:p0808:b001:l011","ordinal":35708,"en":"He sprang like a blue tiger."},{"id":"manas-2010:p0808:b001:l012","ordinal":35709,"en":"His elder, blue-maned Bakay,"},{"id":"manas-2010:p0808:b001:l013","ordinal":35710,"en":"Looked to all like a vast army."},{"id":"manas-2010:p0808:b001:l014","ordinal":35711,"en":"On the northern side,"},{"id":"manas-2010:p0808:b001:l015","ordinal":35712,"en":"His face like oiled wheat,"},{"id":"manas-2010:p0808:b001:l016","ordinal":35713,"en":"His eyes like twilight mist,"},{"id":"manas-2010:p0808:b001:l017","ordinal":35714,"en":"Staring fiercely, eyes blazing,"},{"id":"manas-2010:p0808:b001:l018","ordinal":35715,"en":"His thirst for blood truly upon him,"},{"id":"manas-2010:p0808:b001:l019","ordinal":35716,"en":"The dun horse beneath him"},{"id":"manas-2010:p0808:b001:l020","ordinal":35717,"en":"Kept clashing on the bit,"},{"id":"manas-2010:p0808:b001:l021","ordinal":35718,"en":"Its tail like strands of silk"},{"id":"manas-2010:p0808:b001:l022","ordinal":35719,"en":"Lashing against its flanks."},{"id":"manas-2010:p0808:b001:l023","ordinal":35720,"en":"The sight unsettled the heart,"},{"id":"manas-2010:p0808:b001:l024","ordinal":35721,"en":"It seemed a towering mountain."},{"id":"manas-2010:p0808:b001:l025","ordinal":35722,"en":"Raging and wrenching,"},{"id":"manas-2010:p0808:b001:l026","ordinal":35723,"en":"Twelve companions held the dun horse,"},{"id":"manas-2010:p0808:b001:l027","ordinal":35724,"en":"While it strained against their grip."},{"id":"manas-2010:p0808:b001:l028","ordinal":35725,"en":"On one side of him,"},{"id":"manas-2010:p0808:b001:l029","ordinal":35726,"en":"Khan Manas's forty companions"},{"id":"manas-2010:p0808:b001:l030","ordinal":35727,"en":"Divided among forty-one places,"},{"id":"manas-2010:p0808:b001:l031","ordinal":35728,"en":"As though about to slaughter,"},{"id":"manas-2010:p0808:b001:l032","ordinal":35729,"en":"Showing their prowess."},{"id":"manas-2010:p0808:b001:l033","ordinal":35730,"en":"All the forty companions,"},{"id":"manas-2010:p0808:b001:l034","ordinal":35731,"en":"Their elders led by Kyrgyl,"},{"id":"manas-2010:p0808:b001:l035","ordinal":35732,"en":"Sparing not their threadlike lives,"},{"id":"manas-2010:p0808:b001:l036","ordinal":35733,"en":"As though about to slaughter,"},{"id":"manas-2010:p0808:b001:l037","ordinal":35734,"en":"Laid a fierce siege,"},{"id":"manas-2010:p0808:b001:l038","ordinal":35735,"en":"Bringing upon a mighty khan like Shooruk"},{"id":"manas-2010:p0808:b001:l039","ordinal":35736,"en":"The Day of Judgment."},{"id":"manas-2010:p0808:b001:l040","ordinal":35737,"en":"If warrior Manas gave the order,"},{"id":"manas-2010:p0808:b001:l041","ordinal":35738,"en":"The companions would charge without turning,"},{"id":"manas-2010:p0808:b001:l042","ordinal":35739,"en":"Without turning, simply"},{"id":"manas-2010:p0809:b001:l001","ordinal":35740,"en":"Crush everything as they passed."},{"id":"manas-2010:p0809:b001:l002","ordinal":35741,"en":"The forty companions, each a precious warrior,"},{"id":"manas-2010:p0809:b001:l003","ordinal":35742,"en":"These lions who overthrew the world,"},{"id":"manas-2010:p0809:b001:l004","ordinal":35743,"en":"Upon Khan Shooruk's head"},{"id":"manas-2010:p0809:b001:l005","ordinal":35744,"en":"Brought calamity indeed."},{"id":"manas-2010:p0809:b001:l006","ordinal":35745,"en":"As though about to trample him,"},{"id":"manas-2010:p0809:b001:l007","ordinal":35746,"en":"They gathered all around."},{"id":"manas-2010:p0809:b001:l008","ordinal":35747,"en":"Brandishing spears, watching keenly—"},{"id":"manas-2010:p0809:b001:l009","ordinal":35748,"en":"Do not ask about the forty companions!"},{"id":"manas-2010:p0809:b001:l010","ordinal":35749,"en":"The powder in their cartridge pouches—"},{"id":"manas-2010:p0809:b001:l011","ordinal":35750,"en":"They untied the openings, making ready."},{"id":"manas-2010:p0809:b001:l012","ordinal":35751,"en":"They turned their steeds,"},{"id":"manas-2010:p0809:b001:l013","ordinal":35752,"en":"The fork-rest guns in their hands"},{"id":"manas-2010:p0809:b001:l014","ordinal":35753,"en":"They thrust forward, muzzles gaping."},{"id":"manas-2010:p0809:b001:l015","ordinal":35754,"en":"Charging at the first cry,"},{"id":"manas-2010:p0809:b001:l016","ordinal":35755,"en":"Khan Manas's forty companions,"},{"id":"manas-2010:p0809:b001:l017","ordinal":35756,"en":"If Azhybay brought the signal,"},{"id":"manas-2010:p0809:b001:l018","ordinal":35757,"en":"Would sweep forward all together,"},{"id":"manas-2010:p0809:b001:l019","ordinal":35758,"en":"Leaving not a single one,"},{"id":"manas-2010:p0809:b001:l020","ordinal":35759,"en":"Slaughtering as they passed."},{"id":"manas-2010:p0809:b001:l021","ordinal":35760,"en":"Khan Shooruk's many people"},{"id":"manas-2010:p0809:b001:l022","ordinal":35761,"en":"Lost their senses in their haste,"},{"id":"manas-2010:p0809:b001:l023","ordinal":35762,"en":"Fled in wild confusion,"},{"id":"manas-2010:p0809:b001:l024","ordinal":35763,"en":"Scattered this way and that,"},{"id":"manas-2010:p0809:b001:l025","ordinal":35764,"en":"Unable to collect themselves."},{"id":"manas-2010:p0809:b001:l026","ordinal":35765,"en":"When they saw the forty companions,"},{"id":"manas-2010:p0809:b001:l027","ordinal":35766,"en":"They fled then,"},{"id":"manas-2010:p0809:b001:l028","ordinal":35767,"en":"Bowing down toward their rawhide shoes."},{"id":"manas-2010:p0809:b001:l029","ordinal":35768,"en":"‘Keep out of sight!’ they told each other,"},{"id":"manas-2010:p0809:b001:l030","ordinal":35769,"en":"Dragging and scolding one another."},{"id":"manas-2010:p0809:b001:l031","ordinal":35770,"en":"The gateway with steel doors—"},{"id":"manas-2010:p0809:b001:l032","ordinal":35771,"en":"They fastened its entrance firmly."},{"id":"manas-2010:p0809:b001:l033","ordinal":35772,"en":"The people gathered, crying out;"},{"id":"manas-2010:p0809:b001:l034","ordinal":35773,"en":"The lords who watched the gates"},{"id":"manas-2010:p0809:b001:l035","ordinal":35774,"en":"All fled in a terrified rush."},{"id":"manas-2010:p0809:b001:l036","ordinal":35775,"en":"Azhybay of Khan Argyn"},{"id":"manas-2010:p0809:b001:l037","ordinal":35776,"en":"Took a letter from Khan Bakay,"},{"id":"manas-2010:p0809:b001:l038","ordinal":35777,"en":"Mounted Kartküröng and rode."},{"id":"manas-2010:p0809:b001:l039","ordinal":35778,"en":"The gateway with steel doors—"},{"id":"manas-2010:p0809:b001:l040","ordinal":35779,"en":"Khan Shooruk's khanate"},{"id":"manas-2010:p0809:b001:l041","ordinal":35780,"en":"Looked formidable to him."},{"id":"manas-2010:p0809:b001:l042","ordinal":35781,"en":"He entered through the gateway"},{"id":"manas-2010:p0810:b001:l001","ordinal":35782,"en":"And went on farther."},{"id":"manas-2010:p0810:b001:l002","ordinal":35783,"en":"Plane-tree gardens all around,"},{"id":"manas-2010:p0810:b001:l003","ordinal":35784,"en":"A golden throne at the center."},{"id":"manas-2010:p0810:b001:l004","ordinal":35785,"en":"Then Azhybay went"},{"id":"manas-2010:p0810:b001:l005","ordinal":35786,"en":"To his peer's golden throne,"},{"id":"manas-2010:p0810:b001:l006","ordinal":35787,"en":"Where he sat taking his ease,"},{"id":"manas-2010:p0810:b001:l007","ordinal":35788,"en":"In Khan Shooruk's garden."},{"id":"manas-2010:p0810:b001:l008","ordinal":35789,"en":"He had a garden planted in rows,"},{"id":"manas-2010:p0810:b001:l009","ordinal":35790,"en":"He had a throne within the garden,"},{"id":"manas-2010:p0810:b001:l010","ordinal":35791,"en":"And beneath those garden trees"},{"id":"manas-2010:p0810:b001:l011","ordinal":35792,"en":"There was entertainment too."},{"id":"manas-2010:p0810:b001:l012","ordinal":35793,"en":"Laid before the throne,"},{"id":"manas-2010:p0810:b001:l013","ordinal":35794,"en":"A huge carpet patterned in gold:"},{"id":"manas-2010:p0810:b001:l014","ordinal":35795,"en":"Soaked in water forty years,"},{"id":"manas-2010:p0810:b001:l015","ordinal":35796,"en":"It would not rot, decay or fade."},{"id":"manas-2010:p0810:b001:l016","ordinal":35797,"en":"Flooded for eighty years,"},{"id":"manas-2010:p0810:b001:l017","ordinal":35798,"en":"Its surface would not wear or fade."},{"id":"manas-2010:p0810:b001:l018","ordinal":35799,"en":"Beside Khan Shooruk,"},{"id":"manas-2010:p0810:b001:l019","ordinal":35800,"en":"His champions bearing clubs"},{"id":"manas-2010:p0810:b001:l020","ordinal":35801,"en":"Loomed up on every side."},{"id":"manas-2010:p0810:b001:l021","ordinal":35802,"en":"His camel-mounted soldiers"},{"id":"manas-2010:p0810:b001:l022","ordinal":35803,"en":"Towered in a ring around him."},{"id":"manas-2010:p0810:b001:l023","ordinal":35804,"en":"Warrior Azhybay marveled:"},{"id":"manas-2010:p0810:b001:l024","ordinal":35805,"en":"‘No horses, but camels—"},{"id":"manas-2010:p0810:b001:l025","ordinal":35806,"en":"What sort of doomed man is this?’"},{"id":"manas-2010:p0810:b001:l026","ordinal":35807,"en":"His champions bearing swords"},{"id":"manas-2010:p0810:b001:l027","ordinal":35808,"en":"Made a strange sight about Shooruk,"},{"id":"manas-2010:p0810:b001:l028","ordinal":35809,"en":"Standing in a ring around him."},{"id":"manas-2010:p0810:b001:l029","ordinal":35810,"en":"When they saw Azhybay,"},{"id":"manas-2010:p0810:b001:l030","ordinal":35811,"en":"The guards before the khan"},{"id":"manas-2010:p0810:b001:l031","ordinal":35812,"en":"Split apart and scattered,"},{"id":"manas-2010:p0810:b001:l032","ordinal":35813,"en":"As though they had seen a devourer,"},{"id":"manas-2010:p0810:b001:l033","ordinal":35814,"en":"Fleeing in all directions, shrieking."},{"id":"manas-2010:p0810:b001:l034","ordinal":35815,"en":"His champions wandered in confusion,"},{"id":"manas-2010:p0810:b001:l035","ordinal":35816,"en":"Marveling at Azhybay:"},{"id":"manas-2010:p0810:b001:l036","ordinal":35817,"en":"‘No human being is like this;"},{"id":"manas-2010:p0810:b001:l037","ordinal":35818,"en":"Whoever fights him will fare badly."},{"id":"manas-2010:p0810:b001:l038","ordinal":35819,"en":"If six vast armies swept upon him,"},{"id":"manas-2010:p0810:b001:l039","ordinal":35820,"en":"Not one would survive,’ they said."},{"id":"manas-2010:p0810:b001:l040","ordinal":35821,"en":"His eyes were like the beds of lakes,"},{"id":"manas-2010:p0810:b001:l041","ordinal":35822,"en":"Those who fought him—"},{"id":"manas-2010:p0810:b001:l042","ordinal":35823,"en":"As though he would suck them all in."},{"id":"manas-2010:p0811:b001:l001","ordinal":35824,"en":"‘Is he a lion, or a man?"},{"id":"manas-2010:p0811:b001:l002","ordinal":35825,"en":"His lion nature shows."},{"id":"manas-2010:p0811:b001:l003","ordinal":35826,"en":"His time to conquer has come,"},{"id":"manas-2010:p0811:b001:l004","ordinal":35827,"en":"An extraordinary upheaval upon this head—"},{"id":"manas-2010:p0811:b001:l005","ordinal":35828,"en":"His time to bring it has come.’"},{"id":"manas-2010:p0811:b001:l006","ordinal":35829,"en":"The many troops crowded to look,"},{"id":"manas-2010:p0811:b001:l007","ordinal":35830,"en":"Those who saw him marveled."},{"id":"manas-2010:p0811:b001:l008","ordinal":35831,"en":"To that warrior, Khan Shooruk,"},{"id":"manas-2010:p0811:b001:l009","ordinal":35832,"en":"Azhybay of Khan Argyn"},{"id":"manas-2010:p0811:b001:l010","ordinal":35833,"en":"Spoke quietly, placing his words firmly,"},{"id":"manas-2010:p0811:b001:l011","ordinal":35834,"en":"Beginning his account, his speech:"},{"id":"manas-2010:p0811:b001:l012","ordinal":35835,"en":"‘We are envoys come between you."},{"id":"manas-2010:p0811:b001:l013","ordinal":35836,"en":"The oppressors, the great ones—"},{"id":"manas-2010:p0811:b001:l014","ordinal":35837,"en":"We have come to meet them."},{"id":"manas-2010:p0811:b001:l015","ordinal":35838,"en":"If a mighty enemy army comes out,"},{"id":"manas-2010:p0811:b001:l016","ordinal":35839,"en":"We have come to fight to the death."},{"id":"manas-2010:p0811:b001:l017","ordinal":35840,"en":"Accept the words we speak."}]
