[{"id":"seytek-2012:p0026:b002:l036","ordinal":297217,"en":"Nine months were completed,"},{"id":"seytek-2012:p0026:b002:l037","ordinal":297218,"en":"And nearly ten months had passed."},{"id":"seytek-2012:p0026:b002:l038","ordinal":297219,"en":"Her womb grew ripe and her term was full,"},{"id":"seytek-2012:p0026:b002:l039","ordinal":297220,"en":"The appointed time and day arrived."},{"id":"seytek-2012:p0026:b002:l040","ordinal":297221,"en":"Beside moonlike Chürök"},{"id":"seytek-2012:p0026:b003:l001","ordinal":297222,"en":"Were her attendants,"},{"id":"seytek-2012:p0026:b003:l002","ordinal":297223,"en":"Sixty young wives and eighty maidens;"},{"id":"seytek-2012:p0026:b003:l003","ordinal":297224,"en":"Disguising them as herself,"},{"id":"seytek-2012:p0026:b003:l004","ordinal":297225,"en":"She sent one each day"},{"id":"seytek-2012:p0026:b003:l005","ordinal":297226,"en":"Into Khan Kyyaz’s embrace."},{"id":"seytek-2012:p0026:b003:l006","ordinal":297227,"en":"Keeping her chaste self pure,"},{"id":"seytek-2012:p0026:b003:l007","ordinal":297228,"en":"Preserving herself untouched by anything,"},{"id":"seytek-2012:p0026:b003:l008","ordinal":297229,"en":"Dear Aichürök"},{"id":"seytek-2012:p0026:b003:l009","ordinal":297230,"en":"Protected herself in this way."},{"id":"seytek-2012:p0026:b003:l010","ordinal":297231,"en":"The unfortunate woman possessed sacred powers"},{"id":"seytek-2012:p0026:b003:l011","ordinal":297232,"en":"And many miracles;"},{"id":"seytek-2012:p0026:b003:l012","ordinal":297233,"en":"Among women in flowing gowns,"},{"id":"seytek-2012:p0026:b003:l013","ordinal":297234,"en":"She was a soul who surpassed them all."},{"id":"seytek-2012:p0026:b003:l014","ordinal":297235,"en":"The tormented, ill-fated woman"},{"id":"seytek-2012:p0026:b003:l015","ordinal":297236,"en":"Had a seal upon her tongue."},{"id":"seytek-2012:p0026:b003:l016","ordinal":297237,"en":"She could sweep along at a horse’s speed"},{"id":"seytek-2012:p0026:b003:l017","ordinal":297238,"en":"And fly throughout"},{"id":"seytek-2012:p0026:b003:l018","ordinal":297239,"en":"The whole wide world;"},{"id":"seytek-2012:p0026:b003:l019","ordinal":297240,"en":"Such was the magic she possessed."},{"id":"seytek-2012:p0026:b003:l020","ordinal":297241,"en":"Only Friday knew of her flight,"},{"id":"seytek-2012:p0026:b003:l021","ordinal":297242,"en":"Only the sacred night knew of her travels;"},{"id":"seytek-2012:p0026:b003:l022","ordinal":297243,"en":"When she transformed and flew,"},{"id":"seytek-2012:p0026:b003:l023","ordinal":297244,"en":"Who could know of that single flight?"},{"id":"seytek-2012:p0026:b003:l024","ordinal":297245,"en":"She made the open plains her wondrous summer pasture,"},{"id":"seytek-2012:p0026:b003:l025","ordinal":297246,"en":"Chanting incantations like a sorcerer"},{"id":"seytek-2012:p0026:b003:l026","ordinal":297247,"en":"And casting blindness over human eyes."},{"id":"seytek-2012:p0026:b003:l027","ordinal":297248,"en":"Of all the wisdom granted humankind,"},{"id":"seytek-2012:p0026:b003:l028","ordinal":297249,"en":"Not a hair’s breadth was lacking in her."},{"id":"seytek-2012:p0026:b003:l029","ordinal":297250,"en":"Her curse was dreadful, her venom strong;"},{"id":"seytek-2012:p0026:b003:l030","ordinal":297251,"en":"Whomever she cursed, she laid low."},{"id":"seytek-2012:p0026:b003:l031","ordinal":297252,"en":"Those who saw her majesty trembled;"},{"id":"seytek-2012:p0026:b003:l032","ordinal":297253,"en":"She knew with perfect mastery"},{"id":"seytek-2012:p0026:b003:l033","ordinal":297254,"en":"The magic that blinded eyes."},{"id":"seytek-2012:p0026:b003:l034","ordinal":297255,"en":"When she transformed into a white swan,"},{"id":"seytek-2012:p0026:b003:l035","ordinal":297256,"en":"Only the darkening night knew of her flight;"},{"id":"seytek-2012:p0026:b003:l036","ordinal":297257,"en":"Who else could know that she had gone?"},{"id":"seytek-2012:p0026:b003:l037","ordinal":297258,"en":"When she unleashed her powers fully,"},{"id":"seytek-2012:p0026:b003:l038","ordinal":297259,"en":"She turned a summer day to winter"},{"id":"seytek-2012:p0026:b003:l039","ordinal":297260,"en":"And froze every summer pasture."},{"id":"seytek-2012:p0026:b003:l040","ordinal":297261,"en":"When the distraught woman gathered her strength,"},{"id":"seytek-2012:p0027:b002:l001","ordinal":297262,"en":"“Let this burning anguish subside,” she prayed,"},{"id":"seytek-2012:p0027:b002:l002","ordinal":297263,"en":"Seeking a remedy from Allah,"},{"id":"seytek-2012:p0027:b002:l003","ordinal":297264,"en":"The unfortunate woman beseeching God"},{"id":"seytek-2012:p0027:b002:l004","ordinal":297265,"en":"For the child within her womb."},{"id":"seytek-2012:p0027:b002:l005","ordinal":297266,"en":"“Grant him to me,” she pleaded;"},{"id":"seytek-2012:p0027:b002:l006","ordinal":297267,"en":"“What will he endure"},{"id":"seytek-2012:p0027:b002:l007","ordinal":297268,"en":"Among bitter enemies?"},{"id":"seytek-2012:p0027:b002:l008","ordinal":297269,"en":"If my appointed days end and death comes,"},{"id":"seytek-2012:p0027:b002:l009","ordinal":297270,"en":"What will become of him when I die?"},{"id":"seytek-2012:p0027:b002:l010","ordinal":297271,"en":"How shall I ever see"},{"id":"seytek-2012:p0027:b002:l011","ordinal":297272,"en":"The renowned young gray wolf,"},{"id":"seytek-2012:p0027:b002:l012","ordinal":297273,"en":"Born of my blood and dark eyes,"},{"id":"seytek-2012:p0027:b002:l013","ordinal":297274,"en":"The brave boy I have longed for,"},{"id":"seytek-2012:p0027:b002:l014","ordinal":297275,"en":"The hero destined before me?"},{"id":"seytek-2012:p0027:b002:l015","ordinal":297276,"en":"Alas, countless worries have torn apart my mind"},{"id":"seytek-2012:p0027:b002:l016","ordinal":297277,"en":"For the child sprung from my loins."},{"id":"seytek-2012:p0027:b002:l017","ordinal":297278,"en":"Without letting the enemy suspect,"},{"id":"seytek-2012:p0027:b002:l018","ordinal":297279,"en":"Can I entrust him to someone’s care?"},{"id":"seytek-2012:p0027:b002:l019","ordinal":297280,"en":"If they use force without warning,"},{"id":"seytek-2012:p0027:b002:l020","ordinal":297281,"en":"If they suddenly commit violence,"},{"id":"seytek-2012:p0027:b002:l021","ordinal":297282,"en":"Will they fear the watching eye?"},{"id":"seytek-2012:p0027:b002:l022","ordinal":297283,"en":"Will they act as enemies"},{"id":"seytek-2012:p0027:b002:l023","ordinal":297284,"en":"To the brave boy left by the lion?"},{"id":"seytek-2012:p0027:b002:l024","ordinal":297285,"en":"Will they kill him without delay,"},{"id":"seytek-2012:p0027:b002:l025","ordinal":297286,"en":"Before he reaches maturity?”"},{"id":"seytek-2012:p0027:b002:l026","ordinal":297287,"en":"Countless cares would not fit within her breast,"},{"id":"seytek-2012:p0027:b002:l027","ordinal":297288,"en":"Her tears streamed in a thousand rivulets;"},{"id":"seytek-2012:p0027:b002:l028","ordinal":297289,"en":"The poor woman wept all the more."},{"id":"seytek-2012:p0027:b002:l029","ordinal":297290,"en":"The reason she wept"},{"id":"seytek-2012:p0027:b002:l030","ordinal":297291,"en":"Was that she had been taken as spoil;"},{"id":"seytek-2012:p0027:b002:l031","ordinal":297292,"en":"The unfortunate woman wept in sorrow"},{"id":"seytek-2012:p0027:b002:l032","ordinal":297293,"en":"Because she had been given an evil name."},{"id":"seytek-2012:p0027:b002:l033","ordinal":297294,"en":"The reason she wept was this:"},{"id":"seytek-2012:p0027:b002:l034","ordinal":297295,"en":"She had no strong protector,"},{"id":"seytek-2012:p0027:b002:l035","ordinal":297296,"en":"No secure place to shelter,"},{"id":"seytek-2012:p0027:b002:l036","ordinal":297297,"en":"No forest into which she could flee,"},{"id":"seytek-2012:p0027:b002:l037","ordinal":297298,"en":"No Nogoy people to defend her;"},{"id":"seytek-2012:p0027:b002:l038","ordinal":297299,"en":"Her misery was beyond measure."},{"id":"seytek-2012:p0027:b002:l039","ordinal":297300,"en":"She had no renowned Kyrgyz people,"},{"id":"seytek-2012:p0027:b002:l040","ordinal":297301,"en":"Mighty as mountains, to be her hope."},{"id":"seytek-2012:p0027:b003:l001","ordinal":297302,"en":"Thus her labor came upon her."},{"id":"seytek-2012:p0027:b003:l002","ordinal":297303,"en":"On the sacred night of Friday,"},{"id":"seytek-2012:p0027:b003:l003","ordinal":297304,"en":"During the day of Thursday,"},{"id":"seytek-2012:p0027:b003:l004","ordinal":297305,"en":"Full labor came"},{"id":"seytek-2012:p0027:b003:l005","ordinal":297306,"en":"Upon moonlike Chürök,"},{"id":"seytek-2012:p0027:b003:l006","ordinal":297307,"en":"The wise and wondrous woman."},{"id":"seytek-2012:p0027:b003:l007","ordinal":297308,"en":"Her spirits failed and her flesh ached;"},{"id":"seytek-2012:p0027:b003:l008","ordinal":297309,"en":"Labor came upon Chürök."},{"id":"seytek-2012:p0027:b003:l009","ordinal":297310,"en":"Blood came as the sign of the child;"},{"id":"seytek-2012:p0027:b003:l010","ordinal":297311,"en":"Seeing the sign, she cried aloud,"},{"id":"seytek-2012:p0027:b003:l011","ordinal":297312,"en":"And Aichürök’s strength deserted her."},{"id":"seytek-2012:p0027:b003:l012","ordinal":297313,"en":"Her back throbbed with terrible pain;"},{"id":"seytek-2012:p0027:b003:l013","ordinal":297314,"en":"All her sixty joints and forty-one bones"},{"id":"seytek-2012:p0027:b003:l014","ordinal":297315,"en":"Ached without a single exception."},{"id":"seytek-2012:p0027:b003:l015","ordinal":297316,"en":"Whenever Chürök sat down,"},{"id":"seytek-2012:p0027:b003:l016","ordinal":297317,"en":"Both her dark thighs hurt;"},{"id":"seytek-2012:p0027:b003:l017","ordinal":297318,"en":"The poor woman’s bladder also ached,"},{"id":"seytek-2012:p0027:b003:l018","ordinal":297319,"en":"Leaving her unable to move."},{"id":"seytek-2012:p0027:b003:l019","ordinal":297320,"en":"Her whole body hurt,"},{"id":"seytek-2012:p0027:b003:l020","ordinal":297321,"en":"Her most intimate parts were in pain;"},{"id":"seytek-2012:p0027:b003:l021","ordinal":297322,"en":"Her labor became a terrible affliction."},{"id":"seytek-2012:p0027:b003:l022","ordinal":297323,"en":"She screamed and cried aloud,"},{"id":"seytek-2012:p0027:b003:l023","ordinal":297324,"en":"Sobbing because she could not endure it."},{"id":"seytek-2012:p0027:b003:l024","ordinal":297325,"en":"Her ribs seemed to split apart"},{"id":"seytek-2012:p0027:b003:l025","ordinal":297326,"en":"And tears poured from her eyes;"},{"id":"seytek-2012:p0027:b003:l026","ordinal":297327,"en":"Cruel, accursed death"},{"id":"seytek-2012:p0027:b003:l027","ordinal":297328,"en":"Seemed close before her eyes."},{"id":"seytek-2012:p0027:b003:l028","ordinal":297329,"en":"Sobbing, the woman Aichürök"},{"id":"seytek-2012:p0027:b003:l029","ordinal":297330,"en":"Spent her frail, fly-like life,"},{"id":"seytek-2012:p0027:b003:l030","ordinal":297331,"en":"Screaming and crying aloud:"},{"id":"seytek-2012:p0027:b003:l031","ordinal":297332,"en":"“Show me the brave boy left by my khan,"},{"id":"seytek-2012:p0027:b003:l032","ordinal":297333,"en":"The heir left by the bloodthirsty hero,"},{"id":"seytek-2012:p0027:b003:l033","ordinal":297334,"en":"The banner fastened to the spear,"},{"id":"seytek-2012:p0027:b003:l034","ordinal":297335,"en":"The gift bestowed by the betrothed,"},{"id":"seytek-2012:p0027:b003:l035","ordinal":297336,"en":"The hoofprint left by the noble steed,"},{"id":"seytek-2012:p0027:b003:l036","ordinal":297337,"en":"The brave boy left by the falcon—"},{"id":"seytek-2012:p0027:b003:l037","ordinal":297338,"en":"O God, show him to me unharmed!"},{"id":"seytek-2012:p0027:b003:l038","ordinal":297339,"en":"Make this grievous pain subside,"},{"id":"seytek-2012:p0027:b003:l039","ordinal":297340,"en":"Brighten this mirror-like face!”"},{"id":"seytek-2012:p0027:b003:l040","ordinal":297341,"en":"Her spirit was sorrow and her heart was pain;"},{"id":"seytek-2012:p0028:b002:l001","ordinal":297342,"en":"This woman earnestly begged"},{"id":"seytek-2012:p0028:b002:l002","ordinal":297343,"en":"The true God for a child."},{"id":"seytek-2012:p0028:b002:l003","ordinal":297344,"en":"After seven days had passed,"},{"id":"seytek-2012:p0028:b002:l004","ordinal":297345,"en":"When Chürök’s true labor"},{"id":"seytek-2012:p0028:b002:l005","ordinal":297346,"en":"Had lasted seven days,"},{"id":"seytek-2012:p0028:b002:l006","ordinal":297347,"en":"Her blood was spent and her strength was gone,"},{"id":"seytek-2012:p0028:b002:l007","ordinal":297348,"en":"Her power failed and her breath grew faint."},{"id":"seytek-2012:p0028:b002:l008","ordinal":297349,"en":"Wailing and wasting away for the child,"},{"id":"seytek-2012:p0028:b002:l009","ordinal":297350,"en":"She was left utterly helpless."},{"id":"seytek-2012:p0028:b002:l010","ordinal":297351,"en":"Then Aichürök"},{"id":"seytek-2012:p0028:b002:l011","ordinal":297352,"en":"Raised her voice in a scream;"},{"id":"seytek-2012:p0028:b002:l012","ordinal":297353,"en":"The lifeless trees wept,"},{"id":"seytek-2012:p0028:b002:l013","ordinal":297354,"en":"All the Creator’s works wept,"},{"id":"seytek-2012:p0028:b002:l014","ordinal":297355,"en":"Every living creature wept—"},{"id":"seytek-2012:p0028:b002:l015","ordinal":297356,"en":"Chürök’s ordeal had begun."},{"id":"seytek-2012:p0028:b002:l016","ordinal":297357,"en":"Sixty stars and seven wild sheep,"},{"id":"seytek-2012:p0028:b002:l017","ordinal":297358,"en":"Arrayed high overhead,"},{"id":"seytek-2012:p0028:b002:l018","ordinal":297359,"en":"The moon and stars sharing her travail,"},{"id":"seytek-2012:p0028:b002:l019","ordinal":297360,"en":"Labored together above her."},{"id":"seytek-2012:p0028:b002:l020","ordinal":297361,"en":"Gathering all around,"},{"id":"seytek-2012:p0028:b002:l021","ordinal":297362,"en":"The shamans of every tribe"},{"id":"seytek-2012:p0028:b002:l022","ordinal":297363,"en":"Joined her travail in a great throng."},{"id":"seytek-2012:p0028:b002:l023","ordinal":297364,"en":"Then Aichürök"},{"id":"seytek-2012:p0028:b002:l024","ordinal":297365,"en":"Labored without pause for eight days;"},{"id":"seytek-2012:p0028:b002:l025","ordinal":297366,"en":"Only a spoonful of blood remained."},{"id":"seytek-2012:p0028:b002:l026","ordinal":297367,"en":"She lost consciousness, unable even to groan,"},{"id":"seytek-2012:p0028:b002:l027","ordinal":297368,"en":"And her flesh became a bruised, blue pulp."},{"id":"seytek-2012:p0028:b002:l028","ordinal":297369,"en":"She had no voice left even to moan,"},{"id":"seytek-2012:p0028:b002:l029","ordinal":297370,"en":"And no strength remained"},{"id":"seytek-2012:p0028:b002:l030","ordinal":297371,"en":"To hide her state from Kyyaz of the Jediger."},{"id":"seytek-2012:p0028:b002:l031","ordinal":297372,"en":"Agonized by true labor,"},{"id":"seytek-2012:p0028:b002:l032","ordinal":297373,"en":"The poor woman could endure no more"},{"id":"seytek-2012:p0028:b002:l033","ordinal":297374,"en":"And despaired of her frail, fly-like life."},{"id":"seytek-2012:p0028:b002:l034","ordinal":297375,"en":"When nine days had passed,"},{"id":"seytek-2012:p0028:b002:l035","ordinal":297376,"en":"There was no way to restrain herself;"},{"id":"seytek-2012:p0028:b002:l036","ordinal":297377,"en":"None of her own gathered people were there."},{"id":"seytek-2012:p0028:b002:l037","ordinal":297378,"en":"When the bright dawn advanced"},{"id":"seytek-2012:p0028:b002:l038","ordinal":297379,"en":"And its first light glimmered,"},{"id":"seytek-2012:p0028:b002:l039","ordinal":297380,"en":"When daylight touched the earth,"},{"id":"seytek-2012:p0028:b002:l040","ordinal":297381,"en":"Stars poured down from the sky."},{"id":"seytek-2012:p0028:b003:l001","ordinal":297382,"en":"Her many thoughts unraveled,"},{"id":"seytek-2012:p0028:b003:l002","ordinal":297383,"en":"Her bewildered mind broke apart;"},{"id":"seytek-2012:p0028:b003:l003","ordinal":297384,"en":"The dark earth, sealed below,"},{"id":"seytek-2012:p0028:b003:l004","ordinal":297385,"en":"Seemed ready to take her"},{"id":"seytek-2012:p0028:b003:l005","ordinal":297386,"en":"If her head survived this ordeal."},{"id":"seytek-2012:p0028:b003:l006","ordinal":297387,"en":"From the distraught poor woman’s"},{"id":"seytek-2012:p0028:b003:l007","ordinal":297388,"en":"Quail-like eyes,"},{"id":"seytek-2012:p0028:b003:l008","ordinal":297389,"en":"Tears fell one after another;"},{"id":"seytek-2012:p0028:b003:l009","ordinal":297390,"en":"From her currant-dark eyes,"},{"id":"seytek-2012:p0028:b003:l010","ordinal":297391,"en":"As the wretched woman trembled,"},{"id":"seytek-2012:p0028:b003:l011","ordinal":297392,"en":"Tears fell a whip’s length."},{"id":"seytek-2012:p0028:b003:l012","ordinal":297393,"en":"Unable to gather and steady her thoughts,"},{"id":"seytek-2012:p0028:b003:l013","ordinal":297394,"en":"She wept in anguish from her sorrow"},{"id":"seytek-2012:p0028:b003:l014","ordinal":297395,"en":"And could not even draw back the mucus from her nose."},{"id":"seytek-2012:p0028:b003:l015","ordinal":297396,"en":"As the distraught woman lamented,"},{"id":"seytek-2012:p0028:b003:l016","ordinal":297397,"en":"Her joints loosened and came apart;"},{"id":"seytek-2012:p0028:b003:l017","ordinal":297398,"en":"Brave Kyyaz of the Jediger"},{"id":"seytek-2012:p0028:b003:l018","ordinal":297399,"en":"Appeared before her eyes"},{"id":"seytek-2012:p0028:b003:l019","ordinal":297400,"en":"Like a ravenous monster."},{"id":"seytek-2012:p0028:b003:l020","ordinal":297401,"en":"The golden doorway and gate"},{"id":"seytek-2012:p0028:b003:l021","ordinal":297402,"en":"Had panels of solid tin."},{"id":"seytek-2012:p0028:b003:l022","ordinal":297403,"en":"As for the approach to Khan Kyyaz,"},{"id":"seytek-2012:p0028:b003:l023","ordinal":297404,"en":"The looming figure’s"},{"id":"seytek-2012:p0028:b003:l024","ordinal":297405,"en":"Appearance was like this:"},{"id":"seytek-2012:p0028:b003:l025","ordinal":297406,"en":"Within the white palace,"},{"id":"seytek-2012:p0028:b003:l026","ordinal":297407,"en":"Beside the dark spring,"},{"id":"seytek-2012:p0028:b003:l027","ordinal":297408,"en":"Right by the plane tree,"},{"id":"seytek-2012:p0028:b003:l028","ordinal":297409,"en":"Surrounded by a fortress of lions—"},{"id":"seytek-2012:p0028:b003:l029","ordinal":297410,"en":"Who among humankind had ever possessed such things?"},{"id":"seytek-2012:p0028:b003:l030","ordinal":297411,"en":"Your radiant Chürök,"},{"id":"seytek-2012:p0028:b003:l031","ordinal":297412,"en":"Your formidable wonder,"},{"id":"seytek-2012:p0028:b003:l032","ordinal":297413,"en":"Your moon-beautiful wife,"},{"id":"seytek-2012:p0028:b003:l033","ordinal":297414,"en":"Your infidel rich in wisdom,"},{"id":"seytek-2012:p0028:b003:l034","ordinal":297415,"en":"Had grown old among the people, keeping the nation,"},{"id":"seytek-2012:p0028:b003:l035","ordinal":297416,"en":"And become renowned."},{"id":"seytek-2012:p0028:b003:l036","ordinal":297417,"en":"Without shame she had Mother Umai Zuura"},{"id":"seytek-2012:p0028:b003:l037","ordinal":297418,"en":"Set her womb aright,"},{"id":"seytek-2012:p0028:b003:l038","ordinal":297419,"en":"And, letting no one suspect,"},{"id":"seytek-2012:p0028:b003:l039","ordinal":297420,"en":"The distraught woman labored for seven days,"},{"id":"seytek-2012:p0028:b003:l040","ordinal":297421,"en":"Spending her frail, fly-like life."},{"id":"seytek-2012:p0030:b002:l001","ordinal":297422,"en":"From atop that tower"},{"id":"seytek-2012:p0030:b002:l002","ordinal":297423,"en":"She called out to all the assembled people."},{"id":"seytek-2012:p0030:b002:l003","ordinal":297424,"en":"“Surging hosts of the Jediger,"},{"id":"seytek-2012:p0030:b002:l004","ordinal":297425,"en":"Come, all of you!” she cried."},{"id":"seytek-2012:p0030:b002:l005","ordinal":297426,"en":"“Great dark host of the Jediger,"},{"id":"seytek-2012:p0030:b002:l006","ordinal":297427,"en":"The khan’s doorway is like Judgment Day;"},{"id":"seytek-2012:p0030:b002:l007","ordinal":297428,"en":"We need a way to pass through it."},{"id":"seytek-2012:p0030:b002:l008","ordinal":297429,"en":"The khan’s heart is massive iron;"},{"id":"seytek-2012:p0030:b002:l009","ordinal":297430,"en":"We need a way to melt it."},{"id":"seytek-2012:p0030:b002:l010","ordinal":297431,"en":"Let the renowned Jediger people"},{"id":"seytek-2012:p0030:b002:l011","ordinal":297432,"en":"Take counsel two by two."},{"id":"seytek-2012:p0030:b002:l012","ordinal":297433,"en":"Now, what do you say?"},{"id":"seytek-2012:p0030:b002:l013","ordinal":297434,"en":"Behold this dreadful matter:"},{"id":"seytek-2012:p0030:b002:l014","ordinal":297435,"en":"The tormented, ill-fated woman"},{"id":"seytek-2012:p0030:b002:l015","ordinal":297436,"en":"Has fallen into grievous labor;"},{"id":"seytek-2012:p0030:b002:l016","ordinal":297437,"en":"Come and judge her suffering."},{"id":"seytek-2012:p0030:b002:l017","ordinal":297438,"en":"Come, elders grown old among the people,"},{"id":"seytek-2012:p0030:b002:l018","ordinal":297439,"en":"All you long-eared men of wide experience"},{"id":"seytek-2012:p0030:b002:l019","ordinal":297440,"en":"Who understand the words you hear."},{"id":"seytek-2012:p0030:b002:l020","ordinal":297441,"en":"Come, you who calculate the months,"},{"id":"seytek-2012:p0030:b002:l021","ordinal":297442,"en":"You who reckon the lunar count;"},{"id":"seytek-2012:p0030:b002:l022","ordinal":297443,"en":"Come, men skilled in calculation,"},{"id":"seytek-2012:p0030:b002:l023","ordinal":297444,"en":"And hear the question I shall pose."},{"id":"seytek-2012:p0030:b002:l024","ordinal":297445,"en":"If Aichürök, Akun’s daughter,"},{"id":"seytek-2012:p0030:b002:l025","ordinal":297446,"en":"Should suddenly bear a child,"},{"id":"seytek-2012:p0030:b002:l026","ordinal":297447,"en":"Whose will it be? Consider!"},{"id":"seytek-2012:p0030:b002:l027","ordinal":297448,"en":"If moonlike Chürök"},{"id":"seytek-2012:p0030:b002:l028","ordinal":297449,"en":"Bears a child today,"},{"id":"seytek-2012:p0030:b002:l029","ordinal":297450,"en":"Whose will it be? Consider!”"},{"id":"seytek-2012:p0030:b002:l030","ordinal":297451,"en":"When the Jediger heard this,"},{"id":"seytek-2012:p0030:b002:l031","ordinal":297452,"en":"They set down the days in writing"},{"id":"seytek-2012:p0030:b002:l032","ordinal":297453,"en":"And made their reckoning of them."},{"id":"seytek-2012:p0030:b002:l033","ordinal":297454,"en":"Then they set down the months"},{"id":"seytek-2012:p0030:b002:l034","ordinal":297455,"en":"And calculated their count."},{"id":"seytek-2012:p0030:b002:l035","ordinal":297456,"en":"The shrewd and skillful elders,"},{"id":"seytek-2012:p0030:b002:l036","ordinal":297457,"en":"Like men struck by slaughter,"},{"id":"seytek-2012:p0030:b002:l037","ordinal":297458,"en":"The hard-pressed Jediger,"},{"id":"seytek-2012:p0030:b002:l038","ordinal":297459,"en":"All seethed with agitation."},{"id":"seytek-2012:p0030:b002:l039","ordinal":297460,"en":"In the marsh of Üyrülmö Hill,"},{"id":"seytek-2012:p0030:b002:l040","ordinal":297461,"en":"They held council for three days."},{"id":"seytek-2012:p0030:b003:l001","ordinal":297462,"en":"A great reverberation struck the earth;"},{"id":"seytek-2012:p0030:b003:l002","ordinal":297463,"en":"Stars appeared one by one overhead,"},{"id":"seytek-2012:p0030:b003:l003","ordinal":297464,"en":"And light quivered upon the ground."},{"id":"seytek-2012:p0030:b003:l004","ordinal":297465,"en":"Stars flashed in the heavens,"},{"id":"seytek-2012:p0030:b003:l005","ordinal":297466,"en":"Cries rang toward the qibla,"},{"id":"seytek-2012:p0030:b003:l006","ordinal":297467,"en":"The bitter wind before dawn whistled,"},{"id":"seytek-2012:p0030:b003:l007","ordinal":297468,"en":"The reed tops rattled,"},{"id":"seytek-2012:p0030:b003:l008","ordinal":297469,"en":"And fledgling larks clamored."},{"id":"seytek-2012:p0030:b003:l009","ordinal":297470,"en":"Full daylight touched the earth,"},{"id":"seytek-2012:p0030:b003:l010","ordinal":297471,"en":"And the radiant dawn advanced."},{"id":"seytek-2012:p0030:b003:l011","ordinal":297472,"en":"Every beast and living creature"}]
