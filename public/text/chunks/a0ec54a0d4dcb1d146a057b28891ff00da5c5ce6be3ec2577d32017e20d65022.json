[{"id":"manas-2010:p0379:b001:l047","ordinal":17409,"en":"Came great Döödür's onslaught."},{"id":"manas-2010:p0379:b001:l048","ordinal":17410,"en":"He was a soul whose menace was mountain-high,"},{"id":"manas-2010:p0380:b001:l001","ordinal":17411,"en":"Among the Black Kalmyks"},{"id":"manas-2010:p0380:b001:l002","ordinal":17412,"en":"There was formidable Zholoy."},{"id":"manas-2010:p0380:b001:l003","ordinal":17413,"en":"Whipping Achbuudan,"},{"id":"manas-2010:p0380:b001:l004","ordinal":17414,"en":"Your champion Zholoy arrived."},{"id":"manas-2010:p0380:b001:l005","ordinal":17415,"en":"Which of them shall we tell of?"},{"id":"manas-2010:p0380:b001:l006","ordinal":17416,"en":"Many great lords surged in."},{"id":"manas-2010:p0380:b001:l007","ordinal":17417,"en":"Their shots poured down like hail."},{"id":"manas-2010:p0380:b001:l008","ordinal":17418,"en":"Strength failed, power failed;"},{"id":"manas-2010:p0380:b001:l009","ordinal":17419,"en":"They seemed about to overwhelm him."},{"id":"manas-2010:p0380:b001:l010","ordinal":17420,"en":"Bowshots hissed,"},{"id":"manas-2010:p0380:b001:l011","ordinal":17421,"en":"The places they struck shattered."},{"id":"manas-2010:p0380:b001:l012","ordinal":17422,"en":"With strength to spare they lunged;"},{"id":"manas-2010:p0380:b001:l013","ordinal":17423,"en":"All the arm guards and armor"},{"id":"manas-2010:p0380:b001:l014","ordinal":17424,"en":"Were torn into saddle-strap strips."},{"id":"manas-2010:p0380:b001:l015","ordinal":17425,"en":"Raising battle-cries, making an uproar,"},{"id":"manas-2010:p0380:b001:l016","ordinal":17426,"en":"The Chinese now surged over him."},{"id":"manas-2010:p0380:b001:l017","ordinal":17427,"en":"Earth flew, dust swept along,"},{"id":"manas-2010:p0380:b001:l018","ordinal":17428,"en":"The massed army overwhelmed him,"},{"id":"manas-2010:p0380:b001:l019","ordinal":17429,"en":"Bringing down a terrible hell."},{"id":"manas-2010:p0380:b001:l020","ordinal":17430,"en":"From the flank Khan Zholoy,"},{"id":"manas-2010:p0380:b001:l021","ordinal":17431,"en":"Roaring in fury,"},{"id":"manas-2010:p0380:b001:l022","ordinal":17432,"en":"Their arm guards spread wide,"},{"id":"manas-2010:p0380:b001:l023","ordinal":17433,"en":"He called out to his governors:"},{"id":"manas-2010:p0380:b001:l024","ordinal":17434,"en":"“Manas has gone wandering."},{"id":"manas-2010:p0380:b001:l025","ordinal":17435,"en":"Make straight for their destruction,"},{"id":"manas-2010:p0380:b001:l026","ordinal":17436,"en":"Surge over them all;"},{"id":"manas-2010:p0380:b001:l027","ordinal":17437,"en":"Those forty households of Kyrgyz Burut,"},{"id":"manas-2010:p0380:b001:l028","ordinal":17438,"en":"Wipe them out together!"},{"id":"manas-2010:p0380:b001:l029","ordinal":17439,"en":"Let us devour their Khan Jakyp,"},{"id":"manas-2010:p0380:b001:l030","ordinal":17440,"en":"Let us take their Akbaltay!"},{"id":"manas-2010:p0380:b001:l031","ordinal":17441,"en":"A great slaughter no man could bear to see!"},{"id":"manas-2010:p0380:b001:l032","ordinal":17442,"en":"Döödür and Karazhoy,"},{"id":"manas-2010:p0380:b001:l033","ordinal":17443,"en":"You skillful ones, do not stand watching!"},{"id":"manas-2010:p0380:b001:l034","ordinal":17444,"en":"Ezkara and great Zholoy,"},{"id":"manas-2010:p0380:b001:l035","ordinal":17445,"en":"My mighty ones, do not stand watching!"},{"id":"manas-2010:p0380:b001:l036","ordinal":17446,"en":"My men with iron-rope nets,"},{"id":"manas-2010:p0380:b001:l037","ordinal":17447,"en":"Who charge at the word ‘enemy,’"},{"id":"manas-2010:p0380:b001:l038","ordinal":17448,"en":"Who come encircling,"},{"id":"manas-2010:p0380:b001:l039","ordinal":17449,"en":"My men all armed with daggers!”"},{"id":"manas-2010:p0380:b001:l040","ordinal":17450,"en":"So saying, the hero Zholoy"},{"id":"manas-2010:p0380:b001:l041","ordinal":17451,"en":"Upon Kutubiy's head"},{"id":"manas-2010:p0380:b001:l042","ordinal":17452,"en":"Began great havoc."},{"id":"manas-2010:p0380:b001:l043","ordinal":17453,"en":"He sent his wrestlers surging over him,"},{"id":"manas-2010:p0380:b001:l044","ordinal":17454,"en":"And truly made a spectacle!"},{"id":"manas-2010:p0380:b001:l045","ordinal":17455,"en":"There was no pass through which to flee"},{"id":"manas-2010:p0380:b001:l046","ordinal":17456,"en":"Near Kutubiy."},{"id":"manas-2010:p0380:b001:l047","ordinal":17457,"en":"While they clashed,"},{"id":"manas-2010:p0380:b001:l048","ordinal":17458,"en":"When Khan Zholoy thrust his spear,"},{"id":"manas-2010:p0381:b001:l001","ordinal":17459,"en":"Born greater than other men,"},{"id":"manas-2010:p0381:b001:l002","ordinal":17460,"en":"Bringing uproar on the enemy,"},{"id":"manas-2010:p0381:b001:l003","ordinal":17461,"en":"His falcon, the hero Manas, was absent."},{"id":"manas-2010:p0381:b001:l004","ordinal":17462,"en":"Akbaltay and Khan Jakyp were absent."},{"id":"manas-2010:p0381:b001:l005","ordinal":17463,"en":"Sharing death, their lives as one,"},{"id":"manas-2010:p0381:b001:l006","ordinal":17464,"en":"The forty Kyrgyz households were absent too!"},{"id":"manas-2010:p0381:b001:l007","ordinal":17465,"en":"See the wind, see the bow,"},{"id":"manas-2010:p0381:b001:l008","ordinal":17466,"en":"See the spear, see the mighty force,"},{"id":"manas-2010:p0381:b001:l009","ordinal":17467,"en":"The devastating bow, the painted arrow,"},{"id":"manas-2010:p0381:b001:l010","ordinal":17468,"en":"See the army surging over him!"},{"id":"manas-2010:p0381:b001:l011","ordinal":17469,"en":"“If my death has come, I will die."},{"id":"manas-2010:p0381:b001:l012","ordinal":17470,"en":"If I can manage it, for Kutu"},{"id":"manas-2010:p0381:b001:l013","ordinal":17471,"en":"I will become a protector,” he said."},{"id":"manas-2010:p0381:b001:l014","ordinal":17472,"en":"His white turban like a cauldron,"},{"id":"manas-2010:p0381:b001:l015","ordinal":17473,"en":"His bellow like the call to prayer,"},{"id":"manas-2010:p0381:b001:l016","ordinal":17474,"en":"His great pouch-belt an armful,"},{"id":"manas-2010:p0381:b001:l017","ordinal":17475,"en":"His courage strong, his wrath fierce,"},{"id":"manas-2010:p0381:b001:l018","ordinal":17476,"en":"Whipping Kulager,"},{"id":"manas-2010:p0381:b001:l019","ordinal":17477,"en":"Khan Baltay arrived to help."},{"id":"manas-2010:p0381:b001:l020","ordinal":17478,"en":"Finding countless stratagems,"},{"id":"manas-2010:p0381:b001:l021","ordinal":17479,"en":"When the falcons met,"},{"id":"manas-2010:p0381:b001:l022","ordinal":17480,"en":"They fought with battle-axes."},{"id":"manas-2010:p0381:b001:l023","ordinal":17481,"en":"He went among them, attacking alone,"},{"id":"manas-2010:p0381:b001:l024","ordinal":17482,"en":"To die if his strength failed,"},{"id":"manas-2010:p0381:b001:l025","ordinal":17483,"en":"Or, if his strength sufficed, Akbaltay"},{"id":"manas-2010:p0381:b001:l026","ordinal":17484,"en":"For the poor boy Kutu"},{"id":"manas-2010:p0381:b001:l027","ordinal":17485,"en":"Would become a protector."},{"id":"manas-2010:p0381:b001:l028","ordinal":17486,"en":"While these two held back the army,"},{"id":"manas-2010:p0381:b001:l029","ordinal":17487,"en":"While they stood there day and night,"},{"id":"manas-2010:p0381:b001:l030","ordinal":17488,"en":"Thrusting, holding back the army,"},{"id":"manas-2010:p0381:b001:l031","ordinal":17489,"en":"Fighting the Chinese,"},{"id":"manas-2010:p0381:b001:l032","ordinal":17490,"en":"He had scattered his countless livestock."},{"id":"manas-2010:p0381:b001:l033","ordinal":17491,"en":"Taking the forty households with him,"},{"id":"manas-2010:p0381:b001:l034","ordinal":17492,"en":"Giving neither protection nor support,"},{"id":"manas-2010:p0381:b001:l035","ordinal":17493,"en":"Jakyp had slipped quietly away."},{"id":"manas-2010:p0381:b001:l036","ordinal":17494,"en":"After Jakyp fled from Altay,"},{"id":"manas-2010:p0381:b001:l037","ordinal":17495,"en":"Caught among an immeasurable army,"},{"id":"manas-2010:p0381:b001:l038","ordinal":17496,"en":"Kutubiy and Akbaltay"},{"id":"manas-2010:p0381:b001:l039","ordinal":17497,"en":"Were still battling."},{"id":"manas-2010:p0381:b001:l040","ordinal":17498,"en":"Beyond the edge of Altay,"},{"id":"manas-2010:p0381:b001:l041","ordinal":17499,"en":"Where no plough had cut a furrow,"},{"id":"manas-2010:p0381:b001:l042","ordinal":17500,"en":"Where no marmot had dug a burrow,"},{"id":"manas-2010:p0381:b001:l043","ordinal":17501,"en":"On the broad yellow plain's"},{"id":"manas-2010:p0381:b001:l044","ordinal":17502,"en":"Lower, descending side,"},{"id":"manas-2010:p0381:b001:l045","ordinal":17503,"en":"Standing by themselves,"},{"id":"manas-2010:p0381:b001:l046","ordinal":17504,"en":"Fighting seven days without rest,"},{"id":"manas-2010:p0381:b001:l047","ordinal":17505,"en":"Exhausted, his eyes sunken,"},{"id":"manas-2010:p0381:b001:l048","ordinal":17506,"en":"Your aged uncle Baltay"},{"id":"manas-2010:p0382:b001:l001","ordinal":17507,"en":"Was struck by many spears at once."},{"id":"manas-2010:p0382:b001:l002","ordinal":17508,"en":"His two eyes sunken,"},{"id":"manas-2010:p0382:b001:l003","ordinal":17509,"en":"Your courageous Kutubiy"},{"id":"manas-2010:p0382:b001:l004","ordinal":17510,"en":"Was struck by two thousand spears at once."},{"id":"manas-2010:p0382:b001:l005","ordinal":17511,"en":"The iron helmet shattered."},{"id":"manas-2010:p0382:b001:l006","ordinal":17512,"en":"Dark blood ran in straps,"},{"id":"manas-2010:p0382:b001:l007","ordinal":17513,"en":"Streaming down the bare cheekbone."},{"id":"manas-2010:p0382:b001:l008","ordinal":17514,"en":"The two arms that had fought so bravely"},{"id":"manas-2010:p0382:b001:l009","ordinal":17515,"en":"Could not rise; they were paralyzed."},{"id":"manas-2010:p0382:b001:l010","ordinal":17516,"en":"The whole of the body"},{"id":"manas-2010:p0382:b001:l011","ordinal":17517,"en":"Was numb, unable to move."},{"id":"manas-2010:p0382:b001:l012","ordinal":17518,"en":"Strength exhausted, power gone,"},{"id":"manas-2010:p0382:b001:l013","ordinal":17519,"en":"From every part of their bodies"},{"id":"manas-2010:p0382:b001:l014","ordinal":17520,"en":"Dark blood flowed in drops."},{"id":"manas-2010:p0382:b001:l015","ordinal":17521,"en":"Going among them seven days without rest,"},{"id":"manas-2010:p0382:b001:l016","ordinal":17522,"en":"Akbaltay and Kutubiy"},{"id":"manas-2010:p0382:b001:l017","ordinal":17523,"en":"Suffered wounds in seven places."},{"id":"manas-2010:p0382:b001:l018","ordinal":17524,"en":"Going among them on a crowded day,"},{"id":"manas-2010:p0382:b001:l019","ordinal":17525,"en":"They suffered wounds in ninety places."},{"id":"manas-2010:p0382:b001:l020","ordinal":17526,"en":"Into a merciless great uproar"},{"id":"manas-2010:p0382:b001:l021","ordinal":17527,"en":"They were about to be cast."},{"id":"manas-2010:p0382:b001:l022","ordinal":17528,"en":"The giant Döödür and hero Zholoy"},{"id":"manas-2010:p0382:b001:l023","ordinal":17529,"en":"Were circling the two of them,"},{"id":"manas-2010:p0382:b001:l024","ordinal":17530,"en":"About to take them captive."},{"id":"manas-2010:p0382:b001:l025","ordinal":17531,"en":"When the Chinese came surrounding them,"},{"id":"manas-2010:p0382:b001:l026","ordinal":17532,"en":"When the rabid ones kept surging in,"},{"id":"manas-2010:p0382:b001:l027","ordinal":17533,"en":"The Chinese swarmed and ran."},{"id":"manas-2010:p0382:b001:l028","ordinal":17534,"en":"When they saw the swift foot-runners,"},{"id":"manas-2010:p0382:b001:l029","ordinal":17535,"en":"Kutubiy and Akbaltay"},{"id":"manas-2010:p0382:b001:l030","ordinal":17536,"en":"Despaired of their wretched lives."},{"id":"manas-2010:p0382:b001:l031","ordinal":17537,"en":"The wrestlers wearing arm guards"},{"id":"manas-2010:p0382:b001:l032","ordinal":17538,"en":"Had surged all around them,"},{"id":"manas-2010:p0382:b001:l033","ordinal":17539,"en":"Lying in wait to capture them."},{"id":"manas-2010:p0382:b001:l034","ordinal":17540,"en":"The swift foot-runners, the devourers,"},{"id":"manas-2010:p0382:b001:l035","ordinal":17541,"en":"Had encircled them."},{"id":"manas-2010:p0382:b001:l036","ordinal":17542,"en":"When Jakyp moved away from Altay,"},{"id":"manas-2010:p0382:b001:l037","ordinal":17543,"en":"When he hurriedly dismantled the yurts,"},{"id":"manas-2010:p0382:b001:l038","ordinal":17544,"en":"Such was the trouble the Chinese brought."},{"id":"manas-2010:p0382:b001:l039","ordinal":17545,"en":"If they fell into their hands and surrendered,"},{"id":"manas-2010:p0382:b001:l040","ordinal":17546,"en":"They would not hear their pleading words;"},{"id":"manas-2010:p0382:b001:l041","ordinal":17547,"en":"They stood ready to split them open,"},{"id":"manas-2010:p0382:b001:l042","ordinal":17548,"en":"They stood ready to gouge out their eyes."},{"id":"manas-2010:p0382:b001:l043","ordinal":17549,"en":"When the Chinese came seething,"},{"id":"manas-2010:p0382:b001:l044","ordinal":17550,"en":"Their movement raised dust."},{"id":"manas-2010:p0382:b001:l045","ordinal":17551,"en":"That boar, may your house burn—"},{"id":"manas-2010:p0382:b001:l046","ordinal":17552,"en":"His voice drove the soul out."},{"id":"manas-2010:p0382:b001:l047","ordinal":17553,"en":"Zholoy bellowed from behind,"},{"id":"manas-2010:p0382:b001:l048","ordinal":17554,"en":"That pig, may your house burn,"},{"id":"manas-2010:p0383:b001:l001","ordinal":17555,"en":"Crying “Möndü!” as his battle-cry."},{"id":"manas-2010:p0383:b001:l002","ordinal":17556,"en":"Before the fury of Zholoy,"},{"id":"manas-2010:p0383:b001:l003","ordinal":17557,"en":"The vast army could not stand firm;"},{"id":"manas-2010:p0383:b001:l004","ordinal":17558,"en":"The Chinese surged in."},{"id":"manas-2010:p0383:b001:l005","ordinal":17559,"en":"Then Kutubiy,"},{"id":"manas-2010:p0383:b001:l006","ordinal":17560,"en":"Rich in wisdom, eloquent of tongue,"},{"id":"manas-2010:p0383:b001:l007","ordinal":17561,"en":"A surpassing hero, deviser of stratagems,"},{"id":"manas-2010:p0383:b001:l008","ordinal":17562,"en":"Led Akbaltay along."},{"id":"manas-2010:p0383:b001:l009","ordinal":17563,"en":"There he found a way."},{"id":"manas-2010:p0383:b001:l010","ordinal":17564,"en":"Their reading of the stars was established;"},{"id":"manas-2010:p0383:b001:l011","ordinal":17565,"en":"Of poor, solitary Manas,"},{"id":"manas-2010:p0383:b001:l012","ordinal":17566,"en":"Kutubiy was the companion."},{"id":"manas-2010:p0383:b001:l013","ordinal":17567,"en":"In heaven Allah's sun grew overcast."},{"id":"manas-2010:p0383:b001:l014","ordinal":17568,"en":"His lion Manas was still absent."},{"id":"manas-2010:p0383:b001:l015","ordinal":17569,"en":"Sixty troubles struck his head at once."},{"id":"manas-2010:p0383:b001:l016","ordinal":17570,"en":"The cause of the onslaught was"},{"id":"manas-2010:p0383:b001:l017","ordinal":17571,"en":"The governor-general and Manchu warriors"},{"id":"manas-2010:p0383:b001:l018","ordinal":17572,"en":"Who swarmed and surged upon them."},{"id":"manas-2010:p0383:b001:l019","ordinal":17573,"en":"Who has seen such trouble!"},{"id":"manas-2010:p0383:b001:l020","ordinal":17574,"en":"They drew bows, making rain,"},{"id":"manas-2010:p0383:b001:l021","ordinal":17575,"en":"They fired shots, making hail."},{"id":"manas-2010:p0383:b001:l022","ordinal":17576,"en":"Spears swayed like reeds."},{"id":"manas-2010:p0383:b001:l023","ordinal":17577,"en":"A fierce onslaught, a grievous plight—"},{"id":"manas-2010:p0383:b001:l024","ordinal":17578,"en":"The Chinese surged in undulating masses."},{"id":"manas-2010:p0383:b001:l025","ordinal":17579,"en":"“Unless God grants an outcome,"},{"id":"manas-2010:p0383:b001:l026","ordinal":17580,"en":"It seems we will die now,"},{"id":"manas-2010:p0383:b001:l027","ordinal":17581,"en":"Unless lion Manas comes.”"},{"id":"manas-2010:p0383:b001:l028","ordinal":17582,"en":"Akbaltay stood wailing,"},{"id":"manas-2010:p0383:b001:l029","ordinal":17583,"en":"Proclaiming his last wishes aloud:"},{"id":"manas-2010:p0383:b001:l030","ordinal":17584,"en":"“My darling Kutubiy!"},{"id":"manas-2010:p0383:b001:l031","ordinal":17585,"en":"I am aged Baltay,"},{"id":"manas-2010:p0383:b001:l032","ordinal":17586,"en":"You were the one who protected me!"},{"id":"manas-2010:p0383:b001:l033","ordinal":17587,"en":"My dear Manas is not here."},{"id":"manas-2010:p0383:b001:l034","ordinal":17588,"en":"It seems we will die a foul death,"},{"id":"manas-2010:p0383:b001:l035","ordinal":17589,"en":"Bursting like a camel that will not move."},{"id":"manas-2010:p0383:b001:l036","ordinal":17590,"en":"It seems we will die badly."},{"id":"manas-2010:p0383:b001:l037","ordinal":17591,"en":"In the infidel's iron-rope"},{"id":"manas-2010:p0383:b001:l038","ordinal":17592,"en":"Net we are destined to die."},{"id":"manas-2010:p0383:b001:l039","ordinal":17593,"en":"Of the infidel all armed with daggers,"},{"id":"manas-2010:p0383:b001:l040","ordinal":17594,"en":"In his hands we are destined to die."},{"id":"manas-2010:p0383:b001:l041","ordinal":17595,"en":"To Ala-Too, for which you long,"},{"id":"manas-2010:p0383:b001:l042","ordinal":17596,"en":"We are destined to die without going."},{"id":"manas-2010:p0383:b001:l043","ordinal":17597,"en":"Those wandering Kyrgyz, that people,"},{"id":"manas-2010:p0383:b001:l044","ordinal":17598,"en":"We will die without reaching them!"},{"id":"manas-2010:p0383:b001:l045","ordinal":17599,"en":"I have no pass through which to flee."},{"id":"manas-2010:p0383:b001:l046","ordinal":17600,"en":"To free and rescue me,"},{"id":"manas-2010:p0383:b001:l047","ordinal":17601,"en":"My lion hero Manas is absent."},{"id":"manas-2010:p0383:b001:l048","ordinal":17602,"en":"Ah, my foal, Kutubiy,"},{"id":"manas-2010:p0384:b001:l001","ordinal":17603,"en":"How are we destined to die?”"},{"id":"manas-2010:p0384:b001:l002","ordinal":17604,"en":"His heart truly smoldering with grief,"},{"id":"manas-2010:p0384:b001:l003","ordinal":17605,"en":"Akbaltay in his old age"},{"id":"manas-2010:p0384:b001:l004","ordinal":17606,"en":"Stopped amid the army."},{"id":"manas-2010:p0384:b001:l005","ordinal":17607,"en":"Wailing, despairing of life,"},{"id":"manas-2010:p0384:b001:l006","ordinal":17608,"en":"He called out for Khan Manas."},{"id":"manas-2010:p0384:b001:l007","ordinal":17609,"en":"While Akbaltay stood like that,"},{"id":"manas-2010:p0384:b001:l008","ordinal":17610,"en":"As though stabbed in a tender gland,"},{"id":"manas-2010:p0384:b001:l009","ordinal":17611,"en":"Kutubiy sprang up:"},{"id":"manas-2010:p0384:b001:l010","ordinal":17612,"en":"“Uncle Akbaltay, you are a champion!"},{"id":"manas-2010:p0384:b001:l011","ordinal":17613,"en":"Is this how a warrior behaves?"},{"id":"manas-2010:p0384:b001:l012","ordinal":17614,"en":"Can anyone who calls you a warrior prosper?"},{"id":"manas-2010:p0384:b001:l013","ordinal":17615,"en":"In Altay, the Black Kalmyks'"},{"id":"manas-2010:p0384:b001:l014","ordinal":17616,"en":"Mares I used to raid and eat."},{"id":"manas-2010:p0384:b001:l015","ordinal":17617,"en":"If we clashed with the Kalmyks,"},{"id":"manas-2010:p0384:b001:l016","ordinal":17618,"en":"If my uncle Baltay held the pennon,"},{"id":"manas-2010:p0384:b001:l017","ordinal":17619,"en":"I thought I would destroy Khangay."},{"id":"manas-2010:p0384:b001:l018","ordinal":17620,"en":"When they fought, the Black Kalmyks'"},{"id":"manas-2010:p0384:b001:l019","ordinal":17621,"en":"Cattle I used to raid and eat."},{"id":"manas-2010:p0384:b001:l020","ordinal":17622,"en":"My uncle Baltay and Manas—"},{"id":"manas-2010:p0384:b001:l021","ordinal":17623,"en":"While those two watched over me,"},{"id":"manas-2010:p0384:b001:l022","ordinal":17624,"en":"Driving the Black Kalmyks,"},{"id":"manas-2010:p0384:b001:l023","ordinal":17625,"en":"I thought I would push them back to Kakan."},{"id":"manas-2010:p0384:b001:l024","ordinal":17626,"en":"Can grief pay a debt?"},{"id":"manas-2010:p0384:b001:l025","ordinal":17627,"en":"Can one afraid of Kalmyks prosper?"},{"id":"manas-2010:p0384:b001:l026","ordinal":17628,"en":"Alas, uncle, what are you saying?"},{"id":"manas-2010:p0384:b001:l027","ordinal":17629,"en":"Damn it, uncle, what are you saying?"},{"id":"manas-2010:p0384:b001:l028","ordinal":17630,"en":"Who should hear these words of yours?"},{"id":"manas-2010:p0384:b001:l029","ordinal":17631,"en":"Let only a dark night hear them!"},{"id":"manas-2010:p0384:b001:l030","ordinal":17632,"en":"Blunting our edge with grief,"},{"id":"manas-2010:p0384:b001:l031","ordinal":17633,"en":"You are a man of a wretched day."},{"id":"manas-2010:p0384:b001:l032","ordinal":17634,"en":"Destroying us with sorrow,"},{"id":"manas-2010:p0384:b001:l033","ordinal":17635,"en":"May your road be fortunate!"},{"id":"manas-2010:p0384:b001:l034","ordinal":17636,"en":"Will the Kalmyks listen to your grief?"},{"id":"manas-2010:p0384:b001:l035","ordinal":17637,"en":"Will their governor not seize us,"},{"id":"manas-2010:p0384:b001:l036","ordinal":17638,"en":"Will he not bring a night of doom?"},{"id":"manas-2010:p0384:b001:l037","ordinal":17639,"en":"Will he not rip your belly like a donkey's?"},{"id":"manas-2010:p0384:b001:l038","ordinal":17640,"en":"The innumerable Manchus—"},{"id":"manas-2010:p0384:b001:l039","ordinal":17641,"en":"Will they not tear us apart this instant?"},{"id":"manas-2010:p0384:b001:l040","ordinal":17642,"en":"You are a foolish man."},{"id":"manas-2010:p0384:b001:l041","ordinal":17643,"en":"You mean to have my coat stripped off,"},{"id":"manas-2010:p0384:b001:l042","ordinal":17644,"en":"You mean to show me a fine spectacle."},{"id":"manas-2010:p0384:b001:l043","ordinal":17645,"en":"Let us turn our horses' rumps to them,"},{"id":"manas-2010:p0384:b001:l044","ordinal":17646,"en":"Let us fight like dogs!"},{"id":"manas-2010:p0384:b001:l045","ordinal":17647,"en":"While alive, to the advancing Kalmyks'"},{"id":"manas-2010:p0384:b001:l046","ordinal":17648,"en":"Stare I will not submit."},{"id":"manas-2010:p0384:b001:l047","ordinal":17649,"en":"My golden soul within my breast"},{"id":"manas-2010:p0384:b001:l048","ordinal":17650,"en":"I will not give without much fighting!"},{"id":"manas-2010:p0385:b001:l001","ordinal":17651,"en":"Alas, uncle, what are you saying?”"},{"id":"manas-2010:p0385:b001:l002","ordinal":17652,"en":"So saying, Kutubiy"},{"id":"manas-2010:p0385:b001:l003","ordinal":17653,"en":"Telkyzyl beneath him,"},{"id":"manas-2010:p0385:b001:l004","ordinal":17654,"en":"He whipped from one side and the other,"},{"id":"manas-2010:p0385:b001:l005","ordinal":17655,"en":"Spurring this way and that."},{"id":"manas-2010:p0385:b001:l006","ordinal":17656,"en":"His eyes flashed fiercely like fire."},{"id":"manas-2010:p0385:b001:l007","ordinal":17657,"en":"His thirst for blood truly seized him;"},{"id":"manas-2010:p0385:b001:l008","ordinal":17658,"en":"He exerted his utmost strength."},{"id":"manas-2010:p0385:b001:l009","ordinal":17659,"en":"Of Khan Baltay's Kulager,"},{"id":"manas-2010:p0385:b001:l010","ordinal":17660,"en":"The supple deerskin lead-rope"},{"id":"manas-2010:p0385:b001:l011","ordinal":17661,"en":"He snatched from his hand."},{"id":"manas-2010:p0385:b001:l012","ordinal":17662,"en":"No wind could match his trot,"},{"id":"manas-2010:p0385:b001:l013","ordinal":17663,"en":"No beast could match his walk."},{"id":"manas-2010:p0385:b001:l014","ordinal":17664,"en":"Driving him across level ground,"}]
