[{"id":"semetey-1-2013:p0701:b004:l002","ordinal":130049,"en":"His thoughts distracted,"},{"id":"semetey-1-2013:p0701:b004:l003","ordinal":130050,"en":"Sat pondering,"},{"id":"semetey-1-2013:p0701:b004:l004","ordinal":130051,"en":"And what your valiant, hapless mother"},{"id":"semetey-1-2013:p0701:b004:l005","ordinal":130052,"en":"Had said appeared before his eyes."},{"id":"semetey-1-2013:p0701:b004:l006","ordinal":130053,"en":"“My mother Kanykei had said:"},{"id":"semetey-1-2013:p0701:b004:l007","ordinal":130054,"en":"‘If you reach Talas safely,"},{"id":"semetey-1-2013:p0701:b004:l008","ordinal":130055,"en":"Almambet's orphan son"},{"id":"semetey-1-2013:p0701:b004:l009","ordinal":130056,"en":"Bring back with you,’ she said."},{"id":"semetey-1-2013:p0701:b004:l010","ordinal":130057,"en":"‘His very presence is a mighty support;"},{"id":"semetey-1-2013:p0701:b004:l011","ordinal":130058,"en":"If that child lives and grows,"},{"id":"semetey-1-2013:p0701:b004:l012","ordinal":130059,"en":"No enemy will come raiding."},{"id":"semetey-1-2013:p0701:b004:l013","ordinal":130060,"en":"That hero will be your shelter,"},{"id":"semetey-1-2013:p0701:b004:l014","ordinal":130061,"en":"A lion greater than you,’ she said."},{"id":"semetey-1-2013:p0701:b004:l015","ordinal":130062,"en":"‘When he matures and grows,"},{"id":"semetey-1-2013:p0701:b004:l016","ordinal":130063,"en":"He will be a blazing red ember,’ she said."},{"id":"semetey-1-2013:p0701:b004:l017","ordinal":130064,"en":"‘In this faithless, transient world,"},{"id":"semetey-1-2013:p0701:b004:l018","ordinal":130065,"en":"None like him has been created,’ she said."},{"id":"semetey-1-2013:p0701:b004:l019","ordinal":130066,"en":"‘If you make him your companion,"},{"id":"semetey-1-2013:p0701:b004:l020","ordinal":130067,"en":"He is a bold one who will rout generals,’ she said."},{"id":"semetey-1-2013:p0701:b004:l021","ordinal":130068,"en":"‘If you make him your companion,"},{"id":"semetey-1-2013:p0701:b004:l022","ordinal":130069,"en":"My only son, he is braver than you,’ she said."},{"id":"semetey-1-2013:p0701:b004:l024","ordinal":130070,"en":"‘Through eighteen thousand worlds","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0701:b004:l025","ordinal":130071,"en":"His plea will reach,’ she said."},{"id":"semetey-1-2013:p0701:b004:l026","ordinal":130072,"en":"‘He is a bullet that strikes red-hot,’ she said."},{"id":"semetey-1-2013:p0701:b004:l027","ordinal":130073,"en":"‘Bring him back here;"},{"id":"semetey-1-2013:p0701:b004:l028","ordinal":130074,"en":"In all the ages there is none like him,’ she said."},{"id":"semetey-1-2013:p0701:b004:l029","ordinal":130075,"en":"‘When he faces an adversary,"},{"id":"semetey-1-2013:p0701:b004:l030","ordinal":130076,"en":"He is steeped poison,’ she said."},{"id":"semetey-1-2013:p0701:b004:l031","ordinal":130077,"en":"‘When he faces one in combat,"},{"id":"semetey-1-2013:p0701:b004:l032","ordinal":130078,"en":"He is an unfallen blue banner,’ she said."},{"id":"semetey-1-2013:p0701:b004:l033","ordinal":130079,"en":"‘Charging into the enemy,"},{"id":"semetey-1-2013:p0701:b004:l034","ordinal":130080,"en":"He is red tumult raising strife,’ she said."},{"id":"semetey-1-2013:p0701:b004:l035","ordinal":130081,"en":"Those were my mother's words."},{"id":"semetey-1-2013:p0701:b004:l036","ordinal":130082,"en":"‘On your lowland side are Russians;"},{"id":"semetey-1-2013:p0701:b004:l037","ordinal":130083,"en":"On your highland side are Chinese."},{"id":"semetey-1-2013:p0701:b005:l001","ordinal":130084,"en":"You have many foes to fight to the death."},{"id":"semetey-1-2013:p0701:b005:l002","ordinal":130085,"en":"Take my words to heart and come;"},{"id":"semetey-1-2013:p0701:b005:l003","ordinal":130086,"en":"From your wolf-maned sworn father,"},{"id":"semetey-1-2013:p0701:b005:l004","ordinal":130087,"en":"The one gift plainly left behind,"},{"id":"semetey-1-2013:p0701:b005:l005","ordinal":130088,"en":"Bring Kulchoro with you!"},{"id":"semetey-1-2013:p0701:b005:l006","ordinal":130089,"en":"If you bring the warrior,"},{"id":"semetey-1-2013:p0701:b005:l007","ordinal":130090,"en":"He is strength bound to your waist,’ she said."},{"id":"semetey-1-2013:p0701:b005:l008","ordinal":130091,"en":"‘If an enemy confronts him,"},{"id":"semetey-1-2013:p0701:b005:l009","ordinal":130092,"en":"He never weakens and yields."},{"id":"semetey-1-2013:p0701:b005:l010","ordinal":130093,"en":"Than your sworn father Almam,"},{"id":"semetey-1-2013:p0701:b005:l011","ordinal":130094,"en":"He is a lion born greater,’ she said."},{"id":"semetey-1-2013:p0701:b005:l012","ordinal":130095,"en":"‘He is strength bound to your waist,’ she said."},{"id":"semetey-1-2013:p0701:b005:l013","ordinal":130096,"en":"‘When he matures into a hero,"},{"id":"semetey-1-2013:p0701:b005:l014","ordinal":130097,"en":"And stands equal among heroes' sons,"},{"id":"semetey-1-2013:p0701:b005:l015","ordinal":130098,"en":"He is a lion greater than you,’ she said."},{"id":"semetey-1-2013:p0701:b005:l016","ordinal":130099,"en":"‘His protector is Kozhosan;"},{"id":"semetey-1-2013:p0701:b005:l017","ordinal":130100,"en":"Those opening his path are the Forty Saints."},{"id":"semetey-1-2013:p0701:b005:l018","ordinal":130101,"en":"Such is Kulchoro's nature."},{"id":"semetey-1-2013:p0701:b005:l019","ordinal":130102,"en":"If you abandon him, you will earn disgrace;"},{"id":"semetey-1-2013:p0701:b005:l020","ordinal":130103,"en":"Kulchoro is entrusted to you.’"},{"id":"semetey-1-2013:p0701:b005:l021","ordinal":130104,"en":"My mother has her wisdom;"},{"id":"semetey-1-2013:p0701:b005:l022","ordinal":130105,"en":"My precious, hapless mother"},{"id":"semetey-1-2013:p0701:b005:l023","ordinal":130106,"en":"Entrusted him to me.”"},{"id":"semetey-1-2013:p0701:b005:l024","ordinal":130107,"en":"Saying this, Semetey,"},{"id":"semetey-1-2013:p0701:b005:l025","ordinal":130108,"en":"The orphan child left by Manas,"},{"id":"semetey-1-2013:p0701:b005:l026","ordinal":130109,"en":"Stirred and straightened himself."},{"id":"semetey-1-2013:p0701:b005:l027","ordinal":130110,"en":"Greater than his father, generous Manas,"},{"id":"semetey-1-2013:p0701:b005:l028","ordinal":130111,"en":"Was that noble hero born,"},{"id":"semetey-1-2013:p0701:b005:l029","ordinal":130112,"en":"That noble lion like a cock."},{"id":"semetey-1-2013:p0701:b005:l030","ordinal":130113,"en":"When the orphan stirred and looked,"},{"id":"semetey-1-2013:p0701:b005:l031","ordinal":130114,"en":"Running this way came"},{"id":"semetey-1-2013:p0701:b005:l032","ordinal":130115,"en":"A naked six-year-old child,"},{"id":"semetey-1-2013:p0701:b005:l033","ordinal":130116,"en":"Striking his own thighs with a whip,"},{"id":"semetey-1-2013:p0701:b005:l034","ordinal":130117,"en":"Making a game of it."},{"id":"semetey-1-2013:p0701:b005:l035","ordinal":130118,"en":"An old black fur cap"},{"id":"semetey-1-2013:p0701:b005:l036","ordinal":130119,"en":"They had taken for their kokboru game,"},{"id":"semetey-1-2013:p0701:b005:l037","ordinal":130120,"en":"Chasing one another in delight."},{"id":"semetey-1-2013:p0702:b003:l001","ordinal":130121,"en":"Bending their knees toward the earth,"},{"id":"semetey-1-2013:p0702:b003:l002","ordinal":130122,"en":"Among those children"},{"id":"semetey-1-2013:p0702:b003:l003","ordinal":130123,"en":"Kulchoro came running."},{"id":"semetey-1-2013:p0702:b003:l004","ordinal":130124,"en":"When he looked at Kulchoro,"},{"id":"semetey-1-2013:p0702:b003:l005","ordinal":130125,"en":"Barefoot and bareheaded,"},{"id":"semetey-1-2013:p0702:b003:l006","ordinal":130126,"en":"Your Alake Khan's child"},{"id":"semetey-1-2013:p0702:b003:l007","ordinal":130127,"en":"Was naked, without clothes."},{"id":"semetey-1-2013:p0702:b003:l008","ordinal":130128,"en":"When he saw Kulchoro,"},{"id":"semetey-1-2013:p0702:b003:l009","ordinal":130129,"en":"He thundered in anger;"},{"id":"semetey-1-2013:p0702:b003:l010","ordinal":130130,"en":"Then grief burned fiercely within him,"},{"id":"semetey-1-2013:p0702:b003:l011","ordinal":130131,"en":"And he wept, his voice booming."},{"id":"semetey-1-2013:p0702:b003:l012","ordinal":130132,"en":"Your hero, called brave Seme,"},{"id":"semetey-1-2013:p0702:b003:l013","ordinal":130133,"en":"His noble eyes like a saker's,"},{"id":"semetey-1-2013:p0702:b003:l014","ordinal":130134,"en":"Held tears without blinking."},{"id":"semetey-1-2013:p0702:b003:l015","ordinal":130135,"en":"The reason tears filled them:"},{"id":"semetey-1-2013:p0702:b003:l016","ordinal":130136,"en":"His heart was sorely troubled;"},{"id":"semetey-1-2013:p0702:b003:l017","ordinal":130137,"en":"The dear child he longed to see"},{"id":"semetey-1-2013:p0702:b003:l018","ordinal":130138,"en":"Appeared naked before his eyes."},{"id":"semetey-1-2013:p0702:b003:l019","ordinal":130139,"en":"“He too is a spring of a broad valley's river,"},{"id":"semetey-1-2013:p0702:b003:l020","ordinal":130140,"en":"My lionlike sworn father's"},{"id":"semetey-1-2013:p0702:b003:l021","ordinal":130141,"en":"Light, gained late in life."},{"id":"semetey-1-2013:p0702:b003:l022","ordinal":130142,"en":"Vast treasure and red gold,"},{"id":"semetey-1-2013:p0702:b003:l023","ordinal":130143,"en":"For longing for one child,"},{"id":"semetey-1-2013:p0702:b003:l024","ordinal":130144,"en":"He spent and scattered."},{"id":"semetey-1-2013:p0702:b003:l025","ordinal":130145,"en":"For a single camel-calf child from God,"},{"id":"semetey-1-2013:p0702:b003:l026","ordinal":130146,"en":"He pleaded in such misery."},{"id":"semetey-1-2013:p0702:b003:l027","ordinal":130147,"en":"The bridle kept for the lion's horse,"},{"id":"semetey-1-2013:p0702:b003:l028","ordinal":130148,"en":"The only son of a renowned khan—"},{"id":"semetey-1-2013:p0702:b003:l029","ordinal":130149,"en":"O God, does he live like this?!”"},{"id":"semetey-1-2013:p0702:b003:l030","ordinal":130150,"en":"Saying this, Semetey"},{"id":"semetey-1-2013:p0702:b003:l031","ordinal":130151,"en":"Opened his cavernous mouth,"},{"id":"semetey-1-2013:p0702:b003:l032","ordinal":130152,"en":"And Almambet's child,"},{"id":"semetey-1-2013:p0702:b003:l033","ordinal":130153,"en":"The orphan Kulchoro,"},{"id":"semetey-1-2013:p0702:b003:l034","ordinal":130154,"en":"He clasped to his breast."},{"id":"semetey-1-2013:p0702:b003:l035","ordinal":130155,"en":"Then, like the hairs of a white antelope,"},{"id":"semetey-1-2013:p0702:b003:l036","ordinal":130156,"en":"They became dearest friends;"},{"id":"semetey-1-2013:p0702:b003:l037","ordinal":130157,"en":"Like flour of white wheat,"},{"id":"semetey-1-2013:p0702:b003:l038","ordinal":130158,"en":"They mingled like kneaded dough."},{"id":"semetey-1-2013:p0702:b004:l001","ordinal":130159,"en":"They caressed one another.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0702:b004:l002","ordinal":130160,"en":"The two orphans came together,"},{"id":"semetey-1-2013:p0702:b004:l003","ordinal":130161,"en":"And were united."},{"id":"semetey-1-2013:p0702:b004:l004","ordinal":130162,"en":"Their voices joined in equal weeping;"},{"id":"semetey-1-2013:p0702:b004:l005","ordinal":130163,"en":"They raised a booming lament."},{"id":"semetey-1-2013:p0702:b004:l006","ordinal":130164,"en":"While the orphans wept,"},{"id":"semetey-1-2013:p0702:b004:l007","ordinal":130165,"en":"Old Bakai wept blood;"},{"id":"semetey-1-2013:p0702:b004:l008","ordinal":130166,"en":"All the people wept."},{"id":"semetey-1-2013:p0702:b004:l009","ordinal":130167,"en":"Seeing these two,"},{"id":"semetey-1-2013:p0702:b004:l010","ordinal":130168,"en":"All sorrowful ones cried in grief."},{"id":"semetey-1-2013:p0702:b004:l011","ordinal":130169,"en":"Grown men wept, the people wept;"},{"id":"semetey-1-2013:p0702:b004:l012","ordinal":130170,"en":"All who remembered wept."},{"id":"semetey-1-2013:p0702:b004:l013","ordinal":130171,"en":"Not birches, but willows wept;"},{"id":"semetey-1-2013:p0702:b004:l014","ordinal":130172,"en":"Everyone who watched wept."},{"id":"semetey-1-2013:p0702:b004:l015","ordinal":130173,"en":"The children of lion heroes,"},{"id":"semetey-1-2013:p0702:b004:l016","ordinal":130174,"en":"Lost and straying, found each other."},{"id":"semetey-1-2013:p0702:b004:l017","ordinal":130175,"en":"The children of oceanlike heroes,"},{"id":"semetey-1-2013:p0702:b004:l018","ordinal":130176,"en":"Wandering, met each other."},{"id":"semetey-1-2013:p0702:b004:l019","ordinal":130177,"en":"Then they embraced and sobbed;"},{"id":"semetey-1-2013:p0702:b004:l020","ordinal":130178,"en":"The two orphans cried aloud."},{"id":"semetey-1-2013:p0702:b004:l021","ordinal":130179,"en":"Their bones pressed against each other,"},{"id":"semetey-1-2013:p0702:b004:l022","ordinal":130180,"en":"Their arms entwined."},{"id":"semetey-1-2013:p0702:b004:l023","ordinal":130181,"en":"Lost ones were recovered;"},{"id":"semetey-1-2013:p0702:b004:l024","ordinal":130182,"en":"The wandering orphan was found."},{"id":"semetey-1-2013:p0702:b004:l025","ordinal":130183,"en":"That wondrous hero, Manas's son,"},{"id":"semetey-1-2013:p0702:b004:l026","ordinal":130184,"en":"Made ready and spoke his lament:"},{"id":"semetey-1-2013:p0702:b004:l027","ordinal":130185,"en":"“Parched, without water,"},{"id":"semetey-1-2013:p0702:b004:l028","ordinal":130186,"en":"There is a wretch like a desert."},{"id":"semetey-1-2013:p0702:b004:l029","ordinal":130187,"en":"Wandering, unable to see his form,"},{"id":"semetey-1-2013:p0702:b004:l030","ordinal":130188,"en":"Is there a wretch like me?!"},{"id":"semetey-1-2013:p0702:b004:l031","ordinal":130189,"en":"The offspring of a noble-steed khan,"},{"id":"semetey-1-2013:p0702:b004:l032","ordinal":130190,"en":"Living by fleeing and wandering—"},{"id":"semetey-1-2013:p0702:b004:l033","ordinal":130191,"en":"O leopard father, do not die;"},{"id":"semetey-1-2013:p0702:b004:l034","ordinal":130192,"en":"Let this wretched soul not see sorrow!"},{"id":"semetey-1-2013:p0702:b004:l035","ordinal":130193,"en":"This wretched life of wandering,"},{"id":"semetey-1-2013:p0702:b004:l036","ordinal":130194,"en":"If You create us as living souls,"},{"id":"semetey-1-2013:p0702:b004:l037","ordinal":130195,"en":"Do not grant it to Your mortal creatures.”"},{"id":"semetey-1-2013:p0702:b004:l038","ordinal":130196,"en":"Thus Semetey sobbed;"},{"id":"semetey-1-2013:p0702:b004:l039","ordinal":130197,"en":"Six-year-old Kulchoro"},{"id":"semetey-1-2013:p0703:b003:l001","ordinal":130198,"en":"Wept and cried aloud like this:"},{"id":"semetey-1-2013:p0703:b003:l002","ordinal":130199,"en":"“My prop when I strive upward,"},{"id":"semetey-1-2013:p0703:b003:l003","ordinal":130200,"en":"Has my support, my elder brother, come?!"},{"id":"semetey-1-2013:p0703:b003:l004","ordinal":130201,"en":"The one I have long taken as my strength,"},{"id":"semetey-1-2013:p0703:b003:l005","ordinal":130202,"en":"Has my lion brother come?!"},{"id":"semetey-1-2013:p0703:b003:l006","ordinal":130203,"en":"Brother, I have spent so long tending lambs."},{"id":"semetey-1-2013:p0703:b003:l007","ordinal":130204,"en":"Alas for my fate! ‘My elder brother,"},{"id":"semetey-1-2013:p0703:b003:l008","ordinal":130205,"en":"When will he come?’ I kept asking."},{"id":"semetey-1-2013:p0703:b003:l009","ordinal":130206,"en":"Crying out my grief,"},{"id":"semetey-1-2013:p0703:b003:l010","ordinal":130207,"en":"I sobbed and lamented much."},{"id":"semetey-1-2013:p0703:b003:l011","ordinal":130208,"en":"To Temirkan's city,"},{"id":"semetey-1-2013:p0703:b003:l012","ordinal":130209,"en":"How have you fared in wandering?"},{"id":"semetey-1-2013:p0703:b003:l013","ordinal":130210,"en":"‘When will my ocean come?’"},{"id":"semetey-1-2013:p0703:b003:l014","ordinal":130211,"en":"How have I fared, waiting forlorn?!"},{"id":"semetey-1-2013:p0703:b003:l015","ordinal":130212,"en":"The children of noble-steed khans,"},{"id":"semetey-1-2013:p0703:b003:l016","ordinal":130213,"en":"Separated in different places—"},{"id":"semetey-1-2013:p0703:b003:l017","ordinal":130214,"en":"Is it right for us to suffer humiliation?!"},{"id":"semetey-1-2013:p0703:b003:l018","ordinal":130215,"en":"Alas, brother, where are our people now?!"},{"id":"semetey-1-2013:p0703:b003:l019","ordinal":130216,"en":"The children of princes—"},{"id":"semetey-1-2013:p0703:b003:l020","ordinal":130217,"en":"Is it right for us to live in flight?!"},{"id":"semetey-1-2013:p0703:b003:l021","ordinal":130218,"en":"Alas for this wretched life, brother—where are our people?!"},{"id":"semetey-1-2013:p0703:b003:l022","ordinal":130219,"en":"The offspring of nobles—"},{"id":"semetey-1-2013:p0703:b003:l023","ordinal":130220,"en":"Is it right for us to wander in exile?"},{"id":"semetey-1-2013:p0703:b003:l024","ordinal":130221,"en":"My valiant brother, where are our people?"},{"id":"semetey-1-2013:p0703:b003:l025","ordinal":130222,"en":"A prince's offspring—"},{"id":"semetey-1-2013:p0703:b003:l026","ordinal":130223,"en":"Should such a soul live in flight?"},{"id":"semetey-1-2013:p0703:b003:l027","ordinal":130224,"en":"My leopard brother, where are our people?!"},{"id":"semetey-1-2013:p0703:b003:l028","ordinal":130225,"en":"A noble hero's child—"},{"id":"semetey-1-2013:p0703:b003:l029","ordinal":130226,"en":"Should he live wandering,"},{"id":"semetey-1-2013:p0703:b003:l030","ordinal":130227,"en":"Yearning, unable to find the other?"},{"id":"semetey-1-2013:p0703:b003:l031","ordinal":130228,"en":"Can one prosper living like this!"},{"id":"semetey-1-2013:p0703:b003:l032","ordinal":130229,"en":"The children of princes—"},{"id":"semetey-1-2013:p0703:b003:l033","ordinal":130230,"en":"Should they live in flight,"},{"id":"semetey-1-2013:p0703:b003:l034","ordinal":130231,"en":"Parted from their countless people?"},{"id":"semetey-1-2013:p0703:b003:l035","ordinal":130232,"en":"Can a grieving man prosper!"},{"id":"semetey-1-2013:p0703:b003:l036","ordinal":130233,"en":"May this false world perish!"},{"id":"semetey-1-2013:p0703:b003:l037","ordinal":130234,"en":"Born from the womb, I saw only night."},{"id":"semetey-1-2013:p0703:b003:l038","ordinal":130235,"en":"Without a brother like you to bring me joy,"},{"id":"semetey-1-2013:p0703:b003:l039","ordinal":130236,"en":"I lived in servitude!"},{"id":"semetey-1-2013:p0703:b004:l001","ordinal":130237,"en":"God has troubled my thoughts."},{"id":"semetey-1-2013:p0703:b004:l002","ordinal":130238,"en":"The blows those dogs struck—"},{"id":"semetey-1-2013:p0703:b004:l003","ordinal":130239,"en":"Will they ever leave my aching bones!?"},{"id":"semetey-1-2013:p0703:b004:l004","ordinal":130240,"en":"Breaking me in like an untrained yearling,"},{"id":"semetey-1-2013:p0703:b004:l005","ordinal":130241,"en":"Each dog in turn snatched me away,"},{"id":"semetey-1-2013:p0703:b004:l006","ordinal":130242,"en":"Dragging me back and forth,"},{"id":"semetey-1-2013:p0703:b004:l007","ordinal":130243,"en":"Humiliating me without mercy."},{"id":"semetey-1-2013:p0703:b004:l008","ordinal":130244,"en":"Back and forth they dragged the orphan,"},{"id":"semetey-1-2013:p0703:b004:l009","ordinal":130245,"en":"Tossing and beating me like a kokboru prize."},{"id":"semetey-1-2013:p0703:b004:l010","ordinal":130246,"en":"My whole body shattered,"},{"id":"semetey-1-2013:p0703:b004:l011","ordinal":130247,"en":"Every bone throbbed."},{"id":"semetey-1-2013:p0703:b004:l012","ordinal":130248,"en":"If I lament, will God take me?"},{"id":"semetey-1-2013:p0703:b004:l013","ordinal":130249,"en":"The cruelty those dogs inflicted—"},{"id":"semetey-1-2013:p0703:b004:l014","ordinal":130250,"en":"Will it ever leave my aching bones?"},{"id":"semetey-1-2013:p0703:b004:l015","ordinal":130251,"en":"Abyke and Kobosh, two villains—"},{"id":"semetey-1-2013:p0703:b004:l016","ordinal":130252,"en":"From them I suffered humiliation."},{"id":"semetey-1-2013:p0703:b004:l017","ordinal":130253,"en":"Chyibyt and Kochkor, making four villains—"},{"id":"semetey-1-2013:p0703:b004:l018","ordinal":130254,"en":"From them I suffered violence."},{"id":"semetey-1-2013:p0703:b004:l019","ordinal":130255,"en":"Adybai and Kolbai, making six villains—"},{"id":"semetey-1-2013:p0703:b004:l020","ordinal":130256,"en":"From them I suffered humiliation."},{"id":"semetey-1-2013:p0703:b004:l021","ordinal":130257,"en":"To take my turn at shaming them,"},{"id":"semetey-1-2013:p0703:b004:l022","ordinal":130258,"en":"To raise an uproar and tumult,"},{"id":"semetey-1-2013:p0703:b004:l024","ordinal":130259,"en":"In wretched childhood my strength is small.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0703:b004:l025","ordinal":130260,"en":"I have endured humiliation so long."},{"id":"semetey-1-2013:p0703:b004:l026","ordinal":130261,"en":"‘Alas, my leopard brother,"},{"id":"semetey-1-2013:p0703:b004:l027","ordinal":130262,"en":"When will he come?’ I kept asking."},{"id":"semetey-1-2013:p0703:b004:l028","ordinal":130263,"en":"If my elder brother turns back,"},{"id":"semetey-1-2013:p0703:b004:l029","ordinal":130264,"en":"And comes to settle in Talas,"},{"id":"semetey-1-2013:p0703:b004:l030","ordinal":130265,"en":"If I move my camp from Keng-Kol,"},{"id":"semetey-1-2013:p0703:b004:l031","ordinal":130266,"en":"Upon those swaggering dogs"},{"id":"semetey-1-2013:p0703:b004:l032","ordinal":130267,"en":"I long to take revenge."},{"id":"semetey-1-2013:p0703:b004:l033","ordinal":130268,"en":"Moving my camp from Talas—"},{"id":"semetey-1-2013:p0703:b004:l034","ordinal":130269,"en":"Damn this childhood!"},{"id":"semetey-1-2013:p0703:b004:l035","ordinal":130270,"en":"I cannot take revenge upon those dogs."},{"id":"semetey-1-2013:p0703:b004:l037","ordinal":130271,"en":"My time to contend with those dogs has not come.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0704:b003:l001","ordinal":130272,"en":"My time to wrestle those dogs from the saddle has not come.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0704:b003:l002","ordinal":130273,"en":"If my brother comes, full-grown,"},{"id":"semetey-1-2013:p0704:b003:l003","ordinal":130274,"en":"If I drive my caravan from Keng-Kol,"},{"id":"semetey-1-2013:p0704:b003:l004","ordinal":130275,"en":"Upon those swaggering dogs"},{"id":"semetey-1-2013:p0704:b003:l005","ordinal":130276,"en":"Let me take my revenge without failing."},{"id":"semetey-1-2013:p0704:b003:l006","ordinal":130277,"en":"If I drive my caravan from Talas,"},{"id":"semetey-1-2013:p0704:b003:l007","ordinal":130278,"en":"Battling and smashing,"},{"id":"semetey-1-2013:p0704:b003:l008","ordinal":130279,"en":"Let me take tireless revenge upon those dogs.”"},{"id":"semetey-1-2013:p0704:b003:l009","ordinal":130280,"en":"Voicing this wish,"},{"id":"semetey-1-2013:p0704:b003:l010","ordinal":130281,"en":"The orphan would not stop."},{"id":"semetey-1-2013:p0704:b003:l011","ordinal":130282,"en":"The two orphans met,"},{"id":"semetey-1-2013:p0704:b003:l012","ordinal":130283,"en":"Softening like curds."},{"id":"semetey-1-2013:p0704:b003:l013","ordinal":130284,"en":"The people watching"},{"id":"semetey-1-2013:p0704:b003:l014","ordinal":130285,"en":"Felt every bone ache."},{"id":"semetey-1-2013:p0704:b003:l015","ordinal":130286,"en":"While the boys stood thus,"},{"id":"semetey-1-2013:p0704:b003:l016","ordinal":130287,"en":"Your heroic uncle Bakai,"},{"id":"semetey-1-2013:p0704:b003:l017","ordinal":130288,"en":"His white beard grown thin,"},{"id":"semetey-1-2013:p0704:b003:l018","ordinal":130289,"en":"Hailstone tears streaming from his eyes,"},{"id":"semetey-1-2013:p0704:b003:l019","ordinal":130290,"en":"Pouring down his collarbone—"},{"id":"semetey-1-2013:p0704:b003:l020","ordinal":130291,"en":"At that time Bakai"},{"id":"semetey-1-2013:p0704:b003:l022","ordinal":130292,"en":"And himself followed God's path.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0704:b003:l023","ordinal":130293,"en":"Your sorrowful uncle Bakai sobbed,"},{"id":"semetey-1-2013:p0704:b003:l024","ordinal":130294,"en":"Crying, “My two lions!”"},{"id":"semetey-1-2013:p0704:b003:l025","ordinal":130295,"en":"He hurried between them,"},{"id":"semetey-1-2013:p0704:b003:l026","ordinal":130296,"en":"And came to meet them in the middle."},{"id":"semetey-1-2013:p0704:b003:l027","ordinal":130297,"en":"Your aged uncle Khan Bakai,"},{"id":"semetey-1-2013:p0704:b003:l028","ordinal":130298,"en":"His eyes festering,"},{"id":"semetey-1-2013:p0704:b003:l029","ordinal":130299,"en":"His joints trembling without cease,"},{"id":"semetey-1-2013:p0704:b003:l030","ordinal":130300,"en":"Wept still more, the poor man;"},{"id":"semetey-1-2013:p0704:b003:l031","ordinal":130301,"en":"His chest rattled."},{"id":"semetey-1-2013:p0704:b003:l032","ordinal":130302,"en":"Stepping between them, he made ready,"},{"id":"semetey-1-2013:p0704:b003:l033","ordinal":130303,"en":"And pleaded with the two lions:"},{"id":"semetey-1-2013:p0704:b003:l034","ordinal":130304,"en":"“My beloved two lions,"}]
