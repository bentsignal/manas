[{"id":"semetey-1-2013:p0227:b003:l018","ordinal":94209,"en":"The lions Almambet and Chubak died,"},{"id":"semetey-1-2013:p0227:b003:l019","ordinal":94210,"en":"Egizey and Shooruk died together,"},{"id":"semetey-1-2013:p0227:b003:l020","ordinal":94211,"en":"Muzburchak and Khan Kokcho died,"},{"id":"semetey-1-2013:p0227:b003:l021","ordinal":94212,"en":"Everyone who reached Beijing died."},{"id":"semetey-1-2013:p0227:b003:l023","ordinal":94213,"en":"Beijing, forty days' journey across,"},{"id":"semetey-1-2013:p0227:b003:l024","ordinal":94214,"en":"He had scouted round its edges."},{"id":"semetey-1-2013:p0227:b003:l025","ordinal":94215,"en":"All the mighty men"},{"id":"semetey-1-2013:p0227:b003:l026","ordinal":94216,"en":"He let the Chinese take as gifts."},{"id":"semetey-1-2013:p0227:b003:l027","ordinal":94217,"en":"In anguish my brother-in-law died too."},{"id":"semetey-1-2013:p0227:b003:l028","ordinal":94218,"en":"There was no male child of his line."},{"id":"semetey-1-2013:p0227:b003:l029","ordinal":94219,"en":"Fleeing Talas in distress,"},{"id":"semetey-1-2013:p0227:b003:l030","ordinal":94220,"en":"Left the widow of Manas,"},{"id":"semetey-1-2013:p0227:b003:l031","ordinal":94221,"en":"My elder sister came wandering."},{"id":"semetey-1-2013:p0227:b003:l032","ordinal":94222,"en":"Widowed, without recourse,"},{"id":"semetey-1-2013:p0227:b003:l033","ordinal":94223,"en":"With no son of my brother-in-law."},{"id":"semetey-1-2013:p0227:b003:l034","ordinal":94224,"en":"As they say, one camps along a river;"},{"id":"semetey-1-2013:p0227:b003:l035","ordinal":94225,"en":"For a woman whose husband dies,"},{"id":"semetey-1-2013:p0227:b003:l036","ordinal":94226,"en":"Her own kin are close, they say."},{"id":"semetey-1-2013:p0227:b003:l037","ordinal":94227,"en":"Wearing a loose, flapping felt cloak,"},{"id":"semetey-1-2013:p0227:b003:l038","ordinal":94228,"en":"Grieving, weeping, stumbling along,"},{"id":"semetey-1-2013:p0227:b003:l039","ordinal":94229,"en":"She came hurrying as a widow,"},{"id":"semetey-1-2013:p0227:b005:l001","ordinal":94230,"en":"Came wandering to Bukhara,"},{"id":"semetey-1-2013:p0227:b005:l002","ordinal":94231,"en":"Had her fill of suffering."},{"id":"semetey-1-2013:p0227:b005:l003","ordinal":94232,"en":"Living widowed, she grew wild."},{"id":"semetey-1-2013:p0227:b005:l004","ordinal":94233,"en":"May she sink into the earth, that woman,"},{"id":"semetey-1-2013:p0227:b005:l005","ordinal":94234,"en":"Crazed with racing horses!"},{"id":"semetey-1-2013:p0227:b005:l006","ordinal":94235,"en":"Since your brother-in-law left your sister,"},{"id":"semetey-1-2013:p0227:b005:l007","ordinal":94236,"en":"When you count the years,"},{"id":"semetey-1-2013:p0227:b005:l008","ordinal":94237,"en":"Twelve years have passed."},{"id":"semetey-1-2013:p0227:b005:l009","ordinal":94238,"en":"This very year, since your sister"},{"id":"semetey-1-2013:p0227:b005:l010","ordinal":94239,"en":"Came wandering to Bukhara,"},{"id":"semetey-1-2013:p0227:b005:l011","ordinal":94240,"en":"It has been exactly twelve years."},{"id":"semetey-1-2013:p0227:b005:l012","ordinal":94241,"en":"Widowed, she pushes herself forward,"},{"id":"semetey-1-2013:p0227:b005:l013","ordinal":94242,"en":"Crazed with racing horses—"},{"id":"semetey-1-2013:p0227:b005:l014","ordinal":94243,"en":"Can anyone be so shameless?"},{"id":"semetey-1-2013:p0227:b005:l015","ordinal":94244,"en":"Trouble upon the whole wide world—"},{"id":"semetey-1-2013:p0227:b005:l016","ordinal":94245,"en":"Let your shameless sister not bring it."},{"id":"semetey-1-2013:p0227:b005:l017","ordinal":94246,"en":"That accursed madwoman"},{"id":"semetey-1-2013:p0227:b005:l018","ordinal":94247,"en":"Was an exceptionally strong slave woman."},{"id":"semetey-1-2013:p0227:b005:l019","ordinal":94248,"en":"My darling foal,"},{"id":"semetey-1-2013:p0227:b005:l020","ordinal":94249,"en":"Semetey, do not fail to overpower her."},{"id":"semetey-1-2013:p0227:b005:l021","ordinal":94250,"en":"Set your appointed time close to dawn."},{"id":"semetey-1-2013:p0227:b005:l022","ordinal":94251,"en":"Choose your companions carefully."},{"id":"semetey-1-2013:p0227:b005:l023","ordinal":94252,"en":"When the black gun cracks,"},{"id":"semetey-1-2013:p0227:b005:l024","ordinal":94253,"en":"Take a strong man who will not flee."},{"id":"semetey-1-2013:p0227:b005:l025","ordinal":94254,"en":"When the fierce gun snaps,"},{"id":"semetey-1-2013:p0227:b005:l026","ordinal":94255,"en":"Take a skilled man who will not start."},{"id":"semetey-1-2013:p0227:b005:l027","ordinal":94256,"en":"If an enemy confronts you,"},{"id":"semetey-1-2013:p0227:b005:l028","ordinal":94257,"en":"Take one who will grip and thrust a spear."},{"id":"semetey-1-2013:p0227:b005:l029","ordinal":94258,"en":"If some unforeseen trouble comes,"},{"id":"semetey-1-2013:p0227:b005:l030","ordinal":94259,"en":"Take one who will hold your horse!'"},{"id":"semetey-1-2013:p0227:b005:l031","ordinal":94260,"en":"The twisted copper crest"},{"id":"semetey-1-2013:p0227:b005:l032","ordinal":94261,"en":"He gripped at its corner and turned."},{"id":"semetey-1-2013:p0227:b005:l033","ordinal":94262,"en":"Working his son into a fury,"},{"id":"semetey-1-2013:p0227:b005:l034","ordinal":94263,"en":"Saying, 'Seize your sister and slaughter her,'"},{"id":"semetey-1-2013:p0227:b005:l035","ordinal":94264,"en":"He sent him to his mother."},{"id":"semetey-1-2013:p0227:b005:l036","ordinal":94265,"en":"Giving orders, Ismail"},{"id":"semetey-1-2013:p0227:b005:l037","ordinal":94266,"en":"Had the drum beaten."},{"id":"semetey-1-2013:p0227:b005:l038","ordinal":94267,"en":"The great komuz with an armful-wide back,"},{"id":"semetey-1-2013:p0227:b005:l039","ordinal":94268,"en":"The dombra, he had played."},{"id":"semetey-1-2013:p0228:b003:l001","ordinal":94269,"en":"Some sixty of his champions,"},{"id":"semetey-1-2013:p0228:b003:l002","ordinal":94270,"en":"By his father's Sart custom,"},{"id":"semetey-1-2013:p0228:b003:l003","ordinal":94271,"en":"Now began to sing."},{"id":"semetey-1-2013:p0228:b003:l004","ordinal":94272,"en":"Some seventy champions"},{"id":"semetey-1-2013:p0228:b003:l005","ordinal":94273,"en":"To the poor orphan boy"},{"id":"semetey-1-2013:p0228:b003:l006","ordinal":94274,"en":"Became companions."},{"id":"semetey-1-2013:p0228:b003:l007","ordinal":94275,"en":"At that time Semetey"},{"id":"semetey-1-2013:p0228:b003:l008","ordinal":94276,"en":"Had his wish granted by God,"},{"id":"semetey-1-2013:p0228:b003:l009","ordinal":94277,"en":"Had reached twelve years of age."},{"id":"semetey-1-2013:p0228:b003:l010","ordinal":94278,"en":"The ten companions' gift bestowed by the saint—"},{"id":"semetey-1-2013:p0228:b003:l011","ordinal":94279,"en":"He did not yet know it was a blessing."},{"id":"semetey-1-2013:p0228:b003:l012","ordinal":94280,"en":"Manas, who had gone to the next world—"},{"id":"semetey-1-2013:p0228:b003:l013","ordinal":94281,"en":"He did not yet know he was his father."},{"id":"semetey-1-2013:p0228:b003:l014","ordinal":94282,"en":"Hearing Ismail's words,"},{"id":"semetey-1-2013:p0228:b003:l015","ordinal":94283,"en":"Hearing that the fugitive Kanykei"},{"id":"semetey-1-2013:p0228:b003:l016","ordinal":94284,"en":"Had raced her horse,"},{"id":"semetey-1-2013:p0228:b003:l017","ordinal":94285,"en":"To gouge her eyes in vengeance,"},{"id":"semetey-1-2013:p0228:b003:l018","ordinal":94286,"en":"To seize and slaughter her,"},{"id":"semetey-1-2013:p0228:b003:l019","ordinal":94287,"en":"That shameless, raging woman,"},{"id":"semetey-1-2013:p0228:b003:l020","ordinal":94288,"en":"To catch her upon the road,"},{"id":"semetey-1-2013:p0228:b003:l021","ordinal":94289,"en":"The boy's mind was turned,"},{"id":"semetey-1-2013:p0228:b003:l022","ordinal":94290,"en":"To slaughter her as a sacrifice,"},{"id":"semetey-1-2013:p0228:b003:l023","ordinal":94291,"en":"If he could, in this way"},{"id":"semetey-1-2013:p0228:b003:l024","ordinal":94292,"en":"To cut off her head."},{"id":"semetey-1-2013:p0228:b003:l025","ordinal":94293,"en":"The warrior thought, 'My widowed sister—"},{"id":"semetey-1-2013:p0228:b003:l026","ordinal":94294,"en":"What is this wild behavior?"},{"id":"semetey-1-2013:p0228:b003:l027","ordinal":94295,"en":"Dressing herself in men's clothes,"},{"id":"semetey-1-2013:p0228:b003:l028","ordinal":94296,"en":"What is this madness?'"},{"id":"semetey-1-2013:p0228:b003:l029","ordinal":94297,"en":"Hearing it, he felt constrained,"},{"id":"semetey-1-2013:p0228:b003:l030","ordinal":94298,"en":"The boy was thus tormented by shame."},{"id":"semetey-1-2013:p0228:b003:l031","ordinal":94299,"en":"From iron-gated Bukhara"},{"id":"semetey-1-2013:p0228:b003:l032","ordinal":94300,"en":"The boy went without turning back."},{"id":"semetey-1-2013:p0228:b003:l033","ordinal":94301,"en":"The horse he rode beneath him"},{"id":"semetey-1-2013:p0228:b003:l034","ordinal":94302,"en":"Was Temir Khan's wondrous steed."},{"id":"semetey-1-2013:p0228:b003:l035","ordinal":94303,"en":"The sword within his hand"},{"id":"semetey-1-2013:p0228:b003:l036","ordinal":94304,"en":"Was Ismail's steel."},{"id":"semetey-1-2013:p0228:b003:l037","ordinal":94305,"en":"Semetey grew furious,"},{"id":"semetey-1-2013:p0228:b003:l038","ordinal":94306,"en":"Flames hissing from his mouth,"},{"id":"semetey-1-2013:p0228:b003:l039","ordinal":94307,"en":"His mighty teeth, as broad as doors,"},{"id":"semetey-1-2013:p0228:b004:l001","ordinal":94308,"en":"Shattered into millet grains."},{"id":"semetey-1-2013:p0228:b004:l002","ordinal":94309,"en":"To Kanykei's sorrow,"},{"id":"semetey-1-2013:p0228:b004:l003","ordinal":94310,"en":"Some seventy fearless men,"},{"id":"semetey-1-2013:p0228:b004:l004","ordinal":94311,"en":"All his champions,"},{"id":"semetey-1-2013:p0228:b004:l005","ordinal":94312,"en":"Became his companions."},{"id":"semetey-1-2013:p0228:b004:l006","ordinal":94313,"en":"Among the champions"},{"id":"semetey-1-2013:p0228:b004:l007","ordinal":94314,"en":"Were skilled men who could find a way,"},{"id":"semetey-1-2013:p0228:b004:l008","ordinal":94315,"en":"Men who would not flee a massed foe,"},{"id":"semetey-1-2013:p0228:b004:l009","ordinal":94316,"en":"Broad-chested men of might,"},{"id":"semetey-1-2013:p0228:b004:l010","ordinal":94317,"en":"Marksmen who never missed."},{"id":"semetey-1-2013:p0228:b004:l011","ordinal":94318,"en":"All his champions"},{"id":"semetey-1-2013:p0228:b004:l012","ordinal":94319,"en":"Accompanied the boy,"},{"id":"semetey-1-2013:p0228:b004:l013","ordinal":94320,"en":"Traveling without turning aside,"},{"id":"semetey-1-2013:p0228:b004:l014","ordinal":94321,"en":"Toward the racing plain,"},{"id":"semetey-1-2013:p0228:b004:l015","ordinal":94322,"en":"All of those champions,"},{"id":"semetey-1-2013:p0228:b004:l016","ordinal":94323,"en":"Their leaders of ten bobbing in their saddles,"},{"id":"semetey-1-2013:p0228:b004:l017","ordinal":94324,"en":"Their spears jutting up,"},{"id":"semetey-1-2013:p0228:b004:l018","ordinal":94325,"en":"Their executioners roused to frenzy,"},{"id":"semetey-1-2013:p0228:b004:l019","ordinal":94326,"en":"With seven thousand at their side,"},{"id":"semetey-1-2013:p0228:b004:l020","ordinal":94327,"en":"Went on in wild excitement,"},{"id":"semetey-1-2013:p0228:b004:l021","ordinal":94328,"en":"Raging like madmen,"},{"id":"semetey-1-2013:p0228:b004:l022","ordinal":94329,"en":"Sparing no horses on the road,"},{"id":"semetey-1-2013:p0228:b004:l023","ordinal":94330,"en":"Traveling far without restraint."},{"id":"semetey-1-2013:p0228:b004:l024","ordinal":94331,"en":"Semetey set out."},{"id":"semetey-1-2013:p0228:b004:l025","ordinal":94332,"en":"With seventy champions beside him,"},{"id":"semetey-1-2013:p0228:b004:l026","ordinal":94333,"en":"From the sandy, saddle-shaped ridge"},{"id":"semetey-1-2013:p0228:b004:l027","ordinal":94334,"en":"Semetey came burning with rage."},{"id":"semetey-1-2013:p0228:b004:l028","ordinal":94335,"en":"Drawing his sword, tight-lipped,"},{"id":"semetey-1-2013:p0228:b004:l029","ordinal":94336,"en":"Slipping along like a dragon,"},{"id":"semetey-1-2013:p0228:b004:l030","ordinal":94337,"en":"Looking nowhere about him,"},{"id":"semetey-1-2013:p0228:b004:l031","ordinal":94338,"en":"Having heard Ismail's words,"},{"id":"semetey-1-2013:p0228:b004:l032","ordinal":94339,"en":"Sparing his life not at all,"},{"id":"semetey-1-2013:p0228:b004:l033","ordinal":94340,"en":"They beat the drums"},{"id":"semetey-1-2013:p0228:b004:l034","ordinal":94341,"en":"And went to block the narrow road."},{"id":"semetey-1-2013:p0228:b004:l035","ordinal":94342,"en":"Thus your mother"},{"id":"semetey-1-2013:p0228:b004:l036","ordinal":94343,"en":"Was now waylaid by the orphan."},{"id":"semetey-1-2013:p0228:b004:l037","ordinal":94344,"en":"With seventy champions behind,"},{"id":"semetey-1-2013:p0228:b004:l038","ordinal":94345,"en":"Semetey came burning with rage."},{"id":"semetey-1-2013:p0228:b004:l039","ordinal":94346,"en":"Let us leave this here,"},{"id":"semetey-1-2013:p0229:b003:l001","ordinal":94347,"en":"Upon the saddle-shaped ridge"},{"id":"semetey-1-2013:p0229:b003:l002","ordinal":94348,"en":"She stood unable to find peace,"},{"id":"semetey-1-2013:p0229:b003:l003","ordinal":94349,"en":"Your mother Kanykei."},{"id":"semetey-1-2013:p0229:b003:l004","ordinal":94350,"en":"Let us begin to tell of her."},{"id":"semetey-1-2013:p0229:b003:l005","ordinal":94351,"en":"Your dear mother Kanykei"},{"id":"semetey-1-2013:p0229:b003:l006","ordinal":94352,"en":"Was a blessed soul."},{"id":"semetey-1-2013:p0229:b003:l007","ordinal":94353,"en":"A voice was heard, its owner unseen:"},{"id":"semetey-1-2013:p0229:b003:l008","ordinal":94354,"en":"Upon your sister-in-law's shoulder"},{"id":"semetey-1-2013:p0229:b003:l009","ordinal":94355,"en":"There was a naked child."},{"id":"semetey-1-2013:p0229:b003:l010","ordinal":94356,"en":"Of torment and of sorrow"},{"id":"semetey-1-2013:p0229:b003:l011","ordinal":94357,"en":"That child gave warning."},{"id":"semetey-1-2013:p0229:b003:l012","ordinal":94358,"en":"Gripping her ear and murmuring,"},{"id":"semetey-1-2013:p0229:b003:l013","ordinal":94359,"en":"Then her child"},{"id":"semetey-1-2013:p0229:b003:l014","ordinal":94360,"en":"Whispered to her:"},{"id":"semetey-1-2013:p0229:b003:l015","ordinal":94361,"en":"'Oh, Kanykei, poor soul,"},{"id":"semetey-1-2013:p0229:b003:l016","ordinal":94362,"en":"Dip your hands in water,"},{"id":"semetey-1-2013:p0229:b003:l017","ordinal":94363,"en":"Perform your hands' ablution."},{"id":"semetey-1-2013:p0229:b003:l018","ordinal":94364,"en":"Put your feet in water,"},{"id":"semetey-1-2013:p0229:b003:l019","ordinal":94365,"en":"Perform your feet's ablution."},{"id":"semetey-1-2013:p0229:b003:l020","ordinal":94366,"en":"That dear bird, the wild duck—"},{"id":"semetey-1-2013:p0229:b003:l021","ordinal":94367,"en":"From the plain whence it does not return,"},{"id":"semetey-1-2013:p0229:b003:l022","ordinal":94368,"en":"Wild with racing horses,"},{"id":"semetey-1-2013:p0229:b003:l023","ordinal":94369,"en":"You will die before your appointed death"},{"id":"semetey-1-2013:p0229:b003:l024","ordinal":94370,"en":"At the hands of the child from your womb."},{"id":"semetey-1-2013:p0229:b003:l025","ordinal":94371,"en":"If Taitoru comes first,"},{"id":"semetey-1-2013:p0229:b003:l026","ordinal":94372,"en":"You will see your orphan."},{"id":"semetey-1-2013:p0229:b003:l027","ordinal":94373,"en":"If Taitoru falls behind,"},{"id":"semetey-1-2013:p0229:b003:l028","ordinal":94374,"en":"You will die before your time."},{"id":"semetey-1-2013:p0229:b003:l029","ordinal":94375,"en":"Unsaved from suffering,"},{"id":"semetey-1-2013:p0229:b003:l030","ordinal":94376,"en":"You will face the Last Judgment."},{"id":"semetey-1-2013:p0229:b003:l031","ordinal":94377,"en":"If Taitoru comes first,"},{"id":"semetey-1-2013:p0229:b003:l032","ordinal":94378,"en":"God has granted your wish."},{"id":"semetey-1-2013:p0229:b003:l033","ordinal":94379,"en":"If this horse falls behind,"},{"id":"semetey-1-2013:p0229:b003:l034","ordinal":94380,"en":"Pass through the city of Küzgü;"},{"id":"semetey-1-2013:p0229:b003:l035","ordinal":94381,"en":"Give up your hope of life."},{"id":"semetey-1-2013:p0229:b003:l036","ordinal":94382,"en":"With seventy champions beside him,"},{"id":"semetey-1-2013:p0229:b003:l037","ordinal":94383,"en":"Your orphan comes in a frenzy,"},{"id":"semetey-1-2013:p0229:b003:l038","ordinal":94384,"en":"Their swords gleaming,"},{"id":"semetey-1-2013:p0229:b003:l039","ordinal":94385,"en":"To cut off your head,"},{"id":"semetey-1-2013:p0229:b004:l001","ordinal":94386,"en":"His champions come in a frenzy."},{"id":"semetey-1-2013:p0229:b004:l002","ordinal":94387,"en":"The khan's command is a grievous thing;"},{"id":"semetey-1-2013:p0229:b004:l003","ordinal":94388,"en":"Now force has come upon you."},{"id":"semetey-1-2013:p0229:b004:l004","ordinal":94389,"en":"If this bay horse falls behind,"},{"id":"semetey-1-2013:p0229:b004:l005","ordinal":94390,"en":"You will braid the hair down your back."},{"id":"semetey-1-2013:p0229:b004:l006","ordinal":94391,"en":"Through the champions given orders,"},{"id":"semetey-1-2013:p0229:b004:l007","ordinal":94392,"en":"You will die before your time."},{"id":"semetey-1-2013:p0229:b004:l008","ordinal":94393,"en":"When seven wolves rend one sheep,"},{"id":"semetey-1-2013:p0229:b004:l009","ordinal":94394,"en":"Will they leave its carcass?"},{"id":"semetey-1-2013:p0229:b004:l010","ordinal":94395,"en":"If seventy champions and Semetey"},{"id":"semetey-1-2013:p0229:b004:l011","ordinal":94396,"en":"Beat you, will they leave your corpse?"},{"id":"semetey-1-2013:p0229:b004:l012","ordinal":94397,"en":"Your kin has become your enemy;"},{"id":"semetey-1-2013:p0229:b004:l013","ordinal":94398,"en":"Your anguish is shut inside you."},{"id":"semetey-1-2013:p0229:b004:l014","ordinal":94399,"en":"He chose his spear and swung it;"},{"id":"semetey-1-2013:p0229:b004:l015","ordinal":94400,"en":"Your own brother Ismail"},{"id":"semetey-1-2013:p0229:b004:l016","ordinal":94401,"en":"Turned him to evil and sent him."},{"id":"semetey-1-2013:p0229:b004:l017","ordinal":94402,"en":"He will slaughter your life like a fly,"},{"id":"semetey-1-2013:p0229:b004:l018","ordinal":94403,"en":"Will drain your strength."},{"id":"semetey-1-2013:p0229:b004:l019","ordinal":94404,"en":"Semetey, left by your khan Manas,"},{"id":"semetey-1-2013:p0229:b004:l020","ordinal":94405,"en":"Comes to shed your blood."},{"id":"semetey-1-2013:p0229:b004:l021","ordinal":94406,"en":"Desired today, gone tomorrow—"},{"id":"semetey-1-2013:p0229:b004:l022","ordinal":94407,"en":"Such is this shit of a world."},{"id":"semetey-1-2013:p0229:b004:l023","ordinal":94408,"en":"Your orphan, left by the warrior,"},{"id":"semetey-1-2013:p0229:b004:l024","ordinal":94409,"en":"Will heap live coals upon your head."},{"id":"semetey-1-2013:p0229:b004:l025","ordinal":94410,"en":"To separate you and save you,"},{"id":"semetey-1-2013:p0229:b004:l026","ordinal":94411,"en":"Look, your Kyrgyz people are not here."},{"id":"semetey-1-2013:p0229:b004:l027","ordinal":94412,"en":"You have no support to lean upon,"},{"id":"semetey-1-2013:p0229:b004:l028","ordinal":94413,"en":"No stronghold where you can take shelter."},{"id":"semetey-1-2013:p0229:b004:l029","ordinal":94414,"en":"Racing your horse without foreknowledge,"},{"id":"semetey-1-2013:p0229:b004:l030","ordinal":94415,"en":"You have thus come to nothing.'"},{"id":"semetey-1-2013:p0229:b004:l031","ordinal":94416,"en":"When she heard this news,"},{"id":"semetey-1-2013:p0229:b004:l032","ordinal":94417,"en":"Her heart burned into embers."},{"id":"semetey-1-2013:p0229:b004:l033","ordinal":94418,"en":"That blessed, passionate woman's"},{"id":"semetey-1-2013:p0229:b004:l034","ordinal":94419,"en":"Beloved people were not here."},{"id":"semetey-1-2013:p0229:b004:l035","ordinal":94420,"en":"She had no support to lean upon,"},{"id":"semetey-1-2013:p0229:b004:l036","ordinal":94421,"en":"She grieved sorely on that road;"},{"id":"semetey-1-2013:p0229:b004:l037","ordinal":94422,"en":"Her renowned Argyn people were not here."},{"id":"semetey-1-2013:p0229:b004:l038","ordinal":94423,"en":"Her rib bones came apart,"},{"id":"semetey-1-2013:p0229:b004:l039","ordinal":94424,"en":"The tears streamed from her eyes,"},{"id":"semetey-1-2013:p0230:b003:l001","ordinal":94425,"en":"Her poor heart was torn apart."},{"id":"semetey-1-2013:p0230:b003:l002","ordinal":94426,"en":"By the son born of herself"},{"id":"semetey-1-2013:p0230:b003:l003","ordinal":94427,"en":"It seemed that she would die."},{"id":"semetey-1-2013:p0230:b003:l004","ordinal":94428,"en":"A dark day fell upon her."},{"id":"semetey-1-2013:p0230:b003:l005","ordinal":94429,"en":"Upon your sister-in-law's head"},{"id":"semetey-1-2013:p0230:b003:l006","ordinal":94430,"en":"Seventy afflictions fell at once."},{"id":"semetey-1-2013:p0230:b003:l007","ordinal":94431,"en":"Unless the one Creator God"},{"id":"semetey-1-2013:p0230:b003:l008","ordinal":94432,"en":"Himself came to her aid,"},{"id":"semetey-1-2013:p0230:b003:l009","ordinal":94433,"en":"Upon your sister-in-law's head"},{"id":"semetey-1-2013:p0230:b003:l010","ordinal":94434,"en":"Utter calamity had fallen."},{"id":"semetey-1-2013:p0230:b003:l011","ordinal":94435,"en":"Unable to stand, crying out in tears,"},{"id":"semetey-1-2013:p0230:b003:l012","ordinal":94436,"en":"She despaired of her very life."},{"id":"semetey-1-2013:p0230:b003:l013","ordinal":94437,"en":"Finding not a fly's worth of recourse,"},{"id":"semetey-1-2013:p0230:b003:l014","ordinal":94438,"en":"Her heart was sorely torn,"},{"id":"semetey-1-2013:p0230:b003:l015","ordinal":94439,"en":"The tears poured from her eyes."},{"id":"semetey-1-2013:p0230:b003:l016","ordinal":94440,"en":"Her heart was sorely torn."},{"id":"semetey-1-2013:p0230:b003:l017","ordinal":94441,"en":"By the son born of herself"},{"id":"semetey-1-2013:p0230:b003:l018","ordinal":94442,"en":"It seemed that she would die."},{"id":"semetey-1-2013:p0230:b003:l019","ordinal":94443,"en":"Upon the winding plain,"},{"id":"semetey-1-2013:p0230:b003:l020","ordinal":94444,"en":"She cried out in terrible fear"},{"id":"semetey-1-2013:p0230:b003:l021","ordinal":94445,"en":"Of the child born from her womb."},{"id":"semetey-1-2013:p0230:b003:l022","ordinal":94446,"en":"Unable to turn Akborchuk's head,"},{"id":"semetey-1-2013:p0230:b003:l023","ordinal":94447,"en":"Unable to stop her tears,"},{"id":"semetey-1-2013:p0230:b003:l024","ordinal":94448,"en":"From her pitiful quail-like eyes,"},{"id":"semetey-1-2013:p0230:b003:l025","ordinal":94449,"en":"From the mother you have seen,"},{"id":"semetey-1-2013:p0230:b003:l026","ordinal":94450,"en":"The tears fell drop by drop."},{"id":"semetey-1-2013:p0230:b003:l027","ordinal":94451,"en":"From her dear currant-black eyes"},{"id":"semetey-1-2013:p0230:b003:l028","ordinal":94452,"en":"The tears streamed a whip's length."},{"id":"semetey-1-2013:p0230:b003:l029","ordinal":94453,"en":"‘That dear bird, the wild duck—"},{"id":"semetey-1-2013:p0230:b003:l030","ordinal":94454,"en":"From the plain whence it does not return,"},{"id":"semetey-1-2013:p0230:b003:l031","ordinal":94455,"en":"Wild with racing horses,"},{"id":"semetey-1-2013:p0230:b003:l032","ordinal":94456,"en":"Will I die before my time"},{"id":"semetey-1-2013:p0230:b003:l033","ordinal":94457,"en":"At the hands of the child from my womb?"},{"id":"semetey-1-2013:p0230:b003:l034","ordinal":94458,"en":"That dear bird called the little bustard—"},{"id":"semetey-1-2013:p0230:b003:l035","ordinal":94459,"en":"From the plain from which it flies away,"},{"id":"semetey-1-2013:p0230:b003:l036","ordinal":94460,"en":"Wild with racing horses,"},{"id":"semetey-1-2013:p0230:b003:l037","ordinal":94461,"en":"I am to die an unshriven death, alas,"},{"id":"semetey-1-2013:p0230:b003:l038","ordinal":94462,"en":"At the hands of the child I bore my lord."},{"id":"semetey-1-2013:p0230:b003:l039","ordinal":94463,"en":"I ran like a hunting hound."},{"id":"semetey-1-2013:p0230:b004:l001","ordinal":94464,"en":"Distress came upon me,"}]
