[{"id":"seytek-2012:p0864:b002:l019","ordinal":360705,"en":"No crime, no conflict"},{"id":"seytek-2012:p0864:b002:l020","ordinal":360706,"en":"He died while playing."},{"id":"seytek-2012:p0864:b002:l021","ordinal":360707,"en":"A brave soul"},{"id":"seytek-2012:p0864:b002:l022","ordinal":360708,"en":"It was endlessly straight,"},{"id":"seytek-2012:p0864:b002:l023","ordinal":360709,"en":"There was another force that was troubling."},{"id":"seytek-2012:p0864:b002:l024","ordinal":360710,"en":"This is a scandal, a big scandal"},{"id":"seytek-2012:p0864:b002:l025","ordinal":360711,"en":"It was an unforgettable event."},{"id":"seytek-2012:p0864:b002:l026","ordinal":360712,"en":"Deprived of name and tone,"},{"id":"seytek-2012:p0864:b002:l027","ordinal":360713,"en":"Wandering in the middle,"},{"id":"seytek-2012:p0864:b002:l028","ordinal":360714,"en":"Aryslan hides in the lion's den,"},{"id":"seytek-2012:p0864:b002:l029","ordinal":360715,"en":"In pain,"},{"id":"seytek-2012:p0864:b002:l030","ordinal":360716,"en":"Countless thoughts"},{"id":"seytek-2012:p0864:b002:l031","ordinal":360717,"en":"We will die soon,"},{"id":"seytek-2012:p0864:b002:l032","ordinal":360718,"en":"Zhelpinishke is a lonely soul"},{"id":"seytek-2012:p0864:b002:l033","ordinal":360719,"en":"We will die without leaving."},{"id":"seytek-2012:p0864:b002:l034","ordinal":360720,"en":"There is no raven flying,"},{"id":"seytek-2012:p0864:b002:l035","ordinal":360721,"en":"We will stay in the desert,"},{"id":"seytek-2012:p0864:b002:l036","ordinal":360722,"en":"As Er Sarybay,"},{"id":"seytek-2012:p0864:b002:l037","ordinal":360723,"en":"Not too happy to play,"},{"id":"seytek-2012:p0864:b002:l038","ordinal":360724,"en":"We would stay in Bel."},{"id":"seytek-2012:p0864:b002:l039","ordinal":360725,"en":"Atikpay was furious"},{"id":"seytek-2012:p0864:b002:l040","ordinal":360726,"en":"Unsharpened the spear,"},{"id":"seytek-2012:p0864:b003:l001","ordinal":360727,"en":"In fact, it's ugly"},{"id":"seytek-2012:p0864:b003:l002","ordinal":360728,"en":"We would stay in the people."},{"id":"seytek-2012:p0864:b003:l003","ordinal":360729,"en":"A great scandal, a thick sher"},{"id":"seytek-2012:p0864:b003:l004","ordinal":360730,"en":"We came to see"},{"id":"seytek-2012:p0864:b003:l005","ordinal":360731,"en":"Being embarrassed,"},{"id":"seytek-2012:p0864:b003:l006","ordinal":360732,"en":"We came to die"},{"id":"seytek-2012:p0864:b003:l007","ordinal":360733,"en":"No waist, no back"},{"id":"seytek-2012:p0864:b003:l008","ordinal":360734,"en":"We were on the way,"},{"id":"seytek-2012:p0864:b003:l009","ordinal":360735,"en":"Your mind is running away, your head is confused,"},{"id":"seytek-2012:p0864:b003:l010","ordinal":360736,"en":"We stayed in Shor."},{"id":"seytek-2012:p0864:b003:l011","ordinal":360737,"en":"If you notice, suffering is a problem"},{"id":"seytek-2012:p0864:b003:l012","ordinal":360738,"en":"The hero hides in the community,"},{"id":"seytek-2012:p0864:b003:l013","ordinal":360739,"en":"Suffering, trouble, humiliation,"},{"id":"seytek-2012:p0864:b003:l014","ordinal":360740,"en":"We got into a lot of trouble,"},{"id":"seytek-2012:p0864:b003:l015","ordinal":360741,"en":"Sarybay did violence"},{"id":"seytek-2012:p0864:b003:l016","ordinal":360742,"en":"Red massacre"},{"id":"seytek-2012:p0864:b003:l017","ordinal":360743,"en":"Facing the red people,"},{"id":"seytek-2012:p0864:b003:l018","ordinal":360744,"en":"There was a riot of red blood,"},{"id":"seytek-2012:p0864:b003:l019","ordinal":360745,"en":"Kyzytalak is a pervert"},{"id":"seytek-2012:p0864:b003:l020","ordinal":360746,"en":"That was the beginning."},{"id":"seytek-2012:p0864:b003:l021","ordinal":360747,"en":"There is no place to move around,"},{"id":"seytek-2012:p0864:b003:l022","ordinal":360748,"en":"There is no revenge in Kyrgyz"},{"id":"seytek-2012:p0864:b003:l023","ordinal":360749,"en":"In pain,"},{"id":"seytek-2012:p0864:b003:l024","ordinal":360750,"en":"Hiding in the quarrel,"},{"id":"seytek-2012:p0864:b003:l025","ordinal":360751,"en":"Abuse, trouble,"},{"id":"seytek-2012:p0864:b003:l026","ordinal":360752,"en":"We came to see"},{"id":"seytek-2012:p0864:b003:l027","ordinal":360753,"en":"The created gold is a precious soul"},{"id":"seytek-2012:p0864:b003:l028","ordinal":360754,"en":"Donate to Sarybay"},{"id":"seytek-2012:p0864:b003:l029","ordinal":360755,"en":"We came to give."},{"id":"seytek-2012:p0864:b003:l030","ordinal":360756,"en":"We do not smoke,"},{"id":"seytek-2012:p0864:b003:l031","ordinal":360757,"en":"Such is the problem"},{"id":"seytek-2012:p0864:b003:l032","ordinal":360758,"en":"We will not return to the people on vacation."},{"id":"seytek-2012:p0864:b003:l033","ordinal":360759,"en":"It was bad for us"},{"id":"seytek-2012:p0864:b003:l034","ordinal":360760,"en":"From the wind,"},{"id":"seytek-2012:p0864:b003:l035","ordinal":360761,"en":"Our throat is broken,"},{"id":"seytek-2012:p0864:b003:l036","ordinal":360762,"en":"People run, clap their hands,"},{"id":"seytek-2012:p0864:b003:l037","ordinal":360763,"en":"There are many people standing"},{"id":"seytek-2012:p0864:b003:l038","ordinal":360764,"en":"In the next war"},{"id":"seytek-2012:p0864:b003:l039","ordinal":360765,"en":"Echen horse runner"},{"id":"seytek-2012:p0864:b003:l040","ordinal":360766,"en":"Saddle stitch on the side"},{"id":"seytek-2012:p0865:b002:l001","ordinal":360767,"en":"Many who once reveled now wander,"},{"id":"seytek-2012:p0865:b002:l002","ordinal":360768,"en":"Many souls wander wailing,"},{"id":"seytek-2012:p0865:b002:l003","ordinal":360769,"en":"And much livestock has been left ownerless."},{"id":"seytek-2012:p0865:b002:l004","ordinal":360770,"en":"“Alas, my dear brother,"},{"id":"seytek-2012:p0865:b002:l005","ordinal":360771,"en":"He died innocently, for nothing,”"},{"id":"seytek-2012:p0865:b002:l006","ordinal":360772,"en":"“On a road of torment with no turning back,"},{"id":"seytek-2012:p0865:b002:l007","ordinal":360773,"en":"He met an infidel’s fate,”"},{"id":"seytek-2012:p0865:b002:l008","ordinal":360774,"en":"Many people wander lamenting."},{"id":"seytek-2012:p0865:b002:l009","ordinal":360775,"en":"Yellow with wasting sickness,"},{"id":"seytek-2012:p0865:b002:l010","ordinal":360776,"en":"Their hearts, minds, and thoughts"},{"id":"seytek-2012:p0865:b002:l011","ordinal":360777,"en":"Are distracted—many among the people;"},{"id":"seytek-2012:p0865:b002:l012","ordinal":360778,"en":"Yellow with wasting sickness,"},{"id":"seytek-2012:p0865:b002:l013","ordinal":360779,"en":"Many mortals suffer anxiety,"},{"id":"seytek-2012:p0865:b002:l014","ordinal":360780,"en":"And all their reason and thoughts"},{"id":"seytek-2012:p0865:b002:l015","ordinal":360781,"en":"Are distracted as well;"},{"id":"seytek-2012:p0865:b002:l016","ordinal":360782,"en":"Some have perished in battle,"},{"id":"seytek-2012:p0865:b002:l017","ordinal":360783,"en":"And others too have died."},{"id":"seytek-2012:p0865:b002:l018","ordinal":360784,"en":"“Ah, Sarybai, we are done for,” they say,"},{"id":"seytek-2012:p0865:b002:l019","ordinal":360785,"en":"“Through Choro, the blue-maned brother,"},{"id":"seytek-2012:p0865:b002:l020","ordinal":360786,"en":"We have endured great calamity,” they say."},{"id":"seytek-2012:p0865:b002:l021","ordinal":360787,"en":"“I shall seize the lands"},{"id":"seytek-2012:p0865:b002:l022","ordinal":360788,"en":"Of the consummate blue-maned lions,” he said,"},{"id":"seytek-2012:p0865:b002:l023","ordinal":360789,"en":"“I, brother to a lion, a bloodthirsty tyrant,"},{"id":"seytek-2012:p0865:b002:l024","ordinal":360790,"en":"Shall oppress the people,” he said."},{"id":"seytek-2012:p0865:b002:l025","ordinal":360791,"en":"“An army from the whole world gathered,"},{"id":"seytek-2012:p0865:b002:l026","ordinal":360792,"en":"But in the end we were miserably slaughtered;"},{"id":"seytek-2012:p0865:b002:l027","ordinal":360793,"en":"He slew so many of us,” they say."},{"id":"seytek-2012:p0865:b002:l028","ordinal":360794,"en":"“He heeds no guilt or pity,"},{"id":"seytek-2012:p0865:b002:l029","ordinal":360795,"en":"But wrought a total massacre,” they say."},{"id":"seytek-2012:p0865:b002:l030","ordinal":360796,"en":"Their cruppers torn apart,"},{"id":"seytek-2012:p0865:b002:l031","ordinal":360797,"en":"Many wander ruined among the host;"},{"id":"seytek-2012:p0865:b002:l032","ordinal":360798,"en":"Their girths snapped,"},{"id":"seytek-2012:p0865:b002:l033","ordinal":360799,"en":"Their saddles slipped beneath their bellies,"},{"id":"seytek-2012:p0865:b002:l034","ordinal":360800,"en":"Many people rush about in panic."},{"id":"seytek-2012:p0865:b002:l035","ordinal":360801,"en":"Staggering senseless in confusion,"},{"id":"seytek-2012:p0865:b002:l036","ordinal":360802,"en":"Their two legs dangling,"},{"id":"seytek-2012:p0865:b002:l037","ordinal":360803,"en":"Every knee scraped raw,"},{"id":"seytek-2012:p0865:b002:l038","ordinal":360804,"en":"Every rein torn apart,"},{"id":"seytek-2012:p0865:b002:l039","ordinal":360805,"en":"Armor ripped and fluttering,"},{"id":"seytek-2012:p0865:b002:l040","ordinal":360806,"en":"Spears shattered with a shriek,"},{"id":"seytek-2012:p0865:b004:l001","ordinal":360807,"en":"“Ah, Sarybai has slain us,” they say,"},{"id":"seytek-2012:p0865:b004:l002","ordinal":360808,"en":"“He killed until his fury was spent,” they say."},{"id":"seytek-2012:p0865:b004:l003","ordinal":360809,"en":"“The people are ruined in massacre;"},{"id":"seytek-2012:p0865:b004:l004","ordinal":360810,"en":"Thus has God struck us,” they say."},{"id":"seytek-2012:p0865:b004:l005","ordinal":360811,"en":"“This tyrant’s offspring"},{"id":"seytek-2012:p0865:b004:l006","ordinal":360812,"en":"Would humiliate and slaughter us,” they say."},{"id":"seytek-2012:p0865:b004:l007","ordinal":360813,"en":"“This monstrous slave Sarybai"},{"id":"seytek-2012:p0865:b004:l008","ordinal":360814,"en":"Has made sport of countless men,” they say."},{"id":"seytek-2012:p0865:b004:l009","ordinal":360815,"en":"“The Lord Creator made Sarybai"},{"id":"seytek-2012:p0865:b004:l010","ordinal":360816,"en":"Great and powerful,” they say."},{"id":"seytek-2012:p0865:b004:l011","ordinal":360817,"en":"“He inflicted misery and humiliation;"},{"id":"seytek-2012:p0865:b004:l012","ordinal":360818,"en":"Sarybai is a vicious dog,"},{"id":"seytek-2012:p0865:b004:l013","ordinal":360819,"en":"He has butchered us all,” they say."},{"id":"seytek-2012:p0865:b004:l014","ordinal":360820,"en":"“If death should overtake us suddenly,"},{"id":"seytek-2012:p0865:b004:l015","ordinal":360821,"en":"If by mischance we perish,"},{"id":"seytek-2012:p0865:b004:l016","ordinal":360822,"en":"We shall know him for the dog he is,"},{"id":"seytek-2012:p0865:b004:l017","ordinal":360823,"en":"If the rumors told are true."},{"id":"seytek-2012:p0865:b004:l018","ordinal":360824,"en":"On the Judgment Morning at dawn,"},{"id":"seytek-2012:p0865:b004:l019","ordinal":360825,"en":"That swaggering swine"},{"id":"seytek-2012:p0865:b004:l020","ordinal":360826,"en":"We shall make ride a black donkey,” they said."},{"id":"seytek-2012:p0865:b004:l021","ordinal":360827,"en":"So the army clamored,"},{"id":"seytek-2012:p0865:b004:l022","ordinal":360828,"en":"Until the host lost its senses,"},{"id":"seytek-2012:p0865:b004:l023","ordinal":360829,"en":"And while they poured out their grief,"},{"id":"seytek-2012:p0865:b004:l024","ordinal":360830,"en":"Kulansur, the steed he rode,"},{"id":"seytek-2012:p0865:b004:l025","ordinal":360831,"en":"Flew rumbling like a cloud;"},{"id":"seytek-2012:p0865:b004:l026","ordinal":360832,"en":"The stones struck by his hooves"},{"id":"seytek-2012:p0865:b004:l027","ordinal":360833,"en":"Shattered with a ringing cry."},{"id":"seytek-2012:p0865:b004:l028","ordinal":360834,"en":"Rearing and surging forward,"},{"id":"seytek-2012:p0865:b004:l029","ordinal":360835,"en":"The riderless Kulansur"},{"id":"seytek-2012:p0865:b004:l030","ordinal":360836,"en":"Shot ahead like an arrow;"},{"id":"seytek-2012:p0865:b004:l031","ordinal":360837,"en":"That splendid steed had a flowing mane,"},{"id":"seytek-2012:p0865:b004:l032","ordinal":360838,"en":"And for the young hero Seytek"},{"id":"seytek-2012:p0865:b004:l033","ordinal":360839,"en":"He had been born a perfect match."},{"id":"seytek-2012:p0865:b004:l034","ordinal":360840,"en":"When he glided, he was like a snake;"},{"id":"seytek-2012:p0865:b004:l035","ordinal":360841,"en":"When he wheeled, he was like a whirlwind;"},{"id":"seytek-2012:p0865:b004:l036","ordinal":360842,"en":"When he strode, he was like a wild ass—"},{"id":"seytek-2012:p0865:b004:l037","ordinal":360843,"en":"Such was the nature of that horse."},{"id":"seytek-2012:p0865:b004:l038","ordinal":360844,"en":"The riderless fleet-footed steed"},{"id":"seytek-2012:p0865:b004:l039","ordinal":360845,"en":"He made rear and plunge,"},{"id":"seytek-2012:p0865:b004:l040","ordinal":360846,"en":"And seized the white reins knotted in a loop."},{"id":"seytek-2012:p0866:b002:l001","ordinal":360847,"en":"The reins fitted Kulansur perfectly;"},{"id":"seytek-2012:p0866:b002:l002","ordinal":360848,"en":"He gripped them hard in both hands,"},{"id":"seytek-2012:p0866:b002:l003","ordinal":360849,"en":"And wrestled with the mouth"},{"id":"seytek-2012:p0866:b002:l004","ordinal":360850,"en":"Of the black steed flying like a cloud."},{"id":"seytek-2012:p0866:b002:l005","ordinal":360851,"en":"The reins stretched thin as thread;"},{"id":"seytek-2012:p0866:b002:l006","ordinal":360852,"en":"When the black steed saw the mountain"},{"id":"seytek-2012:p0866:b002:l007","ordinal":360853,"en":"And bucked, the black earth"},{"id":"seytek-2012:p0866:b002:l008","ordinal":360854,"en":"Was gouged out on every side."},{"id":"seytek-2012:p0866:b002:l009","ordinal":360855,"en":"When he struck out with unerring steps,"},{"id":"seytek-2012:p0866:b002:l010","ordinal":360856,"en":"The ground he trod burst apart;"},{"id":"seytek-2012:p0866:b002:l011","ordinal":360857,"en":"A cloud of dust as large as a house"},{"id":"seytek-2012:p0866:b002:l012","ordinal":360858,"en":"Whirled above the head"},{"id":"seytek-2012:p0866:b002:l013","ordinal":360859,"en":"Of the fortunate hero."},{"id":"seytek-2012:p0866:b002:l014","ordinal":360860,"en":"His broad front teeth, like a gate,"},{"id":"seytek-2012:p0866:b002:l015","ordinal":360861,"en":"Shone like steel within his mouth;"},{"id":"seytek-2012:p0866:b002:l016","ordinal":360862,"en":"The black steed’s splayed stride"},{"id":"seytek-2012:p0866:b002:l017","ordinal":360863,"en":"Appeared as broad as a ravine."},{"id":"seytek-2012:p0866:b002:l018","ordinal":360864,"en":"The polished steel spear in his hand"},{"id":"seytek-2012:p0866:b002:l019","ordinal":360865,"en":"Danced and darted in his grasp;"},{"id":"seytek-2012:p0866:b002:l020","ordinal":360866,"en":"The descendant of the noble lion"},{"id":"seytek-2012:p0866:b002:l021","ordinal":360867,"en":"Wore the aspect of one thirsting for blood."},{"id":"seytek-2012:p0866:b002:l022","ordinal":360868,"en":"Those he charged were scorched to ashes;"},{"id":"seytek-2012:p0866:b002:l023","ordinal":360869,"en":"Those he struck ceased to exist."},{"id":"seytek-2012:p0866:b002:l024","ordinal":360870,"en":"He reached the army and cut through it,"},{"id":"seytek-2012:p0866:b002:l025","ordinal":360871,"en":"Spearing everyone he met."},{"id":"seytek-2012:p0866:b002:l026","ordinal":360872,"en":"He swung the spear in his hand,"},{"id":"seytek-2012:p0866:b002:l027","ordinal":360873,"en":"Aimed it at the hollow"},{"id":"seytek-2012:p0866:b002:l028","ordinal":360874,"en":"Above each breastbone, and drove it home."},{"id":"seytek-2012:p0866:b002:l029","ordinal":360875,"en":"The axe flashed in his hand,"},{"id":"seytek-2012:p0866:b002:l030","ordinal":360876,"en":"The iron mace crashed upon heads;"},{"id":"seytek-2012:p0866:b002:l031","ordinal":360877,"en":"Blood poured from those he struck,"},{"id":"seytek-2012:p0866:b002:l032","ordinal":360878,"en":"Life fled from those he smote."},{"id":"seytek-2012:p0866:b002:l033","ordinal":360879,"en":"His spear blazed like a fiery ember,"},{"id":"seytek-2012:p0866:b002:l034","ordinal":360880,"en":"And no one struck by it remained."},{"id":"seytek-2012:p0866:b002:l035","ordinal":360881,"en":"Sarybai, who had advanced in force,"},{"id":"seytek-2012:p0866:b002:l036","ordinal":360882,"en":"Halted as though he had drunk poison."},{"id":"seytek-2012:p0866:b002:l037","ordinal":360883,"en":"Every rein was cut,"},{"id":"seytek-2012:p0866:b002:l038","ordinal":360884,"en":"And the vast host he had summoned"},{"id":"seytek-2012:p0866:b002:l039","ordinal":360885,"en":"Was now gathered"},{"id":"seytek-2012:p0866:b002:l040","ordinal":360886,"en":"Before Sarybai."},{"id":"seytek-2012:p0866:b003:l001","ordinal":360887,"en":"The people lost their senses,"},{"id":"seytek-2012:p0866:b003:l002","ordinal":360888,"en":"The vast army rose in uproar,"},{"id":"seytek-2012:p0866:b003:l003","ordinal":360889,"en":"Pressing around Sarybai;"},{"id":"seytek-2012:p0866:b003:l004","ordinal":360890,"en":"Many commanders of the host"},{"id":"seytek-2012:p0866:b003:l005","ordinal":360891,"en":"Gathered around Sarybai,"},{"id":"seytek-2012:p0866:b003:l006","ordinal":360892,"en":"And the people assembled with a clamor."},{"id":"seytek-2012:p0866:b003:l007","ordinal":360893,"en":"The great army that had gone to war"},{"id":"seytek-2012:p0866:b003:l008","ordinal":360894,"en":"Despaired of its precious life."},{"id":"seytek-2012:p0866:b003:l009","ordinal":360895,"en":"His matchless lionhearted courage,"},{"id":"seytek-2012:p0866:b003:l010","ordinal":360896,"en":"His valor famed through the ages,"},{"id":"seytek-2012:p0866:b003:l011","ordinal":360897,"en":"Revealed the hero Seytek;"},{"id":"seytek-2012:p0866:b003:l012","ordinal":360898,"en":"Wherever he carved into them, they split apart."},{"id":"seytek-2012:p0866:b003:l013","ordinal":360899,"en":"He did not merely raise a furious clash—"},{"id":"seytek-2012:p0866:b003:l014","ordinal":360900,"en":"Every soul despaired."},{"id":"seytek-2012:p0866:b003:l015","ordinal":360901,"en":"“My wrestlers, my lions,” he cried,"},{"id":"seytek-2012:p0866:b003:l016","ordinal":360902,"en":"Toppling them backward from their horses,"},{"id":"seytek-2012:p0866:b003:l017","ordinal":360903,"en":"He defeated and drove them onward."},{"id":"seytek-2012:p0866:b003:l018","ordinal":360904,"en":"The spear he thrust seemed to lengthen,"},{"id":"seytek-2012:p0866:b003:l019","ordinal":360905,"en":"His eyes reddened like a lion’s;"},{"id":"seytek-2012:p0866:b003:l020","ordinal":360906,"en":"Breaking the ranks of the countless host,"},{"id":"seytek-2012:p0866:b003:l021","ordinal":360907,"en":"He swallowed them up and drove them on."},{"id":"seytek-2012:p0866:b003:l022","ordinal":360908,"en":"“May his forefather Manas stand beside him,” they said,"},{"id":"seytek-2012:p0866:b003:l023","ordinal":360909,"en":"“May God set every deed aright,” they said."},{"id":"seytek-2012:p0866:b003:l024","ordinal":360910,"en":"He roared in fury,"},{"id":"seytek-2012:p0866:b003:l025","ordinal":360911,"en":"Slaughtering, driving, and scattering them;"},{"id":"seytek-2012:p0866:b003:l026","ordinal":360912,"en":"The world filled with dust,"},{"id":"seytek-2012:p0866:b003:l027","ordinal":360913,"en":"And their heads reeled in bewilderment."},{"id":"seytek-2012:p0866:b003:l028","ordinal":360914,"en":"He speared them one after another,"},{"id":"seytek-2012:p0866:b003:l029","ordinal":360915,"en":"Crushing the ground wherever he passed;"},{"id":"seytek-2012:p0866:b003:l030","ordinal":360916,"en":"The side he advanced upon became deserted,"},{"id":"seytek-2012:p0866:b003:l031","ordinal":360917,"en":"Those he faced were consumed by fire,"},{"id":"seytek-2012:p0866:b003:l032","ordinal":360918,"en":"And all he encountered were slain."},{"id":"seytek-2012:p0866:b003:l033","ordinal":360919,"en":"He made Kulansur dance,"},{"id":"seytek-2012:p0866:b003:l034","ordinal":360920,"en":"And made everyone he met cry out;"},{"id":"seytek-2012:p0866:b003:l035","ordinal":360921,"en":"In groups of a hundred and forty"},{"id":"seytek-2012:p0866:b003:l036","ordinal":360922,"en":"He herded them away."},{"id":"seytek-2012:p0866:b003:l037","ordinal":360923,"en":"He bent the brave double,"},{"id":"seytek-2012:p0866:b003:l038","ordinal":360924,"en":"Slaughtering as he went."},{"id":"seytek-2012:p0866:b003:l039","ordinal":360925,"en":"Those who resisted and stood their ground,"},{"id":"seytek-2012:p0866:b003:l040","ordinal":360926,"en":"Those who swaggered like men"},{"id":"seytek-2012:p0867:b002:l001","ordinal":360927,"en":"And faced him defiantly,"},{"id":"seytek-2012:p0867:b002:l002","ordinal":360928,"en":"Along with their comrades—"},{"id":"seytek-2012:p0867:b002:l003","ordinal":360929,"en":"Thirty tigers who had closed around them,"},{"id":"seytek-2012:p0867:b002:l004","ordinal":360930,"en":"A fold no wind could penetrate,"},{"id":"seytek-2012:p0867:b002:l005","ordinal":360931,"en":"And thirty-five companions—"},{"id":"seytek-2012:p0867:b002:l006","ordinal":360932,"en":"He left their arms hanging limp,"},{"id":"seytek-2012:p0867:b002:l007","ordinal":360933,"en":"And, without killing them, left their eyes staring;"},{"id":"seytek-2012:p0867:b002:l008","ordinal":360934,"en":"Tormenting them while still alive,"},{"id":"seytek-2012:p0867:b002:l009","ordinal":360935,"en":"He bound them and drove them away."},{"id":"seytek-2012:p0867:b002:l010","ordinal":360936,"en":"Those wretches who would not submit"},{"id":"seytek-2012:p0867:b002:l011","ordinal":360937,"en":"He prodded with his spear"},{"id":"seytek-2012:p0867:b002:l012","ordinal":360938,"en":"And drove away."},{"id":"seytek-2012:p0867:b002:l013","ordinal":360939,"en":"At the sight, the heart was overwhelmed;"},{"id":"seytek-2012:p0867:b002:l014","ordinal":360940,"en":"They loomed like a blue hill,"},{"id":"seytek-2012:p0867:b002:l015","ordinal":360941,"en":"The lions Manas and Semetey"},{"id":"seytek-2012:p0867:b002:l016","ordinal":360942,"en":"Appeared like a deep blue valley."},{"id":"seytek-2012:p0867:b002:l017","ordinal":360943,"en":"They wounded all who took up spears,"},{"id":"seytek-2012:p0867:b002:l018","ordinal":360944,"en":"Cutting through the sixfold host;"},{"id":"seytek-2012:p0867:b002:l019","ordinal":360945,"en":"When within reach, they speared them,"},{"id":"seytek-2012:p0867:b002:l020","ordinal":360946,"en":"And those who came close enough to strike"},{"id":"seytek-2012:p0867:b002:l021","ordinal":360947,"en":"They smashed with battle-axes."},{"id":"seytek-2012:p0867:b002:l022","ordinal":360948,"en":"Those they faced they stretched out dead,"},{"id":"seytek-2012:p0867:b002:l023","ordinal":360949,"en":"Those they met they felled;"},{"id":"seytek-2012:p0867:b002:l024","ordinal":360950,"en":"Those who came face-to-face"},{"id":"seytek-2012:p0867:b002:l025","ordinal":360951,"en":"They destroyed with swords,"},{"id":"seytek-2012:p0867:b002:l026","ordinal":360952,"en":"And those who ventured even closer"},{"id":"seytek-2012:p0867:b002:l027","ordinal":360953,"en":"They struck down with battle-axes."},{"id":"seytek-2012:p0867:b002:l028","ordinal":360954,"en":"The earth turned green-black, filled with blood;"},{"id":"seytek-2012:p0867:b002:l029","ordinal":360955,"en":"For the return of peaceful, joyous times"},{"id":"seytek-2012:p0867:b002:l030","ordinal":360956,"en":"The vast army yearned."},{"id":"seytek-2012:p0867:b002:l031","ordinal":360957,"en":"The people cried out in uproar,"},{"id":"seytek-2012:p0867:b002:l032","ordinal":360958,"en":"Fleeing ridge to ridge for shelter;"},{"id":"seytek-2012:p0867:b002:l033","ordinal":360959,"en":"Hero Külchoro and hero Seytek"},{"id":"seytek-2012:p0867:b002:l034","ordinal":360960,"en":"Moved among the people like tigers."}]
