[{"id":"seytek-2012:p0958:b003:l021","ordinal":370433,"en":"Is a creature born one of a kind,"},{"id":"seytek-2012:p0958:b003:l022","ordinal":370434,"en":"Like a host of encircling wolves,"},{"id":"seytek-2012:p0958:b003:l023","ordinal":370435,"en":"A beast come plainly into view."},{"id":"seytek-2012:p0958:b003:l024","ordinal":370436,"en":"Upon Kulansur, who yields to no pursuit,"},{"id":"seytek-2012:p0958:b003:l025","ordinal":370437,"en":"I shall cast a cold lasso;"},{"id":"seytek-2012:p0958:b003:l026","ordinal":370438,"en":"Kulansur, who will not yield when asked,"},{"id":"seytek-2012:p0958:b003:l027","ordinal":370439,"en":"I shall escort away through spilled blood."},{"id":"seytek-2012:p0958:b003:l028","ordinal":370440,"en":"I shall raise an unflagging tumult,"},{"id":"seytek-2012:p0958:b003:l029","ordinal":370441,"en":"Stir boundless calamity and uproar,"},{"id":"seytek-2012:p0958:b003:l030","ordinal":370442,"en":"Find my chance and wreak slaughter,"},{"id":"seytek-2012:p0958:b003:l031","ordinal":370443,"en":"And avenge my ancient grudge."},{"id":"seytek-2012:p0958:b003:l032","ordinal":370444,"en":"I shall defeat the princely people;"},{"id":"seytek-2012:p0958:b003:l033","ordinal":370445,"en":"If the sly boy falls into my hands,"},{"id":"seytek-2012:p0958:b003:l034","ordinal":370446,"en":"I shall drink his blood like kumis."},{"id":"seytek-2012:p0958:b003:l035","ordinal":370447,"en":"I shall open everyone’s eyes;"},{"id":"seytek-2012:p0958:b003:l036","ordinal":370448,"en":"If by chance he falls into my hands,"},{"id":"seytek-2012:p0958:b003:l037","ordinal":370449,"en":"I shall feast upon his young liver,"},{"id":"seytek-2012:p0958:b003:l038","ordinal":370450,"en":"Spear his mighty warriors,"},{"id":"seytek-2012:p0958:b003:l039","ordinal":370451,"en":"And conquer his hardy men."},{"id":"seytek-2012:p0958:b003:l040","ordinal":370452,"en":"If he falls into my hands, he will go no farther—"},{"id":"seytek-2012:p0959:b002:l001","ordinal":370453,"en":"So saying, Sarybai"},{"id":"seytek-2012:p0959:b002:l002","ordinal":370454,"en":"Gathered as much courage as he could,"},{"id":"seytek-2012:p0959:b002:l003","ordinal":370455,"en":"Venom touching his blackened mouth;"},{"id":"seytek-2012:p0959:b002:l004","ordinal":370456,"en":"He took heart and thundered,"},{"id":"seytek-2012:p0959:b002:l005","ordinal":370457,"en":"And the mortal frame"},{"id":"seytek-2012:p0959:b002:l006","ordinal":370458,"en":"Of humankind shuddered from head to foot."},{"id":"seytek-2012:p0959:b002:l007","ordinal":370459,"en":"When he raged, calamity arose,"},{"id":"seytek-2012:p0959:b002:l008","ordinal":370460,"en":"And wherever he struck was leveled."},{"id":"seytek-2012:p0959:b002:l009","ordinal":370461,"en":"Wrath burst from his courage,"},{"id":"seytek-2012:p0959:b002:l010","ordinal":370462,"en":"Venom poured toward all he faced—"},{"id":"seytek-2012:p0959:b002:l011","ordinal":370463,"en":"Thus Sarybai advanced."},{"id":"seytek-2012:p0959:b002:l012","ordinal":370464,"en":"From the depths of hell itself,"},{"id":"seytek-2012:p0959:b002:l013","ordinal":370465,"en":"Born as the Antichrist,"},{"id":"seytek-2012:p0959:b002:l014","ordinal":370466,"en":"Sarybai had come."},{"id":"seytek-2012:p0959:b002:l015","ordinal":370467,"en":"Mustering all his courage,"},{"id":"seytek-2012:p0959:b002:l016","ordinal":370468,"en":"His glaring eyes became fire,"},{"id":"seytek-2012:p0959:b002:l017","ordinal":370469,"en":"His insides blazed like embers;"},{"id":"seytek-2012:p0959:b002:l018","ordinal":370470,"en":"His bristling hair stood wild,"},{"id":"seytek-2012:p0959:b002:l019","ordinal":370471,"en":"His inner nature was transformed,"},{"id":"seytek-2012:p0959:b002:l020","ordinal":370472,"en":"Revealing blood-drinking ferocity."},{"id":"seytek-2012:p0959:b002:l021","ordinal":370473,"en":"When he cried out in rage,"},{"id":"seytek-2012:p0959:b002:l022","ordinal":370474,"en":"He seemed about to swallow the whole world;"},{"id":"seytek-2012:p0959:b002:l023","ordinal":370475,"en":"Anyone who witnessed his full fury"},{"id":"seytek-2012:p0959:b002:l024","ordinal":370476,"en":"Fled in panic, crying, “I am dead!”"},{"id":"seytek-2012:p0959:b002:l025","ordinal":370477,"en":"Had he fought for six years,"},{"id":"seytek-2012:p0959:b002:l026","ordinal":370478,"en":"Had he slain the armies of the world,"},{"id":"seytek-2012:p0959:b002:l027","ordinal":370479,"en":"Had he endured grievous hardship,"},{"id":"seytek-2012:p0959:b002:l028","ordinal":370480,"en":"His strength spent and his head aching—"},{"id":"seytek-2012:p0959:b002:l029","ordinal":370481,"en":"Such was the fearsome boar’s"},{"id":"seytek-2012:p0959:b002:l030","ordinal":370482,"en":"Demeanor when you saw him."},{"id":"seytek-2012:p0959:b002:l031","ordinal":370483,"en":"Onto the broad field of death,"},{"id":"seytek-2012:p0959:b002:l032","ordinal":370484,"en":"He came forth and faced the fray,"},{"id":"seytek-2012:p0959:b002:l033","ordinal":370485,"en":"Bearing twelve different weapons—"},{"id":"seytek-2012:p0959:b002:l034","ordinal":370486,"en":"May they be accursed."},{"id":"seytek-2012:p0959:b002:l035","ordinal":370487,"en":"Let me learn whether he is a man:"},{"id":"seytek-2012:p0959:b002:l036","ordinal":370488,"en":"Rejoicing at the thought of death,"},{"id":"seytek-2012:p0959:b002:l037","ordinal":370489,"en":"He prepared to unleash his wrath,"},{"id":"seytek-2012:p0959:b002:l038","ordinal":370490,"en":"Wrapped himself in battle gear,"},{"id":"seytek-2012:p0959:b002:l039","ordinal":370491,"en":"His ferocity plain to see,"},{"id":"seytek-2012:p0959:b002:l040","ordinal":370492,"en":"And donned his armored coat."},{"id":"seytek-2012:p0959:b003:l001","ordinal":370493,"en":"His manly courage showed"},{"id":"seytek-2012:p0959:b003:l002","ordinal":370494,"en":"As he put on his precious mail,"},{"id":"seytek-2012:p0959:b003:l003","ordinal":370495,"en":"Starting as though seized by frenzy,"},{"id":"seytek-2012:p0959:b003:l004","ordinal":370496,"en":"And saddled Tookyzyl."},{"id":"seytek-2012:p0959:b003:l005","ordinal":370497,"en":"He girded on the black-steel, blood-shedding"},{"id":"seytek-2012:p0959:b003:l006","ordinal":370498,"en":"Zulfiqar sword."},{"id":"seytek-2012:p0959:b003:l007","ordinal":370499,"en":"Fleeing before the sight of his wrath,"},{"id":"seytek-2012:p0959:b003:l008","ordinal":370500,"en":"The smoothly flowing river,"},{"id":"seytek-2012:p0959:b003:l009","ordinal":370501,"en":"The plane tree and fruit-bearing willow—"},{"id":"seytek-2012:p0959:b003:l010","ordinal":370502,"en":"Before his courage and fury,"},{"id":"seytek-2012:p0959:b003:l011","ordinal":370503,"en":"Even speechless beasts submitted."},{"id":"seytek-2012:p0959:b003:l012","ordinal":370504,"en":"Sarybai, son of a monster,"},{"id":"seytek-2012:p0959:b003:l013","ordinal":370505,"en":"Armed himself and rode to war."},{"id":"seytek-2012:p0959:b003:l014","ordinal":370506,"en":"The ill-fated boar"},{"id":"seytek-2012:p0959:b003:l015","ordinal":370507,"en":"Found the strife he had sought."},{"id":"seytek-2012:p0959:b003:l016","ordinal":370508,"en":"When the seventh day came,"},{"id":"seytek-2012:p0959:b003:l017","ordinal":370509,"en":"The appointed, promised day,"},{"id":"seytek-2012:p0959:b003:l018","ordinal":370510,"en":"And its time was fully reached,"},{"id":"seytek-2012:p0959:b003:l019","ordinal":370511,"en":"When dawn shone clear,"},{"id":"seytek-2012:p0959:b003:l020","ordinal":370512,"en":"And light fell upon the earth,"},{"id":"seytek-2012:p0959:b003:l021","ordinal":370513,"en":"Brave Seytek’s seer,"},{"id":"seytek-2012:p0959:b003:l022","ordinal":370514,"en":"Who knew the face of the world,"},{"id":"seytek-2012:p0959:b003:l023","ordinal":370515,"en":"Went out to the watch and saw him;"},{"id":"seytek-2012:p0959:b003:l024","ordinal":370516,"en":"Such a thing happened in the world."},{"id":"seytek-2012:p0959:b003:l025","ordinal":370517,"en":"At that very watchpost,"},{"id":"seytek-2012:p0959:b003:l026","ordinal":370518,"en":"At the dark eye of the spring,"},{"id":"seytek-2012:p0959:b003:l027","ordinal":370519,"en":"Beside the great plane tree,"},{"id":"seytek-2012:p0959:b003:l028","ordinal":370520,"en":"When your khan-father Manas lived,"},{"id":"seytek-2012:p0959:b003:l029","ordinal":370521,"en":"Scouts stood nearby."},{"id":"seytek-2012:p0959:b003:l030","ordinal":370522,"en":"At that same watchpost,"},{"id":"seytek-2012:p0959:b003:l031","ordinal":370523,"en":"After ranging through many lands,"},{"id":"seytek-2012:p0959:b003:l032","ordinal":370524,"en":"Scouts who knew every country"},{"id":"seytek-2012:p0959:b003:l033","ordinal":370525,"en":"And guards who bent beneath their vigilance stood."},{"id":"seytek-2012:p0959:b003:l034","ordinal":370526,"en":"Brave Seytek, the prince’s son,"},{"id":"seytek-2012:p0959:b003:l035","ordinal":370527,"en":"Seytek, whose four kinds of livestock stood ready,"},{"id":"seytek-2012:p0959:b003:l036","ordinal":370528,"en":"Kept eighty sentries and five scouts"},{"id":"seytek-2012:p0959:b003:l037","ordinal":370529,"en":"Patrolling the land."},{"id":"seytek-2012:p0959:b003:l038","ordinal":370530,"en":"To spy an enemy from afar,"},{"id":"seytek-2012:p0959:b003:l039","ordinal":370531,"en":"They struck the great drum with a crash,"},{"id":"seytek-2012:p0959:b003:l040","ordinal":370532,"en":"As though ready to devour any raven they saw;"},{"id":"seytek-2012:p0960:b002:l001","ordinal":370533,"en":"If even a crow appeared from afar,"},{"id":"seytek-2012:p0960:b002:l002","ordinal":370534,"en":"They would carry word to the city."},{"id":"seytek-2012:p0960:b002:l003","ordinal":370535,"en":"They stood throughout the land,"},{"id":"seytek-2012:p0960:b002:l004","ordinal":370536,"en":"To learn the truth"},{"id":"seytek-2012:p0960:b002:l005","ordinal":370537,"en":"About kinsman and enemy,"},{"id":"seytek-2012:p0960:b002:l006","ordinal":370538,"en":"Serving as messengers between them."},{"id":"seytek-2012:p0960:b002:l007","ordinal":370539,"en":"What the hollows were like, what the mountains were like—"},{"id":"seytek-2012:p0960:b002:l008","ordinal":370540,"en":"They were guides who returned at a run."},{"id":"seytek-2012:p0960:b002:l009","ordinal":370541,"en":"At the slightest stirring they turned back;"},{"id":"seytek-2012:p0960:b002:l010","ordinal":370542,"en":"At the command to speak, they instantly"},{"id":"seytek-2012:p0960:b002:l011","ordinal":370543,"en":"Reported whatever they saw"},{"id":"seytek-2012:p0960:b002:l012","ordinal":370544,"en":"To lion-maned Seytek,"},{"id":"seytek-2012:p0960:b002:l013","ordinal":370545,"en":"Traveling under concealment,"},{"id":"seytek-2012:p0960:b002:l014","ordinal":370546,"en":"And whenever anything occurred,"},{"id":"seytek-2012:p0960:b002:l015","ordinal":370547,"en":"Bringing word of what appeared."},{"id":"seytek-2012:p0960:b002:l016","ordinal":370548,"en":"The diviner at the watchpost,"},{"id":"seytek-2012:p0960:b002:l017","ordinal":370549,"en":"An inheritance from the forefathers,"},{"id":"seytek-2012:p0960:b002:l018","ordinal":370550,"en":"A keen eye handed down by heroes,"},{"id":"seytek-2012:p0960:b002:l019","ordinal":370551,"en":"Spoke his words clearly"},{"id":"seytek-2012:p0960:b002:l020","ordinal":370552,"en":"And lived openly among men."},{"id":"seytek-2012:p0960:b002:l021","ordinal":370553,"en":"When Sarybai, son of a monster,"},{"id":"seytek-2012:p0960:b002:l022","ordinal":370554,"en":"Rode out for single combat,"},{"id":"seytek-2012:p0960:b002:l023","ordinal":370555,"en":"The brave diviner saw him,"},{"id":"seytek-2012:p0960:b002:l024","ordinal":370556,"en":"And at once brought the lion-maned hero"},{"id":"seytek-2012:p0960:b002:l025","ordinal":370557,"en":"News for Seytek."},{"id":"seytek-2012:p0960:b002:l026","ordinal":370558,"en":"Then the diviner"},{"id":"seytek-2012:p0960:b002:l027","ordinal":370559,"en":"Spoke these words:"},{"id":"seytek-2012:p0960:b002:l028","ordinal":370560,"en":"“Lion-maned Seytek, hear me;"},{"id":"seytek-2012:p0960:b002:l029","ordinal":370561,"en":"I have seen a marvel such as this."},{"id":"seytek-2012:p0960:b002:l030","ordinal":370562,"en":"In all the world I have never seen"},{"id":"seytek-2012:p0960:b002:l031","ordinal":370563,"en":"A man of such surpassing terror."},{"id":"seytek-2012:p0960:b002:l032","ordinal":370564,"en":"Do not refuse what I say:"},{"id":"seytek-2012:p0960:b002:l033","ordinal":370565,"en":"To the ravaging monster,"},{"id":"seytek-2012:p0960:b002:l034","ordinal":370566,"en":"Hero, you granted a term of seven days;"},{"id":"seytek-2012:p0960:b002:l035","ordinal":370567,"en":"The enraged Sarybai"},{"id":"seytek-2012:p0960:b002:l036","ordinal":370568,"en":"Is a fearsome calamity such as this."},{"id":"seytek-2012:p0960:b002:l037","ordinal":370569,"en":"His lion eyes are blazing,"},{"id":"seytek-2012:p0960:b002:l038","ordinal":370570,"en":"His overflowing rage is boiling;"},{"id":"seytek-2012:p0960:b002:l039","ordinal":370571,"en":"He is swollen like a blue tick—"},{"id":"seytek-2012:p0960:b002:l040","ordinal":370572,"en":"Such is his appearance."},{"id":"seytek-2012:p0960:b003:l001","ordinal":370573,"en":"Armed and furious,"},{"id":"seytek-2012:p0960:b003:l002","ordinal":370574,"en":"Draped in black velvet,"},{"id":"seytek-2012:p0960:b003:l003","ordinal":370575,"en":"Khan Sarybai rages;"},{"id":"seytek-2012:p0960:b003:l004","ordinal":370576,"en":"His stare is like a tiger’s."},{"id":"seytek-2012:p0960:b003:l005","ordinal":370577,"en":"No man could face"},{"id":"seytek-2012:p0960:b003:l006","ordinal":370578,"en":"That foul-natured boar;"},{"id":"seytek-2012:p0960:b003:l007","ordinal":370579,"en":"His roar is like a lion’s."},{"id":"seytek-2012:p0960:b003:l008","ordinal":370580,"en":"The ravager who drives the people mad"},{"id":"seytek-2012:p0960:b003:l009","ordinal":370581,"en":"Seems able to grind them into sand beneath his feet."},{"id":"seytek-2012:p0960:b003:l010","ordinal":370582,"en":"No living soul can withstand his wrestling;"},{"id":"seytek-2012:p0960:b003:l011","ordinal":370583,"en":"Those he meets seem to fall dead."},{"id":"seytek-2012:p0960:b003:l012","ordinal":370584,"en":"His cry is like a lion’s;"},{"id":"seytek-2012:p0960:b003:l013","ordinal":370585,"en":"His strength seems to have overflowed."},{"id":"seytek-2012:p0960:b003:l014","ordinal":370586,"en":"Unable to withstand his might,"},{"id":"seytek-2012:p0960:b003:l015","ordinal":370587,"en":"Khans, common folk, and living creatures"},{"id":"seytek-2012:p0960:b003:l016","ordinal":370588,"en":"Seem to flee in terrified haste."},{"id":"seytek-2012:p0960:b003:l017","ordinal":370589,"en":"Sarybai has ridden out for single combat—"},{"id":"seytek-2012:p0960:b003:l018","ordinal":370590,"en":"Such is your monster."},{"id":"seytek-2012:p0960:b003:l019","ordinal":370591,"en":"He looks ready to slaughter his opponent,"},{"id":"seytek-2012:p0960:b003:l020","ordinal":370592,"en":"To gnaw apart whoever meets him;"},{"id":"seytek-2012:p0960:b003:l021","ordinal":370593,"en":"His baleful venom is so great"},{"id":"seytek-2012:p0960:b003:l022","ordinal":370594,"en":"That he seems ready to swallow anyone he encounters."},{"id":"seytek-2012:p0960:b003:l023","ordinal":370595,"en":"Such is the hero’s ferocity."},{"id":"seytek-2012:p0960:b003:l024","ordinal":370596,"en":"His figure is like a mountain ridge,"},{"id":"seytek-2012:p0960:b003:l025","ordinal":370597,"en":"His blue-black hardness is like iron."},{"id":"seytek-2012:p0960:b003:l026","ordinal":370598,"en":"When you behold his wrath and venom,"},{"id":"seytek-2012:p0960:b003:l027","ordinal":370599,"en":"He seems ready to devour the living—"},{"id":"seytek-2012:p0960:b003:l028","ordinal":370600,"en":"Such is his valor."},{"id":"seytek-2012:p0960:b003:l029","ordinal":370601,"en":"Brave Sarybai has come as a warrior;"},{"id":"seytek-2012:p0960:b003:l030","ordinal":370602,"en":"From the infidel’s fury,"},{"id":"seytek-2012:p0960:b003:l031","ordinal":370603,"en":"The black earth itself shook."},{"id":"seytek-2012:p0960:b003:l032","ordinal":370604,"en":"His destructiveness was beyond counting;"},{"id":"seytek-2012:p0960:b003:l033","ordinal":370605,"en":"I saw him arrive."},{"id":"seytek-2012:p0960:b003:l034","ordinal":370606,"en":"He became an ember burning with spite;"},{"id":"seytek-2012:p0960:b003:l035","ordinal":370607,"en":"Before the infidel’s imposing form,"},{"id":"seytek-2012:p0960:b003:l036","ordinal":370608,"en":"The speechless flowing river"},{"id":"seytek-2012:p0960:b003:l037","ordinal":370609,"en":"Ceased its course and stood still."},{"id":"seytek-2012:p0960:b003:l038","ordinal":370610,"en":"No common multitude can stand"},{"id":"seytek-2012:p0960:b003:l039","ordinal":370611,"en":"Against the enraged infidel."},{"id":"seytek-2012:p0960:b003:l040","ordinal":370612,"en":"When he bellows, he kills;"},{"id":"seytek-2012:p0961:b002:l001","ordinal":370613,"en":"Unless the one Creator alone knows how,"},{"id":"seytek-2012:p0961:b002:l002","ordinal":370614,"en":"My child, no living human"},{"id":"seytek-2012:p0961:b002:l003","ordinal":370615,"en":"Can withstand him."},{"id":"seytek-2012:p0961:b002:l004","ordinal":370616,"en":"When he charges in fury,"},{"id":"seytek-2012:p0961:b002:l005","ordinal":370617,"en":"Every living creature"},{"id":"seytek-2012:p0961:b002:l006","ordinal":370618,"en":"Flees without looking back."},{"id":"seytek-2012:p0961:b002:l007","ordinal":370619,"en":"Sarybai, son of a monster—"},{"id":"seytek-2012:p0961:b002:l008","ordinal":370620,"en":"Such is his savagery."},{"id":"seytek-2012:p0961:b002:l009","ordinal":370621,"en":"Father, what a black-hearted swine!"},{"id":"seytek-2012:p0961:b002:l010","ordinal":370622,"en":"He has fixed his eyes upon the khan;"},{"id":"seytek-2012:p0961:b002:l011","ordinal":370623,"en":"When they meet in collision,"},{"id":"seytek-2012:p0961:b002:l012","ordinal":370624,"en":"He will rend him till his life is stilled."},{"id":"seytek-2012:p0961:b002:l013","ordinal":370625,"en":"Many champions have fallen before him;"},{"id":"seytek-2012:p0961:b002:l014","ordinal":370626,"en":"He tore all the honorable people"},{"id":"seytek-2012:p0961:b002:l015","ordinal":370627,"en":"Like tufts of spring wool."},{"id":"seytek-2012:p0961:b002:l016","ordinal":370628,"en":"Because of that ill-fated swine,"},{"id":"seytek-2012:p0961:b002:l017","ordinal":370629,"en":"That infidel who devastated the nation,"},{"id":"seytek-2012:p0961:b002:l018","ordinal":370630,"en":"That calamity fallen upon the people,"},{"id":"seytek-2012:p0961:b002:l019","ordinal":370631,"en":"The host wailed and the khan died;"},{"id":"seytek-2012:p0961:b002:l020","ordinal":370632,"en":"All who fought him died."},{"id":"seytek-2012:p0961:b002:l021","ordinal":370633,"en":"Heroes died in the mounted struggle,"},{"id":"seytek-2012:p0961:b002:l022","ordinal":370634,"en":"Many mighty wrestlers and lions died."},{"id":"seytek-2012:p0961:b002:l023","ordinal":370635,"en":"Our young warriors were destroyed;"},{"id":"seytek-2012:p0961:b002:l024","ordinal":370636,"en":"Through Sarybai’s terrible violence,"},{"id":"seytek-2012:p0961:b002:l025","ordinal":370637,"en":"Our finest heroes wept."},{"id":"seytek-2012:p0961:b002:l026","ordinal":370638,"en":"The looming ridge was leveled;"},{"id":"seytek-2012:p0961:b002:l027","ordinal":370639,"en":"Sarybai’s conflict"},{"id":"seytek-2012:p0961:b002:l028","ordinal":370640,"en":"Became a deed never forgotten."},{"id":"seytek-2012:p0961:b002:l029","ordinal":370641,"en":"Fighting on in grief,"},{"id":"seytek-2012:p0961:b002:l030","ordinal":370642,"en":"Deprived of his great host,"},{"id":"seytek-2012:p0961:b002:l031","ordinal":370643,"en":"The lone scourge shrieked,"},{"id":"seytek-2012:p0961:b002:l032","ordinal":370644,"en":"While many stood trembling."},{"id":"seytek-2012:p0961:b002:l033","ordinal":370645,"en":"Ready for this conflict,"},{"id":"seytek-2012:p0961:b002:l034","ordinal":370646,"en":"Sarybai came to single combat;"},{"id":"seytek-2012:p0961:b002:l035","ordinal":370647,"en":"His victory promised terrible calamity—"},{"id":"seytek-2012:p0961:b002:l036","ordinal":370648,"en":"Such was his customary way."},{"id":"seytek-2012:p0961:b002:l037","ordinal":370649,"en":"Blood burned from his fury,"},{"id":"seytek-2012:p0961:b002:l038","ordinal":370650,"en":"And his voice drove out men’s souls."},{"id":"seytek-2012:p0961:b002:l039","ordinal":370651,"en":"When he appeared directly in single combat,"},{"id":"seytek-2012:p0961:b002:l040","ordinal":370652,"en":"The heart of any mortal man"},{"id":"seytek-2012:p0961:b004:l001","ordinal":370653,"en":"Was torn apart at the sight."},{"id":"seytek-2012:p0961:b004:l002","ordinal":370654,"en":"Pouring out his wrath, he armed himself,"},{"id":"seytek-2012:p0961:b004:l003","ordinal":370655,"en":"Like a black camel bull entering the herd;"},{"id":"seytek-2012:p0961:b004:l004","ordinal":370656,"en":"The ravager came out raging."},{"id":"seytek-2012:p0961:b004:l005","ordinal":370657,"en":"Whoever approached that baleful figure"},{"id":"seytek-2012:p0961:b004:l006","ordinal":370658,"en":"Would see what awaited him, they said;"},{"id":"seytek-2012:p0961:b004:l007","ordinal":370659,"en":"Any multitude that grappled with him"},{"id":"seytek-2012:p0961:b004:l008","ordinal":370660,"en":"Would learn their fate, they said."},{"id":"seytek-2012:p0961:b004:l009","ordinal":370661,"en":"Against this infidel Sarybai,"},{"id":"seytek-2012:p0961:b004:l010","ordinal":370662,"en":"They spread turmoil for six months,"},{"id":"seytek-2012:p0961:b004:l011","ordinal":370663,"en":"Clashing without respite;"},{"id":"seytek-2012:p0961:b004:l012","ordinal":370664,"en":"Those whose doom had come fell."},{"id":"seytek-2012:p0961:b004:l013","ordinal":370665,"en":"“This is utter calamity,”"},{"id":"seytek-2012:p0961:b004:l014","ordinal":370666,"en":"The white-capped Kyrgyz wept."},{"id":"seytek-2012:p0961:b004:l015","ordinal":370667,"en":"The reason for their weeping was this:"},{"id":"seytek-2012:p0961:b004:l016","ordinal":370668,"en":"When he strained and charged,"},{"id":"seytek-2012:p0961:b004:l017","ordinal":370669,"en":"He was like a burning plane-tree ember."},{"id":"seytek-2012:p0961:b004:l018","ordinal":370670,"en":"The infidel’s violent heaving"},{"id":"seytek-2012:p0961:b004:l019","ordinal":370671,"en":"Was like an unbreakable host of warriors;"},{"id":"seytek-2012:p0961:b004:l020","ordinal":370672,"en":"The infidel’s battle cry"},{"id":"seytek-2012:p0961:b004:l021","ordinal":370673,"en":"Was like a bolt of lightning—"},{"id":"seytek-2012:p0961:b004:l022","ordinal":370674,"en":"Such was the sight of his form."},{"id":"seytek-2012:p0961:b004:l023","ordinal":370675,"en":"Oh, Sarybai, you swine,"},{"id":"seytek-2012:p0961:b004:l024","ordinal":370676,"en":"A fierce conflict had arisen;"},{"id":"seytek-2012:p0961:b004:l025","ordinal":370677,"en":"He let none who met him turn back,"},{"id":"seytek-2012:p0961:b004:l026","ordinal":370678,"en":"But seized and slaughtered them thus—"},{"id":"seytek-2012:p0961:b004:l027","ordinal":370679,"en":"Such was his manner of fighting."},{"id":"seytek-2012:p0961:b004:l028","ordinal":370680,"en":"Against this infidel Sarybai,"},{"id":"seytek-2012:p0961:b004:l029","ordinal":370681,"en":"They sent scouts to learn his strength;"},{"id":"seytek-2012:p0961:b004:l030","ordinal":370682,"en":"Unable to face him, many lords died,"},{"id":"seytek-2012:p0961:b004:l031","ordinal":370683,"en":"And so many valiant heroes perished."},{"id":"seytek-2012:p0961:b004:l032","ordinal":370684,"en":"His dreadful fury became overwhelming;"},{"id":"seytek-2012:p0961:b004:l033","ordinal":370685,"en":"Those who met him were laid flat."},{"id":"seytek-2012:p0961:b004:l034","ordinal":370686,"en":"You were a great one, you were a lion;"},{"id":"seytek-2012:p0961:b004:l035","ordinal":370687,"en":"The pillar of all these people,"},{"id":"seytek-2012:p0961:b004:l036","ordinal":370688,"en":"You alone were lion-maned Seytek."}]
