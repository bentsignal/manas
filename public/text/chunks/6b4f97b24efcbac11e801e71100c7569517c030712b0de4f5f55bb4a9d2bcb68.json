[{"id":"semetey-1-2013:p0250:b003:l022","ordinal":96001,"en":"Your sister-in-law dragged him like a fur cap."},{"id":"semetey-1-2013:p0250:b003:l023","ordinal":96002,"en":"Guiding him down the slope,"},{"id":"semetey-1-2013:p0250:b003:l024","ordinal":96003,"en":"Where Tory descended,"},{"id":"semetey-1-2013:p0250:b003:l025","ordinal":96004,"en":"Your immensely strong sister-in-law"},{"id":"semetey-1-2013:p0250:b003:l026","ordinal":96005,"en":"Dragged him light as a feather."},{"id":"semetey-1-2013:p0250:b003:l027","ordinal":96006,"en":"She opened her mouth like a gaping maw."},{"id":"semetey-1-2013:p0250:b003:l028","ordinal":96007,"en":"The great lead rope tied in knotted loops,"},{"id":"semetey-1-2013:p0250:b003:l029","ordinal":96008,"en":"The mallet-like flesh of her white breasts,"},{"id":"semetey-1-2013:p0250:b003:l030","ordinal":96009,"en":"She brought down and pressed."},{"id":"semetey-1-2013:p0250:b003:l031","ordinal":96010,"en":"Crying the battle cry, \"Manas!\""},{"id":"semetey-1-2013:p0250:b003:l032","ordinal":96011,"en":"As she urged Taytoru on,"},{"id":"semetey-1-2013:p0250:b003:l033","ordinal":96012,"en":"He broke away from Chong-Küröng."},{"id":"semetey-1-2013:p0250:b003:l034","ordinal":96013,"en":"Taytoru came forward,"},{"id":"semetey-1-2013:p0250:b003:l035","ordinal":96014,"en":"Drawing alongside Aktulpar."},{"id":"semetey-1-2013:p0250:b003:l036","ordinal":96015,"en":"Aktulpar, an extraordinarily swift steed,"},{"id":"semetey-1-2013:p0250:b003:l037","ordinal":96016,"en":"Was a true racer too."},{"id":"semetey-1-2013:p0250:b003:l038","ordinal":96017,"en":"When they entered a downward slope,"},{"id":"semetey-1-2013:p0250:b003:l039","ordinal":96018,"en":"Aktulpar led by a neck;"},{"id":"semetey-1-2013:p0250:b004:l001","ordinal":96019,"en":"When they began climbing,"},{"id":"semetey-1-2013:p0250:b004:l002","ordinal":96020,"en":"Taytoru led by a neck."},{"id":"semetey-1-2013:p0250:b004:l003","ordinal":96021,"en":"Matched evenly, the noble racing horses,"},{"id":"semetey-1-2013:p0250:b004:l004","ordinal":96022,"en":"The two raced fiercely,"},{"id":"semetey-1-2013:p0250:b004:l005","ordinal":96023,"en":"Their two stirrups clashing."},{"id":"semetey-1-2013:p0250:b004:l006","ordinal":96024,"en":"Your courageous mother Kanykei,"},{"id":"semetey-1-2013:p0250:b004:l007","ordinal":96025,"en":"Roaring in fury,"},{"id":"semetey-1-2013:p0250:b004:l008","ordinal":96026,"en":"Ajybay and Bakai, the two khans,"},{"id":"semetey-1-2013:p0250:b004:l009","ordinal":96027,"en":"Called upon them both."},{"id":"semetey-1-2013:p0250:b004:l010","ordinal":96028,"en":"There was no hill even ankle-high,"},{"id":"semetey-1-2013:p0250:b004:l011","ordinal":96029,"en":"No ravine as big as a saddlecloth,"},{"id":"semetey-1-2013:p0250:b004:l012","ordinal":96030,"en":"No furrow scratched by a plough,"},{"id":"semetey-1-2013:p0250:b004:l013","ordinal":96031,"en":"No burrow dug by a marmot."},{"id":"semetey-1-2013:p0250:b004:l014","ordinal":96032,"en":"When they reached the sandy desert,"},{"id":"semetey-1-2013:p0250:b004:l015","ordinal":96033,"en":"Eyes reddening like a raven's,"},{"id":"semetey-1-2013:p0250:b004:l016","ordinal":96034,"en":"Ahead of Aktulpar,"},{"id":"semetey-1-2013:p0250:b004:l017","ordinal":96035,"en":"Your sister-in-law brought"},{"id":"semetey-1-2013:p0250:b004:l018","ordinal":96036,"en":"The racer Taytoru,"},{"id":"semetey-1-2013:p0250:b004:l019","ordinal":96037,"en":"Sending him six bowshots ahead."},{"id":"semetey-1-2013:p0250:b004:l020","ordinal":96038,"en":"When they reached the sandy plain,"},{"id":"semetey-1-2013:p0250:b004:l021","ordinal":96039,"en":"Eyes reddening like a gazelle's,"},{"id":"semetey-1-2013:p0250:b004:l022","ordinal":96040,"en":"Tory, sixty years beyond his first four,"},{"id":"semetey-1-2013:p0250:b004:l023","ordinal":96041,"en":"Your sister-in-law brought forward,"},{"id":"semetey-1-2013:p0250:b004:l024","ordinal":96042,"en":"Sending him seven bowshots ahead."},{"id":"semetey-1-2013:p0250:b004:l025","ordinal":96043,"en":"Dividing the hair down her back in ten,"},{"id":"semetey-1-2013:p0250:b004:l026","ordinal":96044,"en":"Your sister-in-law came binding it up."},{"id":"semetey-1-2013:p0250:b004:l027","ordinal":96045,"en":"The poor one left by a precious man,"},{"id":"semetey-1-2013:p0250:b004:l028","ordinal":96046,"en":"With blank charges,"},{"id":"semetey-1-2013:p0250:b004:l029","ordinal":96047,"en":"Firing now and then,"},{"id":"semetey-1-2013:p0250:b004:l030","ordinal":96048,"en":"The racer Taytoru,"},{"id":"semetey-1-2013:p0250:b004:l031","ordinal":96049,"en":"She came driving onward."},{"id":"semetey-1-2013:p0250:b004:l032","ordinal":96050,"en":"The poor woman with a warrior's frame,"},{"id":"semetey-1-2013:p0250:b004:l033","ordinal":96051,"en":"Her two eyes blazing,"},{"id":"semetey-1-2013:p0250:b004:l034","ordinal":96052,"en":"Came forth in fiery radiance."},{"id":"semetey-1-2013:p0250:b004:l035","ordinal":96053,"en":"With blank charges,"},{"id":"semetey-1-2013:p0250:b004:l036","ordinal":96054,"en":"The racer Taytoru,"},{"id":"semetey-1-2013:p0250:b004:l037","ordinal":96055,"en":"Your fierce mother Kanykei,"},{"id":"semetey-1-2013:p0250:b004:l038","ordinal":96056,"en":"Firing thunderous shots,"},{"id":"semetey-1-2013:p0250:b004:l039","ordinal":96057,"en":"Came driving onward."},{"id":"semetey-1-2013:p0251:b003:l001","ordinal":96058,"en":"Once God had granted her wish,"},{"id":"semetey-1-2013:p0251:b003:l002","ordinal":96059,"en":"Once Taytoru had come out ahead,"},{"id":"semetey-1-2013:p0251:b003:l003","ordinal":96060,"en":"All her thoughts scattered;"},{"id":"semetey-1-2013:p0251:b003:l004","ordinal":96061,"en":"Unable to stand counting her worries,"},{"id":"semetey-1-2013:p0251:b003:l005","ordinal":96062,"en":"Her tears poured down:"},{"id":"semetey-1-2013:p0251:b003:l006","ordinal":96063,"en":"\"My banner fixed upon a spear,"},{"id":"semetey-1-2013:p0251:b003:l007","ordinal":96064,"en":"My gift left by the magnanimous one,"},{"id":"semetey-1-2013:p0251:b003:l008","ordinal":96065,"en":"My hoof left by a noble steed,"},{"id":"semetey-1-2013:p0251:b003:l009","ordinal":96066,"en":"My dear, unspent warhorse—"},{"id":"semetey-1-2013:p0251:b003:l010","ordinal":96067,"en":"He has not turned his mind elsewhere,"},{"id":"semetey-1-2013:p0251:b003:l011","ordinal":96068,"en":"Has not yet clearly seen that I, unfortunate one,"},{"id":"semetey-1-2013:p0251:b003:l012","ordinal":96069,"en":"Am his mother."},{"id":"semetey-1-2013:p0251:b003:l013","ordinal":96070,"en":"If the tassel is hung upon his spear,"},{"id":"semetey-1-2013:p0251:b003:l014","ordinal":96071,"en":"Manas, gone to the other world—"},{"id":"semetey-1-2013:p0251:b003:l015","ordinal":96072,"en":"If he learns that this is his father!"},{"id":"semetey-1-2013:p0251:b003:l016","ordinal":96073,"en":"If my foal takes after his father,"},{"id":"semetey-1-2013:p0251:b003:l017","ordinal":96074,"en":"He will be a lion protected by Shay."},{"id":"semetey-1-2013:p0251:b003:l018","ordinal":96075,"en":"He will trouble not a single soul;"},{"id":"semetey-1-2013:p0251:b003:l019","ordinal":96076,"en":"He will be a hard-hearted warrior."},{"id":"semetey-1-2013:p0251:b003:l020","ordinal":96077,"en":"My foal's right shoulder blade will be broad;"},{"id":"semetey-1-2013:p0251:b003:l021","ordinal":96078,"en":"He will be a lion who crushes the Oirat."},{"id":"semetey-1-2013:p0251:b003:l022","ordinal":96079,"en":"When Semetey was newly born,"},{"id":"semetey-1-2013:p0251:b003:l023","ordinal":96080,"en":"The Russians ate at his feast and departed."},{"id":"semetey-1-2013:p0251:b003:l024","ordinal":96081,"en":"'If he lives, your foal"},{"id":"semetey-1-2013:p0251:b003:l025","ordinal":96082,"en":"Will crush the Oirat,' they said as they left."},{"id":"semetey-1-2013:p0251:b003:l026","ordinal":96083,"en":"The Chinese ate at his feast and departed."},{"id":"semetey-1-2013:p0251:b003:l027","ordinal":96084,"en":"'If he lives, this child"},{"id":"semetey-1-2013:p0251:b003:l028","ordinal":96085,"en":"Will shake the world,' they said as they left."},{"id":"semetey-1-2013:p0251:b003:l029","ordinal":96086,"en":"If by chance Semetey"},{"id":"semetey-1-2013:p0251:b003:l030","ordinal":96087,"en":"Hears words from gossiping people,"},{"id":"semetey-1-2013:p0251:b003:l031","ordinal":96088,"en":"Hears that his father is Manas,"},{"id":"semetey-1-2013:p0251:b003:l032","ordinal":96089,"en":"Might he think evil of me?"},{"id":"semetey-1-2013:p0251:b003:l033","ordinal":96090,"en":"'When my dear father died,"},{"id":"semetey-1-2013:p0251:b003:l034","ordinal":96091,"en":"Mother, you put on men's clothes,' he may say."},{"id":"semetey-1-2013:p0251:b003:l036","ordinal":96092,"en":"'What a foolish mother you are!"},{"id":"semetey-1-2013:p0251:b003:l037","ordinal":96093,"en":"What were you seeking?' he may say."},{"id":"semetey-1-2013:p0251:b003:l038","ordinal":96094,"en":"Might he gouge out my eyes in bitterness?"},{"id":"semetey-1-2013:p0251:b003:l039","ordinal":96095,"en":"That boy, burning with rage,"},{"id":"semetey-1-2013:p0251:b005:l001","ordinal":96096,"en":"Might he seize me,"},{"id":"semetey-1-2013:p0251:b005:l002","ordinal":96097,"en":"Gouge out my eyes,"},{"id":"semetey-1-2013:p0251:b005:l003","ordinal":96098,"en":"That warrior taking after his father—"},{"id":"semetey-1-2013:p0251:b005:l004","ordinal":96099,"en":"Might he put me to death?"},{"id":"semetey-1-2013:p0251:b005:l005","ordinal":96100,"en":"Now that God has given so much,"},{"id":"semetey-1-2013:p0251:b005:l006","ordinal":96101,"en":"Now that my Taytoru has come out ahead,"},{"id":"semetey-1-2013:p0251:b005:l007","ordinal":96102,"en":"By wearing men's clothes,"},{"id":"semetey-1-2013:p0251:b005:l008","ordinal":96103,"en":"What wish could I fulfill?"},{"id":"semetey-1-2013:p0251:b005:l009","ordinal":96104,"en":"From this time onward, O one God,"},{"id":"semetey-1-2013:p0251:b005:l010","ordinal":96105,"en":"Let me remain in mourning."},{"id":"semetey-1-2013:p0251:b005:l011","ordinal":96106,"en":"Alas, may a fierce leopard never die,"},{"id":"semetey-1-2013:p0251:b005:l012","ordinal":96107,"en":"May no head suffer such grief."},{"id":"semetey-1-2013:p0251:b005:l013","ordinal":96108,"en":"Grief like this,"},{"id":"semetey-1-2013:p0251:b005:l014","ordinal":96109,"en":"If you created us as living souls, God,"},{"id":"semetey-1-2013:p0251:b005:l015","ordinal":96110,"en":"From this time onward, O one God,"},{"id":"semetey-1-2013:p0251:b005:l016","ordinal":96111,"en":"Do not give it to the Muslim people!\""},{"id":"semetey-1-2013:p0251:b005:l017","ordinal":96112,"en":"The poor soul wept in anguish,"},{"id":"semetey-1-2013:p0251:b005:l018","ordinal":96113,"en":"Her rosy face smeared like mud,"},{"id":"semetey-1-2013:p0251:b005:l019","ordinal":96114,"en":"Her tall body bowed down."},{"id":"semetey-1-2013:p0251:b005:l020","ordinal":96115,"en":"\"My Semetey will wear it,\" she had said—"},{"id":"semetey-1-2013:p0251:b005:l021","ordinal":96116,"en":"The marten-fur cap she had made,"},{"id":"semetey-1-2013:p0251:b005:l022","ordinal":96117,"en":"Now she snatched into her hand"},{"id":"semetey-1-2013:p0251:b005:l023","ordinal":96118,"en":"And put into the white saddlebags."},{"id":"semetey-1-2013:p0251:b005:l024","ordinal":96119,"en":"Its collar gold, its sleeves copper,"},{"id":"semetey-1-2013:p0251:b005:l025","ordinal":96120,"en":"Double mail with rings like larks' eyes,"},{"id":"semetey-1-2013:p0251:b005:l026","ordinal":96121,"en":"A fine-cloth sash, a broad sleeveless coat,"},{"id":"semetey-1-2013:p0251:b005:l027","ordinal":96122,"en":"That handsome robe of fine white cloth—"},{"id":"semetey-1-2013:p0251:b005:l028","ordinal":96123,"en":"She took it off again and folded it."},{"id":"semetey-1-2013:p0251:b005:l029","ordinal":96124,"en":"Your dear mother Kanykei,"},{"id":"semetey-1-2013:p0251:b005:l030","ordinal":96125,"en":"Fitting it into the white saddlebags,"},{"id":"semetey-1-2013:p0251:b005:l031","ordinal":96126,"en":"Put it there as well."},{"id":"semetey-1-2013:p0251:b005:l032","ordinal":96127,"en":"Her dear hair, thick as a girth,"},{"id":"semetey-1-2013:p0251:b005:l033","ordinal":96128,"en":"Your impetuous mother Kanykei"},{"id":"semetey-1-2013:p0251:b005:l034","ordinal":96129,"en":"Spread across her breast."},{"id":"semetey-1-2013:p0251:b005:l035","ordinal":96130,"en":"Her dear hair like strands of silk,"},{"id":"semetey-1-2013:p0251:b005:l036","ordinal":96131,"en":"Your mother, reddening it,"},{"id":"semetey-1-2013:p0251:b005:l037","ordinal":96132,"en":"Spread it down before her."},{"id":"semetey-1-2013:p0251:b005:l038","ordinal":96133,"en":"Her dark hair loose,"},{"id":"semetey-1-2013:p0251:b005:l039","ordinal":96134,"en":"Her bloody face torn,"},{"id":"semetey-1-2013:p0252:b003:l001","ordinal":96135,"en":"Her bosom filled with tears."},{"id":"semetey-1-2013:p0252:b003:l002","ordinal":96136,"en":"Alas, her lord Manas"},{"id":"semetey-1-2013:p0252:b003:l003","ordinal":96137,"en":"Seemed to have died just now."},{"id":"semetey-1-2013:p0252:b003:l004","ordinal":96138,"en":"Her Akborchuk paced along;"},{"id":"semetey-1-2013:p0252:b003:l005","ordinal":96139,"en":"Bloody tears flowing from her cheeks,"},{"id":"semetey-1-2013:p0252:b003:l006","ordinal":96140,"en":"The noble gray pacer she rode—"},{"id":"semetey-1-2013:p0252:b003:l007","ordinal":96141,"en":"Down its knees they streamed."},{"id":"semetey-1-2013:p0252:b003:l008","ordinal":96142,"en":"Unable to stop sobbing and weeping,"},{"id":"semetey-1-2013:p0252:b003:l009","ordinal":96143,"en":"She had halted along the river."},{"id":"semetey-1-2013:p0252:b003:l010","ordinal":96144,"en":"If you saw the measure of it then,"},{"id":"semetey-1-2013:p0252:b003:l011","ordinal":96145,"en":"Blessed Manas, the leopard,"},{"id":"semetey-1-2013:p0252:b003:l012","ordinal":96146,"en":"Seemed to have died just now."},{"id":"semetey-1-2013:p0252:b003:l013","ordinal":96147,"en":"She had put on her mourning shroud."},{"id":"semetey-1-2013:p0252:b003:l014","ordinal":96148,"en":"Your dear mother Kanykei,"},{"id":"semetey-1-2013:p0252:b003:l015","ordinal":96149,"en":"Crying out as a woman,"},{"id":"semetey-1-2013:p0252:b003:l016","ordinal":96150,"en":"Was driving Taytoru onward."},{"id":"semetey-1-2013:p0252:b003:l017","ordinal":96151,"en":"That sister-in-law of yours, Kanykei,"},{"id":"semetey-1-2013:p0252:b003:l018","ordinal":96152,"en":"Suffering no one had seen,"},{"id":"semetey-1-2013:p0252:b003:l019","ordinal":96153,"en":"Came enduring."},{"id":"semetey-1-2013:p0252:b003:l020","ordinal":96154,"en":"With blank charges,"},{"id":"semetey-1-2013:p0252:b003:l021","ordinal":96155,"en":"Now and then,"},{"id":"semetey-1-2013:p0252:b003:l022","ordinal":96156,"en":"The racer Taytoru,"},{"id":"semetey-1-2013:p0252:b003:l023","ordinal":96157,"en":"She came urging with gunshots."},{"id":"semetey-1-2013:p0252:b003:l024","ordinal":96158,"en":"Her dear hair, thick as a girth,"},{"id":"semetey-1-2013:p0252:b003:l025","ordinal":96159,"en":"Poured across her breast."},{"id":"semetey-1-2013:p0252:b003:l026","ordinal":96160,"en":"Your impetuous mother Kanykei,"},{"id":"semetey-1-2013:p0252:b003:l027","ordinal":96161,"en":"All her thoughts scattered,"},{"id":"semetey-1-2013:p0252:b003:l028","ordinal":96162,"en":"Your mother's great misfortune"},{"id":"semetey-1-2013:p0252:b003:l029","ordinal":96163,"en":"Came boiling forth."},{"id":"semetey-1-2013:p0252:b003:l030","ordinal":96164,"en":"Following behind Tory,"},{"id":"semetey-1-2013:p0252:b003:l031","ordinal":96165,"en":"Your unfortunate mother Kanykei"},{"id":"semetey-1-2013:p0252:b003:l032","ordinal":96166,"en":"Came driving him onward."},{"id":"semetey-1-2013:p0252:b003:l033","ordinal":96167,"en":"Her poor heart torn,"},{"id":"semetey-1-2013:p0252:b003:l034","ordinal":96168,"en":"She came pouring out her words."},{"id":"semetey-1-2013:p0252:b003:l035","ordinal":96169,"en":"\"The jutting point of a blue ridge,"},{"id":"semetey-1-2013:p0252:b003:l036","ordinal":96170,"en":"My lord, like its promontory,\" she said,"},{"id":"semetey-1-2013:p0252:b003:l037","ordinal":96171,"en":"And came chanting her lament."},{"id":"semetey-1-2013:p0252:b003:l038","ordinal":96172,"en":"(Now God had granted her wish;"},{"id":"semetey-1-2013:p0252:b003:l039","ordinal":96173,"en":"Now Taytoru had come out ahead."},{"id":"semetey-1-2013:p0252:b004:l001","ordinal":96174,"en":"Unable to endure her worries,"},{"id":"semetey-1-2013:p0252:b004:l002","ordinal":96175,"en":"The poor soul placed her true hope"},{"id":"semetey-1-2013:p0252:b004:l003","ordinal":96176,"en":"In the son left by the fierce warrior."},{"id":"semetey-1-2013:p0252:b004:l004","ordinal":96177,"en":"Taytoru comes out ahead;"},{"id":"semetey-1-2013:p0252:b004:l005","ordinal":96178,"en":"Kanykei cries and weeps."},{"id":"semetey-1-2013:p0252:b004:l006","ordinal":96179,"en":"Let us leave this here,"},{"id":"semetey-1-2013:p0252:b004:l007","ordinal":96180,"en":"And Semetey, left by Manas,"},{"id":"semetey-1-2013:p0252:b004:l008","ordinal":96181,"en":"Let us begin the tale of that hero.)"},{"id":"semetey-1-2013:p0252:b004:l009","ordinal":96182,"en":"At that time, Semetey"},{"id":"semetey-1-2013:p0252:b004:l010","ordinal":96183,"en":"Had not yet worn a coat over his back."},{"id":"semetey-1-2013:p0252:b004:l011","ordinal":96184,"en":"Khan Manas, gone to the other world—"},{"id":"semetey-1-2013:p0252:b004:l012","ordinal":96185,"en":"He did not yet know this was his elder kinsman."},{"id":"semetey-1-2013:p0252:b004:l013","ordinal":96186,"en":"At that time, Semetey"},{"id":"semetey-1-2013:p0252:b004:l014","ordinal":96187,"en":"Had his thoughts elsewhere."},{"id":"semetey-1-2013:p0252:b004:l015","ordinal":96188,"en":"His twig had been cut,"},{"id":"semetey-1-2013:p0252:b004:l016","ordinal":96189,"en":"The customary rite performed;"},{"id":"semetey-1-2013:p0252:b004:l017","ordinal":96190,"en":"He was Ismayil's son."},{"id":"semetey-1-2013:p0252:b004:l018","ordinal":96191,"en":"Those dark ridges stretching away—"},{"id":"semetey-1-2013:p0252:b004:l019","ordinal":96192,"en":"He did not yet know that land was his."},{"id":"semetey-1-2013:p0252:b004:l020","ordinal":96193,"en":"That wandering woman Kanykei—"},{"id":"semetey-1-2013:p0252:b004:l021","ordinal":96194,"en":"He did not yet know she was his mother."},{"id":"semetey-1-2013:p0252:b004:l022","ordinal":96195,"en":"The grieving soul, coughing again and again—"},{"id":"semetey-1-2013:p0252:b004:l023","ordinal":96196,"en":"He did not know she had coughed."},{"id":"semetey-1-2013:p0252:b004:l024","ordinal":96197,"en":"Breathless in flight, barefoot,"},{"id":"semetey-1-2013:p0252:b004:l025","ordinal":96198,"en":"He did not know she had hurried on."},{"id":"semetey-1-2013:p0252:b004:l026","ordinal":96199,"en":"Evil days had fallen upon her;"},{"id":"semetey-1-2013:p0252:b004:l027","ordinal":96200,"en":"His poor mother,"},{"id":"semetey-1-2013:p0252:b004:l028","ordinal":96201,"en":"Her soles battered against stones,"},{"id":"semetey-1-2013:p0252:b004:l029","ordinal":96202,"en":"Her brow scorched by the sun,"},{"id":"semetey-1-2013:p0252:b004:l030","ordinal":96203,"en":"Ran in flight without measure."},{"id":"semetey-1-2013:p0252:b004:l031","ordinal":96204,"en":"All the flesh of her soles,"},{"id":"semetey-1-2013:p0252:b004:l032","ordinal":96205,"en":"Striking stones, was torn."},{"id":"semetey-1-2013:p0252:b004:l033","ordinal":96206,"en":"As she walked, dark blood flowed from her calves,"},{"id":"semetey-1-2013:p0252:b004:l034","ordinal":96207,"en":"And the poor soul's strength ebbed away."},{"id":"semetey-1-2013:p0252:b004:l035","ordinal":96208,"en":"With no overshoes, in felt socks,"},{"id":"semetey-1-2013:p0252:b004:l036","ordinal":96209,"en":"The dear soul did not die of grief."},{"id":"semetey-1-2013:p0252:b004:l037","ordinal":96210,"en":"Without boots, in felt socks,"},{"id":"semetey-1-2013:p0252:b004:l038","ordinal":96211,"en":"The dear soul would not die."},{"id":"semetey-1-2013:p0252:b004:l039","ordinal":96212,"en":"Countless treasure, myriad possessions,"},{"id":"semetey-1-2013:p0253:b003:l001","ordinal":96213,"en":"She had indeed scattered as she came."},{"id":"semetey-1-2013:p0253:b003:l002","ordinal":96214,"en":"Unable to find any way out,"},{"id":"semetey-1-2013:p0253:b003:l003","ordinal":96215,"en":"Your mother, that raging slavewoman,"},{"id":"semetey-1-2013:p0253:b003:l004","ordinal":96216,"en":"To the city of Temir Khan"},{"id":"semetey-1-2013:p0253:b003:l005","ordinal":96217,"en":"Had indeed come in flight."},{"id":"semetey-1-2013:p0253:b003:l006","ordinal":96218,"en":"The line God had drawn,"},{"id":"semetey-1-2013:p0253:b003:l007","ordinal":96219,"en":"Your sister-in-law had seen."},{"id":"semetey-1-2013:p0253:b003:l008","ordinal":96220,"en":"Her only child left by her companion,"},{"id":"semetey-1-2013:p0253:b003:l009","ordinal":96221,"en":"She had given to another."},{"id":"semetey-1-2013:p0253:b003:l010","ordinal":96222,"en":"Then young Semetey"},{"id":"semetey-1-2013:p0253:b003:l011","ordinal":96223,"en":"Had not yet worn a fine white-cloth shirt."},{"id":"semetey-1-2013:p0253:b003:l012","ordinal":96224,"en":"From his lord, Sultan Manas,"},{"id":"semetey-1-2013:p0253:b003:l013","ordinal":96225,"en":"Semetey did not know he had been left behind."},{"id":"semetey-1-2013:p0253:b003:l014","ordinal":96226,"en":"Semetey, born of Manas,"},{"id":"semetey-1-2013:p0253:b003:l015","ordinal":96227,"en":"Did not yet know he was a prince."},{"id":"semetey-1-2013:p0253:b003:l016","ordinal":96228,"en":"That poor Kanykei—"},{"id":"semetey-1-2013:p0253:b003:l017","ordinal":96229,"en":"He did not yet know she was his mother."},{"id":"semetey-1-2013:p0253:b003:l018","ordinal":96230,"en":"The boy's thoughts were elsewhere."},{"id":"semetey-1-2013:p0253:b003:l019","ordinal":96231,"en":"(Temir Khan's dear camel calf,"},{"id":"semetey-1-2013:p0253:b003:l020","ordinal":96232,"en":"Ismayil's son."},{"id":"semetey-1-2013:p0253:b003:l021","ordinal":96233,"en":"At that time, Semetey"},{"id":"semetey-1-2013:p0253:b003:l022","ordinal":96234,"en":"Had his thoughts elsewhere.)"},{"id":"semetey-1-2013:p0253:b003:l023","ordinal":96235,"en":"From that ridge shaped like a saddle's waist,"},{"id":"semetey-1-2013:p0253:b003:l024","ordinal":96236,"en":"Unable to turn his horse's head,"},{"id":"semetey-1-2013:p0253:b003:l025","ordinal":96237,"en":"From bloodthirsty, fierce Manas,"},{"id":"semetey-1-2013:p0253:b003:l026","ordinal":96238,"en":"A warrior born of a leopard,"},{"id":"semetey-1-2013:p0253:b003:l027","ordinal":96239,"en":"Offspring of his very lineage,"},{"id":"semetey-1-2013:p0253:b003:l028","ordinal":96240,"en":"A lion protected by Shay,"},{"id":"semetey-1-2013:p0253:b003:l029","ordinal":96241,"en":"Roared in anger."},{"id":"semetey-1-2013:p0253:b003:l030","ordinal":96242,"en":"Unable to restrain his strength,"},{"id":"semetey-1-2013:p0253:b003:l031","ordinal":96243,"en":"To some sixty strongmen"},{"id":"semetey-1-2013:p0253:b003:l032","ordinal":96244,"en":"He called, \"Come here!\""},{"id":"semetey-1-2013:p0253:b003:l033","ordinal":96245,"en":"His sixty or so strongmen"},{"id":"semetey-1-2013:p0253:b003:l034","ordinal":96246,"en":"Thundered as though enemies had attacked."},{"id":"semetey-1-2013:p0253:b003:l035","ordinal":96247,"en":"All their weapons"},{"id":"semetey-1-2013:p0253:b003:l036","ordinal":96248,"en":"Looked like takers of life."},{"id":"semetey-1-2013:p0253:b003:l037","ordinal":96249,"en":"Those who watched,"},{"id":"semetey-1-2013:p0253:b003:l038","ordinal":96250,"en":"Their hearts were deeply troubled."},{"id":"semetey-1-2013:p0253:b003:l039","ordinal":96251,"en":"Seven of the guards were there,"},{"id":"semetey-1-2013:p0253:b004:l001","ordinal":96252,"en":"Raging as though rabid."},{"id":"semetey-1-2013:p0253:b004:l002","ordinal":96253,"en":"Commanders of ten came bobbing,"},{"id":"semetey-1-2013:p0253:b004:l003","ordinal":96254,"en":"Their spears jutting up,"},{"id":"semetey-1-2013:p0253:b004:l004","ordinal":96255,"en":"The spearheads clashing,"},{"id":"semetey-1-2013:p0253:b004:l005","ordinal":96256,"en":"The men's heads knocking together."}]
