{"id": "sayakbay-ms-current146:pdf225:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 225, "folio": 608, "line_in_page": 18, "raw": "Эки көздөн куулуп,", "text": "Эки көздөн куулуп,", "en": "Tears streamed from both eyes,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf225:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 225, "folio": 608, "line_in_page": 19, "raw": "Кан аралаш кандуу жаш,", "text": "Кан аралаш кандуу жаш,", "en": "Bloody tears mingled with blood.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf225:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 225, "folio": 608, "line_in_page": 20, "raw": "Тели белен жылкыдай,", "text": "Тели белен жылкыдай,", "en": "Like horses ready at the tether,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
