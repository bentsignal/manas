[{"id":"semetey-1-2013:p1206:b004:l026","ordinal":168193,"en":"Cutting through the final cord."},{"id":"semetey-1-2013:p1206:b004:l027","ordinal":168194,"en":"Your hero brought down the jamby."},{"id":"semetey-1-2013:p1206:b004:l028","ordinal":168195,"en":"The forty companions of Khan Manas"},{"id":"semetey-1-2013:p1206:b004:l029","ordinal":168196,"en":"Had staked Kokotoy's treasury"},{"id":"semetey-1-2013:p1206:b004:l030","ordinal":168197,"en":"As the prize;"},{"id":"semetey-1-2013:p1206:b004:l031","ordinal":168198,"en":"Your precious Manas won"},{"id":"semetey-1-2013:p1206:b004:l032","ordinal":168199,"en":"The contest in motion."},{"id":"semetey-1-2013:p1206:b004:l033","ordinal":168200,"en":"When Manas won the jamby,"},{"id":"semetey-1-2013:p1206:b004:l034","ordinal":168201,"en":"When all forty had reached"},{"id":"semetey-1-2013:p1206:b004:l035","ordinal":168202,"en":"The worldly prize,"},{"id":"semetey-1-2013:p1206:b004:l036","ordinal":168203,"en":"They shot down the jamby;"},{"id":"semetey-1-2013:p1206:b004:l037","ordinal":168204,"en":"Thus the forty companions of Khan Manas"},{"id":"semetey-1-2013:p1206:b004:l038","ordinal":168205,"en":"Came into their inheritance."},{"id":"semetey-1-2013:p1207:b004:l001","ordinal":168206,"en":"Let us leave this matter here."},{"id":"semetey-1-2013:p1207:b004:l002","ordinal":168207,"en":"There are racehorses sent to run,"},{"id":"semetey-1-2013:p1207:b004:l003","ordinal":168208,"en":"And infidel and Muslim"},{"id":"semetey-1-2013:p1207:b004:l004","ordinal":168209,"en":"May raise a commotion."},{"id":"semetey-1-2013:p1207:b004:l005","ordinal":168210,"en":"Each man's head bears a burden;"},{"id":"semetey-1-2013:p1207:b004:l006","ordinal":168211,"en":"There is the duty of cheering a horse."},{"id":"semetey-1-2013:p1207:b004:l007","ordinal":168212,"en":"Infidel and Muslim"},{"id":"semetey-1-2013:p1207:b004:l008","ordinal":168213,"en":"Have chosen racehorses they entered."},{"id":"semetey-1-2013:p1207:b004:l009","ordinal":168214,"en":"There are tulpars born among horses,"},{"id":"semetey-1-2013:p1207:b004:l010","ordinal":168215,"en":"And a plain no winged creature can cross."},{"id":"semetey-1-2013:p1207:b004:l011","ordinal":168216,"en":"If a quarrel starts from a small thing,"},{"id":"semetey-1-2013:p1207:b004:l012","ordinal":168217,"en":"There is a danger that infidel and Muslim"},{"id":"semetey-1-2013:p1207:b004:l013","ordinal":168218,"en":"Will slaughter one another."},{"id":"semetey-1-2013:p1207:b004:l014","ordinal":168219,"en":"The swift Maaniker is among"},{"id":"semetey-1-2013:p1207:b004:l015","ordinal":168220,"en":"The horses driven away."},{"id":"semetey-1-2013:p1207:b004:l016","ordinal":168221,"en":"If an opportunity comes, the Chinese"},{"id":"semetey-1-2013:p1207:b004:l017","ordinal":168222,"en":"Have deeds they may perform."},{"id":"semetey-1-2013:p1207:b004:l018","ordinal":168223,"en":"There is the source of much strife,"},{"id":"semetey-1-2013:p1207:b004:l019","ordinal":168224,"en":"And there is Kokotoy's feast."},{"id":"semetey-1-2013:p1207:b004:l020","ordinal":168225,"en":"Gray-maned Bakay began to speak,"},{"id":"semetey-1-2013:p1207:b004:l021","ordinal":168226,"en":"Letting his words run obliquely."},{"id":"semetey-1-2013:p1207:b004:l022","ordinal":168227,"en":"This is what Bakay said:"},{"id":"semetey-1-2013:p1207:b004:l023","ordinal":168228,"en":"\"O people of the Muslim faith,"},{"id":"semetey-1-2013:p1207:b004:l024","ordinal":168229,"en":"Your khan stands here;"},{"id":"semetey-1-2013:p1207:b004:l025","ordinal":168230,"en":"All you clashing kinsmen"},{"id":"semetey-1-2013:p1207:b004:l026","ordinal":168231,"en":"Stand here."},{"id":"semetey-1-2013:p1207:b004:l027","ordinal":168232,"en":"The wisest of the kinsmen,"},{"id":"semetey-1-2013:p1207:b004:l028","ordinal":168233,"en":"Your deftest man stands here."},{"id":"semetey-1-2013:p1207:b004:l029","ordinal":168234,"en":"Skilled with the spear, a blood-drinker,"},{"id":"semetey-1-2013:p1207:b004:l030","ordinal":168235,"en":"Your strongest man stands here."},{"id":"semetey-1-2013:p1207:b004:l031","ordinal":168236,"en":"Great host of common Muslims,"},{"id":"semetey-1-2013:p1207:b004:l032","ordinal":168237,"en":"Let one in a thousand come;"},{"id":"semetey-1-2013:p1207:b004:l033","ordinal":168238,"en":"Let your able reasoner come."},{"id":"semetey-1-2013:p1207:b004:l034","ordinal":168239,"en":"Your courage remains, O Muslims;"},{"id":"semetey-1-2013:p1207:b004:l035","ordinal":168240,"en":"Let your strongest manlike fighter come,"},{"id":"semetey-1-2013:p1207:b004:l036","ordinal":168241,"en":"Let your hero of complete cunning come,"},{"id":"semetey-1-2013:p1207:b005:l001","ordinal":168242,"en":"And witness this device of mine."},{"id":"semetey-1-2013:p1207:b005:l002","ordinal":168243,"en":"Kongurbay was humiliated,"},{"id":"semetey-1-2013:p1207:b005:l003","ordinal":168244,"en":"Khan Joloy was disgraced,"},{"id":"semetey-1-2013:p1207:b005:l004","ordinal":168245,"en":"And Tukubay was utterly killed."},{"id":"semetey-1-2013:p1207:b005:l005","ordinal":168246,"en":"There is the sorrow of the dark hour;"},{"id":"semetey-1-2013:p1207:b005:l006","ordinal":168247,"en":"Hear, O Muslims,"},{"id":"semetey-1-2013:p1207:b005:l007","ordinal":168248,"en":"Whose turn it is to grapple."},{"id":"semetey-1-2013:p1207:b005:l008","ordinal":168249,"en":"You have dealt terrible wrath"},{"id":"semetey-1-2013:p1207:b005:l009","ordinal":168250,"en":"To the black-worm infidel,"},{"id":"semetey-1-2013:p1207:b005:l010","ordinal":168251,"en":"To hero Khan Kongurbay."},{"id":"semetey-1-2013:p1207:b005:l011","ordinal":168252,"en":"Joloy has become vengeful;"},{"id":"semetey-1-2013:p1207:b005:l012","ordinal":168253,"en":"Tukubay died without a word."},{"id":"semetey-1-2013:p1207:b005:l013","ordinal":168254,"en":"No man has defeated by battle"},{"id":"semetey-1-2013:p1207:b005:l014","ordinal":168255,"en":"The seething Chinese host;"},{"id":"semetey-1-2013:p1207:b005:l015","ordinal":168256,"en":"These surging Chinese"},{"id":"semetey-1-2013:p1207:b005:l016","ordinal":168257,"en":"Are a flood no barrier can hold."},{"id":"semetey-1-2013:p1207:b005:l017","ordinal":168258,"en":"They are the proud Chinese people;"},{"id":"semetey-1-2013:p1207:b005:l018","ordinal":168259,"en":"They have won many prizes,"},{"id":"semetey-1-2013:p1207:b005:l019","ordinal":168260,"en":"And you have disgraced them."},{"id":"semetey-1-2013:p1207:b005:l020","ordinal":168261,"en":"Many regrets remain after a man;"},{"id":"semetey-1-2013:p1207:b005:l021","ordinal":168262,"en":"Such is this treacherous world."},{"id":"semetey-1-2013:p1207:b005:l022","ordinal":168263,"en":"We received it from learned tradition"},{"id":"semetey-1-2013:p1207:b005:l023","ordinal":168264,"en":"And asked those who know."},{"id":"semetey-1-2013:p1207:b005:l024","ordinal":168265,"en":"No man could match them;"},{"id":"semetey-1-2013:p1207:b005:l025","ordinal":168266,"en":"Whoever did did not survive."},{"id":"semetey-1-2013:p1207:b005:l026","ordinal":168267,"en":"Their lowlands were grassy,"},{"id":"semetey-1-2013:p1207:b005:l027","ordinal":168268,"en":"And their people were numerous."},{"id":"semetey-1-2013:p1207:b005:l028","ordinal":168269,"en":"Their spirit was great, their name renowned;"},{"id":"semetey-1-2013:p1207:b005:l029","ordinal":168270,"en":"Whoever fought them did not survive."},{"id":"semetey-1-2013:p1207:b005:l030","ordinal":168271,"en":"The Black Chinese creatures"},{"id":"semetey-1-2013:p1207:b005:l031","ordinal":168272,"en":"Have come to the last man"},{"id":"semetey-1-2013:p1207:b005:l032","ordinal":168273,"en":"From the people of Chynchy-Mynchy,"},{"id":"semetey-1-2013:p1207:b005:l033","ordinal":168274,"en":"From the land of the true Khagan."},{"id":"semetey-1-2013:p1207:b005:l034","ordinal":168275,"en":"The Chinese host is a flood;"},{"id":"semetey-1-2013:p1207:b005:l035","ordinal":168276,"en":"At one crooked provocation,"},{"id":"semetey-1-2013:p1207:b005:l036","ordinal":168277,"en":"It is ready to engulf us."},{"id":"semetey-1-2013:p1208:b003:l001","ordinal":168278,"en":"They have deceptive words;"},{"id":"semetey-1-2013:p1208:b003:l002","ordinal":168279,"en":"If we shriek and quarrel,"},{"id":"semetey-1-2013:p1208:b003:l003","ordinal":168280,"en":"They themselves can strike us down."},{"id":"semetey-1-2013:p1208:b003:l004","ordinal":168281,"en":"They have a people called Machin,"},{"id":"semetey-1-2013:p1208:b003:l005","ordinal":168282,"en":"Their crown hair bristling,"},{"id":"semetey-1-2013:p1208:b003:l006","ordinal":168283,"en":"Ready together to attack."},{"id":"semetey-1-2013:p1208:b003:l007","ordinal":168284,"en":"This gathering that has come"},{"id":"semetey-1-2013:p1208:b003:l008","ordinal":168285,"en":"Is Khan Kokotoy's feast;"},{"id":"semetey-1-2013:p1208:b003:l009","ordinal":168286,"en":"If we take heed, people,"},{"id":"semetey-1-2013:p1208:b003:l010","ordinal":168287,"en":"It is the start of great strife."},{"id":"semetey-1-2013:p1208:b003:l011","ordinal":168288,"en":"Your Bakay who speaks"},{"id":"semetey-1-2013:p1208:b003:l012","ordinal":168289,"en":"Has words without end."},{"id":"semetey-1-2013:p1208:b003:l013","ordinal":168290,"en":"The smoldering Chinese"},{"id":"semetey-1-2013:p1208:b003:l014","ordinal":168291,"en":"Are filled with vengeance."},{"id":"semetey-1-2013:p1208:b003:l015","ordinal":168292,"en":"When your stallion comes in,"},{"id":"semetey-1-2013:p1208:b003:l016","ordinal":168293,"en":"May they not seize its prize by force."},{"id":"semetey-1-2013:p1208:b003:l017","ordinal":168294,"en":"If I quarrel over the prize,"},{"id":"semetey-1-2013:p1208:b003:l018","ordinal":168295,"en":"May they not make sport of us."},{"id":"semetey-1-2013:p1208:b003:l019","ordinal":168296,"en":"The snarling infidels,"},{"id":"semetey-1-2013:p1208:b003:l020","ordinal":168297,"en":"The warriors of Khan Kongurbay,"},{"id":"semetey-1-2013:p1208:b003:l021","ordinal":168298,"en":"If the Muslims' stallion"},{"id":"semetey-1-2013:p1208:b003:l022","ordinal":168299,"en":"Should suddenly come in,"},{"id":"semetey-1-2013:p1208:b003:l023","ordinal":168300,"en":"May they not cause slaughter"},{"id":"semetey-1-2013:p1208:b003:l024","ordinal":168301,"en":"In a sudden frenzy."},{"id":"semetey-1-2013:p1208:b003:l025","ordinal":168302,"en":"Let us choose an envoy"},{"id":"semetey-1-2013:p1208:b003:l026","ordinal":168303,"en":"Who knows seventy foreign tongues:"},{"id":"semetey-1-2013:p1208:b003:l027","ordinal":168304,"en":"Agybay of Argyn Khan;"},{"id":"semetey-1-2013:p1208:b003:l028","ordinal":168305,"en":"Hero Urbu, son of Taz,"},{"id":"semetey-1-2013:p1208:b003:l029","ordinal":168306,"en":"Who knows seventy foreign tongues,"},{"id":"semetey-1-2013:p1208:b003:l030","ordinal":168307,"en":"Sharpens his eloquent tongue,"},{"id":"semetey-1-2013:p1208:b003:l031","ordinal":168308,"en":"And, if sent without warning,"},{"id":"semetey-1-2013:p1208:b003:l032","ordinal":168309,"en":"Speaks the Chinese language."},{"id":"semetey-1-2013:p1208:b003:l033","ordinal":168310,"en":"Almambet of Aziz Khan"},{"id":"semetey-1-2013:p1208:b003:l034","ordinal":168311,"en":"Could not be subdued by force."},{"id":"semetey-1-2013:p1208:b003:l035","ordinal":168312,"en":"His ancestor was Chylaba;"},{"id":"semetey-1-2013:p1208:b003:l036","ordinal":168313,"en":"He disputed Chylaba's khanship"},{"id":"semetey-1-2013:p1208:b003:l037","ordinal":168314,"en":"In true Beijing."},{"id":"semetey-1-2013:p1208:b003:l038","ordinal":168315,"en":"Calling him a true infidel,"},{"id":"semetey-1-2013:p1208:b003:l039","ordinal":168316,"en":"The long-haired Chinese"},{"id":"semetey-1-2013:p1208:b004:l001","ordinal":168317,"en":"Lost track of his origin."},{"id":"semetey-1-2013:p1208:b004:l002","ordinal":168318,"en":"Mighty city and powerful people—"},{"id":"semetey-1-2013:p1208:b004:l003","ordinal":168319,"en":"The noble leopard Almam,"},{"id":"semetey-1-2013:p1208:b004:l004","ordinal":168320,"en":"Because of their jealousy,"},{"id":"semetey-1-2013:p1208:b004:l005","ordinal":168321,"en":"Fought Kun Jang-jung."},{"id":"semetey-1-2013:p1208:b004:l006","ordinal":168322,"en":"He found land at the turning place;"},{"id":"semetey-1-2013:p1208:b004:l007","ordinal":168323,"en":"Unable to fit among these Chinese,"},{"id":"semetey-1-2013:p1208:b004:l008","ordinal":168324,"en":"He found a people among the Muslims."},{"id":"semetey-1-2013:p1208:b004:l009","ordinal":168325,"en":"If you explain the words"},{"id":"semetey-1-2013:p1208:b004:l010","ordinal":168326,"en":"Spoken by lion Lord Bakay,"},{"id":"semetey-1-2013:p1208:b004:l011","ordinal":168327,"en":"Put Chylaba's coat"},{"id":"semetey-1-2013:p1208:b004:l012","ordinal":168328,"en":"Upon your elder Ala;"},{"id":"semetey-1-2013:p1208:b004:l013","ordinal":168329,"en":"Send him unnoticed,"},{"id":"semetey-1-2013:p1208:b004:l014","ordinal":168330,"en":"As a Chinese of Chin-Machin,"},{"id":"semetey-1-2013:p1208:b004:l015","ordinal":168331,"en":"As a genuine Chinese."},{"id":"semetey-1-2013:p1208:b004:l016","ordinal":168332,"en":"If he prays to the true God,"},{"id":"semetey-1-2013:p1208:b004:l017","ordinal":168333,"en":"When the tulpar comes in,"},{"id":"semetey-1-2013:p1208:b004:l018","ordinal":168334,"en":"Your foreign-born leopard Almam"},{"id":"semetey-1-2013:p1208:b004:l019","ordinal":168335,"en":"Will raise the Chinese battle cry,"},{"id":"semetey-1-2013:p1208:b004:l020","ordinal":168336,"en":"Cheering, 'Chin-Machin!'"},{"id":"semetey-1-2013:p1208:b004:l021","ordinal":168337,"en":"Then truly God will grant it,"},{"id":"semetey-1-2013:p1208:b004:l022","ordinal":168338,"en":"And the Muslims will see"},{"id":"semetey-1-2013:p1208:b004:l023","ordinal":168339,"en":"The arriving tulpar safe."},{"id":"semetey-1-2013:p1208:b004:l024","ordinal":168340,"en":"If we do not use this device,"},{"id":"semetey-1-2013:p1208:b004:l025","ordinal":168341,"en":"Your tulpar that comes in"},{"id":"semetey-1-2013:p1208:b004:l026","ordinal":168342,"en":"Will die at Kongurbay's hand."},{"id":"semetey-1-2013:p1208:b004:l027","ordinal":168343,"en":"There where the horses were driven"},{"id":"semetey-1-2013:p1208:b004:l028","ordinal":168344,"en":"Is a corner of Urchuktu."},{"id":"semetey-1-2013:p1208:b004:l029","ordinal":168345,"en":"Very like Akkula,"},{"id":"semetey-1-2013:p1208:b004:l030","ordinal":168346,"en":"Hero Joloy's Surkula"},{"id":"semetey-1-2013:p1208:b004:l031","ordinal":168347,"en":"Bears this dark misfortune."},{"id":"semetey-1-2013:p1208:b004:l032","ordinal":168348,"en":"Orongu's rough-gaited bay mare,"},{"id":"semetey-1-2013:p1208:b004:l033","ordinal":168349,"en":"And young Keney's bay yearling,"},{"id":"semetey-1-2013:p1208:b004:l034","ordinal":168350,"en":"Was a yearling gone in sorrow."},{"id":"semetey-1-2013:p1208:b004:l035","ordinal":168351,"en":"It had great regret."},{"id":"semetey-1-2013:p1208:b004:l036","ordinal":168352,"en":"Do not demand it outright,"},{"id":"semetey-1-2013:p1208:b004:l037","ordinal":168353,"en":"Saying the yearling came first."},{"id":"semetey-1-2013:p1208:b004:l038","ordinal":168354,"en":"Do not tear it to pieces"},{"id":"semetey-1-2013:p1208:b004:l039","ordinal":168355,"en":"Before it reaches maturity."},{"id":"semetey-1-2013:p1209:b003:l001","ordinal":168356,"en":"Forty companions of Khan Manas,"},{"id":"semetey-1-2013:p1209:b003:l002","ordinal":168357,"en":"Choose tulpars and mount."},{"id":"semetey-1-2013:p1209:b003:l003","ordinal":168358,"en":"Against the Black Kalmyks and Manchus,"},{"id":"semetey-1-2013:p1209:b003:l004","ordinal":168359,"en":"Enter with true courage."},{"id":"semetey-1-2013:p1209:b003:l005","ordinal":168360,"en":"When they draw near the prize,"},{"id":"semetey-1-2013:p1209:b003:l006","ordinal":168361,"en":"Raise the battle cry in earnest."},{"id":"semetey-1-2013:p1209:b003:l007","ordinal":168362,"en":"There is no overcoming tulpar Akkula;"},{"id":"semetey-1-2013:p1209:b003:l008","ordinal":168363,"en":"When the stallion comes in,"},{"id":"semetey-1-2013:p1209:b003:l009","ordinal":168364,"en":"Take the grand prize!\""},{"id":"semetey-1-2013:p1209:b003:l010","ordinal":168365,"en":"Hearing these words from Bakay,"},{"id":"semetey-1-2013:p1209:b003:l011","ordinal":168366,"en":"Skirting along Karkyra"},{"id":"semetey-1-2013:p1209:b003:l012","ordinal":168367,"en":"And guarding Chong-Kegen,"},{"id":"semetey-1-2013:p1209:b003:l013","ordinal":168368,"en":"The Muslim host rushed forward,"},{"id":"semetey-1-2013:p1209:b003:l014","ordinal":168369,"en":"Crying down the valley."},{"id":"semetey-1-2013:p1209:b003:l015","ordinal":168370,"en":"Dust billowed to the sky."},{"id":"semetey-1-2013:p1209:b003:l016","ordinal":168371,"en":"To inflict severe torment"},{"id":"semetey-1-2013:p1209:b003:l017","ordinal":168372,"en":"And demand the horse,"},{"id":"semetey-1-2013:p1209:b003:l018","ordinal":168373,"en":"The Kalmyk host rushed forward."},{"id":"semetey-1-2013:p1209:b003:l019","ordinal":168374,"en":"The army spread across the steppe,"},{"id":"semetey-1-2013:p1209:b003:l020","ordinal":168375,"en":"Engulfing it not a little but greatly,"},{"id":"semetey-1-2013:p1209:b003:l021","ordinal":168376,"en":"Dividing into many kinds."},{"id":"semetey-1-2013:p1209:b003:l022","ordinal":168377,"en":"The ground cracked and thundered;"},{"id":"semetey-1-2013:p1209:b003:l023","ordinal":168378,"en":"The brass horn shrieked."},{"id":"semetey-1-2013:p1209:b003:l024","ordinal":168379,"en":"The drum was beaten loudly;"},{"id":"semetey-1-2013:p1209:b003:l025","ordinal":168380,"en":"The surging multitude of lords"},{"id":"semetey-1-2013:p1209:b003:l026","ordinal":168381,"en":"Advanced in a closed mass."},{"id":"semetey-1-2013:p1209:b003:l027","ordinal":168382,"en":"Dust flew and haze burned;"},{"id":"semetey-1-2013:p1209:b003:l028","ordinal":168383,"en":"Armored men stood apart,"},{"id":"semetey-1-2013:p1209:b003:l029","ordinal":168384,"en":"And their heroes appeared."},{"id":"semetey-1-2013:p1209:b003:l030","ordinal":168385,"en":"The multitude covered the Ili like black worms;"},{"id":"semetey-1-2013:p1209:b003:l031","ordinal":168386,"en":"When one looked,"},{"id":"semetey-1-2013:p1209:b003:l032","ordinal":168387,"en":"Flying earth and dust hid it."},{"id":"semetey-1-2013:p1209:b003:l033","ordinal":168388,"en":"Dust struck against dust"},{"id":"semetey-1-2013:p1209:b003:l034","ordinal":168389,"en":"And curled into the sky."},{"id":"semetey-1-2013:p1209:b003:l035","ordinal":168390,"en":"As though making an attack,"},{"id":"semetey-1-2013:p1209:b003:l036","ordinal":168391,"en":"The people poured toward the horses"},{"id":"semetey-1-2013:p1209:b003:l037","ordinal":168392,"en":"Like black worms."},{"id":"semetey-1-2013:p1209:b003:l038","ordinal":168393,"en":"Heads of beasts collided,"},{"id":"semetey-1-2013:p1209:b003:l039","ordinal":168394,"en":"And spearheads struck one another."},{"id":"semetey-1-2013:p1209:b005:l001","ordinal":168395,"en":"When rough hill country came,"},{"id":"semetey-1-2013:p1209:b005:l002","ordinal":168396,"en":"They crossed it with force."},{"id":"semetey-1-2013:p1209:b005:l003","ordinal":168397,"en":"Then your lion Sultan Alma"},{"id":"semetey-1-2013:p1209:b005:l004","ordinal":168398,"en":"Covered the piebald horse"},{"id":"semetey-1-2013:p1209:b005:l005","ordinal":168399,"en":"With his abay cloak."},{"id":"semetey-1-2013:p1209:b005:l006","ordinal":168400,"en":"Your elder Ala flew like an arrow,"},{"id":"semetey-1-2013:p1209:b005:l007","ordinal":168401,"en":"Riding steadily along the road,"},{"id":"semetey-1-2013:p1209:b005:l008","ordinal":168402,"en":"Making his headdress tower."},{"id":"semetey-1-2013:p1209:b005:l009","ordinal":168403,"en":"Your dear dark hero Almam—"},{"id":"semetey-1-2013:p1209:b005:l010","ordinal":168404,"en":"His ancestor was Chylaba."},{"id":"semetey-1-2013:p1209:b005:l011","ordinal":168405,"en":"Wearing Chylaba's coat,"},{"id":"semetey-1-2013:p1209:b005:l012","ordinal":168406,"en":"The poor man labored on,"},{"id":"semetey-1-2013:p1209:b005:l013","ordinal":168407,"en":"Putting on the Chinese crown."},{"id":"semetey-1-2013:p1209:b005:l014","ordinal":168408,"en":"Upon that crown"},{"id":"semetey-1-2013:p1209:b005:l015","ordinal":168409,"en":"Were coral and pearl ornaments."},{"id":"semetey-1-2013:p1209:b005:l016","ordinal":168410,"en":"The great Chinese of Kakanchyn"},{"id":"semetey-1-2013:p1209:b005:l017","ordinal":168411,"en":"Did not recognize your elder Ala,"},{"id":"semetey-1-2013:p1209:b005:l018","ordinal":168412,"en":"And their poor heads were confounded."},{"id":"semetey-1-2013:p1209:b005:l019","ordinal":168413,"en":"The spectacles of gray-maned Lord Almam"},{"id":"semetey-1-2013:p1209:b005:l020","ordinal":168414,"en":"Gleamed;"},{"id":"semetey-1-2013:p1209:b005:l021","ordinal":168415,"en":"Flask-sized coral stones"},{"id":"semetey-1-2013:p1209:b005:l022","ordinal":168416,"en":"Shone upon his crown."},{"id":"semetey-1-2013:p1209:b005:l023","ordinal":168417,"en":"The Chinese who saw him cried, \"My khan,\""},{"id":"semetey-1-2013:p1209:b005:l024","ordinal":168418,"en":"And stared in amazement."},{"id":"semetey-1-2013:p1209:b005:l025","ordinal":168419,"en":"Your elder Ala rode on,"},{"id":"semetey-1-2013:p1209:b005:l026","ordinal":168420,"en":"Preparing his feigned gait."},{"id":"semetey-1-2013:p1209:b005:l027","ordinal":168421,"en":"Foal of a bay mare,"},{"id":"semetey-1-2013:p1209:b005:l028","ordinal":168422,"en":"Tulpar of the black herd—"},{"id":"semetey-1-2013:p1209:b005:l029","ordinal":168423,"en":"If the leopard's Akkula"},{"id":"semetey-1-2013:p1209:b005:l030","ordinal":168424,"en":"Meets me head-on,"},{"id":"semetey-1-2013:p1209:b005:l031","ordinal":168425,"en":"I will charge and seize its reins,"},{"id":"semetey-1-2013:p1209:b005:l032","ordinal":168426,"en":"And bring it to my horse's side."},{"id":"semetey-1-2013:p1209:b005:l033","ordinal":168427,"en":"I will raise the battle cry"},{"id":"semetey-1-2013:p1209:b005:l034","ordinal":168428,"en":"Of the Black Chinese and Manchus,"},{"id":"semetey-1-2013:p1209:b005:l035","ordinal":168429,"en":"Lead it between"},{"id":"semetey-1-2013:p1209:b005:l036","ordinal":168430,"en":"Infidel and Muslim,"},{"id":"semetey-1-2013:p1209:b005:l037","ordinal":168431,"en":"And thus win honor."},{"id":"semetey-1-2013:p1209:b005:l038","ordinal":168432,"en":"The saddle-shaped ridge"},{"id":"semetey-1-2013:p1209:b005:l039","ordinal":168433,"en":"Your dear gray-maned Almam"},{"id":"semetey-1-2013:p1210:b003:l001","ordinal":168434,"en":"Now reached and leaned against."},{"id":"semetey-1-2013:p1210:b003:l002","ordinal":168435,"en":"He turned the piebald horse's head"},{"id":"semetey-1-2013:p1210:b003:l003","ordinal":168436,"en":"And the renowned poor hero"},{"id":"semetey-1-2013:p1210:b003:l004","ordinal":168437,"en":"Raised his spyglass."},{"id":"semetey-1-2013:p1210:b003:l005","ordinal":168438,"en":"A blue haze appeared against the sky,"},{"id":"semetey-1-2013:p1210:b003:l006","ordinal":168439,"en":"Clouded and angular,"},{"id":"semetey-1-2013:p1210:b003:l007","ordinal":168440,"en":"Pointed like a cape."},{"id":"semetey-1-2013:p1210:b003:l008","ordinal":168441,"en":"Across the churned sand,"},{"id":"semetey-1-2013:p1210:b003:l009","ordinal":168442,"en":"Dust rose in bursts."},{"id":"semetey-1-2013:p1210:b003:l010","ordinal":168443,"en":"When he looked at the surging dust,"},{"id":"semetey-1-2013:p1210:b003:l011","ordinal":168444,"en":"It was Akkula's dust."},{"id":"semetey-1-2013:p1210:b003:l012","ordinal":168445,"en":"He had lowered his head to the ground;"},{"id":"semetey-1-2013:p1210:b003:l013","ordinal":168446,"en":"Your padishah's Akkula"},{"id":"semetey-1-2013:p1210:b003:l014","ordinal":168447,"en":"Had taken a remarkable stride."},{"id":"semetey-1-2013:p1210:b003:l015","ordinal":168448,"en":"He had lowered his neck to the ground;"}]
