[{"id":"manas-2010:p1592:b001:l029","ordinal":68609,"en":"From atop Kögala,"},{"id":"manas-2010:p1592:b001:l030","ordinal":68610,"en":"He knocked him down as he passed."},{"id":"manas-2010:p1592:b001:l031","ordinal":68611,"en":"Before the grim-faced one could turn and reach him,"},{"id":"manas-2010:p1592:b001:l032","ordinal":68612,"en":"Before he could cut off his head,"},{"id":"manas-2010:p1592:b001:l033","ordinal":68613,"en":"Cow-rumped Sarala,"},{"id":"manas-2010:p1592:b001:l034","ordinal":68614,"en":"Almambet made wheel and whirl;"},{"id":"manas-2010:p1592:b001:l035","ordinal":68615,"en":"Clinging close, he stood stiff,"},{"id":"manas-2010:p1592:b001:l036","ordinal":68616,"en":"His two eyes glaring;"},{"id":"manas-2010:p1592:b001:l037","ordinal":68617,"en":"Those who saw him were unsettled;"},{"id":"manas-2010:p1592:b001:l038","ordinal":68618,"en":"Flames poured from his mouth."},{"id":"manas-2010:p1592:b001:l039","ordinal":68619,"en":"In the blink of an eye,"},{"id":"manas-2010:p1592:b001:l040","ordinal":68620,"en":"He reached Kongurbay."},{"id":"manas-2010:p1592:b001:l041","ordinal":68621,"en":"The grim-faced one from the flank,"},{"id":"manas-2010:p1592:b001:l042","ordinal":68622,"en":"“Upon the ribs,” he said,"},{"id":"manas-2010:p1593:b001:l001","ordinal":68623,"en":"He struck squarely as he passed."},{"id":"manas-2010:p1593:b001:l002","ordinal":68624,"en":"That grim-faced Kongurbay,"},{"id":"manas-2010:p1593:b001:l003","ordinal":68625,"en":"The warrior left his saddle;"},{"id":"manas-2010:p1593:b001:l004","ordinal":68626,"en":"As he cried, “Oh!” from his mouth"},{"id":"manas-2010:p1593:b001:l005","ordinal":68627,"en":"Blood came in separate gushes."},{"id":"manas-2010:p1593:b001:l006","ordinal":68628,"en":"Courage fled his body;"},{"id":"manas-2010:p1593:b001:l007","ordinal":68629,"en":"Strength left the grim-faced wretch."},{"id":"manas-2010:p1593:b001:l008","ordinal":68630,"en":"As the dear champions turned,"},{"id":"manas-2010:p1593:b001:l009","ordinal":68631,"en":"As they were about to seize his coat's hem,"},{"id":"manas-2010:p1593:b001:l010","ordinal":68632,"en":"As they were about to lay him out lengthwise,"},{"id":"manas-2010:p1593:b001:l011","ordinal":68633,"en":"The black horse beneath him,"},{"id":"manas-2010:p1593:b001:l012","ordinal":68634,"en":"His black horse—has it, I say,"},{"id":"manas-2010:p1593:b001:l013","ordinal":68635,"en":"Wings upon its flanks?"},{"id":"manas-2010:p1593:b001:l014","ordinal":68636,"en":"When that grim-faced Kongurbay"},{"id":"manas-2010:p1593:b001:l015","ordinal":68637,"en":"Had a dark day fall upon his head,"},{"id":"manas-2010:p1593:b001:l016","ordinal":68638,"en":"Always Algara"},{"id":"manas-2010:p1593:b001:l017","ordinal":68639,"en":"Had the habit of rescuing him."},{"id":"manas-2010:p1593:b001:l018","ordinal":68640,"en":"The mountain-sized grim-faced one,"},{"id":"manas-2010:p1593:b001:l019","ordinal":68641,"en":"Speeding like a flying bird,"},{"id":"manas-2010:p1593:b001:l020","ordinal":68642,"en":"It rescued and carried away."},{"id":"manas-2010:p1593:b001:l021","ordinal":68643,"en":"When Kongurbay was wounded"},{"id":"manas-2010:p1593:b001:l022","ordinal":68644,"en":"And struggling for his life,"},{"id":"manas-2010:p1593:b001:l023","ordinal":68645,"en":"The Chinese, people of forty khans,"},{"id":"manas-2010:p1593:b001:l024","ordinal":68646,"en":"Had no support in whom to trust,"},{"id":"manas-2010:p1593:b001:l025","ordinal":68647,"en":"Had no lion, the grim-faced champion,"},{"id":"manas-2010:p1593:b001:l026","ordinal":68648,"en":"To give them courage,"},{"id":"manas-2010:p1593:b001:l027","ordinal":68649,"en":"Had no hero like the grim-faced one!"},{"id":"manas-2010:p1593:b001:l028","ordinal":68650,"en":"“Khan Manas!” the forty companions cried,"},{"id":"manas-2010:p1593:b001:l029","ordinal":68651,"en":"Entering among the Chinese,"},{"id":"manas-2010:p1593:b001:l030","ordinal":68652,"en":"And brought red slaughter."},{"id":"manas-2010:p1593:b001:l031","ordinal":68653,"en":"Chubak, Akbaltay's son,"},{"id":"manas-2010:p1593:b001:l032","ordinal":68654,"en":"Survived on that occasion;"},{"id":"manas-2010:p1593:b001:l033","ordinal":68655,"en":"Almambet had rescued him."},{"id":"manas-2010:p1593:b001:l034","ordinal":68656,"en":"Through the vast host that had surged in,"},{"id":"manas-2010:p1593:b001:l035","ordinal":68657,"en":"Chubak entered shouting,"},{"id":"manas-2010:p1593:b001:l036","ordinal":68658,"en":"Among the Chinese from one flank."},{"id":"manas-2010:p1593:b001:l037","ordinal":68659,"en":"Making their horses dart like arrows,"},{"id":"manas-2010:p1593:b001:l038","ordinal":68660,"en":"Almambet entered their midst;"},{"id":"manas-2010:p1593:b001:l039","ordinal":68661,"en":"Entering beside him, hero Syrgak"},{"id":"manas-2010:p1593:b001:l040","ordinal":68662,"en":"Slaughtered the Chinese, making them crawl."},{"id":"manas-2010:p1593:b001:l041","ordinal":68663,"en":"Into their center, Almambet"},{"id":"manas-2010:p1593:b001:l042","ordinal":68664,"en":"Bored his way."},{"id":"manas-2010:p1594:b001:l001","ordinal":68665,"en":"From the flank, hero Chubak"},{"id":"manas-2010:p1594:b001:l002","ordinal":68666,"en":"Pressed in and enclosed them;"},{"id":"manas-2010:p1594:b001:l003","ordinal":68667,"en":"From one side, hero Syrgak"},{"id":"manas-2010:p1594:b001:l004","ordinal":68668,"en":"Slaughtered and drove them away."},{"id":"manas-2010:p1594:b001:l005","ordinal":68669,"en":"Beijing in Kakan-Chin,"},{"id":"manas-2010:p1594:b001:l006","ordinal":68670,"en":"Before a moment had passed,"},{"id":"manas-2010:p1594:b001:l007","ordinal":68671,"en":"Making the Chinese bellow,"},{"id":"manas-2010:p1594:b001:l008","ordinal":68672,"en":"Like jackdaws struck by a falcon,"},{"id":"manas-2010:p1594:b001:l009","ordinal":68673,"en":"Khan Manas's forty companions,"},{"id":"manas-2010:p1594:b001:l010","ordinal":68674,"en":"Driving them back toward Beijing,"},{"id":"manas-2010:p1594:b001:l011","ordinal":68675,"en":"Drove them inside;"},{"id":"manas-2010:p1594:b001:l012","ordinal":68676,"en":"Along a journey of twelve days,"},{"id":"manas-2010:p1594:b001:l013","ordinal":68677,"en":"They pursued without stopping."},{"id":"manas-2010:p1594:b001:l014","ordinal":68678,"en":"Cotton-sashed, broad-booted,"},{"id":"manas-2010:p1594:b001:l015","ordinal":68679,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1594:b001:l016","ordinal":68680,"en":"Thought deeply upon a plan."},{"id":"manas-2010:p1594:b001:l017","ordinal":68681,"en":"Ay Jangjung and Kongurbay"},{"id":"manas-2010:p1594:b001:l018","ordinal":68682,"en":"Sent an envoy between the sides."},{"id":"manas-2010:p1594:b001:l019","ordinal":68683,"en":"As envoy from their people,"},{"id":"manas-2010:p1594:b001:l020","ordinal":68684,"en":"A thoroughly eloquent man,"},{"id":"manas-2010:p1594:b001:l021","ordinal":68685,"en":"A knowledgeable Chinese went."},{"id":"manas-2010:p1594:b001:l022","ordinal":68686,"en":"Begging Khan Manas,"},{"id":"manas-2010:p1594:b001:l023","ordinal":68687,"en":"Pleading again and again,"},{"id":"manas-2010:p1594:b001:l024","ordinal":68688,"en":"He asked for seven days' respite."},{"id":"manas-2010:p1594:b001:l025","ordinal":68689,"en":"Then Changtiybes said:"},{"id":"manas-2010:p1594:b001:l026","ordinal":68690,"en":"“You came desiring Beijing;"},{"id":"manas-2010:p1594:b001:l027","ordinal":68691,"en":"We raised as khan"},{"id":"manas-2010:p1594:b001:l028","ordinal":68692,"en":"A leopard, a champion such as you!"},{"id":"manas-2010:p1594:b001:l029","ordinal":68693,"en":"From Beijing untouched by Solomon,"},{"id":"manas-2010:p1594:b001:l030","ordinal":68694,"en":"Return having ruled it!"},{"id":"manas-2010:p1594:b001:l031","ordinal":68695,"en":"Gold and silver,"},{"id":"manas-2010:p1594:b001:l032","ordinal":68696,"en":"Return unable to load it all."},{"id":"manas-2010:p1594:b001:l033","ordinal":68697,"en":"Fair young wives and beautiful girls,"},{"id":"manas-2010:p1594:b001:l034","ordinal":68698,"en":"Return unable to manage all that booty!"},{"id":"manas-2010:p1594:b001:l035","ordinal":68699,"en":"Consent to my request;"},{"id":"manas-2010:p1594:b001:l036","ordinal":68700,"en":"I have come begging and pleading;"},{"id":"manas-2010:p1594:b001:l037","ordinal":68701,"en":"Give us seven days' respite!"},{"id":"manas-2010:p1594:b001:l038","ordinal":68702,"en":"If you rage, Khan Manas,"},{"id":"manas-2010:p1594:b001:l039","ordinal":68703,"en":"If you slaughter again, here are the people!"},{"id":"manas-2010:p1594:b001:l040","ordinal":68704,"en":"If you kill the envoy who has come,"},{"id":"manas-2010:p1594:b001:l041","ordinal":68705,"en":"Here before you am I, a Chinese!"},{"id":"manas-2010:p1594:b001:l042","ordinal":68706,"en":"Until the swaying stalks ripened,"},{"id":"manas-2010:p1595:b001:l001","ordinal":68707,"en":"Until the autumn gossamer flew,"},{"id":"manas-2010:p1595:b001:l002","ordinal":68708,"en":"We stood firm and fought;"},{"id":"manas-2010:p1595:b001:l003","ordinal":68709,"en":"Warriors in whom we trusted died;"},{"id":"manas-2010:p1595:b001:l004","ordinal":68710,"en":"So many valiant lions died;"},{"id":"manas-2010:p1595:b001:l005","ordinal":68711,"en":"From the common soldiery,"},{"id":"manas-2010:p1595:b001:l006","ordinal":68712,"en":"Uncountable troops died."},{"id":"manas-2010:p1595:b001:l007","ordinal":68713,"en":"Give us seven days' respite;"},{"id":"manas-2010:p1595:b001:l008","ordinal":68714,"en":"Let us consult with the people,"},{"id":"manas-2010:p1595:b001:l009","ordinal":68715,"en":"With a mighty one like Karykan."},{"id":"manas-2010:p1595:b001:l010","ordinal":68716,"en":"Let us take counsel and advice;"},{"id":"manas-2010:p1595:b001:l011","ordinal":68717,"en":"Taking you to Beijing,"},{"id":"manas-2010:p1595:b001:l012","ordinal":68718,"en":"Upon Karykan's throne,"},{"id":"manas-2010:p1595:b001:l013","ordinal":68719,"en":"Let us seat you too;"},{"id":"manas-2010:p1595:b001:l014","ordinal":68720,"en":"Putting a golden crown upon you,"},{"id":"manas-2010:p1595:b001:l015","ordinal":68721,"en":"Let us raise you as khan!”"},{"id":"manas-2010:p1595:b001:l016","ordinal":68722,"en":"Saying this, Changtiybes,"},{"id":"manas-2010:p1595:b001:l017","ordinal":68723,"en":"As he kept chattering and pleading,"},{"id":"manas-2010:p1595:b001:l018","ordinal":68724,"en":"Now won consent to his words;"},{"id":"manas-2010:p1595:b001:l019","ordinal":68725,"en":"Magnanimous Manas, the leopard,"},{"id":"manas-2010:p1595:b001:l020","ordinal":68726,"en":"Granted seven days' respite."},{"id":"manas-2010:p1595:b001:l021","ordinal":68727,"en":"“Manas has granted a respite,” they said;"},{"id":"manas-2010:p1595:b001:l022","ordinal":68728,"en":"All the Burut"},{"id":"manas-2010:p1595:b001:l023","ordinal":68729,"en":"Slept freely;"},{"id":"manas-2010:p1595:b001:l024","ordinal":68730,"en":"Bored, they played knucklebones;"},{"id":"manas-2010:p1595:b001:l025","ordinal":68731,"en":"Played chess with a clatter;"},{"id":"manas-2010:p1595:b001:l026","ordinal":68732,"en":"Played wildly, running mad;"},{"id":"manas-2010:p1595:b001:l027","ordinal":68733,"en":"Young and old,"},{"id":"manas-2010:p1595:b001:l028","ordinal":68734,"en":"All lay at ease."},{"id":"manas-2010:p1595:b001:l029","ordinal":68735,"en":"Untiring when out scouting,"},{"id":"manas-2010:p1595:b001:l030","ordinal":68736,"en":"Untroubled when left with the baggage train,"},{"id":"manas-2010:p1595:b001:l031","ordinal":68737,"en":"Almambet, Azizkan's son,"},{"id":"manas-2010:p1595:b001:l032","ordinal":68738,"en":"Came to Manas:"},{"id":"manas-2010:p1595:b001:l033","ordinal":68739,"en":"“Beijing, seven months away,"},{"id":"manas-2010:p1595:b001:l034","ordinal":68740,"en":"You called a journey of seven days;"},{"id":"manas-2010:p1595:b001:l035","ordinal":68741,"en":"The Chinese you besieged,"},{"id":"manas-2010:p1595:b001:l036","ordinal":68742,"en":"You called warriors without courage."},{"id":"manas-2010:p1595:b001:l037","ordinal":68743,"en":"You have granted seven days' respite;"},{"id":"manas-2010:p1595:b001:l038","ordinal":68744,"en":"Farewell, my friend Manas;"},{"id":"manas-2010:p1595:b001:l039","ordinal":68745,"en":"We shall not withdraw safely from here;"},{"id":"manas-2010:p1595:b001:l040","ordinal":68746,"en":"Not one of us shall return alive."},{"id":"manas-2010:p1595:b001:l041","ordinal":68747,"en":"We who came shall not return safely;"},{"id":"manas-2010:p1595:b001:l042","ordinal":68748,"en":"We shall not reach Talas alive!"},{"id":"manas-2010:p1596:b001:l001","ordinal":68749,"en":"When I speak with my tongue,"},{"id":"manas-2010:p1596:b001:l002","ordinal":68750,"en":"You will not accept my words;"},{"id":"manas-2010:p1596:b001:l003","ordinal":68751,"en":"You mean to end my days;"},{"id":"manas-2010:p1596:b001:l004","ordinal":68752,"en":"You mean to dig my pit;"},{"id":"manas-2010:p1596:b001:l005","ordinal":68753,"en":"Never taking my advice,"},{"id":"manas-2010:p1596:b001:l006","ordinal":68754,"en":"You mean to make my misery boil!"},{"id":"manas-2010:p1596:b001:l007","ordinal":68755,"en":"You mean to bring upon my head"},{"id":"manas-2010:p1596:b001:l008","ordinal":68756,"en":"Strange marvels from far away;"},{"id":"manas-2010:p1596:b001:l009","ordinal":68757,"en":"You mean to let them take as spoils"},{"id":"manas-2010:p1596:b001:l010","ordinal":68758,"en":"My peerless horse Sarala!"},{"id":"manas-2010:p1596:b001:l011","ordinal":68759,"en":"You have granted seven days' respite,"},{"id":"manas-2010:p1596:b001:l012","ordinal":68760,"en":"Letting them prepare far and wide,"},{"id":"manas-2010:p1596:b001:l013","ordinal":68761,"en":"Letting them gather from end to end;"},{"id":"manas-2010:p1596:b001:l014","ordinal":68762,"en":"You mean to strengthen the infidels."},{"id":"manas-2010:p1596:b001:l015","ordinal":68763,"en":"It is God's doing;"},{"id":"manas-2010:p1596:b001:l016","ordinal":68764,"en":"You mean to spill my blood!"},{"id":"manas-2010:p1596:b001:l017","ordinal":68765,"en":"I shall speak my last wishes:"},{"id":"manas-2010:p1596:b001:l018","ordinal":68766,"en":"If you reach Talas safely,"},{"id":"manas-2010:p1596:b001:l019","ordinal":68767,"en":"If you see the people safe,"},{"id":"manas-2010:p1596:b001:l020","ordinal":68768,"en":"My horses in the mountains number nine thousand,"},{"id":"manas-2010:p1596:b001:l021","ordinal":68769,"en":"Sturdy chargers and swift steeds together."},{"id":"manas-2010:p1596:b001:l022","ordinal":68770,"en":"If torment comes upon one's head,"},{"id":"manas-2010:p1596:b001:l023","ordinal":68771,"en":"Where might a lone head not be left!"},{"id":"manas-2010:p1596:b001:l024","ordinal":68772,"en":"You granted respite without consulting me;"},{"id":"manas-2010:p1596:b001:l025","ordinal":68773,"en":"My regret remains—what can I do?"},{"id":"manas-2010:p1596:b001:l026","ordinal":68774,"en":"Tears flow from my eyes like a lake!"},{"id":"manas-2010:p1596:b001:l027","ordinal":68775,"en":"My horses in the mountains have no master;"},{"id":"manas-2010:p1596:b001:l028","ordinal":68776,"en":"Gather my horses in the mountains."},{"id":"manas-2010:p1596:b001:l029","ordinal":68777,"en":"She who went together with me,"},{"id":"manas-2010:p1596:b001:l030","ordinal":68778,"en":"Aruuke, Akkan's daughter,"},{"id":"manas-2010:p1596:b001:l031","ordinal":68779,"en":"My wedded wife, without good fortune,"},{"id":"manas-2010:p1596:b001:l032","ordinal":68780,"en":"Marry her to Mazhik!"},{"id":"manas-2010:p1596:b001:l033","ordinal":68781,"en":"Beside my horse there is a bridle;"},{"id":"manas-2010:p1596:b001:l034","ordinal":68782,"en":"In Aruuke's womb,"},{"id":"manas-2010:p1596:b001:l035","ordinal":68783,"en":"There remains a three-month child."},{"id":"manas-2010:p1596:b001:l036","ordinal":68784,"en":"If a boy is born,"},{"id":"manas-2010:p1596:b001:l037","ordinal":68785,"en":"Slaughter ninety for his feast;"},{"id":"manas-2010:p1596:b001:l038","ordinal":68786,"en":"Name him hero Külchoro!"},{"id":"manas-2010:p1596:b001:l039","ordinal":68787,"en":"The horse he rides will be gray;"},{"id":"manas-2010:p1596:b001:l040","ordinal":68788,"en":"His right shoulder will be broad;"},{"id":"manas-2010:p1596:b001:l041","ordinal":68789,"en":"His world will be complete;"},{"id":"manas-2010:p1596:b001:l042","ordinal":68790,"en":"He will be a greater lion than I!"},{"id":"manas-2010:p1597:b001:l001","ordinal":68791,"en":"He will be an ember glowing red;"},{"id":"manas-2010:p1597:b001:l002","ordinal":68792,"en":"Entering a vast host, he will be a shot!"},{"id":"manas-2010:p1597:b001:l003","ordinal":68793,"en":"He will turn white deer into cattle;"},{"id":"manas-2010:p1597:b001:l004","ordinal":68794,"en":"He will throw those who grapple with him into confusion!"},{"id":"manas-2010:p1597:b001:l005","ordinal":68795,"en":"Setting grass-grown land ablaze,"},{"id":"manas-2010:p1597:b001:l006","ordinal":68796,"en":"He will set fire to river valleys;"},{"id":"manas-2010:p1597:b001:l007","ordinal":68797,"en":"He will make a way into fortified defenses;"},{"id":"manas-2010:p1597:b001:l008","ordinal":68798,"en":"If an enemy stands against him,"},{"id":"manas-2010:p1597:b001:l009","ordinal":68799,"en":"Before any mortal, he will attack!"},{"id":"manas-2010:p1597:b001:l010","ordinal":68800,"en":"When I turned Sarala's head,"},{"id":"manas-2010:p1597:b001:l011","ordinal":68801,"en":"When we summered in Ürbüs,"},{"id":"manas-2010:p1597:b001:l012","ordinal":68802,"en":"When the Argyn gathered and encamped,"},{"id":"manas-2010:p1597:b001:l013","ordinal":68803,"en":"My betrothed Aruuke,"},{"id":"manas-2010:p1597:b001:l014","ordinal":68804,"en":"When she craved lion's flesh in pregnancy,"},{"id":"manas-2010:p1597:b001:l015","ordinal":68805,"en":"At Ürbüs's head, rocky hills,"},{"id":"manas-2010:p1597:b001:l016","ordinal":68806,"en":"I scouted the pass of Muzdak;"},{"id":"manas-2010:p1597:b001:l017","ordinal":68807,"en":"Shooting a lion and bringing it down,"},{"id":"manas-2010:p1597:b001:l018","ordinal":68808,"en":"I killed it and split its belly."},{"id":"manas-2010:p1597:b001:l019","ordinal":68809,"en":"Frying its heart,"},{"id":"manas-2010:p1597:b001:l020","ordinal":68810,"en":"I gave it to Aruuke."},{"id":"manas-2010:p1597:b001:l021","ordinal":68811,"en":"‘If male, he will be my support,’ I said;"},{"id":"manas-2010:p1597:b001:l022","ordinal":68812,"en":"‘If female, one day"},{"id":"manas-2010:p1597:b001:l023","ordinal":68813,"en":"She will find her match and leave,’ I said."},{"id":"manas-2010:p1597:b001:l024","ordinal":68814,"en":"From that day until this,"},{"id":"manas-2010:p1597:b001:l025","ordinal":68815,"en":"I have cherished that hope!"},{"id":"manas-2010:p1597:b001:l026","ordinal":68816,"en":"If it is a girl, not a boy,"},{"id":"manas-2010:p1597:b001:l027","ordinal":68817,"en":"Shoot a wild ewe and eat it;"},{"id":"manas-2010:p1597:b001:l028","ordinal":68818,"en":"Almambet, gone to the hereafter—"},{"id":"manas-2010:p1597:b001:l029","ordinal":68819,"en":"‘My hawk, Almam, my soul's friend,"},{"id":"manas-2010:p1597:b001:l030","ordinal":68820,"en":"Passed without a male heir,’ say that!"},{"id":"manas-2010:p1597:b001:l031","ordinal":68821,"en":"I shall not return safely to my people;"},{"id":"manas-2010:p1597:b001:l032","ordinal":68822,"en":"Now I shall not withdraw alive!"},{"id":"manas-2010:p1597:b001:l033","ordinal":68823,"en":"If I die at Chinese hands,"},{"id":"manas-2010:p1597:b001:l034","ordinal":68824,"en":"Grasp me by the waist and fold me;"},{"id":"manas-2010:p1597:b001:l035","ordinal":68825,"en":"Do not leave my bones upon the plain;"},{"id":"manas-2010:p1597:b001:l036","ordinal":68826,"en":"Load me upon Sarala!"},{"id":"manas-2010:p1597:b001:l037","ordinal":68827,"en":"When you reach a burial ground,"},{"id":"manas-2010:p1597:b001:l038","ordinal":68828,"en":"Hollow out my grave spaciously;"},{"id":"manas-2010:p1597:b001:l039","ordinal":68829,"en":"Slaughter Sarala;"},{"id":"manas-2010:p1597:b001:l040","ordinal":68830,"en":"Digging my grave and commending me,"},{"id":"manas-2010:p1597:b001:l041","ordinal":68831,"en":"Lay me there with your own hands!"},{"id":"manas-2010:p1597:b001:l042","ordinal":68832,"en":"This Great Beijing standing here,"},{"id":"manas-2010:p1598:b001:l001","ordinal":68833,"en":"The place where my mother bore me,"},{"id":"manas-2010:p1598:b001:l002","ordinal":68834,"en":"The place where my bleeding cord was tied,"},{"id":"manas-2010:p1598:b001:l003","ordinal":68835,"en":"The place where my shirt was taken off and washed,"},{"id":"manas-2010:p1598:b001:l004","ordinal":68836,"en":"The place where my navel blood fell."},{"id":"manas-2010:p1598:b001:l005","ordinal":68837,"en":"In this place, Khan Manas,"},{"id":"manas-2010:p1598:b001:l006","ordinal":68838,"en":"My body's blood will be spilled."},{"id":"manas-2010:p1598:b001:l007","ordinal":68839,"en":"The reason it will be spilled:"},{"id":"manas-2010:p1598:b001:l008","ordinal":68840,"en":"Kojozhash, Karazhoy's son,"},{"id":"manas-2010:p1598:b001:l009","ordinal":68841,"en":"When I was a young child at play,"},{"id":"manas-2010:p1598:b001:l010","ordinal":68842,"en":"Wildly unruly and reckless,"},{"id":"manas-2010:p1598:b001:l011","ordinal":68843,"en":"When I reached six years of age,"},{"id":"manas-2010:p1598:b001:l012","ordinal":68844,"en":"Honored among the Chinese,"},{"id":"manas-2010:p1598:b001:l013","ordinal":68845,"en":"To the uplands called Suuk-Tör,"},{"id":"manas-2010:p1598:b001:l014","ordinal":68846,"en":"To the land of the One-Eyes,"},{"id":"manas-2010:p1598:b001:l015","ordinal":68847,"en":"Before the dragon,"},{"id":"manas-2010:p1598:b001:l016","ordinal":68848,"en":"In the first year, to Beijing,"},{"id":"manas-2010:p1598:b001:l017","ordinal":68849,"en":"They sent six thousand children;"},{"id":"manas-2010:p1598:b001:l018","ordinal":68850,"en":"Six thousand children perished"},{"id":"manas-2010:p1598:b001:l019","ordinal":68851,"en":"From the dragon's venom;"},{"id":"manas-2010:p1598:b001:l020","ordinal":68852,"en":"Six children and I remained."},{"id":"manas-2010:p1598:b001:l021","ordinal":68853,"en":"Seven thousand children went together;"},{"id":"manas-2010:p1598:b001:l022","ordinal":68854,"en":"Among the seven thousand,"},{"id":"manas-2010:p1598:b001:l023","ordinal":68855,"en":"Seven children and I remained."},{"id":"manas-2010:p1598:b001:l024","ordinal":68856,"en":"Ten thousand children went together;"},{"id":"manas-2010:p1598:b001:l025","ordinal":68857,"en":"Only ten children and I remained."},{"id":"manas-2010:p1598:b001:l026","ordinal":68858,"en":"While I was studying,"},{"id":"manas-2010:p1598:b001:l027","ordinal":68859,"en":"He saddled a gray young mare;"},{"id":"manas-2010:p1598:b001:l028","ordinal":68860,"en":"Kojozhash, Karazhoy's son,"},{"id":"manas-2010:p1598:b001:l029","ordinal":68861,"en":"Studied about six months before me."},{"id":"manas-2010:p1598:b001:l030","ordinal":68862,"en":"He remained knowing how to fly;"},{"id":"manas-2010:p1598:b001:l031","ordinal":68863,"en":"I remained knowing how to travel."},{"id":"manas-2010:p1598:b001:l032","ordinal":68864,"en":"I heard news from those who came:"}]
