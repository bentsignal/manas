[{"id":"semetey-1-2013:p0479:b004:l014","ordinal":113409,"en":"Alas, your khan Manas is gone."},{"id":"semetey-1-2013:p0479:b004:l015","ordinal":113410,"en":"Bereft of Khan Manas,"},{"id":"semetey-1-2013:p0479:b004:l016","ordinal":113411,"en":"Think, forty companions:"},{"id":"semetey-1-2013:p0479:b004:l017","ordinal":113412,"en":"You have no time for games."},{"id":"semetey-1-2013:p0479:b004:l018","ordinal":113413,"en":"When the merry dawn broke,"},{"id":"semetey-1-2013:p0479:b004:l019","ordinal":113414,"en":"You forty companions made merry,"},{"id":"semetey-1-2013:p0479:b004:l020","ordinal":113415,"en":"Kymyz by day and girls by night,"},{"id":"semetey-1-2013:p0479:b004:l021","ordinal":113416,"en":"Laughing and playing all the while."},{"id":"semetey-1-2013:p0479:b004:l022","ordinal":113417,"en":"Those warriors who came from Beijing,"},{"id":"semetey-1-2013:p0479:b004:l023","ordinal":113418,"en":"With valiant, gray-maned Manas—"},{"id":"semetey-1-2013:p0479:b004:l024","ordinal":113419,"en":"Those men who claimed kinship—"},{"id":"semetey-1-2013:p0479:b004:l025","ordinal":113420,"en":"Have eaten his well-nourished foal."},{"id":"semetey-1-2013:p0479:b004:l026","ordinal":113421,"en":"Spurring on and fighting,"},{"id":"semetey-1-2013:p0479:b004:l027","ordinal":113422,"en":"They claimed to be his brothers of equal birth!"},{"id":"semetey-1-2013:p0479:b004:l028","ordinal":113423,"en":"Unsuspecting, gray-maned Manas"},{"id":"semetey-1-2013:p0479:b004:l029","ordinal":113424,"en":"They repeatedly invited to feast"},{"id":"semetey-1-2013:p0479:b004:l030","ordinal":113425,"en":"And gave a poison that silenced him."},{"id":"semetey-1-2013:p0479:b004:l031","ordinal":113426,"en":"Noble Kanykei,"},{"id":"semetey-1-2013:p0479:b004:l032","ordinal":113427,"en":"Standing by the sultan,"},{"id":"semetey-1-2013:p0479:b004:l033","ordinal":113428,"en":"While they scattered his treasure,"},{"id":"semetey-1-2013:p0479:b004:l034","ordinal":113429,"en":"Carried the generous lord away"},{"id":"semetey-1-2013:p0479:b004:l035","ordinal":113430,"en":"And fled toward Mecca—"},{"id":"semetey-1-2013:p0479:b004:l036","ordinal":113431,"en":"Such scattered rumors reach me."},{"id":"semetey-1-2013:p0479:b004:l037","ordinal":113432,"en":"With life barely in him,"},{"id":"semetey-1-2013:p0479:b004:l038","ordinal":113433,"en":"Akayar began to speak."},{"id":"semetey-1-2013:p0479:b004:l039","ordinal":113434,"en":"Manas the Lion, that noble hero—"}]
