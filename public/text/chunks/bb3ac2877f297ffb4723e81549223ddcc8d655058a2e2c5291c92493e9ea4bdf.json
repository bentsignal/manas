[{"id":"seytek-2012:p0921:b004:l029","ordinal":365313,"en":"Unable to endure his wrath,"},{"id":"seytek-2012:p0921:b004:l030","ordinal":365314,"en":"The great host fled in thunder."},{"id":"seytek-2012:p0921:b004:l031","ordinal":365315,"en":"He grew ever more menacing,"},{"id":"seytek-2012:p0921:b004:l032","ordinal":365316,"en":"Raged and made ready;"},{"id":"seytek-2012:p0921:b004:l033","ordinal":365317,"en":"A single hair of his mustache"},{"id":"seytek-2012:p0921:b004:l034","ordinal":365318,"en":"Was like the haft of a weighted whip."},{"id":"seytek-2012:p0921:b004:l035","ordinal":365319,"en":"Furious and maddened,"},{"id":"seytek-2012:p0921:b004:l036","ordinal":365320,"en":"Assuming a hundred fearsome forms—"},{"id":"seytek-2012:p0921:b004:l037","ordinal":365321,"en":"Such was his appearance."},{"id":"seytek-2012:p0921:b004:l038","ordinal":365322,"en":"Allowing no warrior ahead of him,"},{"id":"seytek-2012:p0921:b004:l039","ordinal":365323,"en":"He loomed like a grain sack."},{"id":"seytek-2012:p0921:b004:l040","ordinal":365324,"en":"Sarybai, wrapped in mail,"},{"id":"seytek-2012:p0922:b002:l001","ordinal":365325,"en":"Such was his splendor."},{"id":"seytek-2012:p0922:b002:l002","ordinal":365326,"en":"His army strained forward,"},{"id":"seytek-2012:p0922:b002:l003","ordinal":365327,"en":"And behind Sarybai"},{"id":"seytek-2012:p0922:b002:l004","ordinal":365328,"en":"His champions made ready."},{"id":"seytek-2012:p0922:b002:l005","ordinal":365329,"en":"They climbed the ridges and crossed the passes,"},{"id":"seytek-2012:p0922:b002:l006","ordinal":365330,"en":"Surging over them toward this side."},{"id":"seytek-2012:p0922:b002:l007","ordinal":365331,"en":"The mountains seemed dug out and hollowed;"},{"id":"seytek-2012:p0922:b002:l008","ordinal":365332,"en":"They drew and stretched their bows."},{"id":"seytek-2012:p0922:b002:l009","ordinal":365333,"en":"At each one's grim appearance,"},{"id":"seytek-2012:p0922:b002:l010","ordinal":365334,"en":"The whole body of anyone they seized"},{"id":"seytek-2012:p0922:b002:l011","ordinal":365335,"en":"Shuddered from head to foot."},{"id":"seytek-2012:p0922:b002:l012","ordinal":365336,"en":"With musket, bow, and spear,"},{"id":"seytek-2012:p0922:b002:l013","ordinal":365337,"en":"The enraged warrior's"},{"id":"seytek-2012:p0922:b002:l014","ordinal":365338,"en":"Renown surpassed all others."},{"id":"seytek-2012:p0922:b002:l015","ordinal":365339,"en":"Among the people on earth,"},{"id":"seytek-2012:p0922:b002:l016","ordinal":365340,"en":"Across the world struck by his turmoil,"},{"id":"seytek-2012:p0922:b002:l017","ordinal":365341,"en":"He yielded his weapon to no living soul."},{"id":"seytek-2012:p0922:b002:l018","ordinal":365342,"en":"Swaying and streaming,"},{"id":"seytek-2012:p0922:b002:l019","ordinal":365343,"en":"The earth bent beneath the upheaval;"},{"id":"seytek-2012:p0922:b002:l020","ordinal":365344,"en":"Many hosts had he fought,"},{"id":"seytek-2012:p0922:b002:l021","ordinal":365345,"en":"Many foes had he grappled."},{"id":"seytek-2012:p0922:b002:l022","ordinal":365346,"en":"His eyes reddened like a lion's;"},{"id":"seytek-2012:p0922:b002:l023","ordinal":365347,"en":"Whoever came before him,"},{"id":"seytek-2012:p0922:b002:l024","ordinal":365348,"en":"He crushed to dust,"},{"id":"seytek-2012:p0922:b002:l025","ordinal":365349,"en":"Drenched and steeped in blood;"},{"id":"seytek-2012:p0922:b002:l026","ordinal":365350,"en":"When he struck, he spared no life."},{"id":"seytek-2012:p0922:b002:l027","ordinal":365351,"en":"Such was Sarybai's way."},{"id":"seytek-2012:p0922:b002:l028","ordinal":365352,"en":"Fearsome and unconcerned,"},{"id":"seytek-2012:p0922:b002:l029","ordinal":365353,"en":"He counted the entire world"},{"id":"seytek-2012:p0922:b002:l030","ordinal":365354,"en":"As less than the hem of his robe."},{"id":"seytek-2012:p0922:b002:l031","ordinal":365355,"en":"“I alone shall conquer it,” he said,"},{"id":"seytek-2012:p0922:b002:l032","ordinal":365356,"en":"Crushing all who opposed him."},{"id":"seytek-2012:p0922:b002:l033","ordinal":365357,"en":"“Have I not driven men before me and devoured them?"},{"id":"seytek-2012:p0922:b002:l034","ordinal":365358,"en":"Over the whole vast world"},{"id":"seytek-2012:p0922:b002:l035","ordinal":365359,"en":"I alone shall be sovereign,” he said."},{"id":"seytek-2012:p0922:b002:l036","ordinal":365360,"en":"Sarybai raged,"},{"id":"seytek-2012:p0922:b002:l037","ordinal":365361,"en":"And the vast, frantic people"},{"id":"seytek-2012:p0922:b002:l038","ordinal":365362,"en":"Found their days constricted;"},{"id":"seytek-2012:p0922:b002:l039","ordinal":365363,"en":"The land fell into turmoil."},{"id":"seytek-2012:p0922:b002:l040","ordinal":365364,"en":"The raging madman"},{"id":"seytek-2012:p0922:b003:l001","ordinal":365365,"en":"Did not know his end was near."},{"id":"seytek-2012:p0922:b003:l002","ordinal":365366,"en":"When he reached the great battlefield,"},{"id":"seytek-2012:p0922:b003:l003","ordinal":365367,"en":"He reined in his charger and halted."},{"id":"seytek-2012:p0922:b003:l004","ordinal":365368,"en":"Making the blue heavens resound,"},{"id":"seytek-2012:p0922:b003:l005","ordinal":365369,"en":"His forces began arriving and stopping."},{"id":"seytek-2012:p0922:b003:l006","ordinal":365370,"en":"Flame burst from the great guns;"},{"id":"seytek-2012:p0922:b003:l007","ordinal":365371,"en":"When their mouths opened, fire poured forth."},{"id":"seytek-2012:p0922:b003:l008","ordinal":365372,"en":"They climbed the ridge and braced themselves,"},{"id":"seytek-2012:p0922:b003:l009","ordinal":365373,"en":"Swaying as though shooting this way,"},{"id":"seytek-2012:p0922:b003:l010","ordinal":365374,"en":"Menacing and straining,"},{"id":"seytek-2012:p0922:b003:l011","ordinal":365375,"en":"Shouting as if possessed,"},{"id":"seytek-2012:p0922:b003:l012","ordinal":365376,"en":"Calling their people to come."},{"id":"seytek-2012:p0922:b003:l013","ordinal":365377,"en":"At the sight, the mind reeled;"},{"id":"seytek-2012:p0922:b003:l014","ordinal":365378,"en":"The blue crags of the splendid mountain"},{"id":"seytek-2012:p0922:b003:l015","ordinal":365379,"en":"Seemed like a whole vast world."},{"id":"seytek-2012:p0922:b003:l016","ordinal":365380,"en":"Like a man who never walked slowly,"},{"id":"seytek-2012:p0922:b003:l017","ordinal":365381,"en":"It seemed to stride forward."},{"id":"seytek-2012:p0922:b003:l018","ordinal":365382,"en":"Like the ravines of a valley"},{"id":"seytek-2012:p0922:b003:l019","ordinal":365383,"en":"Down which waters plunge, it appeared."},{"id":"seytek-2012:p0922:b003:l020","ordinal":365384,"en":"“Ah, the enemy!” they cried, straining forward,"},{"id":"seytek-2012:p0922:b003:l021","ordinal":365385,"en":"Their eyes dimming."},{"id":"seytek-2012:p0922:b003:l022","ordinal":365386,"en":"……………………………."},{"id":"seytek-2012:p0922:b003:l023","ordinal":365387,"en":"From the enraged boar,"},{"id":"seytek-2012:p0922:b003:l024","ordinal":365388,"en":"Ferocity burst forth,"},{"id":"seytek-2012:p0922:b003:l025","ordinal":365389,"en":"And hair bristled on both cheeks."},{"id":"seytek-2012:p0922:b003:l026","ordinal":365390,"en":"He raged and would not stand still;"},{"id":"seytek-2012:p0922:b003:l027","ordinal":365391,"en":"The people scattered in clamor."},{"id":"seytek-2012:p0922:b003:l028","ordinal":365392,"en":"When they came before his army,"},{"id":"seytek-2012:p0922:b003:l029","ordinal":365393,"en":"They could not face his wrath,"},{"id":"seytek-2012:p0922:b003:l030","ordinal":365394,"en":"Nor endure his fury."},{"id":"seytek-2012:p0922:b003:l031","ordinal":365395,"en":"Before his prestige and appearance,"},{"id":"seytek-2012:p0922:b003:l032","ordinal":365396,"en":"Even a mare could not stand her ground."},{"id":"seytek-2012:p0922:b003:l033","ordinal":365397,"en":"The people despaired of their lives"},{"id":"seytek-2012:p0922:b003:l034","ordinal":365398,"en":"At his aspect and nature,"},{"id":"seytek-2012:p0922:b003:l035","ordinal":365399,"en":"At the calamity of his strife,"},{"id":"seytek-2012:p0922:b003:l036","ordinal":365400,"en":"At his strength and venom,"},{"id":"seytek-2012:p0922:b003:l037","ordinal":365401,"en":"At the wrath he visited upon men."},{"id":"seytek-2012:p0922:b003:l038","ordinal":365402,"en":"Once confronted, he spared no life;"},{"id":"seytek-2012:p0922:b003:l039","ordinal":365403,"en":"No mortal had ever been like him."},{"id":"seytek-2012:p0922:b003:l040","ordinal":365404,"en":"Every living soul despaired,"},{"id":"seytek-2012:p0923:b002:l001","ordinal":365405,"en":"And while all living beings stood thus,"},{"id":"seytek-2012:p0923:b002:l002","ordinal":365406,"en":"Kuyaly of Kaiypchal"},{"id":"seytek-2012:p0923:b002:l003","ordinal":365407,"en":"Also began her holy war."},{"id":"seytek-2012:p0923:b002:l004","ordinal":365408,"en":"Then Seytek spoke,"},{"id":"seytek-2012:p0923:b002:l005","ordinal":365409,"en":"And these were the words he said:"},{"id":"seytek-2012:p0923:b002:l006","ordinal":365410,"en":"“When he rages, roaring,"},{"id":"seytek-2012:p0923:b002:l007","ordinal":365411,"en":"And summons his people and army,"},{"id":"seytek-2012:p0923:b002:l008","ordinal":365412,"en":"Sarybai at their head"},{"id":"seytek-2012:p0923:b002:l009","ordinal":365413,"en":"Roars and stirs up conflict."},{"id":"seytek-2012:p0923:b002:l010","ordinal":365414,"en":"The sin and the merit alike,"},{"id":"seytek-2012:p0923:b002:l011","ordinal":365415,"en":"If he turns to evil, are his own."},{"id":"seytek-2012:p0923:b002:l012","ordinal":365416,"en":"Amid the four sacred duties,"},{"id":"seytek-2012:p0923:b002:l013","ordinal":365417,"en":"Kaiypchal's champion maiden,"},{"id":"seytek-2012:p0923:b002:l014","ordinal":365418,"en":"That surpassing, impetuous warrior—"},{"id":"seytek-2012:p0923:b002:l015","ordinal":365419,"en":"This infidel Sarybai,"},{"id":"seytek-2012:p0923:b002:l016","ordinal":365420,"en":"Who carries men away,"},{"id":"seytek-2012:p0923:b002:l017","ordinal":365421,"en":"This is the mouth that has uttered so much,"},{"id":"seytek-2012:p0923:b002:l018","ordinal":365422,"en":"This is the army standing ready to fight,"},{"id":"seytek-2012:p0923:b002:l019","ordinal":365423,"en":"This is the surging, frantic people."},{"id":"seytek-2012:p0923:b002:l020","ordinal":365424,"en":"Like a grievous affliction,"},{"id":"seytek-2012:p0923:b002:l021","ordinal":365425,"en":"This is the moment long awaited."},{"id":"seytek-2012:p0923:b002:l022","ordinal":365426,"en":"The tormented, desperate people"},{"id":"seytek-2012:p0923:b002:l023","ordinal":365427,"en":"Cannot walk for their pain."},{"id":"seytek-2012:p0923:b002:l024","ordinal":365428,"en":"That swine who calls himself a warrior—"},{"id":"seytek-2012:p0923:b002:l025","ordinal":365429,"en":"I will crush the monster;"},{"id":"seytek-2012:p0923:b002:l026","ordinal":365430,"en":"If he fights, I will soak him in blood,"},{"id":"seytek-2012:p0923:b002:l027","ordinal":365431,"en":"Hack him apart, and still his breath."},{"id":"seytek-2012:p0923:b002:l028","ordinal":365432,"en":"Talas is no easy land;"},{"id":"seytek-2012:p0923:b002:l029","ordinal":365433,"en":"Kuyaly, who tests warriors,"},{"id":"seytek-2012:p0923:b002:l030","ordinal":365434,"en":"Is no feeble or ordinary hero."},{"id":"seytek-2012:p0923:b002:l031","ordinal":365435,"en":"This infidel, son of a demon,"},{"id":"seytek-2012:p0923:b002:l032","ordinal":365436,"en":"Is no lion equal to her, if you consider it."},{"id":"seytek-2012:p0923:b002:l033","ordinal":365437,"en":"Let us strike a terrible blow;"},{"id":"seytek-2012:p0923:b002:l034","ordinal":365438,"en":"If fortune favors us, let us take him."},{"id":"seytek-2012:p0923:b002:l035","ordinal":365439,"en":"From the grievous death that has come,"},{"id":"seytek-2012:p0923:b002:l036","ordinal":365440,"en":"Let us shield the people."},{"id":"seytek-2012:p0923:b002:l037","ordinal":365441,"en":"Let us test the strength"},{"id":"seytek-2012:p0923:b002:l038","ordinal":365442,"en":"Of this vicious, wrathful swine;"},{"id":"seytek-2012:p0923:b002:l039","ordinal":365443,"en":"Let us grapple and join battle."},{"id":"seytek-2012:p0923:b002:l040","ordinal":365444,"en":"Until we have grappled and fought,"},{"id":"seytek-2012:p0923:b004:l001","ordinal":365445,"en":"Until we have rescued his great nation"},{"id":"seytek-2012:p0923:b004:l002","ordinal":365446,"en":"From its misery,"},{"id":"seytek-2012:p0923:b004:l003","ordinal":365447,"en":"The early hope has grown late;"},{"id":"seytek-2012:p0923:b004:l004","ordinal":365448,"en":"My two eyes have become four with watching."},{"id":"seytek-2012:p0923:b004:l005","ordinal":365449,"en":"If my frail soul may rejoice,"},{"id":"seytek-2012:p0923:b004:l006","ordinal":365450,"en":"My warrior heart pounds;"},{"id":"seytek-2012:p0923:b004:l007","ordinal":365451,"en":"Oh, joyful hour!"},{"id":"seytek-2012:p0923:b004:l008","ordinal":365452,"en":"Sarybai, whom I have sought,"},{"id":"seytek-2012:p0923:b004:l009","ordinal":365453,"en":"Has appeared before my face."},{"id":"seytek-2012:p0923:b004:l010","ordinal":365454,"en":"What was broken in me is restored;"},{"id":"seytek-2012:p0923:b004:l011","ordinal":365455,"en":"Thus my soul rejoices."},{"id":"seytek-2012:p0923:b004:l012","ordinal":365456,"en":"I lower my spear and face him,"},{"id":"seytek-2012:p0923:b004:l013","ordinal":365457,"en":"And seize the fighting arm."},{"id":"seytek-2012:p0923:b004:l014","ordinal":365458,"en":"My poor soul is so overjoyed"},{"id":"seytek-2012:p0923:b004:l015","ordinal":365459,"en":"That I can scarcely stay upon the earth."},{"id":"seytek-2012:p0923:b004:l016","ordinal":365460,"en":"Though I fight another six days,"},{"id":"seytek-2012:p0923:b004:l017","ordinal":365461,"en":"My mounting fury will change;"},{"id":"seytek-2012:p0923:b004:l018","ordinal":365462,"en":"If he rages, shall I flee"},{"id":"seytek-2012:p0923:b004:l019","ordinal":365463,"en":"From that swine who calls himself a warrior?"},{"id":"seytek-2012:p0923:b004:l020","ordinal":365464,"en":"Let us find a way to settle his account."},{"id":"seytek-2012:p0923:b004:l021","ordinal":365465,"en":"My name is Kuyaly;"},{"id":"seytek-2012:p0923:b004:l022","ordinal":365466,"en":"I do not boast idly."},{"id":"seytek-2012:p0923:b004:l023","ordinal":365467,"en":"The wings beneath me"},{"id":"seytek-2012:p0923:b004:l024","ordinal":365468,"en":"Have fought in desert and amid armies."},{"id":"seytek-2012:p0923:b004:l025","ordinal":365469,"en":"This infidel Sarybai—"},{"id":"seytek-2012:p0923:b004:l026","ordinal":365470,"en":"Boasting is his habit."},{"id":"seytek-2012:p0923:b004:l027","ordinal":365471,"en":"Do not grieve, asking whether your vengeance died"},{"id":"seytek-2012:p0923:b004:l028","ordinal":365472,"en":"While he still raged before his death;"},{"id":"seytek-2012:p0923:b004:l029","ordinal":365473,"en":"Call him a doomed, overbearing wretch,"},{"id":"seytek-2012:p0923:b004:l030","ordinal":365474,"en":"And let not his people remain forever unreformed."},{"id":"seytek-2012:p0923:b004:l031","ordinal":365475,"en":"Split apart his arrow-proof coat;"},{"id":"seytek-2012:p0923:b004:l032","ordinal":365476,"en":"The calamity that has come from him—"},{"id":"seytek-2012:p0923:b004:l033","ordinal":365477,"en":"Try warding it off with your own hands."},{"id":"seytek-2012:p0923:b004:l034","ordinal":365478,"en":"Ride out in single combat,"},{"id":"seytek-2012:p0923:b004:l035","ordinal":365479,"en":"And clash with him once more."},{"id":"seytek-2012:p0923:b004:l036","ordinal":365480,"en":"These are the words I speak:"},{"id":"seytek-2012:p0923:b004:l037","ordinal":365481,"en":"I shall cast my challenge to the moon;"},{"id":"seytek-2012:p0923:b004:l038","ordinal":365482,"en":"The misery he brought upon the people"},{"id":"seytek-2012:p0923:b004:l039","ordinal":365483,"en":"I shall meet and turn aside."},{"id":"seytek-2012:p0923:b004:l040","ordinal":365484,"en":"If I die, dear people,"},{"id":"seytek-2012:p0924:b002:l001","ordinal":365485,"en":"Say, ‘She died at Sarybai's hand;"},{"id":"seytek-2012:p0924:b002:l002","ordinal":365486,"en":"She went to the land of no return;"},{"id":"seytek-2012:p0924:b002:l003","ordinal":365487,"en":"The lioness met her fate,’"},{"id":"seytek-2012:p0924:b002:l004","ordinal":365488,"en":"And abandon all hope of me."},{"id":"seytek-2012:p0924:b002:l005","ordinal":365489,"en":"Say, ‘Our true champion has died;"},{"id":"seytek-2012:p0924:b002:l006","ordinal":365490,"en":"The valiant maiden met her fate;"},{"id":"seytek-2012:p0924:b002:l007","ordinal":365491,"en":"Her blood filled the riverbed;"},{"id":"seytek-2012:p0924:b002:l008","ordinal":365492,"en":"She was extinguished like a fire.’"},{"id":"seytek-2012:p0924:b002:l009","ordinal":365493,"en":"Scatter those who have assembled;"},{"id":"seytek-2012:p0924:b002:l010","ordinal":365494,"en":"Flee in every direction."},{"id":"seytek-2012:p0924:b002:l011","ordinal":365495,"en":"But if you are men, if you are warriors,"},{"id":"seytek-2012:p0924:b002:l012","ordinal":365496,"en":"Strike and wage battle;"},{"id":"seytek-2012:p0924:b002:l013","ordinal":365497,"en":"Stand beneath the banner."},{"id":"seytek-2012:p0924:b002:l014","ordinal":365498,"en":"Seek out and witness"},{"id":"seytek-2012:p0924:b002:l015","ordinal":365499,"en":"The great, bloody conflict;"},{"id":"seytek-2012:p0924:b002:l016","ordinal":365500,"en":"When you see it, let us not lose heart."},{"id":"seytek-2012:p0924:b002:l017","ordinal":365501,"en":"Say that Kuyaly is dead,"},{"id":"seytek-2012:p0924:b002:l018","ordinal":365502,"en":"And surrender everything you behold!"},{"id":"seytek-2012:p0924:b002:l019","ordinal":365503,"en":"In the fierce, entangled battle,"},{"id":"seytek-2012:p0924:b002:l020","ordinal":365504,"en":"What use is grieving?"},{"id":"seytek-2012:p0924:b002:l021","ordinal":365505,"en":"In the harsh, ruined ravine,"},{"id":"seytek-2012:p0924:b002:l022","ordinal":365506,"en":"What use is wasting away in sorrow,"},{"id":"seytek-2012:p0924:b002:l023","ordinal":365507,"en":"Paling from yellow sickness—"},{"id":"seytek-2012:p0924:b002:l024","ordinal":365508,"en":"What use is pining?"},{"id":"seytek-2012:p0924:b002:l025","ordinal":365509,"en":"Champions who have girded your waists,"},{"id":"seytek-2012:p0924:b002:l026","ordinal":365510,"en":"Sarybai is a champion too,"},{"id":"seytek-2012:p0924:b002:l027","ordinal":365511,"en":"A black-hearted lion."},{"id":"seytek-2012:p0924:b002:l028","ordinal":365512,"en":"Do not stand idle—join battle;"},{"id":"seytek-2012:p0924:b002:l029","ordinal":365513,"en":"Lift up once"},{"id":"seytek-2012:p0924:b002:l030","ordinal":365514,"en":"This grievous, bitter burden."},{"id":"seytek-2012:p0924:b002:l031","ordinal":365515,"en":"When each one's courage is revealed,"},{"id":"seytek-2012:p0924:b002:l032","ordinal":365516,"en":"When they arrive with battle cries,"},{"id":"seytek-2012:p0924:b002:l033","ordinal":365517,"en":"If I fight them one by one"},{"id":"seytek-2012:p0924:b002:l034","ordinal":365518,"en":"And depart forever,"},{"id":"seytek-2012:p0924:b002:l035","ordinal":365519,"en":"Lower your spears."},{"id":"seytek-2012:p0924:b002:l036","ordinal":365520,"en":"If you are heroes, if you are men,"},{"id":"seytek-2012:p0924:b002:l037","ordinal":365521,"en":"If you bear the cry of the noble gray-maned wolf,"},{"id":"seytek-2012:p0924:b002:l038","ordinal":365522,"en":"If you are hawk-like warriors,"},{"id":"seytek-2012:p0924:b002:l039","ordinal":365523,"en":"And fate appoints me death,"},{"id":"seytek-2012:p0924:b002:l040","ordinal":365524,"en":"Then those of you who remain alive"},{"id":"seytek-2012:p0924:b003:l001","ordinal":365525,"en":"Stand as my support;"},{"id":"seytek-2012:p0924:b003:l002","ordinal":365526,"en":"Keep your promise!"},{"id":"seytek-2012:p0924:b003:l003","ordinal":365527,"en":"He has a tail and a living soul,"},{"id":"seytek-2012:p0924:b003:l004","ordinal":365528,"en":"And venom in his purpose;"},{"id":"seytek-2012:p0924:b003:l005","ordinal":365529,"en":"Let Sarybai despair of life,"},{"id":"seytek-2012:p0924:b003:l006","ordinal":365530,"en":"Saying, ‘Here is a soul with a mighty arm.’"},{"id":"seytek-2012:p0924:b003:l007","ordinal":365531,"en":"Such is the word you have heard from me."},{"id":"seytek-2012:p0924:b003:l008","ordinal":365532,"en":"Be my support and my strength;"},{"id":"seytek-2012:p0924:b003:l009","ordinal":365533,"en":"Charge forth against the enemy."},{"id":"seytek-2012:p0924:b003:l010","ordinal":365534,"en":"If I fight while holding the upper ground,"},{"id":"seytek-2012:p0924:b003:l011","ordinal":365535,"en":"Be my prop;"},{"id":"seytek-2012:p0924:b003:l012","ordinal":365536,"en":"If by chance I am driven downhill,"},{"id":"seytek-2012:p0924:b003:l013","ordinal":365537,"en":"Be my prop."},{"id":"seytek-2012:p0924:b003:l014","ordinal":365538,"en":"Do not let his army engulf me;"},{"id":"seytek-2012:p0924:b003:l015","ordinal":365539,"en":"Do not let them spear me from every side"},{"id":"seytek-2012:p0924:b003:l016","ordinal":365540,"en":"And close their ranks around me."},{"id":"seytek-2012:p0924:b003:l017","ordinal":365541,"en":"Let them not hem in my hands"},{"id":"seytek-2012:p0924:b003:l018","ordinal":365542,"en":"Or block my path."},{"id":"seytek-2012:p0924:b003:l019","ordinal":365543,"en":"Let him not display his prowess."},{"id":"seytek-2012:p0924:b003:l020","ordinal":365544,"en":"Sarybai is the one I face;"},{"id":"seytek-2012:p0924:b003:l021","ordinal":365545,"en":"Such is our notorious foe."},{"id":"seytek-2012:p0924:b003:l022","ordinal":365546,"en":"My allied peoples cry aloud,"},{"id":"seytek-2012:p0924:b003:l023","ordinal":365547,"en":"Shuddering and trembling."},{"id":"seytek-2012:p0924:b003:l024","ordinal":365548,"en":"Would God not strike us"},{"id":"seytek-2012:p0924:b003:l025","ordinal":365549,"en":"If I lost my senses"},{"id":"seytek-2012:p0924:b003:l026","ordinal":365550,"en":"And turned back in flight,"},{"id":"seytek-2012:p0924:b003:l027","ordinal":365551,"en":"Showed the enemy my horse's rump,"},{"id":"seytek-2012:p0924:b003:l028","ordinal":365552,"en":"And surrendered my reason?"},{"id":"seytek-2012:p0924:b003:l029","ordinal":365553,"en":"Would He not bring calamity"},{"id":"seytek-2012:p0924:b003:l030","ordinal":365554,"en":"When the great host panics?"},{"id":"seytek-2012:p0924:b003:l031","ordinal":365555,"en":"Would He not take them even as they flee?"},{"id":"seytek-2012:p0924:b003:l032","ordinal":365556,"en":"Therefore heed these words:"},{"id":"seytek-2012:p0924:b003:l033","ordinal":365557,"en":"Stand as my support."},{"id":"seytek-2012:p0924:b003:l034","ordinal":365558,"en":"If you do not support me,"},{"id":"seytek-2012:p0924:b003:l035","ordinal":365559,"en":"Will not seven wolves"},{"id":"seytek-2012:p0924:b003:l036","ordinal":365560,"en":"Fall upon and tear apart one sheep?"},{"id":"seytek-2012:p0924:b003:l037","ordinal":365561,"en":"A lone soul faces many perils;"},{"id":"seytek-2012:p0924:b003:l038","ordinal":365562,"en":"Will they not drag it away after beating it?"},{"id":"seytek-2012:p0924:b003:l039","ordinal":365563,"en":"Will not a thousand men"},{"id":"seytek-2012:p0924:b003:l040","ordinal":365564,"en":"Shoot down one person in a single day?"},{"id":"seytek-2012:p0925:b002:l001","ordinal":365565,"en":"Turn your chargers' heads;"},{"id":"seytek-2012:p0925:b002:l002","ordinal":365566,"en":"Stand ready, army, safe and sound;"},{"id":"seytek-2012:p0925:b002:l003","ordinal":365567,"en":"Do not stand idle—lower your spears."},{"id":"seytek-2012:p0925:b002:l004","ordinal":365568,"en":"If death overtakes you, die."}]
