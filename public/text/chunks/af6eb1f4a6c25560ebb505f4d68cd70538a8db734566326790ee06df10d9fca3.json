[{"id":"semetey-1-2013:p0936:b003:l001","ordinal":148481,"en":"That orphan, son of Manas,"},{"id":"semetey-1-2013:p0936:b003:l002","ordinal":148482,"en":"Has committed this outrage."},{"id":"semetey-1-2013:p0936:b003:l003","ordinal":148483,"en":"Having your wife taken from you,"},{"id":"semetey-1-2013:p0936:b003:l004","ordinal":148484,"en":"Toltoi, you have been struck by God."},{"id":"semetey-1-2013:p0936:b003:l005","ordinal":148485,"en":"His father, bloodthirsty Manas,"},{"id":"semetey-1-2013:p0936:b003:l006","ordinal":148486,"en":"I am the one who deceived him six times."},{"id":"semetey-1-2013:p0936:b003:l007","ordinal":148487,"en":"If you speak of a hero, I am a hero;"},{"id":"semetey-1-2013:p0936:b003:l008","ordinal":148488,"en":"My friend Toltoi, hear me:"},{"id":"semetey-1-2013:p0936:b003:l009","ordinal":148489,"en":"If another army appears upon the road,"},{"id":"semetey-1-2013:p0936:b003:l010","ordinal":148490,"en":"I alone shall be its match."},{"id":"semetey-1-2013:p0936:b003:l011","ordinal":148491,"en":"When he hears the sound of guns,"},{"id":"semetey-1-2013:p0936:b003:l012","ordinal":148492,"en":"My black horse flies into the sky."},{"id":"semetey-1-2013:p0936:b003:l013","ordinal":148493,"en":"Not merely China, but the whole world"},{"id":"semetey-1-2013:p0936:b003:l014","ordinal":148494,"en":"I am accustomed to slaughter."},{"id":"semetey-1-2013:p0936:b003:l015","ordinal":148495,"en":"I have come to you to lay bare"},{"id":"semetey-1-2013:p0936:b003:l016","ordinal":148496,"en":"That Semetey's record."},{"id":"semetey-1-2013:p0936:b003:l017","ordinal":148497,"en":"There is no ship upon the dark water;"},{"id":"semetey-1-2013:p0936:b003:l018","ordinal":148498,"en":"Watch, Jediger:"},{"id":"semetey-1-2013:p0936:b003:l019","ordinal":148499,"en":"So long as my precious head survives,"},{"id":"semetey-1-2013:p0936:b003:l020","ordinal":148500,"en":"There is no one to defy you."},{"id":"semetey-1-2013:p0936:b003:l021","ordinal":148501,"en":"So long as my black horse is safe,"},{"id":"semetey-1-2013:p0936:b003:l022","ordinal":148502,"en":"The eighteen thousand worlds"},{"id":"semetey-1-2013:p0936:b003:l023","ordinal":148503,"en":"I can crush like meal."},{"id":"semetey-1-2013:p0936:b003:l024","ordinal":148504,"en":"My calamities, above my head,"},{"id":"semetey-1-2013:p0936:b003:l025","ordinal":148505,"en":"While the hero Kojo is here,"},{"id":"semetey-1-2013:p0936:b003:l026","ordinal":148506,"en":"Jediger, you have no enemy."},{"id":"semetey-1-2013:p0936:b003:l027","ordinal":148507,"en":"Perhaps you have heard:"},{"id":"semetey-1-2013:p0936:b003:l028","ordinal":148508,"en":"In the hollow of Karkyra,"},{"id":"semetey-1-2013:p0936:b003:l029","ordinal":148509,"en":"At Khan Kokotoi's feast,"},{"id":"semetey-1-2013:p0936:b003:l030","ordinal":148510,"en":"Of the hairy-mouthed Russians,"},{"id":"semetey-1-2013:p0936:b003:l031","ordinal":148511,"en":"When twelve kinds arrived,"},{"id":"semetey-1-2013:p0936:b003:l032","ordinal":148512,"en":"Of the red-tufted Chinese,"},{"id":"semetey-1-2013:p0936:b003:l033","ordinal":148513,"en":"When forty clans arrived,"},{"id":"semetey-1-2013:p0936:b003:l034","ordinal":148514,"en":"At Kara-Saz in Karkyra,"},{"id":"semetey-1-2013:p0936:b003:l035","ordinal":148515,"en":"When mares were tethered,"},{"id":"semetey-1-2013:p0936:b003:l036","ordinal":148516,"en":"Becoming friends with the kaldai,"},{"id":"semetey-1-2013:p0936:b003:l037","ordinal":148517,"en":"And salt was boiled,"},{"id":"semetey-1-2013:p0936:b003:l038","ordinal":148518,"en":"At Khan Kokotoi's feast,"},{"id":"semetey-1-2013:p0936:b003:l039","ordinal":148519,"en":"When the giants gathered,"},{"id":"semetey-1-2013:p0936:b004:l001","ordinal":148520,"en":"Not a single human being remaining behind,"},{"id":"semetey-1-2013:p0936:b004:l002","ordinal":148521,"en":"When everyone had gone there,"},{"id":"semetey-1-2013:p0936:b004:l003","ordinal":148522,"en":"Saintly Khan Koshoi"},{"id":"semetey-1-2013:p0936:b004:l004","ordinal":148523,"en":"Gave a stern command,"},{"id":"semetey-1-2013:p0936:b004:l005","ordinal":148524,"en":"Load on the burden of endurance,"},{"id":"semetey-1-2013:p0936:b004:l006","ordinal":148525,"en":"Kokotoi's great feast"},{"id":"semetey-1-2013:p0936:b004:l007","ordinal":148526,"en":"The Muslim faithful undertook."},{"id":"semetey-1-2013:p0936:b004:l008","ordinal":148527,"en":"Within that gathering"},{"id":"semetey-1-2013:p0936:b004:l009","ordinal":148528,"en":"Were the giants Koshoi and Toshtuk,"},{"id":"semetey-1-2013:p0936:b004:l010","ordinal":148529,"en":"And all the people who had set out."},{"id":"semetey-1-2013:p0936:b004:l011","ordinal":148530,"en":"From the Kara-Kalmak and Manchus"},{"id":"semetey-1-2013:p0936:b004:l012","ordinal":148531,"en":"Was that dear giant Joloi."},{"id":"semetey-1-2013:p0936:b004:l013","ordinal":148532,"en":"The Muslims had their master, leopard Manas."},{"id":"semetey-1-2013:p0936:b004:l015","ordinal":148533,"en":"From China were warriors of many kinds;"},{"id":"semetey-1-2013:p0936:b004:l016","ordinal":148534,"en":"Among those Chinese"},{"id":"semetey-1-2013:p0936:b004:l017","ordinal":148535,"en":"Was hairy-soled Tukubai,"},{"id":"semetey-1-2013:p0936:b004:l018","ordinal":148536,"en":"That utterly ruined infidel."},{"id":"semetey-1-2013:p0936:b004:l019","ordinal":148537,"en":"He spared no one he grappled with,"},{"id":"semetey-1-2013:p0936:b004:l020","ordinal":148538,"en":"And the meat of a single pig,"},{"id":"semetey-1-2013:p0936:b004:l021","ordinal":148539,"en":"Though he ate it all himself, could not fill him."},{"id":"semetey-1-2013:p0936:b004:l022","ordinal":148540,"en":"Relying on their might, those Chinese"},{"id":"semetey-1-2013:p0936:b004:l023","ordinal":148541,"en":"Surged forward together without stopping,"},{"id":"semetey-1-2013:p0936:b004:l024","ordinal":148542,"en":"Stirred up the meat at the cooking trench,"},{"id":"semetey-1-2013:p0936:b004:l025","ordinal":148543,"en":"The raw meat just put in,"},{"id":"semetey-1-2013:p0936:b004:l026","ordinal":148544,"en":"With no thought for cooked or raw,"},{"id":"semetey-1-2013:p0936:b004:l027","ordinal":148545,"en":"The Kara-Kalmaks plundered."},{"id":"semetey-1-2013:p0936:b004:l028","ordinal":148546,"en":"The young men serving at Kokotoi's feast"},{"id":"semetey-1-2013:p0936:b004:l030","ordinal":148547,"en":"They beat with fire pokers."},{"id":"semetey-1-2013:p0936:b004:l031","ordinal":148548,"en":"The swarming infidels"},{"id":"semetey-1-2013:p0936:b004:l032","ordinal":148549,"en":"Ran toward the cooking trench."},{"id":"semetey-1-2013:p0936:b004:l033","ordinal":148550,"en":"The Muslims who watched"},{"id":"semetey-1-2013:p0936:b004:l034","ordinal":148551,"en":"Despaired of their lives."},{"id":"semetey-1-2013:p0936:b004:l035","ordinal":148552,"en":"Lashing out upon Ak-Kula,"},{"id":"semetey-1-2013:p0936:b004:l036","ordinal":148553,"en":"Leopard Manas then,"},{"id":"semetey-1-2013:p0936:b004:l037","ordinal":148554,"en":"Pleading with the one God,"},{"id":"semetey-1-2013:p0936:b004:l038","ordinal":148555,"en":"'We invited them to a memorial feast,"},{"id":"semetey-1-2013:p0936:b004:l039","ordinal":148556,"en":"But they have come to seize it,' he said,"},{"id":"semetey-1-2013:p0937:b003:l001","ordinal":148557,"en":"'They have come to bring"},{"id":"semetey-1-2013:p0937:b003:l002","ordinal":148558,"en":"Merciless uproar,' he said."},{"id":"semetey-1-2013:p0937:b003:l003","ordinal":148559,"en":"Flushing like a lion,"},{"id":"semetey-1-2013:p0937:b003:l004","ordinal":148560,"en":"Her apple-round neck stretched,"},{"id":"semetey-1-2013:p0937:b003:l005","ordinal":148561,"en":"Dust issuing from the corners of his mouth,"},{"id":"semetey-1-2013:p0937:b003:l006","ordinal":148562,"en":"His courage driving the breath from foes."},{"id":"semetey-1-2013:p0937:b003:l007","ordinal":148563,"en":"Girding himself with the gray belt,"},{"id":"semetey-1-2013:p0937:b003:l008","ordinal":148564,"en":"Manas entered, thundering."},{"id":"semetey-1-2013:p0937:b003:l009","ordinal":148565,"en":"The host of Chinese and many Manchus"},{"id":"semetey-1-2013:p0937:b003:l010","ordinal":148566,"en":"From the cooking trench"},{"id":"semetey-1-2013:p0937:b003:l011","ordinal":148567,"en":"Fled in a roaring rush."},{"id":"semetey-1-2013:p0937:b003:l012","ordinal":148568,"en":"We thought, 'He will beat them away,'"},{"id":"semetey-1-2013:p0937:b003:l013","ordinal":148569,"en":"But he drove them away slaughtering."},{"id":"semetey-1-2013:p0937:b003:l014","ordinal":148570,"en":"The Muslims with split heads,"},{"id":"semetey-1-2013:p0937:b003:l015","ordinal":148571,"en":"The hero, leopard Manas,"},{"id":"semetey-1-2013:p0937:b003:l016","ordinal":148572,"en":"Rescued from them."},{"id":"semetey-1-2013:p0937:b003:l017","ordinal":148573,"en":"'They will say he gave a feast and started a quarrel;"},{"id":"semetey-1-2013:p0937:b003:l018","ordinal":148574,"en":"The dispute will spread throughout the world;"},{"id":"semetey-1-2013:p0937:b003:l019","ordinal":148575,"en":"The infidels and Muslims"},{"id":"semetey-1-2013:p0937:b003:l020","ordinal":148576,"en":"Will come to blows,' they said."},{"id":"semetey-1-2013:p0937:b003:l021","ordinal":148577,"en":"Dear Koshoi and Akun Khan"},{"id":"semetey-1-2013:p0937:b003:l022","ordinal":148578,"en":"Seized Manas,"},{"id":"semetey-1-2013:p0937:b003:l023","ordinal":148579,"en":"As he raged and struggled,"},{"id":"semetey-1-2013:p0937:b003:l024","ordinal":148580,"en":"And lunged like a widow in grief."},{"id":"semetey-1-2013:p0937:b003:l025","ordinal":148581,"en":"Somehow taking hold of Manas,"},{"id":"semetey-1-2013:p0937:b003:l026","ordinal":148582,"en":"They separated him from the Chinese."},{"id":"semetey-1-2013:p0937:b003:l027","ordinal":148583,"en":"Then Akun said this:"},{"id":"semetey-1-2013:p0937:b003:l028","ordinal":148584,"en":"'We are friends until Judgment Day;"},{"id":"semetey-1-2013:p0937:b003:l029","ordinal":148585,"en":"Understand these words of mine,"},{"id":"semetey-1-2013:p0937:b003:l030","ordinal":148586,"en":"Put aside your anger and heed me!"},{"id":"semetey-1-2013:p0937:b003:l031","ordinal":148587,"en":"From the ridge of Belgiluu,"},{"id":"semetey-1-2013:p0937:b003:l032","ordinal":148588,"en":"From the place where peris play,"},{"id":"semetey-1-2013:p0937:b003:l033","ordinal":148589,"en":"Demanding skilled craftswomen among the women,"},{"id":"semetey-1-2013:p0937:b003:l034","ordinal":148590,"en":"Beautiful as the shining moon,"},{"id":"semetey-1-2013:p0937:b003:l035","ordinal":148591,"en":"I found a newborn girl."},{"id":"semetey-1-2013:p0937:b003:l036","ordinal":148592,"en":"I slaughtered ninety beasts for her feast,"},{"id":"semetey-1-2013:p0937:b003:l037","ordinal":148593,"en":"Saying, \"She is surpassingly beautiful,\""},{"id":"semetey-1-2013:p0937:b003:l038","ordinal":148594,"en":"I named her Churok."},{"id":"semetey-1-2013:p0937:b003:l039","ordinal":148595,"en":"In my child's ears"},{"id":"semetey-1-2013:p0937:b005:l001","ordinal":148596,"en":"I placed gold earrings."},{"id":"semetey-1-2013:p0937:b005:l002","ordinal":148597,"en":"Magnanimous Manas, my soul-friend,"},{"id":"semetey-1-2013:p0937:b005:l003","ordinal":148598,"en":"I have set her aside for you."},{"id":"semetey-1-2013:p0937:b005:l004","ordinal":148599,"en":"Heed my words well,"},{"id":"semetey-1-2013:p0937:b005:l005","ordinal":148600,"en":"Take her as your daughter-in-law."},{"id":"semetey-1-2013:p0937:b005:l006","ordinal":148601,"en":"Spread your hands and say \"Amen,\""},{"id":"semetey-1-2013:p0937:b005:l007","ordinal":148602,"en":"And bind her in betrothal.'"},{"id":"semetey-1-2013:p0937:b005:l008","ordinal":148603,"en":"When he spoke thus,"},{"id":"semetey-1-2013:p0937:b005:l009","ordinal":148604,"en":"'That is well, Akun,' he said,"},{"id":"semetey-1-2013:p0937:b005:l010","ordinal":148605,"en":"'What you have said is wise.'"},{"id":"semetey-1-2013:p0937:b005:l011","ordinal":148606,"en":"They arranged the marriage and drove livestock,"},{"id":"semetey-1-2013:p0937:b005:l012","ordinal":148607,"en":"Bowed in homage and feasted on fat,"},{"id":"semetey-1-2013:p0937:b005:l013","ordinal":148608,"en":"This is the story:"},{"id":"semetey-1-2013:p0937:b005:l014","ordinal":148609,"en":"Akun's daughter Aichurok"},{"id":"semetey-1-2013:p0937:b005:l015","ordinal":148610,"en":"Is to be Manas's daughter-in-law."},{"id":"semetey-1-2013:p0937:b005:l016","ordinal":148611,"en":"Heed me, my hero Toltoi;"},{"id":"semetey-1-2013:p0937:b005:l017","ordinal":148612,"en":"If you ask about her,"},{"id":"semetey-1-2013:p0937:b005:l018","ordinal":148613,"en":"She is Semetey's wife."},{"id":"semetey-1-2013:p0937:b005:l019","ordinal":148614,"en":"She has a betrothed in a known place;"},{"id":"semetey-1-2013:p0937:b005:l020","ordinal":148615,"en":"He has a maiden he is to take as wife."},{"id":"semetey-1-2013:p0937:b005:l021","ordinal":148616,"en":"He took your wife;"},{"id":"semetey-1-2013:p0937:b005:l022","ordinal":148617,"en":"If you take his wife,"},{"id":"semetey-1-2013:p0937:b005:l023","ordinal":148618,"en":"Such is honor, after all."},{"id":"semetey-1-2013:p0937:b005:l024","ordinal":148619,"en":"Consider it, my hero Toltoi!"},{"id":"semetey-1-2013:p0937:b005:l025","ordinal":148620,"en":"At Jeti-Ozon, let us muster"},{"id":"semetey-1-2013:p0937:b005:l026","ordinal":148621,"en":"The Jediger in full."},{"id":"semetey-1-2013:p0937:b005:l027","ordinal":148622,"en":"Let us bring turmoil upon Oogan."},{"id":"semetey-1-2013:p0937:b005:l028","ordinal":148623,"en":"Manas's son Semetey—"},{"id":"semetey-1-2013:p0937:b005:l029","ordinal":148624,"en":"Let us seize his wife."},{"id":"semetey-1-2013:p0937:b005:l030","ordinal":148625,"en":"If we contend for Aichurok,"},{"id":"semetey-1-2013:p0937:b005:l031","ordinal":148626,"en":"Let all your livestock be scattered!"},{"id":"semetey-1-2013:p0937:b005:l032","ordinal":148627,"en":"Manas's son Semetey—"},{"id":"semetey-1-2013:p0937:b005:l033","ordinal":148628,"en":"When we seize his wife,"},{"id":"semetey-1-2013:p0937:b005:l034","ordinal":148629,"en":"Will any sorrow remain in you?"},{"id":"semetey-1-2013:p0937:b005:l035","ordinal":148630,"en":"Against formidable Oogan,"},{"id":"semetey-1-2013:p0937:b005:l036","ordinal":148631,"en":"Let us wreak great havoc."},{"id":"semetey-1-2013:p0937:b005:l037","ordinal":148632,"en":"Destroyer Toltoi, hear me!"},{"id":"semetey-1-2013:p0937:b005:l038","ordinal":148633,"en":"Aichurok, swaying gracefully,"},{"id":"semetey-1-2013:p0937:b005:l039","ordinal":148634,"en":"Let us take her as a bride."},{"id":"semetey-1-2013:p0938:b003:l001","ordinal":148635,"en":"If we descend upon them and encamp,"},{"id":"semetey-1-2013:p0938:b003:l002","ordinal":148636,"en":"If they do not agree to our words,"},{"id":"semetey-1-2013:p0938:b003:l003","ordinal":148637,"en":"If he will not give his aging daughter,"},{"id":"semetey-1-2013:p0938:b003:l004","ordinal":148638,"en":"Making their willow lattice walls weep,"},{"id":"semetey-1-2013:p0938:b003:l005","ordinal":148639,"en":"Let us bring distress and turmoil;"},{"id":"semetey-1-2013:p0938:b003:l006","ordinal":148640,"en":"Let us seize her in this way."},{"id":"semetey-1-2013:p0938:b003:l007","ordinal":148641,"en":"If he will not listen to good words,"},{"id":"semetey-1-2013:p0938:b003:l008","ordinal":148642,"en":"If he will not give the girl we name,"},{"id":"semetey-1-2013:p0938:b003:l009","ordinal":148643,"en":"I have words to address to him."},{"id":"semetey-1-2013:p0938:b003:l010","ordinal":148644,"en":"The one who destroys anyone who challenges him,"},{"id":"semetey-1-2013:p0938:b003:l011","ordinal":148645,"en":"I myself, leopard Kojo, am here."},{"id":"semetey-1-2013:p0938:b003:l012","ordinal":148646,"en":"Tearing the pillars from their houses,"},{"id":"semetey-1-2013:p0938:b003:l013","ordinal":148647,"en":"Slaughtering every one of their people,"},{"id":"semetey-1-2013:p0938:b003:l014","ordinal":148648,"en":"Diverting water into their gardens,"},{"id":"semetey-1-2013:p0938:b003:l015","ordinal":148649,"en":"See how much strife I shall cause!"},{"id":"semetey-1-2013:p0938:b003:l016","ordinal":148650,"en":"I shall wage war everywhere,"},{"id":"semetey-1-2013:p0938:b003:l017","ordinal":148651,"en":"Diverting water to their poplars,"},{"id":"semetey-1-2013:p0938:b003:l018","ordinal":148652,"en":"I shall send them staggering."},{"id":"semetey-1-2013:p0938:b003:l019","ordinal":148653,"en":"Whether he gives her or not,"},{"id":"semetey-1-2013:p0938:b003:l020","ordinal":148654,"en":"I shall seize Aichurok!"},{"id":"semetey-1-2013:p0938:b003:l021","ordinal":148655,"en":"I shall bring uproar upon his settlement,"},{"id":"semetey-1-2013:p0938:b003:l022","ordinal":148656,"en":"Utterly exhausting his resources,"},{"id":"semetey-1-2013:p0938:b003:l023","ordinal":148657,"en":"In the end I shall take Churok!"},{"id":"semetey-1-2013:p0938:b003:l024","ordinal":148658,"en":"When spring draws near,"},{"id":"semetey-1-2013:p0938:b003:l025","ordinal":148659,"en":"I shall not let them ride maned fillies."},{"id":"semetey-1-2013:p0938:b003:l026","ordinal":148660,"en":"Bringing suffering and distress,"},{"id":"semetey-1-2013:p0938:b003:l027","ordinal":148661,"en":"I shall take Churok in this way."},{"id":"semetey-1-2013:p0938:b003:l028","ordinal":148662,"en":"When autumn comes,"},{"id":"semetey-1-2013:p0938:b003:l029","ordinal":148663,"en":"I shall not let them eat fat-tailed yearlings."},{"id":"semetey-1-2013:p0938:b003:l030","ordinal":148664,"en":"When spring comes,"},{"id":"semetey-1-2013:p0938:b003:l031","ordinal":148665,"en":"I shall not let them ready their yoke pins,"},{"id":"semetey-1-2013:p0938:b003:l032","ordinal":148666,"en":"Nor harness their pair of oxen,"},{"id":"semetey-1-2013:p0938:b003:l033","ordinal":148667,"en":"Nor open the face of the earth,"},{"id":"semetey-1-2013:p0938:b003:l034","ordinal":148668,"en":"Nor scatter a handful of grain."},{"id":"semetey-1-2013:p0938:b003:l035","ordinal":148669,"en":"I shall use a foul stratagem,"},{"id":"semetey-1-2013:p0938:b003:l036","ordinal":148670,"en":"I shall slaughter all their people,"},{"id":"semetey-1-2013:p0938:b003:l037","ordinal":148671,"en":"I shall make such havoc,"},{"id":"semetey-1-2013:p0938:b003:l038","ordinal":148672,"en":"And rest only when I have taken Aichurok."},{"id":"semetey-1-2013:p0938:b004:l001","ordinal":148673,"en":"Stand firm, Jediger!"},{"id":"semetey-1-2013:p0938:b004:l002","ordinal":148674,"en":"In the pleasures of this world,"},{"id":"semetey-1-2013:p0938:b004:l003","ordinal":148675,"en":"How would you like to be immersed, hero Toltoi?"},{"id":"semetey-1-2013:p0938:b004:l004","ordinal":148676,"en":"Embracing Aichurok,"},{"id":"semetey-1-2013:p0938:b004:l005","ordinal":148677,"en":"How would you like to lie, hero Toltoi?"},{"id":"semetey-1-2013:p0938:b004:l006","ordinal":148678,"en":"I am the wrinkle upon your brow!"},{"id":"semetey-1-2013:p0938:b004:l007","ordinal":148679,"en":"I have come to you from the Argyn;"},{"id":"semetey-1-2013:p0938:b004:l008","ordinal":148680,"en":"I am the good fortune upon your brow."},{"id":"semetey-1-2013:p0938:b004:l009","ordinal":148681,"en":"When I exert myself, I, Chynkojo,"},{"id":"semetey-1-2013:p0938:b004:l010","ordinal":148682,"en":"Am tempered red iron."},{"id":"semetey-1-2013:p0938:b004:l011","ordinal":148683,"en":"If hardship truly falls upon your head,"},{"id":"semetey-1-2013:p0938:b004:l012","ordinal":148684,"en":"I am a dark hill's ridge."},{"id":"semetey-1-2013:p0938:b004:l013","ordinal":148685,"en":"If you send me forward,"},{"id":"semetey-1-2013:p0938:b004:l014","ordinal":148686,"en":"I shall bring disorder upon the world."},{"id":"semetey-1-2013:p0938:b004:l015","ordinal":148687,"en":"If you heed my words,"},{"id":"semetey-1-2013:p0938:b004:l016","ordinal":148688,"en":"Over the eighteen thousand worlds"},{"id":"semetey-1-2013:p0938:b004:l017","ordinal":148689,"en":"I shall raise you as khan.\""},{"id":"semetey-1-2013:p0938:b004:l018","ordinal":148690,"en":"When he heard about Churok,"},{"id":"semetey-1-2013:p0938:b004:l019","ordinal":148691,"en":"What could dear Toltoi do?"},{"id":"semetey-1-2013:p0938:b004:l020","ordinal":148692,"en":"His fly-like soul cried out,"},{"id":"semetey-1-2013:p0938:b004:l021","ordinal":148693,"en":"His every bone seemed to shatter."},{"id":"semetey-1-2013:p0938:b004:l022","ordinal":148694,"en":"He shouted, 'Baabedin!'"},{"id":"semetey-1-2013:p0938:b004:l023","ordinal":148695,"en":"'All of you, come here!' he said,"},{"id":"semetey-1-2013:p0938:b004:l024","ordinal":148696,"en":"Calling the Jediger."},{"id":"semetey-1-2013:p0938:b004:l025","ordinal":148697,"en":"Swiftly invoking Baabedin,"},{"id":"semetey-1-2013:p0938:b004:l026","ordinal":148698,"en":"Vowing a sheep to Koroson,"},{"id":"semetey-1-2013:p0938:b004:l027","ordinal":148699,"en":"Dear Toltoi roared,"},{"id":"semetey-1-2013:p0938:b004:l028","ordinal":148700,"en":"Bellowing like a lusty stallion."},{"id":"semetey-1-2013:p0938:b004:l029","ordinal":148701,"en":"Hearing Kojo, he grew excited;"},{"id":"semetey-1-2013:p0938:b004:l030","ordinal":148702,"en":"Could poor Toltoi stand still?"},{"id":"semetey-1-2013:p0938:b004:l031","ordinal":148703,"en":"With Chynkojo urging him on,"},{"id":"semetey-1-2013:p0938:b004:l032","ordinal":148704,"en":"Would God strike Toltoi down?"},{"id":"semetey-1-2013:p0938:b004:l033","ordinal":148705,"en":"He gathered an army against the Oogans,"},{"id":"semetey-1-2013:p0938:b004:l034","ordinal":148706,"en":"An immense multitude,"},{"id":"semetey-1-2013:p0938:b004:l035","ordinal":148707,"en":"At Jeti-Ozon, the Jediger"},{"id":"semetey-1-2013:p0938:b004:l036","ordinal":148708,"en":"He gathered in full."},{"id":"semetey-1-2013:p0938:b004:l037","ordinal":148709,"en":"His complete army assembled,"},{"id":"semetey-1-2013:p0938:b004:l038","ordinal":148710,"en":"And the earth bent beneath them."},{"id":"semetey-1-2013:p0939:b004:l001","ordinal":148711,"en":"Taking up a gray-mottled banner,"},{"id":"semetey-1-2013:p0939:b004:l002","ordinal":148712,"en":"Raising cries of 'Boi-boi!'"},{"id":"semetey-1-2013:p0939:b004:l003","ordinal":148713,"en":"Jeti-Ozon stirred,"},{"id":"semetey-1-2013:p0939:b004:l004","ordinal":148714,"en":"An army beneath which the earth bent."},{"id":"semetey-1-2013:p0939:b004:l005","ordinal":148715,"en":"Tolobai, son of Tolok,"},{"id":"semetey-1-2013:p0939:b004:l006","ordinal":148716,"en":"Was commander of the lower army;"},{"id":"semetey-1-2013:p0939:b004:l007","ordinal":148717,"en":"Kalcha and Kadyrbai"},{"id":"semetey-1-2013:p0939:b004:l008","ordinal":148718,"en":"Were the finest of that great host."},{"id":"semetey-1-2013:p0939:b004:l009","ordinal":148719,"en":"When Chynkojo exerted himself,"},{"id":"semetey-1-2013:p0939:b004:l010","ordinal":148720,"en":"He was like tempered red iron."},{"id":"semetey-1-2013:p0939:b004:l011","ordinal":148721,"en":"The valorous Khan Toltoi"},{"id":"semetey-1-2013:p0939:b004:l012","ordinal":148722,"en":"Was as great as a mountain ridge."},{"id":"semetey-1-2013:p0939:b004:l013","ordinal":148723,"en":"When the two stood there, roused,"},{"id":"semetey-1-2013:p0939:b004:l014","ordinal":148724,"en":"When they thundered their commands,"},{"id":"semetey-1-2013:p0939:b004:l015","ordinal":148725,"en":"Was this a time for the great Jediger host"},{"id":"semetey-1-2013:p0939:b004:l016","ordinal":148726,"en":"To answer back?"},{"id":"semetey-1-2013:p0939:b004:l017","ordinal":148727,"en":"They swarmed like ants,"},{"id":"semetey-1-2013:p0939:b004:l018","ordinal":148728,"en":"A gray haze settled, wavering."},{"id":"semetey-1-2013:p0939:b004:l019","ordinal":148729,"en":"They had provisions prepared,"},{"id":"semetey-1-2013:p0939:b004:l020","ordinal":148730,"en":"And upon all the noble steeds"},{"id":"semetey-1-2013:p0939:b004:l021","ordinal":148731,"en":"Had yellow saddlecloths fastened."},{"id":"semetey-1-2013:p0939:b004:l022","ordinal":148732,"en":"Feeding them millet from the rice fields,"},{"id":"semetey-1-2013:p0939:b004:l023","ordinal":148733,"en":"They had them sweated daily,"},{"id":"semetey-1-2013:p0939:b004:l024","ordinal":148734,"en":"Had their spears readied,"},{"id":"semetey-1-2013:p0939:b004:l025","ordinal":148735,"en":"Had battle-axes of sharp steel prepared."},{"id":"semetey-1-2013:p0939:b004:l026","ordinal":148736,"en":"Their noble steeds with sound backs"}]
