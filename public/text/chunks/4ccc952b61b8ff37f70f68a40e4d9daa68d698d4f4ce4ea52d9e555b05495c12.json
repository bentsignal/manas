[{"id":"manas-2010:p1550:b001:l001","ordinal":66817,"en":"And encircled him now."},{"id":"manas-2010:p1550:b001:l002","ordinal":66818,"en":"From the flank, Ay Zhang-Zhung"},{"id":"manas-2010:p1550:b001:l003","ordinal":66819,"en":"Charged and thrust his lance."},{"id":"manas-2010:p1550:b001:l004","ordinal":66820,"en":"Among the massed Chinese and Manzhuu,"},{"id":"manas-2010:p1550:b001:l005","ordinal":66821,"en":"The fierce-maned leopard Almambet,"},{"id":"manas-2010:p1550:b001:l006","ordinal":66822,"en":"His face shining like the sun,"},{"id":"manas-2010:p1550:b001:l007","ordinal":66823,"en":"Remained encircled now."},{"id":"manas-2010:p1550:b001:l008","ordinal":66824,"en":"Sarala beneath him"},{"id":"manas-2010:p1550:b001:l009","ordinal":66825,"en":"Did not stumble or falter;"},{"id":"manas-2010:p1550:b001:l010","ordinal":66826,"en":"Azizkhan's only son"},{"id":"manas-2010:p1550:b001:l011","ordinal":66827,"en":"Did not stir when a lance struck."},{"id":"manas-2010:p1550:b001:l012","ordinal":66828,"en":"The lances striking from every side"},{"id":"manas-2010:p1550:b001:l013","ordinal":66829,"en":"He shattered with his sword."},{"id":"manas-2010:p1550:b001:l014","ordinal":66830,"en":"When the opening came,"},{"id":"manas-2010:p1550:b001:l015","ordinal":66831,"en":"He struck their heads off sideways;"},{"id":"manas-2010:p1550:b001:l016","ordinal":66832,"en":"He went on felling the Chinese."},{"id":"manas-2010:p1550:b001:l017","ordinal":66833,"en":"The Manzhuu farther away"},{"id":"manas-2010:p1550:b001:l018","ordinal":66834,"en":"He felled with his lance."},{"id":"manas-2010:p1550:b001:l019","ordinal":66835,"en":"Those who kept farther still"},{"id":"manas-2010:p1550:b001:l020","ordinal":66836,"en":"He shot with his lacquered musket."},{"id":"manas-2010:p1550:b001:l021","ordinal":66837,"en":"With dust hiding the earth,"},{"id":"manas-2010:p1550:b001:l022","ordinal":66838,"en":"He fought alone"},{"id":"manas-2010:p1550:b001:l023","ordinal":66839,"en":"Against the Chinese multitude."},{"id":"manas-2010:p1550:b001:l024","ordinal":66840,"en":"Breaking through the Chinese,"},{"id":"manas-2010:p1550:b001:l025","ordinal":66841,"en":"Leaning upon Sarala,"},{"id":"manas-2010:p1550:b001:l026","ordinal":66842,"en":"Not a sound patch left upon his body,"},{"id":"manas-2010:p1550:b001:l027","ordinal":66843,"en":"He was bathed in dark blood."},{"id":"manas-2010:p1550:b001:l028","ordinal":66844,"en":"When Almambet was in such a plight,"},{"id":"manas-2010:p1550:b001:l029","ordinal":66845,"en":"When the Chinese were sweeping upon him,"},{"id":"manas-2010:p1550:b001:l030","ordinal":66846,"en":"A shout arose then."},{"id":"manas-2010:p1550:b001:l031","ordinal":66847,"en":"The Chinese people's Kongurbay—"},{"id":"manas-2010:p1550:b001:l032","ordinal":66848,"en":"Before even that moment passed,"},{"id":"manas-2010:p1550:b001:l033","ordinal":66849,"en":"Akbaltay's Chubak"},{"id":"manas-2010:p1550:b001:l034","ordinal":66850,"en":"And Ulak Khan's Syrgak said,"},{"id":"manas-2010:p1550:b001:l035","ordinal":66851,"en":"“If we flee without turning back,"},{"id":"manas-2010:p1550:b001:l036","ordinal":66852,"en":"What aim will we achieve?"},{"id":"manas-2010:p1550:b001:l037","ordinal":66853,"en":"Our leopard-born Alma,"},{"id":"manas-2010:p1550:b001:l038","ordinal":66854,"en":"How can we abandon him?”"},{"id":"manas-2010:p1550:b001:l039","ordinal":66855,"en":"The two heroes hurried."},{"id":"manas-2010:p1550:b001:l040","ordinal":66856,"en":"“If the Chinese press and overwhelm him,"},{"id":"manas-2010:p1550:b001:l041","ordinal":66857,"en":"Keen, fierce-maned Almambet"},{"id":"manas-2010:p1550:b001:l042","ordinal":66858,"en":"May suddenly fall,” they said."},{"id":"manas-2010:p1551:b001:l001","ordinal":66859,"en":"“If he falls into Chinese hands,"},{"id":"manas-2010:p1551:b001:l002","ordinal":66860,"en":"A needless death will overtake him;"},{"id":"manas-2010:p1551:b001:l003","ordinal":66861,"en":"God will strike us,"},{"id":"manas-2010:p1551:b001:l004","ordinal":66862,"en":"The Buruts' backbone will break."},{"id":"manas-2010:p1551:b001:l005","ordinal":66863,"en":"Let us reach Almambet,"},{"id":"manas-2010:p1551:b001:l006","ordinal":66864,"en":"Let us rescue him!”"},{"id":"manas-2010:p1551:b001:l007","ordinal":66865,"en":"Thus the two heroes spoke."},{"id":"manas-2010:p1551:b001:l008","ordinal":66866,"en":"They loosened their horses' reins;"},{"id":"manas-2010:p1551:b001:l009","ordinal":66867,"en":"To reach Almambet,"},{"id":"manas-2010:p1551:b001:l010","ordinal":66868,"en":"They cried, “Go!” and raced."},{"id":"manas-2010:p1551:b001:l011","ordinal":66869,"en":"Raising their voices in the cry, “Manas!”"},{"id":"manas-2010:p1551:b001:l012","ordinal":66870,"en":"Against Manzhuu and Chinese"},{"id":"manas-2010:p1551:b001:l013","ordinal":66871,"en":"They attacked without stopping."},{"id":"manas-2010:p1551:b001:l014","ordinal":66872,"en":"As they held Almambet fast,"},{"id":"manas-2010:p1551:b001:l015","ordinal":66873,"en":"Standing in a circle around him,"},{"id":"manas-2010:p1551:b001:l016","ordinal":66874,"en":"The lions entered among them."},{"id":"manas-2010:p1551:b001:l017","ordinal":66875,"en":"Of the red-tasseled Chinese,"},{"id":"manas-2010:p1551:b001:l018","ordinal":66876,"en":"They shattered the strongest,"},{"id":"manas-2010:p1551:b001:l019","ordinal":66877,"en":"Made those they met crawl,"},{"id":"manas-2010:p1551:b001:l020","ordinal":66878,"en":"Thrust once at those they faced,"},{"id":"manas-2010:p1551:b001:l021","ordinal":66879,"en":"Made lances play within hearts."},{"id":"manas-2010:p1551:b001:l022","ordinal":66880,"en":"Azizkhan's Almambet,"},{"id":"manas-2010:p1551:b001:l023","ordinal":66881,"en":"When he saw these men,"},{"id":"manas-2010:p1551:b001:l024","ordinal":66882,"en":"Took them as support and girded himself,"},{"id":"manas-2010:p1551:b001:l025","ordinal":66883,"en":"Gathered courage and renewed his strength."},{"id":"manas-2010:p1551:b001:l026","ordinal":66884,"en":"Almambet entered from one side,"},{"id":"manas-2010:p1551:b001:l027","ordinal":66885,"en":"“Grant it!” he cried, calling upon God."},{"id":"manas-2010:p1551:b001:l028","ordinal":66886,"en":"He entered among them, fighting."},{"id":"manas-2010:p1551:b001:l029","ordinal":66887,"en":"Almambet, Chubak and brave Syrgak"},{"id":"manas-2010:p1551:b001:l030","ordinal":66888,"en":"Raced into their midst."},{"id":"manas-2010:p1551:b001:l031","ordinal":66889,"en":"Battle-axes and swords"},{"id":"manas-2010:p1551:b001:l032","ordinal":66890,"en":"They swung back and forth."},{"id":"manas-2010:p1551:b001:l033","ordinal":66891,"en":"Scarlet blood flowed;"},{"id":"manas-2010:p1551:b001:l034","ordinal":66892,"en":"Vast numbers lay there."},{"id":"manas-2010:p1551:b001:l035","ordinal":66893,"en":"Their lives gone, doubled over,"},{"id":"manas-2010:p1551:b001:l036","ordinal":66894,"en":"The countless Chinese multitude"},{"id":"manas-2010:p1551:b001:l037","ordinal":66895,"en":"Was slaughtered in countless numbers."},{"id":"manas-2010:p1551:b001:l038","ordinal":66896,"en":"Black vultures and griffon vultures"},{"id":"manas-2010:p1551:b001:l039","ordinal":66897,"en":"Above the bodies of the dead"},{"id":"manas-2010:p1551:b001:l040","ordinal":66898,"en":"Gathered, spreading wide."},{"id":"manas-2010:p1551:b001:l041","ordinal":66899,"en":"The Chinese people's Kün Zhang-Zhung"},{"id":"manas-2010:p1551:b001:l042","ordinal":66900,"en":"Was himself a mighty hero."},{"id":"manas-2010:p1552:b001:l001","ordinal":66901,"en":"Except for his unbelief,"},{"id":"manas-2010:p1552:b001:l002","ordinal":66902,"en":"He was a lion surpassing the Chinese."},{"id":"manas-2010:p1552:b001:l003","ordinal":66903,"en":"As he shouted and arrived like a bullet,"},{"id":"manas-2010:p1552:b001:l004","ordinal":66904,"en":"From Sarala's back,"},{"id":"manas-2010:p1552:b001:l005","ordinal":66905,"en":"Precious Almambet"},{"id":"manas-2010:p1552:b001:l006","ordinal":66906,"en":"He was about to thrust down."},{"id":"manas-2010:p1552:b001:l007","ordinal":66907,"en":"Sending Kögala racing,"},{"id":"manas-2010:p1552:b001:l008","ordinal":66908,"en":"The seasoned hero Chubak"},{"id":"manas-2010:p1552:b001:l009","ordinal":66909,"en":"Charged from the flank"},{"id":"manas-2010:p1552:b001:l010","ordinal":66910,"en":"And reached Kün Zhang-Zhung."},{"id":"manas-2010:p1552:b001:l011","ordinal":66911,"en":"As soon as he arrived, brave Chubak"},{"id":"manas-2010:p1552:b001:l012","ordinal":66912,"en":"That mountain-sized Zhang-Zhung"},{"id":"manas-2010:p1552:b001:l013","ordinal":66913,"en":"Thrust down and passed."},{"id":"manas-2010:p1552:b001:l014","ordinal":66914,"en":"Unable to stand firm, the Chinese multitude"},{"id":"manas-2010:p1552:b001:l015","ordinal":66915,"en":"Split apart with cries."},{"id":"manas-2010:p1552:b001:l016","ordinal":66916,"en":"When Zhang-Zhung fell,"},{"id":"manas-2010:p1552:b001:l017","ordinal":66917,"en":"Before the fleet-footed Chinese could arrive,"},{"id":"manas-2010:p1552:b001:l018","ordinal":66918,"en":"Toward their champion Kün Zhang-Zhung,"},{"id":"manas-2010:p1552:b001:l019","ordinal":66919,"en":"The devoted comrade who spared no life"},{"id":"manas-2010:p1552:b001:l020","ordinal":66920,"en":"Arrived like a falcon:"},{"id":"manas-2010:p1552:b001:l021","ordinal":66921,"en":"Syrgak, his companion in soul."},{"id":"manas-2010:p1552:b001:l022","ordinal":66922,"en":"Upon arriving, Arkesken"},{"id":"manas-2010:p1552:b001:l023","ordinal":66923,"en":"He grasped by the hilt,"},{"id":"manas-2010:p1552:b001:l024","ordinal":66924,"en":"Drew it from its sheath,"},{"id":"manas-2010:p1552:b001:l025","ordinal":66925,"en":"And cut his head off."},{"id":"manas-2010:p1552:b001:l026","ordinal":66926,"en":"Cotton sash and broad boots,"},{"id":"manas-2010:p1552:b001:l027","ordinal":66927,"en":"He went grieving and bellowing,"},{"id":"manas-2010:p1552:b001:l028","ordinal":66928,"en":"Kongurbay, khan of the shaven priests."},{"id":"manas-2010:p1552:b001:l029","ordinal":66929,"en":"“Kün Zhang-Zhung has died!”"},{"id":"manas-2010:p1552:b001:l030","ordinal":66930,"en":"He sent word to his khan,"},{"id":"manas-2010:p1552:b001:l031","ordinal":66931,"en":"To the city of Kakanchyn."},{"id":"manas-2010:p1552:b001:l032","ordinal":66932,"en":"When they heard this news,"},{"id":"manas-2010:p1552:b001:l033","ordinal":66933,"en":"The Chinese poured forth and swept upon them."},{"id":"manas-2010:p1552:b001:l034","ordinal":66934,"en":"Their champions separated out,"},{"id":"manas-2010:p1552:b001:l035","ordinal":66935,"en":"Kongurbay loomed like a mountain;"},{"id":"manas-2010:p1552:b001:l036","ordinal":66936,"en":"Pleading with their Buddha,"},{"id":"manas-2010:p1552:b001:l037","ordinal":66937,"en":"The Chinese swarmed without breaking ranks."},{"id":"manas-2010:p1552:b001:l038","ordinal":66938,"en":"Seeing them swarm,"},{"id":"manas-2010:p1552:b001:l039","ordinal":66939,"en":"The three champions who were fighting"},{"id":"manas-2010:p1552:b001:l040","ordinal":66940,"en":"Now despaired of their lives."},{"id":"manas-2010:p1552:b001:l041","ordinal":66941,"en":"They had no support to lean upon;"},{"id":"manas-2010:p1552:b001:l042","ordinal":66942,"en":"Their famed lion Manas was absent."},{"id":"manas-2010:p1553:b001:l001","ordinal":66943,"en":"“The Muslims we relied upon,"},{"id":"manas-2010:p1553:b001:l002","ordinal":66944,"en":"The people of twelve khans, are absent."},{"id":"manas-2010:p1553:b001:l003","ordinal":66945,"en":"The Chinese will show us a spectacle, it seems!"},{"id":"manas-2010:p1553:b001:l004","ordinal":66946,"en":"When our horses grow exhausted,"},{"id":"manas-2010:p1553:b001:l005","ordinal":66947,"en":"If the Chinese take the notion,"},{"id":"manas-2010:p1553:b001:l006","ordinal":66948,"en":"They will capture us alive, it seems!"},{"id":"manas-2010:p1553:b001:l007","ordinal":66949,"en":"Slaughtering without cease,"},{"id":"manas-2010:p1553:b001:l008","ordinal":66950,"en":"Those Chinese people are hellish."},{"id":"manas-2010:p1553:b001:l009","ordinal":66951,"en":"Fleeing Beijing without a pause,"},{"id":"manas-2010:p1553:b001:l010","ordinal":66952,"en":"I am the one who suffered much."},{"id":"manas-2010:p1553:b001:l011","ordinal":66953,"en":"Gaining no good from the Chinese,"},{"id":"manas-2010:p1553:b001:l012","ordinal":66954,"en":"Let us draw back."},{"id":"manas-2010:p1553:b001:l013","ordinal":66955,"en":"Showing courage against the Chinese,"},{"id":"manas-2010:p1553:b001:l014","ordinal":66956,"en":"Let us fight a dog's running fight!"},{"id":"manas-2010:p1553:b001:l015","ordinal":66957,"en":"Those of you left after the deaths,"},{"id":"manas-2010:p1553:b001:l016","ordinal":66958,"en":"Make your way to Talas."},{"id":"manas-2010:p1553:b001:l017","ordinal":66959,"en":"‘We suffered humiliation,’"},{"id":"manas-2010:p1553:b001:l018","ordinal":66960,"en":"Go and tell Manas!”"},{"id":"manas-2010:p1553:b001:l019","ordinal":66961,"en":"Thus he spoke these words."},{"id":"manas-2010:p1553:b001:l020","ordinal":66962,"en":"Almambet and Syrgak, the noble lions,"},{"id":"manas-2010:p1553:b001:l021","ordinal":66963,"en":"Fierce-maned Chubak, the surpassing hero,"},{"id":"manas-2010:p1553:b001:l022","ordinal":66964,"en":"Began to draw back."},{"id":"manas-2010:p1553:b001:l023","ordinal":66965,"en":"As brave Chubak fled,"},{"id":"manas-2010:p1553:b001:l024","ordinal":66966,"en":"Almambet stayed and fought;"},{"id":"manas-2010:p1553:b001:l025","ordinal":66967,"en":"As Almambet began to withdraw,"},{"id":"manas-2010:p1553:b001:l026","ordinal":66968,"en":"Syrgak stayed and fought;"},{"id":"manas-2010:p1553:b001:l027","ordinal":66969,"en":"As Syrgak began to withdraw,"},{"id":"manas-2010:p1553:b001:l028","ordinal":66970,"en":"Chubak entered and fought."},{"id":"manas-2010:p1553:b001:l029","ordinal":66971,"en":"Seeing Chubak, Kongurbay"},{"id":"manas-2010:p1553:b001:l030","ordinal":66972,"en":"Swept upon him in earnest."},{"id":"manas-2010:p1553:b001:l031","ordinal":66973,"en":"The spearmen in one group,"},{"id":"manas-2010:p1553:b001:l032","ordinal":66974,"en":"The swordsmen in another,"},{"id":"manas-2010:p1553:b001:l033","ordinal":66975,"en":"All the strongest"},{"id":"manas-2010:p1553:b001:l034","ordinal":66976,"en":"Poured over in throngs."},{"id":"manas-2010:p1553:b001:l035","ordinal":66977,"en":"One could not tell them from crawling insects:"},{"id":"manas-2010:p1553:b001:l036","ordinal":66978,"en":"The Chinese came teeming."},{"id":"manas-2010:p1553:b001:l037","ordinal":66979,"en":"The Fierce One raised the tumult;"},{"id":"manas-2010:p1553:b001:l038","ordinal":66980,"en":"Sending Kögala surging,"},{"id":"manas-2010:p1553:b001:l039","ordinal":66981,"en":"Chubak raised the tumult."},{"id":"manas-2010:p1553:b001:l040","ordinal":66982,"en":"With Khan Kongurbay at their head,"},{"id":"manas-2010:p1553:b001:l041","ordinal":66983,"en":"Almambet, Chubak and Syrgak,"},{"id":"manas-2010:p1553:b001:l042","ordinal":66984,"en":"The massed Chinese and many Manzhuu"},{"id":"manas-2010:p1554:b001:l001","ordinal":66985,"en":"Swept up and drove along."},{"id":"manas-2010:p1554:b001:l002","ordinal":66986,"en":"On the moon-flat plain,"},{"id":"manas-2010:p1554:b001:l003","ordinal":66987,"en":"For seven days, brave Chubak"},{"id":"manas-2010:p1554:b001:l004","ordinal":66988,"en":"Had fought alone."},{"id":"manas-2010:p1554:b001:l005","ordinal":66989,"en":"Both his arms numbed,"},{"id":"manas-2010:p1554:b001:l006","ordinal":66990,"en":"Akbaltay's Chubak"},{"id":"manas-2010:p1554:b001:l007","ordinal":66991,"en":"Drew back."},{"id":"manas-2010:p1554:b001:l008","ordinal":66992,"en":"From the spur where the mountain ended,"},{"id":"manas-2010:p1554:b001:l009","ordinal":66993,"en":"From a rounded dark promontory,"},{"id":"manas-2010:p1554:b001:l010","ordinal":66994,"en":"Shining as though touched by moonlight,"},{"id":"manas-2010:p1554:b001:l011","ordinal":66995,"en":"Thundering like a lion,"},{"id":"manas-2010:p1554:b001:l012","ordinal":66996,"en":"Almambet stood to meet them."},{"id":"manas-2010:p1554:b001:l013","ordinal":66997,"en":"When Chubak darted off,"},{"id":"manas-2010:p1554:b001:l014","ordinal":66998,"en":"When the Chinese pressed hard in pursuit,"},{"id":"manas-2010:p1554:b001:l015","ordinal":66999,"en":"Khan Kongurbay and Ay Zhang-Zhung"},{"id":"manas-2010:p1554:b001:l016","ordinal":67000,"en":"Drove the army in a surging mass,"},{"id":"manas-2010:p1554:b001:l017","ordinal":67001,"en":"Drove all the army together,"},{"id":"manas-2010:p1554:b001:l018","ordinal":67002,"en":"Charged in a frenzy."},{"id":"manas-2010:p1554:b001:l019","ordinal":67003,"en":"Kongurbay, khan of the shaven priests,"},{"id":"manas-2010:p1554:b001:l020","ordinal":67004,"en":"Reached Almambet now."},{"id":"manas-2010:p1554:b001:l021","ordinal":67005,"en":"Upon Almambet,"},{"id":"manas-2010:p1554:b001:l022","ordinal":67006,"en":"Skilled horsemen and fleet-footed runners"},{"id":"manas-2010:p1554:b001:l023","ordinal":67007,"en":"All swept together."},{"id":"manas-2010:p1554:b001:l024","ordinal":67008,"en":"Sarala with cowlike lean haunches"},{"id":"manas-2010:p1554:b001:l025","ordinal":67009,"en":"He wheeled about with a shout;"},{"id":"manas-2010:p1554:b001:l026","ordinal":67010,"en":"Almambet went slaughtering."},{"id":"manas-2010:p1554:b001:l027","ordinal":67011,"en":"Not glancing at those slaughtered,"},{"id":"manas-2010:p1554:b001:l028","ordinal":67012,"en":"The Chinese now made a spectacle."},{"id":"manas-2010:p1554:b001:l029","ordinal":67013,"en":"Drawing bows, sending arrows like rain,"},{"id":"manas-2010:p1554:b001:l030","ordinal":67014,"en":"Zhang-Zhung entered from one side;"},{"id":"manas-2010:p1554:b001:l031","ordinal":67015,"en":"Firing shots like hail,"},{"id":"manas-2010:p1554:b001:l032","ordinal":67016,"en":"The Manzhuu entered from one side;"},{"id":"manas-2010:p1554:b001:l033","ordinal":67017,"en":"Shouting their battle-cry defiantly,"},{"id":"manas-2010:p1554:b001:l034","ordinal":67018,"en":"The Kalmyks entered from one side."},{"id":"manas-2010:p1554:b001:l035","ordinal":67019,"en":"Shibee and Soloon, the two tribes,"},{"id":"manas-2010:p1554:b001:l036","ordinal":67020,"en":"Also swept in from one side."},{"id":"manas-2010:p1554:b001:l037","ordinal":67021,"en":"Tyrgoot and Kara-Kytay,"},{"id":"manas-2010:p1554:b001:l038","ordinal":67022,"en":"The Great Beijing of Kakanchyn,"},{"id":"manas-2010:p1554:b001:l039","ordinal":67023,"en":"Fought a fierce battle."},{"id":"manas-2010:p1554:b001:l040","ordinal":67024,"en":"All their warriors"},{"id":"manas-2010:p1554:b001:l041","ordinal":67025,"en":"Thrust lances from every side."},{"id":"manas-2010:p1554:b001:l042","ordinal":67026,"en":"Running without a backward glance,"},{"id":"manas-2010:p1555:b001:l001","ordinal":67027,"en":"Pressure fell upon him;"},{"id":"manas-2010:p1555:b001:l002","ordinal":67028,"en":"He greatly despaired of his life."},{"id":"manas-2010:p1555:b001:l003","ordinal":67029,"en":"Sarala stood with narrowed eyes;"},{"id":"manas-2010:p1555:b001:l004","ordinal":67030,"en":"Your Alma, still fighting,"},{"id":"manas-2010:p1555:b001:l005","ordinal":67031,"en":"Was struck by many lances at once."},{"id":"manas-2010:p1555:b001:l006","ordinal":67032,"en":"Leaning upon the white saddle,"},{"id":"manas-2010:p1555:b001:l007","ordinal":67033,"en":"Dear Alma stood swaying."},{"id":"manas-2010:p1555:b001:l008","ordinal":67034,"en":"Not yielding to those who shot at him,"},{"id":"manas-2010:p1555:b001:l009","ordinal":67035,"en":"Your seasoned lion,"},{"id":"manas-2010:p1555:b001:l010","ordinal":67036,"en":"Not letting those who struck bring him down,"},{"id":"manas-2010:p1555:b001:l011","ordinal":67037,"en":"Never tiring of battle,"},{"id":"manas-2010:p1555:b001:l012","ordinal":67038,"en":"Without looking all around,"},{"id":"manas-2010:p1555:b001:l013","ordinal":67039,"en":"The footmen who came shouting"},{"id":"manas-2010:p1555:b001:l014","ordinal":67040,"en":"He slaughtered without mercy."},{"id":"manas-2010:p1555:b001:l015","ordinal":67041,"en":"After nine days in their midst,"},{"id":"manas-2010:p1555:b001:l016","ordinal":67042,"en":"Almambet came out covered in blood,"},{"id":"manas-2010:p1555:b001:l017","ordinal":67043,"en":"Numb, unable to move,"},{"id":"manas-2010:p1555:b001:l018","ordinal":67044,"en":"Wounded in ninety places."},{"id":"manas-2010:p1555:b001:l019","ordinal":67045,"en":"Turning across, he darted away."},{"id":"manas-2010:p1555:b001:l020","ordinal":67046,"en":"After seeing the Chinese array,"},{"id":"manas-2010:p1555:b001:l021","ordinal":67047,"en":"Pressure fell upon his head."},{"id":"manas-2010:p1555:b001:l022","ordinal":67048,"en":"Cotton sash and broad boots,"},{"id":"manas-2010:p1555:b001:l023","ordinal":67049,"en":"Kongurbay, khan of the shaven priests,"},{"id":"manas-2010:p1555:b001:l024","ordinal":67050,"en":"Pursued without a care."},{"id":"manas-2010:p1555:b001:l025","ordinal":67051,"en":"From their mines where gold was dug,"},{"id":"manas-2010:p1555:b001:l026","ordinal":67052,"en":"From their land where tea was gathered,"},{"id":"manas-2010:p1555:b001:l027","ordinal":67053,"en":"When their fury rose,"},{"id":"manas-2010:p1555:b001:l028","ordinal":67054,"en":"The massed Chinese and many Manzhuu,"},{"id":"manas-2010:p1555:b001:l029","ordinal":67055,"en":"At the ridge over which they would sweep,"},{"id":"manas-2010:p1555:b001:l030","ordinal":67056,"en":"Was he not standing to meet them?"},{"id":"manas-2010:p1555:b001:l031","ordinal":67057,"en":"“I risk all!” cried brave Syrgak,"},{"id":"manas-2010:p1555:b001:l032","ordinal":67058,"en":"At just such a place."},{"id":"manas-2010:p1555:b001:l033","ordinal":67059,"en":"As though a dark spirit afflicted his wife,"},{"id":"manas-2010:p1555:b001:l034","ordinal":67060,"en":"As though his prey fled close ahead,"},{"id":"manas-2010:p1555:b001:l035","ordinal":67061,"en":"His spectacles gleaming,"},{"id":"manas-2010:p1555:b001:l036","ordinal":67062,"en":"The flask-sized bead-stone"},{"id":"manas-2010:p1555:b001:l037","ordinal":67063,"en":"Flashing upon his head,"},{"id":"manas-2010:p1555:b001:l038","ordinal":67064,"en":"As though to heap tumult upon him,"},{"id":"manas-2010:p1555:b001:l039","ordinal":67065,"en":"He pursued Almambet,"},{"id":"manas-2010:p1555:b001:l040","ordinal":67066,"en":"As though to spear him on the plain."},{"id":"manas-2010:p1555:b001:l041","ordinal":67067,"en":"Then Syrgak, the precious lion,"},{"id":"manas-2010:p1555:b001:l042","ordinal":67068,"en":"The precious hero who did not despair,"},{"id":"manas-2010:p1556:b001:l001","ordinal":67069,"en":"Loosened Kökchebich's reins"},{"id":"manas-2010:p1556:b001:l002","ordinal":67070,"en":"And raised the battle-cry, “Manas!”"},{"id":"manas-2010:p1556:b001:l003","ordinal":67071,"en":"The Fierce One who came pursuing,"},{"id":"manas-2010:p1556:b001:l004","ordinal":67072,"en":"From his flank, brave Syrgak"}]
