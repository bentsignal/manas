{"id": "sayakbay-ms-current146:pdf029:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 29, "folio": 412, "line_in_page": 25, "raw": "Кабак кагып койгондо,", "text": "Кабак кагып койгондо,", "en": "When he merely knit his brow,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
