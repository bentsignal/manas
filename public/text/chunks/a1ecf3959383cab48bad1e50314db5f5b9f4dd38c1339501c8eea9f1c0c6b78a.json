[{"id":"seytek-2012:p1127:b002:l034","ordinal":382209,"en":"Shouted and leveled their spears,"},{"id":"seytek-2012:p1127:b002:l035","ordinal":382210,"en":"He would not reckon them equal to his boot-tip."},{"id":"seytek-2012:p1127:b002:l036","ordinal":382211,"en":"His tiger nature showed;"},{"id":"seytek-2012:p1127:b002:l037","ordinal":382212,"en":"When he saw Chonbilgich,"},{"id":"seytek-2012:p1127:b002:l038","ordinal":382213,"en":"He laughed in eager delight."},{"id":"seytek-2012:p1127:b002:l039","ordinal":382214,"en":"Without fuss, Akjoltoy"},{"id":"seytek-2012:p1127:b002:l040","ordinal":382215,"en":"Fought with measured force—"},{"id":"seytek-2012:p1127:b003:l001","ordinal":382216,"en":"Who had ever seen such a deed?"},{"id":"seytek-2012:p1127:b003:l002","ordinal":382217,"en":"The mountain-like steed Külansur"},{"id":"seytek-2012:p1127:b003:l003","ordinal":382218,"en":"Halted and turned its head."},{"id":"seytek-2012:p1127:b003:l004","ordinal":382219,"en":"Your Joltoy, who came alone from the host,"},{"id":"seytek-2012:p1127:b003:l005","ordinal":382220,"en":"Reached the feather-grass plain;"},{"id":"seytek-2012:p1127:b003:l006","ordinal":382221,"en":"No dust rose beneath him"},{"id":"seytek-2012:p1127:b003:l007","ordinal":382222,"en":"Where the earth itself seemed to speak,"},{"id":"seytek-2012:p1127:b003:l008","ordinal":382223,"en":"And now the mountain-like Külansur"},{"id":"seytek-2012:p1127:b003:l009","ordinal":382224,"en":"Was reined in and turned."},{"id":"seytek-2012:p1127:b003:l010","ordinal":382225,"en":"Rejoicing at the word “foe,”"},{"id":"seytek-2012:p1127:b003:l011","ordinal":382226,"en":"Clad entirely in iron,"},{"id":"seytek-2012:p1127:b003:l012","ordinal":382227,"en":"He chose a steel-tipped spear,"},{"id":"seytek-2012:p1127:b003:l013","ordinal":382228,"en":"And girded on his naked sword."},{"id":"seytek-2012:p1127:b003:l014","ordinal":382229,"en":"Wearing ninety robes of silk,"},{"id":"seytek-2012:p1127:b003:l015","ordinal":382230,"en":"Hero Joltoy said, “I trust in fate.”"},{"id":"seytek-2012:p1127:b003:l016","ordinal":382231,"en":"Hero Bilgich was huge as a mountain,"},{"id":"seytek-2012:p1127:b003:l017","ordinal":382232,"en":"A fortress sprung from Beijing,"},{"id":"seytek-2012:p1127:b003:l018","ordinal":382233,"en":"A hero of immeasurable might."},{"id":"seytek-2012:p1127:b003:l019","ordinal":382234,"en":"Ninety beasts were slaughtered at his feast;"},{"id":"seytek-2012:p1127:b003:l020","ordinal":382235,"en":"Orphaned of his father at six months,"},{"id":"seytek-2012:p1127:b003:l021","ordinal":382236,"en":"He was given the name Bilgich."},{"id":"seytek-2012:p1127:b003:l022","ordinal":382237,"en":"He had slain head-shaking giants,"},{"id":"seytek-2012:p1127:b003:l023","ordinal":382238,"en":"And crushed armies on the march,"},{"id":"seytek-2012:p1127:b003:l024","ordinal":382239,"en":"Proving the lion in his valor;"},{"id":"seytek-2012:p1127:b003:l025","ordinal":382240,"en":"Throughout Beijing, he brought the lands"},{"id":"seytek-2012:p1127:b003:l026","ordinal":382241,"en":"Of forty khans beneath a single will."},{"id":"seytek-2012:p1127:b003:l027","ordinal":382242,"en":"He became master of Kakanchin"},{"id":"seytek-2012:p1127:b003:l028","ordinal":382243,"en":"And a giant to the whole world."},{"id":"seytek-2012:p1127:b003:l029","ordinal":382244,"en":"His menace was one thing, his venom fierce;"},{"id":"seytek-2012:p1127:b003:l030","ordinal":382245,"en":"When he roared, even a dark-hearted man"},{"id":"seytek-2012:p1127:b003:l031","ordinal":382246,"en":"Despaired of life, crying, “I am dead!”"},{"id":"seytek-2012:p1127:b003:l032","ordinal":382247,"en":"His mustache bristled hair by hair,"},{"id":"seytek-2012:p1127:b003:l033","ordinal":382248,"en":"His many peoples gathered in one place."},{"id":"seytek-2012:p1127:b003:l034","ordinal":382249,"en":"Here was courage, here was the lion;"},{"id":"seytek-2012:p1127:b003:l035","ordinal":382250,"en":"Akjoltoy was his opponent,"},{"id":"seytek-2012:p1127:b003:l036","ordinal":382251,"en":"And this was where Bilgich had come."},{"id":"seytek-2012:p1127:b003:l037","ordinal":382252,"en":"When he saw the hero Akjoltoy,"},{"id":"seytek-2012:p1127:b003:l038","ordinal":382253,"en":"He began a savage quarrel,"},{"id":"seytek-2012:p1127:b003:l039","ordinal":382254,"en":"Raging and roaring,"},{"id":"seytek-2012:p1127:b003:l040","ordinal":382255,"en":"As though to crush heaven and earth,"},{"id":"seytek-2012:p1128:b002:l001","ordinal":382256,"en":"And anyone who witnessed his fury"},{"id":"seytek-2012:p1128:b002:l002","ordinal":382257,"en":"Was left feeling swallowed whole."},{"id":"seytek-2012:p1128:b002:l003","ordinal":382258,"en":"He roared in menace,"},{"id":"seytek-2012:p1128:b002:l004","ordinal":382259,"en":"Like the lion of the divided mountains,"},{"id":"seytek-2012:p1128:b002:l005","ordinal":382260,"en":"Bellowing like a lion."},{"id":"seytek-2012:p1128:b002:l006","ordinal":382261,"en":"He struck the royal war drum,"},{"id":"seytek-2012:p1128:b002:l007","ordinal":382262,"en":"Sounding the signal,"},{"id":"seytek-2012:p1128:b002:l008","ordinal":382263,"en":"Then whipped his great rhinoceros mount"},{"id":"seytek-2012:p1128:b002:l009","ordinal":382264,"en":"And rode out onto the battlefield."},{"id":"seytek-2012:p1128:b002:l010","ordinal":382265,"en":"“Akjoltoy of the Kyrgyz,"},{"id":"seytek-2012:p1128:b002:l011","ordinal":382266,"en":"Your tongue speaks a babbling speech;"},{"id":"seytek-2012:p1128:b002:l012","ordinal":382267,"en":"In your heart, you are my enemy."},{"id":"seytek-2012:p1128:b002:l013","ordinal":382268,"en":"If my strength fails and leaves me,"},{"id":"seytek-2012:p1128:b002:l014","ordinal":382269,"en":"I shall meet my death at your hands;"},{"id":"seytek-2012:p1128:b002:l015","ordinal":382270,"en":"But if my strength is enough,"},{"id":"seytek-2012:p1128:b002:l016","ordinal":382271,"en":"I shall hew your borders into countless pieces."},{"id":"seytek-2012:p1128:b002:l017","ordinal":382272,"en":"If I fight in wrath,"},{"id":"seytek-2012:p1128:b002:l018","ordinal":382273,"en":"I shall scatter your honor like ashes;"},{"id":"seytek-2012:p1128:b002:l019","ordinal":382274,"en":"And if rage seizes me again,"},{"id":"seytek-2012:p1128:b002:l020","ordinal":382275,"en":"I shall rip apart your ribs."},{"id":"seytek-2012:p1128:b002:l021","ordinal":382276,"en":"If my strength fails and leaves me,"},{"id":"seytek-2012:p1128:b002:l022","ordinal":382277,"en":"I shall depart this world;"},{"id":"seytek-2012:p1128:b002:l023","ordinal":382278,"en":"But I shall tell Jadygoy,"},{"id":"seytek-2012:p1128:b002:l024","ordinal":382279,"en":"‘I came and destroyed the Buruts,"},{"id":"seytek-2012:p1128:b002:l025","ordinal":382280,"en":"And delivered the punishment"},{"id":"seytek-2012:p1128:b002:l026","ordinal":382281,"en":"Of all the black Kyrgyz into his hands.’"},{"id":"seytek-2012:p1128:b002:l027","ordinal":382282,"en":"I shall ride to Kakanchin, saying,"},{"id":"seytek-2012:p1128:b002:l028","ordinal":382283,"en":"‘I slaughtered the Buruts.’"},{"id":"seytek-2012:p1128:b002:l029","ordinal":382284,"en":"When my wild rage seizes me—"},{"id":"seytek-2012:p1128:b002:l030","ordinal":382285,"en":"And now my fury has risen—"},{"id":"seytek-2012:p1128:b002:l031","ordinal":382286,"en":"You mother-forsaken wretched Burut,"},{"id":"seytek-2012:p1128:b002:l032","ordinal":382287,"en":"I shall awaken your ancient madness."},{"id":"seytek-2012:p1128:b002:l033","ordinal":382288,"en":"Let one of you come, or let a thousand come;"},{"id":"seytek-2012:p1128:b002:l034","ordinal":382289,"en":"You snarling madmen,"},{"id":"seytek-2012:p1128:b002:l035","ordinal":382290,"en":"Let all your strongest heroes come."},{"id":"seytek-2012:p1128:b002:l036","ordinal":382291,"en":"If I flinch, can I ever recover?"},{"id":"seytek-2012:p1128:b002:l037","ordinal":382292,"en":"My forefather was a mighty lord;"},{"id":"seytek-2012:p1128:b002:l038","ordinal":382293,"en":"I have come stalking from afar."},{"id":"seytek-2012:p1128:b002:l039","ordinal":382294,"en":"If I quail, am I even a man?"},{"id":"seytek-2012:p1128:b002:l040","ordinal":382295,"en":"You shall behold my great calamity."},{"id":"seytek-2012:p1128:b003:l001","ordinal":382296,"en":"You are not alone, Joltoy;"},{"id":"seytek-2012:p1128:b003:l002","ordinal":382297,"en":"All you Buruts together shall die!"},{"id":"seytek-2012:p1128:b003:l003","ordinal":382298,"en":"If I do not turn my thoroughbred"},{"id":"seytek-2012:p1128:b003:l004","ordinal":382299,"en":"Onto the passes where you graze your herds,"},{"id":"seytek-2012:p1128:b003:l005","ordinal":382300,"en":"Onto the lands where your lineage multiplies,"},{"id":"seytek-2012:p1128:b003:l006","ordinal":382301,"en":"May I die unworthy of the name Bilgich;"},{"id":"seytek-2012:p1128:b003:l007","ordinal":382302,"en":"If I do not slaughter a thousand of you at once,"},{"id":"seytek-2012:p1128:b003:l008","ordinal":382303,"en":"If I do not butcher your people before returning,"},{"id":"seytek-2012:p1128:b003:l009","ordinal":382304,"en":"Crushing and doubling over your backs,"},{"id":"seytek-2012:p1128:b003:l010","ordinal":382305,"en":"Plundering your Kyrgyz nation,"},{"id":"seytek-2012:p1128:b003:l011","ordinal":382306,"en":"Seating your tall sons at my hearthstones,"},{"id":"seytek-2012:p1128:b003:l012","ordinal":382307,"en":"And seizing your daughters as lawful booty,"},{"id":"seytek-2012:p1128:b003:l013","ordinal":382308,"en":"Binding your mighty men in the marsh,"},{"id":"seytek-2012:p1128:b003:l014","ordinal":382309,"en":"You damned Buruts,"},{"id":"seytek-2012:p1128:b003:l015","ordinal":382310,"en":"And boiling you in your misery;"},{"id":"seytek-2012:p1128:b003:l016","ordinal":382311,"en":"If I do not tear by force"},{"id":"seytek-2012:p1128:b003:l017","ordinal":382312,"en":"The robes from your backs,"},{"id":"seytek-2012:p1128:b003:l018","ordinal":382313,"en":"Strip away your worth,"},{"id":"seytek-2012:p1128:b003:l019","ordinal":382314,"en":"And bring your power to an end;"},{"id":"seytek-2012:p1128:b003:l020","ordinal":382315,"en":"If I do not make your people wander"},{"id":"seytek-2012:p1128:b003:l021","ordinal":382316,"en":"In uproar like victims of yellow fever;"},{"id":"seytek-2012:p1128:b003:l022","ordinal":382317,"en":"If I do not bring ruin upon your blood,"},{"id":"seytek-2012:p1128:b003:l023","ordinal":382318,"en":"Destroying all who cross my path,"},{"id":"seytek-2012:p1128:b003:l024","ordinal":382319,"en":"And reducing them to utter silence;"},{"id":"seytek-2012:p1128:b003:l025","ordinal":382320,"en":"If I do not thwart your desire,"},{"id":"seytek-2012:p1128:b003:l026","ordinal":382321,"en":"And heap boulders like Opol"},{"id":"seytek-2012:p1128:b003:l027","ordinal":382322,"en":"Across the road where you roam at will,"},{"id":"seytek-2012:p1128:b003:l028","ordinal":382323,"en":"You accursed, wretched Kyrgyz;"},{"id":"seytek-2012:p1128:b003:l029","ordinal":382324,"en":"If I do not crush your petty rage,"},{"id":"seytek-2012:p1128:b003:l030","ordinal":382325,"en":"Find a way to overcome you,"},{"id":"seytek-2012:p1128:b003:l031","ordinal":382326,"en":"Then turn back and raid your village,"},{"id":"seytek-2012:p1128:b003:l032","ordinal":382327,"en":"May I die unworthy of the name Bilgich,"},{"id":"seytek-2012:p1128:b003:l033","ordinal":382328,"en":"May I sink stillborn, never truly born."},{"id":"seytek-2012:p1128:b003:l034","ordinal":382329,"en":"Through hardship and sorcerous learning,"},{"id":"seytek-2012:p1128:b003:l035","ordinal":382330,"en":"I became a hero who knew distant things;"},{"id":"seytek-2012:p1128:b003:l036","ordinal":382331,"en":"I was lord over the lands of forty khans,"},{"id":"seytek-2012:p1128:b003:l037","ordinal":382332,"en":"The very embodiment of a noble hero.”"},{"id":"seytek-2012:p1128:b003:l038","ordinal":382333,"en":"So saying, Chonbilgich"},{"id":"seytek-2012:p1128:b003:l039","ordinal":382334,"en":"Gathered all his wrath"},{"id":"seytek-2012:p1128:b003:l040","ordinal":382335,"en":"And would not rest without combat."},{"id":"seytek-2012:p1129:b002:l001","ordinal":382336,"en":"The icon is broken."},{"id":"seytek-2012:p1129:b002:l002","ordinal":382337,"en":"The soul of the beholder is crushed,"},{"id":"seytek-2012:p1129:b002:l003","ordinal":382338,"en":"The art form is like a fist,"},{"id":"seytek-2012:p1129:b002:l004","ordinal":382339,"en":"A buried pig,"},{"id":"seytek-2012:p1129:b002:l005","ordinal":382340,"en":"This is the most courageous."},{"id":"seytek-2012:p1129:b002:l006","ordinal":382341,"en":"The underside is white"},{"id":"seytek-2012:p1129:b002:l007","ordinal":382342,"en":"A large invisible tribe,"},{"id":"seytek-2012:p1129:b002:l008","ordinal":382343,"en":"And in your tribe,"},{"id":"seytek-2012:p1129:b002:l009","ordinal":382344,"en":"Looking in the black eyes"},{"id":"seytek-2012:p1129:b002:l010","ordinal":382345,"en":"Not until he breaks his will,"},{"id":"seytek-2012:p1129:b002:l011","ordinal":382346,"en":"There is no marten-pierced shoulder."},{"id":"seytek-2012:p1129:b002:l012","ordinal":382347,"en":"There is no weight like Saka,"},{"id":"seytek-2012:p1129:b002:l013","ordinal":382348,"en":"There is no obstacle."},{"id":"seytek-2012:p1129:b002:l014","ordinal":382349,"en":"A roaring gray field"},{"id":"seytek-2012:p1129:b002:l015","ordinal":382350,"en":"May the Creator fix his back,"},{"id":"seytek-2012:p1129:b002:l016","ordinal":382351,"en":"Big boy came from China."},{"id":"seytek-2012:p1129:b002:l017","ordinal":382352,"en":"There is no blood from the angry,"},{"id":"seytek-2012:p1129:b002:l018","ordinal":382353,"en":"A runaway dog ​​will not survive."},{"id":"seytek-2012:p1129:b002:l019","ordinal":382354,"en":"The danger is ahead -"},{"id":"seytek-2012:p1129:b002:l020","ordinal":382355,"en":"Akzholtoy stopped."},{"id":"seytek-2012:p1129:b002:l021","ordinal":382356,"en":"I have a lot of worries,"},{"id":"seytek-2012:p1129:b002:l022","ordinal":382357,"en":"It's time for a bad arc,"},{"id":"seytek-2012:p1129:b002:l023","ordinal":382358,"en":"Please, my God."},{"id":"seytek-2012:p1129:b002:l024","ordinal":382359,"en":"See for yourself,"},{"id":"seytek-2012:p1129:b002:l025","ordinal":382360,"en":"From the wrath that represents,"},{"id":"seytek-2012:p1129:b002:l026","ordinal":382361,"en":"From the dragon's fury,"},{"id":"seytek-2012:p1129:b002:l027","ordinal":382362,"en":"The people are disbelievers"},{"id":"seytek-2012:p1129:b002:l028","ordinal":382363,"en":"Evil intent is narrow,"},{"id":"seytek-2012:p1129:b002:l029","ordinal":382364,"en":"From the evil knower infidel,"},{"id":"seytek-2012:p1129:b002:l030","ordinal":382365,"en":"Help yourself, the Creator,"},{"id":"seytek-2012:p1129:b002:l031","ordinal":382366,"en":"Be a friend to the general public."},{"id":"seytek-2012:p1129:b002:l032","ordinal":382367,"en":"The ghost of my departed grandfather"},{"id":"seytek-2012:p1129:b002:l033","ordinal":382368,"en":"Please come and support us."},{"id":"seytek-2012:p1129:b002:l034","ordinal":382369,"en":"He stood motionless."},{"id":"seytek-2012:p1129:b002:l035","ordinal":382370,"en":"Kulunsur below"},{"id":"seytek-2012:p1129:b002:l036","ordinal":382371,"en":"Kulunsur turned his mouth now."},{"id":"seytek-2012:p1129:b002:l037","ordinal":382372,"en":"Moon, animal Kulunsur"},{"id":"seytek-2012:p1129:b002:l038","ordinal":382373,"en":"Like an old man"},{"id":"seytek-2012:p1129:b002:l039","ordinal":382374,"en":"Birth is like a trap,"},{"id":"seytek-2012:p1129:b002:l040","ordinal":382375,"en":"Has a tail, has a mane,"},{"id":"seytek-2012:p1129:b004:l001","ordinal":382376,"en":"It is also an animal."},{"id":"seytek-2012:p1129:b004:l002","ordinal":382377,"en":"To stand up for nothing,"},{"id":"seytek-2012:p1129:b004:l003","ordinal":382378,"en":"Avoiding a duty"},{"id":"seytek-2012:p1129:b004:l004","ordinal":382379,"en":"An animal is an animal"},{"id":"seytek-2012:p1129:b004:l005","ordinal":382380,"en":"The tail spread,"},{"id":"seytek-2012:p1129:b004:l006","ordinal":382381,"en":"Four feet stuck in the ground,"},{"id":"seytek-2012:p1129:b004:l007","ordinal":382382,"en":"Biting his mouth,"},{"id":"seytek-2012:p1129:b004:l008","ordinal":382383,"en":"It devours the earth,"},{"id":"seytek-2012:p1129:b004:l009","ordinal":382384,"en":"Steel mouthpiece knocking,"},{"id":"seytek-2012:p1129:b004:l010","ordinal":382385,"en":"Willow silky tail"},{"id":"seytek-2012:p1129:b004:l011","ordinal":382386,"en":"A blackened butcher"},{"id":"seytek-2012:p1129:b004:l012","ordinal":382387,"en":"Slap on chatkayak,"},{"id":"seytek-2012:p1129:b004:l013","ordinal":382388,"en":"Don't beat your belt,"},{"id":"seytek-2012:p1129:b004:l014","ordinal":382389,"en":"Do not move from where you stand,"},{"id":"seytek-2012:p1129:b004:l015","ordinal":382390,"en":"He raised his head like a deer,"},{"id":"seytek-2012:p1129:b004:l016","ordinal":382391,"en":"Goodbye face,"},{"id":"seytek-2012:p1129:b004:l017","ordinal":382392,"en":"Kulunsur was standing."},{"id":"seytek-2012:p1129:b004:l018","ordinal":382393,"en":"If there is a violent conflict,"},{"id":"seytek-2012:p1129:b004:l019","ordinal":382394,"en":"If the deposit is a strength for the soul,"},{"id":"seytek-2012:p1129:b004:l020","ordinal":382395,"en":"This is the summer of fighting."},{"id":"seytek-2012:p1129:b004:l021","ordinal":382396,"en":"That's how Akjoltoy,"},{"id":"seytek-2012:p1129:b004:l022","ordinal":382397,"en":"Tulpar turned his mouth,"},{"id":"seytek-2012:p1129:b004:l023","ordinal":382398,"en":"The one who gives the turn,"},{"id":"seytek-2012:p1129:b004:l024","ordinal":382399,"en":"Do not quarrel with each other,"},{"id":"seytek-2012:p1129:b004:l025","ordinal":382400,"en":"Take turns fighting"},{"id":"seytek-2012:p1129:b004:l026","ordinal":382401,"en":"Giving way:"},{"id":"seytek-2012:p1129:b004:l027","ordinal":382402,"en":"\"Chonbilgich, the son of Kozhojash,"},{"id":"seytek-2012:p1129:b004:l028","ordinal":382403,"en":"Take your turn, Knower."},{"id":"seytek-2012:p1129:b004:l029","ordinal":382404,"en":"Get ready, Knower,"},{"id":"seytek-2012:p1129:b004:l030","ordinal":382405,"en":"If you are a hero, if you are a man,"},{"id":"seytek-2012:p1129:b004:l031","ordinal":382406,"en":"Take turns, give turns,"},{"id":"seytek-2012:p1129:b004:l032","ordinal":382407,"en":"Know the word yourself,"},{"id":"seytek-2012:p1129:b004:l033","ordinal":382408,"en":"The great elder who was your blood father,"},{"id":"seytek-2012:p1129:b004:l034","ordinal":382409,"en":"Kastasharim burut - that,"},{"id":"seytek-2012:p1129:b004:l035","ordinal":382410,"en":"Kurgurum, you came from Kakan"},{"id":"seytek-2012:p1129:b004:l036","ordinal":382411,"en":"cut off"},{"id":"seytek-2012:p1129:b004:l037","ordinal":382412,"en":"May your life not be long,"},{"id":"seytek-2012:p1129:b004:l038","ordinal":382413,"en":"I died suddenly,"},{"id":"seytek-2012:p1129:b004:l039","ordinal":382414,"en":"Don't waste my time!\" –"},{"id":"seytek-2012:p1129:b004:l040","ordinal":382415,"en":"Uncle Zholtoy said this,"},{"id":"seytek-2012:p1130:b002:l001","ordinal":382416,"en":"Smiling and frowning"},{"id":"seytek-2012:p1130:b002:l002","ordinal":382417,"en":"Laughing and talking"},{"id":"seytek-2012:p1130:b002:l003","ordinal":382418,"en":"The morning of good dreams,"},{"id":"seytek-2012:p1130:b002:l004","ordinal":382419,"en":"Oh, such an ugly creature."},{"id":"seytek-2012:p1130:b002:l005","ordinal":382420,"en":"It was the hero's turn,"},{"id":"seytek-2012:p1130:b002:l006","ordinal":382421,"en":"O angry infidel,"},{"id":"seytek-2012:p1130:b002:l007","ordinal":382422,"en":"Blood to a hero who knows."},{"id":"seytek-2012:p1130:b002:l008","ordinal":382423,"en":"To rush to death,"},{"id":"seytek-2012:p1130:b002:l009","ordinal":382424,"en":"The flies are killed,"},{"id":"seytek-2012:p1130:b002:l010","ordinal":382425,"en":"To your really troublesome sister."},{"id":"seytek-2012:p1130:b002:l011","ordinal":382426,"en":"Kulunsur, a beautiful horse"},{"id":"seytek-2012:p1130:b002:l012","ordinal":382427,"en":"This is Turdu Zholtoy."},{"id":"seytek-2012:p1130:b002:l013","ordinal":382428,"en":"After taking his turn,"},{"id":"seytek-2012:p1130:b002:l014","ordinal":382429,"en":"Enraged Chonbilgich"},{"id":"seytek-2012:p1130:b002:l015","ordinal":382430,"en":"He began to rage."},{"id":"seytek-2012:p1130:b002:l016","ordinal":382431,"en":"Don't forget to take care of yourself"},{"id":"seytek-2012:p1130:b002:l017","ordinal":382432,"en":"Red pepper sprayer"},{"id":"seytek-2012:p1130:b002:l018","ordinal":382433,"en":"He tied it to the grass."},{"id":"seytek-2012:p1130:b002:l019","ordinal":382434,"en":"He is a hunter and a man."},{"id":"seytek-2012:p1130:b002:l020","ordinal":382435,"en":"Along the mountain to Uruna,"},{"id":"seytek-2012:p1130:b002:l021","ordinal":382436,"en":"Thinking about the fight,"},{"id":"seytek-2012:p1130:b002:l022","ordinal":382437,"en":"Beylep started a rage."},{"id":"seytek-2012:p1130:b002:l023","ordinal":382438,"en":"Since leaving Beijing,"},{"id":"seytek-2012:p1130:b002:l024","ordinal":382439,"en":"Boredom is humble,"},{"id":"seytek-2012:p1130:b002:l025","ordinal":382440,"en":"Knowing that he is dead,"},{"id":"seytek-2012:p1130:b002:l026","ordinal":382441,"en":"He tied it to the grass and left it."},{"id":"seytek-2012:p1130:b002:l027","ordinal":382442,"en":"Dust from his step,"},{"id":"seytek-2012:p1130:b002:l028","ordinal":382443,"en":"The soul came out of his voice,"},{"id":"seytek-2012:p1130:b002:l029","ordinal":382444,"en":"No more hunters, no more lions,"},{"id":"seytek-2012:p1130:b002:l030","ordinal":382445,"en":"The trickiest man,"},{"id":"seytek-2012:p1130:b002:l031","ordinal":382446,"en":"Farewell to Zholtoy"},{"id":"seytek-2012:p1130:b002:l032","ordinal":382447,"en":"It's a private place."},{"id":"seytek-2012:p1130:b002:l033","ordinal":382448,"en":"Seeing the outside, criticizing,"},{"id":"seytek-2012:p1130:b002:l034","ordinal":382449,"en":"Apparently, quarreling,"},{"id":"seytek-2012:p1130:b002:l035","ordinal":382450,"en":"Oil comes out of the finger,"},{"id":"seytek-2012:p1130:b002:l036","ordinal":382451,"en":"Bleeding from the nail"},{"id":"seytek-2012:p1130:b002:l037","ordinal":382452,"en":"Don't keep your mouth shut"},{"id":"seytek-2012:p1130:b002:l038","ordinal":382453,"en":"Face with it,"},{"id":"seytek-2012:p1130:b002:l039","ordinal":382454,"en":"Zholtoy, who gave his turn,"},{"id":"seytek-2012:p1130:b002:l040","ordinal":382455,"en":"Ended it,"},{"id":"seytek-2012:p1130:b003:l001","ordinal":382456,"en":"It's hard to move,"},{"id":"seytek-2012:p1130:b003:l002","ordinal":382457,"en":"There is no criticism of hunting,"},{"id":"seytek-2012:p1130:b003:l003","ordinal":382458,"en":"By doing so,"},{"id":"seytek-2012:p1130:b003:l004","ordinal":382459,"en":"Don't shoot too much gun."},{"id":"seytek-2012:p1130:b003:l005","ordinal":382460,"en":"The back has six arrows,"},{"id":"seytek-2012:p1130:b003:l006","ordinal":382461,"en":"With that, fifty shots,"},{"id":"seytek-2012:p1130:b003:l007","ordinal":382462,"en":"It's raining,"},{"id":"seytek-2012:p1130:b003:l008","ordinal":382463,"en":"Shot like hail,"},{"id":"seytek-2012:p1130:b003:l009","ordinal":382464,"en":"The rhino turned its mouth."}]
