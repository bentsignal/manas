[{"id":"semetey-2-2013:p1399:b003:l029","ordinal":294401,"en":"This formidable Kiyaz—"},{"id":"semetey-2-2013:p1399:b003:l030","ordinal":294402,"en":"Such was his appearance."},{"id":"semetey-2-2013:p1399:b003:l031","ordinal":294403,"en":"He towered, huge-limbed,"},{"id":"semetey-2-2013:p1399:b003:l032","ordinal":294404,"en":"With anger as vast as a mountain."},{"id":"semetey-2-2013:p1399:b003:l033","ordinal":294405,"en":"When this Kiyaz grew enraged,"},{"id":"semetey-2-2013:p1399:b003:l034","ordinal":294406,"en":"He seemed ready to swallow his opponent."},{"id":"semetey-2-2013:p1399:b003:l035","ordinal":294407,"en":"Then hero Kiyaz,"},{"id":"semetey-2-2013:p1399:b003:l036","ordinal":294408,"en":"On the plain of Jeti-Ozon,"},{"id":"semetey-2-2013:p1399:b003:l037","ordinal":294409,"en":"Having carried Churok off,"},{"id":"semetey-2-2013:p1399:b003:l038","ordinal":294410,"en":"Was holding the feast for taking her."},{"id":"semetey-2-2013:p1399:b003:l039","ordinal":294411,"en":"\"All the precious four kinds of livestock"},{"id":"semetey-2-2013:p1399:b004:l001","ordinal":294412,"en":"I mean to scatter lavishly,\""},{"id":"semetey-2-2013:p1399:b004:l002","ordinal":294413,"en":"Was Kiyaz's intention."},{"id":"semetey-2-2013:p1399:b004:l003","ordinal":294414,"en":"Dust flew into the sky;"},{"id":"semetey-2-2013:p1399:b004:l004","ordinal":294415,"en":"The army seethed in a dusty throng."},{"id":"semetey-2-2013:p1399:b004:l005","ordinal":294416,"en":"Hero Kiyaz, son of Bagysh,"},{"id":"semetey-2-2013:p1399:b004:l006","ordinal":294417,"en":"Had brought relentless turmoil,"},{"id":"semetey-2-2013:p1399:b004:l007","ordinal":294418,"en":"The people said."},{"id":"semetey-2-2013:p1399:b004:l008","ordinal":294419,"en":"Moonlike Lady Churok,"},{"id":"semetey-2-2013:p1399:b004:l009","ordinal":294420,"en":"Taken as spoil from Talas,"},{"id":"semetey-2-2013:p1399:b004:l010","ordinal":294421,"en":"Akun's daughter Churok,"},{"id":"semetey-2-2013:p1399:b004:l011","ordinal":294422,"en":"He had brought away, they said."},{"id":"semetey-2-2013:p1399:b004:l012","ordinal":294423,"en":"Her gold and silver"},{"id":"semetey-2-2013:p1399:b004:l013","ordinal":294424,"en":"He had loaded and carried off, they said."},{"id":"semetey-2-2013:p1399:b004:l014","ordinal":294425,"en":"Moonlike Lady Churok—"},{"id":"semetey-2-2013:p1399:b004:l015","ordinal":294426,"en":"After ravaging and destroying her camp,"},{"id":"semetey-2-2013:p1399:b004:l016","ordinal":294427,"en":"He had seized her, they said."},{"id":"semetey-2-2013:p1399:b004:l017","ordinal":294428,"en":"\"The lands of old Talas and great Keng-Kol"},{"id":"semetey-2-2013:p1399:b004:l018","ordinal":294429,"en":"I have won and brought home;"},{"id":"semetey-2-2013:p1399:b004:l019","ordinal":294430,"en":"For the fallen and extinguished Zhediger,"},{"id":"semetey-2-2013:p1399:b004:l020","ordinal":294431,"en":"I have taken vengeance,\" he said."},{"id":"semetey-2-2013:p1399:b004:l021","ordinal":294432,"en":"\"Upon the steed none would give when asked,"},{"id":"semetey-2-2013:p1399:b004:l022","ordinal":294433,"en":"I cast the cruel catching-pole;"},{"id":"semetey-2-2013:p1399:b004:l023","ordinal":294434,"en":"Churok, who would not consent in her right mind,"},{"id":"semetey-2-2013:p1399:b004:l024","ordinal":294435,"en":"I have taken and led away as spoil."},{"id":"semetey-2-2013:p1399:b004:l025","ordinal":294436,"en":"Today I mean to scatter all four kinds of livestock"},{"id":"semetey-2-2013:p1399:b004:l026","ordinal":294437,"en":"At the bride Churok's wedding."},{"id":"semetey-2-2013:p1399:b004:l027","ordinal":294438,"en":"My people, now that you have come, I shall spare nothing."},{"id":"semetey-2-2013:p1399:b004:l028","ordinal":294439,"en":"Zhediger of Jeti-Ozon,"},{"id":"semetey-2-2013:p1399:b004:l029","ordinal":294440,"en":"Your khan stands here before you."},{"id":"semetey-2-2013:p1399:b004:l030","ordinal":294441,"en":"All you multitudes born into this world,"},{"id":"semetey-2-2013:p1399:b004:l031","ordinal":294442,"en":"Every one of you stands here."},{"id":"semetey-2-2013:p1399:b004:l032","ordinal":294443,"en":"Say, 'This is Khan Kiyaz's design;"},{"id":"semetey-2-2013:p1399:b004:l033","ordinal":294444,"en":"This is Aichurok's wedding.'"},{"id":"semetey-2-2013:p1399:b004:l034","ordinal":294445,"en":"Let cries and clamor abound;"},{"id":"semetey-2-2013:p1399:b004:l035","ordinal":294446,"en":"Let the din split the sky."},{"id":"semetey-2-2013:p1399:b004:l036","ordinal":294447,"en":"Let dust trail upward from the earth;"},{"id":"semetey-2-2013:p1399:b004:l037","ordinal":294448,"en":"Let all these accomplished people rejoice."},{"id":"semetey-2-2013:p1399:b004:l038","ordinal":294449,"en":"I shall scatter livestock by the tens of thousands;"},{"id":"semetey-2-2013:p1399:b004:l039","ordinal":294450,"en":"The treasury left by my father Bagysh—"},{"id":"semetey-2-2013:p1400:b003:l001","ordinal":294451,"en":"I shall break open its mouth with an axe."},{"id":"semetey-2-2013:p1400:b003:l002","ordinal":294452,"en":"My people, let me slaughter the cattle;"},{"id":"semetey-2-2013:p1400:b003:l003","ordinal":294453,"en":"For valiant Lady Churok,"},{"id":"semetey-2-2013:p1400:b003:l004","ordinal":294454,"en":"Let me hold her wedding today."},{"id":"semetey-2-2013:p1400:b003:l005","ordinal":294455,"en":"Gather livestock from every quarter;"},{"id":"semetey-2-2013:p1400:b003:l006","ordinal":294456,"en":"Let the wealth from my hands be spent."},{"id":"semetey-2-2013:p1400:b003:l007","ordinal":294457,"en":"Today perform my marriage rite with Churok."},{"id":"semetey-2-2013:p1400:b003:l008","ordinal":294458,"en":"Today we shall eat meat from one dish"},{"id":"semetey-2-2013:p1400:b003:l009","ordinal":294459,"en":"And face each other in one bed."},{"id":"semetey-2-2013:p1400:b003:l010","ordinal":294460,"en":"Today I shall scatter all my livestock;"},{"id":"semetey-2-2013:p1400:b003:l011","ordinal":294461,"en":"For the noble, unfortunate woman,"},{"id":"semetey-2-2013:p1400:b003:l012","ordinal":294462,"en":"Today I shall spend all my poor means."},{"id":"semetey-2-2013:p1400:b003:l013","ordinal":294463,"en":"Upon the broad plain,"},{"id":"semetey-2-2013:p1400:b003:l014","ordinal":294464,"en":"For this unfortunate woman's wedding,"},{"id":"semetey-2-2013:p1400:b003:l015","ordinal":294465,"en":"My people, know this today:"},{"id":"semetey-2-2013:p1400:b003:l016","ordinal":294466,"en":"I shall slaughter a thousand dark mares,"},{"id":"semetey-2-2013:p1400:b003:l017","ordinal":294467,"en":"I shall slaughter a thousand blaze-faced camels."},{"id":"semetey-2-2013:p1400:b003:l018","ordinal":294468,"en":"Let the poles bend today;"},{"id":"semetey-2-2013:p1400:b003:l019","ordinal":294469,"en":"Let champion warriors joust today!"},{"id":"semetey-2-2013:p1400:b003:l020","ordinal":294470,"en":"Let poles break and lashings fall;"},{"id":"semetey-2-2013:p1400:b003:l021","ordinal":294471,"en":"At renowned Churok's wedding,"},{"id":"semetey-2-2013:p1400:b003:l022","ordinal":294472,"en":"Let heroes fall and lashings drop."},{"id":"semetey-2-2013:p1400:b003:l023","ordinal":294473,"en":"Let the strongest wrestlers come forward,"},{"id":"semetey-2-2013:p1400:b003:l024","ordinal":294474,"en":"Wearing yellow leather trousers;"},{"id":"semetey-2-2013:p1400:b003:l025","ordinal":294475,"en":"Let them seize each other by the cuffs,"},{"id":"semetey-2-2013:p1400:b003:l026","ordinal":294476,"en":"Let them wrestle on foot,"},{"id":"semetey-2-2013:p1400:b003:l027","ordinal":294477,"en":"And let the victor become rich."},{"id":"semetey-2-2013:p1400:b003:l028","ordinal":294478,"en":"Let no tale remain that she was a woman taken as spoil;"},{"id":"semetey-2-2013:p1400:b003:l029","ordinal":294479,"en":"Let no such talk remain among the people."},{"id":"semetey-2-2013:p1400:b003:l030","ordinal":294480,"en":"Let no resentment remain that she was a plundered woman;"},{"id":"semetey-2-2013:p1400:b003:l031","ordinal":294481,"en":"Let no such grudge remain within."},{"id":"semetey-2-2013:p1400:b003:l032","ordinal":294482,"en":"Let all the peoples think,"},{"id":"semetey-2-2013:p1400:b003:l033","ordinal":294483,"en":"'It was as though he took a maiden in marriage.'"},{"id":"semetey-2-2013:p1400:b003:l034","ordinal":294484,"en":"Let no other thought arise."},{"id":"semetey-2-2013:p1400:b003:l035","ordinal":294485,"en":"Let them say, 'Khan Kiyaz was a leopard warrior;"},{"id":"semetey-2-2013:p1400:b003:l036","ordinal":294486,"en":"Such was his intention."},{"id":"semetey-2-2013:p1400:b003:l037","ordinal":294487,"en":"When he took Aichurok,"},{"id":"semetey-2-2013:p1400:b003:l038","ordinal":294488,"en":"Such was the wedding he held.'"},{"id":"semetey-2-2013:p1400:b003:l039","ordinal":294489,"en":"To all the gathered souls,"},{"id":"semetey-2-2013:p1400:b004:l001","ordinal":294490,"en":"To children chasing butterflies,"},{"id":"semetey-2-2013:p1400:b004:l002","ordinal":294491,"en":"To old men coughing often,"},{"id":"semetey-2-2013:p1400:b004:l003","ordinal":294492,"en":"To the senile who cannot come to the feast,"},{"id":"semetey-2-2013:p1400:b004:l004","ordinal":294493,"en":"To old men remaining at home,"},{"id":"semetey-2-2013:p1400:b004:l005","ordinal":294494,"en":"Let them say, 'This was hero Kiyaz's desire;"},{"id":"semetey-2-2013:p1400:b004:l006","ordinal":294495,"en":"Such was his intention."},{"id":"semetey-2-2013:p1400:b004:l007","ordinal":294496,"en":"The dear ruler of the people—"},{"id":"semetey-2-2013:p1400:b004:l008","ordinal":294497,"en":"Such was the feast he held.'"},{"id":"semetey-2-2013:p1400:b004:l009","ordinal":294498,"en":"Set aside excessive talk;"},{"id":"semetey-2-2013:p1400:b004:l010","ordinal":294499,"en":"Take whatever you desire."},{"id":"semetey-2-2013:p1400:b004:l011","ordinal":294500,"en":"Hold fierce games and great wrestling;"},{"id":"semetey-2-2013:p1400:b004:l012","ordinal":294501,"en":"My people, this is what I desire!\""},{"id":"semetey-2-2013:p1400:b004:l013","ordinal":294502,"en":"So spoke hero Kiyaz."},{"id":"semetey-2-2013:p1400:b004:l014","ordinal":294503,"en":"Because of what had happened,"},{"id":"semetey-2-2013:p1400:b004:l015","ordinal":294504,"en":"Because of Aichurok,"},{"id":"semetey-2-2013:p1400:b004:l016","ordinal":294505,"en":"He gathered the people behind him;"},{"id":"semetey-2-2013:p1400:b004:l017","ordinal":294506,"en":"Driven by his longing for Aichurok,"},{"id":"semetey-2-2013:p1400:b004:l018","ordinal":294507,"en":"The multitude of Zhediger"},{"id":"semetey-2-2013:p1400:b004:l019","ordinal":294508,"en":"Heard that the khan's decree had come."},{"id":"semetey-2-2013:p1400:b004:l020","ordinal":294509,"en":"The poles bent,"},{"id":"semetey-2-2013:p1400:b004:l021","ordinal":294510,"en":"And champion warriors jousted."},{"id":"semetey-2-2013:p1400:b004:l022","ordinal":294511,"en":"Broken poles piled like a mountain;"},{"id":"semetey-2-2013:p1400:b004:l023","ordinal":294512,"en":"They straightened their poles in their grip,"},{"id":"semetey-2-2013:p1400:b004:l024","ordinal":294513,"en":"Thrusting them out at full length,"},{"id":"semetey-2-2013:p1400:b004:l025","ordinal":294514,"en":"Boasting to one another,"},{"id":"semetey-2-2013:p1400:b004:l026","ordinal":294515,"en":"And clashing fiercely in the joust."},{"id":"semetey-2-2013:p1400:b004:l027","ordinal":294516,"en":"When their poles met,"},{"id":"semetey-2-2013:p1400:b004:l028","ordinal":294517,"en":"They shattered at the middle with a crack."},{"id":"semetey-2-2013:p1400:b004:l029","ordinal":294518,"en":"At the great feast held by Lord Kiyaz,"},{"id":"semetey-2-2013:p1400:b004:l030","ordinal":294519,"en":"The multitude of Zhediger"},{"id":"semetey-2-2013:p1400:b004:l031","ordinal":294520,"en":"Rejoiced and bustled."},{"id":"semetey-2-2013:p1400:b004:l032","ordinal":294521,"en":"Wrestlers fell, propping themselves up;"},{"id":"semetey-2-2013:p1400:b004:l033","ordinal":294522,"en":"Men were thrown from their horses."},{"id":"semetey-2-2013:p1400:b004:l034","ordinal":294523,"en":"Those thrown and those who threw them"},{"id":"semetey-2-2013:p1400:b004:l035","ordinal":294524,"en":"Stripped one another bare,"},{"id":"semetey-2-2013:p1400:b004:l036","ordinal":294525,"en":"Plundering each other completely."},{"id":"semetey-2-2013:p1400:b004:l037","ordinal":294526,"en":"They seized each other by the trouser cuffs;"},{"id":"semetey-2-2013:p1400:b004:l038","ordinal":294527,"en":"Heroes and wrestlers grappled,"},{"id":"semetey-2-2013:p1400:b004:l039","ordinal":294528,"en":"Putting forth all their former strength."},{"id":"semetey-2-2013:p1401:b003:l001","ordinal":294529,"en":"They butted like gray bulls,"},{"id":"semetey-2-2013:p1401:b003:l002","ordinal":294530,"en":"And fought like wolves in kok-boru."},{"id":"semetey-2-2013:p1401:b003:l003","ordinal":294531,"en":"They gripped whatever opening appeared;"},{"id":"semetey-2-2013:p1401:b003:l004","ordinal":294532,"en":"The wrestlers, finding an opening,"},{"id":"semetey-2-2013:p1401:b003:l005","ordinal":294533,"en":"Mauled each other like hungry stallion-camels."},{"id":"semetey-2-2013:p1401:b003:l006","ordinal":294534,"en":"Along Jeti-Ozon,"},{"id":"semetey-2-2013:p1401:b003:l007","ordinal":294535,"en":"The people bustled and raised a din."},{"id":"semetey-2-2013:p1401:b003:l008","ordinal":294536,"en":"The one thrown was left empty-handed;"},{"id":"semetey-2-2013:p1401:b003:l009","ordinal":294537,"en":"The victor claimed the prize."},{"id":"semetey-2-2013:p1401:b003:l010","ordinal":294538,"en":"The spectacle grew immense."},{"id":"semetey-2-2013:p1401:b003:l011","ordinal":294539,"en":"Dust flew into the sky;"},{"id":"semetey-2-2013:p1401:b003:l012","ordinal":294540,"en":"The great crowd streamed and bustled."},{"id":"semetey-2-2013:p1401:b003:l013","ordinal":294541,"en":"Now, to begin the celebration,"},{"id":"semetey-2-2013:p1401:b003:l014","ordinal":294542,"en":"To perform Churok's marriage rite,"},{"id":"semetey-2-2013:p1401:b003:l015","ordinal":294543,"en":"Those with turbans wound around their heads,"},{"id":"semetey-2-2013:p1401:b003:l016","ordinal":294544,"en":"Those who prayed to the Almighty,"},{"id":"semetey-2-2013:p1401:b003:l017","ordinal":294545,"en":"The khojas in white turbans,"},{"id":"semetey-2-2013:p1401:b003:l018","ordinal":294546,"en":"The mullahs in mottled robes—"},{"id":"semetey-2-2013:p1401:b003:l019","ordinal":294547,"en":"He gathered every khoja without exception."},{"id":"semetey-2-2013:p1401:b003:l020","ordinal":294548,"en":"As twilight came and the sun set,"},{"id":"semetey-2-2013:p1401:b003:l021","ordinal":294549,"en":"As darkness fell and people grew still,"},{"id":"semetey-2-2013:p1401:b003:l022","ordinal":294550,"en":"When the sky filled with glittering stars,"},{"id":"semetey-2-2013:p1401:b003:l023","ordinal":294551,"en":"When every living creature"},{"id":"semetey-2-2013:p1401:b003:l024","ordinal":294552,"en":"Had reached its time for sleep,"},{"id":"semetey-2-2013:p1401:b003:l025","ordinal":294553,"en":"He had the marriage rite performed at once,"},{"id":"semetey-2-2013:p1401:b003:l026","ordinal":294554,"en":"And Kiyaz took Churok."},{"id":"semetey-2-2013:p1401:b003:l027","ordinal":294555,"en":"Caught in a net she could not break by struggling,"},{"id":"semetey-2-2013:p1401:b003:l028","ordinal":294556,"en":"Aichurok had fallen into the snare."},{"id":"semetey-2-2013:p1401:b003:l029","ordinal":294557,"en":"She had fallen into hands"},{"id":"semetey-2-2013:p1401:b003:l030","ordinal":294558,"en":"In a way no sleeping person could dream."},{"id":"semetey-2-2013:p1401:b003:l031","ordinal":294559,"en":"Conceiving a plan no person could discover,"},{"id":"semetey-2-2013:p1401:b003:l032","ordinal":294560,"en":"Kiyaz, hero of the Zhediger,"},{"id":"semetey-2-2013:p1401:b003:l033","ordinal":294561,"en":"Held a feast for all the accomplished people."},{"id":"semetey-2-2013:p1401:b003:l034","ordinal":294562,"en":"They called it hero Kiyaz's design,"},{"id":"semetey-2-2013:p1401:b003:l035","ordinal":294563,"en":"The wedding at which he would take Aichurok."},{"id":"semetey-2-2013:p1401:b003:l036","ordinal":294564,"en":"He slaughtered ninety mares for the feast;"},{"id":"semetey-2-2013:p1401:b003:l037","ordinal":294565,"en":"Abundant wealth and countless livestock"},{"id":"semetey-2-2013:p1401:b003:l038","ordinal":294566,"en":"He set out without measure."},{"id":"semetey-2-2013:p1401:b003:l039","ordinal":294567,"en":"He seated all the champions facing the feast,"},{"id":"semetey-2-2013:p1401:b005:l001","ordinal":294568,"en":"And made a mountain of meat like Ala-Too,"},{"id":"semetey-2-2013:p1401:b005:l002","ordinal":294569,"en":"A lake of broth like Ala-Kol."},{"id":"semetey-2-2013:p1401:b005:l003","ordinal":294570,"en":"He filled the feast with slaughtered stock"},{"id":"semetey-2-2013:p1401:b005:l004","ordinal":294571,"en":"And plunged into the clamor."},{"id":"semetey-2-2013:p1401:b005:l005","ordinal":294572,"en":"A great spectacle beyond human knowing"},{"id":"semetey-2-2013:p1401:b005:l006","ordinal":294573,"en":"Had plunged into uproar;"},{"id":"semetey-2-2013:p1401:b005:l007","ordinal":294574,"en":"A vast commotion that would not subside"},{"id":"semetey-2-2013:p1401:b005:l008","ordinal":294575,"en":"Had engulfed them."},{"id":"semetey-2-2013:p1401:b005:l009","ordinal":294576,"en":"A spectacle that could not be stilled"},{"id":"semetey-2-2013:p1401:b005:l010","ordinal":294577,"en":"Had plunged into clamor."},{"id":"semetey-2-2013:p1401:b005:l011","ordinal":294578,"en":"The people who came to the feast—"},{"id":"semetey-2-2013:p1401:b005:l012","ordinal":294579,"en":"Some called for a stallion and mounted a camel;"},{"id":"semetey-2-2013:p1401:b005:l013","ordinal":294580,"en":"The shameless went on foot."},{"id":"semetey-2-2013:p1401:b005:l014","ordinal":294581,"en":"All the women streamed along,"},{"id":"semetey-2-2013:p1401:b005:l015","ordinal":294582,"en":"The old and the young;"},{"id":"semetey-2-2013:p1401:b005:l016","ordinal":294583,"en":"Even the drunkards came, none staying behind."},{"id":"semetey-2-2013:p1401:b005:l017","ordinal":294584,"en":"The long-eared gossips,"},{"id":"semetey-2-2013:p1401:b005:l018","ordinal":294585,"en":"All the modest people,"},{"id":"semetey-2-2013:p1401:b005:l019","ordinal":294586,"en":"The eager connoisseur and the handsome,"},{"id":"semetey-2-2013:p1401:b005:l020","ordinal":294587,"en":"The meek man who knew no speeches,"},{"id":"semetey-2-2013:p1401:b005:l021","ordinal":294588,"en":"The khoja wrapped in a turban,"},{"id":"semetey-2-2013:p1401:b005:l022","ordinal":294589,"en":"The lettered mullah,"},{"id":"semetey-2-2013:p1401:b005:l023","ordinal":294590,"en":"The wrestlers and spearmen—"},{"id":"semetey-2-2013:p1401:b005:l024","ordinal":294591,"en":"Hearing Kiyaz would take Churok,"},{"id":"semetey-2-2013:p1401:b005:l025","ordinal":294592,"en":"They all came, none remaining behind."},{"id":"semetey-2-2013:p1401:b005:l026","ordinal":294593,"en":"They came to this feast,"},{"id":"semetey-2-2013:p1401:b005:l027","ordinal":294594,"en":"People of every kind."},{"id":"semetey-2-2013:p1401:b005:l028","ordinal":294595,"en":"Drinking kumis, they grew heated,"},{"id":"semetey-2-2013:p1401:b005:l029","ordinal":294596,"en":"Their bones tingling;"},{"id":"semetey-2-2013:p1401:b005:l030","ordinal":294597,"en":"Drinking spirits, they panted,"},{"id":"semetey-2-2013:p1401:b005:l031","ordinal":294598,"en":"Straining like hungry birds."},{"id":"semetey-2-2013:p1401:b005:l032","ordinal":294599,"en":"Kiyaz, son of Bagysh,"},{"id":"semetey-2-2013:p1401:b005:l033","ordinal":294600,"en":"Showed himself to be a hero."},{"id":"semetey-2-2013:p1401:b005:l034","ordinal":294601,"en":"Many people rejoiced at his feast;"},{"id":"semetey-2-2013:p1401:b005:l035","ordinal":294602,"en":"Great were the games and spectacle,"},{"id":"semetey-2-2013:p1401:b005:l036","ordinal":294603,"en":"When one looked upon such events."},{"id":"semetey-2-2013:p1401:b005:l037","ordinal":294604,"en":"What could poor Kiyaz do?"},{"id":"semetey-2-2013:p1401:b005:l038","ordinal":294605,"en":"Without looking up or down,"},{"id":"semetey-2-2013:p1401:b005:l039","ordinal":294606,"en":"Never thinking he might die,"},{"id":"semetey-2-2013:p1402:b003:l001","ordinal":294607,"en":"Without looking around him,"},{"id":"semetey-2-2013:p1402:b003:l002","ordinal":294608,"en":"Not sparing so much as a hair,"},{"id":"semetey-2-2013:p1402:b003:l003","ordinal":294609,"en":"He conceived a plan no man could fathom,"},{"id":"semetey-2-2013:p1402:b003:l004","ordinal":294610,"en":"And lavishly spent abundant wealth"},{"id":"semetey-2-2013:p1402:b003:l005","ordinal":294611,"en":"And countless livestock upon the feast."},{"id":"semetey-2-2013:p1402:b003:l006","ordinal":294612,"en":"Across the plain of Zherge-Tal,"},{"id":"semetey-2-2013:p1402:b003:l007","ordinal":294613,"en":"Along the banks of Jeti-Suu,"},{"id":"semetey-2-2013:p1402:b003:l008","ordinal":294614,"en":"He raised loud laughter."},{"id":"semetey-2-2013:p1402:b003:l009","ordinal":294615,"en":"Among the Zhediger of Jeti-Ozon,"},{"id":"semetey-2-2013:p1402:b003:l010","ordinal":294616,"en":"He gathered everyone without exception."},{"id":"semetey-2-2013:p1402:b003:l011","ordinal":294617,"en":"The people assembled and packed the place;"},{"id":"semetey-2-2013:p1402:b003:l012","ordinal":294618,"en":"The folk of Jeti-Ozon crowded in."},{"id":"semetey-2-2013:p1402:b003:l013","ordinal":294619,"en":"He opened the treasury,"},{"id":"semetey-2-2013:p1402:b003:l014","ordinal":294620,"en":"And all the amassed gold and wealth"},{"id":"semetey-2-2013:p1402:b003:l015","ordinal":294621,"en":"He scattered lavishly."},{"id":"semetey-2-2013:p1402:b003:l016","ordinal":294622,"en":"He began the games on a boundless scale,"},{"id":"semetey-2-2013:p1402:b003:l017","ordinal":294623,"en":"And all the countless goods"},{"id":"semetey-2-2013:p1402:b003:l018","ordinal":294624,"en":"He utterly gave away."},{"id":"semetey-2-2013:p1402:b003:l019","ordinal":294625,"en":"He slaughtered stallions with tusk-long teeth,"},{"id":"semetey-2-2013:p1402:b003:l020","ordinal":294626,"en":"And specially chosen mares;"},{"id":"semetey-2-2013:p1402:b003:l021","ordinal":294627,"en":"Their two humps standing high,"},{"id":"semetey-2-2013:p1402:b003:l022","ordinal":294628,"en":"He slaughtered ungainly camels,"},{"id":"semetey-2-2013:p1402:b003:l023","ordinal":294629,"en":"Setting out wealth beyond measure."},{"id":"semetey-2-2013:p1402:b003:l024","ordinal":294630,"en":"When the formidable gray wolf had died,"},{"id":"semetey-2-2013:p1402:b003:l025","ordinal":294631,"en":"To the palace taken as spoil,"},{"id":"semetey-2-2013:p1402:b003:l026","ordinal":294632,"en":"Before the khan's dark-eyed lady,"},{"id":"semetey-2-2013:p1402:b003:l027","ordinal":294633,"en":"Before dear Churok herself,"},{"id":"semetey-2-2013:p1402:b003:l028","ordinal":294634,"en":"He summoned the people's biys,"},{"id":"semetey-2-2013:p1402:b003:l029","ordinal":294635,"en":"Gathering all those rulers,"},{"id":"semetey-2-2013:p1402:b003:l030","ordinal":294636,"en":"And hero Kiyaz brought them"},{"id":"semetey-2-2013:p1402:b003:l031","ordinal":294637,"en":"Into Aichurok's dwelling."},{"id":"semetey-2-2013:p1402:b003:l032","ordinal":294638,"en":"The khojas in mottled robes,"},{"id":"semetey-2-2013:p1402:b003:l033","ordinal":294639,"en":"The mullahs wrapped in turbans,"},{"id":"semetey-2-2013:p1402:b003:l034","ordinal":294640,"en":"The eloquent and learned elders—"},{"id":"semetey-2-2013:p1402:b003:l035","ordinal":294641,"en":"So they might carefully behold"},{"id":"semetey-2-2013:p1402:b003:l036","ordinal":294642,"en":"Aichurok's beauty and diversion,"},{"id":"semetey-2-2013:p1402:b003:l037","ordinal":294643,"en":"He gathered all the people."},{"id":"semetey-2-2013:p1402:b003:l038","ordinal":294644,"en":"Those closest to himself,"},{"id":"semetey-2-2013:p1402:b003:l039","ordinal":294645,"en":"Kiyaz gathered his khans"},{"id":"semetey-2-2013:p1402:b004:l001","ordinal":294646,"en":"Into Aichurok's palace."},{"id":"semetey-2-2013:p1402:b004:l002","ordinal":294647,"en":"To his khans and royal kin,"},{"id":"semetey-2-2013:p1402:b004:l003","ordinal":294648,"en":"To everyone close to him,"},{"id":"semetey-2-2013:p1402:b004:l004","ordinal":294649,"en":"To his tiger-hearted heroes,"},{"id":"semetey-2-2013:p1402:b004:l005","ordinal":294650,"en":"To those who rode beside him,"},{"id":"semetey-2-2013:p1402:b004:l006","ordinal":294651,"en":"To his wise and capable lords,"},{"id":"semetey-2-2013:p1402:b004:l007","ordinal":294652,"en":"He displayed Aichurok's bearing,"},{"id":"semetey-2-2013:p1402:b004:l008","ordinal":294653,"en":"Testing the judgment of them all."},{"id":"semetey-2-2013:p1402:b004:l009","ordinal":294654,"en":"The khan proclaimed the viewing,"},{"id":"semetey-2-2013:p1402:b004:l010","ordinal":294655,"en":"And before the noble, unfortunate woman"},{"id":"semetey-2-2013:p1402:b004:l011","ordinal":294656,"en":"Those who faced her stood amazed."}]
