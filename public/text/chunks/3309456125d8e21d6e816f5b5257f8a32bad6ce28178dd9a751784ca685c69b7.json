[{"id":"semetey-1-2013:p1035:b003:l038","ordinal":155137,"en":"The overbearing lion"},{"id":"semetey-1-2013:p1035:b003:l039","ordinal":155138,"en":"Was left ashamed."},{"id":"semetey-1-2013:p1035:b005:l001","ordinal":155139,"en":"His father Manas had pursued enemies;"},{"id":"semetey-1-2013:p1035:b005:l002","ordinal":155140,"en":"Kanykei had borne the hero,"},{"id":"semetey-1-2013:p1035:b005:l003","ordinal":155141,"en":"Yet he had never before been so distressed"},{"id":"semetey-1-2013:p1035:b005:l004","ordinal":155142,"en":"Or suffered such shame."},{"id":"semetey-1-2013:p1035:b005:l005","ordinal":155143,"en":"Aichurok, the daughter of Akun,"},{"id":"semetey-1-2013:p1035:b005:l006","ordinal":155144,"en":"Removed the lord's hand from her breast."},{"id":"semetey-1-2013:p1035:b005:l007","ordinal":155145,"en":"Your overbearing lord"},{"id":"semetey-1-2013:p1035:b005:l008","ordinal":155146,"en":"Was left ashamed."},{"id":"semetey-1-2013:p1035:b005:l009","ordinal":155147,"en":"He stamped about in fury"},{"id":"semetey-1-2013:p1035:b005:l010","ordinal":155148,"en":"And brought down a dark day."},{"id":"semetey-1-2013:p1035:b005:l011","ordinal":155149,"en":"The lion grew enraged"},{"id":"semetey-1-2013:p1035:b005:l012","ordinal":155150,"en":"And began dark speech;"},{"id":"semetey-1-2013:p1035:b005:l013","ordinal":155151,"en":"Let alone Churok—he spoke"},{"id":"semetey-1-2013:p1035:b005:l014","ordinal":155152,"en":"As though he would slaughter Akun himself."},{"id":"semetey-1-2013:p1035:b005:l015","ordinal":155153,"en":"If you would see a marvel, see it now:"},{"id":"semetey-1-2013:p1035:b005:l016","ordinal":155154,"en":"Raging and surging with anger,"},{"id":"semetey-1-2013:p1035:b005:l017","ordinal":155155,"en":"The lion let loose"},{"id":"semetey-1-2013:p1035:b005:l018","ordinal":155156,"en":"And scolded Aichurok:"},{"id":"semetey-1-2013:p1035:b005:l019","ordinal":155157,"en":"\"I shall become a companion"},{"id":"semetey-1-2013:p1035:b005:l020","ordinal":155158,"en":"To maidens gathering reeds."},{"id":"semetey-1-2013:p1035:b005:l021","ordinal":155159,"en":"Come here, you bitch;"},{"id":"semetey-1-2013:p1035:b005:l022","ordinal":155160,"en":"Give me the falcon, and let me go!"},{"id":"semetey-1-2013:p1035:b005:l023","ordinal":155161,"en":"I shall become an equal"},{"id":"semetey-1-2013:p1035:b005:l024","ordinal":155162,"en":"To maidens gathering dung."},{"id":"semetey-1-2013:p1035:b005:l025","ordinal":155163,"en":"You are one of the lowborn;"},{"id":"semetey-1-2013:p1035:b005:l026","ordinal":155164,"en":"Give me the falcon, and let me go!"},{"id":"semetey-1-2013:p1035:b005:l027","ordinal":155165,"en":"To an old crone like you who has taken no husband,"},{"id":"semetey-1-2013:p1035:b005:l028","ordinal":155166,"en":"To a broad-soled hag,"},{"id":"semetey-1-2013:p1035:b005:l029","ordinal":155167,"en":"I shall keep pouring out my contempt."},{"id":"semetey-1-2013:p1035:b005:l030","ordinal":155168,"en":"Give me the falcon, and let me go!"},{"id":"semetey-1-2013:p1035:b005:l031","ordinal":155169,"en":"You stripped the weariness from your horse"},{"id":"semetey-1-2013:p1035:b005:l032","ordinal":155170,"en":"And flew wandering"},{"id":"semetey-1-2013:p1035:b005:l033","ordinal":155171,"en":"Throughout the whole wide world."},{"id":"semetey-1-2013:p1035:b005:l034","ordinal":155172,"en":"There is no place you have not worshiped,"},{"id":"semetey-1-2013:p1035:b005:l035","ordinal":155173,"en":"And no man you have not visited."},{"id":"semetey-1-2013:p1035:b005:l036","ordinal":155174,"en":"Old slave woman who has taken no husband,"},{"id":"semetey-1-2013:p1035:b005:l037","ordinal":155175,"en":"Wretch who blocks the traveler's road—"},{"id":"semetey-1-2013:p1035:b005:l038","ordinal":155176,"en":"Until your hair becomes white as a swan,"},{"id":"semetey-1-2013:p1035:b005:l039","ordinal":155177,"en":"Until your teeth become grains of wheat,"}]
