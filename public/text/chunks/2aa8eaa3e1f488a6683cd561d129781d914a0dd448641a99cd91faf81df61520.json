[{"id":"semetey-1-2013:p0245:b003:l031","ordinal":95489,"en":"\"The command Allah has sent—"},{"id":"semetey-1-2013:p0245:b003:l032","ordinal":95490,"en":"Let me see it as it is."},{"id":"semetey-1-2013:p0245:b003:l033","ordinal":95491,"en":"This true racer of the unseen world,"},{"id":"semetey-1-2013:p0245:b003:l034","ordinal":95492,"en":"Let me urge him on still harder."},{"id":"semetey-1-2013:p0245:b003:l035","ordinal":95493,"en":"My father Temir Khan's Aktulpar"},{"id":"semetey-1-2013:p0245:b003:l036","ordinal":95494,"en":"Was a swift horse by nature."},{"id":"semetey-1-2013:p0245:b003:l037","ordinal":95495,"en":"A Karabair warhorse,"},{"id":"semetey-1-2013:p0245:b003:l038","ordinal":95496,"en":"With sieve-like lungs and copper forelegs,"},{"id":"semetey-1-2013:p0245:b003:l039","ordinal":95497,"en":"He was a creature with wings."},{"id":"semetey-1-2013:p0245:b004:l001","ordinal":95498,"en":"To the prize in this race,"},{"id":"semetey-1-2013:p0245:b004:l002","ordinal":95499,"en":"Will he run without letting anyone catch him?"},{"id":"semetey-1-2013:p0245:b004:l003","ordinal":95500,"en":"Of this Bukhara here,"},{"id":"semetey-1-2013:p0245:b004:l004","ordinal":95501,"en":"Will he win the first prize?"},{"id":"semetey-1-2013:p0245:b004:l005","ordinal":95502,"en":"Will Taytoru die a worthless death"},{"id":"semetey-1-2013:p0245:b004:l006","ordinal":95503,"en":"And finish behind another?"},{"id":"semetey-1-2013:p0245:b004:l007","ordinal":95504,"en":"'Though a woman, she ruined the nation—"},{"id":"semetey-1-2013:p0245:b004:l008","ordinal":95505,"en":"The shameless one's horse!' they may say."},{"id":"semetey-1-2013:p0245:b004:l009","ordinal":95506,"en":"Will the people gather"},{"id":"semetey-1-2013:p0245:b004:l010","ordinal":95507,"en":"And put me to shame?"},{"id":"semetey-1-2013:p0245:b004:l011","ordinal":95508,"en":"Will God dig my pit?"},{"id":"semetey-1-2013:p0245:b004:l012","ordinal":95509,"en":"Will the one God make boil"},{"id":"semetey-1-2013:p0245:b004:l013","ordinal":95510,"en":"My misfortune that has gone so far?"},{"id":"semetey-1-2013:p0245:b004:l014","ordinal":95511,"en":"Will the one God show me"},{"id":"semetey-1-2013:p0245:b004:l015","ordinal":95512,"en":"A wonder no mortal could endure?"},{"id":"semetey-1-2013:p0245:b004:l016","ordinal":95513,"en":"From that ridge shaped like a saddle's waist,"},{"id":"semetey-1-2013:p0245:b004:l017","ordinal":95514,"en":"When he comes down the slope,"},{"id":"semetey-1-2013:p0245:b004:l018","ordinal":95515,"en":"For a racer like Taytoru,"},{"id":"semetey-1-2013:p0245:b004:l019","ordinal":95516,"en":"Let me raise a cry of encouragement."},{"id":"semetey-1-2013:p0245:b004:l020","ordinal":95517,"en":"Crying out, let me take the lead rope;"},{"id":"semetey-1-2013:p0245:b004:l021","ordinal":95518,"en":"Let me open my mouth like a gaping maw."},{"id":"semetey-1-2013:p0245:b004:l022","ordinal":95519,"en":"The mallet-like flesh of my white breasts,"},{"id":"semetey-1-2013:p0245:b004:l023","ordinal":95520,"en":"Let me bring down and press."},{"id":"semetey-1-2013:p0245:b004:l024","ordinal":95521,"en":"Let me urge my Taytoru on."},{"id":"semetey-1-2013:p0245:b004:l025","ordinal":95522,"en":"If Tory does not win here,"},{"id":"semetey-1-2013:p0245:b004:l026","ordinal":95523,"en":"Let me die before my appointed death."},{"id":"semetey-1-2013:p0245:b004:l027","ordinal":95524,"en":"The measured weapon, Aktinte,"},{"id":"semetey-1-2013:p0245:b004:l028","ordinal":95525,"en":"Let me draw from its sheath."},{"id":"semetey-1-2013:p0245:b004:l029","ordinal":95526,"en":"Rather than hear, 'That damned woman,'"},{"id":"semetey-1-2013:p0245:b004:l030","ordinal":95527,"en":"And become gossip among the sovereign's people,"},{"id":"semetey-1-2013:p0245:b004:l031","ordinal":95528,"en":"This life of mine here,"},{"id":"semetey-1-2013:p0245:b004:l032","ordinal":95529,"en":"Let me offer as a sacrifice.\""},{"id":"semetey-1-2013:p0245:b004:l033","ordinal":95530,"en":"So spoke your sister-in-law"},{"id":"semetey-1-2013:p0245:b004:l034","ordinal":95531,"en":"And summoned her courage."},{"id":"semetey-1-2013:p0245:b004:l035","ordinal":95532,"en":"Yesterday, when valiant Manas died,"},{"id":"semetey-1-2013:p0245:b004:l036","ordinal":95533,"en":"When your mother suffered anguish,"},{"id":"semetey-1-2013:p0245:b004:l037","ordinal":95534,"en":"The base dogs whose hearts had turned wicked,"},{"id":"semetey-1-2013:p0245:b004:l038","ordinal":95535,"en":"The countless riches left by the warrior—"},{"id":"semetey-1-2013:p0245:b004:l039","ordinal":95536,"en":"When they divided them every which way,"},{"id":"semetey-1-2013:p0246:b003:l001","ordinal":95537,"en":"Your valiant mother Kanykei,"},{"id":"semetey-1-2013:p0246:b003:l002","ordinal":95538,"en":"When she suffered such anguish,"},{"id":"semetey-1-2013:p0246:b003:l003","ordinal":95539,"en":"When her leopard died,"},{"id":"semetey-1-2013:p0246:b003:l004","ordinal":95540,"en":"Those accursed fools"},{"id":"semetey-1-2013:p0246:b003:l005","ordinal":95541,"en":"Drew their bows like rain,"},{"id":"semetey-1-2013:p0246:b003:l006","ordinal":95542,"en":"Fired their shots like hail."},{"id":"semetey-1-2013:p0246:b003:l007","ordinal":95543,"en":"The countless riches left by the lion,"},{"id":"semetey-1-2013:p0246:b003:l008","ordinal":95544,"en":"Those foolish dogs divided."},{"id":"semetey-1-2013:p0246:b003:l009","ordinal":95545,"en":"Countless humiliations—"},{"id":"semetey-1-2013:p0246:b003:l010","ordinal":95546,"en":"When your poor mother suffered them,"},{"id":"semetey-1-2013:p0246:b003:l011","ordinal":95547,"en":"She firmly devised her plan."},{"id":"semetey-1-2013:p0246:b003:l012","ordinal":95548,"en":"\"You will not marry me?\" he said, dragging her;"},{"id":"semetey-1-2013:p0246:b003:l013","ordinal":95549,"en":"When he struck and split her breast,"},{"id":"semetey-1-2013:p0246:b003:l014","ordinal":95550,"en":"Your noble mother Kanykei"},{"id":"semetey-1-2013:p0246:b003:l015","ordinal":95551,"en":"Merciless terror"},{"id":"semetey-1-2013:p0246:b003:l016","ordinal":95552,"en":"Did indeed inflict."},{"id":"semetey-1-2013:p0246:b003:l017","ordinal":95553,"en":"Unable to find Manas's Akkelte,"},{"id":"semetey-1-2013:p0246:b003:l018","ordinal":95554,"en":"Almambet's Syrbarang,"},{"id":"semetey-1-2013:p0246:b003:l019","ordinal":95555,"en":"Leaning upon it as a staff,"},{"id":"semetey-1-2013:p0246:b003:l020","ordinal":95556,"en":"Your noble mother Kanykei"},{"id":"semetey-1-2013:p0246:b003:l021","ordinal":95557,"en":"Had brought along!"},{"id":"semetey-1-2013:p0246:b003:l022","ordinal":95558,"en":"Left behind then,"},{"id":"semetey-1-2013:p0246:b003:l023","ordinal":95559,"en":"Bereft of her fierce warrior,"},{"id":"semetey-1-2013:p0246:b003:l024","ordinal":95560,"en":"At the age of thirty-two,"},{"id":"semetey-1-2013:p0246:b003:l025","ordinal":95561,"en":"The five who faced her"},{"id":"semetey-1-2013:p0246:b003:l026","ordinal":95562,"en":"She had indeed slain."},{"id":"semetey-1-2013:p0246:b003:l027","ordinal":95563,"en":"Long-suffering Kanykei,"},{"id":"semetey-1-2013:p0246:b003:l028","ordinal":95564,"en":"\"I shall keep it as a keepsake,\" she said."},{"id":"semetey-1-2013:p0246:b003:l029","ordinal":95565,"en":"Almambet's Syrbarang—"},{"id":"semetey-1-2013:p0246:b003:l030","ordinal":95566,"en":"Your sister-in-law deliberately"},{"id":"semetey-1-2013:p0246:b003:l031","ordinal":95567,"en":"Had brought it along!"},{"id":"semetey-1-2013:p0246:b003:l032","ordinal":95568,"en":"When slung across the back, Syrbarang"},{"id":"semetey-1-2013:p0246:b003:l033","ordinal":95569,"en":"Was the mirror of the shoulder blades."},{"id":"semetey-1-2013:p0246:b003:l034","ordinal":95570,"en":"When going out to exchange fire with the foe,"},{"id":"semetey-1-2013:p0246:b003:l035","ordinal":95571,"en":"It was the comfort of a life held in trust."},{"id":"semetey-1-2013:p0246:b003:l036","ordinal":95572,"en":"The thick-mouthed Apple-Head,"},{"id":"semetey-1-2013:p0246:b003:l037","ordinal":95573,"en":"Made no distinction between near and far;"},{"id":"semetey-1-2013:p0246:b003:l038","ordinal":95574,"en":"It grew stronger with every shot."},{"id":"semetey-1-2013:p0246:b003:l039","ordinal":95575,"en":"The invading enemy fled hard,"},{"id":"semetey-1-2013:p0246:b004:l001","ordinal":95576,"en":"Yet never left it unchallenged."},{"id":"semetey-1-2013:p0246:b004:l002","ordinal":95577,"en":"It made no distinction between near and far."},{"id":"semetey-1-2013:p0246:b004:l003","ordinal":95578,"en":"When the true exchange of fire began,"},{"id":"semetey-1-2013:p0246:b004:l004","ordinal":95579,"en":"No enemy remained without fleeing."},{"id":"semetey-1-2013:p0246:b004:l005","ordinal":95580,"en":"Leaning to the right, he fired once"},{"id":"semetey-1-2013:p0246:b004:l006","ordinal":95581,"en":"And felled the one he aimed at."},{"id":"semetey-1-2013:p0246:b004:l007","ordinal":95582,"en":"Beaded hat-buttons and coral stones,"},{"id":"semetey-1-2013:p0246:b004:l008","ordinal":95583,"en":"Mingled with the village headman's blood—"},{"id":"semetey-1-2013:p0246:b004:l009","ordinal":95584,"en":"Making his golden throne greasy,"},{"id":"semetey-1-2013:p0246:b004:l010","ordinal":95585,"en":"Dear Almambet, beginning with his father,"},{"id":"semetey-1-2013:p0246:b004:l011","ordinal":95586,"en":"Slew six hundred."},{"id":"semetey-1-2013:p0246:b004:l012","ordinal":95587,"en":"Dear Almambet fled Beijing;"},{"id":"semetey-1-2013:p0246:b004:l013","ordinal":95588,"en":"Heaps of treasure, countless gold,"},{"id":"semetey-1-2013:p0246:b004:l014","ordinal":95589,"en":"Your Almambet scattered as he fled."},{"id":"semetey-1-2013:p0246:b004:l015","ordinal":95590,"en":"Fighting ninety days without rest,"},{"id":"semetey-1-2013:p0246:b004:l016","ordinal":95591,"en":"When your Almambet escaped,"},{"id":"semetey-1-2013:p0246:b004:l017","ordinal":95592,"en":"Growing stronger when brought into a firefight,"},{"id":"semetey-1-2013:p0246:b004:l018","ordinal":95593,"en":"Almambet's Syrbarang"},{"id":"semetey-1-2013:p0246:b004:l019","ordinal":95594,"en":"Was the lock that guarded a life held in trust."},{"id":"semetey-1-2013:p0246:b004:l020","ordinal":95595,"en":"Upon Beijing, dear Almambet,"},{"id":"semetey-1-2013:p0246:b004:l021","ordinal":95596,"en":"Terror such as no one had seen,"},{"id":"semetey-1-2013:p0246:b004:l022","ordinal":95597,"en":"Had indeed brought down then."},{"id":"semetey-1-2013:p0246:b004:l023","ordinal":95598,"en":"The wondrous incantation,"},{"id":"semetey-1-2013:p0246:b004:l024","ordinal":95599,"en":"As your Almambet recited it,"},{"id":"semetey-1-2013:p0246:b004:l025","ordinal":95600,"en":"Karykan, khan of Kakan,"},{"id":"semetey-1-2013:p0246:b004:l026","ordinal":95601,"en":"Came in alarm."},{"id":"semetey-1-2013:p0246:b004:l027","ordinal":95602,"en":"Two reins and one lead rope,"},{"id":"semetey-1-2013:p0246:b004:l028","ordinal":95603,"en":"When he managed to take them in hand,"},{"id":"semetey-1-2013:p0246:b004:l029","ordinal":95604,"en":"\"I too am a khan's son,\" he said."},{"id":"semetey-1-2013:p0246:b004:l030","ordinal":95605,"en":"In the Kakan khan's Beijing,"},{"id":"semetey-1-2013:p0246:b004:l031","ordinal":95606,"en":"When he wrought a terrible slaughter,"},{"id":"semetey-1-2013:p0246:b004:l032","ordinal":95607,"en":"Contending for the khanship,"},{"id":"semetey-1-2013:p0246:b004:l033","ordinal":95608,"en":"The Chinese who worshipped stone,"},{"id":"semetey-1-2013:p0246:b004:l034","ordinal":95609,"en":"When he slew them utterly,"},{"id":"semetey-1-2013:p0246:b004:l035","ordinal":95610,"en":"The Chinese in sleeveless coats,"},{"id":"semetey-1-2013:p0246:b004:l036","ordinal":95611,"en":"Fighting the strongest among them,"},{"id":"semetey-1-2013:p0246:b004:l037","ordinal":95612,"en":"When dear Almambet was in Beijing,"},{"id":"semetey-1-2013:p0246:b004:l038","ordinal":95613,"en":"On the plain of Orgo-Beijing,"},{"id":"semetey-1-2013:p0246:b004:l039","ordinal":95614,"en":"In the city on this nearer side,"},{"id":"semetey-1-2013:p0247:b003:l001","ordinal":95615,"en":"With a white musket, a red ember,"},{"id":"semetey-1-2013:p0247:b003:l002","ordinal":95616,"en":"Kongurbay, son of Alööke,"},{"id":"semetey-1-2013:p0247:b003:l003","ordinal":95617,"en":"Was their famous warrior."},{"id":"semetey-1-2013:p0247:b003:l004","ordinal":95618,"en":"In the fortress of Beijing,"},{"id":"semetey-1-2013:p0247:b003:l005","ordinal":95619,"en":"Almambet, son of Azozyl,"},{"id":"semetey-1-2013:p0247:b003:l006","ordinal":95620,"en":"When he turned twelve,"},{"id":"semetey-1-2013:p0247:b003:l007","ordinal":95621,"en":"The tip of the spear bent."},{"id":"semetey-1-2013:p0247:b003:l008","ordinal":95622,"en":"Kongurbay, son of Alööke—"},{"id":"semetey-1-2013:p0247:b003:l009","ordinal":95623,"en":"Six thousand Chinese, countless governors—"},{"id":"semetey-1-2013:p0247:b003:l010","ordinal":95624,"en":"If you ask for their greatest warrior,"},{"id":"semetey-1-2013:p0247:b003:l011","ordinal":95625,"en":"He raged upon Algara,"},{"id":"semetey-1-2013:p0247:b003:l012","ordinal":95626,"en":"Kongurbay, son of Alööke."},{"id":"semetey-1-2013:p0247:b003:l013","ordinal":95627,"en":"When God granted his wish,"},{"id":"semetey-1-2013:p0247:b003:l014","ordinal":95628,"en":"When Almambet reached twelve,"},{"id":"semetey-1-2013:p0247:b003:l016","ordinal":95629,"en":"Because of Khan-Jaylak,"},{"id":"semetey-1-2013:p0247:b003:l017","ordinal":95630,"en":"Over the matter of the gold mine,"},{"id":"semetey-1-2013:p0247:b003:l018","ordinal":95631,"en":"They barely escaped death."},{"id":"semetey-1-2013:p0247:b003:l019","ordinal":95632,"en":"Kongurbay and Almambet"},{"id":"semetey-1-2013:p0247:b003:l020","ordinal":95633,"en":"Fought with spears for twelve days."},{"id":"semetey-1-2013:p0247:b003:l021","ordinal":95634,"en":"Merciless torment,"},{"id":"semetey-1-2013:p0247:b003:l022","ordinal":95635,"en":"Your lord, dear Almambet, upon Beijing"},{"id":"semetey-1-2013:p0247:b003:l023","ordinal":95636,"en":"Had indeed inflicted."},{"id":"semetey-1-2013:p0247:b003:l024","ordinal":95637,"en":"Kongurbay, son of Alööke,"},{"id":"semetey-1-2013:p0247:b003:l025","ordinal":95638,"en":"Six times from his horse—"},{"id":"semetey-1-2013:p0247:b003:l026","ordinal":95639,"en":"Almambet, son of Azyz Khan,"},{"id":"semetey-1-2013:p0247:b003:l027","ordinal":95640,"en":"Six times upon the open plain,"},{"id":"semetey-1-2013:p0247:b003:l028","ordinal":95641,"en":"Your Almambet had unseated him with his spear."},{"id":"semetey-1-2013:p0247:b003:l029","ordinal":95642,"en":"Warrior Kongurbay, that mighty, fearsome man,"},{"id":"semetey-1-2013:p0247:b003:l030","ordinal":95643,"en":"When he had grown weary,"},{"id":"semetey-1-2013:p0247:b003:l031","ordinal":95644,"en":"At Esenkan's gate,"},{"id":"semetey-1-2013:p0247:b003:l032","ordinal":95645,"en":"Warrior Almambet, your fierce one,"},{"id":"semetey-1-2013:p0247:b003:l033","ordinal":95646,"en":"That fearsome man Kongurbay,"},{"id":"semetey-1-2013:p0247:b003:l034","ordinal":95647,"en":"When he had trapped him there,"},{"id":"semetey-1-2013:p0247:b003:l035","ordinal":95648,"en":"When he turned Sarala's head,"},{"id":"semetey-1-2013:p0247:b003:l036","ordinal":95649,"en":"Of Beijing's forty Chinese clans,"},{"id":"semetey-1-2013:p0247:b003:l037","ordinal":95650,"en":"\"Give me one khanship!\" he said."},{"id":"semetey-1-2013:p0247:b003:l038","ordinal":95651,"en":"When he advanced and laid siege,"},{"id":"semetey-1-2013:p0247:b003:l039","ordinal":95652,"en":"That your Almambet was a hero,"},{"id":"semetey-1-2013:p0247:b004:l001","ordinal":95653,"en":"They had indeed seen."},{"id":"semetey-1-2013:p0247:b004:l002","ordinal":95654,"en":"Then Syrbarang, which guarded the throne,"},{"id":"semetey-1-2013:p0247:b004:l003","ordinal":95655,"en":"The great gun of the treasury,"},{"id":"semetey-1-2013:p0247:b004:l004","ordinal":95656,"en":"As a gift, Esenkan"},{"id":"semetey-1-2013:p0247:b004:l005","ordinal":95657,"en":"To dear Almambet himself"},{"id":"semetey-1-2013:p0247:b004:l006","ordinal":95658,"en":"Had indeed given."},{"id":"semetey-1-2013:p0247:b004:l007","ordinal":95659,"en":"When she took it from her shoulder and looked,"},{"id":"semetey-1-2013:p0247:b004:l009","ordinal":95660,"en":"Unfired for twelve years,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0247:b004:l010","ordinal":95661,"en":"Its inside filthy as a dog's,"},{"id":"semetey-1-2013:p0247:b004:l011","ordinal":95662,"en":"The rust within it"},{"id":"semetey-1-2013:p0247:b004:l012","ordinal":95663,"en":"Had become one with its interior:"},{"id":"semetey-1-2013:p0247:b004:l013","ordinal":95664,"en":"So Syrbarang had been left."},{"id":"semetey-1-2013:p0247:b004:l014","ordinal":95665,"en":"Then Kanykei said:"},{"id":"semetey-1-2013:p0247:b004:l015","ordinal":95666,"en":"\"My dear Syrbarang,"},{"id":"semetey-1-2013:p0247:b004:l016","ordinal":95667,"en":"You are a widow bereft of your master,"},{"id":"semetey-1-2013:p0247:b004:l017","ordinal":95668,"en":"I am a widow bereft of my husband.\""},{"id":"semetey-1-2013:p0247:b004:l018","ordinal":95669,"en":"Saying these words then,"},{"id":"semetey-1-2013:p0247:b004:l019","ordinal":95670,"en":"She, that truly capable slavewoman,"},{"id":"semetey-1-2013:p0247:b004:l020","ordinal":95671,"en":"Into Syrbarang's mouth"},{"id":"semetey-1-2013:p0247:b004:l021","ordinal":95672,"en":"Now pushed the great scraper."},{"id":"semetey-1-2013:p0247:b004:l022","ordinal":95673,"en":"She scraped with the scraper,"},{"id":"semetey-1-2013:p0247:b004:l023","ordinal":95674,"en":"Worked fiercely, scouring its inside,"},{"id":"semetey-1-2013:p0247:b004:l024","ordinal":95675,"en":"Drew the cleaning rod back and forth,"},{"id":"semetey-1-2013:p0247:b004:l025","ordinal":95676,"en":"Cleaned and wiped its inside,"},{"id":"semetey-1-2013:p0247:b004:l026","ordinal":95677,"en":"Scoured it with the ramrod."},{"id":"semetey-1-2013:p0247:b004:l027","ordinal":95678,"en":"Your tigress sister-in-law Kanykei,"},{"id":"semetey-1-2013:p0247:b004:l028","ordinal":95679,"en":"Almambet's Syrbarang,"},{"id":"semetey-1-2013:p0247:b004:l029","ordinal":95680,"en":"Worked upon it with all her strength."},{"id":"semetey-1-2013:p0247:b004:l030","ordinal":95681,"en":"The reason she could clean it was this:"},{"id":"semetey-1-2013:p0247:b004:l031","ordinal":95682,"en":"Dividing the hair down her back in ten,"},{"id":"semetey-1-2013:p0247:b004:l032","ordinal":95683,"en":"Your sister-in-law had braided it."},{"id":"semetey-1-2013:p0247:b004:l033","ordinal":95684,"en":"While her magnanimous Manas lived,"},{"id":"semetey-1-2013:p0247:b004:l034","ordinal":95685,"en":"Cleaning Akkelte,"},{"id":"semetey-1-2013:p0247:b004:l035","ordinal":95686,"en":"An expert with a gun,"},{"id":"semetey-1-2013:p0247:b004:l036","ordinal":95687,"en":"Your sister-in-law had become."},{"id":"semetey-1-2013:p0247:b004:l037","ordinal":95688,"en":"All the many things he needed,"},{"id":"semetey-1-2013:p0247:b004:l038","ordinal":95689,"en":"She had made in abundance for Manas"},{"id":"semetey-1-2013:p0247:b004:l039","ordinal":95690,"en":"And given them to him."},{"id":"semetey-1-2013:p0248:b003:l001","ordinal":95691,"en":"(She often mended what was broken,"},{"id":"semetey-1-2013:p0248:b003:l002","ordinal":95692,"en":"Often gathered what was scattered,"},{"id":"semetey-1-2013:p0248:b003:l003","ordinal":95693,"en":"Never sat idly looking on,"},{"id":"semetey-1-2013:p0248:b003:l004","ordinal":95694,"en":"But kept warrior Manas safe.)"},{"id":"semetey-1-2013:p0248:b003:l005","ordinal":95695,"en":"Having cleaned Syrbarang inside,"},{"id":"semetey-1-2013:p0248:b003:l006","ordinal":95696,"en":"Your poor, unfortunate sister-in-law"},{"id":"semetey-1-2013:p0248:b003:l007","ordinal":95697,"en":"The powder from its box"},{"id":"semetey-1-2013:p0248:b003:l008","ordinal":95698,"en":"Let fall with a rattle,"},{"id":"semetey-1-2013:p0248:b003:l009","ordinal":95699,"en":"Tipped it toward the muzzle,"},{"id":"semetey-1-2013:p0248:b003:l010","ordinal":95700,"en":"And checked Borchuk's head."},{"id":"semetey-1-2013:p0248:b003:l011","ordinal":95701,"en":"Preparing a blank charge,"},{"id":"semetey-1-2013:p0248:b003:l012","ordinal":95702,"en":"She poured in dry powder."},{"id":"semetey-1-2013:p0248:b003:l013","ordinal":95703,"en":"The familiar great ramrod,"},{"id":"semetey-1-2013:p0248:b003:l014","ordinal":95704,"en":"Your sister-in-law took and turned,"},{"id":"semetey-1-2013:p0248:b003:l015","ordinal":95705,"en":"And drove toward the muzzle."},{"id":"semetey-1-2013:p0248:b003:l016","ordinal":95706,"en":"Working with the ramrod,"},{"id":"semetey-1-2013:p0248:b003:l017","ordinal":95707,"en":"The cock that fired so swiftly,"},{"id":"semetey-1-2013:p0248:b003:l018","ordinal":95708,"en":"She held up and drew back."},{"id":"semetey-1-2013:p0248:b003:l019","ordinal":95709,"en":"Your sister-in-law, unhurried,"},{"id":"semetey-1-2013:p0248:b003:l020","ordinal":95710,"en":"Worked it with the ramrod,"},{"id":"semetey-1-2013:p0248:b003:l021","ordinal":95711,"en":"Tapped its great stock,"},{"id":"semetey-1-2013:p0248:b003:l022","ordinal":95712,"en":"Against the pommel of the broad saddle"},{"id":"semetey-1-2013:p0248:b003:l023","ordinal":95713,"en":"Knocking it with sharp cracks."},{"id":"semetey-1-2013:p0248:b003:l024","ordinal":95714,"en":"Leaning back in the saddle,"},{"id":"semetey-1-2013:p0248:b003:l025","ordinal":95715,"en":"The powder that came from the stock"},{"id":"semetey-1-2013:p0248:b003:l026","ordinal":95716,"en":"She broke up with her fingernail."},{"id":"semetey-1-2013:p0248:b003:l027","ordinal":95717,"en":"The Chinese fire-steel and flint,"},{"id":"semetey-1-2013:p0248:b003:l028","ordinal":95718,"en":"She struck, setting a spark,"},{"id":"semetey-1-2013:p0248:b003:l029","ordinal":95719,"en":"And lit its match."},{"id":"semetey-1-2013:p0248:b003:l030","ordinal":95720,"en":"Your noble sister-in-law Kanykei,"},{"id":"semetey-1-2013:p0248:b003:l031","ordinal":95721,"en":"Crying, \"O God!\""},{"id":"semetey-1-2013:p0248:b003:l032","ordinal":95722,"en":"Turned Akborchuk's head."},{"id":"semetey-1-2013:p0248:b003:l033","ordinal":95723,"en":"With a blank charge,"},{"id":"semetey-1-2013:p0248:b003:l034","ordinal":95724,"en":"That unfortunate woman Kanykei"},{"id":"semetey-1-2013:p0248:b003:l035","ordinal":95725,"en":"Extended Syrbarang."},{"id":"semetey-1-2013:p0248:b003:l036","ordinal":95726,"en":"Your immensely strong mother"},{"id":"semetey-1-2013:p0248:b003:l037","ordinal":95727,"en":"Judged the ground before her."},{"id":"semetey-1-2013:p0248:b003:l038","ordinal":95728,"en":"When she looked at Taytoru,"},{"id":"semetey-1-2013:p0248:b003:l039","ordinal":95729,"en":"On the ridge of Jeti-Moynok,"},{"id":"semetey-1-2013:p0248:b004:l001","ordinal":95730,"en":"Your racer was coming,"},{"id":"semetey-1-2013:p0248:b004:l002","ordinal":95731,"en":"Behind Temir Khan's three horses."},{"id":"semetey-1-2013:p0248:b004:l003","ordinal":95732,"en":"When she saw Taytoru,"},{"id":"semetey-1-2013:p0248:b004:l004","ordinal":95733,"en":"She wept and beat herself,"},{"id":"semetey-1-2013:p0248:b004:l005","ordinal":95734,"en":"Implored the one God."},{"id":"semetey-1-2013:p0248:b004:l006","ordinal":95735,"en":"To fire with a cry of encouragement,"},{"id":"semetey-1-2013:p0248:b004:l007","ordinal":95736,"en":"To draw Taytoru onward,"},{"id":"semetey-1-2013:p0248:b004:l008","ordinal":95737,"en":"She put her belt around her neck."},{"id":"semetey-1-2013:p0248:b004:l009","ordinal":95738,"en":"The poor soul wailed and wept,"},{"id":"semetey-1-2013:p0248:b004:l010","ordinal":95739,"en":"Imploring the Creator."},{"id":"semetey-1-2013:p0248:b004:l011","ordinal":95740,"en":"With a blank charge,"},{"id":"semetey-1-2013:p0248:b004:l012","ordinal":95741,"en":"That unfortunate woman Kanykei,"},{"id":"semetey-1-2013:p0248:b004:l013","ordinal":95742,"en":"Preparing herself for Taytoru,"},{"id":"semetey-1-2013:p0248:b004:l014","ordinal":95743,"en":"Struck the kettledrum once,"},{"id":"semetey-1-2013:p0248:b004:l015","ordinal":95744,"en":"Surpassing herself in valor."}]
