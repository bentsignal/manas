[{"id":"seytek-2012:p0870:b003:l011","ordinal":361217,"en":"Those who grazed the black earth and saw the sun"},{"id":"seytek-2012:p0870:b003:l012","ordinal":361218,"en":"Despaired of livestock and life;"},{"id":"seytek-2012:p0870:b003:l013","ordinal":361219,"en":"Worms, insects, and every creature"},{"id":"seytek-2012:p0870:b003:l014","ordinal":361220,"en":"Despaired of their lives."},{"id":"seytek-2012:p0870:b003:l015","ordinal":361221,"en":"He fully unleashed his venom,"},{"id":"seytek-2012:p0870:b003:l016","ordinal":361222,"en":"And it engulfed the whole world."},{"id":"seytek-2012:p0870:b003:l017","ordinal":361223,"en":"Hearing it clearly, Sarybai"},{"id":"seytek-2012:p0870:b003:l018","ordinal":361224,"en":"Poured out his wrath like this;"},{"id":"seytek-2012:p0870:b003:l019","ordinal":361225,"en":"He doubled so many over"},{"id":"seytek-2012:p0870:b003:l020","ordinal":361226,"en":"That the black earth could not stir,"},{"id":"seytek-2012:p0870:b003:l021","ordinal":361227,"en":"And the great multitude halted."},{"id":"seytek-2012:p0870:b003:l022","ordinal":361228,"en":"When the warrior stood roaring,"},{"id":"seytek-2012:p0870:b003:l023","ordinal":361229,"en":"When he shouted his command,"},{"id":"seytek-2012:p0870:b003:l024","ordinal":361230,"en":"Heads spun in bewilderment,"},{"id":"seytek-2012:p0870:b003:l025","ordinal":361231,"en":"And the world filled with dust."},{"id":"seytek-2012:p0870:b003:l026","ordinal":361232,"en":"When he raged and lunged,"},{"id":"seytek-2012:p0870:b003:l027","ordinal":361233,"en":"He began a mighty upheaval;"},{"id":"seytek-2012:p0870:b003:l028","ordinal":361234,"en":"Under the force of his fury, many men"},{"id":"seytek-2012:p0870:b003:l029","ordinal":361235,"en":"Were left without a single hair,"},{"id":"seytek-2012:p0870:b003:l030","ordinal":361236,"en":"And began to perish."},{"id":"seytek-2012:p0870:b003:l031","ordinal":361237,"en":"Startled by the words he had heard,"},{"id":"seytek-2012:p0870:b003:l032","ordinal":361238,"en":"He saddled the peerless steed Tookyzyl,"},{"id":"seytek-2012:p0870:b003:l033","ordinal":361239,"en":"Saddling Tookyzyl for battle;"},{"id":"seytek-2012:p0870:b003:l034","ordinal":361240,"en":"He seized his cannon and roared,"},{"id":"seytek-2012:p0870:b003:l035","ordinal":361241,"en":"Summoning those skilled at mounting horses,"},{"id":"seytek-2012:p0870:b003:l036","ordinal":361242,"en":"The strong men resourceful in danger,"},{"id":"seytek-2012:p0870:b003:l037","ordinal":361243,"en":"The tents that sheltered them from the cold,"},{"id":"seytek-2012:p0870:b003:l038","ordinal":361244,"en":"Every hero’s stratagem,"},{"id":"seytek-2012:p0870:b003:l039","ordinal":361245,"en":"And warriors who came without being summoned—"},{"id":"seytek-2012:p0870:b003:l040","ordinal":361246,"en":"United in soul, sharing death together."},{"id":"seytek-2012:p0871:b002:l001","ordinal":361247,"en":"If he dies, we share one blood,"},{"id":"seytek-2012:p0871:b002:l002","ordinal":361248,"en":"While alive, we are fellow countrymen,"},{"id":"seytek-2012:p0871:b002:l003","ordinal":361249,"en":"While safe, we are companions,"},{"id":"seytek-2012:p0871:b002:l004","ordinal":361250,"en":"Sharing one name, we are comrades,"},{"id":"seytek-2012:p0871:b002:l005","ordinal":361251,"en":"Sharing our gains, we are neighbors,"},{"id":"seytek-2012:p0871:b002:l006","ordinal":361252,"en":"While safe, we gather together,"},{"id":"seytek-2012:p0871:b002:l007","ordinal":361253,"en":"While alive, we are companions,"},{"id":"seytek-2012:p0871:b002:l008","ordinal":361254,"en":"We have slept in one bed,"},{"id":"seytek-2012:p0871:b002:l009","ordinal":361255,"en":"We have shared the same delights,"},{"id":"seytek-2012:p0871:b002:l010","ordinal":361256,"en":"We have hunted game together,"},{"id":"seytek-2012:p0871:b002:l011","ordinal":361257,"en":"We grew up from childhood,"},{"id":"seytek-2012:p0871:b002:l012","ordinal":361258,"en":"We lived badly, then prospered,"},{"id":"seytek-2012:p0871:b002:l013","ordinal":361259,"en":"We lived poor, then grew rich,"},{"id":"seytek-2012:p0871:b002:l014","ordinal":361260,"en":"We went without, then gained abundance,"},{"id":"seytek-2012:p0871:b002:l015","ordinal":361261,"en":"Our camps stood side by side,"},{"id":"seytek-2012:p0871:b002:l016","ordinal":361262,"en":"Our valleys were shared,"},{"id":"seytek-2012:p0871:b002:l017","ordinal":361263,"en":"If safe, we shall gather together,"},{"id":"seytek-2012:p0871:b002:l018","ordinal":361264,"en":"If alive, we shall be companions,"},{"id":"seytek-2012:p0871:b002:l019","ordinal":361265,"en":"Come share counsel, come, my lion,"},{"id":"seytek-2012:p0871:b002:l020","ordinal":361266,"en":"Every grief and grievous pain—"},{"id":"seytek-2012:p0871:b002:l021","ordinal":361267,"en":"Come, my hero, resolve it now,"},{"id":"seytek-2012:p0871:b002:l022","ordinal":361268,"en":"This is my word—behold:"},{"id":"seytek-2012:p0871:b002:l023","ordinal":361269,"en":"For God's sake and for mine,"},{"id":"seytek-2012:p0871:b002:l024","ordinal":361270,"en":"I shall gladly meet them in combat,"},{"id":"seytek-2012:p0871:b002:l025","ordinal":361271,"en":"Though the people wail and heroes die,"},{"id":"seytek-2012:p0871:b002:l026","ordinal":361272,"en":"Though all are utterly spent,"},{"id":"seytek-2012:p0871:b002:l027","ordinal":361273,"en":"Stand behind me as my support,"},{"id":"seytek-2012:p0871:b002:l028","ordinal":361274,"en":"I shall attack Külchoro,"},{"id":"seytek-2012:p0871:b002:l029","ordinal":361275,"en":"I shall unleash my wrath on Seytek,"},{"id":"seytek-2012:p0871:b002:l030","ordinal":361276,"en":"I shall bring slaughter upon the Kyrgyz,"},{"id":"seytek-2012:p0871:b002:l031","ordinal":361277,"en":"I shall summon strength into my arms,"},{"id":"seytek-2012:p0871:b002:l032","ordinal":361278,"en":"If she falls into my hands, I shall humiliate her,"},{"id":"seytek-2012:p0871:b002:l033","ordinal":361279,"en":"I shall violate Chürök,"},{"id":"seytek-2012:p0871:b002:l034","ordinal":361280,"en":"Brave men, old and young,"},{"id":"seytek-2012:p0871:b002:l035","ordinal":361281,"en":"Say, “Sarybay has given the command,”"},{"id":"seytek-2012:p0871:b002:l036","ordinal":361282,"en":"Do not grieve; satisfy your desire,"},{"id":"seytek-2012:p0871:b002:l037","ordinal":361283,"en":"Let one of the seven days bring death,"},{"id":"seytek-2012:p0871:b002:l038","ordinal":361284,"en":"Why should I live on in vain?"},{"id":"seytek-2012:p0871:b002:l039","ordinal":361285,"en":"Let me gladly meet them, thrusting spears,"},{"id":"seytek-2012:p0871:b002:l040","ordinal":361286,"en":"Let us grapple violently,"},{"id":"seytek-2012:p0871:b003:l001","ordinal":361287,"en":"Let me perish fighting to the end,"},{"id":"seytek-2012:p0871:b003:l002","ordinal":361288,"en":"Aichürök is the one I desire,"},{"id":"seytek-2012:p0871:b003:l003","ordinal":361289,"en":"Kuyaly, on whom my enemies have set their sights,"},{"id":"seytek-2012:p0871:b003:l004","ordinal":361290,"en":"That radiant beauty—"},{"id":"seytek-2012:p0871:b003:l005","ordinal":361291,"en":"I shall ride straight at her and seize her,"},{"id":"seytek-2012:p0871:b003:l006","ordinal":361292,"en":"If turmoil and strife erupt on every side,"},{"id":"seytek-2012:p0871:b003:l007","ordinal":361293,"en":"Drawing bows like pouring rain,"},{"id":"seytek-2012:p0871:b003:l008","ordinal":361294,"en":"Shooting arrows like hail,"},{"id":"seytek-2012:p0871:b003:l009","ordinal":361295,"en":"When the lion's eyes blaze,"},{"id":"seytek-2012:p0871:b003:l010","ordinal":361296,"en":"When his blood-drinking frenzy seizes him,"},{"id":"seytek-2012:p0871:b003:l011","ordinal":361297,"en":"I shall settle the score in full,"},{"id":"seytek-2012:p0871:b003:l012","ordinal":361298,"en":"Making the Kyrgyz shriek,"},{"id":"seytek-2012:p0871:b003:l013","ordinal":361299,"en":"I shall drive them away and plunder them,"},{"id":"seytek-2012:p0871:b003:l014","ordinal":361300,"en":"If Külchoro struts,"},{"id":"seytek-2012:p0871:b003:l015","ordinal":361301,"en":"I shall beat the old madness from him,"},{"id":"seytek-2012:p0871:b003:l016","ordinal":361302,"en":"If the Kyrgyz roar,"},{"id":"seytek-2012:p0871:b003:l017","ordinal":361303,"en":"I shall divert the water from their riverbed,"},{"id":"seytek-2012:p0871:b003:l018","ordinal":361304,"en":"If they boast of their young hero,"},{"id":"seytek-2012:p0871:b003:l019","ordinal":361305,"en":"I shall snuff him out like a fire,"},{"id":"seytek-2012:p0871:b003:l020","ordinal":361306,"en":"Thus spoke Sarybay,"},{"id":"seytek-2012:p0871:b003:l021","ordinal":361307,"en":"Making the wide world narrow as a grain,"},{"id":"seytek-2012:p0871:b003:l022","ordinal":361308,"en":"Such was his furious state,"},{"id":"seytek-2012:p0871:b003:l023","ordinal":361309,"en":"Unable to withstand his wrath,"},{"id":"seytek-2012:p0871:b003:l024","ordinal":361310,"en":"The whole vast army marched out,"},{"id":"seytek-2012:p0871:b003:l025","ordinal":361311,"en":"From the dreadful rage of that swine,"},{"id":"seytek-2012:p0871:b003:l026","ordinal":361312,"en":"His very flesh bristled,"},{"id":"seytek-2012:p0871:b003:l027","ordinal":361313,"en":"His eyes sank deep as pits,"},{"id":"seytek-2012:p0871:b003:l028","ordinal":361314,"en":"When that swine flew into a frenzy,"},{"id":"seytek-2012:p0871:b003:l029","ordinal":361315,"en":"Unable to withstand his wrath,"},{"id":"seytek-2012:p0871:b003:l030","ordinal":361316,"en":"Of the scouts standing watch,"},{"id":"seytek-2012:p0871:b003:l031","ordinal":361317,"en":"Several were slaughtered,"},{"id":"seytek-2012:p0871:b003:l032","ordinal":361318,"en":"Whatever he faced became flame,"},{"id":"seytek-2012:p0871:b003:l033","ordinal":361319,"en":"Whatever he attacked ceased to exist,"},{"id":"seytek-2012:p0871:b003:l034","ordinal":361320,"en":"Nothing remained for him to behold,"},{"id":"seytek-2012:p0871:b003:l035","ordinal":361321,"en":"Those he routed came to a halt,"},{"id":"seytek-2012:p0871:b003:l036","ordinal":361322,"en":"Such was Sarybay's state,"},{"id":"seytek-2012:p0871:b003:l037","ordinal":361323,"en":"Rushing about in frantic haste,"},{"id":"seytek-2012:p0871:b003:l038","ordinal":361324,"en":"When grief made his eyes blaze,"},{"id":"seytek-2012:p0871:b003:l039","ordinal":361325,"en":"Whenever the wretch grew angry,"},{"id":"seytek-2012:p0871:b003:l040","ordinal":361326,"en":"The vast army roared and misery seethed,"},{"id":"seytek-2012:p0872:b002:l001","ordinal":361327,"en":"Despairing of their fly-like lives,"},{"id":"seytek-2012:p0872:b002:l002","ordinal":361328,"en":"He saddled Tookyzyld,"},{"id":"seytek-2012:p0872:b002:l003","ordinal":361329,"en":"His spirit estranged and divided,"},{"id":"seytek-2012:p0872:b002:l004","ordinal":361330,"en":"When he glowered in fury,"},{"id":"seytek-2012:p0872:b002:l005","ordinal":361331,"en":"He looked ready to suck them dry,"},{"id":"seytek-2012:p0872:b002:l006","ordinal":361332,"en":"Such was Sarybay's state:"},{"id":"seytek-2012:p0872:b002:l007","ordinal":361333,"en":"Sixty wrestlers and forty warriors"},{"id":"seytek-2012:p0872:b002:l008","ordinal":361334,"en":"Fell one by one in their places,"},{"id":"seytek-2012:p0872:b002:l009","ordinal":361335,"en":"Upon Tookyzyld,"},{"id":"seytek-2012:p0872:b002:l010","ordinal":361336,"en":"Into the steel-soled stirrups,"},{"id":"seytek-2012:p0872:b002:l011","ordinal":361337,"en":"He leapt without even setting foot,"},{"id":"seytek-2012:p0872:b002:l012","ordinal":361338,"en":"Alone from the massed army,"},{"id":"seytek-2012:p0872:b002:l013","ordinal":361339,"en":"He rode visibly forth to single combat,"},{"id":"seytek-2012:p0872:b002:l014","ordinal":361340,"en":"He appeared ready to drain"},{"id":"seytek-2012:p0872:b002:l015","ordinal":361341,"en":"Every mortal human being,"},{"id":"seytek-2012:p0872:b002:l016","ordinal":361342,"en":"A savage frenzy seized him,"},{"id":"seytek-2012:p0872:b002:l017","ordinal":361343,"en":"Against that dread man's wrath,"},{"id":"seytek-2012:p0872:b002:l018","ordinal":361344,"en":"No one could stand,"},{"id":"seytek-2012:p0872:b002:l019","ordinal":361345,"en":"His appearance utterly transformed,"},{"id":"seytek-2012:p0872:b002:l020","ordinal":361346,"en":"Chasing the whole wide world,"},{"id":"seytek-2012:p0872:b002:l021","ordinal":361347,"en":"Drawing breath like a dragon,"},{"id":"seytek-2012:p0872:b002:l022","ordinal":361348,"en":"He looked ready to suck all life away,"},{"id":"seytek-2012:p0872:b002:l023","ordinal":361349,"en":"His eyes distorted and blazed,"},{"id":"seytek-2012:p0872:b002:l024","ordinal":361350,"en":"Tookyzyld's reins"},{"id":"seytek-2012:p0872:b002:l025","ordinal":361351,"en":"He gripped now right, now left,"},{"id":"seytek-2012:p0872:b002:l026","ordinal":361352,"en":"No soul could endure his fury,"},{"id":"seytek-2012:p0872:b002:l027","ordinal":361353,"en":"The storm never left his brow,"},{"id":"seytek-2012:p0872:b002:l028","ordinal":361354,"en":"The army gathered with a clamor,"},{"id":"seytek-2012:p0872:b002:l029","ordinal":361355,"en":"Unable to withstand his wrath,"},{"id":"seytek-2012:p0872:b002:l030","ordinal":361356,"en":"All whom he looked upon were slain,"},{"id":"seytek-2012:p0872:b002:l031","ordinal":361357,"en":"Every living creature"},{"id":"seytek-2012:p0872:b002:l032","ordinal":361358,"en":"Bowed and bent its head,"},{"id":"seytek-2012:p0872:b002:l033","ordinal":361359,"en":"Whoever stared wide-eyed at him"},{"id":"seytek-2012:p0872:b002:l034","ordinal":361360,"en":"Despaired at once of life,"},{"id":"seytek-2012:p0872:b002:l035","ordinal":361361,"en":"Those skilled at thrusting spears,"},{"id":"seytek-2012:p0872:b002:l036","ordinal":361362,"en":"The stalwarts who struck with battle-axes,"},{"id":"seytek-2012:p0872:b002:l037","ordinal":361363,"en":"Those who faced fearsome foes"},{"id":"seytek-2012:p0872:b002:l038","ordinal":361364,"en":"And were drenched in black blood,"},{"id":"seytek-2012:p0872:b002:l039","ordinal":361365,"en":"Those who guarded the people,"},{"id":"seytek-2012:p0872:b002:l040","ordinal":361366,"en":"Eloquent men who never faltered,"},{"id":"seytek-2012:p0872:b003:l001","ordinal":361367,"en":"Marksmen trained in stealth,"},{"id":"seytek-2012:p0872:b003:l002","ordinal":361368,"en":"Who never shrank when facing the foe,"},{"id":"seytek-2012:p0872:b003:l003","ordinal":361369,"en":"Men born but once"},{"id":"seytek-2012:p0872:b003:l004","ordinal":361370,"en":"Into the hands of fortunate mankind,"},{"id":"seytek-2012:p0872:b003:l005","ordinal":361371,"en":"Who never withdrew what they extended,"},{"id":"seytek-2012:p0872:b003:l006","ordinal":361372,"en":"Whose grim aim never failed,"},{"id":"seytek-2012:p0872:b003:l007","ordinal":361373,"en":"True, sure-shot marksmen—"},{"id":"seytek-2012:p0872:b003:l008","ordinal":361374,"en":"When Sarybay poured out his wrath,"},{"id":"seytek-2012:p0872:b003:l009","ordinal":361375,"en":"All the heroes gathered,"},{"id":"seytek-2012:p0872:b003:l010","ordinal":361376,"en":"And wise men were slaughtered,"},{"id":"seytek-2012:p0872:b003:l011","ordinal":361377,"en":"Their hands struck against one another,"},{"id":"seytek-2012:p0872:b003:l012","ordinal":361378,"en":"When Sarybay poured out his wrath,"},{"id":"seytek-2012:p0872:b003:l013","ordinal":361379,"en":"Many among the people lost their wits,"},{"id":"seytek-2012:p0872:b003:l014","ordinal":361380,"en":"Rushing about in panic,"},{"id":"seytek-2012:p0872:b003:l015","ordinal":361381,"en":"Many mortals fled,"},{"id":"seytek-2012:p0872:b003:l016","ordinal":361382,"en":"Their faces yellow as straw,"},{"id":"seytek-2012:p0872:b003:l017","ordinal":361383,"en":"Finding no earth to enter,"},{"id":"seytek-2012:p0872:b003:l018","ordinal":361384,"en":"Finding nowhere to take shelter,"},{"id":"seytek-2012:p0872:b003:l019","ordinal":361385,"en":"Finding no flattering words to speak,"},{"id":"seytek-2012:p0872:b003:l020","ordinal":361386,"en":"Their hearts corrupted, their faces bitter,"},{"id":"seytek-2012:p0872:b003:l021","ordinal":361387,"en":"Behind the infidel slave,"},{"id":"seytek-2012:p0872:b003:l022","ordinal":361388,"en":"They found no refuge from death,"},{"id":"seytek-2012:p0872:b003:l023","ordinal":361389,"en":"The people lost their senses,"},{"id":"seytek-2012:p0872:b003:l024","ordinal":361390,"en":"And this was why they faltered:"},{"id":"seytek-2012:p0872:b003:l025","ordinal":361391,"en":"Rebuking the whole army,"},{"id":"seytek-2012:p0872:b003:l026","ordinal":361392,"en":"Sarybay stood thundering,"},{"id":"seytek-2012:p0872:b003:l027","ordinal":361393,"en":"“All our stratagems are exhausted,” they said,"},{"id":"seytek-2012:p0872:b003:l028","ordinal":361394,"en":"“In two months he has reached us,” they said,"},{"id":"seytek-2012:p0872:b003:l029","ordinal":361395,"en":"That swine Sarybay's"},{"id":"seytek-2012:p0872:b003:l030","ordinal":361396,"en":"Fierce venom became apparent,"},{"id":"seytek-2012:p0872:b003:l031","ordinal":361397,"en":"All who heard with ears and saw with eyes,"},{"id":"seytek-2012:p0872:b003:l032","ordinal":361398,"en":"The people despaired of life,"},{"id":"seytek-2012:p0872:b003:l033","ordinal":361399,"en":"Beginning their laments, crying “alas,”"},{"id":"seytek-2012:p0872:b003:l034","ordinal":361400,"en":"Every person brooded, crying “woe,”"},{"id":"seytek-2012:p0872:b003:l035","ordinal":361401,"en":"“If Sarybay flies into a rage,"},{"id":"seytek-2012:p0872:b003:l036","ordinal":361402,"en":"He will pursue us to the bitter end,” they said,"},{"id":"seytek-2012:p0872:b003:l037","ordinal":361403,"en":"“He will boastfully drive his army,"},{"id":"seytek-2012:p0872:b003:l038","ordinal":361404,"en":"Not sparing even one,"},{"id":"seytek-2012:p0872:b003:l039","ordinal":361405,"en":"And pass through in slaughter,” they said,"},{"id":"seytek-2012:p0872:b003:l040","ordinal":361406,"en":"Whether hero or lion,"},{"id":"seytek-2012:p0873:b002:l001","ordinal":361407,"en":"Whether wrestler or warrior,"},{"id":"seytek-2012:p0873:b002:l002","ordinal":361408,"en":"To the whole wide world Sarybay"},{"id":"seytek-2012:p0873:b002:l003","ordinal":361409,"en":"Seemed like a towering mountain,"},{"id":"seytek-2012:p0873:b002:l004","ordinal":361410,"en":"“The whole of that small army"},{"id":"seytek-2012:p0873:b002:l005","ordinal":361411,"en":"He drove before him and devoured,” they said,"},{"id":"seytek-2012:p0873:b002:l006","ordinal":361412,"en":"Those with sense pondered this,"},{"id":"seytek-2012:p0873:b002:l007","ordinal":361413,"en":"Unable to gather their wits,"},{"id":"seytek-2012:p0873:b002:l008","ordinal":361414,"en":"Burning without smoke,"},{"id":"seytek-2012:p0873:b002:l009","ordinal":361415,"en":"The people despaired of life,"},{"id":"seytek-2012:p0873:b002:l010","ordinal":361416,"en":"Thus the people stood,"},{"id":"seytek-2012:p0873:b002:l011","ordinal":361417,"en":"When Sarybay grew furious—"},{"id":"seytek-2012:p0873:b002:l012","ordinal":361418,"en":"Such was his valor,"},{"id":"seytek-2012:p0873:b002:l013","ordinal":361419,"en":"Hearing the wrestlers' report,"},{"id":"seytek-2012:p0873:b002:l014","ordinal":361420,"en":"Hearing that brave Seytek and valiant Choro"},{"id":"seytek-2012:p0873:b002:l015","ordinal":361421,"en":"Had slaughtered the army,"},{"id":"seytek-2012:p0873:b002:l016","ordinal":361422,"en":"He bound his soul to death,"},{"id":"seytek-2012:p0873:b002:l017","ordinal":361423,"en":"As for remaining alive and not dying,"},{"id":"seytek-2012:p0873:b002:l018","ordinal":361424,"en":"The guest-soul granted by the Creator—"},{"id":"seytek-2012:p0873:b002:l019","ordinal":361425,"en":"How could his savage fury spare it?"},{"id":"seytek-2012:p0873:b002:l020","ordinal":361426,"en":"Sarybay, son of the ogre—"},{"id":"seytek-2012:p0873:b002:l021","ordinal":361427,"en":"Such was his boldness,"},{"id":"seytek-2012:p0873:b002:l022","ordinal":361428,"en":"Tugging his coat of mail straight,"},{"id":"seytek-2012:p0873:b002:l023","ordinal":361429,"en":"Shaking out his cuirass,"},{"id":"seytek-2012:p0873:b002:l024","ordinal":361430,"en":"“I am a hero against those with skill,"},{"id":"seytek-2012:p0873:b002:l025","ordinal":361431,"en":"And against a foe whose skill has failed,"},{"id":"seytek-2012:p0873:b002:l026","ordinal":361432,"en":"I am the dreadful end of time,"},{"id":"seytek-2012:p0873:b002:l027","ordinal":361433,"en":"I am the walnut ember itself,"},{"id":"seytek-2012:p0873:b002:l028","ordinal":361434,"en":"Burning like a river and slaughtering nations,"},{"id":"seytek-2012:p0873:b002:l029","ordinal":361435,"en":"When my frenzy seizes me again,"},{"id":"seytek-2012:p0873:b002:l030","ordinal":361436,"en":"I am the black eye of the scourge,"},{"id":"seytek-2012:p0873:b002:l031","ordinal":361437,"en":"I am calamity incarnate,"},{"id":"seytek-2012:p0873:b002:l032","ordinal":361438,"en":"I am the source of every slayer,"},{"id":"seytek-2012:p0873:b002:l033","ordinal":361439,"en":"I am savagery itself,"},{"id":"seytek-2012:p0873:b002:l034","ordinal":361440,"en":"Gnawing whoever I encounter,"},{"id":"seytek-2012:p0873:b002:l035","ordinal":361441,"en":"Devouring whoever I find,"},{"id":"seytek-2012:p0873:b002:l036","ordinal":361442,"en":"Mangling whoever crosses me,"},{"id":"seytek-2012:p0873:b002:l037","ordinal":361443,"en":"I am the black scourge itself,"},{"id":"seytek-2012:p0873:b002:l038","ordinal":361444,"en":"I shall be a bleak ridge"},{"id":"seytek-2012:p0873:b002:l039","ordinal":361445,"en":"That weary men cannot cross,"},{"id":"seytek-2012:p0873:b002:l040","ordinal":361446,"en":"I am the black scourge"},{"id":"seytek-2012:p0873:b004:l001","ordinal":361447,"en":"That mangles any soul it meets,"},{"id":"seytek-2012:p0873:b004:l002","ordinal":361448,"en":"While you still have mighty strength,"},{"id":"seytek-2012:p0873:b004:l003","ordinal":361449,"en":"How could I yield my assembled army?"},{"id":"seytek-2012:p0873:b004:l004","ordinal":361450,"en":"Külchoro has run mad—"},{"id":"seytek-2012:p0873:b004:l005","ordinal":361451,"en":"I shall give him his full punishment,"},{"id":"seytek-2012:p0873:b004:l006","ordinal":361452,"en":"If Khan Seytek crosses my path,"},{"id":"seytek-2012:p0873:b004:l007","ordinal":361453,"en":"I shall seize him and spill his blood,"},{"id":"seytek-2012:p0873:b004:l008","ordinal":361454,"en":"If Semetey crosses my path,"},{"id":"seytek-2012:p0873:b004:l009","ordinal":361455,"en":"I shall tear apart his ribs,"},{"id":"seytek-2012:p0873:b004:l010","ordinal":361456,"en":"If Bakai confronts me,"},{"id":"seytek-2012:p0873:b004:l011","ordinal":361457,"en":"I shall beat the old man's fury from him,"},{"id":"seytek-2012:p0873:b004:l012","ordinal":361458,"en":"If Kuyaly grapples with me,"},{"id":"seytek-2012:p0873:b004:l013","ordinal":361459,"en":"I shall settle her account.”"},{"id":"seytek-2012:p0873:b004:l014","ordinal":361460,"en":"Saying this, he thundered,"},{"id":"seytek-2012:p0873:b004:l015","ordinal":361461,"en":"Every mortal human's"},{"id":"seytek-2012:p0873:b004:l016","ordinal":361462,"en":"Whole free body shuddered,"},{"id":"seytek-2012:p0873:b004:l017","ordinal":361463,"en":"Sarybay, son of the ogre,"},{"id":"seytek-2012:p0873:b004:l018","ordinal":361464,"en":"Pressed the wretched people sorely,"},{"id":"seytek-2012:p0873:b004:l019","ordinal":361465,"en":"His shout splitting heads,"},{"id":"seytek-2012:p0873:b004:l020","ordinal":361466,"en":"The doomed man's bellowing,"},{"id":"seytek-2012:p0873:b004:l021","ordinal":361467,"en":"His roar splitting stones,"},{"id":"seytek-2012:p0873:b004:l022","ordinal":361468,"en":"Against that dread man's wrath,"},{"id":"seytek-2012:p0873:b004:l023","ordinal":361469,"en":"No one could stand and look,"},{"id":"seytek-2012:p0873:b004:l024","ordinal":361470,"en":"When the infidel gathered force,"},{"id":"seytek-2012:p0873:b004:l025","ordinal":361471,"en":"No person could withstand him,"},{"id":"seytek-2012:p0873:b004:l026","ordinal":361472,"en":"Such was the true might"}]
