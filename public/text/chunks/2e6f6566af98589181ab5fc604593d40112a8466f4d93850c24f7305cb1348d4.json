[{"id":"semetey-1-2013:p1273:b005:l009","ordinal":174337,"en":"He began a great tumult;"},{"id":"semetey-1-2013:p1273:b005:l010","ordinal":174338,"en":"Saying, \"He will not give his old daughter,\""},{"id":"semetey-1-2013:p1273:b005:l011","ordinal":174339,"en":"He slaughtered the people."},{"id":"semetey-1-2013:p1273:b005:l012","ordinal":174340,"en":"They stood in single combat;"},{"id":"semetey-1-2013:p1273:b005:l013","ordinal":174341,"en":"Not once, but seven times"},{"id":"semetey-1-2013:p1273:b005:l014","ordinal":174342,"en":"The Jediger fought."},{"id":"semetey-1-2013:p1273:b005:l015","ordinal":174343,"en":"They fought horse to horse,"},{"id":"semetey-1-2013:p1273:b005:l016","ordinal":174344,"en":"Jousted with spears,"},{"id":"semetey-1-2013:p1273:b005:l017","ordinal":174345,"en":"And struck with swords."},{"id":"semetey-1-2013:p1273:b005:l018","ordinal":174346,"en":"Because of Aychurok,"},{"id":"semetey-1-2013:p1273:b005:l019","ordinal":174347,"en":"They found much slaughter."},{"id":"semetey-1-2013:p1273:b005:l020","ordinal":174348,"en":"The truest of them was Chynkojo,"},{"id":"semetey-1-2013:p1273:b005:l021","ordinal":174349,"en":"Like tempered red iron."},{"id":"semetey-1-2013:p1273:b005:l022","ordinal":174350,"en":"His courage was different, his venom strong;"},{"id":"semetey-1-2013:p1273:b005:l023","ordinal":174351,"en":"He could devour whomever he met,"},{"id":"semetey-1-2013:p1273:b005:l024","ordinal":174352,"en":"And his bulk was half a mountain."},{"id":"semetey-1-2013:p1273:b005:l025","ordinal":174353,"en":"Kojo, son of Shygay,"},{"id":"semetey-1-2013:p1273:b005:l026","ordinal":174354,"en":"Had a black cap like a cauldron."},{"id":"semetey-1-2013:p1273:b005:l027","ordinal":174355,"en":"He had the will to slaughter"},{"id":"semetey-1-2013:p1273:b005:l028","ordinal":174356,"en":"Not only Afghanistan but the world."},{"id":"semetey-1-2013:p1273:b005:l029","ordinal":174357,"en":"He had received instruction"},{"id":"semetey-1-2013:p1273:b005:l030","ordinal":174358,"en":"From blessed Manas's spirit."},{"id":"semetey-1-2013:p1273:b005:l031","ordinal":174359,"en":"That was the hero and the warrior,"},{"id":"semetey-1-2013:p1273:b005:l032","ordinal":174360,"en":"A cunning and wise man,"},{"id":"semetey-1-2013:p1273:b005:l033","ordinal":174361,"en":"A lion who knew perfectly"},{"id":"semetey-1-2013:p1273:b005:l034","ordinal":174362,"en":"The enemy's devices."},{"id":"semetey-1-2013:p1273:b005:l035","ordinal":174363,"en":"Yesterday, when Almambet fell to a bullet,"},{"id":"semetey-1-2013:p1273:b005:l036","ordinal":174364,"en":"Did he not unleash"},{"id":"semetey-1-2013:p1273:b005:l037","ordinal":174365,"en":"A merciless turmoil?"},{"id":"semetey-1-2013:p1273:b005:l038","ordinal":174366,"en":"Chynkojo the expert"},{"id":"semetey-1-2013:p1273:b005:l039","ordinal":174367,"en":"Had taken Almambet's magic stone,"},{"id":"semetey-1-2013:p1274:b003:l001","ordinal":174368,"en":"Had he not seized it?"},{"id":"semetey-1-2013:p1274:b003:l002","ordinal":174369,"en":"Before, fighting six times,"},{"id":"semetey-1-2013:p1274:b003:l003","ordinal":174370,"en":"He had caused much strife in Afghanistan."},{"id":"semetey-1-2013:p1274:b003:l004","ordinal":174371,"en":"The peoples of the world gathered;"},{"id":"semetey-1-2013:p1274:b003:l005","ordinal":174372,"en":"Many of the palmful of Afghans"},{"id":"semetey-1-2013:p1274:b003:l006","ordinal":174373,"en":"Were slaughtered."},{"id":"semetey-1-2013:p1274:b003:l007","ordinal":174374,"en":"Akun's army stood apart."},{"id":"semetey-1-2013:p1274:b003:l008","ordinal":174375,"en":"What could dear Akun do?"},{"id":"semetey-1-2013:p1274:b003:l009","ordinal":174376,"en":"He wrapped his belt as a turban"},{"id":"semetey-1-2013:p1274:b003:l010","ordinal":174377,"en":"And implored the Almighty:"},{"id":"semetey-1-2013:p1274:b003:l011","ordinal":174378,"en":"\"If death comes, I will die;"},{"id":"semetey-1-2013:p1274:b003:l012","ordinal":174379,"en":"What God has written,"},{"id":"semetey-1-2013:p1274:b003:l013","ordinal":174380,"en":"If it falls upon my neck, I will see."},{"id":"semetey-1-2013:p1274:b003:l014","ordinal":174381,"en":"I will become support"},{"id":"semetey-1-2013:p1274:b003:l015","ordinal":174382,"en":"For the orphaned son of Manas."},{"id":"semetey-1-2013:p1274:b003:l016","ordinal":174383,"en":"If the Jediger falls into my hands,"},{"id":"semetey-1-2013:p1274:b003:l017","ordinal":174384,"en":"I will offer them as sacrifices!\""},{"id":"semetey-1-2013:p1274:b003:l018","ordinal":174385,"en":"Khan Akun came out straining."},{"id":"semetey-1-2013:p1274:b003:l019","ordinal":174386,"en":"What could dear Akun do?"},{"id":"semetey-1-2013:p1274:b003:l020","ordinal":174387,"en":"He prepared for war."},{"id":"semetey-1-2013:p1274:b003:l021","ordinal":174388,"en":"His spear was truly pointed,"},{"id":"semetey-1-2013:p1274:b003:l022","ordinal":174389,"en":"His sword exceptionally sharp."},{"id":"semetey-1-2013:p1274:b003:l023","ordinal":174390,"en":"The hero skilled with the battle-axe,"},{"id":"semetey-1-2013:p1274:b003:l024","ordinal":174391,"en":"Tumenbay, son of Tulku,"},{"id":"semetey-1-2013:p1274:b003:l025","ordinal":174392,"en":"Was the valiant Afghan."},{"id":"semetey-1-2013:p1274:b003:l026","ordinal":174393,"en":"If an army engulfed them,"},{"id":"semetey-1-2013:p1274:b003:l027","ordinal":174394,"en":"If a dug pit lay before them,"},{"id":"semetey-1-2013:p1274:b003:l028","ordinal":174395,"en":"If a hazy fire struck,"},{"id":"semetey-1-2013:p1274:b003:l029","ordinal":174396,"en":"If an unbroken bullet struck,"},{"id":"semetey-1-2013:p1274:b003:l030","ordinal":174397,"en":"He was the hero who would ward it off."},{"id":"semetey-1-2013:p1274:b003:l031","ordinal":174398,"en":"\"I will endure the Jediger's humiliation"},{"id":"semetey-1-2013:p1274:b003:l032","ordinal":174399,"en":"Through hardship;"},{"id":"semetey-1-2013:p1274:b003:l033","ordinal":174400,"en":"I will become support"},{"id":"semetey-1-2013:p1274:b003:l034","ordinal":174401,"en":"For the young lord and tiger.\""},{"id":"semetey-1-2013:p1274:b003:l035","ordinal":174402,"en":"The valiant man's mount"},{"id":"semetey-1-2013:p1274:b003:l036","ordinal":174403,"en":"Was a black-blazed courser."},{"id":"semetey-1-2013:p1274:b003:l037","ordinal":174404,"en":"Surging upon the courser,"},{"id":"semetey-1-2013:p1274:b003:l038","ordinal":174405,"en":"He drove the great common host"},{"id":"semetey-1-2013:p1274:b003:l039","ordinal":174406,"en":"And spoke to the Afghans:"},{"id":"semetey-1-2013:p1274:b004:l001","ordinal":174407,"en":"\"Do not lose your wits;"},{"id":"semetey-1-2013:p1274:b004:l002","ordinal":174408,"en":"Damn you, Afghans,"},{"id":"semetey-1-2013:p1274:b004:l003","ordinal":174409,"en":"Do not flee as before!"},{"id":"semetey-1-2013:p1274:b004:l004","ordinal":174410,"en":"You have a ridge of refuge,"},{"id":"semetey-1-2013:p1274:b004:l005","ordinal":174411,"en":"And heroes girded for battle."},{"id":"semetey-1-2013:p1274:b004:l006","ordinal":174412,"en":"The great Jediger host"},{"id":"semetey-1-2013:p1274:b004:l007","ordinal":174413,"en":"Engulfed Afghanistan"},{"id":"semetey-1-2013:p1274:b004:l008","ordinal":174414,"en":"And often raided your migrations;"},{"id":"semetey-1-2013:p1274:b004:l009","ordinal":174415,"en":"Leopard Khan Semetey"},{"id":"semetey-1-2013:p1274:b004:l010","ordinal":174416,"en":"Will take your revenge."},{"id":"semetey-1-2013:p1274:b004:l011","ordinal":174417,"en":"Support has come to you, Afghans;"},{"id":"semetey-1-2013:p1274:b004:l012","ordinal":174418,"en":"A lion to make a host has come!\""},{"id":"semetey-1-2013:p1274:b004:l013","ordinal":174419,"en":"Shouting, \"Baabedin!\""},{"id":"semetey-1-2013:p1274:b004:l014","ordinal":174420,"en":"Calling the Afghan battle cry,"},{"id":"semetey-1-2013:p1274:b004:l015","ordinal":174421,"en":"They became a vast, accomplished army,"},{"id":"semetey-1-2013:p1274:b004:l016","ordinal":174422,"en":"So numerous the earth bent."},{"id":"semetey-1-2013:p1274:b004:l017","ordinal":174423,"en":"All mounted tulpar horses"},{"id":"semetey-1-2013:p1274:b004:l018","ordinal":174424,"en":"And tightly knotted their hair tails."},{"id":"semetey-1-2013:p1274:b004:l019","ordinal":174425,"en":"The earth filled with their numbers;"},{"id":"semetey-1-2013:p1274:b004:l020","ordinal":174426,"en":"They were a people spread across the land."},{"id":"semetey-1-2013:p1274:b004:l021","ordinal":174427,"en":"His courser thundered;"},{"id":"semetey-1-2013:p1274:b004:l022","ordinal":174428,"en":"He slung the alengir bow"},{"id":"semetey-1-2013:p1274:b004:l023","ordinal":174429,"en":"And patterned arrows,"},{"id":"semetey-1-2013:p1274:b004:l024","ordinal":174430,"en":"Roaring, \"Advance!\""},{"id":"semetey-1-2013:p1274:b004:l025","ordinal":174431,"en":"They streamed like ants."},{"id":"semetey-1-2013:p1274:b004:l026","ordinal":174432,"en":"When his army suddenly emerged"},{"id":"semetey-1-2013:p1274:b004:l027","ordinal":174433,"en":"Upon the earthen ridge,"},{"id":"semetey-1-2013:p1274:b004:l028","ordinal":174434,"en":"The Jediger on the far side"},{"id":"semetey-1-2013:p1274:b004:l029","ordinal":174435,"en":"Were coming in a surging mass."},{"id":"semetey-1-2013:p1274:b004:l030","ordinal":174436,"en":"Spearpoints struck one another,"},{"id":"semetey-1-2013:p1274:b004:l031","ordinal":174437,"en":"And human heads collided."},{"id":"semetey-1-2013:p1274:b004:l032","ordinal":174438,"en":"They drew bows like rain"},{"id":"semetey-1-2013:p1274:b004:l033","ordinal":174439,"en":"And fired bullets like hail."},{"id":"semetey-1-2013:p1274:b004:l034","ordinal":174440,"en":"Closing in toward the city,"},{"id":"semetey-1-2013:p1274:b004:l035","ordinal":174441,"en":"Prepared for mass battle,"},{"id":"semetey-1-2013:p1274:b004:l036","ordinal":174442,"en":"The remaining Jediger"},{"id":"semetey-1-2013:p1274:b004:l037","ordinal":174443,"en":"Drew bows like rain"},{"id":"semetey-1-2013:p1274:b004:l038","ordinal":174444,"en":"And fired bullets like hail."},{"id":"semetey-1-2013:p1274:b004:l039","ordinal":174445,"en":"Without tiring, the people engulfed them,"},{"id":"semetey-1-2013:p1275:b003:l001","ordinal":174446,"en":"An immeasurable flood engulfing them—"},{"id":"semetey-1-2013:p1275:b003:l002","ordinal":174447,"en":"Unless the heroes come out to meet it,"},{"id":"semetey-1-2013:p1275:b003:l003","ordinal":174448,"en":"It is coming to trample Afghanistan"},{"id":"semetey-1-2013:p1275:b003:l004","ordinal":174449,"en":"And reduce it to nothing."},{"id":"semetey-1-2013:p1275:b003:l005","ordinal":174450,"en":"The road-hardened Jediger"},{"id":"semetey-1-2013:p1275:b003:l006","ordinal":174451,"en":"Are coming to engulf Afghanistan"},{"id":"semetey-1-2013:p1275:b003:l007","ordinal":174452,"en":"And grind it to powder."},{"id":"semetey-1-2013:p1275:b003:l008","ordinal":174453,"en":"The army split at the front;"},{"id":"semetey-1-2013:p1275:b003:l009","ordinal":174454,"en":"Lion Kozho, who brought great strife"},{"id":"semetey-1-2013:p1275:b003:l010","ordinal":174455,"en":"Upon the world, was at the flank."},{"id":"semetey-1-2013:p1275:b003:l011","ordinal":174456,"en":"Carrying a gold banner with a crescent,"},{"id":"semetey-1-2013:p1275:b003:l012","ordinal":174457,"en":"Raising every kind of clamor,"},{"id":"semetey-1-2013:p1275:b003:l013","ordinal":174458,"en":"When Kozho drew near,"},{"id":"semetey-1-2013:p1275:b003:l014","ordinal":174459,"en":"The sight made the heart recoil."},{"id":"semetey-1-2013:p1275:b003:l015","ordinal":174460,"en":"His majesty was fierce, his wrath strong;"},{"id":"semetey-1-2013:p1275:b003:l016","ordinal":174461,"en":"The leopard prince then"},{"id":"semetey-1-2013:p1275:b003:l017","ordinal":174462,"en":"Looked as vast as Ala-Too."},{"id":"semetey-1-2013:p1275:b003:l018","ordinal":174463,"en":"A blue-mottled cloud appeared in the sky;"},{"id":"semetey-1-2013:p1275:b003:l019","ordinal":174464,"en":"Semetey, son of the blue-maned lion,"},{"id":"semetey-1-2013:p1275:b003:l020","ordinal":174465,"en":"Made Buurul bound and thrash,"},{"id":"semetey-1-2013:p1275:b003:l021","ordinal":174466,"en":"Rearing and lunging,"},{"id":"semetey-1-2013:p1275:b003:l022","ordinal":174467,"en":"And visibly rode out to meet him"},{"id":"semetey-1-2013:p1275:b003:l023","ordinal":174468,"en":"Before Chynkozho."},{"id":"semetey-1-2013:p1275:b003:l024","ordinal":174469,"en":"Arbuurul beneath him,"},{"id":"semetey-1-2013:p1275:b003:l025","ordinal":174470,"en":"A creature beyond ordinary livestock,"},{"id":"semetey-1-2013:p1275:b003:l026","ordinal":174471,"en":"Pricked its extraordinary ears."},{"id":"semetey-1-2013:p1275:b003:l027","ordinal":174472,"en":"The white blaze on its brow, broad as teeth,"},{"id":"semetey-1-2013:p1275:b003:l028","ordinal":174473,"en":"Seemed covered in steel;"},{"id":"semetey-1-2013:p1275:b003:l029","ordinal":174474,"en":"The breadth of its pelvis"},{"id":"semetey-1-2013:p1275:b003:l030","ordinal":174475,"en":"Was like a ravine filled with firewood."},{"id":"semetey-1-2013:p1275:b003:l031","ordinal":174476,"en":"His fearsome waist girded,"},{"id":"semetey-1-2013:p1275:b003:l032","ordinal":174477,"en":"Semetey charged"},{"id":"semetey-1-2013:p1275:b003:l033","ordinal":174478,"en":"Into Chynkozho's army."},{"id":"semetey-1-2013:p1275:b003:l034","ordinal":174479,"en":"His father was a surpassing blue-maned lion;"},{"id":"semetey-1-2013:p1275:b003:l035","ordinal":174480,"en":"Lion-like Semetey"},{"id":"semetey-1-2013:p1275:b003:l036","ordinal":174481,"en":"Unleashed turmoil there."},{"id":"semetey-1-2013:p1275:b003:l037","ordinal":174482,"en":"Girding a gray kise belt at his waist,"},{"id":"semetey-1-2013:p1275:b003:l038","ordinal":174483,"en":"He charged, swaying heavily."},{"id":"semetey-1-2013:p1275:b003:l039","ordinal":174484,"en":"His hero's gift,"},{"id":"semetey-1-2013:p1275:b005:l001","ordinal":174485,"en":"His renowned red banner,"},{"id":"semetey-1-2013:p1275:b005:l002","ordinal":174486,"en":"He planted wherever he faced;"},{"id":"semetey-1-2013:p1275:b005:l003","ordinal":174487,"en":"Semetey drove straight in,"},{"id":"semetey-1-2013:p1275:b005:l004","ordinal":174488,"en":"Slaughtering the side he faced."},{"id":"semetey-1-2013:p1275:b005:l005","ordinal":174489,"en":"The playful blue-maned hero"},{"id":"semetey-1-2013:p1275:b005:l006","ordinal":174490,"en":"Wrought destruction there."},{"id":"semetey-1-2013:p1275:b005:l007","ordinal":174491,"en":"He made the white standard his banner,"},{"id":"semetey-1-2013:p1275:b005:l008","ordinal":174492,"en":"Filled the side he faced with clamor,"},{"id":"semetey-1-2013:p1275:b005:l009","ordinal":174493,"en":"And set out to drive these people away."},{"id":"semetey-1-2013:p1275:b005:l010","ordinal":174494,"en":"When Semetey entered,"},{"id":"semetey-1-2013:p1275:b005:l011","ordinal":174495,"en":"He darted in like a falcon;"},{"id":"semetey-1-2013:p1275:b005:l012","ordinal":174496,"en":"The great black Jediger host"},{"id":"semetey-1-2013:p1275:b005:l013","ordinal":174497,"en":"Fled shrieking like crows."},{"id":"semetey-1-2013:p1275:b005:l014","ordinal":174498,"en":"Making Taybuurul dance,"},{"id":"semetey-1-2013:p1275:b005:l015","ordinal":174499,"en":"Those he reached then"},{"id":"semetey-1-2013:p1275:b005:l016","ordinal":174500,"en":"He measured out with his spear."},{"id":"semetey-1-2013:p1275:b005:l017","ordinal":174501,"en":"Many were witless with panic;"},{"id":"semetey-1-2013:p1275:b005:l018","ordinal":174502,"en":"Many ran in confusion."},{"id":"semetey-1-2013:p1275:b005:l019","ordinal":174503,"en":"Saying, “Elder, we submit,”"},{"id":"semetey-1-2013:p1275:b005:l020","ordinal":174504,"en":"Many could not gather their senses"},{"id":"semetey-1-2013:p1275:b005:l021","ordinal":174505,"en":"And ran away."},{"id":"semetey-1-2013:p1275:b005:l022","ordinal":174506,"en":"Many threw down their spears"},{"id":"semetey-1-2013:p1275:b005:l023","ordinal":174507,"en":"And stampeded."},{"id":"semetey-1-2013:p1275:b005:l024","ordinal":174508,"en":"They threw away every one"},{"id":"semetey-1-2013:p1275:b005:l025","ordinal":174509,"en":"Of their swords, guns, and weapons."},{"id":"semetey-1-2013:p1275:b005:l026","ordinal":174510,"en":"Saying, “Come, let us preserve"},{"id":"semetey-1-2013:p1275:b005:l027","ordinal":174511,"en":"The lives entrusted to us,” many fled."},{"id":"semetey-1-2013:p1275:b005:l028","ordinal":174512,"en":"In terror they could not pull in the reins;"},{"id":"semetey-1-2013:p1275:b005:l029","ordinal":174513,"en":"Their horses all bucked,"},{"id":"semetey-1-2013:p1275:b005:l030","ordinal":174514,"en":"And many could not stop them."},{"id":"semetey-1-2013:p1275:b005:l031","ordinal":174515,"en":"Saying, “We shall die without seeing"},{"id":"semetey-1-2013:p1275:b005:l032","ordinal":174516,"en":"A wicked wife or young child,”"},{"id":"semetey-1-2013:p1275:b005:l033","ordinal":174517,"en":"Many fled weeping."},{"id":"semetey-1-2013:p1275:b005:l034","ordinal":174518,"en":"The saddles of many swift horses"},{"id":"semetey-1-2013:p1275:b005:l035","ordinal":174519,"en":"Slipped beneath their bellies;"},{"id":"semetey-1-2013:p1275:b005:l036","ordinal":174520,"en":"Many went careering about."},{"id":"semetey-1-2013:p1275:b005:l037","ordinal":174521,"en":"Saying, “My dear lost brother"},{"id":"semetey-1-2013:p1275:b005:l038","ordinal":174522,"en":"Died in such-and-such a place,”"},{"id":"semetey-1-2013:p1275:b005:l039","ordinal":174523,"en":"Many went weeping."},{"id":"semetey-1-2013:p1276:b003:l001","ordinal":174524,"en":"On seeing their dead,"},{"id":"semetey-1-2013:p1276:b003:l002","ordinal":174525,"en":"Many went about in anguish."},{"id":"semetey-1-2013:p1276:b003:l003","ordinal":174526,"en":"Saying, “That fucking dog Kozho"},{"id":"semetey-1-2013:p1276:b003:l004","ordinal":174527,"en":"Has done this to us,”"},{"id":"semetey-1-2013:p1276:b003:l005","ordinal":174528,"en":"Many went weeping."},{"id":"semetey-1-2013:p1276:b003:l006","ordinal":174529,"en":"They dismounted and crowded forward,"},{"id":"semetey-1-2013:p1276:b003:l007","ordinal":174530,"en":"Hanging their belts around their necks;"},{"id":"semetey-1-2013:p1276:b003:l008","ordinal":174531,"en":"Before Semetey then,"},{"id":"semetey-1-2013:p1276:b003:l009","ordinal":174532,"en":"Many begged for their lives in supplication"},{"id":"semetey-1-2013:p1276:b003:l010","ordinal":174533,"en":"And witnessed"},{"id":"semetey-1-2013:p1276:b003:l011","ordinal":174534,"en":"The Creator's command."},{"id":"semetey-1-2013:p1276:b003:l012","ordinal":174535,"en":"Many merely swooned and fell,"},{"id":"semetey-1-2013:p1276:b003:l013","ordinal":174536,"en":"Lying as though dead."},{"id":"semetey-1-2013:p1276:b003:l014","ordinal":174537,"en":"Many wandered about"},{"id":"semetey-1-2013:p1276:b003:l015","ordinal":174538,"en":"With their saddles around their necks."},{"id":"semetey-1-2013:p1276:b003:l016","ordinal":174539,"en":"Their girths had broken;"},{"id":"semetey-1-2013:p1276:b003:l017","ordinal":174540,"en":"Their eyes darted about,"},{"id":"semetey-1-2013:p1276:b003:l018","ordinal":174541,"en":"Their legs hung limp,"},{"id":"semetey-1-2013:p1276:b003:l019","ordinal":174542,"en":"And many ran in panic."},{"id":"semetey-1-2013:p1276:b003:l020","ordinal":174543,"en":"With no tebetei on their heads,"},{"id":"semetey-1-2013:p1276:b003:l021","ordinal":174544,"en":"Barefoot and bareheaded,"},{"id":"semetey-1-2013:p1276:b003:l022","ordinal":174545,"en":"Many fled."},{"id":"semetey-1-2013:p1276:b003:l023","ordinal":174546,"en":"Wandering in groups of five and ten,"},{"id":"semetey-1-2013:p1276:b003:l024","ordinal":174547,"en":"Many scattered apart."},{"id":"semetey-1-2013:p1276:b003:l025","ordinal":174548,"en":"Many appeared"},{"id":"semetey-1-2013:p1276:b003:l026","ordinal":174549,"en":"With swift horses beneath them."},{"id":"semetey-1-2013:p1276:b003:l027","ordinal":174550,"en":"Many sought out their own torment"},{"id":"semetey-1-2013:p1276:b003:l028","ordinal":174551,"en":"And became entangled."},{"id":"semetey-1-2013:p1276:b003:l029","ordinal":174552,"en":"Unable to gather their senses,"},{"id":"semetey-1-2013:p1276:b003:l030","ordinal":174553,"en":"They abandoned and cast off their horses;"},{"id":"semetey-1-2013:p1276:b003:l031","ordinal":174554,"en":"Many became trapped"},{"id":"semetey-1-2013:p1276:b003:l032","ordinal":174555,"en":"In pits and hollows."},{"id":"semetey-1-2013:p1276:b003:l033","ordinal":174556,"en":"The Jediger people shrieked."},{"id":"semetey-1-2013:p1276:b003:l034","ordinal":174557,"en":"When the lion prince Semetey"},{"id":"semetey-1-2013:p1276:b003:l035","ordinal":174558,"en":"Charged through the army,"},{"id":"semetey-1-2013:p1276:b003:l036","ordinal":174559,"en":"They lost their wits"},{"id":"semetey-1-2013:p1276:b003:l037","ordinal":174560,"en":"And fled shrieking."},{"id":"semetey-1-2013:p1276:b003:l038","ordinal":174561,"en":"Wherever his spear reached,"},{"id":"semetey-1-2013:p1276:b003:l039","ordinal":174562,"en":"He slaughtered them with the spear."},{"id":"semetey-1-2013:p1276:b004:l001","ordinal":174563,"en":"It was a time when he did"},{"id":"semetey-1-2013:p1276:b004:l002","ordinal":174564,"en":"Wonders no person had seen."},{"id":"semetey-1-2013:p1276:b004:l003","ordinal":174565,"en":"Wherever his sword reached,"},{"id":"semetey-1-2013:p1276:b004:l004","ordinal":174566,"en":"He hacked them with the sword;"},{"id":"semetey-1-2013:p1276:b004:l005","ordinal":174567,"en":"It was a time when he slaughtered them."},{"id":"semetey-1-2013:p1276:b004:l006","ordinal":174568,"en":"It was a time when he did to them"},{"id":"semetey-1-2013:p1276:b004:l007","ordinal":174569,"en":"What had never been done."},{"id":"semetey-1-2013:p1276:b004:l008","ordinal":174570,"en":"The surging Jediger"},{"id":"semetey-1-2013:p1276:b004:l009","ordinal":174571,"en":"Had fallen into panic."},{"id":"semetey-1-2013:p1276:b004:l010","ordinal":174572,"en":"Unable to gather their senses"},{"id":"semetey-1-2013:p1276:b004:l011","ordinal":174573,"en":"Before the leopard prince and sultan,"},{"id":"semetey-1-2013:p1276:b004:l012","ordinal":174574,"en":"They had fled."},{"id":"semetey-1-2013:p1276:b004:l013","ordinal":174575,"en":"Let us leave that there"},{"id":"semetey-1-2013:p1276:b004:l014","ordinal":174576,"en":"And begin the tale"},{"id":"semetey-1-2013:p1276:b004:l015","ordinal":174577,"en":"Of Kulchoro, son of Almambet:"},{"id":"semetey-1-2013:p1276:b004:l016","ordinal":174578,"en":"Raising high"},{"id":"semetey-1-2013:p1276:b004:l017","ordinal":174579,"en":"The red banner left by Manas,"},{"id":"semetey-1-2013:p1276:b004:l018","ordinal":174580,"en":"Shouting, “Manas! Manas!”"},{"id":"semetey-1-2013:p1276:b004:l019","ordinal":174581,"en":"And crying Manas's battle cry,"},{"id":"semetey-1-2013:p1276:b004:l020","ordinal":174582,"en":"Facing Khan Toltoy's army,"},{"id":"semetey-1-2013:p1276:b004:l021","ordinal":174583,"en":"The leopard boy Kulchoro"},{"id":"semetey-1-2013:p1276:b004:l022","ordinal":174584,"en":"Drove in and scattered them."},{"id":"semetey-1-2013:p1276:b004:l023","ordinal":174585,"en":"Looking all around,"},{"id":"semetey-1-2013:p1276:b004:l024","ordinal":174586,"en":"Licking his lips and nose,"},{"id":"semetey-1-2013:p1276:b004:l025","ordinal":174587,"en":"His two eyes darting,"},{"id":"semetey-1-2013:p1276:b004:l026","ordinal":174588,"en":"His two legs dangling,"},{"id":"semetey-1-2013:p1276:b004:l027","ordinal":174589,"en":"He darted in from the side."},{"id":"semetey-1-2013:p1276:b004:l028","ordinal":174590,"en":"When they came before him,"},{"id":"semetey-1-2013:p1276:b004:l029","ordinal":174591,"en":"Kulchoro thrust again and again"},{"id":"semetey-1-2013:p1276:b004:l030","ordinal":174592,"en":"And flung them with his spear."}]
