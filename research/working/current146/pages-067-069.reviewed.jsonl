{"id": "sayakbay-ms-current146:pdf069:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 69, "folio": 452, "line_in_page": 11, "raw": "Ызаада турган Желжетпес,", "text": "Ызаада турган Желжетпес,", "en": "Jeljetpes stood there in anguish,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or a material variant from the printed continuation.", "bbox": null}
