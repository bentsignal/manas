[{"id":"semetey-1-2013:p0496:b003:l022","ordinal":114945,"en":"Akbaltai's Chubak"},{"id":"semetey-1-2013:p0496:b003:l023","ordinal":114946,"en":"Plunged into the battle."},{"id":"semetey-1-2013:p0496:b003:l024","ordinal":114947,"en":"Like tumbleweed flying,"},{"id":"semetey-1-2013:p0496:b003:l025","ordinal":114948,"en":"Khan Manas's forty noble companions,"},{"id":"semetey-1-2013:p0496:b003:l026","ordinal":114949,"en":"All fighting side by side,"},{"id":"semetey-1-2013:p0496:b003:l027","ordinal":114950,"en":"Joined the melee."},{"id":"semetey-1-2013:p0496:b003:l028","ordinal":114951,"en":"Bloodthirsty Manas the panther,"},{"id":"semetey-1-2013:p0496:b003:l029","ordinal":114952,"en":"When he had come halfway,"},{"id":"semetey-1-2013:p0496:b003:l030","ordinal":114953,"en":"Suffered the grievous workings of the poison:"},{"id":"semetey-1-2013:p0496:b003:l031","ordinal":114954,"en":"Pierced in forty places,"},{"id":"semetey-1-2013:p0496:b003:l032","ordinal":114955,"en":"A dire ordeal that could kill him"},{"id":"semetey-1-2013:p0496:b003:l033","ordinal":114956,"en":"Had befallen the wolf-man with full force."},{"id":"semetey-1-2013:p0496:b003:l034","ordinal":114957,"en":"From some of the opened wounds"},{"id":"semetey-1-2013:p0496:b003:l035","ordinal":114958,"en":"Dark blood flowed;"},{"id":"semetey-1-2013:p0496:b003:l036","ordinal":114959,"en":"From other opened wounds"},{"id":"semetey-1-2013:p0496:b003:l037","ordinal":114960,"en":"Dark venom flowed."},{"id":"semetey-1-2013:p0496:b003:l038","ordinal":114961,"en":"Lifting his basin-sized head,"},{"id":"semetey-1-2013:p0496:b003:l039","ordinal":114962,"en":"Worn out, too weary to reach them,"},{"id":"semetey-1-2013:p0496:b004:l001","ordinal":114963,"en":"The generous lion had fallen behind,"},{"id":"semetey-1-2013:p0496:b004:l002","ordinal":114964,"en":"Sick and coughing."},{"id":"semetey-1-2013:p0496:b004:l003","ordinal":114965,"en":"Unable to mount for scouting,"},{"id":"semetey-1-2013:p0496:b004:l004","ordinal":114966,"en":"Your generous lord and the forty companions"},{"id":"semetey-1-2013:p0496:b004:l005","ordinal":114967,"en":"Could not go scouting together."},{"id":"semetey-1-2013:p0496:b004:l006","ordinal":114968,"en":"Kanykei bore the anguish;"},{"id":"semetey-1-2013:p0496:b004:l007","ordinal":114969,"en":"Outside, the forty companions"},{"id":"semetey-1-2013:p0496:b004:l008","ordinal":114970,"en":"Spoke their parting charge."},{"id":"semetey-1-2013:p0496:b004:l009","ordinal":114971,"en":"Manas, gravely ill,"},{"id":"semetey-1-2013:p0496:b004:l010","ordinal":114972,"en":"She led away toward Talas:"},{"id":"semetey-1-2013:p0496:b004:l011","ordinal":114973,"en":"Poor Kanykei had turned back."},{"id":"semetey-1-2013:p0496:b004:l012","ordinal":114974,"en":"The place they reached in Kalmyk country"},{"id":"semetey-1-2013:p0496:b004:l013","ordinal":114975,"en":"Was the broad slope of Keng-Jyldyz;"},{"id":"semetey-1-2013:p0496:b004:l014","ordinal":114976,"en":"Bloody slaughter, a mighty battle,"},{"id":"semetey-1-2013:p0496:b004:l015","ordinal":114977,"en":"Had come to that place."},{"id":"semetey-1-2013:p0496:b004:l016","ordinal":114978,"en":"Shrill shouting, fierce cheering,"},{"id":"semetey-1-2013:p0496:b004:l017","ordinal":114979,"en":"A great clash, a mighty battle,"},{"id":"semetey-1-2013:p0496:b004:l018","ordinal":114980,"en":"Was raging at that time."},{"id":"semetey-1-2013:p0496:b004:l019","ordinal":114981,"en":"He who had poisoned Khan Manas—"},{"id":"semetey-1-2013:p0496:b004:l020","ordinal":114982,"en":"Such was the story of Közkaman."},{"id":"semetey-1-2013:p0496:b004:l021","ordinal":114983,"en":"They contested on horseback,"},{"id":"semetey-1-2013:p0496:b004:l022","ordinal":114984,"en":"Fighting so long without wavering."},{"id":"semetey-1-2013:p0496:b004:l023","ordinal":114985,"en":"Golden forelock, tasseled belt,"},{"id":"semetey-1-2013:p0496:b004:l024","ordinal":114986,"en":"Almambet the lion, the noble lion!"},{"id":"semetey-1-2013:p0496:b004:l025","ordinal":114987,"en":"Sarala beneath him,"},{"id":"semetey-1-2013:p0496:b004:l026","ordinal":114988,"en":"Hoe-broad rump and wide hooves,"},{"id":"semetey-1-2013:p0496:b004:l027","ordinal":114989,"en":"A courser of the spacious land."},{"id":"semetey-1-2013:p0496:b004:l028","ordinal":114990,"en":"When Almambet took his spear,"},{"id":"semetey-1-2013:p0496:b004:l029","ordinal":114991,"en":"He was a master of combat;"},{"id":"semetey-1-2013:p0496:b004:l030","ordinal":114992,"en":"Many times had Almambet entered"},{"id":"semetey-1-2013:p0496:b004:l031","ordinal":114993,"en":"Battles such as this."},{"id":"semetey-1-2013:p0496:b004:l032","ordinal":114994,"en":"Flinging its forelock to the sky,"},{"id":"semetey-1-2013:p0496:b004:l033","ordinal":114995,"en":"Driving its hooves into the earth,"},{"id":"semetey-1-2013:p0496:b004:l034","ordinal":114996,"en":"Rattling the bit,"},{"id":"semetey-1-2013:p0496:b004:l035","ordinal":114997,"en":"Its tail like silken strands"},{"id":"semetey-1-2013:p0496:b004:l036","ordinal":114998,"en":"Lashing on either side,"},{"id":"semetey-1-2013:p0496:b004:l037","ordinal":114999,"en":"Fired up and straining,"},{"id":"semetey-1-2013:p0496:b004:l038","ordinal":115000,"en":"The courser tugged, refusing restraint."},{"id":"semetey-1-2013:p0496:b004:l039","ordinal":115001,"en":"Spear in hand, breaking their ranks,"},{"id":"semetey-1-2013:p0497:b003:l001","ordinal":115002,"en":"Mortals doomed to die fell to the bullets."},{"id":"semetey-1-2013:p0497:b003:l002","ordinal":115003,"en":"Restless during the day,"},{"id":"semetey-1-2013:p0497:b003:l003","ordinal":115004,"en":"They took no daytime rest,"},{"id":"semetey-1-2013:p0497:b003:l004","ordinal":115005,"en":"No sleep propped on an elbow,"},{"id":"semetey-1-2013:p0497:b003:l005","ordinal":115006,"en":"Not a moment's doze or peace."},{"id":"semetey-1-2013:p0497:b003:l006","ordinal":115007,"en":"Közkaman's eighty, the others forty—"},{"id":"semetey-1-2013:p0497:b003:l007","ordinal":115008,"en":"They fought face to face,"},{"id":"semetey-1-2013:p0497:b003:l008","ordinal":115009,"en":"Creating a hell no mortal had seen"},{"id":"semetey-1-2013:p0497:b003:l009","ordinal":115010,"en":"Out on the open plain."},{"id":"semetey-1-2013:p0497:b003:l010","ordinal":115011,"en":"The beasts could not endure the shooting;"},{"id":"semetey-1-2013:p0497:b003:l011","ordinal":115012,"en":"When horses died upon the plain,"},{"id":"semetey-1-2013:p0497:b003:l012","ordinal":115013,"en":"They changed horses and mounted,"},{"id":"semetey-1-2013:p0497:b003:l013","ordinal":115014,"en":"Standing their ground,"},{"id":"semetey-1-2013:p0497:b003:l014","ordinal":115015,"en":"Fighting face to face again and again."},{"id":"semetey-1-2013:p0497:b003:l015","ordinal":115016,"en":"Golden forelock, tasseled belt,"},{"id":"semetey-1-2013:p0497:b003:l016","ordinal":115017,"en":"The outstanding lion Almambet"},{"id":"semetey-1-2013:p0497:b003:l017","ordinal":115018,"en":"Took the weather-stone received from the unseen,"},{"id":"semetey-1-2013:p0497:b003:l018","ordinal":115019,"en":"Chanted over it and put it in water."},{"id":"semetey-1-2013:p0497:b003:l019","ordinal":115020,"en":"The weather-stone received from a snake"},{"id":"semetey-1-2013:p0497:b003:l020","ordinal":115021,"en":"To a cup of clear water"},{"id":"semetey-1-2013:p0497:b003:l021","ordinal":115022,"en":"He let barely touch."},{"id":"semetey-1-2013:p0497:b003:l022","ordinal":115023,"en":"Karykan's great weather-stone—"},{"id":"semetey-1-2013:p0497:b003:l023","ordinal":115024,"en":"He recited its true spell many times"},{"id":"semetey-1-2013:p0497:b003:l024","ordinal":115025,"en":"He took it and placed it in water."},{"id":"semetey-1-2013:p0497:b003:l025","ordinal":115026,"en":"The cloud's name was Buurakan;"},{"id":"semetey-1-2013:p0497:b003:l026","ordinal":115027,"en":"Calling out that name,"},{"id":"semetey-1-2013:p0497:b003:l027","ordinal":115028,"en":"Almambet the lion, the noble lion,"},{"id":"semetey-1-2013:p0497:b003:l028","ordinal":115029,"en":"Was working weather-magic."},{"id":"semetey-1-2013:p0497:b003:l029","ordinal":115030,"en":"Striking his golden saddle-pommel,"},{"id":"semetey-1-2013:p0497:b003:l030","ordinal":115031,"en":"Clashing his stirrups,"},{"id":"semetey-1-2013:p0497:b003:l031","ordinal":115032,"en":"Almambet looked toward the sky,"},{"id":"semetey-1-2013:p0497:b003:l032","ordinal":115033,"en":"Shouted three times, blew three times,"},{"id":"semetey-1-2013:p0497:b003:l033","ordinal":115034,"en":"Rattling off words in Kalmyk,"},{"id":"semetey-1-2013:p0497:b003:l034","ordinal":115035,"en":"Babbling in Chinese."},{"id":"semetey-1-2013:p0497:b003:l035","ordinal":115036,"en":"Three times he heaved and bucked;"},{"id":"semetey-1-2013:p0497:b003:l036","ordinal":115037,"en":"Almambet cast his weather-spell."},{"id":"semetey-1-2013:p0497:b003:l037","ordinal":115038,"en":"Clouds beat down from the sky,"},{"id":"semetey-1-2013:p0497:b003:l038","ordinal":115039,"en":"Clouds hemmed in the earth."},{"id":"semetey-1-2013:p0497:b003:l039","ordinal":115040,"en":"Clouds from the sky, one by one,"},{"id":"semetey-1-2013:p0497:b005:l001","ordinal":115041,"en":"Shuddered down toward the earth;"},{"id":"semetey-1-2013:p0497:b005:l002","ordinal":115042,"en":"Hail fell over all the foothills,"},{"id":"semetey-1-2013:p0497:b005:l003","ordinal":115043,"en":"Rain over all the lower land."},{"id":"semetey-1-2013:p0497:b005:l004","ordinal":115044,"en":"Nothing could be seen at a glance:"},{"id":"semetey-1-2013:p0497:b005:l005","ordinal":115045,"en":"The world's face was ground-hugging fog,"},{"id":"semetey-1-2013:p0497:b005:l006","ordinal":115046,"en":"Nothing could be distinguished."},{"id":"semetey-1-2013:p0497:b005:l007","ordinal":115047,"en":"Drizzle turned to snow in gusts;"},{"id":"semetey-1-2013:p0497:b005:l008","ordinal":115048,"en":"The earth shook and rattled."},{"id":"semetey-1-2013:p0497:b005:l009","ordinal":115049,"en":"Through ravine after ravine"},{"id":"semetey-1-2013:p0497:b005:l010","ordinal":115050,"en":"Torrents ran, floods swept down."},{"id":"semetey-1-2013:p0497:b005:l011","ordinal":115051,"en":"The summer day froze into winter;"},{"id":"semetey-1-2013:p0497:b005:l012","ordinal":115052,"en":"Thinly clothed Kökchököz"},{"id":"semetey-1-2013:p0497:b005:l013","ordinal":115053,"en":"Became a girl trembling to and fro."},{"id":"semetey-1-2013:p0497:b005:l014","ordinal":115054,"en":"Almambet the panther, the noble lion,"},{"id":"semetey-1-2013:p0497:b005:l015","ordinal":115055,"en":"Held fiercely to his weather-magic"},{"id":"semetey-1-2013:p0497:b005:l016","ordinal":115056,"en":"And fought there."},{"id":"semetey-1-2013:p0497:b005:l017","ordinal":115057,"en":"Kökchököz took no heed;"},{"id":"semetey-1-2013:p0497:b005:l018","ordinal":115058,"en":"That unbeliever buzzed away,"},{"id":"semetey-1-2013:p0497:b005:l019","ordinal":115059,"en":"Almambet's weather-spell"},{"id":"semetey-1-2013:p0497:b005:l020","ordinal":115060,"en":"He did not value in the slightest."},{"id":"semetey-1-2013:p0497:b005:l021","ordinal":115061,"en":"They had saddled their horses together;"},{"id":"semetey-1-2013:p0497:b005:l022","ordinal":115062,"en":"The wondrous arts"},{"id":"semetey-1-2013:p0497:b005:l023","ordinal":115063,"en":"Kökchököz and Almambet"},{"id":"semetey-1-2013:p0497:b005:l024","ordinal":115064,"en":"Had studied equally."},{"id":"semetey-1-2013:p0497:b005:l025","ordinal":115065,"en":"One made storms, the other cleared them;"},{"id":"semetey-1-2013:p0497:b005:l026","ordinal":115066,"en":"They stood their ground,"},{"id":"semetey-1-2013:p0497:b005:l027","ordinal":115067,"en":"Staring each other down as they fought."},{"id":"semetey-1-2013:p0497:b005:l028","ordinal":115068,"en":"Do not ask about Közkaman!"},{"id":"semetey-1-2013:p0497:b005:l029","ordinal":115069,"en":"Kongkulboz was a winged steed;"},{"id":"semetey-1-2013:p0497:b005:l030","ordinal":115070,"en":"He gave Kongkulboz a lash,"},{"id":"semetey-1-2013:p0497:b005:l031","ordinal":115071,"en":"Grasped his spear without holding back,"},{"id":"semetey-1-2013:p0497:b005:l032","ordinal":115072,"en":"And attacked the forty companions."},{"id":"semetey-1-2013:p0497:b005:l033","ordinal":115073,"en":"Making Kongkulboz prance,"},{"id":"semetey-1-2013:p0497:b005:l034","ordinal":115074,"en":"He sent all he faced crawling."},{"id":"semetey-1-2013:p0497:b005:l035","ordinal":115075,"en":"Their champion, Khan Manas, was absent."},{"id":"semetey-1-2013:p0497:b005:l036","ordinal":115076,"en":"Seen today, gone tomorrow—"},{"id":"semetey-1-2013:p0497:b005:l037","ordinal":115077,"en":"Such is this shitty world!"},{"id":"semetey-1-2013:p0497:b005:l038","ordinal":115078,"en":"His shouting split stones,"},{"id":"semetey-1-2013:p0497:b005:l039","ordinal":115079,"en":"His roaring split heads,"},{"id":"semetey-1-2013:p0498:b003:l001","ordinal":115080,"en":"As though an evil spirit had seized his wife,"},{"id":"semetey-1-2013:p0498:b003:l002","ordinal":115081,"en":"As though populous Beijing, its many Chinese,"},{"id":"semetey-1-2013:p0498:b003:l003","ordinal":115082,"en":"Lay dead at his feet,"},{"id":"semetey-1-2013:p0498:b003:l004","ordinal":115083,"en":"He had grown furious"},{"id":"semetey-1-2013:p0498:b003:l005","ordinal":115084,"en":"And wrought havoc."},{"id":"semetey-1-2013:p0498:b003:l006","ordinal":115085,"en":"His men in iron-rope mail"},{"id":"semetey-1-2013:p0498:b003:l007","ordinal":115086,"en":"He sent sweeping forward, all of them,"},{"id":"semetey-1-2013:p0498:b003:l008","ordinal":115087,"en":"Every dagger-handed warrior."},{"id":"semetey-1-2013:p0498:b003:l009","ordinal":115088,"en":"From one side, without holding back,"},{"id":"semetey-1-2013:p0498:b003:l010","ordinal":115089,"en":"Skilled on horseback, strong on foot,"},{"id":"semetey-1-2013:p0498:b003:l011","ordinal":115090,"en":"The fleet fighter of that unbeliever,"},{"id":"semetey-1-2013:p0498:b003:l012","ordinal":115091,"en":"Raising tumult from behind,"},{"id":"semetey-1-2013:p0498:b003:l013","ordinal":115092,"en":"Had now arrived—did you see?"},{"id":"semetey-1-2013:p0498:b003:l014","ordinal":115093,"en":"Kökchököz's band of marauders,"},{"id":"semetey-1-2013:p0498:b003:l015","ordinal":115094,"en":"His warriors bearing iron maces,"},{"id":"semetey-1-2013:p0498:b003:l016","ordinal":115095,"en":"Came sweeping on together."},{"id":"semetey-1-2013:p0498:b003:l017","ordinal":115096,"en":"The most skillful spearmen,"},{"id":"semetey-1-2013:p0498:b003:l018","ordinal":115097,"en":"The finest warriors, holding nothing back,"},{"id":"semetey-1-2013:p0498:b003:l019","ordinal":115098,"en":"All charged abreast"},{"id":"semetey-1-2013:p0498:b003:l020","ordinal":115099,"en":"At King Almambet the wolf-man."},{"id":"semetey-1-2013:p0498:b003:l021","ordinal":115100,"en":"All reached him side by side,"},{"id":"semetey-1-2013:p0498:b003:l022","ordinal":115101,"en":"Almambet the panther, the wolf-man,"},{"id":"semetey-1-2013:p0498:b003:l023","ordinal":115102,"en":"And surrounded him."},{"id":"semetey-1-2013:p0498:b003:l024","ordinal":115103,"en":"Bakai, hero of the saints,"},{"id":"semetey-1-2013:p0498:b003:l025","ordinal":115104,"en":"Ajybai of Khan Argyn,"},{"id":"semetey-1-2013:p0498:b003:l026","ordinal":115105,"en":"Hero Chubak of Akbaltai,"},{"id":"semetey-1-2013:p0498:b003:l027","ordinal":115106,"en":"Hero Syrgak of Ulakkan,"},{"id":"semetey-1-2013:p0498:b003:l028","ordinal":115107,"en":"Yraman's Yrchuul,"},{"id":"semetey-1-2013:p0498:b003:l029","ordinal":115108,"en":"Hero Shuutu, his cap like a yurt's felt cover—"},{"id":"semetey-1-2013:p0498:b003:l030","ordinal":115109,"en":"Mounted on their fine steeds,"},{"id":"semetey-1-2013:p0498:b003:l031","ordinal":115110,"en":"Now charged and attacked,"},{"id":"semetey-1-2013:p0498:b003:l032","ordinal":115111,"en":"All forty companions in the fray."},{"id":"semetey-1-2013:p0498:b003:l033","ordinal":115112,"en":"The seven ishans who had come from Mecca"},{"id":"semetey-1-2013:p0498:b003:l034","ordinal":115113,"en":"He stationed in seven places;"},{"id":"semetey-1-2013:p0498:b003:l035","ordinal":115114,"en":"Your consummate elder Bakai"},{"id":"semetey-1-2013:p0498:b003:l036","ordinal":115115,"en":"Sent those he reached crawling."},{"id":"semetey-1-2013:p0498:b003:l037","ordinal":115116,"en":"Look at the dust drawing a haze,"},{"id":"semetey-1-2013:p0498:b003:l038","ordinal":115117,"en":"Within that very dust"},{"id":"semetey-1-2013:p0498:b003:l039","ordinal":115118,"en":"Look at the souls lying dead!"},{"id":"semetey-1-2013:p0498:b004:l001","ordinal":115119,"en":"When he saw the havoc,"},{"id":"semetey-1-2013:p0498:b004:l002","ordinal":115120,"en":"When Jeldeiboz, in the clash,"},{"id":"semetey-1-2013:p0498:b004:l003","ordinal":115121,"en":"Was killed by Khan Bakai,"},{"id":"semetey-1-2013:p0498:b004:l004","ordinal":115122,"en":"Then Közkaman,"},{"id":"semetey-1-2013:p0498:b004:l005","ordinal":115123,"en":"Upon great Kongkulboz the steed,"},{"id":"semetey-1-2013:p0498:b004:l006","ordinal":115124,"en":"Lashing this way and that,"},{"id":"semetey-1-2013:p0498:b004:l007","ordinal":115125,"en":"Spurring right and left,"},{"id":"semetey-1-2013:p0498:b004:l008","ordinal":115126,"en":"Reached the forty companions."},{"id":"semetey-1-2013:p0498:b004:l009","ordinal":115127,"en":"Hero Shuutu, his cap like a felt cover,"},{"id":"semetey-1-2013:p0498:b004:l010","ordinal":115128,"en":"Yraman's Yrchuul,"},{"id":"semetey-1-2013:p0498:b004:l011","ordinal":115129,"en":"Dark Tölög the diviner,"},{"id":"semetey-1-2013:p0498:b004:l012","ordinal":115130,"en":"And Baichoro—these four"},{"id":"semetey-1-2013:p0498:b004:l013","ordinal":115131,"en":"Közkaman came sweeping upon."},{"id":"semetey-1-2013:p0498:b004:l014","ordinal":115132,"en":"Struck by Közkaman's spear,"},{"id":"semetey-1-2013:p0498:b004:l015","ordinal":115133,"en":"All four, where he reached them,"},{"id":"semetey-1-2013:p0498:b004:l016","ordinal":115134,"en":"Were flung from their horses."},{"id":"semetey-1-2013:p0498:b004:l017","ordinal":115135,"en":"Skillfully spearing warriors,"},{"id":"semetey-1-2013:p0498:b004:l018","ordinal":115136,"en":"Közkaman, that mighty wrestler,"},{"id":"semetey-1-2013:p0498:b004:l019","ordinal":115137,"en":"Struck all four in succession."},{"id":"semetey-1-2013:p0498:b004:l020","ordinal":115138,"en":"Roaring in fury,"},{"id":"semetey-1-2013:p0498:b004:l021","ordinal":115139,"en":"“Are there any more warriors?” he cried,"},{"id":"semetey-1-2013:p0498:b004:l022","ordinal":115140,"en":"Challenging them to single combat."},{"id":"semetey-1-2013:p0498:b004:l023","ordinal":115141,"en":"As though he would devour them,"},{"id":"semetey-1-2013:p0498:b004:l024","ordinal":115142,"en":"The swine stood there puffed up."},{"id":"semetey-1-2013:p0498:b004:l025","ordinal":115143,"en":"Having torn them from their horses,"},{"id":"semetey-1-2013:p0498:b004:l026","ordinal":115144,"en":"Having made this spectacle,"},{"id":"semetey-1-2013:p0498:b004:l027","ordinal":115145,"en":"His warriors charged"},{"id":"semetey-1-2013:p0498:b004:l028","ordinal":115146,"en":"To reach those four,"},{"id":"semetey-1-2013:p0498:b004:l029","ordinal":115147,"en":"About to cut off their heads."},{"id":"semetey-1-2013:p0498:b004:l030","ordinal":115148,"en":"Charging toward hero Shuutu,"},{"id":"semetey-1-2013:p0498:b004:l031","ordinal":115149,"en":"Noble Serek arrived."},{"id":"semetey-1-2013:p0498:b004:l032","ordinal":115150,"en":"Hero Serek caught up hero Shuutu"},{"id":"semetey-1-2013:p0498:b004:l033","ordinal":115151,"en":"And galloped off with him."},{"id":"semetey-1-2013:p0498:b004:l034","ordinal":115152,"en":"Charging toward Yrchuul,"},{"id":"semetey-1-2013:p0498:b004:l035","ordinal":115153,"en":"Outstanding Syrgak arrived."},{"id":"semetey-1-2013:p0498:b004:l036","ordinal":115154,"en":"Hero Syrgak swooped and caught him,"},{"id":"semetey-1-2013:p0498:b004:l037","ordinal":115155,"en":"Seated him upon his right knee."},{"id":"semetey-1-2013:p0498:b004:l038","ordinal":115156,"en":"Before an eye could open and shut,"},{"id":"semetey-1-2013:p0498:b004:l039","ordinal":115157,"en":"Before a word could be spoken,"},{"id":"semetey-1-2013:p0499:b003:l001","ordinal":115158,"en":"He showed that he was a lion."},{"id":"semetey-1-2013:p0499:b003:l002","ordinal":115159,"en":"Four choros—the four companions—"},{"id":"semetey-1-2013:p0499:b003:l003","ordinal":115160,"en":"Reached them and mounted them on horses,"},{"id":"semetey-1-2013:p0499:b003:l004","ordinal":115161,"en":"Kindled their extinguished fires,"},{"id":"semetey-1-2013:p0499:b003:l005","ordinal":115162,"en":"Revived their dying souls."},{"id":"semetey-1-2013:p0499:b003:l006","ordinal":115163,"en":"As they mounted the fallen"},{"id":"semetey-1-2013:p0499:b003:l007","ordinal":115164,"en":"And were busy with them,"},{"id":"semetey-1-2013:p0499:b003:l008","ordinal":115165,"en":"His two eyes flashing fiercely,"},{"id":"semetey-1-2013:p0499:b003:l009","ordinal":115166,"en":"His mighty teeth like doors—"},{"id":"semetey-1-2013:p0499:b003:l010","ordinal":115167,"en":"Was he not Khan Közkaman?—"},{"id":"semetey-1-2013:p0499:b003:l011","ordinal":115168,"en":"He gnashed them hard and loud:"},{"id":"semetey-1-2013:p0499:b003:l012","ordinal":115169,"en":"“Beginning with Syrgak, the forty companions—"},{"id":"semetey-1-2013:p0499:b003:l013","ordinal":115170,"en":"I shall bring them to ruin."},{"id":"semetey-1-2013:p0499:b003:l014","ordinal":115171,"en":"Leaving not one companion,"},{"id":"semetey-1-2013:p0499:b003:l015","ordinal":115172,"en":"I shall wipe them out!”"},{"id":"semetey-1-2013:p0499:b003:l016","ordinal":115173,"en":"Seething, his eyes clouded,"},{"id":"semetey-1-2013:p0499:b003:l017","ordinal":115174,"en":"He thrust his spear toward Syrgak."},{"id":"semetey-1-2013:p0499:b003:l018","ordinal":115175,"en":"His neck stretched like Mount Opol;"},{"id":"semetey-1-2013:p0499:b003:l019","ordinal":115176,"en":"As he came eagerly at Syrgak,"},{"id":"semetey-1-2013:p0499:b003:l020","ordinal":115177,"en":"The outstanding hero Almambet,"},{"id":"semetey-1-2013:p0499:b003:l021","ordinal":115178,"en":"Roaring the Prophet's name,"},{"id":"semetey-1-2013:p0499:b003:l022","ordinal":115179,"en":"Upon his horse Aisarala,"},{"id":"semetey-1-2013:p0499:b003:l023","ordinal":115180,"en":"Crying “Manas!” as his battle-cry,"},{"id":"semetey-1-2013:p0499:b003:l024","ordinal":115181,"en":"His waist bent far forward,"},{"id":"semetey-1-2013:p0499:b003:l025","ordinal":115182,"en":"His noble, blazing eyes"},{"id":"semetey-1-2013:p0499:b003:l026","ordinal":115183,"en":"Bulging, all but bursting out—"},{"id":"semetey-1-2013:p0499:b003:l027","ordinal":115184,"en":"Expert elder Almambet, the fortunate,"},{"id":"semetey-1-2013:p0499:b003:l028","ordinal":115185,"en":"Arrived before an arrow could."},{"id":"semetey-1-2013:p0499:b003:l029","ordinal":115186,"en":"From atop Kongkulboz,"},{"id":"semetey-1-2013:p0499:b003:l030","ordinal":115187,"en":"Almambet, reaching him,"},{"id":"semetey-1-2013:p0499:b003:l031","ordinal":115188,"en":"That warrior Közkaman"},{"id":"semetey-1-2013:p0499:b003:l032","ordinal":115189,"en":"Brought crashing down as he passed."},{"id":"semetey-1-2013:p0499:b003:l033","ordinal":115190,"en":"He who wore the blue lynx-fur cap,"},{"id":"semetey-1-2013:p0499:b003:l034","ordinal":115191,"en":"Who wielded the mottled blue shield,"},{"id":"semetey-1-2013:p0499:b003:l035","ordinal":115192,"en":"Who found the right word in a crisis,"},{"id":"semetey-1-2013:p0499:b003:l036","ordinal":115193,"en":"Who found sight in the darkest night,"},{"id":"semetey-1-2013:p0499:b003:l037","ordinal":115194,"en":"Lucky when sent out in front,"},{"id":"semetey-1-2013:p0499:b003:l038","ordinal":115195,"en":"Like countless troops when driving onward,"},{"id":"semetey-1-2013:p0499:b003:l039","ordinal":115196,"en":"My elder Bakai, the old man,"},{"id":"semetey-1-2013:p0499:b005:l001","ordinal":115197,"en":"Who had grappled in many places,"},{"id":"semetey-1-2013:p0499:b005:l002","ordinal":115198,"en":"The sage who knew the enemy's tricks,"},{"id":"semetey-1-2013:p0499:b005:l003","ordinal":115199,"en":"Lashed his gray steed once,"},{"id":"semetey-1-2013:p0499:b005:l004","ordinal":115200,"en":"Took the fearsome sword in hand;"}]
