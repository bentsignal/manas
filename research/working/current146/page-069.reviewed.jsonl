{"id": "sayakbay-ms-current146:pdf069:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 69, "folio": 452, "line_in_page": 26, "raw": "Арманга болуп карамдуу,", "text": "Арманга болуп карамдуу,", "en": "Grief-stricken and sorrowful,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or a material variant from the printed continuation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf069:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 69, "folio": 452, "line_in_page": 27, "raw": "Айдаган башка ой калбай,", "text": "Айдаган башка ой калбай,", "en": "With no other thought left to pursue,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or a material variant from the printed continuation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf069:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 69, "folio": 452, "line_in_page": 28, "raw": "Турган экен Желжетпес.", "text": "Турган экен Желжетпес.", "en": "There stood Jeljetpes.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or a material variant from the printed continuation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf069:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 69, "folio": 452, "line_in_page": 29, "raw": "Арман кылып көз жайнап,", "text": "Арман кылып көз жайнап,", "en": "Lamenting, his eyes shone,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or a material variant from the printed continuation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf069:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 69, "folio": 452, "line_in_page": 30, "raw": "Санаа санга бөлүнүп,", "text": "Санаа санга бөлүнүп,", "en": "His care divided into countless cares,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf069:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 69, "folio": 452, "line_in_page": 31, "raw": "Каары тозок Чың Темир,", "text": "Каары тозок Чың Темир,", "en": "Chyng Temir, whose wrath was hell,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf069:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 69, "folio": 452, "line_in_page": 32, "raw": "Жалаңкыч түрү көрүнүп,", "text": "Жалаңкыч түрү көрүнүп,", "en": "Appeared in a fearsome aspect,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or a material variant from the printed continuation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf069:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 69, "folio": 452, "line_in_page": 33, "raw": "Жалынган менен жан калбайт,", "text": "Жалынган менен жан калбайт,", "en": "Though one begged, no life would be spared,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or a material variant from the printed continuation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf069:l034", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 69, "folio": 452, "line_in_page": 34, "raw": "Жалбарган менен ал калбайт.", "text": "Жалбарган менен ал калбайт.", "en": "Though one pleaded, none would remain.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or a material variant from the printed continuation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf069:l035", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 69, "folio": 452, "line_in_page": 35, "raw": "Ата карап, эне тууган,", "text": "Ата карап, эне тууган,", "en": "Born of a father and mother,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or a material variant from the printed continuation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf069:l036", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 69, "folio": 452, "line_in_page": 36, "raw": "Жаралган пенде өлбөйбү.", "text": "Жаралган пенде өлбөйбү.", "en": "What created mortal does not die?", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
