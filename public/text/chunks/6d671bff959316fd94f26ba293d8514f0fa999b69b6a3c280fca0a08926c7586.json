[{"id":"semetey-1-2013:p1196:b004:l009","ordinal":168449,"en":"Chinmachin, or Kakan."},{"id":"semetey-1-2013:p1196:b004:l010","ordinal":168450,"en":"My true friend Manas, grant this to me;"},{"id":"semetey-1-2013:p1196:b004:l011","ordinal":168451,"en":"When else shall I see your support?\""},{"id":"semetey-1-2013:p1196:b004:l012","ordinal":168452,"en":"When Almambet had spoken so,"},{"id":"semetey-1-2013:p1196:b004:l013","ordinal":168453,"en":"Great-hearted Manas replied:"},{"id":"semetey-1-2013:p1196:b004:l014","ordinal":168454,"en":"\"Ah, Alake, my gray wolf,"},{"id":"semetey-1-2013:p1196:b004:l015","ordinal":168455,"en":"Would the black Chinese and Manchu people"},{"id":"semetey-1-2013:p1196:b004:l016","ordinal":168456,"en":"Not consume us with their slander?"},{"id":"semetey-1-2013:p1196:b004:l017","ordinal":168457,"en":"Would they not say, 'When Khan Azozyl's only son"},{"id":"semetey-1-2013:p1196:b004:l018","ordinal":168458,"en":"Fled and came to the Buruts,"},{"id":"semetey-1-2013:p1196:b004:l019","ordinal":168459,"en":"They mercilessly handed him over"},{"id":"semetey-1-2013:p1196:b004:l020","ordinal":168460,"en":"To be put to death'?"},{"id":"semetey-1-2013:p1196:b004:l021","ordinal":168461,"en":"Would the Chinese not mock us,"},{"id":"semetey-1-2013:p1196:b004:l022","ordinal":168462,"en":"Would God not strike down my land?"},{"id":"semetey-1-2013:p1196:b004:l023","ordinal":168463,"en":"Would the fortune of this gray wolf Almambet"},{"id":"semetey-1-2013:p1196:b004:l024","ordinal":168464,"en":"Not be broken by this deed?"},{"id":"semetey-1-2013:p1196:b004:l025","ordinal":168465,"en":"The Chinese would turn it into a legend;"},{"id":"semetey-1-2013:p1196:b004:l026","ordinal":168466,"en":"Would God not strike us for it?"},{"id":"semetey-1-2013:p1196:b004:l027","ordinal":168467,"en":"Would they not gnaw at our very core,"},{"id":"semetey-1-2013:p1196:b004:l028","ordinal":168468,"en":"Saying, 'That wandering Chinese man"},{"id":"semetey-1-2013:p1196:b004:l029","ordinal":168469,"en":"They handed over to death'?"},{"id":"semetey-1-2013:p1196:b004:l030","ordinal":168470,"en":"Would they not say, 'The patterned spear in his hand"},{"id":"semetey-1-2013:p1196:b004:l031","ordinal":168471,"en":"At last failed him'?"},{"id":"semetey-1-2013:p1196:b004:l032","ordinal":168472,"en":"Would they not say that Manas"},{"id":"semetey-1-2013:p1196:b004:l033","ordinal":168473,"en":"And all the assembled Buruts"},{"id":"semetey-1-2013:p1196:b004:l034","ordinal":168474,"en":"Spared him from Kongurbay?"},{"id":"semetey-1-2013:p1196:b004:l035","ordinal":168475,"en":"Would they not say that to Kokotoy's feast"},{"id":"semetey-1-2013:p1196:b004:l036","ordinal":168476,"en":"Almambet came as a fugitive,"},{"id":"semetey-1-2013:p1196:b004:l037","ordinal":168477,"en":"Fleeing and wandering?"},{"id":"semetey-1-2013:p1196:b004:l038","ordinal":168478,"en":"Would they not say that all the Buruts gathered"},{"id":"semetey-1-2013:p1196:b004:l039","ordinal":168479,"en":"And Almambet's punishment"},{"id":"semetey-1-2013:p1196:b004:l040","ordinal":168480,"en":"Was carried out by them?\""},{"id":"semetey-1-2013:p1197:b003:l001","ordinal":168481,"en":"\"Oh Almambet, my soul's friend,"},{"id":"semetey-1-2013:p1197:b003:l002","ordinal":168482,"en":"If you go out to joust,"},{"id":"semetey-1-2013:p1197:b003:l003","ordinal":168483,"en":"This act of yours will bring shame."},{"id":"semetey-1-2013:p1197:b003:l004","ordinal":168484,"en":"If you truly are my friend,"},{"id":"semetey-1-2013:p1197:b003:l005","ordinal":168485,"en":"Stand aside and watch impartially."},{"id":"semetey-1-2013:p1197:b003:l006","ordinal":168486,"en":"Lay down your agitation"},{"id":"semetey-1-2013:p1197:b003:l007","ordinal":168487,"en":"And be our support."},{"id":"semetey-1-2013:p1197:b003:l008","ordinal":168488,"en":"Consent to what I say."},{"id":"semetey-1-2013:p1197:b003:l009","ordinal":168489,"en":"Sarala beneath you"},{"id":"semetey-1-2013:p1197:b003:l010","ordinal":168490,"en":"Is a beast fit to ride into combat;"},{"id":"semetey-1-2013:p1197:b003:l011","ordinal":168491,"en":"Give us the use of its strength."},{"id":"semetey-1-2013:p1197:b003:l012","ordinal":168492,"en":"If you give Sarala's strength,"},{"id":"semetey-1-2013:p1197:b003:l013","ordinal":168493,"en":"We shall ride your swift horse."},{"id":"semetey-1-2013:p1197:b003:l014","ordinal":168494,"en":"Against that dog who boasts of strength"},{"id":"semetey-1-2013:p1197:b003:l015","ordinal":168495,"en":"I shall clash and test myself."},{"id":"semetey-1-2013:p1197:b003:l016","ordinal":168496,"en":"He has mounted Algara"},{"id":"semetey-1-2013:p1197:b003:l017","ordinal":168497,"en":"And has grown boastful of his valor."},{"id":"semetey-1-2013:p1197:b003:l018","ordinal":168498,"en":"Against that boastful dog"},{"id":"semetey-1-2013:p1197:b003:l019","ordinal":168499,"en":"I shall meet chest to chest."},{"id":"semetey-1-2013:p1197:b003:l020","ordinal":168500,"en":"Against that dog who boasts of strength"},{"id":"semetey-1-2013:p1197:b003:l021","ordinal":168501,"en":"Let me see how our clash will end!\""},{"id":"semetey-1-2013:p1197:b003:l022","ordinal":168502,"en":"The hero Manas, the panther,"},{"id":"semetey-1-2013:p1197:b003:l023","ordinal":168503,"en":"Before all the people, from Almambet"},{"id":"semetey-1-2013:p1197:b003:l024","ordinal":168504,"en":"Asked for Sarala."},{"id":"semetey-1-2013:p1197:b003:l025","ordinal":168505,"en":"Almambet restrained his anger"},{"id":"semetey-1-2013:p1197:b003:l026","ordinal":168506,"en":"And surrendered Sarala."},{"id":"semetey-1-2013:p1197:b003:l027","ordinal":168507,"en":"To the hero Manas, the gray wolf,"},{"id":"semetey-1-2013:p1197:b003:l028","ordinal":168508,"en":"Unable to say, \"I will not give it,\""},{"id":"semetey-1-2013:p1197:b003:l029","ordinal":168509,"en":"And unwilling to reject the hero's wish,"},{"id":"semetey-1-2013:p1197:b003:l030","ordinal":168510,"en":"He consented to what Manas said"},{"id":"semetey-1-2013:p1197:b003:l031","ordinal":168511,"en":"And gave Sarala, bright as moonlight,"},{"id":"semetey-1-2013:p1197:b003:l032","ordinal":168512,"en":"To his great-hearted lord."},{"id":"semetey-1-2013:p1197:b003:l033","ordinal":168513,"en":"Upon Sarala"},{"id":"semetey-1-2013:p1197:b003:l034","ordinal":168514,"en":"Was Alake's white saddle;"},{"id":"semetey-1-2013:p1197:b003:l035","ordinal":168515,"en":"Three girths and three cruppers—"},{"id":"semetey-1-2013:p1197:b003:l036","ordinal":168516,"en":"He loosened all six,"},{"id":"semetey-1-2013:p1197:b003:l037","ordinal":168517,"en":"And removed the white saddle."},{"id":"semetey-1-2013:p1197:b003:l038","ordinal":168518,"en":"Taking off its tack and leaving it bareback,"},{"id":"semetey-1-2013:p1197:b003:l039","ordinal":168519,"en":"He took a shortcut down a narrow path,"},{"id":"semetey-1-2013:p1197:b003:l040","ordinal":168520,"en":"Leading Almambet's Sarala"},{"id":"semetey-1-2013:p1197:b004:l001","ordinal":168521,"en":"Along entirely bareback."},{"id":"semetey-1-2013:p1197:b004:l002","ordinal":168522,"en":"The gray sash that fell from the sky"},{"id":"semetey-1-2013:p1197:b004:l003","ordinal":168523,"en":"Was wrapped around his slender waist;"},{"id":"semetey-1-2013:p1197:b004:l004","ordinal":168524,"en":"The panther touched by Kydyr"},{"id":"semetey-1-2013:p1197:b004:l005","ordinal":168525,"en":"Prayed to the Almighty."},{"id":"semetey-1-2013:p1197:b004:l006","ordinal":168526,"en":"In fury he made himself ready,"},{"id":"semetey-1-2013:p1197:b004:l007","ordinal":168527,"en":"And buckled on Zulpukor,"},{"id":"semetey-1-2013:p1197:b004:l008","ordinal":168528,"en":"The six blades that fell from heaven."},{"id":"semetey-1-2013:p1197:b004:l009","ordinal":168529,"en":"The lionlike gray-wolf panther"},{"id":"semetey-1-2013:p1197:b004:l010","ordinal":168530,"en":"Moved with ringing confidence,"},{"id":"semetey-1-2013:p1197:b004:l011","ordinal":168531,"en":"Holding the warrior Kongur he would fight"},{"id":"semetey-1-2013:p1197:b004:l012","ordinal":168532,"en":"As worth no more than the hem of his robe."},{"id":"semetey-1-2013:p1197:b004:l013","ordinal":168533,"en":"He gave no thought to where it might end,"},{"id":"semetey-1-2013:p1197:b004:l014","ordinal":168534,"en":"And never thought, \"I shall die.\""},{"id":"semetey-1-2013:p1197:b004:l015","ordinal":168535,"en":"When the great host of dark-clad Muslims"},{"id":"semetey-1-2013:p1197:b004:l016","ordinal":168536,"en":"Looked on, their hearts were stirred."},{"id":"semetey-1-2013:p1197:b004:l017","ordinal":168537,"en":"The panther's guardian spirit"},{"id":"semetey-1-2013:p1197:b004:l018","ordinal":168538,"en":"Appeared like a snow-covered mountain;"},{"id":"semetey-1-2013:p1197:b004:l019","ordinal":168539,"en":"Nine protectors appeared"},{"id":"semetey-1-2013:p1197:b004:l020","ordinal":168540,"en":"On his right side,"},{"id":"semetey-1-2013:p1197:b004:l021","ordinal":168541,"en":"And nine supporters appeared,"},{"id":"semetey-1-2013:p1197:b004:l022","ordinal":168542,"en":"Bearing the likeness of takers of souls."},{"id":"semetey-1-2013:p1197:b004:l023","ordinal":168543,"en":"The blood-drinking lion was enraged,"},{"id":"semetey-1-2013:p1197:b004:l024","ordinal":168544,"en":"Truly seized by his thirst for blood."},{"id":"semetey-1-2013:p1197:b004:l025","ordinal":168545,"en":"When one looked upon his front,"},{"id":"semetey-1-2013:p1197:b004:l026","ordinal":168546,"en":"His eyes blazed like a lion's;"},{"id":"semetey-1-2013:p1197:b004:l027","ordinal":168547,"en":"He charged like a tiger,"},{"id":"semetey-1-2013:p1197:b004:l028","ordinal":168548,"en":"And none he struck could remain alive."},{"id":"semetey-1-2013:p1197:b004:l029","ordinal":168549,"en":"He frowned darkly in wrath—"},{"id":"semetey-1-2013:p1197:b004:l030","ordinal":168550,"en":"Such was the panther's state."},{"id":"semetey-1-2013:p1197:b004:l031","ordinal":168551,"en":"From the giants Koshoy and Toshtuk,"},{"id":"semetey-1-2013:p1197:b004:l032","ordinal":168552,"en":"From Azhybai and Khan Bakai,"},{"id":"semetey-1-2013:p1197:b004:l033","ordinal":168553,"en":"With palms raised, saying \"Amen,\""},{"id":"semetey-1-2013:p1197:b004:l034","ordinal":168554,"en":"He stood asking their blessing."},{"id":"semetey-1-2013:p1197:b004:l035","ordinal":168555,"en":"The two khans, Bakai and Koshoy,"},{"id":"semetey-1-2013:p1197:b004:l036","ordinal":168556,"en":"Hung their belts around their necks;"},{"id":"semetey-1-2013:p1197:b004:l037","ordinal":168557,"en":"Raising their palms and saying \"Amen,\""},{"id":"semetey-1-2013:p1197:b004:l038","ordinal":168558,"en":"They prayed to the Almighty:"},{"id":"semetey-1-2013:p1197:b004:l039","ordinal":168559,"en":"\"O Almighty, amen!"},{"id":"semetey-1-2013:p1197:b004:l040","ordinal":168560,"en":"His fortune has always been complete."},{"id":"semetey-1-2013:p1198:b003:l001","ordinal":168561,"en":"God, cast the infidel beneath him;"},{"id":"semetey-1-2013:p1198:b003:l002","ordinal":168562,"en":"God, raise Manas above him."},{"id":"semetey-1-2013:p1198:b003:l003","ordinal":168563,"en":"He is the lion upheld by the patron spirit;"},{"id":"semetey-1-2013:p1198:b003:l004","ordinal":168564,"en":"Creator, hear my words"},{"id":"semetey-1-2013:p1198:b003:l005","ordinal":168565,"en":"And do not let my back be broken."},{"id":"semetey-1-2013:p1198:b003:l006","ordinal":168566,"en":"God, grant victory"},{"id":"semetey-1-2013:p1198:b003:l007","ordinal":168567,"en":"To my panther Manas, my lion."},{"id":"semetey-1-2013:p1198:b003:l008","ordinal":168568,"en":"Do not raise the Chinese above us,"},{"id":"semetey-1-2013:p1198:b003:l009","ordinal":168569,"en":"Do not cast the Kyrgyz beneath them."},{"id":"semetey-1-2013:p1198:b003:l010","ordinal":168570,"en":"The morning star stands in the sky;"},{"id":"semetey-1-2013:p1198:b003:l011","ordinal":168571,"en":"God, do not scatter those behind him."},{"id":"semetey-1-2013:p1198:b003:l012","ordinal":168572,"en":"If You created the black Kalmyks and Manchus"},{"id":"semetey-1-2013:p1198:b003:l013","ordinal":168573,"en":"As living souls, O God,"},{"id":"semetey-1-2013:p1198:b003:l014","ordinal":168574,"en":"Do not let their eyes ever look straight upon him."},{"id":"semetey-1-2013:p1198:b003:l015","ordinal":168575,"en":"If by mischance he falls from his horse,"},{"id":"semetey-1-2013:p1198:b003:l016","ordinal":168576,"en":"The lion prince, the panther,"},{"id":"semetey-1-2013:p1198:b003:l017","ordinal":168577,"en":"If by accident he should fall,"},{"id":"semetey-1-2013:p1198:b003:l018","ordinal":168578,"en":"They stand ready to write the line,"},{"id":"semetey-1-2013:p1198:b003:l019","ordinal":168579,"en":"'He delivered his Manas into our hands.'"},{"id":"semetey-1-2013:p1198:b003:l020","ordinal":168580,"en":"With Khan Kongurbay at their head,"},{"id":"semetey-1-2013:p1198:b003:l021","ordinal":168581,"en":"Against the Muslim people"},{"id":"semetey-1-2013:p1198:b003:l022","ordinal":168582,"en":"They stand ready to make a spectacle."},{"id":"semetey-1-2013:p1198:b003:l023","ordinal":168583,"en":"Do not let the Chinese day dawn;"},{"id":"semetey-1-2013:p1198:b003:l024","ordinal":168584,"en":"If You created my people as living souls,"},{"id":"semetey-1-2013:p1198:b003:l025","ordinal":168585,"en":"Do not let them be slaughtered"},{"id":"semetey-1-2013:p1198:b003:l026","ordinal":168586,"en":"And driven back toward their homeland."},{"id":"semetey-1-2013:p1198:b003:l027","ordinal":168587,"en":"The black Kalmyks and Manchus"},{"id":"semetey-1-2013:p1198:b003:l028","ordinal":168588,"en":"Have a migrating host they once shattered,"},{"id":"semetey-1-2013:p1198:b003:l029","ordinal":168589,"en":"And have long borne a grudge against us."},{"id":"semetey-1-2013:p1198:b003:l030","ordinal":168590,"en":"If Manas were no longer before their eyes,"},{"id":"semetey-1-2013:p1198:b003:l031","ordinal":168591,"en":"The arrogant heroes' heads"},{"id":"semetey-1-2013:p1198:b003:l032","ordinal":168592,"en":"They yearn to take with their swords;"},{"id":"semetey-1-2013:p1198:b003:l033","ordinal":168593,"en":"The Chinese go about nursing vengeance,"},{"id":"semetey-1-2013:p1198:b003:l034","ordinal":168594,"en":"Longing to bring slaughter upon us."},{"id":"semetey-1-2013:p1198:b003:l035","ordinal":168595,"en":"This infidel has a fearsome look"},{"id":"semetey-1-2013:p1198:b003:l036","ordinal":168596,"en":"And has long been possessed by rage."},{"id":"semetey-1-2013:p1198:b003:l037","ordinal":168597,"en":"The Chinese eagerly seek"},{"id":"semetey-1-2013:p1198:b003:l038","ordinal":168598,"en":"To bind and capture the faithful,"},{"id":"semetey-1-2013:p1198:b003:l039","ordinal":168599,"en":"And to make all the Muslims"},{"id":"semetey-1-2013:p1198:b003:l040","ordinal":168600,"en":"Into slave laborers."},{"id":"semetey-1-2013:p1198:b004:l001","ordinal":168601,"en":"The ravenous black Chinese—"},{"id":"semetey-1-2013:p1198:b004:l002","ordinal":168602,"en":"If people like us fall into their hands,"},{"id":"semetey-1-2013:p1198:b004:l003","ordinal":168603,"en":"Their custom is to slaughter every one."},{"id":"semetey-1-2013:p1198:b004:l004","ordinal":168604,"en":"At Kokotoy's memorial feast"},{"id":"semetey-1-2013:p1198:b004:l005","ordinal":168605,"en":"We have happened to gather together."},{"id":"semetey-1-2013:p1198:b004:l006","ordinal":168606,"en":"Make this an age that finds its meaning;"},{"id":"semetey-1-2013:p1198:b004:l007","ordinal":168607,"en":"If You created us as living souls, O God,"},{"id":"semetey-1-2013:p1198:b004:l008","ordinal":168608,"en":"Keep Manas safe for us."},{"id":"semetey-1-2013:p1198:b004:l009","ordinal":168609,"en":"Oh Khan Manas, my dear colt!\""},{"id":"semetey-1-2013:p1198:b004:l010","ordinal":168610,"en":"So then the Muslims prayed;"},{"id":"semetey-1-2013:p1198:b004:l011","ordinal":168611,"en":"The elders Koshoy and Bakai,"},{"id":"semetey-1-2013:p1198:b004:l012","ordinal":168612,"en":"Those saints, gave their blessing."},{"id":"semetey-1-2013:p1198:b004:l013","ordinal":168613,"en":"Raising their hands and sobbing,"},{"id":"semetey-1-2013:p1198:b004:l014","ordinal":168614,"en":"The handful of Muslims"},{"id":"semetey-1-2013:p1198:b004:l015","ordinal":168615,"en":"Loudly cried out their blessing."},{"id":"semetey-1-2013:p1198:b004:l016","ordinal":168616,"en":"The Muslims stood in an uproar:"},{"id":"semetey-1-2013:p1198:b004:l017","ordinal":168617,"en":"Is not Manas the backbone"},{"id":"semetey-1-2013:p1198:b004:l018","ordinal":168618,"en":"That braces the Kyrgyz waist?"},{"id":"semetey-1-2013:p1198:b004:l019","ordinal":168619,"en":"Unshaken and courageous,"},{"id":"semetey-1-2013:p1198:b004:l020","ordinal":168620,"en":"Is not Manas their lion?"},{"id":"semetey-1-2013:p1198:b004:l021","ordinal":168621,"en":"Is it not Manas who brought slaughter"},{"id":"semetey-1-2013:p1198:b004:l022","ordinal":168622,"en":"Across the whole wide world?"},{"id":"semetey-1-2013:p1198:b004:l023","ordinal":168623,"en":"Is it not Manas who freed"},{"id":"semetey-1-2013:p1198:b004:l024","ordinal":168624,"en":"All of the Muslims"},{"id":"semetey-1-2013:p1198:b004:l025","ordinal":168625,"en":"From the black Chinese and Manchus"},{"id":"semetey-1-2013:p1198:b004:l026","ordinal":168626,"en":"And gathered them beneath his hand?"},{"id":"semetey-1-2013:p1198:b004:l027","ordinal":168627,"en":"Looming like Opol-Too,"},{"id":"semetey-1-2013:p1198:b004:l028","ordinal":168628,"en":"Your saintly gray wolf Manas"},{"id":"semetey-1-2013:p1198:b004:l029","ordinal":168629,"en":"Grew wrathful and made himself ready;"},{"id":"semetey-1-2013:p1198:b004:l030","ordinal":168630,"en":"The blood-drinker Manas mounted his horse."},{"id":"semetey-1-2013:p1198:b004:l031","ordinal":168631,"en":"Twenty rode on his right,"},{"id":"semetey-1-2013:p1198:b004:l032","ordinal":168632,"en":"Worthy comrades, matchless men;"},{"id":"semetey-1-2013:p1198:b004:l033","ordinal":168633,"en":"Twenty rode on his left,"},{"id":"semetey-1-2013:p1198:b004:l034","ordinal":168634,"en":"Bodyguard companions of the blood-drinker,"},{"id":"semetey-1-2013:p1198:b004:l035","ordinal":168635,"en":"Matchless men who brought devastation."},{"id":"semetey-1-2013:p1198:b004:l036","ordinal":168636,"en":"Kalkaman's Black Horse"},{"id":"semetey-1-2013:p1198:b004:l037","ordinal":168637,"en":"The blood-drinker had mounted,"},{"id":"semetey-1-2013:p1198:b004:l038","ordinal":168638,"en":"While cow-rumped Sarala"},{"id":"semetey-1-2013:p1198:b004:l039","ordinal":168639,"en":"Was led beside him bareback."},{"id":"semetey-1-2013:p1198:b004:l040","ordinal":168640,"en":"All of those master riders"},{"id":"semetey-1-2013:p1199:b003:l001","ordinal":168641,"en":"As though ready to come to his aid,"},{"id":"semetey-1-2013:p1199:b003:l002","ordinal":168642,"en":"They held out their spears"},{"id":"semetey-1-2013:p1199:b003:l003","ordinal":168643,"en":"And stood as his support."},{"id":"semetey-1-2013:p1199:b003:l004","ordinal":168644,"en":"The finest of the forty companions,"},{"id":"semetey-1-2013:p1199:b003:l005","ordinal":168645,"en":"The most skillful of spearmen,"},{"id":"semetey-1-2013:p1199:b003:l006","ordinal":168646,"en":"The very strongest heroes,"},{"id":"semetey-1-2013:p1199:b003:l007","ordinal":168647,"en":"The blaze-headed thoroughbreds among horses—"},{"id":"semetey-1-2013:p1199:b003:l008","ordinal":168648,"en":"Almambet and Chubak among them,"},{"id":"semetey-1-2013:p1199:b003:l009","ordinal":168649,"en":"With Khan Agybay and Bakai there—"},{"id":"semetey-1-2013:p1199:b003:l010","ordinal":168650,"en":"They stood in support then;"},{"id":"semetey-1-2013:p1199:b003:l011","ordinal":168651,"en":"All the falcons were there."},{"id":"semetey-1-2013:p1199:b003:l012","ordinal":168652,"en":"If Manas dismounted,"},{"id":"semetey-1-2013:p1199:b003:l013","ordinal":168653,"en":"The leopards Almambet and Chubak"},{"id":"semetey-1-2013:p1199:b003:l014","ordinal":168654,"en":"Would reach him before he could open his eyes."},{"id":"semetey-1-2013:p1199:b003:l015","ordinal":168655,"en":"The lions Agybay and Bakai"},{"id":"semetey-1-2013:p1199:b003:l016","ordinal":168656,"en":"Would make a massacre"},{"id":"semetey-1-2013:p1199:b003:l017","ordinal":168657,"en":"Of the fucking Chinese as they passed."},{"id":"semetey-1-2013:p1199:b003:l018","ordinal":168658,"en":"Hero Manas the leopard,"},{"id":"semetey-1-2013:p1199:b003:l019","ordinal":168659,"en":"His nose bulging like a leather flask,"},{"id":"semetey-1-2013:p1199:b003:l020","ordinal":168660,"en":"Was truly seized by thirst for blood."},{"id":"semetey-1-2013:p1199:b003:l021","ordinal":168661,"en":"Manas had forty companions;"},{"id":"semetey-1-2013:p1199:b003:l022","ordinal":168662,"en":"Kongurbay had forty princes."},{"id":"semetey-1-2013:p1199:b003:l023","ordinal":168663,"en":"Behind Kongurbay"},{"id":"semetey-1-2013:p1199:b003:l024","ordinal":168664,"en":"Were bellowing Manchus,"},{"id":"semetey-1-2013:p1199:b003:l025","ordinal":168665,"en":"Swaying Shibe,"},{"id":"semetey-1-2013:p1199:b003:l026","ordinal":168666,"en":"Their cuirasses hanging loose,"},{"id":"semetey-1-2013:p1199:b003:l027","ordinal":168667,"en":"And all the kalday governors."},{"id":"semetey-1-2013:p1199:b003:l028","ordinal":168668,"en":"Among Kongurbay's supporters"},{"id":"semetey-1-2013:p1199:b003:l029","ordinal":168669,"en":"Were skillful spearmen"},{"id":"semetey-1-2013:p1199:b003:l030","ordinal":168670,"en":"And excellent bowmen."},{"id":"semetey-1-2013:p1199:b003:l031","ordinal":168671,"en":"There were warriors no horse could bear;"},{"id":"semetey-1-2013:p1199:b003:l032","ordinal":168672,"en":"If they happened to dismount,"},{"id":"semetey-1-2013:p1199:b003:l033","ordinal":168673,"en":"They would reach a man before an arrow,"},{"id":"semetey-1-2013:p1199:b003:l034","ordinal":168674,"en":"And upon reaching the fucking wretch,"},{"id":"semetey-1-2013:p1199:b003:l035","ordinal":168675,"en":"Lift him and mount him on a horse."},{"id":"semetey-1-2013:p1199:b003:l036","ordinal":168676,"en":"There were footmen skilled in mounted games;"},{"id":"semetey-1-2013:p1199:b003:l037","ordinal":168677,"en":"There were giants unlike human beings."},{"id":"semetey-1-2013:p1199:b003:l038","ordinal":168678,"en":"Each had made ready to fight;"},{"id":"semetey-1-2013:p1199:b003:l039","ordinal":168679,"en":"Those fine fellows had come."},{"id":"semetey-1-2013:p1199:b003:l040","ordinal":168680,"en":"Were it not for Manas the leopard,"},{"id":"semetey-1-2013:p1199:b004:l001","ordinal":168681,"en":"The many kinds of Chinese"},{"id":"semetey-1-2013:p1199:b004:l002","ordinal":168682,"en":"Would all have engulfed them"},{"id":"semetey-1-2013:p1199:b004:l003","ordinal":168683,"en":"And brought them together to their end."},{"id":"semetey-1-2013:p1199:b004:l004","ordinal":168684,"en":"The reason they could engulf them was this:"},{"id":"semetey-1-2013:p1199:b004:l005","ordinal":168685,"en":"They came as a flood covering the land,"},{"id":"semetey-1-2013:p1199:b004:l006","ordinal":168686,"en":"As one with the face of the earth—"},{"id":"semetey-1-2013:p1199:b004:l007","ordinal":168687,"en":"The infidels had come."},{"id":"semetey-1-2013:p1199:b004:l008","ordinal":168688,"en":"If you looked at Kongurbay,"},{"id":"semetey-1-2013:p1199:b004:l009","ordinal":168689,"en":"He too was a blue-maned lion."},{"id":"semetey-1-2013:p1199:b004:l010","ordinal":168690,"en":"Jerking his golden reins,"},{"id":"semetey-1-2013:p1199:b004:l011","ordinal":168691,"en":"Making Algara rear and lunge,"},{"id":"semetey-1-2013:p1199:b004:l012","ordinal":168692,"en":"He turned the black horse's head."},{"id":"semetey-1-2013:p1199:b004:l013","ordinal":168693,"en":"The carefree Kalcha khan"},{"id":"semetey-1-2013:p1199:b004:l014","ordinal":168694,"en":"Stood facing the single combat."},{"id":"semetey-1-2013:p1199:b004:l015","ordinal":168695,"en":"Then Manas said this:"},{"id":"semetey-1-2013:p1199:b004:l016","ordinal":168696,"en":"“This one was the khan of the Chinese,"},{"id":"semetey-1-2013:p1199:b004:l017","ordinal":168697,"en":"And I was the khan of the Muslims."},{"id":"semetey-1-2013:p1199:b004:l018","ordinal":168698,"en":"If I do not grant him his turn,"},{"id":"semetey-1-2013:p1199:b004:l019","ordinal":168699,"en":"It will seem I am mocking him;"},{"id":"semetey-1-2013:p1199:b004:l020","ordinal":168700,"en":"If I do not give him the first course,"},{"id":"semetey-1-2013:p1199:b004:l021","ordinal":168701,"en":"It will seem I am mistreating him."},{"id":"semetey-1-2013:p1199:b004:l022","ordinal":168702,"en":"Take your turn, Chinese!” he said."},{"id":"semetey-1-2013:p1199:b004:l023","ordinal":168703,"en":"Khan Manas stood upon the bank."},{"id":"semetey-1-2013:p1199:b004:l024","ordinal":168704,"en":"Kongurbay charged and thrust;"}]
