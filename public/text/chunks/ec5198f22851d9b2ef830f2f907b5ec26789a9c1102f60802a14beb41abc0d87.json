[{"id":"semetey-1-2013:p1299:b003:l018","ordinal":175361,"en":"From the eyes of Choro,"},{"id":"semetey-1-2013:p1299:b003:l019","ordinal":175362,"en":"That gray-wolf prince, tears flooded ten plains."},{"id":"semetey-1-2013:p1299:b003:l020","ordinal":175363,"en":"The noble son of Almambet,"},{"id":"semetey-1-2013:p1299:b003:l021","ordinal":175364,"en":"The only child of his peri-born mother,"},{"id":"semetey-1-2013:p1299:b003:l022","ordinal":175365,"en":"Aruuke,"},{"id":"semetey-1-2013:p1299:b003:l023","ordinal":175366,"en":"Raised in tender affection,"},{"id":"semetey-1-2013:p1299:b003:l024","ordinal":175367,"en":"The amulet around her neck,"},{"id":"semetey-1-2013:p1299:b003:l025","ordinal":175368,"en":"The young champion Külchoro,"},{"id":"semetey-1-2013:p1299:b003:l026","ordinal":175369,"en":"Who had fought others for her breast."},{"id":"semetey-1-2013:p1299:b003:l027","ordinal":175370,"en":"Looking to both sides,"},{"id":"semetey-1-2013:p1299:b003:l028","ordinal":175371,"en":"Licking his lips and nose,"},{"id":"semetey-1-2013:p1299:b003:l029","ordinal":175372,"en":"When he reached his uncle,"},{"id":"semetey-1-2013:p1299:b003:l030","ordinal":175373,"en":"He shouted, “Babedin!”"},{"id":"semetey-1-2013:p1299:b003:l031","ordinal":175374,"en":"That spirited young son"},{"id":"semetey-1-2013:p1299:b003:l032","ordinal":175375,"en":"Called out, “Uncle!”"},{"id":"semetey-1-2013:p1299:b003:l033","ordinal":175376,"en":"The young man hurried over;"},{"id":"semetey-1-2013:p1299:b003:l034","ordinal":175377,"en":"Külchoro, lion-like,"},{"id":"semetey-1-2013:p1299:b003:l035","ordinal":175378,"en":"Pleaded with his uncle:"},{"id":"semetey-1-2013:p1299:b003:l036","ordinal":175379,"en":"“My uncle with silver eyes and sun-bright face,"},{"id":"semetey-1-2013:p1299:b003:l037","ordinal":175380,"en":"My thundering uncle!"},{"id":"semetey-1-2013:p1299:b003:l038","ordinal":175381,"en":"My uncle with golden eyes and moon-bright face,"},{"id":"semetey-1-2013:p1299:b003:l039","ordinal":175382,"en":"My beloved uncle!"},{"id":"semetey-1-2013:p1299:b005:l001","ordinal":175383,"en":"Is there a pit dug before you?"},{"id":"semetey-1-2013:p1299:b005:l002","ordinal":175384,"en":"Let me be sacrificed for you,"},{"id":"semetey-1-2013:p1299:b005:l003","ordinal":175385,"en":"My beloved uncle;"},{"id":"semetey-1-2013:p1299:b005:l004","ordinal":175386,"en":"Is there an army surging toward you?"},{"id":"semetey-1-2013:p1299:b005:l005","ordinal":175387,"en":"Is there a fire burning without turning back?"},{"id":"semetey-1-2013:p1299:b005:l006","ordinal":175388,"en":"My dear uncle,"},{"id":"semetey-1-2013:p1299:b005:l007","ordinal":175389,"en":"Is there a host lying unbroken?"},{"id":"semetey-1-2013:p1299:b005:l008","ordinal":175390,"en":"Is there a bullet that strikes without turning?"},{"id":"semetey-1-2013:p1299:b005:l009","ordinal":175391,"en":"Is there a cliff that grants no pass?"},{"id":"semetey-1-2013:p1299:b005:l010","ordinal":175392,"en":"Has some enemy pressed you hard"},{"id":"semetey-1-2013:p1299:b005:l011","ordinal":175393,"en":"And robbed you of all recourse?"},{"id":"semetey-1-2013:p1299:b005:l012","ordinal":175394,"en":"If there is an enemy, I shall destroy it;"},{"id":"semetey-1-2013:p1299:b005:l013","ordinal":175395,"en":"Whoever I meet, I shall slaughter."},{"id":"semetey-1-2013:p1299:b005:l014","ordinal":175396,"en":"My tiger uncle, tell me the truth!”"},{"id":"semetey-1-2013:p1299:b005:l015","ordinal":175397,"en":"When his Choro spoke this way,"},{"id":"semetey-1-2013:p1299:b005:l016","ordinal":175398,"en":"His prince stood and said:"},{"id":"semetey-1-2013:p1299:b005:l017","ordinal":175399,"en":"“My banner fastened to the spear,"},{"id":"semetey-1-2013:p1299:b005:l018","ordinal":175400,"en":"My beloved Külchoro,"},{"id":"semetey-1-2013:p1299:b005:l019","ordinal":175401,"en":"A gift I inherited"},{"id":"semetey-1-2013:p1299:b005:l020","ordinal":175402,"en":"From my lion sworn father."},{"id":"semetey-1-2013:p1299:b005:l021","ordinal":175403,"en":"My prop when I climb upward,"},{"id":"semetey-1-2013:p1299:b005:l022","ordinal":175404,"en":"My support when I descend,"},{"id":"semetey-1-2013:p1299:b005:l023","ordinal":175405,"en":"My good road when sent before me,"},{"id":"semetey-1-2013:p1299:b005:l024","ordinal":175406,"en":"My countless host when you follow behind,"},{"id":"semetey-1-2013:p1299:b005:l025","ordinal":175407,"en":"My ravine where the hawthorn grows,"},{"id":"semetey-1-2013:p1299:b005:l026","ordinal":175408,"en":"My tempered steel."},{"id":"semetey-1-2013:p1299:b005:l027","ordinal":175409,"en":"My ravine where the sorrel grows,"},{"id":"semetey-1-2013:p1299:b005:l028","ordinal":175410,"en":"My fitted blade of steel!"},{"id":"semetey-1-2013:p1299:b005:l029","ordinal":175411,"en":"Your uncle has words to say"},{"id":"semetey-1-2013:p1299:b005:l030","ordinal":175412,"en":"And the skill to offer counsel."},{"id":"semetey-1-2013:p1299:b005:l031","ordinal":175413,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1299:b005:l032","ordinal":175414,"en":"Khojo, resolute in his deeds—"},{"id":"semetey-1-2013:p1299:b005:l033","ordinal":175415,"en":"We shared one camp from the beginning,"},{"id":"semetey-1-2013:p1299:b005:l034","ordinal":175416,"en":"And grew up together from youth."},{"id":"semetey-1-2013:p1299:b005:l035","ordinal":175417,"en":"An enemy who takes up the cudgel is bad;"},{"id":"semetey-1-2013:p1299:b005:l036","ordinal":175418,"en":"An enemy who shared your camp is bad;"},{"id":"semetey-1-2013:p1299:b005:l037","ordinal":175419,"en":"Worst is the dog Khojo who knows your secrets."},{"id":"semetey-1-2013:p1299:b005:l038","ordinal":175420,"en":"He escaped after coming out to shoot;"},{"id":"semetey-1-2013:p1299:b005:l039","ordinal":175421,"en":"Khojo, a proven enemy, is the worst."},{"id":"semetey-1-2013:p1300:b003:l001","ordinal":175422,"en":"Trouble arose from a place without trouble;"},{"id":"semetey-1-2013:p1300:b003:l002","ordinal":175423,"en":"Alas, Khojo emerged as an enemy."},{"id":"semetey-1-2013:p1300:b003:l003","ordinal":175424,"en":"He began the havoc"},{"id":"semetey-1-2013:p1300:b003:l004","ordinal":175425,"en":"And slaughtered your uncle,"},{"id":"semetey-1-2013:p1300:b003:l005","ordinal":175426,"en":"Mountainous as Opol-Too."},{"id":"semetey-1-2013:p1300:b003:l006","ordinal":175427,"en":"My dear Külchoro,"},{"id":"semetey-1-2013:p1300:b003:l007","ordinal":175428,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1300:b003:l008","ordinal":175429,"en":"Has set my sorrow boiling,"},{"id":"semetey-1-2013:p1300:b003:l009","ordinal":175430,"en":"And truly brought upon my head"},{"id":"semetey-1-2013:p1300:b003:l010","ordinal":175431,"en":"This marvel that will be my death."},{"id":"semetey-1-2013:p1300:b003:l011","ordinal":175432,"en":"The moon is dark; night has come;"},{"id":"semetey-1-2013:p1300:b003:l012","ordinal":175433,"en":"My wise Choro, hear this:"},{"id":"semetey-1-2013:p1300:b003:l013","ordinal":175434,"en":"The day of death has come."},{"id":"semetey-1-2013:p1300:b003:l014","ordinal":175435,"en":"Dear Khojo has grown mighty,"},{"id":"semetey-1-2013:p1300:b003:l015","ordinal":175436,"en":"Overpowering honored men."},{"id":"semetey-1-2013:p1300:b003:l016","ordinal":175437,"en":"Of Buurul beneath me,"},{"id":"semetey-1-2013:p1300:b003:l017","ordinal":175438,"en":"Only a spoonful of blood remains,"},{"id":"semetey-1-2013:p1300:b003:l018","ordinal":175439,"en":"His flesh a blue, battered pulp."},{"id":"semetey-1-2013:p1300:b003:l019","ordinal":175440,"en":"My powder has spilled from its flask;"},{"id":"semetey-1-2013:p1300:b003:l020","ordinal":175441,"en":"I have despaired of this grieving life."},{"id":"semetey-1-2013:p1300:b003:l021","ordinal":175442,"en":"No host remains for close combat,"},{"id":"semetey-1-2013:p1300:b003:l022","ordinal":175443,"en":"No bullet remains for shooting—"},{"id":"semetey-1-2013:p1300:b003:l023","ordinal":175444,"en":"Can God strike us so?"},{"id":"semetey-1-2013:p1300:b003:l024","ordinal":175445,"en":"Let us dress him in Akolpok,"},{"id":"semetey-1-2013:p1300:b003:l025","ordinal":175446,"en":"Mount him upon Aktelki,"},{"id":"semetey-1-2013:p1300:b003:l026","ordinal":175447,"en":"And offer Aichürök as tribute;"},{"id":"semetey-1-2013:p1300:b003:l027","ordinal":175448,"en":"Safe and sound to Talas,"},{"id":"semetey-1-2013:p1300:b003:l028","ordinal":175449,"en":"Let us turn back now!"},{"id":"semetey-1-2013:p1300:b003:l029","ordinal":175450,"en":"Let us speak words of conciliation,"},{"id":"semetey-1-2013:p1300:b003:l030","ordinal":175451,"en":"Saying, “Here, take Chürök,”"},{"id":"semetey-1-2013:p1300:b003:l031","ordinal":175452,"en":"And before Toltoi"},{"id":"semetey-1-2013:p1300:b003:l032","ordinal":175453,"en":"Let us offer Aichürök,"},{"id":"semetey-1-2013:p1300:b003:l033","ordinal":175454,"en":"Then return safely to our camp!"},{"id":"semetey-1-2013:p1300:b003:l034","ordinal":175455,"en":"Perhaps we should agree to his demand,"},{"id":"semetey-1-2013:p1300:b003:l035","ordinal":175456,"en":"Saying, “We were kin—pardon us,”"},{"id":"semetey-1-2013:p1300:b003:l036","ordinal":175457,"en":"And offer Arbuurul and Akkelte"},{"id":"semetey-1-2013:p1300:b003:l037","ordinal":175458,"en":"As tribute to Khojo."},{"id":"semetey-1-2013:p1300:b003:l038","ordinal":175459,"en":"Perhaps we should give tribute and withdraw,"},{"id":"semetey-1-2013:p1300:b003:l039","ordinal":175460,"en":"Without crushing battle with the dog,"},{"id":"semetey-1-2013:p1300:b004:l001","ordinal":175461,"en":"And return safely to Talas.”"},{"id":"semetey-1-2013:p1300:b004:l002","ordinal":175462,"en":"When the prince spoke thus,"},{"id":"semetey-1-2013:p1300:b004:l003","ordinal":175463,"en":"As though stabbed in the eye,"},{"id":"semetey-1-2013:p1300:b004:l004","ordinal":175464,"en":"Külchoro sprang up:"},{"id":"semetey-1-2013:p1300:b004:l005","ordinal":175465,"en":"“Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1300:b004:l006","ordinal":175466,"en":"Khojo, whose path is strife!"},{"id":"semetey-1-2013:p1300:b004:l007","ordinal":175467,"en":"Worse than a fire burning the meadow"},{"id":"semetey-1-2013:p1300:b004:l008","ordinal":175468,"en":"Is an enemy sprung from one’s own;"},{"id":"semetey-1-2013:p1300:b004:l009","ordinal":175469,"en":"Worse is an illness sprung from the core,"},{"id":"semetey-1-2013:p1300:b004:l010","ordinal":175470,"en":"Worse is Khojo, the enemy who fights to the death."},{"id":"semetey-1-2013:p1300:b004:l011","ordinal":175471,"en":"My dear uncle,"},{"id":"semetey-1-2013:p1300:b004:l012","ordinal":175472,"en":"Who would listen to these words of yours?"},{"id":"semetey-1-2013:p1300:b004:l013","ordinal":175473,"en":"Let some black night listen;"},{"id":"semetey-1-2013:p1300:b004:l014","ordinal":175474,"en":"Let the dug black grave listen."},{"id":"semetey-1-2013:p1300:b004:l015","ordinal":175475,"en":"Who else would listen to them!"},{"id":"semetey-1-2013:p1300:b004:l016","ordinal":175476,"en":"Let the uncrossable black water listen;"},{"id":"semetey-1-2013:p1300:b004:l017","ordinal":175477,"en":"Who else would listen!"},{"id":"semetey-1-2013:p1300:b004:l018","ordinal":175478,"en":"Do not dig my deep grave,"},{"id":"semetey-1-2013:p1300:b004:l019","ordinal":175479,"en":"My dear uncle;"},{"id":"semetey-1-2013:p1300:b004:l020","ordinal":175480,"en":"Do not set my sorrow boiling!"},{"id":"semetey-1-2013:p1300:b004:l021","ordinal":175481,"en":"How could I bow my head"},{"id":"semetey-1-2013:p1300:b004:l022","ordinal":175482,"en":"And hand my sister-in-law to Khojo,"},{"id":"semetey-1-2013:p1300:b004:l023","ordinal":175483,"en":"With whom we have shed blood?"},{"id":"semetey-1-2013:p1300:b004:l024","ordinal":175484,"en":"How could I turn my neck,"},{"id":"semetey-1-2013:p1300:b004:l025","ordinal":175485,"en":"And offer a heroic soul,"},{"id":"semetey-1-2013:p1300:b004:l026","ordinal":175486,"en":"Saying, ‘Let him be’?"},{"id":"semetey-1-2013:p1300:b004:l027","ordinal":175487,"en":"Rather than see such suffering,"},{"id":"semetey-1-2013:p1300:b004:l028","ordinal":175488,"en":"I shall die fighting."},{"id":"semetey-1-2013:p1300:b004:l029","ordinal":175489,"en":"Akkelte was treasure left by my father—"},{"id":"semetey-1-2013:p1300:b004:l030","ordinal":175490,"en":"How could I give it away?"},{"id":"semetey-1-2013:p1300:b004:l031","ordinal":175491,"en":"The hell that has come upon my head"},{"id":"semetey-1-2013:p1300:b004:l032","ordinal":175492,"en":"I shall face with my own eyelashes!"},{"id":"semetey-1-2013:p1300:b004:l033","ordinal":175493,"en":"While my strong head remains,"},{"id":"semetey-1-2013:p1300:b004:l034","ordinal":175494,"en":"How could I give my swift horse"},{"id":"semetey-1-2013:p1300:b004:l035","ordinal":175495,"en":"To the blustering Khojo?"},{"id":"semetey-1-2013:p1300:b004:l036","ordinal":175496,"en":"Let what I have gathered remain in my hand,"},{"id":"semetey-1-2013:p1300:b004:l037","ordinal":175497,"en":"Let my faith be my companion;"},{"id":"semetey-1-2013:p1300:b004:l038","ordinal":175498,"en":"I shall not withdraw where death has not come."},{"id":"semetey-1-2013:p1300:b004:l039","ordinal":175499,"en":"Until the soft reeds ripen,"},{"id":"semetey-1-2013:p1301:b003:l001","ordinal":175500,"en":"Until the flower of divine law flies,"},{"id":"semetey-1-2013:p1301:b003:l002","ordinal":175501,"en":"I shall fight firmly for six months."},{"id":"semetey-1-2013:p1301:b003:l003","ordinal":175502,"en":"While my able head remains,"},{"id":"semetey-1-2013:p1301:b003:l004","ordinal":175503,"en":"How could I give up my sister-in-law?"},{"id":"semetey-1-2013:p1301:b003:l005","ordinal":175504,"en":"With that earth-scorching dog,"},{"id":"semetey-1-2013:p1301:b003:l006","ordinal":175505,"en":"Let me grapple neck to neck."},{"id":"semetey-1-2013:p1301:b003:l007","ordinal":175506,"en":"Able uncle, what are you saying?"},{"id":"semetey-1-2013:p1301:b003:l008","ordinal":175507,"en":"Let a dog listen to these words!"},{"id":"semetey-1-2013:p1301:b003:l009","ordinal":175508,"en":"My valiant mother Kanykei"},{"id":"semetey-1-2013:p1301:b003:l010","ordinal":175509,"en":"Entrusted something carefully;"},{"id":"semetey-1-2013:p1301:b003:l011","ordinal":175510,"en":"These were my mother’s words:"},{"id":"semetey-1-2013:p1301:b003:l012","ordinal":175511,"en":"‘A single bullet left by Manas"},{"id":"semetey-1-2013:p1301:b003:l013","ordinal":175512,"en":"I sewed into the collar"},{"id":"semetey-1-2013:p1301:b003:l014","ordinal":175513,"en":"Of Akolpok,’ she said."},{"id":"semetey-1-2013:p1301:b003:l015","ordinal":175514,"en":"Binding it back and fastening it,"},{"id":"semetey-1-2013:p1301:b003:l016","ordinal":175515,"en":"When we returned this way,"},{"id":"semetey-1-2013:p1301:b003:l017","ordinal":175516,"en":"My dear mother Kanykei"},{"id":"semetey-1-2013:p1301:b003:l018","ordinal":175517,"en":"Entrusted it to Akolpok."},{"id":"semetey-1-2013:p1301:b003:l019","ordinal":175518,"en":"As we came this way,"},{"id":"semetey-1-2013:p1301:b003:l020","ordinal":175519,"en":"She grasped my hand and held me,"},{"id":"semetey-1-2013:p1301:b003:l021","ordinal":175520,"en":"My beloved mother,"},{"id":"semetey-1-2013:p1301:b003:l022","ordinal":175521,"en":"And, saying, ‘If grave trouble befalls you,"},{"id":"semetey-1-2013:p1301:b003:l023","ordinal":175522,"en":"Remember your father,’ entrusted it,"},{"id":"semetey-1-2013:p1301:b003:l024","ordinal":175523,"en":"Binding and securing it again;"},{"id":"semetey-1-2013:p1301:b003:l025","ordinal":175524,"en":"My beloved Kanykei"},{"id":"semetey-1-2013:p1301:b003:l026","ordinal":175525,"en":"Entrusted it to orphaned me."},{"id":"semetey-1-2013:p1301:b003:l027","ordinal":175526,"en":"When we lived in Talas,"},{"id":"semetey-1-2013:p1301:b003:l028","ordinal":175527,"en":"We herded horses at Kanjailak,"},{"id":"semetey-1-2013:p1301:b003:l029","ordinal":175528,"en":"And shot the soaring vulture"},{"id":"semetey-1-2013:p1301:b003:l030","ordinal":175529,"en":"Before it could reach us."},{"id":"semetey-1-2013:p1301:b003:l031","ordinal":175530,"en":"Once I came blazing"},{"id":"semetey-1-2013:p1301:b003:l032","ordinal":175531,"en":"Into this world;"},{"id":"semetey-1-2013:p1301:b003:l033","ordinal":175532,"en":"With the gun left by my father,"},{"id":"semetey-1-2013:p1301:b003:l034","ordinal":175533,"en":"I had the skill of a marksman.”"},{"id":"semetey-1-2013:p1301:b003:l035","ordinal":175534,"en":"From the hard-pressed sultan,"},{"id":"semetey-1-2013:p1301:b003:l036","ordinal":175535,"en":"Young prince Külchoro"},{"id":"semetey-1-2013:p1301:b003:l037","ordinal":175536,"en":"Asked for Akkelte,"},{"id":"semetey-1-2013:p1301:b003:l038","ordinal":175537,"en":"Striking him with words like these."},{"id":"semetey-1-2013:p1301:b003:l039","ordinal":175538,"en":"Your valiant prince and sultan,"},{"id":"semetey-1-2013:p1301:b004:l001","ordinal":175539,"en":"Unable to say, “I will not give it,”"},{"id":"semetey-1-2013:p1301:b004:l002","ordinal":175540,"en":"And not wishing to thwart the hero,"},{"id":"semetey-1-2013:p1301:b004:l003","ordinal":175541,"en":"Dismounted and gave him Buurul,"},{"id":"semetey-1-2013:p1301:b004:l004","ordinal":175542,"en":"Unfastened and gave him the treasured gear."},{"id":"semetey-1-2013:p1301:b004:l005","ordinal":175543,"en":"Semetey gave them to the hero."},{"id":"semetey-1-2013:p1301:b004:l006","ordinal":175544,"en":"Look at the form of that desperate man:"},{"id":"semetey-1-2013:p1301:b004:l007","ordinal":175545,"en":"In his Kokon mottled coat,"},{"id":"semetey-1-2013:p1301:b004:l008","ordinal":175546,"en":"He ran crouching along the road,"},{"id":"semetey-1-2013:p1301:b004:l009","ordinal":175547,"en":"His knees bending to the ground;"},{"id":"semetey-1-2013:p1301:b004:l010","ordinal":175548,"en":"The prince did not stop but ran,"},{"id":"semetey-1-2013:p1301:b004:l011","ordinal":175549,"en":"Flaring in fury,"},{"id":"semetey-1-2013:p1301:b004:l012","ordinal":175550,"en":"The prince fleeing in great strides,"},{"id":"semetey-1-2013:p1301:b004:l013","ordinal":175551,"en":"Surpassing his former valor,"},{"id":"semetey-1-2013:p1301:b004:l014","ordinal":175552,"en":"Running straight ahead,"},{"id":"semetey-1-2013:p1301:b004:l015","ordinal":175553,"en":"And hiding in a black cave."},{"id":"semetey-1-2013:p1301:b004:l016","ordinal":175554,"en":"When he reached the black cave,"},{"id":"semetey-1-2013:p1301:b004:l017","ordinal":175555,"en":"The dear hero born to surpass"},{"id":"semetey-1-2013:p1301:b004:l018","ordinal":175556,"en":"His father, gray-wolf Manas,"},{"id":"semetey-1-2013:p1301:b004:l019","ordinal":175557,"en":"Hid his whole body,"},{"id":"semetey-1-2013:p1301:b004:l020","ordinal":175558,"en":"Sticking out his head as large as a hearth,"},{"id":"semetey-1-2013:p1301:b004:l021","ordinal":175559,"en":"Hiding his dark body,"},{"id":"semetey-1-2013:p1301:b004:l022","ordinal":175560,"en":"Sticking out his head like a crow."},{"id":"semetey-1-2013:p1301:b004:l023","ordinal":175561,"en":"As hail poured down,"},{"id":"semetey-1-2013:p1301:b004:l024","ordinal":175562,"en":"Streaming from Chynkojo,"},{"id":"semetey-1-2013:p1301:b004:l025","ordinal":175563,"en":"Despairing of his fly-like life,"},{"id":"semetey-1-2013:p1301:b004:l026","ordinal":175564,"en":"True Manas’s only son"},{"id":"semetey-1-2013:p1301:b004:l027","ordinal":175565,"en":"Took shelter in the black cave."},{"id":"semetey-1-2013:p1301:b004:l028","ordinal":175566,"en":"Hero Semey, son of Manas,"},{"id":"semetey-1-2013:p1301:b004:l029","ordinal":175567,"en":"Was hidden from sight,"},{"id":"semetey-1-2013:p1301:b004:l030","ordinal":175568,"en":"Concealed in the black cave,"},{"id":"semetey-1-2013:p1301:b004:l031","ordinal":175569,"en":"His whereabouts unknown."},{"id":"semetey-1-2013:p1301:b004:l032","ordinal":175570,"en":"Having gone to hide in the cave—"},{"id":"semetey-1-2013:p1301:b004:l033","ordinal":175571,"en":"Such was Semetey’s ordeal;"},{"id":"semetey-1-2013:p1301:b004:l034","ordinal":175572,"en":"His poor life had come under strain,"},{"id":"semetey-1-2013:p1301:b004:l035","ordinal":175573,"en":"Else would a hero act this way?"},{"id":"semetey-1-2013:p1301:b004:l036","ordinal":175574,"en":"Now let us tell"},{"id":"semetey-1-2013:p1301:b004:l037","ordinal":175575,"en":"The tale of Külchoro:"},{"id":"semetey-1-2013:p1301:b004:l038","ordinal":175576,"en":"A servant perfectly skilled in judgment,"},{"id":"semetey-1-2013:p1301:b004:l039","ordinal":175577,"en":"Strange and singular from childhood,"},{"id":"semetey-1-2013:p1302:b003:l001","ordinal":175578,"en":"A mighty servant who knew the enemy’s stratagems."},{"id":"semetey-1-2013:p1302:b003:l002","ordinal":175579,"en":"Akkelte, entrusted and left"},{"id":"semetey-1-2013:p1302:b003:l003","ordinal":175580,"en":"By his father, noble Manas,"},{"id":"semetey-1-2013:p1302:b003:l004","ordinal":175581,"en":"With a seven-jointed brass ramrod—"},{"id":"semetey-1-2013:p1302:b003:l005","ordinal":175582,"en":"Your hero drew it out."},{"id":"semetey-1-2013:p1302:b003:l006","ordinal":175583,"en":"Saying, “Its bore has become dirty,”"},{"id":"semetey-1-2013:p1302:b003:l007","ordinal":175584,"en":"He scraped it with a file,"},{"id":"semetey-1-2013:p1302:b003:l008","ordinal":175585,"en":"Pounded it with a striker,"},{"id":"semetey-1-2013:p1302:b003:l009","ordinal":175586,"en":"Pulled it with a draw-tool;"},{"id":"semetey-1-2013:p1302:b003:l010","ordinal":175587,"en":"Without tiring, Külchoro"},{"id":"semetey-1-2013:p1302:b003:l011","ordinal":175588,"en":"Cleaned and wiped its inside."},{"id":"semetey-1-2013:p1302:b003:l012","ordinal":175589,"en":"Once the bore was clean,"},{"id":"semetey-1-2013:p1302:b003:l013","ordinal":175590,"en":"Külchoro took"},{"id":"semetey-1-2013:p1302:b003:l014","ordinal":175591,"en":"A large cloth from the gray kise"},{"id":"semetey-1-2013:p1302:b003:l015","ordinal":175592,"en":"And pulled it through again and again."},{"id":"semetey-1-2013:p1302:b003:l016","ordinal":175593,"en":"The half-bullet sewn into the collar,"},{"id":"semetey-1-2013:p1302:b003:l017","ordinal":175594,"en":"And the half-charge of powder,"},{"id":"semetey-1-2013:p1302:b003:l018","ordinal":175595,"en":"Into Akkelte’s muzzle"},{"id":"semetey-1-2013:p1302:b003:l019","ordinal":175596,"en":"He now poured by the palmful."},{"id":"semetey-1-2013:p1302:b003:l020","ordinal":175597,"en":"The half-bullet in his hand—"},{"id":"semetey-1-2013:p1302:b003:l021","ordinal":175598,"en":"Taking the bronze ramrod,"},{"id":"semetey-1-2013:p1302:b003:l022","ordinal":175599,"en":"He drove it down with a ringing blow."},{"id":"semetey-1-2013:p1302:b003:l023","ordinal":175600,"en":"Gripping the gun at the waist,"},{"id":"semetey-1-2013:p1302:b003:l024","ordinal":175601,"en":"Displaying his valor,"},{"id":"semetey-1-2013:p1302:b003:l025","ordinal":175602,"en":"He swore a firm oath then,"},{"id":"semetey-1-2013:p1302:b003:l026","ordinal":175603,"en":"Touching his mouth to its muzzle:"},{"id":"semetey-1-2013:p1302:b003:l027","ordinal":175604,"en":"“My bloodthirsty father was a lion-warrior;"},{"id":"semetey-1-2013:p1302:b003:l028","ordinal":175605,"en":"Akkelte remained from him."},{"id":"semetey-1-2013:p1302:b003:l029","ordinal":175606,"en":"If I fail to shoot"},{"id":"semetey-1-2013:p1302:b003:l030","ordinal":175607,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1302:b003:l031","ordinal":175608,"en":"May my father’s spirit"},{"id":"semetey-1-2013:p1302:b003:l032","ordinal":175609,"en":"Strike me down in the end;"},{"id":"semetey-1-2013:p1302:b003:l033","ordinal":175610,"en":"If you fail to hit where I point you,"},{"id":"semetey-1-2013:p1302:b003:l034","ordinal":175611,"en":"May my sultan father’s spirit"},{"id":"semetey-1-2013:p1302:b003:l035","ordinal":175612,"en":"Find and strike you in the end!”"},{"id":"semetey-1-2013:p1302:b003:l036","ordinal":175613,"en":"Having sworn his oath with Akkelte,"},{"id":"semetey-1-2013:p1302:b003:l037","ordinal":175614,"en":"Külchoro hurried away."},{"id":"semetey-1-2013:p1302:b003:l038","ordinal":175615,"en":"Saying, “The stallion left by my father,”"},{"id":"semetey-1-2013:p1302:b003:l039","ordinal":175616,"en":"He pleaded with Taibuurul:"}]
