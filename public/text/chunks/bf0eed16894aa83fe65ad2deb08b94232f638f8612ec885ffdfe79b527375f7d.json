[{"id":"manas-2010:p1392:b001:l017","ordinal":60161,"en":"His wide eyes like the morning star,"},{"id":"manas-2010:p1392:b001:l018","ordinal":60162,"en":"His moonlike ears like shields—"},{"id":"manas-2010:p1392:b001:l019","ordinal":60163,"en":"If words were difficult beyond measure,"},{"id":"manas-2010:p1392:b001:l020","ordinal":60164,"en":"The warrior Koshoi untied their knot;"},{"id":"manas-2010:p1392:b001:l021","ordinal":60165,"en":"If a lion rose against him,"},{"id":"manas-2010:p1392:b001:l022","ordinal":60166,"en":"The warrior Koshoi humbled him."},{"id":"manas-2010:p1392:b001:l023","ordinal":60167,"en":"Calling like a gray-mottled bird,"},{"id":"manas-2010:p1392:b001:l024","ordinal":60168,"en":"To the people of the twelve khans,"},{"id":"manas-2010:p1392:b001:l025","ordinal":60169,"en":"To them all he spoke thus:"},{"id":"manas-2010:p1392:b001:l026","ordinal":60170,"en":"“Iron armor that no shot can pierce—"},{"id":"manas-2010:p1392:b001:l027","ordinal":60171,"en":"You who wear it, go to Beijing!"},{"id":"manas-2010:p1392:b001:l028","ordinal":60172,"en":"Who can untie the knot of words—"},{"id":"manas-2010:p1392:b001:l029","ordinal":60173,"en":"You who know how, go to Beijing!"},{"id":"manas-2010:p1392:b001:l030","ordinal":60174,"en":"When evil days fall upon your head,"},{"id":"manas-2010:p1392:b001:l031","ordinal":60175,"en":"Who will neither grieve nor sorrow—"},{"id":"manas-2010:p1392:b001:l032","ordinal":60176,"en":"You champions, go to Beijing!"},{"id":"manas-2010:p1392:b001:l033","ordinal":60177,"en":"Who have sharpened your dark tongue,"},{"id":"manas-2010:p1392:b001:l034","ordinal":60178,"en":"Who speak out without faltering—"},{"id":"manas-2010:p1392:b001:l035","ordinal":60179,"en":"You warriors, go to Beijing!"},{"id":"manas-2010:p1392:b001:l036","ordinal":60180,"en":"Broad jaw and wide tongue,"},{"id":"manas-2010:p1392:b001:l037","ordinal":60181,"en":"Who speak without a slip—"},{"id":"manas-2010:p1392:b001:l038","ordinal":60182,"en":"You orators, go to Beijing!"},{"id":"manas-2010:p1392:b001:l039","ordinal":60183,"en":"Whichever of you will go, then go;"},{"id":"manas-2010:p1392:b001:l040","ordinal":60184,"en":"Go and speak without holding back!"},{"id":"manas-2010:p1392:b001:l041","ordinal":60185,"en":"If he gives Burulcha as a gift,"},{"id":"manas-2010:p1392:b001:l042","ordinal":60186,"en":"Bring the hapless girl back."},{"id":"manas-2010:p1393:b001:l001","ordinal":60187,"en":"If he will not give his daughter as a gift,"},{"id":"manas-2010:p1393:b001:l002","ordinal":60188,"en":"‘There is no death for an envoy,’ they say:"},{"id":"manas-2010:p1393:b001:l003","ordinal":60189,"en":"Return without much delay."},{"id":"manas-2010:p1393:b001:l004","ordinal":60190,"en":"The evil you have seen in Beijing—"},{"id":"manas-2010:p1393:b001:l005","ordinal":60191,"en":"Return and tell what you have seen!”"},{"id":"manas-2010:p1393:b001:l006","ordinal":60192,"en":"Thus spoke Khan Koshoi;"},{"id":"manas-2010:p1393:b001:l007","ordinal":60193,"en":"While he was speaking,"},{"id":"manas-2010:p1393:b001:l008","ordinal":60194,"en":"The great army of the twelve khans"},{"id":"manas-2010:p1393:b001:l009","ordinal":60195,"en":"Sought each other out and met,"},{"id":"manas-2010:p1393:b001:l010","ordinal":60196,"en":"Bringing the matter before them."},{"id":"manas-2010:p1393:b001:l011","ordinal":60197,"en":"They were a people of twelve tribes;"},{"id":"manas-2010:p1393:b001:l012","ordinal":60198,"en":"They went through them clan by clan."},{"id":"manas-2010:p1393:b001:l013","ordinal":60199,"en":"With no one coming forth as envoy,"},{"id":"manas-2010:p1393:b001:l014","ordinal":60200,"en":"Yellowing as if with jaundice,"},{"id":"manas-2010:p1393:b001:l015","ordinal":60201,"en":"They were struck down by God."},{"id":"manas-2010:p1393:b001:l016","ordinal":60202,"en":"As though they were about to die,"},{"id":"manas-2010:p1393:b001:l017","ordinal":60203,"en":"They hid behind one another."},{"id":"manas-2010:p1393:b001:l018","ordinal":60204,"en":"The reason for their hiding was this:"},{"id":"manas-2010:p1393:b001:l019","ordinal":60205,"en":"In the Chinese emperor’s Beijing"},{"id":"manas-2010:p1393:b001:l020","ordinal":60206,"en":"There were pits dug ready,"},{"id":"manas-2010:p1393:b001:l021","ordinal":60207,"en":"There was brine kept boiling."},{"id":"manas-2010:p1393:b001:l022","ordinal":60208,"en":"There were fortified mountain passes,"},{"id":"manas-2010:p1393:b001:l023","ordinal":60209,"en":"There were places they relied upon."},{"id":"manas-2010:p1393:b001:l024","ordinal":60210,"en":"Those who went there never turned back;"},{"id":"manas-2010:p1393:b001:l025","ordinal":60211,"en":"No living person returned—"},{"id":"manas-2010:p1393:b001:l026","ordinal":60212,"en":"Such were the places there."},{"id":"manas-2010:p1393:b001:l027","ordinal":60213,"en":"Of sending an envoy to Beijing,"},{"id":"manas-2010:p1393:b001:l028","ordinal":60214,"en":"The twelve khans had spoken."},{"id":"manas-2010:p1393:b001:l029","ordinal":60215,"en":"To give an answer to the people,"},{"id":"manas-2010:p1393:b001:l030","ordinal":60216,"en":"Jamgyrchy of the Eshtek—"},{"id":"manas-2010:p1393:b001:l031","ordinal":60217,"en":"Such was the lord they had."},{"id":"manas-2010:p1393:b001:l032","ordinal":60218,"en":"Jamgyrchy rose and spoke:"},{"id":"manas-2010:p1393:b001:l033","ordinal":60219,"en":"“Who joins what has been torn,"},{"id":"manas-2010:p1393:b001:l034","ordinal":60220,"en":"Who gathers what has been scattered—"},{"id":"manas-2010:p1393:b001:l035","ordinal":60221,"en":"Let great Bakai go!"},{"id":"manas-2010:p1393:b001:l036","ordinal":60222,"en":"Who wields the mottled gray shield—"},{"id":"manas-2010:p1393:b001:l037","ordinal":60223,"en":"Let wolf-man Bakai go!"},{"id":"manas-2010:p1393:b001:l038","ordinal":60224,"en":"To these Chinese before us,"},{"id":"manas-2010:p1393:b001:l039","ordinal":60225,"en":"On a dark and moonless night he will go."},{"id":"manas-2010:p1393:b001:l040","ordinal":60226,"en":"If it is not the lion Bakai,"},{"id":"manas-2010:p1393:b001:l041","ordinal":60227,"en":"Who else will go?”"},{"id":"manas-2010:p1393:b001:l042","ordinal":60228,"en":"Thus spoke Jamgyrchy."},{"id":"manas-2010:p1394:b001:l001","ordinal":60229,"en":"While he was saying this,"},{"id":"manas-2010:p1394:b001:l002","ordinal":60230,"en":"As if pierced by a spear,"},{"id":"manas-2010:p1394:b001:l003","ordinal":60231,"en":"Leaping up from his place"},{"id":"manas-2010:p1394:b001:l004","ordinal":60232,"en":"And taking his sword in hand,"},{"id":"manas-2010:p1394:b001:l005","ordinal":60233,"en":"Khan Manas stood shouting:"},{"id":"manas-2010:p1394:b001:l006","ordinal":60234,"en":"“When Bakai goes as envoy,"},{"id":"manas-2010:p1394:b001:l007","ordinal":60235,"en":"Will not the many Chinese gather"},{"id":"manas-2010:p1394:b001:l008","ordinal":60236,"en":"And put him in their cage?"},{"id":"manas-2010:p1394:b001:l009","ordinal":60237,"en":"Will they not take Bakai"},{"id":"manas-2010:p1394:b001:l010","ordinal":60238,"en":"In exchange for Ezkara?"},{"id":"manas-2010:p1394:b001:l011","ordinal":60239,"en":"Will my people not then fall into misery?"},{"id":"manas-2010:p1394:b001:l012","ordinal":60240,"en":"When Bakai is held captive,"},{"id":"manas-2010:p1394:b001:l013","ordinal":60241,"en":"Think of it, you great people:"},{"id":"manas-2010:p1394:b001:l014","ordinal":60242,"en":"Will the mist ever leave your heads?"},{"id":"manas-2010:p1394:b001:l015","ordinal":60243,"en":"If gold and golden coins"},{"id":"manas-2010:p1394:b001:l016","ordinal":60244,"en":"We gather and give to the Chinese,"},{"id":"manas-2010:p1394:b001:l017","ordinal":60245,"en":"Will the whole world suffice to ransom Bakai?"},{"id":"manas-2010:p1394:b001:l018","ordinal":60246,"en":"When Bakai falls into their hands,"},{"id":"manas-2010:p1394:b001:l019","ordinal":60247,"en":"Will they not put their feet up on the wall,"},{"id":"manas-2010:p1394:b001:l020","ordinal":60248,"en":"Will they not play the Chinese tune of swagger,"},{"id":"manas-2010:p1394:b001:l021","ordinal":60249,"en":"Will they not say, ‘Come if you dare, Burut’?"},{"id":"manas-2010:p1394:b001:l022","ordinal":60250,"en":"Will they not speak like this?”"},{"id":"manas-2010:p1394:b001:l023","ordinal":60251,"en":"When Manas had spoken thus,"},{"id":"manas-2010:p1394:b001:l024","ordinal":60252,"en":"The people thought and said, “That is right.”"},{"id":"manas-2010:p1394:b001:l025","ordinal":60253,"en":"These words of Khan Manas"},{"id":"manas-2010:p1394:b001:l026","ordinal":60254,"en":"All the people found fitting."},{"id":"manas-2010:p1394:b001:l027","ordinal":60255,"en":"“Jamgyrchy of the Eshtek,"},{"id":"manas-2010:p1394:b001:l028","ordinal":60256,"en":"If this bastard carries on like this,"},{"id":"manas-2010:p1394:b001:l029","ordinal":60257,"en":"Will bring us much misery,” they said,"},{"id":"manas-2010:p1394:b001:l030","ordinal":60258,"en":"And all the people loathed him."},{"id":"manas-2010:p1394:b001:l031","ordinal":60259,"en":"Ajybai, son of Argynkhan,"},{"id":"manas-2010:p1394:b001:l032","ordinal":60260,"en":"Born exceptional as a goshawk,"},{"id":"manas-2010:p1394:b001:l033","ordinal":60261,"en":"Who found a way in darkness,"},{"id":"manas-2010:p1394:b001:l034","ordinal":60262,"en":"Who found words when taken unawares—"},{"id":"manas-2010:p1394:b001:l035","ordinal":60263,"en":"That lord was Khan Ajybai."},{"id":"manas-2010:p1394:b001:l036","ordinal":60264,"en":"When hardship fell upon their heads,"},{"id":"manas-2010:p1394:b001:l037","ordinal":60265,"en":"He was the warrior who found a way."},{"id":"manas-2010:p1394:b001:l038","ordinal":60266,"en":"Knowing the tongues of seventy tribes,"},{"id":"manas-2010:p1394:b001:l039","ordinal":60267,"en":"He was the son of perfect eloquence."},{"id":"manas-2010:p1394:b001:l040","ordinal":60268,"en":"They dressed him in a coat no shot could pierce,"},{"id":"manas-2010:p1394:b001:l041","ordinal":60269,"en":"They mounted him upon Kartkurong,"},{"id":"manas-2010:p1394:b001:l042","ordinal":60270,"en":"A double-edged, stone-cutting blade—"},{"id":"manas-2010:p1395:b001:l001","ordinal":60271,"en":"He had him hang the sword beneath his clothes,"},{"id":"manas-2010:p1395:b001:l002","ordinal":60272,"en":"To go as envoy to Esenkan,"},{"id":"manas-2010:p1395:b001:l003","ordinal":60273,"en":"To obtain Burulcha,"},{"id":"manas-2010:p1395:b001:l004","ordinal":60274,"en":"He sent Ajybay on his way."},{"id":"manas-2010:p1395:b001:l005","ordinal":60275,"en":"“To carry word to Beijing,” he said,"},{"id":"manas-2010:p1395:b001:l006","ordinal":60276,"en":"He who summered in the Two Kemins,"},{"id":"manas-2010:p1395:b001:l007","ordinal":60277,"en":"Who tethered twin black horses,"},{"id":"manas-2010:p1395:b001:l008","ordinal":60278,"en":"Who made a dark cave his house,"},{"id":"manas-2010:p1395:b001:l009","ordinal":60279,"en":"Who made the dark forest his wealth,"},{"id":"manas-2010:p1395:b001:l010","ordinal":60280,"en":"Who trained a harrier into a hunting hawk,"},{"id":"manas-2010:p1395:b001:l011","ordinal":60281,"en":"Who gathered scattered folk into a people,"},{"id":"manas-2010:p1395:b001:l012","ordinal":60282,"en":"Who began alone and grew in numbers,"},{"id":"manas-2010:p1395:b001:l013","ordinal":60283,"en":"Who began poor and grew rich,"},{"id":"manas-2010:p1395:b001:l014","ordinal":60284,"en":"Like sand gathered into stone,"},{"id":"manas-2010:p1395:b001:l015","ordinal":60285,"en":"Who became chief of the assembled people—"},{"id":"manas-2010:p1395:b001:l016","ordinal":60286,"en":"Hero Ürbü, Eybit Khan’s son,"},{"id":"manas-2010:p1395:b001:l017","ordinal":60287,"en":"Was an outstanding orator."},{"id":"manas-2010:p1395:b001:l018","ordinal":60288,"en":"“Let him go with Ajybay,” they said,"},{"id":"manas-2010:p1395:b001:l019","ordinal":60289,"en":"And he became his close companion."},{"id":"manas-2010:p1395:b001:l020","ordinal":60290,"en":"Ajybay and Ürbü together,"},{"id":"manas-2010:p1395:b001:l021","ordinal":60291,"en":"To go upon an embassy,"},{"id":"manas-2010:p1395:b001:l022","ordinal":60292,"en":"Before Esenkan,"},{"id":"manas-2010:p1395:b001:l023","ordinal":60293,"en":"To receive whatever answer he gave,"},{"id":"manas-2010:p1395:b001:l024","ordinal":60294,"en":"These two set out."},{"id":"manas-2010:p1395:b001:l025","ordinal":60295,"en":"While the two were on their way,"},{"id":"manas-2010:p1395:b001:l026","ordinal":60296,"en":"Word reached their khan,"},{"id":"manas-2010:p1395:b001:l027","ordinal":60297,"en":"Before Khan Esenkan;"},{"id":"manas-2010:p1395:b001:l028","ordinal":60298,"en":"Confusion had descended"},{"id":"manas-2010:p1395:b001:l029","ordinal":60299,"en":"Upon Esenkan’s city."},{"id":"manas-2010:p1395:b001:l030","ordinal":60300,"en":"The Chinese peoples of forty khans"},{"id":"manas-2010:p1395:b001:l031","ordinal":60301,"en":"He had pressed to gather;"},{"id":"manas-2010:p1395:b001:l032","ordinal":60302,"en":"Half of brick and half of stone,"},{"id":"manas-2010:p1395:b001:l033","ordinal":60303,"en":"In Esenkan’s city"},{"id":"manas-2010:p1395:b001:l034","ordinal":60304,"en":"He had such a tower built."},{"id":"manas-2010:p1395:b001:l035","ordinal":60305,"en":"Into Esenkan’s heart"},{"id":"manas-2010:p1395:b001:l036","ordinal":60306,"en":"Fear had fallen:"},{"id":"manas-2010:p1395:b001:l037","ordinal":60307,"en":"“Khan Manas and Almambet,"},{"id":"manas-2010:p1395:b001:l038","ordinal":60308,"en":"The two have arrived;"},{"id":"manas-2010:p1395:b001:l039","ordinal":60309,"en":"The Kyrgyz people have slaughtered,"},{"id":"manas-2010:p1395:b001:l040","ordinal":60310,"en":"Destroyed and shattered the Chinese,"},{"id":"manas-2010:p1395:b001:l041","ordinal":60311,"en":"And come to besiege Beijing,”"},{"id":"manas-2010:p1395:b001:l042","ordinal":60312,"en":"He had heard the news."},{"id":"manas-2010:p1396:b001:l001","ordinal":60313,"en":"After hearing that news,"},{"id":"manas-2010:p1396:b001:l002","ordinal":60314,"en":"Ay Jangjung and Kün Jangjung,"},{"id":"manas-2010:p1396:b001:l003","ordinal":60315,"en":"Esenkan and Kongurbay,"},{"id":"manas-2010:p1396:b001:l004","ordinal":60316,"en":"Onto that standing tower"},{"id":"manas-2010:p1396:b001:l005","ordinal":60317,"en":"The four had climbed."},{"id":"manas-2010:p1396:b001:l006","ordinal":60318,"en":"Ajybay and Ürbü, the two envoys,"},{"id":"manas-2010:p1396:b001:l007","ordinal":60319,"en":"Had seen it."},{"id":"manas-2010:p1396:b001:l008","ordinal":60320,"en":"Alöökö’s grim-faced son"},{"id":"manas-2010:p1396:b001:l009","ordinal":60321,"en":"Addressed these words to them:"},{"id":"manas-2010:p1396:b001:l010","ordinal":60322,"en":"“The Burut who have come as envoys,"},{"id":"manas-2010:p1396:b001:l011","ordinal":60323,"en":"Let me slaughter both alike;"},{"id":"manas-2010:p1396:b001:l012","ordinal":60324,"en":"Let me cut off their apple-like heads,"},{"id":"manas-2010:p1396:b001:l013","ordinal":60325,"en":"Let me settle the matter thus."},{"id":"manas-2010:p1396:b001:l014","ordinal":60326,"en":"To the great khan of Kakan-Chin"},{"id":"manas-2010:p1396:b001:l015","ordinal":60327,"en":"Let me send word again;"},{"id":"manas-2010:p1396:b001:l016","ordinal":60328,"en":"The countless Chinese, the many people,"},{"id":"manas-2010:p1396:b001:l017","ordinal":60329,"en":"Let me gather them all."},{"id":"manas-2010:p1396:b001:l018","ordinal":60330,"en":"When all my people have come,"},{"id":"manas-2010:p1396:b001:l019","ordinal":60331,"en":"The idol made of bronze"},{"id":"manas-2010:p1396:b001:l020","ordinal":60332,"en":"Let me fasten up high,"},{"id":"manas-2010:p1396:b001:l021","ordinal":60333,"en":"And march the people before it;"},{"id":"manas-2010:p1396:b001:l022","ordinal":60334,"en":"Upon these two Burut"},{"id":"manas-2010:p1396:b001:l023","ordinal":60335,"en":"Then let me inflict torment.”"},{"id":"manas-2010:p1396:b001:l024","ordinal":60336,"en":"When Kongurbay spoke thus,"},{"id":"manas-2010:p1396:b001:l025","ordinal":60337,"en":"Esenkan stood thundering,"},{"id":"manas-2010:p1396:b001:l026","ordinal":60338,"en":"Growing excited and agitated:"},{"id":"manas-2010:p1396:b001:l027","ordinal":60339,"en":"“When I call you grim-faced, Kongurbay,"},{"id":"manas-2010:p1396:b001:l028","ordinal":60340,"en":"You begin to bluster!"},{"id":"manas-2010:p1396:b001:l029","ordinal":60341,"en":"You ought to think, Kongurbay:"},{"id":"manas-2010:p1396:b001:l030","ordinal":60342,"en":"A fire blazing from the valley is terrible;"},{"id":"manas-2010:p1396:b001:l031","ordinal":60343,"en":"He fled from you once—"},{"id":"manas-2010:p1396:b001:l032","ordinal":60344,"en":"Your blazing dog Alma is terrible!"},{"id":"manas-2010:p1396:b001:l033","ordinal":60345,"en":"If you kill these envoys—"},{"id":"manas-2010:p1396:b001:l034","ordinal":60346,"en":"‘There is no death for an envoy,’ they say—"},{"id":"manas-2010:p1396:b001:l035","ordinal":60347,"en":"Will the turbaned Muslims be finished?"},{"id":"manas-2010:p1396:b001:l036","ordinal":60348,"en":"Khan Manas, who has come besieging,"},{"id":"manas-2010:p1396:b001:l037","ordinal":60349,"en":"Will he flee from you?"},{"id":"manas-2010:p1396:b001:l038","ordinal":60350,"en":"In Beijing of Kakan-Chin,"},{"id":"manas-2010:p1396:b001:l039","ordinal":60351,"en":"When Almambet brought turmoil"},{"id":"manas-2010:p1396:b001:l040","ordinal":60352,"en":"And raided the horses,"},{"id":"manas-2010:p1396:b001:l041","ordinal":60353,"en":"We gave you a vast host of monks."},{"id":"manas-2010:p1396:b001:l042","ordinal":60354,"en":"When Almambet brought calamity,"},{"id":"manas-2010:p1397:b001:l001","ordinal":60355,"en":"When he raided your horses,"},{"id":"manas-2010:p1397:b001:l002","ordinal":60356,"en":"Barring the ford and fighting,"},{"id":"manas-2010:p1397:b001:l003","ordinal":60357,"en":"Unable to match Almambet,"},{"id":"manas-2010:p1397:b001:l004","ordinal":60358,"en":"You turned back, Kongurbay!"},{"id":"manas-2010:p1397:b001:l005","ordinal":60359,"en":"When you return to the gate,"},{"id":"manas-2010:p1397:b001:l006","ordinal":60360,"en":"You begin to thunder;"},{"id":"manas-2010:p1397:b001:l007","ordinal":60361,"en":"As though you had destroyed the world,"},{"id":"manas-2010:p1397:b001:l008","ordinal":60362,"en":"You begin to bluster!"},{"id":"manas-2010:p1397:b001:l009","ordinal":60363,"en":"They are a people rooted together;"},{"id":"manas-2010:p1397:b001:l010","ordinal":60364,"en":"That he would stir the Burut to action,"},{"id":"manas-2010:p1397:b001:l011","ordinal":60365,"en":"That Manas would come here,"},{"id":"manas-2010:p1397:b001:l012","ordinal":60366,"en":"I was the one who knew."},{"id":"manas-2010:p1397:b001:l013","ordinal":60367,"en":"If we kill these envoys,"},{"id":"manas-2010:p1397:b001:l014","ordinal":60368,"en":"Manas will never let it pass;"},{"id":"manas-2010:p1397:b001:l015","ordinal":60369,"en":"He will not leave us two unharmed."},{"id":"manas-2010:p1397:b001:l016","ordinal":60370,"en":"If we kill the two here,"},{"id":"manas-2010:p1397:b001:l017","ordinal":60371,"en":"The Burut behind him,"},{"id":"manas-2010:p1397:b001:l018","ordinal":60372,"en":"Will he not gather them again?"},{"id":"manas-2010:p1397:b001:l019","ordinal":60373,"en":"In Beijing of Kakan-Chin,"},{"id":"manas-2010:p1397:b001:l020","ordinal":60374,"en":"The multitude of Manchu and Chinese,"},{"id":"manas-2010:p1397:b001:l021","ordinal":60375,"en":"Will he not slaughter them again!”"},{"id":"manas-2010:p1397:b001:l022","ordinal":60376,"en":"When Esenkan said this,"},{"id":"manas-2010:p1397:b001:l023","ordinal":60377,"en":"Raging and flailing,"},{"id":"manas-2010:p1397:b001:l024","ordinal":60378,"en":"Kongurbay took offense,"},{"id":"manas-2010:p1397:b001:l025","ordinal":60379,"en":"Bridling before Esenkan:"},{"id":"manas-2010:p1397:b001:l026","ordinal":60380,"en":"“Why should I remain in Outer Beijing?"},{"id":"manas-2010:p1397:b001:l027","ordinal":60381,"en":"Let me go to Inner Beijing!"},{"id":"manas-2010:p1397:b001:l028","ordinal":60382,"en":"Karykan, who knows my worth—"},{"id":"manas-2010:p1397:b001:l029","ordinal":60383,"en":"Let me reach Karykan!"},{"id":"manas-2010:p1397:b001:l030","ordinal":60384,"en":"From Khan-Too of the jinn and spirits,"},{"id":"manas-2010:p1397:b001:l031","ordinal":60385,"en":"All the Chinese on this side"},{"id":"manas-2010:p1397:b001:l032","ordinal":60386,"en":"Let me gather utterly;"},{"id":"manas-2010:p1397:b001:l033","ordinal":60387,"en":"Let me reach their very roots,"},{"id":"manas-2010:p1397:b001:l034","ordinal":60388,"en":"And the Burut, from their roots up,"},{"id":"manas-2010:p1397:b001:l035","ordinal":60389,"en":"Let me slaughter every one!”"},{"id":"manas-2010:p1397:b001:l036","ordinal":60390,"en":"Raging, Kongurbay,"},{"id":"manas-2010:p1397:b001:l037","ordinal":60391,"en":"Renouncing Outer Beijing,"},{"id":"manas-2010:p1397:b001:l038","ordinal":60392,"en":"Went beyond all bounds, did you see?"},{"id":"manas-2010:p1397:b001:l039","ordinal":60393,"en":"Upon the great khan, greatest of forty khans,"},{"id":"manas-2010:p1397:b001:l040","ordinal":60394,"en":"Pressure fell, and the grim-faced wretch"},{"id":"manas-2010:p1397:b001:l041","ordinal":60395,"en":"Fled away, did you see!"},{"id":"manas-2010:p1397:b001:l042","ordinal":60396,"en":"To Esenkan in Outer Beijing,"},{"id":"manas-2010:p1398:b001:l001","ordinal":60397,"en":"To Esenkan’s gate—"},{"id":"manas-2010:p1398:b001:l002","ordinal":60398,"en":"The two envoys then,"},{"id":"manas-2010:p1398:b001:l003","ordinal":60399,"en":"They arrived, did you see?"},{"id":"manas-2010:p1398:b001:l004","ordinal":60400,"en":"Esenkan’s gate—"},{"id":"manas-2010:p1398:b001:l005","ordinal":60401,"en":"Its doorway was exceedingly narrow."},{"id":"manas-2010:p1398:b001:l006","ordinal":60402,"en":"To keep strangers from entering,"},{"id":"manas-2010:p1398:b001:l007","ordinal":60403,"en":"It had a sorcerer."},{"id":"manas-2010:p1398:b001:l008","ordinal":60404,"en":"Looking to one side—"},{"id":"manas-2010:p1398:b001:l009","ordinal":60405,"en":"A dragon stood ready to suck them in;"},{"id":"manas-2010:p1398:b001:l010","ordinal":60406,"en":"Looking toward one edge—"},{"id":"manas-2010:p1398:b001:l011","ordinal":60407,"en":"A marksman stood ready to shoot."},{"id":"manas-2010:p1398:b001:l012","ordinal":60408,"en":"Looking to one side—"},{"id":"manas-2010:p1398:b001:l013","ordinal":60409,"en":"A boar stood ready to strike;"},{"id":"manas-2010:p1398:b001:l014","ordinal":60410,"en":"Looking to one side—"},{"id":"manas-2010:p1398:b001:l015","ordinal":60411,"en":"A tiger stood ready to tear them apart."},{"id":"manas-2010:p1398:b001:l016","ordinal":60412,"en":"Such sorcery as this"},{"id":"manas-2010:p1398:b001:l017","ordinal":60413,"en":"Ajybay and Ürbü beheld."},{"id":"manas-2010:p1398:b001:l018","ordinal":60414,"en":"Ajybay’s Kartküröng,"},{"id":"manas-2010:p1398:b001:l019","ordinal":60415,"en":"Though he lacked a tongue to speak,"},{"id":"manas-2010:p1398:b001:l020","ordinal":60416,"en":"Was a beast wiser than other creatures."}]
