[{"id":"seytek-2012:p0883:b002:l035","ordinal":362241,"en":"If the tempered spear strikes true,"},{"id":"seytek-2012:p0883:b002:l036","ordinal":362242,"en":"The very core of his heart—"},{"id":"seytek-2012:p0883:b002:l037","ordinal":362243,"en":"That is the measured mark;"},{"id":"seytek-2012:p0883:b002:l038","ordinal":362244,"en":"If God wills that it pass through,"},{"id":"seytek-2012:p0883:b002:l039","ordinal":362245,"en":"His hour of death has come.”"},{"id":"seytek-2012:p0883:b002:l040","ordinal":362246,"en":"Thus he stood, measuring the spot:"},{"id":"seytek-2012:p0883:b004:l001","ordinal":362247,"en":"“Support me, my sovereign father;"},{"id":"seytek-2012:p0883:b004:l002","ordinal":362248,"en":"Straighten whatever swerves,"},{"id":"seytek-2012:p0883:b004:l003","ordinal":362249,"en":"Guide it true as you desire.”"},{"id":"seytek-2012:p0883:b004:l004","ordinal":362250,"en":"Such was his consummate skill"},{"id":"seytek-2012:p0883:b004:l005","ordinal":362251,"en":"As he leveled the wrathful spear,"},{"id":"seytek-2012:p0883:b004:l006","ordinal":362252,"en":"Straining every sinew,"},{"id":"seytek-2012:p0883:b004:l007","ordinal":362253,"en":"Hardening himself in fury,"},{"id":"seytek-2012:p0883:b004:l008","ordinal":362254,"en":"His two strength-giving arms"},{"id":"seytek-2012:p0883:b004:l009","ordinal":362255,"en":"Gathering all their wondrous power,"},{"id":"seytek-2012:p0883:b004:l010","ordinal":362256,"en":"His lip bitten through,"},{"id":"seytek-2012:p0883:b004:l011","ordinal":362257,"en":"His waist bent and body braced,"},{"id":"seytek-2012:p0883:b004:l012","ordinal":362258,"en":"His rib bones creaking,"},{"id":"seytek-2012:p0883:b004:l013","ordinal":362259,"en":"His lion eyes flashing,"},{"id":"seytek-2012:p0883:b004:l014","ordinal":362260,"en":"Swooping like a hawk,"},{"id":"seytek-2012:p0883:b004:l015","ordinal":362261,"en":"And in that noble lion himself"},{"id":"seytek-2012:p0883:b004:l016","ordinal":362262,"en":"Unseen wisdom suddenly arose."},{"id":"seytek-2012:p0883:b004:l017","ordinal":362263,"en":"The breath from his mouth"},{"id":"seytek-2012:p0883:b004:l018","ordinal":362264,"en":"Hissed like a speeding bullet,"},{"id":"seytek-2012:p0883:b004:l019","ordinal":362265,"en":"And the white teeth beneath his brow"},{"id":"seytek-2012:p0883:b004:l020","ordinal":362266,"en":"Scattered like grains of millet."},{"id":"seytek-2012:p0883:b004:l021","ordinal":362267,"en":"The deft lion sprang aside,"},{"id":"seytek-2012:p0883:b004:l022","ordinal":362268,"en":"And once more within the hero"},{"id":"seytek-2012:p0883:b004:l023","ordinal":362269,"en":"Unseen wisdom suddenly arose;"},{"id":"seytek-2012:p0883:b004:l024","ordinal":362270,"en":"He readied himself, spear in hand,"},{"id":"seytek-2012:p0883:b004:l025","ordinal":362271,"en":"Praying, “O God!”"},{"id":"seytek-2012:p0883:b004:l026","ordinal":362272,"en":"With matchless agility,"},{"id":"seytek-2012:p0883:b004:l027","ordinal":362273,"en":"He drove it forward with a sharp crack,"},{"id":"seytek-2012:p0883:b004:l028","ordinal":362274,"en":"And struck the mountain-huge boar"},{"id":"seytek-2012:p0883:b004:l029","ordinal":362275,"en":"With a resounding blow."},{"id":"seytek-2012:p0883:b004:l030","ordinal":362276,"en":"When he aimed at the measured mark,"},{"id":"seytek-2012:p0883:b004:l031","ordinal":362277,"en":"When he struck the appointed place,"},{"id":"seytek-2012:p0883:b004:l032","ordinal":362278,"en":"The tempered spear Bölököñ had made—"},{"id":"seytek-2012:p0883:b004:l033","ordinal":362279,"en":"Such was that spear:"},{"id":"seytek-2012:p0883:b004:l034","ordinal":362280,"en":"Torn from a young birch,"},{"id":"seytek-2012:p0883:b004:l035","ordinal":362281,"en":"Bent true by strongmen,"},{"id":"seytek-2012:p0883:b004:l036","ordinal":362282,"en":"Perfected by master craftsmen,"},{"id":"seytek-2012:p0883:b004:l037","ordinal":362283,"en":"Wrapped in mare’s hide,"},{"id":"seytek-2012:p0883:b004:l038","ordinal":362284,"en":"And hafted by Bölökbay."},{"id":"seytek-2012:p0883:b004:l039","ordinal":362285,"en":"Its point had been forged of steel,"},{"id":"seytek-2012:p0883:b004:l040","ordinal":362286,"en":"So that every man it struck"},{"id":"seytek-2012:p0884:b002:l001","ordinal":362287,"en":"Would convulse and die,"},{"id":"seytek-2012:p0884:b002:l002","ordinal":362288,"en":"So that none could retreat,"},{"id":"seytek-2012:p0884:b002:l003","ordinal":362289,"en":"And whoever met it would know its true nature;"},{"id":"seytek-2012:p0884:b002:l004","ordinal":362290,"en":"It had been tempered"},{"id":"seytek-2012:p0884:b002:l005","ordinal":362291,"en":"With human tears."},{"id":"seytek-2012:p0884:b002:l006","ordinal":362292,"en":"Along its flank"},{"id":"seytek-2012:p0884:b002:l007","ordinal":362293,"en":"It was covered with black horsehair,"},{"id":"seytek-2012:p0884:b002:l008","ordinal":362294,"en":"A tempered spear fit for war,"},{"id":"seytek-2012:p0884:b002:l009","ordinal":362295,"en":"Forged by Sarybay—"},{"id":"seytek-2012:p0884:b002:l010","ordinal":362296,"en":"Such was the manner of this strife."},{"id":"seytek-2012:p0884:b002:l011","ordinal":362297,"en":"When it found the measured mark,"},{"id":"seytek-2012:p0884:b002:l012","ordinal":362298,"en":"When it struck the mortal place,"},{"id":"seytek-2012:p0884:b002:l013","ordinal":362299,"en":"He did not flinch though it rang and rang;"},{"id":"seytek-2012:p0884:b002:l014","ordinal":362300,"en":"Even when death was at hand,"},{"id":"seytek-2012:p0884:b002:l015","ordinal":362301,"en":"He counted it less than a trifle."},{"id":"seytek-2012:p0884:b002:l016","ordinal":362302,"en":"He neither reeled nor stirred,"},{"id":"seytek-2012:p0884:b002:l017","ordinal":362303,"en":"The fearsome wrestler, mighty in wrath,"},{"id":"seytek-2012:p0884:b002:l018","ordinal":362304,"en":"Never budged a hair."},{"id":"seytek-2012:p0884:b002:l019","ordinal":362305,"en":"Furious yet unshaken,"},{"id":"seytek-2012:p0884:b002:l020","ordinal":362306,"en":"Strength and gigantic stature"},{"id":"seytek-2012:p0884:b002:l021","ordinal":362307,"en":"The Lord Most High had bestowed"},{"id":"seytek-2012:p0884:b002:l022","ordinal":362308,"en":"Upon that swine without measure."},{"id":"seytek-2012:p0884:b002:l023","ordinal":362309,"en":"Without blinking or twitching,"},{"id":"seytek-2012:p0884:b002:l024","ordinal":362310,"en":"Sarybay stood utterly still."},{"id":"seytek-2012:p0884:b002:l025","ordinal":362311,"en":"When Sarybay was pierced,"},{"id":"seytek-2012:p0884:b002:l026","ordinal":362312,"en":"The ancient tempered steel spear,"},{"id":"seytek-2012:p0884:b002:l027","ordinal":362313,"en":"The precious heirloom from his father,"},{"id":"seytek-2012:p0884:b002:l028","ordinal":362314,"en":"Splintered through the middle."},{"id":"seytek-2012:p0884:b002:l029","ordinal":362315,"en":"Then the prowess of brave, gray-maned Sarybay"},{"id":"seytek-2012:p0884:b002:l030","ordinal":362316,"en":"Was made manifest"},{"id":"seytek-2012:p0884:b002:l031","ordinal":362317,"en":"And revealed before the warriors."},{"id":"seytek-2012:p0884:b002:l032","ordinal":362318,"en":"He could shatter any mountain he met,"},{"id":"seytek-2012:p0884:b002:l033","ordinal":362319,"en":"While the white steed broad as a house"},{"id":"seytek-2012:p0884:b002:l034","ordinal":362320,"en":"Flew thundering over the plain."},{"id":"seytek-2012:p0884:b002:l035","ordinal":362321,"en":"There was no time to ready another spear—"},{"id":"seytek-2012:p0884:b002:l036","ordinal":362322,"en":"Damn this filthy world!"},{"id":"seytek-2012:p0884:b002:l037","ordinal":362323,"en":"No other course remained."},{"id":"seytek-2012:p0884:b002:l038","ordinal":362324,"en":"When laid to turf it kindled fire;"},{"id":"seytek-2012:p0884:b002:l039","ordinal":362325,"en":"Whatever it struck died in an instant;"},{"id":"seytek-2012:p0884:b002:l040","ordinal":362326,"en":"Wherever it landed, blood flowed,"},{"id":"seytek-2012:p0884:b003:l001","ordinal":362327,"en":"Wherever it slashed, life departed."},{"id":"seytek-2012:p0884:b003:l002","ordinal":362328,"en":"Life fled at its stroke:"},{"id":"seytek-2012:p0884:b003:l003","ordinal":362329,"en":"The Zulfiqar inherited"},{"id":"seytek-2012:p0884:b003:l004","ordinal":362330,"en":"From gray-maned Manas of old."},{"id":"seytek-2012:p0884:b003:l005","ordinal":362331,"en":"Seizing it by the hilt,"},{"id":"seytek-2012:p0884:b003:l006","ordinal":362332,"en":"Drawing it from its sheath,"},{"id":"seytek-2012:p0884:b003:l007","ordinal":362333,"en":"He reached him before one could shout, “Strike!”"},{"id":"seytek-2012:p0884:b003:l008","ordinal":362334,"en":"And with it the noble lion"},{"id":"seytek-2012:p0884:b003:l009","ordinal":362335,"en":"Slashed once again as he passed."},{"id":"seytek-2012:p0884:b003:l010","ordinal":362336,"en":"The other never saw the stroke, not even by a hair;"},{"id":"seytek-2012:p0884:b003:l011","ordinal":362337,"en":"From the calamity of doom and death,"},{"id":"seytek-2012:p0884:b003:l012","ordinal":362338,"en":"The swine saw no escape at last."},{"id":"seytek-2012:p0884:b003:l013","ordinal":362339,"en":"Roaring in menace,"},{"id":"seytek-2012:p0884:b003:l014","ordinal":362340,"en":"Bellowing in rage,"},{"id":"seytek-2012:p0884:b003:l015","ordinal":362341,"en":"Cracking like lightning,"},{"id":"seytek-2012:p0884:b003:l016","ordinal":362342,"en":"Thunderous as a dragon,"},{"id":"seytek-2012:p0884:b003:l017","ordinal":362343,"en":"He made every onlooker’s"},{"id":"seytek-2012:p0884:b003:l018","ordinal":362344,"en":"Whole body shudder."},{"id":"seytek-2012:p0884:b003:l019","ordinal":362345,"en":"His wrestler’s form stood revealed"},{"id":"seytek-2012:p0884:b003:l020","ordinal":362346,"en":"As he girded on his blue-mottled sword,"},{"id":"seytek-2012:p0884:b003:l021","ordinal":362347,"en":"Sprang like a blue tiger,"},{"id":"seytek-2012:p0884:b003:l022","ordinal":362348,"en":"Poured out his wrath and ground his teeth;"},{"id":"seytek-2012:p0884:b003:l023","ordinal":362349,"en":"His attacking arm knotted with power,"},{"id":"seytek-2012:p0884:b003:l024","ordinal":362350,"en":"His fury made the blood run cold,"},{"id":"seytek-2012:p0884:b003:l025","ordinal":362351,"en":"And when enraged, misery boiled over."},{"id":"seytek-2012:p0884:b003:l026","ordinal":362352,"en":"The accursed monster’s son,"},{"id":"seytek-2012:p0884:b003:l027","ordinal":362353,"en":"With his cast-iron head broad as a house—"},{"id":"seytek-2012:p0884:b003:l028","ordinal":362354,"en":"Flee far away if you see his deeds!"},{"id":"seytek-2012:p0884:b003:l029","ordinal":362355,"en":"He hacked down all who crossed him,"},{"id":"seytek-2012:p0884:b003:l030","ordinal":362356,"en":"Gnawed apart all he encountered,"},{"id":"seytek-2012:p0884:b003:l031","ordinal":362357,"en":"Destroyed all he set his eyes upon,"},{"id":"seytek-2012:p0884:b003:l032","ordinal":362358,"en":"Reduced matchlock-men to ashes,"},{"id":"seytek-2012:p0884:b003:l033","ordinal":362359,"en":"Filled his quiver with arrows,"},{"id":"seytek-2012:p0884:b003:l034","ordinal":362360,"en":"And annihilated all who fought him."},{"id":"seytek-2012:p0884:b003:l035","ordinal":362361,"en":"That was the deft one, that was the lion,"},{"id":"seytek-2012:p0884:b003:l036","ordinal":362362,"en":"That was the man endowed with courage."},{"id":"seytek-2012:p0884:b003:l037","ordinal":362363,"en":"He turned upon brave Seytek,"},{"id":"seytek-2012:p0884:b003:l038","ordinal":362364,"en":"Raising his battle-axe and sword"},{"id":"seytek-2012:p0884:b003:l039","ordinal":362365,"en":"Higher and higher,"},{"id":"seytek-2012:p0884:b003:l040","ordinal":362366,"en":"His black eyes filling with blood."},{"id":"seytek-2012:p0885:b002:l001","ordinal":362367,"en":"His cavernous mouth gaped wide,"},{"id":"seytek-2012:p0885:b002:l002","ordinal":362368,"en":"And the fire pouring from it"},{"id":"seytek-2012:p0885:b002:l003","ordinal":362369,"en":"Shot upward toward the sky."},{"id":"seytek-2012:p0885:b002:l004","ordinal":362370,"en":"His flesh quivered and his eyes blazed;"},{"id":"seytek-2012:p0885:b002:l005","ordinal":362371,"en":"His color fled, his arms drew taut."},{"id":"seytek-2012:p0885:b002:l006","ordinal":362372,"en":"Parting away in fury,"},{"id":"seytek-2012:p0885:b002:l007","ordinal":362373,"en":"Terrible in bearing and potent in venom,"},{"id":"seytek-2012:p0885:b002:l008","ordinal":362374,"en":"He took on the aspect of a dragon."},{"id":"seytek-2012:p0885:b002:l009","ordinal":362375,"en":"Wild with frenzy, he sprang,"},{"id":"seytek-2012:p0885:b002:l010","ordinal":362376,"en":"Preparing to attack brave Seytek,"},{"id":"seytek-2012:p0885:b002:l011","ordinal":362377,"en":"Raising his pinewood spear,"},{"id":"seytek-2012:p0885:b002:l012","ordinal":362378,"en":"And riding straight against him."},{"id":"seytek-2012:p0885:b002:l013","ordinal":362379,"en":"His staring eyes opened wide,"},{"id":"seytek-2012:p0885:b002:l014","ordinal":362380,"en":"And black venom from both corners of his mouth"},{"id":"seytek-2012:p0885:b002:l015","ordinal":362381,"en":"Spattered toward his ears."},{"id":"seytek-2012:p0885:b002:l016","ordinal":362382,"en":"His face bristled with coarse hair,"},{"id":"seytek-2012:p0885:b002:l017","ordinal":362383,"en":"Sparks flew from his mace,"},{"id":"seytek-2012:p0885:b002:l018","ordinal":362384,"en":"Fire flashed from both eyes,"},{"id":"seytek-2012:p0885:b002:l019","ordinal":362385,"en":"And dust rose from his heart."},{"id":"seytek-2012:p0885:b002:l020","ordinal":362386,"en":"He unleashed a terrible wrath;"},{"id":"seytek-2012:p0885:b002:l021","ordinal":362387,"en":"The people clamored and tumult broke out,"},{"id":"seytek-2012:p0885:b002:l022","ordinal":362388,"en":"And many, overcome with terror,"},{"id":"seytek-2012:p0885:b002:l023","ordinal":362389,"en":"Lost their senses and fled in disarray."},{"id":"seytek-2012:p0885:b002:l024","ordinal":362390,"en":"“The moon is dark, the night close at hand—"},{"id":"seytek-2012:p0885:b002:l025","ordinal":362391,"en":"What will this night bring?"},{"id":"seytek-2012:p0885:b002:l026","ordinal":362392,"en":"When the offspring of that fearsome lion"},{"id":"seytek-2012:p0885:b002:l027","ordinal":362393,"en":"Meets such a day of upheaval,"},{"id":"seytek-2012:p0885:b002:l028","ordinal":362394,"en":"What will daylight bring?”"},{"id":"seytek-2012:p0885:b002:l029","ordinal":362395,"en":"Sarybay was the one who clashed with him,"},{"id":"seytek-2012:p0885:b002:l030","ordinal":362396,"en":"Malicious in thought and narrow of heart."},{"id":"seytek-2012:p0885:b002:l031","ordinal":362397,"en":"He assailed the wrathful lion,"},{"id":"seytek-2012:p0885:b002:l032","ordinal":362398,"en":"And the hero became entangled in disaster;"},{"id":"seytek-2012:p0885:b002:l033","ordinal":362399,"en":"He had challenged a champion unlike any other."},{"id":"seytek-2012:p0885:b002:l034","ordinal":362400,"en":"“O lion who departed for the other world,"},{"id":"seytek-2012:p0885:b002:l035","ordinal":362401,"en":"Gray-maned one, cast down your gaze!"},{"id":"seytek-2012:p0885:b002:l036","ordinal":362402,"en":"Watch over the child sheltered by your shade,"},{"id":"seytek-2012:p0885:b002:l037","ordinal":362403,"en":"The figure left behind you,"},{"id":"seytek-2012:p0885:b002:l038","ordinal":362404,"en":"The falcon you reared,"},{"id":"seytek-2012:p0885:b002:l039","ordinal":362405,"en":"The courser you suckled,"},{"id":"seytek-2012:p0885:b002:l040","ordinal":362406,"en":"The young hero left as your gift,"},{"id":"seytek-2012:p0885:b003:l001","ordinal":362407,"en":"The lamp burning upon the ridge."},{"id":"seytek-2012:p0885:b003:l002","ordinal":362408,"en":"Spirit of gray-maned Manas,"},{"id":"seytek-2012:p0885:b003:l003","ordinal":362409,"en":"Come yourself and sustain him!"},{"id":"seytek-2012:p0885:b003:l004","ordinal":362410,"en":"Bind fast the path"},{"id":"seytek-2012:p0885:b003:l005","ordinal":362411,"en":"Of this wrathful warrior-lion!"},{"id":"seytek-2012:p0885:b003:l006","ordinal":362412,"en":"Entangle and bar"},{"id":"seytek-2012:p0885:b003:l007","ordinal":362413,"en":"The way of that infidel Sarybay!"},{"id":"seytek-2012:p0885:b003:l008","ordinal":362414,"en":"True Almambet and brave Chubak,"},{"id":"seytek-2012:p0885:b003:l009","ordinal":362415,"en":"Protect the cherished boy Seytek;"},{"id":"seytek-2012:p0885:b003:l010","ordinal":362416,"en":"From the calamity of doom and death,"},{"id":"seytek-2012:p0885:b003:l011","ordinal":362417,"en":"Come to Seytek’s aid!”"},{"id":"seytek-2012:p0885:b003:l012","ordinal":362418,"en":"All the champions joined together,"},{"id":"seytek-2012:p0885:b003:l013","ordinal":362419,"en":"And the people cried out in tumult,"},{"id":"seytek-2012:p0885:b003:l014","ordinal":362420,"en":"Praying sincerely"},{"id":"seytek-2012:p0885:b003:l015","ordinal":362421,"en":"To the Creator, the spirits, and God:"},{"id":"seytek-2012:p0885:b003:l016","ordinal":362422,"en":"“O host of holy masters who protect us,"},{"id":"seytek-2012:p0885:b003:l017","ordinal":362423,"en":"Come and lend your aid;"},{"id":"seytek-2012:p0885:b003:l018","ordinal":362424,"en":"Forty holy guardians, Khizr and Ilyas,"},{"id":"seytek-2012:p0885:b003:l019","ordinal":362425,"en":"Come and shield the boy!"},{"id":"seytek-2012:p0885:b003:l020","ordinal":362426,"en":"From death’s bullet of steel,"},{"id":"seytek-2012:p0885:b003:l021","ordinal":362427,"en":"From the enemy’s iron snare,"},{"id":"seytek-2012:p0885:b003:l022","ordinal":362428,"en":"From the wrathful one’s hand,"},{"id":"seytek-2012:p0885:b003:l023","ordinal":362429,"en":"From the pit dug deep,"},{"id":"seytek-2012:p0885:b003:l024","ordinal":362430,"en":"From the bitterness boiled for him,"},{"id":"seytek-2012:p0885:b003:l025","ordinal":362431,"en":"From the fiery embers of hell,"},{"id":"seytek-2012:p0885:b003:l026","ordinal":362432,"en":"From the merciless, grim-faced"},{"id":"seytek-2012:p0885:b003:l027","ordinal":362433,"en":"True enemy’s hand—"},{"id":"seytek-2012:p0885:b003:l028","ordinal":362434,"en":"God, preserve the boy!”"},{"id":"seytek-2012:p0885:b003:l029","ordinal":362435,"en":"The people streamed about, crying aloud,"},{"id":"seytek-2012:p0885:b003:l030","ordinal":362436,"en":"Raising a roar as though the earth had split."},{"id":"seytek-2012:p0885:b003:l031","ordinal":362437,"en":"The poor folk lost their senses,"},{"id":"seytek-2012:p0885:b003:l032","ordinal":362438,"en":"Their thoughts scattered and divided."},{"id":"seytek-2012:p0885:b003:l033","ordinal":362439,"en":"Of monstrous strength and venom,"},{"id":"seytek-2012:p0885:b003:l034","ordinal":362440,"en":"Sarybay looked dreadful."},{"id":"seytek-2012:p0885:b003:l035","ordinal":362441,"en":"The vast host watching him"},{"id":"seytek-2012:p0885:b003:l036","ordinal":362442,"en":"Were dumbfounded and distraught."},{"id":"seytek-2012:p0885:b003:l037","ordinal":362443,"en":"The people lamented in anguish:"},{"id":"seytek-2012:p0885:b003:l038","ordinal":362444,"en":"“What will become of the boy?”"},{"id":"seytek-2012:p0885:b003:l039","ordinal":362445,"en":"The watching multitude"},{"id":"seytek-2012:p0885:b003:l040","ordinal":362446,"en":"Despaired of their tiny lives."},{"id":"seytek-2012:p0886:b002:l001","ordinal":362447,"en":"They swiftly cried, “Baabedin!”"},{"id":"seytek-2012:p0886:b002:l002","ordinal":362448,"en":"And those who knew the invocations"},{"id":"seytek-2012:p0886:b002:l003","ordinal":362449,"en":"Called on Aituyak,"},{"id":"seytek-2012:p0886:b002:l004","ordinal":362450,"en":"Quickly uttering every prayer:"},{"id":"seytek-2012:p0886:b002:l005","ordinal":362451,"en":"“His strength is strange, his fury great—"},{"id":"seytek-2012:p0886:b002:l006","ordinal":362452,"en":"God, cast the infidel beneath him!"},{"id":"seytek-2012:p0886:b002:l007","ordinal":362453,"en":"Let the cherished one, black as a crow,"},{"id":"seytek-2012:p0886:b002:l008","ordinal":362454,"en":"Let God set the boy above him!”"},{"id":"seytek-2012:p0886:b002:l009","ordinal":362455,"en":"Brave Seytek, bearer of the sacred standard,"},{"id":"seytek-2012:p0886:b002:l010","ordinal":362456,"en":"Was the lord of the people, a lion;"},{"id":"seytek-2012:p0886:b002:l011","ordinal":362457,"en":"He was the stronghold of their inheritance."},{"id":"seytek-2012:p0886:b002:l012","ordinal":362458,"en":"Set him in the vanguard and he brought good fortune;"},{"id":"seytek-2012:p0886:b002:l013","ordinal":362459,"en":"Let him lead, and he was like a myriad troops."},{"id":"seytek-2012:p0886:b002:l014","ordinal":362460,"en":"From a ridge he saw keenly;"},{"id":"seytek-2012:p0886:b002:l015","ordinal":362461,"en":"He was the heir bound to the people’s back."},{"id":"seytek-2012:p0886:b002:l016","ordinal":362462,"en":"While this boy lived,"},{"id":"seytek-2012:p0886:b002:l017","ordinal":362463,"en":"He was a black, snow-covered crag,"},{"id":"seytek-2012:p0886:b002:l018","ordinal":362464,"en":"And the people were his cherished own."},{"id":"seytek-2012:p0886:b002:l019","ordinal":362465,"en":"The people reeled in anguish,"},{"id":"seytek-2012:p0886:b002:l020","ordinal":362466,"en":"Praying to the figure"},{"id":"seytek-2012:p0886:b002:l021","ordinal":362467,"en":"Of the gray-maned lion dear as a crow."},{"id":"seytek-2012:p0886:b002:l022","ordinal":362468,"en":"The young champion who faced him"},{"id":"seytek-2012:p0886:b002:l023","ordinal":362469,"en":"Fought Sarybay—"},{"id":"seytek-2012:p0886:b002:l024","ordinal":362470,"en":"Such was their grappling."},{"id":"seytek-2012:p0886:b002:l025","ordinal":362471,"en":"As the people prayed in distress,"},{"id":"seytek-2012:p0886:b002:l026","ordinal":362472,"en":"Sarybay poured out his wrath"},{"id":"seytek-2012:p0886:b002:l027","ordinal":362473,"en":"And prepared to attack brave Seytek."},{"id":"seytek-2012:p0886:b002:l028","ordinal":362474,"en":"Beneath him was Tookyzyl,"},{"id":"seytek-2012:p0886:b002:l029","ordinal":362475,"en":"The red mountain that flew like a cloud,"},{"id":"seytek-2012:p0886:b002:l030","ordinal":362476,"en":"Both swift and steady;"},{"id":"seytek-2012:p0886:b002:l031","ordinal":362477,"en":"He tugged and trailed the reins,"},{"id":"seytek-2012:p0886:b002:l032","ordinal":362478,"en":"His doe-like eyes turning red,"},{"id":"seytek-2012:p0886:b002:l033","ordinal":362479,"en":"His argali stride stretching long."},{"id":"seytek-2012:p0886:b002:l034","ordinal":362480,"en":"Set upon stone, he never slipped;"},{"id":"seytek-2012:p0886:b002:l035","ordinal":362481,"en":"He never faltered on sandy ground,"},{"id":"seytek-2012:p0886:b002:l036","ordinal":362482,"en":"Never stumbled or tired,"},{"id":"seytek-2012:p0886:b002:l037","ordinal":362483,"en":"His parrot-like tail streaming."},{"id":"seytek-2012:p0886:b002:l038","ordinal":362484,"en":"A fully grown giant demon had come"},{"id":"seytek-2012:p0886:b002:l039","ordinal":362485,"en":"And asked for Tookyzyl;"},{"id":"seytek-2012:p0886:b002:l040","ordinal":362486,"en":"When he asked, the horse was not given,"},{"id":"seytek-2012:p0886:b003:l001","ordinal":362487,"en":"Nor had any cold-hearted stranger ridden him."},{"id":"seytek-2012:p0886:b003:l002","ordinal":362488,"en":"He pulled free and twisted the reins,"},{"id":"seytek-2012:p0886:b003:l003","ordinal":362489,"en":"And leapt whenever he saw water or ravine."},{"id":"seytek-2012:p0886:b003:l004","ordinal":362490,"en":"He never panicked at a battle cry;"},{"id":"seytek-2012:p0886:b003:l005","ordinal":362491,"en":"Once his hooves strode forward,"},{"id":"seytek-2012:p0886:b003:l006","ordinal":362492,"en":"He never stepped twice in the same track."},{"id":"seytek-2012:p0886:b003:l007","ordinal":362493,"en":"When he burst away, he left all others behind;"},{"id":"seytek-2012:p0886:b003:l008","ordinal":362494,"en":"When he ran, the black earth"},{"id":"seytek-2012:p0886:b003:l009","ordinal":362495,"en":"Split apart layer by layer."},{"id":"seytek-2012:p0886:b003:l010","ordinal":362496,"en":"Ill-fated Tookyzyl"}]
