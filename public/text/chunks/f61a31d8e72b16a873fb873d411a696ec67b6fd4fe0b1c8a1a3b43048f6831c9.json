[{"id":"manas-2010:p1557:b001:l009","ordinal":67073,"en":"Of the Chinese with rank-buttons,"},{"id":"manas-2010:p1557:b001:l010","ordinal":67074,"en":"The finest, without restraint,"},{"id":"manas-2010:p1557:b001:l011","ordinal":67075,"en":"All attacked Syrgak."},{"id":"manas-2010:p1557:b001:l012","ordinal":67076,"en":"When so many lances struck,"},{"id":"manas-2010:p1557:b001:l013","ordinal":67077,"en":"What could keen Syrgak do?"},{"id":"manas-2010:p1557:b001:l014","ordinal":67078,"en":"He did not stir in dismay,"},{"id":"manas-2010:p1557:b001:l015","ordinal":67079,"en":"Did not shift upon his horse."},{"id":"manas-2010:p1557:b001:l016","ordinal":67080,"en":"The Chinese braced themselves and gathered;"},{"id":"manas-2010:p1557:b001:l017","ordinal":67081,"en":"When they came near,"},{"id":"manas-2010:p1557:b001:l018","ordinal":67082,"en":"Your Syrgak swept them away."},{"id":"manas-2010:p1557:b001:l019","ordinal":67083,"en":"Biting his lip, Kongurbay"},{"id":"manas-2010:p1557:b001:l020","ordinal":67084,"en":"Drove his people: “Sweep upon him!”"},{"id":"manas-2010:p1557:b001:l021","ordinal":67085,"en":"He shouted, slashing with his sword."},{"id":"manas-2010:p1557:b001:l022","ordinal":67086,"en":"“Syrgak is a champion indeed;"},{"id":"manas-2010:p1557:b001:l023","ordinal":67087,"en":"Now is the time to seize him."},{"id":"manas-2010:p1557:b001:l024","ordinal":67088,"en":"He is complete in every way,"},{"id":"manas-2010:p1557:b001:l025","ordinal":67089,"en":"A lion sprung from the Buruts."},{"id":"manas-2010:p1557:b001:l026","ordinal":67090,"en":"He has just reached twenty-one,"},{"id":"manas-2010:p1557:b001:l027","ordinal":67091,"en":"He has come to that age."},{"id":"manas-2010:p1557:b001:l028","ordinal":67092,"en":"The lions Manas and Almambet,"},{"id":"manas-2010:p1557:b001:l029","ordinal":67093,"en":"To support them as a companion,"},{"id":"manas-2010:p1557:b001:l030","ordinal":67094,"en":"He is a hero who spares nothing!"},{"id":"manas-2010:p1557:b001:l031","ordinal":67095,"en":"I heard news from a caravan man:"},{"id":"manas-2010:p1557:b001:l032","ordinal":67096,"en":"When the people of seven khans"},{"id":"manas-2010:p1557:b001:l033","ordinal":67097,"en":"Were assembled together,"},{"id":"manas-2010:p1557:b001:l034","ordinal":67098,"en":"When the whole people"},{"id":"manas-2010:p1557:b001:l035","ordinal":67099,"en":"Had all been gathered,"},{"id":"manas-2010:p1557:b001:l036","ordinal":67100,"en":"When they were made to file past,"},{"id":"manas-2010:p1557:b001:l037","ordinal":67101,"en":"At a loss to find a hero,"},{"id":"manas-2010:p1557:b001:l038","ordinal":67102,"en":"When the people were hard pressed,"},{"id":"manas-2010:p1557:b001:l039","ordinal":67103,"en":"Then that lord Syrgak,"},{"id":"manas-2010:p1557:b001:l040","ordinal":67104,"en":"To scout together,"},{"id":"manas-2010:p1557:b001:l041","ordinal":67105,"en":"Joined Almambet"},{"id":"manas-2010:p1557:b001:l042","ordinal":67106,"en":"And went to Great Beijing."},{"id":"manas-2010:p1558:b001:l001","ordinal":67107,"en":"‘Kongurbay in Beijing,"},{"id":"manas-2010:p1558:b001:l002","ordinal":67108,"en":"I shall raid his horses;"},{"id":"manas-2010:p1558:b001:l003","ordinal":67109,"en":"I shall open the Buruts' road;"},{"id":"manas-2010:p1558:b001:l004","ordinal":67110,"en":"I shall scatter the Chinese livestock,’"},{"id":"manas-2010:p1558:b001:l005","ordinal":67111,"en":"He came himself, I heard."},{"id":"manas-2010:p1558:b001:l006","ordinal":67112,"en":"If you let him escape, Chinese multitude,"},{"id":"manas-2010:p1558:b001:l007","ordinal":67113,"en":"The gray horse beneath him,"},{"id":"manas-2010:p1558:b001:l008","ordinal":67114,"en":"No beast can catch in pursuit."},{"id":"manas-2010:p1558:b001:l009","ordinal":67115,"en":"Though one grapples with Syrgak,"},{"id":"manas-2010:p1558:b001:l010","ordinal":67116,"en":"One lacks the strength to match him."},{"id":"manas-2010:p1558:b001:l011","ordinal":67117,"en":"His right shoulder is broad;"},{"id":"manas-2010:p1558:b001:l012","ordinal":67118,"en":"Except that Manas has mighty spirits,"},{"id":"manas-2010:p1558:b001:l013","ordinal":67119,"en":"Syrgak is braver even than him."},{"id":"manas-2010:p1558:b001:l014","ordinal":67120,"en":"Nine great hosts of Chinese, and he alone!"},{"id":"manas-2010:p1558:b001:l015","ordinal":67121,"en":"He speared and destroyed so many mountain-sized men."},{"id":"manas-2010:p1558:b001:l016","ordinal":67122,"en":"He veiled the heavens in dust,"},{"id":"manas-2010:p1558:b001:l017","ordinal":67123,"en":"Turned the earth's face to blood,"},{"id":"manas-2010:p1558:b001:l018","ordinal":67124,"en":"Killed so many heroes."},{"id":"manas-2010:p1558:b001:l019","ordinal":67125,"en":"Syrgak has broken my backbone,"},{"id":"manas-2010:p1558:b001:l020","ordinal":67126,"en":"Ruined so much of my land."},{"id":"manas-2010:p1558:b001:l021","ordinal":67127,"en":"Raiding my horses alone,"},{"id":"manas-2010:p1558:b001:l022","ordinal":67128,"en":"He drove sleep utterly from me."},{"id":"manas-2010:p1558:b001:l023","ordinal":67129,"en":"Among all the people I have never seen,"},{"id":"manas-2010:p1558:b001:l024","ordinal":67130,"en":"In all my life as Kongurbay,"},{"id":"manas-2010:p1558:b001:l025","ordinal":67131,"en":"Such a goshawk as this."},{"id":"manas-2010:p1558:b001:l026","ordinal":67132,"en":"I was the khan of the shaven priests;"},{"id":"manas-2010:p1558:b001:l027","ordinal":67133,"en":"Even if I die, I have no regret."},{"id":"manas-2010:p1558:b001:l028","ordinal":67134,"en":"Among men sound of body,"},{"id":"manas-2010:p1558:b001:l029","ordinal":67135,"en":"There is none I have not dueled with."},{"id":"manas-2010:p1558:b001:l030","ordinal":67136,"en":"His resourcefulness is formidable."},{"id":"manas-2010:p1558:b001:l031","ordinal":67137,"en":"It has not left my very bones,"},{"id":"manas-2010:p1558:b001:l032","ordinal":67138,"en":"The thrust of Syrgak's lance."},{"id":"manas-2010:p1558:b001:l033","ordinal":67139,"en":"Chinese, people of forty khans,"},{"id":"manas-2010:p1558:b001:l034","ordinal":67140,"en":"All of us, without looking back,"},{"id":"manas-2010:p1558:b001:l035","ordinal":67141,"en":"Let us sweep upon him together."},{"id":"manas-2010:p1558:b001:l036","ordinal":67142,"en":"Not letting him prepare or flee,"},{"id":"manas-2010:p1558:b001:l037","ordinal":67143,"en":"Surround him and spread a net;"},{"id":"manas-2010:p1558:b001:l038","ordinal":67144,"en":"Let us bind him alive!"},{"id":"manas-2010:p1558:b001:l039","ordinal":67145,"en":"Before the emperor-khan,"},{"id":"manas-2010:p1558:b001:l040","ordinal":67146,"en":"With the forty maidens of his treasury,"},{"id":"manas-2010:p1558:b001:l041","ordinal":67147,"en":"Let us take and place him."},{"id":"manas-2010:p1558:b001:l042","ordinal":67148,"en":"Will he stand looking without touching them?"},{"id":"manas-2010:p1559:b001:l001","ordinal":67149,"en":"If one of them bears a son,"},{"id":"manas-2010:p1559:b001:l002","ordinal":67150,"en":"Let us crown him with gold,"},{"id":"manas-2010:p1559:b001:l003","ordinal":67151,"en":"Seat him on the golden throne,"},{"id":"manas-2010:p1559:b001:l004","ordinal":67152,"en":"And raise him as our khan!"},{"id":"manas-2010:p1559:b001:l005","ordinal":67153,"en":"If we capture Syrgak alive,"},{"id":"manas-2010:p1559:b001:l006","ordinal":67154,"en":"Their great Manas died before;"},{"id":"manas-2010:p1559:b001:l007","ordinal":67155,"en":"They have no support to rely upon,"},{"id":"manas-2010:p1559:b001:l008","ordinal":67156,"en":"Except Almambet and Chubak,"},{"id":"manas-2010:p1559:b001:l009","ordinal":67157,"en":"No lions besides those two."},{"id":"manas-2010:p1559:b001:l010","ordinal":67158,"en":"If we finish those two off,"},{"id":"manas-2010:p1559:b001:l011","ordinal":67159,"en":"Then the Burut"},{"id":"manas-2010:p1559:b001:l012","ordinal":67160,"en":"Will have nowhere to take shelter."},{"id":"manas-2010:p1559:b001:l013","ordinal":67161,"en":"Do your utmost, champions!"},{"id":"manas-2010:p1559:b001:l014","ordinal":67162,"en":"Once we have bound Syrgak,"},{"id":"manas-2010:p1559:b001:l015","ordinal":67163,"en":"From the remaining Burut host"},{"id":"manas-2010:p1559:b001:l016","ordinal":67164,"en":"We shall plunder their valuables,"},{"id":"manas-2010:p1559:b001:l017","ordinal":67165,"en":"Bring a day of ruin,"},{"id":"manas-2010:p1559:b001:l018","ordinal":67166,"en":"And heap turmoil upon their heads!"},{"id":"manas-2010:p1559:b001:l019","ordinal":67167,"en":"We shall drive them off to Mecca,"},{"id":"manas-2010:p1559:b001:l020","ordinal":67168,"en":"Seize their daughters and wives as booty,"},{"id":"manas-2010:p1559:b001:l021","ordinal":67169,"en":"And plunder their livestock and possessions!"},{"id":"manas-2010:p1559:b001:l022","ordinal":67170,"en":"We shall kill all their giants,"},{"id":"manas-2010:p1559:b001:l023","ordinal":67171,"en":"And seize their horses and mares;"},{"id":"manas-2010:p1559:b001:l024","ordinal":67172,"en":"Of every Burut who resists,"},{"id":"manas-2010:p1559:b001:l025","ordinal":67173,"en":"We shall smash the brains."},{"id":"manas-2010:p1559:b001:l026","ordinal":67174,"en":"In that way we shall avenge"},{"id":"manas-2010:p1559:b001:l027","ordinal":67175,"en":"The humiliation of our people!"},{"id":"manas-2010:p1559:b001:l028","ordinal":67176,"en":"Upon the Burut who came here themselves,"},{"id":"manas-2010:p1559:b001:l029","ordinal":67177,"en":"We shall heap crushing humiliation;"},{"id":"manas-2010:p1559:b001:l030","ordinal":67178,"en":"Not only the Burut’s other goods—"},{"id":"manas-2010:p1559:b001:l031","ordinal":67179,"en":"We shall drive off their cattle!”"},{"id":"manas-2010:p1559:b001:l032","ordinal":67180,"en":"Thus spoke Kongurbay,"},{"id":"manas-2010:p1559:b001:l033","ordinal":67181,"en":"And as he gave his orders,"},{"id":"manas-2010:p1559:b001:l034","ordinal":67182,"en":"Forty khans prepared without hesitation;"},{"id":"manas-2010:p1559:b001:l035","ordinal":67183,"en":"The Chinese swarmed in, shouting."},{"id":"manas-2010:p1559:b001:l036","ordinal":67184,"en":"As the Chinese attacked together,"},{"id":"manas-2010:p1559:b001:l037","ordinal":67185,"en":"Lone Syrgak would not yield;"},{"id":"manas-2010:p1559:b001:l038","ordinal":67186,"en":"He fought without sparing himself,"},{"id":"manas-2010:p1559:b001:l039","ordinal":67187,"en":"His horse scarcely touching the ground."},{"id":"manas-2010:p1559:b001:l040","ordinal":67188,"en":"Making it dart like a snake,"},{"id":"manas-2010:p1559:b001:l041","ordinal":67189,"en":"He slew Chinese beyond counting,"},{"id":"manas-2010:p1559:b001:l042","ordinal":67190,"en":"And sent all he saw crawling."},{"id":"manas-2010:p1560:b001:l001","ordinal":67191,"en":"A black Kalmyk champion"},{"id":"manas-2010:p1560:b001:l002","ordinal":67192,"en":"Approached Syrgak's head,"},{"id":"manas-2010:p1560:b001:l003","ordinal":67193,"en":"Making ready"},{"id":"manas-2010:p1560:b001:l004","ordinal":67194,"en":"To throw a lasso over him."},{"id":"manas-2010:p1560:b001:l005","ordinal":67195,"en":"Their bow-drawing marksmen"},{"id":"manas-2010:p1560:b001:l006","ordinal":67196,"en":"Showered arrows like rain,"},{"id":"manas-2010:p1560:b001:l007","ordinal":67197,"en":"And all came swarming in."},{"id":"manas-2010:p1560:b001:l008","ordinal":67198,"en":"With iron ropes and nets,"},{"id":"manas-2010:p1560:b001:l009","ordinal":67199,"en":"They encircled him now."},{"id":"manas-2010:p1560:b001:l010","ordinal":67200,"en":"Cotton sash and wide boots,"},{"id":"manas-2010:p1560:b001:l011","ordinal":67201,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1560:b001:l012","ordinal":67202,"en":"Stretched out and thrust his lance."},{"id":"manas-2010:p1560:b001:l013","ordinal":67203,"en":"Your valiant falcon Syrgak,"},{"id":"manas-2010:p1560:b001:l014","ordinal":67204,"en":"Paying not the slightest heed,"},{"id":"manas-2010:p1560:b001:l015","ordinal":67205,"en":"Stood there without wavering."},{"id":"manas-2010:p1560:b001:l016","ordinal":67206,"en":"Ay Zhang-Zhung charged with a roar,"},{"id":"manas-2010:p1560:b001:l017","ordinal":67207,"en":"Urging his horse from afar;"},{"id":"manas-2010:p1560:b001:l018","ordinal":67208,"en":"He too reached Syrgak"},{"id":"manas-2010:p1560:b001:l019","ordinal":67209,"en":"And thrust his lance as he passed."},{"id":"manas-2010:p1560:b001:l020","ordinal":67210,"en":"Unheeding the ringing blows,"},{"id":"manas-2010:p1560:b001:l021","ordinal":67211,"en":"The Fierce One's and Zhang-Zhung's"},{"id":"manas-2010:p1560:b001:l022","ordinal":67212,"en":"Charging lance-thrusts"},{"id":"manas-2010:p1560:b001:l023","ordinal":67213,"en":"He held beneath his notice."},{"id":"manas-2010:p1560:b001:l024","ordinal":67214,"en":"He did not think, “I shall die,”"},{"id":"manas-2010:p1560:b001:l025","ordinal":67215,"en":"Nor fret that he was alone."},{"id":"manas-2010:p1560:b001:l026","ordinal":67216,"en":"Smiling, brave Syrgak"},{"id":"manas-2010:p1560:b001:l027","ordinal":67217,"en":"Stood there and said:"},{"id":"manas-2010:p1560:b001:l028","ordinal":67218,"en":"“My Almambet and Chubak,"},{"id":"manas-2010:p1560:b001:l029","ordinal":67219,"en":"In this time of my distress,"},{"id":"manas-2010:p1560:b001:l030","ordinal":67220,"en":"Let me see them, O my God!"},{"id":"manas-2010:p1560:b001:l031","ordinal":67221,"en":"With the Chinese pressing me,"},{"id":"manas-2010:p1560:b001:l032","ordinal":67222,"en":"When will they raise their battle cry?"},{"id":"manas-2010:p1560:b001:l033","ordinal":67223,"en":"When will the heroes arrive"},{"id":"manas-2010:p1560:b001:l034","ordinal":67224,"en":"And rescue me?” he thought."},{"id":"manas-2010:p1560:b001:l035","ordinal":67225,"en":"While he looked about in agitation,"},{"id":"manas-2010:p1560:b001:l036","ordinal":67226,"en":"With Kongurbay leading a thousand Chinese,"},{"id":"manas-2010:p1560:b001:l037","ordinal":67227,"en":"All the champions reached him,"},{"id":"manas-2010:p1560:b001:l038","ordinal":67228,"en":"All thrust their lances as they passed."},{"id":"manas-2010:p1560:b001:l039","ordinal":67229,"en":"Thundering up behind,"},{"id":"manas-2010:p1560:b001:l040","ordinal":67230,"en":"With a vast host of troops,"},{"id":"manas-2010:p1560:b001:l041","ordinal":67231,"en":"Ay Zhang-Zhung thrust his lance as he passed."},{"id":"manas-2010:p1560:b001:l042","ordinal":67232,"en":"Still Syrgak did not stir."},{"id":"manas-2010:p1561:b001:l001","ordinal":67233,"en":"The reason he did not stir:"},{"id":"manas-2010:p1561:b001:l002","ordinal":67234,"en":"His whole body was sheathed in iron,"},{"id":"manas-2010:p1561:b001:l003","ordinal":67235,"en":"All of it fastened tight;"},{"id":"manas-2010:p1561:b001:l004","ordinal":67236,"en":"His rounded face was hidden,"},{"id":"manas-2010:p1561:b001:l005","ordinal":67237,"en":"Only his two eyes gleamed."},{"id":"manas-2010:p1561:b001:l006","ordinal":67238,"en":"His helmet was fully fitted out;"},{"id":"manas-2010:p1561:b001:l007","ordinal":67239,"en":"A shield stood broad upon his arm,"},{"id":"manas-2010:p1561:b001:l008","ordinal":67240,"en":"A mirror breastplate over his heart,"},{"id":"manas-2010:p1561:b001:l009","ordinal":67241,"en":"A steel guard at his waist;"},{"id":"manas-2010:p1561:b001:l010","ordinal":67242,"en":"Upon him was blue-iron armor,"},{"id":"manas-2010:p1561:b001:l011","ordinal":67243,"en":"Which no amount of shooting pierced,"},{"id":"manas-2010:p1561:b001:l012","ordinal":67244,"en":"With double iron at his flanks."},{"id":"manas-2010:p1561:b001:l013","ordinal":67245,"en":"Not the tiniest gap remained."},{"id":"manas-2010:p1561:b001:l014","ordinal":67246,"en":"The devoted woman Kanykey"},{"id":"manas-2010:p1561:b001:l015","ordinal":67247,"en":"Had given these as gifts;"},{"id":"manas-2010:p1561:b001:l016","ordinal":67248,"en":"His horse too wore an iron covering."},{"id":"manas-2010:p1561:b001:l017","ordinal":67249,"en":"When the Chinese pressed him hard,"},{"id":"manas-2010:p1561:b001:l018","ordinal":67250,"en":"Syrgak raced on without stopping."},{"id":"manas-2010:p1561:b001:l019","ordinal":67251,"en":"Kökchebich beneath him—"},{"id":"manas-2010:p1561:b001:l020","ordinal":67252,"en":"A steed worthy of devotion—"},{"id":"manas-2010:p1561:b001:l021","ordinal":67253,"en":"Flung his forelock toward the sky,"},{"id":"manas-2010:p1561:b001:l022","ordinal":67254,"en":"Drove his hooves into the earth."},{"id":"manas-2010:p1561:b001:l023","ordinal":67255,"en":"The wind could not match his trot,"},{"id":"manas-2010:p1561:b001:l024","ordinal":67256,"en":"No beast could match his walk."},{"id":"manas-2010:p1561:b001:l025","ordinal":67257,"en":"His mouth gaped like a pit,"},{"id":"manas-2010:p1561:b001:l026","ordinal":67258,"en":"No strength could master his reins."},{"id":"manas-2010:p1561:b001:l027","ordinal":67259,"en":"He lowered his head to the ground,"},{"id":"manas-2010:p1561:b001:l028","ordinal":67260,"en":"Gathered himself like a wild sheep,"},{"id":"manas-2010:p1561:b001:l029","ordinal":67261,"en":"His back curved like a sprung trap."},{"id":"manas-2010:p1561:b001:l030","ordinal":67262,"en":"The ground beneath him shattered;"},{"id":"manas-2010:p1561:b001:l031","ordinal":67263,"en":"Stones kicked up, large as bowls,"},{"id":"manas-2010:p1561:b001:l032","ordinal":67264,"en":"Whistled above his head."},{"id":"manas-2010:p1561:b001:l033","ordinal":67265,"en":"That day Kökchebich"},{"id":"manas-2010:p1561:b001:l034","ordinal":67266,"en":"Had warmed to his running."},{"id":"manas-2010:p1561:b001:l035","ordinal":67267,"en":"Your Syrgak upon him"},{"id":"manas-2010:p1561:b001:l036","ordinal":67268,"en":"Bit his lip till blood came;"},{"id":"manas-2010:p1561:b001:l037","ordinal":67269,"en":"His great front teeth, like doors,"},{"id":"manas-2010:p1561:b001:l038","ordinal":67270,"en":"Crumbled like grains of millet."},{"id":"manas-2010:p1561:b001:l039","ordinal":67271,"en":"Whenever he drew close,"},{"id":"manas-2010:p1561:b001:l040","ordinal":67272,"en":"Unable to withstand his heat,"},{"id":"manas-2010:p1561:b001:l041","ordinal":67273,"en":"The many Chinese seeking to seize him"},{"id":"manas-2010:p1561:b001:l042","ordinal":67274,"en":"Split apart and fled."},{"id":"manas-2010:p1562:b001:l001","ordinal":67275,"en":"When he came straight before them,"},{"id":"manas-2010:p1562:b001:l002","ordinal":67276,"en":"They split clean apart, screaming."},{"id":"manas-2010:p1562:b001:l003","ordinal":67277,"en":"Alöökö's Kongurbay,"},{"id":"manas-2010:p1562:b001:l004","ordinal":67278,"en":"Like a man whose only son had died,"},{"id":"manas-2010:p1562:b001:l005","ordinal":67279,"en":"Unable to halt the Chinese,"},{"id":"manas-2010:p1562:b001:l006","ordinal":67280,"en":"Went about sobbing bitterly:"},{"id":"manas-2010:p1562:b001:l007","ordinal":67281,"en":"“People of forty khans together,"},{"id":"manas-2010:p1562:b001:l008","ordinal":67282,"en":"Chinese and Manzhuu, sink into the earth!"},{"id":"manas-2010:p1562:b001:l009","ordinal":67283,"en":"From a lone Burut, Syrgak,"},{"id":"manas-2010:p1562:b001:l010","ordinal":67284,"en":"You all take flight!"},{"id":"manas-2010:p1562:b001:l011","ordinal":67285,"en":"Hero Manas's forty companions"},{"id":"manas-2010:p1562:b001:l012","ordinal":67286,"en":"Are all like Syrgak,"},{"id":"manas-2010:p1562:b001:l013","ordinal":67287,"en":"Every one of them a lion,"},{"id":"manas-2010:p1562:b001:l014","ordinal":67288,"en":"A fierce-maned hero equal to Manas."},{"id":"manas-2010:p1562:b001:l015","ordinal":67289,"en":"Calling the Burut battle cry,"},{"id":"manas-2010:p1562:b001:l016","ordinal":67290,"en":"Shouting out the name of Manas,"},{"id":"manas-2010:p1562:b001:l017","ordinal":67291,"en":"Roaring like lions,"},{"id":"manas-2010:p1562:b001:l018","ordinal":67292,"en":"When they break into your midst,"},{"id":"manas-2010:p1562:b001:l019","ordinal":67293,"en":"Where will you go then?!"},{"id":"manas-2010:p1562:b001:l020","ordinal":67294,"en":"When the Chinese charge,"},{"id":"manas-2010:p1562:b001:l021","ordinal":67295,"en":"And Syrgak sets about slaughter,"},{"id":"manas-2010:p1562:b001:l022","ordinal":67296,"en":"When the forty companions left by Manas"},{"id":"manas-2010:p1562:b001:l023","ordinal":67297,"en":"Come rushing in,"},{"id":"manas-2010:p1562:b001:l024","ordinal":67298,"en":"Almambet and Chubak among them,"},{"id":"manas-2010:p1562:b001:l025","ordinal":67299,"en":"When those men are together,"},{"id":"manas-2010:p1562:b001:l026","ordinal":67300,"en":"What will you do then?!"},{"id":"manas-2010:p1562:b001:l027","ordinal":67301,"en":"My dear, just people,"},{"id":"manas-2010:p1562:b001:l028","ordinal":67302,"en":"Overwhelm Syrgak!"},{"id":"manas-2010:p1562:b001:l029","ordinal":67303,"en":"Why do you keep fleeing?!”"},{"id":"manas-2010:p1562:b001:l030","ordinal":67304,"en":"Thus bellowing,"},{"id":"manas-2010:p1562:b001:l031","ordinal":67305,"en":"Algara's reins"},{"id":"manas-2010:p1562:b001:l032","ordinal":67306,"en":"Were loosed by Kongurbay."},{"id":"manas-2010:p1562:b001:l033","ordinal":67307,"en":"Separating out the spearmen,"},{"id":"manas-2010:p1562:b001:l034","ordinal":67308,"en":"Kongurbay made them ready."},{"id":"manas-2010:p1562:b001:l035","ordinal":67309,"en":"The massed Manzhuu and Chinese,"},{"id":"manas-2010:p1562:b001:l036","ordinal":67310,"en":"Beating them like cattle,"},{"id":"manas-2010:p1562:b001:l037","ordinal":67311,"en":"Kongurbay drove into battle."},{"id":"manas-2010:p1562:b001:l038","ordinal":67312,"en":"Whatever he saw fit this time,"},{"id":"manas-2010:p1562:b001:l039","ordinal":67313,"en":"Kongurbay began to do;"},{"id":"manas-2010:p1562:b001:l040","ordinal":67314,"en":"Those who wavered and turned back,"},{"id":"manas-2010:p1562:b001:l041","ordinal":67315,"en":"Smashing them outright,"},{"id":"manas-2010:p1562:b001:l042","ordinal":67316,"en":"Kongurbay began to slaughter."},{"id":"manas-2010:p1563:b001:l001","ordinal":67317,"en":"Kongurbay's many Chinese,"},{"id":"manas-2010:p1563:b001:l002","ordinal":67318,"en":"Unable to endure his wrath,"},{"id":"manas-2010:p1563:b001:l003","ordinal":67319,"en":"Their brave men all roaring,"},{"id":"manas-2010:p1563:b001:l004","ordinal":67320,"en":"Their cowards screaming,"},{"id":"manas-2010:p1563:b001:l005","ordinal":67321,"en":"Their marksmen running,"},{"id":"manas-2010:p1563:b001:l006","ordinal":67322,"en":"Their archers swarming,"},{"id":"manas-2010:p1563:b001:l007","ordinal":67323,"en":"The lasso-throwing Kalmyks"},{"id":"manas-2010:p1563:b001:l008","ordinal":67324,"en":"Making their lassos ready,"},{"id":"manas-2010:p1563:b001:l009","ordinal":67325,"en":"Swordsmen at the edge,"},{"id":"manas-2010:p1563:b001:l010","ordinal":67326,"en":"Battle-axe wielders at the front,"},{"id":"manas-2010:p1563:b001:l011","ordinal":67327,"en":"Their shouts splitting the sky,"},{"id":"manas-2010:p1563:b001:l012","ordinal":67328,"en":"Their champion, the Fierce One, behind,"}]
