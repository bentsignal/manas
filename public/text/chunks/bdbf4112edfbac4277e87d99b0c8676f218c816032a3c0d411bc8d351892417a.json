[{"id":"manas-2010:p1171:b001:l029","ordinal":50945,"en":"Beijing of Kakanchyn—"},{"id":"manas-2010:p1171:b001:l030","ordinal":50946,"en":"One-eyed Great Malgun"},{"id":"manas-2010:p1171:b001:l031","ordinal":50947,"en":"Stands guard over it there."},{"id":"manas-2010:p1171:b001:l032","ordinal":50948,"en":"There, by the mottled-gray saddle and rocky ridge,"},{"id":"manas-2010:p1171:b001:l033","ordinal":50949,"en":"His cauldron is boiling."},{"id":"manas-2010:p1171:b001:l034","ordinal":50950,"en":"There on the slope, to the great plane tree,"},{"id":"manas-2010:p1171:b001:l035","ordinal":50951,"en":"His mule is tethered."},{"id":"manas-2010:p1171:b001:l036","ordinal":50952,"en":"When I cry the battle name ‘Almambet!’"},{"id":"manas-2010:p1171:b001:l037","ordinal":50953,"en":"Get to his mule!"},{"id":"manas-2010:p1171:b001:l038","ordinal":50954,"en":"If you reach it, my Syrgak,"},{"id":"manas-2010:p1171:b001:l039","ordinal":50955,"en":"Cut off the mule's head."},{"id":"manas-2010:p1171:b001:l040","ordinal":50956,"en":"Listen well to what I say:"},{"id":"manas-2010:p1171:b001:l041","ordinal":50957,"en":"‘What has become of Alake?’"},{"id":"manas-2010:p1171:b001:l042","ordinal":50958,"en":"Keep your eyes upon me."},{"id":"manas-2010:p1172:b001:l001","ordinal":50959,"en":"If you flee from the Chinese,"},{"id":"manas-2010:p1172:b001:l002","ordinal":50960,"en":"I shall know your childishness."},{"id":"manas-2010:p1172:b001:l003","ordinal":50961,"en":"If what is told is true,"},{"id":"manas-2010:p1172:b001:l004","ordinal":50962,"en":"On the coming Day of Judgment,"},{"id":"manas-2010:p1172:b001:l005","ordinal":50963,"en":"I shall make you a black donkey and ride you!"},{"id":"manas-2010:p1172:b001:l006","ordinal":50964,"en":"If I do not tell you, whom shall I tell?"},{"id":"manas-2010:p1172:b001:l007","ordinal":50965,"en":"My banner fastened to my spear,"},{"id":"manas-2010:p1172:b001:l008","ordinal":50966,"en":"From our little handful of Kyrgyz,"},{"id":"manas-2010:p1172:b001:l009","ordinal":50967,"en":"Asked for expressly from Manas,"},{"id":"manas-2010:p1172:b001:l010","ordinal":50968,"en":"You are the gift I brought with me."},{"id":"manas-2010:p1172:b001:l011","ordinal":50969,"en":"Do not hold back, Syrgak!"},{"id":"manas-2010:p1172:b001:l012","ordinal":50970,"en":"I shall fight Great Malgun."},{"id":"manas-2010:p1172:b001:l013","ordinal":50971,"en":"Do not rush away in fright;"},{"id":"manas-2010:p1172:b001:l014","ordinal":50972,"en":"Do not shrink at the sight of his size"},{"id":"manas-2010:p1172:b001:l015","ordinal":50973,"en":"And fail to strike."},{"id":"manas-2010:p1172:b001:l016","ordinal":50974,"en":"Without fear, my Syrgak,"},{"id":"manas-2010:p1172:b001:l017","ordinal":50975,"en":"Get there before an arrow could!”"},{"id":"manas-2010:p1172:b001:l018","ordinal":50976,"en":"Having heard these words,"},{"id":"manas-2010:p1172:b001:l019","ordinal":50977,"en":"The companion dear to his very life,"},{"id":"manas-2010:p1172:b001:l020","ordinal":50978,"en":"The leopard lad Syrgak"},{"id":"manas-2010:p1172:b001:l021","ordinal":50979,"en":"Readied himself, battle-axe in hand,"},{"id":"manas-2010:p1172:b001:l022","ordinal":50980,"en":"Calling upon his courage."},{"id":"manas-2010:p1172:b001:l023","ordinal":50981,"en":"He rode forward, alert."},{"id":"manas-2010:p1172:b001:l024","ordinal":50982,"en":"Your young tiger Syrgak,"},{"id":"manas-2010:p1172:b001:l025","ordinal":50983,"en":"Holding his battle-axe ready,"},{"id":"manas-2010:p1172:b001:l026","ordinal":50984,"en":"Licked his lips like a hungry wolf."},{"id":"manas-2010:p1172:b001:l027","ordinal":50985,"en":"Never taking his eyes from Malgun,"},{"id":"manas-2010:p1172:b001:l028","ordinal":50986,"en":"He stared intently;"},{"id":"manas-2010:p1172:b001:l029","ordinal":50987,"en":"His eyes became red fire."},{"id":"manas-2010:p1172:b001:l030","ordinal":50988,"en":"Almam's roaring voice"},{"id":"manas-2010:p1172:b001:l031","ordinal":50989,"en":"Seemed about to shatter everything."},{"id":"manas-2010:p1172:b001:l032","ordinal":50990,"en":"Poised to spring toward the mule,"},{"id":"manas-2010:p1172:b001:l033","ordinal":50991,"en":"He waited with desperate eagerness."},{"id":"manas-2010:p1172:b001:l034","ordinal":50992,"en":"Fortunate when he entered battle,"},{"id":"manas-2010:p1172:b001:l035","ordinal":50993,"en":"Like a whole army when he fought,"},{"id":"manas-2010:p1172:b001:l036","ordinal":50994,"en":"With golden forelock and tasselled belt,"},{"id":"manas-2010:p1172:b001:l037","ordinal":50995,"en":"Azizkhan's only son"},{"id":"manas-2010:p1172:b001:l038","ordinal":50996,"en":"Loomed like a mountain."},{"id":"manas-2010:p1172:b001:l039","ordinal":50997,"en":"He went on ahead, apart from the others."},{"id":"manas-2010:p1172:b001:l040","ordinal":50998,"en":"If you looked closely at his form,"},{"id":"manas-2010:p1172:b001:l041","ordinal":50999,"en":"With cotton sash and broad boots,"},{"id":"manas-2010:p1172:b001:l042","ordinal":51000,"en":"Kongurbay, khan of the Kalmyks—"},{"id":"manas-2010:p1173:b001:l001","ordinal":51001,"en":"He looked like that great fierce warrior."},{"id":"manas-2010:p1173:b001:l002","ordinal":51002,"en":"Jerking the soft-leather lead rope,"},{"id":"manas-2010:p1173:b001:l003","ordinal":51003,"en":"Surging forward with his racer,"},{"id":"manas-2010:p1173:b001:l004","ordinal":51004,"en":"His great boots stretched out;"},{"id":"manas-2010:p1173:b001:l005","ordinal":51005,"en":"He drew himself up, stiff and stately,"},{"id":"manas-2010:p1173:b001:l006","ordinal":51006,"en":"His neck arched like a rooster's,"},{"id":"manas-2010:p1173:b001:l007","ordinal":51007,"en":"His sword clanging at his waist."},{"id":"manas-2010:p1173:b001:l008","ordinal":51008,"en":"As though he were the khan of the Chinese,"},{"id":"manas-2010:p1173:b001:l009","ordinal":51009,"en":"He rode on, stiff and proud."},{"id":"manas-2010:p1173:b001:l010","ordinal":51010,"en":"When he drew near the monks,"},{"id":"manas-2010:p1173:b001:l011","ordinal":51011,"en":"Your Almam's appearance"},{"id":"manas-2010:p1173:b001:l012","ordinal":51012,"en":"Was just like Kongurbay's."},{"id":"manas-2010:p1173:b001:l013","ordinal":51013,"en":"A great pipe, its bowl like a hearth fire,"},{"id":"manas-2010:p1173:b001:l014","ordinal":51014,"en":"He pulled from his belt."},{"id":"manas-2010:p1173:b001:l015","ordinal":51015,"en":"Tobacco from his pouch"},{"id":"manas-2010:p1173:b001:l016","ordinal":51016,"en":"He put in, five handfuls."},{"id":"manas-2010:p1173:b001:l017","ordinal":51017,"en":"Your champion's pipe"},{"id":"manas-2010:p1173:b001:l018","ordinal":51018,"en":"Still lacked five fingerbreadths of being full."},{"id":"manas-2010:p1173:b001:l019","ordinal":51019,"en":"With Chinese fire-steel and striking stone,"},{"id":"manas-2010:p1173:b001:l020","ordinal":51020,"en":"He struck and set an ember alight."},{"id":"manas-2010:p1173:b001:l021","ordinal":51021,"en":"Kongurbay's lacquered pipe"},{"id":"manas-2010:p1173:b001:l022","ordinal":51022,"en":"Gurgled when he drew upon it."},{"id":"manas-2010:p1173:b001:l023","ordinal":51023,"en":"When he let out its smoke,"},{"id":"manas-2010:p1173:b001:l024","ordinal":51024,"en":"It twisted like a sleeve"},{"id":"manas-2010:p1173:b001:l025","ordinal":51025,"en":"And billowed above his head."},{"id":"manas-2010:p1173:b001:l026","ordinal":51026,"en":"When they saw this,"},{"id":"manas-2010:p1173:b001:l027","ordinal":51027,"en":"‘It is the fierce Kongurbay!’ they said."},{"id":"manas-2010:p1173:b001:l028","ordinal":51028,"en":"The forty monks at the watchpost"},{"id":"manas-2010:p1173:b001:l029","ordinal":51029,"en":"Stood looking, calling out."},{"id":"manas-2010:p1173:b001:l030","ordinal":51030,"en":"When he came close,"},{"id":"manas-2010:p1173:b001:l031","ordinal":51031,"en":"He took the lacquered spear in hand,"},{"id":"manas-2010:p1173:b001:l032","ordinal":51032,"en":"Like the fierce Kongurbay,"},{"id":"manas-2010:p1173:b001:l033","ordinal":51033,"en":"His very image, stiff and stately."},{"id":"manas-2010:p1173:b001:l034","ordinal":51034,"en":"A coral stone the size of a leather flask"},{"id":"manas-2010:p1173:b001:l035","ordinal":51035,"en":"Glittered upon his crown."},{"id":"manas-2010:p1173:b001:l036","ordinal":51036,"en":"Flame poured from his mouth."},{"id":"manas-2010:p1173:b001:l037","ordinal":51037,"en":"The watching monks,"},{"id":"manas-2010:p1173:b001:l038","ordinal":51038,"en":"Seeing him, had their attention drawn."},{"id":"manas-2010:p1173:b001:l039","ordinal":51039,"en":"Among the countless Chinese people,"},{"id":"manas-2010:p1173:b001:l040","ordinal":51040,"en":"A khan named Kongurbay had arisen,"},{"id":"manas-2010:p1173:b001:l041","ordinal":51041,"en":"Whose voice could take one's life:"},{"id":"manas-2010:p1173:b001:l042","ordinal":51042,"en":"He roared in fury,"},{"id":"manas-2010:p1174:b001:l001","ordinal":51043,"en":"He called the forty monks:"},{"id":"manas-2010:p1174:b001:l002","ordinal":51044,"en":"“Because of your ignorance,"},{"id":"manas-2010:p1174:b001:l003","ordinal":51045,"en":"Because of you forty monks,"},{"id":"manas-2010:p1174:b001:l004","ordinal":51046,"en":"I rode far and wide,"},{"id":"manas-2010:p1174:b001:l005","ordinal":51047,"en":"Among the distant Kyrgyz,"},{"id":"manas-2010:p1174:b001:l006","ordinal":51048,"en":"Scouting and exploring their roads."},{"id":"manas-2010:p1174:b001:l007","ordinal":51049,"en":"I have looked, forty monks:"},{"id":"manas-2010:p1174:b001:l008","ordinal":51050,"en":"There is no ship upon the dark water,"},{"id":"manas-2010:p1174:b001:l009","ordinal":51051,"en":"No one to stand against you."},{"id":"manas-2010:p1174:b001:l010","ordinal":51052,"en":"Built and made securely strong,"},{"id":"manas-2010:p1174:b001:l011","ordinal":51053,"en":"There is no city besides Beijing."},{"id":"manas-2010:p1174:b001:l012","ordinal":51054,"en":"While I, your champion, live,"},{"id":"manas-2010:p1174:b001:l013","ordinal":51055,"en":"No disaster threatens you forty monks!"},{"id":"manas-2010:p1174:b001:l014","ordinal":51056,"en":"No city is greater than Beijing."},{"id":"manas-2010:p1174:b001:l015","ordinal":51057,"en":"Unless natural death comes,"},{"id":"manas-2010:p1174:b001:l016","ordinal":51058,"en":"Nothing can be done against you forty monks."},{"id":"manas-2010:p1174:b001:l017","ordinal":51059,"en":"Think, forty monks:"},{"id":"manas-2010:p1174:b001:l018","ordinal":51060,"en":"I have a ridge securely held,"},{"id":"manas-2010:p1174:b001:l019","ordinal":51061,"en":"A place on which I can rely."},{"id":"manas-2010:p1174:b001:l020","ordinal":51062,"en":"Take heed, forty monks:"},{"id":"manas-2010:p1174:b001:l021","ordinal":51063,"en":"My fox lies upon its ridge;"},{"id":"manas-2010:p1174:b001:l022","ordinal":51064,"en":"My gray wild ram lies there—do you see?—"},{"id":"manas-2010:p1174:b001:l023","ordinal":51065,"en":"At its watching post!"},{"id":"manas-2010:p1174:b001:l024","ordinal":51066,"en":"My duck lies upon its lake,"},{"id":"manas-2010:p1174:b001:l025","ordinal":51067,"en":"Securely entrenched as in a fortress."},{"id":"manas-2010:p1174:b001:l026","ordinal":51068,"en":"Come here, forty monks;"},{"id":"manas-2010:p1174:b001:l027","ordinal":51069,"en":"I shall tell you this:"},{"id":"manas-2010:p1174:b001:l028","ordinal":51070,"en":"Unless my precious head should perish,"},{"id":"manas-2010:p1174:b001:l029","ordinal":51071,"en":"I shall make each of you, in different places,"},{"id":"manas-2010:p1174:b001:l030","ordinal":51072,"en":"A lord who never leaves his throne."},{"id":"manas-2010:p1174:b001:l031","ordinal":51073,"en":"Your unending grievance"},{"id":"manas-2010:p1174:b001:l032","ordinal":51074,"en":"Is that, guarding the frontier,"},{"id":"manas-2010:p1174:b001:l033","ordinal":51075,"en":"You have never taken wives."},{"id":"manas-2010:p1174:b001:l034","ordinal":51076,"en":"If I do not send word to Beijing,"},{"id":"manas-2010:p1174:b001:l035","ordinal":51077,"en":"To Karykan in Beijing,"},{"id":"manas-2010:p1174:b001:l036","ordinal":51078,"en":"And ask him for forty maidens,"},{"id":"manas-2010:p1174:b001:l037","ordinal":51079,"en":"If I do not gather the lamas"},{"id":"manas-2010:p1174:b001:l038","ordinal":51080,"en":"And have your marriages solemnized!"},{"id":"manas-2010:p1174:b001:l039","ordinal":51081,"en":"If he will not heed my words,"},{"id":"manas-2010:p1174:b001:l040","ordinal":51082,"en":"If he will not grant my request,"},{"id":"manas-2010:p1174:b001:l041","ordinal":51083,"en":"Unless I die when my time comes,"},{"id":"manas-2010:p1174:b001:l042","ordinal":51084,"en":"For your sake, forty monks,"},{"id":"manas-2010:p1175:b001:l001","ordinal":51085,"en":"If I do not divide the six khans’ people!"},{"id":"manas-2010:p1175:b001:l002","ordinal":51086,"en":"If he will not give them fairly,"},{"id":"manas-2010:p1175:b001:l003","ordinal":51087,"en":"I shall break through by force:"},{"id":"manas-2010:p1175:b001:l004","ordinal":51088,"en":"If I do not seize their daughters,"},{"id":"manas-2010:p1175:b001:l005","ordinal":51089,"en":"For your sake, forty monks,"},{"id":"manas-2010:p1175:b001:l006","ordinal":51090,"en":"If I do not stir up real excitement!”"},{"id":"manas-2010:p1175:b001:l007","ordinal":51091,"en":"Hearing this, the forty monks"},{"id":"manas-2010:p1175:b001:l008","ordinal":51092,"en":"Flung their battle-axes aside."},{"id":"manas-2010:p1175:b001:l009","ordinal":51093,"en":"They all came forward sobbing,"},{"id":"manas-2010:p1175:b001:l010","ordinal":51094,"en":"Their knees bent to the ground,"},{"id":"manas-2010:p1175:b001:l011","ordinal":51095,"en":"Bowing and worshipping in Chinese fashion."},{"id":"manas-2010:p1175:b001:l012","ordinal":51096,"en":"Before Almambet"},{"id":"manas-2010:p1175:b001:l013","ordinal":51097,"en":"They paid homage, crying out."},{"id":"manas-2010:p1175:b001:l014","ordinal":51098,"en":"The forty monks’ khan, Great Malgun,"},{"id":"manas-2010:p1175:b001:l015","ordinal":51099,"en":"Stood swaying, without advancing,"},{"id":"manas-2010:p1175:b001:l016","ordinal":51100,"en":"Astonished at Almambet."},{"id":"manas-2010:p1175:b001:l017","ordinal":51101,"en":"Coughing in great heavy bursts,"},{"id":"manas-2010:p1175:b001:l018","ordinal":51102,"en":"His great axe, as big as a travel tent,"},{"id":"manas-2010:p1175:b001:l019","ordinal":51103,"en":"He lifted onto his back."},{"id":"manas-2010:p1175:b001:l020","ordinal":51104,"en":"Great Malgun had grown a giant;"},{"id":"manas-2010:p1175:b001:l021","ordinal":51105,"en":"His voice could drive the soul out."},{"id":"manas-2010:p1175:b001:l022","ordinal":51106,"en":"They had fortified his dwelling,"},{"id":"manas-2010:p1175:b001:l023","ordinal":51107,"en":"Making a lattice of dark iron."},{"id":"manas-2010:p1175:b001:l024","ordinal":51108,"en":"From the city of giants and spirits"},{"id":"manas-2010:p1175:b001:l025","ordinal":51109,"en":"They had brought him and taught him,"},{"id":"manas-2010:p1175:b001:l026","ordinal":51110,"en":"Making him learn human speech,"},{"id":"manas-2010:p1175:b001:l027","ordinal":51111,"en":"Appointing him to the chief watchpost,"},{"id":"manas-2010:p1175:b001:l028","ordinal":51112,"en":"Making him supreme among its guards."},{"id":"manas-2010:p1175:b001:l029","ordinal":51113,"en":"An iron coat no bullet could pierce"},{"id":"manas-2010:p1175:b001:l030","ordinal":51114,"en":"Great Malgun stood wearing."},{"id":"manas-2010:p1175:b001:l031","ordinal":51115,"en":"“Cloudy by day, clear by night:"},{"id":"manas-2010:p1175:b001:l032","ordinal":51116,"en":"The weather’s character has changed."},{"id":"manas-2010:p1175:b001:l033","ordinal":51117,"en":"Patchy snow and driving sleet—"},{"id":"manas-2010:p1175:b001:l034","ordinal":51118,"en":"It looks like Almambet’s weather magic."},{"id":"manas-2010:p1175:b001:l035","ordinal":51119,"en":"The people of forty khans assembled,"},{"id":"manas-2010:p1175:b001:l036","ordinal":51120,"en":"Holding a feast with games and entertainment."},{"id":"manas-2010:p1175:b001:l037","ordinal":51121,"en":"They sent word to the people;"},{"id":"manas-2010:p1175:b001:l038","ordinal":51122,"en":"The news reached Beijing,"},{"id":"manas-2010:p1175:b001:l039","ordinal":51123,"en":"And Kongurbay went away."},{"id":"manas-2010:p1175:b001:l040","ordinal":51124,"en":"To carry his loaded provisions,"},{"id":"manas-2010:p1175:b001:l041","ordinal":51125,"en":"There were quite a number of elephants."},{"id":"manas-2010:p1175:b001:l042","ordinal":51126,"en":"Since the fierce one left for Beijing,"},{"id":"manas-2010:p1176:b001:l001","ordinal":51127,"en":"It has been exactly twelve days.”"},{"id":"manas-2010:p1176:b001:l002","ordinal":51128,"en":"What this man was saying"},{"id":"manas-2010:p1176:b001:l003","ordinal":51129,"en":"Was certainly not the truth;"},{"id":"manas-2010:p1176:b001:l004","ordinal":51130,"en":"Returning from True Beijing,"},{"id":"manas-2010:p1176:b001:l005","ordinal":51131,"en":"Kongurbay was not due to arrive."},{"id":"manas-2010:p1176:b001:l006","ordinal":51132,"en":"Great Malgun made ready."},{"id":"manas-2010:p1176:b001:l007","ordinal":51133,"en":"When Almambet saw Malgun,"},{"id":"manas-2010:p1176:b001:l008","ordinal":51134,"en":"He took sharp steel in his hand"},{"id":"manas-2010:p1176:b001:l009","ordinal":51135,"en":"And entered battle then,"},{"id":"manas-2010:p1176:b001:l010","ordinal":51136,"en":"Attacking the forty monks."},{"id":"manas-2010:p1176:b001:l011","ordinal":51137,"en":"Back and forth Almambet"},{"id":"manas-2010:p1176:b001:l012","ordinal":51138,"en":"Sported for a little while."},{"id":"manas-2010:p1176:b001:l013","ordinal":51139,"en":"As he sported, ten men died;"},{"id":"manas-2010:p1176:b001:l014","ordinal":51140,"en":"He charged in once again,"},{"id":"manas-2010:p1176:b001:l015","ordinal":51141,"en":"And half died where he entered."},{"id":"manas-2010:p1176:b001:l016","ordinal":51142,"en":"He poised himself like a darting snake;"},{"id":"manas-2010:p1176:b001:l017","ordinal":51143,"en":"When Almambet poised to strike,"},{"id":"manas-2010:p1176:b001:l018","ordinal":51144,"en":"All forty monks were destroyed."},{"id":"manas-2010:p1176:b001:l019","ordinal":51145,"en":"“I have killed all forty,” he said;"},{"id":"manas-2010:p1176:b001:l020","ordinal":51146,"en":"How could your champion stop there?"},{"id":"manas-2010:p1176:b001:l021","ordinal":51147,"en":"Extending his lacquered spear with a creak,"},{"id":"manas-2010:p1176:b001:l022","ordinal":51148,"en":"Drawing and raising his sword,"},{"id":"manas-2010:p1176:b001:l023","ordinal":51149,"en":"He headed straight for Malgun."},{"id":"manas-2010:p1176:b001:l024","ordinal":51150,"en":"Great Malgun, born full of cunning,"},{"id":"manas-2010:p1176:b001:l025","ordinal":51151,"en":"Hurried, flailing his great limbs."},{"id":"manas-2010:p1176:b001:l026","ordinal":51152,"en":"The one-eyed giant tried to reach"},{"id":"manas-2010:p1176:b001:l027","ordinal":51153,"en":"His great mule, lumbering along."},{"id":"manas-2010:p1176:b001:l028","ordinal":51154,"en":"Before he could reach his mule,"},{"id":"manas-2010:p1176:b001:l029","ordinal":51155,"en":"That keen edge of dark steel,"},{"id":"manas-2010:p1176:b001:l030","ordinal":51156,"en":"Hearing Almambet’s voice,"},{"id":"manas-2010:p1176:b001:l031","ordinal":51157,"en":"Charged straight ahead:"},{"id":"manas-2010:p1176:b001:l032","ordinal":51158,"en":"Dear young Syrgak."},{"id":"manas-2010:p1176:b001:l033","ordinal":51159,"en":"“Before that wretched blind one mounts,"},{"id":"manas-2010:p1176:b001:l034","ordinal":51160,"en":"Let me reach his mule!”"},{"id":"manas-2010:p1176:b001:l035","ordinal":51161,"en":"Without looking all around,"},{"id":"manas-2010:p1176:b001:l036","ordinal":51162,"en":"The warrior Syrgak reached him,"},{"id":"manas-2010:p1176:b001:l037","ordinal":51163,"en":"Sparing not his ocean-vast life."},{"id":"manas-2010:p1176:b001:l038","ordinal":51164,"en":"Beneath him was Kokchebich;"},{"id":"manas-2010:p1176:b001:l039","ordinal":51165,"en":"Your winged battle steed"},{"id":"manas-2010:p1176:b001:l040","ordinal":51166,"en":"Arrived ahead of an arrow."},{"id":"manas-2010:p1176:b001:l041","ordinal":51167,"en":"With Narkesken in his hand,"},{"id":"manas-2010:p1176:b001:l042","ordinal":51168,"en":"Your champion Syrgak reached him,"},{"id":"manas-2010:p1177:b001:l001","ordinal":51169,"en":"He struck its neck as he passed."},{"id":"manas-2010:p1177:b001:l002","ordinal":51170,"en":"That dog Malgun's gray mule—"},{"id":"manas-2010:p1177:b001:l003","ordinal":51171,"en":"Its head tore off with a crack."},{"id":"manas-2010:p1177:b001:l004","ordinal":51172,"en":"As though a mountain had collapsed,"},{"id":"manas-2010:p1177:b001:l005","ordinal":51173,"en":"It fell with a thundering crash."},{"id":"manas-2010:p1177:b001:l006","ordinal":51174,"en":"He was deprived of his wings:"},{"id":"manas-2010:p1177:b001:l007","ordinal":51175,"en":"Great Malgun with his single eye"},{"id":"manas-2010:p1177:b001:l008","ordinal":51176,"en":"Lost his gray mule."},{"id":"manas-2010:p1177:b001:l009","ordinal":51177,"en":"Raging, Great Malgun"},{"id":"manas-2010:p1177:b001:l010","ordinal":51178,"en":"Let out one roar."},{"id":"manas-2010:p1177:b001:l011","ordinal":51179,"en":"With the booming of his shout,"},{"id":"manas-2010:p1177:b001:l012","ordinal":51180,"en":"The mountain rang with echoes."},{"id":"manas-2010:p1177:b001:l013","ordinal":51181,"en":"Raging and coughing,"},{"id":"manas-2010:p1177:b001:l014","ordinal":51182,"en":"An axe as big as a herder's shelter"},{"id":"manas-2010:p1177:b001:l015","ordinal":51183,"en":"He lifted onto his shoulder."},{"id":"manas-2010:p1177:b001:l016","ordinal":51184,"en":"The giant Great Malgun spoke:"},{"id":"manas-2010:p1177:b001:l017","ordinal":51185,"en":"'Let me twist and wring their necks,"},{"id":"manas-2010:p1177:b001:l018","ordinal":51186,"en":"Let me slaughter them, sparing none."},{"id":"manas-2010:p1177:b001:l019","ordinal":51187,"en":"If Almambet should appear,"},{"id":"manas-2010:p1177:b001:l020","ordinal":51188,"en":"Let me seize him."},{"id":"manas-2010:p1177:b001:l021","ordinal":51189,"en":"That fugitive who fled away—"},{"id":"manas-2010:p1177:b001:l022","ordinal":51190,"en":"Let me cut off his head."},{"id":"manas-2010:p1177:b001:l023","ordinal":51191,"en":"Karykan in Beijing,"},{"id":"manas-2010:p1177:b001:l024","ordinal":51192,"en":"Before Karykan,"},{"id":"manas-2010:p1177:b001:l025","ordinal":51193,"en":"“Here is Almambet's head,” I shall say,"},{"id":"manas-2010:p1177:b001:l026","ordinal":51194,"en":"And take it as tribute!"},{"id":"manas-2010:p1177:b001:l027","ordinal":51195,"en":"If he grants me Outer Beijing,"},{"id":"manas-2010:p1177:b001:l028","ordinal":51196,"en":"Let me take its khanship.'"},{"id":"manas-2010:p1177:b001:l029","ordinal":51197,"en":"Great Malgun thought this."},{"id":"manas-2010:p1177:b001:l030","ordinal":51198,"en":"His size was half a mountain,"},{"id":"manas-2010:p1177:b001:l031","ordinal":51199,"en":"His nose like a mountain spur,"},{"id":"manas-2010:p1177:b001:l032","ordinal":51200,"en":"His eye like a hollow holding a lake,"}]
