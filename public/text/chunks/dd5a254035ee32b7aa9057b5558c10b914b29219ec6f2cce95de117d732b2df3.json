[{"id":"semetey-2-2013:p1041:b005:l011","ordinal":266753,"en":"Plump and sleek as a white swan,"},{"id":"semetey-2-2013:p1041:b005:l012","ordinal":266754,"en":"My poor noble sister"},{"id":"semetey-2-2013:p1041:b005:l013","ordinal":266755,"en":"Possessed such great honor."},{"id":"semetey-2-2013:p1041:b005:l014","ordinal":266756,"en":"Known to every listening ear and seeing eye,"},{"id":"semetey-2-2013:p1041:b005:l015","ordinal":266757,"en":"Her fame spread across the earth;"},{"id":"semetey-2-2013:p1041:b005:l016","ordinal":266758,"en":"She was a woman of sacred power."},{"id":"semetey-2-2013:p1041:b005:l017","ordinal":266759,"en":"From her husband, gray-maned Köksö,"},{"id":"semetey-2-2013:p1041:b005:l018","ordinal":266760,"en":"She received as a gift"},{"id":"semetey-2-2013:p1041:b005:l019","ordinal":266761,"en":"That valiant son."},{"id":"semetey-2-2013:p1041:b005:l020","ordinal":266762,"en":"That woman Akerkech,"},{"id":"semetey-2-2013:p1041:b005:l021","ordinal":266763,"en":"That radiant forceful soul,"},{"id":"semetey-2-2013:p1041:b005:l022","ordinal":266764,"en":"Had a guardian spirit supporting her."},{"id":"semetey-2-2013:p1041:b005:l023","ordinal":266765,"en":"She made her son"},{"id":"semetey-2-2013:p1041:b005:l024","ordinal":266766,"en":"Her refuge in Köksö’s place."},{"id":"semetey-2-2013:p1041:b005:l025","ordinal":266767,"en":"Köksö had no many sons;"},{"id":"semetey-2-2013:p1041:b005:l026","ordinal":266768,"en":"Ümötöy was his only child."},{"id":"semetey-2-2013:p1041:b005:l027","ordinal":266769,"en":"Akerkech, who bore Ümötöy,"},{"id":"semetey-2-2013:p1041:b005:l028","ordinal":266770,"en":"Was a woman of sacred power."},{"id":"semetey-2-2013:p1041:b005:l029","ordinal":266771,"en":"My dear, formidable sister"},{"id":"semetey-2-2013:p1041:b005:l030","ordinal":266772,"en":"Had a mole upon her lip;"},{"id":"semetey-2-2013:p1041:b005:l031","ordinal":266773,"en":"Her simplest word could bring misfortune,"},{"id":"semetey-2-2013:p1041:b005:l032","ordinal":266774,"en":"For there was a seal upon her tongue."},{"id":"semetey-2-2013:p1041:b005:l033","ordinal":266775,"en":"Her curse never missed its mark,"},{"id":"semetey-2-2013:p1041:b005:l034","ordinal":266776,"en":"Her malediction never fell in vain;"},{"id":"semetey-2-2013:p1041:b005:l035","ordinal":266777,"en":"None prospered when she spoke against them,"},{"id":"semetey-2-2013:p1041:b005:l036","ordinal":266778,"en":"And her curse never failed."},{"id":"semetey-2-2013:p1041:b005:l037","ordinal":266779,"en":"Such a lady was his mother,"},{"id":"semetey-2-2013:p1041:b005:l038","ordinal":266780,"en":"And terrible indeed was her curse."},{"id":"semetey-2-2013:p1041:b005:l039","ordinal":266781,"en":"There was a beauty mark upon her lip."},{"id":"semetey-2-2013:p1042:b003:l001","ordinal":266782,"en":"No one she fixed her gaze upon remained unharmed;"},{"id":"semetey-2-2013:p1042:b003:l002","ordinal":266783,"en":"That woman of invincible wishes"},{"id":"semetey-2-2013:p1042:b003:l003","ordinal":266784,"en":"Had a seal upon her tongue."},{"id":"semetey-2-2013:p1042:b003:l004","ordinal":266785,"en":"May God take Ümötöy—"},{"id":"semetey-2-2013:p1042:b003:l005","ordinal":266786,"en":"It is his mother I fear!”"},{"id":"semetey-2-2013:p1042:b003:l006","ordinal":266787,"en":"So Kanykey"},{"id":"semetey-2-2013:p1042:b003:l007","ordinal":266788,"en":"Spoke amid the turmoil,"},{"id":"semetey-2-2013:p1042:b003:l008","ordinal":266789,"en":"Amid merciless great distress"},{"id":"semetey-2-2013:p1042:b003:l009","ordinal":266790,"en":"And clamor."},{"id":"semetey-2-2013:p1042:b003:l010","ordinal":266791,"en":"She urged stubborn Semetey"},{"id":"semetey-2-2013:p1042:b003:l011","ordinal":266792,"en":"To make peace."},{"id":"semetey-2-2013:p1042:b003:l012","ordinal":266793,"en":"She urged Ümötöy and Semetey"},{"id":"semetey-2-2013:p1042:b003:l013","ordinal":266794,"en":"To shine upon each other"},{"id":"semetey-2-2013:p1042:b003:l014","ordinal":266795,"en":"Like mist-veiled stars in heaven,"},{"id":"semetey-2-2013:p1042:b003:l015","ordinal":266796,"en":"To bind themselves for eternity"},{"id":"semetey-2-2013:p1042:b003:l016","ordinal":266797,"en":"And become friends."},{"id":"semetey-2-2013:p1042:b003:l017","ordinal":266798,"en":"But then Semetey,"},{"id":"semetey-2-2013:p1042:b003:l018","ordinal":266799,"en":"Without saying yes or no"},{"id":"semetey-2-2013:p1042:b003:l019","ordinal":266800,"en":"To Khan Bakay and Kanykey,"},{"id":"semetey-2-2013:p1042:b003:l020","ordinal":266801,"en":"Refusing to heed their words,"},{"id":"semetey-2-2013:p1042:b003:l021","ordinal":266802,"en":"Giving no open answer,"},{"id":"semetey-2-2013:p1042:b003:l022","ordinal":266803,"en":"Grew furious and scowled,"},{"id":"semetey-2-2013:p1042:b003:l023","ordinal":266804,"en":"His eyes flashing wide."},{"id":"semetey-2-2013:p1042:b003:l024","ordinal":266805,"en":"When he thought of Ümötöy,"},{"id":"semetey-2-2013:p1042:b003:l025","ordinal":266806,"en":"His thirst for blood seized him."},{"id":"semetey-2-2013:p1042:b003:l026","ordinal":266807,"en":"To the grave with this world!"},{"id":"semetey-2-2013:p1042:b003:l027","ordinal":266808,"en":"Whenever one foe is destroyed,"},{"id":"semetey-2-2013:p1042:b003:l028","ordinal":266809,"en":"Another rises from our own village,"},{"id":"semetey-2-2013:p1042:b003:l029","ordinal":266810,"en":"And our troubles multiply daily."},{"id":"semetey-2-2013:p1042:b003:l030","ordinal":266811,"en":"Ümötöy, son of Köksö,"},{"id":"semetey-2-2013:p1042:b003:l031","ordinal":266812,"en":"Now we have seen what you are."},{"id":"semetey-2-2013:p1042:b003:l032","ordinal":266813,"en":"Is quarrelsomeness what he loves most?"},{"id":"semetey-2-2013:p1042:b003:l033","ordinal":266814,"en":"How can we offer words of conciliation?"},{"id":"semetey-2-2013:p1042:b003:l034","ordinal":266815,"en":"Let us beat the madness out of him this time;"},{"id":"semetey-2-2013:p1042:b003:l035","ordinal":266816,"en":"If he rages and scowls like that,"},{"id":"semetey-2-2013:p1042:b003:l036","ordinal":266817,"en":"Let us find a way to settle"},{"id":"semetey-2-2013:p1042:b003:l037","ordinal":266818,"en":"With this ill-starred scoundrel."},{"id":"semetey-2-2013:p1042:b003:l038","ordinal":266819,"en":"If that Kazakh loves conflict so much,"},{"id":"semetey-2-2013:p1042:b003:l039","ordinal":266820,"en":"Let us strike him with every man at once."},{"id":"semetey-2-2013:p1042:b004:l001","ordinal":266821,"en":"Always, my mother,"},{"id":"semetey-2-2013:p1042:b004:l002","ordinal":266822,"en":"Ah, my dear lady,"},{"id":"semetey-2-2013:p1042:b004:l003","ordinal":266823,"en":"Wanting her kin to live without fighting,"},{"id":"semetey-2-2013:p1042:b004:l004","ordinal":266824,"en":"Will take their side."},{"id":"semetey-2-2013:p1042:b004:l005","ordinal":266825,"en":"Her blood relations and kinsmen—"},{"id":"semetey-2-2013:p1042:b004:l006","ordinal":266826,"en":"She keeps saying how worthy they are"},{"id":"semetey-2-2013:p1042:b004:l007","ordinal":266827,"en":"And praising them."},{"id":"semetey-2-2013:p1042:b004:l008","ordinal":266828,"en":"He drew back the blood-drinking Choro,"},{"id":"semetey-2-2013:p1042:b004:l009","ordinal":266829,"en":"Turned again toward him,"},{"id":"semetey-2-2013:p1042:b004:l010","ordinal":266830,"en":"Bit his lip and narrowed his eyes,"},{"id":"semetey-2-2013:p1042:b004:l011","ordinal":266831,"en":"And somehow led Choro outside."},{"id":"semetey-2-2013:p1042:b004:l012","ordinal":266832,"en":"Külchoro flew like an arrow,"},{"id":"semetey-2-2013:p1042:b004:l013","ordinal":266833,"en":"Dashing forward in haste,"},{"id":"semetey-2-2013:p1042:b004:l014","ordinal":266834,"en":"Springing and bounding like a roe deer,"},{"id":"semetey-2-2013:p1042:b004:l015","ordinal":266835,"en":"The agile, lion-hearted Choro—"},{"id":"semetey-2-2013:p1042:b004:l016","ordinal":266836,"en":"Matchless in valor,"},{"id":"semetey-2-2013:p1042:b004:l017","ordinal":266837,"en":"The swift, white-browed warrior Choro—"},{"id":"semetey-2-2013:p1042:b004:l018","ordinal":266838,"en":"Ran fleetly and reached him."},{"id":"semetey-2-2013:p1042:b004:l019","ordinal":266839,"en":"Semetey and Külchoro,"},{"id":"semetey-2-2013:p1042:b004:l020","ordinal":266840,"en":"Letting no one overhear"},{"id":"semetey-2-2013:p1042:b004:l021","ordinal":266841,"en":"And no person learn of it,"},{"id":"semetey-2-2013:p1042:b004:l022","ordinal":266842,"en":"Spoke together in whispers."},{"id":"semetey-2-2013:p1042:b004:l023","ordinal":266843,"en":"Semetey told Külchoro this,"},{"id":"semetey-2-2013:p1042:b004:l024","ordinal":266844,"en":"Standing there with a smile."},{"id":"semetey-2-2013:p1042:b004:l025","ordinal":266845,"en":"“Slaughter that Kazakh dog,”"},{"id":"semetey-2-2013:p1042:b004:l026","ordinal":266846,"en":"“Put him to death,”"},{"id":"semetey-2-2013:p1042:b004:l027","ordinal":266847,"en":"Semetey urged him on."},{"id":"semetey-2-2013:p1042:b004:l028","ordinal":266848,"en":"“Do not let him recoil even from stone,”"},{"id":"semetey-2-2013:p1042:b004:l029","ordinal":266849,"en":"Semetey incited him."},{"id":"semetey-2-2013:p1042:b004:l030","ordinal":266850,"en":"“To the grave with it, my lion Choro,"},{"id":"semetey-2-2013:p1042:b004:l031","ordinal":266851,"en":"Your strength can master the world."},{"id":"semetey-2-2013:p1042:b004:l032","ordinal":266852,"en":"If Ümötöy, son of Köksö,"},{"id":"semetey-2-2013:p1042:b004:l033","ordinal":266853,"en":"Will not listen to reason,"},{"id":"semetey-2-2013:p1042:b004:l034","ordinal":266854,"en":"Crush him and bring me his head;"},{"id":"semetey-2-2013:p1042:b004:l035","ordinal":266855,"en":"Cleave your way through his Daңгыт warriors,"},{"id":"semetey-2-2013:p1042:b004:l036","ordinal":266856,"en":"And return utterly sated with blood."},{"id":"semetey-2-2013:p1042:b004:l037","ordinal":266857,"en":"His heeled boots and leather trousers—"},{"id":"semetey-2-2013:p1042:b004:l038","ordinal":266858,"en":"Bring them back as spoils!"},{"id":"semetey-2-2013:p1042:b004:l039","ordinal":266859,"en":"But alas, my poor mother—”"},{"id":"semetey-2-2013:p1043:b003:l001","ordinal":266860,"en":"Of all the people born to me,"},{"id":"semetey-2-2013:p1043:b003:l002","ordinal":266861,"en":"My wretched mother comes out before them,"},{"id":"semetey-2-2013:p1043:b003:l003","ordinal":266862,"en":"Saying, “Her holy patron is the Messiah,”"},{"id":"semetey-2-2013:p1043:b003:l004","ordinal":266863,"en":"My wretched mother simply comes out to meet me."},{"id":"semetey-2-2013:p1043:b003:l005","ordinal":266864,"en":"A khan’s wife is his wing;"},{"id":"semetey-2-2013:p1043:b003:l006","ordinal":266865,"en":"From time to time,"},{"id":"semetey-2-2013:p1043:b003:l007","ordinal":266866,"en":"It has ever been my unfortunate noble mother’s"},{"id":"semetey-2-2013:p1043:b003:l008","ordinal":266867,"en":"Custom to perform such rites."},{"id":"semetey-2-2013:p1043:b003:l009","ordinal":266868,"en":"Father, companion, hear my words;"},{"id":"semetey-2-2013:p1043:b003:l010","ordinal":266869,"en":"Oil your bright steel."},{"id":"semetey-2-2013:p1043:b003:l011","ordinal":266870,"en":"Do not truly provoke my wrath:"},{"id":"semetey-2-2013:p1043:b003:l012","ordinal":266871,"en":"When he roused my enmity,"},{"id":"semetey-2-2013:p1043:b003:l013","ordinal":266872,"en":"Though he was my own uncle,"},{"id":"semetey-2-2013:p1043:b003:l014","ordinal":266873,"en":"I laid Abyke low."},{"id":"semetey-2-2013:p1043:b003:l015","ordinal":266874,"en":"And did I die?"},{"id":"semetey-2-2013:p1043:b003:l016","ordinal":266875,"en":"Did retribution overtake me?"},{"id":"semetey-2-2013:p1043:b003:l017","ordinal":266876,"en":"Did it strike me through the ribs,"},{"id":"semetey-2-2013:p1043:b003:l018","ordinal":266877,"en":"Or make itself felt within my lungs?"},{"id":"semetey-2-2013:p1043:b003:l019","ordinal":266878,"en":"Has Semetey died from it even now?"},{"id":"semetey-2-2013:p1043:b003:l020","ordinal":266879,"en":"Scorching everyone who crossed my path,"},{"id":"semetey-2-2013:p1043:b003:l021","ordinal":266880,"en":"Making your fierce valor known,"},{"id":"semetey-2-2013:p1043:b003:l022","ordinal":266881,"en":"When Köbösh greatly enraged me,"},{"id":"semetey-2-2013:p1043:b003:l023","ordinal":266882,"en":"I sent him to the grave."},{"id":"semetey-2-2013:p1043:b003:l024","ordinal":266883,"en":"And did retribution overtake me?"},{"id":"semetey-2-2013:p1043:b003:l025","ordinal":266884,"en":"Did I close my eyes and stretch out my legs?"},{"id":"semetey-2-2013:p1043:b003:l026","ordinal":266885,"en":"Does the fierce wolf lie dead?"},{"id":"semetey-2-2013:p1043:b003:l027","ordinal":266886,"en":"Has your fierce wolf, even now,"},{"id":"semetey-2-2013:p1043:b003:l028","ordinal":266887,"en":"Suffered the torments of the grave?"},{"id":"semetey-2-2013:p1043:b003:l029","ordinal":266888,"en":"When have I ever heeded a warning rite?"},{"id":"semetey-2-2013:p1043:b003:l030","ordinal":266889,"en":"When he stirred my enmity,"},{"id":"semetey-2-2013:p1043:b003:l031","ordinal":266890,"en":"I devoured my own father, Khan Jakyp."},{"id":"semetey-2-2013:p1043:b003:l032","ordinal":266891,"en":"And did I die?"},{"id":"semetey-2-2013:p1043:b003:l033","ordinal":266892,"en":"Has this precious head, even now,"},{"id":"semetey-2-2013:p1043:b003:l034","ordinal":266893,"en":"Beheld the face of Judgment Day?"},{"id":"semetey-2-2013:p1043:b003:l035","ordinal":266894,"en":"I made my uncle Chyybyt scream;"},{"id":"semetey-2-2013:p1043:b003:l036","ordinal":266895,"en":"I overthrew the six rich lords."},{"id":"semetey-2-2013:p1043:b003:l037","ordinal":266896,"en":"I sent Kölbay to the grave,"},{"id":"semetey-2-2013:p1043:b003:l038","ordinal":266897,"en":"And showed all the people who saw me"},{"id":"semetey-2-2013:p1043:b003:l039","ordinal":266898,"en":"The fierceness of the wolf."},{"id":"semetey-2-2013:p1043:b005:l001","ordinal":266899,"en":"I sent many men to the grave."},{"id":"semetey-2-2013:p1043:b005:l002","ordinal":266900,"en":"And did I die?"},{"id":"semetey-2-2013:p1043:b005:l003","ordinal":266901,"en":"Though retribution came upon so many,"},{"id":"semetey-2-2013:p1043:b005:l004","ordinal":266902,"en":"Where have I ever encountered it?"},{"id":"semetey-2-2013:p1043:b005:l005","ordinal":266903,"en":"When have I died from bloodguilt?"},{"id":"semetey-2-2013:p1043:b005:l006","ordinal":266904,"en":"Those who provoked my fury,"},{"id":"semetey-2-2013:p1043:b005:l007","ordinal":266905,"en":"Those who kept crossing me—"},{"id":"semetey-2-2013:p1043:b005:l008","ordinal":266906,"en":"I slaughtered the forty companions."},{"id":"semetey-2-2013:p1043:b005:l009","ordinal":266907,"en":"They loosed their bows like pouring rain;"},{"id":"semetey-2-2013:p1043:b005:l010","ordinal":266908,"en":"Though I pleaded, they would not spare my life,"},{"id":"semetey-2-2013:p1043:b005:l011","ordinal":266909,"en":"But shot their arrows like hail."},{"id":"semetey-2-2013:p1043:b005:l012","ordinal":266910,"en":"When I drew my steed Buurul forward,"},{"id":"semetey-2-2013:p1043:b005:l013","ordinal":266911,"en":"Though I folded my hands in submission, it availed nothing;"},{"id":"semetey-2-2013:p1043:b005:l014","ordinal":266912,"en":"Thus they seared my soul,"},{"id":"semetey-2-2013:p1043:b005:l015","ordinal":266913,"en":"And set my blood boiling."},{"id":"semetey-2-2013:p1043:b005:l016","ordinal":266914,"en":"Though I pleaded, my kinsmen would not relent,"},{"id":"semetey-2-2013:p1043:b005:l017","ordinal":266915,"en":"But drove my soul to desperation."},{"id":"semetey-2-2013:p1043:b005:l018","ordinal":266916,"en":"They were my father’s legacy,"},{"id":"semetey-2-2013:p1043:b005:l019","ordinal":266917,"en":"And your valor was tested before the people—"},{"id":"semetey-2-2013:p1043:b005:l020","ordinal":266918,"en":"Yet I slaughtered the forty companions."},{"id":"semetey-2-2013:p1043:b005:l021","ordinal":266919,"en":"I unleashed an impossible madness;"},{"id":"semetey-2-2013:p1043:b005:l022","ordinal":266920,"en":"I cut open their pregnant women,"},{"id":"semetey-2-2013:p1043:b005:l023","ordinal":266921,"en":"Shattered the poles of their lattice walls,"},{"id":"semetey-2-2013:p1043:b005:l024","ordinal":266922,"en":"And made their brides and daughters weep."},{"id":"semetey-2-2013:p1043:b005:l025","ordinal":266923,"en":"I smashed every roof pole,"},{"id":"semetey-2-2013:p1043:b005:l026","ordinal":266924,"en":"And made their sons and daughters weep."},{"id":"semetey-2-2013:p1043:b005:l027","ordinal":266925,"en":"I massacred their old,"},{"id":"semetey-2-2013:p1043:b005:l028","ordinal":266926,"en":"Leaving not so much as a hair:"},{"id":"semetey-2-2013:p1043:b005:l029","ordinal":266927,"en":"I destroyed them all."},{"id":"semetey-2-2013:p1043:b005:l030","ordinal":266928,"en":"I devoured my own kin;"},{"id":"semetey-2-2013:p1043:b005:l031","ordinal":266929,"en":"And did I die?"},{"id":"semetey-2-2013:p1043:b005:l032","ordinal":266930,"en":"Did retribution overtake me?"},{"id":"semetey-2-2013:p1043:b005:l033","ordinal":266931,"en":"Has your uncle, even now,"},{"id":"semetey-2-2013:p1043:b005:l034","ordinal":266932,"en":"Let his feet dangle into the grave?"},{"id":"semetey-2-2013:p1043:b005:l035","ordinal":266933,"en":"Has he departed this world?"},{"id":"semetey-2-2013:p1043:b005:l036","ordinal":266934,"en":"Ümötöy, son of Köksö—"},{"id":"semetey-2-2013:p1043:b005:l037","ordinal":266935,"en":"Go and meet Ümötöy."},{"id":"semetey-2-2013:p1043:b005:l038","ordinal":266936,"en":"If that swine will listen to reason,"},{"id":"semetey-2-2013:p1043:b005:l039","ordinal":266937,"en":"There are eight caverns of treasure;"},{"id":"semetey-2-2013:p1044:b003:l001","ordinal":266938,"en":"In the treasury is a yellow key—"},{"id":"semetey-2-2013:p1044:b003:l002","ordinal":266939,"en":"A key with its tassel hanging."},{"id":"semetey-2-2013:p1044:b003:l003","ordinal":266940,"en":"I shall unlock and open its mouth,"},{"id":"semetey-2-2013:p1044:b003:l004","ordinal":266941,"en":"Saying, “Here it is, unruly Kazakh,”"},{"id":"semetey-2-2013:p1044:b003:l005","ordinal":266942,"en":"And among all his people,"},{"id":"semetey-2-2013:p1044:b003:l006","ordinal":266943,"en":"Young and old alike,"},{"id":"semetey-2-2013:p1044:b003:l007","ordinal":266944,"en":"I shall scatter gold by the sackful."},{"id":"semetey-2-2013:p1044:b003:l008","ordinal":266945,"en":"If Ümötöy will listen to reason,"},{"id":"semetey-2-2013:p1044:b003:l009","ordinal":266946,"en":"Let us accept his terms."},{"id":"semetey-2-2013:p1044:b003:l010","ordinal":266947,"en":"On the hills are sixty thousand horses,"},{"id":"semetey-2-2013:p1044:b003:l011","ordinal":266948,"en":"Thoroughbreds mingled with three-year-olds;"},{"id":"semetey-2-2013:p1044:b003:l012","ordinal":266949,"en":"Let us drive them forth in a train,"},{"id":"semetey-2-2013:p1044:b003:l013","ordinal":266950,"en":"And accept his terms."},{"id":"semetey-2-2013:p1044:b003:l014","ordinal":266951,"en":"If he treats his cousin with honor,"},{"id":"semetey-2-2013:p1044:b003:l015","ordinal":266952,"en":"Let us give this Ümötöy"},{"id":"semetey-2-2013:p1044:b003:l016","ordinal":266953,"en":"Thoroughbreds mingled with swift racers."},{"id":"semetey-2-2013:p1044:b003:l017","ordinal":266954,"en":"Give him robes to wear;"},{"id":"semetey-2-2013:p1044:b003:l018","ordinal":266955,"en":"If Ümötöy will make peace,"},{"id":"semetey-2-2013:p1044:b003:l019","ordinal":266956,"en":"Give him whatever force he asks,"},{"id":"semetey-2-2013:p1044:b003:l020","ordinal":266957,"en":"And grant him abundant herds in great number."},{"id":"semetey-2-2013:p1044:b003:l021","ordinal":266958,"en":"Let us eat meat from a single platter,"},{"id":"semetey-2-2013:p1044:b003:l022","ordinal":266959,"en":"Meet face-to-face and behold one another,"},{"id":"semetey-2-2013:p1044:b003:l023","ordinal":266960,"en":"Speak again of former times,"},{"id":"semetey-2-2013:p1044:b003:l024","ordinal":266961,"en":"Clasp hands and become friends."},{"id":"semetey-2-2013:p1044:b003:l025","ordinal":266962,"en":"Let us bind our spears together"},{"id":"semetey-2-2013:p1044:b003:l026","ordinal":266963,"en":"And make this pledge:"},{"id":"semetey-2-2013:p1044:b003:l027","ordinal":266964,"en":"To fight the enemy together."},{"id":"semetey-2-2013:p1044:b003:l028","ordinal":266965,"en":"Our bravest and our elders,"},{"id":"semetey-2-2013:p1044:b003:l029","ordinal":266966,"en":"As cousins bound until Judgment Day,"},{"id":"semetey-2-2013:p1044:b003:l030","ordinal":266967,"en":"Let us all meet together."},{"id":"semetey-2-2013:p1044:b003:l031","ordinal":266968,"en":"To fight the enemy together,"},{"id":"semetey-2-2013:p1044:b003:l032","ordinal":266969,"en":"If Ümötöy can be reconciled,"},{"id":"semetey-2-2013:p1044:b003:l033","ordinal":266970,"en":"To pursue our claims together,"},{"id":"semetey-2-2013:p1044:b003:l034","ordinal":266971,"en":"And scout the enemy together."},{"id":"semetey-2-2013:p1044:b003:l035","ordinal":266972,"en":"If massacre overtakes us in one place,"},{"id":"semetey-2-2013:p1044:b003:l036","ordinal":266973,"en":"Let us gather and die together."},{"id":"semetey-2-2013:p1044:b003:l037","ordinal":266974,"en":"Make a firm peace and return;"},{"id":"semetey-2-2013:p1044:b003:l038","ordinal":266975,"en":"Say, “Your hero spoke thus,”"},{"id":"semetey-2-2013:p1044:b003:l039","ordinal":266976,"en":"And deliver these entrusted words of mine."},{"id":"semetey-2-2013:p1044:b004:l001","ordinal":266977,"en":"If he grows furious and obstinate,"},{"id":"semetey-2-2013:p1044:b004:l002","ordinal":266978,"en":"Seize and subdue the slave,"},{"id":"semetey-2-2013:p1044:b004:l003","ordinal":266979,"en":"And bring him with both hands bound."},{"id":"semetey-2-2013:p1044:b004:l004","ordinal":266980,"en":"Gouge out both his eyes,"},{"id":"semetey-2-2013:p1044:b004:l005","ordinal":266981,"en":"And drive him before your uncle Semetey."},{"id":"semetey-2-2013:p1044:b004:l006","ordinal":266982,"en":"If Ümötöy will come to terms,"},{"id":"semetey-2-2013:p1044:b004:l007","ordinal":266983,"en":"Bring him to me."},{"id":"semetey-2-2013:p1044:b004:l008","ordinal":266984,"en":"So that he may become my closest kinsman,"},{"id":"semetey-2-2013:p1044:b004:l009","ordinal":266985,"en":"Show him before my eyes."},{"id":"semetey-2-2013:p1044:b004:l010","ordinal":266986,"en":"Let us camp in the same valley"},{"id":"semetey-2-2013:p1044:b004:l011","ordinal":266987,"en":"And become true brothers."},{"id":"semetey-2-2013:p1044:b004:l012","ordinal":266988,"en":"Companions gathered in this world,"},{"id":"semetey-2-2013:p1044:b004:l013","ordinal":266989,"en":"Sharing death and sharing faith,"},{"id":"semetey-2-2013:p1044:b004:l014","ordinal":266990,"en":"Let us become the closest of kin."},{"id":"semetey-2-2013:p1044:b004:l015","ordinal":266991,"en":"If Ümötöy will come to terms,"},{"id":"semetey-2-2013:p1044:b004:l016","ordinal":266992,"en":"I shall withhold none of my inheritance."},{"id":"semetey-2-2013:p1044:b004:l017","ordinal":266993,"en":"Broad Talas, left by your father,"},{"id":"semetey-2-2013:p1044:b004:l018","ordinal":266994,"en":"And my land of reedy Keng-Kol—"},{"id":"semetey-2-2013:p1044:b004:l019","ordinal":266995,"en":"I shall give all this to Ümötöy,"},{"id":"semetey-2-2013:p1044:b004:l020","ordinal":266996,"en":"Together with the people left by my father."},{"id":"semetey-2-2013:p1044:b004:l021","ordinal":266997,"en":"I shall give it to him outright;"},{"id":"semetey-2-2013:p1044:b004:l022","ordinal":266998,"en":"I shall submit to whatever"},{"id":"semetey-2-2013:p1044:b004:l023","ordinal":266999,"en":"That hero Ümötöy asks."},{"id":"semetey-2-2013:p1044:b004:l024","ordinal":267000,"en":"Let us send word among the people;"},{"id":"semetey-2-2013:p1044:b004:l025","ordinal":267001,"en":"If he desires to be khan,"},{"id":"semetey-2-2013:p1044:b004:l026","ordinal":267002,"en":"Let us spread word throughout the world,"},{"id":"semetey-2-2013:p1044:b004:l027","ordinal":267003,"en":"Across the lands of the Kyzylbash."},{"id":"semetey-2-2013:p1044:b004:l028","ordinal":267004,"en":"Calling him “Khan Ümötöy the hero,”"},{"id":"semetey-2-2013:p1044:b004:l029","ordinal":267005,"en":"Before all the peoples in our sight,"},{"id":"semetey-2-2013:p1044:b004:l030","ordinal":267006,"en":"Let us raise him as khan."},{"id":"semetey-2-2013:p1044:b004:l031","ordinal":267007,"en":"If Ümötöy refuses to listen"},{"id":"semetey-2-2013:p1044:b004:l032","ordinal":267008,"en":"And sets the Kazakhs against us,"}]
