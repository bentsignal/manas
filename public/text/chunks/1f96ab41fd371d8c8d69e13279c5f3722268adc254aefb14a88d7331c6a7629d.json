[{"id":"semetey-1-2013:p0775:b003:l018","ordinal":135681,"en":"You have blackened my face;"},{"id":"semetey-1-2013:p0775:b003:l019","ordinal":135682,"en":"You showed your hostility"},{"id":"semetey-1-2013:p0775:b003:l020","ordinal":135683,"en":"To the orphan who came to our home!”"},{"id":"semetey-1-2013:p0775:b003:l021","ordinal":135684,"en":"Abyke spoke and fell silent."},{"id":"semetey-1-2013:p0775:b003:l022","ordinal":135685,"en":"This orphan son of Manas"},{"id":"semetey-1-2013:p0775:b003:l023","ordinal":135686,"en":"Made for the doorway."},{"id":"semetey-1-2013:p0775:b003:l024","ordinal":135687,"en":"Bending his knees toward the ground,"},{"id":"semetey-1-2013:p0775:b003:l025","ordinal":135688,"en":"Running toward the doorway,"},{"id":"semetey-1-2013:p0775:b003:l026","ordinal":135689,"en":"Bakai and Semetey"},{"id":"semetey-1-2013:p0775:b003:l027","ordinal":135690,"en":"Bound and fastened it again,"},{"id":"semetey-1-2013:p0775:b003:l028","ordinal":135691,"en":"The wealth that Manas had left,"},{"id":"semetey-1-2013:p0775:b003:l029","ordinal":135692,"en":"Securing it to the saddle straps."},{"id":"semetey-1-2013:p0775:b003:l030","ordinal":135693,"en":"Understanding, the child wept bitterly;"},{"id":"semetey-1-2013:p0775:b003:l031","ordinal":135694,"en":"All these possessions"},{"id":"semetey-1-2013:p0775:b003:l032","ordinal":135695,"en":"He dedicated to his mother Kanykey."},{"id":"semetey-1-2013:p0775:b003:l033","ordinal":135696,"en":"His heart softened and was moved;"},{"id":"semetey-1-2013:p0775:b003:l034","ordinal":135697,"en":"With brave Bakai following,"},{"id":"semetey-1-2013:p0775:b003:l035","ordinal":135698,"en":"Your orphan rode out,"},{"id":"semetey-1-2013:p0775:b003:l036","ordinal":135699,"en":"Looking like a lion."},{"id":"semetey-1-2013:p0775:b003:l037","ordinal":135700,"en":"From valiant, wolf-maned Manas,"},{"id":"semetey-1-2013:p0775:b003:l038","ordinal":135701,"en":"Your dear lad left as a gift,"},{"id":"semetey-1-2013:p0775:b003:l039","ordinal":135702,"en":"Surging forth, breaking away,"},{"id":"semetey-1-2013:p0775:b004:l001","ordinal":135703,"en":"Your dear lad rode out,"},{"id":"semetey-1-2013:p0775:b004:l002","ordinal":135704,"en":"Looking like a towering mountain."},{"id":"semetey-1-2013:p0775:b004:l003","ordinal":135705,"en":"This damned orphan—"},{"id":"semetey-1-2013:p0775:b004:l004","ordinal":135706,"en":"Look at what he did:"},{"id":"semetey-1-2013:p0775:b004:l005","ordinal":135707,"en":"Slung upon him was Akkelte,"},{"id":"semetey-1-2013:p0775:b004:l006","ordinal":135708,"en":"Girded about him was Boz Kise."},{"id":"semetey-1-2013:p0775:b004:l007","ordinal":135709,"en":"The foal of champion Manas,"},{"id":"semetey-1-2013:p0775:b004:l008","ordinal":135710,"en":"What he wore upon his body"},{"id":"semetey-1-2013:p0775:b004:l009","ordinal":135711,"en":"Was Khan Manas's precious cloth robe."},{"id":"semetey-1-2013:p0775:b004:l010","ordinal":135712,"en":"Ringing as he rode,"},{"id":"semetey-1-2013:p0775:b004:l011","ordinal":135713,"en":"Zulpukor, left by Manas,"},{"id":"semetey-1-2013:p0775:b004:l012","ordinal":135714,"en":"As though it had found its master,"},{"id":"semetey-1-2013:p0775:b004:l013","ordinal":135715,"en":"Jangled at his left side."},{"id":"semetey-1-2013:p0775:b004:l014","ordinal":135716,"en":"In his uncle Bakai's hand,"},{"id":"semetey-1-2013:p0775:b004:l015","ordinal":135717,"en":"The banner fluttered."},{"id":"semetey-1-2013:p0775:b004:l016","ordinal":135718,"en":"The blood-drinker left by Manas,"},{"id":"semetey-1-2013:p0775:b004:l017","ordinal":135719,"en":"By the poor orphan child"},{"id":"semetey-1-2013:p0775:b004:l018","ordinal":135720,"en":"Received as a gift, Syrnayza,"},{"id":"semetey-1-2013:p0775:b004:l019","ordinal":135721,"en":"Flashed beside his thigh."},{"id":"semetey-1-2013:p0775:b004:l020","ordinal":135722,"en":"At the sight, the heart was moved;"},{"id":"semetey-1-2013:p0775:b004:l021","ordinal":135723,"en":"It seemed to change a thousand ways."},{"id":"semetey-1-2013:p0775:b004:l022","ordinal":135724,"en":"When he took his weapons,"},{"id":"semetey-1-2013:p0775:b004:l023","ordinal":135725,"en":"When he girded Boz Kise about his waist,"},{"id":"semetey-1-2013:p0775:b004:l024","ordinal":135726,"en":"His nine protectors"},{"id":"semetey-1-2013:p0775:b004:l025","ordinal":135727,"en":"Now gave him their support."},{"id":"semetey-1-2013:p0775:b004:l026","ordinal":135728,"en":"The forty saints, Khyzyr Iliyas,"},{"id":"semetey-1-2013:p0775:b004:l027","ordinal":135729,"en":"Had become his companions."},{"id":"semetey-1-2013:p0775:b004:l028","ordinal":135730,"en":"When dear Bakai looked,"},{"id":"semetey-1-2013:p0775:b004:l029","ordinal":135731,"en":"A black-spotted leopard"},{"id":"semetey-1-2013:p0775:b004:l030","ordinal":135732,"en":"Prowled at his side;"},{"id":"semetey-1-2013:p0775:b004:l031","ordinal":135733,"en":"A short-tailed, blue-maned lion"},{"id":"semetey-1-2013:p0775:b004:l032","ordinal":135734,"en":"Made ready beside him."},{"id":"semetey-1-2013:p0775:b004:l033","ordinal":135735,"en":"Seeing those who supported him,"},{"id":"semetey-1-2013:p0775:b004:l034","ordinal":135736,"en":"His uncle Bakai, the guardian patron,"},{"id":"semetey-1-2013:p0775:b004:l035","ordinal":135737,"en":"Prayed with all his soul:"},{"id":"semetey-1-2013:p0775:b004:l036","ordinal":135738,"en":"“My orphan, blessed with such good fortune,"},{"id":"semetey-1-2013:p0775:b004:l037","ordinal":135739,"en":"Has found all things in harmony."},{"id":"semetey-1-2013:p0775:b004:l038","ordinal":135740,"en":"If you look within him,"},{"id":"semetey-1-2013:p0775:b004:l039","ordinal":135741,"en":"He has grown wider than the face of the earth,"},{"id":"semetey-1-2013:p0776:b003:l001","ordinal":135742,"en":"Than wolf-maned Lord Manas,"},{"id":"semetey-1-2013:p0776:b003:l002","ordinal":135743,"en":"In what way is he less?"},{"id":"semetey-1-2013:p0776:b003:l003","ordinal":135744,"en":"From falcon Manas, the champion,"},{"id":"semetey-1-2013:p0776:b003:l004","ordinal":135745,"en":"Is this not my hawk?"},{"id":"semetey-1-2013:p0776:b003:l005","ordinal":135746,"en":"From goshawk Manas, the wolf-maned,"},{"id":"semetey-1-2013:p0776:b003:l006","ordinal":135747,"en":"Is this not my goshawk?"},{"id":"semetey-1-2013:p0776:b003:l007","ordinal":135748,"en":"His protectors have proved true;"},{"id":"semetey-1-2013:p0776:b003:l008","ordinal":135749,"en":"Every limb has grown in balance."},{"id":"semetey-1-2013:p0776:b003:l009","ordinal":135750,"en":"If my orphan lives unharmed,"},{"id":"semetey-1-2013:p0776:b003:l010","ordinal":135751,"en":"He has become a hero worth the world."},{"id":"semetey-1-2013:p0776:b003:l011","ordinal":135752,"en":"If old Bakai does not die,"},{"id":"semetey-1-2013:p0776:b003:l012","ordinal":135753,"en":"If he does not see Judgment Day,"},{"id":"semetey-1-2013:p0776:b003:l013","ordinal":135754,"en":"Beginning with Khakan and Beijing,"},{"id":"semetey-1-2013:p0776:b003:l014","ordinal":135755,"en":"I shall ride and scout the way."},{"id":"semetey-1-2013:p0776:b003:l015","ordinal":135756,"en":"From the seething unbelievers,"},{"id":"semetey-1-2013:p0776:b003:l016","ordinal":135757,"en":"If I reach them, I shall take revenge.”"},{"id":"semetey-1-2013:p0776:b003:l017","ordinal":135758,"en":"Seeing those who supported him,"},{"id":"semetey-1-2013:p0776:b003:l018","ordinal":135759,"en":"“He has become like my Manas,” he said."},{"id":"semetey-1-2013:p0776:b003:l019","ordinal":135760,"en":"Poor Bakai prayed,"},{"id":"semetey-1-2013:p0776:b003:l020","ordinal":135761,"en":"Quickly invoking Bahauddin,"},{"id":"semetey-1-2013:p0776:b003:l021","ordinal":135762,"en":"Calling on the one God, reciting from memory;"},{"id":"semetey-1-2013:p0776:b003:l022","ordinal":135763,"en":"Poor Bakai rode along."},{"id":"semetey-1-2013:p0776:b003:l023","ordinal":135764,"en":"Traveling on their return journey,"},{"id":"semetey-1-2013:p0776:b003:l025","ordinal":135765,"en":"Now let me tell you","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0776:b003:l026","ordinal":135766,"en":"The tale of Abyke and Kobosh."},{"id":"semetey-1-2013:p0776:b003:l027","ordinal":135767,"en":"His reason returning, his senses gathered,"},{"id":"semetey-1-2013:p0776:b003:l028","ordinal":135768,"en":"Kobosh had stood up."},{"id":"semetey-1-2013:p0776:b003:l029","ordinal":135769,"en":"Akylay, Shoruk's daughter,"},{"id":"semetey-1-2013:p0776:b003:l030","ordinal":135770,"en":"The wretch who strutted in rustling finery,"},{"id":"semetey-1-2013:p0776:b003:l031","ordinal":135771,"en":"Who had forgotten Khan Manas,"},{"id":"semetey-1-2013:p0776:b003:l032","ordinal":135772,"en":"Now Kobosh's wife,"},{"id":"semetey-1-2013:p0776:b003:l033","ordinal":135773,"en":"That wretch grew furious."},{"id":"semetey-1-2013:p0776:b003:l034","ordinal":135774,"en":"The worthless wife did not mend her ways;"},{"id":"semetey-1-2013:p0776:b003:l035","ordinal":135775,"en":"She left no wickedness undone."},{"id":"semetey-1-2013:p0776:b003:l036","ordinal":135776,"en":"She knew not what strife she would raise;"},{"id":"semetey-1-2013:p0776:b003:l037","ordinal":135777,"en":"Screaming, weeping, roaring,"},{"id":"semetey-1-2013:p0776:b003:l038","ordinal":135778,"en":"She abused Kobosh bitterly,"},{"id":"semetey-1-2013:p0776:b003:l039","ordinal":135779,"en":"And wished for greater wickedness,"},{"id":"semetey-1-2013:p0776:b004:l001","ordinal":135780,"en":"She drove Kobosh on fiercely:"},{"id":"semetey-1-2013:p0776:b004:l002","ordinal":135781,"en":"“You villains, of a junior wife,"},{"id":"semetey-1-2013:p0776:b004:l003","ordinal":135782,"en":"You are indeed sons!"},{"id":"semetey-1-2013:p0776:b004:l005","ordinal":135783,"en":"You are indeed sheep!","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0776:b004:l006","ordinal":135784,"en":"Lying on your breast, short-shanked,"},{"id":"semetey-1-2013:p0776:b004:l007","ordinal":135785,"en":"You are indeed a dog."},{"id":"semetey-1-2013:p0776:b004:l008","ordinal":135786,"en":"I have reason to call you a dog;"},{"id":"semetey-1-2013:p0776:b004:l009","ordinal":135787,"en":"You have acted like dogs."},{"id":"semetey-1-2013:p0776:b004:l010","ordinal":135788,"en":"Is this not your doggishness?"},{"id":"semetey-1-2013:p0776:b004:l011","ordinal":135789,"en":"Settled in Talas, you failed to become mighty;"},{"id":"semetey-1-2013:p0776:b004:l012","ordinal":135790,"en":"My treasury left by the warrior—"},{"id":"semetey-1-2013:p0776:b004:l013","ordinal":135791,"en":"You wretches failed to be its masters."},{"id":"semetey-1-2013:p0776:b004:l014","ordinal":135792,"en":"My precious wealth and possessions"},{"id":"semetey-1-2013:p0776:b004:l016","ordinal":135793,"en":"My costly wealth","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0776:b004:l017","ordinal":135794,"en":"You let a single orphan take."},{"id":"semetey-1-2013:p0776:b004:l018","ordinal":135795,"en":"The bright red crimson fabric,"},{"id":"semetey-1-2013:p0776:b004:l020","ordinal":135796,"en":"My precious possessions","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0776:b004:l021","ordinal":135797,"en":"You let be taken, no match for him."},{"id":"semetey-1-2013:p0776:b004:l023","ordinal":135798,"en":"Puffed up, you slept your fill.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0776:b004:l024","ordinal":135799,"en":"The possessions left by Manas"},{"id":"semetey-1-2013:p0776:b004:l025","ordinal":135800,"en":"You let a single orphan take."},{"id":"semetey-1-2013:p0776:b004:l026","ordinal":135801,"en":"You hulking dog who fancied himself a lord,"},{"id":"semetey-1-2013:p0776:b004:l027","ordinal":135802,"en":"You let him trample over your heads together."},{"id":"semetey-1-2013:p0776:b004:l028","ordinal":135803,"en":"The possessions left by the lord"},{"id":"semetey-1-2013:p0776:b004:l029","ordinal":135804,"en":"You let a wandering slave scatter."},{"id":"semetey-1-2013:p0776:b004:l030","ordinal":135805,"en":"My treasury, withheld when asked for,"},{"id":"semetey-1-2013:p0776:b004:l031","ordinal":135806,"en":"You let him seize by force."},{"id":"semetey-1-2013:p0776:b004:l032","ordinal":135807,"en":"The possessions left by the sultan"},{"id":"semetey-1-2013:p0776:b004:l033","ordinal":135808,"en":"You let a wandering slave take."},{"id":"semetey-1-2013:p0776:b004:l035","ordinal":135809,"en":"Into my pure treasury of wealth","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0776:b004:l036","ordinal":135810,"en":"You let an orphan slave enter."},{"id":"semetey-1-2013:p0776:b004:l037","ordinal":135811,"en":"My treasury of precious gold coins"},{"id":"semetey-1-2013:p0776:b004:l038","ordinal":135812,"en":"You let Semetey plunder."},{"id":"semetey-1-2013:p0776:b004:l039","ordinal":135813,"en":"Fighting, your strength could not prevail,"},{"id":"semetey-1-2013:p0777:b003:l001","ordinal":135814,"en":"You hulking dog, your strength exhausted,"},{"id":"semetey-1-2013:p0777:b003:l002","ordinal":135815,"en":"You let Bakai Khan restrain you."},{"id":"semetey-1-2013:p0777:b003:l003","ordinal":135816,"en":"By Manas's fugitive son"},{"id":"semetey-1-2013:p0777:b003:l004","ordinal":135817,"en":"You let poor me be beaten."},{"id":"semetey-1-2013:p0777:b003:l005","ordinal":135818,"en":"Your father's grave, you hulking dog!"},{"id":"semetey-1-2013:p0777:b003:l006","ordinal":135819,"en":"If I gather sand, it is not stone."},{"id":"semetey-1-2013:p0777:b003:l007","ordinal":135820,"en":"Yesterday, drinking spirits and panting,"},{"id":"semetey-1-2013:p0777:b003:l008","ordinal":135821,"en":"As you raged together,"},{"id":"semetey-1-2013:p0777:b003:l009","ordinal":135822,"en":"You used to slice and eat the rump meat;"},{"id":"semetey-1-2013:p0777:b003:l010","ordinal":135823,"en":"All six villains, gathered together,"},{"id":"semetey-1-2013:p0777:b003:l011","ordinal":135824,"en":"You said you would crush the general."},{"id":"semetey-1-2013:p0777:b003:l012","ordinal":135825,"en":"Instead of a general, you hulking dog,"},{"id":"semetey-1-2013:p0777:b003:l013","ordinal":135826,"en":"You have become a grass-grazing camel."},{"id":"semetey-1-2013:p0777:b003:l014","ordinal":135827,"en":"Over the orphan son of Manas,"},{"id":"semetey-1-2013:p0777:b003:l015","ordinal":135828,"en":"When did you six villains gain mastery?"},{"id":"semetey-1-2013:p0777:b003:l017","ordinal":135829,"en":"If he lives, just wait:","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0777:b003:l018","ordinal":135830,"en":"Semetey will bring about your ruin!"},{"id":"semetey-1-2013:p0777:b003:l019","ordinal":135831,"en":"To his mother, that quarrelsome wife,"},{"id":"semetey-1-2013:p0777:b003:l020","ordinal":135832,"en":"You six witless villains"},{"id":"semetey-1-2013:p0777:b003:l021","ordinal":135833,"en":"Brought humiliation, to a wretch like her."},{"id":"semetey-1-2013:p0777:b003:l023","ordinal":135834,"en":"Offer your own head as a gift"},{"id":"semetey-1-2013:p0777:b004:l001","ordinal":135835,"en":"To Manas's orphan son, the hero."},{"id":"semetey-1-2013:p0777:b004:l002","ordinal":135836,"en":"My forty thousand or so horses upon the slopes—"},{"id":"semetey-1-2013:p0777:b004:l004","ordinal":135837,"en":"Unless you take care, you six villains,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0777:b004:l005","ordinal":135838,"en":"To Manas's wretched son"},{"id":"semetey-1-2013:p0777:b004:l006","ordinal":135839,"en":"You have lost my horses too."},{"id":"semetey-1-2013:p0777:b004:l007","ordinal":135840,"en":"Heroes at home, absent in battle,"},{"id":"semetey-1-2013:p0777:b004:l008","ordinal":135841,"en":"Such is this dung of a world."},{"id":"semetey-1-2013:p0777:b004:l009","ordinal":135842,"en":"Your father's grave, you six villains!"},{"id":"semetey-1-2013:p0777:b004:l010","ordinal":135843,"en":"May you perish, as though never born;"},{"id":"semetey-1-2013:p0777:b004:l011","ordinal":135844,"en":"Die instead of living on!"},{"id":"semetey-1-2013:p0777:b004:l012","ordinal":135845,"en":"There is more yet to marvel at:"},{"id":"semetey-1-2013:p0777:b004:l013","ordinal":135846,"en":"Today he raids and takes the livestock,"},{"id":"semetey-1-2013:p0777:b004:l014","ordinal":135847,"en":"Tomorrow he will slaughter and take lives."},{"id":"semetey-1-2013:p0777:b004:l015","ordinal":135848,"en":"When he has reached twelve,"},{"id":"semetey-1-2013:p0777:b004:l016","ordinal":135849,"en":"You have seen a wonder like this."},{"id":"semetey-1-2013:p0777:b004:l017","ordinal":135850,"en":"Without wearing it once, you let him take"},{"id":"semetey-1-2013:p0777:b004:l018","ordinal":135851,"en":"My robe left by the king.”"},{"id":"semetey-1-2013:p0777:b004:l019","ordinal":135852,"en":"Akylay spoke like this;"},{"id":"semetey-1-2013:p0777:b004:l020","ordinal":135853,"en":"God had struck Kobosh hard."},{"id":"semetey-1-2013:p0777:b004:l021","ordinal":135854,"en":"Making ready his weapons,"},{"id":"semetey-1-2013:p0777:b004:l022","ordinal":135855,"en":"Against Manas's orphan son,"},{"id":"semetey-1-2013:p0777:b004:l023","ordinal":135856,"en":"He prepared to joust."},{"id":"semetey-1-2013:p0777:b006:l001","ordinal":135857,"en":"Working himself up, Kobosh said:"},{"id":"semetey-1-2013:p0777:b006:l002","ordinal":135858,"en":"“His father, that simpleton Manas—"},{"id":"semetey-1-2013:p0777:b006:l003","ordinal":135859,"en":"My hand deceived him six times,” he said."},{"id":"semetey-1-2013:p0777:b006:l004","ordinal":135860,"en":"“From Temir Khan's city,"},{"id":"semetey-1-2013:p0777:b006:l005","ordinal":135861,"en":"To the orphan who wandered here,"},{"id":"semetey-1-2013:p0777:b006:l006","ordinal":135862,"en":"Let me show a wonder."},{"id":"semetey-1-2013:p0777:b006:l007","ordinal":135863,"en":"When his father Manas was alive,"},{"id":"semetey-1-2013:p0777:b006:l008","ordinal":135864,"en":"Deceiving and deluding him like this,"},{"id":"semetey-1-2013:p0777:b006:l010","ordinal":135865,"en":"“Let me show my boundless valor,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0777:b006:l011","ordinal":135866,"en":"Into his mother Kanykey's belly,"},{"id":"semetey-1-2013:p0777:b008:l001","ordinal":135867,"en":"Beating him, drive him back inside."},{"id":"semetey-1-2013:p0777:b008:l002","ordinal":135868,"en":"Upon the orphan standing there watching,"},{"id":"semetey-1-2013:p0777:b008:l003","ordinal":135869,"en":"Let me bring havoc."},{"id":"semetey-1-2013:p0777:b008:l004","ordinal":135870,"en":"He has roused my wrath;"},{"id":"semetey-1-2013:p0777:b008:l005","ordinal":135871,"en":"Let me seize him and take his head."},{"id":"semetey-1-2013:p0777:b008:l006","ordinal":135872,"en":"The ill-omened orphan"},{"id":"semetey-1-2013:p0777:b008:l007","ordinal":135873,"en":"I shall cleave upon the road."},{"id":"semetey-1-2013:p0777:b008:l008","ordinal":135874,"en":"Whatever he relies upon for support,"},{"id":"semetey-1-2013:p0777:b008:l009","ordinal":135875,"en":"I shall utterly destroy."},{"id":"semetey-1-2013:p0777:b008:l010","ordinal":135876,"en":"At the reckless orphan,"},{"id":"semetey-1-2013:p0777:b008:l011","ordinal":135877,"en":"Let me shout and thrust my lance,"},{"id":"semetey-1-2013:p0778:b003:l001","ordinal":135878,"en":"I shall strike him down while young,"},{"id":"semetey-1-2013:p0778:b003:l002","ordinal":135879,"en":"And put him out like a fire."},{"id":"semetey-1-2013:p0778:b003:l003","ordinal":135880,"en":"A birch newly sprung up—"},{"id":"semetey-1-2013:p0778:b003:l004","ordinal":135881,"en":"I shall make it as though felled."},{"id":"semetey-1-2013:p0778:b003:l005","ordinal":135882,"en":"The spur of a cliff-sided mountain—"},{"id":"semetey-1-2013:p0778:b003:l006","ordinal":135883,"en":"I shall make it as though brought crashing down."},{"id":"semetey-1-2013:p0778:b003:l007","ordinal":135884,"en":"The Argyn and the Kyrgyz—"},{"id":"semetey-1-2013:p0778:b003:l008","ordinal":135885,"en":"I shall make them move away."},{"id":"semetey-1-2013:p0778:b003:l009","ordinal":135886,"en":"The light upon his brow—"},{"id":"semetey-1-2013:p0778:b003:l010","ordinal":135887,"en":"I shall make it as though extinguished."},{"id":"semetey-1-2013:p0778:b003:l011","ordinal":135888,"en":"I shall reach that source of grief;"},{"id":"semetey-1-2013:p0778:b003:l012","ordinal":135889,"en":"Their elders, Bakai at their head,"},{"id":"semetey-1-2013:p0778:b003:l013","ordinal":135890,"en":"With their children, all of them,"},{"id":"semetey-1-2013:p0778:b003:l014","ordinal":135891,"en":"I shall shake down, shake down as I pass."},{"id":"semetey-1-2013:p0778:b003:l015","ordinal":135892,"en":"I shall catch Toruaygyr and mount him,"},{"id":"semetey-1-2013:p0778:b003:l016","ordinal":135893,"en":"And drive them toward Temir Khan.”"},{"id":"semetey-1-2013:p0778:b003:l017","ordinal":135894,"en":"This swine spoke thus;"},{"id":"semetey-1-2013:p0778:b003:l018","ordinal":135895,"en":"The earth split with his roaring."},{"id":"semetey-1-2013:p0778:b003:l019","ordinal":135896,"en":"The gray coat Akylay had made"},{"id":"semetey-1-2013:p0778:b003:l021","ordinal":135897,"en":"Toruaygyr, with his mallet-like mane, at the tether,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0778:b003:l023","ordinal":135898,"en":"He leapt upon bareback."},{"id":"semetey-1-2013:p0778:b003:l024","ordinal":135899,"en":"A greasy black yurt-bracing pole"},{"id":"semetey-1-2013:p0778:b003:l025","ordinal":135900,"en":"He put upon his shoulder."},{"id":"semetey-1-2013:p0778:b003:l026","ordinal":135901,"en":"Roaring, “The enemy flees!”"},{"id":"semetey-1-2013:p0778:b003:l027","ordinal":135902,"en":"Raising the battle cry, “Kobosh!”"},{"id":"semetey-1-2013:p0778:b003:l028","ordinal":135903,"en":"He shouted and gave chase."},{"id":"semetey-1-2013:p0778:b003:l029","ordinal":135904,"en":"Mallet-maned Toruaygyr,"},{"id":"semetey-1-2013:p0778:b003:l030","ordinal":135905,"en":"Flying like an arrow, sped along,"},{"id":"semetey-1-2013:p0778:b003:l031","ordinal":135906,"en":"Toward Semetey and Bakai,"},{"id":"semetey-1-2013:p0778:b003:l032","ordinal":135907,"en":"And drew near them."},{"id":"semetey-1-2013:p0778:b003:l033","ordinal":135908,"en":"Bakai and Semetey,"},{"id":"semetey-1-2013:p0778:b003:l034","ordinal":135909,"en":"Unperturbed, paying no heed,"},{"id":"semetey-1-2013:p0778:b003:l035","ordinal":135910,"en":"Kept riding on,"},{"id":"semetey-1-2013:p0778:b003:l036","ordinal":135911,"en":"That bellowing dog"},{"id":"semetey-1-2013:p0778:b003:l037","ordinal":135912,"en":"Counting as nothing."},{"id":"semetey-1-2013:p0778:b003:l038","ordinal":135913,"en":"When the fool came close,"},{"id":"semetey-1-2013:p0778:b003:l039","ordinal":135914,"en":"Semetey rode ahead,"},{"id":"semetey-1-2013:p0778:b004:l001","ordinal":135915,"en":"Bakai Khan behind him."},{"id":"semetey-1-2013:p0778:b004:l002","ordinal":135916,"en":"Kobosh caught up, full of rage,"},{"id":"semetey-1-2013:p0778:b004:l003","ordinal":135917,"en":"And spoke to Bakai Khan:"},{"id":"semetey-1-2013:p0778:b004:l004","ordinal":135918,"en":"“You damned slave Bakai,"},{"id":"semetey-1-2013:p0778:b004:l005","ordinal":135919,"en":"A solitary hut before you—"},{"id":"semetey-1-2013:p0778:b004:l006","ordinal":135920,"en":"You have come, thinking it a presence."},{"id":"semetey-1-2013:p0778:b004:l007","ordinal":135921,"en":"Manas's foolish orphan—"},{"id":"semetey-1-2013:p0778:b004:l008","ordinal":135922,"en":"You have come, thinking him support."},{"id":"semetey-1-2013:p0778:b004:l009","ordinal":135923,"en":"I shall strike down your support,"},{"id":"semetey-1-2013:p0778:b004:l010","ordinal":135924,"en":"You damned graybeard;"},{"id":"semetey-1-2013:p0778:b004:l011","ordinal":135925,"en":"I shall settle your account now."},{"id":"semetey-1-2013:p0778:b004:l012","ordinal":135926,"en":"With your beard grown white,"},{"id":"semetey-1-2013:p0778:b004:l013","ordinal":135927,"en":"With your final journey near,"},{"id":"semetey-1-2013:p0778:b004:l014","ordinal":135928,"en":"You do not know your own wickedness;"},{"id":"semetey-1-2013:p0778:b004:l015","ordinal":135929,"en":"You cannot live without unsettling the people."},{"id":"semetey-1-2013:p0778:b004:l016","ordinal":135930,"en":"In your old age,"},{"id":"semetey-1-2013:p0778:b004:l017","ordinal":135931,"en":"With death approaching,"},{"id":"semetey-1-2013:p0778:b004:l018","ordinal":135932,"en":"Urging your Kokcholok along,"},{"id":"semetey-1-2013:p0778:b004:l019","ordinal":135933,"en":"You have scoured the face of the earth."},{"id":"semetey-1-2013:p0778:b004:l020","ordinal":135934,"en":"Manas's wandering orphan"},{"id":"semetey-1-2013:p0778:b004:l021","ordinal":135935,"en":"You have taken as your support."},{"id":"semetey-1-2013:p0778:b004:l022","ordinal":135936,"en":"Whenever it may be, you old rogue,"}]
