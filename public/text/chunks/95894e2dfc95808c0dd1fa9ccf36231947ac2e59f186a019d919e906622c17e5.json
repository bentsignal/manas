[{"id":"semetey-1-2013:p0503:b003:l015","ordinal":115457,"en":"Whoever speared the hero,"},{"id":"semetey-1-2013:p0503:b003:l016","ordinal":115458,"en":"Manas got the name for it."},{"id":"semetey-1-2013:p0503:b003:l017","ordinal":115459,"en":"Whoever wrought the slaughter,"},{"id":"semetey-1-2013:p0503:b003:l018","ordinal":115460,"en":"Your father, gone to Judgment Day,"},{"id":"semetey-1-2013:p0503:b003:l019","ordinal":115461,"en":"Brought trouble upon this wretched head."},{"id":"semetey-1-2013:p0503:b003:l020","ordinal":115462,"en":"At one turn of fortune,"},{"id":"semetey-1-2013:p0503:b003:l021","ordinal":115463,"en":"Before your father, the Lion,"},{"id":"semetey-1-2013:p0503:b003:l022","ordinal":115464,"en":"I loaded gold like stones."},{"id":"semetey-1-2013:p0503:b003:l023","ordinal":115465,"en":"At another turn,"},{"id":"semetey-1-2013:p0503:b003:l024","ordinal":115466,"en":"For six months I was a neglected wife,"},{"id":"semetey-1-2013:p0503:b003:l025","ordinal":115467,"en":"Bearing such suffering."},{"id":"semetey-1-2013:p0503:b003:l026","ordinal":115468,"en":"I still have more to tell;"},{"id":"semetey-1-2013:p0503:b003:l027","ordinal":115469,"en":"Again I shall tell a plain tale."},{"id":"semetey-1-2013:p0503:b003:l028","ordinal":115470,"en":"Alas, orphan, listen!"},{"id":"semetey-1-2013:p0503:b003:l029","ordinal":115471,"en":"When your father was inflicting wrong,"},{"id":"semetey-1-2013:p0503:b003:l030","ordinal":115472,"en":"Wrong as great as Ala-Too,"},{"id":"semetey-1-2013:p0503:b003:l031","ordinal":115473,"en":"Upon my father Khan Temir's city,"},{"id":"semetey-1-2013:p0503:b003:l032","ordinal":115474,"en":"I, your mother, was a little girl,"},{"id":"semetey-1-2013:p0503:b003:l033","ordinal":115475,"en":"My hair not yet long enough to braid,"},{"id":"semetey-1-2013:p0503:b003:l034","ordinal":115476,"en":"The fairest among women then,"},{"id":"semetey-1-2013:p0503:b003:l035","ordinal":115477,"en":"I, your luckless mother,"},{"id":"semetey-1-2013:p0503:b003:l036","ordinal":115478,"en":"Was a girl of fourteen."},{"id":"semetey-1-2013:p0503:b003:l037","ordinal":115479,"en":"Your grandfather, this Khan Temir,"},{"id":"semetey-1-2013:p0503:b003:l038","ordinal":115480,"en":"And my deep-dug moat—"},{"id":"semetey-1-2013:p0503:b003:l039","ordinal":115481,"en":"Into my father Khan Temir's city"},{"id":"semetey-1-2013:p0503:b004:l001","ordinal":115482,"en":"Akbaltai's Chubak"},{"id":"semetey-1-2013:p0503:b004:l002","ordinal":115483,"en":"Wrought a marvel without mercy."},{"id":"semetey-1-2013:p0503:b004:l003","ordinal":115484,"en":"Greasing his battle-axe,"},{"id":"semetey-1-2013:p0503:b004:l004","ordinal":115485,"en":"Sixty watchmen,"},{"id":"semetey-1-2013:p0503:b004:l005","ordinal":115486,"en":"Seventy spearmen,"},{"id":"semetey-1-2013:p0503:b004:l006","ordinal":115487,"en":"He seized and killed."},{"id":"semetey-1-2013:p0503:b004:l007","ordinal":115488,"en":"Unable to withstand Chubak's wrath,"},{"id":"semetey-1-2013:p0503:b004:l008","ordinal":115489,"en":"They fell into turmoil."},{"id":"semetey-1-2013:p0503:b004:l009","ordinal":115490,"en":"Bukhara with its city, Khan Temir—"},{"id":"semetey-1-2013:p0503:b004:l010","ordinal":115491,"en":"Slaughtered, they abandoned the city."},{"id":"semetey-1-2013:p0503:b004:l011","ordinal":115492,"en":"Then Chubak was not yet Chubak,"},{"id":"semetey-1-2013:p0503:b004:l012","ordinal":115493,"en":"Had not yet gone to settle in Talas,"},{"id":"semetey-1-2013:p0503:b004:l013","ordinal":115494,"en":"To befriend your father,"},{"id":"semetey-1-2013:p0503:b004:l014","ordinal":115495,"en":"Had not yet become Manas's companion."},{"id":"semetey-1-2013:p0503:b004:l015","ordinal":115496,"en":"When he reached the age of twelve,"},{"id":"semetey-1-2013:p0503:b004:l016","ordinal":115497,"en":"He besieged Kashgar and took it six times."},{"id":"semetey-1-2013:p0503:b004:l017","ordinal":115498,"en":"Alty-Shaar, Andijan,"},{"id":"semetey-1-2013:p0503:b004:l018","ordinal":115499,"en":"Beyond them Kokand and Margilan,"},{"id":"semetey-1-2013:p0503:b004:l019","ordinal":115500,"en":"At their side Samarkand—"},{"id":"semetey-1-2013:p0503:b004:l020","ordinal":115501,"en":"He attacked and took them four times."},{"id":"semetey-1-2013:p0503:b004:l021","ordinal":115502,"en":"Where his Kökala had not trodden,"},{"id":"semetey-1-2013:p0503:b004:l022","ordinal":115503,"en":"Not a single whole place remained;"},{"id":"semetey-1-2013:p0503:b004:l023","ordinal":115504,"en":"Of Akbaltai's son"},{"id":"semetey-1-2013:p0503:b004:l024","ordinal":115505,"en":"Whose battle-cry they had not heard—"},{"id":"semetey-1-2013:p0503:b004:l025","ordinal":115506,"en":"Not a single whole people remained."},{"id":"semetey-1-2013:p0503:b004:l026","ordinal":115507,"en":"Akbaltai's Chubak"},{"id":"semetey-1-2013:p0503:b004:l027","ordinal":115508,"en":"Threw the world's peoples into turmoil."},{"id":"semetey-1-2013:p0503:b004:l028","ordinal":115509,"en":"The son of Khan Baltai,"},{"id":"semetey-1-2013:p0503:b004:l029","ordinal":115510,"en":"His bristling, cropped-eared warrior,"},{"id":"semetey-1-2013:p0503:b004:l030","ordinal":115511,"en":"Shrill cries and fierce cheering,"},{"id":"semetey-1-2013:p0503:b004:l031","ordinal":115512,"en":"Mottled shirt and long trousers—"},{"id":"semetey-1-2013:p0503:b004:l032","ordinal":115513,"en":"Akbaltai's Chubak"},{"id":"semetey-1-2013:p0503:b004:l033","ordinal":115514,"en":"Inflicted such wrong upon Bukhara."},{"id":"semetey-1-2013:p0503:b004:l034","ordinal":115515,"en":"When he reached sixteen,"},{"id":"semetey-1-2013:p0503:b004:l035","ordinal":115516,"en":"Upon my father Khan Temir"},{"id":"semetey-1-2013:p0503:b004:l036","ordinal":115517,"en":"He laid oppression without mercy."},{"id":"semetey-1-2013:p0503:b004:l037","ordinal":115518,"en":"A letter came from a caravaneer;"},{"id":"semetey-1-2013:p0503:b004:l038","ordinal":115519,"en":"He promptly delivered it without hesitation."},{"id":"semetey-1-2013:p0503:b004:l039","ordinal":115520,"en":"Seeing the letter, he burst into tears,"},{"id":"semetey-1-2013:p0504:b003:l001","ordinal":115521,"en":"Not one person showed courage;"},{"id":"semetey-1-2013:p0504:b003:l002","ordinal":115522,"en":"The Sarts of Bukhara wailed."},{"id":"semetey-1-2013:p0504:b003:l003","ordinal":115523,"en":"When we read his letter,"},{"id":"semetey-1-2013:p0504:b003:l004","ordinal":115524,"en":"The command Chubak had made,"},{"id":"semetey-1-2013:p0504:b003:l005","ordinal":115525,"en":"What he inflicted on Bukhara, alas,"},{"id":"semetey-1-2013:p0504:b003:l006","ordinal":115526,"en":"Was a horror no mortal would commit."},{"id":"semetey-1-2013:p0504:b003:l007","ordinal":115527,"en":"“Let them submit to this letter of mine;"},{"id":"semetey-1-2013:p0504:b003:l008","ordinal":115528,"en":"Khan Temir's golden throne"},{"id":"semetey-1-2013:p0504:b003:l009","ordinal":115529,"en":"Let him give without a quarrel."},{"id":"semetey-1-2013:p0504:b003:l010","ordinal":115530,"en":"If he will not obey my words,"},{"id":"semetey-1-2013:p0504:b003:l011","ordinal":115531,"en":"If he will not give his golden throne,"},{"id":"semetey-1-2013:p0504:b003:l012","ordinal":115532,"en":"I shall trample his head."},{"id":"semetey-1-2013:p0504:b003:l013","ordinal":115533,"en":"Bukhara, the people with its rulers—"},{"id":"semetey-1-2013:p0504:b003:l014","ordinal":115534,"en":"I shall scatter its treasury."},{"id":"semetey-1-2013:p0504:b003:l015","ordinal":115535,"en":"I shall plunder its goods,"},{"id":"semetey-1-2013:p0504:b003:l016","ordinal":115536,"en":"Wreak utter devastation."},{"id":"semetey-1-2013:p0504:b003:l017","ordinal":115537,"en":"When springtime comes,"},{"id":"semetey-1-2013:p0504:b003:l018","ordinal":115538,"en":"I shall let none ride a maned filly."},{"id":"semetey-1-2013:p0504:b003:l019","ordinal":115539,"en":"When autumn comes,"},{"id":"semetey-1-2013:p0504:b003:l020","ordinal":115540,"en":"I shall let none eat a fat-tailed lamb."},{"id":"semetey-1-2013:p0504:b003:l021","ordinal":115541,"en":"I shall not let them yoke a pair of oxen,"},{"id":"semetey-1-2013:p0504:b003:l022","ordinal":115542,"en":"Nor let them sow a crop,"},{"id":"semetey-1-2013:p0504:b003:l023","ordinal":115543,"en":"Nor turn the face of the earth,"},{"id":"semetey-1-2013:p0504:b003:l024","ordinal":115544,"en":"Nor scatter a handful of wheat."},{"id":"semetey-1-2013:p0504:b003:l025","ordinal":115545,"en":"I shall rob their camels on the road,"},{"id":"semetey-1-2013:p0504:b003:l026","ordinal":115546,"en":"Seize and slaughter Bukhara's"},{"id":"semetey-1-2013:p0504:b003:l027","ordinal":115547,"en":"Giant who goes out scouting!”"},{"id":"semetey-1-2013:p0504:b003:l028","ordinal":115548,"en":"Such was the letter Chubak had written."},{"id":"semetey-1-2013:p0504:b003:l029","ordinal":115549,"en":"Seeing his letter, my father"},{"id":"semetey-1-2013:p0504:b003:l030","ordinal":115550,"en":"Despaired of his precious life."},{"id":"semetey-1-2013:p0504:b003:l031","ordinal":115551,"en":"Chubak had unleashed his fury;"},{"id":"semetey-1-2013:p0504:b003:l032","ordinal":115552,"en":"The news drove the soul from them."},{"id":"semetey-1-2013:p0504:b003:l033","ordinal":115553,"en":"The people of Bukhara there"},{"id":"semetey-1-2013:p0504:b003:l034","ordinal":115554,"en":"Were all but thrown into ruin."},{"id":"semetey-1-2013:p0504:b003:l035","ordinal":115555,"en":"Their khoja in a white turban,"},{"id":"semetey-1-2013:p0504:b003:l036","ordinal":115556,"en":"Their mullah in a mottled robe,"},{"id":"semetey-1-2013:p0504:b003:l037","ordinal":115557,"en":"Their eloquent elder Ulukman,"},{"id":"semetey-1-2013:p0504:b003:l038","ordinal":115558,"en":"Saw a tumultuous affair,"},{"id":"semetey-1-2013:p0504:b003:l039","ordinal":115559,"en":"All the people of Bukhara."},{"id":"semetey-1-2013:p0504:b004:l001","ordinal":115560,"en":"Their broad-jawed orator,"},{"id":"semetey-1-2013:p0504:b004:l002","ordinal":115561,"en":"Bukhara's knowing strategists,"},{"id":"semetey-1-2013:p0504:b004:l003","ordinal":115562,"en":"Many a man of cunning,"},{"id":"semetey-1-2013:p0504:b004:l004","ordinal":115563,"en":"To submit to his demand"},{"id":"semetey-1-2013:p0504:b004:l005","ordinal":115564,"en":"All agreed together."},{"id":"semetey-1-2013:p0504:b004:l006","ordinal":115565,"en":"My father Khan Temir's golden throne"},{"id":"semetey-1-2013:p0504:b004:l007","ordinal":115566,"en":"They would give to hero Chubak."},{"id":"semetey-1-2013:p0504:b004:l008","ordinal":115567,"en":"They put the date in writing,"},{"id":"semetey-1-2013:p0504:b004:l009","ordinal":115568,"en":"Reckoned the appointed day,"},{"id":"semetey-1-2013:p0504:b004:l010","ordinal":115569,"en":"And Khan Baltai's son"},{"id":"semetey-1-2013:p0504:b004:l011","ordinal":115570,"en":"They would make their sovereign."},{"id":"semetey-1-2013:p0504:b004:l012","ordinal":115571,"en":"Then they stood making promises,"},{"id":"semetey-1-2013:p0504:b004:l013","ordinal":115572,"en":"Swearing oaths on pain of death,"},{"id":"semetey-1-2013:p0504:b004:l014","ordinal":115573,"en":"Licking deadly poison."},{"id":"semetey-1-2013:p0504:b004:l015","ordinal":115574,"en":"The people cried out and bowed;"},{"id":"semetey-1-2013:p0504:b004:l016","ordinal":115575,"en":"The Bukharans, led by my father,"},{"id":"semetey-1-2013:p0504:b004:l017","ordinal":115576,"en":"Despaired of their precious lives."},{"id":"semetey-1-2013:p0504:b004:l018","ordinal":115577,"en":"While my father was in this state,"},{"id":"semetey-1-2013:p0504:b004:l019","ordinal":115578,"en":"With ninety girls in the palace"},{"id":"semetey-1-2013:p0504:b004:l020","ordinal":115579,"en":"I was playing games."},{"id":"semetey-1-2013:p0504:b004:l021","ordinal":115580,"en":"At the foot of the tower,"},{"id":"semetey-1-2013:p0504:b004:l022","ordinal":115581,"en":"Playing Manara and raising dust,"},{"id":"semetey-1-2013:p0504:b004:l023","ordinal":115582,"en":"I heard word from my watchman."},{"id":"semetey-1-2013:p0504:b004:l024","ordinal":115583,"en":"I, your mother Kanykei,"},{"id":"semetey-1-2013:p0504:b004:l025","ordinal":115584,"en":"The darling of the palace girls,"},{"id":"semetey-1-2013:p0504:b004:l026","ordinal":115585,"en":"Heard that in fifteen days,"},{"id":"semetey-1-2013:p0504:b004:l027","ordinal":115586,"en":"To Khan Baltai's son"},{"id":"semetey-1-2013:p0504:b004:l028","ordinal":115587,"en":"Khan Temir's golden throne"},{"id":"semetey-1-2013:p0504:b004:l029","ordinal":115588,"en":"Was to be given."},{"id":"semetey-1-2013:p0504:b004:l030","ordinal":115589,"en":"To his levying tribute and taxes"},{"id":"semetey-1-2013:p0504:b004:l031","ordinal":115590,"en":"Populous Bukhara had agreed;"},{"id":"semetey-1-2013:p0504:b004:l032","ordinal":115591,"en":"Khan Akbaltai's son"},{"id":"semetey-1-2013:p0504:b004:l033","ordinal":115592,"en":"Over this very Bukhara"},{"id":"semetey-1-2013:p0504:b004:l034","ordinal":115593,"en":"They would make king."},{"id":"semetey-1-2013:p0504:b004:l035","ordinal":115594,"en":"I, your mother Kanykei,"},{"id":"semetey-1-2013:p0504:b004:l036","ordinal":115595,"en":"Allah's beloved servant,"},{"id":"semetey-1-2013:p0504:b004:l037","ordinal":115596,"en":"Youngest of twelve girls,"},{"id":"semetey-1-2013:p0504:b004:l038","ordinal":115597,"en":"The beauty among the dark-complexioned,"},{"id":"semetey-1-2013:p0504:b004:l039","ordinal":115598,"en":"The radiant one among Muslims,"},{"id":"semetey-1-2013:p0505:b003:l001","ordinal":115599,"en":"My heart was sorely troubled,"},{"id":"semetey-1-2013:p0505:b003:l002","ordinal":115600,"en":"Tears poured from my eyes."},{"id":"semetey-1-2013:p0505:b003:l003","ordinal":115601,"en":"Burning with shame, seething inside,"},{"id":"semetey-1-2013:p0505:b003:l004","ordinal":115602,"en":"My eyes flashed like a lion's."},{"id":"semetey-1-2013:p0505:b003:l005","ordinal":115603,"en":"They made their land, grazing their livestock."},{"id":"semetey-1-2013:p0505:b003:l006","ordinal":115604,"en":"For Bukhara's ninety girls"},{"id":"semetey-1-2013:p0505:b003:l007","ordinal":115605,"en":"I held a feast nine days without a pause."},{"id":"semetey-1-2013:p0505:b003:l008","ordinal":115606,"en":"Poor soul, on fourteen camels,"},{"id":"semetey-1-2013:p0505:b003:l009","ordinal":115607,"en":"Of this very Bukhara"},{"id":"semetey-1-2013:p0505:b003:l010","ordinal":115608,"en":"I had another road scouted."},{"id":"semetey-1-2013:p0505:b003:l011","ordinal":115609,"en":"“My father's golden throne—"},{"id":"semetey-1-2013:p0505:b003:l012","ordinal":115610,"en":"To Akbaltai's Chubak"},{"id":"semetey-1-2013:p0505:b003:l013","ordinal":115611,"en":"Must I let it be taken by force?"},{"id":"semetey-1-2013:p0505:b003:l014","ordinal":115612,"en":"Let me sink away without bearing a child;"},{"id":"semetey-1-2013:p0505:b003:l015","ordinal":115613,"en":"Rather than bustle about alive,"},{"id":"semetey-1-2013:p0505:b003:l016","ordinal":115614,"en":"Let me behold Judgment Day."},{"id":"semetey-1-2013:p0505:b003:l017","ordinal":115615,"en":"For my father, for my people,"},{"id":"semetey-1-2013:p0505:b003:l018","ordinal":115616,"en":"For the sake of this Bukhara,"},{"id":"semetey-1-2013:p0505:b003:l019","ordinal":115617,"en":"Taking calamity upon my neck,"},{"id":"semetey-1-2013:p0505:b003:l020","ordinal":115618,"en":"I shall pledge my wretched life to this cause"},{"id":"semetey-1-2013:p0505:b003:l022","ordinal":115619,"en":"And try a bout of spears."},{"id":"semetey-1-2013:p0505:b003:l023","ordinal":115620,"en":"If my strength is enough, Chubak's"},{"id":"semetey-1-2013:p0505:b003:l024","ordinal":115621,"en":"Blood I shall pour out as from a flask."},{"id":"semetey-1-2013:p0505:b003:l025","ordinal":115622,"en":"If my strength falls short,"},{"id":"semetey-1-2013:p0505:b003:l026","ordinal":115623,"en":"At the hands of Akbaltai's son"},{"id":"semetey-1-2013:p0505:b003:l027","ordinal":115624,"en":"Let my precious life end,"},{"id":"semetey-1-2013:p0505:b003:l028","ordinal":115625,"en":"Let me behold Judgment Day."},{"id":"semetey-1-2013:p0505:b003:l029","ordinal":115626,"en":"What Allah has written,"},{"id":"semetey-1-2013:p0505:b003:l030","ordinal":115627,"en":"Whatever it is, let me see!”"},{"id":"semetey-1-2013:p0505:b003:l031","ordinal":115628,"en":"Fired with courage, unable to wait,"},{"id":"semetey-1-2013:p0505:b003:l032","ordinal":115629,"en":"My great hair, thick as a girth,"},{"id":"semetey-1-2013:p0505:b003:l033","ordinal":115630,"en":"I bound tightly upon my crown."},{"id":"semetey-1-2013:p0505:b003:l034","ordinal":115631,"en":"Soft coats that bullets could not pierce,"},{"id":"semetey-1-2013:p0505:b003:l035","ordinal":115632,"en":"Lest a bullet strike me,"},{"id":"semetey-1-2013:p0505:b003:l036","ordinal":115633,"en":"Lest death reach me in the shooting—"},{"id":"semetey-1-2013:p0505:b003:l037","ordinal":115634,"en":"Nine layers I put on."},{"id":"semetey-1-2013:p0505:b003:l038","ordinal":115635,"en":"My father Khan Temir's Ak-Kelte"},{"id":"semetey-1-2013:p0505:b003:l039","ordinal":115636,"en":"I hung upon my broad shoulder."},{"id":"semetey-1-2013:p0505:b005:l001","ordinal":115637,"en":"The golden-cheeked battle-axe"},{"id":"semetey-1-2013:p0505:b005:l002","ordinal":115638,"en":"I put upon my bare wrist."},{"id":"semetey-1-2013:p0505:b005:l003","ordinal":115639,"en":"Khan Temir's steel"},{"id":"semetey-1-2013:p0505:b005:l004","ordinal":115640,"en":"I contrived to take unseen."},{"id":"semetey-1-2013:p0505:b005:l005","ordinal":115641,"en":"In my girlhood, wretched me,"},{"id":"semetey-1-2013:p0505:b005:l006","ordinal":115642,"en":"Thinking it over in anguish,"},{"id":"semetey-1-2013:p0505:b005:l007","ordinal":115643,"en":"I put on battle-clothes,"},{"id":"semetey-1-2013:p0505:b005:l008","ordinal":115644,"en":"Apprehensive of that Chubak."},{"id":"semetey-1-2013:p0505:b005:l009","ordinal":115645,"en":"Your mother Kanykei's black, white-blazed thoroughbred—"},{"id":"semetey-1-2013:p0505:b005:l011","ordinal":115646,"en":"I saddled that thoroughbred,"},{"id":"semetey-1-2013:p0505:b005:l012","ordinal":115647,"en":"Girded on keen steel,"},{"id":"semetey-1-2013:p0505:b005:l013","ordinal":115648,"en":"All my battle gear"},{"id":"semetey-1-2013:p0505:b005:l014","ordinal":115649,"en":"I made ready in its place."},{"id":"semetey-1-2013:p0505:b005:l015","ordinal":115650,"en":"Buttoning up my full body,"},{"id":"semetey-1-2013:p0505:b005:l016","ordinal":115651,"en":"My plump red cheeks"},{"id":"semetey-1-2013:p0505:b005:l017","ordinal":115652,"en":"I covered with blue iron."},{"id":"semetey-1-2013:p0505:b005:l018","ordinal":115653,"en":"The banner fluttered in my hand;"},{"id":"semetey-1-2013:p0505:b005:l019","ordinal":115654,"en":"The great black Narkesken sword"},{"id":"semetey-1-2013:p0505:b005:l020","ordinal":115655,"en":"Gleamed at my wrist."},{"id":"semetey-1-2013:p0505:b005:l021","ordinal":115656,"en":"As I went, my heart was troubled;"},{"id":"semetey-1-2013:p0505:b005:l022","ordinal":115657,"en":"My painted spear, some forty fathoms long,"},{"id":"semetey-1-2013:p0505:b005:l023","ordinal":115658,"en":"Showed beneath my knee."},{"id":"semetey-1-2013:p0505:b005:l024","ordinal":115659,"en":"Wearing out my horse, scouting the land,"},{"id":"semetey-1-2013:p0505:b005:l025","ordinal":115660,"en":"With Khan Baltai's Chubak"},{"id":"semetey-1-2013:p0505:b005:l026","ordinal":115661,"en":"I resolved to fight to the death."},{"id":"semetey-1-2013:p0505:b005:l027","ordinal":115662,"en":"“I shall find the slave on the mountain slope,” I thought."},{"id":"semetey-1-2013:p0505:b005:l028","ordinal":115663,"en":"He alone, I alone,"},{"id":"semetey-1-2013:p0505:b005:l029","ordinal":115664,"en":"With Akbaltai's lion"},{"id":"semetey-1-2013:p0505:b005:l030","ordinal":115665,"en":"I would try a bout of spears."},{"id":"semetey-1-2013:p0505:b005:l031","ordinal":115666,"en":"“If I am speared by Chubak,"},{"id":"semetey-1-2013:p0505:b005:l032","ordinal":115667,"en":"Without letting a soul know,"},{"id":"semetey-1-2013:p0505:b005:l033","ordinal":115668,"en":"Without letting one person discover it,"},{"id":"semetey-1-2013:p0505:b005:l034","ordinal":115669,"en":"I shall submit to his demand,” I thought."},{"id":"semetey-1-2013:p0505:b005:l035","ordinal":115670,"en":"“As a gift, Bukhara's"},{"id":"semetey-1-2013:p0505:b005:l036","ordinal":115671,"en":"Golden throne I shall give,” I thought."},{"id":"semetey-1-2013:p0505:b005:l037","ordinal":115672,"en":"“If I spear Chubak,"},{"id":"semetey-1-2013:p0505:b005:l038","ordinal":115673,"en":"I shall bring disgrace upon his head,"},{"id":"semetey-1-2013:p0505:b005:l039","ordinal":115674,"en":"Drag him onto the road,"},{"id":"semetey-1-2013:p0506:b003:l001","ordinal":115675,"en":"Let me be of use to the hounds;"},{"id":"semetey-1-2013:p0506:b003:l002","ordinal":115676,"en":"On Khan Baltay's son"},{"id":"semetey-1-2013:p0506:b003:l003","ordinal":115677,"en":"Let me take my vengeance thus."},{"id":"semetey-1-2013:p0506:b003:l004","ordinal":115678,"en":"Allah Most High, Creator,"},{"id":"semetey-1-2013:p0506:b003:l005","ordinal":115679,"en":"If I am scattered, grant someone to gather me;"},{"id":"semetey-1-2013:p0506:b003:l006","ordinal":115680,"en":"If I die, grant me faith!"},{"id":"semetey-1-2013:p0506:b003:l007","ordinal":115681,"en":"What the Creator has written,"},{"id":"semetey-1-2013:p0506:b003:l008","ordinal":115682,"en":"If written on my brow, let me endure."},{"id":"semetey-1-2013:p0506:b003:l009","ordinal":115683,"en":"Against Khan Baltay's son"},{"id":"semetey-1-2013:p0506:b003:l010","ordinal":115684,"en":"Let me fight one spear duel and die!"},{"id":"semetey-1-2013:p0506:b003:l011","ordinal":115685,"en":"Wearing out my horse, ranging the land,"},{"id":"semetey-1-2013:p0506:b003:l012","ordinal":115686,"en":"From the saddle-shaped ridge"},{"id":"semetey-1-2013:p0506:b003:l013","ordinal":115687,"en":"I bent down and swept along,"},{"id":"semetey-1-2013:p0506:b003:l014","ordinal":115688,"en":"Roaming the great white feather-grass below."},{"id":"semetey-1-2013:p0506:b003:l015","ordinal":115689,"en":"Watching the suspicious road,"},{"id":"semetey-1-2013:p0506:b003:l016","ordinal":115690,"en":"Skirting lower Ken-Moynok,"},{"id":"semetey-1-2013:p0506:b003:l017","ordinal":115691,"en":"To the spur of Orolmo Mountain,"},{"id":"semetey-1-2013:p0506:b003:l018","ordinal":115692,"en":"To its jutting promontory,"},{"id":"semetey-1-2013:p0506:b003:l019","ordinal":115693,"en":"I turned and kept watch."},{"id":"semetey-1-2013:p0506:b003:l020","ordinal":115694,"en":"The black, white-blazed thoroughbred—"},{"id":"semetey-1-2013:p0506:b003:l021","ordinal":115695,"en":"When I drew its bit and turned it,"},{"id":"semetey-1-2013:p0506:b003:l022","ordinal":115696,"en":"Taking pleasure in riding abroad,"},{"id":"semetey-1-2013:p0506:b003:l023","ordinal":115697,"en":"As I watched from my lookout,"},{"id":"semetey-1-2013:p0506:b003:l024","ordinal":115698,"en":"Upon a red-chestnut horse,"},{"id":"semetey-1-2013:p0506:b003:l025","ordinal":115699,"en":"Its hair-tail tightly knotted,"},{"id":"semetey-1-2013:p0506:b003:l026","ordinal":115700,"en":"A fiddler in a house with daughters,"},{"id":"semetey-1-2013:p0506:b003:l027","ordinal":115701,"en":"A cupbearer in a house with kumys,"},{"id":"semetey-1-2013:p0506:b003:l028","ordinal":115702,"en":"An eloquent, clever entertainer,"},{"id":"semetey-1-2013:p0506:b003:l029","ordinal":115703,"en":"A favorite of girls,"},{"id":"semetey-1-2013:p0506:b003:l030","ordinal":115704,"en":"The elbow-sized hero Agysh,"},{"id":"semetey-1-2013:p0506:b003:l031","ordinal":115705,"en":"Doing as he pleased,"},{"id":"semetey-1-2013:p0506:b003:l032","ordinal":115706,"en":"With an eagle like Orolmo Mountain's White-Shoulder"},{"id":"semetey-1-2013:p0506:b003:l033","ordinal":115707,"en":"Perched without a forearm support,"},{"id":"semetey-1-2013:p0506:b003:l034","ordinal":115708,"en":"Came out hunting."},{"id":"semetey-1-2013:p0506:b003:l035","ordinal":115709,"en":"I knew he was a hero."},{"id":"semetey-1-2013:p0506:b003:l036","ordinal":115710,"en":"If unbeliever and Muslim"},{"id":"semetey-1-2013:p0506:b003:l037","ordinal":115711,"en":"Wrestled for the prize,"},{"id":"semetey-1-2013:p0506:b003:l038","ordinal":115712,"en":"Some help from Agysh"}]
