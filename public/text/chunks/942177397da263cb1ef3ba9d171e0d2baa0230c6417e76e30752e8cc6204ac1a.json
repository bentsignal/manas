[{"id":"semetey-2-2013:p1121:b003:l001","ordinal":271873,"en":"It seems we are to die a shameful death."},{"id":"semetey-2-2013:p1121:b003:l002","ordinal":271874,"en":"Whimpering like young pups,"},{"id":"semetey-2-2013:p1121:b003:l003","ordinal":271875,"en":"Are we to die miserably?"},{"id":"semetey-2-2013:p1121:b003:l004","ordinal":271876,"en":"Raising an uproar all together,"},{"id":"semetey-2-2013:p1121:b003:l005","ordinal":271877,"en":"At the hands of that gray-maned prince,"},{"id":"semetey-2-2013:p1121:b003:l006","ordinal":271878,"en":"Are we to die dishonorably?"},{"id":"semetey-2-2013:p1121:b003:l007","ordinal":271879,"en":"Did we come surging here merely"},{"id":"semetey-2-2013:p1121:b003:l008","ordinal":271880,"en":"To scatter and leave this world,"},{"id":"semetey-2-2013:p1121:b003:l009","ordinal":271881,"en":"Turning our faces toward Jeti-Suu,"},{"id":"semetey-2-2013:p1121:b003:l010","ordinal":271882,"en":"Slaughtered by that peerless lion,"},{"id":"semetey-2-2013:p1121:b003:l011","ordinal":271883,"en":"Only to flee away?"},{"id":"semetey-2-2013:p1121:b003:l012","ordinal":271884,"en":"We Jediger came surging forth—"},{"id":"semetey-2-2013:p1121:b003:l013","ordinal":271885,"en":"Are we not now firm as mountains and stone?"},{"id":"semetey-2-2013:p1121:b003:l014","ordinal":271886,"en":"Assailing the panther,"},{"id":"semetey-2-2013:p1121:b003:l015","ordinal":271887,"en":"Needlessly entangled in calamity,"},{"id":"semetey-2-2013:p1121:b003:l016","ordinal":271888,"en":"Are we to perish in ruin?"},{"id":"semetey-2-2013:p1121:b003:l017","ordinal":271889,"en":"With broad reins knotted in a loop,"},{"id":"semetey-2-2013:p1121:b003:l018","ordinal":271890,"en":"“Ah, hero, spare our lives!” we shall say—"},{"id":"semetey-2-2013:p1121:b003:l019","ordinal":271891,"en":"Are we to cast honor aside, place them"},{"id":"semetey-2-2013:p1121:b003:l020","ordinal":271892,"en":"Around our necks, and die?"},{"id":"semetey-2-2013:p1121:b003:l021","ordinal":271893,"en":"“Generous lord, spare our lives!”—"},{"id":"semetey-2-2013:p1121:b003:l022","ordinal":271894,"en":"Are we to die begging?"},{"id":"semetey-2-2013:p1121:b003:l023","ordinal":271895,"en":"Bearded men and elders"},{"id":"semetey-2-2013:p1121:b003:l024","ordinal":271896,"en":"Grew anxious and raised an uproar;"},{"id":"semetey-2-2013:p1121:b003:l025","ordinal":271897,"en":"All the Jediger and Kipchak wondered,"},{"id":"semetey-2-2013:p1121:b003:l026","ordinal":271898,"en":"“How can we ever reach"},{"id":"semetey-2-2013:p1121:b003:l027","ordinal":271899,"en":"The bounds of this bloodthirsty man blessed by Kydyr?"},{"id":"semetey-2-2013:p1121:b003:l028","ordinal":271900,"en":"Who would dare attack"},{"id":"semetey-2-2013:p1121:b003:l029","ordinal":271901,"en":"The lion Manas’s champion"},{"id":"semetey-2-2013:p1121:b003:l030","ordinal":271902,"en":"And the people left by that lion?"},{"id":"semetey-2-2013:p1121:b003:l031","ordinal":271903,"en":"Who could invade them?” they said."},{"id":"semetey-2-2013:p1121:b003:l032","ordinal":271904,"en":"“He is the son of the great lion;"},{"id":"semetey-2-2013:p1121:b003:l033","ordinal":271905,"en":"He will strike me in battle,” they said."},{"id":"semetey-2-2013:p1121:b003:l034","ordinal":271906,"en":"The people clamored, the nation roared;"},{"id":"semetey-2-2013:p1121:b003:l035","ordinal":271907,"en":"To recall it, there was great turmoil."},{"id":"semetey-2-2013:p1121:b003:l036","ordinal":271908,"en":"Some men drew close"},{"id":"semetey-2-2013:p1121:b003:l037","ordinal":271909,"en":"And spoke among themselves,"},{"id":"semetey-2-2013:p1121:b003:l038","ordinal":271910,"en":"While others leaned together"},{"id":"semetey-2-2013:p1121:b003:l039","ordinal":271911,"en":"And whispered among themselves."},{"id":"semetey-2-2013:p1121:b005:l001","ordinal":271912,"en":"They returned in grief;"},{"id":"semetey-2-2013:p1121:b005:l002","ordinal":271913,"en":"Wretched women and young children asked,"},{"id":"semetey-2-2013:p1121:b005:l003","ordinal":271914,"en":"“What will happen now?”"},{"id":"semetey-2-2013:p1121:b005:l004","ordinal":271915,"en":"And spoke their last wishes."},{"id":"semetey-2-2013:p1121:b005:l005","ordinal":271916,"en":"When the matter was discussed, great turmoil arose;"},{"id":"semetey-2-2013:p1121:b005:l006","ordinal":271917,"en":"The Jediger entered the fray,"},{"id":"semetey-2-2013:p1121:b005:l007","ordinal":271918,"en":"Planning with care and reckoning the task;"},{"id":"semetey-2-2013:p1121:b005:l008","ordinal":271919,"en":"The Jediger plunged into the uproar."},{"id":"semetey-2-2013:p1121:b005:l009","ordinal":271920,"en":"Some stood stubbornly firm,"},{"id":"semetey-2-2013:p1121:b005:l010","ordinal":271921,"en":"Crossing their steel-tipped spears;"},{"id":"semetey-2-2013:p1121:b005:l011","ordinal":271922,"en":"Some, in their anguish,"},{"id":"semetey-2-2013:p1121:b005:l012","ordinal":271923,"en":"Abandoned all care for life."},{"id":"semetey-2-2013:p1121:b005:l013","ordinal":271924,"en":"The people swarmed, the lake heaved;"},{"id":"semetey-2-2013:p1121:b005:l014","ordinal":271925,"en":"Their host was vast beyond counting."},{"id":"semetey-2-2013:p1121:b005:l015","ordinal":271926,"en":"They drew their bows and rained down arrows;"},{"id":"semetey-2-2013:p1121:b005:l016","ordinal":271927,"en":"Brave Kyyaz charged with them all."},{"id":"semetey-2-2013:p1121:b005:l017","ordinal":271928,"en":"Swinging his sword and thrusting his spear,"},{"id":"semetey-2-2013:p1121:b005:l018","ordinal":271929,"en":"Brave Kyyaz plunged into the battle,"},{"id":"semetey-2-2013:p1121:b005:l019","ordinal":271930,"en":"Roaring as he poured out his wrath,"},{"id":"semetey-2-2013:p1121:b005:l020","ordinal":271931,"en":"Raising the battle cry, “Kyyaz!”"},{"id":"semetey-2-2013:p1121:b005:l021","ordinal":271932,"en":"The two sides faced one another,"},{"id":"semetey-2-2013:p1121:b005:l022","ordinal":271933,"en":"Firing muskets and drawing bows,"},{"id":"semetey-2-2013:p1121:b005:l023","ordinal":271934,"en":"Fighting with utter disregard for life;"},{"id":"semetey-2-2013:p1121:b005:l024","ordinal":271935,"en":"A terrible conflict broke out."},{"id":"semetey-2-2013:p1121:b005:l025","ordinal":271936,"en":"They stood locked in battle."},{"id":"semetey-2-2013:p1121:b005:l026","ordinal":271937,"en":"Then Külchoro appeared,"},{"id":"semetey-2-2013:p1121:b005:l027","ordinal":271938,"en":"Choro the lion, upheld by the spirits,"},{"id":"semetey-2-2013:p1121:b005:l028","ordinal":271939,"en":"Agile beyond imagining,"},{"id":"semetey-2-2013:p1121:b005:l029","ordinal":271940,"en":"The fiercely clashing warrior Choro,"},{"id":"semetey-2-2013:p1121:b005:l030","ordinal":271941,"en":"Choro, perfectly formed in every limb,"},{"id":"semetey-2-2013:p1121:b005:l031","ordinal":271942,"en":"Who had slaughtered not only Kyrgyz"},{"id":"semetey-2-2013:p1121:b005:l032","ordinal":271943,"en":"But Chinese armies too."},{"id":"semetey-2-2013:p1121:b005:l033","ordinal":271944,"en":"Then Külchoro"},{"id":"semetey-2-2013:p1121:b005:l034","ordinal":271945,"en":"Made all his weapons ready"},{"id":"semetey-2-2013:p1121:b005:l035","ordinal":271946,"en":"And buckled his sword at his side."},{"id":"semetey-2-2013:p1121:b005:l036","ordinal":271947,"en":"The Jediger were ten thousand; he was alone."},{"id":"semetey-2-2013:p1121:b005:l037","ordinal":271948,"en":"All the agony of cherished life"},{"id":"semetey-2-2013:p1121:b005:l038","ordinal":271949,"en":"Külchoro endured;"},{"id":"semetey-2-2013:p1121:b005:l039","ordinal":271950,"en":"He fought having cast life aside."},{"id":"semetey-2-2013:p1122:b003:l001","ordinal":271951,"en":"Külchoro walked amid death."},{"id":"semetey-2-2013:p1122:b003:l002","ordinal":271952,"en":"His frail life cried out,"},{"id":"semetey-2-2013:p1122:b003:l003","ordinal":271953,"en":"Every bone in his body ached,"},{"id":"semetey-2-2013:p1122:b003:l004","ordinal":271954,"en":"His heart was torn into a thousand pieces,"},{"id":"semetey-2-2013:p1122:b003:l005","ordinal":271955,"en":"And tears poured from his eyes."},{"id":"semetey-2-2013:p1122:b003:l006","ordinal":271956,"en":"The Jediger’s black banner"},{"id":"semetey-2-2013:p1122:b003:l007","ordinal":271957,"en":"And their earth-shaking uproar"},{"id":"semetey-2-2013:p1122:b003:l008","ordinal":271958,"en":"Appeared before him."},{"id":"semetey-2-2013:p1122:b003:l009","ordinal":271959,"en":"Ah, your hero Külchoro thought,"},{"id":"semetey-2-2013:p1122:b003:l010","ordinal":271960,"en":"“If my destined hour has come, let me die;"},{"id":"semetey-2-2013:p1122:b003:l011","ordinal":271961,"en":"But if the falcon of the moon,"},{"id":"semetey-2-2013:p1122:b003:l012","ordinal":271962,"en":"The gray-maned hero Semetey,"},{"id":"semetey-2-2013:p1122:b003:l013","ordinal":271963,"en":"Is alive to stand over me,"},{"id":"semetey-2-2013:p1122:b003:l014","ordinal":271964,"en":"And still walks unharmed,"},{"id":"semetey-2-2013:p1122:b003:l015","ordinal":271965,"en":"What inheritance could I hope to receive"},{"id":"semetey-2-2013:p1122:b003:l016","ordinal":271966,"en":"Before my lion uncle"},{"id":"semetey-2-2013:p1122:b003:l017","ordinal":271967,"en":"If I spared this sly life"},{"id":"semetey-2-2013:p1122:b003:l018","ordinal":271968,"en":"And valued it even as a hair?”"},{"id":"semetey-2-2013:p1122:b003:l019","ordinal":271969,"en":"Your lion Choro’s cry split stone,"},{"id":"semetey-2-2013:p1122:b003:l020","ordinal":271970,"en":"His roar shattered heads."},{"id":"semetey-2-2013:p1122:b003:l021","ordinal":271971,"en":"He charged like a black lion,"},{"id":"semetey-2-2013:p1122:b003:l022","ordinal":271972,"en":"And wisdom came to him from the unseen."},{"id":"semetey-2-2013:p1122:b003:l023","ordinal":271973,"en":"Through their chiefs and champions,"},{"id":"semetey-2-2013:p1122:b003:l024","ordinal":271974,"en":"Through the warriors who entered the clash,"},{"id":"semetey-2-2013:p1122:b003:l025","ordinal":271975,"en":"Külchoro broke his way."},{"id":"semetey-2-2013:p1122:b003:l026","ordinal":271976,"en":"Among the Jediger who covered the earth,"},{"id":"semetey-2-2013:p1122:b003:l027","ordinal":271977,"en":"He attacked and cut a path alone;"},{"id":"semetey-2-2013:p1122:b003:l028","ordinal":271978,"en":"Külchoro went forth to rout them."},{"id":"semetey-2-2013:p1122:b003:l029","ordinal":271979,"en":"Their heroes and champions"},{"id":"semetey-2-2013:p1122:b003:l030","ordinal":271980,"en":"Külchoro bound as he advanced;"},{"id":"semetey-2-2013:p1122:b003:l031","ordinal":271981,"en":"The Jediger who boasted of their strength"},{"id":"semetey-2-2013:p1122:b003:l032","ordinal":271982,"en":"Külchoro drove before him."},{"id":"semetey-2-2013:p1122:b003:l033","ordinal":271983,"en":"He girded his slender waist,"},{"id":"semetey-2-2013:p1122:b003:l034","ordinal":271984,"en":"And against the Jediger covering the earth"},{"id":"semetey-2-2013:p1122:b003:l035","ordinal":271985,"en":"He charged alone,"},{"id":"semetey-2-2013:p1122:b003:l036","ordinal":271986,"en":"Raising the battle cry, “Manas!”"},{"id":"semetey-2-2013:p1122:b003:l037","ordinal":271987,"en":"When he reached the earth-filling Jediger,"},{"id":"semetey-2-2013:p1122:b003:l038","ordinal":271988,"en":"He struck and scattered their ranks."},{"id":"semetey-2-2013:p1122:b003:l039","ordinal":271989,"en":"Wherever his spear could reach,"},{"id":"semetey-2-2013:p1122:b004:l001","ordinal":271990,"en":"He crushed them with his spear;"},{"id":"semetey-2-2013:p1122:b004:l002","ordinal":271991,"en":"When anyone was caught upon its point,"},{"id":"semetey-2-2013:p1122:b004:l003","ordinal":271992,"en":"Your mighty lion Choro"},{"id":"semetey-2-2013:p1122:b004:l004","ordinal":271993,"en":"Ran him through and flung him away."},{"id":"semetey-2-2013:p1122:b004:l005","ordinal":271994,"en":"Wherever his battle-axe could reach,"},{"id":"semetey-2-2013:p1122:b004:l006","ordinal":271995,"en":"He hewed them with the axe;"},{"id":"semetey-2-2013:p1122:b004:l007","ordinal":271996,"en":"Lion Choro surged among them."},{"id":"semetey-2-2013:p1122:b004:l008","ordinal":271997,"en":"Wherever his sword could reach,"},{"id":"semetey-2-2013:p1122:b004:l009","ordinal":271998,"en":"He sliced them with the blade;"},{"id":"semetey-2-2013:p1122:b004:l010","ordinal":271999,"en":"Your Külchoro carved through them."},{"id":"semetey-2-2013:p1122:b004:l011","ordinal":272000,"en":"Roaring as he poured out his wrath,"},{"id":"semetey-2-2013:p1122:b004:l012","ordinal":272001,"en":"He scattered the Jediger,"},{"id":"semetey-2-2013:p1122:b004:l013","ordinal":272002,"en":"Spearing everyone he overtook,"},{"id":"semetey-2-2013:p1122:b004:l014","ordinal":272003,"en":"Searching, “Where is Kyyaz, the cur?”"},{"id":"semetey-2-2013:p1122:b004:l015","ordinal":272004,"en":"He speared the common soldiers,"},{"id":"semetey-2-2013:p1122:b004:l016","ordinal":272005,"en":"Searching, “Where is that villain Kyyaz?”"},{"id":"semetey-2-2013:p1122:b004:l017","ordinal":272006,"en":"He raced in pursuit behind them."},{"id":"semetey-2-2013:p1122:b004:l018","ordinal":272007,"en":"“Let those fated to die, die;"},{"id":"semetey-2-2013:p1122:b004:l019","ordinal":272008,"en":"And let those who remain alive"},{"id":"semetey-2-2013:p1122:b004:l020","ordinal":272009,"en":"Endure many calamities."},{"id":"semetey-2-2013:p1122:b004:l021","ordinal":272010,"en":"Let them lose their wits in terror;"},{"id":"semetey-2-2013:p1122:b004:l022","ordinal":272011,"en":"From this day on, let the Jediger"},{"id":"semetey-2-2013:p1122:b004:l023","ordinal":272012,"en":"Say, ‘Dear lord, we submit,’"},{"id":"semetey-2-2013:p1122:b004:l024","ordinal":272013,"en":"And crawl into a pit.”"},{"id":"semetey-2-2013:p1122:b004:l025","ordinal":272014,"en":"He raced upon his thoroughbred,"},{"id":"semetey-2-2013:p1122:b004:l026","ordinal":272015,"en":"And every giant warrior"},{"id":"semetey-2-2013:p1122:b004:l027","ordinal":272016,"en":"Who ventured near him"},{"id":"semetey-2-2013:p1122:b004:l028","ordinal":272017,"en":"He seized by the shins and hurled away."},{"id":"semetey-2-2013:p1122:b004:l029","ordinal":272018,"en":"At the sight of Külchoro,"},{"id":"semetey-2-2013:p1122:b004:l030","ordinal":272019,"en":"The Jediger crossed"},{"id":"semetey-2-2013:p1122:b004:l031","ordinal":272020,"en":"The foothills of Üch-Koshoy;"},{"id":"semetey-2-2013:p1122:b004:l032","ordinal":272021,"en":"As if a falcon had struck a bustard,"},{"id":"semetey-2-2013:p1122:b004:l033","ordinal":272022,"en":"The Jediger fled."},{"id":"semetey-2-2013:p1122:b004:l034","ordinal":272023,"en":"“Alas, prince, we submit!"},{"id":"semetey-2-2013:p1122:b004:l035","ordinal":272024,"en":"We shall not attack—we surrender!”"},{"id":"semetey-2-2013:p1122:b004:l036","ordinal":272025,"en":"“We yield!” they cried,"},{"id":"semetey-2-2013:p1122:b004:l037","ordinal":272026,"en":"“We are defeated!” and then"},{"id":"semetey-2-2013:p1122:b004:l038","ordinal":272027,"en":"They called out to Külchoro."},{"id":"semetey-2-2013:p1122:b004:l039","ordinal":272028,"en":"Despairing of their fly-like lives,"},{"id":"semetey-2-2013:p1123:b003:l001","ordinal":272029,"en":"They dismounted and ran to him."},{"id":"semetey-2-2013:p1123:b003:l002","ordinal":272030,"en":"The reins knotted into loops"},{"id":"semetey-2-2013:p1123:b003:l003","ordinal":272031,"en":"They placed around their necks;"},{"id":"semetey-2-2013:p1123:b003:l004","ordinal":272032,"en":"The great mass of black-clad Jediger"},{"id":"semetey-2-2013:p1123:b003:l005","ordinal":272033,"en":"Begged him to spare their lives."},{"id":"semetey-2-2013:p1123:b003:l006","ordinal":272034,"en":"The people clamored in uproar;"},{"id":"semetey-2-2013:p1123:b003:l007","ordinal":272035,"en":"It was a grievous conflict."},{"id":"semetey-2-2013:p1123:b003:l008","ordinal":272036,"en":"As they were destroyed, the people cried out,"},{"id":"semetey-2-2013:p1123:b003:l009","ordinal":272037,"en":"Despairing of their wretched lives:"},{"id":"semetey-2-2013:p1123:b003:l010","ordinal":272038,"en":"“This terrible calamity, this great conflict,"},{"id":"semetey-2-2013:p1123:b003:l011","ordinal":272039,"en":"Will slaughter us all!”"},{"id":"semetey-2-2013:p1123:b003:l012","ordinal":272040,"en":"Despairing of their wretched lives,"},{"id":"semetey-2-2013:p1123:b003:l013","ordinal":272041,"en":"Some would not remain still"},{"id":"semetey-2-2013:p1123:b003:l014","ordinal":272042,"en":"But rushed about in panic;"},{"id":"semetey-2-2013:p1123:b003:l015","ordinal":272043,"en":"Some wounded Jediger"},{"id":"semetey-2-2013:p1123:b003:l016","ordinal":272044,"en":"Fled toward the mountains."},{"id":"semetey-2-2013:p1123:b003:l017","ordinal":272045,"en":"Dust rose and haze covered the land;"},{"id":"semetey-2-2013:p1123:b003:l018","ordinal":272046,"en":"Calamity filled the world."},{"id":"semetey-2-2013:p1123:b003:l019","ordinal":272047,"en":"They scattered in every direction,"},{"id":"semetey-2-2013:p1123:b003:l020","ordinal":272048,"en":"And while they milled about in distress,"},{"id":"semetey-2-2013:p1123:b003:l021","ordinal":272049,"en":"Külchoro proved a true falcon,"},{"id":"semetey-2-2013:p1123:b003:l022","ordinal":272050,"en":"Waging a wondrous battle."},{"id":"semetey-2-2013:p1123:b003:l023","ordinal":272051,"en":"From among all the Jediger,"},{"id":"semetey-2-2013:p1123:b003:l024","ordinal":272052,"en":"Kadyrbay and Tölöbay—"},{"id":"semetey-2-2013:p1123:b003:l025","ordinal":272053,"en":"Elders risen from the people,"},{"id":"semetey-2-2013:p1123:b003:l026","ordinal":272054,"en":"Men of wisdom who knew the proper words,"},{"id":"semetey-2-2013:p1123:b003:l027","ordinal":272055,"en":"True sages among them—"},{"id":"semetey-2-2013:p1123:b003:l028","ordinal":272056,"en":"Kadyrbay hurried forth,"},{"id":"semetey-2-2013:p1123:b003:l029","ordinal":272057,"en":"Dismounted and composed himself,"},{"id":"semetey-2-2013:p1123:b003:l030","ordinal":272058,"en":"And there the falcon stood"},{"id":"semetey-2-2013:p1123:b003:l031","ordinal":272059,"en":"Pleading with Külchoro:"},{"id":"semetey-2-2013:p1123:b003:l032","ordinal":272060,"en":"“When we raid horses, our dust rises together;"},{"id":"semetey-2-2013:p1123:b003:l033","ordinal":272061,"en":"Our roots are one, our lives are one."},{"id":"semetey-2-2013:p1123:b003:l034","ordinal":272062,"en":"Across the breadth of Jeti-Özön"},{"id":"semetey-2-2013:p1123:b003:l035","ordinal":272063,"en":"The multitude lies dead—"},{"id":"semetey-2-2013:p1123:b003:l036","ordinal":272064,"en":"Hero, what guilt does the common nation bear?"},{"id":"semetey-2-2013:p1123:b003:l037","ordinal":272065,"en":"The whole mass of black-clad Jediger,"},{"id":"semetey-2-2013:p1123:b003:l038","ordinal":272066,"en":"Every one of us, elders and all,"},{"id":"semetey-2-2013:p1123:b003:l039","ordinal":272067,"en":"Was beaten and battered"},{"id":"semetey-2-2013:p1123:b005:l001","ordinal":272068,"en":"And driven here together."},{"id":"semetey-2-2013:p1123:b005:l002","ordinal":272069,"en":"We encountered Kembay;"},{"id":"semetey-2-2013:p1123:b005:l003","ordinal":272070,"en":"Each of us was brought here."},{"id":"semetey-2-2013:p1123:b005:l004","ordinal":272071,"en":"Forced to become an army,"},{"id":"semetey-2-2013:p1123:b005:l005","ordinal":272072,"en":"Every one of us was driven here."},{"id":"semetey-2-2013:p1123:b005:l006","ordinal":272073,"en":"Is it not our khan who is a fool?"},{"id":"semetey-2-2013:p1123:b005:l007","ordinal":272074,"en":"What guilt does the common nation bear?"},{"id":"semetey-2-2013:p1123:b005:l008","ordinal":272075,"en":"Is it not our leader who is a fool?"},{"id":"semetey-2-2013:p1123:b005:l009","ordinal":272076,"en":"What guilt do all the people bear?"},{"id":"semetey-2-2013:p1123:b005:l010","ordinal":272077,"en":"A witless khan grows rabid;"},{"id":"semetey-2-2013:p1123:b005:l011","ordinal":272078,"en":"May no khan swell with such madness."},{"id":"semetey-2-2013:p1123:b005:l012","ordinal":272079,"en":"Sowing discord among his people,"},{"id":"semetey-2-2013:p1123:b005:l013","ordinal":272080,"en":"He turns ravenously upon his subjects."},{"id":"semetey-2-2013:p1123:b005:l014","ordinal":272081,"en":"A foolish khan raves,"},{"id":"semetey-2-2013:p1123:b005:l015","ordinal":272082,"en":"Gathers the entire nation,"},{"id":"semetey-2-2013:p1123:b005:l016","ordinal":272083,"en":"Brings misery upon his people,"},{"id":"semetey-2-2013:p1123:b005:l017","ordinal":272084,"en":"And slaughters his subjects."},{"id":"semetey-2-2013:p1123:b005:l018","ordinal":272085,"en":"If you are a hero, if you are a lion,"},{"id":"semetey-2-2013:p1123:b005:l019","ordinal":272086,"en":"Slay brave Kyyaz,"},{"id":"semetey-2-2013:p1123:b005:l020","ordinal":272087,"en":"But restrain your anger."},{"id":"semetey-2-2013:p1123:b005:l021","ordinal":272088,"en":"Brave Kyyaz’s wild undertaking"},{"id":"semetey-2-2013:p1123:b005:l022","ordinal":272089,"en":"And the turmoil that has shaken the nation"},{"id":"semetey-2-2013:p1123:b005:l023","ordinal":272090,"en":"Are the villainy of Kanchoro.”"},{"id":"semetey-2-2013:p1123:b005:l024","ordinal":272091,"en":"So Kadyrbay raised an uproar"},{"id":"semetey-2-2013:p1123:b005:l025","ordinal":272092,"en":"And lamented bitterly:"},{"id":"semetey-2-2013:p1123:b005:l026","ordinal":272093,"en":"“We shall not assail your khan;"},{"id":"semetey-2-2013:p1123:b005:l027","ordinal":272094,"en":"Our seed and blood are one."},{"id":"semetey-2-2013:p1123:b005:l028","ordinal":272095,"en":"Ah, hero Külchoro,"},{"id":"semetey-2-2013:p1123:b005:l029","ordinal":272096,"en":"We all submit to you;"},{"id":"semetey-2-2013:p1123:b005:l030","ordinal":272097,"en":"Restrain your anger."},{"id":"semetey-2-2013:p1123:b005:l031","ordinal":272098,"en":"Do not destroy the innocent people."},{"id":"semetey-2-2013:p1123:b005:l032","ordinal":272099,"en":"Here are the cities and settled lands;"},{"id":"semetey-2-2013:p1123:b005:l033","ordinal":272100,"en":"If you would spill blood, here we are."},{"id":"semetey-2-2013:p1123:b005:l034","ordinal":272101,"en":"Here is the ground where heroes lie;"},{"id":"semetey-2-2013:p1123:b005:l035","ordinal":272102,"en":"If you would cut off heads, here we are."},{"id":"semetey-2-2013:p1123:b005:l036","ordinal":272103,"en":"If you will receive them, here are the people;"},{"id":"semetey-2-2013:p1123:b005:l037","ordinal":272104,"en":"Do not kill everyone who comes."},{"id":"semetey-2-2013:p1123:b005:l038","ordinal":272105,"en":"Do not unleash the fury of battle;"},{"id":"semetey-2-2013:p1123:b005:l039","ordinal":272106,"en":"Heed the words we have spoken."},{"id":"semetey-2-2013:p1124:b003:l001","ordinal":272107,"en":"These Kyrgyz will become your people;"},{"id":"semetey-2-2013:p1124:b003:l002","ordinal":272108,"en":"Spare them and do not slaughter them."},{"id":"semetey-2-2013:p1124:b003:l003","ordinal":272109,"en":"While we lived in Jeti-Özön,"},{"id":"semetey-2-2013:p1124:b003:l004","ordinal":272110,"en":"Brave Kyyaz of the Jediger"},{"id":"semetey-2-2013:p1124:b003:l005","ordinal":272111,"en":"Drove out your white-bearded elders"},{"id":"semetey-2-2013:p1124:b003:l006","ordinal":272112,"en":"And all the people with them."},{"id":"semetey-2-2013:p1124:b003:l007","ordinal":272113,"en":"Some he imprisoned;"},{"id":"semetey-2-2013:p1124:b003:l008","ordinal":272114,"en":"Others he simply"},{"id":"semetey-2-2013:p1124:b003:l009","ordinal":272115,"en":"Beat without mercy."},{"id":"semetey-2-2013:p1124:b003:l010","ordinal":272116,"en":"Some people he plundered,"},{"id":"semetey-2-2013:p1124:b003:l011","ordinal":272117,"en":"Aggrieving and humiliating them;"},{"id":"semetey-2-2013:p1124:b003:l012","ordinal":272118,"en":"He withered their fly-like lives"},{"id":"semetey-2-2013:p1124:b003:l013","ordinal":272119,"en":"And drove them here by force."},{"id":"semetey-2-2013:p1124:b003:l014","ordinal":272120,"en":"Is not Kyyaz the fool?"},{"id":"semetey-2-2013:p1124:b003:l015","ordinal":272121,"en":"What guilt do the slaughtered people bear?"},{"id":"semetey-2-2013:p1124:b003:l016","ordinal":272122,"en":"Is not your khan the fool?"},{"id":"semetey-2-2013:p1124:b003:l017","ordinal":272123,"en":"What guilt does the common nation bear?"},{"id":"semetey-2-2013:p1124:b003:l018","ordinal":272124,"en":"The people are treasure, the nation an inheritance."},{"id":"semetey-2-2013:p1124:b003:l019","ordinal":272125,"en":"My panther prince, do not slaughter your people."},{"id":"semetey-2-2013:p1124:b003:l020","ordinal":272126,"en":"When the horn is broken, strength is lost;"},{"id":"semetey-2-2013:p1124:b003:l021","ordinal":272127,"en":"When the udder is crushed and gone,"},{"id":"semetey-2-2013:p1124:b003:l022","ordinal":272128,"en":"The milk that sustains life is lost."}]
