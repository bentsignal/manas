[{"id":"semetey-1-2013:p0878:b003:l029","ordinal":144129,"en":"All stood against them,"},{"id":"semetey-1-2013:p0878:b003:l030","ordinal":144130,"en":"Fighting without sparing their lives."},{"id":"semetey-1-2013:p0878:b003:l031","ordinal":144131,"en":"At Chachykei's fortress,"},{"id":"semetey-1-2013:p0878:b003:l032","ordinal":144132,"en":"At Kanykei's royal court,"},{"id":"semetey-1-2013:p0878:b003:l033","ordinal":144133,"en":"Khan Manas's forty warriors"},{"id":"semetey-1-2013:p0878:b003:l034","ordinal":144134,"en":"Formed a circle,"},{"id":"semetey-1-2013:p0878:b003:l035","ordinal":144135,"en":"And enclosed it in their midst."},{"id":"semetey-1-2013:p0878:b003:l036","ordinal":144136,"en":"Grappling with khagans,"},{"id":"semetey-1-2013:p0878:b003:l037","ordinal":144137,"en":"The forty warriors had become seasoned."},{"id":"semetey-1-2013:p0878:b003:l038","ordinal":144138,"en":"When dear Manas lived,"},{"id":"semetey-1-2013:p0878:b003:l039","ordinal":144139,"en":"Fighting lance battles with many foes,"},{"id":"semetey-1-2013:p0878:b004:l001","ordinal":144140,"en":"The forty warriors had grown experienced."},{"id":"semetey-1-2013:p0878:b004:l002","ordinal":144141,"en":"Their eyes blazed like fire,"},{"id":"semetey-1-2013:p0878:b004:l003","ordinal":144142,"en":"Their bloodlust seized them."},{"id":"semetey-1-2013:p0878:b004:l004","ordinal":144143,"en":"With shrill shouts and ringing battle cries,"},{"id":"semetey-1-2013:p0878:b004:l005","ordinal":144144,"en":"No man could match them in a struggle,"},{"id":"semetey-1-2013:p0878:b004:l006","ordinal":144145,"en":"No beast's teeth could pierce them."},{"id":"semetey-1-2013:p0878:b004:l007","ordinal":144146,"en":"The forty warriors advanced in a fury,"},{"id":"semetey-1-2013:p0878:b004:l008","ordinal":144147,"en":"Speaking against the only son Semetey:"},{"id":"semetey-1-2013:p0878:b004:l009","ordinal":144148,"en":"‘To Temir Khan's city,"},{"id":"semetey-1-2013:p0878:b004:l010","ordinal":144149,"en":"The orphan who wandered away—"},{"id":"semetey-1-2013:p0878:b004:l011","ordinal":144150,"en":"Trample him and seize him!"},{"id":"semetey-1-2013:p0878:b004:l012","ordinal":144151,"en":"Drag him out upon the road,"},{"id":"semetey-1-2013:p0878:b004:l013","ordinal":144152,"en":"And slaughter him as a sacrifice!"},{"id":"semetey-1-2013:p0878:b004:l014","ordinal":144153,"en":"Drag Kanykei out,"},{"id":"semetey-1-2013:p0878:b004:l015","ordinal":144154,"en":"And tear her apart for the great hounds."},{"id":"semetey-1-2013:p0878:b004:l016","ordinal":144155,"en":"Beat old Bakai with clubs,"},{"id":"semetey-1-2013:p0878:b004:l017","ordinal":144156,"en":"And put him behind a camel."},{"id":"semetey-1-2013:p0878:b004:l018","ordinal":144157,"en":"Sary Taz, who stirred up trouble—"},{"id":"semetey-1-2013:p0878:b004:l019","ordinal":144158,"en":"Gouge out his eyes!"},{"id":"semetey-1-2013:p0878:b004:l020","ordinal":144159,"en":"Seize him, seize him, seize him!"},{"id":"semetey-1-2013:p0878:b004:l021","ordinal":144160,"en":"Bind the orphan slave!’ they cried."},{"id":"semetey-1-2013:p0878:b004:l022","ordinal":144161,"en":"Unable to reach the great court,"},{"id":"semetey-1-2013:p0878:b004:l023","ordinal":144162,"en":"Nor daring to go in against the boy,"},{"id":"semetey-1-2013:p0878:b004:l024","ordinal":144163,"en":"They took turns,"},{"id":"semetey-1-2013:p0878:b004:l025","ordinal":144164,"en":"Firing their guns."},{"id":"semetey-1-2013:p0878:b004:l026","ordinal":144165,"en":"They stood unable to enter,"},{"id":"semetey-1-2013:p0878:b004:l027","ordinal":144166,"en":"And fought with their guns."},{"id":"semetey-1-2013:p0878:b004:l028","ordinal":144167,"en":"The forty skilled companions,"},{"id":"semetey-1-2013:p0878:b004:l029","ordinal":144168,"en":"Broad-mouthed, painted arrows—"},{"id":"semetey-1-2013:p0878:b004:l030","ordinal":144169,"en":"Their fighting was a wondrous tale."},{"id":"semetey-1-2013:p0878:b004:l031","ordinal":144170,"en":"All were warriors left by Manas."},{"id":"semetey-1-2013:p0878:b004:l032","ordinal":144171,"en":"Sarybai shot a hundred shafts,"},{"id":"semetey-1-2013:p0878:b004:l033","ordinal":144172,"en":"Taking the gun Kok Chybyk in hand,"},{"id":"semetey-1-2013:p0878:b004:l034","ordinal":144173,"en":"Art with such blood,"},{"id":"semetey-1-2013:p0878:b004:l035","ordinal":144174,"en":"Mingling sound with sound,"},{"id":"semetey-1-2013:p0878:b004:l036","ordinal":144175,"en":"They fired with a mighty thunder."},{"id":"semetey-1-2013:p0878:b004:l037","ordinal":144176,"en":"As they fired without sparing themselves,"},{"id":"semetey-1-2013:p0878:b004:l038","ordinal":144177,"en":"The short guns in their hands"},{"id":"semetey-1-2013:p0878:b004:l039","ordinal":144178,"en":"Joined their voices together,"},{"id":"semetey-1-2013:p0879:b003:l001","ordinal":144179,"en":"Smoke streamed from their mouths."},{"id":"semetey-1-2013:p0879:b003:l002","ordinal":144180,"en":"The steel guns' bullets shrieked;"},{"id":"semetey-1-2013:p0879:b003:l003","ordinal":144181,"en":"Chipping away with every hit,"},{"id":"semetey-1-2013:p0879:b003:l004","ordinal":144182,"en":"The court's walls crumbled."},{"id":"semetey-1-2013:p0879:b003:l005","ordinal":144183,"en":"The guns' voices clattered,"},{"id":"semetey-1-2013:p0879:b003:l006","ordinal":144184,"en":"The arrows pattered."},{"id":"semetey-1-2013:p0879:b003:l007","ordinal":144185,"en":"God, do not let us see their faces!"},{"id":"semetey-1-2013:p0879:b003:l008","ordinal":144186,"en":"Like peas roasting,"},{"id":"semetey-1-2013:p0879:b003:l009","ordinal":144187,"en":"They stood without sparing themselves,"},{"id":"semetey-1-2013:p0879:b003:l010","ordinal":144188,"en":"And all fought together."},{"id":"semetey-1-2013:p0879:b003:l011","ordinal":144189,"en":"With the forty warriors at their head,"},{"id":"semetey-1-2013:p0879:b003:l012","ordinal":144190,"en":"They all swept down together."},{"id":"semetey-1-2013:p0879:b003:l013","ordinal":144191,"en":"Your orphan's court"},{"id":"semetey-1-2013:p0879:b003:l014","ordinal":144192,"en":"They encircled twelve times."},{"id":"semetey-1-2013:p0879:b003:l015","ordinal":144193,"en":"Saying this then,"},{"id":"semetey-1-2013:p0879:b003:l016","ordinal":144194,"en":"It's gone now."},{"id":"semetey-1-2013:p0879:b003:l017","ordinal":144195,"en":"Look at the haze, look at the fire!"},{"id":"semetey-1-2013:p0879:b003:l018","ordinal":144196,"en":"Almighty One, whose command is strong,"},{"id":"semetey-1-2013:p0879:b003:l019","ordinal":144197,"en":"Look at the bullets striking without turning aside!"},{"id":"semetey-1-2013:p0879:b003:l020","ordinal":144198,"en":"When they came to besiege it,"},{"id":"semetey-1-2013:p0879:b003:l021","ordinal":144199,"en":"Gray haze and burning dust arose."},{"id":"semetey-1-2013:p0879:b003:l022","ordinal":144200,"en":"‘What will become of my only son?’"},{"id":"semetey-1-2013:p0879:b003:l023","ordinal":144201,"en":"Two souls stood weeping."},{"id":"semetey-1-2013:p0879:b003:l024","ordinal":144202,"en":"‘The orphan who does not stir—"},{"id":"semetey-1-2013:p0879:b003:l025","ordinal":144203,"en":"They may suddenly overwhelm him."},{"id":"semetey-1-2013:p0879:b003:l026","ordinal":144204,"en":"The orphan gained through mortal suffering—"},{"id":"semetey-1-2013:p0879:b003:l027","ordinal":144205,"en":"His death may come needlessly,’ they thought."},{"id":"semetey-1-2013:p0879:b003:l028","ordinal":144206,"en":"That valiant mother of yours, Kanykei,"},{"id":"semetey-1-2013:p0879:b003:l029","ordinal":144207,"en":"Her heart greatly troubled,"},{"id":"semetey-1-2013:p0879:b003:l030","ordinal":144208,"en":"Tears pouring from her eyes,"},{"id":"semetey-1-2013:p0879:b003:l031","ordinal":144209,"en":"Allah's sun clouded in the heavens,"},{"id":"semetey-1-2013:p0879:b003:l032","ordinal":144210,"en":"Sixty anxieties came upon her at once."},{"id":"semetey-1-2013:p0879:b003:l033","ordinal":144211,"en":"Your valiant mother Kanykei—"},{"id":"semetey-1-2013:p0879:b003:l034","ordinal":144212,"en":"Do not ask of the unfortunate woman's plight."},{"id":"semetey-1-2013:p0879:b003:l035","ordinal":144213,"en":"Almambet's painted musket"},{"id":"semetey-1-2013:p0879:b003:l036","ordinal":144214,"en":"She took into her hands."},{"id":"semetey-1-2013:p0879:b003:l037","ordinal":144215,"en":"Leaning to the right, she fired once,"},{"id":"semetey-1-2013:p0879:b003:l038","ordinal":144216,"en":"Knocked down ten"},{"id":"semetey-1-2013:p0879:b003:l039","ordinal":144217,"en":"Leaning to the left, she fired once,"},{"id":"semetey-1-2013:p0879:b004:l001","ordinal":144218,"en":"And felled their sultans."},{"id":"semetey-1-2013:p0879:b004:l002","ordinal":144219,"en":"Without revealing she was a woman,"},{"id":"semetey-1-2013:p0879:b004:l003","ordinal":144220,"en":"Those dogs Abyke and Kobosh"},{"id":"semetey-1-2013:p0879:b004:l004","ordinal":144221,"en":"She kept from entering the court."},{"id":"semetey-1-2013:p0879:b004:l005","ordinal":144222,"en":"Heroically built, an extraordinary warrior,"},{"id":"semetey-1-2013:p0879:b004:l006","ordinal":144223,"en":"Your precious mother Kanykei"},{"id":"semetey-1-2013:p0879:b004:l007","ordinal":144224,"en":"Showed extraordinary courage."},{"id":"semetey-1-2013:p0879:b004:l008","ordinal":144225,"en":"She kept asking God for help."},{"id":"semetey-1-2013:p0879:b004:l009","ordinal":144226,"en":"Your dear mother Kanykei"},{"id":"semetey-1-2013:p0879:b004:l010","ordinal":144227,"en":"Displayed a mighty, fearsome power."},{"id":"semetey-1-2013:p0879:b004:l011","ordinal":144228,"en":"Then the rascal son of Manas,"},{"id":"semetey-1-2013:p0879:b004:l012","ordinal":144229,"en":"Utterly unconcerned,"},{"id":"semetey-1-2013:p0879:b004:l013","ordinal":144230,"en":"The young lord, that hero,"},{"id":"semetey-1-2013:p0879:b004:l014","ordinal":144231,"en":"Did not draw back his outstretched legs,"},{"id":"semetey-1-2013:p0879:b004:l015","ordinal":144232,"en":"Nor open his closed eyes."},{"id":"semetey-1-2013:p0879:b004:l016","ordinal":144233,"en":"He slept soundly without a care."},{"id":"semetey-1-2013:p0879:b004:l017","ordinal":144234,"en":"The enemy surrounding him"},{"id":"semetey-1-2013:p0879:b004:l018","ordinal":144235,"en":"He did not consider them worth a thing."},{"id":"semetey-1-2013:p0879:b004:l019","ordinal":144236,"en":"Then, in Chachykei's fortress,"},{"id":"semetey-1-2013:p0879:b004:l020","ordinal":144237,"en":"In Kanykei's royal court,"},{"id":"semetey-1-2013:p0879:b004:l021","ordinal":144238,"en":"When it was nearly noon,"},{"id":"semetey-1-2013:p0879:b004:l022","ordinal":144239,"en":"He woke with a start."},{"id":"semetey-1-2013:p0879:b004:l023","ordinal":144240,"en":"Turning onto his right side,"},{"id":"semetey-1-2013:p0879:b004:l024","ordinal":144241,"en":"Awoke with a start,"},{"id":"semetey-1-2013:p0879:b004:l025","ordinal":144242,"en":"He stretched like a gray tiger."},{"id":"semetey-1-2013:p0879:b004:l026","ordinal":144243,"en":"He put his hands in water,"},{"id":"semetey-1-2013:p0879:b004:l027","ordinal":144244,"en":"Performed the washing of his hands,"},{"id":"semetey-1-2013:p0879:b004:l028","ordinal":144245,"en":"And pleaded with the one God."},{"id":"semetey-1-2013:p0879:b004:l029","ordinal":144246,"en":"Startled, he recited his prayer,"},{"id":"semetey-1-2013:p0879:b004:l030","ordinal":144247,"en":"And saddled the noble steed."},{"id":"semetey-1-2013:p0879:b004:l031","ordinal":144248,"en":"He leaped from his place and ran,"},{"id":"semetey-1-2013:p0879:b004:l032","ordinal":144249,"en":"Put on Akolpok,"},{"id":"semetey-1-2013:p0879:b004:l033","ordinal":144250,"en":"And pleaded with the Creator."},{"id":"semetey-1-2013:p0879:b004:l034","ordinal":144251,"en":"Boz Kise, left by Manas,"},{"id":"semetey-1-2013:p0879:b004:l035","ordinal":144252,"en":"He took and fastened at his waist."},{"id":"semetey-1-2013:p0879:b004:l036","ordinal":144253,"en":"Preparing his equipment,"},{"id":"semetey-1-2013:p0879:b004:l037","ordinal":144254,"en":"Your poor child, the lord's son,"},{"id":"semetey-1-2013:p0879:b004:l038","ordinal":144255,"en":"Like a cloud about to rain again,"},{"id":"semetey-1-2013:p0879:b004:l039","ordinal":144256,"en":"Had wrath gathering upon his face."},{"id":"semetey-1-2013:p0880:b003:l001","ordinal":144257,"en":"Of the six keen weapons fallen from heaven,"},{"id":"semetey-1-2013:p0880:b003:l002","ordinal":144258,"en":"The choicest of swords,"},{"id":"semetey-1-2013:p0880:b003:l003","ordinal":144259,"en":"Zulfiqar, which Manas had obtained—"},{"id":"semetey-1-2013:p0880:b003:l004","ordinal":144260,"en":"When drawn from its sheath with a shout,"},{"id":"semetey-1-2013:p0880:b003:l005","ordinal":144261,"en":"It never went idly without drinking blood."},{"id":"semetey-1-2013:p0880:b003:l006","ordinal":144262,"en":"Unless it drank its fill of blood,"},{"id":"semetey-1-2013:p0880:b003:l007","ordinal":144263,"en":"It would not enter its sheath when put away."},{"id":"semetey-1-2013:p0880:b003:l008","ordinal":144264,"en":"When swung, it never returned empty."},{"id":"semetey-1-2013:p0880:b003:l009","ordinal":144265,"en":"When swung in wrath,"},{"id":"semetey-1-2013:p0880:b003:l010","ordinal":144266,"en":"Its sharpness was plain to see;"},{"id":"semetey-1-2013:p0880:b003:l011","ordinal":144267,"en":"At a stroke, an elephant split in two."},{"id":"semetey-1-2013:p0880:b003:l012","ordinal":144268,"en":"Hardened through drinking blood,"},{"id":"semetey-1-2013:p0880:b003:l013","ordinal":144269,"en":"Khan Manas, who wielded it,"},{"id":"semetey-1-2013:p0880:b003:l014","ordinal":144270,"en":"Was called the ‘blood-drinking Burut.’"},{"id":"semetey-1-2013:p0880:b003:l015","ordinal":144271,"en":"Its sharpness was known to the people,"},{"id":"semetey-1-2013:p0880:b003:l016","ordinal":144272,"en":"An inheritance left by his father Manas."},{"id":"semetey-1-2013:p0880:b003:l017","ordinal":144273,"en":"Composing himself in wrath,"},{"id":"semetey-1-2013:p0880:b003:l018","ordinal":144274,"en":"He fastened on Zulfiqar."},{"id":"semetey-1-2013:p0880:b003:l019","ordinal":144275,"en":"Have you heard the tale?"},{"id":"semetey-1-2013:p0880:b003:l020","ordinal":144276,"en":"Your father's friend Bolokbai,"},{"id":"semetey-1-2013:p0880:b003:l021","ordinal":144277,"en":"Who had stirred the Altai Khan star in heaven—"},{"id":"semetey-1-2013:p0880:b003:l023","ordinal":144278,"en":"David and Bolokbai"},{"id":"semetey-1-2013:p0880:b003:l024","ordinal":144279,"en":"Had made friendship sixty times."},{"id":"semetey-1-2013:p0880:b003:l025","ordinal":144280,"en":"Weeping bitterly to the one God,"},{"id":"semetey-1-2013:p0880:b003:l026","ordinal":144281,"en":"‘Let the orphan take it when he comes;"},{"id":"semetey-1-2013:p0880:b003:l027","ordinal":144282,"en":"If my orphan comes safely,"},{"id":"semetey-1-2013:p0880:b003:l028","ordinal":144283,"en":"Let him bring terror upon the foe,’ he said."},{"id":"semetey-1-2013:p0880:b003:l029","ordinal":144284,"en":"The toiling smith Bolokbai,"},{"id":"semetey-1-2013:p0880:b003:l030","ordinal":144285,"en":"Working it with consummate skill,"},{"id":"semetey-1-2013:p0880:b003:l031","ordinal":144286,"en":"Joined with David,"},{"id":"semetey-1-2013:p0880:b003:l032","ordinal":144287,"en":"And made the white battle-axe."},{"id":"semetey-1-2013:p0880:b003:l033","ordinal":144288,"en":"He had gold beaten onto its handle,"},{"id":"semetey-1-2013:p0880:b003:l034","ordinal":144289,"en":"And poison spread upon its edge."},{"id":"semetey-1-2013:p0880:b003:l035","ordinal":144290,"en":"‘If only it were my axe,’"},{"id":"semetey-1-2013:p0880:b003:l036","ordinal":144291,"en":"The mighty men who saw it admired it."},{"id":"semetey-1-2013:p0880:b003:l037","ordinal":144292,"en":"He fashioned its edge of steel,"},{"id":"semetey-1-2013:p0880:b003:l038","ordinal":144293,"en":"‘May everyone it strikes"},{"id":"semetey-1-2013:p0880:b003:l039","ordinal":144294,"en":"Be overcome and die,’ he said."},{"id":"semetey-1-2013:p0880:b004:l001","ordinal":144295,"en":"In dragon's poison,"},{"id":"semetey-1-2013:p0880:b004:l002","ordinal":144296,"en":"He tempered it sixty times."},{"id":"semetey-1-2013:p0880:b004:l003","ordinal":144297,"en":"When it came to its charcoal,"},{"id":"semetey-1-2013:p0880:b004:l004","ordinal":144298,"en":"The Boiorokcho forest was consumed."},{"id":"semetey-1-2013:p0880:b004:l005","ordinal":144299,"en":"When it came to its bellows,"},{"id":"semetey-1-2013:p0880:b004:l006","ordinal":144300,"en":"Many young bulls were slaughtered."},{"id":"semetey-1-2013:p0880:b004:l007","ordinal":144301,"en":"Lest the handle strike off to one side,"},{"id":"semetey-1-2013:p0880:b004:l008","ordinal":144302,"en":"Of honeysuckle and meadowsweet,"},{"id":"semetey-1-2013:p0880:b004:l009","ordinal":144303,"en":"He fashioned a curved handle."},{"id":"semetey-1-2013:p0880:b004:l010","ordinal":144304,"en":"Lest the handle split,"},{"id":"semetey-1-2013:p0880:b004:l011","ordinal":144305,"en":"He had it covered with elephant hide."},{"id":"semetey-1-2013:p0880:b004:l012","ordinal":144306,"en":"So no mishap would occur,"},{"id":"semetey-1-2013:p0880:b004:l013","ordinal":144307,"en":"So it would not fly from the hand,"},{"id":"semetey-1-2013:p0880:b004:l014","ordinal":144308,"en":"He had an autumn gelded goat slaughtered."},{"id":"semetey-1-2013:p0880:b004:l015","ordinal":144309,"en":"The hide of that goat"},{"id":"semetey-1-2013:p0880:b004:l016","ordinal":144310,"en":"He had made into suede,"},{"id":"semetey-1-2013:p0880:b004:l017","ordinal":144311,"en":"Had strongmen stretch it,"},{"id":"semetey-1-2013:p0880:b004:l018","ordinal":144312,"en":"Twisted it into shape,"},{"id":"semetey-1-2013:p0880:b004:l019","ordinal":144313,"en":"And made it into a wrist loop."},{"id":"semetey-1-2013:p0880:b004:l020","ordinal":144314,"en":"The exceptional smith Bolokbai,"},{"id":"semetey-1-2013:p0880:b004:l021","ordinal":144315,"en":"‘Let the noble orphan take it,’ he said,"},{"id":"semetey-1-2013:p0880:b004:l022","ordinal":144316,"en":"Deliberately choosing, fired with zeal,"},{"id":"semetey-1-2013:p0880:b004:l023","ordinal":144317,"en":"Had made a surpassing battle-axe."},{"id":"semetey-1-2013:p0880:b004:l024","ordinal":144318,"en":"Your orphan took it,"},{"id":"semetey-1-2013:p0880:b004:l025","ordinal":144319,"en":"Pleading with the one God,"},{"id":"semetey-1-2013:p0880:b004:l026","ordinal":144320,"en":"And fastened it snugly at his waist."},{"id":"semetey-1-2013:p0880:b004:l027","ordinal":144321,"en":"The living gun Akkelte—"},{"id":"semetey-1-2013:p0880:b004:l028","ordinal":144322,"en":"For shooting, that was the steel weapon;"},{"id":"semetey-1-2013:p0880:b004:l029","ordinal":144323,"en":"Against a grappling enemy,"},{"id":"semetey-1-2013:p0880:b004:l030","ordinal":144324,"en":"That was the treasure that caused distress."},{"id":"semetey-1-2013:p0880:b004:l031","ordinal":144325,"en":"Smoke clogged its ear;"},{"id":"semetey-1-2013:p0880:b004:l032","ordinal":144326,"en":"With every pull, it grew stronger."},{"id":"semetey-1-2013:p0880:b004:l033","ordinal":144327,"en":"The enemy hearing its voice"},{"id":"semetey-1-2013:p0880:b004:l034","ordinal":144328,"en":"Was thrown into roaring confusion."},{"id":"semetey-1-2013:p0880:b004:l035","ordinal":144329,"en":"When its piercing voice rang out,"},{"id":"semetey-1-2013:p0880:b004:l036","ordinal":144330,"en":"It rumbled like a camel with her calf."},{"id":"semetey-1-2013:p0880:b004:l037","ordinal":144331,"en":"On hearing its mighty voice,"},{"id":"semetey-1-2013:p0880:b004:l038","ordinal":144332,"en":"The enemy could not stand and watch,"},{"id":"semetey-1-2013:p0880:b004:l039","ordinal":144333,"en":"But fled back, trembling."},{"id":"semetey-1-2013:p0881:b003:l001","ordinal":144334,"en":"If its bullet struck squarely,"},{"id":"semetey-1-2013:p0881:b003:l002","ordinal":144335,"en":"Not a handspan of bone remained."},{"id":"semetey-1-2013:p0881:b003:l003","ordinal":144336,"en":"No enemy could face it."},{"id":"semetey-1-2013:p0881:b003:l004","ordinal":144337,"en":"When they heard Akkelte's voice,"},{"id":"semetey-1-2013:p0881:b003:l005","ordinal":144338,"en":"The Chinese in Beijing fell into turmoil."},{"id":"semetey-1-2013:p0881:b003:l006","ordinal":144339,"en":"Akkelte, the weapon to fire,"},{"id":"semetey-1-2013:p0881:b003:l007","ordinal":144340,"en":"An inheritance left by his father Manas—"},{"id":"semetey-1-2013:p0881:b003:l008","ordinal":144341,"en":"Semetey, born a lion,"},{"id":"semetey-1-2013:p0881:b003:l009","ordinal":144342,"en":"Slung it across his shoulder blade."},{"id":"semetey-1-2013:p0881:b003:l010","ordinal":144343,"en":"That dear hero stood tall,"},{"id":"semetey-1-2013:p0881:b003:l011","ordinal":144344,"en":"Against the crouching enemy,"},{"id":"semetey-1-2013:p0881:b003:l012","ordinal":144345,"en":"He brought upheaval to that place."},{"id":"semetey-1-2013:p0881:b003:l013","ordinal":144346,"en":"His father, magnanimous Manas—"},{"id":"semetey-1-2013:p0881:b003:l014","ordinal":144347,"en":"He was a dear lion born surpassing him."},{"id":"semetey-1-2013:p0881:b003:l015","ordinal":144348,"en":"Turning and setting himself right,"},{"id":"semetey-1-2013:p0881:b003:l016","ordinal":144349,"en":"Gathering strength like a lion,"},{"id":"semetey-1-2013:p0881:b003:l017","ordinal":144350,"en":"He wrapped himself in Akolpok."},{"id":"semetey-1-2013:p0881:b003:l018","ordinal":144351,"en":"If you would look upon Semetey,"},{"id":"semetey-1-2013:p0881:b003:l019","ordinal":144352,"en":"He surged like a white tiger,"},{"id":"semetey-1-2013:p0881:b003:l020","ordinal":144353,"en":"To Manas, who went to the other world,"},{"id":"semetey-1-2013:p0881:b003:l021","ordinal":144354,"en":"Pleading with his spirit."},{"id":"semetey-1-2013:p0881:b003:l022","ordinal":144355,"en":"His eyes blazed fiercely like fire,"},{"id":"semetey-1-2013:p0881:b003:l023","ordinal":144356,"en":"His thirst for blood seized him in earnest."},{"id":"semetey-1-2013:p0881:b003:l024","ordinal":144357,"en":"His dear teeth, as broad as doors,"},{"id":"semetey-1-2013:p0881:b003:l025","ordinal":144358,"en":"Crumbled like grains of millet."},{"id":"semetey-1-2013:p0881:b003:l026","ordinal":144359,"en":"From both corners of his mouth, blue flame—"},{"id":"semetey-1-2013:p0881:b003:l027","ordinal":144360,"en":"Blue flame poured out, hissing."},{"id":"semetey-1-2013:p0881:b003:l028","ordinal":144361,"en":"Courage radiated from his head,"},{"id":"semetey-1-2013:p0881:b003:l029","ordinal":144362,"en":"His lion's nature showed."},{"id":"semetey-1-2013:p0881:b003:l030","ordinal":144363,"en":"The young lord was a hero,"},{"id":"semetey-1-2013:p0881:b003:l031","ordinal":144364,"en":"His father, magnanimous Manas,"},{"id":"semetey-1-2013:p0881:b003:l032","ordinal":144365,"en":"He resembled without the slightest difference."},{"id":"semetey-1-2013:p0881:b003:l033","ordinal":144366,"en":"Surging forth on his own,"},{"id":"semetey-1-2013:p0881:b003:l034","ordinal":144367,"en":"At the entrance to the court,"},{"id":"semetey-1-2013:p0881:b003:l035","ordinal":144368,"en":"He appeared before his mother Kanykei."},{"id":"semetey-1-2013:p0881:b003:l036","ordinal":144369,"en":"When they saw their only son,"},{"id":"semetey-1-2013:p0881:b003:l037","ordinal":144370,"en":"Kanykei in her advancing years,"},{"id":"semetey-1-2013:p0881:b003:l038","ordinal":144371,"en":"Chiyyrdy in her old age,"},{"id":"semetey-1-2013:p0881:b003:l039","ordinal":144372,"en":"Both his mothers wept."},{"id":"semetey-1-2013:p0881:b005:l001","ordinal":144373,"en":"Then your leopard-mother Kanykei"},{"id":"semetey-1-2013:p0881:b005:l002","ordinal":144374,"en":"Appeared weighed down with sorrow,"},{"id":"semetey-1-2013:p0881:b005:l003","ordinal":144375,"en":"Her heart torn apart."},{"id":"semetey-1-2013:p0881:b005:l004","ordinal":144376,"en":"Both his mothers together"},{"id":"semetey-1-2013:p0881:b005:l005","ordinal":144377,"en":"Led Buurul, as great as a camel,"},{"id":"semetey-1-2013:p0881:b005:l006","ordinal":144378,"en":"And brought him before the boy."},{"id":"semetey-1-2013:p0881:b005:l007","ordinal":144379,"en":"Hanging their belts about their necks,"},{"id":"semetey-1-2013:p0881:b005:l008","ordinal":144380,"en":"To the one Creator God,"},{"id":"semetey-1-2013:p0881:b005:l009","ordinal":144381,"en":"‘Give him aid!’ they pleaded."},{"id":"semetey-1-2013:p0881:b005:l010","ordinal":144382,"en":"Both his mothers wept,"},{"id":"semetey-1-2013:p0881:b005:l011","ordinal":144383,"en":"Spreading their palms and saying, ‘Amen!’"},{"id":"semetey-1-2013:p0881:b005:l012","ordinal":144384,"en":"They cried aloud, pressed close together."}]
