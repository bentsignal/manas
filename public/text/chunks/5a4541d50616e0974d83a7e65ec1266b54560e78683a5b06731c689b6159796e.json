[{"id":"seytek-1991-continuation:p0343:b001:l030","ordinal":389121,"en":"In Yengkor's sight,"},{"id":"seytek-1991-continuation:p0343:b001:l031","ordinal":389122,"en":"Ebegey's ribs"},{"id":"seytek-1991-continuation:p0343:b001:l032","ordinal":389123,"en":"Appeared faintly through the haze."},{"id":"seytek-1991-continuation:p0343:b001:l033","ordinal":389124,"en":"An ember as large as a yurt glowed at the match;"},{"id":"seytek-1991-continuation:p0343:b001:l034","ordinal":389125,"en":"There was no other infidel like him in the world."},{"id":"seytek-1991-continuation:p0343:b001:l035","ordinal":389126,"en":"He brought the gold-trimmed sight"},{"id":"seytek-1991-continuation:p0343:b001:l036","ordinal":389127,"en":"Up to his glass-like eye,"},{"id":"seytek-1991-continuation:p0343:b001:l037","ordinal":389128,"en":"Then pulled and fired."},{"id":"seytek-1991-continuation:p0343:b001:l038","ordinal":389129,"en":"The gun boomed and cracked;"},{"id":"seytek-1991-continuation:p0343:b001:l039","ordinal":389130,"en":"“Lie there, wretched Burut!” he said."},{"id":"seytek-1991-continuation:p0343:b001:l040","ordinal":389131,"en":"From the edge of the ribs,"},{"id":"seytek-1991-continuation:p0343:b001:l041","ordinal":389132,"en":"From the very front of the lung,"},{"id":"seytek-1991-continuation:p0343:b001:l042","ordinal":389133,"en":"Blood gushed and gushed."},{"id":"seytek-1991-continuation:p0343:b001:l043","ordinal":389134,"en":"His fine mustache drooped,"},{"id":"seytek-1991-continuation:p0343:b001:l044","ordinal":389135,"en":"And his ruddy face grew pale;"},{"id":"seytek-1991-continuation:p0343:b001:l045","ordinal":389136,"en":"His breast filled with blood."},{"id":"seytek-1991-continuation:p0343:b001:l046","ordinal":389137,"en":"Ebegey, father of the people,"},{"id":"seytek-1991-continuation:p0343:b001:l047","ordinal":389138,"en":"Was sacrificed for his nation."},{"id":"seytek-1991-continuation:p0343:b001:l048","ordinal":389139,"en":"Blood-handed Yengkor declared,"},{"id":"seytek-1991-continuation:p0343:b001:l049","ordinal":389140,"en":"“I have shattered the mountain ridge"},{"id":"seytek-1991-continuation:p0343:b003:l001","ordinal":389141,"en":"Of the steadfast Burut,"},{"id":"seytek-1991-continuation:p0343:b003:l002","ordinal":389142,"en":"And taken control of the road;"},{"id":"seytek-1991-continuation:p0343:b003:l003","ordinal":389143,"en":"I have brought down a peak like Kap-Too"},{"id":"seytek-1991-continuation:p0343:b003:l004","ordinal":389144,"en":"And cast the world into black night.”"},{"id":"seytek-1991-continuation:p0343:b003:l005","ordinal":389145,"en":"He went to bear glad tidings"},{"id":"seytek-1991-continuation:p0343:b003:l006","ordinal":389146,"en":"To crowned Chyntengir,"},{"id":"seytek-1991-continuation:p0343:b003:l007","ordinal":389147,"en":"Great khan of the Kakan."},{"id":"seytek-1991-continuation:p0343:b004:l001","ordinal":389148,"en":"Now he saw that hero Yengkor"},{"id":"seytek-1991-continuation:p0343:b004:l002","ordinal":389149,"en":"Was truly a man,"},{"id":"seytek-1991-continuation:p0343:b004:l003","ordinal":389150,"en":"And recognized his marksmanship."},{"id":"seytek-1991-continuation:p0343:b004:l004","ordinal":389151,"en":"Without openly rejoicing, he smiled,"},{"id":"seytek-1991-continuation:p0343:b004:l005","ordinal":389152,"en":"His mustache barely twitching,"},{"id":"seytek-1991-continuation:p0343:b004:l006","ordinal":389153,"en":"And laughed almost imperceptibly:"},{"id":"seytek-1991-continuation:p0343:b004:l007","ordinal":389154,"en":"“He was a khan named Ebegey;"},{"id":"seytek-1991-continuation:p0343:b004:l008","ordinal":389155,"en":"You have taken blood for blood."},{"id":"seytek-1991-continuation:p0343:b004:l009","ordinal":389156,"en":"He was a match for our Er Odu."},{"id":"seytek-1991-continuation:p0343:b004:l010","ordinal":389157,"en":"You have broken the enemy's back"},{"id":"seytek-1991-continuation:p0343:b004:l011","ordinal":389158,"en":"And set Chyntengir's heart at rest!"},{"id":"seytek-1991-continuation:p0343:b005:l001","ordinal":389159,"en":"I have heard news from those who came:"},{"id":"seytek-1991-continuation:p0343:b005:l002","ordinal":389160,"en":"They say Er Kenen on Kertulpar"},{"id":"seytek-1991-continuation:p0343:b005:l003","ordinal":389161,"en":"Still stands fighting."},{"id":"seytek-1991-continuation:p0343:b005:l004","ordinal":389162,"en":"Strong men in coats,"},{"id":"seytek-1991-continuation:p0343:b005:l005","ordinal":389163,"en":"Shaven warriors girded with stones,"},{"id":"seytek-1991-continuation:p0343:b005:l006","ordinal":389164,"en":"Thick-armed heroes,"},{"id":"seytek-1991-continuation:p0343:b005:l007","ordinal":389165,"en":"Men deft and skilled with the spear,"},{"id":"seytek-1991-continuation:p0343:b005:l008","ordinal":389166,"en":"Fully armed Kaldays,"},{"id":"seytek-1991-continuation:p0343:b005:l009","ordinal":389167,"en":"Strong men swift in wrestling—"},{"id":"seytek-1991-continuation:p0343:b005:l010","ordinal":389168,"en":"They say these fell in turmoil."},{"id":"seytek-1991-continuation:p0343:b005:l011","ordinal":389169,"en":"They say he destroys without pause,"},{"id":"seytek-1991-continuation:p0343:b005:l012","ordinal":389170,"en":"And keeps inflicting hell."},{"id":"seytek-1991-continuation:p0343:b005:l013","ordinal":389171,"en":"They say he crushes the strong"},{"id":"seytek-1991-continuation:p0343:b005:l014","ordinal":389172,"en":"And beats the rage"},{"id":"seytek-1991-continuation:p0343:b005:l015","ordinal":389173,"en":"Out of courageous Kaldays."},{"id":"seytek-1991-continuation:p0343:b005:l016","ordinal":389174,"en":"May fire burst from your bones!"},{"id":"seytek-1991-continuation:p0343:b005:l017","ordinal":389175,"en":"An enemy has risen from among you:"},{"id":"seytek-1991-continuation:p0343:b005:l018","ordinal":389176,"en":"Jeljetpes has gone over to the Kyrgyz"},{"id":"seytek-1991-continuation:p0343:b005:l019","ordinal":389177,"en":"And become a rebel."},{"id":"seytek-1991-continuation:p0343:b005:l020","ordinal":389178,"en":"He has brought a day of dire disaster"},{"id":"seytek-1991-continuation:p0343:b005:l021","ordinal":389179,"en":"Upon the people of China's forty khans,"},{"id":"seytek-1991-continuation:p0343:b005:l022","ordinal":389180,"en":"And reached their very foundations."},{"id":"seytek-1991-continuation:p0343:b005:l023","ordinal":389181,"en":"Thus that black demon"},{"id":"seytek-1991-continuation:p0343:b005:l024","ordinal":389182,"en":"Has become an enemy."},{"id":"seytek-1991-continuation:p0343:b005:l025","ordinal":389183,"en":"That accursed Jeljetpes"},{"id":"seytek-1991-continuation:p0343:b005:l026","ordinal":389184,"en":"Has ruined my undertaking."},{"id":"seytek-1991-continuation:p0343:b005:l027","ordinal":389185,"en":"He has broken my back,"},{"id":"seytek-1991-continuation:p0343:b005:l028","ordinal":389186,"en":"And openly destroyed"},{"id":"seytek-1991-continuation:p0343:b005:l029","ordinal":389187,"en":"Er Odukan and Choyun Alp,"},{"id":"seytek-1991-continuation:p0343:b005:l030","ordinal":389188,"en":"Heroes such as these.”"},{"id":"seytek-1991-continuation:p0344:b001:l001","ordinal":389189,"en":"“You are the support on whom I rely,"},{"id":"seytek-1991-continuation:p0344:b001:l002","ordinal":389190,"en":"The marksman who is a shield"},{"id":"seytek-1991-continuation:p0344:b001:l003","ordinal":389191,"en":"For the Kakan of Chin-Machin."},{"id":"seytek-1991-continuation:p0344:b001:l004","ordinal":389192,"en":"Even if Jeljetpes descends underground,"},{"id":"seytek-1991-continuation:p0344:b001:l005","ordinal":389193,"en":"Capture him and bring him here."},{"id":"seytek-1991-continuation:p0344:b001:l006","ordinal":389194,"en":"Bind both his hands;"},{"id":"seytek-1991-continuation:p0344:b001:l007","ordinal":389195,"en":"Gouge out both his eyes."},{"id":"seytek-1991-continuation:p0344:b001:l008","ordinal":389196,"en":"Cut out his tongue so he cannot speak,"},{"id":"seytek-1991-continuation:p0344:b001:l009","ordinal":389197,"en":"And pierce him through the nape."},{"id":"seytek-1991-continuation:p0344:b001:l010","ordinal":389198,"en":"Put a billowing robe on him,"},{"id":"seytek-1991-continuation:p0344:b001:l011","ordinal":389199,"en":"Seat him backward on a mule,"},{"id":"seytek-1991-continuation:p0344:b001:l012","ordinal":389200,"en":"Letting him sway helplessly,"},{"id":"seytek-1991-continuation:p0344:b001:l013","ordinal":389201,"en":"And drive him here to me!"},{"id":"seytek-1991-continuation:p0344:b001:l014","ordinal":389202,"en":"He too is a champion and a lion."},{"id":"seytek-1991-continuation:p0344:b001:l015","ordinal":389203,"en":"As for Kenen, chief of the Buruts,"},{"id":"seytek-1991-continuation:p0344:b001:l016","ordinal":389204,"en":"Pure as sparkling water,"},{"id":"seytek-1991-continuation:p0344:b001:l017","ordinal":389205,"en":"The precious bringer of good fortune,"},{"id":"seytek-1991-continuation:p0344:b001:l018","ordinal":389206,"en":"Huge as the Ala-Too,"},{"id":"seytek-1991-continuation:p0344:b001:l019","ordinal":389207,"en":"A fortress like Mount Kap,"},{"id":"seytek-1991-continuation:p0344:b001:l020","ordinal":389208,"en":"Who consumes those he fights,"},{"id":"seytek-1991-continuation:p0344:b001:l021","ordinal":389209,"en":"Thick-armed and stone-hearted,"},{"id":"seytek-1991-continuation:p0344:b001:l022","ordinal":389210,"en":"A massive, well-built terror,"},{"id":"seytek-1991-continuation:p0344:b001:l023","ordinal":389211,"en":"Formidable as Alaskar,"},{"id":"seytek-1991-continuation:p0344:b001:l024","ordinal":389212,"en":"The finest of the white-capped people—"},{"id":"seytek-1991-continuation:p0344:b001:l025","ordinal":389213,"en":"Go and destroy Er Kenen;"},{"id":"seytek-1991-continuation:p0344:b001:l026","ordinal":389214,"en":"Find a way and capture him!"},{"id":"seytek-1991-continuation:p0344:b001:l027","ordinal":389215,"en":"No bullet pierces what he wears;"},{"id":"seytek-1991-continuation:p0344:b001:l028","ordinal":389216,"en":"No arrow catches what he rides."},{"id":"seytek-1991-continuation:p0344:b001:l029","ordinal":389217,"en":"Kertulpar flew like a cloud,"},{"id":"seytek-1991-continuation:p0344:b001:l030","ordinal":389218,"en":"While the champion wore his armor,"},{"id":"seytek-1991-continuation:p0344:b001:l031","ordinal":389219,"en":"And circled all Five Beijings."},{"id":"seytek-1991-continuation:p0344:b001:l032","ordinal":389220,"en":"He is a beast fit for"},{"id":"seytek-1991-continuation:p0344:b001:l033","ordinal":389221,"en":"Your champion khan Chyntengir to ride;"},{"id":"seytek-1991-continuation:p0344:b001:l034","ordinal":389222,"en":"Winged Kertulpar"},{"id":"seytek-1991-continuation:p0344:b001:l035","ordinal":389223,"en":"Is a creature worth taking as plunder.”"},{"id":"seytek-1991-continuation:p0344:b001:l036","ordinal":389224,"en":"Saying, “Remember these words,”"},{"id":"seytek-1991-continuation:p0344:b001:l037","ordinal":389225,"en":"He spoke thus to his marksman,"},{"id":"seytek-1991-continuation:p0344:b001:l038","ordinal":389226,"en":"Gave him this terrible sign,"},{"id":"seytek-1991-continuation:p0344:b001:l039","ordinal":389227,"en":"And firmly sent him against Kenen,"},{"id":"seytek-1991-continuation:p0344:b001:l040","ordinal":389228,"en":"To bring distress upon the champion,"},{"id":"seytek-1991-continuation:p0344:b001:l041","ordinal":389229,"en":"The khan of the Ala-Too."},{"id":"seytek-1991-continuation:p0344:b001:l042","ordinal":389230,"en":"Chyntengir took pride"},{"id":"seytek-1991-continuation:p0344:b001:l043","ordinal":389231,"en":"In having champion Yengkor."},{"id":"seytek-1991-continuation:p0344:b001:l044","ordinal":389232,"en":"When Yengkor chose his shot"},{"id":"seytek-1991-continuation:p0344:b001:l045","ordinal":389233,"en":"And watched for his mark,"},{"id":"seytek-1991-continuation:p0344:b001:l046","ordinal":389234,"en":"He ordered the host to surge past without stooping,"},{"id":"seytek-1991-continuation:p0344:b001:l047","ordinal":389235,"en":"To encircle him,"},{"id":"seytek-1991-continuation:p0344:b001:l048","ordinal":389236,"en":"To reach his very foundation,"},{"id":"seytek-1991-continuation:p0344:b001:l049","ordinal":389237,"en":"And spill his blood by the spoonful."},{"id":"seytek-1991-continuation:p0344:b003:l001","ordinal":389238,"en":"He ordered them to press down from the crown,"},{"id":"seytek-1991-continuation:p0344:b003:l002","ordinal":389239,"en":"And gave him a countless army"},{"id":"seytek-1991-continuation:p0344:b003:l003","ordinal":389240,"en":"Of iron lariats and nets,"},{"id":"seytek-1991-continuation:p0344:b003:l004","ordinal":389241,"en":"And men armed throughout with daggers—"},{"id":"seytek-1991-continuation:p0344:b003:l005","ordinal":389242,"en":"Gave lavishly, holding no troops back."},{"id":"seytek-1991-continuation:p0344:b003:l006","ordinal":389243,"en":"The champion became the marksman,"},{"id":"seytek-1991-continuation:p0344:b003:l007","ordinal":389244,"en":"And came toward the hero."},{"id":"seytek-1991-continuation:p0344:b003:l008","ordinal":389245,"en":"How great was his strength and skill"},{"id":"seytek-1991-continuation:p0344:b003:l009","ordinal":389246,"en":"As he came to see Er Kenen,"},{"id":"seytek-1991-continuation:p0344:b003:l010","ordinal":389247,"en":"To fight and quarrel"},{"id":"seytek-1991-continuation:p0344:b003:l011","ordinal":389248,"en":"And deliver his punishment by hand!"},{"id":"seytek-1991-continuation:p0344:b003:l012","ordinal":389249,"en":"He covered the earth in fog;"},{"id":"seytek-1991-continuation:p0344:b003:l013","ordinal":389250,"en":"Camels passed, crushing stones,"},{"id":"seytek-1991-continuation:p0344:b003:l014","ordinal":389251,"en":"And crossed water without tiring."},{"id":"seytek-1991-continuation:p0344:b003:l015","ordinal":389252,"en":"Watching ridge after ridge,"},{"id":"seytek-1991-continuation:p0344:b003:l016","ordinal":389253,"en":"He saw Kertulpar beneath Kenen,"},{"id":"seytek-1991-continuation:p0344:b003:l017","ordinal":389254,"en":"A swift, well-equipped beast."},{"id":"seytek-1991-continuation:p0344:b003:l018","ordinal":389255,"en":"Unless his limbs were broken,"},{"id":"seytek-1991-continuation:p0344:b003:l019","ordinal":389256,"en":"Unless he died and his life grew still,"},{"id":"seytek-1991-continuation:p0344:b003:l020","ordinal":389257,"en":"Unless a thousand disasters befell him,"},{"id":"seytek-1991-continuation:p0344:b003:l021","ordinal":389258,"en":"Unless only a handful of reins remained,"},{"id":"seytek-1991-continuation:p0344:b003:l022","ordinal":389259,"en":"He would never stumble into disaster;"},{"id":"seytek-1991-continuation:p0344:b003:l023","ordinal":389260,"en":"Though crimson turmoil and great calamity raged,"},{"id":"seytek-1991-continuation:p0344:b003:l024","ordinal":389261,"en":"For however many days he rode into slaughter,"},{"id":"seytek-1991-continuation:p0344:b003:l025","ordinal":389262,"en":"He would never yield to the enemy—"},{"id":"seytek-1991-continuation:p0344:b003:l026","ordinal":389263,"en":"The formidable racer Kertulpar."},{"id":"seytek-1991-continuation:p0344:b003:l027","ordinal":389264,"en":"Jeljetpes, the blessed lion,"},{"id":"seytek-1991-continuation:p0344:b003:l028","ordinal":389265,"en":"Attacked the enemy without looking back;"},{"id":"seytek-1991-continuation:p0344:b003:l029","ordinal":389266,"en":"It was his time to make slaughter."},{"id":"seytek-1991-continuation:p0344:b003:l030","ordinal":389267,"en":"On the qibla side Er Kenen"},{"id":"seytek-1991-continuation:p0344:b003:l031","ordinal":389268,"en":"Wounded everyone he faced,"},{"id":"seytek-1991-continuation:p0344:b003:l032","ordinal":389269,"en":"Threading up and down"},{"id":"seytek-1991-continuation:p0344:b003:l033","ordinal":389270,"en":"Through the countless host."},{"id":"seytek-1991-continuation:p0344:b003:l034","ordinal":389271,"en":"He thrust his spear without turning,"},{"id":"seytek-1991-continuation:p0344:b003:l035","ordinal":389272,"en":"Drenched them in bloody gore,"},{"id":"seytek-1991-continuation:p0344:b003:l036","ordinal":389273,"en":"And fought without retreating."},{"id":"seytek-1991-continuation:p0344:b003:l037","ordinal":389274,"en":"He passed swiftly through their midst,"},{"id":"seytek-1991-continuation:p0344:b003:l038","ordinal":389275,"en":"Spearing those he reached,"},{"id":"seytek-1991-continuation:p0344:b003:l039","ordinal":389276,"en":"Searching for Chyntengir."},{"id":"seytek-1991-continuation:p0344:b003:l040","ordinal":389277,"en":"Having lost the two lions,"},{"id":"seytek-1991-continuation:p0344:b003:l041","ordinal":389278,"en":"Ebegey and Kogoy,"},{"id":"seytek-1991-continuation:p0344:b003:l042","ordinal":389279,"en":"His ribs seemed broken apart;"},{"id":"seytek-1991-continuation:p0344:b003:l043","ordinal":389280,"en":"The world appeared false."},{"id":"seytek-1991-continuation:p0344:b003:l044","ordinal":389281,"en":"Black night fell upon his head,"},{"id":"seytek-1991-continuation:p0344:b003:l045","ordinal":389282,"en":"And a merciless day came;"},{"id":"seytek-1991-continuation:p0344:b003:l046","ordinal":389283,"en":"The night was caught in cloud."},{"id":"seytek-1991-continuation:p0344:b003:l047","ordinal":389284,"en":"Er Kenen, lion against the foe,"},{"id":"seytek-1991-continuation:p0344:b003:l048","ordinal":389285,"en":"Was then surpassing all"},{"id":"seytek-1991-continuation:p0344:b003:l049","ordinal":389286,"en":"In strength and courage."},{"id":"seytek-1991-continuation:p0345:b001:l001","ordinal":389287,"en":"Your gray-maned wolf was then"},{"id":"seytek-1991-continuation:p0345:b001:l002","ordinal":389288,"en":"Withstanding every calamity."},{"id":"seytek-1991-continuation:p0345:b001:l003","ordinal":389289,"en":"He fought without circling in thought,"},{"id":"seytek-1991-continuation:p0345:b001:l004","ordinal":389290,"en":"Grappled without concern,"},{"id":"seytek-1991-continuation:p0345:b001:l005","ordinal":389291,"en":"And began a violent struggle."},{"id":"seytek-1991-continuation:p0345:b001:l006","ordinal":389292,"en":"His precious, matchless life"},{"id":"seytek-1991-continuation:p0345:b001:l007","ordinal":389293,"en":"He cast away, bound by a hair."},{"id":"seytek-1991-continuation:p0345:b002:l001","ordinal":389294,"en":"Until I save our heads"},{"id":"seytek-1991-continuation:p0345:b002:l002","ordinal":389295,"en":"From the imperial host,"},{"id":"seytek-1991-continuation:p0345:b002:l003","ordinal":389296,"en":"For honor and for the people"},{"id":"seytek-1991-continuation:p0345:b002:l004","ordinal":389297,"en":"I will sacrifice my life!"},{"id":"seytek-1991-continuation:p0345:b002:l005","ordinal":389298,"en":"How can I remain alive"},{"id":"seytek-1991-continuation:p0345:b002:l006","ordinal":389299,"en":"While the inherited Kyrgyz people,"},{"id":"seytek-1991-continuation:p0345:b002:l007","ordinal":389300,"en":"The treasure I held dear,"},{"id":"seytek-1991-continuation:p0345:b002:l008","ordinal":389301,"en":"Are taken captive alive?"},{"id":"seytek-1991-continuation:p0345:b002:l009","ordinal":389302,"en":"Thus Er Kenen spoke,"},{"id":"seytek-1991-continuation:p0345:b002:l010","ordinal":389303,"en":"Spoke softly but firmly,"},{"id":"seytek-1991-continuation:p0345:b002:l011","ordinal":389304,"en":"And began addressing Jeljetpes:"},{"id":"seytek-1991-continuation:p0345:b002:l012","ordinal":389305,"en":"“Dear Jeljetpes,"},{"id":"seytek-1991-continuation:p0345:b002:l013","ordinal":389306,"en":"Do not let the Chinese take the land;"},{"id":"seytek-1991-continuation:p0345:b002:l014","ordinal":389307,"en":"Do not let the people be left without descendants;"},{"id":"seytek-1991-continuation:p0345:b002:l015","ordinal":389308,"en":"Do not let them slaughter every living soul."},{"id":"seytek-1991-continuation:p0345:b002:l016","ordinal":389309,"en":"My first forefather had sons one by one;"},{"id":"seytek-1991-continuation:p0345:b002:l017","ordinal":389310,"en":"After long yearning, I, Kenen,"},{"id":"seytek-1991-continuation:p0345:b002:l018","ordinal":389311,"en":"Was blessed with twin boys."},{"id":"seytek-1991-continuation:p0345:b002:l019","ordinal":389312,"en":"I held a feast and slaughtered ninety beasts,"},{"id":"seytek-1991-continuation:p0345:b002:l020","ordinal":389313,"en":"And gave them rhyming names."},{"id":"seytek-1991-continuation:p0345:b002:l021","ordinal":389314,"en":"They are medicine for my breast, my solace,"},{"id":"seytek-1991-continuation:p0345:b002:l022","ordinal":389315,"en":"My two only sons, whom I begged"},{"id":"seytek-1991-continuation:p0345:b002:l023","ordinal":389316,"en":"From God in the open steppe:"},{"id":"seytek-1991-continuation:p0345:b002:l024","ordinal":389317,"en":"My Alymsaryk and Kulansaryk,"},{"id":"seytek-1991-continuation:p0345:b002:l025","ordinal":389318,"en":"The light of my rising morning star."},{"id":"seytek-1991-continuation:p0345:b002:l026","ordinal":389319,"en":"Let them not die before a hidden foe;"},{"id":"seytek-1991-continuation:p0345:b002:l027","ordinal":389320,"en":"Let them not see the place of no return."},{"id":"seytek-1991-continuation:p0345:b002:l028","ordinal":389321,"en":"I entrust my twins to you!"},{"id":"seytek-1991-continuation:p0345:b002:l029","ordinal":389322,"en":"After fighting without rest for many days,"},{"id":"seytek-1991-continuation:p0345:b002:l030","ordinal":389323,"en":"I will let them bind my hands."},{"id":"seytek-1991-continuation:p0345:b002:l031","ordinal":389324,"en":"With the twin heroes following you,"},{"id":"seytek-1991-continuation:p0345:b002:l032","ordinal":389325,"en":"Find, Jeljetpes, a place"},{"id":"seytek-1991-continuation:p0345:b002:l033","ordinal":389326,"en":"Where you can escape alive,"},{"id":"seytek-1991-continuation:p0345:b002:l034","ordinal":389327,"en":"For the sake of the resolve you have made.”"},{"id":"seytek-1991-continuation:p0345:b003:l001","ordinal":389328,"en":"Parted from them,"},{"id":"seytek-1991-continuation:p0345:b004:l001","ordinal":389329,"en":"Thus Er Kenen spoke."},{"id":"seytek-1991-continuation:p0345:b004:l002","ordinal":389330,"en":"At Ak-Kaykan of At-Otpos,"},{"id":"seytek-1991-continuation:p0345:b004:l003","ordinal":389331,"en":"In a ravine no man could tread,"},{"id":"seytek-1991-continuation:p0345:b004:l004","ordinal":389332,"en":"Your gray-maned wolf had surpassed all"},{"id":"seytek-1991-continuation:p0345:b004:l005","ordinal":389333,"en":"In courage and lion-heartedness."},{"id":"seytek-1991-continuation:p0345:b004:l006","ordinal":389334,"en":"He again held back"},{"id":"seytek-1991-continuation:p0345:b004:l007","ordinal":389335,"en":"The infidels who surged upon him."},{"id":"seytek-1991-continuation:p0345:b006:l001","ordinal":389336,"en":"They stood face-to-face,"},{"id":"seytek-1991-continuation:p0345:b006:l002","ordinal":389337,"en":"Firing guns and drawing bows,"},{"id":"seytek-1991-continuation:p0345:b006:l003","ordinal":389338,"en":"Fighting in a bloody crush."},{"id":"seytek-1991-continuation:p0345:b006:l004","ordinal":389339,"en":"Arrows whirred from the bows,"},{"id":"seytek-1991-continuation:p0345:b006:l005","ordinal":389340,"en":"And shattered wherever they struck;"},{"id":"seytek-1991-continuation:p0345:b006:l006","ordinal":389341,"en":"Blood poured with a hiss."},{"id":"seytek-1991-continuation:p0345:b006:l007","ordinal":389342,"en":"Bullets flew like hail—"},{"id":"seytek-1991-continuation:p0345:b006:l008","ordinal":389343,"en":"No trial had ever equaled this!"},{"id":"seytek-1991-continuation:p0345:b006:l009","ordinal":389344,"en":"Through hollows, hills, and valleys,"},{"id":"seytek-1991-continuation:p0345:b006:l010","ordinal":389345,"en":"Black blood flowed rumbling."},{"id":"seytek-1991-continuation:p0345:b006:l011","ordinal":389346,"en":"The battle heaved and swelled;"},{"id":"seytek-1991-continuation:p0345:b006:l012","ordinal":389347,"en":"Dead men lay in heaps,"},{"id":"seytek-1991-continuation:p0345:b006:l013","ordinal":389348,"en":"Dead horses rose like mountains."},{"id":"seytek-1991-continuation:p0345:b006:l014","ordinal":389349,"en":"Every hill was dust,"},{"id":"seytek-1991-continuation:p0345:b006:l015","ordinal":389350,"en":"Every hollow filled with blood;"},{"id":"seytek-1991-continuation:p0345:b006:l016","ordinal":389351,"en":"Now a vast battle raged."},{"id":"seytek-1991-continuation:p0345:b006:l017","ordinal":389352,"en":"Chyntengir received the news."},{"id":"seytek-1991-continuation:p0345:b006:l018","ordinal":389353,"en":"He mounted a dun horse huge as a mountain,"},{"id":"seytek-1991-continuation:p0345:b006:l019","ordinal":389354,"en":"Put on a rippling deep-blue coat,"},{"id":"seytek-1991-continuation:p0345:b006:l020","ordinal":389355,"en":"And advanced, pouring out his rage."},{"id":"seytek-1991-continuation:p0345:b006:l021","ordinal":389356,"en":"He hitched up his belted coat"},{"id":"seytek-1991-continuation:p0345:b006:l022","ordinal":389357,"en":"And bore down upon Kenen,"},{"id":"seytek-1991-continuation:p0345:b006:l023","ordinal":389358,"en":"Who rode Kertulpar."},{"id":"seytek-1991-continuation:p0345:b006:l024","ordinal":389359,"en":"He advanced fearsomely, raising dust,"},{"id":"seytek-1991-continuation:p0345:b006:l025","ordinal":389360,"en":"Intent on reaching him now,"},{"id":"seytek-1991-continuation:p0345:b006:l026","ordinal":389361,"en":"On carrying him off"},{"id":"seytek-1991-continuation:p0345:b006:l027","ordinal":389362,"en":"And riding away unhurried."},{"id":"seytek-1991-continuation:p0345:b006:l028","ordinal":389363,"en":"When he drew near and faced him,"},{"id":"seytek-1991-continuation:p0345:b006:l029","ordinal":389364,"en":"Kenen prayed, “May God aid the solitary man."},{"id":"seytek-1991-continuation:p0345:b006:l030","ordinal":389365,"en":"Darkening like the burning sun,"},{"id":"seytek-1991-continuation:p0345:b006:l031","ordinal":389366,"en":"Let my noble soul depart;"},{"id":"seytek-1991-continuation:p0345:b006:l032","ordinal":389367,"en":"Let me duel with this boastful warrior"},{"id":"seytek-1991-continuation:p0345:b006:l033","ordinal":389368,"en":"And take my pillow beside me.”"},{"id":"seytek-1991-continuation:p0345:b006:l034","ordinal":389369,"en":"Thus Er Kenen spoke"},{"id":"seytek-1991-continuation:p0345:b006:l035","ordinal":389370,"en":"Against the infidel who poured out wrath,"},{"id":"seytek-1991-continuation:p0345:b006:l036","ordinal":389371,"en":"The alien enemy among the people,"},{"id":"seytek-1991-continuation:p0345:b006:l037","ordinal":389372,"en":"The hero Khan Chyntengir."},{"id":"seytek-1991-continuation:p0345:b006:l038","ordinal":389373,"en":"He turned his stallion's head"},{"id":"seytek-1991-continuation:p0345:b006:l039","ordinal":389374,"en":"And at once leveled his spear."},{"id":"seytek-1991-continuation:p0345:b006:l040","ordinal":389375,"en":"Before he could reach Chyntengir,"},{"id":"seytek-1991-continuation:p0345:b006:l041","ordinal":389376,"en":"Before he could strike him with the spear,"}]
