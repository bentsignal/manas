[{"id":"semetey-1-2013:p0981:b004:l025","ordinal":151041,"en":"A woman sitting at home have with it?"},{"id":"semetey-1-2013:p0981:b004:l026","ordinal":151042,"en":"Vanish from my sight;"},{"id":"semetey-1-2013:p0981:b004:l027","ordinal":151043,"en":"Do not come near me!"},{"id":"semetey-1-2013:p0981:b004:l028","ordinal":151044,"en":"You who speak with a hiss,"},{"id":"semetey-1-2013:p0981:b004:l029","ordinal":151045,"en":"Who mention the time I was mocked—"},{"id":"semetey-1-2013:p0981:b004:l030","ordinal":151046,"en":"For these words you have spoken,"},{"id":"semetey-1-2013:p0981:b004:l031","ordinal":151047,"en":"By your father’s grave, filthy slave,"},{"id":"semetey-1-2013:p0981:b004:l032","ordinal":151048,"en":"Vanish from my sight!"},{"id":"semetey-1-2013:p0981:b004:l033","ordinal":151049,"en":"I shall slaughter you now;"},{"id":"semetey-1-2013:p0981:b004:l034","ordinal":151050,"en":"By your father’s grave, devil-slave,"},{"id":"semetey-1-2013:p0981:b004:l035","ordinal":151051,"en":"I shall gouge out your eyes!"},{"id":"semetey-1-2013:p0981:b004:l036","ordinal":151052,"en":"Remember what I have said:"},{"id":"semetey-1-2013:p0981:b004:l037","ordinal":151053,"en":"You and your bloodthirsty companion together—"},{"id":"semetey-1-2013:p0981:b004:l038","ordinal":151054,"en":"Go down into the black earth!”"},{"id":"semetey-1-2013:p0981:b004:l039","ordinal":151055,"en":"She raged and swelled with fury,"},{"id":"semetey-1-2013:p0982:b003:l001","ordinal":151056,"en":"The mad woman Chachykey"},{"id":"semetey-1-2013:p0982:b003:l002","ordinal":151057,"en":"Spoke without restraint,"},{"id":"semetey-1-2013:p0982:b003:l003","ordinal":151058,"en":"And became intent upon"},{"id":"semetey-1-2013:p0982:b003:l004","ordinal":151059,"en":"Slaughtering Kulchoro,"},{"id":"semetey-1-2013:p0982:b003:l005","ordinal":151060,"en":"Putting him to death,"},{"id":"semetey-1-2013:p0982:b003:l006","ordinal":151061,"en":"Cutting him down as a sacrifice,"},{"id":"semetey-1-2013:p0982:b003:l007","ordinal":151062,"en":"And ending his life."},{"id":"semetey-1-2013:p0982:b003:l008","ordinal":151063,"en":"The wayward, spoiled mad slave-woman—"},{"id":"semetey-1-2013:p0982:b003:l009","ordinal":151064,"en":"Now God struck the madwoman;"},{"id":"semetey-1-2013:p0982:b003:l010","ordinal":151065,"en":"May He never give such a person"},{"id":"semetey-1-2013:p0982:b003:l011","ordinal":151066,"en":"Such filthy, obscene speech."},{"id":"semetey-1-2013:p0982:b003:l012","ordinal":151067,"en":"When you looked at Chachykey,"},{"id":"semetey-1-2013:p0982:b003:l013","ordinal":151068,"en":"She raged beyond the reach of words;"},{"id":"semetey-1-2013:p0982:b003:l014","ordinal":151069,"en":"Your stubborn sister-in-law spoke,"},{"id":"semetey-1-2013:p0982:b003:l015","ordinal":151070,"en":"Swelled and seethed,"},{"id":"semetey-1-2013:p0982:b003:l016","ordinal":151071,"en":"And your fierce sister-in-law spoke."},{"id":"semetey-1-2013:p0982:b003:l017","ordinal":151072,"en":"Where Semetey lay,"},{"id":"semetey-1-2013:p0982:b003:l018","ordinal":151073,"en":"Here where he remained still,"},{"id":"semetey-1-2013:p0982:b003:l019","ordinal":151074,"en":"For sixty colts and four sheep"},{"id":"semetey-1-2013:p0982:b003:l020","ordinal":151075,"en":"Your noble mother Kanykey"},{"id":"semetey-1-2013:p0982:b003:l021","ordinal":151076,"en":"Had refined white silver."},{"id":"semetey-1-2013:p0982:b003:l022","ordinal":151077,"en":"Amid thirty daughters-in-law and thirty girls,"},{"id":"semetey-1-2013:p0982:b003:l023","ordinal":151078,"en":"Your sister-in-law"},{"id":"semetey-1-2013:p0982:b003:l024","ordinal":151079,"en":"Seized by its handle"},{"id":"semetey-1-2013:p0982:b003:l025","ordinal":151080,"en":"A knife made to slaughter a man,"},{"id":"semetey-1-2013:p0982:b003:l026","ordinal":151081,"en":"Drew it from its sheath,"},{"id":"semetey-1-2013:p0982:b003:l027","ordinal":151082,"en":"And rushed to slaughter Kulchoro,"},{"id":"semetey-1-2013:p0982:b003:l028","ordinal":151083,"en":"To put him to death."},{"id":"semetey-1-2013:p0982:b003:l029","ordinal":151084,"en":"She charged forward in a lunge,"},{"id":"semetey-1-2013:p0982:b003:l030","ordinal":151085,"en":"Knife gripped in her hand,"},{"id":"semetey-1-2013:p0982:b003:l031","ordinal":151086,"en":"And threw herself upon Kulchoro."},{"id":"semetey-1-2013:p0982:b003:l032","ordinal":151087,"en":"From that witless wretch"},{"id":"semetey-1-2013:p0982:b003:l033","ordinal":151088,"en":"Kulchoro fled away,"},{"id":"semetey-1-2013:p0982:b003:l034","ordinal":151089,"en":"Clung to the place of a mother,"},{"id":"semetey-1-2013:p0982:b003:l035","ordinal":151090,"en":"And escaped the woman who had seized a weapon."},{"id":"semetey-1-2013:p0982:b003:l036","ordinal":151091,"en":"“Father! Wild sister-in-law Chachykey!"},{"id":"semetey-1-2013:p0982:b003:l037","ordinal":151092,"en":"I know your unruly nature;"},{"id":"semetey-1-2013:p0982:b003:l038","ordinal":151093,"en":"I honor the spirit"},{"id":"semetey-1-2013:p0982:b003:l039","ordinal":151094,"en":"Of my swaggering prince Semetey!”"},{"id":"semetey-1-2013:p0982:b004:l001","ordinal":151095,"en":"The boy said this and fled."},{"id":"semetey-1-2013:p0982:b004:l002","ordinal":151096,"en":"Kulchoro flew like an arrow;"},{"id":"semetey-1-2013:p0982:b004:l003","ordinal":151097,"en":"The wretch could not draw near him."},{"id":"semetey-1-2013:p0982:b004:l004","ordinal":151098,"en":"The great woman raised a shout"},{"id":"semetey-1-2013:p0982:b004:l005","ordinal":151099,"en":"And struck out in anger."},{"id":"semetey-1-2013:p0982:b004:l006","ordinal":151100,"en":"From far behind the boy,"},{"id":"semetey-1-2013:p0982:b004:l007","ordinal":151101,"en":"The knife struck the gate."},{"id":"semetey-1-2013:p0982:b004:l008","ordinal":151102,"en":"The gate shattered apart,"},{"id":"semetey-1-2013:p0982:b004:l009","ordinal":151103,"en":"And thirty daughters-in-law and thirty girls"},{"id":"semetey-1-2013:p0982:b004:l010","ordinal":151104,"en":"Fled in every direction, crying out."},{"id":"semetey-1-2013:p0982:b004:l011","ordinal":151105,"en":"Kulchoro ran on,"},{"id":"semetey-1-2013:p0982:b004:l012","ordinal":151106,"en":"Bending low for a spear’s length,"},{"id":"semetey-1-2013:p0982:b004:l013","ordinal":151107,"en":"He reached the top of Akborchuk"},{"id":"semetey-1-2013:p0982:b004:l014","ordinal":151108,"en":"And rushed onward in haste."},{"id":"semetey-1-2013:p0982:b004:l015","ordinal":151109,"en":"He fled as though enemies had entered the village,"},{"id":"semetey-1-2013:p0982:b004:l016","ordinal":151110,"en":"Running away"},{"id":"semetey-1-2013:p0982:b004:l017","ordinal":151111,"en":"From Semetey’s wife."},{"id":"semetey-1-2013:p0982:b004:l018","ordinal":151112,"en":"He took the road at speed,"},{"id":"semetey-1-2013:p0982:b004:l019","ordinal":151113,"en":"And charged onward without drawing near."},{"id":"semetey-1-2013:p0982:b004:l020","ordinal":151114,"en":"Hurrying, the two matched their pace,"},{"id":"semetey-1-2013:p0982:b004:l021","ordinal":151115,"en":"And the two equal warrior choros"},{"id":"semetey-1-2013:p0982:b004:l022","ordinal":151116,"en":"Took counsel in an empty place:"},{"id":"semetey-1-2013:p0982:b004:l023","ordinal":151117,"en":"“Who can understand a secret like this?"},{"id":"semetey-1-2013:p0982:b004:l024","ordinal":151118,"en":"Elder Kanchoro, hear my words!"},{"id":"semetey-1-2013:p0982:b004:l025","ordinal":151119,"en":"His wife is out of her senses;"},{"id":"semetey-1-2013:p0982:b004:l026","ordinal":151120,"en":"That croaking wretch"},{"id":"semetey-1-2013:p0982:b004:l027","ordinal":151121,"en":"Nearly killed me."},{"id":"semetey-1-2013:p0982:b004:l028","ordinal":151122,"en":"Along the Üch-Koshoy,"},{"id":"semetey-1-2013:p0982:b004:l029","ordinal":151123,"en":"Our blue-maned elder, great Bakay,"},{"id":"semetey-1-2013:p0982:b004:l030","ordinal":151124,"en":"Is an old man of immense wisdom,"},{"id":"semetey-1-2013:p0982:b004:l031","ordinal":151125,"en":"A sage left to us"},{"id":"semetey-1-2013:p0982:b004:l032","ordinal":151126,"en":"By the blue-maned lion Manas."},{"id":"semetey-1-2013:p0982:b004:l033","ordinal":151127,"en":"Bakay’s senior wife Körpöjan—"},{"id":"semetey-1-2013:p0982:b004:l034","ordinal":151128,"en":"Let us bring her between us,"},{"id":"semetey-1-2013:p0982:b004:l035","ordinal":151129,"en":"And learn the news for certain."},{"id":"semetey-1-2013:p0982:b004:l036","ordinal":151130,"en":"On the face of the willow country,"},{"id":"semetey-1-2013:p0982:b004:l037","ordinal":151131,"en":"On this side of Keng-Köl,"},{"id":"semetey-1-2013:p0982:b004:l038","ordinal":151132,"en":"Sarykan of the bowl-shaped eyes"},{"id":"semetey-1-2013:p0982:b004:l039","ordinal":151133,"en":"Was a person of sacred power,"},{"id":"semetey-1-2013:p0983:b003:l001","ordinal":151134,"en":"And his senior wife Tynymkan—"},{"id":"semetey-1-2013:p0983:b003:l002","ordinal":151135,"en":"Let us place all four between us"},{"id":"semetey-1-2013:p0983:b003:l003","ordinal":151136,"en":"And learn the news in that way."},{"id":"semetey-1-2013:p0983:b003:l004","ordinal":151137,"en":"On this side of Talas,"},{"id":"semetey-1-2013:p0983:b003:l005","ordinal":151138,"en":"Beyond Keng-Köl,"},{"id":"semetey-1-2013:p0983:b003:l006","ordinal":151139,"en":"There is Jamgyrchy of the Esheks;"},{"id":"semetey-1-2013:p0983:b003:l007","ordinal":151140,"en":"Let us seek him among the men,"},{"id":"semetey-1-2013:p0983:b003:l008","ordinal":151141,"en":"And make his senior wife Jaynake"},{"id":"semetey-1-2013:p0983:b003:l009","ordinal":151142,"en":"Our envoy."},{"id":"semetey-1-2013:p0983:b003:l010","ordinal":151143,"en":"Let us somehow obtain news"},{"id":"semetey-1-2013:p0983:b003:l011","ordinal":151144,"en":"From that witless, wicked woman."},{"id":"semetey-1-2013:p0983:b003:l012","ordinal":151145,"en":"Let us appoint the envoy firmly."},{"id":"semetey-1-2013:p0983:b003:l013","ordinal":151146,"en":"My elder is a true man—"},{"id":"semetey-1-2013:p0983:b003:l014","ordinal":151147,"en":"How could he have called her ‘wife’?"},{"id":"semetey-1-2013:p0983:b003:l015","ordinal":151148,"en":"My sister-in-law is witless;"},{"id":"semetey-1-2013:p0983:b003:l016","ordinal":151149,"en":"He has pampered his wife too much,"},{"id":"semetey-1-2013:p0983:b003:l017","ordinal":151150,"en":"And the wretch has grown loud and wild.”"},{"id":"semetey-1-2013:p0983:b003:l018","ordinal":151151,"en":"They traveled through half the night,"},{"id":"semetey-1-2013:p0983:b003:l019","ordinal":151152,"en":"Rode far without sparing their horses,"},{"id":"semetey-1-2013:p0983:b003:l020","ordinal":151153,"en":"And when the pale dawn drove onward,"},{"id":"semetey-1-2013:p0983:b003:l021","ordinal":151154,"en":"When light touched the earth,"},{"id":"semetey-1-2013:p0983:b003:l022","ordinal":151155,"en":"When daybreak opened dimly"},{"id":"semetey-1-2013:p0983:b003:l023","ordinal":151156,"en":"And light scattered over the land,"},{"id":"semetey-1-2013:p0983:b003:l024","ordinal":151157,"en":"The two went directly"},{"id":"semetey-1-2013:p0983:b003:l025","ordinal":151158,"en":"Before your brave elder Bakay."},{"id":"semetey-1-2013:p0983:b003:l026","ordinal":151159,"en":"When great Bakay in the encampment"},{"id":"semetey-1-2013:p0983:b003:l027","ordinal":151160,"en":"Saw the boys’ appearance,"},{"id":"semetey-1-2013:p0983:b003:l028","ordinal":151161,"en":"He sprang from his place:"},{"id":"semetey-1-2013:p0983:b003:l029","ordinal":151162,"en":"“Kanchoro and Kulchoro,"},{"id":"semetey-1-2013:p0983:b003:l030","ordinal":151163,"en":"My twins who keep me company,"},{"id":"semetey-1-2013:p0983:b003:l031","ordinal":151164,"en":"My sea left from the twin pair,"},{"id":"semetey-1-2013:p0983:b003:l032","ordinal":151165,"en":"My morning stars beside the moon,"},{"id":"semetey-1-2013:p0983:b003:l033","ordinal":151166,"en":"My cherished sultans,"},{"id":"semetey-1-2013:p0983:b003:l034","ordinal":151167,"en":"Your backs I set upon watch—"},{"id":"semetey-1-2013:p0983:b003:l035","ordinal":151168,"en":"My dear stars,"},{"id":"semetey-1-2013:p0983:b003:l036","ordinal":151169,"en":"You have come in a terrible hurry."},{"id":"semetey-1-2013:p0983:b003:l037","ordinal":151170,"en":"Are your Kyrgyz people safe?"},{"id":"semetey-1-2013:p0983:b003:l038","ordinal":151171,"en":"Is he before you safe—"},{"id":"semetey-1-2013:p0983:b003:l039","ordinal":151172,"en":"Poor, solitary Semetey?"},{"id":"semetey-1-2013:p0983:b004:l001","ordinal":151173,"en":"Is your fortune, braided like bargek,"},{"id":"semetey-1-2013:p0983:b004:l002","ordinal":151174,"en":"Standing secure and well,"},{"id":"semetey-1-2013:p0983:b004:l003","ordinal":151175,"en":"And your numerous Argyn people safe?”"},{"id":"semetey-1-2013:p0983:b004:l004","ordinal":151176,"en":"Your elder Bakay said these words."},{"id":"semetey-1-2013:p0983:b004:l005","ordinal":151177,"en":"Startled awake, he sprang up,"},{"id":"semetey-1-2013:p0983:b004:l006","ordinal":151178,"en":"Hurriedly put on his clothes,"},{"id":"semetey-1-2013:p0983:b004:l007","ordinal":151179,"en":"And, alarmed by those who had arrived,"},{"id":"semetey-1-2013:p0983:b004:l008","ordinal":151180,"en":"Your heroic elder Bakay"},{"id":"semetey-1-2013:p0983:b004:l009","ordinal":151181,"en":"Saddled the blue tulpar."},{"id":"semetey-1-2013:p0983:b004:l010","ordinal":151182,"en":"Alarmed by his boys, he said:"},{"id":"semetey-1-2013:p0983:b004:l011","ordinal":151183,"en":"“Oh, my two equal colts,"},{"id":"semetey-1-2013:p0983:b004:l012","ordinal":151184,"en":"Is there a gray, rolling mountain before you?"},{"id":"semetey-1-2013:p0983:b004:l013","ordinal":151185,"en":"You have come in desperate haste,"},{"id":"semetey-1-2013:p0983:b004:l014","ordinal":151186,"en":"Darkening your very lives—"},{"id":"semetey-1-2013:p0983:b004:l015","ordinal":151187,"en":"Is there an enemy surrounding you?"},{"id":"semetey-1-2013:p0983:b004:l016","ordinal":151188,"en":"If an enemy has come from Mecca,"},{"id":"semetey-1-2013:p0983:b004:l017","ordinal":151189,"en":"Brave boys, tell me the truth;"},{"id":"semetey-1-2013:p0983:b004:l018","ordinal":151190,"en":"I shall mount Kökcholok"},{"id":"semetey-1-2013:p0983:b004:l019","ordinal":151191,"en":"And drive them back as far as Mecca."},{"id":"semetey-1-2013:p0983:b004:l020","ordinal":151192,"en":"If an enemy has come from China,"},{"id":"semetey-1-2013:p0983:b004:l021","ordinal":151193,"en":"I shall saddle and mount the tulpar,"},{"id":"semetey-1-2013:p0983:b004:l022","ordinal":151194,"en":"Break their ranks and strike them."},{"id":"semetey-1-2013:p0983:b004:l023","ordinal":151195,"en":"Tell me your words without stumbling;"},{"id":"semetey-1-2013:p0983:b004:l024","ordinal":151196,"en":"You have come in reckless haste."},{"id":"semetey-1-2013:p0983:b004:l025","ordinal":151197,"en":"Boys, tell the truth without faltering.”"},{"id":"semetey-1-2013:p0983:b004:l026","ordinal":151198,"en":"Hero Bakay said this"},{"id":"semetey-1-2013:p0983:b004:l027","ordinal":151199,"en":"To the boys who had hurried so greatly."},{"id":"semetey-1-2013:p0983:b004:l028","ordinal":151200,"en":"“Ah, senior wife, rise,” he said;"},{"id":"semetey-1-2013:p0983:b004:l029","ordinal":151201,"en":"“Pour my boys"},{"id":"semetey-1-2013:p0983:b004:l030","ordinal":151202,"en":"Some fresh yellow mare’s milk.”"},{"id":"semetey-1-2013:p0983:b004:l031","ordinal":151203,"en":"The senior wife sprang up"},{"id":"semetey-1-2013:p0983:b004:l032","ordinal":151204,"en":"And poured Bakay Khan’s great cup"},{"id":"semetey-1-2013:p0983:b004:l033","ordinal":151205,"en":"For the boys."},{"id":"semetey-1-2013:p0983:b004:l034","ordinal":151206,"en":"“Elder Bakay, hear my words!"},{"id":"semetey-1-2013:p0983:b004:l035","ordinal":151207,"en":"We opened tireless Buurul’s stride;"},{"id":"semetey-1-2013:p0983:b004:l036","ordinal":151208,"en":"Can such misery truly happen?"},{"id":"semetey-1-2013:p0983:b004:l037","ordinal":151209,"en":"Along the shore of Ala-Köl"},{"id":"semetey-1-2013:p0983:b004:l038","ordinal":151210,"en":"We lost Akshunkar!"},{"id":"semetey-1-2013:p0983:b004:l039","ordinal":151211,"en":"We let it strike the reed beds,"},{"id":"semetey-1-2013:p0984:b003:l001","ordinal":151212,"en":"From before the riverbank,"},{"id":"semetey-1-2013:p0984:b003:l002","ordinal":151213,"en":"Wise elder, tell us:"},{"id":"semetey-1-2013:p0984:b003:l003","ordinal":151214,"en":"We lost Akshunkar!"},{"id":"semetey-1-2013:p0984:b003:l004","ordinal":151215,"en":"We saw a swan of wondrous power;"},{"id":"semetey-1-2013:p0984:b003:l005","ordinal":151216,"en":"Akshunkar was carried away,"},{"id":"semetey-1-2013:p0984:b003:l006","ordinal":151217,"en":"And we saw turmoil fall into calamity."},{"id":"semetey-1-2013:p0984:b003:l007","ordinal":151218,"en":"These were my elder Semetey’s words:"},{"id":"semetey-1-2013:p0984:b003:l008","ordinal":151219,"en":"‘My exceedingly wise elder,"},{"id":"semetey-1-2013:p0984:b003:l009","ordinal":151220,"en":"My elder, the tiger Bakay,"},{"id":"semetey-1-2013:p0984:b003:l010","ordinal":151221,"en":"Will tell us"},{"id":"semetey-1-2013:p0984:b003:l011","ordinal":151222,"en":"Where the falcon went.’”"},{"id":"semetey-1-2013:p0984:b003:l012","ordinal":151223,"en":"After the boys had said this,"},{"id":"semetey-1-2013:p0984:b003:l013","ordinal":151224,"en":"The aged hero Bakay"},{"id":"semetey-1-2013:p0984:b003:l014","ordinal":151225,"en":"Sent for Jamgyrchy of the Esheks"},{"id":"semetey-1-2013:p0984:b003:l015","ordinal":151226,"en":"Together with his wife,"},{"id":"semetey-1-2013:p0984:b003:l016","ordinal":151227,"en":"And had Sarykan of the bowl-shaped eyes"},{"id":"semetey-1-2013:p0984:b003:l017","ordinal":151228,"en":"Brought along with him."},{"id":"semetey-1-2013:p0984:b003:l018","ordinal":151229,"en":"They hurried and bustled,"},{"id":"semetey-1-2013:p0984:b003:l019","ordinal":151230,"en":"Asking what disaster lay ahead."},{"id":"semetey-1-2013:p0984:b003:l020","ordinal":151231,"en":"“He flew his bird at a swan;"},{"id":"semetey-1-2013:p0984:b003:l021","ordinal":151232,"en":"The swan is gone, and so is the bird,"},{"id":"semetey-1-2013:p0984:b003:l022","ordinal":151233,"en":"And he has remained on the empty plain."},{"id":"semetey-1-2013:p0984:b003:l023","ordinal":151234,"en":"May God spare us such a sight!"},{"id":"semetey-1-2013:p0984:b003:l024","ordinal":151235,"en":"When my age-mate Manas lived,"},{"id":"semetey-1-2013:p0984:b003:l025","ordinal":151236,"en":"If Akshunkar was flown at a swan,"},{"id":"semetey-1-2013:p0984:b003:l026","ordinal":151237,"en":"It would strike the swan down;"},{"id":"semetey-1-2013:p0984:b003:l027","ordinal":151238,"en":"Not only a swan—it would tower above"},{"id":"semetey-1-2013:p0984:b003:l028","ordinal":151239,"en":"And take the creatures of the mountains as well."},{"id":"semetey-1-2013:p0984:b003:l029","ordinal":151240,"en":"As for the falcon that flew away,"},{"id":"semetey-1-2013:p0984:b003:l030","ordinal":151241,"en":"If what they say is true,"},{"id":"semetey-1-2013:p0984:b003:l031","ordinal":151242,"en":"I must consider this very carefully."},{"id":"semetey-1-2013:p0984:b003:l032","ordinal":151243,"en":"Let all three khans gather,"},{"id":"semetey-1-2013:p0984:b003:l033","ordinal":151244,"en":"With the three senior wives and ourselves,"},{"id":"semetey-1-2013:p0984:b003:l034","ordinal":151245,"en":"And place the matter among us."},{"id":"semetey-1-2013:p0984:b003:l035","ordinal":151246,"en":"Let us go swiftly without delay,"},{"id":"semetey-1-2013:p0984:b003:l036","ordinal":151247,"en":"Put the three old women between us,"},{"id":"semetey-1-2013:p0984:b003:l037","ordinal":151248,"en":"And obtain an answer from the daughter-in-law."},{"id":"semetey-1-2013:p0984:b003:l038","ordinal":151249,"en":"The swan is gone, and so is the bird;"},{"id":"semetey-1-2013:p0984:b003:l039","ordinal":151250,"en":"It must be a time of God’s punishment,"},{"id":"semetey-1-2013:p0984:b004:l001","ordinal":151251,"en":"And poor Semetey"},{"id":"semetey-1-2013:p0984:b004:l002","ordinal":151252,"en":"Must be standing there exhausted.”"},{"id":"semetey-1-2013:p0984:b004:l003","ordinal":151253,"en":"Hearing the boys’ account,"},{"id":"semetey-1-2013:p0984:b004:l004","ordinal":151254,"en":"And hearing that Chachykey knew"},{"id":"semetey-1-2013:p0984:b004:l005","ordinal":151255,"en":"What had become of Akshunkar,"},{"id":"semetey-1-2013:p0984:b004:l006","ordinal":151256,"en":"The lion was deeply stirred,"},{"id":"semetey-1-2013:p0984:b004:l007","ordinal":151257,"en":"And blue-maned Bakay mounted."},{"id":"semetey-1-2013:p0984:b004:l008","ordinal":151258,"en":"They joined Bakay,"},{"id":"semetey-1-2013:p0984:b004:l009","ordinal":151259,"en":"And all six rode out together"},{"id":"semetey-1-2013:p0984:b004:l010","ordinal":151260,"en":"To Kanykey’s encampment,"},{"id":"semetey-1-2013:p0984:b004:l011","ordinal":151261,"en":"To Chachykey’s gated fortress."},{"id":"semetey-1-2013:p0984:b004:l012","ordinal":151262,"en":"On the marsh of gathering,"},{"id":"semetey-1-2013:p0984:b004:l013","ordinal":151263,"en":"They gathered in a circle;"},{"id":"semetey-1-2013:p0984:b004:l014","ordinal":151264,"en":"On the marsh of assembly,"},{"id":"semetey-1-2013:p0984:b004:l015","ordinal":151265,"en":"They all assembled together."},{"id":"semetey-1-2013:p0984:b004:l016","ordinal":151266,"en":"They placed the matter among them,"},{"id":"semetey-1-2013:p0984:b004:l017","ordinal":151267,"en":"Conversed and questioned one another,"},{"id":"semetey-1-2013:p0984:b004:l018","ordinal":151268,"en":"Matched their findings step by step,"},{"id":"semetey-1-2013:p0984:b004:l019","ordinal":151269,"en":"And formed a khan’s council;"},{"id":"semetey-1-2013:p0984:b004:l020","ordinal":151270,"en":"It became a great gathering."},{"id":"semetey-1-2013:p0984:b004:l021","ordinal":151271,"en":"There were wise and aged people,"},{"id":"semetey-1-2013:p0984:b004:l022","ordinal":151272,"en":"And all the blue-maned champions were there:"},{"id":"semetey-1-2013:p0984:b004:l023","ordinal":151273,"en":"The tiger Bakay and Jamgyrchy,"},{"id":"semetey-1-2013:p0984:b004:l024","ordinal":151274,"en":"And your elder Sary as well."},{"id":"semetey-1-2013:p0984:b004:l025","ordinal":151275,"en":"Kanykey, the wife of Manas,"},{"id":"semetey-1-2013:p0984:b004:l026","ordinal":151276,"en":"The wise, fierce woman, was also there."},{"id":"semetey-1-2013:p0984:b004:l027","ordinal":151277,"en":"When only khans had arrived,"},{"id":"semetey-1-2013:p0984:b004:l028","ordinal":151278,"en":"They began the splendid proceedings:"},{"id":"semetey-1-2013:p0984:b004:l029","ordinal":151279,"en":"They had tender lamb and sweet head-meat"},{"id":"semetey-1-2013:p0984:b004:l030","ordinal":151280,"en":"Set boiling in broth,"},{"id":"semetey-1-2013:p0984:b004:l031","ordinal":151281,"en":"Spread thick felt carpets,"},{"id":"semetey-1-2013:p0984:b004:l032","ordinal":151282,"en":"And filled them with yellow butter."},{"id":"semetey-1-2013:p0984:b004:l033","ordinal":151283,"en":"They cut rump meat and laid out mane fat,"},{"id":"semetey-1-2013:p0984:b004:l034","ordinal":151284,"en":"And set arak and honey as drink,"},{"id":"semetey-1-2013:p0984:b004:l035","ordinal":151285,"en":"Preparing to receive their guests."},{"id":"semetey-1-2013:p0984:b004:l036","ordinal":151286,"en":"Pleading with Chachykey,"},{"id":"semetey-1-2013:p0984:b004:l037","ordinal":151287,"en":"“Tell the khans the truth,”"},{"id":"semetey-1-2013:p0984:b004:l038","ordinal":151288,"en":"They sent three people forward,"},{"id":"semetey-1-2013:p0984:b004:l039","ordinal":151289,"en":"The three senior wives and noble women,"}]
