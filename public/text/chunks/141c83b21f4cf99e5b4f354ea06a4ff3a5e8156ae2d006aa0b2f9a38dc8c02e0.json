[{"id":"manas-2010:p1538:b001:l038","ordinal":66305,"en":"If he speared ten and brought them down,"},{"id":"manas-2010:p1538:b001:l039","ordinal":66306,"en":"From every side they thrust:"},{"id":"manas-2010:p1538:b001:l040","ordinal":66307,"en":"A hundred spears struck at once."},{"id":"manas-2010:p1538:b001:l041","ordinal":66308,"en":"When Kongurbay came thundering out,"},{"id":"manas-2010:p1538:b001:l042","ordinal":66309,"en":"No man mattered in his eyes,"},{"id":"manas-2010:p1539:b001:l001","ordinal":66310,"en":"Ay Jangjung grew fiercer."},{"id":"manas-2010:p1539:b001:l002","ordinal":66311,"en":"Behind Ay Jangjung,"},{"id":"manas-2010:p1539:b001:l003","ordinal":66312,"en":"Kün Jangjung came shouting."},{"id":"manas-2010:p1539:b001:l004","ordinal":66313,"en":"The two Jangjung khans came forth;"},{"id":"manas-2010:p1539:b001:l005","ordinal":66314,"en":"At their voices, souls fled their bodies."},{"id":"manas-2010:p1539:b001:l006","ordinal":66315,"en":"When Syrgak faced them and thrust,"},{"id":"manas-2010:p1539:b001:l007","ordinal":66316,"en":"His spear broke and bent;"},{"id":"manas-2010:p1539:b001:l008","ordinal":66317,"en":"The strain fell upon one lone soul."},{"id":"manas-2010:p1539:b001:l009","ordinal":66318,"en":"While the Chinese swarmed upon him,"},{"id":"manas-2010:p1539:b001:l010","ordinal":66319,"en":"Alabash, a peerless steed among horses,"},{"id":"manas-2010:p1539:b001:l011","ordinal":66320,"en":"They sent galloping toward Syrgak;"},{"id":"manas-2010:p1539:b001:l012","ordinal":66321,"en":"Almambet and Chubak, their names in harmony,"},{"id":"manas-2010:p1539:b001:l013","ordinal":66322,"en":"“If death is due, let us die;"},{"id":"manas-2010:p1539:b001:l014","ordinal":66323,"en":"If the two of us have the strength,"},{"id":"manas-2010:p1539:b001:l015","ordinal":66324,"en":"For dear young Syrgak,"},{"id":"manas-2010:p1539:b001:l016","ordinal":66325,"en":"Let us give support!”"},{"id":"manas-2010:p1539:b001:l017","ordinal":66326,"en":"Saying this, the two lions,"},{"id":"manas-2010:p1539:b001:l018","ordinal":66327,"en":"Not sparing their frail lives,"},{"id":"manas-2010:p1539:b001:l019","ordinal":66328,"en":"Not heeding the multitude of Chinese,"},{"id":"manas-2010:p1539:b001:l020","ordinal":66329,"en":"Charged in at a gallop,"},{"id":"manas-2010:p1539:b001:l021","ordinal":66330,"en":"Making the Chinese lose their venom."},{"id":"manas-2010:p1539:b001:l022","ordinal":66331,"en":"They charged and struck the Chinese,"},{"id":"manas-2010:p1539:b001:l023","ordinal":66332,"en":"Calling the battle cry, “Manas!”"},{"id":"manas-2010:p1539:b001:l024","ordinal":66333,"en":"The two lions roared;"},{"id":"manas-2010:p1539:b001:l025","ordinal":66334,"en":"Their shouts split stones."},{"id":"manas-2010:p1539:b001:l026","ordinal":66335,"en":"When your fierce champions entered,"},{"id":"manas-2010:p1539:b001:l027","ordinal":66336,"en":"Charging together behind them,"},{"id":"manas-2010:p1539:b001:l028","ordinal":66337,"en":"Hero Manas's forty companions,"},{"id":"manas-2010:p1539:b001:l029","ordinal":66338,"en":"When they charged and swept in,"},{"id":"manas-2010:p1539:b001:l030","ordinal":66339,"en":"Were drenched in blood upon blood."},{"id":"manas-2010:p1539:b001:l031","ordinal":66340,"en":"The multitude of Chinese who swept forward"},{"id":"manas-2010:p1539:b001:l032","ordinal":66341,"en":"Stood and fought without fleeing."},{"id":"manas-2010:p1539:b001:l033","ordinal":66342,"en":"That champion of yours, Syrgak,"},{"id":"manas-2010:p1539:b001:l034","ordinal":66343,"en":"Sped upon Kökchebich;"},{"id":"manas-2010:p1539:b001:l035","ordinal":66344,"en":"Almambet, Azizkan's son,"},{"id":"manas-2010:p1539:b001:l036","ordinal":66345,"en":"Entered their midst like a lion,"},{"id":"manas-2010:p1539:b001:l037","ordinal":66346,"en":"Spearing each man once,"},{"id":"manas-2010:p1539:b001:l038","ordinal":66347,"en":"Throwing them off their horses."},{"id":"manas-2010:p1539:b001:l039","ordinal":66348,"en":"When Almambet truly charged in,"},{"id":"manas-2010:p1539:b001:l040","ordinal":66349,"en":"When Syrgak went beside him,"},{"id":"manas-2010:p1539:b001:l041","ordinal":66350,"en":"The Chinese onslaught halted;"},{"id":"manas-2010:p1539:b001:l042","ordinal":66351,"en":"Chubak, Khan Baltay's son,"},{"id":"manas-2010:p1540:b001:l001","ordinal":66352,"en":"Went slaughtering the Chinese,"},{"id":"manas-2010:p1540:b001:l002","ordinal":66353,"en":"Poised to dart like an arrow-snake."},{"id":"manas-2010:p1540:b001:l003","ordinal":66354,"en":"Into their center, Almambet"},{"id":"manas-2010:p1540:b001:l004","ordinal":66355,"en":"Bored his way;"},{"id":"manas-2010:p1540:b001:l005","ordinal":66356,"en":"Around their edges, hero Syrgak"},{"id":"manas-2010:p1540:b001:l006","ordinal":66357,"en":"Stretched their ranks apart as he entered."},{"id":"manas-2010:p1540:b001:l007","ordinal":66358,"en":"Charging without sparing their lives,"},{"id":"manas-2010:p1540:b001:l008","ordinal":66359,"en":"Khan Manas's forty companions"},{"id":"manas-2010:p1540:b001:l009","ordinal":66360,"en":"Split them as they entered."},{"id":"manas-2010:p1540:b001:l010","ordinal":66361,"en":"The place where they made war"},{"id":"manas-2010:p1540:b001:l011","ordinal":66362,"en":"Was the desert of It-Ölbös;"},{"id":"manas-2010:p1540:b001:l012","ordinal":66363,"en":"No mountain even ankle-bone-sized,"},{"id":"manas-2010:p1540:b001:l013","ordinal":66364,"en":"No hollow even saddlecloth-sized,"},{"id":"manas-2010:p1540:b001:l014","ordinal":66365,"en":"That land was level as a blade."},{"id":"manas-2010:p1540:b001:l015","ordinal":66366,"en":"The whole plain crackled;"},{"id":"manas-2010:p1540:b001:l016","ordinal":66367,"en":"Those were the teeming Chinese people."},{"id":"manas-2010:p1540:b001:l017","ordinal":66368,"en":"Fighting the multitude of Chinese,"},{"id":"manas-2010:p1540:b001:l018","ordinal":66369,"en":"Khan Manas's forty companions,"},{"id":"manas-2010:p1540:b001:l019","ordinal":66370,"en":"Almambet, Chubak and hero Syrgak—"},{"id":"manas-2010:p1540:b001:l020","ordinal":66371,"en":"Those were lion-born champions."},{"id":"manas-2010:p1540:b001:l021","ordinal":66372,"en":"When the multitude of Chinese surged,"},{"id":"manas-2010:p1540:b001:l022","ordinal":66373,"en":"Like a river admitting no barrier,"},{"id":"manas-2010:p1540:b001:l023","ordinal":66374,"en":"That was a flood that swept all away."},{"id":"manas-2010:p1540:b001:l024","ordinal":66375,"en":"Without fleeing in fear of the multitude,"},{"id":"manas-2010:p1540:b001:l025","ordinal":66376,"en":"Having come in small numbers from Talas,"},{"id":"manas-2010:p1540:b001:l026","ordinal":66377,"en":"All six alike, without rest,"},{"id":"manas-2010:p1540:b001:l027","ordinal":66378,"en":"Those were the heroes who grappled."},{"id":"manas-2010:p1540:b001:l028","ordinal":66379,"en":"“Do not flee!” at the Chinese"},{"id":"manas-2010:p1540:b001:l029","ordinal":66380,"en":"Ay Jangjung came out shouting."},{"id":"manas-2010:p1540:b001:l030","ordinal":66381,"en":"“Slaughter them!” he bellowed,"},{"id":"manas-2010:p1540:b001:l031","ordinal":66382,"en":"And Kün Jangjung drove them forth."},{"id":"manas-2010:p1540:b001:l032","ordinal":66383,"en":"The multitude of Chinese fled a little,"},{"id":"manas-2010:p1540:b001:l033","ordinal":66384,"en":"Then turned back in a struggling mass."},{"id":"manas-2010:p1540:b001:l034","ordinal":66385,"en":"When they became intermingled,"},{"id":"manas-2010:p1540:b001:l035","ordinal":66386,"en":"Striking with battle-axes,"},{"id":"manas-2010:p1540:b001:l036","ordinal":66387,"en":"The Chinese and the forty companions,"},{"id":"manas-2010:p1540:b001:l037","ordinal":66388,"en":"The renowned lions, the three wolves,"},{"id":"manas-2010:p1540:b001:l038","ordinal":66389,"en":"Fought with thudding blows."},{"id":"manas-2010:p1540:b001:l039","ordinal":66390,"en":"Turmoil rose in clouds of dust;"},{"id":"manas-2010:p1540:b001:l040","ordinal":66391,"en":"No one could tell which was which;"},{"id":"manas-2010:p1540:b001:l041","ordinal":66392,"en":"Looking, the eye could not make them out."},{"id":"manas-2010:p1540:b001:l042","ordinal":66393,"en":"The sky became black dust;"},{"id":"manas-2010:p1541:b001:l001","ordinal":66394,"en":"The earth's surface became blood."},{"id":"manas-2010:p1541:b001:l002","ordinal":66395,"en":"Fighting the multitude of Chinese,"},{"id":"manas-2010:p1541:b001:l003","ordinal":66396,"en":"There were forty-three valiant souls."},{"id":"manas-2010:p1541:b001:l004","ordinal":66397,"en":"Rejoicing in their valor,"},{"id":"manas-2010:p1541:b001:l005","ordinal":66398,"en":"The multitude of Chinese lost their senses,"},{"id":"manas-2010:p1541:b001:l006","ordinal":66399,"en":"Lost their wits and stood stunned."},{"id":"manas-2010:p1541:b001:l007","ordinal":66400,"en":"They took no rest by day;"},{"id":"manas-2010:p1541:b001:l008","ordinal":66401,"en":"Fighting day and night,"},{"id":"manas-2010:p1541:b001:l009","ordinal":66402,"en":"In the desert of It-Ölbös,"},{"id":"manas-2010:p1541:b001:l010","ordinal":66403,"en":"They did not swallow even a taste of food."},{"id":"manas-2010:p1541:b001:l011","ordinal":66404,"en":"Much is false, much is true;"},{"id":"manas-2010:p1541:b001:l012","ordinal":66405,"en":"No one came back who saw it."},{"id":"manas-2010:p1541:b001:l013","ordinal":66406,"en":"One part false, one part true;"},{"id":"manas-2010:p1541:b001:l014","ordinal":66407,"en":"No one came back who knew it."},{"id":"manas-2010:p1541:b001:l015","ordinal":66408,"en":"No signal horn sounded from the broad expanse;"},{"id":"manas-2010:p1541:b001:l016","ordinal":66409,"en":"No small bird flew from the broad ravine;"},{"id":"manas-2010:p1541:b001:l017","ordinal":66410,"en":"No enemy escaped the spear."},{"id":"manas-2010:p1541:b001:l018","ordinal":66411,"en":"It was a land stretching flat and wide;"},{"id":"manas-2010:p1541:b001:l019","ordinal":66412,"en":"The Chinese people were uncountable."},{"id":"manas-2010:p1541:b001:l020","ordinal":66413,"en":"When the Chinese surged in,"},{"id":"manas-2010:p1541:b001:l021","ordinal":66414,"en":"When they fought without stopping,"},{"id":"manas-2010:p1541:b001:l022","ordinal":66415,"en":"“Let us trust to fate!” hero Syrgak"},{"id":"manas-2010:p1541:b001:l023","ordinal":66416,"en":"Shouted in wrath."},{"id":"manas-2010:p1541:b001:l024","ordinal":66417,"en":"“Almambet, Chubak, well done!” he said,"},{"id":"manas-2010:p1541:b001:l025","ordinal":66418,"en":"Calling the forty companions."},{"id":"manas-2010:p1541:b001:l026","ordinal":66419,"en":"“Saying, ‘The Chinese come sweeping upon us,’"},{"id":"manas-2010:p1541:b001:l027","ordinal":66420,"en":"Saying, ‘My dear life will perish,’"},{"id":"manas-2010:p1541:b001:l028","ordinal":66421,"en":"Do not slacken your resolve;"},{"id":"manas-2010:p1541:b001:l029","ordinal":66422,"en":"Do not lose your spirit."},{"id":"manas-2010:p1541:b001:l030","ordinal":66423,"en":"Along Keng-Kol and Talas,"},{"id":"manas-2010:p1541:b001:l031","ordinal":66424,"en":"While Khan Manas was there,"},{"id":"manas-2010:p1541:b001:l032","ordinal":66425,"en":"We used to slice and eat rump meat;"},{"id":"manas-2010:p1541:b001:l033","ordinal":66426,"en":"‘The Chinese people behind their gates,"},{"id":"manas-2010:p1541:b001:l034","ordinal":66427,"en":"I alone am their match,’ we used to say."},{"id":"manas-2010:p1541:b001:l035","ordinal":66428,"en":"‘Red spears and hungry steel"},{"id":"manas-2010:p1541:b001:l036","ordinal":66429,"en":"We shall smear,’ we used to say."},{"id":"manas-2010:p1541:b001:l037","ordinal":66430,"en":"‘If the forty of us stand together,"},{"id":"manas-2010:p1541:b001:l038","ordinal":66431,"en":"We shall press forward,’ we used to say."},{"id":"manas-2010:p1541:b001:l039","ordinal":66432,"en":"The time to fight has come;"},{"id":"manas-2010:p1541:b001:l040","ordinal":66433,"en":"The hour to die has come!"},{"id":"manas-2010:p1541:b001:l041","ordinal":66434,"en":"From Beijing untouched by the holy one,"},{"id":"manas-2010:p1541:b001:l042","ordinal":66435,"en":"We shall not turn back without fighting."},{"id":"manas-2010:p1542:b001:l001","ordinal":66436,"en":"Does any person remain without dying?"},{"id":"manas-2010:p1542:b001:l002","ordinal":66437,"en":"We shall not return until we die!"},{"id":"manas-2010:p1542:b001:l003","ordinal":66438,"en":"What is written on our foreheads,"},{"id":"manas-2010:p1542:b001:l004","ordinal":66439,"en":"Whenever it comes, we shall face it."},{"id":"manas-2010:p1542:b001:l005","ordinal":66440,"en":"When we set out from Talas,"},{"id":"manas-2010:p1542:b001:l006","ordinal":66441,"en":"On that very day we died!"},{"id":"manas-2010:p1542:b001:l007","ordinal":66442,"en":"Watch, forty companions:"},{"id":"manas-2010:p1542:b001:l008","ordinal":66443,"en":"Holding my spear, I shall break their ranks;"},{"id":"manas-2010:p1542:b001:l009","ordinal":66444,"en":"If death is due, I shall fall to a shot!"},{"id":"manas-2010:p1542:b001:l010","ordinal":66445,"en":"Think of it, forty companions!"},{"id":"manas-2010:p1542:b001:l011","ordinal":66446,"en":"When my Lord gives the command,"},{"id":"manas-2010:p1542:b001:l012","ordinal":66447,"en":"When the death-angel stretches out his hand,"},{"id":"manas-2010:p1542:b001:l013","ordinal":66448,"en":"Will not the dug grave receive us?"},{"id":"manas-2010:p1542:b001:l014","ordinal":66449,"en":"Will not the dark earth contain us!"},{"id":"manas-2010:p1542:b001:l015","ordinal":66450,"en":"Is there a person who will not die?"},{"id":"manas-2010:p1542:b001:l016","ordinal":66451,"en":"Charge, companions;"},{"id":"manas-2010:p1542:b001:l017","ordinal":66452,"en":"Let us enter without wavering;"},{"id":"manas-2010:p1542:b001:l018","ordinal":66453,"en":"Making the Chinese cry out,"},{"id":"manas-2010:p1542:b001:l019","ordinal":66454,"en":"Let us drive them toward Beijing!"},{"id":"manas-2010:p1542:b001:l020","ordinal":66455,"en":"Let us leave their weak men alone;"},{"id":"manas-2010:p1542:b001:l021","ordinal":66456,"en":"Let us face and aim at their khans!”"},{"id":"manas-2010:p1542:b001:l022","ordinal":66457,"en":"Hero Syrgak charged,"},{"id":"manas-2010:p1542:b001:l023","ordinal":66458,"en":"Shouting with courage,"},{"id":"manas-2010:p1542:b001:l024","ordinal":66459,"en":"“Whoever stands without charging,"},{"id":"manas-2010:p1542:b001:l025","ordinal":66460,"en":"His seven forefathers are infidels!” he said."},{"id":"manas-2010:p1542:b001:l026","ordinal":66461,"en":"Syrgak entered their midst,"},{"id":"manas-2010:p1542:b001:l027","ordinal":66462,"en":"Girded with a golden belt,"},{"id":"manas-2010:p1542:b001:l028","ordinal":66463,"en":"His moon-like face marked by a swelling,"},{"id":"manas-2010:p1542:b001:l029","ordinal":66464,"en":"He pressed into their midst."},{"id":"manas-2010:p1542:b001:l030","ordinal":66465,"en":"Smashing them to pieces and raising dust,"},{"id":"manas-2010:p1542:b001:l031","ordinal":66466,"en":"While Syrgak fought,"},{"id":"manas-2010:p1542:b001:l032","ordinal":66467,"en":"Golden-forelocked, tasseled-belted,"},{"id":"manas-2010:p1542:b001:l033","ordinal":66468,"en":"Almambet, Azizkan's son,"},{"id":"manas-2010:p1542:b001:l034","ordinal":66469,"en":"Girding his waist securely,"},{"id":"manas-2010:p1542:b001:l035","ordinal":66470,"en":"Upon seven vast hosts of Chinese clans,"},{"id":"manas-2010:p1542:b001:l036","ordinal":66471,"en":"Entered alone to attack."},{"id":"manas-2010:p1542:b001:l037","ordinal":66472,"en":"Chubak, Khan Baltay's son,"},{"id":"manas-2010:p1542:b001:l038","ordinal":66473,"en":"Charged and made battle."},{"id":"manas-2010:p1542:b001:l039","ordinal":66474,"en":"Look at the haze, look at the embers;"},{"id":"manas-2010:p1542:b001:l040","ordinal":66475,"en":"When these three brought slaughter,"},{"id":"manas-2010:p1542:b001:l041","ordinal":66476,"en":"Look at the shots that struck unfailingly!"},{"id":"manas-2010:p1542:b001:l042","ordinal":66477,"en":"Look at the trenches dug,"},{"id":"manas-2010:p1543:b001:l001","ordinal":66478,"en":"Look at the boiling misery!"},{"id":"manas-2010:p1543:b001:l002","ordinal":66479,"en":"Bellowing their battle cry,"},{"id":"manas-2010:p1543:b001:l003","ordinal":66480,"en":"Look at the Chinese army surging forward!"},{"id":"manas-2010:p1543:b001:l004","ordinal":66481,"en":"Look at the dust that hides the sky;"},{"id":"manas-2010:p1543:b001:l005","ordinal":66482,"en":"Buried within the dust,"},{"id":"manas-2010:p1543:b001:l006","ordinal":66483,"en":"Look at the flowing blood!"},{"id":"manas-2010:p1543:b001:l007","ordinal":66484,"en":"Blazing up whenever they seem exhausted,"},{"id":"manas-2010:p1543:b001:l008","ordinal":66485,"en":"Look at the deeply rooted Chinese people;"},{"id":"manas-2010:p1543:b001:l009","ordinal":66486,"en":"Never looking back or retreating,"},{"id":"manas-2010:p1543:b001:l010","ordinal":66487,"en":"Look at the people fighting to destruction!"},{"id":"manas-2010:p1543:b001:l011","ordinal":66488,"en":"Shouting in wrath,"},{"id":"manas-2010:p1543:b001:l012","ordinal":66489,"en":"When the Chinese swept upon them,"},{"id":"manas-2010:p1543:b001:l013","ordinal":66490,"en":"Again the Chinese were barred"},{"id":"manas-2010:p1543:b001:l014","ordinal":66491,"en":"By Syrgak, Ulak Khan's son."},{"id":"manas-2010:p1543:b001:l015","ordinal":66492,"en":"(His strength could match the world;"},{"id":"manas-2010:p1543:b001:l016","ordinal":66493,"en":"Manas and hero Syrgak"},{"id":"manas-2010:p1543:b001:l017","ordinal":66494,"en":"Were the sons of brothers.)"},{"id":"manas-2010:p1543:b001:l018","ordinal":66495,"en":"Then Syrgak, dear lion,"},{"id":"manas-2010:p1543:b001:l019","ordinal":66496,"en":"Straining forward and bringing slaughter,"},{"id":"manas-2010:p1543:b001:l020","ordinal":66497,"en":"Riding the swift steed Kökchebich,"},{"id":"manas-2010:p1543:b001:l021","ordinal":66498,"en":"Pressing hard without drawing back,"},{"id":"manas-2010:p1543:b001:l022","ordinal":66499,"en":"As he fought with crashing blows,"},{"id":"manas-2010:p1543:b001:l023","ordinal":66500,"en":"The dear youth of twenty-one"},{"id":"manas-2010:p1543:b001:l024","ordinal":66501,"en":"Was covered in crimson blood,"},{"id":"manas-2010:p1543:b001:l025","ordinal":66502,"en":"His dear head suffering hardship."},{"id":"manas-2010:p1543:b001:l026","ordinal":66503,"en":"Wearing a coat of blue ribbed cloth,"},{"id":"manas-2010:p1543:b001:l027","ordinal":66504,"en":"Riding a horse like Kögala,"},{"id":"manas-2010:p1543:b001:l028","ordinal":66505,"en":"Tall of body, broad of shoulder,"},{"id":"manas-2010:p1543:b001:l029","ordinal":66506,"en":"Charged in from one side"},{"id":"manas-2010:p1543:b001:l030","ordinal":66507,"en":"Chubak, Khan Baltay's son."},{"id":"manas-2010:p1543:b001:l031","ordinal":66508,"en":"Their center, Almambet"},{"id":"manas-2010:p1543:b001:l032","ordinal":66509,"en":"Bored through as he came;"},{"id":"manas-2010:p1543:b001:l033","ordinal":66510,"en":"Their two flanks, hero Syrgak"},{"id":"manas-2010:p1543:b001:l034","ordinal":66511,"en":"Drove before him as he came;"},{"id":"manas-2010:p1543:b001:l035","ordinal":66512,"en":"Among the champions, lion Chubak"},{"id":"manas-2010:p1543:b001:l036","ordinal":66513,"en":"Came slaughtering them;"},{"id":"manas-2010:p1543:b001:l037","ordinal":66514,"en":"Toward Beijing in Kakan-Chin,"},{"id":"manas-2010:p1543:b001:l038","ordinal":66515,"en":"Making the Chinese bellow,"},{"id":"manas-2010:p1543:b001:l039","ordinal":66516,"en":"They drove and pressed them back."},{"id":"manas-2010:p1543:b001:l040","ordinal":66517,"en":"Where they waged their campaign,"},{"id":"manas-2010:p1543:b001:l041","ordinal":66518,"en":"Where they clashed fiercely,"},{"id":"manas-2010:p1543:b001:l042","ordinal":66519,"en":"Was the place called It-Ölbös,"},{"id":"manas-2010:p1544:b001:l001","ordinal":66520,"en":"A journey of forty days;"},{"id":"manas-2010:p1544:b001:l002","ordinal":66521,"en":"When a swan flew, its tail,"},{"id":"manas-2010:p1544:b001:l003","ordinal":66522,"en":"When a wild ass walked, its hooves,"},{"id":"manas-2010:p1544:b001:l004","ordinal":66523,"en":"Would be utterly burned in that land."},{"id":"manas-2010:p1544:b001:l005","ordinal":66524,"en":"Not a pinch of grass to eat,"},{"id":"manas-2010:p1544:b001:l006","ordinal":66525,"en":"Not a drop of water to splash,"},{"id":"manas-2010:p1544:b001:l007","ordinal":66526,"en":"When they reached that desert,"},{"id":"manas-2010:p1544:b001:l008","ordinal":66527,"en":"Kongurbay gathered courage;"},{"id":"manas-2010:p1544:b001:l009","ordinal":66528,"en":"The grim-faced khan came out before them;"},{"id":"manas-2010:p1544:b001:l010","ordinal":66529,"en":"At his voice, souls fled their bodies."},{"id":"manas-2010:p1544:b001:l011","ordinal":66530,"en":"Ay Jangjung and Kün Jangjung,"},{"id":"manas-2010:p1544:b001:l012","ordinal":66531,"en":"As comrades to the grim-faced one,"},{"id":"manas-2010:p1544:b001:l013","ordinal":66532,"en":"Had joined him in their fury."},{"id":"manas-2010:p1544:b001:l014","ordinal":66533,"en":"Kongurbay, Alöökö's son,"},{"id":"manas-2010:p1544:b001:l015","ordinal":66534,"en":"Charged without wavering;"},{"id":"manas-2010:p1544:b001:l016","ordinal":66535,"en":"Six thousand Chinese, a thousand governors,"},{"id":"manas-2010:p1544:b001:l017","ordinal":66536,"en":"Their outstanding one, Kongurbay,"},{"id":"manas-2010:p1544:b001:l018","ordinal":66537,"en":"He too came surging up."},{"id":"manas-2010:p1544:b001:l019","ordinal":66538,"en":"From the flank, Ay Jangjung,"},{"id":"manas-2010:p1544:b001:l020","ordinal":66539,"en":"With so many troops of soldiers,"},{"id":"manas-2010:p1544:b001:l021","ordinal":66540,"en":"He too swept upon them."},{"id":"manas-2010:p1544:b001:l022","ordinal":66541,"en":"Wind issuing from his mouth,"},{"id":"manas-2010:p1544:b001:l023","ordinal":66542,"en":"Fire pouring from his eyes,"},{"id":"manas-2010:p1544:b001:l024","ordinal":66543,"en":"Bringing many, many warriors,"},{"id":"manas-2010:p1544:b001:l025","ordinal":66544,"en":"Kün Jangjung entered thundering."},{"id":"manas-2010:p1544:b001:l026","ordinal":66545,"en":"The multitude of Chinese enclosed them like iron"},{"id":"manas-2010:p1544:b001:l027","ordinal":66546,"en":"And took them into their midst."},{"id":"manas-2010:p1544:b001:l028","ordinal":66547,"en":"Spearpoints clashed;"},{"id":"manas-2010:p1544:b001:l029","ordinal":66548,"en":"Human heads struck together;"},{"id":"manas-2010:p1544:b001:l030","ordinal":66549,"en":"Sword met sword;"},{"id":"manas-2010:p1544:b001:l031","ordinal":66550,"en":"They charged against one another;"},{"id":"manas-2010:p1544:b001:l032","ordinal":66551,"en":"Such a campaign now unfolded."},{"id":"manas-2010:p1544:b001:l033","ordinal":66552,"en":"Kongurbay, Alöökö's son,"},{"id":"manas-2010:p1544:b001:l034","ordinal":66553,"en":"Striking Algara with his whip,"},{"id":"manas-2010:p1544:b001:l035","ordinal":66554,"en":"Came charging at Chubak."},{"id":"manas-2010:p1544:b001:l036","ordinal":66555,"en":"When he was about to reach him at full charge,"},{"id":"manas-2010:p1544:b001:l037","ordinal":66556,"en":"From atop Kögala,"},{"id":"manas-2010:p1544:b001:l038","ordinal":66557,"en":"When he was about to knock him down in passing,"},{"id":"manas-2010:p1544:b001:l039","ordinal":66558,"en":"Almambet saw it."},{"id":"manas-2010:p1544:b001:l040","ordinal":66559,"en":"Sarala beneath him,"},{"id":"manas-2010:p1544:b001:l041","ordinal":66560,"en":"He spurred on one side, then the other,"}]
