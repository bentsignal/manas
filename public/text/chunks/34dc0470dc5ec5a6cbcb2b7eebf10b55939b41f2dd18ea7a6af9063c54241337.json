seytek-2012:p0420:b002:l026","ordinal":326633,"en":"Dragging their heads."},{"id":"seytek-2012:p0420:b002:l027","ordinal":326634,"en":"Deeply cut his eyes,"},{"id":"seytek-2012:p0420:b002:l028","ordinal":326635,"en":"When you draw in the air,"},{"id":"seytek-2012:p0420:b002:l029","ordinal":326636,"en":"It was too close."},{"id":"seytek-2012:p0420:b002:l030","ordinal":326637,"en":"Kneeling on the ground,"},{"id":"seytek-2012:p0420:b002:l031","ordinal":326638,"en":"Running happily"},{"id":"seytek-2012:p0420:b002:l032","ordinal":326639,"en":"Kanikei and Aichuruk"},{"id":"seytek-2012:p0420:b002:l033","ordinal":326640,"en":"Instead, they run,"},{"id":"seytek-2012:p0420:b002:l034","ordinal":326641,"en":"In front of the lion"},{"id":"seytek-2012:p0420:b002:l035","ordinal":326642,"en":"Visiting and bowing."},{"id":"seytek-2012:p0420:b002:l036","ordinal":326643,"en":"Weeping and crying"},{"id":"seytek-2012:p0420:b002:l037","ordinal":326644,"en":"Screaming with blood,"},{"id":"seytek-2012:p0420:b002:l038","ordinal":326645,"en":"Led by the pair,"},{"id":"seytek-2012:p0420:b002:l039","ordinal":326646,"en":"The grave is torn apart,"},{"id":"seytek-2012:p0420:b002:l040","ordinal":326647,"en":"The sad copper joins together,"},{"id":"seytek-2012:p0420:b003:l001","ordinal":326648,"en":"Things got better again,"},{"id":"seytek-2012:p0420:b003:l002","ordinal":326649,"en":"You want to stare"},{"id":"seytek-2012:p0420:b003:l003","ordinal":326650,"en":"He granted your wish."},{"id":"seytek-2012:p0420:b003:l004","ordinal":326651,"en":"Whatever you want,"},{"id":"seytek-2012:p0420:b003:l005","ordinal":326652,"en":"Your sadness is scattered,"},{"id":"seytek-2012:p0420:b003:l006","ordinal":326653,"en":"You were a virtuous soul,"},{"id":"seytek-2012:p0420:b003:l007","ordinal":326654,"en":"The garden is open again,"},{"id":"seytek-2012:p0420:b003:l008","ordinal":326655,"en":"Your inner foam is scattered,"},{"id":"seytek-2012:p0420:b003:l009","ordinal":326656,"en":"Your heartache subsides,"}]
