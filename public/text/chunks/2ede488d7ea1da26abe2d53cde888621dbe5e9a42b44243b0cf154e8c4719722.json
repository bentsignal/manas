[{"id":"semetey-1-2013:p0778:b004:l023","ordinal":135937,"en":"You think up wicked words,"},{"id":"semetey-1-2013:p0778:b004:l024","ordinal":135938,"en":"Never cease disrupting the people."},{"id":"semetey-1-2013:p0778:b004:l025","ordinal":135939,"en":"You have stirred strife throughout the world;"},{"id":"semetey-1-2013:p0778:b004:l026","ordinal":135940,"en":"You never tire of wickedness."},{"id":"semetey-1-2013:p0778:b004:l027","ordinal":135941,"en":"Doing this, old rogue, you will come to no good."},{"id":"semetey-1-2013:p0778:b004:l028","ordinal":135942,"en":"Bringing wickedness here,"},{"id":"semetey-1-2013:p0778:b004:l029","ordinal":135943,"en":"You have set him across my path."},{"id":"semetey-1-2013:p0778:b004:l030","ordinal":135944,"en":"Manas's orphan son"},{"id":"semetey-1-2013:p0778:b004:l031","ordinal":135945,"en":"You have brought as a bull camel against me."},{"id":"semetey-1-2013:p0778:b004:l032","ordinal":135946,"en":"In the days of your grizzled beard,"},{"id":"semetey-1-2013:p0778:b004:l033","ordinal":135947,"en":"You have done so much wickedness."},{"id":"semetey-1-2013:p0778:b004:l034","ordinal":135948,"en":"The bull camel who had died,"},{"id":"semetey-1-2013:p0778:b004:l035","ordinal":135949,"en":"Showing him as a living bull camel,"},{"id":"semetey-1-2013:p0778:b004:l036","ordinal":135950,"en":"You proclaim the glad news."},{"id":"semetey-1-2013:p0778:b004:l037","ordinal":135951,"en":"You worthless old rogue, you will come to no good;"},{"id":"semetey-1-2013:p0778:b004:l038","ordinal":135952,"en":"You will not cease your wickedness."},{"id":"semetey-1-2013:p0778:b004:l039","ordinal":135953,"en":"Your evil has reached so many people,"},{"id":"semetey-1-2013:p0779:b003:l001","ordinal":135954,"en":"Hiding yourself in Keng-Kol,"},{"id":"semetey-1-2013:p0779:b003:l002","ordinal":135955,"en":"The orphan who should have died long ago,"},{"id":"semetey-1-2013:p0779:b003:l003","ordinal":135956,"en":"You sent fleeing from broad Talas."},{"id":"semetey-1-2013:p0779:b003:l004","ordinal":135957,"en":"You damned slave Bakai,"},{"id":"semetey-1-2013:p0779:b003:l005","ordinal":135958,"en":"So much have you done,"},{"id":"semetey-1-2013:p0779:b003:l006","ordinal":135959,"en":"Hiding yourself in Talas."},{"id":"semetey-1-2013:p0779:b003:l007","ordinal":135960,"en":"The fool who should long ago have been destroyed,"},{"id":"semetey-1-2013:p0779:b003:l008","ordinal":135961,"en":"You sent fleeing on foot from Talas,"},{"id":"semetey-1-2013:p0779:b003:l009","ordinal":135962,"en":"And made my livestock plunder."},{"id":"semetey-1-2013:p0779:b003:l010","ordinal":135963,"en":"You damned slave Bakai,"},{"id":"semetey-1-2013:p0779:b003:l011","ordinal":135964,"en":"You have stirred my blood so much."},{"id":"semetey-1-2013:p0779:b003:l012","ordinal":135965,"en":"You have burned my soul like this;"},{"id":"semetey-1-2013:p0779:b003:l013","ordinal":135966,"en":"You squandered away"},{"id":"semetey-1-2013:p0779:b003:l014","ordinal":135967,"en":"My livestock in the treasury."},{"id":"semetey-1-2013:p0779:b003:l015","ordinal":135968,"en":"You turned your thoughts to wickedness,"},{"id":"semetey-1-2013:p0779:b003:l016","ordinal":135969,"en":"Grizzled slave Bakai;"},{"id":"semetey-1-2013:p0779:b003:l017","ordinal":135970,"en":"You made an eagle above my head"},{"id":"semetey-1-2013:p0779:b003:l018","ordinal":135971,"en":"Of your child left by Manas."},{"id":"semetey-1-2013:p0779:b003:l019","ordinal":135972,"en":"Now I shall ravage,"},{"id":"semetey-1-2013:p0779:b003:l020","ordinal":135973,"en":"Leveling your city,"},{"id":"semetey-1-2013:p0779:b003:l021","ordinal":135974,"en":"And offer as a sacrifice"},{"id":"semetey-1-2013:p0779:b003:l022","ordinal":135975,"en":"The child you have made your support!"},{"id":"semetey-1-2013:p0779:b003:l023","ordinal":135976,"en":"Father of the people, slave Bakai,"},{"id":"semetey-1-2013:p0779:b003:l025","ordinal":135977,"en":"I shall surely kill, slave Bakai,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0779:b003:l027","ordinal":135978,"en":"Today I learned, slave Bakai,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0779:b003:l028","ordinal":135979,"en":"How you and the orphan joined together,"},{"id":"semetey-1-2013:p0779:b003:l029","ordinal":135980,"en":"The words you spoke in council!"},{"id":"semetey-1-2013:p0779:b003:l030","ordinal":135981,"en":"Wicked graybeard Bakai,"},{"id":"semetey-1-2013:p0779:b003:l031","ordinal":135982,"en":"Let me rob you of your strength.”"},{"id":"semetey-1-2013:p0779:b003:l032","ordinal":135983,"en":"Raging and roaring,"},{"id":"semetey-1-2013:p0779:b003:l033","ordinal":135984,"en":"Filled with strength and thundering,"},{"id":"semetey-1-2013:p0779:b003:l034","ordinal":135985,"en":"The black, greasy pole"},{"id":"semetey-1-2013:p0779:b003:l035","ordinal":135986,"en":"He seized and swung,"},{"id":"semetey-1-2013:p0779:b003:l036","ordinal":135987,"en":"Making Bakai cry out,"},{"id":"semetey-1-2013:p0779:b003:l037","ordinal":135988,"en":"Struck him on the crown."},{"id":"semetey-1-2013:p0779:b003:l038","ordinal":135989,"en":"The pole landed powerfully;"},{"id":"semetey-1-2013:p0779:b003:l039","ordinal":135990,"en":"About four fingerbreadths of Bakai's"},{"id":"semetey-1-2013:p0779:b005:l001","ordinal":135991,"en":"Crown, upon the very top,"},{"id":"semetey-1-2013:p0779:b005:l002","ordinal":135992,"en":"Were split open."},{"id":"semetey-1-2013:p0779:b005:l003","ordinal":135993,"en":"Dear Kobosh loomed large,"},{"id":"semetey-1-2013:p0779:b005:l004","ordinal":135994,"en":"Swelling with rage,"},{"id":"semetey-1-2013:p0779:b005:l005","ordinal":135995,"en":"And reached Semetey."},{"id":"semetey-1-2013:p0779:b005:l006","ordinal":135996,"en":"With the pole, the child"},{"id":"semetey-1-2013:p0779:b005:l007","ordinal":135997,"en":"He was about to strike again,"},{"id":"semetey-1-2013:p0779:b005:l008","ordinal":135998,"en":"Than his father, wolf-maned Manas,"},{"id":"semetey-1-2013:p0779:b005:l009","ordinal":135999,"en":"This orphan had been born greater."},{"id":"semetey-1-2013:p0779:b005:l010","ordinal":136000,"en":"Before a word could be said,"},{"id":"semetey-1-2013:p0779:b005:l011","ordinal":136001,"en":"Before an eye could open and close,"},{"id":"semetey-1-2013:p0779:b005:l012","ordinal":136002,"en":"From valiant, wolf-maned Manas,"},{"id":"semetey-1-2013:p0779:b005:l013","ordinal":136003,"en":"Your dear lad left as a gift,"},{"id":"semetey-1-2013:p0779:b005:l014","ordinal":136004,"en":"The pole that would not spare him"},{"id":"semetey-1-2013:p0779:b005:l015","ordinal":136005,"en":"He tore from his hand and flung away."},{"id":"semetey-1-2013:p0779:b005:l016","ordinal":136006,"en":"He fixed his gaze upon the villain;"},{"id":"semetey-1-2013:p0779:b005:l017","ordinal":136007,"en":"Before he could twist and pull away,"},{"id":"semetey-1-2013:p0779:b005:l018","ordinal":136008,"en":"He seized the lead rope,"},{"id":"semetey-1-2013:p0779:b005:l019","ordinal":136009,"en":"Allowing Kobosh no movement,"},{"id":"semetey-1-2013:p0779:b005:l020","ordinal":136010,"en":"And held him fast."},{"id":"semetey-1-2013:p0779:b005:l021","ordinal":136011,"en":"Truly created by God,"},{"id":"semetey-1-2013:p0779:b005:l022","ordinal":136012,"en":"Have you seen that he is His servant?"},{"id":"semetey-1-2013:p0779:b005:l023","ordinal":136013,"en":"Of the poor hero Manas,"},{"id":"semetey-1-2013:p0779:b005:l024","ordinal":136014,"en":"Have you seen that he is the son?"},{"id":"semetey-1-2013:p0779:b005:l025","ordinal":136015,"en":"Zulpukor, left by Manas,"},{"id":"semetey-1-2013:p0779:b005:l026","ordinal":136016,"en":"Your dear orphan child,"},{"id":"semetey-1-2013:p0779:b005:l027","ordinal":136017,"en":"Grasping it by the hilt,"},{"id":"semetey-1-2013:p0779:b005:l028","ordinal":136018,"en":"Drew from its sheath."},{"id":"semetey-1-2013:p0779:b005:l029","ordinal":136019,"en":"When he was about to sacrifice him,"},{"id":"semetey-1-2013:p0779:b005:l030","ordinal":136020,"en":"About to sever his head,"},{"id":"semetey-1-2013:p0779:b005:l031","ordinal":136021,"en":"When Kobosh was about to perish,"},{"id":"semetey-1-2013:p0779:b005:l032","ordinal":136022,"en":"His uncle, old Bakai,"},{"id":"semetey-1-2013:p0779:b005:l033","ordinal":136023,"en":"The holy sage supported by Shay,"},{"id":"semetey-1-2013:p0779:b005:l034","ordinal":136024,"en":"“Grant me Kobosh's life,"},{"id":"semetey-1-2013:p0779:b005:l035","ordinal":136025,"en":"My dear orphan,"},{"id":"semetey-1-2013:p0779:b005:l036","ordinal":136026,"en":"Grant me his spoonful of blood!"},{"id":"semetey-1-2013:p0779:b005:l037","ordinal":136027,"en":"One who slaughters his kin will come to no good;"},{"id":"semetey-1-2013:p0779:b005:l038","ordinal":136028,"en":"An enemy does not become kin."},{"id":"semetey-1-2013:p0779:b005:l039","ordinal":136029,"en":"Can one who provokes him prosper,"},{"id":"semetey-1-2013:p0780:b003:l001","ordinal":136030,"en":"Will the Chinese become our kin?!"},{"id":"semetey-1-2013:p0780:b003:l002","ordinal":136031,"en":"If we live, my orphan,"},{"id":"semetey-1-2013:p0780:b003:l003","ordinal":136032,"en":"Tomorrow we shall settle in Talas."},{"id":"semetey-1-2013:p0780:b003:l004","ordinal":136033,"en":"‘They slaughtered Abyke,’ they will say,"},{"id":"semetey-1-2013:p0780:b003:l005","ordinal":136034,"en":"And we shall earn a wicked name."},{"id":"semetey-1-2013:p0780:b003:l006","ordinal":136035,"en":"‘Manas's son, the orphan hero,"},{"id":"semetey-1-2013:p0780:b003:l007","ordinal":136036,"en":"Found his kinsmen and went astray,’ they will say."},{"id":"semetey-1-2013:p0780:b003:l008","ordinal":136037,"en":"‘When he reached Talas,"},{"id":"semetey-1-2013:p0780:b003:l009","ordinal":136038,"en":"He slaughtered his Kobosh,’ they will say."},{"id":"semetey-1-2013:p0780:b003:l010","ordinal":136039,"en":"Many enemies will spread slander;"},{"id":"semetey-1-2013:p0780:b003:l011","ordinal":136040,"en":"Thus would God strike us."},{"id":"semetey-1-2013:p0780:b003:l012","ordinal":136041,"en":"Grant me Toruaygyr as a gift of mercy;"},{"id":"semetey-1-2013:p0780:b003:l013","ordinal":136042,"en":"Grant me your uncle's spoonful of blood."},{"id":"semetey-1-2013:p0780:b003:l014","ordinal":136043,"en":"Go and tell without reviling me,"},{"id":"semetey-1-2013:p0780:b003:l015","ordinal":136044,"en":"‘In his old age, my uncle Bakai"},{"id":"semetey-1-2013:p0780:b003:l016","ordinal":136045,"en":"Judged with great fairness,’"},{"id":"semetey-1-2013:p0780:b003:l017","ordinal":136046,"en":"Go and tell Kanykey."},{"id":"semetey-1-2013:p0780:b003:l018","ordinal":136047,"en":"Tell your khan, your grandfather Temir Khan,"},{"id":"semetey-1-2013:p0780:b003:l019","ordinal":136048,"en":"Tell all the people who know their lineage."},{"id":"semetey-1-2013:p0780:b003:l020","ordinal":136049,"en":"Your ocean-like uncle Bakai—"},{"id":"semetey-1-2013:p0780:b003:l022","ordinal":136050,"en":"I used to speak such just words,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0780:b003:l024","ordinal":136051,"en":"‘My uncle speaks well indeed,’ he would say;"},{"id":"semetey-1-2013:p0780:b003:l025","ordinal":136052,"en":"My Manas used to heed my words."},{"id":"semetey-1-2013:p0780:b003:l026","ordinal":136053,"en":"Bakai has a great regret;"},{"id":"semetey-1-2013:p0780:b003:l027","ordinal":136054,"en":"Such is this treacherous world."},{"id":"semetey-1-2013:p0780:b003:l028","ordinal":136055,"en":"I did not die before ocean-like Manas,"},{"id":"semetey-1-2013:p0780:b003:l029","ordinal":136056,"en":"I did not suffer the torments of the grave."},{"id":"semetey-1-2013:p0780:b003:l030","ordinal":136057,"en":"‘My wolf-maned uncle has died,’"},{"id":"semetey-1-2013:p0780:b003:l031","ordinal":136058,"en":"‘He has seen the place of Judgment,’ saying this,"},{"id":"semetey-1-2013:p0780:b003:l032","ordinal":136059,"en":"My precious Manas did not bury me."},{"id":"semetey-1-2013:p0780:b003:l033","ordinal":136060,"en":"Living by tending camels,"},{"id":"semetey-1-2013:p0780:b003:l034","ordinal":136061,"en":"Brave Bakai, left behind by his lord,"},{"id":"semetey-1-2013:p0780:b003:l035","ordinal":136062,"en":"Has lived to see this day.”"},{"id":"semetey-1-2013:p0780:b003:l036","ordinal":136063,"en":"The honored prince Bakai"},{"id":"semetey-1-2013:p0780:b003:l037","ordinal":136064,"en":"Stood interceding,"},{"id":"semetey-1-2013:p0780:b003:l038","ordinal":136065,"en":"And the orphan restrained his anger."},{"id":"semetey-1-2013:p0780:b003:l039","ordinal":136066,"en":"Who had stirred strife in so many places—"},{"id":"semetey-1-2013:p0780:b004:l001","ordinal":136067,"en":"This troublesome Kobosh,"},{"id":"semetey-1-2013:p0780:b004:l002","ordinal":136068,"en":"Upon Toruaygyr's head"},{"id":"semetey-1-2013:p0780:b004:l003","ordinal":136069,"en":"Was Akkula's bridle."},{"id":"semetey-1-2013:p0780:b004:l004","ordinal":136070,"en":"Now he unleashed his wrath again;"},{"id":"semetey-1-2013:p0780:b004:l005","ordinal":136071,"en":"From Toruaygyr, the bridle,"},{"id":"semetey-1-2013:p0780:b004:l006","ordinal":136072,"en":"Your wolf-maned hero Semetey"},{"id":"semetey-1-2013:p0780:b004:l007","ordinal":136073,"en":"Kicked and tore away."},{"id":"semetey-1-2013:p0780:b004:l008","ordinal":136074,"en":"Once the bridle left his head,"},{"id":"semetey-1-2013:p0780:b004:l009","ordinal":136075,"en":"Would Toruaygyr stand still?"},{"id":"semetey-1-2013:p0780:b004:l010","ordinal":136076,"en":"Without dashing toward his herd,"},{"id":"semetey-1-2013:p0780:b004:l011","ordinal":136077,"en":"Would God smite the stallion?"},{"id":"semetey-1-2013:p0780:b004:l012","ordinal":136078,"en":"Accursed be his Toruaygyr!"},{"id":"semetey-1-2013:p0780:b004:l013","ordinal":136079,"en":"Neighing, he dashed away,"},{"id":"semetey-1-2013:p0780:b004:l014","ordinal":136080,"en":"Dashing toward his herd;"},{"id":"semetey-1-2013:p0780:b004:l015","ordinal":136081,"en":"Kobosh was riding bareback."},{"id":"semetey-1-2013:p0780:b004:l016","ordinal":136082,"en":"His tailbone chafed and throbbed,"},{"id":"semetey-1-2013:p0780:b004:l017","ordinal":136083,"en":"The flesh of his buttocks was battered."},{"id":"semetey-1-2013:p0780:b004:l018","ordinal":136084,"en":"Toruaygyr raced, flying along;"},{"id":"semetey-1-2013:p0780:b004:l019","ordinal":136085,"en":"Gathering speed, Toruaygyr ran,"},{"id":"semetey-1-2013:p0780:b004:l020","ordinal":136086,"en":"Ran and reached the tether."},{"id":"semetey-1-2013:p0780:b004:l021","ordinal":136087,"en":"When he reached it and stopped short,"},{"id":"semetey-1-2013:p0780:b004:l022","ordinal":136088,"en":"That dog Kobosh, fit for burial,"},{"id":"semetey-1-2013:p0780:b004:l023","ordinal":136089,"en":"Was flung from his back."},{"id":"semetey-1-2013:p0780:b004:l024","ordinal":136090,"en":"Headlong went brave Kobosh,"},{"id":"semetey-1-2013:p0780:b004:l025","ordinal":136091,"en":"Falling to the ground."},{"id":"semetey-1-2013:p0780:b004:l026","ordinal":136092,"en":"A black stone beside the hearth—"},{"id":"semetey-1-2013:p0780:b004:l027","ordinal":136093,"en":"His head struck against it."},{"id":"semetey-1-2013:p0780:b004:l028","ordinal":136094,"en":"His head was battered,"},{"id":"semetey-1-2013:p0780:b004:l029","ordinal":136095,"en":"His blood streamed out."},{"id":"semetey-1-2013:p0780:b004:l030","ordinal":136096,"en":"Akylay ran up in distress;"},{"id":"semetey-1-2013:p0780:b004:l031","ordinal":136097,"en":"A broad finger-span and a fingerbreadth,"},{"id":"semetey-1-2013:p0780:b004:l032","ordinal":136098,"en":"Kobosh's head was split."},{"id":"semetey-1-2013:p0780:b004:l033","ordinal":136099,"en":"This foolish dog Kobosh's"},{"id":"semetey-1-2013:p0780:b004:l034","ordinal":136100,"en":"Crookedness was revealed."},{"id":"semetey-1-2013:p0780:b004:l035","ordinal":136101,"en":"Beaten by Toruaygyr,"},{"id":"semetey-1-2013:p0780:b004:l036","ordinal":136102,"en":"His wicked blood spilled,"},{"id":"semetey-1-2013:p0780:b004:l037","ordinal":136103,"en":"For seven days, weakened,"},{"id":"semetey-1-2013:p0780:b004:l038","ordinal":136104,"en":"Kobosh lay bleeding."},{"id":"semetey-1-2013:p0780:b004:l039","ordinal":136105,"en":"While Kobosh lay like this,"},{"id":"semetey-1-2013:p0781:b003:l001","ordinal":136106,"en":"The elders led by Kyrgyl,"},{"id":"semetey-1-2013:p0781:b003:l002","ordinal":136107,"en":"As though disaster had struck them,"},{"id":"semetey-1-2013:p0781:b003:l003","ordinal":136108,"en":"All forty companions"},{"id":"semetey-1-2013:p0781:b003:l004","ordinal":136109,"en":"Had gone scouting, surveying the land,"},{"id":"semetey-1-2013:p0781:b003:l005","ordinal":136110,"en":"Ten days' journey away."},{"id":"semetey-1-2013:p0781:b003:l006","ordinal":136111,"en":"Before the companions returned from their patrol,"},{"id":"semetey-1-2013:p0781:b003:l007","ordinal":136112,"en":"As though an evil spirit had struck him,"},{"id":"semetey-1-2013:p0781:b003:l008","ordinal":136113,"en":"That very fool Köbösh"},{"id":"semetey-1-2013:p0781:b003:l009","ordinal":136114,"en":"Had been struck down by God."},{"id":"semetey-1-2013:p0781:b003:l010","ordinal":136115,"en":"His wealth had been plundered;"},{"id":"semetey-1-2013:p0781:b003:l011","ordinal":136116,"en":"Bakai and Semetey"},{"id":"semetey-1-2013:p0781:b003:l012","ordinal":136117,"en":"Together had finished off that dog."},{"id":"semetey-1-2013:p0781:b003:l013","ordinal":136118,"en":"The possessions left by Manas"},{"id":"semetey-1-2013:p0781:b003:l014","ordinal":136119,"en":"They had carried away together."},{"id":"semetey-1-2013:p0781:b003:l015","ordinal":136120,"en":"The wealth left by Manas—"},{"id":"semetey-1-2013:p0781:b003:l016","ordinal":136121,"en":"Akolpok and Akkelte,"},{"id":"semetey-1-2013:p0781:b003:l017","ordinal":136122,"en":"The gray belt-pouch and Altykurch—"},{"id":"semetey-1-2013:p0781:b003:l018","ordinal":136123,"en":"Of Manas, that great, fierce hero,"},{"id":"semetey-1-2013:p0781:b003:l019","ordinal":136124,"en":"The painted spear was gone too."},{"id":"semetey-1-2013:p0781:b003:l020","ordinal":136125,"en":"“The orphan has plundered them!”"},{"id":"semetey-1-2013:p0781:b003:l021","ordinal":136126,"en":"Akylai stood snarling,"},{"id":"semetey-1-2013:p0781:b003:l022","ordinal":136127,"en":"Urging all forty companions on,"},{"id":"semetey-1-2013:p0781:b003:l023","ordinal":136128,"en":"Shrieking out her cries:"},{"id":"semetey-1-2013:p0781:b003:l024","ordinal":136129,"en":"“Damn you, forty companions!"},{"id":"semetey-1-2013:p0781:b003:l025","ordinal":136130,"en":"With my magnanimous Khan Manas"},{"id":"semetey-1-2013:p0781:b003:l026","ordinal":136131,"en":"You joined when tiny as lice,"},{"id":"semetey-1-2013:p0781:b003:l027","ordinal":136132,"en":"You met when small as ticks."},{"id":"semetey-1-2013:p0781:b003:l028","ordinal":136133,"en":"My dear forty companions,"},{"id":"semetey-1-2013:p0781:b003:l029","ordinal":136134,"en":"Raise the battle cry against the fugitive;"},{"id":"semetey-1-2013:p0781:b003:l030","ordinal":136135,"en":"The possessions he carried off,"},{"id":"semetey-1-2013:p0781:b003:l031","ordinal":136136,"en":"Bring them back to me."},{"id":"semetey-1-2013:p0781:b003:l032","ordinal":136137,"en":"For Manas, whose spirit is mighty,"},{"id":"semetey-1-2013:p0781:b003:l033","ordinal":136138,"en":"For his spirit's sake, forty companions,"},{"id":"semetey-1-2013:p0781:b003:l034","ordinal":136139,"en":"Raise a mighty battle cry!”"},{"id":"semetey-1-2013:p0781:b003:l035","ordinal":136140,"en":"As though pierced by an awl,"},{"id":"semetey-1-2013:p0781:b003:l036","ordinal":136141,"en":"The forty companions sprang up."},{"id":"semetey-1-2013:p0781:b003:l037","ordinal":136142,"en":"Ajybai and Shuutu said:"},{"id":"semetey-1-2013:p0781:b003:l038","ordinal":136143,"en":"“You bellow, Akylai,"},{"id":"semetey-1-2013:p0781:b003:l039","ordinal":136144,"en":"And fill our hearts with care."},{"id":"semetey-1-2013:p0781:b004:l001","ordinal":136145,"en":"The forty companions will perish in the wilds."},{"id":"semetey-1-2013:p0781:b004:l002","ordinal":136146,"en":"How could we dare attack"},{"id":"semetey-1-2013:p0781:b004:l003","ordinal":136147,"en":"The child of Manas, blessed by Khyzyr,"},{"id":"semetey-1-2013:p0781:b004:l004","ordinal":136148,"en":"The son he had at his death?"},{"id":"semetey-1-2013:p0781:b004:l006","ordinal":136149,"en":"He is no dark, rugged mountain","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0781:b004:l007","ordinal":136150,"en":"For us to charge and fight;"},{"id":"semetey-1-2013:p0781:b004:l008","ordinal":136151,"en":"That leopard Semetey"},{"id":"semetey-1-2013:p0781:b004:l009","ordinal":136152,"en":"Is no enemy come from the Kalmyks."},{"id":"semetey-1-2013:p0781:b004:l010","ordinal":136153,"en":"Sister-in-law Akylai, listen:"},{"id":"semetey-1-2013:p0781:b004:l011","ordinal":136154,"en":"This idea of yours is mad."},{"id":"semetey-1-2013:p0781:b004:l012","ordinal":136155,"en":"If we defy that righteous spirit,"},{"id":"semetey-1-2013:p0781:b004:l013","ordinal":136156,"en":"Will God strike the companions down"},{"id":"semetey-1-2013:p0781:b004:l014","ordinal":136157,"en":"Of the falcon, brave Manas,"},{"id":"semetey-1-2013:p0781:b004:l015","ordinal":136158,"en":"For attacking his only son?"},{"id":"semetey-1-2013:p0781:b004:l016","ordinal":136159,"en":"Manas's salt has great power;"},{"id":"semetey-1-2013:p0781:b004:l017","ordinal":136160,"en":"Will his salt not destroy us?"},{"id":"semetey-1-2013:p0781:b004:l018","ordinal":136161,"en":"Manas's spirit has great power;"},{"id":"semetey-1-2013:p0781:b004:l019","ordinal":136162,"en":"Will his spirit not destroy us?"},{"id":"semetey-1-2013:p0781:b004:l020","ordinal":136163,"en":"The lord’s only son—"},{"id":"semetey-1-2013:p0781:b004:l021","ordinal":136164,"en":"Can anyone who attacks him prosper?"},{"id":"semetey-1-2013:p0781:b004:l022","ordinal":136165,"en":"Would one rise after a blow from the side?"},{"id":"semetey-1-2013:p0781:b004:l023","ordinal":136166,"en":"Can anyone prosper who attacks the lord?"},{"id":"semetey-1-2013:p0781:b004:l024","ordinal":136167,"en":"Would one rise after a blow from above?"},{"id":"semetey-1-2013:p0781:b004:l025","ordinal":136168,"en":"Can anyone prosper who attacks the only son?"},{"id":"semetey-1-2013:p0781:b004:l026","ordinal":136169,"en":"Would one rise after a blow at the soul?"},{"id":"semetey-1-2013:p0781:b004:l027","ordinal":136170,"en":"When Semetey was born,"},{"id":"semetey-1-2013:p0781:b004:l028","ordinal":136171,"en":"All forty companions were there,"},{"id":"semetey-1-2013:p0781:b004:l029","ordinal":136172,"en":"The elders led by Kyrgyl were there."},{"id":"semetey-1-2013:p0781:b004:l030","ordinal":136173,"en":"When nine hundred barren mares were slaughtered for his feast,"},{"id":"semetey-1-2013:p0781:b004:l031","ordinal":136174,"en":"When he was named Semetey,"},{"id":"semetey-1-2013:p0781:b004:l032","ordinal":136175,"en":"Khyzyr ate at his feast and departed,"},{"id":"semetey-1-2013:p0781:b004:l033","ordinal":136176,"en":"Saying, ‘If this little fellow lives,"},{"id":"semetey-1-2013:p0781:b004:l034","ordinal":136177,"en":"He will accomplish much.’"},{"id":"semetey-1-2013:p0781:b004:l035","ordinal":136178,"en":"When Kanykei had just given birth,"},{"id":"semetey-1-2013:p0781:b004:l036","ordinal":136179,"en":"Manas swelled with pride;"},{"id":"semetey-1-2013:p0781:b004:l037","ordinal":136180,"en":"The ninety giants who came to the feast,"},{"id":"semetey-1-2013:p0781:b004:l038","ordinal":136181,"en":"Led by mountain-like Koshoi,"},{"id":"semetey-1-2013:p0781:b004:l039","ordinal":136182,"en":"Lavished praise upon him,"},{"id":"semetey-1-2013:p0782:b003:l001","ordinal":136183,"en":"As though allotting him an inheritance,"},{"id":"semetey-1-2013:p0782:b003:l002","ordinal":136184,"en":"They all took him in their arms and weighed him:"},{"id":"semetey-1-2013:p0782:b003:l003","ordinal":136185,"en":"‘The fierce hero's only offspring,’ they said,"},{"id":"semetey-1-2013:p0782:b003:l004","ordinal":136186,"en":"‘The little fellow born so late.’"},{"id":"semetey-1-2013:p0782:b003:l005","ordinal":136187,"en":"He received Koshoi's blessing,"},{"id":"semetey-1-2013:p0782:b003:l006","ordinal":136188,"en":"The great men's favor rested on him."},{"id":"semetey-1-2013:p0782:b003:l007","ordinal":136189,"en":"Whoever rivals him will not prosper;"},{"id":"semetey-1-2013:p0782:b003:l008","ordinal":136190,"en":"Whoever attacks him will not remain whole."},{"id":"semetey-1-2013:p0782:b003:l009","ordinal":136191,"en":"When the orphan, Manas's son,"},{"id":"semetey-1-2013:p0782:b003:l010","ordinal":136192,"en":"Had only just been born,"}]
