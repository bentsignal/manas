{"id": "sayakbay-ms-current146:pdf133:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 133, "folio": 516, "line_in_page": 17, "raw": "Чаргын көрдүм алыстан,", "text": "Чаргын көрдүм алыстан,", "en": "I saw Chargyn from afar,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf133:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 133, "folio": 516, "line_in_page": 18, "raw": "Кылым-газым кымбат муну,", "text": "Кылым-газым кымбат муну,", "en": "This was precious through all the ages,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; word division, lexical form, or idiomatic interpretation may require review.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf133:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 133, "folio": 516, "line_in_page": 19, "raw": "Кыйгырын жерден болуппайт,", "text": "Кыйгырын жерден болуппайт,", "en": "Nothing like it could be found on earth,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; word division, lexical form, or idiomatic interpretation may require review.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf133:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 133, "folio": 516, "line_in_page": 20, "raw": "Бу кызыталак доңуздун,", "text": "Бу кызыталак доңуздун,", "en": "Of this accursed swine,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf133:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 133, "folio": 516, "line_in_page": 21, "raw": "Бу кыргыздан тийсе колуна,", "text": "Бу кыргыздан тийсе колуна,", "en": "If any Kyrgyz fell into his hands,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf133:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 133, "folio": 516, "line_in_page": 22, "raw": "Бу кылганы туру көрүнбөйт.", "text": "Бу кылганы туру көрүнбөйт.", "en": "There seemed no end to what he did.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; word division, lexical form, or idiomatic interpretation may require review.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf133:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 133, "folio": 516, "line_in_page": 23, "raw": "Бу киндик кескен, кир жууган,", "text": "Бу киндик кескен, кир жууган,", "en": "This land where our cord was cut and our swaddling washed,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf133:l024", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 133, "folio": 516, "line_in_page": 24, "raw": "Бу бабабыз күткөн Ала-Тоо,", "text": "Бу бабабыз күткөн Ала-Тоо,", "en": "This Ala-Too our forefathers tended,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf133:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 133, "folio": 516, "line_in_page": 25, "raw": "Жердеги туру көрүнбөйт,", "text": "Жердеги туру көрүнбөйт,", "en": "Its true state upon the earth could no longer be seen,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; word division, lexical form, or idiomatic interpretation may require review.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf133:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 133, "folio": 516, "line_in_page": 26, "raw": "Турмушту оңдолбойт,", "text": "Турмушту оңдолбойт,", "en": "Life would not be set right,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; word division, lexical form, or idiomatic interpretation may require review.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf133:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 133, "folio": 516, "line_in_page": 27, "raw": "Эркинден жаткан эл-журтту,", "text": "Эркинден жаткан эл-журтту,", "en": "The people who had lived in freedom,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf133:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 133, "folio": 516, "line_in_page": 28, "raw": "Элдин жайга кондурбайт,", "text": "Элдин жайга кондурбайт,", "en": "He would not let the people settle in their summer pastures,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf133:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 133, "folio": 516, "line_in_page": 29, "raw": "Бу жемин талап кыйратат,", "text": "Бу жемин талап кыйратат,", "en": "He plundered their sustenance and ruined them,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf133:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 133, "folio": 516, "line_in_page": 30, "raw": "Бу жерде биздин оңдолбойт.", "text": "Бу жерде биздин оңдолбойт.", "en": "Our lot in this place would not improve.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; word division, lexical form, or idiomatic interpretation may require review.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf133:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 133, "folio": 516, "line_in_page": 31, "raw": "Бу калырга жарым кан төгөт,", "text": "Бу калырга жарым кан төгөт,", "en": "For this wretch, half the people would spill their blood,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; word division, lexical form, or idiomatic interpretation may require review.", "bbox": null}
