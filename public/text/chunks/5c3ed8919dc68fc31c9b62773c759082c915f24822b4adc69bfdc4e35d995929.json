[{"id":"semetey-1-2013:p1076:b003:l010","ordinal":159233,"en":"Will Toltoy seize him,"},{"id":"semetey-1-2013:p1076:b003:l011","ordinal":159234,"en":"And, before he can say the Bismillah,"},{"id":"semetey-1-2013:p1076:b003:l012","ordinal":159235,"en":"Slaughter him as a sacrifice?"},{"id":"semetey-1-2013:p1076:b003:l013","ordinal":159236,"en":"He has no mane against which to scratch;"},{"id":"semetey-1-2013:p1076:b003:l014","ordinal":159237,"en":"To the Argyn and Kyrgyz,"},{"id":"semetey-1-2013:p1076:b003:l015","ordinal":159238,"en":"Will the prince return slack and helpless?!"},{"id":"semetey-1-2013:p1076:b003:l016","ordinal":159239,"en":"Before he reaches maturity,"},{"id":"semetey-1-2013:p1076:b003:l017","ordinal":159240,"en":"Will my indispensable Külchoro"},{"id":"semetey-1-2013:p1076:b003:l018","ordinal":159241,"en":"Die a needless death?\""},{"id":"semetey-1-2013:p1076:b003:l019","ordinal":159242,"en":"Speaking and grieving so, Semetey"},{"id":"semetey-1-2013:p1076:b003:l020","ordinal":159243,"en":"Stood there as a sorrowing prince;"},{"id":"semetey-1-2013:p1076:b003:l021","ordinal":159244,"en":"The common people wept, the khan wept,"},{"id":"semetey-1-2013:p1076:b003:l022","ordinal":159245,"en":"All the gathered multitude wept,"},{"id":"semetey-1-2013:p1076:b003:l023","ordinal":159246,"en":"The beauty Aychürök wept,"},{"id":"semetey-1-2013:p1076:b003:l024","ordinal":159247,"en":"And the young women and maidens cried aloud."},{"id":"semetey-1-2013:p1076:b003:l025","ordinal":159248,"en":"Brave Semeң, son of Manas,"},{"id":"semetey-1-2013:p1076:b003:l026","ordinal":159249,"en":"Born of his father, gray-maned Manas,"},{"id":"semetey-1-2013:p1076:b003:l027","ordinal":159250,"en":"A hero greater than he—"},{"id":"semetey-1-2013:p1076:b003:l028","ordinal":159251,"en":"Your prince did not stop then."},{"id":"semetey-1-2013:p1076:b003:l029","ordinal":159252,"en":"Taking the inner shortcut,"},{"id":"semetey-1-2013:p1076:b003:l030","ordinal":159253,"en":"He brought out the gray mare"},{"id":"semetey-1-2013:p1076:b003:l031","ordinal":159254,"en":"Of Khan Akun, barren for six years,"},{"id":"semetey-1-2013:p1076:b003:l032","ordinal":159255,"en":"Leading it by the halter."},{"id":"semetey-1-2013:p1076:b003:l033","ordinal":159256,"en":"The leopard born of a gray-maned lion"},{"id":"semetey-1-2013:p1076:b003:l034","ordinal":159257,"en":"Made it rear, crying, \"Amen!\""},{"id":"semetey-1-2013:p1076:b003:l035","ordinal":159258,"en":"He now grasped together"},{"id":"semetey-1-2013:p1076:b003:l036","ordinal":159259,"en":"Its forelock and its ear,"},{"id":"semetey-1-2013:p1076:b003:l037","ordinal":159260,"en":"Then took in his hand"},{"id":"semetey-1-2013:p1076:b003:l038","ordinal":159261,"en":"The white saber with mottled neck."},{"id":"semetey-1-2013:p1076:b003:l039","ordinal":159262,"en":"Holding the mare upright,"},{"id":"semetey-1-2013:p1076:b004:l001","ordinal":159263,"en":"He now cut off its head:"},{"id":"semetey-1-2013:p1076:b004:l002","ordinal":159264,"en":"\"Make this an age without grief;"},{"id":"semetey-1-2013:p1076:b004:l003","ordinal":159265,"en":"If God created him as a living soul,"},{"id":"semetey-1-2013:p1076:b004:l004","ordinal":159266,"en":"Keep Külchoro safe!\""},{"id":"semetey-1-2013:p1076:b004:l005","ordinal":159267,"en":"Your heroic gray-maned lion"},{"id":"semetey-1-2013:p1076:b004:l006","ordinal":159268,"en":"Now sacrificed the white-gray mare;"},{"id":"semetey-1-2013:p1076:b004:l007","ordinal":159269,"en":"Spreading his hands, saying, \"Amen,\""},{"id":"semetey-1-2013:p1076:b004:l008","ordinal":159270,"en":"He now performed the rite"},{"id":"semetey-1-2013:p1076:b004:l009","ordinal":159271,"en":"And sent the boy on his way."},{"id":"semetey-1-2013:p1076:b004:l010","ordinal":159272,"en":"Then Külchoro, son of Almambet,"},{"id":"semetey-1-2013:p1076:b004:l011","ordinal":159273,"en":"Girded on a silver belt,"},{"id":"semetey-1-2013:p1076:b004:l012","ordinal":159274,"en":"His sunlike face touched with radiance,"},{"id":"semetey-1-2013:p1076:b004:l013","ordinal":159275,"en":"Dressed in a coat no bullet pierced."},{"id":"semetey-1-2013:p1076:b004:l014","ordinal":159276,"en":"When told he was going to Toltoy,"},{"id":"semetey-1-2013:p1076:b004:l015","ordinal":159277,"en":"Without frown or knitted brow,"},{"id":"semetey-1-2013:p1076:b004:l016","ordinal":159278,"en":"The boy smiled openly in joy."},{"id":"semetey-1-2013:p1076:b004:l017","ordinal":159279,"en":"He was as large as half a mountain;"},{"id":"semetey-1-2013:p1076:b004:l018","ordinal":159280,"en":"An ancestral spirit settled upon the boy."},{"id":"semetey-1-2013:p1076:b004:l019","ordinal":159281,"en":"He wheeled Arbuudan sideways,"},{"id":"semetey-1-2013:p1076:b004:l020","ordinal":159282,"en":"And, angling close"},{"id":"semetey-1-2013:p1076:b004:l021","ordinal":159283,"en":"To his elder Semetey,"},{"id":"semetey-1-2013:p1076:b004:l022","ordinal":159284,"en":"Gave leave and began to speak:"},{"id":"semetey-1-2013:p1076:b004:l023","ordinal":159285,"en":"\"Gray-maned elder brother, leopard!"},{"id":"semetey-1-2013:p1076:b004:l024","ordinal":159286,"en":"Who would rejoice at this?"},{"id":"semetey-1-2013:p1076:b004:l025","ordinal":159287,"en":"Why do you keep grieving"},{"id":"semetey-1-2013:p1076:b004:l026","ordinal":159288,"en":"For the servant you raised?"},{"id":"semetey-1-2013:p1076:b004:l027","ordinal":159289,"en":"You have kin, you have your beloved;"},{"id":"semetey-1-2013:p1076:b004:l028","ordinal":159290,"en":"You have every enemy before you,"},{"id":"semetey-1-2013:p1076:b004:l029","ordinal":159291,"en":"My falcon elder brother—farewell."},{"id":"semetey-1-2013:p1076:b004:l030","ordinal":159292,"en":"God knows whether I shall die"},{"id":"semetey-1-2013:p1076:b004:l031","ordinal":159293,"en":"At Toltoy of the Zhediger's hands;"},{"id":"semetey-1-2013:p1076:b004:l032","ordinal":159294,"en":"God knows whether I shall remain alive."},{"id":"semetey-1-2013:p1076:b004:l033","ordinal":159295,"en":"You stand in needless worry"},{"id":"semetey-1-2013:p1076:b004:l034","ordinal":159296,"en":"And keep grieving in vain"},{"id":"semetey-1-2013:p1076:b004:l035","ordinal":159297,"en":"For an orphan boy like me."},{"id":"semetey-1-2013:p1076:b004:l036","ordinal":159298,"en":"I am a bound-headed boy,"},{"id":"semetey-1-2013:p1076:b004:l037","ordinal":159299,"en":"As though I had come here in resentment;"},{"id":"semetey-1-2013:p1076:b004:l038","ordinal":159300,"en":"From the beginning I was a servant"},{"id":"semetey-1-2013:p1076:b004:l039","ordinal":159301,"en":"Who girded your waist securely—"},{"id":"semetey-1-2013:p1077:b003:l001","ordinal":159302,"en":"Born as your own kinsman,"},{"id":"semetey-1-2013:p1077:b003:l002","ordinal":159303,"en":"When was I ever a son of Manas?"},{"id":"semetey-1-2013:p1077:b003:l003","ordinal":159304,"en":"You were traced from the very loins"},{"id":"semetey-1-2013:p1077:b003:l004","ordinal":159305,"en":"Of noble, generous Manas;"},{"id":"semetey-1-2013:p1077:b003:l005","ordinal":159306,"en":"You burst forth, tearing the womb"},{"id":"semetey-1-2013:p1077:b003:l006","ordinal":159307,"en":"Of my noble mother Kanykey."},{"id":"semetey-1-2013:p1077:b003:l007","ordinal":159308,"en":"When was I ever a son of Manas?"},{"id":"semetey-1-2013:p1077:b003:l008","ordinal":159309,"en":"If I should die,"},{"id":"semetey-1-2013:p1077:b003:l009","ordinal":159310,"en":"I was a dog-hide slave;"},{"id":"semetey-1-2013:p1077:b003:l010","ordinal":159311,"en":"While I remain alive,"},{"id":"semetey-1-2013:p1077:b003:l011","ordinal":159312,"en":"I am a sheepskin slave."},{"id":"semetey-1-2013:p1077:b003:l012","ordinal":159313,"en":"Do not grieve without cause;"},{"id":"semetey-1-2013:p1077:b003:l013","ordinal":159314,"en":"I was one of the acknowledged servants."},{"id":"semetey-1-2013:p1077:b003:l014","ordinal":159315,"en":"My last request to you, elder brother:"},{"id":"semetey-1-2013:p1077:b003:l015","ordinal":159316,"en":"If I die at Toltoy's hands,"},{"id":"semetey-1-2013:p1077:b003:l016","ordinal":159317,"en":"You will recite the Quran and bury me."},{"id":"semetey-1-2013:p1077:b003:l017","ordinal":159318,"en":"If I return having killed Toltoy,"},{"id":"semetey-1-2013:p1077:b003:l018","ordinal":159319,"en":"My name of \"slave\" will disappear,"},{"id":"semetey-1-2013:p1077:b003:l019","ordinal":159320,"en":"My poor soul will be restored;"},{"id":"semetey-1-2013:p1077:b003:l020","ordinal":159321,"en":"So that I may become a sultan,"},{"id":"semetey-1-2013:p1077:b003:l021","ordinal":159322,"en":"At the very least, leopard,"},{"id":"semetey-1-2013:p1077:b003:l022","ordinal":159323,"en":"You will give me the Argyn people."},{"id":"semetey-1-2013:p1077:b003:l023","ordinal":159324,"en":"Farewell then, leopard!\""},{"id":"semetey-1-2013:p1077:b003:l024","ordinal":159325,"en":"Speaking so, Külchoro"},{"id":"semetey-1-2013:p1077:b003:l025","ordinal":159326,"en":"Seized the nearby prince"},{"id":"semetey-1-2013:p1077:b003:l026","ordinal":159327,"en":"Around the neck."},{"id":"semetey-1-2013:p1077:b003:l027","ordinal":159328,"en":"The gathered folds of his shirt"},{"id":"semetey-1-2013:p1077:b003:l028","ordinal":159329,"en":"Burst apart, and Semetey"},{"id":"semetey-1-2013:p1077:b003:l029","ordinal":159330,"en":"Tore every one away."},{"id":"semetey-1-2013:p1077:b003:l030","ordinal":159331,"en":"Beneath his chin,"},{"id":"semetey-1-2013:p1077:b003:l031","ordinal":159332,"en":"Above his beard,"},{"id":"semetey-1-2013:p1077:b003:l032","ordinal":159333,"en":"He kissed him firmly with a roar;"},{"id":"semetey-1-2013:p1077:b003:l033","ordinal":159334,"en":"\"Farewell, elder brother!\" he said, kissing him."},{"id":"semetey-1-2013:p1077:b003:l034","ordinal":159335,"en":"As the boy stood so,"},{"id":"semetey-1-2013:p1077:b003:l035","ordinal":159336,"en":"Khan Akun and his city cried aloud;"},{"id":"semetey-1-2013:p1077:b003:l036","ordinal":159337,"en":"Every soul who saw him"},{"id":"semetey-1-2013:p1077:b003:l037","ordinal":159338,"en":"Shed streaming tears from their eyes."},{"id":"semetey-1-2013:p1077:b003:l038","ordinal":159339,"en":"Semetey could not bear to watch."},{"id":"semetey-1-2013:p1077:b003:l039","ordinal":159340,"en":"The Kasaba banner floated in his hand,"},{"id":"semetey-1-2013:p1077:b004:l001","ordinal":159341,"en":"Syrnayza flashed in his hand;"},{"id":"semetey-1-2013:p1077:b004:l002","ordinal":159342,"en":"The hearts of those who saw were divided."},{"id":"semetey-1-2013:p1077:b004:l003","ordinal":159343,"en":"Appearing like Opol Mountain,"},{"id":"semetey-1-2013:p1077:b004:l004","ordinal":159344,"en":"He caught up the black-jawed whip"},{"id":"semetey-1-2013:p1077:b004:l005","ordinal":159345,"en":"And swung it around;"},{"id":"semetey-1-2013:p1077:b004:l006","ordinal":159346,"en":"He pulled fairy-like Buurul"},{"id":"semetey-1-2013:p1077:b004:l007","ordinal":159347,"en":"Sideways and let him go,"},{"id":"semetey-1-2013:p1077:b004:l008","ordinal":159348,"en":"Breaking the face of the earth."},{"id":"semetey-1-2013:p1077:b004:l009","ordinal":159349,"en":"Külchoro rode away at a gallop"},{"id":"semetey-1-2013:p1077:b004:l010","ordinal":159350,"en":"Toward Toltoy."},{"id":"semetey-1-2013:p1077:b004:l011","ordinal":159351,"en":"Your prince could not remain still;"},{"id":"semetey-1-2013:p1077:b004:l012","ordinal":159352,"en":"He now took a spyglass in his hand"},{"id":"semetey-1-2013:p1077:b004:l013","ordinal":159353,"en":"And trained it after"},{"id":"semetey-1-2013:p1077:b004:l014","ordinal":159354,"en":"The ill-fated Choro."},{"id":"semetey-1-2013:p1077:b004:l015","ordinal":159355,"en":"A black-striped leopard"},{"id":"semetey-1-2013:p1077:b004:l016","ordinal":159356,"en":"Strained along at his flank;"},{"id":"semetey-1-2013:p1077:b004:l017","ordinal":159357,"en":"The spirit of his khan and father Manas"},{"id":"semetey-1-2013:p1077:b004:l018","ordinal":159358,"en":"Had taken him under its protection."},{"id":"semetey-1-2013:p1077:b004:l019","ordinal":159359,"en":"A short-maned blue lion"},{"id":"semetey-1-2013:p1077:b004:l020","ordinal":159360,"en":"Strained beside him;"},{"id":"semetey-1-2013:p1077:b004:l021","ordinal":159361,"en":"Almambet's spirit"},{"id":"semetey-1-2013:p1077:b004:l022","ordinal":159362,"en":"Had taken him under its care."},{"id":"semetey-1-2013:p1077:b004:l023","ordinal":159363,"en":"The Forty Chiltens and Khidr Ilyas,"},{"id":"semetey-1-2013:p1077:b004:l024","ordinal":159364,"en":"Each becoming a host of a thousand,"},{"id":"semetey-1-2013:p1077:b004:l025","ordinal":159365,"en":"Shouted encouragement behind him."},{"id":"semetey-1-2013:p1077:b004:l026","ordinal":159366,"en":"Nine patron spirits"},{"id":"semetey-1-2013:p1077:b004:l027","ordinal":159367,"en":"Readied themselves at his armpits;"},{"id":"semetey-1-2013:p1077:b004:l028","ordinal":159368,"en":"Dock-tailed blue wolves,"},{"id":"semetey-1-2013:p1077:b004:l029","ordinal":159369,"en":"Appearing as some forty living beings,"},{"id":"semetey-1-2013:p1077:b004:l030","ordinal":159370,"en":"Closed in behind him."},{"id":"semetey-1-2013:p1077:b004:l031","ordinal":159371,"en":"The giant black bird, the Simurgh,"},{"id":"semetey-1-2013:p1077:b004:l032","ordinal":159372,"en":"As though about to carry him away,"},{"id":"semetey-1-2013:p1077:b004:l033","ordinal":159373,"en":"Reached its feet down from the sky,"},{"id":"semetey-1-2013:p1077:b004:l034","ordinal":159374,"en":"And it too stood supporting him;"},{"id":"semetey-1-2013:p1077:b004:l035","ordinal":159375,"en":"Roaring, it stretched out its feet,"},{"id":"semetey-1-2013:p1077:b004:l036","ordinal":159376,"en":"And it too stood supporting him."},{"id":"semetey-1-2013:p1077:b004:l037","ordinal":159377,"en":"Seeing his protectors revealed,"},{"id":"semetey-1-2013:p1077:b004:l038","ordinal":159378,"en":"Dear Semeң rejoiced"},{"id":"semetey-1-2013:p1077:b004:l039","ordinal":159379,"en":"And stood stretching tall:"},{"id":"semetey-1-2013:p1078:b003:l001","ordinal":159380,"en":"\"Chynkozho and Toltoy are no heroes;"},{"id":"semetey-1-2013:p1078:b003:l002","ordinal":159381,"en":"This boy could slaughter the Chinese."},{"id":"semetey-1-2013:p1078:b003:l003","ordinal":159382,"en":"In this form, Külchoro"},{"id":"semetey-1-2013:p1078:b003:l004","ordinal":159383,"en":"Could take not only the Zhediger"},{"id":"semetey-1-2013:p1078:b003:l005","ordinal":159384,"en":"But all of Zhet-Kayt,"},{"id":"semetey-1-2013:p1078:b003:l006","ordinal":159385,"en":"And stir the whole age into turmoil.\""},{"id":"semetey-1-2013:p1078:b003:l007","ordinal":159386,"en":"Rejoicing at what he saw:"},{"id":"semetey-1-2013:p1078:b003:l008","ordinal":159387,"en":"\"I may devote myself to Allah;"},{"id":"semetey-1-2013:p1078:b003:l009","ordinal":159388,"en":"I may sacrifice myself for the boy."},{"id":"semetey-1-2013:p1078:b003:l010","ordinal":159389,"en":"God will grant my prayer;"},{"id":"semetey-1-2013:p1078:b003:l011","ordinal":159390,"en":"Somehow the boy will return.\""},{"id":"semetey-1-2013:p1078:b003:l012","ordinal":159391,"en":"Turning back toward the maidens,"},{"id":"semetey-1-2013:p1078:b003:l013","ordinal":159392,"en":"Semetey entered the clamor;"},{"id":"semetey-1-2013:p1078:b003:l014","ordinal":159393,"en":"Semetey entered festivities"},{"id":"semetey-1-2013:p1078:b003:l015","ordinal":159394,"en":"That could not be subdued."},{"id":"semetey-1-2013:p1078:b003:l016","ordinal":159395,"en":"Here Semetey's guest"},{"id":"semetey-1-2013:p1078:b003:l017","ordinal":159396,"en":"Remained in delight;"},{"id":"semetey-1-2013:p1078:b003:l018","ordinal":159397,"en":"Now let us tell"},{"id":"semetey-1-2013:p1078:b003:l019","ordinal":159398,"en":"The tale of Külchoro."},{"id":"semetey-1-2013:p1078:b003:l020","ordinal":159399,"en":"Bold young Külchoro,"},{"id":"semetey-1-2013:p1078:b003:l021","ordinal":159400,"en":"A distinguished youth who knew all things,"},{"id":"semetey-1-2013:p1078:b003:l022","ordinal":159401,"en":"Had a stature apart from other boys."},{"id":"semetey-1-2013:p1078:b003:l023","ordinal":159402,"en":"If he wished, there could be much lament;"},{"id":"semetey-1-2013:p1078:b003:l024","ordinal":159403,"en":"Watch the spectacle:"},{"id":"semetey-1-2013:p1078:b003:l025","ordinal":159404,"en":"He would bring great conflict upon Toltoy."},{"id":"semetey-1-2013:p1078:b003:l026","ordinal":159405,"en":"The bridle fastened to his horse,"},{"id":"semetey-1-2013:p1078:b003:l027","ordinal":159406,"en":"He was Almambet's six-month"},{"id":"semetey-1-2013:p1078:b003:l028","ordinal":159407,"en":"Unborn legacy."},{"id":"semetey-1-2013:p1078:b003:l029","ordinal":159408,"en":"Not merely Toltoy—the boy's turmoil"},{"id":"semetey-1-2013:p1078:b003:l030","ordinal":159409,"en":"Would reach across the world."},{"id":"semetey-1-2013:p1078:b003:l031","ordinal":159410,"en":"Have you heard the report?"},{"id":"semetey-1-2013:p1078:b003:l032","ordinal":159411,"en":"He was the descendant of one"},{"id":"semetey-1-2013:p1078:b003:l033","ordinal":159412,"en":"Who made enemies of the Black Kalmyks and Manchus,"},{"id":"semetey-1-2013:p1078:b003:l034","ordinal":159413,"en":"Who crushed the foe he grappled with"},{"id":"semetey-1-2013:p1078:b003:l035","ordinal":159414,"en":"And brought them low;"},{"id":"semetey-1-2013:p1078:b003:l036","ordinal":159415,"en":"The descendant of one who began"},{"id":"semetey-1-2013:p1078:b003:l037","ordinal":159416,"en":"The great tumult against the Kakan;"},{"id":"semetey-1-2013:p1078:b003:l038","ordinal":159417,"en":"The descendant of one who killed"},{"id":"semetey-1-2013:p1078:b003:l039","ordinal":159418,"en":"And abandoned his own father;"},{"id":"semetey-1-2013:p1078:b004:l001","ordinal":159419,"en":"The descendant of the hero"},{"id":"semetey-1-2013:p1078:b004:l002","ordinal":159420,"en":"Who scattered Beijing's wealth;"},{"id":"semetey-1-2013:p1078:b004:l003","ordinal":159421,"en":"The descendant of the hero who, angered"},{"id":"semetey-1-2013:p1078:b004:l004","ordinal":159422,"en":"By his position as khan,"},{"id":"semetey-1-2013:p1078:b004:l005","ordinal":159423,"en":"Fled the Kakan's Beijing."},{"id":"semetey-1-2013:p1078:b004:l006","ordinal":159424,"en":"As though he had seen many trials,"},{"id":"semetey-1-2013:p1078:b004:l007","ordinal":159425,"en":"Almambet had given Choro"},{"id":"semetey-1-2013:p1078:b004:l008","ordinal":159426,"en":"Courage and lion-heartedness"},{"id":"semetey-1-2013:p1078:b004:l009","ordinal":159427,"en":"Without measure."},{"id":"semetey-1-2013:p1078:b004:l010","ordinal":159428,"en":"Looking around him,"},{"id":"semetey-1-2013:p1078:b004:l011","ordinal":159429,"en":"Licking his lips and nose,"},{"id":"semetey-1-2013:p1078:b004:l012","ordinal":159430,"en":"Scanning both sides,"},{"id":"semetey-1-2013:p1078:b004:l013","ordinal":159431,"en":"Crouching like a lion,"},{"id":"semetey-1-2013:p1078:b004:l014","ordinal":159432,"en":"Straining like a blue tiger,"},{"id":"semetey-1-2013:p1078:b004:l015","ordinal":159433,"en":"Couching his spear for battle,"},{"id":"semetey-1-2013:p1078:b004:l016","ordinal":159434,"en":"Külchoro raged"},{"id":"semetey-1-2013:p1078:b004:l017","ordinal":159435,"en":"And twisted this way and that."},{"id":"semetey-1-2013:p1078:b004:l018","ordinal":159436,"en":"He crossed rough, uneven ground,"},{"id":"semetey-1-2013:p1078:b004:l019","ordinal":159437,"en":"And traversed hummocked sand;"},{"id":"semetey-1-2013:p1078:b004:l020","ordinal":159438,"en":"Unable to feel the earth's hardship,"},{"id":"semetey-1-2013:p1078:b004:l021","ordinal":159439,"en":"Day passed and night came,"},{"id":"semetey-1-2013:p1078:b004:l022","ordinal":159440,"en":"Darkness settled as brows turned black."},{"id":"semetey-1-2013:p1078:b004:l023","ordinal":159441,"en":"His eyes bound by night travel,"},{"id":"semetey-1-2013:p1078:b004:l024","ordinal":159442,"en":"He crossed winding ravines,"},{"id":"semetey-1-2013:p1078:b004:l025","ordinal":159443,"en":"And passed twisting mountains."},{"id":"semetey-1-2013:p1078:b004:l026","ordinal":159444,"en":"Seeing a broad black river,"},{"id":"semetey-1-2013:p1078:b004:l027","ordinal":159445,"en":"He traveled without turning aside,"},{"id":"semetey-1-2013:p1078:b004:l028","ordinal":159446,"en":"Covering much ground without sparing his horse."},{"id":"semetey-1-2013:p1078:b004:l029","ordinal":159447,"en":"Now he drew near"},{"id":"semetey-1-2013:p1078:b004:l030","ordinal":159448,"en":"The junction of nine roads,"},{"id":"semetey-1-2013:p1078:b004:l031","ordinal":159449,"en":"At the boundary of Börü-Koy:"},{"id":"semetey-1-2013:p1078:b004:l032","ordinal":159450,"en":"One road came into Afghanistan,"},{"id":"semetey-1-2013:p1078:b004:l033","ordinal":159451,"en":"A black road went to Kashgar;"},{"id":"semetey-1-2013:p1078:b004:l034","ordinal":159452,"en":"One road came into Afghanistan,"},{"id":"semetey-1-2013:p1078:b004:l035","ordinal":159453,"en":"A straight road went to Turpan;"},{"id":"semetey-1-2013:p1078:b004:l036","ordinal":159454,"en":"One road came into Afghanistan,"},{"id":"semetey-1-2013:p1078:b004:l037","ordinal":159455,"en":"A marked road went to Beijing;"},{"id":"semetey-1-2013:p1078:b004:l038","ordinal":159456,"en":"One road came into Afghanistan—"},{"id":"semetey-1-2013:p1079:b003:l001","ordinal":159457,"en":"A perilous road went to Kokon;"},{"id":"semetey-1-2013:p1079:b003:l002","ordinal":159458,"en":"One road came into Afghanistan,"},{"id":"semetey-1-2013:p1079:b003:l003","ordinal":159459,"en":"The safe road of Andijan."},{"id":"semetey-1-2013:p1079:b003:l004","ordinal":159460,"en":"He circled and surveyed them all;"},{"id":"semetey-1-2013:p1079:b003:l005","ordinal":159461,"en":"The orphan boy Külchoro"},{"id":"semetey-1-2013:p1079:b003:l006","ordinal":159462,"en":"Now marveled at the land."},{"id":"semetey-1-2013:p1079:b003:l007","ordinal":159463,"en":"As Külchoro looked carefully,"},{"id":"semetey-1-2013:p1079:b003:l008","ordinal":159464,"en":"There was the crest of a rise;"},{"id":"semetey-1-2013:p1079:b003:l009","ordinal":159465,"en":"When he rode up and looked,"},{"id":"semetey-1-2013:p1079:b003:l010","ordinal":159466,"en":"There stood Manas's cairn."},{"id":"semetey-1-2013:p1079:b003:l011","ordinal":159467,"en":"Upon the cairn stone"},{"id":"semetey-1-2013:p1079:b003:l012","ordinal":159468,"en":"Was Almambet's inscription."},{"id":"semetey-1-2013:p1079:b003:l013","ordinal":159469,"en":"Yesterday, when they were bringing disgrace"},{"id":"semetey-1-2013:p1079:b003:l014","ordinal":159470,"en":"Upon the kozho in Kokon,"},{"id":"semetey-1-2013:p1079:b003:l015","ordinal":159471,"en":"When they were imposing violent turmoil"},{"id":"semetey-1-2013:p1079:b003:l016","ordinal":159472,"en":"Across the face of the earth,"},{"id":"semetey-1-2013:p1079:b003:l017","ordinal":159473,"en":"When mighty leopard Manas"},{"id":"semetey-1-2013:p1079:b003:l018","ordinal":159474,"en":"Struck the Kyzylbash people"},{"id":"semetey-1-2013:p1079:b003:l019","ordinal":159475,"en":"And returned them facing home,"},{"id":"semetey-1-2013:p1079:b003:l020","ordinal":159476,"en":"That was when heroic leopard Manas"},{"id":"semetey-1-2013:p1079:b003:l021","ordinal":159477,"en":"Had gone down there;"},{"id":"semetey-1-2013:p1079:b003:l022","ordinal":159478,"en":"It was the place where Almambet,"},{"id":"semetey-1-2013:p1079:b003:l023","ordinal":159479,"en":"Chubak, and brave Manas had lain."},{"id":"semetey-1-2013:p1079:b003:l024","ordinal":159480,"en":"\"This is the black stone's inscription;"},{"id":"semetey-1-2013:p1079:b003:l025","ordinal":159481,"en":"This is the name of Khan Almambet."},{"id":"semetey-1-2013:p1079:b003:l026","ordinal":159482,"en":"This is a pass left by the forefathers,"},{"id":"semetey-1-2013:p1079:b003:l027","ordinal":159483,"en":"A place where heroes lay."},{"id":"semetey-1-2013:p1079:b003:l028","ordinal":159484,"en":"It is a pass brave Toltoy"},{"id":"semetey-1-2013:p1079:b003:l029","ordinal":159485,"en":"Will cross without noticing."},{"id":"semetey-1-2013:p1079:b003:l030","ordinal":159486,"en":"Over there is Batkalysh Hill, Besh-Belchir;"},{"id":"semetey-1-2013:p1079:b003:l031","ordinal":159487,"en":"Sovereign God, bring it face to face"},{"id":"semetey-1-2013:p1079:b003:l032","ordinal":159488,"en":"With boastful Toltoy."}]
