[{"id":"manas-2010:p1580:b001:l021","ordinal":68097,"en":"Down upon the Chinese!"},{"id":"manas-2010:p1580:b001:l022","ordinal":68098,"en":"If we flee without fighting,"},{"id":"manas-2010:p1580:b001:l023","ordinal":68099,"en":"Will the Chinese not come sweeping after us?"},{"id":"manas-2010:p1580:b001:l024","ordinal":68100,"en":"Saying, ‘Manas has fled,’"},{"id":"manas-2010:p1580:b001:l025","ordinal":68101,"en":"Pursuing the Burut,"},{"id":"manas-2010:p1580:b001:l026","ordinal":68102,"en":"Will the Manchus not destroy them utterly?”"},{"id":"manas-2010:p1580:b001:l027","ordinal":68103,"en":"He spoke his words to the heroes."},{"id":"manas-2010:p1580:b001:l028","ordinal":68104,"en":"The three champions standing before him"},{"id":"manas-2010:p1580:b001:l029","ordinal":68105,"en":"Ate and rested,"},{"id":"manas-2010:p1580:b001:l030","ordinal":68106,"en":"Washed and performed their ablutions,"},{"id":"manas-2010:p1580:b001:l031","ordinal":68107,"en":"Bathed in clean water,"},{"id":"manas-2010:p1580:b001:l032","ordinal":68108,"en":"Put on clean clothes,"},{"id":"manas-2010:p1580:b001:l033","ordinal":68109,"en":"Laid their heads toward the direction of prayer,"},{"id":"manas-2010:p1580:b001:l034","ordinal":68110,"en":"Pillowed them on their white-framed saddles,"},{"id":"manas-2010:p1580:b001:l035","ordinal":68111,"en":"And entered sleep then."},{"id":"manas-2010:p1580:b001:l036","ordinal":68112,"en":"Dawn broke clear;"},{"id":"manas-2010:p1580:b001:l037","ordinal":68113,"en":"Light fell on the earth."},{"id":"manas-2010:p1580:b001:l038","ordinal":68114,"en":"Stars parted from the heavens,"},{"id":"manas-2010:p1580:b001:l039","ordinal":68115,"en":"Spilling toward the west;"},{"id":"manas-2010:p1580:b001:l040","ordinal":68116,"en":"Dawn faintly opened."},{"id":"manas-2010:p1580:b001:l041","ordinal":68117,"en":"When the light grew clear,"},{"id":"manas-2010:p1580:b001:l042","ordinal":68118,"en":"Making ready for their ablutions,"},{"id":"manas-2010:p1581:b001:l001","ordinal":68119,"en":"They dipped their hands in the water,"},{"id":"manas-2010:p1581:b001:l002","ordinal":68120,"en":"Washed their hands for prayer,"},{"id":"manas-2010:p1581:b001:l003","ordinal":68121,"en":"Dipped their feet in the water,"},{"id":"manas-2010:p1581:b001:l004","ordinal":68122,"en":"Washed their feet for prayer,"},{"id":"manas-2010:p1581:b001:l005","ordinal":68123,"en":"And loudly called the call to prayer."},{"id":"manas-2010:p1581:b001:l006","ordinal":68124,"en":"The heroes began their prayers."},{"id":"manas-2010:p1581:b001:l007","ordinal":68125,"en":"Two customary, two obligatory—"},{"id":"manas-2010:p1581:b001:l008","ordinal":68126,"en":"The four cycles of the dawn prayer"},{"id":"manas-2010:p1581:b001:l009","ordinal":68127,"en":"They duly recited."},{"id":"manas-2010:p1581:b001:l010","ordinal":68128,"en":"They ate their food,"},{"id":"manas-2010:p1581:b001:l011","ordinal":68129,"en":"Made ready each at his horse,"},{"id":"manas-2010:p1581:b001:l012","ordinal":68130,"en":"Pulled the rear girths tight,"},{"id":"manas-2010:p1581:b001:l013","ordinal":68131,"en":"Shortened their cruppers,"},{"id":"manas-2010:p1581:b001:l014","ordinal":68132,"en":"Adorned their lances,"},{"id":"manas-2010:p1581:b001:l015","ordinal":68133,"en":"Girded on their battle-axes,"},{"id":"manas-2010:p1581:b001:l016","ordinal":68134,"en":"And turned toward the Chinese."},{"id":"manas-2010:p1581:b001:l017","ordinal":68135,"en":"The whole host could hardly hold still;"},{"id":"manas-2010:p1581:b001:l018","ordinal":68136,"en":"With Khan Manas at its head,"},{"id":"manas-2010:p1581:b001:l019","ordinal":68137,"en":"It stood watching, prepared."},{"id":"manas-2010:p1581:b001:l020","ordinal":68138,"en":"They stood facing the enemy, eyes fixed,"},{"id":"manas-2010:p1581:b001:l021","ordinal":68139,"en":"All the Burut gathered together."},{"id":"manas-2010:p1581:b001:l022","ordinal":68140,"en":"As they watched, the many Chinese"},{"id":"manas-2010:p1581:b001:l023","ordinal":68141,"en":"All came sweeping on,"},{"id":"manas-2010:p1581:b001:l024","ordinal":68142,"en":"Rolling forward from their furthest depths."},{"id":"manas-2010:p1581:b001:l025","ordinal":68143,"en":"The face of the earth could not be seen;"},{"id":"manas-2010:p1581:b001:l026","ordinal":68144,"en":"The sky darkened with dust."},{"id":"manas-2010:p1581:b001:l027","ordinal":68145,"en":"They marveled at their numbers."},{"id":"manas-2010:p1581:b001:l028","ordinal":68146,"en":"Shouting, they charged in—"},{"id":"manas-2010:p1581:b001:l029","ordinal":68147,"en":"Kökchö and Muzburchak."},{"id":"manas-2010:p1581:b001:l030","ordinal":68148,"en":"Holding his lance steady,"},{"id":"manas-2010:p1581:b001:l031","ordinal":68149,"en":"Brave Chubak entered with them."},{"id":"manas-2010:p1581:b001:l032","ordinal":68150,"en":"All forty companions entered;"},{"id":"manas-2010:p1581:b001:l033","ordinal":68151,"en":"Riding out in front were"},{"id":"manas-2010:p1581:b001:l034","ordinal":68152,"en":"Almambet and brave Syrgak."},{"id":"manas-2010:p1581:b001:l035","ordinal":68153,"en":"All the Muslims except Manas"},{"id":"manas-2010:p1581:b001:l036","ordinal":68154,"en":"Entered shouting,"},{"id":"manas-2010:p1581:b001:l037","ordinal":68155,"en":"Calling the battle cry, “Manas!”"},{"id":"manas-2010:p1581:b001:l038","ordinal":68156,"en":"Without looking up or down,"},{"id":"manas-2010:p1581:b001:l039","ordinal":68157,"en":"All the Muslims entered,"},{"id":"manas-2010:p1581:b001:l040","ordinal":68158,"en":"Without thinking, “I shall die.”"},{"id":"manas-2010:p1581:b001:l041","ordinal":68159,"en":"Imposing Kongurbay,"},{"id":"manas-2010:p1581:b001:l042","ordinal":68160,"en":"From among the Chinese officials with rank beads,"},{"id":"manas-2010:p1582:b001:l001","ordinal":68161,"en":"He separated out the best;"},{"id":"manas-2010:p1582:b001:l002","ordinal":68162,"en":"Of the Chinese in crimson jackets,"},{"id":"manas-2010:p1582:b001:l003","ordinal":68163,"en":"He separated out the strongest"},{"id":"manas-2010:p1582:b001:l004","ordinal":68164,"en":"And took his place before them."},{"id":"manas-2010:p1582:b001:l005","ordinal":68165,"en":"Driving the Chinese from behind,"},{"id":"manas-2010:p1582:b001:l006","ordinal":68166,"en":"Not leaving one to lag,"},{"id":"manas-2010:p1582:b001:l007","ordinal":68167,"en":"Ay Jangjung moved along."},{"id":"manas-2010:p1582:b001:l008","ordinal":68168,"en":"On one side, upon his great brown horse,"},{"id":"manas-2010:p1582:b001:l009","ordinal":68169,"en":"Having separated out the Manchus,"},{"id":"manas-2010:p1582:b001:l010","ordinal":68170,"en":"Ezkara came shouting."},{"id":"manas-2010:p1582:b001:l011","ordinal":68171,"en":"With a single eye in their foreheads,"},{"id":"manas-2010:p1582:b001:l012","ordinal":68172,"en":"Knowing nothing of death,"},{"id":"manas-2010:p1582:b001:l013","ordinal":68173,"en":"From the Chinese called One-Eyed,"},{"id":"manas-2010:p1582:b001:l014","ordinal":68174,"en":"A mighty host had arrived."},{"id":"manas-2010:p1582:b001:l015","ordinal":68175,"en":"What appeared dimly in the distance,"},{"id":"manas-2010:p1582:b001:l016","ordinal":68176,"en":"Separate behind them,"},{"id":"manas-2010:p1582:b001:l017","ordinal":68177,"en":"Was no haze: it was people."},{"id":"manas-2010:p1582:b001:l018","ordinal":68178,"en":"Looking at their numbers,"},{"id":"manas-2010:p1582:b001:l019","ordinal":68179,"en":"They were no people, but a rushing flood."},{"id":"manas-2010:p1582:b001:l020","ordinal":68180,"en":"The mass of Chinese"},{"id":"manas-2010:p1582:b001:l021","ordinal":68181,"en":"Was a river, a sea, a lake."},{"id":"manas-2010:p1582:b001:l022","ordinal":68182,"en":"When the Burut swarmed forward,"},{"id":"manas-2010:p1582:b001:l023","ordinal":68183,"en":"Seeing this, Kongurbay,"},{"id":"manas-2010:p1582:b001:l024","ordinal":68184,"en":"With Ay Jangjung behind him—"},{"id":"manas-2010:p1582:b001:l025","ordinal":68185,"en":"The two lions joined stirrups"},{"id":"manas-2010:p1582:b001:l026","ordinal":68186,"en":"And rode apart for single combat."},{"id":"manas-2010:p1582:b001:l027","ordinal":68187,"en":"Seeing this, Almambet"},{"id":"manas-2010:p1582:b001:l028","ordinal":68188,"en":"And renowned eagle, brave Syrgak,"},{"id":"manas-2010:p1582:b001:l029","ordinal":68189,"en":"Stared steadily at them."},{"id":"manas-2010:p1582:b001:l030","ordinal":68190,"en":"Where no plow had scored a furrow,"},{"id":"manas-2010:p1582:b001:l031","ordinal":68191,"en":"Where no marmot had dug a burrow,"},{"id":"manas-2010:p1582:b001:l032","ordinal":68192,"en":"On the yellow plain smooth as a blade,"},{"id":"manas-2010:p1582:b001:l033","ordinal":68193,"en":"They went rushing on."},{"id":"manas-2010:p1582:b001:l034","ordinal":68194,"en":"Clods from his horse’s hooves shrilled in the sky;"},{"id":"manas-2010:p1582:b001:l035","ordinal":68195,"en":"Kongurbay came rushing,"},{"id":"manas-2010:p1582:b001:l036","ordinal":68196,"en":"Heading straight toward Syrgak."},{"id":"manas-2010:p1582:b001:l037","ordinal":68197,"en":"Ay Jangjung came shouting,"},{"id":"manas-2010:p1582:b001:l038","ordinal":68198,"en":"Heading straight toward Almambet."},{"id":"manas-2010:p1582:b001:l039","ordinal":68199,"en":"With golden forelock and tasseled sash,"},{"id":"manas-2010:p1582:b001:l040","ordinal":68200,"en":"Azizkan’s only son,"},{"id":"manas-2010:p1582:b001:l041","ordinal":68201,"en":"Without sparing his flylike life,"},{"id":"manas-2010:p1582:b001:l042","ordinal":68202,"en":"Without thinking, “I shall die”—"},{"id":"manas-2010:p1583:b001:l001","ordinal":68203,"en":"But the Chinese Ay Jangjung"},{"id":"manas-2010:p1583:b001:l002","ordinal":68204,"en":"Was a hero born adept."},{"id":"manas-2010:p1583:b001:l003","ordinal":68205,"en":"Giving the only son no time to prepare,"},{"id":"manas-2010:p1583:b001:l004","ordinal":68206,"en":"He charged and thrust his lance."},{"id":"manas-2010:p1583:b001:l005","ordinal":68207,"en":"“The edge of his jacket,” Almambet thought,"},{"id":"manas-2010:p1583:b001:l006","ordinal":68208,"en":"“At the face of his golden belt!”"},{"id":"manas-2010:p1583:b001:l007","ordinal":68209,"en":"That rumbling Chinese warrior—"},{"id":"manas-2010:p1583:b001:l008","ordinal":68210,"en":"Outstripping Ay Jangjung,"},{"id":"manas-2010:p1583:b001:l009","ordinal":68211,"en":"Almambet thrust and swept past."},{"id":"manas-2010:p1583:b001:l010","ordinal":68212,"en":"Both lances struck together,"},{"id":"manas-2010:p1583:b001:l011","ordinal":68213,"en":"Shattering into fragments."},{"id":"manas-2010:p1583:b001:l012","ordinal":68214,"en":"Their splinters shrilled in the sky;"},{"id":"manas-2010:p1583:b001:l013","ordinal":68215,"en":"Clumps of white fiber, horse-head-sized,"},{"id":"manas-2010:p1583:b001:l014","ordinal":68216,"en":"Scattered here and there."},{"id":"manas-2010:p1583:b001:l015","ordinal":68217,"en":"The massed Chinese, the many Manchus,"},{"id":"manas-2010:p1583:b001:l016","ordinal":68218,"en":"With Ezkara at their head,"},{"id":"manas-2010:p1583:b001:l017","ordinal":68219,"en":"Swarmed forward screaming."},{"id":"manas-2010:p1583:b001:l018","ordinal":68220,"en":"When Syrgak drew near,"},{"id":"manas-2010:p1583:b001:l019","ordinal":68221,"en":"Slipping aside with Algara,"},{"id":"manas-2010:p1583:b001:l020","ordinal":68222,"en":"The skilled Kongurbay"},{"id":"manas-2010:p1583:b001:l021","ordinal":68223,"en":"Suddenly changed his course,"},{"id":"manas-2010:p1583:b001:l022","ordinal":68224,"en":"Wheeled toward the countless troops,"},{"id":"manas-2010:p1583:b001:l023","ordinal":68225,"en":"And entered without being struck."},{"id":"manas-2010:p1583:b001:l024","ordinal":68226,"en":"When Syrgak pursued him in,"},{"id":"manas-2010:p1583:b001:l025","ordinal":68227,"en":"Directly before him the one-eyed men,"},{"id":"manas-2010:p1583:b001:l026","ordinal":68228,"en":"Every one of them a giant,"},{"id":"manas-2010:p1583:b001:l027","ordinal":68229,"en":"Foot soldiers skilled in war,"},{"id":"manas-2010:p1583:b001:l028","ordinal":68230,"en":"Swarmed out to bar his way."},{"id":"manas-2010:p1583:b001:l029","ordinal":68231,"en":"Left alone in their midst,"},{"id":"manas-2010:p1583:b001:l030","ordinal":68232,"en":"He struggled for his life,"},{"id":"manas-2010:p1583:b001:l031","ordinal":68233,"en":"Ulak Khan’s Syrgak."},{"id":"manas-2010:p1583:b001:l032","ordinal":68234,"en":"Making their center boil up,"},{"id":"manas-2010:p1583:b001:l033","ordinal":68235,"en":"Brave Syrgak drove them;"},{"id":"manas-2010:p1583:b001:l034","ordinal":68236,"en":"Scattering those around him,"},{"id":"manas-2010:p1583:b001:l035","ordinal":68237,"en":"Brave Syrgak pressed them back."},{"id":"manas-2010:p1583:b001:l036","ordinal":68238,"en":"Sweeping away everyone he met,"},{"id":"manas-2010:p1583:b001:l037","ordinal":68239,"en":"Brave Syrgak slaughtered them."},{"id":"manas-2010:p1583:b001:l038","ordinal":68240,"en":"Like a falcon striking jackdaws,"},{"id":"manas-2010:p1583:b001:l039","ordinal":68241,"en":"Whatever he pleased to the Chinese,"},{"id":"manas-2010:p1583:b001:l040","ordinal":68242,"en":"Brave Syrgak did."},{"id":"manas-2010:p1583:b001:l041","ordinal":68243,"en":"As though it were play instead of war,"},{"id":"manas-2010:p1583:b001:l042","ordinal":68244,"en":"Brave Syrgak laughed!"},{"id":"manas-2010:p1584:b001:l001","ordinal":68245,"en":"Unable to bear it, Kongurbay"},{"id":"manas-2010:p1584:b001:l002","ordinal":68246,"en":"Called the Manchus and Chinese,"},{"id":"manas-2010:p1584:b001:l003","ordinal":68247,"en":"Shouted at the top of his voice,"},{"id":"manas-2010:p1584:b001:l004","ordinal":68248,"en":"And told the mighty host:"},{"id":"manas-2010:p1584:b001:l005","ordinal":68249,"en":"“All of you swarm together!"},{"id":"manas-2010:p1584:b001:l006","ordinal":68250,"en":"Seize him by the very hem!"},{"id":"manas-2010:p1584:b001:l007","ordinal":68251,"en":"Set upon him in earnest!”"},{"id":"manas-2010:p1584:b001:l008","ordinal":68252,"en":"When they heard Kalcha’s words,"},{"id":"manas-2010:p1584:b001:l009","ordinal":68253,"en":"All the Chinese swarmed together,"},{"id":"manas-2010:p1584:b001:l010","ordinal":68254,"en":"Feverishly making ready."},{"id":"manas-2010:p1584:b001:l011","ordinal":68255,"en":"The one-eyed men with battle-axes"},{"id":"manas-2010:p1584:b001:l012","ordinal":68256,"en":"Also swarmed into the fray."},{"id":"manas-2010:p1584:b001:l013","ordinal":68257,"en":"Those skilled at striking with swords"},{"id":"manas-2010:p1584:b001:l014","ordinal":68258,"en":"Made ready and entered from the sides."},{"id":"manas-2010:p1584:b001:l015","ordinal":68259,"en":"As he stood alone in their midst,"},{"id":"manas-2010:p1584:b001:l016","ordinal":68260,"en":"Syrgak once again,"},{"id":"manas-2010:p1584:b001:l017","ordinal":68261,"en":"Seeing this from afar,"},{"id":"manas-2010:p1584:b001:l018","ordinal":68262,"en":"Akbaltay’s Chubak,"},{"id":"manas-2010:p1584:b001:l019","ordinal":68263,"en":"Argynkan’s Azhybay,"},{"id":"manas-2010:p1584:b001:l020","ordinal":68264,"en":"Shuutu the slave, his hat like a yurt roof-felt,"},{"id":"manas-2010:p1584:b001:l021","ordinal":68265,"en":"Yraman’s Yrchy Uul,"},{"id":"manas-2010:p1584:b001:l022","ordinal":68266,"en":"Old Kyrgyl, leader of the forty,"},{"id":"manas-2010:p1584:b001:l023","ordinal":68267,"en":"Boz Uul and Baychoro—"},{"id":"manas-2010:p1584:b001:l024","ordinal":68268,"en":"All forty companions swarmed forward."},{"id":"manas-2010:p1584:b001:l025","ordinal":68269,"en":"“Against the pouring host of one-eyed men,"},{"id":"manas-2010:p1584:b001:l026","ordinal":68270,"en":"I shall fight in earnest;"},{"id":"manas-2010:p1584:b001:l027","ordinal":68271,"en":"Syrgak, left alone,"},{"id":"manas-2010:p1584:b001:l028","ordinal":68272,"en":"I shall rescue!” they said."},{"id":"manas-2010:p1584:b001:l029","ordinal":68273,"en":"The forty companions charged in."},{"id":"manas-2010:p1584:b001:l030","ordinal":68274,"en":"Chubak reached the Chinese"},{"id":"manas-2010:p1584:b001:l031","ordinal":68275,"en":"And threw them into uproar."},{"id":"manas-2010:p1584:b001:l032","ordinal":68276,"en":"All forty companions"},{"id":"manas-2010:p1584:b001:l033","ordinal":68277,"en":"With the countless Chinese and Manchu troops"},{"id":"manas-2010:p1584:b001:l034","ordinal":68278,"en":"Became locked in the fray."},{"id":"manas-2010:p1584:b001:l035","ordinal":68279,"en":"Drenched in red blood,"},{"id":"manas-2010:p1584:b001:l036","ordinal":68280,"en":"Fighting without turning away,"},{"id":"manas-2010:p1584:b001:l037","ordinal":68281,"en":"Their heroes grew weary."},{"id":"manas-2010:p1584:b001:l038","ordinal":68282,"en":"The strong and the valiant,"},{"id":"manas-2010:p1584:b001:l039","ordinal":68283,"en":"Neither drawing back nor flinching,"},{"id":"manas-2010:p1584:b001:l040","ordinal":68284,"en":"Stabbed one another straight in the heart."},{"id":"manas-2010:p1584:b001:l041","ordinal":68285,"en":"Many a steed was left riderless;"},{"id":"manas-2010:p1584:b001:l042","ordinal":68286,"en":"Many heroes lay there,"},{"id":"manas-2010:p1585:b001:l001","ordinal":68287,"en":"Bodies gone, heads left behind."},{"id":"manas-2010:p1585:b001:l002","ordinal":68288,"en":"No one could tell it was day;"},{"id":"manas-2010:p1585:b001:l003","ordinal":68289,"en":"No one could tell it was night."},{"id":"manas-2010:p1585:b001:l004","ordinal":68290,"en":"A black fog of dust had fallen;"},{"id":"manas-2010:p1585:b001:l005","ordinal":68291,"en":"The eagles went on fighting."},{"id":"manas-2010:p1585:b001:l006","ordinal":68292,"en":"Without sparing their threadlike lives,"},{"id":"manas-2010:p1585:b001:l007","ordinal":68293,"en":"Without regard for those who died,"},{"id":"manas-2010:p1585:b001:l008","ordinal":68294,"en":"Wading knee-deep in blood,"},{"id":"manas-2010:p1585:b001:l009","ordinal":68295,"en":"As they pressed against one another,"},{"id":"manas-2010:p1585:b001:l010","ordinal":68296,"en":"As the Burut wreaked slaughter,"},{"id":"manas-2010:p1585:b001:l011","ordinal":68297,"en":"Fighting intermingled,"},{"id":"manas-2010:p1585:b001:l012","ordinal":68298,"en":"As they battered one another,"},{"id":"manas-2010:p1585:b001:l013","ordinal":68299,"en":"Seeing them from afar,"},{"id":"manas-2010:p1585:b001:l014","ordinal":68300,"en":"Kökchö and Muzburchak,"},{"id":"manas-2010:p1585:b001:l015","ordinal":68301,"en":"At the teeming Chinese,"},{"id":"manas-2010:p1585:b001:l016","ordinal":68302,"en":"To thrust their lances without turning away,"},{"id":"manas-2010:p1585:b001:l017","ordinal":68303,"en":"Taking the companions as their support,"},{"id":"manas-2010:p1585:b001:l018","ordinal":68304,"en":"To drive the Chinese back"},{"id":"manas-2010:p1585:b001:l019","ordinal":68305,"en":"And reach Beijing,"},{"id":"manas-2010:p1585:b001:l020","ordinal":68306,"en":"With a host of countless troops"},{"id":"manas-2010:p1585:b001:l021","ordinal":68307,"en":"Swept into the battle."},{"id":"manas-2010:p1585:b001:l022","ordinal":68308,"en":"Muzburchak on Telkyzyl,"},{"id":"manas-2010:p1585:b001:l023","ordinal":68309,"en":"Brave Kökchö on Kögala,"},{"id":"manas-2010:p1585:b001:l024","ordinal":68310,"en":"Taking the lead of the great host,"},{"id":"manas-2010:p1585:b001:l025","ordinal":68311,"en":"Came making their steeds roar."},{"id":"manas-2010:p1585:b001:l026","ordinal":68312,"en":"Seeing them from afar,"},{"id":"manas-2010:p1585:b001:l027","ordinal":68313,"en":"Kongurbay and Ezkara"},{"id":"manas-2010:p1585:b001:l028","ordinal":68314,"en":"Now took counsel:"},{"id":"manas-2010:p1585:b001:l029","ordinal":68315,"en":"“Even if their mighty host numbers thousands,"},{"id":"manas-2010:p1585:b001:l030","ordinal":68316,"en":"We shall prowl like lions."},{"id":"manas-2010:p1585:b001:l031","ordinal":68317,"en":"Almambet, Chubak, brave Syrgak—"},{"id":"manas-2010:p1585:b001:l032","ordinal":68318,"en":"If it were not for those three,"},{"id":"manas-2010:p1585:b001:l033","ordinal":68319,"en":"The remaining mass of Burut"},{"id":"manas-2010:p1585:b001:l034","ordinal":68320,"en":"We would not leave alive an eye-blink!"},{"id":"manas-2010:p1585:b001:l035","ordinal":68321,"en":"Muzburchak and Kökchö,"},{"id":"manas-2010:p1585:b001:l036","ordinal":68322,"en":"Before those three mighty ones just named"},{"id":"manas-2010:p1585:b001:l037","ordinal":68323,"en":"Can rescue them,"},{"id":"manas-2010:p1585:b001:l038","ordinal":68324,"en":"Let us reach and bind them;"},{"id":"manas-2010:p1585:b001:l039","ordinal":68325,"en":"Let us bring torment upon their heads!”"},{"id":"manas-2010:p1585:b001:l040","ordinal":68326,"en":"Spurring Algara on,"},{"id":"manas-2010:p1585:b001:l041","ordinal":68327,"en":"Riding far out ahead,"},{"id":"manas-2010:p1585:b001:l042","ordinal":68328,"en":"Looming like a huge mountain,"},{"id":"manas-2010:p1586:b001:l001","ordinal":68329,"en":"Behind him came the champions,"},{"id":"manas-2010:p1586:b001:l002","ordinal":68330,"en":"All swarming together, not one left out."},{"id":"manas-2010:p1586:b001:l003","ordinal":68331,"en":"Driving them forward from the rear,"},{"id":"manas-2010:p1586:b001:l004","ordinal":68332,"en":"Ezkara came prepared."},{"id":"manas-2010:p1586:b001:l005","ordinal":68333,"en":"Before another moment passed,"},{"id":"manas-2010:p1586:b001:l006","ordinal":68334,"en":"He arrived ahead of an arrow."},{"id":"manas-2010:p1586:b001:l007","ordinal":68335,"en":"Alöökö’s Kongurbay,"},{"id":"manas-2010:p1586:b001:l008","ordinal":68336,"en":"As soon as he reached Kökchö,"},{"id":"manas-2010:p1586:b001:l009","ordinal":68337,"en":"From atop Kögala"},{"id":"manas-2010:p1586:b001:l010","ordinal":68338,"en":"Knocked him flat and swept past."},{"id":"manas-2010:p1586:b001:l011","ordinal":68339,"en":"When Kökchö fell from his horse,"},{"id":"manas-2010:p1586:b001:l012","ordinal":68340,"en":"Kongurbay’s forty nobles"},{"id":"manas-2010:p1586:b001:l013","ordinal":68341,"en":"Took him into their midst"},{"id":"manas-2010:p1586:b001:l014","ordinal":68342,"en":"And surrounded him."},{"id":"manas-2010:p1586:b001:l015","ordinal":68343,"en":"From one side, Muzburchak,"},{"id":"manas-2010:p1586:b001:l016","ordinal":68344,"en":"His shout splitting stone,"},{"id":"manas-2010:p1586:b001:l017","ordinal":68345,"en":"Came charging."},{"id":"manas-2010:p1586:b001:l018","ordinal":68346,"en":"The forty nobles faced him;"},{"id":"manas-2010:p1586:b001:l019","ordinal":68347,"en":"All forty thrust their lances together,"},{"id":"manas-2010:p1586:b001:l020","ordinal":68348,"en":"Swarmed over Muzburchak,"},{"id":"manas-2010:p1586:b001:l021","ordinal":68349,"en":"And took him into their midst."},{"id":"manas-2010:p1586:b001:l022","ordinal":68350,"en":"See the bullets falling like rain!"},{"id":"manas-2010:p1586:b001:l023","ordinal":68351,"en":"Charging without fail,"},{"id":"manas-2010:p1586:b001:l024","ordinal":68352,"en":"See the troop upon troop!"}]
