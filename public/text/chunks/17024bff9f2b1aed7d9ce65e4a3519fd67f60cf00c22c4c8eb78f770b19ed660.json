[{"id":"semetey-1-2013:p0975:b003:l020","ordinal":150529,"en":"And raised the battle cry of Manas."},{"id":"semetey-1-2013:p0975:b003:l021","ordinal":150530,"en":"Overcome with joy,"},{"id":"semetey-1-2013:p0975:b003:l022","ordinal":150531,"en":"He pleaded with the two boys beside him,"},{"id":"semetey-1-2013:p0975:b003:l023","ordinal":150532,"en":"Calling, “Hurry and reach it!"},{"id":"semetey-1-2013:p0975:b003:l024","ordinal":150533,"en":"Kulchoro and Kanchoro,"},{"id":"semetey-1-2013:p0975:b003:l025","ordinal":150534,"en":"My two equal supports,"},{"id":"semetey-1-2013:p0975:b003:l026","ordinal":150535,"en":"You two, my younger brothers,"},{"id":"semetey-1-2013:p0975:b003:l027","ordinal":150536,"en":"Reach it before an arrow could;"},{"id":"semetey-1-2013:p0975:b003:l028","ordinal":150537,"en":"Get there and cut its throat."},{"id":"semetey-1-2013:p0975:b003:l029","ordinal":150538,"en":"Bind it securely again"},{"id":"semetey-1-2013:p0975:b003:l030","ordinal":150539,"en":"And fasten it to the saddle straps."},{"id":"semetey-1-2013:p0975:b003:l031","ordinal":150540,"en":"Slaughter it lawfully,"},{"id":"semetey-1-2013:p0975:b003:l032","ordinal":150541,"en":"And take it as a gift"},{"id":"semetey-1-2013:p0975:b003:l033","ordinal":150542,"en":"To my dear mother Kanykey!”"},{"id":"semetey-1-2013:p0975:b003:l034","ordinal":150543,"en":"After the falcon took it,"},{"id":"semetey-1-2013:p0975:b003:l035","ordinal":150544,"en":"Kulchoro and Kanchoro,"},{"id":"semetey-1-2013:p0975:b003:l036","ordinal":150545,"en":"The two choros, raced each other,"},{"id":"semetey-1-2013:p0975:b003:l037","ordinal":150546,"en":"Their stirrups striking together."},{"id":"semetey-1-2013:p0975:b003:l038","ordinal":150547,"en":"Before they could reach the swan,"},{"id":"semetey-1-2013:p0975:b003:l039","ordinal":150548,"en":"Wearing his handsome patterned coat,"},{"id":"semetey-1-2013:p0975:b004:l001","ordinal":150549,"en":"Semetey, brave son of Manas,"},{"id":"semetey-1-2013:p0975:b004:l002","ordinal":150550,"en":"Thundered along the road."},{"id":"semetey-1-2013:p0975:b004:l003","ordinal":150551,"en":"He made his neck turn like a stag’s;"},{"id":"semetey-1-2013:p0975:b004:l004","ordinal":150552,"en":"Buurul was a true courser,"},{"id":"semetey-1-2013:p0975:b004:l005","ordinal":150553,"en":"And when game appeared along its path,"},{"id":"semetey-1-2013:p0975:b004:l006","ordinal":150554,"en":"It sprang without delay."},{"id":"semetey-1-2013:p0975:b004:l007","ordinal":150555,"en":"He charged straight toward the swan;"},{"id":"semetey-1-2013:p0975:b004:l008","ordinal":150556,"en":"Poor Buurul’s hoofbeats"},{"id":"semetey-1-2013:p0975:b004:l009","ordinal":150557,"en":"Shattered the ground beneath him,"},{"id":"semetey-1-2013:p0975:b004:l010","ordinal":150558,"en":"And he flew roaring like a cloud."},{"id":"semetey-1-2013:p0975:b004:l011","ordinal":150559,"en":"Before one could say this or that,"},{"id":"semetey-1-2013:p0975:b004:l012","ordinal":150560,"en":"In the time it takes to blink,"},{"id":"semetey-1-2013:p0975:b004:l013","ordinal":150561,"en":"Semetey arrived like a master."},{"id":"semetey-1-2013:p0975:b004:l014","ordinal":150562,"en":"He had gone the length of a spear,"},{"id":"semetey-1-2013:p0975:b004:l015","ordinal":150563,"en":"Keeping his eyes fixed on the white swan."},{"id":"semetey-1-2013:p0975:b004:l016","ordinal":150564,"en":"Wondrous Akshunkar lay there,"},{"id":"semetey-1-2013:p0975:b004:l017","ordinal":150565,"en":"Clinging to the white swan’s neck;"},{"id":"semetey-1-2013:p0975:b004:l018","ordinal":150566,"en":"The white swan lay thrashing,"},{"id":"semetey-1-2013:p0975:b004:l019","ordinal":150567,"en":"Locked in battle with Akshunkar."},{"id":"semetey-1-2013:p0975:b004:l020","ordinal":150568,"en":"Raging, he made a sudden move,"},{"id":"semetey-1-2013:p0975:b004:l021","ordinal":150569,"en":"From tireless Buurul"},{"id":"semetey-1-2013:p0975:b004:l022","ordinal":150570,"en":"He sprang and leapt down."},{"id":"semetey-1-2013:p0975:b004:l023","ordinal":150571,"en":"The swan fled, and the falcon was gone;"},{"id":"semetey-1-2013:p0975:b004:l024","ordinal":150572,"en":"When Semetey opened his eyes,"},{"id":"semetey-1-2013:p0975:b004:l025","ordinal":150573,"en":"Such is the worthlessness of this world."},{"id":"semetey-1-2013:p0975:b004:l026","ordinal":150574,"en":"He saw the swan crawling away;"},{"id":"semetey-1-2013:p0975:b004:l027","ordinal":150575,"en":"The blue-maned tiger"},{"id":"semetey-1-2013:p0975:b004:l028","ordinal":150576,"en":"Reached out his hand to seize it,"},{"id":"semetey-1-2013:p0975:b004:l029","ordinal":150577,"en":"But caught the joint of its wing"},{"id":"semetey-1-2013:p0975:b004:l030","ordinal":150578,"en":"With an unsteady grip."},{"id":"semetey-1-2013:p0975:b004:l031","ordinal":150579,"en":"The white swan tore itself free"},{"id":"semetey-1-2013:p0975:b004:l032","ordinal":150580,"en":"And escaped into the deep water."},{"id":"semetey-1-2013:p0975:b004:l033","ordinal":150581,"en":"Where it crossed into Ala-Köl,"},{"id":"semetey-1-2013:p0975:b004:l034","ordinal":150582,"en":"The swaggering madman"},{"id":"semetey-1-2013:p0975:b004:l035","ordinal":150583,"en":"Caught it by the throat."},{"id":"semetey-1-2013:p0975:b004:l036","ordinal":150584,"en":"He pulled back in grief,"},{"id":"semetey-1-2013:p0975:b004:l037","ordinal":150585,"en":"And Semetey, still bewildered,"},{"id":"semetey-1-2013:p0975:b004:l038","ordinal":150586,"en":"Ran toward Arbuudan."},{"id":"semetey-1-2013:p0975:b004:l039","ordinal":150587,"en":"What could the desperate prince do?"},{"id":"semetey-1-2013:p0976:b003:l001","ordinal":150588,"en":"Toward Buurul, standing riderless,"},{"id":"semetey-1-2013:p0976:b003:l002","ordinal":150589,"en":"The bewildered Semetey"},{"id":"semetey-1-2013:p0976:b003:l003","ordinal":150590,"en":"Ran and mounted in haste."},{"id":"semetey-1-2013:p0976:b003:l004","ordinal":150591,"en":"That white swan would not release"},{"id":"semetey-1-2013:p0976:b003:l005","ordinal":150592,"en":"Kojosán’s falcon;"},{"id":"semetey-1-2013:p0976:b003:l006","ordinal":150593,"en":"It clenched the short leash,"},{"id":"semetey-1-2013:p0976:b003:l007","ordinal":150594,"en":"Tucked it beneath its wing,"},{"id":"semetey-1-2013:p0976:b003:l008","ordinal":150595,"en":"Beat the water with its tail,"},{"id":"semetey-1-2013:p0976:b003:l009","ordinal":150596,"en":"And thrashed the dark lake with its wings."},{"id":"semetey-1-2013:p0976:b003:l010","ordinal":150597,"en":"It went farther downward,"},{"id":"semetey-1-2013:p0976:b003:l011","ordinal":150598,"en":"Then sped away like the wind;"},{"id":"semetey-1-2013:p0976:b003:l012","ordinal":150599,"en":"When he looked, it vanished from sight."},{"id":"semetey-1-2013:p0976:b003:l013","ordinal":150600,"en":"The great white swan was escaping,"},{"id":"semetey-1-2013:p0976:b003:l014","ordinal":150601,"en":"And no one could tell which it was."},{"id":"semetey-1-2013:p0976:b003:l015","ordinal":150602,"en":"Your young, blue-maned prince"},{"id":"semetey-1-2013:p0976:b003:l016","ordinal":150603,"en":"Had a true courser beneath him,"},{"id":"semetey-1-2013:p0976:b003:l017","ordinal":150604,"en":"Which raced with a flying bird;"},{"id":"semetey-1-2013:p0976:b003:l018","ordinal":150605,"en":"The white reins steeped in tanning liquor"},{"id":"semetey-1-2013:p0976:b003:l019","ordinal":150606,"en":"Contracted within his palm."},{"id":"semetey-1-2013:p0976:b003:l020","ordinal":150607,"en":"He pursued the white swan"},{"id":"semetey-1-2013:p0976:b003:l021","ordinal":150608,"en":"Upon the true tulpar Buurul."},{"id":"semetey-1-2013:p0976:b003:l022","ordinal":150609,"en":"The white swan’s uncanny power"},{"id":"semetey-1-2013:p0976:b003:l023","ordinal":150610,"en":"Had carried the falcon away."},{"id":"semetey-1-2013:p0976:b003:l024","ordinal":150611,"en":"With a camel-like forelock and swept-back mane,"},{"id":"semetey-1-2013:p0976:b003:l025","ordinal":150612,"en":"Buurul was a true courser;"},{"id":"semetey-1-2013:p0976:b003:l026","ordinal":150613,"en":"He laid his ears flat like a wild ass,"},{"id":"semetey-1-2013:p0976:b003:l027","ordinal":150614,"en":"And with no escape in sight,"},{"id":"semetey-1-2013:p0976:b003:l028","ordinal":150615,"en":"Churned the earth like a whirlwind."},{"id":"semetey-1-2013:p0976:b003:l029","ordinal":150616,"en":"He gathered himself in bounding strides,"},{"id":"semetey-1-2013:p0976:b003:l030","ordinal":150617,"en":"And surged as though diving into a hollow."},{"id":"semetey-1-2013:p0976:b003:l031","ordinal":150618,"en":"From a ridge curved like a saddle bow,"},{"id":"semetey-1-2013:p0976:b003:l032","ordinal":150619,"en":"He bent low and entered beyond it."},{"id":"semetey-1-2013:p0976:b003:l033","ordinal":150620,"en":"They drew close;"},{"id":"semetey-1-2013:p0976:b003:l034","ordinal":150621,"en":"Your swaggering madman"},{"id":"semetey-1-2013:p0976:b003:l035","ordinal":150622,"en":"Raised the patterned spear in his hand"},{"id":"semetey-1-2013:p0976:b003:l036","ordinal":150623,"en":"And cast it badly."},{"id":"semetey-1-2013:p0976:b003:l037","ordinal":150624,"en":"Seeing that escape was impossible,"},{"id":"semetey-1-2013:p0976:b003:l038","ordinal":150625,"en":"What could poor Chürök do?"},{"id":"semetey-1-2013:p0976:b003:l039","ordinal":150626,"en":"It farted with a crack and shat with a snap,"},{"id":"semetey-1-2013:p0976:b004:l001","ordinal":150627,"en":"And cast down a walking fog."},{"id":"semetey-1-2013:p0976:b004:l002","ordinal":150628,"en":"When he looked, nothing could be seen,"},{"id":"semetey-1-2013:p0976:b004:l003","ordinal":150629,"en":"And no one knew where it was."},{"id":"semetey-1-2013:p0976:b004:l004","ordinal":150630,"en":"Clouds split open in the sky,"},{"id":"semetey-1-2013:p0976:b004:l005","ordinal":150631,"en":"And rain poured onto the earth;"},{"id":"semetey-1-2013:p0976:b004:l006","ordinal":150632,"en":"Clouds wheeled across the heavens,"},{"id":"semetey-1-2013:p0976:b004:l007","ordinal":150633,"en":"And eight months’ hail poured down."},{"id":"semetey-1-2013:p0976:b004:l008","ordinal":150634,"en":"A squall went shrieking,"},{"id":"semetey-1-2013:p0976:b004:l009","ordinal":150635,"en":"Through ravine, slope, and plain;"},{"id":"semetey-1-2013:p0976:b004:l010","ordinal":150636,"en":"A foul fog roared,"},{"id":"semetey-1-2013:p0976:b004:l011","ordinal":150637,"en":"And a walking mist descended and blinded the eyes."},{"id":"semetey-1-2013:p0976:b004:l012","ordinal":150638,"en":"Rain covered every lowland,"},{"id":"semetey-1-2013:p0976:b004:l013","ordinal":150639,"en":"Hail covered every upland,"},{"id":"semetey-1-2013:p0976:b004:l014","ordinal":150640,"en":"And the sun was hidden from view."},{"id":"semetey-1-2013:p0976:b004:l015","ordinal":150641,"en":"The falcon was carried away,"},{"id":"semetey-1-2013:p0976:b004:l016","ordinal":150642,"en":"And that Chürök escaped."},{"id":"semetey-1-2013:p0976:b004:l017","ordinal":150643,"en":"Nar Buurul opened his stride;"},{"id":"semetey-1-2013:p0976:b004:l018","ordinal":150644,"en":"The tiger, his father Manas,"},{"id":"semetey-1-2013:p0976:b004:l019","ordinal":150645,"en":"Seemed to have died that very day."},{"id":"semetey-1-2013:p0976:b004:l020","ordinal":150646,"en":"The tiger grieved,"},{"id":"semetey-1-2013:p0976:b004:l021","ordinal":150647,"en":"Having lost Akshunkar;"},{"id":"semetey-1-2013:p0976:b004:l022","ordinal":150648,"en":"His anger rose and his face darkened,"},{"id":"semetey-1-2013:p0976:b004:l023","ordinal":150649,"en":"And his dark rage swelled."},{"id":"semetey-1-2013:p0976:b004:l024","ordinal":150650,"en":"He shouted in fury,"},{"id":"semetey-1-2013:p0976:b004:l025","ordinal":150651,"en":"Calling Kulchoro and Kanchoro,"},{"id":"semetey-1-2013:p0976:b004:l026","ordinal":150652,"en":"Summoning the two of them."},{"id":"semetey-1-2013:p0976:b004:l027","ordinal":150653,"en":"His bellow split heads,"},{"id":"semetey-1-2013:p0976:b004:l028","ordinal":150654,"en":"His cry split stones;"},{"id":"semetey-1-2013:p0976:b004:l029","ordinal":150655,"en":"His eyes blazed like a lion’s,"},{"id":"semetey-1-2013:p0976:b004:l030","ordinal":150656,"en":"And bloodlust truly seized him."},{"id":"semetey-1-2013:p0976:b004:l031","ordinal":150657,"en":"He blackened in his dark fury,"},{"id":"semetey-1-2013:p0976:b004:l032","ordinal":150658,"en":"And when the exhausted prince stood there,"},{"id":"semetey-1-2013:p0976:b004:l033","ordinal":150659,"en":"Kulchoro and Kanchoro,"},{"id":"semetey-1-2013:p0976:b004:l034","ordinal":150660,"en":"The two choros, raced one another,"},{"id":"semetey-1-2013:p0976:b004:l035","ordinal":150661,"en":"Their stirrups striking together;"},{"id":"semetey-1-2013:p0976:b004:l036","ordinal":150662,"en":"They fought the bits"},{"id":"semetey-1-2013:p0976:b004:l037","ordinal":150663,"en":"Of their two equal tulpars."},{"id":"semetey-1-2013:p0976:b004:l038","ordinal":150664,"en":"When they drew near the prince,"},{"id":"semetey-1-2013:p0976:b004:l039","ordinal":150665,"en":"He poured out bitter reproaches,"}]
