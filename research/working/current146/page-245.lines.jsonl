{"id": "sayakbay-ms-current146:pdf245:l001", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 1, "raw": "Олуя жайган багыны,", "text": "Олуя жайган багыны,", "en": "The saint spread out his blessing.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l002", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 2, "raw": "Буй манга берет атаны,", "text": "Буй манга берет атаны,", "en": "This command gives the father to me.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l003", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 3, "raw": "Аманат жандан айрылган,", "text": "Аманат жандан айрылган,", "en": "Separated from the life held in trust,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l004", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 4, "raw": "Таманды ташка тийгизип,", "text": "Таманды ташка тийгизип,", "en": "He set the soles of his feet upon stone.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l005", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 5, "raw": "Кененин күнгө күйгүзүп,", "text": "Кененин күнгө күйгүзүп,", "en": "They burned Kenen beneath the sun.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 6, "raw": "Кармалдарга жан калбай,", "text": "Кармалдарга жан калбай,", "en": "No living soul remained among the captives.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 7, "raw": "Бир төкөгө мал калбай,", "text": "Бир төкөгө мал калбай,", "en": "Not one head of livestock remained at the station.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 8, "raw": "Олуя элек түбүбүз,", "text": "Олуя элек түбүбүз,", "en": "Our roots had not yet known sainthood.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 9, "raw": "Опасызга алдырып,", "text": "Опасызга алдырып,", "en": "Delivered into the hands of the faithless,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 10, "raw": "Ойрон болуп жетебиз,", "text": "Ойрон болуп жетебиз,", "en": "We reach the end in ruin.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 11, "raw": "Далай кордук, далай зар,", "text": "Далай кордук, далай зар,", "en": "Much humiliation and much lament,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 12, "raw": "Турмушта тартканбыз,", "text": "Турмушта тартканбыз,", "en": "We have endured in life.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l013", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 13, "raw": "Жайкалганда чачканбыз,", "text": "Жайкалганда чачканбыз,", "en": "When it flourished, we scattered it.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 14, "raw": "Жылап туруп күн өтүп,", "text": "Жылап туруп күн өтүп,", "en": "The day passed while we stood weeping.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 15, "raw": "Аманат жандан шашканбыз,", "text": "Аманат жандан шашканбыз,", "en": "We hurried away from the entrusted life.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 16, "raw": "Ал абал жаны ушундай,", "text": "Ал абал жаны ушундай,", "en": "Such was the state of his soul.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 17, "raw": "Суукка тоңдук, тон берип,", "text": "Суукка тоңдук, тон берип,", "en": "We froze in the cold and gave away our coats.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 18, "raw": "Өлүм деп кол берип,", "text": "Өлүм деп кол берип,", "en": "Saying “death,” we yielded our hands.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 19, "raw": "Эринди ашка тийгизип,", "text": "Эринди ашка тийгизип,", "en": "They brought his lips to food.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 20, "raw": "Ээрге, төргө кийгизип,", "text": "Ээрге, төргө кийгизип,", "en": "They clothed him for saddle and place of honor.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 21, "raw": "Чын калгандан түр болгон,", "text": "Чын калгандан түр болгон,", "en": "A form arose from what remained true.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 22, "raw": "Азамат билгизип,", "text": "Азамат билгизип,", "en": "Making the hero known,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 23, "raw": "Түшбөгөнгө түзүп,", "text": "Түшбөгөнгө түзүп,", "en": "They set it straight for the one who did not descend.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l024", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 24, "raw": "Тура жоого салышты,", "text": "Тура жоого салышты,", "en": "They sent him standing against the enemy.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 25, "raw": "Билбегендей билгизип,", "text": "Билбегендей билгизип,", "en": "They made him understand as though he knew nothing.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 26, "raw": "Минтип жоого киргизип,", "text": "Минтип жоого киргизип,", "en": "Thus they sent him into the enemy.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 27, "raw": "Ага болуп калыңыз,", "text": "Ага болуп калыңыз,", "en": "Remain as an elder brother.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 28, "raw": "Кандан каар көргөнбүз,", "text": "Кандан каар көргөнбүз,", "en": "We have seen wrath born of blood.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 29, "raw": "Кабылан сыңдуу көк жалбыз,", "text": "Кабылан сыңдуу көк жалбыз,", "en": "We are gray-maned lions.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 30, "raw": "Кайран Кенен баатырды,", "text": "Кайран Кенен баатырды,", "en": "Poor hero Kenen,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 31, "raw": "Эбегей, Кудай арбагы,", "text": "Эбегей, Кудай арбагы,", "en": "Immense one, spirit of God,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 32, "raw": "Эриксине канат көп мушт,", "text": "Эриксине канат көп мушт,", "en": "Many fists beat his restless wings.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 33, "raw": "Хан кызына кол жүктөп,", "text": "Хан кызына кол жүктөп,", "en": "They laid hands upon the khan’s daughter.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l034", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 34, "raw": "Тили шекер чалынды,", "text": "Тили шекер чалынды,", "en": "Her tongue, sweet as sugar, faltered.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l035", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 35, "raw": "Каардуу күн коюну,", "text": "Каардуу күн коюну,", "en": "The bosom of the cruel day,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l036", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 36, "raw": "Берен Кенен бул сөзү,", "text": "Берен Кенен бул сөзү,", "en": "These were brave Kenen’s words,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf245:l037", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 245, "folio": 628, "line_in_page": 37, "raw": "Орто өкөндүн алдында.", "text": "Орто өкөндүн алдында.", "en": "Before the one seated in the middle.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
