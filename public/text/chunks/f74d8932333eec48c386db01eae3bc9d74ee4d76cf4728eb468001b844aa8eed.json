27,"en":"If it gets tough, it's a conflict"},{"id":"seytek-2012:p0860:b003:l022","ordinal":360428,"en":"You will not go home safely."},{"id":"seytek-2012:p0860:b003:l023","ordinal":360429,"en":"Destroying the bere"},{"id":"seytek-2012:p0860:b003:l024","ordinal":360430,"en":"If I don't pay more attention,"},{"id":"seytek-2012:p0860:b003:l025","ordinal":360431,"en":"Don't let your hair down,"},{"id":"seytek-2012:p0860:b003:l026","ordinal":360432,"en":"If I don't cut it off completely."},{"id":"seytek-2012:p0860:b003:l027","ordinal":360433,"en":"If you barely find it,"},{"id":"seytek-2012:p0860:b003:l028","ordinal":360434,"en":"If you don't have an ancient demon,"},{"id":"seytek-2012:p0860:b003:l029","ordinal":360435,"en":"If you don't have heroes,"},{"id":"seytek-2012:p0860:b003:l030","ordinal":360436,"en":"If I don't kill your heroes,"},{"id":"seytek-2012:p0860:b003:l031","ordinal":360437,"en":"Let me die without being poor,"},{"id":"seytek-2012:p0860:b003:l032","ordinal":360438,"en":"Let me sink into the night without being born,"},{"id":"seytek-2012:p0860:b003:l033","ordinal":360439,"en":"Kulchoro was mad"},{"id":"seytek-2012:p0860:b003:l034","ordinal":360440,"en":"Let me shed your blood while chasing"},{"id":"seytek-2012:p0860:b003:l035","ordinal":360441,"en":"If I notice that it seems to be stuck,"},{"id":"seytek-2012:p0860:b003:l036","ordinal":360442,"en":"Let me try to compete with this."},{"id":"seytek-2012:p0860:b003:l037","ordinal":360443,"en":"I am myself when I play"},{"id":"seytek-2012:p0860:b003:l038","ordinal":360444,"en":"He stretched out a wrapped spear,"},{"id":"seytek-2012:p0860:b003:l039","ordinal":360445,"en":"There is little to do, no money"},{"id":"seytek-2012:p0860:b003:l040","ordinal":360446,"en":"That he quarreled with each other,"},{"id":"seytek-2012:p0861:b002:l001","ordinal":360447,"en":"Not even half a hair,"},{"id":"seytek-2012:p0861:b002:l002","ordinal":360448,"en":"The beating of Eselek people,"}]
