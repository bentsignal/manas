[{"id":"semetey-1-2013:p0496:b003:l036","ordinal":114689,"en":"From other opened wounds"},{"id":"semetey-1-2013:p0496:b003:l037","ordinal":114690,"en":"Dark venom flowed."},{"id":"semetey-1-2013:p0496:b003:l038","ordinal":114691,"en":"Lifting his basin-sized head,"},{"id":"semetey-1-2013:p0496:b003:l039","ordinal":114692,"en":"Worn out, too weary to reach them,"},{"id":"semetey-1-2013:p0496:b004:l001","ordinal":114693,"en":"The generous lion had fallen behind,"},{"id":"semetey-1-2013:p0496:b004:l002","ordinal":114694,"en":"Sick and coughing."},{"id":"semetey-1-2013:p0496:b004:l003","ordinal":114695,"en":"Unable to mount for scouting,"},{"id":"semetey-1-2013:p0496:b004:l004","ordinal":114696,"en":"Your generous lord and the forty companions"},{"id":"semetey-1-2013:p0496:b004:l005","ordinal":114697,"en":"Could not go scouting together."},{"id":"semetey-1-2013:p0496:b004:l006","ordinal":114698,"en":"Kanykei bore the anguish;"},{"id":"semetey-1-2013:p0496:b004:l007","ordinal":114699,"en":"Outside, the forty companions"},{"id":"semetey-1-2013:p0496:b004:l008","ordinal":114700,"en":"Spoke their parting charge."},{"id":"semetey-1-2013:p0496:b004:l009","ordinal":114701,"en":"Manas, gravely ill,"},{"id":"semetey-1-2013:p0496:b004:l010","ordinal":114702,"en":"She led away toward Talas:"},{"id":"semetey-1-2013:p0496:b004:l011","ordinal":114703,"en":"Poor Kanykei had turned back."},{"id":"semetey-1-2013:p0496:b004:l012","ordinal":114704,"en":"The place they reached in Kalmyk country"},{"id":"semetey-1-2013:p0496:b004:l013","ordinal":114705,"en":"Was the broad slope of Keng-Jyldyz;"},{"id":"semetey-1-2013:p0496:b004:l014","ordinal":114706,"en":"Bloody slaughter, a mighty battle,"},{"id":"semetey-1-2013:p0496:b004:l015","ordinal":114707,"en":"Had come to that place."},{"id":"semetey-1-2013:p0496:b004:l016","ordinal":114708,"en":"Shrill shouting, fierce cheering,"},{"id":"semetey-1-2013:p0496:b004:l017","ordinal":114709,"en":"A great clash, a mighty battle,"},{"id":"semetey-1-2013:p0496:b004:l018","ordinal":114710,"en":"Was raging at that time."},{"id":"semetey-1-2013:p0496:b004:l019","ordinal":114711,"en":"He who had poisoned Khan Manas—"},{"id":"semetey-1-2013:p0496:b004:l020","ordinal":114712,"en":"Such was the story of Közkaman."},{"id":"semetey-1-2013:p0496:b004:l021","ordinal":114713,"en":"They contested on horseback,"},{"id":"semetey-1-2013:p0496:b004:l022","ordinal":114714,"en":"Fighting so long without wavering."},{"id":"semetey-1-2013:p0496:b004:l023","ordinal":114715,"en":"Golden forelock, tasseled belt,"},{"id":"semetey-1-2013:p0496:b004:l024","ordinal":114716,"en":"Almambet the lion, the noble lion!"},{"id":"semetey-1-2013:p0496:b004:l025","ordinal":114717,"en":"Sarala beneath him,"},{"id":"semetey-1-2013:p0496:b004:l026","ordinal":114718,"en":"Hoe-broad rump and wide hooves,"},{"id":"semetey-1-2013:p0496:b004:l027","ordinal":114719,"en":"A courser of the spacious land."},{"id":"semetey-1-2013:p0496:b004:l028","ordinal":114720,"en":"When Almambet took his spear,"},{"id":"semetey-1-2013:p0496:b004:l029","ordinal":114721,"en":"He was a master of combat;"},{"id":"semetey-1-2013:p0496:b004:l030","ordinal":114722,"en":"Many times had Almambet entered"},{"id":"semetey-1-2013:p0496:b004:l031","ordinal":114723,"en":"Battles such as this."},{"id":"semetey-1-2013:p0496:b004:l032","ordinal":114724,"en":"Flinging its forelock to the sky,"},{"id":"semetey-1-2013:p0496:b004:l033","ordinal":114725,"en":"Driving its hooves into the earth,"},{"id":"semetey-1-2013:p0496:b004:l034","ordinal":114726,"en":"Rattling the bit,"},{"id":"semetey-1-2013:p0496:b004:l035","ordinal":114727,"en":"Its tail like silken strands"},{"id":"semetey-1-2013:p0496:b004:l036","ordinal":114728,"en":"Lashing on either side,"},{"id":"semetey-1-2013:p0496:b004:l037","ordinal":114729,"en":"Fired up and straining,"},{"id":"semetey-1-2013:p0496:b004:l038","ordinal":114730,"en":"The courser tugged, refusing restraint."},{"id":"semetey-1-2013:p0496:b004:l039","ordinal":114731,"en":"Spear in hand, breaking their ranks,"},{"id":"semetey-1-2013:p0497:b003:l001","ordinal":114732,"en":"Mortals doomed to die fell to the bullets."},{"id":"semetey-1-2013:p0497:b003:l003","ordinal":114733,"en":"They took no daytime rest,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0497:b003:l004","ordinal":114734,"en":"No sleep propped on an elbow,"},{"id":"semetey-1-2013:p0497:b003:l005","ordinal":114735,"en":"Not a moment's doze or peace."},{"id":"semetey-1-2013:p0497:b003:l006","ordinal":114736,"en":"Közkaman's eighty, the others forty—"},{"id":"semetey-1-2013:p0497:b003:l007","ordinal":114737,"en":"They fought face to face,"},{"id":"semetey-1-2013:p0497:b003:l008","ordinal":114738,"en":"Creating a hell no mortal had seen"},{"id":"semetey-1-2013:p0497:b003:l009","ordinal":114739,"en":"Out on the open plain."},{"id":"semetey-1-2013:p0497:b003:l010","ordinal":114740,"en":"The beasts could not endure the shooting;"},{"id":"semetey-1-2013:p0497:b003:l011","ordinal":114741,"en":"When horses died upon the plain,"},{"id":"semetey-1-2013:p0497:b003:l012","ordinal":114742,"en":"They changed horses and mounted,"},{"id":"semetey-1-2013:p0497:b003:l013","ordinal":114743,"en":"Standing their ground,"},{"id":"semetey-1-2013:p0497:b003:l014","ordinal":114744,"en":"Fighting face to face again and again."},{"id":"semetey-1-2013:p0497:b003:l015","ordinal":114745,"en":"Golden forelock, tasseled belt,"},{"id":"semetey-1-2013:p0497:b003:l016","ordinal":114746,"en":"The outstanding lion Almambet"},{"id":"semetey-1-2013:p0497:b003:l017","ordinal":114747,"en":"Took the weather-stone received from the unseen,"},{"id":"semetey-1-2013:p0497:b003:l018","ordinal":114748,"en":"Chanted over it and put it in water."},{"id":"semetey-1-2013:p0497:b003:l019","ordinal":114749,"en":"The weather-stone received from a snake"},{"id":"semetey-1-2013:p0497:b003:l020","ordinal":114750,"en":"To a cup of clear water"},{"id":"semetey-1-2013:p0497:b003:l021","ordinal":114751,"en":"He let barely touch."},{"id":"semetey-1-2013:p0497:b003:l022","ordinal":114752,"en":"Karykan's great weather-stone—"},{"id":"semetey-1-2013:p0497:b003:l024","ordinal":114753,"en":"He took it and placed it in water.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0497:b003:l025","ordinal":114754,"en":"The cloud's name was Buurakan;"},{"id":"semetey-1-2013:p0497:b003:l026","ordinal":114755,"en":"Calling out that name,"},{"id":"semetey-1-2013:p0497:b003:l027","ordinal":114756,"en":"Almambet the lion, the noble lion,"},{"id":"semetey-1-2013:p0497:b003:l028","ordinal":114757,"en":"Was working weather-magic."},{"id":"semetey-1-2013:p0497:b003:l029","ordinal":114758,"en":"Striking his golden saddle-pommel,"},{"id":"semetey-1-2013:p0497:b003:l030","ordinal":114759,"en":"Clashing his stirrups,"},{"id":"semetey-1-2013:p0497:b003:l031","ordinal":114760,"en":"Almambet looked toward the sky,"},{"id":"semetey-1-2013:p0497:b003:l032","ordinal":114761,"en":"Shouted three times, blew three times,"},{"id":"semetey-1-2013:p0497:b003:l033","ordinal":114762,"en":"Rattling off words in Kalmyk,"},{"id":"semetey-1-2013:p0497:b003:l034","ordinal":114763,"en":"Babbling in Chinese."},{"id":"semetey-1-2013:p0497:b003:l035","ordinal":114764,"en":"Three times he heaved and bucked;"},{"id":"semetey-1-2013:p0497:b003:l036","ordinal":114765,"en":"Almambet cast his weather-spell."},{"id":"semetey-1-2013:p0497:b003:l037","ordinal":114766,"en":"Clouds beat down from the sky,"},{"id":"semetey-1-2013:p0497:b003:l038","ordinal":114767,"en":"Clouds hemmed in the earth."},{"id":"semetey-1-2013:p0497:b003:l039","ordinal":114768,"en":"Clouds from the sky, one by one,"},{"id":"semetey-1-2013:p0497:b005:l001","ordinal":114769,"en":"Shuddered down toward the earth;"},{"id":"semetey-1-2013:p0497:b005:l002","ordinal":114770,"en":"Hail fell over all the foothills,"},{"id":"semetey-1-2013:p0497:b005:l003","ordinal":114771,"en":"Rain over all the lower land."},{"id":"semetey-1-2013:p0497:b005:l004","ordinal":114772,"en":"Nothing could be seen at a glance:"},{"id":"semetey-1-2013:p0497:b005:l005","ordinal":114773,"en":"The world's face was ground-hugging fog,"},{"id":"semetey-1-2013:p0497:b005:l006","ordinal":114774,"en":"Nothing could be distinguished."},{"id":"semetey-1-2013:p0497:b005:l007","ordinal":114775,"en":"Drizzle turned to snow in gusts;"},{"id":"semetey-1-2013:p0497:b005:l008","ordinal":114776,"en":"The earth shook and rattled."},{"id":"semetey-1-2013:p0497:b005:l009","ordinal":114777,"en":"Through ravine after ravine"},{"id":"semetey-1-2013:p0497:b005:l010","ordinal":114778,"en":"Torrents ran, floods swept down."},{"id":"semetey-1-2013:p0497:b005:l011","ordinal":114779,"en":"The summer day froze into winter;"},{"id":"semetey-1-2013:p0497:b005:l012","ordinal":114780,"en":"Thinly clothed Kökchököz"},{"id":"semetey-1-2013:p0497:b005:l013","ordinal":114781,"en":"Became a girl trembling to and fro."},{"id":"semetey-1-2013:p0497:b005:l014","ordinal":114782,"en":"Almambet the panther, the noble lion,"},{"id":"semetey-1-2013:p0497:b005:l015","ordinal":114783,"en":"Held fiercely to his weather-magic"},{"id":"semetey-1-2013:p0497:b005:l016","ordinal":114784,"en":"And fought there."},{"id":"semetey-1-2013:p0497:b005:l017","ordinal":114785,"en":"Kökchököz took no heed;"},{"id":"semetey-1-2013:p0497:b005:l018","ordinal":114786,"en":"That unbeliever buzzed away,"},{"id":"semetey-1-2013:p0497:b005:l019","ordinal":114787,"en":"Almambet's weather-spell"},{"id":"semetey-1-2013:p0497:b005:l020","ordinal":114788,"en":"He did not value in the slightest."},{"id":"semetey-1-2013:p0497:b005:l021","ordinal":114789,"en":"They had saddled their horses together;"},{"id":"semetey-1-2013:p0497:b005:l022","ordinal":114790,"en":"The wondrous arts"},{"id":"semetey-1-2013:p0497:b005:l023","ordinal":114791,"en":"Kökchököz and Almambet"},{"id":"semetey-1-2013:p0497:b005:l024","ordinal":114792,"en":"Had studied equally."},{"id":"semetey-1-2013:p0497:b005:l025","ordinal":114793,"en":"One made storms, the other cleared them;"},{"id":"semetey-1-2013:p0497:b005:l026","ordinal":114794,"en":"They stood their ground,"},{"id":"semetey-1-2013:p0497:b005:l027","ordinal":114795,"en":"Staring each other down as they fought."},{"id":"semetey-1-2013:p0497:b005:l028","ordinal":114796,"en":"Do not ask about Közkaman!"},{"id":"semetey-1-2013:p0497:b005:l029","ordinal":114797,"en":"Kongkulboz was a winged steed;"},{"id":"semetey-1-2013:p0497:b005:l030","ordinal":114798,"en":"He gave Kongkulboz a lash,"},{"id":"semetey-1-2013:p0497:b005:l031","ordinal":114799,"en":"Grasped his spear without holding back,"},{"id":"semetey-1-2013:p0497:b005:l032","ordinal":114800,"en":"And attacked the forty companions."},{"id":"semetey-1-2013:p0497:b005:l033","ordinal":114801,"en":"Making Kongkulboz prance,"},{"id":"semetey-1-2013:p0497:b005:l034","ordinal":114802,"en":"He sent all he faced crawling."},{"id":"semetey-1-2013:p0497:b005:l035","ordinal":114803,"en":"Their champion, Khan Manas, was absent."},{"id":"semetey-1-2013:p0497:b005:l036","ordinal":114804,"en":"Seen today, gone tomorrow—"},{"id":"semetey-1-2013:p0497:b005:l037","ordinal":114805,"en":"Such is this shitty world!"},{"id":"semetey-1-2013:p0497:b005:l038","ordinal":114806,"en":"His shouting split stones,"},{"id":"semetey-1-2013:p0497:b005:l039","ordinal":114807,"en":"His roaring split heads,"},{"id":"semetey-1-2013:p0498:b003:l001","ordinal":114808,"en":"As though an evil spirit had seized his wife,"},{"id":"semetey-1-2013:p0498:b003:l002","ordinal":114809,"en":"As though populous Beijing, its many Chinese,"},{"id":"semetey-1-2013:p0498:b003:l003","ordinal":114810,"en":"Lay dead at his feet,"},{"id":"semetey-1-2013:p0498:b003:l004","ordinal":114811,"en":"He had grown furious"},{"id":"semetey-1-2013:p0498:b003:l005","ordinal":114812,"en":"And wrought havoc."},{"id":"semetey-1-2013:p0498:b003:l006","ordinal":114813,"en":"His men in iron-rope mail"},{"id":"semetey-1-2013:p0498:b003:l007","ordinal":114814,"en":"He sent sweeping forward, all of them,"},{"id":"semetey-1-2013:p0498:b003:l008","ordinal":114815,"en":"Every dagger-handed warrior."},{"id":"semetey-1-2013:p0498:b003:l009","ordinal":114816,"en":"From one side, without holding back,"},{"id":"semetey-1-2013:p0498:b003:l010","ordinal":114817,"en":"Skilled on horseback, strong on foot,"},{"id":"semetey-1-2013:p0498:b003:l011","ordinal":114818,"en":"The fleet fighter of that unbeliever,"},{"id":"semetey-1-2013:p0498:b003:l012","ordinal":114819,"en":"Raising tumult from behind,"},{"id":"semetey-1-2013:p0498:b003:l013","ordinal":114820,"en":"Had now arrived—did you see?"},{"id":"semetey-1-2013:p0498:b003:l014","ordinal":114821,"en":"Kökchököz's band of marauders,"},{"id":"semetey-1-2013:p0498:b003:l015","ordinal":114822,"en":"His warriors bearing iron maces,"},{"id":"semetey-1-2013:p0498:b003:l016","ordinal":114823,"en":"Came sweeping on together."},{"id":"semetey-1-2013:p0498:b003:l017","ordinal":114824,"en":"The most skillful spearmen,"},{"id":"semetey-1-2013:p0498:b003:l018","ordinal":114825,"en":"The finest warriors, holding nothing back,"},{"id":"semetey-1-2013:p0498:b003:l019","ordinal":114826,"en":"All charged abreast"},{"id":"semetey-1-2013:p0498:b003:l020","ordinal":114827,"en":"At King Almambet the wolf-man."},{"id":"semetey-1-2013:p0498:b003:l021","ordinal":114828,"en":"All reached him side by side,"},{"id":"semetey-1-2013:p0498:b003:l022","ordinal":114829,"en":"Almambet the panther, the wolf-man,"},{"id":"semetey-1-2013:p0498:b003:l023","ordinal":114830,"en":"And surrounded him."},{"id":"semetey-1-2013:p0498:b003:l024","ordinal":114831,"en":"Bakai, hero of the saints,"},{"id":"semetey-1-2013:p0498:b003:l025","ordinal":114832,"en":"Ajybai of Khan Argyn,"},{"id":"semetey-1-2013:p0498:b003:l026","ordinal":114833,"en":"Hero Chubak of Akbaltai,"},{"id":"semetey-1-2013:p0498:b003:l027","ordinal":114834,"en":"Hero Syrgak of Ulakkan,"},{"id":"semetey-1-2013:p0498:b003:l028","ordinal":114835,"en":"Yraman's Yrchuul,"},{"id":"semetey-1-2013:p0498:b003:l029","ordinal":114836,"en":"Hero Shuutu, his cap like a yurt's felt cover—"},{"id":"semetey-1-2013:p0498:b003:l030","ordinal":114837,"en":"Mounted on their fine steeds,"},{"id":"semetey-1-2013:p0498:b003:l031","ordinal":114838,"en":"Now charged and attacked,"},{"id":"semetey-1-2013:p0498:b003:l032","ordinal":114839,"en":"All forty companions in the fray."},{"id":"semetey-1-2013:p0498:b003:l033","ordinal":114840,"en":"The seven ishans who had come from Mecca"},{"id":"semetey-1-2013:p0498:b003:l034","ordinal":114841,"en":"He stationed in seven places;"},{"id":"semetey-1-2013:p0498:b003:l035","ordinal":114842,"en":"Your consummate elder Bakai"},{"id":"semetey-1-2013:p0498:b003:l036","ordinal":114843,"en":"Sent those he reached crawling."},{"id":"semetey-1-2013:p0498:b003:l037","ordinal":114844,"en":"Look at the dust drawing a haze,"},{"id":"semetey-1-2013:p0498:b003:l038","ordinal":114845,"en":"Within that very dust"},{"id":"semetey-1-2013:p0498:b003:l039","ordinal":114846,"en":"Look at the souls lying dead!"},{"id":"semetey-1-2013:p0498:b004:l001","ordinal":114847,"en":"When he saw the havoc,"},{"id":"semetey-1-2013:p0498:b004:l002","ordinal":114848,"en":"When Jeldeiboz, in the clash,"},{"id":"semetey-1-2013:p0498:b004:l003","ordinal":114849,"en":"Was killed by Khan Bakai,"},{"id":"semetey-1-2013:p0498:b004:l004","ordinal":114850,"en":"Then Közkaman,"},{"id":"semetey-1-2013:p0498:b004:l005","ordinal":114851,"en":"Upon great Kongkulboz the steed,"},{"id":"semetey-1-2013:p0498:b004:l006","ordinal":114852,"en":"Lashing this way and that,"},{"id":"semetey-1-2013:p0498:b004:l007","ordinal":114853,"en":"Spurring right and left,"},{"id":"semetey-1-2013:p0498:b004:l008","ordinal":114854,"en":"Reached the forty companions."},{"id":"semetey-1-2013:p0498:b004:l009","ordinal":114855,"en":"Hero Shuutu, his cap like a felt cover,"},{"id":"semetey-1-2013:p0498:b004:l010","ordinal":114856,"en":"Yraman's Yrchuul,"},{"id":"semetey-1-2013:p0498:b004:l011","ordinal":114857,"en":"Dark Tölög the diviner,"},{"id":"semetey-1-2013:p0498:b004:l012","ordinal":114858,"en":"And Baichoro—these four"},{"id":"semetey-1-2013:p0498:b004:l013","ordinal":114859,"en":"Közkaman came sweeping upon."},{"id":"semetey-1-2013:p0498:b004:l014","ordinal":114860,"en":"Struck by Közkaman's spear,"},{"id":"semetey-1-2013:p0498:b004:l015","ordinal":114861,"en":"All four, where he reached them,"},{"id":"semetey-1-2013:p0498:b004:l016","ordinal":114862,"en":"Were flung from their horses."},{"id":"semetey-1-2013:p0498:b004:l017","ordinal":114863,"en":"Skillfully spearing warriors,"},{"id":"semetey-1-2013:p0498:b004:l018","ordinal":114864,"en":"Közkaman, that mighty wrestler,"},{"id":"semetey-1-2013:p0498:b004:l019","ordinal":114865,"en":"Struck all four in succession."},{"id":"semetey-1-2013:p0498:b004:l020","ordinal":114866,"en":"Roaring in fury,"},{"id":"semetey-1-2013:p0498:b004:l021","ordinal":114867,"en":"“Are there any more warriors?” he cried,"},{"id":"semetey-1-2013:p0498:b004:l022","ordinal":114868,"en":"Challenging them to single combat."},{"id":"semetey-1-2013:p0498:b004:l023","ordinal":114869,"en":"As though he would devour them,"},{"id":"semetey-1-2013:p0498:b004:l024","ordinal":114870,"en":"The swine stood there puffed up."},{"id":"semetey-1-2013:p0498:b004:l025","ordinal":114871,"en":"Having torn them from their horses,"},{"id":"semetey-1-2013:p0498:b004:l026","ordinal":114872,"en":"Having made this spectacle,"},{"id":"semetey-1-2013:p0498:b004:l027","ordinal":114873,"en":"His warriors charged"},{"id":"semetey-1-2013:p0498:b004:l028","ordinal":114874,"en":"To reach those four,"},{"id":"semetey-1-2013:p0498:b004:l029","ordinal":114875,"en":"About to cut off their heads."},{"id":"semetey-1-2013:p0498:b004:l030","ordinal":114876,"en":"Charging toward hero Shuutu,"},{"id":"semetey-1-2013:p0498:b004:l031","ordinal":114877,"en":"Noble Serek arrived."},{"id":"semetey-1-2013:p0498:b004:l032","ordinal":114878,"en":"Hero Serek caught up hero Shuutu"},{"id":"semetey-1-2013:p0498:b004:l033","ordinal":114879,"en":"And galloped off with him."},{"id":"semetey-1-2013:p0498:b004:l034","ordinal":114880,"en":"Charging toward Yrchuul,"},{"id":"semetey-1-2013:p0498:b004:l035","ordinal":114881,"en":"Outstanding Syrgak arrived."},{"id":"semetey-1-2013:p0498:b004:l036","ordinal":114882,"en":"Hero Syrgak swooped and caught him,"},{"id":"semetey-1-2013:p0498:b004:l037","ordinal":114883,"en":"Seated him upon his right knee."},{"id":"semetey-1-2013:p0498:b004:l038","ordinal":114884,"en":"Before an eye could open and shut,"},{"id":"semetey-1-2013:p0498:b004:l039","ordinal":114885,"en":"Before a word could be spoken,"},{"id":"semetey-1-2013:p0499:b003:l001","ordinal":114886,"en":"He showed that he was a lion."},{"id":"semetey-1-2013:p0499:b003:l002","ordinal":114887,"en":"Four choros—the four companions—"},{"id":"semetey-1-2013:p0499:b003:l003","ordinal":114888,"en":"Reached them and mounted them on horses,"},{"id":"semetey-1-2013:p0499:b003:l004","ordinal":114889,"en":"Kindled their extinguished fires,"},{"id":"semetey-1-2013:p0499:b003:l005","ordinal":114890,"en":"Revived their dying souls."},{"id":"semetey-1-2013:p0499:b003:l006","ordinal":114891,"en":"As they mounted the fallen"},{"id":"semetey-1-2013:p0499:b003:l007","ordinal":114892,"en":"And were busy with them,"},{"id":"semetey-1-2013:p0499:b003:l008","ordinal":114893,"en":"His two eyes flashing fiercely,"},{"id":"semetey-1-2013:p0499:b003:l009","ordinal":114894,"en":"His mighty teeth like doors—"},{"id":"semetey-1-2013:p0499:b003:l010","ordinal":114895,"en":"Was he not Khan Közkaman?—"},{"id":"semetey-1-2013:p0499:b003:l011","ordinal":114896,"en":"He gnashed them hard and loud:"},{"id":"semetey-1-2013:p0499:b003:l012","ordinal":114897,"en":"“Beginning with Syrgak, the forty companions—"},{"id":"semetey-1-2013:p0499:b003:l013","ordinal":114898,"en":"I shall bring them to ruin."},{"id":"semetey-1-2013:p0499:b003:l014","ordinal":114899,"en":"Leaving not one companion,"},{"id":"semetey-1-2013:p0499:b003:l015","ordinal":114900,"en":"I shall wipe them out!”"},{"id":"semetey-1-2013:p0499:b003:l016","ordinal":114901,"en":"Seething, his eyes clouded,"},{"id":"semetey-1-2013:p0499:b003:l017","ordinal":114902,"en":"He thrust his spear toward Syrgak."},{"id":"semetey-1-2013:p0499:b003:l018","ordinal":114903,"en":"His neck stretched like Mount Opol;"},{"id":"semetey-1-2013:p0499:b003:l019","ordinal":114904,"en":"As he came eagerly at Syrgak,"},{"id":"semetey-1-2013:p0499:b003:l020","ordinal":114905,"en":"The outstanding hero Almambet,"},{"id":"semetey-1-2013:p0499:b003:l021","ordinal":114906,"en":"Roaring the Prophet's name,"},{"id":"semetey-1-2013:p0499:b003:l022","ordinal":114907,"en":"Upon his horse Aisarala,"},{"id":"semetey-1-2013:p0499:b003:l023","ordinal":114908,"en":"Crying “Manas!” as his battle-cry,"},{"id":"semetey-1-2013:p0499:b003:l024","ordinal":114909,"en":"His waist bent far forward,"},{"id":"semetey-1-2013:p0499:b003:l025","ordinal":114910,"en":"His noble, blazing eyes"},{"id":"semetey-1-2013:p0499:b003:l026","ordinal":114911,"en":"Bulging, all but bursting out—"},{"id":"semetey-1-2013:p0499:b003:l027","ordinal":114912,"en":"Expert elder Almambet, the fortunate,"},{"id":"semetey-1-2013:p0499:b003:l028","ordinal":114913,"en":"Arrived before an arrow could."},{"id":"semetey-1-2013:p0499:b003:l029","ordinal":114914,"en":"From atop Kongkulboz,"},{"id":"semetey-1-2013:p0499:b003:l030","ordinal":114915,"en":"Almambet, reaching him,"},{"id":"semetey-1-2013:p0499:b003:l031","ordinal":114916,"en":"That warrior Közkaman"},{"id":"semetey-1-2013:p0499:b003:l032","ordinal":114917,"en":"Brought crashing down as he passed."},{"id":"semetey-1-2013:p0499:b003:l033","ordinal":114918,"en":"He who wore the blue lynx-fur cap,"},{"id":"semetey-1-2013:p0499:b003:l034","ordinal":114919,"en":"Who wielded the mottled blue shield,"},{"id":"semetey-1-2013:p0499:b003:l035","ordinal":114920,"en":"Who found the right word in a crisis,"},{"id":"semetey-1-2013:p0499:b003:l036","ordinal":114921,"en":"Who found sight in the darkest night,"},{"id":"semetey-1-2013:p0499:b003:l037","ordinal":114922,"en":"Lucky when sent out in front,"},{"id":"semetey-1-2013:p0499:b003:l038","ordinal":114923,"en":"Like countless troops when driving onward,"},{"id":"semetey-1-2013:p0499:b003:l039","ordinal":114924,"en":"My elder Bakai, the old man,"},{"id":"semetey-1-2013:p0499:b005:l001","ordinal":114925,"en":"Who had grappled in many places,"},{"id":"semetey-1-2013:p0499:b005:l002","ordinal":114926,"en":"The sage who knew the enemy's tricks,"},{"id":"semetey-1-2013:p0499:b005:l003","ordinal":114927,"en":"Lashed his gray steed once,"},{"id":"semetey-1-2013:p0499:b005:l004","ordinal":114928,"en":"Took the fearsome sword in hand;"},{"id":"semetey-1-2013:p0499:b005:l005","ordinal":114929,"en":"Your devastating elder, Khan Bakai,"},{"id":"semetey-1-2013:p0499:b005:l006","ordinal":114930,"en":"Reached Közkaman."},{"id":"semetey-1-2013:p0499:b005:l007","ordinal":114931,"en":"The panther, when he reached him,"},{"id":"semetey-1-2013:p0499:b005:l008","ordinal":114932,"en":"That very warrior Közkaman's"},{"id":"semetey-1-2013:p0499:b005:l009","ordinal":114933,"en":"Head he cut off as he passed."},{"id":"semetey-1-2013:p0499:b005:l010","ordinal":114934,"en":"Shrill cries, fierce cheering—"},{"id":"semetey-1-2013:p0499:b005:l011","ordinal":114935,"en":"Do not ask about the tale!"},{"id":"semetey-1-2013:p0499:b005:l012","ordinal":114936,"en":"The mighty warrior Kökchököz"},{"id":"semetey-1-2013:p0499:b005:l013","ordinal":114937,"en":"Lashed his blue rhinoceros:"},{"id":"semetey-1-2013:p0499:b005:l014","ordinal":114938,"en":"“They were merely half-Mongol dogs!"},{"id":"semetey-1-2013:p0499:b005:l015","ordinal":114939,"en":"Let me reach these Buruts,"},{"id":"semetey-1-2013:p0499:b005:l016","ordinal":114940,"en":"And of that strayed Chinese,"},{"id":"semetey-1-2013:p0499:b005:l017","ordinal":114941,"en":"Almambet, cut off the head."},{"id":"semetey-1-2013:p0499:b005:l018","ordinal":114942,"en":"Chubak, Bakai, Almambet—"},{"id":"semetey-1-2013:p0499:b005:l019","ordinal":114943,"en":"I shall throw them all into turmoil"},{"id":"semetey-1-2013:p0499:b005:l020","ordinal":114944,"en":"And wipe them out."}]
