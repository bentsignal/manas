{"id": "sayakbay-ms-current146:pdf072:l001", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 1, "raw": "Улук экен эр Кенен,", "text": "Улук экен эр Кенен,", "en": "The hero Kenen is a great man,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l002", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 2, "raw": "Куралган колу эң белен.", "text": "Куралган колу эң белен.", "en": "His assembled army stands fully ready.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l003", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 3, "raw": "Ала-Тоо арзан жер эмес,", "text": "Ала-Тоо арзан жер эмес,", "en": "Ala-Too is no land cheaply won,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l004", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 4, "raw": "Кан төгүшүп чырдашпай,", "text": "Кан төгүшүп чырдашпай,", "en": "Without shedding blood and entering strife,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l005", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 5, "raw": "Өпкө жарып кылдашпай,", "text": "Өпкө жарып кылдашпай,", "en": "Without splitting lungs and contending in battle,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 6, "raw": "Элин берчү неме эмес,", "text": "Элин берчү неме эмес,", "en": "He is not one who will surrender his people,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 7, "raw": "Эрдиги сенден чоң эмес,", "text": "Эрдиги сенден чоң эмес,", "en": "His valor is no greater than yours,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms or a material lexical variant from the printed continuation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 8, "raw": "Колдогону бир бөөк,", "text": "Колдогону бир бөөк,", "en": "A mighty spirit gives him aid,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms or a material lexical variant from the printed continuation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 9, "raw": "Кырк чилтен, кызыр чын жөлөк,", "text": "Кырк чилтен, кызыр чын жөлөк,", "en": "The forty saints and Khizr are his true support,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 10, "raw": "Бет алдында кез экен,", "text": "Бет алдында кез экен,", "en": "The destined hour stands before him,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms or a material lexical variant from the printed continuation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 11, "raw": "Берен эрдин бири экен,", "text": "Берен эрдин бири экен,", "en": "He is one of the valiant heroes,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 12, "raw": "Касиеттүү жан экен,", "text": "Касиеттүү жан экен,", "en": "He is a sacred soul,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l013", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 13, "raw": "Эгиз арстан эки шер,", "text": "Эгиз арстан эки шер,", "en": "Two twin lions, two champions,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 14, "raw": "Алым, Кулан Сарык деп,", "text": "Алым, Кулан Сарык деп,", "en": "Named Alym and Kulan Saryk,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms or a material lexical variant from the printed continuation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 15, "raw": "Арстан уулу бар экен.", "text": "Арстан уулу бар экен.", "en": "He has lion-hearted sons.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 16, "raw": "Кыр-кырынан карасам,", "text": "Кыр-кырынан карасам,", "en": "When I look from ridge to ridge,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 17, "raw": "Арзан Кенен уул эмес,", "text": "Арзан Кенен уул эмес,", "en": "Kenen is no cheaply valued son,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 18, "raw": "Олжо кылып опуруп,", "text": "Олжо кылып опуруп,", "en": "To seize him as booty and overwhelm him,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 19, "raw": "Оюн кылар жоо эмес,", "text": "Оюн кылар жоо эмес,", "en": "He is no enemy to make sport of,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 20, "raw": "Кырк уруунун эли эмес,", "text": "Кырк уруунун эли эмес,", "en": "They are not merely the people of forty clans,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 21, "raw": "Кырып, союп жиберген,", "text": "Кырып, союп жиберген,", "en": "To slaughter and cut them down,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 22, "raw": "Колундагы мен эмес.", "text": "Колундагы мен эмес.", "en": "I am not one held in his hand.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms or a material lexical variant from the printed continuation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 23, "raw": "Беттеп найза сунушсаң,", "text": "Беттеп найза сунушсаң,", "en": "If you face them and level your spear,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l024", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 24, "raw": "Белгилүү кан төгүшөт,", "text": "Белгилүү кан төгүшөт,", "en": "They will certainly spill blood,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 25, "raw": "Жекелешип кармашсаң,", "text": "Жекелешип кармашсаң,", "en": "If you grapple with them man to man,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 26, "raw": "Чама-чаркың көрүшөт.", "text": "Чама-чаркың көрүшөт.", "en": "They will test the measure of your strength.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 27, "raw": "Зордуктасаң урушат,", "text": "Зордуктасаң урушат,", "en": "If you oppress them, they will fight,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 28, "raw": "Атасы арстан эр кыргыз,", "text": "Атасы арстан эр кыргыз,", "en": "The Kyrgyz are heroes whose fathers were lions,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 29, "raw": "Чапчылашып жаңжал кылышат,", "text": "Чапчылашып жаңжал кылышат,", "en": "They strike back and raise a fierce quarrel,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms or a material lexical variant from the printed continuation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 30, "raw": "Ашуулуу тозок тоо ошол,", "text": "Ашуулуу тозок тоо ошол,", "en": "That is the pass-bound mountain of hell,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 31, "raw": "Өпкө жарып, баш кескен,", "text": "Өпкө жарып, баш кескен,", "en": "Splitting lungs and cutting off heads,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 32, "raw": "Өлчөсөң кыргыз жоо ошол.", "text": "Өлчөсөң кыргыз жоо ошол.", "en": "If you take their measure, the Kyrgyz are that foe.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 33, "raw": "Көк сулоосун берки бар,", "text": "Көк сулоосун берки бар,", "en": "On this side lies their blue-gray expanse,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms or a material lexical variant from the printed continuation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l034", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 34, "raw": "Көк аскар тоодой эрки бар,", "text": "Көк аскар тоодой эрки бар,", "en": "They possess freedom like a towering blue mountain,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms or a material lexical variant from the printed continuation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf072:l035", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 72, "folio": 455, "line_in_page": 35, "raw": "Кыргызда Кенен каны бар.", "text": "Кыргызда Кенен каны бар.", "en": "Among the Kyrgyz there is Khan Kenen.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
