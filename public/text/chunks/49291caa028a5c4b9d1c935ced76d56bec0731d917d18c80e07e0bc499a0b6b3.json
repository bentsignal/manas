[{"id":"semetey-1-2013:p1223:b003:l026","ordinal":169473,"en":"As khan of the Zhediger."},{"id":"semetey-1-2013:p1223:b003:l027","ordinal":169474,"en":"Toltoi has indeed known"},{"id":"semetey-1-2013:p1223:b003:l028","ordinal":169475,"en":"Seven years of suffering."},{"id":"semetey-1-2013:p1223:b003:l029","ordinal":169476,"en":"As a saint, Toltoi has indeed"},{"id":"semetey-1-2013:p1223:b003:l030","ordinal":169477,"en":"Known his appointed time!"},{"id":"semetey-1-2013:p1223:b003:l031","ordinal":169478,"en":"Hero Toltoi, my friend,"},{"id":"semetey-1-2013:p1223:b003:l032","ordinal":169479,"en":"If you will go, give me your answer;"},{"id":"semetey-1-2013:p1223:b003:l033","ordinal":169480,"en":"If you will not, tell me the truth."},{"id":"semetey-1-2013:p1223:b003:l034","ordinal":169481,"en":"I had thought you were a khan;"},{"id":"semetey-1-2013:p1223:b003:l035","ordinal":169482,"en":"Why should I go on relying upon you?"},{"id":"semetey-1-2013:p1223:b003:l036","ordinal":169483,"en":"I shall turn back to the people"},{"id":"semetey-1-2013:p1223:b003:l037","ordinal":169484,"en":"And now enter among"},{"id":"semetey-1-2013:p1223:b003:l038","ordinal":169485,"en":"The Argyn and Kyrgyz."},{"id":"semetey-1-2013:p1223:b003:l039","ordinal":169486,"en":"After that, accursed Toltoi,"},{"id":"semetey-1-2013:p1223:b004:l001","ordinal":169487,"en":"Stay where you are;"},{"id":"semetey-1-2013:p1223:b004:l002","ordinal":169488,"en":"Then I shall reach your very root."},{"id":"semetey-1-2013:p1223:b004:l003","ordinal":169489,"en":"If Semetey proves too numerous,"},{"id":"semetey-1-2013:p1223:b004:l004","ordinal":169490,"en":"I shall offer my Kara At as a gift."},{"id":"semetey-1-2013:p1223:b004:l005","ordinal":169491,"en":"I shall make peace and enter my people;"},{"id":"semetey-1-2013:p1223:b004:l006","ordinal":169492,"en":"Then, Toltoi, watch closely—"},{"id":"semetey-1-2013:p1223:b004:l007","ordinal":169493,"en":"Afterward I shall reach your root."},{"id":"semetey-1-2013:p1223:b004:l008","ordinal":169494,"en":"When I go and make peace,"},{"id":"semetey-1-2013:p1223:b004:l009","ordinal":169495,"en":"I shall take Khan Bakai;"},{"id":"semetey-1-2013:p1223:b004:l010","ordinal":169496,"en":"Then I shall bring slaughter"},{"id":"semetey-1-2013:p1223:b004:l011","ordinal":169497,"en":"Upon the Zhediger of Zheti-Özön."},{"id":"semetey-1-2013:p1223:b004:l012","ordinal":169498,"en":"I shall make Kanchoro my companion,"},{"id":"semetey-1-2013:p1223:b004:l013","ordinal":169499,"en":"Engulf you from above,"},{"id":"semetey-1-2013:p1223:b004:l014","ordinal":169500,"en":"And scatter your four kinds of livestock."},{"id":"semetey-1-2013:p1223:b004:l015","ordinal":169501,"en":"If you will go, tell me the truth;"},{"id":"semetey-1-2013:p1223:b004:l016","ordinal":169502,"en":"If you will not, tell me that!\""},{"id":"semetey-1-2013:p1223:b004:l017","ordinal":169503,"en":"Kojo stood seething,"},{"id":"semetey-1-2013:p1223:b004:l018","ordinal":169504,"en":"Speaking as though he would devour"},{"id":"semetey-1-2013:p1223:b004:l019","ordinal":169505,"en":"Toltoi of the Zhediger."},{"id":"semetey-1-2013:p1223:b004:l020","ordinal":169506,"en":"At that moment hero Toltoi,"},{"id":"semetey-1-2013:p1223:b004:l021","ordinal":169507,"en":"Grumbling helplessly,"},{"id":"semetey-1-2013:p1223:b004:l022","ordinal":169508,"en":"Was about to go"},{"id":"semetey-1-2013:p1223:b004:l023","ordinal":169509,"en":"To Khan Akun's city."},{"id":"semetey-1-2013:p1223:b004:l024","ordinal":169510,"en":"Through the calamity"},{"id":"semetey-1-2013:p1223:b004:l025","ordinal":169511,"en":"Of wrathful Kojo,"},{"id":"semetey-1-2013:p1223:b004:l026","ordinal":169512,"en":"Hero Toltoi was about to remain there."},{"id":"semetey-1-2013:p1223:b004:l027","ordinal":169513,"en":"Toltoi of the Zhediger,"},{"id":"semetey-1-2013:p1223:b004:l028","ordinal":169514,"en":"With his great army that bent the earth,"},{"id":"semetey-1-2013:p1223:b004:l029","ordinal":169515,"en":"Could, when angered,"},{"id":"semetey-1-2013:p1223:b004:l030","ordinal":169516,"en":"Utterly engulf the Afghans."},{"id":"semetey-1-2013:p1223:b004:l031","ordinal":169517,"en":"Dear Toltoi could reach"},{"id":"semetey-1-2013:p1223:b004:l032","ordinal":169518,"en":"The very root of whoever challenged him."},{"id":"semetey-1-2013:p1223:b004:l033","ordinal":169519,"en":"Was hero Toltoi not"},{"id":"semetey-1-2013:p1223:b004:l034","ordinal":169520,"en":"The accomplished khan of the Zhediger?"},{"id":"semetey-1-2013:p1223:b004:l035","ordinal":169521,"en":"Did hero Toltoi not possess"},{"id":"semetey-1-2013:p1223:b004:l036","ordinal":169522,"en":"Great courage within him?"},{"id":"semetey-1-2013:p1223:b004:l037","ordinal":169523,"en":"Surkoyon, touched by angels,"},{"id":"semetey-1-2013:p1223:b004:l038","ordinal":169524,"en":"Whom he had saddled five times over,"},{"id":"semetey-1-2013:p1223:b004:l039","ordinal":169525,"en":"Could not be caught at a blink,"},{"id":"semetey-1-2013:p1224:b003:l001","ordinal":169526,"en":"No beast could match him in a race."},{"id":"semetey-1-2013:p1224:b003:l002","ordinal":169527,"en":"With a camel-stallion forelock and low mane,"},{"id":"semetey-1-2013:p1224:b003:l003","ordinal":169528,"en":"His swiftness was plain;"},{"id":"semetey-1-2013:p1224:b003:l004","ordinal":169529,"en":"When tethered, he pulled the post"},{"id":"semetey-1-2013:p1224:b003:l005","ordinal":169530,"en":"Over with its head."},{"id":"semetey-1-2013:p1224:b003:l006","ordinal":169531,"en":"His muscles were like a bull's back,"},{"id":"semetey-1-2013:p1224:b003:l007","ordinal":169532,"en":"And his gait like the wind of the steppe."},{"id":"semetey-1-2013:p1224:b003:l008","ordinal":169533,"en":"His eyes shone like an argali's;"},{"id":"semetey-1-2013:p1224:b003:l009","ordinal":169534,"en":"When he ran at full stride,"},{"id":"semetey-1-2013:p1224:b003:l010","ordinal":169535,"en":"No horse could keep pace."},{"id":"semetey-1-2013:p1224:b003:l011","ordinal":169536,"en":"Hero Toltoi's Surkoyon"},{"id":"semetey-1-2013:p1224:b003:l012","ordinal":169537,"en":"Never tired when ridden scouting,"},{"id":"semetey-1-2013:p1224:b003:l013","ordinal":169538,"en":"Nor suffered when ridden with the baggage train;"},{"id":"semetey-1-2013:p1224:b003:l014","ordinal":169539,"en":"He did not weary if ridden six months."},{"id":"semetey-1-2013:p1224:b003:l015","ordinal":169540,"en":"That surpassing swift thoroughbred,"},{"id":"semetey-1-2013:p1224:b003:l016","ordinal":169541,"en":"Until he reached sixty years,"},{"id":"semetey-1-2013:p1224:b003:l017","ordinal":169542,"en":"Would not age or loosen his fangs."},{"id":"semetey-1-2013:p1224:b003:l018","ordinal":169543,"en":"To go as a bridegroom,"},{"id":"semetey-1-2013:p1224:b003:l019","ordinal":169544,"en":"To raid the Afghan city,"},{"id":"semetey-1-2013:p1224:b003:l020","ordinal":169545,"en":"To eat meat from one platter"},{"id":"semetey-1-2013:p1224:b003:l021","ordinal":169546,"en":"And face one another upon one bed,"},{"id":"semetey-1-2013:p1224:b003:l022","ordinal":169547,"en":"If Chürök proved kind,"},{"id":"semetey-1-2013:p1224:b003:l023","ordinal":169548,"en":"To weigh out gold by the foot"},{"id":"semetey-1-2013:p1224:b003:l024","ordinal":169549,"en":"And give it as the sister-in-law's fee;"},{"id":"semetey-1-2013:p1224:b003:l025","ordinal":169550,"en":"If Chürök proved cruel,"},{"id":"semetey-1-2013:p1224:b003:l026","ordinal":169551,"en":"He was about to enter the upheaval."},{"id":"semetey-1-2013:p1224:b003:l027","ordinal":169552,"en":"Toltoi's ninety youths"},{"id":"semetey-1-2013:p1224:b003:l028","ordinal":169553,"en":"Were skillful spearmen,"},{"id":"semetey-1-2013:p1224:b003:l029","ordinal":169554,"en":"Champions who knew without mercy"},{"id":"semetey-1-2013:p1224:b003:l030","ordinal":169555,"en":"The enemy's stratagems."},{"id":"semetey-1-2013:p1224:b003:l031","ordinal":169556,"en":"When a black gun cracked,"},{"id":"semetey-1-2013:p1224:b003:l032","ordinal":169557,"en":"They were heroes who did not flee;"},{"id":"semetey-1-2013:p1224:b003:l033","ordinal":169558,"en":"When a fierce gun snapped,"},{"id":"semetey-1-2013:p1224:b003:l034","ordinal":169559,"en":"They were heroes who did not start."},{"id":"semetey-1-2013:p1224:b003:l035","ordinal":169560,"en":"Hero Toltoi's Surkoyon"},{"id":"semetey-1-2013:p1224:b003:l036","ordinal":169561,"en":"Was fed rice and rice-chaff,"},{"id":"semetey-1-2013:p1224:b003:l037","ordinal":169562,"en":"And had his sweat drawn every day;"},{"id":"semetey-1-2013:p1224:b003:l038","ordinal":169563,"en":"He was fed his fill of barley,"},{"id":"semetey-1-2013:p1224:b003:l039","ordinal":169564,"en":"And had his sweat drawn every month."},{"id":"semetey-1-2013:p1224:b004:l001","ordinal":169565,"en":"He raced with birds in flight;"},{"id":"semetey-1-2013:p1224:b004:l002","ordinal":169566,"en":"Hero Toltoi's Surkoyon,"},{"id":"semetey-1-2013:p1224:b004:l003","ordinal":169567,"en":"His flank-flesh that would yield rump-fat"},{"id":"semetey-1-2013:p1224:b004:l004","ordinal":169568,"en":"Clung close to the ribs."},{"id":"semetey-1-2013:p1224:b004:l005","ordinal":169569,"en":"At the sight of a shape, he darted;"},{"id":"semetey-1-2013:p1224:b004:l006","ordinal":169570,"en":"When Surkoyon saw a figure,"},{"id":"semetey-1-2013:p1224:b004:l007","ordinal":169571,"en":"At a bird's flight, he started."},{"id":"semetey-1-2013:p1224:b004:l008","ordinal":169572,"en":"Then Toltoi grew excited;"},{"id":"semetey-1-2013:p1224:b004:l009","ordinal":169573,"en":"The dear hero grew wrathful"},{"id":"semetey-1-2013:p1224:b004:l010","ordinal":169574,"en":"And spoke to the Zhediger:"},{"id":"semetey-1-2013:p1224:b004:l011","ordinal":169575,"en":"\"If I go today, I shall die;"},{"id":"semetey-1-2013:p1224:b004:l012","ordinal":169576,"en":"Great Black Zhediger,"},{"id":"semetey-1-2013:p1224:b004:l013","ordinal":169577,"en":"I shall behold the face of the other world."},{"id":"semetey-1-2013:p1224:b004:l014","ordinal":169578,"en":"I have left; now I shall not prosper,"},{"id":"semetey-1-2013:p1224:b004:l015","ordinal":169579,"en":"Nor return alive and well!\""},{"id":"semetey-1-2013:p1224:b004:l016","ordinal":169580,"en":"Surkoyon, saddled five times over,"},{"id":"semetey-1-2013:p1224:b004:l017","ordinal":169581,"en":"Chewed a bit of steel,"},{"id":"semetey-1-2013:p1224:b004:l018","ordinal":169582,"en":"His eyes shining like a camel calf's."},{"id":"semetey-1-2013:p1224:b004:l019","ordinal":169583,"en":"The afflicted courser Surkoyon"},{"id":"semetey-1-2013:p1224:b004:l020","ordinal":169584,"en":"He saddled unsparingly"},{"id":"semetey-1-2013:p1224:b004:l021","ordinal":169585,"en":"With a bearskin saddlecloth and white felt pad,"},{"id":"semetey-1-2013:p1224:b004:l022","ordinal":169586,"en":"Warning the great Black Zhediger,"},{"id":"semetey-1-2013:p1224:b004:l023","ordinal":169587,"en":"\"I shall not return!\""},{"id":"semetey-1-2013:p1224:b004:l024","ordinal":169588,"en":"He drew the rear girth tight"},{"id":"semetey-1-2013:p1224:b004:l025","ordinal":169589,"en":"On the courser Surkoyon,"},{"id":"semetey-1-2013:p1224:b004:l026","ordinal":169590,"en":"And shortened the crupper."},{"id":"semetey-1-2013:p1224:b004:l027","ordinal":169591,"en":"Having made Surkoyon ready,"},{"id":"semetey-1-2013:p1224:b004:l028","ordinal":169592,"en":"Zheldet brought him;"},{"id":"semetey-1-2013:p1224:b004:l029","ordinal":169593,"en":"Lion Toltoi saw"},{"id":"semetey-1-2013:p1224:b004:l030","ordinal":169594,"en":"That his horse was prepared."},{"id":"semetey-1-2013:p1224:b004:l031","ordinal":169595,"en":"He put on twelve layers"},{"id":"semetey-1-2013:p1224:b004:l032","ordinal":169596,"en":"Of his bulletproof coat."},{"id":"semetey-1-2013:p1224:b004:l033","ordinal":169597,"en":"He placed a blue-iron helmet"},{"id":"semetey-1-2013:p1224:b004:l034","ordinal":169598,"en":"Upside down upon his head;"},{"id":"semetey-1-2013:p1224:b004:l035","ordinal":169599,"en":"What could dear Toltoi do?"},{"id":"semetey-1-2013:p1224:b004:l036","ordinal":169600,"en":"He donned the ribbed mail armor,*"},{"id":"semetey-1-2013:p1224:b004:l037","ordinal":169601,"en":"Put on iron from head to foot,"},{"id":"semetey-1-2013:p1224:b004:l038","ordinal":169602,"en":"Buttoning it over his whole body,"},{"id":"semetey-1-2013:p1224:b004:l039","ordinal":169603,"en":"And covered all his broad face"},{"id":"semetey-1-2013:p1225:b003:l001","ordinal":169604,"en":"With blue iron."},{"id":"semetey-1-2013:p1225:b003:l002","ordinal":169605,"en":"Adorned and splendidly arrayed,"},{"id":"semetey-1-2013:p1225:b003:l003","ordinal":169606,"en":"What did valiant Toltoi do?"},{"id":"semetey-1-2013:p1225:b003:l004","ordinal":169607,"en":"He swayed as though struck from this side,"},{"id":"semetey-1-2013:p1225:b003:l005","ordinal":169608,"en":"Roaring in his wrath;"},{"id":"semetey-1-2013:p1225:b003:l006","ordinal":169609,"en":"Dear Toltoi thundered,"},{"id":"semetey-1-2013:p1225:b003:l007","ordinal":169610,"en":"Growling in excitement,"},{"id":"semetey-1-2013:p1225:b003:l008","ordinal":169611,"en":"And spoke to the Zhediger:"},{"id":"semetey-1-2013:p1225:b003:l009","ordinal":169612,"en":"\"Is there anything better than a dog's drink?"},{"id":"semetey-1-2013:p1225:b003:l010","ordinal":169613,"en":"They say vodka is nourishment;"},{"id":"semetey-1-2013:p1225:b003:l011","ordinal":169614,"en":"Let me drink that vodka"},{"id":"semetey-1-2013:p1225:b003:l012","ordinal":169615,"en":"And ride shouting against the enemy."},{"id":"semetey-1-2013:p1225:b003:l013","ordinal":169616,"en":"If my death has come, let me die;"},{"id":"semetey-1-2013:p1225:b003:l014","ordinal":169617,"en":"Whatever command Allah has laid down,"},{"id":"semetey-1-2013:p1225:b003:l015","ordinal":169618,"en":"Let me meet it."},{"id":"semetey-1-2013:p1225:b003:l016","ordinal":169619,"en":"Black vodka in the Kalmak fashion,"},{"id":"semetey-1-2013:p1225:b003:l017","ordinal":169620,"en":"One leather flask of vodka—"},{"id":"semetey-1-2013:p1225:b003:l018","ordinal":169621,"en":"Saying, 'Pour out that dog-drink,'"},{"id":"semetey-1-2013:p1225:b003:l019","ordinal":169622,"en":"They poured him the vodka."},{"id":"semetey-1-2013:p1225:b003:l020","ordinal":169623,"en":"He struck down four bowls of vodka"},{"id":"semetey-1-2013:p1225:b003:l021","ordinal":169624,"en":"One after another."},{"id":"semetey-1-2013:p1225:b003:l022","ordinal":169625,"en":"Drinking vodka, he grew excited,"},{"id":"semetey-1-2013:p1225:b003:l023","ordinal":169626,"en":"Not knowing that he himself would die;"},{"id":"semetey-1-2013:p1225:b003:l024","ordinal":169627,"en":"He cursed without pause"},{"id":"semetey-1-2013:p1225:b003:l025","ordinal":169628,"en":"Both the Zhediger and Kojo."},{"id":"semetey-1-2013:p1225:b004:l001","ordinal":169629,"en":"He girded on his unsheathed sword;"},{"id":"semetey-1-2013:p1225:b004:l002","ordinal":169630,"en":"Like a cloud about to rain again,"},{"id":"semetey-1-2013:p1225:b004:l003","ordinal":169631,"en":"Wrath spread across his face."},{"id":"semetey-1-2013:p1225:b004:l004","ordinal":169632,"en":"The sight arrested the heart;"},{"id":"semetey-1-2013:p1225:b004:l005","ordinal":169633,"en":"Toltoi grew wrathful,"},{"id":"semetey-1-2013:p1225:b004:l006","ordinal":169634,"en":"And anger poured from his mouth."},{"id":"semetey-1-2013:p1225:b004:l007","ordinal":169635,"en":"When your Toltoi showed his true nature,"},{"id":"semetey-1-2013:p1225:b004:l008","ordinal":169636,"en":"He was like taut red iron;"},{"id":"semetey-1-2013:p1225:b004:l009","ordinal":169637,"en":"When Khan Toltoi grew angry,"},{"id":"semetey-1-2013:p1225:b004:l010","ordinal":169638,"en":"His bulk equaled half a mountain."},{"id":"semetey-1-2013:p1225:b004:l011","ordinal":169639,"en":"He took a blue-mottled spear in hand,"},{"id":"semetey-1-2013:p1225:b004:l012","ordinal":169640,"en":"Slung a short blue gun,"},{"id":"semetey-1-2013:p1225:b004:l013","ordinal":169641,"en":"And his war gear stood out;"},{"id":"semetey-1-2013:p1225:b004:l014","ordinal":169642,"en":"He loomed like Opol-Too,"},{"id":"semetey-1-2013:p1225:b004:l015","ordinal":169643,"en":"Overcoming the hearts of all who saw."},{"id":"semetey-1-2013:p1225:b004:l016","ordinal":169644,"en":"To raid the Afghan city,"},{"id":"semetey-1-2013:p1225:b004:l017","ordinal":169645,"en":"To go as bridegroom"},{"id":"semetey-1-2013:p1225:b004:l018","ordinal":169646,"en":"For Akun's daughter Aichürök,"},{"id":"semetey-1-2013:p1225:b004:l019","ordinal":169647,"en":"Dear Toltoi then"},{"id":"semetey-1-2013:p1225:b004:l020","ordinal":169648,"en":"Loomed like Opol-Too."},{"id":"semetey-1-2013:p1225:b004:l021","ordinal":169649,"en":"Roaring in his wrath"},{"id":"semetey-1-2013:p1225:b004:l022","ordinal":169650,"en":"And gathering himself like a blue tiger,"},{"id":"semetey-1-2013:p1225:b004:l023","ordinal":169651,"en":"As the sun was sinking low"},{"id":"semetey-1-2013:p1225:b004:l024","ordinal":169652,"en":"And the people lay down,"},{"id":"semetey-1-2013:p1225:b004:l025","ordinal":169653,"en":"Dear Toltoi mounted his horse."},{"id":"semetey-1-2013:p1225:b006:l001","ordinal":169654,"en":"Tölök and Tölöbai"},{"id":"semetey-1-2013:p1225:b006:l002","ordinal":169655,"en":"Both shouted out"},{"id":"semetey-1-2013:p1225:b006:l003","ordinal":169656,"en":"To remain and give their blessing."},{"id":"semetey-1-2013:p1225:b006:l004","ordinal":169657,"en":"They called to Toltoi of the Zhediger,"},{"id":"semetey-1-2013:p1225:b006:l005","ordinal":169658,"en":"\"Wait a while!\""},{"id":"semetey-1-2013:p1225:b006:l006","ordinal":169659,"en":"When they called, Toltoi cursed them:"},{"id":"semetey-1-2013:p1225:b006:l007","ordinal":169660,"en":"\"Tölök and Tölöbai,"},{"id":"semetey-1-2013:p1225:b006:l008","ordinal":169661,"en":"May you sink into the earth with your blessing!"},{"id":"semetey-1-2013:p1225:b006:l009","ordinal":169662,"en":"I now go to meet"},{"id":"semetey-1-2013:p1225:b008:l001","ordinal":169663,"en":"What fate has laid down;"},{"id":"semetey-1-2013:p1225:b008:l002","ordinal":169664,"en":"Even if you give a thousand blessings,"},{"id":"semetey-1-2013:p1225:b008:l003","ordinal":169665,"en":"I go to die."},{"id":"semetey-1-2013:p1225:b008:l004","ordinal":169666,"en":"If I go today, I shall not prosper;"},{"id":"semetey-1-2013:p1225:b008:l005","ordinal":169667,"en":"Look closely—I shall not survive today."},{"id":"semetey-1-2013:p1225:b008:l006","ordinal":169668,"en":"Give your heart or withhold your heart;"},{"id":"semetey-1-2013:p1225:b008:l007","ordinal":169669,"en":"Let me behold humiliation in full,"},{"id":"semetey-1-2013:p1225:b008:l008","ordinal":169670,"en":"And die when death reaches me."},{"id":"semetey-1-2013:p1225:b008:l009","ordinal":169671,"en":"Challenging a lion blessed by Khizr,"},{"id":"semetey-1-2013:p1226:b003:l001","ordinal":169672,"en":"Will any man remain alive?"},{"id":"semetey-1-2013:p1226:b003:l002","ordinal":169673,"en":"O black-bearded men, this is a distant road;"},{"id":"semetey-1-2013:p1226:b003:l003","ordinal":169674,"en":"Will I die without returning?"},{"id":"semetey-1-2013:p1226:b003:l004","ordinal":169675,"en":"Farewell, my dear people!"},{"id":"semetey-1-2013:p1226:b003:l005","ordinal":169676,"en":"God knows whether one dies;"},{"id":"semetey-1-2013:p1226:b003:l006","ordinal":169677,"en":"God knows whether your Toltoi"},{"id":"semetey-1-2013:p1226:b003:l007","ordinal":169678,"en":"Will return to you alive!\""},{"id":"semetey-1-2013:p1226:b003:l008","ordinal":169679,"en":"Hero Toltoi spoke of"},{"id":"semetey-1-2013:p1226:b003:l009","ordinal":169680,"en":"A fatal calamity,"},{"id":"semetey-1-2013:p1226:b003:l010","ordinal":169681,"en":"Pouring himself recklessly into drink;"},{"id":"semetey-1-2013:p1226:b003:l011","ordinal":169682,"en":"Hero Toltoi raised the uproar."},{"id":"semetey-1-2013:p1226:b003:l012","ordinal":169683,"en":"He raced upon his gray horse;"},{"id":"semetey-1-2013:p1226:b003:l013","ordinal":169684,"en":"Sultan Toltoi spurred forward,"},{"id":"semetey-1-2013:p1226:b003:l014","ordinal":169685,"en":"The earth splitting in a mirage,"},{"id":"semetey-1-2013:p1226:b003:l015","ordinal":169686,"en":"And Toltoi drew near"},{"id":"semetey-1-2013:p1226:b003:l016","ordinal":169687,"en":"The city of broad Afghanistan."},{"id":"semetey-1-2013:p1226:b003:l017","ordinal":169688,"en":"Was he not capable Toltoi,"},{"id":"semetey-1-2013:p1226:b003:l018","ordinal":169689,"en":"Who knew much of the whole world?"},{"id":"semetey-1-2013:p1226:b003:l019","ordinal":169690,"en":"Was he not renowned Toltoi,"},{"id":"semetey-1-2013:p1226:b003:l020","ordinal":169691,"en":"Who knew perfectly what was and was not?"},{"id":"semetey-1-2013:p1226:b003:l021","ordinal":169692,"en":"Was Toltoi not exceedingly"},{"id":"semetey-1-2013:p1226:b003:l022","ordinal":169693,"en":"Skillful among spearmen?"},{"id":"semetey-1-2013:p1226:b003:l023","ordinal":169694,"en":"When his company stood complete,"},{"id":"semetey-1-2013:p1226:b003:l024","ordinal":169695,"en":"Was Toltoi not the foremost champion"},{"id":"semetey-1-2013:p1226:b003:l025","ordinal":169696,"en":"At breaking enemy ranks?"},{"id":"semetey-1-2013:p1226:b003:l026","ordinal":169697,"en":"He reconnoitered the capable road"},{"id":"semetey-1-2013:p1226:b003:l027","ordinal":169698,"en":"Leading to Kashgar;"},{"id":"semetey-1-2013:p1226:b003:l028","ordinal":169699,"en":"Finding no track there,"},{"id":"semetey-1-2013:p1226:b003:l029","ordinal":169700,"en":"He turned back again."},{"id":"semetey-1-2013:p1226:b003:l030","ordinal":169701,"en":"He reconnoitered the direct road"},{"id":"semetey-1-2013:p1226:b003:l031","ordinal":169702,"en":"Leading to Turpan;"},{"id":"semetey-1-2013:p1226:b003:l032","ordinal":169703,"en":"Unable to find a track there,"},{"id":"semetey-1-2013:p1226:b003:l033","ordinal":169704,"en":"He turned back again."},{"id":"semetey-1-2013:p1226:b003:l034","ordinal":169705,"en":"He reconnoitered the safe road"},{"id":"semetey-1-2013:p1226:b003:l035","ordinal":169706,"en":"Leading to Beijing;"},{"id":"semetey-1-2013:p1226:b003:l036","ordinal":169707,"en":"Finding no track there,"},{"id":"semetey-1-2013:p1226:b003:l037","ordinal":169708,"en":"He turned back again."},{"id":"semetey-1-2013:p1226:b003:l038","ordinal":169709,"en":"The winding road of Toguz-Zhol,"},{"id":"semetey-1-2013:p1226:b003:l039","ordinal":169710,"en":"The trail of wolf and sheep,"},{"id":"semetey-1-2013:p1226:b004:l001","ordinal":169711,"en":"The side-road leading to Andizhan—"},{"id":"semetey-1-2013:p1226:b004:l002","ordinal":169712,"en":"He reconnoitered that road;"},{"id":"semetey-1-2013:p1226:b004:l003","ordinal":169713,"en":"Finding no track there,"},{"id":"semetey-1-2013:p1226:b004:l004","ordinal":169714,"en":"He turned back again."},{"id":"semetey-1-2013:p1226:b004:l005","ordinal":169715,"en":"The woeful road entering Koton,"},{"id":"semetey-1-2013:p1226:b004:l006","ordinal":169716,"en":"The seven roads sinking into the earth—"},{"id":"semetey-1-2013:p1226:b004:l007","ordinal":169717,"en":"He reached and reconnoitered them;"},{"id":"semetey-1-2013:p1226:b004:l008","ordinal":169718,"en":"Finding no track there,"},{"id":"semetey-1-2013:p1226:b004:l009","ordinal":169719,"en":"He turned back again."},{"id":"semetey-1-2013:p1226:b004:l010","ordinal":169720,"en":"Echoing Zhar-Kyya,"},{"id":"semetey-1-2013:p1226:b004:l011","ordinal":169721,"en":"Where a single horse-track wound on—"},{"id":"semetey-1-2013:p1226:b004:l012","ordinal":169722,"en":"That was the road to Talas."},{"id":"semetey-1-2013:p1226:b004:l013","ordinal":169723,"en":"Those who knew would know it;"},{"id":"semetey-1-2013:p1226:b004:l014","ordinal":169724,"en":"All who did not know"},{"id":"semetey-1-2013:p1226:b004:l015","ordinal":169725,"en":"Would follow the former road."},{"id":"semetey-1-2013:p1226:b004:l016","ordinal":169726,"en":"When he came to that road,"},{"id":"semetey-1-2013:p1226:b004:l017","ordinal":169727,"en":"A whirlwind spun;"},{"id":"semetey-1-2013:p1226:b004:l018","ordinal":169728,"en":"The black road lay under a curse."}]
