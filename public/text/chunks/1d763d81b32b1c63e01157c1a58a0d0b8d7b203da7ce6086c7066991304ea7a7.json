[{"id":"semetey-1-2013:p1089:b003:l038","ordinal":160257,"en":"He had exactly five hundred prepared."},{"id":"semetey-1-2013:p1089:b003:l039","ordinal":160258,"en":"The treasury doors opened,"},{"id":"semetey-1-2013:p1089:b005:l001","ordinal":160259,"en":"And Kökötöy's countless riches"},{"id":"semetey-1-2013:p1089:b005:l002","ordinal":160260,"en":"Were squandered and scattered"},{"id":"semetey-1-2013:p1089:b005:l003","ordinal":160261,"en":"At his mourning feast."},{"id":"semetey-1-2013:p1089:b005:l004","ordinal":160262,"en":"Khan Kökötöy's resting place,"},{"id":"semetey-1-2013:p1089:b005:l005","ordinal":160263,"en":"His grave, was dug apart."},{"id":"semetey-1-2013:p1089:b005:l006","ordinal":160264,"en":"From champions who wielded spades"},{"id":"semetey-1-2013:p1089:b005:l007","ordinal":160265,"en":"And stalwarts who wielded mattocks,"},{"id":"semetey-1-2013:p1089:b005:l008","ordinal":160266,"en":"He summoned them all without exception"},{"id":"semetey-1-2013:p1089:b005:l009","ordinal":160267,"en":"From Kokon and Samarkan,"},{"id":"semetey-1-2013:p1089:b005:l010","ordinal":160268,"en":"And brought grave-digging champions"},{"id":"semetey-1-2013:p1089:b005:l011","ordinal":160269,"en":"From among them."},{"id":"semetey-1-2013:p1089:b005:l012","ordinal":160270,"en":"They dug his resting chamber evenly,"},{"id":"semetey-1-2013:p1089:b005:l013","ordinal":160271,"en":"Dug it broad in proper measure,"},{"id":"semetey-1-2013:p1089:b005:l014","ordinal":160272,"en":"Dug it perfectly balanced,"},{"id":"semetey-1-2013:p1089:b005:l015","ordinal":160273,"en":"Leveled it and dug it all large."},{"id":"semetey-1-2013:p1089:b005:l016","ordinal":160274,"en":"He had its burial niche hollowed,"},{"id":"semetey-1-2013:p1089:b005:l017","ordinal":160275,"en":"And had it extended from head to foot."},{"id":"semetey-1-2013:p1089:b005:l018","ordinal":160276,"en":"So that it would remain bright"},{"id":"semetey-1-2013:p1089:b005:l019","ordinal":160277,"en":"Until the end of time,"},{"id":"semetey-1-2013:p1089:b005:l020","ordinal":160278,"en":"He had garnet and ruby"},{"id":"semetey-1-2013:p1089:b005:l021","ordinal":160279,"en":"Split open,"},{"id":"semetey-1-2013:p1089:b005:l022","ordinal":160280,"en":"And had lights set"},{"id":"semetey-1-2013:p1089:b005:l023","ordinal":160281,"en":"At his feet and head."},{"id":"semetey-1-2013:p1089:b005:l024","ordinal":160282,"en":"\"Khan Kökötöy has died,\" they said,"},{"id":"semetey-1-2013:p1089:b005:l025","ordinal":160283,"en":"Making it known to the people."},{"id":"semetey-1-2013:p1089:b005:l026","ordinal":160284,"en":"Saying, \"These are the khan's wives,\""},{"id":"semetey-1-2013:p1089:b005:l027","ordinal":160285,"en":"They dressed all seven wives"},{"id":"semetey-1-2013:p1089:b005:l028","ordinal":160286,"en":"In billowing black garments."},{"id":"semetey-1-2013:p1089:b005:l029","ordinal":160287,"en":"When this Kökötöy died,"},{"id":"semetey-1-2013:p1089:b005:l030","ordinal":160288,"en":"People gathered in a mass;"},{"id":"semetey-1-2013:p1089:b005:l031","ordinal":160289,"en":"All the countless giants"},{"id":"semetey-1-2013:p1089:b005:l032","ordinal":160290,"en":"Heaped the earth upon him."},{"id":"semetey-1-2013:p1089:b005:l033","ordinal":160291,"en":"\"Khan Kökötöy has died,\""},{"id":"semetey-1-2013:p1089:b005:l034","ordinal":160292,"en":"\"The dear man has seen"},{"id":"semetey-1-2013:p1089:b005:l035","ordinal":160293,"en":"The true abode from which none return.\""},{"id":"semetey-1-2013:p1089:b005:l036","ordinal":160294,"en":"Kökötöy's Bokmurun"},{"id":"semetey-1-2013:p1089:b005:l037","ordinal":160295,"en":"Wept without opening his eyes:"},{"id":"semetey-1-2013:p1089:b005:l038","ordinal":160296,"en":"\"My valiant father has passed away,"},{"id":"semetey-1-2013:p1089:b005:l039","ordinal":160297,"en":"To the place from which none return;"},{"id":"semetey-1-2013:p1090:b003:l001","ordinal":160298,"en":"My sovereign father has gone,\""},{"id":"semetey-1-2013:p1090:b003:l002","ordinal":160299,"en":"\"This is the moment he vanished from sight."},{"id":"semetey-1-2013:p1090:b003:l003","ordinal":160300,"en":"My father Kökötöy—"},{"id":"semetey-1-2013:p1090:b003:l004","ordinal":160301,"en":"People, here above the grave"},{"id":"semetey-1-2013:p1090:b003:l005","ordinal":160302,"en":"Is your last meeting with him."},{"id":"semetey-1-2013:p1090:b003:l006","ordinal":160303,"en":"Five hundred young camels and five hundred mares"},{"id":"semetey-1-2013:p1090:b003:l007","ordinal":160304,"en":"Today, for my lordly father,"},{"id":"semetey-1-2013:p1090:b003:l008","ordinal":160305,"en":"I shall offer as grave prizes."},{"id":"semetey-1-2013:p1090:b003:l009","ordinal":160306,"en":"Now that my dear father has passed,"},{"id":"semetey-1-2013:p1090:b003:l010","ordinal":160307,"en":"How shall I hold his feast?"},{"id":"semetey-1-2013:p1090:b003:l011","ordinal":160308,"en":"How shall I race the horses?"},{"id":"semetey-1-2013:p1090:b003:l012","ordinal":160309,"en":"I put the matter before you."},{"id":"semetey-1-2013:p1090:b003:l013","ordinal":160310,"en":"All the mighty champions are here;"},{"id":"semetey-1-2013:p1090:b003:l014","ordinal":160311,"en":"I shall take counsel.\""},{"id":"semetey-1-2013:p1090:b003:l015","ordinal":160312,"en":"I myself was right there then,"},{"id":"semetey-1-2013:p1090:b003:l016","ordinal":160313,"en":"At Kökötöy's feast;"},{"id":"semetey-1-2013:p1090:b003:l017","ordinal":160314,"en":"My gray-wolf father, hero Bagysh,"},{"id":"semetey-1-2013:p1090:b003:l018","ordinal":160315,"en":"Was present at the summons."},{"id":"semetey-1-2013:p1090:b003:l019","ordinal":160316,"en":"If you ask how I was then,"},{"id":"semetey-1-2013:p1090:b003:l020","ordinal":160317,"en":"My father, hero Bagysh,"},{"id":"semetey-1-2013:p1090:b003:l021","ordinal":160318,"en":"Mounted me on a bay-piebald pacer,"},{"id":"semetey-1-2013:p1090:b003:l022","ordinal":160319,"en":"Dressed me in a silk coat,"},{"id":"semetey-1-2013:p1090:b003:l023","ordinal":160320,"en":"And led me about the feast."},{"id":"semetey-1-2013:p1090:b003:l024","ordinal":160321,"en":"He mounted me on a pale-piebald pacer,"},{"id":"semetey-1-2013:p1090:b003:l025","ordinal":160322,"en":"Dressed me in garments of precious cloth,"},{"id":"semetey-1-2013:p1090:b003:l026","ordinal":160323,"en":"And led me about the feast."},{"id":"semetey-1-2013:p1090:b003:l027","ordinal":160324,"en":"My poor head had not yet"},{"id":"semetey-1-2013:p1090:b003:l028","ordinal":160325,"en":"Risen above the saddle's fork;"},{"id":"semetey-1-2013:p1090:b003:l029","ordinal":160326,"en":"At that time my age"},{"id":"semetey-1-2013:p1090:b003:l030","ordinal":160327,"en":"Had not yet passed six."},{"id":"semetey-1-2013:p1090:b003:l031","ordinal":160328,"en":"I saw how Kökötöy's"},{"id":"semetey-1-2013:p1090:b003:l032","ordinal":160329,"en":"Vast riches overflowed;"},{"id":"semetey-1-2013:p1090:b003:l033","ordinal":160330,"en":"I saw many people take plunder"},{"id":"semetey-1-2013:p1090:b003:l034","ordinal":160331,"en":"And thereby prosper."},{"id":"semetey-1-2013:p1090:b003:l035","ordinal":160332,"en":"If you ask about that time,"},{"id":"semetey-1-2013:p1090:b003:l036","ordinal":160333,"en":"Kökötöy's Bokmurun"},{"id":"semetey-1-2013:p1090:b003:l037","ordinal":160334,"en":"Had reached twelve years of age;"},{"id":"semetey-1-2013:p1090:b003:l038","ordinal":160335,"en":"He deemed no soul his equal"},{"id":"semetey-1-2013:p1090:b003:l039","ordinal":160336,"en":"And had grown drunk on wealth."},{"id":"semetey-1-2013:p1090:b004:l001","ordinal":160337,"en":"Saying, \"My khan-father has died,\""},{"id":"semetey-1-2013:p1090:b004:l002","ordinal":160338,"en":"He gathered under his gaze"},{"id":"semetey-1-2013:p1090:b004:l003","ordinal":160339,"en":"Infidel and Muslim alike,"},{"id":"semetey-1-2013:p1090:b004:l004","ordinal":160340,"en":"Yet sent no word"},{"id":"semetey-1-2013:p1090:b004:l005","ordinal":160341,"en":"To Zhakyp's only son, Manas."},{"id":"semetey-1-2013:p1090:b004:l006","ordinal":160342,"en":"Know his arrogance from this:"},{"id":"semetey-1-2013:p1090:b004:l007","ordinal":160343,"en":"At Kökötöy's mourning feast,"},{"id":"semetey-1-2013:p1090:b004:l008","ordinal":160344,"en":"Manas did not come to heap earth"},{"id":"semetey-1-2013:p1090:b004:l009","ordinal":160345,"en":"And did not cast his handful of soil."},{"id":"semetey-1-2013:p1090:b004:l010","ordinal":160346,"en":"Akkula was mounted,"},{"id":"semetey-1-2013:p1090:b004:l011","ordinal":160347,"en":"His white armor was donned,"},{"id":"semetey-1-2013:p1090:b004:l012","ordinal":160348,"en":"His sharp steel was girded on;"},{"id":"semetey-1-2013:p1090:b004:l013","ordinal":160349,"en":"Lion Manas, the tiger,"},{"id":"semetey-1-2013:p1090:b004:l014","ordinal":160350,"en":"Vowed, \"I shall strike down Bokmurun,\""},{"id":"semetey-1-2013:p1090:b004:l015","ordinal":160351,"en":"And raged like a white tiger."},{"id":"semetey-1-2013:p1090:b004:l016","ordinal":160352,"en":"As Manas stood shouting,"},{"id":"semetey-1-2013:p1090:b004:l017","ordinal":160353,"en":"Your gray wolf, wise Bakay,"},{"id":"semetey-1-2013:p1090:b004:l018","ordinal":160354,"en":"Stepped between them:"},{"id":"semetey-1-2013:p1090:b004:l019","ordinal":160355,"en":"\"Kökötöy's Bokmurun"},{"id":"semetey-1-2013:p1090:b004:l020","ordinal":160356,"en":"Is no yellow, rugged mountain"},{"id":"semetey-1-2013:p1090:b004:l021","ordinal":160357,"en":"For you to go and strike down,"},{"id":"semetey-1-2013:p1090:b004:l022","ordinal":160358,"en":"And no enemy with whom to test your strength."},{"id":"semetey-1-2013:p1090:b004:l023","ordinal":160359,"en":"Can one strike an idolater?"},{"id":"semetey-1-2013:p1090:b004:l024","ordinal":160360,"en":"If he attacks an idolater,"},{"id":"semetey-1-2013:p1090:b004:l025","ordinal":160361,"en":"Will Manas's deed prosper?"},{"id":"semetey-1-2013:p1090:b004:l026","ordinal":160362,"en":"Can one strike an orphan?"},{"id":"semetey-1-2013:p1090:b004:l027","ordinal":160363,"en":"Will such a complete deed prosper?"},{"id":"semetey-1-2013:p1090:b004:l028","ordinal":160364,"en":"If you go and attack a child,"},{"id":"semetey-1-2013:p1090:b004:l029","ordinal":160365,"en":"Entangling your deed in shame,"},{"id":"semetey-1-2013:p1090:b004:l030","ordinal":160366,"en":"Will your affair then prosper?\""},{"id":"semetey-1-2013:p1090:b004:l031","ordinal":160367,"en":"Noble Bakay, the tiger,"},{"id":"semetey-1-2013:p1090:b004:l032","ordinal":160368,"en":"Stepped between them"},{"id":"semetey-1-2013:p1090:b004:l033","ordinal":160369,"en":"And began his speech."},{"id":"semetey-1-2013:p1090:b004:l034","ordinal":160370,"en":"Thus he restrained"},{"id":"semetey-1-2013:p1090:b004:l035","ordinal":160371,"en":"His magnanimous lord Manas."},{"id":"semetey-1-2013:p1090:b004:l036","ordinal":160372,"en":"Other elders besides Manas were there;"},{"id":"semetey-1-2013:p1090:b004:l037","ordinal":160373,"en":"\"When Khan Kökötöy died,"},{"id":"semetey-1-2013:p1090:b004:l038","ordinal":160374,"en":"When the people gathered and buried him,"},{"id":"semetey-1-2013:p1090:b004:l039","ordinal":160375,"en":"All the common folk were there."},{"id":"semetey-1-2013:p1091:b003:l001","ordinal":160376,"en":"Among them"},{"id":"semetey-1-2013:p1091:b003:l002","ordinal":160377,"en":"Was the hero Koshoy as well."},{"id":"semetey-1-2013:p1091:b003:l003","ordinal":160378,"en":"At Kökötöy's mourning feast,"},{"id":"semetey-1-2013:p1091:b003:l004","ordinal":160379,"en":"His people surged together;"},{"id":"semetey-1-2013:p1091:b003:l005","ordinal":160380,"en":"I saw the place where they buried him."},{"id":"semetey-1-2013:p1091:b003:l006","ordinal":160381,"en":"For many days the people gathered;"},{"id":"semetey-1-2013:p1091:b003:l007","ordinal":160382,"en":"I saw the place where they camped."},{"id":"semetey-1-2013:p1091:b003:l008","ordinal":160383,"en":"I saw with my own eyes"},{"id":"semetey-1-2013:p1091:b003:l009","ordinal":160384,"en":"Kökötöy's grave prizes."},{"id":"semetey-1-2013:p1091:b003:l010","ordinal":160385,"en":"Adorning them richly with gold and jewels,"},{"id":"semetey-1-2013:p1091:b003:l011","ordinal":160386,"en":"He staked all his wealth"},{"id":"semetey-1-2013:p1091:b003:l012","ordinal":160387,"en":"In equal shares, without favor,"},{"id":"semetey-1-2013:p1091:b003:l013","ordinal":160388,"en":"Staked a thousand dark camels,"},{"id":"semetey-1-2013:p1091:b003:l014","ordinal":160389,"en":"And a thousand black-blazed mares."},{"id":"semetey-1-2013:p1091:b003:l015","ordinal":160390,"en":"The racers that were to run"},{"id":"semetey-1-2013:p1091:b004:l001","ordinal":160391,"en":"Had their hair tails braided,"},{"id":"semetey-1-2013:p1091:b004:l002","ordinal":160392,"en":"Their forelocks adorned"},{"id":"semetey-1-2013:p1091:b004:l003","ordinal":160393,"en":"And tied with blue silk."},{"id":"semetey-1-2013:p1091:b004:l004","ordinal":160394,"en":"Their waists were formed slender as a girl's;"},{"id":"semetey-1-2013:p1091:b004:l005","ordinal":160395,"en":"They streamed uphill and down."},{"id":"semetey-1-2013:p1091:b004:l006","ordinal":160396,"en":"Kökötöy's many prizes"},{"id":"semetey-1-2013:p1091:b004:l007","ordinal":160397,"en":"Delighted every soul who saw them."},{"id":"semetey-1-2013:p1091:b004:l008","ordinal":160398,"en":"Their fangs protruding,"},{"id":"semetey-1-2013:p1091:b004:l009","ordinal":160399,"en":"The swift horses grew restive;"},{"id":"semetey-1-2013:p1091:b004:l010","ordinal":160400,"en":"Their mustaches bristling,"},{"id":"semetey-1-2013:p1091:b004:l011","ordinal":160401,"en":"Giants and heroes grew excited."},{"id":"semetey-1-2013:p1091:b004:l012","ordinal":160402,"en":"They covered him and heaped the earth;"},{"id":"semetey-1-2013:p1091:b004:l013","ordinal":160403,"en":"Saying Khan Kökötöy had died,"},{"id":"semetey-1-2013:p1091:b004:l014","ordinal":160404,"en":"The common people gathered in a mass,"},{"id":"semetey-1-2013:p1091:b004:l015","ordinal":160405,"en":"With their khojas and men of standing."},{"id":"semetey-1-2013:p1091:b006:l001","ordinal":160406,"en":"For Khan Kökötöy's death,"},{"id":"semetey-1-2013:p1091:b006:l002","ordinal":160407,"en":"There were peoples who had set out and come."},{"id":"semetey-1-2013:p1091:b006:l003","ordinal":160408,"en":"There were heroes and giants,"},{"id":"semetey-1-2013:p1091:b006:l004","ordinal":160409,"en":"Heroes each worth a thousand,"},{"id":"semetey-1-2013:p1091:b006:l005","ordinal":160410,"en":"All of them gathered there."},{"id":"semetey-1-2013:p1091:b006:l006","ordinal":160411,"en":"His white beard flowing,"},{"id":"semetey-1-2013:p1091:b006:l007","ordinal":160412,"en":"He who had fathomed the depths of wisdom,"},{"id":"semetey-1-2013:p1091:b006:l008","ordinal":160413,"en":"At whose stern face men trembled,"},{"id":"semetey-1-2013:p1091:b006:l009","ordinal":160414,"en":"Who had studied under saints—"},{"id":"semetey-1-2013:p1091:b006:l010","ordinal":160415,"en":"Mighty Koshoy too was there."},{"id":"semetey-1-2013:p1091:b006:l011","ordinal":160416,"en":"He made the unknown known,"},{"id":"semetey-1-2013:p1091:b006:l012","ordinal":160417,"en":"The learned elder Koshoy."},{"id":"semetey-1-2013:p1091:b006:l013","ordinal":160418,"en":"Do not ask of Koshoy's station:"},{"id":"semetey-1-2013:p1091:b006:l014","ordinal":160419,"en":"To receive the highest instruction,"},{"id":"semetey-1-2013:p1091:b006:l015","ordinal":160420,"en":"Hero Koshoy entered Egypt"},{"id":"semetey-1-2013:p1091:b006:l016","ordinal":160421,"en":"And studied in Egypt for five years."},{"id":"semetey-1-2013:p1091:b006:l017","ordinal":160422,"en":"To comprehend all the world,"},{"id":"semetey-1-2013:p1091:b006:l018","ordinal":160423,"en":"He studied in Baghdad for five years."},{"id":"semetey-1-2013:p1091:b006:l019","ordinal":160424,"en":"Traveling the lands before him,"},{"id":"semetey-1-2013:p1091:b008:l001","ordinal":160425,"en":"Hero Koshoy entered Mecca"},{"id":"semetey-1-2013:p1091:b008:l002","ordinal":160426,"en":"And studied in Mecca for five years."},{"id":"semetey-1-2013:p1091:b008:l003","ordinal":160427,"en":"He received a letter from the caliph,"},{"id":"semetey-1-2013:p1091:b008:l004","ordinal":160428,"en":"Pledged his hand to the twelve-in-one,"},{"id":"semetey-1-2013:p1091:b008:l005","ordinal":160429,"en":"And was called Sayypburush."},{"id":"semetey-1-2013:p1091:b008:l006","ordinal":160430,"en":"His white beard flowing,"},{"id":"semetey-1-2013:p1091:b008:l007","ordinal":160431,"en":"That elder, your uncle Koshoy,"},{"id":"semetey-1-2013:p1091:b008:l008","ordinal":160432,"en":"Had examined every counsel."},{"id":"semetey-1-2013:p1091:b008:l009","ordinal":160433,"en":"Before that Koshoy,"},{"id":"semetey-1-2013:p1091:b008:l010","ordinal":160434,"en":"The people were gathered."},{"id":"semetey-1-2013:p1091:b008:l011","ordinal":160435,"en":"The rich man's son Bokmurun,"},{"id":"semetey-1-2013:p1091:b008:l012","ordinal":160436,"en":"Saying, \"My khan-father has passed away,\""},{"id":"semetey-1-2013:p1091:b008:l013","ordinal":160437,"en":"Wept before Khan Koshoy:"},{"id":"semetey-1-2013:p1091:b008:l014","ordinal":160438,"en":"\"My uncle, elder Koshoy,"},{"id":"semetey-1-2013:p1091:b008:l015","ordinal":160439,"en":"My father Kökötöy"},{"id":"semetey-1-2013:p1091:b008:l016","ordinal":160440,"en":"Was indeed the true Kökötöy."},{"id":"semetey-1-2013:p1091:b008:l017","ordinal":160441,"en":"My dear father's countless riches"},{"id":"semetey-1-2013:p1091:b008:l018","ordinal":160442,"en":"Filled the four corners of the world,"},{"id":"semetey-1-2013:p1091:b008:l019","ordinal":160443,"en":"The forty corners of the qibla,"},{"id":"semetey-1-2013:p1092:b003:l001","ordinal":160444,"en":"And forty circuits around it."},{"id":"semetey-1-2013:p1092:b003:l002","ordinal":160445,"en":"I have a spectacle to show the people;"},{"id":"semetey-1-2013:p1092:b003:l003","ordinal":160446,"en":"My dear father left me"},{"id":"semetey-1-2013:p1092:b003:l004","ordinal":160447,"en":"Abundant, glittering wealth."},{"id":"semetey-1-2013:p1092:b003:l005","ordinal":160448,"en":"I shall open the doors"},{"id":"semetey-1-2013:p1092:b003:l006","ordinal":160449,"en":"Of forty treasure-filled rooms."},{"id":"semetey-1-2013:p1092:b003:l007","ordinal":160450,"en":"My dear father's countless riches"},{"id":"semetey-1-2013:p1092:b003:l008","ordinal":160451,"en":"I shall squander and scatter"},{"id":"semetey-1-2013:p1092:b003:l009","ordinal":160452,"en":"Among infidel and Muslim alike."},{"id":"semetey-1-2013:p1092:b003:l010","ordinal":160453,"en":"I have robes of honor and possessions;"},{"id":"semetey-1-2013:p1092:b003:l011","ordinal":160454,"en":"I have exactly seven myriad sheep,"},{"id":"semetey-1-2013:p1092:b003:l012","ordinal":160455,"en":"And means to render service."},{"id":"semetey-1-2013:p1092:b003:l013","ordinal":160456,"en":"To carry my riches,"},{"id":"semetey-1-2013:p1092:b003:l014","ordinal":160457,"en":"And reach whatever land I desire,"},{"id":"semetey-1-2013:p1092:b003:l015","ordinal":160458,"en":"I have camels that have crossed the world."},{"id":"semetey-1-2013:p1092:b003:l016","ordinal":160459,"en":"Kökötöy's vast riches—"},{"id":"semetey-1-2013:p1092:b003:l017","ordinal":160460,"en":"Disregarding all restraint,"},{"id":"semetey-1-2013:p1092:b003:l018","ordinal":160461,"en":"I shall try spending them utterly."},{"id":"semetey-1-2013:p1092:b003:l019","ordinal":160462,"en":"I shall camp in the midst"},{"id":"semetey-1-2013:p1092:b003:l020","ordinal":160463,"en":"Of infidel and Muslim alike"},{"id":"semetey-1-2013:p1092:b003:l021","ordinal":160464,"en":"And hold my father's feast;"},{"id":"semetey-1-2013:p1092:b003:l022","ordinal":160465,"en":"Thus I shall test the strength"},{"id":"semetey-1-2013:p1092:b003:l023","ordinal":160466,"en":"Of the countless herds my father gathered."},{"id":"semetey-1-2013:p1092:b003:l024","ordinal":160467,"en":"On the ridges I have six ilek of horses;"},{"id":"semetey-1-2013:p1092:b003:l025","ordinal":160468,"en":"I shall drive and stake them as prizes."},{"id":"semetey-1-2013:p1092:b003:l026","ordinal":160469,"en":"I have innumerable dark camels;"},{"id":"semetey-1-2013:p1092:b003:l027","ordinal":160470,"en":"Without counting, I shall stake them as prizes."},{"id":"semetey-1-2013:p1092:b003:l028","ordinal":160471,"en":"At my noble gray-wolf father's death,"},{"id":"semetey-1-2013:p1092:b003:l029","ordinal":160472,"en":"Proclaiming the grave prizes"},{"id":"semetey-1-2013:p1092:b003:l030","ordinal":160473,"en":"Before all the people,"},{"id":"semetey-1-2013:p1092:b003:l031","ordinal":160474,"en":"I shall now stake great prizes."},{"id":"semetey-1-2013:p1092:b003:l032","ordinal":160475,"en":"At Khan Kökötöy's feast,"},{"id":"semetey-1-2013:p1092:b003:l033","ordinal":160476,"en":"What mortal will rival me?"},{"id":"semetey-1-2013:p1092:b003:l034","ordinal":160477,"en":"When infidel and Muslim"},{"id":"semetey-1-2013:p1092:b003:l035","ordinal":160478,"en":"Come against one another,"},{"id":"semetey-1-2013:p1092:b003:l036","ordinal":160479,"en":"The bald men will butt heads with a crash;"},{"id":"semetey-1-2013:p1092:b003:l037","ordinal":160480,"en":"Then the spectacle will begin."},{"id":"semetey-1-2013:p1092:b003:l038","ordinal":160481,"en":"At this feast of mine,"},{"id":"semetey-1-2013:p1092:b003:l039","ordinal":160482,"en":"They will seize one another by the trouser cuffs,"},{"id":"semetey-1-2013:p1092:b004:l001","ordinal":160483,"en":"And the wrestlers will wrestle."},{"id":"semetey-1-2013:p1092:b004:l002","ordinal":160484,"en":"I shall open a city bazaar"},{"id":"semetey-1-2013:p1092:b004:l003","ordinal":160485,"en":"And scatter my dear father's"},{"id":"semetey-1-2013:p1092:b004:l004","ordinal":160486,"en":"Countless riches in heaps."},{"id":"semetey-1-2013:p1092:b004:l005","ordinal":160487,"en":"I shall gather all the giants"},{"id":"semetey-1-2013:p1092:b004:l006","ordinal":160488,"en":"Of infidel and Muslim alike."},{"id":"semetey-1-2013:p1092:b004:l007","ordinal":160489,"en":"When I stake abundant prizes,"},{"id":"semetey-1-2013:p1092:b004:l008","ordinal":160490,"en":"Their lance shafts will bend,"},{"id":"semetey-1-2013:p1092:b004:l009","ordinal":160491,"en":"And heroic men will joust."},{"id":"semetey-1-2013:p1092:b004:l010","ordinal":160492,"en":"My father Kökötöy's"},{"id":"semetey-1-2013:p1092:b004:l011","ordinal":160493,"en":"Surging, countless riches—"},{"id":"semetey-1-2013:p1092:b004:l012","ordinal":160494,"en":"I shall scatter them all for my father."},{"id":"semetey-1-2013:p1092:b004:l013","ordinal":160495,"en":"As arbiter I shall appoint"},{"id":"semetey-1-2013:p1092:b004:l014","ordinal":160496,"en":"Old Koshoy of the Katagan."},{"id":"semetey-1-2013:p1092:b004:l015","ordinal":160497,"en":"I have abundant, ample herds;"},{"id":"semetey-1-2013:p1092:b004:l016","ordinal":160498,"en":"I have the means to feast"},{"id":"semetey-1-2013:p1092:b004:l017","ordinal":160499,"en":"Infidel and Muslim alike"},{"id":"semetey-1-2013:p1092:b004:l018","ordinal":160500,"en":"For seven years."},{"id":"semetey-1-2013:p1092:b004:l019","ordinal":160501,"en":"If Kökötöy's great wealth"},{"id":"semetey-1-2013:p1092:b004:l020","ordinal":160502,"en":"Proves little rather than much,"},{"id":"semetey-1-2013:p1092:b004:l021","ordinal":160503,"en":"If much babbling arises among us"},{"id":"semetey-1-2013:p1092:b004:l022","ordinal":160504,"en":"And open kinsmen become foes,"},{"id":"semetey-1-2013:p1092:b004:l023","ordinal":160505,"en":"I shall divide the four kinds of livestock."},{"id":"semetey-1-2013:p1092:b004:l024","ordinal":160506,"en":"I shall impose hardship and grandeur"},{"id":"semetey-1-2013:p1092:b004:l025","ordinal":160507,"en":"Without holding back,"},{"id":"semetey-1-2013:p1092:b004:l026","ordinal":160508,"en":"And overwhelm all the people"},{"id":"semetey-1-2013:p1092:b004:l027","ordinal":160509,"en":"With my full force."},{"id":"semetey-1-2013:p1092:b004:l028","ordinal":160510,"en":"Until only one bull remains,"},{"id":"semetey-1-2013:p1092:b004:l029","ordinal":160511,"en":"I shall scatter my great riches."},{"id":"semetey-1-2013:p1092:b004:l030","ordinal":160512,"en":"There are many peoples who do not eat meat,"}]
