{"id": "sayakbay-ms-current146:pdf185:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 185, "folio": 568, "line_in_page": 15, "raw": "Катуу жаңыл зарынан,", "text": "Катуу жаңыл зарынан,", "en": "From his harsh and grievous lament,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf185:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 185, "folio": 568, "line_in_page": 16, "raw": "Омбой ойлоп ат алат,", "text": "Омбой ойлоп ат алат,", "en": "He pondered deeply and took a horse.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf185:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 185, "folio": 568, "line_in_page": 17, "raw": "Бээжиндин эли кайтадан,", "text": "Бээжиндин эли кайтадан,", "en": "The people of Beijing once again,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf185:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 185, "folio": 568, "line_in_page": 18, "raw": "Кара жой баатыр Кожожан,", "text": "Кара жой баатыр Кожожан,", "en": "The dark warrior Kozhojan,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf185:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 185, "folio": 568, "line_in_page": 19, "raw": "Сенчелик мерген аттанган,", "text": "Сенчелик мерген аттанган,", "en": "A marksman like you rode out.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf185:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 185, "folio": 568, "line_in_page": 20, "raw": "Бир жаны кайра тартпаган,", "text": "Бир жаны кайра тартпаган,", "en": "Not one soul turned back.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf185:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 185, "folio": 568, "line_in_page": 21, "raw": "Чоң мушкулго камдалган,", "text": "Чоң мушкулго камдалган,", "en": "They prepared for the great ordeal,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf185:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 185, "folio": 568, "line_in_page": 22, "raw": "Чоң жамалы мушкулдун,", "text": "Чоң жамалы мушкулдун,", "en": "For the grave face of hardship.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf185:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 185, "folio": 568, "line_in_page": 23, "raw": "Ал данзага каттаган,", "text": "Ал данзага каттаган,", "en": "He entered it on that register.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf185:l024", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 185, "folio": 568, "line_in_page": 24, "raw": "Айтканыбыз билип ал,", "text": "Айтканыбыз билип ал,", "en": "Understand what we have said.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf185:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 185, "folio": 568, "line_in_page": 25, "raw": "Артың мерген кур эле,", "text": "Артың мерген кур эле,", "en": "Behind you stood only the marksman.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf185:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 185, "folio": 568, "line_in_page": 26, "raw": "Белим эр бал эмес,", "text": "Белим эр бал эмес,", "en": "My strength was no mere child.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf185:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 185, "folio": 568, "line_in_page": 27, "raw": "Берен да элең, эр да элең,", "text": "Берен да элең, эр да элең,", "en": "You were a champion and a hero.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf185:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 185, "folio": 568, "line_in_page": 28, "raw": "Кой кайканы козу элең,", "text": "Кой кайканы козу элең,", "en": "You were the lamb that turned the flock.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf185:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 185, "folio": 568, "line_in_page": 29, "raw": "Көк жал эрдин өзү элең,", "text": "Көк жал эрдин өзү элең,", "en": "You were the gray-maned hero himself.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf185:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 185, "folio": 568, "line_in_page": 30, "raw": "Кийгенине ок өтпөйт,", "text": "Кийгенине ок өтпөйт,", "en": "No bullet pierced what he wore.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf185:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 185, "folio": 568, "line_in_page": 31, "raw": "Мингенине жал жетпейт,", "text": "Мингенине жал жетпейт,", "en": "No mane could overtake what he rode.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf185:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 185, "folio": 568, "line_in_page": 32, "raw": "Буруттай уккан кертүүлөр,", "text": "Буруттай уккан кертүүлөр,", "en": "Those who heard the name Burut,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf185:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 185, "folio": 568, "line_in_page": 33, "raw": "Берен элин салынса,", "text": "Берен элин салынса,", "en": "If the champion committed his people,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf185:l034", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 185, "folio": 568, "line_in_page": 34, "raw": "Бел Бээжиндин айланы,", "text": "Бел Бээжиндин айланы,", "en": "The stratagems of mighty Beijing,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf185:l035", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 185, "folio": 568, "line_in_page": 35, "raw": "Берен каны чок төгөр,", "text": "Берен каны чок төгөр,", "en": "The champion would spill blood like embers.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf185:l036", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 185, "folio": 568, "line_in_page": 36, "raw": "Мике турган мал элең.", "text": "Мике турган мал элең.", "en": "You were livestock standing at the stake.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
