[{"id":"semetey-1-2013:p1182:b004:l016","ordinal":166401,"en":"Where is such a prize?"},{"id":"semetey-1-2013:p1182:b004:l017","ordinal":166402,"en":"I will make a riotous wholesale,"},{"id":"semetey-1-2013:p1182:b004:l018","ordinal":166403,"en":"My father's funeral"},{"id":"semetey-1-2013:p1182:b004:l019","ordinal":166404,"en":"I will make my world laugh."},{"id":"semetey-1-2013:p1182:b004:l020","ordinal":166405,"en":"I spoke proudly,"},{"id":"semetey-1-2013:p1182:b004:l021","ordinal":166406,"en":"My father's funeral"},{"id":"semetey-1-2013:p1182:b004:l022","ordinal":166407,"en":"I will spend my life."},{"id":"semetey-1-2013:p1182:b004:l023","ordinal":166408,"en":"Don't let the people gossip,"},{"id":"semetey-1-2013:p1182:b004:l024","ordinal":166409,"en":"Sorry for my father,"},{"id":"semetey-1-2013:p1182:b004:l025","ordinal":166410,"en":"Don't be left alone."},{"id":"semetey-1-2013:p1182:b004:l026","ordinal":166411,"en":"People who came to the memorial feast,"},{"id":"semetey-1-2013:p1182:b004:l027","ordinal":166412,"en":"To my father"},{"id":"semetey-1-2013:p1182:b004:l028","ordinal":166413,"en":"Put both of them down, put one on,"},{"id":"semetey-1-2013:p1182:b004:l029","ordinal":166414,"en":"Put my son and my family."},{"id":"semetey-1-2013:p1182:b004:l030","ordinal":166415,"en":"My people moved from Tashkent."},{"id":"semetey-1-2013:p1182:b004:l031","ordinal":166416,"en":"If the world is not enough,"},{"id":"semetey-1-2013:p1182:b004:l032","ordinal":166417,"en":"Let's go around"},{"id":"semetey-1-2013:p1182:b004:l033","ordinal":166418,"en":"Call me the grand prize.\""},{"id":"semetey-1-2013:p1182:b004:l034","ordinal":166419,"en":"Kökötöy's feast"},{"id":"semetey-1-2013:p1182:b004:l035","ordinal":166420,"en":"Before closing his mouth,"},{"id":"semetey-1-2013:p1182:b004:l036","ordinal":166421,"en":"Until he stopped talking,"},{"id":"semetey-1-2013:p1182:b004:l037","ordinal":166422,"en":"The bell rings loudly,"},{"id":"semetey-1-2013:p1182:b004:l038","ordinal":166423,"en":"Serving red camel,"},{"id":"semetey-1-2013:p1182:b004:l039","ordinal":166424,"en":"came in and closed,"},{"id":"semetey-1-2013:p1183:b003:l001","ordinal":166425,"en":"Countless camels came in rows;"},{"id":"semetey-1-2013:p1183:b003:l002","ordinal":166426,"en":"A host of people came on foot,"},{"id":"semetey-1-2013:p1183:b003:l003","ordinal":166427,"en":"Leading those countless camels."},{"id":"semetey-1-2013:p1183:b003:l004","ordinal":166428,"en":"The people marveled"},{"id":"semetey-1-2013:p1183:b003:l005","ordinal":166429,"en":"And asked many questions:"},{"id":"semetey-1-2013:p1183:b003:l006","ordinal":166430,"en":"\"Whose are all these camels?\""},{"id":"semetey-1-2013:p1183:b003:l007","ordinal":166431,"en":"\"These are Kokotoy's camels,"},{"id":"semetey-1-2013:p1183:b003:l008","ordinal":166432,"en":"Loaded with finery for Kokotoy."},{"id":"semetey-1-2013:p1183:b003:l009","ordinal":166433,"en":"Attending those camels"},{"id":"semetey-1-2013:p1183:b003:l010","ordinal":166434,"en":"Is a countless throng of servants.\""},{"id":"semetey-1-2013:p1183:b003:l011","ordinal":166435,"en":"They came and undid the bindings;"},{"id":"semetey-1-2013:p1183:b003:l012","ordinal":166436,"en":"Many splendid things had come"},{"id":"semetey-1-2013:p1183:b003:l013","ordinal":166437,"en":"To be staked as the grand prize."},{"id":"semetey-1-2013:p1183:b003:l014","ordinal":166438,"en":"With no mount left wanting, they brought goods,"},{"id":"semetey-1-2013:p1183:b003:l015","ordinal":166439,"en":"Loaded gold coins upon the goods,"},{"id":"semetey-1-2013:p1183:b003:l016","ordinal":166440,"en":"And brought sixty beautiful girls,"},{"id":"semetey-1-2013:p1183:b003:l017","ordinal":166441,"en":"All to serve equally as hosts"},{"id":"semetey-1-2013:p1183:b003:l018","ordinal":166442,"en":"At Kokotoy's celebration."},{"id":"semetey-1-2013:p1183:b003:l019","ordinal":166443,"en":"Their trailing ornaments brushed the ground."},{"id":"semetey-1-2013:p1183:b003:l020","ordinal":166444,"en":"This vain wealth had reached its height:"},{"id":"semetey-1-2013:p1183:b003:l021","ordinal":166445,"en":"Kokotoy's abundant riches,"},{"id":"semetey-1-2013:p1183:b003:l022","ordinal":166446,"en":"Which flared brighter as they were spent,"},{"id":"semetey-1-2013:p1183:b003:l023","ordinal":166447,"en":"A world of goods arrayed like grass;"},{"id":"semetey-1-2013:p1183:b003:l024","ordinal":166448,"en":"The more was cut away, the broader it grew,"},{"id":"semetey-1-2013:p1183:b003:l025","ordinal":166449,"en":"Abundant wealth that never diminished."},{"id":"semetey-1-2013:p1183:b003:l026","ordinal":166450,"en":"These were the things he had brought."},{"id":"semetey-1-2013:p1183:b003:l027","ordinal":166451,"en":"Now hear the condition"},{"id":"semetey-1-2013:p1183:b003:l028","ordinal":166452,"en":"Of that boy Bokmurun."},{"id":"semetey-1-2013:p1183:b003:l029","ordinal":166453,"en":"He enjoyed honor among the people."},{"id":"semetey-1-2013:p1183:b003:l030","ordinal":166454,"en":"All this wealth and delight"},{"id":"semetey-1-2013:p1183:b003:l031","ordinal":166455,"en":"Had been amassed, all together,"},{"id":"semetey-1-2013:p1183:b003:l032","ordinal":166456,"en":"By dear noble Kokotoy."},{"id":"semetey-1-2013:p1183:b003:l033","ordinal":166457,"en":"If Bokmurun left it untouched,"},{"id":"semetey-1-2013:p1183:b003:l034","ordinal":166458,"en":"It could have lasted until Judgment Day."},{"id":"semetey-1-2013:p1183:b003:l035","ordinal":166459,"en":"Bokmurun, whose father had died,"},{"id":"semetey-1-2013:p1183:b003:l036","ordinal":166460,"en":"Did not rein in his horse;"},{"id":"semetey-1-2013:p1183:b003:l037","ordinal":166461,"en":"Infidel and Muslim alike,"},{"id":"semetey-1-2013:p1183:b003:l038","ordinal":166462,"en":"He gathered every last one."},{"id":"semetey-1-2013:p1183:b003:l039","ordinal":166463,"en":"He opened the treasury"},{"id":"semetey-1-2013:p1183:b003:l040","ordinal":166464,"en":"The mass of wealth and livestock"},{"id":"semetey-1-2013:p1183:b004:l001","ordinal":166465,"en":"Before the assembled people,"},{"id":"semetey-1-2013:p1183:b004:l002","ordinal":166466,"en":"He scattered lavishly."},{"id":"semetey-1-2013:p1183:b004:l003","ordinal":166467,"en":"Overseeing the feast"},{"id":"semetey-1-2013:p1183:b004:l004","ordinal":166468,"en":"Was gray-maned lion Manas."},{"id":"semetey-1-2013:p1183:b004:l005","ordinal":166469,"en":"Everyone whom ears had heard of"},{"id":"semetey-1-2013:p1183:b004:l006","ordinal":166470,"en":"And eyes had seen among the people"},{"id":"semetey-1-2013:p1183:b004:l007","ordinal":166471,"en":"Attended Kokotoy's feast."},{"id":"semetey-1-2013:p1183:b004:l008","ordinal":166472,"en":"The thick-woven piebald cloth of Andijan,"},{"id":"semetey-1-2013:p1183:b004:l009","ordinal":166473,"en":"Gathered like Ala-Too"},{"id":"semetey-1-2013:p1183:b004:l010","ordinal":166474,"en":"To be staked as the grand prize,"},{"id":"semetey-1-2013:p1183:b004:l011","ordinal":166475,"en":"Made the hearts of onlookers waver."},{"id":"semetey-1-2013:p1183:b004:l012","ordinal":166476,"en":"The costly piebald silk of Bukhara"},{"id":"semetey-1-2013:p1183:b004:l013","ordinal":166477,"en":"At Kokotoy's feast"},{"id":"semetey-1-2013:p1183:b004:l014","ordinal":166478,"en":"Loomed like a misty mountain."},{"id":"semetey-1-2013:p1183:b004:l015","ordinal":166479,"en":"Gold and precious stones,"},{"id":"semetey-1-2013:p1183:b004:l016","ordinal":166480,"en":"With rubies mixed among them—"},{"id":"semetey-1-2013:p1183:b004:l017","ordinal":166481,"en":"Kokotoy's many prizes"},{"id":"semetey-1-2013:p1183:b004:l018","ordinal":166482,"en":"Overwhelmed the multitude,"},{"id":"semetey-1-2013:p1183:b004:l019","ordinal":166483,"en":"And troubled their poor heads."},{"id":"semetey-1-2013:p1183:b004:l020","ordinal":166484,"en":"Kokotoy's red banner with golden finial"},{"id":"semetey-1-2013:p1183:b004:l021","ordinal":166485,"en":"Was raised sky-high above the feast."},{"id":"semetey-1-2013:p1183:b004:l022","ordinal":166486,"en":"Your gray-maned lion Manas"},{"id":"semetey-1-2013:p1183:b004:l023","ordinal":166487,"en":"Had proclamations announced to the people,"},{"id":"semetey-1-2013:p1183:b004:l024","ordinal":166488,"en":"Beginning with Yrchyuul,"},{"id":"semetey-1-2013:p1183:b004:l025","ordinal":166489,"en":"Son of Yraman."},{"id":"semetey-1-2013:p1183:b004:l026","ordinal":166490,"en":"When they heard his proclamation,"},{"id":"semetey-1-2013:p1183:b004:l027","ordinal":166491,"en":"Willow cudgels were cut,"},{"id":"semetey-1-2013:p1183:b004:l028","ordinal":166492,"en":"And every horse racer"},{"id":"semetey-1-2013:p1183:b004:l029","ordinal":166493,"en":"Gathered without exception."},{"id":"semetey-1-2013:p1183:b004:l030","ordinal":166494,"en":"Karatai was made the starter;"},{"id":"semetey-1-2013:p1183:b004:l031","ordinal":166495,"en":"When the time came to drive out the horses,"},{"id":"semetey-1-2013:p1183:b004:l032","ordinal":166496,"en":"Infidel and Muslim"},{"id":"semetey-1-2013:p1183:b004:l033","ordinal":166497,"en":"All assembled without exception."},{"id":"semetey-1-2013:p1183:b004:l034","ordinal":166498,"en":"All the heroes grew excited;"},{"id":"semetey-1-2013:p1183:b004:l035","ordinal":166499,"en":"The simpletons surged forward."},{"id":"semetey-1-2013:p1183:b004:l036","ordinal":166500,"en":"The people gathered in a dense mass,"},{"id":"semetey-1-2013:p1183:b004:l037","ordinal":166501,"en":"Dust flying into the sky;"},{"id":"semetey-1-2013:p1183:b004:l038","ordinal":166502,"en":"They divided clan by clan,"},{"id":"semetey-1-2013:p1183:b004:l039","ordinal":166503,"en":"And when they advanced, looked like a flood."},{"id":"semetey-1-2013:p1184:b004:l001","ordinal":166504,"en":"Dust flew and haze burned;"},{"id":"semetey-1-2013:p1184:b004:l002","ordinal":166505,"en":"A long cloud of dust billowed."},{"id":"semetey-1-2013:p1184:b004:l003","ordinal":166506,"en":"Clan after clan covered the ground;"},{"id":"semetey-1-2013:p1184:b004:l004","ordinal":166507,"en":"The great host come to the feast"},{"id":"semetey-1-2013:p1184:b004:l005","ordinal":166508,"en":"Surged forward, crying out."},{"id":"semetey-1-2013:p1184:b004:l006","ordinal":166509,"en":"The drum was beaten firmly;"},{"id":"semetey-1-2013:p1184:b004:l007","ordinal":166510,"en":"All who wished to race horses"},{"id":"semetey-1-2013:p1184:b004:l008","ordinal":166511,"en":"Closed in without exception."},{"id":"semetey-1-2013:p1184:b004:l009","ordinal":166512,"en":"They dressed the forelocks"},{"id":"semetey-1-2013:p1184:b004:l010","ordinal":166513,"en":"Of the horses meant to win prizes,"},{"id":"semetey-1-2013:p1184:b004:l011","ordinal":166514,"en":"Knotted their tails,"},{"id":"semetey-1-2013:p1184:b004:l012","ordinal":166515,"en":"Took the shortcut along the narrow road,"},{"id":"semetey-1-2013:p1184:b004:l013","ordinal":166516,"en":"And hurried, leading their horses."},{"id":"semetey-1-2013:p1184:b004:l014","ordinal":166517,"en":"They formed nation after nation,"},{"id":"semetey-1-2013:p1184:b004:l015","ordinal":166518,"en":"Their numbers like a flooding river,"},{"id":"semetey-1-2013:p1184:b004:l016","ordinal":166519,"en":"Murmuring like a vast people,"},{"id":"semetey-1-2013:p1184:b004:l017","ordinal":166520,"en":"The multitude swarming thickly."},{"id":"semetey-1-2013:p1184:b004:l018","ordinal":166521,"en":"Turning as they led their horses,"},{"id":"semetey-1-2013:p1184:b004:l019","ordinal":166522,"en":"They separated from one another."},{"id":"semetey-1-2013:p1184:b004:l020","ordinal":166523,"en":"The earth split and shifted;"},{"id":"semetey-1-2013:p1184:b004:l021","ordinal":166524,"en":"Peoples of many ages filled it."},{"id":"semetey-1-2013:p1184:b004:l022","ordinal":166525,"en":"Because that host was so immense,"},{"id":"semetey-1-2013:p1184:b004:l023","ordinal":166526,"en":"The center of the crowd hollowed out."},{"id":"semetey-1-2013:p1184:b004:l024","ordinal":166527,"en":"Kokotoy's countless black livestock"},{"id":"semetey-1-2013:p1184:b004:l025","ordinal":166528,"en":"Were slaughtered and spent lavishly."},{"id":"semetey-1-2013:p1184:b004:l026","ordinal":166529,"en":"At Khan Kokotoy's feast,"},{"id":"semetey-1-2013:p1184:b004:l027","ordinal":166530,"en":"Before the great gathering,"},{"id":"semetey-1-2013:p1184:b004:l028","ordinal":166531,"en":"The people of the khagan ate their fill."},{"id":"semetey-1-2013:p1184:b004:l029","ordinal":166532,"en":"Trenches were dug in great numbers,"},{"id":"semetey-1-2013:p1184:b004:l030","ordinal":166533,"en":"And above the trenches"},{"id":"semetey-1-2013:p1184:b004:l031","ordinal":166534,"en":"Cauldrons were hung by the ten-thousand."},{"id":"semetey-1-2013:p1184:b004:l032","ordinal":166535,"en":"Broth spilled like a lake,"},{"id":"semetey-1-2013:p1184:b004:l033","ordinal":166536,"en":"And meat loomed like a mountain."},{"id":"semetey-1-2013:p1184:b004:l034","ordinal":166537,"en":"When they heard news of the prize,"},{"id":"semetey-1-2013:p1184:b004:l035","ordinal":166538,"en":"All the people, every one,"},{"id":"semetey-1-2013:p1184:b004:l036","ordinal":166539,"en":"Swarmed like ants"},{"id":"semetey-1-2013:p1184:b004:l037","ordinal":166540,"en":"And now came out in groups."},{"id":"semetey-1-2013:p1184:b005:l001","ordinal":166541,"en":"Among the Chinese was Orongu;"},{"id":"semetey-1-2013:p1184:b005:l002","ordinal":166542,"en":"This was Orongu's desire:"},{"id":"semetey-1-2013:p1184:b005:l003","ordinal":166543,"en":"\"I will win the accursed Burut's"},{"id":"semetey-1-2013:p1184:b005:l004","ordinal":166544,"en":"Prize as well,\" he said."},{"id":"semetey-1-2013:p1184:b005:l005","ordinal":166545,"en":"He prepared a rough-gaited bay mare,"},{"id":"semetey-1-2013:p1184:b005:l006","ordinal":166546,"en":"That bay mare,"},{"id":"semetey-1-2013:p1184:b005:l007","ordinal":166547,"en":"Dressing and setting its tail."},{"id":"semetey-1-2013:p1184:b005:l008","ordinal":166548,"en":"Behind the bay mare"},{"id":"semetey-1-2013:p1184:b005:l009","ordinal":166549,"en":"He rolled up and stuffed"},{"id":"semetey-1-2013:p1184:b005:l010","ordinal":166550,"en":"A saddle-sized piece of black felt."},{"id":"semetey-1-2013:p1184:b005:l011","ordinal":166551,"en":"Khan Joloy of the Kalmyks"},{"id":"semetey-1-2013:p1184:b005:l012","ordinal":166552,"en":"Tied Achbuudan's forelock"},{"id":"semetey-1-2013:p1184:b005:l013","ordinal":166553,"en":"This way and that,"},{"id":"semetey-1-2013:p1184:b005:l014","ordinal":166554,"en":"And entered Achbuudan,"},{"id":"semetey-1-2013:p1184:b005:l015","ordinal":166555,"en":"Saying, \"I will win the grand prize.\""},{"id":"semetey-1-2013:p1184:b005:l016","ordinal":166556,"en":"Manas had Akkula;"},{"id":"semetey-1-2013:p1184:b005:l017","ordinal":166557,"en":"Joloy had Surkula."},{"id":"semetey-1-2013:p1184:b005:l018","ordinal":166558,"en":"Akkula and Achbuudan"},{"id":"semetey-1-2013:p1184:b005:l019","ordinal":166559,"en":"Were exceptional tulpar steeds;"},{"id":"semetey-1-2013:p1184:b005:l020","ordinal":166560,"en":"When one looked at the two,"},{"id":"semetey-1-2013:p1184:b005:l021","ordinal":166561,"en":"They resembled hares."},{"id":"semetey-1-2013:p1184:b005:l022","ordinal":166562,"en":"Manas entered Akkula;"},{"id":"semetey-1-2013:p1184:b005:l023","ordinal":166563,"en":"Joloy entered Surkula."},{"id":"semetey-1-2013:p1184:b005:l024","ordinal":166564,"en":"With cotton sash and broad boots,"},{"id":"semetey-1-2013:p1184:b005:l025","ordinal":166565,"en":"Kongurbay, khan of the Kechils,"},{"id":"semetey-1-2013:p1184:b005:l026","ordinal":166566,"en":"Was a swine who knew"},{"id":"semetey-1-2013:p1184:b005:l027","ordinal":166567,"en":"The enemy's devices perfectly:"},{"id":"semetey-1-2013:p1184:b005:l028","ordinal":166568,"en":"\"Let broad-chested Manas"},{"id":"semetey-1-2013:p1184:b005:l029","ordinal":166569,"en":"Race Akkula and I shall see him;"},{"id":"semetey-1-2013:p1184:b005:l030","ordinal":166570,"en":"I will joust with a Burut like him"},{"id":"semetey-1-2013:p1184:b005:l031","ordinal":166571,"en":"And spill his blood."},{"id":"semetey-1-2013:p1184:b005:l032","ordinal":166572,"en":"At the feast for my dead father Alooke,"},{"id":"semetey-1-2013:p1184:b005:l033","ordinal":166573,"en":"I will take my revenge;"},{"id":"semetey-1-2013:p1184:b005:l034","ordinal":166574,"en":"I will offer the accursed Manas"},{"id":"semetey-1-2013:p1184:b005:l035","ordinal":166575,"en":"As a sacrifice,\" he said."},{"id":"semetey-1-2013:p1184:b005:l036","ordinal":166576,"en":"Kongurbay, son of Alooke,"},{"id":"semetey-1-2013:p1184:b005:l037","ordinal":166577,"en":"Gathered his Chinese kinsmen"},{"id":"semetey-1-2013:p1185:b003:l001","ordinal":166578,"en":"By cunning he entered"},{"id":"semetey-1-2013:p1185:b003:l002","ordinal":166579,"en":"His swift black stallion."},{"id":"semetey-1-2013:p1185:b003:l003","ordinal":166580,"en":"\"Mighty Kalcha Khan Kongurbay"},{"id":"semetey-1-2013:p1185:b003:l004","ordinal":166581,"en":"Has entered his Algara,\" they said;"},{"id":"semetey-1-2013:p1185:b003:l005","ordinal":166582,"en":"The Muslim faithful did not recognize it"},{"id":"semetey-1-2013:p1185:b003:l006","ordinal":166583,"en":"And were struck by God."},{"id":"semetey-1-2013:p1185:b003:l007","ordinal":166584,"en":"Ezkara, khan of the Manchus,"},{"id":"semetey-1-2013:p1185:b003:l008","ordinal":166585,"en":"Came out surging too,"},{"id":"semetey-1-2013:p1185:b003:l009","ordinal":166586,"en":"Eagerly saying, \"I will race a horse.\""},{"id":"semetey-1-2013:p1185:b003:l010","ordinal":166587,"en":"They dressed the horses' tails,"},{"id":"semetey-1-2013:p1185:b003:l011","ordinal":166588,"en":"Paraded them back and forth,"},{"id":"semetey-1-2013:p1185:b003:l012","ordinal":166589,"en":"And did so for exactly three days."},{"id":"semetey-1-2013:p1185:b003:l013","ordinal":166590,"en":"At farthest Jelpinig,"},{"id":"semetey-1-2013:p1185:b003:l014","ordinal":166591,"en":"Peoples of seven ages came;"},{"id":"semetey-1-2013:p1185:b003:l015","ordinal":166592,"en":"Not a living soul remained behind."},{"id":"semetey-1-2013:p1185:b003:l016","ordinal":166593,"en":"For Khan Kokotoy's feast"},{"id":"semetey-1-2013:p1185:b003:l017","ordinal":166594,"en":"Every kind of people assembled."},{"id":"semetey-1-2013:p1185:b003:l018","ordinal":166595,"en":"Kokotoy's red banner"},{"id":"semetey-1-2013:p1185:b003:l019","ordinal":166596,"en":"With its golden finial"},{"id":"semetey-1-2013:p1185:b003:l020","ordinal":166597,"en":"Was raised and fluttered."},{"id":"semetey-1-2013:p1185:b003:l021","ordinal":166598,"en":"\"Drive out the horses!\" they cried then;"},{"id":"semetey-1-2013:p1185:b003:l022","ordinal":166599,"en":"The zurnay blared,"},{"id":"semetey-1-2013:p1185:b003:l023","ordinal":166600,"en":"Dust curled toward the sky,"},{"id":"semetey-1-2013:p1185:b003:l024","ordinal":166601,"en":"And people collided with people."},{"id":"semetey-1-2013:p1185:b003:l025","ordinal":166602,"en":"Hero Toshtuk, son of Eleman,"},{"id":"semetey-1-2013:p1185:b003:l026","ordinal":166603,"en":"Chose and entered Chalkuyruk."},{"id":"semetey-1-2013:p1185:b003:l027","ordinal":166604,"en":"Jamgyrchy of the Esheks"},{"id":"semetey-1-2013:p1185:b003:l028","ordinal":166605,"en":"Thought carefully and entered Akkokul."},{"id":"semetey-1-2013:p1185:b003:l029","ordinal":166606,"en":"Khan Koshoy of Katagan"},{"id":"semetey-1-2013:p1185:b003:l030","ordinal":166607,"en":"Chose and entered Kabylan."},{"id":"semetey-1-2013:p1185:b003:l031","ordinal":166608,"en":"Kokboru of Urum Khan"},{"id":"semetey-1-2013:p1185:b003:l032","ordinal":166609,"en":"Entered Kuu Kazyk as well."},{"id":"semetey-1-2013:p1185:b003:l033","ordinal":166610,"en":"Khan Kokcho of the Kazakhs"},{"id":"semetey-1-2013:p1185:b003:l034","ordinal":166611,"en":"Chose and entered Kokala."},{"id":"semetey-1-2013:p1185:b003:l035","ordinal":166612,"en":"The black gray-maned leopard"},{"id":"semetey-1-2013:p1185:b003:l036","ordinal":166613,"en":"Chose and entered Akkula."},{"id":"semetey-1-2013:p1185:b003:l037","ordinal":166614,"en":"With an armful of tack,"},{"id":"semetey-1-2013:p1185:b003:l038","ordinal":166615,"en":"Muzburchak of Buudayyk"},{"id":"semetey-1-2013:p1185:b003:l039","ordinal":166616,"en":"Began the commotion;"},{"id":"semetey-1-2013:p1185:b005:l001","ordinal":166617,"en":"He too then entered"},{"id":"semetey-1-2013:p1185:b005:l002","ordinal":166618,"en":"The racehorse Telkyzyl."},{"id":"semetey-1-2013:p1185:b005:l003","ordinal":166619,"en":"Hero Bagysh of the Jediger"},{"id":"semetey-1-2013:p1185:b005:l004","ordinal":166620,"en":"Took the narrow shortcut,"},{"id":"semetey-1-2013:p1185:b005:l005","ordinal":166621,"en":"Carefully leading and entering"},{"id":"semetey-1-2013:p1185:b005:l006","ordinal":166622,"en":"Surkiyik, swiftest of livestock."},{"id":"semetey-1-2013:p1185:b005:l007","ordinal":166623,"en":"Not a single shod colt remained;"},{"id":"semetey-1-2013:p1185:b005:l008","ordinal":166624,"en":"Every one entered the race."},{"id":"semetey-1-2013:p1185:b005:l009","ordinal":166625,"en":"The renowned tulpar steeds"},{"id":"semetey-1-2013:p1185:b005:l010","ordinal":166626,"en":"At Khan Kokotoy's celebration"},{"id":"semetey-1-2013:p1185:b005:l011","ordinal":166627,"en":"Now came out to compete."},{"id":"semetey-1-2013:p1185:b005:l012","ordinal":166628,"en":"They entered the horses on a list"},{"id":"semetey-1-2013:p1185:b005:l013","ordinal":166629,"en":"And counted them;"},{"id":"semetey-1-2013:p1185:b005:l014","ordinal":166630,"en":"The white paper filled with writing."},{"id":"semetey-1-2013:p1185:b005:l015","ordinal":166631,"en":"The racehorses at the feast"},{"id":"semetey-1-2013:p1185:b005:l016","ordinal":166632,"en":"Numbered seven thousand forty-three."},{"id":"semetey-1-2013:p1185:b005:l017","ordinal":166633,"en":"Among those horses,"},{"id":"semetey-1-2013:p1185:b005:l018","ordinal":166634,"en":"Young, tick-sized Kulatay"},{"id":"semetey-1-2013:p1185:b005:l019","ordinal":166635,"en":"Was going away in sorrow."},{"id":"semetey-1-2013:p1185:b005:l020","ordinal":166636,"en":"He was neither a three-year-old nor a yearling,"},{"id":"semetey-1-2013:p1185:b005:l021","ordinal":166637,"en":"Nor had his time to race arrived."},{"id":"semetey-1-2013:p1185:b005:l022","ordinal":166638,"en":"If only he raced at full age,"},{"id":"semetey-1-2013:p1185:b005:l023","ordinal":166639,"en":"Then he might win a prize."},{"id":"semetey-1-2013:p1185:b005:l024","ordinal":166640,"en":"Or if only he raced at three,"},{"id":"semetey-1-2013:p1185:b005:l025","ordinal":166641,"en":"Then he might win a prize."},{"id":"semetey-1-2013:p1185:b005:l026","ordinal":166642,"en":"When he reached his fifth year,"},{"id":"semetey-1-2013:p1185:b005:l027","ordinal":166643,"en":"Would he not begin the commotion"},{"id":"semetey-1-2013:p1185:b005:l028","ordinal":166644,"en":"And leave the racehorses behind?"},{"id":"semetey-1-2013:p1185:b005:l029","ordinal":166645,"en":"Would he not earn renown"},{"id":"semetey-1-2013:p1185:b005:l030","ordinal":166646,"en":"And spread his wings?"},{"id":"semetey-1-2013:p1185:b005:l031","ordinal":166647,"en":"The flesh of his calves was not yet full;"},{"id":"semetey-1-2013:p1185:b005:l032","ordinal":166648,"en":"His time to race had not yet come."},{"id":"semetey-1-2013:p1185:b005:l033","ordinal":166649,"en":"He was too young to know the land,"},{"id":"semetey-1-2013:p1185:b005:l034","ordinal":166650,"en":"Still a child at present."},{"id":"semetey-1-2013:p1185:b005:l035","ordinal":166651,"en":"If his shoulders filled out,"},{"id":"semetey-1-2013:p1185:b005:l036","ordinal":166652,"en":"And he grew fully among"},{"id":"semetey-1-2013:p1185:b005:l037","ordinal":166653,"en":"Those tulpar horses—"},{"id":"semetey-1-2013:p1185:b005:l038","ordinal":166654,"en":"There would be no overcoming Akkula,"},{"id":"semetey-1-2013:p1185:b005:l039","ordinal":166655,"en":"And no questioning Surkula,"},{"id":"semetey-1-2013:p1186:b003:l001","ordinal":166656,"en":"No remedy against Chalkuyruk."}]
