[{"id":"seytek-2012:p0775:b002:l019","ordinal":354561,"en":"Aichürök, Akun’s daughter,"},{"id":"seytek-2012:p0775:b002:l020","ordinal":354562,"en":"Traversed the whole wide earth,"},{"id":"seytek-2012:p0775:b002:l021","ordinal":354563,"en":"And wandered throughout the universe;"},{"id":"seytek-2012:p0775:b002:l022","ordinal":354564,"en":"I drained away her sorrowful blood,"},{"id":"seytek-2012:p0775:b002:l023","ordinal":354565,"en":"And aged her noble head."},{"id":"seytek-2012:p0775:b002:l024","ordinal":354566,"en":"Her heart pierced, she withdrew,"},{"id":"seytek-2012:p0775:b002:l025","ordinal":354567,"en":"And from Sarybai’s wrath"},{"id":"seytek-2012:p0775:b002:l026","ordinal":354568,"en":"Tears poured from her eyes;"},{"id":"seytek-2012:p0775:b002:l027","ordinal":354569,"en":"Only a spoonful of blood remained,"},{"id":"seytek-2012:p0775:b002:l028","ordinal":354570,"en":"Her fly-sized soul shrieked,"},{"id":"seytek-2012:p0775:b002:l029","ordinal":354571,"en":"Unable to endure, she sobbed,"},{"id":"seytek-2012:p0775:b002:l030","ordinal":354572,"en":"Her heart pierced by sorrow, she withdrew,"},{"id":"seytek-2012:p0775:b002:l031","ordinal":354573,"en":"And tears poured from her eyes;"},{"id":"seytek-2012:p0775:b002:l032","ordinal":354574,"en":"Her fly-sized soul shrieked,"},{"id":"seytek-2012:p0775:b002:l033","ordinal":354575,"en":"Truly entering in, she was battered,"},{"id":"seytek-2012:p0775:b002:l034","ordinal":354576,"en":"And pleaded with wretched me."},{"id":"seytek-2012:p0775:b002:l035","ordinal":354577,"en":"The reason for her pleading was—"},{"id":"seytek-2012:p0775:b002:l036","ordinal":354578,"en":"The stars in heaven were dim,"},{"id":"seytek-2012:p0775:b002:l037","ordinal":354579,"en":"And she, ill-fated like me,"},{"id":"seytek-2012:p0775:b002:l038","ordinal":354580,"en":"Was my sworn friend unto the afterlife."},{"id":"seytek-2012:p0775:b002:l039","ordinal":354581,"en":"That accursed enemy Sarybai—"},{"id":"seytek-2012:p0775:b002:l040","ordinal":354582,"en":"The swine’s cruelty has gone too far;"},{"id":"seytek-2012:p0775:b003:l001","ordinal":354583,"en":"“Let there be a mighty exchange of shots,"},{"id":"seytek-2012:p0775:b003:l002","ordinal":354584,"en":"And by Almighty God’s wrath"},{"id":"seytek-2012:p0775:b003:l003","ordinal":354585,"en":"Deliver them,” she said."},{"id":"seytek-2012:p0775:b003:l004","ordinal":354586,"en":"God created him as a lion,"},{"id":"seytek-2012:p0775:b003:l005","ordinal":354587,"en":"The doomed sultan Semetey,"},{"id":"seytek-2012:p0775:b003:l006","ordinal":354588,"en":"Whose fortune was perfect."},{"id":"seytek-2012:p0775:b003:l007","ordinal":354589,"en":"If you looked into his heart,"},{"id":"seytek-2012:p0775:b003:l008","ordinal":354590,"en":"It was broader than the earth."},{"id":"seytek-2012:p0775:b003:l009","ordinal":354591,"en":"Born of man and woman,"},{"id":"seytek-2012:p0775:b003:l010","ordinal":354592,"en":"Such a dear lion was created but once;"},{"id":"seytek-2012:p0775:b003:l011","ordinal":354593,"en":"His like could never be among mankind."},{"id":"seytek-2012:p0775:b003:l012","ordinal":354594,"en":"Take the sun-faced noble sultan"},{"id":"seytek-2012:p0775:b003:l013","ordinal":354595,"en":"To be your husband."},{"id":"seytek-2012:p0775:b003:l014","ordinal":354596,"en":"Against the grievous foe Sarybai,"},{"id":"seytek-2012:p0775:b003:l015","ordinal":354597,"en":"Wage the struggle with all your might."},{"id":"seytek-2012:p0775:b003:l016","ordinal":354598,"en":"From the hands of that savage dog,"},{"id":"seytek-2012:p0775:b003:l017","ordinal":354599,"en":"Let Semetey’s Seytek"},{"id":"seytek-2012:p0775:b003:l018","ordinal":354600,"en":"And Külchoro, son of Almambet,"},{"id":"seytek-2012:p0775:b003:l019","ordinal":354601,"en":"Be delivered,” she said."},{"id":"seytek-2012:p0775:b003:l020","ordinal":354602,"en":"Chürök cried and wailed,"},{"id":"seytek-2012:p0775:b003:l021","ordinal":354603,"en":"Speaking graceful, honeyed words,"},{"id":"seytek-2012:p0775:b003:l022","ordinal":354604,"en":"And lamenting with bitter sobs."},{"id":"seytek-2012:p0775:b003:l023","ordinal":354605,"en":"From the spirits I heard the news"},{"id":"seytek-2012:p0775:b003:l024","ordinal":354606,"en":"That my beloved Semetey"},{"id":"seytek-2012:p0775:b003:l025","ordinal":354607,"en":"Was locked in enmity"},{"id":"seytek-2012:p0775:b003:l026","ordinal":354608,"en":"With the hero, son of the ogre;"},{"id":"seytek-2012:p0775:b003:l027","ordinal":354609,"en":"Of the fierce gunfire"},{"id":"seytek-2012:p0775:b003:l028","ordinal":354610,"en":"I heard, and came to rescue him"},{"id":"seytek-2012:p0775:b003:l029","ordinal":354611,"en":"From the magnanimous hero’s son."},{"id":"seytek-2012:p0775:b003:l030","ordinal":354612,"en":"In frantic haste I traveled,"},{"id":"seytek-2012:p0775:b003:l031","ordinal":354613,"en":"Never resting by day,"},{"id":"seytek-2012:p0775:b003:l032","ordinal":354614,"en":"Never taking a day’s repose,"},{"id":"seytek-2012:p0775:b003:l033","ordinal":354615,"en":"Never lying down to ease my hips,"},{"id":"seytek-2012:p0775:b003:l034","ordinal":354616,"en":"Never reclining to satisfy my sleep,"},{"id":"seytek-2012:p0775:b003:l035","ordinal":354617,"en":"Crossing towering lofty mountains,"},{"id":"seytek-2012:p0775:b003:l036","ordinal":354618,"en":"Wading through deep ravines,"},{"id":"seytek-2012:p0775:b003:l037","ordinal":354619,"en":"Driving the horse relentlessly onward,"},{"id":"seytek-2012:p0775:b003:l038","ordinal":354620,"en":"Crossing passes and treading stones,"},{"id":"seytek-2012:p0775:b003:l039","ordinal":354621,"en":"Until at last I arrived and made camp."},{"id":"seytek-2012:p0775:b003:l040","ordinal":354622,"en":"When the horse grew as small as a lark,"},{"id":"seytek-2012:p0776:b002:l001","ordinal":354623,"en":"In frantic haste I traveled,"},{"id":"seytek-2012:p0776:b002:l002","ordinal":354624,"en":"And came through tumult and turmoil."},{"id":"seytek-2012:p0776:b002:l003","ordinal":354625,"en":"My beloved hero Sultan—"},{"id":"seytek-2012:p0776:b002:l004","ordinal":354626,"en":"I have seen the bloodthirsty lion!"},{"id":"seytek-2012:p0776:b002:l005","ordinal":354627,"en":"When sent ahead, he brought good fortune;"},{"id":"seytek-2012:p0776:b002:l006","ordinal":354628,"en":"When riding behind, he equaled countless troops."},{"id":"seytek-2012:p0776:b002:l007","ordinal":354629,"en":"He wore a blue lynx-fur cap,"},{"id":"seytek-2012:p0776:b002:l008","ordinal":354630,"en":"And wielded a mottled-blue shield;"},{"id":"seytek-2012:p0776:b002:l009","ordinal":354631,"en":"He spared no soul who faced him."},{"id":"seytek-2012:p0776:b002:l010","ordinal":354632,"en":"His eyes saw from afar;"},{"id":"seytek-2012:p0776:b002:l011","ordinal":354633,"en":"Amid a great assembly,"},{"id":"seytek-2012:p0776:b002:l012","ordinal":354634,"en":"He emerged alone from the race."},{"id":"seytek-2012:p0776:b002:l013","ordinal":354635,"en":"The mightiest of saints,"},{"id":"seytek-2012:p0776:b002:l014","ordinal":354636,"en":"The fortress of the blessed lion."},{"id":"seytek-2012:p0776:b002:l015","ordinal":354637,"en":"Precious elder Bakai,"},{"id":"seytek-2012:p0776:b002:l016","ordinal":354638,"en":"A saint who knew the ages,"},{"id":"seytek-2012:p0776:b002:l017","ordinal":354639,"en":"Your fortunate uncle Bakai—"},{"id":"seytek-2012:p0776:b002:l018","ordinal":354640,"en":"Behold how great his dignity."},{"id":"seytek-2012:p0776:b002:l019","ordinal":354641,"en":"His blessing enriched the soul,"},{"id":"seytek-2012:p0776:b002:l020","ordinal":354642,"en":"His worth brought radiance to life."},{"id":"seytek-2012:p0776:b002:l021","ordinal":354643,"en":"His word was never spoken twice,"},{"id":"seytek-2012:p0776:b002:l022","ordinal":354644,"en":"And he watched over the whole universe."},{"id":"seytek-2012:p0776:b002:l023","ordinal":354645,"en":"He received letters from many lands,"},{"id":"seytek-2012:p0776:b002:l024","ordinal":354646,"en":"And forty blessings from Kydyr."},{"id":"seytek-2012:p0776:b002:l025","ordinal":354647,"en":"He became known as precious Bakai,"},{"id":"seytek-2012:p0776:b002:l026","ordinal":354648,"en":"And received blessings from men of wisdom."},{"id":"seytek-2012:p0776:b002:l027","ordinal":354649,"en":"He taught the ignorant to know,"},{"id":"seytek-2012:p0776:b002:l028","ordinal":354650,"en":"And set a thousand upon the right path."},{"id":"seytek-2012:p0776:b002:l029","ordinal":354651,"en":"My forefather, elder Bakai,"},{"id":"seytek-2012:p0776:b002:l030","ordinal":354652,"en":"Before the magnanimous lion"},{"id":"seytek-2012:p0776:b002:l031","ordinal":354653,"en":"Gathered ninety holy men,"},{"id":"seytek-2012:p0776:b002:l032","ordinal":354654,"en":"And had them solemnly perform the marriage."},{"id":"seytek-2012:p0776:b002:l033","ordinal":354655,"en":"Elder Bakai the peacemaker,"},{"id":"seytek-2012:p0776:b002:l034","ordinal":354656,"en":"After giving the poor daughter of Kaiypchal"},{"id":"seytek-2012:p0776:b002:l035","ordinal":354657,"en":"In marriage to the bloodthirsty hero,"},{"id":"seytek-2012:p0776:b002:l036","ordinal":354658,"en":"Like stars in the heavens"},{"id":"seytek-2012:p0776:b002:l037","ordinal":354659,"en":"They stirred together,"},{"id":"seytek-2012:p0776:b002:l038","ordinal":354660,"en":"And the two lions embraced,"},{"id":"seytek-2012:p0776:b002:l039","ordinal":354661,"en":"Lioness and lion together;"},{"id":"seytek-2012:p0776:b002:l040","ordinal":354662,"en":"Once they had united,"},{"id":"seytek-2012:p0776:b003:l001","ordinal":354663,"en":"Like fine white-wheat flour"},{"id":"seytek-2012:p0776:b003:l002","ordinal":354664,"en":"They blended into one,"},{"id":"seytek-2012:p0776:b003:l003","ordinal":354665,"en":"Like the soft down of a white gazelle"},{"id":"seytek-2012:p0776:b003:l004","ordinal":354666,"en":"They slipped together."},{"id":"seytek-2012:p0776:b003:l005","ordinal":354667,"en":"They sank into delight,"},{"id":"seytek-2012:p0776:b003:l006","ordinal":354668,"en":"And lay upon one bed;"},{"id":"seytek-2012:p0776:b003:l007","ordinal":354669,"en":"They settled in a fitting place,"},{"id":"seytek-2012:p0776:b003:l008","ordinal":354670,"en":"And joined as husband and wife."},{"id":"seytek-2012:p0776:b003:l009","ordinal":354671,"en":"Because of a calamitous affair,"},{"id":"seytek-2012:p0776:b003:l010","ordinal":354672,"en":"Sarybai, son of the ogre—"},{"id":"seytek-2012:p0776:b003:l011","ordinal":354673,"en":"For all that Sarybai possessed,"},{"id":"seytek-2012:p0776:b003:l012","ordinal":354674,"en":"Against that infidel son of the ogre"},{"id":"seytek-2012:p0776:b003:l013","ordinal":354675,"en":"A swung sword could not cut,"},{"id":"seytek-2012:p0776:b003:l014","ordinal":354676,"en":"A lion’s teeth could not pierce,"},{"id":"seytek-2012:p0776:b003:l015","ordinal":354677,"en":"And human strength could not prevail."},{"id":"seytek-2012:p0776:b003:l016","ordinal":354678,"en":"Because of Sarybai’s wrath,"},{"id":"seytek-2012:p0776:b003:l017","ordinal":354679,"en":"And the venom he poured upon the people,"},{"id":"seytek-2012:p0776:b003:l018","ordinal":354680,"en":"Brave Semeñ, son of Manas,"},{"id":"seytek-2012:p0776:b003:l019","ordinal":354681,"en":"Took Kuyaly, daughter of Kaiypchal,"},{"id":"seytek-2012:p0776:b003:l020","ordinal":354682,"en":"The champion maiden, as his wife;"},{"id":"seytek-2012:p0776:b003:l021","ordinal":354683,"en":"Then that champion maiden"},{"id":"seytek-2012:p0776:b003:l022","ordinal":354684,"en":"Began the fierce combat."},{"id":"seytek-2012:p0776:b003:l023","ordinal":354685,"en":"The great epic is a mighty wonder;"},{"id":"seytek-2012:p0776:b003:l024","ordinal":354686,"en":"Many times they fought."},{"id":"seytek-2012:p0776:b003:l025","ordinal":354687,"en":"Of savage infidel Sarybai,"},{"id":"seytek-2012:p0776:b003:l026","ordinal":354688,"en":"She told the whole tale."},{"id":"seytek-2012:p0776:b003:l027","ordinal":354689,"en":"Kaiypchal and the Ogre"},{"id":"seytek-2012:p0776:b003:l028","ordinal":354690,"en":"Shared the land where grain was sown,"},{"id":"seytek-2012:p0776:b003:l029","ordinal":354691,"en":"Shared the people in splendid prosperity,"},{"id":"seytek-2012:p0776:b003:l030","ordinal":354692,"en":"And shared the ground of fold and dwelling."},{"id":"seytek-2012:p0776:b003:l031","ordinal":354693,"en":"Speaking of humiliation and hardship,"},{"id":"seytek-2012:p0776:b003:l032","ordinal":354694,"en":"Kuyaly, daughter of Kaiypchal,"},{"id":"seytek-2012:p0776:b003:l033","ordinal":354695,"en":"Entered the great dispute."},{"id":"seytek-2012:p0776:b003:l034","ordinal":354696,"en":"Into a vast calamity with no end,"},{"id":"seytek-2012:p0776:b003:l035","ordinal":354697,"en":"Into the turmoil she plunged."},{"id":"seytek-2012:p0776:b003:l036","ordinal":354698,"en":"She told of the ridge"},{"id":"seytek-2012:p0776:b003:l037","ordinal":354699,"en":"Of a pass no mortal could cross."},{"id":"seytek-2012:p0776:b003:l038","ordinal":354700,"en":"Of the clash with Sarybai,"},{"id":"seytek-2012:p0776:b003:l039","ordinal":354701,"en":"Of countless ordeals and great commotion,"},{"id":"seytek-2012:p0776:b003:l040","ordinal":354702,"en":"She told the whole conflict."},{"id":"seytek-2012:p0777:b002:l001","ordinal":354703,"en":"Of the great quarrel with Sarybai,"},{"id":"seytek-2012:p0777:b002:l002","ordinal":354704,"en":"She began the epic, revealing its secrets."},{"id":"seytek-2012:p0777:b002:l003","ordinal":354705,"en":"The vast ordeal, the deep conflict—"},{"id":"seytek-2012:p0777:b002:l004","ordinal":354706,"en":"That wondrous, mighty epic,"},{"id":"seytek-2012:p0777:b002:l005","ordinal":354707,"en":"She told it all."},{"id":"seytek-2012:p0777:b002:l006","ordinal":354708,"en":"When God granted her wish,"},{"id":"seytek-2012:p0777:b002:l007","ordinal":354709,"en":"The desire and purpose she had sought,"},{"id":"seytek-2012:p0777:b002:l008","ordinal":354710,"en":"When God freely granted it,"},{"id":"seytek-2012:p0777:b002:l009","ordinal":354711,"en":"She drew the reins of fleet-footed Jeljetpes"},{"id":"seytek-2012:p0777:b002:l010","ordinal":354712,"en":"And turned his head."},{"id":"seytek-2012:p0777:b002:l011","ordinal":354713,"en":"The one she would grapple with was Sarybai,"},{"id":"seytek-2012:p0777:b002:l012","ordinal":354714,"en":"Such was the savage enemy."},{"id":"seytek-2012:p0777:b002:l013","ordinal":354715,"en":"Gentle in nature and broad of heart,"},{"id":"seytek-2012:p0777:b002:l014","ordinal":354716,"en":"Such was the champion maiden’s way."},{"id":"seytek-2012:p0777:b002:l015","ordinal":354717,"en":"She turned the horse’s head,"},{"id":"seytek-2012:p0777:b002:l016","ordinal":354718,"en":"And of all the saintly heroes—"},{"id":"seytek-2012:p0777:b002:l017","ordinal":354719,"en":"Lion Bakai and Kanykei,"},{"id":"seytek-2012:p0777:b002:l018","ordinal":354720,"en":"And heroes such as these—"},{"id":"seytek-2012:p0777:b002:l019","ordinal":354721,"en":"She now asked their blessing."},{"id":"seytek-2012:p0777:b002:l020","ordinal":354722,"en":"“Toward sunrise with banners streaming"},{"id":"seytek-2012:p0777:b002:l021","ordinal":354723,"en":"Lay the road I myself once rode."},{"id":"seytek-2012:p0777:b002:l022","ordinal":354724,"en":"That infidel son of the ogre"},{"id":"seytek-2012:p0777:b002:l023","ordinal":354725,"en":"This hand has speared seven times."},{"id":"seytek-2012:p0777:b002:l024","ordinal":354726,"en":"He split lungs and severed heads,"},{"id":"seytek-2012:p0777:b002:l025","ordinal":354727,"en":"Stirred strife and spilled blood;"},{"id":"seytek-2012:p0777:b002:l026","ordinal":354728,"en":"He was an enemy bearing a blood feud."},{"id":"seytek-2012:p0777:b002:l027","ordinal":354729,"en":"Let me wage the battle freely;"},{"id":"seytek-2012:p0777:b002:l028","ordinal":354730,"en":"For the common folk, for the people,"},{"id":"seytek-2012:p0777:b002:l029","ordinal":354731,"en":"Against the savage foe Sarybai,"},{"id":"seytek-2012:p0777:b002:l030","ordinal":354732,"en":"Let me clash in combat."},{"id":"seytek-2012:p0777:b002:l031","ordinal":354733,"en":"My lion father, khan Bakai,"},{"id":"seytek-2012:p0777:b002:l032","ordinal":354734,"en":"My aged mother Kanykei,"},{"id":"seytek-2012:p0777:b002:l033","ordinal":354735,"en":"If you give your blessing, let me receive it."},{"id":"seytek-2012:p0777:b002:l034","ordinal":354736,"en":"For the common folk, for the people,"},{"id":"seytek-2012:p0777:b002:l035","ordinal":354737,"en":"Let me wage the conflict fiercely."},{"id":"seytek-2012:p0777:b002:l036","ordinal":354738,"en":"If true death reaches me, let me die;"},{"id":"seytek-2012:p0777:b002:l037","ordinal":354739,"en":"If what Creator Allah has ordained"},{"id":"seytek-2012:p0777:b002:l038","ordinal":354740,"en":"Falls upon my brow, let me face it."},{"id":"seytek-2012:p0777:b002:l039","ordinal":354741,"en":"For the common folk, for the people,"},{"id":"seytek-2012:p0777:b002:l040","ordinal":354742,"en":"For the lost magnanimous lion,"},{"id":"seytek-2012:p0777:b004:l001","ordinal":354743,"en":"For my lion brother-in-law Külchoro,"},{"id":"seytek-2012:p0777:b004:l002","ordinal":354744,"en":"Above all, for you,"},{"id":"seytek-2012:p0777:b004:l003","ordinal":354745,"en":"For the countless downcast host,"},{"id":"seytek-2012:p0777:b004:l004","ordinal":354746,"en":"For the blue-maned boy Seytek,"},{"id":"seytek-2012:p0777:b004:l005","ordinal":354747,"en":"Let me face the true decree;"},{"id":"seytek-2012:p0777:b004:l006","ordinal":354748,"en":"If true death reaches me, let me die!"},{"id":"seytek-2012:p0777:b004:l007","ordinal":354749,"en":"For all the heroes, for you,"},{"id":"seytek-2012:p0777:b004:l008","ordinal":354750,"en":"Let me sooner behold"},{"id":"seytek-2012:p0777:b004:l009","ordinal":354751,"en":"The true realm whence none return."},{"id":"seytek-2012:p0777:b004:l010","ordinal":354752,"en":"If I am granted days of honor and success,"},{"id":"seytek-2012:p0777:b004:l011","ordinal":354753,"en":"Let me grapple with Sarybai, whom I hunt,"},{"id":"seytek-2012:p0777:b004:l012","ordinal":354754,"en":"And spill his blood."},{"id":"seytek-2012:p0777:b004:l013","ordinal":354755,"en":"Against the enemy who brought my father calamity,"},{"id":"seytek-2012:p0777:b004:l014","ordinal":354756,"en":"Let me strike without mercy."},{"id":"seytek-2012:p0777:b004:l015","ordinal":354757,"en":"From the enemy who oppresses us,"},{"id":"seytek-2012:p0777:b004:l016","ordinal":354758,"en":"Let me avenge six generations of my fathers."},{"id":"seytek-2012:p0777:b004:l017","ordinal":354759,"en":"If I find the means, let me plunge the villain"},{"id":"seytek-2012:p0777:b004:l018","ordinal":354760,"en":"Into grievous misery."},{"id":"seytek-2012:p0777:b004:l019","ordinal":354761,"en":"If the Creator does not will it,"},{"id":"seytek-2012:p0777:b004:l020","ordinal":354762,"en":"Let me die at the infidel’s hands."},{"id":"seytek-2012:p0777:b004:l021","ordinal":354763,"en":"Infidel and Muslim alike—"},{"id":"seytek-2012:p0777:b004:l022","ordinal":354764,"en":"How many people have been beset by war?"},{"id":"seytek-2012:p0777:b004:l023","ordinal":354765,"en":"The one I shall grapple with is Sarybai;"},{"id":"seytek-2012:p0777:b004:l024","ordinal":354766,"en":"Such is the infidel’s nature."},{"id":"seytek-2012:p0777:b004:l025","ordinal":354767,"en":"God knows who shall die;"},{"id":"seytek-2012:p0777:b004:l026","ordinal":354768,"en":"God knows whether one will turn back"},{"id":"seytek-2012:p0777:b004:l027","ordinal":354769,"en":"And return safely from the villain."},{"id":"seytek-2012:p0777:b004:l028","ordinal":354770,"en":"His calamities are many, his venom strong;"},{"id":"seytek-2012:p0777:b004:l029","ordinal":354771,"en":"He lays flat whoever encounters him."},{"id":"seytek-2012:p0777:b004:l030","ordinal":354772,"en":"His strength is extraordinary,"},{"id":"seytek-2012:p0777:b004:l031","ordinal":354773,"en":"And his heroism is manifold;"},{"id":"seytek-2012:p0777:b004:l032","ordinal":354774,"en":"His venom is potent, his nature harsh—"},{"id":"seytek-2012:p0777:b004:l033","ordinal":354775,"en":"Such is the grievous work"},{"id":"seytek-2012:p0777:b004:l034","ordinal":354776,"en":"Of this blazing Sarybai."},{"id":"seytek-2012:p0777:b004:l035","ordinal":354777,"en":"Once my bloodthirsty, blue-maned father-in-law"},{"id":"seytek-2012:p0777:b004:l036","ordinal":354778,"en":"Was slaughtering the Chinese"},{"id":"seytek-2012:p0777:b004:l037","ordinal":354779,"en":"At the height of the massacre."},{"id":"seytek-2012:p0777:b004:l038","ordinal":354780,"en":"He trampled the whole universe"},{"id":"seytek-2012:p0777:b004:l039","ordinal":354781,"en":"And cleaved through it."},{"id":"seytek-2012:p0777:b004:l040","ordinal":354782,"en":"When the mighty Zulfiqar"},{"id":"seytek-2012:p0778:b002:l001","ordinal":354783,"en":"Was destined to come into being."},{"id":"seytek-2012:p0778:b002:l002","ordinal":354784,"en":"When he subdued the teeming enemy"},{"id":"seytek-2012:p0778:b002:l003","ordinal":354785,"en":"And waged war against them."},{"id":"seytek-2012:p0778:b002:l004","ordinal":354786,"en":"From the desert of Medina,"},{"id":"seytek-2012:p0778:b002:l005","ordinal":354787,"en":"From the shore of Jön Turbas,"},{"id":"seytek-2012:p0778:b002:l006","ordinal":354788,"en":"From this side of Künümdük,"},{"id":"seytek-2012:p0778:b002:l007","ordinal":354789,"en":"From the fortress of Jan-Baspas,"},{"id":"seytek-2012:p0778:b002:l008","ordinal":354790,"en":"It appeared to him from the unseen."},{"id":"seytek-2012:p0778:b002:l009","ordinal":354791,"en":"There was no cawing crow,"},{"id":"seytek-2012:p0778:b002:l010","ordinal":354792,"en":"No croaking raven in flight,"},{"id":"seytek-2012:p0778:b002:l011","ordinal":354793,"en":"No serpent slithering away,"},{"id":"seytek-2012:p0778:b002:l012","ordinal":354794,"en":"No wild ass frolicking there;"},{"id":"seytek-2012:p0778:b002:l013","ordinal":354795,"en":"By many decrees it came to him."},{"id":"seytek-2012:p0778:b002:l014","ordinal":354796,"en":"“It is unique upon the earth,” they said;"},{"id":"seytek-2012:p0778:b002:l015","ordinal":354797,"en":"By Allah’s favor it appeared,"},{"id":"seytek-2012:p0778:b002:l016","ordinal":354798,"en":"And was found upon the empty steppe."},{"id":"seytek-2012:p0778:b002:l017","ordinal":354799,"en":"There a mortal marked for death was found;"},{"id":"seytek-2012:p0778:b002:l018","ordinal":354800,"en":"For the blue-maned lion hero"},{"id":"seytek-2012:p0778:b002:l019","ordinal":354801,"en":"It was found by Allah’s decree."},{"id":"seytek-2012:p0778:b002:l020","ordinal":354802,"en":"Laid upon grass, it set it aflame;"},{"id":"seytek-2012:p0778:b002:l021","ordinal":354803,"en":"Those it struck died in an instant."},{"id":"seytek-2012:p0778:b002:l022","ordinal":354804,"en":"When drawn in the dark of night,"},{"id":"seytek-2012:p0778:b002:l023","ordinal":354805,"en":"Its edge burned red with flame."},{"id":"seytek-2012:p0778:b002:l024","ordinal":354806,"en":"When swung against a formidable foe,"},{"id":"seytek-2012:p0778:b002:l025","ordinal":354807,"en":"It lengthened to forty fathoms."},{"id":"seytek-2012:p0778:b002:l026","ordinal":354808,"en":"When drawn in wrath,"},{"id":"seytek-2012:p0778:b002:l027","ordinal":354809,"en":"It never went without drinking blood."},{"id":"seytek-2012:p0778:b002:l028","ordinal":354810,"en":"Until it was fully sated with blood,"},{"id":"seytek-2012:p0778:b002:l029","ordinal":354811,"en":"It would not return to its sheath."},{"id":"seytek-2012:p0778:b002:l030","ordinal":354812,"en":"My father-in-law’s Zulfiqar—"},{"id":"seytek-2012:p0778:b002:l031","ordinal":354813,"en":"I desire to take it."},{"id":"seytek-2012:p0778:b002:l032","ordinal":354814,"en":"Against the infidel son of the ogre,"},{"id":"seytek-2012:p0778:b002:l033","ordinal":354815,"en":"If I reach him, let me wield the sword."},{"id":"seytek-2012:p0778:b002:l034","ordinal":354816,"en":"Let me test myself in true combat,"}]
