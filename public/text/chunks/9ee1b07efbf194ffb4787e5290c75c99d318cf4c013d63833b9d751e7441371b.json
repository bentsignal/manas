[{"id":"semetey-2-2013:p1216:b004:l027","ordinal":280321,"en":"Spears lay scattered on the ground,"},{"id":"semetey-2-2013:p1216:b004:l028","ordinal":280322,"en":"Dead horses appeared"},{"id":"semetey-2-2013:p1216:b004:l029","ordinal":280323,"en":"With teeth bared wide."},{"id":"semetey-2-2013:p1216:b004:l030","ordinal":280324,"en":"Warriors lay stroking their mustaches,"},{"id":"semetey-2-2013:p1216:b004:l031","ordinal":280325,"en":"And heroes’ blood poured out."},{"id":"semetey-2-2013:p1216:b004:l032","ordinal":280326,"en":"Many more saw the matchlocks and commands,"},{"id":"semetey-2-2013:p1216:b004:l033","ordinal":280327,"en":"Watching from afar;"},{"id":"semetey-2-2013:p1216:b004:l034","ordinal":280328,"en":"Many more fled in panicked terror,"},{"id":"semetey-2-2013:p1216:b004:l035","ordinal":280329,"en":"While many lay dying."},{"id":"semetey-2-2013:p1216:b004:l036","ordinal":280330,"en":"Many more rushed about in deafening tumult,"},{"id":"semetey-2-2013:p1216:b004:l037","ordinal":280331,"en":"And many were struck with panic."},{"id":"semetey-2-2013:p1216:b004:l038","ordinal":280332,"en":"At the forked pass and high ridge,"},{"id":"semetey-2-2013:p1216:b004:l039","ordinal":280333,"en":"They could find no way of escape."},{"id":"semetey-2-2013:p1217:b003:l001","ordinal":280334,"en":"Many were already crossing beyond,"},{"id":"semetey-2-2013:p1217:b003:l002","ordinal":280335,"en":"Dropping their spears to the ground,"},{"id":"semetey-2-2013:p1217:b003:l003","ordinal":280336,"en":"Unable to stoop and pick them up,"},{"id":"semetey-2-2013:p1217:b003:l004","ordinal":280337,"en":"Many were fleeing onward."},{"id":"semetey-2-2013:p1217:b003:l005","ordinal":280338,"en":"Their saddle-cruppers snapped,"},{"id":"semetey-2-2013:p1217:b003:l006","ordinal":280339,"en":"And many a fleet steed"},{"id":"semetey-2-2013:p1217:b003:l007","ordinal":280340,"en":"Had its saddle slip onto its neck;"},{"id":"semetey-2-2013:p1217:b003:l008","ordinal":280341,"en":"Many a valiant warrior,"},{"id":"semetey-2-2013:p1217:b003:l009","ordinal":280342,"en":"Thinking, “Now we are doomed to die,”"},{"id":"semetey-2-2013:p1217:b003:l010","ordinal":280343,"en":"Was fleeing in terror."},{"id":"semetey-2-2013:p1217:b003:l011","ordinal":280344,"en":"In their frantic haste,"},{"id":"semetey-2-2013:p1217:b003:l012","ordinal":280345,"en":"Many trampled one another."},{"id":"semetey-2-2013:p1217:b003:l013","ordinal":280346,"en":"Many a swift racing steed"},{"id":"semetey-2-2013:p1217:b003:l014","ordinal":280347,"en":"Had its saddle slip beneath its belly"},{"id":"semetey-2-2013:p1217:b003:l015","ordinal":280348,"en":"And wandered about unharnessed."},{"id":"semetey-2-2013:p1217:b003:l016","ordinal":280349,"en":"“Father! Alas, my dear brother"},{"id":"semetey-2-2013:p1217:b003:l017","ordinal":280350,"en":"Died at such-and-such a place;"},{"id":"semetey-2-2013:p1217:b003:l018","ordinal":280351,"en":"Where shall I ever see him again?”"},{"id":"semetey-2-2013:p1217:b003:l019","ordinal":280352,"en":"Many wandered, wailing so."},{"id":"semetey-2-2013:p1217:b003:l020","ordinal":280353,"en":"Barefoot and bareheaded,"},{"id":"semetey-2-2013:p1217:b003:l021","ordinal":280354,"en":"Unable to die though wishing for death,"},{"id":"semetey-2-2013:p1217:b003:l022","ordinal":280355,"en":"Straining their wits for some escape,"},{"id":"semetey-2-2013:p1217:b003:l023","ordinal":280356,"en":"Many hid their precious lives"},{"id":"semetey-2-2013:p1217:b003:l024","ordinal":280357,"en":"In scattered places across the open steppe,"},{"id":"semetey-2-2013:p1217:b003:l025","ordinal":280358,"en":"And fled away."},{"id":"semetey-2-2013:p1217:b003:l026","ordinal":280359,"en":"When Külchoro wrought slaughter,"},{"id":"semetey-2-2013:p1217:b003:l027","ordinal":280360,"en":"There was no respite day or night;"},{"id":"semetey-2-2013:p1217:b003:l028","ordinal":280361,"en":"As the carnage raged,"},{"id":"semetey-2-2013:p1217:b003:l029","ordinal":280362,"en":"Many people fell sick with fever,"},{"id":"semetey-2-2013:p1217:b003:l030","ordinal":280363,"en":"And many were scattered before me."},{"id":"semetey-2-2013:p1217:b003:l031","ordinal":280364,"en":"Unable to find their bearings,"},{"id":"semetey-2-2013:p1217:b003:l032","ordinal":280365,"en":"Many panicked, helpless and distraught;"},{"id":"semetey-2-2013:p1217:b003:l033","ordinal":280366,"en":"Despairing of their wretched lives,"},{"id":"semetey-2-2013:p1217:b003:l034","ordinal":280367,"en":"Lamenting, “Now we are dead,”"},{"id":"semetey-2-2013:p1217:b003:l035","ordinal":280368,"en":"The warrior began the massacre."},{"id":"semetey-2-2013:p1217:b003:l036","ordinal":280369,"en":"All the common folk of Jediger,"},{"id":"semetey-2-2013:p1217:b003:l037","ordinal":280370,"en":"Suffering punishment in their very lives,"},{"id":"semetey-2-2013:p1217:b003:l038","ordinal":280371,"en":"Abandoned all hope of survival."},{"id":"semetey-2-2013:p1217:b003:l039","ordinal":280372,"en":"The dreadful battle and turmoil"},{"id":"semetey-2-2013:p1217:b005:l001","ordinal":280373,"en":"Were begun by the lone warrior;"},{"id":"semetey-2-2013:p1217:b005:l002","ordinal":280374,"en":"The Jediger, one and all,"},{"id":"semetey-2-2013:p1217:b005:l003","ordinal":280375,"en":"Found no refuge anywhere—"},{"id":"semetey-2-2013:p1217:b005:l004","ordinal":280376,"en":"Such was the fury of their clash—"},{"id":"semetey-2-2013:p1217:b005:l005","ordinal":280377,"en":"And found no place to hide."},{"id":"semetey-2-2013:p1217:b005:l006","ordinal":280378,"en":"The Jediger were seized by panic."},{"id":"semetey-2-2013:p1217:b005:l007","ordinal":280379,"en":"Their heroes Kyyaz and Kanchoro,"},{"id":"semetey-2-2013:p1217:b005:l008","ordinal":280380,"en":"Raising a tumult together,"},{"id":"semetey-2-2013:p1217:b005:l009","ordinal":280381,"en":"Fled, trampling over the people."},{"id":"semetey-2-2013:p1217:b005:l010","ordinal":280382,"en":"The terrified Jediger"},{"id":"semetey-2-2013:p1217:b005:l011","ordinal":280383,"en":"Fled, trampling even those two."},{"id":"semetey-2-2013:p1217:b005:l012","ordinal":280384,"en":"Seeing the Jediger, Kanchoro’s"},{"id":"semetey-2-2013:p1217:b005:l013","ordinal":280385,"en":"Hair bristled at the nape;"},{"id":"semetey-2-2013:p1217:b005:l014","ordinal":280386,"en":"As though ready to slaughter them,"},{"id":"semetey-2-2013:p1217:b005:l015","ordinal":280387,"en":"He twisted about, his body bristling,"},{"id":"semetey-2-2013:p1217:b005:l016","ordinal":280388,"en":"And roared in fury."},{"id":"semetey-2-2013:p1217:b005:l017","ordinal":280389,"en":"He turned the great fleeing host back"},{"id":"semetey-2-2013:p1217:b005:l018","ordinal":280390,"en":"And drove them together once more;"},{"id":"semetey-2-2013:p1217:b005:l019","ordinal":280391,"en":"Rumbling and working himself up,"},{"id":"semetey-2-2013:p1217:b005:l020","ordinal":280392,"en":"He addressed the Jediger:"},{"id":"semetey-2-2013:p1217:b005:l021","ordinal":280393,"en":"“Damn you, Jediger!"},{"id":"semetey-2-2013:p1217:b005:l022","ordinal":280394,"en":"You came saying you would fight,"},{"id":"semetey-2-2013:p1217:b005:l023","ordinal":280395,"en":"But fled and disgraced yourselves!"},{"id":"semetey-2-2013:p1217:b005:l024","ordinal":280396,"en":"After consulting two by two,"},{"id":"semetey-2-2013:p1217:b005:l025","ordinal":280397,"en":"What do you say now?"},{"id":"semetey-2-2013:p1217:b005:l026","ordinal":280398,"en":"Forgetting all your promises—"},{"id":"semetey-2-2013:p1217:b005:l027","ordinal":280399,"en":"Damn you, Jediger—"},{"id":"semetey-2-2013:p1217:b005:l028","ordinal":280400,"en":"You have proved yourselves heathens!"},{"id":"semetey-2-2013:p1217:b005:l029","ordinal":280401,"en":"Panicking in fear of Külchoro—"},{"id":"semetey-2-2013:p1217:b005:l030","ordinal":280402,"en":"Damn you, Jediger—"},{"id":"semetey-2-2013:p1217:b005:l031","ordinal":280403,"en":"You have proved yourselves faithless!"},{"id":"semetey-2-2013:p1217:b005:l032","ordinal":280404,"en":"Külchoro is one, while you are thousands;"},{"id":"semetey-2-2013:p1217:b005:l033","ordinal":280405,"en":"You Jediger are no men,"},{"id":"semetey-2-2013:p1217:b005:l034","ordinal":280406,"en":"But women, every one!"},{"id":"semetey-2-2013:p1217:b005:l035","ordinal":280407,"en":"You vast host of Jediger,"},{"id":"semetey-2-2013:p1217:b005:l036","ordinal":280408,"en":"You are no people, but heathens!"},{"id":"semetey-2-2013:p1217:b005:l037","ordinal":280409,"en":"While in the Seven Valleys you blustered,"},{"id":"semetey-2-2013:p1217:b005:l038","ordinal":280410,"en":"Posturing as though you would fight alone;"},{"id":"semetey-2-2013:p1217:b005:l039","ordinal":280411,"en":"Now you reel about, Jediger—"},{"id":"semetey-2-2013:p1218:b003:l001","ordinal":280412,"en":"Can a hero behave as you do?"},{"id":"semetey-2-2013:p1218:b003:l002","ordinal":280413,"en":"Will anyone prosper who calls you brave?"},{"id":"semetey-2-2013:p1218:b003:l003","ordinal":280414,"en":"I came to your Seven Valleys,"},{"id":"semetey-2-2013:p1218:b003:l004","ordinal":280415,"en":"Thinking yours was a worthy land;"},{"id":"semetey-2-2013:p1218:b003:l005","ordinal":280416,"en":"Oh, accursed Jediger,"},{"id":"semetey-2-2013:p1218:b003:l006","ordinal":280417,"en":"I came thinking you were a people!"},{"id":"semetey-2-2013:p1218:b003:l007","ordinal":280418,"en":"If I lose all faith in you, Jediger,"},{"id":"semetey-2-2013:p1218:b003:l008","ordinal":280419,"en":"I shall readily move back to Talas;"},{"id":"semetey-2-2013:p1218:b003:l009","ordinal":280420,"en":"Every day you have set my heart aflame."},{"id":"semetey-2-2013:p1218:b003:l010","ordinal":280421,"en":"Jediger, you have burned me within!"},{"id":"semetey-2-2013:p1218:b003:l011","ordinal":280422,"en":"You chattering Jediger,"},{"id":"semetey-2-2013:p1218:b003:l012","ordinal":280423,"en":"If you act so upon seeing his child,"},{"id":"semetey-2-2013:p1218:b003:l013","ordinal":280424,"en":"What will you do when you see his champion?"},{"id":"semetey-2-2013:p1218:b003:l014","ordinal":280425,"en":"If you act so upon seeing his warrior,"},{"id":"semetey-2-2013:p1218:b003:l015","ordinal":280426,"en":"What will you do when you see the great man himself?"},{"id":"semetey-2-2013:p1218:b003:l016","ordinal":280427,"en":"You vast host of Jediger,"},{"id":"semetey-2-2013:p1218:b003:l017","ordinal":280428,"en":"There is no boat upon the dark water;"},{"id":"semetey-2-2013:p1218:b003:l018","ordinal":280429,"en":"While your Kanchoro stands watching,"},{"id":"semetey-2-2013:p1218:b003:l019","ordinal":280430,"en":"None of you dares even raise an eyebrow!"},{"id":"semetey-2-2013:p1218:b003:l020","ordinal":280431,"en":"Make this slaughter truly glorious;"},{"id":"semetey-2-2013:p1218:b003:l021","ordinal":280432,"en":"Plunder all his possessions,"},{"id":"semetey-2-2013:p1218:b003:l022","ordinal":280433,"en":"Leaving not so much as a thread!"},{"id":"semetey-2-2013:p1218:b003:l023","ordinal":280434,"en":"You lanky, swarthy Jediger,"},{"id":"semetey-2-2013:p1218:b003:l024","ordinal":280435,"en":"Show what you can do in battle;"},{"id":"semetey-2-2013:p1218:b003:l025","ordinal":280436,"en":"Divide Semetey’s countless riches"},{"id":"semetey-2-2013:p1218:b003:l026","ordinal":280437,"en":"Precisely by the measure of the whip!"},{"id":"semetey-2-2013:p1218:b003:l027","ordinal":280438,"en":"Bring ruin upon his feast,"},{"id":"semetey-2-2013:p1218:b003:l028","ordinal":280439,"en":"Strike without wavering!"},{"id":"semetey-2-2013:p1218:b003:l029","ordinal":280440,"en":"Surround on every side"},{"id":"semetey-2-2013:p1218:b003:l030","ordinal":280441,"en":"The bloodthirsty man left horseless!"},{"id":"semetey-2-2013:p1218:b003:l031","ordinal":280442,"en":"Look how much ancestral fortune"},{"id":"semetey-2-2013:p1218:b003:l032","ordinal":280443,"en":"He inherited from his forefathers!"},{"id":"semetey-2-2013:p1218:b003:l033","ordinal":280444,"en":"Mighty on horseback but helpless in war,"},{"id":"semetey-2-2013:p1218:b003:l034","ordinal":280445,"en":"At the forked mountain pass"},{"id":"semetey-2-2013:p1218:b003:l035","ordinal":280446,"en":"The bloodthirsty man stands gaping;"},{"id":"semetey-2-2013:p1218:b003:l036","ordinal":280447,"en":"Those of you skilled with the spear,"},{"id":"semetey-2-2013:p1218:b003:l037","ordinal":280448,"en":"Charge shouting and thrust your spears!"},{"id":"semetey-2-2013:p1218:b003:l038","ordinal":280449,"en":"All your champions and elders,"},{"id":"semetey-2-2013:p1218:b003:l039","ordinal":280450,"en":"As though overtaken by slaughter,"},{"id":"semetey-2-2013:p1218:b004:l001","ordinal":280451,"en":"Go and perish together!"},{"id":"semetey-2-2013:p1218:b004:l002","ordinal":280452,"en":"All your strongmen and lions,"},{"id":"semetey-2-2013:p1218:b004:l003","ordinal":280453,"en":"Overwhelm the bloodthirsty son of Manas;"},{"id":"semetey-2-2013:p1218:b004:l004","ordinal":280454,"en":"Every one of you, swarm upon him!"},{"id":"semetey-2-2013:p1218:b004:l005","ordinal":280455,"en":"Thrusting spears and striking axes,"},{"id":"semetey-2-2013:p1218:b004:l006","ordinal":280456,"en":"All of you charge together!"},{"id":"semetey-2-2013:p1218:b004:l007","ordinal":280457,"en":"You vast host of Jediger,"},{"id":"semetey-2-2013:p1218:b004:l008","ordinal":280458,"en":"Heed these words of mine;"},{"id":"semetey-2-2013:p1218:b004:l009","ordinal":280459,"en":"You snarling, wretched people,"},{"id":"semetey-2-2013:p1218:b004:l010","ordinal":280460,"en":"Or you will be annihilated!"},{"id":"semetey-2-2013:p1218:b004:l011","ordinal":280461,"en":"If you do not heed my words,"},{"id":"semetey-2-2013:p1218:b004:l012","ordinal":280462,"en":"Along the Seven Valleys,"},{"id":"semetey-2-2013:p1218:b004:l013","ordinal":280463,"en":"In the hollow of Jerge-Tal,"},{"id":"semetey-2-2013:p1218:b004:l014","ordinal":280464,"en":"I shall plant my army’s standard."},{"id":"semetey-2-2013:p1218:b004:l015","ordinal":280465,"en":"If you stir against me, Jediger,"},{"id":"semetey-2-2013:p1218:b004:l016","ordinal":280466,"en":"I shall have every one of you slaughtered!"},{"id":"semetey-2-2013:p1218:b004:l017","ordinal":280467,"en":"In the hollow of Opol-Too,"},{"id":"semetey-2-2013:p1218:b004:l018","ordinal":280468,"en":"Down toward Andijan and Tarasha,"},{"id":"semetey-2-2013:p1218:b004:l019","ordinal":280469,"en":"Across the broad plain,"},{"id":"semetey-2-2013:p1218:b004:l020","ordinal":280470,"en":"I shall summon a mighty army"},{"id":"semetey-2-2013:p1218:b004:l021","ordinal":280471,"en":"And have it massacre your people,"},{"id":"semetey-2-2013:p1218:b004:l022","ordinal":280472,"en":"Leaving none untouched by slaughter!"},{"id":"semetey-2-2013:p1218:b004:l023","ordinal":280473,"en":"I shall bind the valiant Külchoro,"},{"id":"semetey-2-2013:p1218:b004:l024","ordinal":280474,"en":"My heroic kinsman, to my waist,"},{"id":"semetey-2-2013:p1218:b004:l025","ordinal":280475,"en":"And, setting myself against you, Jediger,"},{"id":"semetey-2-2013:p1218:b004:l026","ordinal":280476,"en":"Utterly wipe out your lineage!"},{"id":"semetey-2-2013:p1218:b004:l027","ordinal":280477,"en":"I shall level every hollow and hill;"},{"id":"semetey-2-2013:p1218:b004:l028","ordinal":280478,"en":"Do not trifle with me, Jediger!"},{"id":"semetey-2-2013:p1218:b004:l029","ordinal":280479,"en":"If I fail to bind your chiefs,"},{"id":"semetey-2-2013:p1218:b004:l030","ordinal":280480,"en":"If I fail to slaughter you all,"},{"id":"semetey-2-2013:p1218:b004:l031","ordinal":280481,"en":"May I die unworthy of the name Kanchoro,"},{"id":"semetey-2-2013:p1218:b004:l032","ordinal":280482,"en":"May I sink barren, as though never born!"},{"id":"semetey-2-2013:p1218:b004:l033","ordinal":280483,"en":"You Jediger who bar my way,"},{"id":"semetey-2-2013:p1218:b004:l034","ordinal":280484,"en":"You wretched people kindling your own deaths,"},{"id":"semetey-2-2013:p1218:b004:l035","ordinal":280485,"en":"Go on, try to flee—let me see!"},{"id":"semetey-2-2013:p1218:b004:l036","ordinal":280486,"en":"I shall raise an army from the Argyn,"},{"id":"semetey-2-2013:p1218:b004:l037","ordinal":280487,"en":"And muster a vast host of Kyrgyz;"},{"id":"semetey-2-2013:p1218:b004:l038","ordinal":280488,"en":"You sprawling Jediger,"},{"id":"semetey-2-2013:p1218:b004:l039","ordinal":280489,"en":"I shall track your yellow trail,"},{"id":"semetey-2-2013:p1219:b003:l001","ordinal":280490,"en":"Hounding and slaughtering you till you turn pale—"},{"id":"semetey-2-2013:p1219:b003:l002","ordinal":280491,"en":"Or may I and all my people die unborn!"},{"id":"semetey-2-2013:p1219:b003:l003","ordinal":280492,"en":"You cringing Jediger,"},{"id":"semetey-2-2013:p1219:b003:l004","ordinal":280493,"en":"Try to flee without leaving one behind!"},{"id":"semetey-2-2013:p1219:b003:l005","ordinal":280494,"en":"Let me see how you escape!”"},{"id":"semetey-2-2013:p1219:b003:l006","ordinal":280495,"en":"Roaring in fury,"},{"id":"semetey-2-2013:p1219:b003:l007","ordinal":280496,"en":"He drove the vast host of Jediger"},{"id":"semetey-2-2013:p1219:b003:l008","ordinal":280497,"en":"Back again in confusion."},{"id":"semetey-2-2013:p1219:b003:l009","ordinal":280498,"en":"The illustrious Kanchoro’s"},{"id":"semetey-2-2013:p1219:b003:l010","ordinal":280499,"en":"Eyes boiled like a boar’s;"},{"id":"semetey-2-2013:p1219:b003:l011","ordinal":280500,"en":"His broad, gate-like teeth"},{"id":"semetey-2-2013:p1219:b003:l012","ordinal":280501,"en":"Clashed as he ground them."},{"id":"semetey-2-2013:p1219:b003:l013","ordinal":280502,"en":"The people clamored and tumult arose;"},{"id":"semetey-2-2013:p1219:b003:l014","ordinal":280503,"en":"The warrior unleashed his wrath."},{"id":"semetey-2-2013:p1219:b003:l015","ordinal":280504,"en":"The Jediger wholly renounced"},{"id":"semetey-2-2013:p1219:b003:l016","ordinal":280505,"en":"Their fly-like lives on the spot."},{"id":"semetey-2-2013:p1219:b003:l017","ordinal":280506,"en":"How capable Kanchoro was:"},{"id":"semetey-2-2013:p1219:b003:l018","ordinal":280507,"en":"He drove the Jediger forward,"},{"id":"semetey-2-2013:p1219:b003:l019","ordinal":280508,"en":"As though he might devour them,"},{"id":"semetey-2-2013:p1219:b003:l020","ordinal":280509,"en":"And shouted at brave Kyyaz."},{"id":"semetey-2-2013:p1219:b003:l021","ordinal":280510,"en":"Making his mountain-bay horse surge,"},{"id":"semetey-2-2013:p1219:b003:l022","ordinal":280511,"en":"The mountain-like Kyyaz approached;"},{"id":"semetey-2-2013:p1219:b003:l023","ordinal":280512,"en":"And the seething Kanchoro"},{"id":"semetey-2-2013:p1219:b003:l024","ordinal":280513,"en":"Saw the fullness of his rage."},{"id":"semetey-2-2013:p1219:b003:l025","ordinal":280514,"en":"“Damn you, Jediger!"},{"id":"semetey-2-2013:p1219:b003:l026","ordinal":280515,"en":"I thought Kyyaz was a hero,"},{"id":"semetey-2-2013:p1219:b003:l027","ordinal":280516,"en":"But when the enemy appears, he flees—"},{"id":"semetey-2-2013:p1219:b003:l028","ordinal":280517,"en":"You have proved a woman, Kyyaz!"},{"id":"semetey-2-2013:p1219:b003:l029","ordinal":280518,"en":"The man you must fight is Semetey,"},{"id":"semetey-2-2013:p1219:b003:l030","ordinal":280519,"en":"Yet in your panic you are poised"},{"id":"semetey-2-2013:p1219:b003:l031","ordinal":280520,"en":"To scatter your own possessions!"},{"id":"semetey-2-2013:p1219:b003:l032","ordinal":280521,"en":"You panic-stricken Jediger,"},{"id":"semetey-2-2013:p1219:b003:l033","ordinal":280522,"en":"It is shameful beyond measure:"},{"id":"semetey-2-2013:p1219:b003:l034","ordinal":280523,"en":"You have come only to flee!"},{"id":"semetey-2-2013:p1219:b003:l035","ordinal":280524,"en":"The dream we saw has turned ill;"},{"id":"semetey-2-2013:p1219:b003:l036","ordinal":280525,"en":"Has there ever been, in all the ages,"},{"id":"semetey-2-2013:p1219:b003:l037","ordinal":280526,"en":"A people who fled from the field of battle?"},{"id":"semetey-2-2013:p1219:b003:l038","ordinal":280527,"en":"All your vaunted elders,"},{"id":"semetey-2-2013:p1219:b003:l039","ordinal":280528,"en":"As though struck by slaughter,"},{"id":"semetey-2-2013:p1219:b005:l001","ordinal":280529,"en":"Go and perish together!"},{"id":"semetey-2-2013:p1219:b005:l002","ordinal":280530,"en":"Has the bloodthirsty son of Manas"},{"id":"semetey-2-2013:p1219:b005:l003","ordinal":280531,"en":"Recited some spell from scripture"},{"id":"semetey-2-2013:p1219:b005:l004","ordinal":280532,"en":"And mounted it as his steed?"},{"id":"semetey-2-2013:p1219:b005:l005","ordinal":280533,"en":"His dapple-gray horse was his wings;"},{"id":"semetey-2-2013:p1219:b005:l006","ordinal":280534,"en":"Dark-flanked and blue-backed,"},{"id":"semetey-2-2013:p1219:b005:l007","ordinal":280535,"en":"That fiery bloodthirsty warrior"},{"id":"semetey-2-2013:p1219:b005:l008","ordinal":280536,"en":"Turned back after besieging Kakan,"},{"id":"semetey-2-2013:p1219:b005:l009","ordinal":280537,"en":"But the legacy of that entrusted bread—"},{"id":"semetey-2-2013:p1219:b005:l010","ordinal":280538,"en":"His Buurul—has been taken from him."},{"id":"semetey-2-2013:p1219:b005:l011","ordinal":280539,"en":"Blood has flooded his breast;"},{"id":"semetey-2-2013:p1219:b005:l012","ordinal":280540,"en":"Deprived of Buurul,"},{"id":"semetey-2-2013:p1219:b005:l013","ordinal":280541,"en":"His good fortune has deserted him."},{"id":"semetey-2-2013:p1219:b005:l014","ordinal":280542,"en":"Leaning upon Akkelte,"},{"id":"semetey-2-2013:p1219:b005:l015","ordinal":280543,"en":"He has been left on foot;"},{"id":"semetey-2-2013:p1219:b005:l016","ordinal":280544,"en":"Your shambling bloodthirsty foe"},{"id":"semetey-2-2013:p1219:b005:l017","ordinal":280545,"en":"Is fated to die a foul death this year!"},{"id":"semetey-2-2013:p1219:b005:l018","ordinal":280546,"en":"Among all the horses God created,"},{"id":"semetey-2-2013:p1219:b005:l019","ordinal":280547,"en":"What champion steed remains"},{"id":"semetey-2-2013:p1219:b005:l020","ordinal":280548,"en":"To lift and carry that man?"},{"id":"semetey-2-2013:p1219:b005:l021","ordinal":280549,"en":"That reckless bloodthirsty warrior"},{"id":"semetey-2-2013:p1219:b005:l022","ordinal":280550,"en":"Is fated to die this year."},{"id":"semetey-2-2013:p1219:b005:l023","ordinal":280551,"en":"The reason he must die is this:"},{"id":"semetey-2-2013:p1219:b005:l024","ordinal":280552,"en":"The forty calamities have overtaken him;"},{"id":"semetey-2-2013:p1219:b005:l025","ordinal":280553,"en":"His Buurul has vanished from his grasp"},{"id":"semetey-2-2013:p1219:b005:l026","ordinal":280554,"en":"And all his blessings have scattered."},{"id":"semetey-2-2013:p1219:b005:l027","ordinal":280555,"en":"The forty holy spirits who sustained him"},{"id":"semetey-2-2013:p1219:b005:l028","ordinal":280556,"en":"Have withdrawn far from his body."},{"id":"semetey-2-2013:p1219:b005:l029","ordinal":280557,"en":"At the forked, arching mountain pass"},{"id":"semetey-2-2013:p1219:b005:l030","ordinal":280558,"en":"He has been left looming there on foot;"},{"id":"semetey-2-2013:p1219:b005:l031","ordinal":280559,"en":"Disaster, death, and dread misfortune"},{"id":"semetey-2-2013:p1219:b005:l032","ordinal":280560,"en":"Have closed around the hero."},{"id":"semetey-2-2013:p1219:b005:l033","ordinal":280561,"en":"Damn you, Jediger,"},{"id":"semetey-2-2013:p1219:b005:l034","ordinal":280562,"en":"Swarm upon him and wage war!"},{"id":"semetey-2-2013:p1219:b005:l035","ordinal":280563,"en":"Take your vengeance upon Semetey;"},{"id":"semetey-2-2013:p1219:b005:l036","ordinal":280564,"en":"Raid Keng-Kol and seize its herds!"},{"id":"semetey-2-2013:p1219:b005:l037","ordinal":280565,"en":"Stately hero Kyyaz,"},{"id":"semetey-2-2013:p1219:b005:l038","ordinal":280566,"en":"Take your revenge before departing;"},{"id":"semetey-2-2013:p1219:b005:l039","ordinal":280567,"en":"Devastate Talas and seize its herds!"},{"id":"semetey-2-2013:p1220:b003:l001","ordinal":280568,"en":"Damn you, Jediger,"},{"id":"semetey-2-2013:p1220:b003:l002","ordinal":280569,"en":"Strike tirelessly and take revenge!"},{"id":"semetey-2-2013:p1220:b003:l003","ordinal":280570,"en":"This year your turn has come"},{"id":"semetey-2-2013:p1220:b003:l004","ordinal":280571,"en":"To gouge out eyes black as currants,"},{"id":"semetey-2-2013:p1220:b003:l005","ordinal":280572,"en":"To gorge yourselves upon rich broth"},{"id":"semetey-2-2013:p1220:b003:l006","ordinal":280573,"en":"And the fat flesh of royal feasts;"},{"id":"semetey-2-2013:p1220:b003:l007","ordinal":280574,"en":"This year your turn has come"},{"id":"semetey-2-2013:p1220:b003:l008","ordinal":280575,"en":"To slaughter the gray wolf, the bloodthirsty man’s son!"},{"id":"semetey-2-2013:p1220:b003:l009","ordinal":280576,"en":"Why do you not strike down"}]
