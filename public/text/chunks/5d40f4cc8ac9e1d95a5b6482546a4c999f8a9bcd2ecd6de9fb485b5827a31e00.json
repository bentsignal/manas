[{"id":"semetey-2-2013:p0019:b005:l017","ordinal":186625,"en":"Precisely aimed at them,"},{"id":"semetey-2-2013:p0019:b005:l018","ordinal":186626,"en":"There lies a stretched net."},{"id":"semetey-2-2013:p0019:b005:l019","ordinal":186627,"en":"Whoever falls upon accursed Beijing"},{"id":"semetey-2-2013:p0019:b005:l020","ordinal":186628,"en":"Has misery from which he cannot recover."},{"id":"semetey-2-2013:p0019:b005:l021","ordinal":186629,"en":"The sand blazes with heat;"},{"id":"semetey-2-2013:p0019:b005:l022","ordinal":186630,"en":"Set a cauldron upon it,"},{"id":"semetey-2-2013:p0019:b005:l023","ordinal":186631,"en":"And it boils roaring and surging."},{"id":"semetey-2-2013:p0019:b005:l024","ordinal":186632,"en":"Before one can say a word,"},{"id":"semetey-2-2013:p0019:b005:l025","ordinal":186633,"en":"In the blink of an eye,"},{"id":"semetey-2-2013:p0019:b005:l026","ordinal":186634,"en":"Not a spoonful of water remains."},{"id":"semetey-2-2013:p0019:b005:l027","ordinal":186635,"en":"One reaches the deathless desert;"},{"id":"semetey-2-2013:p0019:b005:l028","ordinal":186636,"en":"If you encounter that desert,"},{"id":"semetey-2-2013:p0019:b005:l029","ordinal":186637,"en":"My foal, your strength will leave you."},{"id":"semetey-2-2013:p0019:b005:l030","ordinal":186638,"en":"Let us not be caught unawares;"},{"id":"semetey-2-2013:p0019:b005:l031","ordinal":186639,"en":"So the sun's force cannot penetrate,"},{"id":"semetey-2-2013:p0019:b005:l032","ordinal":186640,"en":"Let us prepare our clothing well."},{"id":"semetey-2-2013:p0019:b005:l033","ordinal":186641,"en":"If your stride reaches those many people,"},{"id":"semetey-2-2013:p0019:b005:l034","ordinal":186642,"en":"Let us drive them all away."},{"id":"semetey-2-2013:p0019:b005:l035","ordinal":186643,"en":"With wise Bakai leading the road,"},{"id":"semetey-2-2013:p0019:b005:l036","ordinal":186644,"en":"Taking no fewer than sixty thousand troops,"},{"id":"semetey-2-2013:p0019:b005:l037","ordinal":186645,"en":"And abundant provisions"},{"id":"semetey-2-2013:p0019:b005:l038","ordinal":186646,"en":"For that great army to eat,"},{"id":"semetey-2-2013:p0019:b005:l039","ordinal":186647,"en":"Taking plentiful provisions with us,"},{"id":"semetey-2-2013:p0020:b003:l001","ordinal":186648,"en":"With the moon as our streaming banner,"},{"id":"semetey-2-2013:p0020:b003:l002","ordinal":186649,"en":"With clamor splitting the sky,"},{"id":"semetey-2-2013:p0020:b003:l003","ordinal":186650,"en":"With the sun as our streaming banner,"},{"id":"semetey-2-2013:p0020:b003:l004","ordinal":186651,"en":"With clamor splitting the blue heavens,"},{"id":"semetey-2-2013:p0020:b003:l005","ordinal":186652,"en":"Then let us make war."},{"id":"semetey-2-2013:p0020:b003:l006","ordinal":186653,"en":"Stripping him of horse and armor,"},{"id":"semetey-2-2013:p0020:b003:l007","ordinal":186654,"en":"Let us make hero Khan Kongurbai"},{"id":"semetey-2-2013:p0020:b003:l008","ordinal":186655,"en":"Into such a spectacle."},{"id":"semetey-2-2013:p0020:b003:l009","ordinal":186656,"en":"Upon the Kalcha, khan of the monks,"},{"id":"semetey-2-2013:p0020:b003:l010","ordinal":186657,"en":"Let us bring turmoil that cannot be crossed;"},{"id":"semetey-2-2013:p0020:b003:l011","ordinal":186658,"en":"From that Kalcha, khan of the monks,"},{"id":"semetey-2-2013:p0020:b003:l012","ordinal":186659,"en":"Let us exact our vengeance."},{"id":"semetey-2-2013:p0020:b003:l013","ordinal":186660,"en":"Let horses grow fat and ready,"},{"id":"semetey-2-2013:p0020:b003:l014","ordinal":186661,"en":"And the gathered army stand massed."},{"id":"semetey-2-2013:p0020:b003:l015","ordinal":186662,"en":"May resolute youths and swift horses"},{"id":"semetey-2-2013:p0020:b003:l016","ordinal":186663,"en":"Reach the time when they prove useful."},{"id":"semetey-2-2013:p0020:b003:l017","ordinal":186664,"en":"My son, if you heed me, do this."},{"id":"semetey-2-2013:p0020:b003:l018","ordinal":186665,"en":"May the road be blessed by saints;"},{"id":"semetey-2-2013:p0020:b003:l019","ordinal":186666,"en":"For Beijing, let there be"},{"id":"semetey-2-2013:p0020:b003:l020","ordinal":186667,"en":"No fewer than one hundred twenty thousand troops."},{"id":"semetey-2-2013:p0020:b003:l021","ordinal":186668,"en":"If you make war upon Beijing,"},{"id":"semetey-2-2013:p0020:b003:l022","ordinal":186669,"en":"Let them be abundant, not few."},{"id":"semetey-2-2013:p0020:b003:l023","ordinal":186670,"en":"Let renowned giants come,"},{"id":"semetey-2-2013:p0020:b003:l024","ordinal":186671,"en":"Heroes come to Beijing"},{"id":"semetey-2-2013:p0020:b003:l025","ordinal":186672,"en":"Who do not retreat a hair from death,"},{"id":"semetey-2-2013:p0020:b003:l026","ordinal":186673,"en":"Who never turn away from dying;"},{"id":"semetey-2-2013:p0020:b003:l027","ordinal":186674,"en":"Let such warriors come to Beijing."},{"id":"semetey-2-2013:p0020:b003:l028","ordinal":186675,"en":"When the fierce gun cracks,"},{"id":"semetey-2-2013:p0020:b003:l029","ordinal":186676,"en":"Let warriors come to Beijing"},{"id":"semetey-2-2013:p0020:b003:l030","ordinal":186677,"en":"Who fight without flinching."},{"id":"semetey-2-2013:p0020:b003:l031","ordinal":186678,"en":"When the black gun bangs,"},{"id":"semetey-2-2013:p0020:b003:l032","ordinal":186679,"en":"Let warriors come to Beijing"},{"id":"semetey-2-2013:p0020:b003:l033","ordinal":186680,"en":"Who stand and fight without fleeing."},{"id":"semetey-2-2013:p0020:b003:l034","ordinal":186681,"en":"When we stand on opposite banks,"},{"id":"semetey-2-2013:p0020:b003:l035","ordinal":186682,"en":"Shouting and leveling spears,"},{"id":"semetey-2-2013:p0020:b003:l036","ordinal":186683,"en":"Firing guns and drawing bows,"},{"id":"semetey-2-2013:p0020:b003:l037","ordinal":186684,"en":"Clashing together in battle,"},{"id":"semetey-2-2013:p0020:b003:l038","ordinal":186685,"en":"With arrows whirring"},{"id":"semetey-2-2013:p0020:b003:l039","ordinal":186686,"en":"And wounds burning,"},{"id":"semetey-2-2013:p0020:b004:l001","ordinal":186687,"en":"May they perish, struck by bullets,"},{"id":"semetey-2-2013:p0020:b004:l002","ordinal":186688,"en":"And spill blood in streams."},{"id":"semetey-2-2013:p0020:b004:l003","ordinal":186689,"en":"If you come to Beijing, come thus;"},{"id":"semetey-2-2013:p0020:b004:l004","ordinal":186690,"en":"In the land of Beijing,"},{"id":"semetey-2-2013:p0020:b004:l005","ordinal":186691,"en":"If you fight, fight in this way"},{"id":"semetey-2-2013:p0020:b004:l006","ordinal":186692,"en":"Against the Chinese hero Khan Kongurbai."},{"id":"semetey-2-2013:p0020:b004:l007","ordinal":186693,"en":"Understand what I have said;"},{"id":"semetey-2-2013:p0020:b004:l008","ordinal":186694,"en":"Your uncle Joodur has spoken."},{"id":"semetey-2-2013:p0020:b004:l009","ordinal":186695,"en":"My lion, my son, heed me.”"},{"id":"semetey-2-2013:p0020:b004:l010","ordinal":186696,"en":"When Semetey heard this, he said:"},{"id":"semetey-2-2013:p0020:b004:l011","ordinal":186697,"en":"“My uncle whom I regard as a father,"},{"id":"semetey-2-2013:p0020:b004:l012","ordinal":186698,"en":"What you say is wise."},{"id":"semetey-2-2013:p0020:b004:l013","ordinal":186699,"en":"If I refuse to heed you,"},{"id":"semetey-2-2013:p0020:b004:l014","ordinal":186700,"en":"May my six forefathers be infidels.”"},{"id":"semetey-2-2013:p0020:b004:l015","ordinal":186701,"en":"Foolishness was struck by God"},{"id":"semetey-2-2013:p0020:b004:l016","ordinal":186702,"en":"From father to grandfather:"},{"id":"semetey-2-2013:p0020:b004:l017","ordinal":186703,"en":"His lion uncle Bakai was absent,"},{"id":"semetey-2-2013:p0020:b004:l018","ordinal":186704,"en":"And he let himself be deceived repeatedly"},{"id":"semetey-2-2013:p0020:b004:l019","ordinal":186705,"en":"By Karagul himself."},{"id":"semetey-2-2013:p0020:b004:l020","ordinal":186706,"en":"Karagul, son of Katal—"},{"id":"semetey-2-2013:p0020:b004:l021","ordinal":186707,"en":"Here was black calamity."},{"id":"semetey-2-2013:p0020:b004:l022","ordinal":186708,"en":"That raging swine's"},{"id":"semetey-2-2013:p0020:b004:l023","ordinal":186709,"en":"Deed was done in this way;"},{"id":"semetey-2-2013:p0020:b004:l024","ordinal":186710,"en":"Upon the young son of Manas"},{"id":"semetey-2-2013:p0020:b004:l025","ordinal":186711,"en":"He laid a singular corruption."},{"id":"semetey-2-2013:p0020:b004:l026","ordinal":186712,"en":"Foolishly born Semetey"},{"id":"semetey-2-2013:p0020:b004:l027","ordinal":186713,"en":"Said he would obey him;"},{"id":"semetey-2-2013:p0020:b004:l028","ordinal":186714,"en":"To the deceiver he said,"},{"id":"semetey-2-2013:p0020:b004:l029","ordinal":186715,"en":"“I shall give you my mother.”"},{"id":"semetey-2-2013:p0020:b004:l030","ordinal":186716,"en":"Then Karagul—"},{"id":"semetey-2-2013:p0020:b004:l031","ordinal":186717,"en":"God had now struck the slave—"},{"id":"semetey-2-2013:p0020:b004:l032","ordinal":186718,"en":"Took the gold-cheeked battle-axe"},{"id":"semetey-2-2013:p0020:b004:l033","ordinal":186719,"en":"And braced it at his waist,"},{"id":"semetey-2-2013:p0020:b004:l034","ordinal":186720,"en":"And now invoked Manas too."},{"id":"semetey-2-2013:p0020:b004:l035","ordinal":186721,"en":"Saying, “This is my true kinsman,”"},{"id":"semetey-2-2013:p0020:b004:l036","ordinal":186722,"en":"God now struck the prince."},{"id":"semetey-2-2013:p0020:b004:l037","ordinal":186723,"en":"The towering Arbuurul,"},{"id":"semetey-2-2013:p0020:b004:l038","ordinal":186724,"en":"When he took on his summer coat,"},{"id":"semetey-2-2013:p0020:b004:l039","ordinal":186725,"en":"That red-gray creature,"},{"id":"semetey-2-2013:p0021:b003:l001","ordinal":186726,"en":"In wintertime"},{"id":"semetey-2-2013:p0021:b003:l002","ordinal":186727,"en":"He turned black-gray."},{"id":"semetey-2-2013:p0021:b003:l003","ordinal":186728,"en":"He bent his neck like a stag;"},{"id":"semetey-2-2013:p0021:b003:l004","ordinal":186729,"en":"If game appeared a shot's length away,"},{"id":"semetey-2-2013:p0021:b003:l005","ordinal":186730,"en":"He bounded without hesitation."},{"id":"semetey-2-2013:p0021:b003:l006","ordinal":186731,"en":"When his excellence became known,"},{"id":"semetey-2-2013:p0021:b003:l007","ordinal":186732,"en":"The khan of Bukhara asked for him."},{"id":"semetey-2-2013:p0021:b003:l008","ordinal":186733,"en":"He was not given when requested;"},{"id":"semetey-2-2013:p0021:b003:l009","ordinal":186734,"en":"Far from giving Buurul away,"},{"id":"semetey-2-2013:p0021:b003:l010","ordinal":186735,"en":"No ritually impure man ever rode him."},{"id":"semetey-2-2013:p0021:b003:l011","ordinal":186736,"en":"The foolish hero, son of Manas,"},{"id":"semetey-2-2013:p0021:b003:l012","ordinal":186737,"en":"Resolved to inspect the herd"},{"id":"semetey-2-2013:p0021:b003:l013","ordinal":186738,"en":"And release into it"},{"id":"semetey-2-2013:p0021:b003:l014","ordinal":186739,"en":"The towering swift horse."},{"id":"semetey-2-2013:p0021:b003:l015","ordinal":186740,"en":"Then Semetey said:"},{"id":"semetey-2-2013:p0021:b003:l016","ordinal":186741,"en":"“While my uncle Joodur is here,"},{"id":"semetey-2-2013:p0021:b003:l017","ordinal":186742,"en":"I shall wear the bulletproof armor"},{"id":"semetey-2-2013:p0021:b003:l018","ordinal":186743,"en":"Of hero Kongurbai the Kalcha;"},{"id":"semetey-2-2013:p0021:b003:l019","ordinal":186744,"en":"I shall catch and ride myself"},{"id":"semetey-2-2013:p0021:b003:l020","ordinal":186745,"en":"The Kalcha's winged Black Horse."},{"id":"semetey-2-2013:p0021:b003:l021","ordinal":186746,"en":"This year I shall have Buurul lead the herd"},{"id":"semetey-2-2013:p0021:b003:l022","ordinal":186747,"en":"And drive it to Talas."},{"id":"semetey-2-2013:p0021:b003:l023","ordinal":186748,"en":"Uncle Joodur, your words are true;"},{"id":"semetey-2-2013:p0021:b003:l024","ordinal":186749,"en":"Everything you said is true."},{"id":"semetey-2-2013:p0021:b003:l025","ordinal":186750,"en":"I shall grow fat and refreshed,"},{"id":"semetey-2-2013:p0021:b003:l026","ordinal":186751,"en":"Gathering an army for Beijing,"},{"id":"semetey-2-2013:p0021:b003:l027","ordinal":186752,"en":"Not a few but many,"},{"id":"semetey-2-2013:p0021:b003:l028","ordinal":186753,"en":"And then bring slaughter"},{"id":"semetey-2-2013:p0021:b003:l029","ordinal":186754,"en":"Upon hero Kongurbai."},{"id":"semetey-2-2013:p0021:b003:l030","ordinal":186755,"en":"Thus shall I avenge"},{"id":"semetey-2-2013:p0021:b003:l031","ordinal":186756,"en":"My father who passed into eternity."},{"id":"semetey-2-2013:p0021:b003:l032","ordinal":186757,"en":"I shall gird my waist firmly,"},{"id":"semetey-2-2013:p0021:b003:l033","ordinal":186758,"en":"Commit myself and pray,"},{"id":"semetey-2-2013:p0021:b003:l034","ordinal":186759,"en":"And pursue my father's blood-price."},{"id":"semetey-2-2013:p0021:b003:l035","ordinal":186760,"en":"If fate arrives, I shall die;"},{"id":"semetey-2-2013:p0021:b003:l036","ordinal":186761,"en":"I shall contend with Kongurbai,"},{"id":"semetey-2-2013:p0021:b003:l037","ordinal":186762,"en":"The khan of the monks!”"},{"id":"semetey-2-2013:p0021:b003:l038","ordinal":186763,"en":"Having said this, Semetey"},{"id":"semetey-2-2013:p0021:b003:l039","ordinal":186764,"en":"Saddled Arbuurul"},{"id":"semetey-2-2013:p0021:b004:l001","ordinal":186765,"en":"With the Akkangky saddle made by Almambet:"},{"id":"semetey-2-2013:p0021:b004:l002","ordinal":186766,"en":"Its front bow of white gold,"},{"id":"semetey-2-2013:p0021:b004:l003","ordinal":186767,"en":"Its rear bow of pure silver,"},{"id":"semetey-2-2013:p0021:b004:l004","ordinal":186768,"en":"Both sides of broad iron."},{"id":"semetey-2-2013:p0021:b004:l005","ordinal":186769,"en":"Skilled when crossing passes,"},{"id":"semetey-2-2013:p0021:b004:l006","ordinal":186770,"en":"Alman, who departed for the next world,"},{"id":"semetey-2-2013:p0021:b004:l007","ordinal":186771,"en":"Had made it especially"},{"id":"semetey-2-2013:p0021:b004:l008","ordinal":186772,"en":"For the boy Semetey."},{"id":"semetey-2-2013:p0021:b004:l009","ordinal":186773,"en":"The great saddlecloth and leather sweat-pad"},{"id":"semetey-2-2013:p0021:b004:l010","ordinal":186774,"en":"Semetey stripped from Buurul,"},{"id":"semetey-2-2013:p0021:b004:l011","ordinal":186775,"en":"Deceived by Karagul;"},{"id":"semetey-2-2013:p0021:b004:l012","ordinal":186776,"en":"Your gray wolf began this deed."},{"id":"semetey-2-2013:p0021:b004:l013","ordinal":186777,"en":"He tied a white halter with a rosette knot"},{"id":"semetey-2-2013:p0021:b004:l014","ordinal":186778,"en":"Around his neck."},{"id":"semetey-2-2013:p0021:b004:l015","ordinal":186779,"en":"Once released, Buurul"},{"id":"semetey-2-2013:p0021:b004:l016","ordinal":186780,"en":"Led the vast herd."},{"id":"semetey-2-2013:p0021:b004:l017","ordinal":186781,"en":"Such was Buurul's excellence:"},{"id":"semetey-2-2013:p0021:b004:l018","ordinal":186782,"en":"He never panicked at a battle cry;"},{"id":"semetey-2-2013:p0021:b004:l019","ordinal":186783,"en":"On a moonless day,"},{"id":"semetey-2-2013:p0021:b004:l020","ordinal":186784,"en":"In a night when eyes could not see,"},{"id":"semetey-2-2013:p0021:b004:l021","ordinal":186785,"en":"He never misplaced a single step."},{"id":"semetey-2-2013:p0021:b004:l022","ordinal":186786,"en":"At a clamor he broke away;"},{"id":"semetey-2-2013:p0021:b004:l023","ordinal":186787,"en":"When he ran, the black earth"},{"id":"semetey-2-2013:p0021:b004:l024","ordinal":186788,"en":"Split layer by layer."},{"id":"semetey-2-2013:p0021:b004:l025","ordinal":186789,"en":"At all times that beast"},{"id":"semetey-2-2013:p0021:b004:l026","ordinal":186790,"en":"Showed the marks of a tulpar."},{"id":"semetey-2-2013:p0021:b004:l027","ordinal":186791,"en":"When urged onto stone,"},{"id":"semetey-2-2013:p0021:b004:l028","ordinal":186792,"en":"He did not slip from the heights."},{"id":"semetey-2-2013:p0021:b004:l029","ordinal":186793,"en":"In no way was he inferior"},{"id":"semetey-2-2013:p0021:b004:l030","ordinal":186794,"en":"To the kulan and game of the mountains."},{"id":"semetey-2-2013:p0021:b004:l031","ordinal":186795,"en":"Broad-chested with a low mane,"},{"id":"semetey-2-2013:p0021:b004:l032","ordinal":186796,"en":"Handsome Buurul horse,"},{"id":"semetey-2-2013:p0021:b004:l033","ordinal":186797,"en":"His hindquarters were like a ravine;"},{"id":"semetey-2-2013:p0021:b004:l034","ordinal":186798,"en":"His white front teeth"},{"id":"semetey-2-2013:p0021:b004:l035","ordinal":186799,"en":"Were like hammered steel."},{"id":"semetey-2-2013:p0021:b004:l036","ordinal":186800,"en":"He did not tire after six months' riding;"},{"id":"semetey-2-2013:p0021:b004:l037","ordinal":186801,"en":"Until sixty years of age,"},{"id":"semetey-2-2013:p0021:b004:l038","ordinal":186802,"en":"His tusklike teeth did not grow old."},{"id":"semetey-2-2013:p0021:b004:l039","ordinal":186803,"en":"His calves were like a boy's waist,"},{"id":"semetey-2-2013:p0022:b003:l001","ordinal":186804,"en":"His gait was like the high wind."},{"id":"semetey-2-2013:p0022:b003:l002","ordinal":186805,"en":"Toward the great herd"},{"id":"semetey-2-2013:p0022:b003:l003","ordinal":186806,"en":"Buurul advanced,"},{"id":"semetey-2-2013:p0022:b003:l004","ordinal":186807,"en":"Tossing his forelock to the sky"},{"id":"semetey-2-2013:p0022:b003:l005","ordinal":186808,"en":"And pounding his hooves into the earth."},{"id":"semetey-2-2013:p0022:b003:l006","ordinal":186809,"en":"He broke away at the head of the horses;"},{"id":"semetey-2-2013:p0022:b003:l007","ordinal":186810,"en":"As the beast drew straight ahead,"},{"id":"semetey-2-2013:p0022:b003:l008","ordinal":186811,"en":"His tulpar form appeared."},{"id":"semetey-2-2013:p0022:b003:l009","ordinal":186812,"en":"He had no tongue with which to speak,"},{"id":"semetey-2-2013:p0022:b003:l010","ordinal":186813,"en":"Yet was wiser than an animal."},{"id":"semetey-2-2013:p0022:b003:l011","ordinal":186814,"en":"Neighing and pawing the ground,"},{"id":"semetey-2-2013:p0022:b003:l012","ordinal":186815,"en":"He displayed his thoroughbred form,"},{"id":"semetey-2-2013:p0022:b003:l013","ordinal":186816,"en":"Flicking his forelock toward the sky"},{"id":"semetey-2-2013:p0022:b003:l014","ordinal":186817,"en":"And striking his willow-silk tail"},{"id":"semetey-2-2013:p0022:b003:l015","ordinal":186818,"en":"Against his hind legs."},{"id":"semetey-2-2013:p0022:b003:l016","ordinal":186819,"en":"Neighing with a rolling call,"},{"id":"semetey-2-2013:p0022:b003:l017","ordinal":186820,"en":"By God, the proud creature,"},{"id":"semetey-2-2013:p0022:b003:l018","ordinal":186821,"en":"Towering Arbuurul,"},{"id":"semetey-2-2013:p0022:b003:l019","ordinal":186822,"en":"Pounded the black earth."},{"id":"semetey-2-2013:p0022:b003:l020","ordinal":186823,"en":"Buurul horse left behind"},{"id":"semetey-2-2013:p0022:b003:l021","ordinal":186824,"en":"The prince, son of Manas."},{"id":"semetey-2-2013:p0022:b003:l022","ordinal":186825,"en":"The countless dark livestock gathered as tribute,"},{"id":"semetey-2-2013:p0022:b003:l023","ordinal":186826,"en":"The myriad treasury herds,"},{"id":"semetey-2-2013:p0022:b003:l024","ordinal":186827,"en":"Before a white cliff a rope-length high,"},{"id":"semetey-2-2013:p0022:b003:l025","ordinal":186828,"en":"The creature crossed in a single bound."},{"id":"semetey-2-2013:p0022:b003:l026","ordinal":186829,"en":"After that Buurul,"},{"id":"semetey-2-2013:p0022:b003:l027","ordinal":186830,"en":"The black stallion, father of horses,"},{"id":"semetey-2-2013:p0022:b003:l028","ordinal":186831,"en":"Ran after him without remaining behind;"},{"id":"semetey-2-2013:p0022:b003:l029","ordinal":186832,"en":"A bay stallion like a falcon hood,"},{"id":"semetey-2-2013:p0022:b003:l030","ordinal":186833,"en":"A yellow stallion with jingling ornaments—"},{"id":"semetey-2-2013:p0022:b003:l031","ordinal":186834,"en":"The great thundering herd"},{"id":"semetey-2-2013:p0022:b003:l032","ordinal":186835,"en":"All crossed after him."},{"id":"semetey-2-2013:p0022:b003:l033","ordinal":186836,"en":"The pattering foals and yearlings"},{"id":"semetey-2-2013:p0022:b003:l034","ordinal":186837,"en":"Died in the water;"},{"id":"semetey-2-2013:p0022:b003:l035","ordinal":186838,"en":"The whinnying mares and fillies"},{"id":"semetey-2-2013:p0022:b003:l036","ordinal":186839,"en":"Were left completely exhausted."},{"id":"semetey-2-2013:p0022:b003:l037","ordinal":186840,"en":"He raised the whole dark mass"},{"id":"semetey-2-2013:p0022:b003:l038","ordinal":186841,"en":"And thus Semetey took"},{"id":"semetey-2-2013:p0022:b003:l039","ordinal":186842,"en":"The thundering herd."},{"id":"semetey-2-2013:p0022:b004:l001","ordinal":186843,"en":"Do you see Karagul,"},{"id":"semetey-2-2013:p0022:b004:l002","ordinal":186844,"en":"Preparing treachery?"},{"id":"semetey-2-2013:p0022:b004:l003","ordinal":186845,"en":"Semetey stood here"},{"id":"semetey-2-2013:p0022:b004:l004","ordinal":186846,"en":"With a sheathe-less sword at his waist."},{"id":"semetey-2-2013:p0022:b004:l005","ordinal":186847,"en":"Karagul stood in anguish,"},{"id":"semetey-2-2013:p0022:b004:l006","ordinal":186848,"en":"Preparing the way to flee."},{"id":"semetey-2-2013:p0022:b004:l007","ordinal":186849,"en":"Do you see Semetey"},{"id":"semetey-2-2013:p0022:b004:l008","ordinal":186850,"en":"Begging Karagul to tell him"},{"id":"semetey-2-2013:p0022:b004:l009","ordinal":186851,"en":"Which was Kongurbai's horse?"},{"id":"semetey-2-2013:p0022:b004:l010","ordinal":186852,"en":"“Hey, my dear uncle,"},{"id":"semetey-2-2013:p0022:b004:l011","ordinal":186853,"en":"Did you see him leave from under me,"},{"id":"semetey-2-2013:p0022:b004:l012","ordinal":186854,"en":"My thoroughbred Arbuurul?"},{"id":"semetey-2-2013:p0022:b004:l013","ordinal":186855,"en":"Old Joodur, left from my father,"},{"id":"semetey-2-2013:p0022:b004:l014","ordinal":186856,"en":"My kinsman found upon the steppe."},{"id":"semetey-2-2013:p0022:b004:l015","ordinal":186857,"en":"Which is your infidel's Black Horse,"},{"id":"semetey-2-2013:p0022:b004:l016","ordinal":186858,"en":"So that I may ride it?"},{"id":"semetey-2-2013:p0022:b004:l017","ordinal":186859,"en":"Uncle, kindle my extinguished fire;"},{"id":"semetey-2-2013:p0022:b004:l018","ordinal":186860,"en":"Restore the dead soul."},{"id":"semetey-2-2013:p0022:b004:l019","ordinal":186861,"en":"Let me know your kinship;"},{"id":"semetey-2-2013:p0022:b004:l020","ordinal":186862,"en":"I shall thunder after the herd,"},{"id":"semetey-2-2013:p0022:b004:l021","ordinal":186863,"en":"Drive it from behind,"},{"id":"semetey-2-2013:p0022:b004:l022","ordinal":186864,"en":"And leave none at its roots,"},{"id":"semetey-2-2013:p0022:b004:l023","ordinal":186865,"en":"But drive them all into Talas!”"},{"id":"semetey-2-2013:p0022:b004:l024","ordinal":186866,"en":"Behind that herd,"},{"id":"semetey-2-2013:p0022:b004:l025","ordinal":186867,"en":"The black Kyyduukara horse"},{"id":"semetey-2-2013:p0022:b004:l026","ordinal":186868,"en":"Had remained apart."},{"id":"semetey-2-2013:p0022:b004:l027","ordinal":186869,"en":"Its figure and bearing,"},{"id":"semetey-2-2013:p0022:b004:l028","ordinal":186870,"en":"Its horse-like form,"},{"id":"semetey-2-2013:p0022:b004:l029","ordinal":186871,"en":"Stirred the heart at sight;"},{"id":"semetey-2-2013:p0022:b004:l030","ordinal":186872,"en":"The marks of a tulpar appeared."},{"id":"semetey-2-2013:p0022:b004:l031","ordinal":186873,"en":"God had struck the slave:"},{"id":"semetey-2-2013:p0022:b004:l032","ordinal":186874,"en":"Telling Semetey to ride it,"},{"id":"semetey-2-2013:p0022:b004:l033","ordinal":186875,"en":"He greatly praised"},{"id":"semetey-2-2013:p0022:b004:l034","ordinal":186876,"en":"The black Kyyduukara horse:"},{"id":"semetey-2-2013:p0022:b004:l035","ordinal":186877,"en":"“My dear Semetey,"},{"id":"semetey-2-2013:p0022:b004:l036","ordinal":186878,"en":"The great Black Horse, huge as a mountain,"},{"id":"semetey-2-2013:p0022:b004:l037","ordinal":186879,"en":"Was Algara himself."},{"id":"semetey-2-2013:p0022:b004:l038","ordinal":186880,"en":"This year that desolate swine"}]
