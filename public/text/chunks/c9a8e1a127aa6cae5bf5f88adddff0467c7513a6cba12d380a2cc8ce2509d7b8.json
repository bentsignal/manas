[{"id":"manas-2010:p1336:b001:l022","ordinal":57857,"en":"All were outstanding coursers,"},{"id":"manas-2010:p1336:b001:l023","ordinal":57858,"en":"Karabayyr battle steeds,"},{"id":"manas-2010:p1336:b001:l024","ordinal":57859,"en":"Dwelling in Sary-Arka,"},{"id":"manas-2010:p1336:b001:l025","ordinal":57860,"en":"Apart from all other beasts."},{"id":"manas-2010:p1336:b001:l026","ordinal":57861,"en":"All his warriors together,"},{"id":"manas-2010:p1336:b001:l027","ordinal":57862,"en":"“Where is the enemy?” they said, making ready."},{"id":"manas-2010:p1336:b001:l028","ordinal":57863,"en":"Shouting and bellowing,"},{"id":"manas-2010:p1336:b001:l029","ordinal":57864,"en":"Did you see their boastfulness?"},{"id":"manas-2010:p1336:b001:l030","ordinal":57865,"en":"Crying “Kökchö!” as their battle cry,"},{"id":"manas-2010:p1336:b001:l031","ordinal":57866,"en":"Kökchö went along the road,"},{"id":"manas-2010:p1336:b001:l032","ordinal":57867,"en":"With an army of one san in all."},{"id":"manas-2010:p1336:b001:l033","ordinal":57868,"en":"Behind the Kazakhs,"},{"id":"manas-2010:p1336:b001:l034","ordinal":57869,"en":"Zhamgyrchy of the Eshtek,"},{"id":"manas-2010:p1336:b001:l035","ordinal":57870,"en":"Who pondered and devised plans,"},{"id":"manas-2010:p1336:b001:l036","ordinal":57871,"en":"Who did not give up night thieving,"},{"id":"manas-2010:p1336:b001:l037","ordinal":57872,"en":"Who did not retreat from an enemy,"},{"id":"manas-2010:p1336:b001:l038","ordinal":57873,"en":"Who did not shake his head and turn back,"},{"id":"manas-2010:p1336:b001:l039","ordinal":57874,"en":"Gathering his Eshtek, battle-hardened,"},{"id":"manas-2010:p1336:b001:l040","ordinal":57875,"en":"Famed as warrior Zhamgyrchy,"},{"id":"manas-2010:p1336:b001:l041","ordinal":57876,"en":"He too went along the road,"},{"id":"manas-2010:p1336:b001:l042","ordinal":57877,"en":"With an army numbering one san."},{"id":"manas-2010:p1337:b001:l001","ordinal":57878,"en":"Who dwelt in Eki-Kemin,"},{"id":"manas-2010:p1337:b001:l002","ordinal":57879,"en":"Who tethered a matched pair of black horses,"},{"id":"manas-2010:p1337:b001:l003","ordinal":57880,"en":"Who sowed his rice as a winter crop,"},{"id":"manas-2010:p1337:b001:l004","ordinal":57881,"en":"Who fed its weed-grain to tethered stock,"},{"id":"manas-2010:p1337:b001:l005","ordinal":57882,"en":"Who made a dark cave his house,"},{"id":"manas-2010:p1337:b001:l006","ordinal":57883,"en":"Who trained a harrier as a hunting bird,"},{"id":"manas-2010:p1337:b001:l007","ordinal":57884,"en":"Who made a people of the scattered,"},{"id":"manas-2010:p1337:b001:l008","ordinal":57885,"en":"Who trained a small falcon as a hunting bird,"},{"id":"manas-2010:p1337:b001:l009","ordinal":57886,"en":"Who gathered wanderers into a people,"},{"id":"manas-2010:p1337:b001:l010","ordinal":57887,"en":"Who grew rich from poverty,"},{"id":"manas-2010:p1337:b001:l011","ordinal":57888,"en":"Who grew numerous from solitude,"},{"id":"manas-2010:p1337:b001:l012","ordinal":57889,"en":"Warrior Ürbü, Eybit's son,"},{"id":"manas-2010:p1337:b001:l013","ordinal":57890,"en":"Ürbü surged at the front,"},{"id":"manas-2010:p1337:b001:l014","ordinal":57891,"en":"A vast host surged before him."},{"id":"manas-2010:p1337:b001:l015","ordinal":57892,"en":"He too went along the road,"},{"id":"manas-2010:p1337:b001:l016","ordinal":57893,"en":"With so mighty an army."},{"id":"manas-2010:p1337:b001:l017","ordinal":57894,"en":"Following behind them,"},{"id":"manas-2010:p1337:b001:l018","ordinal":57895,"en":"They were the Kypchak people."},{"id":"manas-2010:p1337:b001:l019","ordinal":57896,"en":"Among these Kypchak,"},{"id":"manas-2010:p1337:b001:l020","ordinal":57897,"en":"There was one called warrior Shygay."},{"id":"manas-2010:p1337:b001:l021","ordinal":57898,"en":"He saddled his Arküröng;"},{"id":"manas-2010:p1337:b001:l022","ordinal":57899,"en":"Fighting with every people,"},{"id":"manas-2010:p1337:b001:l023","ordinal":57900,"en":"He had learned the ways of war."},{"id":"manas-2010:p1337:b001:l024","ordinal":57901,"en":"At Shygay's fierce presence,"},{"id":"manas-2010:p1337:b001:l025","ordinal":57902,"en":"Every man took fright."},{"id":"manas-2010:p1337:b001:l026","ordinal":57903,"en":"In his time, warrior Shygay"},{"id":"manas-2010:p1337:b001:l027","ordinal":57904,"en":"Had devastated the Kyzylbash,"},{"id":"manas-2010:p1337:b001:l028","ordinal":57905,"en":"Had laid their champions low,"},{"id":"manas-2010:p1337:b001:l029","ordinal":57906,"en":"Had made their girls and young wives weep."},{"id":"manas-2010:p1337:b001:l030","ordinal":57907,"en":"They wore shirts of plain cloth."},{"id":"manas-2010:p1337:b001:l031","ordinal":57908,"en":"Warrior Shygay of the Kypchak,"},{"id":"manas-2010:p1337:b001:l032","ordinal":57909,"en":"From Alty-Shaar and Kokand,"},{"id":"manas-2010:p1337:b001:l033","ordinal":57910,"en":"Passing beyond, with Samarkand's"},{"id":"manas-2010:p1337:b001:l034","ordinal":57911,"en":"People he had clashed."},{"id":"manas-2010:p1337:b001:l035","ordinal":57912,"en":"By day he took horses;"},{"id":"manas-2010:p1337:b001:l036","ordinal":57913,"en":"By night he took his sleep."},{"id":"manas-2010:p1337:b001:l037","ordinal":57914,"en":"Hardened through valor,"},{"id":"manas-2010:p1337:b001:l038","ordinal":57915,"en":"Famed as Red Shygay of the Kypchak,"},{"id":"manas-2010:p1337:b001:l039","ordinal":57916,"en":"He too went along the road,"},{"id":"manas-2010:p1337:b001:l040","ordinal":57917,"en":"With an immense army."},{"id":"manas-2010:p1337:b001:l041","ordinal":57918,"en":"Readying his battle-axe,"},{"id":"manas-2010:p1337:b001:l042","ordinal":57919,"en":"That damned man had become adept."},{"id":"manas-2010:p1338:b001:l001","ordinal":57920,"en":"Making his spears ready,"},{"id":"manas-2010:p1338:b001:l002","ordinal":57921,"en":"Beating drums, raising a din,"},{"id":"manas-2010:p1338:b001:l003","ordinal":57922,"en":"Driving those behind, raising an uproar,"},{"id":"manas-2010:p1338:b001:l004","ordinal":57923,"en":"He too went toward Beijing."},{"id":"manas-2010:p1338:b001:l005","ordinal":57924,"en":"Bearing a gray-mottled banner and standard,"},{"id":"manas-2010:p1338:b001:l006","ordinal":57925,"en":"Was his bearing not that of a great beast?"},{"id":"manas-2010:p1338:b001:l007","ordinal":57926,"en":"People rejoiced at his appearance."},{"id":"manas-2010:p1338:b001:l008","ordinal":57927,"en":"Who dwelt in Maseyil,"},{"id":"manas-2010:p1338:b001:l009","ordinal":57928,"en":"Called a fortunate, mighty warrior,"},{"id":"manas-2010:p1338:b001:l010","ordinal":57929,"en":"The youngest of nine sons,"},{"id":"manas-2010:p1338:b001:l011","ordinal":57930,"en":"A servant of the one God,"},{"id":"manas-2010:p1338:b001:l012","ordinal":57931,"en":"Eleman's warrior Töshtük,"},{"id":"manas-2010:p1338:b001:l013","ordinal":57932,"en":"Rode the courser Chalkuyruk."},{"id":"manas-2010:p1338:b001:l014","ordinal":57933,"en":"He wore the iron coat Chayyngi."},{"id":"manas-2010:p1338:b001:l015","ordinal":57934,"en":"He took a spear without a plume."},{"id":"manas-2010:p1338:b001:l016","ordinal":57935,"en":"Beneath the earth, warrior Töshtük"},{"id":"manas-2010:p1338:b001:l017","ordinal":57936,"en":"Had been held for seven years."},{"id":"manas-2010:p1338:b001:l018","ordinal":57937,"en":"Through his valor he had found a people;"},{"id":"manas-2010:p1338:b001:l019","ordinal":57938,"en":"Through his skill he had kept himself alive."},{"id":"manas-2010:p1338:b001:l020","ordinal":57939,"en":"If, in seven years beneath the earth,"},{"id":"manas-2010:p1338:b001:l021","ordinal":57940,"en":"The earth's corrosion had not penetrated him,"},{"id":"manas-2010:p1338:b001:l022","ordinal":57941,"en":"Eleman's warrior Töshtük"},{"id":"manas-2010:p1338:b001:l023","ordinal":57942,"en":"Would have been an immeasurable lion."},{"id":"manas-2010:p1338:b001:l024","ordinal":57943,"en":"He too went along the road,"},{"id":"manas-2010:p1338:b001:l025","ordinal":57944,"en":"With an immense, teeming army."},{"id":"manas-2010:p1338:b001:l026","ordinal":57945,"en":"His staring eyes like the morning star,"},{"id":"manas-2010:p1338:b001:l027","ordinal":57946,"en":"His great ears like shields,"},{"id":"manas-2010:p1338:b001:l028","ordinal":57947,"en":"He who dwelt in Chesh-Töbö,"},{"id":"manas-2010:p1338:b001:l029","ordinal":57948,"en":"All those who saw him"},{"id":"manas-2010:p1338:b001:l030","ordinal":57949,"en":"Called him a warrior without measure."},{"id":"manas-2010:p1338:b001:l031","ordinal":57950,"en":"Khan Koshoy of the Katagan,"},{"id":"manas-2010:p1338:b001:l032","ordinal":57951,"en":"Whose blessing enriched the people,"},{"id":"manas-2010:p1338:b001:l033","ordinal":57952,"en":"Who made the poor flourish like the rich,"},{"id":"manas-2010:p1338:b001:l034","ordinal":57953,"en":"Who upheld all the people,"},{"id":"manas-2010:p1338:b001:l035","ordinal":57954,"en":"Who befriended wandering dervishes,"},{"id":"manas-2010:p1338:b001:l036","ordinal":57955,"en":"Who gave sheep to holy mendicants,"},{"id":"manas-2010:p1338:b001:l037","ordinal":57956,"en":"Whose right shoulder was broad,"},{"id":"manas-2010:p1338:b001:l038","ordinal":57957,"en":"When Manas the devastating leopard"},{"id":"manas-2010:p1338:b001:l039","ordinal":57958,"en":"Was still a child at play,"},{"id":"manas-2010:p1338:b001:l040","ordinal":57959,"en":"Chief Koshoy was already a warrior."},{"id":"manas-2010:p1338:b001:l041","ordinal":57960,"en":"The courser Kerkabylan,"},{"id":"manas-2010:p1338:b001:l042","ordinal":57961,"en":"He saddled without a care."},{"id":"manas-2010:p1339:b001:l001","ordinal":57962,"en":"In Egypt and Mecca,"},{"id":"manas-2010:p1339:b001:l002","ordinal":57963,"en":"He had gone and studied five years."},{"id":"manas-2010:p1339:b001:l003","ordinal":57964,"en":"He had acquired many a courser;"},{"id":"manas-2010:p1339:b001:l004","ordinal":57965,"en":"He was called Great Koshoy."},{"id":"manas-2010:p1339:b001:l005","ordinal":57966,"en":"Your elder, warrior Koshoy,"},{"id":"manas-2010:p1339:b001:l006","ordinal":57967,"en":"Coughing in great fits,"},{"id":"manas-2010:p1339:b001:l007","ordinal":57968,"en":"Raised the Muslim standard."},{"id":"manas-2010:p1339:b001:l008","ordinal":57969,"en":"He too went along the road,"},{"id":"manas-2010:p1339:b001:l009","ordinal":57970,"en":"With an army covering the earth."},{"id":"manas-2010:p1339:b001:l010","ordinal":57971,"en":"He spoke to the people;"},{"id":"manas-2010:p1339:b001:l011","ordinal":57972,"en":"Dear Koshoy spoke:"},{"id":"manas-2010:p1339:b001:l012","ordinal":57973,"en":"“Let none of you turn aside and stay behind."},{"id":"manas-2010:p1339:b001:l013","ordinal":57974,"en":"Beijing ahead is a populous land."},{"id":"manas-2010:p1339:b001:l014","ordinal":57975,"en":"Coming upon its sentries,"},{"id":"manas-2010:p1339:b001:l015","ordinal":57976,"en":"Do not be left in disaster."},{"id":"manas-2010:p1339:b001:l016","ordinal":57977,"en":"On cliff-like ridges, on winding roads,"},{"id":"manas-2010:p1339:b001:l017","ordinal":57978,"en":"Do not let half of you stay behind."},{"id":"manas-2010:p1339:b001:l018","ordinal":57979,"en":"Beijing teems with a mighty people;"},{"id":"manas-2010:p1339:b001:l019","ordinal":57980,"en":"Do not be slaughtered."},{"id":"manas-2010:p1339:b001:l020","ordinal":57981,"en":"There is no forest to flee into."},{"id":"manas-2010:p1339:b001:l021","ordinal":57982,"en":"If you fall behind, Muslims,"},{"id":"manas-2010:p1339:b001:l022","ordinal":57983,"en":"You will see what you have never seen."},{"id":"manas-2010:p1339:b001:l023","ordinal":57984,"en":"Suffering unforeseen hardship,"},{"id":"manas-2010:p1339:b001:l024","ordinal":57985,"en":"If the unbelievers' guards"},{"id":"manas-2010:p1339:b001:l025","ordinal":57986,"en":"Seize you, people,"},{"id":"manas-2010:p1339:b001:l026","ordinal":57987,"en":"You will die a needless death.”"},{"id":"manas-2010:p1339:b001:l027","ordinal":57988,"en":"When Koshoy said this,"},{"id":"manas-2010:p1339:b001:l028","ordinal":57989,"en":"“Those are words indeed, warrior!” he said."},{"id":"manas-2010:p1339:b001:l029","ordinal":57990,"en":"“Your words are counsel for the people,” he said."},{"id":"manas-2010:p1339:b001:l030","ordinal":57991,"en":"Hearing his words, Khan Bakay,"},{"id":"manas-2010:p1339:b001:l031","ordinal":57992,"en":"The old man, went on then."},{"id":"manas-2010:p1339:b001:l032","ordinal":57993,"en":"The teeming mass of Muslims,"},{"id":"manas-2010:p1339:b001:l033","ordinal":57994,"en":"All went on then."},{"id":"manas-2010:p1339:b001:l034","ordinal":57995,"en":"Old Kyrgyl, head of the forty,"},{"id":"manas-2010:p1339:b001:l035","ordinal":57996,"en":"Shuutu the fellow, his hat like a roof-felt,"},{"id":"manas-2010:p1339:b001:l036","ordinal":57997,"en":"Following behind the great army,"},{"id":"manas-2010:p1339:b001:l037","ordinal":57998,"en":"The forty companions went on."},{"id":"manas-2010:p1339:b001:l038","ordinal":57999,"en":"Behind the army, Muzburchak,"},{"id":"manas-2010:p1339:b001:l039","ordinal":58000,"en":"How could your champion hold back?"},{"id":"manas-2010:p1339:b001:l040","ordinal":58001,"en":"When dawn broke clear,"},{"id":"manas-2010:p1339:b001:l041","ordinal":58002,"en":"When light fell on the earth,"},{"id":"manas-2010:p1339:b001:l042","ordinal":58003,"en":"The great army laying siege,"},{"id":"manas-2010:p1340:b001:l001","ordinal":58004,"en":"Boiling bitter brine,"},{"id":"manas-2010:p1340:b001:l002","ordinal":58005,"en":"At the edge of the many Chinese,"},{"id":"manas-2010:p1340:b001:l003","ordinal":58006,"en":"They arrived and drew near."},{"id":"manas-2010:p1340:b001:l004","ordinal":58007,"en":"When Muzburchak arrived,"},{"id":"manas-2010:p1340:b001:l005","ordinal":58008,"en":"If what I tell is not a lie,"},{"id":"manas-2010:p1340:b001:l006","ordinal":58009,"en":"Much is false and much is true;"},{"id":"manas-2010:p1340:b001:l007","ordinal":58010,"en":"No one was there watching."},{"id":"manas-2010:p1340:b001:l008","ordinal":58011,"en":"One thing false, one thing true;"},{"id":"manas-2010:p1340:b001:l009","ordinal":58012,"en":"No one came knowing it."},{"id":"manas-2010:p1340:b001:l010","ordinal":58013,"en":"Shooting their bows like rain,"},{"id":"manas-2010:p1340:b001:l011","ordinal":58014,"en":"Firing their shots like hail,"},{"id":"manas-2010:p1340:b001:l012","ordinal":58015,"en":"Roaring their battle cries,"},{"id":"manas-2010:p1340:b001:l013","ordinal":58016,"en":"You could not tell which was which."},{"id":"manas-2010:p1340:b001:l014","ordinal":58017,"en":"The Chinese swarmed in together,"},{"id":"manas-2010:p1340:b001:l015","ordinal":58018,"en":"Upon those who came unwary."},{"id":"manas-2010:p1340:b001:l016","ordinal":58019,"en":"A looming mass, a dark ridge,"},{"id":"manas-2010:p1340:b001:l017","ordinal":58020,"en":"It was no dark ridge, but people."},{"id":"manas-2010:p1340:b001:l018","ordinal":58021,"en":"Many blazing stars,"},{"id":"manas-2010:p1340:b001:l019","ordinal":58022,"en":"They were not stars, but fires."},{"id":"manas-2010:p1340:b001:l020","ordinal":58023,"en":"Crawling like ants,"},{"id":"manas-2010:p1340:b001:l021","ordinal":58024,"en":"They were encircling them."},{"id":"manas-2010:p1340:b001:l022","ordinal":58025,"en":"A raven could not fly free,"},{"id":"manas-2010:p1340:b001:l023","ordinal":58026,"en":"So numerous were the Chinese,"},{"id":"manas-2010:p1340:b001:l024","ordinal":58027,"en":"A people thick as sand."},{"id":"manas-2010:p1340:b001:l025","ordinal":58028,"en":"When they saw Muzburchak,"},{"id":"manas-2010:p1340:b001:l026","ordinal":58029,"en":"“This is the Burut army!” they said."},{"id":"manas-2010:p1340:b001:l027","ordinal":58030,"en":"Without turning aside, the Chinese made ready;"},{"id":"manas-2010:p1340:b001:l028","ordinal":58031,"en":"They swarmed upon them together."},{"id":"manas-2010:p1340:b001:l029","ordinal":58032,"en":"A thousand Chinese to one Burut,"},{"id":"manas-2010:p1340:b001:l030","ordinal":58033,"en":"The Muslims mingled in the fight."},{"id":"manas-2010:p1340:b001:l031","ordinal":58034,"en":"Muzburchak upon Telkyzyl,"},{"id":"manas-2010:p1340:b001:l032","ordinal":58035,"en":"Girding his waist with a leather belt,"},{"id":"manas-2010:p1340:b001:l033","ordinal":58036,"en":"Muzburchak charged alone."},{"id":"manas-2010:p1340:b001:l034","ordinal":58037,"en":"Against seventy thousand unbelievers,"},{"id":"manas-2010:p1340:b001:l035","ordinal":58038,"en":"He charged alone, attacking."},{"id":"manas-2010:p1340:b001:l036","ordinal":58039,"en":"The earth split apart, becoming dust."},{"id":"manas-2010:p1340:b001:l037","ordinal":58040,"en":"Over the earth's face, in their multitude,"},{"id":"manas-2010:p1340:b001:l038","ordinal":58041,"en":"They had spread everywhere."},{"id":"manas-2010:p1340:b001:l039","ordinal":58042,"en":"The many Chinese crowded together,"},{"id":"manas-2010:p1340:b001:l040","ordinal":58043,"en":"They had engulfed him."},{"id":"manas-2010:p1340:b001:l041","ordinal":58044,"en":"Khan Buudayyk's Muzburchak,"},{"id":"manas-2010:p1340:b001:l042","ordinal":58045,"en":"Thrusting spears and grappling,"},{"id":"manas-2010:p1341:b001:l001","ordinal":58046,"en":"Not sparing his life at all,"},{"id":"manas-2010:p1341:b001:l002","ordinal":58047,"en":"Fighting with all his might,"},{"id":"manas-2010:p1341:b001:l003","ordinal":58048,"en":"When the unbelievers came surrounding him,"},{"id":"manas-2010:p1341:b001:l004","ordinal":58049,"en":"He escaped upon Telkyzyl."},{"id":"manas-2010:p1341:b001:l005","ordinal":58050,"en":"Among the seething Chinese army,"},{"id":"manas-2010:p1341:b001:l006","ordinal":58051,"en":"Körögöch was left captive."},{"id":"manas-2010:p1341:b001:l007","ordinal":58052,"en":"Many thoughts were in his breast:"},{"id":"manas-2010:p1341:b001:l008","ordinal":58053,"en":"“My blue-maned Manas, my champion,"},{"id":"manas-2010:p1341:b001:l009","ordinal":58054,"en":"How is he faring?” he thought."},{"id":"manas-2010:p1341:b001:l010","ordinal":58055,"en":"His tears streamed in ten directions."},{"id":"manas-2010:p1341:b001:l011","ordinal":58056,"en":"Grief fell upon his head;"},{"id":"manas-2010:p1341:b001:l012","ordinal":58057,"en":"He was filled with sorrow."},{"id":"manas-2010:p1341:b001:l013","ordinal":58058,"en":"To Manas upon Tal-Choku,"},{"id":"manas-2010:p1341:b001:l014","ordinal":58059,"en":"Muzburchak now arrived:"},{"id":"manas-2010:p1341:b001:l015","ordinal":58060,"en":"“Without sparing my horse, for your sake,"},{"id":"manas-2010:p1341:b001:l016","ordinal":58061,"en":"I have come expressly, Khan Manas."},{"id":"manas-2010:p1341:b001:l017","ordinal":58062,"en":"Without holding back, for your sake,"},{"id":"manas-2010:p1341:b001:l018","ordinal":58063,"en":"I shall enter the shooting; give me your coat."},{"id":"manas-2010:p1341:b001:l019","ordinal":58064,"en":"I shall fight to the death for you!"},{"id":"manas-2010:p1341:b001:l020","ordinal":58065,"en":"With the Chinese, warrior Manas,"},{"id":"manas-2010:p1341:b001:l021","ordinal":58066,"en":"Give me the chance to fight."},{"id":"manas-2010:p1341:b001:l022","ordinal":58067,"en":"Give me your army led by the forty companions!”"},{"id":"manas-2010:p1341:b001:l023","ordinal":58068,"en":"Buudayyk's Muzburchak,"},{"id":"manas-2010:p1341:b001:l024","ordinal":58069,"en":"As he was saying this,"},{"id":"manas-2010:p1341:b001:l025","ordinal":58070,"en":"Would Manas stand there hard pressed?"},{"id":"manas-2010:p1341:b001:l026","ordinal":58071,"en":"Making Akkula leap,"},{"id":"manas-2010:p1341:b001:l027","ordinal":58072,"en":"Your lion, King Manas,"},{"id":"manas-2010:p1341:b001:l028","ordinal":58073,"en":"Firing repeated shots with Akkelte,"},{"id":"manas-2010:p1341:b001:l029","ordinal":58074,"en":"Crying “Manas!” as his battle cry,"},{"id":"manas-2010:p1341:b001:l030","ordinal":58075,"en":"He entered the battle roaring."},{"id":"manas-2010:p1341:b001:l031","ordinal":58076,"en":"Making Akkula rear,"},{"id":"manas-2010:p1341:b001:l032","ordinal":58077,"en":"He broke through, devastating them."},{"id":"manas-2010:p1341:b001:l033","ordinal":58078,"en":"Your blue-maned one, seething with wrath,"},{"id":"manas-2010:p1341:b001:l034","ordinal":58079,"en":"His shout splitting stones,"},{"id":"manas-2010:p1341:b001:l035","ordinal":58080,"en":"At the Chinese pressing upon him,"},{"id":"manas-2010:p1341:b001:l036","ordinal":58081,"en":"Manas charged with a roar."},{"id":"manas-2010:p1341:b001:l037","ordinal":58082,"en":"Close behind him, Azhybay"},{"id":"manas-2010:p1341:b001:l038","ordinal":58083,"en":"Went keeping watch."},{"id":"manas-2010:p1341:b001:l039","ordinal":58084,"en":"Baychoro of the mighty arms,"},{"id":"manas-2010:p1341:b001:l040","ordinal":58085,"en":"Unshakable Agayar,"},{"id":"manas-2010:p1341:b001:l041","ordinal":58086,"en":"Now charged into the melee."},{"id":"manas-2010:p1341:b001:l042","ordinal":58087,"en":"When you looked, they escaped the eye,"},{"id":"manas-2010:p1342:b001:l001","ordinal":58088,"en":"You could not tell which was which."},{"id":"manas-2010:p1342:b001:l002","ordinal":58089,"en":"Like flying tumbleweed,"},{"id":"manas-2010:p1342:b001:l003","ordinal":58090,"en":"All the champions,"},{"id":"manas-2010:p1342:b001:l004","ordinal":58091,"en":"Your champion Manas, the blue-maned one,"},{"id":"manas-2010:p1342:b001:l005","ordinal":58092,"en":"Manas slaughtered and devastated them."},{"id":"manas-2010:p1342:b001:l006","ordinal":58093,"en":"Prowling like a hungry lion,"},{"id":"manas-2010:p1342:b001:l007","ordinal":58094,"en":"When Manas charged with a shout,"},{"id":"manas-2010:p1342:b001:l008","ordinal":58095,"en":"Blood flowed knee-deep."},{"id":"manas-2010:p1342:b001:l009","ordinal":58096,"en":"It streamed over the earth's face."},{"id":"manas-2010:p1342:b001:l010","ordinal":58097,"en":"As Manas went slaughtering,"},{"id":"manas-2010:p1342:b001:l011","ordinal":58098,"en":"The Muslims of twelve khans"},{"id":"manas-2010:p1342:b001:l012","ordinal":58099,"en":"Joined in the battle."},{"id":"manas-2010:p1342:b001:l013","ordinal":58100,"en":"When they shouted, no man could withstand them;"},{"id":"manas-2010:p1342:b001:l014","ordinal":58101,"en":"A lion's teeth could not pierce them."},{"id":"manas-2010:p1342:b001:l015","ordinal":58102,"en":"They bloodied whoever attacked them,"},{"id":"manas-2010:p1342:b001:l016","ordinal":58103,"en":"Stunned whoever encountered them."},{"id":"manas-2010:p1342:b001:l017","ordinal":58104,"en":"Khan Manas's forty companions,"},{"id":"manas-2010:p1342:b001:l018","ordinal":58105,"en":"At the immense Chinese army,"},{"id":"manas-2010:p1342:b001:l019","ordinal":58106,"en":"Charged all together in a mass."},{"id":"manas-2010:p1342:b001:l020","ordinal":58107,"en":"When the forty companions fought,"},{"id":"manas-2010:p1342:b001:l021","ordinal":58108,"en":"When the Muslims of twelve khans"},{"id":"manas-2010:p1342:b001:l022","ordinal":58109,"en":"Fought alongside them,"},{"id":"manas-2010:p1342:b001:l023","ordinal":58110,"en":"The many Chinese did not budge."},{"id":"manas-2010:p1342:b001:l024","ordinal":58111,"en":"Fighting in the melee,"},{"id":"manas-2010:p1342:b001:l025","ordinal":58112,"en":"Those whose death had come died."}]
