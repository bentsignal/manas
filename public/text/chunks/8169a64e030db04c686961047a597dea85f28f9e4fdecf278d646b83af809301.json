[{"id":"manas-2010:p0799:b001:l010","ordinal":35329,"en":"All despaired of their lives."},{"id":"manas-2010:p0799:b001:l011","ordinal":35330,"en":"Khan Shooruk's many soldiers"},{"id":"manas-2010:p0799:b001:l012","ordinal":35331,"en":"Climbed down from their camels,"},{"id":"manas-2010:p0799:b001:l013","ordinal":35332,"en":"Folded their hands across their bellies,"},{"id":"manas-2010:p0799:b001:l014","ordinal":35333,"en":"Bobbing like brides,"},{"id":"manas-2010:p0799:b001:l015","ordinal":35334,"en":"They began to bow in homage."},{"id":"manas-2010:p0799:b001:l016","ordinal":35335,"en":"Their knees bent;"},{"id":"manas-2010:p0799:b001:l017","ordinal":35336,"en":"Before the bloodthirsty lion,"},{"id":"manas-2010:p0799:b001:l018","ordinal":35337,"en":"So many champions, so many soldiers,"},{"id":"manas-2010:p0799:b001:l019","ordinal":35338,"en":"Bowed in the Chinese manner."},{"id":"manas-2010:p0799:b001:l020","ordinal":35339,"en":"‘We surrender!’ they shouted,"},{"id":"manas-2010:p0799:b001:l021","ordinal":35340,"en":"Each one to another"},{"id":"manas-2010:p0799:b001:l022","ordinal":35341,"en":"Calling, ‘Get down from your camel!’"},{"id":"manas-2010:p0799:b001:l023","ordinal":35342,"en":"Manas waged a fierce fight."},{"id":"manas-2010:p0799:b001:l024","ordinal":35343,"en":"As he was taking Khan Shooruk,"},{"id":"manas-2010:p0799:b001:l025","ordinal":35344,"en":"The many soldiers clamored,"},{"id":"manas-2010:p0799:b001:l026","ordinal":35345,"en":"Dismounting from their horses,"},{"id":"manas-2010:p0799:b001:l027","ordinal":35346,"en":"Their knees bending."},{"id":"manas-2010:p0799:b001:l028","ordinal":35347,"en":"The forty champions stood astonished."},{"id":"manas-2010:p0799:b001:l029","ordinal":35348,"en":"When they saw hero Manas,"},{"id":"manas-2010:p0799:b001:l030","ordinal":35349,"en":"Utterly despairing of their lives,"},{"id":"manas-2010:p0799:b001:l031","ordinal":35350,"en":"The farther part of the army"},{"id":"manas-2010:p0799:b001:l032","ordinal":35351,"en":"Panicked, unable to find a way."},{"id":"manas-2010:p0799:b001:l033","ordinal":35352,"en":"Into renowned Khan Shooruk's"},{"id":"manas-2010:p0799:b001:l034","ordinal":35353,"en":"Throne room they fled."},{"id":"manas-2010:p0799:b001:l035","ordinal":35354,"en":"With no words to say,"},{"id":"manas-2010:p0799:b001:l036","ordinal":35355,"en":"The champion he had trusted"},{"id":"manas-2010:p0799:b001:l037","ordinal":35356,"en":"Was terribly alarmed."},{"id":"manas-2010:p0799:b001:l038","ordinal":35357,"en":"Of that warrior Khan Shooruk,"},{"id":"manas-2010:p0799:b001:l039","ordinal":35358,"en":"He trampled the throne as he fled."},{"id":"manas-2010:p0799:b001:l040","ordinal":35359,"en":"Khan Shooruk lost his senses;"},{"id":"manas-2010:p0799:b001:l041","ordinal":35360,"en":"When he saw his champions,"},{"id":"manas-2010:p0799:b001:l042","ordinal":35361,"en":"‘Good heavens, what a horror!’ he said,"},{"id":"manas-2010:p0800:b001:l001","ordinal":35362,"en":"His mind was terribly alarmed."},{"id":"manas-2010:p0800:b001:l002","ordinal":35363,"en":"His champions came bobbing,"},{"id":"manas-2010:p0800:b001:l003","ordinal":35364,"en":"Running in without end."},{"id":"manas-2010:p0800:b001:l004","ordinal":35365,"en":"When he saw that champion,"},{"id":"manas-2010:p0800:b001:l005","ordinal":35366,"en":"Khan Shooruk then"},{"id":"manas-2010:p0800:b001:l006","ordinal":35367,"en":"Despaired of his life."},{"id":"manas-2010:p0800:b001:l007","ordinal":35368,"en":"The strongest of the gatekeepers,"},{"id":"manas-2010:p0800:b001:l008","ordinal":35369,"en":"The most skillful of the spearmen,"},{"id":"manas-2010:p0800:b001:l009","ordinal":35370,"en":"His mace-wielding champion,"},{"id":"manas-2010:p0800:b001:l010","ordinal":35371,"en":"Before Khan Shooruk,"},{"id":"manas-2010:p0800:b001:l011","ordinal":35372,"en":"The renowned Zhöözheldet,"},{"id":"manas-2010:p0800:b001:l012","ordinal":35373,"en":"Tongue-tied when he tried to speak,"},{"id":"manas-2010:p0800:b001:l013","ordinal":35374,"en":"Had fled back once more."},{"id":"manas-2010:p0800:b001:l014","ordinal":35375,"en":"When he looked at Zhöözheldet,"},{"id":"manas-2010:p0800:b001:l015","ordinal":35376,"en":"Wishing for his people's safety,"},{"id":"manas-2010:p0800:b001:l016","ordinal":35377,"en":"He saw the champion stripped of human bearing."},{"id":"manas-2010:p0800:b001:l017","ordinal":35378,"en":"May God spare us the sight!"},{"id":"manas-2010:p0800:b001:l018","ordinal":35379,"en":"He was a whirl of dust,"},{"id":"manas-2010:p0800:b001:l019","ordinal":35380,"en":"He was a red bucket of blood,"},{"id":"manas-2010:p0800:b001:l020","ordinal":35381,"en":"His eyes darting wildly,"},{"id":"manas-2010:p0800:b001:l021","ordinal":35382,"en":"His legs dangling loose,"},{"id":"manas-2010:p0800:b001:l022","ordinal":35383,"en":"The weapon-handle slipped from his hand,"},{"id":"manas-2010:p0800:b001:l023","ordinal":35384,"en":"The covering gone from his heart."},{"id":"manas-2010:p0800:b001:l024","ordinal":35385,"en":"He saw the champion stripped of human bearing,"},{"id":"manas-2010:p0800:b001:l025","ordinal":35386,"en":"Who had fled before him."},{"id":"manas-2010:p0800:b001:l026","ordinal":35387,"en":"To the unbeliever full of strength,"},{"id":"manas-2010:p0800:b001:l027","ordinal":35388,"en":"To poor warrior Shooruk,"},{"id":"manas-2010:p0800:b001:l028","ordinal":35389,"en":"He gave this news:"},{"id":"manas-2010:p0800:b001:l029","ordinal":35390,"en":"‘Damn your father's grave, hero Shooruk,"},{"id":"manas-2010:p0800:b001:l030","ordinal":35391,"en":"You were a man of surpassing strength."},{"id":"manas-2010:p0800:b001:l031","ordinal":35392,"en":"Heard by ears and seen by eyes,"},{"id":"manas-2010:p0800:b001:l032","ordinal":35393,"en":"To every soul who knew,"},{"id":"manas-2010:p0800:b001:l033","ordinal":35394,"en":"You had the name Khan Shooruk."},{"id":"manas-2010:p0800:b001:l034","ordinal":35395,"en":"I saw a being of greater strength,"},{"id":"manas-2010:p0800:b001:l035","ordinal":35396,"en":"His bearing strange, his wrath fierce."},{"id":"manas-2010:p0800:b001:l036","ordinal":35397,"en":"Once you have seen his scowl,"},{"id":"manas-2010:p0800:b001:l037","ordinal":35398,"en":"Give up hope of your dear life!"},{"id":"manas-2010:p0800:b001:l038","ordinal":35399,"en":"What they all ride,"},{"id":"manas-2010:p0800:b001:l039","ordinal":35400,"en":"They have beasts that fly like clouds."},{"id":"manas-2010:p0800:b001:l040","ordinal":35401,"en":"Their spears are wetted with blood;"},{"id":"manas-2010:p0800:b001:l041","ordinal":35402,"en":"Every one is utterly bloodthirsty."},{"id":"manas-2010:p0800:b001:l042","ordinal":35403,"en":"When I look at their manner,"},{"id":"manas-2010:p0801:b001:l001","ordinal":35404,"en":"Dust rises from their movement;"},{"id":"manas-2010:p0801:b001:l002","ordinal":35405,"en":"Souls depart at their voices."},{"id":"manas-2010:p0801:b001:l003","ordinal":35406,"en":"When I look at them all,"},{"id":"manas-2010:p0801:b001:l004","ordinal":35407,"en":"Thick-armed and stone-hearted,"},{"id":"manas-2010:p0801:b001:l005","ordinal":35408,"en":"Elephant-bodied fierce men,"},{"id":"manas-2010:p0801:b001:l006","ordinal":35409,"en":"They stand out like mountains and rocks."},{"id":"manas-2010:p0801:b001:l007","ordinal":35410,"en":"Wherever they lumber along,"},{"id":"manas-2010:p0801:b001:l008","ordinal":35411,"en":"They seem to unleash hell."},{"id":"manas-2010:p0801:b001:l009","ordinal":35412,"en":"Their war-gear numbers eighty-four;"},{"id":"manas-2010:p0801:b001:l010","ordinal":35413,"en":"No person could draw near."},{"id":"manas-2010:p0801:b001:l011","ordinal":35414,"en":"Wherever they sweep, a crimson blaze."},{"id":"manas-2010:p0801:b001:l012","ordinal":35415,"en":"Those they faced were destroyed;"},{"id":"manas-2010:p0801:b001:l013","ordinal":35416,"en":"They bloodied whoever attacked them."},{"id":"manas-2010:p0801:b001:l014","ordinal":35417,"en":"None remained to offer resistance."},{"id":"manas-2010:p0801:b001:l015","ordinal":35418,"en":"Among the watchmen, a khan died;"},{"id":"manas-2010:p0801:b001:l016","ordinal":35419,"en":"Everyone who grappled with them died."},{"id":"manas-2010:p0801:b001:l017","ordinal":35420,"en":"Of the champion who came to fight,"},{"id":"manas-2010:p0801:b001:l018","ordinal":35421,"en":"Only his hair remained sticking up."},{"id":"manas-2010:p0801:b001:l019","ordinal":35422,"en":"The nobles who guarded the gate"},{"id":"manas-2010:p0801:b001:l020","ordinal":35423,"en":"All died sprawled out."},{"id":"manas-2010:p0801:b001:l021","ordinal":35424,"en":"They seized the strong;"},{"id":"manas-2010:p0801:b001:l022","ordinal":35425,"en":"Those who offered stubborn resistance,"},{"id":"manas-2010:p0801:b001:l023","ordinal":35426,"en":"They slew them all, leaving none."},{"id":"manas-2010:p0801:b001:l024","ordinal":35427,"en":"He sits his horse with splendid grace,"},{"id":"manas-2010:p0801:b001:l025","ordinal":35428,"en":"Wearing a sturdy coat drawn taut."},{"id":"manas-2010:p0801:b001:l026","ordinal":35429,"en":"His shape and stately bearing,"},{"id":"manas-2010:p0801:b001:l027","ordinal":35430,"en":"They seem unlike anything in the world,"},{"id":"manas-2010:p0801:b001:l028","ordinal":35431,"en":"His posture upon horseback."},{"id":"manas-2010:p0801:b001:l029","ordinal":35432,"en":"He is a somewhat stooping hero,"},{"id":"manas-2010:p0801:b001:l030","ordinal":35433,"en":"Abundant on every side,"},{"id":"manas-2010:p0801:b001:l031","ordinal":35434,"en":"No mortal could defeat him in battle."},{"id":"manas-2010:p0801:b001:l032","ordinal":35435,"en":"Souls depart at his fury;"},{"id":"manas-2010:p0801:b001:l033","ordinal":35436,"en":"He is a bringer of dark misfortune."},{"id":"manas-2010:p0801:b001:l034","ordinal":35437,"en":"My thoughts were bewildered."},{"id":"manas-2010:p0801:b001:l035","ordinal":35438,"en":"If we do not heed his counsel,"},{"id":"manas-2010:p0801:b001:l036","ordinal":35439,"en":"If we do not give what he asks,"},{"id":"manas-2010:p0801:b001:l037","ordinal":35440,"en":"Not merely us, but the whole world,"},{"id":"manas-2010:p0801:b001:l038","ordinal":35441,"en":"He looks capable of taking."},{"id":"manas-2010:p0801:b001:l039","ordinal":35442,"en":"Merciless turmoil,"},{"id":"manas-2010:p0801:b001:l040","ordinal":35443,"en":"He looks capable of unleashing."},{"id":"manas-2010:p0801:b001:l041","ordinal":35444,"en":"Forty-one people emerged from the ridge;"},{"id":"manas-2010:p0801:b001:l042","ordinal":35445,"en":"I marvel at their valor,"},{"id":"manas-2010:p0802:b001:l001","ordinal":35446,"en":"No such beings exist in all ages."},{"id":"manas-2010:p0802:b001:l002","ordinal":35447,"en":"Their habit is never to be sated with blood."},{"id":"manas-2010:p0802:b001:l003","ordinal":35448,"en":"They will bring grievous hardship;"},{"id":"manas-2010:p0802:b001:l004","ordinal":35449,"en":"Where have these mighty ones come from?"},{"id":"manas-2010:p0802:b001:l005","ordinal":35450,"en":"Finding no mountain to strike against,"},{"id":"manas-2010:p0802:b001:l006","ordinal":35451,"en":"Finding no enemy to fight,"},{"id":"manas-2010:p0802:b001:l007","ordinal":35452,"en":"Roaming the lands of the world,"},{"id":"manas-2010:p0802:b001:l008","ordinal":35453,"en":"All forty seem lions of great worth."},{"id":"manas-2010:p0802:b001:l009","ordinal":35454,"en":"Deliberately seeking us,"},{"id":"manas-2010:p0802:b001:l010","ordinal":35455,"en":"They seem heroes who have come to invade."},{"id":"manas-2010:p0802:b001:l011","ordinal":35456,"en":"If we eagerly pick a fight,"},{"id":"manas-2010:p0802:b001:l012","ordinal":35457,"en":"They seem poised to slaughter us."},{"id":"manas-2010:p0802:b001:l013","ordinal":35458,"en":"Their leader is imperious."},{"id":"manas-2010:p0802:b001:l014","ordinal":35459,"en":"As I weigh him and consider,"},{"id":"manas-2010:p0802:b001:l015","ordinal":35460,"en":"He would do whatever he wished."},{"id":"manas-2010:p0802:b001:l016","ordinal":35461,"en":"If we resist and clash,"},{"id":"manas-2010:p0802:b001:l017","ordinal":35462,"en":"If we stand and fight without fleeing,"},{"id":"manas-2010:p0802:b001:l018","ordinal":35463,"en":"He would slaughter the people, leaving none."},{"id":"manas-2010:p0802:b001:l019","ordinal":35464,"en":"My collarbones tremble;"},{"id":"manas-2010:p0802:b001:l020","ordinal":35465,"en":"My heart pounds and shudders."},{"id":"manas-2010:p0802:b001:l021","ordinal":35466,"en":"Finding no shelter, finding no support,"},{"id":"manas-2010:p0802:b001:l022","ordinal":35467,"en":"“We had a khan to stand behind us,” we said,"},{"id":"manas-2010:p0802:b001:l023","ordinal":35468,"en":"And fled here to you."},{"id":"manas-2010:p0802:b001:l024","ordinal":35469,"en":"Perhaps you have heard of him;"},{"id":"manas-2010:p0802:b001:l025","ordinal":35470,"en":"I pieced it together from inherited lore,"},{"id":"manas-2010:p0802:b001:l026","ordinal":35471,"en":"I asked those who knew."},{"id":"manas-2010:p0802:b001:l027","ordinal":35472,"en":"Whose hoofbeats split the level earth,"},{"id":"manas-2010:p0802:b001:l028","ordinal":35473,"en":"His strength extraordinary, his wrath fierce,"},{"id":"manas-2010:p0802:b001:l029","ordinal":35474,"en":"It is Bloodthirsty Manas himself."},{"id":"manas-2010:p0802:b001:l030","ordinal":35475,"en":"To slaughter your people,"},{"id":"manas-2010:p0802:b001:l031","ordinal":35476,"en":"He has now set forth prepared."},{"id":"manas-2010:p0802:b001:l032","ordinal":35477,"en":"When we took the Noygut lately,"},{"id":"manas-2010:p0802:b001:l033","ordinal":35478,"en":"Crushing so many of them,"},{"id":"manas-2010:p0802:b001:l034","ordinal":35479,"en":"Slaughtering them utterly,"},{"id":"manas-2010:p0802:b001:l035","ordinal":35480,"en":"When we plundered their finery,"},{"id":"manas-2010:p0802:b001:l036","ordinal":35481,"en":"When we wrought terrible havoc,"},{"id":"manas-2010:p0802:b001:l037","ordinal":35482,"en":"Displaying our prowess,"},{"id":"manas-2010:p0802:b001:l038","ordinal":35483,"en":"The women and girls taken as booty,"},{"id":"manas-2010:p0802:b001:l039","ordinal":35484,"en":"Mounting them on young camels and camels,"},{"id":"manas-2010:p0802:b001:l040","ordinal":35485,"en":"When we returned with our plunder,"},{"id":"manas-2010:p0802:b001:l041","ordinal":35486,"en":"Those accursed Noygut"},{"id":"manas-2010:p0802:b001:l042","ordinal":35487,"en":"Must have fled to him,"},{"id":"manas-2010:p0803:b001:l001","ordinal":35488,"en":"Telling their condition plainly,"},{"id":"manas-2010:p0803:b001:l002","ordinal":35489,"en":"To ruthless, bloodthirsty Manas"},{"id":"manas-2010:p0803:b001:l003","ordinal":35490,"en":"They must have told their secrets."},{"id":"manas-2010:p0803:b001:l004","ordinal":35491,"en":"At this, the blood-drinker,"},{"id":"manas-2010:p0803:b001:l005","ordinal":35492,"en":"His whole inside burning with fire,"},{"id":"manas-2010:p0803:b001:l006","ordinal":35493,"en":"Unable to endure it, taking his spear,"},{"id":"manas-2010:p0803:b001:l007","ordinal":35494,"en":"Must have crossed the Ala-Too."},{"id":"manas-2010:p0803:b001:l008","ordinal":35495,"en":"“If you wish for slaughter, here it is,” he said;"},{"id":"manas-2010:p0803:b001:l009","ordinal":35496,"en":"Without letting us prepare,"},{"id":"manas-2010:p0803:b001:l010","ordinal":35497,"en":"He must have descended upon our heads."},{"id":"manas-2010:p0803:b001:l011","ordinal":35498,"en":"Who loaded camels with fine cloth,"},{"id":"manas-2010:p0803:b001:l012","ordinal":35499,"en":"Who traveled for months and years,"},{"id":"manas-2010:p0803:b001:l013","ordinal":35500,"en":"Who broke their dromedaries' legs,"},{"id":"manas-2010:p0803:b001:l014","ordinal":35501,"en":"The four corners of the round world,"},{"id":"manas-2010:p0803:b001:l015","ordinal":35502,"en":"Who roamed around them four times,"},{"id":"manas-2010:p0803:b001:l016","ordinal":35503,"en":"From caravans I heard word."},{"id":"manas-2010:p0803:b001:l017","ordinal":35504,"en":"Fighting in the broad Altai,"},{"id":"manas-2010:p0803:b001:l018","ordinal":35505,"en":"Esenkan's champions,"},{"id":"manas-2010:p0803:b001:l019","ordinal":35506,"en":"I heard, he slaughtered utterly."},{"id":"manas-2010:p0803:b001:l020","ordinal":35507,"en":"He unleashed a terrible wrath."},{"id":"manas-2010:p0803:b001:l021","ordinal":35508,"en":"The ogres and giants who grappled with him,"},{"id":"manas-2010:p0803:b001:l022","ordinal":35509,"en":"He slaughtered utterly."},{"id":"manas-2010:p0803:b001:l023","ordinal":35510,"en":"No man went forth to face him."},{"id":"manas-2010:p0803:b001:l024","ordinal":35511,"en":"Against bloodthirsty champion Manas,"},{"id":"manas-2010:p0803:b001:l025","ordinal":35512,"en":"Among the teeming Chinese,"},{"id":"manas-2010:p0803:b001:l026","ordinal":35513,"en":"None remained even to turn a catching-pole."},{"id":"manas-2010:p0803:b001:l027","ordinal":35514,"en":"They say he wrought great havoc."},{"id":"manas-2010:p0803:b001:l028","ordinal":35515,"en":"Of the Black Kalmyks and Manchus,"},{"id":"manas-2010:p0803:b001:l029","ordinal":35516,"en":"They say he put a cooking-trivet upon their heads."},{"id":"manas-2010:p0803:b001:l030","ordinal":35517,"en":"He devoured all the generals."},{"id":"manas-2010:p0803:b001:l031","ordinal":35518,"en":"Against ill-omened Manas,"},{"id":"manas-2010:p0803:b001:l032","ordinal":35519,"en":"No Chinese remained to grapple."},{"id":"manas-2010:p0803:b001:l033","ordinal":35520,"en":"It is that bloodthirsty one himself."},{"id":"manas-2010:p0803:b001:l034","ordinal":35521,"en":"To scatter his dragon's venom,"},{"id":"manas-2010:p0803:b001:l035","ordinal":35522,"en":"He has come here deliberately."},{"id":"manas-2010:p0803:b001:l036","ordinal":35523,"en":"Having killed the khan of Kangay,"},{"id":"manas-2010:p0803:b001:l037","ordinal":35524,"en":"I heard, he descended to the Altai."},{"id":"manas-2010:p0803:b001:l038","ordinal":35525,"en":"Having killed the khan of the Altai,"},{"id":"manas-2010:p0803:b001:l039","ordinal":35526,"en":"I heard, he came to the Ala-Too."},{"id":"manas-2010:p0803:b001:l040","ordinal":35527,"en":"The religious lord in Kokand,"},{"id":"manas-2010:p0803:b001:l041","ordinal":35528,"en":"I heard, he laid hands upon him."},{"id":"manas-2010:p0803:b001:l042","ordinal":35529,"en":"Everyone who attacked him,"},{"id":"manas-2010:p0804:b001:l001","ordinal":35530,"en":"I heard, he dealt with them soundly."},{"id":"manas-2010:p0804:b001:l002","ordinal":35531,"en":"Alöökö, who held hostages,"},{"id":"manas-2010:p0804:b001:l003","ordinal":35532,"en":"That bulwark of the Chinese,"},{"id":"manas-2010:p0804:b001:l004","ordinal":35533,"en":"His news and tidings have been heard;"},{"id":"manas-2010:p0804:b001:l005","ordinal":35534,"en":"What has become of him..."},{"id":"manas-2010:p0804:b001:l006","ordinal":35535,"en":"My Khan Shooruk, hear my words:"},{"id":"manas-2010:p0804:b001:l007","ordinal":35536,"en":"A deeply dug pit has come;"},{"id":"manas-2010:p0804:b001:l008","ordinal":35537,"en":"Boiling misery has come."},{"id":"manas-2010:p0804:b001:l009","ordinal":35538,"en":"How shall we remain alive?"},{"id":"manas-2010:p0804:b001:l010","ordinal":35539,"en":"A mighty peril has come upon our lives."},{"id":"manas-2010:p0804:b001:l011","ordinal":35540,"en":"If you do not obey, without ado,"},{"id":"manas-2010:p0804:b001:l012","ordinal":35541,"en":"He has butchered whoever faced him."},{"id":"manas-2010:p0804:b001:l013","ordinal":35542,"en":"They seem to be Manas's kin;"},{"id":"manas-2010:p0804:b001:l014","ordinal":35543,"en":"You have raided the Noygut."},{"id":"manas-2010:p0804:b001:l015","ordinal":35544,"en":"You started the strife yourself;"},{"id":"manas-2010:p0804:b001:l016","ordinal":35545,"en":"The quarrels and many disputes,"},{"id":"manas-2010:p0804:b001:l017","ordinal":35546,"en":"You have greatly multiplied them."},{"id":"manas-2010:p0804:b001:l018","ordinal":35547,"en":"You have taken his prosperous people;"},{"id":"manas-2010:p0804:b001:l019","ordinal":35548,"en":"You have become the guilty one."},{"id":"manas-2010:p0804:b001:l020","ordinal":35549,"en":"He is no hero to leave revenge untaken;"},{"id":"manas-2010:p0804:b001:l021","ordinal":35550,"en":"This is no place where we shall escape grief."},{"id":"manas-2010:p0804:b001:l022","ordinal":35551,"en":"He will break your migrating camp at the ford;"},{"id":"manas-2010:p0804:b001:l023","ordinal":35552,"en":"If you contend, he will take revenge upon you."},{"id":"manas-2010:p0804:b001:l024","ordinal":35553,"en":"He will plunder your camels."},{"id":"manas-2010:p0804:b001:l025","ordinal":35554,"en":"If by chance you make a fuss,"},{"id":"manas-2010:p0804:b001:l026","ordinal":35555,"en":"He will punch your brains out and scatter them."},{"id":"manas-2010:p0804:b001:l027","ordinal":35556,"en":"Against the wolf-maned one called a lion,"},{"id":"manas-2010:p0804:b001:l028","ordinal":35557,"en":"Have you strength to fight?"},{"id":"manas-2010:p0804:b001:l029","ordinal":35558,"en":"Understand these words of mine;"},{"id":"manas-2010:p0804:b001:l030","ordinal":35559,"en":"Ah, Khan Shooruk, heed me!’"},{"id":"manas-2010:p0804:b001:l031","ordinal":35560,"en":"Zhöözheldet spoke these words;"},{"id":"manas-2010:p0804:b001:l032","ordinal":35561,"en":"Before he could close his mouth,"},{"id":"manas-2010:p0804:b001:l033","ordinal":35562,"en":"In the opening and closing of an eye,"},{"id":"manas-2010:p0804:b001:l034","ordinal":35563,"en":"Valiant Bakay and Khan Manas,"},{"id":"manas-2010:p0804:b001:l035","ordinal":35564,"en":"His elder Bakay, blessed by Kydyr,"},{"id":"manas-2010:p0804:b001:l036","ordinal":35565,"en":"Had found many a wise plan."},{"id":"manas-2010:p0804:b001:l037","ordinal":35566,"en":"Argyn Khan's Azhybay,"},{"id":"manas-2010:p0804:b001:l038","ordinal":35567,"en":"Who had kept company with a religious teacher,"},{"id":"manas-2010:p0804:b001:l039","ordinal":35568,"en":"Had the piety of a spiritual master too."},{"id":"manas-2010:p0804:b001:l040","ordinal":35569,"en":"Broad-jawed and broad-tongued,"},{"id":"manas-2010:p0804:b001:l041","ordinal":35570,"en":"Speaking without error,"},{"id":"manas-2010:p0804:b001:l042","ordinal":35571,"en":"He had eloquence as well."},{"id":"manas-2010:p0805:b001:l001","ordinal":35572,"en":"He knew seventy kinds of language,"},{"id":"manas-2010:p0805:b001:l002","ordinal":35573,"en":"Encountered through the unseen,"},{"id":"manas-2010:p0805:b001:l003","ordinal":35574,"en":"For the bloodthirsty prince Manas,"},{"id":"manas-2010:p0805:b001:l004","ordinal":35575,"en":"God had driven him there to be found."},{"id":"manas-2010:p0805:b001:l005","ordinal":35576,"en":"A swift orator, a reasoner,"},{"id":"manas-2010:p0805:b001:l006","ordinal":35577,"en":"Who honed his ready tongue,"},{"id":"manas-2010:p0805:b001:l007","ordinal":35578,"en":"Azhybay's custom"},{"id":"manas-2010:p0805:b001:l008","ordinal":35579,"en":"Was to sing out before the khan."},{"id":"manas-2010:p0805:b001:l009","ordinal":35580,"en":"Eloquent Khan Azhybay's"},{"id":"manas-2010:p0805:b001:l010","ordinal":35581,"en":"Words scattered from his mouth."},{"id":"manas-2010:p0805:b001:l011","ordinal":35582,"en":"When he witnessed his eloquence,"},{"id":"manas-2010:p0805:b001:l012","ordinal":35583,"en":"Great Kerke, khan of the Russians,"},{"id":"manas-2010:p0805:b001:l013","ordinal":35584,"en":"Fell silent, his jaw stilled."}]
