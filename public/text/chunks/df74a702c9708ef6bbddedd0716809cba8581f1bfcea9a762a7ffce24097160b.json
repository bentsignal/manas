[{"id":"semetey-1-2013:p1119:b003:l033","ordinal":162561,"en":"Wearing their mail,"},{"id":"semetey-1-2013:p1119:b003:l034","ordinal":162562,"en":"How many heroes came?"},{"id":"semetey-1-2013:p1119:b003:l035","ordinal":162563,"en":"Among them,"},{"id":"semetey-1-2013:p1119:b003:l036","ordinal":162564,"en":"The renowned one was Kongurbay,"},{"id":"semetey-1-2013:p1119:b003:l037","ordinal":162565,"en":"Kongurbay, a khan known to the people."},{"id":"semetey-1-2013:p1119:b003:l038","ordinal":162566,"en":"Upon his coral headdress,"},{"id":"semetey-1-2013:p1119:b003:l039","ordinal":162567,"en":"A parrot's tail"},{"id":"semetey-1-2013:p1119:b004:l001","ordinal":162568,"en":"Was adorned in ninety ways."},{"id":"semetey-1-2013:p1119:b004:l002","ordinal":162569,"en":"He made the racehorse Algara buck,"},{"id":"semetey-1-2013:p1119:b004:l003","ordinal":162570,"en":"Made its golden reins jerk."},{"id":"semetey-1-2013:p1119:b004:l004","ordinal":162571,"en":"Kongurbay, son of Alööke,"},{"id":"semetey-1-2013:p1119:b004:l005","ordinal":162572,"en":"Was a famed man born full of cunning."},{"id":"semetey-1-2013:p1119:b004:l006","ordinal":162573,"en":"A war banner floated in his hand;"},{"id":"semetey-1-2013:p1119:b004:l007","ordinal":162574,"en":"All manner of gear that could cut stone"},{"id":"semetey-1-2013:p1119:b004:l008","ordinal":162575,"en":"Flashed upon his wrist."},{"id":"semetey-1-2013:p1119:b004:l009","ordinal":162576,"en":"Dust rose from his passage,"},{"id":"semetey-1-2013:p1119:b004:l010","ordinal":162577,"en":"And souls fled at his sound."},{"id":"semetey-1-2013:p1119:b004:l011","ordinal":162578,"en":"Have you heard the tale"},{"id":"semetey-1-2013:p1119:b004:l012","ordinal":162579,"en":"Of glory rising from the hearth?"},{"id":"semetey-1-2013:p1119:b004:l013","ordinal":162580,"en":"From the entire Chinese people,"},{"id":"semetey-1-2013:p1119:b004:l014","ordinal":162581,"en":"A mighty one named Kongurbay arose."},{"id":"semetey-1-2013:p1119:b004:l015","ordinal":162582,"en":"His human form was dreadful to behold;"},{"id":"semetey-1-2013:p1119:b004:l016","ordinal":162583,"en":"Among Alööke's Kalcha people,"},{"id":"semetey-1-2013:p1119:b004:l017","ordinal":162584,"en":"No mortal dared face him."},{"id":"semetey-1-2013:p1119:b004:l018","ordinal":162585,"en":"Beneath him was the racehorse Algara,"},{"id":"semetey-1-2013:p1119:b004:l019","ordinal":162586,"en":"A creature surpassing other beasts."},{"id":"semetey-1-2013:p1119:b004:l020","ordinal":162587,"en":"If we aroused his wrath,"},{"id":"semetey-1-2013:p1119:b004:l021","ordinal":162588,"en":"Kongurbay, son of Alööke,"},{"id":"semetey-1-2013:p1119:b004:l022","ordinal":162589,"en":"Had the strength to slaughter alone"},{"id":"semetey-1-2013:p1119:b004:l023","ordinal":162590,"en":"All the Muslims gathered here."},{"id":"semetey-1-2013:p1119:b004:l024","ordinal":162591,"en":"The nobles beside him"},{"id":"semetey-1-2013:p1119:b004:l025","ordinal":162592,"en":"Separated into distinct groups;"},{"id":"semetey-1-2013:p1119:b004:l026","ordinal":162593,"en":"Looking at a single noble,"},{"id":"semetey-1-2013:p1119:b004:l027","ordinal":162594,"en":"He seemed like a thousand men."},{"id":"semetey-1-2013:p1119:b004:l028","ordinal":162595,"en":"The gathered people who saw them"},{"id":"semetey-1-2013:p1119:b004:l029","ordinal":162596,"en":"Felt their spirits badly shaken."},{"id":"semetey-1-2013:p1119:b004:l030","ordinal":162597,"en":"Champions of myriad forms"},{"id":"semetey-1-2013:p1119:b004:l031","ordinal":162598,"en":"Streamed behind him."},{"id":"semetey-1-2013:p1119:b004:l032","ordinal":162599,"en":"Forty princes who served"},{"id":"semetey-1-2013:p1119:b004:l033","ordinal":162600,"en":"As Kongurbay's attendants"},{"id":"semetey-1-2013:p1119:b004:l034","ordinal":162601,"en":"Had come together with him."},{"id":"semetey-1-2013:p1119:b004:l035","ordinal":162602,"en":"Koshoy, Töshtük, and the seasoned giants"},{"id":"semetey-1-2013:p1119:b004:l036","ordinal":162603,"en":"Were left utterly astonished."},{"id":"semetey-1-2013:p1119:b004:l037","ordinal":162604,"en":"Kongurbay, son of Alööke,"},{"id":"semetey-1-2013:p1119:b004:l038","ordinal":162605,"en":"Had immeasurable prowess;"},{"id":"semetey-1-2013:p1119:b004:l039","ordinal":162606,"en":"He was the finest champion of them all."},{"id":"semetey-1-2013:p1120:b003:l001","ordinal":162607,"en":"How many souls bore"},{"id":"semetey-1-2013:p1120:b003:l002","ordinal":162608,"en":"Broad-strung bows and secret arrows?"},{"id":"semetey-1-2013:p1120:b003:l003","ordinal":162609,"en":"If he found fault with the Kyrgyz,"},{"id":"semetey-1-2013:p1120:b003:l004","ordinal":162610,"en":"He would start a quarrel."},{"id":"semetey-1-2013:p1120:b003:l005","ordinal":162611,"en":"Seeing the appearance of these people,"},{"id":"semetey-1-2013:p1120:b003:l006","ordinal":162612,"en":"One would say they had come together to finish them utterly."},{"id":"semetey-1-2013:p1120:b003:l007","ordinal":162613,"en":"Look at Kongurbay, look at the mountain;"},{"id":"semetey-1-2013:p1120:b003:l008","ordinal":162614,"en":"We shuddered at the sight of his vanguard."},{"id":"semetey-1-2013:p1120:b003:l009","ordinal":162615,"en":"Look at the enemy who would fight!"},{"id":"semetey-1-2013:p1120:b003:l010","ordinal":162616,"en":"With Koshoy and Töshtük at their head,"},{"id":"semetey-1-2013:p1120:b003:l011","ordinal":162617,"en":"When they saw Kongurbay,"},{"id":"semetey-1-2013:p1120:b003:l012","ordinal":162618,"en":"They stood as though split in two."},{"id":"semetey-1-2013:p1120:b003:l013","ordinal":162619,"en":"When Kongurbay went to the feast,"},{"id":"semetey-1-2013:p1120:b003:l014","ordinal":162620,"en":"His drums were unlike any others."},{"id":"semetey-1-2013:p1120:b003:l015","ordinal":162621,"en":"Kongurbay, son of Alööke,"},{"id":"semetey-1-2013:p1120:b003:l016","ordinal":162622,"en":"Had horns and trumpets sounded."},{"id":"semetey-1-2013:p1120:b003:l017","ordinal":162623,"en":"If you saw how great his figure was,"},{"id":"semetey-1-2013:p1120:b003:l018","ordinal":162624,"en":"He loaded his baggage upon rhinoceroses;"},{"id":"semetey-1-2013:p1120:b003:l019","ordinal":162625,"en":"The souls who came were of another kind."},{"id":"semetey-1-2013:p1120:b003:l020","ordinal":162626,"en":"His champions were of every sort;"},{"id":"semetey-1-2013:p1120:b003:l021","ordinal":162627,"en":"If Kongurbay gave the order"},{"id":"semetey-1-2013:p1120:b003:l022","ordinal":162628,"en":"And his champion unexpectedly attacked,"},{"id":"semetey-1-2013:p1120:b003:l023","ordinal":162629,"en":"A man's shoulder blade would come out."},{"id":"semetey-1-2013:p1120:b003:l024","ordinal":162630,"en":"The Chinese called this dyngshoo;"},{"id":"semetey-1-2013:p1120:b003:l025","ordinal":162631,"en":"Kongurbay was such a hero"},{"id":"semetey-1-2013:p1120:b003:l026","ordinal":162632,"en":"That he made his warriors act as one."},{"id":"semetey-1-2013:p1120:b003:l027","ordinal":162633,"en":"Kongurbay, son of Alööke,"},{"id":"semetey-1-2013:p1120:b003:l028","ordinal":162634,"en":"Had reached the time"},{"id":"semetey-1-2013:p1120:b003:l029","ordinal":162635,"en":"When his rib bones bulged,"},{"id":"semetey-1-2013:p1120:b003:l030","ordinal":162636,"en":"His right shoulder rose high,"},{"id":"semetey-1-2013:p1120:b003:l031","ordinal":162637,"en":"And the earth bent when he walked."},{"id":"semetey-1-2013:p1120:b003:l032","ordinal":162638,"en":"He had reached such a time."},{"id":"semetey-1-2013:p1120:b003:l033","ordinal":162639,"en":"His courage was full, his heart stone;"},{"id":"semetey-1-2013:p1120:b003:l034","ordinal":162640,"en":"Do not ask of Kongurbay's station."},{"id":"semetey-1-2013:p1120:b003:l035","ordinal":162641,"en":"If his wrath fell upon the Kyrgyz,"},{"id":"semetey-1-2013:p1120:b003:l036","ordinal":162642,"en":"He would bring great turmoil on this road."},{"id":"semetey-1-2013:p1120:b003:l037","ordinal":162643,"en":"Vowing to gird his waist firmly,"},{"id":"semetey-1-2013:p1120:b003:l038","ordinal":162644,"en":"He had come prepared from Beijing;"},{"id":"semetey-1-2013:p1120:b003:l039","ordinal":162645,"en":"If he met renowned Manas,"},{"id":"semetey-1-2013:p1120:b004:l001","ordinal":162646,"en":"He would pursue Alööke's blood-price."},{"id":"semetey-1-2013:p1120:b004:l002","ordinal":162647,"en":"He donned an arrow-proof coat,"},{"id":"semetey-1-2013:p1120:b004:l003","ordinal":162648,"en":"Thinking his plans and words,"},{"id":"semetey-1-2013:p1120:b004:l004","ordinal":162649,"en":"Thinking the bloodthirsty Manas, that Burut,"},{"id":"semetey-1-2013:p1120:b004:l005","ordinal":162650,"en":"Would come to the feast."},{"id":"semetey-1-2013:p1120:b004:l006","ordinal":162651,"en":"Thus Kongurbay had come,"},{"id":"semetey-1-2013:p1120:b004:l007","ordinal":162652,"en":"Planning to overrun the feast,"},{"id":"semetey-1-2013:p1120:b004:l008","ordinal":162653,"en":"To fight amid the feast"},{"id":"semetey-1-2013:p1120:b004:l009","ordinal":162654,"en":"And spill human blood."},{"id":"semetey-1-2013:p1120:b004:l010","ordinal":162655,"en":"Kongurbay was bloodthirsty;"},{"id":"semetey-1-2013:p1120:b004:l011","ordinal":162656,"en":"He would be filled"},{"id":"semetey-1-2013:p1120:b004:l012","ordinal":162657,"en":"By eating a whole pig at once,"},{"id":"semetey-1-2013:p1120:b004:l013","ordinal":162658,"en":"And, receiving an order from his khan,"},{"id":"semetey-1-2013:p1120:b004:l014","ordinal":162659,"en":"Would slaughter whoever attacked."},{"id":"semetey-1-2013:p1120:b004:l015","ordinal":162660,"en":"In prowess he had brought"},{"id":"semetey-1-2013:p1120:b004:l016","ordinal":162661,"en":"Horse acrobats and runners on foot,"},{"id":"semetey-1-2013:p1120:b004:l017","ordinal":162662,"en":"And marksmen who never missed"},{"id":"semetey-1-2013:p1120:b004:l018","ordinal":162663,"en":"In the darkness of the moon."},{"id":"semetey-1-2013:p1120:b004:l019","ordinal":162664,"en":"From marksmen such as these,"},{"id":"semetey-1-2013:p1120:b004:l020","ordinal":162665,"en":"He chose one from every thousand;"},{"id":"semetey-1-2013:p1120:b004:l021","ordinal":162666,"en":"Of champions such as these,"},{"id":"semetey-1-2013:p1120:b004:l022","ordinal":162667,"en":"He brought exactly twelve thousand."},{"id":"semetey-1-2013:p1120:b004:l023","ordinal":162668,"en":"Beyond them"},{"id":"semetey-1-2013:p1120:b004:l024","ordinal":162669,"en":"Were the Kanjarkol champions;"},{"id":"semetey-1-2013:p1120:b004:l025","ordinal":162670,"en":"The shoulder blades of attacking enemies"},{"id":"semetey-1-2013:p1120:b004:l026","ordinal":162671,"en":"Would unfailingly come out."},{"id":"semetey-1-2013:p1120:b004:l027","ordinal":162672,"en":"Your gray wolf, Khan Kongurbay,"},{"id":"semetey-1-2013:p1120:b004:l028","ordinal":162673,"en":"Said, \"What will the Burut do?\""},{"id":"semetey-1-2013:p1120:b004:l029","ordinal":162674,"en":"Of the Kanjarkol champions,"},{"id":"semetey-1-2013:p1120:b004:l030","ordinal":162675,"en":"He brought exactly ten thousand,"},{"id":"semetey-1-2013:p1120:b004:l031","ordinal":162676,"en":"Who descended fully prepared."},{"id":"semetey-1-2013:p1120:b004:l032","ordinal":162677,"en":"Beyond them came"},{"id":"semetey-1-2013:p1120:b004:l033","ordinal":162678,"en":"The most skillful bowmen,"},{"id":"semetey-1-2013:p1120:b004:l034","ordinal":162679,"en":"The most skillful lasso throwers,"},{"id":"semetey-1-2013:p1120:b004:l035","ordinal":162680,"en":"Who caught men and spared no soul;"},{"id":"semetey-1-2013:p1120:b004:l036","ordinal":162681,"en":"Mingled behind them came"},{"id":"semetey-1-2013:p1120:b004:l037","ordinal":162682,"en":"The finest wielders of battle-axes."},{"id":"semetey-1-2013:p1120:b004:l038","ordinal":162683,"en":"To Kökötöy's feast"},{"id":"semetey-1-2013:p1120:b004:l039","ordinal":162684,"en":"Came the Chinese people with their army."},{"id":"semetey-1-2013:p1121:b003:l001","ordinal":162685,"en":"Saying it was Kökötöy's feast,"},{"id":"semetey-1-2013:p1121:b003:l002","ordinal":162686,"en":"The place of the great gathering,"},{"id":"semetey-1-2013:p1121:b003:l003","ordinal":162687,"en":"The mighty Khan Kongurbay came;"},{"id":"semetey-1-2013:p1121:b003:l004","ordinal":162688,"en":"When his wrath seized him,"},{"id":"semetey-1-2013:p1121:b003:l005","ordinal":162689,"en":"He became a deep-dug pit."},{"id":"semetey-1-2013:p1121:b003:l006","ordinal":162690,"en":"Before Khan Kongurbay,"},{"id":"semetey-1-2013:p1121:b003:l007","ordinal":162691,"en":"Kökötöy's Bokmurun"},{"id":"semetey-1-2013:p1121:b003:l008","ordinal":162692,"en":"Sixty camel-loads of gold"},{"id":"semetey-1-2013:p1121:b003:l009","ordinal":162693,"en":"He now presented."},{"id":"semetey-1-2013:p1121:b003:l010","ordinal":162694,"en":"Giving many gifts of gold,"},{"id":"semetey-1-2013:p1121:b003:l011","ordinal":162695,"en":"Kökötöy's Bokmurun"},{"id":"semetey-1-2013:p1121:b003:l012","ordinal":162696,"en":"Barely pacified the Kalcha."},{"id":"semetey-1-2013:p1121:b003:l013","ordinal":162697,"en":"Eight thousand wethers and five thousand mares"},{"id":"semetey-1-2013:p1121:b003:l014","ordinal":162698,"en":"He gave for slaughter;"},{"id":"semetey-1-2013:p1121:b003:l015","ordinal":162699,"en":"The wood of eight thousand camels"},{"id":"semetey-1-2013:p1121:b003:l016","ordinal":162700,"en":"He gave for burning;"},{"id":"semetey-1-2013:p1121:b003:l017","ordinal":162701,"en":"Sugar large as a kneeling camel or cow"},{"id":"semetey-1-2013:p1121:b003:l018","ordinal":162702,"en":"He gave them to crack apart."},{"id":"semetey-1-2013:p1121:b003:l019","ordinal":162703,"en":"Thus he won the favor"},{"id":"semetey-1-2013:p1121:b003:l020","ordinal":162704,"en":"Of gray-wolf Khan Kongurbay,"},{"id":"semetey-1-2013:p1121:b003:l021","ordinal":162705,"en":"Gathered the whole army,"},{"id":"semetey-1-2013:p1121:b003:l022","ordinal":162706,"en":"And camped against the foothills."},{"id":"semetey-1-2013:p1121:b003:l023","ordinal":162707,"en":"There was yet another spectacle;"},{"id":"semetey-1-2013:p1121:b003:l024","ordinal":162708,"en":"Let us leave this here"},{"id":"semetey-1-2013:p1121:b003:l025","ordinal":162709,"en":"And begin with what came nearer."},{"id":"semetey-1-2013:p1121:b003:l026","ordinal":162710,"en":"Behind him,"},{"id":"semetey-1-2013:p1121:b003:l027","ordinal":162711,"en":"Dust wheeled into the sky;"},{"id":"semetey-1-2013:p1121:b003:l028","ordinal":162712,"en":"The heavens were clear but the earth was veiled,"},{"id":"semetey-1-2013:p1121:b003:l029","ordinal":162713,"en":"And haze parted from the sky."},{"id":"semetey-1-2013:p1121:b003:l030","ordinal":162714,"en":"Their multitude seemed like a flood."},{"id":"semetey-1-2013:p1121:b003:l031","ordinal":162715,"en":"With piercing cries and shrill cheering,"},{"id":"semetey-1-2013:p1121:b003:l032","ordinal":162716,"en":"When one looked carefully,"},{"id":"semetey-1-2013:p1121:b003:l033","ordinal":162717,"en":"Ezkara's army appeared."},{"id":"semetey-1-2013:p1121:b003:l034","ordinal":162718,"en":"Ezkara, khan of the Manchus—"},{"id":"semetey-1-2013:p1121:b003:l035","ordinal":162719,"en":"His multitude was like black worms;"},{"id":"semetey-1-2013:p1121:b003:l036","ordinal":162720,"en":"If he attacked, he brought much grief,"},{"id":"semetey-1-2013:p1121:b003:l037","ordinal":162721,"en":"For he himself was ill-starred, a calamity."},{"id":"semetey-1-2013:p1121:b003:l038","ordinal":162722,"en":"At that time, every mortal"},{"id":"semetey-1-2013:p1121:b003:l039","ordinal":162723,"en":"Who saw Ezkara was afraid."},{"id":"semetey-1-2013:p1121:b005:l001","ordinal":162724,"en":"Ill-fated Ezkara"},{"id":"semetey-1-2013:p1121:b005:l002","ordinal":162725,"en":"Had studied the wondrous arts."},{"id":"semetey-1-2013:p1121:b005:l003","ordinal":162726,"en":"His knowledge was considerable;"},{"id":"semetey-1-2013:p1121:b005:l004","ordinal":162727,"en":"His sorcery was of many kinds,"},{"id":"semetey-1-2013:p1121:b005:l005","ordinal":162728,"en":"A famed man who came from Beijing."},{"id":"semetey-1-2013:p1121:b005:l006","ordinal":162729,"en":"A peerless diviner and knowing servant,"},{"id":"semetey-1-2013:p1121:b005:l007","ordinal":162730,"en":"He knew Bakburchun beyond,"},{"id":"semetey-1-2013:p1121:b005:l008","ordinal":162731,"en":"Ulandy, Kengtung, and Düngshang."},{"id":"semetey-1-2013:p1121:b005:l009","ordinal":162732,"en":"Ezkara, having seen so much,"},{"id":"semetey-1-2013:p1121:b005:l010","ordinal":162733,"en":"Knew that people's number,"},{"id":"semetey-1-2013:p1121:b005:l011","ordinal":162734,"en":"And knew this people's temper."},{"id":"semetey-1-2013:p1121:b005:l012","ordinal":162735,"en":"He knew the might of that people;"},{"id":"semetey-1-2013:p1121:b005:l013","ordinal":162736,"en":"Of this people visibly gathered"},{"id":"semetey-1-2013:p1121:b005:l014","ordinal":162737,"en":"For Kökötöy's feast,"},{"id":"semetey-1-2013:p1121:b005:l015","ordinal":162738,"en":"He knew the small number."},{"id":"semetey-1-2013:p1121:b005:l016","ordinal":162739,"en":"Ezkara of the Manchus"},{"id":"semetey-1-2013:p1121:b005:l017","ordinal":162740,"en":"Was more skillful than any intriguer,"},{"id":"semetey-1-2013:p1121:b005:l018","ordinal":162741,"en":"The finest deviser of means"},{"id":"semetey-1-2013:p1121:b005:l019","ordinal":162742,"en":"Among black Chinese and Manchus."},{"id":"semetey-1-2013:p1121:b005:l020","ordinal":162743,"en":"He was the orator among the eloquent;"},{"id":"semetey-1-2013:p1121:b005:l021","ordinal":162744,"en":"Ezkara, whose desire was fixed,"},{"id":"semetey-1-2013:p1121:b005:l022","ordinal":162745,"en":"Was the champion of the many Chinese."},{"id":"semetey-1-2013:p1121:b005:l023","ordinal":162746,"en":"Straining and exerting himself,"},{"id":"semetey-1-2013:p1121:b005:l024","ordinal":162747,"en":"The renowned hero Ezkara"},{"id":"semetey-1-2013:p1121:b005:l025","ordinal":162748,"en":"Came straight toward this feast,"},{"id":"semetey-1-2013:p1121:b005:l026","ordinal":162749,"en":"Swaying as though shoved this way."},{"id":"semetey-1-2013:p1121:b005:l027","ordinal":162750,"en":"He had many contentious words:"},{"id":"semetey-1-2013:p1121:b005:l028","ordinal":162751,"en":"At the far edge of Altay,"},{"id":"semetey-1-2013:p1121:b005:l029","ordinal":162752,"en":"He had lost plunder worth a thousand camels,"},{"id":"semetey-1-2013:p1121:b005:l030","ordinal":162753,"en":"And had a thousand champions"},{"id":"semetey-1-2013:p1121:b005:l031","ordinal":162754,"en":"Slaughtered by Manas."},{"id":"semetey-1-2013:p1121:b005:l032","ordinal":162755,"en":"The pale blue star in the sky was eclipsed;"},{"id":"semetey-1-2013:p1121:b005:l033","ordinal":162756,"en":"He openly fled and escaped"},{"id":"semetey-1-2013:p1121:b005:l034","ordinal":162757,"en":"Before Esenkan."},{"id":"semetey-1-2013:p1121:b005:l035","ordinal":162758,"en":"When he came to Esenkan,"},{"id":"semetey-1-2013:p1121:b005:l036","ordinal":162759,"en":"He stamped the ground he trod"},{"id":"semetey-1-2013:p1121:b005:l037","ordinal":162760,"en":"And reviled Khan Manas:"},{"id":"semetey-1-2013:p1121:b005:l038","ordinal":162761,"en":"\"From the forty-household Kyrgyz in Altay,"},{"id":"semetey-1-2013:p1122:b003:l001","ordinal":162762,"en":"They say bloodthirsty Manas arose."},{"id":"semetey-1-2013:p1122:b003:l002","ordinal":162763,"en":"He crushed a thousand champions,"},{"id":"semetey-1-2013:p1122:b003:l003","ordinal":162764,"en":"Killed them and thrust them into the earth."},{"id":"semetey-1-2013:p1122:b003:l004","ordinal":162765,"en":"If you do not cut down his crookedness now,"},{"id":"semetey-1-2013:p1122:b003:l005","ordinal":162766,"en":"Destroy his forty households,"},{"id":"semetey-1-2013:p1122:b003:l006","ordinal":162767,"en":"And seize and restrain Manas,"},{"id":"semetey-1-2013:p1122:b003:l007","ordinal":162768,"en":"He has unleashed havoc"},{"id":"semetey-1-2013:p1122:b003:l008","ordinal":162769,"en":"And taken plunder worth my thousand camels!"},{"id":"semetey-1-2013:p1122:b003:l009","ordinal":162770,"en":"If you do not finish Manas,"},{"id":"semetey-1-2013:p1122:b003:l010","ordinal":162771,"en":"He has inflicted harsh suffering,\" he said."},{"id":"semetey-1-2013:p1122:b003:l011","ordinal":162772,"en":"Before Esenkan,"},{"id":"semetey-1-2013:p1122:b003:l012","ordinal":162773,"en":"He went straight in and spoke these words."},{"id":"semetey-1-2013:p1122:b003:l013","ordinal":162774,"en":"Esenkan grew angry:"},{"id":"semetey-1-2013:p1122:b003:l014","ordinal":162775,"en":"\"If you cannot overcome Manas,"},{"id":"semetey-1-2013:p1122:b003:l015","ordinal":162776,"en":"All of you perish together!\" he said."},{"id":"semetey-1-2013:p1122:b003:l016","ordinal":162777,"en":"In wrath, Esenkan"},{"id":"semetey-1-2013:p1122:b003:l017","ordinal":162778,"en":"Drove him away."},{"id":"semetey-1-2013:p1122:b004:l001","ordinal":162779,"en":"Shamed, Ezkara"},{"id":"semetey-1-2013:p1122:b004:l002","ordinal":162780,"en":"Said, \"Damn you, Burut,\""},{"id":"semetey-1-2013:p1122:b004:l003","ordinal":162781,"en":"And the ill-starred wretch held a grudge"},{"id":"semetey-1-2013:p1122:b004:l004","ordinal":162782,"en":"Against hero Manas."},{"id":"semetey-1-2013:p1122:b004:l005","ordinal":162783,"en":"He came to Kökötöy's feast"},{"id":"semetey-1-2013:p1122:b004:l006","ordinal":162784,"en":"To stir up conflict,"},{"id":"semetey-1-2013:p1122:b004:l007","ordinal":162785,"en":"Hoping to utterly strike down"},{"id":"semetey-1-2013:p1122:b004:l008","ordinal":162786,"en":"The handful of Kyrgyz;"},{"id":"semetey-1-2013:p1122:b004:l009","ordinal":162787,"en":"Thus Ezkara came speaking,"},{"id":"semetey-1-2013:p1122:b004:l010","ordinal":162788,"en":"For the Chinese bore a grudge."},{"id":"semetey-1-2013:p1122:b004:l011","ordinal":162789,"en":"With Khan Kongurbay at their head,"},{"id":"semetey-1-2013:p1122:b004:l012","ordinal":162790,"en":"They were poised to swarm upon"},{"id":"semetey-1-2013:p1122:b004:l013","ordinal":162791,"en":"The handful of Muslims."},{"id":"semetey-1-2013:p1122:b004:l014","ordinal":162792,"en":"Kökötöy's many wethers"},{"id":"semetey-1-2013:p1122:b004:l015","ordinal":162793,"en":"And countless horses spread like a lake—"},{"id":"semetey-1-2013:p1122:b004:l016","ordinal":162794,"en":"Bokmurun drove them all together"},{"id":"semetey-1-2013:p1122:b004:l017","ordinal":162795,"en":"And gave them for slaughter."},{"id":"semetey-1-2013:p1122:b006:l001","ordinal":162796,"en":"Shouting angrily,"},{"id":"semetey-1-2013:p1122:b006:l002","ordinal":162797,"en":"He summoned Bokmurun;"},{"id":"semetey-1-2013:p1122:b006:l003","ordinal":162798,"en":"These were Ezkara's words."},{"id":"semetey-1-2013:p1122:b006:l004","ordinal":162799,"en":"When Bokmurun came and bowed,"},{"id":"semetey-1-2013:p1122:b006:l005","ordinal":162800,"en":"He spoke as follows:"},{"id":"semetey-1-2013:p1122:b006:l006","ordinal":162801,"en":"\"I shall eat my fill at your feast, Burut;"},{"id":"semetey-1-2013:p1122:b006:l007","ordinal":162802,"en":"Bringing torment upon your feast,"},{"id":"semetey-1-2013:p1122:b006:l008","ordinal":162803,"en":"I shall raid your village, Burut!"},{"id":"semetey-1-2013:p1122:b006:l009","ordinal":162804,"en":"I shall bring hell upon your feast, Burut;"},{"id":"semetey-1-2013:p1122:b006:l010","ordinal":162805,"en":"I shall strike down your company, Burut!"},{"id":"semetey-1-2013:p1122:b006:l011","ordinal":162806,"en":"You have migrated from broad Tashken, Burut;"},{"id":"semetey-1-2013:p1122:b006:l012","ordinal":162807,"en":"Your braid woven in six strands, Burut—"},{"id":"semetey-1-2013:p1122:b006:l013","ordinal":162808,"en":"Saying, 'Whoever would not come to the feast,"},{"id":"semetey-1-2013:p1122:b006:l014","ordinal":162809,"en":"I shall go and strike him down,'"},{"id":"semetey-1-2013:p1122:b006:l015","ordinal":162810,"en":"You brandished your strength, Burut."},{"id":"semetey-1-2013:p1122:b006:l016","ordinal":162811,"en":"When I surge, I shall crush your strength, Burut;"},{"id":"semetey-1-2013:p1122:b006:l017","ordinal":162812,"en":"I shall darken your very roots, Burut."},{"id":"semetey-1-2013:p1122:b007:l001","ordinal":162813,"en":"I have come with a vast army to strike"},{"id":"semetey-1-2013:p1122:b007:l002","ordinal":162814,"en":"Your far-flung fury, Burut."},{"id":"semetey-1-2013:p1122:b007:l003","ordinal":162815,"en":"I shall rain upon your head"},{"id":"semetey-1-2013:p1122:b007:l004","ordinal":162816,"en":"My winter in the summertime, Burut."}]
