[{"id":"manas-2010:p0438:b001:l032","ordinal":20225,"en":"Your accomplished one reached them and thrust his spear,"},{"id":"manas-2010:p0438:b001:l033","ordinal":20226,"en":"Using abundant, surpassing skill."},{"id":"manas-2010:p0438:b001:l034","ordinal":20227,"en":"The champions his spear reached"},{"id":"manas-2010:p0438:b001:l035","ordinal":20228,"en":"Fell from their horses, sprawling."},{"id":"manas-2010:p0438:b001:l036","ordinal":20229,"en":"Their champions like camels and rocks"},{"id":"manas-2010:p0438:b001:l037","ordinal":20230,"en":"Were slaughtered, stretched out flat."},{"id":"manas-2010:p0438:b001:l038","ordinal":20231,"en":"Those who saw had no regret."},{"id":"manas-2010:p0438:b001:l039","ordinal":20232,"en":"Because of Kutubiy,"},{"id":"manas-2010:p0438:b001:l040","ordinal":20233,"en":"Facing the Chinese,"},{"id":"manas-2010:p0438:b001:l041","ordinal":20234,"en":"Illustrious Manas's"},{"id":"manas-2010:p0438:b001:l042","ordinal":20235,"en":"Strife was wrought upon the Kalmyks."},{"id":"manas-2010:p0438:b001:l043","ordinal":20236,"en":"Whirling his spear without stopping,"},{"id":"manas-2010:p0438:b001:l044","ordinal":20237,"en":"The mass of Black Manchus,"},{"id":"manas-2010:p0438:b001:l045","ordinal":20238,"en":"He broke apart their ranks."},{"id":"manas-2010:p0438:b001:l046","ordinal":20239,"en":"Those who came close to grapple,"},{"id":"manas-2010:p0438:b001:l047","ordinal":20240,"en":"He beat with his battle-axe."},{"id":"manas-2010:p0438:b001:l048","ordinal":20241,"en":"The champions skilled at riding,"},{"id":"manas-2010:p0439:b001:l001","ordinal":20242,"en":"Unable to find their wits,"},{"id":"manas-2010:p0439:b001:l002","ordinal":20243,"en":"Fled, jolting along."},{"id":"manas-2010:p0439:b001:l003","ordinal":20244,"en":"Shattering seven hundred,"},{"id":"manas-2010:p0439:b001:l004","ordinal":20245,"en":"The champions farther away,"},{"id":"manas-2010:p0439:b001:l005","ordinal":20246,"en":"He chased from behind with his spear."},{"id":"manas-2010:p0439:b001:l006","ordinal":20247,"en":"Galloping on the courser Toruchaar,"},{"id":"manas-2010:p0439:b001:l007","ordinal":20248,"en":"All their giants and monsters,"},{"id":"manas-2010:p0439:b001:l008","ordinal":20249,"en":"Your magnanimous one entered, bringing them down."},{"id":"manas-2010:p0439:b001:l009","ordinal":20250,"en":"The spur of broad Altai—"},{"id":"manas-2010:p0439:b001:l010","ordinal":20251,"en":"They fled to the spur and sought shelter."},{"id":"manas-2010:p0439:b001:l011","ordinal":20252,"en":"Those who escaped alive, not dead,"},{"id":"manas-2010:p0439:b001:l012","ordinal":20253,"en":"Were drenched in crimson blood."},{"id":"manas-2010:p0439:b001:l013","ordinal":20254,"en":"Blue haze, burning dust,"},{"id":"manas-2010:p0439:b001:l014","ordinal":20255,"en":"Their threadlike mustaches brushed smooth,"},{"id":"manas-2010:p0439:b001:l015","ordinal":20256,"en":"Many Chinese souls were slain."},{"id":"manas-2010:p0439:b001:l016","ordinal":20257,"en":"Fit to be felt throughout the world,"},{"id":"manas-2010:p0439:b001:l017","ordinal":20258,"en":"Your magnanimous one wrought strife."},{"id":"manas-2010:p0439:b001:l018","ordinal":20259,"en":"Fortunate Kutubiy,"},{"id":"manas-2010:p0439:b001:l019","ordinal":20260,"en":"Your valiant, hapless Manas"},{"id":"manas-2010:p0439:b001:l020","ordinal":20261,"en":"Rescued him."},{"id":"manas-2010:p0439:b001:l021","ordinal":20262,"en":"The unbelievers like dark willows,"},{"id":"manas-2010:p0439:b001:l022","ordinal":20263,"en":"He speared again and pursued,"},{"id":"manas-2010:p0439:b001:l023","ordinal":20264,"en":"Driving them toward the emperor."},{"id":"manas-2010:p0439:b001:l024","ordinal":20265,"en":"Through their middle, the wolf-warrior"},{"id":"manas-2010:p0439:b001:l025","ordinal":20266,"en":"Bored his way."},{"id":"manas-2010:p0439:b001:l026","ordinal":20267,"en":"Around them, Kutubiy"},{"id":"manas-2010:p0439:b001:l027","ordinal":20268,"en":"Cut his way through in slaughter."},{"id":"manas-2010:p0439:b001:l028","ordinal":20269,"en":"On the governors' side, Khan Manas"},{"id":"manas-2010:p0439:b001:l029","ordinal":20270,"en":"Closed them in."},{"id":"manas-2010:p0439:b001:l030","ordinal":20271,"en":"Right through their middle, Kutubiy"},{"id":"manas-2010:p0439:b001:l031","ordinal":20272,"en":"Beat his way."},{"id":"manas-2010:p0439:b001:l032","ordinal":20273,"en":"Through their middle, Kutubiy"},{"id":"manas-2010:p0439:b001:l033","ordinal":20274,"en":"Came reaping his path."},{"id":"manas-2010:p0439:b001:l034","ordinal":20275,"en":"From behind, the Kalmyks,"},{"id":"manas-2010:p0439:b001:l035","ordinal":20276,"en":"Lion Manas, the leopard,"},{"id":"manas-2010:p0439:b001:l036","ordinal":20277,"en":"Leaving not one alive,"},{"id":"manas-2010:p0439:b001:l037","ordinal":20278,"en":"Came sucking their lives away."},{"id":"manas-2010:p0439:b001:l038","ordinal":20279,"en":"Their governors floundered;"},{"id":"manas-2010:p0439:b001:l039","ordinal":20280,"en":"They had taken to flight."},{"id":"manas-2010:p0439:b001:l040","ordinal":20281,"en":"Not letting the fleeing enemy escape,"},{"id":"manas-2010:p0439:b001:l041","ordinal":20282,"en":"Lion Manas and Kutubiy"},{"id":"manas-2010:p0439:b001:l042","ordinal":20283,"en":"Had overtaken them."},{"id":"manas-2010:p0439:b001:l043","ordinal":20284,"en":"Whatever they chose, to the utmost,"},{"id":"manas-2010:p0439:b001:l044","ordinal":20285,"en":"They had done."},{"id":"manas-2010:p0439:b001:l045","ordinal":20286,"en":"The swarming Chinese,"},{"id":"manas-2010:p0439:b001:l046","ordinal":20287,"en":"Valiant Manas then"},{"id":"manas-2010:p0439:b001:l047","ordinal":20288,"en":"Had slaughtered them."},{"id":"manas-2010:p0439:b001:l048","ordinal":20289,"en":"His tusks jutting out,"}]
