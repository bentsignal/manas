[{"id":"sayakbay-ms-current144:pdf164:l015","ordinal":395009,"en":"they called it the blue water of Adyr."},{"id":"sayakbay-ms-current144:pdf164:l016","ordinal":395010,"en":"Its pouring flood was like three dunes."},{"id":"sayakbay-ms-current144:pdf164:l017","ordinal":395011,"en":"Each day they bent under the strain."},{"id":"sayakbay-ms-current144:pdf164:l018","ordinal":395012,"en":"Yesterday his eyes glared as he shouted."},{"id":"sayakbay-ms-current144:pdf164:l019","ordinal":395013,"en":"When he struck and split the earth,"},{"id":"sayakbay-ms-current144:pdf164:l020","ordinal":395014,"en":"he became like a star from the sky."},{"id":"sayakbay-ms-current144:pdf164:l021","ordinal":395015,"en":"He fell, cleaving into the ground."},{"id":"sayakbay-ms-current144:pdf164:l022","ordinal":395016,"en":"At dawn, the two young men’s"},{"id":"sayakbay-ms-current144:pdf164:l023","ordinal":395017,"en":"dripping foam scattered about."},{"id":"sayakbay-ms-current144:pdf164:l024","ordinal":395018,"en":"Water thundered through the valley."},{"id":"sayakbay-ms-current144:pdf164:l025","ordinal":395019,"en":"The grasses he knew swayed softly."},{"id":"sayakbay-ms-current144:pdf164:l026","ordinal":395020,"en":"Across the hollow of countless graves,"},{"id":"sayakbay-ms-current144:pdf164:l027","ordinal":395021,"en":"their tops trembled whenever the wind blew."},{"id":"sayakbay-ms-current144:pdf165:l001","ordinal":395022,"en":"From a peak beyond the eye’s reach,"},{"id":"sayakbay-ms-current144:pdf165:l002","ordinal":395023,"en":"the mountain seemed ready to scatter like dust."},{"id":"sayakbay-ms-current144:pdf165:l003","ordinal":395024,"en":"The mountain summit came into view."},{"id":"sayakbay-ms-current144:pdf165:l004","ordinal":395025,"en":"Its flames divided into a thousand branches."},{"id":"sayakbay-ms-current144:pdf165:l005","ordinal":395026,"en":"Alas, it was broken into hollows and rises."},{"id":"sayakbay-ms-current144:pdf165:l006","ordinal":395027,"en":"From a tower beyond the eye’s reach,"},{"id":"sayakbay-ms-current144:pdf165:l007","ordinal":395028,"en":"the mountain summit could be seen."},{"id":"sayakbay-ms-current144:pdf165:l008","ordinal":395029,"en":"They were already tearing it down."},{"id":"sayakbay-ms-current144:pdf165:l009","ordinal":395030,"en":"Far away, where the beast stood,"},{"id":"sayakbay-ms-current144:pdf165:l010","ordinal":395031,"en":"they had fastened it with a rope."},{"id":"sayakbay-ms-current144:pdf165:l011","ordinal":395032,"en":"When the day began to demand its due,"},{"id":"sayakbay-ms-current144:pdf165:l012","ordinal":395033,"en":"into the valley of the blue dome,"},{"id":"sayakbay-ms-current144:pdf165:l013","ordinal":395034,"en":"toward a warrior beyond the eye’s reach,"},{"id":"sayakbay-ms-current144:pdf165:l014","ordinal":395035,"en":"hero Seitek descended to the ground."},{"id":"sayakbay-ms-current144:pdf165:l015","ordinal":395036,"en":"There were many mottled peaks."},{"id":"sayakbay-ms-current144:pdf165:l016","ordinal":395037,"en":"Now the land was a place of pouring torrents."},{"id":"sayakbay-ms-current144:pdf165:l017","ordinal":395038,"en":"The spring flowed and overflowed."},{"id":"sayakbay-ms-current144:pdf165:l018","ordinal":395039,"en":"The nightingale sang out melodiously."},{"id":"sayakbay-ms-current144:pdf165:l019","ordinal":395040,"en":"No person turned away from its fragrance."},{"id":"sayakbay-ms-current144:pdf165:l020","ordinal":395041,"en":"The black-eared beasts fled."},{"id":"sayakbay-ms-current144:pdf165:l021","ordinal":395042,"en":"No eagle had ever perched there."},{"id":"sayakbay-ms-current144:pdf165:l022","ordinal":395043,"en":"Many souls cried out in commotion."},{"id":"sayakbay-ms-current144:pdf165:l023","ordinal":395044,"en":"From the three-eared headland,"},{"id":"sayakbay-ms-current144:pdf165:l024","ordinal":395045,"en":"within it rose three islands."},{"id":"sayakbay-ms-current144:pdf165:l026","ordinal":395046,"en":"he had gone away for no cause."},{"id":"sayakbay-ms-current144:pdf165:l027","ordinal":395047,"en":"Had the sun already gone down?"},{"id":"sayakbay-ms-current144:pdf166:l001","ordinal":395048,"en":"[The great mountain clattered],"},{"id":"sayakbay-ms-current144:pdf166:l002","ordinal":395049,"en":"[Its peak was worn away],"},{"id":"sayakbay-ms-current144:pdf166:l003","ordinal":395050,"en":"Cliffs split and water fell,"},{"id":"sayakbay-ms-current144:pdf166:l005","ordinal":395051,"en":"The surroundings were hazy,"},{"id":"sayakbay-ms-current144:pdf166:l006","ordinal":395052,"en":"[Seitek saw it while rushing],"},{"id":"sayakbay-ms-current144:pdf166:l008","ordinal":395053,"en":"[Their bullets whistled],"},{"id":"sayakbay-ms-current144:pdf166:l009","ordinal":395054,"en":"The war drums thundered,"},{"id":"sayakbay-ms-current144:pdf166:l010","ordinal":395055,"en":"He raised the battle cry with a roar."},{"id":"sayakbay-ms-current144:pdf166:l012","ordinal":395056,"en":"That an enemy had advanced,"},{"id":"sayakbay-ms-current144:pdf166:l013","ordinal":395057,"en":"[Now leaning back, he called his battle cry]."},{"id":"sayakbay-ms-current144:pdf166:l014","ordinal":395058,"en":"His ninety giants had overwhelmed him,"},{"id":"sayakbay-ms-current144:pdf166:l015","ordinal":395059,"en":"Without rope, without cord,"},{"id":"sayakbay-ms-current144:pdf166:l016","ordinal":395060,"en":"[All swarmed, leaving no enemy apart],"},{"id":"sayakbay-ms-current144:pdf166:l021","ordinal":395061,"en":"[They plunged him into visible misery],"},{"id":"sayakbay-ms-current144:pdf166:l030","ordinal":395062,"en":"Your dear elder was undone."},{"id":"sayakbay-ms-current144:pdf167:l002","ordinal":395063,"en":"Your poor elder was like a slender shrub."},{"id":"sayakbay-ms-current144:pdf167:l003","ordinal":395064,"en":"[He had stature but no strength],"},{"id":"sayakbay-ms-current144:pdf167:l004","ordinal":395065,"en":"Such is this filthy world."},{"id":"sayakbay-ms-current144:pdf167:l006","ordinal":395066,"en":"Your elder had encountered it."},{"id":"sayakbay-ms-current144:pdf167:l009","ordinal":395067,"en":"To the wrath of the wrathful,"},{"id":"sayakbay-ms-current144:pdf167:l010","ordinal":395068,"en":"The poor warrior had succumbed."},{"id":"sayakbay-ms-current144:pdf167:l012","ordinal":395069,"en":"[Perhaps he fell without trusting fate],"},{"id":"sayakbay-ms-current144:pdf167:l013","ordinal":395070,"en":"Into the seething Chinese gunfire."},{"id":"sayakbay-ms-current144:pdf167:l015","ordinal":395071,"en":"God, protect your servant,"},{"id":"sayakbay-ms-current144:pdf167:l017","ordinal":395072,"en":"His might, if you saw it, was mountainlike."},{"id":"sayakbay-ms-current144:pdf167:l018","ordinal":395073,"en":"Humiliating such a brave man,"},{"id":"sayakbay-ms-current144:pdf167:l019","ordinal":395074,"en":"And my fierce elder,"},{"id":"sayakbay-ms-current144:pdf167:l020","ordinal":395075,"en":"[He was slain by a spearman],"},{"id":"sayakbay-ms-current144:pdf167:l021","ordinal":395076,"en":"Your resourceful champion,"},{"id":"sayakbay-ms-current144:pdf167:l022","ordinal":395077,"en":"Your peerless valiant hero,"},{"id":"sayakbay-ms-current144:pdf167:l023","ordinal":395078,"en":"The warrior born for your good fortune,"},{"id":"sayakbay-ms-current144:pdf167:l024","ordinal":395079,"en":"The wrathful infidel destroyed him,"},{"id":"sayakbay-ms-current144:pdf167:l025","ordinal":395080,"en":"Thus God struck us down."},{"id":"sayakbay-ms-current144:pdf167:l026","ordinal":395081,"en":"The horn broke from your head,"},{"id":"sayakbay-ms-current144:pdf167:l027","ordinal":395082,"en":"Will it remain hornless?"},{"id":"sayakbay-ms-current144:pdf167:l028","ordinal":395083,"en":"Without your tail, without your mane,"},{"id":"sayakbay-ms-current144:pdf167:l029","ordinal":395084,"en":"Parted from the mighty warrior,"},{"id":"sayakbay-ms-current144:pdf167:l030","ordinal":395085,"en":"Will it remain maimed?"},{"id":"sayakbay-ms-current144:pdf167:l031","ordinal":395086,"en":"Alas, parted from your tail,"},{"id":"sayakbay-ms-current144:pdf168:l001","ordinal":395087,"en":"[Will he become like a wild ass],"},{"id":"sayakbay-ms-current144:pdf168:l002","ordinal":395088,"en":"Deprived of feet to walk with,"},{"id":"sayakbay-ms-current144:pdf168:l003","ordinal":395089,"en":"Will he become like a snake?"},{"id":"sayakbay-ms-current144:pdf168:l004","ordinal":395090,"en":"Creator, grant your protection,"},{"id":"sayakbay-ms-current144:pdf168:l005","ordinal":395091,"en":"What warrior Joltoy has suffered,"},{"id":"sayakbay-ms-current144:pdf168:l006","ordinal":395092,"en":"From now on, Creator,"},{"id":"sayakbay-ms-current144:pdf168:l007","ordinal":395093,"en":"[Do not lay it upon me], he said."},{"id":"sayakbay-ms-current144:pdf168:l010","ordinal":395094,"en":"[Against your fierce, mighty host],"},{"id":"sayakbay-ms-current144:pdf168:l011","ordinal":395095,"en":"[Those caught in hardship],"},{"id":"sayakbay-ms-current144:pdf168:l017","ordinal":395096,"en":"It is the Creator's command."},{"id":"sayakbay-ms-current144:pdf168:l018","ordinal":395097,"en":"[Let me face whatever falls upon me]."},{"id":"sayakbay-ms-current144:pdf168:l020","ordinal":395098,"en":"To the mountainlike protector of good fortune,"},{"id":"sayakbay-ms-current144:pdf168:l021","ordinal":395099,"en":"Let me be a companion."},{"id":"sayakbay-ms-current144:pdf168:l022","ordinal":395100,"en":"Thus spoke warrior Seitek,"},{"id":"sayakbay-ms-current144:pdf168:l023","ordinal":395101,"en":"His roar split heads,"},{"id":"sayakbay-ms-current144:pdf168:l026","ordinal":395102,"en":"[Like a dragon, like a bullet],"},{"id":"sayakbay-ms-current144:pdf168:l027","ordinal":395103,"en":"[His eyes' pupils bulging],"},{"id":"sayakbay-ms-current144:pdf168:l028","ordinal":395104,"en":"[Raising a slaughtering battle cry],"},{"id":"sayakbay-ms-current144:pdf168:l029","ordinal":395105,"en":"Seething with rage upon rage,"},{"id":"sayakbay-ms-current144:pdf168:l030","ordinal":395106,"en":"[Charge, Seitek, at the infidel],"},{"id":"sayakbay-ms-current144:pdf168:l031","ordinal":395107,"en":"[Some taken from among the sheep],"},{"id":"sayakbay-ms-current144:pdf169:l003","ordinal":395108,"en":"Companions appeared from the unseen,"},{"id":"sayakbay-ms-current144:pdf169:l004","ordinal":395109,"en":"[From the dear lion's lair],"},{"id":"sayakbay-ms-current144:pdf169:l005","ordinal":395110,"en":"[Karaanot rendered service]."},{"id":"sayakbay-ms-current144:pdf169:l007","ordinal":395111,"en":"As though about to tear them apart,"},{"id":"sayakbay-ms-current144:pdf169:l009","ordinal":395112,"en":"At the side, one gray tiger,"},{"id":"sayakbay-ms-current144:pdf169:l010","ordinal":395113,"en":"Crawling beneath him,"},{"id":"sayakbay-ms-current144:pdf169:l012","ordinal":395114,"en":"[There was a dark-striped beast],"},{"id":"sayakbay-ms-current144:pdf169:l014","ordinal":395115,"en":"It lunged beside him."},{"id":"sayakbay-ms-current144:pdf169:l016","ordinal":395116,"en":"[Holding close and circling him],"},{"id":"sayakbay-ms-current144:pdf169:l021","ordinal":395117,"en":"Someone behind him urged him on,"},{"id":"sayakbay-ms-current144:pdf169:l022","ordinal":395118,"en":"Saying, seize your enemy!"},{"id":"sayakbay-ms-current144:pdf169:l027","ordinal":395119,"en":"They gave him mountainlike steadiness."},{"id":"sayakbay-ms-current144:pdf169:l028","ordinal":395120,"en":"[If he halted somewhere with a shout],"},{"id":"sayakbay-ms-current144:pdf169:l029","ordinal":395121,"en":"Beyond the Chinese capacity to resist,"},{"id":"sayakbay-ms-current144:pdf169:l030","ordinal":395122,"en":"[Dark-fated and formidable],"},{"id":"sayakbay-ms-current144:pdf169:l031","ordinal":395123,"en":"[Unless appointed death should take him],"},{"id":"sayakbay-ms-current144:pdf170:l001","ordinal":395124,"en":"Saying, Seitek's life is needed,"},{"id":"sayakbay-ms-current144:pdf170:l002","ordinal":395125,"en":"[The slanderer who draws lives],"},{"id":"sayakbay-ms-current144:pdf170:l003","ordinal":395126,"en":"Unless he himself chooses to take it,"},{"id":"sayakbay-ms-current144:pdf170:l004","ordinal":395127,"en":"None could match him in combat."},{"id":"sayakbay-ms-current144:pdf170:l005","ordinal":395128,"en":"These were ninety-six,"},{"id":"sayakbay-ms-current144:pdf170:l006","ordinal":395129,"en":"Even if all Beijing swarmed him,"},{"id":"sayakbay-ms-current144:pdf170:l008","ordinal":395130,"en":"Even if they trampled the whole world,"},{"id":"sayakbay-ms-current144:pdf170:l009","ordinal":395131,"en":"Devastating land and disrupting waters,"},{"id":"sayakbay-ms-current144:pdf170:l010","ordinal":395132,"en":"Even if Chinese from forty khanates attacked,"},{"id":"sayakbay-ms-current144:pdf170:l011","ordinal":395133,"en":"They could not bend and defeat him."},{"id":"sayakbay-ms-current144:pdf170:l012","ordinal":395134,"en":"Against his heat and cold,"},{"id":"sayakbay-ms-current144:pdf170:l013","ordinal":395135,"en":"[Against his confirmed fury],"},{"id":"sayakbay-ms-current144:pdf170:l014","ordinal":395136,"en":"Against his strength and appearance,"},{"id":"sayakbay-ms-current144:pdf170:l015","ordinal":395137,"en":"No person could approach unexpectedly,"},{"id":"sayakbay-ms-current144:pdf170:l017","ordinal":395138,"en":"[Ah, the ordeal of the bloodthirsty lion]."},{"id":"sayakbay-ms-current144:pdf170:l018","ordinal":395139,"en":"When stirred, he killed,"},{"id":"sayakbay-ms-current144:pdf170:l019","ordinal":395140,"en":"His torment was felt by the soul."},{"id":"sayakbay-ms-current144:pdf170:l020","ordinal":395141,"en":"When he lunged with renewed vigor,"},{"id":"sayakbay-ms-current144:pdf170:l021","ordinal":395142,"en":"[Those who saw him spat in dread],"},{"id":"sayakbay-ms-current144:pdf170:l022","ordinal":395143,"en":"When they learned the true news,"},{"id":"sayakbay-ms-current144:pdf170:l023","ordinal":395144,"en":"[Donning his headdress, he entered],"},{"id":"sayakbay-ms-current144:pdf170:l024","ordinal":395145,"en":"His heroism and leonine courage,"},{"id":"sayakbay-ms-current144:pdf170:l025","ordinal":395146,"en":"Became known to the Chinese."},{"id":"sayakbay-ms-current144:pdf170:l026","ordinal":395147,"en":"What he faced was destroyed,"},{"id":"sayakbay-ms-current144:pdf170:l027","ordinal":395148,"en":"The fierce opponent who faced him vanished."},{"id":"sayakbay-ms-current144:pdf170:l028","ordinal":395149,"en":"When they came to fight,"},{"id":"sayakbay-ms-current144:pdf170:l029","ordinal":395150,"en":"He punished and devoured them."},{"id":"sayakbay-ms-current144:pdf170:l031","ordinal":395151,"en":"No mortal could withstand him,"},{"id":"sayakbay-ms-current144:pdf171:l001","ordinal":395152,"en":"Steel outside, gold within,"},{"id":"sayakbay-ms-current144:pdf171:l002","ordinal":395153,"en":"[Tall and thickset, broad-shouldered],"},{"id":"sayakbay-ms-current144:pdf171:l003","ordinal":395154,"en":"[The dear lion of Uzukan],"},{"id":"sayakbay-ms-current144:pdf171:l006","ordinal":395155,"en":"[A great plane tree in a tangled forest],"},{"id":"sayakbay-ms-current144:pdf171:l009","ordinal":395156,"en":"[Great Bilgich crossed our path],"},{"id":"sayakbay-ms-current144:pdf171:l011","ordinal":395157,"en":"He threw the ninety-four into confusion."},{"id":"sayakbay-ms-current144:pdf171:l013","ordinal":395158,"en":"[Driving it through the openings],"},{"id":"sayakbay-ms-current144:pdf171:l014","ordinal":395159,"en":"Trotting it with a bouncing gait,"},{"id":"sayakbay-ms-current144:pdf171:l015","ordinal":395160,"en":"Kulunsur appeared mountainlike,"},{"id":"sayakbay-ms-current144:pdf171:l018","ordinal":395161,"en":"Striking Kulunsur once on the flank,"},{"id":"sayakbay-ms-current144:pdf171:l021","ordinal":395162,"en":"[His armor seethed, his soul burned],"},{"id":"sayakbay-ms-current144:pdf171:l023","ordinal":395163,"en":"Does a warrior not die for honor?"},{"id":"sayakbay-ms-current144:pdf171:l024","ordinal":395164,"en":"What God Almighty has ordained,"},{"id":"sayakbay-ms-current144:pdf171:l025","ordinal":395165,"en":"[Does the entrusted soul not witness it]?"},{"id":"sayakbay-ms-current144:pdf171:l027","ordinal":395166,"en":"Will one not give it whenever required?"},{"id":"sayakbay-ms-current144:pdf171:l028","ordinal":395167,"en":"When this head is besieged,"},{"id":"sayakbay-ms-current144:pdf171:l029","ordinal":395168,"en":"[Where is the Almighty's appointed death],"},{"id":"sayakbay-ms-current144:pdf171:l031","ordinal":395169,"en":"Against the warrior whose wrath was raised,"},{"id":"sayakbay-ms-current144:pdf172:l001","ordinal":395170,"en":"Let me try a clash,"},{"id":"sayakbay-ms-current144:pdf172:l002","ordinal":395171,"en":"Showing myself to the enemy warrior,"},{"id":"sayakbay-ms-current144:pdf172:l005","ordinal":395172,"en":"The warrior's blood being shed,"},{"id":"sayakbay-ms-current144:pdf172:l006","ordinal":395173,"en":"[Rather than being trampled, to equal ground],"},{"id":"sayakbay-ms-current144:pdf172:l007","ordinal":395174,"en":"Let a warrior die at an enemy's hand,"},{"id":"sayakbay-ms-current144:pdf172:l011","ordinal":395175,"en":"Where one's cord was cut and swaddling washed,"},{"id":"sayakbay-ms-current144:pdf172:l013","ordinal":395176,"en":"Honor lost and backs broken,"},{"id":"sayakbay-ms-current144:pdf172:l014","ordinal":395177,"en":"Rather than the people being plundered,"},{"id":"sayakbay-ms-current144:pdf172:l015","ordinal":395178,"en":"[Let me see what strength can do],"},{"id":"sayakbay-ms-current144:pdf172:l018","ordinal":395179,"en":"When I saw him, I had no fear,"},{"id":"sayakbay-ms-current144:pdf172:l019","ordinal":395180,"en":"Seeing his presence, I knew no dread."},{"id":"sayakbay-ms-current144:pdf172:l020","ordinal":395181,"en":"I have seen the ninety-four,"},{"id":"sayakbay-ms-current144:pdf172:l021","ordinal":395182,"en":"[Let me see them in all the world],"},{"id":"sayakbay-ms-current144:pdf172:l026","ordinal":395183,"en":"He covered what lay exposed,"},{"id":"sayakbay-ms-current144:pdf172:l027","ordinal":395184,"en":"He filled my hungry belly,"},{"id":"sayakbay-ms-current144:pdf172:l028","ordinal":395185,"en":"[He made Ala-Too a saddle],"},{"id":"sayakbay-ms-current144:pdf172:l029","ordinal":395186,"en":"In my youth when I knew nothing,"},{"id":"sayakbay-ms-current144:pdf172:l030","ordinal":395187,"en":"He led me and made me a warrior,"},{"id":"sayakbay-ms-current144:pdf172:l031","ordinal":395188,"en":"My warrior elder Ak Joltoy,"},{"id":"sayakbay-ms-current144:pdf173:l001","ordinal":395189,"en":"For my warrior elder Joltoy,"},{"id":"sayakbay-ms-current144:pdf173:l003","ordinal":395190,"en":"Against the wrathful infidel,"},{"id":"sayakbay-ms-current144:pdf173:l004","ordinal":395191,"en":"Being a protector to Joltoy,"},{"id":"sayakbay-ms-current144:pdf173:l005","ordinal":395192,"en":"To my dear heroic elder,"},{"id":"sayakbay-ms-current144:pdf173:l006","ordinal":395193,"en":"[Against the infidel who darkened his days],"},{"id":"sayakbay-ms-current144:pdf173:l009","ordinal":395194,"en":"For the arrogant there is God,"},{"id":"sayakbay-ms-current144:pdf173:l012","ordinal":395195,"en":"My people living freely,"},{"id":"sayakbay-ms-current144:pdf173:l014","ordinal":395196,"en":"Repeatedly plundering and oppressing,"},{"id":"sayakbay-ms-current144:pdf173:l015","ordinal":395197,"en":"[Continually taking my herds],"},{"id":"sayakbay-ms-current144:pdf173:l017","ordinal":395198,"en":"Making my people bow,"},{"id":"sayakbay-ms-current144:pdf173:l019","ordinal":395199,"en":"[My elder Joltoy, my support],"},{"id":"sayakbay-ms-current144:pdf173:l020","ordinal":395200,"en":"His roar split heads,"},{"id":"sayakbay-ms-current144:pdf173:l024","ordinal":395201,"en":"When he saw warrior Seitek,"},{"id":"sayakbay-ms-current144:pdf173:l025","ordinal":395202,"en":"His blood boiled and surged,"},{"id":"sayakbay-ms-current144:pdf173:l026","ordinal":395203,"en":"A protector appeared before his eyes,"},{"id":"sayakbay-ms-current144:pdf173:l027","ordinal":395204,"en":"Strength returned, enough to chew stone,"},{"id":"sayakbay-ms-current144:pdf173:l028","ordinal":395205,"en":"He stood up with a roar."},{"id":"sayakbay-ms-current144:pdf173:l029","ordinal":395206,"en":"Saying, my protector has arrived,"},{"id":"sayakbay-ms-current144:pdf173:l031","ordinal":395207,"en":"[Now my thoughts found comfort],"},{"id":"sayakbay-ms-current144:pdf174:l002","ordinal":395208,"en":"If I die now, I have no regret."},{"id":"sayakbay-ms-current144:pdf174:l004","ordinal":395209,"en":"[If I die from a bullet],"},{"id":"sayakbay-ms-current144:pdf174:l005","ordinal":395210,"en":"If I perish by misfortune,"},{"id":"sayakbay-ms-current144:pdf174:l006","ordinal":395211,"en":"You will take my waist and fold me,"},{"id":"sayakbay-ms-current144:pdf174:l007","ordinal":395212,"en":"[Making a support to carry me],"},{"id":"sayakbay-ms-current144:pdf174:l008","ordinal":395213,"en":"You will carry me to Ala-Too."},{"id":"sayakbay-ms-current144:pdf174:l010","ordinal":395214,"en":"At the wrathful one's hands,"},{"id":"sayakbay-ms-current144:pdf174:l012","ordinal":395215,"en":"[Without dwelling on terrible hardship],"},{"id":"sayakbay-ms-current144:pdf174:l013","ordinal":395216,"en":"[Without letting wolves ravage the body],"},{"id":"sayakbay-ms-current144:pdf174:l014","ordinal":395217,"en":"Food for beasts,"},{"id":"sayakbay-ms-current144:pdf174:l015","ordinal":395218,"en":"[Without disgracing the departed soul],"},{"id":"sayakbay-ms-current144:pdf174:l016","ordinal":395219,"en":"You will dig the earth with a hoe,"},{"id":"sayakbay-ms-current144:pdf174:l017","ordinal":395220,"en":"Reciting the Quran and a sermon,"},{"id":"sayakbay-ms-current144:pdf174:l018","ordinal":395221,"en":"Seitek has come to bury me, he thought."},{"id":"sayakbay-ms-current144:pdf174:l019","ordinal":395222,"en":"Giving thanks to God,"},{"id":"sayakbay-ms-current144:pdf174:l020","ordinal":395223,"en":"[Seeking support from the young man],"},{"id":"sayakbay-ms-current144:pdf174:l021","ordinal":395224,"en":"Rejoicing greatly after anxiety,"},{"id":"sayakbay-ms-current144:pdf174:l022","ordinal":395225,"en":"[Not fearing, by God's protection],"},{"id":"sayakbay-ms-current144:pdf174:l023","ordinal":395226,"en":"[His spirit strengthened, his heart content],"},{"id":"sayakbay-ms-current144:pdf174:l024","ordinal":395227,"en":"Saying, a protector has visibly arrived,"},{"id":"sayakbay-ms-current144:pdf174:l027","ordinal":395228,"en":"Taking courage in his heart,"},{"id":"sayakbay-ms-current144:pdf174:l029","ordinal":395229,"en":"Seeing a multitude in a single warrior,"},{"id":"sayakbay-ms-current144:pdf174:l030","ordinal":395230,"en":"[His burning anguish subsided],"},{"id":"sayakbay-ms-current144:pdf175:l004","ordinal":395231,"en":"Do not ask about that side,"},{"id":"sayakbay-ms-current144:pdf175:l005","ordinal":395232,"en":"A dark cliff with a rocky ridge,"},{"id":"sayakbay-ms-current144:pdf175:l006","ordinal":395233,"en":"[A great peak where two could not pass],"},{"id":"sayakbay-ms-current144:pdf175:l007","ordinal":395234,"en":"[Below was a narrow steep slope],"},{"id":"sayakbay-ms-current144:pdf175:l008","ordinal":395235,"en":"The maddened Chinese had Joltoy,"},{"id":"sayakbay-ms-current144:pdf175:l009","ordinal":395236,"en":"Do not ask where they besieged him."},{"id":"sayakbay-ms-current144:pdf175:l010","ordinal":395237,"en":"[Hurling stars from the sky],"},{"id":"sayakbay-ms-current144:pdf175:l011","ordinal":395238,"en":"[The place of their final stratagem],"},{"id":"sayakbay-ms-current144:pdf175:l012","ordinal":395239,"en":"The ninety-four joined together,"},{"id":"sayakbay-ms-current144:pdf175:l013","ordinal":395240,"en":"Surging forward, they thrust their spears."},{"id":"sayakbay-ms-current144:pdf175:l014","ordinal":395241,"en":"[Weariness came upon the lone man],"},{"id":"sayakbay-ms-current144:pdf175:l015","ordinal":395242,"en":"Your elder Joltoy was undone."},{"id":"sayakbay-ms-current144:pdf175:l016","ordinal":395243,"en":"[Towering like a great register],"},{"id":"sayakbay-ms-current144:pdf175:l017","ordinal":395244,"en":"[Seen, his chest seemed split],"},{"id":"sayakbay-ms-current144:pdf175:l019","ordinal":395245,"en":"He appeared as though a whole people were seen,"},{"id":"sayakbay-ms-current144:pdf175:l020","ordinal":395246,"en":"[Your heroic young falcon],"},{"id":"sayakbay-ms-current144:pdf175:l021","ordinal":395247,"en":"[The forefather of renown],"},{"id":"sayakbay-ms-current144:pdf175:l022","ordinal":395248,"en":"[An unyielding terror to the enemy],"},{"id":"sayakbay-ms-current144:pdf175:l023","ordinal":395249,"en":"[Readying his sacred power and girding himself],"},{"id":"sayakbay-ms-current144:pdf175:l025","ordinal":395250,"en":"[Ahead rose a roaring clamor],"},{"id":"sayakbay-ms-current144:pdf175:l026","ordinal":395251,"en":"[Badyrek's heroism],"},{"id":"sayakbay-ms-current144:pdf175:l028","ordinal":395252,"en":"Thus he waged his campaign,"},{"id":"sayakbay-ms-current144:pdf175:l030","ordinal":395253,"en":"[Invoking] my forefather Manas's spirit,"},{"id":"sayakbay-ms-current144:pdf176:l001","ordinal":395254,"en":"“Now consider the course of the road,” he said."},{"id":"sayakbay-ms-current144:pdf176:l002","ordinal":395255,"en":"Accept it for the giant’s son."},{"id":"sayakbay-ms-current144:pdf176:l003","ordinal":395256,"en":"Such is the way of the great host."},{"id":"sayakbay-ms-current144:pdf176:l004","ordinal":395257,"en":"The hero was worn down out on the plain."},{"id":"sayakbay-ms-current144:pdf176:l005","ordinal":395258,"en":"The impassioned man surged with emotion."},{"id":"sayakbay-ms-current144:pdf176:l006","ordinal":395259,"en":"“Let me break the giant’s fury.”"},{"id":"sayakbay-ms-current144:pdf176:l007","ordinal":395260,"en":"The pale garb left by the champion,"},{"id":"sayakbay-ms-current144:pdf176:l008","ordinal":395261,"en":"is girded on at every ridge and pass."},{"id":"sayakbay-ms-current144:pdf176:l009","ordinal":395262,"en":"like an enemy unknown to the people."},{"id":"sayakbay-ms-current144:pdf176:l010","ordinal":395263,"en":"When the champions saw him, they rejoiced."},{"id":"sayakbay-ms-current144:pdf176:l011","ordinal":395264,"en":"His maiden wife Bermet rejoiced."}]
