[{"id":"seytek-2012:p0510:b003:l033","ordinal":334849,"en":"For the glory of the fray, precious lives"},{"id":"seytek-2012:p0510:b003:l034","ordinal":334850,"en":"Were bound and cast upon a thread."},{"id":"seytek-2012:p0510:b003:l035","ordinal":334851,"en":"They raised a wondrous tumult and strife,"},{"id":"seytek-2012:p0510:b003:l036","ordinal":334852,"en":"Making it a trial for the gathered people."},{"id":"seytek-2012:p0510:b003:l037","ordinal":334853,"en":"They pledged their lives for the nation,"},{"id":"seytek-2012:p0510:b003:l038","ordinal":334854,"en":"To unleash a dreadful battle,"},{"id":"seytek-2012:p0510:b003:l039","ordinal":334855,"en":"And lead the valiant Kyrgyz and Argyn onward."},{"id":"seytek-2012:p0511:b002:l001","ordinal":334856,"en":"To rescue him,"},{"id":"seytek-2012:p0511:b002:l002","ordinal":334857,"en":"To die if death should come,"},{"id":"seytek-2012:p0511:b002:l003","ordinal":334858,"en":"To grapple with"},{"id":"seytek-2012:p0511:b002:l004","ordinal":334859,"en":"The fearsome champion Sarybai."},{"id":"seytek-2012:p0511:b002:l005","ordinal":334860,"en":"To defeat the cruel foe,"},{"id":"seytek-2012:p0511:b002:l006","ordinal":334861,"en":"To shatter his stone city—"},{"id":"seytek-2012:p0511:b002:l007","ordinal":334862,"en":"Seytek’s mind is set"},{"id":"seytek-2012:p0511:b002:l008","ordinal":334863,"en":"On rescuing Kara Döö,"},{"id":"seytek-2012:p0511:b002:l009","ordinal":334864,"en":"If he is still alive."},{"id":"seytek-2012:p0511:b002:l010","ordinal":334865,"en":"Before the army, brave Seytek"},{"id":"seytek-2012:p0511:b002:l011","ordinal":334866,"en":"Leveled his white gun and fired,"},{"id":"seytek-2012:p0511:b002:l012","ordinal":334867,"en":"Raised a clamor like Khan Manas,"},{"id":"seytek-2012:p0511:b002:l013","ordinal":334868,"en":"With a hungry shout that split stone,"},{"id":"seytek-2012:p0511:b002:l014","ordinal":334869,"en":"With fierce courage that broke heads;"},{"id":"seytek-2012:p0511:b002:l015","ordinal":334870,"en":"Whoever saw him stood amazed:"},{"id":"seytek-2012:p0511:b002:l016","ordinal":334871,"en":"He loomed like a blue mountain."},{"id":"seytek-2012:p0511:b002:l017","ordinal":334872,"en":"His lashes were burning embers,"},{"id":"seytek-2012:p0511:b002:l018","ordinal":334873,"en":"His wrath became an arrow;"},{"id":"seytek-2012:p0511:b002:l019","ordinal":334874,"en":"When he saw the foe he must fight,"},{"id":"seytek-2012:p0511:b002:l020","ordinal":334875,"en":"How could he remain still?"},{"id":"seytek-2012:p0511:b002:l021","ordinal":334876,"en":"Tumult rose before the army,"},{"id":"seytek-2012:p0511:b002:l022","ordinal":334877,"en":"And a lion’s roar rang out."},{"id":"seytek-2012:p0511:b002:l023","ordinal":334878,"en":"Could dear young Seytek,"},{"id":"seytek-2012:p0511:b002:l024","ordinal":334879,"en":"True son of the bloodthirsty khan,"},{"id":"seytek-2012:p0511:b002:l025","ordinal":334880,"en":"Ever flee from battle?"},{"id":"seytek-2012:p0511:b002:l026","ordinal":334881,"en":"Behold how the spirits"},{"id":"seytek-2012:p0511:b002:l027","ordinal":334882,"en":"Of his fathers upheld him!"},{"id":"seytek-2012:p0511:b002:l028","ordinal":334883,"en":"A black-mottled leopard"},{"id":"seytek-2012:p0511:b002:l029","ordinal":334884,"en":"Crouched at his side,"},{"id":"seytek-2012:p0511:b002:l030","ordinal":334885,"en":"As if about to tear flesh;"},{"id":"seytek-2012:p0511:b002:l031","ordinal":334886,"en":"A black-maned lion"},{"id":"seytek-2012:p0511:b002:l032","ordinal":334887,"en":"Waited close beside him,"},{"id":"seytek-2012:p0511:b002:l033","ordinal":334888,"en":"As if ready to spring and strike."},{"id":"seytek-2012:p0511:b002:l034","ordinal":334889,"en":"A gray tiger went before him—"},{"id":"seytek-2012:p0511:b002:l035","ordinal":334890,"en":"No living creature was its equal."},{"id":"seytek-2012:p0511:b002:l036","ordinal":334891,"en":"Looming like a blue mountain,"},{"id":"seytek-2012:p0511:b002:l037","ordinal":334892,"en":"The giant Zymyrik black eagle"},{"id":"seytek-2012:p0511:b002:l038","ordinal":334893,"en":"Seemed ready to swoop,"},{"id":"seytek-2012:p0511:b002:l039","ordinal":334894,"en":"Stretching out its talons"},{"id":"seytek-2012:p0511:b003:l001","ordinal":334895,"en":"As though about to seize him,"},{"id":"seytek-2012:p0511:b003:l002","ordinal":334896,"en":"Carry the world’s hero away,"},{"id":"seytek-2012:p0511:b003:l003","ordinal":334897,"en":"And cross the rocky peaks."},{"id":"seytek-2012:p0511:b003:l004","ordinal":334898,"en":"It thrust its talons wide:"},{"id":"seytek-2012:p0511:b003:l005","ordinal":334899,"en":"One of the seven black eagles"},{"id":"seytek-2012:p0511:b003:l006","ordinal":334900,"en":"Truly stood protecting him."},{"id":"seytek-2012:p0511:b003:l007","ordinal":334901,"en":"Forty tigers lined the ridge—"},{"id":"seytek-2012:p0511:b003:l008","ordinal":334902,"en":"No creatures like them had long been seen."},{"id":"seytek-2012:p0511:b003:l009","ordinal":334903,"en":"What he faced became flame,"},{"id":"seytek-2012:p0511:b003:l010","ordinal":334904,"en":"His spirit became a glowing coal;"},{"id":"seytek-2012:p0511:b003:l011","ordinal":334905,"en":"Once he saw the fearsome foe,"},{"id":"seytek-2012:p0511:b003:l012","ordinal":334906,"en":"How could the valiant son"},{"id":"seytek-2012:p0511:b003:l013","ordinal":334907,"en":"Of his father remain still?"},{"id":"seytek-2012:p0511:b003:l014","ordinal":334908,"en":"The dappled bay with swaying ornaments,"},{"id":"seytek-2012:p0511:b003:l015","ordinal":334909,"en":"The heavy, hostile dappled bay;"},{"id":"seytek-2012:p0511:b003:l016","ordinal":334910,"en":"His foe in combat was Sarybai—"},{"id":"seytek-2012:p0511:b003:l017","ordinal":334911,"en":"His splendor was of another kind."},{"id":"seytek-2012:p0511:b003:l018","ordinal":334912,"en":"His fury was mountain-like,"},{"id":"seytek-2012:p0511:b003:l019","ordinal":334913,"en":"As though he might devour"},{"id":"seytek-2012:p0511:b003:l020","ordinal":334914,"en":"The whole wide world at once."},{"id":"seytek-2012:p0511:b003:l021","ordinal":334915,"en":"He sprang like a tiger;"},{"id":"seytek-2012:p0511:b003:l022","ordinal":334916,"en":"None survived his blows."},{"id":"seytek-2012:p0511:b003:l023","ordinal":334917,"en":"The army roared, filling the fortress,"},{"id":"seytek-2012:p0511:b003:l024","ordinal":334918,"en":"Surging and blazing like fire."},{"id":"seytek-2012:p0511:b003:l025","ordinal":334919,"en":"They stirred to close in combat;"},{"id":"seytek-2012:p0511:b003:l026","ordinal":334920,"en":"The troops clamored, covering the earth,"},{"id":"seytek-2012:p0511:b003:l027","ordinal":334921,"en":"Crossing their steel-tipped spears,"},{"id":"seytek-2012:p0511:b003:l028","ordinal":334922,"en":"Binding their lone fly-like lives"},{"id":"seytek-2012:p0511:b003:l029","ordinal":334923,"en":"To a single hair,"},{"id":"seytek-2012:p0511:b003:l030","ordinal":334924,"en":"They crossed the mountain pass"},{"id":"seytek-2012:p0511:b003:l031","ordinal":334925,"en":"And descended onward"},{"id":"seytek-2012:p0511:b003:l032","ordinal":334926,"en":"Into the plain of El-Jürbös."},{"id":"seytek-2012:p0511:b003:l033","ordinal":334927,"en":"The army settled amid a roar,"},{"id":"seytek-2012:p0511:b003:l034","ordinal":334928,"en":"Set out food and slaughtered colts,"},{"id":"seytek-2012:p0511:b003:l035","ordinal":334929,"en":"And had all the coursing steeds"},{"id":"seytek-2012:p0511:b003:l036","ordinal":334930,"en":"Tethered along the lines."},{"id":"seytek-2012:p0511:b003:l037","ordinal":334931,"en":"From barren, well-fed young mares"},{"id":"seytek-2012:p0511:b003:l038","ordinal":334932,"en":"They boiled their meal."},{"id":"seytek-2012:p0511:b003:l039","ordinal":334933,"en":"They finely dressed and slaughtered colts,"},{"id":"seytek-2012:p0511:b003:l040","ordinal":334934,"en":"Then calmly laid out the feast."},{"id":"seytek-2012:p0512:b002:l001","ordinal":334935,"en":"The whole army murmured,"},{"id":"seytek-2012:p0512:b002:l002","ordinal":334936,"en":"The host clamored and buzzed,"},{"id":"seytek-2012:p0512:b002:l003","ordinal":334937,"en":"Dozing with heads on elbows,"},{"id":"seytek-2012:p0512:b003:l001","ordinal":334938,"en":"Resting in brief sleep,"},{"id":"seytek-2012:p0512:b003:l002","ordinal":334939,"en":"Lying until their hips grew weary,"},{"id":"seytek-2012:p0512:b003:l003","ordinal":334940,"en":"Reclining until sleep was satisfied."},{"id":"seytek-2012:p0512:b004:l001","ordinal":334941,"en":"THE TALE OF SARYBAI, SON OF THE MONSTER"},{"id":"seytek-2012:p0512:b005:l001","ordinal":334942,"en":"Beaten down by Sarybai,"},{"id":"seytek-2012:p0512:b005:l002","ordinal":334943,"en":"They had no time to gather their wits,"},{"id":"seytek-2012:p0512:b005:l003","ordinal":334944,"en":"No chance to fight with manly courage;"},{"id":"seytek-2012:p0512:b005:l004","ordinal":334945,"en":"Many champions panicked."},{"id":"seytek-2012:p0512:b005:l005","ordinal":334946,"en":"Of the many vaunting warriors,"},{"id":"seytek-2012:p0512:b005:l006","ordinal":334947,"en":"Some fled back again,"},{"id":"seytek-2012:p0512:b005:l007","ordinal":334948,"en":"While those fated to die were slain."},{"id":"seytek-2012:p0512:b005:l008","ordinal":334949,"en":"Some champions whose death had not come"},{"id":"seytek-2012:p0512:b005:l009","ordinal":334950,"en":"Were swallowed in swirling dust,"},{"id":"seytek-2012:p0512:b005:l010","ordinal":334951,"en":"Their heads like buckets of blood;"},{"id":"seytek-2012:p0512:b005:l011","ordinal":334952,"en":"Many champions panicked."},{"id":"seytek-2012:p0512:b005:l012","ordinal":334953,"en":"They went intending slaughter,"},{"id":"seytek-2012:p0512:b005:l013","ordinal":334954,"en":"But met with bitter disaster,"},{"id":"seytek-2012:p0512:b005:l014","ordinal":334955,"en":"And felt Sarybai’s might."},{"id":"seytek-2012:p0512:b005:l015","ordinal":334956,"en":"The boastful, swaggering men,"},{"id":"seytek-2012:p0512:b005:l016","ordinal":334957,"en":"Those who called themselves heroes,"},{"id":"seytek-2012:p0512:b005:l017","ordinal":334958,"en":"With their mottled bellies thumping,"},{"id":"seytek-2012:p0512:b005:l018","ordinal":334959,"en":"Their blustering chests rumbling,"},{"id":"seytek-2012:p0512:b005:l019","ordinal":334960,"en":"Those witless braggarts,"},{"id":"seytek-2012:p0512:b005:l020","ordinal":334961,"en":"Failed to meet the foe they sought"},{"id":"seytek-2012:p0512:b005:l021","ordinal":334962,"en":"And met the one they had not sought;"},{"id":"seytek-2012:p0512:b005:l022","ordinal":334963,"en":"Many champions were destroyed."},{"id":"seytek-2012:p0512:b005:l023","ordinal":334964,"en":"All those who fell"},{"id":"seytek-2012:p0512:b005:l024","ordinal":334965,"en":"Were hotheaded braggarts,"},{"id":"seytek-2012:p0512:b005:l025","ordinal":334966,"en":"Empty-chested, broad-flanked men"},{"id":"seytek-2012:p0512:b005:l026","ordinal":334967,"en":"Who had strutted in arrogance."},{"id":"seytek-2012:p0512:b005:l027","ordinal":334968,"en":"They cast away their lives;"},{"id":"seytek-2012:p0512:b005:l028","ordinal":334969,"en":"Those who were not killed"},{"id":"seytek-2012:p0512:b005:l029","ordinal":334970,"en":"Retreated and fled again."},{"id":"seytek-2012:p0512:b005:l030","ordinal":334971,"en":"The warriors who posed as champions,"},{"id":"seytek-2012:p0512:b005:l031","ordinal":334972,"en":"Exalting themselves,"},{"id":"seytek-2012:p0512:b005:l032","ordinal":334973,"en":"Those who said, “I am a champion,”"},{"id":"seytek-2012:p0512:b005:l033","ordinal":334974,"en":"Threw away their lives."},{"id":"seytek-2012:p0512:b006:l001","ordinal":334975,"en":"While the army stood thus,"},{"id":"seytek-2012:p0512:b006:l002","ordinal":334976,"en":"The earth heaved like lake and river;"},{"id":"seytek-2012:p0512:b006:l003","ordinal":334977,"en":"While the people stood thus,"},{"id":"seytek-2012:p0512:b006:l004","ordinal":334978,"en":"The whitening dawn broke,"},{"id":"seytek-2012:p0512:b006:l005","ordinal":334979,"en":"Pouring light upon the earth."},{"id":"seytek-2012:p0512:b006:l006","ordinal":334980,"en":"As day began to dawn,"},{"id":"seytek-2012:p0512:b006:l007","ordinal":334981,"en":"The cold wind before sunrise"},{"id":"seytek-2012:p0512:b006:l008","ordinal":334982,"en":"Swept down the valley;"},{"id":"seytek-2012:p0512:b006:l009","ordinal":334983,"en":"The reed tops shivered,"},{"id":"seytek-2012:p0512:b006:l010","ordinal":334984,"en":"Young larks clamored,"},{"id":"seytek-2012:p0512:b006:l011","ordinal":334985,"en":"All living creatures stirred,"},{"id":"seytek-2012:p0512:b006:l012","ordinal":334986,"en":"Every beast awoke."},{"id":"seytek-2012:p0512:b006:l013","ordinal":334987,"en":"One by one the stars in heaven"},{"id":"seytek-2012:p0512:b006:l014","ordinal":334988,"en":"Quivered toward the qibla;"},{"id":"seytek-2012:p0512:b006:l015","ordinal":334989,"en":"The stars overhead glittered,"},{"id":"seytek-2012:p0512:b006:l016","ordinal":334990,"en":"Hurrying toward the qibla."},{"id":"seytek-2012:p0512:b006:l017","ordinal":334991,"en":"The dawn opened bright,"},{"id":"seytek-2012:p0512:b006:l018","ordinal":334992,"en":"The earth’s twilight withdrew;"},{"id":"seytek-2012:p0512:b006:l019","ordinal":334993,"en":"A light breeze rose to a wind,"},{"id":"seytek-2012:p0512:b006:l020","ordinal":334994,"en":"And the land appeared, filled with troops."},{"id":"seytek-2012:p0512:b006:l021","ordinal":334995,"en":"Shapes emerged from the darkness,"},{"id":"seytek-2012:p0512:b006:l022","ordinal":334996,"en":"And the face of the world appeared."},{"id":"seytek-2012:p0512:b006:l023","ordinal":334997,"en":"When they gathered their baggage,"},{"id":"seytek-2012:p0512:b006:l024","ordinal":334998,"en":"And the camp began to move,"},{"id":"seytek-2012:p0512:b006:l025","ordinal":334999,"en":"The sentries on watch—"},{"id":"seytek-2012:p0512:b006:l026","ordinal":335000,"en":"Those who scouted land and road,"},{"id":"seytek-2012:p0512:b006:l027","ordinal":335001,"en":"And learned the enemy’s order—"},{"id":"seytek-2012:p0512:b006:l028","ordinal":335002,"en":"Surveyed the ground and searched the way,"},{"id":"seytek-2012:p0512:b006:l029","ordinal":335003,"en":"Often exchanging shots."},{"id":"seytek-2012:p0512:b006:l030","ordinal":335004,"en":"They would become entangled"},{"id":"seytek-2012:p0512:b006:l031","ordinal":335005,"en":"In every peril of the foe."},{"id":"seytek-2012:p0512:b006:l032","ordinal":335006,"en":"Dashing about in agitation,"},{"id":"seytek-2012:p0512:b006:l033","ordinal":335007,"en":"They encountered the forward guards,"},{"id":"seytek-2012:p0513:b002:l001","ordinal":335008,"en":"And came to tell the champions."},{"id":"seytek-2012:p0513:b002:l002","ordinal":335009,"en":"Those ill-fated were captured;"},{"id":"seytek-2012:p0513:b002:l003","ordinal":335010,"en":"Some champions whose death had not come"},{"id":"seytek-2012:p0513:b002:l004","ordinal":335011,"en":"Barely managed to escape."},{"id":"seytek-2012:p0513:b002:l005","ordinal":335012,"en":"Sarybai struck the doomed"},{"id":"seytek-2012:p0513:b002:l006","ordinal":335013,"en":"With mace and bow;"},{"id":"seytek-2012:p0513:b002:l007","ordinal":335014,"en":"The fortunate pressed onward,"},{"id":"seytek-2012:p0513:b002:l008","ordinal":335015,"en":"While the wretched fled back."},{"id":"seytek-2012:p0513:b002:l009","ordinal":335016,"en":"Brave hero Seytek was there,"},{"id":"seytek-2012:p0513:b002:l010","ordinal":335017,"en":"Facing them and speaking."},{"id":"seytek-2012:p0513:b002:l011","ordinal":335018,"en":"The vast army grieved,"},{"id":"seytek-2012:p0513:b002:l012","ordinal":335019,"en":"Despairing of their fly-like lives."},{"id":"seytek-2012:p0513:b002:l013","ordinal":335020,"en":"Their bodies went limp with sobbing;"},{"id":"seytek-2012:p0513:b002:l014","ordinal":335021,"en":"Unable to regain their senses,"},{"id":"seytek-2012:p0513:b002:l015","ordinal":335022,"en":"The great host stood clamoring."},{"id":"seytek-2012:p0513:b002:l016","ordinal":335023,"en":"The war drum thundered firmly;"},{"id":"seytek-2012:p0513:b002:l017","ordinal":335024,"en":"Within the army Külchoro"},{"id":"seytek-2012:p0513:b002:l018","ordinal":335025,"en":"Swept forward like a spirit,"},{"id":"seytek-2012:p0513:b002:l019","ordinal":335026,"en":"Finding counsel where none seemed possible."},{"id":"seytek-2012:p0513:b002:l020","ordinal":335027,"en":"The trumpets blared in excitement,"},{"id":"seytek-2012:p0513:b002:l021","ordinal":335028,"en":"And his trumpeter grew fervent."},{"id":"seytek-2012:p0513:b002:l022","ordinal":335029,"en":"Throwing every soul into alarm,"},{"id":"seytek-2012:p0513:b002:l023","ordinal":335030,"en":"He made the gray horse beneath him"},{"id":"seytek-2012:p0513:b002:l024","ordinal":335031,"en":"Stride forward at a stately pace,"},{"id":"seytek-2012:p0513:b002:l025","ordinal":335032,"en":"And leveled his steel weapon."},{"id":"seytek-2012:p0513:b002:l026","ordinal":335033,"en":"He swallowed up the countless host"},{"id":"seytek-2012:p0513:b002:l027","ordinal":335034,"en":"That had panicked helplessly."},{"id":"seytek-2012:p0513:b002:l028","ordinal":335035,"en":"His lashes became leaping flame,"},{"id":"seytek-2012:p0513:b002:l029","ordinal":335036,"en":"His eyes blazed like embers."},{"id":"seytek-2012:p0513:b002:l030","ordinal":335037,"en":"He gnashed his teeth with a crack,"},{"id":"seytek-2012:p0513:b002:l031","ordinal":335038,"en":"His bloodthirsty visage boiling fiercely."},{"id":"seytek-2012:p0513:b002:l032","ordinal":335039,"en":"Flaring with wrath,"},{"id":"seytek-2012:p0513:b002:l033","ordinal":335040,"en":"He addressed the great army:"},{"id":"seytek-2012:p0513:b002:l034","ordinal":335041,"en":"“Damn you, mighty host!"},{"id":"seytek-2012:p0513:b002:l035","ordinal":335042,"en":"You are lions and tigers,"},{"id":"seytek-2012:p0513:b002:l036","ordinal":335043,"en":"Imposing warriors,"},{"id":"seytek-2012:p0513:b002:l037","ordinal":335044,"en":"Who came here seeking battle!"},{"id":"seytek-2012:p0513:b002:l038","ordinal":335045,"en":"But when battle begins, you lose your heads"},{"id":"seytek-2012:p0513:b002:l039","ordinal":335046,"en":"And flee in terror—"},{"id":"seytek-2012:p0513:b002:l040","ordinal":335047,"en":"If you act so, people, you are dead!"},{"id":"seytek-2012:p0513:b003:l001","ordinal":335048,"en":"Those who escaped death"},{"id":"seytek-2012:p0513:b003:l002","ordinal":335049,"en":"Raised a clamor and fled back."},{"id":"seytek-2012:p0513:b003:l003","ordinal":335050,"en":"Some champions are wounded,"},{"id":"seytek-2012:p0513:b003:l004","ordinal":335051,"en":"While some remain wholly unharmed."},{"id":"seytek-2012:p0513:b003:l005","ordinal":335052,"en":"Some champions lost their nerve,"},{"id":"seytek-2012:p0513:b003:l006","ordinal":335053,"en":"Were soundly pierced by spears,"},{"id":"seytek-2012:p0513:b003:l007","ordinal":335054,"en":"And fled without finding a way out."},{"id":"seytek-2012:p0513:b003:l008","ordinal":335055,"en":"May God never show us his face!"},{"id":"seytek-2012:p0513:b003:l009","ordinal":335056,"en":"Sarybai is a horror,"},{"id":"seytek-2012:p0513:b003:l010","ordinal":335057,"en":"They say he turned the army from the hills;"},{"id":"seytek-2012:p0513:b003:l011","ordinal":335058,"en":"They say he slaughtered without a word"},{"id":"seytek-2012:p0513:b003:l012","ordinal":335059,"en":"All whom he encountered."},{"id":"seytek-2012:p0513:b003:l013","ordinal":335060,"en":"None can overcome him in combat,"},{"id":"seytek-2012:p0513:b003:l014","ordinal":335061,"en":"No lion’s teeth can pierce him;"},{"id":"seytek-2012:p0513:b003:l015","ordinal":335062,"en":"His form is strange, his venom strong."},{"id":"seytek-2012:p0513:b003:l016","ordinal":335063,"en":"If you encounter Sarybai,"},{"id":"seytek-2012:p0513:b003:l017","ordinal":335064,"en":"Abandon hope of life and count yourselves dead!"},{"id":"seytek-2012:p0513:b003:l018","ordinal":335065,"en":"He is fire incarnate,"},{"id":"seytek-2012:p0513:b003:l019","ordinal":335066,"en":"The eye of a devouring fiend,"},{"id":"seytek-2012:p0513:b003:l020","ordinal":335067,"en":"The very red essence of disaster."},{"id":"seytek-2012:p0513:b003:l021","ordinal":335068,"en":"We have seen Sarybai’s form:"},{"id":"seytek-2012:p0513:b003:l022","ordinal":335069,"en":"He is like a champion who ruins nations,"},{"id":"seytek-2012:p0513:b003:l023","ordinal":335070,"en":"Driving men like helpless prey,"},{"id":"seytek-2012:p0513:b003:l024","ordinal":335071,"en":"Rending them like a hungry wolf."},{"id":"seytek-2012:p0513:b003:l025","ordinal":335072,"en":"It is as though he gathered the whole world"},{"id":"seytek-2012:p0513:b003:l026","ordinal":335073,"en":"And stuffed it into a single sack."},{"id":"seytek-2012:p0513:b003:l027","ordinal":335074,"en":"Almighty Allah creates"},{"id":"seytek-2012:p0513:b003:l028","ordinal":335075,"en":"His servants in every fashion."},{"id":"seytek-2012:p0513:b003:l029","ordinal":335076,"en":"His two cheeks hang loose,"},{"id":"seytek-2012:p0513:b003:l030","ordinal":335077,"en":"As though two giants had feasted."},{"id":"seytek-2012:p0513:b003:l031","ordinal":335078,"en":"He turns all before him into desert,"},{"id":"seytek-2012:p0513:b003:l032","ordinal":335079,"en":"As though gulping them down whole."},{"id":"seytek-2012:p0513:b003:l033","ordinal":335080,"en":"No vast host can advance against him;"},{"id":"seytek-2012:p0513:b003:l034","ordinal":335081,"en":"None who fights him can survive."},{"id":"seytek-2012:p0513:b003:l035","ordinal":335082,"en":"Black-browed like a recumbent hound,"},{"id":"seytek-2012:p0513:b003:l036","ordinal":335083,"en":"As though vultures roosted upon him,"},{"id":"seytek-2012:p0513:b003:l037","ordinal":335084,"en":"He gnaws whoever meets him,"},{"id":"seytek-2012:p0513:b003:l038","ordinal":335085,"en":"As though swallowing them whole—"},{"id":"seytek-2012:p0513:b003:l039","ordinal":335086,"en":"Such is Sarybai’s appearance."},{"id":"seytek-2012:p0513:b003:l040","ordinal":335087,"en":"However hard each man may struggle,"},{"id":"seytek-2012:p0514:b002:l001","ordinal":335088,"en":"“If I do not slaughter all I meet,"},{"id":"seytek-2012:p0514:b002:l002","ordinal":335089,"en":"If in the end I do not sate myself"},{"id":"seytek-2012:p0514:b002:l003","ordinal":335090,"en":"Upon that dog Sarybai’s blood!”"},{"id":"seytek-2012:p0514:b002:l004","ordinal":335091,"en":"Hero Külchoro spoke these words;"},{"id":"seytek-2012:p0514:b002:l005","ordinal":335092,"en":"Your renowned uncle rose there,"},{"id":"seytek-2012:p0514:b002:l006","ordinal":335093,"en":"Your uncle Külchoro spoke thus,"},{"id":"seytek-2012:p0514:b002:l007","ordinal":335094,"en":"And his eyes glittered like flame."},{"id":"seytek-2012:p0514:b002:l008","ordinal":335095,"en":"When he heard of Sarybai,"},{"id":"seytek-2012:p0514:b002:l009","ordinal":335096,"en":"Fearsome rage seized him."},{"id":"seytek-2012:p0514:b002:l010","ordinal":335097,"en":"His precious, clenched teeth"},{"id":"seytek-2012:p0514:b002:l011","ordinal":335098,"en":"He ground again and again."},{"id":"seytek-2012:p0514:b002:l012","ordinal":335099,"en":"Hell showed upon his face;"},{"id":"seytek-2012:p0514:b002:l013","ordinal":335100,"en":"His lion-hearted valor"},{"id":"seytek-2012:p0514:b002:l014","ordinal":335101,"en":"Surpassed the host and set him apart."},{"id":"seytek-2012:p0514:b002:l015","ordinal":335102,"en":"He gathered himself like a blue tiger,"},{"id":"seytek-2012:p0514:b002:l016","ordinal":335103,"en":"Clad himself in armor no bullet pierced,"},{"id":"seytek-2012:p0514:b002:l017","ordinal":335104,"en":"Set all his weapons in order,"}]
