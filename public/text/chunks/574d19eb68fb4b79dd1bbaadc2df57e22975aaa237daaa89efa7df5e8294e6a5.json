[{"id":"manas-2010:p0493:b001:l028","ordinal":22529,"en":"Manas then, his great frame swaying,"},{"id":"manas-2010:p0493:b001:l029","ordinal":22530,"en":"Put on the gray coat."},{"id":"manas-2010:p0493:b001:l030","ordinal":22531,"en":"The beholder's heart was stirred;"},{"id":"manas-2010:p0493:b001:l031","ordinal":22532,"en":"The leopard touched by Kydyr"},{"id":"manas-2010:p0493:b001:l032","ordinal":22533,"en":"Appeared like a gray-ridged mountain."},{"id":"manas-2010:p0493:b001:l033","ordinal":22534,"en":"At the clamoring Kalmyks,"},{"id":"manas-2010:p0493:b001:l034","ordinal":22535,"en":"The blood-drinking wolf-man took fright."},{"id":"manas-2010:p0493:b001:l035","ordinal":22536,"en":"Aybanboz, whom Aykhozho gave,"},{"id":"manas-2010:p0493:b001:l036","ordinal":22537,"en":"He now saddled."},{"id":"manas-2010:p0493:b001:l037","ordinal":22538,"en":"Your magnanimous one's Akkangky"},{"id":"manas-2010:p0493:b001:l038","ordinal":22539,"en":"Was a saddle just right for Aybanboz."},{"id":"manas-2010:p0493:b001:l039","ordinal":22540,"en":"Its front bow was white gold,"},{"id":"manas-2010:p0493:b001:l040","ordinal":22541,"en":"Its rear bow was pure silver;"},{"id":"manas-2010:p0493:b001:l041","ordinal":22542,"en":"Both sides were broad iron,"},{"id":"manas-2010:p0493:b001:l042","ordinal":22543,"en":"It would not tilt in mounted wrestling."},{"id":"manas-2010:p0494:b001:l001","ordinal":22544,"en":"Its back was high, its saddle low,"},{"id":"manas-2010:p0494:b001:l002","ordinal":22545,"en":"Well suited for entering battle."},{"id":"manas-2010:p0494:b001:l003","ordinal":22546,"en":"Your magnanimous one's great gray horse,"},{"id":"manas-2010:p0494:b001:l004","ordinal":22547,"en":"Breast strap and crupper,"},{"id":"manas-2010:p0494:b001:l005","ordinal":22548,"en":"How well the many straps became him!"},{"id":"manas-2010:p0494:b001:l006","ordinal":22549,"en":"Bringing Aybanboz forward,"},{"id":"manas-2010:p0494:b001:l007","ordinal":22550,"en":"Aykhozho held him out."},{"id":"manas-2010:p0494:b001:l008","ordinal":22551,"en":"Your wolf-man could scarcely wait;"},{"id":"manas-2010:p0494:b001:l009","ordinal":22552,"en":"He had yearned for a horse."},{"id":"manas-2010:p0494:b001:l010","ordinal":22553,"en":"The gold-treaded stirrup,"},{"id":"manas-2010:p0494:b001:l011","ordinal":22554,"en":"Without stepping in it, he leaped up and galloped."},{"id":"manas-2010:p0494:b001:l012","ordinal":22555,"en":"He girded his waist securely;"},{"id":"manas-2010:p0494:b001:l013","ordinal":22556,"en":"Into seven san of Black Chinese,"},{"id":"manas-2010:p0494:b001:l014","ordinal":22557,"en":"He plunged alone and attacked."},{"id":"manas-2010:p0494:b001:l015","ordinal":22558,"en":"His eyes blazed like a lion's;"},{"id":"manas-2010:p0494:b001:l016","ordinal":22559,"en":"Manas would not refrain from combat."},{"id":"manas-2010:p0494:b001:l017","ordinal":22560,"en":"Bellowing in his wrath,"},{"id":"manas-2010:p0494:b001:l018","ordinal":22561,"en":"Bloodthirsty Manas then"},{"id":"manas-2010:p0494:b001:l019","ordinal":22562,"en":"Raised “Manas!” as his battle cry:"},{"id":"manas-2010:p0494:b001:l020","ordinal":22563,"en":"“Manas! Manas! Manas!” he cried."},{"id":"manas-2010:p0494:b001:l021","ordinal":22564,"en":"When he raised the cry of “Manas!”"},{"id":"manas-2010:p0494:b001:l022","ordinal":22565,"en":"Those who remained after the dead,"},{"id":"manas-2010:p0494:b001:l023","ordinal":22566,"en":"Every one of them heard it,"},{"id":"manas-2010:p0494:b001:l024","ordinal":22567,"en":"The champions of the Muslims."},{"id":"manas-2010:p0494:b001:l025","ordinal":22568,"en":"Shouting rose from the hills;"},{"id":"manas-2010:p0494:b001:l026","ordinal":22569,"en":"Aykhozho in his motley robe"},{"id":"manas-2010:p0494:b001:l027","ordinal":22570,"en":"Raised “Manas!” as his battle cry."},{"id":"manas-2010:p0494:b001:l028","ordinal":22571,"en":"Shouting rose from the steep bank;"},{"id":"manas-2010:p0494:b001:l029","ordinal":22572,"en":"Bearing a flag with a golden crescent,"},{"id":"manas-2010:p0494:b001:l030","ordinal":22573,"en":"Raising cries of “Holy One!”"},{"id":"manas-2010:p0494:b001:l031","ordinal":22574,"en":"They raised “Manas!” as their battle cry."},{"id":"manas-2010:p0494:b001:l032","ordinal":22575,"en":"Shouting rose from the crags;"},{"id":"manas-2010:p0494:b001:l033","ordinal":22576,"en":"Trampling living men like stones,"},{"id":"manas-2010:p0494:b001:l034","ordinal":22577,"en":"Praising his wife like a maiden,"},{"id":"manas-2010:p0494:b001:l035","ordinal":22578,"en":"Aydarkan of the Kazakhs"},{"id":"manas-2010:p0494:b001:l036","ordinal":22579,"en":"Raised “Manas!” as his battle cry."},{"id":"manas-2010:p0494:b001:l037","ordinal":22580,"en":"Shouting rose from the ridge;"},{"id":"manas-2010:p0494:b001:l038","ordinal":22581,"en":"Buudayyk, khan of Khiva,"},{"id":"manas-2010:p0494:b001:l039","ordinal":22582,"en":"Raised “Manas!” as his battle cry."},{"id":"manas-2010:p0494:b001:l040","ordinal":22583,"en":"Shouting rose from the hollow;"},{"id":"manas-2010:p0494:b001:l041","ordinal":22584,"en":"All the hollows and the mountains"},{"id":"manas-2010:p0494:b001:l042","ordinal":22585,"en":"Raised “Manas!” as their battle cry."},{"id":"manas-2010:p0495:b001:l001","ordinal":22586,"en":"Shouting rose from the mountain;"},{"id":"manas-2010:p0495:b001:l002","ordinal":22587,"en":"All of them, together with the hollows,"},{"id":"manas-2010:p0495:b001:l003","ordinal":22588,"en":"Raised “Manas!” as their battle cry."},{"id":"manas-2010:p0495:b001:l004","ordinal":22589,"en":"Unbroken, into the great Manchu army,"},{"id":"manas-2010:p0495:b001:l005","ordinal":22590,"en":"They turned, plunged in and attacked."},{"id":"manas-2010:p0495:b001:l006","ordinal":22591,"en":"The Kalmyks standing like a fence,"},{"id":"manas-2010:p0495:b001:l007","ordinal":22592,"en":"They speared again, cutting a path."},{"id":"manas-2010:p0495:b001:l008","ordinal":22593,"en":"At their throat, your magnanimous one"},{"id":"manas-2010:p0495:b001:l009","ordinal":22594,"en":"Came driving and striking them."},{"id":"manas-2010:p0495:b001:l010","ordinal":22595,"en":"On the northern side, Kutubiy"},{"id":"manas-2010:p0495:b001:l011","ordinal":22596,"en":"Scorched and drove them off."},{"id":"manas-2010:p0495:b001:l012","ordinal":22597,"en":"At their throat, Khan Koshoy"},{"id":"manas-2010:p0495:b001:l013","ordinal":22598,"en":"Came driving and striking them."},{"id":"manas-2010:p0495:b001:l014","ordinal":22599,"en":"The unbelievers like dark willows,"},{"id":"manas-2010:p0495:b001:l015","ordinal":22600,"en":"Spearing again and pursuing,"},{"id":"manas-2010:p0495:b001:l016","ordinal":22601,"en":"Bloodthirsty Manas swept them down."},{"id":"manas-2010:p0495:b001:l017","ordinal":22602,"en":"When the Muslims gave chase,"},{"id":"manas-2010:p0495:b001:l018","ordinal":22603,"en":"When they made a dreadful slaughter,"},{"id":"manas-2010:p0495:b001:l019","ordinal":22604,"en":"Manas passed through, spearing;"},{"id":"manas-2010:p0495:b001:l020","ordinal":22605,"en":"Koshoy went cutting off heads."},{"id":"manas-2010:p0495:b001:l021","ordinal":22606,"en":"Koshoy passed through, spearing;"},{"id":"manas-2010:p0495:b001:l022","ordinal":22607,"en":"Manas went cutting off heads."},{"id":"manas-2010:p0495:b001:l023","ordinal":22608,"en":"The neck of the saddle-shaped pass,"},{"id":"manas-2010:p0495:b001:l024","ordinal":22609,"en":"They were crossing over."},{"id":"manas-2010:p0495:b001:l025","ordinal":22610,"en":"Those who remained after the dead"},{"id":"manas-2010:p0495:b001:l026","ordinal":22611,"en":"Were fleeing away."},{"id":"manas-2010:p0495:b001:l027","ordinal":22612,"en":"Their own belongings, the Chinese"},{"id":"manas-2010:p0495:b001:l028","ordinal":22613,"en":"Were scattering as they went."},{"id":"manas-2010:p0495:b001:l029","ordinal":22614,"en":"On the rolling, rugged ground,"},{"id":"manas-2010:p0495:b001:l030","ordinal":22615,"en":"Spears remained jutting up."},{"id":"manas-2010:p0495:b001:l031","ordinal":22616,"en":"The mighty men in jackets,"},{"id":"manas-2010:p0495:b001:l032","ordinal":22617,"en":"The bald men who worshipped stones,"},{"id":"manas-2010:p0495:b001:l033","ordinal":22618,"en":"Died in the field, stretched out."},{"id":"manas-2010:p0495:b001:l034","ordinal":22619,"en":"Of many fine coursers,"},{"id":"manas-2010:p0495:b001:l035","ordinal":22620,"en":"The lead ropes trailed loose."},{"id":"manas-2010:p0495:b001:l036","ordinal":22621,"en":"Their giants and monsters, struck by spears,"},{"id":"manas-2010:p0495:b001:l037","ordinal":22622,"en":"Were slaughtered, sprawling."},{"id":"manas-2010:p0495:b001:l038","ordinal":22623,"en":"In disorder, lurching about,"},{"id":"manas-2010:p0495:b001:l039","ordinal":22624,"en":"Many more hurried away;"},{"id":"manas-2010:p0495:b001:l040","ordinal":22625,"en":"Stumbling along mountain after mountain,"},{"id":"manas-2010:p0495:b001:l041","ordinal":22626,"en":"Many more fled."},{"id":"manas-2010:p0495:b001:l042","ordinal":22627,"en":"Unable to find their wits,"},{"id":"manas-2010:p0496:b001:l001","ordinal":22628,"en":"Many more hurried away."},{"id":"manas-2010:p0496:b001:l002","ordinal":22629,"en":"Among the renowned, khans died;"},{"id":"manas-2010:p0496:b001:l003","ordinal":22630,"en":"All who faced them died."},{"id":"manas-2010:p0496:b001:l004","ordinal":22631,"en":"The dense army that had come that time,"},{"id":"manas-2010:p0496:b001:l005","ordinal":22632,"en":"The road lay at the army's rear."},{"id":"manas-2010:p0496:b001:l006","ordinal":22633,"en":"Their heroes and their khans,"},{"id":"manas-2010:p0496:b001:l007","ordinal":22634,"en":"Those who remained after the dead—"},{"id":"manas-2010:p0496:b001:l008","ordinal":22635,"en":"Khan Koshoy's men,"},{"id":"manas-2010:p0496:b001:l009","ordinal":22636,"en":"The worthy heroes,"},{"id":"manas-2010:p0496:b001:l010","ordinal":22637,"en":"The champions among spearmen,"},{"id":"manas-2010:p0496:b001:l011","ordinal":22638,"en":"Took sixty horses apiece."},{"id":"manas-2010:p0496:b001:l012","ordinal":22639,"en":"The seasoned masters among spearmen,"},{"id":"manas-2010:p0496:b001:l013","ordinal":22640,"en":"The skillful ones who knew the enemy's ways,"},{"id":"manas-2010:p0496:b001:l014","ordinal":22641,"en":"Took seventy horses apiece."},{"id":"manas-2010:p0496:b001:l015","ordinal":22642,"en":"Even the utterly cowardly wretches"},{"id":"manas-2010:p0496:b001:l016","ordinal":22643,"en":"Took seven horses apiece as spoils."},{"id":"manas-2010:p0496:b001:l017","ordinal":22644,"en":"They put the weak to death;"},{"id":"manas-2010:p0496:b001:l018","ordinal":22645,"en":"The fighters grew calm."},{"id":"manas-2010:p0496:b001:l019","ordinal":22646,"en":"They wreaked fierce havoc;"},{"id":"manas-2010:p0496:b001:l020","ordinal":22647,"en":"Lord wolf-man Manas,"},{"id":"manas-2010:p0496:b001:l021","ordinal":22648,"en":"From the seething army, the mighty lion,"},{"id":"manas-2010:p0496:b001:l022","ordinal":22649,"en":"That renowned Sultan Manas,"},{"id":"manas-2010:p0496:b001:l023","ordinal":22650,"en":"They rescued him."},{"id":"manas-2010:p0496:b001:l024","ordinal":22651,"en":"The unbelievers like dark willows,"},{"id":"manas-2010:p0496:b001:l025","ordinal":22652,"en":"They drove back and swept away."},{"id":"manas-2010:p0496:b001:l026","ordinal":22653,"en":"Their strong men died, their giants died;"},{"id":"manas-2010:p0496:b001:l027","ordinal":22654,"en":"All who grappled died."},{"id":"manas-2010:p0496:b001:l028","ordinal":22655,"en":"The strong-backed men died;"},{"id":"manas-2010:p0496:b001:l029","ordinal":22656,"en":"All who faced them died."},{"id":"manas-2010:p0496:b001:l030","ordinal":22657,"en":"The courageous broke the ranks;"},{"id":"manas-2010:p0496:b001:l031","ordinal":22658,"en":"The weak-hearted, inferior men"},{"id":"manas-2010:p0496:b001:l032","ordinal":22659,"en":"Fled in haste and fell to shots."},{"id":"manas-2010:p0496:b001:l033","ordinal":22660,"en":"Their heroes and their warriors,"},{"id":"manas-2010:p0496:b001:l034","ordinal":22661,"en":"Unable to face them in battle,"},{"id":"manas-2010:p0496:b001:l035","ordinal":22662,"en":"Their wise men and their lions,"},{"id":"manas-2010:p0496:b001:l036","ordinal":22663,"en":"Unable to stand with courage,"},{"id":"manas-2010:p0496:b001:l037","ordinal":22664,"en":"The army broke apart in fragments."},{"id":"manas-2010:p0496:b001:l038","ordinal":22665,"en":"The Chinese were routed,"},{"id":"manas-2010:p0496:b001:l039","ordinal":22666,"en":"Fleeing to the emperor, shrieking."},{"id":"manas-2010:p0496:b001:l040","ordinal":22667,"en":"Having lost Toruchaar to a shot,"},{"id":"manas-2010:p0496:b001:l041","ordinal":22668,"en":"Your camel-sized destroyer"},{"id":"manas-2010:p0496:b001:l042","ordinal":22669,"en":"Had now mounted Aybanboz."},{"id":"manas-2010:p0497:b001:l001","ordinal":22670,"en":"Making the Chinese cry out,"},{"id":"manas-2010:p0497:b001:l002","ordinal":22671,"en":"He was driving them away."},{"id":"manas-2010:p0497:b001:l003","ordinal":22672,"en":"He had unleashed fierce wrath;"},{"id":"manas-2010:p0497:b001:l004","ordinal":22673,"en":"The army that had come lay stretched out:"},{"id":"manas-2010:p0497:b001:l005","ordinal":22674,"en":"Khan Manas had slaughtered them."},{"id":"manas-2010:p0497:b001:l006","ordinal":22675,"en":"Beyond broad Altai,"},{"id":"manas-2010:p0497:b001:l007","ordinal":22676,"en":"Where nine mountains met,"},{"id":"manas-2010:p0497:b001:l008","ordinal":22677,"en":"Where ninety rivers joined,"},{"id":"manas-2010:p0497:b001:l009","ordinal":22678,"en":"Was the meeting of many roads."},{"id":"manas-2010:p0497:b001:l010","ordinal":22679,"en":"If the bravest warrior could endure,"},{"id":"manas-2010:p0497:b001:l011","ordinal":22680,"en":"He could somehow scout the way."},{"id":"manas-2010:p0497:b001:l012","ordinal":22681,"en":"If fools ventured on that road,"},{"id":"manas-2010:p0497:b001:l013","ordinal":22682,"en":"Human corpses would remain."},{"id":"manas-2010:p0497:b001:l014","ordinal":22683,"en":"Those men who came to keep watch,"},{"id":"manas-2010:p0497:b001:l015","ordinal":22684,"en":"The hungry lions and wolves,"},{"id":"manas-2010:p0497:b001:l016","ordinal":22685,"en":"The fierce hunting tigers,"},{"id":"manas-2010:p0497:b001:l017","ordinal":22686,"en":"The sword-mouthed boars,"},{"id":"manas-2010:p0497:b001:l018","ordinal":22687,"en":"Would maul and strike and eat them."},{"id":"manas-2010:p0497:b001:l019","ordinal":22688,"en":"All the Chinese of Kakanchyn"},{"id":"manas-2010:p0497:b001:l020","ordinal":22689,"en":"Called it the Place of No Return."},{"id":"manas-2010:p0497:b001:l021","ordinal":22690,"en":"The narrow path where no bird flies,"},{"id":"manas-2010:p0497:b001:l022","ordinal":22691,"en":"Manas pursued them along it."},{"id":"manas-2010:p0497:b001:l023","ordinal":22692,"en":"Driving them through the crossings,"},{"id":"manas-2010:p0497:b001:l024","ordinal":22693,"en":"Driving them across the fords,"},{"id":"manas-2010:p0497:b001:l025","ordinal":22694,"en":"Those who remained after the dead,"},{"id":"manas-2010:p0497:b001:l026","ordinal":22695,"en":"He kept spearing clean through."},{"id":"manas-2010:p0497:b001:l027","ordinal":22696,"en":"Along the single-horse track,"},{"id":"manas-2010:p0497:b001:l028","ordinal":22697,"en":"The Chinese, hurrying and stumbling,"},{"id":"manas-2010:p0497:b001:l029","ordinal":22698,"en":"Passed to the farther side."},{"id":"manas-2010:p0497:b001:l030","ordinal":22699,"en":"When they reached the narrow gorge,"},{"id":"manas-2010:p0497:b001:l031","ordinal":22700,"en":"Then your dear elder Koshoy,"},{"id":"manas-2010:p0497:b001:l032","ordinal":22701,"en":"His roar splitting rocks,"},{"id":"manas-2010:p0497:b001:l033","ordinal":22702,"en":"His shout splitting heads,"},{"id":"manas-2010:p0497:b001:l034","ordinal":22703,"en":"His elder, aged Koshoy,"},{"id":"manas-2010:p0497:b001:l035","ordinal":22704,"en":"Had seized Manas,"},{"id":"manas-2010:p0497:b001:l036","ordinal":22705,"en":"All his giants and monsters too."},{"id":"manas-2010:p0497:b001:l037","ordinal":22706,"en":"Making him rage and struggle,"},{"id":"manas-2010:p0497:b001:l038","ordinal":22707,"en":"Aybanboz by the lead rope,"},{"id":"manas-2010:p0497:b001:l039","ordinal":22708,"en":"They seized, making him jerk."},{"id":"manas-2010:p0497:b001:l040","ordinal":22709,"en":"Jerking and wrenching himself free,"},{"id":"manas-2010:p0497:b001:l041","ordinal":22710,"en":"Manas shouted these words:"},{"id":"manas-2010:p0497:b001:l042","ordinal":22711,"en":"“Let go of my hand, Koshoy!"},{"id":"manas-2010:p0498:b001:l001","ordinal":22712,"en":"Do not block my path!"},{"id":"manas-2010:p0498:b001:l002","ordinal":22713,"en":"Do not bind my good fortune!"},{"id":"manas-2010:p0498:b001:l003","ordinal":22714,"en":"Kakanchyn's Beijing,"},{"id":"manas-2010:p0498:b001:l004","ordinal":22715,"en":"Today is my turn to slaughter it."},{"id":"manas-2010:p0498:b001:l005","ordinal":22716,"en":"Know the mood I am in!"},{"id":"manas-2010:p0498:b001:l006","ordinal":22717,"en":"These people of forty tribes—"},{"id":"manas-2010:p0498:b001:l007","ordinal":22718,"en":"This is the place where I shall fight."},{"id":"manas-2010:p0498:b001:l008","ordinal":22719,"en":"Of Beijing, so eager for strife,"},{"id":"manas-2010:p0498:b001:l009","ordinal":22720,"en":"Let me drive its wolf-men before me."},{"id":"manas-2010:p0498:b001:l010","ordinal":22721,"en":"Fighting long against the Chinese,"},{"id":"manas-2010:p0498:b001:l011","ordinal":22722,"en":"Let me grapple and spill their blood!"},{"id":"manas-2010:p0498:b001:l012","ordinal":22723,"en":"Against the oppressive Black Kalmyks,"},{"id":"manas-2010:p0498:b001:l013","ordinal":22724,"en":"Elder Koshoy, let me go,"},{"id":"manas-2010:p0498:b001:l014","ordinal":22725,"en":"Let me wage battle!"},{"id":"manas-2010:p0498:b001:l015","ordinal":22726,"en":"Look, Koshoy, hear my words."},{"id":"manas-2010:p0498:b001:l016","ordinal":22727,"en":"The Black Chinese and Manchus,"},{"id":"manas-2010:p0498:b001:l017","ordinal":22728,"en":"If I do not plunder their goods,"},{"id":"manas-2010:p0498:b001:l018","ordinal":22729,"en":"Wreaking havoc and firing shots,"},{"id":"manas-2010:p0498:b001:l019","ordinal":22730,"en":"If I do not cause great turmoil!"},{"id":"manas-2010:p0498:b001:l020","ordinal":22731,"en":"These Kalmyks so eager for strife,"},{"id":"manas-2010:p0498:b001:l021","ordinal":22732,"en":"If I do not seize and carry off their wealth,"},{"id":"manas-2010:p0498:b001:l022","ordinal":22733,"en":"If I do not scatter their silver coins and goods,"},{"id":"manas-2010:p0498:b001:l023","ordinal":22734,"en":"If I do not seize their people in the rear,"},{"id":"manas-2010:p0498:b001:l024","ordinal":22735,"en":"If I do not unleash boundless mischief!"},{"id":"manas-2010:p0498:b001:l025","ordinal":22736,"en":"Sending their many troops,"},{"id":"manas-2010:p0498:b001:l026","ordinal":22737,"en":"They have wished for sport like this."},{"id":"manas-2010:p0498:b001:l027","ordinal":22738,"en":"All the Manchus gathered,"},{"id":"manas-2010:p0498:b001:l028","ordinal":22739,"en":"And began this turmoil."},{"id":"manas-2010:p0498:b001:l029","ordinal":22740,"en":"They unleashed fierce wrath,"},{"id":"manas-2010:p0498:b001:l030","ordinal":22741,"en":"As though I had carried off their wealth,"},{"id":"manas-2010:p0498:b001:l031","ordinal":22742,"en":"Ruined their possessions,"},{"id":"manas-2010:p0498:b001:l032","ordinal":22743,"en":"And scattered their treasury."},{"id":"manas-2010:p0498:b001:l033","ordinal":22744,"en":"Their affliction has seized them;"},{"id":"manas-2010:p0498:b001:l034","ordinal":22745,"en":"Sparing no soul even when it begs,"},{"id":"manas-2010:p0498:b001:l035","ordinal":22746,"en":"The Black Kalmyks mass together"},{"id":"manas-2010:p0498:b001:l036","ordinal":22747,"en":"And put them to death."},{"id":"manas-2010:p0498:b001:l037","ordinal":22748,"en":"Those Kalmyks who lord it over us,"},{"id":"manas-2010:p0498:b001:l038","ordinal":22749,"en":"I shall press down upon their heads."},{"id":"manas-2010:p0498:b001:l039","ordinal":22750,"en":"Killing their lords,"},{"id":"manas-2010:p0498:b001:l040","ordinal":22751,"en":"Pursuing them as far as their khan,"},{"id":"manas-2010:p0498:b001:l041","ordinal":22752,"en":"Let me not stand watching, holding back."},{"id":"manas-2010:p0498:b001:l042","ordinal":22753,"en":"Let me seize their mighty men."},{"id":"manas-2010:p0499:b001:l001","ordinal":22754,"en":"Pursuing them as far as their khan,"},{"id":"manas-2010:p0499:b001:l002","ordinal":22755,"en":"Let me kill them without leaving one!"},{"id":"manas-2010:p0499:b001:l003","ordinal":22756,"en":"Let me open my road wide;"},{"id":"manas-2010:p0499:b001:l004","ordinal":22757,"en":"To the obstinate Black Kalmyks,"},{"id":"manas-2010:p0499:b001:l005","ordinal":22758,"en":"Let me show wonders!”"},{"id":"manas-2010:p0499:b001:l006","ordinal":22759,"en":"Manas shouted these words."},{"id":"manas-2010:p0499:b001:l007","ordinal":22760,"en":"In his wrath, the Kalmyks"},{"id":"manas-2010:p0499:b001:l008","ordinal":22761,"en":"He was driving before him."},{"id":"manas-2010:p0499:b001:l009","ordinal":22762,"en":"Making them cry out, spearing them,"},{"id":"manas-2010:p0499:b001:l010","ordinal":22763,"en":"He was slaughtering them!"},{"id":"manas-2010:p0499:b001:l011","ordinal":22764,"en":"When he saw this valor,"},{"id":"manas-2010:p0499:b001:l012","ordinal":22765,"en":"Of champion wolf-man Manas,"},{"id":"manas-2010:p0499:b001:l013","ordinal":22766,"en":"“Pursuing the Chinese,"},{"id":"manas-2010:p0499:b001:l014","ordinal":22767,"en":"He will bring them all to their end,” he thought,"},{"id":"manas-2010:p0499:b001:l015","ordinal":22768,"en":"“Meeting their countless armies,"},{"id":"manas-2010:p0499:b001:l016","ordinal":22769,"en":"That wolf-man, born an only son,"},{"id":"manas-2010:p0499:b001:l017","ordinal":22770,"en":"Will meet an untimely death,” he thought."},{"id":"manas-2010:p0499:b001:l018","ordinal":22771,"en":"Your elder Koshoy thought this;"},{"id":"manas-2010:p0499:b001:l019","ordinal":22772,"en":"Whipping his horse Kabylan,"},{"id":"manas-2010:p0499:b001:l020","ordinal":22773,"en":"Your elder khan, aged Koshoy,"},{"id":"manas-2010:p0499:b001:l021","ordinal":22774,"en":"That wisest of saints,"},{"id":"manas-2010:p0499:b001:l022","ordinal":22775,"en":"Charged up to Manas,"},{"id":"manas-2010:p0499:b001:l023","ordinal":22776,"en":"And seized the horse by its bit."},{"id":"manas-2010:p0499:b001:l024","ordinal":22777,"en":"Making him rage and struggle,"},{"id":"manas-2010:p0499:b001:l025","ordinal":22778,"en":"Making Khan Manas jerk,"},{"id":"manas-2010:p0499:b001:l026","ordinal":22779,"en":"Khan Koshoy held him fast."},{"id":"manas-2010:p0499:b001:l027","ordinal":22780,"en":"“Wolf-man Manas, heed my words."},{"id":"manas-2010:p0499:b001:l028","ordinal":22781,"en":"This is what I say; understand!"},{"id":"manas-2010:p0499:b001:l029","ordinal":22782,"en":"The seething Black Chinese people,"},{"id":"manas-2010:p0499:b001:l030","ordinal":22783,"en":"Never turning back from drinking blood,"},{"id":"manas-2010:p0499:b001:l031","ordinal":22784,"en":"A stubborn people unaware of death."}]
