{"id": "sayakbay-ms-current146:pdf087:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 87, "folio": 470, "line_in_page": 16, "raw": "Албан-албан жер басып,", "text": "Албан-албан жер басып,", "en": "Crossing land after land,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf087:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 87, "folio": 470, "line_in_page": 17, "raw": "Аккан дайра суу кечип,", "text": "Аккан дайра суу кечип,", "en": "Fording the waters of flowing rivers,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
