[{"id":"semetey-1-2013:p0590:b003:l005","ordinal":122113,"en":"When he stretches out his five hands,"},{"id":"semetey-1-2013:p0590:b003:l006","ordinal":122114,"en":"God Most High, who created him, commands,"},{"id":"semetey-1-2013:p0590:b003:l007","ordinal":122115,"en":"‘Take the mortal's soul,’"},{"id":"semetey-1-2013:p0590:b003:l008","ordinal":122116,"en":"When He gives His firm command,"},{"id":"semetey-1-2013:p0590:b003:l009","ordinal":122117,"en":"Man's speaking tongue is bound."},{"id":"semetey-1-2013:p0590:b003:l010","ordinal":122118,"en":"From this deceitful world,"},{"id":"semetey-1-2013:p0590:b003:l011","ordinal":122119,"en":"When the Almighty commands,"},{"id":"semetey-1-2013:p0590:b003:l012","ordinal":122120,"en":"What soul can flee and escape?"},{"id":"semetey-1-2013:p0590:b003:l013","ordinal":122121,"en":"Will the dug grave not take us in,"},{"id":"semetey-1-2013:p0590:b003:l014","ordinal":122122,"en":"The eighteen thousand worlds"},{"id":"semetey-1-2013:p0590:b003:l015","ordinal":122123,"en":"The dark earth that obliterates?"},{"id":"semetey-1-2013:p0590:b003:l016","ordinal":122124,"en":"Father, you are a worthless man,"},{"id":"semetey-1-2013:p0590:b003:l017","ordinal":122125,"en":"Without reason you think yourself so capable;"},{"id":"semetey-1-2013:p0590:b003:l018","ordinal":122126,"en":"You are a good-for-nothing man!”"},{"id":"semetey-1-2013:p0590:b003:l019","ordinal":122127,"en":"His father Ismail,"},{"id":"semetey-1-2013:p0590:b003:l020","ordinal":122128,"en":"Saying this, Semetey"},{"id":"semetey-1-2013:p0590:b003:l021","ordinal":122129,"en":"Struck him squarely on the cheek,"},{"id":"semetey-1-2013:p0590:b003:l022","ordinal":122130,"en":"Pushed him off to the side."},{"id":"semetey-1-2013:p0590:b003:l023","ordinal":122131,"en":"Tumbling like a feedbag,"},{"id":"semetey-1-2013:p0590:b003:l024","ordinal":122132,"en":"Ismail fell."},{"id":"semetey-1-2013:p0590:b003:l025","ordinal":122133,"en":"Struck by the back of his hand,"},{"id":"semetey-1-2013:p0590:b003:l026","ordinal":122134,"en":"Ismail sprawled on the ground."},{"id":"semetey-1-2013:p0590:b003:l027","ordinal":122135,"en":"Without sorrow the boy shouted,"},{"id":"semetey-1-2013:p0590:b003:l028","ordinal":122136,"en":"Calling Camel Wrestler."},{"id":"semetey-1-2013:p0590:b003:l029","ordinal":122137,"en":"At the sight of Camel Wrestler,"},{"id":"semetey-1-2013:p0590:b003:l030","ordinal":122138,"en":"His whole body bristled."},{"id":"semetey-1-2013:p0590:b003:l031","ordinal":122139,"en":"Camel Wrestler stood ready,"},{"id":"semetey-1-2013:p0590:b003:l032","ordinal":122140,"en":"Roaring like a lion."},{"id":"semetey-1-2013:p0590:b003:l033","ordinal":122141,"en":"To the wrestler who had braced himself,"},{"id":"semetey-1-2013:p0590:b003:l034","ordinal":122142,"en":"Your orphan, Manas's son,"},{"id":"semetey-1-2013:p0590:b003:l035","ordinal":122143,"en":"Came close."},{"id":"semetey-1-2013:p0590:b003:l036","ordinal":122144,"en":"“Your father's grave, Camel Wrestler!"},{"id":"semetey-1-2013:p0590:b003:l037","ordinal":122145,"en":"Make your promise firm;"},{"id":"semetey-1-2013:p0590:b003:l038","ordinal":122146,"en":"Swear an oath binding unto death!"},{"id":"semetey-1-2013:p0590:b003:l039","ordinal":122147,"en":"My wrestler, if I fall, I shall give"},{"id":"semetey-1-2013:p0590:b004:l001","ordinal":122148,"en":"The golden crown I wear,"},{"id":"semetey-1-2013:p0590:b004:l002","ordinal":122149,"en":"The golden throne I sit upon."},{"id":"semetey-1-2013:p0590:b004:l003","ordinal":122150,"en":"I have staked them all, Camel Wrestler."},{"id":"semetey-1-2013:p0590:b004:l004","ordinal":122151,"en":"If you throw me and win,"},{"id":"semetey-1-2013:p0590:b004:l005","ordinal":122152,"en":"This Bukhara with its city,"},{"id":"semetey-1-2013:p0590:b004:l006","ordinal":122153,"en":"My grain-growing lands,"},{"id":"semetey-1-2013:p0590:b004:l007","ordinal":122154,"en":"I have staked them too, Camel Wrestler,"},{"id":"semetey-1-2013:p0590:b004:l008","ordinal":122155,"en":"My hoe-working Tajik people."},{"id":"semetey-1-2013:p0590:b004:l009","ordinal":122156,"en":"If I fall, I shall give my golden throne."},{"id":"semetey-1-2013:p0590:b004:l011","ordinal":122157,"en":"If you fall, Camel Wrestler,"},{"id":"semetey-1-2013:p0590:b004:l012","ordinal":122158,"en":"Will you stake your blood?"},{"id":"semetey-1-2013:p0590:b004:l013","ordinal":122159,"en":"I have staked my city of Bukhara;"},{"id":"semetey-1-2013:p0590:b004:l014","ordinal":122160,"en":"Will you stake your life?"},{"id":"semetey-1-2013:p0590:b004:l015","ordinal":122161,"en":"If I throw you and win,"},{"id":"semetey-1-2013:p0590:b004:l016","ordinal":122162,"en":"I shall send word to my people;"},{"id":"semetey-1-2013:p0590:b004:l017","ordinal":122163,"en":"Without letting you utter another excuse,"},{"id":"semetey-1-2013:p0590:b004:l018","ordinal":122164,"en":"I shall tear off your head."},{"id":"semetey-1-2013:p0590:b004:l019","ordinal":122165,"en":"If you throw me and win,"},{"id":"semetey-1-2013:p0590:b004:l020","ordinal":122166,"en":"I shall send word to my people;"},{"id":"semetey-1-2013:p0590:b004:l021","ordinal":122167,"en":"Here in this Bukhara,"},{"id":"semetey-1-2013:p0590:b004:l022","ordinal":122168,"en":"Placing my golden crown upon you,"},{"id":"semetey-1-2013:p0590:b004:l023","ordinal":122169,"en":"Seating you upon the golden throne,"},{"id":"semetey-1-2013:p0590:b004:l024","ordinal":122170,"en":"I shall raise you as khan.”"},{"id":"semetey-1-2013:p0590:b004:l025","ordinal":122171,"en":"After he had said this,"},{"id":"semetey-1-2013:p0590:b004:l026","ordinal":122172,"en":"Proud of having thrown his opponent,"},{"id":"semetey-1-2013:p0590:b004:l027","ordinal":122173,"en":"Camel Wrestler came forward smoothly."},{"id":"semetey-1-2013:p0590:b004:l028","ordinal":122174,"en":"“Agreed, agreed, agreed!"},{"id":"semetey-1-2013:p0590:b004:l029","ordinal":122175,"en":"Agreed, good, hero!” he said,"},{"id":"semetey-1-2013:p0590:b004:l030","ordinal":122176,"en":"Bracing himself in anger,"},{"id":"semetey-1-2013:p0590:b004:l031","ordinal":122177,"en":"And charged at the boy."},{"id":"semetey-1-2013:p0590:b004:l032","ordinal":122178,"en":"“Your father's grave, Camel Wrestler!"},{"id":"semetey-1-2013:p0590:b004:l033","ordinal":122179,"en":"Take whatever hold you like, wrestler;"},{"id":"semetey-1-2013:p0590:b004:l034","ordinal":122180,"en":"Bring your great strength to bear, wrestler."},{"id":"semetey-1-2013:p0590:b004:l035","ordinal":122181,"en":"If you hold back, take your own mother, wrestler!"},{"id":"semetey-1-2013:p0590:b004:l036","ordinal":122182,"en":"Bring your utmost strength, wrestler;"},{"id":"semetey-1-2013:p0590:b004:l037","ordinal":122183,"en":"Leave yourself no regret, wrestler!"},{"id":"semetey-1-2013:p0590:b004:l038","ordinal":122184,"en":"One of the seven days is death;"},{"id":"semetey-1-2013:p0590:b004:l039","ordinal":122185,"en":"When we both die,"},{"id":"semetey-1-2013:p0591:b003:l001","ordinal":122186,"en":"My wrestler, when you see the face of the other world,"},{"id":"semetey-1-2013:p0591:b003:l002","ordinal":122187,"en":"On the night of intercession,"},{"id":"semetey-1-2013:p0591:b003:l003","ordinal":122188,"en":"On the day of the Last Judgment,"},{"id":"semetey-1-2013:p0591:b003:l004","ordinal":122189,"en":"Lest things go badly, my wrestler,"},{"id":"semetey-1-2013:p0591:b003:l005","ordinal":122190,"en":"May God not strike you down!"},{"id":"semetey-1-2013:p0591:b003:l006","ordinal":122191,"en":"Seizing me by the collar in that straitened place,"},{"id":"semetey-1-2013:p0591:b003:l007","ordinal":122192,"en":"Do not demand payment for your blood."},{"id":"semetey-1-2013:p0591:b003:l008","ordinal":122193,"en":"When you go to the other world,"},{"id":"semetey-1-2013:p0591:b003:l009","ordinal":122194,"en":"Do not say, ‘He used his prowess;"},{"id":"semetey-1-2013:p0591:b003:l010","ordinal":122195,"en":"That child was too much for me."},{"id":"semetey-1-2013:p0591:b003:l011","ordinal":122196,"en":"He used his lion's might.’"},{"id":"semetey-1-2013:p0591:b003:l012","ordinal":122197,"en":"‘Semetey was strong,"},{"id":"semetey-1-2013:p0591:b003:l013","ordinal":122198,"en":"He resorted to strength,’ do not say."},{"id":"semetey-1-2013:p0591:b003:l014","ordinal":122199,"en":"Take whatever hold you like, wrestler;"},{"id":"semetey-1-2013:p0591:b003:l015","ordinal":122200,"en":"Trip me however you like, wrestler!”"},{"id":"semetey-1-2013:p0591:b003:l016","ordinal":122201,"en":"Saying this, Semetey"},{"id":"semetey-1-2013:p0591:b003:l017","ordinal":122202,"en":"Stood ready for the wrestler."},{"id":"semetey-1-2013:p0591:b003:l018","ordinal":122203,"en":"The wrestler saw him standing there,"},{"id":"semetey-1-2013:p0591:b003:l019","ordinal":122204,"en":"His knees bent toward the ground,"},{"id":"semetey-1-2013:p0591:b003:l020","ordinal":122205,"en":"Running in anger,"},{"id":"semetey-1-2013:p0591:b003:l021","ordinal":122206,"en":"Camel Wrestler reached him."},{"id":"semetey-1-2013:p0591:b003:l022","ordinal":122207,"en":"Camel Wrestler's prowess"},{"id":"semetey-1-2013:p0591:b003:l023","ordinal":122208,"en":"The orphan Semetey now saw."},{"id":"semetey-1-2013:p0591:b003:l024","ordinal":122209,"en":"To the furious wrestler"},{"id":"semetey-1-2013:p0591:b003:l025","ordinal":122210,"en":"Semetey held out his forearm."},{"id":"semetey-1-2013:p0591:b003:l026","ordinal":122211,"en":"The wrestler seized his forearm,"},{"id":"semetey-1-2013:p0591:b003:l027","ordinal":122212,"en":"Applied all his strength."},{"id":"semetey-1-2013:p0591:b003:l028","ordinal":122213,"en":"As the wrestler gripped him,"},{"id":"semetey-1-2013:p0591:b003:l029","ordinal":122214,"en":"He hummed disdainfully, paying no heed."},{"id":"semetey-1-2013:p0591:b003:l030","ordinal":122215,"en":"That wrestler's grip"},{"id":"semetey-1-2013:p0591:b003:l031","ordinal":122216,"en":"Semetey valued less than a scrap of hide."},{"id":"semetey-1-2013:p0591:b003:l032","ordinal":122217,"en":"The boy paid no heed to death."},{"id":"semetey-1-2013:p0591:b003:l033","ordinal":122218,"en":"Semetey grew angry,"},{"id":"semetey-1-2013:p0591:b003:l034","ordinal":122219,"en":"Exerted his strength fiercely,"},{"id":"semetey-1-2013:p0591:b003:l035","ordinal":122220,"en":"From Camel Wrestler's hand"},{"id":"semetey-1-2013:p0591:b003:l036","ordinal":122221,"en":"The lord's son, the lone hero,"},{"id":"semetey-1-2013:p0591:b003:l037","ordinal":122222,"en":"Drew out his forearm."},{"id":"semetey-1-2013:p0591:b003:l038","ordinal":122223,"en":"Now Camel Wrestler extended his forearm."},{"id":"semetey-1-2013:p0591:b003:l039","ordinal":122224,"en":"Then we saw, people,"},{"id":"semetey-1-2013:p0591:b004:l001","ordinal":122225,"en":"The terror Semetey could bring."},{"id":"semetey-1-2013:p0591:b004:l002","ordinal":122226,"en":"With a slap, he seized"},{"id":"semetey-1-2013:p0591:b004:l003","ordinal":122227,"en":"Camel Wrestler's forearm."},{"id":"semetey-1-2013:p0591:b004:l004","ordinal":122228,"en":"Trying to pull, he could not pull free;"},{"id":"semetey-1-2013:p0591:b004:l005","ordinal":122229,"en":"Camel Wrestler fidgeted."},{"id":"semetey-1-2013:p0591:b004:l006","ordinal":122230,"en":"Trying to wrench away, he could not;"},{"id":"semetey-1-2013:p0591:b004:l007","ordinal":122231,"en":"Camel Wrestler squirmed."},{"id":"semetey-1-2013:p0591:b004:l008","ordinal":122232,"en":"He tightened his grip again;"},{"id":"semetey-1-2013:p0591:b004:l009","ordinal":122233,"en":"Camel Wrestler began to shuffle."},{"id":"semetey-1-2013:p0591:b004:l010","ordinal":122234,"en":"“Ah, mercy! Ah!” he cried."},{"id":"semetey-1-2013:p0591:b004:l011","ordinal":122235,"en":"“We submit to you as slaves!” he said,"},{"id":"semetey-1-2013:p0591:b004:l012","ordinal":122236,"en":"Cowering before Semetey."},{"id":"semetey-1-2013:p0591:b004:l013","ordinal":122237,"en":"From the tips of his five fingers—"},{"id":"semetey-1-2013:p0591:b004:l014","ordinal":122238,"en":"Did you see his might?—"},{"id":"semetey-1-2013:p0591:b004:l015","ordinal":122239,"en":"Dark blood, enough for a mare's milking,"},{"id":"semetey-1-2013:p0591:b004:l016","ordinal":122240,"en":"Spurted and streamed."},{"id":"semetey-1-2013:p0591:b004:l017","ordinal":122241,"en":"“And you called yourself a wrestler!”"},{"id":"semetey-1-2013:p0591:b004:l018","ordinal":122242,"en":"The descendant of the blood-drinker"},{"id":"semetey-1-2013:p0591:b004:l019","ordinal":122243,"en":"Seized him again,"},{"id":"semetey-1-2013:p0591:b004:l020","ordinal":122244,"en":"Five times harder than before,"},{"id":"semetey-1-2013:p0591:b004:l021","ordinal":122245,"en":"Gripped him with greater force."},{"id":"semetey-1-2013:p0591:b004:l022","ordinal":122246,"en":"Poor Camel Wrestler's"},{"id":"semetey-1-2013:p0591:b004:l023","ordinal":122247,"en":"Teeth began to grind."},{"id":"semetey-1-2013:p0591:b004:l024","ordinal":122248,"en":"One of Camel Wrestler's arms,"},{"id":"semetey-1-2013:p0591:b004:l025","ordinal":122249,"en":"Like a rotten reed,"},{"id":"semetey-1-2013:p0591:b004:l026","ordinal":122250,"en":"Broke to pieces with a crack."},{"id":"semetey-1-2013:p0591:b004:l027","ordinal":122251,"en":"Camel Wrestler lost his strength."},{"id":"semetey-1-2013:p0591:b004:l028","ordinal":122252,"en":"The famed sacred capital of sheikhs,"},{"id":"semetey-1-2013:p0591:b004:l029","ordinal":122253,"en":"Populous Kokand and Margilan,"},{"id":"semetey-1-2013:p0591:b004:l030","ordinal":122254,"en":"Below them, Andijan,"},{"id":"semetey-1-2013:p0591:b004:l031","ordinal":122255,"en":"The people of four khans gathered."},{"id":"semetey-1-2013:p0591:b004:l032","ordinal":122256,"en":"Before they could bring gifts,"},{"id":"semetey-1-2013:p0591:b004:l033","ordinal":122257,"en":"Before they could somehow"},{"id":"semetey-1-2013:p0591:b004:l034","ordinal":122258,"en":"Plead for the wrestler's blood,"},{"id":"semetey-1-2013:p0591:b004:l035","ordinal":122259,"en":"Before they could intervene,"},{"id":"semetey-1-2013:p0591:b004:l036","ordinal":122260,"en":"Your boy now found his chance."},{"id":"semetey-1-2013:p0591:b004:l037","ordinal":122261,"en":"Lifting him like a feedbag,"},{"id":"semetey-1-2013:p0591:b004:l038","ordinal":122262,"en":"Poor Camel Wrestler"},{"id":"semetey-1-2013:p0591:b004:l039","ordinal":122263,"en":"He dashed to the earth."},{"id":"semetey-1-2013:p0592:b003:l001","ordinal":122264,"en":"Not letting the wrestler stir,"},{"id":"semetey-1-2013:p0592:b003:l002","ordinal":122265,"en":"He pressed down upon his belly."},{"id":"semetey-1-2013:p0592:b003:l003","ordinal":122266,"en":"The orphan began his terrible deed;"},{"id":"semetey-1-2013:p0592:b003:l004","ordinal":122267,"en":"One of Camel Wrestler's arms"},{"id":"semetey-1-2013:p0592:b003:l005","ordinal":122268,"en":"He tore clean out."},{"id":"semetey-1-2013:p0592:b003:l006","ordinal":122269,"en":"Then poor Camel Wrestler died."},{"id":"semetey-1-2013:p0592:b003:l007","ordinal":122270,"en":"Semetey's prowess"},{"id":"semetey-1-2013:p0592:b003:l008","ordinal":122271,"en":"The eight khans observed."},{"id":"semetey-1-2013:p0592:b003:l009","ordinal":122272,"en":"What could the eight poor khans do?"},{"id":"semetey-1-2013:p0592:b003:l010","ordinal":122273,"en":"They ran up and down."},{"id":"semetey-1-2013:p0592:b003:l011","ordinal":122274,"en":"“He truly takes after his father!” they said;"},{"id":"semetey-1-2013:p0592:b003:l012","ordinal":122275,"en":"The eight khans despaired of their lives."},{"id":"semetey-1-2013:p0592:b003:l013","ordinal":122276,"en":"Then the orphan came to maturity;"},{"id":"semetey-1-2013:p0592:b003:l014","ordinal":122277,"en":"Thus he joined the ranks."},{"id":"semetey-1-2013:p0592:b003:l015","ordinal":122278,"en":"He grew to manhood and became a hero;"},{"id":"semetey-1-2013:p0592:b003:l016","ordinal":122279,"en":"Your boy became the equal of a hero's son."},{"id":"semetey-1-2013:p0592:b003:l017","ordinal":122280,"en":"Cursed be his becoming a hero!"},{"id":"semetey-1-2013:p0592:b003:l018","ordinal":122281,"en":"Now his affairs have gone badly."},{"id":"semetey-1-2013:p0592:b003:l019","ordinal":122282,"en":"Let me not tell it, let you not hear it, brother-in-law!"},{"id":"semetey-1-2013:p0592:b003:l020","ordinal":122283,"en":"Give thanks to God;"},{"id":"semetey-1-2013:p0592:b003:l021","ordinal":122284,"en":"Now be content with God, brother-in-law!"},{"id":"semetey-1-2013:p0592:b003:l022","ordinal":122285,"en":"Who bears it, who does not,"},{"id":"semetey-1-2013:p0592:b003:l023","ordinal":122286,"en":"What the Creator lays upon one's head?"},{"id":"semetey-1-2013:p0592:b003:l024","ordinal":122287,"en":"Let us recite the Quran"},{"id":"semetey-1-2013:p0592:b003:l025","ordinal":122288,"en":"For your boy who has passed away, dear brother-in-law."},{"id":"semetey-1-2013:p0592:b003:l026","ordinal":122289,"en":"Between the dead and the living,"},{"id":"semetey-1-2013:p0592:b003:l027","ordinal":122290,"en":"Brother-in-law, the Quran alone goes between."},{"id":"semetey-1-2013:p0592:b003:l028","ordinal":122291,"en":"What twelve ages had never wrought,"},{"id":"semetey-1-2013:p0592:b003:l029","ordinal":122292,"en":"At the great feast in Bukhara,"},{"id":"semetey-1-2013:p0592:b003:l030","ordinal":122293,"en":"No one remained to turn a catching pole against your boy."},{"id":"semetey-1-2013:p0592:b003:l031","ordinal":122294,"en":"Alas, such is this shitty world!"},{"id":"semetey-1-2013:p0592:b003:l032","ordinal":122295,"en":"He emerged a lion protected by Shai,"},{"id":"semetey-1-2013:p0592:b003:l033","ordinal":122296,"en":"His twelve bodily members sound,"},{"id":"semetey-1-2013:p0592:b003:l034","ordinal":122297,"en":"Of Manas who passed away,"},{"id":"semetey-1-2013:p0592:b003:l035","ordinal":122298,"en":"He emerged a hero equal to the man himself."},{"id":"semetey-1-2013:p0592:b003:l036","ordinal":122299,"en":"The eight khans ate at his feast."},{"id":"semetey-1-2013:p0592:b003:l037","ordinal":122300,"en":"“If this child lives,"},{"id":"semetey-1-2013:p0592:b003:l038","ordinal":122301,"en":"He will overturn the world,” they said."},{"id":"semetey-1-2013:p0592:b003:l039","ordinal":122302,"en":"When he threw Camel Wrestler,"},{"id":"semetey-1-2013:p0592:b003:l040","ordinal":122303,"en":"When he tore out one of his arms,"},{"id":"semetey-1-2013:p0592:b004:l001","ordinal":122304,"en":"Had someone's tongue struck the boy?"},{"id":"semetey-1-2013:p0592:b004:l002","ordinal":122305,"en":"Had someone's evil eye struck him?"},{"id":"semetey-1-2013:p0592:b004:l003","ordinal":122306,"en":"Your boy was stricken in the ribs,"},{"id":"semetey-1-2013:p0592:b004:l004","ordinal":122307,"en":"Your only son felt it at the crown of his head."},{"id":"semetey-1-2013:p0592:b004:l005","ordinal":122308,"en":"A sickness no one could discover struck him;"},{"id":"semetey-1-2013:p0592:b004:l006","ordinal":122309,"en":"He met with a true pestilence."},{"id":"semetey-1-2013:p0592:b004:l007","ordinal":122310,"en":"His cup-like liver was crushed,"},{"id":"semetey-1-2013:p0592:b004:l008","ordinal":122311,"en":"Blood came from his mouth."},{"id":"semetey-1-2013:p0592:b004:l009","ordinal":122312,"en":"No resourceful healer could be found;"},{"id":"semetey-1-2013:p0592:b004:l010","ordinal":122313,"en":"No remedy at all was found for your boy."},{"id":"semetey-1-2013:p0592:b004:l011","ordinal":122314,"en":"He has seen the face of eternity;"},{"id":"semetey-1-2013:p0592:b004:l012","ordinal":122315,"en":"Your only son died seven days ago!"},{"id":"semetey-1-2013:p0592:b004:l013","ordinal":122316,"en":"Then the God who strikes down"},{"id":"semetey-1-2013:p0592:b004:l014","ordinal":122317,"en":"Struck him utterly, so I heard."},{"id":"semetey-1-2013:p0592:b004:l015","ordinal":122318,"en":"‘My little camel calf!’ sobbing,"},{"id":"semetey-1-2013:p0592:b004:l016","ordinal":122319,"en":"Burning with grief, weeping and crying,"},{"id":"semetey-1-2013:p0592:b004:l017","ordinal":122320,"en":"His own beard, Temir Khan,"},{"id":"semetey-1-2013:p0592:b004:l018","ordinal":122321,"en":"Poor man, tore it out, so I heard."},{"id":"semetey-1-2013:p0592:b004:l019","ordinal":122322,"en":"‘I will not outlive my only one,’ she said;"},{"id":"semetey-1-2013:p0592:b004:l020","ordinal":122323,"en":"His grandmother Chiyyrdy,"},{"id":"semetey-1-2013:p0592:b004:l021","ordinal":122324,"en":"An old woman of ninety-five,"},{"id":"semetey-1-2013:p0592:b004:l022","ordinal":122325,"en":"Fell upon a knife and wounded herself,"},{"id":"semetey-1-2013:p0592:b004:l023","ordinal":122326,"en":"And died, so I heard."},{"id":"semetey-1-2013:p0592:b004:l024","ordinal":122327,"en":"His own father Ismail"},{"id":"semetey-1-2013:p0592:b004:l025","ordinal":122328,"en":"Smashed his own head,"},{"id":"semetey-1-2013:p0592:b004:l026","ordinal":122329,"en":"Struck himself, so I heard."},{"id":"semetey-1-2013:p0592:b004:l027","ordinal":122330,"en":"That grieving woman Kanykei,"},{"id":"semetey-1-2013:p0592:b004:l028","ordinal":122331,"en":"‘My only one, whom I mourn, has died!’ she said,"},{"id":"semetey-1-2013:p0592:b004:l029","ordinal":122332,"en":"Striking both her cheeks,"},{"id":"semetey-1-2013:p0592:b004:l030","ordinal":122333,"en":"Tore at them, so I heard."},{"id":"semetey-1-2013:p0592:b004:l031","ordinal":122334,"en":"Her unmerciful, wretched life"},{"id":"semetey-1-2013:p0592:b004:l032","ordinal":122335,"en":"She tormented, so I heard."},{"id":"semetey-1-2013:p0592:b004:l033","ordinal":122336,"en":"The eight khans who came to the feast,"},{"id":"semetey-1-2013:p0592:b004:l034","ordinal":122337,"en":"All eight khans,"},{"id":"semetey-1-2013:p0592:b004:l035","ordinal":122338,"en":"‘Now Manas is truly dead!’ they said,"},{"id":"semetey-1-2013:p0592:b004:l036","ordinal":122339,"en":"And left weeping, so I heard."},{"id":"semetey-1-2013:p0592:b004:l037","ordinal":122340,"en":"Now be content with God;"},{"id":"semetey-1-2013:p0592:b004:l038","ordinal":122341,"en":"Brother-in-law, give thanks to God."},{"id":"semetey-1-2013:p0593:b003:l001","ordinal":122342,"en":"“Brother-in-law, your Talas has been left deserted;"},{"id":"semetey-1-2013:p0593:b003:l002","ordinal":122343,"en":"Thus your Manas has gone without an heir!”"},{"id":"semetey-1-2013:p0593:b003:l003","ordinal":122344,"en":"Without speaking a word, without uttering a sound,"},{"id":"semetey-1-2013:p0593:b003:l004","ordinal":122345,"en":"When he heard this news,"},{"id":"semetey-1-2013:p0593:b003:l005","ordinal":122346,"en":"Khan Bakai lost his voice."},{"id":"semetey-1-2013:p0593:b003:l006","ordinal":122347,"en":"His two eyes staring wildly,"},{"id":"semetey-1-2013:p0593:b003:l007","ordinal":122348,"en":"Khan Bakai lost his speech."},{"id":"semetey-1-2013:p0593:b003:l008","ordinal":122349,"en":"After the time it takes to cook meat, he began to speak,"},{"id":"semetey-1-2013:p0593:b003:l009","ordinal":122350,"en":"Speaking softly but firmly:"},{"id":"semetey-1-2013:p0593:b003:l010","ordinal":122351,"en":"“Valley upon valley, little valley, my child,"},{"id":"semetey-1-2013:p0593:b003:l011","ordinal":122352,"en":"Settle in a little valley, my child."},{"id":"semetey-1-2013:p0593:b003:l012","ordinal":122353,"en":"Bereft of the one who loves you,"},{"id":"semetey-1-2013:p0593:b003:l013","ordinal":122354,"en":"Become like me yourself, my child!"},{"id":"semetey-1-2013:p0593:b003:l014","ordinal":122355,"en":"Your dark mouth filled with blood,"},{"id":"semetey-1-2013:p0593:b003:l015","ordinal":122356,"en":"My child, come to a day beyond return!"},{"id":"semetey-1-2013:p0593:b003:l016","ordinal":122357,"en":"May God cool your breath;"},{"id":"semetey-1-2013:p0593:b003:l017","ordinal":122358,"en":"Become like that Semetey yourself!"},{"id":"semetey-1-2013:p0593:b003:l018","ordinal":122359,"en":"My child, settle along a barren pass;"},{"id":"semetey-1-2013:p0593:b003:l019","ordinal":122360,"en":"May God cool your breath,"},{"id":"semetey-1-2013:p0593:b003:l020","ordinal":122361,"en":"Bereft of the one who loves you,"},{"id":"semetey-1-2013:p0593:b003:l021","ordinal":122362,"en":"My child, become like me yourself!”"},{"id":"semetey-1-2013:p0593:b003:l022","ordinal":122363,"en":"Khan Bakai uttered his curse,"},{"id":"semetey-1-2013:p0593:b003:l023","ordinal":122364,"en":"Now spoke words of desolation."},{"id":"semetey-1-2013:p0593:b003:l024","ordinal":122365,"en":"Making the dark earth weep,"},{"id":"semetey-1-2013:p0593:b003:l025","ordinal":122366,"en":"Bakai began to lament his only one:"},{"id":"semetey-1-2013:p0593:b003:l026","ordinal":122367,"en":"“My spring that feeds a flowing river,"},{"id":"semetey-1-2013:p0593:b003:l027","ordinal":122368,"en":"My lamp, gained through mortal hardship!"}]
