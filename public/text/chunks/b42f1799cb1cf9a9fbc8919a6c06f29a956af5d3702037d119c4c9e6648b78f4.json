[{"id":"semetey-1-2013:p1214:b003:l010","ordinal":169729,"en":"Was racing with all his longing."},{"id":"semetey-1-2013:p1214:b003:l011","ordinal":169730,"en":"Whipping Maaniker,"},{"id":"semetey-1-2013:p1214:b003:l012","ordinal":169731,"en":"Young Aidar raised the cheering cry."},{"id":"semetey-1-2013:p1214:b003:l013","ordinal":169732,"en":"The stones beneath his tread burst apart;"},{"id":"semetey-1-2013:p1214:b003:l014","ordinal":169733,"en":"Kulatai and Maaniker"},{"id":"semetey-1-2013:p1214:b003:l015","ordinal":169734,"en":"Ran side by side with a roar,"},{"id":"semetey-1-2013:p1214:b003:l016","ordinal":169735,"en":"The earth circling in a mirage,"},{"id":"semetey-1-2013:p1214:b003:l017","ordinal":169736,"en":"Drawing close to Achbuudan."},{"id":"semetey-1-2013:p1214:b003:l018","ordinal":169737,"en":"Splitting the dense host in two,"},{"id":"semetey-1-2013:p1214:b003:l019","ordinal":169738,"en":"Kulatai came charging in,"},{"id":"semetey-1-2013:p1214:b003:l020","ordinal":169739,"en":"Nearly moving to the front."},{"id":"semetey-1-2013:p1214:b003:l021","ordinal":169740,"en":"Day had gone and night was ending;"},{"id":"semetey-1-2013:p1214:b003:l022","ordinal":169741,"en":"The boy riding the kulan"},{"id":"semetey-1-2013:p1214:b003:l023","ordinal":169742,"en":"Found a marvelous tongue:"},{"id":"semetey-1-2013:p1214:b003:l024","ordinal":169743,"en":"“Do not cheer me, Aidar, do not cheer;"},{"id":"semetey-1-2013:p1214:b003:l025","ordinal":169744,"en":"If I fall, will my teeth not break?"},{"id":"semetey-1-2013:p1214:b003:l026","ordinal":169745,"en":"If I die, will God not strike me!"},{"id":"semetey-1-2013:p1214:b003:l027","ordinal":169746,"en":"A colt light as tumbleweed—"},{"id":"semetey-1-2013:p1214:b003:l028","ordinal":169747,"en":"Will it not fly off wildly?"},{"id":"semetey-1-2013:p1214:b003:l029","ordinal":169748,"en":"If I tumble to the ground,"},{"id":"semetey-1-2013:p1214:b003:l030","ordinal":169749,"en":"Will my death not truly arrive?"},{"id":"semetey-1-2013:p1214:b003:l031","ordinal":169750,"en":"Will my bones not shatter small?"},{"id":"semetey-1-2013:p1214:b003:l032","ordinal":169751,"en":"Will my tormented life not end?"},{"id":"semetey-1-2013:p1214:b003:l033","ordinal":169752,"en":"He raced the colt and won a prize;"},{"id":"semetey-1-2013:p1214:b003:l034","ordinal":169753,"en":"God did not strike Kenei."},{"id":"semetey-1-2013:p1214:b003:l035","ordinal":169754,"en":"Let him race it when full-grown,"},{"id":"semetey-1-2013:p1214:b003:l036","ordinal":169755,"en":"And win the prize here then."},{"id":"semetey-1-2013:p1214:b003:l037","ordinal":169756,"en":"Instead of prize meat, eat your fat;"},{"id":"semetey-1-2013:p1214:b003:l038","ordinal":169757,"en":"Eat the blood of your mother."},{"id":"semetey-1-2013:p1214:b003:l039","ordinal":169758,"en":"Eat the age of prizes that has passed;"},{"id":"semetey-1-2013:p1214:b004:l001","ordinal":169759,"en":"Eat the liver of your seven forefathers."},{"id":"semetey-1-2013:p1214:b004:l002","ordinal":169760,"en":"What shameless man races a colt"},{"id":"semetey-1-2013:p1214:b004:l003","ordinal":169761,"en":"Alongside grown horses?"},{"id":"semetey-1-2013:p1214:b004:l004","ordinal":169762,"en":"Do not cheer, Aidar, do not cheer;"},{"id":"semetey-1-2013:p1214:b004:l005","ordinal":169763,"en":"Will not our strength fail,"},{"id":"semetey-1-2013:p1214:b004:l006","ordinal":169764,"en":"Will not our blood be spilled?”"},{"id":"semetey-1-2013:p1214:b004:l007","ordinal":169765,"en":"Hero Zholoi’s Achbuudan—"},{"id":"semetey-1-2013:p1214:b004:l008","ordinal":169766,"en":"The many Chinese standing tall"},{"id":"semetey-1-2013:p1214:b004:l009","ordinal":169767,"en":"Cheered it on fiercely."},{"id":"semetey-1-2013:p1214:b004:l010","ordinal":169768,"en":"Kulatai proved a tulpar;"},{"id":"semetey-1-2013:p1214:b004:l011","ordinal":169769,"en":"Khan Zholoi’s Achbuudan"},{"id":"semetey-1-2013:p1214:b004:l012","ordinal":169770,"en":"He seized by the tail with his teeth."},{"id":"semetey-1-2013:p1214:b004:l013","ordinal":169771,"en":"Behind Kulatai,"},{"id":"semetey-1-2013:p1214:b004:l014","ordinal":169772,"en":"Hero Agysh’s Surkiyik,"},{"id":"semetey-1-2013:p1214:b004:l015","ordinal":169773,"en":"Flattening its ears like a kulan,"},{"id":"semetey-1-2013:p1214:b004:l016","ordinal":169774,"en":"Sweeping the earth like a whirlwind,"},{"id":"semetey-1-2013:p1214:b004:l017","ordinal":169775,"en":"Had passed the other racers."},{"id":"semetey-1-2013:p1214:b004:l018","ordinal":169776,"en":"The Black Kalmak and Manchu people"},{"id":"semetey-1-2013:p1214:b004:l019","ordinal":169777,"en":"Blocked it in sixty places."},{"id":"semetey-1-2013:p1214:b004:l020","ordinal":169778,"en":"Behind Surkiyik,"},{"id":"semetey-1-2013:p1214:b004:l021","ordinal":169779,"en":"Hero Töshtük’s Chalkuiruk—"},{"id":"semetey-1-2013:p1214:b004:l022","ordinal":169780,"en":"There was no remedy for Chalkuiruk:"},{"id":"semetey-1-2013:p1214:b004:l023","ordinal":169781,"en":"It had descended beneath the earth"},{"id":"semetey-1-2013:p1214:b004:l024","ordinal":169782,"en":"For nearly seven years,"},{"id":"semetey-1-2013:p1214:b004:l025","ordinal":169783,"en":"And had been above the earth again"},{"id":"semetey-1-2013:p1214:b004:l026","ordinal":169784,"en":"For barely seven days."},{"id":"semetey-1-2013:p1214:b004:l027","ordinal":169785,"en":"Unable to lower its head,"},{"id":"semetey-1-2013:p1214:b004:l028","ordinal":169786,"en":"The wondrous beast, weakened,"},{"id":"semetey-1-2013:p1214:b004:l029","ordinal":169787,"en":"Chalkuiruk came exhausted."},{"id":"semetey-1-2013:p1214:b004:l030","ordinal":169788,"en":"Behind it,"},{"id":"semetey-1-2013:p1214:b004:l031","ordinal":169789,"en":"Muzburchak’s Telkyzyl"},{"id":"semetey-1-2013:p1214:b004:l032","ordinal":169790,"en":"Also ran shimmering like a mirage;"},{"id":"semetey-1-2013:p1214:b004:l033","ordinal":169791,"en":"Kökö Khan’s Kökala"},{"id":"semetey-1-2013:p1214:b004:l034","ordinal":169792,"en":"Pressed close behind."},{"id":"semetey-1-2013:p1214:b004:l035","ordinal":169793,"en":"A leech drawn from the water,"},{"id":"semetey-1-2013:p1214:b004:l036","ordinal":169794,"en":"The racehorse Kerkabylan;"},{"id":"semetey-1-2013:p1214:b004:l037","ordinal":169795,"en":"Behind this one,"},{"id":"semetey-1-2013:p1214:b004:l038","ordinal":169796,"en":"Kökbörü’s Kuukazyk;"},{"id":"semetey-1-2013:p1214:b004:l039","ordinal":169797,"en":"And behind that,"},{"id":"semetey-1-2013:p1215:b003:l001","ordinal":169798,"en":"Orongu’s dun mare."},{"id":"semetey-1-2013:p1215:b003:l002","ordinal":169799,"en":"That was the last of the nine;"},{"id":"semetey-1-2013:p1215:b003:l003","ordinal":169800,"en":"Khan Manas’s Akkula"},{"id":"semetey-1-2013:p1215:b003:l004","ordinal":169801,"en":"Now moved out in front."},{"id":"semetey-1-2013:p1215:b003:l005","ordinal":169802,"en":"Kökötöi’s countless prizes"},{"id":"semetey-1-2013:p1215:b003:l006","ordinal":169803,"en":"The Black Chinese and Manchu people"},{"id":"semetey-1-2013:p1215:b003:l007","ordinal":169804,"en":"Overwhelmed and plundered."},{"id":"semetey-1-2013:p1215:b003:l008","ordinal":169805,"en":"Without gaining possession of the prizes,"},{"id":"semetey-1-2013:p1215:b003:l009","ordinal":169806,"en":"The Muslims were left empty-handed."},{"id":"semetey-1-2013:p1215:b003:l010","ordinal":169807,"en":"From the Chinese came Kongurbai,"},{"id":"semetey-1-2013:p1215:b003:l011","ordinal":169808,"en":"Black-maned Boroonchu,"},{"id":"semetey-1-2013:p1215:b003:l012","ordinal":169809,"en":"From the Kalmaks Khan Zholoi,"},{"id":"semetey-1-2013:p1215:b003:l013","ordinal":169810,"en":"And Ylama of the Solon;"},{"id":"semetey-1-2013:p1215:b003:l014","ordinal":169811,"en":"Do not ask about the violence"},{"id":"semetey-1-2013:p1215:b003:l015","ordinal":169812,"en":"Of those snarling infidels."},{"id":"semetey-1-2013:p1215:b003:l016","ordinal":169813,"en":"Dust flew and haze burned;"},{"id":"semetey-1-2013:p1215:b003:l017","ordinal":169814,"en":"The teeming Chinese covered the land."},{"id":"semetey-1-2013:p1215:b003:l018","ordinal":169815,"en":"This was the Kakanchin pass;"},{"id":"semetey-1-2013:p1215:b003:l019","ordinal":169816,"en":"The Chinese had come as guests"},{"id":"semetey-1-2013:p1215:b003:l020","ordinal":169817,"en":"To Kökötöi’s memorial feast,"},{"id":"semetey-1-2013:p1215:b003:l021","ordinal":169818,"en":"Yet it was time for them to clash."},{"id":"semetey-1-2013:p1215:b003:l022","ordinal":169819,"en":"Zholoi came out using force;"},{"id":"semetey-1-2013:p1215:b003:l023","ordinal":169820,"en":"Kongurbai came out then,"},{"id":"semetey-1-2013:p1215:b003:l024","ordinal":169821,"en":"Humiliating the Muslims."},{"id":"semetey-1-2013:p1215:b003:l025","ordinal":169822,"en":"Great wrestler Ylama,"},{"id":"semetey-1-2013:p1215:b003:l026","ordinal":169823,"en":"A Kalmak like great Zholoi,"},{"id":"semetey-1-2013:p1215:b003:l027","ordinal":169824,"en":"Wielding axes of many kinds—"},{"id":"semetey-1-2013:p1215:b003:l028","ordinal":169825,"en":"The doomed wrestlers,"},{"id":"semetey-1-2013:p1215:b003:l029","ordinal":169826,"en":"The massed Chinese and many Kalmaks,"},{"id":"semetey-1-2013:p1215:b003:l030","ordinal":169827,"en":"Plundered Kökötöi’s"},{"id":"semetey-1-2013:p1215:b003:l031","ordinal":169828,"en":"Many prizes."},{"id":"semetey-1-2013:p1215:b003:l032","ordinal":169829,"en":"It became a deeply dug pit;"},{"id":"semetey-1-2013:p1215:b003:l033","ordinal":169830,"en":"Kakan-Beijing stirred,"},{"id":"semetey-1-2013:p1215:b003:l034","ordinal":169831,"en":"For this was Kökötöi’s feast,"},{"id":"semetey-1-2013:p1215:b003:l035","ordinal":169832,"en":"The beginning of much conflict."},{"id":"semetey-1-2013:p1215:b003:l036","ordinal":169833,"en":"It was a deep, excavated pit,"},{"id":"semetey-1-2013:p1215:b003:l037","ordinal":169834,"en":"Misfortune set boiling."},{"id":"semetey-1-2013:p1215:b003:l038","ordinal":169835,"en":"The heroes guarding the livestock"},{"id":"semetey-1-2013:p1215:b003:l039","ordinal":169836,"en":"Were beaten down."},{"id":"semetey-1-2013:p1215:b004:l001","ordinal":169837,"en":"The many prizes, those Chinese"},{"id":"semetey-1-2013:p1215:b004:l002","ordinal":169838,"en":"Plundered and carried away."},{"id":"semetey-1-2013:p1215:b004:l003","ordinal":169839,"en":"They dug a well in the place of honor;"},{"id":"semetey-1-2013:p1215:b004:l004","ordinal":169840,"en":"The prize won by Akkula,"},{"id":"semetey-1-2013:p1215:b004:l005","ordinal":169841,"en":"By force then,"},{"id":"semetey-1-2013:p1215:b004:l006","ordinal":169842,"en":"The Black Kalmaks scattered."},{"id":"semetey-1-2013:p1215:b004:l007","ordinal":169843,"en":"Kökötöi’s abundant wealth—"},{"id":"semetey-1-2013:p1215:b004:l008","ordinal":169844,"en":"They plundered its silks,"},{"id":"semetey-1-2013:p1215:b004:l009","ordinal":169845,"en":"And wrought terrible disorder."},{"id":"semetey-1-2013:p1215:b004:l010","ordinal":169846,"en":"They now spoke their claim,"},{"id":"semetey-1-2013:p1215:b004:l011","ordinal":169847,"en":"And took the prizes of the horses"},{"id":"semetey-1-2013:p1215:b004:l012","ordinal":169848,"en":"That had placed, then returned."},{"id":"semetey-1-2013:p1215:b004:l013","ordinal":169849,"en":"They tormented the people;"},{"id":"semetey-1-2013:p1215:b004:l014","ordinal":169850,"en":"Against the Black Kalmak and Manchus"},{"id":"semetey-1-2013:p1215:b004:l015","ordinal":169851,"en":"No one remained to cast a lasso."},{"id":"semetey-1-2013:p1215:b004:l016","ordinal":169852,"en":"Leaving no moving livestock,"},{"id":"semetey-1-2013:p1215:b004:l017","ordinal":169853,"en":"They drove off the finest."},{"id":"semetey-1-2013:p1215:b004:l018","ordinal":169854,"en":"Whoever resisted,"},{"id":"semetey-1-2013:p1215:b004:l019","ordinal":169855,"en":"They put to death."},{"id":"semetey-1-2013:p1215:b004:l020","ordinal":169856,"en":"Those whose death had come died;"},{"id":"semetey-1-2013:p1215:b004:l021","ordinal":169857,"en":"At Kökötöi’s feast,"},{"id":"semetey-1-2013:p1215:b004:l022","ordinal":169858,"en":"From the Black Chinese and Manchus,"},{"id":"semetey-1-2013:p1215:b004:l023","ordinal":169859,"en":"The Muslims suffered humiliation."},{"id":"semetey-1-2013:p1215:b004:l024","ordinal":169860,"en":"The seething Chinese ran about;"},{"id":"semetey-1-2013:p1215:b004:l025","ordinal":169861,"en":"When they saw the Chinese people,"},{"id":"semetey-1-2013:p1215:b004:l026","ordinal":169862,"en":"The handful of Muslims"},{"id":"semetey-1-2013:p1215:b004:l027","ordinal":169863,"en":"Despaired of their dear lives."},{"id":"semetey-1-2013:p1215:b004:l028","ordinal":169864,"en":"They rushed about in alarm;"},{"id":"semetey-1-2013:p1215:b004:l029","ordinal":169865,"en":"Some who had lost all recourse"},{"id":"semetey-1-2013:p1215:b004:l030","ordinal":169866,"en":"Fled toward the ravine."},{"id":"semetey-1-2013:p1215:b004:l031","ordinal":169867,"en":"The Muslims had giants,"},{"id":"semetey-1-2013:p1215:b004:l032","ordinal":169868,"en":"And mortals who called themselves heroes,"},{"id":"semetey-1-2013:p1215:b004:l033","ordinal":169869,"en":"Many kinds in all."},{"id":"semetey-1-2013:p1215:b004:l034","ordinal":169870,"en":"The Muslim khans"},{"id":"semetey-1-2013:p1215:b004:l035","ordinal":169871,"en":"Lost their wits;"},{"id":"semetey-1-2013:p1215:b004:l036","ordinal":169872,"en":"Never mind the prizes—"},{"id":"semetey-1-2013:p1215:b004:l037","ordinal":169873,"en":"All of them, even old hero Koshoy,"},{"id":"semetey-1-2013:p1215:b004:l038","ordinal":169874,"en":"Fled to save their lives."},{"id":"semetey-1-2013:p1215:b004:l039","ordinal":169875,"en":"Full in courage and strong in venom,"},{"id":"semetey-1-2013:p1216:b003:l001","ordinal":169876,"en":"Your bloodthirsty lion Manas"},{"id":"semetey-1-2013:p1216:b003:l002","ordinal":169877,"en":"Set right whoever attacked him."},{"id":"semetey-1-2013:p1216:b003:l003","ordinal":169878,"en":"The forty companions were beside him;"},{"id":"semetey-1-2013:p1216:b003:l004","ordinal":169879,"en":"Beneath him was his tulpar."},{"id":"semetey-1-2013:p1216:b003:l005","ordinal":169880,"en":"There had been times"},{"id":"semetey-1-2013:p1216:b003:l006","ordinal":169881,"en":"When he slaughtered the whole world."},{"id":"semetey-1-2013:p1216:b003:l007","ordinal":169882,"en":"His eyes blazing like fire,"},{"id":"semetey-1-2013:p1216:b003:l008","ordinal":169883,"en":"The great black Muslim host—"},{"id":"semetey-1-2013:p1216:b003:l009","ordinal":169884,"en":"When your lion elder grew angry,"},{"id":"semetey-1-2013:p1216:b003:l010","ordinal":169885,"en":"He slaughtered them and left them."},{"id":"semetey-1-2013:p1216:b003:l011","ordinal":169886,"en":"“While the Chinese swarm and seethe,"},{"id":"semetey-1-2013:p1216:b003:l012","ordinal":169887,"en":"The time has come to fight."},{"id":"semetey-1-2013:p1216:b003:l013","ordinal":169888,"en":"If doom comes, let us die;"},{"id":"semetey-1-2013:p1216:b003:l014","ordinal":169889,"en":"Taking Akkula's prize"},{"id":"semetey-1-2013:p1216:b003:l015","ordinal":169890,"en":"Away from the infidels,"},{"id":"semetey-1-2013:p1216:b003:l016","ordinal":169891,"en":"Let us divide it completely!"},{"id":"semetey-1-2013:p1216:b003:l017","ordinal":169892,"en":"Why stand looming in Talas"},{"id":"semetey-1-2013:p1216:b003:l018","ordinal":169893,"en":"Before the Black Kalmaks?"},{"id":"semetey-1-2013:p1216:b003:l019","ordinal":169894,"en":"Why fold our hands before infidels—"},{"id":"semetey-1-2013:p1216:b003:l020","ordinal":169895,"en":"What inheritance would that win us?!"},{"id":"semetey-1-2013:p1216:b003:l021","ordinal":169896,"en":"Let us drive the oppressive Black Kalmaks"},{"id":"semetey-1-2013:p1216:b003:l022","ordinal":169897,"en":"Toward Beijing."},{"id":"semetey-1-2013:p1216:b003:l023","ordinal":169898,"en":"Let us drive the snarling Chinese"},{"id":"semetey-1-2013:p1216:b003:l024","ordinal":169899,"en":"Into the khagan's realm."},{"id":"semetey-1-2013:p1216:b003:l025","ordinal":169900,"en":"Let us slaughter their leaders"},{"id":"semetey-1-2013:p1216:b003:l026","ordinal":169901,"en":"And drink our fill of their blood."},{"id":"semetey-1-2013:p1216:b003:l027","ordinal":169902,"en":"The infidels have shown their greed;"},{"id":"semetey-1-2013:p1216:b003:l028","ordinal":169903,"en":"Let us slaughter them."},{"id":"semetey-1-2013:p1216:b003:l029","ordinal":169904,"en":"Let us face and test them,"},{"id":"semetey-1-2013:p1216:b003:l030","ordinal":169905,"en":"And if doom comes, die."},{"id":"semetey-1-2013:p1216:b003:l031","ordinal":169906,"en":"If we do not fight them to destruction,"},{"id":"semetey-1-2013:p1216:b003:l032","ordinal":169907,"en":"These Chinese will grow insolent"},{"id":"semetey-1-2013:p1216:b003:l033","ordinal":169908,"en":"And strain greedily toward the Muslims."},{"id":"semetey-1-2013:p1216:b003:l034","ordinal":169909,"en":"They will turn back upon us"},{"id":"semetey-1-2013:p1216:b003:l035","ordinal":169910,"en":"And bring fierce upheaval.”"},{"id":"semetey-1-2013:p1216:b003:l036","ordinal":169911,"en":"When Manas said this,"},{"id":"semetey-1-2013:p1216:b003:l037","ordinal":169912,"en":"The great black people of Islam"},{"id":"semetey-1-2013:p1216:b003:l038","ordinal":169913,"en":"Were souls of another temper toward wrathful"},{"id":"semetey-1-2013:p1216:b003:l039","ordinal":169914,"en":"Hero Khan Kongurbai."},{"id":"semetey-1-2013:p1216:b004:l001","ordinal":169915,"en":"“If China takes the livestock, let it take it;"},{"id":"semetey-1-2013:p1216:b004:l002","ordinal":169916,"en":"Let us not attack the infidels."},{"id":"semetey-1-2013:p1216:b004:l003","ordinal":169917,"en":"Let us submit to what they say."},{"id":"semetey-1-2013:p1216:b004:l004","ordinal":169918,"en":"Kökötöy's prize—"},{"id":"semetey-1-2013:p1216:b004:l005","ordinal":169919,"en":"To the great Black Chinese,"},{"id":"semetey-1-2013:p1216:b004:l006","ordinal":169920,"en":"Let us give it without quarrel."},{"id":"semetey-1-2013:p1216:b004:l007","ordinal":169921,"en":"Let us withdraw safely to our own lands,"},{"id":"semetey-1-2013:p1216:b004:l008","ordinal":169922,"en":"And tell those who know"},{"id":"semetey-1-2013:p1216:b004:l009","ordinal":169923,"en":"What venom"},{"id":"semetey-1-2013:p1216:b004:l010","ordinal":169924,"en":"The Black Chinese and Manchus possess."},{"id":"semetey-1-2013:p1216:b004:l011","ordinal":169925,"en":"Without quarreling or raising conflict,"},{"id":"semetey-1-2013:p1216:b004:l012","ordinal":169926,"en":"Lion Manas,"},{"id":"semetey-1-2013:p1216:b004:l013","ordinal":169927,"en":"We gave the feast—let us return alive!"},{"id":"semetey-1-2013:p1216:b004:l014","ordinal":169928,"en":"We have long known"},{"id":"semetey-1-2013:p1216:b004:l015","ordinal":169929,"en":"How numerous the Black Kalmaks and Manchus are;"},{"id":"semetey-1-2013:p1216:b004:l016","ordinal":169930,"en":"We thought, when these infidels grew angry,"},{"id":"semetey-1-2013:p1216:b004:l017","ordinal":169931,"en":"They would multiply against us."},{"id":"semetey-1-2013:p1216:b004:l018","ordinal":169932,"en":"Why should we measure ourselves"},{"id":"semetey-1-2013:p1216:b004:l019","ordinal":169933,"en":"Against wicked infidels?"},{"id":"semetey-1-2013:p1216:b004:l020","ordinal":169934,"en":"Without matching them, Khan Manas,"},{"id":"semetey-1-2013:p1216:b004:l021","ordinal":169935,"en":"Let us depart safely for our lands."},{"id":"semetey-1-2013:p1216:b004:l022","ordinal":169936,"en":"Your infidels are a grim people;"},{"id":"semetey-1-2013:p1216:b004:l023","ordinal":169937,"en":"If by chance they come by tens of thousands,"},{"id":"semetey-1-2013:p1216:b004:l024","ordinal":169938,"en":"They will plunder everything."},{"id":"semetey-1-2013:p1216:b004:l025","ordinal":169939,"en":"These infidels will not take only the prize;"},{"id":"semetey-1-2013:p1216:b004:l026","ordinal":169940,"en":"They seem able to take"},{"id":"semetey-1-2013:p1216:b004:l027","ordinal":169941,"en":"Every one of us completely."},{"id":"semetey-1-2013:p1216:b004:l028","ordinal":169942,"en":"Let us submit to the words"},{"id":"semetey-1-2013:p1216:b004:l029","ordinal":169943,"en":"Of Chinese as numerous as ants."},{"id":"semetey-1-2013:p1216:b004:l030","ordinal":169944,"en":"Akkula's prize—"},{"id":"semetey-1-2013:p1216:b004:l031","ordinal":169945,"en":"Noble Manas, if you heed us,"},{"id":"semetey-1-2013:p1216:b004:l032","ordinal":169946,"en":"Let us give it as an offering."},{"id":"semetey-1-2013:p1216:b004:l033","ordinal":169947,"en":"Since we invited them with honor to the feast,"},{"id":"semetey-1-2013:p1216:b004:l034","ordinal":169948,"en":"The shameless, foolish kinsmen"},{"id":"semetey-1-2013:p1216:b004:l035","ordinal":169949,"en":"Have loaded troops upon camels"},{"id":"semetey-1-2013:p1216:b004:l036","ordinal":169950,"en":"To fight your Chinese;"},{"id":"semetey-1-2013:p1216:b004:l037","ordinal":169951,"en":"They loaded bullets upon Bil,"},{"id":"semetey-1-2013:p1216:b004:l038","ordinal":169952,"en":"And from the Kangly people"},{"id":"semetey-1-2013:p1216:b004:l039","ordinal":169953,"en":"Have taken countless tens of thousands of troops."},{"id":"semetey-1-2013:p1217:b003:l001","ordinal":169954,"en":"Their fortress stands on the slope;"},{"id":"semetey-1-2013:p1217:b003:l002","ordinal":169955,"en":"The infidel people are numerous."},{"id":"semetey-1-2013:p1217:b003:l003","ordinal":169956,"en":"Their grass above has grown thick;"},{"id":"semetey-1-2013:p1217:b003:l004","ordinal":169957,"en":"The Muslim people are few."},{"id":"semetey-1-2013:p1217:b003:l005","ordinal":169958,"en":"Accomplished Manas, heed us!"},{"id":"semetey-1-2013:p1217:b003:l006","ordinal":169959,"en":"Will seven wolves fighting over one foal"},{"id":"semetey-1-2013:p1217:b003:l007","ordinal":169960,"en":"Leave even its carrion?"},{"id":"semetey-1-2013:p1217:b003:l008","ordinal":169961,"en":"They are a people of seven ages;"},{"id":"semetey-1-2013:p1217:b003:l009","ordinal":169962,"en":"If they strike the palm-sized Muslims,"},{"id":"semetey-1-2013:p1217:b003:l010","ordinal":169963,"en":"Will they leave even our carrion?"},{"id":"semetey-1-2013:p1217:b003:l011","ordinal":169964,"en":"Their root is a black lake;"},{"id":"semetey-1-2013:p1217:b003:l012","ordinal":169965,"en":"They are the inexhaustible Chinese people."},{"id":"semetey-1-2013:p1217:b003:l013","ordinal":169966,"en":"Can any man match them?"},{"id":"semetey-1-2013:p1217:b003:l014","ordinal":169967,"en":"If these infidels surge like a flood,"},{"id":"semetey-1-2013:p1217:b003:l015","ordinal":169968,"en":"Will they spare a soul?"},{"id":"semetey-1-2013:p1217:b003:l016","ordinal":169969,"en":"Can one who clashes with the black, monstrous Chinese survive?"},{"id":"semetey-1-2013:p1217:b003:l017","ordinal":169970,"en":"Can one who grapples them remain alive?"},{"id":"semetey-1-2013:p1217:b003:l018","ordinal":169971,"en":"With the dog whose mother is forsworn,"},{"id":"semetey-1-2013:p1217:b003:l019","ordinal":169972,"en":"Let us not enter into enmity."},{"id":"semetey-1-2013:p1217:b003:l020","ordinal":169973,"en":"Let us not invite it upon ourselves;"},{"id":"semetey-1-2013:p1217:b003:l021","ordinal":169974,"en":"Let us not bring calamity"},{"id":"semetey-1-2013:p1217:b003:l022","ordinal":169975,"en":"Upon our dear heads."},{"id":"semetey-1-2013:p1217:b003:l023","ordinal":169976,"en":"Let us not see slaughter from China"},{"id":"semetey-1-2013:p1217:b003:l024","ordinal":169977,"en":"And all die together!”"},{"id":"semetey-1-2013:p1217:b003:l025","ordinal":169978,"en":"When the Muslims said this,"},{"id":"semetey-1-2013:p1217:b003:l026","ordinal":169979,"en":"Hero Manas surged in wrath."},{"id":"semetey-1-2013:p1217:b003:l027","ordinal":169980,"en":"Raging then,"},{"id":"semetey-1-2013:p1217:b003:l028","ordinal":169981,"en":"He confined some,"},{"id":"semetey-1-2013:p1217:b003:l029","ordinal":169982,"en":"And beat others."},{"id":"semetey-1-2013:p1217:b003:l030","ordinal":169983,"en":"Leaning toward every valley,"},{"id":"semetey-1-2013:p1217:b003:l031","ordinal":169984,"en":"Their migration remained behind—did you see?"}]
