{"id": "sayakbay-ms-current146:pdf133:l035", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 133, "folio": 516, "line_in_page": 35, "raw": "Буга теңдешип адам болот.", "text": "Буга теңдешип адам болот.", "en": "A man must rise to stand against him.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
