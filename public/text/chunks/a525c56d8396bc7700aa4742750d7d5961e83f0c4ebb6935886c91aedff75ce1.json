[{"id":"semetey-2-2013:p1356:b004:l016","ordinal":291073,"en":"One gray wolf, unable to endure,"},{"id":"semetey-2-2013:p1356:b004:l017","ordinal":291074,"en":"Fled toward Kaiypchy."},{"id":"semetey-2-2013:p1356:b004:l018","ordinal":291075,"en":"Before the Zhediger could seize him,"},{"id":"semetey-2-2013:p1356:b004:l019","ordinal":291076,"en":"Before they could torment him without mercy,"},{"id":"semetey-2-2013:p1356:b004:l020","ordinal":291077,"en":"Before they cut off his head like a sheep's,"},{"id":"semetey-2-2013:p1356:b004:l021","ordinal":291078,"en":"Before they brought him utterly to ruin,"},{"id":"semetey-2-2013:p1356:b004:l022","ordinal":291079,"en":"Before their flood trampled him,"},{"id":"semetey-2-2013:p1356:b004:l023","ordinal":291080,"en":"He, the son of the smith Bolokbai,"},{"id":"semetey-2-2013:p1356:b004:l024","ordinal":291081,"en":"That extraordinary weather-working servant,"},{"id":"semetey-2-2013:p1356:b004:l025","ordinal":291082,"en":"Made rain fall upon the uplands"},{"id":"semetey-2-2013:p1356:b004:l026","ordinal":291083,"en":"And drew fog over the foothills."},{"id":"semetey-2-2013:p1356:b004:l027","ordinal":291084,"en":"The weather broke and the sun was veiled."},{"id":"semetey-2-2013:p1356:b004:l028","ordinal":291085,"en":"Running on foot day and night,"},{"id":"semetey-2-2013:p1356:b004:l029","ordinal":291086,"en":"Toward Kaiypchy's Kara-Too,"},{"id":"semetey-2-2013:p1356:b004:l030","ordinal":291087,"en":"Toward the pass between twin peaks,"},{"id":"semetey-2-2013:p1356:b004:l031","ordinal":291088,"en":"The route by which his father Bolokbai escaped the foe,"},{"id":"semetey-2-2013:p1356:b004:l032","ordinal":291089,"en":"The ridge used for flight,"},{"id":"semetey-2-2013:p1356:b004:l033","ordinal":291090,"en":"While the weather broke and the sun was veiled,"},{"id":"semetey-2-2013:p1356:b004:l034","ordinal":291091,"en":"Akzholtoi fled and escaped."},{"id":"semetey-2-2013:p1356:b004:l035","ordinal":291092,"en":"Akzholtoi became invisible;"},{"id":"semetey-2-2013:p1356:b004:l036","ordinal":291093,"en":"No human being approached him."},{"id":"semetey-2-2013:p1356:b004:l037","ordinal":291094,"en":"From Kanchoro's wrath,"},{"id":"semetey-2-2013:p1356:b004:l038","ordinal":291095,"en":"Akzholtoi vanished."},{"id":"semetey-2-2013:p1356:b004:l039","ordinal":291096,"en":"He had been khan of the treasury gate,"},{"id":"semetey-2-2013:p1357:b003:l001","ordinal":291097,"en":"And his honor had been great."},{"id":"semetey-2-2013:p1357:b003:l002","ordinal":291098,"en":"Leading his poor soul away,"},{"id":"semetey-2-2013:p1357:b003:l003","ordinal":291099,"en":"He set out toward Kaiypchy-Too,"},{"id":"semetey-2-2013:p1357:b003:l004","ordinal":291100,"en":"Leaving sixty women and mourning sisters-in-law,"},{"id":"semetey-2-2013:p1357:b003:l005","ordinal":291101,"en":"Leaving the camp desolate."},{"id":"semetey-2-2013:p1357:b003:l006","ordinal":291102,"en":"They had encircled the palace,"},{"id":"semetey-2-2013:p1357:b003:l007","ordinal":291103,"en":"And when the bright dawn advanced,"},{"id":"semetey-2-2013:p1357:b003:l008","ordinal":291104,"en":"When stars fled across the sky"},{"id":"semetey-2-2013:p1357:b003:l009","ordinal":291105,"en":"And moved toward the qibla,"},{"id":"semetey-2-2013:p1357:b003:l010","ordinal":291106,"en":"As the first light whitened,"},{"id":"semetey-2-2013:p1357:b003:l011","ordinal":291107,"en":"When the cold wind before sunrise"},{"id":"semetey-2-2013:p1357:b003:l012","ordinal":291108,"en":"Struck and made the bones ache,"},{"id":"semetey-2-2013:p1357:b003:l013","ordinal":291109,"en":"As the dawn's light appeared,"},{"id":"semetey-2-2013:p1357:b003:l014","ordinal":291110,"en":"The stars fled across the sky"},{"id":"semetey-2-2013:p1357:b003:l015","ordinal":291111,"en":"And withdrew toward the qibla."},{"id":"semetey-2-2013:p1357:b003:l016","ordinal":291112,"en":"The haze that blinded the eye"},{"id":"semetey-2-2013:p1357:b003:l017","ordinal":291113,"en":"Lifted upward into the heavens."},{"id":"semetey-2-2013:p1357:b003:l018","ordinal":291114,"en":"The earth seemed to split as dawn broke;"},{"id":"semetey-2-2013:p1357:b003:l019","ordinal":291115,"en":"The separate peaks of Orkoi Mountain"},{"id":"semetey-2-2013:p1357:b003:l020","ordinal":291116,"en":"Became clearly visible."},{"id":"semetey-2-2013:p1357:b003:l021","ordinal":291117,"en":"When the earth opened to the day,"},{"id":"semetey-2-2013:p1357:b003:l022","ordinal":291118,"en":"Girding their waists securely,"},{"id":"semetey-2-2013:p1357:b003:l023","ordinal":291119,"en":"They raised a roar that split the earth."},{"id":"semetey-2-2013:p1357:b003:l024","ordinal":291120,"en":"If you wish to hear that roar:"},{"id":"semetey-2-2013:p1357:b003:l025","ordinal":291121,"en":"They shouted, \"Kanchoro!\""},{"id":"semetey-2-2013:p1357:b003:l026","ordinal":291122,"en":"And the courageous lions"},{"id":"semetey-2-2013:p1357:b003:l027","ordinal":291123,"en":"Drove the Zhediger in."},{"id":"semetey-2-2013:p1357:b003:l028","ordinal":291124,"en":"Upon the sixty sisters-in-law and mourning women,"},{"id":"semetey-2-2013:p1357:b003:l029","ordinal":291125,"en":"They attacked all together;"},{"id":"semetey-2-2013:p1357:b003:l030","ordinal":291126,"en":"The Zhediger flooded in."},{"id":"semetey-2-2013:p1357:b003:l031","ordinal":291127,"en":"That multitude of Zhediger"},{"id":"semetey-2-2013:p1357:b003:l032","ordinal":291128,"en":"Cut down the plane trees,"},{"id":"semetey-2-2013:p1357:b003:l033","ordinal":291129,"en":"Pushed over the walls,"},{"id":"semetey-2-2013:p1357:b003:l034","ordinal":291130,"en":"Cut down the willows,"},{"id":"semetey-2-2013:p1357:b003:l035","ordinal":291131,"en":"And demolished every building."},{"id":"semetey-2-2013:p1357:b003:l036","ordinal":291132,"en":"They turned the gateway bloody,"},{"id":"semetey-2-2013:p1357:b003:l037","ordinal":291133,"en":"Made the brave renowned,"},{"id":"semetey-2-2013:p1357:b003:l038","ordinal":291134,"en":"Made Kanchoro khan"},{"id":"semetey-2-2013:p1357:b003:l039","ordinal":291135,"en":"Over the corrupted multitude,"},{"id":"semetey-2-2013:p1357:b004:l001","ordinal":291136,"en":"And the Zhediger flooded in."},{"id":"semetey-2-2013:p1357:b004:l002","ordinal":291137,"en":"They slaughtered and destroyed the heroes,"},{"id":"semetey-2-2013:p1357:b004:l003","ordinal":291138,"en":"Smashed the doors,"},{"id":"semetey-2-2013:p1357:b004:l004","ordinal":291139,"en":"And made the women scream;"},{"id":"semetey-2-2013:p1357:b004:l005","ordinal":291140,"en":"The Zhediger trampled their way inside."},{"id":"semetey-2-2013:p1357:b004:l006","ordinal":291141,"en":"The treasury that sustained the world—"},{"id":"semetey-2-2013:p1357:b004:l007","ordinal":291142,"en":"They opened its doors."},{"id":"semetey-2-2013:p1357:b004:l008","ordinal":291143,"en":"Refined gold and white silver,"},{"id":"semetey-2-2013:p1357:b004:l009","ordinal":291144,"en":"All the great treasures,"},{"id":"semetey-2-2013:p1357:b004:l010","ordinal":291145,"en":"The Zhediger took as spoil"},{"id":"semetey-2-2013:p1357:b004:l011","ordinal":291146,"en":"And scattered breast-deep."},{"id":"semetey-2-2013:p1357:b004:l012","ordinal":291147,"en":"They widowed those with husbands,"},{"id":"semetey-2-2013:p1357:b004:l013","ordinal":291148,"en":"Beat silk into raw wool,"},{"id":"semetey-2-2013:p1357:b004:l014","ordinal":291149,"en":"And seized the noble brides and Aksakal's women,"},{"id":"semetey-2-2013:p1357:b004:l015","ordinal":291150,"en":"Plundering and enslaving them."},{"id":"semetey-2-2013:p1357:b004:l016","ordinal":291151,"en":"They raided and seized the palace,"},{"id":"semetey-2-2013:p1357:b004:l017","ordinal":291152,"en":"Pulled out the fortress posts,"},{"id":"semetey-2-2013:p1357:b004:l018","ordinal":291153,"en":"Destroyed the stone city,"},{"id":"semetey-2-2013:p1357:b004:l019","ordinal":291154,"en":"And plundered it completely."},{"id":"semetey-2-2013:p1357:b004:l020","ordinal":291155,"en":"They scorched the earthen fort"},{"id":"semetey-2-2013:p1357:b004:l021","ordinal":291156,"en":"And sacked it utterly."},{"id":"semetey-2-2013:p1357:b004:l022","ordinal":291157,"en":"They wrought every conflict they knew,"},{"id":"semetey-2-2013:p1357:b004:l023","ordinal":291158,"en":"Plundered the treasury and settled in ease."},{"id":"semetey-2-2013:p1357:b004:l024","ordinal":291159,"en":"They drove red-tailed riding camels,"},{"id":"semetey-2-2013:p1357:b004:l025","ordinal":291160,"en":"Braiding their flowing tails;"},{"id":"semetey-2-2013:p1357:b004:l026","ordinal":291161,"en":"Gold in pitchers and coins like sand,"},{"id":"semetey-2-2013:p1357:b004:l027","ordinal":291162,"en":"They plundered and divided with approval."},{"id":"semetey-2-2013:p1357:b004:l028","ordinal":291163,"en":"Crimson cloth with golden weave—"},{"id":"semetey-2-2013:p1357:b004:l029","ordinal":291164,"en":"They divided all of it."},{"id":"semetey-2-2013:p1357:b004:l030","ordinal":291165,"en":"All the Kyrgyz were surrounded;"},{"id":"semetey-2-2013:p1357:b004:l031","ordinal":291166,"en":"Girls were seized and plundered as spoil."},{"id":"semetey-2-2013:p1357:b004:l032","ordinal":291167,"en":"The Zhediger, glutted with booty,"},{"id":"semetey-2-2013:p1357:b004:l033","ordinal":291168,"en":"Shouted in wild confusion,"},{"id":"semetey-2-2013:p1357:b004:l034","ordinal":291169,"en":"Saying, \"We have won great spoil!\""},{"id":"semetey-2-2013:p1357:b004:l035","ordinal":291170,"en":"And raising the cry, \"Kiyaz!\""},{"id":"semetey-2-2013:p1357:b004:l036","ordinal":291171,"en":"They pulled out the palace posts,"},{"id":"semetey-2-2013:p1357:b004:l037","ordinal":291172,"en":"Plundered everything together,"},{"id":"semetey-2-2013:p1357:b004:l038","ordinal":291173,"en":"And wrought horror without hardship."},{"id":"semetey-2-2013:p1357:b004:l039","ordinal":291174,"en":"The thundering Zhediger"},{"id":"semetey-2-2013:p1358:b003:l001","ordinal":291175,"en":"They plundered everything and settled in ease."},{"id":"semetey-2-2013:p1358:b003:l002","ordinal":291176,"en":"The bloodthirsty khan’s treasury—"},{"id":"semetey-2-2013:p1358:b003:l003","ordinal":291177,"en":"They could not finish dividing it."},{"id":"semetey-2-2013:p1358:b003:l004","ordinal":291178,"en":"Gold and silver"},{"id":"semetey-2-2013:p1358:b003:l005","ordinal":291179,"en":"They could not load it all."},{"id":"semetey-2-2013:p1358:b003:l006","ordinal":291180,"en":"Noble brides and beautiful girls"},{"id":"semetey-2-2013:p1358:b003:l007","ordinal":291181,"en":"They could not finish carrying off."},{"id":"semetey-2-2013:p1358:b003:l008","ordinal":291182,"en":"The great host of the Kara-Zhediger,"},{"id":"semetey-2-2013:p1358:b003:l009","ordinal":291183,"en":"With Khan Kanchoro grown rich,"},{"id":"semetey-2-2013:p1358:b003:l010","ordinal":291184,"en":"Glutted with all the world’s wealth,"},{"id":"semetey-2-2013:p1358:b003:l011","ordinal":291185,"en":"Made for humankind until Judgment Day"},{"id":"semetey-2-2013:p1358:b003:l012","ordinal":291186,"en":"An unforgettable example,"},{"id":"semetey-2-2013:p1358:b003:l013","ordinal":291187,"en":"Flooding in and seizing the land,"},{"id":"semetey-2-2013:p1358:b003:l014","ordinal":291188,"en":"Slaughtering and destroying many,"},{"id":"semetey-2-2013:p1358:b003:l015","ordinal":291189,"en":"They overcame the infidels guarding the gate,"},{"id":"semetey-2-2013:p1358:b003:l016","ordinal":291190,"en":"And entered to plunder the women in the palace."},{"id":"semetey-2-2013:p1358:b003:l017","ordinal":291191,"en":"They pulled out the roof poles and laid them flat,"},{"id":"semetey-2-2013:p1358:b003:l018","ordinal":291192,"en":"They knocked down the main pillars,"},{"id":"semetey-2-2013:p1358:b003:l019","ordinal":291193,"en":"And Aychyrok’s White Palace"},{"id":"semetey-2-2013:p1358:b003:l020","ordinal":291194,"en":"Was what brave Kyiaz meant to take."},{"id":"semetey-2-2013:p1358:b003:l021","ordinal":291195,"en":"When he came and surrounded it,"},{"id":"semetey-2-2013:p1358:b003:l022","ordinal":291196,"en":"When he tried to force Chyrok,"},{"id":"semetey-2-2013:p1358:b003:l023","ordinal":291197,"en":"Inside the palace Aychyrok"},{"id":"semetey-2-2013:p1358:b003:l024","ordinal":291198,"en":"Sat there in proud composure,"},{"id":"semetey-2-2013:p1358:b003:l025","ordinal":291199,"en":"Too weary even to speak."},{"id":"semetey-2-2013:p1358:b003:l026","ordinal":291200,"en":"This woman Aychyrok,"},{"id":"semetey-2-2013:p1358:b003:l027","ordinal":291201,"en":"This radiant beauty,"},{"id":"semetey-2-2013:p1358:b003:l028","ordinal":291202,"en":"Her mail coat shimmered,"},{"id":"semetey-2-2013:p1358:b003:l029","ordinal":291203,"en":"She shone like the rising moon;"},{"id":"semetey-2-2013:p1358:b003:l030","ordinal":291204,"en":"The hapless fairy maiden’s"},{"id":"semetey-2-2013:p1358:b003:l031","ordinal":291205,"en":"Manner was like this."},{"id":"semetey-2-2013:p1358:b003:l032","ordinal":291206,"en":"Pearl and ruby buttons,"},{"id":"semetey-2-2013:p1358:b003:l033","ordinal":291207,"en":"Each as large as a fist, lay on her breast;"},{"id":"semetey-2-2013:p1358:b003:l034","ordinal":291208,"en":"She spoke sadly, yet still shone."},{"id":"semetey-2-2013:p1358:b003:l035","ordinal":291209,"en":"Her sixty-keyed amulet"},{"id":"semetey-2-2013:p1358:b003:l036","ordinal":291210,"en":"Hung, it seemed, upon the breast"},{"id":"semetey-2-2013:p1358:b003:l037","ordinal":291211,"en":"Of that ill-fated celestial maiden, jingling."},{"id":"semetey-2-2013:p1358:b003:l038","ordinal":291212,"en":"With a thimble-small mouth and camel-calf eyes,"},{"id":"semetey-2-2013:p1358:b003:l039","ordinal":291213,"en":"A sheath-slender waist and a snow-white face—"},{"id":"semetey-2-2013:p1358:b004:l001","ordinal":291214,"en":"Look well upon her marks of beauty."},{"id":"semetey-2-2013:p1358:b004:l002","ordinal":291215,"en":"This woman Aychyrok,"},{"id":"semetey-2-2013:p1358:b004:l003","ordinal":291216,"en":"This graceful beauty,"},{"id":"semetey-2-2013:p1358:b004:l004","ordinal":291217,"en":"Had a gentle bearing and honeyed speech;"},{"id":"semetey-2-2013:p1358:b004:l005","ordinal":291218,"en":"No such soul is born among humankind."},{"id":"semetey-2-2013:p1358:b004:l006","ordinal":291219,"en":"She swayed like a poppy,"},{"id":"semetey-2-2013:p1358:b004:l007","ordinal":291220,"en":"In a fitted vest and silk gown."},{"id":"semetey-2-2013:p1358:b004:l008","ordinal":291221,"en":"The pampered, hapless woman’s"},{"id":"semetey-2-2013:p1358:b004:l009","ordinal":291222,"en":"Hem streamed out like a spring."},{"id":"semetey-2-2013:p1358:b004:l010","ordinal":291223,"en":"When Aychyrok looked straight at him,"},{"id":"semetey-2-2013:p1358:b004:l011","ordinal":291224,"en":"To brave Kyiaz’s eyes"},{"id":"semetey-2-2013:p1358:b004:l012","ordinal":291225,"en":"She seemed like the rising moon."},{"id":"semetey-2-2013:p1358:b004:l013","ordinal":291226,"en":"When he saw Aychyrok,"},{"id":"semetey-2-2013:p1358:b004:l014","ordinal":291227,"en":"Brave Kyiaz, son of Agysh,"},{"id":"semetey-2-2013:p1358:b004:l015","ordinal":291228,"en":"Nearly lost his reason,"},{"id":"semetey-2-2013:p1358:b004:l016","ordinal":291229,"en":"And stared, consumed with grief."},{"id":"semetey-2-2013:p1358:b004:l017","ordinal":291230,"en":"The hapless woman, faintly smiling,"},{"id":"semetey-2-2013:p1358:b004:l018","ordinal":291231,"en":"Had a face wounded though bright as the sun,"},{"id":"semetey-2-2013:p1358:b004:l019","ordinal":291232,"en":"And sorrow shadowed her smiling head."},{"id":"semetey-2-2013:p1358:b004:l020","ordinal":291233,"en":"Her dear hair, long as meadow grass,"},{"id":"semetey-2-2013:p1358:b004:l021","ordinal":291234,"en":"Was spread across her breast."},{"id":"semetey-2-2013:p1358:b004:l022","ordinal":291235,"en":"Into her white face, smooth as a mirror,"},{"id":"semetey-2-2013:p1358:b004:l023","ordinal":291236,"en":"Five fingernails had dug deep."},{"id":"semetey-2-2013:p1358:b004:l024","ordinal":291237,"en":"When brave Kyiaz came and surrounded her,"},{"id":"semetey-2-2013:p1358:b004:l025","ordinal":291238,"en":"Aychyrok despaired of life,"},{"id":"semetey-2-2013:p1358:b004:l026","ordinal":291239,"en":"Her color drained and her face went pale."},{"id":"semetey-2-2013:p1358:b004:l027","ordinal":291240,"en":"Blood flowing from both cheeks"},{"id":"semetey-2-2013:p1358:b004:l028","ordinal":291241,"en":"Poured down over her breast."},{"id":"semetey-2-2013:p1358:b004:l029","ordinal":291242,"en":"Then Chyrok formed a plan:"},{"id":"semetey-2-2013:p1358:b004:l030","ordinal":291243,"en":"If Kyiaz came close,"},{"id":"semetey-2-2013:p1358:b004:l031","ordinal":291244,"en":"“I will draw Zulpukor from its sheath"},{"id":"semetey-2-2013:p1358:b004:l032","ordinal":291245,"en":"And bring a final, crushing disaster"},{"id":"semetey-2-2013:p1358:b004:l033","ordinal":291246,"en":"Upon this rabid dog."},{"id":"semetey-2-2013:p1358:b004:l034","ordinal":291247,"en":"I will somehow find my chance;"},{"id":"semetey-2-2013:p1358:b004:l035","ordinal":291248,"en":"I will strike off this unclean slave’s head,"},{"id":"semetey-2-2013:p1358:b004:l036","ordinal":291249,"en":"And settle the calamity once and for all."},{"id":"semetey-2-2013:p1358:b004:l037","ordinal":291250,"en":"The black blood from inside him"},{"id":"semetey-2-2013:p1358:b004:l038","ordinal":291251,"en":"I will gulp down and swallow.”"},{"id":"semetey-2-2013:p1358:b004:l039","ordinal":291252,"en":"Such was her fierce and terrible wrath."},{"id":"semetey-2-2013:p1359:b003:l001","ordinal":291253,"en":"Thinking, “I will take this infidel captive."},{"id":"semetey-2-2013:p1359:b003:l002","ordinal":291254,"en":"Here inside this palace"},{"id":"semetey-2-2013:p1359:b003:l003","ordinal":291255,"en":"I will split her like a lean sheep.”"},{"id":"semetey-2-2013:p1359:b003:l004","ordinal":291256,"en":"Yesterday, while bloodthirsty Manas lived,"},{"id":"semetey-2-2013:p1359:b003:l005","ordinal":291257,"en":"It descended from heaven and came to him,"},{"id":"semetey-2-2013:p1359:b003:l006","ordinal":291258,"en":"So he might gird himself and ride against the foe:"},{"id":"semetey-2-2013:p1359:b003:l007","ordinal":291259,"en":"Zulpukor, found for valiant Khan Manas."},{"id":"semetey-2-2013:p1359:b003:l008","ordinal":291260,"en":"Zulpukor, which hews down whatever is thrust before it,"},{"id":"semetey-2-2013:p1359:b003:l009","ordinal":291261,"en":"Which, once drawn, could not be stayed,"},{"id":"semetey-2-2013:p1359:b003:l010","ordinal":291262,"en":"Which, when a man swung it as he wished,"},{"id":"semetey-2-2013:p1359:b003:l011","ordinal":291263,"en":"Never returned without drinking blood."},{"id":"semetey-2-2013:p1359:b003:l012","ordinal":291264,"en":"When eagerly drawn from its sheath,"},{"id":"semetey-2-2013:p1359:b003:l013","ordinal":291265,"en":"Its reach lengthened with every stroke;"},{"id":"semetey-2-2013:p1359:b003:l014","ordinal":291266,"en":"Its blue-green edge glowed red,"},{"id":"semetey-2-2013:p1359:b003:l015","ordinal":291267,"en":"And set the grass afire when laid upon it."},{"id":"semetey-2-2013:p1359:b003:l016","ordinal":291268,"en":"Whatever it struck was cut down at once;"},{"id":"semetey-2-2013:p1359:b003:l017","ordinal":291269,"en":"Struck against stone, it raised dust,"},{"id":"semetey-2-2013:p1359:b003:l018","ordinal":291270,"en":"Struck against man, it drew blood."},{"id":"semetey-2-2013:p1359:b003:l019","ordinal":291271,"en":"From renowned Manas of old,"},{"id":"semetey-2-2013:p1359:b003:l020","ordinal":291272,"en":"Zulpukor remained as an heirloom."},{"id":"semetey-2-2013:p1359:b003:l021","ordinal":291273,"en":"Her necklace rattling on her breast,"},{"id":"semetey-2-2013:p1359:b003:l022","ordinal":291274,"en":"The wretched woman, heedless of all,"},{"id":"semetey-2-2013:p1359:b003:l023","ordinal":291275,"en":"Her camel-calf eyes flashing,"},{"id":"semetey-2-2013:p1359:b003:l024","ordinal":291276,"en":"Made early words become late deeds;"},{"id":"semetey-2-2013:p1359:b003:l025","ordinal":291277,"en":"To strike down brave Kyyaz,"},{"id":"semetey-2-2013:p1359:b003:l026","ordinal":291278,"en":"The renowned infidel Chürök"},{"id":"semetey-2-2013:p1359:b003:l027","ordinal":291279,"en":"Watched with all her eyes."},{"id":"semetey-2-2013:p1359:b003:l028","ordinal":291280,"en":"Kyyaz of the Jediger,"},{"id":"semetey-2-2013:p1359:b003:l029","ordinal":291281,"en":"Your sister-in-law stood watching."},{"id":"semetey-2-2013:p1359:b003:l030","ordinal":291282,"en":"Without drawing near that sorceress,"},{"id":"semetey-2-2013:p1359:b003:l031","ordinal":291283,"en":"Brave Kyyaz stood apart."},{"id":"semetey-2-2013:p1359:b003:l032","ordinal":291284,"en":"He could not approach the raging woman,"},{"id":"semetey-2-2013:p1359:b003:l033","ordinal":291285,"en":"Could not endure her cold,"},{"id":"semetey-2-2013:p1359:b003:l034","ordinal":291286,"en":"Could not lie down in her heat;"},{"id":"semetey-2-2013:p1359:b003:l035","ordinal":291287,"en":"At the disposition of that fairy-born woman"},{"id":"semetey-2-2013:p1359:b003:l036","ordinal":291288,"en":"He stood astonished."},{"id":"semetey-2-2013:p1359:b003:l037","ordinal":291289,"en":"To the sly, alluring beauty"},{"id":"semetey-2-2013:p1359:b003:l038","ordinal":291290,"en":"He could not cast his cold noose;"},{"id":"semetey-2-2013:p1359:b003:l039","ordinal":291291,"en":"He could not face and seize"},{"id":"semetey-2-2013:p1359:b004:l001","ordinal":291292,"en":"The beautiful woman Chürök."},{"id":"semetey-2-2013:p1359:b004:l002","ordinal":291293,"en":"He could not draw near the brow"},{"id":"semetey-2-2013:p1359:b004:l003","ordinal":291294,"en":"Of the bitch he had never desired."},{"id":"semetey-2-2013:p1359:b004:l004","ordinal":291295,"en":"Brave Kyyaz of the Jediger,"},{"id":"semetey-2-2013:p1359:b004:l005","ordinal":291296,"en":"When he saw Aichürök,"},{"id":"semetey-2-2013:p1359:b004:l006","ordinal":291297,"en":"Took in the grace of her form"},{"id":"semetey-2-2013:p1359:b004:l007","ordinal":291298,"en":"And marveled at her beauty."},{"id":"semetey-2-2013:p1359:b004:l008","ordinal":291299,"en":"Moonlike Aichürök"},{"id":"semetey-2-2013:p1359:b004:l009","ordinal":291300,"en":"Was no ordinary mortal."},{"id":"semetey-2-2013:p1359:b004:l010","ordinal":291301,"en":"Because of what had happened before,"},{"id":"semetey-2-2013:p1359:b004:l011","ordinal":291302,"en":"Because of Aichürök,"},{"id":"semetey-2-2013:p1359:b004:l012","ordinal":291303,"en":"The gathered people had quarreled;"},{"id":"semetey-2-2013:p1359:b004:l013","ordinal":291304,"en":"It seemed fitting that they should perish."},{"id":"semetey-2-2013:p1359:b004:l014","ordinal":291305,"en":"She was beauty in perfect form,"},{"id":"semetey-2-2013:p1359:b004:l015","ordinal":291306,"en":"The very one to inspire longing,"},{"id":"semetey-2-2013:p1359:b004:l016","ordinal":291307,"en":"A soul surpassing humankind;"},{"id":"semetey-2-2013:p1359:b004:l017","ordinal":291308,"en":"Chynkojo and Toltoy both had died"},{"id":"semetey-2-2013:p1359:b004:l018","ordinal":291309,"en":"While contending for her."},{"id":"semetey-2-2013:p1359:b004:l019","ordinal":291310,"en":"As a wife she had divided nations;"},{"id":"semetey-2-2013:p1359:b004:l020","ordinal":291311,"en":"As a maiden, this Chürök"},{"id":"semetey-2-2013:p1359:b004:l021","ordinal":291312,"en":"Had shaken custom and divided peoples."},{"id":"semetey-2-2013:p1359:b004:l022","ordinal":291313,"en":"She was a being radiant as the sun,"},{"id":"semetey-2-2013:p1359:b004:l023","ordinal":291314,"en":"Who set the world at strife"},{"id":"semetey-2-2013:p1359:b004:l024","ordinal":291315,"en":"And made slaughter seem ordained."},{"id":"semetey-2-2013:p1359:b004:l025","ordinal":291316,"en":"She was the very firebrand,"},{"id":"semetey-2-2013:p1359:b004:l026","ordinal":291317,"en":"Aichürök, for whom men died,"},{"id":"semetey-2-2013:p1359:b004:l027","ordinal":291318,"en":"With deep black eyes."},{"id":"semetey-2-2013:p1359:b004:l028","ordinal":291319,"en":"To keep calling Chürök merely “Chürök”"},{"id":"semetey-2-2013:p1359:b004:l029","ordinal":291320,"en":"Was a God-stricken saying."},{"id":"semetey-2-2013:p1359:b004:l030","ordinal":291321,"en":"She was Chürök who could enter"},{"id":"semetey-2-2013:p1359:b004:l031","ordinal":291322,"en":"Great revels and games!"},{"id":"semetey-2-2013:p1359:b004:l032","ordinal":291323,"en":"She was Chürök who could lie"},{"id":"semetey-2-2013:p1359:b004:l033","ordinal":291324,"en":"And converse in a narrow bed!"},{"id":"semetey-2-2013:p1359:b004:l034","ordinal":291325,"en":"She was Chürök who could preside"},{"id":"semetey-2-2013:p1359:b004:l035","ordinal":291326,"en":"Over pure play and mighty passion!"},{"id":"semetey-2-2013:p1359:b004:l036","ordinal":291327,"en":"She was Chürök who could satisfy"},{"id":"semetey-2-2013:p1359:b004:l037","ordinal":291328,"en":"The desire of the man who possessed her!"}]
