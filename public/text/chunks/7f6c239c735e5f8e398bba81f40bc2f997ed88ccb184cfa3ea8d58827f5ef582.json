[{"id":"semetey-2-2013:p0029:b004:l005","ordinal":187393,"en":"You have come to behold it;"},{"id":"semetey-2-2013:p0029:b004:l006","ordinal":187394,"en":"You have come from the Kakan"},{"id":"semetey-2-2013:p0029:b004:l007","ordinal":187395,"en":"To die, without remaining alive."},{"id":"semetey-2-2013:p0029:b004:l008","ordinal":187396,"en":"I am the valiant man who drew bows"},{"id":"semetey-2-2013:p0029:b004:l009","ordinal":187397,"en":"Like pouring rain against"},{"id":"semetey-2-2013:p0029:b004:l010","ordinal":187398,"en":"Your rash father Manas;"},{"id":"semetey-2-2013:p0029:b004:l011","ordinal":187399,"en":"I am the valiant man who inflicted"},{"id":"semetey-2-2013:p0029:b004:l012","ordinal":187400,"en":"Humiliation no person had ever seen!"},{"id":"semetey-2-2013:p0029:b004:l013","ordinal":187401,"en":"You have come to behold"},{"id":"semetey-2-2013:p0029:b004:l014","ordinal":187402,"en":"The wrath of Karagul."},{"id":"semetey-2-2013:p0029:b004:l015","ordinal":187403,"en":"Great rash son of the Bloodthirsty One,"},{"id":"semetey-2-2013:p0029:b004:l016","ordinal":187404,"en":"You have come here to die!”"},{"id":"semetey-2-2013:p0029:b004:l017","ordinal":187405,"en":"Saying this, Karagul"},{"id":"semetey-2-2013:p0029:b004:l018","ordinal":187406,"en":"Now gathered his courage."},{"id":"semetey-2-2013:p0029:b004:l019","ordinal":187407,"en":"A forty-fathom lasso with a black strap,"},{"id":"semetey-2-2013:p0029:b004:l020","ordinal":187408,"en":"A catch-rope made of birch—"},{"id":"semetey-2-2013:p0029:b004:l021","ordinal":187409,"en":"He spat upon his hand and grasped it,"},{"id":"semetey-2-2013:p0029:b004:l022","ordinal":187410,"en":"Held the narrow end and swung it,"},{"id":"semetey-2-2013:p0029:b004:l023","ordinal":187411,"en":"And with its thick end struck the hero,"},{"id":"semetey-2-2013:p0029:b004:l024","ordinal":187412,"en":"Sending it crashing against his crown."},{"id":"semetey-2-2013:p0029:b004:l025","ordinal":187413,"en":"What else could a slave devour?"},{"id":"semetey-2-2013:p0029:b004:l026","ordinal":187414,"en":"Semetey stood grieving;"},{"id":"semetey-2-2013:p0029:b004:l027","ordinal":187415,"en":"A full span of scalp"},{"id":"semetey-2-2013:p0029:b004:l028","ordinal":187416,"en":"Had been torn away."},{"id":"semetey-2-2013:p0029:b004:l029","ordinal":187417,"en":"Then Semetey—"},{"id":"semetey-2-2013:p0029:b004:l030","ordinal":187418,"en":"Have you heard of him?—"},{"id":"semetey-2-2013:p0029:b004:l031","ordinal":187419,"en":"Offspring of the blood-drinker,"},{"id":"semetey-2-2013:p0029:b004:l032","ordinal":187420,"en":"Offspring of the accursed one"},{"id":"semetey-2-2013:p0029:b004:l033","ordinal":187421,"en":"Who set fire to grassy land,"},{"id":"semetey-2-2013:p0029:b004:l034","ordinal":187422,"en":"Manas the leopard’s own son,"},{"id":"semetey-2-2013:p0029:b004:l035","ordinal":187423,"en":"Who poured blood into black water,"},{"id":"semetey-2-2013:p0029:b004:l036","ordinal":187424,"en":"Who set the tussocked land ablaze,"},{"id":"semetey-2-2013:p0029:b004:l037","ordinal":187425,"en":"Who cut off a head when told, “Take his cap,”"},{"id":"semetey-2-2013:p0029:b004:l038","ordinal":187426,"en":"Who spilled a life when told, “Spill blood,”"},{"id":"semetey-2-2013:p0029:b004:l039","ordinal":187427,"en":"Who seized the grief-stricken—"},{"id":"semetey-2-2013:p0030:b003:l001","ordinal":187428,"en":"When his wrath was roused,"},{"id":"semetey-2-2013:p0030:b003:l002","ordinal":187429,"en":"He killed his own father."},{"id":"semetey-2-2013:p0030:b003:l003","ordinal":187430,"en":"Hot blood reached his nostrils;"},{"id":"semetey-2-2013:p0030:b003:l004","ordinal":187431,"en":"From his neck and jaw"},{"id":"semetey-2-2013:p0030:b003:l005","ordinal":187432,"en":"Blood streamed like a saddle-strap."},{"id":"semetey-2-2013:p0030:b003:l006","ordinal":187433,"en":"He flared higher whenever diminished,"},{"id":"semetey-2-2013:p0030:b003:l007","ordinal":187434,"en":"And multiplied whenever slain—"},{"id":"semetey-2-2013:p0030:b003:l008","ordinal":187435,"en":"The accursed one’s own son."},{"id":"semetey-2-2013:p0030:b003:l009","ordinal":187436,"en":"When the lasso struck his head,"},{"id":"semetey-2-2013:p0030:b003:l010","ordinal":187437,"en":"He shouted in fury,"},{"id":"semetey-2-2013:p0030:b003:l011","ordinal":187438,"en":"Invoking the name of Manas,"},{"id":"semetey-2-2013:p0030:b003:l012","ordinal":187439,"en":"Who had gone to the other world:"},{"id":"semetey-2-2013:p0030:b003:l013","ordinal":187440,"en":"“Frenzied slave, is it you?"},{"id":"semetey-2-2013:p0030:b003:l014","ordinal":187441,"en":"May I die if my strength does not suffice!"},{"id":"semetey-2-2013:p0030:b003:l015","ordinal":187442,"en":"Wrathful Karagul,"},{"id":"semetey-2-2013:p0030:b003:l016","ordinal":187443,"en":"Let me test myself against you."},{"id":"semetey-2-2013:p0030:b003:l017","ordinal":187444,"en":"I will pull the reins"},{"id":"semetey-2-2013:p0030:b003:l018","ordinal":187445,"en":"And turn the ever-ready Taibuurul,"},{"id":"semetey-2-2013:p0030:b003:l019","ordinal":187446,"en":"Then drive you toward Beijing."},{"id":"semetey-2-2013:p0030:b003:l020","ordinal":187447,"en":"After making me pay beyond all measure,"},{"id":"semetey-2-2013:p0030:b003:l021","ordinal":187448,"en":"After splitting my head open,"},{"id":"semetey-2-2013:p0030:b003:l022","ordinal":187449,"en":"How can I remain alive!”"},{"id":"semetey-2-2013:p0030:b003:l023","ordinal":187450,"en":"The splendid lion, proud as a rooster,"},{"id":"semetey-2-2013:p0030:b003:l024","ordinal":187451,"en":"The noble hero who would not be moved—"},{"id":"semetey-2-2013:p0030:b003:l025","ordinal":187452,"en":"After his father Manas died,"},{"id":"semetey-2-2013:p0030:b003:l026","ordinal":187453,"en":"He settled and took possession of Talas;"},{"id":"semetey-2-2013:p0030:b003:l027","ordinal":187454,"en":"Living as an orphan, he grew to manhood"},{"id":"semetey-2-2013:p0030:b003:l028","ordinal":187455,"en":"And became hero Semetey."},{"id":"semetey-2-2013:p0030:b003:l029","ordinal":187456,"en":"He had not yet died of shame,"},{"id":"semetey-2-2013:p0030:b003:l030","ordinal":187457,"en":"And had never before seen"},{"id":"semetey-2-2013:p0030:b003:l031","ordinal":187458,"en":"Such humiliation upon the earth."},{"id":"semetey-2-2013:p0030:b003:l032","ordinal":187459,"en":"Without looking around him,"},{"id":"semetey-2-2013:p0030:b003:l033","ordinal":187460,"en":"Without sparing his life at all,"},{"id":"semetey-2-2013:p0030:b003:l034","ordinal":187461,"en":"Without glancing about,"},{"id":"semetey-2-2013:p0030:b003:l035","ordinal":187462,"en":"Your champion, son of the mighty man,"},{"id":"semetey-2-2013:p0030:b003:l036","ordinal":187463,"en":"Did not value his life as much as a hair."},{"id":"semetey-2-2013:p0030:b003:l037","ordinal":187464,"en":"He hurriedly put on bulletproof Akolpok"},{"id":"semetey-2-2013:p0030:b003:l038","ordinal":187465,"en":"Without even shaking it out,"},{"id":"semetey-2-2013:p0030:b003:l039","ordinal":187466,"en":"And mounted the playful Buurul"},{"id":"semetey-2-2013:p0030:b005:l001","ordinal":187467,"en":"Bare-backed at a bound."},{"id":"semetey-2-2013:p0030:b005:l002","ordinal":187468,"en":"He seized and swung"},{"id":"semetey-2-2013:p0030:b005:l003","ordinal":187469,"en":"The white whip with a black handle,"},{"id":"semetey-2-2013:p0030:b005:l004","ordinal":187470,"en":"And struck Buurul’s flank,"},{"id":"semetey-2-2013:p0030:b005:l005","ordinal":187471,"en":"Making it ring out, “Kang!”"},{"id":"semetey-2-2013:p0030:b005:l006","ordinal":187472,"en":"With no spear and only a whip,"},{"id":"semetey-2-2013:p0030:b005:l007","ordinal":187473,"en":"The leopard’s offspring"},{"id":"semetey-2-2013:p0030:b005:l008","ordinal":187474,"en":"Set out to chase Karagul almost naked."},{"id":"semetey-2-2013:p0030:b005:l009","ordinal":187475,"en":"He looked neither uphill nor down,"},{"id":"semetey-2-2013:p0030:b005:l010","ordinal":187476,"en":"Gave no thought to dying,"},{"id":"semetey-2-2013:p0030:b005:l011","ordinal":187477,"en":"And raced in fury."},{"id":"semetey-2-2013:p0030:b005:l012","ordinal":187478,"en":"As though the horse could understand speech,"},{"id":"semetey-2-2013:p0030:b005:l013","ordinal":187479,"en":"He pleaded with Buurul:"},{"id":"semetey-2-2013:p0030:b005:l014","ordinal":187480,"en":"“My beloved Arbuudan,"},{"id":"semetey-2-2013:p0030:b005:l015","ordinal":187481,"en":"Lower your head toward the ground"},{"id":"semetey-2-2013:p0030:b005:l016","ordinal":187482,"en":"And take a different kind of stride."},{"id":"semetey-2-2013:p0030:b005:l017","ordinal":187483,"en":"To the one who has never squatted down to urinate,"},{"id":"semetey-2-2013:p0030:b005:l018","ordinal":187484,"en":"Whose sleeve has never touched the ground."},{"id":"semetey-2-2013:p0030:b005:l019","ordinal":187485,"en":"That infidel son of Katal—"},{"id":"semetey-2-2013:p0030:b005:l020","ordinal":187486,"en":"Bring me up to him once."},{"id":"semetey-2-2013:p0030:b005:l021","ordinal":187487,"en":"Lower your neck toward the earth,"},{"id":"semetey-2-2013:p0030:b005:l022","ordinal":187488,"en":"My beloved noble thoroughbred,"},{"id":"semetey-2-2013:p0030:b005:l023","ordinal":187489,"en":"And take a stride beyond all measure."},{"id":"semetey-2-2013:p0030:b005:l024","ordinal":187490,"en":"That infidel son of Kaldai,"},{"id":"semetey-2-2013:p0030:b005:l025","ordinal":187491,"en":"Hero Khan Kongurbai—"},{"id":"semetey-2-2013:p0030:b005:l026","ordinal":187492,"en":"His Black Horse ridden on patrol,"},{"id":"semetey-2-2013:p0030:b005:l027","ordinal":187493,"en":"Bring me up to it once!"},{"id":"semetey-2-2013:p0030:b005:l028","ordinal":187494,"en":"I raise argamaks and horses;"},{"id":"semetey-2-2013:p0030:b005:l029","ordinal":187495,"en":"May I circle in devotion, Buurul,"},{"id":"semetey-2-2013:p0030:b005:l030","ordinal":187496,"en":"Around a thoroughbred like you!"},{"id":"semetey-2-2013:p0030:b005:l031","ordinal":187497,"en":"I gathered champions and heroes;"},{"id":"semetey-2-2013:p0030:b005:l032","ordinal":187498,"en":"May I circle around a kinsman like you!"},{"id":"semetey-2-2013:p0030:b005:l033","ordinal":187499,"en":"When he made me pay beyond all measure,"},{"id":"semetey-2-2013:p0030:b005:l034","ordinal":187500,"en":"When he split my head open,"},{"id":"semetey-2-2013:p0030:b005:l035","ordinal":187501,"en":"If only he had turned his neck before me,"},{"id":"semetey-2-2013:p0030:b005:l036","ordinal":187502,"en":"If only Külchoro had stood and watched—"},{"id":"semetey-2-2013:p0030:b005:l037","ordinal":187503,"en":"Would that thundering Karagul"},{"id":"semetey-2-2013:p0030:b005:l038","ordinal":187504,"en":"Then have dared commit this deed?"},{"id":"semetey-2-2013:p0030:b005:l039","ordinal":187505,"en":"The dream he saw had turned baleful—"},{"id":"semetey-2-2013:p0031:b003:l001","ordinal":187506,"en":"“Have you heard of the deed"},{"id":"semetey-2-2013:p0031:b003:l002","ordinal":187507,"en":"Of the man who came on patrol and split my head?”"},{"id":"semetey-2-2013:p0031:b003:l003","ordinal":187508,"en":"Turning wrathful and transformed,"},{"id":"semetey-2-2013:p0031:b003:l004","ordinal":187509,"en":"Ready to tear Karagul apart if he caught him,"},{"id":"semetey-2-2013:p0031:b003:l005","ordinal":187510,"en":"He spoke threats against him."},{"id":"semetey-2-2013:p0031:b003:l006","ordinal":187511,"en":"Breaking the ground beneath his tread,"},{"id":"semetey-2-2013:p0031:b003:l007","ordinal":187512,"en":"The noble lord mounted Buurul bare-backed"},{"id":"semetey-2-2013:p0031:b003:l008","ordinal":187513,"en":"And raced away."},{"id":"semetey-2-2013:p0031:b003:l009","ordinal":187514,"en":"Such was the nature of Buurul:"},{"id":"semetey-2-2013:p0031:b003:l010","ordinal":187515,"en":"His destiny was to be ridden into battle;"},{"id":"semetey-2-2013:p0031:b003:l011","ordinal":187516,"en":"That bastard horse Buurul"},{"id":"semetey-2-2013:p0031:b003:l012","ordinal":187517,"en":"Was Semetey’s wing."},{"id":"semetey-2-2013:p0031:b003:l013","ordinal":187518,"en":"It was his custom to chase down"},{"id":"semetey-2-2013:p0031:b003:l014","ordinal":187519,"en":"An enemy who fled before him."},{"id":"semetey-2-2013:p0031:b003:l015","ordinal":187520,"en":"There was no hillock as large as an ankle-bone,"},{"id":"semetey-2-2013:p0031:b003:l016","ordinal":187521,"en":"No hollow as broad as a saddlecloth,"},{"id":"semetey-2-2013:p0031:b003:l017","ordinal":187522,"en":"No furrow touched by a plow,"},{"id":"semetey-2-2013:p0031:b003:l018","ordinal":187523,"en":"No burrow dug by a marmot;"},{"id":"semetey-2-2013:p0031:b003:l019","ordinal":187524,"en":"Whenever he came upon such terrain,"},{"id":"semetey-2-2013:p0031:b003:l020","ordinal":187525,"en":"It was his custom to run all the harder."},{"id":"semetey-2-2013:p0031:b003:l021","ordinal":187526,"en":"If the desert was forty days across,"},{"id":"semetey-2-2013:p0031:b003:l022","ordinal":187527,"en":"If the country was harsh and difficult,"},{"id":"semetey-2-2013:p0031:b003:l023","ordinal":187528,"en":"It was his custom to endure."},{"id":"semetey-2-2013:p0031:b003:l024","ordinal":187529,"en":"When he saw the hero’s bearing"},{"id":"semetey-2-2013:p0031:b003:l025","ordinal":187530,"en":"And reached the rolling ridges,"},{"id":"semetey-2-2013:p0031:b003:l026","ordinal":187531,"en":"Buurul lengthened his stride;"},{"id":"semetey-2-2013:p0031:b003:l027","ordinal":187532,"en":"His legs drove down like an argali’s."},{"id":"semetey-2-2013:p0031:b003:l028","ordinal":187533,"en":"When he began to climb uphill,"},{"id":"semetey-2-2013:p0031:b003:l029","ordinal":187534,"en":"His mane and tail spread wide."},{"id":"semetey-2-2013:p0031:b003:l030","ordinal":187535,"en":"Kongurbai’s Algara"},{"id":"semetey-2-2013:p0031:b003:l031","ordinal":187536,"en":"Thundered his hooves upon the ground;"},{"id":"semetey-2-2013:p0031:b003:l032","ordinal":187537,"en":"In Semetey’s horse Buurul’s throat,"},{"id":"semetey-2-2013:p0031:b003:l033","ordinal":187538,"en":"The black-steel bit"},{"id":"semetey-2-2013:p0031:b003:l034","ordinal":187539,"en":"Clattered against his palate."},{"id":"semetey-2-2013:p0031:b003:l035","ordinal":187540,"en":"When they entered the downslope,"},{"id":"semetey-2-2013:p0031:b003:l036","ordinal":187541,"en":"Kongurbai’s Algara"},{"id":"semetey-2-2013:p0031:b003:l037","ordinal":187542,"en":"Ran far ahead, shimmering like a mirage."},{"id":"semetey-2-2013:p0031:b003:l038","ordinal":187543,"en":"When they began to climb uphill,"},{"id":"semetey-2-2013:p0031:b003:l039","ordinal":187544,"en":"Semetey’s Buurul"},{"id":"semetey-2-2013:p0031:b004:l001","ordinal":187545,"en":"Closed upon his heels and hemmed him in."},{"id":"semetey-2-2013:p0031:b004:l002","ordinal":187546,"en":"Buurul ran in haste;"},{"id":"semetey-2-2013:p0031:b004:l003","ordinal":187547,"en":"When Karagul, son of Katal,"},{"id":"semetey-2-2013:p0031:b004:l004","ordinal":187548,"en":"Saw how he ran,"},{"id":"semetey-2-2013:p0031:b004:l005","ordinal":187549,"en":"“What has happened to that dog?” he said."},{"id":"semetey-2-2013:p0031:b004:l006","ordinal":187550,"en":"Despairing of his splendid life,"},{"id":"semetey-2-2013:p0031:b004:l007","ordinal":187551,"en":"He crossed rough, hummocked ground,"},{"id":"semetey-2-2013:p0031:b004:l008","ordinal":187552,"en":"Passed over rugged, rolling ridges,"},{"id":"semetey-2-2013:p0031:b004:l009","ordinal":187553,"en":"And the mighty man fled before him."},{"id":"semetey-2-2013:p0031:b004:l010","ordinal":187554,"en":"Such was the precious sight:"},{"id":"semetey-2-2013:p0031:b004:l011","ordinal":187555,"en":"The two went like bride and groom."},{"id":"semetey-2-2013:p0031:b004:l012","ordinal":187556,"en":"They traveled on through haze"},{"id":"semetey-2-2013:p0031:b004:l013","ordinal":187557,"en":"Over rugged ridges;"},{"id":"semetey-2-2013:p0031:b004:l014","ordinal":187558,"en":"The coursers dug up"},{"id":"semetey-2-2013:p0031:b004:l015","ordinal":187559,"en":"The black earth as they went."},{"id":"semetey-2-2013:p0031:b004:l016","ordinal":187560,"en":"Algara and Karagul"},{"id":"semetey-2-2013:p0031:b004:l017","ordinal":187561,"en":"Hurried onward."},{"id":"semetey-2-2013:p0031:b004:l018","ordinal":187562,"en":"They traveled through a hazy land"},{"id":"semetey-2-2013:p0031:b004:l019","ordinal":187563,"en":"Beyond the reach of sight."},{"id":"semetey-2-2013:p0031:b004:l020","ordinal":187564,"en":"They traveled through the desert,"},{"id":"semetey-2-2013:p0031:b004:l021","ordinal":187565,"en":"Ending in a dim and hazy point."},{"id":"semetey-2-2013:p0031:b004:l022","ordinal":187566,"en":"They went along the far side"},{"id":"semetey-2-2013:p0031:b004:l023","ordinal":187567,"en":"Of rugged ridges"},{"id":"semetey-2-2013:p0031:b004:l024","ordinal":187568,"en":"And level uplands beyond sight."},{"id":"semetey-2-2013:p0031:b004:l025","ordinal":187569,"en":"Such was the nature of the courser;"},{"id":"semetey-2-2013:p0031:b004:l026","ordinal":187570,"en":"Karagul, who had deceived the hero,"},{"id":"semetey-2-2013:p0031:b004:l027","ordinal":187571,"en":"Put his trust in his racer"},{"id":"semetey-2-2013:p0031:b004:l028","ordinal":187572,"en":"And fled in boundless haste."},{"id":"semetey-2-2013:p0031:b004:l029","ordinal":187573,"en":"Where Algara’s and Taibuurul’s"},{"id":"semetey-2-2013:p0031:b004:l030","ordinal":187574,"en":"Hooves struck squarely,"},{"id":"semetey-2-2013:p0031:b004:l031","ordinal":187575,"en":"The ground was cut like a great canal;"},{"id":"semetey-2-2013:p0031:b004:l032","ordinal":187576,"en":"Their precisely planted tracks"},{"id":"semetey-2-2013:p0031:b004:l033","ordinal":187577,"en":"Were carved like the hull of a ship."},{"id":"semetey-2-2013:p0031:b004:l034","ordinal":187578,"en":"Such was the nature of the coursers:"},{"id":"semetey-2-2013:p0031:b004:l035","ordinal":187579,"en":"Their mouths gaped like saws,"},{"id":"semetey-2-2013:p0031:b004:l036","ordinal":187580,"en":"And blood-mingled white foam"},{"id":"semetey-2-2013:p0031:b004:l037","ordinal":187581,"en":"From the bereft, ill-fated horse"},{"id":"semetey-2-2013:p0031:b004:l038","ordinal":187582,"en":"Scattered across his breast."},{"id":"semetey-2-2013:p0031:b004:l039","ordinal":187583,"en":"Toward Dyngsha on this side of Beijing,"},{"id":"semetey-2-2013:p0032:b003:l001","ordinal":187584,"en":"He went onward, leaning low;"},{"id":"semetey-2-2013:p0032:b003:l002","ordinal":187585,"en":"His forelock tangled and matted,"},{"id":"semetey-2-2013:p0032:b003:l003","ordinal":187586,"en":"His splendid head, broad as a basin,"},{"id":"semetey-2-2013:p0032:b003:l004","ordinal":187587,"en":"Was covered in red dust."},{"id":"semetey-2-2013:p0032:b003:l005","ordinal":187588,"en":"They lowered their heads toward the earth"},{"id":"semetey-2-2013:p0032:b003:l006","ordinal":187589,"en":"And ran in an extraordinary way;"},{"id":"semetey-2-2013:p0032:b003:l007","ordinal":187590,"en":"They stretched their necks toward the ground"},{"id":"semetey-2-2013:p0032:b003:l008","ordinal":187591,"en":"And took strides beyond measure."},{"id":"semetey-2-2013:p0032:b003:l009","ordinal":187592,"en":"Algara and noble Buurul—"},{"id":"semetey-2-2013:p0032:b003:l010","ordinal":187593,"en":"No wind could match their gallop,"},{"id":"semetey-2-2013:p0032:b003:l011","ordinal":187594,"en":"No beast could match their tread."},{"id":"semetey-2-2013:p0032:b003:l012","ordinal":187595,"en":"When they reached certain places,"},{"id":"semetey-2-2013:p0032:b003:l013","ordinal":187596,"en":"A ground-hugging fog rose like a mirage."},{"id":"semetey-2-2013:p0032:b003:l014","ordinal":187597,"en":"Such was the nature of the racer:"},{"id":"semetey-2-2013:p0032:b003:l015","ordinal":187598,"en":"The Bloodthirsty One’s Buurul"},{"id":"semetey-2-2013:p0032:b003:l016","ordinal":187599,"en":"Drew near to Algara."},{"id":"semetey-2-2013:p0032:b003:l017","ordinal":187600,"en":"Look well upon the plight of Karagul,"},{"id":"semetey-2-2013:p0032:b003:l018","ordinal":187601,"en":"This doomed man here!"},{"id":"semetey-2-2013:p0032:b003:l019","ordinal":187602,"en":"His speech was clear when he spoke;"},{"id":"semetey-2-2013:p0032:b003:l020","ordinal":187603,"en":"Keen-eyed, he was a judge of horses."},{"id":"semetey-2-2013:p0032:b003:l021","ordinal":187604,"en":"When he saw the speed"},{"id":"semetey-2-2013:p0032:b003:l022","ordinal":187605,"en":"Of Buurul beneath Semetey,"},{"id":"semetey-2-2013:p0032:b003:l023","ordinal":187606,"en":"He feared a messenger"},{"id":"semetey-2-2013:p0032:b003:l024","ordinal":187607,"en":"Of Kakanchin’s Beijing might hear,"},{"id":"semetey-2-2013:p0032:b003:l025","ordinal":187608,"en":"Or, if not that dog, a scout"},{"id":"semetey-2-2013:p0032:b003:l026","ordinal":187609,"en":"Might come out before him."},{"id":"semetey-2-2013:p0032:b003:l027","ordinal":187610,"en":"He feared they would begin a fierce spear-fight"},{"id":"semetey-2-2013:p0032:b003:l028","ordinal":187611,"en":"And separate him"},{"id":"semetey-2-2013:p0032:b003:l029","ordinal":187612,"en":"From the champion son of the Bloodthirsty One."},{"id":"semetey-2-2013:p0032:b003:l030","ordinal":187613,"en":"Shouting in fury,"},{"id":"semetey-2-2013:p0032:b003:l031","ordinal":187614,"en":"Raising the battle cry, “Kakan!”"},{"id":"semetey-2-2013:p0032:b003:l032","ordinal":187615,"en":"He crossed and went beyond"},{"id":"semetey-2-2013:p0032:b003:l033","ordinal":187616,"en":"A pass shaped like a saddle-back."},{"id":"semetey-2-2013:p0032:b003:l034","ordinal":187617,"en":"“If my wretched life falls into his hands,"},{"id":"semetey-2-2013:p0032:b003:l035","ordinal":187618,"en":"What dreadful thing will happen?”"},{"id":"semetey-2-2013:p0032:b003:l036","ordinal":187619,"en":"Thinking this, Karagul"},{"id":"semetey-2-2013:p0032:b003:l037","ordinal":187620,"en":"Fled onward in haste—"},{"id":"semetey-2-2013:p0032:b003:l038","ordinal":187621,"en":"Karagul, chief of the horse herders,"},{"id":"semetey-2-2013:p0032:b003:l039","ordinal":187622,"en":"This one doomed to vanish."},{"id":"semetey-2-2013:p0032:b005:l001","ordinal":187623,"en":"When he saw Buurul’s bearing,"},{"id":"semetey-2-2013:p0032:b005:l002","ordinal":187624,"en":"Fearing the raging Burut would catch him,"},{"id":"semetey-2-2013:p0032:b005:l003","ordinal":187625,"en":"Fearing he would cut off his head,"},{"id":"semetey-2-2013:p0032:b005:l004","ordinal":187626,"en":"He fled onward."},{"id":"semetey-2-2013:p0032:b005:l005","ordinal":187627,"en":"“Will I catch him?” Buurul wondered,"},{"id":"semetey-2-2013:p0032:b005:l006","ordinal":187628,"en":"And raced in haste."},{"id":"semetey-2-2013:p0032:b005:l007","ordinal":187629,"en":"Lengthening his stride like an argali,"},{"id":"semetey-2-2013:p0032:b005:l008","ordinal":187630,"en":"His eyes reddening like a lion’s,"},{"id":"semetey-2-2013:p0032:b005:l009","ordinal":187631,"en":"The land streamed by like a mirage;"},{"id":"semetey-2-2013:p0032:b005:l010","ordinal":187632,"en":"The creature ran like a gazelle,"},{"id":"semetey-2-2013:p0032:b005:l011","ordinal":187633,"en":"Drew near to Karagul,"},{"id":"semetey-2-2013:p0032:b005:l012","ordinal":187634,"en":"And came close upon his heels."},{"id":"semetey-2-2013:p0032:b005:l013","ordinal":187635,"en":"At that time Karagul—"},{"id":"semetey-2-2013:p0032:b005:l014","ordinal":187636,"en":"Such was the plight of Karagul—"},{"id":"semetey-2-2013:p0032:b005:l015","ordinal":187637,"en":"Longed desperately to reach"},{"id":"semetey-2-2013:p0032:b005:l016","ordinal":187638,"en":"The city of the Kakanchin."},{"id":"semetey-2-2013:p0032:b005:l017","ordinal":187639,"en":"Out on the plain on this side,"},{"id":"semetey-2-2013:p0032:b005:l018","ordinal":187640,"en":"His heart became deeply troubled;"},{"id":"semetey-2-2013:p0032:b005:l019","ordinal":187641,"en":"Karagul floundered along,"},{"id":"semetey-2-2013:p0032:b005:l020","ordinal":187642,"en":"Looking as though he would die."},{"id":"semetey-2-2013:p0032:b005:l021","ordinal":187643,"en":"Algara ran sluggishly,"},{"id":"semetey-2-2013:p0032:b005:l022","ordinal":187644,"en":"And Karagul suffered bitterly."},{"id":"semetey-2-2013:p0032:b005:l023","ordinal":187645,"en":"His eyes darted wildly,"},{"id":"semetey-2-2013:p0032:b005:l024","ordinal":187646,"en":"And his legs began to dangle."},{"id":"semetey-2-2013:p0032:b005:l025","ordinal":187647,"en":"He struck Algara beneath him"},{"id":"semetey-2-2013:p0032:b005:l026","ordinal":187648,"en":"From side to side with his whip,"}]
