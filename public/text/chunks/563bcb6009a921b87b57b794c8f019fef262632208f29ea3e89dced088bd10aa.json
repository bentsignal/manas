[{"id":"semetey-1-2013:p0433:b003:l018","ordinal":110081,"en":"And light poured over the earth."},{"id":"semetey-1-2013:p0433:b003:l019","ordinal":110082,"en":"Birds rose as dawn broke,"},{"id":"semetey-1-2013:p0433:b003:l020","ordinal":110083,"en":"And the encircling Chinese appeared."},{"id":"semetey-1-2013:p0433:b003:l021","ordinal":110084,"en":"Kongurbay, son of Alooke,"},{"id":"semetey-1-2013:p0433:b003:l022","ordinal":110085,"en":"Also came out and rushed upon him."},{"id":"semetey-1-2013:p0433:b003:l023","ordinal":110086,"en":"Ezkara, khan of the Manchus,"},{"id":"semetey-1-2013:p0433:b003:l024","ordinal":110087,"en":"Orokkyr, khan of the Shibe,"},{"id":"semetey-1-2013:p0433:b003:l025","ordinal":110088,"en":"Hero Joloy, khan of the Kalmyks,"},{"id":"semetey-1-2013:p0433:b003:l026","ordinal":110089,"en":"The mass of hulking simpletons and swift runners"},{"id":"semetey-1-2013:p0433:b003:l027","ordinal":110090,"en":"Stirred up turmoil and swarmed thickly,"},{"id":"semetey-1-2013:p0433:b003:l028","ordinal":110091,"en":"Rushing in to torment him."},{"id":"semetey-1-2013:p0433:b003:l029","ordinal":110092,"en":"All those Chinese and many Kalmyks,"},{"id":"semetey-1-2013:p0433:b003:l030","ordinal":110093,"en":"Upon your khan father—"},{"id":"semetey-1-2013:p0433:b003:l031","ordinal":110094,"en":"Red-whipped Shypshaydar,"},{"id":"semetey-1-2013:p0433:b003:l032","ordinal":110095,"en":"The vast people of forty Chinese tribes,"},{"id":"semetey-1-2013:p0433:b003:l033","ordinal":110096,"en":"Who did not squat to urinate,"},{"id":"semetey-1-2013:p0433:b003:l034","ordinal":110097,"en":"Whose sleeves did not touch the ground,"},{"id":"semetey-1-2013:p0433:b003:l035","ordinal":110098,"en":"Of Allah Most High, the One,"},{"id":"semetey-1-2013:p0433:b003:l036","ordinal":110099,"en":"They knew neither existence nor oneness—"},{"id":"semetey-1-2013:p0433:b003:l037","ordinal":110100,"en":"Black Tiken and great Malgun,"},{"id":"semetey-1-2013:p0433:b003:l038","ordinal":110101,"en":"The Chinese khans rushed upon him,"},{"id":"semetey-1-2013:p0433:b003:l039","ordinal":110102,"en":"Saying they would seize your father."},{"id":"semetey-1-2013:p0433:b005:l001","ordinal":110103,"en":"So many wrestlers made ready."},{"id":"semetey-1-2013:p0433:b005:l002","ordinal":110104,"en":"Never sparing one he grappled with,"},{"id":"semetey-1-2013:p0433:b005:l003","ordinal":110105,"en":"By the flesh of a whole pig"},{"id":"semetey-1-2013:p0433:b005:l004","ordinal":110106,"en":"Never sated at one meal,"},{"id":"semetey-1-2013:p0433:b005:l005","ordinal":110107,"en":"Makil, huge as Mount Opol,"},{"id":"semetey-1-2013:p0433:b005:l006","ordinal":110108,"en":"Made ready on his right."},{"id":"semetey-1-2013:p0433:b005:l007","ordinal":110109,"en":"Shypshaydar and mighty Tiken,"},{"id":"semetey-1-2013:p0433:b005:l008","ordinal":110110,"en":"Upon your leopard father Manas,"},{"id":"semetey-1-2013:p0433:b005:l009","ordinal":110111,"en":"Khan Kongurbay, the fierce hero—"},{"id":"semetey-1-2013:p0433:b005:l010","ordinal":110112,"en":"All of them rushed in."},{"id":"semetey-1-2013:p0433:b005:l011","ordinal":110113,"en":"I, your unfortunate, ill-fated mother,"},{"id":"semetey-1-2013:p0433:b005:l012","ordinal":110114,"en":"From my blackcurrant eyes"},{"id":"semetey-1-2013:p0433:b005:l013","ordinal":110115,"en":"Shed tears a whip's length long."},{"id":"semetey-1-2013:p0433:b005:l014","ordinal":110116,"en":"My dear quail-like eyes"},{"id":"semetey-1-2013:p0433:b005:l015","ordinal":110117,"en":"Shed tears in separate streams."},{"id":"semetey-1-2013:p0433:b005:l016","ordinal":110118,"en":"Ready to die if struck by a bullet,"},{"id":"semetey-1-2013:p0433:b005:l017","ordinal":110119,"en":"If my death had come, with my generous lord"},{"id":"semetey-1-2013:p0433:b005:l018","ordinal":110120,"en":"To go and lie entwined,"},{"id":"semetey-1-2013:p0433:b005:l019","ordinal":110121,"en":"The black, white-blazed thoroughbred"},{"id":"semetey-1-2013:p0433:b005:l020","ordinal":110122,"en":"I spurred on either side,"},{"id":"semetey-1-2013:p0433:b005:l021","ordinal":110123,"en":"Lashing left and right with my whip,"},{"id":"semetey-1-2013:p0433:b005:l022","ordinal":110124,"en":"Roaring in fury."},{"id":"semetey-1-2013:p0433:b005:l023","ordinal":110125,"en":"Before the Chinese host, the enemy people,"},{"id":"semetey-1-2013:p0433:b005:l024","ordinal":110126,"en":"Concealing that I was a woman,"},{"id":"semetey-1-2013:p0433:b005:l025","ordinal":110127,"en":"I shouted the battle cry like a man."},{"id":"semetey-1-2013:p0433:b005:l026","ordinal":110128,"en":"The black, white-blazed winged steed—"},{"id":"semetey-1-2013:p0433:b005:l027","ordinal":110129,"en":"I drew its bit and turned it."},{"id":"semetey-1-2013:p0433:b005:l028","ordinal":110130,"en":"My painted spear with steel blades"},{"id":"semetey-1-2013:p0433:b005:l029","ordinal":110131,"en":"I leveled at the enemy with a shout."},{"id":"semetey-1-2013:p0433:b005:l030","ordinal":110132,"en":"I, your unfortunate mother,"},{"id":"semetey-1-2013:p0433:b005:l031","ordinal":110133,"en":"The black, white-blazed thoroughbred"},{"id":"semetey-1-2013:p0433:b005:l032","ordinal":110134,"en":"Pressed with my right knee."},{"id":"semetey-1-2013:p0433:b005:l033","ordinal":110135,"en":"At great Makil of the Black Chinese"},{"id":"semetey-1-2013:p0433:b005:l034","ordinal":110136,"en":"I then launched my attack."},{"id":"semetey-1-2013:p0433:b005:l035","ordinal":110137,"en":"The forty guards beside him—"},{"id":"semetey-1-2013:p0433:b005:l036","ordinal":110138,"en":"I brought all forty from their horses,"},{"id":"semetey-1-2013:p0433:b005:l037","ordinal":110139,"en":"Spearing them as I passed along the line."},{"id":"semetey-1-2013:p0433:b005:l038","ordinal":110140,"en":"Makil upon his great rhinoceros—"},{"id":"semetey-1-2013:p0433:b005:l039","ordinal":110141,"en":"I reached him from the flank,"},{"id":"semetey-1-2013:p0434:b003:l001","ordinal":110142,"en":"As soon as I reached Makil,"},{"id":"semetey-1-2013:p0434:b003:l002","ordinal":110143,"en":"The unbeliever upon the great rhinoceros,"},{"id":"semetey-1-2013:p0434:b003:l003","ordinal":110144,"en":"That hero as huge as a mountain—"},{"id":"semetey-1-2013:p0434:b003:l004","ordinal":110145,"en":"'At this edge of the broad belt,' I thought,"},{"id":"semetey-1-2013:p0434:b003:l005","ordinal":110146,"en":"'Opposite the lungs,' I thought."},{"id":"semetey-1-2013:p0434:b003:l006","ordinal":110147,"en":"My back bent over behind,"},{"id":"semetey-1-2013:p0434:b003:l007","ordinal":110148,"en":"My rib bones jutting out,"},{"id":"semetey-1-2013:p0434:b003:l008","ordinal":110149,"en":"Crying aloud and beating myself,"},{"id":"semetey-1-2013:p0434:b003:l009","ordinal":110150,"en":"Pleading with the true God,"},{"id":"semetey-1-2013:p0434:b003:l010","ordinal":110151,"en":"I reached that Makil."},{"id":"semetey-1-2013:p0434:b003:l011","ordinal":110152,"en":"The wrestler riding the rhinoceros"},{"id":"semetey-1-2013:p0434:b003:l012","ordinal":110153,"en":"Stretching out, I struck as I passed."},{"id":"semetey-1-2013:p0434:b003:l013","ordinal":110154,"en":"My spear broke into fragments,"},{"id":"semetey-1-2013:p0434:b003:l014","ordinal":110155,"en":"And from the great rhinoceros,"},{"id":"semetey-1-2013:p0434:b003:l015","ordinal":110156,"en":"That Makil, huge as Mount Opol,"},{"id":"semetey-1-2013:p0434:b003:l016","ordinal":110157,"en":"Fell, tumbling down."},{"id":"semetey-1-2013:p0434:b003:l017","ordinal":110158,"en":"A woman by name, wretched me,"},{"id":"semetey-1-2013:p0434:b003:l018","ordinal":110159,"en":"My strength was utterly spent."},{"id":"semetey-1-2013:p0434:b003:l019","ordinal":110160,"en":"I slipped backward from my saddle."},{"id":"semetey-1-2013:p0434:b003:l020","ordinal":110161,"en":"The thoroughbred's white reins"},{"id":"semetey-1-2013:p0434:b003:l021","ordinal":110162,"en":"I could not grasp in both hands."},{"id":"semetey-1-2013:p0434:b003:l022","ordinal":110163,"en":"Into the steel-tread stirrup"},{"id":"semetey-1-2013:p0434:b003:l023","ordinal":110164,"en":"I could not guide my foot."},{"id":"semetey-1-2013:p0434:b003:l024","ordinal":110165,"en":"My blood drained away, my insides burned."},{"id":"semetey-1-2013:p0434:b003:l025","ordinal":110166,"en":"Sometimes I could come to my senses,"},{"id":"semetey-1-2013:p0434:b003:l026","ordinal":110167,"en":"Sometimes I could not."},{"id":"semetey-1-2013:p0434:b003:l027","ordinal":110168,"en":"Your mother stood reeling."},{"id":"semetey-1-2013:p0434:b003:l028","ordinal":110169,"en":"Orokkyr, khan of the unbelievers,"},{"id":"semetey-1-2013:p0434:b003:l029","ordinal":110170,"en":"Charged in fury,"},{"id":"semetey-1-2013:p0434:b003:l030","ordinal":110171,"en":"Attacking at my flank."},{"id":"semetey-1-2013:p0434:b003:l031","ordinal":110172,"en":"He made one great charge,"},{"id":"semetey-1-2013:p0434:b003:l032","ordinal":110173,"en":"Taking his great spear in hand,"},{"id":"semetey-1-2013:p0434:b003:l033","ordinal":110174,"en":"Roaring in fury,"},{"id":"semetey-1-2013:p0434:b003:l034","ordinal":110175,"en":"His rage frightening souls away."},{"id":"semetey-1-2013:p0434:b003:l035","ordinal":110176,"en":"Your mother's whole body shuddered."},{"id":"semetey-1-2013:p0434:b003:l036","ordinal":110177,"en":"He came to seize me;"},{"id":"semetey-1-2013:p0434:b003:l037","ordinal":110178,"en":"That cursed old man was about to reach me,"},{"id":"semetey-1-2013:p0434:b003:l038","ordinal":110179,"en":"To slaughter me as a sacrifice,"},{"id":"semetey-1-2013:p0434:b003:l039","ordinal":110180,"en":"Me, your mother Kanykey,"},{"id":"semetey-1-2013:p0434:b004:l001","ordinal":110181,"en":"To take my wretched head."},{"id":"semetey-1-2013:p0434:b004:l002","ordinal":110182,"en":"Orokkyr, khan of the Shibe,"},{"id":"semetey-1-2013:p0434:b004:l003","ordinal":110183,"en":"Drew near, roaring."},{"id":"semetey-1-2013:p0434:b004:l004","ordinal":110184,"en":"I had no lion Manas behind me."},{"id":"semetey-1-2013:p0434:b004:l005","ordinal":110185,"en":"Khan Manas, now gone to the other world,"},{"id":"semetey-1-2013:p0434:b004:l006","ordinal":110186,"en":"With whom I united when tiny as a louse,"},{"id":"semetey-1-2013:p0434:b004:l007","ordinal":110187,"en":"With whom I joined when small as a thumb,"},{"id":"semetey-1-2013:p0434:b004:l008","ordinal":110188,"en":"Said, 'This woman built like a hero,"},{"id":"semetey-1-2013:p0434:b004:l009","ordinal":110189,"en":"The valiant woman Kanykey,"},{"id":"semetey-1-2013:p0434:b004:l010","ordinal":110190,"en":"They will slaughter as a sacrifice."},{"id":"semetey-1-2013:p0434:b004:l011","ordinal":110191,"en":"These Chinese, my poor one,"},{"id":"semetey-1-2013:p0434:b004:l012","ordinal":110192,"en":"Will kill her for nothing.'"},{"id":"semetey-1-2013:p0434:b004:l013","ordinal":110193,"en":"He struck Akkula upon the thigh,"},{"id":"semetey-1-2013:p0434:b004:l014","ordinal":110194,"en":"Took his painted spear in hand,"},{"id":"semetey-1-2013:p0434:b004:l015","ordinal":110195,"en":"Roared, crying 'Muslim!'"},{"id":"semetey-1-2013:p0434:b004:l016","ordinal":110196,"en":"And shouted the battle cry 'Ystan!'"},{"id":"semetey-1-2013:p0434:b004:l017","ordinal":110197,"en":"Before an eye could open and close,"},{"id":"semetey-1-2013:p0434:b004:l018","ordinal":110198,"en":"Before one could say this or that,"},{"id":"semetey-1-2013:p0434:b004:l019","ordinal":110199,"en":"Your leopard father Manas"},{"id":"semetey-1-2013:p0434:b004:l020","ordinal":110200,"en":"Reached Orokkyr."},{"id":"semetey-1-2013:p0434:b004:l021","ordinal":110201,"en":"The mighty Orokkyr,"},{"id":"semetey-1-2013:p0434:b004:l022","ordinal":110202,"en":"From atop his great mule,"},{"id":"semetey-1-2013:p0434:b004:l023","ordinal":110203,"en":"He knocked down and passed on."},{"id":"semetey-1-2013:p0434:b004:l024","ordinal":110204,"en":"Unable to survive a single spear thrust,"},{"id":"semetey-1-2013:p0434:b004:l025","ordinal":110205,"en":"Once your leopard father's hand had struck him,"},{"id":"semetey-1-2013:p0434:b004:l026","ordinal":110206,"en":"The renowned warrior Orokkyr"},{"id":"semetey-1-2013:p0434:b004:l027","ordinal":110207,"en":"Went off to hell."},{"id":"semetey-1-2013:p0434:b004:l028","ordinal":110208,"en":"Taking Zulpukor in hand,"},{"id":"semetey-1-2013:p0434:b004:l029","ordinal":110209,"en":"Beginning with Makil and Doodur,"},{"id":"semetey-1-2013:p0434:b004:l030","ordinal":110210,"en":"He cut off the heads of seven."},{"id":"semetey-1-2013:p0434:b004:l031","ordinal":110211,"en":"That Makil and Orokkyr,"},{"id":"semetey-1-2013:p0434:b004:l032","ordinal":110212,"en":"His two giants, were dead,"},{"id":"semetey-1-2013:p0434:b004:l033","ordinal":110213,"en":"The formidable warrior Kongurbay"},{"id":"semetey-1-2013:p0434:b004:l034","ordinal":110214,"en":"Saw as he stood apart."},{"id":"semetey-1-2013:p0434:b004:l035","ordinal":110215,"en":"He drew his bow, raining arrows,"},{"id":"semetey-1-2013:p0434:b004:l036","ordinal":110216,"en":"And fired bullets like hail."},{"id":"semetey-1-2013:p0434:b004:l037","ordinal":110217,"en":"Gathering courage, he roared,"},{"id":"semetey-1-2013:p0434:b004:l038","ordinal":110218,"en":"Stood defiant and shouted his battle cry,"},{"id":"semetey-1-2013:p0434:b004:l039","ordinal":110219,"en":"His battle cry was 'Kakay!'"},{"id":"semetey-1-2013:p0435:b003:l001","ordinal":110220,"en":"The massed Chinese and countless Manchus—"},{"id":"semetey-1-2013:p0435:b003:l002","ordinal":110221,"en":"Did they not swarm upon him!"},{"id":"semetey-1-2013:p0435:b003:l003","ordinal":110222,"en":"After suffering the torment of loneliness,"},{"id":"semetey-1-2013:p0435:b003:l004","ordinal":110223,"en":"Khan Bakay's lion"},{"id":"semetey-1-2013:p0435:b003:l005","ordinal":110224,"en":"Came back to his mind."},{"id":"semetey-1-2013:p0435:b003:l006","ordinal":110225,"en":"Toward the saddle-shaped pass"},{"id":"semetey-1-2013:p0435:b003:l007","ordinal":110226,"en":"Your hero father turned Akkula's head."},{"id":"semetey-1-2013:p0435:b003:l008","ordinal":110227,"en":"The forty outstanding, mighty companions,"},{"id":"semetey-1-2013:p0435:b003:l009","ordinal":110228,"en":"Your father included Chubak in his lament:"},{"id":"semetey-1-2013:p0435:b003:l010","ordinal":110229,"en":"No stepmother on whom I can rely,"},{"id":"semetey-1-2013:p0435:b003:l011","ordinal":110230,"en":"There is no hero to give me courage."},{"id":"semetey-1-2013:p0435:b003:l012","ordinal":110231,"en":"I can only turn in anguish to God."},{"id":"semetey-1-2013:p0435:b003:l013","ordinal":110232,"en":"My blood-stained Bakay and Chubak are absent;"},{"id":"semetey-1-2013:p0435:b003:l014","ordinal":110233,"en":"Lion Almambet and Syrgak are absent."},{"id":"semetey-1-2013:p0435:b003:l015","ordinal":110234,"en":"Seen today, gone tomorrow—"},{"id":"semetey-1-2013:p0435:b003:l016","ordinal":110235,"en":"This day seemed a mere handspan."},{"id":"semetey-1-2013:p0435:b003:l017","ordinal":110236,"en":"Was this your nature, filthy world?!"},{"id":"semetey-1-2013:p0435:b003:l018","ordinal":110237,"en":"When my belly grew hungry,"},{"id":"semetey-1-2013:p0435:b003:l019","ordinal":110238,"en":"I would cut and eat horse-rump meat."},{"id":"semetey-1-2013:p0435:b003:l020","ordinal":110239,"en":"If Chubak were beside me,"},{"id":"semetey-1-2013:p0435:b003:l021","ordinal":110240,"en":"I would say, 'I shall rout the governor.'"},{"id":"semetey-1-2013:p0435:b003:l022","ordinal":110241,"en":"When my stomach grew hungry,"},{"id":"semetey-1-2013:p0435:b003:l023","ordinal":110242,"en":"I would cut and eat horse-belly fat."},{"id":"semetey-1-2013:p0435:b003:l024","ordinal":110243,"en":"While my dear Almam was there,"},{"id":"semetey-1-2013:p0435:b003:l025","ordinal":110244,"en":"I would say, 'I shall slaughter the Kalmyks.'"},{"id":"semetey-1-2013:p0435:b003:l026","ordinal":110245,"en":"With red-steel Zulpukor"},{"id":"semetey-1-2013:p0435:b003:l027","ordinal":110246,"en":"I would say, 'I shall fight.'"},{"id":"semetey-1-2013:p0435:b003:l028","ordinal":110247,"en":"While Kyzyr-blessed Bakay was there,"},{"id":"semetey-1-2013:p0435:b003:l029","ordinal":110248,"en":"With the eighteen thousand worlds"},{"id":"semetey-1-2013:p0435:b003:l030","ordinal":110249,"en":"I, wretched soul, said I would grapple!"},{"id":"semetey-1-2013:p0435:b003:l032","ordinal":110250,"en":"My distress has become beyond compare."},{"id":"semetey-1-2013:p0435:b003:l033","ordinal":110251,"en":"Ah, may loneliness perish!"},{"id":"semetey-1-2013:p0435:b003:l034","ordinal":110252,"en":"My wife has become my support."},{"id":"semetey-1-2013:p0435:b003:l035","ordinal":110253,"en":"That leopard Syrgak is not here!"},{"id":"semetey-1-2013:p0435:b003:l036","ordinal":110254,"en":"The finest of sixty,"},{"id":"semetey-1-2013:p0435:b003:l037","ordinal":110255,"en":"The strongest of forty companions,"},{"id":"semetey-1-2013:p0435:b003:l038","ordinal":110256,"en":"Light upon a horse, fit for a colt,"},{"id":"semetey-1-2013:p0435:b003:l039","ordinal":110257,"en":"Sleeping little, watchful on the road,"},{"id":"semetey-1-2013:p0435:b005:l001","ordinal":110258,"en":"My black-capped support,"},{"id":"semetey-1-2013:p0435:b005:l002","ordinal":110259,"en":"Where has he gone and vanished,"},{"id":"semetey-1-2013:p0435:b005:l003","ordinal":110260,"en":"My dear, beloved Syrgak?"},{"id":"semetey-1-2013:p0435:b005:l004","ordinal":110261,"en":"My Chubak went away offended;"},{"id":"semetey-1-2013:p0435:b005:l005","ordinal":110262,"en":"That was when my backbone broke."},{"id":"semetey-1-2013:p0435:b005:l006","ordinal":110263,"en":"Saying, 'He treated Chubak like this,'"},{"id":"semetey-1-2013:p0435:b005:l007","ordinal":110264,"en":"My friend to the next world, Almambet,"},{"id":"semetey-1-2013:p0435:b005:l008","ordinal":110265,"en":"Looked on askance."},{"id":"semetey-1-2013:p0435:b005:l009","ordinal":110266,"en":"Hero Bakay, that excellent elder,"},{"id":"semetey-1-2013:p0435:b005:l010","ordinal":110267,"en":"My dear friend until Judgment Day,"},{"id":"semetey-1-2013:p0435:b005:l011","ordinal":110268,"en":"Said, 'He maligned his serving warrior;"},{"id":"semetey-1-2013:p0435:b005:l012","ordinal":110269,"en":"His conduct was bad.'"},{"id":"semetey-1-2013:p0435:b005:l013","ordinal":110270,"en":"Bakay's heart grew indifferent."},{"id":"semetey-1-2013:p0435:b005:l014","ordinal":110271,"en":"Ajybay, son of Argyn Khan,"},{"id":"semetey-1-2013:p0435:b005:l015","ordinal":110272,"en":"Was a friend to the next world."},{"id":"semetey-1-2013:p0435:b005:l016","ordinal":110273,"en":"'Manas believed gossip;"},{"id":"semetey-1-2013:p0435:b005:l017","ordinal":110274,"en":"May this world crush him!"},{"id":"semetey-1-2013:p0435:b005:l018","ordinal":110275,"en":"Such is what Manas has become,' he said."},{"id":"semetey-1-2013:p0435:b005:l019","ordinal":110276,"en":"Ill will showed in his eyes,"},{"id":"semetey-1-2013:p0435:b005:l020","ordinal":110277,"en":"And his words took a crooked course."},{"id":"semetey-1-2013:p0435:b005:l021","ordinal":110278,"en":"'Manas believed his old man;"},{"id":"semetey-1-2013:p0435:b005:l022","ordinal":110279,"en":"The fierce hero turned obstinate,' they said."},{"id":"semetey-1-2013:p0435:b005:l023","ordinal":110280,"en":"If they could, the forty companions"},{"id":"semetey-1-2013:p0435:b005:l024","ordinal":110281,"en":"Would have struck me down.'"},{"id":"semetey-1-2013:p0435:b005:l025","ordinal":110282,"en":"Saying this in anger,"},{"id":"semetey-1-2013:p0435:b005:l026","ordinal":110283,"en":"In sorrow he gathered troops."},{"id":"semetey-1-2013:p0435:b005:l027","ordinal":110284,"en":"Your hero father mourned his forty companions,"},{"id":"semetey-1-2013:p0435:b005:l028","ordinal":110285,"en":"And muttered in distress."},{"id":"semetey-1-2013:p0435:b005:l029","ordinal":110286,"en":"Your hero father's wits"},{"id":"semetey-1-2013:p0435:b005:l030","ordinal":110287,"en":"Were thrown into confusion."},{"id":"semetey-1-2013:p0435:b005:l031","ordinal":110288,"en":"His protecting spirit"},{"id":"semetey-1-2013:p0435:b005:l032","ordinal":110289,"en":"Had fled from his body."},{"id":"semetey-1-2013:p0435:b005:l033","ordinal":110290,"en":"His forty companions were not beside him."},{"id":"semetey-1-2013:p0435:b005:l034","ordinal":110291,"en":"His wretched life was pressed hard;"},{"id":"semetey-1-2013:p0435:b005:l035","ordinal":110292,"en":"Your father, gone to Judgment,"},{"id":"semetey-1-2013:p0435:b005:l036","ordinal":110293,"en":"Was thrown into confusion."},{"id":"semetey-1-2013:p0435:b005:l037","ordinal":110294,"en":"While things stood thus,"},{"id":"semetey-1-2013:p0435:b005:l038","ordinal":110295,"en":"What you had prayed for, the one God"},{"id":"semetey-1-2013:p0435:b005:l039","ordinal":110296,"en":"Had at that time granted."},{"id":"semetey-1-2013:p0436:b003:l001","ordinal":110297,"en":"Wild shouts and shrill cheers—"},{"id":"semetey-1-2013:p0436:b003:l002","ordinal":110298,"en":"That Chubak, son of Akbaltay,"},{"id":"semetey-1-2013:p0436:b003:l003","ordinal":110299,"en":"Had crossed down into Talas"},{"id":"semetey-1-2013:p0436:b003:l004","ordinal":110300,"en":"And arrived at that moment."},{"id":"semetey-1-2013:p0436:b003:l005","ordinal":110301,"en":"To be your father's companion,"},{"id":"semetey-1-2013:p0436:b003:l006","ordinal":110302,"en":"The tiger, the fierce-maned lion,"},{"id":"semetey-1-2013:p0436:b003:l007","ordinal":110303,"en":"Upon a horse such as Kokala,"},{"id":"semetey-1-2013:p0436:b003:l008","ordinal":110304,"en":"Came trotting along."},{"id":"semetey-1-2013:p0436:b003:l009","ordinal":110305,"en":"A roar came from ahead;"},{"id":"semetey-1-2013:p0436:b003:l010","ordinal":110306,"en":"It was that familiar voice of Chubak,"},{"id":"semetey-1-2013:p0436:b003:l011","ordinal":110307,"en":"Shouting 'Manas!' as his battle cry."},{"id":"semetey-1-2013:p0436:b003:l012","ordinal":110308,"en":"Girding his waist firmly,"},{"id":"semetey-1-2013:p0436:b003:l013","ordinal":110309,"en":"Into seven vast hosts of Chinese"},{"id":"semetey-1-2013:p0436:b003:l014","ordinal":110310,"en":"Your Chubak went alone,"},{"id":"semetey-1-2013:p0436:b003:l015","ordinal":110311,"en":"Attacking the instant he reached them."},{"id":"semetey-1-2013:p0436:b003:l016","ordinal":110312,"en":"When he heard Chubak's voice,"},{"id":"semetey-1-2013:p0436:b003:l017","ordinal":110313,"en":"Wearing a blue-lynx fur cap,"},{"id":"semetey-1-2013:p0436:b003:l018","ordinal":110314,"en":"Flourishing a blue-mottled shield,"},{"id":"semetey-1-2013:p0436:b003:l019","ordinal":110315,"en":"His head adorned with all of gold,"},{"id":"semetey-1-2013:p0436:b003:l020","ordinal":110316,"en":"His feet resting on pure silver,"},{"id":"semetey-1-2013:p0436:b003:l021","ordinal":110317,"en":"Finding the right words unexpectedly,"},{"id":"semetey-1-2013:p0436:b003:l022","ordinal":110318,"en":"Finding sight in the darkness,"},{"id":"semetey-1-2013:p0436:b003:l023","ordinal":110319,"en":"Bringing good fortune when sent ahead,"},{"id":"semetey-1-2013:p0436:b003:l024","ordinal":110320,"en":"His uncle Bakay, worth a countless host,"},{"id":"semetey-1-2013:p0436:b003:l025","ordinal":110321,"en":"Also entered with a roar."},{"id":"semetey-1-2013:p0436:b003:l026","ordinal":110322,"en":"That excellent hero Bakay"},{"id":"semetey-1-2013:p0436:b003:l027","ordinal":110323,"en":"Also shouted 'Manas!' as his battle cry."},{"id":"semetey-1-2013:p0436:b003:l028","ordinal":110324,"en":"Riding a horse such as Sarala,"},{"id":"semetey-1-2013:p0436:b003:l029","ordinal":110325,"en":"Wearing yellow leather trousers,"},{"id":"semetey-1-2013:p0436:b003:l030","ordinal":110326,"en":"Holding a spear without a horsehair tuft,"},{"id":"semetey-1-2013:p0436:b003:l031","ordinal":110327,"en":"A naked sword tied at his side,"},{"id":"semetey-1-2013:p0436:b003:l032","ordinal":110328,"en":"With golden forelock and tasselled sash—"},{"id":"semetey-1-2013:p0436:b003:l033","ordinal":110329,"en":"The only son of Khan Azyz in Beijing—"},{"id":"semetey-1-2013:p0436:b003:l034","ordinal":110330,"en":"A roar came from ahead;"},{"id":"semetey-1-2013:p0436:b003:l035","ordinal":110331,"en":"When he heard Chubak's voice,"},{"id":"semetey-1-2013:p0436:b003:l036","ordinal":110332,"en":"He too came out from the hills,"},{"id":"semetey-1-2013:p0436:b003:l037","ordinal":110333,"en":"Shouting 'Manas!' as his battle cry."},{"id":"semetey-1-2013:p0436:b003:l038","ordinal":110334,"en":"Light on a horse, fit for a colt,"},{"id":"semetey-1-2013:p0436:b003:l039","ordinal":110335,"en":"Sleepless, watchful on the road,"},{"id":"semetey-1-2013:p0436:b004:l001","ordinal":110336,"en":"His support of black steel,"}]
