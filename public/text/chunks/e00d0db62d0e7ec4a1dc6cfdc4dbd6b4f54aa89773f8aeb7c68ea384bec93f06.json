[{"id":"seytek-2012:p0509:b003:l028","ordinal":333569,"en":"Some did not engage him in battle,"},{"id":"seytek-2012:p0509:b003:l029","ordinal":333570,"en":"Nor stand against him face-to-face."},{"id":"seytek-2012:p0509:b003:l030","ordinal":333571,"en":"The hearts of some men"},{"id":"seytek-2012:p0509:b003:l031","ordinal":333572,"en":"Utterly failed, and they died."},{"id":"seytek-2012:p0509:b003:l032","ordinal":333573,"en":"These very eyes beheld their deaths."},{"id":"seytek-2012:p0509:b003:l033","ordinal":333574,"en":"However fearsome Sarybay may be,"},{"id":"seytek-2012:p0509:b003:l034","ordinal":333575,"en":"Let us overwhelm him and unleash battle."},{"id":"seytek-2012:p0509:b003:l035","ordinal":333576,"en":"Let us go and bar the road"},{"id":"seytek-2012:p0509:b003:l036","ordinal":333577,"en":"Of that arrogant swine."},{"id":"seytek-2012:p0509:b003:l037","ordinal":333578,"en":"If he is a champion, let us fight him,"},{"id":"seytek-2012:p0509:b003:l038","ordinal":333579,"en":"Strip to the waist and spill blood,"},{"id":"seytek-2012:p0509:b003:l039","ordinal":333580,"en":"And stand amid the desperate struggle."},{"id":"seytek-2012:p0509:b003:l040","ordinal":333581,"en":"If Sarybay proves weak,"},{"id":"seytek-2012:p0510:b002:l001","ordinal":333582,"en":"They grasped the stout shafts"},{"id":"seytek-2012:p0510:b002:l002","ordinal":333583,"en":"Of their true-steel spears,"},{"id":"seytek-2012:p0510:b002:l003","ordinal":333584,"en":"While war banners rippled in their hands"},{"id":"seytek-2012:p0510:b002:l004","ordinal":333585,"en":"And black-steel Zulfikar swords"},{"id":"seytek-2012:p0510:b002:l005","ordinal":333586,"en":"Flashed in every hand."},{"id":"seytek-2012:p0510:b002:l006","ordinal":333587,"en":"Traveling by night and not by day,"},{"id":"seytek-2012:p0510:b002:l007","ordinal":333588,"en":"They raised war cries and a mighty clamor,"},{"id":"seytek-2012:p0510:b002:l008","ordinal":333589,"en":"Preparing the army and leading the host,"},{"id":"seytek-2012:p0510:b002:l009","ordinal":333590,"en":"Gathering all their forces together."},{"id":"seytek-2012:p0510:b002:l010","ordinal":333591,"en":"The earth shook beneath their streaming banners,"},{"id":"seytek-2012:p0510:b002:l011","ordinal":333592,"en":"And the uproar deafened every ear,"},{"id":"seytek-2012:p0510:b002:l012","ordinal":333593,"en":"Throwing the whole world into alarm."},{"id":"seytek-2012:p0510:b002:l013","ordinal":333594,"en":"He made Buurul beneath him"},{"id":"seytek-2012:p0510:b002:l014","ordinal":333595,"en":"Stride forward proudly."},{"id":"seytek-2012:p0510:b002:l015","ordinal":333596,"en":"A warrior’s courage split stones,"},{"id":"seytek-2012:p0510:b002:l016","ordinal":333597,"en":"And his battle cry split heads."},{"id":"seytek-2012:p0510:b002:l017","ordinal":333598,"en":"His great banner rippled,"},{"id":"seytek-2012:p0510:b002:l018","ordinal":333599,"en":"As the earth cracked and mountains fell,"},{"id":"seytek-2012:p0510:b002:l019","ordinal":333600,"en":"And the battle standards billowed,"},{"id":"seytek-2012:p0510:b002:l020","ordinal":333601,"en":"While the courageous thundered onward."},{"id":"seytek-2012:p0510:b002:l021","ordinal":333602,"en":"The marksmen whose shots never missed,"},{"id":"seytek-2012:p0510:b002:l022","ordinal":333603,"en":"He drove forward against the enemy’s flank,"},{"id":"seytek-2012:p0510:b002:l023","ordinal":333604,"en":"Along with the deftest spearmen"},{"id":"seytek-2012:p0510:b002:l024","ordinal":333605,"en":"And the strongest battle-axe wielders."},{"id":"seytek-2012:p0510:b002:l025","ordinal":333606,"en":"He sent onto the road"},{"id":"seytek-2012:p0510:b002:l026","ordinal":333607,"en":"Warriors who were wolves in battle"},{"id":"seytek-2012:p0510:b002:l027","ordinal":333608,"en":"And champions who knew the enemy’s stratagems."},{"id":"seytek-2012:p0510:b002:l028","ordinal":333609,"en":"The fleeing multitudes surged and scattered,"},{"id":"seytek-2012:p0510:b002:l029","ordinal":333610,"en":"And the solitary figure of one man"},{"id":"seytek-2012:p0510:b002:l030","ordinal":333611,"en":"Appeared as great as a thousand."},{"id":"seytek-2012:p0510:b002:l031","ordinal":333612,"en":"They donned bulletproof coats"},{"id":"seytek-2012:p0510:b002:l032","ordinal":333613,"en":"And chose to mount"},{"id":"seytek-2012:p0510:b002:l033","ordinal":333614,"en":"Stallions too swift for bullets to reach."},{"id":"seytek-2012:p0510:b002:l034","ordinal":333615,"en":"They selected and sharpened their spears,"},{"id":"seytek-2012:p0510:b002:l035","ordinal":333616,"en":"And the valiant warriors bound"},{"id":"seytek-2012:p0510:b002:l036","ordinal":333617,"en":"Their entrusted lives to a thread."},{"id":"seytek-2012:p0510:b002:l037","ordinal":333618,"en":"They leveled their muskets and fired,"},{"id":"seytek-2012:p0510:b002:l038","ordinal":333619,"en":"And the muskets’ reports rolled and boomed."},{"id":"seytek-2012:p0510:b002:l039","ordinal":333620,"en":"The host that rode out was ten thousand strong,"},{"id":"seytek-2012:p0510:b003:l001","ordinal":333621,"en":"Shouting, “Khan Manas!”"},{"id":"seytek-2012:p0510:b003:l002","ordinal":333622,"en":"Their champions led the way,"},{"id":"seytek-2012:p0510:b003:l003","ordinal":333623,"en":"The brass pipes blaring,"},{"id":"seytek-2012:p0510:b003:l004","ordinal":333624,"en":"And the trumpets sounding sharply."},{"id":"seytek-2012:p0510:b003:l005","ordinal":333625,"en":"No bird could fly through the broad valley"},{"id":"seytek-2012:p0510:b003:l006","ordinal":333626,"en":"As shrill notes rang from the brass horns."},{"id":"seytek-2012:p0510:b003:l007","ordinal":333627,"en":"The kettledrums deafened every ear,"},{"id":"seytek-2012:p0510:b003:l008","ordinal":333628,"en":"And courage poured from the champions,"},{"id":"seytek-2012:p0510:b003:l009","ordinal":333629,"en":"While their warriors and lions"},{"id":"seytek-2012:p0510:b003:l010","ordinal":333630,"en":"Spread out across the ridges."},{"id":"seytek-2012:p0510:b003:l011","ordinal":333631,"en":"They were a countless throng."},{"id":"seytek-2012:p0510:b003:l012","ordinal":333632,"en":"Beneath the banner rode Semetey,"},{"id":"seytek-2012:p0510:b003:l013","ordinal":333633,"en":"With Külchoro beside him,"},{"id":"seytek-2012:p0510:b003:l014","ordinal":333634,"en":"While dust covered the sky."},{"id":"seytek-2012:p0510:b003:l015","ordinal":333635,"en":"Brave Seytek led the host,"},{"id":"seytek-2012:p0510:b003:l016","ordinal":333636,"en":"Immovable as dark-blue steel."},{"id":"seytek-2012:p0510:b003:l017","ordinal":333637,"en":"Upon his head he wore"},{"id":"seytek-2012:p0510:b003:l018","ordinal":333638,"en":"A Kyrgyz cap with layered sable trim."},{"id":"seytek-2012:p0510:b003:l019","ordinal":333639,"en":"Surveying all, he led the army,"},{"id":"seytek-2012:p0510:b003:l020","ordinal":333640,"en":"Drawing the converging troops together."},{"id":"seytek-2012:p0510:b003:l021","ordinal":333641,"en":"Brave Seytek, commander of the host,"},{"id":"seytek-2012:p0510:b003:l022","ordinal":333642,"en":"Bore a steel-edged, ornamented spear,"},{"id":"seytek-2012:p0510:b003:l023","ordinal":333643,"en":"Marching against the warrior who made the earth split,"},{"id":"seytek-2012:p0510:b003:l024","ordinal":333644,"en":"The infidel Sarybay’s son."},{"id":"seytek-2012:p0510:b003:l025","ordinal":333645,"en":"He went to wage a fierce campaign"},{"id":"seytek-2012:p0510:b003:l026","ordinal":333646,"en":"And avenge the Black Giant."},{"id":"seytek-2012:p0510:b003:l027","ordinal":333647,"en":"Dust rose high enough to split the sky,"},{"id":"seytek-2012:p0510:b003:l028","ordinal":333648,"en":"As gray-wolf Seytek took the lead,"},{"id":"seytek-2012:p0510:b003:l029","ordinal":333649,"en":"Raising a wondrous tumult to behold"},{"id":"seytek-2012:p0510:b003:l030","ordinal":333650,"en":"And filling the earth with clamor."},{"id":"seytek-2012:p0510:b003:l031","ordinal":333651,"en":"Steel-tipped spears crossed,"},{"id":"seytek-2012:p0510:b003:l032","ordinal":333652,"en":"And a mighty battle began."},{"id":"seytek-2012:p0510:b003:l033","ordinal":333653,"en":"For the glory of the fray, precious lives"},{"id":"seytek-2012:p0510:b003:l034","ordinal":333654,"en":"Were bound and cast upon a thread."},{"id":"seytek-2012:p0510:b003:l035","ordinal":333655,"en":"They raised a wondrous tumult and strife,"},{"id":"seytek-2012:p0510:b003:l036","ordinal":333656,"en":"Making it a trial for the gathered people."},{"id":"seytek-2012:p0510:b003:l037","ordinal":333657,"en":"They pledged their lives for the nation,"},{"id":"seytek-2012:p0510:b003:l038","ordinal":333658,"en":"To unleash a dreadful battle,"},{"id":"seytek-2012:p0510:b003:l039","ordinal":333659,"en":"And lead the valiant Kyrgyz and Argyn onward."},{"id":"seytek-2012:p0511:b002:l001","ordinal":333660,"en":"To rescue him,"},{"id":"seytek-2012:p0511:b002:l002","ordinal":333661,"en":"To die if death should come,"},{"id":"seytek-2012:p0511:b002:l003","ordinal":333662,"en":"To grapple with"},{"id":"seytek-2012:p0511:b002:l004","ordinal":333663,"en":"The fearsome champion Sarybai."},{"id":"seytek-2012:p0511:b002:l005","ordinal":333664,"en":"To defeat the cruel foe,"},{"id":"seytek-2012:p0511:b002:l006","ordinal":333665,"en":"To shatter his stone city—"},{"id":"seytek-2012:p0511:b002:l007","ordinal":333666,"en":"Seytek’s mind is set"},{"id":"seytek-2012:p0511:b002:l008","ordinal":333667,"en":"On rescuing Kara Döö,"},{"id":"seytek-2012:p0511:b002:l009","ordinal":333668,"en":"If he is still alive."},{"id":"seytek-2012:p0511:b002:l010","ordinal":333669,"en":"Before the army, brave Seytek"},{"id":"seytek-2012:p0511:b002:l011","ordinal":333670,"en":"Leveled his white gun and fired,"},{"id":"seytek-2012:p0511:b002:l012","ordinal":333671,"en":"Raised a clamor like Khan Manas,"},{"id":"seytek-2012:p0511:b002:l013","ordinal":333672,"en":"With a hungry shout that split stone,"},{"id":"seytek-2012:p0511:b002:l014","ordinal":333673,"en":"With fierce courage that broke heads;"},{"id":"seytek-2012:p0511:b002:l015","ordinal":333674,"en":"Whoever saw him stood amazed:"},{"id":"seytek-2012:p0511:b002:l016","ordinal":333675,"en":"He loomed like a blue mountain."},{"id":"seytek-2012:p0511:b002:l017","ordinal":333676,"en":"His lashes were burning embers,"},{"id":"seytek-2012:p0511:b002:l018","ordinal":333677,"en":"His wrath became an arrow;"},{"id":"seytek-2012:p0511:b002:l019","ordinal":333678,"en":"When he saw the foe he must fight,"},{"id":"seytek-2012:p0511:b002:l020","ordinal":333679,"en":"How could he remain still?"},{"id":"seytek-2012:p0511:b002:l021","ordinal":333680,"en":"Tumult rose before the army,"},{"id":"seytek-2012:p0511:b002:l022","ordinal":333681,"en":"And a lion’s roar rang out."},{"id":"seytek-2012:p0511:b002:l023","ordinal":333682,"en":"Could dear young Seytek,"},{"id":"seytek-2012:p0511:b002:l024","ordinal":333683,"en":"True son of the bloodthirsty khan,"},{"id":"seytek-2012:p0511:b002:l025","ordinal":333684,"en":"Ever flee from battle?"},{"id":"seytek-2012:p0511:b002:l026","ordinal":333685,"en":"Behold how the spirits"},{"id":"seytek-2012:p0511:b002:l027","ordinal":333686,"en":"Of his fathers upheld him!"},{"id":"seytek-2012:p0511:b002:l028","ordinal":333687,"en":"A black-mottled leopard"},{"id":"seytek-2012:p0511:b002:l029","ordinal":333688,"en":"Crouched at his side,"},{"id":"seytek-2012:p0511:b002:l030","ordinal":333689,"en":"As if about to tear flesh;"},{"id":"seytek-2012:p0511:b002:l031","ordinal":333690,"en":"A black-maned lion"},{"id":"seytek-2012:p0511:b002:l032","ordinal":333691,"en":"Waited close beside him,"},{"id":"seytek-2012:p0511:b002:l033","ordinal":333692,"en":"As if ready to spring and strike."},{"id":"seytek-2012:p0511:b002:l034","ordinal":333693,"en":"A gray tiger went before him—"},{"id":"seytek-2012:p0511:b002:l035","ordinal":333694,"en":"No living creature was its equal."},{"id":"seytek-2012:p0511:b002:l036","ordinal":333695,"en":"Looming like a blue mountain,"},{"id":"seytek-2012:p0511:b002:l037","ordinal":333696,"en":"The giant Zymyrik black eagle"},{"id":"seytek-2012:p0511:b002:l038","ordinal":333697,"en":"Seemed ready to swoop,"},{"id":"seytek-2012:p0511:b002:l039","ordinal":333698,"en":"Stretching out its talons"},{"id":"seytek-2012:p0511:b003:l001","ordinal":333699,"en":"As though about to seize him,"},{"id":"seytek-2012:p0511:b003:l002","ordinal":333700,"en":"Carry the world’s hero away,"},{"id":"seytek-2012:p0511:b003:l003","ordinal":333701,"en":"And cross the rocky peaks."},{"id":"seytek-2012:p0511:b003:l004","ordinal":333702,"en":"It thrust its talons wide:"},{"id":"seytek-2012:p0511:b003:l005","ordinal":333703,"en":"One of the seven black eagles"},{"id":"seytek-2012:p0511:b003:l006","ordinal":333704,"en":"Truly stood protecting him."},{"id":"seytek-2012:p0511:b003:l007","ordinal":333705,"en":"Forty tigers lined the ridge—"},{"id":"seytek-2012:p0511:b003:l008","ordinal":333706,"en":"No creatures like them had long been seen."},{"id":"seytek-2012:p0511:b003:l009","ordinal":333707,"en":"What he faced became flame,"},{"id":"seytek-2012:p0511:b003:l010","ordinal":333708,"en":"His spirit became a glowing coal;"},{"id":"seytek-2012:p0511:b003:l011","ordinal":333709,"en":"Once he saw the fearsome foe,"},{"id":"seytek-2012:p0511:b003:l012","ordinal":333710,"en":"How could the valiant son"},{"id":"seytek-2012:p0511:b003:l013","ordinal":333711,"en":"Of his father remain still?"},{"id":"seytek-2012:p0511:b003:l014","ordinal":333712,"en":"The dappled bay with swaying ornaments,"},{"id":"seytek-2012:p0511:b003:l015","ordinal":333713,"en":"The heavy, hostile dappled bay;"},{"id":"seytek-2012:p0511:b003:l016","ordinal":333714,"en":"His foe in combat was Sarybai—"},{"id":"seytek-2012:p0511:b003:l017","ordinal":333715,"en":"His splendor was of another kind."},{"id":"seytek-2012:p0511:b003:l018","ordinal":333716,"en":"His fury was mountain-like,"},{"id":"seytek-2012:p0511:b003:l019","ordinal":333717,"en":"As though he might devour"},{"id":"seytek-2012:p0511:b003:l020","ordinal":333718,"en":"The whole wide world at once."},{"id":"seytek-2012:p0511:b003:l021","ordinal":333719,"en":"He sprang like a tiger;"},{"id":"seytek-2012:p0511:b003:l022","ordinal":333720,"en":"None survived his blows."},{"id":"seytek-2012:p0511:b003:l023","ordinal":333721,"en":"The army roared, filling the fortress,"},{"id":"seytek-2012:p0511:b003:l024","ordinal":333722,"en":"Surging and blazing like fire."},{"id":"seytek-2012:p0511:b003:l025","ordinal":333723,"en":"They stirred to close in combat;"},{"id":"seytek-2012:p0511:b003:l026","ordinal":333724,"en":"The troops clamored, covering the earth,"},{"id":"seytek-2012:p0511:b003:l027","ordinal":333725,"en":"Crossing their steel-tipped spears,"},{"id":"seytek-2012:p0511:b003:l028","ordinal":333726,"en":"Binding their lone fly-like lives"},{"id":"seytek-2012:p0511:b003:l029","ordinal":333727,"en":"To a single hair,"},{"id":"seytek-2012:p0511:b003:l030","ordinal":333728,"en":"They crossed the mountain pass"},{"id":"seytek-2012:p0511:b003:l031","ordinal":333729,"en":"And descended onward"},{"id":"seytek-2012:p0511:b003:l032","ordinal":333730,"en":"Into the plain of El-Jürbös."},{"id":"seytek-2012:p0511:b003:l033","ordinal":333731,"en":"The army settled amid a roar,"},{"id":"seytek-2012:p0511:b003:l034","ordinal":333732,"en":"Set out food and slaughtered colts,"},{"id":"seytek-2012:p0511:b003:l035","ordinal":333733,"en":"And had all the coursing steeds"},{"id":"seytek-2012:p0511:b003:l036","ordinal":333734,"en":"Tethered along the lines."},{"id":"seytek-2012:p0511:b003:l037","ordinal":333735,"en":"From barren, well-fed young mares"},{"id":"seytek-2012:p0511:b003:l038","ordinal":333736,"en":"They boiled their meal."},{"id":"seytek-2012:p0511:b003:l039","ordinal":333737,"en":"They finely dressed and slaughtered colts,"},{"id":"seytek-2012:p0511:b003:l040","ordinal":333738,"en":"Then calmly laid out the feast."},{"id":"seytek-2012:p0512:b002:l001","ordinal":333739,"en":"The whole army murmured,"},{"id":"seytek-2012:p0512:b002:l002","ordinal":333740,"en":"The host clamored and buzzed,"},{"id":"seytek-2012:p0512:b002:l003","ordinal":333741,"en":"Dozing with heads on elbows,"},{"id":"seytek-2012:p0512:b003:l001","ordinal":333742,"en":"Resting in brief sleep,"},{"id":"seytek-2012:p0512:b003:l002","ordinal":333743,"en":"Lying until their hips grew weary,"},{"id":"seytek-2012:p0512:b003:l003","ordinal":333744,"en":"Reclining until sleep was satisfied."},{"id":"seytek-2012:p0512:b004:l001","ordinal":333745,"en":"THE TALE OF SARYBAI, SON OF THE MONSTER"},{"id":"seytek-2012:p0512:b005:l001","ordinal":333746,"en":"Beaten down by Sarybai,"},{"id":"seytek-2012:p0512:b005:l002","ordinal":333747,"en":"They had no time to gather their wits,"},{"id":"seytek-2012:p0512:b005:l003","ordinal":333748,"en":"No chance to fight with manly courage;"},{"id":"seytek-2012:p0512:b005:l004","ordinal":333749,"en":"Many champions panicked."},{"id":"seytek-2012:p0512:b005:l005","ordinal":333750,"en":"Of the many vaunting warriors,"},{"id":"seytek-2012:p0512:b005:l006","ordinal":333751,"en":"Some fled back again,"},{"id":"seytek-2012:p0512:b005:l007","ordinal":333752,"en":"While those fated to die were slain."},{"id":"seytek-2012:p0512:b005:l008","ordinal":333753,"en":"Some champions whose death had not come"},{"id":"seytek-2012:p0512:b005:l009","ordinal":333754,"en":"Were swallowed in swirling dust,"},{"id":"seytek-2012:p0512:b005:l010","ordinal":333755,"en":"Their heads like buckets of blood;"},{"id":"seytek-2012:p0512:b005:l011","ordinal":333756,"en":"Many champions panicked."},{"id":"seytek-2012:p0512:b005:l012","ordinal":333757,"en":"They went intending slaughter,"},{"id":"seytek-2012:p0512:b005:l013","ordinal":333758,"en":"But met with bitter disaster,"},{"id":"seytek-2012:p0512:b005:l014","ordinal":333759,"en":"And felt Sarybai’s might."},{"id":"seytek-2012:p0512:b005:l015","ordinal":333760,"en":"The boastful, swaggering men,"},{"id":"seytek-2012:p0512:b005:l016","ordinal":333761,"en":"Those who called themselves heroes,"},{"id":"seytek-2012:p0512:b005:l017","ordinal":333762,"en":"With their mottled bellies thumping,"},{"id":"seytek-2012:p0512:b005:l018","ordinal":333763,"en":"Their blustering chests rumbling,"},{"id":"seytek-2012:p0512:b005:l019","ordinal":333764,"en":"Those witless braggarts,"},{"id":"seytek-2012:p0512:b005:l020","ordinal":333765,"en":"Failed to meet the foe they sought"},{"id":"seytek-2012:p0512:b005:l021","ordinal":333766,"en":"And met the one they had not sought;"},{"id":"seytek-2012:p0512:b005:l022","ordinal":333767,"en":"Many champions were destroyed."},{"id":"seytek-2012:p0512:b005:l023","ordinal":333768,"en":"All those who fell"},{"id":"seytek-2012:p0512:b005:l024","ordinal":333769,"en":"Were hotheaded braggarts,"},{"id":"seytek-2012:p0512:b005:l025","ordinal":333770,"en":"Empty-chested, broad-flanked men"},{"id":"seytek-2012:p0512:b005:l026","ordinal":333771,"en":"Who had strutted in arrogance."},{"id":"seytek-2012:p0512:b005:l027","ordinal":333772,"en":"They cast away their lives;"},{"id":"seytek-2012:p0512:b005:l028","ordinal":333773,"en":"Those who were not killed"},{"id":"seytek-2012:p0512:b005:l029","ordinal":333774,"en":"Retreated and fled again."},{"id":"seytek-2012:p0512:b005:l030","ordinal":333775,"en":"The warriors who posed as champions,"},{"id":"seytek-2012:p0512:b005:l031","ordinal":333776,"en":"Exalting themselves,"},{"id":"seytek-2012:p0512:b005:l032","ordinal":333777,"en":"Those who said, “I am a champion,”"},{"id":"seytek-2012:p0512:b005:l033","ordinal":333778,"en":"Threw away their lives."},{"id":"seytek-2012:p0512:b006:l001","ordinal":333779,"en":"While the army stood thus,"},{"id":"seytek-2012:p0512:b006:l002","ordinal":333780,"en":"The earth heaved like lake and river;"},{"id":"seytek-2012:p0512:b006:l003","ordinal":333781,"en":"While the people stood thus,"},{"id":"seytek-2012:p0512:b006:l004","ordinal":333782,"en":"The whitening dawn broke,"},{"id":"seytek-2012:p0512:b006:l005","ordinal":333783,"en":"Pouring light upon the earth."},{"id":"seytek-2012:p0512:b006:l006","ordinal":333784,"en":"As day began to dawn,"},{"id":"seytek-2012:p0512:b006:l007","ordinal":333785,"en":"The cold wind before sunrise"},{"id":"seytek-2012:p0512:b006:l008","ordinal":333786,"en":"Swept down the valley;"},{"id":"seytek-2012:p0512:b006:l009","ordinal":333787,"en":"The reed tops shivered,"},{"id":"seytek-2012:p0512:b006:l010","ordinal":333788,"en":"Young larks clamored,"},{"id":"seytek-2012:p0512:b006:l011","ordinal":333789,"en":"All living creatures stirred,"},{"id":"seytek-2012:p0512:b006:l012","ordinal":333790,"en":"Every beast awoke."},{"id":"seytek-2012:p0512:b006:l013","ordinal":333791,"en":"One by one the stars in heaven"},{"id":"seytek-2012:p0512:b006:l014","ordinal":333792,"en":"Quivered toward the qibla;"},{"id":"seytek-2012:p0512:b006:l015","ordinal":333793,"en":"The stars overhead glittered,"},{"id":"seytek-2012:p0512:b006:l016","ordinal":333794,"en":"Hurrying toward the qibla."},{"id":"seytek-2012:p0512:b006:l017","ordinal":333795,"en":"The dawn opened bright,"},{"id":"seytek-2012:p0512:b006:l018","ordinal":333796,"en":"The earth’s twilight withdrew;"},{"id":"seytek-2012:p0512:b006:l019","ordinal":333797,"en":"A light breeze rose to a wind,"},{"id":"seytek-2012:p0512:b006:l020","ordinal":333798,"en":"And the land appeared, filled with troops."},{"id":"seytek-2012:p0512:b006:l021","ordinal":333799,"en":"Shapes emerged from the darkness,"},{"id":"seytek-2012:p0512:b006:l022","ordinal":333800,"en":"And the face of the world appeared."},{"id":"seytek-2012:p0512:b006:l023","ordinal":333801,"en":"When they gathered their baggage,"},{"id":"seytek-2012:p0512:b006:l024","ordinal":333802,"en":"And the camp began to move,"},{"id":"seytek-2012:p0512:b006:l025","ordinal":333803,"en":"The sentries on watch—"},{"id":"seytek-2012:p0512:b006:l026","ordinal":333804,"en":"Those who scouted land and road,"},{"id":"seytek-2012:p0512:b006:l027","ordinal":333805,"en":"And learned the enemy’s order—"},{"id":"seytek-2012:p0512:b006:l028","ordinal":333806,"en":"Surveyed the ground and searched the way,"},{"id":"seytek-2012:p0512:b006:l029","ordinal":333807,"en":"Often exchanging shots."},{"id":"seytek-2012:p0512:b006:l030","ordinal":333808,"en":"They would become entangled"},{"id":"seytek-2012:p0512:b006:l031","ordinal":333809,"en":"In every peril of the foe."},{"id":"seytek-2012:p0512:b006:l032","ordinal":333810,"en":"Dashing about in agitation,"},{"id":"seytek-2012:p0512:b006:l033","ordinal":333811,"en":"They encountered the forward guards,"},{"id":"seytek-2012:p0513:b002:l001","ordinal":333812,"en":"And came to tell the champions."},{"id":"seytek-2012:p0513:b002:l002","ordinal":333813,"en":"Those ill-fated were captured;"},{"id":"seytek-2012:p0513:b002:l003","ordinal":333814,"en":"Some champions whose death had not come"},{"id":"seytek-2012:p0513:b002:l004","ordinal":333815,"en":"Barely managed to escape."},{"id":"seytek-2012:p0513:b002:l005","ordinal":333816,"en":"Sarybai struck the doomed"},{"id":"seytek-2012:p0513:b002:l006","ordinal":333817,"en":"With mace and bow;"},{"id":"seytek-2012:p0513:b002:l007","ordinal":333818,"en":"The fortunate pressed onward,"},{"id":"seytek-2012:p0513:b002:l008","ordinal":333819,"en":"While the wretched fled back."},{"id":"seytek-2012:p0513:b002:l009","ordinal":333820,"en":"Brave hero Seytek was there,"},{"id":"seytek-2012:p0513:b002:l010","ordinal":333821,"en":"Facing them and speaking."},{"id":"seytek-2012:p0513:b002:l011","ordinal":333822,"en":"The vast army grieved,"},{"id":"seytek-2012:p0513:b002:l012","ordinal":333823,"en":"Despairing of their fly-like lives."},{"id":"seytek-2012:p0513:b002:l013","ordinal":333824,"en":"Their bodies went limp with sobbing;"}]
