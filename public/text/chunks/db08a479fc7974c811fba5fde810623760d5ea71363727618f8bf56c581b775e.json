[{"id":"semetey-1-2013:p1270:b003:l026","ordinal":174081,"en":"Was twelve years old,"},{"id":"semetey-1-2013:p1270:b003:l027","ordinal":174082,"en":"A glowing red ember."},{"id":"semetey-1-2013:p1270:b003:l028","ordinal":174083,"en":"God Almighty in His power"},{"id":"semetey-1-2013:p1270:b003:l029","ordinal":174084,"en":"Creates every kind of soul;"},{"id":"semetey-1-2013:p1270:b003:l030","ordinal":174085,"en":"None like him existed in the age."},{"id":"semetey-1-2013:p1270:b003:l031","ordinal":174086,"en":"The Creator performs every deed;"},{"id":"semetey-1-2013:p1270:b003:l032","ordinal":174087,"en":"No mortal like him existed."},{"id":"semetey-1-2013:p1270:b003:l033","ordinal":174088,"en":"The brightest and fairest of boys,"},{"id":"semetey-1-2013:p1270:b003:l034","ordinal":174089,"en":"His might was exceptional;"},{"id":"semetey-1-2013:p1270:b003:l035","ordinal":174090,"en":"When he mounted to attack an enemy,"},{"id":"semetey-1-2013:p1270:b003:l036","ordinal":174091,"en":"His strength was exceptional."},{"id":"semetey-1-2013:p1270:b003:l037","ordinal":174092,"en":"Thick-armed and stone-hearted,"},{"id":"semetey-1-2013:p1270:b003:l038","ordinal":174093,"en":"Able to bring slaughter upon the age,"},{"id":"semetey-1-2013:p1270:b003:l039","ordinal":174094,"en":"Kulchoro was no mere Jediger;"},{"id":"semetey-1-2013:p1270:b004:l001","ordinal":174095,"en":"And raid the Chinese."},{"id":"semetey-1-2013:p1270:b004:l002","ordinal":174096,"en":"He looked to both sides;"},{"id":"semetey-1-2013:p1270:b004:l003","ordinal":174097,"en":"Descendant of a blood-drinker,"},{"id":"semetey-1-2013:p1270:b004:l004","ordinal":174098,"en":"He licked his lips and nose."},{"id":"semetey-1-2013:p1270:b004:l005","ordinal":174099,"en":"Early words became late;"},{"id":"semetey-1-2013:p1270:b004:l006","ordinal":174100,"en":"At the thought of confronting"},{"id":"semetey-1-2013:p1270:b004:l007","ordinal":174101,"en":"Toltoy of the Jediger once,"},{"id":"semetey-1-2013:p1270:b004:l008","ordinal":174102,"en":"His two eyes became four."},{"id":"semetey-1-2013:p1270:b004:l009","ordinal":174103,"en":"He did not look around;"},{"id":"semetey-1-2013:p1270:b004:l010","ordinal":174104,"en":"By ocean-like gray-maned Almam,"},{"id":"semetey-1-2013:p1270:b004:l011","ordinal":174105,"en":"Your stripling left as a gift"},{"id":"semetey-1-2013:p1270:b004:l012","ordinal":174106,"en":"Did not think, \"I will die.\""},{"id":"semetey-1-2013:p1270:b004:l013","ordinal":174107,"en":"Your dear mother Kanykey—"},{"id":"semetey-1-2013:p1270:b004:l014","ordinal":174108,"en":"The bulletproof armor she had made,"},{"id":"semetey-1-2013:p1270:b004:l015","ordinal":174109,"en":"When Kulchoro put it on,"},{"id":"semetey-1-2013:p1270:b004:l016","ordinal":174110,"en":"It began above his navel."},{"id":"semetey-1-2013:p1270:b004:l017","ordinal":174111,"en":"When they saw the enormous power"},{"id":"semetey-1-2013:p1270:b004:l018","ordinal":174112,"en":"Of the twelve-year-old boy,"},{"id":"semetey-1-2013:p1270:b004:l019","ordinal":174113,"en":"The Afghan people lost heart."},{"id":"semetey-1-2013:p1270:b004:l020","ordinal":174114,"en":"Wearing his bulletproof coat,"},{"id":"semetey-1-2013:p1270:b004:l021","ordinal":174115,"en":"Without drawing brow or frowning,"},{"id":"semetey-1-2013:p1270:b004:l022","ordinal":174116,"en":"As though going to his in-laws,"},{"id":"semetey-1-2013:p1270:b004:l023","ordinal":174117,"en":"He smiled openly in joy."},{"id":"semetey-1-2013:p1270:b004:l024","ordinal":174118,"en":"With the honor-cutting sword at his side,"},{"id":"semetey-1-2013:p1270:b004:l025","ordinal":174119,"en":"Like a cloud about to rain again,"},{"id":"semetey-1-2013:p1270:b004:l026","ordinal":174120,"en":"Wrath spread across his face."},{"id":"semetey-1-2013:p1270:b004:l027","ordinal":174121,"en":"He moved apart in anger;"},{"id":"semetey-1-2013:p1270:b004:l028","ordinal":174122,"en":"The direction he looked caught fire."},{"id":"semetey-1-2013:p1270:b004:l029","ordinal":174123,"en":"At six years old,"},{"id":"semetey-1-2013:p1270:b004:l030","ordinal":174124,"en":"He had a child's thoughts;"},{"id":"semetey-1-2013:p1270:b004:l031","ordinal":174125,"en":"At twelve,"},{"id":"semetey-1-2013:p1270:b004:l032","ordinal":174126,"en":"He slaughtered whoever faced him."},{"id":"semetey-1-2013:p1270:b004:l033","ordinal":174127,"en":"His fortune was complete;"},{"id":"semetey-1-2013:p1270:b004:l034","ordinal":174128,"en":"He was a lion supported by the Shah."},{"id":"semetey-1-2013:p1270:b004:l035","ordinal":174129,"en":"Except for his bad name,"},{"id":"semetey-1-2013:p1270:b004:l036","ordinal":174130,"en":"Kulchoro under Semetey"},{"id":"semetey-1-2013:p1270:b004:l037","ordinal":174131,"en":"Was a hero of a spear's cast."},{"id":"semetey-1-2013:p1270:b004:l038","ordinal":174132,"en":"Creating souls of every kind,"},{"id":"semetey-1-2013:p1270:b004:l039","ordinal":174133,"en":"When he came into his prime,"},{"id":"semetey-1-2013:p1271:b003:l001","ordinal":174134,"en":"Kulchoro, son of Almambet,"},{"id":"semetey-1-2013:p1271:b003:l002","ordinal":174135,"en":"Seemed ready to throw the age into turmoil."},{"id":"semetey-1-2013:p1271:b003:l003","ordinal":174136,"en":"A helmet of blue iron—"},{"id":"semetey-1-2013:p1271:b003:l004","ordinal":174137,"en":"He overturned and set it upon his head,"},{"id":"semetey-1-2013:p1271:b003:l005","ordinal":174138,"en":"Its fastening beneath his throat—"},{"id":"semetey-1-2013:p1271:b003:l006","ordinal":174139,"en":"He crossed and tied it."},{"id":"semetey-1-2013:p1271:b003:l007","ordinal":174140,"en":"He wore a coat of mail beneath."},{"id":"semetey-1-2013:p1271:b003:l008","ordinal":174141,"en":"Of Choro, son of Almambet,"},{"id":"semetey-1-2013:p1271:b003:l009","ordinal":174142,"en":"If you look at his courage,"},{"id":"semetey-1-2013:p1271:b003:l010","ordinal":174143,"en":"Kanykey's bulletproof armor—"},{"id":"semetey-1-2013:p1271:b003:l011","ordinal":174144,"en":"He wore eighty layers of it."},{"id":"semetey-1-2013:p1271:b003:l012","ordinal":174145,"en":"The bulletproof armor,"},{"id":"semetey-1-2013:p1271:b003:l013","ordinal":174146,"en":"Kulchoro had put it on,"},{"id":"semetey-1-2013:p1271:b003:l014","ordinal":174147,"en":"The iron no bullet pierced."},{"id":"semetey-1-2013:p1271:b003:l015","ordinal":174148,"en":"He spread the armor across his shoulder blades"},{"id":"semetey-1-2013:p1271:b003:l016","ordinal":174149,"en":"And donned the iron fully."},{"id":"semetey-1-2013:p1271:b003:l017","ordinal":174150,"en":"His eyes blazed like a blue tiger's;"},{"id":"semetey-1-2013:p1271:b003:l018","ordinal":174151,"en":"He girded himself, saying, \"I trust in God.\""},{"id":"semetey-1-2013:p1271:b003:l019","ordinal":174152,"en":"If death had come, he would die;"},{"id":"semetey-1-2013:p1271:b003:l020","ordinal":174153,"en":"If he remained alive,"},{"id":"semetey-1-2013:p1271:b003:l021","ordinal":174154,"en":"He would test himself"},{"id":"semetey-1-2013:p1271:b003:l022","ordinal":174155,"en":"Against Toltoy of the Jediger."},{"id":"semetey-1-2013:p1271:b003:l023","ordinal":174156,"en":"If your gray-maned hero met him,"},{"id":"semetey-1-2013:p1271:b003:l024","ordinal":174157,"en":"He was eager to face him and thrust his spear,"},{"id":"semetey-1-2013:p1271:b003:l025","ordinal":174158,"en":"Eager to cut short"},{"id":"semetey-1-2013:p1271:b003:l026","ordinal":174159,"en":"The suffering soul."},{"id":"semetey-1-2013:p1271:b003:l027","ordinal":174160,"en":"Toltoy of the Jediger"},{"id":"semetey-1-2013:p1271:b003:l028","ordinal":174161,"en":"Would die if death had come."},{"id":"semetey-1-2013:p1271:b003:l029","ordinal":174162,"en":"Kulchoro was riding out"},{"id":"semetey-1-2013:p1271:b003:l030","ordinal":174163,"en":"To test himself in destruction."},{"id":"semetey-1-2013:p1271:b003:l031","ordinal":174164,"en":"The mount beneath him"},{"id":"semetey-1-2013:p1271:b003:l032","ordinal":174165,"en":"Was his uncle's tulpar,"},{"id":"semetey-1-2013:p1271:b003:l033","ordinal":174166,"en":"Semetey's falcon, whose loss"},{"id":"semetey-1-2013:p1271:b003:l034","ordinal":174167,"en":"Had caused strife."},{"id":"semetey-1-2013:p1271:b003:l035","ordinal":174168,"en":"There was an unhealed quarrel:"},{"id":"semetey-1-2013:p1271:b003:l036","ordinal":174169,"en":"Saying he would take a wife,"},{"id":"semetey-1-2013:p1271:b003:l037","ordinal":174170,"en":"Toltoy had begun a great tumult."},{"id":"semetey-1-2013:p1271:b003:l038","ordinal":174171,"en":"Such was the strange tale."},{"id":"semetey-1-2013:p1271:b003:l039","ordinal":174172,"en":"Made ready like a goshawk,"},{"id":"semetey-1-2013:p1271:b004:l001","ordinal":174173,"en":"This was what he had desired:"},{"id":"semetey-1-2013:p1271:b004:l002","ordinal":174174,"en":"An enemy to grapple had been found."},{"id":"semetey-1-2013:p1271:b004:l003","ordinal":174175,"en":"As for young Lord Choro,"},{"id":"semetey-1-2013:p1271:b004:l004","ordinal":174176,"en":"The mount beneath him"},{"id":"semetey-1-2013:p1271:b004:l005","ordinal":174177,"en":"Was his uncle's tulpar;"},{"id":"semetey-1-2013:p1271:b004:l006","ordinal":174178,"en":"What he held in his hand"},{"id":"semetey-1-2013:p1271:b004:l007","ordinal":174179,"en":"Was hero Syrgak's steel weapon."},{"id":"semetey-1-2013:p1271:b004:l008","ordinal":174180,"en":"\"I submit my neck to the true faith;"},{"id":"semetey-1-2013:p1271:b004:l009","ordinal":174181,"en":"Ah Almighty, support me!"},{"id":"semetey-1-2013:p1271:b004:l010","ordinal":174182,"en":"I make holy war against Toltoy!\""},{"id":"semetey-1-2013:p1271:b004:l011","ordinal":174183,"en":"Kulchoro rode out,"},{"id":"semetey-1-2013:p1271:b004:l012","ordinal":174184,"en":"Raising the gray-piebald banner,"},{"id":"semetey-1-2013:p1271:b004:l013","ordinal":174185,"en":"Heading toward Toltoy,"},{"id":"semetey-1-2013:p1271:b004:l014","ordinal":174186,"en":"Calling the clamor of Khan Manas."},{"id":"semetey-1-2013:p1271:b004:l015","ordinal":174187,"en":"Raising the patterned spear,"},{"id":"semetey-1-2013:p1271:b004:l016","ordinal":174188,"en":"Kulchoro rode out with this army."},{"id":"semetey-1-2013:p1271:b004:l017","ordinal":174189,"en":"Kanchoro, son of Chubak,"},{"id":"semetey-1-2013:p1271:b004:l018","ordinal":174190,"en":"Would ride straight into"},{"id":"semetey-1-2013:p1271:b004:l019","ordinal":174191,"en":"The brooding Jediger and thrust,"},{"id":"semetey-1-2013:p1271:b004:l020","ordinal":174192,"en":"Fight to the finish for many days,"},{"id":"semetey-1-2013:p1271:b004:l021","ordinal":174193,"en":"And make such a spectacle."},{"id":"semetey-1-2013:p1271:b004:l022","ordinal":174194,"en":"He would enter battle with the Jediger"},{"id":"semetey-1-2013:p1271:b004:l023","ordinal":174195,"en":"And split its countless army in two,"},{"id":"semetey-1-2013:p1271:b004:l024","ordinal":174196,"en":"Holding a spear and breaking formations;"},{"id":"semetey-1-2013:p1271:b004:l025","ordinal":174197,"en":"If death came, he would fall to a bullet"},{"id":"semetey-1-2013:p1271:b004:l026","ordinal":174198,"en":"And die at the Jediger's hands."},{"id":"semetey-1-2013:p1271:b004:l027","ordinal":174199,"en":"From the shrieking brass spear,"},{"id":"semetey-1-2013:p1271:b004:l028","ordinal":174200,"en":"Across the broad ravine no bird could cross,"},{"id":"semetey-1-2013:p1271:b004:l029","ordinal":174201,"en":"From the spear no foe escaped,"},{"id":"semetey-1-2013:p1271:b004:l030","ordinal":174202,"en":"He said, \"If my fate arrives, I will die"},{"id":"semetey-1-2013:p1271:b004:l031","ordinal":174203,"en":"And become support"},{"id":"semetey-1-2013:p1271:b004:l032","ordinal":174204,"en":"For my renowned lone uncle.\""},{"id":"semetey-1-2013:p1271:b004:l033","ordinal":174205,"en":"He readied himself like a goshawk"},{"id":"semetey-1-2013:p1271:b004:l034","ordinal":174206,"en":"And strained like a leopard;"},{"id":"semetey-1-2013:p1271:b004:l035","ordinal":174207,"en":"Counsel came from the unseen."},{"id":"semetey-1-2013:p1271:b004:l036","ordinal":174208,"en":"A man became a marvel;"},{"id":"semetey-1-2013:p1271:b004:l037","ordinal":174209,"en":"Able youth and tulpar horse"},{"id":"semetey-1-2013:p1271:b004:l038","ordinal":174210,"en":"Had reached the time to prove useful."},{"id":"semetey-1-2013:p1271:b004:l039","ordinal":174211,"en":"Raising the bay-piebald banner,"},{"id":"semetey-1-2013:p1272:b003:l001","ordinal":174212,"en":"Kanchoro rode out,"},{"id":"semetey-1-2013:p1272:b003:l002","ordinal":174213,"en":"Calling the clamor of Khan Manas."},{"id":"semetey-1-2013:p1272:b003:l003","ordinal":174214,"en":"His broad red radiant face"},{"id":"semetey-1-2013:p1272:b003:l004","ordinal":174215,"en":"Was hidden rather than shown."},{"id":"semetey-1-2013:p1272:b003:l005","ordinal":174216,"en":"His courage was no ordinary thing;"},{"id":"semetey-1-2013:p1272:b003:l006","ordinal":174217,"en":"In bearing and appearance,"},{"id":"semetey-1-2013:p1272:b003:l007","ordinal":174218,"en":"He was no less than hero Chubak."},{"id":"semetey-1-2013:p1272:b003:l008","ordinal":174219,"en":"There was the lion named Kanchoro,"},{"id":"semetey-1-2013:p1272:b003:l009","ordinal":174220,"en":"Who conceived crooked schemes"},{"id":"semetey-1-2013:p1272:b003:l010","ordinal":174221,"en":"And had a dark-hearted nature."},{"id":"semetey-1-2013:p1272:b003:l011","ordinal":174222,"en":"Were it not for his treachery,"},{"id":"semetey-1-2013:p1272:b003:l012","ordinal":174223,"en":"His fortunes too were complete."},{"id":"semetey-1-2013:p1272:b003:l013","ordinal":174224,"en":"His nature was to endure six months of riding;"},{"id":"semetey-1-2013:p1272:b003:l014","ordinal":174225,"en":"Raised and protected to maturity,"},{"id":"semetey-1-2013:p1272:b003:l015","ordinal":174226,"en":"He was Semetey's own wing."},{"id":"semetey-1-2013:p1272:b003:l016","ordinal":174227,"en":"He had fed him the fat of the rump"},{"id":"semetey-1-2013:p1272:b003:l017","ordinal":174228,"en":"And caused the sacred gray-maned hero"},{"id":"semetey-1-2013:p1272:b003:l018","ordinal":174229,"en":"To call him Chubak's son."},{"id":"semetey-1-2013:p1272:b003:l019","ordinal":174230,"en":"Kanykey had given her breast"},{"id":"semetey-1-2013:p1272:b003:l020","ordinal":174231,"en":"To Kulchoro and Kanchoro,"},{"id":"semetey-1-2013:p1272:b003:l021","ordinal":174232,"en":"And nursed both of them."},{"id":"semetey-1-2013:p1272:b003:l022","ordinal":174233,"en":"When Kanchoro sucked the breast,"},{"id":"semetey-1-2013:p1272:b003:l023","ordinal":174234,"en":"His voice reached God;"},{"id":"semetey-1-2013:p1272:b003:l024","ordinal":174235,"en":"Kanykey lost her strength,"},{"id":"semetey-1-2013:p1272:b003:l025","ordinal":174236,"en":"And from her breast then"},{"id":"semetey-1-2013:p1272:b003:l026","ordinal":174237,"en":"Dark crimson blood flowed."},{"id":"semetey-1-2013:p1272:b003:l027","ordinal":174238,"en":"\"In the end this one will be an enemy;"},{"id":"semetey-1-2013:p1272:b003:l028","ordinal":174239,"en":"Kill him outright,\" she said."},{"id":"semetey-1-2013:p1272:b003:l029","ordinal":174240,"en":"Poor Kanykey wept."},{"id":"semetey-1-2013:p1272:b003:l030","ordinal":174241,"en":"\"The lone boy Kanchoro—"},{"id":"semetey-1-2013:p1272:b003:l031","ordinal":174242,"en":"What could he possibly do?\""},{"id":"semetey-1-2013:p1272:b003:l032","ordinal":174243,"en":"Young Semetey would not consent."},{"id":"semetey-1-2013:p1272:b003:l033","ordinal":174244,"en":"He was a dark-hearted lion;"},{"id":"semetey-1-2013:p1272:b003:l034","ordinal":174245,"en":"Otherwise Kanchoro"},{"id":"semetey-1-2013:p1272:b003:l035","ordinal":174246,"en":"Was a lion who knew the enemy's devices."},{"id":"semetey-1-2013:p1272:b003:l036","ordinal":174247,"en":"He too prepared against the Jediger,"},{"id":"semetey-1-2013:p1272:b003:l037","ordinal":174248,"en":"Praying to the Creator."},{"id":"semetey-1-2013:p1272:b003:l038","ordinal":174249,"en":"What he chose and mounted from Talas"},{"id":"semetey-1-2013:p1272:b003:l039","ordinal":174250,"en":"Was Kobosh Khan's tulpar."},{"id":"semetey-1-2013:p1272:b004:l001","ordinal":174251,"en":"The kasaba standard floated in his hand;"},{"id":"semetey-1-2013:p1272:b004:l002","ordinal":174252,"en":"A golden-cheeked battle-axe"},{"id":"semetey-1-2013:p1272:b004:l003","ordinal":174253,"en":"Flashed upon his arm."},{"id":"semetey-1-2013:p1272:b004:l004","ordinal":174254,"en":"The sight made hearts waver;"},{"id":"semetey-1-2013:p1272:b004:l005","ordinal":174255,"en":"Kanchoro of Khan Chubak"},{"id":"semetey-1-2013:p1272:b004:l006","ordinal":174256,"en":"Looked like his father."},{"id":"semetey-1-2013:p1272:b004:l007","ordinal":174257,"en":"Against the teeming Jediger,"},{"id":"semetey-1-2013:p1272:b004:l008","ordinal":174258,"en":"To charge and thrust a spear,"},{"id":"semetey-1-2013:p1272:b004:l009","ordinal":174259,"en":"To take his ancient revenge,"},{"id":"semetey-1-2013:p1272:b004:l010","ordinal":174260,"en":"To unleash a great tumult,"},{"id":"semetey-1-2013:p1272:b004:l011","ordinal":174261,"en":"To die if death came,"},{"id":"semetey-1-2013:p1272:b004:l012","ordinal":174262,"en":"Or, if he survived, to break"},{"id":"semetey-1-2013:p1272:b004:l013","ordinal":174263,"en":"The Jediger into fragments."},{"id":"semetey-1-2013:p1272:b004:l014","ordinal":174264,"en":"If death came, he would fall to a bullet"},{"id":"semetey-1-2013:p1272:b004:l015","ordinal":174265,"en":"And die at the Jediger's hands."},{"id":"semetey-1-2013:p1272:b004:l016","ordinal":174266,"en":"Kanchoro rode out surging,"},{"id":"semetey-1-2013:p1272:b004:l017","ordinal":174267,"en":"Taking a white sacred banner"},{"id":"semetey-1-2013:p1272:b004:l018","ordinal":174268,"en":"And a clamorous battle cry."},{"id":"semetey-1-2013:p1272:b004:l019","ordinal":174269,"en":"He emerged from the gate"},{"id":"semetey-1-2013:p1272:b004:l020","ordinal":174270,"en":"And came apart from Afghanistan."},{"id":"semetey-1-2013:p1272:b004:l021","ordinal":174271,"en":"Black-bearded hero Tolok"},{"id":"semetey-1-2013:p1272:b004:l022","ordinal":174272,"en":"Set his course toward hero Tolok's army;"},{"id":"semetey-1-2013:p1272:b004:l023","ordinal":174273,"en":"Kanchoro rode out panting."},{"id":"semetey-1-2013:p1272:b004:l024","ordinal":174274,"en":"Baytaylak, son of Bakay,"},{"id":"semetey-1-2013:p1272:b004:l025","ordinal":174275,"en":"Kalyk of Sary Khan,"},{"id":"semetey-1-2013:p1272:b004:l026","ordinal":174276,"en":"All rode together to war."},{"id":"semetey-1-2013:p1272:b004:l027","ordinal":174277,"en":"Agybay, son of Agy,"},{"id":"semetey-1-2013:p1272:b004:l028","ordinal":174278,"en":"Brought a great army from Afghanistan,"},{"id":"semetey-1-2013:p1272:b004:l029","ordinal":174279,"en":"Bringing troops in abundance."},{"id":"semetey-1-2013:p1272:b004:l030","ordinal":174280,"en":"As they prepared and gathered the people,"},{"id":"semetey-1-2013:p1272:b004:l031","ordinal":174281,"en":"His white turban was cauldron-sized,"},{"id":"semetey-1-2013:p1272:b004:l032","ordinal":174282,"en":"And when he shouted, his voice was like the call to prayer:"},{"id":"semetey-1-2013:p1272:b004:l033","ordinal":174283,"en":"Akun Khan's son stood apart."},{"id":"semetey-1-2013:p1272:b004:l034","ordinal":174284,"en":"The command drum was beaten;"},{"id":"semetey-1-2013:p1272:b004:l035","ordinal":174285,"en":"Akun's people closed in,"},{"id":"semetey-1-2013:p1272:b004:l036","ordinal":174286,"en":"Dividing into many kinds."},{"id":"semetey-1-2013:p1272:b004:l037","ordinal":174287,"en":"The red banner with golden finial"},{"id":"semetey-1-2013:p1272:b004:l038","ordinal":174288,"en":"Appeared from his horde."},{"id":"semetey-1-2013:p1272:b004:l039","ordinal":174289,"en":"Raising a gray-piebald banner,"},{"id":"semetey-1-2013:p1273:b003:l001","ordinal":174290,"en":"Calling the battle cry \"Khan Akun!\""},{"id":"semetey-1-2013:p1273:b003:l002","ordinal":174291,"en":"The karnay blared,"},{"id":"semetey-1-2013:p1273:b003:l003","ordinal":174292,"en":"The brass horn clattered,"},{"id":"semetey-1-2013:p1273:b003:l004","ordinal":174293,"en":"And dust curled into the sky."},{"id":"semetey-1-2013:p1273:b003:l005","ordinal":174294,"en":"The great host, frightened at first,"},{"id":"semetey-1-2013:p1273:b003:l006","ordinal":174295,"en":"Gathered to the last man."},{"id":"semetey-1-2013:p1273:b003:l007","ordinal":174296,"en":"Would the deftest with battle-axes,"},{"id":"semetey-1-2013:p1273:b003:l008","ordinal":174297,"en":"The strongest Afghans,"},{"id":"semetey-1-2013:p1273:b003:l009","ordinal":174298,"en":"Stand watching without fighting to the death?"},{"id":"semetey-1-2013:p1273:b003:l010","ordinal":174299,"en":"The gray-piebald banner became their standard,"},{"id":"semetey-1-2013:p1273:b003:l011","ordinal":174300,"en":"And a wailing clamor arose."},{"id":"semetey-1-2013:p1273:b003:l012","ordinal":174301,"en":"The finest spearmen stood apart,"},{"id":"semetey-1-2013:p1273:b003:l013","ordinal":174302,"en":"And the best men appeared."},{"id":"semetey-1-2013:p1273:b003:l014","ordinal":174303,"en":"The inside of the city closed down;"},{"id":"semetey-1-2013:p1273:b003:l015","ordinal":174304,"en":"All the bloodletters gathered."},{"id":"semetey-1-2013:p1273:b003:l016","ordinal":174305,"en":"The old men stayed bowed at home;"},{"id":"semetey-1-2013:p1273:b003:l017","ordinal":174306,"en":"All the Afghans"},{"id":"semetey-1-2013:p1273:b003:l018","ordinal":174307,"en":"Set their army in motion."},{"id":"semetey-1-2013:p1273:b003:l019","ordinal":174308,"en":"From the treasury horde"},{"id":"semetey-1-2013:p1273:b003:l020","ordinal":174309,"en":"Khan Akun's army appeared."},{"id":"semetey-1-2013:p1273:b003:l021","ordinal":174310,"en":"Tumenbay, son of Tulku,"},{"id":"semetey-1-2013:p1273:b003:l022","ordinal":174311,"en":"Was a hero with a Turkic spirit."},{"id":"semetey-1-2013:p1273:b003:l023","ordinal":174312,"en":"At Jeti-Ozon, the Jediger"},{"id":"semetey-1-2013:p1273:b003:l024","ordinal":174313,"en":"Would meet them face to face and fight;"},{"id":"semetey-1-2013:p1273:b003:l025","ordinal":174314,"en":"That was where they would reach their end."},{"id":"semetey-1-2013:p1273:b003:l026","ordinal":174315,"en":"Little wisdom and much courage—"},{"id":"semetey-1-2013:p1273:b003:l027","ordinal":174316,"en":"That Tumenbay, son of Tulku,"},{"id":"semetey-1-2013:p1273:b003:l028","ordinal":174317,"en":"Was a harsh-tempered hero,"},{"id":"semetey-1-2013:p1273:b003:l029","ordinal":174318,"en":"A lion who stood out plainly."},{"id":"semetey-1-2013:p1273:b003:l030","ordinal":174319,"en":"He fought trusting fate"},{"id":"semetey-1-2013:p1273:b003:l031","ordinal":174320,"en":"And was one who broke formations."},{"id":"semetey-1-2013:p1273:b003:l032","ordinal":174321,"en":"He girded the jekene at his waist;"},{"id":"semetey-1-2013:p1273:b003:l033","ordinal":174322,"en":"If the seven divisions of Jediger"},{"id":"semetey-1-2013:p1273:b003:l034","ordinal":174323,"en":"Suddenly engulfed him,"},{"id":"semetey-1-2013:p1273:b003:l035","ordinal":174324,"en":"He attacked alone."},{"id":"semetey-1-2013:p1273:b003:l036","ordinal":174325,"en":"He did not fear death by a penny;"},{"id":"semetey-1-2013:p1273:b003:l037","ordinal":174326,"en":"Barely having escaped death,"},{"id":"semetey-1-2013:p1273:b003:l038","ordinal":174327,"en":"The teeming Jediger"},{"id":"semetey-1-2013:p1273:b003:l039","ordinal":174328,"en":"Had surged in yesterday;"},{"id":"semetey-1-2013:p1273:b005:l001","ordinal":174329,"en":"Before this, Tumenbay"},{"id":"semetey-1-2013:p1273:b005:l002","ordinal":174330,"en":"Had fought them many times."},{"id":"semetey-1-2013:p1273:b005:l003","ordinal":174331,"en":"Driving after him,"},{"id":"semetey-1-2013:p1273:b005:l004","ordinal":174332,"en":"Because of desire for Aychurok,"},{"id":"semetey-1-2013:p1273:b005:l005","ordinal":174333,"en":"Yesterday Toltoy of the Jediger"},{"id":"semetey-1-2013:p1273:b005:l006","ordinal":174334,"en":"Drew his bow like rain"},{"id":"semetey-1-2013:p1273:b005:l007","ordinal":174335,"en":"And fired bullets like hail."},{"id":"semetey-1-2013:p1273:b005:l008","ordinal":174336,"en":"Saying, \"He will not obey my demand,\""}]
