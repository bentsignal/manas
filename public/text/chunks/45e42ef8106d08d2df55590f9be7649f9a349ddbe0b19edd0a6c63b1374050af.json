[{"id":"manas-2010:p0530:b001:l025","ordinal":24065,"en":"They migrated with a swaying gait."},{"id":"manas-2010:p0530:b001:l026","ordinal":24066,"en":"Taking revenge upon the Kalmyks,"},{"id":"manas-2010:p0530:b001:l027","ordinal":24067,"en":"They migrated in delight."},{"id":"manas-2010:p0530:b001:l028","ordinal":24068,"en":"Jakyp had countless cattle;"},{"id":"manas-2010:p0530:b001:l029","ordinal":24069,"en":"Akbaltay had multitudes of livestock."},{"id":"manas-2010:p0530:b001:l030","ordinal":24070,"en":"All sorrow was dispelled,"},{"id":"manas-2010:p0530:b001:l031","ordinal":24071,"en":"All misfortune cut away."},{"id":"manas-2010:p0530:b001:l032","ordinal":24072,"en":"Khan Manas rose to greatness."},{"id":"manas-2010:p0530:b001:l033","ordinal":24073,"en":"All sorrow was dispelled,"},{"id":"manas-2010:p0530:b001:l034","ordinal":24074,"en":"All grief was cut away."},{"id":"manas-2010:p0530:b001:l035","ordinal":24075,"en":"All mourning was scattered,"},{"id":"manas-2010:p0530:b001:l036","ordinal":24076,"en":"All anxiety was released."},{"id":"manas-2010:p0530:b001:l037","ordinal":24077,"en":"Extinguishing the fires they had lit,"},{"id":"manas-2010:p0530:b001:l038","ordinal":24078,"en":"All forty households"},{"id":"manas-2010:p0530:b001:l039","ordinal":24079,"en":"He moved at their ease."},{"id":"manas-2010:p0530:b001:l040","ordinal":24080,"en":"Khan Koshoy of the Katagan,"},{"id":"manas-2010:p0530:b001:l041","ordinal":24081,"en":"Who had been a support to Manas,"},{"id":"manas-2010:p0530:b001:l042","ordinal":24082,"en":"He now heeded what he said."},{"id":"manas-2010:p0531:b001:l001","ordinal":24083,"en":"By multitudes and thousands, to Koshoy"},{"id":"manas-2010:p0531:b001:l002","ordinal":24084,"en":"He now gave his due."},{"id":"manas-2010:p0531:b001:l003","ordinal":24085,"en":"When Toruchaar fell to a shot,"},{"id":"manas-2010:p0531:b001:l004","ordinal":24086,"en":"The countless thousands of Chinese"},{"id":"manas-2010:p0531:b001:l005","ordinal":24087,"en":"Stood surrounding him."},{"id":"manas-2010:p0531:b001:l006","ordinal":24088,"en":"When Koshoy came to face them,"},{"id":"manas-2010:p0531:b001:l007","ordinal":24089,"en":"To bloodthirsty champion Manas,"},{"id":"manas-2010:p0531:b001:l008","ordinal":24090,"en":"When he became a companion,"},{"id":"manas-2010:p0531:b001:l009","ordinal":24091,"en":"When those whose end had come died,"},{"id":"manas-2010:p0531:b001:l010","ordinal":24092,"en":"For Manas, leopard and tiger,"},{"id":"manas-2010:p0531:b001:l011","ordinal":24093,"en":"Your dear elder, aged Koshoy,"},{"id":"manas-2010:p0531:b001:l012","ordinal":24094,"en":"When he became a support,"},{"id":"manas-2010:p0531:b001:l013","ordinal":24095,"en":"The men who fought,"},{"id":"manas-2010:p0531:b001:l014","ordinal":24096,"en":"Those who remained after the dead,"},{"id":"manas-2010:p0531:b001:l015","ordinal":24097,"en":"The especially mighty and skilled,"},{"id":"manas-2010:p0531:b001:l016","ordinal":24098,"en":"Had their wishes fulfilled."},{"id":"manas-2010:p0531:b001:l017","ordinal":24099,"en":"When they laid the Chinese waste,"},{"id":"manas-2010:p0531:b001:l018","ordinal":24100,"en":"Their hands filled with lead ropes."},{"id":"manas-2010:p0531:b001:l019","ordinal":24101,"en":"When Manas wrought slaughter,"},{"id":"manas-2010:p0531:b001:l020","ordinal":24102,"en":"When he speared the Chinese back,"},{"id":"manas-2010:p0531:b001:l021","ordinal":24103,"en":"The skilled among the spearmen,"},{"id":"manas-2010:p0531:b001:l022","ordinal":24104,"en":"The exceedingly mighty men,"},{"id":"manas-2010:p0531:b001:l023","ordinal":24105,"en":"Took six thousand horses apiece."},{"id":"manas-2010:p0531:b001:l024","ordinal":24106,"en":"The weak-backed who could not take them"},{"id":"manas-2010:p0531:b001:l025","ordinal":24107,"en":"Took sixty horses apiece."},{"id":"manas-2010:p0531:b001:l026","ordinal":24108,"en":"The accomplished heroes,"},{"id":"manas-2010:p0531:b001:l027","ordinal":24109,"en":"The champions who came out alone,"},{"id":"manas-2010:p0531:b001:l028","ordinal":24110,"en":"Took seven thousand horses apiece."},{"id":"manas-2010:p0531:b001:l029","ordinal":24111,"en":"The clumsy ones who could not keep up"},{"id":"manas-2010:p0531:b001:l030","ordinal":24112,"en":"Took seven hundred horses apiece."},{"id":"manas-2010:p0531:b001:l031","ordinal":24113,"en":"Their spoils to one another,"},{"id":"manas-2010:p0531:b001:l032","ordinal":24114,"en":"They showed off with pride."},{"id":"manas-2010:p0531:b001:l033","ordinal":24115,"en":"Those who had taken much, to those with little,"},{"id":"manas-2010:p0531:b001:l034","ordinal":24116,"en":"Gave lavish gifts from their spoils."},{"id":"manas-2010:p0531:b001:l035","ordinal":24117,"en":"Devising cunning schemes,"},{"id":"manas-2010:p0531:b001:l036","ordinal":24118,"en":"The oppressors of the meek,"},{"id":"manas-2010:p0531:b001:l037","ordinal":24119,"en":"Stealing their horses,"},{"id":"manas-2010:p0531:b001:l038","ordinal":24120,"en":"Put their own brands upon them."},{"id":"manas-2010:p0531:b001:l039","ordinal":24121,"en":"They shouted angrily at one another,"},{"id":"manas-2010:p0531:b001:l040","ordinal":24122,"en":"And went before their arbiter."},{"id":"manas-2010:p0531:b001:l041","ordinal":24123,"en":"While the warrior touched by Kydyr was there,"},{"id":"manas-2010:p0531:b001:l042","ordinal":24124,"en":"They acquired much property,"},{"id":"manas-2010:p0532:b001:l001","ordinal":24125,"en":"Over pass after pass,"},{"id":"manas-2010:p0532:b001:l002","ordinal":24126,"en":"They were migrating,"},{"id":"manas-2010:p0532:b001:l003","ordinal":24127,"en":"Through high valleys branching apart."},{"id":"manas-2010:p0532:b001:l004","ordinal":24128,"en":"Mottled banners, red standards,"},{"id":"manas-2010:p0532:b001:l005","ordinal":24129,"en":"They came migrating with a swaying gait."},{"id":"manas-2010:p0532:b001:l006","ordinal":24130,"en":"Khan Manas as their leader,"},{"id":"manas-2010:p0532:b001:l007","ordinal":24131,"en":"All their heartache eased,"},{"id":"manas-2010:p0532:b001:l008","ordinal":24132,"en":"They came migrating in delight!"},{"id":"manas-2010:p0532:b001:l009","ordinal":24133,"en":"Ala-Too was what they longed for:"},{"id":"manas-2010:p0532:b001:l010","ordinal":24134,"en":"The land where they took off shirts and washed them,"},{"id":"manas-2010:p0532:b001:l011","ordinal":24135,"en":"The land their forefathers left,"},{"id":"manas-2010:p0532:b001:l012","ordinal":24136,"en":"The land where their livestock thronged and grew,"},{"id":"manas-2010:p0532:b001:l013","ordinal":24137,"en":"The land where mothers gave birth with cries,"},{"id":"manas-2010:p0532:b001:l014","ordinal":24138,"en":"The land where umbilical blood was stanched."},{"id":"manas-2010:p0532:b001:l015","ordinal":24139,"en":"Seeing their land, trudging onward,"},{"id":"manas-2010:p0532:b001:l016","ordinal":24140,"en":"They had migrated in full strength."},{"id":"manas-2010:p0532:b001:l017","ordinal":24141,"en":"Spirits distilled from fermented mare's milk,"},{"id":"manas-2010:p0532:b001:l018","ordinal":24142,"en":"They poured into leather flasks and set them out."},{"id":"manas-2010:p0532:b001:l019","ordinal":24143,"en":"Fat lamb, delicious food,"},{"id":"manas-2010:p0532:b001:l020","ordinal":24144,"en":"All migrating without stopping,"},{"id":"manas-2010:p0532:b001:l021","ordinal":24145,"en":"They boiled in traveling pots."},{"id":"manas-2010:p0532:b001:l022","ordinal":24146,"en":"They put on their light robes,"},{"id":"manas-2010:p0532:b001:l023","ordinal":24147,"en":"Mounted pacers that did not trot,"},{"id":"manas-2010:p0532:b001:l024","ordinal":24148,"en":"Passed on, migrating without rest,"},{"id":"manas-2010:p0532:b001:l025","ordinal":24149,"en":"Attaining their inheritance."},{"id":"manas-2010:p0532:b001:l026","ordinal":24150,"en":"Kichi-Zhyldyz and Chong-Zhyldyz,"},{"id":"manas-2010:p0532:b001:l027","ordinal":24151,"en":"They crossed in succession, it is said."},{"id":"manas-2010:p0532:b001:l028","ordinal":24152,"en":"Ögüz-Ashuu and Tay-Ashuu,"},{"id":"manas-2010:p0532:b001:l029","ordinal":24153,"en":"They now crossed in succession."},{"id":"manas-2010:p0532:b001:l030","ordinal":24154,"en":"Üch-Aral at the head of the Ili"},{"id":"manas-2010:p0532:b001:l031","ordinal":24155,"en":"Became their resting camp."},{"id":"manas-2010:p0532:b001:l032","ordinal":24156,"en":"Üch-Zhyrgalang and Köngüz,"},{"id":"manas-2010:p0532:b001:l033","ordinal":24157,"en":"They now migrated along them."},{"id":"manas-2010:p0532:b001:l034","ordinal":24158,"en":"Passing along Kök-Tal,"},{"id":"manas-2010:p0532:b001:l035","ordinal":24159,"en":"Traveling about the great Ili,"},{"id":"manas-2010:p0532:b001:l036","ordinal":24160,"en":"From the spur with swirling waters,"},{"id":"manas-2010:p0532:b001:l037","ordinal":24161,"en":"They made their crossing,"},{"id":"manas-2010:p0532:b001:l038","ordinal":24162,"en":"From the headland called Tash-Kechüü."},{"id":"manas-2010:p0532:b001:l039","ordinal":24163,"en":"Driving horses in a rushing stream,"},{"id":"manas-2010:p0532:b001:l040","ordinal":24164,"en":"All migrated, spreading out."},{"id":"manas-2010:p0532:b001:l041","ordinal":24165,"en":"When they turned downstream,"},{"id":"manas-2010:p0532:b001:l042","ordinal":24166,"en":"There was no cawing crow,"},{"id":"manas-2010:p0533:b001:l001","ordinal":24167,"en":"No croaking raven in flight."},{"id":"manas-2010:p0533:b001:l002","ordinal":24168,"en":"They called it Father Sary-Özön;"},{"id":"manas-2010:p0533:b001:l003","ordinal":24169,"en":"It was the bank of the broad Ili."},{"id":"manas-2010:p0533:b001:l004","ordinal":24170,"en":"In the hollow of flowing water,"},{"id":"manas-2010:p0533:b001:l005","ordinal":24171,"en":"Beside the great river,"},{"id":"manas-2010:p0533:b001:l006","ordinal":24172,"en":"The people camped together, it is said."},{"id":"manas-2010:p0533:b001:l007","ordinal":24173,"en":"The parting of two peoples,"},{"id":"manas-2010:p0533:b001:l008","ordinal":24174,"en":"The sorrow of brave men—"},{"id":"manas-2010:p0533:b001:l009","ordinal":24175,"en":"They made a full resting halt,"},{"id":"manas-2010:p0533:b001:l010","ordinal":24176,"en":"And camped there seven days."},{"id":"manas-2010:p0533:b001:l011","ordinal":24177,"en":"Its bank was at the mouth of Ak-Chiy,"},{"id":"manas-2010:p0533:b001:l012","ordinal":24178,"en":"At the head of Sary-Özön."},{"id":"manas-2010:p0533:b001:l013","ordinal":24179,"en":"There was hazy dust upon the plain."},{"id":"manas-2010:p0533:b001:l014","ordinal":24180,"en":"My dear Sary-Özön,"},{"id":"manas-2010:p0533:b001:l015","ordinal":24181,"en":"There were wild asses on its flats as well."},{"id":"manas-2010:p0533:b001:l016","ordinal":24182,"en":"It was land no horse had trodden;"},{"id":"manas-2010:p0533:b001:l017","ordinal":24183,"en":"Such was the deserted land."},{"id":"manas-2010:p0533:b001:l018","ordinal":24184,"en":"Its apples ripened and became manure;"},{"id":"manas-2010:p0533:b001:l019","ordinal":24185,"en":"Fallen walnuts filled the gullies."},{"id":"manas-2010:p0533:b001:l020","ordinal":24186,"en":"It was empty land without an owner."},{"id":"manas-2010:p0533:b001:l021","ordinal":24187,"en":"The tops of its willows bent;"},{"id":"manas-2010:p0533:b001:l022","ordinal":24188,"en":"The surface of its sand was scored."},{"id":"manas-2010:p0533:b001:l023","ordinal":24189,"en":"The sign of that forlorn land:"},{"id":"manas-2010:p0533:b001:l024","ordinal":24190,"en":"It appeared full of bounty."},{"id":"manas-2010:p0533:b001:l025","ordinal":24191,"en":"The heart of every soul who saw"},{"id":"manas-2010:p0533:b001:l026","ordinal":24192,"en":"Was stirred in many ways."},{"id":"manas-2010:p0533:b001:l027","ordinal":24193,"en":"Its kochia and wormwood,"},{"id":"manas-2010:p0533:b001:l028","ordinal":24194,"en":"My dear Sary-Özön,"},{"id":"manas-2010:p0533:b001:l029","ordinal":24195,"en":"Its gently flowing springs."},{"id":"manas-2010:p0533:b001:l030","ordinal":24196,"en":"A cool breeze filled the valley;"},{"id":"manas-2010:p0533:b001:l031","ordinal":24197,"en":"If you judged it, it was paradise on earth."},{"id":"manas-2010:p0533:b001:l032","ordinal":24198,"en":"Summer and winter alike,"},{"id":"manas-2010:p0533:b001:l033","ordinal":24199,"en":"There was snow upon its mountains."},{"id":"manas-2010:p0533:b001:l034","ordinal":24200,"en":"It appeared an earthly paradise;"},{"id":"manas-2010:p0533:b001:l035","ordinal":24201,"en":"Its woods were full of rooks."},{"id":"manas-2010:p0533:b001:l036","ordinal":24202,"en":"Rejoicing at the sight of the land,"},{"id":"manas-2010:p0533:b001:l037","ordinal":24203,"en":"Your accomplished Manas then"},{"id":"manas-2010:p0533:b001:l038","ordinal":24204,"en":"Stayed seven days, it is said."},{"id":"manas-2010:p0533:b001:l039","ordinal":24205,"en":"In the marsh of Üyrülmö,"},{"id":"manas-2010:p0533:b001:l040","ordinal":24206,"en":"He held an assembly three days, it is said."},{"id":"manas-2010:p0533:b001:l041","ordinal":24207,"en":"In the marsh of Chogulma,"},{"id":"manas-2010:p0533:b001:l042","ordinal":24208,"en":"They stood assembled, it is said."},{"id":"manas-2010:p0534:b001:l001","ordinal":24209,"en":"Seeking one another, they met;"},{"id":"manas-2010:p0534:b001:l002","ordinal":24210,"en":"Chasing one another, they pursued."},{"id":"manas-2010:p0534:b001:l003","ordinal":24211,"en":"Laying their words before all,"},{"id":"manas-2010:p0534:b001:l004","ordinal":24212,"en":"They took counsel together."},{"id":"manas-2010:p0534:b001:l005","ordinal":24213,"en":"Calling like a falcon,"},{"id":"manas-2010:p0534:b001:l006","ordinal":24214,"en":"Your elder Koshoy spoke with a clatter:"},{"id":"manas-2010:p0534:b001:l007","ordinal":24215,"en":"“Skilled men among spearmen,"},{"id":"manas-2010:p0534:b001:l008","ordinal":24216,"en":"Let them remain here,"},{"id":"manas-2010:p0534:b001:l009","ordinal":24217,"en":"The mighty masters of men."},{"id":"manas-2010:p0534:b001:l010","ordinal":24218,"en":"We have migrated from Altai."},{"id":"manas-2010:p0534:b001:l011","ordinal":24219,"en":"Where shall the village settle?"},{"id":"manas-2010:p0534:b001:l012","ordinal":24220,"en":"There are many enemies to grapple with;"},{"id":"manas-2010:p0534:b001:l013","ordinal":24221,"en":"What means shall we find?"},{"id":"manas-2010:p0534:b001:l014","ordinal":24222,"en":"There are Chinese at your flank,"},{"id":"manas-2010:p0534:b001:l015","ordinal":24223,"en":"Many enemies to fight to the death."},{"id":"manas-2010:p0534:b001:l016","ordinal":24224,"en":"Where is a camping ground to settle?"},{"id":"manas-2010:p0534:b001:l017","ordinal":24225,"en":"Before you there are muskets,"},{"id":"manas-2010:p0534:b001:l018","ordinal":24226,"en":"Many foes to contend with."},{"id":"manas-2010:p0534:b001:l019","ordinal":24227,"en":"Beyond lie Talas and At-Bashy."},{"id":"manas-2010:p0534:b001:l020","ordinal":24228,"en":"My dear beloved foal,"},{"id":"manas-2010:p0534:b001:l021","ordinal":24229,"en":"Let us dwell beside one another."},{"id":"manas-2010:p0534:b001:l022","ordinal":24230,"en":"Let us fight our enemies together,"},{"id":"manas-2010:p0534:b001:l023","ordinal":24231,"en":"Let us press our claims together,"},{"id":"manas-2010:p0534:b001:l024","ordinal":24232,"en":"Let us kindle our gun-matches together,"},{"id":"manas-2010:p0534:b001:l025","ordinal":24233,"en":"Let us load our muskets together."},{"id":"manas-2010:p0534:b001:l026","ordinal":24234,"en":"Let us settle side by side."},{"id":"manas-2010:p0534:b001:l027","ordinal":24235,"en":"If a grievous ordeal comes,"},{"id":"manas-2010:p0534:b001:l028","ordinal":24236,"en":"Let us sacrifice ourselves for Manas!"},{"id":"manas-2010:p0534:b001:l029","ordinal":24237,"en":"So that no enemy can strike us,"},{"id":"manas-2010:p0534:b001:l030","ordinal":24238,"en":"Let us set a strong watch."},{"id":"manas-2010:p0534:b001:l031","ordinal":24239,"en":"For the few scattered, destitute people,"},{"id":"manas-2010:p0534:b001:l032","ordinal":24240,"en":"Making Manas their support,"},{"id":"manas-2010:p0534:b001:l033","ordinal":24241,"en":"Let us raise him as khan."},{"id":"manas-2010:p0534:b001:l034","ordinal":24242,"en":"Let us bind our pinewood spears."},{"id":"manas-2010:p0534:b001:l035","ordinal":24243,"en":"Making Manas our support,"},{"id":"manas-2010:p0534:b001:l036","ordinal":24244,"en":"The enemies who challenge us,"},{"id":"manas-2010:p0534:b001:l037","ordinal":24245,"en":"Let us fight till they cough blood."},{"id":"manas-2010:p0534:b001:l038","ordinal":24246,"en":"My son Manas, my foal,"},{"id":"manas-2010:p0534:b001:l039","ordinal":24247,"en":"The black-cheeked battle-axe,"},{"id":"manas-2010:p0534:b001:l040","ordinal":24248,"en":"Fit it firmly, without tilting!"},{"id":"manas-2010:p0534:b001:l041","ordinal":24249,"en":"The vast Black Kyrgyz people,"},{"id":"manas-2010:p0534:b001:l042","ordinal":24250,"en":"Lead them without bringing them to ruin!"},{"id":"manas-2010:p0535:b001:l001","ordinal":24251,"en":"Become a khan like Kara-Too!"},{"id":"manas-2010:p0535:b001:l002","ordinal":24252,"en":"For the forty-tribed Kyrgyz people,"},{"id":"manas-2010:p0535:b001:l003","ordinal":24253,"en":"Become a soul endowed with sacred power!"},{"id":"manas-2010:p0535:b001:l004","ordinal":24254,"en":"Two reins and one lead rope,"},{"id":"manas-2010:p0535:b001:l005","ordinal":24255,"en":"Oh, my foal, warrior Manas,"},{"id":"manas-2010:p0535:b001:l006","ordinal":24256,"en":"Take them now into your hand."},{"id":"manas-2010:p0535:b001:l007","ordinal":24257,"en":"Your warrior elder then,"},{"id":"manas-2010:p0535:b001:l008","ordinal":24258,"en":"Send him where men wrestle!"},{"id":"manas-2010:p0535:b001:l009","ordinal":24259,"en":"I shall attain my wish;"},{"id":"manas-2010:p0535:b001:l010","ordinal":24260,"en":"Leopard Manas, for you,"},{"id":"manas-2010:p0535:b001:l011","ordinal":24261,"en":"I shall go to my death in sacrifice!"},{"id":"manas-2010:p0535:b001:l012","ordinal":24262,"en":"If we place in your hand, may it be blessed,"},{"id":"manas-2010:p0535:b001:l013","ordinal":24263,"en":"The red flag with a golden crescent,"},{"id":"manas-2010:p0535:b001:l014","ordinal":24264,"en":"If you grapple with the Chinese,"},{"id":"manas-2010:p0535:b001:l015","ordinal":24265,"en":"And raise a mighty uproar,"},{"id":"manas-2010:p0535:b001:l016","ordinal":24266,"en":"I shall turn Kabylan's mouth toward them."},{"id":"manas-2010:p0535:b001:l017","ordinal":24267,"en":"Until my death comes and I die,"},{"id":"manas-2010:p0535:b001:l018","ordinal":24268,"en":"I shall stand beneath the flag!"},{"id":"manas-2010:p0535:b001:l019","ordinal":24269,"en":"Be pleased with me,"},{"id":"manas-2010:p0535:b001:l020","ordinal":24270,"en":"Keep me within your sight."},{"id":"manas-2010:p0535:b001:l021","ordinal":24271,"en":"Among those scattered, destitute people,"},{"id":"manas-2010:p0535:b001:l022","ordinal":24272,"en":"Go from time to time."},{"id":"manas-2010:p0535:b001:l023","ordinal":24273,"en":"‘Elder Koshoy, give it,’ you shall say,"},{"id":"manas-2010:p0535:b001:l024","ordinal":24274,"en":"And take your tribute!"},{"id":"manas-2010:p0535:b001:l025","ordinal":24275,"en":"You have become this people's leader;"},{"id":"manas-2010:p0535:b001:l026","ordinal":24276,"en":"We shall heed what you say."},{"id":"manas-2010:p0535:b001:l027","ordinal":24277,"en":"Until your elder khan enters the earth,"},{"id":"manas-2010:p0535:b001:l028","ordinal":24278,"en":"Leopard Manas, my foal,"},{"id":"manas-2010:p0535:b001:l029","ordinal":24279,"en":"We give the khanship to you."},{"id":"manas-2010:p0535:b001:l030","ordinal":24280,"en":"You are my city with its royal court,"},{"id":"manas-2010:p0535:b001:l031","ordinal":24281,"en":"You are my saintlike soul."},{"id":"manas-2010:p0535:b001:l032","ordinal":24282,"en":"Long ago I knew you would arise."},{"id":"manas-2010:p0535:b001:l033","ordinal":24283,"en":"‘When will the leopard come?’ I said,"},{"id":"manas-2010:p0535:b001:l034","ordinal":24284,"en":"And waited for you."},{"id":"manas-2010:p0535:b001:l035","ordinal":24285,"en":"With courtly silks and blue leather,"},{"id":"manas-2010:p0535:b001:l036","ordinal":24286,"en":"Mighty Kokand and Margilan,"},{"id":"manas-2010:p0535:b001:l037","ordinal":24287,"en":"At the far end, Keptesh and Samarkand,"},{"id":"manas-2010:p0535:b001:l038","ordinal":24288,"en":"Alty-Shaar to the east,"},{"id":"manas-2010:p0535:b001:l039","ordinal":24289,"en":"‘He will come,’ they wait for you."},{"id":"manas-2010:p0535:b001:l040","ordinal":24290,"en":"So many peoples await you."},{"id":"manas-2010:p0535:b001:l041","ordinal":24291,"en":"Prepare a treasury, gather an army;"},{"id":"manas-2010:p0535:b001:l042","ordinal":24292,"en":"Gather abundant, mighty courage,"},{"id":"manas-2010:p0536:b001:l001","ordinal":24293,"en":"Find land where you can fortify yourself,"},{"id":"manas-2010:p0536:b001:l002","ordinal":24294,"en":"Find strong-backed warriors,"},{"id":"manas-2010:p0536:b001:l003","ordinal":24295,"en":"Prepare fully, gather an army."},{"id":"manas-2010:p0536:b001:l004","ordinal":24296,"en":"So the people do not scatter,"},{"id":"manas-2010:p0536:b001:l005","ordinal":24297,"en":"Gather a plentiful treasury!"},{"id":"manas-2010:p0536:b001:l006","ordinal":24298,"en":"If you look beyond Khiva,"},{"id":"manas-2010:p0536:b001:l007","ordinal":24299,"en":"There is the khan of the Kyzylbash;"},{"id":"manas-2010:p0536:b001:l008","ordinal":24300,"en":"There are still enemies to slay."},{"id":"manas-2010:p0536:b001:l009","ordinal":24301,"en":"Who would spill blood without looking back,"},{"id":"manas-2010:p0536:b001:l010","ordinal":24302,"en":"All those daughter-damned men are there!"},{"id":"manas-2010:p0536:b001:l011","ordinal":24303,"en":"Khan Molto who came from China—"},{"id":"manas-2010:p0536:b001:l012","ordinal":24304,"en":"You stand between them."},{"id":"manas-2010:p0536:b001:l013","ordinal":24305,"en":"Oh, my Manas, listen!"},{"id":"manas-2010:p0536:b001:l014","ordinal":24306,"en":"When you grow stout, recover and prosper,"},{"id":"manas-2010:p0536:b001:l015","ordinal":24307,"en":"When you settle upon the terrace,"},{"id":"manas-2010:p0536:b001:l016","ordinal":24308,"en":"When you settle by the river waters,"},{"id":"manas-2010:p0536:b001:l017","ordinal":24309,"en":"Governing the people, ruling the nation,"},{"id":"manas-2010:p0536:b001:l018","ordinal":24310,"en":"When you stand on your own,"},{"id":"manas-2010:p0536:b001:l019","ordinal":24311,"en":"With striking words to say,"},{"id":"manas-2010:p0536:b001:l020","ordinal":24312,"en":"If pressure falls upon your head,"},{"id":"manas-2010:p0536:b001:l021","ordinal":24313,"en":"To find counsel for you,"},{"id":"manas-2010:p0536:b001:l022","ordinal":24314,"en":"Your elder Koshoy himself is here."},{"id":"manas-2010:p0536:b001:l023","ordinal":24315,"en":"The two khans just mentioned,"},{"id":"manas-2010:p0536:b001:l024","ordinal":24316,"en":"Upon you yourself, Lord Manas,"},{"id":"manas-2010:p0536:b001:l025","ordinal":24317,"en":"Have venom to pour."},{"id":"manas-2010:p0536:b001:l026","ordinal":24318,"en":"There will be deceit in their words,"},{"id":"manas-2010:p0536:b001:l027","ordinal":24319,"en":"There will be guile in their eyes."},{"id":"manas-2010:p0536:b001:l028","ordinal":24320,"en":"If they have the strength,"}]
