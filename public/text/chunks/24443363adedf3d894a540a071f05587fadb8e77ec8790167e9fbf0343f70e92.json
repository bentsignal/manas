[{"id":"seytek-1991-continuation:p0315:b002:l001","ordinal":385281,"en":"The moon waned and days passed,"},{"id":"seytek-1991-continuation:p0315:b002:l002","ordinal":385282,"en":"Many more days passed,"},{"id":"seytek-1991-continuation:p0315:b002:l003","ordinal":385283,"en":"Nine months were fulfilled,"},{"id":"seytek-1991-continuation:p0315:b002:l004","ordinal":385284,"en":"And after nine more days had passed,"},{"id":"seytek-1991-continuation:p0315:b002:l005","ordinal":385285,"en":"When her time was complete,"},{"id":"seytek-1991-continuation:p0315:b002:l006","ordinal":385286,"en":"The unfortunate noblewoman"},{"id":"seytek-1991-continuation:p0315:b002:l007","ordinal":385287,"en":"Went into labor."},{"id":"seytek-1991-continuation:p0315:b002:l008","ordinal":385288,"en":"Her waist ached above,"},{"id":"seytek-1991-continuation:p0315:b002:l009","ordinal":385289,"en":"Where death might strike, it ached,"},{"id":"seytek-1991-continuation:p0315:b002:l010","ordinal":385290,"en":"Both her dark thighs ached,"},{"id":"seytek-1991-continuation:p0315:b002:l011","ordinal":385291,"en":"Every bone, limb, and sinew,"},{"id":"seytek-1991-continuation:p0315:b002:l012","ordinal":385292,"en":"Without exception, ached,"},{"id":"seytek-1991-continuation:p0315:b002:l013","ordinal":385293,"en":"Her frail soul screamed,"},{"id":"seytek-1991-continuation:p0315:b002:l014","ordinal":385294,"en":"Unable to endure, she sobbed,"},{"id":"seytek-1991-continuation:p0315:b002:l015","ordinal":385295,"en":"Her ribs seemed torn apart,"},{"id":"seytek-1991-continuation:p0315:b002:l016","ordinal":385296,"en":"As though it would take her life now,"},{"id":"seytek-1991-continuation:p0315:b002:l017","ordinal":385297,"en":"The poor lady was utterly spent,"},{"id":"seytek-1991-continuation:p0315:b002:l018","ordinal":385298,"en":"As though bowing low, she would surrender her life,"},{"id":"seytek-1991-continuation:p0315:b002:l019","ordinal":385299,"en":"So grievous were her labor pains,"},{"id":"seytek-1991-continuation:p0315:b002:l020","ordinal":385300,"en":"Her life hung by a single hair,"},{"id":"seytek-1991-continuation:p0315:b002:l021","ordinal":385301,"en":"Her thoughts scattered in a thousand directions,"},{"id":"seytek-1991-continuation:p0315:b002:l022","ordinal":385302,"en":"Her frail soul was blown away,"},{"id":"seytek-1991-continuation:p0315:b002:l023","ordinal":385303,"en":"She strained and writhed,"},{"id":"seytek-1991-continuation:p0315:b002:l024","ordinal":385304,"en":"Her bewildered mind was divided,"},{"id":"seytek-1991-continuation:p0315:b002:l025","ordinal":385305,"en":"That accursed, merciless death"},{"id":"seytek-1991-continuation:p0315:b002:l026","ordinal":385306,"en":"Now appeared before her eyes,"},{"id":"seytek-1991-continuation:p0315:b002:l027","ordinal":385307,"en":"Worn down by torment,"},{"id":"seytek-1991-continuation:p0315:b002:l028","ordinal":385308,"en":"Seeing no hope, she despaired of life,"},{"id":"seytek-1991-continuation:p0315:b002:l029","ordinal":385309,"en":"When the fiercest labor came,"},{"id":"seytek-1991-continuation:p0315:b002:l030","ordinal":385310,"en":"For life is sweet until death,"},{"id":"seytek-1991-continuation:p0315:b002:l031","ordinal":385311,"en":"She kept writhing in agony."},{"id":"seytek-1991-continuation:p0315:b002:l032","ordinal":385312,"en":"At midnight,"},{"id":"seytek-1991-continuation:p0315:b002:l033","ordinal":385313,"en":"When her labor came to term,"},{"id":"seytek-1991-continuation:p0315:b002:l034","ordinal":385314,"en":"When the appointed hour was fulfilled,"},{"id":"seytek-1991-continuation:p0315:b002:l035","ordinal":385315,"en":"Sixty old matrons"},{"id":"seytek-1991-continuation:p0315:b004:l001","ordinal":385316,"en":"Waited in a circle around her,"},{"id":"seytek-1991-continuation:p0315:b004:l002","ordinal":385317,"en":"What a wondrous sight it was,"},{"id":"seytek-1991-continuation:p0315:b004:l003","ordinal":385318,"en":"A figure blessed with sacred grace,"},{"id":"seytek-1991-continuation:p0315:b004:l004","ordinal":385319,"en":"The wonder of it was this:"},{"id":"seytek-1991-continuation:p0315:b004:l005","ordinal":385320,"en":"The moon rose upon his brow,"},{"id":"seytek-1991-continuation:p0315:b004:l006","ordinal":385321,"en":"The sun stood above his crown,"},{"id":"seytek-1991-continuation:p0315:b004:l007","ordinal":385322,"en":"His perfect fortune set forth,"},{"id":"seytek-1991-continuation:p0315:b004:l008","ordinal":385323,"en":"The fierce black-maned leopard—"},{"id":"seytek-1991-continuation:p0315:b004:l009","ordinal":385324,"en":"She gave birth to brave Kenen."},{"id":"seytek-1991-continuation:p0315:b005:l001","ordinal":385325,"en":"The child dropped forth crying,"},{"id":"seytek-1991-continuation:p0315:b005:l002","ordinal":385326,"en":"Shouting every battle cry,"},{"id":"seytek-1991-continuation:p0315:b005:l003","ordinal":385327,"en":"He landed upright on his soles,"},{"id":"seytek-1991-continuation:p0315:b005:l004","ordinal":385328,"en":"His kin rejoiced,"},{"id":"seytek-1991-continuation:p0315:b005:l005","ordinal":385329,"en":"But the hateful enemy who begrudged him"},{"id":"seytek-1991-continuation:p0315:b005:l006","ordinal":385330,"en":"Felt his breast split apart."},{"id":"seytek-1991-continuation:p0315:b005:l007","ordinal":385331,"en":"He bore every heroic sign,"},{"id":"seytek-1991-continuation:p0315:b005:l008","ordinal":385332,"en":"And when they looked at his back,"},{"id":"seytek-1991-continuation:p0315:b005:l009","ordinal":385333,"en":"He had a black mane a span long,"},{"id":"seytek-1991-continuation:p0315:b006:l001","ordinal":385334,"en":"All the old women scurried,"},{"id":"seytek-1991-continuation:p0315:b006:l002","ordinal":385335,"en":"And all the young wives,"},{"id":"seytek-1991-continuation:p0315:b006:l003","ordinal":385336,"en":"Saying, “What an extraordinary horror!"},{"id":"seytek-1991-continuation:p0315:b006:l004","ordinal":385337,"en":"This is no child but a calamity,"},{"id":"seytek-1991-continuation:p0315:b006:l005","ordinal":385338,"en":"He is something wholly different,"},{"id":"seytek-1991-continuation:p0315:b006:l006","ordinal":385339,"en":"He has a roaring voice,"},{"id":"seytek-1991-continuation:p0315:b006:l007","ordinal":385340,"en":"Hair grows upon his back,"},{"id":"seytek-1991-continuation:p0315:b006:l008","ordinal":385341,"en":"Fur covers his body,"},{"id":"seytek-1991-continuation:p0315:b006:l009","ordinal":385342,"en":"He is one who will leave none unharmed,"},{"id":"seytek-1991-continuation:p0315:b006:l010","ordinal":385343,"en":"The black eye of disaster!”"},{"id":"seytek-1991-continuation:p0315:b006:l011","ordinal":385344,"en":"Losing their senses,"},{"id":"seytek-1991-continuation:p0315:b006:l012","ordinal":385345,"en":"As though he might seize and swallow a young child,"},{"id":"seytek-1991-continuation:p0315:b006:l013","ordinal":385346,"en":"They panicked and trembled,"},{"id":"seytek-1991-continuation:p0315:b006:l014","ordinal":385347,"en":"Many fled in terror,"},{"id":"seytek-1991-continuation:p0315:b006:l015","ordinal":385348,"en":"Many muttered incantations,"},{"id":"seytek-1991-continuation:p0315:b006:l016","ordinal":385349,"en":"And many among the people grumbled."},{"id":"seytek-1991-continuation:p0316:b001:l001","ordinal":385350,"en":"The noble Gulayym,"},{"id":"seytek-1991-continuation:p0316:b001:l002","ordinal":385351,"en":"The true lady, peer of princes,"},{"id":"seytek-1991-continuation:p0316:b001:l003","ordinal":385352,"en":"The capable lady in all she did,"},{"id":"seytek-1991-continuation:p0316:b001:l004","ordinal":385353,"en":"Purest among those with brass thimbles,"},{"id":"seytek-1991-continuation:p0316:b001:l005","ordinal":385354,"en":"Foremost among the scarf-wearing women,"},{"id":"seytek-1991-continuation:p0316:b001:l006","ordinal":385355,"en":"Said to the old women who were fleeing,"},{"id":"seytek-1991-continuation:p0316:b001:l007","ordinal":385356,"en":"“Fall down and be damned,"},{"id":"seytek-1991-continuation:p0316:b001:l008","ordinal":385357,"en":"May grave dust fill your eyes!”"},{"id":"seytek-1991-continuation:p0316:b001:l009","ordinal":385358,"en":"She scattered earth and chanted,"},{"id":"seytek-1991-continuation:p0316:b001:l010","ordinal":385359,"en":"Performing many different rites,"},{"id":"seytek-1991-continuation:p0316:b001:l011","ordinal":385360,"en":"Invoking Baabedin’s blessing,"},{"id":"seytek-1991-continuation:p0316:b001:l012","ordinal":385361,"en":"Naming a horse for the crescent hoof,"},{"id":"seytek-1991-continuation:p0316:b001:l013","ordinal":385362,"en":"Then slowly turned,"},{"id":"seytek-1991-continuation:p0316:b001:l014","ordinal":385363,"en":"And before the child upon the shield,"},{"id":"seytek-1991-continuation:p0316:b001:l015","ordinal":385364,"en":"The luckless woman repented,"},{"id":"seytek-1991-continuation:p0316:b001:l016","ordinal":385365,"en":"Bowing as young wives do,"},{"id":"seytek-1991-continuation:p0316:b001:l017","ordinal":385366,"en":"And opened her skirts, crying, “God!”"},{"id":"seytek-1991-continuation:p0316:b001:l018","ordinal":385367,"en":"When she looked at Kenen,"},{"id":"seytek-1991-continuation:p0316:b001:l019","ordinal":385368,"en":"Dark within and blue-gray without,"},{"id":"seytek-1991-continuation:p0316:b001:l020","ordinal":385369,"en":"He was one beyond all reckoning,"},{"id":"seytek-1991-continuation:p0316:b001:l021","ordinal":385370,"en":"His courage was singular, his wrath mighty,"},{"id":"seytek-1991-continuation:p0316:b001:l022","ordinal":385371,"en":"Such were the poor child’s black eyes."},{"id":"seytek-1991-continuation:p0316:b001:l023","ordinal":385372,"en":"He was one of the mightiest heroes,"},{"id":"seytek-1991-continuation:p0316:b001:l024","ordinal":385373,"en":"The lion of the Kyrgyz people."},{"id":"seytek-1991-continuation:p0316:b001:l025","ordinal":385374,"en":"With a steel razor in her hand,"},{"id":"seytek-1991-continuation:p0316:b001:l026","ordinal":385375,"en":"She swiftly cut his cord."},{"id":"seytek-1991-continuation:p0316:b001:l027","ordinal":385376,"en":"Saying, “Blessed be the day you saw the light,”"},{"id":"seytek-1991-continuation:p0316:b001:l028","ordinal":385377,"en":"She wrapped him in a robe,"},{"id":"seytek-1991-continuation:p0316:b001:l029","ordinal":385378,"en":"Into his right hand, black blood"},{"id":"seytek-1991-continuation:p0316:b001:l030","ordinal":385379,"en":"Brave Kenen grasped,"},{"id":"seytek-1991-continuation:p0316:b001:l031","ordinal":385380,"en":"Into his left hand, yellow gold"},{"id":"seytek-1991-continuation:p0316:b001:l032","ordinal":385381,"en":"Brave Kenen clutched."},{"id":"seytek-1991-continuation:p0316:b001:l033","ordinal":385382,"en":"He cried and roared wrathfully,"},{"id":"seytek-1991-continuation:p0316:b001:l034","ordinal":385383,"en":"To the vast multitude,"},{"id":"seytek-1991-continuation:p0316:b001:l035","ordinal":385384,"en":"As if crying, “I shall be the people’s guardian,”"},{"id":"seytek-1991-continuation:p0316:b001:l036","ordinal":385385,"en":"Thus he raised his battle cry,"},{"id":"seytek-1991-continuation:p0316:b001:l037","ordinal":385386,"en":"While still in the birth membrane, the child"},{"id":"seytek-1991-continuation:p0316:b001:l038","ordinal":385387,"en":"Was known to be destined for a khan,"},{"id":"seytek-1991-continuation:p0316:b001:l039","ordinal":385388,"en":"The fierce black-maned leopard"},{"id":"seytek-1991-continuation:p0316:b001:l040","ordinal":385389,"en":"Was known to be a peerless soul."},{"id":"seytek-1991-continuation:p0316:b001:l041","ordinal":385390,"en":"Against the wrathful foe,"},{"id":"seytek-1991-continuation:p0316:b001:l042","ordinal":385391,"en":"He showed he would stand firm,"},{"id":"seytek-1991-continuation:p0316:b001:l043","ordinal":385392,"en":"To the darkly raging fierce leopard,"},{"id":"seytek-1991-continuation:p0316:b001:l044","ordinal":385393,"en":"He was known to become a fire,"},{"id":"seytek-1991-continuation:p0316:b001:l045","ordinal":385394,"en":"In battle against the enemy,"},{"id":"seytek-1991-continuation:p0316:b001:l046","ordinal":385395,"en":"He was known to stand his ground."},{"id":"seytek-1991-continuation:p0316:b001:l047","ordinal":385396,"en":"He opened his mouth and roared,"},{"id":"seytek-1991-continuation:p0316:b001:l048","ordinal":385397,"en":"And the black blood in his hand"},{"id":"seytek-1991-continuation:p0316:b001:l049","ordinal":385398,"en":"He flung in a storm."},{"id":"seytek-1991-continuation:p0316:b002:l001","ordinal":385399,"en":"If a savage, turbulent enemy arose"},{"id":"seytek-1991-continuation:p0316:b002:l002","ordinal":385400,"en":"And came to grapple with his people,"},{"id":"seytek-1991-continuation:p0316:b002:l003","ordinal":385401,"en":"He meant to crush the black foe,"},{"id":"seytek-1991-continuation:p0316:b002:l004","ordinal":385402,"en":"And scatter his blood,"},{"id":"seytek-1991-continuation:p0316:b002:l005","ordinal":385403,"en":"The people’s defending hero"},{"id":"seytek-1991-continuation:p0316:b002:l006","ordinal":385404,"en":"Meant to guard the nation."},{"id":"seytek-1991-continuation:p0316:b002:l007","ordinal":385405,"en":"Sixty young wives and forty old women"},{"id":"seytek-1991-continuation:p0316:b002:l008","ordinal":385406,"en":"Could find no composure,"},{"id":"seytek-1991-continuation:p0316:b002:l009","ordinal":385407,"en":"Could not endure his countenance,"},{"id":"seytek-1991-continuation:p0316:b002:l010","ordinal":385408,"en":"Could not withstand his majesty,"},{"id":"seytek-1991-continuation:p0316:b002:l011","ordinal":385409,"en":"And in a flustered panic,"},{"id":"seytek-1991-continuation:p0316:b002:l012","ordinal":385410,"en":"They paced back and forth."},{"id":"seytek-1991-continuation:p0316:b002:l013","ordinal":385411,"en":"The yellow gold in his left hand,"},{"id":"seytek-1991-continuation:p0316:b002:l014","ordinal":385412,"en":"With many different cries,"},{"id":"seytek-1991-continuation:p0316:b002:l015","ordinal":385413,"en":"The roaring child scattered."},{"id":"seytek-1991-continuation:p0316:b002:l016","ordinal":385414,"en":"By scattering his omen,"},{"id":"seytek-1991-continuation:p0316:b002:l017","ordinal":385415,"en":"He meant that if an equal foe arose,"},{"id":"seytek-1991-continuation:p0316:b002:l018","ordinal":385416,"en":"He would turn him yellow as gold,"},{"id":"seytek-1991-continuation:p0316:b002:l019","ordinal":385417,"en":"Drain all strength from his limbs,"},{"id":"seytek-1991-continuation:p0316:b002:l020","ordinal":385418,"en":"And afflict him with jaundice."},{"id":"seytek-1991-continuation:p0316:b002:l021","ordinal":385419,"en":"If the foe pressed upon his throat,"},{"id":"seytek-1991-continuation:p0316:b002:l022","ordinal":385420,"en":"He meant to seize his people and possessions."},{"id":"seytek-1991-continuation:p0316:b002:l023","ordinal":385421,"en":"If a foe came forth to challenge him,"},{"id":"seytek-1991-continuation:p0316:b002:l024","ordinal":385422,"en":"He would pursue vengeance for six generations of fathers,"},{"id":"seytek-1991-continuation:p0316:b002:l025","ordinal":385423,"en":"Turn him yellow as jaundice,"},{"id":"seytek-1991-continuation:p0316:b002:l026","ordinal":385424,"en":"And take revenge."},{"id":"seytek-1991-continuation:p0316:b002:l027","ordinal":385425,"en":"A mighty bird of prey came to the perch,"},{"id":"seytek-1991-continuation:p0316:b002:l028","ordinal":385426,"en":"The falcon Kenen came into the world,"},{"id":"seytek-1991-continuation:p0316:b002:l029","ordinal":385427,"en":"They devised wonders no man had conceived,"},{"id":"seytek-1991-continuation:p0316:b002:l030","ordinal":385428,"en":"And held a feast that satisfied the world,"},{"id":"seytek-1991-continuation:p0316:b002:l031","ordinal":385429,"en":"The people’s hearts found peace,"},{"id":"seytek-1991-continuation:p0316:b002:l032","ordinal":385430,"en":"At word that Seytek had seen Kenen,"},{"id":"seytek-1991-continuation:p0316:b002:l033","ordinal":385431,"en":"The multitude throughout Ala-Too,"},{"id":"seytek-1991-continuation:p0316:b002:l034","ordinal":385432,"en":"With vast treasure and mighty fortune,"},{"id":"seytek-1991-continuation:p0316:b002:l035","ordinal":385433,"en":"Were overcome with tenderness,"},{"id":"seytek-1991-continuation:p0316:b002:l036","ordinal":385434,"en":"Their living hearts rejoiced,"},{"id":"seytek-1991-continuation:p0316:b002:l037","ordinal":385435,"en":"For at his birth the signs"},{"id":"seytek-1991-continuation:p0316:b002:l038","ordinal":385436,"en":"Showed that he would be a lion,"},{"id":"seytek-1991-continuation:p0316:b002:l039","ordinal":385437,"en":"Without delay they prepared a feast,"},{"id":"seytek-1991-continuation:p0316:b002:l040","ordinal":385438,"en":"And the great host surged with excitement,"},{"id":"seytek-1991-continuation:p0316:b002:l041","ordinal":385439,"en":"With meat heaped like Ala-Too,"},{"id":"seytek-1991-continuation:p0316:b002:l042","ordinal":385440,"en":"And broth spread like Ala-Köl,"},{"id":"seytek-1991-continuation:p0316:b002:l043","ordinal":385441,"en":"The tumultuous revelry of the feast"},{"id":"seytek-1991-continuation:p0316:b002:l044","ordinal":385442,"en":"Subsided after nine days,"},{"id":"seytek-1991-continuation:p0316:b002:l045","ordinal":385443,"en":"The entertainment had been abundant,"},{"id":"seytek-1991-continuation:p0316:b002:l046","ordinal":385444,"en":"And the people’s longing was fulfilled,"},{"id":"seytek-1991-continuation:p0316:b002:l047","ordinal":385445,"en":"He became a giant no horse could bear,"},{"id":"seytek-1991-continuation:p0316:b002:l048","ordinal":385446,"en":"And became lord of all the Kyrgyz,"},{"id":"seytek-1991-continuation:p0316:b002:l049","ordinal":385447,"en":"A glorious khan,"},{"id":"seytek-1991-continuation:p0317:b001:l001","ordinal":385448,"en":"A man whose weight was like a mountain."},{"id":"seytek-1991-continuation:p0317:b001:l002","ordinal":385449,"en":"He now came to bear the name Kenen,"},{"id":"seytek-1991-continuation:p0317:b001:l003","ordinal":385450,"en":"The hero now became his people’s fortress."},{"id":"seytek-1991-continuation:p0317:b001:l004","ordinal":385451,"en":"He now mounted Kertulpar,"},{"id":"seytek-1991-continuation:p0317:b001:l005","ordinal":385452,"en":"And as a majestic khan,"},{"id":"seytek-1991-continuation:p0317:b001:l006","ordinal":385453,"en":"He ruled the people."},{"id":"seytek-1991-continuation:p0317:b001:l007","ordinal":385454,"en":"While matters stood thus,"},{"id":"seytek-1991-continuation:p0317:b001:l008","ordinal":385455,"en":"Janaaly and Karach were khans,"},{"id":"seytek-1991-continuation:p0317:b001:l009","ordinal":385456,"en":"The two had been born as twins,"},{"id":"seytek-1991-continuation:p0317:b001:l010","ordinal":385457,"en":"They stirred the people and ruined nations,"},{"id":"seytek-1991-continuation:p0317:b001:l011","ordinal":385458,"en":"Those accursed madmen, blazing until death,"},{"id":"seytek-1991-continuation:p0317:b001:l012","ordinal":385459,"en":"From ancient times had borne"},{"id":"seytek-1991-continuation:p0317:b001:l013","ordinal":385460,"en":"Enmity toward the fierce leopard."},{"id":"seytek-1991-continuation:p0317:b001:l014","ordinal":385461,"en":"From those khans Janaaly and Karach,"},{"id":"seytek-1991-continuation:p0317:b001:l015","ordinal":385462,"en":"The two giants Ebegey and Kögöy"},{"id":"seytek-1991-continuation:p0317:b001:l016","ordinal":385463,"en":"Were born beyond all reckoning."},{"id":"seytek-1991-continuation:p0317:b001:l017","ordinal":385464,"en":"Beyond Bukhara and Sharip,"},{"id":"seytek-1991-continuation:p0317:b001:l018","ordinal":385465,"en":"This side of ancient Chambyl,"},{"id":"seytek-1991-continuation:p0317:b001:l019","ordinal":385466,"en":"Lay Belendi’s Sary-Bel,"},{"id":"seytek-1991-continuation:p0317:b001:l020","ordinal":385467,"en":"And they were born in Sary-Bel."},{"id":"seytek-1991-continuation:p0317:b001:l021","ordinal":385468,"en":"The two giants Ebegey and Kögöy"},{"id":"seytek-1991-continuation:p0317:b001:l022","ordinal":385469,"en":"Recently heard tidings from caravans,"},{"id":"seytek-1991-continuation:p0317:b001:l023","ordinal":385470,"en":"They heard that Semetey was dead, and his wretched son"},{"id":"seytek-1991-continuation:p0317:b001:l024","ordinal":385471,"en":"Seytek remained,"},{"id":"seytek-1991-continuation:p0317:b001:l025","ordinal":385472,"en":"Black-headed and cloven-footed,"},{"id":"seytek-1991-continuation:p0317:b001:l026","ordinal":385473,"en":"Led about by the hero Joltoy,"},{"id":"seytek-1991-continuation:p0317:b001:l027","ordinal":385474,"en":"Like so much livestock, they heard,"},{"id":"seytek-1991-continuation:p0317:b001:l028","ordinal":385475,"en":"So they advanced to wage war,"},{"id":"seytek-1991-continuation:p0317:b001:l029","ordinal":385476,"en":"To avenge an ancient grudge,"},{"id":"seytek-1991-continuation:p0317:b001:l030","ordinal":385477,"en":"Shrouding themselves as in mourning,"},{"id":"seytek-1991-continuation:p0317:b001:l031","ordinal":385478,"en":"And gathering again like clouds"},{"id":"seytek-1991-continuation:p0317:b001:l032","ordinal":385479,"en":"About to pour a violent rain,"},{"id":"seytek-1991-continuation:p0317:b001:l033","ordinal":385480,"en":"Ebegey and Kögöy thirsted for blood,"},{"id":"seytek-1991-continuation:p0317:b001:l034","ordinal":385481,"en":"The fools raged,"},{"id":"seytek-1991-continuation:p0317:b001:l035","ordinal":385482,"en":"The murderous lions sought battle,"},{"id":"seytek-1991-continuation:p0317:b001:l036","ordinal":385483,"en":"And the black earth grew hard beneath them."},{"id":"seytek-1991-continuation:p0317:b001:l037","ordinal":385484,"en":"They roared and thundered,"},{"id":"seytek-1991-continuation:p0317:b001:l038","ordinal":385485,"en":"And loaded their great guns,"},{"id":"seytek-1991-continuation:p0317:b001:l039","ordinal":385486,"en":"Oh, my child, the black earth, unable to overturn,"},{"id":"seytek-1991-continuation:p0317:b001:l040","ordinal":385487,"en":"Was held firm by its massive weight."},{"id":"seytek-1991-continuation:p0317:b001:l041","ordinal":385488,"en":"Their raven eyes blazed,"},{"id":"seytek-1991-continuation:p0317:b001:l042","ordinal":385489,"en":"They had their fine steeds tethered,"},{"id":"seytek-1991-continuation:p0317:b001:l043","ordinal":385490,"en":"Terrifying all they threatened,"},{"id":"seytek-1991-continuation:p0317:b001:l044","ordinal":385491,"en":"And had the racehorses saddled,"},{"id":"seytek-1991-continuation:p0317:b001:l045","ordinal":385492,"en":"Then the two giants"},{"id":"seytek-1991-continuation:p0317:b001:l046","ordinal":385493,"en":"Took eighty warriors from Kambyl,"},{"id":"seytek-1991-continuation:p0317:b001:l047","ordinal":385494,"en":"Darkening with rage,"},{"id":"seytek-1991-continuation:p0317:b001:l048","ordinal":385495,"en":"Rain falling from their fury,"},{"id":"seytek-1991-continuation:p0317:b001:l049","ordinal":385496,"en":"Water streaming from their march,"},{"id":"seytek-1991-continuation:p0317:b003:l001","ordinal":385497,"en":"An uproar rising at their tidings,"},{"id":"seytek-1991-continuation:p0317:b003:l002","ordinal":385498,"en":"They prepared horses to mount with a bound,"},{"id":"seytek-1991-continuation:p0317:b003:l003","ordinal":385499,"en":"And coats to don when refreshed,"},{"id":"seytek-1991-continuation:p0317:b003:l004","ordinal":385500,"en":"They laid in abundant ammunition,"},{"id":"seytek-1991-continuation:p0317:b003:l005","ordinal":385501,"en":"And had their weapons packed,"},{"id":"seytek-1991-continuation:p0317:b003:l006","ordinal":385502,"en":"They loaded a red camel,"},{"id":"seytek-1991-continuation:p0317:b003:l007","ordinal":385503,"en":"That could travel forty days without water,"},{"id":"seytek-1991-continuation:p0317:b003:l008","ordinal":385504,"en":"And never once grow faint with weariness,"},{"id":"seytek-1991-continuation:p0317:b003:l009","ordinal":385505,"en":"The equal of the swiftest riding camel,"},{"id":"seytek-1991-continuation:p0317:b003:l010","ordinal":385506,"en":"No other beast like it existed,"},{"id":"seytek-1991-continuation:p0317:b003:l011","ordinal":385507,"en":"Hook-nosed, with a back like a trap,"},{"id":"seytek-1991-continuation:p0317:b003:l012","ordinal":385508,"en":"They mounted their horses in ordered ranks,"},{"id":"seytek-1991-continuation:p0317:b003:l013","ordinal":385509,"en":"And fitted handsome harness,"},{"id":"seytek-1991-continuation:p0317:b003:l014","ordinal":385510,"en":"They draped themselves in warriors’ coats,"},{"id":"seytek-1991-continuation:p0317:b003:l015","ordinal":385511,"en":"The two lions Ebegey and Kögöy"},{"id":"seytek-1991-continuation:p0317:b003:l016","ordinal":385512,"en":"Had long been making ready."},{"id":"seytek-1991-continuation:p0317:b003:l017","ordinal":385513,"en":"The two villains Ebegey and Kögöy"},{"id":"seytek-1991-continuation:p0317:b003:l018","ordinal":385514,"en":"Set out to ravage the people,"},{"id":"seytek-1991-continuation:p0317:b003:l019","ordinal":385515,"en":"Traveling for many days,"},{"id":"seytek-1991-continuation:p0317:b003:l020","ordinal":385516,"en":"They reached great Khotan beyond Kashgar,"},{"id":"seytek-1991-continuation:p0317:b003:l021","ordinal":385517,"en":"Made great Khotan their base,"},{"id":"seytek-1991-continuation:p0317:b003:l022","ordinal":385518,"en":"Skirted broad Kashgar,"},{"id":"seytek-1991-continuation:p0317:b003:l023","ordinal":385519,"en":"Encircled the Six Cities,"},{"id":"seytek-1991-continuation:p0317:b003:l024","ordinal":385520,"en":"Watched the hill country closely,"},{"id":"seytek-1991-continuation:p0317:b003:l025","ordinal":385521,"en":"And once again destroyed"},{"id":"seytek-1991-continuation:p0317:b003:l026","ordinal":385522,"en":"All the fine horses of the valleys,"},{"id":"seytek-1991-continuation:p0317:b003:l027","ordinal":385523,"en":"Brave Seytek was the one they sought,"},{"id":"seytek-1991-continuation:p0317:b003:l028","ordinal":385524,"en":"Their hearts black as soot,"},{"id":"seytek-1991-continuation:p0317:b003:l029","ordinal":385525,"en":"They came straight toward him."},{"id":"seytek-1991-continuation:p0317:b003:l030","ordinal":385526,"en":"Let us leave this matter here,"},{"id":"seytek-1991-continuation:p0317:b003:l031","ordinal":385527,"en":"And of your heroic elder Akjoltoy,"},{"id":"seytek-1991-continuation:p0317:b003:l032","ordinal":385528,"en":"Let us now begin the tale."},{"id":"seytek-1991-continuation:p0317:b003:l033","ordinal":385529,"en":"The well-built racehorse Kulunsur"},{"id":"seytek-1991-continuation:p0317:b003:l034","ordinal":385530,"en":"Was his tethered mount,"},{"id":"seytek-1991-continuation:p0317:b003:l035","ordinal":385531,"en":"While he lived as a hero on the people’s frontier,"},{"id":"seytek-1991-continuation:p0317:b003:l036","ordinal":385532,"en":"In the middle of the night"},{"id":"seytek-1991-continuation:p0317:b003:l037","ordinal":385533,"en":"He awoke with a start,"},{"id":"seytek-1991-continuation:p0317:b003:l038","ordinal":385534,"en":"Tossing and turning anxiously,"},{"id":"seytek-1991-continuation:p0317:b003:l039","ordinal":385535,"en":"And saddled Kulunsur,"},{"id":"seytek-1991-continuation:p0317:b003:l040","ordinal":385536,"en":"“It has now been seven days,"}]
