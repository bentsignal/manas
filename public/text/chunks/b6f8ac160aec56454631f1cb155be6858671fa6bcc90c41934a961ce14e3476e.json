[{"id":"seytek-2012:p0143:b003:l029","ordinal":303873,"en":"The price of kefir is divided,"},{"id":"seytek-2012:p0143:b003:l030","ordinal":303874,"en":"Every thought is a thousand problems"},{"id":"seytek-2012:p0143:b003:l031","ordinal":303875,"en":"Seen at the top"},{"id":"seytek-2012:p0143:b003:l032","ordinal":303876,"en":"Looking up the hill,"},{"id":"seytek-2012:p0143:b003:l033","ordinal":303877,"en":"If the population wants to live"},{"id":"seytek-2012:p0143:b003:l034","ordinal":303878,"en":"Smoke from the sky,"},{"id":"seytek-2012:p0143:b003:l035","ordinal":303879,"en":"Seen in a new place"},{"id":"seytek-2012:p0143:b003:l036","ordinal":303880,"en":"He went to go,"},{"id":"seytek-2012:p0143:b003:l037","ordinal":303881,"en":"Black giant lost his mind"},{"id":"seytek-2012:p0143:b003:l038","ordinal":303882,"en":"To report to the army,"},{"id":"seytek-2012:p0143:b003:l039","ordinal":303883,"en":"Poor Külchoro who loves fire"},{"id":"seytek-2012:p0143:b003:l040","ordinal":303884,"en":"To make a partner,"},{"id":"seytek-2012:p0144:b002:l001","ordinal":303885,"en":"The birch without a tongue cried,"},{"id":"seytek-2012:p0144:b002:l002","ordinal":303886,"en":"The soul that stares weeps,"},{"id":"seytek-2012:p0144:b002:l003","ordinal":303887,"en":"Weeping from the well-known"},{"id":"seytek-2012:p0144:b002:l004","ordinal":303888,"en":"Seitek, an orphan"},{"id":"seytek-2012:p0144:b002:l005","ordinal":303889,"en":"The lion crying in front"},{"id":"seytek-2012:p0144:b002:l006","ordinal":303890,"en":"Külchoro as a dream"},{"id":"seytek-2012:p0144:b002:l007","ordinal":303891,"en":"And the poor man cried,"},{"id":"seytek-2012:p0144:b002:l008","ordinal":303892,"en":"He began with a speech,"},{"id":"seytek-2012:p0144:b002:l009","ordinal":303893,"en":"Even near cattle"},{"id":"seytek-2012:p0144:b002:l010","ordinal":303894,"en":"Wrestlers passed."},{"id":"seytek-2012:p0144:b002:l011","ordinal":303895,"en":"That's when Külchoro"},{"id":"seytek-2012:p0144:b002:l012","ordinal":303896,"en":"The guest of honor,"},{"id":"seytek-2012:p0144:b002:l013","ordinal":303897,"en":"Gave a fairy tale,"},{"id":"seytek-2012:p0144:b002:l014","ordinal":303898,"en":"Dressed in blood-dead black,"},{"id":"seytek-2012:p0144:b002:l015","ordinal":303899,"en":"He told me what he knew:"},{"id":"seytek-2012:p0144:b002:l016","ordinal":303900,"en":"\"Ayash father Kyzylsart,"},{"id":"seytek-2012:p0144:b002:l017","ordinal":303901,"en":"He got tired and left."},{"id":"seytek-2012:p0144:b002:l018","ordinal":303902,"en":"Abakem Sultan rode,"},{"id":"seytek-2012:p0144:b002:l019","ordinal":303903,"en":"There was a lot of noise,"},{"id":"seytek-2012:p0144:b002:l020","ordinal":303904,"en":"It was terrible, my dear."},{"id":"seytek-2012:p0144:b002:l021","ordinal":303905,"en":"Lose the bound waist,"},{"id":"seytek-2012:p0144:b002:l022","ordinal":303906,"en":"The air that gave me was gone,"},{"id":"seytek-2012:p0144:b002:l023","ordinal":303907,"en":"I landed along the river,"},{"id":"seytek-2012:p0144:b002:l024","ordinal":303908,"en":"I was too shy,"},{"id":"seytek-2012:p0144:b002:l025","ordinal":303909,"en":"I can't see, I'm sad"},{"id":"seytek-2012:p0144:b002:l026","ordinal":303910,"en":"Blood loss,"},{"id":"seytek-2012:p0144:b002:l027","ordinal":303911,"en":"Our poor food,"},{"id":"seytek-2012:p0144:b002:l028","ordinal":303912,"en":"Our lost head."},{"id":"seytek-2012:p0144:b002:l029","ordinal":303913,"en":"This is the fuel that raises"},{"id":"seytek-2012:p0144:b002:l030","ordinal":303914,"en":"A typical water day,"},{"id":"seytek-2012:p0144:b002:l031","ordinal":303915,"en":"Our blood that is guarded,"},{"id":"seytek-2012:p0144:b002:l032","ordinal":303916,"en":"A spoonful of our blood,"},{"id":"seytek-2012:p0144:b002:l033","ordinal":303917,"en":"We will be born and die"},{"id":"seytek-2012:p0144:b002:l034","ordinal":303918,"en":"Our mother is in mourning."},{"id":"seytek-2012:p0144:b002:l035","ordinal":303919,"en":"Our deserted Talas land,"},{"id":"seytek-2012:p0144:b002:l036","ordinal":303920,"en":"Our back was broken a long time ago."},{"id":"seytek-2012:p0144:b002:l037","ordinal":303921,"en":"Lost in the lake,"},{"id":"seytek-2012:p0144:b002:l038","ordinal":303922,"en":"We are clay,"},{"id":"seytek-2012:p0144:b002:l039","ordinal":303923,"en":"Ulukman lost the lion,"},{"id":"seytek-2012:p0144:b002:l040","ordinal":303924,"en":"We are crazy,"},{"id":"seytek-2012:p0144:b003:l001","ordinal":303925,"en":"Choro without a beak"},{"id":"seytek-2012:p0144:b003:l002","ordinal":303926,"en":"The pain does not go away,"},{"id":"seytek-2012:p0144:b003:l003","ordinal":303927,"en":"Eyes wide open,"},{"id":"seytek-2012:p0144:b003:l004","ordinal":303928,"en":"If you think about it, don't write it down,"},{"id":"seytek-2012:p0144:b003:l005","ordinal":303929,"en":"It was when he was sick."},{"id":"seytek-2012:p0144:b003:l006","ordinal":303930,"en":"When Choro is sick"},{"id":"seytek-2012:p0144:b003:l007","ordinal":303931,"en":"The Black Giant went to the news:"},{"id":"seytek-2012:p0144:b003:l008","ordinal":303932,"en":"\"Greetings from Salao"},{"id":"seytek-2012:p0144:b003:l009","ordinal":303933,"en":"I'm crazy"},{"id":"seytek-2012:p0144:b003:l010","ordinal":303934,"en":"Humanity is a slave"},{"id":"seytek-2012:p0144:b003:l011","ordinal":303935,"en":"My husband, who cannot be found,"},{"id":"seytek-2012:p0144:b003:l012","ordinal":303936,"en":"To cure the disease"},{"id":"seytek-2012:p0144:b003:l013","ordinal":303937,"en":"I brought a reason - said,"},{"id":"seytek-2012:p0144:b003:l014","ordinal":303938,"en":"Blood father's confidant,"},{"id":"seytek-2012:p0144:b003:l015","ordinal":303939,"en":"Your uncle's friend"},{"id":"seytek-2012:p0144:b003:l016","ordinal":303940,"en":"Standing at the base of the flag,"},{"id":"seytek-2012:p0144:b003:l017","ordinal":303941,"en":"Healer of disease,"},{"id":"seytek-2012:p0144:b003:l018","ordinal":303942,"en":"Ayash, your father is Kyzylsart"},{"id":"seytek-2012:p0144:b003:l019","ordinal":303943,"en":"I brought it now,"},{"id":"seytek-2012:p0144:b003:l020","ordinal":303944,"en":"The blue of your wish,"},{"id":"seytek-2012:p0144:b003:l021","ordinal":303945,"en":"I gave it to you,"},{"id":"seytek-2012:p0144:b003:l022","ordinal":303946,"en":"The black giant was coming,"},{"id":"seytek-2012:p0144:b003:l023","ordinal":303947,"en":"Sixty wrestlers, Kyzylsart,"},{"id":"seytek-2012:p0144:b003:l024","ordinal":303948,"en":"Unable to dismount"},{"id":"seytek-2012:p0144:b003:l025","ordinal":303949,"en":"Fight like a lion"},{"id":"seytek-2012:p0144:b003:l026","ordinal":303950,"en":"Some six thousand red camels,"},{"id":"seytek-2012:p0144:b003:l027","ordinal":303951,"en":"He multiplies the red camels."},{"id":"seytek-2012:p0144:b003:l028","ordinal":303952,"en":"It has red gold undertones,"},{"id":"seytek-2012:p0144:b003:l029","ordinal":303953,"en":"Doomsday has gone blue"},{"id":"seytek-2012:p0144:b003:l030","ordinal":303954,"en":"There is a decreasing rate."},{"id":"seytek-2012:p0144:b003:l031","ordinal":303955,"en":"There are about sixty souls,"},{"id":"seytek-2012:p0144:b003:l032","ordinal":303956,"en":"All from a wrestler."},{"id":"seytek-2012:p0144:b003:l033","ordinal":303957,"en":"Unable to dismount"},{"id":"seytek-2012:p0144:b003:l034","ordinal":303958,"en":"It's a dark place"},{"id":"seytek-2012:p0144:b003:l035","ordinal":303959,"en":"All of them got into the dirt."},{"id":"seytek-2012:p0144:b003:l036","ordinal":303960,"en":"When you see Külchoro"},{"id":"seytek-2012:p0144:b003:l037","ordinal":303961,"en":"Bending the joint loosely,"},{"id":"seytek-2012:p0144:b003:l038","ordinal":303962,"en":"Kyzylsart is made of steam."},{"id":"seytek-2012:p0144:b003:l039","ordinal":303963,"en":"Screaming and running."},{"id":"seytek-2012:p0144:b003:l040","ordinal":303964,"en":"Kyzylsart was crying"},{"id":"seytek-2012:p0145:b002:l001","ordinal":303965,"en":"He alone was the healer,"},{"id":"seytek-2012:p0145:b002:l002","ordinal":303966,"en":"He had keen black eyes,"},{"id":"seytek-2012:p0145:b002:l003","ordinal":303967,"en":"In Kyzylsart’s own keeping"},{"id":"seytek-2012:p0145:b002:l004","ordinal":303968,"en":"There was a compound red medicine,"},{"id":"seytek-2012:p0145:b002:l005","ordinal":303969,"en":"He had every kind of remedy."},{"id":"seytek-2012:p0145:b002:l006","ordinal":303970,"en":"He had searched great Baghdad,"},{"id":"seytek-2012:p0145:b002:l007","ordinal":303971,"en":"And from a deserted place obtained"},{"id":"seytek-2012:p0145:b002:l008","ordinal":303972,"en":"A medicine called matchless."},{"id":"seytek-2012:p0145:b002:l009","ordinal":303973,"en":"He had searched great Egypt,"},{"id":"seytek-2012:p0145:b002:l010","ordinal":303974,"en":"And the potent medicine"},{"id":"seytek-2012:p0145:b002:l011","ordinal":303975,"en":"He had obtained from there."},{"id":"seytek-2012:p0145:b002:l012","ordinal":303976,"en":"With one dose of his medicine,"},{"id":"seytek-2012:p0145:b002:l013","ordinal":303977,"en":"The pain subsided."},{"id":"seytek-2012:p0145:b002:l014","ordinal":303978,"en":"With one dose of the remedy,"},{"id":"seytek-2012:p0145:b002:l015","ordinal":303979,"en":"The eyes opened wide."},{"id":"seytek-2012:p0145:b002:l016","ordinal":303980,"en":"Of those potent medicines,"},{"id":"seytek-2012:p0145:b002:l017","ordinal":303981,"en":"Of all his remedies,"},{"id":"seytek-2012:p0145:b002:l018","ordinal":303982,"en":"Even one that could stave off death,"},{"id":"seytek-2012:p0145:b002:l019","ordinal":303983,"en":"From the black heart of medicine,"},{"id":"seytek-2012:p0145:b002:l020","ordinal":303984,"en":"Kyzylsart spared no effort"},{"id":"seytek-2012:p0145:b002:l021","ordinal":303985,"en":"And carefully applied the cure,"},{"id":"seytek-2012:p0145:b002:l022","ordinal":303986,"en":"But here the medicine did no good,"},{"id":"seytek-2012:p0145:b002:l023","ordinal":303987,"en":"And Choro did not recover."},{"id":"seytek-2012:p0145:b002:l024","ordinal":303988,"en":"Grieving in all sincerity,"},{"id":"seytek-2012:p0145:b002:l025","ordinal":303989,"en":"Despairing of his fly-like life,"},{"id":"seytek-2012:p0145:b002:l026","ordinal":303990,"en":"Choro burned with humiliation,"},{"id":"seytek-2012:p0145:b002:l027","ordinal":303991,"en":"And despaired of his entrusted life."},{"id":"seytek-2012:p0145:b002:l028","ordinal":303992,"en":"As Choro stood there thus,"},{"id":"seytek-2012:p0145:b002:l029","ordinal":303993,"en":"Your foster-father Kyzylsart"},{"id":"seytek-2012:p0145:b002:l030","ordinal":303994,"en":"Was himself the healer,"},{"id":"seytek-2012:p0145:b002:l031","ordinal":303995,"en":"A keen and careful eye,"},{"id":"seytek-2012:p0145:b002:l032","ordinal":303996,"en":"Weighing thoughts and shaping words,"},{"id":"seytek-2012:p0145:b002:l033","ordinal":303997,"en":"He also had discernment,"},{"id":"seytek-2012:p0145:b002:l034","ordinal":303998,"en":"A remedy for every illness,"},{"id":"seytek-2012:p0145:b002:l035","ordinal":303999,"en":"And he also had resourcefulness."},{"id":"seytek-2012:p0145:b002:l036","ordinal":304000,"en":"When the sun sank shimmering,"},{"id":"seytek-2012:p0145:b002:l037","ordinal":304001,"en":"When the foremost of the people lay down,"},{"id":"seytek-2012:p0145:b002:l038","ordinal":304002,"en":"A blue mastiff with a leather-capped head,"},{"id":"seytek-2012:p0145:b002:l039","ordinal":304003,"en":"A dog left behind by the gray wolf,"},{"id":"seytek-2012:p0145:b002:l040","ordinal":304004,"en":"Howled and whimpered in grief."},{"id":"seytek-2012:p0145:b003:l001","ordinal":304005,"en":"Parted from the magnanimous lion,"},{"id":"seytek-2012:p0145:b003:l002","ordinal":304006,"en":"We stand here powerless."},{"id":"seytek-2012:p0145:b003:l003","ordinal":304007,"en":"While my lion-hearted uncle lived,"},{"id":"seytek-2012:p0145:b003:l004","ordinal":304008,"en":"We grew to manhood as lions."},{"id":"seytek-2012:p0145:b003:l005","ordinal":304009,"en":"After my uncle Semetey passed away,"},{"id":"seytek-2012:p0145:b003:l006","ordinal":304010,"en":"We who were white steel became notched,"},{"id":"seytek-2012:p0145:b003:l007","ordinal":304011,"en":"We who were heroes fell into sorrow,"},{"id":"seytek-2012:p0145:b003:l008","ordinal":304012,"en":"We were parted from the renowned lion."},{"id":"seytek-2012:p0145:b003:l009","ordinal":304013,"en":"Foster-father Kyzylsart,"},{"id":"seytek-2012:p0145:b003:l010","ordinal":304014,"en":"Our backs made sore, to Kyyaz"},{"id":"seytek-2012:p0145:b003:l011","ordinal":304015,"en":"We came as docile pacers."},{"id":"seytek-2012:p0145:b003:l012","ordinal":304016,"en":"Parted from our good fortune,"},{"id":"seytek-2012:p0145:b003:l013","ordinal":304017,"en":"In Jeti-Özön, among the Jediger,"},{"id":"seytek-2012:p0145:b003:l014","ordinal":304018,"en":"To Kyyaz, son of Bagysh,"},{"id":"seytek-2012:p0145:b003:l015","ordinal":304019,"en":"We came as spoils of war."},{"id":"seytek-2012:p0145:b003:l016","ordinal":304020,"en":"Our herds were plundered,"},{"id":"seytek-2012:p0145:b003:l017","ordinal":304021,"en":"Our blood was utterly drained,"},{"id":"seytek-2012:p0145:b003:l018","ordinal":304022,"en":"Separated from the six divisions,"},{"id":"seytek-2012:p0145:b003:l019","ordinal":304023,"en":"Our strength departed long ago."},{"id":"seytek-2012:p0145:b003:l020","ordinal":304024,"en":"I bear a deep-dug wound,"},{"id":"seytek-2012:p0145:b003:l021","ordinal":304025,"en":"I bear a vast, seething misery."},{"id":"seytek-2012:p0145:b003:l022","ordinal":304026,"en":"Longing to die, I cannot die,"},{"id":"seytek-2012:p0145:b003:l023","ordinal":304027,"en":"Yet cannot take my own life."},{"id":"seytek-2012:p0145:b003:l024","ordinal":304028,"en":"Our herds were given over to plunder,"},{"id":"seytek-2012:p0145:b003:l025","ordinal":304029,"en":"Barely a spoonful of blood remains."},{"id":"seytek-2012:p0145:b003:l026","ordinal":304030,"en":"I am fading away."},{"id":"seytek-2012:p0145:b003:l027","ordinal":304031,"en":"Foster-father Kyzylsart,"},{"id":"seytek-2012:p0145:b003:l028","ordinal":304032,"en":"Please take us as your companions."},{"id":"seytek-2012:p0145:b003:l029","ordinal":304033,"en":"The stars in heaven have turned pale,"},{"id":"seytek-2012:p0145:b003:l030","ordinal":304034,"en":"My father was your old friend."},{"id":"seytek-2012:p0145:b003:l031","ordinal":304035,"en":"I am frozen by the cold—give me your coat;"},{"id":"seytek-2012:p0145:b003:l032","ordinal":304036,"en":"I beg you with both hands outstretched."},{"id":"seytek-2012:p0145:b003:l033","ordinal":304037,"en":"My strength is gone—give me your medicine,"},{"id":"seytek-2012:p0145:b003:l034","ordinal":304038,"en":"O noble, khanly father,"},{"id":"seytek-2012:p0145:b003:l035","ordinal":304039,"en":"Give me all your remedies."},{"id":"seytek-2012:p0145:b003:l036","ordinal":304040,"en":"I beg you, father, grant me your best;"},{"id":"seytek-2012:p0145:b003:l037","ordinal":304041,"en":"Give me your hand and do not abandon me.”"},{"id":"seytek-2012:p0145:b003:l038","ordinal":304042,"en":"Thus did Külchoro"},{"id":"seytek-2012:p0145:b003:l039","ordinal":304043,"en":"Speak in his wretchedness, and then"},{"id":"seytek-2012:p0145:b003:l040","ordinal":304044,"en":"His foster-father Kyzylsart—"},{"id":"seytek-2012:p0146:b002:l001","ordinal":304045,"en":"Finding no head he could tear off,"},{"id":"seytek-2012:p0146:b002:l002","ordinal":304046,"en":"His courage like a sheer mountain ridge,"},{"id":"seytek-2012:p0146:b002:l003","ordinal":304047,"en":"The formidable Külchoro"},{"id":"seytek-2012:p0146:b002:l004","ordinal":304048,"en":"Seemed able to devour any man he grappled."},{"id":"seytek-2012:p0146:b002:l005","ordinal":304049,"en":"At Choro’s terrible bearing,"},{"id":"seytek-2012:p0146:b002:l006","ordinal":304050,"en":"All the Jediger might flee."},{"id":"seytek-2012:p0146:b002:l007","ordinal":304051,"en":"If seven hosts of alien foes came,"},{"id":"seytek-2012:p0146:b002:l008","ordinal":304052,"en":"He alone could crush them."},{"id":"seytek-2012:p0146:b002:l009","ordinal":304053,"en":"The hot breath from his mouth"},{"id":"seytek-2012:p0146:b002:l010","ordinal":304054,"en":"Seemed able to set the valley aflame."},{"id":"seytek-2012:p0146:b002:l011","ordinal":304055,"en":"If he merely stirred,"},{"id":"seytek-2012:p0146:b002:l012","ordinal":304056,"en":"He seemed able to ravage the world."},{"id":"seytek-2012:p0146:b002:l013","ordinal":304057,"en":"Broad-hearted as a valley,"},{"id":"seytek-2012:p0146:b002:l014","ordinal":304058,"en":"His handsome front teeth"},{"id":"seytek-2012:p0146:b002:l015","ordinal":304059,"en":"Were like tempered steel."},{"id":"seytek-2012:p0146:b002:l016","ordinal":304060,"en":"When you looked at his aquiline nose,"},{"id":"seytek-2012:p0146:b002:l017","ordinal":304061,"en":"It was like the sheath of a saber."},{"id":"seytek-2012:p0146:b002:l018","ordinal":304062,"en":"His upturned mustache"},{"id":"seytek-2012:p0146:b002:l019","ordinal":304063,"en":"Was like a Bukharan blade."},{"id":"seytek-2012:p0146:b002:l020","ordinal":304064,"en":"The heat of his two eyes"},{"id":"seytek-2012:p0146:b002:l021","ordinal":304065,"en":"Was like flame rising through a valley."},{"id":"seytek-2012:p0146:b002:l022","ordinal":304066,"en":"When you looked into their corners,"},{"id":"seytek-2012:p0146:b002:l023","ordinal":304067,"en":"They were like the hollows of dried-up wells."},{"id":"seytek-2012:p0146:b002:l024","ordinal":304068,"en":"When that formidable man moved,"},{"id":"seytek-2012:p0146:b002:l025","ordinal":304069,"en":"He seemed able to swallow the world."},{"id":"seytek-2012:p0146:b002:l026","ordinal":304070,"en":"Recovering from his broken state,"},{"id":"seytek-2012:p0146:b002:l027","ordinal":304071,"en":"Choro became a bloodthirsty warrior again."},{"id":"seytek-2012:p0146:b002:l028","ordinal":304072,"en":"His former vigor"},{"id":"seytek-2012:p0146:b002:l029","ordinal":304073,"en":"Filled him like a bloated blue tick,"},{"id":"seytek-2012:p0146:b002:l030","ordinal":304074,"en":"And his wolfish valor and heroism"},{"id":"seytek-2012:p0146:b002:l031","ordinal":304075,"en":"Were as they had been before."},{"id":"seytek-2012:p0146:b002:l032","ordinal":304076,"en":"The awe-inspiring poor falcon’s"},{"id":"seytek-2012:p0146:b002:l033","ordinal":304077,"en":"Hollows filled with milk,"},{"id":"seytek-2012:p0146:b002:l034","ordinal":304078,"en":"His gaunt frame filled with flesh,"},{"id":"seytek-2012:p0146:b002:l035","ordinal":304079,"en":"And the time came for him to fight."},{"id":"seytek-2012:p0146:b002:l036","ordinal":304080,"en":"With Kyyaz, son of Bagysh,"},{"id":"seytek-2012:p0146:b002:l037","ordinal":304081,"en":"The time came for him to meet face-to-face."},{"id":"seytek-2012:p0146:b002:l038","ordinal":304082,"en":"His figure was like half a mountain,"},{"id":"seytek-2012:p0146:b002:l039","ordinal":304083,"en":"Ready to devour any soul he met."},{"id":"seytek-2012:p0146:b002:l040","ordinal":304084,"en":"Külchoro, upheld by the divine,"},{"id":"seytek-2012:p0146:b003:l001","ordinal":304085,"en":"Used Choro as his pretext,"},{"id":"seytek-2012:p0146:b003:l002","ordinal":304086,"en":"And the poor fellow followed him about."},{"id":"seytek-2012:p0146:b003:l003","ordinal":304087,"en":"The blue mastiff left by the hero—"},{"id":"seytek-2012:p0146:b003:l004","ordinal":304088,"en":"Kyzylsart suddenly seized it"},{"id":"seytek-2012:p0146:b003:l005","ordinal":304089,"en":"And slaughtered the blue mastiff."},{"id":"seytek-2012:p0146:b003:l006","ordinal":304090,"en":"Cutting out its diaphragm,"},{"id":"seytek-2012:p0146:b003:l007","ordinal":304091,"en":"He laid it upon Külchoro."},{"id":"seytek-2012:p0146:b003:l008","ordinal":304092,"en":"Kyzylsart was meticulous,"},{"id":"seytek-2012:p0146:b003:l009","ordinal":304093,"en":"Skillful in devising strange measures."},{"id":"seytek-2012:p0146:b003:l010","ordinal":304094,"en":"Upon Külchoro’s back"},{"id":"seytek-2012:p0146:b003:l011","ordinal":304095,"en":"He fitted the dog’s diaphragm,"},{"id":"seytek-2012:p0146:b003:l012","ordinal":304096,"en":"And the powdered red medicine"},{"id":"seytek-2012:p0146:b003:l013","ordinal":304097,"en":"He rubbed on forty times."},{"id":"seytek-2012:p0146:b003:l014","ordinal":304098,"en":"The boiled black medicine"},{"id":"seytek-2012:p0146:b003:l015","ordinal":304099,"en":"He rubbed on time after time."},{"id":"seytek-2012:p0146:b003:l016","ordinal":304100,"en":"Then the poor father Choro’s"},{"id":"seytek-2012:p0146:b003:l017","ordinal":304101,"en":"Painful places subsided,"},{"id":"seytek-2012:p0146:b003:l018","ordinal":304102,"en":"His eyes opened wide,"},{"id":"seytek-2012:p0146:b003:l019","ordinal":304103,"en":"Blood coursed through his body,"},{"id":"seytek-2012:p0146:b003:l020","ordinal":304104,"en":"And the day came when his courage swelled."},{"id":"seytek-2012:p0146:b003:l021","ordinal":304105,"en":"The moon waned and the nights passed,"},{"id":"seytek-2012:p0146:b003:l022","ordinal":304106,"en":"And many days went by."},{"id":"seytek-2012:p0146:b003:l023","ordinal":304107,"en":"Vigor seethed and strength filled him,"},{"id":"seytek-2012:p0146:b003:l024","ordinal":304108,"en":"Power welled up within him."},{"id":"seytek-2012:p0146:b003:l025","ordinal":304109,"en":"The days passed as though he lay in comfort,"},{"id":"seytek-2012:p0146:b003:l026","ordinal":304110,"en":"And all he saw was like the Night of Glory."},{"id":"seytek-2012:p0146:b003:l027","ordinal":304111,"en":"His loosened joints were restored,"},{"id":"seytek-2012:p0146:b003:l028","ordinal":304112,"en":"And all his sorrow disappeared."},{"id":"seytek-2012:p0146:b003:l029","ordinal":304113,"en":"His thoughts became a night of blessed destiny,"},{"id":"seytek-2012:p0146:b003:l030","ordinal":304114,"en":"And the spirited youth and swift horse"},{"id":"seytek-2012:p0146:b003:l031","ordinal":304115,"en":"Came to the day their worth was fulfilled."},{"id":"seytek-2012:p0146:b003:l032","ordinal":304116,"en":"It was then that Külchoro"},{"id":"seytek-2012:p0146:b003:l033","ordinal":304117,"en":"Returned to himself and recovered."},{"id":"seytek-2012:p0146:b003:l034","ordinal":304118,"en":"Kyzylsart had been his healer,"},{"id":"seytek-2012:p0146:b003:l035","ordinal":304119,"en":"And all his affliction disappeared."},{"id":"seytek-2012:p0146:b003:l036","ordinal":304120,"en":"His courage rose and strength filled him."},{"id":"seytek-2012:p0146:b003:l037","ordinal":304121,"en":"Think of Choro now:"},{"id":"seytek-2012:p0146:b003:l038","ordinal":304122,"en":"He could find no mountain to strike,"},{"id":"seytek-2012:p0146:b003:l039","ordinal":304123,"en":"No enemy to fight,"},{"id":"seytek-2012:p0146:b003:l040","ordinal":304124,"en":"No stone to chew."},{"id":"seytek-2012:p0147:b002:l001","ordinal":304125,"en":"You girded your appointed belt,"},{"id":"seytek-2012:p0147:b002:l002","ordinal":304126,"en":"And raised turmoil against all who faced you."},{"id":"seytek-2012:p0147:b002:l003","ordinal":304127,"en":"You besieged the Khagan and took his lands,"},{"id":"seytek-2012:p0147:b002:l004","ordinal":304128,"en":"And conquered the populous Chinese realm"}]
