[{"id":"semetey-1-2013:p1260:b003:l038","ordinal":173313,"en":"And came before him,"},{"id":"semetey-1-2013:p1260:b003:l039","ordinal":173314,"en":"The young orphan Semetey"},{"id":"semetey-1-2013:p1260:b004:l001","ordinal":173315,"en":"Now spoke these words;"},{"id":"semetey-1-2013:p1260:b004:l002","ordinal":173316,"en":"To the companions beside him"},{"id":"semetey-1-2013:p1260:b004:l003","ordinal":173317,"en":"He said the following:"},{"id":"semetey-1-2013:p1260:b004:l004","ordinal":173318,"en":"“With Khojo, who attacked us himself,"},{"id":"semetey-1-2013:p1260:b004:l005","ordinal":173319,"en":"Let us measure ourselves."},{"id":"semetey-1-2013:p1260:b004:l006","ordinal":173320,"en":"With Khojo, craving battle,"},{"id":"semetey-1-2013:p1260:b004:l007","ordinal":173321,"en":"With that raging swine!"},{"id":"semetey-1-2013:p1260:b004:l008","ordinal":173322,"en":"Did we steal away his piebald mare?"},{"id":"semetey-1-2013:p1260:b004:l009","ordinal":173323,"en":"We were kin from the root;"},{"id":"semetey-1-2013:p1260:b004:l010","ordinal":173324,"en":"Did we scatter his white silver and sable?"},{"id":"semetey-1-2013:p1260:b004:l011","ordinal":173325,"en":"Did we chase off his dun mare?"},{"id":"semetey-1-2013:p1260:b004:l012","ordinal":173326,"en":"That Khojo has gone mad—"},{"id":"semetey-1-2013:p1260:b004:l013","ordinal":173327,"en":"Did we scatter sable from his saddlebags?"},{"id":"semetey-1-2013:p1260:b004:l014","ordinal":173328,"en":"Did we camp upon his village?"},{"id":"semetey-1-2013:p1260:b004:l015","ordinal":173329,"en":"Did we commit some offense?!"},{"id":"semetey-1-2013:p1260:b004:l016","ordinal":173330,"en":"Did we seize and slaughter his barren mare?"},{"id":"semetey-1-2013:p1260:b004:l017","ordinal":173331,"en":"Did we reconnoiter his strong city?"},{"id":"semetey-1-2013:p1260:b004:l018","ordinal":173332,"en":"Have we become guilty?"},{"id":"semetey-1-2013:p1260:b004:l019","ordinal":173333,"en":"That Khojo, rising in force—"},{"id":"semetey-1-2013:p1260:b004:l020","ordinal":173334,"en":"Did we reap his rice like hay?"},{"id":"semetey-1-2013:p1260:b004:l021","ordinal":173335,"en":"Against thundering Toltoi,"},{"id":"semetey-1-2013:p1260:b004:l022","ordinal":173336,"en":"Have we made ourselves guilty?"},{"id":"semetey-1-2013:p1260:b004:l023","ordinal":173337,"en":"That he musters his army in fury,"},{"id":"semetey-1-2013:p1260:b004:l024","ordinal":173338,"en":"That his spears quiver in readiness—"},{"id":"semetey-1-2013:p1260:b004:l025","ordinal":173339,"en":"Were we rivals for that swine’s wife?"},{"id":"semetey-1-2013:p1260:b004:l026","ordinal":173340,"en":"Did we earlier attack"},{"id":"semetey-1-2013:p1260:b004:l027","ordinal":173341,"en":"And raid his village?!"},{"id":"semetey-1-2013:p1260:b004:l028","ordinal":173342,"en":"He has longed for slaughter—"},{"id":"semetey-1-2013:p1260:b004:l029","ordinal":173343,"en":"Have we fallen into his torment?!"},{"id":"semetey-1-2013:p1260:b004:l030","ordinal":173344,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1260:b004:l031","ordinal":173345,"en":"Was a servant of our common root;"},{"id":"semetey-1-2013:p1260:b004:l032","ordinal":173346,"en":"Let us fight to the finish,"},{"id":"semetey-1-2013:p1260:b004:l033","ordinal":173347,"en":"For we were sons of one father."},{"id":"semetey-1-2013:p1260:b004:l034","ordinal":173348,"en":"Mustering his host with a roar,"},{"id":"semetey-1-2013:p1260:b004:l035","ordinal":173349,"en":"As though we had plundered his gold,"},{"id":"semetey-1-2013:p1260:b004:l036","ordinal":173350,"en":"As though we had raided his village—"},{"id":"semetey-1-2013:p1260:b004:l037","ordinal":173351,"en":"While my strong head remains,"},{"id":"semetey-1-2013:p1260:b004:l038","ordinal":173352,"en":"How can I give up my wife?"},{"id":"semetey-1-2013:p1260:b004:l039","ordinal":173353,"en":"The swine have risen in force;"},{"id":"semetey-1-2013:p1261:b003:l001","ordinal":173354,"en":"Let me grapple and test them!"},{"id":"semetey-1-2013:p1261:b003:l002","ordinal":173355,"en":"While my ocean-like head remains,"},{"id":"semetey-1-2013:p1261:b003:l003","ordinal":173356,"en":"How can I give up my equal companion?"},{"id":"semetey-1-2013:p1261:b003:l004","ordinal":173357,"en":"The swine are surging;"},{"id":"semetey-1-2013:p1261:b003:l005","ordinal":173358,"en":"Let me fight them alone and test myself!”"},{"id":"semetey-1-2013:p1261:b003:l006","ordinal":173359,"en":"Your prince grieved in this way,"},{"id":"semetey-1-2013:p1261:b003:l007","ordinal":173360,"en":"Put on the bulletproof armor,"},{"id":"semetey-1-2013:p1261:b003:l008","ordinal":173361,"en":"Readied himself toward the foe,"},{"id":"semetey-1-2013:p1261:b003:l009","ordinal":173362,"en":"And prepared his weapons."},{"id":"semetey-1-2013:p1261:b003:l010","ordinal":173363,"en":"The blood-drinking gray wolf’s"},{"id":"semetey-1-2013:p1261:b003:l011","ordinal":173364,"en":"Wrath spread across his face."},{"id":"semetey-1-2013:p1261:b003:l012","ordinal":173365,"en":"The gray kise he had inherited"},{"id":"semetey-1-2013:p1261:b003:l013","ordinal":173366,"en":"From his khan father, the bloodletter,"},{"id":"semetey-1-2013:p1261:b003:l014","ordinal":173367,"en":"The bloodthirsty champion buckled on—"},{"id":"semetey-1-2013:p1261:b003:l015","ordinal":173368,"en":"He who unleashed havoc,"},{"id":"semetey-1-2013:p1261:b003:l016","ordinal":173369,"en":"Who carried off women."},{"id":"semetey-1-2013:p1261:b003:l017","ordinal":173370,"en":"At doom-struck Khojo"},{"id":"semetey-1-2013:p1261:b003:l018","ordinal":173371,"en":"He glowered in wrath."},{"id":"semetey-1-2013:p1261:b003:l019","ordinal":173372,"en":"Making ready with the gray kise,"},{"id":"semetey-1-2013:p1261:b003:l020","ordinal":173373,"en":"Pleading with the Creator,"},{"id":"semetey-1-2013:p1261:b003:l021","ordinal":173374,"en":"When the wondrous thing was slung on,"},{"id":"semetey-1-2013:p1261:b003:l022","ordinal":173375,"en":"It was a mirror upon the shoulder;"},{"id":"semetey-1-2013:p1261:b003:l023","ordinal":173376,"en":"When borne into clashing battle,"},{"id":"semetey-1-2013:p1261:b003:l024","ordinal":173377,"en":"It was comfort for the entrusted life."},{"id":"semetey-1-2013:p1261:b003:l025","ordinal":173378,"en":"Its report had been measured and judged;"},{"id":"semetey-1-2013:p1261:b003:l026","ordinal":173379,"en":"Nothing measured could match its form."},{"id":"semetey-1-2013:p1261:b003:l027","ordinal":173380,"en":"In sport it was Ochogor,"},{"id":"semetey-1-2013:p1261:b003:l028","ordinal":173381,"en":"In earnest it was Koichagyr—"},{"id":"semetey-1-2013:p1261:b003:l029","ordinal":173382,"en":"This was the sharp weapon inherited"},{"id":"semetey-1-2013:p1261:b003:l030","ordinal":173383,"en":"From noble Lord Manas."},{"id":"semetey-1-2013:p1261:b003:l031","ordinal":173384,"en":"Its keenness was proven among the people,"},{"id":"semetey-1-2013:p1261:b003:l032","ordinal":173385,"en":"An inheritance remaining"},{"id":"semetey-1-2013:p1261:b003:l033","ordinal":173386,"en":"From the poor prince and sultan."},{"id":"semetey-1-2013:p1261:b003:l034","ordinal":173387,"en":"Golden collar and copper sleeves,"},{"id":"semetey-1-2013:p1261:b003:l035","ordinal":173388,"en":"Double ring mail with lark-like eyes,"},{"id":"semetey-1-2013:p1261:b003:l036","ordinal":173389,"en":"Netted outer coat and blue jacket—"},{"id":"semetey-1-2013:p1261:b003:l037","ordinal":173390,"en":"No bullet pierced it in battle."},{"id":"semetey-1-2013:p1261:b003:l038","ordinal":173391,"en":"Gray-wolf Sultan Semetey"},{"id":"semetey-1-2013:p1261:b003:l039","ordinal":173392,"en":"Now put it on over the rest."},{"id":"semetey-1-2013:p1261:b004:l001","ordinal":173393,"en":"The sight stirred the heart;"},{"id":"semetey-1-2013:p1261:b004:l002","ordinal":173394,"en":"When he put on his weapons,"},{"id":"semetey-1-2013:p1261:b004:l003","ordinal":173395,"en":"Semetey, wolf of battle,"},{"id":"semetey-1-2013:p1261:b004:l004","ordinal":173396,"en":"Loomed as large as a house."},{"id":"semetey-1-2013:p1261:b004:l005","ordinal":173397,"en":"He raised the gold-crescent banner,"},{"id":"semetey-1-2013:p1261:b004:l006","ordinal":173398,"en":"Raised the cry “Ai, Manas!”"},{"id":"semetey-1-2013:p1261:b004:l007","ordinal":173399,"en":"And your prince surged from the palace,"},{"id":"semetey-1-2013:p1261:b004:l008","ordinal":173400,"en":"Wearing the bulletproof armor,"},{"id":"semetey-1-2013:p1261:b004:l009","ordinal":173401,"en":"Gathering himself like a lion."},{"id":"semetey-1-2013:p1261:b004:l010","ordinal":173402,"en":"Like a cloud about to rain again,"},{"id":"semetey-1-2013:p1261:b004:l011","ordinal":173403,"en":"Wrath covered his face;"},{"id":"semetey-1-2013:p1261:b004:l012","ordinal":173404,"en":"His breadth was an armful,"},{"id":"semetey-1-2013:p1261:b004:l013","ordinal":173405,"en":"His arms and armor fastened on."},{"id":"semetey-1-2013:p1261:b004:l014","ordinal":173406,"en":"The sight stirred every heart;"},{"id":"semetey-1-2013:p1261:b004:l015","ordinal":173407,"en":"Venom poured from his mouth."},{"id":"semetey-1-2013:p1261:b004:l016","ordinal":173408,"en":"He readied himself like a hawk,"},{"id":"semetey-1-2013:p1261:b004:l017","ordinal":173409,"en":"And received wisdom from the unseen."},{"id":"semetey-1-2013:p1261:b004:l018","ordinal":173410,"en":"Looking to either side,"},{"id":"semetey-1-2013:p1261:b004:l019","ordinal":173411,"en":"As he prepared to enter battle,"},{"id":"semetey-1-2013:p1261:b004:l020","ordinal":173412,"en":"He licked his lips and nose."},{"id":"semetey-1-2013:p1261:b004:l021","ordinal":173413,"en":"The sight stirred the heart:"},{"id":"semetey-1-2013:p1261:b004:l022","ordinal":173414,"en":"Külchoro, son of the gray wolf,"},{"id":"semetey-1-2013:p1261:b004:l023","ordinal":173415,"en":"Appeared with Aktelki."},{"id":"semetey-1-2013:p1261:b004:l024","ordinal":173416,"en":"Külchoro came out in high spirits,"},{"id":"semetey-1-2013:p1261:b004:l025","ordinal":173417,"en":"Met Semetey,"},{"id":"semetey-1-2013:p1261:b004:l026","ordinal":173418,"en":"And stood as his support."},{"id":"semetey-1-2013:p1261:b004:l027","ordinal":173419,"en":"Beyond him came"},{"id":"semetey-1-2013:p1261:b004:l028","ordinal":173420,"en":"Kanchoro, born to surpass"},{"id":"semetey-1-2013:p1261:b004:l029","ordinal":173421,"en":"His father, lion Chubak,"},{"id":"semetey-1-2013:p1261:b004:l030","ordinal":173422,"en":"Wearing over himself a fur coat"},{"id":"semetey-1-2013:p1261:b004:l031","ordinal":173423,"en":"Of blue otter skin;"},{"id":"semetey-1-2013:p1261:b004:l032","ordinal":173424,"en":"If an army of six thousand came,"},{"id":"semetey-1-2013:p1261:b004:l033","ordinal":173425,"en":"He attacked without sparing himself."},{"id":"semetey-1-2013:p1261:b004:l034","ordinal":173426,"en":"He never turned back from gunfire,"},{"id":"semetey-1-2013:p1261:b004:l035","ordinal":173427,"en":"Never fled in fear of death."},{"id":"semetey-1-2013:p1261:b004:l036","ordinal":173428,"en":"Köktelki of Khan Köbösh,"},{"id":"semetey-1-2013:p1261:b004:l037","ordinal":173429,"en":"His stallion for holy war,"},{"id":"semetey-1-2013:p1261:b004:l038","ordinal":173430,"en":"Came as his support."},{"id":"semetey-1-2013:p1261:b004:l039","ordinal":173431,"en":"Young prince Kanchoro,"},{"id":"semetey-1-2013:p1262:b003:l001","ordinal":173432,"en":"Semetey’s kinsman;"},{"id":"semetey-1-2013:p1262:b003:l002","ordinal":173433,"en":"Baitailak, son of Bakai Khan,"},{"id":"semetey-1-2013:p1262:b003:l003","ordinal":173434,"en":"Also came as support;"},{"id":"semetey-1-2013:p1262:b003:l004","ordinal":173435,"en":"Kalyk, son of Sary Khan,"},{"id":"semetey-1-2013:p1262:b003:l005","ordinal":173436,"en":"Skilled against the foe he fought,"},{"id":"semetey-1-2013:p1262:b003:l006","ordinal":173437,"en":"His bright aid of use,"},{"id":"semetey-1-2013:p1262:b003:l007","ordinal":173438,"en":"Ready for slaughter,"},{"id":"semetey-1-2013:p1262:b003:l008","ordinal":173439,"en":"Became a companion then."},{"id":"semetey-1-2013:p1262:b003:l009","ordinal":173440,"en":"All sons of khans,"},{"id":"semetey-1-2013:p1262:b003:l010","ordinal":173441,"en":"They raised the pale-gray banner,"},{"id":"semetey-1-2013:p1262:b003:l011","ordinal":173442,"en":"Raised the cry “Khan Manas!”"},{"id":"semetey-1-2013:p1262:b003:l012","ordinal":173443,"en":"Braced themselves like lions,"},{"id":"semetey-1-2013:p1262:b003:l013","ordinal":173444,"en":"And all mounted like lions."},{"id":"semetey-1-2013:p1262:b003:l014","ordinal":173445,"en":"Receiving a letter from the caliph,"},{"id":"semetey-1-2013:p1262:b003:l015","ordinal":173446,"en":"Receiving the elders’ blessing,"},{"id":"semetey-1-2013:p1262:b003:l016","ordinal":173447,"en":"The leopard’s sons, who wrought slaughter"},{"id":"semetey-1-2013:p1262:b003:l017","ordinal":173448,"en":"When challenged,"},{"id":"semetey-1-2013:p1262:b003:l018","ordinal":173449,"en":"Now rode into"},{"id":"semetey-1-2013:p1262:b003:l019","ordinal":173450,"en":"The Jediger host."},{"id":"semetey-1-2013:p1262:b003:l020","ordinal":173451,"en":"From the Jediger city,"},{"id":"semetey-1-2013:p1262:b003:l021","ordinal":173452,"en":"Moving swiftly and gathering themselves,"},{"id":"semetey-1-2013:p1262:b003:l022","ordinal":173453,"en":"Turning like lions,"},{"id":"semetey-1-2013:p1262:b003:l023","ordinal":173454,"en":"Onto the spur of the broken mountain,"},{"id":"semetey-1-2013:p1262:b003:l024","ordinal":173455,"en":"Onto the looming promontory,"},{"id":"semetey-1-2013:p1262:b003:l025","ordinal":173456,"en":"Semetey suddenly climbed."},{"id":"semetey-1-2013:p1262:b003:l026","ordinal":173457,"en":"When the young man truly looked,"},{"id":"semetey-1-2013:p1262:b003:l027","ordinal":173458,"en":"Spears swayed like reeds,"},{"id":"semetey-1-2013:p1262:b003:l028","ordinal":173459,"en":"Weapons glittered like stars;"},{"id":"semetey-1-2013:p1262:b003:l029","ordinal":173460,"en":"Dawn broke in clouds,"},{"id":"semetey-1-2013:p1262:b003:l030","ordinal":173461,"en":"And, crying “Khojo!” as their battle call,"},{"id":"semetey-1-2013:p1262:b003:l031","ordinal":173462,"en":"The Jediger came shouting."},{"id":"semetey-1-2013:p1262:b003:l032","ordinal":173463,"en":"They raised the mottled gray banner;"},{"id":"semetey-1-2013:p1262:b003:l033","ordinal":173464,"en":"The Jediger covered the land,"},{"id":"semetey-1-2013:p1262:b003:l034","ordinal":173465,"en":"Raising the cry “Khan Toltoi!”"},{"id":"semetey-1-2013:p1262:b003:l035","ordinal":173466,"en":"Divided into many kinds,"},{"id":"semetey-1-2013:p1262:b003:l036","ordinal":173467,"en":"Each formation looked different;"},{"id":"semetey-1-2013:p1262:b003:l037","ordinal":173468,"en":"Their dust swept up like a mountain,"},{"id":"semetey-1-2013:p1262:b003:l038","ordinal":173469,"en":"And without stopping they raised their cries."},{"id":"semetey-1-2013:p1262:b003:l039","ordinal":173470,"en":"Toltoi’s host was immense,"},{"id":"semetey-1-2013:p1262:b004:l001","ordinal":173471,"en":"And had covered the land with them."},{"id":"semetey-1-2013:p1262:b004:l002","ordinal":173472,"en":"Riding Sur with silver bracelets,"},{"id":"semetey-1-2013:p1262:b004:l003","ordinal":173473,"en":"All riding stout, full-grown horses,"},{"id":"semetey-1-2013:p1262:b004:l004","ordinal":173474,"en":"Tölök, master of judgment,"},{"id":"semetey-1-2013:p1262:b004:l005","ordinal":173475,"en":"With Jediger countless as ants,"},{"id":"semetey-1-2013:p1262:b004:l006","ordinal":173476,"en":"Trampled wherever they passed"},{"id":"semetey-1-2013:p1262:b004:l007","ordinal":173477,"en":"And covered the Afghan city."},{"id":"semetey-1-2013:p1262:b004:l008","ordinal":173478,"en":"Shouting from below,"},{"id":"semetey-1-2013:p1262:b004:l009","ordinal":173479,"en":"Raising the cry “Tölök!”"},{"id":"semetey-1-2013:p1262:b004:l010","ordinal":173480,"en":"He too covered the land."},{"id":"semetey-1-2013:p1262:b004:l011","ordinal":173481,"en":"Kalcha and Kadyrbai,"},{"id":"semetey-1-2013:p1262:b004:l012","ordinal":173482,"en":"Tölök and Tölöbai,"},{"id":"semetey-1-2013:p1262:b004:l013","ordinal":173483,"en":"At the edge of the lower host,"},{"id":"semetey-1-2013:p1262:b004:l014","ordinal":173484,"en":"With their princes at the front,"},{"id":"semetey-1-2013:p1262:b004:l015","ordinal":173485,"en":"Had invoked Babedin"},{"id":"semetey-1-2013:p1262:b004:l016","ordinal":173486,"en":"And loosed the raiding host."},{"id":"semetey-1-2013:p1262:b004:l017","ordinal":173487,"en":"Those on yellow horses streamed out,"},{"id":"semetey-1-2013:p1262:b004:l018","ordinal":173488,"en":"Separated as another division,"},{"id":"semetey-1-2013:p1262:b004:l019","ordinal":173489,"en":"Appearing wholly yellow."},{"id":"semetey-1-2013:p1262:b004:l020","ordinal":173490,"en":"The gray-horse riders divided off,"},{"id":"semetey-1-2013:p1262:b004:l021","ordinal":173491,"en":"Appearing as men of substance."},{"id":"semetey-1-2013:p1262:b004:l022","ordinal":173492,"en":"Their dust rose to the sky;"},{"id":"semetey-1-2013:p1262:b004:l023","ordinal":173493,"en":"The people divided into seven,"},{"id":"semetey-1-2013:p1262:b004:l024","ordinal":173494,"en":"Appearing like monsters."},{"id":"semetey-1-2013:p1262:b004:l025","ordinal":173495,"en":"The vast, wrathful host roared,"},{"id":"semetey-1-2013:p1262:b004:l026","ordinal":173496,"en":"Raising the battle cry “Khojo!”"},{"id":"semetey-1-2013:p1262:b004:l027","ordinal":173497,"en":"Saying, “Submit now to what we demand;"},{"id":"semetey-1-2013:p1262:b004:l028","ordinal":173498,"en":"Give us the old maid,”"},{"id":"semetey-1-2013:p1262:b004:l029","ordinal":173499,"en":"They flowed along the bank,"},{"id":"semetey-1-2013:p1262:b004:l030","ordinal":173500,"en":"Making the earth split and heave;"},{"id":"semetey-1-2013:p1262:b004:l031","ordinal":173501,"en":"All the Jediger"},{"id":"semetey-1-2013:p1262:b004:l032","ordinal":173502,"en":"Had covered the land with skill."},{"id":"semetey-1-2013:p1262:b004:l033","ordinal":173503,"en":"Drawing bows like rain,"},{"id":"semetey-1-2013:p1262:b004:l034","ordinal":173504,"en":"Firing bullets like hail,"},{"id":"semetey-1-2013:p1262:b004:l035","ordinal":173505,"en":"The spearmen shouted;"},{"id":"semetey-1-2013:p1262:b004:l036","ordinal":173506,"en":"The surging, massive host"},{"id":"semetey-1-2013:p1262:b004:l037","ordinal":173507,"en":"Raised the battle cry “Toltoi!”"},{"id":"semetey-1-2013:p1262:b004:l038","ordinal":173508,"en":"The musketeers stood along one flank,"},{"id":"semetey-1-2013:p1262:b004:l039","ordinal":173509,"en":"Their finest men in front,"},{"id":"semetey-1-2013:p1263:b003:l001","ordinal":173510,"en":"The archers drew together;"},{"id":"semetey-1-2013:p1263:b003:l002","ordinal":173511,"en":"Iron-headed wrestlers"},{"id":"semetey-1-2013:p1263:b003:l003","ordinal":173512,"en":"Prepared at the front."},{"id":"semetey-1-2013:p1263:b003:l004","ordinal":173513,"en":"Their warriors of countless kinds"},{"id":"semetey-1-2013:p1263:b003:l005","ordinal":173514,"en":"Were the shield"},{"id":"semetey-1-2013:p1263:b003:l006","ordinal":173515,"en":"Of whoever they faced."},{"id":"semetey-1-2013:p1263:b003:l007","ordinal":173516,"en":"From the screaming brass horn,"},{"id":"semetey-1-2013:p1263:b003:l008","ordinal":173517,"en":"From the trumpet, ears went deaf."},{"id":"semetey-1-2013:p1263:b003:l009","ordinal":173518,"en":"Across a wide ravine where no bird flew,"},{"id":"semetey-1-2013:p1263:b003:l010","ordinal":173519,"en":"From their spear no foe escaped."},{"id":"semetey-1-2013:p1263:b003:l011","ordinal":173520,"en":"Driving their heroes forward,"},{"id":"semetey-1-2013:p1263:b003:l012","ordinal":173521,"en":"They came out in chosen array;"},{"id":"semetey-1-2013:p1263:b003:l013","ordinal":173522,"en":"Their valiant men at the front,"},{"id":"semetey-1-2013:p1263:b003:l014","ordinal":173523,"en":"They came out glittering."},{"id":"semetey-1-2013:p1263:b003:l015","ordinal":173524,"en":"Hero Toltoi was a valiant man;"},{"id":"semetey-1-2013:p1263:b003:l016","ordinal":173525,"en":"From the rear of the Jediger"},{"id":"semetey-1-2013:p1263:b003:l017","ordinal":173526,"en":"He drove them out and came on."},{"id":"semetey-1-2013:p1263:b003:l018","ordinal":173527,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1263:b003:l019","ordinal":173528,"en":"Had unleashed havoc,"},{"id":"semetey-1-2013:p1263:b003:l020","ordinal":173529,"en":"Beating the great host"},{"id":"semetey-1-2013:p1263:b003:l021","ordinal":173530,"en":"And driving it without letting it flee."},{"id":"semetey-1-2013:p1263:b003:l022","ordinal":173531,"en":"When they saw the wrath of these men,"},{"id":"semetey-1-2013:p1263:b003:l023","ordinal":173532,"en":"The many Black Jediger"},{"id":"semetey-1-2013:p1263:b003:l024","ordinal":173533,"en":"Had no strength to flee."},{"id":"semetey-1-2013:p1263:b003:l025","ordinal":173534,"en":"Putting on their shields,"},{"id":"semetey-1-2013:p1263:b003:l026","ordinal":173535,"en":"Committing themselves to fate,"},{"id":"semetey-1-2013:p1263:b003:l027","ordinal":173536,"en":"They fitted their oroipo bullets;"},{"id":"semetey-1-2013:p1263:b003:l028","ordinal":173537,"en":"The Jediger of the Seven Valleys"},{"id":"semetey-1-2013:p1263:b003:l029","ordinal":173538,"en":"Covered the land all together."},{"id":"semetey-1-2013:p1263:b003:l030","ordinal":173539,"en":"The host divided into hundreds,"},{"id":"semetey-1-2013:p1263:b003:l031","ordinal":173540,"en":"Looking ready to run forward;"},{"id":"semetey-1-2013:p1263:b003:l032","ordinal":173541,"en":"The host divided into thousands,"},{"id":"semetey-1-2013:p1263:b003:l033","ordinal":173542,"en":"Looking ready to overwhelm."},{"id":"semetey-1-2013:p1263:b003:l034","ordinal":173543,"en":"They shouted their battle cries,"},{"id":"semetey-1-2013:p1263:b003:l035","ordinal":173544,"en":"Dust billowing to the sky;"},{"id":"semetey-1-2013:p1263:b003:l036","ordinal":173545,"en":"Their heroes grew excited,"},{"id":"semetey-1-2013:p1263:b003:l037","ordinal":173546,"en":"Spurring their sluggish horses."},{"id":"semetey-1-2013:p1263:b003:l038","ordinal":173547,"en":"The Jediger now covered"},{"id":"semetey-1-2013:p1263:b003:l039","ordinal":173548,"en":"The many Black Afghans;"},{"id":"semetey-1-2013:p1263:b004:l001","ordinal":173549,"en":"If allowed to go unanswered,"},{"id":"semetey-1-2013:p1263:b004:l002","ordinal":173550,"en":"They would reach their very roots,"},{"id":"semetey-1-2013:p1263:b004:l003","ordinal":173551,"en":"Shatter the stone fortress,"},{"id":"semetey-1-2013:p1263:b004:l004","ordinal":173552,"en":"And slaughter them utterly."},{"id":"semetey-1-2013:p1263:b004:l005","ordinal":173553,"en":"They would make the meek ones wail"},{"id":"semetey-1-2013:p1263:b004:l006","ordinal":173554,"en":"And offer them as sacrifice."},{"id":"semetey-1-2013:p1263:b004:l007","ordinal":173555,"en":"They would seize their daughters for pleasure;"},{"id":"semetey-1-2013:p1263:b004:l008","ordinal":173556,"en":"If the Jediger had their way,"},{"id":"semetey-1-2013:p1263:b004:l009","ordinal":173557,"en":"They came to wreak slaughter"},{"id":"semetey-1-2013:p1263:b004:l010","ordinal":173558,"en":"And bring devastation upon Afghanistan."},{"id":"semetey-1-2013:p1263:b004:l011","ordinal":173559,"en":"The strong man’s day had dawned;"},{"id":"semetey-1-2013:p1263:b004:l012","ordinal":173560,"en":"As though setting out on campaign against China,"},{"id":"semetey-1-2013:p1263:b004:l013","ordinal":173561,"en":"He had bound his head awry."},{"id":"semetey-1-2013:p1263:b004:l014","ordinal":173562,"en":"Chynkojo was a corrupter;"},{"id":"semetey-1-2013:p1263:b004:l015","ordinal":173563,"en":"His day had dawned."},{"id":"semetey-1-2013:p1263:b004:l016","ordinal":173564,"en":"While matters stood this way,"},{"id":"semetey-1-2013:p1263:b004:l017","ordinal":173565,"en":"Blue-gray mist parted in the sky;"},{"id":"semetey-1-2013:p1263:b004:l018","ordinal":173566,"en":"With a piercing shout, a myriad host—"},{"id":"semetey-1-2013:p1263:b004:l019","ordinal":173567,"en":"Chynkojo’s army appeared."},{"id":"semetey-1-2013:p1263:b004:l020","ordinal":173568,"en":"If no one drove them back,"}]
