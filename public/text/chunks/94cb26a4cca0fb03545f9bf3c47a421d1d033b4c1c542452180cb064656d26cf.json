[{"id":"semetey-1-2013:p1052:b003:l017","ordinal":156417,"en":"And return this way!"},{"id":"semetey-1-2013:p1052:b003:l018","ordinal":156418,"en":"Let us take the maiden with mutual honor"},{"id":"semetey-1-2013:p1052:b003:l019","ordinal":156419,"en":"And depart without resentment."},{"id":"semetey-1-2013:p1052:b003:l020","ordinal":156420,"en":"Let us go to their envoys;"},{"id":"semetey-1-2013:p1052:b003:l021","ordinal":156421,"en":"If they will give Chürök,"},{"id":"semetey-1-2013:p1052:b003:l022","ordinal":156422,"en":"Let us take their promise;"},{"id":"semetey-1-2013:p1052:b003:l023","ordinal":156423,"en":"If they will not give Chürök,"},{"id":"semetey-1-2013:p1052:b003:l024","ordinal":156424,"en":"Then let us begin the battle."},{"id":"semetey-1-2013:p1052:b003:l025","ordinal":156425,"en":"Look carefully, warrior Toltoy:"},{"id":"semetey-1-2013:p1052:b003:l026","ordinal":156426,"en":"Livestock has come as tribute,"},{"id":"semetey-1-2013:p1052:b003:l027","ordinal":156427,"en":"The khan has come leading them,"},{"id":"semetey-1-2013:p1052:b003:l028","ordinal":156428,"en":"Grievous force has come upon Afghanistan,"},{"id":"semetey-1-2013:p1052:b003:l029","ordinal":156429,"en":"All their nobles have come."},{"id":"semetey-1-2013:p1052:b003:l030","ordinal":156430,"en":"Let us hear the envoys' answer,"},{"id":"semetey-1-2013:p1052:b003:l031","ordinal":156431,"en":"And then ride out to war!\""},{"id":"semetey-1-2013:p1052:b003:l032","ordinal":156432,"en":"When mighty Kozho waved"},{"id":"semetey-1-2013:p1052:b003:l033","ordinal":156433,"en":"The red banner mottled gray and white,"},{"id":"semetey-1-2013:p1052:b003:l034","ordinal":156434,"en":"It was the signal to dismount;"},{"id":"semetey-1-2013:p1052:b003:l035","ordinal":156435,"en":"All the Zhediger"},{"id":"semetey-1-2013:p1052:b003:l036","ordinal":156436,"en":"Boiled down from their horses."},{"id":"semetey-1-2013:p1052:b003:l037","ordinal":156437,"en":"Swarming like ants,"},{"id":"semetey-1-2013:p1052:b003:l038","ordinal":156438,"en":"They spread out and dismounted."},{"id":"semetey-1-2013:p1052:b003:l039","ordinal":156439,"en":"Dividing into groups of ten and five,"},{"id":"semetey-1-2013:p1052:b004:l001","ordinal":156440,"en":"They gathered around the field cauldrons."},{"id":"semetey-1-2013:p1052:b004:l002","ordinal":156441,"en":"Chynkozho and warrior Tölök"},{"id":"semetey-1-2013:p1052:b004:l003","ordinal":156442,"en":"Had the Zhediger dismount."},{"id":"semetey-1-2013:p1052:b004:l004","ordinal":156443,"en":"Hurrying between the sides came"},{"id":"semetey-1-2013:p1052:b004:l005","ordinal":156444,"en":"Azhybay, son of Azhy,"},{"id":"semetey-1-2013:p1052:b004:l006","ordinal":156445,"en":"And Tümönbay, son of Tülkü."},{"id":"semetey-1-2013:p1052:b004:l007","ordinal":156446,"en":"Azhybay, son of Azhy,"},{"id":"semetey-1-2013:p1052:b004:l008","ordinal":156447,"en":"Was a surpassingly eloquent servant,"},{"id":"semetey-1-2013:p1052:b004:l009","ordinal":156448,"en":"Swift-tongued and skilled in argument,"},{"id":"semetey-1-2013:p1052:b004:l010","ordinal":156449,"en":"A man of exceptional eloquence."},{"id":"semetey-1-2013:p1052:b004:l011","ordinal":156450,"en":"Tümönbay, son of Tülkü,"},{"id":"semetey-1-2013:p1052:b004:l012","ordinal":156451,"en":"Proud-hearted and blustering,"},{"id":"semetey-1-2013:p1052:b004:l013","ordinal":156452,"en":"Very courageous and stern,"},{"id":"semetey-1-2013:p1052:b004:l014","ordinal":156453,"en":"Was a ruthless hero"},{"id":"semetey-1-2013:p1052:b004:l015","ordinal":156454,"en":"Who never turned back from death."},{"id":"semetey-1-2013:p1052:b004:l016","ordinal":156455,"en":"After seeing Kozho and Tölök"},{"id":"semetey-1-2013:p1052:b004:l017","ordinal":156456,"en":"Coming toward them,"},{"id":"semetey-1-2013:p1052:b004:l018","ordinal":156457,"en":"They had their thoroughbreds prepared"},{"id":"semetey-1-2013:p1052:b004:l019","ordinal":156458,"en":"And the horses tethered far away."},{"id":"semetey-1-2013:p1052:b004:l020","ordinal":156459,"en":"They spread foods of every sweet and fine kind"},{"id":"semetey-1-2013:p1052:b004:l021","ordinal":156460,"en":"In abundance before Kozho,"},{"id":"semetey-1-2013:p1052:b004:l022","ordinal":156461,"en":"And beneath him had a thick layer"},{"id":"semetey-1-2013:p1052:b004:l023","ordinal":156462,"en":"Of splendid carpets of every kind laid."},{"id":"semetey-1-2013:p1052:b004:l024","ordinal":156463,"en":"Tölök and Chynkozho"},{"id":"semetey-1-2013:p1052:b004:l025","ordinal":156464,"en":"Halted the Zhediger host"},{"id":"semetey-1-2013:p1052:b004:l026","ordinal":156465,"en":"And the two now came between the sides."},{"id":"semetey-1-2013:p1052:b004:l027","ordinal":156466,"en":"When he saw the appearance"},{"id":"semetey-1-2013:p1052:b004:l028","ordinal":156467,"en":"Of Tümönbay and Azhybay,"},{"id":"semetey-1-2013:p1052:b004:l029","ordinal":156468,"en":"Could Kozho stand without surging forward?"},{"id":"semetey-1-2013:p1052:b004:l030","ordinal":156469,"en":"\"Azhybay and Tümönbay,"},{"id":"semetey-1-2013:p1052:b004:l031","ordinal":156470,"en":"Tell the lawful and unlawful truth."},{"id":"semetey-1-2013:p1052:b004:l032","ordinal":156471,"en":"If you will not give her, name your danger;"},{"id":"semetey-1-2013:p1052:b004:l033","ordinal":156472,"en":"If you say you will, state your answer!"},{"id":"semetey-1-2013:p1052:b004:l034","ordinal":156473,"en":"If you say you will not give Chürök,"},{"id":"semetey-1-2013:p1052:b004:l035","ordinal":156474,"en":"Let us begin the turmoil;"},{"id":"semetey-1-2013:p1052:b004:l036","ordinal":156475,"en":"Let us send the armies over you,"},{"id":"semetey-1-2013:p1052:b004:l037","ordinal":156476,"en":"And set your bitter sorrows boiling."},{"id":"semetey-1-2013:p1052:b004:l038","ordinal":156477,"en":"Tell me the purpose for which you girded your waist;"},{"id":"semetey-1-2013:p1052:b004:l039","ordinal":156478,"en":"Tell me the place where you lie fortified,"}]
