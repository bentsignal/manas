[{"id":"semetey-1-2013:p1335:b004:l009","ordinal":178177,"en":"With Bölökbai at their head,"},{"id":"semetey-1-2013:p1335:b004:l010","ordinal":178178,"en":"Let us prepare eighty smiths;"},{"id":"semetey-1-2013:p1335:b004:l011","ordinal":178179,"en":"Helmets of blue steel,"},{"id":"semetey-1-2013:p1335:b004:l012","ordinal":178180,"en":"To be set upside down upon the head,"},{"id":"semetey-1-2013:p1335:b004:l013","ordinal":178181,"en":"So all the ready warriors"},{"id":"semetey-1-2013:p1335:b004:l014","ordinal":178182,"en":"May strike the foe without tiring;"},{"id":"semetey-1-2013:p1335:b004:l015","ordinal":178183,"en":"Let us make mail-cap helmets,"},{"id":"semetey-1-2013:p1335:b004:l016","ordinal":178184,"en":"Let us ready the weapons of war."},{"id":"semetey-1-2013:p1335:b004:l017","ordinal":178185,"en":"Let us take an exact count"},{"id":"semetey-1-2013:p1335:b004:l018","ordinal":178186,"en":"Of the troops going to the Kakan!"},{"id":"semetey-1-2013:p1335:b004:l019","ordinal":178187,"en":"Against the seething unbelievers,"},{"id":"semetey-1-2013:p1335:b004:l020","ordinal":178188,"en":"Against hero Khan Kongurbai,"},{"id":"semetey-1-2013:p1335:b004:l021","ordinal":178189,"en":"Thus let us begin the conflict!"},{"id":"semetey-1-2013:p1335:b004:l022","ordinal":178190,"en":"Wearing coats without a hole,"},{"id":"semetey-1-2013:p1335:b004:l023","ordinal":178191,"en":"Gathering an army fit to match them,"},{"id":"semetey-1-2013:p1335:b004:l024","ordinal":178192,"en":"Let us take the host together,"},{"id":"semetey-1-2013:p1335:b004:l025","ordinal":178193,"en":"My splendid young hero,"},{"id":"semetey-1-2013:p1335:b004:l026","ordinal":178194,"en":"And ride thus into battle!"},{"id":"semetey-1-2013:p1335:b004:l027","ordinal":178195,"en":"Preparing troops of many kinds,"},{"id":"semetey-1-2013:p1335:b004:l028","ordinal":178196,"en":"For the force going to exchange fire,"},{"id":"semetey-1-2013:p1335:b004:l029","ordinal":178197,"en":"Preparing abundant provisions."},{"id":"semetey-1-2013:p1335:b004:l030","ordinal":178198,"en":"My horses on the hills are piebald,"},{"id":"semetey-1-2013:p1335:b004:l031","ordinal":178199,"en":"Swift horses and chargers mixed together."},{"id":"semetey-1-2013:p1335:b004:l032","ordinal":178200,"en":"There are well-fattened mares;"},{"id":"semetey-1-2013:p1335:b004:l033","ordinal":178201,"en":"Choose and slaughter the fat ones,"},{"id":"semetey-1-2013:p1335:b004:l034","ordinal":178202,"en":"Have the servants butcher them,"},{"id":"semetey-1-2013:p1335:b004:l035","ordinal":178203,"en":"And select provisions."},{"id":"semetey-1-2013:p1335:b004:l036","ordinal":178204,"en":"If you bring great conflict upon China,"},{"id":"semetey-1-2013:p1335:b004:l037","ordinal":178205,"en":"So the army does not go hungry,"},{"id":"semetey-1-2013:p1335:b004:l038","ordinal":178206,"en":"Let us firmly prepare journey-rations!"},{"id":"semetey-1-2013:p1335:b004:l039","ordinal":178207,"en":"If we wage battle against Beijing!"},{"id":"semetey-1-2013:p1336:b003:l001","ordinal":178208,"en":"Let us not be caught unawares!"},{"id":"semetey-1-2013:p1336:b003:l002","ordinal":178209,"en":"If we set out for Kakan-Chin,"},{"id":"semetey-1-2013:p1336:b003:l003","ordinal":178210,"en":"Let dust fly into the sky,"},{"id":"semetey-1-2013:p1336:b003:l004","ordinal":178211,"en":"As the army gathers in a mass."},{"id":"semetey-1-2013:p1336:b003:l005","ordinal":178212,"en":"The spearheads clashing,"},{"id":"semetey-1-2013:p1336:b003:l006","ordinal":178213,"en":"Each intending to go on holy war,"},{"id":"semetey-1-2013:p1336:b003:l007","ordinal":178214,"en":"The army racing with a roar."},{"id":"semetey-1-2013:p1336:b003:l008","ordinal":178215,"en":"While your lion father lived,"},{"id":"semetey-1-2013:p1336:b003:l009","ordinal":178216,"en":"He chose seven heroes,"},{"id":"semetey-1-2013:p1336:b003:l010","ordinal":178217,"en":"Stationed them in seven places,"},{"id":"semetey-1-2013:p1336:b003:l011","ordinal":178218,"en":"Had them called sons of the accomplished,"},{"id":"semetey-1-2013:p1336:b003:l012","ordinal":178219,"en":"Brought great conflict upon Beijing,"},{"id":"semetey-1-2013:p1336:b003:l013","ordinal":178220,"en":"And ravaged every place they reached."},{"id":"semetey-1-2013:p1336:b003:l014","ordinal":178221,"en":"All the fine-bred horses,"},{"id":"semetey-1-2013:p1336:b003:l015","ordinal":178222,"en":"He made prance in the mountains;"},{"id":"semetey-1-2013:p1336:b003:l016","ordinal":178223,"en":"The seething Chinese,"},{"id":"semetey-1-2013:p1336:b003:l017","ordinal":178224,"en":"He made their wives and daughters weep,"},{"id":"semetey-1-2013:p1336:b003:l018","ordinal":178225,"en":"And destroyed the cities"},{"id":"semetey-1-2013:p1336:b003:l019","ordinal":178226,"en":"Of the black Chinese and Manchu."},{"id":"semetey-1-2013:p1336:b003:l020","ordinal":178227,"en":"Bringing hardship upon China,"},{"id":"semetey-1-2013:p1336:b003:l021","ordinal":178228,"en":"Your adversary Kakan-Chin—"},{"id":"semetey-1-2013:p1336:b003:l022","ordinal":178229,"en":"If we wage holy war against Beijing,"},{"id":"semetey-1-2013:p1336:b003:l023","ordinal":178230,"en":"Leveling it flatter than a palm,"},{"id":"semetey-1-2013:p1336:b003:l024","ordinal":178231,"en":"Making springtime seem no more than autumn."},{"id":"semetey-1-2013:p1336:b003:l025","ordinal":178232,"en":"The army marching in a mass,"},{"id":"semetey-1-2013:p1336:b003:l026","ordinal":178233,"en":"The earth hidden in haze,"},{"id":"semetey-1-2013:p1336:b003:l027","ordinal":178234,"en":"Dust flying into the sky."},{"id":"semetey-1-2013:p1336:b003:l028","ordinal":178235,"en":"The march becoming a wondrous road,"},{"id":"semetey-1-2013:p1336:b003:l029","ordinal":178236,"en":"The whole world stirring,"},{"id":"semetey-1-2013:p1336:b003:l030","ordinal":178237,"en":"The army surging and spilling forth,"},{"id":"semetey-1-2013:p1336:b003:l031","ordinal":178238,"en":"In the eyes of Kalcha Kongurbai,"},{"id":"semetey-1-2013:p1336:b003:l032","ordinal":178239,"en":"Appearing like a monster—"},{"id":"semetey-1-2013:p1336:b003:l033","ordinal":178240,"en":"Thus let us go to Beijing."},{"id":"semetey-1-2013:p1336:b003:l034","ordinal":178241,"en":"Against the seething unbelievers,"},{"id":"semetey-1-2013:p1336:b003:l035","ordinal":178242,"en":"Against hero Khan Kongurbai,"},{"id":"semetey-1-2013:p1336:b003:l036","ordinal":178243,"en":"Thus let us wage war!"},{"id":"semetey-1-2013:p1336:b003:l037","ordinal":178244,"en":"When Muslims set out on holy war,"},{"id":"semetey-1-2013:p1336:b003:l038","ordinal":178245,"en":"My only support, hear this:"},{"id":"semetey-1-2013:p1336:b003:l039","ordinal":178246,"en":"Such is the nature of battle!"},{"id":"semetey-1-2013:p1336:b004:l001","ordinal":178247,"en":"Raising the white sacred banner,"},{"id":"semetey-1-2013:p1336:b004:l002","ordinal":178248,"en":"Shouting the cry of “Manas!”"},{"id":"semetey-1-2013:p1336:b004:l003","ordinal":178249,"en":"With the white-mottled standard as our banner,"},{"id":"semetey-1-2013:p1336:b004:l004","ordinal":178250,"en":"With plentiful shouts and uproar,"},{"id":"semetey-1-2013:p1336:b004:l005","ordinal":178251,"en":"When we meet the Chinese,"},{"id":"semetey-1-2013:p1336:b004:l006","ordinal":178252,"en":"The bronze cannon booming,"},{"id":"semetey-1-2013:p1336:b004:l007","ordinal":178253,"en":"When the hosts meet in full,"},{"id":"semetey-1-2013:p1336:b004:l008","ordinal":178254,"en":"When the general battle begins,"},{"id":"semetey-1-2013:p1336:b004:l009","ordinal":178255,"en":"The battle-axes clanging,"},{"id":"semetey-1-2013:p1336:b004:l010","ordinal":178256,"en":"Sharpened swords flashing,"},{"id":"semetey-1-2013:p1336:b004:l011","ordinal":178257,"en":"Spears breaking apart,"},{"id":"semetey-1-2013:p1336:b004:l012","ordinal":178258,"en":"Human blood spilling,"},{"id":"semetey-1-2013:p1336:b004:l013","ordinal":178259,"en":"Ah, my foal,"},{"id":"semetey-1-2013:p1336:b004:l014","ordinal":178260,"en":"A man's valor"},{"id":"semetey-1-2013:p1336:b004:l015","ordinal":178261,"en":"Appearing like a lion."},{"id":"semetey-1-2013:p1336:b004:l016","ordinal":178262,"en":"When the facing enemy is scattered,"},{"id":"semetey-1-2013:p1336:b004:l017","ordinal":178263,"en":"My only son of a hero,"},{"id":"semetey-1-2013:p1336:b004:l018","ordinal":178264,"en":"Is that not a mighty marvel!"},{"id":"semetey-1-2013:p1336:b004:l019","ordinal":178265,"en":"While my hero Manas lived,"},{"id":"semetey-1-2013:p1336:b004:l020","ordinal":178266,"en":"With hero Bakai before us,"},{"id":"semetey-1-2013:p1336:b004:l021","ordinal":178267,"en":"We brought calamity thus;"},{"id":"semetey-1-2013:p1336:b004:l022","ordinal":178268,"en":"Crushing the enemy we faced,"},{"id":"semetey-1-2013:p1336:b004:l023","ordinal":178269,"en":"We took them within a single day."},{"id":"semetey-1-2013:p1336:b004:l024","ordinal":178270,"en":"If death came, we died;"},{"id":"semetey-1-2013:p1336:b004:l025","ordinal":178271,"en":"All those we faced,"},{"id":"semetey-1-2013:p1336:b004:l026","ordinal":178272,"en":"When we advanced, we burned like fire."},{"id":"semetey-1-2013:p1336:b004:l027","ordinal":178273,"en":"While my gray wolf Manas lived,"},{"id":"semetey-1-2013:p1336:b004:l028","ordinal":178274,"en":"I reclined in armor no bullet pierced,"},{"id":"semetey-1-2013:p1336:b004:l029","ordinal":178275,"en":"And when they provoked me,"},{"id":"semetey-1-2013:p1336:b004:l030","ordinal":178276,"en":"I crushed the Kyzylbash."},{"id":"semetey-1-2013:p1336:b004:l031","ordinal":178277,"en":"While bloodthirsty Manas lived,"},{"id":"semetey-1-2013:p1336:b004:l032","ordinal":178278,"en":"I reclined wearing my shield,"},{"id":"semetey-1-2013:p1336:b004:l033","ordinal":178279,"en":"And when they angered me,"},{"id":"semetey-1-2013:p1336:b004:l034","ordinal":178280,"en":"I smashed and ruined the Chinese."},{"id":"semetey-1-2013:p1336:b004:l035","ordinal":178281,"en":"While your comrade lived,"},{"id":"semetey-1-2013:p1336:b004:l036","ordinal":178282,"en":"Their gold, silver, and daughters—"},{"id":"semetey-1-2013:p1336:b004:l037","ordinal":178283,"en":"Alas, what a woeful, dreadful day,"},{"id":"semetey-1-2013:p1336:b004:l038","ordinal":178284,"en":"Why did I not die while plundering them!"},{"id":"semetey-1-2013:p1336:b004:l039","ordinal":178285,"en":"Chinmachin and the Kakan,"},{"id":"semetey-1-2013:p1337:b003:l001","ordinal":178286,"en":"Why did I not die while plundering them!"},{"id":"semetey-1-2013:p1337:b003:l002","ordinal":178287,"en":"Making the Manchu crash,"},{"id":"semetey-1-2013:p1337:b003:l003","ordinal":178288,"en":"Why did I not die while striking them!"},{"id":"semetey-1-2013:p1337:b003:l004","ordinal":178289,"en":"When we seized the Kakan's khanate,"},{"id":"semetey-1-2013:p1337:b003:l005","ordinal":178290,"en":"Why did I not die!"},{"id":"semetey-1-2013:p1337:b003:l006","ordinal":178291,"en":"When we brought chaos upon Beijing,"},{"id":"semetey-1-2013:p1337:b003:l007","ordinal":178292,"en":"Why did I not die!"},{"id":"semetey-1-2013:p1337:b003:l008","ordinal":178293,"en":"Gripping a spear and breaking formations,"},{"id":"semetey-1-2013:p1337:b003:l009","ordinal":178294,"en":"Why did I not die in battle!"},{"id":"semetey-1-2013:p1337:b003:l010","ordinal":178295,"en":"In the mace-blows of the general melee,"},{"id":"semetey-1-2013:p1337:b003:l011","ordinal":178296,"en":"Why did I not die in combat!"},{"id":"semetey-1-2013:p1337:b003:l012","ordinal":178297,"en":"You have halted me at the frontier,"},{"id":"semetey-1-2013:p1337:b003:l013","ordinal":178298,"en":"My young hero, son of Manas,"},{"id":"semetey-1-2013:p1337:b003:l014","ordinal":178299,"en":"And made me mourn the old days!"},{"id":"semetey-1-2013:p1337:b003:l015","ordinal":178300,"en":"Counting all that came before,"},{"id":"semetey-1-2013:p1337:b003:l016","ordinal":178301,"en":"I sit here overturned with grief!"},{"id":"semetey-1-2013:p1337:b003:l017","ordinal":178302,"en":"Against the seething Chinese Kakan,"},{"id":"semetey-1-2013:p1337:b003:l018","ordinal":178303,"en":"When we charged and began war,"},{"id":"semetey-1-2013:p1337:b003:l019","ordinal":178304,"en":"When we seized his khanate,"},{"id":"semetey-1-2013:p1337:b003:l020","ordinal":178305,"en":"Alas, what a desolate day,"},{"id":"semetey-1-2013:p1337:b003:l021","ordinal":178306,"en":"Why did I not die there!"},{"id":"semetey-1-2013:p1337:b003:l022","ordinal":178307,"en":"When I poured my courage"},{"id":"semetey-1-2013:p1337:b003:l023","ordinal":178308,"en":"Out against the Chinese,"},{"id":"semetey-1-2013:p1337:b003:l024","ordinal":178309,"en":"When my humanity"},{"id":"semetey-1-2013:p1337:b003:l025","ordinal":178310,"en":"Overflowed from my head,"},{"id":"semetey-1-2013:p1337:b003:l026","ordinal":178311,"en":"Why did I not die there!"},{"id":"semetey-1-2013:p1337:b003:l027","ordinal":178312,"en":"When, with courage, I hemmed in"},{"id":"semetey-1-2013:p1337:b003:l028","ordinal":178313,"en":"The Kalmak,"},{"id":"semetey-1-2013:p1337:b003:l029","ordinal":178314,"en":"When I struck"},{"id":"semetey-1-2013:p1337:b003:l030","ordinal":178315,"en":"The Kaldai and Zuntung,"},{"id":"semetey-1-2013:p1337:b003:l031","ordinal":178316,"en":"Why did I not die there!"},{"id":"semetey-1-2013:p1337:b003:l032","ordinal":178317,"en":"When I smashed those who opposed me,"},{"id":"semetey-1-2013:p1337:b003:l033","ordinal":178318,"en":"And cut them down,"},{"id":"semetey-1-2013:p1337:b003:l034","ordinal":178319,"en":"When I inflicted humiliation"},{"id":"semetey-1-2013:p1337:b003:l035","ordinal":178320,"en":"Upon the Kalmak like sheep,"},{"id":"semetey-1-2013:p1337:b003:l036","ordinal":178321,"en":"Why did I not die then!"},{"id":"semetey-1-2013:p1337:b003:l037","ordinal":178322,"en":"Filled out like a lion,"},{"id":"semetey-1-2013:p1337:b003:l038","ordinal":178323,"en":"In your holy uncle Bakai"},{"id":"semetey-1-2013:p1337:b003:l039","ordinal":178324,"en":"The old anguish stirred!"},{"id":"semetey-1-2013:p1337:b005:l001","ordinal":178325,"en":"When my journey grew feeble,"},{"id":"semetey-1-2013:p1337:b005:l002","ordinal":178326,"en":"My young son Semetey,"},{"id":"semetey-1-2013:p1337:b005:l003","ordinal":178327,"en":"Do not make my days turn yellow."},{"id":"semetey-1-2013:p1337:b005:l004","ordinal":178328,"en":"While my gray wolf Manas lived,"},{"id":"semetey-1-2013:p1337:b005:l005","ordinal":178329,"en":"He waged holy war in many lands,"},{"id":"semetey-1-2013:p1337:b005:l006","ordinal":178330,"en":"And always heeded"},{"id":"semetey-1-2013:p1337:b005:l007","ordinal":178331,"en":"The words of your holy uncle Bakai."},{"id":"semetey-1-2013:p1337:b005:l008","ordinal":178332,"en":"While my gray wolf Manas lived,"},{"id":"semetey-1-2013:p1337:b005:l009","ordinal":178333,"en":"I raised the banner in many lands;"},{"id":"semetey-1-2013:p1337:b005:l010","ordinal":178334,"en":"Defending the Kyrgyz people,"},{"id":"semetey-1-2013:p1337:b005:l011","ordinal":178335,"en":"Taking the blue-mottled spear in hand,"},{"id":"semetey-1-2013:p1337:b005:l012","ordinal":178336,"en":"I speared and shattered many lands."},{"id":"semetey-1-2013:p1337:b005:l013","ordinal":178337,"en":"While my accomplished gray wolf lived,"},{"id":"semetey-1-2013:p1337:b005:l014","ordinal":178338,"en":"I girded the jekene at my waist,"},{"id":"semetey-1-2013:p1337:b005:l015","ordinal":178339,"en":"And amid enemies covering the earth,"},{"id":"semetey-1-2013:p1337:b005:l016","ordinal":178340,"en":"I rode alone through them and attacked."},{"id":"semetey-1-2013:p1337:b005:l017","ordinal":178341,"en":"Since my accomplished Manas died,"},{"id":"semetey-1-2013:p1337:b005:l018","ordinal":178342,"en":"I am dead, not living;"},{"id":"semetey-1-2013:p1337:b005:l019","ordinal":178343,"en":"Weeping long for my bloodthirsty hero,"},{"id":"semetey-1-2013:p1337:b005:l020","ordinal":178344,"en":"My poor soul has seen hell while alive."},{"id":"semetey-1-2013:p1337:b005:l021","ordinal":178345,"en":"Reason has left me,"},{"id":"semetey-1-2013:p1337:b005:l022","ordinal":178346,"en":"From weeping long for my magnanimous lord,"},{"id":"semetey-1-2013:p1337:b005:l023","ordinal":178347,"en":"The light has left my eyes."},{"id":"semetey-1-2013:p1337:b005:l024","ordinal":178348,"en":"When my lion died,"},{"id":"semetey-1-2013:p1337:b005:l025","ordinal":178349,"en":"My black beard turned white;"},{"id":"semetey-1-2013:p1337:b005:l026","ordinal":178350,"en":"For your mountain-like uncle Bakai,"},{"id":"semetey-1-2013:p1337:b005:l027","ordinal":178351,"en":"The end of days has nearly come."},{"id":"semetey-1-2013:p1337:b005:l028","ordinal":178352,"en":"I have spoken all these words—understand;"},{"id":"semetey-1-2013:p1337:b005:l029","ordinal":178353,"en":"My needed only one, heed me!"},{"id":"semetey-1-2013:p1337:b005:l030","ordinal":178354,"en":"Unbeliever and Muslim—"},{"id":"semetey-1-2013:p1337:b005:l031","ordinal":178355,"en":"Noble orphan, think!"},{"id":"semetey-1-2013:p1337:b005:l032","ordinal":178356,"en":"Such is the nature of battle."},{"id":"semetey-1-2013:p1337:b005:l033","ordinal":178357,"en":"Your uncle, dear hero Bakai—"},{"id":"semetey-1-2013:p1337:b005:l034","ordinal":178358,"en":"An iron coat no bullet pierced,"},{"id":"semetey-1-2013:p1337:b005:l035","ordinal":178359,"en":"Do you think he did not wear it?!"},{"id":"semetey-1-2013:p1337:b005:l036","ordinal":178360,"en":"In the holy war where peoples clashed,"},{"id":"semetey-1-2013:p1337:b005:l037","ordinal":178361,"en":"Do you think Bakai did not march"},{"id":"semetey-1-2013:p1337:b005:l038","ordinal":178362,"en":"At the head of the people?!"},{"id":"semetey-1-2013:p1337:b005:l039","ordinal":178363,"en":"The many people of forty Chinese tribes,"},{"id":"semetey-1-2013:p1338:b003:l001","ordinal":178364,"en":"Do you think he did not know them?!"},{"id":"semetey-1-2013:p1338:b003:l002","ordinal":178365,"en":"The sable cap upon one's head—"},{"id":"semetey-1-2013:p1338:b003:l003","ordinal":178366,"en":"Who has not worn it at a jaunty tilt,"},{"id":"semetey-1-2013:p1338:b003:l004","ordinal":178367,"en":"Who, while fortune was theirs,"},{"id":"semetey-1-2013:p1338:b003:l005","ordinal":178368,"en":"Did not stride about roaring?"},{"id":"semetey-1-2013:p1338:b003:l006","ordinal":178369,"en":"I have told many of its secrets;"},{"id":"semetey-1-2013:p1338:b003:l007","ordinal":178370,"en":"Such is the nature of Beijing!"},{"id":"semetey-1-2013:p1338:b003:l008","ordinal":178371,"en":"My heroic son, understand,"},{"id":"semetey-1-2013:p1338:b003:l009","ordinal":178372,"en":"And heed me without making me wail!"},{"id":"semetey-1-2013:p1338:b003:l010","ordinal":178373,"en":"Beijing is no easy place;"},{"id":"semetey-1-2013:p1338:b003:l011","ordinal":178374,"en":"Those who go there to die"},{"id":"semetey-1-2013:p1338:b003:l012","ordinal":178375,"en":"Are not a people it restores!"},{"id":"semetey-1-2013:p1338:b003:l013","ordinal":178376,"en":"In that Beijing,"},{"id":"semetey-1-2013:p1338:b003:l014","ordinal":178377,"en":"Of the great men of old,"},{"id":"semetey-1-2013:p1338:b003:l015","ordinal":178378,"en":"None went and exacted judgment;"},{"id":"semetey-1-2013:p1338:b003:l016","ordinal":178379,"en":"Whoever attacked the people"},{"id":"semetey-1-2013:p1338:b003:l017","ordinal":178380,"en":"Of Kakan-Chin did not survive."},{"id":"semetey-1-2013:p1338:b003:l018","ordinal":178381,"en":"Solomon did not exact judgment there;"},{"id":"semetey-1-2013:p1338:b003:l019","ordinal":178382,"en":"That is formidable Beijing!"},{"id":"semetey-1-2013:p1338:b003:l020","ordinal":178383,"en":"Unfolding its nature from the root,"},{"id":"semetey-1-2013:p1338:b003:l021","ordinal":178384,"en":"I have told it to you!"},{"id":"semetey-1-2013:p1338:b003:l022","ordinal":178385,"en":"What he knew and perceived,"},{"id":"semetey-1-2013:p1338:b003:l023","ordinal":178386,"en":"Hero Bakai told thus;"},{"id":"semetey-1-2013:p1338:b003:l024","ordinal":178387,"en":"What he had seen and knew,"},{"id":"semetey-1-2013:p1338:b003:l025","ordinal":178388,"en":"Hero Bakai told openly."},{"id":"semetey-1-2013:p1338:b003:l026","ordinal":178389,"en":"The young sultan, hero Semey,"},{"id":"semetey-1-2013:p1338:b003:l027","ordinal":178390,"en":"Your hero who did not fear death,"},{"id":"semetey-1-2013:p1338:b003:l028","ordinal":178391,"en":"Drew his arm back,"},{"id":"semetey-1-2013:p1338:b003:l029","ordinal":178392,"en":"Your lion remaining unmoved,"},{"id":"semetey-1-2013:p1338:b003:l030","ordinal":178393,"en":"His gray-wolf spirit roused, he cried out."},{"id":"semetey-1-2013:p1338:b004:l001","ordinal":178394,"en":"When he heard hero Bakai's words,"},{"id":"semetey-1-2013:p1338:b004:l002","ordinal":178395,"en":"He summoned his two mothers..."},{"id":"semetey-1-2013:p1338:b004:l003","ordinal":178396,"en":"Below Tört-Kül,"},{"id":"semetey-1-2013:p1338:b004:l004","ordinal":178397,"en":"In the garden prince Manas planted,"},{"id":"semetey-1-2013:p1338:b004:l005","ordinal":178398,"en":"Facing Great Talas,"},{"id":"semetey-1-2013:p1338:b004:l006","ordinal":178399,"en":"At the edge of Great Ak-Chiy,"},{"id":"semetey-1-2013:p1338:b004:l007","ordinal":178400,"en":"Within the walled stronghold,"},{"id":"semetey-1-2013:p1338:b004:l008","ordinal":178401,"en":"In Chachykei's palace,"},{"id":"semetey-1-2013:p1338:b004:l009","ordinal":178402,"en":"Hero Semey, son of the prince,"},{"id":"semetey-1-2013:p1338:b004:l010","ordinal":178403,"en":"Your hero aided by spirits,"},{"id":"semetey-1-2013:p1338:b004:l011","ordinal":178404,"en":"Külchoro, son of Almambet—"},{"id":"semetey-1-2013:p1338:b004:l012","ordinal":178405,"en":"The ready expert in shooting;"},{"id":"semetey-1-2013:p1338:b004:l013","ordinal":178406,"en":"Kanchoro, son of Chubak—"},{"id":"semetey-1-2013:p1338:b004:l014","ordinal":178407,"en":"The strong master of the whip;"},{"id":"semetey-1-2013:p1338:b004:l015","ordinal":178408,"en":"Argyn and Kyrgyz together,"},{"id":"semetey-1-2013:p1338:b004:l016","ordinal":178409,"en":"Hearing Semetey would go to Beijing,"},{"id":"semetey-1-2013:p1338:b004:l017","ordinal":178410,"en":"Poor heads were thrown into turmoil."},{"id":"semetey-1-2013:p1338:b004:l018","ordinal":178411,"en":"From the banks of Üch-Koshoy,"},{"id":"semetey-1-2013:p1338:b004:l019","ordinal":178412,"en":"Sarykan, khan of the Argyn,"},{"id":"semetey-1-2013:p1338:b004:l020","ordinal":178413,"en":"Heard the news and came;"},{"id":"semetey-1-2013:p1338:b004:l021","ordinal":178414,"en":"A teeming multitude came."},{"id":"semetey-1-2013:p1338:b004:l022","ordinal":178415,"en":"Bölökbai, keeper of the treasury,"},{"id":"semetey-1-2013:p1338:b004:l023","ordinal":178416,"en":"Leading his forty Kalchas,"},{"id":"semetey-1-2013:p1338:b004:l024","ordinal":178417,"en":"(With his father, hero Manas,"},{"id":"semetey-1-2013:p1338:b004:l025","ordinal":178418,"en":"He had been a friend unto doomsday),"},{"id":"semetey-1-2013:p1338:b004:l026","ordinal":178419,"en":"He came raising a battle cry."},{"id":"semetey-1-2013:p1338:b004:l027","ordinal":178420,"en":"All the khans gathered,"},{"id":"semetey-1-2013:p1338:b004:l028","ordinal":178421,"en":"The people came and assembled;"},{"id":"semetey-1-2013:p1338:b004:l029","ordinal":178422,"en":"The khans wept in torrents,"},{"id":"semetey-1-2013:p1338:b004:l030","ordinal":178423,"en":"The people grieved with a roar."},{"id":"semetey-1-2013:p1339:b004:l001","ordinal":178424,"en":"Sary Khan stood and said this:"},{"id":"semetey-1-2013:p1339:b004:l002","ordinal":178425,"en":"“My only one left by the bloodthirsty hero!"},{"id":"semetey-1-2013:p1339:b004:l003","ordinal":178426,"en":"Those who go to Beijing do not return;"},{"id":"semetey-1-2013:p1339:b004:l004","ordinal":178427,"en":"No man has defeated it in conflict,"},{"id":"semetey-1-2013:p1339:b004:l005","ordinal":178428,"en":"And no soul who went returned alive."},{"id":"semetey-1-2013:p1339:b004:l006","ordinal":178429,"en":"Toward harsh and perilous Beijing,"},{"id":"semetey-1-2013:p1339:b004:l007","ordinal":178430,"en":"Pursuing your royal father's blood vengeance,"},{"id":"semetey-1-2013:p1339:b004:l008","ordinal":178431,"en":"You have set out to grapple!"},{"id":"semetey-1-2013:p1339:b004:l009","ordinal":178432,"en":"Return alive from Beijing;"}]
