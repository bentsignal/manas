[{"id":"semetey-1-2013:p1276:b004:l031","ordinal":174593,"en":"Did you see the consummate skill"},{"id":"semetey-1-2013:p1276:b004:l032","ordinal":174594,"en":"Of Choro, Almambet's son?!"},{"id":"semetey-1-2013:p1276:b004:l033","ordinal":174595,"en":"Did you see the earth-filling Jediger"},{"id":"semetey-1-2013:p1276:b004:l034","ordinal":174596,"en":"Reduced to nothing?"},{"id":"semetey-1-2013:p1276:b004:l035","ordinal":174597,"en":"Choro appeared like a wolf;"},{"id":"semetey-1-2013:p1276:b004:l036","ordinal":174598,"en":"When he plunged among them,"},{"id":"semetey-1-2013:p1276:b004:l037","ordinal":174599,"en":"All the Jediger"},{"id":"semetey-1-2013:p1276:b004:l038","ordinal":174600,"en":"Split into separate groups."},{"id":"semetey-1-2013:p1276:b004:l039","ordinal":174601,"en":"Wounded, they went away,"},{"id":"semetey-1-2013:p1277:b003:l001","ordinal":174602,"en":"All fleeing in a stream."},{"id":"semetey-1-2013:p1277:b003:l002","ordinal":174603,"en":"As though they could rescue them,"},{"id":"semetey-1-2013:p1277:b003:l003","ordinal":174604,"en":"They all together"},{"id":"semetey-1-2013:p1277:b003:l004","ordinal":174605,"en":"Took refuge with Khan Toltoy."},{"id":"semetey-1-2013:p1277:b003:l005","ordinal":174606,"en":"Kulchoro raged,"},{"id":"semetey-1-2013:p1277:b003:l006","ordinal":174607,"en":"Darting in from the side;"},{"id":"semetey-1-2013:p1277:b003:l007","ordinal":174608,"en":"As though skewering tebetei hats,"},{"id":"semetey-1-2013:p1277:b003:l008","ordinal":174609,"en":"With the tip of his spear"},{"id":"semetey-1-2013:p1277:b003:l009","ordinal":174610,"en":"He whirled and flung them."},{"id":"semetey-1-2013:p1277:b003:l010","ordinal":174611,"en":"Crushing his golden face,"},{"id":"semetey-1-2013:p1277:b003:l011","ordinal":174612,"en":"He made ready like a lion,"},{"id":"semetey-1-2013:p1277:b003:l012","ordinal":174613,"en":"Hounding the foul Toltoy,"},{"id":"semetey-1-2013:p1277:b003:l013","ordinal":174614,"en":"Crushing seven hundred faces."},{"id":"semetey-1-2013:p1277:b003:l014","ordinal":174615,"en":"Kulchoro, fierce as an executioner,"},{"id":"semetey-1-2013:p1277:b003:l015","ordinal":174616,"en":"Hounded the raging Toltoy."},{"id":"semetey-1-2013:p1277:b003:l016","ordinal":174617,"en":"Toltoy, who killed those who grappled him—"},{"id":"semetey-1-2013:p1277:b003:l017","ordinal":174618,"en":"Kulchoro hounded that infidel."},{"id":"semetey-1-2013:p1277:b003:l018","ordinal":174619,"en":"Toltoy, who came to seize a wife—"},{"id":"semetey-1-2013:p1277:b003:l019","ordinal":174620,"en":"Kulchoro hounded that hero."},{"id":"semetey-1-2013:p1277:b003:l020","ordinal":174621,"en":"Toltoy, who drove the Jediger army—"},{"id":"semetey-1-2013:p1277:b003:l021","ordinal":174622,"en":"Kulchoro hounded that skillful man."},{"id":"semetey-1-2013:p1277:b003:l022","ordinal":174623,"en":"Toltoy, who took maidens as booty—"},{"id":"semetey-1-2013:p1277:b003:l023","ordinal":174624,"en":"Kulchoro hounded that mighty man."},{"id":"semetey-1-2013:p1277:b003:l024","ordinal":174625,"en":"Toltoy, who bore the Alengir bow and bronze arrow—"},{"id":"semetey-1-2013:p1277:b003:l025","ordinal":174626,"en":"Kulchoro hounded him."},{"id":"semetey-1-2013:p1277:b003:l026","ordinal":174627,"en":"Toltoy would not come to fight;"},{"id":"semetey-1-2013:p1277:b003:l027","ordinal":174628,"en":"He took refuge and hid."},{"id":"semetey-1-2013:p1277:b003:l028","ordinal":174629,"en":"Scattering the Jediger,"},{"id":"semetey-1-2013:p1277:b003:l029","ordinal":174630,"en":"Kulchoro raged"},{"id":"semetey-1-2013:p1277:b003:l030","ordinal":174631,"en":"And drove Khan Toltoy away."},{"id":"semetey-1-2013:p1277:b003:l031","ordinal":174632,"en":"His wits gone in confusion,"},{"id":"semetey-1-2013:p1277:b003:l032","ordinal":174633,"en":"Kulchoro hounded the panicked Toltoy."},{"id":"semetey-1-2013:p1277:b003:l033","ordinal":174634,"en":"Taking refuge worse than a woman,"},{"id":"semetey-1-2013:p1277:b003:l034","ordinal":174635,"en":"Kulchoro hounded the fleeing Toltoy."},{"id":"semetey-1-2013:p1277:b003:l035","ordinal":174636,"en":"Girding the jekene belt at his waist,"},{"id":"semetey-1-2013:p1277:b003:l036","ordinal":174637,"en":"He charged alone through"},{"id":"semetey-1-2013:p1277:b003:l037","ordinal":174638,"en":"The countless black Jediger."},{"id":"semetey-1-2013:p1277:b003:l038","ordinal":174639,"en":"Girding a white kise belt at his waist,"},{"id":"semetey-1-2013:p1277:b003:l039","ordinal":174640,"en":"The lion boy Kulchoro"},{"id":"semetey-1-2013:p1277:b004:l001","ordinal":174641,"en":"Attacked the countless black Jediger"},{"id":"semetey-1-2013:p1277:b004:l002","ordinal":174642,"en":"And threw them into turmoil."},{"id":"semetey-1-2013:p1277:b004:l003","ordinal":174643,"en":"His bulletproof mail shirt"},{"id":"semetey-1-2013:p1277:b004:l004","ordinal":174644,"en":"Showing upon his chest,"},{"id":"semetey-1-2013:p1277:b004:l005","ordinal":174645,"en":"The twelve-year-old Kulchoro—"},{"id":"semetey-1-2013:p1277:b004:l006","ordinal":174646,"en":"The Jediger host saw"},{"id":"semetey-1-2013:p1277:b004:l007","ordinal":174647,"en":"That he would destroy them."},{"id":"semetey-1-2013:p1277:b004:l008","ordinal":174648,"en":"Dust billowed into the sky;"},{"id":"semetey-1-2013:p1277:b004:l009","ordinal":174649,"en":"The great black Jediger"},{"id":"semetey-1-2013:p1277:b004:l010","ordinal":174650,"en":"All fled shrieking."},{"id":"semetey-1-2013:p1277:b004:l011","ordinal":174651,"en":"Noble Kulchoro"},{"id":"semetey-1-2013:p1277:b004:l012","ordinal":174652,"en":"Was an unmoving lion."},{"id":"semetey-1-2013:p1277:b004:l013","ordinal":174653,"en":"He was a hero who could slaughter"},{"id":"semetey-1-2013:p1277:b004:l014","ordinal":174654,"en":"Not merely the Jediger, but the whole age alone."},{"id":"semetey-1-2013:p1277:b004:l015","ordinal":174655,"en":"His father, blue-maned Almambet,"},{"id":"semetey-1-2013:p1277:b004:l016","ordinal":174656,"en":"Was a lion born surpassing all."},{"id":"semetey-1-2013:p1277:b004:l017","ordinal":174657,"en":"The horse he rode was gray;"},{"id":"semetey-1-2013:p1277:b004:l018","ordinal":174658,"en":"His fortunes were complete."},{"id":"semetey-1-2013:p1277:b004:l019","ordinal":174659,"en":"He was a lion born surpassing"},{"id":"semetey-1-2013:p1277:b004:l020","ordinal":174660,"en":"The lion prince Alman."},{"id":"semetey-1-2013:p1277:b004:l021","ordinal":174661,"en":"His turmoil reached the whole world."},{"id":"semetey-1-2013:p1277:b004:l022","ordinal":174662,"en":"When he went on campaign to Kakan,"},{"id":"semetey-1-2013:p1277:b004:l023","ordinal":174663,"en":"He had left in Aruuke's womb"},{"id":"semetey-1-2013:p1277:b004:l024","ordinal":174664,"en":"A fetus of three months."},{"id":"semetey-1-2013:p1277:b004:l025","ordinal":174665,"en":"Your blue-maned lord Alman"},{"id":"semetey-1-2013:p1277:b004:l026","ordinal":174666,"en":"Joined their hands"},{"id":"semetey-1-2013:p1277:b004:l027","ordinal":174667,"en":"And entrusted him to the lions,"},{"id":"semetey-1-2013:p1277:b004:l028","ordinal":174668,"en":"Saying, “Name him Choro.”"},{"id":"semetey-1-2013:p1277:b004:l029","ordinal":174669,"en":"Spring of the mountain pass,"},{"id":"semetey-1-2013:p1277:b004:l030","ordinal":174670,"en":"Driving the Jediger,"},{"id":"semetey-1-2013:p1277:b004:l031","ordinal":174671,"en":"He was Almambet's lamp."},{"id":"semetey-1-2013:p1277:b004:l032","ordinal":174672,"en":"He began the great slaughter;"},{"id":"semetey-1-2013:p1277:b004:l033","ordinal":174673,"en":"Fierce-born Kulchoro"},{"id":"semetey-1-2013:p1277:b004:l034","ordinal":174674,"en":"Slaughtered half"},{"id":"semetey-1-2013:p1277:b004:l035","ordinal":174675,"en":"The great black Jediger."},{"id":"semetey-1-2013:p1277:b004:l036","ordinal":174676,"en":"Raging and shouting,"},{"id":"semetey-1-2013:p1277:b004:l037","ordinal":174677,"en":"Khan Toltoy's great army—"},{"id":"semetey-1-2013:p1277:b004:l038","ordinal":174678,"en":"To Jangyryk's Jar-Kyya,"},{"id":"semetey-1-2013:p1277:b004:l039","ordinal":174679,"en":"In a single-file stream of horses,"},{"id":"semetey-1-2013:p1278:b003:l001","ordinal":174680,"en":"He drove them all together and crushed them."},{"id":"semetey-1-2013:p1278:b003:l002","ordinal":174681,"en":"The Jediger army gave way;"},{"id":"semetey-1-2013:p1278:b003:l003","ordinal":174682,"en":"The raging Kulchoro"},{"id":"semetey-1-2013:p1278:b003:l004","ordinal":174683,"en":"Drove and chased"},{"id":"semetey-1-2013:p1278:b003:l005","ordinal":174684,"en":"The countless Jediger host"},{"id":"semetey-1-2013:p1278:b003:l006","ordinal":174685,"en":"And packed them into Jar-Kyya."},{"id":"semetey-1-2013:p1278:b003:l007","ordinal":174686,"en":"The young prince Kulchoro—"},{"id":"semetey-1-2013:p1278:b003:l008","ordinal":174687,"en":"As he drove the Jediger,"},{"id":"semetey-1-2013:p1278:b003:l009","ordinal":174688,"en":"Their tusks jutting out,"},{"id":"semetey-1-2013:p1278:b003:l010","ordinal":174689,"en":"The horse corpses formed a mountain."},{"id":"semetey-1-2013:p1278:b003:l011","ordinal":174690,"en":"Their mustaches drooping,"},{"id":"semetey-1-2013:p1278:b003:l012","ordinal":174691,"en":"The warriors' corpses formed a heap."},{"id":"semetey-1-2013:p1278:b003:l013","ordinal":174692,"en":"Raging, he shouted;"},{"id":"semetey-1-2013:p1278:b003:l014","ordinal":174693,"en":"The great black Jediger"},{"id":"semetey-1-2013:p1278:b003:l015","ordinal":174694,"en":"Struck back and scattered."},{"id":"semetey-1-2013:p1278:b003:l016","ordinal":174695,"en":"From fear, the Jediger"},{"id":"semetey-1-2013:p1278:b003:l017","ordinal":174696,"en":"Split into many different groups;"},{"id":"semetey-1-2013:p1278:b003:l018","ordinal":174697,"en":"Those whose deaths had come"},{"id":"semetey-1-2013:p1278:b003:l019","ordinal":174698,"en":"Spilled their blood upon the plain."},{"id":"semetey-1-2013:p1278:b003:l020","ordinal":174699,"en":"Let us leave that there"},{"id":"semetey-1-2013:p1278:b003:l021","ordinal":174700,"en":"And begin from this side:"},{"id":"semetey-1-2013:p1278:b003:l022","ordinal":174701,"en":"Kulchoro of Almambet,"},{"id":"semetey-1-2013:p1278:b003:l023","ordinal":174702,"en":"Baitaylak of Khan Bakai,"},{"id":"semetey-1-2013:p1278:b003:l024","ordinal":174703,"en":"Kalyk of Sary Khan,"},{"id":"semetey-1-2013:p1278:b003:l025","ordinal":174704,"en":"Shayyymbet of Jamgyrchy—"},{"id":"semetey-1-2013:p1278:b003:l026","ordinal":174705,"en":"All were khans' sons."},{"id":"semetey-1-2013:p1278:b003:l027","ordinal":174706,"en":"Raising the white standard as their banner,"},{"id":"semetey-1-2013:p1278:b003:l028","ordinal":174707,"en":"Raising a clamorous battle cry,"},{"id":"semetey-1-2013:p1278:b003:l029","ordinal":174708,"en":"The blue-maned lions now charged"},{"id":"semetey-1-2013:p1278:b003:l030","ordinal":174709,"en":"Into brave Töshtük's army,"},{"id":"semetey-1-2013:p1278:b003:l031","ordinal":174710,"en":"Onto the road where slaughter would come."},{"id":"semetey-1-2013:p1278:b003:l032","ordinal":174711,"en":"Standing face to face,"},{"id":"semetey-1-2013:p1278:b003:l033","ordinal":174712,"en":"Firing guns and drawing bows,"},{"id":"semetey-1-2013:p1278:b003:l034","ordinal":174713,"en":"They fought with snarling fury."},{"id":"semetey-1-2013:p1278:b003:l035","ordinal":174714,"en":"The heroes grappled in battle,"},{"id":"semetey-1-2013:p1278:b003:l036","ordinal":174715,"en":"Driving birchwood spears"},{"id":"semetey-1-2013:p1278:b003:l037","ordinal":174716,"en":"Into the very heart."},{"id":"semetey-1-2013:p1278:b003:l038","ordinal":174717,"en":"The living suffered humiliation;"},{"id":"semetey-1-2013:p1278:b003:l039","ordinal":174718,"en":"Those whose deaths had come died."},{"id":"semetey-1-2013:p1278:b004:l001","ordinal":174719,"en":"The sword-bearing Jediger"},{"id":"semetey-1-2013:p1278:b004:l002","ordinal":174720,"en":"Fought with scabbards and all;"},{"id":"semetey-1-2013:p1278:b004:l003","ordinal":174721,"en":"The battle-ax-bearing Jediger"},{"id":"semetey-1-2013:p1278:b004:l004","ordinal":174722,"en":"Fought with whatever they had."},{"id":"semetey-1-2013:p1278:b004:l005","ordinal":174723,"en":"Brave Toltoy of the Jediger"},{"id":"semetey-1-2013:p1278:b004:l006","ordinal":174724,"en":"Began battle early."},{"id":"semetey-1-2013:p1278:b004:l007","ordinal":174725,"en":"What could dear Tölök do?"},{"id":"semetey-1-2013:p1278:b004:l008","ordinal":174726,"en":"Raising the white standard as his banner,"},{"id":"semetey-1-2013:p1278:b004:l009","ordinal":174727,"en":"Crying “Aziret!” and raising a clamor,"},{"id":"semetey-1-2013:p1278:b004:l010","ordinal":174728,"en":"Arrows from bows shrieked;"},{"id":"semetey-1-2013:p1278:b004:l011","ordinal":174729,"en":"Bullets from short guns clattered."},{"id":"semetey-1-2013:p1278:b004:l012","ordinal":174730,"en":"Spear points clashed;"},{"id":"semetey-1-2013:p1278:b004:l013","ordinal":174731,"en":"They raised a raiding clamor;"},{"id":"semetey-1-2013:p1278:b004:l014","ordinal":174732,"en":"The warriors' heads knocked together."},{"id":"semetey-1-2013:p1278:b004:l015","ordinal":174733,"en":"They fought face to face,"},{"id":"semetey-1-2013:p1278:b004:l016","ordinal":174734,"en":"Standing pressed against one another."},{"id":"semetey-1-2013:p1278:b004:l017","ordinal":174735,"en":"They stared each other down and fought long,"},{"id":"semetey-1-2013:p1278:b004:l018","ordinal":174736,"en":"Wrestling with battle cries;"},{"id":"semetey-1-2013:p1278:b004:l019","ordinal":174737,"en":"Those fated to die died."},{"id":"semetey-1-2013:p1278:b004:l020","ordinal":174738,"en":"They confronted each other face to face,"},{"id":"semetey-1-2013:p1278:b004:l021","ordinal":174739,"en":"Standing and straining hard,"},{"id":"semetey-1-2013:p1278:b004:l022","ordinal":174740,"en":"Fighting beyond mortal measure."},{"id":"semetey-1-2013:p1278:b004:l023","ordinal":174741,"en":"Tölöbay, son of Tölök,"},{"id":"semetey-1-2013:p1278:b004:l024","ordinal":174742,"en":"Charged with a shout from the flank,"},{"id":"semetey-1-2013:p1278:b004:l025","ordinal":174743,"en":"Raising the battle cry of Khan Kozho."},{"id":"semetey-1-2013:p1278:b004:l026","ordinal":174744,"en":"The most skillful with the battle-ax—"},{"id":"semetey-1-2013:p1278:b004:l027","ordinal":174745,"en":"Such was Tölöbay,"},{"id":"semetey-1-2013:p1278:b004:l028","ordinal":174746,"en":"The finest of the gray youths."},{"id":"semetey-1-2013:p1278:b004:l029","ordinal":174747,"en":"Renowned for striking with the battle-ax,"},{"id":"semetey-1-2013:p1278:b004:l030","ordinal":174748,"en":"Skillful at striking with the whip,"},{"id":"semetey-1-2013:p1278:b004:l031","ordinal":174749,"en":"The finest among so many,"},{"id":"semetey-1-2013:p1278:b004:l032","ordinal":174750,"en":"With dust billowing into the sky,"},{"id":"semetey-1-2013:p1278:b004:l033","ordinal":174751,"en":"Crying Toltoy's battle cry,"},{"id":"semetey-1-2013:p1278:b004:l034","ordinal":174752,"en":"Tölöbay charged shrieking."},{"id":"semetey-1-2013:p1278:b004:l035","ordinal":174753,"en":"Riding only dun-gray horses,"},{"id":"semetey-1-2013:p1278:b004:l036","ordinal":174754,"en":"Wearing bulletproof coats,"},{"id":"semetey-1-2013:p1278:b004:l037","ordinal":174755,"en":"Raging and seething,"},{"id":"semetey-1-2013:p1278:b004:l038","ordinal":174756,"en":"Tölöbay's great army"},{"id":"semetey-1-2013:p1278:b004:l039","ordinal":174757,"en":"Engulfed Afghanistan, shrieking,"},{"id":"semetey-1-2013:p1279:b003:l001","ordinal":174758,"en":"Just as they were about to surge over them,"},{"id":"semetey-1-2013:p1279:b003:l002","ordinal":174759,"en":"Upon one flank of the Jediger,"},{"id":"semetey-1-2013:p1279:b003:l003","ordinal":174760,"en":"About to reach their root together,"},{"id":"semetey-1-2013:p1279:b003:l004","ordinal":174761,"en":"About to slaughter their champions,"},{"id":"semetey-1-2013:p1279:b003:l005","ordinal":174762,"en":"And take their daughters as tribute,"},{"id":"semetey-1-2013:p1279:b003:l006","ordinal":174763,"en":"When they had drawn near the city,"},{"id":"semetey-1-2013:p1279:b003:l007","ordinal":174764,"en":"Tümönbay, son of Tülkü,"},{"id":"semetey-1-2013:p1279:b003:l008","ordinal":174765,"en":"Leading many formations of troops,"},{"id":"semetey-1-2013:p1279:b003:l009","ordinal":174766,"en":"Mounted a black-blazed argamak"},{"id":"semetey-1-2013:p1279:b003:l010","ordinal":174767,"en":"And strained for battle,"},{"id":"semetey-1-2013:p1279:b003:l011","ordinal":174768,"en":"Praying to the Almighty,"},{"id":"semetey-1-2013:p1279:b003:l012","ordinal":174769,"en":"His wrapped turban wound around him."},{"id":"semetey-1-2013:p1279:b003:l013","ordinal":174770,"en":"The brass horn shrilled,"},{"id":"semetey-1-2013:p1279:b003:l014","ordinal":174771,"en":"The drum boomed,"},{"id":"semetey-1-2013:p1279:b003:l015","ordinal":174772,"en":"The surnai clattered,"},{"id":"semetey-1-2013:p1279:b003:l016","ordinal":174773,"en":"And spear points flashed."},{"id":"semetey-1-2013:p1279:b003:l017","ordinal":174774,"en":"Tümönbay, son of Tülkü,"},{"id":"semetey-1-2013:p1279:b003:l018","ordinal":174775,"en":"Raised the patterned spear"},{"id":"semetey-1-2013:p1279:b003:l019","ordinal":174776,"en":"And faced Tölöbay,"},{"id":"semetey-1-2013:p1279:b003:l020","ordinal":174777,"en":"Making his argamak prance,"},{"id":"semetey-1-2013:p1279:b003:l021","ordinal":174778,"en":"His blue skullcap perched high."},{"id":"semetey-1-2013:p1279:b003:l022","ordinal":174779,"en":"Reckless and pounding in the chest,"},{"id":"semetey-1-2013:p1279:b003:l023","ordinal":174780,"en":"Proud and thundering in the lungs,"},{"id":"semetey-1-2013:p1279:b003:l024","ordinal":174781,"en":"Weak in command but himself a hero,"},{"id":"semetey-1-2013:p1279:b003:l025","ordinal":174782,"en":"He faced Tölöbay;"},{"id":"semetey-1-2013:p1279:b003:l026","ordinal":174783,"en":"That was where slaughter began."},{"id":"semetey-1-2013:p1279:b003:l027","ordinal":174784,"en":"Afghan and Jediger"},{"id":"semetey-1-2013:p1279:b003:l028","ordinal":174785,"en":"Met face to face"},{"id":"semetey-1-2013:p1279:b003:l029","ordinal":174786,"en":"And fought beyond mortal measure."},{"id":"semetey-1-2013:p1279:b003:l030","ordinal":174787,"en":"Spears struck and horses died;"},{"id":"semetey-1-2013:p1279:b003:l031","ordinal":174788,"en":"Brave men quickly died."},{"id":"semetey-1-2013:p1279:b003:l032","ordinal":174789,"en":"They stood slaughtering one another"},{"id":"semetey-1-2013:p1279:b003:l033","ordinal":174790,"en":"And fought with terrible fury."},{"id":"semetey-1-2013:p1279:b003:l034","ordinal":174791,"en":"Straining against one another,"},{"id":"semetey-1-2013:p1279:b003:l035","ordinal":174792,"en":"Firing guns and drawing bows,"},{"id":"semetey-1-2013:p1279:b003:l036","ordinal":174793,"en":"They fought with crashing blows."},{"id":"semetey-1-2013:p1279:b003:l037","ordinal":174794,"en":"Mounting stallions from the tethering line,"},{"id":"semetey-1-2013:p1279:b003:l038","ordinal":174795,"en":"Taking poles up from the ground,"},{"id":"semetey-1-2013:p1279:b003:l039","ordinal":174796,"en":"Shouting, “Japyrim!” as they fought—"},{"id":"semetey-1-2013:p1279:b004:l001","ordinal":174797,"en":"Now it became a terrible battle."},{"id":"semetey-1-2013:p1279:b004:l002","ordinal":174798,"en":"They fought with spears;"},{"id":"semetey-1-2013:p1279:b004:l003","ordinal":174799,"en":"Those who came especially close"},{"id":"semetey-1-2013:p1279:b004:l004","ordinal":174800,"en":"Seized each other by the collar."},{"id":"semetey-1-2013:p1279:b004:l005","ordinal":174801,"en":"Keeping the battle in mind,"},{"id":"semetey-1-2013:p1279:b004:l006","ordinal":174802,"en":"They fought in utter confusion;"},{"id":"semetey-1-2013:p1279:b004:l007","ordinal":174803,"en":"When one looked, the eye could distinguish nothing."},{"id":"semetey-1-2013:p1279:b004:l008","ordinal":174804,"en":"The tumultuous battle grew immense,"},{"id":"semetey-1-2013:p1279:b004:l009","ordinal":174805,"en":"And no one could tell which side was which."},{"id":"semetey-1-2013:p1279:b004:l010","ordinal":174806,"en":"Many more stood devising plans"},{"id":"semetey-1-2013:p1279:b004:l011","ordinal":174807,"en":"And pondering words."},{"id":"semetey-1-2013:p1279:b004:l012","ordinal":174808,"en":"“Ah, wicked Aychürök,"},{"id":"semetey-1-2013:p1279:b004:l013","ordinal":174809,"en":"Until she grew old she took no husband;"},{"id":"semetey-1-2013:p1279:b004:l014","ordinal":174810,"en":"She understood none of the words spoken,"},{"id":"semetey-1-2013:p1279:b004:l015","ordinal":174811,"en":"And roamed without marrying a man;"},{"id":"semetey-1-2013:p1279:b004:l016","ordinal":174812,"en":"She never ceased stirring corruption!”"},{"id":"semetey-1-2013:p1279:b004:l017","ordinal":174813,"en":"Many more went about reviling her."},{"id":"semetey-1-2013:p1279:b004:l018","ordinal":174814,"en":"Many more stood brandishing spears"},{"id":"semetey-1-2013:p1279:b004:l019","ordinal":174815,"en":"And swaggering."},{"id":"semetey-1-2013:p1279:b004:l020","ordinal":174816,"en":"Saying, “She truly is shameless,”"},{"id":"semetey-1-2013:p1279:b004:l021","ordinal":174817,"en":"The great host and Aychürök—"},{"id":"semetey-1-2013:p1279:b004:l022","ordinal":174818,"en":"Many more fought over her."},{"id":"semetey-1-2013:p1279:b004:l023","ordinal":174819,"en":"“Since it was the khan's command,"},{"id":"semetey-1-2013:p1279:b004:l024","ordinal":174820,"en":"How could we refuse to fight?”"},{"id":"semetey-1-2013:p1279:b004:l025","ordinal":174821,"en":"So saying and exhorting one another,"},{"id":"semetey-1-2013:p1279:b004:l026","ordinal":174822,"en":"Many more strove in battle."},{"id":"semetey-1-2013:p1279:b004:l027","ordinal":174823,"en":"Black and blue, born of the same mother,"},{"id":"semetey-1-2013:p1279:b004:l028","ordinal":174824,"en":"Sparing not their mortal lives,"},{"id":"semetey-1-2013:p1279:b004:l029","ordinal":174825,"en":"Many more exchanged fire."},{"id":"semetey-1-2013:p1279:b004:l030","ordinal":174826,"en":"“If we die, so be it—we trust in fate,”"},{"id":"semetey-1-2013:p1279:b004:l031","ordinal":174827,"en":"So saying and fighting,"},{"id":"semetey-1-2013:p1279:b004:l032","ordinal":174828,"en":"Many more exchanged blows."},{"id":"semetey-1-2013:p1279:b004:l033","ordinal":174829,"en":"Those without spears"},{"id":"semetey-1-2013:p1279:b004:l034","ordinal":174830,"en":"Found other means in great numbers;"},{"id":"semetey-1-2013:p1279:b004:l035","ordinal":174831,"en":"With whips, one another"},{"id":"semetey-1-2013:p1279:b004:l036","ordinal":174832,"en":"Many more struck."},{"id":"semetey-1-2013:p1279:b004:l037","ordinal":174833,"en":"Bracing knee against knee and driving forward,"},{"id":"semetey-1-2013:p1279:b004:l038","ordinal":174834,"en":"Many more clashed."},{"id":"semetey-1-2013:p1279:b004:l039","ordinal":174835,"en":"The elders of Jediger and Afghanistan,"},{"id":"semetey-1-2013:p1280:b003:l001","ordinal":174836,"en":"All had become slaughter;"},{"id":"semetey-1-2013:p1280:b003:l002","ordinal":174837,"en":"The common people gathered,"},{"id":"semetey-1-2013:p1280:b003:l003","ordinal":174838,"en":"And in the clashing battle"},{"id":"semetey-1-2013:p1280:b003:l004","ordinal":174839,"en":"How many people were killed."},{"id":"semetey-1-2013:p1280:b003:l005","ordinal":174840,"en":"Meek men and cruel men died;"},{"id":"semetey-1-2013:p1280:b003:l006","ordinal":174841,"en":"In the upheaval that arose,"},{"id":"semetey-1-2013:p1280:b003:l007","ordinal":174842,"en":"How many people died together."},{"id":"semetey-1-2013:p1280:b003:l008","ordinal":174843,"en":"Those who survived without dying"},{"id":"semetey-1-2013:p1280:b003:l009","ordinal":174844,"en":"Staggered about wounded,"},{"id":"semetey-1-2013:p1280:b003:l010","ordinal":174845,"en":"The two fronts of their coats flapping;"},{"id":"semetey-1-2013:p1280:b003:l011","ordinal":174846,"en":"All their robes were torn,"},{"id":"semetey-1-2013:p1280:b003:l012","ordinal":174847,"en":"All the heroes hard-pressed,"},{"id":"semetey-1-2013:p1280:b003:l013","ordinal":174848,"en":"And all the people thrown into disorder."}]
