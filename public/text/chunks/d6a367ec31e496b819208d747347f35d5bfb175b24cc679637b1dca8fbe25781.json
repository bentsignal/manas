[{"id":"manas-2010:p1691:b001:l025","ordinal":72705,"en":"The Chinese upon my flank,"},{"id":"manas-2010:p1691:b001:l026","ordinal":72706,"en":"When I was slaughtering them,"},{"id":"manas-2010:p1691:b001:l027","ordinal":72707,"en":"Turning Beijing back without flinching,"},{"id":"manas-2010:p1691:b001:l028","ordinal":72708,"en":"Damn it, how shall I turn back now,"},{"id":"manas-2010:p1691:b001:l029","ordinal":72709,"en":"Bereft of the champions,"},{"id":"manas-2010:p1691:b001:l030","ordinal":72710,"en":"Almambet and Chubak, their names paired?"},{"id":"manas-2010:p1691:b001:l031","ordinal":72711,"en":"Against Beijing untouched even by holy Ali,"},{"id":"manas-2010:p1691:b001:l032","ordinal":72712,"en":"Did I think my strength would suffice?"},{"id":"manas-2010:p1691:b001:l033","ordinal":72713,"en":"Fighting here,"},{"id":"manas-2010:p1691:b001:l034","ordinal":72714,"en":"Bereft of the lions,"},{"id":"manas-2010:p1691:b001:l035","ordinal":72715,"en":"Did I think I would leave alive?"},{"id":"manas-2010:p1691:b001:l036","ordinal":72716,"en":"O God, you made me a lion who slaughtered unbelievers;"},{"id":"manas-2010:p1691:b001:l037","ordinal":72717,"en":"Taking dear Alma from me,"},{"id":"manas-2010:p1691:b001:l038","ordinal":72718,"en":"God, why have you diminished me so greatly?"},{"id":"manas-2010:p1691:b001:l039","ordinal":72719,"en":"Load on the burden of endurance,"},{"id":"manas-2010:p1691:b001:l040","ordinal":72720,"en":"Merciless, deceitful world;"},{"id":"manas-2010:p1691:b001:l041","ordinal":72721,"en":"Now take back the life you entrusted."},{"id":"manas-2010:p1691:b001:l042","ordinal":72722,"en":"From Beijing with its forbidding cliffs,"},{"id":"manas-2010:p1692:b001:l001","ordinal":72723,"en":"If I ride the red horse, I shall pass through;"},{"id":"manas-2010:p1692:b001:l002","ordinal":72724,"en":"Bereft of the heroes,"},{"id":"manas-2010:p1692:b001:l003","ordinal":72725,"en":"How can I leave alone now?"},{"id":"manas-2010:p1692:b001:l004","ordinal":72726,"en":"In the hills, white-headed horses,"},{"id":"manas-2010:p1692:b001:l005","ordinal":72727,"en":"Thoroughbreds and noble steeds together;"},{"id":"manas-2010:p1692:b001:l006","ordinal":72728,"en":"The one who would gather them,"},{"id":"manas-2010:p1692:b001:l007","ordinal":72729,"en":"My son left behind, is young."},{"id":"manas-2010:p1692:b001:l008","ordinal":72730,"en":"Do not leave me helpless and alone;"},{"id":"manas-2010:p1692:b001:l009","ordinal":72731,"en":"Almambet, Chubak, take me with you."},{"id":"manas-2010:p1692:b001:l010","ordinal":72732,"en":"Bereft of Akkula,"},{"id":"manas-2010:p1692:b001:l011","ordinal":72733,"en":"I stand helpless on foot."},{"id":"manas-2010:p1692:b001:l012","ordinal":72734,"en":"My brothers Almambet and Chubak are gone;"},{"id":"manas-2010:p1692:b001:l013","ordinal":72735,"en":"What can I possibly do now?!”"},{"id":"manas-2010:p1692:b001:l014","ordinal":72736,"en":"As he stood in fury,"},{"id":"manas-2010:p1692:b001:l015","ordinal":72737,"en":"What twelve ages had never brought,"},{"id":"manas-2010:p1692:b001:l016","ordinal":72738,"en":"At that moment, upon the Generous One—"},{"id":"manas-2010:p1692:b001:l017","ordinal":72739,"en":"No one remained to rein him in."},{"id":"manas-2010:p1692:b001:l018","ordinal":72740,"en":"At that moment, your Generous One"},{"id":"manas-2010:p1692:b001:l019","ordinal":72741,"en":"Came forth in fury."},{"id":"manas-2010:p1692:b001:l020","ordinal":72742,"en":"When slung, the mirror of his shoulder,"},{"id":"manas-2010:p1692:b001:l021","ordinal":72743,"en":"When fired once at a contending foe,"},{"id":"manas-2010:p1692:b001:l022","ordinal":72744,"en":"The dear support of life held in trust."},{"id":"manas-2010:p1692:b001:l023","ordinal":72745,"en":"Earlier, my prince, leopard Manas,"},{"id":"manas-2010:p1692:b001:l024","ordinal":72746,"en":"His fortune in Altay,"},{"id":"manas-2010:p1692:b001:l025","ordinal":72747,"en":"When it was setting forth,"},{"id":"manas-2010:p1692:b001:l026","ordinal":72748,"en":"His mother Chyyrdy,"},{"id":"manas-2010:p1692:b001:l027","ordinal":72749,"en":"When she was giving birth,"},{"id":"manas-2010:p1692:b001:l028","ordinal":72750,"en":"In the travail God had made,"},{"id":"manas-2010:p1692:b001:l029","ordinal":72751,"en":"Before the elder wife"},{"id":"manas-2010:p1692:b001:l030","ordinal":72752,"en":"There had come then"},{"id":"manas-2010:p1692:b001:l031","ordinal":72753,"en":"A white-bearded wandering holy man."},{"id":"manas-2010:p1692:b001:l032","ordinal":72754,"en":"“Elder wife, heed my words,” he said."},{"id":"manas-2010:p1692:b001:l033","ordinal":72755,"en":"“This child is a lion."},{"id":"manas-2010:p1692:b001:l034","ordinal":72756,"en":"When he reaches twelve years,"},{"id":"manas-2010:p1692:b001:l035","ordinal":72757,"en":"Entrust this to him,” he said,"},{"id":"manas-2010:p1692:b001:l036","ordinal":72758,"en":"And gave a steel bullet then."},{"id":"manas-2010:p1692:b001:l037","ordinal":72759,"en":"“When his dear, proudly upright back"},{"id":"manas-2010:p1692:b001:l038","ordinal":72760,"en":"Bends, let him fire it."},{"id":"manas-2010:p1692:b001:l039","ordinal":72761,"en":"When his poor head, shaped like an apple,"},{"id":"manas-2010:p1692:b001:l040","ordinal":72762,"en":"Comes under strain, let him fire it."},{"id":"manas-2010:p1692:b001:l041","ordinal":72763,"en":"Despairing of his life held in trust,"},{"id":"manas-2010:p1692:b001:l042","ordinal":72764,"en":"When he is weary, let him fire it."},{"id":"manas-2010:p1693:b001:l001","ordinal":72765,"en":"Those whose fathers are utter unbelievers,"},{"id":"manas-2010:p1693:b001:l002","ordinal":72766,"en":"When they besiege him, let him fire it.”"},{"id":"manas-2010:p1693:b001:l003","ordinal":72767,"en":"At his birth, he touched it to his mouth."},{"id":"manas-2010:p1693:b001:l004","ordinal":72768,"en":"Your formidable mother Chyyrdy"},{"id":"manas-2010:p1693:b001:l005","ordinal":72769,"en":"And Kanykey, joining together,"},{"id":"manas-2010:p1693:b001:l006","ordinal":72770,"en":"Had hidden that bullet,"},{"id":"manas-2010:p1693:b001:l007","ordinal":72771,"en":"Sewing it into Akolpok's collar."},{"id":"manas-2010:p1693:b001:l008","ordinal":72772,"en":"Clutching his collar in anguish,"},{"id":"manas-2010:p1693:b001:l009","ordinal":72773,"en":"As that fierce-maned one stood,"},{"id":"manas-2010:p1693:b001:l010","ordinal":72774,"en":"He grieved, thinking of Almambet."},{"id":"manas-2010:p1693:b001:l011","ordinal":72775,"en":"The single bullet sewn in the collar"},{"id":"manas-2010:p1693:b001:l012","ordinal":72776,"en":"Caught his hand like a button."},{"id":"manas-2010:p1693:b001:l013","ordinal":72777,"en":"When the bullet touched his hand,"},{"id":"manas-2010:p1693:b001:l014","ordinal":72778,"en":"The leopard tore the stitches open at once."},{"id":"manas-2010:p1693:b001:l015","ordinal":72779,"en":"Half a charge of fine-shooting powder,"},{"id":"manas-2010:p1693:b001:l016","ordinal":72780,"en":"Into Akkelte's mouth the leopard"},{"id":"manas-2010:p1693:b001:l017","ordinal":72781,"en":"Poured from the powder flask."},{"id":"manas-2010:p1693:b001:l018","ordinal":72782,"en":"That sacred steel bullet"},{"id":"manas-2010:p1693:b001:l019","ordinal":72783,"en":"He rammed in with a rumble."},{"id":"manas-2010:p1693:b001:l020","ordinal":72784,"en":"The finely made telescope"},{"id":"manas-2010:p1693:b001:l021","ordinal":72785,"en":"He turned seven times."},{"id":"manas-2010:p1693:b001:l022","ordinal":72786,"en":"“See where it reaches,” he said;"},{"id":"manas-2010:p1693:b001:l023","ordinal":72787,"en":"The king aimed at seven rope-lengths."},{"id":"manas-2010:p1693:b001:l024","ordinal":72788,"en":"“Trust in God!” he said, the telescope"},{"id":"manas-2010:p1693:b001:l025","ordinal":72789,"en":"Turning ten times."},{"id":"manas-2010:p1693:b001:l026","ordinal":72790,"en":"“See the place you face,” he said,"},{"id":"manas-2010:p1693:b001:l027","ordinal":72791,"en":"Aiming at ten rope-lengths."},{"id":"manas-2010:p1693:b001:l028","ordinal":72792,"en":"The dear lord, the leopard,"},{"id":"manas-2010:p1693:b001:l029","ordinal":72793,"en":"Bound it again, fitting it close."},{"id":"manas-2010:p1693:b001:l030","ordinal":72794,"en":"That great telescope,"},{"id":"manas-2010:p1693:b001:l031","ordinal":72795,"en":"On top of Akkelte,"},{"id":"manas-2010:p1693:b001:l032","ordinal":72796,"en":"He bound and fastened together."},{"id":"manas-2010:p1693:b001:l033","ordinal":72797,"en":"Your noble lord, the goshawk,"},{"id":"manas-2010:p1693:b001:l034","ordinal":72798,"en":"Took Akkelte in his hand."},{"id":"manas-2010:p1693:b001:l035","ordinal":72799,"en":"A black rock like a saddle-shaped ridge,"},{"id":"manas-2010:p1693:b001:l036","ordinal":72800,"en":"Your king patiently took hold of,"},{"id":"manas-2010:p1693:b001:l037","ordinal":72801,"en":"And rested it upon it then."},{"id":"manas-2010:p1693:b001:l038","ordinal":72802,"en":"Pointing into the haze,"},{"id":"manas-2010:p1693:b001:l039","ordinal":72803,"en":"Dim and angular,"},{"id":"manas-2010:p1693:b001:l040","ordinal":72804,"en":"Of the unblessed black unbelievers"},{"id":"manas-2010:p1693:b001:l041","ordinal":72805,"en":"He caught sight of a corner,"},{"id":"manas-2010:p1693:b001:l042","ordinal":72806,"en":"Seething like ants."},{"id":"manas-2010:p1694:b001:l001","ordinal":72807,"en":"The surrounding black unbelievers'"},{"id":"manas-2010:p1694:b001:l002","ordinal":72808,"en":"People he now saw."},{"id":"manas-2010:p1694:b001:l003","ordinal":72809,"en":"The earth had turned to dust;"},{"id":"manas-2010:p1694:b001:l004","ordinal":72810,"en":"Receiving word from their khan,"},{"id":"manas-2010:p1694:b001:l005","ordinal":72811,"en":"Ninety Beijings had risen."},{"id":"manas-2010:p1694:b001:l006","ordinal":72812,"en":"There were many remarkable men;"},{"id":"manas-2010:p1694:b001:l007","ordinal":72813,"en":"Raging and boasting,"},{"id":"manas-2010:p1694:b001:l008","ordinal":72814,"en":"The swine Kojozhash had become khan in Beijing."},{"id":"manas-2010:p1694:b001:l009","ordinal":72815,"en":"The proud black unbelievers'"},{"id":"manas-2010:p1694:b001:l010","ordinal":72816,"en":"Lords he had gathered."},{"id":"manas-2010:p1694:b001:l011","ordinal":72817,"en":"Their champions, the Fierce One and Kojozhash,"},{"id":"manas-2010:p1694:b001:l012","ordinal":72818,"en":"Nine khans in all,"},{"id":"manas-2010:p1694:b001:l013","ordinal":72819,"en":"The unbelievers lay boasting."},{"id":"manas-2010:p1694:b001:l014","ordinal":72820,"en":"Before Chynchy Khan, Kojozhash"},{"id":"manas-2010:p1694:b001:l015","ordinal":72821,"en":"Boasted mightily:"},{"id":"manas-2010:p1694:b001:l016","ordinal":72822,"en":"“There is no ship upon the dark water."},{"id":"manas-2010:p1694:b001:l017","ordinal":72823,"en":"Chinese, as long as my dear head lives,"},{"id":"manas-2010:p1694:b001:l018","ordinal":72824,"en":"No one can resist you."},{"id":"manas-2010:p1694:b001:l019","ordinal":72825,"en":"There is no lord but me."},{"id":"manas-2010:p1694:b001:l020","ordinal":72826,"en":"When battle brought slaughter,"},{"id":"manas-2010:p1694:b001:l021","ordinal":72827,"en":"I overthrew the Burut's Almambet."},{"id":"manas-2010:p1694:b001:l022","ordinal":72828,"en":"Akbaltay's Chubak,"},{"id":"manas-2010:p1694:b001:l023","ordinal":72829,"en":"That roaring reckless one,"},{"id":"manas-2010:p1694:b001:l024","ordinal":72830,"en":"I cast out from this Beijing."},{"id":"manas-2010:p1694:b001:l025","ordinal":72831,"en":"When my fury truly rose,"},{"id":"manas-2010:p1694:b001:l026","ordinal":72832,"en":"I forged steel into a bullet;"},{"id":"manas-2010:p1694:b001:l027","ordinal":72833,"en":"The brim of the black felt hat"},{"id":"manas-2010:p1694:b001:l028","ordinal":72834,"en":"I erased from this Beijing."},{"id":"manas-2010:p1694:b001:l029","ordinal":72835,"en":"The worthless ones without courage"},{"id":"manas-2010:p1694:b001:l030","ordinal":72836,"en":"I captured alive."},{"id":"manas-2010:p1694:b001:l031","ordinal":72837,"en":"When they provoked my anger,"},{"id":"manas-2010:p1694:b001:l032","ordinal":72838,"en":"Of Khan Manas's forty companions,"},{"id":"manas-2010:p1694:b001:l033","ordinal":72839,"en":"I slew twelve."},{"id":"manas-2010:p1694:b001:l034","ordinal":72840,"en":"The wishes of the living Burut"},{"id":"manas-2010:p1694:b001:l035","ordinal":72841,"en":"I have ruined like this."},{"id":"manas-2010:p1694:b001:l036","ordinal":72842,"en":"Their khan Manas himself"},{"id":"manas-2010:p1694:b001:l037","ordinal":72843,"en":"I made howl upon the ridge."},{"id":"manas-2010:p1694:b001:l038","ordinal":72844,"en":"Those who defied me"},{"id":"manas-2010:p1694:b001:l039","ordinal":72845,"en":"I simply destroyed like this."},{"id":"manas-2010:p1694:b001:l040","ordinal":72846,"en":"The shameless soul who still lives"},{"id":"manas-2010:p1694:b001:l041","ordinal":72847,"en":"Strains on, thinking he will not die."},{"id":"manas-2010:p1694:b001:l042","ordinal":72848,"en":"Wounded, fierce-maned Manas's"},{"id":"manas-2010:p1695:b001:l001","ordinal":72849,"en":"Horse I shot down."},{"id":"manas-2010:p1695:b001:l002","ordinal":72850,"en":"Now alone, where can he escape?"},{"id":"manas-2010:p1695:b001:l003","ordinal":72851,"en":"Their wounded Sultan Manas,"},{"id":"manas-2010:p1695:b001:l004","ordinal":72852,"en":"Let us swarm and seize him."},{"id":"manas-2010:p1695:b001:l005","ordinal":72853,"en":"The medicine called Üpü,"},{"id":"manas-2010:p1695:b001:l006","ordinal":72854,"en":"Let us put it upon his wound."},{"id":"manas-2010:p1695:b001:l007","ordinal":72855,"en":"By whatever means, Manas"},{"id":"manas-2010:p1695:b001:l008","ordinal":72856,"en":"Let us heal."},{"id":"manas-2010:p1695:b001:l009","ordinal":72857,"en":"Without killing or losing him,"},{"id":"manas-2010:p1695:b001:l010","ordinal":72858,"en":"Let us bind him and take him to Beijing."},{"id":"manas-2010:p1695:b001:l011","ordinal":72859,"en":"The forty wanton women in Beijing,"},{"id":"manas-2010:p1695:b001:l012","ordinal":72860,"en":"The women of the royal household,"},{"id":"manas-2010:p1695:b001:l013","ordinal":72861,"en":"Without shame, the Generous One"},{"id":"manas-2010:p1695:b001:l014","ordinal":72862,"en":"Let us take to them and keep as a stud."},{"id":"manas-2010:p1695:b001:l015","ordinal":72863,"en":"From Manas, father of his people,"},{"id":"manas-2010:p1695:b001:l016","ordinal":72864,"en":"Let us obtain the offspring we desire."},{"id":"manas-2010:p1695:b001:l017","ordinal":72865,"en":"Those seething women and girls,"},{"id":"manas-2010:p1695:b001:l018","ordinal":72866,"en":"Let us take him to them as a stud."},{"id":"manas-2010:p1695:b001:l019","ordinal":72867,"en":"From the girls and women, excelling,"},{"id":"manas-2010:p1695:b001:l020","ordinal":72868,"en":"If a son is born,"},{"id":"manas-2010:p1695:b001:l021","ordinal":72869,"en":"In the emperor's Beijing,"},{"id":"manas-2010:p1695:b001:l022","ordinal":72870,"en":"In Karykhan's place,"},{"id":"manas-2010:p1695:b001:l023","ordinal":72871,"en":"Putting a golden crown upon him,"},{"id":"manas-2010:p1695:b001:l024","ordinal":72872,"en":"Seating him upon the golden throne,"},{"id":"manas-2010:p1695:b001:l025","ordinal":72873,"en":"Of palm-sized Beijing,"},{"id":"manas-2010:p1695:b001:l026","ordinal":72874,"en":"Giving him its unity and making it known,"},{"id":"manas-2010:p1695:b001:l027","ordinal":72875,"en":"Let us send word to the people."},{"id":"manas-2010:p1695:b001:l028","ordinal":72876,"en":"Over the imperial realm itself,"},{"id":"manas-2010:p1695:b001:l029","ordinal":72877,"en":"If a son is born of him,"},{"id":"manas-2010:p1695:b001:l030","ordinal":72878,"en":"Let us raise him as khan!”"},{"id":"manas-2010:p1695:b001:l031","ordinal":72879,"en":"Thus spoke Kojozhash."},{"id":"manas-2010:p1695:b001:l032","ordinal":72880,"en":"The Kalmyks' dark spirits,"},{"id":"manas-2010:p1695:b001:l033","ordinal":72881,"en":"A flask of that strong liquor,"},{"id":"manas-2010:p1695:b001:l034","ordinal":72882,"en":"They tipped up and drank together,"},{"id":"manas-2010:p1695:b001:l035","ordinal":72883,"en":"Raised and swallowed together."},{"id":"manas-2010:p1695:b001:l036","ordinal":72884,"en":"Their Buddha image made of bronze,"},{"id":"manas-2010:p1695:b001:l037","ordinal":72885,"en":"In the windswept barren plain,"},{"id":"manas-2010:p1695:b001:l038","ordinal":72886,"en":"They had hung and tied up."},{"id":"manas-2010:p1695:b001:l039","ordinal":72887,"en":"Before the bronze-and-copper Buddha image,"},{"id":"manas-2010:p1695:b001:l040","ordinal":72888,"en":"Rising and bowing in worship,"},{"id":"manas-2010:p1695:b001:l041","ordinal":72889,"en":"The unbelievers offered penitence."},{"id":"manas-2010:p1695:b001:l042","ordinal":72890,"en":"Shouting in fury,"},{"id":"manas-2010:p1696:b001:l001","ordinal":72891,"en":"All of their khans"},{"id":"manas-2010:p1696:b001:l002","ordinal":72892,"en":"Stood proudly, shouting battle cries,"},{"id":"manas-2010:p1696:b001:l003","ordinal":72893,"en":"Roaring in their fury."},{"id":"manas-2010:p1696:b001:l004","ordinal":72894,"en":"Kojojash kept boasting:"},{"id":"manas-2010:p1696:b001:l005","ordinal":72895,"en":"“Among the red-scabbarded Chinese,"},{"id":"manas-2010:p1696:b001:l006","ordinal":72896,"en":"I myself am the strongest!"},{"id":"manas-2010:p1696:b001:l007","ordinal":72897,"en":"The Chinese people of forty khans—"},{"id":"manas-2010:p1696:b001:l008","ordinal":72898,"en":"I shall take all their khanates!"},{"id":"manas-2010:p1696:b001:l009","ordinal":72899,"en":"Of this Chinese people with its king,"},{"id":"manas-2010:p1696:b001:l010","ordinal":72900,"en":"I myself have become the chief!"},{"id":"manas-2010:p1696:b001:l011","ordinal":72901,"en":"The Buruts who dared oppose us—"},{"id":"manas-2010:p1696:b001:l012","ordinal":72902,"en":"I have drained them of everything!”"},{"id":"manas-2010:p1696:b001:l013","ordinal":72903,"en":"Joykara and Kojojash,"},{"id":"manas-2010:p1696:b001:l014","ordinal":72904,"en":"Shuykuchu and Körögöch,"},{"id":"manas-2010:p1696:b001:l015","ordinal":72905,"en":"Ugarkulak and Kanzharkol,"},{"id":"manas-2010:p1696:b001:l016","ordinal":72906,"en":"Bozkertik standing across from them,"},{"id":"manas-2010:p1696:b001:l017","ordinal":72907,"en":"With Zhelzhetpes, the eight"},{"id":"manas-2010:p1696:b001:l018","ordinal":72908,"en":"Now stood in a row."},{"id":"manas-2010:p1696:b001:l019","ordinal":72909,"en":"Alooke’s son Kongurbay,"},{"id":"manas-2010:p1696:b001:l020","ordinal":72910,"en":"The fierce warrior rich in wisdom,"},{"id":"manas-2010:p1696:b001:l021","ordinal":72911,"en":"Stood apart from them."},{"id":"manas-2010:p1696:b001:l022","ordinal":72912,"en":"Those eight mighty men standing there"},{"id":"manas-2010:p1696:b001:l023","ordinal":72913,"en":"Were seen by Sultan Manas Khan"},{"id":"manas-2010:p1696:b001:l024","ordinal":72914,"en":"From upon the rise."},{"id":"manas-2010:p1696:b001:l025","ordinal":72915,"en":"“If you grant me those eight, one God,"},{"id":"manas-2010:p1696:b001:l026","ordinal":72916,"en":"Then load me upon a thoroughbred!"},{"id":"manas-2010:p1696:b001:l027","ordinal":72917,"en":"Let me have no cause for regret."},{"id":"manas-2010:p1696:b001:l028","ordinal":72918,"en":"O one God, whom I adore,"},{"id":"manas-2010:p1696:b001:l029","ordinal":72919,"en":"Take back the life you entrusted me!"},{"id":"manas-2010:p1696:b001:l030","ordinal":72920,"en":"Do not make me a slayer of unbelievers;"},{"id":"manas-2010:p1696:b001:l031","ordinal":72921,"en":"Without letting me take blood from Beijing,"},{"id":"manas-2010:p1696:b001:l032","ordinal":72922,"en":"Do not lay me level with the black earth!"},{"id":"manas-2010:p1696:b001:l033","ordinal":72923,"en":"Beneath me, for me to mount and ride,"},{"id":"manas-2010:p1696:b001:l034","ordinal":72924,"en":"There is no swift horse like Akkula."},{"id":"manas-2010:p1696:b001:l035","ordinal":72925,"en":"To stand and lend me help,"},{"id":"manas-2010:p1696:b001:l036","ordinal":72926,"en":"No brothers Almambet and Syrgak are here!”"},{"id":"manas-2010:p1696:b001:l037","ordinal":72927,"en":"Having spoken these words,"},{"id":"manas-2010:p1696:b001:l038","ordinal":72928,"en":"Your champion lord, the leopard,"},{"id":"manas-2010:p1696:b001:l039","ordinal":72929,"en":"Now took Akkelte in his hand."},{"id":"manas-2010:p1696:b001:l040","ordinal":72930,"en":"At the eight champions before him"},{"id":"manas-2010:p1696:b001:l041","ordinal":72931,"en":"Your mighty warrior fixed his gaze."},{"id":"manas-2010:p1696:b001:l042","ordinal":72932,"en":"As he leveled Akkelte,"},{"id":"manas-2010:p1697:b001:l001","ordinal":72933,"en":"As your Magnanimous One watched intently,"},{"id":"manas-2010:p1697:b001:l002","ordinal":72934,"en":"His two eyes seeming four,"},{"id":"manas-2010:p1697:b001:l003","ordinal":72935,"en":"Your warrior sultan burned with grief."},{"id":"manas-2010:p1697:b001:l004","ordinal":72936,"en":"In the sight of Akkelte,"},{"id":"manas-2010:p1697:b001:l005","ordinal":72937,"en":"The precious heads of those eight"},{"id":"manas-2010:p1697:b001:l006","ordinal":72938,"en":"Hung like little buttons."},{"id":"manas-2010:p1697:b001:l007","ordinal":72939,"en":"The longer he stared, the more they shimmered;"},{"id":"manas-2010:p1697:b001:l008","ordinal":72940,"en":"The eight drew near, a doorway’s height away."},{"id":"manas-2010:p1697:b001:l009","ordinal":72941,"en":"When they came close without delay,"},{"id":"manas-2010:p1697:b001:l010","ordinal":72942,"en":"When your precious lord saw them,"},{"id":"manas-2010:p1697:b001:l011","ordinal":72943,"en":"Would he merely stand and stare?"},{"id":"manas-2010:p1697:b001:l012","ordinal":72944,"en":"Would God strike down the Blood-Shedder?"},{"id":"manas-2010:p1697:b001:l013","ordinal":72945,"en":"He struck the thunderous drum once—"},{"id":"manas-2010:p1697:b001:l014","ordinal":72946,"en":"Akkelte within his hand."},{"id":"manas-2010:p1697:b001:l015","ordinal":72947,"en":"The precious lion, unmoving,"},{"id":"manas-2010:p1697:b001:l016","ordinal":72948,"en":"Fired Akkelte once."},{"id":"manas-2010:p1697:b001:l017","ordinal":72949,"en":"Roaring, Kelte’s shot reached them;"},{"id":"manas-2010:p1697:b001:l018","ordinal":72950,"en":"Joykara and Kojojash,"},{"id":"manas-2010:p1697:b001:l019","ordinal":72951,"en":"With all eight sorcerers, were flung back."},{"id":"manas-2010:p1697:b001:l020","ordinal":72952,"en":"From where it fired, Akkelte"},{"id":"manas-2010:p1697:b001:l021","ordinal":72953,"en":"Tore off their heads as it passed."},{"id":"manas-2010:p1697:b001:l022","ordinal":72954,"en":"The mass of monks fled in panic"},{"id":"manas-2010:p1697:b001:l023","ordinal":72955,"en":"When they heard Akkelte’s voice,"},{"id":"manas-2010:p1697:b001:l024","ordinal":72956,"en":"When it felled their eight giants."},{"id":"manas-2010:p1697:b001:l025","ordinal":72957,"en":"The Manchus fled in terror;"},{"id":"manas-2010:p1697:b001:l026","ordinal":72958,"en":"Chinese, Solon and Manchu"},{"id":"manas-2010:p1697:b001:l027","ordinal":72959,"en":"Scattered in separate bands."},{"id":"manas-2010:p1697:b001:l028","ordinal":72960,"en":"Why would your noble one hold back?"}]
