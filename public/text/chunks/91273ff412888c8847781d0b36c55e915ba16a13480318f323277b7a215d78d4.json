[{"id":"manas-2010:p0701:b001:l031","ordinal":31233,"en":"Would certainly come, he heard."},{"id":"manas-2010:p0701:b001:l032","ordinal":31234,"en":"His gate had doors of steel;"},{"id":"manas-2010:p0701:b001:l033","ordinal":31235,"en":"At the entrance to those doors,"},{"id":"manas-2010:p0701:b001:l034","ordinal":31236,"en":"Guarding Alöökö,"},{"id":"manas-2010:p0701:b001:l035","ordinal":31237,"en":"Were the keepers who watched over him,"},{"id":"manas-2010:p0701:b001:l036","ordinal":31238,"en":"Men of many kinds,"},{"id":"manas-2010:p0701:b001:l037","ordinal":31239,"en":"Sharing death, united in life,"},{"id":"manas-2010:p0701:b001:l038","ordinal":31240,"en":"Men close to him,"},{"id":"manas-2010:p0701:b001:l039","ordinal":31241,"en":"His great men of deep wisdom,"},{"id":"manas-2010:p0701:b001:l040","ordinal":31242,"en":"His clear-minded men of many kinds."},{"id":"manas-2010:p0701:b001:l041","ordinal":31243,"en":"Alöökö's circumstances were like this:"},{"id":"manas-2010:p0701:b001:l042","ordinal":31244,"en":"A tower for climbing up to keep watch,"},{"id":"manas-2010:p0702:b001:l001","ordinal":31245,"en":"Do not ask about that tower!"},{"id":"manas-2010:p0702:b001:l002","ordinal":31246,"en":"Lights were kindled on the tower,"},{"id":"manas-2010:p0702:b001:l003","ordinal":31247,"en":"The great drum was beaten hard,"},{"id":"manas-2010:p0702:b001:l004","ordinal":31248,"en":"The drum was elephant hide."},{"id":"manas-2010:p0702:b001:l005","ordinal":31249,"en":"When the champions struck it with clubs,"},{"id":"manas-2010:p0702:b001:l006","ordinal":31250,"en":"Then would shift"},{"id":"manas-2010:p0702:b001:l007","ordinal":31251,"en":"The slopes of Margalan."},{"id":"manas-2010:p0702:b001:l008","ordinal":31252,"en":"When they heard the drum's voice,"},{"id":"manas-2010:p0702:b001:l009","ordinal":31253,"en":"“What terrible thing has happened?” they asked."},{"id":"manas-2010:p0702:b001:l010","ordinal":31254,"en":"Hurrying, stumbling in confusion,"},{"id":"manas-2010:p0702:b001:l011","ordinal":31255,"en":"His club-bearers and champions,"},{"id":"manas-2010:p0702:b001:l012","ordinal":31256,"en":"“Word has come from the khan,” they said."},{"id":"manas-2010:p0702:b001:l013","ordinal":31257,"en":"His Torguts gathered to the last man;"},{"id":"manas-2010:p0702:b001:l014","ordinal":31258,"en":"They came and assembled."},{"id":"manas-2010:p0702:b001:l015","ordinal":31259,"en":"His men with plumed headdresses,"},{"id":"manas-2010:p0702:b001:l016","ordinal":31260,"en":"His champions who guarded the gate,"},{"id":"manas-2010:p0702:b001:l017","ordinal":31261,"en":"Trembling as though the enemy had come,"},{"id":"manas-2010:p0702:b001:l018","ordinal":31262,"en":"Ran to their khan."},{"id":"manas-2010:p0702:b001:l019","ordinal":31263,"en":"His swordsmen and skilled men,"},{"id":"manas-2010:p0702:b001:l020","ordinal":31264,"en":"As though struck by slaughter,"},{"id":"manas-2010:p0702:b001:l021","ordinal":31265,"en":"His mighty men swarmed."},{"id":"manas-2010:p0702:b001:l022","ordinal":31266,"en":"When the people had gathered,"},{"id":"manas-2010:p0702:b001:l023","ordinal":31267,"en":"Your khan spoke after considering:"},{"id":"manas-2010:p0702:b001:l024","ordinal":31268,"en":"“Your father's grave, my champions!"},{"id":"manas-2010:p0702:b001:l025","ordinal":31269,"en":"Let no grievance against me remain."},{"id":"manas-2010:p0702:b001:l026","ordinal":31270,"en":"My champions, prepare horses;"},{"id":"manas-2010:p0702:b001:l027","ordinal":31271,"en":"If you prepare horses, prepare them quickly!"},{"id":"manas-2010:p0702:b001:l028","ordinal":31272,"en":"For each warrior, from the winged steeds,"},{"id":"manas-2010:p0702:b001:l029","ordinal":31273,"en":"Take two swift horses apiece."},{"id":"manas-2010:p0702:b001:l030","ordinal":31274,"en":"The things that will be needed,"},{"id":"manas-2010:p0702:b001:l031","ordinal":31275,"en":"Take them quickly, without delay!"},{"id":"manas-2010:p0702:b001:l032","ordinal":31276,"en":"Hack at the treasury entrance with axes;"},{"id":"manas-2010:p0702:b001:l033","ordinal":31277,"en":"Open it without delay!"},{"id":"manas-2010:p0702:b001:l034","ordinal":31278,"en":"Countless treasures, abundant wealth,"},{"id":"manas-2010:p0702:b001:l035","ordinal":31279,"en":"Red gold and white silver,"},{"id":"manas-2010:p0702:b001:l036","ordinal":31280,"en":"Break it all up and scatter it!"},{"id":"manas-2010:p0702:b001:l037","ordinal":31281,"en":"Fold up the robes of honor;"},{"id":"manas-2010:p0702:b001:l038","ordinal":31282,"en":"All the yellow gold"},{"id":"manas-2010:p0702:b001:l039","ordinal":31283,"en":"Load upon the mules!"},{"id":"manas-2010:p0702:b001:l040","ordinal":31284,"en":"Send out scouts and travel hard."},{"id":"manas-2010:p0702:b001:l041","ordinal":31285,"en":"If you do not heed these words,"},{"id":"manas-2010:p0702:b001:l042","ordinal":31286,"en":"You will suffer terrible hardship."},{"id":"manas-2010:p0703:b001:l001","ordinal":31287,"en":"If champion Manas comes once,"},{"id":"manas-2010:p0703:b001:l002","ordinal":31288,"en":"You will die, not one of you left!”"},{"id":"manas-2010:p0703:b001:l003","ordinal":31289,"en":"For the winged steeds in the stables,"},{"id":"manas-2010:p0703:b001:l004","ordinal":31290,"en":"All the guards,"},{"id":"manas-2010:p0703:b001:l005","ordinal":31291,"en":"Taking halters in their hands,"},{"id":"manas-2010:p0703:b001:l006","ordinal":31292,"en":"This turmoil was no small thing,"},{"id":"manas-2010:p0703:b001:l007","ordinal":31293,"en":"Began running about."},{"id":"manas-2010:p0703:b001:l008","ordinal":31294,"en":"May God not let us see such a sight!"},{"id":"manas-2010:p0703:b001:l009","ordinal":31295,"en":"As though tumbleweeds were flying,"},{"id":"manas-2010:p0703:b001:l010","ordinal":31296,"en":"The treasury entrance opened."},{"id":"manas-2010:p0703:b001:l011","ordinal":31297,"en":"The gold that filled it"},{"id":"manas-2010:p0703:b001:l012","ordinal":31298,"en":"Went scattering over the plain."},{"id":"manas-2010:p0703:b001:l013","ordinal":31299,"en":"The scattered booty"},{"id":"manas-2010:p0703:b001:l014","ordinal":31300,"en":"The poor found and gathered."},{"id":"manas-2010:p0703:b001:l015","ordinal":31301,"en":"“May it all turn out like this,” they said."},{"id":"manas-2010:p0703:b001:l016","ordinal":31302,"en":"Rejoicing, the poor"},{"id":"manas-2010:p0703:b001:l017","ordinal":31303,"en":"Hid it in their clothing."},{"id":"manas-2010:p0703:b001:l018","ordinal":31304,"en":"The people's hearts were at ease;"},{"id":"manas-2010:p0703:b001:l019","ordinal":31305,"en":"All the poor became rich."},{"id":"manas-2010:p0703:b001:l020","ordinal":31306,"en":"Some of the scattered wealth"},{"id":"manas-2010:p0703:b001:l021","ordinal":31307,"en":"The children found and gathered,"},{"id":"manas-2010:p0703:b001:l022","ordinal":31308,"en":"Putting it into their clothing."},{"id":"manas-2010:p0703:b001:l023","ordinal":31309,"en":"To the place where walnuts were sold"},{"id":"manas-2010:p0703:b001:l024","ordinal":31310,"en":"They ran inside."},{"id":"manas-2010:p0703:b001:l025","ordinal":31311,"en":"All that money in silver coins"},{"id":"manas-2010:p0703:b001:l026","ordinal":31312,"en":"They exchanged for walnuts."},{"id":"manas-2010:p0703:b001:l027","ordinal":31313,"en":"Coming out, the young boys"},{"id":"manas-2010:p0703:b001:l028","ordinal":31314,"en":"Shot at walnuts as at knucklebones."},{"id":"manas-2010:p0703:b001:l029","ordinal":31315,"en":"There were thoughts no one could fathom."},{"id":"manas-2010:p0703:b001:l030","ordinal":31316,"en":"When Khan Alöökö fled,"},{"id":"manas-2010:p0703:b001:l031","ordinal":31317,"en":"A feast arose beside the horses."},{"id":"manas-2010:p0703:b001:l032","ordinal":31318,"en":"The poor and destitute milled about."},{"id":"manas-2010:p0703:b001:l033","ordinal":31319,"en":"“What has happened to the Chinese?” they asked;"},{"id":"manas-2010:p0703:b001:l034","ordinal":31320,"en":"The people stood utterly amazed."},{"id":"manas-2010:p0703:b001:l035","ordinal":31321,"en":"The formidable elder Alöökö,"},{"id":"manas-2010:p0703:b001:l036","ordinal":31322,"en":"When he looked, the Chinese"},{"id":"manas-2010:p0703:b001:l037","ordinal":31323,"en":"Were all swarming about."},{"id":"manas-2010:p0703:b001:l038","ordinal":31324,"en":"His gatekeepers and guards,"},{"id":"manas-2010:p0703:b001:l039","ordinal":31325,"en":"His watchmen and appraisers,"},{"id":"manas-2010:p0703:b001:l040","ordinal":31326,"en":"All gathered, leaving none behind."},{"id":"manas-2010:p0703:b001:l041","ordinal":31327,"en":"Loading their burdens onto winged steeds,"},{"id":"manas-2010:p0703:b001:l042","ordinal":31328,"en":"Panicking and rushing about,"},{"id":"manas-2010:p0704:b001:l001","ordinal":31329,"en":"The swordsmen moved in throngs;"},{"id":"manas-2010:p0704:b001:l002","ordinal":31330,"en":"The archers and warriors"},{"id":"manas-2010:p0704:b001:l003","ordinal":31331,"en":"Loaded their gold onto elephants."},{"id":"manas-2010:p0704:b001:l004","ordinal":31332,"en":"For the warrior, hero Alöökö,"},{"id":"manas-2010:p0704:b001:l005","ordinal":31333,"en":"Such was the sign of a khan."},{"id":"manas-2010:p0704:b001:l006","ordinal":31334,"en":"If you ask about Alöökö,"},{"id":"manas-2010:p0704:b001:l007","ordinal":31335,"en":"With gem buttons the size of fists,"},{"id":"manas-2010:p0704:b001:l008","ordinal":31336,"en":"Draping himself in blue mail,"},{"id":"manas-2010:p0704:b001:l009","ordinal":31337,"en":"If you could see Alöökö,"},{"id":"manas-2010:p0704:b001:l010","ordinal":31338,"en":"He prepared to flee to Beijing."},{"id":"manas-2010:p0704:b001:l011","ordinal":31339,"en":"Beside warrior Alöökö,"},{"id":"manas-2010:p0704:b001:l012","ordinal":31340,"en":"Seven thousand Chinese, countless governors,"},{"id":"manas-2010:p0704:b001:l013","ordinal":31341,"en":"Stretched out in a frightened throng."},{"id":"manas-2010:p0704:b001:l014","ordinal":31342,"en":"Hurrying, stumbling in confusion,"},{"id":"manas-2010:p0704:b001:l015","ordinal":31343,"en":"Onto mules and camels"},{"id":"manas-2010:p0704:b001:l016","ordinal":31344,"en":"They shakily loaded gold."},{"id":"manas-2010:p0704:b001:l017","ordinal":31345,"en":"His executioners and governors"},{"id":"manas-2010:p0704:b001:l018","ordinal":31346,"en":"Loaded horses in a flurry."},{"id":"manas-2010:p0704:b001:l019","ordinal":31347,"en":"Their swiftness was beyond measure;"},{"id":"manas-2010:p0704:b001:l020","ordinal":31348,"en":"They loaded quickly in a flurry."},{"id":"manas-2010:p0704:b001:l021","ordinal":31349,"en":"For the warrior, hero Alöökö,"},{"id":"manas-2010:p0704:b001:l022","ordinal":31350,"en":"They saddled winged steeds and prepared horses."},{"id":"manas-2010:p0704:b001:l023","ordinal":31351,"en":"Alöökö was a great lord,"},{"id":"manas-2010:p0704:b001:l024","ordinal":31352,"en":"Preparing all this so quickly."},{"id":"manas-2010:p0704:b001:l025","ordinal":31353,"en":"They mounted him on a pacer that never trotted;"},{"id":"manas-2010:p0704:b001:l026","ordinal":31354,"en":"They draped silk loosely over him."},{"id":"manas-2010:p0704:b001:l027","ordinal":31355,"en":"Alöökö was a champion;"},{"id":"manas-2010:p0704:b001:l028","ordinal":31356,"en":"Girding on his battle wrap,"},{"id":"manas-2010:p0704:b001:l029","ordinal":31357,"en":"Taking the measure of Manas,"},{"id":"manas-2010:p0704:b001:l030","ordinal":31358,"en":"He prepared to flee to Beijing."},{"id":"manas-2010:p0704:b001:l031","ordinal":31359,"en":"Binding on his armguards,"},{"id":"manas-2010:p0704:b001:l032","ordinal":31360,"en":"Alöökö resolved to flee,"},{"id":"manas-2010:p0704:b001:l033","ordinal":31361,"en":"Turning toward Kakan."},{"id":"manas-2010:p0704:b001:l034","ordinal":31362,"en":"The precious silk and satin"},{"id":"manas-2010:p0704:b001:l035","ordinal":31363,"en":"He had folded diagonally."},{"id":"manas-2010:p0704:b001:l036","ordinal":31364,"en":"The one he worshiped as his god,"},{"id":"manas-2010:p0704:b001:l037","ordinal":31365,"en":"The idol made of bronze,"},{"id":"manas-2010:p0704:b001:l038","ordinal":31366,"en":"He had loaded on a red elephant."},{"id":"manas-2010:p0704:b001:l039","ordinal":31367,"en":"The treasures he had kept,"},{"id":"manas-2010:p0704:b001:l040","ordinal":31368,"en":"All the marvels,"},{"id":"manas-2010:p0704:b001:l041","ordinal":31369,"en":"He abandoned and scattered."},{"id":"manas-2010:p0704:b001:l042","ordinal":31370,"en":"Hearing news of Manas,"},{"id":"manas-2010:p0705:b001:l001","ordinal":31371,"en":"Without turning back, Alöökö"},{"id":"manas-2010:p0705:b001:l002","ordinal":31372,"en":"Fled toward Kakan."},{"id":"manas-2010:p0705:b001:l003","ordinal":31373,"en":"With their tusklike teeth jutting,"},{"id":"manas-2010:p0705:b001:l004","ordinal":31374,"en":"Their front lips hanging,"},{"id":"manas-2010:p0705:b001:l005","ordinal":31375,"en":"Their necks arched like ducks,"},{"id":"manas-2010:p0705:b001:l006","ordinal":31376,"en":"Their two humps showing,"},{"id":"manas-2010:p0705:b001:l007","ordinal":31377,"en":"Their shaggy hair hanging separately,"},{"id":"manas-2010:p0705:b001:l008","ordinal":31378,"en":"He chose the strongest camels."},{"id":"manas-2010:p0705:b001:l009","ordinal":31379,"en":"Alöökö, who struck down on your head,"},{"id":"manas-2010:p0705:b001:l010","ordinal":31380,"en":"Loaded them with gold."},{"id":"manas-2010:p0705:b001:l011","ordinal":31381,"en":"With stallions' manes and mares' bellies,"},{"id":"manas-2010:p0705:b001:l012","ordinal":31382,"en":"Karabayyr thoroughbreds,"},{"id":"manas-2010:p0705:b001:l013","ordinal":31383,"en":"He chose the finest horses."},{"id":"manas-2010:p0705:b001:l014","ordinal":31384,"en":"Alöökö, struck by ancestral spirits,"},{"id":"manas-2010:p0705:b001:l015","ordinal":31385,"en":"Fled without sparing himself."},{"id":"manas-2010:p0705:b001:l016","ordinal":31386,"en":"His wretched warriors, one by one,"},{"id":"manas-2010:p0705:b001:l017","ordinal":31387,"en":"Loaded saddlebags full of gold."},{"id":"manas-2010:p0705:b001:l018","ordinal":31388,"en":"Abundant treasure, countless possessions,"},{"id":"manas-2010:p0705:b001:l019","ordinal":31389,"en":"He squandered and scattered."},{"id":"manas-2010:p0705:b001:l020","ordinal":31390,"en":"Taking the measure of Manas,"},{"id":"manas-2010:p0705:b001:l021","ordinal":31391,"en":"Alöökö now set his course"},{"id":"manas-2010:p0705:b001:l022","ordinal":31392,"en":"And fled toward Beijing."},{"id":"manas-2010:p0705:b001:l023","ordinal":31393,"en":"He scattered his abundant livestock."},{"id":"manas-2010:p0705:b001:l024","ordinal":31394,"en":"On the words his sorcerer knew,"},{"id":"manas-2010:p0705:b001:l025","ordinal":31395,"en":"Alöökö reflected"},{"id":"manas-2010:p0705:b001:l026","ordinal":31396,"en":"And fled toward Anjy."},{"id":"manas-2010:p0705:b001:l027","ordinal":31397,"en":"Hearing the sorcerer's grave words,"},{"id":"manas-2010:p0705:b001:l028","ordinal":31398,"en":"That magnanimous leopard Manas"},{"id":"manas-2010:p0705:b001:l029","ordinal":31399,"en":"Would come to our court"},{"id":"manas-2010:p0705:b001:l030","ordinal":31400,"en":"And overrun it, he heard."},{"id":"manas-2010:p0705:b001:l031","ordinal":31401,"en":"Fine gold coins and precious stones,"},{"id":"manas-2010:p0705:b001:l032","ordinal":31402,"en":"Mixed with rubies and coral,"},{"id":"manas-2010:p0705:b001:l033","ordinal":31403,"en":"He had put into leather vessels."},{"id":"manas-2010:p0705:b001:l034","ordinal":31404,"en":"He passed through Andijan;"},{"id":"manas-2010:p0705:b001:l035","ordinal":31405,"en":"He crossed Erkech-Tam."},{"id":"manas-2010:p0705:b001:l036","ordinal":31406,"en":"Alabek, khan of Kashgar,"},{"id":"manas-2010:p0705:b001:l037","ordinal":31407,"en":"He trampled down upon his head."},{"id":"manas-2010:p0705:b001:l038","ordinal":31408,"en":"Upon Blue Kashgar itself"},{"id":"manas-2010:p0705:b001:l039","ordinal":31409,"en":"He brought turmoil."},{"id":"manas-2010:p0705:b001:l040","ordinal":31410,"en":"Causing terrible hardship,"},{"id":"manas-2010:p0705:b001:l041","ordinal":31411,"en":"Leaving not a mule or camel,"},{"id":"manas-2010:p0705:b001:l042","ordinal":31412,"en":"Alöökö seized them all."},{"id":"manas-2010:p0706:b001:l001","ordinal":31413,"en":"Following the eastern side,"},{"id":"manas-2010:p0706:b001:l002","ordinal":31414,"en":"Picking their way over stony ground,"},{"id":"manas-2010:p0706:b001:l003","ordinal":31415,"en":"All the horses and mules"},{"id":"manas-2010:p0706:b001:l004","ordinal":31416,"en":"Were shod firmly and well."},{"id":"manas-2010:p0706:b001:l005","ordinal":31417,"en":"Alöökö's flight"},{"id":"manas-2010:p0706:b001:l006","ordinal":31418,"en":"Made hearts ache terribly"},{"id":"manas-2010:p0706:b001:l007","ordinal":31419,"en":"And saddle-sored every pack animal."},{"id":"manas-2010:p0706:b001:l008","ordinal":31420,"en":"For every hundred men, one good man"},{"id":"manas-2010:p0706:b001:l009","ordinal":31421,"en":"Was appointed leader to drive them onward."},{"id":"manas-2010:p0706:b001:l010","ordinal":31422,"en":"The mass of troops, the mass of camels,"},{"id":"manas-2010:p0706:b001:l011","ordinal":31423,"en":"He pressed until their eyes bulged."},{"id":"manas-2010:p0706:b001:l012","ordinal":31424,"en":"For every fifty, one leader"},{"id":"manas-2010:p0706:b001:l013","ordinal":31425,"en":"He appointed to drive them on."},{"id":"manas-2010:p0706:b001:l014","ordinal":31426,"en":"The pack animals weakening, struggling onward,"},{"id":"manas-2010:p0706:b001:l015","ordinal":31427,"en":"“That damned Alöökö"},{"id":"manas-2010:p0706:b001:l016","ordinal":31428,"en":"Has certainly met his match,” they said."},{"id":"manas-2010:p0706:b001:l017","ordinal":31429,"en":"Many soldiers cursed as they trudged,"},{"id":"manas-2010:p0706:b001:l018","ordinal":31430,"en":"Fleeing in panic and confusion."},{"id":"manas-2010:p0706:b001:l019","ordinal":31431,"en":"His soldiers whispered,"},{"id":"manas-2010:p0706:b001:l020","ordinal":31432,"en":"Murmuring to one another:"},{"id":"manas-2010:p0706:b001:l021","ordinal":31433,"en":"“Fleeing about like this,"},{"id":"manas-2010:p0706:b001:l022","ordinal":31434,"en":"How shall we die?"},{"id":"manas-2010:p0706:b001:l023","ordinal":31435,"en":"Before we reach Kakanchyn,"},{"id":"manas-2010:p0706:b001:l024","ordinal":31436,"en":"It is a journey of six months."},{"id":"manas-2010:p0706:b001:l025","ordinal":31437,"en":"Beijing is a hot land;"},{"id":"manas-2010:p0706:b001:l026","ordinal":31438,"en":"The Chinese are a distant people."},{"id":"manas-2010:p0706:b001:l027","ordinal":31439,"en":"Some parts of Beijing"},{"id":"manas-2010:p0706:b001:l028","ordinal":31440,"en":"Are desert forty days across,"},{"id":"manas-2010:p0706:b001:l029","ordinal":31441,"en":"Where living beings cannot endure,"},{"id":"manas-2010:p0706:b001:l030","ordinal":31442,"en":"Where none who encounters it survives."},{"id":"manas-2010:p0706:b001:l031","ordinal":31443,"en":"A ewer set upon the sand"},{"id":"manas-2010:p0706:b001:l032","ordinal":31444,"en":"Bubbles up and boils."},{"id":"manas-2010:p0706:b001:l033","ordinal":31445,"en":"The senseless wretch drove us hard;"},{"id":"manas-2010:p0706:b001:l034","ordinal":31446,"en":"No sense or reason remains in us."},{"id":"manas-2010:p0706:b001:l035","ordinal":31447,"en":"Our strength gone, our power exhausted,"},{"id":"manas-2010:p0706:b001:l036","ordinal":31448,"en":"Shall we be left upon a pass?"},{"id":"manas-2010:p0706:b001:l037","ordinal":31449,"en":"Palates dry, eyes staring,"},{"id":"manas-2010:p0706:b001:l038","ordinal":31450,"en":"Shall we be left in the desert?"},{"id":"manas-2010:p0706:b001:l039","ordinal":31451,"en":"Whimpering like young puppies,"},{"id":"manas-2010:p0706:b001:l040","ordinal":31452,"en":"Shall we die a wretched death?"},{"id":"manas-2010:p0706:b001:l041","ordinal":31453,"en":"Alöökö has gone mad."},{"id":"manas-2010:p0706:b001:l042","ordinal":31454,"en":"Finding not a spoonful of water in the desert,"},{"id":"manas-2010:p0707:b001:l001","ordinal":31455,"en":"Shall we die miserably?"},{"id":"manas-2010:p0707:b001:l002","ordinal":31456,"en":"Coming upon empty plains and desert,"},{"id":"manas-2010:p0707:b001:l003","ordinal":31457,"en":"Shall we die a wretched death?"},{"id":"manas-2010:p0707:b001:l004","ordinal":31458,"en":"Before reaching Beijing, on this side,"},{"id":"manas-2010:p0707:b001:l005","ordinal":31459,"en":"Shall we die miserably?"},{"id":"manas-2010:p0707:b001:l006","ordinal":31460,"en":"The Six Cities, the khan of Kokand,"},{"id":"manas-2010:p0707:b001:l007","ordinal":31461,"en":"And below them Samarkand:"},{"id":"manas-2010:p0707:b001:l008","ordinal":31462,"en":"Imposing heavy levies,"},{"id":"manas-2010:p0707:b001:l009","ordinal":31463,"en":"He consumed their livestock as tribute."},{"id":"manas-2010:p0707:b001:l010","ordinal":31464,"en":"Keeping treasure, gathering livestock,"},{"id":"manas-2010:p0707:b001:l011","ordinal":31465,"en":"In the days when he swaggered,"},{"id":"manas-2010:p0707:b001:l012","ordinal":31466,"en":"If a terrible, difficult dispute arose,"},{"id":"manas-2010:p0707:b001:l013","ordinal":31467,"en":"‘I will not let them touch you,’ he would say"},{"id":"manas-2010:p0707:b001:l014","ordinal":31468,"en":"To those heard by ears and seen by eyes,"},{"id":"manas-2010:p0707:b001:l015","ordinal":31469,"en":"The giants and mighty men, he would say."},{"id":"manas-2010:p0707:b001:l016","ordinal":31470,"en":"His scattering so much wealth,"},{"id":"manas-2010:p0707:b001:l017","ordinal":31471,"en":"That damned Alöökö,"},{"id":"manas-2010:p0707:b001:l018","ordinal":31472,"en":"Saddle-soring every pack animal,"},{"id":"manas-2010:p0707:b001:l019","ordinal":31473,"en":"Making every heart ache,"},{"id":"manas-2010:p0707:b001:l020","ordinal":31474,"en":"His flight toward Beijing:"},{"id":"manas-2010:p0707:b001:l021","ordinal":31475,"en":"What terrible thing, what business is this?”"},{"id":"manas-2010:p0707:b001:l022","ordinal":31476,"en":"His soldiers thought these thoughts;"},{"id":"manas-2010:p0707:b001:l023","ordinal":31477,"en":"Alöökö did not heed their minds."},{"id":"manas-2010:p0707:b001:l024","ordinal":31478,"en":"Traversing all Kakshaal,"},{"id":"manas-2010:p0707:b001:l025","ordinal":31479,"en":"Skirting bad waters,"},{"id":"manas-2010:p0707:b001:l026","ordinal":31480,"en":"He crossed the dark plain."},{"id":"manas-2010:p0707:b001:l027","ordinal":31481,"en":"Taking no rest by day,"},{"id":"manas-2010:p0707:b001:l028","ordinal":31482,"en":"Taking no sleep at night,"},{"id":"manas-2010:p0707:b001:l029","ordinal":31483,"en":"He fled by day and night."},{"id":"manas-2010:p0707:b001:l030","ordinal":31484,"en":"Zhylgyn-Talaa, Tash-Kechüü,"},{"id":"manas-2010:p0707:b001:l031","ordinal":31485,"en":"The warrior, hero Alöökö's"},{"id":"manas-2010:p0707:b001:l032","ordinal":31486,"en":"Familiar crossing he himself had seen,"},{"id":"manas-2010:p0707:b001:l033","ordinal":31487,"en":"He forded Kum-Aryk."},{"id":"manas-2010:p0707:b001:l034","ordinal":31488,"en":"Beyond the crumbling Ak-Zhar,"}]
