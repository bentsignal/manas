[{"id":"semetey-1-2013:p0673:b005:l006","ordinal":128001,"en":"Your elder Bakai put them on Kökcholok,"},{"id":"semetey-1-2013:p0673:b005:l007","ordinal":128002,"en":"And mounted himself as well."},{"id":"semetey-1-2013:p0673:b005:l008","ordinal":128003,"en":"Semetey followed him."},{"id":"semetey-1-2013:p0673:b005:l009","ordinal":128004,"en":"From malicious Jakyp,"},{"id":"semetey-1-2013:p0673:b005:l010","ordinal":128005,"en":"Khan Manas's saddlebags"},{"id":"semetey-1-2013:p0673:b005:l011","ordinal":128006,"en":"He had seized and was taking away."},{"id":"semetey-1-2013:p0673:b005:l012","ordinal":128007,"en":"Warrior Bakai's Kökcholok,"},{"id":"semetey-1-2013:p0673:b005:l013","ordinal":128008,"en":"Under the weight of the saddlebags,"},{"id":"semetey-1-2013:p0673:b005:l014","ordinal":128009,"en":"Ah, that Kökcholok—"},{"id":"semetey-1-2013:p0673:b005:l016","ordinal":128010,"en":"His pasterns bent,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0673:b005:l017","ordinal":128011,"en":"His belly hung down to the ground."},{"id":"semetey-1-2013:p0673:b005:l018","ordinal":128012,"en":"“What will become of the dog?”"},{"id":"semetey-1-2013:p0673:b005:l019","ordinal":128013,"en":"Your elder Bakai looked about in alarm."},{"id":"semetey-1-2013:p0673:b005:l020","ordinal":128014,"en":"The horse's spine curved like a sickle;"},{"id":"semetey-1-2013:p0673:b005:l022","ordinal":128015,"en":"His back bent and sagged.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0673:b005:l023","ordinal":128016,"en":"Kökcholok stepped forward,"},{"id":"semetey-1-2013:p0673:b005:l024","ordinal":128017,"en":"That worthy noble steed,"},{"id":"semetey-1-2013:p0673:b005:l025","ordinal":128018,"en":"With a supple, ambling gait."},{"id":"semetey-1-2013:p0673:b005:l026","ordinal":128019,"en":"The wind could not match his trot;"},{"id":"semetey-1-2013:p0673:b005:l027","ordinal":128020,"en":"No beast could match his walk."},{"id":"semetey-1-2013:p0673:b005:l028","ordinal":128021,"en":"Steam billowed from his nostrils."},{"id":"semetey-1-2013:p0673:b005:l029","ordinal":128022,"en":"The black stones he trod upon"},{"id":"semetey-1-2013:p0673:b005:l030","ordinal":128023,"en":"Crumbled worse than charcoal."},{"id":"semetey-1-2013:p0673:b005:l031","ordinal":128024,"en":"Lord Bakai, your warrior elder,"},{"id":"semetey-1-2013:p0673:b005:l032","ordinal":128025,"en":"(Kayipchi's dark cave,"},{"id":"semetey-1-2013:p0673:b005:l033","ordinal":128026,"en":"When leopard Manas lived,"},{"id":"semetey-1-2013:p0673:b005:l034","ordinal":128027,"en":"The very cave where he hid treasure),"},{"id":"semetey-1-2013:p0673:b005:l035","ordinal":128028,"en":"To the cave where the treasury was gathered,"},{"id":"semetey-1-2013:p0673:b005:l036","ordinal":128029,"en":"He tipped and lowered them."},{"id":"semetey-1-2013:p0673:b005:l037","ordinal":128030,"en":"To that helpless one left by Manas,"},{"id":"semetey-1-2013:p0673:b005:l038","ordinal":128031,"en":"He handed over the gray saddlebags."},{"id":"semetey-1-2013:p0673:b005:l039","ordinal":128032,"en":"“The saddlebags left by Manas,” he said,"},{"id":"semetey-1-2013:p0673:b005:l040","ordinal":128033,"en":"Entrusting them to Bölökbai,"},{"id":"semetey-1-2013:p0674:b004:l001","ordinal":128034,"en":"Teaching what was unknown,"},{"id":"semetey-1-2013:p0674:b004:l002","ordinal":128035,"en":"The learned elder Bakai,"},{"id":"semetey-1-2013:p0674:b004:l003","ordinal":128036,"en":"Making the unperceived understood,"},{"id":"semetey-1-2013:p0674:b004:l004","ordinal":128037,"en":"Falcon Bakai, the saint."},{"id":"semetey-1-2013:p0674:b004:l005","ordinal":128038,"en":"As they rode farther on,"},{"id":"semetey-1-2013:p0674:b004:l006","ordinal":128039,"en":"Yellow foothills came into view."},{"id":"semetey-1-2013:p0674:b004:l007","ordinal":128040,"en":"Seeing the ridge, he wept;"},{"id":"semetey-1-2013:p0674:b004:l008","ordinal":128041,"en":"Jilgynduu, Keng-Kol, broad Talas—"},{"id":"semetey-1-2013:p0674:b004:l009","ordinal":128042,"en":"Seeing the land, he wept."},{"id":"semetey-1-2013:p0674:b004:l010","ordinal":128043,"en":"Kara-Buura and Chong-Chatkal—"},{"id":"semetey-1-2013:p0674:b004:l011","ordinal":128044,"en":"Seeing their mountainside hollows, he wept."},{"id":"semetey-1-2013:p0674:b004:l012","ordinal":128045,"en":"The multitude of Kyrgyz, the many Argin,"},{"id":"semetey-1-2013:p0674:b004:l013","ordinal":128046,"en":"Seeing where they had dwelt, he wept."},{"id":"semetey-1-2013:p0674:b004:l014","ordinal":128047,"en":"Your elder, leopard Bakai,"},{"id":"semetey-1-2013:p0674:b004:l015","ordinal":128048,"en":"The dark ridge where he used to stand watch—"},{"id":"semetey-1-2013:p0674:b004:l016","ordinal":128049,"en":"Seeing its peak, he wept."},{"id":"semetey-1-2013:p0674:b004:l017","ordinal":128050,"en":"God's sun grew overcast in the sky;"},{"id":"semetey-1-2013:p0674:b004:l018","ordinal":128051,"en":"Upon Khan Bakai's head,"},{"id":"semetey-1-2013:p0674:b004:l019","ordinal":128052,"en":"Sixty thoughts came at once:"},{"id":"semetey-1-2013:p0674:b004:l020","ordinal":128053,"en":"“My dear orphan,"},{"id":"semetey-1-2013:p0674:b004:l021","ordinal":128054,"en":"Seen today, gone tomorrow—"},{"id":"semetey-1-2013:p0674:b004:l022","ordinal":128055,"en":"Such is this world of shit."},{"id":"semetey-1-2013:p0674:b004:l023","ordinal":128056,"en":"Orphan, listen to my words."},{"id":"semetey-1-2013:p0674:b004:l024","ordinal":128057,"en":"In those days, when my caravan Manas lived,"},{"id":"semetey-1-2013:p0674:b004:l025","ordinal":128058,"en":"In a Kyrgyz cap of blue-gray lynx fur,"},{"id":"semetey-1-2013:p0674:b004:l026","ordinal":128059,"en":"When I tossed my head,"},{"id":"semetey-1-2013:p0674:b004:l027","ordinal":128060,"en":"Knowing the world,"},{"id":"semetey-1-2013:p0674:b004:l028","ordinal":128061,"en":"When I lived in delight,"},{"id":"semetey-1-2013:p0674:b004:l029","ordinal":128062,"en":"Lying on my back, acting like God,"},{"id":"semetey-1-2013:p0674:b004:l030","ordinal":128063,"en":"I would slice and eat rump meat."},{"id":"semetey-1-2013:p0674:b004:l031","ordinal":128064,"en":"When my soul's companion Manas lived,"},{"id":"semetey-1-2013:p0674:b004:l032","ordinal":128065,"en":"I would say, ‘Where is the angel of death for me?’"},{"id":"semetey-1-2013:p0674:b004:l033","ordinal":128066,"en":"After that Manas died,"},{"id":"semetey-1-2013:p0674:b004:l034","ordinal":128067,"en":"I was humiliated, herding camels."},{"id":"semetey-1-2013:p0674:b004:l035","ordinal":128068,"en":"While his lord was alive,"},{"id":"semetey-1-2013:p0674:b004:l036","ordinal":128069,"en":"Your elder, Lord Bakai—"},{"id":"semetey-1-2013:p0674:b005:l001","ordinal":128070,"en":"The marten cap upon his head,"},{"id":"semetey-1-2013:p0674:b005:l002","ordinal":128071,"en":"Who did not wear it and toss his head?"},{"id":"semetey-1-2013:p0674:b005:l003","ordinal":128072,"en":"When they heard of your elder, Khan Bakai,"},{"id":"semetey-1-2013:p0674:b005:l004","ordinal":128073,"en":"Great China, the khakan's people,"},{"id":"semetey-1-2013:p0674:b005:l005","ordinal":128074,"en":"The mighty peoples trembled."},{"id":"semetey-1-2013:p0674:b005:l006","ordinal":128075,"en":"My dear orphan,"},{"id":"semetey-1-2013:p0674:b005:l007","ordinal":128076,"en":"When I reckon up my past,"},{"id":"semetey-1-2013:p0674:b005:l008","ordinal":128077,"en":"My heart is sorely troubled,"},{"id":"semetey-1-2013:p0674:b005:l009","ordinal":128078,"en":"Tears spill from my eyes."},{"id":"semetey-1-2013:p0674:b005:l010","ordinal":128079,"en":"The overturned, treacherous world"},{"id":"semetey-1-2013:p0674:b005:l011","ordinal":128080,"en":"Seems to have gone without a backward glance."},{"id":"semetey-1-2013:p0674:b005:l012","ordinal":128081,"en":"The goodness that lay before me,"},{"id":"semetey-1-2013:p0674:b005:l013","ordinal":128082,"en":"I failed to see it."},{"id":"semetey-1-2013:p0674:b005:l014","ordinal":128083,"en":"Bruised black and blue, wretched man,"},{"id":"semetey-1-2013:p0674:b005:l015","ordinal":128084,"en":"While fierce Manas was alive,"},{"id":"semetey-1-2013:p0674:b005:l016","ordinal":128085,"en":"I failed to die."},{"id":"semetey-1-2013:p0674:b005:l017","ordinal":128086,"en":"Kara-Shaar and Kambil,"},{"id":"semetey-1-2013:p0674:b005:l018","ordinal":128087,"en":"When I held them in my grasp,"},{"id":"semetey-1-2013:p0674:b005:l019","ordinal":128088,"en":"The multitude of Manchus, the countless Torguts,"},{"id":"semetey-1-2013:p0674:b005:l020","ordinal":128089,"en":"When I struck them down,"},{"id":"semetey-1-2013:p0674:b005:l021","ordinal":128090,"en":"In the time of the wide world,"},{"id":"semetey-1-2013:p0674:b005:l022","ordinal":128091,"en":"While my fierce one was alive,"},{"id":"semetey-1-2013:p0674:b005:l023","ordinal":128092,"en":"Why did I not die then?"},{"id":"semetey-1-2013:p0674:b005:l024","ordinal":128093,"en":"Narkesken, that strikes men down,"},{"id":"semetey-1-2013:p0674:b005:l025","ordinal":128094,"en":"When I held it,"},{"id":"semetey-1-2013:p0674:b005:l026","ordinal":128095,"en":"Upon the world, turmoil—"},{"id":"semetey-1-2013:p0674:b005:l027","ordinal":128096,"en":"When I brought it,"},{"id":"semetey-1-2013:p0674:b005:l028","ordinal":128097,"en":"When sacred power rested upon my head,"},{"id":"semetey-1-2013:p0674:b005:l029","ordinal":128098,"en":"While Manas was safe and well,"},{"id":"semetey-1-2013:p0674:b005:l030","ordinal":128099,"en":"Why did I not die then?"},{"id":"semetey-1-2013:p0674:b005:l031","ordinal":128100,"en":"In those days, when I wore a shot-proof coat,"},{"id":"semetey-1-2013:p0674:b005:l032","ordinal":128101,"en":"The eighteen thousand worlds,"},{"id":"semetey-1-2013:p0674:b005:l033","ordinal":128102,"en":"When I trod them down like charcoal,"},{"id":"semetey-1-2013:p0674:b005:l034","ordinal":128103,"en":"Why did I not die then?"},{"id":"semetey-1-2013:p0674:b005:l035","ordinal":128104,"en":"Upon those I aimed at, turmoil—"},{"id":"semetey-1-2013:p0674:b005:l036","ordinal":128105,"en":"When I brought it,"}]
