[{"id":"seytek-2012:p0774:b003:l009","ordinal":353537,"en":"This is the army that fought"},{"id":"seytek-2012:p0774:b003:l010","ordinal":353538,"en":"The infidel, the monster’s son;"},{"id":"seytek-2012:p0774:b003:l011","ordinal":353539,"en":"This is the mouth that traded words with him."},{"id":"seytek-2012:p0774:b003:l012","ordinal":353540,"en":"I am the maiden Kuyaly, the champion—"},{"id":"seytek-2012:p0774:b003:l013","ordinal":353541,"en":"I shall unleash a great conflict for the ages."},{"id":"seytek-2012:p0774:b003:l014","ordinal":353542,"en":"If I meet him face-to-face in combat,"},{"id":"seytek-2012:p0774:b003:l015","ordinal":353543,"en":"Could Sarybay ever stand against me?"},{"id":"seytek-2012:p0774:b003:l016","ordinal":353544,"en":"This was all I ever asked"},{"id":"seytek-2012:p0774:b003:l017","ordinal":353545,"en":"Of almighty God."},{"id":"seytek-2012:p0774:b003:l018","ordinal":353546,"en":"Having blunted my steel"},{"id":"seytek-2012:p0774:b003:l019","ordinal":353547,"en":"And destroyed Sarybay,"},{"id":"seytek-2012:p0774:b003:l020","ordinal":353548,"en":"At the encampment pitched here since yesterday,"},{"id":"seytek-2012:p0774:b003:l021","ordinal":353549,"en":"Where Kökmonchok, daughter of Beri,"},{"id":"seytek-2012:p0774:b003:l022","ordinal":353550,"en":"Was holding her games,"},{"id":"seytek-2012:p0774:b003:l023","ordinal":353551,"en":"I hobbled Zhelzhetpes beneath me"},{"id":"seytek-2012:p0774:b003:l024","ordinal":353552,"en":"And tied him to graze."},{"id":"seytek-2012:p0774:b003:l025","ordinal":353553,"en":"I removed the saddle"},{"id":"seytek-2012:p0774:b003:l026","ordinal":353554,"en":"From my courser and left him bareback;"},{"id":"seytek-2012:p0774:b003:l027","ordinal":353555,"en":"Beneath the plane tree below,"},{"id":"seytek-2012:p0774:b003:l028","ordinal":353556,"en":"I tethered him on a long lead to graze,"},{"id":"seytek-2012:p0774:b003:l029","ordinal":353557,"en":"Quenched his thirst beyond the ridge,"},{"id":"seytek-2012:p0774:b003:l030","ordinal":353558,"en":"And let him crop the lush grass."},{"id":"seytek-2012:p0774:b003:l031","ordinal":353559,"en":"I shod Zhan-Baspas,"},{"id":"seytek-2012:p0774:b003:l032","ordinal":353560,"en":"And beneath me the charger Saykashka,"},{"id":"seytek-2012:p0774:b003:l033","ordinal":353561,"en":"With shoes of gold."},{"id":"seytek-2012:p0774:b003:l034","ordinal":353562,"en":"Finding no mountain left to tread,"},{"id":"seytek-2012:p0774:b003:l035","ordinal":353563,"en":"No enemy left to fight,"},{"id":"seytek-2012:p0774:b003:l036","ordinal":353564,"en":"We hunted with clamor, raising dust,"},{"id":"seytek-2012:p0774:b003:l037","ordinal":353565,"en":"Played on the swings, making merry,"},{"id":"seytek-2012:p0774:b003:l038","ordinal":353566,"en":"Held maidens’ games to great acclaim,"},{"id":"seytek-2012:p0774:b003:l039","ordinal":353567,"en":"And played bold games amid clouds of dust;"},{"id":"seytek-2012:p0774:b003:l040","ordinal":353568,"en":"When bored, we hunted roe deer."},{"id":"seytek-2012:p0775:b002:l001","ordinal":353569,"en":"If the dear soul does not weary,"},{"id":"seytek-2012:p0775:b002:l002","ordinal":353570,"en":"By the river stands a clustered poplar;"},{"id":"seytek-2012:p0775:b002:l003","ordinal":353571,"en":"When they camped beside the clustered poplar,"},{"id":"seytek-2012:p0775:b002:l004","ordinal":353572,"en":"When the revelry came into full bloom."},{"id":"seytek-2012:p0775:b002:l005","ordinal":353573,"en":"When the pale dawn broke,"},{"id":"seytek-2012:p0775:b002:l006","ordinal":353574,"en":"When the constellation Libra vanished,"},{"id":"seytek-2012:p0775:b002:l007","ordinal":353575,"en":"And sank behind the looming mountain,"},{"id":"seytek-2012:p0775:b002:l008","ordinal":353576,"en":"When the cold wind of daybreak"},{"id":"seytek-2012:p0775:b002:l009","ordinal":353577,"en":"Swept down the river,"},{"id":"seytek-2012:p0775:b002:l010","ordinal":353578,"en":"When the pale dawn stood,"},{"id":"seytek-2012:p0775:b002:l011","ordinal":353579,"en":"Stars glittered in the sky,"},{"id":"seytek-2012:p0775:b002:l012","ordinal":353580,"en":"As the pale dawn opened,"},{"id":"seytek-2012:p0775:b002:l013","ordinal":353581,"en":"And yesterday light spread over the earth,"},{"id":"seytek-2012:p0775:b002:l014","ordinal":353582,"en":"Yesterday, noble Aichürök,"},{"id":"seytek-2012:p0775:b002:l015","ordinal":353583,"en":"My days of honor had departed."},{"id":"seytek-2012:p0775:b002:l016","ordinal":353584,"en":"After Sarybai unleashed his wrath,"},{"id":"seytek-2012:p0775:b002:l017","ordinal":353585,"en":"And ground Talas to dust,"},{"id":"seytek-2012:p0775:b002:l018","ordinal":353586,"en":"After Sarybai laid siege to it,"},{"id":"seytek-2012:p0775:b002:l019","ordinal":353587,"en":"Aichürök, Akun’s daughter,"},{"id":"seytek-2012:p0775:b002:l020","ordinal":353588,"en":"Traversed the whole wide earth,"},{"id":"seytek-2012:p0775:b002:l021","ordinal":353589,"en":"And wandered throughout the universe;"},{"id":"seytek-2012:p0775:b002:l022","ordinal":353590,"en":"I drained away her sorrowful blood,"},{"id":"seytek-2012:p0775:b002:l023","ordinal":353591,"en":"And aged her noble head."},{"id":"seytek-2012:p0775:b002:l024","ordinal":353592,"en":"Her heart pierced, she withdrew,"},{"id":"seytek-2012:p0775:b002:l025","ordinal":353593,"en":"And from Sarybai’s wrath"},{"id":"seytek-2012:p0775:b002:l026","ordinal":353594,"en":"Tears poured from her eyes;"},{"id":"seytek-2012:p0775:b002:l027","ordinal":353595,"en":"Only a spoonful of blood remained,"},{"id":"seytek-2012:p0775:b002:l028","ordinal":353596,"en":"Her fly-sized soul shrieked,"},{"id":"seytek-2012:p0775:b002:l029","ordinal":353597,"en":"Unable to endure, she sobbed,"},{"id":"seytek-2012:p0775:b002:l030","ordinal":353598,"en":"Her heart pierced by sorrow, she withdrew,"},{"id":"seytek-2012:p0775:b002:l031","ordinal":353599,"en":"And tears poured from her eyes;"},{"id":"seytek-2012:p0775:b002:l032","ordinal":353600,"en":"Her fly-sized soul shrieked,"},{"id":"seytek-2012:p0775:b002:l033","ordinal":353601,"en":"Truly entering in, she was battered,"},{"id":"seytek-2012:p0775:b002:l034","ordinal":353602,"en":"And pleaded with wretched me."},{"id":"seytek-2012:p0775:b002:l035","ordinal":353603,"en":"The reason for her pleading was—"},{"id":"seytek-2012:p0775:b002:l036","ordinal":353604,"en":"The stars in heaven were dim,"},{"id":"seytek-2012:p0775:b002:l037","ordinal":353605,"en":"And she, ill-fated like me,"},{"id":"seytek-2012:p0775:b002:l038","ordinal":353606,"en":"Was my sworn friend unto the afterlife."},{"id":"seytek-2012:p0775:b002:l039","ordinal":353607,"en":"That accursed enemy Sarybai—"},{"id":"seytek-2012:p0775:b002:l040","ordinal":353608,"en":"The swine’s cruelty has gone too far;"},{"id":"seytek-2012:p0775:b003:l001","ordinal":353609,"en":"“Let there be a mighty exchange of shots,"},{"id":"seytek-2012:p0775:b003:l002","ordinal":353610,"en":"And by Almighty God’s wrath"},{"id":"seytek-2012:p0775:b003:l003","ordinal":353611,"en":"Deliver them,” she said."},{"id":"seytek-2012:p0775:b003:l004","ordinal":353612,"en":"God created him as a lion,"},{"id":"seytek-2012:p0775:b003:l005","ordinal":353613,"en":"The doomed sultan Semetey,"},{"id":"seytek-2012:p0775:b003:l006","ordinal":353614,"en":"Whose fortune was perfect."},{"id":"seytek-2012:p0775:b003:l007","ordinal":353615,"en":"If you looked into his heart,"},{"id":"seytek-2012:p0775:b003:l008","ordinal":353616,"en":"It was broader than the earth."},{"id":"seytek-2012:p0775:b003:l009","ordinal":353617,"en":"Born of man and woman,"},{"id":"seytek-2012:p0775:b003:l010","ordinal":353618,"en":"Such a dear lion was created but once;"},{"id":"seytek-2012:p0775:b003:l011","ordinal":353619,"en":"His like could never be among mankind."},{"id":"seytek-2012:p0775:b003:l012","ordinal":353620,"en":"Take the sun-faced noble sultan"},{"id":"seytek-2012:p0775:b003:l013","ordinal":353621,"en":"To be your husband."},{"id":"seytek-2012:p0775:b003:l014","ordinal":353622,"en":"Against the grievous foe Sarybai,"},{"id":"seytek-2012:p0775:b003:l015","ordinal":353623,"en":"Wage the struggle with all your might."},{"id":"seytek-2012:p0775:b003:l016","ordinal":353624,"en":"From the hands of that savage dog,"},{"id":"seytek-2012:p0775:b003:l017","ordinal":353625,"en":"Let Semetey’s Seytek"},{"id":"seytek-2012:p0775:b003:l018","ordinal":353626,"en":"And Külchoro, son of Almambet,"},{"id":"seytek-2012:p0775:b003:l019","ordinal":353627,"en":"Be delivered,” she said."},{"id":"seytek-2012:p0775:b003:l020","ordinal":353628,"en":"Chürök cried and wailed,"},{"id":"seytek-2012:p0775:b003:l021","ordinal":353629,"en":"Speaking graceful, honeyed words,"},{"id":"seytek-2012:p0775:b003:l022","ordinal":353630,"en":"And lamenting with bitter sobs."},{"id":"seytek-2012:p0775:b003:l023","ordinal":353631,"en":"From the spirits I heard the news"},{"id":"seytek-2012:p0775:b003:l024","ordinal":353632,"en":"That my beloved Semetey"},{"id":"seytek-2012:p0775:b003:l025","ordinal":353633,"en":"Was locked in enmity"},{"id":"seytek-2012:p0775:b003:l026","ordinal":353634,"en":"With the hero, son of the ogre;"},{"id":"seytek-2012:p0775:b003:l027","ordinal":353635,"en":"Of the fierce gunfire"},{"id":"seytek-2012:p0775:b003:l028","ordinal":353636,"en":"I heard, and came to rescue him"},{"id":"seytek-2012:p0775:b003:l029","ordinal":353637,"en":"From the magnanimous hero’s son."},{"id":"seytek-2012:p0775:b003:l030","ordinal":353638,"en":"In frantic haste I traveled,"},{"id":"seytek-2012:p0775:b003:l031","ordinal":353639,"en":"Never resting by day,"},{"id":"seytek-2012:p0775:b003:l032","ordinal":353640,"en":"Never taking a day’s repose,"},{"id":"seytek-2012:p0775:b003:l033","ordinal":353641,"en":"Never lying down to ease my hips,"},{"id":"seytek-2012:p0775:b003:l034","ordinal":353642,"en":"Never reclining to satisfy my sleep,"},{"id":"seytek-2012:p0775:b003:l035","ordinal":353643,"en":"Crossing towering lofty mountains,"},{"id":"seytek-2012:p0775:b003:l036","ordinal":353644,"en":"Wading through deep ravines,"},{"id":"seytek-2012:p0775:b003:l037","ordinal":353645,"en":"Driving the horse relentlessly onward,"},{"id":"seytek-2012:p0775:b003:l038","ordinal":353646,"en":"Crossing passes and treading stones,"},{"id":"seytek-2012:p0775:b003:l039","ordinal":353647,"en":"Until at last I arrived and made camp."},{"id":"seytek-2012:p0775:b003:l040","ordinal":353648,"en":"When the horse grew as small as a lark,"},{"id":"seytek-2012:p0776:b002:l001","ordinal":353649,"en":"In frantic haste I traveled,"},{"id":"seytek-2012:p0776:b002:l002","ordinal":353650,"en":"And came through tumult and turmoil."},{"id":"seytek-2012:p0776:b002:l003","ordinal":353651,"en":"My beloved hero Sultan—"},{"id":"seytek-2012:p0776:b002:l004","ordinal":353652,"en":"I have seen the bloodthirsty lion!"},{"id":"seytek-2012:p0776:b002:l005","ordinal":353653,"en":"When sent ahead, he brought good fortune;"},{"id":"seytek-2012:p0776:b002:l006","ordinal":353654,"en":"When riding behind, he equaled countless troops."},{"id":"seytek-2012:p0776:b002:l007","ordinal":353655,"en":"He wore a blue lynx-fur cap,"},{"id":"seytek-2012:p0776:b002:l008","ordinal":353656,"en":"And wielded a mottled-blue shield;"},{"id":"seytek-2012:p0776:b002:l009","ordinal":353657,"en":"He spared no soul who faced him."},{"id":"seytek-2012:p0776:b002:l010","ordinal":353658,"en":"His eyes saw from afar;"},{"id":"seytek-2012:p0776:b002:l011","ordinal":353659,"en":"Amid a great assembly,"},{"id":"seytek-2012:p0776:b002:l012","ordinal":353660,"en":"He emerged alone from the race."},{"id":"seytek-2012:p0776:b002:l013","ordinal":353661,"en":"The mightiest of saints,"},{"id":"seytek-2012:p0776:b002:l014","ordinal":353662,"en":"The fortress of the blessed lion."},{"id":"seytek-2012:p0776:b002:l015","ordinal":353663,"en":"Precious elder Bakai,"},{"id":"seytek-2012:p0776:b002:l016","ordinal":353664,"en":"A saint who knew the ages,"},{"id":"seytek-2012:p0776:b002:l017","ordinal":353665,"en":"Your fortunate uncle Bakai—"},{"id":"seytek-2012:p0776:b002:l018","ordinal":353666,"en":"Behold how great his dignity."},{"id":"seytek-2012:p0776:b002:l019","ordinal":353667,"en":"His blessing enriched the soul,"},{"id":"seytek-2012:p0776:b002:l020","ordinal":353668,"en":"His worth brought radiance to life."},{"id":"seytek-2012:p0776:b002:l021","ordinal":353669,"en":"His word was never spoken twice,"},{"id":"seytek-2012:p0776:b002:l022","ordinal":353670,"en":"And he watched over the whole universe."},{"id":"seytek-2012:p0776:b002:l023","ordinal":353671,"en":"He received letters from many lands,"},{"id":"seytek-2012:p0776:b002:l024","ordinal":353672,"en":"And forty blessings from Kydyr."},{"id":"seytek-2012:p0776:b002:l025","ordinal":353673,"en":"He became known as precious Bakai,"},{"id":"seytek-2012:p0776:b002:l026","ordinal":353674,"en":"And received blessings from men of wisdom."},{"id":"seytek-2012:p0776:b002:l027","ordinal":353675,"en":"He taught the ignorant to know,"},{"id":"seytek-2012:p0776:b002:l028","ordinal":353676,"en":"And set a thousand upon the right path."},{"id":"seytek-2012:p0776:b002:l029","ordinal":353677,"en":"My forefather, elder Bakai,"},{"id":"seytek-2012:p0776:b002:l030","ordinal":353678,"en":"Before the magnanimous lion"},{"id":"seytek-2012:p0776:b002:l031","ordinal":353679,"en":"Gathered ninety holy men,"},{"id":"seytek-2012:p0776:b002:l032","ordinal":353680,"en":"And had them solemnly perform the marriage."},{"id":"seytek-2012:p0776:b002:l033","ordinal":353681,"en":"Elder Bakai the peacemaker,"},{"id":"seytek-2012:p0776:b002:l034","ordinal":353682,"en":"After giving the poor daughter of Kaiypchal"},{"id":"seytek-2012:p0776:b002:l035","ordinal":353683,"en":"In marriage to the bloodthirsty hero,"},{"id":"seytek-2012:p0776:b002:l036","ordinal":353684,"en":"Like stars in the heavens"},{"id":"seytek-2012:p0776:b002:l037","ordinal":353685,"en":"They stirred together,"},{"id":"seytek-2012:p0776:b002:l038","ordinal":353686,"en":"And the two lions embraced,"},{"id":"seytek-2012:p0776:b002:l039","ordinal":353687,"en":"Lioness and lion together;"},{"id":"seytek-2012:p0776:b002:l040","ordinal":353688,"en":"Once they had united,"},{"id":"seytek-2012:p0776:b003:l001","ordinal":353689,"en":"Like fine white-wheat flour"},{"id":"seytek-2012:p0776:b003:l002","ordinal":353690,"en":"They blended into one,"},{"id":"seytek-2012:p0776:b003:l003","ordinal":353691,"en":"Like the soft down of a white gazelle"},{"id":"seytek-2012:p0776:b003:l004","ordinal":353692,"en":"They slipped together."},{"id":"seytek-2012:p0776:b003:l005","ordinal":353693,"en":"They sank into delight,"},{"id":"seytek-2012:p0776:b003:l006","ordinal":353694,"en":"And lay upon one bed;"},{"id":"seytek-2012:p0776:b003:l007","ordinal":353695,"en":"They settled in a fitting place,"},{"id":"seytek-2012:p0776:b003:l008","ordinal":353696,"en":"And joined as husband and wife."},{"id":"seytek-2012:p0776:b003:l009","ordinal":353697,"en":"Because of a calamitous affair,"},{"id":"seytek-2012:p0776:b003:l010","ordinal":353698,"en":"Sarybai, son of the ogre—"},{"id":"seytek-2012:p0776:b003:l011","ordinal":353699,"en":"For all that Sarybai possessed,"},{"id":"seytek-2012:p0776:b003:l012","ordinal":353700,"en":"Against that infidel son of the ogre"},{"id":"seytek-2012:p0776:b003:l013","ordinal":353701,"en":"A swung sword could not cut,"},{"id":"seytek-2012:p0776:b003:l014","ordinal":353702,"en":"A lion’s teeth could not pierce,"},{"id":"seytek-2012:p0776:b003:l015","ordinal":353703,"en":"And human strength could not prevail."},{"id":"seytek-2012:p0776:b003:l016","ordinal":353704,"en":"Because of Sarybai’s wrath,"},{"id":"seytek-2012:p0776:b003:l017","ordinal":353705,"en":"And the venom he poured upon the people,"},{"id":"seytek-2012:p0776:b003:l018","ordinal":353706,"en":"Brave Semeñ, son of Manas,"},{"id":"seytek-2012:p0776:b003:l019","ordinal":353707,"en":"Took Kuyaly, daughter of Kaiypchal,"},{"id":"seytek-2012:p0776:b003:l020","ordinal":353708,"en":"The champion maiden, as his wife;"},{"id":"seytek-2012:p0776:b003:l021","ordinal":353709,"en":"Then that champion maiden"},{"id":"seytek-2012:p0776:b003:l022","ordinal":353710,"en":"Began the fierce combat."},{"id":"seytek-2012:p0776:b003:l023","ordinal":353711,"en":"The great epic is a mighty wonder;"},{"id":"seytek-2012:p0776:b003:l024","ordinal":353712,"en":"Many times they fought."},{"id":"seytek-2012:p0776:b003:l025","ordinal":353713,"en":"Of savage infidel Sarybai,"},{"id":"seytek-2012:p0776:b003:l026","ordinal":353714,"en":"She told the whole tale."},{"id":"seytek-2012:p0776:b003:l027","ordinal":353715,"en":"Kaiypchal and the Ogre"},{"id":"seytek-2012:p0776:b003:l028","ordinal":353716,"en":"Shared the land where grain was sown,"},{"id":"seytek-2012:p0776:b003:l029","ordinal":353717,"en":"Shared the people in splendid prosperity,"},{"id":"seytek-2012:p0776:b003:l030","ordinal":353718,"en":"And shared the ground of fold and dwelling."},{"id":"seytek-2012:p0776:b003:l031","ordinal":353719,"en":"Speaking of humiliation and hardship,"},{"id":"seytek-2012:p0776:b003:l032","ordinal":353720,"en":"Kuyaly, daughter of Kaiypchal,"},{"id":"seytek-2012:p0776:b003:l033","ordinal":353721,"en":"Entered the great dispute."},{"id":"seytek-2012:p0776:b003:l034","ordinal":353722,"en":"Into a vast calamity with no end,"},{"id":"seytek-2012:p0776:b003:l035","ordinal":353723,"en":"Into the turmoil she plunged."},{"id":"seytek-2012:p0776:b003:l036","ordinal":353724,"en":"She told of the ridge"},{"id":"seytek-2012:p0776:b003:l037","ordinal":353725,"en":"Of a pass no mortal could cross."},{"id":"seytek-2012:p0776:b003:l038","ordinal":353726,"en":"Of the clash with Sarybai,"},{"id":"seytek-2012:p0776:b003:l039","ordinal":353727,"en":"Of countless ordeals and great commotion,"},{"id":"seytek-2012:p0776:b003:l040","ordinal":353728,"en":"She told the whole conflict."},{"id":"seytek-2012:p0777:b002:l001","ordinal":353729,"en":"Of the great quarrel with Sarybai,"},{"id":"seytek-2012:p0777:b002:l002","ordinal":353730,"en":"She began the epic, revealing its secrets."},{"id":"seytek-2012:p0777:b002:l003","ordinal":353731,"en":"The vast ordeal, the deep conflict—"},{"id":"seytek-2012:p0777:b002:l004","ordinal":353732,"en":"That wondrous, mighty epic,"},{"id":"seytek-2012:p0777:b002:l005","ordinal":353733,"en":"She told it all."},{"id":"seytek-2012:p0777:b002:l006","ordinal":353734,"en":"When God granted her wish,"},{"id":"seytek-2012:p0777:b002:l007","ordinal":353735,"en":"The desire and purpose she had sought,"},{"id":"seytek-2012:p0777:b002:l008","ordinal":353736,"en":"When God freely granted it,"},{"id":"seytek-2012:p0777:b002:l009","ordinal":353737,"en":"She drew the reins of fleet-footed Jeljetpes"},{"id":"seytek-2012:p0777:b002:l010","ordinal":353738,"en":"And turned his head."},{"id":"seytek-2012:p0777:b002:l011","ordinal":353739,"en":"The one she would grapple with was Sarybai,"},{"id":"seytek-2012:p0777:b002:l012","ordinal":353740,"en":"Such was the savage enemy."},{"id":"seytek-2012:p0777:b002:l013","ordinal":353741,"en":"Gentle in nature and broad of heart,"},{"id":"seytek-2012:p0777:b002:l014","ordinal":353742,"en":"Such was the champion maiden’s way."},{"id":"seytek-2012:p0777:b002:l015","ordinal":353743,"en":"She turned the horse’s head,"},{"id":"seytek-2012:p0777:b002:l016","ordinal":353744,"en":"And of all the saintly heroes—"},{"id":"seytek-2012:p0777:b002:l017","ordinal":353745,"en":"Lion Bakai and Kanykei,"},{"id":"seytek-2012:p0777:b002:l018","ordinal":353746,"en":"And heroes such as these—"},{"id":"seytek-2012:p0777:b002:l019","ordinal":353747,"en":"She now asked their blessing."},{"id":"seytek-2012:p0777:b002:l020","ordinal":353748,"en":"“Toward sunrise with banners streaming"},{"id":"seytek-2012:p0777:b002:l021","ordinal":353749,"en":"Lay the road I myself once rode."},{"id":"seytek-2012:p0777:b002:l022","ordinal":353750,"en":"That infidel son of the ogre"},{"id":"seytek-2012:p0777:b002:l023","ordinal":353751,"en":"This hand has speared seven times."},{"id":"seytek-2012:p0777:b002:l024","ordinal":353752,"en":"He split lungs and severed heads,"},{"id":"seytek-2012:p0777:b002:l025","ordinal":353753,"en":"Stirred strife and spilled blood;"},{"id":"seytek-2012:p0777:b002:l026","ordinal":353754,"en":"He was an enemy bearing a blood feud."},{"id":"seytek-2012:p0777:b002:l027","ordinal":353755,"en":"Let me wage the battle freely;"},{"id":"seytek-2012:p0777:b002:l028","ordinal":353756,"en":"For the common folk, for the people,"},{"id":"seytek-2012:p0777:b002:l029","ordinal":353757,"en":"Against the savage foe Sarybai,"},{"id":"seytek-2012:p0777:b002:l030","ordinal":353758,"en":"Let me clash in combat."},{"id":"seytek-2012:p0777:b002:l031","ordinal":353759,"en":"My lion father, khan Bakai,"},{"id":"seytek-2012:p0777:b002:l032","ordinal":353760,"en":"My aged mother Kanykei,"},{"id":"seytek-2012:p0777:b002:l033","ordinal":353761,"en":"If you give your blessing, let me receive it."},{"id":"seytek-2012:p0777:b002:l034","ordinal":353762,"en":"For the common folk, for the people,"},{"id":"seytek-2012:p0777:b002:l035","ordinal":353763,"en":"Let me wage the conflict fiercely."},{"id":"seytek-2012:p0777:b002:l036","ordinal":353764,"en":"If true death reaches me, let me die;"},{"id":"seytek-2012:p0777:b002:l037","ordinal":353765,"en":"If what Creator Allah has ordained"},{"id":"seytek-2012:p0777:b002:l038","ordinal":353766,"en":"Falls upon my brow, let me face it."},{"id":"seytek-2012:p0777:b002:l039","ordinal":353767,"en":"For the common folk, for the people,"},{"id":"seytek-2012:p0777:b002:l040","ordinal":353768,"en":"For the lost magnanimous lion,"},{"id":"seytek-2012:p0777:b004:l001","ordinal":353769,"en":"For my lion brother-in-law Külchoro,"},{"id":"seytek-2012:p0777:b004:l002","ordinal":353770,"en":"Above all, for you,"},{"id":"seytek-2012:p0777:b004:l003","ordinal":353771,"en":"For the countless downcast host,"},{"id":"seytek-2012:p0777:b004:l004","ordinal":353772,"en":"For the blue-maned boy Seytek,"},{"id":"seytek-2012:p0777:b004:l005","ordinal":353773,"en":"Let me face the true decree;"},{"id":"seytek-2012:p0777:b004:l006","ordinal":353774,"en":"If true death reaches me, let me die!"},{"id":"seytek-2012:p0777:b004:l007","ordinal":353775,"en":"For all the heroes, for you,"},{"id":"seytek-2012:p0777:b004:l008","ordinal":353776,"en":"Let me sooner behold"},{"id":"seytek-2012:p0777:b004:l009","ordinal":353777,"en":"The true realm whence none return."},{"id":"seytek-2012:p0777:b004:l010","ordinal":353778,"en":"If I am granted days of honor and success,"},{"id":"seytek-2012:p0777:b004:l011","ordinal":353779,"en":"Let me grapple with Sarybai, whom I hunt,"},{"id":"seytek-2012:p0777:b004:l012","ordinal":353780,"en":"And spill his blood."},{"id":"seytek-2012:p0777:b004:l013","ordinal":353781,"en":"Against the enemy who brought my father calamity,"},{"id":"seytek-2012:p0777:b004:l014","ordinal":353782,"en":"Let me strike without mercy."},{"id":"seytek-2012:p0777:b004:l015","ordinal":353783,"en":"From the enemy who oppresses us,"},{"id":"seytek-2012:p0777:b004:l016","ordinal":353784,"en":"Let me avenge six generations of my fathers."},{"id":"seytek-2012:p0777:b004:l017","ordinal":353785,"en":"If I find the means, let me plunge the villain"},{"id":"seytek-2012:p0777:b004:l018","ordinal":353786,"en":"Into grievous misery."},{"id":"seytek-2012:p0777:b004:l019","ordinal":353787,"en":"If the Creator does not will it,"},{"id":"seytek-2012:p0777:b004:l020","ordinal":353788,"en":"Let me die at the infidel’s hands."},{"id":"seytek-2012:p0777:b004:l021","ordinal":353789,"en":"Infidel and Muslim alike—"},{"id":"seytek-2012:p0777:b004:l022","ordinal":353790,"en":"How many people have been beset by war?"},{"id":"seytek-2012:p0777:b004:l023","ordinal":353791,"en":"The one I shall grapple with is Sarybai;"},{"id":"seytek-2012:p0777:b004:l024","ordinal":353792,"en":"Such is the infidel’s nature."}]
