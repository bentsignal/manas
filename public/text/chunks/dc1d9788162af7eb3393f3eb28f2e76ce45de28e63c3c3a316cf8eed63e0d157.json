[{"id":"semetey-1-2013:p0184:b003:l021","ordinal":90881,"en":"This wretched soul bore sorrow."},{"id":"semetey-1-2013:p0184:b003:l022","ordinal":90882,"en":"How could I remain in Ken-Kol?"},{"id":"semetey-1-2013:p0184:b003:l023","ordinal":90883,"en":"If those great dogs kept raving,"},{"id":"semetey-1-2013:p0184:b003:l024","ordinal":90884,"en":"They would torment my only child."},{"id":"semetey-1-2013:p0184:b003:l025","ordinal":90885,"en":"As that dear bird, the wild duck, flies,"},{"id":"semetey-1-2013:p0184:b003:l026","ordinal":90886,"en":"I came seeking the steppe."},{"id":"semetey-1-2013:p0184:b003:l027","ordinal":90887,"en":"Semetey, born of my womb,"},{"id":"semetey-1-2013:p0184:b003:l028","ordinal":90888,"en":"My only hero child, born after long yearning—"},{"id":"semetey-1-2013:p0184:b003:l029","ordinal":90889,"en":"I came for my child!"},{"id":"semetey-1-2013:p0184:b003:l030","ordinal":90890,"en":"Hear my words, Ismayil:"},{"id":"semetey-1-2013:p0184:b003:l031","ordinal":90891,"en":"The pennon fixed to the spear,"},{"id":"semetey-1-2013:p0184:b003:l032","ordinal":90892,"en":"The gift left by the magnanimous one,"},{"id":"semetey-1-2013:p0184:b003:l033","ordinal":90893,"en":"I carried away from Ken-Kol"},{"id":"semetey-1-2013:p0184:b003:l034","ordinal":90894,"en":"And brought him to you."},{"id":"semetey-1-2013:p0184:b003:l035","ordinal":90895,"en":"That Bukhara lying yonder—"},{"id":"semetey-1-2013:p0184:b003:l036","ordinal":90896,"en":"May I perish if I call it my own land!"},{"id":"semetey-1-2013:p0184:b003:l037","ordinal":90897,"en":"This dear child left by happiness,"},{"id":"semetey-1-2013:p0184:b003:l038","ordinal":90898,"en":"Ismayil, may I perish if I call him mine!"},{"id":"semetey-1-2013:p0184:b003:l039","ordinal":90899,"en":"Hang an amulet upon his neck;"},{"id":"semetey-1-2013:p0184:b004:l001","ordinal":90900,"en":"I give him to you wholly."},{"id":"semetey-1-2013:p0184:b004:l002","ordinal":90901,"en":"Ismayil, raise your orphan!"},{"id":"semetey-1-2013:p0184:b004:l003","ordinal":90902,"en":"Do not let the swan be eaten by a hawk;"},{"id":"semetey-1-2013:p0184:b004:l004","ordinal":90903,"en":"This only child born in my misery,"},{"id":"semetey-1-2013:p0184:b004:l005","ordinal":90904,"en":"Let no one call him another man's son!"},{"id":"semetey-1-2013:p0184:b004:l006","ordinal":90905,"en":"Do not let the goose be eaten by a hawk;"},{"id":"semetey-1-2013:p0184:b004:l007","ordinal":90906,"en":"This dear child I rely upon,"},{"id":"semetey-1-2013:p0184:b004:l008","ordinal":90907,"en":"Accept him, I shall give him to you."},{"id":"semetey-1-2013:p0184:b004:l009","ordinal":90908,"en":"My dear little brother,"},{"id":"semetey-1-2013:p0184:b004:l010","ordinal":90909,"en":"Let no one call him another man's son!"},{"id":"semetey-1-2013:p0184:b004:l011","ordinal":90910,"en":"The reason I give him to you:"},{"id":"semetey-1-2013:p0184:b004:l012","ordinal":90911,"en":"Among the Chinese on the ridges,"},{"id":"semetey-1-2013:p0184:b004:l013","ordinal":90912,"en":"There is much vengeance against us."},{"id":"semetey-1-2013:p0184:b004:l014","ordinal":90913,"en":"When my noble lord was alive,"},{"id":"semetey-1-2013:p0184:b004:l015","ordinal":90914,"en":"The Six Cities, the khan of Kokand,"},{"id":"semetey-1-2013:p0184:b004:l016","ordinal":90915,"en":"Down as far as Margilan,"},{"id":"semetey-1-2013:p0184:b004:l017","ordinal":90916,"en":"Broad Andijan, Samarkand—"},{"id":"semetey-1-2013:p0184:b004:l018","ordinal":90917,"en":"He caused them grief and humiliation."},{"id":"semetey-1-2013:p0184:b004:l019","ordinal":90918,"en":"Beating it out of their people,"},{"id":"semetey-1-2013:p0184:b004:l020","ordinal":90919,"en":"Six thousand ingots, a thousand otter pelts,"},{"id":"semetey-1-2013:p0184:b004:l021","ordinal":90920,"en":"Every month beating their people,"},{"id":"semetey-1-2013:p0184:b004:l022","ordinal":90921,"en":"Every month he took tribute."},{"id":"semetey-1-2013:p0184:b004:l023","ordinal":90922,"en":"Unable to bear his levies,"},{"id":"semetey-1-2013:p0184:b004:l024","ordinal":90923,"en":"Every nation was left weeping."},{"id":"semetey-1-2013:p0184:b004:l025","ordinal":90924,"en":"If a man of Kokand caught us,"},{"id":"semetey-1-2013:p0184:b004:l026","ordinal":90925,"en":"His eyes held hidden malice;"},{"id":"semetey-1-2013:p0184:b004:l027","ordinal":90926,"en":"If those people had the strength,"},{"id":"semetey-1-2013:p0184:b004:l028","ordinal":90927,"en":"They would strike me down."},{"id":"semetey-1-2013:p0184:b004:l029","ordinal":90928,"en":"Crookedness was in their words,"},{"id":"semetey-1-2013:p0184:b004:l030","ordinal":90929,"en":"Malice was in their eyes."},{"id":"semetey-1-2013:p0184:b004:l031","ordinal":90930,"en":"If they found their chance,"},{"id":"semetey-1-2013:p0184:b004:l032","ordinal":90931,"en":"They would smash me to pieces."},{"id":"semetey-1-2013:p0184:b004:l033","ordinal":90932,"en":"In hostile places they have vengeance;"},{"id":"semetey-1-2013:p0184:b004:l034","ordinal":90933,"en":"Where grudges were made, grudges remain."},{"id":"semetey-1-2013:p0184:b004:l035","ordinal":90934,"en":"“They will humiliate us”—"},{"id":"semetey-1-2013:p0184:b004:l036","ordinal":90935,"en":"I, your sister Kanykei, have that fear."},{"id":"semetey-1-2013:p0184:b004:l037","ordinal":90936,"en":"Your brother-in-law who has passed away,"},{"id":"semetey-1-2013:p0184:b004:l038","ordinal":90937,"en":"I met him at fourteen;"},{"id":"semetey-1-2013:p0184:b004:l039","ordinal":90938,"en":"At first I remained childless,"},{"id":"semetey-1-2013:p0185:b003:l001","ordinal":90939,"en":"By your brother-in-law I bore"},{"id":"semetey-1-2013:p0185:b003:l002","ordinal":90940,"en":"This orphan here,"},{"id":"semetey-1-2013:p0185:b003:l003","ordinal":90941,"en":"At thirty-two years of age."},{"id":"semetey-1-2013:p0185:b003:l004","ordinal":90942,"en":"Praying to God for an only child,"},{"id":"semetey-1-2013:p0185:b003:l005","ordinal":90943,"en":"I opened my treasury,"},{"id":"semetey-1-2013:p0185:b003:l006","ordinal":90944,"en":"Hoping their blessings might reach me."},{"id":"semetey-1-2013:p0185:b003:l007","ordinal":90945,"en":"My vast treasury of gold,"},{"id":"semetey-1-2013:p0185:b003:l008","ordinal":90946,"en":"To mendicants, the poor, and dervishes,"},{"id":"semetey-1-2013:p0185:b003:l009","ordinal":90947,"en":"To those in want, I scattered it."},{"id":"semetey-1-2013:p0185:b003:l010","ordinal":90948,"en":"Spending my gold,"},{"id":"semetey-1-2013:p0185:b003:l011","ordinal":90949,"en":"I poured it out, leaving none."},{"id":"semetey-1-2013:p0185:b003:l012","ordinal":90950,"en":"Tormenting my soul greatly,"},{"id":"semetey-1-2013:p0185:b003:l013","ordinal":90951,"en":"Exhausting my strength greatly,"},{"id":"semetey-1-2013:p0185:b003:l014","ordinal":90952,"en":"I prayed for my orphan."},{"id":"semetey-1-2013:p0185:b003:l015","ordinal":90953,"en":"A host of saints joined together;"},{"id":"semetey-1-2013:p0185:b003:l016","ordinal":90954,"en":"This child was granted through repentance."},{"id":"semetey-1-2013:p0185:b003:l017","ordinal":90955,"en":"All the saints joined together;"},{"id":"semetey-1-2013:p0185:b003:l018","ordinal":90956,"en":"This child was granted through blessing."},{"id":"semetey-1-2013:p0185:b003:l019","ordinal":90957,"en":"Khan Koshoi of the Katagan,"},{"id":"semetey-1-2013:p0185:b003:l020","ordinal":90958,"en":"My dear father,"},{"id":"semetey-1-2013:p0185:b003:l021","ordinal":90959,"en":"Whose blessing enriched the people,"},{"id":"semetey-1-2013:p0185:b003:l022","ordinal":90960,"en":"Who brought light to those he favored,"},{"id":"semetey-1-2013:p0185:b003:l023","ordinal":90961,"en":"The dear land of Seven Rivers,"},{"id":"semetey-1-2013:p0185:b003:l024","ordinal":90962,"en":"He made it a homeland with his skill."},{"id":"semetey-1-2013:p0185:b003:l025","ordinal":90963,"en":"The Kyrgyz of Seven Rivers,"},{"id":"semetey-1-2013:p0185:b003:l026","ordinal":90964,"en":"He contrived to make them one people."},{"id":"semetey-1-2013:p0185:b003:l027","ordinal":90965,"en":"A saint protected by Shay,"},{"id":"semetey-1-2013:p0185:b003:l028","ordinal":90966,"en":"An old man whose words were healing,"},{"id":"semetey-1-2013:p0185:b003:l029","ordinal":90967,"en":"He gave his hand to seventy saints;"},{"id":"semetey-1-2013:p0185:b003:l030","ordinal":90968,"en":"Seven holy ones opened his road."},{"id":"semetey-1-2013:p0185:b003:l031","ordinal":90969,"en":"At Kokotoi's memorial feast,"},{"id":"semetey-1-2013:p0185:b003:l032","ordinal":90970,"en":"Before the many mighty men,"},{"id":"semetey-1-2013:p0185:b003:l033","ordinal":90971,"en":"Prophet Koshoi joined them;"},{"id":"semetey-1-2013:p0185:b003:l034","ordinal":90972,"en":"Semetey was conceived through his blessing."},{"id":"semetey-1-2013:p0185:b003:l035","ordinal":90973,"en":"This tender gray-mottled falcon of mine,"},{"id":"semetey-1-2013:p0185:b003:l036","ordinal":90974,"en":"This Semetey here,"},{"id":"semetey-1-2013:p0185:b003:l037","ordinal":90975,"en":"My gray goshawk, my morning star,"},{"id":"semetey-1-2013:p0185:b003:l038","ordinal":90976,"en":"My renowned flowing spring,"},{"id":"semetey-1-2013:p0185:b003:l039","ordinal":90977,"en":"My dear child left by my khan."},{"id":"semetey-1-2013:p0185:b005:l001","ordinal":90978,"en":"For him I braided my hair upward,"},{"id":"semetey-1-2013:p0185:b005:l002","ordinal":90979,"en":"I gained him in my extremity."},{"id":"semetey-1-2013:p0185:b005:l003","ordinal":90980,"en":"I have many days still to see;"},{"id":"semetey-1-2013:p0185:b005:l004","ordinal":90981,"en":"Whom have I besides him?"},{"id":"semetey-1-2013:p0185:b005:l005","ordinal":90982,"en":"I opened my mouth and kissed him,"},{"id":"semetey-1-2013:p0185:b005:l006","ordinal":90983,"en":"Opened my eyes and saw him!"},{"id":"semetey-1-2013:p0185:b005:l007","ordinal":90984,"en":"The prince's child—"},{"id":"semetey-1-2013:p0185:b005:l008","ordinal":90985,"en":"How would it be if I gave him willingly?"},{"id":"semetey-1-2013:p0185:b005:l009","ordinal":90986,"en":"“He is left by my khanly brother-in-law,” you might say;"},{"id":"semetey-1-2013:p0185:b005:l011","ordinal":90987,"en":"The prince's only child—"},{"id":"semetey-1-2013:p0185:b005:l012","ordinal":90988,"en":"How would it be if you accepted him willingly?"},{"id":"semetey-1-2013:p0185:b005:l013","ordinal":90989,"en":"The nobleman's child,"},{"id":"semetey-1-2013:p0185:b005:l014","ordinal":90990,"en":"Ismayil, how would it be if I entrusted him to you?"},{"id":"semetey-1-2013:p0185:b005:l015","ordinal":90991,"en":"I have cut his twig;"},{"id":"semetey-1-2013:p0185:b005:l016","ordinal":90992,"en":"Let me perform every rite.’"},{"id":"semetey-1-2013:p0185:b005:l017","ordinal":90993,"en":"She made him pass over the dog's bowl,"},{"id":"semetey-1-2013:p0185:b005:l018","ordinal":90994,"en":"Made him step across the sword's edge,"},{"id":"semetey-1-2013:p0185:b005:l019","ordinal":90995,"en":"And performed his rite."},{"id":"semetey-1-2013:p0185:b005:l020","ordinal":90996,"en":"‘May I perish if I call him my child;"},{"id":"semetey-1-2013:p0185:b005:l021","ordinal":90997,"en":"If I call this one my camel calf,"},{"id":"semetey-1-2013:p0185:b005:l022","ordinal":90998,"en":"May I never prosper!’"},{"id":"semetey-1-2013:p0185:b005:l023","ordinal":90999,"en":"Your noble sister-in-law Kanykei,"},{"id":"semetey-1-2013:p0185:b005:l024","ordinal":91000,"en":"When she gave Semetey to Ismayil,"},{"id":"semetey-1-2013:p0185:b005:l025","ordinal":91001,"en":"Chewed white wheat flour"},{"id":"semetey-1-2013:p0185:b005:l026","ordinal":91002,"en":"And held the sacred Quran."},{"id":"semetey-1-2013:p0185:b005:l027","ordinal":91003,"en":"Kanykei had come in mourning;"},{"id":"semetey-1-2013:p0185:b005:l028","ordinal":91004,"en":"Semetey had come in flight."},{"id":"semetey-1-2013:p0185:b005:l029","ordinal":91005,"en":"Of this deceitful, abundant world,"},{"id":"semetey-1-2013:p0185:b005:l030","ordinal":91006,"en":"She had seen the falsehood now."},{"id":"semetey-1-2013:p0185:b005:l031","ordinal":91007,"en":"Performing many rites,"},{"id":"semetey-1-2013:p0185:b005:l032","ordinal":91008,"en":"She gave the child to Ismayil."},{"id":"semetey-1-2013:p0185:b005:l033","ordinal":91009,"en":"Ismayil took the child,"},{"id":"semetey-1-2013:p0185:b005:l034","ordinal":91010,"en":"Still in his cradle days."},{"id":"semetey-1-2013:p0185:b005:l035","ordinal":91011,"en":"As a rite for the child,"},{"id":"semetey-1-2013:p0185:b005:l036","ordinal":91012,"en":"He dressed him in a coat of mail"},{"id":"semetey-1-2013:p0185:b005:l037","ordinal":91013,"en":"And set the lucky swaddled one"},{"id":"semetey-1-2013:p0185:b005:l038","ordinal":91014,"en":"Upon his great brown horse."},{"id":"semetey-1-2013:p0185:b005:l039","ordinal":91015,"en":"Traveling by night, not by day,"},{"id":"semetey-1-2013:p0186:b003:l001","ordinal":91016,"en":"When they reached Bukhara,"},{"id":"semetey-1-2013:p0186:b003:l002","ordinal":91017,"en":"They feasted for seventeen days,"},{"id":"semetey-1-2013:p0186:b003:l003","ordinal":91018,"en":"Their poles bending,"},{"id":"semetey-1-2013:p0186:b003:l004","ordinal":91019,"en":"Their heroes jousting."},{"id":"semetey-1-2013:p0186:b003:l005","ordinal":91020,"en":"Calling it ‘Semetey's feast,’"},{"id":"semetey-1-2013:p0186:b003:l006","ordinal":91021,"en":"The treasury of four kinds of livestock,"},{"id":"semetey-1-2013:p0186:b003:l007","ordinal":91022,"en":"Ismayil the lord"},{"id":"semetey-1-2013:p0186:b003:l008","ordinal":91023,"en":"Opened wide from the top."},{"id":"semetey-1-2013:p0186:b003:l009","ordinal":91024,"en":"All four kinds of livestock"},{"id":"semetey-1-2013:p0186:b003:l010","ordinal":91025,"en":"He spent and scattered generously."},{"id":"semetey-1-2013:p0186:b003:l011","ordinal":91026,"en":"Russians ate at the feast and departed,"},{"id":"semetey-1-2013:p0186:b003:l012","ordinal":91027,"en":"Saying, ‘If this son of yours lives,"},{"id":"semetey-1-2013:p0186:b003:l013","ordinal":91028,"en":"He will overthrow the Oirats.’"},{"id":"semetey-1-2013:p0186:b003:l014","ordinal":91029,"en":"At Semetey's feast,"},{"id":"semetey-1-2013:p0186:b003:l015","ordinal":91030,"en":"Chinese ate and departed,"},{"id":"semetey-1-2013:p0186:b003:l016","ordinal":91031,"en":"Saying, ‘If this child lives,"},{"id":"semetey-1-2013:p0186:b003:l017","ordinal":91032,"en":"He will overthrow the world.’"},{"id":"semetey-1-2013:p0186:b003:l018","ordinal":91033,"en":"All the long, malicious talk"},{"id":"semetey-1-2013:p0186:b003:l019","ordinal":91034,"en":"Had its mouth shut completely."},{"id":"semetey-1-2013:p0186:b003:l020","ordinal":91035,"en":"Your orphan left by Manas"},{"id":"semetey-1-2013:p0186:b003:l021","ordinal":91036,"en":"Entered Bukhara and was raised there."},{"id":"semetey-1-2013:p0186:b003:l022","ordinal":91037,"en":"Temir Khan, the khan of Bukhara,"},{"id":"semetey-1-2013:p0186:b003:l023","ordinal":91038,"en":"He too, Kanykei's father,"},{"id":"semetey-1-2013:p0186:b003:l024","ordinal":91039,"en":"Wore a golden crown"},{"id":"semetey-1-2013:p0186:b003:l025","ordinal":91040,"en":"And sat upon a golden throne."},{"id":"semetey-1-2013:p0186:b003:l026","ordinal":91041,"en":"He heard from Ismayil:"},{"id":"semetey-1-2013:p0186:b003:l027","ordinal":91042,"en":"‘Dear child Kanykei,"},{"id":"semetey-1-2013:p0186:b003:l028","ordinal":91043,"en":"Parted from Khan Manas,"},{"id":"semetey-1-2013:p0186:b003:l029","ordinal":91044,"en":"The countless riches Manas left,"},{"id":"semetey-1-2013:p0186:b003:l030","ordinal":91045,"en":"She scattered and came,’ he heard."},{"id":"semetey-1-2013:p0186:b003:l031","ordinal":91046,"en":"‘With no kin to look to,"},{"id":"semetey-1-2013:p0186:b003:l032","ordinal":91047,"en":"Carrying the child upon her back,"},{"id":"semetey-1-2013:p0186:b003:l033","ordinal":91048,"en":"She wandered astray and came,’ he heard."},{"id":"semetey-1-2013:p0186:b003:l034","ordinal":91049,"en":"Without slippers, in stockings,"},{"id":"semetey-1-2013:p0186:b003:l035","ordinal":91050,"en":"Her poor soul did not die of grief."},{"id":"semetey-1-2013:p0186:b003:l036","ordinal":91051,"en":"Without boots, in stockings,"},{"id":"semetey-1-2013:p0186:b003:l037","ordinal":91052,"en":"If her angel of death has not come,"},{"id":"semetey-1-2013:p0186:b003:l038","ordinal":91053,"en":"Her poor soul will not die of sobbing."},{"id":"semetey-1-2013:p0186:b003:l039","ordinal":91054,"en":"‘All the property they had gathered,"},{"id":"semetey-1-2013:p0186:b004:l001","ordinal":91055,"en":"My wretched child Kanykei"},{"id":"semetey-1-2013:p0186:b004:l002","ordinal":91056,"en":"Scattered and came, I heard."},{"id":"semetey-1-2013:p0186:b004:l003","ordinal":91057,"en":"When leopard Manas died,"},{"id":"semetey-1-2013:p0186:b004:l004","ordinal":91058,"en":"She fled and came, I heard."},{"id":"semetey-1-2013:p0186:b004:l005","ordinal":91059,"en":"Her felt coat flapping,"},{"id":"semetey-1-2013:p0186:b004:l006","ordinal":91060,"en":"Riding a brown mare and jolting,"},{"id":"semetey-1-2013:p0186:b004:l007","ordinal":91061,"en":"Hurting her heels,"},{"id":"semetey-1-2013:p0186:b004:l008","ordinal":91062,"en":"Chafing the soles of her feet,"},{"id":"semetey-1-2013:p0186:b004:l009","ordinal":91063,"en":"Her legs losing strength at every step,"},{"id":"semetey-1-2013:p0186:b004:l010","ordinal":91064,"en":"Dark blood flowing from her soles,"},{"id":"semetey-1-2013:p0186:b004:l011","ordinal":91065,"en":"Left all on her own,"},{"id":"semetey-1-2013:p0186:b004:l012","ordinal":91066,"en":"Parted from her bloodthirsty hero,"},{"id":"semetey-1-2013:p0186:b004:l013","ordinal":91067,"en":"At thirty-two years of age,"},{"id":"semetey-1-2013:p0186:b004:l014","ordinal":91068,"en":"Though she lamented, God would not take her."},{"id":"semetey-1-2013:p0186:b004:l015","ordinal":91069,"en":"The slave Abyke's whip"},{"id":"semetey-1-2013:p0186:b004:l016","ordinal":91070,"en":"Left no part of her fleshy buttocks untouched."},{"id":"semetey-1-2013:p0186:b004:l017","ordinal":91071,"en":"My child Kanykei,"},{"id":"semetey-1-2013:p0186:b004:l018","ordinal":91072,"en":"Youngest of twelve daughters,"},{"id":"semetey-1-2013:p0186:b004:l019","ordinal":91073,"en":"God's beloved mortal,"},{"id":"semetey-1-2013:p0186:b004:l020","ordinal":91074,"en":"Beauty of the dark-complexioned,"},{"id":"semetey-1-2013:p0186:b004:l021","ordinal":91075,"en":"My foal, radiant among Muslims."},{"id":"semetey-1-2013:p0186:b004:l022","ordinal":91076,"en":"When she reached six,"},{"id":"semetey-1-2013:p0186:b004:l023","ordinal":91077,"en":"My noble child Kanykei,"},{"id":"semetey-1-2013:p0186:b004:l024","ordinal":91078,"en":"I cherished her and braided her hair."},{"id":"semetey-1-2013:p0186:b004:l025","ordinal":91079,"en":"When she reached nine,"},{"id":"semetey-1-2013:p0186:b004:l026","ordinal":91080,"en":"More than ninety ranks of sons,"},{"id":"semetey-1-2013:p0186:b004:l027","ordinal":91081,"en":"I loved her, as I still do today."},{"id":"semetey-1-2013:p0186:b004:l028","ordinal":91082,"en":"When she reached ten,"},{"id":"semetey-1-2013:p0186:b004:l029","ordinal":91083,"en":"My plane tree, my fortress with gates."},{"id":"semetey-1-2013:p0186:b004:l030","ordinal":91084,"en":"When she reached twelve,"},{"id":"semetey-1-2013:p0186:b004:l031","ordinal":91085,"en":"Though a girl, Kanykei"},{"id":"semetey-1-2013:p0186:b004:l032","ordinal":91086,"en":"Was my dark-browed hawk."},{"id":"semetey-1-2013:p0186:b004:l033","ordinal":91087,"en":"As she neared thirteen,"},{"id":"semetey-1-2013:p0186:b004:l034","ordinal":91088,"en":"She shook the world and stirred the people."},{"id":"semetey-1-2013:p0186:b004:l035","ordinal":91089,"en":"When she reached fourteen,"},{"id":"semetey-1-2013:p0186:b004:l036","ordinal":91090,"en":"Her courage made her bold;"},{"id":"semetey-1-2013:p0186:b004:l037","ordinal":91091,"en":"She met Hero Manas."},{"id":"semetey-1-2013:p0186:b004:l038","ordinal":91092,"en":"When she reached fifteen,"},{"id":"semetey-1-2013:p0186:b004:l039","ordinal":91093,"en":"Renowned Manas—"},{"id":"semetey-1-2013:p0187:b003:l001","ordinal":91094,"en":"She planted him and made a garden,"},{"id":"semetey-1-2013:p0187:b003:l002","ordinal":91095,"en":"Joined what had been severed,"},{"id":"semetey-1-2013:p0187:b003:l003","ordinal":91096,"en":"Gathered what had been scattered,"},{"id":"semetey-1-2013:p0187:b003:l004","ordinal":91097,"en":"Kindled his extinguished fire,"},{"id":"semetey-1-2013:p0187:b003:l005","ordinal":91098,"en":"Revived his deadened soul."},{"id":"semetey-1-2013:p0187:b003:l006","ordinal":91099,"en":"She pursued claims together with him;"},{"id":"semetey-1-2013:p0187:b003:l007","ordinal":91100,"en":"If there were foes, she fought them with him."},{"id":"semetey-1-2013:p0187:b003:l008","ordinal":91101,"en":"Manas, whom Khizyr had touched,"},{"id":"semetey-1-2013:p0187:b003:l009","ordinal":91102,"en":"My precious daughter met him."},{"id":"semetey-1-2013:p0187:b003:l010","ordinal":91103,"en":"Manas, whom the prophet had touched,"},{"id":"semetey-1-2013:p0187:b003:l011","ordinal":91104,"en":"My sovereign daughter encountered him."},{"id":"semetey-1-2013:p0187:b003:l012","ordinal":91105,"en":"This child of mine, Kanykei,"},{"id":"semetey-1-2013:p0187:b003:l013","ordinal":91106,"en":"When she stayed with Khan Manas,"},{"id":"semetey-1-2013:p0187:b003:l014","ordinal":91107,"en":"Was a firmly established house."},{"id":"semetey-1-2013:p0187:b003:l015","ordinal":91108,"en":"The sovereign among women,"},{"id":"semetey-1-2013:p0187:b003:l016","ordinal":91109,"en":"My child was khan to the world."},{"id":"semetey-1-2013:p0187:b003:l017","ordinal":91110,"en":"Two reins and a single lead rope,"},{"id":"semetey-1-2013:p0187:b003:l018","ordinal":91111,"en":"Held firmly about her wrist,"},{"id":"semetey-1-2013:p0187:b003:l019","ordinal":91112,"en":"This was the child who took them up."},{"id":"semetey-1-2013:p0187:b003:l020","ordinal":91113,"en":"Kneading the people like dough,"},{"id":"semetey-1-2013:p0187:b003:l021","ordinal":91114,"en":"This was the child who ruled them."},{"id":"semetey-1-2013:p0187:b003:l022","ordinal":91115,"en":"An iron rope across her path—"},{"id":"semetey-1-2013:p0187:b003:l023","ordinal":91116,"en":"Have you seen it become a snare?"},{"id":"semetey-1-2013:p0187:b003:l024","ordinal":91117,"en":"Parted from her ocean,"},{"id":"semetey-1-2013:p0187:b003:l025","ordinal":91118,"en":"Bekzaada's wife"},{"id":"semetey-1-2013:p0187:b003:l026","ordinal":91119,"en":"Wandering into Bukhara,"},{"id":"semetey-1-2013:p0187:b003:l027","ordinal":91120,"en":"Have you seen her humiliated?"},{"id":"semetey-1-2013:p0187:b003:l028","ordinal":91121,"en":"Alas, her forehead bone was curved;"},{"id":"semetey-1-2013:p0187:b003:l029","ordinal":91122,"en":"After the hero passed away,"},{"id":"semetey-1-2013:p0187:b003:l030","ordinal":91123,"en":"My child's prospect of living was meager."},{"id":"semetey-1-2013:p0187:b003:l031","ordinal":91124,"en":"The hair down her back was like grass;"},{"id":"semetey-1-2013:p0187:b003:l032","ordinal":91125,"en":"Her ruin outweighed her happiness"},{"id":"semetey-1-2013:p0187:b003:l033","ordinal":91126,"en":"By many a spear's length."},{"id":"semetey-1-2013:p0187:b003:l034","ordinal":91127,"en":"Though a girl, Kanykei"},{"id":"semetey-1-2013:p0187:b003:l035","ordinal":91128,"en":"Had everything in balance;"},{"id":"semetey-1-2013:p0187:b003:l036","ordinal":91129,"en":"She was a lion protected by Shay."},{"id":"semetey-1-2013:p0187:b003:l037","ordinal":91130,"en":"Gathering harriers and making hunting birds,"},{"id":"semetey-1-2013:p0187:b003:l038","ordinal":91131,"en":"She was one of those wretched slavewomen."},{"id":"semetey-1-2013:p0187:b003:l039","ordinal":91132,"en":"This wretched child of mine, Kanykei,"},{"id":"semetey-1-2013:p0187:b005:l001","ordinal":91133,"en":"Gathered mixed peoples and made a nation,"},{"id":"semetey-1-2013:p0187:b005:l002","ordinal":91134,"en":"Raised small falcons into hunting birds,"},{"id":"semetey-1-2013:p0187:b005:l003","ordinal":91135,"en":"Gathered wanderers and made a people."},{"id":"semetey-1-2013:p0187:b005:l004","ordinal":91136,"en":"If someone came without strength,"}]
