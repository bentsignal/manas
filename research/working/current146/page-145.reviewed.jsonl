{"id": "sayakbay-ms-current146:pdf145:l001", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 1, "raw": "Белегиң билинди,", "text": "Белегиң билинди,", "en": "Your sign has become known,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l002", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 2, "raw": "Ойрон болгон Озу кан,", "text": "Ойрон болгон Озу кан,", "en": "Ozu Khan, who brought devastation,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l003", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 3, "raw": "Оройлондуң Коңорчун,", "text": "Оройлондуң Коңорчун,", "en": "You grew arrogant, Koñorchun,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l004", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 4, "raw": "Орой тилиң кармады,", "text": "Орой тилиң кармады,", "en": "Your insolent tongue took hold,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l005", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 5, "raw": "Балбанды сордуруп,", "text": "Балбанды сордуруп,", "en": "Draining the champions,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 6, "raw": "Беттешкенин сен билип,", "text": "Беттешкенин сен билип,", "en": "Knowing those who faced you,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 7, "raw": "Ат кулак чондой ороюн.", "text": "Ат кулак чондой ороюн.", "en": "I shall envelop you like a horse’s ear.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 8, "raw": "Чапчыласаң чаң балекет,", "text": "Чапчыласаң чаң балекет,", "en": "If you lash out, dusty calamity rises,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 9, "raw": "Кабылса кайсаар мергендин,", "text": "Кабылса кайсаар мергендин,", "en": "If you encounter the unyielding marksman,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 10, "raw": "Адам айтат журт билген,", "text": "Адам айтат журт билген,", "en": "People speak of what the nation knows,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 11, "raw": "Кара таштан козголуп,", "text": "Кара таштан козголуп,", "en": "Stirring from the black stone,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 12, "raw": "Мен хан Озу кан озунуп,", "text": "Мен хан Озу кан озунуп,", "en": "I, Khan Ozu, surged ahead,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l013", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 13, "raw": "Мен Каганга турганда,", "text": "Мен Каганга турганда,", "en": "When I stood before the Khagan,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 14, "raw": "Темир туулга кийгеним,", "text": "Темир туулга кийгеним,", "en": "I put on the iron helmet,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 15, "raw": "Адам карап жең түрүп,", "text": "Адам карап жең түрүп,", "en": "Facing men, I rolled up my sleeves,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 16, "raw": "Жастык адам болгонум,", "text": "Жастык адам болгонум,", "en": "I was a man of youth,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 17, "raw": "Озу кан атка конгону,", "text": "Озу кан атка конгону,", "en": "Ozu Khan mounted his horse,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 18, "raw": "Кан болуп калкты билгени,", "text": "Кан болуп калкты билгени,", "en": "And as khan ruled the people,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 19, "raw": "Арбайып атка мингени,", "text": "Арбайып атка мингени,", "en": "Towering as he mounted the horse,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 20, "raw": "Адам болуп жүргөнү,", "text": "Адам болуп жүргөнү,", "en": "Living his life as a man,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 21, "raw": "Кандайлык каарың айканы,", "text": "Кандайлык каарың айканы,", "en": "What manner of wrath you displayed,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 22, "raw": "Тышы журт албай койгонуң,", "text": "Тышы журт албай койгонуң,", "en": "The outer peoples would not accept you,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 23, "raw": "Кара кыргыз уруу журт,", "text": "Кара кыргыз уруу журт,", "en": "The tribal people of the Black Kyrgyz,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l024", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 24, "raw": "Каарманың калың токсон деп,", "text": "Каарманың калың токсон деп,", "en": "Calling your warriors ninety strong,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 25, "raw": "Беттешкенин бүт кылып,", "text": "Беттешкенин бүт кылып,", "en": "Finishing all who faced you,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 26, "raw": "Калың журт токсон деп,", "text": "Калың журт токсон деп,", "en": "Calling the numerous host ninety,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 27, "raw": "Кахарбай эрен жеңем деп,", "text": "Кахарбай эрен жеңем деп,", "en": "Saying the hero Kakharbay would triumph,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 28, "raw": "Кермеш кыла жүрөм деп,", "text": "Кермеш кыла жүрөм деп,", "en": "Saying I would continue the struggle,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 29, "raw": "Кондоң кылган буркандан,", "text": "Кондоң кылган буркандан,", "en": "From the idol that made him bow,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 30, "raw": "Ишиң минет өзүнөн,", "text": "Ишиң минет өзүнөн,", "en": "Your deeds will ride back upon you,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 31, "raw": "Үшүнү орош жүрөмүн,", "text": "Үшүнү орош жүрөмүн,", "en": "I shall go wrapped in resolve,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 32, "raw": "Каалаганым кабыл ал,", "text": "Каалаганым кабыл ал,", "en": "Accept what I desire,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf145:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 145, "folio": 528, "line_in_page": 33, "raw": "Кубанчым ирең жадырсын.", "text": "Кубанчым ирең жадырсын.", "en": "May my joy brighten my face.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
