[{"id":"manas-2010:p0487:b001:l019","ordinal":22273,"en":"The sun could not be distinguished through the swarms;"},{"id":"manas-2010:p0487:b001:l020","ordinal":22274,"en":"Not a single stalk upon the earth was seen."},{"id":"manas-2010:p0487:b001:l021","ordinal":22275,"en":"The sky was clear, the earth overcast;"},{"id":"manas-2010:p0487:b001:l022","ordinal":22276,"en":"Piercing shouts, an uproar,"},{"id":"manas-2010:p0487:b001:l023","ordinal":22277,"en":"The unbelievers swept forward and clashed,"},{"id":"manas-2010:p0487:b001:l024","ordinal":22278,"en":"Unleashing a tumult."},{"id":"manas-2010:p0487:b001:l025","ordinal":22279,"en":"Dust covered the face of the world;"},{"id":"manas-2010:p0487:b001:l026","ordinal":22280,"en":"A ground-hugging mist descended."},{"id":"manas-2010:p0487:b001:l027","ordinal":22281,"en":"The muskets' voices boomed."},{"id":"manas-2010:p0487:b001:l028","ordinal":22282,"en":"If you looked to this side,"},{"id":"manas-2010:p0487:b001:l029","ordinal":22283,"en":"Beating the dense army,"},{"id":"manas-2010:p0487:b001:l030","ordinal":22284,"en":"Zholoy drove them, thundering."},{"id":"manas-2010:p0487:b001:l031","ordinal":22285,"en":"When he saw these deeds,"},{"id":"manas-2010:p0487:b001:l032","ordinal":22286,"en":"To bind the hero,"},{"id":"manas-2010:p0487:b001:l033","ordinal":22287,"en":"Arrows from bows rasped,"},{"id":"manas-2010:p0487:b001:l034","ordinal":22288,"en":"Arrows from quivers whistled."},{"id":"manas-2010:p0487:b001:l035","ordinal":22289,"en":"What the Chinese fired:"},{"id":"manas-2010:p0487:b001:l036","ordinal":22290,"en":"Destructive bows, lacquered arrows."},{"id":"manas-2010:p0487:b001:l037","ordinal":22291,"en":"When they migrated from Altai,"},{"id":"manas-2010:p0487:b001:l038","ordinal":22292,"en":"Esenkan gave the command—"},{"id":"manas-2010:p0487:b001:l039","ordinal":22293,"en":"This was the trouble the Chinese caused."},{"id":"manas-2010:p0487:b001:l040","ordinal":22294,"en":"Manas had lost his horse,"},{"id":"manas-2010:p0487:b001:l041","ordinal":22295,"en":"His rib bones torn apart,"},{"id":"manas-2010:p0487:b001:l042","ordinal":22296,"en":"He seemed stricken with grief."},{"id":"manas-2010:p0488:b001:l001","ordinal":22297,"en":"Grieving for Toruchaar,"},{"id":"manas-2010:p0488:b001:l002","ordinal":22298,"en":"Know his greatness from this:"},{"id":"manas-2010:p0488:b001:l003","ordinal":22299,"en":"Untroubled by the buzzing,"},{"id":"manas-2010:p0488:b001:l004","ordinal":22300,"en":"The Black Chinese and Manchus,"},{"id":"manas-2010:p0488:b001:l005","ordinal":22301,"en":"Your lion stood there,"},{"id":"manas-2010:p0488:b001:l006","ordinal":22302,"en":"Not reckoning them worth his trouser cuff."},{"id":"manas-2010:p0488:b001:l007","ordinal":22303,"en":"Girded with a silver belt,"},{"id":"manas-2010:p0488:b001:l008","ordinal":22304,"en":"That thundering hero's"},{"id":"manas-2010:p0488:b001:l009","ordinal":22305,"en":"Sunlike face was touched by light."},{"id":"manas-2010:p0488:b001:l010","ordinal":22306,"en":"Girded with a golden belt,"},{"id":"manas-2010:p0488:b001:l011","ordinal":22307,"en":"Your magnanimous one's"},{"id":"manas-2010:p0488:b001:l012","ordinal":22308,"en":"Moonlike face was touched by light."},{"id":"manas-2010:p0488:b001:l013","ordinal":22309,"en":"The Manchus and Chinese trembled."},{"id":"manas-2010:p0488:b001:l014","ordinal":22310,"en":"Those who reached him farther away,"},{"id":"manas-2010:p0488:b001:l015","ordinal":22311,"en":"He struck once with his spear;"},{"id":"manas-2010:p0488:b001:l016","ordinal":22312,"en":"Those who came nearer,"},{"id":"manas-2010:p0488:b001:l017","ordinal":22313,"en":"He struck once with his battle-axe."},{"id":"manas-2010:p0488:b001:l018","ordinal":22314,"en":"Bozkelte in his hand,"},{"id":"manas-2010:p0488:b001:l019","ordinal":22315,"en":"Leaning to the right, he fired once."},{"id":"manas-2010:p0488:b003:l001","ordinal":22316,"en":"When he looked at the billowing dust,"},{"id":"manas-2010:p0488:b003:l002","ordinal":22317,"en":"Honking like a young goose,"},{"id":"manas-2010:p0488:b003:l003","ordinal":22318,"en":"His white beard flashing,"},{"id":"manas-2010:p0488:b003:l004","ordinal":22319,"en":"It was your elder Koshoy."},{"id":"manas-2010:p0488:b003:l005","ordinal":22320,"en":"Kerkabylan was his swift horse;"},{"id":"manas-2010:p0488:b003:l006","ordinal":22321,"en":"Joining in the contest,"},{"id":"manas-2010:p0488:b003:l007","ordinal":22322,"en":"This was the tumult Koshoy brought."},{"id":"manas-2010:p0488:b003:l008","ordinal":22323,"en":"Your elder, old Koshoy,"},{"id":"manas-2010:p0488:b003:l009","ordinal":22324,"en":"A saint beyond other men—"},{"id":"manas-2010:p0488:b003:l010","ordinal":22325,"en":"Too many cares to fit his breast,"},{"id":"manas-2010:p0488:b003:l011","ordinal":22326,"en":"Sultan wolf-man Manas's"},{"id":"manas-2010:p0488:b003:l012","ordinal":22327,"en":"Tears flowed in ten channels."},{"id":"manas-2010:p0488:b003:l013","ordinal":22328,"en":"“If my end comes, I shall die,” he said,"},{"id":"manas-2010:p0488:b003:l014","ordinal":22329,"en":"“For my bloodthirsty lion Manas,"},{"id":"manas-2010:p0488:b003:l015","ordinal":22330,"en":"In my old age, I, Koshoy,"},{"id":"manas-2010:p0488:b003:l016","ordinal":22331,"en":"Shall be a support,” he said."},{"id":"manas-2010:p0488:b003:l017","ordinal":22332,"en":"That most courageous warrior,"},{"id":"manas-2010:p0488:b003:l018","ordinal":22333,"en":"Forged like blue iron,"},{"id":"manas-2010:p0489:b001:l001","ordinal":22334,"en":"Taking twelve thousand troops,"},{"id":"manas-2010:p0489:b001:l002","ordinal":22335,"en":"Laying their mighty ones low,"},{"id":"manas-2010:p0489:b001:l003","ordinal":22336,"en":"Leaning to the left, he fired once,"},{"id":"manas-2010:p0489:b001:l004","ordinal":22337,"en":"Laying their sultans low."},{"id":"manas-2010:p0489:b001:l005","ordinal":22338,"en":"When he turned his back, upon the magnanimous one"},{"id":"manas-2010:p0489:b001:l006","ordinal":22339,"en":"The unbelievers came shrieking."},{"id":"manas-2010:p0489:b001:l007","ordinal":22340,"en":"When he looked before him,"},{"id":"manas-2010:p0489:b001:l008","ordinal":22341,"en":"Of the Chinese with rank buttons on their caps,"},{"id":"manas-2010:p0489:b001:l009","ordinal":22342,"en":"Their bald men then"},{"id":"manas-2010:p0489:b001:l010","ordinal":22343,"en":"Kept fleeing in a rush."},{"id":"manas-2010:p0489:b001:l011","ordinal":22344,"en":"Their heroes gasped for breath;"},{"id":"manas-2010:p0489:b001:l012","ordinal":22345,"en":"When he shouted and thrust his spear,"},{"id":"manas-2010:p0489:b001:l013","ordinal":22346,"en":"The Manchus bristled."},{"id":"manas-2010:p0489:b001:l014","ordinal":22347,"en":"When they stood surrounding him,"},{"id":"manas-2010:p0489:b001:l015","ordinal":22348,"en":"From the open, curved saddle-pass,"},{"id":"manas-2010:p0489:b001:l016","ordinal":22349,"en":"From the low ground horses could cross,"},{"id":"manas-2010:p0489:b001:l017","ordinal":22350,"en":"From the fescue-covered rise,"},{"id":"manas-2010:p0489:b001:l018","ordinal":22351,"en":"From the broad ground with high passes,"},{"id":"manas-2010:p0489:b001:l019","ordinal":22352,"en":"Dust surged up in waves."},{"id":"manas-2010:p0489:b001:l020","ordinal":22353,"en":"When they saw the surging dust,"},{"id":"manas-2010:p0489:b001:l021","ordinal":22354,"en":"The forty-tribed Chinese and Ezkara—"},{"id":"manas-2010:p0489:b001:l022","ordinal":22355,"en":"These two were frightened out of their lives."},{"id":"manas-2010:p0489:b001:l023","ordinal":22356,"en":"Keeping his army together, not scattering it,"},{"id":"manas-2010:p0489:b001:l024","ordinal":22357,"en":"Taking giants from the Muslims,"},{"id":"manas-2010:p0489:b001:l025","ordinal":22358,"en":"Taking all the courageous men,"},{"id":"manas-2010:p0489:b001:l026","ordinal":22359,"en":"“I shall camp along Altai,” he said,"},{"id":"manas-2010:p0489:b001:l027","ordinal":22360,"en":"“For bloodthirsty, magnanimous Manas,"},{"id":"manas-2010:p0489:b001:l028","ordinal":22361,"en":"I shall be a backing,” he said."},{"id":"manas-2010:p0489:b001:l029","ordinal":22362,"en":"“If my end comes, I shall die,” he said,"},{"id":"manas-2010:p0489:b001:l030","ordinal":22363,"en":"“For bloodthirsty wolf-man Manas,"},{"id":"manas-2010:p0489:b001:l031","ordinal":22364,"en":"I shall be a support,” he said."},{"id":"manas-2010:p0489:b001:l032","ordinal":22365,"en":"The earth was veiled in mist and dust;"},{"id":"manas-2010:p0489:b001:l033","ordinal":22366,"en":"The rousing battle cry came alive."},{"id":"manas-2010:p0489:b001:l034","ordinal":22367,"en":"His heroes grew excited;"},{"id":"manas-2010:p0489:b001:l035","ordinal":22368,"en":"Those who never drew back from death,"},{"id":"manas-2010:p0489:b001:l036","ordinal":22369,"en":"All the renowned ones,"},{"id":"manas-2010:p0489:b001:l037","ordinal":22370,"en":"Roused themselves in the vanguard."},{"id":"manas-2010:p0489:b001:l038","ordinal":22371,"en":"Earth flew into the sky;"},{"id":"manas-2010:p0489:b001:l039","ordinal":22372,"en":"The dense army thundered, crying “Go!”"},{"id":"manas-2010:p0489:b001:l040","ordinal":22373,"en":"Lacquered spearpoints flashed;"},{"id":"manas-2010:p0489:b001:l041","ordinal":22374,"en":"Brass horns clattered."},{"id":"manas-2010:p0489:b001:l042","ordinal":22375,"en":"The earth was veiled in mist and dust,"},{"id":"manas-2010:p0490:b001:l001","ordinal":22376,"en":"Khan Koshoy of the Katagan,"},{"id":"manas-2010:p0490:b001:l002","ordinal":22377,"en":"He was the standard-bearer."},{"id":"manas-2010:p0490:b001:l003","ordinal":22378,"en":"His white turban like a cauldron,"},{"id":"manas-2010:p0490:b001:l004","ordinal":22379,"en":"His shout like the call to prayer:"},{"id":"manas-2010:p0490:b001:l005","ordinal":22380,"en":"“If death comes, I shall die,” he said,"},{"id":"manas-2010:p0490:b001:l006","ordinal":22381,"en":"“For the Muslims, small as a palm,"},{"id":"manas-2010:p0490:b001:l007","ordinal":22382,"en":"For their dead, then,"},{"id":"manas-2010:p0490:b001:l008","ordinal":22383,"en":"I shall serve as prayer leader,” he said."},{"id":"manas-2010:p0490:b001:l009","ordinal":22384,"en":"Aykhozho in a motley robe,"},{"id":"manas-2010:p0490:b001:l010","ordinal":22385,"en":"He had come from Andijan,"},{"id":"manas-2010:p0490:b001:l011","ordinal":22386,"en":"Wrapping his belt as a turban,"},{"id":"manas-2010:p0490:b001:l012","ordinal":22387,"en":"Beseeching divine power,"},{"id":"manas-2010:p0490:b001:l013","ordinal":22388,"en":"A great cleric from Bukhara."},{"id":"manas-2010:p0490:b001:l014","ordinal":22389,"en":"His army too was abundant;"},{"id":"manas-2010:p0490:b001:l015","ordinal":22390,"en":"Still more were on the road."},{"id":"manas-2010:p0490:b001:l016","ordinal":22391,"en":"Rope cruppers, rope girths,"},{"id":"manas-2010:p0490:b001:l017","ordinal":22392,"en":"All the mounts were stallions;"},{"id":"manas-2010:p0490:b001:l018","ordinal":22393,"en":"Still more were upon camel saddles."},{"id":"manas-2010:p0490:b001:l019","ordinal":22394,"en":"Aydarkan of the Kazakhs,"},{"id":"manas-2010:p0490:b001:l020","ordinal":22395,"en":"His dust billowing from the valley,"},{"id":"manas-2010:p0490:b001:l021","ordinal":22396,"en":"Shouting out his songs,"},{"id":"manas-2010:p0490:b001:l022","ordinal":22397,"en":"The Kazakh army was a separate host."},{"id":"manas-2010:p0490:b001:l023","ordinal":22398,"en":"His white beard an armful,"},{"id":"manas-2010:p0490:b001:l024","ordinal":22399,"en":"Muzburchak, khan of Khiva."},{"id":"manas-2010:p0490:b001:l025","ordinal":22400,"en":"No one dared face him;"},{"id":"manas-2010:p0490:b001:l026","ordinal":22401,"en":"No mortal could force him down and take him."},{"id":"manas-2010:p0490:b001:l027","ordinal":22402,"en":"Dwelling in Buzulgan-Chambyl,"},{"id":"manas-2010:p0490:b001:l028","ordinal":22403,"en":"No mortal could force him down and defeat him."},{"id":"manas-2010:p0490:b001:l029","ordinal":22404,"en":"Ready whenever war was named,"},{"id":"manas-2010:p0490:b001:l030","ordinal":22405,"en":"Each man at his side"},{"id":"manas-2010:p0490:b001:l031","ordinal":22406,"en":"Had a knife like a sword bound on."},{"id":"manas-2010:p0490:b001:l032","ordinal":22407,"en":"“If death comes, I shall die,” he said,"},{"id":"manas-2010:p0490:b001:l033","ordinal":22408,"en":"“For precious young Manas,"},{"id":"manas-2010:p0490:b001:l034","ordinal":22409,"en":"I shall be a support,” he said."},{"id":"manas-2010:p0490:b001:l035","ordinal":22410,"en":"Khan Buudayyk himself was there."},{"id":"manas-2010:p0490:b001:l036","ordinal":22411,"en":"Hapless Koshoy's companion,"},{"id":"manas-2010:p0490:b001:l037","ordinal":22412,"en":"Kudaynazar—Kuuchokmor,"},{"id":"manas-2010:p0490:b001:l038","ordinal":22413,"en":"His conqueror when sent in front,"},{"id":"manas-2010:p0490:b001:l039","ordinal":22414,"en":"His champion when placed behind,"},{"id":"manas-2010:p0490:b001:l040","ordinal":22415,"en":"Raising piercing cries and uproar,"},{"id":"manas-2010:p0490:b001:l041","ordinal":22416,"en":"Your elder Koshoy at their head,"},{"id":"manas-2010:p0490:b001:l042","ordinal":22417,"en":"Against Black Chinese and Manchus,"},{"id":"manas-2010:p0491:b001:l001","ordinal":22418,"en":"The strife your elder wrought:"},{"id":"manas-2010:p0491:b001:l002","ordinal":22419,"en":"Firing muskets, drawing bows,"},{"id":"manas-2010:p0491:b001:l003","ordinal":22420,"en":"Like tumbleweed in flight,"},{"id":"manas-2010:p0491:b001:l004","ordinal":22421,"en":"They mingled together."},{"id":"manas-2010:p0491:b001:l005","ordinal":22422,"en":"The eye could not make them out;"},{"id":"manas-2010:p0491:b001:l006","ordinal":22423,"en":"When unbelievers and Muslims"},{"id":"manas-2010:p0491:b001:l007","ordinal":22424,"en":"Clashed with a crash,"},{"id":"manas-2010:p0491:b001:l008","ordinal":22425,"en":"One could not tell which was which."},{"id":"manas-2010:p0491:b001:l009","ordinal":22426,"en":"Standing face to face,"},{"id":"manas-2010:p0491:b001:l010","ordinal":22427,"en":"Firing muskets, drawing bows,"},{"id":"manas-2010:p0491:b001:l011","ordinal":22428,"en":"They fought with resounding crashes."},{"id":"manas-2010:p0491:b001:l012","ordinal":22429,"en":"Arrows from bows shrieked;"},{"id":"manas-2010:p0491:b001:l013","ordinal":22430,"en":"Where they struck, things shattered."},{"id":"manas-2010:p0491:b001:l014","ordinal":22431,"en":"Blood poured out, splashing."},{"id":"manas-2010:p0491:b001:l015","ordinal":22432,"en":"Their heroes reeled,"},{"id":"manas-2010:p0491:b001:l016","ordinal":22433,"en":"Acting of their own free will;"},{"id":"manas-2010:p0491:b001:l017","ordinal":22434,"en":"A patch like a hearth-pit,"},{"id":"manas-2010:p0491:b001:l018","ordinal":22435,"en":"They chopped out,"},{"id":"manas-2010:p0491:b001:l019","ordinal":22436,"en":"And laid them in their clothing."},{"id":"manas-2010:p0491:b001:l020","ordinal":22437,"en":"The many swarming troops"},{"id":"manas-2010:p0491:b001:l021","ordinal":22438,"en":"Stood facing one another."},{"id":"manas-2010:p0491:b001:l022","ordinal":22439,"en":"When the champions met,"},{"id":"manas-2010:p0491:b001:l023","ordinal":22440,"en":"Sparing not their champion lives,"},{"id":"manas-2010:p0491:b001:l024","ordinal":22441,"en":"They plunged spears into each other."},{"id":"manas-2010:p0491:b001:l025","ordinal":22442,"en":"Grabbing collars, they grappled;"},{"id":"manas-2010:p0491:b001:l026","ordinal":22443,"en":"The weak, the strong men"},{"id":"manas-2010:p0491:b001:l027","ordinal":22444,"en":"Seized and killed."},{"id":"manas-2010:p0491:b001:l028","ordinal":22445,"en":"They struck with battle-axes,"},{"id":"manas-2010:p0491:b001:l029","ordinal":22446,"en":"They clashed with whips,"},{"id":"manas-2010:p0491:b001:l030","ordinal":22447,"en":"Grabbing collars, they grappled."},{"id":"manas-2010:p0491:b001:l031","ordinal":22448,"en":"Their strong men with the strong"},{"id":"manas-2010:p0491:b001:l032","ordinal":22449,"en":"Bit like hungry bull camels."},{"id":"manas-2010:p0491:b001:l033","ordinal":22450,"en":"Among the armies locked in combat,"},{"id":"manas-2010:p0491:b001:l034","ordinal":22451,"en":"What was there, and what was not!"},{"id":"manas-2010:p0491:b001:l035","ordinal":22452,"en":"Arms broken, crying in pain,"},{"id":"manas-2010:p0491:b001:l036","ordinal":22453,"en":"Many more fled from there."},{"id":"manas-2010:p0491:b001:l037","ordinal":22454,"en":"Legs broken, then,"},{"id":"manas-2010:p0491:b001:l038","ordinal":22455,"en":"Many more lay there."},{"id":"manas-2010:p0491:b001:l039","ordinal":22456,"en":"When the many troops met,"},{"id":"manas-2010:p0491:b001:l040","ordinal":22457,"en":"Ears fallen off, left stumpy,"},{"id":"manas-2010:p0491:b001:l041","ordinal":22458,"en":"Many more ran away."},{"id":"manas-2010:p0491:b001:l042","ordinal":22459,"en":"Noses fallen off, left blunt,"},{"id":"manas-2010:p0492:b001:l001","ordinal":22460,"en":"Many more hurried about."},{"id":"manas-2010:p0492:b001:l002","ordinal":22461,"en":"Fighting in a tumult,"},{"id":"manas-2010:p0492:b001:l003","ordinal":22462,"en":"Black clubs and battle-axes"},{"id":"manas-2010:p0492:b001:l004","ordinal":22463,"en":"They now raised."},{"id":"manas-2010:p0492:b001:l005","ordinal":22464,"en":"Kalmyks and Kyrgyz faced each other,"},{"id":"manas-2010:p0492:b001:l006","ordinal":22465,"en":"And began their thudding blows."},{"id":"manas-2010:p0492:b001:l007","ordinal":22466,"en":"Fighting with thudding blows,"},{"id":"manas-2010:p0492:b001:l008","ordinal":22467,"en":"Let us leave the armies there."},{"id":"manas-2010:p0492:b001:l009","ordinal":22468,"en":"Having lost Toruchaar to a shot,"},{"id":"manas-2010:p0492:b001:l010","ordinal":22469,"en":"Standing on foot like a mountain,"},{"id":"manas-2010:p0492:b001:l011","ordinal":22470,"en":"Mountain-like leopard Manas—"},{"id":"manas-2010:p0492:b001:l012","ordinal":22471,"en":"Let us begin to tell of him."},{"id":"manas-2010:p0492:b001:l013","ordinal":22472,"en":"Before the dense army swept upon him,"},{"id":"manas-2010:p0492:b001:l014","ordinal":22473,"en":"Stepping unsteadily, holding himself back,"},{"id":"manas-2010:p0492:b001:l015","ordinal":22474,"en":"Leaning on his gray spear,"},{"id":"manas-2010:p0492:b001:l016","ordinal":22475,"en":"He stepped upon a broad rock and stopped."},{"id":"manas-2010:p0492:b001:l017","ordinal":22476,"en":"Your leopard then"},{"id":"manas-2010:p0492:b001:l018","ordinal":22477,"en":"Called for Khan Koshoy:"},{"id":"manas-2010:p0492:b001:l019","ordinal":22478,"en":"“Khan Koshoy of the Kyrgyz"},{"id":"manas-2010:p0492:b001:l020","ordinal":22479,"en":"Was a soul endowed with sacred power."},{"id":"manas-2010:p0492:b001:l021","ordinal":22480,"en":"‘Against the Chinese and Manchus you fight,"},{"id":"manas-2010:p0492:b001:l022","ordinal":22481,"en":"I shall come as your backing,’ he said,"},{"id":"manas-2010:p0492:b001:l023","ordinal":22482,"en":"‘I shall rescue you,’ he said."},{"id":"manas-2010:p0492:b001:l024","ordinal":22483,"en":"My elder, wolf-man Koshoy,"},{"id":"manas-2010:p0492:b001:l025","ordinal":22484,"en":"Had given his promise."},{"id":"manas-2010:p0492:b001:l026","ordinal":22485,"en":"Has my dear elder forgotten?"},{"id":"manas-2010:p0492:b001:l027","ordinal":22486,"en":"The appointed day has come.”"},{"id":"manas-2010:p0492:b001:l028","ordinal":22487,"en":"Before Manas had finished speaking,"},{"id":"manas-2010:p0492:b001:l029","ordinal":22488,"en":"Before his open mouth could close,"},{"id":"manas-2010:p0492:b001:l030","ordinal":22489,"en":"His white turban like a cauldron,"},{"id":"manas-2010:p0492:b001:l031","ordinal":22490,"en":"His shout like the call to prayer,"},{"id":"manas-2010:p0492:b001:l032","ordinal":22491,"en":"Taking a shortcut on a narrow path,"},{"id":"manas-2010:p0492:b001:l033","ordinal":22492,"en":"Aykhozho in a motley robe,"},{"id":"manas-2010:p0492:b001:l034","ordinal":22493,"en":"Aybanboz, approaching his fifth year,"},{"id":"manas-2010:p0492:b001:l035","ordinal":22494,"en":"He had brought along by the rein."},{"id":"manas-2010:p0492:b001:l036","ordinal":22495,"en":"Before Manas,"},{"id":"manas-2010:p0492:b001:l037","ordinal":22496,"en":"Bekkhozho came and stood."},{"id":"manas-2010:p0492:b001:l038","ordinal":22497,"en":"Aybanboz, the champion who remained,"},{"id":"manas-2010:p0492:b001:l039","ordinal":22498,"en":"He presented to the champion."},{"id":"manas-2010:p0492:b001:l040","ordinal":22499,"en":"“Father Manas, leopard,"},{"id":"manas-2010:p0492:b001:l041","ordinal":22500,"en":"Hearing of you, I, Aykhozho,"},{"id":"manas-2010:p0492:b001:l042","ordinal":22501,"en":"Had the face of the earth searched."},{"id":"manas-2010:p0493:b001:l001","ordinal":22502,"en":"Beyond that broad Khotan,"},{"id":"manas-2010:p0493:b001:l002","ordinal":22503,"en":"On this side of Kerme-Too,"},{"id":"manas-2010:p0493:b001:l003","ordinal":22504,"en":"I had the desolate wilderness searched."},{"id":"manas-2010:p0493:b001:l004","ordinal":22505,"en":"Putting means to work and giving gold,"},{"id":"manas-2010:p0493:b001:l005","ordinal":22506,"en":"I had him brought from that very place."},{"id":"manas-2010:p0493:b001:l006","ordinal":22507,"en":"I knew that you were a lion;"},{"id":"manas-2010:p0493:b001:l007","ordinal":22508,"en":"Great Manas, born an only son,"},{"id":"manas-2010:p0493:b001:l008","ordinal":22509,"en":"I kept wishing you would ride him!"},{"id":"manas-2010:p0493:b001:l009","ordinal":22510,"en":"When I set out leading Aybanboz,"},{"id":"manas-2010:p0493:b001:l010","ordinal":22511,"en":"I wept bitterly to God."},{"id":"manas-2010:p0493:b001:l011","ordinal":22512,"en":"Having seen you in my dream,"},{"id":"manas-2010:p0493:b001:l012","ordinal":22513,"en":"Majestic wolf-man leopard,"},{"id":"manas-2010:p0493:b001:l013","ordinal":22514,"en":"I came expressly, pressing onward."},{"id":"manas-2010:p0493:b001:l014","ordinal":22515,"en":"A fine white-fabric coat is at my saddle-thongs;"},{"id":"manas-2010:p0493:b001:l015","ordinal":22516,"en":"An excellent coat, if you wear it."},{"id":"manas-2010:p0493:b001:l016","ordinal":22517,"en":"There is writing on its collar:"},{"id":"manas-2010:p0493:b001:l017","ordinal":22518,"en":"‘Manas shall wear it on campaign,’"},{"id":"manas-2010:p0493:b001:l018","ordinal":22519,"en":"On this coat I had set aside,"},{"id":"manas-2010:p0493:b001:l019","ordinal":22520,"en":"His name is written."},{"id":"manas-2010:p0493:b001:l020","ordinal":22521,"en":"I give it as a gift; put it on!"},{"id":"manas-2010:p0493:b001:l021","ordinal":22522,"en":"Mount Aybanboz,"},{"id":"manas-2010:p0493:b001:l022","ordinal":22523,"en":"And wreak fierce havoc."},{"id":"manas-2010:p0493:b001:l023","ordinal":22524,"en":"From the unruly Black Chinese,"},{"id":"manas-2010:p0493:b001:l024","ordinal":22525,"en":"The Muslims, small as a palm,"},{"id":"manas-2010:p0493:b001:l025","ordinal":22526,"en":"Rescue them!”"},{"id":"manas-2010:p0493:b001:l026","ordinal":22527,"en":"Aykhozho in a motley robe,"},{"id":"manas-2010:p0493:b001:l027","ordinal":22528,"en":"Taking him by the hand six times,"}]
