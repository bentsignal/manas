[{"id":"manas-2010:p1074:b001:l020","ordinal":46849,"en":"Once my dear father"},{"id":"manas-2010:p1074:b001:l021","ordinal":46850,"en":"Became enraged."},{"id":"manas-2010:p1074:b001:l022","ordinal":46851,"en":"In anger he shouted,"},{"id":"manas-2010:p1074:b001:l023","ordinal":46852,"en":"When I had reached six,"},{"id":"manas-2010:p1074:b001:l024","ordinal":46853,"en":"He called me in distress:"},{"id":"manas-2010:p1074:b001:l025","ordinal":46854,"en":"“There was no choice but to endure."},{"id":"manas-2010:p1074:b001:l026","ordinal":46855,"en":"Among the numerous Chinese in Beijing"},{"id":"manas-2010:p1074:b001:l027","ordinal":46856,"en":"I lived many years without a child."},{"id":"manas-2010:p1074:b001:l028","ordinal":46857,"en":"Because I had no child,"},{"id":"manas-2010:p1074:b001:l029","ordinal":46858,"en":"I suffered much in Beijing,"},{"id":"manas-2010:p1074:b001:l030","ordinal":46859,"en":"Because of that dog Kongurbay."},{"id":"manas-2010:p1074:b001:l031","ordinal":46860,"en":"I saw much humiliation."},{"id":"manas-2010:p1074:b001:l032","ordinal":46861,"en":"From that dog Kongurbay, Kalcha,"},{"id":"manas-2010:p1074:b001:l033","ordinal":46862,"en":"I endured much oppression."},{"id":"manas-2010:p1074:b001:l034","ordinal":46863,"en":"If you grow up safe and sound,"},{"id":"manas-2010:p1074:b001:l035","ordinal":46864,"en":"Set apart for me the land I gained."},{"id":"manas-2010:p1074:b001:l036","ordinal":46865,"en":"If your strength cannot match that dog,"},{"id":"manas-2010:p1074:b001:l037","ordinal":46866,"en":"Come back dead rather than live."},{"id":"manas-2010:p1074:b001:l038","ordinal":46867,"en":"If you remain alive and well,"},{"id":"manas-2010:p1074:b001:l039","ordinal":46868,"en":"Return after seeing many marvels!"},{"id":"manas-2010:p1074:b001:l040","ordinal":46869,"en":"Down in the land of the one-eyed people,"},{"id":"manas-2010:p1074:b001:l041","ordinal":46870,"en":"In its upper valley called Suuk-Tör,"},{"id":"manas-2010:p1074:b001:l042","ordinal":46871,"en":"In its lake called Averden,"},{"id":"manas-2010:p1075:b001:l001","ordinal":46872,"en":"There is a sixty-headed dragon:"},{"id":"manas-2010:p1075:b001:l002","ordinal":46873,"en":"Go and learn its secrets."},{"id":"manas-2010:p1075:b001:l003","ordinal":46874,"en":"Cloudy by day, clear by night,"},{"id":"manas-2010:p1075:b001:l004","ordinal":46875,"en":"Swirling storms of sleet,"},{"id":"manas-2010:p1075:b001:l005","ordinal":46876,"en":"Changing and unsettling the weather:"},{"id":"manas-2010:p1075:b001:l006","ordinal":46877,"en":"It teaches the knowledge of rain magic."},{"id":"manas-2010:p1075:b001:l007","ordinal":46878,"en":"Keeping you undefeated in a firefight,"},{"id":"manas-2010:p1075:b001:l008","ordinal":46879,"en":"It teaches the knowledge of bullets."},{"id":"manas-2010:p1075:b001:l009","ordinal":46880,"en":"A short coat wrought of gold,"},{"id":"manas-2010:p1075:b001:l010","ordinal":46881,"en":"Wear it against your bare flesh."},{"id":"manas-2010:p1075:b001:l011","ordinal":46882,"en":"If your skill permits, Beijing's"},{"id":"manas-2010:p1075:b001:l012","ordinal":46883,"en":"Golden throne, mount it for me."},{"id":"manas-2010:p1075:b001:l013","ordinal":46884,"en":"Kakan-Chin's Beijing,"},{"id":"manas-2010:p1075:b001:l014","ordinal":46885,"en":"Rule it without letting it stir!"},{"id":"manas-2010:p1075:b001:l015","ordinal":46886,"en":"If Kongurbay opposes you,"},{"id":"manas-2010:p1075:b001:l016","ordinal":46887,"en":"Drive him farther off!"},{"id":"manas-2010:p1075:b001:l017","ordinal":46888,"en":"Before the dragon"},{"id":"manas-2010:p1075:b001:l018","ordinal":46889,"en":"Many people have gone,"},{"id":"manas-2010:p1075:b001:l019","ordinal":46890,"en":"None have come back."},{"id":"manas-2010:p1075:b001:l020","ordinal":46891,"en":"From Kakan-Chin's Beijing"},{"id":"manas-2010:p1075:b001:l021","ordinal":46892,"en":"Many children were gathered."},{"id":"manas-2010:p1075:b001:l022","ordinal":46893,"en":"When they went saying, ‘We shall learn,’"},{"id":"manas-2010:p1075:b001:l023","ordinal":46894,"en":"Many children perished."},{"id":"manas-2010:p1075:b001:l024","ordinal":46895,"en":"Saddle Sarala the courser and go,"},{"id":"manas-2010:p1075:b001:l025","ordinal":46896,"en":"Before the dragon"},{"id":"manas-2010:p1075:b001:l026","ordinal":46897,"en":"Go and truly learn the spells."},{"id":"manas-2010:p1075:b001:l027","ordinal":46898,"en":"If you are worthless, my foal,"},{"id":"manas-2010:p1075:b001:l028","ordinal":46899,"en":"Go early and die."},{"id":"manas-2010:p1075:b001:l029","ordinal":46900,"en":"If you are worthy, my foal,"},{"id":"manas-2010:p1075:b001:l030","ordinal":46901,"en":"Upon the massed Chinese,"},{"id":"manas-2010:p1075:b001:l031","ordinal":46902,"en":"Bringing devastation on their heads,"},{"id":"manas-2010:p1075:b001:l032","ordinal":46903,"en":"Turn back and return!”"},{"id":"manas-2010:p1075:b001:l033","ordinal":46904,"en":"He dressed me in an embroidered coat."},{"id":"manas-2010:p1075:b001:l034","ordinal":46905,"en":"When I had reached six,"},{"id":"manas-2010:p1075:b001:l035","ordinal":46906,"en":"My father put me on Sarala."},{"id":"manas-2010:p1075:b001:l036","ordinal":46907,"en":"“Go to the dragon,” he said,"},{"id":"manas-2010:p1075:b001:l037","ordinal":46908,"en":"And sent your Almam toward it."},{"id":"manas-2010:p1075:b001:l038","ordinal":46909,"en":"His forelock ornament wrought of gold"},{"id":"manas-2010:p1075:b001:l039","ordinal":46910,"en":"He swung down before him."},{"id":"manas-2010:p1075:b001:l040","ordinal":46911,"en":"At first, in Beijing,"},{"id":"manas-2010:p1075:b001:l041","ordinal":46912,"en":"Putting me among them as their leader,"},{"id":"manas-2010:p1075:b001:l042","ordinal":46913,"en":"Six thousand children then"},{"id":"manas-2010:p1076:b001:l001","ordinal":46914,"en":"When we went to the dragon,"},{"id":"manas-2010:p1076:b001:l002","ordinal":46915,"en":"If it raised its heads on one side,"},{"id":"manas-2010:p1076:b001:l003","ordinal":46916,"en":"Fire showered forth like rain."},{"id":"manas-2010:p1076:b001:l004","ordinal":46917,"en":"If it raised its heads on another side,"},{"id":"manas-2010:p1076:b001:l005","ordinal":46918,"en":"Flames and embers poured forth."},{"id":"manas-2010:p1076:b001:l006","ordinal":46919,"en":"Six thousand children screamed,"},{"id":"manas-2010:p1076:b001:l007","ordinal":46920,"en":"Helpless with fear."},{"id":"manas-2010:p1076:b001:l008","ordinal":46921,"en":"The others all perished."},{"id":"manas-2010:p1076:b001:l009","ordinal":46922,"en":"Among those children,"},{"id":"manas-2010:p1076:b001:l010","ordinal":46923,"en":"Without meeting death,"},{"id":"manas-2010:p1076:b001:l011","ordinal":46924,"en":"We six children remained."},{"id":"manas-2010:p1076:b001:l012","ordinal":46925,"en":"When the second year came,"},{"id":"manas-2010:p1076:b001:l013","ordinal":46926,"en":"Seven thousand children went together."},{"id":"manas-2010:p1076:b001:l014","ordinal":46927,"en":"All the rest perished;"},{"id":"manas-2010:p1076:b001:l015","ordinal":46928,"en":"Seven children, including me, remained."},{"id":"manas-2010:p1076:b001:l016","ordinal":46929,"en":"When the third year came,"},{"id":"manas-2010:p1076:b001:l017","ordinal":46930,"en":"Eight thousand children went."},{"id":"manas-2010:p1076:b001:l018","ordinal":46931,"en":"Among eight thousand children,"},{"id":"manas-2010:p1076:b001:l019","ordinal":46932,"en":"Without meeting death,"},{"id":"manas-2010:p1076:b001:l020","ordinal":46933,"en":"We eight children remained."},{"id":"manas-2010:p1076:b001:l021","ordinal":46934,"en":"When the fourth year came,"},{"id":"manas-2010:p1076:b001:l022","ordinal":46935,"en":"Nine thousand children went."},{"id":"manas-2010:p1076:b001:l023","ordinal":46936,"en":"Nine thousand children perished;"},{"id":"manas-2010:p1076:b001:l024","ordinal":46937,"en":"We nine children remained."},{"id":"manas-2010:p1076:b001:l025","ordinal":46938,"en":"Ten thousand children went together;"},{"id":"manas-2010:p1076:b001:l026","ordinal":46939,"en":"All ten thousand perished."},{"id":"manas-2010:p1076:b001:l027","ordinal":46940,"en":"We ten children remained alive."},{"id":"manas-2010:p1076:b001:l028","ordinal":46941,"en":"Traveling over the earth,"},{"id":"manas-2010:p1076:b001:l029","ordinal":46942,"en":"I studied and learned."},{"id":"manas-2010:p1076:b001:l030","ordinal":46943,"en":"Flying through the sky,"},{"id":"manas-2010:p1076:b001:l031","ordinal":46944,"en":"Kozhozhash, son of Karazhoy,"},{"id":"manas-2010:p1076:b001:l032","ordinal":46945,"en":"He learned it thoroughly."},{"id":"manas-2010:p1076:b001:l033","ordinal":46946,"en":"He truly mastered his art;"},{"id":"manas-2010:p1076:b001:l034","ordinal":46947,"en":"He studied three months longer than me."},{"id":"manas-2010:p1076:b001:l035","ordinal":46948,"en":"Kozhozhash, son of Karazhoy,"},{"id":"manas-2010:p1076:b001:l036","ordinal":46949,"en":"In Beijing his mighty fame"},{"id":"manas-2010:p1076:b001:l037","ordinal":46950,"en":"Came about because"},{"id":"manas-2010:p1076:b001:l038","ordinal":46951,"en":"He was a trick rider, a swift runner,"},{"id":"manas-2010:p1076:b001:l039","ordinal":46952,"en":"Who would emerge when China faced ruin,"},{"id":"manas-2010:p1076:b001:l040","ordinal":46953,"en":"A great marksman of the treasury."},{"id":"manas-2010:p1076:b001:l041","ordinal":46954,"en":"I hear reports from those who come:"},{"id":"manas-2010:p1076:b001:l042","ordinal":46955,"en":"Without dying or perishing, that pig of a slave"},{"id":"manas-2010:p1077:b001:l001","ordinal":46956,"en":"Has lasted eight full years, they say."},{"id":"manas-2010:p1077:b001:l002","ordinal":46957,"en":"He has a lingering illness, I hear."},{"id":"manas-2010:p1077:b001:l003","ordinal":46958,"en":"If he dies of that illness,"},{"id":"manas-2010:p1077:b001:l004","ordinal":46959,"en":"It will truly be a gift to us."},{"id":"manas-2010:p1077:b001:l005","ordinal":46960,"en":"If he recovers from that illness,"},{"id":"manas-2010:p1077:b001:l006","ordinal":46961,"en":"It will be disaster for us."},{"id":"manas-2010:p1077:b001:l007","ordinal":46962,"en":"If he recovers from that illness,"},{"id":"manas-2010:p1077:b001:l008","ordinal":46963,"en":"Many khans who meet him will die,"},{"id":"manas-2010:p1077:b001:l009","ordinal":46964,"en":"Every soul who comes will die."},{"id":"manas-2010:p1077:b001:l010","ordinal":46965,"en":"To anyone except Kozhozhash,"},{"id":"manas-2010:p1077:b001:l011","ordinal":46966,"en":"Though we grapple, I shall not yield."},{"id":"manas-2010:p1077:b001:l012","ordinal":46967,"en":"My people, small as a palm,"},{"id":"manas-2010:p1077:b001:l013","ordinal":46968,"en":"I shall not let their wings catch fire."},{"id":"manas-2010:p1077:b001:l014","ordinal":46969,"en":"May my words not become sinful boasting:"},{"id":"manas-2010:p1077:b001:l015","ordinal":46970,"en":"I shall turn a summer day to winter."},{"id":"manas-2010:p1077:b001:l016","ordinal":46971,"en":"The Chinese in their thin clothing,"},{"id":"manas-2010:p1077:b001:l017","ordinal":46972,"en":"I shall make them whimper like girls."},{"id":"manas-2010:p1077:b001:l018","ordinal":46973,"en":"The reason I can turn them into girls:"},{"id":"manas-2010:p1077:b001:l019","ordinal":46974,"en":"Against my bare flesh a fine white shirt"},{"id":"manas-2010:p1077:b001:l020","ordinal":46975,"en":"I had worn when I came."},{"id":"manas-2010:p1077:b001:l021","ordinal":46976,"en":"I studied every spell,"},{"id":"manas-2010:p1077:b001:l022","ordinal":46977,"en":"I had learned them when I came."},{"id":"manas-2010:p1077:b001:l023","ordinal":46978,"en":"Enough, why should I tell the rest?"},{"id":"manas-2010:p1077:b001:l024","ordinal":46979,"en":"Let me tell this part."},{"id":"manas-2010:p1077:b001:l025","ordinal":46980,"en":"When I was in Beijing,"},{"id":"manas-2010:p1077:b001:l026","ordinal":46981,"en":"When I reached twelve years,"},{"id":"manas-2010:p1077:b001:l027","ordinal":46982,"en":"Finding no pit dug ready,"},{"id":"manas-2010:p1077:b001:l028","ordinal":46983,"en":"Finding no brine boiled ready,"},{"id":"manas-2010:p1077:b001:l029","ordinal":46984,"en":"Against Beijing, not even"},{"id":"manas-2010:p1077:b001:l030","ordinal":46985,"en":"Finding an army coming to attack,"},{"id":"manas-2010:p1077:b001:l031","ordinal":46986,"en":"Finding no mountain to crash against,"},{"id":"manas-2010:p1077:b001:l032","ordinal":46987,"en":"Finding no enemy to fight,"},{"id":"manas-2010:p1077:b001:l033","ordinal":46988,"en":"I became fully capable for my people;"},{"id":"manas-2010:p1077:b001:l034","ordinal":46989,"en":"I became an ogre in Beijing."},{"id":"manas-2010:p1077:b001:l035","ordinal":46990,"en":"Listen, Manas, to my words."},{"id":"manas-2010:p1077:b001:l036","ordinal":46991,"en":"Here, taking offense at me,"},{"id":"manas-2010:p1077:b001:l037","ordinal":46992,"en":"You sought to unsettle me."},{"id":"manas-2010:p1077:b001:l038","ordinal":46993,"en":"You sought to stir up trouble,"},{"id":"manas-2010:p1077:b001:l039","ordinal":46994,"en":"You sought to make a spectacle."},{"id":"manas-2010:p1077:b001:l040","ordinal":46995,"en":"Listen, Khan Manas,"},{"id":"manas-2010:p1077:b001:l041","ordinal":46996,"en":"To the hell I brought upon Beijing."},{"id":"manas-2010:p1077:b001:l042","ordinal":46997,"en":"When I lived in Beijing,"},{"id":"manas-2010:p1078:b001:l001","ordinal":46998,"en":"A child with little understanding,"},{"id":"manas-2010:p1078:b001:l002","ordinal":46999,"en":"Golden sword and battle-axe,"},{"id":"manas-2010:p1078:b001:l003","ordinal":47000,"en":"Made specially, tempered hard,"},{"id":"manas-2010:p1078:b001:l004","ordinal":47001,"en":"Hung looped around my wrist."},{"id":"manas-2010:p1078:b001:l005","ordinal":47002,"en":"Never recoiling from stone,"},{"id":"manas-2010:p1078:b001:l006","ordinal":47003,"en":"Striking iron and shattering it,"},{"id":"manas-2010:p1078:b001:l007","ordinal":47004,"en":"Drawing blood when swung,"},{"id":"manas-2010:p1078:b001:l008","ordinal":47005,"en":"Taking the life of whoever opposed it,"},{"id":"manas-2010:p1078:b001:l009","ordinal":47006,"en":"My father's Akbolot"},{"id":"manas-2010:p1078:b001:l010","ordinal":47007,"en":"Lay fitted in its sheath."},{"id":"manas-2010:p1078:b001:l011","ordinal":47008,"en":"Covered in elephant hide,"},{"id":"manas-2010:p1078:b001:l012","ordinal":47009,"en":"Hafted by a skilled craftsman,"},{"id":"manas-2010:p1078:b001:l013","ordinal":47010,"en":"With a tuft attached to its head,"},{"id":"manas-2010:p1078:b001:l014","ordinal":47011,"en":"Treasured, kept from others' touch,"},{"id":"manas-2010:p1078:b001:l015","ordinal":47012,"en":"My dear father, secretly,"},{"id":"manas-2010:p1078:b001:l016","ordinal":47013,"en":"Had it tended with great care."},{"id":"manas-2010:p1078:b001:l017","ordinal":47014,"en":"He had hard steel laid over its surface:"},{"id":"manas-2010:p1078:b001:l018","ordinal":47015,"en":"“It will cut through iron,” he said,"},{"id":"manas-2010:p1078:b001:l019","ordinal":47016,"en":"And enhanced all its fittings."},{"id":"manas-2010:p1078:b001:l020","ordinal":47017,"en":"It rang when a fly touched it,"},{"id":"manas-2010:p1078:b001:l021","ordinal":47018,"en":"It chimed when flicked."},{"id":"manas-2010:p1078:b001:l022","ordinal":47019,"en":"“It may grow brittle and break,” he said,"},{"id":"manas-2010:p1078:b001:l023","ordinal":47020,"en":"And had it steeped in yellow glue."},{"id":"manas-2010:p1078:b001:l024","ordinal":47021,"en":"My father Azizkan's Akbolot"},{"id":"manas-2010:p1078:b001:l025","ordinal":47022,"en":"I took in my right hand."},{"id":"manas-2010:p1078:b001:l026","ordinal":47023,"en":"“Alöökö's Kongurbay,"},{"id":"manas-2010:p1078:b001:l027","ordinal":47024,"en":"If I have the strength, I shall overcome him,” I said,"},{"id":"manas-2010:p1078:b001:l028","ordinal":47025,"en":"“If I lack the strength, I shall die,” I said."},{"id":"manas-2010:p1078:b001:l029","ordinal":47026,"en":"When I had reached twelve,"},{"id":"manas-2010:p1078:b001:l030","ordinal":47027,"en":"I went to make my demand."},{"id":"manas-2010:p1078:b001:l031","ordinal":47028,"en":"“If Kongurbay acts justly,"},{"id":"manas-2010:p1078:b001:l032","ordinal":47029,"en":"He will agree to what I say,” I said."},{"id":"manas-2010:p1078:b001:l033","ordinal":47030,"en":"“My father's Kan-Zhaylak"},{"id":"manas-2010:p1078:b001:l034","ordinal":47031,"en":"He will give back to me,” I said."},{"id":"manas-2010:p1078:b001:l035","ordinal":47032,"en":"When I had reached twelve,"},{"id":"manas-2010:p1078:b001:l036","ordinal":47033,"en":"I drew in Sarala's reins."},{"id":"manas-2010:p1078:b001:l037","ordinal":47034,"en":"Before your Kongur"},{"id":"manas-2010:p1078:b001:l038","ordinal":47035,"en":"I went to demand Kan-Zhaylak."},{"id":"manas-2010:p1078:b001:l039","ordinal":47036,"en":"His torment had become unbearable then,"},{"id":"manas-2010:p1078:b001:l040","ordinal":47037,"en":"Cotton sash and broad boots,"},{"id":"manas-2010:p1078:b001:l041","ordinal":47038,"en":"Kongurbay, khan of the monks."},{"id":"manas-2010:p1078:b001:l042","ordinal":47039,"en":"When I observed him closely,"},{"id":"manas-2010:p1079:b001:l001","ordinal":47040,"en":"Kalcha, large as a hut,"},{"id":"manas-2010:p1079:b001:l002","ordinal":47041,"en":"Among the Chinese, a mighty one,"},{"id":"manas-2010:p1079:b001:l003","ordinal":47042,"en":"He had become by then."},{"id":"manas-2010:p1079:b001:l004","ordinal":47043,"en":"Towering like a hut,"},{"id":"manas-2010:p1079:b001:l005","ordinal":47044,"en":"His spirit spreading on all sides,"},{"id":"manas-2010:p1079:b001:l006","ordinal":47045,"en":"He had reached his full strength then."},{"id":"manas-2010:p1079:b001:l007","ordinal":47046,"en":"His neck arched like a rooster's,"},{"id":"manas-2010:p1079:b001:l008","ordinal":47047,"en":"His great boots stretched out."},{"id":"manas-2010:p1079:b001:l009","ordinal":47048,"en":"One's wits scattered and fled"},{"id":"manas-2010:p1079:b001:l010","ordinal":47049,"en":"If a human looked closely;"},{"id":"manas-2010:p1079:b001:l011","ordinal":47050,"en":"He appeared like a death-bringing demon."},{"id":"manas-2010:p1079:b001:l012","ordinal":47051,"en":"The corners of his two eyes"},{"id":"manas-2010:p1079:b001:l013","ordinal":47052,"en":"Were like an opened grave."},{"id":"manas-2010:p1079:b001:l014","ordinal":47053,"en":"When one looked at his moon-like brow,"},{"id":"manas-2010:p1079:b001:l015","ordinal":47054,"en":"It was like a spacious upper valley."},{"id":"manas-2010:p1079:b001:l016","ordinal":47055,"en":"When one looked at his glaring eyes,"},{"id":"manas-2010:p1079:b001:l017","ordinal":47056,"en":"They were like land veiled in dusk."},{"id":"manas-2010:p1079:b001:l018","ordinal":47057,"en":"Jerking a golden leading rein,"},{"id":"manas-2010:p1079:b001:l019","ordinal":47058,"en":"Riding Algara and making him plunge,"},{"id":"manas-2010:p1079:b001:l020","ordinal":47059,"en":"Six thousand Chinese, a thousand governors,"},{"id":"manas-2010:p1079:b001:l021","ordinal":47060,"en":"Kongurbay their elder."},{"id":"manas-2010:p1079:b001:l022","ordinal":47061,"en":"In the hollow of Kyr-Kayyng"},{"id":"manas-2010:p1079:b001:l023","ordinal":47062,"en":"I attacked Kongurbay."},{"id":"manas-2010:p1079:b001:l024","ordinal":47063,"en":"My back giving way, bent forward,"},{"id":"manas-2010:p1079:b001:l025","ordinal":47064,"en":"My dear eyes staring wide,"},{"id":"manas-2010:p1079:b001:l026","ordinal":47065,"en":"I arrived ahead of an arrow."},{"id":"manas-2010:p1079:b001:l027","ordinal":47066,"en":"That slave Kongurbay, Kalcha:"},{"id":"manas-2010:p1079:b001:l028","ordinal":47067,"en":"“The face of the right shoulder blade,” I said,"},{"id":"manas-2010:p1079:b001:l029","ordinal":47068,"en":"“The lower edge of the lung,” I said."},{"id":"manas-2010:p1079:b001:l030","ordinal":47069,"en":"At Kalcha with my spear"},{"id":"manas-2010:p1079:b001:l031","ordinal":47070,"en":"I reached him, struck and passed."},{"id":"manas-2010:p1079:b001:l032","ordinal":47071,"en":"At that time, to Kalcha"},{"id":"manas-2010:p1079:b001:l033","ordinal":47072,"en":"No one spoke without thinking;"},{"id":"manas-2010:p1079:b001:l034","ordinal":47073,"en":"No one remained to raise a herding pole against him."},{"id":"manas-2010:p1079:b001:l035","ordinal":47074,"en":"Sarala, striking like a shot,"},{"id":"manas-2010:p1079:b001:l036","ordinal":47075,"en":"And Algara both reeled."},{"id":"manas-2010:p1079:b001:l037","ordinal":47076,"en":"“At twelve years of age"},{"id":"manas-2010:p1079:b001:l038","ordinal":47077,"en":"He has challenged Kongurbay,"},{"id":"manas-2010:p1079:b001:l039","ordinal":47078,"en":"What a devastating child!” they said."},{"id":"manas-2010:p1079:b001:l040","ordinal":47079,"en":"The teeming Chinese marveled."},{"id":"manas-2010:p1079:b001:l041","ordinal":47080,"en":"The land grew dim with dust,"},{"id":"manas-2010:p1079:b001:l042","ordinal":47081,"en":"The face of the earth became blood,"},{"id":"manas-2010:p1080:b001:l001","ordinal":47082,"en":"I remained alive upon that ground."},{"id":"manas-2010:p1080:b001:l002","ordinal":47083,"en":"Not just once, but Kalcha,"},{"id":"manas-2010:p1080:b001:l003","ordinal":47084,"en":"In the desert of It-Ölbös,"},{"id":"manas-2010:p1080:b001:l004","ordinal":47085,"en":"Six times I struck down with my spear."},{"id":"manas-2010:p1080:b001:l005","ordinal":47086,"en":"Esenkan of Outer Beijing,"},{"id":"manas-2010:p1080:b001:l006","ordinal":47087,"en":"Into Esenkan's palace"},{"id":"manas-2010:p1080:b001:l007","ordinal":47088,"en":"I drove him as I went."},{"id":"manas-2010:p1080:b001:l008","ordinal":47089,"en":"Distracted, unable to think,"},{"id":"manas-2010:p1080:b001:l009","ordinal":47090,"en":"Kongurbay rushed inside."},{"id":"manas-2010:p1080:b001:l010","ordinal":47091,"en":"“I shall die before my appointed death,” he said,"},{"id":"manas-2010:p1080:b001:l011","ordinal":47092,"en":"Kongurbay fled inside."},{"id":"manas-2010:p1080:b001:l012","ordinal":47093,"en":"Stepping through the gateway,"},{"id":"manas-2010:p1080:b001:l013","ordinal":47094,"en":"Then he went"},{"id":"manas-2010:p1080:b001:l014","ordinal":47095,"en":"Before Esenkan,"},{"id":"manas-2010:p1080:b001:l015","ordinal":47096,"en":"Speaking ill of wretched me:"},{"id":"manas-2010:p1080:b001:l016","ordinal":47097,"en":"“He will not let our work proceed."},{"id":"manas-2010:p1080:b001:l017","ordinal":47098,"en":"That bastard-piss creature of Azizkan,"},{"id":"manas-2010:p1080:b001:l018","ordinal":47099,"en":"He will not let us stay in Beijing!"},{"id":"manas-2010:p1080:b001:l019","ordinal":47100,"en":"He will plunder the gold,"},{"id":"manas-2010:p1080:b001:l020","ordinal":47101,"en":"He will bring us torment."},{"id":"manas-2010:p1080:b001:l021","ordinal":47102,"en":"If you do not restrain this pig,"},{"id":"manas-2010:p1080:b001:l022","ordinal":47103,"en":"If you do not cut off his apple-round head,"},{"id":"manas-2010:p1080:b001:l023","ordinal":47104,"en":"He will scatter vast amounts of gold."}]
