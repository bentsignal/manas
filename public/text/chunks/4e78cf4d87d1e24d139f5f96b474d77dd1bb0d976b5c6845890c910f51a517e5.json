[{"id":"semetey-1-2013:p0787:b005:l009","ordinal":137217,"en":"Had followed the horse Buurul"},{"id":"semetey-1-2013:p0787:b005:l010","ordinal":137218,"en":"And gone away with him."},{"id":"semetey-1-2013:p0787:b005:l011","ordinal":137219,"en":"Keeping watch, surveying the land,"},{"id":"semetey-1-2013:p0787:b005:l012","ordinal":137220,"en":"Had they not wandered about?"},{"id":"semetey-1-2013:p0787:b005:l013","ordinal":137221,"en":"‘When will Semetey come?’"},{"id":"semetey-1-2013:p0787:b005:l014","ordinal":137222,"en":"Had they not wandered in anguish?"},{"id":"semetey-1-2013:p0787:b005:l015","ordinal":137223,"en":"That Bozbee, neighing,"},{"id":"semetey-1-2013:p0787:b005:l016","ordinal":137224,"en":"Appeared on his right."},{"id":"semetey-1-2013:p0787:b005:l017","ordinal":137225,"en":"Your orphan, the son of Manas,"},{"id":"semetey-1-2013:p0787:b005:l018","ordinal":137226,"en":"Implored his Allah,"},{"id":"semetey-1-2013:p0787:b005:l019","ordinal":137227,"en":"And hung the gray belt-pouch"},{"id":"semetey-1-2013:p0787:b005:l020","ordinal":137228,"en":"Left by Manas around his neck."},{"id":"semetey-1-2013:p0787:b005:l021","ordinal":137229,"en":"‘O Creator!’ he pleaded."},{"id":"semetey-1-2013:p0787:b005:l022","ordinal":137230,"en":"The brave son born of Manas"},{"id":"semetey-1-2013:p0787:b005:l023","ordinal":137231,"en":"Took hold of that standing Bozbee,"},{"id":"semetey-1-2013:p0787:b005:l024","ordinal":137232,"en":"Her ears and forelock,"},{"id":"semetey-1-2013:p0787:b005:l025","ordinal":137233,"en":"Grasping them together."},{"id":"semetey-1-2013:p0787:b005:l026","ordinal":137234,"en":"In honor of his father Manas,"},{"id":"semetey-1-2013:p0787:b005:l027","ordinal":137235,"en":"He dedicated her and made the sacrifice."},{"id":"semetey-1-2013:p0787:b005:l028","ordinal":137236,"en":"Without first casting Bozbee down,"},{"id":"semetey-1-2013:p0787:b005:l029","ordinal":137237,"en":"He cut off her head."},{"id":"semetey-1-2013:p0787:b005:l030","ordinal":137238,"en":"They butchered Bozbee,"},{"id":"semetey-1-2013:p0787:b005:l031","ordinal":137239,"en":"And rejoiced in this way."},{"id":"semetey-1-2013:p0787:b005:l032","ordinal":137240,"en":"Was she not Manas's own livestock?"},{"id":"semetey-1-2013:p0787:b005:l033","ordinal":137241,"en":"They butchered her and spread the meat in the field."},{"id":"semetey-1-2013:p0787:b005:l034","ordinal":137242,"en":"Boiled it in a traveling cauldron."},{"id":"semetey-1-2013:p0787:b005:l035","ordinal":137243,"en":"Bakai and Semetey,"},{"id":"semetey-1-2013:p0787:b005:l036","ordinal":137244,"en":"The horse herders and the elders,"},{"id":"semetey-1-2013:p0787:b005:l037","ordinal":137245,"en":"All who had known Manas were there."},{"id":"semetey-1-2013:p0787:b005:l038","ordinal":137246,"en":"Bozbee was slaughtered as an offering;"},{"id":"semetey-1-2013:p0787:b005:l039","ordinal":137247,"en":"Everyone ate their fill,"},{"id":"semetey-1-2013:p0788:b003:l001","ordinal":137248,"en":"Extinguished fires were lit,"},{"id":"semetey-1-2013:p0788:b003:l002","ordinal":137249,"en":"Dead souls came to life,"},{"id":"semetey-1-2013:p0788:b003:l003","ordinal":137250,"en":"All the valleys and mountains ran."},{"id":"semetey-1-2013:p0788:b003:l004","ordinal":137251,"en":"‘Oh, wonder, he is Manas's son!’"},{"id":"semetey-1-2013:p0788:b003:l005","ordinal":137252,"en":"Everyone who saw him rejoiced."},{"id":"semetey-1-2013:p0788:b003:l006","ordinal":137253,"en":"They cried, ‘Baabedin!’"},{"id":"semetey-1-2013:p0788:b003:l007","ordinal":137254,"en":"‘Manas's only son has come!’"},{"id":"semetey-1-2013:p0788:b003:l009","ordinal":137255,"en":"They shouted the joyful news."},{"id":"semetey-1-2013:p0788:b003:l010","ordinal":137256,"en":"The wealthiest slaughtered mares,"},{"id":"semetey-1-2013:p0788:b003:l011","ordinal":137257,"en":"Those of middling means slaughtered sheep."},{"id":"semetey-1-2013:p0788:b003:l012","ordinal":137258,"en":"Of blessed, fierce Manas,"},{"id":"semetey-1-2013:p0788:b003:l013","ordinal":137259,"en":"The only son has come!"},{"id":"semetey-1-2013:p0788:b003:l014","ordinal":137260,"en":"The Creator God has granted him to us."},{"id":"semetey-1-2013:p0788:b003:l015","ordinal":137261,"en":"When the magnanimous one was alive,"},{"id":"semetey-1-2013:p0788:b003:l016","ordinal":137262,"en":"Among these Kyrgyz and Argyn,"},{"id":"semetey-1-2013:p0788:b003:l017","ordinal":137263,"en":"From thick Kyrgyz thoughts,"},{"id":"semetey-1-2013:p0788:b003:l018","ordinal":137264,"en":"When they were encamped,"},{"id":"semetey-1-2013:p0788:b003:l019","ordinal":137265,"en":"There was kumys by day, girls by night,"},{"id":"semetey-1-2013:p0788:b003:l020","ordinal":137266,"en":"Such were those times."},{"id":"semetey-1-2013:p0788:b003:l021","ordinal":137267,"en":"When paired alaba coats* and sable caps"},{"id":"semetey-1-2013:p0788:b003:l022","ordinal":137268,"en":"When those caps swayed,"},{"id":"semetey-1-2013:p0788:b003:l023","ordinal":137269,"en":"Together knowing the Kyrgyz,"},{"id":"semetey-1-2013:p0788:b003:l024","ordinal":137270,"en":"When they lived in joy."},{"id":"semetey-1-2013:p0788:b003:l025","ordinal":137271,"en":"While Manas was here,"},{"id":"semetey-1-2013:p0788:b003:l026","ordinal":137272,"en":"We took a whole beaver skin,"},{"id":"semetey-1-2013:p0788:b003:l027","ordinal":137273,"en":"Divided it in half,"},{"id":"semetey-1-2013:p0788:b003:l028","ordinal":137274,"en":"And put it on our trouser legs."},{"id":"semetey-1-2013:p0788:b003:l029","ordinal":137275,"en":"Our noses swelled like leather bottles;"},{"id":"semetey-1-2013:p0788:b003:l030","ordinal":137276,"en":"While fierce Manas was here,"},{"id":"semetey-1-2013:p0788:b003:l031","ordinal":137277,"en":"Did we not strut proudly about?"},{"id":"semetey-1-2013:p0788:b003:l032","ordinal":137278,"en":"When Manas died,"},{"id":"semetey-1-2013:p0788:b003:l033","ordinal":137279,"en":"When the dogs' turn came,"},{"id":"semetey-1-2013:p0788:b003:l034","ordinal":137280,"en":"Unable to bear their taxes,"},{"id":"semetey-1-2013:p0788:b003:l035","ordinal":137281,"en":"The Argyn fled to one place."},{"id":"semetey-1-2013:p0788:b003:l036","ordinal":137282,"en":"Unable to bear their conduct,"},{"id":"semetey-1-2013:p0788:b003:l037","ordinal":137283,"en":"The Kyrgyz went to another place."},{"id":"semetey-1-2013:p0788:b003:l038","ordinal":137284,"en":"When Manas died,"},{"id":"semetey-1-2013:p0788:b003:l039","ordinal":137285,"en":"They quenched the fires we had lit."},{"id":"semetey-1-2013:p0788:b004:l001","ordinal":137286,"en":"They tormented the many people"},{"id":"semetey-1-2013:p0788:b004:l002","ordinal":137287,"en":"And drove the whole nation away."},{"id":"semetey-1-2013:p0788:b004:l003","ordinal":137288,"en":"Our elders saw hell;"},{"id":"semetey-1-2013:p0788:b004:l004","ordinal":137289,"en":"As though calamity had struck,"},{"id":"semetey-1-2013:p0788:b004:l005","ordinal":137290,"en":"We all became scattered and destitute."},{"id":"semetey-1-2013:p0788:b004:l006","ordinal":137291,"en":"Abyke and Köbösh, two scoundrels:"},{"id":"semetey-1-2013:p0788:b004:l007","ordinal":137292,"en":"From them we suffered humiliation."},{"id":"semetey-1-2013:p0788:b004:l008","ordinal":137293,"en":"Chiybyt and Kochkor made four scoundrels:"},{"id":"semetey-1-2013:p0788:b004:l009","ordinal":137294,"en":"From them we suffered violence."},{"id":"semetey-1-2013:p0788:b004:l010","ordinal":137295,"en":"Adybai and Kölbai made six scoundrels:"},{"id":"semetey-1-2013:p0788:b004:l011","ordinal":137296,"en":"From them we suffered arrogance."},{"id":"semetey-1-2013:p0788:b004:l012","ordinal":137297,"en":"While those wretched six held power,"},{"id":"semetey-1-2013:p0788:b004:l013","ordinal":137298,"en":"They laid a levy on every household,"},{"id":"semetey-1-2013:p0788:b004:l014","ordinal":137299,"en":"Collected everything, leaving nothing."},{"id":"semetey-1-2013:p0788:b004:l015","ordinal":137300,"en":"Unable to bear their levy,"},{"id":"semetey-1-2013:p0788:b004:l016","ordinal":137301,"en":"These people would have been exhausted."},{"id":"semetey-1-2013:p0788:b004:l017","ordinal":137302,"en":"Now brave Manas's only son"},{"id":"semetey-1-2013:p0788:b004:l018","ordinal":137303,"en":"Has arrived."},{"id":"semetey-1-2013:p0788:b004:l019","ordinal":137304,"en":"The one God has granted"},{"id":"semetey-1-2013:p0788:b004:l020","ordinal":137305,"en":"These many people standing here"},{"id":"semetey-1-2013:p0788:b004:l021","ordinal":137306,"en":"What they longed for."},{"id":"semetey-1-2013:p0788:b004:l022","ordinal":137307,"en":"Those who would slaughter a yearling, slaughter one;"},{"id":"semetey-1-2013:p0788:b004:l023","ordinal":137308,"en":"Those who would slaughter a mare, slaughter one!’"},{"id":"semetey-1-2013:p0788:b004:l024","ordinal":137309,"en":"Argyn and Kyrgyz sobbed,"},{"id":"semetey-1-2013:p0788:b004:l025","ordinal":137310,"en":"Cried out and made offerings."},{"id":"semetey-1-2013:p0788:b004:l026","ordinal":137311,"en":"Their quenched fire was kindled;"},{"id":"semetey-1-2013:p0788:b004:l027","ordinal":137312,"en":"The dead Manas came to life."},{"id":"semetey-1-2013:p0788:b004:l028","ordinal":137313,"en":"‘Manas's son has come!’"},{"id":"semetey-1-2013:p0788:b004:l029","ordinal":137314,"en":"Those in the valleys ran to the mountains"},{"id":"semetey-1-2013:p0788:b004:l030","ordinal":137315,"en":"To bear the joyful news."},{"id":"semetey-1-2013:p0788:b004:l031","ordinal":137316,"en":"Dusk fell and the sun set;"},{"id":"semetey-1-2013:p0788:b004:l032","ordinal":137317,"en":"The first of the people lay asleep."},{"id":"semetey-1-2013:p0788:b004:l033","ordinal":137318,"en":"Manas's sister Kardygach"},{"id":"semetey-1-2013:p0788:b004:l034","ordinal":137319,"en":"Wore out her horse, searching the land,"},{"id":"semetey-1-2013:p0788:b004:l035","ordinal":137320,"en":"Followed tracks without sleep,"},{"id":"semetey-1-2013:p0788:b004:l036","ordinal":137321,"en":"Could not rest even on her elbow,"},{"id":"semetey-1-2013:p0788:b004:l037","ordinal":137322,"en":"Could not sleep even a moment."},{"id":"semetey-1-2013:p0788:b004:l038","ordinal":137323,"en":"That lion-limbed, valiant woman"},{"id":"semetey-1-2013:p0788:b004:l039","ordinal":137324,"en":"Had been born of the same nest as Manas."},{"id":"semetey-1-2013:p0789:b003:l001","ordinal":137325,"en":"If anyone attacked the orphan,"},{"id":"semetey-1-2013:p0789:b003:l002","ordinal":137326,"en":"To charge with a shout and thrust her spear,"},{"id":"semetey-1-2013:p0789:b003:l003","ordinal":137327,"en":"To knock the fury out of anyone she met,"},{"id":"semetey-1-2013:p0789:b003:l004","ordinal":137328,"en":"To strike off his apple-like head,"},{"id":"semetey-1-2013:p0789:b003:l005","ordinal":137329,"en":"To drag him along the road,"},{"id":"semetey-1-2013:p0789:b003:l006","ordinal":137330,"en":"To burst into glory,"},{"id":"semetey-1-2013:p0789:b003:l007","ordinal":137331,"en":"If the six fools acted treacherously,"},{"id":"semetey-1-2013:p0789:b003:l008","ordinal":137332,"en":"To make a great spectacle of them,"},{"id":"semetey-1-2013:p0789:b003:l009","ordinal":137333,"en":"If the forty companions showed enmity,"},{"id":"semetey-1-2013:p0789:b003:l010","ordinal":137334,"en":"To leave not a single one of them,"},{"id":"semetey-1-2013:p0789:b003:l011","ordinal":137335,"en":"The elders led by Kyrgyl,"},{"id":"semetey-1-2013:p0789:b003:l012","ordinal":137336,"en":"To slaughter them all,"},{"id":"semetey-1-2013:p0789:b003:l013","ordinal":137337,"en":"That same tiger Kardygach"},{"id":"semetey-1-2013:p0789:b003:l014","ordinal":137338,"en":"Had kept watch,"},{"id":"semetey-1-2013:p0789:b003:l015","ordinal":137339,"en":"And learned that he was safe."},{"id":"semetey-1-2013:p0789:b003:l016","ordinal":137340,"en":"Telküröng beneath her"},{"id":"semetey-1-2013:p0789:b003:l017","ordinal":137341,"en":"Flattened his ears like a spirit-horse,"},{"id":"semetey-1-2013:p0789:b003:l018","ordinal":137342,"en":"Scattered the earth like a whirlwind,"},{"id":"semetey-1-2013:p0789:b003:l019","ordinal":137343,"en":"Raced against flying birds,"},{"id":"semetey-1-2013:p0789:b003:l020","ordinal":137344,"en":"Fought against the bit,"},{"id":"semetey-1-2013:p0789:b003:l021","ordinal":137345,"en":"Reared wildly and strained,"},{"id":"semetey-1-2013:p0789:b003:l022","ordinal":137346,"en":"Thrashed as though her husband had died."},{"id":"semetey-1-2013:p0789:b003:l023","ordinal":137347,"en":"That day Telküröng"},{"id":"semetey-1-2013:p0789:b003:l024","ordinal":137348,"en":"Showed the qualities of a noble steed."},{"id":"semetey-1-2013:p0789:b003:l025","ordinal":137349,"en":"Where he stepped, the dark earth"},{"id":"semetey-1-2013:p0789:b003:l026","ordinal":137350,"en":"Parted like a hearth pit;"},{"id":"semetey-1-2013:p0789:b003:l027","ordinal":137351,"en":"White foam mixed with blood"},{"id":"semetey-1-2013:p0789:b003:l028","ordinal":137352,"en":"Poured upon his breast."},{"id":"semetey-1-2013:p0789:b003:l029","ordinal":137353,"en":"His tail, like strands of silk,"},{"id":"semetey-1-2013:p0789:b003:l030","ordinal":137354,"en":"Spread between his thighs,"},{"id":"semetey-1-2013:p0789:b003:l031","ordinal":137355,"en":"The dark earth his hooves struck"},{"id":"semetey-1-2013:p0789:b003:l032","ordinal":137356,"en":"Split like a hand-dug irrigation ditch."},{"id":"semetey-1-2013:p0789:b003:l033","ordinal":137357,"en":"Hoe-hoofed, broad-rumped,"},{"id":"semetey-1-2013:p0789:b003:l034","ordinal":137358,"en":"Handsome Telküröng."},{"id":"semetey-1-2013:p0789:b003:l035","ordinal":137359,"en":"What could poor Kardygach do?"},{"id":"semetey-1-2013:p0789:b003:l036","ordinal":137360,"en":"That well-seasoned wielder of the club,"},{"id":"semetey-1-2013:p0789:b003:l037","ordinal":137361,"en":"On the downward slope she made the steed"},{"id":"semetey-1-2013:p0789:b003:l038","ordinal":137362,"en":"Plant his forelegs like a roe deer."},{"id":"semetey-1-2013:p0789:b003:l039","ordinal":137363,"en":"When she urged him upward,"},{"id":"semetey-1-2013:p0789:b004:l001","ordinal":137364,"en":"His mane and tail streamed out;"},{"id":"semetey-1-2013:p0789:b004:l002","ordinal":137365,"en":"He tore up the face of the earth,"},{"id":"semetey-1-2013:p0789:b004:l003","ordinal":137366,"en":"She made him race wildly."},{"id":"semetey-1-2013:p0789:b004:l004","ordinal":137367,"en":"Hot upon his trail,"},{"id":"semetey-1-2013:p0789:b004:l005","ordinal":137368,"en":"If the forty companions pursued relentlessly,"},{"id":"semetey-1-2013:p0789:b004:l006","ordinal":137369,"en":"If they pursued the orphan,"},{"id":"semetey-1-2013:p0789:b004:l007","ordinal":137370,"en":"To intercept all forty companions"},{"id":"semetey-1-2013:p0789:b004:l008","ordinal":137371,"en":"Upon their way,"},{"id":"semetey-1-2013:p0789:b004:l009","ordinal":137372,"en":"To smash them to pieces,"},{"id":"semetey-1-2013:p0789:b004:l010","ordinal":137373,"en":"To slaughter them utterly,"},{"id":"semetey-1-2013:p0789:b004:l011","ordinal":137374,"en":"After midnight had passed,"},{"id":"semetey-1-2013:p0789:b004:l012","ordinal":137375,"en":"She sent Telküröng racing"},{"id":"semetey-1-2013:p0789:b004:l013","ordinal":137376,"en":"To Khan Bakai's Karool-Tash,"},{"id":"semetey-1-2013:p0789:b004:l014","ordinal":137377,"en":"The high rock shaped like a skullcap."},{"id":"semetey-1-2013:p0789:b004:l015","ordinal":137378,"en":"Around that rock grew"},{"id":"semetey-1-2013:p0789:b004:l016","ordinal":137379,"en":"Birches mixed with honeysuckle."},{"id":"semetey-1-2013:p0789:b004:l017","ordinal":137380,"en":"Across the twisting ridges,"},{"id":"semetey-1-2013:p0789:b004:l018","ordinal":137381,"en":"Over ridge after ridge,"},{"id":"semetey-1-2013:p0789:b004:l019","ordinal":137382,"en":"Along the winding path,"},{"id":"semetey-1-2013:p0789:b004:l020","ordinal":137383,"en":"Kardygach, who knew it of old,"},{"id":"semetey-1-2013:p0789:b004:l021","ordinal":137384,"en":"Now stood on the watch ridge."},{"id":"semetey-1-2013:p0789:b004:l022","ordinal":137385,"en":"At the four corners of the world"},{"id":"semetey-1-2013:p0789:b004:l023","ordinal":137386,"en":"She looked, turning four ways."},{"id":"semetey-1-2013:p0789:b004:l024","ordinal":137387,"en":"No dust swirled upon the road,"},{"id":"semetey-1-2013:p0789:b004:l025","ordinal":137388,"en":"Nor was there a single moving soul."},{"id":"semetey-1-2013:p0789:b004:l026","ordinal":137389,"en":"Seeing this, Kardygach"},{"id":"semetey-1-2013:p0789:b004:l027","ordinal":137390,"en":"Turned Telküröng's head"},{"id":"semetey-1-2013:p0789:b004:l028","ordinal":137391,"en":"And stood watching without a stir."},{"id":"semetey-1-2013:p0789:b004:l029","ordinal":137392,"en":"Before long,"},{"id":"semetey-1-2013:p0789:b004:l030","ordinal":137393,"en":"A star parted from the sky,"},{"id":"semetey-1-2013:p0789:b004:l031","ordinal":137394,"en":"The glow of dawn appeared."},{"id":"semetey-1-2013:p0789:b004:l032","ordinal":137395,"en":"Stars scattered overhead,"},{"id":"semetey-1-2013:p0789:b004:l033","ordinal":137396,"en":"Streaking toward the west;"},{"id":"semetey-1-2013:p0789:b004:l034","ordinal":137397,"en":"The morning star stood apart,"},{"id":"semetey-1-2013:p0789:b004:l035","ordinal":137398,"en":"The glow of dawn appeared."},{"id":"semetey-1-2013:p0789:b004:l036","ordinal":137399,"en":"The cold wind of dawn whistled,"},{"id":"semetey-1-2013:p0789:b004:l037","ordinal":137400,"en":"The birch tops rattled,"},{"id":"semetey-1-2013:p0789:b004:l038","ordinal":137401,"en":"Young larks called,"},{"id":"semetey-1-2013:p0789:b004:l039","ordinal":137402,"en":"When the dawn broke clear,"},{"id":"semetey-1-2013:p0790:b003:l001","ordinal":137403,"en":"When light fell upon the earth,"},{"id":"semetey-1-2013:p0790:b003:l002","ordinal":137404,"en":"On the northern side,"},{"id":"semetey-1-2013:p0790:b003:l003","ordinal":137405,"en":"At the edge of Kan-Jailak,"},{"id":"semetey-1-2013:p0790:b003:l004","ordinal":137406,"en":"Riding a horse like Kökcholok,"},{"id":"semetey-1-2013:p0790:b003:l005","ordinal":137407,"en":"It was my elder Bakai himself."},{"id":"semetey-1-2013:p0790:b003:l006","ordinal":137408,"en":"‘Look over this way:"},{"id":"semetey-1-2013:p0790:b003:l007","ordinal":137409,"en":"Hastening to say his prayer,"},{"id":"semetey-1-2013:p0790:b003:l008","ordinal":137410,"en":"Saddling Taibuurul,"},{"id":"semetey-1-2013:p0790:b003:l009","ordinal":137411,"en":"My orphan, whom I look to for support,"},{"id":"semetey-1-2013:p0790:b003:l010","ordinal":137412,"en":"Seems to be reaching his desire"},{"id":"semetey-1-2013:p0790:b003:l011","ordinal":137413,"en":"Safe and sound."},{"id":"semetey-1-2013:p0790:b003:l012","ordinal":137414,"en":"He seems to be turning back"},{"id":"semetey-1-2013:p0790:b003:l013","ordinal":137415,"en":"And going to Bukhara."},{"id":"semetey-1-2013:p0790:b003:l014","ordinal":137416,"en":"Small as a crow, alive before my eyes,"},{"id":"semetey-1-2013:p0790:b003:l015","ordinal":137417,"en":"My protector has appeared alive.’"},{"id":"semetey-1-2013:p0790:b003:l016","ordinal":137418,"en":"Kardygach prayed for her wish;"},{"id":"semetey-1-2013:p0790:b003:l017","ordinal":137419,"en":"The tears poured from her eyes."},{"id":"semetey-1-2013:p0790:b003:l018","ordinal":137420,"en":"Then Kardygach,"},{"id":"semetey-1-2013:p0790:b003:l019","ordinal":137421,"en":"Praying fervently,"},{"id":"semetey-1-2013:p0790:b003:l020","ordinal":137422,"en":"Turned toward Jelpinish,"},{"id":"semetey-1-2013:p0790:b003:l021","ordinal":137423,"en":"And prepared to leave."},{"id":"semetey-1-2013:p0790:b003:l022","ordinal":137424,"en":"‘My dear Semetey"},{"id":"semetey-1-2013:p0790:b003:l023","ordinal":137425,"en":"By those prowling dogs"},{"id":"semetey-1-2013:p0790:b003:l024","ordinal":137426,"en":"Is no boy to be overcome."},{"id":"semetey-1-2013:p0790:b003:l025","ordinal":137427,"en":"Khan Bakai beside him"},{"id":"semetey-1-2013:p0790:b003:l026","ordinal":137428,"en":"Is no man to miss a danger."},{"id":"semetey-1-2013:p0790:b003:l027","ordinal":137429,"en":"If I go and meet them now,"},{"id":"semetey-1-2013:p0790:b003:l028","ordinal":137430,"en":"What purpose will I achieve?"},{"id":"semetey-1-2013:p0790:b003:l029","ordinal":137431,"en":"Now I shall go toward Jelpinish.’"},{"id":"semetey-1-2013:p0790:b003:l030","ordinal":137432,"en":"She set off along the road in a rush;"},{"id":"semetey-1-2013:p0790:b003:l031","ordinal":137433,"en":"Your tiger sister urged her horse on."},{"id":"semetey-1-2013:p0790:b003:l032","ordinal":137434,"en":"Fighter, wrestler"},{"id":"semetey-1-2013:p0790:b003:l033","ordinal":137435,"en":"Kardygach vanished from sight."},{"id":"semetey-1-2013:p0790:b003:l034","ordinal":137436,"en":"At her cry she was gone,"},{"id":"semetey-1-2013:p0790:b003:l035","ordinal":137437,"en":"Kardygach vanished from sight."},{"id":"semetey-1-2013:p0790:b003:l036","ordinal":137438,"en":"The gray saddlebags taken as spoil"},{"id":"semetey-1-2013:p0790:b003:l037","ordinal":137439,"en":"They loaded upon Aktulpar,"},{"id":"semetey-1-2013:p0790:b003:l038","ordinal":137440,"en":"Turned the copper cauldron upside down,"},{"id":"semetey-1-2013:p0790:b003:l039","ordinal":137441,"en":"Fastened Akolpok behind the saddle,"},{"id":"semetey-1-2013:p0790:b004:l001","ordinal":137442,"en":"And loaded it upon Aktulpar."},{"id":"semetey-1-2013:p0790:b004:l002","ordinal":137443,"en":"To the valley of Jylgynduu,"},{"id":"semetey-1-2013:p0790:b004:l003","ordinal":137444,"en":"Along great Keng-Kol,"},{"id":"semetey-1-2013:p0790:b004:l004","ordinal":137445,"en":"The boy and Bakai went."},{"id":"semetey-1-2013:p0790:b004:l005","ordinal":137446,"en":"With leaves like leather,"},{"id":"semetey-1-2013:p0790:b004:l006","ordinal":137447,"en":"Was it not the earth's rich rump?"},{"id":"semetey-1-2013:p0790:b004:l007","ordinal":137448,"en":"This precious Keng-Kol—"},{"id":"semetey-1-2013:p0790:b004:l008","ordinal":137449,"en":"Would the Kyrgyz not flourish if they settled here?"},{"id":"semetey-1-2013:p0790:b004:l009","ordinal":137450,"en":"There was a forest at the bend."},{"id":"semetey-1-2013:p0790:b004:l010","ordinal":137451,"en":"Look at its delights:"},{"id":"semetey-1-2013:p0790:b004:l011","ordinal":137452,"en":"Nightingales and sparrows were there together."},{"id":"semetey-1-2013:p0790:b004:l012","ordinal":137453,"en":"When the nightingale sang mournfully,"},{"id":"semetey-1-2013:p0790:b004:l013","ordinal":137454,"en":"A grieving person could not bear to hear;"},{"id":"semetey-1-2013:p0790:b004:l014","ordinal":137455,"en":"He would sob and weep in a frenzy."},{"id":"semetey-1-2013:p0790:b004:l015","ordinal":137456,"en":"A person could not leave its midst."},{"id":"semetey-1-2013:p0790:b004:l016","ordinal":137457,"en":"The orphan Semetey saw it,"},{"id":"semetey-1-2013:p0790:b004:l017","ordinal":137458,"en":"His eyes drank in the place;"},{"id":"semetey-1-2013:p0790:b004:l018","ordinal":137459,"en":"The fierce orphan rejoiced."},{"id":"semetey-1-2013:p0790:b004:l019","ordinal":137460,"en":"Just as he stood there,"},{"id":"semetey-1-2013:p0790:b004:l020","ordinal":137461,"en":"The hills came into view;"},{"id":"semetey-1-2013:p0790:b004:l021","ordinal":137462,"en":"From the back of one hill,"},{"id":"semetey-1-2013:p0790:b004:l022","ordinal":137463,"en":"Driving wild sheep, panting,"},{"id":"semetey-1-2013:p0790:b004:l023","ordinal":137464,"en":"Poor Kumaik appeared."},{"id":"semetey-1-2013:p0790:b004:l024","ordinal":137465,"en":"When Khan Manas's Kumaik"},{"id":"semetey-1-2013:p0790:b004:l025","ordinal":137466,"en":"Came toward them,"},{"id":"semetey-1-2013:p0790:b004:l026","ordinal":137467,"en":"After the dun mare had been slaughtered,"},{"id":"semetey-1-2013:p0790:b004:l027","ordinal":137468,"en":"When he had been entrusted"},{"id":"semetey-1-2013:p0790:b004:l028","ordinal":137469,"en":"To stay beside her,"},{"id":"semetey-1-2013:p0790:b004:l029","ordinal":137470,"en":"Kumaik had shown his strength."},{"id":"semetey-1-2013:p0790:b004:l030","ordinal":137471,"en":"Upon the dun mare's meat"},{"id":"semetey-1-2013:p0790:b004:l031","ordinal":137472,"en":"He had lain and eaten his fill."}]
