[{"id":"semetey-1-2013:p0831:b004:l031","ordinal":140545,"en":"He will bring us all to ruin;"},{"id":"semetey-1-2013:p0831:b004:l032","ordinal":140546,"en":"This very Kokand"},{"id":"semetey-1-2013:p0831:b004:l033","ordinal":140547,"en":"He will slaughter entirely!"},{"id":"semetey-1-2013:p0831:b004:l034","ordinal":140548,"en":"He will plunder the fine cloth,"},{"id":"semetey-1-2013:p0831:b004:l035","ordinal":140549,"en":"The boy will cause havoc!"},{"id":"semetey-1-2013:p0831:b004:l036","ordinal":140550,"en":"They were ready to make us taste salt,"},{"id":"semetey-1-2013:p0831:b005:l001","ordinal":140551,"en":"He will carry off as plunder"},{"id":"semetey-1-2013:p0831:b005:l002","ordinal":140552,"en":"All the girls of Kokand!"},{"id":"semetey-1-2013:p0831:b005:l003","ordinal":140553,"en":"This orphan, Manas’s son,"},{"id":"semetey-1-2013:p0831:b005:l004","ordinal":140554,"en":"Is the very bastard,"},{"id":"semetey-1-2013:p0831:b005:l005","ordinal":140555,"en":"The very image of that reckless rogue."},{"id":"semetey-1-2013:p0831:b005:l006","ordinal":140556,"en":"Having stirred up trouble in Bukhara,"},{"id":"semetey-1-2013:p0831:b005:l007","ordinal":140557,"en":"He is now moving to Talas."},{"id":"semetey-1-2013:p0831:b005:l008","ordinal":140558,"en":"Unless we seize and slaughter him,"},{"id":"semetey-1-2013:p0831:b005:l009","ordinal":140559,"en":"Unless we wipe him out,"},{"id":"semetey-1-2013:p0831:b005:l010","ordinal":140560,"en":"He will not let us turn a plow;"},{"id":"semetey-1-2013:p0831:b005:l011","ordinal":140561,"en":"He will not let us live in Kokand."},{"id":"semetey-1-2013:p0831:b005:l012","ordinal":140562,"en":"He will not let us fit the yoke-pins,"},{"id":"semetey-1-2013:p0831:b005:l013","ordinal":140563,"en":"He will not let us sow our crops."},{"id":"semetey-1-2013:p0831:b005:l014","ordinal":140564,"en":"When summer comes,"},{"id":"semetey-1-2013:p0831:b005:l015","ordinal":140565,"en":"He will not let us ride a maned mare;"},{"id":"semetey-1-2013:p0831:b005:l016","ordinal":140566,"en":"When autumn comes,"},{"id":"semetey-1-2013:p0831:b005:l017","ordinal":140567,"en":"He will not let us eat a fat-tailed yearling sheep."},{"id":"semetey-1-2013:p0831:b005:l018","ordinal":140568,"en":"He will trample on our heads;"},{"id":"semetey-1-2013:p0831:b005:l019","ordinal":140569,"en":"Will he not scatter the four kinds of livestock?"},{"id":"semetey-1-2013:p0831:b005:l020","ordinal":140570,"en":"He will break into our treasury;"},{"id":"semetey-1-2013:p0831:b005:l021","ordinal":140571,"en":"Will he not plunge us into black night?”"},{"id":"semetey-1-2013:p0831:b005:l022","ordinal":140572,"en":"The sentry had fled in panic;"},{"id":"semetey-1-2013:p0831:b005:l023","ordinal":140573,"en":"Thus, to Kozubek,"},{"id":"semetey-1-2013:p0831:b005:l024","ordinal":140574,"en":"He spoke, maligning the boy."},{"id":"semetey-1-2013:p0831:b005:l025","ordinal":140575,"en":"‘The boy will pass through as he moves,’"},{"id":"semetey-1-2013:p0831:b005:l026","ordinal":140576,"en":"Hearing word from a messenger,"},{"id":"semetey-1-2013:p0831:b005:l027","ordinal":140577,"en":"Hearing, ‘He will go to Talas,’"},{"id":"semetey-1-2013:p0831:b005:l028","ordinal":140578,"en":"Considering carefully, thinking much,"},{"id":"semetey-1-2013:p0831:b005:l029","ordinal":140579,"en":"To kill Semetey,"},{"id":"semetey-1-2013:p0831:b005:l030","ordinal":140580,"en":"To cut off his head,"},{"id":"semetey-1-2013:p0831:b005:l031","ordinal":140581,"en":"To Abyke and Kobosh"},{"id":"semetey-1-2013:p0831:b005:l032","ordinal":140582,"en":"To bring the joyful news,"},{"id":"semetey-1-2013:p0831:b005:l033","ordinal":140583,"en":"The wealth left by Manas"},{"id":"semetey-1-2013:p0831:b005:l034","ordinal":140584,"en":"To obtain from those two,"},{"id":"semetey-1-2013:p0831:b005:l035","ordinal":140585,"en":"To receive property as a reward for the news,"},{"id":"semetey-1-2013:p0831:b005:l036","ordinal":140586,"en":"And settle down in wealth—"},{"id":"semetey-1-2013:p0832:b003:l001","ordinal":140587,"en":"The peoples of four khans gathered."},{"id":"semetey-1-2013:p0832:b003:l002","ordinal":140588,"en":"To bustling Kokand"},{"id":"semetey-1-2013:p0832:b003:l003","ordinal":140589,"en":"They flocked and held assembly;"},{"id":"semetey-1-2013:p0832:b003:l004","ordinal":140590,"en":"To crowded Kokand"},{"id":"semetey-1-2013:p0832:b003:l005","ordinal":140591,"en":"They gathered and held assembly."},{"id":"semetey-1-2013:p0832:b003:l006","ordinal":140592,"en":"Chasing one another, they pursued."},{"id":"semetey-1-2013:p0832:b003:l007","ordinal":140593,"en":"Seeking, they found one another;"},{"id":"semetey-1-2013:p0832:b003:l008","ordinal":140594,"en":"They left nothing crooked,"},{"id":"semetey-1-2013:p0832:b003:l009","ordinal":140595,"en":"Straightening and setting their affairs right."},{"id":"semetey-1-2013:p0832:b003:l010","ordinal":140596,"en":"They prepared their noble steeds,"},{"id":"semetey-1-2013:p0832:b003:l011","ordinal":140597,"en":"Made their champions ready."},{"id":"semetey-1-2013:p0832:b003:l012","ordinal":140598,"en":"Many Sarts spoke:"},{"id":"semetey-1-2013:p0832:b003:l013","ordinal":140599,"en":"“That damned orphan—"},{"id":"semetey-1-2013:p0832:b003:l014","ordinal":140600,"en":"I shall seize and slaughter him,” they said."},{"id":"semetey-1-2013:p0832:b003:l015","ordinal":140601,"en":"“That bastard boy—"},{"id":"semetey-1-2013:p0832:b003:l016","ordinal":140602,"en":"Unless we seize and slaughter him,"},{"id":"semetey-1-2013:p0832:b003:l017","ordinal":140603,"en":"Unless we gouge out his eyes,"},{"id":"semetey-1-2013:p0832:b003:l018","ordinal":140604,"en":"Unless we wipe him out,"},{"id":"semetey-1-2013:p0832:b003:l019","ordinal":140605,"en":"Unless we seize him by the arm,"},{"id":"semetey-1-2013:p0832:b003:l020","ordinal":140606,"en":"Drag him onto the road,"},{"id":"semetey-1-2013:p0832:b003:l021","ordinal":140607,"en":"And slaughter him as a sacrifice,"},{"id":"semetey-1-2013:p0832:b003:l022","ordinal":140608,"en":"‘The tribute left by my father—"},{"id":"semetey-1-2013:p0832:b003:l023","ordinal":140609,"en":"Count it out to me now,’ he will say;"},{"id":"semetey-1-2013:p0832:b003:l024","ordinal":140610,"en":"The orphan will finally stir up strife."},{"id":"semetey-1-2013:p0832:b003:l025","ordinal":140611,"en":"Before he reaches his full strength,"},{"id":"semetey-1-2013:p0832:b003:l026","ordinal":140612,"en":"Let us slaughter him without delay."},{"id":"semetey-1-2013:p0832:b003:l027","ordinal":140613,"en":"While the orphan’s bones are still cartilage,"},{"id":"semetey-1-2013:p0832:b003:l028","ordinal":140614,"en":"Let us put an end to him."},{"id":"semetey-1-2013:p0832:b003:l029","ordinal":140615,"en":"Let us take the boy’s life;"},{"id":"semetey-1-2013:p0832:b003:l030","ordinal":140616,"en":"Fierce, foolhardy Manas—"},{"id":"semetey-1-2013:p0832:b003:l031","ordinal":140617,"en":"Let us make him like an extinguished fire!”"},{"id":"semetey-1-2013:p0832:b003:l032","ordinal":140618,"en":"The peoples of four khans united,"},{"id":"semetey-1-2013:p0832:b003:l033","ordinal":140619,"en":"Made a trough of pine,"},{"id":"semetey-1-2013:p0832:b003:l034","ordinal":140620,"en":"And upon Semetey’s head"},{"id":"semetey-1-2013:p0832:b003:l035","ordinal":140621,"en":"I have an invisible snow,"},{"id":"semetey-1-2013:p0832:b003:l036","ordinal":140622,"en":"They had prepared it all."},{"id":"semetey-1-2013:p0832:b003:l037","ordinal":140623,"en":"A thousand champions gathered:"},{"id":"semetey-1-2013:p0832:b003:l038","ordinal":140624,"en":"“If a thousand champions surround him together,"},{"id":"semetey-1-2013:p0832:b003:l039","ordinal":140625,"en":"How can his strength suffice?"},{"id":"semetey-1-2013:p0832:b004:l001","ordinal":140626,"en":"Manas’s reckless orphan"},{"id":"semetey-1-2013:p0832:b004:l002","ordinal":140627,"en":"Will meet his death,” they said."},{"id":"semetey-1-2013:p0832:b004:l003","ordinal":140628,"en":"They considered and discussed,"},{"id":"semetey-1-2013:p0832:b004:l004","ordinal":140629,"en":"Firmly planned to kill him."},{"id":"semetey-1-2013:p0832:b004:l005","ordinal":140630,"en":"Their wise men, their elders,"},{"id":"semetey-1-2013:p0832:b004:l006","ordinal":140631,"en":"All their knowing men said:"},{"id":"semetey-1-2013:p0832:b004:l007","ordinal":140632,"en":"Seven wolves and one colt—"},{"id":"semetey-1-2013:p0832:b004:l008","ordinal":140633,"en":"If they tear at it, will they leave its carcass?"},{"id":"semetey-1-2013:p0832:b004:l009","ordinal":140634,"en":"If a thousand champions fall upon him,"},{"id":"semetey-1-2013:p0832:b004:l010","ordinal":140635,"en":"The orphan son of Manas—"},{"id":"semetey-1-2013:p0832:b004:l011","ordinal":140636,"en":"Will they leave his carcass after beating him?”"},{"id":"semetey-1-2013:p0832:b004:l012","ordinal":140637,"en":"Thus the peoples of four khans"},{"id":"semetey-1-2013:p0832:b004:l013","ordinal":140638,"en":"Prepared their noble steeds,"},{"id":"semetey-1-2013:p0832:b004:l014","ordinal":140639,"en":"Made their champions ready,"},{"id":"semetey-1-2013:p0832:b004:l015","ordinal":140640,"en":"Beat their drums."},{"id":"semetey-1-2013:p0832:b004:l016","ordinal":140641,"en":"As though their own people were not enough,"},{"id":"semetey-1-2013:p0832:b004:l017","ordinal":140642,"en":"They brought men from Hindustan."},{"id":"semetey-1-2013:p0832:b004:l018","ordinal":140643,"en":"They mounted them on horses no shot could catch,"},{"id":"semetey-1-2013:p0832:b004:l019","ordinal":140644,"en":"Clothed them in coats no shot could pierce,"},{"id":"semetey-1-2013:p0832:b004:l020","ordinal":140645,"en":"Their thoroughbreds holding their heads high,"},{"id":"semetey-1-2013:p0832:b004:l021","ordinal":140646,"en":"Kicking the blue hood,"},{"id":"semetey-1-2013:p0832:b004:l022","ordinal":140647,"en":"They made their champions ready,"},{"id":"semetey-1-2013:p0832:b004:l023","ordinal":140648,"en":"Prepared their heroes."},{"id":"semetey-1-2013:p0832:b004:l024","ordinal":140649,"en":"Hearing the sentry’s words,"},{"id":"semetey-1-2013:p0832:b004:l025","ordinal":140650,"en":"Kozubek of Khan Kokand,"},{"id":"semetey-1-2013:p0832:b004:l026","ordinal":140651,"en":"Hearing Semetey had come,"},{"id":"semetey-1-2013:p0832:b004:l027","ordinal":140652,"en":"At the treasury tower"},{"id":"semetey-1-2013:p0832:b004:l028","ordinal":140653,"en":"Tethered his noble steed."},{"id":"semetey-1-2013:p0832:b004:l029","ordinal":140654,"en":"He provided a feast from the treasury,"},{"id":"semetey-1-2013:p0832:b004:l030","ordinal":140655,"en":"Had all the rice boiled,"},{"id":"semetey-1-2013:p0832:b004:l031","ordinal":140656,"en":"Had the dutars played,"},{"id":"semetey-1-2013:p0832:b004:l032","ordinal":140657,"en":"And for all the champions"},{"id":"semetey-1-2013:p0832:b004:l033","ordinal":140658,"en":"Had songs sung throughout."},{"id":"semetey-1-2013:p0832:b004:l034","ordinal":140659,"en":"Among the thousand champions"},{"id":"semetey-1-2013:p0832:b004:l035","ordinal":140660,"en":"Were khojas in motley robes,"},{"id":"semetey-1-2013:p0832:b004:l036","ordinal":140661,"en":"Mullahs reciting lessons,"},{"id":"semetey-1-2013:p0832:b004:l037","ordinal":140662,"en":"Broad-chested warriors,"},{"id":"semetey-1-2013:p0832:b004:l038","ordinal":140663,"en":"Heroes of mighty courage."},{"id":"semetey-1-2013:p0832:b004:l039","ordinal":140664,"en":"Their datkas numbered forty-one."},{"id":"semetey-1-2013:p0833:b003:l001","ordinal":140665,"en":"Kozubek of Khan Kokand"},{"id":"semetey-1-2013:p0833:b003:l002","ordinal":140666,"en":"Had his drums beaten."},{"id":"semetey-1-2013:p0833:b003:l003","ordinal":140667,"en":"As though an enemy had come, a thousand champions"},{"id":"semetey-1-2013:p0833:b003:l004","ordinal":140668,"en":"Equipped themselves for war,"},{"id":"semetey-1-2013:p0833:b003:l005","ordinal":140669,"en":"Girded their swords at a slant."},{"id":"semetey-1-2013:p0833:b003:l006","ordinal":140670,"en":"Their leaders of ten bobbed about,"},{"id":"semetey-1-2013:p0833:b003:l007","ordinal":140671,"en":"Their leaders of fifty strode conspicuously;"},{"id":"semetey-1-2013:p0833:b003:l008","ordinal":140672,"en":"All their leaders of a hundred"},{"id":"semetey-1-2013:p0833:b003:l009","ordinal":140673,"en":"Ran about in haste."},{"id":"semetey-1-2013:p0833:b003:l010","ordinal":140674,"en":"At the tower before the khan,"},{"id":"semetey-1-2013:p0833:b003:l011","ordinal":140675,"en":"The many champions made ready;"},{"id":"semetey-1-2013:p0833:b003:l012","ordinal":140676,"en":"Before Kozubek"},{"id":"semetey-1-2013:p0833:b003:l013","ordinal":140677,"en":"They crowded to bow in homage."},{"id":"semetey-1-2013:p0833:b003:l014","ordinal":140678,"en":"When the champions came and stood there,"},{"id":"semetey-1-2013:p0833:b003:l015","ordinal":140679,"en":"To all the champions"},{"id":"semetey-1-2013:p0833:b003:l016","ordinal":140680,"en":"Kozubek gave command:"},{"id":"semetey-1-2013:p0833:b003:l017","ordinal":140681,"en":"“Your father’s grave, my champions!"},{"id":"semetey-1-2013:p0833:b003:l018","ordinal":140682,"en":"My leaders, every one excellent,"},{"id":"semetey-1-2013:p0833:b003:l019","ordinal":140683,"en":"My men, all champions!"},{"id":"semetey-1-2013:p0833:b003:l020","ordinal":140684,"en":"Of Manas’s orphan son"},{"id":"semetey-1-2013:p0833:b003:l021","ordinal":140685,"en":"I heard word from the sentry:"},{"id":"semetey-1-2013:p0833:b003:l022","ordinal":140686,"en":"Loaded with gold by the pood from Bukhara,"},{"id":"semetey-1-2013:p0833:b003:l023","ordinal":140687,"en":"He is moving here, I heard."},{"id":"semetey-1-2013:p0833:b003:l024","ordinal":140688,"en":"Champions, attend to these words:"},{"id":"semetey-1-2013:p0833:b003:l025","ordinal":140689,"en":"Advance on right and left;"},{"id":"semetey-1-2013:p0833:b003:l026","ordinal":140690,"en":"Seize and scatter his goods as plunder!"},{"id":"semetey-1-2013:p0833:b003:l027","ordinal":140691,"en":"Upon Manas’s orphan son"},{"id":"semetey-1-2013:p0833:b003:l028","ordinal":140692,"en":"Bring great calamity!"},{"id":"semetey-1-2013:p0833:b003:l029","ordinal":140693,"en":"Fight him fiercely!"},{"id":"semetey-1-2013:p0833:b003:l030","ordinal":140694,"en":"Bald Sary, with eyes like little bowls—"},{"id":"semetey-1-2013:p0833:b003:l031","ordinal":140695,"en":"If the khan falls into your hands,"},{"id":"semetey-1-2013:p0833:b003:l032","ordinal":140696,"en":"Slaughter him as a sacrifice!"},{"id":"semetey-1-2013:p0833:b003:l033","ordinal":140697,"en":"If you seize the orphan alive,"},{"id":"semetey-1-2013:p0833:b003:l034","ordinal":140698,"en":"Bind both his hands,"},{"id":"semetey-1-2013:p0833:b003:l035","ordinal":140699,"en":"Gouge out both his eyes,"},{"id":"semetey-1-2013:p0833:b003:l036","ordinal":140700,"en":"And drive him here alive!"},{"id":"semetey-1-2013:p0833:b003:l037","ordinal":140701,"en":"Manas’s orphan son—"},{"id":"semetey-1-2013:p0833:b003:l038","ordinal":140702,"en":"Let us cut off his head;"},{"id":"semetey-1-2013:p0833:b003:l039","ordinal":140703,"en":"Let us take our vengeance thus."},{"id":"semetey-1-2013:p0833:b005:l001","ordinal":140704,"en":"His aged mother Chiyyrdy—"},{"id":"semetey-1-2013:p0833:b005:l002","ordinal":140705,"en":"Let us drag her along the road"},{"id":"semetey-1-2013:p0833:b005:l003","ordinal":140706,"en":"And cast her to the full-grown dogs!"},{"id":"semetey-1-2013:p0833:b005:l004","ordinal":140707,"en":"Kanykei and Semetey—"},{"id":"semetey-1-2013:p0833:b005:l005","ordinal":140708,"en":"Let us seize those two,"},{"id":"semetey-1-2013:p0833:b005:l006","ordinal":140709,"en":"To Abyke and Kobosh"},{"id":"semetey-1-2013:p0833:b005:l007","ordinal":140710,"en":"Let us bring the joyful news."},{"id":"semetey-1-2013:p0833:b005:l008","ordinal":140711,"en":"The yellow gold left by Manas—"},{"id":"semetey-1-2013:p0833:b005:l009","ordinal":140712,"en":"Let us have it counted out to us,"},{"id":"semetey-1-2013:p0833:b005:l010","ordinal":140713,"en":"All the peoples of four khans;"},{"id":"semetey-1-2013:p0833:b005:l011","ordinal":140714,"en":"Let us settle down in wealth!”"},{"id":"semetey-1-2013:p0833:b005:l012","ordinal":140715,"en":"When they received the khan’s command,"},{"id":"semetey-1-2013:p0833:b005:l013","ordinal":140716,"en":"The champions of Andijan and Kokand"},{"id":"semetey-1-2013:p0833:b005:l014","ordinal":140717,"en":"Set out together."},{"id":"semetey-1-2013:p0833:b005:l015","ordinal":140718,"en":"At wielding spears, surpassing"},{"id":"semetey-1-2013:p0833:b005:l016","ordinal":140719,"en":"Warriors were among them;"},{"id":"semetey-1-2013:p0833:b005:l017","ordinal":140720,"en":"Who shook the whole world"},{"id":"semetey-1-2013:p0833:b005:l018","ordinal":140721,"en":"Were heroes among them too."},{"id":"semetey-1-2013:p0833:b005:l019","ordinal":140722,"en":"Their thousand champions rushed forth,"},{"id":"semetey-1-2013:p0833:b005:l020","ordinal":140723,"en":"Traveling along the road."},{"id":"semetey-1-2013:p0833:b005:l021","ordinal":140724,"en":"Many Sarts had no saddle;"},{"id":"semetey-1-2013:p0833:b005:l022","ordinal":140725,"en":"They rode on packsaddles."},{"id":"semetey-1-2013:p0833:b005:l023","ordinal":140726,"en":"The army coming had no sense;"},{"id":"semetey-1-2013:p0833:b005:l024","ordinal":140727,"en":"They rode on Andijan’s ak-kanky saddles."},{"id":"semetey-1-2013:p0833:b005:l025","ordinal":140728,"en":"All their horses were stallions;"},{"id":"semetey-1-2013:p0833:b005:l026","ordinal":140729,"en":"They had no cruppers at all."},{"id":"semetey-1-2013:p0833:b005:l027","ordinal":140730,"en":"No support to rely upon,"},{"id":"semetey-1-2013:p0833:b005:l028","ordinal":140731,"en":"No people to stand firm in combat—"},{"id":"semetey-1-2013:p0833:b005:l029","ordinal":140732,"en":"If they faced one another with spears,"},{"id":"semetey-1-2013:p0833:b005:l030","ordinal":140733,"en":"If they clashed together,"},{"id":"semetey-1-2013:p0833:b005:l031","ordinal":140734,"en":"If one or another fell from his horse,"},{"id":"semetey-1-2013:p0833:b005:l032","ordinal":140735,"en":"Giving shelter to one another—"},{"id":"semetey-1-2013:p0833:b005:l033","ordinal":140736,"en":"They were not men to pull their comrades free."},{"id":"semetey-1-2013:p0833:b005:l034","ordinal":140737,"en":"When the boy turned this way,"},{"id":"semetey-1-2013:p0833:b005:l035","ordinal":140738,"en":"When he returned toward Bukhara,"},{"id":"semetey-1-2013:p0833:b005:l036","ordinal":140739,"en":"Abyke and Kobosh, those six scoundrels,"},{"id":"semetey-1-2013:p0833:b005:l037","ordinal":140740,"en":"Gave six swift horses,"},{"id":"semetey-1-2013:p0833:b005:l038","ordinal":140741,"en":"Gave a letter the size of a palm,"},{"id":"semetey-1-2013:p0833:b005:l039","ordinal":140742,"en":"Devised much treachery,"},{"id":"semetey-1-2013:p0834:b003:l001","ordinal":140743,"en":"Kyrgylchal, leader of the forty—"},{"id":"semetey-1-2013:p0834:b003:l002","ordinal":140744,"en":"They sent Kyrgylchal riding."},{"id":"semetey-1-2013:p0834:b003:l003","ordinal":140745,"en":"Dwelling in Chambyl-Bel"},{"id":"semetey-1-2013:p0834:b003:l004","ordinal":140746,"en":"Were Janaaly and the hero Karach."},{"id":"semetey-1-2013:p0834:b003:l005","ordinal":140747,"en":"On a dark and moonless night he will go."},{"id":"semetey-1-2013:p0834:b003:l006","ordinal":140748,"en":"For killing Koenaaly,"},{"id":"semetey-1-2013:p0834:b003:l007","ordinal":140749,"en":"He too had a vengeance against Semetey."},{"id":"semetey-1-2013:p0834:b003:l008","ordinal":140750,"en":"They had sent him word;"},{"id":"semetey-1-2013:p0834:b003:l009","ordinal":140751,"en":"Kozubek’s army"},{"id":"semetey-1-2013:p0834:b003:l010","ordinal":140752,"en":"He had joined."},{"id":"semetey-1-2013:p0834:b003:l011","ordinal":140753,"en":"The peoples of four khans gathered,"},{"id":"semetey-1-2013:p0834:b003:l012","ordinal":140754,"en":"The lord’s orphan son"},{"id":"semetey-1-2013:p0834:b003:l013","ordinal":140755,"en":"They clamored to overwhelm."},{"id":"semetey-1-2013:p0834:b003:l014","ordinal":140756,"en":"“Do not lose your wits,” they said;"},{"id":"semetey-1-2013:p0834:b003:l015","ordinal":140757,"en":"“Not one of you turn back,” they said."},{"id":"semetey-1-2013:p0834:b003:l016","ordinal":140758,"en":"They chewed white wheat flour,"},{"id":"semetey-1-2013:p0834:b003:l017","ordinal":140759,"en":"Held the Holy Koran,"},{"id":"semetey-1-2013:p0834:b003:l018","ordinal":140760,"en":"Licked an oath unto death,"},{"id":"semetey-1-2013:p0834:b003:l019","ordinal":140761,"en":"Swore a vow to die."},{"id":"semetey-1-2013:p0834:b003:l020","ordinal":140762,"en":"“Do not crowd together; spread out,” they said;"},{"id":"semetey-1-2013:p0834:b003:l021","ordinal":140763,"en":"“Go abreast, all in one line,” they said."},{"id":"semetey-1-2013:p0834:b003:l022","ordinal":140764,"en":"Stretching along the edge, swaying,"},{"id":"semetey-1-2013:p0834:b003:l023","ordinal":140765,"en":"Moving in rows, undulating,"},{"id":"semetey-1-2013:p0834:b003:l024","ordinal":140766,"en":"Their spearheads struck together;"},{"id":"semetey-1-2013:p0834:b003:l025","ordinal":140767,"en":"The men’s heads knocked together."},{"id":"semetey-1-2013:p0834:b003:l026","ordinal":140768,"en":"Look at the reeds, look at the flood;"},{"id":"semetey-1-2013:p0834:b003:l027","ordinal":140769,"en":"Look at the Sart people surging forward!"},{"id":"semetey-1-2013:p0834:b003:l028","ordinal":140770,"en":"All alike as starlings,"},{"id":"semetey-1-2013:p0834:b003:l029","ordinal":140771,"en":"Those riding gray horses formed one group."},{"id":"semetey-1-2013:p0834:b003:l030","ordinal":140772,"en":"Fattened on maize,"},{"id":"semetey-1-2013:p0834:b003:l031","ordinal":140773,"en":"Those riding gray horses formed one group."},{"id":"semetey-1-2013:p0834:b003:l032","ordinal":140774,"en":"Riding stallions, making them pant,"},{"id":"semetey-1-2013:p0834:b003:l033","ordinal":140775,"en":"Making them lunge like a widow in grief,"},{"id":"semetey-1-2013:p0834:b003:l034","ordinal":140776,"en":"Many more suffered thus."},{"id":"semetey-1-2013:p0834:b003:l035","ordinal":140777,"en":"Their necks hunched,"},{"id":"semetey-1-2013:p0834:b003:l036","ordinal":140778,"en":"Their ears pricked,"},{"id":"semetey-1-2013:p0834:b003:l037","ordinal":140779,"en":"Their tails firmly knotted,"},{"id":"semetey-1-2013:p0834:b003:l038","ordinal":140780,"en":"Genuine stout riding horses—"},{"id":"semetey-1-2013:p0834:b003:l039","ordinal":140781,"en":"Those mounted on them formed one group."},{"id":"semetey-1-2013:p0834:b004:l001","ordinal":140782,"en":"Pale banners became their standards;"},{"id":"semetey-1-2013:p0834:b004:l002","ordinal":140783,"en":"Cries of “Boy-boy!” rose in uproar."},{"id":"semetey-1-2013:p0834:b004:l003","ordinal":140784,"en":"Their shouting split the earth;"},{"id":"semetey-1-2013:p0834:b004:l004","ordinal":140785,"en":"Crying the battle cry “Kokand!”"},{"id":"semetey-1-2013:p0834:b004:l005","ordinal":140786,"en":"Their thousand champions yelled,"},{"id":"semetey-1-2013:p0834:b004:l006","ordinal":140787,"en":"Their arrows whistled,"},{"id":"semetey-1-2013:p0834:b004:l007","ordinal":140788,"en":"And all came rushing in."},{"id":"semetey-1-2013:p0834:b004:l008","ordinal":140789,"en":"Your dear mother Kanykei"},{"id":"semetey-1-2013:p0834:b004:l009","ordinal":140790,"en":"Her black hair, thick as a girth,"},{"id":"semetey-1-2013:p0834:b004:l010","ordinal":140791,"en":"Had tied tightly atop her head."},{"id":"semetey-1-2013:p0834:b004:l011","ordinal":140792,"en":"“If my death has come, I shall die;"},{"id":"semetey-1-2013:p0834:b004:l012","ordinal":140793,"en":"If I can, for my only son"},{"id":"semetey-1-2013:p0834:b004:l013","ordinal":140794,"en":"I shall be a shelter,” she said."},{"id":"semetey-1-2013:p0834:b004:l014","ordinal":140795,"en":"Her black, blaze-faced thoroughbred—"},{"id":"semetey-1-2013:p0834:b004:l015","ordinal":140796,"en":"She tightened its girth firmly."},{"id":"semetey-1-2013:p0834:b004:l016","ordinal":140797,"en":"Beside her, Sary Khan,"},{"id":"semetey-1-2013:p0834:b004:l017","ordinal":140798,"en":"His fiery eyes blazing brightly,"},{"id":"semetey-1-2013:p0834:b004:l018","ordinal":140799,"en":"His mighty teeth like a door,"},{"id":"semetey-1-2013:p0834:b004:l019","ordinal":140800,"en":"Gnashed them hard, again and again."}]
