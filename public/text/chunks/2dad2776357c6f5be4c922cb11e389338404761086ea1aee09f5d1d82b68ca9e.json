[{"id":"semetey-1-2013:p1162:b003:l037","ordinal":164865,"en":"And our honored sister-in-law Kanykei—"},{"id":"semetey-1-2013:p1162:b003:l038","ordinal":164866,"en":"The bloodthirsty man will cut off her head."},{"id":"semetey-1-2013:p1162:b003:l039","ordinal":164867,"en":"He will put to death"},{"id":"semetey-1-2013:p1162:b004:l001","ordinal":164868,"en":"Our resourceful treasure,"},{"id":"semetey-1-2013:p1162:b004:l002","ordinal":164869,"en":"Our lionhearted, fierce sister-in-law.”"},{"id":"semetey-1-2013:p1162:b004:l003","ordinal":164870,"en":"Agybay, son of Argyn Khan,"},{"id":"semetey-1-2013:p1162:b004:l004","ordinal":164871,"en":"Stepped between them."},{"id":"semetey-1-2013:p1162:b004:l005","ordinal":164872,"en":"Brave Bakai, son of Oloyat,"},{"id":"semetey-1-2013:p1162:b004:l006","ordinal":164873,"en":"Seized the bloodthirsty man"},{"id":"semetey-1-2013:p1162:b004:l007","ordinal":164874,"en":"And held him back as he thrashed in fury."},{"id":"semetey-1-2013:p1162:b004:l008","ordinal":164875,"en":"Almambet, son of Khan Azozül,"},{"id":"semetey-1-2013:p1162:b004:l009","ordinal":164876,"en":"Saying, “Hero, restrain your anger,”"},{"id":"semetey-1-2013:p1162:b004:l010","ordinal":164877,"en":"Intervened and stopped him."},{"id":"semetey-1-2013:p1162:b004:l011","ordinal":164878,"en":"When Manas lunged at their sister-in-law,"},{"id":"semetey-1-2013:p1162:b004:l012","ordinal":164879,"en":"All forty companions,"},{"id":"semetey-1-2013:p1162:b004:l013","ordinal":164880,"en":"As if disaster had struck them,"},{"id":"semetey-1-2013:p1162:b004:l014","ordinal":164881,"en":"The old and gray-haired among them"},{"id":"semetey-1-2013:p1162:b004:l015","ordinal":164882,"en":"Staggered, understanding what had happened."},{"id":"semetey-1-2013:p1162:b004:l016","ordinal":164883,"en":"All forty companions said,"},{"id":"semetey-1-2013:p1162:b004:l017","ordinal":164884,"en":"“Why should we look to"},{"id":"semetey-1-2013:p1162:b004:l018","ordinal":164885,"en":"A bloodthirsty man who slaughters his wife?"},{"id":"semetey-1-2013:p1162:b004:l019","ordinal":164886,"en":"All forty of us are sons of forty khans;"},{"id":"semetey-1-2013:p1162:b004:l020","ordinal":164887,"en":"Let us all disperse"},{"id":"semetey-1-2013:p1162:b004:l021","ordinal":164888,"en":"And return to our own lands.”"},{"id":"semetey-1-2013:p1162:b004:l022","ordinal":164889,"en":"The forty companions bristled"},{"id":"semetey-1-2013:p1162:b004:l023","ordinal":164890,"en":"And glowered at Manas:"},{"id":"semetey-1-2013:p1162:b004:l024","ordinal":164891,"en":"“He obeyed at once"},{"id":"semetey-1-2013:p1162:b004:l025","ordinal":164892,"en":"The fool whose trousers would not fit;"},{"id":"semetey-1-2013:p1162:b004:l026","ordinal":164893,"en":"Preparing to kill"},{"id":"semetey-1-2013:p1162:b004:l027","ordinal":164894,"en":"Kanykei, our true treasure,"},{"id":"semetey-1-2013:p1162:b004:l028","ordinal":164895,"en":"God has taken leave of the bloodthirsty man."},{"id":"semetey-1-2013:p1162:b004:l029","ordinal":164896,"en":"We became Manas's companions;"},{"id":"semetey-1-2013:p1162:b004:l030","ordinal":164897,"en":"Why should we stand here for nothing?"},{"id":"semetey-1-2013:p1162:b004:l031","ordinal":164898,"en":"If he attacks Kanykei,"},{"id":"semetey-1-2013:p1162:b004:l032","ordinal":164899,"en":"Let us grapple"},{"id":"semetey-1-2013:p1162:b004:l033","ordinal":164900,"en":"With the bloodthirsty man, mighty as Kambar."},{"id":"semetey-1-2013:p1162:b004:l034","ordinal":164901,"en":"We forty companions came from many lands;"},{"id":"semetey-1-2013:p1162:b004:l035","ordinal":164902,"en":"Kanykei became our refuge."},{"id":"semetey-1-2013:p1162:b004:l036","ordinal":164903,"en":"She joined what was severed"},{"id":"semetey-1-2013:p1162:b004:l037","ordinal":164904,"en":"And gathered what was scattered."},{"id":"semetey-1-2013:p1162:b004:l038","ordinal":164905,"en":"By laying course upon course, she made a house;"},{"id":"semetey-1-2013:p1162:b004:l039","ordinal":164906,"en":"By planting shoot upon shoot, she made a garden."},{"id":"semetey-1-2013:p1163:b003:l001","ordinal":164907,"en":"“Saying, ‘I will take the wretch's head,’"},{"id":"semetey-1-2013:p1163:b003:l002","ordinal":164908,"en":"This bloodthirsty man has gone mad.”"},{"id":"semetey-1-2013:p1163:b003:l003","ordinal":164909,"en":"They muttered without speaking openly;"},{"id":"semetey-1-2013:p1163:b003:l004","ordinal":164910,"en":"They grumbled to one another."},{"id":"semetey-1-2013:p1163:b003:l005","ordinal":164911,"en":"When Manas stood there snorting,"},{"id":"semetey-1-2013:p1163:b003:l006","ordinal":164912,"en":"When the bloodthirsty man went forth in fury,"},{"id":"semetey-1-2013:p1163:b003:l007","ordinal":164913,"en":"At Kökötöy's feast,"},{"id":"semetey-1-2013:p1163:b003:l008","ordinal":164914,"en":"Before the great assembly,"},{"id":"semetey-1-2013:p1163:b003:l009","ordinal":164915,"en":"On the banks of Karkyra,"},{"id":"semetey-1-2013:p1163:b003:l010","ordinal":164916,"en":"Just as he entered"},{"id":"semetey-1-2013:p1163:b003:l011","ordinal":164917,"en":"Khan Manas's camp,"},{"id":"semetey-1-2013:p1163:b003:l012","ordinal":164918,"en":"Kanykei with her forty young wives"},{"id":"semetey-1-2013:p1163:b003:l013","ordinal":164919,"en":"Led the forty young wives"},{"id":"semetey-1-2013:p1163:b003:l014","ordinal":164920,"en":"Out of the camp."},{"id":"semetey-1-2013:p1163:b003:l015","ordinal":164921,"en":"Her rump showed white as a wild ewe's;"},{"id":"semetey-1-2013:p1163:b003:l016","ordinal":164922,"en":"Her white breasts swayed."},{"id":"semetey-1-2013:p1163:b003:l017","ordinal":164923,"en":"With forty young wives following her,"},{"id":"semetey-1-2013:p1163:b003:l018","ordinal":164924,"en":"She spoke softly and sadly"},{"id":"semetey-1-2013:p1163:b003:l019","ordinal":164925,"en":"To the prince who was raging,"},{"id":"semetey-1-2013:p1163:b003:l020","ordinal":164926,"en":"And would not let him go on Akkula."},{"id":"semetey-1-2013:p1163:b003:l021","ordinal":164927,"en":"His nose bulged like a leather flask;"},{"id":"semetey-1-2013:p1163:b003:l022","ordinal":164928,"en":"As he raged and thrashed,"},{"id":"semetey-1-2013:p1163:b003:l023","ordinal":164929,"en":"Twelve companions struggled"},{"id":"semetey-1-2013:p1163:b003:l024","ordinal":164930,"en":"To hold Manas back."},{"id":"semetey-1-2013:p1163:b003:l025","ordinal":164931,"en":"They exchanged muffled words"},{"id":"semetey-1-2013:p1163:b003:l026","ordinal":164932,"en":"And whispered among themselves,"},{"id":"semetey-1-2013:p1163:b003:l027","ordinal":164933,"en":"Thinking with dread,"},{"id":"semetey-1-2013:p1163:b003:l028","ordinal":164934,"en":"“This bloodthirsty man who kills his wife—"},{"id":"semetey-1-2013:p1163:b003:l029","ordinal":164935,"en":"How could he spare us?”"},{"id":"semetey-1-2013:p1163:b003:l030","ordinal":164936,"en":"They would not release the bloodthirsty man,"},{"id":"semetey-1-2013:p1163:b003:l031","ordinal":164937,"en":"But stepped between them."},{"id":"semetey-1-2013:p1163:b003:l032","ordinal":164938,"en":"Shimmering in garments of yellow gold,"},{"id":"semetey-1-2013:p1163:b003:l033","ordinal":164939,"en":"With forty young wives following her,"},{"id":"semetey-1-2013:p1163:b003:l034","ordinal":164940,"en":"She came gleaming before him."},{"id":"semetey-1-2013:p1163:b003:l035","ordinal":164941,"en":"She spoke to the blue-maned lion,"},{"id":"semetey-1-2013:p1163:b003:l036","ordinal":164942,"en":"Saying openly:"},{"id":"semetey-1-2013:p1163:b003:l037","ordinal":164943,"en":"“Here are the teeming multitudes."},{"id":"semetey-1-2013:p1163:b003:l038","ordinal":164944,"en":"You have grown furious;"},{"id":"semetey-1-2013:p1163:b003:l039","ordinal":164945,"en":"Though I am only a woman, hear me."},{"id":"semetey-1-2013:p1163:b005:l001","ordinal":164946,"en":"Here I am—spill my blood."},{"id":"semetey-1-2013:p1163:b005:l002","ordinal":164947,"en":"While the people stand here,"},{"id":"semetey-1-2013:p1163:b005:l003","ordinal":164948,"en":"I have something fitting to say."},{"id":"semetey-1-2013:p1163:b005:l004","ordinal":164949,"en":"If you spill my blood,"},{"id":"semetey-1-2013:p1163:b005:l005","ordinal":164950,"en":"My bloodthirsty lord, I have words for you."},{"id":"semetey-1-2013:p1163:b005:l006","ordinal":164951,"en":"Knowing your elder would wear it,"},{"id":"semetey-1-2013:p1163:b005:l007","ordinal":164952,"en":"I lined its inside with brocade."},{"id":"semetey-1-2013:p1163:b005:l008","ordinal":164953,"en":"For six years without rest, I worked it with my teeth."},{"id":"semetey-1-2013:p1163:b005:l009","ordinal":164954,"en":"While the maidens and young wives embroidered it,"},{"id":"semetey-1-2013:p1163:b005:l010","ordinal":164955,"en":"I had the places I disliked unstitched."},{"id":"semetey-1-2013:p1163:b005:l011","ordinal":164956,"en":"Plate after plate of steel"},{"id":"semetey-1-2013:p1163:b005:l012","ordinal":164957,"en":"I had poured into its midst."},{"id":"semetey-1-2013:p1163:b005:l013","ordinal":164958,"en":"I made it with all my heart."},{"id":"semetey-1-2013:p1163:b005:l014","ordinal":164959,"en":"Weeping in supplication to the one God,"},{"id":"semetey-1-2013:p1163:b005:l015","ordinal":164960,"en":"From the very beginning, wretched as I was,"},{"id":"semetey-1-2013:p1163:b005:l016","ordinal":164961,"en":"I dedicated it to my elder."},{"id":"semetey-1-2013:p1163:b005:l017","ordinal":164962,"en":"I have endless words to tell."},{"id":"semetey-1-2013:p1163:b005:l018","ordinal":164963,"en":"If I made the kandagai wider,"},{"id":"semetey-1-2013:p1163:b005:l019","ordinal":164964,"en":"I feared he would unleash a massacre;"},{"id":"semetey-1-2013:p1163:b005:l020","ordinal":164965,"en":"I feared my bloodthirsty lord would take my head."},{"id":"semetey-1-2013:p1163:b005:l021","ordinal":164966,"en":"That was the measure of my fear."},{"id":"semetey-1-2013:p1163:b005:l022","ordinal":164967,"en":"I kept measuring its dimensions:"},{"id":"semetey-1-2013:p1163:b005:l023","ordinal":164968,"en":"Six spans and four finger-widths"},{"id":"semetey-1-2013:p1163:b005:l024","ordinal":164969,"en":"From the end of the cuff,"},{"id":"semetey-1-2013:p1163:b005:l025","ordinal":164970,"en":"And from the rim of the fat rump,"},{"id":"semetey-1-2013:p1163:b005:l026","ordinal":164971,"en":"I have a clasp joining it shut."},{"id":"semetey-1-2013:p1163:b005:l027","ordinal":164972,"en":"I have many words to tell."},{"id":"semetey-1-2013:p1163:b005:l028","ordinal":164973,"en":"Many cares cannot fit within my heart;"},{"id":"semetey-1-2013:p1163:b005:l029","ordinal":164974,"en":"The tears from my eyes spread in ten directions."},{"id":"semetey-1-2013:p1163:b005:l030","ordinal":164975,"en":"Almambet and Chubak, whose names rhyme,"},{"id":"semetey-1-2013:p1163:b005:l031","ordinal":164976,"en":"Let them take opposing sides and pull.”"},{"id":"semetey-1-2013:p1163:b005:l032","ordinal":164977,"en":"Your furious bloodthirsty man"},{"id":"semetey-1-2013:p1163:b005:l033","ordinal":164978,"en":"Grabbed the black-bladed whip,"},{"id":"semetey-1-2013:p1163:b005:l034","ordinal":164979,"en":"Seized it and turned it around."},{"id":"semetey-1-2013:p1163:b005:l035","ordinal":164980,"en":"The towering leopard"},{"id":"semetey-1-2013:p1163:b005:l036","ordinal":164981,"en":"Pulled it toward the middle;"},{"id":"semetey-1-2013:p1163:b005:l037","ordinal":164982,"en":"With a ripping sound, the trousers tore,"},{"id":"semetey-1-2013:p1163:b005:l038","ordinal":164983,"en":"Their folds came loose and opened."},{"id":"semetey-1-2013:p1163:b005:l039","ordinal":164984,"en":"That queen Kanykei's"},{"id":"semetey-1-2013:p1164:b003:l001","ordinal":164985,"en":"Far-off misery came to an end."},{"id":"semetey-1-2013:p1164:b003:l002","ordinal":164986,"en":"When Khan Koshoi of the Katagan,"},{"id":"semetey-1-2013:p1164:b003:l003","ordinal":164987,"en":"Your elder, father of the people,"},{"id":"semetey-1-2013:p1164:b003:l004","ordinal":164988,"en":"Put on the kandagai,"},{"id":"semetey-1-2013:p1164:b003:l005","ordinal":164989,"en":"Your elder, old Koshoi,"},{"id":"semetey-1-2013:p1164:b003:l006","ordinal":164990,"en":"Cuff upon cuff,"},{"id":"semetey-1-2013:p1164:b003:l007","ordinal":164991,"en":"It was as though fitted in place;"},{"id":"semetey-1-2013:p1164:b003:l008","ordinal":164992,"en":"Fat rump upon fat rump,"},{"id":"semetey-1-2013:p1164:b003:l009","ordinal":164993,"en":"It was as though patched in place."},{"id":"semetey-1-2013:p1164:b003:l010","ordinal":164994,"en":"Old hero Koshoi"},{"id":"semetey-1-2013:p1164:b003:l011","ordinal":164995,"en":"Then tested Kanykei,"},{"id":"semetey-1-2013:p1164:b003:l012","ordinal":164996,"en":"Daughter of Kara Khan,"},{"id":"semetey-1-2013:p1164:b003:l013","ordinal":164997,"en":"The wretched daughter of a saint."},{"id":"semetey-1-2013:p1164:b003:l014","ordinal":164998,"en":"Seeing this, he approved."},{"id":"semetey-1-2013:p1164:b003:l015","ordinal":164999,"en":"Kanykei, the prince's wife,"},{"id":"semetey-1-2013:p1164:b003:l016","ordinal":165000,"en":"Bent her knees to the ground"},{"id":"semetey-1-2013:p1164:b003:l017","ordinal":165001,"en":"And stood bowing"},{"id":"semetey-1-2013:p1164:b003:l018","ordinal":165002,"en":"Before Koshoi, father of the people."},{"id":"semetey-1-2013:p1164:b003:l019","ordinal":165003,"en":"Her prayer to God"},{"id":"semetey-1-2013:p1164:b003:l020","ordinal":165004,"en":"Had reached Him long before."},{"id":"semetey-1-2013:p1164:b003:l021","ordinal":165005,"en":"At Khan Kökötöy's feast,"},{"id":"semetey-1-2013:p1164:b003:l022","ordinal":165006,"en":"While infidels and Muslims"},{"id":"semetey-1-2013:p1164:b003:l023","ordinal":165007,"en":"Seethed there before him,"},{"id":"semetey-1-2013:p1164:b003:l024","ordinal":165008,"en":"When she bowed to her elder khan,"},{"id":"semetey-1-2013:p1164:b003:l025","ordinal":165009,"en":"He became as heavy as lead."},{"id":"semetey-1-2013:p1164:b003:l026","ordinal":165010,"en":"Koshoi tested the fierce woman:"},{"id":"semetey-1-2013:p1164:b003:l027","ordinal":165011,"en":"“Ah, my poor Kanykei,"},{"id":"semetey-1-2013:p1164:b003:l028","ordinal":165012,"en":"Her fortunes are complete;"},{"id":"semetey-1-2013:p1164:b003:l029","ordinal":165013,"en":"Her twelve limbs are ample."},{"id":"semetey-1-2013:p1164:b003:l030","ordinal":165014,"en":"Her courage is great, her wrath is strong;"},{"id":"semetey-1-2013:p1164:b003:l031","ordinal":165015,"en":"She is a woman who will bear a lion."},{"id":"semetey-1-2013:p1164:b003:l032","ordinal":165016,"en":"She is a chosen one among spear-wielders,"},{"id":"semetey-1-2013:p1164:b003:l033","ordinal":165017,"en":"A woman who will bear a hero."},{"id":"semetey-1-2013:p1164:b003:l034","ordinal":165018,"en":"She is a seamstress with golden fingers;"},{"id":"semetey-1-2013:p1164:b003:l035","ordinal":165019,"en":"Among women there can be none like her,"},{"id":"semetey-1-2013:p1164:b003:l036","ordinal":165020,"en":"For she herself is a saint's daughter."},{"id":"semetey-1-2013:p1164:b003:l037","ordinal":165021,"en":"When trouble assails, she will undo it;"},{"id":"semetey-1-2013:p1164:b003:l038","ordinal":165022,"en":"She is one of the finest of people."},{"id":"semetey-1-2013:p1164:b003:l039","ordinal":165023,"en":"For the sacred bloodthirsty man,"},{"id":"semetey-1-2013:p1164:b004:l001","ordinal":165024,"en":"She is the Night of Power itself."},{"id":"semetey-1-2013:p1164:b004:l002","ordinal":165025,"en":"She was born with excellent wisdom;"},{"id":"semetey-1-2013:p1164:b004:l003","ordinal":165026,"en":"Her pelvis is narrow."},{"id":"semetey-1-2013:p1164:b004:l004","ordinal":165027,"en":"Put another way, there is something to say:"},{"id":"semetey-1-2013:p1164:b004:l005","ordinal":165028,"en":"There is a reason she might not bear a child."},{"id":"semetey-1-2013:p1164:b004:l006","ordinal":165029,"en":"Her forehead bone curves back;"},{"id":"semetey-1-2013:p1164:b004:l007","ordinal":165030,"en":"After the hero's eyes close,"},{"id":"semetey-1-2013:p1164:b004:l008","ordinal":165031,"en":"Her chance of surviving is poor."},{"id":"semetey-1-2013:p1164:b004:l009","ordinal":165032,"en":"The hair at her nape is like wool;"},{"id":"semetey-1-2013:p1164:b004:l010","ordinal":165033,"en":"When the hero's eyes close,"},{"id":"semetey-1-2013:p1164:b004:l011","ordinal":165034,"en":"She was born for sorrow."},{"id":"semetey-1-2013:p1164:b004:l012","ordinal":165035,"en":"The hair on her brow is like grass;"},{"id":"semetey-1-2013:p1164:b004:l013","ordinal":165036,"en":"She has little happiness"},{"id":"semetey-1-2013:p1164:b004:l014","ordinal":165037,"en":"And much misfortune.”"},{"id":"semetey-1-2013:p1164:b004:l015","ordinal":165038,"en":"Koshoi spoke these words."},{"id":"semetey-1-2013:p1164:b004:l016","ordinal":165039,"en":"When Koshoi looked again,"},{"id":"semetey-1-2013:p1164:b004:l017","ordinal":165040,"en":"Unable to contain her distress,"},{"id":"semetey-1-2013:p1164:b004:l018","ordinal":165041,"en":"Dear Kanykei"},{"id":"semetey-1-2013:p1164:b004:l019","ordinal":165042,"en":"Was asking God for a child."},{"id":"semetey-1-2013:p1164:b004:l020","ordinal":165043,"en":"From those dear quail-like eyes,"},{"id":"semetey-1-2013:p1164:b004:l021","ordinal":165044,"en":"Tears streamed apart;"},{"id":"semetey-1-2013:p1164:b004:l022","ordinal":165045,"en":"From those dear currant-like eyes,"},{"id":"semetey-1-2013:p1164:b004:l023","ordinal":165046,"en":"Tears streamed a whip's length."},{"id":"semetey-1-2013:p1164:b004:l024","ordinal":165047,"en":"Wailing in repentance,"},{"id":"semetey-1-2013:p1164:b004:l025","ordinal":165048,"en":"Sobbing and weeping without cease,"},{"id":"semetey-1-2013:p1164:b004:l026","ordinal":165049,"en":"Turning over countless cares,"},{"id":"semetey-1-2013:p1164:b004:l027","ordinal":165050,"en":"Asking my Lord for a child,"},{"id":"semetey-1-2013:p1164:b004:l028","ordinal":165051,"en":"Her knees bent to the ground,"},{"id":"semetey-1-2013:p1164:b004:l029","ordinal":165052,"en":"Your sister-in-law bowed"},{"id":"semetey-1-2013:p1164:b004:l030","ordinal":165053,"en":"Before Koshoi of the Katagan."},{"id":"semetey-1-2013:p1164:b004:l031","ordinal":165054,"en":"As soon as he saw your sister-in-law,"},{"id":"semetey-1-2013:p1164:b004:l032","ordinal":165055,"en":"Khan Koshoi gave his blessing."},{"id":"semetey-1-2013:p1164:b004:l033","ordinal":165056,"en":"Infidels and Muslims"},{"id":"semetey-1-2013:p1164:b004:l034","ordinal":165057,"en":"Joined in the blessing:"},{"id":"semetey-1-2013:p1164:b004:l035","ordinal":165058,"en":"“May Kydyr be a fresh young willow for him;"},{"id":"semetey-1-2013:p1164:b004:l036","ordinal":165059,"en":"Until he climbs the mountain ridge,"},{"id":"semetey-1-2013:p1164:b004:l037","ordinal":165060,"en":"May God, who will act for Semetey,"},{"id":"semetey-1-2013:p1164:b004:l038","ordinal":165061,"en":"Be his protector!"},{"id":"semetey-1-2013:p1164:b004:l039","ordinal":165062,"en":"May he grease his white steel;"},{"id":"semetey-1-2013:p1165:b003:l001","ordinal":165063,"en":"When someone provokes his anger,"},{"id":"semetey-1-2013:p1165:b003:l002","ordinal":165064,"en":"May he lay that man's father beside him!"},{"id":"semetey-1-2013:p1165:b003:l003","ordinal":165065,"en":"May he grease his blue steel;"},{"id":"semetey-1-2013:p1165:b003:l004","ordinal":165066,"en":"When someone crosses him,"},{"id":"semetey-1-2013:p1165:b003:l005","ordinal":165067,"en":"May he lay low the forty companions."},{"id":"semetey-1-2013:p1165:b003:l006","ordinal":165068,"en":"May this Semetey become a hero,"},{"id":"semetey-1-2013:p1165:b003:l007","ordinal":165069,"en":"May he become a keen-eared lion."},{"id":"semetey-1-2013:p1165:b003:l008","ordinal":165070,"en":"On a downward slope, may he spear a hero;"},{"id":"semetey-1-2013:p1165:b003:l009","ordinal":165071,"en":"May he spear many in a single row."},{"id":"semetey-1-2013:p1165:b003:l010","ordinal":165072,"en":"May his fortunes be complete."},{"id":"semetey-1-2013:p1165:b003:l011","ordinal":165073,"en":"Descendant of ocean-like Manas,"},{"id":"semetey-1-2013:p1165:b003:l012","ordinal":165074,"en":"May he be a lion like his father!"},{"id":"semetey-1-2013:p1165:b003:l013","ordinal":165075,"en":"May he be a fire blazing on the ridge;"},{"id":"semetey-1-2013:p1165:b003:l014","ordinal":165076,"en":"May no enemy withstand him!"},{"id":"semetey-1-2013:p1165:b003:l015","ordinal":165077,"en":"Amen!” he said, spreading his hands,"},{"id":"semetey-1-2013:p1165:b003:l016","ordinal":165078,"en":"And Koshoi gave the blessing."},{"id":"semetey-1-2013:p1165:b003:l017","ordinal":165079,"en":"Infidels and Muslims,"},{"id":"semetey-1-2013:p1165:b003:l018","ordinal":165080,"en":"Saying, “Such is his sacred rite,”"},{"id":"semetey-1-2013:p1165:b003:l019","ordinal":165081,"en":"Joined in the blessing."},{"id":"semetey-1-2013:p1165:b003:l020","ordinal":165082,"en":"The earth resounded."},{"id":"semetey-1-2013:p1165:b003:l021","ordinal":165083,"en":"Khan Manas received his blessing."},{"id":"semetey-1-2013:p1165:b003:l022","ordinal":165084,"en":"As for your dear elder Koshoi—"},{"id":"semetey-1-2013:p1165:b003:l023","ordinal":165085,"en":"People, look on in wonder!"},{"id":"semetey-1-2013:p1165:b003:l024","ordinal":165086,"en":"Burning and raging,"},{"id":"semetey-1-2013:p1165:b003:l025","ordinal":165087,"en":"He put on the kandagai."},{"id":"semetey-1-2013:p1165:b003:l026","ordinal":165088,"en":"He prayed to the Almighty;"},{"id":"semetey-1-2013:p1165:b003:l027","ordinal":165089,"en":"Your poor elder, the giant Koshoi,"},{"id":"semetey-1-2013:p1165:b003:l028","ordinal":165090,"en":"Made ready like a starving tiger."},{"id":"semetey-1-2013:p1165:b003:l029","ordinal":165091,"en":"If death came, he was ready to die;"},{"id":"semetey-1-2013:p1165:b003:l030","ordinal":165092,"en":"If strength came to your elder,"},{"id":"semetey-1-2013:p1165:b003:l031","ordinal":165093,"en":"He was ready to meet"},{"id":"semetey-1-2013:p1165:b003:l032","ordinal":165094,"en":"The Kalmyks' giant Joloy in combat."},{"id":"semetey-1-2013:p1165:b003:l033","ordinal":165095,"en":"Khan Bakai of surpassing strength,"},{"id":"semetey-1-2013:p1165:b003:l034","ordinal":165096,"en":"Your elder, old Koshoi,"},{"id":"semetey-1-2013:p1165:b003:l035","ordinal":165097,"en":"His white beard flowing,"},{"id":"semetey-1-2013:p1165:b003:l036","ordinal":165098,"en":"Barefoot and bareheaded,"},{"id":"semetey-1-2013:p1165:b003:l037","ordinal":165099,"en":"Advanced toward the wrestler."},{"id":"semetey-1-2013:p1165:b003:l038","ordinal":165100,"en":"Your ancient elder Koshoi's"},{"id":"semetey-1-2013:p1165:b003:l039","ordinal":165101,"en":"Muscles were like a bull's back,"},{"id":"semetey-1-2013:p1165:b004:l001","ordinal":165102,"en":"As though he could devour anyone who grappled him;"},{"id":"semetey-1-2013:p1165:b004:l002","ordinal":165103,"en":"Like a tiger about to pounce—"},{"id":"semetey-1-2013:p1165:b004:l003","ordinal":165104,"en":"Such was Koshoi's fury."},{"id":"semetey-1-2013:p1165:b004:l004","ordinal":165105,"en":"It seemed no man could wrestle him."},{"id":"semetey-1-2013:p1165:b004:l005","ordinal":165106,"en":"Thinking of honor and shame,"},{"id":"semetey-1-2013:p1165:b004:l006","ordinal":165107,"en":"Your elder went out to the wrestler."},{"id":"semetey-1-2013:p1165:b004:l007","ordinal":165108,"en":"Your elder, old Koshoi,"},{"id":"semetey-1-2013:p1165:b004:l008","ordinal":165109,"en":"Who left no one he seized unharmed,"},{"id":"semetey-1-2013:p1165:b004:l009","ordinal":165110,"en":"Was going to contend"},{"id":"semetey-1-2013:p1165:b004:l010","ordinal":165111,"en":"With the Kalmyks' Joloy;"},{"id":"semetey-1-2013:p1165:b004:l011","ordinal":165112,"en":"He was going to fight to the death."},{"id":"semetey-1-2013:p1165:b004:l012","ordinal":165113,"en":"It was Kökötöy's feast,"},{"id":"semetey-1-2013:p1165:b004:l013","ordinal":165114,"en":"Before the great assembly."},{"id":"semetey-1-2013:p1165:b004:l014","ordinal":165115,"en":"Dust flew to the sky;"},{"id":"semetey-1-2013:p1165:b004:l015","ordinal":165116,"en":"People seethed in the dust."},{"id":"semetey-1-2013:p1165:b004:l016","ordinal":165117,"en":"They swarmed like black worms;"},{"id":"semetey-1-2013:p1165:b004:l017","ordinal":165118,"en":"The people gathered, buzzing."},{"id":"semetey-1-2013:p1165:b004:l018","ordinal":165119,"en":"Saying it was Kökötöy's feast,"},{"id":"semetey-1-2013:p1165:b004:l019","ordinal":165120,"en":"The gathering of many leaders,"}]
