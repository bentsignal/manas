{"id": "sayakbay-ms-current146:pdf215:l001", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 1, "raw": "Берегеден чалдары,", "text": "Берегеден чалдары,", "en": "The elders came from the far bank.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l002", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 2, "raw": "Аз жеткен олтуруп,", "text": "Аз жеткен олтуруп,", "en": "The few who arrived sat down.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l003", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 3, "raw": "Алтыннын чокко түштү,", "text": "Алтыннын чокко түштү,", "en": "The gold fell into the embers.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l004", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 4, "raw": "Көп жеткен айрылып,", "text": "Көп жеткен айрылып,", "en": "The many who arrived were separated.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l005", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 5, "raw": "Көөдөнүн чокко түштү,", "text": "Көөдөнүн чокко түштү,", "en": "The fire fell into his breast.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 6, "raw": "Мына омокто ур кыраан,", "text": "Мына омокто ур кыраан,", "en": "Now strike, mighty falcon, amid the tumult.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 7, "raw": "Кыямат мушкул жолунда,", "text": "Кыямат мушкул жолунда,", "en": "Upon the hard road of doomsday,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 8, "raw": "Жараткан жалгыз колунда,", "text": "Жараткан жалгыз колунда,", "en": "He remained in the Creator’s hand alone,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 9, "raw": "Теңирдин темир торунда,", "text": "Теңирдин темир торунда,", "en": "Within God’s iron net,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 10, "raw": "Тек ажалдын колунда,", "text": "Тек ажалдын колунда,", "en": "Solely in the hand of death.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 11, "raw": "Кайда кылып кайрылып,", "text": "Кайда кылып кайрылып,", "en": "Turning wherever he could,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 12, "raw": "Эбегей көгөй эр Кенен,", "text": "Эбегей көгөй эр Кенен,", "en": "Vast-hearted hero Kenen,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l013", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 13, "raw": "Эл-журттан чогу айрылып,", "text": "Эл-журттан чогу айрылып,", "en": "Separated together from his people,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 14, "raw": "Көп дүйнөнү тартып,", "text": "Көп дүйнөнү тартып,", "en": "Endured much of this world.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 15, "raw": "Бейли кара, коону заар,", "text": "Бейли кара, коону заар,", "en": "His intent was dark and his heart poisonous.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 16, "raw": "Чын душманга бастырып,", "text": "Чын душманга бастырып,", "en": "He was trampled by the true enemy.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 17, "raw": "Казатка кирген көк жалдар,", "text": "Казатка кирген көк жалдар,", "en": "The gray-maned heroes entered the holy war.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 18, "raw": "Алып Куман, жан шер,", "text": "Алып Куман, жан шер,", "en": "Brave Kuman, companion of the soul,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 19, "raw": "Айбы сүйлөп бек талдап,", "text": "Айбы сүйлөп бек талдап,", "en": "Spoke his challenge and judged it firmly.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 20, "raw": "Жетимек, жел жетпес,", "text": "Жетимек, жел жетпес,", "en": "The orphan was beyond the wind’s reach.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 21, "raw": "Атыңа дыйкан жан өтпөс,", "text": "Атыңа дыйкан жан өтпөс,", "en": "No farming soul could pass your horse.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 22, "raw": "Көзү караган алыстан,", "text": "Көзү караган алыстан,", "en": "His eye gazed from afar.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 23, "raw": "Далай чыккан жел жетпес,", "text": "Далай чыккан жел жетпес,", "en": "Many rode out beyond the wind’s reach.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l024", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 24, "raw": "Көз жетпеген жыргаштан,", "text": "Көз жетпеген жыргаштан,", "en": "From delight beyond the eye’s reach,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 25, "raw": "Көк жалдардан найза алган,", "text": "Көк жалдардан найза алган,", "en": "He took a spear from the gray-maned heroes.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 26, "raw": "Кыны жок кылып байланган,", "text": "Кыны жок кылып байланган,", "en": "He was bound with no sheath remaining.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 27, "raw": "Артың бийик жан болгон,", "text": "Артың бийик жан болгон,", "en": "Behind you stood a lofty soul.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 28, "raw": "Тайгалдар баркы келген,", "text": "Тайгалдар баркы келген,", "en": "The worth of the slippery ones arrived.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 29, "raw": "Үч журтка хан болгон,", "text": "Үч журтка хан болгон,", "en": "He became khan over three peoples.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 30, "raw": "Дүйнөк-дүйнөк сөз айтса,", "text": "Дүйнөк-дүйнөк сөз айтса,", "en": "When he spoke world upon world of words,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 31, "raw": "Тыйын тегер, жел жетпес,", "text": "Тыйын тегер, жел жетпес,", "en": "A coin spun, beyond the wind’s reach.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 32, "raw": "Тур баскан өрнө,", "text": "Тур баскан өрнө,", "en": "The pattern stood upright.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 33, "raw": "Көп ташкан жел жетпес,", "text": "Көп ташкан жел жетпес,", "en": "What cast many stones outran the wind.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf215:l034", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 215, "folio": 598, "line_in_page": 34, "raw": "Алыс жанды болгон.", "text": "Алыс жанды болгон.", "en": "His soul belonged to the distant land.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
