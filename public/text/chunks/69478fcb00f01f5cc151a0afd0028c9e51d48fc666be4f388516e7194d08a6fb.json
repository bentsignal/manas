"},{"id":"seytek-2012:p0309:b002:l004","ordinal":319207,"en":"Ripe, burning and sad,"},{"id":"seytek-2012:p0309:b002:l005","ordinal":319208,"en":"Cook with fire"},{"id":"seytek-2012:p0309:b002:l006","ordinal":319209,"en":"We were completely lost,"},{"id":"seytek-2012:p0309:b002:l007","ordinal":319210,"en":"Losing the tail"},{"id":"seytek-2012:p0309:b002:l008","ordinal":319211,"en":"We are poor people."},{"id":"seytek-2012:p0309:b002:l009","ordinal":319212,"en":"Losing his head"},{"id":"seytek-2012:p0309:b002:l010","ordinal":319213,"en":"We're poor bastards."},{"id":"seytek-2012:p0309:b002:l011","ordinal":319214,"en":"If the blood screams in anger,"},{"id":"seytek-2012:p0309:b002:l012","ordinal":319215,"en":"We are poor people who are on the road,"},{"id":"seytek-2012:p0309:b002:l013","ordinal":319216,"en":"We can't jump out if we dare."},{"id":"seytek-2012:p0309:b002:l014","ordinal":319217,"en":"We are poor people who have fallen into the shelter."},{"id":"seytek-2012:p0309:b002:l015","ordinal":319218,"en":"Lost in the eyes,"},{"id":"seytek-2012:p0309:b002:l016","ordinal":319219,"en":"I can't find a sad cry"},{"id":"seytek-2012:p0309:b002:l017","ordinal":319220,"en":"We are poor people who have been caught."},{"id":"seytek-2012:p0309:b002:l018","ordinal":319221,"en":"Sobbing and crying"},{"id":"seytek-2012:p0309:b002:l019","ordinal":319222,"en":"We can't find a way."},{"id":"seytek-2012:p0309:b002:l020","ordinal":319223,"en":"From the hands of a fierce enemy,"},{"id":"seytek-2012:p0309:b002:l021","ordinal":319224,"en":"There are no children to divorce."},{"id":"seytek-2012:p0309:b002:l022","ordinal":319225,"en":"How do we do it?"},{"id":"seytek-2012:p0309:b002:l023","ordinal":319226,"en":"We have become ashes that have not yet been destroyed."},{"id":"seytek-2012:p0309:b002:l024","ordinal":319227,"en":"We became wool before silk,"},{"id":"seytek-2012:p0309:b002:l025","ordinal":319228,"en":"We were maids before the queen,"},{"id":"seytek-2012:p0309:b002:l026","ordinal":319229,"en":"We cried and cried,"},{"id":"seytek-2012:p0309:b002:l027","ordinal":319230,"en":"We lost the Kairans."},{"id":"seytek-2012:p0309:b002:l028","ordinal":319231,"en":"It was night before day,"},{"id":"seytek-2012:p0309:b002:l029","ordinal":319232,"en":"When Kanchoro gets angry,"}]
