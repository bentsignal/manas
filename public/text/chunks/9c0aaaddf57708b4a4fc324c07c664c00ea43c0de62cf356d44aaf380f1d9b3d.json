[{"id":"semetey-1-2013:p0285:b003:l012","ordinal":98561,"en":"And exchanged shots for forty-eight days."},{"id":"semetey-1-2013:p0285:b003:l013","ordinal":98562,"en":"When their strength failed,"},{"id":"semetey-1-2013:p0285:b003:l014","ordinal":98563,"en":"When the moment came that they might be taken,"},{"id":"semetey-1-2013:p0285:b003:l015","ordinal":98564,"en":"They fled this way from Zhyldyz,"},{"id":"semetey-1-2013:p0285:b003:l016","ordinal":98565,"en":"Fighting like dogs,"},{"id":"semetey-1-2013:p0285:b003:l017","ordinal":98566,"en":"Their strength failing."},{"id":"semetey-1-2013:p0285:b003:l018","ordinal":98567,"en":"Oguz-Ashuu and Tai-Ashuu,"},{"id":"semetey-1-2013:p0285:b003:l019","ordinal":98568,"en":"They crossed both passes together."},{"id":"semetey-1-2013:p0285:b003:l020","ordinal":98569,"en":"Kunos, Tekes, Uch-Aral—"},{"id":"semetey-1-2013:p0285:b003:l021","ordinal":98570,"en":"They hurried away in flight."},{"id":"semetey-1-2013:p0285:b003:l022","ordinal":98571,"en":"They lay on opposite sides,"},{"id":"semetey-1-2013:p0285:b003:l023","ordinal":98572,"en":"Unable to reach with spears,"},{"id":"semetey-1-2013:p0285:b003:l024","ordinal":98573,"en":"And shot at one another with bows."},{"id":"semetey-1-2013:p0285:b003:l025","ordinal":98574,"en":"(Kongurbay was skilled,"},{"id":"semetey-1-2013:p0285:b003:l026","ordinal":98575,"en":"That swine who knew the tricks of war!)"},{"id":"semetey-1-2013:p0285:b003:l027","ordinal":98576,"en":"When the two luckless maidens suffered,"},{"id":"semetey-1-2013:p0285:b003:l028","ordinal":98577,"en":"Kardygach’s Telkyzyl—"},{"id":"semetey-1-2013:p0285:b003:l029","ordinal":98578,"en":"Alooke’s Kongurbay,"},{"id":"semetey-1-2013:p0285:b003:l030","ordinal":98579,"en":"The skilled, mighty Kalcha,"},{"id":"semetey-1-2013:p0285:b003:l031","ordinal":98580,"en":"When he fired from the opposite side,"},{"id":"semetey-1-2013:p0285:b003:l032","ordinal":98581,"en":"The two maidens were at their wits’ end."},{"id":"semetey-1-2013:p0285:b003:l033","ordinal":98582,"en":"The shot struck across the breast;"},{"id":"semetey-1-2013:p0285:b003:l034","ordinal":98583,"en":"Telkyzyl lay dying."},{"id":"semetey-1-2013:p0285:b003:l035","ordinal":98584,"en":"When Kardygach’s certain death"},{"id":"semetey-1-2013:p0285:b003:l036","ordinal":98585,"en":"Was about to arrive,"},{"id":"semetey-1-2013:p0285:b003:l037","ordinal":98586,"en":"When at the hands of the Chinese"},{"id":"semetey-1-2013:p0285:b003:l038","ordinal":98587,"en":"She was about to perish,"},{"id":"semetey-1-2013:p0285:b003:l039","ordinal":98588,"en":"Khan Saikal, daughter of Karacha,"},{"id":"semetey-1-2013:p0285:b004:l001","ordinal":98589,"en":"Was one of the mighty warriors."},{"id":"semetey-1-2013:p0285:b004:l002","ordinal":98590,"en":"Upon Kardygach’s back"},{"id":"semetey-1-2013:p0285:b004:l003","ordinal":98591,"en":"She put a coat no shot could pierce."},{"id":"semetey-1-2013:p0285:b004:l004","ordinal":98592,"en":"For Kardygach,"},{"id":"semetey-1-2013:p0285:b004:l005","ordinal":98593,"en":"From Kaip’s daughter Kuyaly,"},{"id":"semetey-1-2013:p0285:b004:l006","ordinal":98594,"en":"Surkyzyl, freely bestowed—"},{"id":"semetey-1-2013:p0285:b004:l007","ordinal":98595,"en":"She seated her upon Surkyzyl."},{"id":"semetey-1-2013:p0285:b004:l008","ordinal":98596,"en":"A star was eclipsed in the sky;"},{"id":"semetey-1-2013:p0285:b004:l009","ordinal":98597,"en":"In plain sight they fled,"},{"id":"semetey-1-2013:p0285:b004:l010","ordinal":98598,"en":"And escaped in this way."},{"id":"semetey-1-2013:p0285:b004:l011","ordinal":98599,"en":"Fighting with spears by turns,"},{"id":"semetey-1-2013:p0285:b004:l012","ordinal":98600,"en":"They remained among the living."},{"id":"semetey-1-2013:p0285:b004:l013","ordinal":98601,"en":"They traveled upward out of the fire,"},{"id":"semetey-1-2013:p0285:b004:l014","ordinal":98602,"en":"Traveled far without sparing themselves."},{"id":"semetey-1-2013:p0285:b004:l015","ordinal":98603,"en":"Kalcha had hemmed them into a narrow place;"},{"id":"semetey-1-2013:p0285:b004:l016","ordinal":98604,"en":"Thus the two maidens were worn out."},{"id":"semetey-1-2013:p0285:b004:l017","ordinal":98605,"en":"The two poor maidens, conserving their strength,"},{"id":"semetey-1-2013:p0285:b004:l018","ordinal":98606,"en":"Toward a pass that stood there"},{"id":"semetey-1-2013:p0285:b004:l019","ordinal":98607,"en":"Made their way for shelter."},{"id":"semetey-1-2013:p0285:b004:l020","ordinal":98608,"en":"Loading their baggage on the piebald stallion,"},{"id":"semetey-1-2013:p0285:b004:l021","ordinal":98609,"en":"Enduring terrible hardship,"},{"id":"semetey-1-2013:p0285:b004:l022","ordinal":98610,"en":"They traveled by night, never by day."},{"id":"semetey-1-2013:p0285:b004:l023","ordinal":98611,"en":"There is writing on the black stone;"},{"id":"semetey-1-2013:p0285:b004:l024","ordinal":98612,"en":"From that day to this,"},{"id":"semetey-1-2013:p0285:b004:l025","ordinal":98613,"en":"It bears the names Ala-Aigyr and Saikal."},{"id":"semetey-1-2013:p0285:b004:l026","ordinal":98614,"en":"The Chinese are a costly foe to us;"},{"id":"semetey-1-2013:p0285:b004:l027","ordinal":98615,"en":"Such trouble do they bring."},{"id":"semetey-1-2013:p0285:b004:l028","ordinal":98616,"en":"Just as they were about to seize them,"},{"id":"semetey-1-2013:p0285:b004:l029","ordinal":98617,"en":"To bring torment upon their heads,"},{"id":"semetey-1-2013:p0285:b004:l030","ordinal":98618,"en":"The black Kalmyks and the Manchu people,"},{"id":"semetey-1-2013:p0285:b004:l031","ordinal":98619,"en":"Just as they were about to take them as wives,"},{"id":"semetey-1-2013:p0285:b004:l032","ordinal":98620,"en":"With golden forelock and tasseled belt,"},{"id":"semetey-1-2013:p0285:b004:l033","ordinal":98621,"en":"Almambet, son of Khan Azyz,"},{"id":"semetey-1-2013:p0285:b004:l034","ordinal":98622,"en":"The saintly hero Bakai,"},{"id":"semetey-1-2013:p0285:b004:l035","ordinal":98623,"en":"Azhybai, son of the Argyn khan,"},{"id":"semetey-1-2013:p0285:b004:l036","ordinal":98624,"en":"The finest of the sixty,"},{"id":"semetey-1-2013:p0285:b004:l037","ordinal":98625,"en":"The formidable one of the forty companions,"},{"id":"semetey-1-2013:p0285:b004:l038","ordinal":98626,"en":"Syrgak, son of Khan Ulak,"},{"id":"semetey-1-2013:p0285:b004:l039","ordinal":98627,"en":"Traveled along the lower road,"},{"id":"semetey-1-2013:p0286:b003:l001","ordinal":98628,"en":"They traveled far, sparing no horses,"},{"id":"semetey-1-2013:p0286:b003:l002","ordinal":98629,"en":"Past cleft, enormous crags,"},{"id":"semetey-1-2013:p0286:b003:l003","ordinal":98630,"en":"Past strange, dark mountains."},{"id":"semetey-1-2013:p0286:b003:l004","ordinal":98631,"en":"Bakai followed along their foothills;"},{"id":"semetey-1-2013:p0286:b003:l005","ordinal":98632,"en":"Almambet did not travel by day,"},{"id":"semetey-1-2013:p0286:b003:l006","ordinal":98633,"en":"But made his way through the night."},{"id":"semetey-1-2013:p0286:b003:l007","ordinal":98634,"en":"To see the maiden on watch,"},{"id":"semetey-1-2013:p0286:b003:l008","ordinal":98635,"en":"The grievous plight of Kakan’s people,"},{"id":"semetey-1-2013:p0286:b003:l009","ordinal":98636,"en":"To bring back news of it,"},{"id":"semetey-1-2013:p0286:b003:l010","ordinal":98637,"en":"Across moonlike Sary-Talaa,"},{"id":"semetey-1-2013:p0286:b003:l011","ordinal":98638,"en":"When they crossed and descended,"},{"id":"semetey-1-2013:p0286:b003:l012","ordinal":98639,"en":"With their teeth jutting out,"},{"id":"semetey-1-2013:p0286:b003:l013","ordinal":98640,"en":"Dead horses lay everywhere."},{"id":"semetey-1-2013:p0286:b003:l014","ordinal":98641,"en":"With their mustaches bristling,"},{"id":"semetey-1-2013:p0286:b003:l015","ordinal":98642,"en":"Dead warriors lay in one place."},{"id":"semetey-1-2013:p0286:b003:l016","ordinal":98643,"en":"When the clear dawn broke,"},{"id":"semetey-1-2013:p0286:b003:l017","ordinal":98644,"en":"When light fell upon the earth,"},{"id":"semetey-1-2013:p0286:b003:l018","ordinal":98645,"en":"When stars departed from the sky,"},{"id":"semetey-1-2013:p0286:b003:l019","ordinal":98646,"en":"And light appeared upon the earth,"},{"id":"semetey-1-2013:p0286:b003:l020","ordinal":98647,"en":"When leopard-like Bakai looked,"},{"id":"semetey-1-2013:p0286:b003:l021","ordinal":98648,"en":"The crust of the black earth"},{"id":"semetey-1-2013:p0286:b003:l022","ordinal":98649,"en":"Had been worn away toward the west."},{"id":"semetey-1-2013:p0286:b003:l023","ordinal":98650,"en":"The tracks the coursers had left"},{"id":"semetey-1-2013:p0286:b003:l024","ordinal":98651,"en":"Were hollowed like hearth pits."},{"id":"semetey-1-2013:p0286:b003:l025","ordinal":98652,"en":"An army had gone toward the west,"},{"id":"semetey-1-2013:p0286:b003:l026","ordinal":98653,"en":"Had gone far, wearing out its horses."},{"id":"semetey-1-2013:p0286:b003:l027","ordinal":98654,"en":"Then your elder Bakai,"},{"id":"semetey-1-2013:p0286:b003:l028","ordinal":98655,"en":"My saintly one, stood thinking:"},{"id":"semetey-1-2013:p0286:b003:l029","ordinal":98656,"en":"“A mighty army has come from Kakan,"},{"id":"semetey-1-2013:p0286:b003:l030","ordinal":98657,"en":"Has come in great numbers against our lives."},{"id":"semetey-1-2013:p0286:b003:l031","ordinal":98658,"en":"It seems they have overrun the mountains,"},{"id":"semetey-1-2013:p0286:b003:l032","ordinal":98659,"en":"Fighting along the mountaintops."},{"id":"semetey-1-2013:p0286:b003:l033","ordinal":98660,"en":"The two maidens who went on watch—"},{"id":"semetey-1-2013:p0286:b003:l034","ordinal":98661,"en":"Black night has fallen upon their heads."},{"id":"semetey-1-2013:p0286:b003:l035","ordinal":98662,"en":"Meaning to capture both,"},{"id":"semetey-1-2013:p0286:b003:l036","ordinal":98663,"en":"They seem to have closely hemmed them in;"},{"id":"semetey-1-2013:p0286:b003:l037","ordinal":98664,"en":"They seem to have overwhelmed us,"},{"id":"semetey-1-2013:p0286:b003:l038","ordinal":98665,"en":"Scattered all four kinds of livestock!"},{"id":"semetey-1-2013:p0286:b003:l039","ordinal":98666,"en":"Hot upon their trail,"},{"id":"semetey-1-2013:p0286:b004:l001","ordinal":98667,"en":"Oh, Almambet, my master of hidden arts,"},{"id":"semetey-1-2013:p0286:b004:l002","ordinal":98668,"en":"Let us pursue them relentlessly."},{"id":"semetey-1-2013:p0286:b004:l003","ordinal":98669,"en":"Upon the countless Chinese,"},{"id":"semetey-1-2013:p0286:b004:l004","ordinal":98670,"en":"Let us bring slaughter in a narrow place."},{"id":"semetey-1-2013:p0286:b004:l005","ordinal":98671,"en":"The two maidens who went on watch—"},{"id":"semetey-1-2013:p0286:b004:l006","ordinal":98672,"en":"Bringing slaughter in the narrow place,"},{"id":"semetey-1-2013:p0286:b004:l007","ordinal":98673,"en":"Let us rescue them.”"},{"id":"semetey-1-2013:p0286:b004:l008","ordinal":98674,"en":"Having spoken these words,"},{"id":"semetey-1-2013:p0286:b004:l009","ordinal":98675,"en":"Prince Bakai, the leopard,"},{"id":"semetey-1-2013:p0286:b004:l010","ordinal":98676,"en":"And Almambet, son of Khan Azyz,"},{"id":"semetey-1-2013:p0286:b004:l011","ordinal":98677,"en":"Grappled with the Chinese,"},{"id":"semetey-1-2013:p0286:b004:l012","ordinal":98678,"en":"My saintly master of skill."},{"id":"semetey-1-2013:p0286:b004:l013","ordinal":98679,"en":"Wind-driven drizzle turning into snow—"},{"id":"semetey-1-2013:p0286:b004:l014","ordinal":98680,"en":"Your Almambet worked his weather magic."},{"id":"semetey-1-2013:p0286:b004:l015","ordinal":98681,"en":"Gray haze, low-lying fog,"},{"id":"semetey-1-2013:p0286:b004:l016","ordinal":98682,"en":"Cloudy by day, clear by night,"},{"id":"semetey-1-2013:p0286:b004:l017","ordinal":98683,"en":"The weather’s temper was upset."},{"id":"semetey-1-2013:p0286:b004:l018","ordinal":98684,"en":"Fleeing across to the far side,"},{"id":"semetey-1-2013:p0286:b004:l019","ordinal":98685,"en":"Alooke’s Kongurbay,"},{"id":"semetey-1-2013:p0286:b004:l020","ordinal":98686,"en":"Sixty Chinese, countless governors—"},{"id":"semetey-1-2013:p0286:b004:l021","ordinal":98687,"en":"When these men pursued them,"},{"id":"semetey-1-2013:p0286:b004:l022","ordinal":98688,"en":"He fled across and escaped."},{"id":"semetey-1-2013:p0286:b004:l023","ordinal":98689,"en":"Sixty Chinese and a great governor"},{"id":"semetey-1-2013:p0286:b004:l024","ordinal":98690,"en":"Were captured there."},{"id":"semetey-1-2013:p0286:b004:l025","ordinal":98691,"en":"A thousand wrestlers, led by the governor,"},{"id":"semetey-1-2013:p0286:b004:l026","ordinal":98692,"en":"Bakai took prisoner."},{"id":"semetey-1-2013:p0286:b004:l027","ordinal":98693,"en":"Leaving not one alive,"},{"id":"semetey-1-2013:p0286:b004:l028","ordinal":98694,"en":"Almambet, son of Khan Azyz,"},{"id":"semetey-1-2013:p0286:b004:l029","ordinal":98695,"en":"Your hero born surpassing others,"},{"id":"semetey-1-2013:p0286:b004:l030","ordinal":98696,"en":"Offered them up as sacrifices."},{"id":"semetey-1-2013:p0286:b004:l031","ordinal":98697,"en":"The two distraught maidens,"},{"id":"semetey-1-2013:p0286:b004:l032","ordinal":98698,"en":"The mighty ones on watch,"},{"id":"semetey-1-2013:p0286:b004:l033","ordinal":98699,"en":"These men rescued them."},{"id":"semetey-1-2013:p0286:b004:l034","ordinal":98700,"en":"Khan Saikal, daughter of Karacha,"},{"id":"semetey-1-2013:p0286:b004:l035","ordinal":98701,"en":"They returned to her father."},{"id":"semetey-1-2013:p0286:b004:l036","ordinal":98702,"en":"Manas’s sister Kardygach,"},{"id":"semetey-1-2013:p0286:b004:l037","ordinal":98703,"en":"At the world’s end, Zhelpinish,"},{"id":"semetey-1-2013:p0286:b004:l038","ordinal":98704,"en":"To Zharmanas of the ill-famed people,"},{"id":"semetey-1-2013:p0286:b004:l039","ordinal":98705,"en":"To Zharmanas they gave her."},{"id":"semetey-1-2013:p0287:b003:l001","ordinal":98706,"en":"“She bore one son, a lion champion;"},{"id":"semetey-1-2013:p0287:b003:l002","ordinal":98707,"en":"My mother who lies here"},{"id":"semetey-1-2013:p0287:b003:l003","ordinal":98708,"en":"Bore one daughter, a warrior.”"},{"id":"semetey-1-2013:p0287:b003:l004","ordinal":98709,"en":"Having spoken these words,"},{"id":"semetey-1-2013:p0287:b003:l005","ordinal":98710,"en":"Telling of the lion champion who had passed away,"},{"id":"semetey-1-2013:p0287:b003:l007","ordinal":98711,"en":"Calling her own son little brother,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0287:b003:l008","ordinal":98712,"en":"“Whom have I but you?” she said."},{"id":"semetey-1-2013:p0287:b003:l009","ordinal":98713,"en":"“For a widow like me,"},{"id":"semetey-1-2013:p0287:b003:l010","ordinal":98714,"en":"Apart from you, little brother,"},{"id":"semetey-1-2013:p0287:b003:l011","ordinal":98715,"en":"Who is there to look after me?” she said."},{"id":"semetey-1-2013:p0287:b003:l012","ordinal":98716,"en":"Kanykei turned and walked."},{"id":"semetey-1-2013:p0287:b003:l013","ordinal":98717,"en":"On this side of the lattice wall,"},{"id":"semetey-1-2013:p0287:b003:l014","ordinal":98718,"en":"On the far side of the curtain,"},{"id":"semetey-1-2013:p0287:b003:l015","ordinal":98719,"en":"Upon the bed,"},{"id":"semetey-1-2013:p0287:b003:l016","ordinal":98720,"en":"The old woman lay hunched,"},{"id":"semetey-1-2013:p0287:b003:l017","ordinal":98721,"en":"The saintly one upheld by her patron,"},{"id":"semetey-1-2013:p0287:b003:l018","ordinal":98722,"en":"The venerable old Chyiyrdy,"},{"id":"semetey-1-2013:p0287:b003:l019","ordinal":98723,"en":"The elder who had borne Manas."},{"id":"semetey-1-2013:p0287:b003:l020","ordinal":98724,"en":"God had granted her wish;"},{"id":"semetey-1-2013:p0287:b003:l021","ordinal":98725,"en":"She had reached ninety-five."},{"id":"semetey-1-2013:p0287:b003:l022","ordinal":98726,"en":"Bent over like a quail,"},{"id":"semetey-1-2013:p0287:b003:l023","ordinal":98727,"en":"She had huddled into herself."},{"id":"semetey-1-2013:p0287:b003:l024","ordinal":98728,"en":"When her royal son had died,"},{"id":"semetey-1-2013:p0287:b003:l025","ordinal":98729,"en":"“My king!” she had wept and wept."},{"id":"semetey-1-2013:p0287:b003:l026","ordinal":98730,"en":"With no strength to rise,"},{"id":"semetey-1-2013:p0287:b003:l027","ordinal":98731,"en":"The old woman had sunk down."},{"id":"semetey-1-2013:p0287:b003:l028","ordinal":98732,"en":"Her eyes had filled with pus;"},{"id":"semetey-1-2013:p0287:b003:l029","ordinal":98733,"en":"Her chest had begun to rattle."},{"id":"semetey-1-2013:p0287:b003:l030","ordinal":98734,"en":"All twelve bones of her frame"},{"id":"semetey-1-2013:p0287:b003:l031","ordinal":98735,"en":"Trembled without cease."},{"id":"semetey-1-2013:p0287:b003:l032","ordinal":98736,"en":"Call her dead—she was not in the grave;"},{"id":"semetey-1-2013:p0287:b003:l033","ordinal":98737,"en":"Call her alive—she was not among their number."},{"id":"semetey-1-2013:p0287:b003:l034","ordinal":98738,"en":"Seen today, gone tomorrow:"},{"id":"semetey-1-2013:p0287:b003:l035","ordinal":98739,"en":"Such is this world of shit."},{"id":"semetey-1-2013:p0287:b003:l036","ordinal":98740,"en":"The elder was ninety-five,"},{"id":"semetey-1-2013:p0287:b003:l037","ordinal":98741,"en":"Without the strength to stand."},{"id":"semetey-1-2013:p0287:b003:l038","ordinal":98742,"en":"Your dear mother Kanykei,"},{"id":"semetey-1-2013:p0287:b003:l039","ordinal":98743,"en":"The old woman lying there in sorrow,"},{"id":"semetey-1-2013:p0287:b004:l001","ordinal":98744,"en":"Took her firmly by the forearm."},{"id":"semetey-1-2013:p0287:b004:l002","ordinal":98745,"en":"That same dear mother Kanykei"},{"id":"semetey-1-2013:p0287:b004:l003","ordinal":98746,"en":"Spoke to her loudly:"},{"id":"semetey-1-2013:p0287:b004:l004","ordinal":98747,"en":"“Venerable old woman, my sacred mother,"},{"id":"semetey-1-2013:p0287:b004:l005","ordinal":98748,"en":"My darling mother!"},{"id":"semetey-1-2013:p0287:b004:l006","ordinal":98749,"en":"Seeing you, my heart is deeply content;"},{"id":"semetey-1-2013:p0287:b004:l007","ordinal":98750,"en":"Mother, I have no sacred refuge but you."},{"id":"semetey-1-2013:p0287:b004:l008","ordinal":98751,"en":"God has granted your wish;"},{"id":"semetey-1-2013:p0287:b004:l009","ordinal":98752,"en":"Lift your head and rise, Mother:"},{"id":"semetey-1-2013:p0287:b004:l010","ordinal":98753,"en":"Your young in-law has come."},{"id":"semetey-1-2013:p0287:b004:l011","ordinal":98754,"en":"Rise and greet him, Mother!"},{"id":"semetey-1-2013:p0287:b004:l012","ordinal":98755,"en":"Your lamenting split the stones;"},{"id":"semetey-1-2013:p0287:b004:l013","ordinal":98756,"en":"My darling mother,"},{"id":"semetey-1-2013:p0287:b004:l014","ordinal":98757,"en":"You were like a crying snowcock."},{"id":"semetey-1-2013:p0287:b004:l015","ordinal":98758,"en":"‘If only I could see that in-law,’ you said;"},{"id":"semetey-1-2013:p0287:b004:l016","ordinal":98759,"en":"Mother, you had longed for him.”"},{"id":"semetey-1-2013:p0287:b004:l017","ordinal":98760,"en":"Then Chyiyrdy,"},{"id":"semetey-1-2013:p0287:b004:l018","ordinal":98761,"en":"When she heard this news,"},{"id":"semetey-1-2013:p0287:b004:l019","ordinal":98762,"en":"Coughing in deep, repeated bursts,"},{"id":"semetey-1-2013:p0287:b004:l020","ordinal":98763,"en":"Raised her head from the bed."},{"id":"semetey-1-2013:p0287:b004:l021","ordinal":98764,"en":"Coughing in sharp, repeated bursts,"},{"id":"semetey-1-2013:p0287:b004:l022","ordinal":98765,"en":"Raised her head from the pillow."},{"id":"semetey-1-2013:p0287:b004:l023","ordinal":98766,"en":"Taking a golden staff in her hand,"},{"id":"semetey-1-2013:p0287:b004:l024","ordinal":98767,"en":"She barely managed to straighten up,"},{"id":"semetey-1-2013:p0287:b004:l025","ordinal":98768,"en":"Turning toward her only one, Semetey."},{"id":"semetey-1-2013:p0287:b004:l026","ordinal":98769,"en":"Her dry eyes, so full of dignity,"},{"id":"semetey-1-2013:p0287:b004:l027","ordinal":98770,"en":"Your mother turned and wiped."},{"id":"semetey-1-2013:p0287:b004:l028","ordinal":98771,"en":"For the time it takes meat to cook,"},{"id":"semetey-1-2013:p0287:b004:l029","ordinal":98772,"en":"She gazed at the boy without tiring."},{"id":"semetey-1-2013:p0287:b004:l030","ordinal":98773,"en":"Watching the boy, full of longing,"},{"id":"semetey-1-2013:p0287:b004:l031","ordinal":98774,"en":"Chyiyrdy began,"},{"id":"semetey-1-2013:p0287:b004:l032","ordinal":98775,"en":"Pleading then with Kanykei:"},{"id":"semetey-1-2013:p0287:b004:l033","ordinal":98776,"en":"“Oh, Kanykei, my foal,"},{"id":"semetey-1-2013:p0287:b004:l034","ordinal":98777,"en":"Who would not tire if ridden for six months,"},{"id":"semetey-1-2013:p0287:b004:l035","ordinal":98778,"en":"Even upon reaching sixty mature years,"},{"id":"semetey-1-2013:p0287:b004:l036","ordinal":98779,"en":"Would not wear down her teeth and grow old—"},{"id":"semetey-1-2013:p0287:b004:l037","ordinal":98780,"en":"Oh, Kanykei, my foal,"},{"id":"semetey-1-2013:p0287:b004:l038","ordinal":98781,"en":"My tireless black steed with the white blaze,"},{"id":"semetey-1-2013:p0287:b004:l039","ordinal":98782,"en":"Let me speak what lies within my belly,"},{"id":"semetey-1-2013:p0288:b003:l001","ordinal":98783,"en":"My darling foal!"},{"id":"semetey-1-2013:p0288:b003:l002","ordinal":98784,"en":"When my foal Manas died,"},{"id":"semetey-1-2013:p0288:b003:l003","ordinal":98785,"en":"When my wretched head suffered plunder,"},{"id":"semetey-1-2013:p0288:b003:l004","ordinal":98786,"en":"When I ran like a hunting hound,"},{"id":"semetey-1-2013:p0288:b003:l005","ordinal":98787,"en":"Suffering hardship, my afflicted head,"},{"id":"semetey-1-2013:p0288:b003:l006","ordinal":98788,"en":"When I came wandering from Talas,"},{"id":"semetey-1-2013:p0288:b003:l007","ordinal":98789,"en":"God drove me under escort,"},{"id":"semetey-1-2013:p0288:b003:l008","ordinal":98790,"en":"I came to Bukhara and settled,"},{"id":"semetey-1-2013:p0288:b003:l009","ordinal":98791,"en":"Wearing a loose, flapping felt cloak,"},{"id":"semetey-1-2013:p0288:b003:l010","ordinal":98792,"en":"Riding a bay mare, swaying along,"},{"id":"semetey-1-2013:p0288:b003:l011","ordinal":98793,"en":"Finding even yearling sheep's fat frozen,"},{"id":"semetey-1-2013:p0288:b003:l012","ordinal":98794,"en":"Suffering such great torment,"},{"id":"semetey-1-2013:p0288:b003:l013","ordinal":98795,"en":"To Temir Khan's city"},{"id":"semetey-1-2013:p0288:b003:l014","ordinal":98796,"en":"I came wandering to make my living."},{"id":"semetey-1-2013:p0288:b003:l015","ordinal":98797,"en":"When I settled as a wanderer in Bukhara,"},{"id":"semetey-1-2013:p0288:b003:l016","ordinal":98798,"en":"Having them call me a wandering woman,"},{"id":"semetey-1-2013:p0288:b003:l017","ordinal":98799,"en":"My child, when I gained an ill name,"},{"id":"semetey-1-2013:p0288:b003:l018","ordinal":98800,"en":"Born when we arrived,"},{"id":"semetey-1-2013:p0288:b003:l019","ordinal":98801,"en":"Countless people gave him a name,"},{"id":"semetey-1-2013:p0288:b003:l020","ordinal":98802,"en":"Held a great feast and slaughtered mares."},{"id":"semetey-1-2013:p0288:b003:l021","ordinal":98803,"en":"A levy was raised in Bukhara,"},{"id":"semetey-1-2013:p0288:b003:l022","ordinal":98804,"en":"Countless fifth-year she-camels slaughtered."},{"id":"semetey-1-2013:p0288:b003:l023","ordinal":98805,"en":"The people gathered, and his own name"},{"id":"semetey-1-2013:p0288:b003:l024","ordinal":98806,"en":"Was given as the warrior Semetey."},{"id":"semetey-1-2013:p0288:b003:l025","ordinal":98807,"en":"Afghans ate at his feast and departed,"},{"id":"semetey-1-2013:p0288:b003:l026","ordinal":98808,"en":"'If this child lives unharmed,"},{"id":"semetey-1-2013:p0288:b003:l027","ordinal":98809,"en":"He will shatter the Oirats,' they said and left."},{"id":"semetey-1-2013:p0288:b003:l028","ordinal":98810,"en":"Kyrgyz ate at his feast and departed,"},{"id":"semetey-1-2013:p0288:b003:l029","ordinal":98811,"en":"'If this child lives unharmed,"},{"id":"semetey-1-2013:p0288:b003:l030","ordinal":98812,"en":"He will be worth the whole world,' they said and left."},{"id":"semetey-1-2013:p0288:b003:l031","ordinal":98813,"en":"Is he the bird upon your hand,"},{"id":"semetey-1-2013:p0288:b003:l032","ordinal":98814,"en":"Who lately became the new khan in Bukhara?"},{"id":"semetey-1-2013:p0288:b003:l033","ordinal":98815,"en":"My dear Kanykei,"},{"id":"semetey-1-2013:p0288:b003:l034","ordinal":98816,"en":"Is this your little brother?"}]
