[{"id":"semetey-1-2013:p0789:b003:l027","ordinal":136705,"en":"White foam mixed with blood"},{"id":"semetey-1-2013:p0789:b003:l028","ordinal":136706,"en":"Poured upon his breast."},{"id":"semetey-1-2013:p0789:b003:l029","ordinal":136707,"en":"His tail, like strands of silk,"},{"id":"semetey-1-2013:p0789:b003:l030","ordinal":136708,"en":"Spread between his thighs,"},{"id":"semetey-1-2013:p0789:b003:l031","ordinal":136709,"en":"The dark earth his hooves struck"},{"id":"semetey-1-2013:p0789:b003:l032","ordinal":136710,"en":"Split like a hand-dug irrigation ditch."},{"id":"semetey-1-2013:p0789:b003:l033","ordinal":136711,"en":"Hoe-hoofed, broad-rumped,"},{"id":"semetey-1-2013:p0789:b003:l034","ordinal":136712,"en":"Handsome Telküröng."},{"id":"semetey-1-2013:p0789:b003:l035","ordinal":136713,"en":"What could poor Kardygach do?"},{"id":"semetey-1-2013:p0789:b003:l036","ordinal":136714,"en":"That well-seasoned wielder of the club,"},{"id":"semetey-1-2013:p0789:b003:l037","ordinal":136715,"en":"On the downward slope she made the steed"},{"id":"semetey-1-2013:p0789:b003:l038","ordinal":136716,"en":"Plant his forelegs like a roe deer."},{"id":"semetey-1-2013:p0789:b003:l039","ordinal":136717,"en":"When she urged him upward,"},{"id":"semetey-1-2013:p0789:b004:l001","ordinal":136718,"en":"His mane and tail streamed out;"},{"id":"semetey-1-2013:p0789:b004:l002","ordinal":136719,"en":"He tore up the face of the earth,"},{"id":"semetey-1-2013:p0789:b004:l003","ordinal":136720,"en":"She made him race wildly."},{"id":"semetey-1-2013:p0789:b004:l004","ordinal":136721,"en":"Hot upon his trail,"},{"id":"semetey-1-2013:p0789:b004:l005","ordinal":136722,"en":"If the forty companions pursued relentlessly,"},{"id":"semetey-1-2013:p0789:b004:l006","ordinal":136723,"en":"If they pursued the orphan,"},{"id":"semetey-1-2013:p0789:b004:l007","ordinal":136724,"en":"To intercept all forty companions"},{"id":"semetey-1-2013:p0789:b004:l008","ordinal":136725,"en":"Upon their way,"},{"id":"semetey-1-2013:p0789:b004:l009","ordinal":136726,"en":"To smash them to pieces,"},{"id":"semetey-1-2013:p0789:b004:l010","ordinal":136727,"en":"To slaughter them utterly,"},{"id":"semetey-1-2013:p0789:b004:l011","ordinal":136728,"en":"After midnight had passed,"},{"id":"semetey-1-2013:p0789:b004:l012","ordinal":136729,"en":"She sent Telküröng racing"},{"id":"semetey-1-2013:p0789:b004:l013","ordinal":136730,"en":"To Khan Bakai's Karool-Tash,"},{"id":"semetey-1-2013:p0789:b004:l014","ordinal":136731,"en":"The high rock shaped like a skullcap."},{"id":"semetey-1-2013:p0789:b004:l015","ordinal":136732,"en":"Around that rock grew"},{"id":"semetey-1-2013:p0789:b004:l016","ordinal":136733,"en":"Birches mixed with honeysuckle."},{"id":"semetey-1-2013:p0789:b004:l017","ordinal":136734,"en":"Across the twisting ridges,"},{"id":"semetey-1-2013:p0789:b004:l019","ordinal":136735,"en":"Along the winding path,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0789:b004:l020","ordinal":136736,"en":"Kardygach, who knew it of old,"},{"id":"semetey-1-2013:p0789:b004:l021","ordinal":136737,"en":"Now stood on the watch ridge."},{"id":"semetey-1-2013:p0789:b004:l022","ordinal":136738,"en":"At the four corners of the world"},{"id":"semetey-1-2013:p0789:b004:l023","ordinal":136739,"en":"She looked, turning four ways."},{"id":"semetey-1-2013:p0789:b004:l024","ordinal":136740,"en":"No dust swirled upon the road,"},{"id":"semetey-1-2013:p0789:b004:l025","ordinal":136741,"en":"Nor was there a single moving soul."},{"id":"semetey-1-2013:p0789:b004:l026","ordinal":136742,"en":"Seeing this, Kardygach"},{"id":"semetey-1-2013:p0789:b004:l027","ordinal":136743,"en":"Turned Telküröng's head"},{"id":"semetey-1-2013:p0789:b004:l028","ordinal":136744,"en":"And stood watching without a stir."},{"id":"semetey-1-2013:p0789:b004:l029","ordinal":136745,"en":"Before long,"},{"id":"semetey-1-2013:p0789:b004:l030","ordinal":136746,"en":"A star parted from the sky,"},{"id":"semetey-1-2013:p0789:b004:l031","ordinal":136747,"en":"The glow of dawn appeared."},{"id":"semetey-1-2013:p0789:b004:l032","ordinal":136748,"en":"Stars scattered overhead,"},{"id":"semetey-1-2013:p0789:b004:l033","ordinal":136749,"en":"Streaking toward the west;"},{"id":"semetey-1-2013:p0789:b004:l034","ordinal":136750,"en":"The morning star stood apart,"},{"id":"semetey-1-2013:p0789:b004:l035","ordinal":136751,"en":"The glow of dawn appeared."},{"id":"semetey-1-2013:p0789:b004:l036","ordinal":136752,"en":"The cold wind of dawn whistled,"},{"id":"semetey-1-2013:p0789:b004:l037","ordinal":136753,"en":"The birch tops rattled,"},{"id":"semetey-1-2013:p0789:b004:l038","ordinal":136754,"en":"Young larks called,"},{"id":"semetey-1-2013:p0789:b004:l039","ordinal":136755,"en":"When the dawn broke clear,"},{"id":"semetey-1-2013:p0790:b003:l001","ordinal":136756,"en":"When light fell upon the earth,"},{"id":"semetey-1-2013:p0790:b003:l002","ordinal":136757,"en":"On the northern side,"},{"id":"semetey-1-2013:p0790:b003:l003","ordinal":136758,"en":"At the edge of Kan-Jailak,"},{"id":"semetey-1-2013:p0790:b003:l004","ordinal":136759,"en":"Riding a horse like Kökcholok,"},{"id":"semetey-1-2013:p0790:b003:l005","ordinal":136760,"en":"It was my elder Bakai himself."},{"id":"semetey-1-2013:p0790:b003:l006","ordinal":136761,"en":"‘Look over this way:"},{"id":"semetey-1-2013:p0790:b003:l007","ordinal":136762,"en":"Hastening to say his prayer,"},{"id":"semetey-1-2013:p0790:b003:l008","ordinal":136763,"en":"Saddling Taibuurul,"},{"id":"semetey-1-2013:p0790:b003:l009","ordinal":136764,"en":"My orphan, whom I look to for support,"},{"id":"semetey-1-2013:p0790:b003:l010","ordinal":136765,"en":"Seems to be reaching his desire"},{"id":"semetey-1-2013:p0790:b003:l011","ordinal":136766,"en":"Safe and sound."},{"id":"semetey-1-2013:p0790:b003:l012","ordinal":136767,"en":"He seems to be turning back"},{"id":"semetey-1-2013:p0790:b003:l013","ordinal":136768,"en":"And going to Bukhara."},{"id":"semetey-1-2013:p0790:b003:l014","ordinal":136769,"en":"Small as a crow, alive before my eyes,"},{"id":"semetey-1-2013:p0790:b003:l015","ordinal":136770,"en":"My protector has appeared alive.’"},{"id":"semetey-1-2013:p0790:b003:l016","ordinal":136771,"en":"Kardygach prayed for her wish;"},{"id":"semetey-1-2013:p0790:b003:l017","ordinal":136772,"en":"The tears poured from her eyes."},{"id":"semetey-1-2013:p0790:b003:l018","ordinal":136773,"en":"Then Kardygach,"},{"id":"semetey-1-2013:p0790:b003:l019","ordinal":136774,"en":"Praying fervently,"},{"id":"semetey-1-2013:p0790:b003:l020","ordinal":136775,"en":"Turned toward Jelpinish,"},{"id":"semetey-1-2013:p0790:b003:l021","ordinal":136776,"en":"And prepared to leave."},{"id":"semetey-1-2013:p0790:b003:l022","ordinal":136777,"en":"‘My dear Semetey"},{"id":"semetey-1-2013:p0790:b003:l023","ordinal":136778,"en":"By those prowling dogs"},{"id":"semetey-1-2013:p0790:b003:l024","ordinal":136779,"en":"Is no boy to be overcome."},{"id":"semetey-1-2013:p0790:b003:l025","ordinal":136780,"en":"Khan Bakai beside him"},{"id":"semetey-1-2013:p0790:b003:l026","ordinal":136781,"en":"Is no man to miss a danger."},{"id":"semetey-1-2013:p0790:b003:l027","ordinal":136782,"en":"If I go and meet them now,"},{"id":"semetey-1-2013:p0790:b003:l028","ordinal":136783,"en":"What purpose will I achieve?"},{"id":"semetey-1-2013:p0790:b003:l029","ordinal":136784,"en":"Now I shall go toward Jelpinish.’"},{"id":"semetey-1-2013:p0790:b003:l030","ordinal":136785,"en":"She set off along the road in a rush;"},{"id":"semetey-1-2013:p0790:b003:l031","ordinal":136786,"en":"Your tiger sister urged her horse on."},{"id":"semetey-1-2013:p0790:b003:l034","ordinal":136787,"en":"At her cry she was gone,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0790:b003:l035","ordinal":136788,"en":"Kardygach vanished from sight."},{"id":"semetey-1-2013:p0790:b003:l036","ordinal":136789,"en":"The gray saddlebags taken as spoil"},{"id":"semetey-1-2013:p0790:b003:l037","ordinal":136790,"en":"They loaded upon Aktulpar,"},{"id":"semetey-1-2013:p0790:b003:l038","ordinal":136791,"en":"Turned the copper cauldron upside down,"},{"id":"semetey-1-2013:p0790:b003:l039","ordinal":136792,"en":"Fastened Akolpok behind the saddle,"},{"id":"semetey-1-2013:p0790:b004:l001","ordinal":136793,"en":"And loaded it upon Aktulpar."},{"id":"semetey-1-2013:p0790:b004:l002","ordinal":136794,"en":"To the valley of Jylgynduu,"},{"id":"semetey-1-2013:p0790:b004:l003","ordinal":136795,"en":"Along great Keng-Kol,"},{"id":"semetey-1-2013:p0790:b004:l004","ordinal":136796,"en":"The boy and Bakai went."},{"id":"semetey-1-2013:p0790:b004:l005","ordinal":136797,"en":"With leaves like leather,"},{"id":"semetey-1-2013:p0790:b004:l006","ordinal":136798,"en":"Was it not the earth's rich rump?"},{"id":"semetey-1-2013:p0790:b004:l007","ordinal":136799,"en":"This precious Keng-Kol—"},{"id":"semetey-1-2013:p0790:b004:l008","ordinal":136800,"en":"Would the Kyrgyz not flourish if they settled here?"},{"id":"semetey-1-2013:p0790:b004:l009","ordinal":136801,"en":"There was a forest at the bend."},{"id":"semetey-1-2013:p0790:b004:l010","ordinal":136802,"en":"Look at its delights:"},{"id":"semetey-1-2013:p0790:b004:l011","ordinal":136803,"en":"Nightingales and sparrows were there together."},{"id":"semetey-1-2013:p0790:b004:l012","ordinal":136804,"en":"When the nightingale sang mournfully,"},{"id":"semetey-1-2013:p0790:b004:l013","ordinal":136805,"en":"A grieving person could not bear to hear;"},{"id":"semetey-1-2013:p0790:b004:l014","ordinal":136806,"en":"He would sob and weep in a frenzy."},{"id":"semetey-1-2013:p0790:b004:l016","ordinal":136807,"en":"The orphan Semetey saw it,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0790:b004:l017","ordinal":136808,"en":"His eyes drank in the place;"},{"id":"semetey-1-2013:p0790:b004:l018","ordinal":136809,"en":"The fierce orphan rejoiced."},{"id":"semetey-1-2013:p0790:b004:l019","ordinal":136810,"en":"Just as he stood there,"},{"id":"semetey-1-2013:p0790:b004:l020","ordinal":136811,"en":"The hills came into view;"},{"id":"semetey-1-2013:p0790:b004:l021","ordinal":136812,"en":"From the back of one hill,"},{"id":"semetey-1-2013:p0790:b004:l022","ordinal":136813,"en":"Driving wild sheep, panting,"},{"id":"semetey-1-2013:p0790:b004:l023","ordinal":136814,"en":"Poor Kumaik appeared."},{"id":"semetey-1-2013:p0790:b004:l024","ordinal":136815,"en":"When Khan Manas's Kumaik"},{"id":"semetey-1-2013:p0790:b004:l025","ordinal":136816,"en":"Came toward them,"},{"id":"semetey-1-2013:p0790:b004:l026","ordinal":136817,"en":"After the dun mare had been slaughtered,"},{"id":"semetey-1-2013:p0790:b004:l027","ordinal":136818,"en":"When he had been entrusted"},{"id":"semetey-1-2013:p0790:b004:l028","ordinal":136819,"en":"To stay beside her,"},{"id":"semetey-1-2013:p0790:b004:l029","ordinal":136820,"en":"Kumaik had shown his strength."},{"id":"semetey-1-2013:p0790:b004:l030","ordinal":136821,"en":"Upon the dun mare's meat"},{"id":"semetey-1-2013:p0790:b004:l031","ordinal":136822,"en":"He had lain and eaten his fill."},{"id":"semetey-1-2013:p0790:b004:l032","ordinal":136823,"en":"It was as though brave Sultan Manas"},{"id":"semetey-1-2013:p0790:b004:l033","ordinal":136824,"en":"Were still alive."},{"id":"semetey-1-2013:p0790:b004:l034","ordinal":136825,"en":"He had grown fat and fresh,"},{"id":"semetey-1-2013:p0790:b004:l035","ordinal":136826,"en":"His strength had returned."},{"id":"semetey-1-2013:p0790:b004:l036","ordinal":136827,"en":"Before Semetey turned back,"},{"id":"semetey-1-2013:p0790:b004:l037","ordinal":136828,"en":"Before he returned from the people,"},{"id":"semetey-1-2013:p0790:b004:l038","ordinal":136829,"en":"He had pursued the wild sheep"},{"id":"semetey-1-2013:p0790:b004:l039","ordinal":136830,"en":"In the hills and torn them apart."},{"id":"semetey-1-2013:p0791:b003:l001","ordinal":136831,"en":"A spectacle to anyone who saw,"},{"id":"semetey-1-2013:p0791:b003:l002","ordinal":136832,"en":"He had performed such marvels."},{"id":"semetey-1-2013:p0791:b003:l003","ordinal":136833,"en":"The deer in the rugged country"},{"id":"semetey-1-2013:p0791:b003:l004","ordinal":136834,"en":"He drove apart and tore to pieces."},{"id":"semetey-1-2013:p0791:b003:l005","ordinal":136835,"en":"Among the wild asses in the hills"},{"id":"semetey-1-2013:p0791:b003:l006","ordinal":136836,"en":"He wrought merciless slaughter."},{"id":"semetey-1-2013:p0791:b003:l007","ordinal":136837,"en":"Poor Kumaik"},{"id":"semetey-1-2013:p0791:b003:l008","ordinal":136838,"en":"Had fully satisfied his craving."},{"id":"semetey-1-2013:p0791:b003:l009","ordinal":136839,"en":"Before the orphan and Bakai,"},{"id":"semetey-1-2013:p0791:b003:l010","ordinal":136840,"en":"When Kumaik came running,"},{"id":"semetey-1-2013:p0791:b003:l011","ordinal":136841,"en":"His coat had filled out like a beaver's."},{"id":"semetey-1-2013:p0791:b003:l012","ordinal":136842,"en":"It was as though magnanimous,"},{"id":"semetey-1-2013:p0791:b003:l013","ordinal":136843,"en":"Brave Manas were still alive."},{"id":"semetey-1-2013:p0791:b003:l014","ordinal":136844,"en":"When Kumaik howled,"},{"id":"semetey-1-2013:p0791:b003:l015","ordinal":136845,"en":"His voice equaled a lion's."},{"id":"semetey-1-2013:p0791:b003:l016","ordinal":136846,"en":"That legacy left by Manas"},{"id":"semetey-1-2013:p0791:b003:l017","ordinal":136847,"en":"Had fur that shimmered in three shades."},{"id":"semetey-1-2013:p0791:b003:l018","ordinal":136848,"en":"When the orphan looked again,"},{"id":"semetey-1-2013:p0791:b003:l019","ordinal":136849,"en":"He had the appearance of a lion,"},{"id":"semetey-1-2013:p0791:b003:l020","ordinal":136850,"en":"A steel collar round his neck."},{"id":"semetey-1-2013:p0791:b003:l021","ordinal":136851,"en":"‘My mother remained behind in tears,"},{"id":"semetey-1-2013:p0791:b003:l022","ordinal":136852,"en":"Saying, “Bring Kumaik with you.”"},{"id":"semetey-1-2013:p0791:b003:l023","ordinal":136853,"en":"She entrusted that task to me."},{"id":"semetey-1-2013:p0791:b003:l024","ordinal":136854,"en":"Elder Bakai, hear my words!"},{"id":"semetey-1-2013:p0791:b003:l025","ordinal":136855,"en":"It would be a disgrace to leave him."},{"id":"semetey-1-2013:p0791:b003:l026","ordinal":136856,"en":"To my dear mother"},{"id":"semetey-1-2013:p0791:b003:l027","ordinal":136857,"en":"Let me bring what she entrusted to me."},{"id":"semetey-1-2013:p0791:b003:l028","ordinal":136858,"en":"It was my mother's request:"},{"id":"semetey-1-2013:p0791:b003:l029","ordinal":136859,"en":"“Bring him with you,” she said,"},{"id":"semetey-1-2013:p0791:b003:l030","ordinal":136860,"en":"“Let me see him with my own eyes.”"},{"id":"semetey-1-2013:p0791:b003:l031","ordinal":136861,"en":"Let me take Kumaik with me,"},{"id":"semetey-1-2013:p0791:b003:l032","ordinal":136862,"en":"To my poor, unhappy mother,"},{"id":"semetey-1-2013:p0791:b003:l033","ordinal":136863,"en":"For the milk of her breast,"},{"id":"semetey-1-2013:p0791:b003:l034","ordinal":136864,"en":"Let me repay at least a little of my debt."},{"id":"semetey-1-2013:p0791:b003:l035","ordinal":136865,"en":"Finding Kumaik, he called on God;"},{"id":"semetey-1-2013:p0791:b003:l036","ordinal":136866,"en":"The poor orphan thought of this."},{"id":"semetey-1-2013:p0791:b003:l037","ordinal":136867,"en":"All the valleys and mountains"},{"id":"semetey-1-2013:p0791:b003:l038","ordinal":136868,"en":"Seemed to be running,"},{"id":"semetey-1-2013:p0791:b003:l039","ordinal":136869,"en":"His father Sultan Manas"},{"id":"semetey-1-2013:p0791:b004:l001","ordinal":136870,"en":"Seemed to have risen from the dead."},{"id":"semetey-1-2013:p0791:b004:l002","ordinal":136871,"en":"Brave Bakai, who led him,"},{"id":"semetey-1-2013:p0791:b004:l003","ordinal":136872,"en":"Urged his horse onward from there."},{"id":"semetey-1-2013:p0791:b004:l004","ordinal":136873,"en":"There were pools among the marshes,"},{"id":"semetey-1-2013:p0791:b004:l005","ordinal":136874,"en":"Geese rising in separate flocks."},{"id":"semetey-1-2013:p0791:b004:l006","ordinal":136875,"en":"The pintails swayed,"},{"id":"semetey-1-2013:p0791:b004:l007","ordinal":136876,"en":"The creatures lay there."},{"id":"semetey-1-2013:p0791:b004:l008","ordinal":136877,"en":"The red-headed ducks bobbed,"},{"id":"semetey-1-2013:p0791:b004:l009","ordinal":136878,"en":"The clear streams branched,"},{"id":"semetey-1-2013:p0791:b004:l010","ordinal":136879,"en":"Spread out in separate channels."},{"id":"semetey-1-2013:p0791:b004:l011","ordinal":136880,"en":"Migrant swans, geese and ducks,"},{"id":"semetey-1-2013:p0791:b004:l012","ordinal":136881,"en":"All confined, unable to fly,"},{"id":"semetey-1-2013:p0791:b004:l013","ordinal":136882,"en":"Those creatures lay there."},{"id":"semetey-1-2013:p0791:b004:l014","ordinal":136883,"en":"From the ridge above,"},{"id":"semetey-1-2013:p0791:b004:l015","ordinal":136884,"en":"Another marvel came into sight."},{"id":"semetey-1-2013:p0791:b004:l016","ordinal":136885,"en":"When Bakai saw it,"},{"id":"semetey-1-2013:p0791:b004:l017","ordinal":136886,"en":"The tears poured from his eyes."},{"id":"semetey-1-2013:p0791:b004:l018","ordinal":136887,"en":"What could your poor elder do?"},{"id":"semetey-1-2013:p0791:b004:l019","ordinal":136888,"en":"From his dear quail-like eyes"},{"id":"semetey-1-2013:p0791:b004:l020","ordinal":136889,"en":"Tears fell drop by drop."},{"id":"semetey-1-2013:p0791:b004:l021","ordinal":136890,"en":"From his dear blackcurrant eyes"},{"id":"semetey-1-2013:p0791:b004:l022","ordinal":136891,"en":"Tears streamed a whip's length."},{"id":"semetey-1-2013:p0791:b004:l023","ordinal":136892,"en":"Your elder, King Bakai,"},{"id":"semetey-1-2013:p0791:b004:l024","ordinal":136893,"en":"Was sorely moved at heart."},{"id":"semetey-1-2013:p0791:b004:l025","ordinal":136894,"en":"Khan Manas's Akshumkar,"},{"id":"semetey-1-2013:p0791:b004:l026","ordinal":136895,"en":"Saying, ‘His son will come today,’"},{"id":"semetey-1-2013:p0791:b004:l027","ordinal":136896,"en":"Seemed to be waiting to meet him."},{"id":"semetey-1-2013:p0791:b004:l028","ordinal":136897,"en":"That day Akshumkar"},{"id":"semetey-1-2013:p0791:b004:l029","ordinal":136898,"en":"Had blocked the mountain pass."},{"id":"semetey-1-2013:p0791:b004:l030","ordinal":136899,"en":"Among migrant swans and migrant geese"},{"id":"semetey-1-2013:p0791:b004:l031","ordinal":136900,"en":"He had wrought a marvelous slaughter,"},{"id":"semetey-1-2013:p0791:b004:l032","ordinal":136901,"en":"For Manas, who had gone to Judgment,"},{"id":"semetey-1-2013:p0791:b004:l033","ordinal":136902,"en":"It had honored his spirit."},{"id":"semetey-1-2013:p0791:b004:l034","ordinal":136903,"en":"‘Surely the orphan will come,’ he said,"},{"id":"semetey-1-2013:p0791:b004:l035","ordinal":136904,"en":"And waited upon his path."},{"id":"semetey-1-2013:p0791:b004:l036","ordinal":136905,"en":"God had granted his desire."},{"id":"semetey-1-2013:p0791:b004:l037","ordinal":136906,"en":"His fully fledged young one"},{"id":"semetey-1-2013:p0791:b004:l038","ordinal":136907,"en":"It had brought to the poplar."},{"id":"semetey-1-2013:p0791:b004:l039","ordinal":136908,"en":"‘The orphan at twelve,"},{"id":"semetey-1-2013:p0792:b003:l001","ordinal":136909,"en":"I shall fly and see him with my own eyes."},{"id":"semetey-1-2013:p0792:b003:l002","ordinal":136910,"en":"His father was Manas, the magnanimous lion."},{"id":"semetey-1-2013:p0792:b003:l003","ordinal":136911,"en":"Honoring Manas's spirit,"},{"id":"semetey-1-2013:p0792:b003:l004","ordinal":136912,"en":"My child to his child,"},{"id":"semetey-1-2013:p0792:b003:l005","ordinal":136913,"en":"I shall entrust,’ it said,"},{"id":"semetey-1-2013:p0792:b003:l006","ordinal":136914,"en":"And had now come."},{"id":"semetey-1-2013:p0792:b003:l007","ordinal":136915,"en":"Of that precious falcon,"},{"id":"semetey-1-2013:p0792:b003:l008","ordinal":136916,"en":"Such was the thought."},{"id":"semetey-1-2013:p0792:b003:l009","ordinal":136917,"en":"Do you see how its young one"},{"id":"semetey-1-2013:p0792:b003:l010","ordinal":136918,"en":"Upon the plane tree beats its wings?"},{"id":"semetey-1-2013:p0792:b003:l011","ordinal":136919,"en":"This orphan standing here"},{"id":"semetey-1-2013:p0792:b003:l012","ordinal":136920,"en":"Was favored in God's sight."},{"id":"semetey-1-2013:p0792:b003:l013","ordinal":136921,"en":"The young one was far larger"},{"id":"semetey-1-2013:p0792:b003:l014","ordinal":136922,"en":"Than its mother."},{"id":"semetey-1-2013:p0792:b003:l015","ordinal":136923,"en":"Its talons steel, its jess-fastener copper,"},{"id":"semetey-1-2013:p0792:b003:l016","ordinal":136924,"en":"Two kez around,"},{"id":"semetey-1-2013:p0792:b003:l018","ordinal":136925,"en":"It would not retreat from anything it saw.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0792:b003:l019","ordinal":136926,"en":"Akshumkar, left by Manas,"},{"id":"semetey-1-2013:p0792:b003:l020","ordinal":136927,"en":"Had hatched and reared a splendid bird,"},{"id":"semetey-1-2013:p0792:b003:l021","ordinal":136928,"en":"By Allah's command the falcon"},{"id":"semetey-1-2013:p0792:b003:l022","ordinal":136929,"en":"Was brought to Semetey."},{"id":"semetey-1-2013:p0792:b003:l023","ordinal":136930,"en":"It was a bird to carry with him,"},{"id":"semetey-1-2013:p0792:b003:l024","ordinal":136931,"en":"A possession left by Manas."},{"id":"semetey-1-2013:p0792:b003:l025","ordinal":136932,"en":"Honoring Manas, Akshumkar"},{"id":"semetey-1-2013:p0792:b003:l026","ordinal":136933,"en":"Had come to give his young one,"},{"id":"semetey-1-2013:p0792:b003:l027","ordinal":136934,"en":"To give and entrust his young one,"},{"id":"semetey-1-2013:p0792:b003:l028","ordinal":136935,"en":"And then Akshumkar"},{"id":"semetey-1-2013:p0792:b003:l029","ordinal":136936,"en":"Would attain his desire."},{"id":"semetey-1-2013:p0792:b003:l030","ordinal":136937,"en":"Akshumkar's young one"},{"id":"semetey-1-2013:p0792:b003:l031","ordinal":136938,"en":"Had filled out its breast feathers."},{"id":"semetey-1-2013:p0792:b003:l033","ordinal":136939,"en":"Its wings had rounded out.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0792:b003:l034","ordinal":136940,"en":"With no tongue to say what it wished,"},{"id":"semetey-1-2013:p0792:b003:l035","ordinal":136941,"en":"Wise, intelligent Akshumkar"},{"id":"semetey-1-2013:p0792:b003:l036","ordinal":136942,"en":"Geese, cranes and migrant swans"},{"id":"semetey-1-2013:p0792:b003:l037","ordinal":136943,"en":"He had gathered for food."},{"id":"semetey-1-2013:p0792:b003:l038","ordinal":136944,"en":"The geese and ducks penned there,"},{"id":"semetey-1-2013:p0792:b003:l039","ordinal":136945,"en":"At the sight of the falcon,"},{"id":"semetey-1-2013:p0792:b004:l001","ordinal":136946,"en":"Were frightened out of their senses."},{"id":"semetey-1-2013:p0792:b004:l002","ordinal":136947,"en":"None would raise its head;"},{"id":"semetey-1-2013:p0792:b004:l003","ordinal":136948,"en":"Each thrust its head into the water."},{"id":"semetey-1-2013:p0792:b004:l004","ordinal":136949,"en":"The rush of wings was heard;"},{"id":"semetey-1-2013:p0792:b004:l005","ordinal":136950,"en":"They tumbled this way and that,"},{"id":"semetey-1-2013:p0792:b004:l006","ordinal":136951,"en":"Their heads buried in the waterweed,"},{"id":"semetey-1-2013:p0792:b004:l007","ordinal":136952,"en":"Those living creatures remained there."},{"id":"semetey-1-2013:p0792:b004:l008","ordinal":136953,"en":"Your valiant orphan received him;"},{"id":"semetey-1-2013:p0792:b004:l009","ordinal":136954,"en":"What had broken was joined,"},{"id":"semetey-1-2013:p0792:b004:l010","ordinal":136955,"en":"What had scattered was gathered."},{"id":"semetey-1-2013:p0792:b004:l011","ordinal":136956,"en":"What had been lost was found,"},{"id":"semetey-1-2013:p0792:b004:l012","ordinal":136957,"en":"His honor was restored."},{"id":"semetey-1-2013:p0792:b004:l013","ordinal":136958,"en":"When he received Akshumkar,"},{"id":"semetey-1-2013:p0792:b004:l014","ordinal":136959,"en":"All the valleys and mountains"},{"id":"semetey-1-2013:p0792:b004:l015","ordinal":136960,"en":"Seemed to be running;"}]
