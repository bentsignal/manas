[{"id":"semetey-2-2013:p1333:b004:l017","ordinal":289281,"en":"While the populace stood thus,"},{"id":"semetey-2-2013:p1333:b004:l018","ordinal":289282,"en":"What did Khan Kanchoro do?"},{"id":"semetey-2-2013:p1333:b004:l019","ordinal":289283,"en":"He went jingling on, unconcerned,"},{"id":"semetey-2-2013:p1333:b004:l020","ordinal":289284,"en":"Counting the clamor of the people"},{"id":"semetey-2-2013:p1333:b004:l021","ordinal":289285,"en":"As no more than the cuff of his trousers."},{"id":"semetey-2-2013:p1333:b004:l022","ordinal":289286,"en":"He did not regard a dusty black ridge"},{"id":"semetey-2-2013:p1333:b004:l023","ordinal":289287,"en":"As even a mountain pass,"},{"id":"semetey-2-2013:p1333:b004:l024","ordinal":289288,"en":"Nor did he regard the people's clamor"},{"id":"semetey-2-2013:p1333:b004:l025","ordinal":289289,"en":"As so much as grass."},{"id":"semetey-2-2013:p1333:b004:l026","ordinal":289290,"en":"The goatskin war drum—"},{"id":"semetey-2-2013:p1333:b004:l027","ordinal":289291,"en":"He beat the great drum."},{"id":"semetey-2-2013:p1333:b004:l028","ordinal":289292,"en":"In Jeti-Özön the Jediger,"},{"id":"semetey-2-2013:p1333:b004:l029","ordinal":289293,"en":"The vast, eager-standing host,"},{"id":"semetey-2-2013:p1333:b004:l030","ordinal":289294,"en":"He roused every one of them."},{"id":"semetey-2-2013:p1333:b004:l031","ordinal":289295,"en":"Damn you, Jediger!"},{"id":"semetey-2-2013:p1333:b004:l032","ordinal":289296,"en":"Obey the words of Khan Kanchoro;"},{"id":"semetey-2-2013:p1333:b004:l033","ordinal":289297,"en":"Let all the people enter upon his plan."},{"id":"semetey-2-2013:p1333:b004:l034","ordinal":289298,"en":"In Kara-Buura and Chatkal,"},{"id":"semetey-2-2013:p1333:b004:l035","ordinal":289299,"en":"The many herds of horses left in sight"},{"id":"semetey-2-2013:p1333:b004:l036","ordinal":289300,"en":"Must be grazing there in sweeping ranks."},{"id":"semetey-2-2013:p1333:b004:l037","ordinal":289301,"en":"The sunny side of the horse range"},{"id":"semetey-2-2013:p1333:b004:l038","ordinal":289302,"en":"Lies on the ridge of Jorgo-Küyük;"},{"id":"semetey-2-2013:p1333:b004:l039","ordinal":289303,"en":"The shaded side of the horse range—"},{"id":"semetey-2-2013:p1334:b003:l001","ordinal":289304,"en":"Faces toward Bek-Jailoo,"},{"id":"semetey-2-2013:p1334:b003:l002","ordinal":289305,"en":"Its pass-side toward Kan-Jailoo."},{"id":"semetey-2-2013:p1334:b003:l003","ordinal":289306,"en":"On the ridge of Kan-Jailoo,"},{"id":"semetey-2-2013:p1334:b003:l004","ordinal":289307,"en":"The nearer side of the horse range"},{"id":"semetey-2-2013:p1334:b003:l005","ordinal":289308,"en":"Is by Üch-Koshoi and Keng-Shor."},{"id":"semetey-2-2013:p1334:b003:l006","ordinal":289309,"en":"Wreak havoc and raise turmoil;"},{"id":"semetey-2-2013:p1334:b003:l007","ordinal":289310,"en":"This mighty warrior's countless horses—"},{"id":"semetey-2-2013:p1334:b003:l008","ordinal":289311,"en":"Plunder and drive them off."},{"id":"semetey-2-2013:p1334:b003:l009","ordinal":289312,"en":"Jediger of Jeti-Özön,"},{"id":"semetey-2-2013:p1334:b003:l010","ordinal":289313,"en":"All of you who are able,"},{"id":"semetey-2-2013:p1334:b003:l011","ordinal":289314,"en":"Drive away seven thousand horses each;"},{"id":"semetey-2-2013:p1334:b003:l012","ordinal":289315,"en":"You weaklings unable to manage that,"},{"id":"semetey-2-2013:p1334:b003:l013","ordinal":289316,"en":"Drive away seven hundred each;"},{"id":"semetey-2-2013:p1334:b003:l014","ordinal":289317,"en":"You weaklings unable to manage that,"},{"id":"semetey-2-2013:p1334:b003:l015","ordinal":289318,"en":"Drive away seven hundred horses each"},{"id":"semetey-2-2013:p1334:b003:l016","ordinal":289319,"en":"And make them your plunder."},{"id":"semetey-2-2013:p1334:b003:l017","ordinal":289320,"en":"Twelve tümön of abundant livestock—"},{"id":"semetey-2-2013:p1334:b003:l018","ordinal":289321,"en":"Thus plunder and seize them."},{"id":"semetey-2-2013:p1334:b003:l019","ordinal":289322,"en":"Then all your misfortune will vanish,"},{"id":"semetey-2-2013:p1334:b003:l020","ordinal":289323,"en":"And you great black host of Jediger"},{"id":"semetey-2-2013:p1334:b003:l021","ordinal":289324,"en":"Will lie at ease with swollen bellies."},{"id":"semetey-2-2013:p1334:b003:l022","ordinal":289325,"en":"Unleash the passion in your hearts;"},{"id":"semetey-2-2013:p1334:b003:l023","ordinal":289326,"en":"In this way pass beyond misfortune."},{"id":"semetey-2-2013:p1334:b003:l024","ordinal":289327,"en":"Take all his worldly goods"},{"id":"semetey-2-2013:p1334:b003:l025","ordinal":289328,"en":"And settle down wealthy."},{"id":"semetey-2-2013:p1334:b003:l026","ordinal":289329,"en":"In the mountains are nine hosts of horses,"},{"id":"semetey-2-2013:p1334:b003:l027","ordinal":289330,"en":"Packhorses mingled with thoroughbreds."},{"id":"semetey-2-2013:p1334:b003:l028","ordinal":289331,"en":"If you go in and take them as spoil,"},{"id":"semetey-2-2013:p1334:b003:l029","ordinal":289332,"en":"Let your poor hearts rejoice!"},{"id":"semetey-2-2013:p1334:b003:l030","ordinal":289333,"en":"On the hills are piebald horses,"},{"id":"semetey-2-2013:p1334:b003:l031","ordinal":289334,"en":"Fleet thoroughbreds mingled among them."},{"id":"semetey-2-2013:p1334:b003:l032","ordinal":289335,"en":"Go and plunder them all;"},{"id":"semetey-2-2013:p1334:b003:l033","ordinal":289336,"en":"Let your poor hearts rejoice!"},{"id":"semetey-2-2013:p1334:b003:l034","ordinal":289337,"en":"Cast a cold catch-rope"},{"id":"semetey-2-2013:p1334:b003:l035","ordinal":289338,"en":"Upon the thoroughbred he would not give when asked."},{"id":"semetey-2-2013:p1334:b003:l036","ordinal":289339,"en":"Strike on every side"},{"id":"semetey-2-2013:p1334:b003:l037","ordinal":289340,"en":"The countless black herds he withholds despite pleas."},{"id":"semetey-2-2013:p1334:b003:l038","ordinal":289341,"en":"Cast lassos over the thoroughbreds"},{"id":"semetey-2-2013:p1334:b003:l039","ordinal":289342,"en":"And enter into this revel."},{"id":"semetey-2-2013:p1334:b004:l001","ordinal":289343,"en":"At Kuu-Tez of Kuugandy"},{"id":"semetey-2-2013:p1334:b004:l002","ordinal":289344,"en":"Loose horses are lying now."},{"id":"semetey-2-2013:p1334:b004:l003","ordinal":289345,"en":"Look upon the splendid livestock;"},{"id":"semetey-2-2013:p1334:b004:l004","ordinal":289346,"en":"Divide by the measure of the whip"},{"id":"semetey-2-2013:p1334:b004:l005","ordinal":289347,"en":"The countless horses left by the mighty warrior."},{"id":"semetey-2-2013:p1334:b004:l006","ordinal":289348,"en":"The great treasury and myriad possessions—"},{"id":"semetey-2-2013:p1334:b004:l007","ordinal":289349,"en":"Plunder them all and leave nothing."},{"id":"semetey-2-2013:p1334:b004:l008","ordinal":289350,"en":"Say, “Kanchoro's support"},{"id":"semetey-2-2013:p1334:b004:l009","ordinal":289351,"en":"Has brought us this much benefit.”"},{"id":"semetey-2-2013:p1334:b004:l010","ordinal":289352,"en":"Go back to your lands, Jediger,"},{"id":"semetey-2-2013:p1334:b004:l011","ordinal":289353,"en":"And boast of it with elation."},{"id":"semetey-2-2013:p1334:b004:l012","ordinal":289354,"en":"This mighty warrior's treasury,"},{"id":"semetey-2-2013:p1334:b004:l013","ordinal":289355,"en":"The gate standing before the palace,"},{"id":"semetey-2-2013:p1334:b004:l014","ordinal":289356,"en":"The garden planted with plane trees,"},{"id":"semetey-2-2013:p1334:b004:l015","ordinal":289357,"en":"The true warrior-khan's throne,"},{"id":"semetey-2-2013:p1334:b004:l016","ordinal":289358,"en":"The dark eye of the spring,"},{"id":"semetey-2-2013:p1334:b004:l017","ordinal":289359,"en":"The very plane tree itself,"},{"id":"semetey-2-2013:p1334:b004:l018","ordinal":289360,"en":"The golden-gated horde—"},{"id":"semetey-2-2013:p1334:b004:l019","ordinal":289361,"en":"Great black host of Jediger,"},{"id":"semetey-2-2013:p1334:b004:l020","ordinal":289362,"en":"Throw yourselves upon them without sparing life;"},{"id":"semetey-2-2013:p1334:b004:l021","ordinal":289363,"en":"Launch a mass assault!"},{"id":"semetey-2-2013:p1334:b004:l022","ordinal":289364,"en":"Make arrows rain down like rain,"},{"id":"semetey-2-2013:p1334:b004:l023","ordinal":289365,"en":"Shoot bullets like hail;"},{"id":"semetey-2-2013:p1334:b004:l024","ordinal":289366,"en":"Slaughter his heroes and lay them low,"},{"id":"semetey-2-2013:p1334:b004:l025","ordinal":289367,"en":"Set all his people clamoring,"},{"id":"semetey-2-2013:p1334:b004:l026","ordinal":289368,"en":"Slaughter his khans and lay them low,"},{"id":"semetey-2-2013:p1334:b004:l027","ordinal":289369,"en":"Destroy all who remain."},{"id":"semetey-2-2013:p1334:b004:l028","ordinal":289370,"en":"Make their women don black headdresses;"},{"id":"semetey-2-2013:p1334:b004:l029","ordinal":289371,"en":"Slaughter every last one."},{"id":"semetey-2-2013:p1334:b004:l030","ordinal":289372,"en":"Bring terror upon their beks;"},{"id":"semetey-2-2013:p1334:b004:l031","ordinal":289373,"en":"Attack head-on and plunder."},{"id":"semetey-2-2013:p1334:b004:l032","ordinal":289374,"en":"Say, “We overran from above"},{"id":"semetey-2-2013:p1334:b004:l033","ordinal":289375,"en":"The mighty warrior who fell upon us;"},{"id":"semetey-2-2013:p1334:b004:l034","ordinal":289376,"en":"We scattered his four kinds of livestock,"},{"id":"semetey-2-2013:p1334:b004:l035","ordinal":289377,"en":"Slaughtered and destroyed his nobles,"},{"id":"semetey-2-2013:p1334:b004:l036","ordinal":289378,"en":"And raised a great upheaval.”"},{"id":"semetey-2-2013:p1334:b004:l037","ordinal":289379,"en":"Such is the way of combat."},{"id":"semetey-2-2013:p1334:b004:l038","ordinal":289380,"en":"Say, “We destroyed his remaining men"},{"id":"semetey-2-2013:p1334:b004:l039","ordinal":289381,"en":"And carried off his women.”"},{"id":"semetey-2-2013:p1335:b003:l001","ordinal":289382,"en":"Jediger of Jeti-Özön,"},{"id":"semetey-2-2013:p1335:b003:l002","ordinal":289383,"en":"You will have something to boast of."},{"id":"semetey-2-2013:p1335:b003:l003","ordinal":289384,"en":"Since you were born as Jediger,"},{"id":"semetey-2-2013:p1335:b003:l004","ordinal":289385,"en":"Dig a well in the place of honor;"},{"id":"semetey-2-2013:p1335:b003:l005","ordinal":289386,"en":"Scatter their four kinds of livestock."},{"id":"semetey-2-2013:p1335:b003:l006","ordinal":289387,"en":"Great black host of Jediger,"},{"id":"semetey-2-2013:p1335:b003:l007","ordinal":289388,"en":"Move off in a dark mass along the ridge."},{"id":"semetey-2-2013:p1335:b003:l008","ordinal":289389,"en":"My people, thus avenge"},{"id":"semetey-2-2013:p1335:b003:l009","ordinal":289390,"en":"Toltoy, who was your uncle and khan!"},{"id":"semetey-2-2013:p1335:b003:l010","ordinal":289391,"en":"Slaughter every one"},{"id":"semetey-2-2013:p1335:b003:l011","ordinal":289392,"en":"Of their elders who boasted of strength."},{"id":"semetey-2-2013:p1335:b003:l012","ordinal":289393,"en":"Seething Jediger,"},{"id":"semetey-2-2013:p1335:b003:l013","ordinal":289394,"en":"Know that I have spoken thus."},{"id":"semetey-2-2013:p1335:b003:l014","ordinal":289395,"en":"My people, every one of you, heed"},{"id":"semetey-2-2013:p1335:b003:l015","ordinal":289396,"en":"What your Khan Kanchoro has said."},{"id":"semetey-2-2013:p1335:b003:l016","ordinal":289397,"en":"Of this son-of-a-bitch warrior,"},{"id":"semetey-2-2013:p1335:b003:l017","ordinal":289398,"en":"This oath-breaker who ruined the age,"},{"id":"semetey-2-2013:p1335:b003:l018","ordinal":289399,"en":"Slaughter many and take your plunder!"},{"id":"semetey-2-2013:p1335:b003:l019","ordinal":289400,"en":"Cut down his plane trees and lay them low;"},{"id":"semetey-2-2013:p1335:b003:l020","ordinal":289401,"en":"Kick down his walls."},{"id":"semetey-2-2013:p1335:b003:l021","ordinal":289402,"en":"Plunder and take his gold;"},{"id":"semetey-2-2013:p1335:b003:l022","ordinal":289403,"en":"Raise merciless turmoil."},{"id":"semetey-2-2013:p1335:b003:l023","ordinal":289404,"en":"Draw bows and make arrows rain;"},{"id":"semetey-2-2013:p1335:b003:l024","ordinal":289405,"en":"Shoot other missiles like hail."},{"id":"semetey-2-2013:p1335:b003:l025","ordinal":289406,"en":"Exert your strength without mercy,"},{"id":"semetey-2-2013:p1335:b003:l026","ordinal":289407,"en":"Level his capital to the ground,"},{"id":"semetey-2-2013:p1335:b003:l027","ordinal":289408,"en":"And sack it completely."},{"id":"semetey-2-2013:p1335:b003:l028","ordinal":289409,"en":"Bring slaughter upon his people."},{"id":"semetey-2-2013:p1335:b003:l029","ordinal":289410,"en":"Come now, Jediger, do not stand idle;"},{"id":"semetey-2-2013:p1335:b003:l030","ordinal":289411,"en":"Take your positions on either side."},{"id":"semetey-2-2013:p1335:b003:l031","ordinal":289412,"en":"Fire your guns and draw your bows;"},{"id":"semetey-2-2013:p1335:b003:l032","ordinal":289413,"en":"Fight with blades flashing."},{"id":"semetey-2-2013:p1335:b003:l033","ordinal":289414,"en":"Let bowstrings and arrows thrum,"},{"id":"semetey-2-2013:p1335:b003:l034","ordinal":289415,"en":"Let the places they strike burst apart,"},{"id":"semetey-2-2013:p1335:b003:l035","ordinal":289416,"en":"Let spilled blood run in streams."},{"id":"semetey-2-2013:p1335:b003:l036","ordinal":289417,"en":"Hack through and hollow out"},{"id":"semetey-2-2013:p1335:b003:l037","ordinal":289418,"en":"A place as broad as a ship."},{"id":"semetey-2-2013:p1335:b003:l038","ordinal":289419,"en":"If any soul dies in the fighting,"},{"id":"semetey-2-2013:p1335:b003:l039","ordinal":289420,"en":"Bury him in his clothes."},{"id":"semetey-2-2013:p1335:b004:l001","ordinal":289421,"en":"Such is the way of battle;"},{"id":"semetey-2-2013:p1335:b004:l002","ordinal":289422,"en":"Thus feast upon the plunder."},{"id":"semetey-2-2013:p1335:b004:l003","ordinal":289423,"en":"Break apart their fine goods;"},{"id":"semetey-2-2013:p1335:b004:l004","ordinal":289424,"en":"Bring ruin upon them in earnest."},{"id":"semetey-2-2013:p1335:b004:l005","ordinal":289425,"en":"If his guards resist,"},{"id":"semetey-2-2013:p1335:b004:l006","ordinal":289426,"en":"Drag them along the road"},{"id":"semetey-2-2013:p1335:b004:l007","ordinal":289427,"en":"And hand them over to the Dangyt!"},{"id":"semetey-2-2013:p1335:b004:l008","ordinal":289428,"en":"Slaughter every able man who guards the gate;"},{"id":"semetey-2-2013:p1335:b004:l009","ordinal":289429,"en":"Leave none alive."},{"id":"semetey-2-2013:p1335:b004:l010","ordinal":289430,"en":"Great black host of Jediger,"},{"id":"semetey-2-2013:p1335:b004:l011","ordinal":289431,"en":"Plunder the warrior-khan's treasury;"},{"id":"semetey-2-2013:p1335:b004:l012","ordinal":289432,"en":"Do not leave a thing!"},{"id":"semetey-2-2013:p1335:b004:l013","ordinal":289433,"en":"Let dust fly to the heavens;"},{"id":"semetey-2-2013:p1335:b004:l014","ordinal":289434,"en":"Let troops boil up in dusty masses."},{"id":"semetey-2-2013:p1335:b004:l015","ordinal":289435,"en":"Let spearheads clash,"},{"id":"semetey-2-2013:p1335:b004:l016","ordinal":289436,"en":"And human heads collide!”"},{"id":"semetey-2-2013:p1335:b004:l017","ordinal":289437,"en":"So Kanchoro spoke"},{"id":"semetey-2-2013:p1335:b004:l018","ordinal":289438,"en":"And issued his command"},{"id":"semetey-2-2013:p1335:b004:l019","ordinal":289439,"en":"To plunder the treasury."},{"id":"semetey-2-2013:p1335:b004:l020","ordinal":289440,"en":"He was working a monstrous outrage,"},{"id":"semetey-2-2013:p1335:b004:l021","ordinal":289441,"en":"A great and merciless calamity."},{"id":"semetey-2-2013:p1335:b004:l022","ordinal":289442,"en":"Crested banners filled the ranks;"},{"id":"semetey-2-2013:p1335:b004:l023","ordinal":289443,"en":"The clamor split the sky."},{"id":"semetey-2-2013:p1335:b004:l024","ordinal":289444,"en":"When Kanchoro commanded,"},{"id":"semetey-2-2013:p1335:b004:l025","ordinal":289445,"en":"“Break the horde and take plunder!"},{"id":"semetey-2-2013:p1335:b004:l026","ordinal":289446,"en":"Attack them with a roar!”"},{"id":"semetey-2-2013:p1335:b004:l027","ordinal":289447,"en":"Choro issued his decree."},{"id":"semetey-2-2013:p1335:b004:l028","ordinal":289448,"en":"Ah, this luckless Choro—"},{"id":"semetey-2-2013:p1335:b004:l029","ordinal":289449,"en":"The hair on his crown bristled,"},{"id":"semetey-2-2013:p1335:b004:l030","ordinal":289450,"en":"His eyes truly blazed with fire;"},{"id":"semetey-2-2013:p1335:b004:l031","ordinal":289451,"en":"His broad front teeth, large as a gate,"},{"id":"semetey-2-2013:p1335:b004:l032","ordinal":289452,"en":"Teeth unlike those of any other soul,"},{"id":"semetey-2-2013:p1335:b004:l033","ordinal":289453,"en":"Ground together with a loud crunch."},{"id":"semetey-2-2013:p1335:b004:l034","ordinal":289454,"en":"Kanchoro raised the battle cry."},{"id":"semetey-2-2013:p1335:b004:l035","ordinal":289455,"en":"Not one soul remained upright;"},{"id":"semetey-2-2013:p1335:b004:l036","ordinal":289456,"en":"The great black host of Jediger"},{"id":"semetey-2-2013:p1335:b004:l037","ordinal":289457,"en":"Began to claw at the earth."},{"id":"semetey-2-2013:p1335:b004:l038","ordinal":289458,"en":"As the Jediger stood thus,"},{"id":"semetey-2-2013:p1335:b004:l039","ordinal":289459,"en":"Choro emerged in a frenzy."},{"id":"semetey-2-2013:p1336:b003:l001","ordinal":289460,"en":"His shout split stone;"},{"id":"semetey-2-2013:p1336:b003:l002","ordinal":289461,"en":"His roar split heads."},{"id":"semetey-2-2013:p1336:b003:l003","ordinal":289462,"en":"He began a vast tumult"},{"id":"semetey-2-2013:p1336:b003:l004","ordinal":289463,"en":"Such as men might know and nations behold."},{"id":"semetey-2-2013:p1336:b003:l005","ordinal":289464,"en":"The Jediger faltered"},{"id":"semetey-2-2013:p1336:b003:l006","ordinal":289465,"en":"And began to flee."},{"id":"semetey-2-2013:p1336:b003:l007","ordinal":289466,"en":"“Great black host of Jediger,"},{"id":"semetey-2-2013:p1336:b003:l008","ordinal":289467,"en":"You are merely hands that were just fighting,"},{"id":"semetey-2-2013:p1336:b003:l009","ordinal":289468,"en":"Merely mouths that were just boasting."},{"id":"semetey-2-2013:p1336:b003:l010","ordinal":289469,"en":"Jediger who claimed to be heroes,"},{"id":"semetey-2-2013:p1336:b003:l011","ordinal":289470,"en":"If you flee now, you are finished!"},{"id":"semetey-2-2013:p1336:b003:l012","ordinal":289471,"en":"Looking back again and again,"},{"id":"semetey-2-2013:p1336:b003:l013","ordinal":289472,"en":"What were you saying just now?"},{"id":"semetey-2-2013:p1336:b003:l014","ordinal":289473,"en":"If you are heroes, if you are lions,"},{"id":"semetey-2-2013:p1336:b003:l015","ordinal":289474,"en":"If you are the finest people—!”"},{"id":"semetey-2-2013:p1336:b003:l016","ordinal":289475,"en":"When Kanchoro spoke thus,"},{"id":"semetey-2-2013:p1336:b003:l017","ordinal":289476,"en":"The Jediger rose as one"},{"id":"semetey-2-2013:p1336:b003:l018","ordinal":289477,"en":"And all marched thundering."},{"id":"semetey-2-2013:p1336:b003:l019","ordinal":289478,"en":"At the valor of that host,"},{"id":"semetey-2-2013:p1336:b003:l020","ordinal":289479,"en":"The earth split with a roar."},{"id":"semetey-2-2013:p1336:b003:l021","ordinal":289480,"en":"Trumpets deafened the ear;"},{"id":"semetey-2-2013:p1336:b003:l022","ordinal":289481,"en":"Pale banners became their standards."},{"id":"semetey-2-2013:p1336:b003:l023","ordinal":289482,"en":"A clamor split the sky;"},{"id":"semetey-2-2013:p1336:b003:l024","ordinal":289483,"en":"The people cried out and the host swelled,"},{"id":"semetey-2-2013:p1336:b003:l025","ordinal":289484,"en":"Countless and abundant."},{"id":"semetey-2-2013:p1336:b003:l026","ordinal":289485,"en":"The attacking Jediger"},{"id":"semetey-2-2013:p1336:b003:l027","ordinal":289486,"en":"Divided into surging ranks;"},{"id":"semetey-2-2013:p1336:b003:l028","ordinal":289487,"en":"Their savage aspect appeared."},{"id":"semetey-2-2013:p1336:b003:l029","ordinal":289488,"en":"They mounted stallions from the herd,"},{"id":"semetey-2-2013:p1336:b003:l030","ordinal":289489,"en":"Took single poles from the woods,"},{"id":"semetey-2-2013:p1336:b003:l031","ordinal":289490,"en":"And became wildly excited."},{"id":"semetey-2-2013:p1336:b003:l032","ordinal":289491,"en":"Their strongest men, their lions,"},{"id":"semetey-2-2013:p1336:b003:l033","ordinal":289492,"en":"Broad-chested and wide-breasted,"},{"id":"semetey-2-2013:p1336:b003:l034","ordinal":289493,"en":"With long poles and pale clubs—"},{"id":"semetey-2-2013:p1336:b003:l035","ordinal":289494,"en":"What well-formed wrestlers they were!"},{"id":"semetey-2-2013:p1336:b003:l036","ordinal":289495,"en":"The Jediger had grown frenzied,"},{"id":"semetey-2-2013:p1336:b003:l037","ordinal":289496,"en":"Bent that day on plundering the horde."},{"id":"semetey-2-2013:p1336:b003:l038","ordinal":289497,"en":"Thick-armed and stone-hearted,"},{"id":"semetey-2-2013:p1336:b003:l039","ordinal":289498,"en":"They meant to break the horde, seize plunder,"},{"id":"semetey-2-2013:p1336:b004:l001","ordinal":289499,"en":"And unleash a great upheaval."},{"id":"semetey-2-2013:p1336:b004:l002","ordinal":289500,"en":"Darkening with grim resolve,"},{"id":"semetey-2-2013:p1336:b004:l003","ordinal":289501,"en":"The Jediger entered the fray."},{"id":"semetey-2-2013:p1336:b004:l004","ordinal":289502,"en":"With a cry that deafened ears,"},{"id":"semetey-2-2013:p1336:b004:l005","ordinal":289503,"en":"The Jediger entered the tumult."},{"id":"semetey-2-2013:p1336:b004:l006","ordinal":289504,"en":"Into an affliction with no remedy,"},{"id":"semetey-2-2013:p1336:b004:l007","ordinal":289505,"en":"The Jediger entered the tumult."},{"id":"semetey-2-2013:p1336:b004:l008","ordinal":289506,"en":"They made their spears ready"},{"id":"semetey-2-2013:p1336:b004:l009","ordinal":289507,"en":"And prepared their battle-axes."},{"id":"semetey-2-2013:p1336:b004:l010","ordinal":289508,"en":"They surged, roused to fury,"},{"id":"semetey-2-2013:p1336:b004:l011","ordinal":289509,"en":"Saying to one another,"},{"id":"semetey-2-2013:p1336:b004:l012","ordinal":289510,"en":"“Mount up, Jediger!”"},{"id":"semetey-2-2013:p1336:b004:l013","ordinal":289511,"en":"Heroic Kiyaz thundered;"},{"id":"semetey-2-2013:p1336:b004:l014","ordinal":289512,"en":"This was when he became inflamed."},{"id":"semetey-2-2013:p1336:b004:l015","ordinal":289513,"en":"“Break and take his horde!"},{"id":"semetey-2-2013:p1336:b004:l016","ordinal":289514,"en":"Raid and take his horses!”"},{"id":"semetey-2-2013:p1336:b004:l017","ordinal":289515,"en":"The slippery Kanchoro"},{"id":"semetey-2-2013:p1336:b004:l018","ordinal":289516,"en":"Was rousing them at that moment."},{"id":"semetey-2-2013:p1336:b004:l019","ordinal":289517,"en":"When their khans issued a decree,"},{"id":"semetey-2-2013:p1336:b004:l020","ordinal":289518,"en":"How could the people not be stirred?"},{"id":"semetey-2-2013:p1336:b004:l021","ordinal":289519,"en":"If they refused the khan's word,"},{"id":"semetey-2-2013:p1336:b004:l022","ordinal":289520,"en":"Would God not strike the populace?"},{"id":"semetey-2-2013:p1336:b004:l023","ordinal":289521,"en":"The leaders of ten bustled,"},{"id":"semetey-2-2013:p1336:b004:l024","ordinal":289522,"en":"The leaders of fifty strutted,"},{"id":"semetey-2-2013:p1336:b004:l025","ordinal":289523,"en":"The leaders of a hundred ran,"},{"id":"semetey-2-2013:p1336:b004:l026","ordinal":289524,"en":"And all the leaders of a thousand"},{"id":"semetey-2-2013:p1336:b004:l027","ordinal":289525,"en":"Thus despaired of life."},{"id":"semetey-2-2013:p1336:b004:l028","ordinal":289526,"en":"Their heroes and brave men"},{"id":"semetey-2-2013:p1336:b004:l029","ordinal":289527,"en":"Took battle-axes in hand."},{"id":"semetey-2-2013:p1336:b004:l030","ordinal":289528,"en":"Boasting as heroes and lions,"},{"id":"semetey-2-2013:p1336:b004:l031","ordinal":289529,"en":"They simply swaggered in warlike pride."},{"id":"semetey-2-2013:p1336:b004:l032","ordinal":289530,"en":"They pounded the earth with a roar;"},{"id":"semetey-2-2013:p1336:b004:l033","ordinal":289531,"en":"Their clamor split the sky."},{"id":"semetey-2-2013:p1336:b004:l034","ordinal":289532,"en":"The host filled broad Talas;"},{"id":"semetey-2-2013:p1336:b004:l035","ordinal":289533,"en":"The dread and calamitous affair"},{"id":"semetey-2-2013:p1336:b004:l036","ordinal":289534,"en":"Was not small but immense."},{"id":"semetey-2-2013:p1336:b004:l037","ordinal":289535,"en":"Clubmen formed the front,"},{"id":"semetey-2-2013:p1336:b004:l038","ordinal":289536,"en":"Fighters stood at the flanks,"}]
