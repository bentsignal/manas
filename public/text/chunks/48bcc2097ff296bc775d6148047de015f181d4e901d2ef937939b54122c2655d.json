[{"id":"semetey-1-2013:p0782:b003:l011","ordinal":136193,"en":"There is a tale that never ends,"},{"id":"semetey-1-2013:p0782:b003:l012","ordinal":136194,"en":"Growing stronger whenever it seemed spent,"},{"id":"semetey-1-2013:p0782:b003:l013","ordinal":136195,"en":"His roots have a saintly quality."},{"id":"semetey-1-2013:p0782:b003:l014","ordinal":136196,"en":"‘When she had just given birth,"},{"id":"semetey-1-2013:p0782:b003:l015","ordinal":136197,"en":"We witnessed a great miracle,’"},{"id":"semetey-1-2013:p0782:b003:l016","ordinal":136198,"en":"Six women said."},{"id":"semetey-1-2013:p0782:b003:l017","ordinal":136199,"en":"Let me tell you who the six were:"},{"id":"semetey-1-2013:p0782:b003:l018","ordinal":136200,"en":"Almambet's Aruuke,"},{"id":"semetey-1-2013:p0782:b003:l019","ordinal":136201,"en":"Khan Bakai's Körpöjan,"},{"id":"semetey-1-2013:p0782:b003:l020","ordinal":136202,"en":"Brave Chubak's Altynai,"},{"id":"semetey-1-2013:p0782:b003:l021","ordinal":136203,"en":"Ajybai's Alymkan,"},{"id":"semetey-1-2013:p0782:b003:l022","ordinal":136204,"en":"Brave Shuutu's Burmakan."},{"id":"semetey-1-2013:p0782:b003:l023","ordinal":136205,"en":"While Kanykei labored greatly,"},{"id":"semetey-1-2013:p0782:b003:l026","ordinal":136206,"en":"She bore the warrior, brave Semetey,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0782:b003:l027","ordinal":136207,"en":"Upright, with his feet first."},{"id":"semetey-1-2013:p0782:b003:l028","ordinal":136208,"en":"In his right hand, dark blood—"},{"id":"semetey-1-2013:p0782:b003:l029","ordinal":136209,"en":"I hear he was born clutching it."},{"id":"semetey-1-2013:p0782:b003:l030","ordinal":136210,"en":"That he was born clutching dark blood"},{"id":"semetey-1-2013:p0782:b004:l001","ordinal":136211,"en":"Meant, ‘The enemy who attacks me,"},{"id":"semetey-1-2013:p0782:b004:l002","ordinal":136212,"en":"When I fight him in fury,"},{"id":"semetey-1-2013:p0782:b004:l003","ordinal":136213,"en":"I shall spill his blood.’"},{"id":"semetey-1-2013:p0782:b004:l004","ordinal":136214,"en":"The reason his left hand"},{"id":"semetey-1-2013:p0782:b004:l005","ordinal":136215,"en":"Was born grasping yellow venom"},{"id":"semetey-1-2013:p0782:b004:l006","ordinal":136216,"en":"Was, ‘I shall turn them yellow as venom;"},{"id":"semetey-1-2013:p0782:b004:l007","ordinal":136217,"en":"Until only one descendant remains,"},{"id":"semetey-1-2013:p0782:b004:l008","ordinal":136218,"en":"I shall dig out their roots.’"},{"id":"semetey-1-2013:p0782:b004:l009","ordinal":136219,"en":"At Abyke's palace,"},{"id":"semetey-1-2013:p0782:b004:l010","ordinal":136220,"en":"All forty companions,"},{"id":"semetey-1-2013:p0782:b004:l011","ordinal":136221,"en":"The elders led by Kyrgyl,"},{"id":"semetey-1-2013:p0782:b004:l012","ordinal":136222,"en":"When they heard the blessed words,"},{"id":"semetey-1-2013:p0782:b004:l013","ordinal":136223,"en":"All collapsed,"},{"id":"semetey-1-2013:p0782:b004:l014","ordinal":136224,"en":"Hung up their weapons,"},{"id":"semetey-1-2013:p0782:b004:l015","ordinal":136225,"en":"And took to drinking."},{"id":"semetey-1-2013:p0782:b004:l016","ordinal":136226,"en":"In Abyke's house,"},{"id":"semetey-1-2013:p0782:b004:l017","ordinal":136227,"en":"Strong liquor stood by the wall."},{"id":"semetey-1-2013:p0782:b004:l019","ordinal":136228,"en":"They poured it into traveling cups,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0782:b004:l020","ordinal":136229,"en":"They all passed it round."},{"id":"semetey-1-2013:p0782:b004:l021","ordinal":136230,"en":"Those wretched forty companions,"},{"id":"semetey-1-2013:p0782:b004:l023","ordinal":136231,"en":"As for the orphan, Manas's son,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0782:b004:l024","ordinal":136232,"en":"The forty companions cared nothing;"},{"id":"semetey-1-2013:p0782:b004:l025","ordinal":136233,"en":"No one asked, ‘Where are you?’"},{"id":"semetey-1-2013:p0782:b004:l026","ordinal":136234,"en":"They drank liquor and panted,"},{"id":"semetey-1-2013:p0782:b004:l027","ordinal":136235,"en":"They drank kumys and shouted."},{"id":"semetey-1-2013:p0782:b004:l028","ordinal":136236,"en":"The scandal of the forty companions—"},{"id":"semetey-1-2013:p0782:b004:l029","ordinal":136237,"en":"Now let me tell"},{"id":"semetey-1-2013:p0782:b004:l030","ordinal":136238,"en":"The tale of brave Semetey."},{"id":"semetey-1-2013:p0783:b004:l001","ordinal":136239,"en":"Brave Bakai led him"},{"id":"semetey-1-2013:p0783:b004:l002","ordinal":136240,"en":"Across the yellow, rugged ridge,"},{"id":"semetey-1-2013:p0783:b004:l003","ordinal":136241,"en":"Through the ranks of upland valleys—"},{"id":"semetey-1-2013:p0783:b004:l004","ordinal":136242,"en":"May I be his sacrifice!—"},{"id":"semetey-1-2013:p0783:b004:l005","ordinal":136243,"en":"Across the yellow, rugged ridge."},{"id":"semetey-1-2013:p0783:b004:l006","ordinal":136244,"en":"The little hills of Kan-Jailak"},{"id":"semetey-1-2013:p0783:b004:l007","ordinal":136245,"en":"Showed in mottled patches."},{"id":"semetey-1-2013:p0783:b004:l008","ordinal":136246,"en":"The heart of staunch, fierce Bakai"},{"id":"semetey-1-2013:p0783:b004:l009","ordinal":136247,"en":"Was sorely troubled."},{"id":"semetey-1-2013:p0783:b004:l010","ordinal":136248,"en":"Hill after hill came into view;"},{"id":"semetey-1-2013:p0783:b004:l011","ordinal":136249,"en":"Horses stood out upon the hills."},{"id":"semetey-1-2013:p0783:b004:l012","ordinal":136250,"en":"From grieving, fierce Bakai's eyes"},{"id":"semetey-1-2013:p0783:b004:l013","ordinal":136251,"en":"The tears poured down."},{"id":"semetey-1-2013:p0783:b004:l014","ordinal":136252,"en":"Watching him, Semetey"},{"id":"semetey-1-2013:p0783:b004:l015","ordinal":136253,"en":"Seemed greatly troubled."},{"id":"semetey-1-2013:p0783:b004:l016","ordinal":136254,"en":"His white beard grew thin;"},{"id":"semetey-1-2013:p0783:b004:l017","ordinal":136255,"en":"The dark tears from his eyes"},{"id":"semetey-1-2013:p0783:b004:l018","ordinal":136256,"en":"Of your valiant elder Bakai,"},{"id":"semetey-1-2013:p0783:b004:l019","ordinal":136257,"en":"Poured down his collarbone."},{"id":"semetey-1-2013:p0783:b004:l020","ordinal":136258,"en":"Without speaking a word,"},{"id":"semetey-1-2013:p0783:b004:l021","ordinal":136259,"en":"Your caravan-leader Bakai trembled,"},{"id":"semetey-1-2013:p0783:b004:l022","ordinal":136260,"en":"Thinking much of the old days;"},{"id":"semetey-1-2013:p0783:b004:l023","ordinal":136261,"en":"The poor man stood shaking."},{"id":"semetey-1-2013:p0783:b004:l024","ordinal":136262,"en":"“My dear orphan,"},{"id":"semetey-1-2013:p0783:b004:l025","ordinal":136263,"en":"Unseen by me for twelve years,"},{"id":"semetey-1-2013:p0783:b004:l026","ordinal":136264,"en":"The livestock left without an owner"},{"id":"semetey-1-2013:p0783:b004:l027","ordinal":136265,"en":"Appear before my eyes like a vision."},{"id":"semetey-1-2013:p0783:b004:l028","ordinal":136266,"en":"This accursed, empty world"},{"id":"semetey-1-2013:p0783:b004:l029","ordinal":136267,"en":"Seems to deal with us like this."},{"id":"semetey-1-2013:p0783:b004:l030","ordinal":136268,"en":"Those precious herds upon the hills,"},{"id":"semetey-1-2013:p0783:b004:l031","ordinal":136269,"en":"Their stallion descended from Kambar Ata,"},{"id":"semetey-1-2013:p0783:b004:l033","ordinal":136270,"en":"To tell you of the old days,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0783:b004:l034","ordinal":136271,"en":"They were Manas's livestock."},{"id":"semetey-1-2013:p0783:b004:l035","ordinal":136272,"en":"To tell you of today,"},{"id":"semetey-1-2013:p0783:b004:l036","ordinal":136273,"en":"Abyke and Köbösh, those six scoundrels,"},{"id":"semetey-1-2013:p0783:b005:l001","ordinal":136274,"en":"Caught Manas's Kambar Ata stallion"},{"id":"semetey-1-2013:p0783:b005:l002","ordinal":136275,"en":"And slaughtered him for winter meat."},{"id":"semetey-1-2013:p0783:b005:l005","ordinal":136276,"en":"They butchered the fleet-footed steed.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0783:b005:l006","ordinal":136277,"en":"Those precious beasts resembling Buurul,"},{"id":"semetey-1-2013:p0783:b005:l008","ordinal":136278,"en":"With fine tails and fine manes,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0783:b005:l009","ordinal":136279,"en":"Such were those precious herds."},{"id":"semetey-1-2013:p0783:b005:l012","ordinal":136280,"en":"Abyke and Köbösh became their owners,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0783:b005:l013","ordinal":136281,"en":"And the wealth has dwindled away.”"},{"id":"semetey-1-2013:p0783:b005:l014","ordinal":136282,"en":"So Khan Bakai lamented."},{"id":"semetey-1-2013:p0783:b005:l015","ordinal":136283,"en":"To a saddle-shaped mountain pass"},{"id":"semetey-1-2013:p0783:b005:l016","ordinal":136284,"en":"Brave Semetey and Khan Bakai"},{"id":"semetey-1-2013:p0783:b005:l017","ordinal":136285,"en":"Now climbed."},{"id":"semetey-1-2013:p0783:b005:l018","ordinal":136286,"en":"When he looked north,"},{"id":"semetey-1-2013:p0783:b005:l019","ordinal":136287,"en":"Dust rose in billowing clouds."},{"id":"semetey-1-2013:p0783:b005:l020","ordinal":136288,"en":"When he saw the billowing dust,"},{"id":"semetey-1-2013:p0783:b005:l021","ordinal":136289,"en":"Khan Bakai nearly lost his soul."},{"id":"semetey-1-2013:p0783:b005:l022","ordinal":136290,"en":"He turned Kökcholok's head:"},{"id":"semetey-1-2013:p0783:b005:l023","ordinal":136291,"en":"“My orphan!” he called,"},{"id":"semetey-1-2013:p0783:b005:l024","ordinal":136292,"en":"Shouting, “Come here!”"},{"id":"semetey-1-2013:p0783:b005:l025","ordinal":136293,"en":"Valiant Bakai stood there."},{"id":"semetey-1-2013:p0783:b005:l026","ordinal":136294,"en":"He cried, “Baabedin!”"},{"id":"semetey-1-2013:p0783:b005:l027","ordinal":136295,"en":"And called for Semetey:"},{"id":"semetey-1-2013:p0783:b005:l028","ordinal":136296,"en":"“My dear Semetey,"},{"id":"semetey-1-2013:p0783:b005:l029","ordinal":136297,"en":"My comfort left by my Khan Manas,"},{"id":"semetey-1-2013:p0783:b005:l030","ordinal":136298,"en":"Whom I have seen at my death,"},{"id":"semetey-1-2013:p0783:b005:l031","ordinal":136299,"en":"Have you seen what I have seen?"},{"id":"semetey-1-2013:p0783:b005:l032","ordinal":136300,"en":"Have you sensed what I have sensed?"},{"id":"semetey-1-2013:p0783:b005:l033","ordinal":136301,"en":"Have you understood what I have understood?"},{"id":"semetey-1-2013:p0783:b005:l034","ordinal":136302,"en":"Today your elder Bakai's"},{"id":"semetey-1-2013:p0783:b005:l035","ordinal":136303,"en":"Rib bones tremble,"},{"id":"semetey-1-2013:p0783:b005:l036","ordinal":136304,"en":"His living heart quakes."},{"id":"semetey-1-2013:p0784:b003:l001","ordinal":136305,"en":"Today your elder, Khan Bakai,"},{"id":"semetey-1-2013:p0784:b003:l002","ordinal":136306,"en":"Wakes startled from sleep,"},{"id":"semetey-1-2013:p0784:b003:l003","ordinal":136307,"en":"Turns onto his right side,"},{"id":"semetey-1-2013:p0784:b003:l004","ordinal":136308,"en":"Dips his hands in water,"},{"id":"semetey-1-2013:p0784:b003:l005","ordinal":136309,"en":"And performs his ablution."},{"id":"semetey-1-2013:p0784:b003:l006","ordinal":136310,"en":"He pleads with the one God,"},{"id":"semetey-1-2013:p0784:b003:l007","ordinal":136311,"en":"Hastens to say his prayer,"},{"id":"semetey-1-2013:p0784:b003:l008","ordinal":136312,"en":"And saddles Kökcholok."},{"id":"semetey-1-2013:p0784:b003:l009","ordinal":136313,"en":"This very day your elder"},{"id":"semetey-1-2013:p0784:b003:l010","ordinal":136314,"en":"Will see a night of calamity"},{"id":"semetey-1-2013:p0784:b003:l011","ordinal":136315,"en":"Or a day upon which light shines."},{"id":"semetey-1-2013:p0784:b003:l012","ordinal":136316,"en":"Today your elder Bakai"},{"id":"semetey-1-2013:p0784:b003:l013","ordinal":136317,"en":"Will either meet death and die,"},{"id":"semetey-1-2013:p0784:b003:l014","ordinal":136318,"en":"And see the face of Judgment,"},{"id":"semetey-1-2013:p0784:b003:l015","ordinal":136319,"en":"Or else Khan Bakai"},{"id":"semetey-1-2013:p0784:b003:l016","ordinal":136320,"en":"Will see the delights of the world."},{"id":"semetey-1-2013:p0784:b003:l017","ordinal":136321,"en":"Since the mighty Manas died,"},{"id":"semetey-1-2013:p0784:b003:l018","ordinal":136322,"en":"Twelve full years have passed."},{"id":"semetey-1-2013:p0784:b003:l019","ordinal":136323,"en":"The forlorn remnant that fled"},{"id":"semetey-1-2013:p0784:b003:l020","ordinal":136324,"en":"Seems to have returned this year."},{"id":"semetey-1-2013:p0784:b003:l021","ordinal":136325,"en":"This elder Bakai of yours may die;"},{"id":"semetey-1-2013:p0784:b003:l022","ordinal":136326,"en":"If your elder Bakai does not die,"},{"id":"semetey-1-2013:p0784:b003:l023","ordinal":136327,"en":"He will witness a marvel."},{"id":"semetey-1-2013:p0784:b003:l024","ordinal":136328,"en":"Oh, my dear orphan,"},{"id":"semetey-1-2013:p0784:b003:l025","ordinal":136329,"en":"Have you seen the billowing dust?"},{"id":"semetey-1-2013:p0784:b003:l026","ordinal":136330,"en":"Have you understood that billowing dust?"},{"id":"semetey-1-2013:p0784:b003:l027","ordinal":136331,"en":"When I look ahead of the dust,"},{"id":"semetey-1-2013:p0784:b003:l028","ordinal":136332,"en":"My heart grows tender and troubled:"},{"id":"semetey-1-2013:p0784:b003:l029","ordinal":136333,"en":"Your horse Narbuurul comes into view."},{"id":"semetey-1-2013:p0784:b003:l030","ordinal":136334,"en":"When leopard Manas died,"},{"id":"semetey-1-2013:p0784:b003:l031","ordinal":136335,"en":"When the bereft one knew grief,"},{"id":"semetey-1-2013:p0784:b003:l032","ordinal":136336,"en":"Mourning and wailing,"},{"id":"semetey-1-2013:p0784:b003:l033","ordinal":136337,"en":"Crying loudly in torment,"},{"id":"semetey-1-2013:p0784:b003:l034","ordinal":136338,"en":"Neighing and pawing the ground,"},{"id":"semetey-1-2013:p0784:b003:l035","ordinal":136339,"en":"Though an animal, that living creature,"},{"id":"semetey-1-2013:p0784:b003:l036","ordinal":136340,"en":"His tail and mane disheveled,"},{"id":"semetey-1-2013:p0784:b003:l037","ordinal":136341,"en":"The tears pouring from his eyes,"},{"id":"semetey-1-2013:p0784:b003:l038","ordinal":136342,"en":"Roamed the mountaintops,"},{"id":"semetey-1-2013:p0784:b003:l039","ordinal":136343,"en":"Wandered among the sacred graves."},{"id":"semetey-1-2013:p0784:b004:l001","ordinal":136344,"en":"Unknown to any person,"},{"id":"semetey-1-2013:p0784:b004:l002","ordinal":136345,"en":"Unseen by anyone,"},{"id":"semetey-1-2013:p0784:b004:l003","ordinal":136346,"en":"Leading eighty swift horses,"},{"id":"semetey-1-2013:p0784:b004:l004","ordinal":136347,"en":"Narbuudan vanished."},{"id":"semetey-1-2013:p0784:b004:l005","ordinal":136348,"en":"In this manner Narbuudan"},{"id":"semetey-1-2013:p0784:b004:l006","ordinal":136349,"en":"Attained his desire."},{"id":"semetey-1-2013:p0784:b004:l007","ordinal":136350,"en":"Vanishing from sight,"},{"id":"semetey-1-2013:p0784:b004:l008","ordinal":136351,"en":"Narbuudan went away."},{"id":"semetey-1-2013:p0784:b004:l009","ordinal":136352,"en":"He drove away any foal that came,"},{"id":"semetey-1-2013:p0784:b004:l010","ordinal":136353,"en":"Sought ridges covered in fescue,"},{"id":"semetey-1-2013:p0784:b004:l011","ordinal":136354,"en":"Sought places no mortal could travel."},{"id":"semetey-1-2013:p0784:b004:l012","ordinal":136355,"en":"In the hottest days of summer"},{"id":"semetey-1-2013:p0784:b004:l013","ordinal":136356,"en":"He stayed on the mountaintops,"},{"id":"semetey-1-2013:p0784:b004:l014","ordinal":136357,"en":"Grazed at Toguz-Döbö."},{"id":"semetey-1-2013:p0784:b004:l015","ordinal":136358,"en":"As autumn approached,"},{"id":"semetey-1-2013:p0784:b004:l016","ordinal":136359,"en":"When the grass reached its full strength,"},{"id":"semetey-1-2013:p0784:b004:l017","ordinal":136360,"en":"When the supple grass ripened,"},{"id":"semetey-1-2013:p0784:b004:l018","ordinal":136361,"en":"When autumn gossamer flew,"},{"id":"semetey-1-2013:p0784:b004:l019","ordinal":136362,"en":"The splendid steed Narbuurul"},{"id":"semetey-1-2013:p0784:b004:l020","ordinal":136363,"en":"Stayed at Jyltyrgan,"},{"id":"semetey-1-2013:p0784:b004:l021","ordinal":136364,"en":"And grazed on tumbleweed."},{"id":"semetey-1-2013:p0784:b004:l022","ordinal":136365,"en":"As winter approached,"},{"id":"semetey-1-2013:p0784:b004:l023","ordinal":136366,"en":"When the ground froze hard,"},{"id":"semetey-1-2013:p0784:b004:l024","ordinal":136367,"en":"When springs bubbled and ice froze,"},{"id":"semetey-1-2013:p0784:b004:l026","ordinal":136368,"en":"When bitterly cold winds blew,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0784:b004:l027","ordinal":136369,"en":"When the deep winter creaked with frost,"},{"id":"semetey-1-2013:p0784:b004:l028","ordinal":136370,"en":"When the cold reached its cracking height,"},{"id":"semetey-1-2013:p0784:b004:l029","ordinal":136371,"en":"He stayed upon the open plains,"},{"id":"semetey-1-2013:p0784:b004:l030","ordinal":136372,"en":"And grazed on fescue."},{"id":"semetey-1-2013:p0784:b004:l031","ordinal":136373,"en":"At the sight of a figure he darted away."},{"id":"semetey-1-2013:p0784:b004:l032","ordinal":136374,"en":"He must have known you would come this year;"},{"id":"semetey-1-2013:p0784:b004:l033","ordinal":136375,"en":"To Suurma-Kök in Suusamyr,"},{"id":"semetey-1-2013:p0784:b004:l034","ordinal":136376,"en":"To Suurma-Kök he has come."},{"id":"semetey-1-2013:p0784:b004:l036","ordinal":136377,"en":"He had been wandering in distress,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0784:b004:l037","ordinal":136378,"en":"Saying, ‘My protector, the orphan, will come,’"},{"id":"semetey-1-2013:p0784:b004:l038","ordinal":136379,"en":"He had been waiting to meet you."},{"id":"semetey-1-2013:p0784:b004:l039","ordinal":136380,"en":"If you would ride, that is the horse;"},{"id":"semetey-1-2013:p0785:b003:l001","ordinal":136381,"en":"High-backed, yet low in stature,"},{"id":"semetey-1-2013:p0785:b003:l002","ordinal":136382,"en":"A dark Karabair, a battle steed,"},{"id":"semetey-1-2013:p0785:b003:l003","ordinal":136383,"en":"With sieve-like lungs and copper forelegs."},{"id":"semetey-1-2013:p0785:b003:l004","ordinal":136384,"en":"The space between his hind thighs like a ravine,"},{"id":"semetey-1-2013:p0785:b003:l006","ordinal":136385,"en":"Like tempered steel,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0785:b003:l008","ordinal":136386,"en":"Though he traveled six months without rest,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0785:b003:l009","ordinal":136387,"en":"His back and head would not grow sore."},{"id":"semetey-1-2013:p0785:b003:l010","ordinal":136388,"en":"He did not panic at a battle cry;"},{"id":"semetey-1-2013:p0785:b003:l011","ordinal":136389,"en":"In the moon's darkness"},{"id":"semetey-1-2013:p0785:b003:l012","ordinal":136390,"en":"He never misplaced a step."},{"id":"semetey-1-2013:p0785:b003:l013","ordinal":136391,"en":"Alas, while your father was alive,"},{"id":"semetey-1-2013:p0785:b003:l014","ordinal":136392,"en":"He had deer drag his lead-rope."},{"id":"semetey-1-2013:p0785:b003:l016","ordinal":136393,"en":"Wherever the ground was rough and hilly,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0785:b003:l017","ordinal":136394,"en":"He took him there to train him."},{"id":"semetey-1-2013:p0785:b003:l018","ordinal":136395,"en":"He never panicked in the tumult;"},{"id":"semetey-1-2013:p0785:b003:l020","ordinal":136396,"en":"In the moon's darkness","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0785:b003:l021","ordinal":136397,"en":"He never set a foot wrong."},{"id":"semetey-1-2013:p0785:b003:l022","ordinal":136398,"en":"Camel-forelocked, short-maned,"},{"id":"semetey-1-2013:p0785:b003:l023","ordinal":136399,"en":"A deep-ribbed battle steed."},{"id":"semetey-1-2013:p0785:b003:l024","ordinal":136400,"en":"No wild ass he chased could escape;"},{"id":"semetey-1-2013:p0785:b003:l025","ordinal":136401,"en":"No overgrown frog within his hoof,"},{"id":"semetey-1-2013:p0785:b003:l026","ordinal":136402,"en":"A true noble steed, that creature."},{"id":"semetey-1-2013:p0785:b003:l027","ordinal":136403,"en":"Far above Algara,"},{"id":"semetey-1-2013:p0785:b003:l028","ordinal":136404,"en":"Far above Akkula,"},{"id":"semetey-1-2013:p0785:b003:l029","ordinal":136405,"en":"Much higher than Kuukazyk,"},{"id":"semetey-1-2013:p0785:b003:l030","ordinal":136406,"en":"Higher still than Maaniker,"},{"id":"semetey-1-2013:p0785:b003:l031","ordinal":136407,"en":"Far above Chalkuiruk."},{"id":"semetey-1-2013:p0785:b003:l032","ordinal":136408,"en":"If you reach him and ride, my orphan,"},{"id":"semetey-1-2013:p0785:b003:l033","ordinal":136409,"en":"That is a thoroughly swift horse."},{"id":"semetey-1-2013:p0785:b003:l034","ordinal":136410,"en":"A cloud cannot be caught in the sky;"},{"id":"semetey-1-2013:p0785:b003:l035","ordinal":136411,"en":"No four-footed creature"},{"id":"semetey-1-2013:p0785:b003:l036","ordinal":136412,"en":"Can flee and escape him."},{"id":"semetey-1-2013:p0785:b003:l037","ordinal":136413,"en":"If you ride him, he is well-tried,"},{"id":"semetey-1-2013:p0785:b003:l038","ordinal":136414,"en":"A support left by your father Manas;"},{"id":"semetey-1-2013:p0785:b003:l039","ordinal":136415,"en":"The sight of him moves the heart."},{"id":"semetey-1-2013:p0785:b005:l001","ordinal":136416,"en":"That creature, Buurul,"},{"id":"semetey-1-2013:p0785:b005:l002","ordinal":136417,"en":"Seems to have come out to meet you."},{"id":"semetey-1-2013:p0785:b005:l003","ordinal":136418,"en":"‘Twelve years have passed,’ he says,"},{"id":"semetey-1-2013:p0785:b005:l004","ordinal":136419,"en":"‘This year my dear companion will ride me to war;"},{"id":"semetey-1-2013:p0785:b005:l005","ordinal":136420,"en":"It is time for him to come,’ he says,"},{"id":"semetey-1-2013:p0785:b005:l006","ordinal":136421,"en":"And has been waiting to meet you."},{"id":"semetey-1-2013:p0785:b005:l007","ordinal":136422,"en":"Before the boy,"},{"id":"semetey-1-2013:p0785:b005:l008","ordinal":136423,"en":"The red-roan, short-maned horse,"},{"id":"semetey-1-2013:p0785:b005:l009","ordinal":136424,"en":"The precious steed Narbuurul,"},{"id":"semetey-1-2013:p0785:b005:l010","ordinal":136425,"en":"Flung his forelock toward the sky;"},{"id":"semetey-1-2013:p0785:b005:l011","ordinal":136426,"en":"The crust of the dark earth"},{"id":"semetey-1-2013:p0785:b005:l012","ordinal":136427,"en":"He pawed and tossed away."},{"id":"semetey-1-2013:p0785:b005:l013","ordinal":136428,"en":"His tail and mane disheveled,"},{"id":"semetey-1-2013:p0785:b005:l014","ordinal":136429,"en":"Tears pouring from his eyes,"},{"id":"semetey-1-2013:p0785:b005:l015","ordinal":136430,"en":"He had no tongue to speak."},{"id":"semetey-1-2013:p0785:b005:l016","ordinal":136431,"en":"Though an animal, the horse Buurul"},{"id":"semetey-1-2013:p0785:b005:l017","ordinal":136432,"en":"Neighed and trembled,"},{"id":"semetey-1-2013:p0785:b005:l018","ordinal":136433,"en":"Drew in his belly and shook."},{"id":"semetey-1-2013:p0785:b005:l019","ordinal":136434,"en":"His ears stood like candles,"},{"id":"semetey-1-2013:p0785:b005:l020","ordinal":136435,"en":"Tears poured from his eyes."},{"id":"semetey-1-2013:p0785:b005:l021","ordinal":136436,"en":"His father, who had died long ago,"},{"id":"semetey-1-2013:p0785:b005:l022","ordinal":136437,"en":"Appeared before him like a vision."},{"id":"semetey-1-2013:p0785:b005:l024","ordinal":136438,"en":"Your orphan, the son of Manas,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0785:b005:l026","ordinal":136439,"en":"Wept, ‘My mighty father!’","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0785:b005:l027","ordinal":136440,"en":"And raised a wailing cry."},{"id":"semetey-1-2013:p0785:b005:l028","ordinal":136441,"en":"When he saw the horse Buurul,"},{"id":"semetey-1-2013:p0785:b005:l029","ordinal":136442,"en":"‘My fleet-footed father, do not die!’"},{"id":"semetey-1-2013:p0785:b005:l030","ordinal":136443,"en":"Your boy sobbed in bitter grief."},{"id":"semetey-1-2013:p0785:b005:l031","ordinal":136444,"en":"‘When my fleet-footed father died,"},{"id":"semetey-1-2013:p0785:b005:l032","ordinal":136445,"en":"This animal kept mourning."},{"id":"semetey-1-2013:p0785:b005:l033","ordinal":136446,"en":"Yet I, a human, poor wretch,"},{"id":"semetey-1-2013:p0785:b005:l034","ordinal":136447,"en":"To Temirkan's city"},{"id":"semetey-1-2013:p0785:b005:l035","ordinal":136448,"en":"Wandered away in disgrace."}]
