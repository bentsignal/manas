[{"id":"manas-2010:p1013:b001:l013","ordinal":44289,"en":"Chubak is no less than Manas."},{"id":"manas-2010:p1013:b001:l014","ordinal":44290,"en":"Dark-hollowed, ridged of back,"},{"id":"manas-2010:p1013:b001:l015","ordinal":44291,"en":"Well-shaped, broad of shoulder,"},{"id":"manas-2010:p1013:b001:l016","ordinal":44292,"en":"Stooping in stature, wide at the shoulders,"},{"id":"manas-2010:p1013:b001:l017","ordinal":44293,"en":"His breast and back equally matched."},{"id":"manas-2010:p1013:b001:l018","ordinal":44294,"en":"Poised like an arrow-snake,"},{"id":"manas-2010:p1013:b001:l019","ordinal":44295,"en":"Round-bodied beyond other men,"},{"id":"manas-2010:p1013:b001:l020","ordinal":44296,"en":"The foe he charged was destroyed."},{"id":"manas-2010:p1013:b001:l021","ordinal":44297,"en":"‘If Beijing has been granted,"},{"id":"manas-2010:p1013:b001:l022","ordinal":44298,"en":"I shall ask for five of its gates."},{"id":"manas-2010:p1013:b001:l023","ordinal":44299,"en":"If he will not give me the scouting,"},{"id":"manas-2010:p1013:b001:l024","ordinal":44300,"en":"Almambet who poses as a champion,"},{"id":"manas-2010:p1013:b001:l025","ordinal":44301,"en":"I shall spill his blood upon a ridge!"},{"id":"manas-2010:p1013:b001:l026","ordinal":44302,"en":"If he will not give me the scouting,"},{"id":"manas-2010:p1013:b001:l027","ordinal":44303,"en":"I shall tear his ribs apart!"},{"id":"manas-2010:p1013:b001:l028","ordinal":44304,"en":"Without turning back to the army,"},{"id":"manas-2010:p1013:b001:l029","ordinal":44305,"en":"I shall charge into Beijing,"},{"id":"manas-2010:p1013:b001:l030","ordinal":44306,"en":"Drive them as far as Kanggay."},{"id":"manas-2010:p1013:b001:l031","ordinal":44307,"en":"Beginning with Almambet,"},{"id":"manas-2010:p1013:b001:l032","ordinal":44308,"en":"I shall slaughter the Chinese and return!’"},{"id":"manas-2010:p1013:b001:l033","ordinal":44309,"en":"Without turning Kögala's mouth,"},{"id":"manas-2010:p1013:b001:l034","ordinal":44310,"en":"Without stopping long,"},{"id":"manas-2010:p1013:b001:l035","ordinal":44311,"en":"Putting grass upon his very tracks,"},{"id":"manas-2010:p1013:b001:l036","ordinal":44312,"en":"He pursued your Alma relentlessly."},{"id":"manas-2010:p1013:b001:l037","ordinal":44313,"en":"Wearing a gray lynx-fur cap,"},{"id":"manas-2010:p1013:b001:l038","ordinal":44314,"en":"Lifting and swinging his shield,"},{"id":"manas-2010:p1013:b001:l039","ordinal":44315,"en":"Khan Bakay, born to royalty,"},{"id":"manas-2010:p1013:b001:l040","ordinal":44316,"en":"Whose mouth was rinsed with honey,"},{"id":"manas-2010:p1013:b001:l041","ordinal":44317,"en":"Who found a road in darkness,"},{"id":"manas-2010:p1013:b001:l042","ordinal":44318,"en":"Who found words at an unforeseen moment,"},{"id":"manas-2010:p1014:b001:l001","ordinal":44319,"en":"Stars stirred in the sky."},{"id":"manas-2010:p1014:b001:l002","ordinal":44320,"en":"Manas and warrior Bakay,"},{"id":"manas-2010:p1014:b001:l003","ordinal":44321,"en":"Friends for the world beyond,"},{"id":"manas-2010:p1014:b001:l004","ordinal":44322,"en":"Chubak who had ridden away—"},{"id":"manas-2010:p1014:b001:l005","ordinal":44323,"en":"Bakay could find no way to handle him."},{"id":"manas-2010:p1014:b001:l006","ordinal":44324,"en":"Inside the golden tent,"},{"id":"manas-2010:p1014:b001:l007","ordinal":44325,"en":"To mighty ruler Manas,"},{"id":"manas-2010:p1014:b001:l008","ordinal":44326,"en":"Warrior Bakay walked in."},{"id":"manas-2010:p1014:b001:l009","ordinal":44327,"en":"‘What shall I do about Chubak?’ he said;"},{"id":"manas-2010:p1014:b001:l010","ordinal":44328,"en":"Warrior Bakay hurried in."},{"id":"manas-2010:p1014:b001:l011","ordinal":44329,"en":"‘The twelve khans' great army,"},{"id":"manas-2010:p1014:b001:l012","ordinal":44330,"en":"Have you seen it raise its standard, Manas?"},{"id":"manas-2010:p1014:b001:l013","ordinal":44331,"en":"Khan Baltay's Chubak,"},{"id":"manas-2010:p1014:b001:l014","ordinal":44332,"en":"That reckless blue-maned leopard,"},{"id":"manas-2010:p1014:b001:l015","ordinal":44333,"en":"Have you seen him raise an uproar, Manas?"},{"id":"manas-2010:p1014:b001:l016","ordinal":44334,"en":"They care nothing if a lake is shaken."},{"id":"manas-2010:p1014:b001:l017","ordinal":44335,"en":"Almambet and Chubak, two lions,"},{"id":"manas-2010:p1014:b001:l018","ordinal":44336,"en":"Anyone but you, Manas,"},{"id":"manas-2010:p1014:b001:l019","ordinal":44337,"en":"They do not reckon equal to their hoof."},{"id":"manas-2010:p1014:b001:l020","ordinal":44338,"en":"Go after them,"},{"id":"manas-2010:p1014:b001:l021","ordinal":44339,"en":"Speak your wise words and return;"},{"id":"manas-2010:p1014:b001:l022","ordinal":44340,"en":"Reconcile them and come back."},{"id":"manas-2010:p1014:b001:l023","ordinal":44341,"en":"Let neither reach the other."},{"id":"manas-2010:p1014:b001:l024","ordinal":44342,"en":"Lest the two lions needlessly,"},{"id":"manas-2010:p1014:b001:l025","ordinal":44343,"en":"In empty wilderness, with no people,"},{"id":"manas-2010:p1014:b001:l026","ordinal":44344,"en":"With no flood at their backs,"},{"id":"manas-2010:p1014:b001:l027","ordinal":44345,"en":"Should suddenly die!"},{"id":"manas-2010:p1014:b001:l028","ordinal":44346,"en":"Making a gray one from the white horses,"},{"id":"manas-2010:p1014:b001:l029","ordinal":44347,"en":"The two blue-maned lion warriors,"},{"id":"manas-2010:p1014:b001:l030","ordinal":44348,"en":"Make them friends for the hereafter."},{"id":"manas-2010:p1014:b001:l031","ordinal":44349,"en":"Have them lick the sword's edge,"},{"id":"manas-2010:p1014:b001:l032","ordinal":44350,"en":"Have them face toward Mecca,"},{"id":"manas-2010:p1014:b001:l033","ordinal":44351,"en":"Make an oath upon their lives."},{"id":"manas-2010:p1014:b001:l034","ordinal":44352,"en":"Go yourself and return!’"},{"id":"manas-2010:p1014:b001:l035","ordinal":44353,"en":"When Manas heard this,"},{"id":"manas-2010:p1014:b001:l036","ordinal":44354,"en":"When the sun had risen high,"},{"id":"manas-2010:p1014:b001:l037","ordinal":44355,"en":"He had Aybanboz saddled."},{"id":"manas-2010:p1014:b001:l038","ordinal":44356,"en":"Your lion-born Manas,"},{"id":"manas-2010:p1014:b001:l039","ordinal":44357,"en":"After the two lions,"},{"id":"manas-2010:p1014:b001:l040","ordinal":44358,"en":"Set off with his mount surging."},{"id":"manas-2010:p1014:b001:l041","ordinal":44359,"en":"Almambet, who had fallen asleep,"},{"id":"manas-2010:p1014:b001:l042","ordinal":44360,"en":"Awoke with a start,"},{"id":"manas-2010:p1015:b001:l001","ordinal":44361,"en":"Coiled like an arrow-snake,"},{"id":"manas-2010:p1015:b001:l002","ordinal":44362,"en":"Put on his ammunition and gear,"},{"id":"manas-2010:p1015:b001:l003","ordinal":44363,"en":"Made ready Sarala,"},{"id":"manas-2010:p1015:b001:l004","ordinal":44364,"en":"As though to tie his great forelock,"},{"id":"manas-2010:p1015:b001:l005","ordinal":44365,"en":"Into distant Beijing"},{"id":"manas-2010:p1015:b001:l006","ordinal":44366,"en":"As though to charge alone,"},{"id":"manas-2010:p1015:b001:l007","ordinal":44367,"en":"Mounted his horse and sat straight,"},{"id":"manas-2010:p1015:b001:l008","ordinal":44368,"en":"Cried like a white falcon:"},{"id":"manas-2010:p1015:b001:l009","ordinal":44369,"en":"‘Lion Syrgak, get up!’ he said,"},{"id":"manas-2010:p1015:b001:l010","ordinal":44370,"en":"Shouting from horseback."},{"id":"manas-2010:p1015:b001:l011","ordinal":44371,"en":"Syrgak rose alert,"},{"id":"manas-2010:p1015:b001:l012","ordinal":44372,"en":"Like one going out to fight a foe,"},{"id":"manas-2010:p1015:b001:l013","ordinal":44373,"en":"Readied all his equipment."},{"id":"manas-2010:p1015:b001:l014","ordinal":44374,"en":"Roaring in wrath,"},{"id":"manas-2010:p1015:b001:l015","ordinal":44375,"en":"Almambet stood impatient:"},{"id":"manas-2010:p1015:b001:l016","ordinal":44376,"en":"‘Mount quickly, Syrgak!’ he said,"},{"id":"manas-2010:p1015:b001:l017","ordinal":44377,"en":"Calling again and again."},{"id":"manas-2010:p1015:b001:l018","ordinal":44378,"en":"When Syrgak mounted,"},{"id":"manas-2010:p1015:b001:l019","ordinal":44379,"en":"When he rode up to the lion,"},{"id":"manas-2010:p1015:b001:l020","ordinal":44380,"en":"When your Alma saw him,"},{"id":"manas-2010:p1015:b001:l021","ordinal":44381,"en":"Almambet, lion and leopard,"},{"id":"manas-2010:p1015:b001:l022","ordinal":44382,"en":"Began speaking to Syrgak:"},{"id":"manas-2010:p1015:b001:l023","ordinal":44383,"en":"‘Have you seen what I have seen?"},{"id":"manas-2010:p1015:b001:l024","ordinal":44384,"en":"Have you known what I have known?"},{"id":"manas-2010:p1015:b001:l025","ordinal":44385,"en":"If you have not seen what I have seen,"},{"id":"manas-2010:p1015:b001:l026","ordinal":44386,"en":"If you have not known what I have known:"},{"id":"manas-2010:p1015:b001:l027","ordinal":44387,"en":"The moon dark, the night overcast,"},{"id":"manas-2010:p1015:b001:l028","ordinal":44388,"en":"God has struck the night."},{"id":"manas-2010:p1015:b001:l029","ordinal":44389,"en":"Not a handspan long, as I see it,"},{"id":"manas-2010:p1015:b001:l030","ordinal":44390,"en":"God has struck the day."},{"id":"manas-2010:p1015:b001:l031","ordinal":44391,"en":"Patchy cloud and sleet,"},{"id":"manas-2010:p1015:b001:l032","ordinal":44392,"en":"God has struck the gray."},{"id":"manas-2010:p1015:b001:l033","ordinal":44393,"en":"Who grew up with me from the very beginning,"},{"id":"manas-2010:p1015:b001:l034","ordinal":44394,"en":"Akbaltay's warrior Chubak,"},{"id":"manas-2010:p1015:b001:l035","ordinal":44395,"en":"God has struck my friend."},{"id":"manas-2010:p1015:b001:l036","ordinal":44396,"en":"He has brought suffering behind me."},{"id":"manas-2010:p1015:b001:l037","ordinal":44397,"en":"Looming tall upon Aybanboz,"},{"id":"manas-2010:p1015:b001:l038","ordinal":44398,"en":"Lion-born warrior Manas"},{"id":"manas-2010:p1015:b001:l039","ordinal":44399,"en":"Has set out behind, Syrgak!"},{"id":"manas-2010:p1015:b001:l040","ordinal":44400,"en":"As though his wife were struck by an evil spirit,"},{"id":"manas-2010:p1015:b001:l041","ordinal":44401,"en":"Khan Baltay's Chubak,"},{"id":"manas-2010:p1015:b001:l042","ordinal":44402,"en":"As though his quarry had just escaped,"},{"id":"manas-2010:p1016:b001:l001","ordinal":44403,"en":"Has become enraged."},{"id":"manas-2010:p1016:b001:l002","ordinal":44404,"en":"The steel meant to slaughter Chinese,"},{"id":"manas-2010:p1016:b001:l003","ordinal":44405,"en":"Drawing it from the sheath, gripping it firmly,"},{"id":"manas-2010:p1016:b001:l004","ordinal":44406,"en":"Your cruel Chubak,"},{"id":"manas-2010:p1016:b001:l005","ordinal":44407,"en":"Unless I lie, has left the faith."},{"id":"manas-2010:p1016:b001:l006","ordinal":44408,"en":"Let my words not be slander:"},{"id":"manas-2010:p1016:b001:l007","ordinal":44409,"en":"Blue-maned leopard warrior Chubak"},{"id":"manas-2010:p1016:b001:l008","ordinal":44410,"en":"Has gathered his strength."},{"id":"manas-2010:p1016:b001:l009","ordinal":44411,"en":"Unless I lie, Chubak the slave"},{"id":"manas-2010:p1016:b001:l010","ordinal":44412,"en":"Comes eating what should not be eaten."},{"id":"manas-2010:p1016:b001:l011","ordinal":44413,"en":"“Scouting the land alone without me,"},{"id":"manas-2010:p1016:b001:l012","ordinal":44414,"en":"An excited Chinese,” he comes saying."},{"id":"manas-2010:p1016:b001:l013","ordinal":44415,"en":"If in frenzy he keeps calling me Chinese,"},{"id":"manas-2010:p1016:b001:l014","ordinal":44416,"en":"If in conceit he keeps eating shit,"},{"id":"manas-2010:p1016:b001:l015","ordinal":44417,"en":"I shall insist and scout Beijing."},{"id":"manas-2010:p1016:b001:l016","ordinal":44418,"en":"From Chubak who comes like that,"},{"id":"manas-2010:p1016:b001:l017","ordinal":44419,"en":"How shall I remain alive, Syrgak?!"},{"id":"manas-2010:p1016:b001:l018","ordinal":44420,"en":"If his death-hour comes, he dies, Syrgak!"},{"id":"manas-2010:p1016:b001:l019","ordinal":44421,"en":"If it does not come, I die, Syrgak!"},{"id":"manas-2010:p1016:b001:l020","ordinal":44422,"en":"If I die at Chubak's hands,"},{"id":"manas-2010:p1016:b001:l021","ordinal":44423,"en":"At that death-seeking reckless pig's,"},{"id":"manas-2010:p1016:b001:l022","ordinal":44424,"en":"My iron support,"},{"id":"manas-2010:p1016:b001:l023","ordinal":44425,"en":"“Excitedly saying he would scout,"},{"id":"manas-2010:p1016:b001:l024","ordinal":44426,"en":"The swaggering Chinese slave"},{"id":"manas-2010:p1016:b001:l025","ordinal":44427,"en":"Died in the wilderness”—do not let them say it."},{"id":"manas-2010:p1016:b001:l026","ordinal":44428,"en":"If I should die at Chubak's hands,"},{"id":"manas-2010:p1016:b001:l027","ordinal":44429,"en":"My precious eyes like blackcurrants,"},{"id":"manas-2010:p1016:b001:l028","ordinal":44430,"en":"Let no croaking vulture gouge them out."},{"id":"manas-2010:p1016:b001:l029","ordinal":44431,"en":"My bright teeth, broad as shovels,"},{"id":"manas-2010:p1016:b001:l030","ordinal":44432,"en":"Let no magpie shit upon them."},{"id":"manas-2010:p1016:b001:l031","ordinal":44433,"en":"Let your elder Alma not become vulture shit."},{"id":"manas-2010:p1016:b001:l032","ordinal":44434,"en":"If I die at Chubak's hands,"},{"id":"manas-2010:p1016:b001:l033","ordinal":44435,"en":"Do not leave my bones in the wilderness."},{"id":"manas-2010:p1016:b001:l034","ordinal":44436,"en":"Grasp me at the waist and fold me over,"},{"id":"manas-2010:p1016:b001:l035","ordinal":44437,"en":"Load me upon Sarala."},{"id":"manas-2010:p1016:b001:l036","ordinal":44438,"en":"Cross the desert hills,"},{"id":"manas-2010:p1016:b001:l037","ordinal":44439,"en":"Pass over the level ridge."},{"id":"manas-2010:p1016:b001:l038","ordinal":44440,"en":"When you reach the place of tombs,"},{"id":"manas-2010:p1016:b001:l039","ordinal":44441,"en":"Slaughter Sarala."},{"id":"manas-2010:p1016:b001:l040","ordinal":44442,"en":"With your own hands, carefully,"},{"id":"manas-2010:p1016:b001:l041","ordinal":44443,"en":"Bury me in a marked place!"},{"id":"manas-2010:p1016:b001:l042","ordinal":44444,"en":"Saddle my horse properly:"},{"id":"manas-2010:p1017:b001:l001","ordinal":44445,"en":"“A renowned champion has died,” say,"},{"id":"manas-2010:p1017:b001:l002","ordinal":44446,"en":"Recite the Quran as my last request,"},{"id":"manas-2010:p1017:b001:l003","ordinal":44447,"en":"Turn back without going to Beijing."},{"id":"manas-2010:p1017:b001:l004","ordinal":44448,"en":"“Champion Alma has died,” say,"},{"id":"manas-2010:p1017:b001:l005","ordinal":44449,"en":"Tell your sister-in-law Aruuke!"},{"id":"manas-2010:p1017:b001:l006","ordinal":44450,"en":"Nine thousand horses in the mountains,"},{"id":"manas-2010:p1017:b001:l007","ordinal":44451,"en":"Warhorses and coursers mixed."},{"id":"manas-2010:p1017:b001:l008","ordinal":44452,"en":"Warhorses and coursers in great herds here,"},{"id":"manas-2010:p1017:b001:l009","ordinal":44453,"en":"In this hellish, false world,"},{"id":"manas-2010:p1017:b001:l010","ordinal":44454,"en":"I have no son behind me."},{"id":"manas-2010:p1017:b001:l011","ordinal":44455,"en":"What God has done, Syrgak,"},{"id":"manas-2010:p1017:b001:l012","ordinal":44456,"en":"I have no choice but to bear!"},{"id":"manas-2010:p1017:b001:l013","ordinal":44457,"en":"Faithless, wretched world,"},{"id":"manas-2010:p1017:b001:l014","ordinal":44458,"en":"When death comes, there is no remedy."},{"id":"manas-2010:p1017:b001:l015","ordinal":44459,"en":"To remain crying “Father,”"},{"id":"manas-2010:p1017:b001:l016","ordinal":44460,"en":"I have no son behind me!"},{"id":"manas-2010:p1017:b001:l017","ordinal":44461,"en":"Piebald-headed horses on the hills,"},{"id":"manas-2010:p1017:b001:l018","ordinal":44462,"en":"All are steeds without brains,"},{"id":"manas-2010:p1017:b001:l019","ordinal":44463,"en":"With no master to care for them."},{"id":"manas-2010:p1017:b001:l020","ordinal":44464,"en":"Becoming pure from the dark faith,"},{"id":"manas-2010:p1017:b001:l021","ordinal":44465,"en":"Since coming to the Muslims,"},{"id":"manas-2010:p1017:b001:l022","ordinal":44466,"en":"Elephants have carried my loads."},{"id":"manas-2010:p1017:b001:l023","ordinal":44467,"en":"How many years since I came?"},{"id":"manas-2010:p1017:b001:l024","ordinal":44468,"en":"Agynay's daughter Aruuke,"},{"id":"manas-2010:p1017:b001:l025","ordinal":44469,"en":"How many years since I took her?"},{"id":"manas-2010:p1017:b001:l026","ordinal":44470,"en":"She does not sway and comb her hair."},{"id":"manas-2010:p1017:b001:l027","ordinal":44471,"en":"In this withered, false world,"},{"id":"manas-2010:p1017:b001:l028","ordinal":44472,"en":"Her heels do not bleed."},{"id":"manas-2010:p1017:b001:l029","ordinal":44473,"en":"Such a day of sorrow has come!"},{"id":"manas-2010:p1017:b001:l030","ordinal":44474,"en":"Gather my horses from the mountains."},{"id":"manas-2010:p1017:b001:l031","ordinal":44475,"en":"If I die at Chubak's hands,"},{"id":"manas-2010:p1017:b001:l032","ordinal":44476,"en":"Who came together with me,"},{"id":"manas-2010:p1017:b001:l033","ordinal":44477,"en":"Aruuke, left in sorrow,"},{"id":"manas-2010:p1017:b001:l034","ordinal":44478,"en":"Marry her to Mazhik!’"},{"id":"manas-2010:p1017:b001:l035","ordinal":44479,"en":"As though pierced with a spear,"},{"id":"manas-2010:p1017:b001:l036","ordinal":44480,"en":"Warrior Syrgak sprang up."},{"id":"manas-2010:p1017:b001:l037","ordinal":44481,"en":"As though struck with a club,"},{"id":"manas-2010:p1017:b001:l038","ordinal":44482,"en":"Warrior Syrgak was startled."},{"id":"manas-2010:p1017:b001:l039","ordinal":44483,"en":"‘Can any place equal Talas?"},{"id":"manas-2010:p1017:b001:l040","ordinal":44484,"en":"Is Chubak a greater warrior than you?"},{"id":"manas-2010:p1017:b001:l041","ordinal":44485,"en":"Elder Alma, who should hear these words of yours?"},{"id":"manas-2010:p1017:b001:l042","ordinal":44486,"en":"Let the deeply dug pit hear them,"},{"id":"manas-2010:p1018:b001:l001","ordinal":44487,"en":"Let the pitch-black night hear them,"},{"id":"manas-2010:p1018:b001:l002","ordinal":44488,"en":"Who else should hear them!"},{"id":"manas-2010:p1018:b001:l003","ordinal":44489,"en":"Elder, do not rage over Chubak,"},{"id":"manas-2010:p1018:b001:l004","ordinal":44490,"en":"Do not be distressed over Chubak."},{"id":"manas-2010:p1018:b001:l005","ordinal":44491,"en":"I know Chubak's story."},{"id":"manas-2010:p1018:b001:l006","ordinal":44492,"en":"When I sought it from the learned,"},{"id":"manas-2010:p1018:b001:l007","ordinal":44493,"en":"When I asked the wise:"},{"id":"manas-2010:p1018:b001:l008","ordinal":44494,"en":"There was a land called Alay,"},{"id":"manas-2010:p1018:b001:l009","ordinal":44495,"en":"There were the Noygut people."},{"id":"manas-2010:p1018:b001:l010","ordinal":44496,"en":"Among those Noygut,"},{"id":"manas-2010:p1018:b001:l011","ordinal":44497,"en":"There was a fine walled dwelling."},{"id":"manas-2010:p1018:b001:l012","ordinal":44498,"en":"Ruling the Noygut,"},{"id":"manas-2010:p1018:b001:l013","ordinal":44499,"en":"They had a khan, Akbaltay."},{"id":"manas-2010:p1018:b001:l014","ordinal":44500,"en":"He was a soul of sacred power,"},{"id":"manas-2010:p1018:b001:l015","ordinal":44501,"en":"He was eighty years old."},{"id":"manas-2010:p1018:b001:l016","ordinal":44502,"en":"He had married forty wives."},{"id":"manas-2010:p1018:b001:l017","ordinal":44503,"en":"The forty wives were barren;"},{"id":"manas-2010:p1018:b001:l018","ordinal":44504,"en":"Akbaltay had had no child."},{"id":"manas-2010:p1018:b001:l019","ordinal":44505,"en":"When the people moved uphill,"},{"id":"manas-2010:p1018:b001:l020","ordinal":44506,"en":"In summer, when grass blackens horses’ tongues,"},{"id":"manas-2010:p1018:b001:l022","ordinal":44507,"en":"Wrapped in ragged felt,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p1018:b001:l023","ordinal":44508,"en":"Tied to a camel's hump,"},{"id":"manas-2010:p1018:b001:l024","ordinal":44509,"en":"As dusk fell and the sun set,"},{"id":"manas-2010:p1018:b001:l025","ordinal":44510,"en":"He was a child they found."},{"id":"manas-2010:p1018:b001:l026","ordinal":44511,"en":"Hanging gold upon his neck,"},{"id":"manas-2010:p1018:b001:l027","ordinal":44512,"en":"Spending much of his livestock,"},{"id":"manas-2010:p1018:b001:l028","ordinal":44513,"en":"Having forty wives rear him,"},{"id":"manas-2010:p1018:b001:l029","ordinal":44514,"en":"Slaughtering ninety beasts for his feast,"},{"id":"manas-2010:p1018:b001:l030","ordinal":44515,"en":"Gathering a multitude of people,"},{"id":"manas-2010:p1018:b001:l031","ordinal":44516,"en":"Feeding the people at the feast,"},{"id":"manas-2010:p1018:b001:l032","ordinal":44517,"en":"Having him named Chubak,"},{"id":"manas-2010:p1018:b001:l033","ordinal":44518,"en":"He was a child they found."},{"id":"manas-2010:p1018:b001:l034","ordinal":44519,"en":"By divine decree, this Chubak"},{"id":"manas-2010:p1018:b001:l035","ordinal":44520,"en":"Was a child who had been found."},{"id":"manas-2010:p1018:b001:l036","ordinal":44521,"en":"I do not know whether it is true;"},{"id":"manas-2010:p1018:b001:l037","ordinal":44522,"en":"Some people tell the story:"},{"id":"manas-2010:p1018:b001:l038","ordinal":44523,"en":"“Chubak is the son of a saintly elder,"},{"id":"manas-2010:p1018:b001:l039","ordinal":44524,"en":"He is God's beloved servant."},{"id":"manas-2010:p1018:b001:l040","ordinal":44525,"en":"No man's strength can match him in wrestling,"},{"id":"manas-2010:p1018:b001:l041","ordinal":44526,"en":"No lion's tooth can pierce him."},{"id":"manas-2010:p1018:b001:l042","ordinal":44527,"en":"Khan Akbaltay's Chubak,” they say,"},{"id":"manas-2010:p1019:b001:l001","ordinal":44528,"en":"“When his anger truly rises,"},{"id":"manas-2010:p1019:b001:l002","ordinal":44529,"en":"He throws the world into turmoil,"},{"id":"manas-2010:p1019:b001:l003","ordinal":44530,"en":"An outstanding mighty, reckless fellow.”"},{"id":"manas-2010:p1019:b001:l004","ordinal":44531,"en":"Some people say this:"},{"id":"manas-2010:p1019:b001:l005","ordinal":44532,"en":"“A crooked one born to an unmarried girl,” they say."},{"id":"manas-2010:p1019:b001:l006","ordinal":44533,"en":"“Your Chubak always"},{"id":"manas-2010:p1019:b001:l007","ordinal":44534,"en":"Argues for crooked deeds,"},{"id":"manas-2010:p1019:b001:l008","ordinal":44535,"en":"One of those damned fellows,” they say."},{"id":"manas-2010:p1019:b001:l009","ordinal":44536,"en":"We shall press on and scout the road,"},{"id":"manas-2010:p1019:b001:l010","ordinal":44537,"en":"We shall journey to Beijing."},{"id":"manas-2010:p1019:b001:l011","ordinal":44538,"en":"When we journey to Beijing,"},{"id":"manas-2010:p1019:b001:l012","ordinal":44539,"en":"Giving no help at all,"},{"id":"manas-2010:p1019:b001:l013","ordinal":44540,"en":"Showing no companionship,"},{"id":"manas-2010:p1019:b001:l014","ordinal":44541,"en":"Joining the magnanimous one,"},{"id":"manas-2010:p1019:b001:l015","ordinal":44542,"en":"He will stay with the baggage train."},{"id":"manas-2010:p1019:b001:l016","ordinal":44543,"en":"Do not hurt yourself over Chubak,"},{"id":"manas-2010:p1019:b001:l017","ordinal":44544,"en":"Do not take offense over the reckless fellow.’"}]
