[{"id":"manas-2010:p0732:b001:l009","ordinal":32513,"en":"Spearing warriors on the downward slope,"},{"id":"manas-2010:p0732:b001:l010","ordinal":32514,"en":"Spearing many in a row,"},{"id":"manas-2010:p0732:b001:l011","ordinal":32515,"en":"Making his dun horse prance,"},{"id":"manas-2010:p0732:b001:l012","ordinal":32516,"en":"Galloping it this way and that,"},{"id":"manas-2010:p0732:b001:l013","ordinal":32517,"en":"Smashing everything he reached,"},{"id":"manas-2010:p0732:b001:l014","ordinal":32518,"en":"Your skilled Manas laid them low."},{"id":"manas-2010:p0732:b001:l015","ordinal":32519,"en":"Would heroes lie down without fighting?"},{"id":"manas-2010:p0732:b001:l016","ordinal":32520,"en":"‘We have lost it to the enemy!’ they said."},{"id":"manas-2010:p0732:b001:l017","ordinal":32521,"en":"From that day to this,"},{"id":"manas-2010:p0732:b001:l018","ordinal":32522,"en":"Its name became Aksy."},{"id":"manas-2010:p0732:b001:l019","ordinal":32523,"en":"If you look to the side,"},{"id":"manas-2010:p0732:b001:l020","ordinal":32524,"en":"Shrill cries and fierce cheering!"},{"id":"manas-2010:p0732:b001:l021","ordinal":32525,"en":"Khan Manas's forty wolves"},{"id":"manas-2010:p0732:b001:l022","ordinal":32526,"en":"Brought a mighty turmoil upon the Chinese."},{"id":"manas-2010:p0732:b001:l023","ordinal":32527,"en":"Among the forty champions,"},{"id":"manas-2010:p0732:b001:l024","ordinal":32528,"en":"Their elders with Kyrgyl at their head,"},{"id":"manas-2010:p0732:b001:l025","ordinal":32529,"en":"Suffering slaughter, sparing not their lives,"},{"id":"manas-2010:p0732:b001:l026","ordinal":32530,"en":"They all fought to the death."},{"id":"manas-2010:p0732:b001:l027","ordinal":32531,"en":"Measuring out the ground,"},{"id":"manas-2010:p0732:b001:l028","ordinal":32532,"en":"Such is the warrior's way,"},{"id":"manas-2010:p0732:b001:l029","ordinal":32533,"en":"They fought one against one."},{"id":"manas-2010:p0732:b001:l030","ordinal":32534,"en":"While your champions were there,"},{"id":"manas-2010:p0732:b001:l031","ordinal":32535,"en":"Such was their confrontation."},{"id":"manas-2010:p0732:b001:l032","ordinal":32536,"en":"Marking out the plain,"},{"id":"manas-2010:p0732:b001:l033","ordinal":32537,"en":"They entered the firm arena."},{"id":"manas-2010:p0732:b001:l034","ordinal":32538,"en":"Their opponents, one by one,"},{"id":"manas-2010:p0732:b001:l035","ordinal":32539,"en":"They felled with spears."},{"id":"manas-2010:p0732:b001:l036","ordinal":32540,"en":"Unable to endure the single combats,"},{"id":"manas-2010:p0732:b001:l037","ordinal":32541,"en":"With shrill cries and fierce cheering,"},{"id":"manas-2010:p0732:b001:l038","ordinal":32542,"en":"They now began a general melee."},{"id":"manas-2010:p0732:b001:l039","ordinal":32543,"en":"Khan Manas, Bakay and Azhybay,"},{"id":"manas-2010:p0732:b001:l040","ordinal":32544,"en":"Alöökö's great army"},{"id":"manas-2010:p0732:b001:l041","ordinal":32545,"en":"Now swept over them."},{"id":"manas-2010:p0732:b001:l042","ordinal":32546,"en":"God, never let us see such a sight,"},{"id":"manas-2010:p0733:b001:l001","ordinal":32547,"en":"As though the gorge itself were moving,"},{"id":"manas-2010:p0733:b001:l002","ordinal":32548,"en":"Spears tapped against breasts,"},{"id":"manas-2010:p0733:b001:l003","ordinal":32549,"en":"Battle-axes clattered on heads,"},{"id":"manas-2010:p0733:b001:l004","ordinal":32550,"en":"Standards swayed in hands,"},{"id":"manas-2010:p0733:b001:l005","ordinal":32551,"en":"Swords flashed above heads."},{"id":"manas-2010:p0733:b001:l006","ordinal":32552,"en":"When they entered the melee,"},{"id":"manas-2010:p0733:b001:l007","ordinal":32553,"en":"When open battle raged,"},{"id":"manas-2010:p0733:b001:l008","ordinal":32554,"en":"Warriors struck by spears"},{"id":"manas-2010:p0733:b001:l009","ordinal":32555,"en":"Drew aside, exhausted."},{"id":"manas-2010:p0733:b001:l010","ordinal":32556,"en":"Those who did not flee"},{"id":"manas-2010:p0733:b001:l011","ordinal":32557,"en":"Pinned the fleeing ones with spears."},{"id":"manas-2010:p0733:b001:l012","ordinal":32558,"en":"Nothing could be caught by the eye;"},{"id":"manas-2010:p0733:b001:l013","ordinal":32559,"en":"The broad plain of Kum-Aryk,"},{"id":"manas-2010:p0733:b001:l014","ordinal":32560,"en":"No one could tell where it was."},{"id":"manas-2010:p0733:b001:l015","ordinal":32561,"en":"Earth flew, dust covered all;"},{"id":"manas-2010:p0733:b001:l016","ordinal":32562,"en":"All the wondrous steeds"},{"id":"manas-2010:p0733:b001:l017","ordinal":32563,"en":"Leant into the dust that wrapped them."},{"id":"manas-2010:p0733:b001:l018","ordinal":32564,"en":"Such was the manner of the battle."},{"id":"manas-2010:p0733:b001:l019","ordinal":32565,"en":"The heads of the wondrous steeds"},{"id":"manas-2010:p0733:b001:l020","ordinal":32566,"en":"Were drenched in crimson blood."},{"id":"manas-2010:p0733:b001:l021","ordinal":32567,"en":"His fame grew great."},{"id":"manas-2010:p0733:b001:l022","ordinal":32568,"en":"When taking Alöökö, lion"},{"id":"manas-2010:p0733:b001:l023","ordinal":32569,"en":"Prince Manas's"},{"id":"manas-2010:p0733:b001:l024","ordinal":32570,"en":"Strife was fierce."},{"id":"manas-2010:p0733:b001:l025","ordinal":32571,"en":"Men died, the ravine filled."},{"id":"manas-2010:p0733:b001:l026","ordinal":32572,"en":"Your aged elder Bakay"},{"id":"manas-2010:p0733:b001:l027","ordinal":32573,"en":"Stood without flinching,"},{"id":"manas-2010:p0733:b001:l028","ordinal":32574,"en":"He was the one who held the banner."},{"id":"manas-2010:p0733:b001:l029","ordinal":32575,"en":"Argyn Khan's Azhybay"},{"id":"manas-2010:p0733:b001:l030","ordinal":32576,"en":"Blocked the approach, fighting with spears."},{"id":"manas-2010:p0733:b001:l031","ordinal":32577,"en":"Yraman's son Yrchy,"},{"id":"manas-2010:p0733:b001:l032","ordinal":32578,"en":"Hero Shuutu, his felt cap like a roof-cover,"},{"id":"manas-2010:p0733:b001:l033","ordinal":32579,"en":"Strong-armed Baychoro,"},{"id":"manas-2010:p0733:b001:l034","ordinal":32580,"en":"‘Which way will they flee?’ they said,"},{"id":"manas-2010:p0733:b001:l035","ordinal":32581,"en":"And blocked the side toward Kangay."},{"id":"manas-2010:p0733:b001:l036","ordinal":32582,"en":"The other champions"},{"id":"manas-2010:p0733:b001:l037","ordinal":32583,"en":"Shouted and thrust their spears,"},{"id":"manas-2010:p0733:b001:l038","ordinal":32584,"en":"Slaughtering one another."},{"id":"manas-2010:p0733:b001:l039","ordinal":32585,"en":"Leopard Manas, the wolf-maned lion,"},{"id":"manas-2010:p0733:b001:l040","ordinal":32586,"en":"The poor hero exerting his strength,"},{"id":"manas-2010:p0733:b001:l041","ordinal":32587,"en":"The five emblems received by the champions,"},{"id":"manas-2010:p0733:b001:l042","ordinal":32588,"en":"He set up in five or six places,"},{"id":"manas-2010:p0734:b001:l001","ordinal":32589,"en":"Champion Manas, wolf-maned hero,"},{"id":"manas-2010:p0734:b001:l002","ordinal":32590,"en":"Made those he faced crawl."},{"id":"manas-2010:p0734:b001:l003","ordinal":32591,"en":"Each emblem bestowed by the noble ones,"},{"id":"manas-2010:p0734:b001:l004","ordinal":32592,"en":"Setting them in different places,"},{"id":"manas-2010:p0734:b001:l005","ordinal":32593,"en":"The lions drove them on,"},{"id":"manas-2010:p0734:b001:l006","ordinal":32594,"en":"Making Alöökö's army crawl."},{"id":"manas-2010:p0734:b001:l007","ordinal":32595,"en":"Raging and charging,"},{"id":"manas-2010:p0734:b001:l008","ordinal":32596,"en":"When they saw the bloodthirsty one's face,"},{"id":"manas-2010:p0734:b001:l009","ordinal":32597,"en":"Alöökö's vast army"},{"id":"manas-2010:p0734:b001:l010","ordinal":32598,"en":"Fled together in a mass."},{"id":"manas-2010:p0734:b001:l011","ordinal":32599,"en":"Azhybay emerged from the flank,"},{"id":"manas-2010:p0734:b001:l012","ordinal":32600,"en":"Never turning back once he charged."},{"id":"manas-2010:p0734:b001:l013","ordinal":32601,"en":"Your bloodthirsty one's forty champions"},{"id":"manas-2010:p0734:b001:l014","ordinal":32602,"en":"Had no little skill."},{"id":"manas-2010:p0734:b001:l015","ordinal":32603,"en":"Saint-like Khan Bakay,"},{"id":"manas-2010:p0734:b001:l016","ordinal":32604,"en":"The sign of every spiritual elder,"},{"id":"manas-2010:p0734:b001:l017","ordinal":32605,"en":"Was it not Bakay who understood it?"},{"id":"manas-2010:p0734:b001:l018","ordinal":32606,"en":"Desiring strife, seeking a quarrel,"},{"id":"manas-2010:p0734:b001:l019","ordinal":32607,"en":"Was it not Bakay who went forth?"},{"id":"manas-2010:p0734:b001:l020","ordinal":32608,"en":"The enemy who came in force,"},{"id":"manas-2010:p0734:b001:l021","ordinal":32609,"en":"Crushing him to sand and meal,"},{"id":"manas-2010:p0734:b001:l022","ordinal":32610,"en":"Into a dungeon forty rope-lengths deep,"},{"id":"manas-2010:p0734:b001:l023","ordinal":32611,"en":"Was it not Bakay who thrust him?"},{"id":"manas-2010:p0734:b001:l024","ordinal":32612,"en":"If you ask of Bakay's nature,"},{"id":"manas-2010:p0734:b001:l025","ordinal":32613,"en":"The bold one among heroes,"},{"id":"manas-2010:p0734:b001:l026","ordinal":32614,"en":"Of your bloodthirsty lion Manas,"},{"id":"manas-2010:p0734:b001:l027","ordinal":32615,"en":"The able one who gave him support."},{"id":"manas-2010:p0734:b001:l028","ordinal":32616,"en":"If you ask of Bakay's nature,"},{"id":"manas-2010:p0734:b001:l029","ordinal":32617,"en":"Against his inner flesh, bulletproof armor,"},{"id":"manas-2010:p0734:b001:l030","ordinal":32618,"en":"Was it not Bakay who wore it?"},{"id":"manas-2010:p0734:b001:l031","ordinal":32619,"en":"Unable to find his prince, his lion,"},{"id":"manas-2010:p0734:b001:l032","ordinal":32620,"en":"The four corners of the round world,"},{"id":"manas-2010:p0734:b001:l033","ordinal":32621,"en":"Roaming around them four times,"},{"id":"manas-2010:p0734:b001:l034","ordinal":32622,"en":"Was it not Bakay who traveled there?"},{"id":"manas-2010:p0734:b001:l035","ordinal":32623,"en":"Once, his elder Bakay,"},{"id":"manas-2010:p0734:b001:l036","ordinal":32624,"en":"Finding no mountain to strike against,"},{"id":"manas-2010:p0734:b001:l037","ordinal":32625,"en":"Finding no enemy to fight,"},{"id":"manas-2010:p0734:b001:l038","ordinal":32626,"en":"Besieged the black giant."},{"id":"manas-2010:p0734:b001:l039","ordinal":32627,"en":"His elder, wolf-maned Bakay,"},{"id":"manas-2010:p0734:b001:l040","ordinal":32628,"en":"Also slew the blue giant."},{"id":"manas-2010:p0734:b001:l041","ordinal":32629,"en":"Laying many lands waste,"},{"id":"manas-2010:p0734:b001:l042","ordinal":32630,"en":"A giant called Choyun Alp had arisen,"},{"id":"manas-2010:p0735:b001:l001","ordinal":32631,"en":"From this endless world,"},{"id":"manas-2010:p0735:b001:l002","ordinal":32632,"en":"Peoples of many kinds had arisen."},{"id":"manas-2010:p0735:b001:l003","ordinal":32633,"en":"‘I alone shall rule the earth,’ he said,"},{"id":"manas-2010:p0735:b001:l004","ordinal":32634,"en":"The dark scourge Choyun Alp."},{"id":"manas-2010:p0735:b001:l005","ordinal":32635,"en":"When he raged fiercely,"},{"id":"manas-2010:p0735:b001:l006","ordinal":32636,"en":"Men and beasts,"},{"id":"manas-2010:p0735:b001:l007","ordinal":32637,"en":"The living beings upon the earth,"},{"id":"manas-2010:p0735:b001:l008","ordinal":32638,"en":"He slaughtered, sparing none."},{"id":"manas-2010:p0735:b001:l009","ordinal":32639,"en":"Without asking, ‘Who is guilty?’"},{"id":"manas-2010:p0735:b001:l010","ordinal":32640,"en":"Everyone he encountered, Choyun Alp"},{"id":"manas-2010:p0735:b001:l011","ordinal":32641,"en":"Slaughtered without exception."},{"id":"manas-2010:p0735:b001:l012","ordinal":32642,"en":"His name was heard throughout the world,"},{"id":"manas-2010:p0735:b001:l013","ordinal":32643,"en":"His awesome spirit rose before all."},{"id":"manas-2010:p0735:b001:l014","ordinal":32644,"en":"Whatever pleased him, that unbeliever"},{"id":"manas-2010:p0735:b001:l015","ordinal":32645,"en":"Began to do."},{"id":"manas-2010:p0735:b001:l016","ordinal":32646,"en":"Every soul he encountered,"},{"id":"manas-2010:p0735:b001:l017","ordinal":32647,"en":"He began to slaughter."},{"id":"manas-2010:p0735:b001:l018","ordinal":32648,"en":"Of that warrior, that hero,"},{"id":"manas-2010:p0735:b001:l019","ordinal":32649,"en":"Of Khan Bakay the lion,"},{"id":"manas-2010:p0735:b001:l020","ordinal":32650,"en":"It is heard in handed-down lore,"},{"id":"manas-2010:p0735:b001:l021","ordinal":32651,"en":"It is known from those who know."},{"id":"manas-2010:p0735:b001:l022","ordinal":32652,"en":"Spears were made of steel."},{"id":"manas-2010:p0735:b001:l023","ordinal":32653,"en":"Heard by the ear and seen by the eye,"},{"id":"manas-2010:p0735:b001:l024","ordinal":32654,"en":"All the giants gathered."},{"id":"manas-2010:p0735:b001:l025","ordinal":32655,"en":"Eighty giants from beneath the earth,"},{"id":"manas-2010:p0735:b001:l026","ordinal":32656,"en":"Ninety giants from upon the earth,"},{"id":"manas-2010:p0735:b001:l027","ordinal":32657,"en":"When the two groups surrounded him,"},{"id":"manas-2010:p0735:b001:l028","ordinal":32658,"en":"Against Choyun Alp, a great battle,"},{"id":"manas-2010:p0735:b001:l029","ordinal":32659,"en":"When the people gathered to wage it,"},{"id":"manas-2010:p0735:b001:l030","ordinal":32660,"en":"Choyun Alp, unlike mortals,"},{"id":"manas-2010:p0735:b001:l031","ordinal":32661,"en":"Terrible havoc and hardship,"},{"id":"manas-2010:p0735:b001:l032","ordinal":32662,"en":"When he began to unleash them,"},{"id":"manas-2010:p0735:b001:l033","ordinal":32663,"en":"Smashing the giants who attacked him,"},{"id":"manas-2010:p0735:b001:l034","ordinal":32664,"en":"When he began to overcome them,"},{"id":"manas-2010:p0735:b001:l035","ordinal":32665,"en":"The rich man's son, Khan Bakay,"},{"id":"manas-2010:p0735:b001:l036","ordinal":32666,"en":"Who rinsed his mouth with honey,"},{"id":"manas-2010:p0735:b001:l037","ordinal":32667,"en":"Who wore a gray lynx-fur cap,"},{"id":"manas-2010:p0735:b001:l038","ordinal":32668,"en":"Who wielded a blue-mottled shield,"},{"id":"manas-2010:p0735:b001:l039","ordinal":32669,"en":"Warrior Bakay had gone there."},{"id":"manas-2010:p0735:b001:l040","ordinal":32670,"en":"The reason he went there:"},{"id":"manas-2010:p0735:b001:l041","ordinal":32671,"en":"He was searching for Manas."},{"id":"manas-2010:p0735:b001:l042","ordinal":32672,"en":"At the earth's end, Zhelpinish,"},{"id":"manas-2010:p0736:b001:l001","ordinal":32673,"en":"On this side of Zhelpinish,"},{"id":"manas-2010:p0736:b001:l002","ordinal":32674,"en":"On the ridge from which the wind comes,"},{"id":"manas-2010:p0736:b001:l003","ordinal":32675,"en":"Ninety giants and eighty giants,"},{"id":"manas-2010:p0736:b001:l004","ordinal":32676,"en":"Their opponent Choyun Alp,"},{"id":"manas-2010:p0736:b001:l005","ordinal":32677,"en":"Drenched in crimson blood,"},{"id":"manas-2010:p0736:b001:l006","ordinal":32678,"en":"At the place of massacre,"},{"id":"manas-2010:p0736:b001:l007","ordinal":32679,"en":"Lion Bakay then,"},{"id":"manas-2010:p0736:b001:l008","ordinal":32680,"en":"Against an unbeliever like Choyun Alp,"},{"id":"manas-2010:p0736:b001:l009","ordinal":32681,"en":"Exchanged much gunfire."},{"id":"manas-2010:p0736:b001:l010","ordinal":32682,"en":"The eighty giants and ninety giants,"},{"id":"manas-2010:p0736:b001:l011","ordinal":32683,"en":"From Choyun Alp's grasp,"},{"id":"manas-2010:p0736:b001:l012","ordinal":32684,"en":"He wrested them free."},{"id":"manas-2010:p0736:b001:l013","ordinal":32685,"en":"As he was freeing them,"},{"id":"manas-2010:p0736:b001:l014","ordinal":32686,"en":"Against that unbeliever Choyun Alp,"},{"id":"manas-2010:p0736:b001:l015","ordinal":32687,"en":"No one matched him in mounted combat;"},{"id":"manas-2010:p0736:b001:l016","ordinal":32688,"en":"There was no forehead left unsplit."},{"id":"manas-2010:p0736:b001:l017","ordinal":32689,"en":"When they came face to face,"},{"id":"manas-2010:p0736:b001:l018","ordinal":32690,"en":"Choyun Alp was a scourge."},{"id":"manas-2010:p0736:b001:l019","ordinal":32691,"en":"Spears broke and splintered;"},{"id":"manas-2010:p0736:b001:l020","ordinal":32692,"en":"Wherever he struck his way through,"},{"id":"manas-2010:p0736:b001:l021","ordinal":32693,"en":"Blood poured down in streams."},{"id":"manas-2010:p0736:b001:l022","ordinal":32694,"en":"Fighting ceaselessly for seven days,"},{"id":"manas-2010:p0736:b001:l023","ordinal":32695,"en":"Was it not Bakay who stood there?"},{"id":"manas-2010:p0736:b001:l024","ordinal":32696,"en":"Choyun Alp's bay horse,"},{"id":"manas-2010:p0736:b001:l025","ordinal":32697,"en":"Smashing it to a pulp,"},{"id":"manas-2010:p0736:b001:l026","ordinal":32698,"en":"Was it not Bakay who speared it?"},{"id":"manas-2010:p0736:b001:l027","ordinal":32699,"en":"The unbeliever full of strength,"},{"id":"manas-2010:p0736:b001:l028","ordinal":32700,"en":"The warrior Khan Choyun Alp,"},{"id":"manas-2010:p0736:b001:l029","ordinal":32701,"en":"Into a dungeon forty rope-lengths deep,"},{"id":"manas-2010:p0736:b001:l030","ordinal":32702,"en":"Was it not Bakay who cast him?"},{"id":"manas-2010:p0736:b001:l031","ordinal":32703,"en":"The giants and ogres,"},{"id":"manas-2010:p0736:b001:l032","ordinal":32704,"en":"Each one different,"},{"id":"manas-2010:p0736:b001:l033","ordinal":32705,"en":"The lords of different places,"},{"id":"manas-2010:p0736:b001:l034","ordinal":32706,"en":"Freeing them from Choyun,"},{"id":"manas-2010:p0736:b001:l035","ordinal":32707,"en":"Was it not Bakay who rescued them?"},{"id":"manas-2010:p0736:b001:l036","ordinal":32708,"en":"Hero Bakay had been their help."},{"id":"manas-2010:p0736:b001:l037","ordinal":32709,"en":"Eighty giants upon the earth,"},{"id":"manas-2010:p0736:b001:l038","ordinal":32710,"en":"Ninety giants beneath the earth,"},{"id":"manas-2010:p0736:b001:l039","ordinal":32711,"en":"Receiving blessings from them all,"},{"id":"manas-2010:p0736:b001:l040","ordinal":32712,"en":"Winning the name of warrior Bakay,"},{"id":"manas-2010:p0736:b001:l041","ordinal":32713,"en":"Was it not Bakay who returned?"},{"id":"manas-2010:p0736:b001:l042","ordinal":32714,"en":"When he swung his spear and thrust,"},{"id":"manas-2010:p0737:b001:l001","ordinal":32715,"en":"Was it not skillful Bakay?"},{"id":"manas-2010:p0737:b001:l002","ordinal":32716,"en":"Warrior Manas's confidant,"},{"id":"manas-2010:p0737:b001:l003","ordinal":32717,"en":"Was it not bold Bakay?"},{"id":"manas-2010:p0737:b001:l004","ordinal":32718,"en":"Having laid Choyun low,"},{"id":"manas-2010:p0737:b001:l005","ordinal":32719,"en":"Was it not Bakay who returned?"},{"id":"manas-2010:p0737:b001:l006","ordinal":32720,"en":"Driven by God, to Manas,"},{"id":"manas-2010:p0737:b001:l007","ordinal":32721,"en":"Was it not Bakay who came?"},{"id":"manas-2010:p0737:b001:l008","ordinal":32722,"en":"Such is Bakay's nature."},{"id":"manas-2010:p0737:b001:l009","ordinal":32723,"en":"Among the wielders of the spear,"},{"id":"manas-2010:p0737:b001:l010","ordinal":32724,"en":"He has exceptional skill as well."},{"id":"manas-2010:p0737:b001:l011","ordinal":32725,"en":"A resourceful sage,"},{"id":"manas-2010:p0737:b001:l012","ordinal":32726,"en":"He has strength as well."},{"id":"manas-2010:p0737:b001:l013","ordinal":32727,"en":"Both knowing and heroic,"},{"id":"manas-2010:p0737:b001:l014","ordinal":32728,"en":"Against warrior Alöökö,"},{"id":"manas-2010:p0737:b001:l015","ordinal":32729,"en":"Now your elder Bakay,"},{"id":"manas-2010:p0737:b001:l016","ordinal":32730,"en":"That was where he joined the attack."},{"id":"manas-2010:p0737:b001:l017","ordinal":32731,"en":"Dear heads in the darkening dust,"},{"id":"manas-2010:p0737:b001:l018","ordinal":32732,"en":"Within this strife,"},{"id":"manas-2010:p0737:b001:l019","ordinal":32733,"en":"Azhybay, Bakay and lion Manas,"},{"id":"manas-2010:p0737:b001:l020","ordinal":32734,"en":"These three were mingled together."},{"id":"manas-2010:p0737:b001:l021","ordinal":32735,"en":"Raising and thrusting their spears,"},{"id":"manas-2010:p0737:b001:l022","ordinal":32736,"en":"They fought in turns."},{"id":"manas-2010:p0737:b001:l023","ordinal":32737,"en":"Manas speared a man as he passed;"},{"id":"manas-2010:p0737:b001:l024","ordinal":32738,"en":"Azhybay cut off his head."},{"id":"manas-2010:p0737:b001:l025","ordinal":32739,"en":"Bakay went spearing men as he passed;"},{"id":"manas-2010:p0737:b001:l026","ordinal":32740,"en":"Manas went cutting off their heads."},{"id":"manas-2010:p0737:b001:l027","ordinal":32741,"en":"Before one could say this or that,"},{"id":"manas-2010:p0737:b001:l028","ordinal":32742,"en":"In the opening and closing of an eye,"},{"id":"manas-2010:p0737:b001:l029","ordinal":32743,"en":"They began a fierce slaughter."},{"id":"manas-2010:p0737:b001:l030","ordinal":32744,"en":"Alöökö's great army,"},{"id":"manas-2010:p0737:b001:l031","ordinal":32745,"en":"Lion Manas, Azhybay,"},{"id":"manas-2010:p0737:b001:l032","ordinal":32746,"en":"And the forty warriors following the wolf's way,"},{"id":"manas-2010:p0737:b001:l033","ordinal":32747,"en":"Slaughtered them all."},{"id":"manas-2010:p0737:b001:l034","ordinal":32748,"en":"They seized his governors."},{"id":"manas-2010:p0737:b001:l035","ordinal":32749,"en":"His strong men wearing sleeveless coats,"},{"id":"manas-2010:p0737:b001:l036","ordinal":32750,"en":"The finest officials wearing rank-balls,"},{"id":"manas-2010:p0737:b001:l037","ordinal":32751,"en":"Smashing them without sparing one,"},{"id":"manas-2010:p0737:b001:l038","ordinal":32752,"en":"They slaughtered them all."},{"id":"manas-2010:p0737:b001:l039","ordinal":32753,"en":"They unleashed a fierce wrath."},{"id":"manas-2010:p0737:b001:l040","ordinal":32754,"en":"Of his great army, leaving none,"},{"id":"manas-2010:p0737:b001:l041","ordinal":32755,"en":"They slaughtered every one."},{"id":"manas-2010:p0737:b001:l042","ordinal":32756,"en":"The reason they left none,"},{"id":"manas-2010:p0738:b001:l001","ordinal":32757,"en":"They had made a dreadful quarrel,"},{"id":"manas-2010:p0738:b001:l002","ordinal":32758,"en":"They had fought without sparing lives."},{"id":"manas-2010:p0738:b001:l003","ordinal":32759,"en":"The gold he had taken as booty,"},{"id":"manas-2010:p0738:b001:l004","ordinal":32760,"en":"Lion Manas then"},{"id":"manas-2010:p0738:b001:l005","ordinal":32761,"en":"Scattered it as booty."},{"id":"manas-2010:p0738:b001:l006","ordinal":32762,"en":"Of warrior Alöökö,"},{"id":"manas-2010:p0738:b001:l007","ordinal":32763,"en":"The place where they descended upon his head,"},{"id":"manas-2010:p0738:b001:l008","ordinal":32764,"en":"Its name remains even now,"},{"id":"manas-2010:p0738:b001:l009","ordinal":32765,"en":"The place they scattered his four kinds of livestock."},{"id":"manas-2010:p0738:b001:l010","ordinal":32766,"en":"In Kashalay's deep hollow,"},{"id":"manas-2010:p0738:b001:l011","ordinal":32767,"en":"Beside the Kum-Aryk River,"},{"id":"manas-2010:p0738:b001:l012","ordinal":32768,"en":"Making the excitement costly,"}]
