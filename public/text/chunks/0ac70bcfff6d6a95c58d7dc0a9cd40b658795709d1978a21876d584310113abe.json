[{"id":"semetey-1-2013:p0720:b004:l039","ordinal":132097,"en":"‘To the Burut's mad Manas,"},{"id":"semetey-1-2013:p0721:b003:l001","ordinal":132098,"en":"I shall bring terrible trouble,’ he said."},{"id":"semetey-1-2013:p0721:b003:l002","ordinal":132099,"en":"That self-important Manas—"},{"id":"semetey-1-2013:p0721:b003:l003","ordinal":132100,"en":"‘I shall face him and capture him."},{"id":"semetey-1-2013:p0721:b003:l004","ordinal":132101,"en":"For the daughters of Chynmachyn,"},{"id":"semetey-1-2013:p0721:b003:l005","ordinal":132102,"en":"I shall capture him and use him as a stallion.’"},{"id":"semetey-1-2013:p0721:b003:l006","ordinal":132103,"en":"Great Döngö had made firm preparations;"},{"id":"semetey-1-2013:p0721:b003:l007","ordinal":132104,"en":"Now he had arrived."},{"id":"semetey-1-2013:p0721:b003:l008","ordinal":132105,"en":"If you ask about Döngö,"},{"id":"semetey-1-2013:p0721:b003:l009","ordinal":132106,"en":"He was as big as a mountain,"},{"id":"semetey-1-2013:p0721:b003:l010","ordinal":132107,"en":"Seeming ready to devour any challenger."},{"id":"semetey-1-2013:p0721:b003:l011","ordinal":132108,"en":"His appearance was unlike a human's."},{"id":"semetey-1-2013:p0721:b003:l012","ordinal":132109,"en":"His attacks made blood flow;"},{"id":"semetey-1-2013:p0721:b003:l013","ordinal":132110,"en":"His might made souls depart."},{"id":"semetey-1-2013:p0721:b003:l014","ordinal":132111,"en":"His mule trampled the earth."},{"id":"semetey-1-2013:p0721:b003:l015","ordinal":132112,"en":"Khan Kongurbai and Joloi"},{"id":"semetey-1-2013:p0721:b003:l016","ordinal":132113,"en":"He scolded as though they were his wives:"},{"id":"semetey-1-2013:p0721:b003:l017","ordinal":132114,"en":"‘To this day, the Burut Manas"},{"id":"semetey-1-2013:p0721:b003:l018","ordinal":132115,"en":"You have not bent down and speared!"},{"id":"semetey-1-2013:p0721:b003:l019","ordinal":132116,"en":"Let alone the Burut's horses,"},{"id":"semetey-1-2013:p0721:b003:l020","ordinal":132117,"en":"You have not driven off their cattle!"},{"id":"semetey-1-2013:p0721:b003:l021","ordinal":132118,"en":"Raging and boasting—"},{"id":"semetey-1-2013:p0721:b003:l022","ordinal":132119,"en":"Where is Khan Kongurbai,"},{"id":"semetey-1-2013:p0721:b003:l023","ordinal":132120,"en":"Who has not charged into battle?"},{"id":"semetey-1-2013:p0721:b003:l024","ordinal":132121,"en":"Let alone the Burut's daughters,"},{"id":"semetey-1-2013:p0721:b003:l025","ordinal":132122,"en":"He has not taken their wives as spoil!"},{"id":"semetey-1-2013:p0721:b003:l026","ordinal":132123,"en":"Where is that cowardly Kalcha?"},{"id":"semetey-1-2013:p0721:b003:l027","ordinal":132124,"en":"You multitude of Chinese, the khakan's people,"},{"id":"semetey-1-2013:p0721:b003:l028","ordinal":132125,"en":"If you are grass like tumbleweed,"},{"id":"semetey-1-2013:p0721:b003:l029","ordinal":132126,"en":"If you are so absurdly numerous,"},{"id":"semetey-1-2013:p0721:b003:l030","ordinal":132127,"en":"Manchus and black Kalmyks,"},{"id":"semetey-1-2013:p0721:b003:l031","ordinal":132128,"en":"All of you have fled!"},{"id":"semetey-1-2013:p0721:b003:l032","ordinal":132129,"en":"From the countless Burut,"},{"id":"semetey-1-2013:p0721:b003:l033","ordinal":132130,"en":"You have taken just one girl as spoil!’"},{"id":"semetey-1-2013:p0721:b003:l034","ordinal":132131,"en":"So spoke Great Döngö,"},{"id":"semetey-1-2013:p0721:b003:l035","ordinal":132132,"en":"Of the jacket-wearing Chinese,"},{"id":"semetey-1-2013:p0721:b003:l036","ordinal":132133,"en":"Scolding their mighty men."},{"id":"semetey-1-2013:p0721:b003:l037","ordinal":132134,"en":"Of the stone-worshipping Chinese,"},{"id":"semetey-1-2013:p0721:b003:l038","ordinal":132135,"en":"Scolding their bald ones,"},{"id":"semetey-1-2013:p0721:b003:l039","ordinal":132136,"en":"He began a terrible commotion."},{"id":"semetey-1-2013:p0721:b005:l001","ordinal":132137,"en":"Great Döngö raged."},{"id":"semetey-1-2013:p0721:b005:l002","ordinal":132138,"en":"All their khans—"},{"id":"semetey-1-2013:p0721:b005:l003","ordinal":132139,"en":"The owner left"},{"id":"semetey-1-2013:p0721:b005:l004","ordinal":132140,"en":"Khan Joloi and Ylama,"},{"id":"semetey-1-2013:p0721:b005:l005","ordinal":132141,"en":"The multitude of Chinese, Machangchyn,"},{"id":"semetey-1-2013:p0721:b005:l006","ordinal":132142,"en":"Ask not about their people!"},{"id":"semetey-1-2013:p0721:b005:l007","ordinal":132143,"en":"This ill-omened Döngö,"},{"id":"semetey-1-2013:p0721:b005:l008","ordinal":132144,"en":"Let me tell you of the giant."},{"id":"semetey-1-2013:p0721:b005:l009","ordinal":132145,"en":"Ask not about Döngö!"},{"id":"semetey-1-2013:p0721:b005:l010","ordinal":132146,"en":"His brow was high, his face cold."},{"id":"semetey-1-2013:p0721:b005:l011","ordinal":132147,"en":"What could that fearsome Döngö do?"},{"id":"semetey-1-2013:p0721:b005:l012","ordinal":132148,"en":"His curling mustache"},{"id":"semetey-1-2013:p0721:b005:l013","ordinal":132149,"en":"Was like nettles on an old sheepfold."},{"id":"semetey-1-2013:p0721:b005:l014","ordinal":132150,"en":"And the filth of his pipe"},{"id":"semetey-1-2013:p0721:b005:l015","ordinal":132151,"en":"Like the ground grain children eat."},{"id":"semetey-1-2013:p0721:b005:l016","ordinal":132152,"en":"The size of his nose"},{"id":"semetey-1-2013:p0721:b005:l017","ordinal":132153,"en":"Was like a great sword's scabbard."},{"id":"semetey-1-2013:p0721:b005:l018","ordinal":132154,"en":"The space between brow and eyelids"},{"id":"semetey-1-2013:p0721:b005:l019","ordinal":132155,"en":"Was like a grave whose roof had fallen in."},{"id":"semetey-1-2013:p0721:b005:l020","ordinal":132156,"en":"The breadth of his moon-like forehead"},{"id":"semetey-1-2013:p0721:b005:l021","ordinal":132157,"en":"Was like an upland pasture where a rich man summers."},{"id":"semetey-1-2013:p0721:b005:l022","ordinal":132158,"en":"No man could bear to look upon his face;"},{"id":"semetey-1-2013:p0721:b005:l023","ordinal":132159,"en":"No mortal could come to face him;"},{"id":"semetey-1-2013:p0721:b005:l024","ordinal":132160,"en":"No mortal could bear his appearance."},{"id":"semetey-1-2013:p0721:b005:l025","ordinal":132161,"en":"Then that giant,"},{"id":"semetey-1-2013:p0721:b005:l026","ordinal":132162,"en":"With many ready behind him,"},{"id":"semetey-1-2013:p0721:b005:l027","ordinal":132163,"en":"Countless giants crowded about him,"},{"id":"semetey-1-2013:p0721:b005:l028","ordinal":132164,"en":"Gathered his strength and roared."},{"id":"semetey-1-2013:p0721:b005:l029","ordinal":132165,"en":"The multitude of Chinese, Kongurbai,"},{"id":"semetey-1-2013:p0721:b005:l030","ordinal":132166,"en":"Split apart with a great uproar."},{"id":"semetey-1-2013:p0721:b005:l031","ordinal":132167,"en":"He armed himself and girded for action."},{"id":"semetey-1-2013:p0721:b005:l032","ordinal":132168,"en":"He was one of the renowned."},{"id":"semetey-1-2013:p0721:b005:l033","ordinal":132169,"en":"Swaying as though struck by a spirit,"},{"id":"semetey-1-2013:p0721:b005:l034","ordinal":132170,"en":"The Chinese warrior strode heedlessly."},{"id":"semetey-1-2013:p0721:b005:l035","ordinal":132171,"en":"The great army coming at his flank"},{"id":"semetey-1-2013:p0721:b005:l036","ordinal":132172,"en":"He valued less than his trouser cuff."},{"id":"semetey-1-2013:p0721:b005:l037","ordinal":132173,"en":"Tied close at his side,"},{"id":"semetey-1-2013:p0721:b005:l038","ordinal":132174,"en":"A red pouch, a tobacco container—"},{"id":"semetey-1-2013:p0721:b005:l039","ordinal":132175,"en":"Into the pipe in his hand,"},{"id":"semetey-1-2013:p0722:b003:l001","ordinal":132176,"en":"Tobacco from the container,"},{"id":"semetey-1-2013:p0722:b003:l002","ordinal":132177,"en":"He put in four handfuls."},{"id":"semetey-1-2013:p0722:b003:l003","ordinal":132178,"en":"That Döngö's pipe"},{"id":"semetey-1-2013:p0722:b003:l004","ordinal":132179,"en":"Still was not full then;"},{"id":"semetey-1-2013:p0722:b003:l005","ordinal":132180,"en":"It remained four fingerbreadths short."},{"id":"semetey-1-2013:p0722:b003:l006","ordinal":132181,"en":"Bulging as large as a small tent,"},{"id":"semetey-1-2013:p0722:b003:l007","ordinal":132182,"en":"He drew black tinder from his pouch,"},{"id":"semetey-1-2013:p0722:b003:l008","ordinal":132183,"en":"Creating uproar among the Chinese."},{"id":"semetey-1-2013:p0722:b003:l009","ordinal":132184,"en":"Chinese firesteel and flint—"},{"id":"semetey-1-2013:p0722:b003:l010","ordinal":132185,"en":"He struck them and made fire."},{"id":"semetey-1-2013:p0722:b003:l011","ordinal":132186,"en":"He put an ember in his pipe,"},{"id":"semetey-1-2013:p0722:b003:l012","ordinal":132187,"en":"Thus setting the pipe alight."},{"id":"semetey-1-2013:p0722:b003:l013","ordinal":132188,"en":"When he sucked, the great pipe"},{"id":"semetey-1-2013:p0722:b003:l014","ordinal":132189,"en":"Rumbled like a drum."},{"id":"semetey-1-2013:p0722:b003:l015","ordinal":132190,"en":"When he let out its smoke,"},{"id":"semetey-1-2013:p0722:b003:l016","ordinal":132191,"en":"It billowed like a hide-smoking pit."},{"id":"semetey-1-2013:p0722:b003:l017","ordinal":132192,"en":"All the Manchus, the many monks,"},{"id":"semetey-1-2013:p0722:b003:l018","ordinal":132193,"en":"Screamed in terror for their lives."},{"id":"semetey-1-2013:p0722:b003:l019","ordinal":132194,"en":"Like shooting stars,"},{"id":"semetey-1-2013:p0722:b003:l020","ordinal":132195,"en":"The pipe's embers flew."},{"id":"semetey-1-2013:p0722:b003:l021","ordinal":132196,"en":"The noble mule beneath him"},{"id":"semetey-1-2013:p0722:b003:l022","ordinal":132197,"en":"He whipped in anger."},{"id":"semetey-1-2013:p0722:b003:l023","ordinal":132198,"en":"‘Your father's grave, Kongurbai!"},{"id":"semetey-1-2013:p0722:b003:l024","ordinal":132199,"en":"Shypshaidar and Kongurbai,"},{"id":"semetey-1-2013:p0722:b003:l025","ordinal":132200,"en":"Still you stand looking on!"},{"id":"semetey-1-2013:p0722:b003:l026","ordinal":132201,"en":"To the black Burut who oppose us,"},{"id":"semetey-1-2013:p0722:b003:l027","ordinal":132202,"en":"I shall bring calamity."},{"id":"semetey-1-2013:p0722:b003:l028","ordinal":132203,"en":"Never mind Manas—just watch!"},{"id":"semetey-1-2013:p0722:b003:l029","ordinal":132204,"en":"I shall bind all the others."},{"id":"semetey-1-2013:p0722:b003:l030","ordinal":132205,"en":"The renowned Burut, that small people,"},{"id":"semetey-1-2013:p0722:b003:l031","ordinal":132206,"en":"I shall drive them to Mecca."},{"id":"semetey-1-2013:p0722:b003:l032","ordinal":132207,"en":"Weak-backed, watery-hearted,"},{"id":"semetey-1-2013:p0722:b003:l033","ordinal":132208,"en":"You dogs who have lost your spirit!’"},{"id":"semetey-1-2013:p0722:b003:l034","ordinal":132209,"en":"Now he made a fearsome display."},{"id":"semetey-1-2013:p0722:b003:l035","ordinal":132210,"en":"Facing them, he leveled his spear."},{"id":"semetey-1-2013:p0722:b003:l036","ordinal":132211,"en":"Watch how thoroughly he will confound"},{"id":"semetey-1-2013:p0722:b003:l037","ordinal":132212,"en":"The forty companions."},{"id":"semetey-1-2013:p0722:b003:l038","ordinal":132213,"en":"Roaring in anger,"},{"id":"semetey-1-2013:p0722:b003:l039","ordinal":132214,"en":"He whipped his mule,"},{"id":"semetey-1-2013:p0722:b004:l001","ordinal":132215,"en":"Calling, ‘Come, Burut!’"},{"id":"semetey-1-2013:p0722:b004:l002","ordinal":132216,"en":"When they saw that Döngö,"},{"id":"semetey-1-2013:p0722:b004:l003","ordinal":132217,"en":"Khan Manas's forty champions,"},{"id":"semetey-1-2013:p0722:b004:l004","ordinal":132218,"en":"Your precious elder Bakai among them,"},{"id":"semetey-1-2013:p0722:b004:l005","ordinal":132219,"en":"All the champions gathered,"},{"id":"semetey-1-2013:p0722:b004:l006","ordinal":132220,"en":"Falling silent as if they had drunk poison."},{"id":"semetey-1-2013:p0722:b004:l007","ordinal":132221,"en":"No one dared stand against Döngö."},{"id":"semetey-1-2013:p0722:b004:l008","ordinal":132222,"en":"Of the forty companions themselves,"},{"id":"semetey-1-2013:p0722:b004:l009","ordinal":132223,"en":"Not a louse-sized drop of blood remained in their faces."},{"id":"semetey-1-2013:p0722:b004:l010","ordinal":132224,"en":"‘That damned Chinese—"},{"id":"semetey-1-2013:p0722:b004:l011","ordinal":132225,"en":"No one who challenges him will survive!"},{"id":"semetey-1-2013:p0722:b004:l012","ordinal":132226,"en":"No one who meets him will leave alive!’"},{"id":"semetey-1-2013:p0722:b004:l013","ordinal":132227,"en":"With old Kyrgyl at their head,"},{"id":"semetey-1-2013:p0722:b004:l014","ordinal":132228,"en":"All forty companions—"},{"id":"semetey-1-2013:p0722:b004:l015","ordinal":132229,"en":"The covering left their hearts,"},{"id":"semetey-1-2013:p0722:b004:l016","ordinal":132230,"en":"The strength left their arms."},{"id":"semetey-1-2013:p0722:b004:l017","ordinal":132231,"en":"Valiant Manas, the leopard,"},{"id":"semetey-1-2013:p0722:b004:l018","ordinal":132232,"en":"Your saint, born renowned,"},{"id":"semetey-1-2013:p0722:b004:l019","ordinal":132233,"en":"The conquering lord, the surpassing lion,"},{"id":"semetey-1-2013:p0722:b004:l020","ordinal":132234,"en":"Fought the spear duel there."},{"id":"semetey-1-2013:p0722:b004:l021","ordinal":132235,"en":"Guardian-spirit Manas, the leopard,"},{"id":"semetey-1-2013:p0722:b004:l022","ordinal":132236,"en":"The mount beneath him,"},{"id":"semetey-1-2013:p0722:b004:l023","ordinal":132237,"en":"Akkula, whom he rode to war,"},{"id":"semetey-1-2013:p0722:b004:l024","ordinal":132238,"en":"Was a Karabair warhorse,"},{"id":"semetey-1-2013:p0722:b004:l025","ordinal":132239,"en":"With sieve-like lungs and copper forelegs,"},{"id":"semetey-1-2013:p0722:b004:l026","ordinal":132240,"en":"A young mare's foal,"},{"id":"semetey-1-2013:p0722:b004:l027","ordinal":132241,"en":"The Duldul of the horse herds."},{"id":"semetey-1-2013:p0722:b004:l028","ordinal":132242,"en":"Taking his painted spear in hand,"},{"id":"semetey-1-2013:p0722:b004:l029","ordinal":132243,"en":"He struck Akkula once on the thigh."},{"id":"semetey-1-2013:p0722:b004:l030","ordinal":132244,"en":"The lion, the leopard like a camel,"},{"id":"semetey-1-2013:p0722:b004:l031","ordinal":132245,"en":"Attacked that Döngö."},{"id":"semetey-1-2013:p0722:b004:l032","ordinal":132246,"en":"The Boz Kise that descended from heaven,"},{"id":"semetey-1-2013:p0722:b004:l033","ordinal":132247,"en":"He girded about his waist, shouting."},{"id":"semetey-1-2013:p0722:b004:l034","ordinal":132248,"en":"Shrill battle cries, fierce rallying shouts—"},{"id":"semetey-1-2013:p0722:b004:l035","ordinal":132249,"en":"He raised an earth-splitting voice."},{"id":"semetey-1-2013:p0722:b004:l036","ordinal":132250,"en":"Valiant Manas, the lion,"},{"id":"semetey-1-2013:p0722:b004:l037","ordinal":132251,"en":"Hunched backward at the waist,"},{"id":"semetey-1-2013:p0722:b004:l038","ordinal":132252,"en":"His eyes staring without blinking,"},{"id":"semetey-1-2013:p0722:b004:l039","ordinal":132253,"en":"‘The Kalmyk saddle's pommel,’ he said—"},{"id":"semetey-1-2013:p0723:b003:l001","ordinal":132254,"en":"‘If I sink it down through the breast,"},{"id":"semetey-1-2013:p0723:b003:l002","ordinal":132255,"en":"There is the very heart,’ he said."},{"id":"semetey-1-2013:p0723:b003:l003","ordinal":132256,"en":"When Manas struck him,"},{"id":"semetey-1-2013:p0723:b003:l004","ordinal":132257,"en":"Great Döngö did not flinch."},{"id":"semetey-1-2013:p0723:b003:l005","ordinal":132258,"en":"A tale full of marvels!"},{"id":"semetey-1-2013:p0723:b003:l006","ordinal":132259,"en":"Often ridden against hostile foes,"},{"id":"semetey-1-2013:p0723:b003:l007","ordinal":132260,"en":"Akkula had grown seasoned."},{"id":"semetey-1-2013:p0723:b003:l008","ordinal":132261,"en":"When Manas struck Döngö,"},{"id":"semetey-1-2013:p0723:b003:l009","ordinal":132262,"en":"His feet sank firmly into the earth."},{"id":"semetey-1-2013:p0723:b003:l010","ordinal":132263,"en":"Smiling boldly,"},{"id":"semetey-1-2013:p0723:b003:l011","ordinal":132264,"en":"Laughing brightly, standing unbowed,"},{"id":"semetey-1-2013:p0723:b003:l012","ordinal":132265,"en":"‘Take your turn, infidel!"},{"id":"semetey-1-2013:p0723:b003:l013","ordinal":132266,"en":"You have come from Beijing,"},{"id":"semetey-1-2013:p0723:b003:l014","ordinal":132267,"en":"Renowned warrior Döngö,’ he said."},{"id":"semetey-1-2013:p0723:b003:l015","ordinal":132268,"en":"Khan Manas stood on a ridge."},{"id":"semetey-1-2013:p0723:b003:l016","ordinal":132269,"en":"Great Döngö faced him and thrust;"},{"id":"semetey-1-2013:p0723:b003:l017","ordinal":132270,"en":"Khan Manas paid it no heed."},{"id":"semetey-1-2013:p0723:b003:l018","ordinal":132271,"en":"Great Döngö stood upon a peak."},{"id":"semetey-1-2013:p0723:b003:l019","ordinal":132272,"en":"Khan Manas stretched forward and thrust;"},{"id":"semetey-1-2013:p0723:b003:l020","ordinal":132273,"en":"Great Döngö showed no fear."},{"id":"semetey-1-2013:p0723:b003:l021","ordinal":132274,"en":"They stood in turn,"},{"id":"semetey-1-2013:p0723:b003:l022","ordinal":132275,"en":"Struck one another firmly,"},{"id":"semetey-1-2013:p0723:b003:l023","ordinal":132276,"en":"Shouted and fought with spears."},{"id":"semetey-1-2013:p0723:b003:l024","ordinal":132277,"en":"A great tale without equal in the ages—"},{"id":"semetey-1-2013:p0723:b003:l025","ordinal":132278,"en":"Thus they fought."},{"id":"semetey-1-2013:p0723:b003:l026","ordinal":132279,"en":"Great Döngö stood again;"},{"id":"semetey-1-2013:p0723:b003:l027","ordinal":132280,"en":"Khan Manas stood again."},{"id":"semetey-1-2013:p0723:b003:l028","ordinal":132281,"en":"When Manas thrust again,"},{"id":"semetey-1-2013:p0723:b003:l029","ordinal":132282,"en":"Döngö, who had stood firm—"},{"id":"semetey-1-2013:p0723:b003:l030","ordinal":132283,"en":"His shot-proof coat split open;"},{"id":"semetey-1-2013:p0723:b003:l031","ordinal":132284,"en":"The place over his lungs was exposed."},{"id":"semetey-1-2013:p0723:b003:l032","ordinal":132285,"en":"Unable to gather his wits,"},{"id":"semetey-1-2013:p0723:b003:l033","ordinal":132286,"en":"Great Döngö standing there"},{"id":"semetey-1-2013:p0723:b003:l034","ordinal":132287,"en":"Was in great distress."},{"id":"semetey-1-2013:p0723:b003:l035","ordinal":132288,"en":"Khan Kongurbai and Shypshaidar,"},{"id":"semetey-1-2013:p0723:b003:l036","ordinal":132289,"en":"And their renowned wrestler Tiken,"},{"id":"semetey-1-2013:p0723:b003:l037","ordinal":132290,"en":"Against Khan Manas"},{"id":"semetey-1-2013:p0723:b003:l038","ordinal":132291,"en":"The pigs launched a mass assault."},{"id":"semetey-1-2013:p0723:b003:l039","ordinal":132292,"en":"Khan Manas's forty lords"},{"id":"semetey-1-2013:p0723:b005:l001","ordinal":132293,"en":"Charged against them."},{"id":"semetey-1-2013:p0723:b005:l002","ordinal":132294,"en":"Precious Chubak and warrior Bakai,"},{"id":"semetey-1-2013:p0723:b005:l003","ordinal":132295,"en":"Not letting their Manas be overwhelmed,"},{"id":"semetey-1-2013:p0723:b005:l004","ordinal":132296,"en":"Fought with crashing blows,"},{"id":"semetey-1-2013:p0723:b005:l005","ordinal":132297,"en":"Hacked with battle-axes,"},{"id":"semetey-1-2013:p0723:b005:l006","ordinal":132298,"en":"confused,"},{"id":"semetey-1-2013:p0723:b005:l007","ordinal":132299,"en":"Killed when opportunity came."},{"id":"semetey-1-2013:p0723:b005:l008","ordinal":132300,"en":"When they came within reach,"},{"id":"semetey-1-2013:p0723:b005:l009","ordinal":132301,"en":"Their sharp, tasseled spears"},{"id":"semetey-1-2013:p0723:b005:l010","ordinal":132302,"en":"They planted in the chosen spot."},{"id":"semetey-1-2013:p0723:b005:l011","ordinal":132303,"en":"Infidel and Muslim"},{"id":"semetey-1-2013:p0723:b005:l012","ordinal":132304,"en":"Became mingled together."},{"id":"semetey-1-2013:p0723:b005:l013","ordinal":132305,"en":"May God never show you such a sight!"},{"id":"semetey-1-2013:p0723:b005:l014","ordinal":132306,"en":"One could not tell which was which;"},{"id":"semetey-1-2013:p0723:b005:l015","ordinal":132307,"en":"Looking, the eye could not distinguish them."},{"id":"semetey-1-2013:p0723:b005:l016","ordinal":132308,"en":"As though tumbleweed flew,"},{"id":"semetey-1-2013:p0723:b005:l017","ordinal":132309,"en":"Dust swarmed up from the level ground."},{"id":"semetey-1-2013:p0723:b005:l018","ordinal":132310,"en":"From rough hollows and ditches,"},{"id":"semetey-1-2013:p0723:b005:l019","ordinal":132311,"en":"Dark blood poured with a gurgle."},{"id":"semetey-1-2013:p0723:b005:l020","ordinal":132312,"en":"As the Chinese were dying,"},{"id":"semetey-1-2013:p0723:b005:l021","ordinal":132313,"en":"If you ask about Döngö,"},{"id":"semetey-1-2013:p0723:b005:l022","ordinal":132314,"en":"Unable to endure Manas's heat,"},{"id":"semetey-1-2013:p0723:b005:l023","ordinal":132315,"en":"Unable to withstand his strength,"},{"id":"semetey-1-2013:p0723:b005:l024","ordinal":132316,"en":"He urged his mount toward the khakan,"},{"id":"semetey-1-2013:p0723:b005:l025","ordinal":132317,"en":"And fled away."},{"id":"semetey-1-2013:p0723:b005:l026","ordinal":132318,"en":"Frantic, his wits scattered,"},{"id":"semetey-1-2013:p0723:b005:l027","ordinal":132319,"en":"What could poor Döngö do?"},{"id":"semetey-1-2013:p0723:b005:l028","ordinal":132320,"en":"He was thrown into panic."},{"id":"semetey-1-2013:p0723:b005:l029","ordinal":132321,"en":"When they reached the descent,"},{"id":"semetey-1-2013:p0723:b005:l030","ordinal":132322,"en":"That Döngö's mule"},{"id":"semetey-1-2013:p0723:b005:l031","ordinal":132323,"en":"Had a neck bulging like a bull's."},{"id":"semetey-1-2013:p0723:b005:l032","ordinal":132324,"en":"When they began to climb,"},{"id":"semetey-1-2013:p0723:b005:l033","ordinal":132325,"en":"Khan Manas's Akkula"},{"id":"semetey-1-2013:p0723:b005:l034","ordinal":132326,"en":"Had eyes gleaming like an argali's."},{"id":"semetey-1-2013:p0723:b005:l035","ordinal":132327,"en":"Your accomplished elder Manas"},{"id":"semetey-1-2013:p0723:b005:l036","ordinal":132328,"en":"Reached him swifter than an arrow."},{"id":"semetey-1-2013:p0723:b005:l037","ordinal":132329,"en":"Where he caught up with Döngö,"},{"id":"semetey-1-2013:p0723:b005:l038","ordinal":132330,"en":"From upon his mule,"},{"id":"semetey-1-2013:p0723:b005:l039","ordinal":132331,"en":"When precious Manas made ready,"},{"id":"semetey-1-2013:p0724:b003:l001","ordinal":132332,"en":"Akbalta's Chubak,"},{"id":"semetey-1-2013:p0724:b003:l002","ordinal":132333,"en":"Who made the whole world cry out,"},{"id":"semetey-1-2013:p0724:b003:l003","ordinal":132334,"en":"That wretch—your father's grave!—"},{"id":"semetey-1-2013:p0724:b003:l004","ordinal":132335,"en":"In Khan Chubak's hand"},{"id":"semetey-1-2013:p0724:b003:l005","ordinal":132336,"en":"Was the renowned sword Oikuma."},{"id":"semetey-1-2013:p0724:b003:l006","ordinal":132337,"en":"He reached him and took his head."},{"id":"semetey-1-2013:p0724:b003:l007","ordinal":132338,"en":"Accomplished Manas and he together"},{"id":"semetey-1-2013:p0724:b003:l008","ordinal":132339,"en":"Slaughtered Döngö."},{"id":"semetey-1-2013:p0724:b003:l009","ordinal":132340,"en":"‘Mighty Döngö is dead!’"},{"id":"semetey-1-2013:p0724:b003:l010","ordinal":132341,"en":"The people of Beijing fled."},{"id":"semetey-1-2013:p0724:b003:l011","ordinal":132342,"en":"Then valiant Manas, the fierce khan,"},{"id":"semetey-1-2013:p0724:b003:l012","ordinal":132343,"en":"The five pennants brought from Mecca"},{"id":"semetey-1-2013:p0724:b003:l013","ordinal":132344,"en":"Planted firmly in the earth,"},{"id":"semetey-1-2013:p0724:b003:l014","ordinal":132345,"en":"Sending those who faced him crawling."},{"id":"semetey-1-2013:p0724:b003:l015","ordinal":132346,"en":"The emblems brought from afar"},{"id":"semetey-1-2013:p0724:b003:l016","ordinal":132347,"en":"He planted in six places,"},{"id":"semetey-1-2013:p0724:b003:l017","ordinal":132348,"en":"Driving the enemy, sending them crawling,"},{"id":"semetey-1-2013:p0724:b003:l018","ordinal":132349,"en":"Bringing down the kaldai's banner."},{"id":"semetey-1-2013:p0724:b003:l019","ordinal":132350,"en":"The black Manchus and Sibe—"},{"id":"semetey-1-2013:p0724:b003:l020","ordinal":132351,"en":"He made their cries reach God,"},{"id":"semetey-1-2013:p0724:b003:l021","ordinal":132352,"en":"Pursued and drove and scattered them,"}]
