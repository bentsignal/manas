[{"id":"semetey-1-2013:p1045:b004:l002","ordinal":155905,"en":"Until Aychürök came near,"},{"id":"semetey-1-2013:p1045:b004:l003","ordinal":155906,"en":"The great-hearted princely leopard"},{"id":"semetey-1-2013:p1045:b004:l004","ordinal":155907,"en":"Went limp and nearly fainted."},{"id":"semetey-1-2013:p1045:b004:l005","ordinal":155908,"en":"Until Chürök came beside him,"},{"id":"semetey-1-2013:p1045:b004:l006","ordinal":155909,"en":"His tiny soul cried out;"},{"id":"semetey-1-2013:p1045:b004:l007","ordinal":155910,"en":"He waited in frightened haste,"},{"id":"semetey-1-2013:p1045:b004:l008","ordinal":155911,"en":"Every bone in his body trembling."},{"id":"semetey-1-2013:p1045:b004:l009","ordinal":155912,"en":"Early time became late;"},{"id":"semetey-1-2013:p1045:b004:l010","ordinal":155913,"en":"\"When will Chürök come?\" he thought."},{"id":"semetey-1-2013:p1045:b004:l011","ordinal":155914,"en":"Your gray-maned wolf waited impatiently,"},{"id":"semetey-1-2013:p1045:b004:l012","ordinal":155915,"en":"His two eyes becoming four."},{"id":"semetey-1-2013:p1045:b004:l013","ordinal":155916,"en":"Aychürök, daughter of Akun,"},{"id":"semetey-1-2013:p1045:b004:l014","ordinal":155917,"en":"Pulled off and removed"},{"id":"semetey-1-2013:p1045:b004:l015","ordinal":155918,"en":"Her gown made of fine broadcloth."},{"id":"semetey-1-2013:p1045:b004:l016","ordinal":155919,"en":"Swaying softly like dressed leather,"},{"id":"semetey-1-2013:p1045:b004:l017","ordinal":155920,"en":"Whimpering like a puppy,"},{"id":"semetey-1-2013:p1045:b004:l018","ordinal":155921,"en":"Her face shining like the sun,"},{"id":"semetey-1-2013:p1045:b004:l019","ordinal":155922,"en":"She lay down embracing"},{"id":"semetey-1-2013:p1045:b004:l020","ordinal":155923,"en":"Her sultan's breast."},{"id":"semetey-1-2013:p1045:b004:l021","ordinal":155924,"en":"They immersed themselves in delight,"},{"id":"semetey-1-2013:p1045:b004:l022","ordinal":155925,"en":"And lay upon one bed;"},{"id":"semetey-1-2013:p1045:b004:l023","ordinal":155926,"en":"Like two graceful wild ducks,"},{"id":"semetey-1-2013:p1045:b004:l024","ordinal":155927,"en":"They now came together."},{"id":"semetey-1-2013:p1045:b004:l025","ordinal":155928,"en":"Like an argali ewe and ram,"},{"id":"semetey-1-2013:p1045:b004:l026","ordinal":155929,"en":"They now entwined."},{"id":"semetey-1-2013:p1045:b004:l027","ordinal":155930,"en":"They lay upon one bed,"},{"id":"semetey-1-2013:p1045:b004:l028","ordinal":155931,"en":"Immersed in pleasure like this,"},{"id":"semetey-1-2013:p1045:b004:l029","ordinal":155932,"en":"And mingled like"},{"id":"semetey-1-2013:p1045:b004:l030","ordinal":155933,"en":"Flour made from white wheat;"},{"id":"semetey-1-2013:p1045:b004:l031","ordinal":155934,"en":"They slid against one another"},{"id":"semetey-1-2013:p1045:b004:l032","ordinal":155935,"en":"Like the hair of a white gazelle."},{"id":"semetey-1-2013:p1045:b004:l033","ordinal":155936,"en":"They joined by their own will,"},{"id":"semetey-1-2013:p1045:b004:l034","ordinal":155937,"en":"Embracing and kissing,"},{"id":"semetey-1-2013:p1045:b004:l035","ordinal":155938,"en":"Speaking in whispers,"},{"id":"semetey-1-2013:p1045:b004:l036","ordinal":155939,"en":"And laughing with ringing voices."},{"id":"semetey-1-2013:p1045:b004:l037","ordinal":155940,"en":"As the lovers lay embraced,"},{"id":"semetey-1-2013:p1045:b004:l038","ordinal":155941,"en":"When the fierce conqueror stirred,"},{"id":"semetey-1-2013:p1045:b004:l039","ordinal":155942,"en":"Chürök sprang up with a whimper."}]
