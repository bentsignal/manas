[{"id":"semetey-1-2013:p0113:b005:l006","ordinal":85505,"en":"Moving one by one toward the qibla."},{"id":"semetey-1-2013:p0113:b005:l007","ordinal":85506,"en":"Dawn brightened and swelled,"},{"id":"semetey-1-2013:p0113:b005:l008","ordinal":85507,"en":"Dawn split open, swelling forth."},{"id":"semetey-1-2013:p0113:b005:l009","ordinal":85508,"en":"Ah, father, the dawn broke clear;"},{"id":"semetey-1-2013:p0113:b005:l010","ordinal":85509,"en":"The Balance stars had set."},{"id":"semetey-1-2013:p0113:b005:l011","ordinal":85510,"en":"As the still dawn advanced,"},{"id":"semetey-1-2013:p0113:b005:l012","ordinal":85511,"en":"As light fell upon the earth,"},{"id":"semetey-1-2013:p0113:b005:l013","ordinal":85512,"en":"At Kara-Tash of Kayyp-Kyr,"},{"id":"semetey-1-2013:p0113:b005:l014","ordinal":85513,"en":"With wild rams and ibex mingled on its slopes,"},{"id":"semetey-1-2013:p0113:b005:l015","ordinal":85514,"en":"In the hollow of Chalkandy,"},{"id":"semetey-1-2013:p0113:b005:l016","ordinal":85515,"en":"Then Bakay the leopard"},{"id":"semetey-1-2013:p0113:b005:l017","ordinal":85516,"en":"Lay down and slept his fill."},{"id":"semetey-1-2013:p0113:b005:l018","ordinal":85517,"en":"At the orphan standing there pleading,"},{"id":"semetey-1-2013:p0113:b005:l019","ordinal":85518,"en":"He let the steeds graze."},{"id":"semetey-1-2013:p0113:b005:l020","ordinal":85519,"en":"At the clear water of a crossing spring,"},{"id":"semetey-1-2013:p0113:b005:l021","ordinal":85520,"en":"He let them quench their thirst."},{"id":"semetey-1-2013:p0113:b005:l022","ordinal":85521,"en":"The snuff in his tobacco box,"},{"id":"semetey-1-2013:p0113:b005:l023","ordinal":85522,"en":"Extending his fingers, he took a pinch,"},{"id":"semetey-1-2013:p0113:b005:l024","ordinal":85523,"en":"And put it against his palate."},{"id":"semetey-1-2013:p0113:b005:l025","ordinal":85524,"en":"Khan Bakay then spoke his sorrow."},{"id":"semetey-1-2013:p0113:b005:l026","ordinal":85525,"en":"“This Kara-Üngkür standing here"},{"id":"semetey-1-2013:p0113:b005:l027","ordinal":85526,"en":"Is the very cave where treasure was gathered."},{"id":"semetey-1-2013:p0113:b005:l028","ordinal":85527,"en":"Tears flow without stopping from my eyes."},{"id":"semetey-1-2013:p0113:b005:l029","ordinal":85528,"en":"While Khan Manas was alive,"},{"id":"semetey-1-2013:p0113:b005:l030","ordinal":85529,"en":"Gold and silver lay mingled."},{"id":"semetey-1-2013:p0113:b005:l031","ordinal":85530,"en":"It has become a stone that holds my gold,"},{"id":"semetey-1-2013:p0113:b005:l032","ordinal":85531,"en":"Since my precious one's eyes closed in death."},{"id":"semetey-1-2013:p0113:b005:l033","ordinal":85532,"en":"The six scoundrels have become the people's chiefs."},{"id":"semetey-1-2013:p0113:b005:l034","ordinal":85533,"en":"There you lie—farewell,"},{"id":"semetey-1-2013:p0113:b005:l035","ordinal":85534,"en":"My cave where treasure was gathered!"},{"id":"semetey-1-2013:p0113:b005:l036","ordinal":85535,"en":"Those who guarded my cave,"},{"id":"semetey-1-2013:p0113:b005:l037","ordinal":85536,"en":"With Khan Bölökböy at their head,"},{"id":"semetey-1-2013:p0113:b005:l038","ordinal":85537,"en":"Where have they gone, the noble ones,"},{"id":"semetey-1-2013:p0113:b005:l039","ordinal":85538,"en":"My forty-one guards.”"},{"id":"semetey-1-2013:p0114:b003:l001","ordinal":85539,"en":"Bakay leaned upon his battle-axe,"},{"id":"semetey-1-2013:p0114:b003:l002","ordinal":85540,"en":"Girding his waist firmly,"},{"id":"semetey-1-2013:p0114:b003:l003","ordinal":85541,"en":"He called aloud, “Bölökbay!”"},{"id":"semetey-1-2013:p0114:b003:l004","ordinal":85542,"en":"“They must have plundered my gold,"},{"id":"semetey-1-2013:p0114:b003:l005","ordinal":85543,"en":"And that poor Bölökbay,"},{"id":"semetey-1-2013:p0114:b003:l006","ordinal":85544,"en":"They must have cleaved him on the road."},{"id":"semetey-1-2013:p0114:b003:l007","ordinal":85545,"en":"Together they have brought my ruin."},{"id":"semetey-1-2013:p0114:b003:l008","ordinal":85546,"en":"O God, they must have slaughtered my forty-one!”"},{"id":"semetey-1-2013:p0114:b003:l010","ordinal":85547,"en":"Khan Bakay wept and wailed,"},{"id":"semetey-1-2013:p0114:b003:l011","ordinal":85548,"en":"Standing there, adding words to his lament."},{"id":"semetey-1-2013:p0114:b003:l012","ordinal":85549,"en":"Then the lame smith Bölökbay"},{"id":"semetey-1-2013:p0114:b003:l013","ordinal":85550,"en":"Heard the prince's voice."},{"id":"semetey-1-2013:p0114:b003:l014","ordinal":85551,"en":"From Zhar-Kyya of Zhangyryk,"},{"id":"semetey-1-2013:p0114:b003:l015","ordinal":85552,"en":"They were coming down,"},{"id":"semetey-1-2013:p0114:b003:l016","ordinal":85553,"en":"With the hero Bölökbay at their head."},{"id":"semetey-1-2013:p0114:b003:l017","ordinal":85554,"en":"There, in a line one horse wide,"},{"id":"semetey-1-2013:p0114:b003:l018","ordinal":85555,"en":"When the dogs assaulted the court,"},{"id":"semetey-1-2013:p0114:b003:l019","ordinal":85556,"en":"Laying hands upon the treasury,"},{"id":"semetey-1-2013:p0114:b003:l020","ordinal":85557,"en":"Drawing their bows like falling rain,"},{"id":"semetey-1-2013:p0114:b003:l021","ordinal":85558,"en":"When the dogs rushed in together,"},{"id":"semetey-1-2013:p0114:b003:l022","ordinal":85559,"en":"The treasure cave became a mountain,"},{"id":"semetey-1-2013:p0114:b003:l023","ordinal":85560,"en":"The six scoundrels and forty companions,"},{"id":"semetey-1-2013:p0114:b003:l024","ordinal":85561,"en":"All the Kyrgyz gathered together,"},{"id":"semetey-1-2013:p0114:b003:l025","ordinal":85562,"en":"Became Bölökbay's enemies."},{"id":"semetey-1-2013:p0114:b003:l026","ordinal":85563,"en":"Because of the treasury,"},{"id":"semetey-1-2013:p0114:b003:l027","ordinal":85564,"en":"They drew their bows like falling rain,"},{"id":"semetey-1-2013:p0114:b003:l028","ordinal":85565,"en":"Firing missiles like hail,"},{"id":"semetey-1-2013:p0114:b003:l029","ordinal":85566,"en":"Tormenting Bölökbay,"},{"id":"semetey-1-2013:p0114:b003:l030","ordinal":85567,"en":"Forcing their way into Manas's treasury."},{"id":"semetey-1-2013:p0114:b003:l031","ordinal":85568,"en":"Then the lame smith Bölökbay,"},{"id":"semetey-1-2013:p0114:b003:l032","ordinal":85569,"en":"Refusing to obey their words,"},{"id":"semetey-1-2013:p0114:b003:l033","ordinal":85570,"en":"Refusing to give up the treasure,"},{"id":"semetey-1-2013:p0114:b003:l034","ordinal":85571,"en":"For seven days in their midst,"},{"id":"semetey-1-2013:p0114:b003:l035","ordinal":85572,"en":"Bölökbay had held out,"},{"id":"semetey-1-2013:p0114:b003:l036","ordinal":85573,"en":"Taking wounds in seventy places."},{"id":"semetey-1-2013:p0114:b003:l037","ordinal":85574,"en":"The forty guards came out shooting,"},{"id":"semetey-1-2013:p0114:b003:l038","ordinal":85575,"en":"For six days amid the fighting,"},{"id":"semetey-1-2013:p0114:b003:l039","ordinal":85576,"en":"The poor men were at their wits' end,"},{"id":"semetey-1-2013:p0114:b004:l001","ordinal":85577,"en":"Taking wounds in sixty places."},{"id":"semetey-1-2013:p0114:b004:l002","ordinal":85578,"en":"Their four kinds of livestock scattered,"},{"id":"semetey-1-2013:p0114:b004:l003","ordinal":85579,"en":"Overwhelmed from above,"},{"id":"semetey-1-2013:p0114:b004:l004","ordinal":85580,"en":"Their star darkened in the sky."},{"id":"semetey-1-2013:p0114:b004:l005","ordinal":85581,"en":"After twelve days of shooting,"},{"id":"semetey-1-2013:p0114:b004:l006","ordinal":85582,"en":"Bölökbay broke free and escaped."},{"id":"semetey-1-2013:p0114:b004:l007","ordinal":85583,"en":"Abyke, Köbösh—the six scoundrels—"},{"id":"semetey-1-2013:p0114:b004:l008","ordinal":85584,"en":"Were not content with the gold."},{"id":"semetey-1-2013:p0114:b004:l009","ordinal":85585,"en":"“I shall catch Bölökbay and butcher him,"},{"id":"semetey-1-2013:p0114:b004:l010","ordinal":85586,"en":"I shall gouge out his eyes,"},{"id":"semetey-1-2013:p0114:b004:l011","ordinal":85587,"en":"I shall seize him and crush him,” they said."},{"id":"semetey-1-2013:p0114:b004:l012","ordinal":85588,"en":"They tracked his every trace,"},{"id":"semetey-1-2013:p0114:b004:l013","ordinal":85589,"en":"Pursuing him till they turned pale,"},{"id":"semetey-1-2013:p0114:b004:l014","ordinal":85590,"en":"As though he had slaughtered seven generations of their fathers,"},{"id":"semetey-1-2013:p0114:b004:l015","ordinal":85591,"en":"When they pursued him relentlessly,"},{"id":"semetey-1-2013:p0114:b004:l016","ordinal":85592,"en":"With their marksmen crouching,"},{"id":"semetey-1-2013:p0114:b004:l017","ordinal":85593,"en":"Sending them ahead,"},{"id":"semetey-1-2013:p0114:b004:l018","ordinal":85594,"en":"The most skillful of their spearmen,"},{"id":"semetey-1-2013:p0114:b004:l019","ordinal":85595,"en":"Their lances thrusting high,"},{"id":"semetey-1-2013:p0114:b004:l020","ordinal":85596,"en":"When they drove them into the foothills,"},{"id":"semetey-1-2013:p0114:b004:l021","ordinal":85597,"en":"On the narrow road of Zhangyryk,"},{"id":"semetey-1-2013:p0114:b004:l022","ordinal":85598,"en":"There was a black rock like a small yurt."},{"id":"semetey-1-2013:p0114:b004:l023","ordinal":85599,"en":"The tiger-like smith Bölökbay"},{"id":"semetey-1-2013:p0114:b004:l024","ordinal":85600,"en":"Had blocked their path."},{"id":"semetey-1-2013:p0114:b004:l025","ordinal":85601,"en":"Abyke's forty marksmen,"},{"id":"semetey-1-2013:p0114:b004:l026","ordinal":85602,"en":"The hero Köbösh's many marksmen,"},{"id":"semetey-1-2013:p0114:b004:l027","ordinal":85603,"en":"Köbösh had driven there."},{"id":"semetey-1-2013:p0114:b004:l028","ordinal":85604,"en":"In the days of Khan Manas,"},{"id":"semetey-1-2013:p0114:b004:l029","ordinal":85605,"en":"He had often entered battle against a shooting enemy."},{"id":"semetey-1-2013:p0114:b004:l030","ordinal":85606,"en":"Bölökbay had become a practiced fighter."},{"id":"semetey-1-2013:p0114:b004:l032","ordinal":85607,"en":"Knowing the hiding places well,"},{"id":"semetey-1-2013:p0114:b004:l033","ordinal":85608,"en":"Bölökbay had become experienced."},{"id":"semetey-1-2013:p0114:b004:l034","ordinal":85609,"en":"When he aimed, his gun never fired in vain;"},{"id":"semetey-1-2013:p0114:b004:l035","ordinal":85610,"en":"When he shot, his bullet never returned empty."},{"id":"semetey-1-2013:p0114:b004:l036","ordinal":85611,"en":"That mighty smith Bölökbay"},{"id":"semetey-1-2013:p0114:b004:l037","ordinal":85612,"en":"Had blocked the mountain pass."},{"id":"semetey-1-2013:p0114:b004:l038","ordinal":85613,"en":"Tormenting them with torment,"},{"id":"semetey-1-2013:p0114:b004:l039","ordinal":85614,"en":"Overpowering them with violence,"},{"id":"semetey-1-2013:p0115:b003:l001","ordinal":85615,"en":"Abyke and Köbösh, the six scoundrels,"},{"id":"semetey-1-2013:p0115:b003:l002","ordinal":85616,"en":"Had driven forty marksmen there."},{"id":"semetey-1-2013:p0115:b003:l003","ordinal":85617,"en":"That mighty smith Bölökbay,"},{"id":"semetey-1-2013:p0115:b003:l004","ordinal":85618,"en":"Your poor man upon the cliff,"},{"id":"semetey-1-2013:p0115:b003:l005","ordinal":85619,"en":"Upon the scoundrels Abyke and Köbösh,"},{"id":"semetey-1-2013:p0115:b003:l006","ordinal":85620,"en":"Had brought the Day of Judgment."},{"id":"semetey-1-2013:p0115:b003:l007","ordinal":85621,"en":"Köbösh's forty marksmen,"},{"id":"semetey-1-2013:p0115:b003:l008","ordinal":85622,"en":"Bölökbay upon the cliff"},{"id":"semetey-1-2013:p0115:b003:l009","ordinal":85623,"en":"Had slaughtered, letting none escape."},{"id":"semetey-1-2013:p0115:b003:l010","ordinal":85624,"en":"Abyke's forty warriors"},{"id":"semetey-1-2013:p0115:b003:l011","ordinal":85625,"en":"He had shot down in the foothills."},{"id":"semetey-1-2013:p0115:b003:l012","ordinal":85626,"en":"Bölökbay's forty guards"},{"id":"semetey-1-2013:p0115:b003:l013","ordinal":85627,"en":"He had brought through alive."},{"id":"semetey-1-2013:p0115:b003:l014","ordinal":85628,"en":"That Bakay had come,"},{"id":"semetey-1-2013:p0115:b003:l015","ordinal":85629,"en":"That God had granted his wish,"},{"id":"semetey-1-2013:p0115:b003:l016","ordinal":85630,"en":"He saw from the foothills."},{"id":"semetey-1-2013:p0115:b003:l017","ordinal":85631,"en":"The forty guards took counsel:"},{"id":"semetey-1-2013:p0115:b003:l018","ordinal":85632,"en":"“Bölökbay, you were khan to us all."},{"id":"semetey-1-2013:p0115:b003:l019","ordinal":85633,"en":"While sovereign Manas lived,"},{"id":"semetey-1-2013:p0115:b003:l020","ordinal":85634,"en":"You were a friend of David,"},{"id":"semetey-1-2013:p0115:b003:l021","ordinal":85635,"en":"A man like a prophet."},{"id":"semetey-1-2013:p0115:b003:l022","ordinal":85636,"en":"Smoke rises from that bluff;"},{"id":"semetey-1-2013:p0115:b003:l023","ordinal":85637,"en":"With a reddish bay horse,"},{"id":"semetey-1-2013:p0115:b003:l024","ordinal":85638,"en":"A stately man is visible."},{"id":"semetey-1-2013:p0115:b003:l025","ordinal":85639,"en":"It may be the hero Bakay himself,"},{"id":"semetey-1-2013:p0115:b003:l026","ordinal":85640,"en":"With the orphan and the widow,"},{"id":"semetey-1-2013:p0115:b003:l027","ordinal":85641,"en":"Perhaps he is bringing them through."},{"id":"semetey-1-2013:p0115:b003:l028","ordinal":85642,"en":"As I judge his appearance,"},{"id":"semetey-1-2013:p0115:b003:l029","ordinal":85643,"en":"He seems like Bakay."},{"id":"semetey-1-2013:p0115:b003:l030","ordinal":85644,"en":"Can it be my sovereign himself?"},{"id":"semetey-1-2013:p0115:b003:l031","ordinal":85645,"en":"Look closely, forty guards:"},{"id":"semetey-1-2013:p0115:b003:l032","ordinal":85646,"en":"His outline, his bearing,"},{"id":"semetey-1-2013:p0115:b003:l033","ordinal":85647,"en":"His appearance upon horseback—"},{"id":"semetey-1-2013:p0115:b003:l034","ordinal":85648,"en":"It is my elder Bakay himself."},{"id":"semetey-1-2013:p0115:b003:l035","ordinal":85649,"en":"Finding those fugitives,"},{"id":"semetey-1-2013:p0115:b003:l036","ordinal":85650,"en":"My elder, without despairing,"},{"id":"semetey-1-2013:p0115:b003:l037","ordinal":85651,"en":"Has been preparing horses."},{"id":"semetey-1-2013:p0115:b003:l038","ordinal":85652,"en":"The orphan and the widow,"},{"id":"semetey-1-2013:p0115:b003:l039","ordinal":85653,"en":"It is time to send them on their way."},{"id":"semetey-1-2013:p0115:b005:l001","ordinal":85654,"en":"Unless he sends them on and gains peace,"},{"id":"semetey-1-2013:p0115:b005:l002","ordinal":85655,"en":"Otherwise Bakay the tiger"},{"id":"semetey-1-2013:p0115:b005:l003","ordinal":85656,"en":"Seems ready to die."},{"id":"semetey-1-2013:p0115:b005:l004","ordinal":85657,"en":"My sorrow-stricken sister-in-law,"},{"id":"semetey-1-2013:p0115:b005:l005","ordinal":85658,"en":"My tiger-like elder, Khan Bakay,"},{"id":"semetey-1-2013:p0115:b005:l006","ordinal":85659,"en":"Seems to be sending her on her way."},{"id":"semetey-1-2013:p0115:b005:l007","ordinal":85660,"en":"‘I shall come to meet them,’ he said."},{"id":"semetey-1-2013:p0115:b005:l008","ordinal":85661,"en":"O Almighty, Bahauddin!"},{"id":"semetey-1-2013:p0115:b005:l009","ordinal":85662,"en":"Now he has come to us."},{"id":"semetey-1-2013:p0115:b005:l010","ordinal":85663,"en":"It is my elder Bakay himself;"},{"id":"semetey-1-2013:p0115:b005:l011","ordinal":85664,"en":"Not merely himself—his very dark eyes!”"},{"id":"semetey-1-2013:p0115:b005:l012","ordinal":85665,"en":"The mighty hero Bölökbay,"},{"id":"semetey-1-2013:p0115:b005:l013","ordinal":85666,"en":"And the forty guards who supported him,"},{"id":"semetey-1-2013:p0115:b005:l014","ordinal":85667,"en":"Made toward Khan Bakay."},{"id":"semetey-1-2013:p0115:b005:l015","ordinal":85668,"en":"All ran with a clatter,"},{"id":"semetey-1-2013:p0115:b005:l016","ordinal":85669,"en":"Shouting, “Manas! Manas!”"},{"id":"semetey-1-2013:p0115:b005:l017","ordinal":85670,"en":"Calling “Manas!” as their battle cry,"},{"id":"semetey-1-2013:p0115:b005:l018","ordinal":85671,"en":"Shouting their cry as they ran."},{"id":"semetey-1-2013:p0115:b005:l019","ordinal":85672,"en":"Robbed of his treasury,"},{"id":"semetey-1-2013:p0115:b005:l020","ordinal":85673,"en":"Grief-stricken Bölökbay,"},{"id":"semetey-1-2013:p0115:b005:l021","ordinal":85674,"en":"When he saw Khan Bakay,"},{"id":"semetey-1-2013:p0115:b005:l022","ordinal":85675,"en":"Bölökbay burst into tears."},{"id":"semetey-1-2013:p0115:b005:l023","ordinal":85676,"en":"“Elder Bakay, you leopard,"},{"id":"semetey-1-2013:p0115:b005:l024","ordinal":85677,"en":"The forty companions left by Manas"},{"id":"semetey-1-2013:p0115:b005:l025","ordinal":85678,"en":"Have shown themselves to be unruly."},{"id":"semetey-1-2013:p0115:b005:l026","ordinal":85679,"en":"Manas the leopard, favored by Kyzyr,"},{"id":"semetey-1-2013:p0115:b005:l027","ordinal":85680,"en":"Now we know that he is gone!"},{"id":"semetey-1-2013:p0115:b005:l028","ordinal":85681,"en":"The forty guards beside him, his companions,"},{"id":"semetey-1-2013:p0115:b005:l029","ordinal":85682,"en":"Elder Bakay, I prepared as though I would never die."},{"id":"semetey-1-2013:p0115:b005:l030","ordinal":85683,"en":"For twelve days we exchanged fire;"},{"id":"semetey-1-2013:p0115:b005:l031","ordinal":85684,"en":"Only at death's door did I escape those dogs!"},{"id":"semetey-1-2013:p0115:b005:l032","ordinal":85685,"en":"Elder Bakay, I had my muscles spoiled by fire."},{"id":"semetey-1-2013:p0115:b005:l033","ordinal":85686,"en":"It was God's decree."},{"id":"semetey-1-2013:p0115:b005:l034","ordinal":85687,"en":"In my grief, finding no hero like you,"},{"id":"semetey-1-2013:p0115:b005:l035","ordinal":85688,"en":"All my ribs"},{"id":"semetey-1-2013:p0115:b005:l036","ordinal":85689,"en":"Were torn away by arrows."},{"id":"semetey-1-2013:p0115:b005:l037","ordinal":85690,"en":"A deep pit has been dug for me,"},{"id":"semetey-1-2013:p0115:b005:l038","ordinal":85691,"en":"No steadfast hero like you came to my treasury,"},{"id":"semetey-1-2013:p0116:b003:l001","ordinal":85692,"en":"Bölökbay has layer upon layer of boiling sorrow."},{"id":"semetey-1-2013:p0116:b003:l003","ordinal":85693,"en":"Parted from the treasure and possessions,"},{"id":"semetey-1-2013:p0116:b003:l004","ordinal":85694,"en":"I have been left wandering in the wilderness."},{"id":"semetey-1-2013:p0116:b003:l005","ordinal":85695,"en":"Elder Bakay, Semetey, left by the generous hero,"},{"id":"semetey-1-2013:p0116:b003:l007","ordinal":85696,"en":"When he comes in days to come,"},{"id":"semetey-1-2013:p0116:b003:l008","ordinal":85697,"en":"‘Elder Bölökbay, favored by Kyzyr,"},{"id":"semetey-1-2013:p0116:b003:l009","ordinal":85698,"en":"You were a friend of David,"},{"id":"semetey-1-2013:p0116:b003:l010","ordinal":85699,"en":"Where is my treasury?’—when he says that,"},{"id":"semetey-1-2013:p0116:b003:l011","ordinal":85700,"en":"If my appointed death arrives, I shall die."},{"id":"semetey-1-2013:p0116:b003:l012","ordinal":85701,"en":"To that one child, Semetey,"},{"id":"semetey-1-2013:p0116:b003:l013","ordinal":85702,"en":"What answer shall I give?"},{"id":"semetey-1-2013:p0116:b003:l014","ordinal":85703,"en":"Elder Bakay, God has robbed me of my means;"},{"id":"semetey-1-2013:p0116:b003:l015","ordinal":85704,"en":"Allah has exhausted my words."},{"id":"semetey-1-2013:p0116:b003:l016","ordinal":85705,"en":"When my orphan reaches twelve,"},{"id":"semetey-1-2013:p0116:b003:l017","ordinal":85706,"en":"And asks, ‘Where is my treasury?’"},{"id":"semetey-1-2013:p0116:b003:l018","ordinal":85707,"en":"Elder Bakay, find me some way out."},{"id":"semetey-1-2013:p0116:b003:l019","ordinal":85708,"en":"When my sister-in-law, fierce Kanykey, comes,"},{"id":"semetey-1-2013:p0116:b003:l020","ordinal":85709,"en":"What words shall I say!"},{"id":"semetey-1-2013:p0116:b003:l021","ordinal":85710,"en":"Elder Bakay, I was struck on my right side."},{"id":"semetey-1-2013:p0116:b003:l022","ordinal":85711,"en":"The gathered gold and wealth"},{"id":"semetey-1-2013:p0116:b003:l023","ordinal":85712,"en":"I lost to your dogs."},{"id":"semetey-1-2013:p0116:b003:l024","ordinal":85713,"en":"The gold gathered beyond counting,"},{"id":"semetey-1-2013:p0116:b003:l025","ordinal":85714,"en":"Hacking with battle-axes and battering,"},{"id":"semetey-1-2013:p0116:b003:l026","ordinal":85715,"en":"The scoundrels plundered and took it."},{"id":"semetey-1-2013:p0116:b003:l027","ordinal":85716,"en":"Without a renowned lion like you,"},{"id":"semetey-1-2013:p0116:b003:l028","ordinal":85717,"en":"I have been left to suffer torment."},{"id":"semetey-1-2013:p0116:b003:l029","ordinal":85718,"en":"Finding no support to brace myself upon,"},{"id":"semetey-1-2013:p0116:b003:l030","ordinal":85719,"en":"To bind up my waist,"},{"id":"semetey-1-2013:p0116:b003:l031","ordinal":85720,"en":"To slaughter the six scoundrels,"},{"id":"semetey-1-2013:p0116:b003:l032","ordinal":85721,"en":"Finding no renowned hero like you,"},{"id":"semetey-1-2013:p0116:b003:l033","ordinal":85722,"en":"Skirting the cliffs of Zhangyryk,"},{"id":"semetey-1-2013:p0116:b003:l034","ordinal":85723,"en":"Leaning upon Boz-Kelte,"},{"id":"semetey-1-2013:p0116:b003:l035","ordinal":85724,"en":"I escaped from the pass.”"},{"id":"semetey-1-2013:p0116:b003:l036","ordinal":85725,"en":"Then Bölökbay wept and lamented."},{"id":"semetey-1-2013:p0116:b003:l037","ordinal":85726,"en":"Looking at the forty warriors,"},{"id":"semetey-1-2013:p0116:b003:l038","ordinal":85727,"en":"They had no fur caps, their heads were bare."},{"id":"semetey-1-2013:p0116:b004:l001","ordinal":85728,"en":"Some had no trousers and were naked."},{"id":"semetey-1-2013:p0116:b004:l002","ordinal":85729,"en":"Looking at some—"},{"id":"semetey-1-2013:p0116:b004:l003","ordinal":85730,"en":"They were barefoot and bareheaded."},{"id":"semetey-1-2013:p0116:b004:l004","ordinal":85731,"en":"Looking at some—"},{"id":"semetey-1-2013:p0116:b004:l005","ordinal":85732,"en":"Their muscles were ruined by bullets."},{"id":"semetey-1-2013:p0116:b004:l006","ordinal":85733,"en":"Looking at some—"},{"id":"semetey-1-2013:p0116:b004:l007","ordinal":85734,"en":"The backs of their knees were torn by arrows."},{"id":"semetey-1-2013:p0116:b004:l008","ordinal":85735,"en":"In utter turmoil and dust,"},{"id":"semetey-1-2013:p0116:b004:l009","ordinal":85736,"en":"Looking at their whole bodies—"},{"id":"semetey-1-2013:p0116:b004:l010","ordinal":85737,"en":"They were red buckets of blood."},{"id":"semetey-1-2013:p0116:b004:l011","ordinal":85738,"en":"Looking at both their hands—"},{"id":"semetey-1-2013:p0116:b004:l012","ordinal":85739,"en":"They hung paralyzed, unable to rise."},{"id":"semetey-1-2013:p0116:b004:l013","ordinal":85740,"en":"Looking at their whole bodies—"},{"id":"semetey-1-2013:p0116:b004:l014","ordinal":85741,"en":"With the hero Bölökbay at their head,"},{"id":"semetey-1-2013:p0116:b004:l015","ordinal":85742,"en":"They were stunned, unable to stir."},{"id":"semetey-1-2013:p0116:b004:l016","ordinal":85743,"en":"When the dogs attacked them unexpectedly,"},{"id":"semetey-1-2013:p0116:b004:l017","ordinal":85744,"en":"Their dear lives were sorely pressed."},{"id":"semetey-1-2013:p0116:b004:l018","ordinal":85745,"en":"As they fled in panic,"},{"id":"semetey-1-2013:p0116:b004:l019","ordinal":85746,"en":"They had exchanged fire for twelve days,"},{"id":"semetey-1-2013:p0116:b004:l020","ordinal":85747,"en":"And barely escaped death."},{"id":"semetey-1-2013:p0116:b004:l021","ordinal":85748,"en":"With no bluff in which to hide,"},{"id":"semetey-1-2013:p0116:b004:l022","ordinal":85749,"en":"They had become destitute."},{"id":"semetey-1-2013:p0116:b004:l023","ordinal":85750,"en":"Bölökbay and his forty guards"},{"id":"semetey-1-2013:p0116:b004:l024","ordinal":85751,"en":"Had become gaunt."},{"id":"semetey-1-2013:p0116:b004:l025","ordinal":85752,"en":"For seven days in the fighting,"},{"id":"semetey-1-2013:p0116:b004:l026","ordinal":85753,"en":"Taking wounds in seventy places,"},{"id":"semetey-1-2013:p0116:b004:l027","ordinal":85754,"en":"They had seen terrible suffering."},{"id":"semetey-1-2013:p0116:b004:l028","ordinal":85755,"en":"They had loaded their baggage upon a calf."},{"id":"semetey-1-2013:p0116:b004:l029","ordinal":85756,"en":"Sheltering in the mountains, fleeing on foot,"},{"id":"semetey-1-2013:p0116:b004:l030","ordinal":85757,"en":"They had suffered a dreadful hell!"},{"id":"semetey-1-2013:p0116:b004:l032","ordinal":85758,"en":"Then the wide world became narrow;"},{"id":"semetey-1-2013:p0116:b004:l033","ordinal":85759,"en":"When those great dogs overwhelmed them,"},{"id":"semetey-1-2013:p0116:b004:l034","ordinal":85760,"en":"The gray-maned prince Bakay,"}]
