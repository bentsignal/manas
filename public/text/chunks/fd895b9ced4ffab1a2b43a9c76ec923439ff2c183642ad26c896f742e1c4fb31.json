[{"id":"seytek-2012:p0456:b003:l019","ordinal":328449,"en":"Eat plenty of food"},{"id":"seytek-2012:p0456:b003:l020","ordinal":328450,"en":"Murdered by disappearance,"},{"id":"seytek-2012:p0456:b003:l021","ordinal":328451,"en":"Deer suckling,"},{"id":"seytek-2012:p0456:b003:l022","ordinal":328452,"en":"Born into the world"},{"id":"seytek-2012:p0456:b003:l023","ordinal":328453,"en":"It is true that he came."},{"id":"seytek-2012:p0456:b003:l024","ordinal":328454,"en":"Made a wish,"},{"id":"seytek-2012:p0456:b003:l025","ordinal":328455,"en":"It is true that he gave."},{"id":"seytek-2012:p0456:b003:l026","ordinal":328456,"en":"A lion on the ground,"},{"id":"seytek-2012:p0456:b003:l027","ordinal":328457,"en":"Be a man who conquers the universe,"},{"id":"seytek-2012:p0456:b003:l028","ordinal":328458,"en":"All twelve members"},{"id":"seytek-2012:p0456:b003:l029","ordinal":328459,"en":"It is true that he came."},{"id":"seytek-2012:p0456:b003:l030","ordinal":328460,"en":"There was a blue mane and a lion."},{"id":"seytek-2012:p0456:b003:l031","ordinal":328461,"en":"They say they are dead, but they are alive."},{"id":"seytek-2012:p0456:b003:l032","ordinal":328462,"en":"One of the undead."},{"id":"seytek-2012:p0456:b003:l033","ordinal":328463,"en":"Chinar has black eyes."},{"id":"seytek-2012:p0456:b003:l034","ordinal":328464,"en":"It's the real blue man himself."},{"id":"seytek-2012:p0456:b003:l035","ordinal":328465,"en":"It's busy, it's a virgin,"},{"id":"seytek-2012:p0456:b003:l036","ordinal":328466,"en":"What the black giant said"},{"id":"seytek-2012:p0456:b003:l037","ordinal":328467,"en":"It's not a lie, it's true\" -"},{"id":"seytek-2012:p0456:b003:l038","ordinal":328468,"en":"So, so, Kulchoro,"},{"id":"seytek-2012:p0456:b003:l039","ordinal":328469,"en":"Burned lungs,"},{"id":"seytek-2012:p0456:b003:l040","ordinal":328470,"en":"More happy than death."},{"id":"seytek-2012:p0457:b002:l001","ordinal":328471,"en":"Thirteen years have passed."},{"id":"seytek-2012:p0457:b002:l002","ordinal":328472,"en":"When you ponder this treacherous world,"},{"id":"seytek-2012:p0457:b002:l003","ordinal":328473,"en":"So great have its horrors become."},{"id":"seytek-2012:p0457:b002:l004","ordinal":328474,"en":"Since the magnanimous lord departed,"},{"id":"seytek-2012:p0457:b002:l005","ordinal":328475,"en":"The head has gone to ruin,"},{"id":"seytek-2012:p0457:b002:l006","ordinal":328476,"en":"The feet have gone astray,"},{"id":"seytek-2012:p0457:b002:l007","ordinal":328477,"en":"Fire has engulfed the royal camp,"},{"id":"seytek-2012:p0457:b002:l008","ordinal":328478,"en":"The people have been carried off as spoil,"},{"id":"seytek-2012:p0457:b002:l009","ordinal":328479,"en":"Aichürök has remained in mourning,"},{"id":"seytek-2012:p0457:b002:l010","ordinal":328480,"en":"Külchoro has remained wounded."},{"id":"seytek-2012:p0457:b002:l011","ordinal":328481,"en":"Kanykei and Bakai met with disaster,"},{"id":"seytek-2012:p0457:b002:l012","ordinal":328482,"en":"His right shoulder was gouged,"},{"id":"seytek-2012:p0457:b002:l013","ordinal":328483,"en":"And Külchoro was taken into slavery."},{"id":"seytek-2012:p0457:b002:l014","ordinal":328484,"en":"Aichürök donned black,"},{"id":"seytek-2012:p0457:b002:l015","ordinal":328485,"en":"Went to Kyyaz, and lived as a widow."},{"id":"seytek-2012:p0457:b002:l016","ordinal":328486,"en":"Brave Seytek, left within her womb,"},{"id":"seytek-2012:p0457:b002:l017","ordinal":328487,"en":"Became a son to the Jediger."},{"id":"seytek-2012:p0457:b002:l018","ordinal":328488,"en":"Grieving and humiliated,"},{"id":"seytek-2012:p0457:b002:l019","ordinal":328489,"en":"Aichürök endured affliction;"},{"id":"seytek-2012:p0457:b002:l020","ordinal":328490,"en":"Both shoulders gouged,"},{"id":"seytek-2012:p0457:b002:l021","ordinal":328491,"en":"Külchoro carried firewood."},{"id":"seytek-2012:p0457:b002:l022","ordinal":328492,"en":"He fed the bustard to the birds,"},{"id":"seytek-2012:p0457:b002:l023","ordinal":328493,"en":"Blotted out his mountain-high name,"},{"id":"seytek-2012:p0457:b002:l024","ordinal":328494,"en":"Made Seytek his dependent,"},{"id":"seytek-2012:p0457:b002:l025","ordinal":328495,"en":"And had him called Kyyaz’s son."},{"id":"seytek-2012:p0457:b002:l026","ordinal":328496,"en":"Talas became a desolate road,"},{"id":"seytek-2012:p0457:b002:l027","ordinal":328497,"en":"His mother Kanykei"},{"id":"seytek-2012:p0457:b002:l028","ordinal":328498,"en":"Was left utterly helpless,"},{"id":"seytek-2012:p0457:b002:l029","ordinal":328499,"en":"The daughters and brides became widows,"},{"id":"seytek-2012:p0457:b002:l030","ordinal":328500,"en":"And Muzoochu became a black slave-woman."},{"id":"seytek-2012:p0457:b002:l031","ordinal":328501,"en":"The nobles fled and scattered,"},{"id":"seytek-2012:p0457:b002:l032","ordinal":328502,"en":"His elder Bakai, the old man,"},{"id":"seytek-2012:p0457:b002:l033","ordinal":328503,"en":"Was plundered by wrestlers."},{"id":"seytek-2012:p0457:b002:l034","ordinal":328504,"en":"May his equal be steeped in sorrow—"},{"id":"seytek-2012:p0457:b002:l035","ordinal":328505,"en":"Such varied fates were created."},{"id":"seytek-2012:p0457:b002:l036","ordinal":328506,"en":"For whom was this humiliation?"},{"id":"seytek-2012:p0457:b002:l037","ordinal":328507,"en":"Though one looks, he cannot be seen,"},{"id":"seytek-2012:p0457:b002:l038","ordinal":328508,"en":"And no one knows where he is—"},{"id":"seytek-2012:p0457:b002:l039","ordinal":328509,"en":"It was for the vanished lord,"},{"id":"seytek-2012:p0457:b002:l040","ordinal":328510,"en":"For the lord had disappeared from sight."},{"id":"seytek-2012:p0457:b003:l001","ordinal":328511,"en":"And from that poor Black Giant’s"},{"id":"seytek-2012:p0457:b003:l002","ordinal":328512,"en":"Two eyes the tears flowed,"},{"id":"seytek-2012:p0457:b003:l003","ordinal":328513,"en":"Streaming down his sacred mane."},{"id":"seytek-2012:p0457:b003:l004","ordinal":328514,"en":"The sword had slipped from its sheath,"},{"id":"seytek-2012:p0457:b003:l005","ordinal":328515,"en":"Many of his words rang true;"},{"id":"seytek-2012:p0457:b003:l006","ordinal":328516,"en":"What he had seen of the bloodthirsty lion"},{"id":"seytek-2012:p0457:b003:l007","ordinal":328517,"en":"Proved true, not false."},{"id":"seytek-2012:p0457:b003:l008","ordinal":328518,"en":"At the soothsayer’s black cave,"},{"id":"seytek-2012:p0457:b003:l009","ordinal":328519,"en":"Where the path into the dark cavern was stained red,"},{"id":"seytek-2012:p0457:b003:l010","ordinal":328520,"en":"The elder and younger kinsmen,"},{"id":"seytek-2012:p0457:b003:l011","ordinal":328521,"en":"Külchoro and Semetey,"},{"id":"seytek-2012:p0457:b003:l012","ordinal":328522,"en":"Met upon the open plain."},{"id":"seytek-2012:p0457:b003:l013","ordinal":328523,"en":"Külchoro wailed and wept,"},{"id":"seytek-2012:p0457:b003:l014","ordinal":328524,"en":"Steeling himself like a bird of prey,"},{"id":"seytek-2012:p0457:b003:l015","ordinal":328525,"en":"Pleading, “Elder brother!”"},{"id":"seytek-2012:p0457:b003:l016","ordinal":328526,"en":"He seized the bridle"},{"id":"seytek-2012:p0457:b003:l017","ordinal":328527,"en":"And turned the noble Buurul."},{"id":"seytek-2012:p0457:b003:l018","ordinal":328528,"en":"When he saw the gray-maned lion,"},{"id":"seytek-2012:p0457:b003:l019","ordinal":328529,"en":"His heart was wrung;"},{"id":"seytek-2012:p0457:b003:l020","ordinal":328530,"en":"The tears flowing down both cheeks"},{"id":"seytek-2012:p0457:b003:l021","ordinal":328531,"en":"Fell over his breast."},{"id":"seytek-2012:p0457:b003:l022","ordinal":328532,"en":"The blood drained from his ruddy face,"},{"id":"seytek-2012:p0457:b003:l023","ordinal":328533,"en":"And Külchoro lost his strength;"},{"id":"seytek-2012:p0457:b003:l024","ordinal":328534,"en":"His heart was wrung,"},{"id":"seytek-2012:p0457:b003:l025","ordinal":328535,"en":"And the tears flowing from both eyes"},{"id":"seytek-2012:p0457:b003:l026","ordinal":328536,"en":"Fell over his breast."},{"id":"seytek-2012:p0457:b003:l027","ordinal":328537,"en":"His strength failed and he grew faint,"},{"id":"seytek-2012:p0457:b003:l028","ordinal":328538,"en":"His joints went slack and his life ebbed;"},{"id":"seytek-2012:p0457:b003:l029","ordinal":328539,"en":"His tiny soul became flame,"},{"id":"seytek-2012:p0457:b003:l030","ordinal":328540,"en":"When his true elder brother appeared."},{"id":"seytek-2012:p0457:b003:l031","ordinal":328541,"en":"When he saw his true elder brother,"},{"id":"seytek-2012:p0457:b003:l032","ordinal":328542,"en":"The poor man could not endure it;"},{"id":"seytek-2012:p0457:b003:l033","ordinal":328543,"en":"His heart was pierced and torn apart."},{"id":"seytek-2012:p0457:b003:l034","ordinal":328544,"en":"The precious lion had come into his hands,"},{"id":"seytek-2012:p0457:b003:l035","ordinal":328545,"en":"And this accursed, treacherous world"},{"id":"seytek-2012:p0457:b003:l036","ordinal":328546,"en":"Seemed no broader than a handful."},{"id":"seytek-2012:p0457:b003:l037","ordinal":328547,"en":"Külchoro and the Black Giant"},{"id":"seytek-2012:p0457:b003:l038","ordinal":328548,"en":"Clung to the hero and wept,"},{"id":"seytek-2012:p0457:b003:l039","ordinal":328549,"en":"And the Argyn-Kyrgyz people wept"},{"id":"seytek-2012:p0457:b003:l040","ordinal":328550,"en":"Because the gray-maned lion had vanished."},{"id":"seytek-2012:p0458:b002:l001","ordinal":328551,"en":"If we set his blessed road before us,"},{"id":"seytek-2012:p0458:b002:l002","ordinal":328552,"en":"He would lead countless armies."},{"id":"seytek-2012:p0458:b002:l003","ordinal":328553,"en":"The glory of the gated city,"},{"id":"seytek-2012:p0458:b002:l004","ordinal":328554,"en":"The city of the deep-rooted plane tree—"},{"id":"seytek-2012:p0458:b002:l005","ordinal":328555,"en":"Brave Külchoro found him,"},{"id":"seytek-2012:p0458:b002:l006","ordinal":328556,"en":"And his lord was restored to the seat of honor;"},{"id":"seytek-2012:p0458:b002:l007","ordinal":328557,"en":"Thus the disgraced Choro’s"},{"id":"seytek-2012:p0458:b002:l008","ordinal":328558,"en":"Honor was restored."},{"id":"seytek-2012:p0458:b002:l009","ordinal":328559,"en":"“Is this waking,” he said, “or a dream?"},{"id":"seytek-2012:p0458:b002:l010","ordinal":328560,"en":"Is this the lord I longed for?"},{"id":"seytek-2012:p0458:b002:l011","ordinal":328561,"en":"Is this my gray-maned lion himself,"},{"id":"seytek-2012:p0458:b002:l012","ordinal":328562,"en":"The very eye of the tiger,"},{"id":"seytek-2012:p0458:b002:l013","ordinal":328563,"en":"Encountered as if by providence,"},{"id":"seytek-2012:p0458:b002:l014","ordinal":328564,"en":"Found upon the white plain,"},{"id":"seytek-2012:p0458:b002:l015","ordinal":328565,"en":"Met after vanishing on the road—"},{"id":"seytek-2012:p0458:b002:l016","ordinal":328566,"en":"Is this my tiger himself?”"},{"id":"seytek-2012:p0458:b002:l017","ordinal":328567,"en":"He would not release"},{"id":"seytek-2012:p0458:b002:l018","ordinal":328568,"en":"The bridle of noble Buurul."},{"id":"seytek-2012:p0458:b002:l019","ordinal":328569,"en":"Blazing with anguish, he gathered himself,"},{"id":"seytek-2012:p0458:b002:l020","ordinal":328570,"en":"And the noble warrior pleaded;"},{"id":"seytek-2012:p0458:b002:l021","ordinal":328571,"en":"Glowing and flaring like an ember,"},{"id":"seytek-2012:p0458:b002:l022","ordinal":328572,"en":"When he saw his lion of a hero,"},{"id":"seytek-2012:p0458:b002:l023","ordinal":328573,"en":"How could the sorrow-laden warrior"},{"id":"seytek-2012:p0458:b002:l024","ordinal":328574,"en":"Possibly stand still?"},{"id":"seytek-2012:p0458:b002:l025","ordinal":328575,"en":"Ripened and blazing like an ember,"},{"id":"seytek-2012:p0458:b002:l026","ordinal":328576,"en":"The wretched man who had seen his lord—"},{"id":"seytek-2012:p0458:b002:l027","ordinal":328577,"en":"How could he endure and stand still?"},{"id":"seytek-2012:p0458:b002:l028","ordinal":328578,"en":"Külchoro burned with a righteous flame,"},{"id":"seytek-2012:p0458:b002:l029","ordinal":328579,"en":"A bare sword hung at his side,"},{"id":"seytek-2012:p0458:b002:l030","ordinal":328580,"en":"And, pleading “Elder brother,”"},{"id":"seytek-2012:p0458:b002:l031","ordinal":328581,"en":"Külchoro stood there burning."},{"id":"seytek-2012:p0458:b002:l032","ordinal":328582,"en":"He remains rigid and takes no heed,"},{"id":"seytek-2012:p0458:b002:l033","ordinal":328583,"en":"And holds the sobbing Choro"},{"id":"seytek-2012:p0458:b002:l034","ordinal":328584,"en":"Of no more account than his boot-heel."},{"id":"seytek-2012:p0458:b002:l035","ordinal":328585,"en":"No distinct words leave his mouth;"},{"id":"seytek-2012:p0458:b002:l036","ordinal":328586,"en":"When they wail aloud, he hears no speech."},{"id":"seytek-2012:p0458:b002:l037","ordinal":328587,"en":"If called alive, he seems dead;"},{"id":"seytek-2012:p0458:b002:l038","ordinal":328588,"en":"If called dead, he seems alive;"},{"id":"seytek-2012:p0458:b002:l039","ordinal":328589,"en":"The lord and the Choro"},{"id":"seytek-2012:p0458:b002:l040","ordinal":328590,"en":"Cannot come to an understanding."},{"id":"seytek-2012:p0458:b003:l001","ordinal":328591,"en":"For the sake of the tens of thousands,"},{"id":"seytek-2012:p0458:b003:l002","ordinal":328592,"en":"Because the lord was gone from sight,"},{"id":"seytek-2012:p0458:b003:l003","ordinal":328593,"en":"The Argyn-Kyrgyz people of Talas"},{"id":"seytek-2012:p0458:b003:l004","ordinal":328594,"en":"Found the Ala-Too passes turned to mere roads,"},{"id":"seytek-2012:p0458:b003:l005","ordinal":328595,"en":"And this nation was humiliated by all."},{"id":"seytek-2012:p0458:b003:l006","ordinal":328596,"en":"They mowed meadow grass as tribute,"},{"id":"seytek-2012:p0458:b003:l007","ordinal":328597,"en":"And paid heavy taxes and levies;"},{"id":"seytek-2012:p0458:b003:l008","ordinal":328598,"en":"What they saw was utter darkness,"},{"id":"seytek-2012:p0458:b003:l009","ordinal":328599,"en":"And what they endured was a day of torment."},{"id":"seytek-2012:p0458:b003:l010","ordinal":328600,"en":"When the khan departed from the Kyrgyz,"},{"id":"seytek-2012:p0458:b003:l011","ordinal":328601,"en":"Food vanished from their cauldron,"},{"id":"seytek-2012:p0458:b003:l012","ordinal":328602,"en":"And their dear people lost their head."},{"id":"seytek-2012:p0458:b003:l013","ordinal":328603,"en":"No one could bear another,"},{"id":"seytek-2012:p0458:b003:l014","ordinal":328604,"en":"No one heeded another’s words;"},{"id":"seytek-2012:p0458:b003:l015","ordinal":328605,"en":"They drove away the noble lord with lamentation,"},{"id":"seytek-2012:p0458:b003:l016","ordinal":328606,"en":"And clamored like plundering ravens."},{"id":"seytek-2012:p0458:b003:l017","ordinal":328607,"en":"Grief spread among the people,"},{"id":"seytek-2012:p0458:b003:l018","ordinal":328608,"en":"And many were beaten and humiliated."},{"id":"seytek-2012:p0458:b003:l019","ordinal":328609,"en":"Such was the people’s degradation,"},{"id":"seytek-2012:p0458:b003:l020","ordinal":328610,"en":"All their warriors became slaves,"},{"id":"seytek-2012:p0458:b003:l021","ordinal":328611,"en":"And the people’s suffering became a commodity;"},{"id":"seytek-2012:p0458:b003:l022","ordinal":328612,"en":"This honored hero here"},{"id":"seytek-2012:p0458:b003:l023","ordinal":328613,"en":"Became a slave to one man after another."},{"id":"seytek-2012:p0458:b003:l024","ordinal":328614,"en":"Now this is the state of the people.”"},{"id":"seytek-2012:p0458:b003:l025","ordinal":328615,"en":"Speaking thus, Külchoro"},{"id":"seytek-2012:p0458:b003:l026","ordinal":328616,"en":"Seethed as his heart dissolved,"},{"id":"seytek-2012:p0458:b003:l027","ordinal":328617,"en":"And, meeting the bloodthirsty warrior this way,"},{"id":"seytek-2012:p0458:b003:l028","ordinal":328618,"en":"Told how the hills held deer and the plains argali,"},{"id":"seytek-2012:p0458:b003:l029","ordinal":328619,"en":"Explaining the nature of the land;"},{"id":"seytek-2012:p0458:b003:l030","ordinal":328620,"en":"Then of the walled city and the people at the gates"},{"id":"seytek-2012:p0458:b003:l031","ordinal":328621,"en":"He told all that had happened,"},{"id":"seytek-2012:p0458:b003:l032","ordinal":328622,"en":"Standing thus before the gray-maned lion."},{"id":"seytek-2012:p0458:b003:l033","ordinal":328623,"en":"And so Külchoro"},{"id":"seytek-2012:p0458:b003:l034","ordinal":328624,"en":"Found the elder brother who had raised him,"},{"id":"seytek-2012:p0458:b003:l035","ordinal":328625,"en":"The forebear dearer than a father,"},{"id":"seytek-2012:p0458:b003:l036","ordinal":328626,"en":"His hobble-cord braided with gold,"},{"id":"seytek-2012:p0458:b003:l037","ordinal":328627,"en":"The one he esteemed above"},{"id":"seytek-2012:p0458:b003:l038","ordinal":328628,"en":"Both father and mother,"},{"id":"seytek-2012:p0458:b003:l039","ordinal":328629,"en":"The fruit of the deep-rooted plane tree,"},{"id":"seytek-2012:p0458:b003:l040","ordinal":328630,"en":"His lord whose figure loomed like a mountain."},{"id":"seytek-2012:p0459:b002:l001","ordinal":328631,"en":"Saying, “God has restored the magnanimous lord,”"},{"id":"seytek-2012:p0459:b002:l002","ordinal":328632,"en":"The Black Giant stood rejoicing."},{"id":"seytek-2012:p0459:b002:l003","ordinal":328633,"en":"Külchoro stood there distraught,"},{"id":"seytek-2012:p0459:b002:l004","ordinal":328634,"en":"From time to time crying aloud"},{"id":"seytek-2012:p0459:b002:l005","ordinal":328635,"en":"And pleading for protection"},{"id":"seytek-2012:p0459:b002:l006","ordinal":328636,"en":"As he begged his elder brother."},{"id":"seytek-2012:p0459:b002:l007","ordinal":328637,"en":"His elder brother stood unmoved,"},{"id":"seytek-2012:p0459:b002:l008","ordinal":328638,"en":"And Semetey held all"},{"id":"seytek-2012:p0459:b002:l009","ordinal":328639,"en":"His many golden, honeyed words"},{"id":"seytek-2012:p0459:b002:l010","ordinal":328640,"en":"Of no more account than his boot-heel."},{"id":"seytek-2012:p0459:b002:l011","ordinal":328641,"en":"Speaking softly, then firmly,"},{"id":"seytek-2012:p0459:b002:l012","ordinal":328642,"en":"Your wretched lion Külchoro"},{"id":"seytek-2012:p0459:b002:l013","ordinal":328643,"en":"Let loose and began his speech."},{"id":"seytek-2012:p0459:b002:l014","ordinal":328644,"en":"Among the spearmen, this Choro"},{"id":"seytek-2012:p0459:b002:l015","ordinal":328645,"en":"Possessed great prowess;"},{"id":"seytek-2012:p0459:b002:l016","ordinal":328646,"en":"He could face six divisions of foes,"},{"id":"seytek-2012:p0459:b002:l017","ordinal":328647,"en":"And possessed great strength."},{"id":"seytek-2012:p0459:b002:l018","ordinal":328648,"en":"The dark ridge with its lofty crest"},{"id":"seytek-2012:p0459:b002:l019","ordinal":328649,"en":"Was truly a mountain pass."},{"id":"seytek-2012:p0459:b002:l020","ordinal":328650,"en":"He was the renowned, fortunate one,"},{"id":"seytek-2012:p0459:b002:l021","ordinal":328651,"en":"Who, when the whole world made war,"},{"id":"seytek-2012:p0459:b002:l022","ordinal":328652,"en":"Went forth alone into battle."},{"id":"seytek-2012:p0459:b002:l023","ordinal":328653,"en":"When he spoke, his words were lucid and clear,"},{"id":"seytek-2012:p0459:b002:l024","ordinal":328654,"en":"Eloquent in speech and keen of sight—"},{"id":"seytek-2012:p0459:b002:l025","ordinal":328655,"en":"Külchoro himself was plain and forthright."},{"id":"seytek-2012:p0459:b002:l026","ordinal":328656,"en":"Broad-jawed and fluent-tongued,"},{"id":"seytek-2012:p0459:b002:l027","ordinal":328657,"en":"He was a great orator who never faltered."},{"id":"seytek-2012:p0459:b002:l028","ordinal":328658,"en":"From hellish torment and affliction"},{"id":"seytek-2012:p0459:b002:l029","ordinal":328659,"en":"He had escaped many times."},{"id":"seytek-2012:p0459:b002:l030","ordinal":328660,"en":"Such was Külchoro’s nature:"},{"id":"seytek-2012:p0459:b002:l031","ordinal":328661,"en":"He sharpened his dark tongue"},{"id":"seytek-2012:p0459:b002:l032","ordinal":328662,"en":"And declaimed before the people;"},{"id":"seytek-2012:p0459:b002:l033","ordinal":328663,"en":"Though the contest lasted months and years,"},{"id":"seytek-2012:p0459:b002:l034","ordinal":328664,"en":"He neither stumbled nor tired;"},{"id":"seytek-2012:p0459:b002:l035","ordinal":328665,"en":"Though humiliated and forced to plead,"},{"id":"seytek-2012:p0459:b002:l036","ordinal":328666,"en":"He never let his hands and feet be bound."},{"id":"seytek-2012:p0459:b002:l037","ordinal":328667,"en":"His words spread like sugar;"},{"id":"seytek-2012:p0459:b002:l038","ordinal":328668,"en":"He was created unlike other men."},{"id":"seytek-2012:p0459:b002:l039","ordinal":328669,"en":"He had received the people’s warrant"},{"id":"seytek-2012:p0459:b002:l040","ordinal":328670,"en":"And the saints’ blessing."},{"id":"seytek-2012:p0459:b003:l001","ordinal":328671,"en":"Yet his heart would not soften upon the riverbank,"},{"id":"seytek-2012:p0459:b003:l002","ordinal":328672,"en":"Nor would their blood mingle, though it boiled."},{"id":"seytek-2012:p0459:b003:l003","ordinal":328673,"en":"He had not seen that radiant face."},{"id":"seytek-2012:p0459:b003:l004","ordinal":328674,"en":"However eloquently Külchoro spoke,"},{"id":"seytek-2012:p0459:b003:l005","ordinal":328675,"en":"He received no word of well-being."},{"id":"seytek-2012:p0459:b003:l006","ordinal":328676,"en":"He gave not the slightest answer,"},{"id":"seytek-2012:p0459:b003:l007","ordinal":328677,"en":"Nor acknowledged the mighty warrior,"},{"id":"seytek-2012:p0459:b003:l008","ordinal":328678,"en":"But tormented him with force."},{"id":"seytek-2012:p0459:b003:l009","ordinal":328679,"en":"He acted only through gestures,"},{"id":"seytek-2012:p0459:b003:l010","ordinal":328680,"en":"His ears deaf and his eyes blind."},{"id":"seytek-2012:p0459:b003:l011","ordinal":328681,"en":"The poor, bewildered people"},{"id":"seytek-2012:p0459:b003:l012","ordinal":328682,"en":"Had fallen into Külchoro’s hands,"},{"id":"seytek-2012:p0459:b003:l013","ordinal":328683,"en":"There at the cave where they stood."},{"id":"seytek-2012:p0459:b003:l014","ordinal":328684,"en":"Külchoro kept hold of him,"},{"id":"seytek-2012:p0459:b003:l015","ordinal":328685,"en":"Refusing to release his lord,"},{"id":"seytek-2012:p0459:b003:l016","ordinal":328686,"en":"Holding his precious one motionless."},{"id":"seytek-2012:p0459:b003:l017","ordinal":328687,"en":"He held fast to his tent-pole,"},{"id":"seytek-2012:p0459:b003:l018","ordinal":328688,"en":"And held his hero as a gift."},{"id":"seytek-2012:p0459:b003:l019","ordinal":328689,"en":"The precious falcon had been found,"},{"id":"seytek-2012:p0459:b003:l020","ordinal":328690,"en":"And the beloved Choro’s precious"},{"id":"seytek-2012:p0459:b003:l021","ordinal":328691,"en":"Honor was thus restored."},{"id":"seytek-2012:p0459:b003:l022","ordinal":328692,"en":"His grief dispersed and lifted;"},{"id":"seytek-2012:p0459:b003:l023","ordinal":328693,"en":"Brave Külchoro’s"},{"id":"seytek-2012:p0459:b003:l024","ordinal":328694,"en":"Once-blinded eyes opened,"},{"id":"seytek-2012:p0459:b003:l025","ordinal":328695,"en":"And he beamed, crying, “Elder brother!”"},{"id":"seytek-2012:p0459:b003:l026","ordinal":328696,"en":"The honorable kinsman-warrior’s"},{"id":"seytek-2012:p0459:b003:l027","ordinal":328697,"en":"Moonlike face shone brightly."},{"id":"seytek-2012:p0459:b003:l028","ordinal":328698,"en":"Even now, to cross away like a spirit,"},{"id":"seytek-2012:p0459:b003:l029","ordinal":328699,"en":"Semetey stood drawing back."},{"id":"seytek-2012:p0459:b003:l030","ordinal":328700,"en":"The Black Giant and Külchoro"},{"id":"seytek-2012:p0459:b003:l031","ordinal":328701,"en":"Seized the bloodthirsty warrior together."},{"id":"seytek-2012:p0459:b003:l032","ordinal":328702,"en":"Külchoro stood thinking this:"},{"id":"seytek-2012:p0459:b003:l033","ordinal":328703,"en":"“Long ago my khan and elder brother"},{"id":"seytek-2012:p0459:b003:l034","ordinal":328704,"en":"Ruled the people and cared for the nation,"}]
