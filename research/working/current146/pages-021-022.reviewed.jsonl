{"id": "sayakbay-ms-current146:pdf021:l001", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 1, "raw": "Суурган чакта берилиптир.", "en": "In Suurgan's time, it was bestowed.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The faint opening proper name and final verb are best visual readings; the sentence continues the preceding page's genealogy.", "bbox": null, "text": "Суурган чакта берилиптир."}
{"id": "sayakbay-ms-current146:pdf021:l002", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 2, "raw": "Көк дүрбөттү эл кылып,", "en": "Making the Blue Dörböt into a people,", "classification": "narrative", "transcription_status": "visually_transcribed", "bbox": null, "text": "Көк дүрбөттү эл кылып,"}
{"id": "sayakbay-ms-current146:pdf021:l003", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 3, "raw": "Калмакка бүлүк салыптыр", "en": "He brought turmoil upon the Kalmyks,", "classification": "narrative", "transcription_status": "visually_transcribed", "bbox": null, "text": "Калмакка бүлүк салыптыр"}
{"id": "sayakbay-ms-current146:pdf021:l004", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 4, "raw": "Бүт Бээжиндин тизгинин,", "en": "The reins of all Beijing,", "classification": "narrative", "transcription_status": "visually_transcribed", "bbox": null, "text": "Бүт Бээжиндин тизгинин,"}
{"id": "sayakbay-ms-current146:pdf021:l005", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 5, "raw": "Түп Теңирден алыптыр,", "en": "He received from Tüp Teñir,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Түп Теңир is a visually plausible title or proper name; it may instead be a compressed epithet.", "bbox": null, "text": "Түп Теңирден алыптыр,"}
{"id": "sayakbay-ms-current146:pdf021:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 6, "raw": "Кочуштап журттан алыптыр.", "en": "He took it from the people by the armful.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The first two words are faint and joined; transcription and idiomatic English are provisional.", "bbox": null, "text": "Кочуштап журттан алыптыр."}
{"id": "sayakbay-ms-current146:pdf021:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 7, "raw": "Суурган кама көк хан деп,", "en": "Calling Suurgan the great Blue Khan,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "кама is the best visual reading but the title is unresolved; English renders it contextually as 'great.'", "bbox": null, "text": "Суурган кама көк хан деп,"}
{"id": "sayakbay-ms-current146:pdf021:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 8, "raw": "Бир жөрөлгөн ток жан деп,", "en": "Calling him a singular, contented soul,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "жөрөлгөн is a provisional reading of a faint joined word; translation follows the apparent sense.", "bbox": null, "text": "Бир жөрөлгөн ток жан деп,"}
{"id": "sayakbay-ms-current146:pdf021:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 9, "raw": "Өткөрө өкүм кылыптыр", "en": "He ruled with surpassing authority,", "classification": "narrative", "transcription_status": "visually_transcribed", "bbox": null, "text": "Өткөрө өкүм кылыптыр"}
{"id": "sayakbay-ms-current146:pdf021:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 10, "raw": "Бир учурда айткан кандарың,", "en": "The khans who spoke at one time,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The middle phrase is pale; учурда айткан is the best visual segmentation.", "bbox": null, "text": "Бир учурда айткан кандарың,"}
{"id": "sayakbay-ms-current146:pdf021:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 11, "raw": "Бир нечесин кырыптыр.", "en": "He slaughtered several of them.", "classification": "narrative", "transcription_status": "visually_transcribed", "bbox": null, "text": "Бир нечесин кырыптыр."}
{"id": "sayakbay-ms-current146:pdf021:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 12, "raw": "Айбатын көрүп Түп Теңир,", "en": "Seeing his awesome might, Tüp Teñir,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The final name or title is the same provisional reading as line 5.", "bbox": null, "text": "Айбатын көрүп Түп Теңир,"}
{"id": "sayakbay-ms-current146:pdf021:l013", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 13, "raw": "Калмаканына бериптир,", "en": "Gave it to his Kalmyk people,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Калмаканына is an uncertain manuscript form; English is contextual.", "bbox": null, "text": "Калмаканына бериптир,"}
{"id": "sayakbay-ms-current146:pdf021:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 14, "raw": "Айран таажысын кийгизип,", "en": "Placing the Ayran crown upon him,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Айран is the best visual reading of the modifier before таажысын but its referent is unresolved.", "bbox": null, "text": "Айран таажысын кийгизип,"}
{"id": "sayakbay-ms-current146:pdf021:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 15, "raw": "Изилдеп такка мингизип,", "en": "Carefully seating him upon the throne,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The first verb is pale and provisionally read as Изилдеп.", "bbox": null, "text": "Изилдеп такка мингизип,"}
{"id": "sayakbay-ms-current146:pdf021:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 16, "raw": "Сакал берип, ээ берип,", "en": "Giving him a beard and mastery,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "ээ is visually plausible; the formula and its English sense remain provisional.", "bbox": null, "text": "Сакал берип, ээ берип,"}
{"id": "sayakbay-ms-current146:pdf021:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 17, "raw": "Жери күндүк, күнү дүйнөлүк,", "en": "His land for a day, his day for the world,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Both halves are faint and the idiom is unresolved; transcription and literal English are provisional.", "bbox": null, "text": "Жери күндүк, күнү дүйнөлүк,"}
{"id": "sayakbay-ms-current146:pdf021:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 18, "raw": "Төлөсүнө түн берип,", "en": "Giving night to his due,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The opening noun and the formula are unresolved; English is deliberately literal.", "bbox": null, "text": "Төлөсүнө түн берип,"}
{"id": "sayakbay-ms-current146:pdf021:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 19, "raw": "Калган такка мингизип,", "en": "Seating the remaining one on the throne,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The first word is pale and could be a proper name or title rather than калган.", "bbox": null, "text": "Калган такка мингизип,"}
{"id": "sayakbay-ms-current146:pdf021:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 20, "raw": "Какан журтун билгизип,", "en": "Giving him rule over the khagan's people,", "classification": "narrative", "transcription_status": "visually_transcribed", "bbox": null, "text": "Какан журтун билгизип,"}
{"id": "sayakbay-ms-current146:pdf021:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 21, "raw": "Арбагы алыс болду деп,", "en": "Saying his spiritual power reached afar,", "classification": "narrative", "transcription_status": "visually_transcribed", "bbox": null, "text": "Арбагы алыс болду деп,"}
{"id": "sayakbay-ms-current146:pdf021:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 22, "raw": "Бүт Бээжинди чочутуп,", "en": "Frightening all of Beijing,", "classification": "narrative", "transcription_status": "visually_transcribed", "bbox": null, "text": "Бүт Бээжинди чочутуп,"}
{"id": "sayakbay-ms-current146:pdf021:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 23, "raw": "Азыркы деген калмакты,", "en": "The Kalmyk called Azyrky,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Азыркы may be a proper name, an epithet, or the ordinary adjective 'present'; English preserves it as a name.", "bbox": null, "text": "Азыркы деген калмакты,"}
{"id": "sayakbay-ms-current146:pdf021:l024", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 24, "raw": "Жан калпагын кийгизип,", "en": "Putting the Jan cap upon him,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Жан is a provisional modifier or name; the act of placing a cap is clear.", "bbox": null, "text": "Жан калпагын кийгизип,"}
{"id": "sayakbay-ms-current146:pdf021:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 25, "raw": "Барган жери калдай тартпайбы,", "en": "Wherever he went, did he not act as a governor?", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The final word is faint; калдай is interpreted as the title 'governor.'", "bbox": null, "text": "Барган жери калдай тартпайбы,"}
{"id": "sayakbay-ms-current146:pdf021:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 26, "raw": "Тили суук-бу деген турбайбы,", "en": "Was he not the one called Cold-Tongued?", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The internal punctuation and final auxiliary are inferred from a faint, joined line; translation is contextual.", "bbox": null, "text": "Тили суук-бу деген турбайбы,"}
{"id": "sayakbay-ms-current146:pdf021:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 27, "raw": "Алтымыш баштуу ажыдаар,", "en": "A sixty-headed dragon,", "classification": "narrative", "transcription_status": "visually_transcribed", "bbox": null, "text": "Алтымыш баштуу ажыдаар,"}
{"id": "sayakbay-ms-current146:pdf021:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 28, "raw": "Алдындагы зайыптары,", "en": "The women beneath him,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The second word is a best visual reading of very pale handwriting; English is literal.", "bbox": null, "text": "Алдындагы зайыптары,"}
{"id": "sayakbay-ms-current146:pdf021:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 29, "raw": "Тажайган кара казынан,", "en": "From the weary black treasure,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Both тажайган and казынан are provisional readings; the phrase's meaning is unresolved.", "bbox": null, "text": "Тажайган кара казынан,"}
{"id": "sayakbay-ms-current146:pdf021:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 30, "raw": "Чын мынчылыгын өзүнөн,", "en": "His true nature from himself,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The middle word is faint and semantically unresolved; English follows the apparent syntax.", "bbox": null, "text": "Чын мынчылыгын өзүнөн,"}
{"id": "sayakbay-ms-current146:pdf021:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 31, "raw": "Суурган ханды окуткан,", "en": "He had Khan Suurgan taught,", "classification": "narrative", "transcription_status": "visually_transcribed", "bbox": null, "text": "Суурган ханды окуткан,"}
{"id": "sayakbay-ms-current146:pdf021:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 32, "raw": "Ак түңгөрүн туткан,", "en": "He held his white standard,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "түңгөрүн is a provisional reading of a faint lexeme; 'standard' is contextual.", "bbox": null, "text": "Ак түңгөрүн туткан,"}
{"id": "sayakbay-ms-current146:pdf021:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 33, "raw": "Кытай жан мында окуган,", "en": "A Chinese soul studied here,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "жан мында is the best visual segmentation; the construction and English are provisional.", "bbox": null, "text": "Кытай жан мында окуган,"}
{"id": "sayakbay-ms-current146:pdf021:l034", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 21, "folio": 404, "line_in_page": 34, "raw": "Хан көңүлү жыйылып.", "en": "The khan gathered his resolve.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The final verb is pale; жыйылып is the best visual reading and English is contextual.", "bbox": null, "text": "Хан көңүлү жыйылып."}
{"id": "sayakbay-ms-current146:pdf022:l001", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 22, "folio": 405, "line_in_page": 1, "raw": "Суурчулган кандын баласы,", "text": "Суурчулган кандын баласы,", "en": "The son of Khan Suurchulgan,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The first word is a provisional proper-name reading; its joined middle letters are indistinct.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf022:l002", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 22, "folio": 405, "line_in_page": 2, "raw": "Бурада туруп келген,", "text": "Бурада туруп келген,", "en": "Who had come and stood here,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Бурада is the closest visual reading and may instead be a dialectal spelling or proper name; English is contextual.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf022:l003", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 22, "folio": 405, "line_in_page": 3, "raw": "Эсен аман түз болуп,", "text": "Эсен аман түз болуп,", "en": "Safe and sound, remaining upright,", "classification": "narrative", "transcription_status": "visually_transcribed", "bbox": null}
{"id": "sayakbay-ms-current146:pdf022:l004", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 22, "folio": 405, "line_in_page": 4, "raw": "Эл журтун бир жак көздөгөн,", "text": "Эл журтун бир жак көздөгөн,", "en": "He directed his people toward one course,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The word read жак is faint; translation follows the apparent idiom.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf022:l005", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 22, "folio": 405, "line_in_page": 5, "raw": "Арка конгоз, жоо күйүк,", "text": "Арка конгоз, жоо күйүк,", "en": "Arka Kongoz, the scourge of the foe,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Арка конгоз is a provisional reading, probably an epithet or name; English treats жоо күйүк contextually.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf022:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 22, "folio": 405, "line_in_page": 6, "raw": "Айдаганы бөлөк, кайра күн,", "text": "Айдаганы бөлөк, кайра күн,", "en": "What he drove was different, on the returning day,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The middle word appears to be бөлөк and the final phrase кайра күн; the syntax and English remain provisional.", "bbox": null}
