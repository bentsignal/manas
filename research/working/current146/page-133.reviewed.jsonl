{"id": "sayakbay-ms-current146:pdf133:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 133, "folio": 516, "line_in_page": 33, "raw": "Бу Какандын эл калды журт,", "text": "Бу Какандын эл калды журт,", "en": "The people and land of this Kakan remained behind,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; word division, lexical form, or idiomatic interpretation may require review.", "bbox": null}
