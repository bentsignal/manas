[{"id":"seytek-2012:p0872:b002:l026","ordinal":363521,"en":"No soul could endure his fury,"},{"id":"seytek-2012:p0872:b002:l027","ordinal":363522,"en":"The storm never left his brow,"},{"id":"seytek-2012:p0872:b002:l028","ordinal":363523,"en":"The army gathered with a clamor,"},{"id":"seytek-2012:p0872:b002:l029","ordinal":363524,"en":"Unable to withstand his wrath,"},{"id":"seytek-2012:p0872:b002:l030","ordinal":363525,"en":"All whom he looked upon were slain,"},{"id":"seytek-2012:p0872:b002:l031","ordinal":363526,"en":"Every living creature"},{"id":"seytek-2012:p0872:b002:l032","ordinal":363527,"en":"Bowed and bent its head,"},{"id":"seytek-2012:p0872:b002:l033","ordinal":363528,"en":"Whoever stared wide-eyed at him"},{"id":"seytek-2012:p0872:b002:l034","ordinal":363529,"en":"Despaired at once of life,"},{"id":"seytek-2012:p0872:b002:l035","ordinal":363530,"en":"Those skilled at thrusting spears,"},{"id":"seytek-2012:p0872:b002:l036","ordinal":363531,"en":"The stalwarts who struck with battle-axes,"},{"id":"seytek-2012:p0872:b002:l037","ordinal":363532,"en":"Those who faced fearsome foes"},{"id":"seytek-2012:p0872:b002:l038","ordinal":363533,"en":"And were drenched in black blood,"},{"id":"seytek-2012:p0872:b002:l039","ordinal":363534,"en":"Those who guarded the people,"},{"id":"seytek-2012:p0872:b002:l040","ordinal":363535,"en":"Eloquent men who never faltered,"},{"id":"seytek-2012:p0872:b003:l001","ordinal":363536,"en":"Marksmen trained in stealth,"},{"id":"seytek-2012:p0872:b003:l002","ordinal":363537,"en":"Who never shrank when facing the foe,"},{"id":"seytek-2012:p0872:b003:l003","ordinal":363538,"en":"Men born but once"},{"id":"seytek-2012:p0872:b003:l004","ordinal":363539,"en":"Into the hands of fortunate mankind,"},{"id":"seytek-2012:p0872:b003:l005","ordinal":363540,"en":"Who never withdrew what they extended,"},{"id":"seytek-2012:p0872:b003:l006","ordinal":363541,"en":"Whose grim aim never failed,"},{"id":"seytek-2012:p0872:b003:l007","ordinal":363542,"en":"True, sure-shot marksmen—"},{"id":"seytek-2012:p0872:b003:l008","ordinal":363543,"en":"When Sarybay poured out his wrath,"},{"id":"seytek-2012:p0872:b003:l009","ordinal":363544,"en":"All the heroes gathered,"},{"id":"seytek-2012:p0872:b003:l010","ordinal":363545,"en":"And wise men were slaughtered,"},{"id":"seytek-2012:p0872:b003:l011","ordinal":363546,"en":"Their hands struck against one another,"},{"id":"seytek-2012:p0872:b003:l012","ordinal":363547,"en":"When Sarybay poured out his wrath,"},{"id":"seytek-2012:p0872:b003:l013","ordinal":363548,"en":"Many among the people lost their wits,"},{"id":"seytek-2012:p0872:b003:l014","ordinal":363549,"en":"Rushing about in panic,"},{"id":"seytek-2012:p0872:b003:l015","ordinal":363550,"en":"Many mortals fled,"},{"id":"seytek-2012:p0872:b003:l016","ordinal":363551,"en":"Their faces yellow as straw,"},{"id":"seytek-2012:p0872:b003:l017","ordinal":363552,"en":"Finding no earth to enter,"},{"id":"seytek-2012:p0872:b003:l018","ordinal":363553,"en":"Finding nowhere to take shelter,"},{"id":"seytek-2012:p0872:b003:l019","ordinal":363554,"en":"Finding no flattering words to speak,"},{"id":"seytek-2012:p0872:b003:l020","ordinal":363555,"en":"Their hearts corrupted, their faces bitter,"},{"id":"seytek-2012:p0872:b003:l021","ordinal":363556,"en":"Behind the infidel slave,"},{"id":"seytek-2012:p0872:b003:l022","ordinal":363557,"en":"They found no refuge from death,"},{"id":"seytek-2012:p0872:b003:l023","ordinal":363558,"en":"The people lost their senses,"},{"id":"seytek-2012:p0872:b003:l024","ordinal":363559,"en":"And this was why they faltered:"},{"id":"seytek-2012:p0872:b003:l025","ordinal":363560,"en":"Rebuking the whole army,"},{"id":"seytek-2012:p0872:b003:l026","ordinal":363561,"en":"Sarybay stood thundering,"},{"id":"seytek-2012:p0872:b003:l027","ordinal":363562,"en":"“All our stratagems are exhausted,” they said,"},{"id":"seytek-2012:p0872:b003:l028","ordinal":363563,"en":"“In two months he has reached us,” they said,"},{"id":"seytek-2012:p0872:b003:l029","ordinal":363564,"en":"That swine Sarybay's"},{"id":"seytek-2012:p0872:b003:l030","ordinal":363565,"en":"Fierce venom became apparent,"},{"id":"seytek-2012:p0872:b003:l031","ordinal":363566,"en":"All who heard with ears and saw with eyes,"},{"id":"seytek-2012:p0872:b003:l032","ordinal":363567,"en":"The people despaired of life,"},{"id":"seytek-2012:p0872:b003:l033","ordinal":363568,"en":"Beginning their laments, crying “alas,”"},{"id":"seytek-2012:p0872:b003:l034","ordinal":363569,"en":"Every person brooded, crying “woe,”"},{"id":"seytek-2012:p0872:b003:l035","ordinal":363570,"en":"“If Sarybay flies into a rage,"},{"id":"seytek-2012:p0872:b003:l036","ordinal":363571,"en":"He will pursue us to the bitter end,” they said,"},{"id":"seytek-2012:p0872:b003:l037","ordinal":363572,"en":"“He will boastfully drive his army,"},{"id":"seytek-2012:p0872:b003:l038","ordinal":363573,"en":"Not sparing even one,"},{"id":"seytek-2012:p0872:b003:l039","ordinal":363574,"en":"And pass through in slaughter,” they said,"},{"id":"seytek-2012:p0872:b003:l040","ordinal":363575,"en":"Whether hero or lion,"},{"id":"seytek-2012:p0873:b002:l001","ordinal":363576,"en":"Whether wrestler or warrior,"},{"id":"seytek-2012:p0873:b002:l002","ordinal":363577,"en":"To the whole wide world Sarybay"},{"id":"seytek-2012:p0873:b002:l003","ordinal":363578,"en":"Seemed like a towering mountain,"},{"id":"seytek-2012:p0873:b002:l004","ordinal":363579,"en":"“The whole of that small army"},{"id":"seytek-2012:p0873:b002:l005","ordinal":363580,"en":"He drove before him and devoured,” they said,"},{"id":"seytek-2012:p0873:b002:l006","ordinal":363581,"en":"Those with sense pondered this,"},{"id":"seytek-2012:p0873:b002:l007","ordinal":363582,"en":"Unable to gather their wits,"},{"id":"seytek-2012:p0873:b002:l008","ordinal":363583,"en":"Burning without smoke,"},{"id":"seytek-2012:p0873:b002:l009","ordinal":363584,"en":"The people despaired of life,"},{"id":"seytek-2012:p0873:b002:l010","ordinal":363585,"en":"Thus the people stood,"},{"id":"seytek-2012:p0873:b002:l011","ordinal":363586,"en":"When Sarybay grew furious—"},{"id":"seytek-2012:p0873:b002:l012","ordinal":363587,"en":"Such was his valor,"},{"id":"seytek-2012:p0873:b002:l013","ordinal":363588,"en":"Hearing the wrestlers' report,"},{"id":"seytek-2012:p0873:b002:l014","ordinal":363589,"en":"Hearing that brave Seytek and valiant Choro"},{"id":"seytek-2012:p0873:b002:l015","ordinal":363590,"en":"Had slaughtered the army,"},{"id":"seytek-2012:p0873:b002:l016","ordinal":363591,"en":"He bound his soul to death,"},{"id":"seytek-2012:p0873:b002:l017","ordinal":363592,"en":"As for remaining alive and not dying,"},{"id":"seytek-2012:p0873:b002:l018","ordinal":363593,"en":"The guest-soul granted by the Creator—"},{"id":"seytek-2012:p0873:b002:l019","ordinal":363594,"en":"How could his savage fury spare it?"},{"id":"seytek-2012:p0873:b002:l020","ordinal":363595,"en":"Sarybay, son of the ogre—"},{"id":"seytek-2012:p0873:b002:l021","ordinal":363596,"en":"Such was his boldness,"},{"id":"seytek-2012:p0873:b002:l022","ordinal":363597,"en":"Tugging his coat of mail straight,"},{"id":"seytek-2012:p0873:b002:l023","ordinal":363598,"en":"Shaking out his cuirass,"},{"id":"seytek-2012:p0873:b002:l024","ordinal":363599,"en":"“I am a hero against those with skill,"},{"id":"seytek-2012:p0873:b002:l025","ordinal":363600,"en":"And against a foe whose skill has failed,"},{"id":"seytek-2012:p0873:b002:l026","ordinal":363601,"en":"I am the dreadful end of time,"},{"id":"seytek-2012:p0873:b002:l027","ordinal":363602,"en":"I am the walnut ember itself,"},{"id":"seytek-2012:p0873:b002:l028","ordinal":363603,"en":"Burning like a river and slaughtering nations,"},{"id":"seytek-2012:p0873:b002:l029","ordinal":363604,"en":"When my frenzy seizes me again,"},{"id":"seytek-2012:p0873:b002:l030","ordinal":363605,"en":"I am the black eye of the scourge,"},{"id":"seytek-2012:p0873:b002:l031","ordinal":363606,"en":"I am calamity incarnate,"},{"id":"seytek-2012:p0873:b002:l032","ordinal":363607,"en":"I am the source of every slayer,"},{"id":"seytek-2012:p0873:b002:l033","ordinal":363608,"en":"I am savagery itself,"},{"id":"seytek-2012:p0873:b002:l034","ordinal":363609,"en":"Gnawing whoever I encounter,"},{"id":"seytek-2012:p0873:b002:l035","ordinal":363610,"en":"Devouring whoever I find,"},{"id":"seytek-2012:p0873:b002:l036","ordinal":363611,"en":"Mangling whoever crosses me,"},{"id":"seytek-2012:p0873:b002:l037","ordinal":363612,"en":"I am the black scourge itself,"},{"id":"seytek-2012:p0873:b002:l038","ordinal":363613,"en":"I shall be a bleak ridge"},{"id":"seytek-2012:p0873:b002:l039","ordinal":363614,"en":"That weary men cannot cross,"},{"id":"seytek-2012:p0873:b002:l040","ordinal":363615,"en":"I am the black scourge"},{"id":"seytek-2012:p0873:b004:l001","ordinal":363616,"en":"That mangles any soul it meets,"},{"id":"seytek-2012:p0873:b004:l002","ordinal":363617,"en":"While you still have mighty strength,"},{"id":"seytek-2012:p0873:b004:l003","ordinal":363618,"en":"How could I yield my assembled army?"},{"id":"seytek-2012:p0873:b004:l004","ordinal":363619,"en":"Külchoro has run mad—"},{"id":"seytek-2012:p0873:b004:l005","ordinal":363620,"en":"I shall give him his full punishment,"},{"id":"seytek-2012:p0873:b004:l006","ordinal":363621,"en":"If Khan Seytek crosses my path,"},{"id":"seytek-2012:p0873:b004:l007","ordinal":363622,"en":"I shall seize him and spill his blood,"},{"id":"seytek-2012:p0873:b004:l008","ordinal":363623,"en":"If Semetey crosses my path,"},{"id":"seytek-2012:p0873:b004:l009","ordinal":363624,"en":"I shall tear apart his ribs,"},{"id":"seytek-2012:p0873:b004:l010","ordinal":363625,"en":"If Bakai confronts me,"},{"id":"seytek-2012:p0873:b004:l011","ordinal":363626,"en":"I shall beat the old man's fury from him,"},{"id":"seytek-2012:p0873:b004:l012","ordinal":363627,"en":"If Kuyaly grapples with me,"},{"id":"seytek-2012:p0873:b004:l013","ordinal":363628,"en":"I shall settle her account.”"},{"id":"seytek-2012:p0873:b004:l014","ordinal":363629,"en":"Saying this, he thundered,"},{"id":"seytek-2012:p0873:b004:l015","ordinal":363630,"en":"Every mortal human's"},{"id":"seytek-2012:p0873:b004:l016","ordinal":363631,"en":"Whole free body shuddered,"},{"id":"seytek-2012:p0873:b004:l017","ordinal":363632,"en":"Sarybay, son of the ogre,"},{"id":"seytek-2012:p0873:b004:l018","ordinal":363633,"en":"Pressed the wretched people sorely,"},{"id":"seytek-2012:p0873:b004:l019","ordinal":363634,"en":"His shout splitting heads,"},{"id":"seytek-2012:p0873:b004:l020","ordinal":363635,"en":"The doomed man's bellowing,"},{"id":"seytek-2012:p0873:b004:l021","ordinal":363636,"en":"His roar splitting stones,"},{"id":"seytek-2012:p0873:b004:l022","ordinal":363637,"en":"Against that dread man's wrath,"},{"id":"seytek-2012:p0873:b004:l023","ordinal":363638,"en":"No one could stand and look,"},{"id":"seytek-2012:p0873:b004:l024","ordinal":363639,"en":"When the infidel gathered force,"},{"id":"seytek-2012:p0873:b004:l025","ordinal":363640,"en":"No person could withstand him,"},{"id":"seytek-2012:p0873:b004:l026","ordinal":363641,"en":"Such was the true might"},{"id":"seytek-2012:p0873:b004:l027","ordinal":363642,"en":"Of the infidel, the ogre's son,"},{"id":"seytek-2012:p0873:b004:l028","ordinal":363643,"en":"Then Sarybay"},{"id":"seytek-2012:p0873:b004:l029","ordinal":363644,"en":"Was seized by his blood-drinking frenzy,"},{"id":"seytek-2012:p0873:b004:l030","ordinal":363645,"en":"All who looked on were astonished,"},{"id":"seytek-2012:p0873:b004:l031","ordinal":363646,"en":"No one remained unhurried,"},{"id":"seytek-2012:p0873:b004:l032","ordinal":363647,"en":"His wrath became a grievous force,"},{"id":"seytek-2012:p0873:b004:l033","ordinal":363648,"en":"Then Sarybay,"},{"id":"seytek-2012:p0873:b004:l034","ordinal":363649,"en":"His eyes reddening like fire,"},{"id":"seytek-2012:p0873:b004:l035","ordinal":363650,"en":"Swelled with menace and strained for battle,"},{"id":"seytek-2012:p0873:b004:l036","ordinal":363651,"en":"Taking up his slaughtering steel spear,"},{"id":"seytek-2012:p0873:b004:l037","ordinal":363652,"en":"The raging madman,"},{"id":"seytek-2012:p0873:b004:l038","ordinal":363653,"en":"With a steel mace as large as a house,"},{"id":"seytek-2012:p0873:b004:l039","ordinal":363654,"en":"His bloodthirsty eyes rolling,"},{"id":"seytek-2012:p0873:b004:l040","ordinal":363655,"en":"Glowering, his hair bristling,"},{"id":"seytek-2012:p0874:b002:l001","ordinal":363656,"en":"He began the quarrel with a deep growl,"},{"id":"seytek-2012:p0874:b002:l002","ordinal":363657,"en":"Such again was Sarybay,"},{"id":"seytek-2012:p0874:b002:l003","ordinal":363658,"en":"A man fully prepared for battle,"},{"id":"seytek-2012:p0874:b002:l004","ordinal":363659,"en":"Those who heard with ears and saw with eyes"},{"id":"seytek-2012:p0874:b002:l005","ordinal":363660,"en":"Called him Sarybay the Devourer,"},{"id":"seytek-2012:p0874:b002:l006","ordinal":363661,"en":"Toward the poor and powerless,"},{"id":"seytek-2012:p0874:b002:l007","ordinal":363662,"en":"He seemed never to look back,"},{"id":"seytek-2012:p0874:b002:l008","ordinal":363663,"en":"Ready now, in his madness,"},{"id":"seytek-2012:p0874:b002:l009","ordinal":363664,"en":"To consume the entire world,"},{"id":"seytek-2012:p0874:b002:l010","ordinal":363665,"en":"His aspect strange, his venom strong,"},{"id":"seytek-2012:p0874:b002:l011","ordinal":363666,"en":"“If you see his wrath, I am dead,” they said,"},{"id":"seytek-2012:p0874:b002:l012","ordinal":363667,"en":"“Abandon hope for your precious life,”"},{"id":"seytek-2012:p0874:b002:l013","ordinal":363668,"en":"His thoroughbred horse was Tookyzyld,"},{"id":"seytek-2012:p0874:b002:l014","ordinal":363669,"en":"He saddled Tookyzyld,"},{"id":"seytek-2012:p0874:b002:l015","ordinal":363670,"en":"Arranged his arms and armor,"},{"id":"seytek-2012:p0874:b002:l016","ordinal":363671,"en":"And buckled on his flashing sword,"},{"id":"seytek-2012:p0874:b002:l017","ordinal":363672,"en":"When the bloodthirsty man reared for battle,"},{"id":"seytek-2012:p0874:b002:l018","ordinal":363673,"en":"His appearance utterly transformed,"},{"id":"seytek-2012:p0874:b002:l019","ordinal":363674,"en":"He seemed ready to drive the whole world"},{"id":"seytek-2012:p0874:b002:l020","ordinal":363675,"en":"Before him and slaughter it,"},{"id":"seytek-2012:p0874:b002:l021","ordinal":363676,"en":"His shaggy hair stood bristling,"},{"id":"seytek-2012:p0874:b002:l022","ordinal":363677,"en":"Then its wild rising subsided,"},{"id":"seytek-2012:p0874:b002:l023","ordinal":363678,"en":"A hazy crimson fire"},{"id":"seytek-2012:p0874:b002:l024","ordinal":363679,"en":"Scattered all around,"},{"id":"seytek-2012:p0874:b002:l025","ordinal":363680,"en":"He screamed, pouring out his wrath,"},{"id":"seytek-2012:p0874:b002:l026","ordinal":363681,"en":"Making the wrestlers flatten their ears,"},{"id":"seytek-2012:p0874:b002:l027","ordinal":363682,"en":"And now committed a dreadful deed:"},{"id":"seytek-2012:p0874:b002:l028","ordinal":363683,"en":"“My name is Sarybay,"},{"id":"seytek-2012:p0874:b002:l029","ordinal":363684,"en":"Let harsh affliction be revealed,"},{"id":"seytek-2012:p0874:b002:l030","ordinal":363685,"en":"Let blood and gore pour from combat,"},{"id":"seytek-2012:p0874:b002:l031","ordinal":363686,"en":"Do not go on living—pass away,"},{"id":"seytek-2012:p0874:b002:l032","ordinal":363687,"en":"Without leaving a single one,"},{"id":"seytek-2012:p0874:b002:l033","ordinal":363688,"en":"Go and slaughter one another!"},{"id":"seytek-2012:p0874:b002:l034","ordinal":363689,"en":"My mighty men, my warriors,"},{"id":"seytek-2012:p0874:b002:l035","ordinal":363690,"en":"My lions who stand beside me,"},{"id":"seytek-2012:p0874:b002:l036","ordinal":363691,"en":"Bold men girded for war,"},{"id":"seytek-2012:p0874:b002:l037","ordinal":363692,"en":"Who destroy all they confront,"},{"id":"seytek-2012:p0874:b002:l038","ordinal":363693,"en":"My champions, my finest men,"},{"id":"seytek-2012:p0874:b002:l039","ordinal":363694,"en":"Those masterfully skilled with spears,"},{"id":"seytek-2012:p0874:b002:l040","ordinal":363695,"en":"Stalwarts accomplished in cunning!”"},{"id":"seytek-2012:p0874:b003:l001","ordinal":363696,"en":"Thus speaking, Sarybay"},{"id":"seytek-2012:p0874:b003:l002","ordinal":363697,"en":"Set the battle order firmly,"},{"id":"seytek-2012:p0874:b003:l003","ordinal":363698,"en":"Mounted his thoroughbred Tookyzyld,"},{"id":"seytek-2012:p0874:b003:l004","ordinal":363699,"en":"Knotted its slender tail tight,"},{"id":"seytek-2012:p0874:b003:l005","ordinal":363700,"en":"And, furious and prepared,"},{"id":"seytek-2012:p0874:b003:l006","ordinal":363701,"en":"Drove out all his army,"},{"id":"seytek-2012:p0874:b003:l007","ordinal":363702,"en":"The raging foe raised a clamor,"},{"id":"seytek-2012:p0874:b003:l008","ordinal":363703,"en":"The sky resounded with the din,"},{"id":"seytek-2012:p0874:b003:l009","ordinal":363704,"en":"The earth shook and mountains moved,"},{"id":"seytek-2012:p0874:b003:l010","ordinal":363705,"en":"Piercing war cries arose,"},{"id":"seytek-2012:p0874:b003:l011","ordinal":363706,"en":"Utter and final was the great conflict,"},{"id":"seytek-2012:p0874:b003:l012","ordinal":363707,"en":"And mortals despaired of life,"},{"id":"seytek-2012:p0874:b003:l013","ordinal":363708,"en":"The fierce fury of the swine,"},{"id":"seytek-2012:p0874:b003:l014","ordinal":363709,"en":"His savage madness, became apparent,"},{"id":"seytek-2012:p0874:b003:l015","ordinal":363710,"en":"Then Sarybay,"},{"id":"seytek-2012:p0874:b003:l016","ordinal":363711,"en":"His eyes like hollows in a ravine,"},{"id":"seytek-2012:p0874:b003:l017","ordinal":363712,"en":"Seemed ready to swallow his challenger,"},{"id":"seytek-2012:p0874:b003:l018","ordinal":363713,"en":"To slaughter whoever he charged,"},{"id":"seytek-2012:p0874:b003:l019","ordinal":363714,"en":"To ruin whoever crossed him,"},{"id":"seytek-2012:p0874:b003:l020","ordinal":363715,"en":"And utterly wipe them out—"},{"id":"seytek-2012:p0874:b003:l021","ordinal":363716,"en":"Such was the sight of his wrath,"},{"id":"seytek-2012:p0874:b003:l022","ordinal":363717,"en":"He was a champion, a bulwark,"},{"id":"seytek-2012:p0874:b003:l023","ordinal":363718,"en":"Sarybay was a mighty wrestler,"},{"id":"seytek-2012:p0874:b003:l024","ordinal":363719,"en":"Who spared no life when grappling,"},{"id":"seytek-2012:p0874:b003:l025","ordinal":363720,"en":"Who could not be sated with a colt's flesh,"},{"id":"seytek-2012:p0874:b003:l026","ordinal":363721,"en":"Who mangled whoever crossed him,"},{"id":"seytek-2012:p0874:b003:l027","ordinal":363722,"en":"And truly inflicted torment"},{"id":"seytek-2012:p0874:b003:l028","ordinal":363723,"en":"On every mortal who confronted him,"},{"id":"seytek-2012:p0874:b003:l029","ordinal":363724,"en":"Driving an army of tens of thousands,"},{"id":"seytek-2012:p0874:b003:l030","ordinal":363725,"en":"He gathered all who remained"},{"id":"seytek-2012:p0874:b003:l031","ordinal":363726,"en":"From among the dead and drove them on,"},{"id":"seytek-2012:p0874:b003:l032","ordinal":363727,"en":"Whichever side met him was destroyed,"},{"id":"seytek-2012:p0874:b003:l033","ordinal":363728,"en":"As he advanced and unleashed conflict,"},{"id":"seytek-2012:p0874:b003:l034","ordinal":363729,"en":"A red haze rose like fire,"},{"id":"seytek-2012:p0874:b003:l035","ordinal":363730,"en":"A great conflict of dire affliction,"},{"id":"seytek-2012:p0874:b003:l036","ordinal":363731,"en":"Left every mortal full of regret,"},{"id":"seytek-2012:p0874:b003:l037","ordinal":363732,"en":"That swift slave Sarybay,"},{"id":"seytek-2012:p0874:b003:l038","ordinal":363733,"en":"A wicked slave in all he sought,"},{"id":"seytek-2012:p0874:b003:l039","ordinal":363734,"en":"A baleful slave in all he observed,"},{"id":"seytek-2012:p0874:b003:l040","ordinal":363735,"en":"His fury and lionheartedness"},{"id":"seytek-2012:p0875:b002:l001","ordinal":363736,"en":"Surpassed all the world,"},{"id":"seytek-2012:p0875:b002:l002","ordinal":363737,"en":"Such was that infidel's courage,"},{"id":"seytek-2012:p0875:b002:l003","ordinal":363738,"en":"Breaking away from the host,"},{"id":"seytek-2012:p0875:b002:l004","ordinal":363739,"en":"He appeared like Ala-Too,"},{"id":"seytek-2012:p0875:b002:l005","ordinal":363740,"en":"He rode out raging to single combat,"},{"id":"seytek-2012:p0875:b002:l006","ordinal":363741,"en":"The madman who scorched the earth"},{"id":"seytek-2012:p0875:b002:l007","ordinal":363742,"en":"Charged possessed onto the battlefield,"},{"id":"seytek-2012:p0875:b002:l008","ordinal":363743,"en":"As though to suck dry whoever crossed him,"},{"id":"seytek-2012:p0875:b002:l009","ordinal":363744,"en":"As though to slaughter all who opposed him,"},{"id":"seytek-2012:p0875:b002:l010","ordinal":363745,"en":"Like a mighty, merciless wrestler,"},{"id":"seytek-2012:p0875:b002:l011","ordinal":363746,"en":"As though to tear any soul he met into ten pieces,"},{"id":"seytek-2012:p0875:b002:l012","ordinal":363747,"en":"And mangle it again and again,"},{"id":"seytek-2012:p0875:b002:l013","ordinal":363748,"en":"Such was his appearance,"},{"id":"seytek-2012:p0875:b002:l014","ordinal":363749,"en":"For single combat in the great battle,"},{"id":"seytek-2012:p0875:b002:l015","ordinal":363750,"en":"Sarybay rode out alone,"},{"id":"seytek-2012:p0875:b002:l016","ordinal":363751,"en":"His menace unmatched, his venom strong,"},{"id":"seytek-2012:p0875:b002:l017","ordinal":363752,"en":"“If you see the infidel, I am dead,” they said,"},{"id":"seytek-2012:p0875:b002:l018","ordinal":363753,"en":"“Abandon hope for your precious life!”"},{"id":"seytek-2012:p0875:b002:l019","ordinal":363754,"en":"His balefulness was unlike any other,"},{"id":"seytek-2012:p0875:b002:l020","ordinal":363755,"en":"This terror surpassed them all,"},{"id":"seytek-2012:p0875:b002:l021","ordinal":363756,"en":"At the ground where battle would be waged,"},{"id":"seytek-2012:p0875:b002:l022","ordinal":363757,"en":"At the place where he would ride out alone,"},{"id":"seytek-2012:p0875:b002:l023","ordinal":363758,"en":"He surged and thundered in frenzy,"},{"id":"seytek-2012:p0875:b002:l024","ordinal":363759,"en":"Behind him the wrestlers"},{"id":"seytek-2012:p0875:b002:l025","ordinal":363760,"en":"Beat their drums,"},{"id":"seytek-2012:p0875:b002:l026","ordinal":363761,"en":"And pounded their kettledrums,"},{"id":"seytek-2012:p0875:b002:l027","ordinal":363762,"en":"The earth split and dust arose,"},{"id":"seytek-2012:p0875:b002:l028","ordinal":363763,"en":"Strength deserted humankind,"},{"id":"seytek-2012:p0875:b002:l029","ordinal":363764,"en":"The countless army dared not advance,"},{"id":"seytek-2012:p0875:b002:l030","ordinal":363765,"en":"No mortal dared show his face,"},{"id":"seytek-2012:p0875:b002:l031","ordinal":363766,"en":"His nature strange, his venom strong—"},{"id":"seytek-2012:p0875:b002:l032","ordinal":363767,"en":"Such was the swine Sarybay,"},{"id":"seytek-2012:p0875:b002:l033","ordinal":363768,"en":"The scheming madman"},{"id":"seytek-2012:p0875:b002:l034","ordinal":363769,"en":"Took up a strange long spear,"},{"id":"seytek-2012:p0875:b002:l035","ordinal":363770,"en":"Buckled his sword diagonally,"},{"id":"seytek-2012:p0875:b002:l036","ordinal":363771,"en":"And readied all his arms,"},{"id":"seytek-2012:p0875:b002:l037","ordinal":363772,"en":"Like a cloud driven by a gale,"},{"id":"seytek-2012:p0875:b002:l038","ordinal":363773,"en":"His wrath wheeled across his face,"},{"id":"seytek-2012:p0875:b002:l039","ordinal":363774,"en":"He was a giant of mighty spirit,"},{"id":"seytek-2012:p0875:b002:l040","ordinal":363775,"en":"Shallow in reason and without sense,"},{"id":"seytek-2012:p0875:b004:l001","ordinal":363776,"en":"An arrogant brute,"}]
