[{"id":"semetey-1-2013:p0523:b003:l019","ordinal":116993,"en":"Courage had been given beyond measure."},{"id":"semetey-1-2013:p0523:b003:l020","ordinal":116994,"en":"He continued on, heedless;"},{"id":"semetey-1-2013:p0523:b003:l021","ordinal":116995,"en":"From hero Manas himself"},{"id":"semetey-1-2013:p0523:b003:l022","ordinal":116996,"en":"He had been born, without measure."},{"id":"semetey-1-2013:p0523:b003:l023","ordinal":116997,"en":"All the wrestlers,"},{"id":"semetey-1-2013:p0523:b003:l024","ordinal":116998,"en":"Their old man with a forked beard,"},{"id":"semetey-1-2013:p0523:b003:l025","ordinal":116999,"en":"Their skilled battle-axe men,"},{"id":"semetey-1-2013:p0523:b003:l026","ordinal":117000,"en":"Their capable spearmen,"},{"id":"semetey-1-2013:p0523:b003:l027","ordinal":117001,"en":"Their formidable swordsmen,"},{"id":"semetey-1-2013:p0523:b003:l028","ordinal":117002,"en":"Their marksmen who never missed,"},{"id":"semetey-1-2013:p0523:b003:l029","ordinal":117003,"en":"That dear one left by Manas"},{"id":"semetey-1-2013:p0523:b003:l030","ordinal":117004,"en":"They all pursued together."},{"id":"semetey-1-2013:p0523:b003:l031","ordinal":117005,"en":"All the wrestlers shouted,"},{"id":"semetey-1-2013:p0523:b003:l032","ordinal":117006,"en":"Crying “Kokand!” as their battle cry."},{"id":"semetey-1-2013:p0523:b003:l033","ordinal":117007,"en":"“Hey, orphan slave, do not flee!” they said,"},{"id":"semetey-1-2013:p0523:b003:l034","ordinal":117008,"en":"As if to reap and gather him,"},{"id":"semetey-1-2013:p0523:b003:l035","ordinal":117009,"en":"As if to cast him alive into their pit,"},{"id":"semetey-1-2013:p0523:b003:l036","ordinal":117010,"en":"Before the high official,"},{"id":"semetey-1-2013:p0523:b003:l037","ordinal":117011,"en":"Without killing or losing him,"},{"id":"semetey-1-2013:p0523:b003:l038","ordinal":117012,"en":"As if to drive him there alive."},{"id":"semetey-1-2013:p0523:b003:l039","ordinal":117013,"en":"When one looked at those wrestlers,"},{"id":"semetey-1-2013:p0523:b005:l001","ordinal":117014,"en":"Their dreadful looks stood out;"},{"id":"semetey-1-2013:p0523:b005:l002","ordinal":117015,"en":"They looked like angels of death."},{"id":"semetey-1-2013:p0523:b005:l003","ordinal":117016,"en":"Their spearmen worked themselves up,"},{"id":"semetey-1-2013:p0523:b005:l004","ordinal":117017,"en":"“That orphan left by Manas,” they said,"},{"id":"semetey-1-2013:p0523:b005:l005","ordinal":117018,"en":"Calling him a scoundrel."},{"id":"semetey-1-2013:p0523:b005:l006","ordinal":117019,"en":"“Let them do what they will,” he thought."},{"id":"semetey-1-2013:p0523:b005:l007","ordinal":117020,"en":"Semetey did not look back at the wrestlers."},{"id":"semetey-1-2013:p0523:b005:l008","ordinal":117021,"en":"Looming bulky, heedless,"},{"id":"semetey-1-2013:p0523:b005:l009","ordinal":117022,"en":"The many wrestlers swarming upon him—"},{"id":"semetey-1-2013:p0523:b005:l010","ordinal":117023,"en":"Semetey went on,"},{"id":"semetey-1-2013:p0523:b005:l011","ordinal":117024,"en":"Valuing them less than his boot."},{"id":"semetey-1-2013:p0523:b005:l012","ordinal":117025,"en":"As the boy continued on,"},{"id":"semetey-1-2013:p0523:b005:l013","ordinal":117026,"en":"All their wrestlers,"},{"id":"semetey-1-2013:p0523:b005:l014","ordinal":117027,"en":"Their elder, the ishan dignitary,"},{"id":"semetey-1-2013:p0523:b005:l015","ordinal":117028,"en":"Now reached the boy,"},{"id":"semetey-1-2013:p0523:b005:l016","ordinal":117029,"en":"All those men of Kokand."},{"id":"semetey-1-2013:p0523:b005:l017","ordinal":117030,"en":"From among the skilled spearmen,"},{"id":"semetey-1-2013:p0523:b005:l018","ordinal":117031,"en":"The orphan left by Manas"},{"id":"semetey-1-2013:p0523:b005:l019","ordinal":117032,"en":"Ten thrust at him as they passed."},{"id":"semetey-1-2013:p0523:b005:l020","ordinal":117033,"en":"He had no fear of death;"},{"id":"semetey-1-2013:p0523:b005:l021","ordinal":117034,"en":"That accursed one's offspring"},{"id":"semetey-1-2013:p0523:b005:l022","ordinal":117035,"en":"Did not care whether they struck him."},{"id":"semetey-1-2013:p0523:b005:l023","ordinal":117036,"en":"His thoroughbred thundering,"},{"id":"semetey-1-2013:p0523:b005:l024","ordinal":117037,"en":"Broad-lunged and wheezing,"},{"id":"semetey-1-2013:p0523:b005:l025","ordinal":117038,"en":"Fork-bearded Akbalban"},{"id":"semetey-1-2013:p0523:b005:l026","ordinal":117039,"en":"Took his sword in his hand."},{"id":"semetey-1-2013:p0523:b005:l027","ordinal":117040,"en":"The only one visited by Kyzyr—"},{"id":"semetey-1-2013:p0523:b005:l028","ordinal":117041,"en":"The swordsmen reached the boy,"},{"id":"semetey-1-2013:p0523:b005:l029","ordinal":117042,"en":"Ten struck in succession,"},{"id":"semetey-1-2013:p0523:b005:l030","ordinal":117043,"en":"And passed on again."},{"id":"semetey-1-2013:p0523:b005:l031","ordinal":117044,"en":"They did not distract his thoughts a hair's breadth."},{"id":"semetey-1-2013:p0523:b005:l032","ordinal":117045,"en":"The swordsmen's blows"},{"id":"semetey-1-2013:p0523:b005:l033","ordinal":117046,"en":"The boy did not rate as much as a mosquito."},{"id":"semetey-1-2013:p0523:b005:l034","ordinal":117047,"en":"Thus the swordsmen passed,"},{"id":"semetey-1-2013:p0523:b005:l035","ordinal":117048,"en":"As if an evil spirit had struck their wives,"},{"id":"semetey-1-2013:p0523:b005:l036","ordinal":117049,"en":"As if their quarry were fleeing close by,"},{"id":"semetey-1-2013:p0523:b005:l037","ordinal":117050,"en":"As if hot on the heels of their quarry,"},{"id":"semetey-1-2013:p0523:b005:l038","ordinal":117051,"en":"As if their wives had borne sons,"},{"id":"semetey-1-2013:p0523:b005:l039","ordinal":117052,"en":"Flustered, crying “Go!”"},{"id":"semetey-1-2013:p0524:b003:l001","ordinal":117053,"en":"Sticking out their blue overshoes,"},{"id":"semetey-1-2013:p0524:b003:l002","ordinal":117054,"en":"Their thoroughbreds holding their heads high,"},{"id":"semetey-1-2013:p0524:b003:l003","ordinal":117055,"en":"Those white saddles of Kokand"},{"id":"semetey-1-2013:p0524:b003:l004","ordinal":117056,"en":"Had no cruppers at all."},{"id":"semetey-1-2013:p0524:b003:l005","ordinal":117057,"en":"All their horses were stallions."},{"id":"semetey-1-2013:p0524:b003:l006","ordinal":117058,"en":"These Sarts who attacked the lion protected by Kyzyr"},{"id":"semetey-1-2013:p0524:b003:l007","ordinal":117059,"en":"Had no sense."},{"id":"semetey-1-2013:p0524:b003:l008","ordinal":117060,"en":"Hurrying and stumbling in confusion,"},{"id":"semetey-1-2013:p0524:b003:l009","ordinal":117061,"en":"Their marksmen swarmed up."},{"id":"semetey-1-2013:p0524:b003:l010","ordinal":117062,"en":"With stocked, mighty guns,"},{"id":"semetey-1-2013:p0524:b003:l011","ordinal":117063,"en":"Ten wrestlers from among the marksmen"},{"id":"semetey-1-2013:p0524:b003:l012","ordinal":117064,"en":"Fired in succession as they passed."},{"id":"semetey-1-2013:p0524:b003:l013","ordinal":117065,"en":"The orphan hummed along, heedless."},{"id":"semetey-1-2013:p0524:b003:l014","ordinal":117066,"en":"The wrestlers' shooting,"},{"id":"semetey-1-2013:p0524:b003:l015","ordinal":117067,"en":"The havoc they were wreaking,"},{"id":"semetey-1-2013:p0524:b003:l016","ordinal":117068,"en":"That only son of Manas"},{"id":"semetey-1-2013:p0524:b003:l017","ordinal":117069,"en":"He valued less than a trouser hem."},{"id":"semetey-1-2013:p0524:b003:l018","ordinal":117070,"en":"A mottled wrestler on a flaxen-chestnut horse,"},{"id":"semetey-1-2013:p0524:b003:l019","ordinal":117071,"en":"And a gray wrestler with a curly beard,"},{"id":"semetey-1-2013:p0524:b003:l020","ordinal":117072,"en":"Swarmed up from behind."},{"id":"semetey-1-2013:p0524:b003:l021","ordinal":117073,"en":"The wrestlers with battle-axes,"},{"id":"semetey-1-2013:p0524:b003:l022","ordinal":117074,"en":"Each one in turn,"},{"id":"semetey-1-2013:p0524:b003:l023","ordinal":117075,"en":"Struck as they passed."},{"id":"semetey-1-2013:p0524:b003:l024","ordinal":117076,"en":"The orphan did not tilt or stir."},{"id":"semetey-1-2013:p0524:b003:l025","ordinal":117077,"en":"The offspring of the lion protected by Kyzyr"},{"id":"semetey-1-2013:p0524:b003:l026","ordinal":117078,"en":"Did not flinch before the wrestlers."},{"id":"semetey-1-2013:p0524:b003:l027","ordinal":117079,"en":"The great wrestlers carrying iron-headed maces"},{"id":"semetey-1-2013:p0524:b003:l028","ordinal":117080,"en":"All reached him together."},{"id":"semetey-1-2013:p0524:b003:l029","ordinal":117081,"en":"Each one in turn"},{"id":"semetey-1-2013:p0524:b003:l030","ordinal":117082,"en":"Struck the boy as he passed."},{"id":"semetey-1-2013:p0524:b003:l031","ordinal":117083,"en":"Curly-bearded Buka the Sart,"},{"id":"semetey-1-2013:p0524:b003:l032","ordinal":117084,"en":"That craggy great wrestler,"},{"id":"semetey-1-2013:p0524:b003:l033","ordinal":117085,"en":"He too struck as he passed."},{"id":"semetey-1-2013:p0524:b003:l034","ordinal":117086,"en":"His iron-headed mace"},{"id":"semetey-1-2013:p0524:b003:l035","ordinal":117087,"en":"Into the poor goshawk boy's"},{"id":"semetey-1-2013:p0524:b003:l036","ordinal":117088,"en":"Bones struck painfully."},{"id":"semetey-1-2013:p0524:b003:l037","ordinal":117089,"en":"Their flesh restored, they pranced,"},{"id":"semetey-1-2013:p0524:b003:l038","ordinal":117090,"en":"To the wrestler in front,"},{"id":"semetey-1-2013:p0524:b003:l039","ordinal":117091,"en":"Your fierce one was about to give something to talk about!"},{"id":"semetey-1-2013:p0524:b004:l001","ordinal":117092,"en":"Striking Aktulpar once on the thigh,"},{"id":"semetey-1-2013:p0524:b004:l002","ordinal":117093,"en":"His two eyes blazing,"},{"id":"semetey-1-2013:p0524:b004:l003","ordinal":117094,"en":"His splendid teeth like gates,"},{"id":"semetey-1-2013:p0524:b004:l004","ordinal":117095,"en":"Those many Sart wrestlers'"},{"id":"semetey-1-2013:p0524:b004:l005","ordinal":117096,"en":"Deeds were dreadful trouble."},{"id":"semetey-1-2013:p0524:b004:l006","ordinal":117097,"en":"He chewed over and over."},{"id":"semetey-1-2013:p0524:b004:l007","ordinal":117098,"en":"The orphan grew wrathful;"},{"id":"semetey-1-2013:p0524:b004:l008","ordinal":117099,"en":"His thirst for blood seized him."},{"id":"semetey-1-2013:p0524:b004:l009","ordinal":117100,"en":"To shrink back from no stone,"},{"id":"semetey-1-2013:p0524:b004:l010","ordinal":117101,"en":"His anger rose with deadly focus,"},{"id":"semetey-1-2013:p0524:b004:l011","ordinal":117102,"en":"To shrink back from no death."},{"id":"semetey-1-2013:p0524:b004:l012","ordinal":117103,"en":"“I honored them as Muslims."},{"id":"semetey-1-2013:p0524:b004:l013","ordinal":117104,"en":"Though I never stole their piebald horse,"},{"id":"semetey-1-2013:p0524:b004:l014","ordinal":117105,"en":"Every one of them beats me—"},{"id":"semetey-1-2013:p0524:b004:l015","ordinal":117106,"en":"What are they doing?"},{"id":"semetey-1-2013:p0524:b004:l016","ordinal":117107,"en":"Let me put an end to them all."},{"id":"semetey-1-2013:p0524:b004:l017","ordinal":117108,"en":"If they will not heed my words,"},{"id":"semetey-1-2013:p0524:b004:l018","ordinal":117109,"en":"These Sarts standing here,"},{"id":"semetey-1-2013:p0524:b004:l019","ordinal":117110,"en":"Let me slaughter them all."},{"id":"semetey-1-2013:p0524:b004:l020","ordinal":117111,"en":"That hairy-chested wretch,"},{"id":"semetey-1-2013:p0524:b004:l021","ordinal":117112,"en":"Let me put an end to him thus."},{"id":"semetey-1-2013:p0524:b004:l022","ordinal":117113,"en":"Let me make sport in my fury;"},{"id":"semetey-1-2013:p0524:b004:l023","ordinal":117114,"en":"The wrestler who struck first,"},{"id":"semetey-1-2013:p0524:b004:l024","ordinal":117115,"en":"Let me give him sport and trouble!”"},{"id":"semetey-1-2013:p0524:b004:l025","ordinal":117116,"en":"Saying this, Semetey,"},{"id":"semetey-1-2013:p0524:b004:l026","ordinal":117117,"en":"The orphan burst out shouting,"},{"id":"semetey-1-2013:p0524:b004:l027","ordinal":117118,"en":"Calling to the wrestlers:"},{"id":"semetey-1-2013:p0524:b004:l028","ordinal":117119,"en":"“Do not stick out your blue overshoes,"},{"id":"semetey-1-2013:p0524:b004:l029","ordinal":117120,"en":"Foul-looking men of Kokand!"},{"id":"semetey-1-2013:p0524:b004:l030","ordinal":117121,"en":"Do not make your fine horse toss its head."},{"id":"semetey-1-2013:p0524:b004:l031","ordinal":117122,"en":"Hey, Kokand! Hey, Kokand!"},{"id":"semetey-1-2013:p0524:b004:l032","ordinal":117123,"en":"Rein in your horse, Kokand!"},{"id":"semetey-1-2013:p0524:b004:l033","ordinal":117124,"en":"You will all be slaughtered."},{"id":"semetey-1-2013:p0524:b004:l034","ordinal":117125,"en":"Heed my words; turn back, Kokand!"},{"id":"semetey-1-2013:p0524:b004:l035","ordinal":117126,"en":"Damn your father's grave, Sart of Kokand!"},{"id":"semetey-1-2013:p0524:b004:l036","ordinal":117127,"en":"I came as a guest, and you beat me,"},{"id":"semetey-1-2013:p0524:b004:l037","ordinal":117128,"en":"Putting bitter pain within me."},{"id":"semetey-1-2013:p0524:b004:l038","ordinal":117129,"en":"Damn your father's grave, hey, Kokand!"},{"id":"semetey-1-2013:p0524:b004:l039","ordinal":117130,"en":"For all of you to thrust spears,"},{"id":"semetey-1-2013:p0525:b003:l001","ordinal":117131,"en":"For you to surround me,"},{"id":"semetey-1-2013:p0525:b003:l002","ordinal":117132,"en":"For you to take such firm revenge,"},{"id":"semetey-1-2013:p0525:b003:l003","ordinal":117133,"en":"Did I run off with your piebald horse,"},{"id":"semetey-1-2013:p0525:b003:l004","ordinal":117134,"en":"Shameless Sart of Kokand?"},{"id":"semetey-1-2013:p0525:b003:l005","ordinal":117135,"en":"Did I scatter your wealth of white silver coins?"},{"id":"semetey-1-2013:p0525:b003:l006","ordinal":117136,"en":"For all of you to come and surround me,"},{"id":"semetey-1-2013:p0525:b003:l007","ordinal":117137,"en":"For you to beat me so hard,"},{"id":"semetey-1-2013:p0525:b003:l008","ordinal":117138,"en":"Did I drive off your dun horse?"},{"id":"semetey-1-2013:p0525:b003:l009","ordinal":117139,"en":"Hey, God-forsaken Sart of Kokand,"},{"id":"semetey-1-2013:p0525:b003:l010","ordinal":117140,"en":"Did I scatter the valuables in your saddlebags?"},{"id":"semetey-1-2013:p0525:b003:l011","ordinal":117141,"en":"Before this, hey, Kokand,"},{"id":"semetey-1-2013:p0525:b003:l012","ordinal":117142,"en":"I did not plunder your wealth;"},{"id":"semetey-1-2013:p0525:b003:l013","ordinal":117143,"en":"I did not cause havoc before."},{"id":"semetey-1-2013:p0525:b003:l014","ordinal":117144,"en":"You stubborn wrestler,"},{"id":"semetey-1-2013:p0525:b003:l015","ordinal":117145,"en":"Calling all the devils together,"},{"id":"semetey-1-2013:p0525:b003:l016","ordinal":117146,"en":"Why have you attacked me so?"},{"id":"semetey-1-2013:p0525:b003:l017","ordinal":117147,"en":"Damn your father's grave, wrestler!"},{"id":"semetey-1-2013:p0525:b003:l018","ordinal":117148,"en":"Your guilt is on your own head;"},{"id":"semetey-1-2013:p0525:b003:l019","ordinal":117149,"en":"May your suffering fall upon your dark crown!"},{"id":"semetey-1-2013:p0525:b003:l020","ordinal":117150,"en":"If I leave you to your will, you will not stop."},{"id":"semetey-1-2013:p0525:b003:l021","ordinal":117151,"en":"Each of you strikes ten times;"},{"id":"semetey-1-2013:p0525:b003:l022","ordinal":117152,"en":"Nor do you leave me to my harmless thoughts."},{"id":"semetey-1-2013:p0525:b003:l023","ordinal":117153,"en":"Is havoc what you seek"},{"id":"semetey-1-2013:p0525:b003:l024","ordinal":117154,"en":"From Manas's orphan son?"},{"id":"semetey-1-2013:p0525:b003:l025","ordinal":117155,"en":"Now, my wrestlers,"},{"id":"semetey-1-2013:p0525:b003:l026","ordinal":117156,"en":"See what sport awaits!"},{"id":"semetey-1-2013:p0525:b003:l027","ordinal":117157,"en":"Is havoc what you want?"},{"id":"semetey-1-2013:p0525:b003:l028","ordinal":117158,"en":"If blood drives you, attack;"},{"id":"semetey-1-2013:p0525:b003:l029","ordinal":117159,"en":"Now see what sport I give you!”"},{"id":"semetey-1-2013:p0525:b003:l030","ordinal":117160,"en":"Saying this, Semetey,"},{"id":"semetey-1-2013:p0525:b003:l031","ordinal":117161,"en":"Wrathful, seized by blood-thirst,"},{"id":"semetey-1-2013:p0525:b003:l032","ordinal":117162,"en":"Was gripped by his fit."},{"id":"semetey-1-2013:p0525:b003:l033","ordinal":117163,"en":"Aktulpar beneath him,"},{"id":"semetey-1-2013:p0525:b003:l034","ordinal":117164,"en":"He lashed with his whip on either side,"},{"id":"semetey-1-2013:p0525:b003:l035","ordinal":117165,"en":"Spurring to right and left."},{"id":"semetey-1-2013:p0525:b003:l036","ordinal":117166,"en":"The wretched orphan left by generous Manas,"},{"id":"semetey-1-2013:p0525:b003:l037","ordinal":117167,"en":"Raging like a lion,"},{"id":"semetey-1-2013:p0525:b003:l038","ordinal":117168,"en":"Attacking the wrestlers,"},{"id":"semetey-1-2013:p0525:b003:l039","ordinal":117169,"en":"Semetey charged in, wild with excitement."},{"id":"semetey-1-2013:p0525:b004:l001","ordinal":117170,"en":"He raged and shouted,"},{"id":"semetey-1-2013:p0525:b004:l002","ordinal":117171,"en":"Drew his steel blade from its sheath,"},{"id":"semetey-1-2013:p0525:b004:l003","ordinal":117172,"en":"Cried “Manas!” as his battle cry."},{"id":"semetey-1-2013:p0525:b004:l004","ordinal":117173,"en":"That dauntless one, girded with the gray pouch-belt,"},{"id":"semetey-1-2013:p0525:b004:l005","ordinal":117174,"en":"Attacked the wrestlers,"},{"id":"semetey-1-2013:p0525:b004:l006","ordinal":117175,"en":"Striking each one once."},{"id":"semetey-1-2013:p0525:b004:l007","ordinal":117176,"en":"He made sport of them again and again."},{"id":"semetey-1-2013:p0525:b004:l008","ordinal":117177,"en":"Ten died where he made sport."},{"id":"semetey-1-2013:p0525:b004:l009","ordinal":117178,"en":"Four or five of the wrestlers"},{"id":"semetey-1-2013:p0525:b004:l010","ordinal":117179,"en":"Died on the ridge where they faced him."},{"id":"semetey-1-2013:p0525:b004:l011","ordinal":117180,"en":"Six or seven of their wrestlers"},{"id":"semetey-1-2013:p0525:b004:l012","ordinal":117181,"en":"Died where he made that sport."},{"id":"semetey-1-2013:p0525:b004:l013","ordinal":117182,"en":"When he reached Boz-Moynok,"},{"id":"semetey-1-2013:p0525:b004:l014","ordinal":117183,"en":"The wrestlers themselves stopped."},{"id":"semetey-1-2013:p0525:b004:l015","ordinal":117184,"en":"Having attacked the boy without cause,"},{"id":"semetey-1-2013:p0525:b004:l016","ordinal":117185,"en":"Sixty wrestlers perished through this."},{"id":"semetey-1-2013:p0525:b004:l018","ordinal":117186,"en":"Whatever he pleased in Kokand—"},{"id":"semetey-1-2013:p0525:b004:l019","ordinal":117187,"en":"Did you see your orphan do it?"},{"id":"semetey-1-2013:p0525:b004:l020","ordinal":117188,"en":"Some sixty wrestlers—"},{"id":"semetey-1-2013:p0525:b004:l021","ordinal":117189,"en":"Did you see Semetey slaughter them?"},{"id":"semetey-1-2013:p0525:b004:l022","ordinal":117190,"en":"They saw the face of Judgment Day."},{"id":"semetey-1-2013:p0525:b004:l023","ordinal":117191,"en":"Attacking the lion protected by Kyzyr,"},{"id":"semetey-1-2013:p0525:b004:l024","ordinal":117192,"en":"Those accursed wrestlers died."},{"id":"semetey-1-2013:p0525:b004:l025","ordinal":117193,"en":"Hearing the terrible news,"},{"id":"semetey-1-2013:p0525:b004:l026","ordinal":117194,"en":"That some sixty wrestlers"},{"id":"semetey-1-2013:p0525:b004:l027","ordinal":117195,"en":"Khan Manas's orphan"},{"id":"semetey-1-2013:p0525:b004:l028","ordinal":117196,"en":"Had slaughtered,"},{"id":"semetey-1-2013:p0525:b004:l029","ordinal":117197,"en":"No one went after him."},{"id":"semetey-1-2013:p0525:b004:l030","ordinal":117198,"en":"The people of Kokand feared his might;"},{"id":"semetey-1-2013:p0525:b004:l031","ordinal":117199,"en":"They did not avenge the wrestlers."},{"id":"semetey-1-2013:p0525:b004:l032","ordinal":117200,"en":"Against the twelve-year-old boy"},{"id":"semetey-1-2013:p0525:b004:l033","ordinal":117201,"en":"None remained who could withstand him."},{"id":"semetey-1-2013:p0525:b004:l034","ordinal":117202,"en":"For the only son born of Manas,"},{"id":"semetey-1-2013:p0525:b004:l035","ordinal":117203,"en":"Now there was no lament over the dead."},{"id":"semetey-1-2013:p0525:b004:l036","ordinal":117204,"en":"“Semetey will slaughter us,” they said."},{"id":"semetey-1-2013:p0525:b004:l037","ordinal":117205,"en":"Of the city of Kokand,"},{"id":"semetey-1-2013:p0525:b004:l038","ordinal":117206,"en":"Not a soul remained in the open country."},{"id":"semetey-1-2013:p0525:b004:l039","ordinal":117207,"en":"Mounting camel saddles, running on foot,"},{"id":"semetey-1-2013:p0526:b003:l001","ordinal":117208,"en":"The people of Kokand hurried inside."},{"id":"semetey-1-2013:p0526:b003:l002","ordinal":117209,"en":"Shutting the gate tight,"},{"id":"semetey-1-2013:p0526:b003:l003","ordinal":117210,"en":"The people of Kokand fled within."},{"id":"semetey-1-2013:p0526:b003:l004","ordinal":117211,"en":"Without turning back toward Kokand,"},{"id":"semetey-1-2013:p0526:b003:l005","ordinal":117212,"en":"Kozhosan's only son"},{"id":"semetey-1-2013:p0526:b003:l006","ordinal":117213,"en":"Stayed upon his journey."},{"id":"semetey-1-2013:p0526:b003:l007","ordinal":117214,"en":"Along Aman-Zhol, where his mother had come,"},{"id":"semetey-1-2013:p0526:b003:l008","ordinal":117215,"en":"Not a crow was heard cawing,"},{"id":"semetey-1-2013:p0526:b003:l009","ordinal":117216,"en":"Not a raven croaking."},{"id":"semetey-1-2013:p0526:b003:l010","ordinal":117217,"en":"There was no furrow touched by a plow,"},{"id":"semetey-1-2013:p0526:b003:l011","ordinal":117218,"en":"No burrow dug by a marmot,"},{"id":"semetey-1-2013:p0526:b003:l012","ordinal":117219,"en":"No pit to stumble into,"},{"id":"semetey-1-2013:p0526:b003:l013","ordinal":117220,"en":"No stump to trip a horse."},{"id":"semetey-1-2013:p0526:b003:l014","ordinal":117221,"en":"He traveled down Aman-Zhol,"},{"id":"semetey-1-2013:p0526:b003:l015","ordinal":117222,"en":"Went far, sparing no horse,"},{"id":"semetey-1-2013:p0526:b003:l016","ordinal":117223,"en":"Journeyed without sparing himself."},{"id":"semetey-1-2013:p0526:b003:l017","ordinal":117224,"en":"“If death comes, I shall die,” he thought."},{"id":"semetey-1-2013:p0526:b003:l018","ordinal":117225,"en":"“What Allah has ordained,"},{"id":"semetey-1-2013:p0526:b003:l019","ordinal":117226,"en":"Whatever it may be, I shall face."},{"id":"semetey-1-2013:p0526:b003:l020","ordinal":117227,"en":"For my khan father, Manas the Lion,"},{"id":"semetey-1-2013:p0526:b003:l021","ordinal":117228,"en":"I am going to recite the Qur'an."},{"id":"semetey-1-2013:p0526:b003:l022","ordinal":117229,"en":"The Argyn and Kyrgyz people in Talas"},{"id":"semetey-1-2013:p0526:b003:l023","ordinal":117230,"en":"Are the people my father left behind."},{"id":"semetey-1-2013:p0526:b003:l024","ordinal":117231,"en":"This year I shall see their faces.”"},{"id":"semetey-1-2013:p0526:b003:l025","ordinal":117232,"en":"He crossed the mottled, hilly land,"},{"id":"semetey-1-2013:p0526:b003:l026","ordinal":117233,"en":"Passed over gray, uneven ridges,"},{"id":"semetey-1-2013:p0526:b003:l027","ordinal":117234,"en":"Traversed the ranks of mountains,"},{"id":"semetey-1-2013:p0526:b003:l028","ordinal":117235,"en":"Followed along their edges."},{"id":"semetey-1-2013:p0526:b003:l029","ordinal":117236,"en":"The gray, mist-shrouded slopes"},{"id":"semetey-1-2013:p0526:b003:l030","ordinal":117237,"en":"He traveled along."},{"id":"semetey-1-2013:p0526:b003:l031","ordinal":117238,"en":"Crossing the Syr Darya, he pressed on,"},{"id":"semetey-1-2013:p0526:b003:l032","ordinal":117239,"en":"Crossed passes and trod over stones."},{"id":"semetey-1-2013:p0526:b003:l033","ordinal":117240,"en":"The boy's mind was troubled."},{"id":"semetey-1-2013:p0526:b003:l034","ordinal":117241,"en":"Hurrying on in haste,"},{"id":"semetey-1-2013:p0526:b003:l035","ordinal":117242,"en":"He journeyed toward Talas,"},{"id":"semetey-1-2013:p0526:b003:l036","ordinal":117243,"en":"Traveled far without tiring,"},{"id":"semetey-1-2013:p0526:b003:l037","ordinal":117244,"en":"Saw pass after separate pass,"},{"id":"semetey-1-2013:p0526:b003:l038","ordinal":117245,"en":"Saw many stretches of foothills,"},{"id":"semetey-1-2013:p0526:b003:l039","ordinal":117246,"en":"Passed through slender willows."},{"id":"semetey-1-2013:p0526:b004:l001","ordinal":117247,"en":"Chyiyrchyk and Salar, the two rivers—"},{"id":"semetey-1-2013:p0526:b004:l002","ordinal":117248,"en":"He traveled along their banks."}]
