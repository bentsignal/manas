[{"id":"seytek-1991-continuation:p0345:b001:l007","ordinal":388097,"en":"He cast away, bound by a hair."},{"id":"seytek-1991-continuation:p0345:b002:l001","ordinal":388098,"en":"Until I save our heads"},{"id":"seytek-1991-continuation:p0345:b002:l002","ordinal":388099,"en":"From the imperial host,"},{"id":"seytek-1991-continuation:p0345:b002:l003","ordinal":388100,"en":"For honor and for the people"},{"id":"seytek-1991-continuation:p0345:b002:l004","ordinal":388101,"en":"I will sacrifice my life!"},{"id":"seytek-1991-continuation:p0345:b002:l005","ordinal":388102,"en":"How can I remain alive"},{"id":"seytek-1991-continuation:p0345:b002:l006","ordinal":388103,"en":"While the inherited Kyrgyz people,"},{"id":"seytek-1991-continuation:p0345:b002:l007","ordinal":388104,"en":"The treasure I held dear,"},{"id":"seytek-1991-continuation:p0345:b002:l008","ordinal":388105,"en":"Are taken captive alive?"},{"id":"seytek-1991-continuation:p0345:b002:l009","ordinal":388106,"en":"Thus Er Kenen spoke,"},{"id":"seytek-1991-continuation:p0345:b002:l010","ordinal":388107,"en":"Spoke softly but firmly,"},{"id":"seytek-1991-continuation:p0345:b002:l011","ordinal":388108,"en":"And began addressing Jeljetpes:"},{"id":"seytek-1991-continuation:p0345:b002:l012","ordinal":388109,"en":"“Dear Jeljetpes,"},{"id":"seytek-1991-continuation:p0345:b002:l013","ordinal":388110,"en":"Do not let the Chinese take the land;"},{"id":"seytek-1991-continuation:p0345:b002:l014","ordinal":388111,"en":"Do not let the people be left without descendants;"},{"id":"seytek-1991-continuation:p0345:b002:l015","ordinal":388112,"en":"Do not let them slaughter every living soul."},{"id":"seytek-1991-continuation:p0345:b002:l016","ordinal":388113,"en":"My first forefather had sons one by one;"},{"id":"seytek-1991-continuation:p0345:b002:l017","ordinal":388114,"en":"After long yearning, I, Kenen,"},{"id":"seytek-1991-continuation:p0345:b002:l018","ordinal":388115,"en":"Was blessed with twin boys."},{"id":"seytek-1991-continuation:p0345:b002:l019","ordinal":388116,"en":"I held a feast and slaughtered ninety beasts,"},{"id":"seytek-1991-continuation:p0345:b002:l020","ordinal":388117,"en":"And gave them rhyming names."},{"id":"seytek-1991-continuation:p0345:b002:l021","ordinal":388118,"en":"They are medicine for my breast, my solace,"},{"id":"seytek-1991-continuation:p0345:b002:l022","ordinal":388119,"en":"My two only sons, whom I begged"},{"id":"seytek-1991-continuation:p0345:b002:l023","ordinal":388120,"en":"From God in the open steppe:"},{"id":"seytek-1991-continuation:p0345:b002:l024","ordinal":388121,"en":"My Alymsaryk and Kulansaryk,"},{"id":"seytek-1991-continuation:p0345:b002:l025","ordinal":388122,"en":"The light of my rising morning star."},{"id":"seytek-1991-continuation:p0345:b002:l026","ordinal":388123,"en":"Let them not die before a hidden foe;"},{"id":"seytek-1991-continuation:p0345:b002:l027","ordinal":388124,"en":"Let them not see the place of no return."},{"id":"seytek-1991-continuation:p0345:b002:l028","ordinal":388125,"en":"I entrust my twins to you!"},{"id":"seytek-1991-continuation:p0345:b002:l029","ordinal":388126,"en":"After fighting without rest for many days,"},{"id":"seytek-1991-continuation:p0345:b002:l030","ordinal":388127,"en":"I will let them bind my hands."},{"id":"seytek-1991-continuation:p0345:b002:l031","ordinal":388128,"en":"With the twin heroes following you,"},{"id":"seytek-1991-continuation:p0345:b002:l032","ordinal":388129,"en":"Find, Jeljetpes, a place"},{"id":"seytek-1991-continuation:p0345:b002:l033","ordinal":388130,"en":"Where you can escape alive,"},{"id":"seytek-1991-continuation:p0345:b002:l034","ordinal":388131,"en":"For the sake of the resolve you have made.”"},{"id":"seytek-1991-continuation:p0345:b003:l001","ordinal":388132,"en":"Parted from them,"},{"id":"seytek-1991-continuation:p0345:b004:l001","ordinal":388133,"en":"Thus Er Kenen spoke."},{"id":"seytek-1991-continuation:p0345:b004:l002","ordinal":388134,"en":"At Ak-Kaykan of At-Otpos,"},{"id":"seytek-1991-continuation:p0345:b004:l003","ordinal":388135,"en":"In a ravine no man could tread,"},{"id":"seytek-1991-continuation:p0345:b004:l004","ordinal":388136,"en":"Your gray-maned wolf had surpassed all"},{"id":"seytek-1991-continuation:p0345:b004:l005","ordinal":388137,"en":"In courage and lion-heartedness."},{"id":"seytek-1991-continuation:p0345:b004:l006","ordinal":388138,"en":"He again held back"},{"id":"seytek-1991-continuation:p0345:b004:l007","ordinal":388139,"en":"The infidels who surged upon him."},{"id":"seytek-1991-continuation:p0345:b006:l001","ordinal":388140,"en":"They stood face-to-face,"},{"id":"seytek-1991-continuation:p0345:b006:l002","ordinal":388141,"en":"Firing guns and drawing bows,"},{"id":"seytek-1991-continuation:p0345:b006:l003","ordinal":388142,"en":"Fighting in a bloody crush."},{"id":"seytek-1991-continuation:p0345:b006:l004","ordinal":388143,"en":"Arrows whirred from the bows,"},{"id":"seytek-1991-continuation:p0345:b006:l005","ordinal":388144,"en":"And shattered wherever they struck;"},{"id":"seytek-1991-continuation:p0345:b006:l006","ordinal":388145,"en":"Blood poured with a hiss."},{"id":"seytek-1991-continuation:p0345:b006:l007","ordinal":388146,"en":"Bullets flew like hail—"},{"id":"seytek-1991-continuation:p0345:b006:l008","ordinal":388147,"en":"No trial had ever equaled this!"},{"id":"seytek-1991-continuation:p0345:b006:l009","ordinal":388148,"en":"Through hollows, hills, and valleys,"},{"id":"seytek-1991-continuation:p0345:b006:l010","ordinal":388149,"en":"Black blood flowed rumbling."},{"id":"seytek-1991-continuation:p0345:b006:l011","ordinal":388150,"en":"The battle heaved and swelled;"},{"id":"seytek-1991-continuation:p0345:b006:l012","ordinal":388151,"en":"Dead men lay in heaps,"},{"id":"seytek-1991-continuation:p0345:b006:l013","ordinal":388152,"en":"Dead horses rose like mountains."},{"id":"seytek-1991-continuation:p0345:b006:l014","ordinal":388153,"en":"Every hill was dust,"},{"id":"seytek-1991-continuation:p0345:b006:l015","ordinal":388154,"en":"Every hollow filled with blood;"},{"id":"seytek-1991-continuation:p0345:b006:l016","ordinal":388155,"en":"Now a vast battle raged."},{"id":"seytek-1991-continuation:p0345:b006:l017","ordinal":388156,"en":"Chyntengir received the news."},{"id":"seytek-1991-continuation:p0345:b006:l018","ordinal":388157,"en":"He mounted a dun horse huge as a mountain,"},{"id":"seytek-1991-continuation:p0345:b006:l019","ordinal":388158,"en":"Put on a rippling deep-blue coat,"},{"id":"seytek-1991-continuation:p0345:b006:l020","ordinal":388159,"en":"And advanced, pouring out his rage."},{"id":"seytek-1991-continuation:p0345:b006:l021","ordinal":388160,"en":"He hitched up his belted coat"},{"id":"seytek-1991-continuation:p0345:b006:l022","ordinal":388161,"en":"And bore down upon Kenen,"},{"id":"seytek-1991-continuation:p0345:b006:l023","ordinal":388162,"en":"Who rode Kertulpar."},{"id":"seytek-1991-continuation:p0345:b006:l024","ordinal":388163,"en":"He advanced fearsomely, raising dust,"},{"id":"seytek-1991-continuation:p0345:b006:l025","ordinal":388164,"en":"Intent on reaching him now,"},{"id":"seytek-1991-continuation:p0345:b006:l026","ordinal":388165,"en":"On carrying him off"},{"id":"seytek-1991-continuation:p0345:b006:l027","ordinal":388166,"en":"And riding away unhurried."},{"id":"seytek-1991-continuation:p0345:b006:l028","ordinal":388167,"en":"When he drew near and faced him,"},{"id":"seytek-1991-continuation:p0345:b006:l029","ordinal":388168,"en":"Kenen prayed, “May God aid the solitary man."},{"id":"seytek-1991-continuation:p0345:b006:l030","ordinal":388169,"en":"Darkening like the burning sun,"},{"id":"seytek-1991-continuation:p0345:b006:l031","ordinal":388170,"en":"Let my noble soul depart;"},{"id":"seytek-1991-continuation:p0345:b006:l032","ordinal":388171,"en":"Let me duel with this boastful warrior"},{"id":"seytek-1991-continuation:p0345:b006:l033","ordinal":388172,"en":"And take my pillow beside me.”"},{"id":"seytek-1991-continuation:p0345:b006:l034","ordinal":388173,"en":"Thus Er Kenen spoke"},{"id":"seytek-1991-continuation:p0345:b006:l035","ordinal":388174,"en":"Against the infidel who poured out wrath,"},{"id":"seytek-1991-continuation:p0345:b006:l036","ordinal":388175,"en":"The alien enemy among the people,"},{"id":"seytek-1991-continuation:p0345:b006:l037","ordinal":388176,"en":"The hero Khan Chyntengir."},{"id":"seytek-1991-continuation:p0345:b006:l038","ordinal":388177,"en":"He turned his stallion's head"},{"id":"seytek-1991-continuation:p0345:b006:l039","ordinal":388178,"en":"And at once leveled his spear."},{"id":"seytek-1991-continuation:p0345:b006:l040","ordinal":388179,"en":"Before he could reach Chyntengir,"},{"id":"seytek-1991-continuation:p0345:b006:l041","ordinal":388180,"en":"Before he could strike him with the spear,"},{"id":"seytek-1991-continuation:p0345:b006:l042","ordinal":388181,"en":"Before he could use his great skill"},{"id":"seytek-1991-continuation:p0345:b006:l043","ordinal":388182,"en":"And cunning against the fearsome khan—"},{"id":"seytek-1991-continuation:p0345:b006:l044","ordinal":388183,"en":"Do not ask what Chyntengir was like:"},{"id":"seytek-1991-continuation:p0345:b006:l045","ordinal":388184,"en":"He had an armor-clad body,"},{"id":"seytek-1991-continuation:p0345:b006:l046","ordinal":388185,"en":"And endless speech."},{"id":"seytek-1991-continuation:p0345:b006:l047","ordinal":388186,"en":"His stone-hearted people"},{"id":"seytek-1991-continuation:p0345:b006:l048","ordinal":388187,"en":"Had strength where one equaled a thousand."},{"id":"seytek-1991-continuation:p0345:b006:l049","ordinal":388188,"en":"He had giants whose hunger no feast could sate."},{"id":"seytek-1991-continuation:p0346:b001:l001","ordinal":388189,"en":"Even if a mountain came instead of a man,"},{"id":"seytek-1991-continuation:p0346:b001:l002","ordinal":388190,"en":"They had strength enough to crush it."},{"id":"seytek-1991-continuation:p0346:b001:l003","ordinal":388191,"en":"He had a multitude of marksmen as companions;"},{"id":"seytek-1991-continuation:p0346:b001:l004","ordinal":388192,"en":"The finest of those companions"},{"id":"seytek-1991-continuation:p0346:b001:l005","ordinal":388193,"en":"Was Yengkor of the royal treasury,"},{"id":"seytek-1991-continuation:p0346:b001:l006","ordinal":388194,"en":"The ablest of spearmen,"},{"id":"seytek-1991-continuation:p0346:b001:l007","ordinal":388195,"en":"The finest deviser of stratagems."},{"id":"seytek-1991-continuation:p0346:b001:l008","ordinal":388196,"en":"None could match his horsemanship;"},{"id":"seytek-1991-continuation:p0346:b001:l009","ordinal":388197,"en":"If he narrowed his eye and took aim,"},{"id":"seytek-1991-continuation:p0346:b001:l010","ordinal":388198,"en":"No winged creature escaped alive."},{"id":"seytek-1991-continuation:p0346:b001:l011","ordinal":388199,"en":"He was calamity incarnate,"},{"id":"seytek-1991-continuation:p0346:b001:l012","ordinal":388200,"en":"The trusted support"},{"id":"seytek-1991-continuation:p0346:b001:l013","ordinal":388201,"en":"Of murderous Chyntengir."},{"id":"seytek-1991-continuation:p0346:b001:l014","ordinal":388202,"en":"He was now advancing,"},{"id":"seytek-1991-continuation:p0346:b001:l015","ordinal":388203,"en":"Ready to cast his eye"},{"id":"seytek-1991-continuation:p0346:b001:l016","ordinal":388204,"en":"Upon the gray-maned wolf, Er Kenen."},{"id":"seytek-1991-continuation:p0346:b001:l017","ordinal":388205,"en":"Er Kenen's Kertulpar"},{"id":"seytek-1991-continuation:p0346:b001:l018","ordinal":388206,"en":"Trailed a tail like a parrot's."},{"id":"seytek-1991-continuation:p0346:b001:l019","ordinal":388207,"en":"If a ninety-day desert lay ahead,"},{"id":"seytek-1991-continuation:p0346:b001:l020","ordinal":388208,"en":"He galloped without slowing."},{"id":"seytek-1991-continuation:p0346:b001:l021","ordinal":388209,"en":"He was a beast close to a demon,"},{"id":"seytek-1991-continuation:p0346:b001:l022","ordinal":388210,"en":"Endowed with the nature of a tulpar."},{"id":"seytek-1991-continuation:p0346:b001:l023","ordinal":388211,"en":"Yengkor aimed at Kertulpar,"},{"id":"seytek-1991-continuation:p0346:b001:l024","ordinal":388212,"en":"Taking the shoulder blade as his mark,"},{"id":"seytek-1991-continuation:p0346:b001:l025","ordinal":388213,"en":"The edge of the thick neck,"},{"id":"seytek-1991-continuation:p0346:b001:l026","ordinal":388214,"en":"The place where the spine would break,"},{"id":"seytek-1991-continuation:p0346:b001:l027","ordinal":388215,"en":"The very center of his measure,"},{"id":"seytek-1991-continuation:p0346:b001:l028","ordinal":388216,"en":"The dark pupil of death."},{"id":"seytek-1991-continuation:p0346:b001:l029","ordinal":388217,"en":"He measured carefully and fired."},{"id":"seytek-1991-continuation:p0346:b001:l030","ordinal":388218,"en":"Kertulpar beneath Kenen"},{"id":"seytek-1991-continuation:p0346:b001:l031","ordinal":388219,"en":"Reared and crashed down."},{"id":"seytek-1991-continuation:p0346:b001:l032","ordinal":388220,"en":"Stricken with boundless grief,"},{"id":"seytek-1991-continuation:p0346:b001:l033","ordinal":388221,"en":"Parted from Kertulpar,"},{"id":"seytek-1991-continuation:p0346:b001:l034","ordinal":388222,"en":"Surrounded on every side by troops,"},{"id":"seytek-1991-continuation:p0346:b001:l035","ordinal":388223,"en":"With abundant misery boiling,"},{"id":"seytek-1991-continuation:p0346:b001:l036","ordinal":388224,"en":"With neither battle cry nor people,"},{"id":"seytek-1991-continuation:p0346:b001:l037","ordinal":388225,"en":"Er Kenen stood alone in the fight."},{"id":"seytek-1991-continuation:p0346:b001:l038","ordinal":388226,"en":"He had no sheltering people around him,"},{"id":"seytek-1991-continuation:p0346:b001:l039","ordinal":388227,"en":"No stallion to mount when wearied,"},{"id":"seytek-1991-continuation:p0346:b001:l040","ordinal":388228,"en":"No Ebegey or Kogoy,"},{"id":"seytek-1991-continuation:p0346:b001:l041","ordinal":388229,"en":"Those heroes who waged mighty battle"},{"id":"seytek-1991-continuation:p0346:b001:l042","ordinal":388230,"en":"And came to rescue him."},{"id":"seytek-1991-continuation:p0346:b001:l043","ordinal":388231,"en":"He despaired of his dear life."},{"id":"seytek-1991-continuation:p0346:b001:l044","ordinal":388232,"en":"“Now I will capture this shameless man"},{"id":"seytek-1991-continuation:p0346:b001:l045","ordinal":388233,"en":"Who has been left without a horse,”"},{"id":"seytek-1991-continuation:p0346:b001:l046","ordinal":388234,"en":"Thought the boastful hero Yengkor."},{"id":"seytek-1991-continuation:p0346:b001:l047","ordinal":388235,"en":"Thinking himself a lion,"},{"id":"seytek-1991-continuation:p0346:b001:l048","ordinal":388236,"en":"That madman believed himself alone"},{"id":"seytek-1991-continuation:p0346:b001:l049","ordinal":388237,"en":"Equal to the whole world,"},{"id":"seytek-1991-continuation:p0346:b003:l001","ordinal":388238,"en":"And came striding near."},{"id":"seytek-1991-continuation:p0346:b003:l002","ordinal":388239,"en":"The lion Kenen saw him."},{"id":"seytek-1991-continuation:p0346:b003:l003","ordinal":388240,"en":"His nar-kesken was in his hand;"},{"id":"seytek-1991-continuation:p0346:b003:l004","ordinal":388241,"en":"He seized it firmly by the hilt"},{"id":"seytek-1991-continuation:p0346:b003:l005","ordinal":388242,"en":"And drew the sword"},{"id":"seytek-1991-continuation:p0346:b003:l006","ordinal":388243,"en":"From its sheath."},{"id":"seytek-1991-continuation:p0346:b003:l007","ordinal":388244,"en":"The hero and lion without a steed"},{"id":"seytek-1991-continuation:p0346:b003:l008","ordinal":388245,"en":"Neither hurried nor faltered."},{"id":"seytek-1991-continuation:p0346:b003:l009","ordinal":388246,"en":"Thinking, “Here at last is death,”"},{"id":"seytek-1991-continuation:p0346:b003:l010","ordinal":388247,"en":"He valued torment and death"},{"id":"seytek-1991-continuation:p0346:b003:l011","ordinal":388248,"en":"No more than a trouser cuff,"},{"id":"seytek-1991-continuation:p0346:b003:l012","ordinal":388249,"en":"For the Lord himself"},{"id":"seytek-1991-continuation:p0346:b003:l013","ordinal":388250,"en":"Had bestowed upon him"},{"id":"seytek-1991-continuation:p0346:b003:l014","ordinal":388251,"en":"Measureless courage."},{"id":"seytek-1991-continuation:p0346:b003:l015","ordinal":388252,"en":"He gripped and whirled the sword."},{"id":"seytek-1991-continuation:p0346:b003:l016","ordinal":388253,"en":"When the boar-like swine"},{"id":"seytek-1991-continuation:p0346:b003:l017","ordinal":388254,"en":"Came within cutting distance,"},{"id":"seytek-1991-continuation:p0346:b003:l018","ordinal":388255,"en":"He struck him across the neck."},{"id":"seytek-1991-continuation:p0346:b003:l019","ordinal":388256,"en":"The sword reached him with a whistle;"},{"id":"seytek-1991-continuation:p0346:b003:l020","ordinal":388257,"en":"From artery and neck flesh"},{"id":"seytek-1991-continuation:p0346:b003:l021","ordinal":388258,"en":"Black blood hissed."},{"id":"seytek-1991-continuation:p0346:b003:l022","ordinal":388259,"en":"His head, huge as a yurt,"},{"id":"seytek-1991-continuation:p0346:b003:l023","ordinal":388260,"en":"Tumbled rattling to the ground;"},{"id":"seytek-1991-continuation:p0346:b003:l024","ordinal":388261,"en":"Yengkor fell dead."},{"id":"seytek-1991-continuation:p0346:b003:l025","ordinal":388262,"en":"Fearsome Tengir saw"},{"id":"seytek-1991-continuation:p0346:b003:l026","ordinal":388263,"en":"That Yengkor had died."},{"id":"seytek-1991-continuation:p0346:b003:l027","ordinal":388264,"en":"He threw the whole world into panic,"},{"id":"seytek-1991-continuation:p0346:b003:l028","ordinal":388265,"en":"Spurring onward Kula-ker beneath him."},{"id":"seytek-1991-continuation:p0346:b003:l029","ordinal":388266,"en":"He shouted to his mace-men,"},{"id":"seytek-1991-continuation:p0346:b003:l030","ordinal":388267,"en":"Calling his great champions:"},{"id":"seytek-1991-continuation:p0346:b003:l031","ordinal":388268,"en":"“There is one Burut and a multitude of you;"},{"id":"seytek-1991-continuation:p0346:b003:l032","ordinal":388269,"en":"What kind of people are the tribal Chinese?"},{"id":"seytek-1991-continuation:p0346:b003:l033","ordinal":388270,"en":"Surge, Manchus, surge!"},{"id":"seytek-1991-continuation:p0346:b003:l034","ordinal":388271,"en":"Knead him into the earth and trample him!”"},{"id":"seytek-1991-continuation:p0346:b003:l035","ordinal":388272,"en":"Shouting for his spear of greatest havoc,"},{"id":"seytek-1991-continuation:p0346:b003:l036","ordinal":388273,"en":"The huge spear made by Ebegey,"},{"id":"seytek-1991-continuation:p0346:b003:l037","ordinal":388274,"en":"He bellowed and cried,"},{"id":"seytek-1991-continuation:p0346:b003:l038","ordinal":388275,"en":"Bending and flattening birch and willow,"},{"id":"seytek-1991-continuation:p0346:b003:l039","ordinal":388276,"en":"And summoned his countless champions."},{"id":"seytek-1991-continuation:p0346:b003:l040","ordinal":388277,"en":"At the horseless, weakened Kenen,"},{"id":"seytek-1991-continuation:p0346:b003:l041","ordinal":388278,"en":"To deprive him of every escape,"},{"id":"seytek-1991-continuation:p0346:b003:l042","ordinal":388279,"en":"Chyntengir strained and aimed,"},{"id":"seytek-1991-continuation:p0346:b003:l043","ordinal":388280,"en":"Taking the place beneath the heart,"},{"id":"seytek-1991-continuation:p0346:b003:l044","ordinal":388281,"en":"The measured edge of the lung,"},{"id":"seytek-1991-continuation:p0346:b003:l045","ordinal":388282,"en":"The exact center of his aim:"},{"id":"seytek-1991-continuation:p0346:b003:l046","ordinal":388283,"en":"“Even if he had a hundred thousand lives,"},{"id":"seytek-1991-continuation:p0346:b003:l047","ordinal":388284,"en":"They would all fly out here.”"},{"id":"seytek-1991-continuation:p0346:b003:l048","ordinal":388285,"en":"He turned his stallion's head,"},{"id":"seytek-1991-continuation:p0346:b003:l049","ordinal":388286,"en":"And his eyes blazed like fire."},{"id":"seytek-1991-continuation:p0347:b001:l001","ordinal":388287,"en":"His raging fury boiled over."},{"id":"seytek-1991-continuation:p0347:b001:l002","ordinal":388288,"en":"As he was about to strike with his spear,"},{"id":"seytek-1991-continuation:p0347:b001:l003","ordinal":388289,"en":"The hero and lion,"},{"id":"seytek-1991-continuation:p0347:b001:l004","ordinal":388290,"en":"Swift beyond measure,"},{"id":"seytek-1991-continuation:p0347:b001:l005","ordinal":388291,"en":"The most perceptive sage,"},{"id":"seytek-1991-continuation:p0347:b001:l006","ordinal":388292,"en":"Ground his teeth like millstones."},{"id":"seytek-1991-continuation:p0347:b001:l007","ordinal":388293,"en":"His eyes flashed like a lion's;"},{"id":"seytek-1991-continuation:p0347:b001:l008","ordinal":388294,"en":"He thrust and whirled the sword."},{"id":"seytek-1991-continuation:p0347:b001:l009","ordinal":388295,"en":"Er Kenen struck the dun horse"},{"id":"seytek-1991-continuation:p0347:b001:l010","ordinal":388296,"en":"At the place the poor hero had chosen,"},{"id":"seytek-1991-continuation:p0347:b001:l011","ordinal":388297,"en":"Drawing the blade across it."},{"id":"seytek-1991-continuation:p0347:b001:l012","ordinal":388298,"en":"When Kenen performed that feat,"},{"id":"seytek-1991-continuation:p0347:b001:l013","ordinal":388299,"en":"When he brought the sword down true,"},{"id":"seytek-1991-continuation:p0347:b001:l014","ordinal":388300,"en":"The champion Chyntengir's"},{"id":"seytek-1991-continuation:p0347:b001:l015","ordinal":388301,"en":"True stallion toppled."},{"id":"seytek-1991-continuation:p0347:b001:l016","ordinal":388302,"en":"Its house-sized head fell;"},{"id":"seytek-1991-continuation:p0347:b001:l017","ordinal":388303,"en":"As if a mountain had collapsed,"},{"id":"seytek-1991-continuation:p0347:b001:l018","ordinal":388304,"en":"The dun horse pitched over and lay still."},{"id":"seytek-1991-continuation:p0347:b001:l019","ordinal":388305,"en":"When Chyntengir was left on foot,"},{"id":"seytek-1991-continuation:p0347:b001:l020","ordinal":388306,"en":"Your father, the dear gray-maned hero,"},{"id":"seytek-1991-continuation:p0347:b001:l021","ordinal":388307,"en":"Hewed with his sword"},{"id":"seytek-1991-continuation:p0347:b002:l001","ordinal":388308,"en":"And shouted as he waged battle."},{"id":"seytek-1991-continuation:p0347:b003:l001","ordinal":388309,"en":"The sword shattered on the swine,"},{"id":"seytek-1991-continuation:p0347:b003:l002","ordinal":388310,"en":"Leaving only the hilt in his hand."},{"id":"seytek-1991-continuation:p0347:b003:l003","ordinal":388311,"en":"The Kaldays and chiefs,"},{"id":"seytek-1991-continuation:p0347:b003:l004","ordinal":388312,"en":"Men with iron lariat nets,"},{"id":"seytek-1991-continuation:p0347:b003:l005","ordinal":388313,"en":"All armed in iron,"},{"id":"seytek-1991-continuation:p0347:b003:l006","ordinal":388314,"en":"Fully armed infidels,"},{"id":"seytek-1991-continuation:p0347:b003:l007","ordinal":388315,"en":"Heroes who had come from Kakan,"},{"id":"seytek-1991-continuation:p0347:b003:l008","ordinal":388316,"en":"Mounted Chyntengir again"},{"id":"seytek-1991-continuation:p0347:b003:l009","ordinal":388317,"en":"On another swift stallion."},{"id":"seytek-1991-continuation:p0347:b003:l010","ordinal":388318,"en":"They put their khan on horseback,"},{"id":"seytek-1991-continuation:p0347:b003:l011","ordinal":388319,"en":"Burning Kenen's soul with anguish."},{"id":"seytek-1991-continuation:p0347:b003:l012","ordinal":388320,"en":"Then they cast iron lariat nets"},{"id":"seytek-1991-continuation:p0347:b003:l013","ordinal":388321,"en":"Over Kenen,"},{"id":"seytek-1991-continuation:p0347:b003:l014","ordinal":388322,"en":"Surrounded and attacked him,"},{"id":"seytek-1991-continuation:p0347:b003:l015","ordinal":388323,"en":"And truly robbed him of escape."},{"id":"seytek-1991-continuation:p0347:b003:l016","ordinal":388324,"en":"They firmly bound his hands."},{"id":"seytek-1991-continuation:p0347:b003:l017","ordinal":388325,"en":"Poor Kenen the leopard,"},{"id":"seytek-1991-continuation:p0347:b003:l018","ordinal":388326,"en":"The champion on whom hopes rested,"},{"id":"seytek-1991-continuation:p0347:b003:l019","ordinal":388327,"en":"The renowned hero of the Kyrgyz,"},{"id":"seytek-1991-continuation:p0347:b003:l020","ordinal":388328,"en":"Sultan of the white-capped people—"},{"id":"seytek-1991-continuation:p0347:b003:l021","ordinal":388329,"en":"Kenen was alone and the Chinese were a thousand."},{"id":"seytek-1991-continuation:p0347:b003:l022","ordinal":388330,"en":"They tore and ruined his coat,"},{"id":"seytek-1991-continuation:p0347:b003:l023","ordinal":388331,"en":"Displaying their great force,"},{"id":"seytek-1991-continuation:p0347:b003:l024","ordinal":388332,"en":"Tormenting his fly-like soul."},{"id":"seytek-1991-continuation:p0347:b003:l025","ordinal":388333,"en":"They wound his hands and feet tightly;"},{"id":"seytek-1991-continuation:p0347:b003:l026","ordinal":388334,"en":"Chyntengir bound and enclosed"},{"id":"seytek-1991-continuation:p0347:b003:l027","ordinal":388335,"en":"His entire body in chains."},{"id":"seytek-1991-continuation:p0347:b004:l001","ordinal":388336,"en":"They jerked him until his back bent,"},{"id":"seytek-1991-continuation:p0347:b004:l002","ordinal":388337,"en":"Loaded him upon a gray mule,"},{"id":"seytek-1991-continuation:p0347:b005:l001","ordinal":388338,"en":"And ordered, “Avenge your forefather!”"},{"id":"seytek-1991-continuation:p0347:b006:l001","ordinal":388339,"en":"They had their champions beat him"},{"id":"seytek-1991-continuation:p0347:b006:l002","ordinal":388340,"en":"And drove him before their khan."},{"id":"seytek-1991-continuation:p0347:b006:l003","ordinal":388341,"en":"Poor Kenen saw"},{"id":"seytek-1991-continuation:p0347:b006:l004","ordinal":388342,"en":"A cold and merciless black night."},{"id":"seytek-1991-continuation:p0347:b006:l005","ordinal":388343,"en":"“If you are a hero and a lion,"},{"id":"seytek-1991-continuation:p0347:b006:l006","ordinal":388344,"en":"Descendant of your Kalmyk forefather Kongurbay,"},{"id":"seytek-1991-continuation:p0347:b006:l007","ordinal":388345,"en":"Loosen my hands for a moment."},{"id":"seytek-1991-continuation:p0347:b006:l008","ordinal":388346,"en":"Let me see your heroism,"},{"id":"seytek-1991-continuation:p0347:b006:l009","ordinal":388347,"en":"And then I will take your head."},{"id":"seytek-1991-continuation:p0347:b006:l010","ordinal":388348,"en":"Release my hands,"},{"id":"seytek-1991-continuation:p0347:b006:l011","ordinal":388349,"en":"Then hear my answer."},{"id":"seytek-1991-continuation:p0347:b006:l012","ordinal":388350,"en":"While my eyelashes still move,"},{"id":"seytek-1991-continuation:p0347:b006:l013","ordinal":388351,"en":"How can you bend my back?"},{"id":"seytek-1991-continuation:p0347:b006:l014","ordinal":388352,"en":"How could I surrender my people?”"}]
