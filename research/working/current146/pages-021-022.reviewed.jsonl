{"id": "sayakbay-ms-current146:pdf022:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 22, "folio": 405, "line_in_page": 20, "raw": "Узун кулак каранын,", "text": "Узун кулак каранын,", "en": "Of the long-eared black one,", "classification": "narrative", "transcription_status": "visually_transcribed", "bbox": null}
