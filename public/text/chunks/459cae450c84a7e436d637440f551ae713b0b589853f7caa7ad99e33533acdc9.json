[{"id":"semetey-1-2013:p1293:b003:l024","ordinal":175873,"en":"If he truly has a grievance,"},{"id":"semetey-1-2013:p1293:b003:l025","ordinal":175874,"en":"Let him thrust and strike!"},{"id":"semetey-1-2013:p1293:b003:l026","ordinal":175875,"en":"Let him unleash his full wrath;"},{"id":"semetey-1-2013:p1293:b003:l027","ordinal":175876,"en":"I shall stand and grant his turn,"},{"id":"semetey-1-2013:p1293:b003:l028","ordinal":175877,"en":"And let him avenge whatever ancient wrong he bears."},{"id":"semetey-1-2013:p1293:b003:l029","ordinal":175878,"en":"Let him level his spear and strike me,"},{"id":"semetey-1-2013:p1293:b003:l030","ordinal":175879,"en":"Truly inflicting open humiliation;"},{"id":"semetey-1-2013:p1293:b003:l031","ordinal":175880,"en":"Will he not then look upon Buudan?"},{"id":"semetey-1-2013:p1293:b003:l032","ordinal":175881,"en":"If I do not strike back,"},{"id":"semetey-1-2013:p1293:b003:l033","ordinal":175882,"en":"Will he not regard me as kin?”"},{"id":"semetey-1-2013:p1293:b003:l034","ordinal":175883,"en":"Without flinching, Semetey"},{"id":"semetey-1-2013:p1293:b003:l035","ordinal":175884,"en":"Now stood looking ahead."},{"id":"semetey-1-2013:p1293:b003:l036","ordinal":175885,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1293:b003:l037","ordinal":175886,"en":"Tensed and thrust his spear."},{"id":"semetey-1-2013:p1293:b003:l038","ordinal":175887,"en":"In fury Chynkojo"},{"id":"semetey-1-2013:p1293:b003:l039","ordinal":175888,"en":"Charged and drove the spear."},{"id":"semetey-1-2013:p1293:b004:l001","ordinal":175889,"en":"His waist bent far backward,"},{"id":"semetey-1-2013:p1293:b004:l002","ordinal":175890,"en":"His eyes bulged out,"},{"id":"semetey-1-2013:p1293:b004:l003","ordinal":175891,"en":"His beard bristled strand by strand;"},{"id":"semetey-1-2013:p1293:b004:l004","ordinal":175892,"en":"Roaring in anger,"},{"id":"semetey-1-2013:p1293:b004:l005","ordinal":175893,"en":"Saying, “This side of the ornamented belt,"},{"id":"semetey-1-2013:p1293:b004:l006","ordinal":175894,"en":"Right at the edge of the lung,”"},{"id":"semetey-1-2013:p1293:b004:l007","ordinal":175895,"en":"He charged and drove his spear."},{"id":"semetey-1-2013:p1293:b004:l008","ordinal":175896,"en":"Semetey did not flinch."},{"id":"semetey-1-2013:p1293:b004:l009","ordinal":175897,"en":"Akolpok, inherited"},{"id":"semetey-1-2013:p1293:b004:l010","ordinal":175898,"en":"From his father, gray-wolf Manas,"},{"id":"semetey-1-2013:p1293:b004:l011","ordinal":175899,"en":"Yielded to no such foe,"},{"id":"semetey-1-2013:p1293:b004:l012","ordinal":175900,"en":"Armor fitted to your lion."},{"id":"semetey-1-2013:p1293:b004:l013","ordinal":175901,"en":"Saying, “It has grown very old,”"},{"id":"semetey-1-2013:p1293:b004:l014","ordinal":175902,"en":"Your poor mother had repaired it,"},{"id":"semetey-1-2013:p1293:b004:l015","ordinal":175903,"en":"Mending every pierced place."},{"id":"semetey-1-2013:p1293:b004:l016","ordinal":175904,"en":"When it reached Akolpok,"},{"id":"semetey-1-2013:p1293:b004:l017","ordinal":175905,"en":"Khojo’s spear"},{"id":"semetey-1-2013:p1293:b004:l018","ordinal":175906,"en":"Shattered into eighty pieces,"},{"id":"semetey-1-2013:p1293:b004:l019","ordinal":175907,"en":"And Khojo’s stratagem failed."},{"id":"semetey-1-2013:p1293:b004:l020","ordinal":175908,"en":"Had he not seen many lands,"},{"id":"semetey-1-2013:p1293:b004:l021","ordinal":175909,"en":"That accomplished Khojo?"},{"id":"semetey-1-2013:p1293:b004:l022","ordinal":175910,"en":"Did he not know the enemy’s stratagems,"},{"id":"semetey-1-2013:p1293:b004:l023","ordinal":175911,"en":"That experienced Khojo?"},{"id":"semetey-1-2013:p1293:b004:l024","ordinal":175912,"en":"A great club as large as a house—"},{"id":"semetey-1-2013:p1293:b004:l025","ordinal":175913,"en":"That road-hardened Khojo"},{"id":"semetey-1-2013:p1293:b004:l026","ordinal":175914,"en":"Seized and swung in his hand;"},{"id":"semetey-1-2013:p1293:b004:l027","ordinal":175915,"en":"Gripping it with both hands,"},{"id":"semetey-1-2013:p1293:b004:l028","ordinal":175916,"en":"At the prince, mighty as Khoja,"},{"id":"semetey-1-2013:p1293:b004:l029","ordinal":175917,"en":"He brought it down upon the crown."},{"id":"semetey-1-2013:p1293:b004:l030","ordinal":175918,"en":"When the club struck his head,"},{"id":"semetey-1-2013:p1293:b004:l031","ordinal":175919,"en":"Chynkojo’s cast-iron mace-head—"},{"id":"semetey-1-2013:p1293:b004:l032","ordinal":175920,"en":"Its shaft burst apart,"},{"id":"semetey-1-2013:p1293:b004:l033","ordinal":175921,"en":"Its head flew rattling away."},{"id":"semetey-1-2013:p1293:b004:l034","ordinal":175922,"en":"The helmet worn upon his head,"},{"id":"semetey-1-2013:p1293:b004:l035","ordinal":175923,"en":"At the very place the blow struck,"},{"id":"semetey-1-2013:p1293:b004:l036","ordinal":175924,"en":"Had stretched and bent;"},{"id":"semetey-1-2013:p1293:b004:l037","ordinal":175925,"en":"But Charaina, fashioned"},{"id":"semetey-1-2013:p1293:b004:l038","ordinal":175926,"en":"By your dear mother Kanykei,"},{"id":"semetey-1-2013:p1293:b004:l039","ordinal":175927,"en":"Had remained and stopped the blow."},{"id":"semetey-1-2013:p1294:b003:l001","ordinal":175928,"en":"When Semetey granted him his turn,"},{"id":"semetey-1-2013:p1294:b003:l002","ordinal":175929,"en":"Those dear eyes like black currants"},{"id":"semetey-1-2013:p1294:b003:l003","ordinal":175930,"en":"He nearly gouged out."},{"id":"semetey-1-2013:p1294:b003:l004","ordinal":175931,"en":"That black-hearted dog Khojo"},{"id":"semetey-1-2013:p1294:b003:l005","ordinal":175932,"en":"The orphaned son of Manas"},{"id":"semetey-1-2013:p1294:b003:l006","ordinal":175933,"en":"He nearly slaughtered."},{"id":"semetey-1-2013:p1294:b003:l007","ordinal":175934,"en":"His kinsman became his enemy,"},{"id":"semetey-1-2013:p1294:b003:l008","ordinal":175935,"en":"And within the leopard prince and sultan"},{"id":"semetey-1-2013:p1294:b003:l009","ordinal":175936,"en":"An enemy arose."},{"id":"semetey-1-2013:p1294:b003:l010","ordinal":175937,"en":"Unable to stand his burning rage,"},{"id":"semetey-1-2013:p1294:b003:l011","ordinal":175938,"en":"The falcon prince and sultan"},{"id":"semetey-1-2013:p1294:b003:l012","ordinal":175939,"en":"Revealed his gray-wolf nature."},{"id":"semetey-1-2013:p1294:b003:l013","ordinal":175940,"en":"His dear teeth, broad as a gate,"},{"id":"semetey-1-2013:p1294:b003:l014","ordinal":175941,"en":"Teeth unlike those of ordinary people,"},{"id":"semetey-1-2013:p1294:b003:l015","ordinal":175942,"en":"Showed apart like grains of millet;"},{"id":"semetey-1-2013:p1294:b003:l016","ordinal":175943,"en":"From his mouth blue flame"},{"id":"semetey-1-2013:p1294:b003:l017","ordinal":175944,"en":"Poured as though from a loaded gun."},{"id":"semetey-1-2013:p1294:b003:l018","ordinal":175945,"en":"His eyes burned like embers,"},{"id":"semetey-1-2013:p1294:b003:l019","ordinal":175946,"en":"Stirring the heart of whoever saw him;"},{"id":"semetey-1-2013:p1294:b003:l020","ordinal":175947,"en":"He looked like a blue tiger."},{"id":"semetey-1-2013:p1294:b003:l021","ordinal":175948,"en":"His wrath darkened his face;"},{"id":"semetey-1-2013:p1294:b003:l022","ordinal":175949,"en":"The great and towering Buurul—"},{"id":"semetey-1-2013:p1294:b003:l023","ordinal":175950,"en":"He pulled the reins and turned its head."},{"id":"semetey-1-2013:p1294:b003:l024","ordinal":175951,"en":"The sultan’s Syrnaiza, which drank blood"},{"id":"semetey-1-2013:p1294:b003:l025","ordinal":175952,"en":"Whenever he leveled it,"},{"id":"semetey-1-2013:p1294:b003:l026","ordinal":175953,"en":"He gripped at full length and thrust."},{"id":"semetey-1-2013:p1294:b003:l027","ordinal":175954,"en":"Seizing and swinging his spear,"},{"id":"semetey-1-2013:p1294:b003:l028","ordinal":175955,"en":"He drew the great Buurul"},{"id":"semetey-1-2013:p1294:b003:l029","ordinal":175956,"en":"Hard beneath his thighs;"},{"id":"semetey-1-2013:p1294:b003:l030","ordinal":175957,"en":"Without looking around,"},{"id":"semetey-1-2013:p1294:b003:l031","ordinal":175958,"en":"Your ocean-like hero charged Khojo,"},{"id":"semetey-1-2013:p1294:b003:l032","ordinal":175959,"en":"With no care at all for his life."},{"id":"semetey-1-2013:p1294:b003:l033","ordinal":175960,"en":"On the spur of the broken mountain,"},{"id":"semetey-1-2013:p1294:b003:l034","ordinal":175961,"en":"At the looming promontory,"},{"id":"semetey-1-2013:p1294:b003:l035","ordinal":175962,"en":"He arrived ahead of an arrow;"},{"id":"semetey-1-2013:p1294:b003:l036","ordinal":175963,"en":"On reaching him, he drove the spear."},{"id":"semetey-1-2013:p1294:b003:l037","ordinal":175964,"en":"That expert Khojo"},{"id":"semetey-1-2013:p1294:b003:l038","ordinal":175965,"en":"Took his battle-axe in hand"},{"id":"semetey-1-2013:p1294:b003:l039","ordinal":175966,"en":"And knocked the spear aside before it struck."},{"id":"semetey-1-2013:p1294:b004:l001","ordinal":175967,"en":"When the spear passed beyond him,"},{"id":"semetey-1-2013:p1294:b004:l002","ordinal":175968,"en":"And flew out without touching him,"},{"id":"semetey-1-2013:p1294:b004:l003","ordinal":175969,"en":"At his side was a small golden pouch,"},{"id":"semetey-1-2013:p1294:b004:l004","ordinal":175970,"en":"In his right hand the gold-cheeked battle-axe."},{"id":"semetey-1-2013:p1294:b004:l005","ordinal":175971,"en":"The lion-hero, seized by rage,"},{"id":"semetey-1-2013:p1294:b004:l006","ordinal":175972,"en":"Gripped it and swung,"},{"id":"semetey-1-2013:p1294:b004:l007","ordinal":175973,"en":"At the lordly Khojo"},{"id":"semetey-1-2013:p1294:b004:l008","ordinal":175974,"en":"He brought it down upon the crown."},{"id":"semetey-1-2013:p1294:b004:l009","ordinal":175975,"en":"Lord Khojo then"},{"id":"semetey-1-2013:p1294:b004:l010","ordinal":175976,"en":"Semetey’s violent humiliation"},{"id":"semetey-1-2013:p1294:b004:l011","ordinal":175977,"en":"Was made to behold."},{"id":"semetey-1-2013:p1294:b004:l012","ordinal":175978,"en":"From the axe that struck his crown,"},{"id":"semetey-1-2013:p1294:b004:l013","ordinal":175979,"en":"He nearly fell dead."},{"id":"semetey-1-2013:p1294:b004:l014","ordinal":175980,"en":"From the axe that struck his crown,"},{"id":"semetey-1-2013:p1294:b004:l015","ordinal":175981,"en":"His shield burst apart;"},{"id":"semetey-1-2013:p1294:b004:l016","ordinal":175982,"en":"His fly-like life shrieked,"},{"id":"semetey-1-2013:p1294:b004:l017","ordinal":175983,"en":"His foot slipped from the stirrup,"},{"id":"semetey-1-2013:p1294:b004:l018","ordinal":175984,"en":"And he slid backward from the saddle."},{"id":"semetey-1-2013:p1294:b004:l019","ordinal":175985,"en":"His two eyes rolled,"},{"id":"semetey-1-2013:p1294:b004:l020","ordinal":175986,"en":"His two legs hung loose,"},{"id":"semetey-1-2013:p1294:b004:l021","ordinal":175987,"en":"His wineskin-like nose flapped,"},{"id":"semetey-1-2013:p1294:b004:l022","ordinal":175988,"en":"And both coat skirts fluttered."},{"id":"semetey-1-2013:p1294:b004:l023","ordinal":175989,"en":"He lost his wits,"},{"id":"semetey-1-2013:p1294:b004:l024","ordinal":175990,"en":"And toward a saddle-shaped ridge"},{"id":"semetey-1-2013:p1294:b004:l025","ordinal":175991,"en":"Khojo fled upward."},{"id":"semetey-1-2013:p1294:b004:l026","ordinal":175992,"en":"Your command-bearing gray wolf"},{"id":"semetey-1-2013:p1294:b004:l027","ordinal":175993,"en":"Now turned Buurul’s head."},{"id":"semetey-1-2013:p1294:b004:l028","ordinal":175994,"en":"Akkelte, inherited"},{"id":"semetey-1-2013:p1294:b004:l029","ordinal":175995,"en":"From his father, lion Manas,"},{"id":"semetey-1-2013:p1294:b004:l030","ordinal":175996,"en":"He took from his shoulder."},{"id":"semetey-1-2013:p1294:b004:l031","ordinal":175997,"en":"Its match burned like an ember;"},{"id":"semetey-1-2013:p1294:b004:l032","ordinal":175998,"en":"It had long stood loaded."},{"id":"semetey-1-2013:p1294:b004:l033","ordinal":175999,"en":"When he took it in hand"},{"id":"semetey-1-2013:p1294:b004:l034","ordinal":176000,"en":"And leveled it at Khojo,"},{"id":"semetey-1-2013:p1294:b004:l035","ordinal":176001,"en":"The purest aid to marksmanship,"},{"id":"semetey-1-2013:p1294:b004:l036","ordinal":176002,"en":"Its forked rest stood ready."},{"id":"semetey-1-2013:p1294:b004:l037","ordinal":176003,"en":"“At the joint of the elbow—"},{"id":"semetey-1-2013:p1294:b004:l038","ordinal":176004,"en":"This, as you see, is truly"},{"id":"semetey-1-2013:p1294:b004:l039","ordinal":176005,"en":"The hour of Khojo’s death,” he said,"},{"id":"semetey-1-2013:p1295:b003:l001","ordinal":176006,"en":"Your gray wolf, born a lion,"},{"id":"semetey-1-2013:p1295:b003:l002","ordinal":176007,"en":"Fired Ak-Kelte once,"},{"id":"semetey-1-2013:p1295:b003:l003","ordinal":176008,"en":"When the gun's report rang out,"},{"id":"semetey-1-2013:p1295:b003:l004","ordinal":176009,"en":"Poor Kojo darted aside."},{"id":"semetey-1-2013:p1295:b003:l005","ordinal":176010,"en":"The shot went astray,"},{"id":"semetey-1-2013:p1295:b003:l006","ordinal":176011,"en":"Missing him then,"},{"id":"semetey-1-2013:p1295:b003:l007","ordinal":176012,"en":"It tore away a mat-sized patch of turf."},{"id":"semetey-1-2013:p1295:b003:l008","ordinal":176013,"en":"Despairing of his precious life,"},{"id":"semetey-1-2013:p1295:b003:l009","ordinal":176014,"en":"That Kojo grew enraged,"},{"id":"semetey-1-2013:p1295:b003:l010","ordinal":176015,"en":"And stirred up God's weather."},{"id":"semetey-1-2013:p1295:b003:l011","ordinal":176016,"en":"The weather-stone inherited"},{"id":"semetey-1-2013:p1295:b003:l012","ordinal":176017,"en":"From noble gray-wolf Alman,"},{"id":"semetey-1-2013:p1295:b003:l013","ordinal":176018,"en":"He took and placed in water,"},{"id":"semetey-1-2013:p1295:b003:l014","ordinal":176019,"en":"And the spell of Chinmachin"},{"id":"semetey-1-2013:p1295:b003:l015","ordinal":176020,"en":"He began to recite in earnest."},{"id":"semetey-1-2013:p1295:b003:l016","ordinal":176021,"en":"Mist arose from level ground,"},{"id":"semetey-1-2013:p1295:b003:l017","ordinal":176022,"en":"Clouds covered the mountains,"},{"id":"semetey-1-2013:p1295:b003:l018","ordinal":176023,"en":"From the towering mountains"},{"id":"semetey-1-2013:p1295:b003:l019","ordinal":176024,"en":"A black wind thundered,"},{"id":"semetey-1-2013:p1295:b003:l020","ordinal":176025,"en":"And in Kojo, son of Shygai,"},{"id":"semetey-1-2013:p1295:b003:l021","ordinal":176026,"en":"The guise of a weather-maker appeared."},{"id":"semetey-1-2013:p1295:b003:l022","ordinal":176027,"en":"As though poured from buckets,"},{"id":"semetey-1-2013:p1295:b003:l023","ordinal":176028,"en":"Blue-speckled hail spilled from the sky,"},{"id":"semetey-1-2013:p1295:b003:l024","ordinal":176029,"en":"Low mist crept down,"},{"id":"semetey-1-2013:p1295:b003:l025","ordinal":176030,"en":"And then there moved"},{"id":"semetey-1-2013:p1295:b003:l026","ordinal":176031,"en":"A red haze and driving sleet."},{"id":"semetey-1-2013:p1295:b003:l027","ordinal":176032,"en":"All the lowlands filled with rain,"},{"id":"semetey-1-2013:p1295:b003:l028","ordinal":176033,"en":"All the foothills filled with hail,"},{"id":"semetey-1-2013:p1295:b003:l029","ordinal":176034,"en":"Flurries and driving sleet,"},{"id":"semetey-1-2013:p1295:b003:l030","ordinal":176035,"en":"Clouds gathered overhead,"},{"id":"semetey-1-2013:p1295:b003:l031","ordinal":176036,"en":"The earth seemed to split,"},{"id":"semetey-1-2013:p1295:b003:l032","ordinal":176037,"en":"And God struck the heavens."},{"id":"semetey-1-2013:p1295:b003:l033","ordinal":176038,"en":"The spell of Kakan-Chin"},{"id":"semetey-1-2013:p1295:b003:l034","ordinal":176039,"en":"Poor Kojo then"},{"id":"semetey-1-2013:p1295:b003:l035","ordinal":176040,"en":"Stood boldly reciting."},{"id":"semetey-1-2013:p1295:b003:l036","ordinal":176041,"en":"His fiery eyes blazed fiercely,"},{"id":"semetey-1-2013:p1295:b003:l037","ordinal":176042,"en":"The lion prince Semetey,"},{"id":"semetey-1-2013:p1295:b003:l038","ordinal":176043,"en":"Truly seized by his bloodlust,"},{"id":"semetey-1-2013:p1295:b003:l039","ordinal":176044,"en":"Was about to assail Kojo,"},{"id":"semetey-1-2013:p1295:b004:l001","ordinal":176045,"en":"Was about to grapple with him."},{"id":"semetey-1-2013:p1295:b004:l002","ordinal":176046,"en":"As he raised Ak-Kelte again,"},{"id":"semetey-1-2013:p1295:b004:l003","ordinal":176047,"en":"As he was about to shoot Kojo,"},{"id":"semetey-1-2013:p1295:b004:l004","ordinal":176048,"en":"Chynkojo's Black Horse—"},{"id":"semetey-1-2013:p1295:b004:l005","ordinal":176049,"en":"That Black Horse, it seems,"},{"id":"semetey-1-2013:p1295:b004:l006","ordinal":176050,"en":"Had wings upon its flanks,"},{"id":"semetey-1-2013:p1295:b004:l007","ordinal":176051,"en":"And, when a wondrous spell was read,"},{"id":"semetey-1-2013:p1295:b004:l008","ordinal":176052,"en":"Was accustomed to fly."},{"id":"semetey-1-2013:p1295:b004:l009","ordinal":176053,"en":"A mighty sorcerer and magician"},{"id":"semetey-1-2013:p1295:b004:l010","ordinal":176054,"en":"Had fashioned this for Kojo:"},{"id":"semetey-1-2013:p1295:b004:l011","ordinal":176055,"en":"Beneath him was his racehorse, the Black Horse."},{"id":"semetey-1-2013:p1295:b004:l012","ordinal":176056,"en":"When his precious life was pressed,"},{"id":"semetey-1-2013:p1295:b004:l013","ordinal":176057,"en":"Whenever it saw an enemy in battle,"},{"id":"semetey-1-2013:p1295:b004:l014","ordinal":176058,"en":"It was accustomed to rise and fly."},{"id":"semetey-1-2013:p1295:b004:l015","ordinal":176059,"en":"That Kojo was a master;"},{"id":"semetey-1-2013:p1295:b004:l016","ordinal":176060,"en":"Ask not the full extent of his powers,"},{"id":"semetey-1-2013:p1295:b004:l017","ordinal":176061,"en":"Kojo was a lion aided by spirits."},{"id":"semetey-1-2013:p1295:b004:l018","ordinal":176062,"en":"Resourceful, he went flying,"},{"id":"semetey-1-2013:p1295:b004:l019","ordinal":176063,"en":"Kojo was a hero of formidable spirit."},{"id":"semetey-1-2013:p1295:b004:l020","ordinal":176064,"en":"Mingling with the mirage,"},{"id":"semetey-1-2013:p1295:b004:l021","ordinal":176065,"en":"Chynkojo entered the tumult."},{"id":"semetey-1-2013:p1295:b004:l022","ordinal":176066,"en":"In a deed no son of man would believe,"},{"id":"semetey-1-2013:p1295:b004:l023","ordinal":176067,"en":"Chynkojo entered the fray."},{"id":"semetey-1-2013:p1295:b004:l024","ordinal":176068,"en":"Much of it is false, much is true;"},{"id":"semetey-1-2013:p1295:b004:l025","ordinal":176069,"en":"No one has gone and seen it,"},{"id":"semetey-1-2013:p1295:b004:l026","ordinal":176070,"en":"And unless manifest God knows,"},{"id":"semetey-1-2013:p1295:b004:l027","ordinal":176071,"en":"We cannot tell whether it is true."},{"id":"semetey-1-2013:p1295:b004:l028","ordinal":176072,"en":"Half is false and half is true;"},{"id":"semetey-1-2013:p1295:b004:l029","ordinal":176073,"en":"Unless the Creator himself knows,"},{"id":"semetey-1-2013:p1295:b004:l030","ordinal":176074,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1295:b004:l031","ordinal":176075,"en":"Kojo whose deeds were formidable,"},{"id":"semetey-1-2013:p1295:b004:l032","ordinal":176076,"en":"Kojo with broad right shoulder,"},{"id":"semetey-1-2013:p1295:b004:l033","ordinal":176077,"en":"Kojo, a hero surpassing the world,"},{"id":"semetey-1-2013:p1295:b004:l034","ordinal":176078,"en":"Kojo perfect in all twelve limbs,"},{"id":"semetey-1-2013:p1295:b004:l035","ordinal":176079,"en":"Was angered and enraged,"},{"id":"semetey-1-2013:p1295:b004:l036","ordinal":176080,"en":"While the racehorse beneath him,"},{"id":"semetey-1-2013:p1295:b004:l037","ordinal":176081,"en":"Circling like a blue vulture,"},{"id":"semetey-1-2013:p1295:b004:l038","ordinal":176082,"en":"With jezail gun and steel-tipped arrow,"},{"id":"semetey-1-2013:p1295:b004:l039","ordinal":176083,"en":"Kojo girded himself once more,"},{"id":"semetey-1-2013:p1296:b003:l001","ordinal":176084,"en":"He was about to trace the line,"},{"id":"semetey-1-2013:p1296:b003:l002","ordinal":176085,"en":"Upon Semetey's head"},{"id":"semetey-1-2013:p1296:b003:l003","ordinal":176086,"en":"He meant to work a marvel."},{"id":"semetey-1-2013:p1296:b003:l004","ordinal":176087,"en":"He meant to aggravate the wound,"},{"id":"semetey-1-2013:p1296:b003:l005","ordinal":176088,"en":"Upon Semetey's head"},{"id":"semetey-1-2013:p1296:b003:l006","ordinal":176089,"en":"He meant to bring calamity."},{"id":"semetey-1-2013:p1296:b003:l007","ordinal":176090,"en":"He meant to burn his heart,"},{"id":"semetey-1-2013:p1296:b003:l008","ordinal":176091,"en":"Upon Semetey's head"},{"id":"semetey-1-2013:p1296:b003:l009","ordinal":176092,"en":"Your Kojo meant to wreak"},{"id":"semetey-1-2013:p1296:b003:l010","ordinal":176093,"en":"Havoc no man could wreak."},{"id":"semetey-1-2013:p1296:b003:l011","ordinal":176094,"en":"He meant to begin the mischief,"},{"id":"semetey-1-2013:p1296:b003:l012","ordinal":176095,"en":"Fighting as he flew;"},{"id":"semetey-1-2013:p1296:b003:l013","ordinal":176096,"en":"May the wretched Kojo never prosper,"},{"id":"semetey-1-2013:p1296:b003:l014","ordinal":176097,"en":"He meant to work a marvel."},{"id":"semetey-1-2013:p1296:b003:l015","ordinal":176098,"en":"Low mist shimmered over the earth,"},{"id":"semetey-1-2013:p1296:b003:l016","ordinal":176099,"en":"And mingling with the low mist,"},{"id":"semetey-1-2013:p1296:b003:l017","ordinal":176100,"en":"Kojo drew near."},{"id":"semetey-1-2013:p1296:b003:l018","ordinal":176101,"en":"Supremely ready for combat,"},{"id":"semetey-1-2013:p1296:b003:l019","ordinal":176102,"en":"From the beginning, in combat,"},{"id":"semetey-1-2013:p1296:b003:l020","ordinal":176103,"en":"He was a plainly proven great master."},{"id":"semetey-1-2013:p1296:b003:l021","ordinal":176104,"en":"Drawing near within the mist,"},{"id":"semetey-1-2013:p1296:b003:l022","ordinal":176105,"en":"He came within half a target's range,"},{"id":"semetey-1-2013:p1296:b003:l023","ordinal":176106,"en":"And saw upon the orphan son of Manas"},{"id":"semetey-1-2013:p1296:b003:l024","ordinal":176107,"en":"The place at which to aim."},{"id":"semetey-1-2013:p1296:b003:l025","ordinal":176108,"en":"Seeing it, he took delight,"},{"id":"semetey-1-2013:p1296:b003:l026","ordinal":176109,"en":"And now began his mischief."},{"id":"semetey-1-2013:p1296:b003:l027","ordinal":176110,"en":"With a gaping steel-tipped arrow,"},{"id":"semetey-1-2013:p1296:b003:l028","ordinal":176111,"en":"At Semetey's head"},{"id":"semetey-1-2013:p1296:b003:l029","ordinal":176112,"en":"Hero Kojo began his assault."},{"id":"semetey-1-2013:p1296:b003:l030","ordinal":176113,"en":"Snatching up his arrows,"},{"id":"semetey-1-2013:p1296:b003:l031","ordinal":176114,"en":"He turned and drew the bow,"},{"id":"semetey-1-2013:p1296:b003:l032","ordinal":176115,"en":"And from where he stood, at Semey,"},{"id":"semetey-1-2013:p1296:b003:l033","ordinal":176116,"en":"He loosed six thousand shots."},{"id":"semetey-1-2013:p1296:b003:l034","ordinal":176117,"en":"With steel-tipped arrows at his shoulder,"},{"id":"semetey-1-2013:p1296:b003:l035","ordinal":176118,"en":"Chynkojo snatched them up,"},{"id":"semetey-1-2013:p1296:b003:l036","ordinal":176119,"en":"And shot a thousand with those."},{"id":"semetey-1-2013:p1296:b003:l037","ordinal":176120,"en":"The fiery Oroybo matchlock,"},{"id":"semetey-1-2013:p1296:b003:l038","ordinal":176121,"en":"Chynkojo snatched it up,"},{"id":"semetey-1-2013:p1296:b003:l039","ordinal":176122,"en":"And fired a hundred with it."},{"id":"semetey-1-2013:p1296:b004:l001","ordinal":176123,"en":"Poor Kojo then"},{"id":"semetey-1-2013:p1296:b004:l002","ordinal":176124,"en":"Drew his bow like pouring rain,"},{"id":"semetey-1-2013:p1296:b004:l003","ordinal":176125,"en":"And fired bullets like hail."},{"id":"semetey-1-2013:p1296:b004:l004","ordinal":176126,"en":"Semetey was hard beset;"},{"id":"semetey-1-2013:p1296:b004:l005","ordinal":176127,"en":"Had his helmet not been iron,"},{"id":"semetey-1-2013:p1296:b004:l006","ordinal":176128,"en":"His fur cap would have been shattered."}]
