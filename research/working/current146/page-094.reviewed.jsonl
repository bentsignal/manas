{"id": "sayakbay-ms-current146:pdf094:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 94, "folio": 477, "line_in_page": 28, "raw": "Чын айткан сөздүн таңы,", "text": "Чын айткан сөздүн таңы,", "en": "The dawn of words spoken truly,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf094:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 94, "folio": 477, "line_in_page": 29, "raw": "Айтылган шердин алгы,", "text": "Айтылган шердин алгы,", "en": "The foremost of the renowned lions,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf094:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 94, "folio": 477, "line_in_page": 30, "raw": "Бар Жел жетпес баргын деп,", "text": "Бар Жел жетпес баргын деп,", "en": "“Go, Zhelzhetpes, go,” he said,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf094:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 94, "folio": 477, "line_in_page": 31, "raw": "Ал бадырак кыргыздан,", "text": "Ал бадырак кыргыздан,", "en": "From those swaggering Kyrgyz,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf094:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 94, "folio": 477, "line_in_page": 32, "raw": "Ар жабдыгы беленден,", "text": "Ар жабдыгы беленден,", "en": "Whose every weapon stands ready,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf094:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 94, "folio": 477, "line_in_page": 33, "raw": "Кыргыздан доочу Кененден,", "text": "Кыргыздан доочу Кененден,", "en": "From Kenen, the champion of the Kyrgyz,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf094:l034", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 94, "folio": 477, "line_in_page": 34, "raw": "Барып кабар алып кел.", "text": "Барып кабар алып кел.", "en": "Go and bring back word.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf094:l035", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 94, "folio": 477, "line_in_page": 35, "raw": "Сапар жүрүп талбай кел,", "text": "Сапар жүрүп талбай кел,", "en": "Travel on your journey and return untired,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf094:l036", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 94, "folio": 477, "line_in_page": 36, "raw": "Күн билиши беш күнгө.", "text": "Күн билиши беш күнгө.", "en": "With five days as the appointed time.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: ambiguous cursive letterforms, archaic vocabulary, or uncertain word division.", "bbox": null}
