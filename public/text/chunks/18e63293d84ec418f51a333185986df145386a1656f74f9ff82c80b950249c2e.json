[{"id":"semetey-1-2013:p0483:b003:l005","ordinal":113665,"en":"May your bustling good fortune open,"},{"id":"semetey-1-2013:p0483:b003:l006","ordinal":113666,"en":"May all your grief scatter."},{"id":"semetey-1-2013:p0483:b003:l007","ordinal":113667,"en":"Black steel, impenetrable to bullets—"},{"id":"semetey-1-2013:p0483:b003:l008","ordinal":113668,"en":"Your father's grave, forty nobles!—"},{"id":"semetey-1-2013:p0483:b003:l009","ordinal":113669,"en":"The time has come to put it on."},{"id":"semetey-1-2013:p0483:b003:l010","ordinal":113670,"en":"Like jackdaws upon the fugitives,"},{"id":"semetey-1-2013:p0483:b003:l011","ordinal":113671,"en":"Companions, the time has come to strike."},{"id":"semetey-1-2013:p0483:b003:l012","ordinal":113672,"en":"Making them shriek, beating them,"},{"id":"semetey-1-2013:p0483:b003:l013","ordinal":113673,"en":"Heroes, the time has come to strike!"},{"id":"semetey-1-2013:p0483:b003:l014","ordinal":113674,"en":"Without fastening a bridle, riding bareback,"},{"id":"semetey-1-2013:p0483:b003:l015","ordinal":113675,"en":"The time has come to ride the fugitives."},{"id":"semetey-1-2013:p0483:b003:l016","ordinal":113676,"en":"Yraman's Yrchuul,"},{"id":"semetey-1-2013:p0483:b003:l017","ordinal":113677,"en":"His tasseled drawstring of forty joints,"},{"id":"semetey-1-2013:p0483:b003:l018","ordinal":113678,"en":"Sing here beside me."},{"id":"semetey-1-2013:p0483:b003:l019","ordinal":113679,"en":"My dark Tölög the diviner,"},{"id":"semetey-1-2013:p0483:b003:l020","ordinal":113680,"en":"Cast your divination; I shall see."},{"id":"semetey-1-2013:p0483:b003:l021","ordinal":113681,"en":"Spear in hand, breaking their ranks,"},{"id":"semetey-1-2013:p0483:b003:l022","ordinal":113682,"en":"Falling to bullets if death is due,"},{"id":"semetey-1-2013:p0483:b003:l023","ordinal":113683,"en":"I shall behold a marvelous slaughter!”"},{"id":"semetey-1-2013:p0483:b003:l024","ordinal":113684,"en":"Yraman's singer"},{"id":"semetey-1-2013:p0483:b003:l025","ordinal":113685,"en":"Began to sing his words;"},{"id":"semetey-1-2013:p0483:b003:l026","ordinal":113686,"en":"Dark Tölög the diviner"},{"id":"semetey-1-2013:p0483:b003:l027","ordinal":113687,"en":"Cast his divination:"},{"id":"semetey-1-2013:p0483:b003:l028","ordinal":113688,"en":"“The departed fugitives have camped;"},{"id":"semetey-1-2013:p0483:b003:l029","ordinal":113689,"en":"Your journey has prospered."},{"id":"semetey-1-2013:p0483:b003:l030","ordinal":113690,"en":"Like springs upon the hills,"},{"id":"semetey-1-2013:p0483:b003:l031","ordinal":113691,"en":"The time has come to join;"},{"id":"semetey-1-2013:p0483:b003:l032","ordinal":113692,"en":"Like flour of white wheat,"},{"id":"semetey-1-2013:p0483:b003:l033","ordinal":113693,"en":"The time has come to mingle as dough;"},{"id":"semetey-1-2013:p0483:b003:l034","ordinal":113694,"en":"Like hair of the white antelope,"},{"id":"semetey-1-2013:p0483:b003:l035","ordinal":113695,"en":"The time has come to be drawn out."},{"id":"semetey-1-2013:p0483:b003:l036","ordinal":113696,"en":"Like Venus in the sky,"},{"id":"semetey-1-2013:p0483:b003:l037","ordinal":113697,"en":"Perhaps the time has come to shine pale;"},{"id":"semetey-1-2013:p0483:b003:l038","ordinal":113698,"en":"The generous lord will rejoin us safely,"},{"id":"semetey-1-2013:p0483:b003:l039","ordinal":113699,"en":"Perhaps the time has come for friendship!”"},{"id":"semetey-1-2013:p0483:b005:l001","ordinal":113700,"en":"Casting his divination, speaking truly,"},{"id":"semetey-1-2013:p0483:b005:l002","ordinal":113701,"en":"“The fugitives below shall not escape;"},{"id":"semetey-1-2013:p0483:b005:l003","ordinal":113702,"en":"My lordly elder, Khan Manas, is coming,” he said."},{"id":"semetey-1-2013:p0483:b005:l005","ordinal":113703,"en":"Before he could close his mouth,"},{"id":"semetey-1-2013:p0483:b005:l006","ordinal":113704,"en":"A shout came from behind:"},{"id":"semetey-1-2013:p0483:b005:l007","ordinal":113705,"en":"Akayar and Kanykei"},{"id":"semetey-1-2013:p0483:b005:l008","ordinal":113706,"en":"Were coming from afar,"},{"id":"semetey-1-2013:p0483:b005:l009","ordinal":113707,"en":"Crying “Manas!” as their battle-cry."},{"id":"semetey-1-2013:p0483:b005:l010","ordinal":113708,"en":"My devastating sister-in-law Kanykei,"},{"id":"semetey-1-2013:p0483:b005:l011","ordinal":113709,"en":"Her great hair, thick as a girth,"},{"id":"semetey-1-2013:p0483:b005:l012","ordinal":113710,"en":"Had wound and tied upon her crown."},{"id":"semetey-1-2013:p0483:b005:l013","ordinal":113711,"en":"Khan Manas's old cap"},{"id":"semetey-1-2013:p0483:b005:l014","ordinal":113712,"en":"She had pulled down upon her head."},{"id":"semetey-1-2013:p0483:b005:l015","ordinal":113713,"en":"The black-cheeked battle-axe"},{"id":"semetey-1-2013:p0483:b005:l016","ordinal":113714,"en":"She had fastened snugly at her wrist."},{"id":"semetey-1-2013:p0483:b005:l017","ordinal":113715,"en":"Arkesken, the black steel sword,"},{"id":"semetey-1-2013:p0483:b005:l018","ordinal":113716,"en":"She had drawn from its sheath."},{"id":"semetey-1-2013:p0483:b005:l019","ordinal":113717,"en":"Her black, white-blazed thoroughbred's"},{"id":"semetey-1-2013:p0483:b005:l020","ordinal":113718,"en":"Belly-girth she had pulled tight,"},{"id":"semetey-1-2013:p0483:b005:l021","ordinal":113719,"en":"Its crupper she had lengthened,"},{"id":"semetey-1-2013:p0483:b005:l022","ordinal":113720,"en":"Lashing right and left,"},{"id":"semetey-1-2013:p0483:b005:l023","ordinal":113721,"en":"Spurring this way and that,"},{"id":"semetey-1-2013:p0483:b005:l024","ordinal":113722,"en":"Making a warrior of her woman's self,"},{"id":"semetey-1-2013:p0483:b005:l025","ordinal":113723,"en":"Making a banner of her towering head,"},{"id":"semetey-1-2013:p0483:b005:l026","ordinal":113724,"en":"Upon the fugitives' tracks"},{"id":"semetey-1-2013:p0483:b005:l027","ordinal":113725,"en":"She had pursued relentlessly,"},{"id":"semetey-1-2013:p0483:b005:l028","ordinal":113726,"en":"Chasing till she turned yellow."},{"id":"semetey-1-2013:p0483:b005:l029","ordinal":113727,"en":"Upon their bare tracks she pressed relentlessly,"},{"id":"semetey-1-2013:p0483:b005:l030","ordinal":113728,"en":"Chasing till she turned pale."},{"id":"semetey-1-2013:p0483:b005:l031","ordinal":113729,"en":"The youngest of six lions,"},{"id":"semetey-1-2013:p0483:b005:l032","ordinal":113730,"en":"Allah's beloved servant,"},{"id":"semetey-1-2013:p0483:b005:l033","ordinal":113731,"en":"She had mounted on Akkula,"},{"id":"semetey-1-2013:p0483:b005:l034","ordinal":113732,"en":"Clothed in the white padded armor."},{"id":"semetey-1-2013:p0483:b005:l035","ordinal":113733,"en":"The great gun Ak-Kelte,"},{"id":"semetey-1-2013:p0483:b005:l036","ordinal":113734,"en":"When the noble one slung it on,"},{"id":"semetey-1-2013:p0483:b005:l037","ordinal":113735,"en":"Was the mirror of his shoulder;"},{"id":"semetey-1-2013:p0483:b005:l038","ordinal":113736,"en":"When turned on an enemy in combat,"},{"id":"semetey-1-2013:p0483:b005:l039","ordinal":113737,"en":"It was the solace of his borrowed life."},{"id":"semetey-1-2013:p0484:b003:l002","ordinal":113738,"en":"If an enemy came out shooting,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0484:b003:l003","ordinal":113739,"en":"It was the companion of his borrowed life."},{"id":"semetey-1-2013:p0484:b003:l004","ordinal":113740,"en":"Fired in play, an ochogor gun;"},{"id":"semetey-1-2013:p0484:b003:l005","ordinal":113741,"en":"In earnest, Chorkelte;"},{"id":"semetey-1-2013:p0484:b003:l006","ordinal":113742,"en":"On inspection, Koychagyr;"},{"id":"semetey-1-2013:p0484:b003:l007","ordinal":113743,"en":"Of surpassing steel, Almabash."},{"id":"semetey-1-2013:p0484:b003:l008","ordinal":113744,"en":"Unfailing for sixty days,"},{"id":"semetey-1-2013:p0484:b003:l009","ordinal":113745,"en":"Making no distinction between far and near,"},{"id":"semetey-1-2013:p0484:b003:l010","ordinal":113746,"en":"The living gun Ak-Kelte"},{"id":"semetey-1-2013:p0484:b003:l011","ordinal":113747,"en":"Hung about Khan Manas's neck."},{"id":"semetey-1-2013:p0484:b003:l012","ordinal":113748,"en":"Flashing as though moonlight struck it,"},{"id":"semetey-1-2013:p0484:b003:l013","ordinal":113749,"en":"Of the six blades fallen from heaven,"},{"id":"semetey-1-2013:p0484:b003:l014","ordinal":113750,"en":"The finest among swords,"},{"id":"semetey-1-2013:p0484:b003:l015","ordinal":113751,"en":"Zulpukor, which Manas had received,"},{"id":"semetey-1-2013:p0484:b003:l016","ordinal":113752,"en":"Gleamed at his wrist."},{"id":"semetey-1-2013:p0484:b003:l017","ordinal":113753,"en":"The painted spear Bölökbai had made"},{"id":"semetey-1-2013:p0484:b003:l018","ordinal":113754,"en":"Shimmered beneath his knee."},{"id":"semetey-1-2013:p0484:b003:l019","ordinal":113755,"en":"The banner seemed a mountain;"},{"id":"semetey-1-2013:p0484:b003:l020","ordinal":113756,"en":"The noble lion, proud as a cock,"},{"id":"semetey-1-2013:p0484:b003:l021","ordinal":113757,"en":"Seemed like Mount Opol."},{"id":"semetey-1-2013:p0484:b003:l022","ordinal":113758,"en":"When Almambet, Chubak and Bakai"},{"id":"semetey-1-2013:p0484:b003:l023","ordinal":113759,"en":"Saw their generous lord before them,"},{"id":"semetey-1-2013:p0484:b003:l024","ordinal":113760,"en":"As though they might never see him again,"},{"id":"semetey-1-2013:p0484:b003:l025","ordinal":113761,"en":"Those heroes who had been grieving"},{"id":"semetey-1-2013:p0484:b003:l026","ordinal":113762,"en":"Poured tears from their eyes."},{"id":"semetey-1-2013:p0484:b003:l027","ordinal":113763,"en":"Their king, Manas the lion,"},{"id":"semetey-1-2013:p0484:b003:l028","ordinal":113764,"en":"Before the mighty men's eyes"},{"id":"semetey-1-2013:p0484:b003:l029","ordinal":113765,"en":"Appeared alive, not dead."},{"id":"semetey-1-2013:p0484:b003:l030","ordinal":113766,"en":"His forty companions cried out,"},{"id":"semetey-1-2013:p0484:b003:l031","ordinal":113767,"en":"As though seeing their father,"},{"id":"semetey-1-2013:p0484:b003:l032","ordinal":113768,"en":"To the One God their wishes"},{"id":"semetey-1-2013:p0484:b003:l033","ordinal":113769,"en":"They offered, sobbing."},{"id":"semetey-1-2013:p0484:b003:l034","ordinal":113770,"en":"Almambet and Bakai, the lions,"},{"id":"semetey-1-2013:p0484:b003:l035","ordinal":113771,"en":"Cried “Baabedin!” and offered prayers,"},{"id":"semetey-1-2013:p0484:b003:l036","ordinal":113772,"en":"Vowed sheep to Koroshon,"},{"id":"semetey-1-2013:p0484:b003:l037","ordinal":113773,"en":"To Allah the Exalted, the One,"},{"id":"semetey-1-2013:p0484:b003:l038","ordinal":113774,"en":"Vowed crescent-hoofed horses,"},{"id":"semetey-1-2013:p0484:b003:l039","ordinal":113775,"en":"Quickly uttering every wish."},{"id":"semetey-1-2013:p0484:b004:l001","ordinal":113776,"en":"“My wolf-lord has come!” they said,"},{"id":"semetey-1-2013:p0484:b004:l002","ordinal":113777,"en":"“God has granted our wish!” they said."},{"id":"semetey-1-2013:p0484:b004:l003","ordinal":113778,"en":"Severed steel was joined again."},{"id":"semetey-1-2013:p0484:b004:l004","ordinal":113779,"en":"When they saw the panther,"},{"id":"semetey-1-2013:p0484:b004:l005","ordinal":113780,"en":"Khan Manas's forty noble companions"},{"id":"semetey-1-2013:p0484:b004:l006","ordinal":113781,"en":"All rejoiced together."},{"id":"semetey-1-2013:p0484:b004:l007","ordinal":113782,"en":"Stars streamed down from the sky;"},{"id":"semetey-1-2013:p0484:b004:l008","ordinal":113783,"en":"With the wolf-man lion, the forty companions"},{"id":"semetey-1-2013:p0484:b004:l009","ordinal":113784,"en":"Were reunited safe and sound."},{"id":"semetey-1-2013:p0484:b004:l010","ordinal":113785,"en":"Bakai the panther, the wolf-man hero,"},{"id":"semetey-1-2013:p0484:b004:l011","ordinal":113786,"en":"Pursued the fugitives' tracks,"},{"id":"semetey-1-2013:p0484:b004:l012","ordinal":113787,"en":"Skirted along the bank,"},{"id":"semetey-1-2013:p0484:b004:l013","ordinal":113788,"en":"Roamed through Jerge-Talaa,"},{"id":"semetey-1-2013:p0484:b004:l014","ordinal":113789,"en":"Crossed Moinokcho,"},{"id":"semetey-1-2013:p0484:b004:l015","ordinal":113790,"en":"Traversed Üch-Aral,"},{"id":"semetey-1-2013:p0484:b004:l016","ordinal":113791,"en":"Üch-Aral at the head of the Ili."},{"id":"semetey-1-2013:p0484:b004:l017","ordinal":113792,"en":"Ögüz-Ashuu and Tai-Ashuu—"},{"id":"semetey-1-2013:p0484:b004:l018","ordinal":113793,"en":"He crossed both in succession."},{"id":"semetey-1-2013:p0484:b004:l019","ordinal":113794,"en":"The two plains, Künes and Jyldyz,"},{"id":"semetey-1-2013:p0484:b004:l020","ordinal":113795,"en":"He traversed both, leaving neither out."},{"id":"semetey-1-2013:p0484:b004:l021","ordinal":113796,"en":"Közkaman had gone and halted"},{"id":"semetey-1-2013:p0484:b004:l022","ordinal":113797,"en":"At the foot of Mount Ambal,"},{"id":"semetey-1-2013:p0484:b004:l023","ordinal":113798,"en":"Rejoicing, “We have escaped!"},{"id":"semetey-1-2013:p0484:b004:l024","ordinal":113799,"en":"We have rid ourselves of every grief!"},{"id":"semetey-1-2013:p0484:b004:l025","ordinal":113800,"en":"That dark wolf-lord whom we sought out,"},{"id":"semetey-1-2013:p0484:b004:l026","ordinal":113801,"en":"By tricking him and serving a meal,"},{"id":"semetey-1-2013:p0484:b004:l027","ordinal":113802,"en":"We have thoroughly slaughtered!”"},{"id":"semetey-1-2013:p0484:b004:l028","ordinal":113803,"en":"To send news to Beijing,"},{"id":"semetey-1-2013:p0484:b004:l029","ordinal":113804,"en":"To the Khakan's khan,"},{"id":"semetey-1-2013:p0484:b004:l030","ordinal":113805,"en":"Before Karykan,"},{"id":"semetey-1-2013:p0484:b004:l031","ordinal":113806,"en":"To go with glad tidings,"},{"id":"semetey-1-2013:p0484:b004:l032","ordinal":113807,"en":"Of the numerous Chinese people of forty tribes"},{"id":"semetey-1-2013:p0484:b004:l033","ordinal":113808,"en":"To receive a khanate—"},{"id":"semetey-1-2013:p0484:b004:l034","ordinal":113809,"en":"The fleeing Kalmyks rejoiced"},{"id":"semetey-1-2013:p0484:b004:l035","ordinal":113810,"en":"And lay at their ease."},{"id":"semetey-1-2013:p0484:b004:l036","ordinal":113811,"en":"To a ridge like a saddle's waist,"},{"id":"semetey-1-2013:p0484:b004:l037","ordinal":113812,"en":"Bakai the panther, tracking them,"},{"id":"semetey-1-2013:p0484:b004:l038","ordinal":113813,"en":"Bent low and went in to look."},{"id":"semetey-1-2013:p0484:b004:l039","ordinal":113814,"en":"Gray-mottled haze, red banners,"},{"id":"semetey-1-2013:p0485:b003:l002","ordinal":113815,"en":"Such, it seemed, was the Chinese clamor.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0485:b003:l003","ordinal":113816,"en":"They had beaten their drums,"},{"id":"semetey-1-2013:p0485:b003:l004","ordinal":113817,"en":"Calling it “the game of slaughtering Manas.”"},{"id":"semetey-1-2013:p0485:b003:l005","ordinal":113818,"en":"Their Kalmyks swayed"},{"id":"semetey-1-2013:p0485:b003:l006","ordinal":113819,"en":"And danced with all their might."},{"id":"semetey-1-2013:p0485:b003:l007","ordinal":113820,"en":"Khan Bakai's entry"},{"id":"semetey-1-2013:p0485:b003:l008","ordinal":113821,"en":"Jeldeiboz, standing watch,"},{"id":"semetey-1-2013:p0485:b003:l009","ordinal":113822,"en":"Had clearly seen."},{"id":"semetey-1-2013:p0485:b003:l010","ordinal":113823,"en":"The steed beneath him"},{"id":"semetey-1-2013:p0485:b003:l011","ordinal":113824,"en":"He lashed, shouting,"},{"id":"semetey-1-2013:p0485:b003:l012","ordinal":113825,"en":"To Közkaman and Kökchököz"},{"id":"semetey-1-2013:p0485:b003:l013","ordinal":113826,"en":"Crying out his battle-cry."},{"id":"semetey-1-2013:p0485:b003:l014","ordinal":113827,"en":"“Kökchököz and Közkaman!"},{"id":"semetey-1-2013:p0485:b003:l015","ordinal":113828,"en":"The striking idol has struck us!"},{"id":"semetey-1-2013:p0485:b003:l016","ordinal":113829,"en":"Reckless Manas and forty mighty men"},{"id":"semetey-1-2013:p0485:b003:l017","ordinal":113830,"en":"Are pursuing at your heels."},{"id":"semetey-1-2013:p0485:b003:l018","ordinal":113831,"en":"Almambet has gone on patrol;"},{"id":"semetey-1-2013:p0485:b003:l019","ordinal":113832,"en":"Bakai, hero of the saints—"},{"id":"semetey-1-2013:p0485:b003:l020","ordinal":113833,"en":"Think of it: a dreadful, grievous affair!—"},{"id":"semetey-1-2013:p0485:b003:l021","ordinal":113834,"en":"Has pressed relentlessly upon your tracks,"},{"id":"semetey-1-2013:p0485:b003:l022","ordinal":113835,"en":"Chasing till he turns yellow."},{"id":"semetey-1-2013:p0485:b003:l023","ordinal":113836,"en":"To pursue you to the Khakan"},{"id":"semetey-1-2013:p0485:b003:l024","ordinal":113837,"en":"And wreak havoc,"},{"id":"semetey-1-2013:p0485:b003:l025","ordinal":113838,"en":"All forty mighty men"},{"id":"semetey-1-2013:p0485:b003:l026","ordinal":113839,"en":"Have pledged their word."},{"id":"semetey-1-2013:p0485:b003:l027","ordinal":113840,"en":"Their Manas was a consummate khan;"},{"id":"semetey-1-2013:p0485:b003:l028","ordinal":113841,"en":"The least of his companions"},{"id":"semetey-1-2013:p0485:b003:l029","ordinal":113842,"en":"Was worth a thousand men."},{"id":"semetey-1-2013:p0485:b003:l030","ordinal":113843,"en":"The pit dug for us has come,"},{"id":"semetey-1-2013:p0485:b003:l031","ordinal":113844,"en":"Disaster for our precious lives has come."},{"id":"semetey-1-2013:p0485:b003:l032","ordinal":113845,"en":"However much I spoke, you would not listen;"},{"id":"semetey-1-2013:p0485:b003:l033","ordinal":113846,"en":"My khans, has God struck you?"},{"id":"semetey-1-2013:p0485:b003:l034","ordinal":113847,"en":"Pursuing as far as the Khakan—"},{"id":"semetey-1-2013:p0485:b003:l035","ordinal":113848,"en":"Has God struck the Buruts?"},{"id":"semetey-1-2013:p0485:b003:l036","ordinal":113849,"en":"Traveling day and night,"},{"id":"semetey-1-2013:p0485:b003:l037","ordinal":113850,"en":"You refuse when I say, ‘Let us flee.’"},{"id":"semetey-1-2013:p0485:b003:l038","ordinal":113851,"en":"The time to be lashed has come."},{"id":"semetey-1-2013:p0485:b003:l039","ordinal":113852,"en":"Ah, Közkaman, you will come to no good!"},{"id":"semetey-1-2013:p0485:b004:l001","ordinal":113853,"en":"Every companion came running;"},{"id":"semetey-1-2013:p0485:b004:l002","ordinal":113854,"en":"Khan Manas, whom they called dead,"},{"id":"semetey-1-2013:p0485:b004:l003","ordinal":113855,"en":"Has risen today, as you can see."},{"id":"semetey-1-2013:p0485:b004:l004","ordinal":113856,"en":"You indulge in other deeds:"},{"id":"semetey-1-2013:p0485:b004:l005","ordinal":113857,"en":"You take Kyrgyz girls as booty"},{"id":"semetey-1-2013:p0485:b004:l006","ordinal":113858,"en":"And make them your wives."},{"id":"semetey-1-2013:p0485:b004:l007","ordinal":113859,"en":"‘The destroyer Manas is dead,’ you say."},{"id":"semetey-1-2013:p0485:b004:l009","ordinal":113860,"en":"I have seen Manas's mighty men.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0485:b004:l010","ordinal":113861,"en":"Damned Közkaman,"},{"id":"semetey-1-2013:p0485:b004:l011","ordinal":113862,"en":"How will you find a way out?"},{"id":"semetey-1-2013:p0485:b004:l012","ordinal":113863,"en":"Great Beijing, the distant city—"},{"id":"semetey-1-2013:p0485:b004:l013","ordinal":113864,"en":"Before you reach that place, Közkaman,"},{"id":"semetey-1-2013:p0485:b004:l014","ordinal":113865,"en":"It seems you will be dead."},{"id":"semetey-1-2013:p0485:b004:l015","ordinal":113866,"en":"When bored, you shoot roe deer;"},{"id":"semetey-1-2013:p0485:b004:l016","ordinal":113867,"en":"When not bored, you wretch,"},{"id":"semetey-1-2013:p0485:b004:l017","ordinal":113868,"en":"You lie playing with girls."},{"id":"semetey-1-2013:p0485:b004:l018","ordinal":113869,"en":"Manas the lion, blessed by Khidr, has come;"},{"id":"semetey-1-2013:p0485:b004:l019","ordinal":113870,"en":"Today you will suffer pressure."},{"id":"semetey-1-2013:p0485:b004:l020","ordinal":113871,"en":"When I say, ‘Send word to the watch,’"},{"id":"semetey-1-2013:p0485:b004:l021","ordinal":113872,"en":"When I say, ‘Send word to the Khakan,’"},{"id":"semetey-1-2013:p0485:b004:l022","ordinal":113873,"en":"‘Those who let no opponent go,"},{"id":"semetey-1-2013:p0485:b004:l023","ordinal":113874,"en":"Recruit some of those warriors,’ I say—"},{"id":"semetey-1-2013:p0485:b004:l024","ordinal":113875,"en":"You will not comply, my scoundrel."},{"id":"semetey-1-2013:p0485:b004:l025","ordinal":113876,"en":"You have had us all slaughtered."},{"id":"semetey-1-2013:p0485:b004:l026","ordinal":113877,"en":"Ah, Kökchököz, you will come to no good!"},{"id":"semetey-1-2013:p0485:b004:l027","ordinal":113878,"en":"The deep-dug pit has come;"},{"id":"semetey-1-2013:p0485:b004:l028","ordinal":113879,"en":"Equal to his Manas,"},{"id":"semetey-1-2013:p0485:b004:l029","ordinal":113880,"en":"Look, mighty Bakai has come."},{"id":"semetey-1-2013:p0485:b004:l030","ordinal":113881,"en":"When bored, you shoot wild asses."},{"id":"semetey-1-2013:p0485:b004:l031","ordinal":113882,"en":"You fool come from Beijing,"},{"id":"semetey-1-2013:p0485:b004:l032","ordinal":113883,"en":"Never considering that they have champions,"},{"id":"semetey-1-2013:p0485:b004:l033","ordinal":113884,"en":"You lie playing all the harder!"},{"id":"semetey-1-2013:p0485:b004:l034","ordinal":113885,"en":"Ah, Kökchököz and Közkaman,"},{"id":"semetey-1-2013:p0485:b004:l035","ordinal":113886,"en":"Take your game instead of a captive girl;"},{"id":"semetey-1-2013:p0485:b004:l036","ordinal":113887,"en":"Take your mother instead of a clever girl!"},{"id":"semetey-1-2013:p0485:b004:l038","ordinal":113888,"en":"Have you seen what I have seen,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0485:b004:l039","ordinal":113889,"en":"You great dog lying there in a frenzy?"},{"id":"semetey-1-2013:p0486:b003:l001","ordinal":113890,"en":"Have you learned what I know?"},{"id":"semetey-1-2013:p0486:b003:l002","ordinal":113891,"en":"From the jutting mountain spur,"},{"id":"semetey-1-2013:p0486:b003:l003","ordinal":113892,"en":"From the overhanging promontory,"},{"id":"semetey-1-2013:p0486:b003:l004","ordinal":113893,"en":"From a cleft like a forked saddle,"},{"id":"semetey-1-2013:p0486:b003:l005","ordinal":113894,"en":"Dust billows and billows out."},{"id":"semetey-1-2013:p0486:b003:l006","ordinal":113895,"en":"I watched the billowing dust:"},{"id":"semetey-1-2013:p0486:b003:l007","ordinal":113896,"en":"It was the dust of the gray winged steed."},{"id":"semetey-1-2013:p0486:b003:l008","ordinal":113897,"en":"The rider mounted upon it"},{"id":"semetey-1-2013:p0486:b003:l009","ordinal":113898,"en":"Was a man like Bakai."},{"id":"semetey-1-2013:p0486:b003:l010","ordinal":113899,"en":"A wrathful bellow—"},{"id":"semetey-1-2013:p0486:b003:l011","ordinal":113900,"en":"When I lent an ear a little,"},{"id":"semetey-1-2013:p0486:b003:l012","ordinal":113901,"en":"He was shouting the battle cry, ‘Manas!’"},{"id":"semetey-1-2013:p0486:b003:l013","ordinal":113902,"en":"When I looked behind him—"},{"id":"semetey-1-2013:p0486:b003:l014","ordinal":113903,"en":"As huge as half a mountain,"},{"id":"semetey-1-2013:p0486:b003:l015","ordinal":113904,"en":"As though he would devour whoever he met."},{"id":"semetey-1-2013:p0486:b003:l016","ordinal":113905,"en":"Yesterday, he made his golden throne greasy;"},{"id":"semetey-1-2013:p0486:b003:l017","ordinal":113906,"en":"Saying, ‘He will not enter Islam,’"},{"id":"semetey-1-2013:p0486:b003:l018","ordinal":113907,"en":"He slew his own father."},{"id":"semetey-1-2013:p0486:b003:l019","ordinal":113908,"en":"They held back only from dying,"},{"id":"semetey-1-2013:p0486:b003:l020","ordinal":113909,"en":"Until the supple reeds ripened,"},{"id":"semetey-1-2013:p0486:b003:l021","ordinal":113910,"en":"Until the autumn gossamer flew,"},{"id":"semetey-1-2013:p0486:b003:l022","ordinal":113911,"en":"Fighting hard for six months,"},{"id":"semetey-1-2013:p0486:b003:l023","ordinal":113912,"en":"He brought devastation to Beijing."},{"id":"semetey-1-2013:p0486:b003:l024","ordinal":113913,"en":"The gleaming golden throne"},{"id":"semetey-1-2013:p0486:b003:l025","ordinal":113914,"en":"He repudiated and abandoned."},{"id":"semetey-1-2013:p0486:b003:l026","ordinal":113915,"en":"Upon this very Beijing"},{"id":"semetey-1-2013:p0486:b003:l027","ordinal":113916,"en":"He brought great torment."},{"id":"semetey-1-2013:p0486:b003:l028","ordinal":113917,"en":"Without saddling Sarala,"},{"id":"semetey-1-2013:p0486:b003:l029","ordinal":113918,"en":"The great house-sized idol"},{"id":"semetey-1-2013:p0486:b003:l030","ordinal":113919,"en":"He rejected, refusing to bow."},{"id":"semetey-1-2013:p0486:b003:l031","ordinal":113920,"en":"He raised Sarala into a steed."}]
