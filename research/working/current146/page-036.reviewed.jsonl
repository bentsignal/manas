{"id": "sayakbay-ms-current146:pdf036:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 36, "folio": 419, "line_in_page": 31, "raw": "Бөтөн журтка чак болуп,", "text": "Бөтөн журтка чак болуп,", "en": "He became a match for foreign peoples,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The postposition is provisionally read -ка and чак as “a match.”", "bbox": null}
