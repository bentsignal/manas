[{"id":"semetey-1-2013:p0609:b003:l002","ordinal":123137,"en":"The saint knew them clearly."},{"id":"semetey-1-2013:p0609:b003:l003","ordinal":123138,"en":"The falcon among mankind,"},{"id":"semetey-1-2013:p0609:b003:l004","ordinal":123139,"en":"The very son of saintly wisdom,"},{"id":"semetey-1-2013:p0609:b003:l006","ordinal":123140,"en":"Dear Bakai the Leopard,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0609:b003:l007","ordinal":123141,"en":"Speaking many, many words,"},{"id":"semetey-1-2013:p0609:b003:l008","ordinal":123142,"en":"Led Semetey with him"},{"id":"semetey-1-2013:p0609:b003:l009","ordinal":123143,"en":"To his companion, fierce-maned Manas."},{"id":"semetey-1-2013:p0609:b003:l010","ordinal":123144,"en":"Explaining when to recite the Qur'an,"},{"id":"semetey-1-2013:p0609:b003:l011","ordinal":123145,"en":"Teaching him what he did not know,"},{"id":"semetey-1-2013:p0609:b003:l012","ordinal":123146,"en":"Leading along the road his mother had walked,"},{"id":"semetey-1-2013:p0609:b003:l013","ordinal":123147,"en":"Guiding him in her footsteps,"},{"id":"semetey-1-2013:p0609:b003:l014","ordinal":123148,"en":"To Echkiliktin's dark cliff,"},{"id":"semetey-1-2013:p0609:b003:l015","ordinal":123149,"en":"The great mountain standing still—"},{"id":"semetey-1-2013:p0609:b003:l016","ordinal":123150,"en":"When they drew near the grave,"},{"id":"semetey-1-2013:p0609:b003:l017","ordinal":123151,"en":"Magnanimous Bakai wailed."},{"id":"semetey-1-2013:p0609:b003:l018","ordinal":123152,"en":"“Khan Manas!” he cried aloud."},{"id":"semetey-1-2013:p0609:b003:l019","ordinal":123153,"en":"Sobbing, Bakai, the warrior sultan,"},{"id":"semetey-1-2013:p0609:b003:l020","ordinal":123154,"en":"Raised his voice in lamentation."},{"id":"semetey-1-2013:p0609:b003:l021","ordinal":123155,"en":"His white beard thinning,"},{"id":"semetey-1-2013:p0609:b003:l022","ordinal":123156,"en":"The bloody tears from his eyes"},{"id":"semetey-1-2013:p0609:b003:l023","ordinal":123157,"en":"Poured down over his collarbone."},{"id":"semetey-1-2013:p0609:b003:l024","ordinal":123158,"en":"When his fatherly Bakai did this,"},{"id":"semetey-1-2013:p0609:b003:l025","ordinal":123159,"en":"May I be sacrificed to God!"},{"id":"semetey-1-2013:p0609:b003:l026","ordinal":123160,"en":"Could the grieving boy remain still?"},{"id":"semetey-1-2013:p0609:b003:l027","ordinal":123161,"en":"He cried aloud, “Father!”"},{"id":"semetey-1-2013:p0609:b003:l028","ordinal":123162,"en":"Did you see his childishness?"},{"id":"semetey-1-2013:p0609:b003:l029","ordinal":123163,"en":"To his kingly father Manas"},{"id":"semetey-1-2013:p0609:b003:l030","ordinal":123164,"en":"He called, “Rise up!”"},{"id":"semetey-1-2013:p0609:b003:l031","ordinal":123165,"en":"Semetey acted like a child,"},{"id":"semetey-1-2013:p0609:b003:l032","ordinal":123166,"en":"Crying aloud, “Father!”"},{"id":"semetey-1-2013:p0609:b003:l033","ordinal":123167,"en":"The golden-bladed battle-ax"},{"id":"semetey-1-2013:p0609:b003:l034","ordinal":123168,"en":"He braced against his right side."},{"id":"semetey-1-2013:p0609:b003:l035","ordinal":123169,"en":"“My formidable father!” he wept."},{"id":"semetey-1-2013:p0609:b003:l036","ordinal":123170,"en":"The white whip with black cheeks"},{"id":"semetey-1-2013:p0609:b003:l037","ordinal":123171,"en":"He braced against his left side."},{"id":"semetey-1-2013:p0609:b003:l038","ordinal":123172,"en":"“My protector, my father!” he wept."},{"id":"semetey-1-2013:p0609:b003:l039","ordinal":123173,"en":"Old Bakai the Leopard,"},{"id":"semetey-1-2013:p0609:b005:l001","ordinal":123174,"en":"When he checked his grief,"},{"id":"semetey-1-2013:p0609:b005:l002","ordinal":123175,"en":"When he dried his tears—"},{"id":"semetey-1-2013:p0609:b005:l003","ordinal":123176,"en":"That grave of Manas"},{"id":"semetey-1-2013:p0609:b005:l004","ordinal":123177,"en":"No soul but Bakai knew."},{"id":"semetey-1-2013:p0609:b005:l005","ordinal":123178,"en":"They stood weeping at the grave,"},{"id":"semetey-1-2013:p0609:b005:l006","ordinal":123179,"en":"Then took courage again."},{"id":"semetey-1-2013:p0609:b005:l007","ordinal":123180,"en":"They rested and gathered their wits,"},{"id":"semetey-1-2013:p0609:b005:l008","ordinal":123181,"en":"Toward Manas, gone to Judgment Day,"},{"id":"semetey-1-2013:p0609:b005:l009","ordinal":123182,"en":"And the wife who had buried him through hardship,"},{"id":"semetey-1-2013:p0609:b005:l010","ordinal":123183,"en":"Standing filled with gratitude."},{"id":"semetey-1-2013:p0609:b005:l011","ordinal":123184,"en":"When they looked to the north,"},{"id":"semetey-1-2013:p0609:b005:l012","ordinal":123185,"en":"Over a saddle-shaped pass"},{"id":"semetey-1-2013:p0609:b005:l013","ordinal":123186,"en":"Something was coming into view:"},{"id":"semetey-1-2013:p0609:b005:l014","ordinal":123187,"en":"Bozbuura, the ancestor of camels,"},{"id":"semetey-1-2013:p0609:b005:l015","ordinal":123188,"en":"Toward that grave"},{"id":"semetey-1-2013:p0609:b005:l016","ordinal":123189,"en":"Came running forth."},{"id":"semetey-1-2013:p0609:b005:l017","ordinal":123190,"en":"When he came near the grave,"},{"id":"semetey-1-2013:p0609:b005:l019","ordinal":123191,"en":"With his head toward the north,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0609:b005:l020","ordinal":123192,"en":"His long wool parting,"},{"id":"semetey-1-2013:p0609:b005:l021","ordinal":123193,"en":"Seeing the orphan Semetey,"},{"id":"semetey-1-2013:p0609:b005:l022","ordinal":123194,"en":"Bozbuura knelt down."},{"id":"semetey-1-2013:p0609:b005:l023","ordinal":123195,"en":"His voice differed from other beasts'."},{"id":"semetey-1-2013:p0609:b005:l025","ordinal":123196,"en":"He seemed to wish to be sacrificed.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0609:b005:l026","ordinal":123197,"en":"At “Kneel, kneel!” he knelt,"},{"id":"semetey-1-2013:p0609:b005:l027","ordinal":123198,"en":"And Bozbuura would not rise."},{"id":"semetey-1-2013:p0609:b005:l028","ordinal":123199,"en":"Lowering his chin to the ground,"},{"id":"semetey-1-2013:p0609:b005:l029","ordinal":123200,"en":"Bozbuura held himself still."},{"id":"semetey-1-2013:p0609:b005:l030","ordinal":123201,"en":"Without stirring from his place,"},{"id":"semetey-1-2013:p0609:b005:l031","ordinal":123202,"en":"Bozbuura lay down."},{"id":"semetey-1-2013:p0609:b005:l032","ordinal":123203,"en":"Bakai the Leopard and Semetey"},{"id":"semetey-1-2013:p0609:b005:l033","ordinal":123204,"en":"Dipped their hands into the water,"},{"id":"semetey-1-2013:p0609:b005:l034","ordinal":123205,"en":"Performed the ablution of their hands,"},{"id":"semetey-1-2013:p0609:b005:l035","ordinal":123206,"en":"Dipped their feet into the water,"},{"id":"semetey-1-2013:p0609:b005:l036","ordinal":123207,"en":"Performed the ablution of their feet."},{"id":"semetey-1-2013:p0609:b005:l037","ordinal":123208,"en":"Dear Bakai the Leopard"},{"id":"semetey-1-2013:p0609:b005:l038","ordinal":123209,"en":"For his companion, Lord Manas,"},{"id":"semetey-1-2013:p0609:b005:l039","ordinal":123210,"en":"Began to recite the Qur'an."},{"id":"semetey-1-2013:p0610:b003:l001","ordinal":123211,"en":"“Amen!” he said, spreading his hands."},{"id":"semetey-1-2013:p0610:b003:l002","ordinal":123212,"en":"The extraordinary boy Semetey"},{"id":"semetey-1-2013:p0610:b003:l003","ordinal":123213,"en":"Drew his bright, short-necked scimitar"},{"id":"semetey-1-2013:p0610:b003:l004","ordinal":123214,"en":"From its sheath and took it in his hand."},{"id":"semetey-1-2013:p0610:b003:l005","ordinal":123215,"en":"“Bozbuura, ancestor of camels,"},{"id":"semetey-1-2013:p0610:b003:l006","ordinal":123216,"en":"If you wish to journey, there is Mecca."},{"id":"semetey-1-2013:p0610:b003:l007","ordinal":123217,"en":"You have made ready and knelt down."},{"id":"semetey-1-2013:p0610:b003:l008","ordinal":123218,"en":"Dear creature, go and reach my khan father."},{"id":"semetey-1-2013:p0610:b003:l009","ordinal":123219,"en":"May I be sacrificed to You, O God!"},{"id":"semetey-1-2013:p0610:b003:l010","ordinal":123220,"en":"May hellfire stay far away."},{"id":"semetey-1-2013:p0610:b003:l011","ordinal":123221,"en":"Be a Buraq for my leopard khan father!"},{"id":"semetey-1-2013:p0610:b003:l012","ordinal":123222,"en":"Your soul to Almighty Allah,"},{"id":"semetey-1-2013:p0610:b003:l013","ordinal":123223,"en":"The merit to my father Manas.”"},{"id":"semetey-1-2013:p0610:b003:l014","ordinal":123224,"en":"So saying, Semetey"},{"id":"semetey-1-2013:p0610:b003:l015","ordinal":123225,"en":"Sacrificed Bozbuura."},{"id":"semetey-1-2013:p0610:b003:l016","ordinal":123226,"en":"Without waiting to be told, “Strike!”"},{"id":"semetey-1-2013:p0610:b003:l017","ordinal":123227,"en":"He cut off the camel's head."},{"id":"semetey-1-2013:p0610:b003:l018","ordinal":123228,"en":"Bakai began speaking again,"},{"id":"semetey-1-2013:p0610:b003:l019","ordinal":123229,"en":"Speaking softly, laying his words down firmly."},{"id":"semetey-1-2013:p0610:b003:l020","ordinal":123230,"en":"Every word was like gold;"},{"id":"semetey-1-2013:p0610:b003:l021","ordinal":123231,"en":"His wisdom pierced the soul."},{"id":"semetey-1-2013:p0610:b003:l022","ordinal":123232,"en":"Stars had streamed from the heavens"},{"id":"semetey-1-2013:p0610:b003:l023","ordinal":123233,"en":"When the Magnanimous One came from Altai."},{"id":"semetey-1-2013:p0610:b003:l024","ordinal":123234,"en":"They became friends for the next world."},{"id":"semetey-1-2013:p0610:b003:l025","ordinal":123235,"en":"When he reached twelve years of age,"},{"id":"semetey-1-2013:p0610:b003:l026","ordinal":123236,"en":"When Bakai first saw him,"},{"id":"semetey-1-2013:p0610:b003:l027","ordinal":123237,"en":"Stars stirred in the heavens."},{"id":"semetey-1-2013:p0610:b003:l028","ordinal":123238,"en":"Twelve times they had become friends."},{"id":"semetey-1-2013:p0610:b003:l030","ordinal":123239,"en":"When he reached twelve years of age,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0610:b003:l031","ordinal":123240,"en":"If Semetey came to his father"},{"id":"semetey-1-2013:p0610:b003:l032","ordinal":123241,"en":"To recite the Qur'an,"},{"id":"semetey-1-2013:p0610:b003:l033","ordinal":123242,"en":"For his son to enter once,"},{"id":"semetey-1-2013:p0610:b003:l034","ordinal":123243,"en":"She had left it as a trust."},{"id":"semetey-1-2013:p0610:b003:l035","ordinal":123244,"en":"Then Bakai said:"},{"id":"semetey-1-2013:p0610:b003:l036","ordinal":123245,"en":"“Now, orphan, listen."},{"id":"semetey-1-2013:p0610:b003:l037","ordinal":123246,"en":"Bakai has words to tell you."},{"id":"semetey-1-2013:p0610:b003:l038","ordinal":123247,"en":"‘Let the son see his father,’ she said."},{"id":"semetey-1-2013:p0610:b003:l039","ordinal":123248,"en":"She left that charge in trust."},{"id":"semetey-1-2013:p0610:b004:l001","ordinal":123249,"en":"Enter this cave, my child."},{"id":"semetey-1-2013:p0610:b004:l002","ordinal":123250,"en":"Your leopard father, your lion—"},{"id":"semetey-1-2013:p0610:b004:l003","ordinal":123251,"en":"See every limb of him, my child."},{"id":"semetey-1-2013:p0610:b004:l004","ordinal":123252,"en":"The sorrows in your heart,"},{"id":"semetey-1-2013:p0610:b004:l005","ordinal":123253,"en":"Scatter every one of them, my child."},{"id":"semetey-1-2013:p0610:b004:l006","ordinal":123254,"en":"It is the trust your mother left."},{"id":"semetey-1-2013:p0610:b004:l007","ordinal":123255,"en":"Open this cave, my child."},{"id":"semetey-1-2013:p0610:b004:l008","ordinal":123256,"en":"The entrance opened in the cave"},{"id":"semetey-1-2013:p0610:b004:l009","ordinal":123257,"en":"She had fitted carefully together,"},{"id":"semetey-1-2013:p0610:b004:l010","ordinal":123258,"en":"And left it as a trust."},{"id":"semetey-1-2013:p0610:b004:l011","ordinal":123259,"en":"Overturn the stone at its mouth;"},{"id":"semetey-1-2013:p0610:b004:l012","ordinal":123260,"en":"Tip it back this way.”"},{"id":"semetey-1-2013:p0610:b004:l013","ordinal":123261,"en":"When Bakai said this,"},{"id":"semetey-1-2013:p0610:b004:l014","ordinal":123262,"en":"The boy could not pull it; he struggled."},{"id":"semetey-1-2013:p0610:b004:l015","ordinal":123263,"en":"His strength failed; he swayed."},{"id":"semetey-1-2013:p0610:b004:l016","ordinal":123264,"en":"When the boy was doing this,"},{"id":"semetey-1-2013:p0610:b004:l017","ordinal":123265,"en":"Khan Bakai grew angry."},{"id":"semetey-1-2013:p0610:b004:l018","ordinal":123266,"en":"“When we were drunk on play like you,"},{"id":"semetey-1-2013:p0610:b004:l019","ordinal":123267,"en":"When we were young and played,"},{"id":"semetey-1-2013:p0610:b004:l020","ordinal":123268,"en":"Barefoot and bareheaded,"},{"id":"semetey-1-2013:p0610:b004:l021","ordinal":123269,"en":"The earth would tremble in those days."},{"id":"semetey-1-2013:p0610:b004:l022","ordinal":123270,"en":"That precious time has passed."},{"id":"semetey-1-2013:p0610:b004:l023","ordinal":123271,"en":"Children nowadays—"},{"id":"semetey-1-2013:p0610:b004:l025","ordinal":123272,"en":"In the old days, in my childhood,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0610:b004:l026","ordinal":123273,"en":"We used to play our games,"},{"id":"semetey-1-2013:p0610:b004:l027","ordinal":123274,"en":"Used to test our strength."},{"id":"semetey-1-2013:p0610:b004:l028","ordinal":123275,"en":"The firmly rooted birches,"},{"id":"semetey-1-2013:p0610:b004:l029","ordinal":123276,"en":"By their very roots, dear boy,"},{"id":"semetey-1-2013:p0610:b004:l030","ordinal":123277,"en":"We used to pull them out.”"},{"id":"semetey-1-2013:p0610:b004:l031","ordinal":123278,"en":"So saying, mighty Bakai"},{"id":"semetey-1-2013:p0610:b004:l032","ordinal":123279,"en":"The dark rock as large as a small tent"},{"id":"semetey-1-2013:p0610:b004:l033","ordinal":123280,"en":"Wrenched away from the entrance."},{"id":"semetey-1-2013:p0610:b004:l034","ordinal":123281,"en":"“I have no right to enter."},{"id":"semetey-1-2013:p0610:b004:l035","ordinal":123282,"en":"Orphan child, go in."},{"id":"semetey-1-2013:p0610:b004:l036","ordinal":123283,"en":"How Khan Manas lies,"},{"id":"semetey-1-2013:p0610:b004:l037","ordinal":123284,"en":"My orphan, my support, go and see.”"},{"id":"semetey-1-2013:p0610:b004:l038","ordinal":123285,"en":"He sent the boy inside."},{"id":"semetey-1-2013:p0610:b004:l039","ordinal":123286,"en":"The orphan left by Manas"},{"id":"semetey-1-2013:p0611:b003:l001","ordinal":123287,"en":"Wailing as he recited the profession of faith,"},{"id":"semetey-1-2013:p0611:b003:l002","ordinal":123288,"en":"The orphan came and entered."},{"id":"semetey-1-2013:p0611:b003:l003","ordinal":123289,"en":"The fierce-maned mighty conqueror's"},{"id":"semetey-1-2013:p0611:b003:l004","ordinal":123290,"en":"Resting place he now beheld."},{"id":"semetey-1-2013:p0611:b003:l005","ordinal":123291,"en":"The boy stood still, gazing,"},{"id":"semetey-1-2013:p0611:b003:l006","ordinal":123292,"en":"At the inside of that cave"},{"id":"semetey-1-2013:p0611:b003:l007","ordinal":123293,"en":"The orphan boy marveled."},{"id":"semetey-1-2013:p0611:b003:l008","ordinal":123294,"en":"A feat beyond human strength had been performed;"},{"id":"semetey-1-2013:p0611:b003:l009","ordinal":123295,"en":"All its furnishings had been completed."},{"id":"semetey-1-2013:p0611:b003:l010","ordinal":123296,"en":"As he looked, it came into view."},{"id":"semetey-1-2013:p0611:b003:l011","ordinal":123297,"en":"The orphan gazing upon it"},{"id":"semetey-1-2013:p0611:b003:l012","ordinal":123298,"en":"Felt his heart sorely troubled."},{"id":"semetey-1-2013:p0611:b003:l013","ordinal":123299,"en":"The interior was bright and clear,"},{"id":"semetey-1-2013:p0611:b003:l014","ordinal":123300,"en":"Seemed to be lit by the moon."},{"id":"semetey-1-2013:p0611:b003:l015","ordinal":123301,"en":"My poor mother Kanykei"},{"id":"semetey-1-2013:p0611:b003:l016","ordinal":123302,"en":"My khan father's treasury"},{"id":"semetey-1-2013:p0611:b003:l017","ordinal":123303,"en":"Had spent and scattered."},{"id":"semetey-1-2013:p0611:b003:l018","ordinal":123304,"en":"Within that cave"},{"id":"semetey-1-2013:p0611:b003:l019","ordinal":123305,"en":"My valiant mother Kanykei"},{"id":"semetey-1-2013:p0611:b003:l020","ordinal":123306,"en":"Had revealed the likeness of paradise."},{"id":"semetey-1-2013:p0611:b003:l021","ordinal":123307,"en":"She had precious ruby stones cut,"},{"id":"semetey-1-2013:p0611:b003:l022","ordinal":123308,"en":"In the cave's four corners"},{"id":"semetey-1-2013:p0611:b003:l023","ordinal":123309,"en":"Had them set, as large as reclining camels."},{"id":"semetey-1-2013:p0611:b003:l024","ordinal":123310,"en":"She had it encrusted with precious jewels,"},{"id":"semetey-1-2013:p0611:b003:l025","ordinal":123311,"en":"In sections as large as sheep's heads,"},{"id":"semetey-1-2013:p0611:b003:l026","ordinal":123312,"en":"And had them embedded in the ceiling."},{"id":"semetey-1-2013:p0611:b003:l027","ordinal":123313,"en":"The sight stirred the heart."},{"id":"semetey-1-2013:p0611:b003:l028","ordinal":123314,"en":"Bright as daylight,"},{"id":"semetey-1-2013:p0611:b003:l029","ordinal":123315,"en":"The interior appeared clear."},{"id":"semetey-1-2013:p0611:b003:l030","ordinal":123316,"en":"Lest the cave collapse—"},{"id":"semetey-1-2013:p0611:b003:l031","ordinal":123317,"en":"A sight that would dishearten one—"},{"id":"semetey-1-2013:p0611:b003:l032","ordinal":123318,"en":"Four posts in its four corners"},{"id":"semetey-1-2013:p0611:b003:l033","ordinal":123319,"en":"She had shaped from solid gold,"},{"id":"semetey-1-2013:p0611:b003:l034","ordinal":123320,"en":"And had them installed as pillars."},{"id":"semetey-1-2013:p0611:b003:l035","ordinal":123321,"en":"Lest the inside grow foul,"},{"id":"semetey-1-2013:p0611:b003:l036","ordinal":123322,"en":"She displayed her resourcefulness."},{"id":"semetey-1-2013:p0611:b003:l037","ordinal":123323,"en":"Having a channel broken with iron crowbars,"},{"id":"semetey-1-2013:p0611:b003:l038","ordinal":123324,"en":"The flowing spring water"},{"id":"semetey-1-2013:p0611:b003:l039","ordinal":123325,"en":"Through that very cave"},{"id":"semetey-1-2013:p0611:b005:l001","ordinal":123326,"en":"She had made to run."},{"id":"semetey-1-2013:p0611:b005:l002","ordinal":123327,"en":"Satisfying the eye that beheld it,"},{"id":"semetey-1-2013:p0611:b005:l003","ordinal":123328,"en":"Various precious ruby stones"},{"id":"semetey-1-2013:p0611:b005:l004","ordinal":123329,"en":"She had set in different places."},{"id":"semetey-1-2013:p0611:b005:l005","ordinal":123330,"en":"Farther in was another wonder,"},{"id":"semetey-1-2013:p0611:b005:l006","ordinal":123331,"en":"Satisfying the heart that beheld it:"},{"id":"semetey-1-2013:p0611:b005:l007","ordinal":123332,"en":"A bed made of gold."},{"id":"semetey-1-2013:p0611:b005:l008","ordinal":123333,"en":"Her service knew no bounds."},{"id":"semetey-1-2013:p0611:b005:l009","ordinal":123334,"en":"She had it placed toward the north."},{"id":"semetey-1-2013:p0611:b005:l010","ordinal":123335,"en":"Levying tribute from the Kyrgyz,"},{"id":"semetey-1-2013:p0611:b005:l011","ordinal":123336,"en":"She had juniper ash brought."},{"id":"semetey-1-2013:p0611:b005:l012","ordinal":123337,"en":"Lest the underside decay,"},{"id":"semetey-1-2013:p0611:b005:l013","ordinal":123338,"en":"My noble mother Kanykei"},{"id":"semetey-1-2013:p0611:b005:l014","ordinal":123339,"en":"Had a layer of it spread beneath."},{"id":"semetey-1-2013:p0611:b005:l016","ordinal":123340,"en":"My poor father Manas","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0611:b005:l017","ordinal":123341,"en":"She wrapped in a fine white cloth shroud."},{"id":"semetey-1-2013:p0611:b005:l018","ordinal":123342,"en":"She had a reed screen drawn on this side."},{"id":"semetey-1-2013:p0611:b005:l019","ordinal":123343,"en":"An undyed robe of the kind an ishan wears,"},{"id":"semetey-1-2013:p0611:b005:l020","ordinal":123344,"en":"My incomparable mother Kanykei"},{"id":"semetey-1-2013:p0611:b005:l021","ordinal":123345,"en":"Had laid across him."},{"id":"semetey-1-2013:p0611:b005:l022","ordinal":123346,"en":"He rested his head upon the holy Qur'an."},{"id":"semetey-1-2013:p0611:b005:l023","ordinal":123347,"en":"My khan father's white face,"},{"id":"semetey-1-2013:p0611:b005:l024","ordinal":123348,"en":"His head she turned toward the north."},{"id":"semetey-1-2013:p0611:b005:l025","ordinal":123349,"en":"She had accomplished her service well."},{"id":"semetey-1-2013:p0611:b005:l026","ordinal":123350,"en":"My dear father's white face"},{"id":"semetey-1-2013:p0611:b005:l027","ordinal":123351,"en":"She turned toward the qibla."},{"id":"semetey-1-2013:p0611:b005:l028","ordinal":123352,"en":"Seeing it, his heart was torn."},{"id":"semetey-1-2013:p0611:b005:l029","ordinal":123353,"en":"Crying, “Father!” the orphan's"},{"id":"semetey-1-2013:p0611:b005:l030","ordinal":123354,"en":"Tears poured from his eyes."},{"id":"semetey-1-2013:p0611:b005:l031","ordinal":123355,"en":"His dear, saker-like eyes"},{"id":"semetey-1-2013:p0611:b005:l032","ordinal":123356,"en":"Shed tears with every blink."},{"id":"semetey-1-2013:p0611:b005:l033","ordinal":123357,"en":"His dear eyes like the morning star"},{"id":"semetey-1-2013:p0611:b005:l034","ordinal":123358,"en":"Shed tears together."},{"id":"semetey-1-2013:p0611:b005:l035","ordinal":123359,"en":"Semetey wept with ringing cries,"},{"id":"semetey-1-2013:p0611:b005:l036","ordinal":123360,"en":"And began to lament Manas:"},{"id":"semetey-1-2013:p0611:b005:l037","ordinal":123361,"en":"“Magnanimous Manas, my lion father!"},{"id":"semetey-1-2013:p0611:b005:l038","ordinal":123362,"en":"Your orphan wandered lost,"},{"id":"semetey-1-2013:p0611:b005:l039","ordinal":123363,"en":"And here I have seen your remains."},{"id":"semetey-1-2013:p0612:b003:l001","ordinal":123364,"en":"Your remains lie here, but your soul is gone."},{"id":"semetey-1-2013:p0612:b003:l002","ordinal":123365,"en":"Your form remains, but your blood is gone."},{"id":"semetey-1-2013:p0612:b003:l003","ordinal":123366,"en":"Your valor is absent from your form."},{"id":"semetey-1-2013:p0612:b003:l004","ordinal":123367,"en":"My father who would rise with a roar,"},{"id":"semetey-1-2013:p0612:b003:l005","ordinal":123368,"en":"My sovereign, is gone as well."},{"id":"semetey-1-2013:p0612:b003:l006","ordinal":123369,"en":"Your bed is like a fortress."},{"id":"semetey-1-2013:p0612:b003:l007","ordinal":123370,"en":"To Temir Khan's city"},{"id":"semetey-1-2013:p0612:b003:l008","ordinal":123371,"en":"Your orphan wandered and lived."},{"id":"semetey-1-2013:p0612:b003:l009","ordinal":123372,"en":"He has come before you."},{"id":"semetey-1-2013:p0612:b003:l010","ordinal":123373,"en":"My ocean-like father, wake up!"},{"id":"semetey-1-2013:p0612:b003:l011","ordinal":123374,"en":"The meeting of two rivers—"},{"id":"semetey-1-2013:p0612:b003:l012","ordinal":123375,"en":"My khan father, like their rushing current!"},{"id":"semetey-1-2013:p0612:b003:l013","ordinal":123376,"en":"The meeting of two mountains—"},{"id":"semetey-1-2013:p0612:b003:l014","ordinal":123377,"en":"My khan father, like their great ridge!"},{"id":"semetey-1-2013:p0612:b003:l015","ordinal":123378,"en":"With the moon overhead and the sun rising,"},{"id":"semetey-1-2013:p0612:b003:l016","ordinal":123379,"en":"I could not be your guiding sign."},{"id":"semetey-1-2013:p0612:b003:l017","ordinal":123380,"en":"For my dear father, this poor soul"},{"id":"semetey-1-2013:p0612:b003:l018","ordinal":123381,"en":"Could not remain a companion."},{"id":"semetey-1-2013:p0612:b003:l019","ordinal":123382,"en":"I never beheld you while you lived."},{"id":"semetey-1-2013:p0612:b003:l020","ordinal":123383,"en":"Until I reached twelve,"},{"id":"semetey-1-2013:p0612:b003:l021","ordinal":123384,"en":"Why could you not live, my formidable father?”"},{"id":"semetey-1-2013:p0612:b003:l022","ordinal":123385,"en":"Reciting the profession of faith, he sobbed,"},{"id":"semetey-1-2013:p0612:b003:l023","ordinal":123386,"en":"Weeping in sorrow, shaking with grief."},{"id":"semetey-1-2013:p0612:b003:l024","ordinal":123387,"en":"“The four corners of the round world,"},{"id":"semetey-1-2013:p0612:b003:l025","ordinal":123388,"en":"I did not gather from all four sides,"},{"id":"semetey-1-2013:p0612:b003:l026","ordinal":123389,"en":"Saying, ‘My lord father died today.’"},{"id":"semetey-1-2013:p0612:b003:l027","ordinal":123390,"en":"I did not serve at your bedside."},{"id":"semetey-1-2013:p0612:b003:l028","ordinal":123391,"en":"I lament to God."},{"id":"semetey-1-2013:p0612:b003:l029","ordinal":123392,"en":"Your resting place is like a rocky fortress."}]
