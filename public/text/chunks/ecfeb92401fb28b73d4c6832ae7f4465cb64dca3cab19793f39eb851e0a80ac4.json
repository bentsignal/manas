[{"id":"semetey-1-2013:p0813:b004:l016","ordinal":138497,"en":"What would your poor uncle Sary do?"},{"id":"semetey-1-2013:p0813:b004:l017","ordinal":138498,"en":"Thick-armed and stone-hearted,"},{"id":"semetey-1-2013:p0813:b004:l018","ordinal":138499,"en":"Unless these things were presented to him,"},{"id":"semetey-1-2013:p0813:b004:l019","ordinal":138500,"en":"He would bring great havoc on Bukhara."},{"id":"semetey-1-2013:p0813:b004:l020","ordinal":138501,"en":"His eyes stood out from his brow,"},{"id":"semetey-1-2013:p0813:b004:l021","ordinal":138502,"en":"His heroic nature showed."},{"id":"semetey-1-2013:p0813:b004:l022","ordinal":138503,"en":"Looking him straight in the face,"},{"id":"semetey-1-2013:p0813:b004:l023","ordinal":138504,"en":"No mortal could endure his presence."},{"id":"semetey-1-2013:p0813:b004:l024","ordinal":138505,"en":"If he faced them, extending his spear,"},{"id":"semetey-1-2013:p0813:b004:l025","ordinal":138506,"en":"No mortal could approach him."},{"id":"semetey-1-2013:p0813:b004:l026","ordinal":138507,"en":"He was a support to rely upon;"},{"id":"semetey-1-2013:p0813:b004:l027","ordinal":138508,"en":"For this orphan Semetey,"},{"id":"semetey-1-2013:p0813:b004:l028","ordinal":138509,"en":"He was a binding about the waist,"},{"id":"semetey-1-2013:p0813:b004:l029","ordinal":138510,"en":"A hero on whom to set one's hopes."},{"id":"semetey-1-2013:p0813:b004:l030","ordinal":138511,"en":"Then this only son of Manas,"},{"id":"semetey-1-2013:p0813:b004:l031","ordinal":138512,"en":"Taking courage in ‘my uncle Sary,’"},{"id":"semetey-1-2013:p0813:b004:l032","ordinal":138513,"en":"Made the bald charcoal burner a hero,"},{"id":"semetey-1-2013:p0813:b004:l033","ordinal":138514,"en":"Did away with the name ‘Sary Taz,’"},{"id":"semetey-1-2013:p0813:b004:l034","ordinal":138515,"en":"Made him a renowned khan,"},{"id":"semetey-1-2013:p0813:b004:l035","ordinal":138516,"en":"And raised Sary Taz's fortunes."},{"id":"semetey-1-2013:p0813:b004:l036","ordinal":138517,"en":"‘While this dear head of mine is safe,"},{"id":"semetey-1-2013:p0813:b004:l037","ordinal":138518,"en":"I shall stir up trouble in the world,’ he said,"},{"id":"semetey-1-2013:p0813:b004:l038","ordinal":138519,"en":"Setting a golden crown upon him,"},{"id":"semetey-1-2013:p0813:b004:l039","ordinal":138520,"en":"And seating him upon a golden throne,"},{"id":"semetey-1-2013:p0814:b003:l001","ordinal":138521,"en":"‘If he lives, over the Argyn"},{"id":"semetey-1-2013:p0814:b003:l002","ordinal":138522,"en":"I shall raise him as khan,’ he said."},{"id":"semetey-1-2013:p0814:b003:l003","ordinal":138523,"en":"Tuuchunak, whom no bullet could catch,"},{"id":"semetey-1-2013:p0814:b003:l004","ordinal":138524,"en":"He gave Sary Khan to ride."},{"id":"semetey-1-2013:p0814:b003:l005","ordinal":138525,"en":"The costly blue armored coat"},{"id":"semetey-1-2013:p0814:b003:l006","ordinal":138526,"en":"He had put upon him as well."},{"id":"semetey-1-2013:p0814:b003:l007","ordinal":138527,"en":"Bozkelte, adept at shooting,"},{"id":"semetey-1-2013:p0814:b003:l008","ordinal":138528,"en":"He had hung upon your uncle Sary."},{"id":"semetey-1-2013:p0814:b003:l009","ordinal":138529,"en":"In your uncle Sary's hands"},{"id":"semetey-1-2013:p0814:b003:l010","ordinal":138530,"en":"Were weapons of every kind."},{"id":"semetey-1-2013:p0814:b003:l011","ordinal":138531,"en":"The marks of a khan were unmistakable—"},{"id":"semetey-1-2013:p0814:b003:l012","ordinal":138532,"en":"The sight diverted one's heart;"},{"id":"semetey-1-2013:p0814:b003:l013","ordinal":138533,"en":"The marks of a khan appeared,"},{"id":"semetey-1-2013:p0814:b003:l014","ordinal":138534,"en":"Much of his misfortune was cut away,"},{"id":"semetey-1-2013:p0814:b003:l015","ordinal":138535,"en":"His thoughts were fully unburdened."},{"id":"semetey-1-2013:p0814:b003:l016","ordinal":138536,"en":"Entering Bukhara, he obtained a horse,"},{"id":"semetey-1-2013:p0814:b003:l017","ordinal":138537,"en":"And himself was named ‘Sary Khan.’"},{"id":"semetey-1-2013:p0814:b003:l018","ordinal":138538,"en":"Let us leave him like this,"},{"id":"semetey-1-2013:p0814:b003:l019","ordinal":138539,"en":"And take up the other side."},{"id":"semetey-1-2013:p0814:b003:l020","ordinal":138540,"en":"Then Temir Khan proclaimed a decree,"},{"id":"semetey-1-2013:p0814:b003:l022","ordinal":138541,"en":"To all the people without exception,"},{"id":"semetey-1-2013:p0814:b003:l023","ordinal":138542,"en":"He called, ‘Let them come here!’"},{"id":"semetey-1-2013:p0814:b003:l024","ordinal":138543,"en":"Temir Khan had a golden throne,"},{"id":"semetey-1-2013:p0814:b003:l025","ordinal":138544,"en":"And fortune surpassing other men's."},{"id":"semetey-1-2013:p0814:b003:l026","ordinal":138545,"en":"He had executioners in plenty,"},{"id":"semetey-1-2013:p0814:b003:l027","ordinal":138546,"en":"And all his strongmen were there."},{"id":"semetey-1-2013:p0814:b003:l028","ordinal":138547,"en":"Among those strongmen"},{"id":"semetey-1-2013:p0814:b003:l029","ordinal":138548,"en":"Were elders who could find wise counsel."},{"id":"semetey-1-2013:p0814:b003:l030","ordinal":138549,"en":"Guarding the entrance to the gate,"},{"id":"semetey-1-2013:p0814:b003:l031","ordinal":138550,"en":"His sentries were there as well."},{"id":"semetey-1-2013:p0814:b003:l032","ordinal":138551,"en":"To those sentries"},{"id":"semetey-1-2013:p0814:b003:l033","ordinal":138552,"en":"No one would come near."},{"id":"semetey-1-2013:p0814:b003:l034","ordinal":138553,"en":"Human noses and ears"},{"id":"semetey-1-2013:p0814:b003:l035","ordinal":138554,"en":"They wore as amulets."},{"id":"semetey-1-2013:p0814:b003:l036","ordinal":138555,"en":"People wandered clear of them;"},{"id":"semetey-1-2013:p0814:b003:l037","ordinal":138556,"en":"Those who met them stood amazed."},{"id":"semetey-1-2013:p0814:b003:l038","ordinal":138557,"en":"Temir Khan ruled over all,"},{"id":"semetey-1-2013:p0814:b003:l039","ordinal":138558,"en":"A man of formidable spiritual power."},{"id":"semetey-1-2013:p0814:b004:l001","ordinal":138559,"en":"Those who grappled with him lay still;"},{"id":"semetey-1-2013:p0814:b004:l002","ordinal":138560,"en":"He was a khan rich in wisdom."},{"id":"semetey-1-2013:p0814:b004:l003","ordinal":138561,"en":"He had his dutars brought out,"},{"id":"semetey-1-2013:p0814:b004:l004","ordinal":138562,"en":"And rattles made of iron"},{"id":"semetey-1-2013:p0814:b004:l005","ordinal":138563,"en":"All played in proper rhythm."},{"id":"semetey-1-2013:p0814:b004:l006","ordinal":138564,"en":"He made his trumpets blare,"},{"id":"semetey-1-2013:p0814:b004:l007","ordinal":138565,"en":"And had his booming drums struck."},{"id":"semetey-1-2013:p0814:b004:l008","ordinal":138566,"en":"He gathered his people,"},{"id":"semetey-1-2013:p0814:b004:l009","ordinal":138567,"en":"And had great counsel taken."},{"id":"semetey-1-2013:p0814:b004:l010","ordinal":138568,"en":"At the golden tower,"},{"id":"semetey-1-2013:p0814:b004:l011","ordinal":138569,"en":"He gathered all the people at its foot."},{"id":"semetey-1-2013:p0814:b004:l013","ordinal":138570,"en":"Roaring in his wrath,"},{"id":"semetey-1-2013:p0814:b004:l014","ordinal":138571,"en":"Temir Khan proclaimed a decree:"},{"id":"semetey-1-2013:p0814:b004:l015","ordinal":138572,"en":"‘Let your dignitaries come, your khans come,"},{"id":"semetey-1-2013:p0814:b004:l016","ordinal":138573,"en":"Come, all you people gathered here!"},{"id":"semetey-1-2013:p0814:b004:l017","ordinal":138574,"en":"Let the resourceful and skillful come,"},{"id":"semetey-1-2013:p0814:b004:l018","ordinal":138575,"en":"Let the worthy, rich in wisdom, come."},{"id":"semetey-1-2013:p0814:b004:l019","ordinal":138576,"en":"Let your white-turbaned khojas come,"},{"id":"semetey-1-2013:p0814:b004:l020","ordinal":138577,"en":"Let your lesson-reading mullahs come."},{"id":"semetey-1-2013:p0814:b004:l021","ordinal":138578,"en":"Let your elders, rich in wisdom, come,"},{"id":"semetey-1-2013:p0814:b004:l022","ordinal":138579,"en":"Come, all of you, young and old!"},{"id":"semetey-1-2013:p0814:b004:l023","ordinal":138580,"en":"My protector left by Manas,"},{"id":"semetey-1-2013:p0814:b004:l024","ordinal":138581,"en":"Semetey, my only fortune,"},{"id":"semetey-1-2013:p0814:b004:l025","ordinal":138582,"en":"For whom I raised a golden tent,"},{"id":"semetey-1-2013:p0814:b004:l026","ordinal":138583,"en":"My lion whom I cherished and reared!"},{"id":"semetey-1-2013:p0814:b004:l027","ordinal":138584,"en":"I saw you when you were tender;"},{"id":"semetey-1-2013:p0814:b004:l028","ordinal":138585,"en":"This child of mine, when newly born,"},{"id":"semetey-1-2013:p0814:b004:l029","ordinal":138586,"en":"I have nurtured and kept safe."},{"id":"semetey-1-2013:p0814:b004:l030","ordinal":138587,"en":"I am grateful to God:"},{"id":"semetey-1-2013:p0814:b004:l031","ordinal":138588,"en":"He has now reached twelve,"},{"id":"semetey-1-2013:p0814:b004:l032","ordinal":138589,"en":"And God has granted my desire."},{"id":"semetey-1-2013:p0814:b004:l033","ordinal":138590,"en":"He has grown mature, become a hero;"},{"id":"semetey-1-2013:p0814:b004:l034","ordinal":138591,"en":"Childhood has passed, his sense is full."},{"id":"semetey-1-2013:p0814:b004:l035","ordinal":138592,"en":"The time has come to join his people."},{"id":"semetey-1-2013:p0814:b004:l036","ordinal":138593,"en":"Twelve tail feathers, ten flight feathers—"},{"id":"semetey-1-2013:p0814:b004:l037","ordinal":138594,"en":"Consider, my people, he has matured."},{"id":"semetey-1-2013:p0814:b004:l038","ordinal":138595,"en":"He has become a khan who can maintain a court,"},{"id":"semetey-1-2013:p0814:b004:l039","ordinal":138596,"en":"A man of settled purpose."},{"id":"semetey-1-2013:p0815:b003:l001","ordinal":138597,"en":"His childhood days are gone;"},{"id":"semetey-1-2013:p0815:b003:l002","ordinal":138598,"en":"He has taken on a hero's form."},{"id":"semetey-1-2013:p0815:b003:l003","ordinal":138599,"en":"His childish foolishness is gone;"},{"id":"semetey-1-2013:p0815:b003:l004","ordinal":138600,"en":"He has grown into a hero's son."},{"id":"semetey-1-2013:p0815:b003:l005","ordinal":138601,"en":"I have hope in my child,"},{"id":"semetey-1-2013:p0815:b003:l006","ordinal":138602,"en":"That he will go and settle in Talas."},{"id":"semetey-1-2013:p0815:b003:l007","ordinal":138603,"en":"If this orphan survives,"},{"id":"semetey-1-2013:p0815:b003:l008","ordinal":138604,"en":"He will prove himself Manas's son."},{"id":"semetey-1-2013:p0815:b003:l009","ordinal":138605,"en":"I cherish hope in the child,"},{"id":"semetey-1-2013:p0815:b003:l010","ordinal":138606,"en":"That he will take after his father."},{"id":"semetey-1-2013:p0815:b003:l011","ordinal":138607,"en":"If he lives, my blessing"},{"id":"semetey-1-2013:p0815:b003:l012","ordinal":138608,"en":"To all the sorrowing people"},{"id":"semetey-1-2013:p0815:b003:l013","ordinal":138609,"en":"Will become a father."},{"id":"semetey-1-2013:p0815:b003:l014","ordinal":138610,"en":"If his life stretches long,"},{"id":"semetey-1-2013:p0815:b003:l015","ordinal":138611,"en":"He will stir up trouble in Kentan."},{"id":"semetey-1-2013:p0815:b003:l016","ordinal":138612,"en":"The heir left by Manas"},{"id":"semetey-1-2013:p0815:b003:l017","ordinal":138613,"en":"Will take vengeance for his wrongs."},{"id":"semetey-1-2013:p0815:b003:l018","ordinal":138614,"en":"Semetey standing here,"},{"id":"semetey-1-2013:p0815:b003:l019","ordinal":138615,"en":"The jeweled ornament left by Manas,"},{"id":"semetey-1-2013:p0815:b003:l020","ordinal":138616,"en":"The mirror left by the gray-maned hero—"},{"id":"semetey-1-2013:p0815:b003:l021","ordinal":138617,"en":"Mighty Bukhara, hear my words!"},{"id":"semetey-1-2013:p0815:b003:l022","ordinal":138618,"en":"Living an orphan, he has matured,"},{"id":"semetey-1-2013:p0815:b003:l023","ordinal":138619,"en":"And joined the ranks himself."},{"id":"semetey-1-2013:p0815:b003:l024","ordinal":138620,"en":"He has grown mature, become a hero,"},{"id":"semetey-1-2013:p0815:b003:l025","ordinal":138621,"en":"And stands equal to a hero's son."},{"id":"semetey-1-2013:p0815:b003:l026","ordinal":138622,"en":"Fortune has settled on his brow;"},{"id":"semetey-1-2013:p0815:b003:l027","ordinal":138623,"en":"The time for heroism has come!"},{"id":"semetey-1-2013:p0815:b003:l028","ordinal":138624,"en":"Your father's grave, you Bukharans!"},{"id":"semetey-1-2013:p0815:b003:l029","ordinal":138625,"en":"You dug my pit deep,"},{"id":"semetey-1-2013:p0815:b003:l030","ordinal":138626,"en":"Saying, ‘Your child has turned unruly,’"},{"id":"semetey-1-2013:p0815:b003:l031","ordinal":138627,"en":"You meant to boil up my misery!"},{"id":"semetey-1-2013:p0815:b003:l032","ordinal":138628,"en":"Now Semetey leaves for his people."},{"id":"semetey-1-2013:p0815:b003:l033","ordinal":138629,"en":"Come, not merely your worst, but all of you;"},{"id":"semetey-1-2013:p0815:b003:l034","ordinal":138630,"en":"Come together, all Bukhara!"},{"id":"semetey-1-2013:p0815:b003:l035","ordinal":138631,"en":"If this child leaves unmarried,"},{"id":"semetey-1-2013:p0815:b003:l036","ordinal":138632,"en":"Do not be left wailing, my people."},{"id":"semetey-1-2013:p0815:b003:l037","ordinal":138633,"en":"For the plump, pale-mottled goshawk,"},{"id":"semetey-1-2013:p0815:b003:l038","ordinal":138634,"en":"For the gray hawk, your morning star,"},{"id":"semetey-1-2013:p0815:b003:l039","ordinal":138635,"en":"Prepare his bride!"},{"id":"semetey-1-2013:p0815:b004:l001","ordinal":138636,"en":"Remember to give his share of livestock;"},{"id":"semetey-1-2013:p0815:b004:l002","ordinal":138637,"en":"He is moving to the Kyrgyz."},{"id":"semetey-1-2013:p0815:b004:l003","ordinal":138638,"en":"Give him your golden throne to sit upon!’"},{"id":"semetey-1-2013:p0815:b004:l004","ordinal":138639,"en":"While Temir Khan was speaking,"},{"id":"semetey-1-2013:p0815:b004:l005","ordinal":138640,"en":"Their faces changing, their color turning,"},{"id":"semetey-1-2013:p0815:b004:l006","ordinal":138641,"en":"The wretched people of Bukhara"},{"id":"semetey-1-2013:p0815:b004:l007","ordinal":138642,"en":"Thrust their heads toward the ground."},{"id":"semetey-1-2013:p0815:b004:l008","ordinal":138643,"en":"As though a massacre had struck them,"},{"id":"semetey-1-2013:p0815:b004:l009","ordinal":138644,"en":"Not one made the slightest sound."},{"id":"semetey-1-2013:p0815:b004:l010","ordinal":138645,"en":"All scraped at the earth in a row,"},{"id":"semetey-1-2013:p0815:b004:l011","ordinal":138646,"en":"Each with his head bent to the ground."},{"id":"semetey-1-2013:p0815:b004:l012","ordinal":138647,"en":"The white-bearded elders stared"},{"id":"semetey-1-2013:p0815:b004:l013","ordinal":138648,"en":"At the black-bearded men."},{"id":"semetey-1-2013:p0815:b004:l014","ordinal":138649,"en":"The black-bearded warriors"},{"id":"semetey-1-2013:p0815:b004:l015","ordinal":138650,"en":"Looked at the young men."},{"id":"semetey-1-2013:p0815:b004:l016","ordinal":138651,"en":"All the young men,"},{"id":"semetey-1-2013:p0815:b004:l017","ordinal":138652,"en":"As though a massacre had struck them,"},{"id":"semetey-1-2013:p0815:b004:l018","ordinal":138653,"en":"Fled away, one after another."},{"id":"semetey-1-2013:p0815:b004:l019","ordinal":138654,"en":"Bukhara's khan, Temir Khan,"},{"id":"semetey-1-2013:p0815:b004:l020","ordinal":138655,"en":"Saw that no counsel would come from these people,"},{"id":"semetey-1-2013:p0815:b004:l021","ordinal":138656,"en":"Watching now from the tower."},{"id":"semetey-1-2013:p0815:b004:l022","ordinal":138657,"en":"Jerking again and again,"},{"id":"semetey-1-2013:p0815:b004:l023","ordinal":138658,"en":"As though seized by a fit of rage,"},{"id":"semetey-1-2013:p0815:b004:l024","ordinal":138659,"en":"He shook and issued orders."},{"id":"semetey-1-2013:p0815:b004:l025","ordinal":138660,"en":"At the many people of Bukhara,"},{"id":"semetey-1-2013:p0815:b004:l026","ordinal":138661,"en":"He now grew angry."},{"id":"semetey-1-2013:p0815:b004:l027","ordinal":138662,"en":"‘Oh, people like straw stuffed in a sack,"},{"id":"semetey-1-2013:p0815:b004:l028","ordinal":138663,"en":"There is no support in a spiritless people!"},{"id":"semetey-1-2013:p0815:b004:l029","ordinal":138664,"en":"Your father's grave, you wretched people!"},{"id":"semetey-1-2013:p0815:b004:l030","ordinal":138665,"en":"If this orphan leaves without a wife,"},{"id":"semetey-1-2013:p0815:b004:l031","ordinal":138666,"en":"And should choke with pent-up anger,"},{"id":"semetey-1-2013:p0815:b004:l032","ordinal":138667,"en":"With all this gossip of yours besides,"},{"id":"semetey-1-2013:p0815:b004:l033","ordinal":138668,"en":"Will he not suddenly grow wrathful?"},{"id":"semetey-1-2013:p0815:b004:l034","ordinal":138669,"en":"If this orphan turns back,"},{"id":"semetey-1-2013:p0815:b004:l035","ordinal":138670,"en":"Will he not bring devastation,"},{"id":"semetey-1-2013:p0815:b004:l036","ordinal":138671,"en":"Will he not take vengeance far and wide?"},{"id":"semetey-1-2013:p0815:b004:l037","ordinal":138672,"en":"Will he not settle accounts with you this way?"},{"id":"semetey-1-2013:p0815:b004:l038","ordinal":138673,"en":"If this orphan runs wild,"},{"id":"semetey-1-2013:p0815:b004:l039","ordinal":138674,"en":"Will he not utterly destroy your people,"},{"id":"semetey-1-2013:p0816:b003:l001","ordinal":138675,"en":"Will he not beat your old madness out of you?"},{"id":"semetey-1-2013:p0816:b003:l002","ordinal":138676,"en":"Will he not plunder your treasury?"},{"id":"semetey-1-2013:p0816:b003:l003","ordinal":138677,"en":"If Semetey leaves without a wife,"},{"id":"semetey-1-2013:p0816:b003:l004","ordinal":138678,"en":"Will he not bring devastation?’"},{"id":"semetey-1-2013:p0816:b003:l005","ordinal":138679,"en":"Temir Khan grew angry,"},{"id":"semetey-1-2013:p0816:b003:l006","ordinal":138680,"en":"And had the reed horn sounded."},{"id":"semetey-1-2013:p0816:b003:l007","ordinal":138681,"en":"About eighty-five of his strongmen"},{"id":"semetey-1-2013:p0816:b003:l008","ordinal":138682,"en":"Made themselves ready."},{"id":"semetey-1-2013:p0816:b003:l009","ordinal":138683,"en":"He struck the people with terror,"},{"id":"semetey-1-2013:p0816:b003:l010","ordinal":138684,"en":"And made his orders harsh."},{"id":"semetey-1-2013:p0816:b003:l011","ordinal":138685,"en":"He roared in his wrath,"},{"id":"semetey-1-2013:p0816:b003:l012","ordinal":138686,"en":"And all the strongmen,"},{"id":"semetey-1-2013:p0816:b003:l013","ordinal":138687,"en":"Hurrying them, making them pant,"},{"id":"semetey-1-2013:p0816:b003:l014","ordinal":138688,"en":"He summoned: ‘Come here!’"},{"id":"semetey-1-2013:p0816:b003:l015","ordinal":138689,"en":"Temir Khan's strongmen"},{"id":"semetey-1-2013:p0816:b003:l016","ordinal":138690,"en":"Were all in haste and confusion."},{"id":"semetey-1-2013:p0816:b003:l017","ordinal":138691,"en":"The commanders of ten bobbed about;"},{"id":"semetey-1-2013:p0816:b003:l018","ordinal":138692,"en":"Commanders of fifty and a hundred"},{"id":"semetey-1-2013:p0816:b003:l019","ordinal":138693,"en":"Bustled, frightened out of their wits."},{"id":"semetey-1-2013:p0816:b003:l020","ordinal":138694,"en":"The commanders of a hundred ran,"},{"id":"semetey-1-2013:p0816:b003:l021","ordinal":138695,"en":"Greatly despairing for their lives."},{"id":"semetey-1-2013:p0816:b003:l022","ordinal":138696,"en":"When the strongmen arrived,"},{"id":"semetey-1-2013:p0816:b003:l023","ordinal":138697,"en":"Temir Khan stood and said:"},{"id":"semetey-1-2013:p0816:b003:l024","ordinal":138698,"en":"‘Strongmen, hear my words!"},{"id":"semetey-1-2013:p0816:b003:l025","ordinal":138699,"en":"Of Bukhara's twelve gates,"},{"id":"semetey-1-2013:p0816:b003:l026","ordinal":138700,"en":"Open all twelve entrances!"},{"id":"semetey-1-2013:p0816:b003:l027","ordinal":138701,"en":"Belonging to the treasury,"},{"id":"semetey-1-2013:p0816:b003:l028","ordinal":138702,"en":"I have twelve kinds of livestock."},{"id":"semetey-1-2013:p0816:b003:l029","ordinal":138703,"en":"For the one child Semetey,"},{"id":"semetey-1-2013:p0816:b003:l030","ordinal":138704,"en":"Spend them and give them away!"},{"id":"semetey-1-2013:p0816:b003:l031","ordinal":138705,"en":"In the gated royal court,"},{"id":"semetey-1-2013:p0816:b003:l032","ordinal":138706,"en":"The costly crimson cloth,"},{"id":"semetey-1-2013:p0816:b003:l033","ordinal":138707,"en":"Folded up from crimson cloth—"},{"id":"semetey-1-2013:p0816:b003:l034","ordinal":138708,"en":"Around the world's four corners,"},{"id":"semetey-1-2013:p0816:b003:l035","ordinal":138709,"en":"Sent around all four,"},{"id":"semetey-1-2013:p0816:b003:l036","ordinal":138710,"en":"They carried trading loads."},{"id":"semetey-1-2013:p0816:b003:l037","ordinal":138711,"en":"Bells as large as buckets,"},{"id":"semetey-1-2013:p0816:b003:l038","ordinal":138712,"en":"Pampering them, upon their necks"},{"id":"semetey-1-2013:p0816:b003:l039","ordinal":138713,"en":"They hung them all in great abundance."},{"id":"semetey-1-2013:p0816:b004:l001","ordinal":138714,"en":"Letting no other beast approach them,"},{"id":"semetey-1-2013:p0816:b004:l002","ordinal":138715,"en":"They reared them in the white palace."},{"id":"semetey-1-2013:p0816:b004:l003","ordinal":138716,"en":"With their fangs jutting out,"},{"id":"semetey-1-2013:p0816:b004:l004","ordinal":138717,"en":"Their lower lips hanging down,"},{"id":"semetey-1-2013:p0816:b004:l005","ordinal":138718,"en":"Their humps rising high,"},{"id":"semetey-1-2013:p0816:b004:l006","ordinal":138719,"en":"Their long hair flowing—"},{"id":"semetey-1-2013:p0816:b004:l007","ordinal":138720,"en":"Eighty red-tailed single-humped camels"},{"id":"semetey-1-2013:p0816:b004:l008","ordinal":138721,"en":"Bring to the treasury."},{"id":"semetey-1-2013:p0816:b004:l009","ordinal":138722,"en":"Of gold and silver,"},{"id":"semetey-1-2013:p0816:b004:l010","ordinal":138723,"en":"Load the gelded camels."},{"id":"semetey-1-2013:p0816:b004:l011","ordinal":138724,"en":"Agree to what I say;"},{"id":"semetey-1-2013:p0816:b004:l012","ordinal":138725,"en":"This orphan's inheritance"},{"id":"semetey-1-2013:p0816:b004:l013","ordinal":138726,"en":"Give him in this manner."},{"id":"semetey-1-2013:p0816:b004:l014","ordinal":138727,"en":"There is more I have to say;"},{"id":"semetey-1-2013:p0816:b004:l015","ordinal":138728,"en":"Once more, my people, heed my words!"},{"id":"semetey-1-2013:p0816:b004:l016","ordinal":138729,"en":"Bukhara's twelve gates—"},{"id":"semetey-1-2013:p0816:b004:l017","ordinal":138730,"en":"Set their doors open."},{"id":"semetey-1-2013:p0816:b004:l018","ordinal":138731,"en":"Five sets of nine, each headed by a mare,"},{"id":"semetey-1-2013:p0816:b004:l019","ordinal":138732,"en":"Slaughter at every entrance."},{"id":"semetey-1-2013:p0816:b004:l020","ordinal":138733,"en":"Twelve discerning judges,"},{"id":"semetey-1-2013:p0816:b004:l021","ordinal":138734,"en":"Clear-sighted men,"},{"id":"semetey-1-2013:p0816:b004:l022","ordinal":138735,"en":"Warriors who have seen much,"},{"id":"semetey-1-2013:p0816:b004:l023","ordinal":138736,"en":"Able men who know the truth,"},{"id":"semetey-1-2013:p0816:b004:l024","ordinal":138737,"en":"Worthy men of surpassing knowledge—"},{"id":"semetey-1-2013:p0816:b004:l025","ordinal":138738,"en":"Place them at each entrance."},{"id":"semetey-1-2013:p0816:b004:l026","ordinal":138739,"en":"Send word to the people:"},{"id":"semetey-1-2013:p0816:b004:l027","ordinal":138740,"en":"With thimble mouths and camel-calf eyes,"},{"id":"semetey-1-2013:p0816:b004:l028","ordinal":138741,"en":"Crimson dresses and slender waists,"},{"id":"semetey-1-2013:p0816:b004:l029","ordinal":138742,"en":"Of the graceful beauties,"},{"id":"semetey-1-2013:p0816:b004:l030","ordinal":138743,"en":"Let them be maidens, not married women;"},{"id":"semetey-1-2013:p0816:b004:l031","ordinal":138744,"en":"Let every one be truly beautiful."},{"id":"semetey-1-2013:p0816:b004:l032","ordinal":138745,"en":"With broad foreheads and dark eyes,"},{"id":"semetey-1-2013:p0816:b004:l033","ordinal":138746,"en":"Well-formed beauties with dark eyes,"},{"id":"semetey-1-2013:p0816:b004:l034","ordinal":138747,"en":"Below sixteen,"},{"id":"semetey-1-2013:p0816:b004:l035","ordinal":138748,"en":"And above ten,"},{"id":"semetey-1-2013:p0816:b004:l036","ordinal":138749,"en":"Girls between those ages—"},{"id":"semetey-1-2013:p0816:b004:l037","ordinal":138750,"en":"Gather every one of them,"},{"id":"semetey-1-2013:p0816:b004:l038","ordinal":138751,"en":"And set them filing past."},{"id":"semetey-1-2013:p0816:b004:l039","ordinal":138752,"en":"‘She is already betrothed,’"}]
