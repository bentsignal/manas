[{"id":"manas-2010:p1617:b001:l009","ordinal":69633,"en":"Like a vast army when he came from behind,"},{"id":"manas-2010:p1617:b001:l010","ordinal":69634,"en":"Auspicious when he gave shelter,"},{"id":"manas-2010:p1617:b001:l011","ordinal":69635,"en":"Like a vast army to behold,"},{"id":"manas-2010:p1617:b001:l012","ordinal":69636,"en":"Never sleeping upon his elbow,"},{"id":"manas-2010:p1617:b001:l013","ordinal":69637,"en":"Never taking a moment's rest,"},{"id":"manas-2010:p1617:b001:l014","ordinal":69638,"en":"Unmoved by the sight of booty,"},{"id":"manas-2010:p1617:b001:l015","ordinal":69639,"en":"That was devastating Syrgak himself;"},{"id":"manas-2010:p1617:b001:l016","ordinal":69640,"en":"Now was his time to slaughter the Chinese."},{"id":"manas-2010:p1617:b001:l017","ordinal":69641,"en":"Making Kökchebich wheel and dart,"},{"id":"manas-2010:p1617:b001:l018","ordinal":69642,"en":"Sending those he met crawling,"},{"id":"manas-2010:p1617:b001:l019","ordinal":69643,"en":"Through their middle, brave Syrgak"},{"id":"manas-2010:p1617:b001:l020","ordinal":69644,"en":"Came gouging a path."},{"id":"manas-2010:p1617:b001:l021","ordinal":69645,"en":"Their very center, Almambet"},{"id":"manas-2010:p1617:b001:l022","ordinal":69646,"en":"Came hemming in."},{"id":"manas-2010:p1617:b001:l023","ordinal":69647,"en":"Around their edges, brave Chubak"},{"id":"manas-2010:p1617:b001:l024","ordinal":69648,"en":"Came piercing through."},{"id":"manas-2010:p1617:b001:l025","ordinal":69649,"en":"Khan Manas's forty companions,"},{"id":"manas-2010:p1617:b001:l026","ordinal":69650,"en":"Their shouts splitting stone,"},{"id":"manas-2010:p1617:b001:l027","ordinal":69651,"en":"Slew and drove the enemy onward."},{"id":"manas-2010:p1617:b001:l028","ordinal":69652,"en":"The handful of Muslims"},{"id":"manas-2010:p1617:b001:l029","ordinal":69653,"en":"Entered without sparing themselves."},{"id":"manas-2010:p1617:b001:l030","ordinal":69654,"en":"Their tusks jutting out,"},{"id":"manas-2010:p1617:b001:l031","ordinal":69655,"en":"Dead horses fell in mountains;"},{"id":"manas-2010:p1617:b001:l032","ordinal":69656,"en":"Their moustaches spread flat,"},{"id":"manas-2010:p1617:b001:l033","ordinal":69657,"en":"Dead heroes fell in bundles."},{"id":"manas-2010:p1617:b001:l034","ordinal":69658,"en":"Ah, a lone hero died,"},{"id":"manas-2010:p1617:b001:l035","ordinal":69659,"en":"Many a splendid khan died,"},{"id":"manas-2010:p1617:b001:l036","ordinal":69660,"en":"Many a steed among the racers died,"},{"id":"manas-2010:p1617:b001:l037","ordinal":69661,"en":"Heroes among the brave men died."},{"id":"manas-2010:p1617:b001:l038","ordinal":69662,"en":"Those still living, not yet dead,"},{"id":"manas-2010:p1617:b001:l039","ordinal":69663,"en":"Were drenched in crimson blood."},{"id":"manas-2010:p1617:b001:l040","ordinal":69664,"en":"Those who stood and fought without fleeing,"},{"id":"manas-2010:p1617:b001:l041","ordinal":69665,"en":"Their two arms paralyzed,"},{"id":"manas-2010:p1617:b001:l042","ordinal":69666,"en":"Their whole bodies—"},{"id":"manas-2010:p1618:b001:l001","ordinal":69667,"en":"Were numb, unable to move."},{"id":"manas-2010:p1618:b001:l002","ordinal":69668,"en":"They spared one another nothing;"},{"id":"manas-2010:p1618:b001:l003","ordinal":69669,"en":"In the renowned campaign,"},{"id":"manas-2010:p1618:b001:l004","ordinal":69670,"en":"They fought without restraint,"},{"id":"manas-2010:p1618:b001:l005","ordinal":69671,"en":"Drenched in bloody gore."},{"id":"manas-2010:p1618:b001:l006","ordinal":69672,"en":"Unbelievers and Muslims"},{"id":"manas-2010:p1618:b001:l007","ordinal":69673,"en":"Stood and fought without fleeing."},{"id":"manas-2010:p1618:b001:l008","ordinal":69674,"en":"Even in death there was no regret;"},{"id":"manas-2010:p1618:b001:l009","ordinal":69675,"en":"The noble men born as lions,"},{"id":"manas-2010:p1618:b001:l010","ordinal":69676,"en":"Shouting out, “Kyrgyz!”"},{"id":"manas-2010:p1618:b001:l011","ordinal":69677,"en":"Raising the battle cry, “Manas!”"},{"id":"manas-2010:p1618:b001:l012","ordinal":69678,"en":"Fought many battles without stopping."},{"id":"manas-2010:p1618:b001:l013","ordinal":69679,"en":"Each upon his own front,"},{"id":"manas-2010:p1618:b001:l014","ordinal":69680,"en":"All did as they saw fit."},{"id":"manas-2010:p1618:b001:l015","ordinal":69681,"en":"Shouting in fury,"},{"id":"manas-2010:p1618:b001:l016","ordinal":69682,"en":"The three heroes put them to the sword,"},{"id":"manas-2010:p1618:b001:l017","ordinal":69683,"en":"“Drive them back!” they cried, overwhelming them."},{"id":"manas-2010:p1618:b001:l018","ordinal":69684,"en":"Bellowing and screaming,"},{"id":"manas-2010:p1618:b001:l019","ordinal":69685,"en":"The many Chinese indeed"},{"id":"manas-2010:p1618:b001:l020","ordinal":69686,"en":"Drew back and fled."},{"id":"manas-2010:p1618:b001:l021","ordinal":69687,"en":"When the Chinese people of forty khans"},{"id":"manas-2010:p1618:b001:l022","ordinal":69688,"en":"Had fled again,"},{"id":"manas-2010:p1618:b001:l023","ordinal":69689,"en":"Turning their horses' rumps,"},{"id":"manas-2010:p1618:b001:l024","ordinal":69690,"en":"From behind, Almambet"},{"id":"manas-2010:p1618:b001:l025","ordinal":69691,"en":"Came driving them onward."},{"id":"manas-2010:p1618:b001:l026","ordinal":69692,"en":"Giving them no rest, brave Syrgak"},{"id":"manas-2010:p1618:b001:l027","ordinal":69693,"en":"Came striking them."},{"id":"manas-2010:p1618:b001:l028","ordinal":69694,"en":"When Akbaltay's Chubak"},{"id":"manas-2010:p1618:b001:l029","ordinal":69695,"en":"Attacked without restraint,"},{"id":"manas-2010:p1618:b001:l030","ordinal":69696,"en":"When the forty companions behind"},{"id":"manas-2010:p1618:b001:l031","ordinal":69697,"en":"Split them off and drove them,"},{"id":"manas-2010:p1618:b001:l032","ordinal":69698,"en":"The Manzhuu, like black jackdaws,"},{"id":"manas-2010:p1618:b001:l033","ordinal":69699,"en":"Were driven back and scattered;"},{"id":"manas-2010:p1618:b001:l034","ordinal":69700,"en":"The Shibee, as many as a cow's hairs,"},{"id":"manas-2010:p1618:b001:l035","ordinal":69701,"en":"Were thrown into confusion."},{"id":"manas-2010:p1618:b001:l036","ordinal":69702,"en":"Cotton sash and wide boots,"},{"id":"manas-2010:p1618:b001:l037","ordinal":69703,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1618:b001:l038","ordinal":69704,"en":"Shouting in fury,"},{"id":"manas-2010:p1618:b001:l039","ordinal":69705,"en":"The Chinese who had fled"},{"id":"manas-2010:p1618:b001:l040","ordinal":69706,"en":"Cut off and scattered back."},{"id":"manas-2010:p1618:b001:l041","ordinal":69707,"en":"Algara's reins—"},{"id":"manas-2010:p1618:b001:l042","ordinal":69708,"en":"(Like a man whose wife a dark spirit afflicted)—"},{"id":"manas-2010:p1619:b001:l001","ordinal":69709,"en":"Kongurbay kept drawing in."},{"id":"manas-2010:p1619:b001:l002","ordinal":69710,"en":"So many Soloon and Manzhuu"},{"id":"manas-2010:p1619:b001:l003","ordinal":69711,"en":"Kongurbay slaughtered."},{"id":"manas-2010:p1619:b001:l004","ordinal":69712,"en":"When the Fierce One blocked them in front,"},{"id":"manas-2010:p1619:b001:l005","ordinal":69713,"en":"Screaming in the middle,"},{"id":"manas-2010:p1619:b001:l006","ordinal":69714,"en":"The fleeing Chinese gathered."},{"id":"manas-2010:p1619:b001:l007","ordinal":69715,"en":"When the heroes drove them on,"},{"id":"manas-2010:p1619:b001:l008","ordinal":69716,"en":"So many souls were slaughtered."},{"id":"manas-2010:p1619:b001:l009","ordinal":69717,"en":"Paying no heed to the danger,"},{"id":"manas-2010:p1619:b001:l010","ordinal":69718,"en":"Leopard Syrgak shone forth."},{"id":"manas-2010:p1619:b001:l011","ordinal":69719,"en":"“Alöökö's Kongurbay,"},{"id":"manas-2010:p1619:b001:l012","ordinal":69720,"en":"If he comes before me,"},{"id":"manas-2010:p1619:b001:l013","ordinal":69721,"en":"I shall go straight at him."},{"id":"manas-2010:p1619:b001:l014","ordinal":69722,"en":"Whatever Allah has decreed,"},{"id":"manas-2010:p1619:b001:l015","ordinal":69723,"en":"Whatever is written on my brow, I shall see.”"},{"id":"manas-2010:p1619:b001:l016","ordinal":69724,"en":"Ulak Khan's Syrgak,"},{"id":"manas-2010:p1619:b001:l017","ordinal":69725,"en":"Just reaching twenty-one,"},{"id":"manas-2010:p1619:b001:l018","ordinal":69726,"en":"The youth in his swelling prime,"},{"id":"manas-2010:p1619:b001:l019","ordinal":69727,"en":"Against the seething Chinese"},{"id":"manas-2010:p1619:b001:l020","ordinal":69728,"en":"Attacked without drawing back,"},{"id":"manas-2010:p1619:b001:l021","ordinal":69729,"en":"And stood beneath the banner."},{"id":"manas-2010:p1619:b001:l022","ordinal":69730,"en":"Kojozhash's father,"},{"id":"manas-2010:p1619:b001:l023","ordinal":69731,"en":"Karazhoy, he attacked."},{"id":"manas-2010:p1619:b001:l024","ordinal":69732,"en":"Before the man could turn back,"},{"id":"manas-2010:p1619:b001:l025","ordinal":69733,"en":"Before he could see the leopard,"},{"id":"manas-2010:p1619:b001:l026","ordinal":69734,"en":"Syrgak arrived faster than an arrow."},{"id":"manas-2010:p1619:b001:l027","ordinal":69735,"en":"As soon as brave Syrgak reached him,"},{"id":"manas-2010:p1619:b001:l028","ordinal":69736,"en":"The champion Karazhoy"},{"id":"manas-2010:p1619:b001:l029","ordinal":69737,"en":"He thrust down as he passed."},{"id":"manas-2010:p1619:b001:l030","ordinal":69738,"en":"A champion called Zhese"},{"id":"manas-2010:p1619:b001:l031","ordinal":69739,"en":"Arrived and put him on a horse."},{"id":"manas-2010:p1619:b001:l032","ordinal":69740,"en":"Before he could lead him away,"},{"id":"manas-2010:p1619:b001:l033","ordinal":69741,"en":"Golden forelock and tasseled belt,"},{"id":"manas-2010:p1619:b001:l034","ordinal":69742,"en":"Azizkhan's only son,"},{"id":"manas-2010:p1619:b001:l035","ordinal":69743,"en":"Striking Sarala with his whip,"},{"id":"manas-2010:p1619:b001:l036","ordinal":69744,"en":"Your noble Alma arrived."},{"id":"manas-2010:p1619:b001:l037","ordinal":69745,"en":"Upon reaching Karazhoy,"},{"id":"manas-2010:p1619:b001:l038","ordinal":69746,"en":"Your Alma raised a tumult;"},{"id":"manas-2010:p1619:b001:l039","ordinal":69747,"en":"After raising that tumult,"},{"id":"manas-2010:p1619:b001:l040","ordinal":69748,"en":"Of the champion Karazhoy"},{"id":"manas-2010:p1619:b001:l041","ordinal":69749,"en":"He cut off the head."},{"id":"manas-2010:p1619:b001:l042","ordinal":69750,"en":"“Of the Chinese with rank-buttons,"},{"id":"manas-2010:p1620:b001:l001","ordinal":69751,"en":"Having lost the finest,"},{"id":"manas-2010:p1620:b001:l002","ordinal":69752,"en":"How can I remain alive?!”"},{"id":"manas-2010:p1620:b001:l003","ordinal":69753,"en":"Kongurbay bellowed."},{"id":"manas-2010:p1620:b001:l004","ordinal":69754,"en":"Tossing his moustaches with a jerk,"},{"id":"manas-2010:p1620:b001:l005","ordinal":69755,"en":"Cotton sash and wide boots,"},{"id":"manas-2010:p1620:b001:l006","ordinal":69756,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1620:b001:l007","ordinal":69757,"en":"“At least that fugitive wretch,"},{"id":"manas-2010:p1620:b001:l008","ordinal":69758,"en":"Almambet, I shall slaughter!” he said."},{"id":"manas-2010:p1620:b001:l009","ordinal":69759,"en":"His great teeth, like doors,"},{"id":"manas-2010:p1620:b001:l010","ordinal":69760,"en":"Crumbled like grains of millet."},{"id":"manas-2010:p1620:b001:l011","ordinal":69761,"en":"Sending Algara racing,"},{"id":"manas-2010:p1620:b001:l012","ordinal":69762,"en":"He came thundering on."},{"id":"manas-2010:p1620:b001:l013","ordinal":69763,"en":"As he was about to reach Almambet,"},{"id":"manas-2010:p1620:b001:l014","ordinal":69764,"en":"Among the countless Chinese,"},{"id":"manas-2010:p1620:b001:l015","ordinal":69765,"en":"From Sarala's back,"},{"id":"manas-2010:p1620:b001:l016","ordinal":69766,"en":"About to thrust him down and pass,"},{"id":"manas-2010:p1620:b001:l017","ordinal":69767,"en":"Without looking all around,"},{"id":"manas-2010:p1620:b001:l018","ordinal":69768,"en":"Fired with the love of battle,"},{"id":"manas-2010:p1620:b001:l019","ordinal":69769,"en":"Not sparing his life a hair,"},{"id":"manas-2010:p1620:b001:l020","ordinal":69770,"en":"The brim of the black felt hat,"},{"id":"manas-2010:p1620:b001:l021","ordinal":69771,"en":"Khan Manas's Syrgak,"},{"id":"manas-2010:p1620:b001:l022","ordinal":69772,"en":"Whipped Kökchebich."},{"id":"manas-2010:p1620:b001:l023","ordinal":69773,"en":"From the flank, to the Fierce One,"},{"id":"manas-2010:p1620:b001:l024","ordinal":69774,"en":"Dear Syrgak arrived."},{"id":"manas-2010:p1620:b001:l025","ordinal":69775,"en":"From Algara's back,"},{"id":"manas-2010:p1620:b001:l026","ordinal":69776,"en":"Among seven great hosts of Chinese,"},{"id":"manas-2010:p1620:b001:l027","ordinal":69777,"en":"The mountain-like Fierce One"},{"id":"manas-2010:p1620:b001:l028","ordinal":69778,"en":"He thrust down as he passed."},{"id":"manas-2010:p1620:b001:l029","ordinal":69779,"en":"Sprawling broad as a hut,"},{"id":"manas-2010:p1620:b001:l030","ordinal":69780,"en":"From his horse the Fierce One, that wretch,"},{"id":"manas-2010:p1620:b001:l031","ordinal":69781,"en":"Flew off with limbs spread wide."},{"id":"manas-2010:p1620:b001:l032","ordinal":69782,"en":"When the Fierce One fell from his horse,"},{"id":"manas-2010:p1620:b001:l033","ordinal":69783,"en":"“Algara beneath him,"},{"id":"manas-2010:p1620:b001:l034","ordinal":69784,"en":"I shall seize, and break his support;"},{"id":"manas-2010:p1620:b001:l035","ordinal":69785,"en":"That monk whose horse is swift,"},{"id":"manas-2010:p1620:b001:l036","ordinal":69786,"en":"I shall quiet his soul like this,"},{"id":"manas-2010:p1620:b001:l037","ordinal":69787,"en":"I shall bring such torment upon him!”"},{"id":"manas-2010:p1620:b001:l038","ordinal":69788,"en":"Kongurbay's Algara,"},{"id":"manas-2010:p1620:b001:l039","ordinal":69789,"en":"Before he could turn and flee,"},{"id":"manas-2010:p1620:b001:l040","ordinal":69790,"en":"On the red slope, the broad road,"},{"id":"manas-2010:p1620:b001:l041","ordinal":69791,"en":"Before he could dodge and escape,"},{"id":"manas-2010:p1620:b001:l042","ordinal":69792,"en":"A hand reached his lead-rein."},{"id":"manas-2010:p1621:b001:l001","ordinal":69793,"en":"Taking Algara as booty,"},{"id":"manas-2010:p1621:b001:l002","ordinal":69794,"en":"He led him prancing alongside."},{"id":"manas-2010:p1621:b001:l003","ordinal":69795,"en":"A great trench had been dug;"},{"id":"manas-2010:p1621:b001:l004","ordinal":69796,"en":"Great misery had been stirred up."},{"id":"manas-2010:p1621:b001:l005","ordinal":69797,"en":"It was a mine where gold was dug,"},{"id":"manas-2010:p1621:b001:l006","ordinal":69798,"en":"A bad road no lone horse could pass."},{"id":"manas-2010:p1621:b001:l007","ordinal":69799,"en":"When he entered the narrow track,"},{"id":"manas-2010:p1621:b001:l008","ordinal":69800,"en":"Kökchebich, booty taken from the foe,"},{"id":"manas-2010:p1621:b001:l009","ordinal":69801,"en":"Never tired when ridden scouting;"},{"id":"manas-2010:p1621:b001:l010","ordinal":69802,"en":"This was no time for him to tire."},{"id":"manas-2010:p1621:b001:l011","ordinal":69803,"en":"Ridden to the rear camp, he never wearied."},{"id":"manas-2010:p1621:b001:l012","ordinal":69804,"en":"That day, Kökchebich—"},{"id":"manas-2010:p1621:b001:l013","ordinal":69805,"en":"It was no time for him to stumble."},{"id":"manas-2010:p1621:b001:l014","ordinal":69806,"en":"Yet Kökchebich beneath him"},{"id":"manas-2010:p1621:b001:l015","ordinal":69807,"en":"Stumbled as he passed;"},{"id":"manas-2010:p1621:b001:l016","ordinal":69808,"en":"The steel shield upon his head"},{"id":"manas-2010:p1621:b001:l017","ordinal":69809,"en":"Flew off and fell."},{"id":"manas-2010:p1621:b001:l018","ordinal":69810,"en":"Kojozhash, son of Karazhoy,"},{"id":"manas-2010:p1621:b001:l019","ordinal":69811,"en":"A master horseman, fleet on foot,"},{"id":"manas-2010:p1621:b001:l020","ordinal":69812,"en":"The champion lying in wait,"},{"id":"manas-2010:p1621:b001:l021","ordinal":69813,"en":"Exercising his surpassing marksmanship,"},{"id":"manas-2010:p1621:b001:l022","ordinal":69814,"en":"At the height straight ahead"},{"id":"manas-2010:p1621:b001:l023","ordinal":69815,"en":"Had concealed himself."},{"id":"manas-2010:p1621:b001:l024","ordinal":69816,"en":"Before the shield upon the ground"},{"id":"manas-2010:p1621:b001:l025","ordinal":69817,"en":"Could be reached and picked up,"},{"id":"manas-2010:p1621:b001:l026","ordinal":69818,"en":"Before he could put it on his head,"},{"id":"manas-2010:p1621:b001:l027","ordinal":69819,"en":"Never drawing back from what he faced,"},{"id":"manas-2010:p1621:b001:l028","ordinal":69820,"en":"Never turning from what he aimed at,"},{"id":"manas-2010:p1621:b001:l029","ordinal":69821,"en":"Red-clad and charging,"},{"id":"manas-2010:p1621:b001:l030","ordinal":69822,"en":"Syrgak at twenty-one he sighted:"},{"id":"manas-2010:p1621:b001:l031","ordinal":69823,"en":"“Between his two eyes,"},{"id":"manas-2010:p1621:b001:l032","ordinal":69824,"en":"The very place measured out,” he thought,"},{"id":"manas-2010:p1621:b001:l033","ordinal":69825,"en":"“Or, if lower, his eye.”"},{"id":"manas-2010:p1621:b001:l034","ordinal":69826,"en":"Taking steady aim, he fired once."},{"id":"manas-2010:p1621:b001:l035","ordinal":69827,"en":"Your brave Syrgak crumpled;"},{"id":"manas-2010:p1621:b001:l036","ordinal":69828,"en":"He lost the strength to utter a sound,"},{"id":"manas-2010:p1621:b001:l037","ordinal":69829,"en":"Dark blood flowed from his temple."},{"id":"manas-2010:p1621:b001:l038","ordinal":69830,"en":"When the bullet struck Syrgak,"},{"id":"manas-2010:p1621:b001:l039","ordinal":69831,"en":"Kökchebich beneath him,"},{"id":"manas-2010:p1621:b001:l040","ordinal":69832,"en":"Whose trot the wind could not match,"},{"id":"manas-2010:p1621:b001:l041","ordinal":69833,"en":"Was about to trot away."},{"id":"manas-2010:p1621:b001:l042","ordinal":69834,"en":"“At the first neck vertebra,” he thought,"},{"id":"manas-2010:p1622:b001:l001","ordinal":69835,"en":"“That is the measured place.”"},{"id":"manas-2010:p1622:b001:l002","ordinal":69836,"en":"Then, without letting him go far,"},{"id":"manas-2010:p1622:b001:l003","ordinal":69837,"en":"He fired once at Kökchebich."},{"id":"manas-2010:p1622:b001:l004","ordinal":69838,"en":"Wheeling round, he crumpled;"},{"id":"manas-2010:p1622:b001:l005","ordinal":69839,"en":"Heaven's own Kökchebich—"},{"id":"manas-2010:p1622:b001:l006","ordinal":69840,"en":"He died together with his horse,"},{"id":"manas-2010:p1622:b001:l007","ordinal":69841,"en":"Young Syrgak died among them."},{"id":"manas-2010:p1622:b001:l008","ordinal":69842,"en":"The Flood had never swept in there;"},{"id":"manas-2010:p1622:b001:l009","ordinal":69843,"en":"The surging multitude of Chinese"},{"id":"manas-2010:p1622:b001:l010","ordinal":69844,"en":"Were the people of forty khans."},{"id":"manas-2010:p1622:b001:l011","ordinal":69845,"en":"For the Chinese who had known no joy,"},{"id":"manas-2010:p1622:b001:l012","ordinal":69846,"en":"A joyful day now dawned:"},{"id":"manas-2010:p1622:b001:l013","ordinal":69847,"en":"“This Syrgak who has died,"},{"id":"manas-2010:p1622:b001:l014","ordinal":69848,"en":"Let us bind his corpse upon a mule,"},{"id":"manas-2010:p1622:b001:l015","ordinal":69849,"en":"Before the emperor-khan"},{"id":"manas-2010:p1622:b001:l016","ordinal":69850,"en":"Let us take it as a gift!”"},{"id":"manas-2010:p1622:b001:l017","ordinal":69851,"en":"The Chinese came swarming up,"},{"id":"manas-2010:p1622:b001:l018","ordinal":69852,"en":"With Kojozhash at their head,"},{"id":"manas-2010:p1622:b001:l019","ordinal":69853,"en":"And encircled him twelvefold."},{"id":"manas-2010:p1622:b001:l020","ordinal":69854,"en":"Sorrow too great for his breast to hold,"},{"id":"manas-2010:p1622:b001:l021","ordinal":69855,"en":"Your lone fierce-maned Alma's"},{"id":"manas-2010:p1622:b001:l022","ordinal":69856,"en":"Tears streamed in ten directions."},{"id":"manas-2010:p1622:b001:l023","ordinal":69857,"en":"See the ants, see the insects,"},{"id":"manas-2010:p1622:b001:l024","ordinal":69858,"en":"See the Chinese as numerous as insects,"},{"id":"manas-2010:p1622:b001:l025","ordinal":69859,"en":"See the trench they have dug,"},{"id":"manas-2010:p1622:b001:l026","ordinal":69860,"en":"See the misery they have stirred up,"},{"id":"manas-2010:p1622:b001:l027","ordinal":69861,"en":"Bellowing their battle cry,"},{"id":"manas-2010:p1622:b001:l028","ordinal":69862,"en":"See the Chinese army sweeping in!"},{"id":"manas-2010:p1622:b001:l029","ordinal":69863,"en":"Slaughter them on and they never end;"},{"id":"manas-2010:p1622:b001:l030","ordinal":69864,"en":"See the multitude, as countless as grass!"},{"id":"manas-2010:p1622:b001:l031","ordinal":69865,"en":"The leaders of ten wheeled round,"},{"id":"manas-2010:p1622:b001:l032","ordinal":69866,"en":"Their lances jutting,"},{"id":"manas-2010:p1622:b001:l033","ordinal":69867,"en":"All the warriors separated out;"},{"id":"manas-2010:p1622:b001:l034","ordinal":69868,"en":"The army swarmed, giving no rest."},{"id":"manas-2010:p1622:b001:l035","ordinal":69869,"en":"All Beijing was stirred;"},{"id":"manas-2010:p1622:b001:l036","ordinal":69870,"en":"Nothing could be caught by the eye."},{"id":"manas-2010:p1622:b001:l037","ordinal":69871,"en":"Earth flew and dust covered all;"},{"id":"manas-2010:p1622:b001:l038","ordinal":69872,"en":"One could not tell one from another!"},{"id":"manas-2010:p1622:b001:l039","ordinal":69873,"en":"Clear sky, darkened earth,"},{"id":"manas-2010:p1622:b001:l040","ordinal":69874,"en":"As though tumbleweeds were flying,"},{"id":"manas-2010:p1622:b001:l041","ordinal":69875,"en":"Armies teemed over the earth;"},{"id":"manas-2010:p1622:b001:l042","ordinal":69876,"en":"Seventy Beijings were stirred."},{"id":"manas-2010:p1623:b001:l001","ordinal":69877,"en":"Of the Chinese with rank-buttons,"},{"id":"manas-2010:p1623:b001:l002","ordinal":69878,"en":"The finest separated and swept forward."},{"id":"manas-2010:p1623:b001:l003","ordinal":69879,"en":"Of the jacket-wearing Chinese,"},{"id":"manas-2010:p1623:b001:l004","ordinal":69880,"en":"The strongest came into view."},{"id":"manas-2010:p1623:b001:l005","ordinal":69881,"en":"Kün Zhang-Zhung and Kongurbay"},{"id":"manas-2010:p1623:b001:l006","ordinal":69882,"en":"Came forward apart for single combat."},{"id":"manas-2010:p1623:b001:l007","ordinal":69883,"en":"Alöökö's Kongurbay,"},{"id":"manas-2010:p1623:b001:l008","ordinal":69884,"en":"This surpassing warrior,"},{"id":"manas-2010:p1623:b001:l009","ordinal":69885,"en":"Loomed like a mighty mountain."},{"id":"manas-2010:p1623:b001:l010","ordinal":69886,"en":"Venom poured from his mouth,"},{"id":"manas-2010:p1623:b001:l011","ordinal":69887,"en":"Dust rose wherever he moved,"},{"id":"manas-2010:p1623:b001:l012","ordinal":69888,"en":"His voice drove life from men."}]
