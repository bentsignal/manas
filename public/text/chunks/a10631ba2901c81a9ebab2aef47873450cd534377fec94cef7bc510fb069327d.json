[{"id":"semetey-2-2013:p1359:b003:l027","ordinal":290305,"en":"Watched with all her eyes."},{"id":"semetey-2-2013:p1359:b003:l028","ordinal":290306,"en":"Kyyaz of the Jediger,"},{"id":"semetey-2-2013:p1359:b003:l029","ordinal":290307,"en":"Your sister-in-law stood watching."},{"id":"semetey-2-2013:p1359:b003:l030","ordinal":290308,"en":"Without drawing near that sorceress,"},{"id":"semetey-2-2013:p1359:b003:l031","ordinal":290309,"en":"Brave Kyyaz stood apart."},{"id":"semetey-2-2013:p1359:b003:l032","ordinal":290310,"en":"He could not approach the raging woman,"},{"id":"semetey-2-2013:p1359:b003:l033","ordinal":290311,"en":"Could not endure her cold,"},{"id":"semetey-2-2013:p1359:b003:l034","ordinal":290312,"en":"Could not lie down in her heat;"},{"id":"semetey-2-2013:p1359:b003:l035","ordinal":290313,"en":"At the disposition of that fairy-born woman"},{"id":"semetey-2-2013:p1359:b003:l036","ordinal":290314,"en":"He stood astonished."},{"id":"semetey-2-2013:p1359:b003:l037","ordinal":290315,"en":"To the sly, alluring beauty"},{"id":"semetey-2-2013:p1359:b003:l038","ordinal":290316,"en":"He could not cast his cold noose;"},{"id":"semetey-2-2013:p1359:b003:l039","ordinal":290317,"en":"He could not face and seize"},{"id":"semetey-2-2013:p1359:b004:l001","ordinal":290318,"en":"The beautiful woman Chürök."},{"id":"semetey-2-2013:p1359:b004:l002","ordinal":290319,"en":"He could not draw near the brow"},{"id":"semetey-2-2013:p1359:b004:l003","ordinal":290320,"en":"Of the bitch he had never desired."},{"id":"semetey-2-2013:p1359:b004:l004","ordinal":290321,"en":"Brave Kyyaz of the Jediger,"},{"id":"semetey-2-2013:p1359:b004:l005","ordinal":290322,"en":"When he saw Aichürök,"},{"id":"semetey-2-2013:p1359:b004:l006","ordinal":290323,"en":"Took in the grace of her form"},{"id":"semetey-2-2013:p1359:b004:l007","ordinal":290324,"en":"And marveled at her beauty."},{"id":"semetey-2-2013:p1359:b004:l008","ordinal":290325,"en":"Moonlike Aichürök"},{"id":"semetey-2-2013:p1359:b004:l009","ordinal":290326,"en":"Was no ordinary mortal."},{"id":"semetey-2-2013:p1359:b004:l010","ordinal":290327,"en":"Because of what had happened before,"},{"id":"semetey-2-2013:p1359:b004:l011","ordinal":290328,"en":"Because of Aichürök,"},{"id":"semetey-2-2013:p1359:b004:l012","ordinal":290329,"en":"The gathered people had quarreled;"},{"id":"semetey-2-2013:p1359:b004:l013","ordinal":290330,"en":"It seemed fitting that they should perish."},{"id":"semetey-2-2013:p1359:b004:l014","ordinal":290331,"en":"She was beauty in perfect form,"},{"id":"semetey-2-2013:p1359:b004:l015","ordinal":290332,"en":"The very one to inspire longing,"},{"id":"semetey-2-2013:p1359:b004:l016","ordinal":290333,"en":"A soul surpassing humankind;"},{"id":"semetey-2-2013:p1359:b004:l017","ordinal":290334,"en":"Chynkojo and Toltoy both had died"},{"id":"semetey-2-2013:p1359:b004:l018","ordinal":290335,"en":"While contending for her."},{"id":"semetey-2-2013:p1359:b004:l019","ordinal":290336,"en":"As a wife she had divided nations;"},{"id":"semetey-2-2013:p1359:b004:l020","ordinal":290337,"en":"As a maiden, this Chürök"},{"id":"semetey-2-2013:p1359:b004:l021","ordinal":290338,"en":"Had shaken custom and divided peoples."},{"id":"semetey-2-2013:p1359:b004:l022","ordinal":290339,"en":"She was a being radiant as the sun,"},{"id":"semetey-2-2013:p1359:b004:l023","ordinal":290340,"en":"Who set the world at strife"},{"id":"semetey-2-2013:p1359:b004:l024","ordinal":290341,"en":"And made slaughter seem ordained."},{"id":"semetey-2-2013:p1359:b004:l025","ordinal":290342,"en":"She was the very firebrand,"},{"id":"semetey-2-2013:p1359:b004:l026","ordinal":290343,"en":"Aichürök, for whom men died,"},{"id":"semetey-2-2013:p1359:b004:l027","ordinal":290344,"en":"With deep black eyes."},{"id":"semetey-2-2013:p1359:b004:l028","ordinal":290345,"en":"To keep calling Chürök merely “Chürök”"},{"id":"semetey-2-2013:p1359:b004:l029","ordinal":290346,"en":"Was a God-stricken saying."},{"id":"semetey-2-2013:p1359:b004:l030","ordinal":290347,"en":"She was Chürök who could enter"},{"id":"semetey-2-2013:p1359:b004:l031","ordinal":290348,"en":"Great revels and games!"},{"id":"semetey-2-2013:p1359:b004:l032","ordinal":290349,"en":"She was Chürök who could lie"},{"id":"semetey-2-2013:p1359:b004:l033","ordinal":290350,"en":"And converse in a narrow bed!"},{"id":"semetey-2-2013:p1359:b004:l034","ordinal":290351,"en":"She was Chürök who could preside"},{"id":"semetey-2-2013:p1359:b004:l035","ordinal":290352,"en":"Over pure play and mighty passion!"},{"id":"semetey-2-2013:p1359:b004:l036","ordinal":290353,"en":"She was Chürök who could satisfy"},{"id":"semetey-2-2013:p1359:b004:l037","ordinal":290354,"en":"The desire of the man who possessed her!"},{"id":"semetey-2-2013:p1359:b004:l038","ordinal":290355,"en":"Meeting face to face as allies,"},{"id":"semetey-2-2013:p1359:b004:l039","ordinal":290356,"en":"Eating meat from a single cauldron,"},{"id":"semetey-2-2013:p1360:b003:l001","ordinal":290357,"en":"Settling freely along the place of honor,"},{"id":"semetey-2-2013:p1360:b003:l002","ordinal":290358,"en":"Living together as husband and wife,"},{"id":"semetey-2-2013:p1360:b003:l003","ordinal":290359,"en":"She was Chürök whose every manner"},{"id":"semetey-2-2013:p1360:b003:l004","ordinal":290360,"en":"Surpassed all others in the world;"},{"id":"semetey-2-2013:p1360:b003:l005","ordinal":290361,"en":"Chürök whom a man would love"},{"id":"semetey-2-2013:p1360:b003:l006","ordinal":290362,"en":"And draw against his breast;"},{"id":"semetey-2-2013:p1360:b003:l007","ordinal":290363,"en":"Chürök who would enter"},{"id":"semetey-2-2013:p1360:b003:l008","ordinal":290364,"en":"Countless delightful games;"},{"id":"semetey-2-2013:p1360:b003:l009","ordinal":290365,"en":"Chürök who could cure"},{"id":"semetey-2-2013:p1360:b003:l010","ordinal":290366,"en":"Ancient grief and great affliction;"},{"id":"semetey-2-2013:p1360:b003:l011","ordinal":290367,"en":"Chürök who should not go as spoil"},{"id":"semetey-2-2013:p1360:b003:l012","ordinal":290368,"en":"Into a broad foreign palace;"},{"id":"semetey-2-2013:p1360:b003:l013","ordinal":290369,"en":"Chürök who should not be placed"},{"id":"semetey-2-2013:p1360:b003:l014","ordinal":290370,"en":"At anyone’s unrestricted disposal;"},{"id":"semetey-2-2013:p1360:b003:l015","ordinal":290371,"en":"Meeting face to face through one gate,"},{"id":"semetey-2-2013:p1360:b003:l016","ordinal":290372,"en":"Eating meat from one platter,"},{"id":"semetey-2-2013:p1360:b003:l017","ordinal":290373,"en":"She was Chürök who could enter"},{"id":"semetey-2-2013:p1360:b003:l018","ordinal":290374,"en":"The deepest pleasures and games;"},{"id":"semetey-2-2013:p1360:b003:l019","ordinal":290375,"en":"Would Chürök not lie with"},{"id":"semetey-2-2013:p1360:b003:l020","ordinal":290376,"en":"The poor man who swayed toward her,"},{"id":"semetey-2-2013:p1360:b003:l021","ordinal":290377,"en":"And satisfy his first longing?"},{"id":"semetey-2-2013:p1360:b003:l022","ordinal":290378,"en":"To that sidelong-glancing beauty,"},{"id":"semetey-2-2013:p1360:b003:l023","ordinal":290379,"en":"Ah, to that quivering creature,"},{"id":"semetey-2-2013:p1360:b003:l024","ordinal":290380,"en":"Would Chürök not place into his hands"},{"id":"semetey-2-2013:p1360:b003:l025","ordinal":290381,"en":"Everything he asked of her?"},{"id":"semetey-2-2013:p1360:b003:l026","ordinal":290382,"en":"Would Chürök refuse to consent"},{"id":"semetey-2-2013:p1360:b003:l027","ordinal":290383,"en":"And submit to what he said?"},{"id":"semetey-2-2013:p1360:b003:l028","ordinal":290384,"en":"If I do not spend my strength"},{"id":"semetey-2-2013:p1360:b003:l029","ordinal":290385,"en":"For matchless Chürök,"},{"id":"semetey-2-2013:p1360:b003:l030","ordinal":290386,"en":"If I do not scatter my gathered herds,"},{"id":"semetey-2-2013:p1360:b003:l031","ordinal":290387,"en":"If I do not spend beyond livestock,"},{"id":"semetey-2-2013:p1360:b003:l032","ordinal":290388,"en":"Sending men through many cities,"},{"id":"semetey-2-2013:p1360:b003:l033","ordinal":290389,"en":"If I do not open the treasury,"},{"id":"semetey-2-2013:p1360:b003:l034","ordinal":290390,"en":"And lavish upon Chürök"},{"id":"semetey-2-2013:p1360:b003:l035","ordinal":290391,"en":"All the wealth I have found and amassed,"},{"id":"semetey-2-2013:p1360:b003:l036","ordinal":290392,"en":"Scattering countless riches!"},{"id":"semetey-2-2013:p1360:b003:l037","ordinal":290393,"en":"For beautiful Chürök to enter,"},{"id":"semetey-2-2013:p1360:b003:l038","ordinal":290394,"en":"If I do not commission a palace,"},{"id":"semetey-2-2013:p1360:b003:l039","ordinal":290395,"en":"Commissioned with a golden roof-ring and copper ropes;"},{"id":"semetey-2-2013:p1360:b004:l001","ordinal":290396,"en":"If, upon that roof-ring,"},{"id":"semetey-2-2013:p1360:b004:l002","ordinal":290397,"en":"I do not have gold richly plated,"},{"id":"semetey-2-2013:p1360:b004:l003","ordinal":290398,"en":"Spending freely from"},{"id":"semetey-2-2013:p1360:b004:l004","ordinal":290399,"en":"The Jediger treasury;"},{"id":"semetey-2-2013:p1360:b004:l005","ordinal":290400,"en":"If I do not gladden the people with celebration,"},{"id":"semetey-2-2013:p1360:b004:l006","ordinal":290401,"en":"Making all the world proclaim,"},{"id":"semetey-2-2013:p1360:b004:l007","ordinal":290402,"en":"“Kyyaz has won Chürök,”"},{"id":"semetey-2-2013:p1360:b004:l008","ordinal":290403,"en":"And gather every living soul,"},{"id":"semetey-2-2013:p1360:b004:l009","ordinal":290404,"en":"Holding a feast for multitudes;"},{"id":"semetey-2-2013:p1360:b004:l010","ordinal":290405,"en":"If I do not make a wonder for the ages,"},{"id":"semetey-2-2013:p1360:b004:l011","ordinal":290406,"en":"As though taking a maiden in marriage;"},{"id":"semetey-2-2013:p1360:b004:l012","ordinal":290407,"en":"If I do not attend her like a chief wife,"},{"id":"semetey-2-2013:p1360:b004:l013","ordinal":290408,"en":"Begging her no fewer than forty times,"},{"id":"semetey-2-2013:p1360:b004:l014","ordinal":290409,"en":"Preparing to serve her"},{"id":"semetey-2-2013:p1360:b004:l015","ordinal":290410,"en":"And standing before her!"},{"id":"semetey-2-2013:p1360:b004:l016","ordinal":290411,"en":"Moonlike Aichürök,"},{"id":"semetey-2-2013:p1360:b004:l017","ordinal":290412,"en":"If I do not obey your words,"},{"id":"semetey-2-2013:p1360:b004:l018","ordinal":290413,"en":"Go wherever you direct me,"},{"id":"semetey-2-2013:p1360:b004:l019","ordinal":290414,"en":"Consent to what you say,"},{"id":"semetey-2-2013:p1360:b004:l020","ordinal":290415,"en":"And carry out your commands,"},{"id":"semetey-2-2013:p1360:b004:l021","ordinal":290416,"en":"May the hairy-breasted Earth strike me,"},{"id":"semetey-2-2013:p1360:b004:l022","ordinal":290417,"en":"May the overarching Sky strike me,"},{"id":"semetey-2-2013:p1360:b004:l023","ordinal":290418,"en":"May holy Ak strike me in disaster,"},{"id":"semetey-2-2013:p1360:b004:l024","ordinal":290419,"en":"May the spark of the white matchlock strike me,"},{"id":"semetey-2-2013:p1360:b004:l025","ordinal":290420,"en":"May the bullet of the white-barreled gun strike me!”"},{"id":"semetey-2-2013:p1360:b004:l026","ordinal":290421,"en":"Brave Kyyaz of the Jediger"},{"id":"semetey-2-2013:p1360:b004:l027","ordinal":290422,"en":"Stood there in distress."},{"id":"semetey-2-2013:p1360:b004:l028","ordinal":290423,"en":"Without approaching her, brave Kyyaz"},{"id":"semetey-2-2013:p1360:b004:l029","ordinal":290424,"en":"Stood pleading with Chürök."},{"id":"semetey-2-2013:p1360:b004:l030","ordinal":290425,"en":"Your mother, moonlike lady,"},{"id":"semetey-2-2013:p1360:b004:l031","ordinal":290426,"en":"See every outrage she commits:"},{"id":"semetey-2-2013:p1360:b004:l032","ordinal":290427,"en":"Her heart burning to embers,"},{"id":"semetey-2-2013:p1360:b004:l033","ordinal":290428,"en":"Her eyes staring without dying,"},{"id":"semetey-2-2013:p1360:b004:l034","ordinal":290429,"en":"Parted from the bloodthirsty lion,"},{"id":"semetey-2-2013:p1360:b004:l035","ordinal":290430,"en":"Her dear hair like willow silk,"},{"id":"semetey-2-2013:p1360:b004:l036","ordinal":290431,"en":"Her dear head cast onto the plain,"},{"id":"semetey-2-2013:p1360:b004:l037","ordinal":290432,"en":"Rather than suffer such disgrace,"},{"id":"semetey-2-2013:p1360:b004:l038","ordinal":290433,"en":"She wished to die before her appointed death,"},{"id":"semetey-2-2013:p1360:b004:l039","ordinal":290434,"en":"And see the true abode from which none return."},{"id":"semetey-2-2013:p1361:b003:l001","ordinal":290435,"en":"She wished to see her dear head there."},{"id":"semetey-2-2013:p1361:b003:l002","ordinal":290436,"en":"Her heart burning, her eyes blazing,"},{"id":"semetey-2-2013:p1361:b003:l003","ordinal":290437,"en":"The enraged Chürök"},{"id":"semetey-2-2013:p1361:b003:l004","ordinal":290438,"en":"Was truly seized by bloodlust."},{"id":"semetey-2-2013:p1361:b003:l005","ordinal":290439,"en":"She grieved, saying, “I shall die;"},{"id":"semetey-2-2013:p1361:b003:l006","ordinal":290440,"en":"Rather than become Kyyaz’s spoil,"},{"id":"semetey-2-2013:p1361:b003:l007","ordinal":290441,"en":"May I see my dear head"},{"id":"semetey-2-2013:p1361:b003:l008","ordinal":290442,"en":"In the true abode from which none return.”"},{"id":"semetey-2-2013:p1361:b003:l009","ordinal":290443,"en":"Aichürök’s heart was divided;"},{"id":"semetey-2-2013:p1361:b003:l010","ordinal":290444,"en":"Brave Kyyaz of the Jediger"},{"id":"semetey-2-2013:p1361:b003:l011","ordinal":290445,"en":"Appeared before Aichürök’s eyes"},{"id":"semetey-2-2013:p1361:b003:l012","ordinal":290446,"en":"Like a dragon."},{"id":"semetey-2-2013:p1361:b003:l013","ordinal":290447,"en":"“If slave Kyyaz comes near,"},{"id":"semetey-2-2013:p1361:b003:l014","ordinal":290448,"en":"I will draw my sword from its sheath"},{"id":"semetey-2-2013:p1361:b003:l015","ordinal":290449,"en":"And bring utter calamity"},{"id":"semetey-2-2013:p1361:b003:l016","ordinal":290450,"en":"Upon brave Kyyaz;"},{"id":"semetey-2-2013:p1361:b003:l017","ordinal":290451,"en":"I will cut short his age."},{"id":"semetey-2-2013:p1361:b003:l018","ordinal":290452,"en":"I will find a way to deal"},{"id":"semetey-2-2013:p1361:b003:l019","ordinal":290453,"en":"With this would-be hero Kyyaz;"},{"id":"semetey-2-2013:p1361:b003:l020","ordinal":290454,"en":"I will strike him with Zulpukor."},{"id":"semetey-2-2013:p1361:b003:l021","ordinal":290455,"en":"The sun of God darkened in heaven,"},{"id":"semetey-2-2013:p1361:b003:l022","ordinal":290456,"en":"And sixty cares at once"},{"id":"semetey-2-2013:p1361:b003:l023","ordinal":290457,"en":"Descended upon Aichürök’s head."},{"id":"semetey-2-2013:p1361:b003:l024","ordinal":290458,"en":"If Kyyaz draws near,"},{"id":"semetey-2-2013:p1361:b003:l025","ordinal":290459,"en":"If Kanchoro comes beside me,"},{"id":"semetey-2-2013:p1361:b003:l026","ordinal":290460,"en":"I will heap trouble upon them;"},{"id":"semetey-2-2013:p1361:b003:l027","ordinal":290461,"en":"Whichever one approaches,"},{"id":"semetey-2-2013:p1361:b003:l028","ordinal":290462,"en":"I will take his apple-like head"},{"id":"semetey-2-2013:p1361:b003:l029","ordinal":290463,"en":"And bring utter destruction"},{"id":"semetey-2-2013:p1361:b003:l030","ordinal":290464,"en":"Upon the two villains.”"},{"id":"semetey-2-2013:p1361:b003:l031","ordinal":290465,"en":"Aichürök stood thinking this:"},{"id":"semetey-2-2013:p1361:b003:l032","ordinal":290466,"en":"“Let me take delight in slaughter,"},{"id":"semetey-2-2013:p1361:b003:l033","ordinal":290467,"en":"Sparing no accursed soul;"},{"id":"semetey-2-2013:p1361:b003:l034","ordinal":290468,"en":"Let me sever someone’s head.”"},{"id":"semetey-2-2013:p1361:b003:l035","ordinal":290469,"en":"A capable maid with a man’s bearing,"},{"id":"semetey-2-2013:p1361:b003:l036","ordinal":290470,"en":"A maid who knew the enemy’s devices,"},{"id":"semetey-2-2013:p1361:b003:l037","ordinal":290471,"en":"A mighty maid,"},{"id":"semetey-2-2013:p1361:b003:l038","ordinal":290472,"en":"Who skimmed over the horse’s back,"},{"id":"semetey-2-2013:p1361:b003:l039","ordinal":290473,"en":"Who had flown and journeyed"},{"id":"semetey-2-2013:p1361:b005:l001","ordinal":290474,"en":"Across the whole wide world."},{"id":"semetey-2-2013:p1361:b005:l002","ordinal":290475,"en":"The mist dispersed from the sky;"},{"id":"semetey-2-2013:p1361:b005:l003","ordinal":290476,"en":"Taking the form of a man,"},{"id":"semetey-2-2013:p1361:b005:l004","ordinal":290477,"en":"She had observed all the giants,"},{"id":"semetey-2-2013:p1361:b005:l005","ordinal":290478,"en":"Young and old,"},{"id":"semetey-2-2013:p1361:b005:l006","ordinal":290479,"en":"Their warriors and lions,"},{"id":"semetey-2-2013:p1361:b005:l007","ordinal":290480,"en":"Their many kinds of men,"},{"id":"semetey-2-2013:p1361:b005:l008","ordinal":290481,"en":"Their rivers and lakes,"},{"id":"semetey-2-2013:p1361:b005:l009","ordinal":290482,"en":"And those whose fortunes were complete;"},{"id":"semetey-2-2013:p1361:b005:l010","ordinal":290483,"en":"Your sister-in-law had judged"},{"id":"semetey-2-2013:p1361:b005:l011","ordinal":290484,"en":"The black-hearted wretches"},{"id":"semetey-2-2013:p1361:b005:l012","ordinal":290485,"en":"Who fought women over the cauldron."},{"id":"semetey-2-2013:p1361:b005:l013","ordinal":290486,"en":"The accustomed fierce Aichürök,"},{"id":"semetey-2-2013:p1361:b005:l014","ordinal":290487,"en":"With a man’s bearing and fiery eyes—"},{"id":"semetey-2-2013:p1361:b005:l015","ordinal":290488,"en":"Keep far away if you see her form!"},{"id":"semetey-2-2013:p1361:b005:l016","ordinal":290489,"en":"Bloodlust seized her firmly;"},{"id":"semetey-2-2013:p1361:b005:l017","ordinal":290490,"en":"Her even teeth, like ruby stones,"},{"id":"semetey-2-2013:p1361:b005:l018","ordinal":290491,"en":"Teeth unlike those of other women,"},{"id":"semetey-2-2013:p1361:b005:l019","ordinal":290492,"en":"She ground with a loud crunch."},{"id":"semetey-2-2013:p1361:b005:l020","ordinal":290493,"en":"Her eyes blazed in torment;"},{"id":"semetey-2-2013:p1361:b005:l021","ordinal":290494,"en":"She writhed like a white snake"},{"id":"semetey-2-2013:p1361:b005:l022","ordinal":290495,"en":"And gathered herself like a lion."},{"id":"semetey-2-2013:p1361:b005:l023","ordinal":290496,"en":"The blood left her face pale;"},{"id":"semetey-2-2013:p1361:b005:l024","ordinal":290497,"en":"Her eyes reddened like a wolf’s."},{"id":"semetey-2-2013:p1361:b005:l025","ordinal":290498,"en":"Her dear hair, thick as a hillock,"},{"id":"semetey-2-2013:p1361:b005:l026","ordinal":290499,"en":"Streamed down across her breast."},{"id":"semetey-2-2013:p1361:b005:l027","ordinal":290500,"en":"The Jediger were a host, she was alone,"},{"id":"semetey-2-2013:p1361:b005:l028","ordinal":290501,"en":"Yet she did not look around,"},{"id":"semetey-2-2013:p1361:b005:l029","ordinal":290502,"en":"And spared no living soul."},{"id":"semetey-2-2013:p1361:b005:l030","ordinal":290503,"en":"Though the Jediger ringed her,"},{"id":"semetey-2-2013:p1361:b005:l031","ordinal":290504,"en":"She did not reckon that she would die;"},{"id":"semetey-2-2013:p1361:b005:l032","ordinal":290505,"en":"She did not look about her,"},{"id":"semetey-2-2013:p1361:b005:l033","ordinal":290506,"en":"Nor spare her thread-thin life,"},{"id":"semetey-2-2013:p1361:b005:l034","ordinal":290507,"en":"And counted the shouting Jediger"},{"id":"semetey-2-2013:p1361:b005:l035","ordinal":290508,"en":"As less than a settled people."},{"id":"semetey-2-2013:p1361:b005:l036","ordinal":290509,"en":"Her heart burned to embers;"},{"id":"semetey-2-2013:p1361:b005:l037","ordinal":290510,"en":"She flamed and blazed fiercely."},{"id":"semetey-2-2013:p1361:b005:l038","ordinal":290511,"en":"The guards who kept watch,"},{"id":"semetey-2-2013:p1361:b005:l039","ordinal":290512,"en":"The keepers at the gate-mouth,"},{"id":"semetey-2-2013:p1362:b003:l001","ordinal":290513,"en":"Those who stood beneath the banner—"},{"id":"semetey-2-2013:p1362:b003:l002","ordinal":290514,"en":"That luckless rabble"},{"id":"semetey-2-2013:p1362:b003:l003","ordinal":290515,"en":"Would be ground to powder."},{"id":"semetey-2-2013:p1362:b003:l004","ordinal":290516,"en":"Her heart burned, her breast was embers;"},{"id":"semetey-2-2013:p1362:b003:l005","ordinal":290517,"en":"Her apple-like head was in torment—"},{"id":"semetey-2-2013:p1362:b003:l006","ordinal":290518,"en":"No woman was ever so afflicted."},{"id":"semetey-2-2013:p1362:b003:l007","ordinal":290519,"en":"Grieving in sorrow,"},{"id":"semetey-2-2013:p1362:b003:l008","ordinal":290520,"en":"Parted together with her hero"},{"id":"semetey-2-2013:p1362:b003:l009","ordinal":290521,"en":"From Akjoltoy, who had been her support,"},{"id":"semetey-2-2013:p1362:b003:l010","ordinal":290522,"en":"Aichürök now remembered"},{"id":"semetey-2-2013:p1362:b003:l011","ordinal":290523,"en":"That God might strike her,"},{"id":"semetey-2-2013:p1362:b003:l012","ordinal":290524,"en":"That the Jediger would take her as spoil,"},{"id":"semetey-2-2013:p1362:b003:l013","ordinal":290525,"en":"And, if enraged, the Jediger"},{"id":"semetey-2-2013:p1362:b003:l014","ordinal":290526,"en":"Would cruelly take her life;"},{"id":"semetey-2-2013:p1362:b003:l015","ordinal":290527,"en":"Only then would your pale one rest,"},{"id":"semetey-2-2013:p1362:b003:l016","ordinal":290528,"en":"For they would show no mercy."},{"id":"semetey-2-2013:p1362:b003:l017","ordinal":290529,"en":"She bent her mind and formed a plan,"},{"id":"semetey-2-2013:p1362:b003:l018","ordinal":290530,"en":"Thinking Kyyaz and Kanchoro"},{"id":"semetey-2-2013:p1362:b003:l019","ordinal":290531,"en":"Might come within her reach."},{"id":"semetey-2-2013:p1362:b003:l020","ordinal":290532,"en":"The raging woman could not stand still."},{"id":"semetey-2-2013:p1362:b003:l021","ordinal":290533,"en":"When the enemy surrounded her,"},{"id":"semetey-2-2013:p1362:b003:l022","ordinal":290534,"en":"Her ribs seemed torn apart;"},{"id":"semetey-2-2013:p1362:b003:l023","ordinal":290535,"en":"Her mind broke loose from grief."},{"id":"semetey-2-2013:p1362:b003:l024","ordinal":290536,"en":"In anguish she could not stand,"},{"id":"semetey-2-2013:p1362:b003:l025","ordinal":290537,"en":"Yet could not take an innocent life."},{"id":"semetey-2-2013:p1362:b003:l026","ordinal":290538,"en":"Inside that palace"},{"id":"semetey-2-2013:p1362:b003:l027","ordinal":290539,"en":"Stood a grove of plane trees,"},{"id":"semetey-2-2013:p1362:b003:l028","ordinal":290540,"en":"And towering at its center,"},{"id":"semetey-2-2013:p1362:b003:l029","ordinal":290541,"en":"Plain as a camel ridden by a prince,"},{"id":"semetey-2-2013:p1362:b003:l030","ordinal":290542,"en":"Was a golden throne."},{"id":"semetey-2-2013:p1362:b003:l031","ordinal":290543,"en":"Beneath that throne hung"},{"id":"semetey-2-2013:p1362:b003:l032","ordinal":290544,"en":"Tassels made of jewels,"},{"id":"semetey-2-2013:p1362:b003:l033","ordinal":290545,"en":"Installed in splendor"},{"id":"semetey-2-2013:p1362:b003:l034","ordinal":290546,"en":"For the bloodthirsty lion."},{"id":"semetey-2-2013:p1362:b003:l035","ordinal":290547,"en":"Before the throne lay a great carpet,"},{"id":"semetey-2-2013:p1362:b003:l036","ordinal":290548,"en":"Its border like a camel-load."},{"id":"semetey-2-2013:p1362:b003:l037","ordinal":290549,"en":"If you sat and studied its meaning,"},{"id":"semetey-2-2013:p1362:b003:l038","ordinal":290550,"en":"It seemed the very image of fortune;"},{"id":"semetey-2-2013:p1362:b003:l039","ordinal":290551,"en":"Its warp was yellow gold,"},{"id":"semetey-2-2013:p1362:b004:l001","ordinal":290552,"en":"Its patterns countless as the palate’s fancies."},{"id":"semetey-2-2013:p1362:b004:l002","ordinal":290553,"en":"So much beaten gold was poured"},{"id":"semetey-2-2013:p1362:b004:l003","ordinal":290554,"en":"Into the making of that carpet"},{"id":"semetey-2-2013:p1362:b004:l004","ordinal":290555,"en":"That the bloodthirsty hero’s treasury"},{"id":"semetey-2-2013:p1362:b004:l005","ordinal":290556,"en":"Was greatly diminished."},{"id":"semetey-2-2013:p1362:b004:l006","ordinal":290557,"en":"For many years it did not stir;"},{"id":"semetey-2-2013:p1362:b004:l007","ordinal":290558,"en":"Its edges neither rotted nor softened,"},{"id":"semetey-2-2013:p1362:b004:l008","ordinal":290559,"en":"For it was meant to lie before the throne."},{"id":"semetey-2-2013:p1362:b004:l009","ordinal":290560,"en":"Silk-edged, with golden ties,"}]
