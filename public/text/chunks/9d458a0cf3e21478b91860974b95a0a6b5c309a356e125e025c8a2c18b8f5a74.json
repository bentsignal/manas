[{"id":"seytek-2012:p0880:b003:l029","ordinal":363009,"en":"Broad-chested and wide-breasted,"},{"id":"seytek-2012:p0880:b003:l030","ordinal":363010,"en":"The doomed hero stood imposing,"},{"id":"seytek-2012:p0880:b003:l031","ordinal":363011,"en":"Both a champion and a lion;"},{"id":"seytek-2012:p0880:b003:l032","ordinal":363012,"en":"Such was he when setting out on that long road,"},{"id":"seytek-2012:p0880:b003:l033","ordinal":363013,"en":"Like one who had suffered bitter torment,"},{"id":"seytek-2012:p0880:b003:l034","ordinal":363014,"en":"Like a champion entering the field."},{"id":"seytek-2012:p0880:b003:l035","ordinal":363015,"en":"God Almighty in His power"},{"id":"seytek-2012:p0880:b003:l036","ordinal":363016,"en":"Creates living souls in every kind."},{"id":"seytek-2012:p0880:b003:l037","ordinal":363017,"en":"As the youth sat mounted,"},{"id":"seytek-2012:p0880:b003:l038","ordinal":363018,"en":"The memory stirred his heart:"},{"id":"seytek-2012:p0880:b003:l039","ordinal":363019,"en":"“Urge your Akkula onward;"},{"id":"seytek-2012:p0880:b003:l040","ordinal":363020,"en":"Now charge, my son!”"},{"id":"seytek-2012:p0881:b002:l001","ordinal":363021,"en":"“Where is your heroic courage?”"},{"id":"seytek-2012:p0881:b002:l002","ordinal":363022,"en":"“Drive your steel-tipped spear"},{"id":"seytek-2012:p0881:b002:l003","ordinal":363023,"en":"Into the very heart"},{"id":"seytek-2012:p0881:b002:l004","ordinal":363024,"en":"Of the swine confronting you!"},{"id":"seytek-2012:p0881:b002:l005","ordinal":363025,"en":"This is the hour to show your courage!”"},{"id":"seytek-2012:p0881:b002:l006","ordinal":363026,"en":"He had mounted Akkula;"},{"id":"seytek-2012:p0881:b002:l007","ordinal":363027,"en":"The gray-maned lion, warrior Manas,"},{"id":"seytek-2012:p0881:b002:l008","ordinal":363028,"en":"Rode beside him as his companion."},{"id":"seytek-2012:p0881:b002:l009","ordinal":363029,"en":"Seytek, lion of the bloodthirsty hero,"},{"id":"seytek-2012:p0881:b002:l010","ordinal":363030,"en":"Seytek, whose fortune was complete,"},{"id":"seytek-2012:p0881:b002:l011","ordinal":363031,"en":"Dark blue as the sea itself,"},{"id":"seytek-2012:p0881:b002:l012","ordinal":363032,"en":"Rode toward the clash,"},{"id":"seytek-2012:p0881:b002:l013","ordinal":363033,"en":"Having received the great host’s blessing."},{"id":"seytek-2012:p0881:b002:l014","ordinal":363034,"en":"O almighty Creator,"},{"id":"seytek-2012:p0881:b002:l015","ordinal":363035,"en":"The cherished young boy"},{"id":"seytek-2012:p0881:b002:l016","ordinal":363036,"en":"Was riding away to battle;"},{"id":"seytek-2012:p0881:b002:l017","ordinal":363037,"en":"The sole hero granted as a gift"},{"id":"seytek-2012:p0881:b002:l018","ordinal":363038,"en":"Was riding away to the fray;"},{"id":"seytek-2012:p0881:b002:l019","ordinal":363039,"en":"He was going forth to face"},{"id":"seytek-2012:p0881:b002:l020","ordinal":363040,"en":"Evil and affliction."},{"id":"seytek-2012:p0881:b002:l021","ordinal":363041,"en":"“Creator, sustain him Yourself;"},{"id":"seytek-2012:p0881:b002:l022","ordinal":363042,"en":"Almighty Creator, prosper him;"},{"id":"seytek-2012:p0881:b002:l023","ordinal":363043,"en":"When the people behold the boy,"},{"id":"seytek-2012:p0881:b002:l024","ordinal":363044,"en":"May God prosper his deed.”"},{"id":"seytek-2012:p0881:b002:l025","ordinal":363045,"en":"As the boy rode against the enemy,"},{"id":"seytek-2012:p0881:b002:l026","ordinal":363046,"en":"The people wailed and wept,"},{"id":"seytek-2012:p0881:b002:l027","ordinal":363047,"en":"Crying, “Protect, we pray, this boy,"},{"id":"seytek-2012:p0881:b002:l028","ordinal":363048,"en":"Small as a crow!”"},{"id":"seytek-2012:p0881:b002:l029","ordinal":363049,"en":"The broad Chatkal of rugged hills"},{"id":"seytek-2012:p0881:b002:l030","ordinal":363050,"en":"Was no mountain to cross without heed;"},{"id":"seytek-2012:p0881:b002:l031","ordinal":363051,"en":"Sarybai, oppressor of the age,"},{"id":"seytek-2012:p0881:b002:l032","ordinal":363052,"en":"Was no foe for a hero to trust lightly."},{"id":"seytek-2012:p0881:b002:l033","ordinal":363053,"en":"His champion’s might was well known,"},{"id":"seytek-2012:p0881:b002:l034","ordinal":363054,"en":"Yet the boy rode straight against him,"},{"id":"seytek-2012:p0881:b002:l035","ordinal":363055,"en":"Going to the place of cruel calamity"},{"id":"seytek-2012:p0881:b002:l036","ordinal":363056,"en":"And mighty strife."},{"id":"seytek-2012:p0881:b002:l037","ordinal":363057,"en":"With matchless courage and potent wrath,"},{"id":"seytek-2012:p0881:b002:l038","ordinal":363058,"en":"He rode against the mighty warrior."},{"id":"seytek-2012:p0881:b002:l039","ordinal":363059,"en":"When the crow-sized boy set forth,"},{"id":"seytek-2012:p0881:b002:l040","ordinal":363060,"en":"The people wailed and wept,"},{"id":"seytek-2012:p0881:b004:l001","ordinal":363061,"en":"Their souls tormented by grief,"},{"id":"seytek-2012:p0881:b004:l002","ordinal":363062,"en":"Their hearts distracted by care."},{"id":"seytek-2012:p0881:b004:l003","ordinal":363063,"en":"Behold the warrior Seytek:"},{"id":"seytek-2012:p0881:b004:l004","ordinal":363064,"en":"He stood apart beyond all the world,"},{"id":"seytek-2012:p0881:b004:l005","ordinal":363065,"en":"Trained beyond all the world;"},{"id":"seytek-2012:p0881:b004:l006","ordinal":363066,"en":"He rode forth like a lion."},{"id":"seytek-2012:p0881:b004:l007","ordinal":363067,"en":"Seizing the black-thonged whip,"},{"id":"seytek-2012:p0881:b004:l008","ordinal":363068,"en":"He swung it around,"},{"id":"seytek-2012:p0881:b004:l009","ordinal":363069,"en":"And struck Kunansur’s flank"},{"id":"seytek-2012:p0881:b004:l010","ordinal":363070,"en":"So that it rang aloud."},{"id":"seytek-2012:p0881:b004:l011","ordinal":363071,"en":"Kulansur turned his neck."},{"id":"seytek-2012:p0881:b004:l012","ordinal":363072,"en":"With a steel shaft and keen point,"},{"id":"seytek-2012:p0881:b004:l013","ordinal":363073,"en":"The socketed enchanted spear"},{"id":"seytek-2012:p0881:b004:l014","ordinal":363074,"en":"Was leveled at Sarybai, who had come to single combat,"},{"id":"seytek-2012:p0881:b004:l015","ordinal":363075,"en":"And now thrust toward the sky."},{"id":"seytek-2012:p0881:b004:l016","ordinal":363076,"en":"He roared as he faced the foe,"},{"id":"seytek-2012:p0881:b004:l017","ordinal":363077,"en":"Raising the battle cry of “Manas!”"},{"id":"seytek-2012:p0881:b004:l018","ordinal":363078,"en":"As he charged the enemy,"},{"id":"seytek-2012:p0881:b004:l019","ordinal":363079,"en":"The fearsome youth"},{"id":"seytek-2012:p0881:b004:l020","ordinal":363080,"en":"Showed the aspect of a tiger."},{"id":"seytek-2012:p0881:b004:l021","ordinal":363081,"en":"When he came face-to-face with Sarybai,"},{"id":"seytek-2012:p0881:b004:l022","ordinal":363082,"en":"With a piercing cry and shrill battle shout"},{"id":"seytek-2012:p0881:b004:l023","ordinal":363083,"en":"The hero launched his charge."},{"id":"seytek-2012:p0881:b004:l024","ordinal":363084,"en":"At one glance he seemed one man,"},{"id":"seytek-2012:p0881:b004:l025","ordinal":363085,"en":"At another, a thousand men;"},{"id":"seytek-2012:p0881:b004:l026","ordinal":363086,"en":"At one glance, a radiant chosen steed;"},{"id":"seytek-2012:p0881:b004:l027","ordinal":363087,"en":"His terrible majesty stood apart."},{"id":"seytek-2012:p0881:b004:l028","ordinal":363088,"en":"At another glance, behind the mighty warrior,"},{"id":"seytek-2012:p0881:b004:l029","ordinal":363089,"en":"A dark-maned black leopard,"},{"id":"seytek-2012:p0881:b004:l030","ordinal":363090,"en":"The spirit of Khan Manas,"},{"id":"seytek-2012:p0881:b004:l031","ordinal":363091,"en":"Could be seen."},{"id":"seytek-2012:p0881:b004:l032","ordinal":363092,"en":"It had come to ride beside him;"},{"id":"seytek-2012:p0881:b004:l033","ordinal":363093,"en":"The Forty Holy Ones and Khizr Ilyas"},{"id":"seytek-2012:p0881:b004:l034","ordinal":363094,"en":"Had become his companions."},{"id":"seytek-2012:p0881:b004:l035","ordinal":363095,"en":"Abiding beneath blessed fortune,"},{"id":"seytek-2012:p0881:b004:l036","ordinal":363096,"en":"They charged in ranks of forty."},{"id":"seytek-2012:p0881:b004:l037","ordinal":363097,"en":"Against that infidel Sarybai"},{"id":"seytek-2012:p0881:b004:l038","ordinal":363098,"en":"He charged and thrust his spear."},{"id":"seytek-2012:p0881:b004:l039","ordinal":363099,"en":"When Seytek bore down upon him,"},{"id":"seytek-2012:p0881:b004:l040","ordinal":363100,"en":"The infidel’s fury redoubled—"},{"id":"seytek-2012:p0882:b002:l001","ordinal":363101,"en":"Your warrior Sarybai,"},{"id":"seytek-2012:p0882:b002:l002","ordinal":363102,"en":"The boar who devastated the nation,"},{"id":"seytek-2012:p0882:b002:l003","ordinal":363103,"en":"The villain long accustomed"},{"id":"seytek-2012:p0882:b002:l004","ordinal":363104,"en":"To drinking blood,"},{"id":"seytek-2012:p0882:b002:l005","ordinal":363105,"en":"Who had waged war for many years,"},{"id":"seytek-2012:p0882:b002:l006","ordinal":363106,"en":"Dominated the whole age,"},{"id":"seytek-2012:p0882:b002:l007","ordinal":363107,"en":"Gnawed down all he encountered,"},{"id":"seytek-2012:p0882:b002:l008","ordinal":363108,"en":"And, hardened by bloodshed,"},{"id":"seytek-2012:p0882:b002:l009","ordinal":363109,"en":"Had become renowned as a bloodthirsty killer."},{"id":"seytek-2012:p0882:b002:l010","ordinal":363110,"en":"When Seytek leveled his spear,"},{"id":"seytek-2012:p0882:b002:l011","ordinal":363111,"en":"And drew near"},{"id":"seytek-2012:p0882:b002:l012","ordinal":363112,"en":"To the field of combat,"},{"id":"seytek-2012:p0882:b002:l013","ordinal":363113,"en":"“Look, the boy they rely upon"},{"id":"seytek-2012:p0882:b002:l014","ordinal":363114,"en":"Has come out to fight!"},{"id":"seytek-2012:p0882:b002:l015","ordinal":363115,"en":"Now I shall settle the account"},{"id":"seytek-2012:p0882:b002:l016","ordinal":363116,"en":"Of this ill-fated boy"},{"id":"seytek-2012:p0882:b002:l017","ordinal":363117,"en":"And beat out his ancient madness."},{"id":"seytek-2012:p0882:b002:l018","ordinal":363118,"en":"Before he reaches maturity,"},{"id":"seytek-2012:p0882:b002:l019","ordinal":363119,"en":"Before his coming day can dawn,"},{"id":"seytek-2012:p0882:b002:l020","ordinal":363120,"en":"I shall finish him altogether."},{"id":"seytek-2012:p0882:b002:l021","ordinal":363121,"en":"I shall see the full courage"},{"id":"seytek-2012:p0882:b002:l022","ordinal":363122,"en":"Of this boy who boasts of strength,"},{"id":"seytek-2012:p0882:b002:l023","ordinal":363123,"en":"And carefully spill his blood."},{"id":"seytek-2012:p0882:b002:l024","ordinal":363124,"en":"I shall curb his imperious rage"},{"id":"seytek-2012:p0882:b002:l025","ordinal":363125,"en":"And quench him like a dying fire."},{"id":"seytek-2012:p0882:b002:l026","ordinal":363126,"en":"Ravening as I wreak havoc,"},{"id":"seytek-2012:p0882:b002:l027","ordinal":363127,"en":"I shall crush whoever assails me;"},{"id":"seytek-2012:p0882:b002:l028","ordinal":363128,"en":"I shall leave none around me alive,"},{"id":"seytek-2012:p0882:b002:l029","ordinal":363129,"en":"And seize him by both skirts."},{"id":"seytek-2012:p0882:b002:l030","ordinal":363130,"en":"You wretch who boasts of courage and lionhood,"},{"id":"seytek-2012:p0882:b002:l031","ordinal":363131,"en":"Who boasts of strength,"},{"id":"seytek-2012:p0882:b002:l032","ordinal":363132,"en":"I shall put an end to you indeed."},{"id":"seytek-2012:p0882:b002:l033","ordinal":363133,"en":"I shall unleash upon this boy"},{"id":"seytek-2012:p0882:b002:l034","ordinal":363134,"en":"My fierce courage and surpassing fury."},{"id":"seytek-2012:p0882:b002:l035","ordinal":363135,"en":"I shall overcome every ailing foe,"},{"id":"seytek-2012:p0882:b002:l036","ordinal":363136,"en":"Crush whoever encounters me,"},{"id":"seytek-2012:p0882:b002:l037","ordinal":363137,"en":"Bend down whoever confronts me,"},{"id":"seytek-2012:p0882:b002:l038","ordinal":363138,"en":"And defeat whoever crosses me."},{"id":"seytek-2012:p0882:b002:l039","ordinal":363139,"en":"If I do not conquer their champions,"},{"id":"seytek-2012:p0882:b002:l040","ordinal":363140,"en":"If I do not swallow all who ride against me,"},{"id":"seytek-2012:p0882:b003:l001","ordinal":363141,"en":"Then before Sarybai can be called a mighty warrior,"},{"id":"seytek-2012:p0882:b003:l002","ordinal":363142,"en":"May I sink away unborn;"},{"id":"seytek-2012:p0882:b003:l003","ordinal":363143,"en":"May I die rather than live!”"},{"id":"seytek-2012:p0882:b003:l004","ordinal":363144,"en":"They stood opposed to one another,"},{"id":"seytek-2012:p0882:b003:l005","ordinal":363145,"en":"And Sarybai, enraged,"},{"id":"seytek-2012:p0882:b003:l006","ordinal":363146,"en":"Roared and leveled his spear."},{"id":"seytek-2012:p0882:b003:l007","ordinal":363147,"en":"At the boy, that wolf of war,"},{"id":"seytek-2012:p0882:b003:l008","ordinal":363148,"en":"He thrust his steel-shafted enchanted spear,"},{"id":"seytek-2012:p0882:b003:l009","ordinal":363149,"en":"Aiming it at his liver."},{"id":"seytek-2012:p0882:b003:l010","ordinal":363150,"en":"A renowned master among spearmen,"},{"id":"seytek-2012:p0882:b003:l011","ordinal":363151,"en":"A consummate master of cunning,"},{"id":"seytek-2012:p0882:b003:l012","ordinal":363152,"en":"He had faced heroes in many lands"},{"id":"seytek-2012:p0882:b003:l013","ordinal":363153,"en":"And met countless disasters as an equal."},{"id":"seytek-2012:p0882:b003:l014","ordinal":363154,"en":"The cunning dog knew well how to thrust a spear;"},{"id":"seytek-2012:p0882:b003:l015","ordinal":363155,"en":"Though the whole world surrounded him, none had defeated him,"},{"id":"seytek-2012:p0882:b003:l016","ordinal":363156,"en":"And he was a master of stratagems."},{"id":"seytek-2012:p0882:b003:l017","ordinal":363157,"en":"When Sarybai thrust his spear,"},{"id":"seytek-2012:p0882:b003:l018","ordinal":363158,"en":"He gathered all his strength."},{"id":"seytek-2012:p0882:b003:l019","ordinal":363159,"en":"When he thunderously drove the spear"},{"id":"seytek-2012:p0882:b003:l020","ordinal":363160,"en":"At the mighty gray-maned Seytek,"},{"id":"seytek-2012:p0882:b003:l021","ordinal":363161,"en":"As the spear came for his blood,"},{"id":"seytek-2012:p0882:b003:l022","ordinal":363162,"en":"And was about to strike its mark,"},{"id":"seytek-2012:p0882:b003:l023","ordinal":363163,"en":"The spirit-steed Kulansur"},{"id":"seytek-2012:p0882:b003:l024","ordinal":363164,"en":"Flickered aside like a hare"},{"id":"seytek-2012:p0882:b003:l025","ordinal":363165,"en":"And darted away like a wild ass."},{"id":"seytek-2012:p0882:b003:l026","ordinal":363166,"en":"The arrow-swift, accursed racer"},{"id":"seytek-2012:p0882:b003:l027","ordinal":363167,"en":"Would not let the spear reach him;"},{"id":"seytek-2012:p0882:b003:l028","ordinal":363168,"en":"No wind could match his gallop."},{"id":"seytek-2012:p0882:b003:l029","ordinal":363169,"en":"The blessed horse was like a spirit of the wind,"},{"id":"seytek-2012:p0882:b003:l030","ordinal":363170,"en":"And no beast could match his stride."},{"id":"seytek-2012:p0882:b003:l031","ordinal":363171,"en":"He flew whirring like an arrow,"},{"id":"seytek-2012:p0882:b003:l032","ordinal":363172,"en":"And surged like a flying cloud;"},{"id":"seytek-2012:p0882:b003:l033","ordinal":363173,"en":"A mighty clatter of stones and earth"},{"id":"seytek-2012:p0882:b003:l034","ordinal":363174,"en":"Whirled above his head."},{"id":"seytek-2012:p0882:b003:l035","ordinal":363175,"en":"He bounded as though shot from a bow,"},{"id":"seytek-2012:p0882:b003:l036","ordinal":363176,"en":"Soft-mouthed and perfectly responsive;"},{"id":"seytek-2012:p0882:b003:l037","ordinal":363177,"en":"When he turned, he darted aside,"},{"id":"seytek-2012:p0882:b003:l038","ordinal":363178,"en":"Before one could cry, “This way or that!”"},{"id":"seytek-2012:p0882:b003:l039","ordinal":363179,"en":"In the blink of an eye,"},{"id":"seytek-2012:p0882:b003:l040","ordinal":363180,"en":"Before one could say a word,"},{"id":"seytek-2012:p0883:b002:l001","ordinal":363181,"en":"Before he could turn Tookyzyl’s head,"},{"id":"seytek-2012:p0883:b002:l002","ordinal":363182,"en":"Before he could steady himself and thrust his spear,"},{"id":"seytek-2012:p0883:b002:l003","ordinal":363183,"en":"Brave Seytek, upheld by the spirits,"},{"id":"seytek-2012:p0883:b002:l004","ordinal":363184,"en":"Had already wheeled his horse around."},{"id":"seytek-2012:p0883:b002:l005","ordinal":363185,"en":"Before a word could be said,"},{"id":"seytek-2012:p0883:b002:l006","ordinal":363186,"en":"Before Tookyzyl could close his mouth,"},{"id":"seytek-2012:p0883:b002:l007","ordinal":363187,"en":"He wheeled about with a shout,"},{"id":"seytek-2012:p0883:b002:l008","ordinal":363188,"en":"Raising his battle cry,"},{"id":"seytek-2012:p0883:b002:l009","ordinal":363189,"en":"And before he could thrust at Seytek,"},{"id":"seytek-2012:p0883:b002:l010","ordinal":363190,"en":"The descendant of the leopard-lion,"},{"id":"seytek-2012:p0883:b002:l011","ordinal":363191,"en":"The dark-maned, dauntless lion,"},{"id":"seytek-2012:p0883:b002:l012","ordinal":363192,"en":"The hero of surpassing courage,"},{"id":"seytek-2012:p0883:b002:l013","ordinal":363193,"en":"Who had ridden into battle there,"},{"id":"seytek-2012:p0883:b002:l014","ordinal":363194,"en":"Against that mountain-sized villain,"},{"id":"seytek-2012:p0883:b002:l015","ordinal":363195,"en":"Against that warrior versed in every ruse,"},{"id":"seytek-2012:p0883:b002:l016","ordinal":363196,"en":"Against that snow-demonic infidel,"},{"id":"seytek-2012:p0883:b002:l017","ordinal":363197,"en":"Against that mighty, full-blooded champion,"},{"id":"seytek-2012:p0883:b002:l018","ordinal":363198,"en":"Who deemed himself a hero and a lion,"},{"id":"seytek-2012:p0883:b002:l019","ordinal":363199,"en":"Who vaunted himself before the whole world,"},{"id":"seytek-2012:p0883:b002:l020","ordinal":363200,"en":"The matchlessly nimble warrior,"},{"id":"seytek-2012:p0883:b002:l021","ordinal":363201,"en":"Turned Kulansur’s neck,"},{"id":"seytek-2012:p0883:b002:l022","ordinal":363202,"en":"And the spear inherited from his forefathers"},{"id":"seytek-2012:p0883:b002:l023","ordinal":363203,"en":"The heroic prince leveled."},{"id":"seytek-2012:p0883:b002:l024","ordinal":363204,"en":"Such was his valor,"},{"id":"seytek-2012:p0883:b002:l025","ordinal":363205,"en":"His forefather was a mighty, peerless lion,"},{"id":"seytek-2012:p0883:b002:l026","ordinal":363206,"en":"And there they met in combat."},{"id":"seytek-2012:p0883:b002:l027","ordinal":363207,"en":"At the monster-born warrior,"},{"id":"seytek-2012:p0883:b002:l028","ordinal":363208,"en":"At the infidel who smeared the earth,"},{"id":"seytek-2012:p0883:b002:l029","ordinal":363209,"en":"“The face of his belt,” he thought,"},{"id":"seytek-2012:p0883:b002:l030","ordinal":363210,"en":"“The edge of his right shoulder;"},{"id":"seytek-2012:p0883:b002:l031","ordinal":363211,"en":"If the tempered spear goes lower,"},{"id":"seytek-2012:p0883:b002:l032","ordinal":363212,"en":"The rim of his ribs;"},{"id":"seytek-2012:p0883:b002:l033","ordinal":363213,"en":"Here lies the crown of his heart,"},{"id":"seytek-2012:p0883:b002:l034","ordinal":363214,"en":"His lungs, heart, and windpipe;"},{"id":"seytek-2012:p0883:b002:l035","ordinal":363215,"en":"If the tempered spear strikes true,"},{"id":"seytek-2012:p0883:b002:l036","ordinal":363216,"en":"The very core of his heart—"},{"id":"seytek-2012:p0883:b002:l037","ordinal":363217,"en":"That is the measured mark;"},{"id":"seytek-2012:p0883:b002:l038","ordinal":363218,"en":"If God wills that it pass through,"},{"id":"seytek-2012:p0883:b002:l039","ordinal":363219,"en":"His hour of death has come.”"},{"id":"seytek-2012:p0883:b002:l040","ordinal":363220,"en":"Thus he stood, measuring the spot:"},{"id":"seytek-2012:p0883:b004:l001","ordinal":363221,"en":"“Support me, my sovereign father;"},{"id":"seytek-2012:p0883:b004:l002","ordinal":363222,"en":"Straighten whatever swerves,"},{"id":"seytek-2012:p0883:b004:l003","ordinal":363223,"en":"Guide it true as you desire.”"},{"id":"seytek-2012:p0883:b004:l004","ordinal":363224,"en":"Such was his consummate skill"},{"id":"seytek-2012:p0883:b004:l005","ordinal":363225,"en":"As he leveled the wrathful spear,"},{"id":"seytek-2012:p0883:b004:l006","ordinal":363226,"en":"Straining every sinew,"},{"id":"seytek-2012:p0883:b004:l007","ordinal":363227,"en":"Hardening himself in fury,"},{"id":"seytek-2012:p0883:b004:l008","ordinal":363228,"en":"His two strength-giving arms"},{"id":"seytek-2012:p0883:b004:l009","ordinal":363229,"en":"Gathering all their wondrous power,"},{"id":"seytek-2012:p0883:b004:l010","ordinal":363230,"en":"His lip bitten through,"},{"id":"seytek-2012:p0883:b004:l011","ordinal":363231,"en":"His waist bent and body braced,"},{"id":"seytek-2012:p0883:b004:l012","ordinal":363232,"en":"His rib bones creaking,"},{"id":"seytek-2012:p0883:b004:l013","ordinal":363233,"en":"His lion eyes flashing,"},{"id":"seytek-2012:p0883:b004:l014","ordinal":363234,"en":"Swooping like a hawk,"},{"id":"seytek-2012:p0883:b004:l015","ordinal":363235,"en":"And in that noble lion himself"},{"id":"seytek-2012:p0883:b004:l016","ordinal":363236,"en":"Unseen wisdom suddenly arose."},{"id":"seytek-2012:p0883:b004:l017","ordinal":363237,"en":"The breath from his mouth"},{"id":"seytek-2012:p0883:b004:l018","ordinal":363238,"en":"Hissed like a speeding bullet,"},{"id":"seytek-2012:p0883:b004:l019","ordinal":363239,"en":"And the white teeth beneath his brow"},{"id":"seytek-2012:p0883:b004:l020","ordinal":363240,"en":"Scattered like grains of millet."},{"id":"seytek-2012:p0883:b004:l021","ordinal":363241,"en":"The deft lion sprang aside,"},{"id":"seytek-2012:p0883:b004:l022","ordinal":363242,"en":"And once more within the hero"},{"id":"seytek-2012:p0883:b004:l023","ordinal":363243,"en":"Unseen wisdom suddenly arose;"},{"id":"seytek-2012:p0883:b004:l024","ordinal":363244,"en":"He readied himself, spear in hand,"},{"id":"seytek-2012:p0883:b004:l025","ordinal":363245,"en":"Praying, “O God!”"},{"id":"seytek-2012:p0883:b004:l026","ordinal":363246,"en":"With matchless agility,"},{"id":"seytek-2012:p0883:b004:l027","ordinal":363247,"en":"He drove it forward with a sharp crack,"},{"id":"seytek-2012:p0883:b004:l028","ordinal":363248,"en":"And struck the mountain-huge boar"},{"id":"seytek-2012:p0883:b004:l029","ordinal":363249,"en":"With a resounding blow."},{"id":"seytek-2012:p0883:b004:l030","ordinal":363250,"en":"When he aimed at the measured mark,"},{"id":"seytek-2012:p0883:b004:l031","ordinal":363251,"en":"When he struck the appointed place,"},{"id":"seytek-2012:p0883:b004:l032","ordinal":363252,"en":"The tempered spear Bölököñ had made—"},{"id":"seytek-2012:p0883:b004:l033","ordinal":363253,"en":"Such was that spear:"},{"id":"seytek-2012:p0883:b004:l034","ordinal":363254,"en":"Torn from a young birch,"},{"id":"seytek-2012:p0883:b004:l035","ordinal":363255,"en":"Bent true by strongmen,"},{"id":"seytek-2012:p0883:b004:l036","ordinal":363256,"en":"Perfected by master craftsmen,"},{"id":"seytek-2012:p0883:b004:l037","ordinal":363257,"en":"Wrapped in mare’s hide,"},{"id":"seytek-2012:p0883:b004:l038","ordinal":363258,"en":"And hafted by Bölökbay."},{"id":"seytek-2012:p0883:b004:l039","ordinal":363259,"en":"Its point had been forged of steel,"},{"id":"seytek-2012:p0883:b004:l040","ordinal":363260,"en":"So that every man it struck"},{"id":"seytek-2012:p0884:b002:l001","ordinal":363261,"en":"Would convulse and die,"},{"id":"seytek-2012:p0884:b002:l002","ordinal":363262,"en":"So that none could retreat,"},{"id":"seytek-2012:p0884:b002:l003","ordinal":363263,"en":"And whoever met it would know its true nature;"},{"id":"seytek-2012:p0884:b002:l004","ordinal":363264,"en":"It had been tempered"}]
