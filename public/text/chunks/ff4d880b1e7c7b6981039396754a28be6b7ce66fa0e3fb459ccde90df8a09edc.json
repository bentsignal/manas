[{"id":"manas-2010:p0597:b001:l036","ordinal":26881,"en":"Against the many people who hold themselves high,"},{"id":"manas-2010:p0597:b001:l037","ordinal":26882,"en":"Unless I fire and wage war,"},{"id":"manas-2010:p0597:b001:l038","ordinal":26883,"en":"My helpless, wretched kin,"},{"id":"manas-2010:p0597:b001:l039","ordinal":26884,"en":"Unless I seek and find them!"},{"id":"manas-2010:p0597:b001:l040","ordinal":26885,"en":"I was born while we lived in Altay."},{"id":"manas-2010:p0597:b001:l041","ordinal":26886,"en":"Growing to maturity, becoming a hero,"},{"id":"manas-2010:p0597:b001:l042","ordinal":26887,"en":"I became equal to sons of heroes."},{"id":"manas-2010:p0598:b001:l001","ordinal":26888,"en":"When I remember, my heart turns to embers."},{"id":"manas-2010:p0598:b001:l002","ordinal":26889,"en":"I was wholly deprived of kin."},{"id":"manas-2010:p0598:b001:l003","ordinal":26890,"en":"My size is half a mountain;"},{"id":"manas-2010:p0598:b001:l004","ordinal":26891,"en":"‘This Manas was left without kin;"},{"id":"manas-2010:p0598:b001:l005","ordinal":26892,"en":"Let him sink away unborn!’—let none say that."},{"id":"manas-2010:p0598:b001:l006","ordinal":26893,"en":"The sustaining Creator"},{"id":"manas-2010:p0598:b001:l007","ordinal":26894,"en":"Had inscribed it on our brows,"},{"id":"manas-2010:p0598:b001:l008","ordinal":26895,"en":"Scattering us all."},{"id":"manas-2010:p0598:b001:l009","ordinal":26896,"en":"For those kinsmen driven away,"},{"id":"manas-2010:p0598:b001:l010","ordinal":26897,"en":"Unless I turn my neck toward the Truth,"},{"id":"manas-2010:p0598:b001:l011","ordinal":26898,"en":"My people who have wandered,"},{"id":"manas-2010:p0598:b001:l012","ordinal":26899,"en":"Unless I gather all, leaving none,"},{"id":"manas-2010:p0598:b001:l013","ordinal":26900,"en":"Those who humiliated my people,"},{"id":"manas-2010:p0598:b001:l014","ordinal":26901,"en":"Unless I slaughter all, leaving none,"},{"id":"manas-2010:p0598:b001:l015","ordinal":26902,"en":"Let me die unworthy of Manas's name;"},{"id":"manas-2010:p0598:b001:l016","ordinal":26903,"en":"Let me sink away unborn!”"},{"id":"manas-2010:p0598:b001:l017","ordinal":26904,"en":"The blue-maned one raged without stopping."},{"id":"manas-2010:p0598:b001:l018","ordinal":26905,"en":"His eyes blazed like fire."},{"id":"manas-2010:p0598:b001:l019","ordinal":26906,"en":"The great lurching terror"},{"id":"manas-2010:p0598:b001:l020","ordinal":26907,"en":"Was seized by his thirst for blood."},{"id":"manas-2010:p0598:b001:l021","ordinal":26908,"en":"When he braced himself, strength surged."},{"id":"manas-2010:p0598:b001:l022","ordinal":26909,"en":"If you saw the warrior's face,"},{"id":"manas-2010:p0598:b001:l023","ordinal":26910,"en":"Hair sprouted enough for five felt stockings."},{"id":"manas-2010:p0598:b001:l024","ordinal":26911,"en":"Distressed, the dear lion"},{"id":"manas-2010:p0598:b001:l025","ordinal":26912,"en":"Now stood in fury,"},{"id":"manas-2010:p0598:b001:l026","ordinal":26913,"en":"Now hardened his resolve."},{"id":"manas-2010:p0598:b001:l027","ordinal":26914,"en":"“Mighty Allah, grant a way!”"},{"id":"manas-2010:p0598:b001:l028","ordinal":26915,"en":"This was what he now asked."},{"id":"manas-2010:p0598:b001:l029","ordinal":26916,"en":"Rousing himself like a lion,"},{"id":"manas-2010:p0598:b001:l030","ordinal":26917,"en":"His sight shook the heart."},{"id":"manas-2010:p0598:b001:l031","ordinal":26918,"en":"If you saw the blue-maned one then,"},{"id":"manas-2010:p0598:b001:l032","ordinal":26919,"en":"His blue-maned nature showed."},{"id":"manas-2010:p0598:b001:l033","ordinal":26920,"en":"Preparing himself like a goshawk,"},{"id":"manas-2010:p0598:b001:l034","ordinal":26921,"en":"The exceptional blood-drinking leopard,"},{"id":"manas-2010:p0598:b001:l035","ordinal":26922,"en":"Wisdom coming from the unseen,"},{"id":"manas-2010:p0598:b001:l036","ordinal":26923,"en":"Unleashing his fury, burning within,"},{"id":"manas-2010:p0598:b001:l037","ordinal":26924,"en":"The falcon, blue-maned one prepared:"},{"id":"manas-2010:p0598:b001:l038","ordinal":26925,"en":"“Of any man who stands against me,"},{"id":"manas-2010:p0598:b001:l039","ordinal":26926,"en":"Unless I charge and raid his people,"},{"id":"manas-2010:p0598:b001:l040","ordinal":26927,"en":"My kin who were separated,"},{"id":"manas-2010:p0598:b001:l041","ordinal":26928,"en":"Unless I seek and find the living,"},{"id":"manas-2010:p0598:b001:l042","ordinal":26929,"en":"Unless I turn my neck toward death,"},{"id":"manas-2010:p0599:b001:l001","ordinal":26930,"en":"My kin who have gone into the depths,"},{"id":"manas-2010:p0599:b001:l002","ordinal":26931,"en":"Unless I pursue them all, leaving none!"},{"id":"manas-2010:p0599:b001:l003","ordinal":26932,"en":"When my father Karakan died,"},{"id":"manas-2010:p0599:b001:l004","ordinal":26933,"en":"They plundered the khan's possessions."},{"id":"manas-2010:p0599:b001:l005","ordinal":26934,"en":"Destroying so many,"},{"id":"manas-2010:p0599:b001:l006","ordinal":26935,"en":"They slaughtered his champions."},{"id":"manas-2010:p0599:b001:l007","ordinal":26936,"en":"To the four corners of the world,"},{"id":"manas-2010:p0599:b001:l008","ordinal":26937,"en":"Peoples ruled by princes took booty"},{"id":"manas-2010:p0599:b001:l009","ordinal":26938,"en":"And divided my kin apart."},{"id":"manas-2010:p0599:b001:l010","ordinal":26939,"en":"Many, living in captivity,"},{"id":"manas-2010:p0599:b001:l011","ordinal":26940,"en":"Beheld the face of Judgment Day."},{"id":"manas-2010:p0599:b001:l012","ordinal":26941,"en":"The true abode from which none return,"},{"id":"manas-2010:p0599:b001:l013","ordinal":26942,"en":"Many of my people saw."},{"id":"manas-2010:p0599:b001:l014","ordinal":26943,"en":"My kin who bore themselves as warriors,"},{"id":"manas-2010:p0599:b001:l015","ordinal":26944,"en":"They stormed in and bound them."},{"id":"manas-2010:p0599:b001:l016","ordinal":26945,"en":"Their champions who claimed heroism,"},{"id":"manas-2010:p0599:b001:l017","ordinal":26946,"en":"They slaughtered mercilessly."},{"id":"manas-2010:p0599:b001:l018","ordinal":26947,"en":"Ruining my people,"},{"id":"manas-2010:p0599:b001:l019","ordinal":26948,"en":"They took as booty,"},{"id":"manas-2010:p0599:b001:l020","ordinal":26949,"en":"As I think of it, my land."},{"id":"manas-2010:p0599:b001:l021","ordinal":26950,"en":"Where my nails can reach and eyes can see,"},{"id":"manas-2010:p0599:b001:l022","ordinal":26951,"en":"Unless I raid the places I reach!"},{"id":"manas-2010:p0599:b001:l023","ordinal":26952,"en":"Taking them as booty, leaving them destitute,"},{"id":"manas-2010:p0599:b001:l024","ordinal":26953,"en":"Unless I raid the people who took them!"},{"id":"manas-2010:p0599:b001:l025","ordinal":26954,"en":"Unless I free my land,"},{"id":"manas-2010:p0599:b001:l026","ordinal":26955,"en":"Unless I free and rescue"},{"id":"manas-2010:p0599:b001:l027","ordinal":26956,"en":"My people living in exile!"},{"id":"manas-2010:p0599:b001:l028","ordinal":26957,"en":"Unless I die when death comes,"},{"id":"manas-2010:p0599:b001:l029","ordinal":26958,"en":"My people held captive,"},{"id":"manas-2010:p0599:b001:l030","ordinal":26959,"en":"Unless I truly find and see them,"},{"id":"manas-2010:p0599:b001:l031","ordinal":26960,"en":"Thrusting spears, breaking the ranks,"},{"id":"manas-2010:p0599:b001:l032","ordinal":26961,"en":"Meeting death, struck by a shot,"},{"id":"manas-2010:p0599:b001:l033","ordinal":26962,"en":"Dividing peoples with princely courts,"},{"id":"manas-2010:p0599:b001:l034","ordinal":26963,"en":"For those kinsfolk,"},{"id":"manas-2010:p0599:b001:l035","ordinal":26964,"en":"Dying in battle without rest for twelve months,"},{"id":"manas-2010:p0599:b001:l036","ordinal":26965,"en":"Wherever ears have heard and eyes have seen,"},{"id":"manas-2010:p0599:b001:l037","ordinal":26966,"en":"Traveling through every people,"},{"id":"manas-2010:p0599:b001:l038","ordinal":26967,"en":"Wearing a coat no shot can pierce,"},{"id":"manas-2010:p0599:b001:l039","ordinal":26968,"en":"Zhelpinish at the ends of the earth,"},{"id":"manas-2010:p0599:b001:l040","ordinal":26969,"en":"Circling seven times around,"},{"id":"manas-2010:p0599:b001:l041","ordinal":26970,"en":"Unless I go to many places,"},{"id":"manas-2010:p0599:b001:l042","ordinal":26971,"en":"Their dead and their living,"},{"id":"manas-2010:p0600:b001:l001","ordinal":26972,"en":"Unless I learn to distinguish them,"},{"id":"manas-2010:p0600:b001:l002","ordinal":26973,"en":"For the sake of my kin,"},{"id":"manas-2010:p0600:b001:l003","ordinal":26974,"en":"Unless I bring slaughter on the world,"},{"id":"manas-2010:p0600:b001:l004","ordinal":26975,"en":"Calling myself Manas, sprawling about,"},{"id":"manas-2010:p0600:b001:l005","ordinal":26976,"en":"Let my great bulk perish!"},{"id":"manas-2010:p0600:b001:l006","ordinal":26977,"en":"As master of this Talas,"},{"id":"manas-2010:p0600:b001:l007","ordinal":26978,"en":"Let my swollen pride perish!"},{"id":"manas-2010:p0600:b001:l008","ordinal":26979,"en":"Opening up all my livestock wealth,"},{"id":"manas-2010:p0600:b001:l009","ordinal":26980,"en":"Traveling through many cities,"},{"id":"manas-2010:p0600:b001:l010","ordinal":26981,"en":"Unless I find the orphans,"},{"id":"manas-2010:p0600:b001:l011","ordinal":26982,"en":"Every place I reach,"},{"id":"manas-2010:p0600:b001:l012","ordinal":26983,"en":"Unless I raid it into submission,"},{"id":"manas-2010:p0600:b001:l013","ordinal":26984,"en":"Traveling toward the sunset,"},{"id":"manas-2010:p0600:b001:l014","ordinal":26985,"en":"Unless I slaughter the Kyzylbash people!"},{"id":"manas-2010:p0600:b001:l015","ordinal":26986,"en":"Driving my tulpar onward,"},{"id":"manas-2010:p0600:b001:l016","ordinal":26987,"en":"All the world,"},{"id":"manas-2010:p0600:b001:l017","ordinal":26988,"en":"Traveling through it with battle,"},{"id":"manas-2010:p0600:b001:l018","ordinal":26989,"en":"Spreading my heroism among the people,"},{"id":"manas-2010:p0600:b001:l019","ordinal":26990,"en":"Wherever ears have heard and eyes have seen,"},{"id":"manas-2010:p0600:b001:l020","ordinal":26991,"en":"Bringing the peoples I reach under my rule,"},{"id":"manas-2010:p0600:b001:l021","ordinal":26992,"en":"Those who heed my words,"},{"id":"manas-2010:p0600:b001:l022","ordinal":26993,"en":"Bringing them under my rule through words,"},{"id":"manas-2010:p0600:b001:l023","ordinal":26994,"en":"Unless I wage a fierce struggle,"},{"id":"manas-2010:p0600:b001:l024","ordinal":26995,"en":"Those who do not understand words,"},{"id":"manas-2010:p0600:b001:l025","ordinal":26996,"en":"Unless I conquer them by force!"},{"id":"manas-2010:p0600:b001:l026","ordinal":26997,"en":"Unless I show my lion's nature,"},{"id":"manas-2010:p0600:b001:l027","ordinal":26998,"en":"Unless in many places I perform"},{"id":"manas-2010:p0600:b001:l028","ordinal":26999,"en":"Heroism beyond humankind,"},{"id":"manas-2010:p0600:b001:l029","ordinal":27000,"en":"The man who says, ‘I have only one horse,’"},{"id":"manas-2010:p0600:b001:l030","ordinal":27001,"en":"Slaughtering his horse and holding a feast,"},{"id":"manas-2010:p0600:b001:l031","ordinal":27002,"en":"Feeding those who lack,"},{"id":"manas-2010:p0600:b001:l032","ordinal":27003,"en":"The enemy who disobeys,"},{"id":"manas-2010:p0600:b001:l033","ordinal":27004,"en":"Making them say, ‘Manas devoured him!’"},{"id":"manas-2010:p0600:b001:l034","ordinal":27005,"en":"Unless I make many such spectacles!"},{"id":"manas-2010:p0600:b001:l035","ordinal":27006,"en":"If they roar and grow stronger,"},{"id":"manas-2010:p0600:b001:l036","ordinal":27007,"en":"Unless I pierce their champions,"},{"id":"manas-2010:p0600:b001:l037","ordinal":27008,"en":"The man who says, ‘I alone remain,’"},{"id":"manas-2010:p0600:b001:l038","ordinal":27009,"en":"Unless I slaughter him and feast my fill!"},{"id":"manas-2010:p0600:b001:l039","ordinal":27010,"en":"Deep Beijing and great Mecca,"},{"id":"manas-2010:p0600:b001:l040","ordinal":27011,"en":"Unless I roam through them all,"},{"id":"manas-2010:p0600:b001:l041","ordinal":27012,"en":"Shouting and leveling spears,"},{"id":"manas-2010:p0600:b001:l042","ordinal":27013,"en":"My people taken as booty,"},{"id":"manas-2010:p0601:b001:l001","ordinal":27014,"en":"Unless I thoughtfully seek and find them,"},{"id":"manas-2010:p0601:b001:l002","ordinal":27015,"en":"Where is my heroism?!"},{"id":"manas-2010:p0601:b001:l003","ordinal":27016,"en":"If a bitterly hostile enemy arises,"},{"id":"manas-2010:p0601:b001:l004","ordinal":27017,"en":"Unless I seize and slaughter him,"},{"id":"manas-2010:p0601:b001:l005","ordinal":27018,"en":"For these worn and scattered people,"},{"id":"manas-2010:p0601:b001:l006","ordinal":27019,"en":"Unless I become an exceptional fortress,"},{"id":"manas-2010:p0601:b001:l007","ordinal":27020,"en":"Calling myself Manas, rumbling,"},{"id":"manas-2010:p0601:b001:l008","ordinal":27021,"en":"Let my great bulk perish!"},{"id":"manas-2010:p0601:b001:l009","ordinal":27022,"en":"As leader of this people,"},{"id":"manas-2010:p0601:b001:l010","ordinal":27023,"en":"Let my swollen pride perish!"},{"id":"manas-2010:p0601:b001:l011","ordinal":27024,"en":"Zhelpinish at the ends of the earth,"},{"id":"manas-2010:p0601:b001:l012","ordinal":27025,"en":"Great Beijing at the farthest reach,"},{"id":"manas-2010:p0601:b001:l013","ordinal":27026,"en":"Unless I scout seven times around,"},{"id":"manas-2010:p0601:b001:l014","ordinal":27027,"en":"Where wings tire and feet can reach,"},{"id":"manas-2010:p0601:b001:l015","ordinal":27028,"en":"Unless I travel as far as that,"},{"id":"manas-2010:p0601:b001:l016","ordinal":27029,"en":"The sprawling city Kara-Kyr,"},{"id":"manas-2010:p0601:b001:l017","ordinal":27030,"en":"Unless I cross it and Mount Kap together,"},{"id":"manas-2010:p0601:b001:l018","ordinal":27031,"en":"Among blood-drinkers and blue-maned heroes,"},{"id":"manas-2010:p0601:b001:l019","ordinal":27032,"en":"Unless I seek and find champions,"},{"id":"manas-2010:p0601:b001:l020","ordinal":27033,"en":"Let me perish and die."},{"id":"manas-2010:p0601:b001:l021","ordinal":27034,"en":"What mighty Allah has written,"},{"id":"manas-2010:p0601:b001:l022","ordinal":27035,"en":"Let me face it when it comes upon my neck!”"},{"id":"manas-2010:p0601:b001:l023","ordinal":27036,"en":"The blue-maned one spoke without stopping,"},{"id":"manas-2010:p0601:b001:l024","ordinal":27037,"en":"Finding no mountain to strike against,"},{"id":"manas-2010:p0601:b001:l025","ordinal":27038,"en":"Finding no enemy to fight,"},{"id":"manas-2010:p0601:b001:l026","ordinal":27039,"en":"Finding no stone to chew,"},{"id":"manas-2010:p0601:b001:l027","ordinal":27040,"en":"Finding no head to tear off,"},{"id":"manas-2010:p0601:b001:l028","ordinal":27041,"en":"Furious, rousing himself—"},{"id":"manas-2010:p0601:b001:l029","ordinal":27042,"en":"Such was the blood-drinker's state."},{"id":"manas-2010:p0601:b001:l030","ordinal":27043,"en":"Of middling height, broad-shouldered,"},{"id":"manas-2010:p0601:b001:l031","ordinal":27044,"en":"An extraordinary wrestler, a blood-drinker,"},{"id":"manas-2010:p0601:b001:l032","ordinal":27045,"en":"His prowess was unlike others'."},{"id":"manas-2010:p0601:b001:l033","ordinal":27046,"en":"When his temper was provoked,"},{"id":"manas-2010:p0601:b001:l034","ordinal":27047,"en":"He was the bold one who ruined the Chinese."},{"id":"manas-2010:p0601:b001:l035","ordinal":27048,"en":"From seven he found land."},{"id":"manas-2010:p0601:b001:l036","ordinal":27049,"en":"The Black Kalmyks and many Manchus,"},{"id":"manas-2010:p0601:b001:l037","ordinal":27050,"en":"Fighting them, he found a people."},{"id":"manas-2010:p0601:b001:l038","ordinal":27051,"en":"When he stood rigid in fury,"},{"id":"manas-2010:p0601:b001:l039","ordinal":27052,"en":"His people despaired of life."},{"id":"manas-2010:p0601:b001:l040","ordinal":27053,"en":"“That ill-omened blood-drinker,"},{"id":"manas-2010:p0601:b001:l041","ordinal":27054,"en":"What will he do to us?” they said."},{"id":"manas-2010:p0601:b001:l042","ordinal":27055,"en":"The people surged in distress,"},{"id":"manas-2010:p0602:b001:l001","ordinal":27056,"en":"“Of the champion, blue-maned lord,"},{"id":"manas-2010:p0602:b001:l002","ordinal":27057,"en":"What will his disposition be?” they said."},{"id":"manas-2010:p0602:b001:l003","ordinal":27058,"en":"“These people not yet put to rights,"},{"id":"manas-2010:p0602:b001:l004","ordinal":27059,"en":"If his madness seizes him to set them straight,"},{"id":"manas-2010:p0602:b001:l005","ordinal":27060,"en":"He will gather them all,” they said."},{"id":"manas-2010:p0602:b001:l006","ordinal":27061,"en":"“Against a great enemy of grievous burden,"},{"id":"manas-2010:p0602:b001:l007","ordinal":27062,"en":"Driving us all, this blood-drinker"},{"id":"manas-2010:p0602:b001:l008","ordinal":27063,"en":"Will have us slaughtered,” they said."},{"id":"manas-2010:p0602:b001:l009","ordinal":27064,"en":"“From ill-intentioned Jakyp,"},{"id":"manas-2010:p0602:b001:l010","ordinal":27065,"en":"If suddenly he grows furious,"},{"id":"manas-2010:p0602:b001:l011","ordinal":27066,"en":"From the dark, blue-maned warrior,"},{"id":"manas-2010:p0602:b001:l012","ordinal":27067,"en":"What soul will survive?” they said."},{"id":"manas-2010:p0602:b001:l013","ordinal":27068,"en":"“If the leopard grows furious,"},{"id":"manas-2010:p0602:b001:l014","ordinal":27069,"en":"All the Kyrgyz gathered here,"},{"id":"manas-2010:p0602:b001:l015","ordinal":27070,"en":"He will muster to the last,” they said."},{"id":"manas-2010:p0602:b001:l016","ordinal":27071,"en":"Panicking beyond all reason,"},{"id":"manas-2010:p0602:b001:l017","ordinal":27072,"en":"Surging in utter confusion,"},{"id":"manas-2010:p0602:b001:l018","ordinal":27073,"en":"Speaking in broken, uneven phrases,"},{"id":"manas-2010:p0602:b001:l019","ordinal":27074,"en":"His people clamored and cried."},{"id":"manas-2010:p0602:b001:l020","ordinal":27075,"en":"The people lost their senses;"},{"id":"manas-2010:p0602:b001:l021","ordinal":27076,"en":"They stood in great panic."},{"id":"manas-2010:p0602:b001:l022","ordinal":27077,"en":"Blood-drinking Manas, the leopard,"},{"id":"manas-2010:p0602:b001:l023","ordinal":27078,"en":"Spoke calmly to the people."},{"id":"manas-2010:p0602:b001:l024","ordinal":27079,"en":"“This year, my people, hear my words!"},{"id":"manas-2010:p0602:b001:l025","ordinal":27080,"en":"Driving a ravaged people into an army,"},{"id":"manas-2010:p0602:b001:l026","ordinal":27081,"en":"What inheritance would I gain?"},{"id":"manas-2010:p0602:b001:l027","ordinal":27082,"en":"The world's four corners,"},{"id":"manas-2010:p0602:b001:l028","ordinal":27083,"en":"To raid on all four sides,"},{"id":"manas-2010:p0602:b001:l029","ordinal":27084,"en":"Let me go alone."},{"id":"manas-2010:p0602:b001:l030","ordinal":27085,"en":"The painted spear with its fine pennon,"},{"id":"manas-2010:p0602:b001:l031","ordinal":27086,"en":"Let me flourish and take in my hand."},{"id":"manas-2010:p0602:b001:l032","ordinal":27087,"en":"Upon enemies who fill the land,"},{"id":"manas-2010:p0602:b001:l033","ordinal":27088,"en":"Let me alone bring slaughter."},{"id":"manas-2010:p0602:b001:l034","ordinal":27089,"en":"Girding my waist with a leather belt,"},{"id":"manas-2010:p0602:b001:l035","ordinal":27090,"en":"Let enemies fill the land,"},{"id":"manas-2010:p0602:b001:l036","ordinal":27091,"en":"Let giants bow the earth,"},{"id":"manas-2010:p0602:b001:l037","ordinal":27092,"en":"Entering alone and attacking,"},{"id":"manas-2010:p0602:b001:l038","ordinal":27093,"en":"Heavenly cities, great peoples,"},{"id":"manas-2010:p0602:b001:l039","ordinal":27094,"en":"Let me scout to their farthest end."},{"id":"manas-2010:p0602:b001:l040","ordinal":27095,"en":"Without troubling this people,"},{"id":"manas-2010:p0602:b001:l041","ordinal":27096,"en":"Let me go by myself."},{"id":"manas-2010:p0602:b001:l042","ordinal":27097,"en":"Sharing death, joined in life,"},{"id":"manas-2010:p0603:b001:l001","ordinal":27098,"en":"If God has created them as living souls,"},{"id":"manas-2010:p0603:b001:l002","ordinal":27099,"en":"Let me find close companions."},{"id":"manas-2010:p0603:b001:l003","ordinal":27100,"en":"If my strength allows, let me clash;"},{"id":"manas-2010:p0603:b001:l004","ordinal":27101,"en":"Let me go alone to battle."},{"id":"manas-2010:p0603:b001:l005","ordinal":27102,"en":"If my power allows, let me exchange shots,"},{"id":"manas-2010:p0603:b001:l006","ordinal":27103,"en":"Let me fire many volleys."},{"id":"manas-2010:p0603:b001:l007","ordinal":27104,"en":"Making some weep,"},{"id":"manas-2010:p0603:b001:l008","ordinal":27105,"en":"Making some sob,"},{"id":"manas-2010:p0603:b001:l009","ordinal":27106,"en":"Why should I grieve the people?"},{"id":"manas-2010:p0603:b001:l010","ordinal":27107,"en":"Wherever ears have heard and eyes have seen,"},{"id":"manas-2010:p0603:b001:l011","ordinal":27108,"en":"Traveling through every land,"},{"id":"manas-2010:p0603:b001:l012","ordinal":27109,"en":"Let me go by myself.”"},{"id":"manas-2010:p0603:b001:l013","ordinal":27110,"en":"So said the leopard,"},{"id":"manas-2010:p0603:b001:l014","ordinal":27111,"en":"Your falcon visited by Kydyr."},{"id":"manas-2010:p0603:b001:l015","ordinal":27112,"en":"Without fighting slaughterous battles with peoples,"},{"id":"manas-2010:p0603:b001:l016","ordinal":27113,"en":"Would your falcon Manas remain still?"},{"id":"manas-2010:p0603:b001:l017","ordinal":27114,"en":"‘I have no kin,’ he said without ceasing."},{"id":"manas-2010:p0603:b001:l018","ordinal":27115,"en":"Furious, excited,"},{"id":"manas-2010:p0603:b001:l019","ordinal":27116,"en":"Blood-drinking Manas grew frenzied."},{"id":"manas-2010:p0603:b001:l020","ordinal":27117,"en":"Hastily performing his prayers,"},{"id":"manas-2010:p0603:b001:l021","ordinal":27118,"en":"Saddling Akkula,"},{"id":"manas-2010:p0603:b001:l022","ordinal":27119,"en":"Furious, making ready,"},{"id":"manas-2010:p0603:b001:l023","ordinal":27120,"en":"If you saw the blood-drinking lion,"},{"id":"manas-2010:p0603:b001:l024","ordinal":27121,"en":"Zulpukor, never sated with blood,"},{"id":"manas-2010:p0603:b001:l025","ordinal":27122,"en":"Was fastened on his left side."},{"id":"manas-2010:p0603:b001:l026","ordinal":27123,"en":"Taking a spear of wondrous facets,"},{"id":"manas-2010:p0603:b001:l027","ordinal":27124,"en":"His people surged in grief."},{"id":"manas-2010:p0603:b001:l028","ordinal":27125,"en":"The battle-axe with golden cheeks"},{"id":"manas-2010:p0603:b001:l029","ordinal":27126,"en":"Hung upon his bare wrist."},{"id":"manas-2010:p0603:b001:l030","ordinal":27127,"en":"A plane tree planted in Talas,"},{"id":"manas-2010:p0603:b001:l031","ordinal":27128,"en":"Your lord's mount—"},{"id":"manas-2010:p0603:b001:l032","ordinal":27129,"en":"A golden throne as big as a camel."},{"id":"manas-2010:p0603:b001:l033","ordinal":27130,"en":"The people under their prince clamored;"},{"id":"manas-2010:p0603:b001:l034","ordinal":27131,"en":"The people stood in sorrow."},{"id":"manas-2010:p0603:b001:l035","ordinal":27132,"en":"Towering upon Akkula,"},{"id":"manas-2010:p0603:b001:l036","ordinal":27133,"en":"The lion lord then"},{"id":"manas-2010:p0603:b001:l037","ordinal":27134,"en":"Parted from his vast people."},{"id":"manas-2010:p0603:b001:l038","ordinal":27135,"en":"As he rode off, the many people's"},{"id":"manas-2010:p0603:b001:l039","ordinal":27136,"en":"Hearts were left shaken."}]
