[{"id":"manas-2010:p0208:b001:l044","ordinal":9217,"en":"Before an eye could blink,"},{"id":"manas-2010:p0208:b001:l045","ordinal":9218,"en":"The lion's true lionhood was known."},{"id":"manas-2010:p0208:b001:l046","ordinal":9219,"en":"Toruchaar came galloping up."},{"id":"manas-2010:p0208:b001:l047","ordinal":9220,"en":"Khan Manas upon Toruchaar,"},{"id":"manas-2010:p0208:b001:l048","ordinal":9221,"en":"His face like oiled wheat,"},{"id":"manas-2010:p0209:b001:l001","ordinal":9222,"en":"His eyes like dusk and mist,"},{"id":"manas-2010:p0209:b001:l002","ordinal":9223,"en":"Blood-drinking Manas the leopard"},{"id":"manas-2010:p0209:b001:l003","ordinal":9224,"en":"Girded his full-grown waist."},{"id":"manas-2010:p0209:b001:l004","ordinal":9225,"en":"On reaching Döngö,"},{"id":"manas-2010:p0209:b001:l005","ordinal":9226,"en":"He stabbed him once with his spear."},{"id":"manas-2010:p0209:b001:l006","ordinal":9227,"en":"Your accomplished young lion"},{"id":"manas-2010:p0209:b001:l007","ordinal":9228,"en":"Arrived before an arrow."},{"id":"manas-2010:p0209:b001:l008","ordinal":9229,"en":"When he reached Döngö, he said:"},{"id":"manas-2010:p0209:b001:l009","ordinal":9230,"en":"‘The edge of the hemp belt,"},{"id":"manas-2010:p0209:b001:l010","ordinal":9231,"en":"One side of the lung,"},{"id":"manas-2010:p0209:b001:l011","ordinal":9232,"en":"The place of his vital part—"},{"id":"manas-2010:p0209:b001:l012","ordinal":9233,"en":"That pig, may he burn to death,"},{"id":"manas-2010:p0209:b001:l013","ordinal":9234,"en":"This is where he will die.’"},{"id":"manas-2010:p0209:b001:l014","ordinal":9235,"en":"The lacquered spear never sated with blood,"},{"id":"manas-2010:p0209:b001:l015","ordinal":9236,"en":"He seized it and swung it round."},{"id":"manas-2010:p0209:b001:l016","ordinal":9237,"en":"Such was his bloodthirstiness:"},{"id":"manas-2010:p0209:b001:l017","ordinal":9238,"en":"Making Döngö cry ‘Kang!’"},{"id":"manas-2010:p0209:b001:l018","ordinal":9239,"en":"He came and struck him."},{"id":"manas-2010:p0209:b001:l019","ordinal":9240,"en":"His rib bones split apart."},{"id":"manas-2010:p0209:b001:l020","ordinal":9241,"en":"When Manas the lion drove his spear,"},{"id":"manas-2010:p0209:b001:l021","ordinal":9242,"en":"His lungs were cleft in two;"},{"id":"manas-2010:p0209:b001:l022","ordinal":9243,"en":"His blood poured out like water."},{"id":"manas-2010:p0209:b001:l023","ordinal":9244,"en":"Those who watched"},{"id":"manas-2010:p0209:b001:l024","ordinal":9245,"en":"Trembled through their whole bodies."},{"id":"manas-2010:p0209:b001:l025","ordinal":9246,"en":"From atop Kylküröng,"},{"id":"manas-2010:p0209:b001:l026","ordinal":9247,"en":"His backside slipped from the saddle;"},{"id":"manas-2010:p0209:b001:l027","ordinal":9248,"en":"His feet slipped from the stirrups;"},{"id":"manas-2010:p0209:b001:l028","ordinal":9249,"en":"He fell with a thunder."},{"id":"manas-2010:p0209:b001:l029","ordinal":9250,"en":"When Döngö fell from his horse,"},{"id":"manas-2010:p0209:b001:l030","ordinal":9251,"en":"He brought calamity upon his head"},{"id":"manas-2010:p0209:b001:l031","ordinal":9252,"en":"And cut his head off."},{"id":"manas-2010:p0209:b001:l032","ordinal":9253,"en":"Having laid that Döngö low,"},{"id":"manas-2010:p0209:b001:l033","ordinal":9254,"en":"Taking a shorter path inward,"},{"id":"manas-2010:p0209:b001:l034","ordinal":9255,"en":"Manas the lion took Kylküröng"},{"id":"manas-2010:p0209:b001:l035","ordinal":9256,"en":"As spoils and led him away."},{"id":"manas-2010:p0209:b001:l036","ordinal":9257,"en":"Before he could bring Kylküröng out,"},{"id":"manas-2010:p0209:b001:l037","ordinal":9258,"en":"God forbid we see such a face!"},{"id":"manas-2010:p0209:b001:l038","ordinal":9259,"en":"Look at the reeds, look at the flood;"},{"id":"manas-2010:p0209:b001:l039","ordinal":9260,"en":"Look at the people who swept over all."},{"id":"manas-2010:p0209:b001:l040","ordinal":9261,"en":"Look at the embers flying in the haze;"},{"id":"manas-2010:p0209:b001:l041","ordinal":9262,"en":"Look at the bullets striking without fail."},{"id":"manas-2010:p0209:b001:l042","ordinal":9263,"en":"Wrathful Zholoy roared,"},{"id":"manas-2010:p0209:b001:l043","ordinal":9264,"en":"Crying the battle cry ‘Kakan!’"},{"id":"manas-2010:p0209:b001:l044","ordinal":9265,"en":"He now unleashed fierce wrath."},{"id":"manas-2010:p0209:b001:l045","ordinal":9266,"en":"The many seething champions,"},{"id":"manas-2010:p0209:b001:l046","ordinal":9267,"en":"With their khan Zholoy at their head,"},{"id":"manas-2010:p0209:b001:l047","ordinal":9268,"en":"The mighty Sultan Manas,"},{"id":"manas-2010:p0209:b001:l048","ordinal":9269,"en":"They now surrounded him."},{"id":"manas-2010:p0210:b001:l001","ordinal":9270,"en":"Rich Akbaltay and rich Jakyp,"},{"id":"manas-2010:p0210:b001:l002","ordinal":9271,"en":"Their many worries too great for their breasts,"},{"id":"manas-2010:p0210:b001:l003","ordinal":9272,"en":"When they saw Khan Manas,"},{"id":"manas-2010:p0210:b001:l004","ordinal":9273,"en":"Both their tears flowed in ten streams."},{"id":"manas-2010:p0210:b001:l005","ordinal":9274,"en":"‘If we go on living without dying,"},{"id":"manas-2010:p0210:b001:l006","ordinal":9275,"en":"What inheritance shall we attain?"},{"id":"manas-2010:p0210:b001:l007","ordinal":9276,"en":"For the child granted by fate,"},{"id":"manas-2010:p0210:b001:l008","ordinal":9277,"en":"Let our wretched lives be sacrificed.’"},{"id":"manas-2010:p0210:b001:l009","ordinal":9278,"en":"Their white beards thinning,"},{"id":"manas-2010:p0210:b001:l010","ordinal":9279,"en":"Tears streaming from two eyes"},{"id":"manas-2010:p0210:b001:l011","ordinal":9280,"en":"Poured down below the collarbones."},{"id":"manas-2010:p0210:b001:l012","ordinal":9281,"en":"Their many worries could not fit their breasts;"},{"id":"manas-2010:p0210:b001:l013","ordinal":9282,"en":"Their tears flowed in a thousand streams."},{"id":"manas-2010:p0210:b001:l014","ordinal":9283,"en":"‘If death comes, we die,’ they said."},{"id":"manas-2010:p0210:b001:l015","ordinal":9284,"en":"‘If there is a way, for Manas"},{"id":"manas-2010:p0210:b001:l016","ordinal":9285,"en":"Let us become a support,’ they said."},{"id":"manas-2010:p0210:b001:l017","ordinal":9286,"en":"Without sparing his own life,"},{"id":"manas-2010:p0210:b001:l018","ordinal":9287,"en":"Khan Baltay from the flank"},{"id":"manas-2010:p0210:b001:l019","ordinal":9288,"en":"Charged and thrust his spear."},{"id":"manas-2010:p0210:b001:l020","ordinal":9289,"en":"Rich Jakyp in the middle,"},{"id":"manas-2010:p0210:b001:l021","ordinal":9290,"en":"For his mighty son Manas,"},{"id":"manas-2010:p0210:b001:l022","ordinal":9291,"en":"Fought in the slaughter."},{"id":"manas-2010:p0210:b001:l023","ordinal":9292,"en":"The dear lion of surpassing fortune,"},{"id":"manas-2010:p0210:b001:l024","ordinal":9293,"en":"Smashing the Chinese,"},{"id":"manas-2010:p0210:b001:l025","ordinal":9294,"en":"The hero Manas went slaughtering them."},{"id":"manas-2010:p0210:b001:l026","ordinal":9295,"en":"Striking Toruchaar once on the thigh,"},{"id":"manas-2010:p0210:b001:l027","ordinal":9296,"en":"Crying out ‘Khan Manas!’"},{"id":"manas-2010:p0210:b001:l028","ordinal":9297,"en":"When he darted again and again,"},{"id":"manas-2010:p0210:b001:l029","ordinal":9298,"en":"Twelve Kalmyks lay sprawled out."},{"id":"manas-2010:p0210:b001:l030","ordinal":9299,"en":"Making Toruchaar prance,"},{"id":"manas-2010:p0210:b001:l031","ordinal":9300,"en":"Making those he reached crawl,"},{"id":"manas-2010:p0210:b001:l032","ordinal":9301,"en":"Mighty Manas in the middle"},{"id":"manas-2010:p0210:b001:l033","ordinal":9302,"en":"Appeared like a towering mountain."},{"id":"manas-2010:p0210:b001:l034","ordinal":9303,"en":"Unable to bear the bloodthirsty one's wrath,"},{"id":"manas-2010:p0210:b001:l035","ordinal":9304,"en":"Champions broke away and fled."},{"id":"manas-2010:p0210:b001:l036","ordinal":9305,"en":"Those who came straight before him"},{"id":"manas-2010:p0210:b001:l037","ordinal":9306,"en":"Could not flee and escape alive;"},{"id":"manas-2010:p0210:b001:l038","ordinal":9307,"en":"Their blood flowed and poured out."},{"id":"manas-2010:p0210:b001:l039","ordinal":9308,"en":"When it came to battle cries,"},{"id":"manas-2010:p0210:b001:l040","ordinal":9309,"en":"Wolf-maned Manas the lion"},{"id":"manas-2010:p0210:b001:l041","ordinal":9310,"en":"Showed his lion's form."},{"id":"manas-2010:p0210:b001:l042","ordinal":9311,"en":"On the downward slope he speared men;"},{"id":"manas-2010:p0210:b001:l043","ordinal":9312,"en":"The incomparable leopard"},{"id":"manas-2010:p0210:b001:l044","ordinal":9313,"en":"Speared fully fifty in a row at once."},{"id":"manas-2010:p0210:b001:l045","ordinal":9314,"en":"When he entered the turmoil,"},{"id":"manas-2010:p0210:b001:l046","ordinal":9315,"en":"He roared in wrath."},{"id":"manas-2010:p0210:b001:l047","ordinal":9316,"en":"The Kalmyks, like black willow trees,"},{"id":"manas-2010:p0210:b001:l048","ordinal":9317,"en":"He drove back and scattered."},{"id":"manas-2010:p0211:b001:l001","ordinal":9318,"en":"Their middle, Akbaltay"},{"id":"manas-2010:p0211:b001:l002","ordinal":9319,"en":"Had torn through it."},{"id":"manas-2010:p0211:b001:l003","ordinal":9320,"en":"On one edge, rich Jakyp"},{"id":"manas-2010:p0211:b001:l004","ordinal":9321,"en":"Had begun slaughtering."},{"id":"manas-2010:p0211:b001:l005","ordinal":9322,"en":"The Kalmyks fled one by one"},{"id":"manas-2010:p0211:b001:l006","ordinal":9323,"en":"And were scattered everywhere."},{"id":"manas-2010:p0211:b001:l007","ordinal":9324,"en":"Slaughtering those who scattered,"},{"id":"manas-2010:p0211:b001:l008","ordinal":9325,"en":"That wolf-maned Manas of yours"},{"id":"manas-2010:p0211:b001:l009","ordinal":9326,"en":"Had driven them before him."},{"id":"manas-2010:p0211:b001:l010","ordinal":9327,"en":"He began a fierce fury."},{"id":"manas-2010:p0211:b001:l011","ordinal":9328,"en":"Beginning with their hero Döngö,"},{"id":"manas-2010:p0211:b001:l012","ordinal":9329,"en":"All the troops who had come,"},{"id":"manas-2010:p0211:b001:l013","ordinal":9330,"en":"He slaughtered them utterly."},{"id":"manas-2010:p0211:b001:l014","ordinal":9331,"en":"All the plain became dust;"},{"id":"manas-2010:p0211:b001:l015","ordinal":9332,"en":"If you looked at every ravine,"},{"id":"manas-2010:p0211:b001:l016","ordinal":9333,"en":"Blood flowed there, bubbling."},{"id":"manas-2010:p0211:b001:l017","ordinal":9334,"en":"Calamity was brought upon their heads;"},{"id":"manas-2010:p0211:b001:l018","ordinal":9335,"en":"Esenkan's champions"},{"id":"manas-2010:p0211:b001:l019","ordinal":9336,"en":"Were overcome by Khan Manas alone."},{"id":"manas-2010:p0211:b001:l020","ordinal":9337,"en":"Rich Akbaltay and rich Jakyp"},{"id":"manas-2010:p0211:b001:l021","ordinal":9338,"en":"Had taken horses as spoils;"},{"id":"manas-2010:p0211:b001:l022","ordinal":9339,"en":"They were steeped in spoils."},{"id":"manas-2010:p0211:b001:l023","ordinal":9340,"en":"The Kalmyks' hero,"},{"id":"manas-2010:p0211:b001:l024","ordinal":9341,"en":"Their valiant unbeliever Zholoy,"},{"id":"manas-2010:p0211:b001:l025","ordinal":9342,"en":"Raised a turmoil."},{"id":"manas-2010:p0211:b001:l026","ordinal":9343,"en":"The Kalmyks' Zholoy"},{"id":"manas-2010:p0211:b001:l027","ordinal":9344,"en":"Had barred Chylan’s path."},{"id":"manas-2010:p0211:b001:l028","ordinal":9345,"en":"He raised a turmoil,"},{"id":"manas-2010:p0211:b001:l029","ordinal":9346,"en":"Destroying his servants,"},{"id":"manas-2010:p0211:b001:l030","ordinal":9347,"en":"On the Topurak-Söksööl road,"},{"id":"manas-2010:p0211:b001:l031","ordinal":9348,"en":"From hellish Zholoy's hands,"},{"id":"manas-2010:p0211:b001:l032","ordinal":9349,"en":"Raising a thousand struggles,"},{"id":"manas-2010:p0211:b001:l033","ordinal":9350,"en":"He took the tea of a thousand camels."},{"id":"manas-2010:p0211:b001:l034","ordinal":9351,"en":"He began a fierce fury."},{"id":"manas-2010:p0211:b001:l035","ordinal":9352,"en":"Everyone apart from Zholoy"},{"id":"manas-2010:p0211:b001:l036","ordinal":9353,"en":"He slaughtered on the ridge."},{"id":"manas-2010:p0211:b001:l037","ordinal":9354,"en":"Before, there was no mountain, not an ankle's height,"},{"id":"manas-2010:p0211:b001:l038","ordinal":9355,"en":"No hollow to crouch and enter,"},{"id":"manas-2010:p0211:b001:l039","ordinal":9356,"en":"No furrow drawn by a plow,"},{"id":"manas-2010:p0211:b001:l040","ordinal":9357,"en":"No burrow dug by a marmot."},{"id":"manas-2010:p0211:b001:l041","ordinal":9358,"en":"On the yellow plain like the moon,"},{"id":"manas-2010:p0211:b001:l042","ordinal":9359,"en":"The surpassing champion, hero Zholoy,"},{"id":"manas-2010:p0211:b001:l043","ordinal":9360,"en":"With ten zhaysangs following him,"},{"id":"manas-2010:p0211:b001:l044","ordinal":9361,"en":"Mighty Zholoy was their chief."},{"id":"manas-2010:p0211:b001:l045","ordinal":9362,"en":"His front had been struck;"},{"id":"manas-2010:p0211:b001:l046","ordinal":9363,"en":"In addition to his champions,"},{"id":"manas-2010:p0211:b001:l047","ordinal":9364,"en":"He had lost his tea on a thousand camels."},{"id":"manas-2010:p0211:b001:l048","ordinal":9365,"en":"These men broke away from the champions,"},{"id":"manas-2010:p0212:b001:l001","ordinal":9366,"en":"Their hearts burning, not sparing their lives,"},{"id":"manas-2010:p0212:b001:l002","ordinal":9367,"en":"Their appearance showed they would die."},{"id":"manas-2010:p0212:b001:l003","ordinal":9368,"en":"At the spur where the mountain ended,"},{"id":"manas-2010:p0212:b001:l004","ordinal":9369,"en":"At a jutting point,"},{"id":"manas-2010:p0212:b001:l005","ordinal":9370,"en":"Mist rose in separate billows."},{"id":"manas-2010:p0212:b001:l006","ordinal":9371,"en":"Towering like a mighty mountain,"},{"id":"manas-2010:p0212:b001:l007","ordinal":9372,"en":"With twelve zhaysangs beside him,"},{"id":"manas-2010:p0212:b001:l008","ordinal":9373,"en":"Mighty Zholoy appeared."},{"id":"manas-2010:p0212:b001:l009","ordinal":9374,"en":"The strongest of the zhaysangs,"},{"id":"manas-2010:p0212:b001:l010","ordinal":9375,"en":"Scissor-eared Kaman the giant,"},{"id":"manas-2010:p0212:b001:l011","ordinal":9376,"en":"Vulture-tailed Zhoon the giant,"},{"id":"manas-2010:p0212:b001:l012","ordinal":9377,"en":"His champion Karachoyun,"},{"id":"manas-2010:p0212:b001:l013","ordinal":9378,"en":"With twelve zhaysangs following him,"},{"id":"manas-2010:p0212:b001:l014","ordinal":9379,"en":"From the jutting mountain spur"},{"id":"manas-2010:p0212:b001:l015","ordinal":9380,"en":"Khan Zholoy emerged."},{"id":"manas-2010:p0212:b001:l016","ordinal":9381,"en":"Among many, that hero Zholoy,"},{"id":"manas-2010:p0212:b001:l017","ordinal":9382,"en":"Fighting a mighty battle,"},{"id":"manas-2010:p0212:b001:l018","ordinal":9383,"en":"That was the place of slaughter."},{"id":"manas-2010:p0212:b001:l019","ordinal":9384,"en":"There were lords, there were giants;"},{"id":"manas-2010:p0212:b001:l020","ordinal":9385,"en":"To those who knew, he had great weight."},{"id":"manas-2010:p0212:b001:l021","ordinal":9386,"en":"To seize and bind Manas,"},{"id":"manas-2010:p0212:b001:l022","ordinal":9387,"en":"The valiant one was eager."},{"id":"manas-2010:p0212:b001:l023","ordinal":9388,"en":"His dozen or so zhaysangs,"},{"id":"manas-2010:p0212:b001:l024","ordinal":9389,"en":"Every one of the champions,"},{"id":"manas-2010:p0212:b001:l025","ordinal":9390,"en":"A ravenous, surpassing man—"},{"id":"manas-2010:p0212:b001:l026","ordinal":9391,"en":"Clashing fiercely and jousting,"},{"id":"manas-2010:p0212:b001:l027","ordinal":9392,"en":"That was to be the place of slaughter."},{"id":"manas-2010:p0212:b001:l028","ordinal":9393,"en":"The hero Zholoy roared:"},{"id":"manas-2010:p0212:b001:l029","ordinal":9394,"en":"Scissor-eared Kaman the giant,"},{"id":"manas-2010:p0212:b001:l030","ordinal":9395,"en":"Calling his giant Kaman, he said:"},{"id":"manas-2010:p0212:b001:l031","ordinal":9396,"en":"‘From the bastard Burut Manas,"},{"id":"manas-2010:p0212:b001:l032","ordinal":9397,"en":"How shall we pass without taking revenge?"},{"id":"manas-2010:p0212:b001:l033","ordinal":9398,"en":"Unless we fight Manas to the death,"},{"id":"manas-2010:p0212:b001:l034","ordinal":9399,"en":"How shall we depart alive?"},{"id":"manas-2010:p0212:b001:l035","ordinal":9400,"en":"He began a fierce fury;"},{"id":"manas-2010:p0212:b001:l036","ordinal":9401,"en":"The valiant warrior Döngö,"},{"id":"manas-2010:p0212:b001:l037","ordinal":9402,"en":"With his champions laid sprawling,"},{"id":"manas-2010:p0212:b001:l038","ordinal":9403,"en":"He slaughtered them utterly."},{"id":"manas-2010:p0212:b001:l039","ordinal":9404,"en":"He began turmoil and raised strife."},{"id":"manas-2010:p0212:b001:l040","ordinal":9405,"en":"This Burut, may his house burn,"},{"id":"manas-2010:p0212:b001:l041","ordinal":9406,"en":"On the Topurak ridge"},{"id":"manas-2010:p0212:b001:l042","ordinal":9407,"en":"Took the tea of a thousand camels."},{"id":"manas-2010:p0212:b001:l043","ordinal":9408,"en":"He began the sorrow before;"},{"id":"manas-2010:p0212:b001:l044","ordinal":9409,"en":"If my monks fell into his hands,"},{"id":"manas-2010:p0212:b001:l045","ordinal":9410,"en":"Making their napes jut out,"},{"id":"manas-2010:p0212:b001:l046","ordinal":9411,"en":"He castrated them into geldings."},{"id":"manas-2010:p0212:b001:l047","ordinal":9412,"en":"Who has seen such oppression?"},{"id":"manas-2010:p0212:b001:l048","ordinal":9413,"en":"From this bastard Burut,"},{"id":"manas-2010:p0213:b001:l001","ordinal":9414,"en":"The hero Zholoy suffered it in anguish."},{"id":"manas-2010:p0213:b001:l002","ordinal":9415,"en":"Beijing's khan Esenkan"},{"id":"manas-2010:p0213:b001:l003","ordinal":9416,"en":"Sent him ahead to scout the way;"},{"id":"manas-2010:p0213:b001:l004","ordinal":9417,"en":"His Zholoy, whom he trusted firmly,"},{"id":"manas-2010:p0213:b001:l005","ordinal":9418,"en":"To the bastard Burut"},{"id":"manas-2010:p0213:b001:l006","ordinal":9419,"en":"Lost his many possessions."},{"id":"manas-2010:p0213:b001:l007","ordinal":9420,"en":"How shall we retreat without fighting to the death?"},{"id":"manas-2010:p0213:b001:l008","ordinal":9421,"en":"If he is a hero, against the Burut"},{"id":"manas-2010:p0213:b001:l009","ordinal":9422,"en":"Let us advance and wage battle."},{"id":"manas-2010:p0213:b001:l010","ordinal":9423,"en":"Having had everything slaughtered,"},{"id":"manas-2010:p0213:b001:l011","ordinal":9424,"en":"How can we stay alive?’"},{"id":"manas-2010:p0213:b001:l012","ordinal":9425,"en":"Achbuudan beneath him"},{"id":"manas-2010:p0213:b001:l013","ordinal":9426,"en":"Was a winged tulpar steed."},{"id":"manas-2010:p0213:b001:l014","ordinal":9427,"en":"His tail stuck out, his mane lay flat."},{"id":"manas-2010:p0213:b001:l015","ordinal":9428,"en":"The madman's Achbuudan,"},{"id":"manas-2010:p0213:b001:l016","ordinal":9429,"en":"If he chased a kulan, would not let it escape;"},{"id":"manas-2010:p0213:b001:l017","ordinal":9430,"en":"He was practiced against battling foes."},{"id":"manas-2010:p0213:b001:l018","ordinal":9431,"en":"Achbuudan beneath him,"},{"id":"manas-2010:p0213:b001:l019","ordinal":9432,"en":"He made him stride this way and that."},{"id":"manas-2010:p0213:b001:l020","ordinal":9433,"en":"Terrifying the zhaysangs,"},{"id":"manas-2010:p0213:b001:l021","ordinal":9434,"en":"Hurrying them in wrath,"},{"id":"manas-2010:p0213:b001:l022","ordinal":9435,"en":"What did valiant Zholoy do?"},{"id":"manas-2010:p0213:b001:l023","ordinal":9436,"en":"He did not stay still in grief."},{"id":"manas-2010:p0213:b001:l024","ordinal":9437,"en":"As though his father had just died,"},{"id":"manas-2010:p0213:b001:l025","ordinal":9438,"en":"He raised shrill shouts and uproar,"},{"id":"manas-2010:p0213:b001:l026","ordinal":9439,"en":"Struck the kettledrum once,"},{"id":"manas-2010:p0213:b001:l027","ordinal":9440,"en":"Clothed himself in blue-gray armor."},{"id":"manas-2010:p0213:b001:l028","ordinal":9441,"en":"If you were to look at Khan Zholoy,"},{"id":"manas-2010:p0213:b001:l029","ordinal":9442,"en":"He raged like a blue-gray tiger."},{"id":"manas-2010:p0213:b001:l030","ordinal":9443,"en":"His head was like a traveling hut;"},{"id":"manas-2010:p0213:b001:l031","ordinal":9444,"en":"His brows like a molting vulture."},{"id":"manas-2010:p0213:b001:l032","ordinal":9445,"en":"His wolf-like eyes stood out."},{"id":"manas-2010:p0213:b001:l033","ordinal":9446,"en":"That pig, may he be torn apart and die,"},{"id":"manas-2010:p0213:b001:l034","ordinal":9447,"en":"Showed an extraordinary form."},{"id":"manas-2010:p0213:b001:l035","ordinal":9448,"en":"Flat-nosed, skin-lidded eyes,"},{"id":"manas-2010:p0213:b001:l036","ordinal":9449,"en":"Low-browed, fierce in menace,"},{"id":"manas-2010:p0213:b001:l037","ordinal":9450,"en":"Abandon hope with this unbeliever."},{"id":"manas-2010:p0213:b001:l038","ordinal":9451,"en":"He was the Black Kalmyks' khan;"},{"id":"manas-2010:p0213:b001:l039","ordinal":9452,"en":"In jousting and battle,"},{"id":"manas-2010:p0213:b001:l040","ordinal":9453,"en":"He had always been a dangerous soul."},{"id":"manas-2010:p0213:b001:l041","ordinal":9454,"en":"Broad-bodied, fair in appearance,"},{"id":"manas-2010:p0213:b001:l042","ordinal":9455,"en":"In wrestling and war"},{"id":"manas-2010:p0213:b001:l043","ordinal":9456,"en":"He had long been thoroughly skilled."},{"id":"manas-2010:p0213:b001:l044","ordinal":9457,"en":"The accomplished great champion Zholoy"},{"id":"manas-2010:p0213:b001:l045","ordinal":9458,"en":"Had driven scissor-eared Kaman the giant"},{"id":"manas-2010:p0213:b001:l046","ordinal":9459,"en":"Before him as a support."},{"id":"manas-2010:p0213:b001:l047","ordinal":9460,"en":"Vulture-tailed Zhoon the giant"},{"id":"manas-2010:p0213:b001:l048","ordinal":9461,"en":"He had firmly chosen as a companion."},{"id":"manas-2010:p0214:b001:l001","ordinal":9462,"en":"His presence mighty, his menace fierce,"},{"id":"manas-2010:p0214:b001:l002","ordinal":9463,"en":"As though an evil spirit had struck his wife,"},{"id":"manas-2010:p0214:b001:l003","ordinal":9464,"en":"The panting unbelievers—"},{"id":"manas-2010:p0214:b001:l004","ordinal":9465,"en":"See the madman's condition."},{"id":"manas-2010:p0214:b001:l005","ordinal":9466,"en":"As though a slave had squandered his wealth,"},{"id":"manas-2010:p0214:b001:l006","ordinal":9467,"en":"Such was the madman's condition,"},{"id":"manas-2010:p0214:b001:l007","ordinal":9468,"en":"As though fleeing with pursuers close behind."},{"id":"manas-2010:p0214:b001:l008","ordinal":9469,"en":"Flustered, leading his people,"},{"id":"manas-2010:p0214:b001:l009","ordinal":9470,"en":"He girded his waist tightly."},{"id":"manas-2010:p0214:b001:l010","ordinal":9471,"en":"Zholoy, sheer calamity,"},{"id":"manas-2010:p0214:b001:l011","ordinal":9472,"en":"That pig, unable to bear it,"}]
