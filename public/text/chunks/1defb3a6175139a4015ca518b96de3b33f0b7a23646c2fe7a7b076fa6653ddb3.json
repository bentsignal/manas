[{"id":"manas-2010:p0074:b002:l048","ordinal":2817,"en":"“This is the one named Manas,” they said."},{"id":"manas-2010:p0075:b002:l001","ordinal":2818,"en":"Their discerning men examined him."},{"id":"manas-2010:p0075:b002:l002","ordinal":2819,"en":"“His name is Manas,” they said;"},{"id":"manas-2010:p0075:b002:l003","ordinal":2820,"en":"Could the champions fail to rejoice?"},{"id":"manas-2010:p0075:b002:l004","ordinal":2821,"en":"Some examined him:"},{"id":"manas-2010:p0075:b002:l005","ordinal":2822,"en":"“Stout of body, broad-shouldered,"},{"id":"manas-2010:p0075:b002:l006","ordinal":2823,"en":"He is truly a hero."},{"id":"manas-2010:p0075:b002:l007","ordinal":2824,"en":"He is indeed Manas himself,"},{"id":"manas-2010:p0075:b002:l008","ordinal":2825,"en":"More than himself, his very eye!”"},{"id":"manas-2010:p0075:b002:l009","ordinal":2826,"en":"Some said this:"},{"id":"manas-2010:p0075:b002:l010","ordinal":2827,"en":"“His right shoulder is broad;"},{"id":"manas-2010:p0075:b002:l011","ordinal":2828,"en":"He is the hero who will ruin the Oirat.”"},{"id":"manas-2010:p0075:b002:l012","ordinal":2829,"en":"Some said this:"},{"id":"manas-2010:p0075:b002:l013","ordinal":2830,"en":"“He has the bearing of a mighty mountain,"},{"id":"manas-2010:p0075:b002:l014","ordinal":2831,"en":"The whole world—"},{"id":"manas-2010:p0075:b002:l015","ordinal":2832,"en":"He has the will to slaughter it."},{"id":"manas-2010:p0075:b002:l016","ordinal":2833,"en":"Karykan, the khan of Beijing,"},{"id":"manas-2010:p0075:b002:l017","ordinal":2834,"en":"Truly knew this,"},{"id":"manas-2010:p0075:b002:l018","ordinal":2835,"en":"That mighty one.”"},{"id":"manas-2010:p0075:b002:l019","ordinal":2836,"en":"Some said this:"},{"id":"manas-2010:p0075:b002:l020","ordinal":2837,"en":"“He will chase white deer"},{"id":"manas-2010:p0075:b002:l021","ordinal":2838,"en":"And turn them into cattle."},{"id":"manas-2010:p0075:b002:l022","ordinal":2839,"en":"If he comes of age and becomes a man,"},{"id":"manas-2010:p0075:b002:l023","ordinal":2840,"en":"If he stands equal to a hero's son,"},{"id":"manas-2010:p0075:b002:l024","ordinal":2841,"en":"Beijing with its kakan—"},{"id":"manas-2010:p0075:b002:l025","ordinal":2842,"en":"He is the boy who will slaughter it.”"},{"id":"manas-2010:p0075:b002:l026","ordinal":2843,"en":"Some said this:"},{"id":"manas-2010:p0075:b002:l027","ordinal":2844,"en":"“This child named Manas"},{"id":"manas-2010:p0075:b002:l028","ordinal":2845,"en":"Is like a watching tiger;"},{"id":"manas-2010:p0075:b002:l029","ordinal":2846,"en":"Whoever clashes with him will not survive."},{"id":"manas-2010:p0075:b002:l030","ordinal":2847,"en":"High-browed, fierce in menace,"},{"id":"manas-2010:p0075:b002:l031","ordinal":2848,"en":"He lays low whoever challenges him."},{"id":"manas-2010:p0075:b002:l032","ordinal":2849,"en":"He is indeed Manas himself,"},{"id":"manas-2010:p0075:b002:l033","ordinal":2850,"en":"More than himself, his very eye!”"},{"id":"manas-2010:p0075:b002:l034","ordinal":2851,"en":"Some said this:"},{"id":"manas-2010:p0075:b002:l035","ordinal":2852,"en":"“He has a bearing unlike other mortals,"},{"id":"manas-2010:p0075:b002:l036","ordinal":2853,"en":"Chin-Machin and Kakan—"},{"id":"manas-2010:p0075:b002:l037","ordinal":2854,"en":"He has the will to slaughter them."},{"id":"manas-2010:p0075:b002:l038","ordinal":2855,"en":"Has the enemy fallen into our hands?"},{"id":"manas-2010:p0075:b002:l039","ordinal":2856,"en":"Truly God has given him to us!”"},{"id":"manas-2010:p0075:b002:l040","ordinal":2857,"en":"They bound the boy,"},{"id":"manas-2010:p0075:b002:l041","ordinal":2858,"en":"Thinking he would die."},{"id":"manas-2010:p0075:b002:l042","ordinal":2859,"en":"The champions all gathered,"},{"id":"manas-2010:p0075:b002:l043","ordinal":2860,"en":"Held a feast for twelve days,"},{"id":"manas-2010:p0075:b002:l044","ordinal":2861,"en":"Cast aside all sorrow,"},{"id":"manas-2010:p0075:b002:l045","ordinal":2862,"en":"Slaughtered their mules for the feast."},{"id":"manas-2010:p0075:b002:l046","ordinal":2863,"en":"All the executioners grew excited,"},{"id":"manas-2010:p0075:b002:l047","ordinal":2864,"en":"All the champions grew frenzied;"},{"id":"manas-2010:p0075:b002:l048","ordinal":2865,"en":"Your Muslim people bowed down,"},{"id":"manas-2010:p0076:b002:l001","ordinal":2866,"en":"The Chinese people rejoiced;"},{"id":"manas-2010:p0076:b002:l002","ordinal":2867,"en":"Calling him Manas, they bound him by force."},{"id":"manas-2010:p0076:b002:l003","ordinal":2868,"en":"The Chinese people, like black spiders,"},{"id":"manas-2010:p0076:b002:l004","ordinal":2869,"en":"Humiliated the people of Samarkan,"},{"id":"manas-2010:p0076:b002:l005","ordinal":2870,"en":"Drained the people's strength,"},{"id":"manas-2010:p0076:b002:l006","ordinal":2871,"en":"And seized from Samarkan"},{"id":"manas-2010:p0076:b002:l007","ordinal":2872,"en":"Their boy named Manas."},{"id":"manas-2010:p0076:b002:l008","ordinal":2873,"en":"“This is the one named Manas,” they said,"},{"id":"manas-2010:p0076:b002:l009","ordinal":2874,"en":"“This fulfills what was foretold,” they said."},{"id":"manas-2010:p0076:b002:l010","ordinal":2875,"en":"With an iron-rope net,"},{"id":"manas-2010:p0076:b002:l011","ordinal":2876,"en":"They surrounded him,"},{"id":"manas-2010:p0076:b002:l012","ordinal":2877,"en":"The boy, all those dagger-bearing men."},{"id":"manas-2010:p0076:b002:l013","ordinal":2878,"en":"Skilled at wielding an iron-headed mace,"},{"id":"manas-2010:p0076:b002:l014","ordinal":2879,"en":"The great diviner from Beijing"},{"id":"manas-2010:p0076:b002:l015","ordinal":2880,"en":"Said, “This is the one named Manas,”"},{"id":"manas-2010:p0076:b002:l016","ordinal":2881,"en":"And upon Jar Manas's head"},{"id":"manas-2010:p0076:b002:l017","ordinal":2882,"en":"Put a hood of iron."},{"id":"manas-2010:p0076:b002:l018","ordinal":2883,"en":"They secured his legs and feet,"},{"id":"manas-2010:p0076:b002:l019","ordinal":2884,"en":"Bound his eyes tightly,"},{"id":"manas-2010:p0076:b002:l020","ordinal":2885,"en":"And upon the people of Samarkan"},{"id":"manas-2010:p0076:b002:l021","ordinal":2886,"en":"Brought the Last Judgment."},{"id":"manas-2010:p0076:b002:l022","ordinal":2887,"en":"His name was Jar Manas;"},{"id":"manas-2010:p0076:b002:l023","ordinal":2888,"en":"Dwelling in Samarkan,"},{"id":"manas-2010:p0076:b002:l024","ordinal":2889,"en":"He was the son of Chong Eshen."},{"id":"manas-2010:p0076:b002:l025","ordinal":2890,"en":"“The hero Jar Manas is gone,” they said;"},{"id":"manas-2010:p0076:b002:l026","ordinal":2891,"en":"The people wept, the folk wept,"},{"id":"manas-2010:p0076:b002:l027","ordinal":2892,"en":"The whole multitude wept."},{"id":"manas-2010:p0076:b002:l028","ordinal":2893,"en":"A journey of six months, they said:"},{"id":"manas-2010:p0076:b002:l029","ordinal":2894,"en":"Would a mortal ever see Beijing,"},{"id":"manas-2010:p0076:b002:l030","ordinal":2895,"en":"Would anyone who went there return?"},{"id":"manas-2010:p0076:b002:l031","ordinal":2896,"en":"A land of no return, they called it:"},{"id":"manas-2010:p0076:b002:l032","ordinal":2897,"en":"To the people of the kakan's realm,"},{"id":"manas-2010:p0076:b002:l033","ordinal":2898,"en":"Would anyone who went there return?"},{"id":"manas-2010:p0076:b002:l034","ordinal":2899,"en":"The people of Samarkan grieved;"},{"id":"manas-2010:p0076:b002:l035","ordinal":2900,"en":"When he had reached seventeen years,"},{"id":"manas-2010:p0076:b002:l036","ordinal":2901,"en":"They were parted from Jar Manas."},{"id":"manas-2010:p0076:b002:l037","ordinal":2902,"en":"The forty Chinese tribes gathered,"},{"id":"manas-2010:p0076:b002:l038","ordinal":2903,"en":"Broke their evil designs,"},{"id":"manas-2010:p0076:b002:l039","ordinal":2904,"en":"And seized the boy."},{"id":"manas-2010:p0076:b002:l040","ordinal":2905,"en":"Against the seething infidels,"},{"id":"manas-2010:p0076:b002:l041","ordinal":2906,"en":"Could anyone fight and survive?"},{"id":"manas-2010:p0076:b002:l042","ordinal":2907,"en":"The Muslims' hearts grew calm;"},{"id":"manas-2010:p0076:b002:l043","ordinal":2908,"en":"Seizing the boy,"},{"id":"manas-2010:p0076:b002:l044","ordinal":2909,"en":"The infidels were cursed by God."},{"id":"manas-2010:p0076:b002:l045","ordinal":2910,"en":"They traveled toward Beijing,"},{"id":"manas-2010:p0076:b002:l046","ordinal":2911,"en":"Riding far, sparing no horses."},{"id":"manas-2010:p0076:b002:l047","ordinal":2912,"en":"When they reached the halfway point,"},{"id":"manas-2010:p0076:b002:l048","ordinal":2913,"en":"Giving six swift horses,"},{"id":"manas-2010:p0077:b002:l001","ordinal":2914,"en":"Karykan, khan of Beijing,"},{"id":"manas-2010:p0077:b002:l002","ordinal":2915,"en":"Giving him a palm-sized letter,"},{"id":"manas-2010:p0077:b002:l003","ordinal":2916,"en":"Half bronze, a copper idol,"},{"id":"manas-2010:p0077:b002:l004","ordinal":2917,"en":"Grasping it at a corner and turning it,"},{"id":"manas-2010:p0077:b002:l005","ordinal":2918,"en":"A trick rider, a swift runner on foot,"},{"id":"manas-2010:p0077:b002:l006","ordinal":2919,"en":"He sent the great diviner."},{"id":"manas-2010:p0077:b002:l007","ordinal":2920,"en":"When the great diviner entered,"},{"id":"manas-2010:p0077:b002:l008","ordinal":2921,"en":"“We have captured Manas and brought him,” he said;"},{"id":"manas-2010:p0077:b002:l009","ordinal":2922,"en":"When he brought the news to his khan,"},{"id":"manas-2010:p0077:b002:l010","ordinal":2923,"en":"Within the khan's palace,"},{"id":"manas-2010:p0077:b002:l011","ordinal":2924,"en":"At the kendeme where crowds stood,"},{"id":"manas-2010:p0077:b002:l012","ordinal":2925,"en":"Ken-Tun in the kendeme,"},{"id":"manas-2010:p0077:b002:l013","ordinal":2926,"en":"Beside that Ken,"},{"id":"manas-2010:p0077:b002:l014","ordinal":2927,"en":"People came and stood in throngs."},{"id":"manas-2010:p0077:b002:l015","ordinal":2928,"en":"In the kendeme was a tower,"},{"id":"manas-2010:p0077:b002:l016","ordinal":2929,"en":"The tower was a marvel indeed;"},{"id":"manas-2010:p0077:b002:l017","ordinal":2930,"en":"Do not ask about that tower!"},{"id":"manas-2010:p0077:b002:l018","ordinal":2931,"en":"Its base was founded on stone;"},{"id":"manas-2010:p0077:b002:l019","ordinal":2932,"en":"Stone was heaped around it,"},{"id":"manas-2010:p0077:b002:l020","ordinal":2933,"en":"It was cast from blue-gray iron."},{"id":"manas-2010:p0077:b002:l021","ordinal":2934,"en":"If you ask about that tower,"},{"id":"manas-2010:p0077:b002:l022","ordinal":2935,"en":"It was nine hundred armspans high;"},{"id":"manas-2010:p0077:b002:l023","ordinal":2936,"en":"The bell upon its top,"},{"id":"manas-2010:p0077:b002:l024","ordinal":2937,"en":"When they struck that bell,"},{"id":"manas-2010:p0077:b002:l025","ordinal":2938,"en":"For nine days' journey around"},{"id":"manas-2010:p0077:b002:l026","ordinal":2939,"en":"It could be heard without fail;"},{"id":"manas-2010:p0077:b002:l027","ordinal":2940,"en":"Its reach was true indeed."},{"id":"manas-2010:p0077:b002:l028","ordinal":2941,"en":"A light was lit upon the tower,"},{"id":"manas-2010:p0077:b002:l029","ordinal":2942,"en":"The bell was beaten hard,"},{"id":"manas-2010:p0077:b002:l030","ordinal":2943,"en":"The Torgut gathered to a man."},{"id":"manas-2010:p0077:b002:l031","ordinal":2944,"en":"The many lords thronged together;"},{"id":"manas-2010:p0077:b002:l032","ordinal":2945,"en":"Of the jacket-wearing Chinese,"},{"id":"manas-2010:p0077:b002:l033","ordinal":2946,"en":"Their strongest men gathered."},{"id":"manas-2010:p0077:b002:l034","ordinal":2947,"en":"Of the Chinese with rank buttons on their caps,"},{"id":"manas-2010:p0077:b002:l035","ordinal":2948,"en":"Their bald heads gathered."},{"id":"manas-2010:p0077:b002:l036","ordinal":2949,"en":"To Esenkan and Karykan,"},{"id":"manas-2010:p0077:b002:l037","ordinal":2950,"en":"To both, the news was brought."},{"id":"manas-2010:p0077:b002:l038","ordinal":2951,"en":"Esenkan and Karykan,"},{"id":"manas-2010:p0077:b002:l039","ordinal":2952,"en":"Serving those two,"},{"id":"manas-2010:p0077:b002:l040","ordinal":2953,"en":"Had exactly a thousand champions."},{"id":"manas-2010:p0077:b002:l041","ordinal":2954,"en":"Upon a gold-patterned carpet"},{"id":"manas-2010:p0077:b002:l042","ordinal":2955,"en":"They placed the two of them."},{"id":"manas-2010:p0077:b002:l043","ordinal":2956,"en":"When their khan went out for pleasure,"},{"id":"manas-2010:p0077:b002:l044","ordinal":2957,"en":"It was the Chinese custom"},{"id":"manas-2010:p0077:b002:l045","ordinal":2958,"en":"For his champions to run."},{"id":"manas-2010:p0077:b002:l046","ordinal":2959,"en":"The champions beneath him"},{"id":"manas-2010:p0077:b002:l047","ordinal":2960,"en":"Came along in pairs;"},{"id":"manas-2010:p0077:b002:l048","ordinal":2961,"en":"Behind, the racing steed,"},{"id":"manas-2010:p0078:b002:l001","ordinal":2962,"en":"Twelve nobles led it riderless."},{"id":"manas-2010:p0078:b002:l002","ordinal":2963,"en":"When the khan came out for pleasure,"},{"id":"manas-2010:p0078:b002:l003","ordinal":2964,"en":"All his people gathered;"},{"id":"manas-2010:p0078:b002:l004","ordinal":2965,"en":"Many swine and countless livestock"},{"id":"manas-2010:p0078:b002:l005","ordinal":2966,"en":"Were slaughtered for the feast."},{"id":"manas-2010:p0078:b002:l006","ordinal":2967,"en":"A copper cauldron forty armspans across"},{"id":"manas-2010:p0078:b002:l007","ordinal":2968,"en":"They suspended in the street."},{"id":"manas-2010:p0078:b002:l008","ordinal":2969,"en":"They slaughtered forty pigs"},{"id":"manas-2010:p0078:b002:l009","ordinal":2970,"en":"And put them in together."},{"id":"manas-2010:p0078:b002:l010","ordinal":2971,"en":"They slaughtered forty oxen"},{"id":"manas-2010:p0078:b002:l011","ordinal":2972,"en":"And put those in together too."},{"id":"manas-2010:p0078:b002:l012","ordinal":2973,"en":"They slaughtered forty mules"},{"id":"manas-2010:p0078:b002:l013","ordinal":2974,"en":"And put those in as well."},{"id":"manas-2010:p0078:b002:l014","ordinal":2975,"en":"Forty of every kind,"},{"id":"manas-2010:p0078:b002:l015","ordinal":2976,"en":"Such was the Chinese custom,"},{"id":"manas-2010:p0078:b002:l016","ordinal":2977,"en":"They brought and put in now."},{"id":"manas-2010:p0078:b002:l017","ordinal":2978,"en":"The copper idol made of bronze,"},{"id":"manas-2010:p0078:b002:l018","ordinal":2979,"en":"Calling it “My God,”"},{"id":"manas-2010:p0078:b002:l019","ordinal":2980,"en":"They bound it up and hung it now."},{"id":"manas-2010:p0078:b002:l020","ordinal":2981,"en":"Their sorcerer started in alarm;"},{"id":"manas-2010:p0078:b002:l021","ordinal":2982,"en":"Of the Chinese with rank buttons on their caps,"},{"id":"manas-2010:p0078:b002:l022","ordinal":2983,"en":"Their bald heads gathered."},{"id":"manas-2010:p0078:b002:l023","ordinal":2984,"en":"Devising something no one could imagine,"},{"id":"manas-2010:p0078:b002:l024","ordinal":2985,"en":"Saying, “We have found our enemy,”"},{"id":"manas-2010:p0078:b002:l025","ordinal":2986,"en":"They feasted for exactly forty-five days."},{"id":"manas-2010:p0078:b002:l026","ordinal":2987,"en":"To the foot of the golden throne"},{"id":"manas-2010:p0078:b002:l027","ordinal":2988,"en":"They drove Jar Manas."},{"id":"manas-2010:p0078:b002:l028","ordinal":2989,"en":"Their Manchus were extraordinary,"},{"id":"manas-2010:p0078:b002:l029","ordinal":2990,"en":"Their champions beyond measure."},{"id":"manas-2010:p0078:b002:l030","ordinal":2991,"en":"Beneath the golden throne,"},{"id":"manas-2010:p0078:b002:l031","ordinal":2992,"en":"Forty rope-lengths in height,"},{"id":"manas-2010:p0078:b002:l032","ordinal":2993,"en":"Was a great dungeon."},{"id":"manas-2010:p0078:b002:l033","ordinal":2994,"en":"Without killing or destroying him,"},{"id":"manas-2010:p0078:b002:l034","ordinal":2995,"en":"They put him in alive."},{"id":"manas-2010:p0078:b002:l035","ordinal":2996,"en":"“The name of Manas is extinguished,” they said;"},{"id":"manas-2010:p0078:b002:l036","ordinal":2997,"en":"All the lords dispersed."},{"id":"manas-2010:p0078:b002:l037","ordinal":2998,"en":"Without killing or destroying"},{"id":"manas-2010:p0078:b002:l038","ordinal":2999,"en":"That poor man,"},{"id":"manas-2010:p0078:b002:l039","ordinal":3000,"en":"They kept him imprisoned twelve years."},{"id":"manas-2010:p0078:b002:l040","ordinal":3001,"en":"Let us leave that aside;"},{"id":"manas-2010:p0078:b002:l041","ordinal":3002,"en":"Now let us begin over here."},{"id":"manas-2010:p0078:b002:l042","ordinal":3003,"en":"The poor ones who went to Altay,"},{"id":"manas-2010:p0078:b002:l043","ordinal":3004,"en":"The heroes driven away,"},{"id":"manas-2010:p0078:b002:l044","ordinal":3005,"en":"Grieving, neither dead nor destroyed,"},{"id":"manas-2010:p0078:b002:l045","ordinal":3006,"en":"Parted from their people while alive,"},{"id":"manas-2010:p0078:b002:l046","ordinal":3007,"en":"Their hands bound as guilty men,"},{"id":"manas-2010:p0078:b002:l047","ordinal":3008,"en":"Driven toward Altay,"},{"id":"manas-2010:p0078:b002:l048","ordinal":3009,"en":"Had grown rich digging gold mines,"},{"id":"manas-2010:p0079:b002:l001","ordinal":3010,"en":"Sowing grain, keeping livestock,"},{"id":"manas-2010:p0079:b002:l002","ordinal":3011,"en":"Driving a san of cattle, they had grown rich."},{"id":"manas-2010:p0079:b002:l003","ordinal":3012,"en":"In Jakyp's service"},{"id":"manas-2010:p0079:b002:l004","ordinal":3013,"en":"Was Kochku from among the Kalmyks."},{"id":"manas-2010:p0079:b002:l005","ordinal":3014,"en":"He had set Oshpur over the sheep;"},{"id":"manas-2010:p0079:b002:l006","ordinal":3015,"en":"He had a servant with his camels."},{"id":"manas-2010:p0079:b002:l007","ordinal":3016,"en":"That dear rich man Jakyp,"},{"id":"manas-2010:p0079:b002:l008","ordinal":3017,"en":"On the blessed night of Friday,"},{"id":"manas-2010:p0079:b002:l009","ordinal":3018,"en":"At the hour of midnight,"},{"id":"manas-2010:p0079:b002:l010","ordinal":3019,"en":"Saw a dream in his sleep,"},{"id":"manas-2010:p0079:b002:l011","ordinal":3020,"en":"Saw a good thing in his dream."},{"id":"manas-2010:p0079:b002:l012","ordinal":3021,"en":"Poor Jakyp, parted from his people,"},{"id":"manas-2010:p0079:b002:l013","ordinal":3022,"en":"From his quail-like eyes"},{"id":"manas-2010:p0079:b002:l014","ordinal":3023,"en":"Tears fell drop by drop;"},{"id":"manas-2010:p0079:b002:l015","ordinal":3024,"en":"From his currant-black eyes"},{"id":"manas-2010:p0079:b002:l016","ordinal":3025,"en":"Tears fell a whip-length long."},{"id":"manas-2010:p0079:b002:l017","ordinal":3026,"en":"His heart was sorely torn;"},{"id":"manas-2010:p0079:b002:l018","ordinal":3027,"en":"That rich man Jakyp's"},{"id":"manas-2010:p0079:b002:l019","ordinal":3028,"en":"Tears poured from his eyes,"},{"id":"manas-2010:p0079:b002:l020","ordinal":3029,"en":"His rib bones seemed to split,"},{"id":"manas-2010:p0079:b002:l021","ordinal":3030,"en":"And paradise appeared in his dream."},{"id":"manas-2010:p0079:b002:l022","ordinal":3031,"en":"Having seen the dream, rich Jakyp,"},{"id":"manas-2010:p0079:b002:l023","ordinal":3032,"en":"His heart sorely torn,"},{"id":"manas-2010:p0079:b002:l024","ordinal":3033,"en":"Without looking all around,"},{"id":"manas-2010:p0079:b002:l025","ordinal":3034,"en":"With a grievous burden upon him,"},{"id":"manas-2010:p0079:b002:l026","ordinal":3035,"en":"Sparing not his thread of life, said:"},{"id":"manas-2010:p0079:b002:l027","ordinal":3036,"en":"“The san of cattle I have raised,"},{"id":"manas-2010:p0079:b002:l028","ordinal":3037,"en":"If my dream comes true,” he said,"},{"id":"manas-2010:p0079:b002:l029","ordinal":3038,"en":"“Let me finish them off together,” he said,"},{"id":"manas-2010:p0079:b002:l030","ordinal":3039,"en":"“This san of cattle standing here,"},{"id":"manas-2010:p0079:b002:l031","ordinal":3040,"en":"Let me slaughter every one,” he said."},{"id":"manas-2010:p0079:b002:l032","ordinal":3041,"en":"Your rich man Jakyp thought this;"},{"id":"manas-2010:p0079:b002:l033","ordinal":3042,"en":"The best of the forty households,"},{"id":"manas-2010:p0079:b002:l034","ordinal":3043,"en":"Their shamans who struck with lungs,"},{"id":"manas-2010:p0079:b002:l035","ordinal":3044,"en":"Their best men who would rise to the task,"},{"id":"manas-2010:p0079:b002:l036","ordinal":3045,"en":"With mighty Akbaltay at their head,"},{"id":"manas-2010:p0079:b002:l037","ordinal":3046,"en":"Your warrior Jakyp wept."},{"id":"manas-2010:p0079:b002:l038","ordinal":3047,"en":"The forty Kyrgyz households and Akbaltay,"},{"id":"manas-2010:p0079:b002:l039","ordinal":3048,"en":"He summoned every one of them;"},{"id":"manas-2010:p0079:b002:l040","ordinal":3049,"en":"The precious dream he saw by night,"},{"id":"manas-2010:p0079:b002:l041","ordinal":3050,"en":"He gathered them to interpret it."},{"id":"manas-2010:p0079:b002:l042","ordinal":3051,"en":"“For rich Jakyp's dream,” they said;"},{"id":"manas-2010:p0079:b002:l043","ordinal":3052,"en":"The forty Kyrgyz households came now."},{"id":"manas-2010:p0079:b002:l044","ordinal":3053,"en":"Having gathered the Kyrgyz,"},{"id":"manas-2010:p0079:b002:l045","ordinal":3054,"en":"Rich Jakyp broke into tears:"},{"id":"manas-2010:p0079:b002:l046","ordinal":3055,"en":"“I have many herds, but no heir;"},{"id":"manas-2010:p0079:b002:l047","ordinal":3056,"en":"Worse than all afflictions is this burden:"},{"id":"manas-2010:p0079:b002:l048","ordinal":3057,"en":"I have no way to obtain a child."},{"id":"manas-2010:p0080:b002:l001","ordinal":3058,"en":"Inside is sorrow, outside burning coals."},{"id":"manas-2010:p0080:b002:l002","ordinal":3059,"en":"To inherit my great herds,"},{"id":"manas-2010:p0080:b002:l003","ordinal":3060,"en":"I look, but I have no son."},{"id":"manas-2010:p0080:b002:l004","ordinal":3061,"en":"Nor have I any means to obtain a child;"},{"id":"manas-2010:p0080:b002:l005","ordinal":3062,"en":"Unless my sovereign God grants it,"},{"id":"manas-2010:p0080:b002:l006","ordinal":3063,"en":"There is no other way."},{"id":"manas-2010:p0080:b002:l007","ordinal":3064,"en":"My yaks have reached ninety thousand,"},{"id":"manas-2010:p0080:b002:l008","ordinal":3065,"en":"My wealth has become famous among the people."},{"id":"manas-2010:p0080:b002:l009","ordinal":3066,"en":"My herds are a tümen; I have no child."},{"id":"manas-2010:p0080:b002:l010","ordinal":3067,"en":"Unless the Creator makes it possible,"},{"id":"manas-2010:p0080:b002:l011","ordinal":3068,"en":"I have no other way.”"},{"id":"manas-2010:p0080:b002:l012","ordinal":3069,"en":"Five nines, each headed by a mare,"},{"id":"manas-2010:p0080:b002:l013","ordinal":3070,"en":"He took and slaughtered for his wish."},{"id":"manas-2010:p0080:b002:l014","ordinal":3071,"en":"Four nines, each headed by a camel,"},{"id":"manas-2010:p0080:b002:l015","ordinal":3072,"en":"For the destitute and the poor,"}]
