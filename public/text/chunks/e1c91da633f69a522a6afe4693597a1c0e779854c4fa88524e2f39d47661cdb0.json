[{"id":"semetey-1-2013:p0581:b003:l023","ordinal":121089,"en":"My calamities, above my head,"},{"id":"semetey-1-2013:p0581:b003:l024","ordinal":121090,"en":"You met me when they had grown many."},{"id":"semetey-1-2013:p0581:b003:l025","ordinal":121091,"en":"My courser saddle-sore, poor creature,"},{"id":"semetey-1-2013:p0581:b003:l026","ordinal":121092,"en":"You met it when it had grown thin."},{"id":"semetey-1-2013:p0581:b003:l027","ordinal":121093,"en":"My steel gone, myself dying,"},{"id":"semetey-1-2013:p0581:b003:l028","ordinal":121094,"en":"You met me when I had grown old."},{"id":"semetey-1-2013:p0581:b003:l029","ordinal":121095,"en":"My foal who would take Kokcholok,"},{"id":"semetey-1-2013:p0581:b003:l030","ordinal":121096,"en":"Stand there before me; do not hurry."},{"id":"semetey-1-2013:p0581:b003:l031","ordinal":121097,"en":"If you are a man, you wretch,"},{"id":"semetey-1-2013:p0581:b003:l032","ordinal":121098,"en":"Stand firm; do not run away."},{"id":"semetey-1-2013:p0581:b003:l033","ordinal":121099,"en":"The green river valley of Kapchygay"},{"id":"semetey-1-2013:p0581:b003:l034","ordinal":121100,"en":"Was a road I roamed."},{"id":"semetey-1-2013:p0581:b003:l035","ordinal":121101,"en":"Boys such as you,"},{"id":"semetey-1-2013:p0581:b003:l036","ordinal":121102,"en":"Eight thousand of them, smashing them,"},{"id":"semetey-1-2013:p0581:b003:l037","ordinal":121103,"en":"This was the hand that took them!”"},{"id":"semetey-1-2013:p0581:b003:l038","ordinal":121104,"en":"“Manas, Manas!” he shouted;"},{"id":"semetey-1-2013:p0581:b003:l039","ordinal":121105,"en":"God now struck the old man."},{"id":"semetey-1-2013:p0581:b004:l001","ordinal":121106,"en":"Striking Kokcholok once,"},{"id":"semetey-1-2013:p0581:b004:l002","ordinal":121107,"en":"Frowning in fury,"},{"id":"semetey-1-2013:p0581:b004:l003","ordinal":121108,"en":"Bakay came onto the ridge."},{"id":"semetey-1-2013:p0581:b004:l004","ordinal":121109,"en":"His fury grew;"},{"id":"semetey-1-2013:p0581:b004:l005","ordinal":121110,"en":"Without sparing his own life,"},{"id":"semetey-1-2013:p0581:b004:l006","ordinal":121111,"en":"Bakay saw a birch."},{"id":"semetey-1-2013:p0581:b004:l007","ordinal":121112,"en":"Leopard Bakay, your khan elder,"},{"id":"semetey-1-2013:p0581:b004:l008","ordinal":121113,"en":"Had a short-tailed beast beneath him."},{"id":"semetey-1-2013:p0581:b004:l009","ordinal":121114,"en":"Even if sixty Bakays died,"},{"id":"semetey-1-2013:p0581:b004:l010","ordinal":121115,"en":"He had the strength of a thousand men."},{"id":"semetey-1-2013:p0581:b004:l011","ordinal":121116,"en":"Bakay pulled the birch, wrenching it over;"},{"id":"semetey-1-2013:p0581:b004:l012","ordinal":121117,"en":"The birch, roots and all,"},{"id":"semetey-1-2013:p0581:b004:l013","ordinal":121118,"en":"He tore out and overturned,"},{"id":"semetey-1-2013:p0581:b004:l014","ordinal":121119,"en":"And made it into a club."},{"id":"semetey-1-2013:p0581:b004:l015","ordinal":121120,"en":"Kokcholok beneath him,"},{"id":"semetey-1-2013:p0581:b004:l016","ordinal":121121,"en":"Lashing right and left with his whip,"},{"id":"semetey-1-2013:p0581:b004:l017","ordinal":121122,"en":"Spurring on either side:"},{"id":"semetey-1-2013:p0581:b004:l018","ordinal":121123,"en":"“My child, if you are strong, stand without haste."},{"id":"semetey-1-2013:p0581:b004:l019","ordinal":121124,"en":"Stand before me; do not run away."},{"id":"semetey-1-2013:p0581:b004:l020","ordinal":121125,"en":"If you stand without fleeing, you are a hero,"},{"id":"semetey-1-2013:p0581:b004:l021","ordinal":121126,"en":"A valiant one with strength."},{"id":"semetey-1-2013:p0581:b004:l022","ordinal":121127,"en":"If you stand without fleeing, my foal,"},{"id":"semetey-1-2013:p0581:b004:l023","ordinal":121128,"en":"Let me see your strength;"},{"id":"semetey-1-2013:p0581:b004:l024","ordinal":121129,"en":"Let me split your head into eighty pieces!"},{"id":"semetey-1-2013:p0581:b004:l025","ordinal":121130,"en":"Let me pour out your blood by the leather flaskful;"},{"id":"semetey-1-2013:p0581:b004:l026","ordinal":121131,"en":"Let me tear your ribs apart!"},{"id":"semetey-1-2013:p0581:b004:l027","ordinal":121132,"en":"My brother-in-law, let me catch you,"},{"id":"semetey-1-2013:p0581:b004:l028","ordinal":121133,"en":"Drive you toward your sister,"},{"id":"semetey-1-2013:p0581:b004:l029","ordinal":121134,"en":"And finish you in disgrace!"},{"id":"semetey-1-2013:p0581:b004:l030","ordinal":121135,"en":"Kara-Shaar and Kambyl,"},{"id":"semetey-1-2013:p0581:b004:l031","ordinal":121136,"en":"This is the brother-in-law who besieged them."},{"id":"semetey-1-2013:p0581:b004:l032","ordinal":121137,"en":"Making the camels crack and crash,"},{"id":"semetey-1-2013:p0581:b004:l033","ordinal":121138,"en":"This is the hand that beat them."},{"id":"semetey-1-2013:p0581:b004:l034","ordinal":121139,"en":"Havoc upon Kakanchy,"},{"id":"semetey-1-2013:p0581:b004:l035","ordinal":121140,"en":"This is Bakay himself who brought it."},{"id":"semetey-1-2013:p0581:b004:l036","ordinal":121141,"en":"From many places, much booty,"},{"id":"semetey-1-2013:p0581:b004:l037","ordinal":121142,"en":"This is Bakay who took it."},{"id":"semetey-1-2013:p0581:b004:l038","ordinal":121143,"en":"I took Beijing, let alone mere land,"},{"id":"semetey-1-2013:p0581:b004:l039","ordinal":121144,"en":"Raiding farther beyond,"},{"id":"semetey-1-2013:p0582:b003:l001","ordinal":121145,"en":"My child, I raided Afghanistan, let alone you."},{"id":"semetey-1-2013:p0582:b003:l002","ordinal":121146,"en":"Your sister in her old age,"},{"id":"semetey-1-2013:p0582:b003:l003","ordinal":121147,"en":"My child, you have come to see her."},{"id":"semetey-1-2013:p0582:b003:l004","ordinal":121148,"en":"Your appointed death has come, at your brother-in-law's hands;"},{"id":"semetey-1-2013:p0582:b003:l005","ordinal":121149,"en":"My child, you have come to die."},{"id":"semetey-1-2013:p0582:b003:l006","ordinal":121150,"en":"My child, Judgment's narrow road,"},{"id":"semetey-1-2013:p0582:b003:l007","ordinal":121151,"en":"My foal, you have come to see it."},{"id":"semetey-1-2013:p0582:b003:l008","ordinal":121152,"en":"Ah, my child, I welcomed you as a guest,"},{"id":"semetey-1-2013:p0582:b003:l009","ordinal":121153,"en":"But you have come to hell!”"},{"id":"semetey-1-2013:p0582:b003:l010","ordinal":121154,"en":"So Bakay shouted,"},{"id":"semetey-1-2013:p0582:b003:l011","ordinal":121155,"en":"Taking the great club in his hand."},{"id":"semetey-1-2013:p0582:b003:l012","ordinal":121156,"en":"Now, as he sought his opportunity,"},{"id":"semetey-1-2013:p0582:b003:l013","ordinal":121157,"en":"Now, as he came to strike,"},{"id":"semetey-1-2013:p0582:b003:l014","ordinal":121158,"en":"Unable to stand Bakay's heat,"},{"id":"semetey-1-2013:p0582:b003:l015","ordinal":121159,"en":"Unable to lie in his cold,"},{"id":"semetey-1-2013:p0582:b003:l016","ordinal":121160,"en":"His lower ribs trembling then,"},{"id":"semetey-1-2013:p0582:b003:l017","ordinal":121161,"en":"The orphan left by Manas,"},{"id":"semetey-1-2013:p0582:b003:l018","ordinal":121162,"en":"His living heart trembled."},{"id":"semetey-1-2013:p0582:b003:l019","ordinal":121163,"en":"Seeing it, his heart was shaken."},{"id":"semetey-1-2013:p0582:b003:l020","ordinal":121164,"en":"Your elder Bakay, the heroic sultan,"},{"id":"semetey-1-2013:p0582:b003:l021","ordinal":121165,"en":"Appeared like Ala-Too."},{"id":"semetey-1-2013:p0582:b003:l022","ordinal":121166,"en":"If you saw his figure, Khan Bakay"},{"id":"semetey-1-2013:p0582:b003:l023","ordinal":121167,"en":"Thundered like Ala-Too."},{"id":"semetey-1-2013:p0582:b003:l024","ordinal":121168,"en":"The boy who stood watching,"},{"id":"semetey-1-2013:p0582:b003:l025","ordinal":121169,"en":"His whole body shuddered."},{"id":"semetey-1-2013:p0582:b003:l026","ordinal":121170,"en":"The boy could not stand it;"},{"id":"semetey-1-2013:p0582:b003:l027","ordinal":121171,"en":"His heart was sorely shaken."},{"id":"semetey-1-2013:p0582:b003:l028","ordinal":121172,"en":"Bakay, standing there watching,"},{"id":"semetey-1-2013:p0582:b003:l029","ordinal":121173,"en":"Then appeared like a dragon."},{"id":"semetey-1-2013:p0582:b003:l030","ordinal":121174,"en":"The boy could not stand it;"},{"id":"semetey-1-2013:p0582:b003:l031","ordinal":121175,"en":"Darting away on Aktulpar,"},{"id":"semetey-1-2013:p0582:b003:l032","ordinal":121176,"en":"Semetey shifted his position"},{"id":"semetey-1-2013:p0582:b003:l033","ordinal":121177,"en":"And fled in a flash."},{"id":"semetey-1-2013:p0582:b003:l034","ordinal":121178,"en":"‘This powerful Bakay is no good,’ he thought."},{"id":"semetey-1-2013:p0582:b003:l035","ordinal":121179,"en":"‘If I stand my ground, Khan Bakay"},{"id":"semetey-1-2013:p0582:b003:l036","ordinal":121180,"en":"Will not spare me with his club,’ he thought."},{"id":"semetey-1-2013:p0582:b003:l037","ordinal":121181,"en":"Then the boy, frightened, darted away;"},{"id":"semetey-1-2013:p0582:b003:l038","ordinal":121182,"en":"Your orphan made his escape,"},{"id":"semetey-1-2013:p0582:b003:l039","ordinal":121183,"en":"Flashing away on Aktulpar."},{"id":"semetey-1-2013:p0582:b004:l001","ordinal":121184,"en":"Then, shouting “Wretch!” in fury,"},{"id":"semetey-1-2013:p0582:b004:l002","ordinal":121185,"en":"Unable to strike Semetey,"},{"id":"semetey-1-2013:p0582:b004:l003","ordinal":121186,"en":"Bakay returned to his place, muttering."},{"id":"semetey-1-2013:p0582:b004:l004","ordinal":121187,"en":"The boy had not a fly's strength left."},{"id":"semetey-1-2013:p0582:b004:l005","ordinal":121188,"en":"Fleeing out onto a ridge,"},{"id":"semetey-1-2013:p0582:b004:l006","ordinal":121189,"en":"Semetey turned and stood;"},{"id":"semetey-1-2013:p0582:b004:l007","ordinal":121190,"en":"Khan Bakay then"},{"id":"semetey-1-2013:p0582:b004:l008","ordinal":121191,"en":"He deceived with cries of “Dear brother-in-law.”"},{"id":"semetey-1-2013:p0582:b004:l009","ordinal":121192,"en":"“You were a thoroughbred that would never grow thin;"},{"id":"semetey-1-2013:p0582:b004:l010","ordinal":121193,"en":"Brother-in-law, you have wasted away."},{"id":"semetey-1-2013:p0582:b004:l011","ordinal":121194,"en":"You were khan to the people of the whole world;"},{"id":"semetey-1-2013:p0582:b004:l012","ordinal":121195,"en":"Brother-in-law, you have grown old."},{"id":"semetey-1-2013:p0582:b004:l013","ordinal":121196,"en":"When Khan Manas died, all died;"},{"id":"semetey-1-2013:p0582:b004:l014","ordinal":121197,"en":"Their chief, old Bakay, died;"},{"id":"semetey-1-2013:p0582:b004:l015","ordinal":121198,"en":"You have fallen into misery."},{"id":"semetey-1-2013:p0582:b004:l016","ordinal":121199,"en":"You did not remain alive; you died."},{"id":"semetey-1-2013:p0582:b004:l017","ordinal":121200,"en":"Brother-in-law, you have seen the face of Judgment."},{"id":"semetey-1-2013:p0582:b004:l018","ordinal":121201,"en":"Brother-in-law, by asking for your Kokcholok,"},{"id":"semetey-1-2013:p0582:b004:l019","ordinal":121202,"en":"What wish would I fulfill?"},{"id":"semetey-1-2013:p0582:b004:l020","ordinal":121203,"en":"Or my sister who has grown old,"},{"id":"semetey-1-2013:p0582:b004:l021","ordinal":121204,"en":"If I took her from you,"},{"id":"semetey-1-2013:p0582:b004:l022","ordinal":121205,"en":"Where would I take her?"},{"id":"semetey-1-2013:p0582:b004:l023","ordinal":121206,"en":"Herding camels in the wilderness,"},{"id":"semetey-1-2013:p0582:b004:l024","ordinal":121207,"en":"Brother-in-law, you have become a quarrelsome man."},{"id":"semetey-1-2013:p0582:b004:l025","ordinal":121208,"en":"When a guest comes, you beat him;"},{"id":"semetey-1-2013:p0582:b004:l026","ordinal":121209,"en":"Brother-in-law, you have become rude."},{"id":"semetey-1-2013:p0582:b004:l027","ordinal":121210,"en":"Judgment's narrow road,"},{"id":"semetey-1-2013:p0582:b004:l028","ordinal":121211,"en":"Brother-in-law, you have seen it."},{"id":"semetey-1-2013:p0582:b004:l029","ordinal":121212,"en":"When your precious Manas died,"},{"id":"semetey-1-2013:p0582:b004:l030","ordinal":121213,"en":"This very year you died."},{"id":"semetey-1-2013:p0582:b004:l031","ordinal":121214,"en":"I journeyed from Chambyl;"},{"id":"semetey-1-2013:p0582:b004:l032","ordinal":121215,"en":"Sparing no horse, I traveled far."},{"id":"semetey-1-2013:p0582:b004:l033","ordinal":121216,"en":"My khan brother-in-law who has grown old,"},{"id":"semetey-1-2013:p0582:b004:l034","ordinal":121217,"en":"I came to ask after his welfare."},{"id":"semetey-1-2013:p0582:b004:l035","ordinal":121218,"en":"Your Khan Manas has died;"},{"id":"semetey-1-2013:p0582:b004:l036","ordinal":121219,"en":"Brother-in-law, I came to pay my respects."},{"id":"semetey-1-2013:p0582:b004:l037","ordinal":121220,"en":"Your famed land of Talas,"},{"id":"semetey-1-2013:p0582:b004:l038","ordinal":121221,"en":"Does it remain safe and sound,"},{"id":"semetey-1-2013:p0582:b004:l039","ordinal":121222,"en":"Brother-in-law, your small Kyrgyz people?”"},{"id":"semetey-1-2013:p0583:b003:l001","ordinal":121223,"en":"Hearing this news,"},{"id":"semetey-1-2013:p0583:b003:l002","ordinal":121224,"en":"Bakay now said:"},{"id":"semetey-1-2013:p0583:b003:l003","ordinal":121225,"en":"“My child, the people are well, the khan is well;"},{"id":"semetey-1-2013:p0583:b003:l004","ordinal":121226,"en":"All the multitude are well."},{"id":"semetey-1-2013:p0583:b003:l005","ordinal":121227,"en":"Tamarisk-covered Keng-Kol is safe;"},{"id":"semetey-1-2013:p0583:b003:l006","ordinal":121228,"en":"The small Kyrgyz people are safe."},{"id":"semetey-1-2013:p0583:b003:l007","ordinal":121229,"en":"Making my living by herding camels,"},{"id":"semetey-1-2013:p0583:b003:l008","ordinal":121230,"en":"I, your noble brother-in-law, am well."},{"id":"semetey-1-2013:p0583:b003:l011","ordinal":121231,"en":"My child, your spearhead is an armful;","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0583:b003:l013","ordinal":121232,"en":"‘Precious gems come from stone,’ they would say.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0583:b003:l014","ordinal":121233,"en":"‘Wisdom comes from the young,’ they would say."},{"id":"semetey-1-2013:p0583:b003:l015","ordinal":121234,"en":"My child, have you come from Bukhara?"},{"id":"semetey-1-2013:p0583:b003:l016","ordinal":121235,"en":"My child, have you heard news from Bukhara?"},{"id":"semetey-1-2013:p0583:b003:l017","ordinal":121236,"en":"Alty-Shaar, Margilan,"},{"id":"semetey-1-2013:p0583:b003:l018","ordinal":121237,"en":"Below them the khan of Kokand,"},{"id":"semetey-1-2013:p0583:b003:l019","ordinal":121238,"en":"Broad-naped Bukhara,"},{"id":"semetey-1-2013:p0583:b003:l020","ordinal":121239,"en":"Samarkand beside it—"},{"id":"semetey-1-2013:p0583:b003:l021","ordinal":121240,"en":"These were cities standing side by side."},{"id":"semetey-1-2013:p0583:b003:l022","ordinal":121241,"en":"They had messengers;"},{"id":"semetey-1-2013:p0583:b003:l023","ordinal":121242,"en":"Caravans used to come;"},{"id":"semetey-1-2013:p0583:b003:l024","ordinal":121243,"en":"News used to be heard."},{"id":"semetey-1-2013:p0583:b003:l025","ordinal":121244,"en":"Have you come from the direction of Bukhara?"},{"id":"semetey-1-2013:p0583:b003:l026","ordinal":121245,"en":"My child, have you heard news from Bukhara?"},{"id":"semetey-1-2013:p0583:b003:l027","ordinal":121246,"en":"When Leopard Manas died,"},{"id":"semetey-1-2013:p0583:b003:l028","ordinal":121247,"en":"When the people gathered and buried him,"},{"id":"semetey-1-2013:p0583:b003:l029","ordinal":121248,"en":"Kanykey was left in mourning;"},{"id":"semetey-1-2013:p0583:b003:l030","ordinal":121249,"en":"Semetey was left an orphan."},{"id":"semetey-1-2013:p0583:b003:l031","ordinal":121250,"en":"Abyke, Kobosh—the six villains,"},{"id":"semetey-1-2013:p0583:b003:l032","ordinal":121251,"en":"Those helpless dogs became enemies."},{"id":"semetey-1-2013:p0583:b003:l033","ordinal":121252,"en":"When they ravaged the possessions,"},{"id":"semetey-1-2013:p0583:b003:l034","ordinal":121253,"en":"When they wrought great havoc,"},{"id":"semetey-1-2013:p0583:b003:l035","ordinal":121254,"en":"Burning and smashing the palace,"},{"id":"semetey-1-2013:p0583:b003:l036","ordinal":121255,"en":"Taking the gold and swaggering,"},{"id":"semetey-1-2013:p0583:b003:l037","ordinal":121256,"en":"Abyke, Kobosh—the six villains,"},{"id":"semetey-1-2013:p0583:b003:l038","ordinal":121257,"en":"When they inflicted excessive humiliation,"},{"id":"semetey-1-2013:p0583:b003:l039","ordinal":121258,"en":"Brave Manas's forty nobles,"},{"id":"semetey-1-2013:p0583:b004:l001","ordinal":121259,"en":"When they destroyed the palace,"},{"id":"semetey-1-2013:p0583:b004:l002","ordinal":121260,"en":"Drawing bows to make a rain,"},{"id":"semetey-1-2013:p0583:b004:l003","ordinal":121261,"en":"Shooting missiles worse than hail,"},{"id":"semetey-1-2013:p0583:b004:l004","ordinal":121262,"en":"Disregarding the ancestral spirit,"},{"id":"semetey-1-2013:p0583:b004:l005","ordinal":121263,"en":"Khan Manas's forty nobles"},{"id":"semetey-1-2013:p0583:b004:l006","ordinal":121264,"en":"Moved from Talas amid strife,"},{"id":"semetey-1-2013:p0583:b004:l007","ordinal":121265,"en":"Went and settled in Urbus."},{"id":"semetey-1-2013:p0583:b004:l008","ordinal":121266,"en":"The forty swine made it their support."},{"id":"semetey-1-2013:p0583:b004:l009","ordinal":121267,"en":"After my noble Manas passed away,"},{"id":"semetey-1-2013:p0583:b004:l010","ordinal":121268,"en":"They sided with Abyke,"},{"id":"semetey-1-2013:p0583:b004:l011","ordinal":121269,"en":"Held up Kobosh as their banner."},{"id":"semetey-1-2013:p0583:b004:l012","ordinal":121270,"en":"The forty companions, against Kanykey,"},{"id":"semetey-1-2013:p0583:b004:l013","ordinal":121271,"en":"Raised an uproar no person had seen."},{"id":"semetey-1-2013:p0583:b004:l014","ordinal":121272,"en":"When they devised their wicked scheme,"},{"id":"semetey-1-2013:p0583:b004:l015","ordinal":121273,"en":"My child Kanykey's,"},{"id":"semetey-1-2013:p0583:b004:l016","ordinal":121274,"en":"That woman's, still in mourning,"},{"id":"semetey-1-2013:p0583:b004:l017","ordinal":121275,"en":"Breast they slashed open."},{"id":"semetey-1-2013:p0583:b004:l018","ordinal":121276,"en":"When my heroic lord died,"},{"id":"semetey-1-2013:p0583:b004:l019","ordinal":121277,"en":"When my lady suffered humiliation,"},{"id":"semetey-1-2013:p0583:b004:l020","ordinal":121278,"en":"When they scattered her countless gold,"},{"id":"semetey-1-2013:p0583:b004:l021","ordinal":121279,"en":"‘When a woman's husband dies,"},{"id":"semetey-1-2013:p0583:b004:l022","ordinal":121280,"en":"Her birth family is close,’ she said,"},{"id":"semetey-1-2013:p0583:b004:l023","ordinal":121281,"en":"And fled toward her father, Khan Temir."},{"id":"semetey-1-2013:p0583:b004:l024","ordinal":121282,"en":"Unable to cross Kuyuk Pass,"},{"id":"semetey-1-2013:p0583:b004:l025","ordinal":121283,"en":"Grieving and weeping, unable to walk,"},{"id":"semetey-1-2013:p0583:b004:l026","ordinal":121284,"en":"Unable to cross Jorgo Pass,"},{"id":"semetey-1-2013:p0583:b004:l027","ordinal":121285,"en":"Lamenting and weeping, unable to walk,"},{"id":"semetey-1-2013:p0583:b004:l028","ordinal":121286,"en":"Unable to reach the appointed place,"},{"id":"semetey-1-2013:p0583:b004:l029","ordinal":121287,"en":"Unable to go toward Bukhara,"},{"id":"semetey-1-2013:p0583:b004:l030","ordinal":121288,"en":"Wailing, weeping, crying aloud,"},{"id":"semetey-1-2013:p0583:b004:l031","ordinal":121289,"en":"Unable to cross Chakmak Pass,"},{"id":"semetey-1-2013:p0583:b004:l032","ordinal":121290,"en":"Unable to walk from exhaustion,"},{"id":"semetey-1-2013:p0583:b004:l033","ordinal":121291,"en":"With every step, her strength and vigor gone,"},{"id":"semetey-1-2013:p0583:b004:l034","ordinal":121292,"en":"Blood ran a saddle-strap's length from her calves."},{"id":"semetey-1-2013:p0583:b004:l035","ordinal":121293,"en":"Her soles were all gouged open;"},{"id":"semetey-1-2013:p0583:b004:l036","ordinal":121294,"en":"The flesh of her heels was flayed;"},{"id":"semetey-1-2013:p0583:b004:l037","ordinal":121295,"en":"Her soft soles were torn to pieces;"},{"id":"semetey-1-2013:p0583:b004:l038","ordinal":121296,"en":"Every bone in her body ached."},{"id":"semetey-1-2013:p0583:b004:l039","ordinal":121297,"en":"Upon her was her long-awaited Semetey,"},{"id":"semetey-1-2013:p0584:b003:l001","ordinal":121298,"en":"Crying aloud with hunger,"},{"id":"semetey-1-2013:p0584:b003:l002","ordinal":121299,"en":"I, Bakay, caught up with them,"},{"id":"semetey-1-2013:p0584:b003:l003","ordinal":121300,"en":"Gave two swift horses,"},{"id":"semetey-1-2013:p0584:b003:l004","ordinal":121301,"en":"Gave two skins of milk."},{"id":"semetey-1-2013:p0584:b003:l005","ordinal":121302,"en":"My two-year-old wether, slaughtered for provisions then—"},{"id":"semetey-1-2013:p0584:b003:l006","ordinal":121303,"en":"I keep thinking he will not forget"},{"id":"semetey-1-2013:p0584:b003:l007","ordinal":121304,"en":"What I did at that time."},{"id":"semetey-1-2013:p0584:b003:l008","ordinal":121305,"en":"Hiding myself in Keng-Kol,"},{"id":"semetey-1-2013:p0584:b003:l009","ordinal":121306,"en":"The imposing, dear soul,"},{"id":"semetey-1-2013:p0584:b003:l010","ordinal":121307,"en":"The orphan left by Manas,"},{"id":"semetey-1-2013:p0584:b003:l011","ordinal":121308,"en":"Thus I sent him fleeing,"},{"id":"semetey-1-2013:p0584:b003:l012","ordinal":121309,"en":"Helped them cross Jorgo Pass,"},{"id":"semetey-1-2013:p0584:b003:l013","ordinal":121310,"en":"Sorrow-stricken Kanykey,"},{"id":"semetey-1-2013:p0584:b003:l014","ordinal":121311,"en":"Sent her fleeing from this Talas."},{"id":"semetey-1-2013:p0584:b003:l015","ordinal":121312,"en":"Helped her cross Kuyuk Pass,"},{"id":"semetey-1-2013:p0584:b003:l016","ordinal":121313,"en":"That fierce Kanykey,"},{"id":"semetey-1-2013:p0584:b003:l017","ordinal":121314,"en":"Sent her fleeing from this Talas."},{"id":"semetey-1-2013:p0584:b003:l018","ordinal":121315,"en":"Kanykey departed in mourning;"},{"id":"semetey-1-2013:p0584:b003:l019","ordinal":121316,"en":"When he was a nursing infant,"},{"id":"semetey-1-2013:p0584:b003:l020","ordinal":121317,"en":"Semetey fled to Bukhara."},{"id":"semetey-1-2013:p0584:b003:l021","ordinal":121318,"en":"He prospered by plundering his valuables."},{"id":"semetey-1-2013:p0584:b003:l022","ordinal":121319,"en":"This year, the courser's son Semetey"},{"id":"semetey-1-2013:p0584:b003:l023","ordinal":121320,"en":"Is twelve; he has grown up."},{"id":"semetey-1-2013:p0584:b003:l024","ordinal":121321,"en":"Have you come from the direction of Bukhara?"},{"id":"semetey-1-2013:p0584:b003:l025","ordinal":121322,"en":"Ah, my child, have you heard news from Bukhara?"},{"id":"semetey-1-2013:p0584:b003:l027","ordinal":121323,"en":"I grieve, thinking of Manas."},{"id":"semetey-1-2013:p0584:b003:l028","ordinal":121324,"en":"The long-awaited Semetey,"},{"id":"semetey-1-2013:p0584:b003:l029","ordinal":121325,"en":"‘Will he turn out like him?’ I wonder,"},{"id":"semetey-1-2013:p0584:b003:l030","ordinal":121326,"en":"And I grieve for the boy."},{"id":"semetey-1-2013:p0584:b003:l032","ordinal":121327,"en":"With Manas, I, a sorrowful soul,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0584:b003:l033","ordinal":121328,"en":"Was a friend unto Judgment."},{"id":"semetey-1-2013:p0584:b003:l034","ordinal":121329,"en":"I grieve, thinking of Manas."},{"id":"semetey-1-2013:p0584:b003:l035","ordinal":121330,"en":"Manas, gone to the other world,"},{"id":"semetey-1-2013:p0584:b003:l036","ordinal":121331,"en":"Honoring his spirit, a poor soul,"},{"id":"semetey-1-2013:p0584:b003:l037","ordinal":121332,"en":"I go on herding camels."},{"id":"semetey-1-2013:p0584:b003:l038","ordinal":121333,"en":"Shall I die herding camels?"},{"id":"semetey-1-2013:p0584:b003:l039","ordinal":121334,"en":"Shall I see the face of Judgment?"},{"id":"semetey-1-2013:p0584:b004:l001","ordinal":121335,"en":"My sorrow within scattered,"},{"id":"semetey-1-2013:p0584:b004:l002","ordinal":121336,"en":"My brow opening brightly,"},{"id":"semetey-1-2013:p0584:b004:l003","ordinal":121337,"en":"Shall I see Semetey's face?"},{"id":"semetey-1-2013:p0584:b004:l004","ordinal":121338,"en":"Wait a moment, my foal."},{"id":"semetey-1-2013:p0584:b004:l005","ordinal":121339,"en":"Now let me count the days,"},{"id":"semetey-1-2013:p0584:b004:l006","ordinal":121340,"en":"Let me put the days in writing."},{"id":"semetey-1-2013:p0584:b004:l007","ordinal":121341,"en":"Let me count the years,"},{"id":"semetey-1-2013:p0584:b004:l008","ordinal":121342,"en":"Now let me put the years in writing:"},{"id":"semetey-1-2013:p0584:b004:l009","ordinal":121343,"en":"There was the Mouse, there was the Cow,"},{"id":"semetey-1-2013:p0584:b004:l010","ordinal":121344,"en":"There was the Horse, and the Tiger,"}]
