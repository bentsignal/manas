[{"id":"manas-2010:p1465:b001:l030","ordinal":63233,"en":"After the battle-axe struck,"},{"id":"manas-2010:p1465:b001:l031","ordinal":63234,"en":"He fell straight upon his head."},{"id":"manas-2010:p1465:b001:l032","ordinal":63235,"en":"The call to prayer fell silent;"},{"id":"manas-2010:p1465:b001:l033","ordinal":63236,"en":"Ajybay, who had fallen asleep,"},{"id":"manas-2010:p1465:b001:l034","ordinal":63237,"en":"Opened his eyes fully awake."},{"id":"manas-2010:p1465:b001:l035","ordinal":63238,"en":"Startled, Ajybay"},{"id":"manas-2010:p1465:b001:l036","ordinal":63239,"en":"Came dashing up."},{"id":"manas-2010:p1465:b001:l037","ordinal":63240,"en":"As the grim-faced one fled,"},{"id":"manas-2010:p1465:b001:l038","ordinal":63241,"en":"Ajybay, born resourceful,"},{"id":"manas-2010:p1465:b001:l039","ordinal":63242,"en":"Struck once with his spear."},{"id":"manas-2010:p1465:b001:l040","ordinal":63243,"en":"The grim-faced one fled swiftly;"},{"id":"manas-2010:p1465:b001:l041","ordinal":63244,"en":"After the spear struck squarely,"},{"id":"manas-2010:p1465:b001:l042","ordinal":63245,"en":"Shattering in many places,"},{"id":"manas-2010:p1466:b001:l001","ordinal":63246,"en":"When Ajybay thrust his spear,"},{"id":"manas-2010:p1466:b001:l002","ordinal":63247,"en":"Two rib bones,"},{"id":"manas-2010:p1466:b001:l003","ordinal":63248,"en":"Both crushed together,"},{"id":"manas-2010:p1466:b001:l004","ordinal":63249,"en":"Were shattered together."},{"id":"manas-2010:p1466:b001:l005","ordinal":63250,"en":"Kongurbay was wounded;"},{"id":"manas-2010:p1466:b001:l006","ordinal":63251,"en":"Algara beneath him"},{"id":"manas-2010:p1466:b001:l007","ordinal":63252,"en":"Moved forward at an amble."},{"id":"manas-2010:p1466:b001:l008","ordinal":63253,"en":"Black blood flowing from his flank"},{"id":"manas-2010:p1466:b001:l009","ordinal":63254,"en":"Streamed onto the dark earth."},{"id":"manas-2010:p1466:b001:l010","ordinal":63255,"en":"With people who knew nothing,"},{"id":"manas-2010:p1466:b001:l011","ordinal":63256,"en":"With his senses gone,"},{"id":"manas-2010:p1466:b001:l012","ordinal":63257,"en":"Losing strength and growing weak,"},{"id":"manas-2010:p1466:b001:l013","ordinal":63258,"en":"Losing his wits and staring dazed,"},{"id":"manas-2010:p1466:b001:l014","ordinal":63259,"en":"He barely made his way,"},{"id":"manas-2010:p1466:b001:l015","ordinal":63260,"en":"Bleeding without the blood stopping."},{"id":"manas-2010:p1466:b001:l016","ordinal":63261,"en":"Seeing the grim-faced one in this state,"},{"id":"manas-2010:p1466:b001:l017","ordinal":63262,"en":"When your grieving Ajy saw him,"},{"id":"manas-2010:p1466:b001:l018","ordinal":63263,"en":"“Manas has been wounded,”"},{"id":"manas-2010:p1466:b001:l019","ordinal":63264,"en":"Word spread among the multitude."},{"id":"manas-2010:p1466:b001:l020","ordinal":63265,"en":"The gates and doors were closed;"},{"id":"manas-2010:p1466:b001:l021","ordinal":63266,"en":"No winged bird could pass,"},{"id":"manas-2010:p1466:b001:l022","ordinal":63267,"en":"Beijing remained sealed tight,"},{"id":"manas-2010:p1466:b001:l023","ordinal":63268,"en":"No person could enter or leave,"},{"id":"manas-2010:p1466:b001:l024","ordinal":63269,"en":"A fortress standing all around."},{"id":"manas-2010:p1466:b001:l025","ordinal":63270,"en":"Kongurbay’s black horse,"},{"id":"manas-2010:p1466:b001:l026","ordinal":63271,"en":"His black horse had,"},{"id":"manas-2010:p1466:b001:l027","ordinal":63272,"en":"Upon its flanks, wings."},{"id":"manas-2010:p1466:b001:l028","ordinal":63273,"en":"Whenever there was a wall,"},{"id":"manas-2010:p1466:b001:l029","ordinal":63274,"en":"Curling like a cat,"},{"id":"manas-2010:p1466:b001:l030","ordinal":63275,"en":"It was his habit to leap across."},{"id":"manas-2010:p1466:b001:l031","ordinal":63276,"en":"The grim-faced one did not stand still;"},{"id":"manas-2010:p1466:b001:l032","ordinal":63277,"en":"When he struck the thigh with his whip,"},{"id":"manas-2010:p1466:b001:l033","ordinal":63278,"en":"Algara beneath him,"},{"id":"manas-2010:p1466:b001:l034","ordinal":63279,"en":"Over the high-built wall,"},{"id":"manas-2010:p1466:b001:l035","ordinal":63280,"en":"Leaped a whip’s length above it."},{"id":"manas-2010:p1466:b001:l037","ordinal":63281,"en":"All snapped and cracked apart.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p1466:b001:l038","ordinal":63282,"en":"The grim-faced one fell from atop him,"},{"id":"manas-2010:p1466:b001:l039","ordinal":63283,"en":"Tumbled from Algara,"},{"id":"manas-2010:p1466:b001:l040","ordinal":63284,"en":"Into a dug-out pit,"},{"id":"manas-2010:p1466:b001:l041","ordinal":63285,"en":"Fell inside and lay sprawled,"},{"id":"manas-2010:p1466:b001:l042","ordinal":63286,"en":"Fainting from loss of blood."},{"id":"manas-2010:p1467:b001:l001","ordinal":63287,"en":"Not one companion saw him."},{"id":"manas-2010:p1467:b001:l002","ordinal":63288,"en":"Alöökö’s son Kongurbay,"},{"id":"manas-2010:p1467:b001:l003","ordinal":63289,"en":"His death had not come; he did not die."},{"id":"manas-2010:p1467:b001:l004","ordinal":63290,"en":"From afar he had noticed:"},{"id":"manas-2010:p1467:b001:l005","ordinal":63291,"en":"Alöökö’s son Kongurbay"},{"id":"manas-2010:p1467:b001:l006","ordinal":63292,"en":"Had fallen into the pit;"},{"id":"manas-2010:p1467:b001:l007","ordinal":63293,"en":"Shuykuchu had seen it."},{"id":"manas-2010:p1467:b001:l008","ordinal":63294,"en":"Seeing it, Shuykuchu"},{"id":"manas-2010:p1467:b001:l009","ordinal":63295,"en":"Now walked toward him."},{"id":"manas-2010:p1467:b001:l010","ordinal":63296,"en":"Over Kongurbay,"},{"id":"manas-2010:p1467:b001:l011","ordinal":63297,"en":"He spread a covering."},{"id":"manas-2010:p1467:b001:l012","ordinal":63298,"en":"For forty days the grim-faced one lay weak,"},{"id":"manas-2010:p1467:b001:l013","ordinal":63299,"en":"Remaining in the pit."},{"id":"manas-2010:p1467:b001:l014","ordinal":63300,"en":"Slipping unseen and running,"},{"id":"manas-2010:p1467:b001:l015","ordinal":63301,"en":"Shuykuchu kept coming."},{"id":"manas-2010:p1467:b001:l016","ordinal":63302,"en":"To the grim-faced one lying stretched out,"},{"id":"manas-2010:p1467:b001:l017","ordinal":63303,"en":"In plenty, three times a day,"},{"id":"manas-2010:p1467:b001:l018","ordinal":63304,"en":"His food and drink"},{"id":"manas-2010:p1467:b001:l019","ordinal":63305,"en":"Shuykuchu kept giving."},{"id":"manas-2010:p1467:b001:l020","ordinal":63306,"en":"He kept treating him as well,"},{"id":"manas-2010:p1467:b001:l021","ordinal":63307,"en":"Coming each day to tend him."},{"id":"manas-2010:p1467:b001:l022","ordinal":63308,"en":"Of Shuykuchu, not a single person"},{"id":"manas-2010:p1467:b001:l023","ordinal":63309,"en":"Knew what he was doing."},{"id":"manas-2010:p1467:b001:l024","ordinal":63310,"en":"Treating the grim-faced one,"},{"id":"manas-2010:p1467:b001:l025","ordinal":63311,"en":"He rekindled his extinguished fire,"},{"id":"manas-2010:p1467:b001:l026","ordinal":63312,"en":"Revived his dead soul."},{"id":"manas-2010:p1467:b001:l027","ordinal":63313,"en":"Quieting his pain,"},{"id":"manas-2010:p1467:b001:l028","ordinal":63314,"en":"Opening his eyes fully awake,"},{"id":"manas-2010:p1467:b001:l029","ordinal":63315,"en":"He showed his sorcery."},{"id":"manas-2010:p1467:b001:l030","ordinal":63316,"en":"The grim-faced one of the Chinese"},{"id":"manas-2010:p1467:b001:l031","ordinal":63317,"en":"He dressed in a wandering mendicant’s guise."},{"id":"manas-2010:p1467:b001:l032","ordinal":63318,"en":"Giving a white staff into his hand,"},{"id":"manas-2010:p1467:b001:l033","ordinal":63319,"en":"Having him ask the people for alms,"},{"id":"manas-2010:p1467:b001:l034","ordinal":63320,"en":"He sent the grim-faced one on his way."},{"id":"manas-2010:p1467:b001:l035","ordinal":63321,"en":"Kongurbay’s forty lords,"},{"id":"manas-2010:p1467:b001:l036","ordinal":63322,"en":"Twisting their black hair like a girth,"},{"id":"manas-2010:p1467:b001:l037","ordinal":63323,"en":"Gathering it atop their heads,"},{"id":"manas-2010:p1467:b001:l038","ordinal":63324,"en":"Were wearing it rolled up then."},{"id":"manas-2010:p1467:b001:l039","ordinal":63325,"en":"“When will our khan come?” they said,"},{"id":"manas-2010:p1467:b001:l040","ordinal":63326,"en":"Leading Algara,"},{"id":"manas-2010:p1467:b001:l041","ordinal":63327,"en":"All waiting to meet him,"},{"id":"manas-2010:p1467:b001:l042","ordinal":63328,"en":"They were in anguish then."},{"id":"manas-2010:p1468:b001:l001","ordinal":63329,"en":"Counting the days that passed,"},{"id":"manas-2010:p1468:b001:l002","ordinal":63330,"en":"It was the time they had reckoned;"},{"id":"manas-2010:p1468:b001:l003","ordinal":63331,"en":"If he did not come that day,"},{"id":"manas-2010:p1468:b001:l004","ordinal":63332,"en":"It was time for them to leave."},{"id":"manas-2010:p1468:b001:l005","ordinal":63333,"en":"Bringing Algara across,"},{"id":"manas-2010:p1468:b001:l006","ordinal":63334,"en":"The forty lords came bowing,"},{"id":"manas-2010:p1468:b001:l007","ordinal":63335,"en":"Showing reverence to their khan."},{"id":"manas-2010:p1468:b001:l008","ordinal":63336,"en":"Dismounting, all of them"},{"id":"manas-2010:p1468:b001:l009","ordinal":63337,"en":"Bowed respectfully."},{"id":"manas-2010:p1468:b001:l010","ordinal":63338,"en":"Thus the lords arrived;"},{"id":"manas-2010:p1468:b001:l011","ordinal":63339,"en":"Where they reached the grim-faced one,"},{"id":"manas-2010:p1468:b001:l012","ordinal":63340,"en":"They mounted him upon Algara,"},{"id":"manas-2010:p1468:b001:l013","ordinal":63341,"en":"And took him away."},{"id":"manas-2010:p1468:b001:l014","ordinal":63342,"en":"With the forty lords at their head,"},{"id":"manas-2010:p1468:b001:l015","ordinal":63343,"en":"Taking a long, difficult road,"},{"id":"manas-2010:p1468:b001:l016","ordinal":63344,"en":"Angled in the haze,"},{"id":"manas-2010:p1468:b001:l017","ordinal":63345,"en":"Pointed in the gloom,"},{"id":"manas-2010:p1468:b001:l018","ordinal":63346,"en":"The spur at the mountain’s end,"},{"id":"manas-2010:p1468:b001:l019","ordinal":63347,"en":"The junction of ninety roads,"},{"id":"manas-2010:p1468:b001:l020","ordinal":63348,"en":"The meeting of nine rivers,"},{"id":"manas-2010:p1468:b001:l021","ordinal":63349,"en":"Echoing Zhar-Kyya,"},{"id":"manas-2010:p1468:b001:l022","ordinal":63350,"en":"Before it a dense forest,"},{"id":"manas-2010:p1468:b001:l023","ordinal":63351,"en":"A single-horse track,"},{"id":"manas-2010:p1468:b001:l024","ordinal":63352,"en":"Along the only road,"},{"id":"manas-2010:p1468:b001:l025","ordinal":63353,"en":"Finding no mountain to assail,"},{"id":"manas-2010:p1468:b001:l026","ordinal":63354,"en":"Finding no enemy to fight,"},{"id":"manas-2010:p1468:b001:l027","ordinal":63355,"en":"Not resting to sleep their fill,"},{"id":"manas-2010:p1468:b001:l028","ordinal":63356,"en":"Not letting their steeds graze,"},{"id":"manas-2010:p1468:b001:l029","ordinal":63357,"en":"Unable to lie upon an elbow,"},{"id":"manas-2010:p1468:b001:l030","ordinal":63358,"en":"Taking not even a moment’s sleep,"},{"id":"manas-2010:p1468:b001:l031","ordinal":63359,"en":"From a broad ravine where no small bird flew,"},{"id":"manas-2010:p1468:b001:l032","ordinal":63360,"en":"From a plain where signal horns sounded,"},{"id":"manas-2010:p1468:b001:l033","ordinal":63361,"en":"Bracing themselves and barring the road,"},{"id":"manas-2010:p1468:b001:l034","ordinal":63362,"en":"The moon dark, the night overcast,"},{"id":"manas-2010:p1468:b001:l035","ordinal":63363,"en":"Three champions emerged from the hills—"},{"id":"manas-2010:p1468:b001:l036","ordinal":63364,"en":"Almambet, Chubak and hero Syrgak."},{"id":"manas-2010:p1468:b001:l037","ordinal":63365,"en":"Through suspicious places, the roads"},{"id":"manas-2010:p1468:b001:l038","ordinal":63366,"en":"They were ranging then."},{"id":"manas-2010:p1468:b001:l039","ordinal":63367,"en":"Suspecting the grim-faced one,"},{"id":"manas-2010:p1468:b001:l040","ordinal":63368,"en":"They were lying in wait for him."},{"id":"manas-2010:p1468:b001:l041","ordinal":63369,"en":"Almambet came out shouting,"},{"id":"manas-2010:p1468:b001:l042","ordinal":63370,"en":"Calling, “Islam!”"},{"id":"manas-2010:p1469:b001:l001","ordinal":63371,"en":"Tall of body, broad of shoulder,"},{"id":"manas-2010:p1469:b001:l002","ordinal":63372,"en":"Who never drew back from a charge,"},{"id":"manas-2010:p1469:b001:l003","ordinal":63373,"en":"Who never fled again from the enemy,"},{"id":"manas-2010:p1469:b001:l004","ordinal":63374,"en":"Came charging behind him,"},{"id":"manas-2010:p1469:b001:l005","ordinal":63375,"en":"Chubak, Khan Baltay’s son."},{"id":"manas-2010:p1469:b001:l006","ordinal":63376,"en":"Flames poured from his eyes;"},{"id":"manas-2010:p1469:b001:l007","ordinal":63377,"en":"Ahead of them all,"},{"id":"manas-2010:p1469:b001:l008","ordinal":63378,"en":"A bowshot apart,"},{"id":"manas-2010:p1469:b001:l009","ordinal":63379,"en":"Not looking all around,"},{"id":"manas-2010:p1469:b001:l010","ordinal":63380,"en":"Not sparing his life at all,"},{"id":"manas-2010:p1469:b001:l011","ordinal":63381,"en":"Syrgak, Ulak Khan’s son,"},{"id":"manas-2010:p1469:b001:l012","ordinal":63382,"en":"Came like an arrow."},{"id":"manas-2010:p1469:b001:l013","ordinal":63383,"en":"At the terror of the three champions,"},{"id":"manas-2010:p1469:b001:l014","ordinal":63384,"en":"The earth split and rumbled."},{"id":"manas-2010:p1469:b001:l015","ordinal":63385,"en":"Like tethered lions,"},{"id":"manas-2010:p1469:b001:l016","ordinal":63386,"en":"Thundering like a storm,"},{"id":"manas-2010:p1469:b001:l017","ordinal":63387,"en":"The forty lords and Kongurbay,"},{"id":"manas-2010:p1469:b001:l018","ordinal":63388,"en":"Unable to bear their heat,"},{"id":"manas-2010:p1469:b001:l019","ordinal":63389,"en":"Fled one by one."},{"id":"manas-2010:p1469:b001:l020","ordinal":63390,"en":"Alöökö’s son Kongurbay"},{"id":"manas-2010:p1469:b001:l021","ordinal":63391,"en":"Truly fled, trembling."},{"id":"manas-2010:p1469:b001:l022","ordinal":63392,"en":"The earth split, dust rose;"},{"id":"manas-2010:p1469:b001:l023","ordinal":63393,"en":"At Almambet, Chubak and Syrgak’s"},{"id":"manas-2010:p1469:b001:l024","ordinal":63394,"en":"Voices, souls fled their bodies."},{"id":"manas-2010:p1469:b001:l025","ordinal":63395,"en":"Splitting into separate groups,"},{"id":"manas-2010:p1469:b001:l026","ordinal":63396,"en":"The forty lords took flight."},{"id":"manas-2010:p1469:b001:l027","ordinal":63397,"en":"From behind them, hero Syrgak"},{"id":"manas-2010:p1469:b001:l028","ordinal":63398,"en":"Separated twenty,"},{"id":"manas-2010:p1469:b001:l029","ordinal":63399,"en":"And drove them before him."},{"id":"manas-2010:p1469:b001:l030","ordinal":63400,"en":"Chubak, Akbaltay’s son,"},{"id":"manas-2010:p1469:b001:l031","ordinal":63401,"en":"Separated ten."},{"id":"manas-2010:p1469:b001:l032","ordinal":63402,"en":"Driving eleven before him,"},{"id":"manas-2010:p1469:b001:l033","ordinal":63403,"en":"With Kongurbay at their head,"},{"id":"manas-2010:p1469:b001:l034","ordinal":63404,"en":"Almambet now pursued them."},{"id":"manas-2010:p1469:b001:l035","ordinal":63405,"en":"Upon the grim-faced wretch, calamity"},{"id":"manas-2010:p1469:b001:l036","ordinal":63406,"en":"Almambet brought as he went,"},{"id":"manas-2010:p1469:b001:l037","ordinal":63407,"en":"Making them crawl wherever he reached,"},{"id":"manas-2010:p1469:b001:l038","ordinal":63408,"en":"Destroying whoever he met,"},{"id":"manas-2010:p1469:b001:l039","ordinal":63409,"en":"Gouging his way onward."},{"id":"manas-2010:p1469:b001:l040","ordinal":63410,"en":"Your Alma had made battle;"},{"id":"manas-2010:p1469:b001:l041","ordinal":63411,"en":"The grim-faced one’s ten lords"},{"id":"manas-2010:p1469:b001:l042","ordinal":63412,"en":"He had slaughtered utterly."},{"id":"manas-2010:p1470:b001:l001","ordinal":63413,"en":"Alöökö’s son Kongurbay,"},{"id":"manas-2010:p1470:b001:l002","ordinal":63414,"en":"Fighting a dog’s fight,"},{"id":"manas-2010:p1470:b001:l003","ordinal":63415,"en":"Turning back again and again,"},{"id":"manas-2010:p1470:b001:l004","ordinal":63416,"en":"Grappled with Almambet."},{"id":"manas-2010:p1470:b001:l005","ordinal":63417,"en":"Syrgak, Ulak Khan’s son,"},{"id":"manas-2010:p1470:b001:l006","ordinal":63418,"en":"Making his spearpoint bloody,"},{"id":"manas-2010:p1470:b001:l007","ordinal":63419,"en":"Making grain of those he met,"},{"id":"manas-2010:p1470:b001:l008","ordinal":63420,"en":"Laying them low, sparing none,"},{"id":"manas-2010:p1470:b001:l009","ordinal":63421,"en":"Shouting, “Alake!”"},{"id":"manas-2010:p1470:b001:l010","ordinal":63422,"en":"Syrgak came pleading."},{"id":"manas-2010:p1470:b001:l011","ordinal":63423,"en":"The fleeing grim-faced one,"},{"id":"manas-2010:p1470:b001:l012","ordinal":63424,"en":"“Stop him!” he shouted."},{"id":"manas-2010:p1470:b001:l013","ordinal":63425,"en":"Bellowing, “Almambet!”"},{"id":"manas-2010:p1470:b001:l014","ordinal":63426,"en":"Having destroyed his ten lords,"},{"id":"manas-2010:p1470:b001:l015","ordinal":63427,"en":"Slaughtered them all, sparing none,"},{"id":"manas-2010:p1470:b001:l016","ordinal":63428,"en":"Hero Chubak came on."},{"id":"manas-2010:p1470:b001:l017","ordinal":63429,"en":"Behind Almambet,"},{"id":"manas-2010:p1470:b001:l018","ordinal":63430,"en":"Shouting with all his life,"},{"id":"manas-2010:p1470:b001:l019","ordinal":63431,"en":"So many curved ridges"},{"id":"manas-2010:p1470:b001:l020","ordinal":63432,"en":"Kongurbay crossed."},{"id":"manas-2010:p1470:b001:l021","ordinal":63433,"en":"Without the strength to grapple,"},{"id":"manas-2010:p1470:b001:l022","ordinal":63434,"en":"Looking neither ahead nor behind,"},{"id":"manas-2010:p1470:b001:l023","ordinal":63435,"en":"Not considering matters of honor,"},{"id":"manas-2010:p1470:b001:l024","ordinal":63436,"en":"Kongurbay took flight."},{"id":"manas-2010:p1470:b001:l025","ordinal":63437,"en":"Pursuing and pursuing, unable to catch him,"},{"id":"manas-2010:p1470:b001:l026","ordinal":63438,"en":"The three champions halted together."},{"id":"manas-2010:p1470:b001:l027","ordinal":63439,"en":"Not letting any of the three catch him,"},{"id":"manas-2010:p1470:b001:l028","ordinal":63440,"en":"Kongurbay went on his way."},{"id":"manas-2010:p1470:b001:l029","ordinal":63441,"en":"Alöökö’s son Kongurbay"},{"id":"manas-2010:p1470:b001:l030","ordinal":63442,"en":"Now sent urgent word."},{"id":"manas-2010:p1470:b001:l031","ordinal":63443,"en":"“I have slain Manas,”"},{"id":"manas-2010:p1470:b001:l032","ordinal":63444,"en":"He sent word to everyone."},{"id":"manas-2010:p1470:b001:l033","ordinal":63445,"en":"When Kongurbay sent word,"},{"id":"manas-2010:p1470:b001:l034","ordinal":63446,"en":"They stirred without stopping;"},{"id":"manas-2010:p1470:b001:l035","ordinal":63447,"en":"Ninety Beijings rose."},{"id":"manas-2010:p1470:b001:l036","ordinal":63448,"en":"Earth flew up as dust;"},{"id":"manas-2010:p1470:b001:l037","ordinal":63449,"en":"The multitude of Chinese rose."},{"id":"manas-2010:p1470:b001:l038","ordinal":63450,"en":"The humiliation Manas inflicted"},{"id":"manas-2010:p1470:b001:l039","ordinal":63451,"en":"Turned to ice in their breasts."},{"id":"manas-2010:p1470:b001:l040","ordinal":63452,"en":"Raising their battle cries,"},{"id":"manas-2010:p1470:b001:l041","ordinal":63453,"en":"Gathering soldiers from the people,"},{"id":"manas-2010:p1470:b001:l042","ordinal":63454,"en":"Driving khans from the farthest edges,"},{"id":"manas-2010:p1471:b001:l001","ordinal":63455,"en":"Driving men from distant lands,"},{"id":"manas-2010:p1471:b001:l002","ordinal":63456,"en":"Driving the heaving lake,"},{"id":"manas-2010:p1471:b001:l003","ordinal":63457,"en":"Driving the flood that shattered mountains,"},{"id":"manas-2010:p1471:b001:l004","ordinal":63458,"en":"Who grew into heroes in the wilderness,"},{"id":"manas-2010:p1471:b001:l005","ordinal":63459,"en":"Driving the people called One-Eye,"},{"id":"manas-2010:p1471:b001:l006","ordinal":63460,"en":"The earth’s surface teemed;"},{"id":"manas-2010:p1471:b001:l007","ordinal":63461,"en":"Swarming as numerous as grains of sand,"},{"id":"manas-2010:p1471:b001:l008","ordinal":63462,"en":"Seething like ants,"},{"id":"manas-2010:p1471:b001:l009","ordinal":63463,"en":"Divided into troop after troop,"},{"id":"manas-2010:p1471:b001:l010","ordinal":63464,"en":"Grouped as sons of their fathers,"},{"id":"manas-2010:p1471:b001:l011","ordinal":63465,"en":"Each lineage separately,"},{"id":"manas-2010:p1471:b001:l012","ordinal":63466,"en":"They appeared and gave their tally."},{"id":"manas-2010:p1471:b001:l013","ordinal":63467,"en":"No one could tell it was night;"},{"id":"manas-2010:p1471:b001:l014","ordinal":63468,"en":"Earth flew up into the sky;"},{"id":"manas-2010:p1471:b001:l015","ordinal":63469,"en":"No one could tell it was day."},{"id":"manas-2010:p1471:b001:l016","ordinal":63470,"en":"Dust spread through the heavens."},{"id":"manas-2010:p1471:b001:l017","ordinal":63471,"en":"When they said Manas had died,"},{"id":"manas-2010:p1471:b001:l018","ordinal":63472,"en":"The multitude of Chinese, not one left out,"},{"id":"manas-2010:p1471:b001:l019","ordinal":63473,"en":"Had all arrived,"},{"id":"manas-2010:p1471:b001:l020","ordinal":63474,"en":"Their fighting men gathered."},{"id":"manas-2010:p1471:b001:l021","ordinal":63475,"en":"Look at the sand, look at the insects;"},{"id":"manas-2010:p1471:b001:l022","ordinal":63476,"en":"Swarming like ants,"},{"id":"manas-2010:p1471:b001:l023","ordinal":63477,"en":"Look at the mighty Chinese people!"},{"id":"manas-2010:p1471:b001:l024","ordinal":63478,"en":"Look at the grass upon the earth;"},{"id":"manas-2010:p1471:b001:l025","ordinal":63479,"en":"Look at Chinese as many as the grass!"},{"id":"manas-2010:p1471:b001:l026","ordinal":63480,"en":"When their army set out,"},{"id":"manas-2010:p1471:b001:l027","ordinal":63481,"en":"The spearpoints clashed;"},{"id":"manas-2010:p1471:b001:l028","ordinal":63482,"en":"So numerous was the mighty host,"},{"id":"manas-2010:p1471:b001:l029","ordinal":63483,"en":"They collided, unable to move."},{"id":"manas-2010:p1471:b001:l030","ordinal":63484,"en":"Commanders of fifty hurried breathlessly;"},{"id":"manas-2010:p1471:b001:l031","ordinal":63485,"en":"Commanders of ten shouted roughly;"},{"id":"manas-2010:p1471:b001:l032","ordinal":63486,"en":"Commanders of a thousand stood apart;"},{"id":"manas-2010:p1471:b001:l033","ordinal":63487,"en":"Commanders of a hundred darted about."},{"id":"manas-2010:p1471:b001:l034","ordinal":63488,"en":"Swords rang in their sheaths;"}]
