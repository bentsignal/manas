[{"id":"semetey-2-2013:p0049:b003:l020","ordinal":188929,"en":"The gray-maned Manas;"},{"id":"semetey-2-2013:p0049:b003:l021","ordinal":188930,"en":"His figure and bearing,"},{"id":"semetey-2-2013:p0049:b003:l022","ordinal":188931,"en":"His form astride a horse,"},{"id":"semetey-2-2013:p0049:b003:l023","ordinal":188932,"en":"I will observe carefully and see."},{"id":"semetey-2-2013:p0049:b003:l024","ordinal":188933,"en":"Without seeing the young hero’s courage,"},{"id":"semetey-2-2013:p0049:b003:l025","ordinal":188934,"en":"Why drive a host of ten thousand into turmoil,"},{"id":"semetey-2-2013:p0049:b003:l026","ordinal":188935,"en":"Driving not a few but a multitude,"},{"id":"semetey-2-2013:p0049:b003:l027","ordinal":188936,"en":"Driving them over forty days’ journey,"},{"id":"semetey-2-2013:p0049:b003:l028","ordinal":188937,"en":"Driving them into a desert where they would perish,"},{"id":"semetey-2-2013:p0049:b003:l029","ordinal":188938,"en":"Soring all the thoroughbred horses,"},{"id":"semetey-2-2013:p0049:b003:l030","ordinal":188939,"en":"Paining the champions’ hearts,"},{"id":"semetey-2-2013:p0049:b003:l031","ordinal":188940,"en":"Making some of them weep,"},{"id":"semetey-2-2013:p0049:b003:l032","ordinal":188941,"en":"Making others ache,"},{"id":"semetey-2-2013:p0049:b003:l033","ordinal":188942,"en":"Chilling the people’s spirits?"},{"id":"semetey-2-2013:p0049:b003:l034","ordinal":188943,"en":"What inheritance would I gain?"},{"id":"semetey-2-2013:p0049:b003:l035","ordinal":188944,"en":"If he is indeed a hero born of Manas,"},{"id":"semetey-2-2013:p0049:b003:l036","ordinal":188945,"en":"I will meet him in the peopleless desert"},{"id":"semetey-2-2013:p0049:b003:l037","ordinal":188946,"en":"And clash with him."},{"id":"semetey-2-2013:p0049:b003:l038","ordinal":188947,"en":"While my towering head still stands,"},{"id":"semetey-2-2013:p0049:b003:l039","ordinal":188948,"en":"Why should I fear for nothing"},{"id":"semetey-2-2013:p0049:b005:l001","ordinal":188949,"en":"A boy who has come without companions?"},{"id":"semetey-2-2013:p0049:b005:l002","ordinal":188950,"en":"Without bringing ruin upon Beijing,"},{"id":"semetey-2-2013:p0049:b005:l003","ordinal":188951,"en":"Without laying waste to my people,"},{"id":"semetey-2-2013:p0049:b005:l004","ordinal":188952,"en":"I will get news from afar."},{"id":"semetey-2-2013:p0049:b005:l005","ordinal":188953,"en":"If he truly is Manas’s son,"},{"id":"semetey-2-2013:p0049:b005:l006","ordinal":188954,"en":"I will reach him and put him to the test."},{"id":"semetey-2-2013:p0049:b005:l007","ordinal":188955,"en":"Without troubling my people,"},{"id":"semetey-2-2013:p0049:b005:l008","ordinal":188956,"en":"I alone will go."},{"id":"semetey-2-2013:p0049:b005:l009","ordinal":188957,"en":"While my mighty head still stands,"},{"id":"semetey-2-2013:p0049:b005:l010","ordinal":188958,"en":"How could I surrender my swift horse?"},{"id":"semetey-2-2013:p0049:b005:l011","ordinal":188959,"en":"If Semetey is mighty,"},{"id":"semetey-2-2013:p0049:b005:l012","ordinal":188960,"en":"I will clash with him and see."},{"id":"semetey-2-2013:p0049:b005:l013","ordinal":188961,"en":"While my strength is in its heroic prime,"},{"id":"semetey-2-2013:p0049:b005:l014","ordinal":188962,"en":"How could I surrender my livestock?"},{"id":"semetey-2-2013:p0049:b005:l015","ordinal":188963,"en":"The pale boy seems to have gone mad;"},{"id":"semetey-2-2013:p0049:b005:l016","ordinal":188964,"en":"I will grapple with him and see!”"},{"id":"semetey-2-2013:p0049:b005:l017","ordinal":188965,"en":"Thus Kongurbay declared."},{"id":"semetey-2-2013:p0049:b005:l018","ordinal":188966,"en":"He put on his blue coat,"},{"id":"semetey-2-2013:p0049:b005:l019","ordinal":188967,"en":"Coiled like a blue tiger—"},{"id":"semetey-2-2013:p0049:b005:l020","ordinal":188968,"en":"Such was Kongurbay’s nature."},{"id":"semetey-2-2013:p0049:b005:l021","ordinal":188969,"en":"His eyeglasses gleamed,"},{"id":"semetey-2-2013:p0049:b005:l022","ordinal":188970,"en":"And a pendant-stone like a leather flask"},{"id":"semetey-2-2013:p0049:b005:l023","ordinal":188971,"en":"Flashed on the crown"},{"id":"semetey-2-2013:p0049:b005:l024","ordinal":188972,"en":"Of the Manchu doomed to burn and die."},{"id":"semetey-2-2013:p0049:b005:l025","ordinal":188973,"en":"From the palace with gates of steel,"},{"id":"semetey-2-2013:p0049:b005:l026","ordinal":188974,"en":"The Kalmyk departed in turmoil,"},{"id":"semetey-2-2013:p0049:b005:l027","ordinal":188975,"en":"Clad in armor no bullet pierced."},{"id":"semetey-2-2013:p0049:b005:l028","ordinal":188976,"en":"He slung the great six-grooved gun,"},{"id":"semetey-2-2013:p0049:b005:l029","ordinal":188977,"en":"Ochogor, over his shoulder."},{"id":"semetey-2-2013:p0049:b005:l030","ordinal":188978,"en":"As though their Kalmyk would never return,"},{"id":"semetey-2-2013:p0049:b005:l031","ordinal":188979,"en":"As though he would never see his Chinese again,"},{"id":"semetey-2-2013:p0049:b005:l032","ordinal":188980,"en":"Karagul stood grieving."},{"id":"semetey-2-2013:p0049:b005:l033","ordinal":188981,"en":"With a cotton sash and broad boots,"},{"id":"semetey-2-2013:p0049:b005:l034","ordinal":188982,"en":"The hulking great Kalmyk,"},{"id":"semetey-2-2013:p0049:b005:l035","ordinal":188983,"en":"With a leather saddle-cloth and twisted waist,"},{"id":"semetey-2-2013:p0049:b005:l036","ordinal":188984,"en":"The rank-smelling warrior Kalmyk—"},{"id":"semetey-2-2013:p0049:b005:l037","ordinal":188985,"en":"At the sight of him the heart was divided;"},{"id":"semetey-2-2013:p0049:b005:l038","ordinal":188986,"en":"Among all sons of men ever created,"},{"id":"semetey-2-2013:p0049:b005:l039","ordinal":188987,"en":"He appeared the greatest."},{"id":"semetey-2-2013:p0050:b003:l001","ordinal":188988,"en":"Beneath him he had a thoroughbred steed;"},{"id":"semetey-2-2013:p0050:b003:l002","ordinal":188989,"en":"The great blue-gray-bearded Manchu,"},{"id":"semetey-2-2013:p0050:b003:l003","ordinal":188990,"en":"Though he had grown old and might die,"},{"id":"semetey-2-2013:p0050:b003:l004","ordinal":188991,"en":"Still had strength enough to lay waste to the world."},{"id":"semetey-2-2013:p0050:b003:l005","ordinal":188992,"en":"The corners of his two eyes"},{"id":"semetey-2-2013:p0050:b003:l006","ordinal":188993,"en":"Were like graves gaping open;"},{"id":"semetey-2-2013:p0050:b003:l007","ordinal":188994,"en":"His broad forehead spread wide,"},{"id":"semetey-2-2013:p0050:b003:l008","ordinal":188995,"en":"Like the seat of honor occupied by a rich man;"},{"id":"semetey-2-2013:p0050:b003:l009","ordinal":188996,"en":"His upturned mustache"},{"id":"semetey-2-2013:p0050:b003:l010","ordinal":188997,"en":"Was like the handle of a greased axe;"},{"id":"semetey-2-2013:p0050:b003:l011","ordinal":188998,"en":"His huge, jutting nose"},{"id":"semetey-2-2013:p0050:b003:l012","ordinal":188999,"en":"Was like the sheath of a selebe saber."},{"id":"semetey-2-2013:p0050:b003:l013","ordinal":189000,"en":"If you sit and ask of his renown:"},{"id":"semetey-2-2013:p0050:b003:l014","ordinal":189001,"en":"Born in Outer Beijing,"},{"id":"semetey-2-2013:p0050:b003:l015","ordinal":189002,"en":"Kongurbay had stirred such turmoil"},{"id":"semetey-2-2013:p0050:b003:l016","ordinal":189003,"en":"Not only among the Chinese, but throughout the age."},{"id":"semetey-2-2013:p0050:b003:l017","ordinal":189004,"en":"Dust rose wherever he traveled;"},{"id":"semetey-2-2013:p0050:b003:l018","ordinal":189005,"en":"At his voice, life fled."},{"id":"semetey-2-2013:p0050:b003:l019","ordinal":189006,"en":"He was the man who went forth to conflict,"},{"id":"semetey-2-2013:p0050:b003:l020","ordinal":189007,"en":"That was the heedless warrior."},{"id":"semetey-2-2013:p0050:b003:l021","ordinal":189008,"en":"Seeing his courage, the khagan’s men"},{"id":"semetey-2-2013:p0050:b003:l022","ordinal":189009,"en":"Carried out his spoken word."},{"id":"semetey-2-2013:p0050:b003:l023","ordinal":189010,"en":"Against the sudden coming of an enemy,"},{"id":"semetey-2-2013:p0050:b003:l024","ordinal":189011,"en":"They made him the fortress of Outer Beijing."},{"id":"semetey-2-2013:p0050:b003:l025","ordinal":189012,"en":"Have you heard the news?"},{"id":"semetey-2-2013:p0050:b003:l026","ordinal":189013,"en":"He slew whoever fought him;"},{"id":"semetey-2-2013:p0050:b003:l027","ordinal":189014,"en":"The resourceful Kalmyk"},{"id":"semetey-2-2013:p0050:b003:l028","ordinal":189015,"en":"Had cunning as well."},{"id":"semetey-2-2013:p0050:b003:l029","ordinal":189016,"en":"He was a master who knew the enemy’s stratagems,"},{"id":"semetey-2-2013:p0050:b003:l030","ordinal":189017,"en":"And had power as well."},{"id":"semetey-2-2013:p0050:b003:l031","ordinal":189018,"en":"He was the champion displayed for all to see;"},{"id":"semetey-2-2013:p0050:b003:l032","ordinal":189019,"en":"If you came to fight him,"},{"id":"semetey-2-2013:p0050:b003:l033","ordinal":189020,"en":"He was the mightiest khan of the Kechil."},{"id":"semetey-2-2013:p0050:b003:l034","ordinal":189021,"en":"His wisdom was great, his venom strong—"},{"id":"semetey-2-2013:p0050:b003:l035","ordinal":189022,"en":"Have you heard the news?"},{"id":"semetey-2-2013:p0050:b003:l036","ordinal":189023,"en":"He leveled the ground where he fought."},{"id":"semetey-2-2013:p0050:b003:l037","ordinal":189024,"en":"The Kechil khan, the great swine,"},{"id":"semetey-2-2013:p0050:b003:l038","ordinal":189025,"en":"The khan of Beijing, the foremost swine."},{"id":"semetey-2-2013:p0050:b003:l039","ordinal":189026,"en":"The great black horse that pranced"},{"id":"semetey-2-2013:p0050:b004:l001","ordinal":189027,"en":"He sent among the Ong Soloon,"},{"id":"semetey-2-2013:p0050:b004:l002","ordinal":189028,"en":"To have the judges inspect"},{"id":"semetey-2-2013:p0050:b004:l003","ordinal":189029,"en":"What its flesh and form were like."},{"id":"semetey-2-2013:p0050:b004:l004","ordinal":189030,"en":"A golden saddle with arched pommel,"},{"id":"semetey-2-2013:p0050:b004:l005","ordinal":189031,"en":"The doomed one took"},{"id":"semetey-2-2013:p0050:b004:l006","ordinal":189032,"en":"And had placed on Algara."},{"id":"semetey-2-2013:p0050:b004:l007","ordinal":189033,"en":"Sixty wrestlers and countless Soloon,"},{"id":"semetey-2-2013:p0050:b004:l008","ordinal":189034,"en":"Wondering what his plan might be,"},{"id":"semetey-2-2013:p0050:b004:l009","ordinal":189035,"en":"The great white-bearded Manchu"},{"id":"semetey-2-2013:p0050:b004:l010","ordinal":189036,"en":"Frightened all those people."},{"id":"semetey-2-2013:p0050:b004:l011","ordinal":189037,"en":"They fretted and wailed;"},{"id":"semetey-2-2013:p0050:b004:l012","ordinal":189038,"en":"His stricken people cried aloud."},{"id":"semetey-2-2013:p0050:b004:l013","ordinal":189039,"en":"When he had reached old age,"},{"id":"semetey-2-2013:p0050:b004:l014","ordinal":189040,"en":"They asked what would become of the noble hawk:"},{"id":"semetey-2-2013:p0050:b004:l015","ordinal":189041,"en":"“The hairs of his beard are white;"},{"id":"semetey-2-2013:p0050:b004:l016","ordinal":189042,"en":"It seems his time has come to depart on a journey."},{"id":"semetey-2-2013:p0050:b004:l017","ordinal":189043,"en":"Past eighty and nearing ninety,"},{"id":"semetey-2-2013:p0050:b004:l018","ordinal":189044,"en":"Such is his condition now."},{"id":"semetey-2-2013:p0050:b004:l019","ordinal":189045,"en":"Unable to take a companion as escort,"},{"id":"semetey-2-2013:p0050:b004:l020","ordinal":189046,"en":"Unable to take a vast host of ten thousand,"},{"id":"semetey-2-2013:p0050:b004:l021","ordinal":189047,"en":"Alas, the poor old father"},{"id":"semetey-2-2013:p0050:b004:l022","ordinal":189048,"en":"Seems to have grown aged."},{"id":"semetey-2-2013:p0050:b004:l023","ordinal":189049,"en":"Meeting by chance and in vain"},{"id":"semetey-2-2013:p0050:b004:l024","ordinal":189050,"en":"To feud with blood-drinking Manas’s son—"},{"id":"semetey-2-2013:p0050:b004:l025","ordinal":189051,"en":"Is it time for him to set out on his final journey?"},{"id":"semetey-2-2013:p0050:b004:l026","ordinal":189052,"en":"Now that his beard is blue-gray,"},{"id":"semetey-2-2013:p0050:b004:l027","ordinal":189053,"en":"The gray-maned wolf himself will surely not come."},{"id":"semetey-2-2013:p0050:b004:l028","ordinal":189054,"en":"Father, noble hawk, what shall I do?"},{"id":"semetey-2-2013:p0050:b004:l029","ordinal":189055,"en":"Surely he will not see Beijing again.”"},{"id":"semetey-2-2013:p0050:b004:l030","ordinal":189056,"en":"When the Kalmyk mounted to depart,"},{"id":"semetey-2-2013:p0050:b004:l031","ordinal":189057,"en":"His nobles wept and his khan wept,"},{"id":"semetey-2-2013:p0050:b004:l032","ordinal":189058,"en":"All that people wept,"},{"id":"semetey-2-2013:p0050:b004:l033","ordinal":189059,"en":"The mass of people grieving."},{"id":"semetey-2-2013:p0050:b004:l034","ordinal":189060,"en":"“Alas, the poor brave man,"},{"id":"semetey-2-2013:p0050:b004:l035","ordinal":189061,"en":"He has grown old,” they wept."},{"id":"semetey-2-2013:p0050:b004:l036","ordinal":189062,"en":"Whichever one you looked at,"},{"id":"semetey-2-2013:p0050:b004:l037","ordinal":189063,"en":"Wept, consumed by personal grief."},{"id":"semetey-2-2013:p0050:b004:l038","ordinal":189064,"en":"“He was the precious khan we cherished;"},{"id":"semetey-2-2013:p0050:b004:l039","ordinal":189065,"en":"May he return,” they wept."},{"id":"semetey-2-2013:p0051:b003:l001","ordinal":189066,"en":"The sun sank, shimmering,"},{"id":"semetey-2-2013:p0051:b003:l002","ordinal":189067,"en":"And the foremost of the people lay down."},{"id":"semetey-2-2013:p0051:b003:l003","ordinal":189068,"en":"From the encampment with gates of steel,"},{"id":"semetey-2-2013:p0051:b003:l004","ordinal":189069,"en":"From the fortress of Great Beijing,"},{"id":"semetey-2-2013:p0051:b003:l005","ordinal":189070,"en":"Jerking the reins of gold"},{"id":"semetey-2-2013:p0051:b003:l006","ordinal":189071,"en":"And urging Algara onward,"},{"id":"semetey-2-2013:p0051:b003:l007","ordinal":189072,"en":"The Kalcha’s state was such:"},{"id":"semetey-2-2013:p0051:b003:l008","ordinal":189073,"en":"The flesh of his forearms creased as he strained,"},{"id":"semetey-2-2013:p0051:b003:l009","ordinal":189074,"en":"“What is wrong with the dog?” he said,"},{"id":"semetey-2-2013:p0051:b003:l010","ordinal":189075,"en":"Quarreling with Algara."},{"id":"semetey-2-2013:p0051:b003:l011","ordinal":189076,"en":"When Algara opened his stride—"},{"id":"semetey-2-2013:p0051:b003:l012","ordinal":189077,"en":"That unsurpassed great black horse—"},{"id":"semetey-2-2013:p0051:b003:l013","ordinal":189078,"en":"If he stepped upon black stone,"},{"id":"semetey-2-2013:p0051:b003:l014","ordinal":189079,"en":"It burst and crumbled into powder;"},{"id":"semetey-2-2013:p0051:b003:l015","ordinal":189080,"en":"The madman’s black horse"},{"id":"semetey-2-2013:p0051:b003:l016","ordinal":189081,"en":"Flew rumbling like a cloud."},{"id":"semetey-2-2013:p0051:b003:l017","ordinal":189082,"en":"Around the hour of midnight,"},{"id":"semetey-2-2013:p0051:b003:l018","ordinal":189083,"en":"The Kalcha rose in agitation;"},{"id":"semetey-2-2013:p0051:b003:l019","ordinal":189084,"en":"Before midnight had even come,"},{"id":"semetey-2-2013:p0051:b003:l020","ordinal":189085,"en":"He reached the roaring Sary-Suu."},{"id":"semetey-2-2013:p0051:b003:l021","ordinal":189086,"en":"Coming upon the Sary-Suu,"},{"id":"semetey-2-2013:p0051:b003:l022","ordinal":189087,"en":"Algara stretched out his stride."},{"id":"semetey-2-2013:p0051:b003:l023","ordinal":189088,"en":"Was Algara not a thoroughbred?"},{"id":"semetey-2-2013:p0051:b003:l024","ordinal":189089,"en":"At the great roaring river,"},{"id":"semetey-2-2013:p0051:b003:l025","ordinal":189090,"en":"Algara did not draw back,"},{"id":"semetey-2-2013:p0051:b003:l026","ordinal":189091,"en":"But leapt wherever he met it."},{"id":"semetey-2-2013:p0051:b003:l027","ordinal":189092,"en":"To the pasture where the horses had lain,"},{"id":"semetey-2-2013:p0051:b003:l028","ordinal":189093,"en":"To the pass of Kyr-Kaiyng,"},{"id":"semetey-2-2013:p0051:b003:l029","ordinal":189094,"en":"To the shore of the salty Kürpüldök,"},{"id":"semetey-2-2013:p0051:b003:l030","ordinal":189095,"en":"To the horses’ grazing ground,"},{"id":"semetey-2-2013:p0051:b003:l031","ordinal":189096,"en":"Hero Kalcha came riding."},{"id":"semetey-2-2013:p0051:b003:l032","ordinal":189097,"en":"When he looked toward Zholum’s camp,"},{"id":"semetey-2-2013:p0051:b003:l033","ordinal":189098,"en":"Hoping his people were safe,"},{"id":"semetey-2-2013:p0051:b003:l034","ordinal":189099,"en":"The herdsman at Zholum’s camp"},{"id":"semetey-2-2013:p0051:b003:l035","ordinal":189100,"en":"Lay stretched out dead,"},{"id":"semetey-2-2013:p0051:b003:l036","ordinal":189101,"en":"His body remaining, his head gone,"},{"id":"semetey-2-2013:p0051:b003:l037","ordinal":189102,"en":"Plainly and utterly slain."},{"id":"semetey-2-2013:p0051:b003:l038","ordinal":189103,"en":"Dust had been churned in every direction;"},{"id":"semetey-2-2013:p0051:b003:l039","ordinal":189104,"en":"As though a giant beast had trampled it,"},{"id":"semetey-2-2013:p0051:b005:l001","ordinal":189105,"en":"All of Zholum’s camp"},{"id":"semetey-2-2013:p0051:b005:l002","ordinal":189106,"en":"Lay smashed and ground to bits."},{"id":"semetey-2-2013:p0051:b005:l003","ordinal":189107,"en":"“It is true that Karagul"},{"id":"semetey-2-2013:p0051:b005:l004","ordinal":189108,"en":"Saw what happened in this place."},{"id":"semetey-2-2013:p0051:b005:l005","ordinal":189109,"en":"And it is true that all the others"},{"id":"semetey-2-2013:p0051:b005:l006","ordinal":189110,"en":"Have been killed.”"},{"id":"semetey-2-2013:p0051:b005:l007","ordinal":189111,"en":"Then Kongurbai,"},{"id":"semetey-2-2013:p0051:b005:l008","ordinal":189112,"en":"Unable to stand still in his fury—"},{"id":"semetey-2-2013:p0051:b005:l009","ordinal":189113,"en":"With his great moon-crested golden pipe,"},{"id":"semetey-2-2013:p0051:b005:l010","ordinal":189114,"en":"That Kalcha huge as a yurt—"},{"id":"semetey-2-2013:p0051:b005:l011","ordinal":189115,"en":"Into its bowl he thrust"},{"id":"semetey-2-2013:p0051:b005:l012","ordinal":189116,"en":"A great handful of tobacco,"},{"id":"semetey-2-2013:p0051:b005:l013","ordinal":189117,"en":"And now took the pipe in hand."},{"id":"semetey-2-2013:p0051:b005:l014","ordinal":189118,"en":"He struck the Chinese flintstone,"},{"id":"semetey-2-2013:p0051:b005:l015","ordinal":189119,"en":"Set an ember upon it,"},{"id":"semetey-2-2013:p0051:b005:l016","ordinal":189120,"en":"And the keen-minded hero Kalcha"},{"id":"semetey-2-2013:p0051:b005:l017","ordinal":189121,"en":"Drew upon his pipe;"},{"id":"semetey-2-2013:p0051:b005:l018","ordinal":189122,"en":"It rasped aloud in the usual way,"},{"id":"semetey-2-2013:p0051:b005:l019","ordinal":189123,"en":"And when he released the smoke,"},{"id":"semetey-2-2013:p0051:b005:l020","ordinal":189124,"en":"It billowed like a sleeve."},{"id":"semetey-2-2013:p0051:b005:l021","ordinal":189125,"en":"The hair on his crown stood on end:"},{"id":"semetey-2-2013:p0051:b005:l022","ordinal":189126,"en":"“They have slaughtered my herdsmen,” he said,"},{"id":"semetey-2-2013:p0051:b005:l023","ordinal":189127,"en":"“And carried away my horses;"},{"id":"semetey-2-2013:p0051:b005:l024","ordinal":189128,"en":"They have worked another outrage,” he said."},{"id":"semetey-2-2013:p0051:b005:l025","ordinal":189129,"en":"Unable to collect his thoughts,"},{"id":"semetey-2-2013:p0051:b005:l026","ordinal":189130,"en":"He turned Algara’s head."},{"id":"semetey-2-2013:p0051:b005:l027","ordinal":189131,"en":"As though he had endured great grief"},{"id":"semetey-2-2013:p0051:b005:l028","ordinal":189132,"en":"For many days and nights,"},{"id":"semetey-2-2013:p0051:b005:l029","ordinal":189133,"en":"He stood there on that spot."},{"id":"semetey-2-2013:p0051:b005:l030","ordinal":189134,"en":"Kongurbai pursued behind them;"},{"id":"semetey-2-2013:p0051:b005:l031","ordinal":189135,"en":"Let us leave him there,"},{"id":"semetey-2-2013:p0051:b005:l032","ordinal":189136,"en":"And begin the news of Semetey,"},{"id":"semetey-2-2013:p0051:b005:l033","ordinal":189137,"en":"Who was driving the horses:"},{"id":"semetey-2-2013:p0051:b005:l034","ordinal":189138,"en":"Upon a towering mountain ridge,"},{"id":"semetey-2-2013:p0051:b005:l035","ordinal":189139,"en":"On a jutting spur,"},{"id":"semetey-2-2013:p0051:b005:l036","ordinal":189140,"en":"Lay Zhangy-Zher, found by Almambet."},{"id":"semetey-2-2013:p0051:b005:l037","ordinal":189141,"en":"There in Zhangy-Zher itself,"},{"id":"semetey-2-2013:p0051:b005:l038","ordinal":189142,"en":"At the mine where gold was dug—"},{"id":"semetey-2-2013:p0051:b005:l039","ordinal":189143,"en":"Upon the heights above that mine,"},{"id":"semetey-2-2013:p0052:b003:l001","ordinal":189144,"en":"Beneath a plane tree as large as a house,"},{"id":"semetey-2-2013:p0052:b003:l002","ordinal":189145,"en":"Your elder, old Bakai,"},{"id":"semetey-2-2013:p0052:b003:l003","ordinal":189146,"en":"Had removed the saddle"},{"id":"semetey-2-2013:p0052:b003:l004","ordinal":189147,"en":"From Kökcholok beneath him,"},{"id":"semetey-2-2013:p0052:b003:l005","ordinal":189148,"en":"Hobbled him with double fetters,"},{"id":"semetey-2-2013:p0052:b003:l006","ordinal":189149,"en":"Pillowed his head on the blue saddlecloth,"},{"id":"semetey-2-2013:p0052:b003:l007","ordinal":189150,"en":"And lay with his head toward the qibla."},{"id":"semetey-2-2013:p0052:b003:l008","ordinal":189151,"en":"The old man sleeping there"},{"id":"semetey-2-2013:p0052:b003:l009","ordinal":189152,"en":"Started awake from sleep,"},{"id":"semetey-2-2013:p0052:b003:l010","ordinal":189153,"en":"Turned onto his right side,"},{"id":"semetey-2-2013:p0052:b003:l011","ordinal":189154,"en":"Hastily performed his prayer,"},{"id":"semetey-2-2013:p0052:b003:l012","ordinal":189155,"en":"And saddled Kökcholok."},{"id":"semetey-2-2013:p0052:b003:l013","ordinal":189156,"en":"Their elder Bakai, the bringer of good fortune,"},{"id":"semetey-2-2013:p0052:b003:l014","ordinal":189157,"en":"When the dawn shone white,"},{"id":"semetey-2-2013:p0052:b003:l015","ordinal":189158,"en":"And light fell upon the earth,"},{"id":"semetey-2-2013:p0052:b003:l016","ordinal":189159,"en":"Led Aktaigan behind him"},{"id":"semetey-2-2013:p0052:b003:l017","ordinal":189160,"en":"And perched Akshumkar on his hand."},{"id":"semetey-2-2013:p0052:b003:l018","ordinal":189161,"en":"Sent before you, he brought good fortune;"},{"id":"semetey-2-2013:p0052:b003:l019","ordinal":189162,"en":"If you followed him, he was like a myriad troops."},{"id":"semetey-2-2013:p0052:b003:l020","ordinal":189163,"en":"He made known what others did not know—"},{"id":"semetey-2-2013:p0052:b003:l021","ordinal":189164,"en":"The wise old Bakai."},{"id":"semetey-2-2013:p0052:b003:l022","ordinal":189165,"en":"He made men perceive what they had not sensed—"},{"id":"semetey-2-2013:p0052:b003:l023","ordinal":189166,"en":"The true prophet Bakai."},{"id":"semetey-2-2013:p0052:b003:l024","ordinal":189167,"en":"At the empty pasture where no soul moved,"},{"id":"semetey-2-2013:p0052:b003:l025","ordinal":189168,"en":"“Where has Semetey gone?” he said."},{"id":"semetey-2-2013:p0052:b003:l026","ordinal":189169,"en":"On the broad foothill ridge,"},{"id":"semetey-2-2013:p0052:b003:l027","ordinal":189170,"en":"Bakai stood leaning and watched."},{"id":"semetey-2-2013:p0052:b003:l028","ordinal":189171,"en":"“Ride toward Agala, toward Kyzyl-Kum,"},{"id":"semetey-2-2013:p0052:b003:l029","ordinal":189172,"en":"The fatherland of Almambet;"},{"id":"semetey-2-2013:p0052:b003:l030","ordinal":189173,"en":"It was his father’s pasture."},{"id":"semetey-2-2013:p0052:b003:l031","ordinal":189174,"en":"When the soaring black bird,"},{"id":"semetey-2-2013:p0052:b003:l032","ordinal":189175,"en":"The lion Almang, went away,"},{"id":"semetey-2-2013:p0052:b003:l033","ordinal":189176,"en":"He left it behind long ago."},{"id":"semetey-2-2013:p0052:b003:l034","ordinal":189177,"en":"When hardship and an evil day befall you,"},{"id":"semetey-2-2013:p0052:b003:l035","ordinal":189178,"en":"He said it would be your refuge."},{"id":"semetey-2-2013:p0052:b003:l036","ordinal":189179,"en":"Instead of camping at Kyzyl-Kum,"},{"id":"semetey-2-2013:p0052:b003:l037","ordinal":189180,"en":"What word shall I hear of"},{"id":"semetey-2-2013:p0052:b003:l038","ordinal":189181,"en":"The inheritance Manas left behind?"},{"id":"semetey-2-2013:p0052:b003:l039","ordinal":189182,"en":"I will ride out to meet"},{"id":"semetey-2-2013:p0052:b004:l001","ordinal":189183,"en":"The lone one who is my shelter!”"},{"id":"semetey-2-2013:p0052:b004:l002","ordinal":189184,"en":"Saying this, hero Bakai"}]
