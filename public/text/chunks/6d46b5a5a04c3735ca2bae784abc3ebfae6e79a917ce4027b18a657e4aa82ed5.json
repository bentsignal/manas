[{"id":"semetey-1-2013:p1309:b003:l006","ordinal":176129,"en":"Afghanistan's warriors"},{"id":"semetey-1-2013:p1309:b003:l007","ordinal":176130,"en":"He utterly slaughtered."},{"id":"semetey-1-2013:p1309:b003:l008","ordinal":176131,"en":"He unleashed a fierce calamity;"},{"id":"semetey-1-2013:p1309:b003:l009","ordinal":176132,"en":"Poor Toltoy then"},{"id":"semetey-1-2013:p1309:b003:l010","ordinal":176133,"en":"Lay there taking lives."},{"id":"semetey-1-2013:p1309:b003:l011","ordinal":176134,"en":"When the people were being slaughtered,"},{"id":"semetey-1-2013:p1309:b003:l012","ordinal":176135,"en":"Was he not born a lion?"},{"id":"semetey-1-2013:p1309:b003:l013","ordinal":176136,"en":"Dear Choro arrived."},{"id":"semetey-1-2013:p1309:b003:l014","ordinal":176137,"en":"Against Toltoy once again"},{"id":"semetey-1-2013:p1309:b003:l015","ordinal":176138,"en":"He unleashed the melee."},{"id":"semetey-1-2013:p1309:b003:l016","ordinal":176139,"en":"Külchoro, son of Almambet,"},{"id":"semetey-1-2013:p1309:b003:l017","ordinal":176140,"en":"Turned Akborchuk's head,"},{"id":"semetey-1-2013:p1309:b003:l018","ordinal":176141,"en":"And at Toltoy of the Jediger"},{"id":"semetey-1-2013:p1309:b003:l019","ordinal":176142,"en":"He now shouted and leveled his spear."},{"id":"semetey-1-2013:p1309:b003:l020","ordinal":176143,"en":"When he saw Külchoro,"},{"id":"semetey-1-2013:p1309:b003:l021","ordinal":176144,"en":"Mountain-like hero Toltoy's"},{"id":"semetey-1-2013:p1309:b003:l022","ordinal":176145,"en":"Ribs began to tremble,"},{"id":"semetey-1-2013:p1309:b003:l023","ordinal":176146,"en":"And his entrails quivered."},{"id":"semetey-1-2013:p1309:b003:l024","ordinal":176147,"en":"The brute he had seen before—"},{"id":"semetey-1-2013:p1309:b003:l025","ordinal":176148,"en":"Could Toltoy remain without fleeing,"},{"id":"semetey-1-2013:p1309:b003:l026","ordinal":176149,"en":"Having barely escaped death?"},{"id":"semetey-1-2013:p1309:b003:l027","ordinal":176150,"en":"Could Toltoy stand there calmly?"},{"id":"semetey-1-2013:p1309:b003:l028","ordinal":176151,"en":"Külchoro like Gabriel,"},{"id":"semetey-1-2013:p1309:b003:l029","ordinal":176152,"en":"Making the earth split and thunder,"},{"id":"semetey-1-2013:p1309:b003:l030","ordinal":176153,"en":"Came at that moment,"},{"id":"semetey-1-2013:p1309:b003:l031","ordinal":176154,"en":"Roaring toward Toltoy."},{"id":"semetey-1-2013:p1309:b003:l032","ordinal":176155,"en":"His eyes reddened like a wolf's,"},{"id":"semetey-1-2013:p1309:b003:l033","ordinal":176156,"en":"His neck stretched unusually long;"},{"id":"semetey-1-2013:p1309:b003:l034","ordinal":176157,"en":"There was no man like Külchoro."},{"id":"semetey-1-2013:p1309:b003:l035","ordinal":176158,"en":"When Toltoy looked back,"},{"id":"semetey-1-2013:p1309:b003:l036","ordinal":176159,"en":"A gray tiger was coming beneath him."},{"id":"semetey-1-2013:p1309:b003:l037","ordinal":176160,"en":"With his tail raised high,"},{"id":"semetey-1-2013:p1309:b003:l038","ordinal":176161,"en":"He made for Khan Toltoy,"},{"id":"semetey-1-2013:p1309:b003:l039","ordinal":176162,"en":"Shouting a mighty cry."},{"id":"semetey-1-2013:p1309:b004:l001","ordinal":176163,"en":"The blue invincible one, never sated with blood,"},{"id":"semetey-1-2013:p1309:b004:l002","ordinal":176164,"en":"As though about to sweep him away,"},{"id":"semetey-1-2013:p1309:b004:l003","ordinal":176165,"en":"Came up beneath him."},{"id":"semetey-1-2013:p1309:b004:l004","ordinal":176166,"en":"Before Toltoy's eyes"},{"id":"semetey-1-2013:p1309:b004:l005","ordinal":176167,"en":"He began the melee."},{"id":"semetey-1-2013:p1309:b004:l006","ordinal":176168,"en":"From that invincible one's wrath,"},{"id":"semetey-1-2013:p1309:b004:l007","ordinal":176169,"en":"Poor Toltoy then"},{"id":"semetey-1-2013:p1309:b004:l008","ordinal":176170,"en":"Was nearly flung"},{"id":"semetey-1-2013:p1309:b004:l009","ordinal":176171,"en":"From atop Surkoyon."},{"id":"semetey-1-2013:p1309:b004:l010","ordinal":176172,"en":"His heart began pounding,"},{"id":"semetey-1-2013:p1309:b004:l011","ordinal":176173,"en":"Despairing of his precious life,"},{"id":"semetey-1-2013:p1309:b004:l012","ordinal":176174,"en":"Toltoy burned and trembled."},{"id":"semetey-1-2013:p1309:b004:l013","ordinal":176175,"en":"When he saw Külchoro,"},{"id":"semetey-1-2013:p1309:b004:l014","ordinal":176176,"en":"Toltoy looked and grieved;"},{"id":"semetey-1-2013:p1309:b004:l015","ordinal":176177,"en":"Thinking he would die,"},{"id":"semetey-1-2013:p1309:b004:l016","ordinal":176178,"en":"He despaired of his fly-like life."},{"id":"semetey-1-2013:p1309:b004:l017","ordinal":176179,"en":"As though about to leave this world,"},{"id":"semetey-1-2013:p1309:b004:l018","ordinal":176180,"en":"He lost his wits."},{"id":"semetey-1-2013:p1309:b004:l019","ordinal":176181,"en":"Lion Toltoy then"},{"id":"semetey-1-2013:p1309:b004:l020","ordinal":176182,"en":"Fled away from his people."},{"id":"semetey-1-2013:p1309:b004:l021","ordinal":176183,"en":"He fled like a woman—away he went,"},{"id":"semetey-1-2013:p1309:b004:l022","ordinal":176184,"en":"Toltoy of the Jediger, their noble"},{"id":"semetey-1-2013:p1309:b004:l023","ordinal":176185,"en":"lion."},{"id":"semetey-1-2013:p1309:b004:l024","ordinal":176186,"en":"Roaring in fury,"},{"id":"semetey-1-2013:p1309:b004:l025","ordinal":176187,"en":"When he saw Khan Toltoy,"},{"id":"semetey-1-2013:p1309:b004:l026","ordinal":176188,"en":"Lion-prince Külchoro"},{"id":"semetey-1-2013:p1309:b004:l027","ordinal":176189,"en":"Shouted the battle cry “Manas!”"},{"id":"semetey-1-2013:p1309:b004:l028","ordinal":176190,"en":"“Do not flee like a woman,"},{"id":"semetey-1-2013:p1309:b004:l029","ordinal":176191,"en":"Toltoy!” he shouted."},{"id":"semetey-1-2013:p1309:b004:l030","ordinal":176192,"en":"A ridge shaped like a saddleback—"},{"id":"semetey-1-2013:p1309:b004:l031","ordinal":176193,"en":"Toltoy came crossing it."},{"id":"semetey-1-2013:p1309:b004:l032","ordinal":176194,"en":"Glancing about in fear,"},{"id":"semetey-1-2013:p1309:b004:l033","ordinal":176195,"en":"Toltoy came fleeing."},{"id":"semetey-1-2013:p1309:b004:l034","ordinal":176196,"en":"Without looking around,"},{"id":"semetey-1-2013:p1309:b004:l035","ordinal":176197,"en":"With no care for his own life,"},{"id":"semetey-1-2013:p1309:b004:l036","ordinal":176198,"en":"Külchoro pursued him."},{"id":"semetey-1-2013:p1309:b004:l037","ordinal":176199,"en":"Brave Toltoy's Surkoyon"},{"id":"semetey-1-2013:p1309:b004:l038","ordinal":176200,"en":"Was no beast that could let him catch up,"},{"id":"semetey-1-2013:p1309:b004:l039","ordinal":176201,"en":"And Külchoro's Aktelki—"},{"id":"semetey-1-2013:p1310:b003:l001","ordinal":176202,"en":"Was no beast that could quite catch him."},{"id":"semetey-1-2013:p1310:b003:l002","ordinal":176203,"en":"Skimming over the face of the earth,"},{"id":"semetey-1-2013:p1310:b003:l003","ordinal":176204,"en":"Circling Khan Akun's city,"},{"id":"semetey-1-2013:p1310:b003:l004","ordinal":176205,"en":"He harried Toltoy."},{"id":"semetey-1-2013:p1310:b003:l005","ordinal":176206,"en":"Around the marsh of Üyrülmö"},{"id":"semetey-1-2013:p1310:b003:l006","ordinal":176207,"en":"He chased him three times."},{"id":"semetey-1-2013:p1310:b003:l007","ordinal":176208,"en":"Around the marsh of Chogulma"},{"id":"semetey-1-2013:p1310:b003:l008","ordinal":176209,"en":"He chased him in a full circuit."},{"id":"semetey-1-2013:p1310:b003:l009","ordinal":176210,"en":"At the foot of the mountains"},{"id":"semetey-1-2013:p1310:b003:l010","ordinal":176211,"en":"Of Keng-Opol he pursued him;"},{"id":"semetey-1-2013:p1310:b003:l011","ordinal":176212,"en":"Along the water of broad Ürgönch"},{"id":"semetey-1-2013:p1310:b003:l012","ordinal":176213,"en":"He pursued him."},{"id":"semetey-1-2013:p1310:b003:l013","ordinal":176214,"en":"Across boundless Ak-Chiy,"},{"id":"semetey-1-2013:p1310:b003:l014","ordinal":176215,"en":"He went after him;"},{"id":"semetey-1-2013:p1310:b003:l015","ordinal":176216,"en":"Along the edge of the rolling plain,"},{"id":"semetey-1-2013:p1310:b003:l016","ordinal":176217,"en":"He pursued him."},{"id":"semetey-1-2013:p1310:b003:l017","ordinal":176218,"en":"At the far end of the swelling mountain,"},{"id":"semetey-1-2013:p1310:b003:l018","ordinal":176219,"en":"He pursued him,"},{"id":"semetey-1-2013:p1310:b003:l019","ordinal":176220,"en":"And beside Akun's exhausted city,"},{"id":"semetey-1-2013:p1310:b003:l020","ordinal":176221,"en":"He pursued him."},{"id":"semetey-1-2013:p1310:b003:l021","ordinal":176222,"en":"He chased him around six times."},{"id":"semetey-1-2013:p1310:b003:l022","ordinal":176223,"en":"Watching from atop the tower,"},{"id":"semetey-1-2013:p1310:b003:l023","ordinal":176224,"en":"Ayçürök"},{"id":"semetey-1-2013:p1310:b003:l024","ordinal":176225,"en":"Mocked Toltoy."},{"id":"semetey-1-2013:p1310:b003:l025","ordinal":176226,"en":"“Ayrok, ayrok!” she cried,"},{"id":"semetey-1-2013:p1310:b003:l026","ordinal":176227,"en":"God has struck Chürök mad."},{"id":"semetey-1-2013:p1310:b003:l027","ordinal":176228,"en":"“Rather than flee in a panic"},{"id":"semetey-1-2013:p1310:b003:l028","ordinal":176229,"en":"From nine-year-old Külchoro,"},{"id":"semetey-1-2013:p1310:b003:l029","ordinal":176230,"en":"Mountain-like Toltoy, you should die"},{"id":"semetey-1-2013:p1310:b003:l030","ordinal":176231,"en":"And behold Judgment Day!"},{"id":"semetey-1-2013:p1310:b003:l031","ordinal":176232,"en":"Can there be a hero like you?"},{"id":"semetey-1-2013:p1310:b003:l032","ordinal":176233,"en":"You blustering brute,"},{"id":"semetey-1-2013:p1310:b003:l033","ordinal":176234,"en":"Is it right to call you a hero?"},{"id":"semetey-1-2013:p1310:b003:l034","ordinal":176235,"en":"Rather than scurry away, you should die;"},{"id":"semetey-1-2013:p1310:b003:l035","ordinal":176236,"en":"Can there be a fool like you?"},{"id":"semetey-1-2013:p1310:b003:l036","ordinal":176237,"en":"Külchoro is twelve,"},{"id":"semetey-1-2013:p1310:b003:l037","ordinal":176238,"en":"Brave Toltoy is thirty-five,"},{"id":"semetey-1-2013:p1310:b003:l038","ordinal":176239,"en":"Yet you have fled in terror—"},{"id":"semetey-1-2013:p1310:b003:l039","ordinal":176240,"en":"Ayrok, fool, ayrok!” she cried."},{"id":"semetey-1-2013:p1310:b004:l001","ordinal":176241,"en":"“Shame, fool, shame!” she cried."},{"id":"semetey-1-2013:p1310:b004:l002","ordinal":176242,"en":"“You should behold Judgment Day;"},{"id":"semetey-1-2013:p1310:b004:l003","ordinal":176243,"en":"Rather than flee about like this,"},{"id":"semetey-1-2013:p1310:b004:l004","ordinal":176244,"en":"You should strangle on your trouser cord!"},{"id":"semetey-1-2013:p1310:b004:l005","ordinal":176245,"en":"You are no proper man,"},{"id":"semetey-1-2013:p1310:b004:l006","ordinal":176246,"en":"Fleeing from a mere youth."},{"id":"semetey-1-2013:p1310:b004:l007","ordinal":176247,"en":"You fool akin to a beast,"},{"id":"semetey-1-2013:p1310:b004:l008","ordinal":176248,"en":"You are fleeing from a child."},{"id":"semetey-1-2013:p1310:b004:l009","ordinal":176249,"en":"Instead of going off fleeing from a child,"},{"id":"semetey-1-2013:p1310:b004:l010","ordinal":176250,"en":"Your wineskin nose bulging,"},{"id":"semetey-1-2013:p1310:b004:l011","ordinal":176251,"en":"Is there meat to set upon the platter?"},{"id":"semetey-1-2013:p1310:b004:l012","ordinal":176252,"en":"Royal bridegroom, have you any shame?"},{"id":"semetey-1-2013:p1310:b004:l013","ordinal":176253,"en":"You came to fight only in pretense,"},{"id":"semetey-1-2013:p1310:b004:l014","ordinal":176254,"en":"And proved to be careless;"},{"id":"semetey-1-2013:p1310:b004:l015","ordinal":176255,"en":"Ready to flee at the sight of a figure,"},{"id":"semetey-1-2013:p1310:b004:l016","ordinal":176256,"en":"You are a phantom Toltoy."},{"id":"semetey-1-2013:p1310:b004:l017","ordinal":176257,"en":"Unable to face a child,"},{"id":"semetey-1-2013:p1310:b004:l018","ordinal":176258,"en":"You are a womanly Toltoy."},{"id":"semetey-1-2013:p1310:b004:l019","ordinal":176259,"en":"Rather than flee about like this,"},{"id":"semetey-1-2013:p1310:b004:l020","ordinal":176260,"en":"Accursed Toltoy, you should die"},{"id":"semetey-1-2013:p1310:b004:l021","ordinal":176261,"en":"And behold Judgment Day!"},{"id":"semetey-1-2013:p1310:b004:l022","ordinal":176262,"en":"Rather than run away flapping,"},{"id":"semetey-1-2013:p1310:b004:l023","ordinal":176263,"en":"You should wheel and thrust your spear!"},{"id":"semetey-1-2013:p1310:b004:l024","ordinal":176264,"en":"Rather than scurry away,"},{"id":"semetey-1-2013:p1310:b004:l025","ordinal":176265,"en":"You should move and drive your spear!"},{"id":"semetey-1-2013:p1310:b004:l026","ordinal":176266,"en":"Hurl the child from your spear"},{"id":"semetey-1-2013:p1310:b004:l027","ordinal":176267,"en":"And make me your bride!"},{"id":"semetey-1-2013:p1310:b004:l028","ordinal":176268,"en":"Oh, bridegroom, shame on me!"},{"id":"semetey-1-2013:p1310:b004:l029","ordinal":176269,"en":"Failing as a bridegroom, drop dead;"},{"id":"semetey-1-2013:p1310:b004:l030","ordinal":176270,"en":"Sink and die without offspring!"},{"id":"semetey-1-2013:p1310:b004:l031","ordinal":176271,"en":"Rather than this, you fool,"},{"id":"semetey-1-2013:p1310:b004:l032","ordinal":176272,"en":"Do not remain alive—drop dead!”"},{"id":"semetey-1-2013:p1310:b004:l033","ordinal":176273,"en":"After hearing this from Chürök,"},{"id":"semetey-1-2013:p1310:b004:l034","ordinal":176274,"en":"He stiffened in rage,"},{"id":"semetey-1-2013:p1310:b004:l035","ordinal":176275,"en":"And wheeled around"},{"id":"semetey-1-2013:p1310:b004:l036","ordinal":176276,"en":"Surkoyon beneath him."},{"id":"semetey-1-2013:p1310:b004:l037","ordinal":176277,"en":"He brandished and took in hand"},{"id":"semetey-1-2013:p1310:b004:l038","ordinal":176278,"en":"His steel spear with a knobbed shaft."},{"id":"semetey-1-2013:p1310:b004:l039","ordinal":176279,"en":"Poor Toltoy then"},{"id":"semetey-1-2013:p1311:b003:l001","ordinal":176280,"en":"Thunderously thrust his spear."},{"id":"semetey-1-2013:p1311:b003:l002","ordinal":176281,"en":"From the other side Külchoro"},{"id":"semetey-1-2013:p1311:b003:l003","ordinal":176282,"en":"Also readied his spear."},{"id":"semetey-1-2013:p1311:b003:l004","ordinal":176283,"en":"Your warrior born a lion"},{"id":"semetey-1-2013:p1311:b003:l005","ordinal":176284,"en":"Charged and thrust his spear."},{"id":"semetey-1-2013:p1311:b003:l006","ordinal":176285,"en":"Spurring on in fury,"},{"id":"semetey-1-2013:p1311:b003:l007","ordinal":176286,"en":"The lion-prince reached him."},{"id":"semetey-1-2013:p1311:b003:l008","ordinal":176287,"en":"Skillful Toltoy, your blue-maned wolf,"},{"id":"semetey-1-2013:p1311:b003:l009","ordinal":176288,"en":"Also drove his spear."},{"id":"semetey-1-2013:p1311:b003:l010","ordinal":176289,"en":"They stood without fleeing and jousted,"},{"id":"semetey-1-2013:p1311:b003:l011","ordinal":176290,"en":"Meeting one another with spears;"},{"id":"semetey-1-2013:p1311:b003:l012","ordinal":176291,"en":"When they faced each other,"},{"id":"semetey-1-2013:p1311:b003:l013","ordinal":176292,"en":"They were utterly battered."},{"id":"semetey-1-2013:p1311:b003:l014","ordinal":176293,"en":"Their spears could avail them no more,"},{"id":"semetey-1-2013:p1311:b003:l015","ordinal":176294,"en":"Their jousting ceased,"},{"id":"semetey-1-2013:p1311:b003:l016","ordinal":176295,"en":"And they fought with battle-axes."},{"id":"semetey-1-2013:p1311:b003:l017","ordinal":176296,"en":"The battle-axes went shrieking,"},{"id":"semetey-1-2013:p1311:b003:l018","ordinal":176297,"en":"Leaving their hafts in their hands."},{"id":"semetey-1-2013:p1311:b003:l019","ordinal":176298,"en":"They fought with swords,"},{"id":"semetey-1-2013:p1311:b003:l020","ordinal":176299,"en":"And all the swords shattered,"},{"id":"semetey-1-2013:p1311:b003:l021","ordinal":176300,"en":"Leaving the scabbards in their hands."},{"id":"semetey-1-2013:p1311:b003:l022","ordinal":176301,"en":"They seized each other's collars,"},{"id":"semetey-1-2013:p1311:b003:l023","ordinal":176302,"en":"Tearing at whatever they grasped."},{"id":"semetey-1-2013:p1311:b003:l024","ordinal":176303,"en":"When nothing else availed them,"},{"id":"semetey-1-2013:p1311:b003:l025","ordinal":176304,"en":"They dismounted."},{"id":"semetey-1-2013:p1311:b003:l026","ordinal":176305,"en":"They seized each other's wrists,"},{"id":"semetey-1-2013:p1311:b003:l027","ordinal":176306,"en":"Wrestling like champions,"},{"id":"semetey-1-2013:p1311:b003:l028","ordinal":176307,"en":"Tearing whatever flesh showed,"},{"id":"semetey-1-2013:p1311:b003:l029","ordinal":176308,"en":"Butting like blue bulls."},{"id":"semetey-1-2013:p1311:b003:l030","ordinal":176309,"en":"They heaved worse than camels,"},{"id":"semetey-1-2013:p1311:b003:l031","ordinal":176310,"en":"And grappled worse than stallions."},{"id":"semetey-1-2013:p1311:b003:l032","ordinal":176311,"en":"Neither could overcome the other,"},{"id":"semetey-1-2013:p1311:b003:l033","ordinal":176312,"en":"Neither could throw the other;"},{"id":"semetey-1-2013:p1311:b003:l034","ordinal":176313,"en":"While they stood unable to prevail,"},{"id":"semetey-1-2013:p1311:b003:l035","ordinal":176314,"en":"Making Buurul surge,"},{"id":"semetey-1-2013:p1311:b003:l036","ordinal":176315,"en":"Looming like Opol-Too,"},{"id":"semetey-1-2013:p1311:b003:l037","ordinal":176316,"en":"Venom pouring from his mouth,"},{"id":"semetey-1-2013:p1311:b003:l038","ordinal":176317,"en":"Semetey suddenly appeared."},{"id":"semetey-1-2013:p1311:b003:l039","ordinal":176318,"en":"“The elder and younger brother"},{"id":"semetey-1-2013:p1311:b004:l001","ordinal":176319,"en":"Will join against me,” he thought,"},{"id":"semetey-1-2013:p1311:b004:l002","ordinal":176320,"en":"“They will kill me and reach my end,”"},{"id":"semetey-1-2013:p1311:b004:l003","ordinal":176321,"en":"And his heart sank."},{"id":"semetey-1-2013:p1311:b004:l004","ordinal":176322,"en":"Drawing his sword grimly,"},{"id":"semetey-1-2013:p1311:b004:l005","ordinal":176323,"en":"Semetey reached them."},{"id":"semetey-1-2013:p1311:b004:l006","ordinal":176324,"en":"Toltoy of the Jediger"},{"id":"semetey-1-2013:p1311:b004:l007","ordinal":176325,"en":"Had fallen and lay there."},{"id":"semetey-1-2013:p1311:b004:l008","ordinal":176326,"en":"“When he reaches Judgment Day,"},{"id":"semetey-1-2013:p1311:b004:l009","ordinal":176327,"en":"Let him not say two attacked him;"},{"id":"semetey-1-2013:p1311:b004:l010","ordinal":176328,"en":"Because you would not spare his precious life,"},{"id":"semetey-1-2013:p1311:b004:l011","ordinal":176329,"en":"Let him not say you joined against him."},{"id":"semetey-1-2013:p1311:b004:l012","ordinal":176330,"en":"Give Toltoy's blood to me,”"},{"id":"semetey-1-2013:p1311:b004:l013","ordinal":176331,"en":"Külchoro asked."},{"id":"semetey-1-2013:p1311:b004:l014","ordinal":176332,"en":"Without Semetey charging with his sword,"},{"id":"semetey-1-2013:p1311:b004:l015","ordinal":176333,"en":"He yielded the man's blood to the boy."},{"id":"semetey-1-2013:p1311:b004:l016","ordinal":176334,"en":"He lifted and struck Toltoy,"},{"id":"semetey-1-2013:p1311:b004:l017","ordinal":176335,"en":"Twisted and flung away his mustache,"},{"id":"semetey-1-2013:p1311:b004:l018","ordinal":176336,"en":"And tore and scattered his beard."},{"id":"semetey-1-2013:p1311:b004:l019","ordinal":176337,"en":"He began the slaughter;"},{"id":"semetey-1-2013:p1311:b004:l020","ordinal":176338,"en":"From the weapon at his side,"},{"id":"semetey-1-2013:p1311:b004:l021","ordinal":176339,"en":"Drawing it from its sheath,"},{"id":"semetey-1-2013:p1311:b004:l022","ordinal":176340,"en":"He cut off the head"},{"id":"semetey-1-2013:p1311:b004:l023","ordinal":176341,"en":"Of Toltoy, son of Bagysh."},{"id":"semetey-1-2013:p1311:b004:l024","ordinal":176342,"en":"Dragging it onto the road,"},{"id":"semetey-1-2013:p1311:b004:l025","ordinal":176343,"en":"He displayed it to the Dangyt,"},{"id":"semetey-1-2013:p1311:b004:l026","ordinal":176344,"en":"Taking at last his vengeance"},{"id":"semetey-1-2013:p1311:b004:l027","ordinal":176345,"en":"On the swine Toltoy the warrior."},{"id":"semetey-1-2013:p1311:b004:l028","ordinal":176346,"en":"Brave Toltoy's Surkoyon—"},{"id":"semetey-1-2013:p1311:b004:l029","ordinal":176347,"en":"This Koyon was a peerless courser—"},{"id":"semetey-1-2013:p1311:b004:l030","ordinal":176348,"en":"Would let neither hand near"},{"id":"semetey-1-2013:p1311:b004:l031","ordinal":176349,"en":"The reins tied in a knot,"},{"id":"semetey-1-2013:p1311:b004:l032","ordinal":176350,"en":"And seized them in his mouth."},{"id":"semetey-1-2013:p1311:b004:l033","ordinal":176351,"en":"Wheeling around, he sped off,"},{"id":"semetey-1-2013:p1311:b004:l034","ordinal":176352,"en":"Heading toward the Jediger."},{"id":"semetey-1-2013:p1311:b004:l035","ordinal":176353,"en":"He had crossed"},{"id":"semetey-1-2013:p1311:b004:l036","ordinal":176354,"en":"The saddle-shaped ridge."},{"id":"semetey-1-2013:p1311:b004:l037","ordinal":176355,"en":"No wind matched his gallop,"},{"id":"semetey-1-2013:p1311:b004:l038","ordinal":176356,"en":"No beast matched his stride;"},{"id":"semetey-1-2013:p1311:b004:l039","ordinal":176357,"en":"Thus he fled away."},{"id":"semetey-1-2013:p1312:b003:l001","ordinal":176358,"en":"Peerless courser Surkoyon,"},{"id":"semetey-1-2013:p1312:b003:l002","ordinal":176359,"en":"When he came downhill,"},{"id":"semetey-1-2013:p1312:b003:l003","ordinal":176360,"en":"Stretched his forelegs like a roe deer;"},{"id":"semetey-1-2013:p1312:b003:l004","ordinal":176361,"en":"When he leaned into an ascent,"},{"id":"semetey-1-2013:p1312:b003:l005","ordinal":176362,"en":"His mane and tail spread wide."},{"id":"semetey-1-2013:p1312:b003:l006","ordinal":176363,"en":"Flattening his ears like a kulan,"},{"id":"semetey-1-2013:p1312:b003:l007","ordinal":176364,"en":"He swept the earth like a whirlwind."},{"id":"semetey-1-2013:p1312:b003:l008","ordinal":176365,"en":"That lion-like man,"},{"id":"semetey-1-2013:p1312:b003:l009","ordinal":176366,"en":"Making the earth's surface thunder,"},{"id":"semetey-1-2013:p1312:b003:l010","ordinal":176367,"en":"Urged Arbuu rul onward,"},{"id":"semetey-1-2013:p1312:b003:l011","ordinal":176368,"en":"Putting grass on the gray trail,"},{"id":"semetey-1-2013:p1312:b003:l012","ordinal":176369,"en":"And pursued him relentlessly."},{"id":"semetey-1-2013:p1312:b003:l013","ordinal":176370,"en":"Putting grass on the yellow trail,"},{"id":"semetey-1-2013:p1312:b003:l014","ordinal":176371,"en":"He pursued until he turned pale."},{"id":"semetey-1-2013:p1312:b003:l015","ordinal":176372,"en":"Taibuurul beneath him"},{"id":"semetey-1-2013:p1312:b003:l016","ordinal":176373,"en":"Arched his neck like a stag."},{"id":"semetey-1-2013:p1312:b003:l017","ordinal":176374,"en":"Without slowing, he leaped"},{"id":"semetey-1-2013:p1312:b003:l018","ordinal":176375,"en":"Ravines a spear's length wide."},{"id":"semetey-1-2013:p1312:b003:l019","ordinal":176376,"en":"His neck bent like an argali's;"},{"id":"semetey-1-2013:p1312:b003:l020","ordinal":176377,"en":"When a ravine a rope's length wide appeared,"},{"id":"semetey-1-2013:p1312:b003:l021","ordinal":176378,"en":"He gathered himself and cleared it unfailingly."},{"id":"semetey-1-2013:p1312:b003:l022","ordinal":176379,"en":"When brave Toltoy's Surkoyon"},{"id":"semetey-1-2013:p1312:b003:l023","ordinal":176380,"en":"Reached the seven ridges,"},{"id":"semetey-1-2013:p1312:b003:l024","ordinal":176381,"en":"Semetey came from behind,"},{"id":"semetey-1-2013:p1312:b003:l025","ordinal":176382,"en":"Faster than an arrow."},{"id":"semetey-1-2013:p1312:b003:l026","ordinal":176383,"en":"When Semetey caught him,"},{"id":"semetey-1-2013:p1312:b003:l027","ordinal":176384,"en":"He seized the reins then"}]
