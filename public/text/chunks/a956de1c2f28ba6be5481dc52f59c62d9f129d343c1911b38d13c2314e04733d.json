[{"id":"manas-2010:p1447:b001:l017","ordinal":62465,"en":"When the khans gathered and came,"},{"id":"manas-2010:p1447:b001:l018","ordinal":62466,"en":"He lacked for nothing."},{"id":"manas-2010:p1447:b001:l019","ordinal":62467,"en":"If his silver burned, he would not grieve;"},{"id":"manas-2010:p1447:b001:l020","ordinal":62468,"en":"If his gold flowed away, he would not notice."},{"id":"manas-2010:p1447:b001:l021","ordinal":62469,"en":"If you looked inside him,"},{"id":"manas-2010:p1447:b001:l022","ordinal":62470,"en":"He was generous in this world."},{"id":"manas-2010:p1447:b001:l023","ordinal":62471,"en":"Your precious, noble lion"},{"id":"manas-2010:p1447:b001:l024","ordinal":62472,"en":"Was a black-eared tiger."},{"id":"manas-2010:p1447:b001:l025","ordinal":62473,"en":"Then Manas began to speak:"},{"id":"manas-2010:p1447:b001:l026","ordinal":62474,"en":"“Aykhozho, Koshoy, Khan Bakay,"},{"id":"manas-2010:p1447:b001:l027","ordinal":62475,"en":"You elders stand here;"},{"id":"manas-2010:p1447:b001:l028","ordinal":62476,"en":"People, multitude of Muslims,"},{"id":"manas-2010:p1447:b001:l029","ordinal":62477,"en":"All of you stand here."},{"id":"manas-2010:p1447:b001:l030","ordinal":62478,"en":"If I have oppressed you, forgive me;"},{"id":"manas-2010:p1447:b001:l031","ordinal":62479,"en":"If I have spoken harsh words,"},{"id":"manas-2010:p1447:b001:l032","ordinal":62480,"en":"My mighty people, forgive me!"},{"id":"manas-2010:p1447:b001:l033","ordinal":62481,"en":"I destroyed courts and took spoils;"},{"id":"manas-2010:p1447:b001:l034","ordinal":62482,"en":"When I reached twelve,"},{"id":"manas-2010:p1447:b001:l035","ordinal":62483,"en":"I opened roads to many lands."},{"id":"manas-2010:p1447:b001:l036","ordinal":62484,"en":"Mowing down the Russians,"},{"id":"manas-2010:p1447:b001:l037","ordinal":62485,"en":"I won for you in abundance"},{"id":"manas-2010:p1447:b001:l038","ordinal":62486,"en":"Places where you could settle."},{"id":"manas-2010:p1447:b001:l039","ordinal":62487,"en":"‘The Chinese on the borders,"},{"id":"manas-2010:p1447:b001:l040","ordinal":62488,"en":"Put pressure upon them;"},{"id":"manas-2010:p1447:b001:l041","ordinal":62489,"en":"Heed my wish,’ you said."},{"id":"manas-2010:p1447:b001:l042","ordinal":62490,"en":"‘Destroy them and give them to us,’ you said."},{"id":"manas-2010:p1448:b001:l001","ordinal":62491,"en":"When I heard these words of yours,"},{"id":"manas-2010:p1448:b001:l002","ordinal":62492,"en":"Twelve Muslim khans,"},{"id":"manas-2010:p1448:b001:l003","ordinal":62493,"en":"I was dwelling in Talas."},{"id":"manas-2010:p1448:b001:l004","ordinal":62494,"en":"All of you, my mighty people,"},{"id":"manas-2010:p1448:b001:l005","ordinal":62495,"en":"Leaving none of you behind,"},{"id":"manas-2010:p1448:b001:l006","ordinal":62496,"en":"‘I shall campaign against Beijing,’ I said,"},{"id":"manas-2010:p1448:b001:l007","ordinal":62497,"en":"And drove you here, forcing you along."},{"id":"manas-2010:p1448:b001:l008","ordinal":62498,"en":"Whoever said, ‘I have only one horse,’"},{"id":"manas-2010:p1448:b001:l009","ordinal":62499,"en":"‘I shall slaughter and eat his horse,’ I said."},{"id":"manas-2010:p1448:b001:l010","ordinal":62500,"en":"I pressed you hard, Muslims."},{"id":"manas-2010:p1448:b001:l011","ordinal":62501,"en":"Whoever said, ‘I am alone,’"},{"id":"manas-2010:p1448:b001:l012","ordinal":62502,"en":"‘I shall slaughter and eat him,’ I said."},{"id":"manas-2010:p1448:b001:l013","ordinal":62503,"en":"I ruled harshly, Muslims."},{"id":"manas-2010:p1448:b001:l014","ordinal":62504,"en":"‘Your stern warrior Manas"},{"id":"manas-2010:p1448:b001:l015","ordinal":62505,"en":"Has ruled far too harshly,"},{"id":"manas-2010:p1448:b001:l016","ordinal":62506,"en":"Has used overbearing force,’ you said,"},{"id":"manas-2010:p1448:b001:l017","ordinal":62507,"en":"And went about lamenting, Muslims."},{"id":"manas-2010:p1448:b001:l018","ordinal":62508,"en":"‘Manas has brought hardship upon us’—"},{"id":"manas-2010:p1448:b001:l019","ordinal":62509,"en":"Do not grieve overmuch;"},{"id":"manas-2010:p1448:b001:l020","ordinal":62510,"en":"Let your bloodguilt not fall on me."},{"id":"manas-2010:p1448:b001:l021","ordinal":62511,"en":"On the coming Day of Resurrection,"},{"id":"manas-2010:p1448:b001:l022","ordinal":62512,"en":"Do not bring me to torment."},{"id":"manas-2010:p1448:b001:l023","ordinal":62513,"en":"‘He drove us out and slaughtered us;"},{"id":"manas-2010:p1448:b001:l024","ordinal":62514,"en":"He gathered the people of the world,"},{"id":"manas-2010:p1448:b001:l025","ordinal":62515,"en":"Took us away to Beijing,"},{"id":"manas-2010:p1448:b001:l026","ordinal":62516,"en":"And plunged us into suffering."},{"id":"manas-2010:p1448:b001:l027","ordinal":62517,"en":"Our wretched wives and young children"},{"id":"manas-2010:p1448:b001:l028","ordinal":62518,"en":"We shall never see again’—"},{"id":"manas-2010:p1448:b001:l029","ordinal":62519,"en":"On the Day of Judgment,"},{"id":"manas-2010:p1448:b001:l030","ordinal":62520,"en":"Do not claim your blood from me."},{"id":"manas-2010:p1448:b001:l031","ordinal":62521,"en":"You who say, ‘My father is old,’"},{"id":"manas-2010:p1448:b001:l032","ordinal":62522,"en":"Return to your country now."},{"id":"manas-2010:p1448:b001:l033","ordinal":62523,"en":"You who say, ‘I am weak,’"},{"id":"manas-2010:p1448:b001:l034","ordinal":62524,"en":"Go back to your country now."},{"id":"manas-2010:p1448:b001:l035","ordinal":62525,"en":"Those who would leave, return"},{"id":"manas-2010:p1448:b001:l036","ordinal":62526,"en":"To the people of your birth and kin!”"},{"id":"manas-2010:p1448:b001:l037","ordinal":62527,"en":"Thus warrior Manas,"},{"id":"manas-2010:p1448:b001:l038","ordinal":62528,"en":"As he proclaimed his decree,"},{"id":"manas-2010:p1448:b001:l039","ordinal":62529,"en":"The people stirred, remembering home."},{"id":"manas-2010:p1448:b001:l040","ordinal":62530,"en":"How many rejoiced,"},{"id":"manas-2010:p1448:b001:l041","ordinal":62531,"en":"Remembering where their navels were cut, birth-water spilled,"},{"id":"manas-2010:p1448:b001:l042","ordinal":62532,"en":"The ground where they had played."},{"id":"manas-2010:p1449:b001:l001","ordinal":62533,"en":"The wife Chubak had married,"},{"id":"manas-2010:p1449:b001:l002","ordinal":62534,"en":"Ay Jangjung's daughter Birmyskal,"},{"id":"manas-2010:p1449:b001:l003","ordinal":62535,"en":"Loading gold and silver in balanced packs,"},{"id":"manas-2010:p1449:b001:l004","ordinal":62536,"en":"Valuing the red gold coins,"},{"id":"manas-2010:p1449:b001:l005","ordinal":62537,"en":"Taking many kinds of cloth,"},{"id":"manas-2010:p1449:b001:l006","ordinal":62538,"en":"Taking many slaves from the Chinese,"},{"id":"manas-2010:p1449:b001:l007","ordinal":62539,"en":"With their champion Bakay at their head,"},{"id":"manas-2010:p1449:b001:l008","ordinal":62540,"en":"Meant to return to Talas."},{"id":"manas-2010:p1449:b001:l009","ordinal":62541,"en":"Esenkan's daughter Burulcha,"},{"id":"manas-2010:p1449:b001:l010","ordinal":62542,"en":"The woman Almambet had married,"},{"id":"manas-2010:p1449:b001:l011","ordinal":62543,"en":"They dressed in loosely draped silk."},{"id":"manas-2010:p1449:b001:l012","ordinal":62544,"en":"From the perfectly beautiful girls,"},{"id":"manas-2010:p1449:b001:l013","ordinal":62545,"en":"They gave girls as attendants."},{"id":"manas-2010:p1449:b001:l014","ordinal":62546,"en":"From the costly robes,"},{"id":"manas-2010:p1449:b001:l015","ordinal":62547,"en":"From the cloth worked with gold,"},{"id":"manas-2010:p1449:b001:l016","ordinal":62548,"en":"They gave cloth tied up in bundles."},{"id":"manas-2010:p1449:b001:l017","ordinal":62549,"en":"Taking selected slaves,"},{"id":"manas-2010:p1449:b001:l018","ordinal":62550,"en":"From her own allotted share,"},{"id":"manas-2010:p1449:b001:l019","ordinal":62551,"en":"Taking possessions from Esenkan,"},{"id":"manas-2010:p1449:b001:l020","ordinal":62552,"en":"The gold and silver,"},{"id":"manas-2010:p1449:b001:l021","ordinal":62553,"en":"Khan Bakay could not load it all."},{"id":"manas-2010:p1449:b001:l022","ordinal":62554,"en":"Fair young women, beautiful girls,"},{"id":"manas-2010:p1449:b001:l023","ordinal":62555,"en":"Khan Bakay could not take them all as spoils."},{"id":"manas-2010:p1449:b001:l024","ordinal":62556,"en":"Extinguishing their fires, letting none be lit,"},{"id":"manas-2010:p1449:b001:l025","ordinal":62557,"en":"Ay Jangjung's daughter Birmyskal,"},{"id":"manas-2010:p1449:b001:l026","ordinal":62558,"en":"Esenkan's daughter Burulcha,"},{"id":"manas-2010:p1449:b001:l027","ordinal":62559,"en":"With their full display of splendor,"},{"id":"manas-2010:p1449:b001:l028","ordinal":62560,"en":"Making the face of the earth swarm,"},{"id":"manas-2010:p1449:b001:l029","ordinal":62561,"en":"He led them out in migration."},{"id":"manas-2010:p1449:b001:l030","ordinal":62562,"en":"The kakan's great city of Beijing,"},{"id":"manas-2010:p1449:b001:l031","ordinal":62563,"en":"Its people fell into sorrow,"},{"id":"manas-2010:p1449:b001:l032","ordinal":62564,"en":"Burulcha and Birmyskal—"},{"id":"manas-2010:p1449:b001:l033","ordinal":62565,"en":"Those close to these two women."},{"id":"manas-2010:p1449:b001:l034","ordinal":62566,"en":"Wearing mail, moving gracefully,"},{"id":"manas-2010:p1449:b001:l035","ordinal":62567,"en":"Crimson dresses, slanting eyes,"},{"id":"manas-2010:p1449:b001:l036","ordinal":62568,"en":"Rooster necks and slender waists,"},{"id":"manas-2010:p1449:b001:l037","ordinal":62569,"en":"Beauties unmatched anywhere,"},{"id":"manas-2010:p1449:b001:l038","ordinal":62570,"en":"Setting off with Burulcha,"},{"id":"manas-2010:p1449:b001:l039","ordinal":62571,"en":"They swayed along toward Talas,"},{"id":"manas-2010:p1449:b001:l040","ordinal":62572,"en":"Taken as spoils for Manas."},{"id":"manas-2010:p1449:b001:l041","ordinal":62573,"en":"Riding red pacing horses,"},{"id":"manas-2010:p1449:b001:l042","ordinal":62574,"en":"Their manes bound snugly,"},{"id":"manas-2010:p1450:b001:l001","ordinal":62575,"en":"Wearing crimson coats,"},{"id":"manas-2010:p1450:b001:l002","ordinal":62576,"en":"All the girls said,"},{"id":"manas-2010:p1450:b001:l003","ordinal":62577,"en":"“We have become Bakay's spoils,”"},{"id":"manas-2010:p1450:b001:l004","ordinal":62578,"en":"And rode away toward Talas."},{"id":"manas-2010:p1450:b001:l005","ordinal":62579,"en":"Every one of these"},{"id":"manas-2010:p1450:b001:l006","ordinal":62580,"en":"The aged Khan Bakay"},{"id":"manas-2010:p1450:b001:l007","ordinal":62581,"en":"Led along behind him,"},{"id":"manas-2010:p1450:b001:l008","ordinal":62582,"en":"Bringing them out of Beijing."},{"id":"manas-2010:p1450:b001:l009","ordinal":62583,"en":"When they departed,"},{"id":"manas-2010:p1450:b001:l010","ordinal":62584,"en":"Dust covered the face of the earth;"},{"id":"manas-2010:p1450:b001:l011","ordinal":62585,"en":"The many Chinese of forty khans"},{"id":"manas-2010:p1450:b001:l012","ordinal":62586,"en":"Were all numbed with grief."},{"id":"manas-2010:p1450:b001:l013","ordinal":62587,"en":"The many Chinese lost their spirit,"},{"id":"manas-2010:p1450:b001:l014","ordinal":62588,"en":"Their minds bewildered and confused."},{"id":"manas-2010:p1450:b001:l015","ordinal":62589,"en":"If all this is true,"},{"id":"manas-2010:p1450:b001:l016","ordinal":62590,"en":"It brought the Muslims joy;"},{"id":"manas-2010:p1450:b001:l017","ordinal":62591,"en":"These deeds of Manas"},{"id":"manas-2010:p1450:b001:l018","ordinal":62592,"en":"Were heard throughout the world,"},{"id":"manas-2010:p1450:b001:l019","ordinal":62593,"en":"Bringing him fame among the people."},{"id":"manas-2010:p1450:b001:l020","ordinal":62594,"en":"Khan Koshoy of the Katagan"},{"id":"manas-2010:p1450:b001:l021","ordinal":62595,"en":"Had white in his beard;"},{"id":"manas-2010:p1450:b001:l022","ordinal":62596,"en":"He had reached old age."},{"id":"manas-2010:p1450:b001:l023","ordinal":62597,"en":"“The joy God has granted—"},{"id":"manas-2010:p1450:b001:l024","ordinal":62598,"en":"Let me see that this is what it is;"},{"id":"manas-2010:p1450:b001:l025","ordinal":62599,"en":"Among the common Katagan,"},{"id":"manas-2010:p1450:b001:l026","ordinal":62600,"en":"My vast, proud people,"},{"id":"manas-2010:p1450:b001:l027","ordinal":62601,"en":"Let me reach my homeland and die.”"},{"id":"manas-2010:p1450:b001:l028","ordinal":62602,"en":"So saying, Khan Koshoy"},{"id":"manas-2010:p1450:b001:l029","ordinal":62603,"en":"Took a thousand of his soldiers;"},{"id":"manas-2010:p1450:b001:l030","ordinal":62604,"en":"To carry away his spoils,"},{"id":"manas-2010:p1450:b001:l031","ordinal":62605,"en":"From that city of Beijing"},{"id":"manas-2010:p1450:b001:l032","ordinal":62606,"en":"He took a thousand red camels,"},{"id":"manas-2010:p1450:b001:l033","ordinal":62607,"en":"And he too left Beijing."},{"id":"manas-2010:p1450:b001:l034","ordinal":62608,"en":"Eleman's hero Töshtük,"},{"id":"manas-2010:p1450:b001:l035","ordinal":62609,"en":"When he went beneath the earth,"},{"id":"manas-2010:p1450:b001:l036","ordinal":62610,"en":"Had vanished for seven years;"},{"id":"manas-2010:p1450:b001:l037","ordinal":62611,"en":"Since he emerged from underground,"},{"id":"manas-2010:p1450:b001:l038","ordinal":62612,"en":"Three years had now passed."},{"id":"manas-2010:p1450:b001:l039","ordinal":62613,"en":"Struggling with the dragon,"},{"id":"manas-2010:p1450:b001:l040","ordinal":62614,"en":"He had worn himself away;"},{"id":"manas-2010:p1450:b001:l041","ordinal":62615,"en":"The cauldron with forty handles,"},{"id":"manas-2010:p1450:b001:l042","ordinal":62616,"en":"When he dragged it out with difficulty,"},{"id":"manas-2010:p1451:b001:l001","ordinal":62617,"en":"Half his life had gone."},{"id":"manas-2010:p1451:b001:l002","ordinal":62618,"en":"A spoonful of blood remained,"},{"id":"manas-2010:p1451:b001:l003","ordinal":62619,"en":"His flesh was wasted, utterly lean;"},{"id":"manas-2010:p1451:b001:l004","ordinal":62620,"en":"That unlucky man in a thin coat,"},{"id":"manas-2010:p1451:b001:l005","ordinal":62621,"en":"Who never escaped misfortune,"},{"id":"manas-2010:p1451:b001:l006","ordinal":62622,"en":"Eleman's poor son,"},{"id":"manas-2010:p1451:b001:l007","ordinal":62623,"en":"Resolved to go home."},{"id":"manas-2010:p1451:b001:l008","ordinal":62624,"en":"“If enemy raiders confront me,"},{"id":"manas-2010:p1451:b001:l009","ordinal":62625,"en":"If death overtakes me on the road,"},{"id":"manas-2010:p1451:b001:l010","ordinal":62626,"en":"He will understand a traveler's plight"},{"id":"manas-2010:p1451:b001:l011","ordinal":62627,"en":"And give me companionship,” he said."},{"id":"manas-2010:p1451:b001:l012","ordinal":62628,"en":"Taking Körögöch with him,"},{"id":"manas-2010:p1451:b001:l013","ordinal":62629,"en":"Selecting five hundred soldiers,"},{"id":"manas-2010:p1451:b001:l014","ordinal":62630,"en":"Taking gold, silver and coins,"},{"id":"manas-2010:p1451:b001:l015","ordinal":62631,"en":"Taking abundant spoils,"},{"id":"manas-2010:p1451:b001:l016","ordinal":62632,"en":"Taking girls with black eyes,"},{"id":"manas-2010:p1451:b001:l017","ordinal":62633,"en":"Taking so many beautiful maidens,"},{"id":"manas-2010:p1451:b001:l018","ordinal":62634,"en":"Töshtük returned to his land."},{"id":"manas-2010:p1451:b001:l019","ordinal":62635,"en":"Nine khans remained:"},{"id":"manas-2010:p1451:b001:l020","ordinal":62636,"en":"“Most of the Burut have gone,”"},{"id":"manas-2010:p1451:b001:l021","ordinal":62637,"en":"The news spread among the Chinese."},{"id":"manas-2010:p1451:b001:l022","ordinal":62638,"en":"With his cotton sash and broad boots,"},{"id":"manas-2010:p1451:b001:l023","ordinal":62639,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1451:b001:l024","ordinal":62640,"en":"Had Shuykuchu living with Manas,"},{"id":"manas-2010:p1451:b001:l025","ordinal":62641,"en":"Who carried news to the Kalcha"},{"id":"manas-2010:p1451:b001:l026","ordinal":62642,"en":"Morning and evening."},{"id":"manas-2010:p1451:b001:l027","ordinal":62643,"en":"With golden forelock and tasseled belt,"},{"id":"manas-2010:p1451:b001:l028","ordinal":62644,"en":"Azizkan's only son"},{"id":"manas-2010:p1451:b001:l029","ordinal":62645,"en":"Turned summer days to winter;"},{"id":"manas-2010:p1451:b001:l030","ordinal":62646,"en":"The Chinese in their thin clothes"},{"id":"manas-2010:p1451:b001:l031","ordinal":62647,"en":"He made tremble like girls,"},{"id":"manas-2010:p1451:b001:l032","ordinal":62648,"en":"And held them all in submission."},{"id":"manas-2010:p1451:b001:l033","ordinal":62649,"en":"Over the Sibe and Manchu"},{"id":"manas-2010:p1451:b001:l034","ordinal":62650,"en":"Chubak had become ruler."},{"id":"manas-2010:p1451:b001:l035","ordinal":62651,"en":"Where ninety mountains meet,"},{"id":"manas-2010:p1451:b001:l036","ordinal":62652,"en":"Where nine rivers join,"},{"id":"manas-2010:p1451:b001:l037","ordinal":62653,"en":"With a single path unknown to men,"},{"id":"manas-2010:p1451:b001:l038","ordinal":62654,"en":"With warrior Almambet at their head,"},{"id":"manas-2010:p1451:b001:l039","ordinal":62655,"en":"An army of one san lay spread out."},{"id":"manas-2010:p1451:b001:l040","ordinal":62656,"en":"Let me tell the army's state:"},{"id":"manas-2010:p1451:b001:l041","ordinal":62657,"en":"When bored, they ate their yearlings,"},{"id":"manas-2010:p1451:b001:l042","ordinal":62658,"en":"Eating horse-belly fat, guts and grease,"},{"id":"manas-2010:p1452:b001:l001","ordinal":62659,"en":"The great army feasted noisily."},{"id":"manas-2010:p1452:b001:l002","ordinal":62660,"en":"They slaughtered plentiful meat;"},{"id":"manas-2010:p1452:b001:l003","ordinal":62661,"en":"Fermented mare's milk by day, girls by night,"},{"id":"manas-2010:p1452:b001:l004","ordinal":62662,"en":"The foolish, leaderless host"},{"id":"manas-2010:p1452:b001:l005","ordinal":62663,"en":"Did whatever they pleased,"},{"id":"manas-2010:p1452:b001:l006","ordinal":62664,"en":"Playing the wolves-and-sheep game with a din,"},{"id":"manas-2010:p1452:b001:l007","ordinal":62665,"en":"Marking a circle forty paces wide,"},{"id":"manas-2010:p1452:b001:l008","ordinal":62666,"en":"Setting out their knucklebone game,"},{"id":"manas-2010:p1452:b001:l009","ordinal":62667,"en":"The great army kept playing."},{"id":"manas-2010:p1452:b001:l010","ordinal":62668,"en":"Once they said the Kalcha was coming,"},{"id":"manas-2010:p1452:b001:l011","ordinal":62669,"en":"The kakan's Beijing,"},{"id":"manas-2010:p1452:b001:l012","ordinal":62670,"en":"The great Manchu and Chinese hosts,"},{"id":"manas-2010:p1452:b001:l013","ordinal":62671,"en":"They paid no heed to any of them."},{"id":"manas-2010:p1452:b001:l014","ordinal":62672,"en":"At that time, guarding Manas"},{"id":"manas-2010:p1452:b001:l015","ordinal":62673,"en":"Were the forty companions."},{"id":"manas-2010:p1452:b001:l016","ordinal":62674,"en":"Serving as scouts for Manas,"},{"id":"manas-2010:p1452:b001:l017","ordinal":62675,"en":"Serek and Syrgak stood there;"},{"id":"manas-2010:p1452:b001:l018","ordinal":62676,"en":"On this side of them,"},{"id":"manas-2010:p1452:b001:l019","ordinal":62677,"en":"Yraman's son Yrchy Uul,"},{"id":"manas-2010:p1452:b001:l020","ordinal":62678,"en":"Tölöman's diviner,"},{"id":"manas-2010:p1452:b001:l021","ordinal":62679,"en":"His darling called Bozuul,"},{"id":"manas-2010:p1452:b001:l022","ordinal":62680,"en":"The leader of the forty, old Kyrgyl—"},{"id":"manas-2010:p1452:b001:l023","ordinal":62681,"en":"The mad old man, wild even at forty;"},{"id":"manas-2010:p1452:b001:l024","ordinal":62682,"en":"There was beloved Shuutu,"},{"id":"manas-2010:p1452:b001:l025","ordinal":62683,"en":"And the hero Baychoro,"},{"id":"manas-2010:p1452:b001:l026","ordinal":62684,"en":"And Agayar too."},{"id":"manas-2010:p1452:b001:l027","ordinal":62685,"en":"Allowing no horse to approach,"},{"id":"manas-2010:p1452:b001:l028","ordinal":62686,"en":"The forty companions guarded the door,"},{"id":"manas-2010:p1452:b001:l029","ordinal":62687,"en":"Letting no person reach hero Manas"},{"id":"manas-2010:p1452:b001:l030","ordinal":62688,"en":"Without permission;"},{"id":"manas-2010:p1452:b001:l031","ordinal":62689,"en":"They encircled him like iron."},{"id":"manas-2010:p1452:b001:l032","ordinal":62690,"en":"If the Chinese voiced their grief,"},{"id":"manas-2010:p1452:b001:l033","ordinal":62691,"en":"They slaughtered and ate their horses too."},{"id":"manas-2010:p1452:b001:l034","ordinal":62692,"en":"Hero Manas's forty companions"},{"id":"manas-2010:p1452:b001:l035","ordinal":62693,"en":"Made those who listened"},{"id":"manas-2010:p1452:b001:l036","ordinal":62694,"en":"Fear them through their words;"},{"id":"manas-2010:p1452:b001:l037","ordinal":62695,"en":"Those who did not listen"},{"id":"manas-2010:p1452:b001:l038","ordinal":62696,"en":"They frightened with their swords."},{"id":"manas-2010:p1452:b001:l039","ordinal":62697,"en":"Asked for a cap, they cut off a head;"},{"id":"manas-2010:p1452:b001:l040","ordinal":62698,"en":"The forty companions stood apart."},{"id":"manas-2010:p1452:b001:l041","ordinal":62699,"en":"Seeing such force,"},{"id":"manas-2010:p1452:b001:l042","ordinal":62700,"en":"The Chinese people of forty khans"},{"id":"manas-2010:p1453:b001:l001","ordinal":62701,"en":"Felt the pressure upon them."},{"id":"manas-2010:p1453:b001:l002","ordinal":62702,"en":"“Like this, without pity for us,"},{"id":"manas-2010:p1453:b001:l003","ordinal":62703,"en":"Manas will slaughter us and depart;"},{"id":"manas-2010:p1453:b001:l004","ordinal":62704,"en":"The Manchu and Chinese"},{"id":"manas-2010:p1453:b001:l005","ordinal":62705,"en":"Will be destroyed by the Burut,” they said."},{"id":"manas-2010:p1453:b001:l006","ordinal":62706,"en":"Manas's forty companions"},{"id":"manas-2010:p1453:b001:l007","ordinal":62707,"en":"Played at wrestling, raising dust;"},{"id":"manas-2010:p1453:b001:l008","ordinal":62708,"en":"They played at wrestling on horseback,"},{"id":"manas-2010:p1453:b001:l009","ordinal":62709,"en":"Charging out two by two."},{"id":"manas-2010:p1453:b001:l010","ordinal":62710,"en":"“If they meet us, they will kill us,”"},{"id":"manas-2010:p1453:b001:l011","ordinal":62711,"en":"Unable to endure their wrath,"},{"id":"manas-2010:p1453:b001:l012","ordinal":62712,"en":"The many Chinese and Manchu"},{"id":"manas-2010:p1453:b001:l013","ordinal":62713,"en":"Fled headlong from the road."},{"id":"manas-2010:p1453:b001:l014","ordinal":62714,"en":"None paused to think or reason;"},{"id":"manas-2010:p1453:b001:l015","ordinal":62715,"en":"Among the Chinese and Manchu"},{"id":"manas-2010:p1453:b001:l016","ordinal":62716,"en":"No man remained who could resist."},{"id":"manas-2010:p1453:b001:l017","ordinal":62717,"en":"In the kakan's Beijing,"},{"id":"manas-2010:p1453:b001:l018","ordinal":62718,"en":"Hero Manas thundered;"},{"id":"manas-2010:p1453:b001:l019","ordinal":62719,"en":"The many Chinese and Manchu"},{"id":"manas-2010:p1453:b001:l020","ordinal":62720,"en":"Fled, leaving the bare earth."}]
