[{"id":"semetey-1-2013:p1075:b003:l038","ordinal":158209,"en":"Let me tell of the hero's condition."},{"id":"semetey-1-2013:p1075:b003:l039","ordinal":158210,"en":"Wrapped in the blue Kübө coat,"},{"id":"semetey-1-2013:p1075:b005:l001","ordinal":158211,"en":"Straining like a blue tiger,"},{"id":"semetey-1-2013:p1075:b005:l002","ordinal":158212,"en":"With a rope slung around his neck,"},{"id":"semetey-1-2013:p1075:b005:l003","ordinal":158213,"en":"He led a white-gray mare"},{"id":"semetey-1-2013:p1075:b005:l004","ordinal":158214,"en":"That had borne no foal for seven years."},{"id":"semetey-1-2013:p1075:b005:l005","ordinal":158215,"en":"The hero, son of Manas,"},{"id":"semetey-1-2013:p1075:b005:l006","ordinal":158216,"en":"Slung the rope around his neck"},{"id":"semetey-1-2013:p1075:b005:l007","ordinal":158217,"en":"And prayed to the Creator:"},{"id":"semetey-1-2013:p1075:b005:l008","ordinal":158218,"en":"He spread his hands, saying, \"Amen!\""},{"id":"semetey-1-2013:p1075:b005:l009","ordinal":158219,"en":"His heart cruelly divided,"},{"id":"semetey-1-2013:p1075:b005:l010","ordinal":158220,"en":"Tears pouring from his eyes,"},{"id":"semetey-1-2013:p1075:b005:l011","ordinal":158221,"en":"He slung around his neck"},{"id":"semetey-1-2013:p1075:b005:l012","ordinal":158222,"en":"The great purse left by Manas"},{"id":"semetey-1-2013:p1075:b005:l013","ordinal":158223,"en":"And prayed to the one God:"},{"id":"semetey-1-2013:p1075:b005:l014","ordinal":158224,"en":"\"Amen, God, amen!"},{"id":"semetey-1-2013:p1075:b005:l015","ordinal":158225,"en":"The one horse equal in worth to a life"},{"id":"semetey-1-2013:p1075:b005:l016","ordinal":158226,"en":"Carries the young boy away."},{"id":"semetey-1-2013:p1075:b005:l017","ordinal":158227,"en":"If you let it be flattened, that is disgrace."},{"id":"semetey-1-2013:p1075:b005:l018","ordinal":158228,"en":"Buurul, whom none would give when asked—"},{"id":"semetey-1-2013:p1075:b005:l019","ordinal":158229,"en":"When the boy mounted without inspiring envy,"},{"id":"semetey-1-2013:p1075:b005:l020","ordinal":158230,"en":"My age was cruelly scorched."},{"id":"semetey-1-2013:p1075:b005:l021","ordinal":158231,"en":"He is riding away to witness"},{"id":"semetey-1-2013:p1075:b005:l022","ordinal":158232,"en":"The suffering laid down by the Creator;"},{"id":"semetey-1-2013:p1075:b005:l023","ordinal":158233,"en":"A young boy of twelve"},{"id":"semetey-1-2013:p1075:b005:l024","ordinal":158234,"en":"Is riding away to die"},{"id":"semetey-1-2013:p1075:b005:l025","ordinal":158235,"en":"At Toltoy of the Zhediger's hands."},{"id":"semetey-1-2013:p1075:b005:l026","ordinal":158236,"en":"Will practiced Chynkozho"},{"id":"semetey-1-2013:p1075:b005:l027","ordinal":158237,"en":"Spear through and overturn"},{"id":"semetey-1-2013:p1075:b005:l028","ordinal":158238,"en":"The twelve-year-old boy,"},{"id":"semetey-1-2013:p1075:b005:l029","ordinal":158239,"en":"I lament before God,"},{"id":"semetey-1-2013:p1075:b005:l030","ordinal":158240,"en":"And take Buurul beneath him as plunder?!"},{"id":"semetey-1-2013:p1075:b005:l031","ordinal":158241,"en":"You have multiplied these worries so greatly;"},{"id":"semetey-1-2013:p1075:b005:l032","ordinal":158242,"en":"Will the Almighty reveal"},{"id":"semetey-1-2013:p1075:b005:l033","ordinal":158243,"en":"The boy, small as a crow?"},{"id":"semetey-1-2013:p1075:b005:l034","ordinal":158244,"en":"My thoroughbred Narbuudan"},{"id":"semetey-1-2013:p1075:b005:l035","ordinal":158245,"en":"Would not tire if ridden for six months."},{"id":"semetey-1-2013:p1075:b005:l036","ordinal":158246,"en":"I lament before God"},{"id":"semetey-1-2013:p1075:b005:l037","ordinal":158247,"en":"For Külchoro, my kinsman."},{"id":"semetey-1-2013:p1075:b005:l038","ordinal":158248,"en":"The prayer of my kinsman—"},{"id":"semetey-1-2013:p1075:b005:l039","ordinal":158249,"en":"Unable to remain standing, this poor soul—"},{"id":"semetey-1-2013:p1076:b003:l001","ordinal":158250,"en":"I stand asking it of God."},{"id":"semetey-1-2013:p1076:b003:l002","ordinal":158251,"en":"May the blessing remain with the boy."},{"id":"semetey-1-2013:p1076:b003:l003","ordinal":158252,"en":"My time is cruelly divided;"},{"id":"semetey-1-2013:p1076:b003:l004","ordinal":158253,"en":"If brave Toltoy is skillful,"},{"id":"semetey-1-2013:p1076:b003:l005","ordinal":158254,"en":"It seems he will seize"},{"id":"semetey-1-2013:p1076:b003:l006","ordinal":158255,"en":"The twelve-year-old boy."},{"id":"semetey-1-2013:p1076:b003:l007","ordinal":158256,"en":"Thinking of this, my wretched soul,"},{"id":"semetey-1-2013:p1076:b003:l008","ordinal":158257,"en":"My time is cruelly divided."},{"id":"semetey-1-2013:p1076:b003:l009","ordinal":158258,"en":"The twelve-year-old boy—"},{"id":"semetey-1-2013:p1076:b003:l010","ordinal":158259,"en":"Will Toltoy seize him,"},{"id":"semetey-1-2013:p1076:b003:l011","ordinal":158260,"en":"And, before he can say the Bismillah,"},{"id":"semetey-1-2013:p1076:b003:l012","ordinal":158261,"en":"Slaughter him as a sacrifice?"},{"id":"semetey-1-2013:p1076:b003:l013","ordinal":158262,"en":"He has no mane against which to scratch;"},{"id":"semetey-1-2013:p1076:b003:l014","ordinal":158263,"en":"To the Argyn and Kyrgyz,"},{"id":"semetey-1-2013:p1076:b003:l015","ordinal":158264,"en":"Will the prince return slack and helpless?!"},{"id":"semetey-1-2013:p1076:b003:l016","ordinal":158265,"en":"Before he reaches maturity,"},{"id":"semetey-1-2013:p1076:b003:l017","ordinal":158266,"en":"Will my indispensable Külchoro"},{"id":"semetey-1-2013:p1076:b003:l018","ordinal":158267,"en":"Die a needless death?\""},{"id":"semetey-1-2013:p1076:b003:l019","ordinal":158268,"en":"Speaking and grieving so, Semetey"},{"id":"semetey-1-2013:p1076:b003:l020","ordinal":158269,"en":"Stood there as a sorrowing prince;"},{"id":"semetey-1-2013:p1076:b003:l021","ordinal":158270,"en":"The common people wept, the khan wept,"},{"id":"semetey-1-2013:p1076:b003:l022","ordinal":158271,"en":"All the gathered multitude wept,"},{"id":"semetey-1-2013:p1076:b003:l023","ordinal":158272,"en":"The beauty Aychürök wept,"},{"id":"semetey-1-2013:p1076:b003:l024","ordinal":158273,"en":"And the young women and maidens cried aloud."},{"id":"semetey-1-2013:p1076:b003:l025","ordinal":158274,"en":"Brave Semeң, son of Manas,"},{"id":"semetey-1-2013:p1076:b003:l026","ordinal":158275,"en":"Born of his father, gray-maned Manas,"},{"id":"semetey-1-2013:p1076:b003:l027","ordinal":158276,"en":"A hero greater than he—"},{"id":"semetey-1-2013:p1076:b003:l028","ordinal":158277,"en":"Your prince did not stop then."},{"id":"semetey-1-2013:p1076:b003:l029","ordinal":158278,"en":"Taking the inner shortcut,"},{"id":"semetey-1-2013:p1076:b003:l030","ordinal":158279,"en":"He brought out the gray mare"},{"id":"semetey-1-2013:p1076:b003:l031","ordinal":158280,"en":"Of Khan Akun, barren for six years,"},{"id":"semetey-1-2013:p1076:b003:l032","ordinal":158281,"en":"Leading it by the halter."},{"id":"semetey-1-2013:p1076:b003:l033","ordinal":158282,"en":"The leopard born of a gray-maned lion"},{"id":"semetey-1-2013:p1076:b003:l034","ordinal":158283,"en":"Made it rear, crying, \"Amen!\""},{"id":"semetey-1-2013:p1076:b003:l035","ordinal":158284,"en":"He now grasped together"},{"id":"semetey-1-2013:p1076:b003:l036","ordinal":158285,"en":"Its forelock and its ear,"},{"id":"semetey-1-2013:p1076:b003:l037","ordinal":158286,"en":"Then took in his hand"},{"id":"semetey-1-2013:p1076:b003:l038","ordinal":158287,"en":"The white saber with mottled neck."},{"id":"semetey-1-2013:p1076:b003:l039","ordinal":158288,"en":"Holding the mare upright,"},{"id":"semetey-1-2013:p1076:b004:l001","ordinal":158289,"en":"He now cut off its head:"},{"id":"semetey-1-2013:p1076:b004:l002","ordinal":158290,"en":"\"Make this an age without grief;"},{"id":"semetey-1-2013:p1076:b004:l003","ordinal":158291,"en":"If God created him as a living soul,"},{"id":"semetey-1-2013:p1076:b004:l004","ordinal":158292,"en":"Keep Külchoro safe!\""},{"id":"semetey-1-2013:p1076:b004:l005","ordinal":158293,"en":"Your heroic gray-maned lion"},{"id":"semetey-1-2013:p1076:b004:l006","ordinal":158294,"en":"Now sacrificed the white-gray mare;"},{"id":"semetey-1-2013:p1076:b004:l007","ordinal":158295,"en":"Spreading his hands, saying, \"Amen,\""},{"id":"semetey-1-2013:p1076:b004:l008","ordinal":158296,"en":"He now performed the rite"},{"id":"semetey-1-2013:p1076:b004:l009","ordinal":158297,"en":"And sent the boy on his way."},{"id":"semetey-1-2013:p1076:b004:l010","ordinal":158298,"en":"Then Külchoro, son of Almambet,"},{"id":"semetey-1-2013:p1076:b004:l011","ordinal":158299,"en":"Girded on a silver belt,"},{"id":"semetey-1-2013:p1076:b004:l012","ordinal":158300,"en":"His sunlike face touched with radiance,"},{"id":"semetey-1-2013:p1076:b004:l013","ordinal":158301,"en":"Dressed in a coat no bullet pierced."},{"id":"semetey-1-2013:p1076:b004:l014","ordinal":158302,"en":"When told he was going to Toltoy,"},{"id":"semetey-1-2013:p1076:b004:l015","ordinal":158303,"en":"Without frown or knitted brow,"},{"id":"semetey-1-2013:p1076:b004:l016","ordinal":158304,"en":"The boy smiled openly in joy."},{"id":"semetey-1-2013:p1076:b004:l017","ordinal":158305,"en":"He was as large as half a mountain;"},{"id":"semetey-1-2013:p1076:b004:l018","ordinal":158306,"en":"An ancestral spirit settled upon the boy."},{"id":"semetey-1-2013:p1076:b004:l019","ordinal":158307,"en":"He wheeled Arbuudan sideways,"},{"id":"semetey-1-2013:p1076:b004:l020","ordinal":158308,"en":"And, angling close"},{"id":"semetey-1-2013:p1076:b004:l021","ordinal":158309,"en":"To his elder Semetey,"},{"id":"semetey-1-2013:p1076:b004:l022","ordinal":158310,"en":"Gave leave and began to speak:"},{"id":"semetey-1-2013:p1076:b004:l023","ordinal":158311,"en":"\"Gray-maned elder brother, leopard!"},{"id":"semetey-1-2013:p1076:b004:l024","ordinal":158312,"en":"Who would rejoice at this?"},{"id":"semetey-1-2013:p1076:b004:l025","ordinal":158313,"en":"Why do you keep grieving"},{"id":"semetey-1-2013:p1076:b004:l026","ordinal":158314,"en":"For the servant you raised?"},{"id":"semetey-1-2013:p1076:b004:l027","ordinal":158315,"en":"You have kin, you have your beloved;"},{"id":"semetey-1-2013:p1076:b004:l028","ordinal":158316,"en":"You have every enemy before you,"},{"id":"semetey-1-2013:p1076:b004:l029","ordinal":158317,"en":"My falcon elder brother—farewell."},{"id":"semetey-1-2013:p1076:b004:l030","ordinal":158318,"en":"God knows whether I shall die"},{"id":"semetey-1-2013:p1076:b004:l031","ordinal":158319,"en":"At Toltoy of the Zhediger's hands;"},{"id":"semetey-1-2013:p1076:b004:l032","ordinal":158320,"en":"God knows whether I shall remain alive."},{"id":"semetey-1-2013:p1076:b004:l033","ordinal":158321,"en":"You stand in needless worry"},{"id":"semetey-1-2013:p1076:b004:l034","ordinal":158322,"en":"And keep grieving in vain"},{"id":"semetey-1-2013:p1076:b004:l035","ordinal":158323,"en":"For an orphan boy like me."},{"id":"semetey-1-2013:p1076:b004:l036","ordinal":158324,"en":"I am a bound-headed boy,"},{"id":"semetey-1-2013:p1076:b004:l037","ordinal":158325,"en":"As though I had come here in resentment;"},{"id":"semetey-1-2013:p1076:b004:l038","ordinal":158326,"en":"From the beginning I was a servant"},{"id":"semetey-1-2013:p1076:b004:l039","ordinal":158327,"en":"Who girded your waist securely—"}]
