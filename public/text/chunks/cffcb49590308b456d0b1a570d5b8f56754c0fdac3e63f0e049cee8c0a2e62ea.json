[{"id":"semetey-1-2013:p0721:b003:l017","ordinal":131585,"en":"‘To this day, the Burut Manas"},{"id":"semetey-1-2013:p0721:b003:l018","ordinal":131586,"en":"You have not bent down and speared!"},{"id":"semetey-1-2013:p0721:b003:l019","ordinal":131587,"en":"Let alone the Burut's horses,"},{"id":"semetey-1-2013:p0721:b003:l020","ordinal":131588,"en":"You have not driven off their cattle!"},{"id":"semetey-1-2013:p0721:b003:l021","ordinal":131589,"en":"Raging and boasting—"},{"id":"semetey-1-2013:p0721:b003:l022","ordinal":131590,"en":"Where is Khan Kongurbai,"},{"id":"semetey-1-2013:p0721:b003:l023","ordinal":131591,"en":"Who has not charged into battle?"},{"id":"semetey-1-2013:p0721:b003:l024","ordinal":131592,"en":"Let alone the Burut's daughters,"},{"id":"semetey-1-2013:p0721:b003:l025","ordinal":131593,"en":"He has not taken their wives as spoil!"},{"id":"semetey-1-2013:p0721:b003:l026","ordinal":131594,"en":"Where is that cowardly Kalcha?"},{"id":"semetey-1-2013:p0721:b003:l027","ordinal":131595,"en":"You multitude of Chinese, the khakan's people,"},{"id":"semetey-1-2013:p0721:b003:l028","ordinal":131596,"en":"If you are grass like tumbleweed,"},{"id":"semetey-1-2013:p0721:b003:l029","ordinal":131597,"en":"If you are so absurdly numerous,"},{"id":"semetey-1-2013:p0721:b003:l030","ordinal":131598,"en":"Manchus and black Kalmyks,"},{"id":"semetey-1-2013:p0721:b003:l031","ordinal":131599,"en":"All of you have fled!"},{"id":"semetey-1-2013:p0721:b003:l032","ordinal":131600,"en":"From the countless Burut,"},{"id":"semetey-1-2013:p0721:b003:l033","ordinal":131601,"en":"You have taken just one girl as spoil!’"},{"id":"semetey-1-2013:p0721:b003:l034","ordinal":131602,"en":"So spoke Great Döngö,"},{"id":"semetey-1-2013:p0721:b003:l035","ordinal":131603,"en":"Of the jacket-wearing Chinese,"},{"id":"semetey-1-2013:p0721:b003:l036","ordinal":131604,"en":"Scolding their mighty men."},{"id":"semetey-1-2013:p0721:b003:l037","ordinal":131605,"en":"Of the stone-worshipping Chinese,"},{"id":"semetey-1-2013:p0721:b003:l038","ordinal":131606,"en":"Scolding their bald ones,"},{"id":"semetey-1-2013:p0721:b003:l039","ordinal":131607,"en":"He began a terrible commotion."},{"id":"semetey-1-2013:p0721:b005:l001","ordinal":131608,"en":"Great Döngö raged."},{"id":"semetey-1-2013:p0721:b005:l002","ordinal":131609,"en":"All their khans—"},{"id":"semetey-1-2013:p0721:b005:l004","ordinal":131610,"en":"Khan Joloi and Ylama,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0721:b005:l005","ordinal":131611,"en":"The multitude of Chinese, Machangchyn,"},{"id":"semetey-1-2013:p0721:b005:l006","ordinal":131612,"en":"Ask not about their people!"},{"id":"semetey-1-2013:p0721:b005:l007","ordinal":131613,"en":"This ill-omened Döngö,"},{"id":"semetey-1-2013:p0721:b005:l008","ordinal":131614,"en":"Let me tell you of the giant."},{"id":"semetey-1-2013:p0721:b005:l009","ordinal":131615,"en":"Ask not about Döngö!"},{"id":"semetey-1-2013:p0721:b005:l010","ordinal":131616,"en":"His brow was high, his face cold."},{"id":"semetey-1-2013:p0721:b005:l011","ordinal":131617,"en":"What could that fearsome Döngö do?"},{"id":"semetey-1-2013:p0721:b005:l012","ordinal":131618,"en":"His curling mustache"},{"id":"semetey-1-2013:p0721:b005:l013","ordinal":131619,"en":"Was like nettles on an old sheepfold."},{"id":"semetey-1-2013:p0721:b005:l015","ordinal":131620,"en":"Like the ground grain children eat.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0721:b005:l016","ordinal":131621,"en":"The size of his nose"},{"id":"semetey-1-2013:p0721:b005:l017","ordinal":131622,"en":"Was like a great sword's scabbard."},{"id":"semetey-1-2013:p0721:b005:l018","ordinal":131623,"en":"The space between brow and eyelids"},{"id":"semetey-1-2013:p0721:b005:l019","ordinal":131624,"en":"Was like a grave whose roof had fallen in."},{"id":"semetey-1-2013:p0721:b005:l020","ordinal":131625,"en":"The breadth of his moon-like forehead"},{"id":"semetey-1-2013:p0721:b005:l021","ordinal":131626,"en":"Was like an upland pasture where a rich man summers."},{"id":"semetey-1-2013:p0721:b005:l022","ordinal":131627,"en":"No man could bear to look upon his face;"},{"id":"semetey-1-2013:p0721:b005:l023","ordinal":131628,"en":"No mortal could come to face him;"},{"id":"semetey-1-2013:p0721:b005:l024","ordinal":131629,"en":"No mortal could bear his appearance."},{"id":"semetey-1-2013:p0721:b005:l025","ordinal":131630,"en":"Then that giant,"},{"id":"semetey-1-2013:p0721:b005:l026","ordinal":131631,"en":"With many ready behind him,"},{"id":"semetey-1-2013:p0721:b005:l027","ordinal":131632,"en":"Countless giants crowded about him,"},{"id":"semetey-1-2013:p0721:b005:l028","ordinal":131633,"en":"Gathered his strength and roared."},{"id":"semetey-1-2013:p0721:b005:l029","ordinal":131634,"en":"The multitude of Chinese, Kongurbai,"},{"id":"semetey-1-2013:p0721:b005:l030","ordinal":131635,"en":"Split apart with a great uproar."},{"id":"semetey-1-2013:p0721:b005:l032","ordinal":131636,"en":"He was one of the renowned.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0721:b005:l033","ordinal":131637,"en":"Swaying as though struck by a spirit,"},{"id":"semetey-1-2013:p0721:b005:l034","ordinal":131638,"en":"The Chinese warrior strode heedlessly."},{"id":"semetey-1-2013:p0721:b005:l035","ordinal":131639,"en":"The great army coming at his flank"},{"id":"semetey-1-2013:p0721:b005:l036","ordinal":131640,"en":"He valued less than his trouser cuff."},{"id":"semetey-1-2013:p0721:b005:l037","ordinal":131641,"en":"Tied close at his side,"},{"id":"semetey-1-2013:p0721:b005:l038","ordinal":131642,"en":"A red pouch, a tobacco container—"},{"id":"semetey-1-2013:p0721:b005:l039","ordinal":131643,"en":"Into the pipe in his hand,"},{"id":"semetey-1-2013:p0722:b003:l001","ordinal":131644,"en":"Tobacco from the container,"},{"id":"semetey-1-2013:p0722:b003:l002","ordinal":131645,"en":"He put in four handfuls."},{"id":"semetey-1-2013:p0722:b003:l003","ordinal":131646,"en":"That Döngö's pipe"},{"id":"semetey-1-2013:p0722:b003:l004","ordinal":131647,"en":"Still was not full then;"},{"id":"semetey-1-2013:p0722:b003:l005","ordinal":131648,"en":"It remained four fingerbreadths short."},{"id":"semetey-1-2013:p0722:b003:l006","ordinal":131649,"en":"Bulging as large as a small tent,"},{"id":"semetey-1-2013:p0722:b003:l007","ordinal":131650,"en":"He drew black tinder from his pouch,"},{"id":"semetey-1-2013:p0722:b003:l008","ordinal":131651,"en":"Creating uproar among the Chinese."},{"id":"semetey-1-2013:p0722:b003:l009","ordinal":131652,"en":"Chinese firesteel and flint—"},{"id":"semetey-1-2013:p0722:b003:l010","ordinal":131653,"en":"He struck them and made fire."},{"id":"semetey-1-2013:p0722:b003:l011","ordinal":131654,"en":"He put an ember in his pipe,"},{"id":"semetey-1-2013:p0722:b003:l012","ordinal":131655,"en":"Thus setting the pipe alight."},{"id":"semetey-1-2013:p0722:b003:l013","ordinal":131656,"en":"When he sucked, the great pipe"},{"id":"semetey-1-2013:p0722:b003:l014","ordinal":131657,"en":"Rumbled like a drum."},{"id":"semetey-1-2013:p0722:b003:l015","ordinal":131658,"en":"When he let out its smoke,"},{"id":"semetey-1-2013:p0722:b003:l016","ordinal":131659,"en":"It billowed like a hide-smoking pit."},{"id":"semetey-1-2013:p0722:b003:l017","ordinal":131660,"en":"All the Manchus, the many monks,"},{"id":"semetey-1-2013:p0722:b003:l018","ordinal":131661,"en":"Screamed in terror for their lives."},{"id":"semetey-1-2013:p0722:b003:l019","ordinal":131662,"en":"Like shooting stars,"},{"id":"semetey-1-2013:p0722:b003:l020","ordinal":131663,"en":"The pipe's embers flew."},{"id":"semetey-1-2013:p0722:b003:l021","ordinal":131664,"en":"The noble mule beneath him"},{"id":"semetey-1-2013:p0722:b003:l022","ordinal":131665,"en":"He whipped in anger."},{"id":"semetey-1-2013:p0722:b003:l023","ordinal":131666,"en":"‘Your father's grave, Kongurbai!"},{"id":"semetey-1-2013:p0722:b003:l024","ordinal":131667,"en":"Shypshaidar and Kongurbai,"},{"id":"semetey-1-2013:p0722:b003:l025","ordinal":131668,"en":"Still you stand looking on!"},{"id":"semetey-1-2013:p0722:b003:l026","ordinal":131669,"en":"To the black Burut who oppose us,"},{"id":"semetey-1-2013:p0722:b003:l027","ordinal":131670,"en":"I shall bring calamity."},{"id":"semetey-1-2013:p0722:b003:l028","ordinal":131671,"en":"Never mind Manas—just watch!"},{"id":"semetey-1-2013:p0722:b003:l029","ordinal":131672,"en":"I shall bind all the others."},{"id":"semetey-1-2013:p0722:b003:l030","ordinal":131673,"en":"The renowned Burut, that small people,"},{"id":"semetey-1-2013:p0722:b003:l031","ordinal":131674,"en":"I shall drive them to Mecca."},{"id":"semetey-1-2013:p0722:b003:l032","ordinal":131675,"en":"Weak-backed, watery-hearted,"},{"id":"semetey-1-2013:p0722:b003:l033","ordinal":131676,"en":"You dogs who have lost your spirit!’"},{"id":"semetey-1-2013:p0722:b003:l034","ordinal":131677,"en":"Now he made a fearsome display."},{"id":"semetey-1-2013:p0722:b003:l035","ordinal":131678,"en":"Facing them, he leveled his spear."},{"id":"semetey-1-2013:p0722:b003:l036","ordinal":131679,"en":"Watch how thoroughly he will confound"},{"id":"semetey-1-2013:p0722:b003:l037","ordinal":131680,"en":"The forty companions."},{"id":"semetey-1-2013:p0722:b003:l038","ordinal":131681,"en":"Roaring in anger,"},{"id":"semetey-1-2013:p0722:b003:l039","ordinal":131682,"en":"He whipped his mule,"},{"id":"semetey-1-2013:p0722:b004:l001","ordinal":131683,"en":"Calling, ‘Come, Burut!’"},{"id":"semetey-1-2013:p0722:b004:l002","ordinal":131684,"en":"When they saw that Döngö,"},{"id":"semetey-1-2013:p0722:b004:l003","ordinal":131685,"en":"Khan Manas's forty champions,"},{"id":"semetey-1-2013:p0722:b004:l004","ordinal":131686,"en":"Your precious elder Bakai among them,"},{"id":"semetey-1-2013:p0722:b004:l005","ordinal":131687,"en":"All the champions gathered,"},{"id":"semetey-1-2013:p0722:b004:l006","ordinal":131688,"en":"Falling silent as if they had drunk poison."},{"id":"semetey-1-2013:p0722:b004:l007","ordinal":131689,"en":"No one dared stand against Döngö."},{"id":"semetey-1-2013:p0722:b004:l008","ordinal":131690,"en":"Of the forty companions themselves,"},{"id":"semetey-1-2013:p0722:b004:l009","ordinal":131691,"en":"Not a louse-sized drop of blood remained in their faces."},{"id":"semetey-1-2013:p0722:b004:l010","ordinal":131692,"en":"‘That damned Chinese—"},{"id":"semetey-1-2013:p0722:b004:l011","ordinal":131693,"en":"No one who challenges him will survive!"},{"id":"semetey-1-2013:p0722:b004:l012","ordinal":131694,"en":"No one who meets him will leave alive!’"},{"id":"semetey-1-2013:p0722:b004:l013","ordinal":131695,"en":"With old Kyrgyl at their head,"},{"id":"semetey-1-2013:p0722:b004:l014","ordinal":131696,"en":"All forty companions—"},{"id":"semetey-1-2013:p0722:b004:l015","ordinal":131697,"en":"The covering left their hearts,"},{"id":"semetey-1-2013:p0722:b004:l016","ordinal":131698,"en":"The strength left their arms."},{"id":"semetey-1-2013:p0722:b004:l017","ordinal":131699,"en":"Valiant Manas, the leopard,"},{"id":"semetey-1-2013:p0722:b004:l018","ordinal":131700,"en":"Your saint, born renowned,"},{"id":"semetey-1-2013:p0722:b004:l019","ordinal":131701,"en":"The conquering lord, the surpassing lion,"},{"id":"semetey-1-2013:p0722:b004:l020","ordinal":131702,"en":"Fought the spear duel there."},{"id":"semetey-1-2013:p0722:b004:l021","ordinal":131703,"en":"Guardian-spirit Manas, the leopard,"},{"id":"semetey-1-2013:p0722:b004:l022","ordinal":131704,"en":"The mount beneath him,"},{"id":"semetey-1-2013:p0722:b004:l023","ordinal":131705,"en":"Akkula, whom he rode to war,"},{"id":"semetey-1-2013:p0722:b004:l024","ordinal":131706,"en":"Was a Karabair warhorse,"},{"id":"semetey-1-2013:p0722:b004:l025","ordinal":131707,"en":"With sieve-like lungs and copper forelegs,"},{"id":"semetey-1-2013:p0722:b004:l026","ordinal":131708,"en":"A young mare's foal,"},{"id":"semetey-1-2013:p0722:b004:l027","ordinal":131709,"en":"The Duldul of the horse herds."},{"id":"semetey-1-2013:p0722:b004:l028","ordinal":131710,"en":"Taking his painted spear in hand,"},{"id":"semetey-1-2013:p0722:b004:l029","ordinal":131711,"en":"He struck Akkula once on the thigh."},{"id":"semetey-1-2013:p0722:b004:l030","ordinal":131712,"en":"The lion, the leopard like a camel,"},{"id":"semetey-1-2013:p0722:b004:l031","ordinal":131713,"en":"Attacked that Döngö."},{"id":"semetey-1-2013:p0722:b004:l032","ordinal":131714,"en":"The Boz Kise that descended from heaven,"},{"id":"semetey-1-2013:p0722:b004:l033","ordinal":131715,"en":"He girded about his waist, shouting."},{"id":"semetey-1-2013:p0722:b004:l034","ordinal":131716,"en":"Shrill battle cries, fierce rallying shouts—"},{"id":"semetey-1-2013:p0722:b004:l035","ordinal":131717,"en":"He raised an earth-splitting voice."},{"id":"semetey-1-2013:p0722:b004:l036","ordinal":131718,"en":"Valiant Manas, the lion,"},{"id":"semetey-1-2013:p0722:b004:l037","ordinal":131719,"en":"Hunched backward at the waist,"},{"id":"semetey-1-2013:p0722:b004:l038","ordinal":131720,"en":"His eyes staring without blinking,"},{"id":"semetey-1-2013:p0722:b004:l039","ordinal":131721,"en":"‘The Kalmyk saddle's pommel,’ he said—"},{"id":"semetey-1-2013:p0723:b003:l001","ordinal":131722,"en":"‘If I sink it down through the breast,"},{"id":"semetey-1-2013:p0723:b003:l002","ordinal":131723,"en":"There is the very heart,’ he said."},{"id":"semetey-1-2013:p0723:b003:l003","ordinal":131724,"en":"When Manas struck him,"},{"id":"semetey-1-2013:p0723:b003:l004","ordinal":131725,"en":"Great Döngö did not flinch."},{"id":"semetey-1-2013:p0723:b003:l005","ordinal":131726,"en":"A tale full of marvels!"},{"id":"semetey-1-2013:p0723:b003:l006","ordinal":131727,"en":"Often ridden against hostile foes,"},{"id":"semetey-1-2013:p0723:b003:l007","ordinal":131728,"en":"Akkula had grown seasoned."},{"id":"semetey-1-2013:p0723:b003:l008","ordinal":131729,"en":"When Manas struck Döngö,"},{"id":"semetey-1-2013:p0723:b003:l009","ordinal":131730,"en":"His feet sank firmly into the earth."},{"id":"semetey-1-2013:p0723:b003:l010","ordinal":131731,"en":"Smiling boldly,"},{"id":"semetey-1-2013:p0723:b003:l011","ordinal":131732,"en":"Laughing brightly, standing unbowed,"},{"id":"semetey-1-2013:p0723:b003:l012","ordinal":131733,"en":"‘Take your turn, infidel!"},{"id":"semetey-1-2013:p0723:b003:l013","ordinal":131734,"en":"You have come from Beijing,"},{"id":"semetey-1-2013:p0723:b003:l014","ordinal":131735,"en":"Renowned warrior Döngö,’ he said."},{"id":"semetey-1-2013:p0723:b003:l015","ordinal":131736,"en":"Khan Manas stood on a ridge."},{"id":"semetey-1-2013:p0723:b003:l016","ordinal":131737,"en":"Great Döngö faced him and thrust;"},{"id":"semetey-1-2013:p0723:b003:l017","ordinal":131738,"en":"Khan Manas paid it no heed."},{"id":"semetey-1-2013:p0723:b003:l018","ordinal":131739,"en":"Great Döngö stood upon a peak."},{"id":"semetey-1-2013:p0723:b003:l019","ordinal":131740,"en":"Khan Manas stretched forward and thrust;"},{"id":"semetey-1-2013:p0723:b003:l020","ordinal":131741,"en":"Great Döngö showed no fear."},{"id":"semetey-1-2013:p0723:b003:l021","ordinal":131742,"en":"They stood in turn,"},{"id":"semetey-1-2013:p0723:b003:l022","ordinal":131743,"en":"Struck one another firmly,"},{"id":"semetey-1-2013:p0723:b003:l023","ordinal":131744,"en":"Shouted and fought with spears."},{"id":"semetey-1-2013:p0723:b003:l024","ordinal":131745,"en":"A great tale without equal in the ages—"},{"id":"semetey-1-2013:p0723:b003:l025","ordinal":131746,"en":"Thus they fought."},{"id":"semetey-1-2013:p0723:b003:l026","ordinal":131747,"en":"Great Döngö stood again;"},{"id":"semetey-1-2013:p0723:b003:l027","ordinal":131748,"en":"Khan Manas stood again."},{"id":"semetey-1-2013:p0723:b003:l028","ordinal":131749,"en":"When Manas thrust again,"},{"id":"semetey-1-2013:p0723:b003:l029","ordinal":131750,"en":"Döngö, who had stood firm—"},{"id":"semetey-1-2013:p0723:b003:l030","ordinal":131751,"en":"His shot-proof coat split open;"},{"id":"semetey-1-2013:p0723:b003:l031","ordinal":131752,"en":"The place over his lungs was exposed."},{"id":"semetey-1-2013:p0723:b003:l032","ordinal":131753,"en":"Unable to gather his wits,"},{"id":"semetey-1-2013:p0723:b003:l033","ordinal":131754,"en":"Great Döngö standing there"},{"id":"semetey-1-2013:p0723:b003:l034","ordinal":131755,"en":"Was in great distress."},{"id":"semetey-1-2013:p0723:b003:l035","ordinal":131756,"en":"Khan Kongurbai and Shypshaidar,"},{"id":"semetey-1-2013:p0723:b003:l036","ordinal":131757,"en":"And their renowned wrestler Tiken,"},{"id":"semetey-1-2013:p0723:b003:l037","ordinal":131758,"en":"Against Khan Manas"},{"id":"semetey-1-2013:p0723:b003:l038","ordinal":131759,"en":"The pigs launched a mass assault."},{"id":"semetey-1-2013:p0723:b003:l039","ordinal":131760,"en":"Khan Manas's forty lords"},{"id":"semetey-1-2013:p0723:b005:l001","ordinal":131761,"en":"Charged against them."},{"id":"semetey-1-2013:p0723:b005:l002","ordinal":131762,"en":"Precious Chubak and warrior Bakai,"},{"id":"semetey-1-2013:p0723:b005:l003","ordinal":131763,"en":"Not letting their Manas be overwhelmed,"},{"id":"semetey-1-2013:p0723:b005:l004","ordinal":131764,"en":"Fought with crashing blows,"},{"id":"semetey-1-2013:p0723:b005:l005","ordinal":131765,"en":"Hacked with battle-axes,"},{"id":"semetey-1-2013:p0723:b005:l007","ordinal":131766,"en":"Killed when opportunity came.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0723:b005:l008","ordinal":131767,"en":"When they came within reach,"},{"id":"semetey-1-2013:p0723:b005:l009","ordinal":131768,"en":"Their sharp, tasseled spears"},{"id":"semetey-1-2013:p0723:b005:l010","ordinal":131769,"en":"They planted in the chosen spot."},{"id":"semetey-1-2013:p0723:b005:l011","ordinal":131770,"en":"Infidel and Muslim"},{"id":"semetey-1-2013:p0723:b005:l012","ordinal":131771,"en":"Became mingled together."},{"id":"semetey-1-2013:p0723:b005:l013","ordinal":131772,"en":"May God never show you such a sight!"},{"id":"semetey-1-2013:p0723:b005:l014","ordinal":131773,"en":"One could not tell which was which;"},{"id":"semetey-1-2013:p0723:b005:l015","ordinal":131774,"en":"Looking, the eye could not distinguish them."},{"id":"semetey-1-2013:p0723:b005:l016","ordinal":131775,"en":"As though tumbleweed flew,"},{"id":"semetey-1-2013:p0723:b005:l017","ordinal":131776,"en":"Dust swarmed up from the level ground."},{"id":"semetey-1-2013:p0723:b005:l018","ordinal":131777,"en":"From rough hollows and ditches,"},{"id":"semetey-1-2013:p0723:b005:l019","ordinal":131778,"en":"Dark blood poured with a gurgle."},{"id":"semetey-1-2013:p0723:b005:l020","ordinal":131779,"en":"As the Chinese were dying,"},{"id":"semetey-1-2013:p0723:b005:l021","ordinal":131780,"en":"If you ask about Döngö,"},{"id":"semetey-1-2013:p0723:b005:l022","ordinal":131781,"en":"Unable to endure Manas's heat,"},{"id":"semetey-1-2013:p0723:b005:l023","ordinal":131782,"en":"Unable to withstand his strength,"},{"id":"semetey-1-2013:p0723:b005:l024","ordinal":131783,"en":"He urged his mount toward the khakan,"},{"id":"semetey-1-2013:p0723:b005:l025","ordinal":131784,"en":"And fled away."},{"id":"semetey-1-2013:p0723:b005:l026","ordinal":131785,"en":"Frantic, his wits scattered,"},{"id":"semetey-1-2013:p0723:b005:l027","ordinal":131786,"en":"What could poor Döngö do?"},{"id":"semetey-1-2013:p0723:b005:l028","ordinal":131787,"en":"He was thrown into panic."},{"id":"semetey-1-2013:p0723:b005:l029","ordinal":131788,"en":"When they reached the descent,"},{"id":"semetey-1-2013:p0723:b005:l030","ordinal":131789,"en":"That Döngö's mule"},{"id":"semetey-1-2013:p0723:b005:l031","ordinal":131790,"en":"Had a neck bulging like a bull's."},{"id":"semetey-1-2013:p0723:b005:l032","ordinal":131791,"en":"When they began to climb,"},{"id":"semetey-1-2013:p0723:b005:l033","ordinal":131792,"en":"Khan Manas's Akkula"},{"id":"semetey-1-2013:p0723:b005:l034","ordinal":131793,"en":"Had eyes gleaming like an argali's."},{"id":"semetey-1-2013:p0723:b005:l035","ordinal":131794,"en":"Your accomplished elder Manas"},{"id":"semetey-1-2013:p0723:b005:l036","ordinal":131795,"en":"Reached him swifter than an arrow."},{"id":"semetey-1-2013:p0723:b005:l037","ordinal":131796,"en":"Where he caught up with Döngö,"},{"id":"semetey-1-2013:p0723:b005:l038","ordinal":131797,"en":"From upon his mule,"},{"id":"semetey-1-2013:p0723:b005:l039","ordinal":131798,"en":"When precious Manas made ready,"},{"id":"semetey-1-2013:p0724:b003:l001","ordinal":131799,"en":"Akbalta's Chubak,"},{"id":"semetey-1-2013:p0724:b003:l002","ordinal":131800,"en":"Who made the whole world cry out,"},{"id":"semetey-1-2013:p0724:b003:l003","ordinal":131801,"en":"That wretch—your father's grave!—"},{"id":"semetey-1-2013:p0724:b003:l004","ordinal":131802,"en":"In Khan Chubak's hand"},{"id":"semetey-1-2013:p0724:b003:l005","ordinal":131803,"en":"Was the renowned sword Oikuma."},{"id":"semetey-1-2013:p0724:b003:l006","ordinal":131804,"en":"He reached him and took his head."},{"id":"semetey-1-2013:p0724:b003:l007","ordinal":131805,"en":"Accomplished Manas and he together"},{"id":"semetey-1-2013:p0724:b003:l008","ordinal":131806,"en":"Slaughtered Döngö."},{"id":"semetey-1-2013:p0724:b003:l009","ordinal":131807,"en":"‘Mighty Döngö is dead!’"},{"id":"semetey-1-2013:p0724:b003:l010","ordinal":131808,"en":"The people of Beijing fled."},{"id":"semetey-1-2013:p0724:b003:l011","ordinal":131809,"en":"Then valiant Manas, the fierce khan,"},{"id":"semetey-1-2013:p0724:b003:l012","ordinal":131810,"en":"The five pennants brought from Mecca"},{"id":"semetey-1-2013:p0724:b003:l013","ordinal":131811,"en":"Planted firmly in the earth,"},{"id":"semetey-1-2013:p0724:b003:l014","ordinal":131812,"en":"Sending those who faced him crawling."},{"id":"semetey-1-2013:p0724:b003:l015","ordinal":131813,"en":"The emblems brought from afar"},{"id":"semetey-1-2013:p0724:b003:l016","ordinal":131814,"en":"He planted in six places,"},{"id":"semetey-1-2013:p0724:b003:l017","ordinal":131815,"en":"Driving the enemy, sending them crawling,"},{"id":"semetey-1-2013:p0724:b003:l018","ordinal":131816,"en":"Bringing down the kaldai's banner."},{"id":"semetey-1-2013:p0724:b003:l019","ordinal":131817,"en":"The black Manchus and Sibe—"},{"id":"semetey-1-2013:p0724:b003:l020","ordinal":131818,"en":"He made their cries reach God,"},{"id":"semetey-1-2013:p0724:b003:l021","ordinal":131819,"en":"Pursued and drove and scattered them,"},{"id":"semetey-1-2013:p0724:b003:l022","ordinal":131820,"en":"Sweeping them toward Beijing."},{"id":"semetey-1-2013:p0724:b003:l023","ordinal":131821,"en":"Their warrior's head was cut off;"},{"id":"semetey-1-2013:p0724:b003:l024","ordinal":131822,"en":"The Chinese met with torment."},{"id":"semetey-1-2013:p0724:b003:l025","ordinal":131823,"en":"When their mighty Döngö died,"},{"id":"semetey-1-2013:p0724:b003:l026","ordinal":131824,"en":"When the Chinese knew grief,"},{"id":"semetey-1-2013:p0724:b003:l027","ordinal":131825,"en":"We pursued and drove them on."},{"id":"semetey-1-2013:p0724:b003:l028","ordinal":131826,"en":"From beyond Jyldyz,"},{"id":"semetey-1-2013:p0724:b003:l029","ordinal":131827,"en":"From the edge of Ak-Talaa,"},{"id":"semetey-1-2013:p0724:b003:l030","ordinal":131828,"en":"From the ridge of Kyran-Kyr,"},{"id":"semetey-1-2013:p0724:b003:l031","ordinal":131829,"en":"From Ylama's hands,"},{"id":"semetey-1-2013:p0724:b003:l032","ordinal":131830,"en":"From the seething infidels'"},{"id":"semetey-1-2013:p0724:b003:l033","ordinal":131831,"en":"Net of iron ropes—"},{"id":"semetey-1-2013:p0724:b003:l034","ordinal":131832,"en":"When Surkyzyl was shot down,"},{"id":"semetey-1-2013:p0724:b003:l035","ordinal":131833,"en":"Manas's younger sister Kardygach"},{"id":"semetey-1-2013:p0724:b003:l036","ordinal":131834,"en":"Had been taken captive."},{"id":"semetey-1-2013:p0724:b003:l037","ordinal":131835,"en":"With a net of iron ropes,"},{"id":"semetey-1-2013:p0724:b003:l038","ordinal":131836,"en":"She had been caught in a net."},{"id":"semetey-1-2013:p0724:b003:l039","ordinal":131837,"en":"Upon the seething Chinese"},{"id":"semetey-1-2013:p0724:b004:l001","ordinal":131838,"en":"We had brought havoc."},{"id":"semetey-1-2013:p0724:b004:l002","ordinal":131839,"en":"From the great infidel Ylama,"},{"id":"semetey-1-2013:p0724:b004:l003","ordinal":131840,"en":"Thus we wrested Kardygach away."}]
