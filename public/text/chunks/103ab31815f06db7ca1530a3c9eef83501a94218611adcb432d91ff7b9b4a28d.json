[{"id":"semetey-1-2013:p1068:b004:l021","ordinal":157697,"en":"He brought turmoil upon us"},{"id":"semetey-1-2013:p1068:b004:l022","ordinal":157698,"en":"And came contending for Chürök."},{"id":"semetey-1-2013:p1068:b004:l023","ordinal":157699,"en":"When they laid a foul siege,"},{"id":"semetey-1-2013:p1068:b004:l024","ordinal":157700,"en":"And Toltoy of the Zhediger"},{"id":"semetey-1-2013:p1068:b004:l025","ordinal":157701,"en":"Slaughtered every person"},{"id":"semetey-1-2013:p1068:b004:l026","ordinal":157702,"en":"Who ventured outside,"},{"id":"semetey-1-2013:p1068:b004:l027","ordinal":157703,"en":"We stood and raced our horses;"},{"id":"semetey-1-2013:p1068:b004:l028","ordinal":157704,"en":"Because of you, Aychürök,"},{"id":"semetey-1-2013:p1068:b004:l029","ordinal":157705,"en":"We fired guns and drew bows,"},{"id":"semetey-1-2013:p1068:b004:l030","ordinal":157706,"en":"And stood fighting without fleeing!"},{"id":"semetey-1-2013:p1068:b004:l031","ordinal":157707,"en":"We held our ground for nine months;"},{"id":"semetey-1-2013:p1068:b004:l032","ordinal":157708,"en":"For nine days we fought without rest."},{"id":"semetey-1-2013:p1068:b004:l033","ordinal":157709,"en":"With teeth jutting out,"},{"id":"semetey-1-2013:p1068:b004:l034","ordinal":157710,"en":"Horse corpses became a mountain;"},{"id":"semetey-1-2013:p1068:b004:l035","ordinal":157711,"en":"With mustaches drooping,"},{"id":"semetey-1-2013:p1068:b004:l036","ordinal":157712,"en":"Men's corpses became bundled heaps."},{"id":"semetey-1-2013:p1068:b004:l037","ordinal":157713,"en":"Many formidable beks died;"},{"id":"semetey-1-2013:p1068:b004:l038","ordinal":157714,"en":"Many innocent people died."},{"id":"semetey-1-2013:p1068:b004:l039","ordinal":157715,"en":"Demanding, 'Give us Aychürök,'"},{"id":"semetey-1-2013:p1069:b003:l001","ordinal":157716,"en":"Saying, 'Agree to what I say,'"},{"id":"semetey-1-2013:p1069:b003:l002","ordinal":157717,"en":"They came and overran us again;"},{"id":"semetey-1-2013:p1069:b003:l003","ordinal":157718,"en":"When death drew near,"},{"id":"semetey-1-2013:p1069:b003:l004","ordinal":157719,"en":"When all our strength was gone,"},{"id":"semetey-1-2013:p1069:b003:l005","ordinal":157720,"en":"They would not let us prepare Shamyyan,"},{"id":"semetey-1-2013:p1069:b003:l006","ordinal":157721,"en":"Would not let us plow crops into the earth,"},{"id":"semetey-1-2013:p1069:b003:l007","ordinal":157722,"en":"Would not let us break the earth's surface,"},{"id":"semetey-1-2013:p1069:b003:l008","ordinal":157723,"en":"Would not let us scatter a handful of seed."},{"id":"semetey-1-2013:p1069:b003:l009","ordinal":157724,"en":"After they laid their foul siege,"},{"id":"semetey-1-2013:p1069:b003:l010","ordinal":157725,"en":"After they made all pleasure costly,"},{"id":"semetey-1-2013:p1069:b003:l011","ordinal":157726,"en":"After they slaughtered the people without looking back,"},{"id":"semetey-1-2013:p1069:b003:l012","ordinal":157727,"en":"It is true that I resolved to agree"},{"id":"semetey-1-2013:p1069:b003:l013","ordinal":157728,"en":"So the people might be saved!"},{"id":"semetey-1-2013:p1069:b003:l014","ordinal":157729,"en":"It is true that I meant"},{"id":"semetey-1-2013:p1069:b003:l015","ordinal":157730,"en":"To bind you and take you"},{"id":"semetey-1-2013:p1069:b003:l016","ordinal":157731,"en":"To Toltoy of the Zhediger!"},{"id":"semetey-1-2013:p1069:b003:l017","ordinal":157732,"en":"Corruption has entered your mind;"},{"id":"semetey-1-2013:p1069:b003:l018","ordinal":157733,"en":"Do not bring disgrace"},{"id":"semetey-1-2013:p1069:b003:l019","ordinal":157734,"en":"Before your renowned princely husband."},{"id":"semetey-1-2013:p1069:b003:l020","ordinal":157735,"en":"Who will believe your words?"},{"id":"semetey-1-2013:p1069:b003:l021","ordinal":157736,"en":"Stop playing coy with your husband."},{"id":"semetey-1-2013:p1069:b003:l022","ordinal":157737,"en":"If suffering comes upon me,"},{"id":"semetey-1-2013:p1069:b003:l023","ordinal":157738,"en":"I have my Argyn people and my own strength"},{"id":"semetey-1-2013:p1069:b003:l024","ordinal":157739,"en":"To charge forth and make war."},{"id":"semetey-1-2013:p1069:b003:l025","ordinal":157740,"en":"You are my lawfully wedded wife in my embrace;"},{"id":"semetey-1-2013:p1069:b003:l026","ordinal":157741,"en":"If hardship presses a son of a bitch,"},{"id":"semetey-1-2013:p1069:b003:l027","ordinal":157742,"en":"I may resolve to give even her away!"},{"id":"semetey-1-2013:p1069:b003:l028","ordinal":157743,"en":"For the waist you have girded,"},{"id":"semetey-1-2013:p1069:b003:l029","ordinal":157744,"en":"Do not keep fiercely maligning"},{"id":"semetey-1-2013:p1069:b003:l030","ordinal":157745,"en":"Your renowned gray-maned husband!"},{"id":"semetey-1-2013:p1069:b003:l031","ordinal":157746,"en":"Semetey, born greater"},{"id":"semetey-1-2013:p1069:b003:l032","ordinal":157747,"en":"Than his father, gray-maned Manas,"},{"id":"semetey-1-2013:p1069:b003:l033","ordinal":157748,"en":"If you have heard reports about yourself,"},{"id":"semetey-1-2013:p1069:b003:l034","ordinal":157749,"en":"And keep believing your wife,"},{"id":"semetey-1-2013:p1069:b003:l035","ordinal":157750,"en":"Here is the city of Baashaluu,"},{"id":"semetey-1-2013:p1069:b003:l036","ordinal":157751,"en":"And here am I—cut off my head!\""},{"id":"semetey-1-2013:p1069:b003:l037","ordinal":157752,"en":"Unerring Azhybay"},{"id":"semetey-1-2013:p1069:b003:l038","ordinal":157753,"en":"Had spoken his fitting words;"},{"id":"semetey-1-2013:p1069:b003:l039","ordinal":157754,"en":"He revealed his eloquence."},{"id":"semetey-1-2013:p1069:b004:l001","ordinal":157755,"en":"Azhybay, eloquent beyond others,"},{"id":"semetey-1-2013:p1069:b004:l002","ordinal":157756,"en":"Drove every weighty word"},{"id":"semetey-1-2013:p1069:b004:l003","ordinal":157757,"en":"Into the heart"},{"id":"semetey-1-2013:p1069:b004:l004","ordinal":157758,"en":"Of prince Semetey."},{"id":"semetey-1-2013:p1069:b004:l005","ordinal":157759,"en":"Then Semetey,"},{"id":"semetey-1-2013:p1069:b004:l006","ordinal":157760,"en":"Hearing many kinds of words from Azhybay,"},{"id":"semetey-1-2013:p1069:b004:l007","ordinal":157761,"en":"Found all he said persuasive;"},{"id":"semetey-1-2013:p1069:b004:l008","ordinal":157762,"en":"Thinking, \"She is acting like a woman,\""},{"id":"semetey-1-2013:p1069:b004:l009","ordinal":157763,"en":"He came to hate Aychürök."},{"id":"semetey-1-2013:p1069:b004:l010","ordinal":157764,"en":"\"God has struck her,"},{"id":"semetey-1-2013:p1069:b004:l011","ordinal":157765,"en":"For maligning her own elder brother!\""},{"id":"semetey-1-2013:p1069:b004:l012","ordinal":157766,"en":"His eyes reddened like a lion's;"},{"id":"semetey-1-2013:p1069:b004:l013","ordinal":157767,"en":"The fearsome leopard"},{"id":"semetey-1-2013:p1069:b004:l014","ordinal":157768,"en":"Showed his venomous face"},{"id":"semetey-1-2013:p1069:b004:l015","ordinal":157769,"en":"And now stared at Chürök."},{"id":"semetey-1-2013:p1069:b004:l016","ordinal":157770,"en":"Unable to bear his anger,"},{"id":"semetey-1-2013:p1069:b004:l017","ordinal":157771,"en":"What could dear Chürök do?"},{"id":"semetey-1-2013:p1069:b004:l018","ordinal":157772,"en":"She hurried forward at an amble;"},{"id":"semetey-1-2013:p1069:b004:l019","ordinal":157773,"en":"Unable to bear his venom,"},{"id":"semetey-1-2013:p1069:b004:l020","ordinal":157774,"en":"While the gray-maned lion stared,"},{"id":"semetey-1-2013:p1069:b004:l021","ordinal":157775,"en":"She cowered behind the curtain."},{"id":"semetey-1-2013:p1069:b004:l022","ordinal":157776,"en":"Azhybay, son of Azhy,"},{"id":"semetey-1-2013:p1069:b004:l023","ordinal":157777,"en":"And Tümönbay, son of Tülkü,"},{"id":"semetey-1-2013:p1069:b004:l024","ordinal":157778,"en":"Now put the day in writing"},{"id":"semetey-1-2013:p1069:b004:l025","ordinal":157779,"en":"And received the reckoning of the date."},{"id":"semetey-1-2013:p1069:b004:l026","ordinal":157780,"en":"When seven days had passed,"},{"id":"semetey-1-2013:p1069:b004:l027","ordinal":157781,"en":"They said, \"Let brave Toltoy come"},{"id":"semetey-1-2013:p1069:b004:l028","ordinal":157782,"en":"As bridegroom to Aychürök.\""},{"id":"semetey-1-2013:p1069:b004:l029","ordinal":157783,"en":"Azhybay, son of Azhy,"},{"id":"semetey-1-2013:p1069:b004:l030","ordinal":157784,"en":"Now made the pledge."},{"id":"semetey-1-2013:p1069:b004:l031","ordinal":157785,"en":"Külchoro, son of Almambet,"},{"id":"semetey-1-2013:p1069:b004:l032","ordinal":157786,"en":"Was twelve years old then;"},{"id":"semetey-1-2013:p1069:b004:l033","ordinal":157787,"en":"He was a remarkable one,"},{"id":"semetey-1-2013:p1069:b004:l034","ordinal":157788,"en":"A glowing red ember,"},{"id":"semetey-1-2013:p1069:b004:l035","ordinal":157789,"en":"With no one like him in the world,"},{"id":"semetey-1-2013:p1069:b004:l036","ordinal":157790,"en":"A prodigy born among men,"},{"id":"semetey-1-2013:p1069:b004:l037","ordinal":157791,"en":"With no one like him among mortals."},{"id":"semetey-1-2013:p1069:b004:l038","ordinal":157792,"en":"The horse he rode was gray;"},{"id":"semetey-1-2013:p1069:b004:l039","ordinal":157793,"en":"From heroic Sultan Alma—"}]
