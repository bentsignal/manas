[{"id":"semetey-1-2013:p0509:b004:l027","ordinal":115969,"en":"When he turned his back,"},{"id":"semetey-1-2013:p0509:b004:l028","ordinal":115970,"en":"He had the dread presence of six thousand men."},{"id":"semetey-1-2013:p0509:b004:l029","ordinal":115971,"en":"A black-spotted leopard"},{"id":"semetey-1-2013:p0509:b004:l030","ordinal":115972,"en":"Leapt beside his flank."},{"id":"semetey-1-2013:p0509:b004:l031","ordinal":115973,"en":"A short-tailed, fierce-maned lion,"},{"id":"semetey-1-2013:p0509:b004:l032","ordinal":115974,"en":"Opening its mouth and roaring,"},{"id":"semetey-1-2013:p0509:b004:l033","ordinal":115975,"en":"Made ready before him."},{"id":"semetey-1-2013:p0509:b004:l034","ordinal":115976,"en":"His protector was Kojosan,"},{"id":"semetey-1-2013:p0509:b004:l035","ordinal":115977,"en":"His supporters the forty chiltens."},{"id":"semetey-1-2013:p0509:b004:l036","ordinal":115978,"en":"He was that fortunate lion himself."},{"id":"semetey-1-2013:p0509:b004:l037","ordinal":115979,"en":"Keeping watch, ranging the land,"},{"id":"semetey-1-2013:p0509:b004:l038","ordinal":115980,"en":"With Khan Bakay following him,"},{"id":"semetey-1-2013:p0509:b004:l039","ordinal":115981,"en":"Your father Manas, the blood-stained lion,"},{"id":"semetey-1-2013:p0510:b003:l001","ordinal":115982,"en":"He was out on patrol."},{"id":"semetey-1-2013:p0510:b003:l002","ordinal":115983,"en":"Pursuing Chubak, I grew excited;"},{"id":"semetey-1-2013:p0510:b003:l003","ordinal":115984,"en":"I, that clamorous shrew,"},{"id":"semetey-1-2013:p0510:b003:l004","ordinal":115985,"en":"Encountered your father, Khan Manas."},{"id":"semetey-1-2013:p0510:b003:l005","ordinal":115986,"en":"As a married woman, in this way"},{"id":"semetey-1-2013:p0510:b003:l006","ordinal":115987,"en":"I shook the people and threw them into turmoil;"},{"id":"semetey-1-2013:p0510:b003:l007","ordinal":115988,"en":"As a girl, wretched me,"},{"id":"semetey-1-2013:p0510:b003:l008","ordinal":115989,"en":"I shook generations and threw the nation into turmoil."},{"id":"semetey-1-2013:p0510:b003:l009","ordinal":115990,"en":"Riding a horse like a gray winged steed,"},{"id":"semetey-1-2013:p0510:b003:l010","ordinal":115991,"en":"Holding blue Zulpukor,"},{"id":"semetey-1-2013:p0510:b003:l011","ordinal":115992,"en":"Tall and broad-shouldered,"},{"id":"semetey-1-2013:p0510:b003:l012","ordinal":115993,"en":"Both a wrestler and a lion,"},{"id":"semetey-1-2013:p0510:b003:l013","ordinal":115994,"en":"Famous Bakay, that heroic sultan,"},{"id":"semetey-1-2013:p0510:b003:l014","ordinal":115995,"en":"Looked kindly on your unfortunate mother Kanykey."},{"id":"semetey-1-2013:p0510:b003:l016","ordinal":115996,"en":"Seeing him, I took fright."},{"id":"semetey-1-2013:p0510:b003:l017","ordinal":115997,"en":"Akbaltay's lion,"},{"id":"semetey-1-2013:p0510:b003:l018","ordinal":115998,"en":"Escaping, brought word;"},{"id":"semetey-1-2013:p0510:b003:l019","ordinal":115999,"en":"To Bakay and the lion Manas"},{"id":"semetey-1-2013:p0510:b003:l020","ordinal":116000,"en":"That Chubak had gone."},{"id":"semetey-1-2013:p0510:b003:l021","ordinal":116001,"en":"“Hero Manas, hear my grievance:"},{"id":"semetey-1-2013:p0510:b003:l022","ordinal":116002,"en":"In Bukhara, that great city,"},{"id":"semetey-1-2013:p0510:b003:l023","ordinal":116003,"en":"When I sought to seize its khanship,"},{"id":"semetey-1-2013:p0510:b003:l024","ordinal":116004,"en":"What turmoil I encountered!"},{"id":"semetey-1-2013:p0510:b003:l025","ordinal":116005,"en":"Tearing my nine coats,"},{"id":"semetey-1-2013:p0510:b003:l026","ordinal":116006,"en":"Of middle height and broad shoulders,"},{"id":"semetey-1-2013:p0510:b003:l027","ordinal":116007,"en":"Having received a written letter from the caliph,"},{"id":"semetey-1-2013:p0510:b003:l028","ordinal":116008,"en":"Known as a blood-drinker,"},{"id":"semetey-1-2013:p0510:b003:l029","ordinal":116009,"en":"Holding a blue Zulpukor spear,"},{"id":"semetey-1-2013:p0510:b003:l030","ordinal":116010,"en":"With a naked sword bound at the side,"},{"id":"semetey-1-2013:p0510:b003:l031","ordinal":116011,"en":"Riding a black, white-blazed horse,"},{"id":"semetey-1-2013:p0510:b003:l032","ordinal":116012,"en":"Its hairy tail tied tight,"},{"id":"semetey-1-2013:p0510:b003:l033","ordinal":116013,"en":"Coming out across my path to fight,"},{"id":"semetey-1-2013:p0510:b003:l034","ordinal":116014,"en":"We fought many spear bouts."},{"id":"semetey-1-2013:p0510:b003:l035","ordinal":116015,"en":"I made that foe thrust many spears;"},{"id":"semetey-1-2013:p0510:b003:l036","ordinal":116016,"en":"Of all those swords and spears,"},{"id":"semetey-1-2013:p0510:b003:l037","ordinal":116017,"en":"I broke them without leaving one."},{"id":"semetey-1-2013:p0510:b003:l038","ordinal":116018,"en":"That one exhausted"},{"id":"semetey-1-2013:p0510:b003:l039","ordinal":116019,"en":"My beast, Kokala."},{"id":"semetey-1-2013:p0510:b004:l001","ordinal":116020,"en":"I never saw such a fierce warrior."},{"id":"semetey-1-2013:p0510:b004:l002","ordinal":116021,"en":"Khan Manas, had you not been here,"},{"id":"semetey-1-2013:p0510:b004:l003","ordinal":116022,"en":"That foe would have spilled my blood,"},{"id":"semetey-1-2013:p0510:b004:l004","ordinal":116023,"en":"Pursuing cruelly without turning back,"},{"id":"semetey-1-2013:p0510:b004:l005","ordinal":116024,"en":"Draining my strength."},{"id":"semetey-1-2013:p0510:b004:l006","ordinal":116025,"en":"Thrusting four times for my one,"},{"id":"semetey-1-2013:p0510:b004:l007","ordinal":116026,"en":"That foe disgraced me terribly."},{"id":"semetey-1-2013:p0510:b004:l008","ordinal":116027,"en":"I have lost faith in the Oygut;"},{"id":"semetey-1-2013:p0510:b004:l009","ordinal":116028,"en":"No companion came behind me."},{"id":"semetey-1-2013:p0510:b004:l010","ordinal":116029,"en":"This year I shall move to Talas,"},{"id":"semetey-1-2013:p0510:b004:l011","ordinal":116030,"en":"And come to serve as a warrior"},{"id":"semetey-1-2013:p0510:b004:l012","ordinal":116031,"en":"To famous Sultan Manas."},{"id":"semetey-1-2013:p0510:b004:l013","ordinal":116032,"en":"Bringing my household to Keng-Kol,"},{"id":"semetey-1-2013:p0510:b004:l014","ordinal":116033,"en":"From stately Bukhara,"},{"id":"semetey-1-2013:p0510:b004:l015","ordinal":116034,"en":"If I live, I shall exact"},{"id":"semetey-1-2013:p0510:b004:l016","ordinal":116035,"en":"Revenge for what I have suffered.”"},{"id":"semetey-1-2013:p0510:b004:l017","ordinal":116036,"en":"“Akbaltay's lion,"},{"id":"semetey-1-2013:p0510:b004:l018","ordinal":116037,"en":"Your words are truly right;"},{"id":"semetey-1-2013:p0510:b004:l019","ordinal":116038,"en":"There is no twisting or evasion,"},{"id":"semetey-1-2013:p0510:b004:l020","ordinal":116039,"en":"What you have said is wholly true."},{"id":"semetey-1-2013:p0510:b004:l021","ordinal":116040,"en":"The stars were gray from the sky,"},{"id":"semetey-1-2013:p0510:b004:l022","ordinal":116041,"en":"This world is fleeting, only two days;"},{"id":"semetey-1-2013:p0510:b004:l023","ordinal":116042,"en":"Be friends into the next world."},{"id":"semetey-1-2013:p0510:b004:l024","ordinal":116043,"en":"So that you never part,"},{"id":"semetey-1-2013:p0510:b004:l025","ordinal":116044,"en":"Chew white wheat flour together."},{"id":"semetey-1-2013:p0510:b004:l026","ordinal":116045,"en":"My son, I am Lion Bakay;"},{"id":"semetey-1-2013:p0510:b004:l027","ordinal":116046,"en":"Let me tell you the truth."},{"id":"semetey-1-2013:p0510:b004:l028","ordinal":116047,"en":"A star had stirred in the heavens at his birth;"},{"id":"semetey-1-2013:p0510:b004:l029","ordinal":116048,"en":"To bring slaughter upon the emperor,"},{"id":"semetey-1-2013:p0510:b004:l030","ordinal":116049,"en":"To take revenge upon the unbelievers,"},{"id":"semetey-1-2013:p0510:b004:l031","ordinal":116050,"en":"To bring slaughter upon Beijing,"},{"id":"semetey-1-2013:p0510:b004:l032","ordinal":116051,"en":"To destroy them utterly,"},{"id":"semetey-1-2013:p0510:b004:l033","ordinal":116052,"en":"Chew white wheat flour."},{"id":"semetey-1-2013:p0510:b004:l034","ordinal":116053,"en":"My son, hold to the sacred oath."},{"id":"semetey-1-2013:p0510:b004:l035","ordinal":116054,"en":"Come and settle in Talas,"},{"id":"semetey-1-2013:p0510:b004:l036","ordinal":116055,"en":"Come and serve as a warrior"},{"id":"semetey-1-2013:p0510:b004:l037","ordinal":116056,"en":"To Manas, Jakyp's only son."},{"id":"semetey-1-2013:p0510:b004:l039","ordinal":116057,"en":"If you come and settle in Talas,"},{"id":"semetey-1-2013:p0511:b003:l001","ordinal":116058,"en":"That is the place to dispel your sorrow;"},{"id":"semetey-1-2013:p0511:b003:l002","ordinal":116059,"en":"He is the hero who will tend you without grief."},{"id":"semetey-1-2013:p0511:b003:l003","ordinal":116060,"en":"My son, come to Manas and you will prosper;"},{"id":"semetey-1-2013:p0511:b003:l004","ordinal":116061,"en":"You will thrive, playing the knucklebone game."},{"id":"semetey-1-2013:p0511:b003:l005","ordinal":116062,"en":"My son, I am Oluyat's son;"},{"id":"semetey-1-2013:p0511:b003:l006","ordinal":116063,"en":"My son, you are Khan Baltay's son."},{"id":"semetey-1-2013:p0511:b003:l007","ordinal":116064,"en":"I grew up and girded my waist."},{"id":"semetey-1-2013:p0511:b003:l008","ordinal":116065,"en":"At the world's end lies Zhelpinish;"},{"id":"semetey-1-2013:p0511:b003:l009","ordinal":116066,"en":"In that Zhelpinish I was born."},{"id":"semetey-1-2013:p0511:b003:l010","ordinal":116067,"en":"At only six I grew restless;"},{"id":"semetey-1-2013:p0511:b003:l011","ordinal":116068,"en":"When I reached seven years,"},{"id":"semetey-1-2013:p0511:b003:l012","ordinal":116069,"en":"I saw Manas in a dream;"},{"id":"semetey-1-2013:p0511:b003:l013","ordinal":116070,"en":"Now I have met Khan Manas."},{"id":"semetey-1-2013:p0511:b003:l014","ordinal":116071,"en":"At the world's end, in Zhelpinish,"},{"id":"semetey-1-2013:p0511:b003:l015","ordinal":116072,"en":"Before Manas was born,"},{"id":"semetey-1-2013:p0511:b003:l016","ordinal":116073,"en":"I sought him for seven years."},{"id":"semetey-1-2013:p0511:b003:l017","ordinal":116074,"en":"In the cities of Baghdad and Egypt,"},{"id":"semetey-1-2013:p0511:b003:l018","ordinal":116075,"en":"I searched for six years."},{"id":"semetey-1-2013:p0511:b003:l019","ordinal":116076,"en":"In Mecca and Medina,"},{"id":"semetey-1-2013:p0511:b003:l020","ordinal":116077,"en":"For five years I could not find him."},{"id":"semetey-1-2013:p0511:b003:l021","ordinal":116078,"en":"Yesterday, when God granted my wish,"},{"id":"semetey-1-2013:p0511:b003:l022","ordinal":116079,"en":"When I reached thirty-one,"},{"id":"semetey-1-2013:p0511:b003:l023","ordinal":116080,"en":"Finding no land like Talas,"},{"id":"semetey-1-2013:p0511:b003:l024","ordinal":116081,"en":"Finding no hero like Khan Manas,"},{"id":"semetey-1-2013:p0511:b003:l025","ordinal":116082,"en":"My courage made me restless, Chubak."},{"id":"semetey-1-2013:p0511:b003:l026","ordinal":116083,"en":"On Andijan's gray plain, Chubak,"},{"id":"semetey-1-2013:p0511:b003:l027","ordinal":116084,"en":"I met Lion Khan Manas."},{"id":"semetey-1-2013:p0511:b003:l028","ordinal":116085,"en":"Sleeping at noon, I heard word"},{"id":"semetey-1-2013:p0511:b003:l029","ordinal":116086,"en":"That Khan Akbaltay's lion"},{"id":"semetey-1-2013:p0511:b003:l030","ordinal":116087,"en":"To generous, fierce Manas"},{"id":"semetey-1-2013:p0511:b003:l031","ordinal":116088,"en":"Would become a sworn warrior."},{"id":"semetey-1-2013:p0511:b003:l032","ordinal":116089,"en":"My companion in death, my partner in life,"},{"id":"semetey-1-2013:p0511:b003:l033","ordinal":116090,"en":"We rode ahead toward Andijan."},{"id":"semetey-1-2013:p0511:b003:l034","ordinal":116091,"en":"To find you, my precious one,"},{"id":"semetey-1-2013:p0511:b003:l035","ordinal":116092,"en":"We waited, looking toward Andijan."},{"id":"semetey-1-2013:p0511:b003:l036","ordinal":116093,"en":"I was a holy sage myself, Chubak,"},{"id":"semetey-1-2013:p0511:b003:l037","ordinal":116094,"en":"I was Khan Bakay's eye."},{"id":"semetey-1-2013:p0511:b003:l038","ordinal":116095,"en":"To go and settle in Talas,"},{"id":"semetey-1-2013:p0511:b003:l039","ordinal":116096,"en":"To become Manas's warrior,"},{"id":"semetey-1-2013:p0511:b004:l001","ordinal":116097,"en":"You were wandering astray, Chubak."},{"id":"semetey-1-2013:p0511:b004:l002","ordinal":116098,"en":"Seeking you deliberately, making a path,"},{"id":"semetey-1-2013:p0511:b004:l003","ordinal":116099,"en":"Hero, I was the bridegroom who came that once."},{"id":"semetey-1-2013:p0511:b004:l004","ordinal":116100,"en":"Your village was among the Oygut."},{"id":"semetey-1-2013:p0511:b004:l005","ordinal":116101,"en":"When I reckon the months,"},{"id":"semetey-1-2013:p0511:b004:l006","ordinal":116102,"en":"News of you came from Bukhara."},{"id":"semetey-1-2013:p0511:b004:l008","ordinal":116103,"en":"Dueling with a woman,"},{"id":"semetey-1-2013:p0511:b004:l009","ordinal":116104,"en":"Chubak, this was your disgrace."},{"id":"semetey-1-2013:p0511:b004:l011","ordinal":116105,"en":"Well, that person from Bukhara whom you fought—"},{"id":"semetey-1-2013:p0511:b004:l013","ordinal":116106,"en":"She is the wife Khan Manas will take."},{"id":"semetey-1-2013:p0511:b004:l014","ordinal":116107,"en":"A beauty among the dark-complexioned,"},{"id":"semetey-1-2013:p0511:b004:l015","ordinal":116108,"en":"She is radiant among Muslims."},{"id":"semetey-1-2013:p0511:b004:l016","ordinal":116109,"en":"The most capable of women,"},{"id":"semetey-1-2013:p0511:b004:l017","ordinal":116110,"en":"A saint among women,"},{"id":"semetey-1-2013:p0511:b004:l018","ordinal":116111,"en":"A woman of extraordinary strength,"},{"id":"semetey-1-2013:p0511:b004:l020","ordinal":116112,"en":"A treasure for Khan Manas."},{"id":"semetey-1-2013:p0511:b004:l021","ordinal":116113,"en":"Often, Chubak, you will know:"},{"id":"semetey-1-2013:p0511:b004:l022","ordinal":116114,"en":"By your excellent, ill-fated sister-in-law,"},{"id":"semetey-1-2013:p0511:b004:l023","ordinal":116115,"en":"Chubak, you will wear the coat she makes."},{"id":"semetey-1-2013:p0511:b004:l024","ordinal":116116,"en":"Chubak, on your right are Russians;"},{"id":"semetey-1-2013:p0511:b004:l025","ordinal":116117,"en":"Chubak, beyond the ridge are Chinese."},{"id":"semetey-1-2013:p0511:b004:l026","ordinal":116118,"en":"Chubak, before you are Franks."},{"id":"semetey-1-2013:p0511:b004:l027","ordinal":116119,"en":"If sovereign Khan Manas lives and thrives,"},{"id":"semetey-1-2013:p0511:b004:l028","ordinal":116120,"en":"You have many enemies to fight."},{"id":"semetey-1-2013:p0511:b004:l029","ordinal":116121,"en":"If God grants it, my Chubak,"},{"id":"semetey-1-2013:p0511:b004:l030","ordinal":116122,"en":"Your time will come to be a sultan."},{"id":"semetey-1-2013:p0511:b004:l031","ordinal":116123,"en":"Kanykey, Khan Temir's daughter—"},{"id":"semetey-1-2013:p0511:b004:l032","ordinal":116124,"en":"Chubak, do not grieve;"},{"id":"semetey-1-2013:p0511:b004:l033","ordinal":116125,"en":"This year she is to become your sister-in-law."},{"id":"semetey-1-2013:p0511:b004:l034","ordinal":116126,"en":"This year, Chubak, hear my words:"},{"id":"semetey-1-2013:p0511:b004:l035","ordinal":116127,"en":"This year we shall range through Medina."},{"id":"semetey-1-2013:p0511:b004:l036","ordinal":116128,"en":"For Manas, visited by Kyzyr,"},{"id":"semetey-1-2013:p0511:b004:l037","ordinal":116129,"en":"We shall find valiant men."},{"id":"semetey-1-2013:p0511:b004:l038","ordinal":116130,"en":"For Manas, visited by Baabedin,"},{"id":"semetey-1-2013:p0511:b004:l039","ordinal":116131,"en":"We shall find many heroes."},{"id":"semetey-1-2013:p0512:b003:l001","ordinal":116132,"en":"On the ridge of Kum-Bulak,"},{"id":"semetey-1-2013:p0512:b003:l002","ordinal":116133,"en":"On the journey to Mecca,"},{"id":"semetey-1-2013:p0512:b003:l003","ordinal":116134,"en":"At the place of ritual washing,"},{"id":"semetey-1-2013:p0512:b003:l004","ordinal":116135,"en":"One champion among fanged creatures"},{"id":"semetey-1-2013:p0512:b003:l005","ordinal":116136,"en":"Will meet the generous khan."},{"id":"semetey-1-2013:p0512:b003:l006","ordinal":116137,"en":"If it lives, a gray puppy"},{"id":"semetey-1-2013:p0512:b003:l007","ordinal":116138,"en":"Will be found for Khan Manas."},{"id":"semetey-1-2013:p0512:b003:l008","ordinal":116139,"en":"We shall take Kumayyk along the way."},{"id":"semetey-1-2013:p0512:b003:l009","ordinal":116140,"en":"To tend Kumayyk,"},{"id":"semetey-1-2013:p0512:b003:l010","ordinal":116141,"en":"Using that as a pretext,"},{"id":"semetey-1-2013:p0512:b003:l011","ordinal":116142,"en":"Putting betrothal earrings on that poor woman,"},{"id":"semetey-1-2013:p0512:b003:l012","ordinal":116143,"en":"We shall take Kanykey as bride."},{"id":"semetey-1-2013:p0512:b003:l013","ordinal":116144,"en":"She is the support to rely upon;"},{"id":"semetey-1-2013:p0512:b003:l014","ordinal":116145,"en":"Born of a woman,"},{"id":"semetey-1-2013:p0512:b003:l015","ordinal":116146,"en":"She is that exceptionally strong hero."},{"id":"semetey-1-2013:p0512:b003:l016","ordinal":116147,"en":"As queen to the blood-stained warrior,"},{"id":"semetey-1-2013:p0512:b003:l017","ordinal":116148,"en":"She is the one who will find a way for us.”"},{"id":"semetey-1-2013:p0512:b003:l019","ordinal":116149,"en":"Acting as mediator, Khan Bakay"},{"id":"semetey-1-2013:p0512:b003:l020","ordinal":116150,"en":"Spoke words of prophecy."},{"id":"semetey-1-2013:p0512:b003:l021","ordinal":116151,"en":"Speaking words full of meaning,"},{"id":"semetey-1-2013:p0512:b003:l022","ordinal":116152,"en":"Proclaiming all that was to be said,"},{"id":"semetey-1-2013:p0512:b003:l023","ordinal":116153,"en":"Comforting Khan Chubak,"},{"id":"semetey-1-2013:p0512:b003:l024","ordinal":116154,"en":"He returned to Talas."},{"id":"semetey-1-2013:p0512:b003:l025","ordinal":116155,"en":"He made the meaning known"},{"id":"semetey-1-2013:p0512:b003:l026","ordinal":116156,"en":"To your royal father Manas."},{"id":"semetey-1-2013:p0512:b003:l027","ordinal":116157,"en":"Khan Bakay, born a leopard,"},{"id":"semetey-1-2013:p0512:b003:l028","ordinal":116158,"en":"Spoke words of sacred power."},{"id":"semetey-1-2013:p0512:b003:l029","ordinal":116159,"en":"Resourceful Bakay, that holy elder,"},{"id":"semetey-1-2013:p0512:b003:l030","ordinal":116160,"en":"Persuading Chubak skillfully,"},{"id":"semetey-1-2013:p0512:b003:l031","ordinal":116161,"en":"Took him to Talas then."},{"id":"semetey-1-2013:p0512:b003:l032","ordinal":116162,"en":"Chubak went and settled in Talas;"},{"id":"semetey-1-2013:p0512:b003:l033","ordinal":116163,"en":"He became your father Sultan Manas's warrior."},{"id":"semetey-1-2013:p0512:b003:l034","ordinal":116164,"en":"Ajybay, Khan Argyn's son,"},{"id":"semetey-1-2013:p0512:b003:l035","ordinal":116165,"en":"Rode to Talas,"},{"id":"semetey-1-2013:p0512:b003:l036","ordinal":116166,"en":"And then became a warrior"},{"id":"semetey-1-2013:p0512:b003:l037","ordinal":116167,"en":"To your father Sultan Manas."},{"id":"semetey-1-2013:p0512:b003:l038","ordinal":116168,"en":"Your father gathered heroes through his valor."},{"id":"semetey-1-2013:p0512:b003:l039","ordinal":116169,"en":"He gathered twelve generations alike."},{"id":"semetey-1-2013:p0512:b004:l001","ordinal":116170,"en":"The horses grew fat and strong."},{"id":"semetey-1-2013:p0512:b004:l002","ordinal":116171,"en":"Through his greatness of spirit, your father"},{"id":"semetey-1-2013:p0512:b004:l003","ordinal":116172,"en":"Alone was worth forty men."},{"id":"semetey-1-2013:p0512:b004:l004","ordinal":116173,"en":"Fortune favored him in everything;"},{"id":"semetey-1-2013:p0512:b004:l005","ordinal":116174,"en":"He was a lion favored with victory."},{"id":"semetey-1-2013:p0512:b004:l006","ordinal":116175,"en":"The one God, someone like your father,"},{"id":"semetey-1-2013:p0512:b004:l007","ordinal":116176,"en":"A soul created to equal your father,"},{"id":"semetey-1-2013:p0512:b004:l008","ordinal":116177,"en":"Will not grant again soon."},{"id":"semetey-1-2013:p0512:b004:l009","ordinal":116178,"en":"Your father made trouble wherever he sought;"},{"id":"semetey-1-2013:p0512:b004:l010","ordinal":116179,"en":"Using Kumayyk as a pretext,"},{"id":"semetey-1-2013:p0512:b004:l011","ordinal":116180,"en":"Loading eighty camels with gold coins,"},{"id":"semetey-1-2013:p0512:b004:l012","ordinal":116181,"en":"He made a marriage alliance and took me."},{"id":"semetey-1-2013:p0512:b004:l013","ordinal":116182,"en":"He showed me many humiliations,"},{"id":"semetey-1-2013:p0512:b004:l014","ordinal":116183,"en":"Stirring quarrels time and again;"},{"id":"semetey-1-2013:p0512:b004:l015","ordinal":116184,"en":"Your father subjected me to much oppression."},{"id":"semetey-1-2013:p0512:b004:l016","ordinal":116185,"en":"Your father Manas, looming large,"},{"id":"semetey-1-2013:p0512:b004:l017","ordinal":116186,"en":"When he came to court me,"},{"id":"semetey-1-2013:p0512:b004:l018","ordinal":116187,"en":"My father was beside himself with joy,"},{"id":"semetey-1-2013:p0512:b004:l019","ordinal":116188,"en":"And gathered holy men, leaving none out."},{"id":"semetey-1-2013:p0512:b004:l020","ordinal":116189,"en":"Seventy mullahs and four scholars"},{"id":"semetey-1-2013:p0512:b004:l021","ordinal":116190,"en":"Joined your fierce father Khan Manas"},{"id":"semetey-1-2013:p0512:b004:l022","ordinal":116191,"en":"In marriage to your wretched mother."},{"id":"semetey-1-2013:p0512:b004:l024","ordinal":116192,"en":"Ninety young wives and ninety girls"},{"id":"semetey-1-2013:p0512:b004:l025","ordinal":116193,"en":"Laid bedding without pause,"},{"id":"semetey-1-2013:p0512:b004:l026","ordinal":116194,"en":"Taking gold by the pood, countless gold coins,"},{"id":"semetey-1-2013:p0512:b004:l027","ordinal":116195,"en":"As gifts for the bride's womenfolk."},{"id":"semetey-1-2013:p0512:b004:l028","ordinal":116196,"en":"To lie in his embrace,"},{"id":"semetey-1-2013:p0512:b004:l029","ordinal":116197,"en":"When I, wretched one, stepped forward,"},{"id":"semetey-1-2013:p0512:b004:l030","ordinal":116198,"en":"Just as I reached the bed,"},{"id":"semetey-1-2013:p0512:b004:l031","ordinal":116199,"en":"My steel blade on the lattice wall"},{"id":"semetey-1-2013:p0512:b004:l032","ordinal":116200,"en":"Leapt from its sheath,"},{"id":"semetey-1-2013:p0512:b004:l033","ordinal":116201,"en":"And your father, visited by Kyzyr,"},{"id":"semetey-1-2013:p0512:b004:l034","ordinal":116202,"en":"It lightly scratched across the forearm."},{"id":"semetey-1-2013:p0512:b004:l035","ordinal":116203,"en":"Putting sorrow upon me,"},{"id":"semetey-1-2013:p0512:b004:l036","ordinal":116204,"en":"Saying, “As a girl, this bitch"},{"id":"semetey-1-2013:p0512:b004:l037","ordinal":116205,"en":"Stabbed and wounded my forearm,”"},{"id":"semetey-1-2013:p0512:b004:l038","ordinal":116206,"en":"He left without lying in my embrace."},{"id":"semetey-1-2013:p0512:b004:l039","ordinal":116207,"en":"I acquired an ill name,"},{"id":"semetey-1-2013:p0513:b003:l001","ordinal":116208,"en":"Your khan father would not sleep with me;"},{"id":"semetey-1-2013:p0513:b003:l002","ordinal":116209,"en":"Again I became a neglected wife."},{"id":"semetey-1-2013:p0513:b003:l003","ordinal":116210,"en":"Struggling, he won his prize;"},{"id":"semetey-1-2013:p0513:b003:l004","ordinal":116211,"en":"Using that as a pretext, your father"},{"id":"semetey-1-2013:p0513:b003:l005","ordinal":116212,"en":"Bukhara, where my father Khan Temir lived,"},{"id":"semetey-1-2013:p0513:b003:l006","ordinal":116213,"en":"He raided six times."},{"id":"semetey-1-2013:p0513:b003:l007","ordinal":116214,"en":"For Akbaltay's Chubak,"},{"id":"semetey-1-2013:p0513:b003:l008","ordinal":116215,"en":"That unruly one who had fought me,"},{"id":"semetey-1-2013:p0513:b003:l009","ordinal":116216,"en":"He attacked the moving camps at will,"},{"id":"semetey-1-2013:p0513:b003:l010","ordinal":116217,"en":"And thus took his revenge."},{"id":"semetey-1-2013:p0513:b003:l011","ordinal":116218,"en":"I was the one left neglected."},{"id":"semetey-1-2013:p0513:b003:l012","ordinal":116219,"en":"Bearing your father no resentment,"},{"id":"semetey-1-2013:p0513:b003:l013","ordinal":116220,"en":"With sixty girls and their white yurts,"},{"id":"semetey-1-2013:p0513:b003:l014","ordinal":116221,"en":"I came out of Bukhara,"},{"id":"semetey-1-2013:p0513:b003:l015","ordinal":116222,"en":"And settled beside your father."},{"id":"semetey-1-2013:p0513:b003:l016","ordinal":116223,"en":"Finding my way, with your father"},{"id":"semetey-1-2013:p0513:b003:l017","ordinal":116224,"en":"Winning favor through my skill,"}]
