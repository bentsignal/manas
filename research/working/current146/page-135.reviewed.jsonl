{"id": "sayakbay-ms-current146:pdf135:l001", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 1, "raw": "Эренди тандап чабылды,", "text": "Эренди тандап чабылды,", "en": "He chose his warriors and launched the attack,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l002", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 2, "raw": "Кыран кыргыз салбайбы,", "text": "Кыран кыргыз салбайбы,", "en": "Would he not unleash the valiant Kyrgyz?", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l003", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 3, "raw": "Кыйык эткенди сойбойбу,", "text": "Кыйык эткенди сойбойбу,", "en": "Would he not cut down whoever resisted?", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l004", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 4, "raw": "Кылычтай баатыр салбайбы.", "text": "Кылычтай баатыр салбайбы.", "en": "Would he not send forth warriors sharp as swords?", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l005", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 5, "raw": "Колго тийсе коёбу,", "text": "Колго тийсе коёбу,", "en": "If one fell into his hands, would he let him go?", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 6, "raw": "Корголорун сойбойбу,", "text": "Корголорун сойбойбу,", "en": "Would he not slaughter those seeking protection?", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; word division, proper name, or idiomatic interpretation may require review.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 7, "raw": "Кой этинен отпойбу,", "text": "Кой этинен отпойбу,", "en": "Would he not consume even their mutton?", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; word division, proper name, or idiomatic interpretation may require review.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 8, "raw": "Коркураган калбады кан,", "text": "Коркураган калбады кан,", "en": "No trembling khan remained,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 9, "raw": "Такыр журтту койбойбу.", "text": "Такыр журтту койбойбу.", "en": "Would he not strip the people bare?", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 10, "raw": "Малың эмес башыңды,", "text": "Малың эмес башыңды,", "en": "Not merely your livestock, but your head,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 11, "raw": "Оймо кызык кылбайбы,", "text": "Оймо кызык кылбайбы,", "en": "Would he not make it an object of cruel sport?", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; word division, proper name, or idiomatic interpretation may require review.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 12, "raw": "Казынаң бергенди,", "text": "Казынаң бергенди,", "en": "What your treasury had yielded,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; word division, proper name, or idiomatic interpretation may require review.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l013", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 13, "raw": "Карап кылым карбайбы,", "text": "Карап кылым карбайбы,", "en": "Would he not seize it before all the world?", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; word division, proper name, or idiomatic interpretation may require review.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 14, "raw": "Бетине бетпайт салбайбы,", "text": "Бетине бетпайт салбайбы,", "en": "Would he not strike anyone who faced him?", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; word division, proper name, or idiomatic interpretation may require review.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 15, "raw": "Аркы атасы Алеке,", "text": "Аркы атасы Алеке,", "en": "His forefather was Aleke,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; word division, proper name, or idiomatic interpretation may require review.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 16, "raw": "Андан кийинки эр Канча,", "text": "Андан кийинки эр Канча,", "en": "After him came the warrior Kancha,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; word division, proper name, or idiomatic interpretation may require review.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 17, "raw": "Булгардан кунун албайбы,", "text": "Булгардан кунун албайбы,", "en": "Would he not exact blood-price from the Bulgars?", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 18, "raw": "Кунуңа кыргыз жеталбайт,", "text": "Кунуңа кыргыз жеталбайт,", "en": "The Kyrgyz cannot attain your vengeance,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 19, "raw": "Кыргыз аз журт оңбойбу,", "text": "Кыргыз аз журт оңбойбу,", "en": "Can the small Kyrgyz people not recover?", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 20, "raw": "Куп, атам, шу мына деп,", "text": "Куп, атам, шу мына деп,", "en": "“Indeed, father, here it is,” he said,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; word division, proper name, or idiomatic interpretation may require review.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 21, "raw": "Эрендерди унутпайбы,", "text": "Эрендерди унутпайбы,", "en": "Would he forget the heroes?", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 22, "raw": "Бет алганды жыгылбайбы,", "text": "Бет алганды жыгылбайбы,", "en": "Would he not bring down whoever confronted him?", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 23, "raw": "Деп өшөктү Шам жетпес,", "text": "Деп өшөктү Шам жетпес,", "en": "So he spoke of a feud whose end none could reach,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; word division, proper name, or idiomatic interpretation may require review.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l024", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 24, "raw": "Кара түмөн кайрадан,", "text": "Кара түмөн кайрадан,", "en": "The black host came once again,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 25, "raw": "Канча агып байлоо сөз,", "text": "Канча агып байлоо сөз,", "en": "Many binding words poured forth,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; word division, proper name, or idiomatic interpretation may require review.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 26, "raw": "Түгөнгөн жерин сайрады.", "text": "Түгөнгөн жерин сайрады.", "en": "He told the tale through to its end.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 27, "raw": "Муну укканда эр Кенен,", "text": "Муну укканда эр Кенен,", "en": "When the warrior Kenen heard this,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 28, "raw": "Жалындан жаны кайнады,", "text": "Жалындан жаны кайнады,", "en": "His soul boiled like flame,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 29, "raw": "Бузулган кытай доңуздун,", "text": "Бузулган кытай доңуздун,", "en": "At the depraved Chinese swine,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 30, "raw": "Мурдатан душман ал эдин,", "text": "Мурдатан душман ал эдин,", "en": "You had been an enemy since ancient times,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 31, "raw": "Кантип момун чебиз,", "text": "Кантип момун чебиз,", "en": "How could we remain meek?", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; word division, proper name, or idiomatic interpretation may require review.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 32, "raw": "Шер башында кем кылып,", "text": "Шер башында кем кылып,", "en": "Humiliating the lion-hearted leader,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; word division, proper name, or idiomatic interpretation may require review.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 33, "raw": "Коңурду кара жер кылып,", "text": "Коңурду кара жер кылып,", "en": "Casting Kongur down upon the black earth,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; word division, proper name, or idiomatic interpretation may require review.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l034", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 34, "raw": "Козунун жаман кол кылып,", "text": "Козунун жаман кол кылып,", "en": "Putting him into Kozu’s wicked hands,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; word division, proper name, or idiomatic interpretation may require review.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf135:l035", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 135, "folio": 518, "line_in_page": 35, "raw": "Душманга журтту бийлетип.", "text": "Душманга журтту бийлетип.", "en": "Letting an enemy rule the people.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
