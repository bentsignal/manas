{"id": "sayakbay-ms-current146:pdf073:l001", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 73, "folio": 456, "line_in_page": 1, "raw": "Көпчүлүккө салбасаң,", "text": "Көпчүлүккө салбасаң,", "en": "Unless you cast it before the multitude,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Opening construction is difficult and provisional.", "bbox": null}
