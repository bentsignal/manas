[{"id":"seytek-2012:p1147:b004:l016","ordinal":385025,"en":"It satisfied the heart of all who saw it."},{"id":"seytek-2012:p1147:b004:l017","ordinal":385026,"en":"All eyes turned when he girded it on,"},{"id":"seytek-2012:p1147:b004:l018","ordinal":385027,"en":"And souls rejoiced at the sight;"},{"id":"seytek-2012:p1147:b004:l019","ordinal":385028,"en":"On a moonless, overcast night,"},{"id":"seytek-2012:p1147:b004:l020","ordinal":385029,"en":"It shone as brightly as moonlight"},{"id":"seytek-2012:p1147:b004:l021","ordinal":385030,"en":"When seen upon his waist."},{"id":"seytek-2012:p1147:b004:l022","ordinal":385031,"en":"He girded on the blue pouch,"},{"id":"seytek-2012:p1147:b004:l023","ordinal":385032,"en":"Took up the blue-lacquered spear,"},{"id":"seytek-2012:p1147:b004:l024","ordinal":385033,"en":"And rode along the edge of the road,"},{"id":"seytek-2012:p1147:b004:l025","ordinal":385034,"en":"Making the peerless steed Kulunsur"},{"id":"seytek-2012:p1147:b004:l026","ordinal":385035,"en":"Prance beneath him."},{"id":"seytek-2012:p1147:b004:l027","ordinal":385036,"en":"Your hero Joltoi"},{"id":"seytek-2012:p1147:b004:l028","ordinal":385037,"en":"Rode proudly, braced for battle,"},{"id":"seytek-2012:p1147:b004:l029","ordinal":385038,"en":"Swaying as though the earth struck toward him,"},{"id":"seytek-2012:p1147:b004:l030","ordinal":385039,"en":"His silhouette rising like another mountain,"},{"id":"seytek-2012:p1147:b004:l031","ordinal":385040,"en":"His whole body surging with power."},{"id":"seytek-2012:p1147:b004:l032","ordinal":385041,"en":"He shouted from the front,"},{"id":"seytek-2012:p1147:b004:l033","ordinal":385042,"en":"“Where is my dear Seytek?”"},{"id":"seytek-2012:p1147:b004:l034","ordinal":385043,"en":"And raised a mighty battle cry."},{"id":"seytek-2012:p1147:b004:l035","ordinal":385044,"en":"Seeing strife, battle, and turmoil,"},{"id":"seytek-2012:p1147:b004:l036","ordinal":385045,"en":"Seeing coats without end,"},{"id":"seytek-2012:p1147:b004:l037","ordinal":385046,"en":"Joltoi saw the vastness of hell:"},{"id":"seytek-2012:p1147:b004:l038","ordinal":385047,"en":"Those ninety there, these two here,"},{"id":"seytek-2012:p1147:b004:l039","ordinal":385048,"en":"Attacking from every side."},{"id":"seytek-2012:p1148:b002:l001","ordinal":385049,"en":"With no thought of truce,"},{"id":"seytek-2012:p1148:b002:l002","ordinal":385050,"en":"And no mercy for precious life,"},{"id":"seytek-2012:p1148:b002:l003","ordinal":385051,"en":"A fierce battle and great calamity raged;"},{"id":"seytek-2012:p1148:b002:l004","ordinal":385052,"en":"Spears shattered and heroes fell,"},{"id":"seytek-2012:p1148:b002:l005","ordinal":385053,"en":"And the turmoil grew immense."},{"id":"seytek-2012:p1148:b002:l006","ordinal":385054,"en":"They fought with spears,"},{"id":"seytek-2012:p1148:b002:l007","ordinal":385055,"en":"Raising piercing cries and hoarse shouts"},{"id":"seytek-2012:p1148:b002:l008","ordinal":385056,"en":"With all their might."},{"id":"seytek-2012:p1148:b002:l009","ordinal":385057,"en":"Seytek rode through, striking as he went,"},{"id":"seytek-2012:p1148:b002:l010","ordinal":385058,"en":"And any foe who happened to fall,"},{"id":"seytek-2012:p1148:b002:l011","ordinal":385059,"en":"Akjoltoi cut off his head."},{"id":"seytek-2012:p1148:b002:l012","ordinal":385060,"en":"Joltoi rode through, spearing as he went,"},{"id":"seytek-2012:p1148:b002:l013","ordinal":385061,"en":"And any man he felled, without leaving him whole,"},{"id":"seytek-2012:p1148:b002:l014","ordinal":385062,"en":"Seytek cut off his head."},{"id":"seytek-2012:p1148:b002:l015","ordinal":385063,"en":"They fought, scarcely pausing for breath,"},{"id":"seytek-2012:p1148:b002:l016","ordinal":385064,"en":"Wreaking calamitous havoc;"},{"id":"seytek-2012:p1148:b002:l017","ordinal":385065,"en":"When their spears broke and were lost,"},{"id":"seytek-2012:p1148:b002:l018","ordinal":385066,"en":"They took up their battle-axes."},{"id":"seytek-2012:p1148:b002:l019","ordinal":385067,"en":"The falcons who confronted one another"},{"id":"seytek-2012:p1148:b002:l020","ordinal":385068,"en":"Struck in turn,"},{"id":"seytek-2012:p1148:b002:l021","ordinal":385069,"en":"Standing face-to-face;"},{"id":"seytek-2012:p1148:b002:l022","ordinal":385070,"en":"Valuing their fleeting lives not a hair,"},{"id":"seytek-2012:p1148:b002:l023","ordinal":385071,"en":"They utterly renounced them,"},{"id":"seytek-2012:p1148:b002:l024","ordinal":385072,"en":"Standing firm for honor,"},{"id":"seytek-2012:p1148:b002:l025","ordinal":385073,"en":"Fighting without wavering,"},{"id":"seytek-2012:p1148:b002:l026","ordinal":385074,"en":"Until the tumult became immense."},{"id":"seytek-2012:p1148:b002:l027","ordinal":385075,"en":"Mighty Bilgich grew furious:"},{"id":"seytek-2012:p1148:b002:l028","ordinal":385076,"en":"“We are ninety-four, and these are only two!"},{"id":"seytek-2012:p1148:b002:l029","ordinal":385077,"en":"Have our strength and endurance departed?"},{"id":"seytek-2012:p1148:b002:l030","ordinal":385078,"en":"Has all our might abandoned us?"},{"id":"seytek-2012:p1148:b002:l031","ordinal":385079,"en":"All of you close in and attack!"},{"id":"seytek-2012:p1148:b002:l032","ordinal":385080,"en":"If grievous death"},{"id":"seytek-2012:p1148:b002:l033","ordinal":385081,"en":"Is written upon your brow, then face it;"},{"id":"seytek-2012:p1148:b002:l034","ordinal":385082,"en":"Can a doomed man turn death aside?"},{"id":"seytek-2012:p1148:b002:l035","ordinal":385083,"en":"Can a brave man with a warrior’s sash"},{"id":"seytek-2012:p1148:b002:l036","ordinal":385084,"en":"Turn back from death?”"},{"id":"seytek-2012:p1148:b002:l037","ordinal":385085,"en":"Shouting to embolden them,"},{"id":"seytek-2012:p1148:b002:l038","ordinal":385086,"en":"The savage Chongbilgich once more"},{"id":"seytek-2012:p1148:b002:l039","ordinal":385087,"en":"Drove all who remained alive"},{"id":"seytek-2012:p1148:b002:l040","ordinal":385088,"en":"Into the fray in a surging mass."},{"id":"seytek-2012:p1148:b003:l001","ordinal":385089,"en":"He trampled and shattered the battle line,"},{"id":"seytek-2012:p1148:b003:l002","ordinal":385090,"en":"Scolding all his champions,"},{"id":"seytek-2012:p1148:b003:l003","ordinal":385091,"en":"Whirling his spear in a rushing arc."},{"id":"seytek-2012:p1148:b003:l004","ordinal":385092,"en":"The madman thundered,"},{"id":"seytek-2012:p1148:b003:l005","ordinal":385093,"en":"Making the wide world seem narrow,"},{"id":"seytek-2012:p1148:b003:l006","ordinal":385094,"en":"Showing a back as dreadful as hell,"},{"id":"seytek-2012:p1148:b003:l007","ordinal":385095,"en":"Steeling courage as vast as a mountain,"},{"id":"seytek-2012:p1148:b003:l008","ordinal":385096,"en":"Working mysteries no man could fathom,"},{"id":"seytek-2012:p1148:b003:l009","ordinal":385097,"en":"Making his wit, cunning, and strength"},{"id":"seytek-2012:p1148:b003:l010","ordinal":385098,"en":"Keener than anything in the world."},{"id":"seytek-2012:p1148:b003:l011","ordinal":385099,"en":"He dimmed the light and blinded the eye,"},{"id":"seytek-2012:p1148:b003:l012","ordinal":385100,"en":"Toppling mountains and darkening the sun,"},{"id":"seytek-2012:p1148:b003:l013","ordinal":385101,"en":"Raising a tumult equal to hell;"},{"id":"seytek-2012:p1148:b003:l014","ordinal":385102,"en":"Caught in his fury,"},{"id":"seytek-2012:p1148:b003:l015","ordinal":385103,"en":"The age grew cramped and disordered,"},{"id":"seytek-2012:p1148:b003:l016","ordinal":385104,"en":"The earth clouded with dust and mist,"},{"id":"seytek-2012:p1148:b003:l017","ordinal":385105,"en":"And hill, cliff, and lofty mountain"},{"id":"seytek-2012:p1148:b003:l018","ordinal":385106,"en":"Vanished as though beneath snow."},{"id":"seytek-2012:p1148:b003:l019","ordinal":385107,"en":"The weather broke and turned to winter,"},{"id":"seytek-2012:p1148:b003:l020","ordinal":385108,"en":"So fierce a storm he raised."},{"id":"seytek-2012:p1148:b003:l021","ordinal":385109,"en":"Ask no more of Chongbilgich:"},{"id":"seytek-2012:p1148:b003:l022","ordinal":385110,"en":"A master horseman and swift runner on foot,"},{"id":"seytek-2012:p1148:b003:l023","ordinal":385111,"en":"Ready and supremely skilled with the spear,"},{"id":"seytek-2012:p1148:b003:l024","ordinal":385112,"en":"A consummate master of cunning,"},{"id":"seytek-2012:p1148:b003:l025","ordinal":385113,"en":"His father was the marksman Kojozhash;"},{"id":"seytek-2012:p1148:b003:l026","ordinal":385114,"en":"Watch his stratagems closely,"},{"id":"seytek-2012:p1148:b003:l027","ordinal":385115,"en":"And when all means fail, flee."},{"id":"seytek-2012:p1148:b003:l028","ordinal":385116,"en":"His onslaught had deep-rooted force,"},{"id":"seytek-2012:p1148:b003:l029","ordinal":385117,"en":"No living soul survived his bow,"},{"id":"seytek-2012:p1148:b003:l030","ordinal":385118,"en":"And no creature could withstand"},{"id":"seytek-2012:p1148:b003:l031","ordinal":385119,"en":"His terrible aspect and venom."},{"id":"seytek-2012:p1148:b003:l032","ordinal":385120,"en":"The earth darkened and the waters surged,"},{"id":"seytek-2012:p1148:b003:l033","ordinal":385121,"en":"So masterful was the battle."},{"id":"seytek-2012:p1148:b003:l034","ordinal":385122,"en":"Riding twin gray steeds,"},{"id":"seytek-2012:p1148:b003:l035","ordinal":385123,"en":"Wearing splendid, mighty coats,"},{"id":"seytek-2012:p1148:b003:l036","ordinal":385124,"en":"The heroes Seytek and Akjoltoi"},{"id":"seytek-2012:p1148:b003:l037","ordinal":385125,"en":"Were borne onward by their guardian spirits,"},{"id":"seytek-2012:p1148:b003:l038","ordinal":385126,"en":"Who raised their hands in aid."},{"id":"seytek-2012:p1148:b003:l039","ordinal":385127,"en":"The spirits of their forefathers"},{"id":"seytek-2012:p1148:b003:l040","ordinal":385128,"en":"Bore them mightily onward."},{"id":"seytek-2012:p1149:b002:l001","ordinal":385129,"en":"Without so much as blinking,"},{"id":"seytek-2012:p1149:b002:l002","ordinal":385130,"en":"The wrath of great Bilgich"},{"id":"seytek-2012:p1149:b002:l003","ordinal":385131,"en":"The gray-maned hero heeded not, though it would drain him dry;"},{"id":"seytek-2012:p1149:b002:l004","ordinal":385132,"en":"They fought in turns,"},{"id":"seytek-2012:p1149:b002:l005","ordinal":385133,"en":"Neither yielding to great Bilgich’s fury"},{"id":"seytek-2012:p1149:b002:l006","ordinal":385134,"en":"Nor to the venom he unleashed,"},{"id":"seytek-2012:p1149:b002:l007","ordinal":385135,"en":"Standing firm without submission."},{"id":"seytek-2012:p1149:b002:l008","ordinal":385136,"en":"The incomparable Akjoltoy"},{"id":"seytek-2012:p1149:b002:l009","ordinal":385137,"en":"Had saddled Kulunsur."},{"id":"seytek-2012:p1149:b002:l010","ordinal":385138,"en":"Every spell known to man,"},{"id":"seytek-2012:p1149:b002:l011","ordinal":385139,"en":"He recited without omitting one."},{"id":"seytek-2012:p1149:b002:l012","ordinal":385140,"en":"Great Bilgich, the mighty sorcerer,"},{"id":"seytek-2012:p1149:b002:l013","ordinal":385141,"en":"Sent forth an icy wind,"},{"id":"seytek-2012:p1149:b002:l014","ordinal":385142,"en":"Splitting the blue-gray sky apart,"},{"id":"seytek-2012:p1149:b002:l015","ordinal":385143,"en":"Wrapping everything in mist and confusion."},{"id":"seytek-2012:p1149:b002:l016","ordinal":385144,"en":"But Akjoltoy was a true champion:"},{"id":"seytek-2012:p1149:b002:l017","ordinal":385145,"en":"He made the beguiled sun appear,"},{"id":"seytek-2012:p1149:b002:l018","ordinal":385146,"en":"Subdued the hell of the cutting wind,"},{"id":"seytek-2012:p1149:b002:l019","ordinal":385147,"en":"Akjoltoy held it down,"},{"id":"seytek-2012:p1149:b002:l020","ordinal":385148,"en":"And opened up the day,"},{"id":"seytek-2012:p1149:b002:l021","ordinal":385149,"en":"Making it brilliantly bright."},{"id":"seytek-2012:p1149:b002:l022","ordinal":385150,"en":"Great Bilgich’s fury left him,"},{"id":"seytek-2012:p1149:b002:l023","ordinal":385151,"en":"And he came out into the sunlight."},{"id":"seytek-2012:p1149:b002:l024","ordinal":385152,"en":"That Bilgich ceased his infernal raging"},{"id":"seytek-2012:p1149:b002:l025","ordinal":385153,"en":"And regained his speech."},{"id":"seytek-2012:p1149:b002:l026","ordinal":385154,"en":"When he rode out from the Great Khagan,"},{"id":"seytek-2012:p1149:b002:l027","ordinal":385155,"en":"Great Bilgich fixed his hatred"},{"id":"seytek-2012:p1149:b002:l028","ordinal":385156,"en":"On Akjoltoy and the valiant Seytek."},{"id":"seytek-2012:p1149:b002:l029","ordinal":385157,"en":"Intent on taking Kulunsur as spoil,"},{"id":"seytek-2012:p1149:b002:l030","ordinal":385158,"en":"He charged with a roar,"},{"id":"seytek-2012:p1149:b002:l031","ordinal":385159,"en":"Leveling his spear with a battle cry."},{"id":"seytek-2012:p1149:b002:l032","ordinal":385160,"en":"As he was about to reach Akjoltoy,"},{"id":"seytek-2012:p1149:b002:l033","ordinal":385161,"en":"Brave Seytek, that peerless lion, thought:"},{"id":"seytek-2012:p1149:b002:l034","ordinal":385162,"en":"“If the infidel reaches my uncle,"},{"id":"seytek-2012:p1149:b002:l035","ordinal":385163,"en":"Then afterward, upon this land,"},{"id":"seytek-2012:p1149:b002:l036","ordinal":385164,"en":"The end of days will surely fall."},{"id":"seytek-2012:p1149:b002:l037","ordinal":385165,"en":"I shall drive my horse without restraint"},{"id":"seytek-2012:p1149:b002:l038","ordinal":385166,"en":"And bar the path"},{"id":"seytek-2012:p1149:b002:l039","ordinal":385167,"en":"Of this wrathful calamity.”"},{"id":"seytek-2012:p1149:b002:l040","ordinal":385168,"en":"So saying, brave Seytek"},{"id":"seytek-2012:p1149:b003:l001","ordinal":385169,"en":"Turned all his attention there;"},{"id":"seytek-2012:p1149:b003:l002","ordinal":385170,"en":"He loomed like Mount Opol,"},{"id":"seytek-2012:p1149:b003:l003","ordinal":385171,"en":"While Kulunsur beneath him"},{"id":"seytek-2012:p1149:b003:l004","ordinal":385172,"en":"Wheeled as he gripped his spear."},{"id":"seytek-2012:p1149:b003:l005","ordinal":385173,"en":"He reined the cloud-swift steed"},{"id":"seytek-2012:p1149:b003:l006","ordinal":385174,"en":"Hard against the fetlocks,"},{"id":"seytek-2012:p1149:b003:l007","ordinal":385175,"en":"And that matchless Kulunsur"},{"id":"seytek-2012:p1149:b003:l008","ordinal":385176,"en":"Turned his neck toward the foe."},{"id":"seytek-2012:p1149:b003:l009","ordinal":385177,"en":"With a stout shaft and keen point,"},{"id":"seytek-2012:p1149:b003:l010","ordinal":385178,"en":"The tasselled Syr spear—"},{"id":"seytek-2012:p1149:b003:l011","ordinal":385179,"en":"“Creator, grant me passage!” he cried,"},{"id":"seytek-2012:p1149:b003:l012","ordinal":385180,"en":"And straight at great Bilgich"},{"id":"seytek-2012:p1149:b003:l013","ordinal":385181,"en":"He thrust it with a thunderous roar."},{"id":"seytek-2012:p1149:b003:l014","ordinal":385182,"en":"His eyes blazed like a lion’s;"},{"id":"seytek-2012:p1149:b003:l015","ordinal":385183,"en":"His broad white teeth seemed set like stakes,"},{"id":"seytek-2012:p1149:b003:l016","ordinal":385184,"en":"Teeth worthy of royal blood,"},{"id":"seytek-2012:p1149:b003:l017","ordinal":385185,"en":"And he ground them section by section."},{"id":"seytek-2012:p1149:b003:l018","ordinal":385186,"en":"He roused a terrible rage,"},{"id":"seytek-2012:p1149:b003:l019","ordinal":385187,"en":"Counting his precious life as a hair,"},{"id":"seytek-2012:p1149:b003:l020","ordinal":385188,"en":"And launched a furious assault,"},{"id":"seytek-2012:p1149:b003:l021","ordinal":385189,"en":"Hurling the spear with all his strength."},{"id":"seytek-2012:p1149:b003:l022","ordinal":385190,"en":"At the bristling boar"},{"id":"seytek-2012:p1149:b003:l023","ordinal":385191,"en":"Before he could truly reach Joltoy,"},{"id":"seytek-2012:p1149:b003:l024","ordinal":385192,"en":"He aimed for the face of the elbow,"},{"id":"seytek-2012:p1149:b003:l025","ordinal":385193,"en":"The very brink of waiting death,"},{"id":"seytek-2012:p1149:b003:l026","ordinal":385194,"en":"Between the lungs and heart,"},{"id":"seytek-2012:p1149:b003:l027","ordinal":385195,"en":"The measured mark of mortal doom,"},{"id":"seytek-2012:p1149:b003:l028","ordinal":385196,"en":"Level with the ribs:"},{"id":"seytek-2012:p1149:b003:l029","ordinal":385197,"en":"“If I strike him exactly here, I have him!”"},{"id":"seytek-2012:p1149:b003:l030","ordinal":385198,"en":"He chose the mortal spot,"},{"id":"seytek-2012:p1149:b003:l031","ordinal":385199,"en":"Lashed Kulunsur with the whip,"},{"id":"seytek-2012:p1149:b003:l032","ordinal":385200,"en":"And before that hulking champion"},{"id":"seytek-2012:p1149:b003:l033","ordinal":385201,"en":"Could reach the hero Joltoy,"},{"id":"seytek-2012:p1149:b003:l034","ordinal":385202,"en":"The peerless warrior struck Bilgich"},{"id":"seytek-2012:p1149:b003:l035","ordinal":385203,"en":"With his spear."},{"id":"seytek-2012:p1149:b003:l036","ordinal":385204,"en":"His senses failed and his strength ebbed;"},{"id":"seytek-2012:p1149:b003:l037","ordinal":385205,"en":"At that moment great Bilgich"},{"id":"seytek-2012:p1149:b003:l038","ordinal":385206,"en":"Reeled unconscious and bewildered."},{"id":"seytek-2012:p1149:b003:l039","ordinal":385207,"en":"What could poor Bilgich do?"},{"id":"seytek-2012:p1149:b003:l040","ordinal":385208,"en":"Unable to achieve his aim,"},{"id":"seytek-2012:p1150:b002:l001","ordinal":385209,"en":"Though Akjoltoy was his chosen target,"},{"id":"seytek-2012:p1150:b002:l002","ordinal":385210,"en":"He could not kill him and ride away;"},{"id":"seytek-2012:p1150:b002:l003","ordinal":385211,"en":"Seytek struck him with the spear,"},{"id":"seytek-2012:p1150:b002:l004","ordinal":385212,"en":"And when Seytek’s spear struck,"},{"id":"seytek-2012:p1150:b002:l005","ordinal":385213,"en":"He fell backward from the saddle,"},{"id":"seytek-2012:p1150:b002:l006","ordinal":385214,"en":"His feet slipped from the stirrups,"},{"id":"seytek-2012:p1150:b002:l007","ordinal":385215,"en":"And both his legs dangled loose."},{"id":"seytek-2012:p1150:b002:l008","ordinal":385216,"en":"As though something now seized his skirts,"},{"id":"seytek-2012:p1150:b002:l009","ordinal":385217,"en":"His two eyes rolled wildly."},{"id":"seytek-2012:p1150:b002:l010","ordinal":385218,"en":"His surging courage vanished,"},{"id":"seytek-2012:p1150:b002:l011","ordinal":385219,"en":"His frenzy crumbled and was quelled;"},{"id":"seytek-2012:p1150:b002:l012","ordinal":385220,"en":"He had collided with brave Seytek"},{"id":"seytek-2012:p1150:b002:l013","ordinal":385221,"en":"And made ready to flee."},{"id":"seytek-2012:p1150:b002:l014","ordinal":385222,"en":"That roaring boar—"},{"id":"seytek-2012:p1150:b002:l015","ordinal":385223,"en":"Where now had all his fury gone?"},{"id":"seytek-2012:p1150:b002:l016","ordinal":385224,"en":"When champion meets champion,"},{"id":"seytek-2012:p1150:b002:l017","ordinal":385225,"en":"Both men’s legs begin to twitch;"},{"id":"seytek-2012:p1150:b002:l018","ordinal":385226,"en":"When one tongue answers another,"},{"id":"seytek-2012:p1150:b002:l019","ordinal":385227,"en":"The hinges of their jaws begin to quiver."},{"id":"seytek-2012:p1150:b002:l020","ordinal":385228,"en":"Bilgich’s spirit nearly left him;"},{"id":"seytek-2012:p1150:b002:l021","ordinal":385229,"en":"The falsehood of this accursed world"},{"id":"seytek-2012:p1150:b002:l022","ordinal":385230,"en":"Was laid bare before him."},{"id":"seytek-2012:p1150:b002:l023","ordinal":385231,"en":"Bilgich despaired of life,"},{"id":"seytek-2012:p1150:b002:l024","ordinal":385232,"en":"All strength deserted the warrior,"},{"id":"seytek-2012:p1150:b002:l025","ordinal":385233,"en":"Blood poured from his side,"},{"id":"seytek-2012:p1150:b002:l026","ordinal":385234,"en":"And grievous was his wound."},{"id":"seytek-2012:p1150:b002:l027","ordinal":385235,"en":"Unable to gain his desire,"},{"id":"seytek-2012:p1150:b002:l028","ordinal":385236,"en":"His reins cut through together,"},{"id":"seytek-2012:p1150:b002:l029","ordinal":385237,"en":"He had collided with a leopard of a hero,"},{"id":"seytek-2012:p1150:b002:l030","ordinal":385238,"en":"Encountered a man of majesty,"},{"id":"seytek-2012:p1150:b002:l031","ordinal":385239,"en":"And fallen upon a wrathful foe."},{"id":"seytek-2012:p1150:b002:l032","ordinal":385240,"en":"His horse was swift and huge,"},{"id":"seytek-2012:p1150:b002:l033","ordinal":385241,"en":"The winged gray Kerik;"},{"id":"seytek-2012:p1150:b002:l034","ordinal":385242,"en":"No wind could match him at a trot,"},{"id":"seytek-2012:p1150:b002:l035","ordinal":385243,"en":"No beast could match him at a walk."},{"id":"seytek-2012:p1150:b002:l036","ordinal":385244,"en":"A message had been tied to his tail:"},{"id":"seytek-2012:p1150:b002:l037","ordinal":385245,"en":"“He will catch whatever man he pursues”—"},{"id":"seytek-2012:p1150:b002:l038","ordinal":385246,"en":"And so they named him Gray Kerik."},{"id":"seytek-2012:p1150:b002:l039","ordinal":385247,"en":"Gray Kerik, bred for battle,"},{"id":"seytek-2012:p1150:b002:l040","ordinal":385248,"en":"Could halt atop a mountain;"},{"id":"seytek-2012:p1150:b003:l001","ordinal":385249,"en":"For nine full years they had watched him,"},{"id":"seytek-2012:p1150:b003:l002","ordinal":385250,"en":"Letting him graze untouched by tether."},{"id":"seytek-2012:p1150:b003:l003","ordinal":385251,"en":"They had raised him in darkness,"},{"id":"seytek-2012:p1150:b003:l004","ordinal":385252,"en":"And Niyanker, whose eye was keen,"},{"id":"seytek-2012:p1150:b003:l005","ordinal":385253,"en":"Had approved him as a master judge of horses."},{"id":"seytek-2012:p1150:b003:l006","ordinal":385254,"en":"Carrying Bilgich off,"},{"id":"seytek-2012:p1150:b003:l007","ordinal":385255,"en":"He sped toward the Khagan."},{"id":"seytek-2012:p1150:b003:l008","ordinal":385256,"en":"Over ridge after ridge,"},{"id":"seytek-2012:p1150:b003:l009","ordinal":385257,"en":"Through gaping valley lands,"},{"id":"seytek-2012:p1150:b003:l010","ordinal":385258,"en":"Skirting Imerchik,"},{"id":"seytek-2012:p1150:b003:l011","ordinal":385259,"en":"Across Kürküldök’s gray plain,"},{"id":"seytek-2012:p1150:b003:l012","ordinal":385260,"en":"And farther down the road he roamed,"},{"id":"seytek-2012:p1150:b003:l013","ordinal":385261,"en":"Fleeing all alone."},{"id":"seytek-2012:p1150:b003:l014","ordinal":385262,"en":"Seytek was a reckless, simple-hearted hero;"},{"id":"seytek-2012:p1150:b003:l015","ordinal":385263,"en":"He knew nothing of this,"},{"id":"seytek-2012:p1150:b003:l016","ordinal":385264,"en":"Nor did brave Seytek know"},{"id":"seytek-2012:p1150:b003:l017","ordinal":385265,"en":"How many perils lay in Beijing."},{"id":"seytek-2012:p1150:b003:l018","ordinal":385266,"en":"There were countless excavated pits"},{"id":"seytek-2012:p1150:b003:l019","ordinal":385267,"en":"And misery for any who encountered them;"},{"id":"seytek-2012:p1150:b003:l020","ordinal":385268,"en":"That scorched boar"},{"id":"seytek-2012:p1150:b003:l021","ordinal":385269,"en":"Had troops stationed in the trenches,"},{"id":"seytek-2012:p1150:b003:l022","ordinal":385270,"en":"His venom lay in many places,"},{"id":"seytek-2012:p1150:b003:l023","ordinal":385271,"en":"His infernal wrath was stored in ambush,"},{"id":"seytek-2012:p1150:b003:l024","ordinal":385272,"en":"And the overthrown Bilgich"},{"id":"seytek-2012:p1150:b003:l025","ordinal":385273,"en":"Still possessed all his cunning."},{"id":"seytek-2012:p1150:b003:l026","ordinal":385274,"en":"There were sentries and boundaries,"},{"id":"seytek-2012:p1150:b003:l027","ordinal":385275,"en":"And warriors stationed at every frontier;"},{"id":"seytek-2012:p1150:b003:l028","ordinal":385276,"en":"Words would fail if all were told—"},{"id":"seytek-2012:p1150:b003:l029","ordinal":385277,"en":"That accursed one had many stratagems,"},{"id":"seytek-2012:p1150:b003:l030","ordinal":385278,"en":"Every kind of calamity was there."},{"id":"seytek-2012:p1150:b003:l031","ordinal":385279,"en":"Knowing nothing of those dangers,"},{"id":"seytek-2012:p1150:b003:l032","ordinal":385280,"en":"With skirts loose and breast exposed,"}]
