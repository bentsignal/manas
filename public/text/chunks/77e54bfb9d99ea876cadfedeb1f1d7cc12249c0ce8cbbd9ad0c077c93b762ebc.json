[{"id":"manas-2010:p1373:b001:l004","ordinal":59393,"en":"Of the stone-badged Chinese,"},{"id":"manas-2010:p1373:b001:l005","ordinal":59394,"en":"Dressed like the finest among them,"},{"id":"manas-2010:p1373:b001:l006","ordinal":59395,"en":"Reached the lama."},{"id":"manas-2010:p1373:b001:l007","ordinal":59396,"en":"The moment he arrived, Almambet,"},{"id":"manas-2010:p1373:b001:l008","ordinal":59397,"en":"From atop Kartküröng,"},{"id":"manas-2010:p1373:b001:l009","ordinal":59398,"en":"Thrust him down as he passed."},{"id":"manas-2010:p1373:b001:l010","ordinal":59399,"en":"Taking his battle-axe in hand,"},{"id":"manas-2010:p1373:b001:l011","ordinal":59400,"en":"Syrgak the lion arrived."},{"id":"manas-2010:p1373:b001:l012","ordinal":59401,"en":"As soon as he reached him, into five pieces,"},{"id":"manas-2010:p1373:b001:l013","ordinal":59402,"en":"That Kalmyk lama,"},{"id":"manas-2010:p1373:b001:l014","ordinal":59403,"en":"He hewed apart as he passed."},{"id":"manas-2010:p1373:b001:l015","ordinal":59404,"en":"Without letting the banner touch the ground,"},{"id":"manas-2010:p1373:b001:l016","ordinal":59405,"en":"The accomplished, mighty Almambet,"},{"id":"manas-2010:p1373:b001:l017","ordinal":59406,"en":"Whipping Sarala,"},{"id":"manas-2010:p1373:b001:l018","ordinal":59407,"en":"Carried it away as he passed."},{"id":"manas-2010:p1373:b001:l019","ordinal":59408,"en":"Separating, alone along the road,"},{"id":"manas-2010:p1373:b001:l020","ordinal":59409,"en":"Heading toward Beijing,"},{"id":"manas-2010:p1373:b001:l021","ordinal":59410,"en":"Raising the red standard,"},{"id":"manas-2010:p1373:b001:l022","ordinal":59411,"en":"Speaking Kalmyk with a rattle,"},{"id":"manas-2010:p1373:b001:l023","ordinal":59412,"en":"Babbling away in Chinese,"},{"id":"manas-2010:p1373:b001:l024","ordinal":59413,"en":"When your Almambet fled,"},{"id":"manas-2010:p1373:b001:l025","ordinal":59414,"en":"When he used this stratagem,"},{"id":"manas-2010:p1373:b001:l026","ordinal":59415,"en":"Unable to gather their iron net,"},{"id":"manas-2010:p1373:b001:l027","ordinal":59416,"en":"The Chinese and many Manchu,"},{"id":"manas-2010:p1373:b001:l028","ordinal":59417,"en":"Unable to fight the campaign as equals,"},{"id":"manas-2010:p1373:b001:l029","ordinal":59418,"en":"Dust billowing toward the sky,"},{"id":"manas-2010:p1373:b001:l030","ordinal":59419,"en":"The teeming Chinese and many Manchu,"},{"id":"manas-2010:p1373:b001:l031","ordinal":59420,"en":"All of them fled."},{"id":"manas-2010:p1373:b001:l032","ordinal":59421,"en":"Behind the fleeing standard,"},{"id":"manas-2010:p1373:b001:l033","ordinal":59422,"en":"They surged toward Beijing."},{"id":"manas-2010:p1373:b001:l034","ordinal":59423,"en":"So many ravines,"},{"id":"manas-2010:p1373:b001:l035","ordinal":59424,"en":"The Chinese crossed as they went."},{"id":"manas-2010:p1373:b001:l036","ordinal":59425,"en":"Fighting like dogs,"},{"id":"manas-2010:p1373:b001:l037","ordinal":59426,"en":"The Chinese fled onward."},{"id":"manas-2010:p1373:b001:l038","ordinal":59427,"en":"When the Chinese fled,"},{"id":"manas-2010:p1373:b001:l039","ordinal":59428,"en":"Is a fleeing enemy not a woman?"},{"id":"manas-2010:p1373:b001:l040","ordinal":59429,"en":"Would Manas stand and watch?"},{"id":"manas-2010:p1373:b001:l041","ordinal":59430,"en":"Charging from behind,"},{"id":"manas-2010:p1373:b001:l042","ordinal":59431,"en":"Mighty Manas drove them onward."},{"id":"manas-2010:p1374:b001:l001","ordinal":59432,"en":"“The many Chinese in Kangay,"},{"id":"manas-2010:p1374:b001:l002","ordinal":59433,"en":"Unless I drive them all the way to Beijing,"},{"id":"manas-2010:p1374:b001:l003","ordinal":59434,"en":"Leveling spears, shattering mountains,"},{"id":"manas-2010:p1374:b001:l004","ordinal":59435,"en":"If death comes, falling to a bullet,"},{"id":"manas-2010:p1374:b001:l005","ordinal":59436,"en":"Crimson dresses, languishing eyes,"},{"id":"manas-2010:p1374:b001:l006","ordinal":59437,"en":"Their surpassingly beautiful girls,"},{"id":"manas-2010:p1374:b001:l007","ordinal":59438,"en":"Unless I give them to the troops,"},{"id":"manas-2010:p1374:b001:l008","ordinal":59439,"en":"The gold coins and rubies,"},{"id":"manas-2010:p1374:b001:l009","ordinal":59440,"en":"To this great army that has come,"},{"id":"manas-2010:p1374:b001:l010","ordinal":59441,"en":"As spoils to everyone,"},{"id":"manas-2010:p1374:b001:l011","ordinal":59442,"en":"Unless I divide them, measured by the whip!”"},{"id":"manas-2010:p1374:b001:l012","ordinal":59443,"en":"Wrathful Khan Manas"},{"id":"manas-2010:p1374:b001:l013","ordinal":59444,"en":"Was hemming them in."},{"id":"manas-2010:p1374:b001:l014","ordinal":59445,"en":"Around their edges, warrior Chubak"},{"id":"manas-2010:p1374:b001:l015","ordinal":59446,"en":"Was driving them."},{"id":"manas-2010:p1374:b001:l016","ordinal":59447,"en":"One flank, Khan Bakay"},{"id":"manas-2010:p1374:b001:l017","ordinal":59448,"en":"Pushed and drove onward."},{"id":"manas-2010:p1374:b001:l018","ordinal":59449,"en":"Leaving not one behind,"},{"id":"manas-2010:p1374:b001:l019","ordinal":59450,"en":"Like jackdaws struck by a falcon,"},{"id":"manas-2010:p1374:b001:l020","ordinal":59451,"en":"Going out on that side,"},{"id":"manas-2010:p1374:b001:l021","ordinal":59452,"en":"Charging from this side,"},{"id":"manas-2010:p1374:b001:l022","ordinal":59453,"en":"The teeming Chinese, the vast army,"},{"id":"manas-2010:p1374:b001:l023","ordinal":59454,"en":"He pushed onward."},{"id":"manas-2010:p1374:b001:l024","ordinal":59455,"en":"When they pressed in from behind,"},{"id":"manas-2010:p1374:b001:l025","ordinal":59456,"en":"To the kakan's Beijing,"},{"id":"manas-2010:p1374:b001:l026","ordinal":59457,"en":"Making the Chinese cry out,"},{"id":"manas-2010:p1374:b001:l027","ordinal":59458,"en":"That was where they slaughtered, destroyed and drove them,"},{"id":"manas-2010:p1374:b001:l028","ordinal":59459,"en":"Where they spilled the Chinese blood,"},{"id":"manas-2010:p1374:b001:l029","ordinal":59460,"en":"Where they opened the Kyrgyz way!"},{"id":"manas-2010:p1374:b001:l030","ordinal":59461,"en":"Unable to turn and fight,"},{"id":"manas-2010:p1374:b001:l031","ordinal":59462,"en":"Against the Kyrgyz, resistance,"},{"id":"manas-2010:p1374:b001:l032","ordinal":59463,"en":"The many Chinese could not offer."},{"id":"manas-2010:p1374:b001:l033","ordinal":59464,"en":"Toward the kakan's Beijing,"},{"id":"manas-2010:p1374:b001:l034","ordinal":59465,"en":"Their mighty army crying out,"},{"id":"manas-2010:p1374:b001:l035","ordinal":59466,"en":"That was where they all fled together."},{"id":"manas-2010:p1374:b001:l036","ordinal":59467,"en":"The plain filled with the dead;"},{"id":"manas-2010:p1374:b001:l037","ordinal":59468,"en":"Many coursers were left riderless."},{"id":"manas-2010:p1374:b001:l038","ordinal":59469,"en":"The vast Chinese host,"},{"id":"manas-2010:p1374:b001:l039","ordinal":59470,"en":"Warrior Manas, taking heart,"},{"id":"manas-2010:p1374:b001:l040","ordinal":59471,"en":"When he drove and pushed them onward,"},{"id":"manas-2010:p1374:b001:l041","ordinal":59472,"en":"Kongurbay of the Chinese,"},{"id":"manas-2010:p1374:b001:l042","ordinal":59473,"en":"Blocking Manas from the front,"},{"id":"manas-2010:p1375:b001:l001","ordinal":59474,"en":"Came out to confront him then."},{"id":"manas-2010:p1375:b001:l002","ordinal":59475,"en":"Cotton sash, wide boots,"},{"id":"manas-2010:p1375:b001:l003","ordinal":59476,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1375:b001:l004","ordinal":59477,"en":"A stately champion warrior,"},{"id":"manas-2010:p1375:b001:l005","ordinal":59478,"en":"A fellow skilled in spearing,"},{"id":"manas-2010:p1375:b001:l006","ordinal":59479,"en":"A mighty fellow who knew the enemy's ways,"},{"id":"manas-2010:p1375:b001:l007","ordinal":59480,"en":"Coming before Manas,"},{"id":"manas-2010:p1375:b001:l008","ordinal":59481,"en":"Unable to turn Algara's head,"},{"id":"manas-2010:p1375:b001:l009","ordinal":59482,"en":"The wolf-maned one of surpassing might,"},{"id":"manas-2010:p1375:b001:l010","ordinal":59483,"en":"Unable to stand confronting him,"},{"id":"manas-2010:p1375:b001:l011","ordinal":59484,"en":"Unable to shout and level his spear,"},{"id":"manas-2010:p1375:b001:l012","ordinal":59485,"en":"Unable to offer the smallest resistance,"},{"id":"manas-2010:p1375:b001:l013","ordinal":59486,"en":"Devising a plan, Kongurbay,"},{"id":"manas-2010:p1375:b001:l014","ordinal":59487,"en":"A ridge like a saddle's back,"},{"id":"manas-2010:p1375:b001:l015","ordinal":59488,"en":"He crossed it, did you see?"},{"id":"manas-2010:p1375:b001:l016","ordinal":59489,"en":"When he saw Manas's wrath,"},{"id":"manas-2010:p1375:b001:l017","ordinal":59490,"en":"Kongurbay grew alarmed."},{"id":"manas-2010:p1375:b001:l018","ordinal":59491,"en":"Bolting toward Beijing,"},{"id":"manas-2010:p1375:b001:l019","ordinal":59492,"en":"Kongurbay fled."},{"id":"manas-2010:p1375:b001:l020","ordinal":59493,"en":"When he saw warrior Kalcha,"},{"id":"manas-2010:p1375:b001:l021","ordinal":59494,"en":"He did not lose his wits;"},{"id":"manas-2010:p1375:b001:l022","ordinal":59495,"en":"Manas did not stand holding back."},{"id":"manas-2010:p1375:b001:l023","ordinal":59496,"en":"Flame came from his mouth;"},{"id":"manas-2010:p1375:b001:l024","ordinal":59497,"en":"Fire poured from his eyes."},{"id":"manas-2010:p1375:b001:l025","ordinal":59498,"en":"Driving him before him in pursuit,"},{"id":"manas-2010:p1375:b001:l026","ordinal":59499,"en":"He went racing onward."},{"id":"manas-2010:p1375:b001:l027","ordinal":59500,"en":"Separating from the army, grappling,"},{"id":"manas-2010:p1375:b001:l028","ordinal":59501,"en":"So many ridges,"},{"id":"manas-2010:p1375:b001:l029","ordinal":59502,"en":"Kongurbay crossed onward."},{"id":"manas-2010:p1375:b001:l030","ordinal":59503,"en":"Flustered before Manas,"},{"id":"manas-2010:p1375:b001:l031","ordinal":59504,"en":"Kongurbay hurried onward."},{"id":"manas-2010:p1375:b001:l032","ordinal":59505,"en":"If you looked where he fled,"},{"id":"manas-2010:p1375:b001:l033","ordinal":59506,"en":"There were ridges, hill after hill."},{"id":"manas-2010:p1375:b001:l034","ordinal":59507,"en":"Beyond that ridge,"},{"id":"manas-2010:p1375:b001:l035","ordinal":59508,"en":"There was a desert forty days across."},{"id":"manas-2010:p1375:b001:l036","ordinal":59509,"en":"When a swan flew, its wings,"},{"id":"manas-2010:p1375:b001:l037","ordinal":59510,"en":"When a wild ass walked, its hooves,"},{"id":"manas-2010:p1375:b001:l038","ordinal":59511,"en":"Would burn in that desert."},{"id":"manas-2010:p1375:b001:l039","ordinal":59512,"en":"There was not a drop of water,"},{"id":"manas-2010:p1375:b001:l040","ordinal":59513,"en":"No grass to nibble a pinch of."},{"id":"manas-2010:p1375:b001:l041","ordinal":59514,"en":"Hazy, jutting in corners,"},{"id":"manas-2010:p1375:b001:l042","ordinal":59515,"en":"Dim, tapering into points,"},{"id":"manas-2010:p1376:b001:l001","ordinal":59516,"en":"He fled onto that ground."},{"id":"manas-2010:p1376:b001:l002","ordinal":59517,"en":"When he saw Akkula,"},{"id":"manas-2010:p1376:b001:l003","ordinal":59518,"en":"Kongurbay lost his wits;"},{"id":"manas-2010:p1376:b001:l004","ordinal":59519,"en":"Now he fled in earnest."},{"id":"manas-2010:p1376:b001:l005","ordinal":59520,"en":"When they took the downhill road,"},{"id":"manas-2010:p1376:b001:l006","ordinal":59521,"en":"Kongurbay's Algara"},{"id":"manas-2010:p1376:b001:l007","ordinal":59522,"en":"Had a neck that bulged like a bull's;"},{"id":"manas-2010:p1376:b001:l008","ordinal":59523,"en":"When they came against a rise,"},{"id":"manas-2010:p1376:b001:l009","ordinal":59524,"en":"Khan Manas's Akkula"},{"id":"manas-2010:p1376:b001:l010","ordinal":59525,"en":"Had eyes that flashed like flint."},{"id":"manas-2010:p1376:b001:l011","ordinal":59526,"en":"When they went downhill,"},{"id":"manas-2010:p1376:b001:l012","ordinal":59527,"en":"Kongurbay's Algara"},{"id":"manas-2010:p1376:b001:l013","ordinal":59528,"en":"Planted his forelegs like a roe deer;"},{"id":"manas-2010:p1376:b001:l014","ordinal":59529,"en":"When they reached rising ground,"},{"id":"manas-2010:p1376:b001:l015","ordinal":59530,"en":"Khan Manas's Akkula"},{"id":"manas-2010:p1376:b001:l016","ordinal":59531,"en":"Spread out his mane and tail."},{"id":"manas-2010:p1376:b001:l017","ordinal":59532,"en":"When they came to the steep descent,"},{"id":"manas-2010:p1376:b001:l018","ordinal":59533,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1376:b001:l019","ordinal":59534,"en":"Drew far away like a mirage;"},{"id":"manas-2010:p1376:b001:l020","ordinal":59535,"en":"When they reached rising ground,"},{"id":"manas-2010:p1376:b001:l021","ordinal":59536,"en":"Khan Manas, as of old,"},{"id":"manas-2010:p1376:b001:l022","ordinal":59537,"en":"Closed in upon his heels."},{"id":"manas-2010:p1376:b001:l023","ordinal":59538,"en":"When Manas pressed upon his heels,"},{"id":"manas-2010:p1376:b001:l024","ordinal":59539,"en":"Alöökö's Kongurbay"},{"id":"manas-2010:p1376:b001:l025","ordinal":59540,"en":"Gave up all hope of life;"},{"id":"manas-2010:p1376:b001:l026","ordinal":59541,"en":"At Algara beneath him,"},{"id":"manas-2010:p1376:b001:l027","ordinal":59542,"en":"Kongurbay, in his panic,"},{"id":"manas-2010:p1376:b001:l028","ordinal":59543,"en":"Lashed this way and that,"},{"id":"manas-2010:p1376:b001:l029","ordinal":59544,"en":"Spurring right and left;"},{"id":"manas-2010:p1376:b001:l030","ordinal":59545,"en":"Across so many deserts and slopes"},{"id":"manas-2010:p1376:b001:l031","ordinal":59546,"en":"He fled over the heights."},{"id":"manas-2010:p1376:b001:l032","ordinal":59547,"en":"When Manas drew near,"},{"id":"manas-2010:p1376:b001:l033","ordinal":59548,"en":"Despairing of his precious life,"},{"id":"manas-2010:p1376:b001:l034","ordinal":59549,"en":"He fled away in haste."},{"id":"manas-2010:p1376:b001:l035","ordinal":59550,"en":"When Kalcha looked behind him,"},{"id":"manas-2010:p1376:b001:l036","ordinal":59551,"en":"Khan Manas's Akkula"},{"id":"manas-2010:p1376:b001:l037","ordinal":59552,"en":"Was bounding, gathering himself,"},{"id":"manas-2010:p1376:b001:l038","ordinal":59553,"en":"Running as though somersaulting,"},{"id":"manas-2010:p1376:b001:l039","ordinal":59554,"en":"His neck curved like a gun's hammer,"},{"id":"manas-2010:p1376:b001:l040","ordinal":59555,"en":"Throwing his forelock at the sky,"},{"id":"manas-2010:p1376:b001:l041","ordinal":59556,"en":"Driving his hooves into the ground,"},{"id":"manas-2010:p1376:b001:l042","ordinal":59557,"en":"Clattering his bit,"},{"id":"manas-2010:p1377:b001:l001","ordinal":59558,"en":"His tail like strands of silk"},{"id":"manas-2010:p1377:b001:l002","ordinal":59559,"en":"Lashing against his groin,"},{"id":"manas-2010:p1377:b001:l003","ordinal":59560,"en":"His soles thundering on the ground,"},{"id":"manas-2010:p1377:b001:l004","ordinal":59561,"en":"The black steel bit"},{"id":"manas-2010:p1377:b001:l005","ordinal":59562,"en":"Clanging in his throat,"},{"id":"manas-2010:p1377:b001:l006","ordinal":59563,"en":"His mouth gaping like a chasm,"},{"id":"manas-2010:p1377:b001:l007","ordinal":59564,"en":"White foam mixed with blood"},{"id":"manas-2010:p1377:b001:l008","ordinal":59565,"en":"Spraying across his chest."},{"id":"manas-2010:p1377:b001:l009","ordinal":59566,"en":"He had lowered his head to earth;"},{"id":"manas-2010:p1377:b001:l010","ordinal":59567,"en":"Pitching forward, covering the ground,"},{"id":"manas-2010:p1377:b001:l011","ordinal":59568,"en":"His flesh had grown hot."},{"id":"manas-2010:p1377:b001:l012","ordinal":59569,"en":"Manas, heavy as lead,"},{"id":"manas-2010:p1377:b001:l013","ordinal":59570,"en":"He carried like a pellet of dung;"},{"id":"manas-2010:p1377:b001:l014","ordinal":59571,"en":"Manas, like an immense mountain,"},{"id":"manas-2010:p1377:b001:l015","ordinal":59572,"en":"He carried like a vertebra."},{"id":"manas-2010:p1377:b001:l016","ordinal":59573,"en":"The stones he trod on crumbled;"},{"id":"manas-2010:p1377:b001:l017","ordinal":59574,"en":"Speeding like a flying bird,"},{"id":"manas-2010:p1377:b001:l018","ordinal":59575,"en":"He came with a ringing neigh."},{"id":"manas-2010:p1377:b001:l019","ordinal":59576,"en":"Manas upon his back"},{"id":"manas-2010:p1377:b001:l020","ordinal":59577,"en":"Had eyes that blazed like fire;"},{"id":"manas-2010:p1377:b001:l021","ordinal":59578,"en":"His thirst to drink blood had seized him."},{"id":"manas-2010:p1377:b001:l022","ordinal":59579,"en":"Seeing him in such a state,"},{"id":"manas-2010:p1377:b001:l023","ordinal":59580,"en":"That he had gathered his strength"},{"id":"manas-2010:p1377:b001:l024","ordinal":59581,"en":"Kalcha knew for certain;"},{"id":"manas-2010:p1377:b001:l025","ordinal":59582,"en":"Without sparing his own life,"},{"id":"manas-2010:p1377:b001:l026","ordinal":59583,"en":"Kongurbay fled away;"},{"id":"manas-2010:p1377:b001:l027","ordinal":59584,"en":"Across slopes no dog would walk, many ridges,"},{"id":"manas-2010:p1377:b001:l028","ordinal":59585,"en":"Kongurbay fled with him in pursuit."},{"id":"manas-2010:p1377:b001:l029","ordinal":59586,"en":"“Through Esenkan’s gate,"},{"id":"manas-2010:p1377:b001:l030","ordinal":59587,"en":"If I can somehow flee inside,” he thought;"},{"id":"manas-2010:p1377:b001:l031","ordinal":59588,"en":"Kongurbay sped away."},{"id":"manas-2010:p1377:b001:l032","ordinal":59589,"en":"Until he reached the gate,"},{"id":"manas-2010:p1377:b001:l033","ordinal":59590,"en":"There was a six-day journey,"},{"id":"manas-2010:p1377:b001:l034","ordinal":59591,"en":"There were those many little ridges;"},{"id":"manas-2010:p1377:b001:l035","ordinal":59592,"en":"It was the ground where Algara"},{"id":"manas-2010:p1377:b001:l036","ordinal":59593,"en":"Had grown up playing as a foal,"},{"id":"manas-2010:p1377:b001:l037","ordinal":59594,"en":"The ground he knew so well."},{"id":"manas-2010:p1377:b001:l038","ordinal":59595,"en":"The black horse Kalcha rode"},{"id":"manas-2010:p1377:b001:l039","ordinal":59596,"en":"Was a beast apart from other creatures,"},{"id":"manas-2010:p1377:b001:l040","ordinal":59597,"en":"With wings upon his sides;"},{"id":"manas-2010:p1377:b001:l041","ordinal":59598,"en":"Unless death came from Allah,"},{"id":"manas-2010:p1377:b001:l042","ordinal":59599,"en":"Unless his forelegs broke,"},{"id":"manas-2010:p1378:b001:l001","ordinal":59600,"en":"Whenever it might be, Kalcha"},{"id":"manas-2010:p1378:b001:l002","ordinal":59601,"en":"He was accustomed to save."},{"id":"manas-2010:p1378:b001:l003","ordinal":59602,"en":"Stubbornly pursuing him,"},{"id":"manas-2010:p1378:b001:l004","ordinal":59603,"en":"Readying and swinging his spear,"},{"id":"manas-2010:p1378:b001:l005","ordinal":59604,"en":"“Let me catch and stab the wretch!”"},{"id":"manas-2010:p1378:b001:l006","ordinal":59605,"en":"Warrior Manas gave chase."},{"id":"manas-2010:p1378:b001:l007","ordinal":59606,"en":"When they reached level ground,"},{"id":"manas-2010:p1378:b001:l008","ordinal":59607,"en":"Right at the hem of his coat"},{"id":"manas-2010:p1378:b001:l009","ordinal":59608,"en":"Warrior Manas meant to seize Kalcha."},{"id":"manas-2010:p1378:b001:l010","ordinal":59609,"en":"Chalkak-Bel, of shifting sand:"},{"id":"manas-2010:p1378:b001:l011","ordinal":59610,"en":"As they approached Chalkak-Bel,"},{"id":"manas-2010:p1378:b001:l012","ordinal":59611,"en":"Akkula drew alongside;"},{"id":"manas-2010:p1378:b001:l013","ordinal":59612,"en":"As he was passing Algara,"},{"id":"manas-2010:p1378:b001:l014","ordinal":59613,"en":"Your lion Manas cried out"},{"id":"manas-2010:p1378:b001:l015","ordinal":59614,"en":"And raised his lacquered spear."},{"id":"manas-2010:p1378:b001:l016","ordinal":59615,"en":"From the shifting sands of Chalkak,"},{"id":"manas-2010:p1378:b001:l017","ordinal":59616,"en":"Kalcha ducked and darted downhill."},{"id":"manas-2010:p1378:b001:l018","ordinal":59617,"en":"From this side warrior Manas,"},{"id":"manas-2010:p1378:b001:l019","ordinal":59618,"en":"“The edge of his right shoulder blade,"},{"id":"manas-2010:p1378:b001:l020","ordinal":59619,"en":"The side of his lungs and liver!” he said,"},{"id":"manas-2010:p1378:b001:l021","ordinal":59620,"en":"And struck once with his spear."},{"id":"manas-2010:p1378:b001:l022","ordinal":59621,"en":"Not letting the spear touch his body,"},{"id":"manas-2010:p1378:b001:l023","ordinal":59622,"en":"Kalcha was indeed a warrior;"},{"id":"manas-2010:p1378:b001:l024","ordinal":59623,"en":"Drawing and swinging Arkesken,"},{"id":"manas-2010:p1378:b001:l025","ordinal":59624,"en":"The generous one's spear,"},{"id":"manas-2010:p1378:b001:l026","ordinal":59625,"en":"Kongurbay, through its middle,"},{"id":"manas-2010:p1378:b001:l027","ordinal":59626,"en":"Chopped clean in two."},{"id":"manas-2010:p1378:b001:l028","ordinal":59627,"en":"A warrior skilled among spearmen,"},{"id":"manas-2010:p1378:b001:l029","ordinal":59628,"en":"In the hour of danger"},{"id":"manas-2010:p1378:b001:l030","ordinal":59629,"en":"A mighty warrior who knew the enemy's tricks."},{"id":"manas-2010:p1378:b001:l031","ordinal":59630,"en":"“The leopard's Akkula"},{"id":"manas-2010:p1378:b001:l032","ordinal":59631,"en":"Is a horse born of the unseen world."},{"id":"manas-2010:p1378:b001:l033","ordinal":59632,"en":"Will he catch up?” he thought."},{"id":"manas-2010:p1378:b001:l034","ordinal":59633,"en":"“Somehow I cut his spear;"},{"id":"manas-2010:p1378:b001:l035","ordinal":59634,"en":"Now will this Manas catch up"},{"id":"manas-2010:p1378:b001:l036","ordinal":59635,"en":"And seize me?” he thought."},{"id":"manas-2010:p1378:b001:l037","ordinal":59636,"en":"“If he seizes me, Manas will show no mercy;"},{"id":"manas-2010:p1378:b001:l038","ordinal":59637,"en":"Wretched days, he will not leave me alive."},{"id":"manas-2010:p1378:b001:l039","ordinal":59638,"en":"If I happen to fall into his hands,"},{"id":"manas-2010:p1378:b001:l040","ordinal":59639,"en":"Will he rip my belly open?"},{"id":"manas-2010:p1378:b001:l041","ordinal":59640,"en":"Will the red blood inside me"},{"id":"manas-2010:p1378:b001:l042","ordinal":59641,"en":"Flow out like water?”"},{"id":"manas-2010:p1379:b001:l001","ordinal":59642,"en":"Thinking thus, Kongurbay"},{"id":"manas-2010:p1379:b001:l002","ordinal":59643,"en":"Fled in earnest, vanishing like a mirage."},{"id":"manas-2010:p1379:b001:l003","ordinal":59644,"en":"Your Manas's Akkula"},{"id":"manas-2010:p1379:b001:l004","ordinal":59645,"en":"Caught up close upon his heels."},{"id":"manas-2010:p1379:b001:l005","ordinal":59646,"en":"Kongurbay was fleeing,"},{"id":"manas-2010:p1379:b001:l006","ordinal":59647,"en":"Toward the gate built in Outer Beijing,"},{"id":"manas-2010:p1379:b001:l007","ordinal":59648,"en":"He was drawing near;"}]
