006","ordinal":352230,"en":"If I get really angry,"},{"id":"seytek-2012:p0746:b002:l007","ordinal":352231,"en":"I suck like a dragon."},{"id":"seytek-2012:p0746:b002:l008","ordinal":352232,"en":"My name is Sarybay,"},{"id":"seytek-2012:p0746:b002:l009","ordinal":352233,"en":"If you ask for land"},{"id":"seytek-2012:p0746:b002:l010","ordinal":352234,"en":"Born in Jelpinish,"},{"id":"seytek-2012:p0746:b002:l011","ordinal":352235,"en":"My name was heard by the people,"},{"id":"seytek-2012:p0746:b002:l012","ordinal":352236,"en":"I made a mess in the world."},{"id":"seytek-2012:p0746:b002:l013","ordinal":352237,"en":"Who cares what is covered,"},{"id":"seytek-2012:p0746:b002:l014","ordinal":352238,"en":"Kan Sarybay myself."},{"id":"seytek-2012:p0746:b002:l015","ordinal":352239,"en":"Shimise is insatiable for blood,"},{"id":"seytek-2012:p0746:b002:l016","ordinal":352240,"en":"The black eye of boredom,"},{"id":"seytek-2012:p0746:b002:l017","ordinal":352241,"en":"Balaket's self."},{"id":"seytek-2012:p0746:b002:l018","ordinal":352242,"en":"Do not find money"},{"id":"seytek-2012:p0746:b002:l019","ordinal":352243,"en":"Unable to fight,"},{"id":"seytek-2012:p0746:b002:l020","ordinal":352244,"en":"I don't find stones in my teapots,"},{"id":"seytek-2012:p0746:b002:l021","ordinal":352245,"en":"I can't find five for my neck,"},{"id":"seytek-2012:p0746:b002:l022","ordinal":352246,"en":"Tomorrow is late,"},{"id":"seytek-2012:p0746:b002:l023","ordinal":352247,"en":"Blood is a descendant of Manas"},{"id":"seytek-2012:p0746:b002:l024","ordinal":352248,"en":"To slaughter without leaving,"},{"id":"seytek-2012:p0746:b002:l025","ordinal":352249,"en":"Edit without editing,"},{"id":"seytek-2012:p0746:b002:l026","ordinal":352250,"en":"To reach the bottom together,"},{"id":"seytek-2012:p0746:b002:l027","ordinal":352251,"en":"To fight hard,"},{"id":"seytek-2012:p0746:b002:l028","ordinal":352252,"en":"To slaughter the people of Kaltyrbay,"},{"id":"seytek-2012:p0746:b002:l029","ordinal":352253,"en":"The winding boat is unstoppable"},{"id":"seytek-2012:p0746:b002:l030","ordinal":352254,"en":"Around the Obsolon mountain,"},{"id":"seytek-2012:p0746:b002:l031","ordinal":352255,"en":"like a hero"},{"id":"seytek-2012:p0746:b002:l032","ordinal":352256,"en":"To take revenge without delay,"}]
