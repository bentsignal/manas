{"id": "sayakbay-ms-current146:pdf232:l001", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 1, "raw": "Оң кай кала конулган,", "text": "Оң кай кала конулган,", "en": "A favorable city had been settled there.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l002", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 2, "raw": "Кете турган жер экен,", "text": "Кете турган жер экен,", "en": "It was a place from which one must depart.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l003", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 3, "raw": "Азырканы сиз уулан,", "text": "Азырканы сиз уулан,", "en": "You sons of the present age,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l004", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 4, "raw": "Өтө турган жер экен,", "text": "Өтө турган жер экен,", "en": "It was a land one had to cross.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l005", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 5, "raw": "Бугу-марал аны атап,", "text": "Бугу-марал аны атап,", "en": "They named it for deer and maral.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 6, "raw": "Бузбай курсаң түзүп,", "text": "Бузбай курсаң түзүп,", "en": "If you build it without ruin, set it straight.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 7, "raw": "Аркар-кулжа деп атап,", "text": "Аркар-кулжа деп атап,", "en": "They named it for argali and wild ram.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 8, "raw": "Тамашага чын багып,", "text": "Тамашага чын багып,", "en": "They truly raised them for spectacle.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 9, "raw": "Ташыган жанды тындырып,", "text": "Ташыган жанды тындырып,", "en": "They brought the wandering soul to rest.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 10, "raw": "Тамаша салып уу уулан,", "text": "Тамаша салып уу уулан,", "en": "They made a spectacle, sons of poison.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 11, "raw": "Бермек чокон жан тырбып,", "text": "Бермек чокон жан тырбып,", "en": "The giver struggled for his soul.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 12, "raw": "Так ошентип турду эле,", "text": "Так ошентип турду эле,", "en": "He stood exactly so.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l013", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 13, "raw": "Ону кара мал экен,", "text": "Ону кара мал экен,", "en": "Those were his ten dark cattle.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 14, "raw": "Оң жылагач жан экен,", "text": "Оң жылагач жан экен,", "en": "He was a bare and righteous soul.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 15, "raw": "Демекчи боон тур чалган,", "text": "Демекчи боон тур чалган,", "en": "The speaker struck the standing bond.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 16, "raw": "Кол колуна найза алган,", "text": "Кол колуна найза алган,", "en": "Each man took a spear in hand.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 17, "raw": "Кокуйга турган кандай жан,", "text": "Кокуйга турган кандай жан,", "en": "What kind of soul stood in calamity?", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 18, "raw": "Кайып журтун өзү экен,", "text": "Кайып журтун өзү экен,", "en": "He himself belonged to the hidden people.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 19, "raw": "Как индинин көзү экен,", "text": "Как индинин көзү экен,", "en": "His eye was like a hard Indian gem.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 20, "raw": "Айбанга карар чок жеген,", "text": "Айбанга карар чок жеген,", "en": "He looked like a beast that had swallowed fire.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 21, "raw": "Адамдын түрүн билбеген,", "text": "Адамдын түрүн билбеген,", "en": "He did not recognize the form of man.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 22, "raw": "Бир муштум карса эрбеген,", "text": "Бир муштум карса эрбеген,", "en": "One fist seized him, yet he did not yield.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 23, "raw": "Талай журтка жамыкты,", "text": "Талай журтка жамыкты,", "en": "He brought concealment upon many peoples.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l024", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 24, "raw": "Атылынан шамыты,", "text": "Атылынан шамыты,", "en": "Its splendor came from its lineage.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 25, "raw": "Бермектерден аркарлар,", "text": "Бермектерден аркарлар,", "en": "The argali came from the givers.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 26, "raw": "Куланга урай калтырар,", "text": "Куланга урай калтырар,", "en": "They would drive it down upon the kulan.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 27, "raw": "Күрдөөнүн жандан түшүп,", "text": "Күрдөөнүн жандан түшүп,", "en": "He descended alive from the mountain pass.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 28, "raw": "Муну көрдү үч арстан,", "text": "Муну көрдү үч арстан,", "en": "The three lions saw this.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 29, "raw": "Каздуу күн жайылган,", "text": "Каздуу күн жайылган,", "en": "The day of fortune spread out.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 30, "raw": "Шумду көрдү үч арстан,", "text": "Шумду көрдү үч арстан,", "en": "The three lions saw the horror.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 31, "raw": "Белтиң бар, белим бар,", "text": "Белтиң бар, белим бар,", "en": "You have strength, and I have strength.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 32, "raw": "Эрчүйгөн ээн эл бар,", "text": "Эрчүйгөн ээн эл бар,", "en": "There is a deserted people who pursue heroes.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, proper name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 33, "raw": "Аманат жан кыямат,", "text": "Аманат жан кыямат,", "en": "A life held in trust faces doomsday.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l034", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 34, "raw": "Азатка адам түшүргөн,", "text": "Азатка адам түшүргөн,", "en": "He brought a man down into freedom.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l035", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 35, "raw": "Ажалы жок, шору жок,", "text": "Ажалы жок, шору жок,", "en": "Without death and without misery,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l036", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 36, "raw": "Азапсыз адам курган,", "text": "Азапсыз адам курган,", "en": "He fashioned a man without suffering.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l037", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 37, "raw": "Кудай бетин көрсөтсө,", "text": "Кудай бетин көрсөтсө,", "en": "If God showed his face,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l038", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 38, "raw": "Жыргылы бар, душман бар,", "text": "Жыргылы бар, душман бар,", "en": "There is joy, and there is an enemy.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf232:l039", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 232, "folio": 615, "line_in_page": 39, "raw": "Жылын жүргөн жаман бар.", "text": "Жылын жүргөн жаман бар.", "en": "There is an evil one who walks through the years.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
