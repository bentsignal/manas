[{"id":"semetey-1-2013:p0251:b005:l039","ordinal":96001,"en":"Her bloody face torn,"},{"id":"semetey-1-2013:p0252:b003:l001","ordinal":96002,"en":"Her bosom filled with tears."},{"id":"semetey-1-2013:p0252:b003:l002","ordinal":96003,"en":"Alas, her lord Manas"},{"id":"semetey-1-2013:p0252:b003:l003","ordinal":96004,"en":"Seemed to have died just now."},{"id":"semetey-1-2013:p0252:b003:l004","ordinal":96005,"en":"Her Akborchuk paced along;"},{"id":"semetey-1-2013:p0252:b003:l005","ordinal":96006,"en":"Bloody tears flowing from her cheeks,"},{"id":"semetey-1-2013:p0252:b003:l006","ordinal":96007,"en":"The noble gray pacer she rode—"},{"id":"semetey-1-2013:p0252:b003:l007","ordinal":96008,"en":"Down its knees they streamed."},{"id":"semetey-1-2013:p0252:b003:l008","ordinal":96009,"en":"Unable to stop sobbing and weeping,"},{"id":"semetey-1-2013:p0252:b003:l009","ordinal":96010,"en":"She had halted along the river."},{"id":"semetey-1-2013:p0252:b003:l010","ordinal":96011,"en":"If you saw the measure of it then,"},{"id":"semetey-1-2013:p0252:b003:l011","ordinal":96012,"en":"Blessed Manas, the leopard,"},{"id":"semetey-1-2013:p0252:b003:l012","ordinal":96013,"en":"Seemed to have died just now."},{"id":"semetey-1-2013:p0252:b003:l013","ordinal":96014,"en":"She had put on her mourning shroud."},{"id":"semetey-1-2013:p0252:b003:l014","ordinal":96015,"en":"Your dear mother Kanykei,"},{"id":"semetey-1-2013:p0252:b003:l015","ordinal":96016,"en":"Crying out as a woman,"},{"id":"semetey-1-2013:p0252:b003:l016","ordinal":96017,"en":"Was driving Taytoru onward."},{"id":"semetey-1-2013:p0252:b003:l017","ordinal":96018,"en":"That sister-in-law of yours, Kanykei,"},{"id":"semetey-1-2013:p0252:b003:l018","ordinal":96019,"en":"Suffering no one had seen,"},{"id":"semetey-1-2013:p0252:b003:l019","ordinal":96020,"en":"Came enduring."},{"id":"semetey-1-2013:p0252:b003:l020","ordinal":96021,"en":"With blank charges,"},{"id":"semetey-1-2013:p0252:b003:l021","ordinal":96022,"en":"Now and then,"},{"id":"semetey-1-2013:p0252:b003:l022","ordinal":96023,"en":"The racer Taytoru,"},{"id":"semetey-1-2013:p0252:b003:l023","ordinal":96024,"en":"She came urging with gunshots."},{"id":"semetey-1-2013:p0252:b003:l024","ordinal":96025,"en":"Her dear hair, thick as a girth,"},{"id":"semetey-1-2013:p0252:b003:l025","ordinal":96026,"en":"Poured across her breast."},{"id":"semetey-1-2013:p0252:b003:l026","ordinal":96027,"en":"Your impetuous mother Kanykei,"},{"id":"semetey-1-2013:p0252:b003:l027","ordinal":96028,"en":"All her thoughts scattered,"},{"id":"semetey-1-2013:p0252:b003:l028","ordinal":96029,"en":"Your mother's great misfortune"},{"id":"semetey-1-2013:p0252:b003:l029","ordinal":96030,"en":"Came boiling forth."},{"id":"semetey-1-2013:p0252:b003:l030","ordinal":96031,"en":"Following behind Tory,"},{"id":"semetey-1-2013:p0252:b003:l031","ordinal":96032,"en":"Your unfortunate mother Kanykei"},{"id":"semetey-1-2013:p0252:b003:l032","ordinal":96033,"en":"Came driving him onward."},{"id":"semetey-1-2013:p0252:b003:l033","ordinal":96034,"en":"Her poor heart torn,"},{"id":"semetey-1-2013:p0252:b003:l034","ordinal":96035,"en":"She came pouring out her words."},{"id":"semetey-1-2013:p0252:b003:l035","ordinal":96036,"en":"\"The jutting point of a blue ridge,"},{"id":"semetey-1-2013:p0252:b003:l036","ordinal":96037,"en":"My lord, like its promontory,\" she said,"},{"id":"semetey-1-2013:p0252:b003:l037","ordinal":96038,"en":"And came chanting her lament."},{"id":"semetey-1-2013:p0252:b003:l038","ordinal":96039,"en":"(Now God had granted her wish;"},{"id":"semetey-1-2013:p0252:b003:l039","ordinal":96040,"en":"Now Taytoru had come out ahead."},{"id":"semetey-1-2013:p0252:b004:l001","ordinal":96041,"en":"Unable to endure her worries,"},{"id":"semetey-1-2013:p0252:b004:l002","ordinal":96042,"en":"The poor soul placed her true hope"},{"id":"semetey-1-2013:p0252:b004:l003","ordinal":96043,"en":"In the son left by the fierce warrior."},{"id":"semetey-1-2013:p0252:b004:l004","ordinal":96044,"en":"Taytoru comes out ahead;"},{"id":"semetey-1-2013:p0252:b004:l005","ordinal":96045,"en":"Kanykei cries and weeps."},{"id":"semetey-1-2013:p0252:b004:l006","ordinal":96046,"en":"Let us leave this here,"},{"id":"semetey-1-2013:p0252:b004:l007","ordinal":96047,"en":"And Semetey, left by Manas,"},{"id":"semetey-1-2013:p0252:b004:l008","ordinal":96048,"en":"Let us begin the tale of that hero.)"},{"id":"semetey-1-2013:p0252:b004:l009","ordinal":96049,"en":"At that time, Semetey"},{"id":"semetey-1-2013:p0252:b004:l010","ordinal":96050,"en":"Had not yet worn a coat over his back."},{"id":"semetey-1-2013:p0252:b004:l011","ordinal":96051,"en":"Khan Manas, gone to the other world—"},{"id":"semetey-1-2013:p0252:b004:l012","ordinal":96052,"en":"He did not yet know this was his elder kinsman."},{"id":"semetey-1-2013:p0252:b004:l013","ordinal":96053,"en":"At that time, Semetey"},{"id":"semetey-1-2013:p0252:b004:l014","ordinal":96054,"en":"Had his thoughts elsewhere."},{"id":"semetey-1-2013:p0252:b004:l015","ordinal":96055,"en":"His twig had been cut,"},{"id":"semetey-1-2013:p0252:b004:l016","ordinal":96056,"en":"The customary rite performed;"},{"id":"semetey-1-2013:p0252:b004:l017","ordinal":96057,"en":"He was Ismayil's son."},{"id":"semetey-1-2013:p0252:b004:l018","ordinal":96058,"en":"Those dark ridges stretching away—"},{"id":"semetey-1-2013:p0252:b004:l019","ordinal":96059,"en":"He did not yet know that land was his."},{"id":"semetey-1-2013:p0252:b004:l020","ordinal":96060,"en":"That wandering woman Kanykei—"},{"id":"semetey-1-2013:p0252:b004:l021","ordinal":96061,"en":"He did not yet know she was his mother."},{"id":"semetey-1-2013:p0252:b004:l022","ordinal":96062,"en":"The grieving soul, coughing again and again—"},{"id":"semetey-1-2013:p0252:b004:l023","ordinal":96063,"en":"He did not know she had coughed."},{"id":"semetey-1-2013:p0252:b004:l024","ordinal":96064,"en":"Breathless in flight, barefoot,"},{"id":"semetey-1-2013:p0252:b004:l025","ordinal":96065,"en":"He did not know she had hurried on."},{"id":"semetey-1-2013:p0252:b004:l026","ordinal":96066,"en":"Evil days had fallen upon her;"},{"id":"semetey-1-2013:p0252:b004:l027","ordinal":96067,"en":"His poor mother,"},{"id":"semetey-1-2013:p0252:b004:l028","ordinal":96068,"en":"Her soles battered against stones,"},{"id":"semetey-1-2013:p0252:b004:l029","ordinal":96069,"en":"Her brow scorched by the sun,"},{"id":"semetey-1-2013:p0252:b004:l030","ordinal":96070,"en":"Ran in flight without measure."},{"id":"semetey-1-2013:p0252:b004:l031","ordinal":96071,"en":"All the flesh of her soles,"},{"id":"semetey-1-2013:p0252:b004:l032","ordinal":96072,"en":"Striking stones, was torn."},{"id":"semetey-1-2013:p0252:b004:l033","ordinal":96073,"en":"As she walked, dark blood flowed from her calves,"},{"id":"semetey-1-2013:p0252:b004:l034","ordinal":96074,"en":"And the poor soul's strength ebbed away."},{"id":"semetey-1-2013:p0252:b004:l035","ordinal":96075,"en":"With no overshoes, in felt socks,"},{"id":"semetey-1-2013:p0252:b004:l036","ordinal":96076,"en":"The dear soul did not die of grief."},{"id":"semetey-1-2013:p0252:b004:l037","ordinal":96077,"en":"Without boots, in felt socks,"},{"id":"semetey-1-2013:p0252:b004:l038","ordinal":96078,"en":"The dear soul would not die."},{"id":"semetey-1-2013:p0252:b004:l039","ordinal":96079,"en":"Countless treasure, myriad possessions,"},{"id":"semetey-1-2013:p0253:b003:l001","ordinal":96080,"en":"She had indeed scattered as she came."},{"id":"semetey-1-2013:p0253:b003:l002","ordinal":96081,"en":"Unable to find any way out,"},{"id":"semetey-1-2013:p0253:b003:l003","ordinal":96082,"en":"Your mother, that raging slavewoman,"},{"id":"semetey-1-2013:p0253:b003:l004","ordinal":96083,"en":"To the city of Temir Khan"},{"id":"semetey-1-2013:p0253:b003:l005","ordinal":96084,"en":"Had indeed come in flight."},{"id":"semetey-1-2013:p0253:b003:l006","ordinal":96085,"en":"The line God had drawn,"},{"id":"semetey-1-2013:p0253:b003:l007","ordinal":96086,"en":"Your sister-in-law had seen."},{"id":"semetey-1-2013:p0253:b003:l008","ordinal":96087,"en":"Her only child left by her companion,"},{"id":"semetey-1-2013:p0253:b003:l009","ordinal":96088,"en":"She had given to another."},{"id":"semetey-1-2013:p0253:b003:l010","ordinal":96089,"en":"Then young Semetey"},{"id":"semetey-1-2013:p0253:b003:l011","ordinal":96090,"en":"Had not yet worn a fine white-cloth shirt."},{"id":"semetey-1-2013:p0253:b003:l012","ordinal":96091,"en":"From his lord, Sultan Manas,"},{"id":"semetey-1-2013:p0253:b003:l013","ordinal":96092,"en":"Semetey did not know he had been left behind."},{"id":"semetey-1-2013:p0253:b003:l014","ordinal":96093,"en":"Semetey, born of Manas,"},{"id":"semetey-1-2013:p0253:b003:l015","ordinal":96094,"en":"Did not yet know he was a prince."},{"id":"semetey-1-2013:p0253:b003:l016","ordinal":96095,"en":"That poor Kanykei—"},{"id":"semetey-1-2013:p0253:b003:l017","ordinal":96096,"en":"He did not yet know she was his mother."},{"id":"semetey-1-2013:p0253:b003:l018","ordinal":96097,"en":"The boy's thoughts were elsewhere."},{"id":"semetey-1-2013:p0253:b003:l019","ordinal":96098,"en":"(Temir Khan's dear camel calf,"},{"id":"semetey-1-2013:p0253:b003:l020","ordinal":96099,"en":"Ismayil's son."},{"id":"semetey-1-2013:p0253:b003:l021","ordinal":96100,"en":"At that time, Semetey"},{"id":"semetey-1-2013:p0253:b003:l022","ordinal":96101,"en":"Had his thoughts elsewhere.)"},{"id":"semetey-1-2013:p0253:b003:l023","ordinal":96102,"en":"From that ridge shaped like a saddle's waist,"},{"id":"semetey-1-2013:p0253:b003:l024","ordinal":96103,"en":"Unable to turn his horse's head,"},{"id":"semetey-1-2013:p0253:b003:l025","ordinal":96104,"en":"From bloodthirsty, fierce Manas,"},{"id":"semetey-1-2013:p0253:b003:l026","ordinal":96105,"en":"A warrior born of a leopard,"},{"id":"semetey-1-2013:p0253:b003:l027","ordinal":96106,"en":"Offspring of his very lineage,"},{"id":"semetey-1-2013:p0253:b003:l028","ordinal":96107,"en":"A lion protected by Shay,"},{"id":"semetey-1-2013:p0253:b003:l029","ordinal":96108,"en":"Roared in anger."},{"id":"semetey-1-2013:p0253:b003:l030","ordinal":96109,"en":"Unable to restrain his strength,"},{"id":"semetey-1-2013:p0253:b003:l031","ordinal":96110,"en":"To some sixty strongmen"},{"id":"semetey-1-2013:p0253:b003:l032","ordinal":96111,"en":"He called, \"Come here!\""},{"id":"semetey-1-2013:p0253:b003:l033","ordinal":96112,"en":"His sixty or so strongmen"},{"id":"semetey-1-2013:p0253:b003:l034","ordinal":96113,"en":"Thundered as though enemies had attacked."},{"id":"semetey-1-2013:p0253:b003:l035","ordinal":96114,"en":"All their weapons"},{"id":"semetey-1-2013:p0253:b003:l036","ordinal":96115,"en":"Looked like takers of life."},{"id":"semetey-1-2013:p0253:b003:l037","ordinal":96116,"en":"Those who watched,"},{"id":"semetey-1-2013:p0253:b003:l038","ordinal":96117,"en":"Their hearts were deeply troubled."},{"id":"semetey-1-2013:p0253:b003:l039","ordinal":96118,"en":"Seven of the guards were there,"},{"id":"semetey-1-2013:p0253:b004:l001","ordinal":96119,"en":"Raging as though rabid."},{"id":"semetey-1-2013:p0253:b004:l002","ordinal":96120,"en":"Commanders of ten came bobbing,"},{"id":"semetey-1-2013:p0253:b004:l003","ordinal":96121,"en":"Their spears jutting up,"},{"id":"semetey-1-2013:p0253:b004:l004","ordinal":96122,"en":"The spearheads clashing,"},{"id":"semetey-1-2013:p0253:b004:l005","ordinal":96123,"en":"The men's heads knocking together."},{"id":"semetey-1-2013:p0253:b004:l006","ordinal":96124,"en":"The great kettledrum,"},{"id":"semetey-1-2013:p0253:b004:l007","ordinal":96125,"en":"The headstrong boy Semetey"},{"id":"semetey-1-2013:p0253:b004:l008","ordinal":96126,"en":"Struck with a clang."},{"id":"semetey-1-2013:p0253:b004:l009","ordinal":96127,"en":"All his strongmen,"},{"id":"semetey-1-2013:p0253:b004:l010","ordinal":96128,"en":"Readying themselves as though enemies had come,"},{"id":"semetey-1-2013:p0253:b004:l011","ordinal":96129,"en":"The boy Semetey"},{"id":"semetey-1-2013:p0253:b004:l012","ordinal":96130,"en":"Stood surrounding."},{"id":"semetey-1-2013:p0253:b004:l013","ordinal":96131,"en":"Upon lips that had never spoken Manas,"},{"id":"semetey-1-2013:p0253:b004:l014","ordinal":96132,"en":"The poor orphan boy's lips,"},{"id":"semetey-1-2013:p0253:b004:l015","ordinal":96133,"en":"Manas now appeared."},{"id":"semetey-1-2013:p0253:b004:l016","ordinal":96134,"en":"Upon lips that had never spoken a homeland,"},{"id":"semetey-1-2013:p0253:b004:l017","ordinal":96135,"en":"Talas now appeared."},{"id":"semetey-1-2013:p0253:b004:l018","ordinal":96136,"en":"Khizyr visited the boy,"},{"id":"semetey-1-2013:p0253:b004:l019","ordinal":96137,"en":"And Kyrgyz now appeared."},{"id":"semetey-1-2013:p0253:b004:l020","ordinal":96138,"en":"His blood drew him irresistibly;"},{"id":"semetey-1-2013:p0253:b004:l021","ordinal":96139,"en":"That courageous young lad,"},{"id":"semetey-1-2013:p0253:b004:l022","ordinal":96140,"en":"Upon lips that had never said 'Mother,'"},{"id":"semetey-1-2013:p0253:b004:l023","ordinal":96141,"en":"'Mother' now appeared:"},{"id":"semetey-1-2013:p0253:b004:l024","ordinal":96142,"en":"\"My dear strongmen,"},{"id":"semetey-1-2013:p0253:b004:l025","ordinal":96143,"en":"The people we have yet to reach—"},{"id":"semetey-1-2013:p0253:b004:l026","ordinal":96144,"en":"Let us put them to the test, strongmen."},{"id":"semetey-1-2013:p0253:b004:l027","ordinal":96145,"en":"Against those thundering khans today,"},{"id":"semetey-1-2013:p0253:b004:l028","ordinal":96146,"en":"Let us stir up a quarrel, strongmen!"},{"id":"semetey-1-2013:p0253:b004:l029","ordinal":96147,"en":"All the horses that have owners,"},{"id":"semetey-1-2013:p0253:b004:l030","ordinal":96148,"en":"Now, strongmen, hear my words:"},{"id":"semetey-1-2013:p0253:b004:l031","ordinal":96149,"en":"Let us catch them at the bank."},{"id":"semetey-1-2013:p0253:b004:l032","ordinal":96150,"en":"Leaving not a single one alive,"},{"id":"semetey-1-2013:p0253:b004:l033","ordinal":96151,"en":"Let us slaughter them all."},{"id":"semetey-1-2013:p0253:b004:l034","ordinal":96152,"en":"Gathering every last one,"},{"id":"semetey-1-2013:p0253:b004:l035","ordinal":96153,"en":"Let us offer them in sacrifice!"},{"id":"semetey-1-2013:p0253:b004:l036","ordinal":96154,"en":"Now, strongmen, hear my words:"},{"id":"semetey-1-2013:p0253:b004:l037","ordinal":96155,"en":"My unlucky elder sister's"},{"id":"semetey-1-2013:p0253:b004:l038","ordinal":96156,"en":"Horse Taytoru—if he appears,"},{"id":"semetey-1-2013:p0253:b004:l039","ordinal":96157,"en":"Let us urge that one onward."},{"id":"semetey-1-2013:p0254:b003:l001","ordinal":96158,"en":"Let us slaughter the horses that have owners."},{"id":"semetey-1-2013:p0254:b003:l002","ordinal":96159,"en":"If my elder sister's horse appears,"},{"id":"semetey-1-2013:p0254:b003:l003","ordinal":96160,"en":"Roaring, 'Manas! Manas!'"},{"id":"semetey-1-2013:p0254:b003:l004","ordinal":96161,"en":"Raising the battle cry, 'Manas!'"},{"id":"semetey-1-2013:p0254:b003:l005","ordinal":96162,"en":"Let us urge him onward."},{"id":"semetey-1-2013:p0254:b003:l006","ordinal":96163,"en":"If God grants it, to Bukhara,"},{"id":"semetey-1-2013:p0254:b003:l007","ordinal":96164,"en":"Let us urge him on with cries of 'Manas!'"},{"id":"semetey-1-2013:p0254:b003:l008","ordinal":96165,"en":"My dear strongmen,"},{"id":"semetey-1-2013:p0254:b003:l009","ordinal":96166,"en":"All the valleys and mountains,"},{"id":"semetey-1-2013:p0254:b003:l010","ordinal":96167,"en":"Let us make them seem to run."},{"id":"semetey-1-2013:p0254:b003:l011","ordinal":96168,"en":"My dear brother-in-law, gone to the other world,"},{"id":"semetey-1-2013:p0254:b003:l012","ordinal":96169,"en":"Awaking again where he lies,"},{"id":"semetey-1-2013:p0254:b003:l013","ordinal":96170,"en":"Let us make it seem my brother-in-law has risen!"},{"id":"semetey-1-2013:p0254:b003:l014","ordinal":96171,"en":"All the valleys and mountains crying 'Manas!'"},{"id":"semetey-1-2013:p0254:b003:l015","ordinal":96172,"en":"Let us make them seem to run."},{"id":"semetey-1-2013:p0254:b003:l016","ordinal":96173,"en":"The rugged, rolling hills,"},{"id":"semetey-1-2013:p0254:b003:l017","ordinal":96174,"en":"Let us make them like a plain."},{"id":"semetey-1-2013:p0254:b003:l018","ordinal":96175,"en":"That elder sister of mine, so full of sorrow,"},{"id":"semetey-1-2013:p0254:b003:l019","ordinal":96176,"en":"The poor woman whose strength is spent,"},{"id":"semetey-1-2013:p0254:b003:l020","ordinal":96177,"en":"Let us make her feel she has a child."},{"id":"semetey-1-2013:p0254:b003:l021","ordinal":96178,"en":"The ill-hearted people,"},{"id":"semetey-1-2013:p0254:b003:l022","ordinal":96179,"en":"When they see it,"},{"id":"semetey-1-2013:p0254:b003:l023","ordinal":96180,"en":"Let us make them despair of life!"},{"id":"semetey-1-2013:p0254:b003:l024","ordinal":96181,"en":"Valleys and mountains joining,"},{"id":"semetey-1-2013:p0254:b003:l025","ordinal":96182,"en":"'That is Manas!' they will say;"},{"id":"semetey-1-2013:p0254:b003:l026","ordinal":96183,"en":"Let us make them seem to run!"},{"id":"semetey-1-2013:p0254:b003:l027","ordinal":96184,"en":"Roaring, 'Manas! Manas!'"},{"id":"semetey-1-2013:p0254:b003:l028","ordinal":96185,"en":"Raising the battle cry, 'Manas!'"},{"id":"semetey-1-2013:p0254:b003:l029","ordinal":96186,"en":"The racer Taytoru,"},{"id":"semetey-1-2013:p0254:b003:l030","ordinal":96187,"en":"Let us urge onward to Bukhara."},{"id":"semetey-1-2013:p0254:b003:l031","ordinal":96188,"en":"The countless livestock offered as prizes,"},{"id":"semetey-1-2013:p0254:b003:l032","ordinal":96189,"en":"Treasure filling seven houses,"},{"id":"semetey-1-2013:p0254:b003:l033","ordinal":96190,"en":"A thousand dark camels,"},{"id":"semetey-1-2013:p0254:b003:l034","ordinal":96191,"en":"A thousand black mares with blazes,"},{"id":"semetey-1-2013:p0254:b003:l035","ordinal":96192,"en":"Gold weighed out in poods,"},{"id":"semetey-1-2013:p0254:b003:l036","ordinal":96193,"en":"Let us take possession of it all!"},{"id":"semetey-1-2013:p0254:b003:l037","ordinal":96194,"en":"Do not think narrowly, young men."},{"id":"semetey-1-2013:p0254:b003:l038","ordinal":96195,"en":"The racer Taytoru has no human sense;"},{"id":"semetey-1-2013:p0254:b003:l039","ordinal":96196,"en":"He has no master apart from us."},{"id":"semetey-1-2013:p0254:b004:l001","ordinal":96197,"en":"If Taytoru comes out ahead,"},{"id":"semetey-1-2013:p0254:b004:l002","ordinal":96198,"en":"If God grants our very wish,"},{"id":"semetey-1-2013:p0254:b004:l003","ordinal":96199,"en":"I shall agree to what you say,"},{"id":"semetey-1-2013:p0254:b004:l004","ordinal":96200,"en":"My dear strongmen."},{"id":"semetey-1-2013:p0254:b004:l005","ordinal":96201,"en":"Keeping not a coin for myself,"},{"id":"semetey-1-2013:p0254:b004:l006","ordinal":96202,"en":"Again, strongmen, listen:"},{"id":"semetey-1-2013:p0254:b004:l007","ordinal":96203,"en":"All the prizes,"},{"id":"semetey-1-2013:p0254:b004:l008","ordinal":96204,"en":"I shall share out among you."},{"id":"semetey-1-2013:p0254:b004:l009","ordinal":96205,"en":"If I dispute a prize with you,"},{"id":"semetey-1-2013:p0254:b004:l010","ordinal":96206,"en":"If I lose my reason,"},{"id":"semetey-1-2013:p0254:b004:l011","ordinal":96207,"en":"Like a horse-tethering post,"},{"id":"semetey-1-2013:p0254:b004:l012","ordinal":96208,"en":"May I live utterly barren."},{"id":"semetey-1-2013:p0254:b004:l013","ordinal":96209,"en":"Never seeing God's face,"},{"id":"semetey-1-2013:p0254:b004:l014","ordinal":96210,"en":"My dear strongmen,"},{"id":"semetey-1-2013:p0254:b004:l015","ordinal":96211,"en":"May I remain an unbeliever!"},{"id":"semetey-1-2013:p0254:b004:l016","ordinal":96212,"en":"I do not covet the prize;"},{"id":"semetey-1-2013:p0254:b004:l017","ordinal":96213,"en":"Let the fame belong to Manas!"},{"id":"semetey-1-2013:p0254:b004:l018","ordinal":96214,"en":"Think, strongmen:"},{"id":"semetey-1-2013:p0254:b004:l019","ordinal":96215,"en":"Here today, gone tomorrow,"},{"id":"semetey-1-2013:p0254:b004:l020","ordinal":96216,"en":"Such is this shitty world!"},{"id":"semetey-1-2013:p0254:b004:l021","ordinal":96217,"en":"Consider, strongmen:"},{"id":"semetey-1-2013:p0254:b004:l022","ordinal":96218,"en":"The marten-fur cap upon one's head,"},{"id":"semetey-1-2013:p0254:b004:l023","ordinal":96219,"en":"Who has not worn it jauntily?"},{"id":"semetey-1-2013:p0254:b004:l024","ordinal":96220,"en":"When fortune was upon them,"},{"id":"semetey-1-2013:p0254:b004:l025","ordinal":96221,"en":"Who has not strode about in splendor?"},{"id":"semetey-1-2013:p0254:b004:l026","ordinal":96222,"en":"At the sight of my brother-in-law, Khan Manas,"},{"id":"semetey-1-2013:p0254:b004:l027","ordinal":96223,"en":"Not only Muslims, but those"},{"id":"semetey-1-2013:p0254:b004:l028","ordinal":96224,"en":"Chinese people trembled."},{"id":"semetey-1-2013:p0254:b004:l029","ordinal":96225,"en":"The Russians on his right,"},{"id":"semetey-1-2013:p0254:b004:l030","ordinal":96226,"en":"My brother-in-law mowed down."},{"id":"semetey-1-2013:p0254:b004:l031","ordinal":96227,"en":"The Chinese on the uplands,"},{"id":"semetey-1-2013:p0254:b004:l032","ordinal":96228,"en":"My brother-in-law slaughtered."},{"id":"semetey-1-2013:p0254:b004:l033","ordinal":96229,"en":"His own will throughout the world,"},{"id":"semetey-1-2013:p0254:b004:l034","ordinal":96230,"en":"My brother-in-law carried out."},{"id":"semetey-1-2013:p0254:b004:l035","ordinal":96231,"en":"This Muslim faith, Islam,"},{"id":"semetey-1-2013:p0254:b004:l036","ordinal":96232,"en":"My brother-in-law protected."},{"id":"semetey-1-2013:p0254:b004:l037","ordinal":96233,"en":"He received a letter from the caliph,"},{"id":"semetey-1-2013:p0254:b004:l038","ordinal":96234,"en":"He himself received Khan-Khoja's blessing."},{"id":"semetey-1-2013:p0254:b004:l039","ordinal":96235,"en":"My dear brother-in-law, gone to the other world,"},{"id":"semetey-1-2013:p0255:b003:l001","ordinal":96236,"en":"Was called the renowned conqueror."},{"id":"semetey-1-2013:p0255:b003:l002","ordinal":96237,"en":"He raided Ombu and took spoils,"},{"id":"semetey-1-2013:p0255:b003:l003","ordinal":96238,"en":"Shattered many a land,"},{"id":"semetey-1-2013:p0255:b003:l004","ordinal":96239,"en":"Devastated without measure and took spoils."},{"id":"semetey-1-2013:p0255:b003:l005","ordinal":96240,"en":"My brother-in-law Manas, the leopard,"},{"id":"semetey-1-2013:p0255:b003:l006","ordinal":96241,"en":"Went and raided the Afghans."},{"id":"semetey-1-2013:p0255:b003:l007","ordinal":96242,"en":"Untouched by my brother-in-law's hand,"},{"id":"semetey-1-2013:p0255:b003:l008","ordinal":96243,"en":"How could Margalang have remained unharmed?"},{"id":"semetey-1-2013:p0255:b003:l009","ordinal":96244,"en":"Untrodden by his horse Akkula,"},{"id":"semetey-1-2013:p0255:b003:l010","ordinal":96245,"en":"No whole tract of land remained."},{"id":"semetey-1-2013:p0255:b003:l011","ordinal":96246,"en":"Without having heard his battle cry,"},{"id":"semetey-1-2013:p0255:b003:l012","ordinal":96247,"en":"No whole people remained."},{"id":"semetey-1-2013:p0255:b003:l013","ordinal":96248,"en":"My brother-in-law, seized by his valor,"},{"id":"semetey-1-2013:p0255:b003:l014","ordinal":96249,"en":"Gathered the Muslim people."},{"id":"semetey-1-2013:p0255:b003:l015","ordinal":96250,"en":"Into dark, looming Beijing,"},{"id":"semetey-1-2013:p0255:b003:l016","ordinal":96251,"en":"He went straight, thrusting his spear firmly."},{"id":"semetey-1-2013:p0255:b003:l017","ordinal":96252,"en":"With four hundred thousand troops, my brother-in-law"},{"id":"semetey-1-2013:p0255:b003:l018","ordinal":96253,"en":"Smashed and slaughtered the Chinese."},{"id":"semetey-1-2013:p0255:b003:l019","ordinal":96254,"en":"Ruling Beijing,"},{"id":"semetey-1-2013:p0255:b003:l020","ordinal":96255,"en":"He held inquiries for six months."},{"id":"semetey-1-2013:p0255:b003:l021","ordinal":96256,"en":"That brother-in-law of mine has died."}]
