[{"id":"manas-2010:p0823:b001:l033","ordinal":36353,"en":"Did she not writhe there?"},{"id":"manas-2010:p0823:b001:l034","ordinal":36354,"en":"“Leopard, may you stay safe!”"},{"id":"manas-2010:p0823:b001:l035","ordinal":36355,"en":"Did she not remain there weeping?"},{"id":"manas-2010:p0823:b001:l036","ordinal":36356,"en":"Her great name would be a treasure;"},{"id":"manas-2010:p0823:b001:l037","ordinal":36357,"en":"The finest among women,"},{"id":"manas-2010:p0823:b001:l038","ordinal":36358,"en":"She was a blessed soul."},{"id":"manas-2010:p0823:b001:l039","ordinal":36359,"en":"To wait for me seven years"},{"id":"manas-2010:p0823:b001:l040","ordinal":36360,"en":"Was her promise."},{"id":"manas-2010:p0823:b001:l041","ordinal":36361,"en":"When I reckon the months,"},{"id":"manas-2010:p0823:b001:l042","ordinal":36362,"en":"When I set the months in writing,"},{"id":"manas-2010:p0824:b001:l001","ordinal":36363,"en":"The moon renews, the day dies;"},{"id":"manas-2010:p0824:b001:l002","ordinal":36364,"en":"Unable to take my sorrowful beloved,"},{"id":"manas-2010:p0824:b001:l003","ordinal":36365,"en":"Must we go on like this?"},{"id":"manas-2010:p0824:b001:l004","ordinal":36366,"en":"Leaving my love, crying “Manas!”"},{"id":"manas-2010:p0824:b001:l005","ordinal":36367,"en":"What of me, gone for years?"},{"id":"manas-2010:p0824:b001:l006","ordinal":36368,"en":"“My precious Bakay will come,” she says,"},{"id":"manas-2010:p0824:b001:l007","ordinal":36369,"en":"Counting the days in sorrow—"},{"id":"manas-2010:p0824:b001:l008","ordinal":36370,"en":"What of her, going about in tears?"},{"id":"manas-2010:p0824:b001:l009","ordinal":36371,"en":"God Most High, his servants—"},{"id":"manas-2010:p0824:b001:l010","ordinal":36372,"en":"He creates them in so many ways."},{"id":"manas-2010:p0824:b001:l011","ordinal":36373,"en":"Pale instead of rosy,"},{"id":"manas-2010:p0824:b001:l012","ordinal":36374,"en":"She must be filled with sorrow."},{"id":"manas-2010:p0824:b001:l013","ordinal":36375,"en":"“Bakay has gone without returning,” she must say,"},{"id":"manas-2010:p0824:b001:l014","ordinal":36376,"en":"And must have lost all hope."},{"id":"manas-2010:p0824:b001:l015","ordinal":36377,"en":"Of your elder Bakay, so long delayed,"},{"id":"manas-2010:p0824:b001:l016","ordinal":36378,"en":"She must think, “He will not come.”"},{"id":"manas-2010:p0824:b001:l017","ordinal":36379,"en":"These days Körpöyan"},{"id":"manas-2010:p0824:b001:l018","ordinal":36380,"en":"Must be living without hope."},{"id":"manas-2010:p0824:b001:l019","ordinal":36381,"en":"To her father himself"},{"id":"manas-2010:p0824:b001:l020","ordinal":36382,"en":"People came as marriage envoys."},{"id":"manas-2010:p0824:b001:l021","ordinal":36383,"en":"“I shall take the poor girl,” they said,"},{"id":"manas-2010:p0824:b001:l022","ordinal":36384,"en":"Khans coming from every direction."},{"id":"manas-2010:p0824:b001:l023","ordinal":36385,"en":"A green-patterned cotton dress"},{"id":"manas-2010:p0824:b001:l024","ordinal":36386,"en":"She refused to wear, I heard."},{"id":"manas-2010:p0824:b001:l025","ordinal":36387,"en":"“Cut off my head if you wish,” she said,"},{"id":"manas-2010:p0824:b001:l026","ordinal":36388,"en":"And refused to marry, I heard."},{"id":"manas-2010:p0824:b001:l027","ordinal":36389,"en":"Lamenting, “Khan Bakay!”"},{"id":"manas-2010:p0824:b001:l028","ordinal":36390,"en":"What of her, burning with longing?"},{"id":"manas-2010:p0824:b001:l029","ordinal":36391,"en":"Unable to reach my appointed day,"},{"id":"manas-2010:p0824:b001:l030","ordinal":36392,"en":"What of me, Bakay, yearning fiercely?"},{"id":"manas-2010:p0824:b001:l031","ordinal":36393,"en":"God Most High, his servants—"},{"id":"manas-2010:p0824:b001:l032","ordinal":36394,"en":"He hobbles them in so many ways."},{"id":"manas-2010:p0824:b001:l033","ordinal":36395,"en":"Sitting, pondering and burning,"},{"id":"manas-2010:p0824:b001:l034","ordinal":36396,"en":"Your Bakay pours out his heart,"},{"id":"manas-2010:p0824:b001:l035","ordinal":36397,"en":"Burning in so many ways."},{"id":"manas-2010:p0824:b001:l036","ordinal":36398,"en":"For a journey of six months,"},{"id":"manas-2010:p0824:b001:l037","ordinal":36399,"en":"There is no courser like my gray steed."},{"id":"manas-2010:p0824:b001:l038","ordinal":36400,"en":"Youngest of warriors, mighty Manas,"},{"id":"manas-2010:p0824:b001:l039","ordinal":36401,"en":"I have no kin but you."},{"id":"manas-2010:p0824:b001:l040","ordinal":36402,"en":"I have no warrior companion;"},{"id":"manas-2010:p0824:b001:l041","ordinal":36403,"en":"My solace, Manas, blue-maned warrior,"},{"id":"manas-2010:p0824:b001:l042","ordinal":36404,"en":"I fear nothing but death."},{"id":"manas-2010:p0825:b001:l001","ordinal":36405,"en":"Alone like a pine tree,"},{"id":"manas-2010:p0825:b001:l002","ordinal":36406,"en":"I have no warrior but you."},{"id":"manas-2010:p0825:b001:l003","ordinal":36407,"en":"My companion Manas has been found;"},{"id":"manas-2010:p0825:b001:l004","ordinal":36408,"en":"Now I am at peace about everything else."},{"id":"manas-2010:p0825:b001:l005","ordinal":36409,"en":"The one I seek is Körpöyan;"},{"id":"manas-2010:p0825:b001:l006","ordinal":36410,"en":"I have no sorrow but that.’"},{"id":"manas-2010:p0825:b001:l007","ordinal":36411,"en":"Your elder Bakay said this,"},{"id":"manas-2010:p0825:b001:l008","ordinal":36412,"en":"Dismounted on a steep bank and stopped."},{"id":"manas-2010:p0825:b001:l009","ordinal":36413,"en":"His beloved came to mind,"},{"id":"manas-2010:p0825:b001:l010","ordinal":36414,"en":"Stirring his long-distant pain."},{"id":"manas-2010:p0825:b001:l011","ordinal":36415,"en":"No red remained in his face."},{"id":"manas-2010:p0825:b001:l012","ordinal":36416,"en":"His course was Chambyl-Bel;"},{"id":"manas-2010:p0825:b001:l013","ordinal":36417,"en":"Your champion elder Bakay"},{"id":"manas-2010:p0825:b001:l014","ordinal":36418,"en":"Was seized by his thirst for blood."},{"id":"manas-2010:p0825:b001:l015","ordinal":36419,"en":"His mighty sultan Manas"},{"id":"manas-2010:p0825:b001:l016","ordinal":36420,"en":"Now raised a shout."},{"id":"manas-2010:p0825:b001:l017","ordinal":36421,"en":"Booming as though an enemy had come,"},{"id":"manas-2010:p0825:b001:l018","ordinal":36422,"en":"The great war drum was struck hard."},{"id":"manas-2010:p0825:b001:l019","ordinal":36423,"en":"To charge when an enemy appeared"},{"id":"manas-2010:p0825:b001:l020","ordinal":36424,"en":"Was the forty companions' custom."},{"id":"manas-2010:p0825:b001:l021","ordinal":36425,"en":"Before Khan Bakay,"},{"id":"manas-2010:p0825:b001:l022","ordinal":36426,"en":"They came in a row and crowded in."},{"id":"manas-2010:p0825:b001:l023","ordinal":36427,"en":"Before lion Bakay,"},{"id":"manas-2010:p0825:b001:l024","ordinal":36428,"en":"Springing like a lion,"},{"id":"manas-2010:p0825:b001:l025","ordinal":36429,"en":"Khan Manas arrived,"},{"id":"manas-2010:p0825:b001:l026","ordinal":36430,"en":"Counsel coming from the unseen:"},{"id":"manas-2010:p0825:b001:l027","ordinal":36431,"en":"‘Precious Bakay, dear elder,"},{"id":"manas-2010:p0825:b001:l028","ordinal":36432,"en":"Today you have told your truth."},{"id":"manas-2010:p0825:b001:l029","ordinal":36433,"en":"Now you have spoken, dear elder,"},{"id":"manas-2010:p0825:b001:l030","ordinal":36434,"en":"The secret within your breast."},{"id":"manas-2010:p0825:b001:l031","ordinal":36435,"en":"Zhanaaly and Karach, the two khans—"},{"id":"manas-2010:p0825:b001:l032","ordinal":36436,"en":"If they will not accept these words,"},{"id":"manas-2010:p0825:b001:l033","ordinal":36437,"en":"If they will not give Körpöyan,"},{"id":"manas-2010:p0825:b001:l034","ordinal":36438,"en":"I shall plunder their goods,"},{"id":"manas-2010:p0825:b001:l035","ordinal":36439,"en":"Bring devastation upon them together."},{"id":"manas-2010:p0825:b001:l036","ordinal":36440,"en":"The steed Akkula and Aybanboz"},{"id":"manas-2010:p0825:b001:l037","ordinal":36441,"en":"I shall ride by turns."},{"id":"manas-2010:p0825:b001:l038","ordinal":36442,"en":"If they will not accept these words,"},{"id":"manas-2010:p0825:b001:l039","ordinal":36443,"en":"If they will not give Körpöyan,"},{"id":"manas-2010:p0825:b001:l040","ordinal":36444,"en":"Driving and slaughtering them all,"},{"id":"manas-2010:p0825:b001:l041","ordinal":36445,"en":"I shall pursue them as far as Mecca!’"},{"id":"manas-2010:p0825:b001:l042","ordinal":36446,"en":"Thus Khan Manas spoke,"},{"id":"manas-2010:p0826:b001:l001","ordinal":36447,"en":"Saying this to Khan Bakay:"},{"id":"manas-2010:p0826:b001:l002","ordinal":36448,"en":"‘You who joined what was broken,"},{"id":"manas-2010:p0826:b001:l003","ordinal":36449,"en":"Gathered what was scattered,"},{"id":"manas-2010:p0826:b001:l004","ordinal":36450,"en":"Led a soul and made him a warrior,"},{"id":"manas-2010:p0826:b001:l005","ordinal":36451,"en":"Made him the equal of warriors' sons,"},{"id":"manas-2010:p0826:b001:l006","ordinal":36452,"en":"My twin, Bakay, my mighty warrior!"},{"id":"manas-2010:p0826:b001:l007","ordinal":36453,"en":"If you look at me and speak, elder,"},{"id":"manas-2010:p0826:b001:l008","ordinal":36454,"en":"I shall simply obey you!"},{"id":"manas-2010:p0826:b001:l009","ordinal":36455,"en":"Look straight at me and send me into fire;"},{"id":"manas-2010:p0826:b001:l010","ordinal":36456,"en":"If I do not cross through it,"},{"id":"manas-2010:p0826:b001:l011","ordinal":36457,"en":"Lion elder, take my head!"},{"id":"manas-2010:p0826:b001:l012","ordinal":36458,"en":"For our sister-in-law they will not give when asked,"},{"id":"manas-2010:p0826:b001:l013","ordinal":36459,"en":"We shall cast a cold catching pole."},{"id":"manas-2010:p0826:b001:l014","ordinal":36460,"en":"If they stand stiffly and resist,"},{"id":"manas-2010:p0826:b001:l015","ordinal":36461,"en":"We shall charge and snatch her away!’"},{"id":"manas-2010:p0826:b001:l016","ordinal":36462,"en":"Thus Khan Manas spoke,"},{"id":"manas-2010:p0826:b001:l017","ordinal":36463,"en":"Sweeping across the open wilderness,"},{"id":"manas-2010:p0826:b001:l018","ordinal":36464,"en":"Black sands where no one could dwell—"},{"id":"manas-2010:p0826:b001:l019","ordinal":36465,"en":"He traveled through them now."},{"id":"manas-2010:p0826:b001:l020","ordinal":36466,"en":"At the hidden spring in the sands,"},{"id":"manas-2010:p0826:b001:l021","ordinal":36467,"en":"They watered their horses."},{"id":"manas-2010:p0826:b001:l023","ordinal":36468,"en":"They let their horses graze.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p0826:b001:l024","ordinal":36469,"en":"They chased wild asses,"},{"id":"manas-2010:p0826:b001:l025","ordinal":36470,"en":"Immersed themselves in many pleasures."},{"id":"manas-2010:p0826:b001:l026","ordinal":36471,"en":"Now Manas and Khan Bakay—"},{"id":"manas-2010:p0826:b001:l027","ordinal":36472,"en":"How could those warriors hold back?"},{"id":"manas-2010:p0826:b001:l028","ordinal":36473,"en":"Because of what had happened,"},{"id":"manas-2010:p0826:b001:l029","ordinal":36474,"en":"For Körpöyan's sake,"},{"id":"manas-2010:p0826:b001:l030","ordinal":36475,"en":"When they looked on this side,"},{"id":"manas-2010:p0826:b001:l031","ordinal":36476,"en":"It was the ridge of Belendi."},{"id":"manas-2010:p0826:b001:l032","ordinal":36477,"en":"When they looked beyond,"},{"id":"manas-2010:p0826:b001:l033","ordinal":36478,"en":"Haze beyond the reach of sight—"},{"id":"manas-2010:p0826:b001:l034","ordinal":36479,"en":"They called it the ridge of Chambyl."},{"id":"manas-2010:p0826:b001:l035","ordinal":36480,"en":"To the ridge of Belendi,"},{"id":"manas-2010:p0826:b001:l036","ordinal":36481,"en":"To the edge of great Chambyl,"},{"id":"manas-2010:p0826:b001:l037","ordinal":36482,"en":"The champions now made their way."},{"id":"manas-2010:p0826:b001:l038","ordinal":36483,"en":"One could never tire of its delights;"},{"id":"manas-2010:p0826:b001:l039","ordinal":36484,"en":"There was no land like this."},{"id":"manas-2010:p0826:b001:l040","ordinal":36485,"en":"If you would see marvels, see them here:"},{"id":"manas-2010:p0826:b001:l041","ordinal":36486,"en":"Wild sheep on its hills,"},{"id":"manas-2010:p0826:b001:l042","ordinal":36487,"en":"Wild goats on its terraces,"},{"id":"manas-2010:p0827:b001:l001","ordinal":36488,"en":"Deer dwell in its rough country;"},{"id":"manas-2010:p0827:b001:l002","ordinal":36489,"en":"Those who have not seen it have cause for sorrow."},{"id":"manas-2010:p0827:b001:l003","ordinal":36490,"en":"Foxes dwell upon its plains;"},{"id":"manas-2010:p0827:b001:l004","ordinal":36491,"en":"To gladden human hearts,"},{"id":"manas-2010:p0827:b001:l005","ordinal":36492,"en":"It holds the riches of every living creature."},{"id":"manas-2010:p0827:b001:l006","ordinal":36493,"en":"Golden, rolling slopes they were;"},{"id":"manas-2010:p0827:b001:l007","ordinal":36494,"en":"May I be their sacrifice!"},{"id":"manas-2010:p0827:b001:l008","ordinal":36495,"en":"A place for hunting expeditions."},{"id":"manas-2010:p0827:b001:l009","ordinal":36496,"en":"Was it not the choicest of lands?"},{"id":"manas-2010:p0827:b001:l010","ordinal":36497,"en":"Would not those dwelling there flourish?"},{"id":"manas-2010:p0827:b001:l011","ordinal":36498,"en":"When they reached the level ground,"},{"id":"manas-2010:p0827:b001:l012","ordinal":36499,"en":"Foxes fled in a streaming line."},{"id":"manas-2010:p0827:b001:l013","ordinal":36500,"en":"When they saw those foxes,"},{"id":"manas-2010:p0827:b001:l014","ordinal":36501,"en":"The forty mighty men, delighted,"},{"id":"manas-2010:p0827:b001:l015","ordinal":36502,"en":"Burst into laughter and rejoiced."},{"id":"manas-2010:p0827:b001:l016","ordinal":36503,"en":"A great, gently rounded, uneven height,"},{"id":"manas-2010:p0827:b001:l017","ordinal":36504,"en":"They called it Belendi Ridge."},{"id":"manas-2010:p0827:b001:l018","ordinal":36505,"en":"For Zhanaaly and Karach,"},{"id":"manas-2010:p0827:b001:l019","ordinal":36506,"en":"Running their hounds, seeking game,"},{"id":"manas-2010:p0827:b001:l020","ordinal":36507,"en":"It was a place they came in season."},{"id":"manas-2010:p0827:b001:l021","ordinal":36508,"en":"Frenziedly pursuing wild asses,"},{"id":"manas-2010:p0827:b001:l022","ordinal":36509,"en":"The two khans, Zhanaaly and Karach,"},{"id":"manas-2010:p0827:b001:l023","ordinal":36510,"en":"Made their sport in this place."},{"id":"manas-2010:p0827:b001:l024","ordinal":36511,"en":"And so that place"},{"id":"manas-2010:p0827:b001:l025","ordinal":36512,"en":"They called Belendi Ridge."},{"id":"manas-2010:p0827:b001:l026","ordinal":36513,"en":"To a saddle-shaped rise"},{"id":"manas-2010:p0827:b001:l027","ordinal":36514,"en":"The noble men climbed."},{"id":"manas-2010:p0827:b001:l028","ordinal":36515,"en":"If one sought the people's well-being,"},{"id":"manas-2010:p0827:b001:l029","ordinal":36516,"en":"There was no crow to caw,"},{"id":"manas-2010:p0827:b001:l030","ordinal":36517,"en":"There was no raven to croak."},{"id":"manas-2010:p0827:b001:l031","ordinal":36518,"en":"Looking across the empty plain,"},{"id":"manas-2010:p0827:b001:l032","ordinal":36519,"en":"Driving mountain sheep from the hills,"},{"id":"manas-2010:p0827:b001:l033","ordinal":36520,"en":"With five hundred men beside them,"},{"id":"manas-2010:p0827:b001:l034","ordinal":36521,"en":"They had come to hunt."},{"id":"manas-2010:p0827:b001:l035","ordinal":36522,"en":"A terrible, unhealing affliction,"},{"id":"manas-2010:p0827:b001:l036","ordinal":36523,"en":"They had come into the dust of battle."},{"id":"manas-2010:p0827:b001:l037","ordinal":36524,"en":"That they were Zhanaaly and Karach,"},{"id":"manas-2010:p0827:b001:l038","ordinal":36525,"en":"Resourceful Bakay now knew."},{"id":"manas-2010:p0827:b001:l039","ordinal":36526,"en":"“God has delivered the slave,” he said;"},{"id":"manas-2010:p0827:b001:l040","ordinal":36527,"en":"“He has come onto the empty plain,” he said,"},{"id":"manas-2010:p0827:b001:l041","ordinal":36528,"en":"And smiled beneath his moustache."},{"id":"manas-2010:p0827:b001:l042","ordinal":36529,"en":"Your elder Bakay, the exceptional lion,"},{"id":"manas-2010:p0828:b001:l001","ordinal":36530,"en":"“Manas! Manas!” he shouted,"},{"id":"manas-2010:p0828:b001:l002","ordinal":36531,"en":"Calling the mighty men:"},{"id":"manas-2010:p0828:b001:l003","ordinal":36532,"en":"“What was lost has been found;"},{"id":"manas-2010:p0828:b001:l004","ordinal":36533,"en":"Our honor is now preserved."},{"id":"manas-2010:p0828:b001:l005","ordinal":36534,"en":"Did you see what I saw?"},{"id":"manas-2010:p0828:b001:l006","ordinal":36535,"en":"Did you perceive what I perceived?"},{"id":"manas-2010:p0828:b001:l007","ordinal":36536,"en":"For the servant he wishes to favor,"},{"id":"manas-2010:p0828:b001:l008","ordinal":36537,"en":"He lays things ready upon the road."},{"id":"manas-2010:p0828:b001:l009","ordinal":36538,"en":"Your expedition has found good fortune;"},{"id":"manas-2010:p0828:b001:l010","ordinal":36539,"en":"Zhanaaly and Karach, the two khans,"},{"id":"manas-2010:p0828:b001:l011","ordinal":36540,"en":"Have appeared upon your road."},{"id":"manas-2010:p0828:b001:l012","ordinal":36541,"en":"Drawing bows to rain arrows,"},{"id":"manas-2010:p0828:b001:l013","ordinal":36542,"en":"Firing shots to hail bullets,"},{"id":"manas-2010:p0828:b001:l014","ordinal":36543,"en":"When Bakay was alone,"},{"id":"manas-2010:p0828:b001:l015","ordinal":36544,"en":"They brought him terrible suffering."},{"id":"manas-2010:p0828:b001:l017","ordinal":36545,"en":"He swept down and beset me.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p0828:b001:l018","ordinal":36546,"en":"Unable to inflict suffering alone,"},{"id":"manas-2010:p0828:b001:l019","ordinal":36547,"en":"Unable to take Körpöyan,"},{"id":"manas-2010:p0828:b001:l020","ordinal":36548,"en":"The humiliation Zhanaaly inflicted,"},{"id":"manas-2010:p0828:b001:l021","ordinal":36549,"en":"Let us show before his eyes"},{"id":"manas-2010:p0828:b001:l022","ordinal":36550,"en":"The violence he himself committed."},{"id":"manas-2010:p0828:b001:l023","ordinal":36551,"en":"Let us bring hell in full;"},{"id":"manas-2010:p0828:b001:l024","ordinal":36552,"en":"Striking him into a heap,"},{"id":"manas-2010:p0828:b001:l025","ordinal":36553,"en":"Let us seize Körpöyan."},{"id":"manas-2010:p0828:b001:l026","ordinal":36554,"en":"Without giving a joint of meat with its knuckle,"},{"id":"manas-2010:p0828:b001:l027","ordinal":36555,"en":"Without giving an orphaned bay-pied yearling,"},{"id":"manas-2010:p0828:b001:l028","ordinal":36556,"en":"Let us seize Körpöyan,"},{"id":"manas-2010:p0828:b001:l029","ordinal":36557,"en":"Let us place her behind the saddle."},{"id":"manas-2010:p0828:b001:l030","ordinal":36558,"en":"Taking Körpöyan by force,"},{"id":"manas-2010:p0828:b001:l031","ordinal":36559,"en":"“Here is the daughter you cherished,” we shall say."},{"id":"manas-2010:p0828:b001:l032","ordinal":36560,"en":"Let us make her a wife taken as booty;"},{"id":"manas-2010:p0828:b001:l033","ordinal":36561,"en":"“How do you like it?” we shall say and return."},{"id":"manas-2010:p0828:b001:l034","ordinal":36562,"en":"“We remain without a marriage rite,” we shall say;"},{"id":"manas-2010:p0828:b001:l035","ordinal":36563,"en":"Let us say exactly this."},{"id":"manas-2010:p0828:b001:l036","ordinal":36564,"en":"Drawing bows to rain arrows,"},{"id":"manas-2010:p0828:b001:l037","ordinal":36565,"en":"That doomed Zhanaaly,"},{"id":"manas-2010:p0828:b001:l038","ordinal":36566,"en":"When he attacked, made me suffer."},{"id":"manas-2010:p0828:b001:l039","ordinal":36567,"en":"Firing shots to hail bullets,"},{"id":"manas-2010:p0828:b001:l040","ordinal":36568,"en":"When they split up and swept down,"},{"id":"manas-2010:p0828:b001:l041","ordinal":36569,"en":"Your Bakay lost his strength."},{"id":"manas-2010:p0828:b001:l042","ordinal":36570,"en":"From his whole body then"},{"id":"manas-2010:p0829:b001:l001","ordinal":36571,"en":"Black blood flowed in great drops."},{"id":"manas-2010:p0829:b001:l002","ordinal":36572,"en":"A resourceful khan died for nothing."},{"id":"manas-2010:p0829:b001:l003","ordinal":36573,"en":"While battle cries were ringing,"},{"id":"manas-2010:p0829:b001:l004","ordinal":36574,"en":"All the spearmen died."},{"id":"manas-2010:p0829:b001:l005","ordinal":36575,"en":"Concerning those past events,"},{"id":"manas-2010:p0829:b001:l006","ordinal":36576,"en":"On account of Körpöyan,"},{"id":"manas-2010:p0829:b001:l007","ordinal":36577,"en":"I fought a mighty struggle."},{"id":"manas-2010:p0829:b001:l008","ordinal":36578,"en":"Curse being alone!"},{"id":"manas-2010:p0829:b001:l009","ordinal":36579,"en":"I left unable to know my own fate."},{"id":"manas-2010:p0829:b001:l010","ordinal":36580,"en":"I left then unable to take"},{"id":"manas-2010:p0829:b001:l011","ordinal":36581,"en":"Körpöyan, my noble wife.”"},{"id":"manas-2010:p0829:b001:l012","ordinal":36582,"en":"Your elder, old Bakay,"},{"id":"manas-2010:p0829:b001:l013","ordinal":36583,"en":"All those actions,"},{"id":"manas-2010:p0829:b001:l014","ordinal":36584,"en":"The saint recounted."},{"id":"manas-2010:p0829:b001:l015","ordinal":36585,"en":"At that time the companions'"},{"id":"manas-2010:p0829:b001:l016","ordinal":36586,"en":"Number had reached forty."},{"id":"manas-2010:p0829:b001:l017","ordinal":36587,"en":"When they saw an enemy in battle,"},{"id":"manas-2010:p0829:b001:l018","ordinal":36588,"en":"All forty companions,"},{"id":"manas-2010:p0829:b001:l019","ordinal":36589,"en":"Their elders headed by Kyrgyl,"},{"id":"manas-2010:p0829:b001:l020","ordinal":36590,"en":"Were accustomed to grind him like roasted flour."},{"id":"manas-2010:p0829:b001:l021","ordinal":36591,"en":"Standards fluttered in their hands;"},{"id":"manas-2010:p0829:b001:l022","ordinal":36592,"en":"All their weapons"},{"id":"manas-2010:p0829:b001:l023","ordinal":36593,"en":"Glittered at their sides."},{"id":"manas-2010:p0829:b001:l024","ordinal":36594,"en":"In their midst was mighty Manas,"},{"id":"manas-2010:p0829:b001:l025","ordinal":36595,"en":"Appearing like a towering mountain."},{"id":"manas-2010:p0829:b001:l026","ordinal":36596,"en":"The mighty ones of forty companions,"},{"id":"manas-2010:p0829:b001:l027","ordinal":36597,"en":"The skilled among spearmen,"},{"id":"manas-2010:p0829:b001:l028","ordinal":36598,"en":"The finest among sixty,"},{"id":"manas-2010:p0829:b001:l029","ordinal":36599,"en":"Ajybay and Bakay, the twin khans,"},{"id":"manas-2010:p0829:b001:l030","ordinal":36600,"en":"Yrchy and Shuutu, equal warriors,"},{"id":"manas-2010:p0829:b001:l031","ordinal":36601,"en":"Chalybay and Küldür, the twins,"},{"id":"manas-2010:p0829:b001:l032","ordinal":36602,"en":"Boz Uul and their Baychoro,"},{"id":"manas-2010:p0829:b001:l033","ordinal":36603,"en":"These among the forty companions,"},{"id":"manas-2010:p0829:b001:l034","ordinal":36604,"en":"If caught in red fire,"},{"id":"manas-2010:p0829:b001:l035","ordinal":36605,"en":"Would shout and thrust their spears."},{"id":"manas-2010:p0829:b001:l036","ordinal":36606,"en":"Hearing the battle cry,"},{"id":"manas-2010:p0829:b001:l037","ordinal":36607,"en":"Khan Manas's forty madmen,"},{"id":"manas-2010:p0829:b001:l038","ordinal":36608,"en":"Could they hold back from slaughter?"}]
