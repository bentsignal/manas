[{"id":"manas-2010:p1227:b001:l007","ordinal":53249,"en":"‘My Almambet has died,’"},{"id":"manas-2010:p1227:b001:l008","ordinal":53250,"en":"Tell the people, and lament me!"},{"id":"manas-2010:p1227:b001:l009","ordinal":53251,"en":"If you meet one at Adyrmak,"},{"id":"manas-2010:p1227:b001:l010","ordinal":53252,"en":"Shoot a wild sheep and eat it."},{"id":"manas-2010:p1227:b001:l011","ordinal":53253,"en":"‘My precious Almam, that outstanding man,"},{"id":"manas-2010:p1227:b001:l012","ordinal":53254,"en":"Has departed this world,’ say as you go."},{"id":"manas-2010:p1227:b001:l013","ordinal":53255,"en":"Making the horses thunder,"},{"id":"manas-2010:p1227:b001:l014","ordinal":53256,"en":"Chasing them by day and night,"},{"id":"manas-2010:p1227:b001:l015","ordinal":53257,"en":"Tie up your horse's tail and go."},{"id":"manas-2010:p1227:b001:l016","ordinal":53258,"en":"Let me tell you the utmost limit:"},{"id":"manas-2010:p1227:b001:l017","ordinal":53259,"en":"Grieve for seven days."},{"id":"manas-2010:p1227:b001:l018","ordinal":53260,"en":"If I remain away beyond seven days,"},{"id":"manas-2010:p1227:b001:l019","ordinal":53261,"en":"Scatter the horses you are driving."},{"id":"manas-2010:p1227:b001:l020","ordinal":53262,"en":"‘My lion Almam has died,’ say,"},{"id":"manas-2010:p1227:b001:l021","ordinal":53263,"en":"And without turning back,"},{"id":"manas-2010:p1227:b001:l022","ordinal":53264,"en":"Flee toward your generous lord."},{"id":"manas-2010:p1227:b001:l023","ordinal":53265,"en":"If you reach Talas safely, tell them:"},{"id":"manas-2010:p1227:b001:l024","ordinal":53266,"en":"‘My one and only Almam has died.’"},{"id":"manas-2010:p1227:b001:l025","ordinal":53267,"en":"Tell my friend, my lion Manas."},{"id":"manas-2010:p1227:b001:l026","ordinal":53268,"en":"That vast expanse lying gray"},{"id":"manas-2010:p1227:b001:l027","ordinal":53269,"en":"Is no mountain to cross without reckoning."},{"id":"manas-2010:p1227:b001:l028","ordinal":53270,"en":"Cotton belt and broad boots—"},{"id":"manas-2010:p1227:b001:l029","ordinal":53271,"en":"Kongurbay, khan of the shaven-headed ones,"},{"id":"manas-2010:p1227:b001:l030","ordinal":53272,"en":"Let me speak without belittling him:"},{"id":"manas-2010:p1227:b001:l031","ordinal":53273,"en":"Apart from his being an infidel,"},{"id":"manas-2010:p1227:b001:l032","ordinal":53274,"en":"He is no enemy to despise.”"},{"id":"manas-2010:p1227:b001:l033","ordinal":53275,"en":"Having said this, Almambet"},{"id":"manas-2010:p1227:b001:l034","ordinal":53276,"en":"Turned Sarala around."},{"id":"manas-2010:p1227:b001:l035","ordinal":53277,"en":"Wheeling boldly,"},{"id":"manas-2010:p1227:b001:l036","ordinal":53278,"en":"He stood alone for single combat."},{"id":"manas-2010:p1227:b001:l037","ordinal":53279,"en":"Shouting with all his life,"},{"id":"manas-2010:p1227:b001:l038","ordinal":53280,"en":"Behind Kartküröng,"},{"id":"manas-2010:p1227:b001:l039","ordinal":53281,"en":"The seething multitude of horses—"},{"id":"manas-2010:p1227:b001:l040","ordinal":53282,"en":"Syrgak, that fierce-maned leopard hero,"},{"id":"manas-2010:p1227:b001:l041","ordinal":53283,"en":"Was driving them onward in a rush,"},{"id":"manas-2010:p1227:b001:l042","ordinal":53284,"en":"Sweeping the horses along,"},{"id":"manas-2010:p1228:b001:l001","ordinal":53285,"en":"Driving them toward the Muslim lands."},{"id":"manas-2010:p1228:b001:l002","ordinal":53286,"en":"In this world, livestock's loss is bitter."},{"id":"manas-2010:p1228:b001:l003","ordinal":53287,"en":"Kongurbay, son of Alöökö,"},{"id":"manas-2010:p1228:b001:l004","ordinal":53288,"en":"Following the horses' trail,"},{"id":"manas-2010:p1228:b001:l005","ordinal":53289,"en":"The great Fierce One came,"},{"id":"manas-2010:p1228:b001:l006","ordinal":53290,"en":"Raising the cry, “Single combat!”"},{"id":"manas-2010:p1228:b001:l007","ordinal":53291,"en":"Beneath him as he rode"},{"id":"manas-2010:p1228:b001:l008","ordinal":53292,"en":"Was the black horse Algara."},{"id":"manas-2010:p1228:b001:l009","ordinal":53293,"en":"His black horse possessed"},{"id":"manas-2010:p1228:b001:l010","ordinal":53294,"en":"Wings upon its flanks."},{"id":"manas-2010:p1228:b001:l011","ordinal":53295,"en":"Always, the whole world—"},{"id":"manas-2010:p1228:b001:l012","ordinal":53296,"en":"Alöökö's Fierce One"},{"id":"manas-2010:p1228:b001:l013","ordinal":53297,"en":"Was accustomed to grind it like meal."},{"id":"manas-2010:p1228:b001:l014","ordinal":53298,"en":"A fellow skilled among spearmen,"},{"id":"manas-2010:p1228:b001:l015","ordinal":53299,"en":"However thick the enemy host,"},{"id":"manas-2010:p1228:b001:l016","ordinal":53300,"en":"An able fellow who knew how to deal with it."},{"id":"manas-2010:p1228:b001:l017","ordinal":53301,"en":"Making Algara surge,"},{"id":"manas-2010:p1228:b001:l018","ordinal":53302,"en":"Unable to contain his fury,"},{"id":"manas-2010:p1228:b001:l019","ordinal":53303,"en":"The earth shook and thundered;"},{"id":"manas-2010:p1228:b001:l020","ordinal":53304,"en":"Those who heard his voice could not stand,"},{"id":"manas-2010:p1228:b001:l021","ordinal":53305,"en":"Their whole bodies shuddering."},{"id":"manas-2010:p1228:b001:l022","ordinal":53306,"en":"Algara beneath him"},{"id":"manas-2010:p1228:b001:l023","ordinal":53307,"en":"Had lowered his head to the ground."},{"id":"manas-2010:p1228:b001:l024","ordinal":53308,"en":"As though an evil spirit had seized his wife,"},{"id":"manas-2010:p1228:b001:l025","ordinal":53309,"en":"As though his enemy were fleeing close by,"},{"id":"manas-2010:p1228:b001:l026","ordinal":53310,"en":"Your Chinese warrior raged;"},{"id":"manas-2010:p1228:b001:l027","ordinal":53311,"en":"God had struck him down."},{"id":"manas-2010:p1228:b001:l028","ordinal":53312,"en":"Roaring as he descended to the foothills,"},{"id":"manas-2010:p1228:b001:l029","ordinal":53313,"en":"Raising his battle-cry, “Möndü!”"},{"id":"manas-2010:p1228:b001:l030","ordinal":53314,"en":"“Even if he has seventy lives,"},{"id":"manas-2010:p1228:b001:l031","ordinal":53315,"en":"I shall seize him by the hand!"},{"id":"manas-2010:p1228:b001:l032","ordinal":53316,"en":"When I meet the Burut,"},{"id":"manas-2010:p1228:b001:l033","ordinal":53317,"en":"I shall cut off his head!"},{"id":"manas-2010:p1228:b001:l034","ordinal":53318,"en":"The Burut who attacked us himself—"},{"id":"manas-2010:p1228:b001:l035","ordinal":53319,"en":"I shall trample upon his crown!"},{"id":"manas-2010:p1228:b001:l036","ordinal":53320,"en":"Whoever has come along this road,"},{"id":"manas-2010:p1228:b001:l037","ordinal":53321,"en":"I shall seize him and spill his blood!"},{"id":"manas-2010:p1228:b001:l038","ordinal":53322,"en":"I shall slaughter the Buruts!"},{"id":"manas-2010:p1228:b001:l039","ordinal":53323,"en":"First I shall reach my horses"},{"id":"manas-2010:p1228:b001:l040","ordinal":53324,"en":"And rescue them!” he said."},{"id":"manas-2010:p1228:b001:l041","ordinal":53325,"en":"Kongurbay came behind,"},{"id":"manas-2010:p1228:b001:l042","ordinal":53326,"en":"Thundering like the sun,"},{"id":"manas-2010:p1229:b001:l001","ordinal":53327,"en":"Almambet stood watching,"},{"id":"manas-2010:p1229:b001:l002","ordinal":53328,"en":"His whole body shuddering."},{"id":"manas-2010:p1229:b001:l003","ordinal":53329,"en":"“Without matching myself against the governor,"},{"id":"manas-2010:p1229:b001:l004","ordinal":53330,"en":"What if I simply went on?"},{"id":"manas-2010:p1229:b001:l005","ordinal":53331,"en":"By merely going on, away from the infidel,"},{"id":"manas-2010:p1229:b001:l006","ordinal":53332,"en":"What desire would I fulfill?"},{"id":"manas-2010:p1229:b001:l007","ordinal":53333,"en":"If doom should come unexpectedly,"},{"id":"manas-2010:p1229:b001:l008","ordinal":53334,"en":"Let me die at the infidel's hands!"},{"id":"manas-2010:p1229:b001:l009","ordinal":53335,"en":"If I live, grant me strength;"},{"id":"manas-2010:p1229:b001:l010","ordinal":53336,"en":"If I die, grant me faith!”"},{"id":"manas-2010:p1229:b001:l011","ordinal":53337,"en":"Striking Sarala once on the thigh,"},{"id":"manas-2010:p1229:b001:l012","ordinal":53338,"en":"Shouting, “Manas! Manas!”"},{"id":"manas-2010:p1229:b001:l013","ordinal":53339,"en":"Raising “Manas!” as his battle-cry,"},{"id":"manas-2010:p1229:b001:l014","ordinal":53340,"en":"His voice deafened the ears."},{"id":"manas-2010:p1229:b001:l015","ordinal":53341,"en":"Gripping his lacquered lance firmly,"},{"id":"manas-2010:p1229:b001:l016","ordinal":53342,"en":"Holding it steadily out,"},{"id":"manas-2010:p1229:b001:l017","ordinal":53343,"en":"Fire flashed from his eyes;"},{"id":"manas-2010:p1229:b001:l018","ordinal":53344,"en":"His clenched teeth ground together;"},{"id":"manas-2010:p1229:b001:l019","ordinal":53345,"en":"His ribs creaked;"},{"id":"manas-2010:p1229:b001:l020","ordinal":53346,"en":"The earth split and rumbled."},{"id":"manas-2010:p1229:b001:l021","ordinal":53347,"en":"Heading straight for Kongurbay,"},{"id":"manas-2010:p1229:b001:l022","ordinal":53348,"en":"Azizkhan's only son"},{"id":"manas-2010:p1229:b001:l023","ordinal":53349,"en":"Came on, thundering."},{"id":"manas-2010:p1229:b001:l024","ordinal":53350,"en":"Thrusting without mercy,"},{"id":"manas-2010:p1229:b001:l025","ordinal":53351,"en":"Striking this way and that,"},{"id":"manas-2010:p1229:b001:l026","ordinal":53352,"en":"The two lions roared,"},{"id":"manas-2010:p1229:b001:l027","ordinal":53353,"en":"Tugging wherever they could seize,"},{"id":"manas-2010:p1229:b001:l028","ordinal":53354,"en":"Wrenching at each other from horseback."},{"id":"manas-2010:p1229:b001:l029","ordinal":53355,"en":"That your Almam would not be overcome—"},{"id":"manas-2010:p1229:b001:l030","ordinal":53356,"en":"When Kongurbay the Fierce One realized this,"},{"id":"manas-2010:p1229:b001:l031","ordinal":53357,"en":"He resorted to a stratagem."},{"id":"manas-2010:p1229:b001:l032","ordinal":53358,"en":"From a saddle-shaped ridge,"},{"id":"manas-2010:p1229:b001:l033","ordinal":53359,"en":"Bending low, he darted off;"},{"id":"manas-2010:p1229:b001:l034","ordinal":53360,"en":"Before Almambet"},{"id":"manas-2010:p1229:b001:l035","ordinal":53361,"en":"He spurred away, pretending to flee."},{"id":"manas-2010:p1229:b001:l036","ordinal":53362,"en":"Kongurbay's Algara,"},{"id":"manas-2010:p1229:b001:l037","ordinal":53363,"en":"At the cry of “Go!” raced away."},{"id":"manas-2010:p1229:b001:l038","ordinal":53364,"en":"When they came to a downward slope,"},{"id":"manas-2010:p1229:b001:l039","ordinal":53365,"en":"The great Fierce One's Algara"},{"id":"manas-2010:p1229:b001:l040","ordinal":53366,"en":"Planted his forelegs like a roe deer."},{"id":"manas-2010:p1229:b001:l041","ordinal":53367,"en":"When they began to climb,"},{"id":"manas-2010:p1229:b001:l042","ordinal":53368,"en":"Almambet's Sarala,"},{"id":"manas-2010:p1230:b001:l001","ordinal":53369,"en":"His mane and tail streaming,"},{"id":"manas-2010:p1230:b001:l002","ordinal":53370,"en":"When they began to descend,"},{"id":"manas-2010:p1230:b001:l003","ordinal":53371,"en":"Your infidel's Algara"},{"id":"manas-2010:p1230:b001:l004","ordinal":53372,"en":"Drew far ahead, flashing away."},{"id":"manas-2010:p1230:b001:l005","ordinal":53373,"en":"When they turned uphill,"},{"id":"manas-2010:p1230:b001:l006","ordinal":53374,"en":"Dear Almambet's Sarala"},{"id":"manas-2010:p1230:b001:l007","ordinal":53375,"en":"Caught up close at his heels."},{"id":"manas-2010:p1230:b001:l008","ordinal":53376,"en":"When the road reached an escarpment,"},{"id":"manas-2010:p1230:b001:l009","ordinal":53377,"en":"Azizkhan's Almambet"},{"id":"manas-2010:p1230:b001:l010","ordinal":53378,"en":"Arrived faster than an arrow."},{"id":"manas-2010:p1230:b001:l011","ordinal":53379,"en":"At the front of the ribs,"},{"id":"manas-2010:p1230:b001:l012","ordinal":53380,"en":"At the moonlike edge of the shoulder-blade,"},{"id":"manas-2010:p1230:b001:l013","ordinal":53381,"en":"As soon as dear Almambet reached him,"},{"id":"manas-2010:p1230:b001:l014","ordinal":53382,"en":"Without looking up or down,"},{"id":"manas-2010:p1230:b001:l015","ordinal":53383,"en":"Without thinking he might die,"},{"id":"manas-2010:p1230:b001:l016","ordinal":53384,"en":"He reached him and thrust as he passed."},{"id":"manas-2010:p1230:b001:l017","ordinal":53385,"en":"When he reached and struck him,"},{"id":"manas-2010:p1230:b001:l018","ordinal":53386,"en":"When he brought disaster upon him,"},{"id":"manas-2010:p1230:b001:l019","ordinal":53387,"en":"The man left his saddle;"},{"id":"manas-2010:p1230:b001:l020","ordinal":53388,"en":"His feet left the stirrups."},{"id":"manas-2010:p1230:b001:l021","ordinal":53389,"en":"He drove his thrust firmly home;"},{"id":"manas-2010:p1230:b001:l022","ordinal":53390,"en":"The mountain-sized Fierce One"},{"id":"manas-2010:p1230:b001:l023","ordinal":53391,"en":"He lifted upward, bent double;"},{"id":"manas-2010:p1230:b001:l024","ordinal":53392,"en":"Azizkhan's only son"},{"id":"manas-2010:p1230:b001:l025","ordinal":53393,"en":"Sent him onto the withers."},{"id":"manas-2010:p1230:b001:l026","ordinal":53394,"en":"His brow and face contorted:"},{"id":"manas-2010:p1230:b001:l027","ordinal":53395,"en":"“God has cursed my horse!” he said."},{"id":"manas-2010:p1230:b001:l028","ordinal":53396,"en":"Algara beneath him—"},{"id":"manas-2010:p1230:b001:l029","ordinal":53397,"en":"He quarreled with it,"},{"id":"manas-2010:p1230:b001:l030","ordinal":53398,"en":"Fleeing and crying, “My back!"},{"id":"manas-2010:p1230:b001:l031","ordinal":53399,"en":"That cursed lance of his—"},{"id":"manas-2010:p1230:b001:l032","ordinal":53400,"en":"If he swings it once, it will finish me!”"},{"id":"manas-2010:p1230:b001:l033","ordinal":53401,"en":"The Fierce One lost his wits;"},{"id":"manas-2010:p1230:b001:l034","ordinal":53402,"en":"Toward red sand waist-deep"},{"id":"manas-2010:p1230:b001:l035","ordinal":53403,"en":"He fled."},{"id":"manas-2010:p1230:b001:l036","ordinal":53404,"en":"When they reached the red sand,"},{"id":"manas-2010:p1230:b001:l037","ordinal":53405,"en":"Having had no rest by day,"},{"id":"manas-2010:p1230:b001:l038","ordinal":53406,"en":"Having had no sleep at night,"},{"id":"manas-2010:p1230:b001:l039","ordinal":53407,"en":"Since leaving broad Talas,"},{"id":"manas-2010:p1230:b001:l040","ordinal":53408,"en":"Not cropping even a fescue tip,"},{"id":"manas-2010:p1230:b001:l041","ordinal":53409,"en":"The noble beast, day and night,"},{"id":"manas-2010:p1230:b001:l042","ordinal":53410,"en":"Had taken neither pause nor rest."},{"id":"manas-2010:p1231:b001:l001","ordinal":53411,"en":"Kongurbay devised a trick;"},{"id":"manas-2010:p1231:b001:l002","ordinal":53412,"en":"Did you see how he arranged it?"},{"id":"manas-2010:p1231:b001:l003","ordinal":53413,"en":"When he fled into the sand,"},{"id":"manas-2010:p1231:b001:l004","ordinal":53414,"en":"Almambet's Sarala"},{"id":"manas-2010:p1231:b001:l005","ordinal":53415,"en":"Could not manage—did you see?"},{"id":"manas-2010:p1231:b001:l006","ordinal":53416,"en":"Darting into the sand,"},{"id":"manas-2010:p1231:b001:l007","ordinal":53417,"en":"The Fierce One spurred harder onward."},{"id":"manas-2010:p1231:b001:l008","ordinal":53418,"en":"That Sarala had grown tired,"},{"id":"manas-2010:p1231:b001:l009","ordinal":53419,"en":"Kongurbay the Fierce One now understood."},{"id":"manas-2010:p1231:b001:l010","ordinal":53420,"en":"“God is giving me the fugitive,” he said,"},{"id":"manas-2010:p1231:b001:l011","ordinal":53421,"en":"And chuckled to himself."},{"id":"manas-2010:p1231:b001:l012","ordinal":53422,"en":"Alöökö's giant Fierce One,"},{"id":"manas-2010:p1231:b001:l013","ordinal":53423,"en":"Beating the war-drum,"},{"id":"manas-2010:p1231:b001:l014","ordinal":53424,"en":"Upon a steed like Algara,"},{"id":"manas-2010:p1231:b001:l015","ordinal":53425,"en":"Across the flesh of its flank,"},{"id":"manas-2010:p1231:b001:l016","ordinal":53426,"en":"With his whip, without mercy,"},{"id":"manas-2010:p1231:b001:l017","ordinal":53427,"en":"Striking again and again,"},{"id":"manas-2010:p1231:b001:l018","ordinal":53428,"en":"Kongurbay, mounted on his winged steed,"},{"id":"manas-2010:p1231:b001:l019","ordinal":53429,"en":"At the cry of “Go!” vanished;"},{"id":"manas-2010:p1231:b001:l020","ordinal":53430,"en":"Wheeling around, behind your Almam"},{"id":"manas-2010:p1231:b001:l021","ordinal":53431,"en":"He took up the chase in earnest."},{"id":"manas-2010:p1231:b001:l022","ordinal":53432,"en":"On Outer Beijing's plain,"},{"id":"manas-2010:p1231:b001:l023","ordinal":53433,"en":"The mountain-sized Fierce One caught up."},{"id":"manas-2010:p1231:b001:l024","ordinal":53434,"en":"“The very bone of his spine,” he said,"},{"id":"manas-2010:p1231:b001:l025","ordinal":53435,"en":"“The place of lungs and liver!”"},{"id":"manas-2010:p1231:b001:l026","ordinal":53436,"en":"Giving Algara momentum,"},{"id":"manas-2010:p1231:b001:l027","ordinal":53437,"en":"Kongurbay, that skilled spearman,"},{"id":"manas-2010:p1231:b001:l028","ordinal":53438,"en":"Struck once with his lance;"},{"id":"manas-2010:p1231:b001:l029","ordinal":53439,"en":"A fierce-maned man like Almambet—"},{"id":"manas-2010:p1231:b001:l030","ordinal":53440,"en":"He made him see his very life before his eyes."},{"id":"manas-2010:p1231:b001:l031","ordinal":53441,"en":"Kongurbay's thrust bent him down,"},{"id":"manas-2010:p1231:b001:l032","ordinal":53442,"en":"Sending him onto the withers."},{"id":"manas-2010:p1231:b001:l033","ordinal":53443,"en":"The man left his saddle;"},{"id":"manas-2010:p1231:b001:l034","ordinal":53444,"en":"His feet left the stirrups."},{"id":"manas-2010:p1231:b001:l035","ordinal":53445,"en":"Bracing himself, clawing back,"},{"id":"manas-2010:p1231:b001:l036","ordinal":53446,"en":"Almambet struggled for his life."},{"id":"manas-2010:p1231:b001:l037","ordinal":53447,"en":"Leaning backward, eyes staring,"},{"id":"manas-2010:p1231:b001:l038","ordinal":53448,"en":"He gripped the crupper."},{"id":"manas-2010:p1231:b001:l039","ordinal":53449,"en":"Sarala came running;"},{"id":"manas-2010:p1231:b001:l040","ordinal":53450,"en":"Azizkhan's Almambet"},{"id":"manas-2010:p1231:b001:l041","ordinal":53451,"en":"Despaired of his one life."},{"id":"manas-2010:p1231:b001:l042","ordinal":53452,"en":"The great Fierce One sprang and thrust,"},{"id":"manas-2010:p1232:b001:l001","ordinal":53453,"en":"Coming to lay him low."},{"id":"manas-2010:p1232:b001:l002","ordinal":53454,"en":"The black cliff beneath him"},{"id":"manas-2010:p1232:b001:l003","ordinal":53455,"en":"Carried him alongside,"},{"id":"manas-2010:p1232:b001:l004","ordinal":53456,"en":"And he came to knock him down."},{"id":"manas-2010:p1232:b001:l005","ordinal":53457,"en":"“Oh, Creator, grant me strength!"},{"id":"manas-2010:p1232:b001:l006","ordinal":53458,"en":"My daylight has become black night."},{"id":"manas-2010:p1232:b001:l007","ordinal":53459,"en":"At a fierce man like Kongurbay's hands"},{"id":"manas-2010:p1232:b001:l008","ordinal":53460,"en":"This is the day my doom will come."},{"id":"manas-2010:p1232:b001:l009","ordinal":53461,"en":"When will he work some marvel,"},{"id":"manas-2010:p1232:b001:l010","ordinal":53462,"en":"My black steel's keen edge,"},{"id":"manas-2010:p1232:b001:l011","ordinal":53463,"en":"My darling Syrgak?"},{"id":"manas-2010:p1232:b001:l012","ordinal":53464,"en":"When will he arrive and his elder brother"},{"id":"manas-2010:p1232:b001:l013","ordinal":53465,"en":"Tear free?"},{"id":"manas-2010:p1232:b001:l014","ordinal":53466,"en":"If he does not rescue me,"},{"id":"manas-2010:p1232:b001:l015","ordinal":53467,"en":"I shall know his foolishness."},{"id":"manas-2010:p1232:b001:l016","ordinal":53468,"en":"If the coming day is true,"},{"id":"manas-2010:p1232:b001:l017","ordinal":53469,"en":"I shall make him a donkey and ride him.”"},{"id":"manas-2010:p1232:b001:l018","ordinal":53470,"en":"Thinking this, Almambet"},{"id":"manas-2010:p1232:b001:l019","ordinal":53471,"en":"Despaired of his precious life."},{"id":"manas-2010:p1232:b001:l020","ordinal":53472,"en":"Hero Syrgak had stayed behind the herd,"},{"id":"manas-2010:p1232:b001:l021","ordinal":53473,"en":"Watching Almambet;"},{"id":"manas-2010:p1232:b001:l022","ordinal":53474,"en":"He had been keeping an eye on him."},{"id":"manas-2010:p1232:b001:l023","ordinal":53475,"en":"“What will become of my Almam?”"},{"id":"manas-2010:p1232:b001:l024","ordinal":53476,"en":"He had been burning with concern!"},{"id":"manas-2010:p1232:b001:l025","ordinal":53477,"en":"When he saw Almambet,"},{"id":"manas-2010:p1232:b001:l026","ordinal":53478,"en":"And the Fierce One thrusting from behind—"},{"id":"manas-2010:p1232:b001:l027","ordinal":53479,"en":"When watchful Syrgak saw this,"},{"id":"manas-2010:p1232:b001:l028","ordinal":53480,"en":"He sent Kökchebich flying,"},{"id":"manas-2010:p1232:b001:l029","ordinal":53481,"en":"Without looking all around,"},{"id":"manas-2010:p1232:b001:l030","ordinal":53482,"en":"Not sparing his ocean-vast life."},{"id":"manas-2010:p1232:b001:l031","ordinal":53483,"en":"“If I live on without dying,"},{"id":"manas-2010:p1232:b001:l032","ordinal":53484,"en":"What desire would I fulfill?"},{"id":"manas-2010:p1232:b001:l033","ordinal":53485,"en":"Having let Almambet be killed,"},{"id":"manas-2010:p1232:b001:l034","ordinal":53486,"en":"Without fighting the Fierce One,"},{"id":"manas-2010:p1232:b001:l035","ordinal":53487,"en":"How could I return?”"},{"id":"manas-2010:p1232:b001:l036","ordinal":53488,"en":"The brim of the black felt hat—"},{"id":"manas-2010:p1232:b001:l037","ordinal":53489,"en":"From where he came, no one knew:"},{"id":"manas-2010:p1232:b001:l038","ordinal":53490,"en":"Khan Manas's Syrgak."},{"id":"manas-2010:p1232:b001:l039","ordinal":53491,"en":"Charging from the flank,"},{"id":"manas-2010:p1232:b001:l040","ordinal":53492,"en":"He arrived faster than an arrow."},{"id":"manas-2010:p1232:b001:l041","ordinal":53493,"en":"“The lungs and liver themselves,” he said,"},{"id":"manas-2010:p1232:b001:l042","ordinal":53494,"en":"“Right at the place of the heart!”"},{"id":"manas-2010:p1233:b001:l001","ordinal":53495,"en":"The huge, looming Fierce One"},{"id":"manas-2010:p1233:b001:l002","ordinal":53496,"en":"He struck hard as he passed."},{"id":"manas-2010:p1233:b001:l003","ordinal":53497,"en":"The lacquered lance hit from the side;"},{"id":"manas-2010:p1233:b001:l004","ordinal":53498,"en":"Two paired ribs"},{"id":"manas-2010:p1233:b001:l005","ordinal":53499,"en":"Shattered and broke."},{"id":"manas-2010:p1233:b001:l006","ordinal":53500,"en":"When Syrgak thrust and passed,"},{"id":"manas-2010:p1233:b001:l007","ordinal":53501,"en":"The mountain-sized Fierce One's"},{"id":"manas-2010:p1233:b001:l008","ordinal":53502,"en":"Feet left the stirrups;"},{"id":"manas-2010:p1233:b001:l009","ordinal":53503,"en":"The man left his saddle;"},{"id":"manas-2010:p1233:b001:l010","ordinal":53504,"en":"His strength to move was gone."}]
