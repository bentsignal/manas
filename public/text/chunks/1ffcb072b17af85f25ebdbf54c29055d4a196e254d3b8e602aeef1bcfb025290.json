[{"id":"sayakbay-ms-current145:pdf042:l027","ordinal":389121,"en":"With the prosperous household,"},{"id":"sayakbay-ms-current145:pdf042:l028","ordinal":389122,"en":"With the unfortunate hero Kairy,"},{"id":"sayakbay-ms-current145:pdf042:l029","ordinal":389123,"en":"With the mighty champion-warrior,"},{"id":"sayakbay-ms-current145:pdf042:l030","ordinal":389124,"en":"They had continued without being able to prevail,"},{"id":"sayakbay-ms-current145:pdf042:l031","ordinal":389125,"en":"Preparing Jardyger’s army,"},{"id":"sayakbay-ms-current145:pdf042:l032","ordinal":389126,"en":"The champion Jayy was there,"},{"id":"sayakbay-ms-current145:pdf042:l033","ordinal":389127,"en":"The hero’s valiant son arrived,"},{"id":"sayakbay-ms-current145:pdf043:l001","ordinal":389128,"en":"Kulansur and Kuluker"},{"id":"sayakbay-ms-current145:pdf043:l002","ordinal":389129,"en":"The charger had suffered"},{"id":"sayakbay-ms-current145:pdf043:l003","ordinal":389130,"en":"For four days without rest"},{"id":"sayakbay-ms-current145:pdf043:l004","ordinal":389131,"en":"Sitting after making one victory known"},{"id":"sayakbay-ms-current145:pdf043:l005","ordinal":389132,"en":"If the separated thousands were true"},{"id":"sayakbay-ms-current145:pdf043:l006","ordinal":389133,"en":"Saying he passed ahead of them"},{"id":"sayakbay-ms-current145:pdf043:l007","ordinal":389134,"en":"The two chargers surged"},{"id":"sayakbay-ms-current145:pdf043:l008","ordinal":389135,"en":"The horses’ labor numbered in thousands"},{"id":"sayakbay-ms-current145:pdf043:l009","ordinal":389136,"en":"Straining along the road"},{"id":"sayakbay-ms-current145:pdf043:l010","ordinal":389137,"en":"If the road led toward China"},{"id":"sayakbay-ms-current145:pdf043:l011","ordinal":389138,"en":"He led the road without delay"},{"id":"sayakbay-ms-current145:pdf043:l012","ordinal":389139,"en":"Against the mass of enemies"},{"id":"sayakbay-ms-current145:pdf043:l013","ordinal":389140,"en":"His people were separated between them"},{"id":"sayakbay-ms-current145:pdf043:l014","ordinal":389141,"en":"He returned again to Talas"},{"id":"sayakbay-ms-current145:pdf043:l015","ordinal":389142,"en":"Keeping the court and becoming khan"},{"id":"sayakbay-ms-current145:pdf043:l016","ordinal":389143,"en":"Alive in thirty places"},{"id":"sayakbay-ms-current145:pdf043:l017","ordinal":389144,"en":"Taking a letter from the Kalmyks"},{"id":"sayakbay-ms-current145:pdf043:l018","ordinal":389145,"en":"Traveling through many lands"},{"id":"sayakbay-ms-current145:pdf043:l019","ordinal":389146,"en":"His thoughts divided among the people"},{"id":"sayakbay-ms-current145:pdf043:l020","ordinal":389147,"en":"He was named the hero Kenen"},{"id":"sayakbay-ms-current145:pdf043:l021","ordinal":389148,"en":"Pouring blood into the black water"},{"id":"sayakbay-ms-current145:pdf043:l022","ordinal":389149,"en":"Setting fire to the land of booty"},{"id":"sayakbay-ms-current145:pdf043:l023","ordinal":389150,"en":"Traveling and gathering lions"},{"id":"sayakbay-ms-current145:pdf043:l024","ordinal":389151,"en":"The Chinese awaited warriors"},{"id":"sayakbay-ms-current145:pdf043:l025","ordinal":389152,"en":"Counting their strength, they broke apart"},{"id":"sayakbay-ms-current145:pdf043:l026","ordinal":389153,"en":"Their countless treasure was exhausted"},{"id":"sayakbay-ms-current145:pdf043:l027","ordinal":389154,"en":"Sating them with yellow gold"},{"id":"sayakbay-ms-current145:pdf043:l028","ordinal":389155,"en":"Enriching them with brown horses"},{"id":"sayakbay-ms-current145:pdf043:l029","ordinal":389156,"en":"All that belonged to Kulansur"},{"id":"sayakbay-ms-current145:pdf043:l030","ordinal":389157,"en":"Mounting the blue Altai horse"},{"id":"sayakbay-ms-current145:pdf043:l031","ordinal":389158,"en":"Keeping the charger ready"},{"id":"sayakbay-ms-current145:pdf043:l032","ordinal":389159,"en":"Becoming known to the ancestral people"},{"id":"sayakbay-ms-current145:pdf044:l001","ordinal":389160,"en":"Would any person face him"},{"id":"sayakbay-ms-current145:pdf044:l004","ordinal":389161,"en":"When mighty Kiten heard this"},{"id":"sayakbay-ms-current145:pdf044:l005","ordinal":389162,"en":"After hearing news from Bilgich"},{"id":"sayakbay-ms-current145:pdf044:l006","ordinal":389163,"en":"His eyes filled with tears"},{"id":"sayakbay-ms-current145:pdf044:l007","ordinal":389164,"en":"Gathering the Kalmyks and preparing"},{"id":"sayakbay-ms-current145:pdf044:l008","ordinal":389165,"en":"It was a grief to thousands"},{"id":"sayakbay-ms-current145:pdf044:l009","ordinal":389166,"en":"The people were pledged to sorrow"},{"id":"sayakbay-ms-current145:pdf044:l010","ordinal":389167,"en":"When several years had passed"},{"id":"sayakbay-ms-current145:pdf044:l011","ordinal":389168,"en":"From Kakan who ruled the Chinese"},{"id":"sayakbay-ms-current145:pdf044:l012","ordinal":389169,"en":"Gathering his great host"},{"id":"sayakbay-ms-current145:pdf044:l013","ordinal":389170,"en":"Of the Chinese in motley coats"},{"id":"sayakbay-ms-current145:pdf044:l014","ordinal":389171,"en":"A harsh burden befell them"},{"id":"sayakbay-ms-current145:pdf044:l015","ordinal":389172,"en":"Against the wretched Burut"},{"id":"sayakbay-ms-current145:pdf044:l016","ordinal":389173,"en":"To bring about his end"},{"id":"sayakbay-ms-current145:pdf044:l017","ordinal":389174,"en":"No man could reach him"},{"id":"sayakbay-ms-current145:pdf044:l018","ordinal":389175,"en":"A tiger descended to play"},{"id":"sayakbay-ms-current145:pdf044:l019","ordinal":389176,"en":"No warrior dared go"},{"id":"sayakbay-ms-current145:pdf044:l020","ordinal":389177,"en":"No warrior remained on the march"},{"id":"sayakbay-ms-current145:pdf044:l021","ordinal":389178,"en":"Give account to all Beijing"},{"id":"sayakbay-ms-current145:pdf044:l022","ordinal":389179,"en":"You will take the great bellows"},{"id":"sayakbay-ms-current145:pdf044:l023","ordinal":389180,"en":"With a horse swift as the moon"},{"id":"sayakbay-ms-current145:pdf044:l024","ordinal":389181,"en":"He had a messenger found"},{"id":"sayakbay-ms-current145:pdf044:l025","ordinal":389182,"en":"Forty thousand of Beijing"},{"id":"sayakbay-ms-current145:pdf044:l026","ordinal":389183,"en":"He had the great gate opened"},{"id":"sayakbay-ms-current145:pdf044:l027","ordinal":389184,"en":"To populous Beijing"},{"id":"sayakbay-ms-current145:pdf044:l028","ordinal":389185,"en":"Let us send the true report"},{"id":"sayakbay-ms-current145:pdf044:l029","ordinal":389186,"en":"The widowed women fixed their eyes"},{"id":"sayakbay-ms-current145:pdf044:l030","ordinal":389187,"en":"Let us proclaim it through Beijing"},{"id":"sayakbay-ms-current145:pdf044:l031","ordinal":389188,"en":"Frightening all the people"},{"id":"sayakbay-ms-current145:pdf044:l032","ordinal":389189,"en":"From the force hidden from sight"},{"id":"sayakbay-ms-current145:pdf044:l033","ordinal":389190,"en":"His court turned to ruin"},{"id":"sayakbay-ms-current145:pdf045:l001","ordinal":389191,"en":"Without sparing the women of Kakan"},{"id":"sayakbay-ms-current145:pdf045:l002","ordinal":389192,"en":"From where arrows flew by tens"},{"id":"sayakbay-ms-current145:pdf045:l003","ordinal":389193,"en":"Leaving no maiden in Beijing"},{"id":"sayakbay-ms-current145:pdf045:l004","ordinal":389194,"en":"Let us gather the thousands around"},{"id":"sayakbay-ms-current145:pdf045:l005","ordinal":389195,"en":"If they are not satisfied by the spoken word"},{"id":"sayakbay-ms-current145:pdf045:l006","ordinal":389196,"en":"If they do not yield before it"},{"id":"sayakbay-ms-current145:pdf045:l007","ordinal":389197,"en":"Forty tribes from forty thousand"},{"id":"sayakbay-ms-current145:pdf045:l008","ordinal":389198,"en":"Purifying it every dawn"},{"id":"sayakbay-ms-current145:pdf045:l009","ordinal":389199,"en":"To sit upon the throne"},{"id":"sayakbay-ms-current145:pdf045:l010","ordinal":389200,"en":"To rule over the Chinese people"},{"id":"sayakbay-ms-current145:pdf045:l011","ordinal":389201,"en":"What the people knew in the end"},{"id":"sayakbay-ms-current145:pdf045:l012","ordinal":389202,"en":"Let us send word to appoint him"},{"id":"sayakbay-ms-current145:pdf045:l013","ordinal":389203,"en":"More precious than spoken counsel"},{"id":"sayakbay-ms-current145:pdf045:l014","ordinal":389204,"en":"Let us send news that it was given"},{"id":"sayakbay-ms-current145:pdf045:l015","ordinal":389205,"en":"The two disputed these words"},{"id":"sayakbay-ms-current145:pdf045:l016","ordinal":389206,"en":"Let us send news of the booty"},{"id":"sayakbay-ms-current145:pdf045:l017","ordinal":389207,"en":"To all Chinese Beijing"},{"id":"sayakbay-ms-current145:pdf045:l018","ordinal":389208,"en":"Let us send word that he shall settle"},{"id":"sayakbay-ms-current145:pdf045:l019","ordinal":389209,"en":"A khan’s decree is not twofold"},{"id":"sayakbay-ms-current145:pdf045:l020","ordinal":389210,"en":"What the Kalmyk gave"},{"id":"sayakbay-ms-current145:pdf045:l021","ordinal":389211,"en":"Let us report the booty"},{"id":"sayakbay-ms-current145:pdf045:l022","ordinal":389212,"en":"The oath arose from this deed"},{"id":"sayakbay-ms-current145:pdf045:l023","ordinal":389213,"en":"In this land of Beijing"},{"id":"sayakbay-ms-current145:pdf045:l024","ordinal":389214,"en":"Leaving no unbridled colt"},{"id":"sayakbay-ms-current145:pdf045:l025","ordinal":389215,"en":"Let the lords issue a decree"},{"id":"sayakbay-ms-current145:pdf045:l026","ordinal":389216,"en":"The celebration of the Chinese"},{"id":"sayakbay-ms-current145:pdf045:l027","ordinal":389217,"en":"Belonged to the watched women"},{"id":"sayakbay-ms-current145:pdf045:l028","ordinal":389218,"en":"Great Beijing with forty barriers"},{"id":"sayakbay-ms-current145:pdf045:l029","ordinal":389219,"en":"The elder authority of Kakan"},{"id":"sayakbay-ms-current145:pdf045:l030","ordinal":389220,"en":"Let forty thousand set out"},{"id":"sayakbay-ms-current145:pdf045:l031","ordinal":389221,"en":"To approach those who came"},{"id":"sayakbay-ms-current145:pdf046:l001","ordinal":389222,"en":"The angered soul took hold"},{"id":"sayakbay-ms-current145:pdf046:l002","ordinal":389223,"en":"Leading his people for forty days"},{"id":"sayakbay-ms-current145:pdf046:l003","ordinal":389224,"en":"Throwing the whole age into uproar"},{"id":"sayakbay-ms-current145:pdf046:l004","ordinal":389225,"en":"Against the wretched Burut"},{"id":"sayakbay-ms-current145:pdf046:l005","ordinal":389226,"en":"To wage the bloody struggle"},{"id":"sayakbay-ms-current145:pdf046:l006","ordinal":389227,"en":"To take up the moving arrow"},{"id":"sayakbay-ms-current145:pdf046:l007","ordinal":389228,"en":"To drive him to the root"},{"id":"sayakbay-ms-current145:pdf046:l008","ordinal":389229,"en":"Kakan raged in his wrath"},{"id":"sayakbay-ms-current145:pdf046:l009","ordinal":389230,"en":"Having the judges examine them"},{"id":"sayakbay-ms-current145:pdf046:l010","ordinal":389231,"en":"Having weapons fitted by the lattice wall"},{"id":"sayakbay-ms-current145:pdf046:l011","ordinal":389232,"en":"Having them lie beside the herdsman"},{"id":"sayakbay-ms-current145:pdf046:l012","ordinal":389233,"en":"Those deep-rooted Chinese"},{"id":"sayakbay-ms-current145:pdf046:l013","ordinal":389234,"en":"To Beijing’s golden throne"},{"id":"sayakbay-ms-current145:pdf046:l014","ordinal":389235,"en":"Guarding it so no soul approached"},{"id":"sayakbay-ms-current145:pdf046:l015","ordinal":389236,"en":"Gathering the attendants"},{"id":"sayakbay-ms-current145:pdf046:l016","ordinal":389237,"en":"Having the marriage rite performed"},{"id":"sayakbay-ms-current145:pdf046:l017","ordinal":389238,"en":"Let us destroy all of Kakan"},{"id":"sayakbay-ms-current145:pdf046:l018","ordinal":389239,"en":"If she bears a son from him"},{"id":"sayakbay-ms-current145:pdf046:l019","ordinal":389240,"en":"Let us name him Chyngteñir"},{"id":"sayakbay-ms-current145:pdf046:l020","ordinal":389241,"en":"When Chyngteñir grows up"},{"id":"sayakbay-ms-current145:pdf046:l021","ordinal":389242,"en":"See how mighty he will become"},{"id":"sayakbay-ms-current145:pdf046:l022","ordinal":389243,"en":"The Chinese understood the order"},{"id":"sayakbay-ms-current145:pdf046:l023","ordinal":389244,"en":"He became an orator among the Chinese"},{"id":"sayakbay-ms-current145:pdf046:l024","ordinal":389245,"en":"Blinding those who would not see"},{"id":"sayakbay-ms-current145:pdf046:l025","ordinal":389246,"en":"Setting him over many domains"},{"id":"sayakbay-ms-current145:pdf046:l026","ordinal":389247,"en":"Awakening his burning force"},{"id":"sayakbay-ms-current145:pdf046:l027","ordinal":389248,"en":"Moving him across seven broad rivers"},{"id":"sayakbay-ms-current145:pdf046:l028","ordinal":389249,"en":"Calling together the Chinese host"},{"id":"sayakbay-ms-current145:pdf046:l029","ordinal":389250,"en":"Humbling the people of the white kalpak"},{"id":"sayakbay-ms-current145:pdf046:l030","ordinal":389251,"en":"He turned gently from the valley"},{"id":"sayakbay-ms-current145:pdf046:l031","ordinal":389252,"en":"The Chinese joined together"},{"id":"sayakbay-ms-current145:pdf046:l032","ordinal":389253,"en":"Great Bilgich came to speech"},{"id":"sayakbay-ms-current145:pdf046:l033","ordinal":389254,"en":"His tongue formed these words"},{"id":"sayakbay-ms-current145:pdf047:l001","ordinal":389255,"en":"Know what I have told you"},{"id":"sayakbay-ms-current145:pdf051:l001","ordinal":389256,"en":"In the world arrayed in garments"},{"id":"sayakbay-ms-current145:pdf051:l002","ordinal":389257,"en":"The Chinese opened their eyes"},{"id":"sayakbay-ms-current145:pdf051:l003","ordinal":389258,"en":"Having treasure scattered"},{"id":"sayakbay-ms-current145:pdf051:l004","ordinal":389259,"en":"The souls who had been seized and confined"},{"id":"sayakbay-ms-current145:pdf051:l005","ordinal":389260,"en":"Came forth again"},{"id":"sayakbay-ms-current145:pdf051:l006","ordinal":389261,"en":"Longing for the good"},{"id":"sayakbay-ms-current145:pdf051:l007","ordinal":389262,"en":"The children went to their games"},{"id":"sayakbay-ms-current145:pdf051:l008","ordinal":389263,"en":"Calling Mount Chyng a mighty mountain"},{"id":"sayakbay-ms-current145:pdf051:l009","ordinal":389264,"en":"They cast banners toward the sky"},{"id":"sayakbay-ms-current145:pdf051:l010","ordinal":389265,"en":"Raising his people above other nations"},{"id":"sayakbay-ms-current145:pdf051:l011","ordinal":389266,"en":"Bringing fortune upon his head"},{"id":"sayakbay-ms-current145:pdf051:l012","ordinal":389267,"en":"Rallying his stricken Chinese"},{"id":"sayakbay-ms-current145:pdf051:l013","ordinal":389268,"en":"Saying the lord of Beijing had come"},{"id":"sayakbay-ms-current145:pdf051:l014","ordinal":389269,"en":"Inscribing it in his fortune"},{"id":"sayakbay-ms-current145:pdf051:l015","ordinal":389270,"en":"Ilik, Kiyik, and old souls"},{"id":"sayakbay-ms-current145:pdf051:l022","ordinal":389271,"en":"In the form of a dragon"},{"id":"sayakbay-ms-current145:pdf051:l024","ordinal":389272,"en":"How the Chinese rejoiced"},{"id":"sayakbay-ms-current145:pdf051:l025","ordinal":389273,"en":"In that teeming place"},{"id":"sayakbay-ms-current145:pdf051:l028","ordinal":389274,"en":"A peerless enemy lurked there"},{"id":"sayakbay-ms-current145:pdf051:l029","ordinal":389275,"en":"That was the gleaming well"},{"id":"sayakbay-ms-current145:pdf051:l030","ordinal":389276,"en":"Its poison was fierce"},{"id":"sayakbay-ms-current145:pdf051:l032","ordinal":389277,"en":"Sixty dragon young"},{"id":"sayakbay-ms-current145:pdf051:l033","ordinal":389278,"en":"Dragging six men down from the earth"},{"id":"sayakbay-ms-current145:pdf052:l002","ordinal":389279,"en":"The young child Urumtai"},{"id":"sayakbay-ms-current145:pdf052:l003","ordinal":389280,"en":"The people who committed crimes"},{"id":"sayakbay-ms-current145:pdf052:l004","ordinal":389281,"en":"The dragon would squeeze them"},{"id":"sayakbay-ms-current145:pdf052:l006","ordinal":389282,"en":"Looking upon his daughter like a bead"},{"id":"sayakbay-ms-current145:pdf052:l007","ordinal":389283,"en":"That black camel sat awaiting"},{"id":"sayakbay-ms-current145:pdf052:l008","ordinal":389284,"en":"This well ruled the people"},{"id":"sayakbay-ms-current145:pdf052:l010","ordinal":389285,"en":"It became a ruthless enemy"},{"id":"sayakbay-ms-current145:pdf052:l011","ordinal":389286,"en":"It sucked in long hair"},{"id":"sayakbay-ms-current145:pdf052:l013","ordinal":389287,"en":"Even a strong camel would grow weary"},{"id":"sayakbay-ms-current145:pdf052:l014","ordinal":389288,"en":"They carried them away with a rush"},{"id":"sayakbay-ms-current145:pdf052:l016","ordinal":389289,"en":"Scarcely a person remained"},{"id":"sayakbay-ms-current145:pdf052:l017","ordinal":389290,"en":"Great Teñir over such a people"},{"id":"sayakbay-ms-current145:pdf052:l019","ordinal":389291,"en":"Saying Bural had made him Chinese"},{"id":"sayakbay-ms-current145:pdf052:l020","ordinal":389292,"en":"They seated Teñir on the throne"},{"id":"sayakbay-ms-current145:pdf052:l021","ordinal":389293,"en":"Seven whole souls bowed down"},{"id":"sayakbay-ms-current145:pdf052:l022","ordinal":389294,"en":"Many spoke corrupt words"},{"id":"sayakbay-ms-current145:pdf052:l023","ordinal":389295,"en":"Their eyes looked ominous"},{"id":"sayakbay-ms-current145:pdf052:l024","ordinal":389296,"en":"The lifeless seemed to threaten the living"},{"id":"sayakbay-ms-current145:pdf052:l027","ordinal":389297,"en":"They wrapped and swaddled him"},{"id":"sayakbay-ms-current145:pdf052:l028","ordinal":389298,"en":"Watching over him day by day"},{"id":"sayakbay-ms-current145:pdf052:l029","ordinal":389299,"en":"Saying he would become a surpassing child"},{"id":"sayakbay-ms-current145:pdf052:l030","ordinal":389300,"en":"Cunning as a dragon"},{"id":"sayakbay-ms-current145:pdf052:l031","ordinal":389301,"en":"Saying his body shone brighter than the moon"},{"id":"sayakbay-ms-current145:pdf052:l032","ordinal":389302,"en":"If misfortune should fall upon Kakana"},{"id":"sayakbay-ms-current145:pdf053:l001","ordinal":389303,"en":"The Chinese hero who made all sway"},{"id":"sayakbay-ms-current145:pdf053:l002","ordinal":389304,"en":"None in Beijing could equal him"},{"id":"sayakbay-ms-current145:pdf053:l003","ordinal":389305,"en":"Chyng became their great ruler"},{"id":"sayakbay-ms-current145:pdf053:l004","ordinal":389306,"en":"Chyng Teñir, for whom the people labored"},{"id":"sayakbay-ms-current145:pdf053:l005","ordinal":389307,"en":"Taking tribute from every subject"},{"id":"sayakbay-ms-current145:pdf053:l006","ordinal":389308,"en":"For forty days feeding forty sheep"},{"id":"sayakbay-ms-current145:pdf053:l009","ordinal":389309,"en":"No people could stand against his coming"},{"id":"sayakbay-ms-current145:pdf053:l010","ordinal":389310,"en":"The Chinese people did not avert their gaze"},{"id":"sayakbay-ms-current145:pdf053:l011","ordinal":389311,"en":"The great Chinese spoke among the clans"},{"id":"sayakbay-ms-current145:pdf053:l012","ordinal":389312,"en":"None remained to raise a clamor"},{"id":"sayakbay-ms-current145:pdf053:l016","ordinal":389313,"en":"Became khan from month to month"},{"id":"sayakbay-ms-current145:pdf053:l017","ordinal":389314,"en":"The Kalmyk champion"},{"id":"sayakbay-ms-current145:pdf053:l019","ordinal":389315,"en":"Setting his gain upon the throne"},{"id":"sayakbay-ms-current145:pdf053:l021","ordinal":389316,"en":"Now he would not bend from the straight path"},{"id":"sayakbay-ms-current145:pdf053:l022","ordinal":389317,"en":"No champion could meet his gaze"},{"id":"sayakbay-ms-current145:pdf053:l024","ordinal":389318,"en":"Prevailing across the earth"},{"id":"sayakbay-ms-current145:pdf053:l027","ordinal":389319,"en":"He became a mounted foe"},{"id":"sayakbay-ms-current145:pdf053:l029","ordinal":389320,"en":"The child’s early years passed"},{"id":"sayakbay-ms-current145:pdf053:l030","ordinal":389321,"en":"He brought all Beijing under him"},{"id":"sayakbay-ms-current145:pdf054:l003","ordinal":389322,"en":"Making a home for his white falcon"},{"id":"sayakbay-ms-current145:pdf054:l006","ordinal":389323,"en":"Covering it with precious ornament"},{"id":"sayakbay-ms-current145:pdf054:l007","ordinal":389324,"en":"Driving cattle toward the mountain"},{"id":"sayakbay-ms-current145:pdf054:l009","ordinal":389325,"en":"Digging a pit where baltyrgan grew"},{"id":"sayakbay-ms-current145:pdf054:l010","ordinal":389326,"en":"Plating it in pure gold"},{"id":"sayakbay-ms-current145:pdf054:l011","ordinal":389327,"en":"Having the nobles praise it"},{"id":"sayakbay-ms-current145:pdf054:l013","ordinal":389328,"en":"The open face of the mountain"},{"id":"sayakbay-ms-current145:pdf054:l018","ordinal":389329,"en":"Saying none would remain standing"},{"id":"sayakbay-ms-current145:pdf054:l022","ordinal":389330,"en":"Surrounding its bounds twice"},{"id":"sayakbay-ms-current145:pdf054:l024","ordinal":389331,"en":"So none might come and ruin it"},{"id":"sayakbay-ms-current145:pdf054:l025","ordinal":389332,"en":"O ruthless Chinese people"},{"id":"sayakbay-ms-current145:pdf054:l026","ordinal":389333,"en":"Chyng Teñir, who knew how to command"},{"id":"sayakbay-ms-current145:pdf054:l027","ordinal":389334,"en":"To the host spread across the heights"},{"id":"sayakbay-ms-current145:pdf054:l028","ordinal":389335,"en":"Across the stone-strewn plain"},{"id":"sayakbay-ms-current145:pdf054:l029","ordinal":389336,"en":"To the champion clad for the child"},{"id":"sayakbay-ms-current145:pdf054:l030","ordinal":389337,"en":"Upon the great commanding summit"},{"id":"sayakbay-ms-current145:pdf054:l031","ordinal":389338,"en":"He surveyed the broad world"},{"id":"sayakbay-ms-current145:pdf055:l017","ordinal":389339,"en":"His founding ancestor was Nogoy Khan,"},{"id":"sayakbay-ms-current145:pdf055:l019","ordinal":389340,"en":"Let us begin the tale from ancient times."},{"id":"sayakbay-ms-current145:pdf055:l020","ordinal":389341,"en":"His earlier ancestor was Böyön Khan,"},{"id":"sayakbay-ms-current145:pdf055:l021","ordinal":389342,"en":"He became khan in a foreign steppe,"},{"id":"sayakbay-ms-current145:pdf055:l022","ordinal":389343,"en":"[?] made the land his own,"},{"id":"sayakbay-ms-current145:pdf055:l023","ordinal":389344,"en":"The dear land that saw the White Kalmyks,"},{"id":"sayakbay-ms-current145:pdf055:l024","ordinal":389345,"en":"[?] made the land his own,"},{"id":"sayakbay-ms-current145:pdf055:l025","ordinal":389346,"en":"Nogoy Khan, a man of fortune."},{"id":"sayakbay-ms-current145:pdf055:l026","ordinal":389347,"en":"Men were forged by the khanate,"},{"id":"sayakbay-ms-current145:pdf055:l027","ordinal":389348,"en":"Fighting, the enemy was defeated,"},{"id":"sayakbay-ms-current145:pdf055:l028","ordinal":389349,"en":"His [?] became aflame,"},{"id":"sayakbay-ms-current145:pdf055:l029","ordinal":389350,"en":"Sayan established a royal camp."},{"id":"sayakbay-ms-current145:pdf055:l030","ordinal":389351,"en":"Descended from Sayan Khan,"},{"id":"sayakbay-ms-current145:pdf055:l031","ordinal":389352,"en":"Ordering that one to be sacrificed,"},{"id":"sayakbay-ms-current145:pdf055:l032","ordinal":389353,"en":"All the peoples of the age,"},{"id":"sayakbay-ms-current145:pdf056:l001","ordinal":389354,"en":"Karakhan himself descended [from him],"},{"id":"sayakbay-ms-current145:pdf056:l002","ordinal":389355,"en":"There his eye could not see,"},{"id":"sayakbay-ms-current145:pdf056:l003","ordinal":389356,"en":"Khans and elders sprang from noble stock,"},{"id":"sayakbay-ms-current145:pdf056:l004","ordinal":389357,"en":"A gray stallion that would let no horse escape,"},{"id":"sayakbay-ms-current145:pdf056:l005","ordinal":389358,"en":"Radiant elders and khans arose,"},{"id":"sayakbay-ms-current145:pdf056:l006","ordinal":389359,"en":"Becoming a foe who advanced alone,"},{"id":"sayakbay-ms-current145:pdf056:l007","ordinal":389360,"en":"The world became anguish to the heart,"},{"id":"sayakbay-ms-current145:pdf056:l008","ordinal":389361,"en":"Setting his aim broadly,"},{"id":"sayakbay-ms-current145:pdf056:l009","ordinal":389362,"en":"His equal was truly his match,"},{"id":"sayakbay-ms-current145:pdf056:l010","ordinal":389363,"en":"Many people descended [from him],"},{"id":"sayakbay-ms-current145:pdf056:l011","ordinal":389364,"en":"They attained a homeland on earth,"},{"id":"sayakbay-ms-current145:pdf056:l012","ordinal":389365,"en":"He acted together with heroes,"},{"id":"sayakbay-ms-current145:pdf056:l013","ordinal":389366,"en":"Burak made them a people,"},{"id":"sayakbay-ms-current145:pdf056:l014","ordinal":389367,"en":"From Tara Khan came Bala Khan,"},{"id":"sayakbay-ms-current145:pdf056:l015","ordinal":389368,"en":"He became khan while still young,"},{"id":"sayakbay-ms-current145:pdf056:l016","ordinal":389369,"en":"Generous to warriors, open-handed,"},{"id":"sayakbay-ms-current145:pdf056:l017","ordinal":389370,"en":"He was an incomparable soul,"},{"id":"sayakbay-ms-current145:pdf056:l018","ordinal":389371,"en":"From Bala Khan came Nogoy Khan,"},{"id":"sayakbay-ms-current145:pdf056:l019","ordinal":389372,"en":"Who could be mightier than Nogoy Khan?"},{"id":"sayakbay-ms-current145:pdf056:l020","ordinal":389373,"en":"They followed according to his word,"},{"id":"sayakbay-ms-current145:pdf056:l021","ordinal":389374,"en":"He slaughtered anyone who rose against him,"},{"id":"sayakbay-ms-current145:pdf056:l022","ordinal":389375,"en":"When he set his sights, he became a fierce khan,"},{"id":"sayakbay-ms-current145:pdf056:l023","ordinal":389376,"en":"In combat he was a formidable man,"}]
