[{"id":"manas-2010:p1239:b001:l015","ordinal":53761,"en":"Cutting a path through rock,"},{"id":"manas-2010:p1239:b001:l016","ordinal":53762,"en":"If only he shared my mountain slope!"},{"id":"manas-2010:p1239:b001:l017","ordinal":53763,"en":"If only he were Alooko’s youngest,"},{"id":"manas-2010:p1239:b001:l018","ordinal":53764,"en":"Born of the same parents as me,"},{"id":"manas-2010:p1239:b001:l019","ordinal":53765,"en":"My brother from the same nest!"},{"id":"manas-2010:p1239:b001:l020","ordinal":53766,"en":"Syrgak is truly a renowned champion;"},{"id":"manas-2010:p1239:b001:l021","ordinal":53767,"en":"Syrgak stands apart from other mortals."},{"id":"manas-2010:p1239:b001:l022","ordinal":53768,"en":"His whole body is well proportioned."},{"id":"manas-2010:p1239:b001:l023","ordinal":53769,"en":"Reaching twenty,"},{"id":"manas-2010:p1239:b001:l024","ordinal":53770,"en":"He has come to that age this year."},{"id":"manas-2010:p1239:b001:l025","ordinal":53771,"en":"He is at his swelling prime,"},{"id":"manas-2010:p1239:b001:l026","ordinal":53772,"en":"A truly valiant falcon,"},{"id":"manas-2010:p1239:b001:l027","ordinal":53773,"en":"In such condition he would strike a rock."},{"id":"manas-2010:p1239:b001:l028","ordinal":53774,"en":"O God, O idol, what shall I do?"},{"id":"manas-2010:p1239:b001:l029","ordinal":53775,"en":"If only I could contrive it skillfully,"},{"id":"manas-2010:p1239:b001:l030","ordinal":53776,"en":"Have my swift foot soldiers surround him,"},{"id":"manas-2010:p1239:b001:l031","ordinal":53777,"en":"And capture Syrgak alive!"},{"id":"manas-2010:p1239:b001:l032","ordinal":53778,"en":"With Beijing’s beautiful maidens,"},{"id":"manas-2010:p1239:b001:l033","ordinal":53779,"en":"If only I could join him to them!"},{"id":"manas-2010:p1239:b001:l034","ordinal":53780,"en":"If a son were born to Syrgak,"},{"id":"manas-2010:p1239:b001:l035","ordinal":53781,"en":"I would place my golden crown upon him,"},{"id":"manas-2010:p1239:b001:l036","ordinal":53782,"en":"Seat him upon my golden throne,"},{"id":"manas-2010:p1239:b001:l037","ordinal":53783,"en":"And over Outer Beijing, forever,"},{"id":"manas-2010:p1239:b001:l038","ordinal":53784,"en":"Make him the khan of its watch!"},{"id":"manas-2010:p1239:b001:l039","ordinal":53785,"en":"Without turning aside, fighting to the death,"},{"id":"manas-2010:p1239:b001:l040","ordinal":53786,"en":"Let me try a face-to-face encounter with Syrgak!”"},{"id":"manas-2010:p1239:b001:l041","ordinal":53787,"en":"He did not shrink from his resolve;"},{"id":"manas-2010:p1239:b001:l042","ordinal":53788,"en":"He did not draw back what he had extended,"},{"id":"manas-2010:p1240:b001:l001","ordinal":53789,"en":"He devised a plan, thinking hard,"},{"id":"manas-2010:p1240:b001:l002","ordinal":53790,"en":"Considering where he might"},{"id":"manas-2010:p1240:b001:l003","ordinal":53791,"en":"Capture Syrgak by a trick."},{"id":"manas-2010:p1240:b001:l004","ordinal":53792,"en":"Coughing in great heavy bursts,"},{"id":"manas-2010:p1240:b001:l005","ordinal":53793,"en":"“I shall shoot the warrior Syrgak,” he said."},{"id":"manas-2010:p1240:b001:l006","ordinal":53794,"en":"He set fire to his match,"},{"id":"manas-2010:p1240:b001:l007","ordinal":53795,"en":"With Chinese firesteel and striking stone"},{"id":"manas-2010:p1240:b001:l008","ordinal":53796,"en":"Scraping out a glowing spark."},{"id":"manas-2010:p1240:b001:l009","ordinal":53797,"en":"“I shall shoot,” he said, preparing,"},{"id":"manas-2010:p1240:b001:l010","ordinal":53798,"en":"Raising and leveling his gun."},{"id":"manas-2010:p1240:b001:l011","ordinal":53799,"en":"Algara beneath him"},{"id":"manas-2010:p1240:b001:l012","ordinal":53800,"en":"Coiled and sprang away."},{"id":"manas-2010:p1240:b001:l013","ordinal":53801,"en":"Taking Syrgak squarely in his sights,"},{"id":"manas-2010:p1240:b001:l014","ordinal":53802,"en":"He fired once with his matchlock."},{"id":"manas-2010:p1240:b001:l015","ordinal":53803,"en":"As soon as he pressed it, the matchlock"},{"id":"manas-2010:p1240:b001:l016","ordinal":53804,"en":"Puffed smoke and cracked."},{"id":"manas-2010:p1240:b001:l017","ordinal":53805,"en":"Syrgak stood firm, untroubled;"},{"id":"manas-2010:p1240:b001:l018","ordinal":53806,"en":"The fierce slave’s shot"},{"id":"manas-2010:p1240:b001:l019","ordinal":53807,"en":"He counted as nothing."},{"id":"manas-2010:p1240:b001:l020","ordinal":53808,"en":"He did not think, “I shall die.”"},{"id":"manas-2010:p1240:b001:l021","ordinal":53809,"en":"The mountainlike fierce one’s"},{"id":"manas-2010:p1240:b001:l022","ordinal":53810,"en":"Appearance and bearing"},{"id":"manas-2010:p1240:b001:l023","ordinal":53811,"en":"Your Syrgak stood observing."},{"id":"manas-2010:p1240:b001:l024","ordinal":53812,"en":"“On fescue ground where dust cannot rise,"},{"id":"manas-2010:p1240:b001:l025","ordinal":53813,"en":"If only I could meet him there"},{"id":"manas-2010:p1240:b001:l026","ordinal":53814,"en":"And face him in combat!”"},{"id":"manas-2010:p1240:b001:l027","ordinal":53815,"en":"Your Syrgak was dying with eagerness."},{"id":"manas-2010:p1240:b001:l028","ordinal":53816,"en":"“There, in distant Talas,"},{"id":"manas-2010:p1240:b001:l029","ordinal":53817,"en":"If only I could arrive ahead of an arrow,"},{"id":"manas-2010:p1240:b001:l030","ordinal":53818,"en":"And upon arriving, with that slave,"},{"id":"manas-2010:p1240:b001:l031","ordinal":53819,"en":"Fight a shattering battle!"},{"id":"manas-2010:p1240:b001:l032","ordinal":53820,"en":"If my appointed death comes suddenly,"},{"id":"manas-2010:p1240:b001:l033","ordinal":53821,"en":"Spear in hand, struck by a bullet,"},{"id":"manas-2010:p1240:b001:l034","ordinal":53822,"en":"Let me die a martyr."},{"id":"manas-2010:p1240:b001:l035","ordinal":53823,"en":"If I remain alive and do not die,"},{"id":"manas-2010:p1240:b001:l036","ordinal":53824,"en":"Let me grapple with Kongurbay"},{"id":"manas-2010:p1240:b001:l037","ordinal":53825,"en":"And see which of us prevails!”"},{"id":"manas-2010:p1240:b001:l038","ordinal":53826,"en":"His insides boiled and blazed;"},{"id":"manas-2010:p1240:b001:l039","ordinal":53827,"en":"Ulak Khan’s Syrgak"},{"id":"manas-2010:p1240:b001:l040","ordinal":53828,"en":"Longed to join a spear fight."},{"id":"manas-2010:p1240:b001:l041","ordinal":53829,"en":"His eyes strained with eager waiting."},{"id":"manas-2010:p1240:b001:l042","ordinal":53830,"en":"His stoutly made lacquered spear"},{"id":"manas-2010:p1241:b001:l001","ordinal":53831,"en":"He gripped firmly in his hand."},{"id":"manas-2010:p1241:b001:l002","ordinal":53832,"en":"Grasping the spear,"},{"id":"manas-2010:p1241:b001:l003","ordinal":53833,"en":"He aimed it at a chosen spot."},{"id":"manas-2010:p1241:b001:l004","ordinal":53834,"en":"Without drawing back what he extended,"},{"id":"manas-2010:p1241:b001:l005","ordinal":53835,"en":"Without relaxing his stern expression,"},{"id":"manas-2010:p1241:b001:l006","ordinal":53836,"en":"Without recoiling in fear,"},{"id":"manas-2010:p1241:b001:l007","ordinal":53837,"en":"His pouch belt girded at his waist,"},{"id":"manas-2010:p1241:b001:l008","ordinal":53838,"en":"He raised the cry, “Islam!”"},{"id":"manas-2010:p1241:b001:l009","ordinal":53839,"en":"And shouted “Manas!” as his battle cry."},{"id":"manas-2010:p1241:b001:l010","ordinal":53840,"en":"When the fierce one heard that cry,"},{"id":"manas-2010:p1241:b001:l011","ordinal":53841,"en":"He too charged forward."},{"id":"manas-2010:p1241:b001:l012","ordinal":53842,"en":"Without drawing back what he extended,"},{"id":"manas-2010:p1241:b001:l013","ordinal":53843,"en":"He too came on without fleeing."},{"id":"manas-2010:p1241:b001:l014","ordinal":53844,"en":"Syrgak and Kongurbay"},{"id":"manas-2010:p1241:b001:l015","ordinal":53845,"en":"Were charging at each other."},{"id":"manas-2010:p1241:b001:l016","ordinal":53846,"en":"Sparing not his flylike life,"},{"id":"manas-2010:p1241:b001:l017","ordinal":53847,"en":"Alooko’s Kongurbay"},{"id":"manas-2010:p1241:b001:l018","ordinal":53848,"en":"Also raised his spear"},{"id":"manas-2010:p1241:b001:l019","ordinal":53849,"en":"And came on, drawing it round."},{"id":"manas-2010:p1241:b001:l020","ordinal":53850,"en":"He aimed at a deadly spot,"},{"id":"manas-2010:p1241:b001:l021","ordinal":53851,"en":"Readying himself as he came."},{"id":"manas-2010:p1241:b001:l023","ordinal":53852,"en":"“At the lungs and liver,” he said.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p1241:b001:l024","ordinal":53853,"en":"He had known the chosen places"},{"id":"manas-2010:p1241:b001:l025","ordinal":53854,"en":"From his earliest youth, that slave;"},{"id":"manas-2010:p1241:b001:l026","ordinal":53855,"en":"With Syrgak, in former times,"},{"id":"manas-2010:p1241:b001:l027","ordinal":53856,"en":"He had entered many battles, that slave."},{"id":"manas-2010:p1241:b001:l028","ordinal":53857,"en":"At that moment the warrior Syrgak,"},{"id":"manas-2010:p1241:b001:l029","ordinal":53858,"en":"With Kokchebich beneath him,"},{"id":"manas-2010:p1241:b001:l030","ordinal":53859,"en":"Shattering the stones it trod,"},{"id":"manas-2010:p1241:b001:l031","ordinal":53860,"en":"In the opening and closing of an eye,"},{"id":"manas-2010:p1241:b001:l032","ordinal":53861,"en":"The warrior Syrgak reached"},{"id":"manas-2010:p1241:b001:l033","ordinal":53862,"en":"The great fierce one with a rush."},{"id":"manas-2010:p1241:b001:l034","ordinal":53863,"en":"When Syrgak drew close"},{"id":"manas-2010:p1241:b001:l035","ordinal":53864,"en":"To the thundering fierce one,"},{"id":"manas-2010:p1241:b001:l036","ordinal":53865,"en":"“Above the saddle’s pommel,” he said,"},{"id":"manas-2010:p1241:b001:l037","ordinal":53866,"en":"“At the top of the bladder,” he said,"},{"id":"manas-2010:p1241:b001:l038","ordinal":53867,"en":"And Syrgak drove his thrust home."},{"id":"manas-2010:p1241:b001:l039","ordinal":53868,"en":"At that moment Kongurbay,"},{"id":"manas-2010:p1241:b001:l040","ordinal":53869,"en":"Keeping to the spot he aimed at,"},{"id":"manas-2010:p1241:b001:l041","ordinal":53870,"en":"Your wolf-man also drove his thrust home."},{"id":"manas-2010:p1241:b001:l042","ordinal":53871,"en":"The two warriors, sparing neither,"},{"id":"manas-2010:p1242:b001:l001","ordinal":53872,"en":"Struck with their spears."},{"id":"manas-2010:p1242:b001:l002","ordinal":53873,"en":"From the space between the two"},{"id":"manas-2010:p1242:b001:l003","ordinal":53874,"en":"Fibers flew in clouds."},{"id":"manas-2010:p1242:b001:l004","ordinal":53875,"en":"The two spears with which they thrust"},{"id":"manas-2010:p1242:b001:l005","ordinal":53876,"en":"Shattered with a shriek."},{"id":"manas-2010:p1242:b001:l006","ordinal":53877,"en":"Fierce Kongurbay was a warrior;"},{"id":"manas-2010:p1242:b001:l007","ordinal":53878,"en":"Your Syrgak was a greater lion."},{"id":"manas-2010:p1242:b001:l008","ordinal":53879,"en":"Clashing without flight,"},{"id":"manas-2010:p1242:b001:l009","ordinal":53880,"en":"They were both mighty men."},{"id":"manas-2010:p1242:b001:l010","ordinal":53881,"en":"When Syrgak charged and thrust,"},{"id":"manas-2010:p1242:b001:l011","ordinal":53882,"en":"Their knees bent;"},{"id":"manas-2010:p1242:b001:l012","ordinal":53883,"en":"The two battle steeds fell,"},{"id":"manas-2010:p1242:b001:l013","ordinal":53884,"en":"Spent from the force of the joust."},{"id":"manas-2010:p1242:b001:l014","ordinal":53885,"en":"“If Kokchebich could stand lower,"},{"id":"manas-2010:p1242:b001:l015","ordinal":53886,"en":"Before the fierce one could prepare,"},{"id":"manas-2010:p1242:b001:l016","ordinal":53887,"en":"Let me seize his lower hem."},{"id":"manas-2010:p1242:b001:l017","ordinal":53888,"en":"If his head comes into my hands,"},{"id":"manas-2010:p1242:b001:l018","ordinal":53889,"en":"Let me slice it straight off"},{"id":"manas-2010:p1242:b001:l019","ordinal":53890,"en":"And follow after Almambet,"},{"id":"manas-2010:p1242:b001:l020","ordinal":53891,"en":"Bringing him joyful news!”"},{"id":"manas-2010:p1242:b001:l021","ordinal":53892,"en":"Your Syrgak was dying with eagerness."},{"id":"manas-2010:p1242:b001:l022","ordinal":53893,"en":"He thrust, making them reel and break,"},{"id":"manas-2010:p1242:b001:l023","ordinal":53894,"en":"Like small birds struck by a merlin,"},{"id":"manas-2010:p1242:b001:l024","ordinal":53895,"en":"Shattering all who came his way."},{"id":"manas-2010:p1242:b001:l025","ordinal":53896,"en":"Like creatures attacked by a wolf,"},{"id":"manas-2010:p1242:b001:l026","ordinal":53897,"en":"Your Syrgak split them apart."},{"id":"manas-2010:p1242:b001:l027","ordinal":53898,"en":"“Where is their wolf, the fierce one?” he cried."},{"id":"manas-2010:p1242:b001:l028","ordinal":53899,"en":"His eyes strained with eager searching;"},{"id":"manas-2010:p1242:b001:l029","ordinal":53900,"en":"Your Syrgak burned with eagerness."},{"id":"manas-2010:p1242:b001:l030","ordinal":53901,"en":"“Manas!” Syrgak roared,"},{"id":"manas-2010:p1242:b001:l031","ordinal":53902,"en":"Making the many Chinese thunder away,"},{"id":"manas-2010:p1242:b001:l032","ordinal":53903,"en":"To the edge of Kurpuldok,"},{"id":"manas-2010:p1242:b001:l033","ordinal":53904,"en":"Driving and scattering them."},{"id":"manas-2010:p1242:b001:l034","ordinal":53905,"en":"His pride stung, Kongurbay,"},{"id":"manas-2010:p1242:b001:l035","ordinal":53906,"en":"Without stopping, the Chinese"},{"id":"manas-2010:p1242:b001:l036","ordinal":53907,"en":"Drove back, beating them;"},{"id":"manas-2010:p1242:b001:l037","ordinal":53908,"en":"Kongurbay slaughtered them."},{"id":"manas-2010:p1242:b001:l038","ordinal":53909,"en":"“Before the lone champion Syrgak,"},{"id":"manas-2010:p1242:b001:l039","ordinal":53910,"en":"Bury yourselves—call yourselves Chinese no more!"},{"id":"manas-2010:p1242:b001:l040","ordinal":53911,"en":"You flee all together.”"},{"id":"manas-2010:p1242:b001:l041","ordinal":53912,"en":"That vast thicket lying spread out—"},{"id":"manas-2010:p1242:b001:l042","ordinal":53913,"en":"What seemed a forest was people;"},{"id":"manas-2010:p1243:b001:l001","ordinal":53914,"en":"The swarming multitude of Chinese—"},{"id":"manas-2010:p1243:b001:l002","ordinal":53915,"en":"What seemed stars were fires."},{"id":"manas-2010:p1243:b001:l003","ordinal":53916,"en":"Beyond the mighty army"},{"id":"manas-2010:p1243:b001:l004","ordinal":53917,"en":"Lay a ditch they had dug."},{"id":"manas-2010:p1243:b001:l005","ordinal":53918,"en":"The multitude of Chinese"},{"id":"manas-2010:p1243:b001:l006","ordinal":53919,"en":"Was an army beyond counting,"},{"id":"manas-2010:p1243:b001:l007","ordinal":53920,"en":"A flood that would engulf all."},{"id":"manas-2010:p1243:b001:l008","ordinal":53921,"en":"The sky was clear, the earth overcast;"},{"id":"manas-2010:p1243:b001:l009","ordinal":53922,"en":"The earth's face could not be seen."},{"id":"manas-2010:p1243:b001:l010","ordinal":53923,"en":"The eye could not take it in;"},{"id":"manas-2010:p1243:b001:l011","ordinal":53924,"en":"Earth rained down, dust flew,"},{"id":"manas-2010:p1243:b001:l012","ordinal":53925,"en":"One could not tell which was which."},{"id":"manas-2010:p1243:b001:l013","ordinal":53926,"en":"Swarming like ants,"},{"id":"manas-2010:p1243:b001:l014","ordinal":53927,"en":"Like flying tumbleweed,"},{"id":"manas-2010:p1243:b001:l015","ordinal":53928,"en":"Spearheads struck each other;"},{"id":"manas-2010:p1243:b001:l016","ordinal":53929,"en":"Men's heads knocked together."},{"id":"manas-2010:p1243:b001:l017","ordinal":53930,"en":"Entering the mighty host,"},{"id":"manas-2010:p1243:b001:l018","ordinal":53931,"en":"Your leopard, hero Syrgak,"},{"id":"manas-2010:p1243:b001:l019","ordinal":53932,"en":"Took the sword Arkesken in hand;"},{"id":"manas-2010:p1243:b001:l020","ordinal":53933,"en":"He did not think, ‘I shall die.’"},{"id":"manas-2010:p1243:b001:l021","ordinal":53934,"en":"Upon the seething vast host,"},{"id":"manas-2010:p1243:b001:l022","ordinal":53935,"en":"He attacked like a white falcon."},{"id":"manas-2010:p1243:b001:l023","ordinal":53936,"en":"Where his sword could reach,"},{"id":"manas-2010:p1243:b001:l024","ordinal":53937,"en":"He struck them down with his sword."},{"id":"manas-2010:p1243:b001:l025","ordinal":53938,"en":"If an enemy was within spear's reach,"},{"id":"manas-2010:p1243:b001:l026","ordinal":53939,"en":"He felled him with it."},{"id":"manas-2010:p1243:b001:l027","ordinal":53940,"en":"If an enemy was struck by the battle-axe,"},{"id":"manas-2010:p1243:b001:l028","ordinal":53941,"en":"He laid him low with it."},{"id":"manas-2010:p1243:b001:l029","ordinal":53942,"en":"Like a jackdaw struck by a falcon,"},{"id":"manas-2010:p1243:b001:l030","ordinal":53943,"en":"When Kökchebich could not rise,"},{"id":"manas-2010:p1243:b001:l031","ordinal":53944,"en":"Grim-faced Kongurbay thought:"},{"id":"manas-2010:p1243:b001:l032","ordinal":53945,"en":"‘If Algara would get up,"},{"id":"manas-2010:p1243:b001:l033","ordinal":53946,"en":"Would I not inflict hell,"},{"id":"manas-2010:p1243:b001:l034","ordinal":53947,"en":"Would I not show him a spectacle!"},{"id":"manas-2010:p1243:b001:l035","ordinal":53948,"en":"Taking him to the city of Beijing,"},{"id":"manas-2010:p1243:b001:l036","ordinal":53949,"en":"Upon this Burut's head"},{"id":"manas-2010:p1243:b001:l037","ordinal":53950,"en":"Would I not bring disaster!’"},{"id":"manas-2010:p1243:b001:l038","ordinal":53951,"en":"Before even that could happen,"},{"id":"manas-2010:p1243:b001:l039","ordinal":53952,"en":"Algara sprang to his feet;"},{"id":"manas-2010:p1243:b001:l040","ordinal":53953,"en":"Kökchebich stood up."},{"id":"manas-2010:p1243:b001:l041","ordinal":53954,"en":"Seeing this, the great grim-faced one"},{"id":"manas-2010:p1243:b001:l042","ordinal":53955,"en":"Devised a stratagem then."},{"id":"manas-2010:p1244:b001:l001","ordinal":53956,"en":"‘He is a youth of twenty."},{"id":"manas-2010:p1244:b001:l002","ordinal":53957,"en":"Let me pretend to flee."},{"id":"manas-2010:p1244:b001:l003","ordinal":53958,"en":"The mighty army behind me—"},{"id":"manas-2010:p1244:b001:l004","ordinal":53959,"en":"By confusing him, by trickery,"},{"id":"manas-2010:p1244:b001:l005","ordinal":53960,"en":"Let me lead him to them."},{"id":"manas-2010:p1244:b001:l006","ordinal":53961,"en":"Gathering on every side,"},{"id":"manas-2010:p1244:b001:l007","ordinal":53962,"en":"Letting the many Chinese swarm over him,"},{"id":"manas-2010:p1244:b001:l008","ordinal":53963,"en":"With the Burut in our midst,"},{"id":"manas-2010:p1244:b001:l009","ordinal":53964,"en":"Let me capture him alive.’"},{"id":"manas-2010:p1244:b001:l010","ordinal":53965,"en":"Doing this, Kongurbay"},{"id":"manas-2010:p1244:b001:l011","ordinal":53966,"en":"Fled without looking back."},{"id":"manas-2010:p1244:b001:l012","ordinal":53967,"en":"When his enemy fled,"},{"id":"manas-2010:p1244:b001:l013","ordinal":53968,"en":"Syrgak pursued without holding back."},{"id":"manas-2010:p1244:b001:l014","ordinal":53969,"en":"Then the grim-faced slave"},{"id":"manas-2010:p1244:b001:l015","ordinal":53970,"en":"Crossed Kum-Beles."},{"id":"manas-2010:p1244:b001:l016","ordinal":53971,"en":"The infidel with the swift horse"},{"id":"manas-2010:p1244:b001:l017","ordinal":53972,"en":"Through the vast army beyond it"},{"id":"manas-2010:p1244:b001:l018","ordinal":53973,"en":"Galloped in flight."},{"id":"manas-2010:p1244:b001:l019","ordinal":53974,"en":"When Alöökö's son Kongurbay"},{"id":"manas-2010:p1244:b001:l020","ordinal":53975,"en":"Roared, turned, and barred the way,"},{"id":"manas-2010:p1244:b001:l021","ordinal":53976,"en":"All the mighty fighters"},{"id":"manas-2010:p1244:b001:l022","ordinal":53977,"en":"Swarmed in upon Syrgak."},{"id":"manas-2010:p1244:b001:l023","ordinal":53978,"en":"Preparing to capture him,"},{"id":"manas-2010:p1244:b001:l024","ordinal":53979,"en":"From his flank charged"},{"id":"manas-2010:p1244:b001:l025","ordinal":53980,"en":"The warrior riding a mule."},{"id":"manas-2010:p1244:b001:l026","ordinal":53981,"en":"Börüköz came in at his side;"},{"id":"manas-2010:p1244:b001:l027","ordinal":53982,"en":"Orokkyr came from the front;"},{"id":"manas-2010:p1244:b001:l028","ordinal":53983,"en":"Ylama came opposite him;"},{"id":"manas-2010:p1244:b001:l029","ordinal":53984,"en":"Khan Zholoy charged in,"},{"id":"manas-2010:p1244:b001:l030","ordinal":53985,"en":"And Ezkara, khan of the Manchu."},{"id":"manas-2010:p1244:b001:l031","ordinal":53986,"en":"Skillful at thrusting a spear,"},{"id":"manas-2010:p1244:b001:l032","ordinal":53987,"en":"He attacked Syrgak without restraint,"},{"id":"manas-2010:p1244:b001:l033","ordinal":53988,"en":"The one most skilled in stratagems."},{"id":"manas-2010:p1244:b001:l034","ordinal":53989,"en":"Kongurbay entered roaring,"},{"id":"manas-2010:p1244:b001:l035","ordinal":53990,"en":"‘Capture him alive!’"},{"id":"manas-2010:p1244:b001:l036","ordinal":53991,"en":"Calling to his mighty fighters,"},{"id":"manas-2010:p1244:b001:l037","ordinal":53992,"en":"He came roaring once again."},{"id":"manas-2010:p1244:b001:l038","ordinal":53993,"en":"The mountain-sized warrior called Kutan the Giant"},{"id":"manas-2010:p1244:b001:l039","ordinal":53994,"en":"Charged in from one side;"},{"id":"manas-2010:p1244:b001:l040","ordinal":53995,"en":"Mangkush the Giant with his iron forehead—"},{"id":"manas-2010:p1244:b001:l041","ordinal":53996,"en":"When they all swarmed upon him,"},{"id":"manas-2010:p1244:b001:l042","ordinal":53997,"en":"Upon young hero Syrgak"},{"id":"manas-2010:p1245:b001:l001","ordinal":53998,"en":"Seventy spears struck at once."},{"id":"manas-2010:p1245:b001:l002","ordinal":53999,"en":"When the Chinese came one by one,"},{"id":"manas-2010:p1245:b001:l003","ordinal":54000,"en":"He fought them by himself."},{"id":"manas-2010:p1245:b001:l004","ordinal":54001,"en":"The Chinese pressed in, massing;"},{"id":"manas-2010:p1245:b001:l005","ordinal":54002,"en":"They had all surrounded him."},{"id":"manas-2010:p1245:b001:l006","ordinal":54003,"en":"Look at the rain, look at the embers!"},{"id":"manas-2010:p1245:b001:l007","ordinal":54004,"en":"Look at the shots striking in showers!"},{"id":"manas-2010:p1245:b001:l008","ordinal":54005,"en":"The red spear and the sword"},{"id":"manas-2010:p1245:b001:l009","ordinal":54006,"en":"Hero Syrgak held tight."},{"id":"manas-2010:p1245:b001:l010","ordinal":54007,"en":"When the Chinese pressed upon him,"},{"id":"manas-2010:p1245:b001:l011","ordinal":54008,"en":"Flashing crimson,"},{"id":"manas-2010:p1245:b001:l012","ordinal":54009,"en":"Without sparing his life a hair,"},{"id":"manas-2010:p1245:b001:l013","ordinal":54010,"en":"Hero Syrgak endured."},{"id":"manas-2010:p1245:b001:l014","ordinal":54011,"en":"When all the Chinese entered,"},{"id":"manas-2010:p1245:b001:l015","ordinal":54012,"en":"Their peerless chief entered too."},{"id":"manas-2010:p1245:b001:l016","ordinal":54013,"en":"Perish, this trampled world!"},{"id":"manas-2010:p1245:b001:l017","ordinal":54014,"en":"They had made their promises,"},{"id":"manas-2010:p1245:b001:l018","ordinal":54015,"en":"Yet on the day of shattering battle,"},{"id":"manas-2010:p1245:b001:l019","ordinal":54016,"en":"The forty champion companions were not here."}]
