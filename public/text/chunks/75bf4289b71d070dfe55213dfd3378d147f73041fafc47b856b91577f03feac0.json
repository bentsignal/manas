[{"id":"semetey-1-2013:p0520:b003:l035","ordinal":116481,"en":"There is a pit forty cubits deep."},{"id":"semetey-1-2013:p0520:b003:l036","ordinal":116482,"en":"If I do not make sport now,"},{"id":"semetey-1-2013:p0520:b003:l037","ordinal":116483,"en":"The yellow water from his heart—"},{"id":"semetey-1-2013:p0520:b003:l038","ordinal":116484,"en":"If I do not draw it all out,"},{"id":"semetey-1-2013:p0520:b003:l039","ordinal":116485,"en":"Going ahead first to Kokand,"},{"id":"semetey-1-2013:p0520:b004:l001","ordinal":116486,"en":"If I do not cause a rout,"},{"id":"semetey-1-2013:p0520:b004:l002","ordinal":116487,"en":"Their households are loaded on donkeys;"},{"id":"semetey-1-2013:p0520:b004:l003","ordinal":116488,"en":"Later they will show it,"},{"id":"semetey-1-2013:p0520:b004:l004","ordinal":116489,"en":"These Sarts have a grudge."},{"id":"semetey-1-2013:p0520:b004:l005","ordinal":116490,"en":"Rather than fear this Kokand,"},{"id":"semetey-1-2013:p0520:b004:l006","ordinal":116491,"en":"Rather than turn back without meeting him,"},{"id":"semetey-1-2013:p0520:b004:l007","ordinal":116492,"en":"Rather than retreat afraid before meeting him,"},{"id":"semetey-1-2013:p0520:b004:l008","ordinal":116493,"en":"Let me sink away without being born;"},{"id":"semetey-1-2013:p0520:b004:l009","ordinal":116494,"en":"Let me die before my appointed death."},{"id":"semetey-1-2013:p0520:b004:l010","ordinal":116495,"en":"The khan of Kokand's cruelty,"},{"id":"semetey-1-2013:p0520:b004:l011","ordinal":116496,"en":"If he rises against me, let me see it."},{"id":"semetey-1-2013:p0520:b004:l012","ordinal":116497,"en":"Rather than go in fear of Kokand,"},{"id":"semetey-1-2013:p0520:b004:l013","ordinal":116498,"en":"Let me sink away without being born."},{"id":"semetey-1-2013:p0520:b004:l014","ordinal":116499,"en":"Let me meet the khan of Kokand,"},{"id":"semetey-1-2013:p0520:b004:l015","ordinal":116500,"en":"And pass after greeting him."},{"id":"semetey-1-2013:p0520:b004:l016","ordinal":116501,"en":"If Kokand grows insolent,"},{"id":"semetey-1-2013:p0520:b004:l017","ordinal":116502,"en":"Let me bring it to its end altogether."},{"id":"semetey-1-2013:p0520:b004:l018","ordinal":116503,"en":"Rather than go in fear of this Kokand,"},{"id":"semetey-1-2013:p0520:b004:l019","ordinal":116504,"en":"Let me depart while young."},{"id":"semetey-1-2013:p0520:b004:l020","ordinal":116505,"en":"Where he steps is like a ridge;"},{"id":"semetey-1-2013:p0520:b004:l021","ordinal":116506,"en":"Of the high official, Semetey"},{"id":"semetey-1-2013:p0520:b004:l022","ordinal":116507,"en":"Would not be said to have fled in fear."},{"id":"semetey-1-2013:p0520:b004:l023","ordinal":116508,"en":"My life is a sacrifice to my honor."},{"id":"semetey-1-2013:p0520:b004:l024","ordinal":116509,"en":"High official of Kokand!"},{"id":"semetey-1-2013:p0520:b004:l025","ordinal":116510,"en":"While my dear life remains,"},{"id":"semetey-1-2013:p0520:b004:l026","ordinal":116511,"en":"Let me meet him once!”"},{"id":"semetey-1-2013:p0520:b004:l027","ordinal":116512,"en":"The orphan servant born of Manas,"},{"id":"semetey-1-2013:p0520:b004:l028","ordinal":116513,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p0520:b004:l029","ordinal":116514,"en":"Before one could say a word,"},{"id":"semetey-1-2013:p0520:b004:l030","ordinal":116515,"en":"Taking cover in its narrow streets,"},{"id":"semetey-1-2013:p0520:b004:l031","ordinal":116516,"en":"Passing through spacious Kokand,"},{"id":"semetey-1-2013:p0520:b004:l032","ordinal":116517,"en":"Driven to frenzy by his courage,"},{"id":"semetey-1-2013:p0520:b004:l033","ordinal":116518,"en":"The high official of Kokand's"},{"id":"semetey-1-2013:p0520:b004:l034","ordinal":116519,"en":"Guard he encountered."},{"id":"semetey-1-2013:p0520:b004:l035","ordinal":116520,"en":"Majestic, the orphan cared nothing;"},{"id":"semetey-1-2013:p0520:b004:l036","ordinal":116521,"en":"The high official of Kokand"},{"id":"semetey-1-2013:p0520:b004:l037","ordinal":116522,"en":"He valued less than a trouser hem."},{"id":"semetey-1-2013:p0520:b004:l038","ordinal":116523,"en":"Courage and lion-hearted valor,"},{"id":"semetey-1-2013:p0520:b004:l039","ordinal":116524,"en":"To Manas's orphan son,"},{"id":"semetey-1-2013:p0521:b003:l001","ordinal":116525,"en":"Had been given without measure."},{"id":"semetey-1-2013:p0521:b003:l002","ordinal":116526,"en":"The high official's wrestler"},{"id":"semetey-1-2013:p0521:b003:l003","ordinal":116527,"en":"He valued less than a trouser hem."},{"id":"semetey-1-2013:p0521:b003:l004","ordinal":116528,"en":"The mount beneath him"},{"id":"semetey-1-2013:p0521:b003:l005","ordinal":116529,"en":"Was Khan Temir's Aktulpar;"},{"id":"semetey-1-2013:p0521:b003:l006","ordinal":116530,"en":"What he held in his hand"},{"id":"semetey-1-2013:p0521:b003:l007","ordinal":116531,"en":"Was Ismayyl's steel blade."},{"id":"semetey-1-2013:p0521:b003:l008","ordinal":116532,"en":"That unruly orphan himself"},{"id":"semetey-1-2013:p0521:b003:l009","ordinal":116533,"en":"Had resourcefulness beyond other people."},{"id":"semetey-1-2013:p0521:b003:l010","ordinal":116534,"en":"He had brought from Bukhara"},{"id":"semetey-1-2013:p0521:b003:l011","ordinal":116535,"en":"Khan Koloy's spear."},{"id":"semetey-1-2013:p0521:b003:l012","ordinal":116536,"en":"What he wore upon him,"},{"id":"semetey-1-2013:p0521:b003:l013","ordinal":116537,"en":"With a golden collar and copper sleeves,"},{"id":"semetey-1-2013:p0521:b003:l014","ordinal":116538,"en":"Double mail with lark-eye rings,"},{"id":"semetey-1-2013:p0521:b003:l015","ordinal":116539,"en":"A gold-thread collar and broad jacket,"},{"id":"semetey-1-2013:p0521:b003:l016","ordinal":116540,"en":"Impenetrable to bullets when worn in battle,"},{"id":"semetey-1-2013:p0521:b003:l017","ordinal":116541,"en":"Was the white coat Kanykey had made."},{"id":"semetey-1-2013:p0521:b003:l018","ordinal":116542,"en":"Showing her motherly care,"},{"id":"semetey-1-2013:p0521:b003:l019","ordinal":116543,"en":"To the only one left by the valiant hero"},{"id":"semetey-1-2013:p0521:b003:l020","ordinal":116544,"en":"She had given it to wear as a gift."},{"id":"semetey-1-2013:p0521:b003:l021","ordinal":116545,"en":"The gray pouch-belt at his waist,"},{"id":"semetey-1-2013:p0521:b003:l022","ordinal":116546,"en":"Proven when girded on,"},{"id":"semetey-1-2013:p0521:b003:l023","ordinal":116547,"en":"Was that poor one's inheritance from Manas."},{"id":"semetey-1-2013:p0521:b003:l024","ordinal":116548,"en":"When he cried out and bound it at his waist,"},{"id":"semetey-1-2013:p0521:b003:l025","ordinal":116549,"en":"The White Ishan became his companion."},{"id":"semetey-1-2013:p0521:b003:l026","ordinal":116550,"en":"When he shouted and bound it at his waist,"},{"id":"semetey-1-2013:p0521:b003:l027","ordinal":116551,"en":"The forty chiltens became his companions."},{"id":"semetey-1-2013:p0521:b003:l028","ordinal":116552,"en":"Those who knew would say:"},{"id":"semetey-1-2013:p0521:b003:l029","ordinal":116553,"en":"“God brought it to the generous hero;"},{"id":"semetey-1-2013:p0521:b003:l030","ordinal":116554,"en":"It appeared from the unseen world,"},{"id":"semetey-1-2013:p0521:b003:l031","ordinal":116555,"en":"Was found in the desolate desert—"},{"id":"semetey-1-2013:p0521:b003:l032","ordinal":116556,"en":"The pouch-belt that fell from heaven.”"},{"id":"semetey-1-2013:p0521:b003:l033","ordinal":116557,"en":"Those who did not know said this:"},{"id":"semetey-1-2013:p0521:b003:l034","ordinal":116558,"en":"“Six Cities, Kokand’s"},{"id":"semetey-1-2013:p0521:b003:l035","ordinal":116559,"en":"Andijan—when he ravaged them,"},{"id":"semetey-1-2013:p0521:b003:l036","ordinal":116560,"en":"From a white-turbaned holy man,"},{"id":"semetey-1-2013:p0521:b003:l037","ordinal":116561,"en":"From a mullah in a motley coat,"},{"id":"semetey-1-2013:p0521:b003:l038","ordinal":116562,"en":"He seized that pouch-belt,” they said."},{"id":"semetey-1-2013:p0521:b003:l039","ordinal":116563,"en":"Girding on the gray pouch-belt,"},{"id":"semetey-1-2013:p0521:b005:l001","ordinal":116564,"en":"Your unruly boy born of Khan Manas,"},{"id":"semetey-1-2013:p0521:b005:l002","ordinal":116565,"en":"Wrathful and grim,"},{"id":"semetey-1-2013:p0521:b005:l003","ordinal":116566,"en":"Drew the attention of all who saw him."},{"id":"semetey-1-2013:p0521:b005:l004","ordinal":116567,"en":"With the ancestral spirit upon him, towering,"},{"id":"semetey-1-2013:p0521:b005:l005","ordinal":116568,"en":"He looked like your generous Manas himself."},{"id":"semetey-1-2013:p0521:b005:l006","ordinal":116569,"en":"Taking cover in the narrow streets,"},{"id":"semetey-1-2013:p0521:b005:l007","ordinal":116570,"en":"Passing through Great Kokand,"},{"id":"semetey-1-2013:p0521:b005:l008","ordinal":116571,"en":"He went to the high official."},{"id":"semetey-1-2013:p0521:b005:l009","ordinal":116572,"en":"The high official's sentry,"},{"id":"semetey-1-2013:p0521:b005:l010","ordinal":116573,"en":"Standing and looking at the boy,"},{"id":"semetey-1-2013:p0521:b005:l011","ordinal":116574,"en":"Shouted and ran on foot."},{"id":"semetey-1-2013:p0521:b005:l012","ordinal":116575,"en":"His wrestler, flustered,"},{"id":"semetey-1-2013:p0521:b005:l013","ordinal":116576,"en":"Before the high official"},{"id":"semetey-1-2013:p0521:b005:l014","ordinal":116577,"en":"Spoke ill of Semetey:"},{"id":"semetey-1-2013:p0521:b005:l015","ordinal":116578,"en":"“My lord khan, hear my words!"},{"id":"semetey-1-2013:p0521:b005:l016","ordinal":116579,"en":"Do you know what I know?"},{"id":"semetey-1-2013:p0521:b005:l017","ordinal":116580,"en":"Have you sensed what I sensed?"},{"id":"semetey-1-2013:p0521:b005:l018","ordinal":116581,"en":"My lord, have you seen what I saw?"},{"id":"semetey-1-2013:p0521:b005:l019","ordinal":116582,"en":"That scoundrel has arrived."},{"id":"semetey-1-2013:p0521:b005:l020","ordinal":116583,"en":"My lord, that wretch has arrived."},{"id":"semetey-1-2013:p0521:b005:l022","ordinal":116584,"en":"The one who started the turmoil,"},{"id":"semetey-1-2013:p0521:b005:l023","ordinal":116585,"en":"One arm of our Camel Wrestler"},{"id":"semetey-1-2013:p0521:b005:l024","ordinal":116586,"en":"He tore clean off."},{"id":"semetey-1-2013:p0521:b005:l025","ordinal":116587,"en":"To Khan Temir's city"},{"id":"semetey-1-2013:p0521:b005:l026","ordinal":116588,"en":"He wandered and grew up;"},{"id":"semetey-1-2013:p0521:b005:l027","ordinal":116589,"en":"That blood-drinker has arrived."},{"id":"semetey-1-2013:p0521:b005:l028","ordinal":116590,"en":"He has reached twelve years old."},{"id":"semetey-1-2013:p0521:b005:l029","ordinal":116591,"en":"He will not let a plow turn."},{"id":"semetey-1-2013:p0521:b005:l030","ordinal":116592,"en":"May good fortune forsake me if I lie!"},{"id":"semetey-1-2013:p0521:b005:l031","ordinal":116593,"en":"He will not let us remain in this Kokand."},{"id":"semetey-1-2013:p0521:b005:l032","ordinal":116594,"en":"If we do not seize him now,"},{"id":"semetey-1-2013:p0521:b005:l033","ordinal":116595,"en":"If we do not cut short that only child's life,"},{"id":"semetey-1-2013:p0521:b005:l034","ordinal":116596,"en":"If we do not put him out like a fire,"},{"id":"semetey-1-2013:p0521:b005:l035","ordinal":116597,"en":"The orphan will bring us torment."},{"id":"semetey-1-2013:p0521:b005:l036","ordinal":116598,"en":"'Tribute left by my father,' he will say;"},{"id":"semetey-1-2013:p0521:b005:l037","ordinal":116599,"en":"'A token left by Manas,' he will say."},{"id":"semetey-1-2013:p0521:b005:l038","ordinal":116600,"en":"Six thousand silver ingots, a thousand otter pelts,"},{"id":"semetey-1-2013:p0521:b005:l039","ordinal":116601,"en":"Renewing that tribute,"},{"id":"semetey-1-2013:p0522:b003:l001","ordinal":116602,"en":"He will bring us torment;"},{"id":"semetey-1-2013:p0522:b003:l002","ordinal":116603,"en":"He will take his revenge far and wide!"},{"id":"semetey-1-2013:p0522:b003:l003","ordinal":116604,"en":"That wretched orphan, the image of blood-stained Manas,"},{"id":"semetey-1-2013:p0522:b003:l004","ordinal":116605,"en":"Dragging along the road"},{"id":"semetey-1-2013:p0522:b003:l005","ordinal":116606,"en":"Whoever talks back,"},{"id":"semetey-1-2013:p0522:b003:l006","ordinal":116607,"en":"He will have the great dogs tear them apart."},{"id":"semetey-1-2013:p0522:b003:l007","ordinal":116608,"en":"Thus he will slaughter Kokand."},{"id":"semetey-1-2013:p0522:b003:l008","ordinal":116609,"en":"If we do not find a way now,"},{"id":"semetey-1-2013:p0522:b003:l009","ordinal":116610,"en":"If we do not cut off his head now,"},{"id":"semetey-1-2013:p0522:b003:l010","ordinal":116611,"en":"God damn that orphan!"},{"id":"semetey-1-2013:p0522:b003:l011","ordinal":116612,"en":"Of this Kokand here,"},{"id":"semetey-1-2013:p0522:b003:l012","ordinal":116613,"en":"He will slaughter them without leaving one!”"},{"id":"semetey-1-2013:p0522:b003:l013","ordinal":116614,"en":"The high official in Kokand,"},{"id":"semetey-1-2013:p0522:b003:l014","ordinal":116615,"en":"After hearing this,"},{"id":"semetey-1-2013:p0522:b003:l015","ordinal":116616,"en":"Revealed his dreadful purpose,"},{"id":"semetey-1-2013:p0522:b003:l016","ordinal":116617,"en":"And gave orders to his wrestlers."},{"id":"semetey-1-2013:p0522:b003:l017","ordinal":116618,"en":"From marksmen who never missed,"},{"id":"semetey-1-2013:p0522:b003:l018","ordinal":116619,"en":"“Capture Semetey and bring him,” he said,"},{"id":"semetey-1-2013:p0522:b003:l019","ordinal":116620,"en":"And sent ten of them."},{"id":"semetey-1-2013:p0522:b003:l020","ordinal":116621,"en":"From skilled spearmen,"},{"id":"semetey-1-2013:p0522:b003:l021","ordinal":116622,"en":"From strong men who knew the enemy's tricks,"},{"id":"semetey-1-2013:p0522:b003:l022","ordinal":116623,"en":"He sent ten of them."},{"id":"semetey-1-2013:p0522:b003:l023","ordinal":116624,"en":"From warriors who wielded iron-headed maces,"},{"id":"semetey-1-2013:p0522:b003:l024","ordinal":116625,"en":"He sent ten of them."},{"id":"semetey-1-2013:p0522:b003:l025","ordinal":116626,"en":"From mighty swordsmen,"},{"id":"semetey-1-2013:p0522:b003:l026","ordinal":116627,"en":"He sent ten of them."},{"id":"semetey-1-2013:p0522:b003:l027","ordinal":116628,"en":"When a fearsome gun cracked,"},{"id":"semetey-1-2013:p0522:b003:l028","ordinal":116629,"en":"From strong men who did not flinch,"},{"id":"semetey-1-2013:p0522:b003:l029","ordinal":116630,"en":"He sent ten of them."},{"id":"semetey-1-2013:p0522:b003:l030","ordinal":116631,"en":"When a black gun boomed,"},{"id":"semetey-1-2013:p0522:b003:l031","ordinal":116632,"en":"From strong men who would not flee,"},{"id":"semetey-1-2013:p0522:b003:l032","ordinal":116633,"en":"He sent ten of them."},{"id":"semetey-1-2013:p0522:b003:l033","ordinal":116634,"en":"Having heard it, the high official"},{"id":"semetey-1-2013:p0522:b003:l034","ordinal":116635,"en":"Worked himself into a terrible fury."},{"id":"semetey-1-2013:p0522:b003:l035","ordinal":116636,"en":"Shouting, calling them scoundrels,"},{"id":"semetey-1-2013:p0522:b003:l036","ordinal":116637,"en":"He raged at his wrestlers."},{"id":"semetey-1-2013:p0522:b003:l037","ordinal":116638,"en":"“Capture Semetey and bring him;"},{"id":"semetey-1-2013:p0522:b003:l038","ordinal":116639,"en":"Capture the orphan and bring him,"},{"id":"semetey-1-2013:p0522:b003:l039","ordinal":116640,"en":"Deliver him straight into my hands."},{"id":"semetey-1-2013:p0522:b004:l001","ordinal":116641,"en":"If you do not obey my words—"},{"id":"semetey-1-2013:p0522:b004:l002","ordinal":116642,"en":"My wrestlers, all of you listen!"},{"id":"semetey-1-2013:p0522:b004:l003","ordinal":116643,"en":"To capture Semetey,"},{"id":"semetey-1-2013:p0522:b004:l004","ordinal":116644,"en":"To seize the orphan,"},{"id":"semetey-1-2013:p0522:b004:l005","ordinal":116645,"en":"To put him to death,"},{"id":"semetey-1-2013:p0522:b004:l006","ordinal":116646,"en":"To kill him and take his head,"},{"id":"semetey-1-2013:p0522:b004:l007","ordinal":116647,"en":"To avenge the Camel Wrestler,"},{"id":"semetey-1-2013:p0522:b004:l008","ordinal":116648,"en":"The prince's orphan son,"},{"id":"semetey-1-2013:p0522:b004:l009","ordinal":116649,"en":"To bring disaster upon him!”"},{"id":"semetey-1-2013:p0522:b004:l010","ordinal":116650,"en":"Saying this, the high official"},{"id":"semetey-1-2013:p0522:b004:l011","ordinal":116651,"en":"Beat the drum."},{"id":"semetey-1-2013:p0522:b004:l012","ordinal":116652,"en":"When they heard this news,"},{"id":"semetey-1-2013:p0522:b004:l013","ordinal":116653,"en":"His wrestlers hurried in confusion."},{"id":"semetey-1-2013:p0522:b004:l014","ordinal":116654,"en":"The accursed fellows who had received orders"},{"id":"semetey-1-2013:p0522:b004:l015","ordinal":116655,"en":"“To capture Semetey,”"},{"id":"semetey-1-2013:p0522:b004:l016","ordinal":116656,"en":"Their spears bristling,"},{"id":"semetey-1-2013:p0522:b004:l017","ordinal":116657,"en":"Their battle-axes showing,"},{"id":"semetey-1-2013:p0522:b004:l018","ordinal":116658,"en":"Drawing the attention of onlookers,"},{"id":"semetey-1-2013:p0522:b004:l019","ordinal":116659,"en":"Their leaders spreading their arms,"},{"id":"semetey-1-2013:p0522:b004:l020","ordinal":116660,"en":"His wrestlers rushed upon the boy,"},{"id":"semetey-1-2013:p0522:b004:l021","ordinal":116661,"en":"Swarming forward with limbs flailing."},{"id":"semetey-1-2013:p0522:b004:l022","ordinal":116662,"en":"Then the boy Semetey,"},{"id":"semetey-1-2013:p0522:b004:l023","ordinal":116663,"en":"Offspring of the lion protected by Kyzyr,"},{"id":"semetey-1-2013:p0522:b004:l024","ordinal":116664,"en":"The orphan rode without looking back,"},{"id":"semetey-1-2013:p0522:b004:l025","ordinal":116665,"en":"Paying no heed to Kokand,"},{"id":"semetey-1-2013:p0522:b004:l026","ordinal":116666,"en":"Caring not a straw for death."},{"id":"semetey-1-2013:p0522:b004:l027","ordinal":116667,"en":"His eyes blazed like fire."},{"id":"semetey-1-2013:p0522:b004:l028","ordinal":116668,"en":"His splendid teeth, like gates,"},{"id":"semetey-1-2013:p0522:b004:l029","ordinal":116669,"en":"That offspring of a prince"},{"id":"semetey-1-2013:p0522:b004:l030","ordinal":116670,"en":"Chewed hard, over and over."},{"id":"semetey-1-2013:p0522:b004:l031","ordinal":116671,"en":"His father, fierce Manas,"},{"id":"semetey-1-2013:p0522:b004:l032","ordinal":116672,"en":"Your orphan was born to surpass."},{"id":"semetey-1-2013:p0522:b004:l033","ordinal":116673,"en":"With Aktulpar, heedless,"},{"id":"semetey-1-2013:p0522:b004:l034","ordinal":116674,"en":"The wrestlers who rushed upon him"},{"id":"semetey-1-2013:p0522:b004:l035","ordinal":116675,"en":"He valued less than his shin."},{"id":"semetey-1-2013:p0522:b004:l036","ordinal":116676,"en":"Did you see his dauntless nature?"},{"id":"semetey-1-2013:p0522:b004:l037","ordinal":116677,"en":"The boy went on, heedless."},{"id":"semetey-1-2013:p0522:b004:l038","ordinal":116678,"en":"He did not look up or down,"},{"id":"semetey-1-2013:p0522:b004:l039","ordinal":116679,"en":"The offspring of that accursed one,"},{"id":"semetey-1-2013:p0523:b003:l001","ordinal":116680,"en":"Did not think he would die."},{"id":"semetey-1-2013:p0523:b003:l002","ordinal":116681,"en":"The leopard who poured blood into dark waters—"},{"id":"semetey-1-2013:p0523:b003:l003","ordinal":116682,"en":"He was that leopard's offspring;"},{"id":"semetey-1-2013:p0523:b003:l004","ordinal":116683,"en":"The fierce hero who burned grassy lands—"},{"id":"semetey-1-2013:p0523:b003:l005","ordinal":116684,"en":"He was that hero's offspring."},{"id":"semetey-1-2013:p0523:b003:l006","ordinal":116685,"en":"From his father back to his forefathers,"},{"id":"semetey-1-2013:p0523:b003:l007","ordinal":116686,"en":"They spared none who grappled with them,"},{"id":"semetey-1-2013:p0523:b003:l008","ordinal":116687,"en":"Drank blood and were never sated,"},{"id":"semetey-1-2013:p0523:b003:l009","ordinal":116688,"en":"Had their undertakings favored by God,"},{"id":"semetey-1-2013:p0523:b003:l010","ordinal":116689,"en":"And never went back on their word."},{"id":"semetey-1-2013:p0523:b003:l011","ordinal":116690,"en":"Perhaps you have heard of him,"},{"id":"semetey-1-2013:p0523:b003:l012","ordinal":116691,"en":"Khan Manas's only son."},{"id":"semetey-1-2013:p0523:b003:l013","ordinal":116692,"en":"Before this, the boy Semetey"},{"id":"semetey-1-2013:p0523:b003:l014","ordinal":116693,"en":"Had never known such enemies;"},{"id":"semetey-1-2013:p0523:b003:l015","ordinal":116694,"en":"The generous hero's only son"},{"id":"semetey-1-2013:p0523:b003:l016","ordinal":116695,"en":"Had never charged into battle with a shout."},{"id":"semetey-1-2013:p0523:b003:l017","ordinal":116696,"en":"Not thinking they were enemies,"},{"id":"semetey-1-2013:p0523:b003:l018","ordinal":116697,"en":"To this proud, cock-like lion"},{"id":"semetey-1-2013:p0523:b003:l019","ordinal":116698,"en":"Courage had been given beyond measure."},{"id":"semetey-1-2013:p0523:b003:l020","ordinal":116699,"en":"He continued on, heedless;"},{"id":"semetey-1-2013:p0523:b003:l021","ordinal":116700,"en":"From hero Manas himself"},{"id":"semetey-1-2013:p0523:b003:l022","ordinal":116701,"en":"He had been born, without measure."},{"id":"semetey-1-2013:p0523:b003:l023","ordinal":116702,"en":"All the wrestlers,"},{"id":"semetey-1-2013:p0523:b003:l024","ordinal":116703,"en":"Their old man with a forked beard,"},{"id":"semetey-1-2013:p0523:b003:l025","ordinal":116704,"en":"Their skilled battle-axe men,"},{"id":"semetey-1-2013:p0523:b003:l026","ordinal":116705,"en":"Their capable spearmen,"},{"id":"semetey-1-2013:p0523:b003:l027","ordinal":116706,"en":"Their formidable swordsmen,"},{"id":"semetey-1-2013:p0523:b003:l028","ordinal":116707,"en":"Their marksmen who never missed,"},{"id":"semetey-1-2013:p0523:b003:l029","ordinal":116708,"en":"That dear one left by Manas"},{"id":"semetey-1-2013:p0523:b003:l030","ordinal":116709,"en":"They all pursued together."},{"id":"semetey-1-2013:p0523:b003:l031","ordinal":116710,"en":"All the wrestlers shouted,"},{"id":"semetey-1-2013:p0523:b003:l032","ordinal":116711,"en":"Crying “Kokand!” as their battle cry."},{"id":"semetey-1-2013:p0523:b003:l033","ordinal":116712,"en":"“Hey, orphan slave, do not flee!” they said,"},{"id":"semetey-1-2013:p0523:b003:l034","ordinal":116713,"en":"As if to reap and gather him,"},{"id":"semetey-1-2013:p0523:b003:l035","ordinal":116714,"en":"As if to cast him alive into their pit,"},{"id":"semetey-1-2013:p0523:b003:l036","ordinal":116715,"en":"Before the high official,"},{"id":"semetey-1-2013:p0523:b003:l037","ordinal":116716,"en":"Without killing or losing him,"},{"id":"semetey-1-2013:p0523:b003:l038","ordinal":116717,"en":"As if to drive him there alive."},{"id":"semetey-1-2013:p0523:b003:l039","ordinal":116718,"en":"When one looked at those wrestlers,"},{"id":"semetey-1-2013:p0523:b005:l001","ordinal":116719,"en":"Their dreadful looks stood out;"},{"id":"semetey-1-2013:p0523:b005:l002","ordinal":116720,"en":"They looked like angels of death."},{"id":"semetey-1-2013:p0523:b005:l003","ordinal":116721,"en":"Their spearmen worked themselves up,"},{"id":"semetey-1-2013:p0523:b005:l004","ordinal":116722,"en":"“That orphan left by Manas,” they said,"},{"id":"semetey-1-2013:p0523:b005:l005","ordinal":116723,"en":"Calling him a scoundrel."},{"id":"semetey-1-2013:p0523:b005:l006","ordinal":116724,"en":"“Let them do what they will,” he thought."},{"id":"semetey-1-2013:p0523:b005:l007","ordinal":116725,"en":"Semetey did not look back at the wrestlers."},{"id":"semetey-1-2013:p0523:b005:l008","ordinal":116726,"en":"Looming bulky, heedless,"},{"id":"semetey-1-2013:p0523:b005:l009","ordinal":116727,"en":"The many wrestlers swarming upon him—"},{"id":"semetey-1-2013:p0523:b005:l010","ordinal":116728,"en":"Semetey went on,"},{"id":"semetey-1-2013:p0523:b005:l011","ordinal":116729,"en":"Valuing them less than his boot."},{"id":"semetey-1-2013:p0523:b005:l012","ordinal":116730,"en":"As the boy continued on,"},{"id":"semetey-1-2013:p0523:b005:l013","ordinal":116731,"en":"All their wrestlers,"},{"id":"semetey-1-2013:p0523:b005:l014","ordinal":116732,"en":"Their elder, the ishan dignitary,"},{"id":"semetey-1-2013:p0523:b005:l015","ordinal":116733,"en":"Now reached the boy,"},{"id":"semetey-1-2013:p0523:b005:l016","ordinal":116734,"en":"All those men of Kokand."},{"id":"semetey-1-2013:p0523:b005:l017","ordinal":116735,"en":"From among the skilled spearmen,"},{"id":"semetey-1-2013:p0523:b005:l018","ordinal":116736,"en":"The orphan left by Manas"}]
