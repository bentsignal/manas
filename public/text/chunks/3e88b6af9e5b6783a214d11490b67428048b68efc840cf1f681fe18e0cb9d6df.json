[{"id":"semetey-1-2013:p0760:b004:l027","ordinal":135169,"en":"Never shrinking from what he saw,"},{"id":"semetey-1-2013:p0760:b004:l028","ordinal":135170,"en":"Not more than a hobby,"},{"id":"semetey-1-2013:p0760:b004:l029","ordinal":135171,"en":"He would not fold his wings and swoop;"},{"id":"semetey-1-2013:p0760:b004:l030","ordinal":135172,"en":"He would not let a goose fly from the lake."},{"id":"semetey-1-2013:p0760:b004:l031","ordinal":135173,"en":"He would not gather his tail and swoop;"},{"id":"semetey-1-2013:p0760:b004:l032","ordinal":135174,"en":"He would not let a swan fly from the lake."},{"id":"semetey-1-2013:p0760:b004:l033","ordinal":135175,"en":"He was a bird to take hunting;"},{"id":"semetey-1-2013:p0760:b004:l034","ordinal":135176,"en":"He was a possession left by my father."},{"id":"semetey-1-2013:p0760:b004:l035","ordinal":135177,"en":"Where is the white falcon, uncle?!"},{"id":"semetey-1-2013:p0760:b004:l036","ordinal":135178,"en":"Long ago, into looming Great Beijing,"},{"id":"semetey-1-2013:p0760:b004:l037","ordinal":135179,"en":"When he went straight in and thrust his spear,"},{"id":"semetey-1-2013:p0760:b004:l038","ordinal":135180,"en":"From a hell of grievous suffering,"},{"id":"semetey-1-2013:p0760:b004:l039","ordinal":135181,"en":"When he freed lives."},{"id":"semetey-1-2013:p0761:b003:l001","ordinal":135182,"en":"Into Beijing, where no prophet goes,"},{"id":"semetey-1-2013:p0761:b003:l002","ordinal":135183,"en":"When he marched and wrought slaughter,"},{"id":"semetey-1-2013:p0761:b003:l003","ordinal":135184,"en":"Black Chinese in Kakanda"},{"id":"semetey-1-2013:p0761:b003:l004","ordinal":135185,"en":"When he seized their king,"},{"id":"semetey-1-2013:p0761:b003:l005","ordinal":135186,"en":"Folding the bulletproof coat,"},{"id":"semetey-1-2013:p0761:b003:l006","ordinal":135187,"en":"Loading it on as he wished,"},{"id":"semetey-1-2013:p0761:b003:l007","ordinal":135188,"en":"Loading plenty of steel shot,"},{"id":"semetey-1-2013:p0761:b003:l008","ordinal":135189,"en":"And loading the journey provisions too,"},{"id":"semetey-1-2013:p0761:b003:l009","ordinal":135190,"en":"When my father the khan went to war,"},{"id":"semetey-1-2013:p0761:b003:l010","ordinal":135191,"en":"Jelmaian went along with him."},{"id":"semetey-1-2013:p0761:b003:l011","ordinal":135192,"en":"Those were the words my mother spoke;"},{"id":"semetey-1-2013:p0761:b003:l012","ordinal":135193,"en":"She spoke them to your six uncles."},{"id":"semetey-1-2013:p0761:b003:l013","ordinal":135194,"en":"Where is that swift Jelmaian?"},{"id":"semetey-1-2013:p0761:b003:l014","ordinal":135195,"en":"Its collar gold, its sleeves copper,"},{"id":"semetey-1-2013:p0761:b003:l015","ordinal":135196,"en":"Double mail with lark-eye links,"},{"id":"semetey-1-2013:p0761:b003:l016","ordinal":135197,"en":"Akolpok, left by my father,"},{"id":"semetey-1-2013:p0761:b003:l017","ordinal":135198,"en":"Has fallen to you as plunder!"},{"id":"semetey-1-2013:p0761:b003:l018","ordinal":135199,"en":"To wear securely as a gift,"},{"id":"semetey-1-2013:p0761:b003:l019","ordinal":135200,"en":"I hear it is a renowned coat,"},{"id":"semetey-1-2013:p0761:b003:l020","ordinal":135201,"en":"For facing and striking the enemy."},{"id":"semetey-1-2013:p0761:b003:l021","ordinal":135202,"en":"Knowing an orphan is an orphan,"},{"id":"semetey-1-2013:p0761:b003:l022","ordinal":135203,"en":"Look after me properly, uncle."},{"id":"semetey-1-2013:p0761:b003:l023","ordinal":135204,"en":"I came to ask it of you:"},{"id":"semetey-1-2013:p0761:b003:l024","ordinal":135205,"en":"Give me Akolpok."},{"id":"semetey-1-2013:p0761:b003:l025","ordinal":135206,"en":"The six keen blades left by my father,"},{"id":"semetey-1-2013:p0761:b003:l026","ordinal":135207,"en":"The finest-tempered sword,"},{"id":"semetey-1-2013:p0761:b003:l027","ordinal":135208,"en":"Zulpukor, which Manas took,"},{"id":"semetey-1-2013:p0761:b003:l028","ordinal":135209,"en":"Azhybay's Achalbars,"},{"id":"semetey-1-2013:p0761:b003:l029","ordinal":135210,"en":"Kylbolot, which Bakay took,"},{"id":"semetey-1-2013:p0761:b003:l030","ordinal":135211,"en":"Almambet's Oykuma,"},{"id":"semetey-1-2013:p0761:b003:l031","ordinal":135212,"en":"Hero Chubak's Zhoykuma,"},{"id":"semetey-1-2013:p0761:b003:l032","ordinal":135213,"en":"Arkesken, which Syrgak took—"},{"id":"semetey-1-2013:p0761:b003:l033","ordinal":135214,"en":"Those honored swords, six keen blades,"},{"id":"semetey-1-2013:p0761:b003:l034","ordinal":135215,"en":"When my mother was in mourning,"},{"id":"semetey-1-2013:p0761:b003:l035","ordinal":135216,"en":"When you swept down and attacked,"},{"id":"semetey-1-2013:p0761:b003:l036","ordinal":135217,"en":"You seized and kept them."},{"id":"semetey-1-2013:p0761:b003:l037","ordinal":135218,"en":"I came to ask: where are they?"},{"id":"semetey-1-2013:p0761:b003:l038","ordinal":135219,"en":"Those who knew would tell of"},{"id":"semetey-1-2013:p0761:b003:l039","ordinal":135220,"en":"Bozkise, descended from the sky,"},{"id":"semetey-1-2013:p0761:b005:l001","ordinal":135221,"en":"With my father the khan, the fierce hero,"},{"id":"semetey-1-2013:p0761:b005:l002","ordinal":135222,"en":"The belt was a friend indeed."},{"id":"semetey-1-2013:p0761:b005:l003","ordinal":135223,"en":"When he cried out and fastened it at his waist,"},{"id":"semetey-1-2013:p0761:b005:l004","ordinal":135224,"en":"The forty saints became his companions."},{"id":"semetey-1-2013:p0761:b005:l005","ordinal":135225,"en":"When he shouted and fastened it at his waist,"},{"id":"semetey-1-2013:p0761:b005:l006","ordinal":135226,"en":"The strength of a lion came to him."},{"id":"semetey-1-2013:p0761:b005:l007","ordinal":135227,"en":"No mortal could stand against him;"},{"id":"semetey-1-2013:p0761:b005:l008","ordinal":135228,"en":"The enemy he faced fell."},{"id":"semetey-1-2013:p0761:b005:l009","ordinal":135229,"en":"Then my distressed mother Kanykey—"},{"id":"semetey-1-2013:p0761:b005:l010","ordinal":135230,"en":"You went straight in to her,"},{"id":"semetey-1-2013:p0761:b005:l011","ordinal":135231,"en":"Wreaked havoc upon my mother,"},{"id":"semetey-1-2013:p0761:b005:l012","ordinal":135232,"en":"And seized this from her."},{"id":"semetey-1-2013:p0761:b005:l013","ordinal":135233,"en":"I came to ask; agree,"},{"id":"semetey-1-2013:p0761:b005:l014","ordinal":135234,"en":"And give me Bozkise."},{"id":"semetey-1-2013:p0761:b005:l015","ordinal":135235,"en":"When that wondrous thing was slung,"},{"id":"semetey-1-2013:p0761:b005:l016","ordinal":135236,"en":"It was the mirror of the shoulder blade."},{"id":"semetey-1-2013:p0761:b005:l017","ordinal":135237,"en":"If it struck the enemy in battle once,"},{"id":"semetey-1-2013:p0761:b005:l018","ordinal":135238,"en":"It was the support of one's entrusted life."},{"id":"semetey-1-2013:p0761:b005:l019","ordinal":135239,"en":"It is property left by my father,"},{"id":"semetey-1-2013:p0761:b005:l020","ordinal":135240,"en":"A keen weapon to carry."},{"id":"semetey-1-2013:p0761:b005:l021","ordinal":135241,"en":"Where is Akkelte? Tell me this!"},{"id":"semetey-1-2013:p0761:b005:l022","ordinal":135242,"en":"When my father died,"},{"id":"semetey-1-2013:p0761:b005:l023","ordinal":135243,"en":"On the hills were mottled-headed horses,"},{"id":"semetey-1-2013:p0761:b005:l024","ordinal":135244,"en":"Coursers and swift steeds mingled—"},{"id":"semetey-1-2013:p0761:b005:l025","ordinal":135245,"en":"Where is the livestock my father left?"},{"id":"semetey-1-2013:p0761:b005:l026","ordinal":135246,"en":"Uncle Abyke, tell me this:"},{"id":"semetey-1-2013:p0761:b005:l027","ordinal":135247,"en":"Treasures filling eight buildings,"},{"id":"semetey-1-2013:p0761:b005:l028","ordinal":135248,"en":"Red gold coins and yellow gold,"},{"id":"semetey-1-2013:p0761:b005:l029","ordinal":135249,"en":"Gemstones and rubies mingled—"},{"id":"semetey-1-2013:p0761:b005:l030","ordinal":135250,"en":"Uncle Abyke, tell me this."},{"id":"semetey-1-2013:p0761:b005:l031","ordinal":135251,"en":"Narbuurul, left by my father,"},{"id":"semetey-1-2013:p0761:b005:l032","ordinal":135252,"en":"Born in the desert, raised upon stone,"},{"id":"semetey-1-2013:p0761:b005:l033","ordinal":135253,"en":"Raised apart among the spirits,"},{"id":"semetey-1-2013:p0761:b005:l034","ordinal":135254,"en":"Who raced with wild asses,"},{"id":"semetey-1-2013:p0761:b005:l035","ordinal":135255,"en":"With the maiden Saykal's Algara,"},{"id":"semetey-1-2013:p0761:b005:l036","ordinal":135256,"en":"The winged steed, born of the same kin."},{"id":"semetey-1-2013:p0761:b005:l037","ordinal":135257,"en":"High-backed, short of stature,"},{"id":"semetey-1-2013:p0761:b005:l038","ordinal":135258,"en":"He would not falter upon the hills;"},{"id":"semetey-1-2013:p0761:b005:l039","ordinal":135259,"en":"Until he reached his sixty-fourth year,"},{"id":"semetey-1-2013:p0762:b003:l001","ordinal":135260,"en":"He would not grow old grinding his teeth."},{"id":"semetey-1-2013:p0762:b003:l002","ordinal":135261,"en":"When he came to compete,"},{"id":"semetey-1-2013:p0762:b003:l003","ordinal":135262,"en":"The roan horse given as a gift,"},{"id":"semetey-1-2013:p0762:b003:l004","ordinal":135263,"en":"With a camel's forelock and a short mane,"},{"id":"semetey-1-2013:p0762:b003:l005","ordinal":135264,"en":"A courser left by my father, Khan Manas."},{"id":"semetey-1-2013:p0762:b003:l007","ordinal":135265,"en":"When Saykal gave him as a gift,"},{"id":"semetey-1-2013:p0762:b003:l008","ordinal":135266,"en":"When he arrived as a yearling,"},{"id":"semetey-1-2013:p0762:b003:l009","ordinal":135267,"en":"They had owl feathers fixed upon his head,"},{"id":"semetey-1-2013:p0762:b003:l010","ordinal":135268,"en":"Had him kept in a dark place,"},{"id":"semetey-1-2013:p0762:b003:l011","ordinal":135269,"en":"A horse judge tested and approved him,"},{"id":"semetey-1-2013:p0762:b003:l012","ordinal":135270,"en":"And had a rich covering laid upon him."},{"id":"semetey-1-2013:p0762:b003:l013","ordinal":135271,"en":"Twisting his neck like a stag,"},{"id":"semetey-1-2013:p0762:b003:l014","ordinal":135272,"en":"If a precipice a bowshot wide appeared,"},{"id":"semetey-1-2013:p0762:b003:l015","ordinal":135273,"en":"He galloped on without delay."},{"id":"semetey-1-2013:p0762:b003:l016","ordinal":135274,"en":"Once they knew his speed,"},{"id":"semetey-1-2013:p0762:b003:l017","ordinal":135275,"en":"Giving gold by the pood and fine cloth,"},{"id":"semetey-1-2013:p0762:b003:l018","ordinal":135276,"en":"The khan of Bukhara asked for him."},{"id":"semetey-1-2013:p0762:b003:l019","ordinal":135277,"en":"Twisting his neck like a wild sheep,"},{"id":"semetey-1-2013:p0762:b003:l020","ordinal":135278,"en":"If a trench a rope's length wide appeared,"},{"id":"semetey-1-2013:p0762:b003:l021","ordinal":135279,"en":"He cleared it without hesitation and raced on."},{"id":"semetey-1-2013:p0762:b003:l022","ordinal":135280,"en":"When they knew his excellence,"},{"id":"semetey-1-2013:p0762:b003:l023","ordinal":135281,"en":"Offering red gold with coaxing words,"},{"id":"semetey-1-2013:p0762:b003:l024","ordinal":135282,"en":"The khan of Andijan asked for him."},{"id":"semetey-1-2013:p0762:b003:l025","ordinal":135283,"en":"They would not give him to those who asked;"},{"id":"semetey-1-2013:p0762:b003:l026","ordinal":135284,"en":"Far from giving Buurul away,"},{"id":"semetey-1-2013:p0762:b003:l027","ordinal":135285,"en":"No person without ritual washing rode him."},{"id":"semetey-1-2013:p0762:b003:l028","ordinal":135286,"en":"Then there were Muzburchak and Khan Kokcho,"},{"id":"semetey-1-2013:p0762:b003:l029","ordinal":135287,"en":"There were the giants Koshoi and Toshtuk,"},{"id":"semetey-1-2013:p0762:b003:l030","ordinal":135288,"en":"All the mighty Muslim champions were there."},{"id":"semetey-1-2013:p0762:b003:l031","ordinal":135289,"en":"When Almambet had passed as a martyr,"},{"id":"semetey-1-2013:p0762:b003:l032","ordinal":135290,"en":"And my father was left standing tall,"},{"id":"semetey-1-2013:p0762:b003:l033","ordinal":135291,"en":"Kozhozhash, son of Karazhoi,"},{"id":"semetey-1-2013:p0762:b003:l034","ordinal":135292,"en":"Brought upon him grievous trouble."},{"id":"semetey-1-2013:p0762:b003:l035","ordinal":135293,"en":"Leaning upon Akkelte,"},{"id":"semetey-1-2013:p0762:b003:l036","ordinal":135294,"en":"My noble father stood bereft,"},{"id":"semetey-1-2013:p0762:b003:l037","ordinal":135295,"en":"Bewildered, finding no way out,"},{"id":"semetey-1-2013:p0762:b003:l038","ordinal":135296,"en":"Grieving and sorrowing,"},{"id":"semetey-1-2013:p0762:b003:l039","ordinal":135297,"en":"Having lost Akkula,"},{"id":"semetey-1-2013:p0762:b004:l001","ordinal":135298,"en":"When my leopard father stood there,"},{"id":"semetey-1-2013:p0762:b004:l002","ordinal":135299,"en":"Saint-like Khan Bakay"},{"id":"semetey-1-2013:p0762:b004:l003","ordinal":135300,"en":"Buurul, in his fifth year—"},{"id":"semetey-1-2013:p0762:b004:l004","ordinal":135301,"en":"When he arrived bringing him,"},{"id":"semetey-1-2013:p0762:b004:l005","ordinal":135302,"en":"When my father mounted Buurul,"},{"id":"semetey-1-2013:p0762:b004:l006","ordinal":135303,"en":"And spurred him into the enemy,"},{"id":"semetey-1-2013:p0762:b004:l007","ordinal":135304,"en":"Turning the black Chinese back,"},{"id":"semetey-1-2013:p0762:b004:l008","ordinal":135305,"en":"Driving them toward Beijing,"},{"id":"semetey-1-2013:p0762:b004:l009","ordinal":135306,"en":"When he traveled six months without rest,"},{"id":"semetey-1-2013:p0762:b004:l010","ordinal":135307,"en":"My lead-boned father"},{"id":"semetey-1-2013:p0762:b004:l011","ordinal":135308,"en":"He carried without fail."},{"id":"semetey-1-2013:p0762:b004:l012","ordinal":135309,"en":"My father, like a towering mountain,"},{"id":"semetey-1-2013:p0762:b004:l013","ordinal":135310,"en":"He bore at a run without faltering."},{"id":"semetey-1-2013:p0762:b004:l014","ordinal":135311,"en":"When my father was about to die,"},{"id":"semetey-1-2013:p0762:b004:l015","ordinal":135312,"en":"About to face Judgment Day,"},{"id":"semetey-1-2013:p0762:b004:l016","ordinal":135313,"en":"Buurul, nearing his fifth year,"},{"id":"semetey-1-2013:p0762:b004:l017","ordinal":135314,"en":"Was tethered beside him."},{"id":"semetey-1-2013:p0762:b004:l018","ordinal":135315,"en":"My precious leopard father"},{"id":"semetey-1-2013:p0762:b004:l019","ordinal":135316,"en":"Found comfort in him there."},{"id":"semetey-1-2013:p0762:b004:l020","ordinal":135317,"en":"Buurul, the horse allotted to me—"},{"id":"semetey-1-2013:p0762:b004:l021","ordinal":135318,"en":"I was asking what had become of him."},{"id":"semetey-1-2013:p0762:b004:l022","ordinal":135319,"en":"At the place where he was tethered,"},{"id":"semetey-1-2013:p0762:b004:l023","ordinal":135320,"en":"From any nar steam"},{"id":"semetey-1-2013:p0762:b004:l024","ordinal":135321,"en":"That wondrous creature neighed,"},{"id":"semetey-1-2013:p0762:b004:l025","ordinal":135322,"en":"Pawed and tore at the earth."},{"id":"semetey-1-2013:p0762:b004:l026","ordinal":135323,"en":"Though an animal, that wondrous creature"},{"id":"semetey-1-2013:p0762:b004:l027","ordinal":135324,"en":"Stood observing mourning."},{"id":"semetey-1-2013:p0762:b004:l028","ordinal":135325,"en":"Where is a Kyrgyz soul in Talas?"},{"id":"semetey-1-2013:p0762:b004:l029","ordinal":135326,"en":"Where is an animal like Buurul?"},{"id":"semetey-1-2013:p0762:b004:l030","ordinal":135327,"en":"Where is this property of mine, where is it?"},{"id":"semetey-1-2013:p0762:b004:l031","ordinal":135328,"en":"Then Abyke said this:"},{"id":"semetey-1-2013:p0762:b004:l032","ordinal":135329,"en":"“My dear orphan,"},{"id":"semetey-1-2013:p0762:b004:l033","ordinal":135330,"en":"What you say is true as well;"},{"id":"semetey-1-2013:p0762:b004:l034","ordinal":135331,"en":"Everything you say is true."},{"id":"semetey-1-2013:p0762:b004:l035","ordinal":135332,"en":"Your noble father Manas—"},{"id":"semetey-1-2013:p0762:b004:l036","ordinal":135333,"en":"What he had, and what he lacked,"},{"id":"semetey-1-2013:p0762:b004:l037","ordinal":135334,"en":"Appeared like an image before my eyes."},{"id":"semetey-1-2013:p0762:b004:l038","ordinal":135335,"en":"Such is this shitty world!"},{"id":"semetey-1-2013:p0762:b004:l039","ordinal":135336,"en":"Sorrow within me, embers without,"},{"id":"semetey-1-2013:p0763:b003:l001","ordinal":135337,"en":"There is no one to heed my words,"},{"id":"semetey-1-2013:p0763:b003:l002","ordinal":135338,"en":"My flowing river and spring,"},{"id":"semetey-1-2013:p0763:b003:l003","ordinal":135339,"en":"My long-awaited darling."},{"id":"semetey-1-2013:p0763:b003:l004","ordinal":135340,"en":"You have sent alive into the grave"},{"id":"semetey-1-2013:p0763:b003:l005","ordinal":135341,"en":"Your uncle Abyke."},{"id":"semetey-1-2013:p0763:b003:l006","ordinal":135342,"en":"Today you showed your fierce courage."},{"id":"semetey-1-2013:p0763:b003:l007","ordinal":135343,"en":"I have withered without dying,"},{"id":"semetey-1-2013:p0763:b003:l008","ordinal":135344,"en":"And you have asked me for Kumaiyk."},{"id":"semetey-1-2013:p0763:b003:l009","ordinal":135345,"en":"The story of Kumaiyk—"},{"id":"semetey-1-2013:p0763:b003:l010","ordinal":135346,"en":"How could I fail to tell it?"},{"id":"semetey-1-2013:p0763:b003:l011","ordinal":135347,"en":"Your father, Khan Manas, the leopard,"},{"id":"semetey-1-2013:p0763:b003:l012","ordinal":135348,"en":"My saint who has passed away,"},{"id":"semetey-1-2013:p0763:b003:l013","ordinal":135349,"en":"Across its spreading farther face,"},{"id":"semetey-1-2013:p0763:b003:l014","ordinal":135350,"en":"At the place where he performed his ablutions,"},{"id":"semetey-1-2013:p0763:b003:l015","ordinal":135351,"en":"Kumaiyk was found,"},{"id":"semetey-1-2013:p0763:b003:l016","ordinal":135352,"en":"Encountered through the unseen world."},{"id":"semetey-1-2013:p0763:b003:l017","ordinal":135353,"en":"A blue vulture had borne and left him;"},{"id":"semetey-1-2013:p0763:b003:l018","ordinal":135354,"en":"He was found after three days."},{"id":"semetey-1-2013:p0763:b003:l019","ordinal":135355,"en":"When he took him in his hand and looked,"},{"id":"semetey-1-2013:p0763:b003:l020","ordinal":135356,"en":"Your leopard father, your guardian spirit,"},{"id":"semetey-1-2013:p0763:b003:l021","ordinal":135357,"en":"There was a gray pup the size of a fist."},{"id":"semetey-1-2013:p0763:b003:l022","ordinal":135358,"en":"Manas stood astonished."},{"id":"semetey-1-2013:p0763:b003:l023","ordinal":135359,"en":"“This is truly Kumaiyk,” he said,"},{"id":"semetey-1-2013:p0763:b003:l024","ordinal":135360,"en":"Your uncle Bakay the leopard,"},{"id":"semetey-1-2013:p0763:b003:l025","ordinal":135361,"en":"Having examined Kumaiyk."},{"id":"semetey-1-2013:p0763:b003:l026","ordinal":135362,"en":"Kanykey in Bukhara"},{"id":"semetey-1-2013:p0763:b003:l027","ordinal":135363,"en":"Was a maiden at that time."},{"id":"semetey-1-2013:p0763:b003:l028","ordinal":135364,"en":"He took him and arrived there."},{"id":"semetey-1-2013:p0763:b003:l029","ordinal":135365,"en":"Around Kumaiyk's neck"},{"id":"semetey-1-2013:p0763:b003:l030","ordinal":135366,"en":"She put a collar of steel."},{"id":"semetey-1-2013:p0763:b003:l031","ordinal":135367,"en":"Kanykey beyond measure"},{"id":"semetey-1-2013:p0763:b003:l032","ordinal":135368,"en":"Reared him with boundless care."},{"id":"semetey-1-2013:p0763:b003:l033","ordinal":135369,"en":"Do not ask about Kumaiyk!"},{"id":"semetey-1-2013:p0763:b003:l034","ordinal":135370,"en":"Poor Manas's mighty hunter,"},{"id":"semetey-1-2013:p0763:b003:l035","ordinal":135371,"en":"His bearing surpassed a human's."},{"id":"semetey-1-2013:p0763:b003:l036","ordinal":135372,"en":"Set upon a tiger with a cry of “Attack!”"},{"id":"semetey-1-2013:p0763:b003:l037","ordinal":135373,"en":"He did not flee like a mere dog."},{"id":"semetey-1-2013:p0763:b003:l038","ordinal":135374,"en":"Set upon a bear with a cry of “Attack!”"},{"id":"semetey-1-2013:p0763:b003:l039","ordinal":135375,"en":"He ravaged whatever he bit,"},{"id":"semetey-1-2013:p0763:b005:l001","ordinal":135376,"en":"Making the one who unleashed him laugh."},{"id":"semetey-1-2013:p0763:b005:l002","ordinal":135377,"en":"That Kumaiyk left by Manas,"},{"id":"semetey-1-2013:p0763:b005:l003","ordinal":135378,"en":"When Manas died,"},{"id":"semetey-1-2013:p0763:b005:l004","ordinal":135379,"en":"Would give himself to no one else."},{"id":"semetey-1-2013:p0763:b005:l005","ordinal":135380,"en":"Kumaiyk wasted away,"},{"id":"semetey-1-2013:p0763:b005:l006","ordinal":135381,"en":"Grew weak observing mourning;"},{"id":"semetey-1-2013:p0763:b005:l007","ordinal":135382,"en":"Kumaiyk wasted away."},{"id":"semetey-1-2013:p0763:b005:l008","ordinal":135383,"en":"When Kumaiyk howled,"},{"id":"semetey-1-2013:p0763:b005:l009","ordinal":135384,"en":"When they saw Kumaiyk,"},{"id":"semetey-1-2013:p0763:b005:l010","ordinal":135385,"en":"Living mortals wept."},{"id":"semetey-1-2013:p0763:b005:l011","ordinal":135386,"en":"Huddled like a quail,"},{"id":"semetey-1-2013:p0763:b005:l012","ordinal":135387,"en":"Kumaiyk crouched,"},{"id":"semetey-1-2013:p0763:b005:l013","ordinal":135388,"en":"His eyes filling with tears;"},{"id":"semetey-1-2013:p0763:b005:l014","ordinal":135389,"en":"Kumaiyk shed them."},{"id":"semetey-1-2013:p0763:b005:l015","ordinal":135390,"en":"Your five reckless uncles"},{"id":"semetey-1-2013:p0763:b005:l016","ordinal":135391,"en":"Harbored evil thoughts,"},{"id":"semetey-1-2013:p0763:b005:l017","ordinal":135392,"en":"And fought with the hound:"},{"id":"semetey-1-2013:p0763:b005:l018","ordinal":135393,"en":"“He has no tongue to speak,"},{"id":"semetey-1-2013:p0763:b005:l019","ordinal":135394,"en":"His dog too shall come to no good—"},{"id":"semetey-1-2013:p0763:b005:l020","ordinal":135395,"en":"The hero, fierce Manas—"},{"id":"semetey-1-2013:p0763:b005:l021","ordinal":135396,"en":"It will not be as when he was here,” they said."},{"id":"semetey-1-2013:p0763:b005:l022","ordinal":135397,"en":"Grabbing him by the collar to train him,"},{"id":"semetey-1-2013:p0763:b005:l023","ordinal":135398,"en":"Dragging him under the whip,"},{"id":"semetey-1-2013:p0763:b005:l024","ordinal":135399,"en":"They left him mottled red,"},{"id":"semetey-1-2013:p0763:b005:l025","ordinal":135400,"en":"Gathered round and beat him."},{"id":"semetey-1-2013:p0763:b005:l026","ordinal":135401,"en":"This year his grief filled him within."},{"id":"semetey-1-2013:p0763:b005:l027","ordinal":135402,"en":"On one side, raging at him,"},{"id":"semetey-1-2013:p0763:b005:l028","ordinal":135403,"en":"Akylay turned against him."},{"id":"semetey-1-2013:p0763:b005:l029","ordinal":135404,"en":"The shepherd tormented him;"},{"id":"semetey-1-2013:p0763:b005:l030","ordinal":135405,"en":"The horse-herder beat him."},{"id":"semetey-1-2013:p0763:b005:l031","ordinal":135406,"en":"Kumaiyk, noblest among animals,"},{"id":"semetey-1-2013:p0763:b005:l032","ordinal":135407,"en":"Suffered with his ears flattened."},{"id":"semetey-1-2013:p0763:b005:l033","ordinal":135408,"en":"Kobosh used force against him;"},{"id":"semetey-1-2013:p0763:b005:l034","ordinal":135409,"en":"Akylay tormented him."},{"id":"semetey-1-2013:p0763:b005:l035","ordinal":135410,"en":"When the people moved uphill,"},{"id":"semetey-1-2013:p0763:b005:l036","ordinal":135411,"en":"Hoping he would faint and die,"},{"id":"semetey-1-2013:p0763:b005:l037","ordinal":135412,"en":"They gave him softened lung meat."},{"id":"semetey-1-2013:p0763:b005:l038","ordinal":135413,"en":"When the people moved downhill,"},{"id":"semetey-1-2013:p0763:b005:l039","ordinal":135414,"en":"They husked the barley,"},{"id":"semetey-1-2013:p0764:b003:l001","ordinal":135415,"en":"Taking the barley bran,"},{"id":"semetey-1-2013:p0764:b003:l002","ordinal":135416,"en":"They made it into gruel and gave it to him."},{"id":"semetey-1-2013:p0764:b003:l003","ordinal":135417,"en":"The bran pierced his lungs;"},{"id":"semetey-1-2013:p0764:b003:l004","ordinal":135418,"en":"His matted coat would not fall away,"},{"id":"semetey-1-2013:p0764:b003:l005","ordinal":135419,"en":"And he was left coughing."},{"id":"semetey-1-2013:p0764:b003:l006","ordinal":135420,"en":"Kumaiyk wasted away;"},{"id":"semetey-1-2013:p0764:b003:l007","ordinal":135421,"en":"He came to be called a thief."},{"id":"semetey-1-2013:p0764:b003:l008","ordinal":135422,"en":"That wondrous creature Kumaiyk"},{"id":"semetey-1-2013:p0764:b003:l009","ordinal":135423,"en":"Was given a bad name."},{"id":"semetey-1-2013:p0764:b003:l010","ordinal":135424,"en":"Onto a saddle-shaped ridge"}]
