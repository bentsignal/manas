[{"id":"semetey-1-2013:p0965:b003:l032","ordinal":149761,"en":"He displayed at the horse's forelock"},{"id":"semetey-1-2013:p0965:b003:l033","ordinal":149762,"en":"A silk bundle as large as a horse's head."},{"id":"semetey-1-2013:p0965:b003:l034","ordinal":149763,"en":"This is the reasoning I am telling you:"},{"id":"semetey-1-2013:p0965:b003:l035","ordinal":149764,"en":"Semetey is my own husband!”"},{"id":"semetey-1-2013:p0965:b003:l036","ordinal":149765,"en":"So Aychürök provoked her, saying:"},{"id":"semetey-1-2013:p0965:b003:l037","ordinal":149766,"en":"“Ill-mannered senior wife,"},{"id":"semetey-1-2013:p0965:b003:l038","ordinal":149767,"en":"If I do not use a greater stratagem,"},{"id":"semetey-1-2013:p0965:b003:l039","ordinal":149768,"en":"If I do not seize and carry away"},{"id":"semetey-1-2013:p0965:b004:l001","ordinal":149769,"en":"Your lord's White Falcon,"},{"id":"semetey-1-2013:p0965:b004:l002","ordinal":149770,"en":"If I do not make sport of this,"},{"id":"semetey-1-2013:p0965:b004:l003","ordinal":149771,"en":"And make you a cast-off wife,"},{"id":"semetey-1-2013:p0965:b004:l004","ordinal":149772,"en":"May I bow the hair down my back"},{"id":"semetey-1-2013:p0965:b004:l005","ordinal":149773,"en":"And marry my father, Khan Akun!”"},{"id":"semetey-1-2013:p0965:b004:l006","ordinal":149774,"en":"Having spoken thus, Aychürök,"},{"id":"semetey-1-2013:p0965:b004:l007","ordinal":149775,"en":"The unfortunate woman skilled"},{"id":"semetey-1-2013:p0965:b004:l008","ordinal":149776,"en":"Through studying the Arabic language,"},{"id":"semetey-1-2013:p0965:b004:l009","ordinal":149777,"en":"Scooped a handful of dust from the ground."},{"id":"semetey-1-2013:p0965:b004:l010","ordinal":149778,"en":"She rapidly recited backward"},{"id":"semetey-1-2013:p0965:b004:l011","ordinal":149779,"en":"A difficult sorcerer's spell;"},{"id":"semetey-1-2013:p0965:b004:l012","ordinal":149780,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p0965:b004:l013","ordinal":149781,"en":"Before anyone could say a word,"},{"id":"semetey-1-2013:p0965:b004:l014","ordinal":149782,"en":"She recited swiftly without restraint"},{"id":"semetey-1-2013:p0965:b004:l015","ordinal":149783,"en":"And cast a chilling spell."},{"id":"semetey-1-2013:p0965:b004:l016","ordinal":149784,"en":"The dust in her hand"},{"id":"semetey-1-2013:p0965:b004:l017","ordinal":149785,"en":"She consecrated with a rite"},{"id":"semetey-1-2013:p0965:b004:l018","ordinal":149786,"en":"And struck her with it."},{"id":"semetey-1-2013:p0965:b004:l019","ordinal":149787,"en":"The pampered wife Chachykey"},{"id":"semetey-1-2013:p0965:b004:l020","ordinal":149788,"en":"Screamed from her bellowing,"},{"id":"semetey-1-2013:p0965:b004:l021","ordinal":149789,"en":"Calling upon her dead ancestors;"},{"id":"semetey-1-2013:p0965:b004:l022","ordinal":149790,"en":"She staggered in a seizure."},{"id":"semetey-1-2013:p0965:b004:l023","ordinal":149791,"en":"The forty young women beside her"},{"id":"semetey-1-2013:p0965:b004:l024","ordinal":149792,"en":"Were left utterly astonished."},{"id":"semetey-1-2013:p0965:b004:l025","ordinal":149793,"en":"Chachykey suffered a convulsion;"},{"id":"semetey-1-2013:p0965:b004:l026","ordinal":149794,"en":"Six or seven supported her,"},{"id":"semetey-1-2013:p0965:b004:l027","ordinal":149795,"en":"And, two abreast, carried her"},{"id":"semetey-1-2013:p0965:b004:l028","ordinal":149796,"en":"Into Chachykey's fortress."},{"id":"semetey-1-2013:p0965:b004:l029","ordinal":149797,"en":"When she remained in this condition,"},{"id":"semetey-1-2013:p0965:b004:l030","ordinal":149798,"en":"Semetey gathered everyone:"},{"id":"semetey-1-2013:p0965:b004:l031","ordinal":149799,"en":"Khojas in white turbans,"},{"id":"semetey-1-2013:p0965:b004:l032","ordinal":149800,"en":"Mullahs learned in scripture,"},{"id":"semetey-1-2013:p0965:b004:l033","ordinal":149801,"en":"The wisest of the good men,"},{"id":"semetey-1-2013:p0965:b004:l034","ordinal":149802,"en":"And shamans experienced in divination."},{"id":"semetey-1-2013:p0965:b004:l035","ordinal":149803,"en":"For six days he had them recite over her;"},{"id":"semetey-1-2013:p0965:b004:l036","ordinal":149804,"en":"Bound as though insane,"},{"id":"semetey-1-2013:p0965:b004:l037","ordinal":149805,"en":"Chachykey recovered her form,"},{"id":"semetey-1-2013:p0965:b004:l038","ordinal":149806,"en":"And when the seventh day came,"},{"id":"semetey-1-2013:p0965:b004:l039","ordinal":149807,"en":"Chachykey regained her speech."}]
