[{"id":"manas-2010:p1812:b001:l011","ordinal":77825,"en":"Sworn mother Kanykei,"},{"id":"manas-2010:p1812:b001:l012","ordinal":77826,"en":"Be damned along with your words!"},{"id":"manas-2010:p1812:b001:l013","ordinal":77827,"en":"My sworn father Manas—"},{"id":"manas-2010:p1812:b001:l014","ordinal":77828,"en":"Let me see his precious face."},{"id":"manas-2010:p1812:b001:l015","ordinal":77829,"en":"I was a moon; let me set."},{"id":"manas-2010:p1812:b001:l016","ordinal":77830,"en":"If he truly takes me as his companion,"},{"id":"manas-2010:p1812:b001:l017","ordinal":77831,"en":"With my sworn father Manas"},{"id":"manas-2010:p1812:b001:l018","ordinal":77832,"en":"Let me lie, feet beside feet."},{"id":"manas-2010:p1812:b001:l019","ordinal":77833,"en":"Let me hear what he says."},{"id":"manas-2010:p1812:b001:l020","ordinal":77834,"en":"If he commands, let me withstand the foe."},{"id":"manas-2010:p1812:b001:l021","ordinal":77835,"en":"If an enemy comes out to fight,"},{"id":"manas-2010:p1812:b001:l022","ordinal":77836,"en":"Let me seize his banner and cast him down."},{"id":"manas-2010:p1812:b001:l023","ordinal":77837,"en":"My sworn father Manas—"},{"id":"manas-2010:p1812:b001:l024","ordinal":77838,"en":"If his enemy comes from China,"},{"id":"manas-2010:p1812:b001:l025","ordinal":77839,"en":"Let me drive him back to Beijing."},{"id":"manas-2010:p1812:b001:l026","ordinal":77840,"en":"If his enemy comes from Russia,"},{"id":"manas-2010:p1812:b001:l027","ordinal":77841,"en":"Let me drive him into Omsk."},{"id":"manas-2010:p1812:b001:l028","ordinal":77842,"en":"With my sworn father Manas"},{"id":"manas-2010:p1812:b001:l029","ordinal":77843,"en":"I shall clasp hands.”"},{"id":"manas-2010:p1812:b001:l030","ordinal":77844,"en":"Your heroic mother Kanykei—"},{"id":"manas-2010:p1812:b001:l031","ordinal":77845,"en":"He seized her waist and shook her,"},{"id":"manas-2010:p1812:b001:l032","ordinal":77846,"en":"Caught her arm and swung her,"},{"id":"manas-2010:p1812:b001:l033","ordinal":77847,"en":"Flung her behind him."},{"id":"manas-2010:p1812:b001:l034","ordinal":77848,"en":"Calling out a greeting as he rushed,"},{"id":"manas-2010:p1812:b001:l035","ordinal":77849,"en":"The young boy entered,"},{"id":"manas-2010:p1812:b001:l036","ordinal":77850,"en":"Pleading, “Dear father!”"},{"id":"manas-2010:p1812:b001:l037","ordinal":77851,"en":"“Father Manas, favored by Khizr,"},{"id":"manas-2010:p1812:b001:l038","ordinal":77852,"en":"You have departed toward Judgment Day."},{"id":"manas-2010:p1812:b001:l039","ordinal":77853,"en":"The Muslims in distress"},{"id":"manas-2010:p1812:b001:l040","ordinal":77854,"en":"You have left desolate."},{"id":"manas-2010:p1812:b001:l041","ordinal":77855,"en":"My khan-father, full of honor,"},{"id":"manas-2010:p1812:b001:l042","ordinal":77856,"en":"May your journey be safe!"},{"id":"manas-2010:p1813:b001:l001","ordinal":77857,"en":"Your little cradle-child"},{"id":"manas-2010:p1813:b001:l002","ordinal":77858,"en":"Is entrusted to the one God!"},{"id":"manas-2010:p1813:b001:l003","ordinal":77859,"en":"My leopard-father, Khan Manas,"},{"id":"manas-2010:p1813:b001:l004","ordinal":77860,"en":"May you attain your desire."},{"id":"manas-2010:p1813:b001:l005","ordinal":77861,"en":"Six san of horses on the hills"},{"id":"manas-2010:p1813:b001:l006","ordinal":77862,"en":"You have left behind!”"},{"id":"manas-2010:p1813:b001:l007","ordinal":77863,"en":"Saying these words then,"},{"id":"manas-2010:p1813:b001:l008","ordinal":77864,"en":"Manas, whose eyes had closed—"},{"id":"manas-2010:p1813:b001:l009","ordinal":77865,"en":"He took hold of his hand."},{"id":"manas-2010:p1813:b001:l010","ordinal":77866,"en":"The precious lion born so dear"},{"id":"manas-2010:p1813:b001:l011","ordinal":77867,"en":"Gripped it with great force."},{"id":"manas-2010:p1813:b001:l012","ordinal":77868,"en":"With that firmly clasped hand,"},{"id":"manas-2010:p1813:b001:l013","ordinal":77869,"en":"His eyes opened again;"},{"id":"manas-2010:p1813:b001:l014","ordinal":77870,"en":"Manas the lion awoke again."},{"id":"manas-2010:p1813:b001:l015","ordinal":77871,"en":"Ever since Manas had become Manas,"},{"id":"manas-2010:p1813:b001:l016","ordinal":77872,"en":"Ever since he had gained the name Manas,"},{"id":"manas-2010:p1813:b001:l017","ordinal":77873,"en":"Ever since he had slaughtered the Chinese,"},{"id":"manas-2010:p1813:b001:l018","ordinal":77874,"en":"He had never seen such a hand,"},{"id":"manas-2010:p1813:b001:l019","ordinal":77875,"en":"Never known its like."},{"id":"manas-2010:p1813:b001:l020","ordinal":77876,"en":"Manas fixed his attention now"},{"id":"manas-2010:p1813:b001:l021","ordinal":77877,"en":"Upon little Koyonaaly,"},{"id":"manas-2010:p1813:b001:l022","ordinal":77878,"en":"Looking straight at him."},{"id":"manas-2010:p1813:b001:l023","ordinal":77879,"en":"And so Manas's"},{"id":"manas-2010:p1813:b001:l024","ordinal":77880,"en":"Gaze upon little Koyonaaly"},{"id":"manas-2010:p1813:b001:l025","ordinal":77881,"en":"Struck him with the evil eye:"},{"id":"manas-2010:p1813:b001:l026","ordinal":77882,"en":"“Among Argyn and Nogoy,"},{"id":"manas-2010:p1813:b001:l027","ordinal":77883,"en":"Among the generations and the Kyrgyz,"},{"id":"manas-2010:p1813:b001:l028","ordinal":77884,"en":"While governing the people,"},{"id":"manas-2010:p1813:b001:l029","ordinal":77885,"en":"There would be heaps of gathered wealth;"},{"id":"manas-2010:p1813:b001:l030","ordinal":77886,"en":"A child like this"},{"id":"manas-2010:p1813:b001:l031","ordinal":77887,"en":"I have never seen.”"},{"id":"manas-2010:p1813:b001:l032","ordinal":77888,"en":"Then precious Kanykei"},{"id":"manas-2010:p1813:b001:l033","ordinal":77889,"en":"Burst into piercing cries,"},{"id":"manas-2010:p1813:b001:l034","ordinal":77890,"en":"Broke into bitter wailing:"},{"id":"manas-2010:p1813:b001:l035","ordinal":77891,"en":"“My wretched lord, you will come to no good!"},{"id":"manas-2010:p1813:b001:l036","ordinal":77892,"en":"You never cease your greed!"},{"id":"manas-2010:p1813:b001:l037","ordinal":77893,"en":"Devouring the flame beside you,"},{"id":"manas-2010:p1813:b001:l038","ordinal":77894,"en":"Have you become like a wild ass?"},{"id":"manas-2010:p1813:b001:l039","ordinal":77895,"en":"Depriving him of feet to walk,"},{"id":"manas-2010:p1813:b001:l040","ordinal":77896,"en":"Have you made him like a snake?"},{"id":"manas-2010:p1813:b001:l041","ordinal":77897,"en":"If you do not know who he is:"},{"id":"manas-2010:p1813:b001:l042","ordinal":77898,"en":"The spring of the broad valley,"},{"id":"manas-2010:p1814:b001:l001","ordinal":77899,"en":"Your friend Kokboru's"},{"id":"manas-2010:p1814:b001:l002","ordinal":77900,"en":"Little Koyonaaly."},{"id":"manas-2010:p1814:b001:l003","ordinal":77901,"en":"Alas, Blood-Shedder, let go!” she said,"},{"id":"manas-2010:p1814:b001:l004","ordinal":77902,"en":"And pulled him away by the hand."},{"id":"manas-2010:p1814:b001:l005","ordinal":77903,"en":"“You wretched fierce one, you will come to no good!"},{"id":"manas-2010:p1814:b001:l006","ordinal":77904,"en":"Kanykei, rich in wisdom,"},{"id":"manas-2010:p1814:b001:l007","ordinal":77905,"en":"You never yield."},{"id":"manas-2010:p1814:b001:l008","ordinal":77906,"en":"This child will now fall in his prime."},{"id":"manas-2010:p1814:b001:l009","ordinal":77907,"en":"He will perish while still young;"},{"id":"manas-2010:p1814:b001:l010","ordinal":77908,"en":"He will not last seven days."},{"id":"manas-2010:p1814:b001:l011","ordinal":77909,"en":"Listen to my words:"},{"id":"manas-2010:p1814:b001:l012","ordinal":77910,"en":"We were friends into the next world."},{"id":"manas-2010:p1814:b001:l013","ordinal":77911,"en":"Little Koyonaaly—"},{"id":"manas-2010:p1814:b001:l014","ordinal":77912,"en":"Will you give him to me, Kokboru?"},{"id":"manas-2010:p1814:b001:l015","ordinal":77913,"en":"If you consent to give him,"},{"id":"manas-2010:p1814:b001:l016","ordinal":77914,"en":"My friend, let me tie him to my saddle-straps."},{"id":"manas-2010:p1814:b001:l017","ordinal":77915,"en":"Give him freely, without holding back;"},{"id":"manas-2010:p1814:b001:l018","ordinal":77916,"en":"Let me take my little light as a companion."},{"id":"manas-2010:p1814:b001:l019","ordinal":77917,"en":"Holding the only child in my hand,"},{"id":"manas-2010:p1814:b001:l020","ordinal":77918,"en":"Upon Judgment Day's narrow path,"},{"id":"manas-2010:p1814:b001:l021","ordinal":77919,"en":"Saying, ‘A gift received from my friend,’"},{"id":"manas-2010:p1814:b001:l022","ordinal":77920,"en":"Let me hold him as I go.”"},{"id":"manas-2010:p1814:b001:l023","ordinal":77921,"en":"“My friend, not only my child—take me!"},{"id":"manas-2010:p1814:b001:l024","ordinal":77922,"en":"My friend, pour my blood into a leather flask and take it."},{"id":"manas-2010:p1814:b001:l025","ordinal":77923,"en":"Not merely my child, dear friend:"},{"id":"manas-2010:p1814:b001:l026","ordinal":77924,"en":"If you need it, take my life!”"},{"id":"manas-2010:p1814:b001:l027","ordinal":77925,"en":"Setting forth for the other world,"},{"id":"manas-2010:p1814:b001:l028","ordinal":77926,"en":"There he passed away."},{"id":"manas-2010:p1814:b001:l029","ordinal":77927,"en":"The people wept, the khans wept,"},{"id":"manas-2010:p1814:b001:l030","ordinal":77928,"en":"Koshoi and Toshtuk wept as well,"},{"id":"manas-2010:p1814:b001:l031","ordinal":77929,"en":"Ajybai and old Bakai wept."},{"id":"manas-2010:p1814:b001:l032","ordinal":77930,"en":"Khan Manas's forty companions,"},{"id":"manas-2010:p1814:b001:l033","ordinal":77931,"en":"Planting their spears and shouting,"},{"id":"manas-2010:p1814:b001:l034","ordinal":77932,"en":"Crying, “My Greathearted One!”"},{"id":"manas-2010:p1814:b001:l035","ordinal":77933,"en":"Stood there in a row."},{"id":"manas-2010:p1814:b001:l036","ordinal":77934,"en":"Red willows grew in an enclosing ring;"},{"id":"manas-2010:p1814:b001:l037","ordinal":77935,"en":"Holy masters became his protectors."},{"id":"manas-2010:p1814:b001:l038","ordinal":77936,"en":"Today, there in Ken-Shor,"},{"id":"manas-2010:p1814:b001:l039","ordinal":77937,"en":"That precious woman Kanykei,"},{"id":"manas-2010:p1814:b001:l040","ordinal":77938,"en":"Her precious hair untouched by a comb,"},{"id":"manas-2010:p1814:b001:l041","ordinal":77939,"en":"Seized it by the strands and tore it out."},{"id":"manas-2010:p1814:b001:l042","ordinal":77940,"en":"Then strand upon strand became forests of willows."},{"id":"manas-2010:p1815:b001:l001","ordinal":77941,"en":"To the precious lion, famed throughout the world,"},{"id":"manas-2010:p1815:b001:l002","ordinal":77942,"en":"The Creator himself became a protector."},{"id":"manas-2010:p1815:b001:l003","ordinal":77943,"en":"The dark blood flowing from her face"},{"id":"manas-2010:p1815:b001:l004","ordinal":77944,"en":"Became red stones ankle-deep."},{"id":"manas-2010:p1815:b001:l005","ordinal":77945,"en":"The bloody tears flowing from her eyes"},{"id":"manas-2010:p1815:b001:l006","ordinal":77946,"en":"Became a river of spring-water."},{"id":"manas-2010:p1815:b001:l007","ordinal":77947,"en":"For six days the moon did not rise;"},{"id":"manas-2010:p1815:b001:l008","ordinal":77948,"en":"Oh, alas, the nights were moonless and dark."},{"id":"manas-2010:p1815:b001:l009","ordinal":77949,"en":"Then flat-humped Karanar,"},{"id":"manas-2010:p1815:b001:l010","ordinal":77950,"en":"From the city of Lower Mecca,"},{"id":"manas-2010:p1815:b001:l011","ordinal":77951,"en":"Was a beast the leopard had brought."},{"id":"manas-2010:p1815:b001:l012","ordinal":77952,"en":"No wind could catch its trot,"},{"id":"manas-2010:p1815:b001:l013","ordinal":77953,"en":"No beast could match its walk."},{"id":"manas-2010:p1815:b001:l014","ordinal":77954,"en":"Apart from being called a camel,"},{"id":"manas-2010:p1815:b001:l015","ordinal":77955,"en":"It was a creature of sacred power."},{"id":"manas-2010:p1815:b001:l016","ordinal":77956,"en":"The bulletproof mail,"},{"id":"manas-2010:p1815:b001:l017","ordinal":77957,"en":"Zhelmaian carried folded;"},{"id":"manas-2010:p1815:b001:l018","ordinal":77958,"en":"All the bullets and powder,"},{"id":"manas-2010:p1815:b001:l019","ordinal":77959,"en":"Zhelmaian carried as a load."},{"id":"manas-2010:p1815:b001:l020","ordinal":77960,"en":"Never brushing a birch's crown,"},{"id":"manas-2010:p1815:b001:l021","ordinal":77961,"en":"Flat-humped Karanar"},{"id":"manas-2010:p1815:b001:l022","ordinal":77962,"en":"Never lagged behind on campaign."},{"id":"manas-2010:p1815:b001:l023","ordinal":77963,"en":"Beside the wall where Manas lay,"},{"id":"manas-2010:p1815:b001:l024","ordinal":77964,"en":"Zhelmaian knelt down."},{"id":"manas-2010:p1815:b001:l025","ordinal":77965,"en":"Tears streamed in ten channels;"},{"id":"manas-2010:p1815:b001:l026","ordinal":77966,"en":"Zhelmaian shed them all."},{"id":"manas-2010:p1815:b001:l027","ordinal":77967,"en":"On the nearer side of it,"},{"id":"manas-2010:p1815:b001:l028","ordinal":77968,"en":"From the ridge of Kum-Bulak,"},{"id":"manas-2010:p1815:b001:l029","ordinal":77969,"en":"At the place where he performed ablution,"},{"id":"manas-2010:p1815:b001:l030","ordinal":77970,"en":"He had found Kumaiyk."},{"id":"manas-2010:p1815:b001:l031","ordinal":77971,"en":"Its ravenous mouth toward the sky,"},{"id":"manas-2010:p1815:b001:l032","ordinal":77972,"en":"Kumaiyk opened wide."},{"id":"manas-2010:p1815:b001:l033","ordinal":77973,"en":"Moaning more than a human,"},{"id":"manas-2010:p1815:b001:l034","ordinal":77974,"en":"At Manas's feet"},{"id":"manas-2010:p1815:b001:l035","ordinal":77975,"en":"Kumaiyk lay down."},{"id":"manas-2010:p1815:b001:l036","ordinal":77976,"en":"Not tasting food when offered,"},{"id":"manas-2010:p1815:b001:l037","ordinal":77977,"en":"Though Kumaiyk was a beast,"},{"id":"manas-2010:p1815:b001:l038","ordinal":77978,"en":"Never stilling its wailing voice,"},{"id":"manas-2010:p1815:b001:l039","ordinal":77979,"en":"For many days tasting nothing,"},{"id":"manas-2010:p1815:b001:l040","ordinal":77980,"en":"Kumaiyk wasted away."},{"id":"manas-2010:p1815:b001:l041","ordinal":77981,"en":"Moaning, never leaving the side-wall,"},{"id":"manas-2010:p1815:b001:l042","ordinal":77982,"en":"Kumaiyk howled."},{"id":"manas-2010:p1816:b001:l001","ordinal":77983,"en":"Khan Manas's White Falcon,"},{"id":"manas-2010:p1816:b001:l002","ordinal":77984,"en":"Wheeling and fluttering,"},{"id":"manas-2010:p1816:b001:l003","ordinal":77985,"en":"Flying backward, leaning back,"},{"id":"manas-2010:p1816:b001:l004","ordinal":77986,"en":"All the foul-smelling meat"},{"id":"manas-2010:p1816:b001:l005","ordinal":77987,"en":"The White Falcon scattered."},{"id":"manas-2010:p1816:b001:l006","ordinal":77988,"en":"Vanishing from sight,"},{"id":"manas-2010:p1816:b001:l007","ordinal":77989,"en":"The White Falcon flew away."},{"id":"manas-2010:p1816:b001:l008","ordinal":77990,"en":"Its short golden jesses"},{"id":"manas-2010:p1816:b001:l009","ordinal":77991,"en":"The White Falcon tore apart."},{"id":"manas-2010:p1816:b001:l010","ordinal":77992,"en":"Soaring toward the sky,"},{"id":"manas-2010:p1816:b001:l011","ordinal":77993,"en":"The White Falcon sped away."},{"id":"manas-2010:p1816:b001:l012","ordinal":77994,"en":"Arbuudan, newly come to maturity—"},{"id":"manas-2010:p1816:b001:l013","ordinal":77995,"en":"When sovereign Manas died,"},{"id":"manas-2010:p1816:b001:l014","ordinal":77996,"en":"Tied up, it would not stay still;"},{"id":"manas-2010:p1816:b001:l015","ordinal":77997,"en":"Turned loose, it would not graze."},{"id":"manas-2010:p1816:b001:l016","ordinal":77998,"en":"Though the creature was a beast,"},{"id":"manas-2010:p1816:b001:l017","ordinal":77999,"en":"It had taken up mourning."},{"id":"manas-2010:p1816:b001:l018","ordinal":78000,"en":"Then precious Kanykei,"},{"id":"manas-2010:p1816:b001:l019","ordinal":78001,"en":"Her bloody face torn,"},{"id":"manas-2010:p1816:b001:l020","ordinal":78002,"en":"Her black hair loose,"},{"id":"manas-2010:p1816:b001:l021","ordinal":78003,"en":"Upon her looming dark head,"},{"id":"manas-2010:p1816:b001:l022","ordinal":78004,"en":"Bereft of her Blood-Shedder"},{"id":"manas-2010:p1816:b001:l023","ordinal":78005,"en":"At thirty-two years old:"},{"id":"manas-2010:p1816:b001:l024","ordinal":78006,"en":"“Six san of horses on the hills,"},{"id":"manas-2010:p1816:b001:l025","ordinal":78007,"en":"Thoroughbreds and swift steeds mingled."},{"id":"manas-2010:p1816:b001:l026","ordinal":78008,"en":"To know how to govern his own people,"},{"id":"manas-2010:p1816:b001:l027","ordinal":78009,"en":"Your son left behind is still too young."},{"id":"manas-2010:p1816:b001:l028","ordinal":78010,"en":"Your horses in the mountains have piebald heads,"},{"id":"manas-2010:p1816:b001:l029","ordinal":78011,"en":"Toburchak steeds and swift horses mingled;"},{"id":"manas-2010:p1816:b001:l030","ordinal":78012,"en":"The child who would gather them is young."},{"id":"manas-2010:p1816:b001:l031","ordinal":78013,"en":"Without casting my soul into hell,"},{"id":"manas-2010:p1816:b001:l032","ordinal":78014,"en":"My mountain, blue-maned one, take me along!"},{"id":"manas-2010:p1816:b001:l033","ordinal":78015,"en":"My dresses of every kind—"},{"id":"manas-2010:p1816:b001:l034","ordinal":78016,"en":"When I pull them up, they do not reach my neck."},{"id":"manas-2010:p1816:b001:l035","ordinal":78017,"en":"Without exhausting me, my sultan,"},{"id":"manas-2010:p1816:b001:l036","ordinal":78018,"en":"Draw me into your embrace and take me!"},{"id":"manas-2010:p1816:b001:l037","ordinal":78019,"en":"We joined when small as thumbs;"},{"id":"manas-2010:p1816:b001:l038","ordinal":78020,"en":"My sultan, we united when tiny as lice."},{"id":"manas-2010:p1816:b001:l039","ordinal":78021,"en":"You are the one gone to the other world;"},{"id":"manas-2010:p1816:b001:l040","ordinal":78022,"en":"I am the one left to suffer."},{"id":"manas-2010:p1816:b001:l041","ordinal":78023,"en":"That black-cheeked battle-axe of yours—"},{"id":"manas-2010:p1816:b001:l042","ordinal":78024,"en":"Who will fit its haft without making it crooked?"},{"id":"manas-2010:p1817:b001:l001","ordinal":78025,"en":"Never satisfied with what they demand and consume,"},{"id":"manas-2010:p1817:b001:l002","ordinal":78026,"en":"Never abandoning their greed,"},{"id":"manas-2010:p1817:b001:l003","ordinal":78027,"en":"Your Argyn and Kyrgyz people—"},{"id":"manas-2010:p1817:b001:l004","ordinal":78028,"en":"Who will lead them without turmoil?"},{"id":"manas-2010:p1817:b001:l005","ordinal":78029,"en":"The peerless winged steed has a piebald head;"},{"id":"manas-2010:p1817:b001:l006","ordinal":78030,"en":"All your brothers are enemies."},{"id":"manas-2010:p1817:b001:l007","ordinal":78031,"en":"Without making me bear this torment,"},{"id":"manas-2010:p1817:b001:l008","ordinal":78032,"en":"My greathearted sultan, take me along!"},{"id":"manas-2010:p1817:b001:l009","ordinal":78033,"en":"Leopard, journeying to the other world,"},{"id":"manas-2010:p1817:b001:l010","ordinal":78034,"en":"You have torn my thoughts apart."},{"id":"manas-2010:p1817:b001:l011","ordinal":78035,"en":"To whom have you entrusted"},{"id":"manas-2010:p1817:b001:l012","ordinal":78036,"en":"Your six-month-old son left behind?”"},{"id":"manas-2010:p1817:b001:l013","ordinal":78037,"en":"As she stood weeping thus,"},{"id":"manas-2010:p1817:b001:l014","ordinal":78038,"en":"When your precious lord had died,"},{"id":"manas-2010:p1817:b001:l015","ordinal":78039,"en":"When your great people faced disaster,"},{"id":"manas-2010:p1817:b001:l016","ordinal":78040,"en":"Abyke and Kobosh among them,"},{"id":"manas-2010:p1817:b001:l017","ordinal":78041,"en":"The six scoundrels descended from the hills."},{"id":"manas-2010:p1817:b001:l018","ordinal":78042,"en":"It was mostly amusement, not mourning."},{"id":"manas-2010:p1817:b001:l019","ordinal":78043,"en":"“Ah, the dear departed!” people cried"},{"id":"manas-2010:p1817:b001:l020","ordinal":78044,"en":"Here and there."},{"id":"manas-2010:p1817:b001:l021","ordinal":78045,"en":"The six scoundrels came making noise,"},{"id":"manas-2010:p1817:b001:l022","ordinal":78046,"en":"Their reach extending through the world."},{"id":"manas-2010:p1817:b001:l023","ordinal":78047,"en":"Sharing a father with Manas,"},{"id":"manas-2010:p1817:b001:l024","ordinal":78048,"en":"The six scoundrels were the younger wife's sons."},{"id":"manas-2010:p1817:b001:l025","ordinal":78049,"en":"Abyke and Kobosh, two scoundrels,"},{"id":"manas-2010:p1817:b001:l026","ordinal":78050,"en":"Chiybyt and Kochkor, making four,"},{"id":"manas-2010:p1817:b001:l027","ordinal":78051,"en":"Ajybai and Kolbai, making six."},{"id":"manas-2010:p1817:b001:l028","ordinal":78052,"en":"Moaning here and there,"},{"id":"manas-2010:p1817:b001:l029","ordinal":78053,"en":"“Ah, the dear departed!”"},{"id":"manas-2010:p1817:b001:l030","ordinal":78054,"en":"The six scoundrels let out booming wails."},{"id":"manas-2010:p1817:b001:l031","ordinal":78055,"en":"Seeing these scoundrels,"},{"id":"manas-2010:p1817:b001:l032","ordinal":78056,"en":"Your precious sister-in-law Kanykei thought:"},{"id":"manas-2010:p1817:b001:l033","ordinal":78057,"en":"“These six crooked scoundrels"},{"id":"manas-2010:p1817:b001:l034","ordinal":78058,"en":"Will descend upon my head and crush me."},{"id":"manas-2010:p1817:b001:l035","ordinal":78059,"en":"Without letting my lord's body be buried,"},{"id":"manas-2010:p1817:b001:l036","ordinal":78060,"en":"They will plunder my goods."},{"id":"manas-2010:p1817:b001:l037","ordinal":78061,"en":"The six scoundrels will wreak havoc now.”"},{"id":"manas-2010:p1817:b001:l038","ordinal":78062,"en":"Unable to find a way,"},{"id":"manas-2010:p1817:b001:l039","ordinal":78063,"en":"Your noble sister-in-law Kanykei,"},{"id":"manas-2010:p1817:b001:l040","ordinal":78064,"en":"Dark blood streaming from her face,"},{"id":"manas-2010:p1817:b001:l041","ordinal":78065,"en":"With little cradle-child Semetey"},{"id":"manas-2010:p1817:b001:l042","ordinal":78066,"en":"Pressed beneath her arm for safekeeping,"},{"id":"manas-2010:p1818:b001:l001","ordinal":78067,"en":"Came out before the six scoundrels."},{"id":"manas-2010:p1818:b001:l002","ordinal":78068,"en":"Abyke was a man born kindhearted;"},{"id":"manas-2010:p1818:b001:l003","ordinal":78069,"en":"Kobosh was deeply malicious."},{"id":"manas-2010:p1818:b001:l004","ordinal":78070,"en":"Your precious sister-in-law Kanykei"},{"id":"manas-2010:p1818:b001:l005","ordinal":78071,"en":"Bustled about them,"},{"id":"manas-2010:p1818:b001:l006","ordinal":78072,"en":"Calling, “Sons!”"},{"id":"manas-2010:p1818:b001:l007","ordinal":78073,"en":"Pleading with the six scoundrels."},{"id":"manas-2010:p1818:b001:l008","ordinal":78074,"en":"“The support you relied upon"},{"id":"manas-2010:p1818:b001:l009","ordinal":78075,"en":"Is gone, my son."},{"id":"manas-2010:p1818:b001:l010","ordinal":78076,"en":"Your mighty lion on the heights is gone, my son."},{"id":"manas-2010:p1818:b001:l011","ordinal":78077,"en":"‘When renowned Manas died,"},{"id":"manas-2010:p1818:b001:l012","ordinal":78078,"en":"Those left settled along the heights."},{"id":"manas-2010:p1818:b001:l013","ordinal":78079,"en":"When the khan died, all died;"},{"id":"manas-2010:p1818:b001:l014","ordinal":78080,"en":"They became like an extinguished fire,’ they will say."}]
