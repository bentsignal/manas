[{"id":"semetey-1-2013:p0707:b005:l016","ordinal":131073,"en":"He was a deeply ignorant dog;"},{"id":"semetey-1-2013:p0707:b005:l017","ordinal":131074,"en":"What man was he, if not a dog?"},{"id":"semetey-1-2013:p0707:b005:l018","ordinal":131075,"en":"Because of that swine,"},{"id":"semetey-1-2013:p0707:b005:l019","ordinal":131076,"en":"We lived lost and wandering;"},{"id":"semetey-1-2013:p0707:b005:l020","ordinal":131077,"en":"We saw pitch-dark nights;"},{"id":"semetey-1-2013:p0707:b005:l021","ordinal":131078,"en":"We saw devastation."},{"id":"semetey-1-2013:p0707:b005:l022","ordinal":131079,"en":"When dog Kobosh inflicted humiliation,"},{"id":"semetey-1-2013:p0707:b005:l023","ordinal":131080,"en":"When he plundered the palace,"},{"id":"semetey-1-2013:p0707:b005:l024","ordinal":131081,"en":"Into Temirkan's city"},{"id":"semetey-1-2013:p0707:b005:l025","ordinal":131082,"en":"We wandered and made a life."},{"id":"semetey-1-2013:p0707:b005:l026","ordinal":131083,"en":"Fearing someone with a grudge would slaughter you,"},{"id":"semetey-1-2013:p0707:b005:l027","ordinal":131084,"en":"Would kill you for nothing,"},{"id":"semetey-1-2013:p0707:b005:l028","ordinal":131085,"en":"Your twig was cut,"},{"id":"semetey-1-2013:p0707:b005:l029","ordinal":131086,"en":"Your ritual was performed."},{"id":"semetey-1-2013:p0707:b005:l030","ordinal":131087,"en":"You were passed through a dog's bowl,"},{"id":"semetey-1-2013:p0707:b005:l031","ordinal":131088,"en":"Made to step over a sword's edge;"},{"id":"semetey-1-2013:p0707:b005:l032","ordinal":131089,"en":"An amulet was hung about your neck."},{"id":"semetey-1-2013:p0707:b005:l033","ordinal":131090,"en":"Because of accursed Kobosh,"},{"id":"semetey-1-2013:p0707:b005:l034","ordinal":131091,"en":"In Temirkan's city"},{"id":"semetey-1-2013:p0707:b005:l035","ordinal":131092,"en":"You wandered away and were raised."},{"id":"semetey-1-2013:p0707:b005:l036","ordinal":131093,"en":"Let me circle round you in devotion;"},{"id":"semetey-1-2013:p0707:b005:l037","ordinal":131094,"en":"I have much to tell."},{"id":"semetey-1-2013:p0707:b005:l038","ordinal":131095,"en":"In swine Kobosh's hands"},{"id":"semetey-1-2013:p0707:b005:l039","ordinal":131096,"en":"Are the forty warriors left by your father."},{"id":"semetey-1-2013:p0708:b003:l001","ordinal":131097,"en":"The forty were dogs from forty different places;"},{"id":"semetey-1-2013:p0708:b003:l002","ordinal":131098,"en":"What men were they, if not dogs?"},{"id":"semetey-1-2013:p0708:b003:l003","ordinal":131099,"en":"One warrior came without a horse."},{"id":"semetey-1-2013:p0708:b003:l004","ordinal":131100,"en":"To the warrior who came horseless,"},{"id":"semetey-1-2013:p0708:b003:l005","ordinal":131101,"en":"Argali-legged, bronze-wristed,"},{"id":"semetey-1-2013:p0708:b003:l006","ordinal":131102,"en":"He gave a winged steed to ride."},{"id":"semetey-1-2013:p0708:b003:l007","ordinal":131103,"en":"One warrior came without a coat."},{"id":"semetey-1-2013:p0708:b003:l008","ordinal":131104,"en":"To the warrior who came coatless,"},{"id":"semetey-1-2013:p0708:b003:l009","ordinal":131105,"en":"Golden-collared, brazen-sleeved,"},{"id":"semetey-1-2013:p0708:b003:l010","ordinal":131106,"en":"Double-mailed, bulletproof,"},{"id":"semetey-1-2013:p0708:b003:l011","ordinal":131107,"en":"Your father gave a coat to wear."},{"id":"semetey-1-2013:p0708:b003:l012","ordinal":131108,"en":"One warrior came without livestock."},{"id":"semetey-1-2013:p0708:b003:l013","ordinal":131109,"en":"To the warrior who came stockless,"},{"id":"semetey-1-2013:p0708:b003:l014","ordinal":131110,"en":"Six vast herds of horses on the hills,"},{"id":"semetey-1-2013:p0708:b003:l015","ordinal":131111,"en":"Thoroughbreds and swift steeds mixed,"},{"id":"semetey-1-2013:p0708:b003:l016","ordinal":131112,"en":"Mighty Manas gave as his share."},{"id":"semetey-1-2013:p0708:b003:l017","ordinal":131113,"en":"One warrior came without a wife."},{"id":"semetey-1-2013:p0708:b003:l018","ordinal":131114,"en":"For the warrior who came wifeless,"},{"id":"semetey-1-2013:p0708:b003:l019","ordinal":131115,"en":"In crimson dresses, slender-waisted,"},{"id":"semetey-1-2013:p0708:b003:l020","ordinal":131116,"en":"With thimble-small mouths and camel-calf eyes,"},{"id":"semetey-1-2013:p0708:b003:l021","ordinal":131117,"en":"With dark eyes glancing coyly,"},{"id":"semetey-1-2013:p0708:b003:l022","ordinal":131118,"en":"Waists like scabbards, faces like the moon,"},{"id":"semetey-1-2013:p0708:b003:l023","ordinal":131119,"en":"From renowned beautiful girls,"},{"id":"semetey-1-2013:p0708:b003:l024","ordinal":131120,"en":"Heroic Manas obtained a bride."},{"id":"semetey-1-2013:p0708:b003:l025","ordinal":131121,"en":"When your father died,"},{"id":"semetey-1-2013:p0708:b003:l026","ordinal":131122,"en":"Those beasts turned to plotting."},{"id":"semetey-1-2013:p0708:b003:l027","ordinal":131123,"en":"Without looking back at your father Manas,"},{"id":"semetey-1-2013:p0708:b003:l028","ordinal":131124,"en":"The forty warriors went out to the wilds."},{"id":"semetey-1-2013:p0708:b003:l029","ordinal":131125,"en":"Now those forty warriors"},{"id":"semetey-1-2013:p0708:b003:l030","ordinal":131126,"en":"Settled Urbus and made it their territory;"},{"id":"semetey-1-2013:p0708:b003:l031","ordinal":131127,"en":"They made the six villains their lords."},{"id":"semetey-1-2013:p0708:b003:l032","ordinal":131128,"en":"The strongest of the forty warriors now,"},{"id":"semetey-1-2013:p0708:b003:l033","ordinal":131129,"en":"Kyrgylchal at their head, and Tazbaimat—"},{"id":"semetey-1-2013:p0708:b003:l034","ordinal":131130,"en":"The leader of the forty, Kyrgylchal,"},{"id":"semetey-1-2013:p0708:b003:l035","ordinal":131131,"en":"That mad old man, swollen with pride among the forty,"},{"id":"semetey-1-2013:p0708:b003:l036","ordinal":131132,"en":"Always thought up wicked words."},{"id":"semetey-1-2013:p0708:b003:l037","ordinal":131133,"en":"Even if he ruined everything,"},{"id":"semetey-1-2013:p0708:b004:l001","ordinal":131134,"en":"Your swift-steed, leopard father"},{"id":"semetey-1-2013:p0708:b004:l002","ordinal":131135,"en":"Never said, ‘He has ruined it.’"},{"id":"semetey-1-2013:p0708:b004:l003","ordinal":131136,"en":"Turning away, the forty warriors,"},{"id":"semetey-1-2013:p0708:b004:l004","ordinal":131137,"en":"Most forgetting Talas,"},{"id":"semetey-1-2013:p0708:b004:l005","ordinal":131138,"en":"Abandoned—do you see?—"},{"id":"semetey-1-2013:p0708:b004:l006","ordinal":131139,"en":"Your father, Sultan Manas."},{"id":"semetey-1-2013:p0708:b004:l007","ordinal":131140,"en":"Damn them, the forty warriors!"},{"id":"semetey-1-2013:p0708:b004:l008","ordinal":131141,"en":"The forty were dogs from forty different places;"},{"id":"semetey-1-2013:p0708:b004:l009","ordinal":131142,"en":"What men were they, if not dogs?"},{"id":"semetey-1-2013:p0708:b004:l010","ordinal":131143,"en":"While your father Manas lived,"},{"id":"semetey-1-2013:p0708:b004:l011","ordinal":131144,"en":"They cried, ‘Baabedin!’"},{"id":"semetey-1-2013:p0708:b004:l012","ordinal":131145,"en":"They raised the war cry, ‘Manas!’"},{"id":"semetey-1-2013:p0708:b004:l013","ordinal":131146,"en":"Now those forty warriors"},{"id":"semetey-1-2013:p0708:b004:l014","ordinal":131147,"en":"Bend down the willow tops;"},{"id":"semetey-1-2013:p0708:b004:l015","ordinal":131148,"en":"They raise the war cry, ‘Kobosh!’"},{"id":"semetey-1-2013:p0708:b004:l016","ordinal":131149,"en":"If they get the chance, they will clash with us."},{"id":"semetey-1-2013:p0708:b004:l017","ordinal":131150,"en":"The forty warriors cursed by Khidr—"},{"id":"semetey-1-2013:p0708:b004:l018","ordinal":131151,"en":"When will they ever honor us?"},{"id":"semetey-1-2013:p0708:b004:l019","ordinal":131152,"en":"Pouring out his account,"},{"id":"semetey-1-2013:p0708:b004:l020","ordinal":131153,"en":"Your khan uncle Bakai had these words."},{"id":"semetey-1-2013:p0708:b004:l021","ordinal":131154,"en":"Keep watch over this:"},{"id":"semetey-1-2013:p0708:b004:l022","ordinal":131155,"en":"Those forty swine bear a grudge against you;"},{"id":"semetey-1-2013:p0708:b004:l023","ordinal":131156,"en":"Their intentions are wicked."},{"id":"semetey-1-2013:p0708:b004:l024","ordinal":131157,"en":"My beloved orphan,"},{"id":"semetey-1-2013:p0708:b004:l025","ordinal":131158,"en":"Let us scout thoroughly;"},{"id":"semetey-1-2013:p0708:b004:l026","ordinal":131159,"en":"Let us gather sound news.”"},{"id":"semetey-1-2013:p0708:b004:l027","ordinal":131160,"en":"So said Khan Bakai,"},{"id":"semetey-1-2013:p0708:b004:l028","ordinal":131161,"en":"Your resourceful uncle Khan Bakai."},{"id":"semetey-1-2013:p0708:b004:l029","ordinal":131162,"en":"To the spur where the mountain ends,"},{"id":"semetey-1-2013:p0708:b004:l030","ordinal":131163,"en":"To the looming promontory,"},{"id":"semetey-1-2013:p0708:b004:l031","ordinal":131164,"en":"Wearing out his horse, surveying the land,"},{"id":"semetey-1-2013:p0708:b004:l032","ordinal":131165,"en":"Watching shapes, scouting the road,"},{"id":"semetey-1-2013:p0708:b004:l033","ordinal":131166,"en":"The Kokcholok beneath him"},{"id":"semetey-1-2013:p0708:b004:l034","ordinal":131167,"en":"He spurred on either side."},{"id":"semetey-1-2013:p0708:b004:l035","ordinal":131168,"en":"Searching tracks this way and that,"},{"id":"semetey-1-2013:p0708:b004:l036","ordinal":131169,"en":"Valiant Bakai the Leopard"},{"id":"semetey-1-2013:p0708:b004:l037","ordinal":131170,"en":"Reached the ridge at last."},{"id":"semetey-1-2013:p0709:b004:l001","ordinal":131171,"en":"Before much time had passed,"},{"id":"semetey-1-2013:p0709:b004:l002","ordinal":131172,"en":"Before this or that could be said,"},{"id":"semetey-1-2013:p0709:b004:l003","ordinal":131173,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p0709:b004:l004","ordinal":131174,"en":"Massive as half a mountain,"},{"id":"semetey-1-2013:p0709:b004:l005","ordinal":131175,"en":"As though to devour whoever was met,"},{"id":"semetey-1-2013:p0709:b004:l006","ordinal":131176,"en":"With a high brow and a stern face,"},{"id":"semetey-1-2013:p0709:b004:l007","ordinal":131177,"en":"Broad-chested, with an ample breast,"},{"id":"semetey-1-2013:p0709:b004:l008","ordinal":131178,"en":"A majestic person appeared,"},{"id":"semetey-1-2013:p0709:b004:l009","ordinal":131179,"en":"Riding a dark chestnut horse,"},{"id":"semetey-1-2013:p0709:b004:l010","ordinal":131180,"en":"Its long tail tightly knotted,"},{"id":"semetey-1-2013:p0709:b004:l011","ordinal":131181,"en":"Looking like a night-devouring monster,"},{"id":"semetey-1-2013:p0709:b004:l012","ordinal":131182,"en":"With eyes like twilight mist,"},{"id":"semetey-1-2013:p0709:b004:l013","ordinal":131183,"en":"A banner floating,"},{"id":"semetey-1-2013:p0709:b004:l014","ordinal":131184,"en":"A helmet of blue iron"},{"id":"semetey-1-2013:p0709:b004:l015","ordinal":131185,"en":"Gleaming upon the head,"},{"id":"semetey-1-2013:p0709:b004:l016","ordinal":131186,"en":"A sight that troubled the heart."},{"id":"semetey-1-2013:p0709:b004:l017","ordinal":131187,"en":"A bulletproof steel shield"},{"id":"semetey-1-2013:p0709:b004:l018","ordinal":131188,"en":"Showed upon the broad shoulder blades."},{"id":"semetey-1-2013:p0709:b004:l019","ordinal":131189,"en":"A golden-cheeked battle-axe"},{"id":"semetey-1-2013:p0709:b004:l020","ordinal":131190,"en":"Was firmly looped upon the wrist."},{"id":"semetey-1-2013:p0709:b004:l021","ordinal":131191,"en":"A hungry blade never sated with blood,"},{"id":"semetey-1-2013:p0709:b004:l022","ordinal":131192,"en":"A steel sword, was girded on."},{"id":"semetey-1-2013:p0709:b004:l023","ordinal":131193,"en":"There was a form unlike other men,"},{"id":"semetey-1-2013:p0709:b004:l024","ordinal":131194,"en":"A dread presence like a dragon."},{"id":"semetey-1-2013:p0709:b004:l025","ordinal":131195,"en":"There was a dark chestnut winged steed,"},{"id":"semetey-1-2013:p0709:b004:l026","ordinal":131196,"en":"The four corners of the round world—"},{"id":"semetey-1-2013:p0709:b004:l027","ordinal":131197,"en":"There was strength to suck them away."},{"id":"semetey-1-2013:p0709:b004:l028","ordinal":131198,"en":"This powerfully built person"},{"id":"semetey-1-2013:p0709:b004:l029","ordinal":131199,"en":"Came right up beside them."},{"id":"semetey-1-2013:p0709:b004:l030","ordinal":131200,"en":"The wondrous hero born of Manas,"},{"id":"semetey-1-2013:p0709:b004:l031","ordinal":131201,"en":"To the person who had just arrived,"},{"id":"semetey-1-2013:p0709:b004:l032","ordinal":131202,"en":"Spoke these words:"},{"id":"semetey-1-2013:p0709:b004:l033","ordinal":131203,"en":"“Grim in form, strange of face,"},{"id":"semetey-1-2013:p0709:b004:l034","ordinal":131204,"en":"From where have you come, warrior?!"},{"id":"semetey-1-2013:p0709:b004:l035","ordinal":131205,"en":"Your horse's neck swings proudly;"},{"id":"semetey-1-2013:p0709:b004:l036","ordinal":131206,"en":"You ride a beast unlike the rest."},{"id":"semetey-1-2013:p0709:b005:l001","ordinal":131207,"en":"Your spear's butt is an armful;"},{"id":"semetey-1-2013:p0709:b005:l002","ordinal":131208,"en":"You carry wood unlike the rest."},{"id":"semetey-1-2013:p0709:b005:l003","ordinal":131209,"en":"Wearing out horses, scouting the land,"},{"id":"semetey-1-2013:p0709:b005:l004","ordinal":131210,"en":"Unleashing hounds and flying hawks,"},{"id":"semetey-1-2013:p0709:b005:l005","ordinal":131211,"en":"Circling Orolmo-Too,"},{"id":"semetey-1-2013:p0709:b005:l006","ordinal":131212,"en":"Girded with weapons of war,"},{"id":"semetey-1-2013:p0709:b005:l007","ordinal":131213,"en":"You are one of the raiders."},{"id":"semetey-1-2013:p0709:b005:l008","ordinal":131214,"en":"Your deeds show plainly;"},{"id":"semetey-1-2013:p0709:b005:l009","ordinal":131215,"en":"May your road prosper—tell the truth,"},{"id":"semetey-1-2013:p0709:b005:l010","ordinal":131216,"en":"Or your blood will be shed now."},{"id":"semetey-1-2013:p0709:b005:l011","ordinal":131217,"en":"If you wish to trade shots,"},{"id":"semetey-1-2013:p0709:b005:l012","ordinal":131218,"en":"Make your musket ready;"},{"id":"semetey-1-2013:p0709:b005:l013","ordinal":131219,"en":"If you wish to fight,"},{"id":"semetey-1-2013:p0709:b005:l014","ordinal":131220,"en":"Make your axe and sword ready;"},{"id":"semetey-1-2013:p0709:b005:l015","ordinal":131221,"en":"If you wish to joust,"},{"id":"semetey-1-2013:p0709:b005:l016","ordinal":131222,"en":"Make your spear ready here."},{"id":"semetey-1-2013:p0709:b005:l017","ordinal":131223,"en":"Today certain death will enter your thoughts;"},{"id":"semetey-1-2013:p0709:b005:l018","ordinal":131224,"en":"Guard yourself very carefully."},{"id":"semetey-1-2013:p0709:b005:l019","ordinal":131225,"en":"If you are a raider,"},{"id":"semetey-1-2013:p0709:b005:l020","ordinal":131226,"en":"And I am the boy you have met,"},{"id":"semetey-1-2013:p0709:b005:l021","ordinal":131227,"en":"I shall gouge out your eyes;"},{"id":"semetey-1-2013:p0709:b005:l022","ordinal":131228,"en":"I am enraged—I shall slaughter you."},{"id":"semetey-1-2013:p0709:b005:l023","ordinal":131229,"en":"Fire has kindled and your eyes blaze;"},{"id":"semetey-1-2013:p0709:b005:l024","ordinal":131230,"en":"I will not spare your life otherwise."},{"id":"semetey-1-2013:p0709:b005:l025","ordinal":131231,"en":"My thirst for blood has seized me today."},{"id":"semetey-1-2013:p0709:b005:l026","ordinal":131232,"en":"If you ask about me,"},{"id":"semetey-1-2013:p0709:b005:l027","ordinal":131233,"en":"Having roamed all the world,"},{"id":"semetey-1-2013:p0709:b005:l028","ordinal":131234,"en":"Finding no hero like you to joust with,"},{"id":"semetey-1-2013:p0709:b005:l029","ordinal":131235,"en":"Finding no ground on which to measure strength,"},{"id":"semetey-1-2013:p0709:b005:l030","ordinal":131236,"en":"To fight and satisfy my longing,"},{"id":"semetey-1-2013:p0709:b005:l031","ordinal":131237,"en":"Finding no soul like you,"},{"id":"semetey-1-2013:p0709:b005:l032","ordinal":131238,"en":"Finding no mountain to dash against,"},{"id":"semetey-1-2013:p0709:b005:l033","ordinal":131239,"en":"Finding no enemy to battle,"},{"id":"semetey-1-2013:p0709:b005:l034","ordinal":131240,"en":"I have stood here in distress.”"},{"id":"semetey-1-2013:p0709:b005:l035","ordinal":131241,"en":"Saying this, Semetey,"},{"id":"semetey-1-2013:p0709:b005:l036","ordinal":131242,"en":"Unceasing in his fury,"},{"id":"semetey-1-2013:p0710:b003:l001","ordinal":131243,"en":"His black-cheeked white whip"},{"id":"semetey-1-2013:p0710:b003:l002","ordinal":131244,"en":"Seized and swung round,"},{"id":"semetey-1-2013:p0710:b003:l003","ordinal":131245,"en":"And the renowned swift Aktulpar"},{"id":"semetey-1-2013:p0710:b003:l004","ordinal":131246,"en":"He struck across the belly."},{"id":"semetey-1-2013:p0710:b003:l005","ordinal":131247,"en":"His painted spear with a steel edge"},{"id":"semetey-1-2013:p0710:b003:l006","ordinal":131248,"en":"He seized and swung relentlessly."},{"id":"semetey-1-2013:p0710:b003:l007","ordinal":131249,"en":"He turned Aktulpar's head,"},{"id":"semetey-1-2013:p0710:b003:l008","ordinal":131250,"en":"And toward the bulky giant"},{"id":"semetey-1-2013:p0710:b003:l009","ordinal":131251,"en":"Thundering, he leveled his spear."},{"id":"semetey-1-2013:p0710:b003:l010","ordinal":131252,"en":"Semetey charged."},{"id":"semetey-1-2013:p0710:b003:l011","ordinal":131253,"en":"When Semetey came near,"},{"id":"semetey-1-2013:p0710:b003:l012","ordinal":131254,"en":"Humming, utterly unconcerned,"},{"id":"semetey-1-2013:p0710:b003:l013","ordinal":131255,"en":"The boy's leveled spear"},{"id":"semetey-1-2013:p0710:b003:l014","ordinal":131256,"en":"The rider valued less than a trouser cuff."},{"id":"semetey-1-2013:p0710:b003:l015","ordinal":131257,"en":"The dark chestnut winged steed's"},{"id":"semetey-1-2013:p0710:b003:l016","ordinal":131258,"en":"Head the rider pulled round,"},{"id":"semetey-1-2013:p0710:b003:l017","ordinal":131259,"en":"And held firm without tiring."},{"id":"semetey-1-2013:p0710:b003:l018","ordinal":131260,"en":"“This boy has spirit;"},{"id":"semetey-1-2013:p0710:b003:l019","ordinal":131261,"en":"Let him strike firmly with his spear,"},{"id":"semetey-1-2013:p0710:b003:l020","ordinal":131262,"en":"Let him have no regrets,” thinking thus,"},{"id":"semetey-1-2013:p0710:b003:l021","ordinal":131263,"en":"The rider turned Kartkurong's head."},{"id":"semetey-1-2013:p0710:b003:l022","ordinal":131264,"en":"Semetey arrived at speed,"},{"id":"semetey-1-2013:p0710:b003:l023","ordinal":131265,"en":"Gripped his spear and struck hard."},{"id":"semetey-1-2013:p0710:b003:l024","ordinal":131266,"en":"At the spear the boy thrust,"},{"id":"semetey-1-2013:p0710:b003:l025","ordinal":131267,"en":"The rider stared, unruffled."},{"id":"semetey-1-2013:p0710:b003:l026","ordinal":131268,"en":"“This side of the belt,” he aimed,"},{"id":"semetey-1-2013:p0710:b003:l027","ordinal":131269,"en":"“Below the edge of the lungs,” he aimed."},{"id":"semetey-1-2013:p0710:b003:l028","ordinal":131270,"en":"When the boy charged and struck,"},{"id":"semetey-1-2013:p0710:b003:l029","ordinal":131271,"en":"The steel spear in his hand"},{"id":"semetey-1-2013:p0710:b003:l030","ordinal":131272,"en":"Burst and shattered."},{"id":"semetey-1-2013:p0710:b003:l031","ordinal":131273,"en":"He doubled at knees and waist;"},{"id":"semetey-1-2013:p0710:b003:l032","ordinal":131274,"en":"His precious life was sorely strained."},{"id":"semetey-1-2013:p0710:b003:l033","ordinal":131275,"en":"When your Seme sprang and thrust,"},{"id":"semetey-1-2013:p0710:b003:l034","ordinal":131276,"en":"The rider did not recoil at all."},{"id":"semetey-1-2013:p0710:b003:l035","ordinal":131277,"en":"Before Semetey could pull back,"},{"id":"semetey-1-2013:p0710:b003:l036","ordinal":131278,"en":"The golden-cheeked battle-axe"},{"id":"semetey-1-2013:p0710:b003:l037","ordinal":131279,"en":"The rider seized and struck four times."},{"id":"semetey-1-2013:p0710:b003:l038","ordinal":131280,"en":"After that,"},{"id":"semetey-1-2013:p0710:b003:l039","ordinal":131281,"en":"Drawing hungry steel from the side,"},{"id":"semetey-1-2013:p0710:b004:l001","ordinal":131282,"en":"The rider struck three times with it."},{"id":"semetey-1-2013:p0710:b004:l002","ordinal":131283,"en":"A ready spear was in the rider's hand;"},{"id":"semetey-1-2013:p0710:b004:l003","ordinal":131284,"en":"The rider's skill was greater."},{"id":"semetey-1-2013:p0710:b004:l004","ordinal":131285,"en":"The rider reached your orphan,"},{"id":"semetey-1-2013:p0710:b004:l005","ordinal":131286,"en":"Reached him and struck him passing."},{"id":"semetey-1-2013:p0710:b004:l006","ordinal":131287,"en":"The orphan who fancied himself a champion"},{"id":"semetey-1-2013:p0710:b004:l007","ordinal":131288,"en":"Bent double at the waist;"},{"id":"semetey-1-2013:p0710:b004:l008","ordinal":131289,"en":"His eyes bulged."},{"id":"semetey-1-2013:p0710:b004:l009","ordinal":131290,"en":"His backside left the saddle;"},{"id":"semetey-1-2013:p0710:b004:l010","ordinal":131291,"en":"His feet left the stirrups."},{"id":"semetey-1-2013:p0710:b004:l011","ordinal":131292,"en":"The tightly knotted white reins,"},{"id":"semetey-1-2013:p0710:b004:l012","ordinal":131293,"en":"Reins just right for Aktulpar,"},{"id":"semetey-1-2013:p0710:b004:l013","ordinal":131294,"en":"The reckless, unruly orphan child"},{"id":"semetey-1-2013:p0710:b004:l014","ordinal":131295,"en":"Managed to grasp properly."},{"id":"semetey-1-2013:p0710:b004:l015","ordinal":131296,"en":"The Aktulpar beneath him"},{"id":"semetey-1-2013:p0710:b004:l016","ordinal":131297,"en":"He whipped on right and left,"},{"id":"semetey-1-2013:p0710:b004:l017","ordinal":131298,"en":"And put the whip beneath his right thigh."},{"id":"semetey-1-2013:p0710:b004:l018","ordinal":131299,"en":"Your dear child, son of the mighty one,"},{"id":"semetey-1-2013:p0710:b004:l019","ordinal":131300,"en":"Fell into tremendous panic."},{"id":"semetey-1-2013:p0710:b004:l020","ordinal":131301,"en":"“I attacked an enemy not to be attacked;"},{"id":"semetey-1-2013:p0710:b004:l021","ordinal":131302,"en":"I have fallen into misfortune."},{"id":"semetey-1-2013:p0710:b004:l022","ordinal":131303,"en":"I challenged an enemy not to be touched;"},{"id":"semetey-1-2013:p0710:b004:l023","ordinal":131304,"en":"My insolent tongue has undone me."},{"id":"semetey-1-2013:p0710:b004:l024","ordinal":131305,"en":"To see the humiliation of this world,"},{"id":"semetey-1-2013:p0710:b004:l025","ordinal":131306,"en":"It seems I challenged this foe."},{"id":"semetey-1-2013:p0710:b004:l026","ordinal":131307,"en":"Before my appointed death, before my days were done,"},{"id":"semetey-1-2013:p0710:b004:l027","ordinal":131308,"en":"It seems I challenged this foe to die."},{"id":"semetey-1-2013:p0710:b004:l028","ordinal":131309,"en":"This was a khan of sacred power!”"},{"id":"semetey-1-2013:p0710:b004:l029","ordinal":131310,"en":"Saying this then,"},{"id":"semetey-1-2013:p0710:b004:l030","ordinal":131311,"en":"The noble boy Semetey"},{"id":"semetey-1-2013:p0710:b004:l031","ordinal":131312,"en":"Darted off in haste;"},{"id":"semetey-1-2013:p0710:b004:l032","ordinal":131313,"en":"Toward his uncle Bakai"},{"id":"semetey-1-2013:p0710:b004:l033","ordinal":131314,"en":"The orphan fled, urging his horse."},{"id":"semetey-1-2013:p0710:b004:l034","ordinal":131315,"en":"Kardygach came pursuing."},{"id":"semetey-1-2013:p0710:b004:l035","ordinal":131316,"en":"As he fled downhill,"},{"id":"semetey-1-2013:p0710:b004:l036","ordinal":131317,"en":"Semetey's Aktulpar"},{"id":"semetey-1-2013:p0710:b004:l037","ordinal":131318,"en":"Planted its forelegs like a roe deer."},{"id":"semetey-1-2013:p0710:b004:l038","ordinal":131319,"en":"As they began to climb,"},{"id":"semetey-1-2013:p0710:b004:l039","ordinal":131320,"en":"Kardygach's winged steed"},{"id":"semetey-1-2013:p0711:b003:l001","ordinal":131321,"en":"Spread its mane and tail."},{"id":"semetey-1-2013:p0711:b003:l002","ordinal":131322,"en":"With a sparse mane and scant tail,"},{"id":"semetey-1-2013:p0711:b003:l003","ordinal":131323,"en":"Telkurong was a devouring marvel."},{"id":"semetey-1-2013:p0711:b003:l004","ordinal":131324,"en":"It had been Khan Zhakyp's horse,"},{"id":"semetey-1-2013:p0711:b003:l005","ordinal":131325,"en":"Born on sand, raised on stone,"},{"id":"semetey-1-2013:p0711:b003:l006","ordinal":131326,"en":"Raised apart, unlike other horses."},{"id":"semetey-1-2013:p0711:b003:l007","ordinal":131327,"en":"A Karabair, with a trap-strong back,"},{"id":"semetey-1-2013:p0711:b003:l008","ordinal":131328,"en":"Its running was the wind itself."}]
