[{"id":"manas-2010:p1429:b001:l003","ordinal":61697,"en":"To take the Buurul beneath him"},{"id":"manas-2010:p1429:b001:l004","ordinal":61698,"en":"As captured booty:"},{"id":"manas-2010:p1429:b001:l005","ordinal":61699,"en":"Coming up from behind,"},{"id":"manas-2010:p1429:b001:l006","ordinal":61700,"en":"Kongurbay was thinking,"},{"id":"manas-2010:p1429:b001:l007","ordinal":61701,"en":"“I shall load him with gold and silver,"},{"id":"manas-2010:p1429:b001:l008","ordinal":61702,"en":"The Buurul beneath him;"},{"id":"manas-2010:p1429:b001:l009","ordinal":61703,"en":"Having struck Shuutu down,"},{"id":"manas-2010:p1429:b001:l010","ordinal":61704,"en":"I shall present him to Karykan."},{"id":"manas-2010:p1429:b001:l011","ordinal":61705,"en":"The Buurul beneath him,"},{"id":"manas-2010:p1429:b001:l012","ordinal":61706,"en":"With shields spread wide,"},{"id":"manas-2010:p1429:b001:l013","ordinal":61707,"en":"Is a horse for a governor to ride;"},{"id":"manas-2010:p1429:b001:l014","ordinal":61708,"en":"With his waist-guard fastened,"},{"id":"manas-2010:p1429:b001:l015","ordinal":61709,"en":"A lord of Beijing should ride him."},{"id":"manas-2010:p1429:b001:l016","ordinal":61710,"en":"To a luckless Burut,"},{"id":"manas-2010:p1429:b001:l017","ordinal":61711,"en":"How did such a horse come?"},{"id":"manas-2010:p1429:b001:l018","ordinal":61712,"en":"For riding at leisure,"},{"id":"manas-2010:p1429:b001:l019","ordinal":61713,"en":"This roan horse has no equal."},{"id":"manas-2010:p1429:b001:l020","ordinal":61714,"en":"A golden horse-cloth—"},{"id":"manas-2010:p1429:b001:l021","ordinal":61715,"en":"Would one not cover such a beast with it?"},{"id":"manas-2010:p1429:b001:l022","ordinal":61716,"en":"Within a fortress with golden gates,"},{"id":"manas-2010:p1429:b001:l023","ordinal":61717,"en":"Would one not groom him each month"},{"id":"manas-2010:p1429:b001:l024","ordinal":61718,"en":"And tend such a beast?"},{"id":"manas-2010:p1429:b001:l025","ordinal":61719,"en":"To keep his feet from treading stones,"},{"id":"manas-2010:p1429:b001:l026","ordinal":61720,"en":"Would one not have gold horseshoes bent"},{"id":"manas-2010:p1429:b001:l027","ordinal":61721,"en":"And nail them on such a beast?"},{"id":"manas-2010:p1429:b001:l029","ordinal":61722,"en":"To Buurul's forelock,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p1429:b001:l030","ordinal":61723,"en":"Would one not attach it?"},{"id":"manas-2010:p1429:b001:l031","ordinal":61724,"en":"Would the khan of Kakanchyn"},{"id":"manas-2010:p1429:b001:l032","ordinal":61725,"en":"Not delight in such a beast?”"},{"id":"manas-2010:p1429:b001:l033","ordinal":61726,"en":"Burning within, all aflame,"},{"id":"manas-2010:p1429:b001:l034","ordinal":61727,"en":"Coveting Taibuurul,"},{"id":"manas-2010:p1429:b001:l035","ordinal":61728,"en":"His two eyes turned to four;"},{"id":"manas-2010:p1429:b001:l036","ordinal":61729,"en":"He raced along behind,"},{"id":"manas-2010:p1429:b001:l037","ordinal":61730,"en":"Urging Algara onward:"},{"id":"manas-2010:p1429:b001:l038","ordinal":61731,"en":"Kongurbay went on."},{"id":"manas-2010:p1429:b001:l039","ordinal":61732,"en":"He pursued in earnest,"},{"id":"manas-2010:p1429:b001:l040","ordinal":61733,"en":"His saddle-flaps fluttering,"},{"id":"manas-2010:p1429:b001:l041","ordinal":61734,"en":"A deep-blue bead-stone, flask-sized,"},{"id":"manas-2010:p1429:b001:l042","ordinal":61735,"en":"Bobbed upon his head."},{"id":"manas-2010:p1430:b001:l001","ordinal":61736,"en":"Among the Chinese with rank-buttons,"},{"id":"manas-2010:p1430:b001:l002","ordinal":61737,"en":"He was one of the finest;"},{"id":"manas-2010:p1430:b001:l003","ordinal":61738,"en":"Among the jacket-wearing Chinese,"},{"id":"manas-2010:p1430:b001:l004","ordinal":61739,"en":"He was a vat-sized great man,"},{"id":"manas-2010:p1430:b001:l005","ordinal":61740,"en":"He was Alöökö's son."},{"id":"manas-2010:p1430:b001:l006","ordinal":61741,"en":"Besides possessing wisdom,"},{"id":"manas-2010:p1430:b001:l007","ordinal":61742,"en":"He was a judge of horses."},{"id":"manas-2010:p1430:b001:l008","ordinal":61743,"en":"His words were clear when he spoke,"},{"id":"manas-2010:p1430:b001:l009","ordinal":61744,"en":"His eyes were clear when he gazed,"},{"id":"manas-2010:p1430:b001:l010","ordinal":61745,"en":"His face was open among men."},{"id":"manas-2010:p1430:b001:l011","ordinal":61746,"en":"His right shoulder was broad;"},{"id":"manas-2010:p1430:b001:l012","ordinal":61747,"en":"Kongurbay was no ordinary man,"},{"id":"manas-2010:p1430:b001:l013","ordinal":61748,"en":"A hero worth both left and right."},{"id":"manas-2010:p1430:b001:l014","ordinal":61749,"en":"Trapped before the muddy water,"},{"id":"manas-2010:p1430:b001:l015","ordinal":61750,"en":"That Shuutu was stranded now."},{"id":"manas-2010:p1430:b001:l016","ordinal":61751,"en":"“Buddha has given me the Burut!”"},{"id":"manas-2010:p1430:b001:l017","ordinal":61752,"en":"The lacquered spear upon his arm"},{"id":"manas-2010:p1430:b001:l018","ordinal":61753,"en":"He took into his hand."},{"id":"manas-2010:p1430:b001:l019","ordinal":61754,"en":"Bent low at the waist,"},{"id":"manas-2010:p1430:b001:l020","ordinal":61755,"en":"His eyes blazing and staring,"},{"id":"manas-2010:p1430:b001:l021","ordinal":61756,"en":"His battle-axe-like moustache"},{"id":"manas-2010:p1430:b001:l022","ordinal":61757,"en":"Divided into separate strands;"},{"id":"manas-2010:p1430:b001:l023","ordinal":61758,"en":"The earth split and shimmered:"},{"id":"manas-2010:p1430:b001:l024","ordinal":61759,"en":"Alöökö's Kongurbay"},{"id":"manas-2010:p1430:b001:l025","ordinal":61760,"en":"Was drawing near."},{"id":"manas-2010:p1430:b001:l026","ordinal":61761,"en":"As Kongurbay approached,"},{"id":"manas-2010:p1430:b001:l027","ordinal":61762,"en":"About to heap torment on him,"},{"id":"manas-2010:p1430:b001:l028","ordinal":61763,"en":"That hero Shuutu's"},{"id":"manas-2010:p1430:b001:l029","ordinal":61764,"en":"World shriveled in dread."},{"id":"manas-2010:p1430:b001:l030","ordinal":61765,"en":"Unable to find any means,"},{"id":"manas-2010:p1430:b001:l031","ordinal":61766,"en":"Looking from side to side,"},{"id":"manas-2010:p1430:b001:l032","ordinal":61767,"en":"Licking his lips and nose,"},{"id":"manas-2010:p1430:b001:l033","ordinal":61768,"en":"The reins tied in a round knot"},{"id":"manas-2010:p1430:b001:l034","ordinal":61769,"en":"He did not take in a proper grip;"},{"id":"manas-2010:p1430:b001:l035","ordinal":61770,"en":"Straight toward the dark water"},{"id":"manas-2010:p1430:b001:l036","ordinal":61771,"en":"He let Buurul go."},{"id":"manas-2010:p1430:b001:l037","ordinal":61772,"en":"He curved his neck like a stag;"},{"id":"manas-2010:p1430:b001:l038","ordinal":61773,"en":"Across the dark water, a target's distance,"},{"id":"manas-2010:p1430:b001:l039","ordinal":61774,"en":"That marvelous steed Buurul,"},{"id":"manas-2010:p1430:b001:l040","ordinal":61775,"en":"Bearing brave Shuutu,"},{"id":"manas-2010:p1430:b001:l041","ordinal":61776,"en":"Ran without hesitation."},{"id":"manas-2010:p1430:b001:l042","ordinal":61777,"en":"As he gathered himself to spring,"},{"id":"manas-2010:p1431:b001:l001","ordinal":61778,"en":"The mouth of his belt-pouch opened;"},{"id":"manas-2010:p1431:b001:l002","ordinal":61779,"en":"The letter of greeting Kanykey wrote"},{"id":"manas-2010:p1431:b001:l003","ordinal":61780,"en":"Scattered into the dark water."},{"id":"manas-2010:p1431:b001:l004","ordinal":61781,"en":"His gazelle-like eyes narrowed;"},{"id":"manas-2010:p1431:b001:l005","ordinal":61782,"en":"The accomplished steed Buurul"},{"id":"manas-2010:p1431:b001:l006","ordinal":61783,"en":"Struck the bank of the dark water,"},{"id":"manas-2010:p1431:b001:l007","ordinal":61784,"en":"Landing once upon the farther edge."},{"id":"manas-2010:p1431:b001:l008","ordinal":61785,"en":"Kongurbay, who knew his craft,"},{"id":"manas-2010:p1431:b001:l009","ordinal":61786,"en":"Along a winding, bull-urine track,"},{"id":"manas-2010:p1431:b001:l010","ordinal":61787,"en":"Along the ground that curved away,"},{"id":"manas-2010:p1431:b001:l011","ordinal":61788,"en":"Not letting Buurul draw far off,"},{"id":"manas-2010:p1431:b001:l012","ordinal":61789,"en":"Came racing like a mirage;"},{"id":"manas-2010:p1431:b001:l013","ordinal":61790,"en":"Was his mount not a marvelous steed too,"},{"id":"manas-2010:p1431:b001:l014","ordinal":61791,"en":"Hard upon Taibuurul's heels?"},{"id":"manas-2010:p1431:b001:l015","ordinal":61792,"en":"“I shall be captured!” he thought;"},{"id":"manas-2010:p1431:b001:l016","ordinal":61793,"en":"Brave Shuutu fled,"},{"id":"manas-2010:p1431:b001:l017","ordinal":61794,"en":"Cracking his whip as he struck."},{"id":"manas-2010:p1431:b001:l018","ordinal":61795,"en":"With golden forelock and fiery sash,"},{"id":"manas-2010:p1431:b001:l019","ordinal":61796,"en":"Well versed in Beijing,"},{"id":"manas-2010:p1431:b001:l020","ordinal":61797,"en":"Azizkhan's Almambet"},{"id":"manas-2010:p1431:b001:l021","ordinal":61798,"en":"Hastily performed his prayers"},{"id":"manas-2010:p1431:b001:l022","ordinal":61799,"en":"And saddled Sarala."},{"id":"manas-2010:p1431:b001:l023","ordinal":61800,"en":"“The Chinese of Kakanchyn"},{"id":"manas-2010:p1431:b001:l024","ordinal":61801,"en":"Have reached their hour of strength;"},{"id":"manas-2010:p1431:b001:l025","ordinal":61802,"en":"Perhaps their cunning has prevailed."},{"id":"manas-2010:p1431:b001:l026","ordinal":61803,"en":"If Kongurbay takes the notion,"},{"id":"manas-2010:p1431:b001:l027","ordinal":61804,"en":"For someone coming from home"},{"id":"manas-2010:p1431:b001:l028","ordinal":61805,"en":"He will lurk in ambush on the road;"},{"id":"manas-2010:p1431:b001:l029","ordinal":61806,"en":"He will seize him in a secluded place."},{"id":"manas-2010:p1431:b001:l030","ordinal":61807,"en":"If the messenger falls into his hands"},{"id":"manas-2010:p1431:b001:l031","ordinal":61808,"en":"(The messenger who left Talas),"},{"id":"manas-2010:p1431:b001:l032","ordinal":61809,"en":"He will slaughter him as a sacrifice.”"},{"id":"manas-2010:p1431:b001:l033","ordinal":61810,"en":"His courage surpassed"},{"id":"manas-2010:p1431:b001:l034","ordinal":61811,"en":"That of other men in those days;"},{"id":"manas-2010:p1431:b001:l035","ordinal":61812,"en":"He scouted the road, reconnoitered the land,"},{"id":"manas-2010:p1431:b001:l036","ordinal":61813,"en":"And went out to meet arrivals."},{"id":"manas-2010:p1431:b001:l037","ordinal":61814,"en":"Finding no mountain to fling himself against,"},{"id":"manas-2010:p1431:b001:l038","ordinal":61815,"en":"Finding no enemy to fight,"},{"id":"manas-2010:p1431:b001:l039","ordinal":61816,"en":"Stretching like a lion,"},{"id":"manas-2010:p1431:b001:l040","ordinal":61817,"en":"Azizkhan's Almambet,"},{"id":"manas-2010:p1431:b001:l041","ordinal":61818,"en":"Riding a horse like Sarala,"},{"id":"manas-2010:p1431:b001:l042","ordinal":61819,"en":"Wearing yellow leather trousers,"},{"id":"manas-2010:p1432:b001:l001","ordinal":61820,"en":"Rode with an inkling of danger."},{"id":"manas-2010:p1432:b001:l002","ordinal":61821,"en":"That Shuutu had taken flight,"},{"id":"manas-2010:p1432:b001:l003","ordinal":61822,"en":"That the Fierce One, Kongurbay,"},{"id":"manas-2010:p1432:b001:l004","ordinal":61823,"en":"Had driven him ahead,"},{"id":"manas-2010:p1432:b001:l005","ordinal":61824,"en":"Almambet saw from afar"},{"id":"manas-2010:p1432:b001:l006","ordinal":61825,"en":"(That precious hero, fulfilled in every way,"},{"id":"manas-2010:p1432:b001:l007","ordinal":61826,"en":"That lion of superior birth)."},{"id":"manas-2010:p1432:b001:l008","ordinal":61827,"en":"Unable to turn Sarala aside,"},{"id":"manas-2010:p1432:b001:l009","ordinal":61828,"en":"When he saw Kongurbay,"},{"id":"manas-2010:p1432:b001:l010","ordinal":61829,"en":"Unable to bear standing still,"},{"id":"manas-2010:p1432:b001:l011","ordinal":61830,"en":"He shouted, “Almambet!”"},{"id":"manas-2010:p1432:b001:l012","ordinal":61831,"en":"And raised the battle-cry, “Manas!”"},{"id":"manas-2010:p1432:b001:l013","ordinal":61832,"en":"The swift Sarala stretched out,"},{"id":"manas-2010:p1432:b001:l014","ordinal":61833,"en":"And Almambet upon him"},{"id":"manas-2010:p1432:b001:l015","ordinal":61834,"en":"Loomed like a mighty mountain."},{"id":"manas-2010:p1432:b001:l016","ordinal":61835,"en":"When he saw Almambet,"},{"id":"manas-2010:p1432:b001:l017","ordinal":61836,"en":"Alöökö's Fierce One"},{"id":"manas-2010:p1432:b001:l018","ordinal":61837,"en":"Was torn by fear within."},{"id":"manas-2010:p1432:b001:l019","ordinal":61838,"en":"“Algara has gathered speed;"},{"id":"manas-2010:p1432:b001:l020","ordinal":61839,"en":"Before I can rein him in,"},{"id":"manas-2010:p1432:b001:l021","ordinal":61840,"en":"Before I can get ready,"},{"id":"manas-2010:p1432:b001:l022","ordinal":61841,"en":"That accursed one coming from the flank,"},{"id":"manas-2010:p1432:b001:l023","ordinal":61842,"en":"If he charges and thrusts, will leave me ruined."},{"id":"manas-2010:p1432:b001:l024","ordinal":61843,"en":"He was born a capable lion,"},{"id":"manas-2010:p1432:b001:l025","ordinal":61844,"en":"He is a hero of great strength;"},{"id":"manas-2010:p1432:b001:l026","ordinal":61845,"en":"If he thrusts from the flank, I am undone!”"},{"id":"manas-2010:p1432:b001:l027","ordinal":61846,"en":"So saying, Kongurbay"},{"id":"manas-2010:p1432:b001:l028","ordinal":61847,"en":"Pulled the swift steed Algara"},{"id":"manas-2010:p1432:b001:l029","ordinal":61848,"en":"Around now."},{"id":"manas-2010:p1432:b001:l030","ordinal":61849,"en":"Not facing Almambet,"},{"id":"manas-2010:p1432:b001:l031","ordinal":61850,"en":"Not daring to grapple,"},{"id":"manas-2010:p1432:b001:l032","ordinal":61851,"en":"He suddenly turned back,"},{"id":"manas-2010:p1432:b001:l033","ordinal":61852,"en":"Slipping away like a fox:"},{"id":"manas-2010:p1432:b001:l034","ordinal":61853,"en":"The Fierce One took flight."},{"id":"manas-2010:p1432:b001:l035","ordinal":61854,"en":"The strong fort built in Beijing:"},{"id":"manas-2010:p1432:b001:l036","ordinal":61855,"en":"Kongurbay, hurrying in earnest,"},{"id":"manas-2010:p1432:b001:l037","ordinal":61856,"en":"Was penned against the fort now."},{"id":"manas-2010:p1432:b001:l038","ordinal":61857,"en":"When the Fierce One was hemmed in,"},{"id":"manas-2010:p1432:b001:l039","ordinal":61858,"en":"The surpassing hero Almambet,"},{"id":"manas-2010:p1432:b001:l040","ordinal":61859,"en":"His shout splitting stones,"},{"id":"manas-2010:p1432:b001:l041","ordinal":61860,"en":"His roar splitting heads,"},{"id":"manas-2010:p1432:b001:l042","ordinal":61861,"en":"Made Sarala surge,"},{"id":"manas-2010:p1433:b001:l001","ordinal":61862,"en":"Made him spring and plunge,"},{"id":"manas-2010:p1433:b001:l002","ordinal":61863,"en":"Whipped him from side to side,"},{"id":"manas-2010:p1433:b001:l003","ordinal":61864,"en":"Spurred right and left,"},{"id":"manas-2010:p1433:b001:l004","ordinal":61865,"en":"His eyes blazing like fire."},{"id":"manas-2010:p1433:b001:l005","ordinal":61866,"en":"“While he is hemmed in,"},{"id":"manas-2010:p1433:b001:l006","ordinal":61867,"en":"I shall run the Fierce One through!”"},{"id":"manas-2010:p1433:b001:l007","ordinal":61868,"en":"His two eyes turned to four;"},{"id":"manas-2010:p1433:b001:l008","ordinal":61869,"en":"As he arrived like an arrow,"},{"id":"manas-2010:p1433:b001:l009","ordinal":61870,"en":"The lion-born Almambet,"},{"id":"manas-2010:p1433:b001:l010","ordinal":61871,"en":"At Alöökö's Kongurbay"},{"id":"manas-2010:p1433:b001:l011","ordinal":61872,"en":"Upon Algara's back,"},{"id":"manas-2010:p1433:b001:l012","ordinal":61873,"en":"Was about to drive his thrust."},{"id":"manas-2010:p1433:b001:l013","ordinal":61874,"en":"That fellow skilled among spearmen,"},{"id":"manas-2010:p1433:b001:l014","ordinal":61875,"en":"That capable fellow versed in enemy tricks,"},{"id":"manas-2010:p1433:b001:l015","ordinal":61876,"en":"Shouted, “Come! Come! Come!”"},{"id":"manas-2010:p1433:b001:l016","ordinal":61877,"en":"Raising “Come!” as his battle-cry,"},{"id":"manas-2010:p1433:b001:l017","ordinal":61878,"en":"The true steed Algara"},{"id":"manas-2010:p1433:b001:l018","ordinal":61879,"en":"He struck once across the hocks."},{"id":"manas-2010:p1433:b001:l019","ordinal":61880,"en":"Bending his neck like a gun-trigger,"},{"id":"manas-2010:p1433:b001:l020","ordinal":61881,"en":"That hemmed-in Fierce One fellow,"},{"id":"manas-2010:p1433:b001:l021","ordinal":61882,"en":"The accursed man, struggling for life,"},{"id":"manas-2010:p1433:b001:l022","ordinal":61883,"en":"Over the high-built, mighty fort"},{"id":"manas-2010:p1433:b001:l023","ordinal":61884,"en":"Made him leap and fled."},{"id":"manas-2010:p1433:b001:l024","ordinal":61885,"en":"Clouds gathered in the sky;"},{"id":"manas-2010:p1433:b001:l025","ordinal":61886,"en":"Alöökö's Fierce One,"},{"id":"manas-2010:p1433:b001:l026","ordinal":61887,"en":"From right before Almambet,"},{"id":"manas-2010:p1433:b001:l027","ordinal":61888,"en":"Escaped in plain sight."},{"id":"manas-2010:p1433:b001:l028","ordinal":61889,"en":"When the Fierce One had fled,"},{"id":"manas-2010:p1433:b001:l029","ordinal":61890,"en":"Drawing out the drum's booming,"},{"id":"manas-2010:p1433:b001:l030","ordinal":61891,"en":"The tiger-hero Almambet"},{"id":"manas-2010:p1433:b001:l031","ordinal":61892,"en":"Lamented his unfulfilled wish,"},{"id":"manas-2010:p1433:b001:l032","ordinal":61893,"en":"Beat his palms together,"},{"id":"manas-2010:p1433:b001:l033","ordinal":61894,"en":"Grew furious and wild,"},{"id":"manas-2010:p1433:b001:l034","ordinal":61895,"en":"Turned his horse and came back,"},{"id":"manas-2010:p1433:b001:l035","ordinal":61896,"en":"And the messenger from Talas,"},{"id":"manas-2010:p1433:b001:l036","ordinal":61897,"en":"Shuutu, he came to meet."},{"id":"manas-2010:p1433:b001:l037","ordinal":61898,"en":"“Peace be upon you,"},{"id":"manas-2010:p1433:b001:l038","ordinal":61899,"en":"Brave Shuutu of noble bearing!"},{"id":"manas-2010:p1433:b001:l039","ordinal":61900,"en":"Where the cuckoo sings in the willow,"},{"id":"manas-2010:p1433:b001:l040","ordinal":61901,"en":"Where the nightingale pours out its song,"},{"id":"manas-2010:p1433:b001:l041","ordinal":61902,"en":"Tamarisk-grown Keng-Kol and broad Talas:"},{"id":"manas-2010:p1433:b001:l042","ordinal":61903,"en":"Is your homeland safe and well?"},{"id":"manas-2010:p1434:b001:l001","ordinal":61904,"en":"Your prosperous people, the many Nogoy,"},{"id":"manas-2010:p1434:b001:l002","ordinal":61905,"en":"Argyn and Kyrgyz mingled:"},{"id":"manas-2010:p1434:b001:l003","ordinal":61906,"en":"Are your people alive and well?"},{"id":"manas-2010:p1434:b001:l004","ordinal":61907,"en":"With Kaynar's dark-eyed daughter,"},{"id":"manas-2010:p1434:b001:l005","ordinal":61908,"en":"With that very plane tree,"},{"id":"manas-2010:p1434:b001:l006","ordinal":61909,"en":"Is your household safe and well?"},{"id":"manas-2010:p1434:b001:l007","ordinal":61910,"en":"There along the Talas,"},{"id":"manas-2010:p1434:b001:l008","ordinal":61911,"en":"His white turban like a cauldron,"},{"id":"manas-2010:p1434:b001:l009","ordinal":61912,"en":"His shout like the call to prayer,"},{"id":"manas-2010:p1434:b001:l010","ordinal":61913,"en":"Is your mullah safe and well?"},{"id":"manas-2010:p1434:b001:l011","ordinal":61914,"en":"With heavy braid-ornaments and broad hips,"},{"id":"manas-2010:p1434:b001:l012","ordinal":61915,"en":"Is your craftswoman safe and well?"},{"id":"manas-2010:p1434:b001:l013","ordinal":61916,"en":"With rooster-like neck and flowing hair,"},{"id":"manas-2010:p1434:b001:l014","ordinal":61917,"en":"Is your maiden safe and well?"},{"id":"manas-2010:p1434:b001:l015","ordinal":61918,"en":"Spread broadly like a river,"},{"id":"manas-2010:p1434:b001:l016","ordinal":61919,"en":"Is your village safe and well?"},{"id":"manas-2010:p1434:b001:l017","ordinal":61920,"en":"I have no male heir behind me:"},{"id":"manas-2010:p1434:b001:l018","ordinal":61921,"en":"Agynay's daughter Aruuke,"},{"id":"manas-2010:p1434:b001:l019","ordinal":61922,"en":"Is my wife safe and well?"},{"id":"manas-2010:p1434:b001:l020","ordinal":61923,"en":"Kanykey, mother of the people,"},{"id":"manas-2010:p1434:b001:l021","ordinal":61924,"en":"Bearing her people's sorrows,"},{"id":"manas-2010:p1434:b001:l022","ordinal":61925,"en":"Is our sister-in-law safe and well?"},{"id":"manas-2010:p1434:b001:l023","ordinal":61926,"en":"The spring flowing from his river,"},{"id":"manas-2010:p1434:b001:l024","ordinal":61927,"en":"The little son Manas gained so painfully,"},{"id":"manas-2010:p1434:b001:l025","ordinal":61928,"en":"For whose feast ninety beasts were slain,"},{"id":"manas-2010:p1434:b001:l026","ordinal":61929,"en":"Who was named brave Semetey,"},{"id":"manas-2010:p1434:b001:l027","ordinal":61930,"en":"When we set out on our journey,"},{"id":"manas-2010:p1434:b001:l028","ordinal":61931,"en":"The Russians ate his feast and left,"},{"id":"manas-2010:p1434:b001:l029","ordinal":61932,"en":"Saying, ‘If Semetey lives,"},{"id":"manas-2010:p1434:b001:l030","ordinal":61933,"en":"He will overthrow the Oirat,’ as they left."},{"id":"manas-2010:p1434:b001:l031","ordinal":61934,"en":"Many peoples ate his feast and left,"},{"id":"manas-2010:p1434:b001:l032","ordinal":61935,"en":"Saying, ‘If Semetey lives,"},{"id":"manas-2010:p1434:b001:l033","ordinal":61936,"en":"He will overthrow many,’ as they left."},{"id":"manas-2010:p1434:b001:l034","ordinal":61937,"en":"The banner fastened to his spear,"},{"id":"manas-2010:p1434:b001:l035","ordinal":61938,"en":"Is Semetey alive and well, my Shuutu?"},{"id":"manas-2010:p1434:b001:l036","ordinal":61939,"en":"Scheming treachery,"},{"id":"manas-2010:p1434:b001:l037","ordinal":61940,"en":"Never abandoning wicked thoughts,"},{"id":"manas-2010:p1434:b001:l038","ordinal":61941,"en":"Khan Manas's father,"},{"id":"manas-2010:p1434:b001:l039","ordinal":61942,"en":"Is old Jakyp well?”"},{"id":"manas-2010:p1434:b001:l040","ordinal":61943,"en":"Giving greeting, drooping low,"},{"id":"manas-2010:p1434:b001:l041","ordinal":61944,"en":"He turned Taibuurul's mouth,"},{"id":"manas-2010:p1434:b001:l042","ordinal":61945,"en":"And told him how the people fared,"},{"id":"manas-2010:p1435:b001:l001","ordinal":61946,"en":"Before Almambet"},{"id":"manas-2010:p1435:b001:l002","ordinal":61947,"en":"He rode up and stood."},{"id":"manas-2010:p1435:b001:l003","ordinal":61948,"en":"“The dear child is safe, the people safe,"},{"id":"manas-2010:p1435:b001:l004","ordinal":61949,"en":"All the people you remember are safe."},{"id":"manas-2010:p1435:b001:l005","ordinal":61950,"en":"With Kanykei at their head, the people are safe."},{"id":"manas-2010:p1435:b001:l006","ordinal":61951,"en":"When I went to Talas with news,"},{"id":"manas-2010:p1435:b001:l007","ordinal":61952,"en":"All the people you know were safe."}]
