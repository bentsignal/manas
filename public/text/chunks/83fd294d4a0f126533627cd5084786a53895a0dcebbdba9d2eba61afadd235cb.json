[{"id":"semetey-1-2013:p0981:b004:l025","ordinal":151041,"en":"A woman sitting at home have with it?"},{"id":"semetey-1-2013:p0981:b004:l026","ordinal":151042,"en":"Vanish from my sight;"},{"id":"semetey-1-2013:p0981:b004:l027","ordinal":151043,"en":"Do not come near me!"},{"id":"semetey-1-2013:p0981:b004:l028","ordinal":151044,"en":"You who speak with a hiss,"},{"id":"semetey-1-2013:p0981:b004:l029","ordinal":151045,"en":"Who mention the time I was mocked—"},{"id":"semetey-1-2013:p0981:b004:l030","ordinal":151046,"en":"For these words you have spoken,"},{"id":"semetey-1-2013:p0981:b004:l031","ordinal":151047,"en":"By your father’s grave, filthy slave,"},{"id":"semetey-1-2013:p0981:b004:l032","ordinal":151048,"en":"Vanish from my sight!"},{"id":"semetey-1-2013:p0981:b004:l033","ordinal":151049,"en":"I shall slaughter you now;"},{"id":"semetey-1-2013:p0981:b004:l034","ordinal":151050,"en":"By your father’s grave, devil-slave,"},{"id":"semetey-1-2013:p0981:b004:l035","ordinal":151051,"en":"I shall gouge out your eyes!"},{"id":"semetey-1-2013:p0981:b004:l036","ordinal":151052,"en":"Remember what I have said:"},{"id":"semetey-1-2013:p0981:b004:l037","ordinal":151053,"en":"You and your bloodthirsty companion together—"},{"id":"semetey-1-2013:p0981:b004:l038","ordinal":151054,"en":"Go down into the black earth!”"},{"id":"semetey-1-2013:p0981:b004:l039","ordinal":151055,"en":"She raged and swelled with fury,"},{"id":"semetey-1-2013:p0982:b003:l001","ordinal":151056,"en":"The mad woman Chachykey"},{"id":"semetey-1-2013:p0982:b003:l002","ordinal":151057,"en":"Spoke without restraint,"},{"id":"semetey-1-2013:p0982:b003:l003","ordinal":151058,"en":"And became intent upon"},{"id":"semetey-1-2013:p0982:b003:l004","ordinal":151059,"en":"Slaughtering Kulchoro,"},{"id":"semetey-1-2013:p0982:b003:l005","ordinal":151060,"en":"Putting him to death,"},{"id":"semetey-1-2013:p0982:b003:l006","ordinal":151061,"en":"Cutting him down as a sacrifice,"},{"id":"semetey-1-2013:p0982:b003:l007","ordinal":151062,"en":"And ending his life."},{"id":"semetey-1-2013:p0982:b003:l008","ordinal":151063,"en":"The wayward, spoiled mad slave-woman—"},{"id":"semetey-1-2013:p0982:b003:l009","ordinal":151064,"en":"Now God struck the madwoman;"},{"id":"semetey-1-2013:p0982:b003:l010","ordinal":151065,"en":"May He never give such a person"},{"id":"semetey-1-2013:p0982:b003:l011","ordinal":151066,"en":"Such filthy, obscene speech."},{"id":"semetey-1-2013:p0982:b003:l012","ordinal":151067,"en":"When you looked at Chachykey,"},{"id":"semetey-1-2013:p0982:b003:l013","ordinal":151068,"en":"She raged beyond the reach of words;"},{"id":"semetey-1-2013:p0982:b003:l014","ordinal":151069,"en":"Your stubborn sister-in-law spoke,"},{"id":"semetey-1-2013:p0982:b003:l015","ordinal":151070,"en":"Swelled and seethed,"},{"id":"semetey-1-2013:p0982:b003:l016","ordinal":151071,"en":"And your fierce sister-in-law spoke."},{"id":"semetey-1-2013:p0982:b003:l017","ordinal":151072,"en":"Where Semetey lay,"},{"id":"semetey-1-2013:p0982:b003:l018","ordinal":151073,"en":"Here where he remained still,"},{"id":"semetey-1-2013:p0982:b003:l019","ordinal":151074,"en":"For sixty colts and four sheep"},{"id":"semetey-1-2013:p0982:b003:l020","ordinal":151075,"en":"Your noble mother Kanykey"},{"id":"semetey-1-2013:p0982:b003:l021","ordinal":151076,"en":"Had refined white silver."},{"id":"semetey-1-2013:p0982:b003:l022","ordinal":151077,"en":"Amid thirty daughters-in-law and thirty girls,"},{"id":"semetey-1-2013:p0982:b003:l023","ordinal":151078,"en":"Your sister-in-law"},{"id":"semetey-1-2013:p0982:b003:l024","ordinal":151079,"en":"Seized by its handle"},{"id":"semetey-1-2013:p0982:b003:l025","ordinal":151080,"en":"A knife made to slaughter a man,"},{"id":"semetey-1-2013:p0982:b003:l026","ordinal":151081,"en":"Drew it from its sheath,"},{"id":"semetey-1-2013:p0982:b003:l027","ordinal":151082,"en":"And rushed to slaughter Kulchoro,"},{"id":"semetey-1-2013:p0982:b003:l028","ordinal":151083,"en":"To put him to death."},{"id":"semetey-1-2013:p0982:b003:l029","ordinal":151084,"en":"She charged forward in a lunge,"},{"id":"semetey-1-2013:p0982:b003:l030","ordinal":151085,"en":"Knife gripped in her hand,"},{"id":"semetey-1-2013:p0982:b003:l031","ordinal":151086,"en":"And threw herself upon Kulchoro."},{"id":"semetey-1-2013:p0982:b003:l032","ordinal":151087,"en":"From that witless wretch"},{"id":"semetey-1-2013:p0982:b003:l033","ordinal":151088,"en":"Kulchoro fled away,"},{"id":"semetey-1-2013:p0982:b003:l034","ordinal":151089,"en":"Clung to the place of a mother,"},{"id":"semetey-1-2013:p0982:b003:l035","ordinal":151090,"en":"And escaped the woman who had seized a weapon."},{"id":"semetey-1-2013:p0982:b003:l036","ordinal":151091,"en":"“Father! Wild sister-in-law Chachykey!"},{"id":"semetey-1-2013:p0982:b003:l037","ordinal":151092,"en":"I know your unruly nature;"},{"id":"semetey-1-2013:p0982:b003:l038","ordinal":151093,"en":"I honor the spirit"},{"id":"semetey-1-2013:p0982:b003:l039","ordinal":151094,"en":"Of my swaggering prince Semetey!”"},{"id":"semetey-1-2013:p0982:b004:l001","ordinal":151095,"en":"The boy said this and fled."},{"id":"semetey-1-2013:p0982:b004:l002","ordinal":151096,"en":"Kulchoro flew like an arrow;"},{"id":"semetey-1-2013:p0982:b004:l003","ordinal":151097,"en":"The wretch could not draw near him."},{"id":"semetey-1-2013:p0982:b004:l004","ordinal":151098,"en":"The great woman raised a shout"},{"id":"semetey-1-2013:p0982:b004:l005","ordinal":151099,"en":"And struck out in anger."},{"id":"semetey-1-2013:p0982:b004:l006","ordinal":151100,"en":"From far behind the boy,"},{"id":"semetey-1-2013:p0982:b004:l007","ordinal":151101,"en":"The knife struck the gate."},{"id":"semetey-1-2013:p0982:b004:l008","ordinal":151102,"en":"The gate shattered apart,"},{"id":"semetey-1-2013:p0982:b004:l009","ordinal":151103,"en":"And thirty daughters-in-law and thirty girls"},{"id":"semetey-1-2013:p0982:b004:l010","ordinal":151104,"en":"Fled in every direction, crying out."},{"id":"semetey-1-2013:p0982:b004:l011","ordinal":151105,"en":"Kulchoro ran on,"},{"id":"semetey-1-2013:p0982:b004:l012","ordinal":151106,"en":"Bending low for a spear’s length,"},{"id":"semetey-1-2013:p0982:b004:l013","ordinal":151107,"en":"He reached the top of Akborchuk"},{"id":"semetey-1-2013:p0982:b004:l014","ordinal":151108,"en":"And rushed onward in haste."},{"id":"semetey-1-2013:p0982:b004:l015","ordinal":151109,"en":"He fled as though enemies had entered the village,"},{"id":"semetey-1-2013:p0982:b004:l016","ordinal":151110,"en":"Running away"},{"id":"semetey-1-2013:p0982:b004:l017","ordinal":151111,"en":"From Semetey’s wife."},{"id":"semetey-1-2013:p0982:b004:l018","ordinal":151112,"en":"He took the road at speed,"},{"id":"semetey-1-2013:p0982:b004:l019","ordinal":151113,"en":"And charged onward without drawing near."},{"id":"semetey-1-2013:p0982:b004:l020","ordinal":151114,"en":"Hurrying, the two matched their pace,"},{"id":"semetey-1-2013:p0982:b004:l021","ordinal":151115,"en":"And the two equal warrior choros"},{"id":"semetey-1-2013:p0982:b004:l022","ordinal":151116,"en":"Took counsel in an empty place:"},{"id":"semetey-1-2013:p0982:b004:l023","ordinal":151117,"en":"“Who can understand a secret like this?"},{"id":"semetey-1-2013:p0982:b004:l024","ordinal":151118,"en":"Elder Kanchoro, hear my words!"},{"id":"semetey-1-2013:p0982:b004:l025","ordinal":151119,"en":"His wife is out of her senses;"},{"id":"semetey-1-2013:p0982:b004:l026","ordinal":151120,"en":"That croaking wretch"},{"id":"semetey-1-2013:p0982:b004:l027","ordinal":151121,"en":"Nearly killed me."},{"id":"semetey-1-2013:p0982:b004:l028","ordinal":151122,"en":"Along the Üch-Koshoy,"},{"id":"semetey-1-2013:p0982:b004:l029","ordinal":151123,"en":"Our blue-maned elder, great Bakay,"},{"id":"semetey-1-2013:p0982:b004:l030","ordinal":151124,"en":"Is an old man of immense wisdom,"},{"id":"semetey-1-2013:p0982:b004:l031","ordinal":151125,"en":"A sage left to us"},{"id":"semetey-1-2013:p0982:b004:l032","ordinal":151126,"en":"By the blue-maned lion Manas."},{"id":"semetey-1-2013:p0982:b004:l033","ordinal":151127,"en":"Bakay’s senior wife Körpöjan—"},{"id":"semetey-1-2013:p0982:b004:l034","ordinal":151128,"en":"Let us bring her between us,"},{"id":"semetey-1-2013:p0982:b004:l035","ordinal":151129,"en":"And learn the news for certain."},{"id":"semetey-1-2013:p0982:b004:l036","ordinal":151130,"en":"On the face of the willow country,"},{"id":"semetey-1-2013:p0982:b004:l037","ordinal":151131,"en":"On this side of Keng-Köl,"},{"id":"semetey-1-2013:p0982:b004:l038","ordinal":151132,"en":"Sarykan of the bowl-shaped eyes"},{"id":"semetey-1-2013:p0982:b004:l039","ordinal":151133,"en":"Was a person of sacred power,"}]
