{"id": "sayakbay-ms-current146:pdf029:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 29, "folio": 412, "line_in_page": 27, "raw": "Айбатынан жан өлгөн,", "text": "Айбатынан жан өлгөн,", "en": "At his menace, men died of fright,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
