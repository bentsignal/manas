{"id": "sayakbay-ms-current146:pdf205:l001", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 1, "raw": "Чын байлады колдорду,", "text": "Чын байлады колдорду,", "en": "They bound his hands fast.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l002", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 2, "raw": "Кайран Кенен кабылан,", "text": "Кайран Кенен кабылан,", "en": "Poor Kenen, the lion,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l003", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 3, "raw": "Бел байлаган берени,", "text": "Бел байлаган берени,", "en": "The champion who girded his waist,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l004", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 4, "raw": "Белим кыргыз эрени,", "text": "Белим кыргыз эрени,", "en": "My strength, the Kyrgyz hero,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l005", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 5, "raw": "Алда Таала носкону,", "text": "Алда Таала носкону,", "en": "The one ordained by Almighty God,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 6, "raw": "Ак калпак журтун сүйгөнү,", "text": "Ак калпак журтун сүйгөнү,", "en": "The one who loved the white-capped people.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 7, "raw": "Кенен жалгыз Кудай менен,", "text": "Кенен жалгыз Кудай менен,", "en": "Kenen stood alone with God.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 8, "raw": "Токун турган бүлдүрүп,", "text": "Токун турган бүлдүрүп,", "en": "They devastated what stood assembled,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 9, "raw": "Чоң зоорун билгизип,", "text": "Чоң зоорун билгизип,", "en": "Making their great violence known,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 10, "raw": "Чындыгын жанды күйгүзүп,", "text": "Чындыгын жанды күйгүзүп,", "en": "And burning the soul with its truth.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 11, "raw": "Кармашып деп калдайды,", "text": "Кармашып деп калдайды,", "en": "They summoned the Kalmyk to grapple.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 12, "raw": "Каарданын зекирип,", "text": "Каарданын зекирип,", "en": "He rebuked them in his wrath.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l013", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 13, "raw": "Кол агын бел чырмап,", "text": "Кол агын бел чырмап,", "en": "They twisted his white arms behind his waist.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 14, "raw": "Букон бойду чың текшер,", "text": "Букон бойду чың текшер,", "en": "Test the whole body and bind it tight.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 15, "raw": "Чындырып курган бекитип,", "text": "Чындырып курган бекитип,", "en": "They fastened the restraint they had made.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 16, "raw": "Ыктык белин бүктөтүп,", "text": "Ыктык белин бүктөтүп,", "en": "They forced his supple waist to bend.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 17, "raw": "Боз калырга жүрөтүп,", "text": "Боз калырга жүрөтүп,", "en": "They drove him toward the gray Kalmyks.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 18, "raw": "Калың кытай баарына,", "text": "Калың кытай баарына,", "en": "Before all the countless Chinese,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 19, "raw": "Кордуу тиш калырга,", "text": "Кордуу тиш калырга,", "en": "They left him with teeth of humiliation.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 20, "raw": "Кордуктан байлатып,", "text": "Кордуктан байлатып,", "en": "They had him bound in disgrace.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 21, "raw": "Эки көздү жайкатып,", "text": "Эки көздү жайкатып,", "en": "They made his two eyes spread wide.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 22, "raw": "Сан калдайга байлатып,", "text": "Сан калдайга байлатып,", "en": "They bound him before the many Kalmyks.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 23, "raw": "Токун токоп талатып,", "text": "Токун токоп талатып,", "en": "They trampled and plundered him.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l024", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 24, "raw": "Бабаңдын өчүн алган деп,", "text": "Бабаңдын өчүн алган деп,", "en": "Saying, “He avenged your forefather,”", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 25, "raw": "Белбандарга сабатып,", "text": "Белбандарга сабатып,", "en": "They had the wrestlers beat him.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 26, "raw": "Ханына айдап келди эле,", "text": "Ханына айдап келди эле,", "en": "Then they drove him before their khan.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 27, "raw": "Каардуу муздак караң түн,", "text": "Каардуу муздак караң түн,", "en": "The cruel, cold, dark night,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 28, "raw": "Кайран Кенен көрдү эле,", "text": "Кайран Кенен көрдү эле,", "en": "Poor Kenen saw it.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 29, "raw": "Эки колу байлоодо,", "text": "Эки колу байлоодо,", "en": "His two hands were bound,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 30, "raw": "Эки алтын көз жайноодо,", "text": "Эки алтын көз жайноодо,", "en": "While his two golden eyes still shone.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 31, "raw": "Байлап кысып ханына,", "text": "Байлап кысып ханына,", "en": "They bound him tight before the khan.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 32, "raw": "Сейилдикке түшүргөн,", "text": "Сейилдикке түшүргөн,", "en": "They brought him down to the promenade.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 33, "raw": "Жабушу алтын чабырга,", "text": "Жабушу алтын чабырга,", "en": "To the golden-covered platform,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Completion-first provisional reading of difficult cursive; lexical form, name, or idiomatic interpretation requires later witness collation.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l034", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 34, "raw": "Эр Чыңкер баатырга,", "text": "Эр Чыңкер баатырга,", "en": "Before the hero Chengker,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf205:l035", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 205, "folio": 588, "line_in_page": 35, "raw": "Алып тартып кылды эле.", "text": "Алып тартып кылды эле.", "en": "They dragged him forward and did this.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
