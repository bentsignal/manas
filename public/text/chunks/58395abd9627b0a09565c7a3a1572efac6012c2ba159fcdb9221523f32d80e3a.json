[{"id":"semetey-1-2013:p0459:b005:l017","ordinal":111873,"en":"His lion Bakai Khan was not there."},{"id":"semetey-1-2013:p0459:b005:l018","ordinal":111874,"en":"Companions even in the hereafter,"},{"id":"semetey-1-2013:p0459:b005:l019","ordinal":111875,"en":"All those forty champions were absent."},{"id":"semetey-1-2013:p0459:b005:l020","ordinal":111876,"en":"His hapless eyes drooped shut,"},{"id":"semetey-1-2013:p0459:b005:l021","ordinal":111877,"en":"His looks faded, his belly burned,"},{"id":"semetey-1-2013:p0459:b005:l022","ordinal":111878,"en":"His strength left him as he languished."},{"id":"semetey-1-2013:p0459:b005:l023","ordinal":111879,"en":"Once Közkaman had become his enemy,"},{"id":"semetey-1-2013:p0459:b005:l024","ordinal":111880,"en":"My sultan openly despaired of life."},{"id":"semetey-1-2013:p0459:b005:l025","ordinal":111881,"en":"Unable to rise, doubled over,"},{"id":"semetey-1-2013:p0459:b005:l026","ordinal":111882,"en":"After drinking the accursed poison,"},{"id":"semetey-1-2013:p0459:b005:l027","ordinal":111883,"en":"My sultan fell straight onto his head."},{"id":"semetey-1-2013:p0459:b005:l028","ordinal":111884,"en":"“For not heeding Kanykei's words,"},{"id":"semetey-1-2013:p0459:b005:l029","ordinal":111885,"en":"Let this poor head suffer on,” he said."},{"id":"semetey-1-2013:p0459:b005:l030","ordinal":111886,"en":"My dear lord grieved."},{"id":"semetey-1-2013:p0459:b005:l031","ordinal":111887,"en":"Kökchököz's nine sons,"},{"id":"semetey-1-2013:p0459:b005:l032","ordinal":111888,"en":"Közkaman's nine sons—"},{"id":"semetey-1-2013:p0459:b005:l033","ordinal":111889,"en":"All were masters of the spear,"},{"id":"semetey-1-2013:p0459:b005:l034","ordinal":111890,"en":"Skilled men who knew the enemy's tactics,"},{"id":"semetey-1-2013:p0459:b005:l035","ordinal":111891,"en":"Marksmen whose shots did not miss,"},{"id":"semetey-1-2013:p0459:b005:l036","ordinal":111892,"en":"All warriors hostile to your father."},{"id":"semetey-1-2013:p0459:b005:l037","ordinal":111893,"en":"From the khan of the khagan's people"},{"id":"semetey-1-2013:p0459:b005:l038","ordinal":111894,"en":"Those bold men had willingly come,"},{"id":"semetey-1-2013:p0459:b005:l039","ordinal":111895,"en":"Warriors with cast-iron heads,"},{"id":"semetey-1-2013:p0460:b003:l001","ordinal":111896,"en":"Clad in mail of iron cords,"},{"id":"semetey-1-2013:p0460:b003:l002","ordinal":111897,"en":"Those Kozkaman had brought"},{"id":"semetey-1-2013:p0460:b003:l003","ordinal":111898,"en":"Were all dagger-handed warriors."},{"id":"semetey-1-2013:p0460:b003:l004","ordinal":111899,"en":"“You experts who strike with iron maces,"},{"id":"semetey-1-2013:p0460:b003:l005","ordinal":111900,"en":"You skilled wielders of swords,"},{"id":"semetey-1-2013:p0460:b003:l006","ordinal":111901,"en":"You fine drawers of bows,"},{"id":"semetey-1-2013:p0460:b003:l007","ordinal":111902,"en":"Champions come from Beezhin,"},{"id":"semetey-1-2013:p0460:b003:l008","ordinal":111903,"en":"Now that God has delivered this fool,"},{"id":"semetey-1-2013:p0460:b003:l009","ordinal":111904,"en":"Spare him nothing, mighty heroes!”"},{"id":"semetey-1-2013:p0460:b003:l010","ordinal":111905,"en":"His bold men took their swords."},{"id":"semetey-1-2013:p0460:b003:l011","ordinal":111906,"en":"Once formidable Kozkaman had spoken,"},{"id":"semetey-1-2013:p0460:b003:l012","ordinal":111907,"en":"Were they fools to hesitate?"},{"id":"semetey-1-2013:p0460:b003:l013","ordinal":111908,"en":"Chattering away in Kalmyk,"},{"id":"semetey-1-2013:p0460:b003:l014","ordinal":111909,"en":"Praying to their idol,"},{"id":"semetey-1-2013:p0460:b003:l015","ordinal":111910,"en":"Kozkaman and Kokchokoz—"},{"id":"semetey-1-2013:p0460:b003:l016","ordinal":111911,"en":"The six hundred they had brought—"},{"id":"semetey-1-2013:p0460:b003:l017","ordinal":111912,"en":"Were all outstanding champions."},{"id":"semetey-1-2013:p0460:b003:l018","ordinal":111913,"en":"Against drunken, wolf-like Manas,"},{"id":"semetey-1-2013:p0460:b003:l019","ordinal":111914,"en":"They readied their swords."},{"id":"semetey-1-2013:p0460:b003:l020","ordinal":111915,"en":"“The opportunity has come twice!” they said,"},{"id":"semetey-1-2013:p0460:b003:l021","ordinal":111916,"en":"And upon your father, now gone to Judgment,"},{"id":"semetey-1-2013:p0460:b003:l022","ordinal":111917,"en":"They all fell together."},{"id":"semetey-1-2013:p0460:b003:l023","ordinal":111918,"en":"Kokchokoz and Kozkaman"},{"id":"semetey-1-2013:p0460:b003:l024","ordinal":111919,"en":"Took their swords in hand,"},{"id":"semetey-1-2013:p0460:b003:l025","ordinal":111920,"en":"And all the champions"},{"id":"semetey-1-2013:p0460:b003:l026","ordinal":111921,"en":"They openly urged onward:"},{"id":"semetey-1-2013:p0460:b003:l027","ordinal":111922,"en":"“You skilled spearmen,"},{"id":"semetey-1-2013:p0460:b003:l028","ordinal":111923,"en":"You mighty sword-strikers,"},{"id":"semetey-1-2013:p0460:b003:l029","ordinal":111924,"en":"This fool Manas, this slave,"},{"id":"semetey-1-2013:p0460:b003:l030","ordinal":111925,"en":"We have plainly set his misery boiling."},{"id":"semetey-1-2013:p0460:b003:l031","ordinal":111926,"en":"Acting with cunning,"},{"id":"semetey-1-2013:p0460:b003:l032","ordinal":111927,"en":"Pouring spirits and giving poison,"},{"id":"semetey-1-2013:p0460:b003:l033","ordinal":111928,"en":"We have had both his hands bound."},{"id":"semetey-1-2013:p0460:b003:l034","ordinal":111929,"en":"Champions come from Beezhin,"},{"id":"semetey-1-2013:p0460:b003:l035","ordinal":111930,"en":"Renowned, wolf-like Manas—"},{"id":"semetey-1-2013:p0460:b003:l036","ordinal":111931,"en":"The time has come to take him."},{"id":"semetey-1-2013:p0460:b003:l037","ordinal":111932,"en":"Surround him and seize him,"},{"id":"semetey-1-2013:p0460:b003:l038","ordinal":111933,"en":"Slaughter him as a sacrifice,"},{"id":"semetey-1-2013:p0460:b003:l039","ordinal":111934,"en":"Drag his body along,"},{"id":"semetey-1-2013:p0460:b004:l001","ordinal":111935,"en":"Have the great hounds tear him apart!"},{"id":"semetey-1-2013:p0460:b004:l002","ordinal":111936,"en":"Cut off his head and fasten it to you,"},{"id":"semetey-1-2013:p0460:b004:l003","ordinal":111937,"en":"To Karykan of Kakan,"},{"id":"semetey-1-2013:p0460:b004:l004","ordinal":111938,"en":"Go bearing the glad tidings."},{"id":"semetey-1-2013:p0460:b004:l005","ordinal":111939,"en":"The golden throne of Chyn-Beezhin"},{"id":"semetey-1-2013:p0460:b004:l006","ordinal":111940,"en":"Take as your reward for the news!"},{"id":"semetey-1-2013:p0460:b004:l007","ordinal":111941,"en":"If you go with his severed head,"},{"id":"semetey-1-2013:p0460:b004:l008","ordinal":111942,"en":"Karykan, khan of Beezhin,"},{"id":"semetey-1-2013:p0460:b004:l009","ordinal":111943,"en":"Will spare nothing he possesses."},{"id":"semetey-1-2013:p0460:b004:l010","ordinal":111944,"en":"Of the yellow willows he had planted,"},{"id":"semetey-1-2013:p0460:b004:l011","ordinal":111945,"en":"Karykan will give you his grove."},{"id":"semetey-1-2013:p0460:b004:l012","ordinal":111946,"en":"Made of pure gold,"},{"id":"semetey-1-2013:p0460:b004:l013","ordinal":111947,"en":"Karykan will give you his throne."},{"id":"semetey-1-2013:p0460:b004:l014","ordinal":111948,"en":"The center of forty tribes,"},{"id":"semetey-1-2013:p0460:b004:l015","ordinal":111949,"en":"Karykan will give you his city."},{"id":"semetey-1-2013:p0460:b004:l016","ordinal":111950,"en":"He will have his golden crown put on you,"},{"id":"semetey-1-2013:p0460:b004:l017","ordinal":111951,"en":"Seat you on the golden throne."},{"id":"semetey-1-2013:p0460:b004:l018","ordinal":111952,"en":"Those were the words Karykan sent:"},{"id":"semetey-1-2013:p0460:b004:l019","ordinal":111953,"en":"‘Manas in Talas,"},{"id":"semetey-1-2013:p0460:b004:l020","ordinal":111954,"en":"Kill him by whatever means,’ he said."},{"id":"semetey-1-2013:p0460:b004:l021","ordinal":111955,"en":"He reckoned the days,"},{"id":"semetey-1-2013:p0460:b004:l022","ordinal":111956,"en":"Set the days down in writing,"},{"id":"semetey-1-2013:p0460:b004:l023","ordinal":111957,"en":"He reckoned the months,"},{"id":"semetey-1-2013:p0460:b004:l024","ordinal":111958,"en":"Set the months down in writing."},{"id":"semetey-1-2013:p0460:b004:l025","ordinal":111959,"en":"With Karykan, khan of Beezhin,"},{"id":"semetey-1-2013:p0460:b004:l026","ordinal":111960,"en":"We had an agreement."},{"id":"semetey-1-2013:p0460:b004:l027","ordinal":111961,"en":"This fool as huge as Opol-Too,"},{"id":"semetey-1-2013:p0460:b004:l028","ordinal":111962,"en":"The devil has driven him here."},{"id":"semetey-1-2013:p0460:b004:l029","ordinal":111963,"en":"Take heed, champions:"},{"id":"semetey-1-2013:p0460:b004:l030","ordinal":111964,"en":"The deity has granted him to us."},{"id":"semetey-1-2013:p0460:b004:l031","ordinal":111965,"en":"If we take the Buruts' Manas,"},{"id":"semetey-1-2013:p0460:b004:l032","ordinal":111966,"en":"We shall crush them from above,"},{"id":"semetey-1-2013:p0460:b004:l033","ordinal":111967,"en":"Scatter their four kinds of livestock."},{"id":"semetey-1-2013:p0460:b004:l034","ordinal":111968,"en":"These people who have struck at your heads,"},{"id":"semetey-1-2013:p0460:b004:l035","ordinal":111969,"en":"We shall open their eyes wide!"},{"id":"semetey-1-2013:p0460:b004:l036","ordinal":111970,"en":"Raiding and driving off their mares,"},{"id":"semetey-1-2013:p0460:b004:l037","ordinal":111971,"en":"Killing their giant Manas,"},{"id":"semetey-1-2013:p0460:b004:l038","ordinal":111972,"en":"If the Kyrgyz come near,"},{"id":"semetey-1-2013:p0460:b004:l039","ordinal":111973,"en":"Smashing their brains and scattering them,"},{"id":"semetey-1-2013:p0461:b003:l001","ordinal":111974,"en":"Let us bring upon this people"},{"id":"semetey-1-2013:p0461:b003:l002","ordinal":111975,"en":"Retribution for long ago."},{"id":"semetey-1-2013:p0461:b003:l003","ordinal":111976,"en":"Let us seize their Manas and crush him,"},{"id":"semetey-1-2013:p0461:b003:l004","ordinal":111977,"en":"Of these Kyrgyz here,"},{"id":"semetey-1-2013:p0461:b003:l005","ordinal":111978,"en":"Let us scatter the treasure."},{"id":"semetey-1-2013:p0461:b003:l006","ordinal":111979,"en":"Like one oppressed by an evil spirit,"},{"id":"semetey-1-2013:p0461:b003:l007","ordinal":111980,"en":"Let us open their eyes wide."},{"id":"semetey-1-2013:p0461:b003:l008","ordinal":111981,"en":"Let us plunder their valuables,"},{"id":"semetey-1-2013:p0461:b003:l009","ordinal":111982,"en":"Among these Kyrgyz"},{"id":"semetey-1-2013:p0461:b003:l010","ordinal":111983,"en":"Let us bring such ruin."},{"id":"semetey-1-2013:p0461:b003:l011","ordinal":111984,"en":"Lord Manas, their peerless steed—"},{"id":"semetey-1-2013:p0461:b003:l012","ordinal":111985,"en":"The chance has come: let us cleave him."},{"id":"semetey-1-2013:p0461:b003:l013","ordinal":111986,"en":"That dusky beauty,"},{"id":"semetey-1-2013:p0461:b003:l014","ordinal":111987,"en":"The radiant one among Muslims,"},{"id":"semetey-1-2013:p0461:b003:l015","ordinal":111988,"en":"That woman Kanykei,"},{"id":"semetey-1-2013:p0461:b003:l016","ordinal":111989,"en":"Let us seize her as booty."},{"id":"semetey-1-2013:p0461:b003:l017","ordinal":111990,"en":"Their Almambet and Chubak,"},{"id":"semetey-1-2013:p0461:b003:l018","ordinal":111991,"en":"Let us slaughter them as sacrifices."},{"id":"semetey-1-2013:p0461:b003:l019","ordinal":111992,"en":"The two khans, Azhybai and Bakai,"},{"id":"semetey-1-2013:p0461:b003:l020","ordinal":111993,"en":"Let us bind them alive and take them to Kakan"},{"id":"semetey-1-2013:p0461:b003:l021","ordinal":111994,"en":"As our captives."},{"id":"semetey-1-2013:p0461:b003:l022","ordinal":111995,"en":"Make them herd Kakan's cattle;"},{"id":"semetey-1-2013:p0461:b003:l023","ordinal":111996,"en":"Let us avenge our ancient grudge."},{"id":"semetey-1-2013:p0461:b003:l024","ordinal":111997,"en":"Let us slaughter their forty choros,"},{"id":"semetey-1-2013:p0461:b003:l025","ordinal":111998,"en":"Those damned Buruts'"},{"id":"semetey-1-2013:p0461:b003:l026","ordinal":111999,"en":"Daughters let us seize as booty."},{"id":"semetey-1-2013:p0461:b003:l027","ordinal":112000,"en":"Let us kill their lions,"},{"id":"semetey-1-2013:p0461:b003:l028","ordinal":112001,"en":"Let us break these Kyrgyz people's backs."},{"id":"semetey-1-2013:p0461:b003:l030","ordinal":112002,"en":"Let us uproot their royal encampments."},{"id":"semetey-1-2013:p0461:b003:l031","ordinal":112003,"en":"Twelve tumens, countless beasts,"},{"id":"semetey-1-2013:p0461:b003:l032","ordinal":112004,"en":"Let us drive them all to Beezhin,"},{"id":"semetey-1-2013:p0461:b003:l033","ordinal":112005,"en":"And glut ourselves on plunder."},{"id":"semetey-1-2013:p0461:b003:l034","ordinal":112006,"en":"Upon this people, these Kyrgyz,"},{"id":"semetey-1-2013:p0461:b003:l035","ordinal":112007,"en":"Let us unleash a tumult,"},{"id":"semetey-1-2013:p0461:b003:l036","ordinal":112008,"en":"Their women in white headscarves"},{"id":"semetey-1-2013:p0461:b003:l037","ordinal":112009,"en":"Let us leave in mourning."},{"id":"semetey-1-2013:p0461:b003:l038","ordinal":112010,"en":"Let us do as we please;"},{"id":"semetey-1-2013:p0461:b003:l039","ordinal":112011,"en":"Anyone who might rise above us,"},{"id":"semetey-1-2013:p0461:b004:l001","ordinal":112012,"en":"Let us slaughter without leaving one."},{"id":"semetey-1-2013:p0461:b004:l002","ordinal":112013,"en":"When Manas goes, their backbone goes;"},{"id":"semetey-1-2013:p0461:b004:l003","ordinal":112014,"en":"From among these Kyrgyz,"},{"id":"semetey-1-2013:p0461:b004:l004","ordinal":112015,"en":"Their dark, wolf-like lion goes."},{"id":"semetey-1-2013:p0461:b004:l005","ordinal":112016,"en":"Into the barrel holding spirits,"},{"id":"semetey-1-2013:p0461:b004:l006","ordinal":112017,"en":"Let us bring this Manas to his end."},{"id":"semetey-1-2013:p0461:b004:l007","ordinal":112018,"en":"Make herdsmen masters of it:"},{"id":"semetey-1-2013:p0461:b004:l008","ordinal":112019,"en":"This Talas here—"},{"id":"semetey-1-2013:p0461:b004:l009","ordinal":112020,"en":"The time has come to slaughter it."},{"id":"semetey-1-2013:p0461:b004:l010","ordinal":112021,"en":"Champions come from Beezhin,"},{"id":"semetey-1-2013:p0461:b004:l011","ordinal":112022,"en":"Unless you are truly curs,"},{"id":"semetey-1-2013:p0461:b004:l012","ordinal":112023,"en":"Zhakyp's only son Manas—"},{"id":"semetey-1-2013:p0461:b004:l013","ordinal":112024,"en":"Your aching grievance has been relieved."},{"id":"semetey-1-2013:p0461:b004:l014","ordinal":112025,"en":"Since your deity has granted your wish,"},{"id":"semetey-1-2013:p0461:b004:l015","ordinal":112026,"en":"Your eyes have opened wide."},{"id":"semetey-1-2013:p0461:b004:l016","ordinal":112027,"en":"Your furrowed brows have smoothed."},{"id":"semetey-1-2013:p0461:b004:l017","ordinal":112028,"en":"Charge in earnest, champions!"},{"id":"semetey-1-2013:p0461:b004:l018","ordinal":112029,"en":"Now the Kyrgyz have lost their khan."},{"id":"semetey-1-2013:p0461:b004:l019","ordinal":112030,"en":"Pull out their supporting pillar;"},{"id":"semetey-1-2013:p0461:b004:l020","ordinal":112031,"en":"Now bring them to their end."},{"id":"semetey-1-2013:p0461:b004:l021","ordinal":112032,"en":"Your honor has thus been restored,"},{"id":"semetey-1-2013:p0461:b004:l022","ordinal":112033,"en":"Champions come from afar."},{"id":"semetey-1-2013:p0461:b004:l023","ordinal":112034,"en":"Foolish Manas is drunk:"},{"id":"semetey-1-2013:p0461:b004:l024","ordinal":112035,"en":"You have found plenty to amuse yourselves with!”"},{"id":"semetey-1-2013:p0461:b004:l025","ordinal":112036,"en":"Kozkaman and Kokchokoz"},{"id":"semetey-1-2013:p0461:b004:l026","ordinal":112037,"en":"Went on saying much more."},{"id":"semetey-1-2013:p0461:b004:l027","ordinal":112038,"en":"When they heard these words,"},{"id":"semetey-1-2013:p0461:b004:l028","ordinal":112039,"en":"All swarmed forward to attack,"},{"id":"semetey-1-2013:p0461:b004:l029","ordinal":112040,"en":"Falling upon Manas."},{"id":"semetey-1-2013:p0461:b004:l030","ordinal":112041,"en":"God had struck the champion."},{"id":"semetey-1-2013:p0461:b004:l031","ordinal":112042,"en":"Once their khan had given the order,"},{"id":"semetey-1-2013:p0461:b004:l032","ordinal":112043,"en":"Would the mass of champions stand still?"},{"id":"semetey-1-2013:p0461:b004:l033","ordinal":112044,"en":"Not one showed Manas any regard."},{"id":"semetey-1-2013:p0461:b004:l034","ordinal":112045,"en":"Could God strike a man down like this?"},{"id":"semetey-1-2013:p0461:b004:l035","ordinal":112046,"en":"Kokchokoz's nine sons"},{"id":"semetey-1-2013:p0461:b004:l036","ordinal":112047,"en":"Now openly took their swords."},{"id":"semetey-1-2013:p0461:b004:l037","ordinal":112048,"en":"Kozkaman's nine sons,"},{"id":"semetey-1-2013:p0461:b004:l038","ordinal":112049,"en":"Great champions who struck with iron maces,"},{"id":"semetey-1-2013:p0461:b004:l039","ordinal":112050,"en":"Now all swarmed forward together."},{"id":"semetey-1-2013:p0462:b003:l001","ordinal":112051,"en":"Zheltiybes's nine sons,"},{"id":"semetey-1-2013:p0462:b003:l002","ordinal":112052,"en":"Hearing Zhetigin's words,"},{"id":"semetey-1-2013:p0462:b003:l003","ordinal":112053,"en":"Now rushed forward and swarmed over him."},{"id":"semetey-1-2013:p0462:b003:l004","ordinal":112054,"en":"Zheldeiboz's nine sons,"},{"id":"semetey-1-2013:p0462:b003:l005","ordinal":112055,"en":"Skilled strikers with swords,"},{"id":"semetey-1-2013:p0462:b003:l006","ordinal":112056,"en":"Your formidable, wolf-like father—"},{"id":"semetey-1-2013:p0462:b003:l007","ordinal":112057,"en":"As though to cut off his head at once,"},{"id":"semetey-1-2013:p0462:b003:l008","ordinal":112058,"en":"And now came swarming near."},{"id":"semetey-1-2013:p0462:b003:l009","ordinal":112059,"en":"The skilled spearmen"},{"id":"semetey-1-2013:p0462:b003:l010","ordinal":112060,"en":"Took spears and made ready."},{"id":"semetey-1-2013:p0462:b003:l011","ordinal":112061,"en":"Over your lion father,"},{"id":"semetey-1-2013:p0462:b003:l012","ordinal":112062,"en":"The swordsmen swarmed,"},{"id":"semetey-1-2013:p0462:b003:l013","ordinal":112063,"en":"To seize your father,"},{"id":"semetey-1-2013:p0462:b003:l014","ordinal":112064,"en":"To slaughter him as a sacrifice."},{"id":"semetey-1-2013:p0462:b003:l016","ordinal":112065,"en":"Many of them swarmed upon him.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0462:b003:l017","ordinal":112066,"en":"Kozkaman shouted,"},{"id":"semetey-1-2013:p0462:b003:l018","ordinal":112067,"en":"Raising his battle cry in Kalmyk."},{"id":"semetey-1-2013:p0462:b003:l019","ordinal":112068,"en":"His mace-bearing champions"},{"id":"semetey-1-2013:p0462:b003:l020","ordinal":112069,"en":"All swarmed upon your father together."},{"id":"semetey-1-2013:p0462:b003:l021","ordinal":112070,"en":"When the Chinese rushed upon him,"},{"id":"semetey-1-2013:p0462:b003:l022","ordinal":112071,"en":"When swords were about to reach his head,"},{"id":"semetey-1-2013:p0462:b003:l023","ordinal":112072,"en":"Your father Manas was a lion."},{"id":"semetey-1-2013:p0462:b003:l024","ordinal":112073,"en":"A soul like your father"},{"id":"semetey-1-2013:p0462:b003:l025","ordinal":112074,"en":"The one God would never create again."},{"id":"semetey-1-2013:p0462:b003:l026","ordinal":112075,"en":"A dark-spotted leopard"},{"id":"semetey-1-2013:p0462:b003:l027","ordinal":112076,"en":"Raged at your father's flank;"},{"id":"semetey-1-2013:p0462:b003:l028","ordinal":112077,"en":"A short-tailed, fierce lion"},{"id":"semetey-1-2013:p0462:b003:l029","ordinal":112078,"en":"Stood ready before your father."},{"id":"semetey-1-2013:p0462:b003:l030","ordinal":112079,"en":"When it took its place before him,"},{"id":"semetey-1-2013:p0462:b003:l031","ordinal":112080,"en":"He assumed the aspect of a white tiger."},{"id":"semetey-1-2013:p0462:b003:l032","ordinal":112081,"en":"Your father's looming figure"},{"id":"semetey-1-2013:p0462:b003:l033","ordinal":112082,"en":"Was fearsome as a thousand men."},{"id":"semetey-1-2013:p0462:b003:l034","ordinal":112083,"en":"The Chinese champions who saw him"},{"id":"semetey-1-2013:p0462:b003:l035","ordinal":112084,"en":"Were sorely shaken."},{"id":"semetey-1-2013:p0462:b003:l036","ordinal":112085,"en":"In the champions' eyes,"},{"id":"semetey-1-2013:p0462:b003:l037","ordinal":112086,"en":"Your father appeared a lion."},{"id":"semetey-1-2013:p0462:b003:l038","ordinal":112087,"en":"His face shone like oiled wheat;"},{"id":"semetey-1-2013:p0462:b003:l039","ordinal":112088,"en":"He loomed like dusky mist."},{"id":"semetey-1-2013:p0462:b004:l001","ordinal":112089,"en":"Both a hero and a lion,"},{"id":"semetey-1-2013:p0462:b004:l002","ordinal":112090,"en":"Your father they could not bear to approach;"},{"id":"semetey-1-2013:p0462:b004:l003","ordinal":112091,"en":"There they were thrown into confusion."},{"id":"semetey-1-2013:p0462:b004:l004","ordinal":112092,"en":"When your father closed his eyes,"},{"id":"semetey-1-2013:p0462:b004:l005","ordinal":112093,"en":"The Chinese surrounded and beset him,"},{"id":"semetey-1-2013:p0462:b004:l006","ordinal":112094,"en":"Skillful horsemen, swift runners on foot,"},{"id":"semetey-1-2013:p0462:b004:l007","ordinal":112095,"en":"All the champions,"},{"id":"semetey-1-2013:p0462:b004:l008","ordinal":112096,"en":"Kokchokoz and Kozkaman,"},{"id":"semetey-1-2013:p0462:b004:l009","ordinal":112097,"en":"Of the unbelievers come from Beezhin,"},{"id":"semetey-1-2013:p0462:b004:l010","ordinal":112098,"en":"The crafty elders—"},{"id":"semetey-1-2013:p0462:b004:l011","ordinal":112099,"en":"Upon your father"},{"id":"semetey-1-2013:p0462:b004:l012","ordinal":112100,"en":"All these men swarmed."},{"id":"semetey-1-2013:p0462:b004:l013","ordinal":112101,"en":"When the Chinese rushed upon him,"},{"id":"semetey-1-2013:p0462:b004:l014","ordinal":112102,"en":"His wits failed, his strength ebbed."},{"id":"semetey-1-2013:p0462:b004:l015","ordinal":112103,"en":"When the Chinese came near to strike,"},{"id":"semetey-1-2013:p0462:b004:l016","ordinal":112104,"en":"When they truly found their chance,"},{"id":"semetey-1-2013:p0462:b004:l017","ordinal":112105,"en":"Begging the Chinese for mercy,"},{"id":"semetey-1-2013:p0462:b004:l018","ordinal":112106,"en":"Your father, truly a sultan,"},{"id":"semetey-1-2013:p0462:b004:l019","ordinal":112107,"en":"Took the sacred gray belt with its pouches"},{"id":"semetey-1-2013:p0462:b004:l020","ordinal":112108,"en":"And fitted it about his neck."},{"id":"semetey-1-2013:p0462:b004:l021","ordinal":112109,"en":"“Creator, grant me faith!” he cried,"},{"id":"semetey-1-2013:p0462:b004:l022","ordinal":112110,"en":"And prayed to the one God."},{"id":"semetey-1-2013:p0462:b004:l023","ordinal":112111,"en":"When your father opened his eyes,"},{"id":"semetey-1-2013:p0462:b004:l024","ordinal":112112,"en":"The champions who had gone to strike"},{"id":"semetey-1-2013:p0462:b004:l025","ordinal":112113,"en":"All fled together."},{"id":"semetey-1-2013:p0462:b004:l026","ordinal":112114,"en":"When your father's eyes closed,"},{"id":"semetey-1-2013:p0462:b004:l027","ordinal":112115,"en":"With beaded hat-finials and coral stones,"},{"id":"semetey-1-2013:p0462:b004:l028","ordinal":112116,"en":"With that swine Kozkaman among them,"},{"id":"semetey-1-2013:p0462:b004:l029","ordinal":112117,"en":"They brandished their broad axes,"},{"id":"semetey-1-2013:p0462:b004:l030","ordinal":112118,"en":"Held out their swords,"},{"id":"semetey-1-2013:p0462:b004:l031","ordinal":112119,"en":"Raised their clubs,"},{"id":"semetey-1-2013:p0462:b004:l032","ordinal":112120,"en":"Thrust their spears aloft."},{"id":"semetey-1-2013:p0462:b004:l033","ordinal":112121,"en":"When your father's eyes closed,"},{"id":"semetey-1-2013:p0462:b004:l034","ordinal":112122,"en":"They advanced, making ready."},{"id":"semetey-1-2013:p0462:b004:l035","ordinal":112123,"en":"When your father's eyes opened,"},{"id":"semetey-1-2013:p0462:b004:l036","ordinal":112124,"en":"Unable to endure his heat,"},{"id":"semetey-1-2013:p0462:b004:l037","ordinal":112125,"en":"Unable to abide his cold,"},{"id":"semetey-1-2013:p0462:b004:l038","ordinal":112126,"en":"They all fled together."},{"id":"semetey-1-2013:p0462:b004:l039","ordinal":112127,"en":"Tirelessly they kept him surrounded,"},{"id":"semetey-1-2013:p0463:b003:l001","ordinal":112128,"en":"Unable to slaughter him as a sacrifice,"}]
