[{"id":"manas-2010:p0406:b001:l031","ordinal":18689,"en":"I fought mounted contests;"},{"id":"manas-2010:p0406:b001:l032","ordinal":18690,"en":"For sixty days I fought."},{"id":"manas-2010:p0406:b001:l033","ordinal":18691,"en":"Where, then, is my death?"},{"id":"manas-2010:p0406:b001:l034","ordinal":18692,"en":"Where is death's arrival for me?!"},{"id":"manas-2010:p0406:b001:l035","ordinal":18693,"en":"Leaving their village headmen looming,"},{"id":"manas-2010:p0406:b001:l036","ordinal":18694,"en":"Leaving their messengers standing helpless,"},{"id":"manas-2010:p0406:b001:l037","ordinal":18695,"en":"I worked many marvels;"},{"id":"manas-2010:p0406:b001:l038","ordinal":18696,"en":"I slaughtered many of them."},{"id":"manas-2010:p0406:b001:l039","ordinal":18697,"en":"Drinking blood, I grew hardened;"},{"id":"manas-2010:p0406:b001:l040","ordinal":18698,"en":"Among the seething Kytay"},{"id":"manas-2010:p0406:b001:l041","ordinal":18699,"en":"I gained the name of bloodstained Burut."},{"id":"manas-2010:p0406:b001:l042","ordinal":18700,"en":"When fate comes, I shall die;"},{"id":"manas-2010:p0406:b001:l043","ordinal":18701,"en":"Before fate arrives, before my days end,"},{"id":"manas-2010:p0406:b001:l044","ordinal":18702,"en":"How can I submit to oppression?"},{"id":"manas-2010:p0406:b001:l045","ordinal":18703,"en":"A warrior of the world, a mortal soul,"},{"id":"manas-2010:p0406:b001:l046","ordinal":18704,"en":"Just because the Kytay have swarmed upon us,"},{"id":"manas-2010:p0406:b001:l047","ordinal":18705,"en":"How can I lose my wits?"},{"id":"manas-2010:p0406:b001:l048","ordinal":18706,"en":"Elder Baltay, leopard,"},{"id":"manas-2010:p0407:b001:l001","ordinal":18707,"en":"How can I flee stumbling away?"},{"id":"manas-2010:p0407:b001:l002","ordinal":18708,"en":"If the Kakan comes swarming,"},{"id":"manas-2010:p0407:b001:l003","ordinal":18709,"en":"I shall try grappling with him!"},{"id":"manas-2010:p0407:b001:l004","ordinal":18710,"en":"I shall sit astride my horse;"},{"id":"manas-2010:p0407:b001:l005","ordinal":18711,"en":"Against the seething Kytay"},{"id":"manas-2010:p0407:b001:l006","ordinal":18712,"en":"I shall charge alone!"},{"id":"manas-2010:p0407:b001:l007","ordinal":18713,"en":"I shall gird my strong waist;"},{"id":"manas-2010:p0407:b001:l008","ordinal":18714,"en":"Into the Kytay covering the earth"},{"id":"manas-2010:p0407:b001:l009","ordinal":18715,"en":"I shall plunge and attack alone!"},{"id":"manas-2010:p0407:b001:l010","ordinal":18716,"en":"The seething Kytay,"},{"id":"manas-2010:p0407:b001:l011","ordinal":18717,"en":"The attacking Kalmyks and Manchus,"},{"id":"manas-2010:p0407:b001:l012","ordinal":18718,"en":"Have sorely provoked my anger."},{"id":"manas-2010:p0407:b001:l013","ordinal":18719,"en":"Unless I drive them back to the Kakan—"},{"id":"manas-2010:p0407:b001:l014","ordinal":18720,"en":"Those over-eager Kytay,"},{"id":"manas-2010:p0407:b001:l015","ordinal":18721,"en":"I shall drive them all the way to Beejin!"},{"id":"manas-2010:p0407:b001:l016","ordinal":18722,"en":"Only death will stop me;"},{"id":"manas-2010:p0407:b001:l017","ordinal":18723,"en":"Against those seething unbelievers"},{"id":"manas-2010:p0407:b001:l018","ordinal":18724,"en":"I shall fight alone without fleeing!"},{"id":"manas-2010:p0407:b001:l019","ordinal":18725,"en":"Akbaltay, heroic elder,"},{"id":"manas-2010:p0407:b001:l020","ordinal":18726,"en":"Go calmly to your migrating camp."},{"id":"manas-2010:p0407:b001:l021","ordinal":18727,"en":"Continue your migration without haste;"},{"id":"manas-2010:p0407:b001:l022","ordinal":18728,"en":"Of your warrior son Manas,"},{"id":"manas-2010:p0407:b001:l023","ordinal":18729,"en":"Seek news after five months!"},{"id":"manas-2010:p0407:b001:l024","ordinal":18730,"en":"If I remain away past the fifth month,"},{"id":"manas-2010:p0407:b001:l025","ordinal":18731,"en":"Scatter your countless livestock and go;"},{"id":"manas-2010:p0407:b001:l026","ordinal":18732,"en":"'Manas died in combat,' say,"},{"id":"manas-2010:p0407:b001:l027","ordinal":18733,"en":"And flee ahead, each on his way."},{"id":"manas-2010:p0407:b001:l028","ordinal":18734,"en":"Pass through the city of Küzgü;"},{"id":"manas-2010:p0407:b001:l029","ordinal":18735,"en":"If I remain away past the fifth month,"},{"id":"manas-2010:p0407:b001:l030","ordinal":18736,"en":"'The warrior Manas is dead,' say,"},{"id":"manas-2010:p0407:b001:l031","ordinal":18737,"en":"And abandon all hope of me!"},{"id":"manas-2010:p0407:b001:l032","ordinal":18738,"en":"From the saddle-shaped ridge,"},{"id":"manas-2010:p0407:b001:l033","ordinal":18739,"en":"Move your camp downhill and halt."},{"id":"manas-2010:p0407:b001:l034","ordinal":18740,"en":"'Manas, our companion, is dead,' say,"},{"id":"manas-2010:p0407:b001:l035","ordinal":18741,"en":"And lament me, weeping and sobbing!"},{"id":"manas-2010:p0407:b001:l036","ordinal":18742,"en":"If death comes, I shall die;"},{"id":"manas-2010:p0407:b001:l037","ordinal":18743,"en":"I shall see the face of the other world."},{"id":"manas-2010:p0407:b001:l038","ordinal":18744,"en":"Before death comes, before my days end,"},{"id":"manas-2010:p0407:b001:l039","ordinal":18745,"en":"If my precious head remains unharmed,"},{"id":"manas-2010:p0407:b001:l040","ordinal":18746,"en":"With the seething Kytay unbelievers"},{"id":"manas-2010:p0407:b001:l041","ordinal":18747,"en":"I shall try crossing weapons!"},{"id":"manas-2010:p0407:b001:l042","ordinal":18748,"en":"Against the Kalmyks advancing in strength,"},{"id":"manas-2010:p0407:b001:l043","ordinal":18749,"en":"How can I refrain from wrestling?"},{"id":"manas-2010:p0407:b001:l044","ordinal":18750,"en":"Without fighting and taking revenge,"},{"id":"manas-2010:p0407:b001:l045","ordinal":18751,"en":"How can I remain alive?"},{"id":"manas-2010:p0407:b001:l046","ordinal":18752,"en":"Of those hell-like Kytay,"},{"id":"manas-2010:p0407:b001:l047","ordinal":18753,"en":"Unless I learn their tumult,"},{"id":"manas-2010:p0407:b001:l048","ordinal":18754,"en":"Against the countless Manchus,"},{"id":"manas-2010:p0408:b001:l001","ordinal":18755,"en":"Unless I wage a tumultuous battle,"},{"id":"manas-2010:p0408:b001:l002","ordinal":18756,"en":"May I die rather than remain alive!"},{"id":"manas-2010:p0408:b001:l003","ordinal":18757,"en":"Rather than bow and yield to them,"},{"id":"manas-2010:p0408:b001:l004","ordinal":18758,"en":"May I sink away as though never born!”"},{"id":"manas-2010:p0408:b001:l005","ordinal":18759,"en":"Born with an exceptional destiny,"},{"id":"manas-2010:p0408:b001:l006","ordinal":18760,"en":"The lion Manas, supported by holy patrons,"},{"id":"manas-2010:p0408:b001:l007","ordinal":18761,"en":"Could not endure standing and watching;"},{"id":"manas-2010:p0408:b001:l008","ordinal":18762,"en":"His fury boiled over."},{"id":"manas-2010:p0408:b001:l009","ordinal":18763,"en":"His two jaws clattered,"},{"id":"manas-2010:p0408:b001:l010","ordinal":18764,"en":"He bit through his lip."},{"id":"manas-2010:p0408:b001:l011","ordinal":18765,"en":"Firmly blocking the governor's path,"},{"id":"manas-2010:p0408:b001:l012","ordinal":18766,"en":"As your bloodstained hero stood watching,"},{"id":"manas-2010:p0408:b001:l013","ordinal":18767,"en":"'Manas is alone, the Kytay a thousand;"},{"id":"manas-2010:p0408:b001:l014","ordinal":18768,"en":"What will become of the boy?' he thought."},{"id":"manas-2010:p0408:b001:l015","ordinal":18769,"en":"Akbaltay grieved,"},{"id":"manas-2010:p0408:b001:l016","ordinal":18770,"en":"His heart burned fiercely."},{"id":"manas-2010:p0408:b001:l017","ordinal":18771,"en":"Long renowned as the hero Baltay,"},{"id":"manas-2010:p0408:b001:l018","ordinal":18772,"en":"Akbaltay, who had endured humiliation,"},{"id":"manas-2010:p0408:b001:l019","ordinal":18773,"en":"His precious falcon-like eyes"},{"id":"manas-2010:p0408:b001:l020","ordinal":18774,"en":"Filled with tears without blinking."},{"id":"manas-2010:p0408:b001:l021","ordinal":18775,"en":"Drawing him aside, asking for words,"},{"id":"manas-2010:p0408:b001:l022","ordinal":18776,"en":"Akbaltay, at his wits' end,"},{"id":"manas-2010:p0408:b001:l023","ordinal":18777,"en":"Stood weeping and lamenting:"},{"id":"manas-2010:p0408:b001:l024","ordinal":18778,"en":"“He was renowned, he was our support;"},{"id":"manas-2010:p0408:b001:l025","ordinal":18779,"en":"Born superior to mortals,"},{"id":"manas-2010:p0408:b001:l026","ordinal":18780,"en":"The warrior Manas, the leopard,"},{"id":"manas-2010:p0408:b001:l027","ordinal":18781,"en":"Was a lion unlike mortal men."},{"id":"manas-2010:p0408:b001:l028","ordinal":18782,"en":"If you created him as your servant, God,"},{"id":"manas-2010:p0408:b001:l029","ordinal":18783,"en":"Keep Manas safe!"},{"id":"manas-2010:p0408:b001:l030","ordinal":18784,"en":"If you created him as a living soul, God,"},{"id":"manas-2010:p0408:b001:l031","ordinal":18785,"en":"Do not let the unbeliever triumph!"},{"id":"manas-2010:p0408:b001:l032","ordinal":18786,"en":"We Kyrgyz were but few;"},{"id":"manas-2010:p0408:b001:l033","ordinal":18787,"en":"You granted the generous one to our lot."},{"id":"manas-2010:p0408:b001:l034","ordinal":18788,"en":"Do not separate him from the Kyrgyz"},{"id":"manas-2010:p0408:b001:l035","ordinal":18789,"en":"By bringing death between us!"},{"id":"manas-2010:p0408:b001:l036","ordinal":18790,"en":"Grant him days to see his people;"},{"id":"manas-2010:p0408:b001:l037","ordinal":18791,"en":"If you created him as a living soul, God,"},{"id":"manas-2010:p0408:b001:l038","ordinal":18792,"en":"Keep my gray-maned hero safe!"},{"id":"manas-2010:p0408:b001:l039","ordinal":18793,"en":"When we came driven out and fleeing,"},{"id":"manas-2010:p0408:b001:l040","ordinal":18794,"en":"The lion Manas, my blessing,"},{"id":"manas-2010:p0408:b001:l041","ordinal":18795,"en":"Was born here in Altay."},{"id":"manas-2010:p0408:b001:l042","ordinal":18796,"en":"We, this people, burn from humiliation;"},{"id":"manas-2010:p0408:b001:l043","ordinal":18797,"en":"A scattered, destitute people,"},{"id":"manas-2010:p0408:b001:l044","ordinal":18798,"en":"Gray-maned Manas, our shelter,"},{"id":"manas-2010:p0408:b001:l045","ordinal":18799,"en":"We look to him for support!"},{"id":"manas-2010:p0408:b001:l046","ordinal":18800,"en":"Against the Manchus rushing in together,"},{"id":"manas-2010:p0408:b001:l047","ordinal":18801,"en":"My foal Manas, my only one,"},{"id":"manas-2010:p0408:b001:l048","ordinal":18802,"en":"You alone took up the burden."},{"id":"manas-2010:p0409:b001:l001","ordinal":18803,"en":"If death comes and your days end,"},{"id":"manas-2010:p0409:b001:l002","ordinal":18804,"en":"If you die at Kalmyk hands,"},{"id":"manas-2010:p0409:b001:l003","ordinal":18805,"en":"The forty households who came in exile,"},{"id":"manas-2010:p0409:b001:l004","ordinal":18806,"en":"You will have left your village desolate!"},{"id":"manas-2010:p0409:b001:l005","ordinal":18807,"en":"If my Manas remains safe,"},{"id":"manas-2010:p0409:b001:l006","ordinal":18808,"en":"We shall regain our inheritance;"},{"id":"manas-2010:p0409:b001:l007","ordinal":18809,"en":"Playing our games from camp to camp,"},{"id":"manas-2010:p0409:b001:l008","ordinal":18810,"en":"We shall migrate joyfully!"},{"id":"manas-2010:p0409:b001:l009","ordinal":18811,"en":"Put an end to all the Kalmyks,"},{"id":"manas-2010:p0409:b001:l010","ordinal":18812,"en":"Mighty Allah, the Creator;"},{"id":"manas-2010:p0409:b001:l011","ordinal":18813,"en":"God, keep the bloodstained hero safe!"},{"id":"manas-2010:p0409:b001:l012","ordinal":18814,"en":"My warrior Manas, my gray-maned one,"},{"id":"manas-2010:p0409:b001:l013","ordinal":18815,"en":"When you reached five years,"},{"id":"manas-2010:p0409:b001:l014","ordinal":18816,"en":"You became this people's banner!"},{"id":"manas-2010:p0409:b001:l015","ordinal":18817,"en":"When you reached eight,"},{"id":"manas-2010:p0409:b001:l016","ordinal":18818,"en":"You gathered forty boys together!"},{"id":"manas-2010:p0409:b001:l017","ordinal":18819,"en":"When you reached nine,"},{"id":"manas-2010:p0409:b001:l018","ordinal":18820,"en":"The black Kalmyks and Manchus'"},{"id":"manas-2010:p0409:b001:l019","ordinal":18821,"en":"Boys you gathered and grazed upon!"},{"id":"manas-2010:p0409:b001:l020","ordinal":18822,"en":"When you reached ten,"},{"id":"manas-2010:p0409:b001:l021","ordinal":18823,"en":"You began a great upheaval."},{"id":"manas-2010:p0409:b001:l022","ordinal":18824,"en":"When you reached twelve,"},{"id":"manas-2010:p0409:b001:l023","ordinal":18825,"en":"You broke the ordo and took booty."},{"id":"manas-2010:p0409:b001:l024","ordinal":18826,"en":"When you mounted your horse in might,"},{"id":"manas-2010:p0409:b001:l025","ordinal":18827,"en":"You attacked a mighty people!"},{"id":"manas-2010:p0409:b001:l026","ordinal":18828,"en":"Born to our fortune and grown great,"},{"id":"manas-2010:p0409:b001:l027","ordinal":18829,"en":"Khan Manas, no hero equals you."},{"id":"manas-2010:p0409:b001:l028","ordinal":18830,"en":"When the Kytay swarm upon you,"},{"id":"manas-2010:p0409:b001:l029","ordinal":18831,"en":"To become your support,"},{"id":"manas-2010:p0409:b001:l030","ordinal":18832,"en":"The Kyrgyz people are not here."},{"id":"manas-2010:p0409:b001:l031","ordinal":18833,"en":"You have no chosen ridge to flee to;"},{"id":"manas-2010:p0409:b001:l032","ordinal":18834,"en":"Facing the Kytay,"},{"id":"manas-2010:p0409:b001:l033","ordinal":18835,"en":"To stand as your support,"},{"id":"manas-2010:p0409:b001:l034","ordinal":18836,"en":"You have no warrior equal to you!"},{"id":"manas-2010:p0409:b001:l035","ordinal":18837,"en":"You have no saddle to lean down into;"},{"id":"manas-2010:p0409:b001:l036","ordinal":18838,"en":"If you should stoop and fall,"},{"id":"manas-2010:p0409:b001:l037","ordinal":18839,"en":"You have no nephew to hold as a companion!"},{"id":"manas-2010:p0409:b001:l038","ordinal":18840,"en":"Your gray-maned valor is beyond measure;"},{"id":"manas-2010:p0409:b001:l039","ordinal":18841,"en":"If you fight the Kytay long,"},{"id":"manas-2010:p0409:b001:l040","ordinal":18842,"en":"To stand openly as your support,"},{"id":"manas-2010:p0409:b001:l041","ordinal":18843,"en":"The Kyrgyz people are not here!"},{"id":"manas-2010:p0409:b001:l042","ordinal":18844,"en":"A lone horse cannot tread the cliff-path;"},{"id":"manas-2010:p0409:b001:l043","ordinal":18845,"en":"Creator, support him yourself:"},{"id":"manas-2010:p0409:b001:l044","ordinal":18846,"en":"My Manas was the only one from his nest."},{"id":"manas-2010:p0409:b001:l045","ordinal":18847,"en":"If the moon is darkened by cloud,"},{"id":"manas-2010:p0409:b001:l046","ordinal":18848,"en":"What will become of the night?"},{"id":"manas-2010:p0409:b001:l047","ordinal":18849,"en":"If you let him fall to the Kytay,"},{"id":"manas-2010:p0409:b001:l048","ordinal":18850,"en":"Your few Kyrgyz people,"},{"id":"manas-2010:p0410:b001:l001","ordinal":18851,"en":"What will become of their day?"},{"id":"manas-2010:p0410:b001:l002","ordinal":18852,"en":"To the Kytay of formidable strength,"},{"id":"manas-2010:p0410:b001:l003","ordinal":18853,"en":"If you let him fall, it will be disgrace."},{"id":"manas-2010:p0410:b001:l004","ordinal":18854,"en":"God, grant him strength;"},{"id":"manas-2010:p0410:b001:l005","ordinal":18855,"en":"My only-born gray-maned hero"},{"id":"manas-2010:p0410:b001:l006","ordinal":18856,"en":"Is entrusted to the one God!”"},{"id":"manas-2010:p0410:b001:l007","ordinal":18857,"en":"Spreading his palms, Akbaltay,"},{"id":"manas-2010:p0410:b001:l008","ordinal":18858,"en":"His heart torn apart,"},{"id":"manas-2010:p0410:b001:l009","ordinal":18859,"en":"'Against the seething unbelievers"},{"id":"manas-2010:p0410:b001:l010","ordinal":18860,"en":"My gray-maned hero remains alone,' he thought."},{"id":"manas-2010:p0410:b001:l011","ordinal":18861,"en":"Tears streamed from his eyes;"},{"id":"manas-2010:p0410:b001:l012","ordinal":18862,"en":"In the sky, Allah's sun was clouded."},{"id":"manas-2010:p0410:b001:l013","ordinal":18863,"en":"Upon Akbaltay's head"},{"id":"manas-2010:p0410:b001:l014","ordinal":18864,"en":"Sixty worries came at once!"},{"id":"manas-2010:p0410:b001:l015","ordinal":18865,"en":"“Amen!” they said, spreading their hands,"},{"id":"manas-2010:p0410:b001:l016","ordinal":18866,"en":"And turned the tulpar's head."},{"id":"manas-2010:p0410:b001:l017","ordinal":18867,"en":"As though parting for good,"},{"id":"manas-2010:p0410:b001:l018","ordinal":18868,"en":"With Manas holding the banner,"},{"id":"manas-2010:p0410:b001:l019","ordinal":18869,"en":"They stood clasping hands."},{"id":"manas-2010:p0410:b001:l020","ordinal":18870,"en":"Clasping his hand firmly,"},{"id":"manas-2010:p0410:b001:l021","ordinal":18871,"en":"Entrusting him to the Creator,"},{"id":"manas-2010:p0410:b001:l022","ordinal":18872,"en":"Akbaltay turned back"},{"id":"manas-2010:p0410:b001:l023","ordinal":18873,"en":"To rejoin the migrating camp."},{"id":"manas-2010:p0410:b001:l024","ordinal":18874,"en":"Your hero remained in that place"},{"id":"manas-2010:p0410:b001:l025","ordinal":18875,"en":"To wreak slaughter upon the Kytay."},{"id":"manas-2010:p0410:b001:l026","ordinal":18876,"en":"Youngest of the six lions,"},{"id":"manas-2010:p0410:b001:l027","ordinal":18877,"en":"Allah's beloved servant,"},{"id":"manas-2010:p0410:b001:l028","ordinal":18878,"en":"He turned Toruchaar's head."},{"id":"manas-2010:p0410:b001:l029","ordinal":18879,"en":"The forty chiltens and his Kutubiy—"},{"id":"manas-2010:p0410:b001:l030","ordinal":18880,"en":"The valiant Manas took them"},{"id":"manas-2010:p0410:b001:l031","ordinal":18881,"en":"As his strength and support."},{"id":"manas-2010:p0410:b001:l032","ordinal":18882,"en":"When he saw the great enemy host,"},{"id":"manas-2010:p0410:b001:l033","ordinal":18883,"en":"Manas surged in a frenzy,"},{"id":"manas-2010:p0410:b001:l034","ordinal":18884,"en":"Tearing about like one whose husband had died,"},{"id":"manas-2010:p0410:b001:l035","ordinal":18885,"en":"Looking to both sides,"},{"id":"manas-2010:p0410:b001:l036","ordinal":18886,"en":"Your falcon stood possessed,"},{"id":"manas-2010:p0410:b001:l037","ordinal":18887,"en":"Licking his lips like a hungry lion."},{"id":"manas-2010:p0410:b001:l038","ordinal":18888,"en":"Wrathful and straining,"},{"id":"manas-2010:p0410:b001:l039","ordinal":18889,"en":"Kutubiy, his support,"},{"id":"manas-2010:p0410:b001:l040","ordinal":18890,"en":"Held him there,"},{"id":"manas-2010:p0410:b001:l041","ordinal":18891,"en":"The leopard tugging to break free."},{"id":"manas-2010:p0410:b001:l042","ordinal":18892,"en":"Forty boys followed him,"},{"id":"manas-2010:p0410:b001:l043","ordinal":18893,"en":"Companions of your gray-maned hero;"},{"id":"manas-2010:p0410:b001:l044","ordinal":18894,"en":"The mightiest was Kutubiy."},{"id":"manas-2010:p0410:b001:l045","ordinal":18895,"en":"As your warrior stood upon the ridge,"},{"id":"manas-2010:p0410:b001:l046","ordinal":18896,"en":"At the spur where the mountain ended,"},{"id":"manas-2010:p0410:b001:l047","ordinal":18897,"en":"At the jutting promontory,"},{"id":"manas-2010:p0410:b001:l048","ordinal":18898,"en":"The earth split and dust rose."},{"id":"manas-2010:p0411:b001:l001","ordinal":18899,"en":"Beneath the banner, the great army's"},{"id":"manas-2010:p0411:b001:l002","ordinal":18900,"en":"Roar seemed to drive out the soul."},{"id":"manas-2010:p0411:b001:l003","ordinal":18901,"en":"Moving his great army forward,"},{"id":"manas-2010:p0411:b001:l004","ordinal":18902,"en":"With shawms deafening the ears,"},{"id":"manas-2010:p0411:b001:l005","ordinal":18903,"en":"The Manchus' Ezkara,"},{"id":"manas-2010:p0411:b001:l006","ordinal":18904,"en":"Their khan, came advancing."},{"id":"manas-2010:p0411:b001:l007","ordinal":18905,"en":"Khan Zholoy of the Kalmyks"},{"id":"manas-2010:p0411:b001:l008","ordinal":18906,"en":"Also came advancing."},{"id":"manas-2010:p0411:b001:l009","ordinal":18907,"en":"Dark, mottled Boroonchu,"},{"id":"manas-2010:p0411:b001:l010","ordinal":18908,"en":"He too came advancing."},{"id":"manas-2010:p0411:b001:l011","ordinal":18909,"en":"The giant Döödür, riding a rhinoceros,"},{"id":"manas-2010:p0411:b001:l012","ordinal":18910,"en":"Beating the rear of the army,"},{"id":"manas-2010:p0411:b001:l013","ordinal":18911,"en":"Came driving them forward."},{"id":"manas-2010:p0411:b001:l014","ordinal":18912,"en":"Dust flew in swirling clouds;"},{"id":"manas-2010:p0411:b001:l015","ordinal":18913,"en":"The countless troops thronged without turning."},{"id":"manas-2010:p0411:b001:l016","ordinal":18914,"en":"Through the foothills of great Altay,"},{"id":"manas-2010:p0411:b001:l017","ordinal":18915,"en":"He came driving them onward."},{"id":"manas-2010:p0411:b001:l018","ordinal":18916,"en":"Streaming along the edge,"},{"id":"manas-2010:p0411:b001:l019","ordinal":18917,"en":"Swaying shoulder to shoulder,"},{"id":"manas-2010:p0411:b001:l020","ordinal":18918,"en":"They came spreading into view."},{"id":"manas-2010:p0411:b001:l021","ordinal":18919,"en":"Those who would never retreat from a sword,"},{"id":"manas-2010:p0411:b001:l022","ordinal":18920,"en":"Their champions, were in the front;"},{"id":"manas-2010:p0411:b001:l023","ordinal":18921,"en":"Dressed alike to a hair,"},{"id":"manas-2010:p0411:b001:l024","ordinal":18922,"en":"Their mighty men held the flanks."},{"id":"manas-2010:p0411:b001:l025","ordinal":18923,"en":"Those skilled at striking with battle-axes,"},{"id":"manas-2010:p0411:b001:l026","ordinal":18924,"en":"Those with fearsomely pointed spears,"},{"id":"manas-2010:p0411:b001:l027","ordinal":18925,"en":"Those with fearsomely sharp swords,"},{"id":"manas-2010:p0411:b001:l028","ordinal":18926,"en":"The renowned among spearmen,"},{"id":"manas-2010:p0411:b001:l029","ordinal":18927,"en":"Those deft at swinging swords,"},{"id":"manas-2010:p0411:b001:l030","ordinal":18928,"en":"Those skilled at drawing bows,"},{"id":"manas-2010:p0411:b001:l031","ordinal":18929,"en":"With unsheathed swords strapped on,"},{"id":"manas-2010:p0411:b001:l032","ordinal":18930,"en":"The experts who knew the enemy's stratagems,"},{"id":"manas-2010:p0411:b001:l033","ordinal":18931,"en":"Their finest officials with rank buttons on their caps,"},{"id":"manas-2010:p0411:b001:l034","ordinal":18932,"en":"Strong men wearing short coats—"},{"id":"manas-2010:p0411:b001:l035","ordinal":18933,"en":"The khan whose rule the people knew,"},{"id":"manas-2010:p0411:b001:l036","ordinal":18934,"en":"Khan Esenkan, from his presence,"},{"id":"manas-2010:p0411:b001:l037","ordinal":18935,"en":"Had sent them out in readiness."},{"id":"manas-2010:p0411:b001:l038","ordinal":18936,"en":"Skilled on horseback, swift on foot,"},{"id":"manas-2010:p0411:b001:l039","ordinal":18937,"en":"The great royal marksman,"},{"id":"manas-2010:p0411:b001:l040","ordinal":18938,"en":"His golden shield roaring,"},{"id":"manas-2010:p0411:b001:l041","ordinal":18939,"en":"His many-colored banner rattling,"},{"id":"manas-2010:p0411:b001:l042","ordinal":18940,"en":"Among marksmen who never missed,"},{"id":"manas-2010:p0411:b001:l043","ordinal":18941,"en":"Karazhoy came advancing."},{"id":"manas-2010:p0411:b001:l044","ordinal":18942,"en":"Karazhoy, a khan known to the people,"},{"id":"manas-2010:p0411:b001:l045","ordinal":18943,"en":"Dressed in mottled red,"},{"id":"manas-2010:p0411:b001:l046","ordinal":18944,"en":"A parrot's tail feathers"}]
