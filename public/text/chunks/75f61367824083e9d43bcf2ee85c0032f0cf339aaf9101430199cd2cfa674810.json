[{"id":"manas-2010:p0422:b001:l032","ordinal":19457,"en":"Lacking strength and being struck down,"},{"id":"manas-2010:p0422:b001:l033","ordinal":19458,"en":"Losing all our champions,"},{"id":"manas-2010:p0422:b001:l034","ordinal":19459,"en":"Letting his wrath wreak havoc,"},{"id":"manas-2010:p0422:b001:l035","ordinal":19460,"en":"Letting him slaughter his challengers,"},{"id":"manas-2010:p0422:b001:l036","ordinal":19461,"en":"How can we remain alive?"},{"id":"manas-2010:p0422:b001:l037","ordinal":19462,"en":"If we do not capture Manas,"},{"id":"manas-2010:p0422:b001:l038","ordinal":19463,"en":"Before Khan Esen"},{"id":"manas-2010:p0422:b001:l039","ordinal":19464,"en":"What answer shall we bring?"},{"id":"manas-2010:p0422:b001:l040","ordinal":19465,"en":"Sweeping upon the bloodthirsty one,"},{"id":"manas-2010:p0422:b001:l041","ordinal":19466,"en":"If you lack the strength to grapple,"},{"id":"manas-2010:p0422:b001:l042","ordinal":19467,"en":"Let us all be slaughtered and die!"},{"id":"manas-2010:p0422:b001:l043","ordinal":19468,"en":"Without death or loss, all of us,"},{"id":"manas-2010:p0422:b001:l044","ordinal":19469,"en":"To Lord Khan Esenkan,"},{"id":"manas-2010:p0422:b001:l045","ordinal":19470,"en":"What answer could we give?!"},{"id":"manas-2010:p0422:b001:l046","ordinal":19471,"en":"Rather than go empty-handed to the khan,"},{"id":"manas-2010:p0422:b001:l047","ordinal":19472,"en":"Let us die, leaving none alive."},{"id":"manas-2010:p0422:b001:l048","ordinal":19473,"en":"The bloodthirsty one whose name is known,"},{"id":"manas-2010:p0423:b001:l001","ordinal":19474,"en":"To that sovereign Esenkan,"},{"id":"manas-2010:p0423:b001:l002","ordinal":19475,"en":"Let us seize and give him alive."},{"id":"manas-2010:p0423:b001:l003","ordinal":19476,"en":"Thrusting spears and shouting,"},{"id":"manas-2010:p0423:b001:l004","ordinal":19477,"en":"Let us stab and shove from every side."},{"id":"manas-2010:p0423:b001:l005","ordinal":19478,"en":"Of true wolf-man Manas,"},{"id":"manas-2010:p0423:b001:l006","ordinal":19479,"en":"Let us uncover a secret."},{"id":"manas-2010:p0423:b001:l007","ordinal":19480,"en":"Let us thrust spears without tiring;"},{"id":"manas-2010:p0423:b001:l008","ordinal":19481,"en":"Stretching our arms, let us strike our maces."},{"id":"manas-2010:p0423:b001:l009","ordinal":19482,"en":"Against the bloodthirsty one who came to contend,"},{"id":"manas-2010:p0423:b001:l010","ordinal":19483,"en":"Let us find some means."},{"id":"manas-2010:p0423:b001:l011","ordinal":19484,"en":"Across the lower slopes of Altai,"},{"id":"manas-2010:p0423:b001:l012","ordinal":19485,"en":"Let us keep him from trotting again."},{"id":"manas-2010:p0423:b001:l013","ordinal":19486,"en":"Firing shots again and again,"},{"id":"manas-2010:p0423:b001:l014","ordinal":19487,"en":"Your father's grave—this Burut,"},{"id":"manas-2010:p0423:b001:l015","ordinal":19488,"en":"After this, to the emperor,"},{"id":"manas-2010:p0423:b001:l016","ordinal":19489,"en":"Let us keep him from coming again."},{"id":"manas-2010:p0423:b001:l017","ordinal":19490,"en":"Let us find some means;"},{"id":"manas-2010:p0423:b001:l018","ordinal":19491,"en":"Let us drive his rage far away."},{"id":"manas-2010:p0423:b001:l019","ordinal":19492,"en":"Beating him into sprawling tatters,"},{"id":"manas-2010:p0423:b001:l020","ordinal":19493,"en":"Against the bloodthirsty lover of trouble,"},{"id":"manas-2010:p0423:b001:l021","ordinal":19494,"en":"Let us find some means."},{"id":"manas-2010:p0423:b001:l022","ordinal":19495,"en":"If he shambles forward and exerts his strength,"},{"id":"manas-2010:p0423:b001:l023","ordinal":19496,"en":"Let us kill him, leaving no life."},{"id":"manas-2010:p0423:b001:l024","ordinal":19497,"en":"Among these champions,"},{"id":"manas-2010:p0423:b001:l025","ordinal":19498,"en":"You have many giants and wolves."},{"id":"manas-2010:p0423:b001:l026","ordinal":19499,"en":"Ezkara, a cultivator of wisdom,"},{"id":"manas-2010:p0423:b001:l027","ordinal":19500,"en":"Understand the words I speak!"},{"id":"manas-2010:p0423:b001:l028","ordinal":19501,"en":"Reckless warrior Mangkush,"},{"id":"manas-2010:p0423:b001:l029","ordinal":19502,"en":"This is what I say; understand!"},{"id":"manas-2010:p0423:b001:l030","ordinal":19503,"en":"None of you is weak; you are skilled."},{"id":"manas-2010:p0423:b001:l031","ordinal":19504,"en":"One of you alone is worth a thousand troops;"},{"id":"manas-2010:p0423:b001:l032","ordinal":19505,"en":"You are mighty as devouring demons."},{"id":"manas-2010:p0423:b001:l033","ordinal":19506,"en":"Of your Esenkan in Beijing,"},{"id":"manas-2010:p0423:b001:l034","ordinal":19507,"en":"You are the support he trusts."},{"id":"manas-2010:p0423:b001:l035","ordinal":19508,"en":"Of the vast Chinese people,"},{"id":"manas-2010:p0423:b001:l036","ordinal":19509,"en":"You are the heroes they firmly trust."},{"id":"manas-2010:p0423:b001:l037","ordinal":19510,"en":"Tested and approved as warriors—"},{"id":"manas-2010:p0423:b001:l038","ordinal":19511,"en":"Take heed, champions!"},{"id":"manas-2010:p0423:b001:l039","ordinal":19512,"en":"Your lord, mighty Esenkan,"},{"id":"manas-2010:p0423:b001:l040","ordinal":19513,"en":"Had you fed from the treasury."},{"id":"manas-2010:p0423:b001:l041","ordinal":19514,"en":"You who spare no opponent,"},{"id":"manas-2010:p0423:b001:l042","ordinal":19515,"en":"The meat of a whole pig"},{"id":"manas-2010:p0423:b001:l043","ordinal":19516,"en":"Cannot fill you at one meal."},{"id":"manas-2010:p0423:b001:l044","ordinal":19517,"en":"Unfastening the chain from your neck,"},{"id":"manas-2010:p0423:b001:l045","ordinal":19518,"en":"He sent you against a mighty foe."},{"id":"manas-2010:p0423:b001:l046","ordinal":19519,"en":"That wild, bloodthirsty Burut,"},{"id":"manas-2010:p0423:b001:l047","ordinal":19520,"en":"How can we fail to face him?"},{"id":"manas-2010:p0423:b001:l048","ordinal":19521,"en":"He sent us with great faith,"},{"id":"manas-2010:p0424:b001:l001","ordinal":19522,"en":"Esenkan is a wolf-man indeed."},{"id":"manas-2010:p0424:b001:l002","ordinal":19523,"en":"Some havoc from this Burut,"},{"id":"manas-2010:p0424:b001:l003","ordinal":19524,"en":"How can we fail to face it!"},{"id":"manas-2010:p0424:b001:l004","ordinal":19525,"en":"Slaughtered, no longer alive,"},{"id":"manas-2010:p0424:b001:l005","ordinal":19526,"en":"How can we go without dying!"},{"id":"manas-2010:p0424:b001:l006","ordinal":19527,"en":"If we lose to the Burut,"},{"id":"manas-2010:p0424:b001:l007","ordinal":19528,"en":"If you are frightened, take courage."},{"id":"manas-2010:p0424:b001:l008","ordinal":19529,"en":"If we go empty-handed to Esen,"},{"id":"manas-2010:p0424:b001:l009","ordinal":19530,"en":"This will be our shame!”"},{"id":"manas-2010:p0424:b001:l010","ordinal":19531,"en":"Making them all march in ranks,"},{"id":"manas-2010:p0424:b001:l011","ordinal":19532,"en":"Zholoy and Ezkara"},{"id":"manas-2010:p0424:b001:l012","ordinal":19533,"en":"Showed their valor."},{"id":"manas-2010:p0424:b001:l013","ordinal":19534,"en":"When the champions heard this,"},{"id":"manas-2010:p0424:b001:l014","ordinal":19535,"en":"They took battle-axes in hand."},{"id":"manas-2010:p0424:b001:l015","ordinal":19536,"en":"Upon renowned wolf-man Manas,"},{"id":"manas-2010:p0424:b001:l016","ordinal":19537,"en":"The many Chinese, stripped of honor,"},{"id":"manas-2010:p0424:b001:l017","ordinal":19538,"en":"Launched their charge."},{"id":"manas-2010:p0424:b001:l018","ordinal":19539,"en":"The eye could not make them out;"},{"id":"manas-2010:p0424:b001:l019","ordinal":19540,"en":"May God spare us the sight!"},{"id":"manas-2010:p0424:b001:l020","ordinal":19541,"en":"Like tumbleweed in flight,"},{"id":"manas-2010:p0424:b001:l021","ordinal":19542,"en":"One could not tell them apart."},{"id":"manas-2010:p0424:b001:l022","ordinal":19543,"en":"All were skilled wolf-men;"},{"id":"manas-2010:p0424:b001:l023","ordinal":19544,"en":"They had overwhelmed Manas,"},{"id":"manas-2010:p0424:b001:l024","ordinal":19545,"en":"The finest who came from the emperor."},{"id":"manas-2010:p0424:b001:l025","ordinal":19546,"en":"Their heroes full of courage,"},{"id":"manas-2010:p0424:b001:l026","ordinal":19547,"en":"Each one like a mountain,"},{"id":"manas-2010:p0424:b001:l027","ordinal":19548,"en":"Their champions who would not flee,"},{"id":"manas-2010:p0424:b001:l028","ordinal":19549,"en":"Their broad-backed men at the front,"},{"id":"manas-2010:p0424:b001:l029","ordinal":19550,"en":"Ezkara and Zholoy on the flanks,"},{"id":"manas-2010:p0424:b001:l030","ordinal":19551,"en":"Charging and thrusting spears,"},{"id":"manas-2010:p0424:b001:l031","ordinal":19552,"en":"They swept forward in multitudes."},{"id":"manas-2010:p0424:b001:l032","ordinal":19553,"en":"Let me give myself to God,"},{"id":"manas-2010:p0424:b001:l033","ordinal":19554,"en":"Well pleased with His word."},{"id":"manas-2010:p0424:b001:l034","ordinal":19555,"en":"Kutubiy, Oshpur's son,"},{"id":"manas-2010:p0424:b001:l035","ordinal":19556,"en":"Look how fortunate he was,"},{"id":"manas-2010:p0424:b001:l036","ordinal":19557,"en":"For hapless Manas himself."},{"id":"manas-2010:p0424:b001:l037","ordinal":19558,"en":"Kutubiy stood and said this,"},{"id":"manas-2010:p0424:b001:l038","ordinal":19559,"en":"When he saw the surrounding foe:"},{"id":"manas-2010:p0424:b001:l039","ordinal":19560,"en":"“My support, Manas, my dear friend,"},{"id":"manas-2010:p0424:b001:l040","ordinal":19561,"en":"Born in Altai, you have met sorrow."},{"id":"manas-2010:p0424:b001:l041","ordinal":19562,"en":"Joining when I was small as a louse,"},{"id":"manas-2010:p0424:b001:l042","ordinal":19563,"en":"Uniting when we were small as thumbs,"},{"id":"manas-2010:p0424:b001:l043","ordinal":19564,"en":"Meeting when we were small as ticks,"},{"id":"manas-2010:p0424:b001:l044","ordinal":19565,"en":"I became your friend beside you."},{"id":"manas-2010:p0424:b001:l045","ordinal":19566,"en":"Born and playing in Altai,"},{"id":"manas-2010:p0424:b001:l046","ordinal":19567,"en":"Against the oppressive Black Chinese,"},{"id":"manas-2010:p0424:b001:l047","ordinal":19568,"en":"Let us raise an uproar."},{"id":"manas-2010:p0424:b001:l048","ordinal":19569,"en":"Until the supple dry stalk ripens,"},{"id":"manas-2010:p0425:b001:l001","ordinal":19570,"en":"Until the autumn gossamer flies,"},{"id":"manas-2010:p0425:b001:l002","ordinal":19571,"en":"Let us fight fiercely for six months,"},{"id":"manas-2010:p0425:b001:l003","ordinal":19572,"en":"Whirling spears and breaking ranks,"},{"id":"manas-2010:p0425:b001:l004","ordinal":19573,"en":"Falling to a shot if death arrives,"},{"id":"manas-2010:p0425:b001:l005","ordinal":19574,"en":"Facing one another and dying,"},{"id":"manas-2010:p0425:b001:l006","ordinal":19575,"en":"What the One Who Exists has written,"},{"id":"manas-2010:p0425:b001:l007","ordinal":19576,"en":"Let us face it when it comes upon our heads."},{"id":"manas-2010:p0425:b001:l008","ordinal":19577,"en":"Against the massing unbelievers,"},{"id":"manas-2010:p0425:b001:l009","ordinal":19578,"en":"Let us keep on fighting."},{"id":"manas-2010:p0425:b001:l010","ordinal":19579,"en":"Unless we die, to the unbelievers,"},{"id":"manas-2010:p0425:b001:l011","ordinal":19580,"en":"How can we surrender our migration!"},{"id":"manas-2010:p0425:b001:l012","ordinal":19581,"en":"These Manchus have grown mighty;"},{"id":"manas-2010:p0425:b001:l013","ordinal":19582,"en":"Let us stand and block their front."},{"id":"manas-2010:p0425:b001:l014","ordinal":19583,"en":"Let us not lose our honor,"},{"id":"manas-2010:p0425:b001:l015","ordinal":19584,"en":"Fighting six months without rest."},{"id":"manas-2010:p0425:b001:l016","ordinal":19585,"en":"Toward their lord, their venomous khan,"},{"id":"manas-2010:p0425:b001:l017","ordinal":19586,"en":"Let us drive them fighting,"},{"id":"manas-2010:p0425:b001:l018","ordinal":19587,"en":"Crushing the Chinese,"},{"id":"manas-2010:p0425:b001:l019","ordinal":19588,"en":"Before Esenkan!"},{"id":"manas-2010:p0425:b001:l020","ordinal":19589,"en":"A little grief is in my heart:"},{"id":"manas-2010:p0425:b001:l021","ordinal":19590,"en":"Among the swarming Chinese,"},{"id":"manas-2010:p0425:b001:l022","ordinal":19591,"en":"We have been left forty households."},{"id":"manas-2010:p0425:b001:l023","ordinal":19592,"en":"I have no support to trust,"},{"id":"manas-2010:p0425:b001:l024","ordinal":19593,"en":"No land where I am firmly settled."},{"id":"manas-2010:p0425:b001:l025","ordinal":19594,"en":"If I die at Chinese hands,"},{"id":"manas-2010:p0425:b001:l026","ordinal":19595,"en":"O sole Creator, my heart is at peace.”"},{"id":"manas-2010:p0425:b001:l027","ordinal":19596,"en":"Then leopard Manas,"},{"id":"manas-2010:p0425:b001:l028","ordinal":19597,"en":"Having heard Kutubiy's words:"},{"id":"manas-2010:p0425:b001:l029","ordinal":19598,"en":"“Do not grieve, my Kutu, do not grieve!"},{"id":"manas-2010:p0425:b001:l030","ordinal":19599,"en":"Let us choose coursers to ride."},{"id":"manas-2010:p0425:b001:l031","ordinal":19600,"en":"The Chinese, swarming like ants,"},{"id":"manas-2010:p0425:b001:l032","ordinal":19601,"en":"Let us destroy and drive them off!"},{"id":"manas-2010:p0425:b001:l033","ordinal":19602,"en":"These lower slopes of Altai—"},{"id":"manas-2010:p0425:b001:l034","ordinal":19603,"en":"Alas, my Kutu, what are you saying?"},{"id":"manas-2010:p0425:b001:l035","ordinal":19604,"en":"Were they a land where we could not ride?”"},{"id":"manas-2010:p0425:b001:l036","ordinal":19605,"en":"Saying this, warrior Manas,"},{"id":"manas-2010:p0425:b001:l037","ordinal":19606,"en":"Flame burst from his mouth."},{"id":"manas-2010:p0425:b001:l038","ordinal":19607,"en":"One who would fight without retreat—"},{"id":"manas-2010:p0425:b001:l039","ordinal":19608,"en":"His blood-drinker's bearing showed."},{"id":"manas-2010:p0425:b001:l040","ordinal":19609,"en":"The curved pass over yonder,"},{"id":"manas-2010:p0425:b001:l041","ordinal":19610,"en":"Manas crossed in fury."},{"id":"manas-2010:p0425:b001:l042","ordinal":19611,"en":"Toruchaar beneath him,"},{"id":"manas-2010:p0425:b001:l043","ordinal":19612,"en":"He covered in shot-proof armor."},{"id":"manas-2010:p0425:b001:l044","ordinal":19613,"en":"As he faced the enemy,"},{"id":"manas-2010:p0425:b001:l045","ordinal":19614,"en":"His companion Kydyr, the two together,"},{"id":"manas-2010:p0425:b001:l046","ordinal":19615,"en":"Making his spotted horse toss,"},{"id":"manas-2010:p0425:b001:l047","ordinal":19616,"en":"The forty Chiltens led it."},{"id":"manas-2010:p0425:b001:l048","ordinal":19617,"en":"One of the Chiltens, a gray tiger,"},{"id":"manas-2010:p0426:b001:l001","ordinal":19618,"en":"Sprang forward at the front."},{"id":"manas-2010:p0426:b001:l002","ordinal":19619,"en":"The magnanimous one entered battle,"},{"id":"manas-2010:p0426:b001:l003","ordinal":19620,"en":"Ready with his spear thrust out."},{"id":"manas-2010:p0426:b001:l004","ordinal":19621,"en":"He was the champion, he the support;"},{"id":"manas-2010:p0426:b001:l005","ordinal":19622,"en":"Facing the Chinese,"},{"id":"manas-2010:p0426:b001:l006","ordinal":19623,"en":"That was the place of turmoil."},{"id":"manas-2010:p0426:b001:l007","ordinal":19624,"en":"At the saddle of Kum-Kashat,"},{"id":"manas-2010:p0426:b001:l008","ordinal":19625,"en":"Kutubiy beside him,"},{"id":"manas-2010:p0426:b001:l009","ordinal":19626,"en":"When valiant Manas appeared,"},{"id":"manas-2010:p0426:b001:l010","ordinal":19627,"en":"Haze filled the earth."},{"id":"manas-2010:p0426:b001:l011","ordinal":19628,"en":"He thought it mist, but it was dust;"},{"id":"manas-2010:p0426:b001:l012","ordinal":19629,"en":"Strangely yellow as the moon,"},{"id":"manas-2010:p0426:b001:l013","ordinal":19630,"en":"He thought it a plain, but it was people."},{"id":"manas-2010:p0426:b001:l014","ordinal":19631,"en":"So many shapes gathered together—"},{"id":"manas-2010:p0426:b001:l015","ordinal":19632,"en":"“A forest?” he wondered,"},{"id":"manas-2010:p0426:b001:l016","ordinal":19633,"en":"But it was the surging Chinese people."},{"id":"manas-2010:p0426:b001:l017","ordinal":19634,"en":"What appeared flickering and flashing,"},{"id":"manas-2010:p0426:b001:l018","ordinal":19635,"en":"He thought stars, but it was fire."},{"id":"manas-2010:p0426:b001:l019","ordinal":19636,"en":"A black ridge stretching across—"},{"id":"manas-2010:p0426:b001:l020","ordinal":19637,"en":"He thought a ridge, but it was a pass."},{"id":"manas-2010:p0426:b001:l021","ordinal":19638,"en":"Upon that black ridge"},{"id":"manas-2010:p0426:b001:l022","ordinal":19639,"en":"Were the seething Chinese people."},{"id":"manas-2010:p0426:b001:l023","ordinal":19640,"en":"Look at the hazy land;"},{"id":"manas-2010:p0426:b001:l024","ordinal":19641,"en":"Those who attack without turning back,"},{"id":"manas-2010:p0426:b001:l025","ordinal":19642,"en":"Look at those Chinese people!"},{"id":"manas-2010:p0426:b001:l026","ordinal":19643,"en":"Esenkan, khan of Beijing,"},{"id":"manas-2010:p0426:b001:l027","ordinal":19644,"en":"Had sternly gathered his governors."},{"id":"manas-2010:p0426:b001:l028","ordinal":19645,"en":"“Bring the bloodthirsty one bound,”"},{"id":"manas-2010:p0426:b001:l029","ordinal":19646,"en":"He had issued a fierce command."},{"id":"manas-2010:p0426:b001:l030","ordinal":19647,"en":"Executioners had swept forward;"},{"id":"manas-2010:p0426:b001:l031","ordinal":19648,"en":"With Chinese, Kalmyks and Manchus,"},{"id":"manas-2010:p0426:b001:l032","ordinal":19649,"en":"The earth could no longer be seen."},{"id":"manas-2010:p0426:b001:l033","ordinal":19650,"en":"Their arm guards spreading broad,"},{"id":"manas-2010:p0426:b001:l034","ordinal":19651,"en":"From the multitude of Chinese,"},{"id":"manas-2010:p0426:b001:l035","ordinal":19652,"en":"The sun could no longer be seen."},{"id":"manas-2010:p0426:b001:l036","ordinal":19653,"en":"They were Kakanchyn's people;"},{"id":"manas-2010:p0426:b001:l037","ordinal":19654,"en":"There were giants of every kind."},{"id":"manas-2010:p0426:b001:l038","ordinal":19655,"en":"When their khan commanded,"},{"id":"manas-2010:p0426:b001:l039","ordinal":19656,"en":"Throwing the whole world into tumult"},{"id":"manas-2010:p0426:b001:l040","ordinal":19657,"en":"Was those unbelievers' custom."},{"id":"manas-2010:p0426:b001:l041","ordinal":19658,"en":"Look at the pass where earth flies;"},{"id":"manas-2010:p0426:b001:l042","ordinal":19659,"en":"Then, upon the earth,"},{"id":"manas-2010:p0426:b001:l043","ordinal":19660,"en":"Look at the surging Chinese people!"},{"id":"manas-2010:p0426:b001:l044","ordinal":19661,"en":"Esenkan with his lords"},{"id":"manas-2010:p0426:b001:l045","ordinal":19662,"en":"Had issued such a command."},{"id":"manas-2010:p0426:b001:l046","ordinal":19663,"en":"Whom ears had heard of and eyes had seen,"},{"id":"manas-2010:p0426:b001:l047","ordinal":19664,"en":"He had gathered every champion."},{"id":"manas-2010:p0426:b001:l048","ordinal":19665,"en":"From the cities of Chin-Machin,"},{"id":"manas-2010:p0427:b001:l001","ordinal":19666,"en":"He had brought his true judges of men."},{"id":"manas-2010:p0427:b001:l002","ordinal":19667,"en":"That madman drove them like livestock,"},{"id":"manas-2010:p0427:b001:l003","ordinal":19668,"en":"Making them file along."},{"id":"manas-2010:p0427:b001:l004","ordinal":19669,"en":"He had gathered his champions;"},{"id":"manas-2010:p0427:b001:l005","ordinal":19670,"en":"Anyone who said, “I will not go,”"},{"id":"manas-2010:p0427:b001:l006","ordinal":19671,"en":"He had cut off his head."},{"id":"manas-2010:p0427:b001:l007","ordinal":19672,"en":"Each man worth a thousand,"},{"id":"manas-2010:p0427:b001:l008","ordinal":19673,"en":"He had sent the skilled ones."},{"id":"manas-2010:p0427:b001:l009","ordinal":19674,"en":"Those who struck and buried shame,"},{"id":"manas-2010:p0427:b001:l010","ordinal":19675,"en":"He had sent the mighty ones."},{"id":"manas-2010:p0427:b001:l011","ordinal":19676,"en":"Their tasseled standards floated;"},{"id":"manas-2010:p0427:b001:l012","ordinal":19677,"en":"Their strong men swept forward."},{"id":"manas-2010:p0427:b001:l013","ordinal":19678,"en":"At that time, Manas's"},{"id":"manas-2010:p0427:b001:l014","ordinal":19679,"en":"Collarbones had formed."},{"id":"manas-2010:p0427:b001:l015","ordinal":19680,"en":"If one judged the leopard,"},{"id":"manas-2010:p0427:b001:l016","ordinal":19681,"en":"He had filled out like Mount Opol."},{"id":"manas-2010:p0427:b001:l017","ordinal":19682,"en":"Manas had become Manas!"},{"id":"manas-2010:p0427:b001:l018","ordinal":19683,"en":"He had donned the unwearing coat,"},{"id":"manas-2010:p0427:b001:l019","ordinal":19684,"en":"He had mounted Toruchaar."},{"id":"manas-2010:p0427:b001:l020","ordinal":19685,"en":"The place he reached was Kakanchyn;"},{"id":"manas-2010:p0427:b001:l021","ordinal":19686,"en":"Against their nets of iron rope,"},{"id":"manas-2010:p0427:b001:l022","ordinal":19687,"en":"Your accomplished one now attacked,"},{"id":"manas-2010:p0427:b001:l023","ordinal":19688,"en":"Against Esenkan's army."},{"id":"manas-2010:p0427:b001:l024","ordinal":19689,"en":"Girding a warrior's belt about his waist,"},{"id":"manas-2010:p0427:b001:l025","ordinal":19690,"en":"Such was the bloodthirsty one's way."},{"id":"manas-2010:p0427:b001:l026","ordinal":19691,"en":"Into the Chinese who filled the earth,"},{"id":"manas-2010:p0427:b001:l027","ordinal":19692,"en":"He entered alone and attacked."},{"id":"manas-2010:p0427:b001:l028","ordinal":19693,"en":"Thrusting spears and striking axes,"},{"id":"manas-2010:p0427:b001:l029","ordinal":19694,"en":"They began to wound one another."},{"id":"manas-2010:p0427:b001:l030","ordinal":19695,"en":"Into the Chinese who filled the earth,"},{"id":"manas-2010:p0427:b001:l031","ordinal":19696,"en":"Your lord attacked alone"},{"id":"manas-2010:p0427:b001:l032","ordinal":19697,"en":"And plunged among them."},{"id":"manas-2010:p0427:b001:l033","ordinal":19698,"en":"Such was the champion's way;"},{"id":"manas-2010:p0427:b001:l034","ordinal":19699,"en":"Strong in spirit, weighty in name,"},{"id":"manas-2010:p0427:b001:l035","ordinal":19700,"en":"He entered and attacked."},{"id":"manas-2010:p0427:b001:l036","ordinal":19701,"en":"Before him, multitudes of Manchu troops."},{"id":"manas-2010:p0427:b001:l037","ordinal":19702,"en":"Great in majesty, fierce in wrath,"},{"id":"manas-2010:p0427:b001:l038","ordinal":19703,"en":"Thrusting their giants head over heels,"},{"id":"manas-2010:p0427:b001:l039","ordinal":19704,"en":"Your lion laid them flat."},{"id":"manas-2010:p0427:b001:l040","ordinal":19705,"en":"Bending down, he speared a warrior;"},{"id":"manas-2010:p0427:b001:l041","ordinal":19706,"en":"Such was the bloodthirsty one's way."},{"id":"manas-2010:p0427:b001:l042","ordinal":19707,"en":"He speared many in an even row."},{"id":"manas-2010:p0427:b001:l043","ordinal":19708,"en":"Galloping on Toruchaar,"},{"id":"manas-2010:p0427:b001:l044","ordinal":19709,"en":"Their champions like mountains and rocks,"},{"id":"manas-2010:p0427:b001:l045","ordinal":19710,"en":"He speared headlong and brought them down."},{"id":"manas-2010:p0427:b001:l046","ordinal":19711,"en":"Making the courser Toruchaar rear,"},{"id":"manas-2010:p0427:b001:l047","ordinal":19712,"en":"He laid multitudes low."}]
