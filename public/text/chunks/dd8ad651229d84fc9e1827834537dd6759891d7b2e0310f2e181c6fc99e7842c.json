[{"id":"semetey-1-2013:p0768:b003:l024","ordinal":135169,"en":"He was a thudding wretch;"},{"id":"semetey-1-2013:p0768:b003:l025","ordinal":135170,"en":"Like a boar in the forest,"},{"id":"semetey-1-2013:p0768:b003:l026","ordinal":135171,"en":"He was a grunting wretch."},{"id":"semetey-1-2013:p0768:b003:l028","ordinal":135172,"en":"He was no wretch to be a breeze,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0768:b003:l029","ordinal":135173,"en":"Nor one to join with the orphan"},{"id":"semetey-1-2013:p0768:b003:l030","ordinal":135174,"en":"And become one people."},{"id":"semetey-1-2013:p0768:b003:l033","ordinal":135175,"en":"Whoever fell into his hands,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0768:b003:l034","ordinal":135176,"en":"That wretch would beat them."},{"id":"semetey-1-2013:p0768:b003:l035","ordinal":135177,"en":"Taxes and tribute on his people"},{"id":"semetey-1-2013:p0768:b003:l036","ordinal":135178,"en":"That wretch kept raining down;"},{"id":"semetey-1-2013:p0768:b003:l037","ordinal":135179,"en":"Anyone who opposed him"},{"id":"semetey-1-2013:p0768:b003:l038","ordinal":135180,"en":"He thrust alive into the earth,"},{"id":"semetey-1-2013:p0768:b003:l039","ordinal":135181,"en":"And kept them buried underfoot."},{"id":"semetey-1-2013:p0768:b004:l001","ordinal":135182,"en":"Among the six, Kobosh was khan;"},{"id":"semetey-1-2013:p0768:b004:l002","ordinal":135183,"en":"Such was the suffering he caused,"},{"id":"semetey-1-2013:p0768:b004:l003","ordinal":135184,"en":"And he himself was a fool."},{"id":"semetey-1-2013:p0768:b004:l004","ordinal":135185,"en":"Kobosh stood there, gathering rage,"},{"id":"semetey-1-2013:p0768:b004:l005","ordinal":135186,"en":"To the orphan son of Manas"},{"id":"semetey-1-2013:p0768:b004:l006","ordinal":135187,"en":"Speaking without restraint."},{"id":"semetey-1-2013:p0768:b004:l007","ordinal":135188,"en":"Kobosh began his threats;"},{"id":"semetey-1-2013:p0768:b004:l008","ordinal":135189,"en":"The orphan son of Manas"},{"id":"semetey-1-2013:p0768:b004:l010","ordinal":135190,"en":"His bellow split heads,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0768:b004:l011","ordinal":135191,"en":"His shout split stone."},{"id":"semetey-1-2013:p0768:b004:l012","ordinal":135192,"en":"Raging and roaring,"},{"id":"semetey-1-2013:p0768:b004:l013","ordinal":135193,"en":"Dear Kobosh thundered:"},{"id":"semetey-1-2013:p0768:b004:l014","ordinal":135194,"en":"“To Temir Khan’s city"},{"id":"semetey-1-2013:p0768:b004:l015","ordinal":135195,"en":"You wandered, you orphan slave;"},{"id":"semetey-1-2013:p0768:b004:l016","ordinal":135196,"en":"To Kara Khan’s city"},{"id":"semetey-1-2013:p0768:b004:l017","ordinal":135197,"en":"You fled, you fugitive slave;"},{"id":"semetey-1-2013:p0768:b004:l018","ordinal":135198,"en":"This damned orphan—"},{"id":"semetey-1-2013:p0768:b004:l019","ordinal":135199,"en":"Look at what he is doing."},{"id":"semetey-1-2013:p0768:b004:l020","ordinal":135200,"en":"I shall kill him, sever his head,"},{"id":"semetey-1-2013:p0768:b004:l021","ordinal":135201,"en":"And put him out like a fire."},{"id":"semetey-1-2013:p0768:b004:l022","ordinal":135202,"en":"When a cliff falls, water bears it up;"},{"id":"semetey-1-2013:p0768:b004:l023","ordinal":135203,"en":"If this lone slave dies, who will uphold him?!"},{"id":"semetey-1-2013:p0768:b004:l024","ordinal":135204,"en":"You damned orphan slave,"},{"id":"semetey-1-2013:p0768:b004:l025","ordinal":135205,"en":"What remained to you from your father, Khan Manas?"},{"id":"semetey-1-2013:p0768:b004:l027","ordinal":135206,"en":"A short-tailed dun mare remained,"},{"id":"semetey-1-2013:p0768:b004:l028","ordinal":135207,"en":"A single maggot-ridden camel remained,"},{"id":"semetey-1-2013:p0768:b004:l029","ordinal":135208,"en":"A black cow with a torn nostril remained,"},{"id":"semetey-1-2013:p0768:b004:l030","ordinal":135209,"en":"A tattered black yurt remained."},{"id":"semetey-1-2013:p0768:b004:l031","ordinal":135210,"en":"Your father Manas"},{"id":"semetey-1-2013:p0768:b004:l032","ordinal":135211,"en":"Entered a black little hut;"},{"id":"semetey-1-2013:p0768:b004:l033","ordinal":135212,"en":"Your father spent his days"},{"id":"semetey-1-2013:p0768:b004:l034","ordinal":135213,"en":"Fighting with anyone and everyone."},{"id":"semetey-1-2013:p0768:b004:l036","ordinal":135214,"en":"Loading his baggage onto a calf,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0768:b004:l037","ordinal":135215,"en":"Making you suffer hell like this."},{"id":"semetey-1-2013:p0768:b004:l038","ordinal":135216,"en":"Your father Manas, the fool,"},{"id":"semetey-1-2013:p0768:b004:l039","ordinal":135217,"en":"Used to ride Akkula,"},{"id":"semetey-1-2013:p0769:b003:l001","ordinal":135218,"en":"Fighting whoever faced him,"},{"id":"semetey-1-2013:p0769:b003:l002","ordinal":135219,"en":"Going about with threats."},{"id":"semetey-1-2013:p0769:b003:l003","ordinal":135220,"en":"Akkula, whom your father rode,"},{"id":"semetey-1-2013:p0769:b003:l004","ordinal":135221,"en":"Was a horse of ours."},{"id":"semetey-1-2013:p0769:b003:l005","ordinal":135222,"en":"That Manas, with his bullying,"},{"id":"semetey-1-2013:p0769:b003:l006","ordinal":135223,"en":"Rode him by force."},{"id":"semetey-1-2013:p0769:b003:l007","ordinal":135224,"en":"When one of his moods seized him,"},{"id":"semetey-1-2013:p0769:b003:l008","ordinal":135225,"en":"He gelded a thoroughbred to make a mount,"},{"id":"semetey-1-2013:p0769:b003:l009","ordinal":135226,"en":"And estranged us from Altai."},{"id":"semetey-1-2013:p0769:b003:l010","ordinal":135227,"en":"This one's father, foolish Manas—"},{"id":"semetey-1-2013:p0769:b003:l011","ordinal":135228,"en":"Where did he ever raid a people?"},{"id":"semetey-1-2013:p0769:b003:l012","ordinal":135229,"en":"Your father was a fool,"},{"id":"semetey-1-2013:p0769:b003:l013","ordinal":135230,"en":"Who lived upon our livestock."},{"id":"semetey-1-2013:p0769:b003:l014","ordinal":135231,"en":"He started scandalous affairs;"},{"id":"semetey-1-2013:p0769:b003:l015","ordinal":135232,"en":"When they came from the Kalmyks, received with honor,"},{"id":"semetey-1-2013:p0769:b003:l016","ordinal":135233,"en":"Kinsmen such as Kozkaman"},{"id":"semetey-1-2013:p0769:b003:l017","ordinal":135234,"en":"He slaughtered all together."},{"id":"semetey-1-2013:p0769:b003:l019","ordinal":135235,"en":"He stirred up trouble with the Chinese","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0769:b003:l020","ordinal":135236,"en":"And made us their enemies."},{"id":"semetey-1-2013:p0769:b003:l021","ordinal":135237,"en":"This damned orphan—"},{"id":"semetey-1-2013:p0769:b003:l022","ordinal":135238,"en":"Look at what he has done!"},{"id":"semetey-1-2013:p0769:b003:l023","ordinal":135239,"en":"How many people did Manas leave,"},{"id":"semetey-1-2013:p0769:b003:l024","ordinal":135240,"en":"What livestock did your father leave?"},{"id":"semetey-1-2013:p0769:b003:l025","ordinal":135241,"en":"Akshumkar, whom you speak of,"},{"id":"semetey-1-2013:p0769:b003:l026","ordinal":135242,"en":"I myself took from the nest"},{"id":"semetey-1-2013:p0769:b003:l027","ordinal":135243,"en":"And flew him for my pleasure."},{"id":"semetey-1-2013:p0769:b003:l028","ordinal":135244,"en":"You damned orphan slave,"},{"id":"semetey-1-2013:p0769:b003:l029","ordinal":135245,"en":"When was he ever Manas's bird!"},{"id":"semetey-1-2013:p0769:b003:l030","ordinal":135246,"en":"From the desert of Mediyan,"},{"id":"semetey-1-2013:p0769:b003:l031","ordinal":135247,"en":"From the place I washed for prayer,"},{"id":"semetey-1-2013:p0769:b003:l032","ordinal":135248,"en":"I found and took Kumayyk;"},{"id":"semetey-1-2013:p0769:b003:l033","ordinal":135249,"en":"I tended him as a puppy,"},{"id":"semetey-1-2013:p0769:b003:l034","ordinal":135250,"en":"Kept him until he was grown,"},{"id":"semetey-1-2013:p0769:b003:l035","ordinal":135251,"en":"Had discerning judges assess him,"},{"id":"semetey-1-2013:p0769:b003:l037","ordinal":135252,"en":"Had a collar put upon his neck,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0769:b003:l038","ordinal":135253,"en":"Had keepers care for him—"},{"id":"semetey-1-2013:p0769:b003:l039","ordinal":135254,"en":"My own dog, whom I found."},{"id":"semetey-1-2013:p0769:b005:l001","ordinal":135255,"en":"You damned orphan slave,"},{"id":"semetey-1-2013:p0769:b005:l002","ordinal":135256,"en":"When was he ever Manas's dog?"},{"id":"semetey-1-2013:p0769:b005:l003","ordinal":135257,"en":"Yesterday I went and raided the Afghans;"},{"id":"semetey-1-2013:p0769:b005:l004","ordinal":135258,"en":"How could Margilan remain unharmed?"},{"id":"semetey-1-2013:p0769:b005:l005","ordinal":135259,"en":"When I humiliated the religious master,"},{"id":"semetey-1-2013:p0769:b005:l006","ordinal":135260,"en":"When I beat the mullah,"},{"id":"semetey-1-2013:p0769:b005:l007","ordinal":135261,"en":"I seized Akolpok—"},{"id":"semetey-1-2013:p0769:b005:l008","ordinal":135262,"en":"When was it ever Manas's coat?"},{"id":"semetey-1-2013:p0769:b005:l009","ordinal":135263,"en":"You damned orphan slave,"},{"id":"semetey-1-2013:p0769:b005:l010","ordinal":135264,"en":"Look at what he is saying!"},{"id":"semetey-1-2013:p0769:b005:l011","ordinal":135265,"en":"What he calls Boz Kise,"},{"id":"semetey-1-2013:p0769:b005:l012","ordinal":135266,"en":"What nonsense he is speaking!"},{"id":"semetey-1-2013:p0769:b005:l013","ordinal":135267,"en":"When I roamed through Medina,"},{"id":"semetey-1-2013:p0769:b005:l014","ordinal":135268,"en":"When I went toward Mecca,"},{"id":"semetey-1-2013:p0769:b005:l015","ordinal":135269,"en":"From the ridge of Medina,"},{"id":"semetey-1-2013:p0769:b005:l017","ordinal":135270,"en":"It came upon me from the unseen,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0769:b005:l018","ordinal":135271,"en":"And was found by my very self."},{"id":"semetey-1-2013:p0769:b005:l019","ordinal":135272,"en":"You damned orphan slave,"},{"id":"semetey-1-2013:p0769:b005:l020","ordinal":135273,"en":"When was it ever Manas's possession?"},{"id":"semetey-1-2013:p0769:b005:l021","ordinal":135274,"en":"This damned orphan—"},{"id":"semetey-1-2013:p0769:b005:l022","ordinal":135275,"en":"Look at what he is doing."},{"id":"semetey-1-2013:p0769:b005:l023","ordinal":135276,"en":"Beyond Andijan,"},{"id":"semetey-1-2013:p0769:b005:l024","ordinal":135277,"en":"This side of Amangen,"},{"id":"semetey-1-2013:p0769:b005:l025","ordinal":135278,"en":"Under the wing of the khan of Kokand,"},{"id":"semetey-1-2013:p0769:b005:l026","ordinal":135279,"en":"From the moonlike yellow plain,"},{"id":"semetey-1-2013:p0769:b005:l027","ordinal":135280,"en":"Sixty Russian land surveyors,"},{"id":"semetey-1-2013:p0769:b005:l028","ordinal":135281,"en":"Having their carts pulled along,"},{"id":"semetey-1-2013:p0769:b005:l029","ordinal":135282,"en":"Wearing their yellow coats,"},{"id":"semetey-1-2013:p0769:b005:l030","ordinal":135283,"en":"Riding their mares bareback—"},{"id":"semetey-1-2013:p0769:b005:l031","ordinal":135284,"en":"When the surveyors came out,"},{"id":"semetey-1-2013:p0769:b005:l032","ordinal":135285,"en":"I slaughtered and robbed the Russians;"},{"id":"semetey-1-2013:p0769:b005:l033","ordinal":135286,"en":"From that Russian's back,"},{"id":"semetey-1-2013:p0769:b005:l034","ordinal":135287,"en":"I snatched it from his hand;"},{"id":"semetey-1-2013:p0769:b005:l035","ordinal":135288,"en":"I fell upon them, wreaking havoc,"},{"id":"semetey-1-2013:p0769:b005:l036","ordinal":135289,"en":"I myself seized it."},{"id":"semetey-1-2013:p0769:b005:l037","ordinal":135290,"en":"You damned orphan slave,"},{"id":"semetey-1-2013:p0769:b005:l038","ordinal":135291,"en":"When was it ever Manas's gun?"},{"id":"semetey-1-2013:p0769:b005:l039","ordinal":135292,"en":"Yesterday, when I went ravaging Bukhara,"},{"id":"semetey-1-2013:p0770:b003:l003","ordinal":135293,"en":"Found in a deserted place,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0770:b003:l004","ordinal":135294,"en":"The six keen blades fallen from heaven"},{"id":"semetey-1-2013:p0770:b003:l005","ordinal":135295,"en":"I myself discovered."},{"id":"semetey-1-2013:p0770:b003:l006","ordinal":135296,"en":"You damned orphan slave,"},{"id":"semetey-1-2013:p0770:b003:l007","ordinal":135297,"en":"When were they ever Manas's property?"},{"id":"semetey-1-2013:p0770:b003:l008","ordinal":135298,"en":"From the pass of Yrgayty,"},{"id":"semetey-1-2013:p0770:b003:l009","ordinal":135299,"en":"When I truly advanced to meet them,"},{"id":"semetey-1-2013:p0770:b003:l010","ordinal":135300,"en":"When I wrought great havoc,"},{"id":"semetey-1-2013:p0770:b003:l011","ordinal":135301,"en":"Below Old Turpan,"},{"id":"semetey-1-2013:p0770:b003:l012","ordinal":135302,"en":"Facing Great Barbar,"},{"id":"semetey-1-2013:p0770:b003:l013","ordinal":135303,"en":"Beside the Lop River,"},{"id":"semetey-1-2013:p0770:b003:l014","ordinal":135304,"en":"When I attacked the Noygut,"},{"id":"semetey-1-2013:p0770:b003:l015","ordinal":135305,"en":"Against Karacha's Saykal,"},{"id":"semetey-1-2013:p0770:b003:l016","ordinal":135306,"en":"When I went to battle,"},{"id":"semetey-1-2013:p0770:b003:l017","ordinal":135307,"en":"Against renowned Saykal,"},{"id":"semetey-1-2013:p0770:b003:l018","ordinal":135308,"en":"When I went to joust,"},{"id":"semetey-1-2013:p0770:b003:l019","ordinal":135309,"en":"When we stood facing each other,"},{"id":"semetey-1-2013:p0770:b003:l020","ordinal":135310,"en":"When we fought fiercely,"},{"id":"semetey-1-2013:p0770:b003:l021","ordinal":135311,"en":"Advancing and thrusting our lances,"},{"id":"semetey-1-2013:p0770:b003:l022","ordinal":135312,"en":"When we met, our lances"},{"id":"semetey-1-2013:p0770:b003:l023","ordinal":135313,"en":"We broke across their middles."},{"id":"semetey-1-2013:p0770:b003:l024","ordinal":135314,"en":"We stood braced against each other,"},{"id":"semetey-1-2013:p0770:b003:l025","ordinal":135315,"en":"Fighting face to face again and again,"},{"id":"semetey-1-2013:p0770:b003:l026","ordinal":135316,"en":"Firing guns and drawing bows,"},{"id":"semetey-1-2013:p0770:b003:l027","ordinal":135317,"en":"Fighting without fleeing,"},{"id":"semetey-1-2013:p0770:b003:l028","ordinal":135318,"en":"Battling with battle-axes,"},{"id":"semetey-1-2013:p0770:b003:l029","ordinal":135319,"en":"Unable to close our eyes,"},{"id":"semetey-1-2013:p0770:b003:l030","ordinal":135320,"en":"Wrestling from horseback,"},{"id":"semetey-1-2013:p0770:b003:l031","ordinal":135321,"en":"Grappling by the collars,"},{"id":"semetey-1-2013:p0770:b003:l032","ordinal":135322,"en":"At the pass of Yrgayty,"},{"id":"semetey-1-2013:p0770:b003:l033","ordinal":135323,"en":"Swaying against one another,"},{"id":"semetey-1-2013:p0770:b003:l034","ordinal":135324,"en":"Fighting just like that—"},{"id":"semetey-1-2013:p0770:b003:l035","ordinal":135325,"en":"Karacha's Saykal"},{"id":"semetey-1-2013:p0770:b003:l036","ordinal":135326,"en":"I myself struck with my lance."},{"id":"semetey-1-2013:p0770:b003:l037","ordinal":135327,"en":"You damned orphan slave,"},{"id":"semetey-1-2013:p0770:b003:l038","ordinal":135328,"en":"Buurul, the horse you speak of—"},{"id":"semetey-1-2013:p0770:b003:l039","ordinal":135329,"en":"When was he ever Manas's livestock?"},{"id":"semetey-1-2013:p0770:b004:l001","ordinal":135330,"en":"Six multitudes of horses on the hills,"},{"id":"semetey-1-2013:p0770:b004:l002","ordinal":135331,"en":"Famous swift horses, mottled-headed,"},{"id":"semetey-1-2013:p0770:b004:l003","ordinal":135332,"en":"With thoroughbreds and coursers among them,"},{"id":"semetey-1-2013:p0770:b004:l004","ordinal":135333,"en":"These herds filling the valley"},{"id":"semetey-1-2013:p0770:b004:l005","ordinal":135334,"en":"Are my own stock, allotted by fate."},{"id":"semetey-1-2013:p0770:b004:l006","ordinal":135335,"en":"When were they ever Manas's livestock?"},{"id":"semetey-1-2013:p0770:b004:l007","ordinal":135336,"en":"That guileless Manas—"},{"id":"semetey-1-2013:p0770:b004:l008","ordinal":135337,"en":"How much livestock did he ever have?"},{"id":"semetey-1-2013:p0770:b004:l009","ordinal":135338,"en":"This damned orphan—"},{"id":"semetey-1-2013:p0770:b004:l010","ordinal":135339,"en":"Have you seen what he has done?"},{"id":"semetey-1-2013:p0770:b004:l011","ordinal":135340,"en":"Making a claim on a falsehood,"},{"id":"semetey-1-2013:p0770:b004:l012","ordinal":135341,"en":"Have you seen what he is doing?"},{"id":"semetey-1-2013:p0770:b004:l014","ordinal":135342,"en":"He says, ‘This much is mine.’","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0770:b004:l015","ordinal":135343,"en":"He plots with brazen malice,"},{"id":"semetey-1-2013:p0770:b004:l016","ordinal":135344,"en":"And makes false claims against me."},{"id":"semetey-1-2013:p0770:b004:l017","ordinal":135345,"en":"Even then, Kobosh's"},{"id":"semetey-1-2013:p0770:b004:l019","ordinal":135346,"en":"Storming and rushing on,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0770:b004:l020","ordinal":135347,"en":"Clattering out words of nonsense,"},{"id":"semetey-1-2013:p0770:b004:l021","ordinal":135348,"en":"Your uncle Kobosh would not stop."},{"id":"semetey-1-2013:p0770:b004:l022","ordinal":135349,"en":"He truly began to thunder;"},{"id":"semetey-1-2013:p0770:b004:l023","ordinal":135350,"en":"The cold words Kobosh spoke"},{"id":"semetey-1-2013:p0770:b004:l024","ordinal":135351,"en":"Through the orphan son of Manas"},{"id":"semetey-1-2013:p0770:b004:l025","ordinal":135352,"en":"Pierced to the marrow."},{"id":"semetey-1-2013:p0770:b004:l026","ordinal":135353,"en":"When Kobosh spurred on and shouted,"},{"id":"semetey-1-2013:p0770:b004:l027","ordinal":135354,"en":"They pierced through his bones."},{"id":"semetey-1-2013:p0770:b004:l028","ordinal":135355,"en":"Raging more and more,"},{"id":"semetey-1-2013:p0770:b004:l029","ordinal":135356,"en":"Kobosh's eyes became bullets;"},{"id":"semetey-1-2013:p0770:b004:l030","ordinal":135357,"en":"The poor soul, scarcely a handspan,"},{"id":"semetey-1-2013:p0770:b004:l031","ordinal":135358,"en":"The child's heart became burning embers."},{"id":"semetey-1-2013:p0770:b004:l032","ordinal":135359,"en":"How he had wandered far away,"},{"id":"semetey-1-2013:p0770:b004:l033","ordinal":135360,"en":"That rootless fool Kobosh"},{"id":"semetey-1-2013:p0770:b004:l034","ordinal":135361,"en":"Now recounted in full."},{"id":"semetey-1-2013:p0770:b004:l035","ordinal":135362,"en":"“To Kara Khan's city"},{"id":"semetey-1-2013:p0770:b004:l036","ordinal":135363,"en":"You fled, you orphan slave;"},{"id":"semetey-1-2013:p0770:b004:l037","ordinal":135364,"en":"To Temir Khan's city"},{"id":"semetey-1-2013:p0770:b004:l038","ordinal":135365,"en":"You wandered, you orphan slave;"},{"id":"semetey-1-2013:p0770:b004:l039","ordinal":135366,"en":"This slave whom Manas left—"},{"id":"semetey-1-2013:p0771:b003:l001","ordinal":135367,"en":"Look at what he is saying."},{"id":"semetey-1-2013:p0771:b003:l002","ordinal":135368,"en":"His mother is a mare, a great bitch;"},{"id":"semetey-1-2013:p0771:b003:l003","ordinal":135369,"en":"As a wife she ruined a people,"},{"id":"semetey-1-2013:p0771:b003:l004","ordinal":135370,"en":"And when his mother was a maiden,"},{"id":"semetey-1-2013:p0771:b003:l005","ordinal":135371,"en":"She shook nations and wrecked a land."},{"id":"semetey-1-2013:p0771:b003:l006","ordinal":135372,"en":"His mother fled away;"},{"id":"semetey-1-2013:p0771:b003:l007","ordinal":135373,"en":"She grew among foolish, witless people,"},{"id":"semetey-1-2013:p0771:b003:l008","ordinal":135374,"en":"Grew in a land of donkey-riders,"},{"id":"semetey-1-2013:p0771:b003:l009","ordinal":135375,"en":"Grew in a grave without a door."},{"id":"semetey-1-2013:p0771:b003:l010","ordinal":135376,"en":"Of that fool Manas,"},{"id":"semetey-1-2013:p0771:b003:l011","ordinal":135377,"en":"The orphan who wandered in flight,"},{"id":"semetey-1-2013:p0771:b003:l012","ordinal":135378,"en":"The damned mad slave,"},{"id":"semetey-1-2013:p0771:b003:l013","ordinal":135379,"en":"Fled and grew up in another land,"},{"id":"semetey-1-2013:p0771:b003:l014","ordinal":135380,"en":"Grew among people ignorant of custom."},{"id":"semetey-1-2013:p0771:b003:l015","ordinal":135381,"en":"Saying, ‘Much gold was left to me,’"},{"id":"semetey-1-2013:p0771:b003:l016","ordinal":135382,"en":"This damned orphan—"},{"id":"semetey-1-2013:p0771:b003:l017","ordinal":135383,"en":"Look at what he is doing!"},{"id":"semetey-1-2013:p0771:b003:l018","ordinal":135384,"en":"This orphan who has come raging,"},{"id":"semetey-1-2013:p0771:b003:l019","ordinal":135385,"en":"I shall offer as a sacrifice;"},{"id":"semetey-1-2013:p0771:b003:l020","ordinal":135386,"en":"This mad offspring of Manas,"},{"id":"semetey-1-2013:p0771:b003:l021","ordinal":135387,"en":"I shall offer as a sacrifice."},{"id":"semetey-1-2013:p0771:b003:l022","ordinal":135388,"en":"Having him buried while still unripe,"},{"id":"semetey-1-2013:p0771:b003:l023","ordinal":135389,"en":"I shall bury him now!”"},{"id":"semetey-1-2013:p0771:b003:l024","ordinal":135390,"en":"Roaring, Kobosh worked himself up,"},{"id":"semetey-1-2013:p0771:b003:l025","ordinal":135391,"en":"Speaking like this,"},{"id":"semetey-1-2013:p0771:b003:l026","ordinal":135392,"en":"Almambet's Zhoykuma"},{"id":"semetey-1-2013:p0771:b003:l027","ordinal":135393,"en":"He took into his hand."},{"id":"semetey-1-2013:p0771:b003:l028","ordinal":135394,"en":"Now God had struck Kobosh,"},{"id":"semetey-1-2013:p0771:b003:l029","ordinal":135395,"en":"Now God had struck him hard!"},{"id":"semetey-1-2013:p0771:b003:l030","ordinal":135396,"en":"Taking the sword and shouting,"},{"id":"semetey-1-2013:p0771:b003:l031","ordinal":135397,"en":"Raising the battle cry, “Kobosh!”"},{"id":"semetey-1-2013:p0771:b003:l032","ordinal":135398,"en":"He lumbered down from his throne;"},{"id":"semetey-1-2013:p0771:b003:l033","ordinal":135399,"en":"That wretch Kobosh came shambling."},{"id":"semetey-1-2013:p0771:b003:l034","ordinal":135400,"en":"When Kobosh came near,"},{"id":"semetey-1-2013:p0771:b003:l035","ordinal":135401,"en":"These were the child's words:"},{"id":"semetey-1-2013:p0771:b003:l036","ordinal":135402,"en":"“Wicked Kobosh, hear my words!"},{"id":"semetey-1-2013:p0771:b003:l038","ordinal":135403,"en":"Did I scatter your goods in the saddlebag?","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0771:b003:l039","ordinal":135404,"en":"Did I steal away your piebald horse?"},{"id":"semetey-1-2013:p0771:b005:l001","ordinal":135405,"en":"You run about bellowing—"},{"id":"semetey-1-2013:p0771:b005:l002","ordinal":135406,"en":"Did I scatter your gold?"},{"id":"semetey-1-2013:p0771:b005:l003","ordinal":135407,"en":"The great wealth you will not give when asked,"},{"id":"semetey-1-2013:p0771:b005:l004","ordinal":135408,"en":"Now I shall seize by force;"},{"id":"semetey-1-2013:p0771:b005:l005","ordinal":135409,"en":"The treasury you refuse when asked,"},{"id":"semetey-1-2013:p0771:b005:l006","ordinal":135410,"en":"I shall take from you."},{"id":"semetey-1-2013:p0771:b005:l007","ordinal":135411,"en":"Is a quarrel what you want?"},{"id":"semetey-1-2013:p0771:b005:l008","ordinal":135412,"en":"Now I shall wreak slaughter."},{"id":"semetey-1-2013:p0771:b005:l009","ordinal":135413,"en":"My mother Kanykey went away in grief;"},{"id":"semetey-1-2013:p0771:b005:l010","ordinal":135414,"en":"This is how I shall take revenge on you!”"},{"id":"semetey-1-2013:p0771:b005:l011","ordinal":135415,"en":"When Kobosh came near,"},{"id":"semetey-1-2013:p0771:b005:l012","ordinal":135416,"en":"Manas's son, that splendid hero,"},{"id":"semetey-1-2013:p0771:b005:l013","ordinal":135417,"en":"Struck him square upon the jaw,"},{"id":"semetey-1-2013:p0771:b005:l014","ordinal":135418,"en":"Punched him on the other cheek."},{"id":"semetey-1-2013:p0771:b005:l015","ordinal":135419,"en":"Than his father, wolf-maned Manas,"},{"id":"semetey-1-2013:p0771:b005:l016","ordinal":135420,"en":"Your orphan had been born greater."},{"id":"semetey-1-2013:p0771:b005:l017","ordinal":135421,"en":"What could poor Kobosh do?"},{"id":"semetey-1-2013:p0771:b005:l018","ordinal":135422,"en":"When the fist struck his cheek,"},{"id":"semetey-1-2013:p0771:b005:l019","ordinal":135423,"en":"His eyes went darting wildly,"},{"id":"semetey-1-2013:p0771:b005:l020","ordinal":135424,"en":"His senses reeled away."}]
