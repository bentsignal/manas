[{"id":"semetey-1-2013:p0615:b004:l017","ordinal":123649,"en":"Perhaps I too should enter."},{"id":"semetey-1-2013:p0615:b004:l018","ordinal":123650,"en":"Alas, beside my sultan father"},{"id":"semetey-1-2013:p0615:b004:l019","ordinal":123651,"en":"Perhaps I too should lie!"},{"id":"semetey-1-2013:p0615:b004:l020","ordinal":123652,"en":"Between him and the girl he embraces,"},{"id":"semetey-1-2013:p0615:b004:l021","ordinal":123653,"en":"Perhaps I should enter."},{"id":"semetey-1-2013:p0615:b004:l022","ordinal":123654,"en":"What a marvel, what a thing!"},{"id":"semetey-1-2013:p0615:b004:l023","ordinal":123655,"en":"What misfortune, what a dream!"},{"id":"semetey-1-2013:p0615:b004:l024","ordinal":123656,"en":"If I lie with my father and die,"},{"id":"semetey-1-2013:p0615:b004:l025","ordinal":123657,"en":"My old leopard uncle,"},{"id":"semetey-1-2013:p0615:b004:l026","ordinal":123658,"en":"Will my uncle Khan Bakai die?"},{"id":"semetey-1-2013:p0615:b004:l027","ordinal":123659,"en":"My grieving mother Kanykei,"},{"id":"semetey-1-2013:p0615:b004:l028","ordinal":123660,"en":"Will she see torment again?"},{"id":"semetey-1-2013:p0615:b004:l029","ordinal":123661,"en":"Chyiyrdy, at ninety-five,"},{"id":"semetey-1-2013:p0615:b004:l030","ordinal":123662,"en":"Will she plunge a knife into herself?"},{"id":"semetey-1-2013:p0615:b004:l031","ordinal":123663,"en":"Will all these people suddenly"},{"id":"semetey-1-2013:p0615:b004:l032","ordinal":123664,"en":"Be struck by death?"},{"id":"semetey-1-2013:p0615:b004:l033","ordinal":123665,"en":"My uncle Bakai, blessed by Kydyr,"},{"id":"semetey-1-2013:p0615:b004:l034","ordinal":123666,"en":"Let me ask him about this wonder."},{"id":"semetey-1-2013:p0615:b004:l035","ordinal":123667,"en":"He teaches what I do not know;"},{"id":"semetey-1-2013:p0615:b004:l036","ordinal":123668,"en":"Let me go to my uncle."},{"id":"semetey-1-2013:p0615:b004:l037","ordinal":123669,"en":"O Almighty, a thousand times I repent!"},{"id":"semetey-1-2013:p0615:b004:l038","ordinal":123670,"en":"My lion father's state"},{"id":"semetey-1-2013:p0615:b004:l039","ordinal":123671,"en":"Let me tell Khan Bakai."},{"id":"semetey-1-2013:p0616:b003:l001","ordinal":123672,"en":"Let me gather every word."},{"id":"semetey-1-2013:p0616:b003:l002","ordinal":123673,"en":"From my wise uncle Bakai"},{"id":"semetey-1-2013:p0616:b003:l003","ordinal":123674,"en":"Let me ask about this.”"},{"id":"semetey-1-2013:p0616:b003:l004","ordinal":123675,"en":"So saying, Semetey"},{"id":"semetey-1-2013:p0616:b003:l005","ordinal":123676,"en":"Came out of the cave, calling aloud."},{"id":"semetey-1-2013:p0616:b003:l006","ordinal":123677,"en":"To his uncle Sultan Bakai"},{"id":"semetey-1-2013:p0616:b003:l007","ordinal":123678,"en":"He waved his hand and called."},{"id":"semetey-1-2013:p0616:b003:l008","ordinal":123679,"en":"When Bakai came near,"},{"id":"semetey-1-2013:p0616:b003:l009","ordinal":123680,"en":"“Warrior uncle, hear my words."},{"id":"semetey-1-2013:p0616:b003:l010","ordinal":123681,"en":"Let me stay as your guest tonight,"},{"id":"semetey-1-2013:p0616:b003:l011","ordinal":123682,"en":"And tell you my tale.”"},{"id":"semetey-1-2013:p0616:b003:l012","ordinal":123683,"en":"Then Bakai said:"},{"id":"semetey-1-2013:p0616:b003:l013","ordinal":123684,"en":"“I know your tale."},{"id":"semetey-1-2013:p0616:b003:l014","ordinal":123685,"en":"May your journey prosper, Semetey."},{"id":"semetey-1-2013:p0616:b003:l015","ordinal":123686,"en":"May God set your affairs right."},{"id":"semetey-1-2013:p0616:b003:l016","ordinal":123687,"en":"He was a lion whose spirit lives;"},{"id":"semetey-1-2013:p0616:b003:l017","ordinal":123688,"en":"May your father Manas protect you!"},{"id":"semetey-1-2013:p0616:b003:l018","ordinal":123689,"en":"Pledged to twelve spiritual masters,"},{"id":"semetey-1-2013:p0616:b003:l019","ordinal":123690,"en":"That is your saintly lion father."},{"id":"semetey-1-2013:p0616:b003:l020","ordinal":123691,"en":"Appearing before your eyes,"},{"id":"semetey-1-2013:p0616:b003:l021","ordinal":123692,"en":"That is how he gives his aid."},{"id":"semetey-1-2013:p0616:b003:l022","ordinal":123693,"en":"Your father Manas, blessed by Kydyr—"},{"id":"semetey-1-2013:p0616:b003:l023","ordinal":123694,"en":"That is how he sets things right.”"},{"id":"semetey-1-2013:p0616:b003:l024","ordinal":123695,"en":"So saying, Khan Bakai"},{"id":"semetey-1-2013:p0616:b003:l025","ordinal":123696,"en":"Took the dark stone as large as a small tent"},{"id":"semetey-1-2013:p0616:b003:l026","ordinal":123697,"en":"Up into his hands."},{"id":"semetey-1-2013:p0616:b003:l027","ordinal":123698,"en":"Bakai sealed it in an instant."},{"id":"semetey-1-2013:p0616:b003:l028","ordinal":123699,"en":"One could not see it by looking;"},{"id":"semetey-1-2013:p0616:b003:l029","ordinal":123700,"en":"The cave vanished into the unseen."},{"id":"semetey-1-2013:p0616:b003:l030","ordinal":123701,"en":"Its whereabouts could not be known;"},{"id":"semetey-1-2013:p0616:b003:l031","ordinal":123702,"en":"The cave disappeared."},{"id":"semetey-1-2013:p0616:b003:l032","ordinal":123703,"en":"Bakai sealed the cave,"},{"id":"semetey-1-2013:p0616:b003:l033","ordinal":123704,"en":"And when it had vanished,"},{"id":"semetey-1-2013:p0616:b003:l034","ordinal":123705,"en":"Semetey stood gazing."},{"id":"semetey-1-2013:p0616:b003:l035","ordinal":123706,"en":"The rascal left by Manas"},{"id":"semetey-1-2013:p0616:b003:l036","ordinal":123707,"en":"Astonished at this wonder:"},{"id":"semetey-1-2013:p0616:b003:l037","ordinal":123708,"en":"“My father is a lion!"},{"id":"semetey-1-2013:p0616:b003:l038","ordinal":123709,"en":"He is a warrior whose spirit is present."},{"id":"semetey-1-2013:p0616:b003:l039","ordinal":123710,"en":"For this small Muslim people"},{"id":"semetey-1-2013:p0616:b004:l001","ordinal":123711,"en":"He was a fortress built of iron."},{"id":"semetey-1-2013:p0616:b004:l002","ordinal":123712,"en":"May I be sacrificed to God!"},{"id":"semetey-1-2013:p0616:b004:l003","ordinal":123713,"en":"My father who went to the next world"},{"id":"semetey-1-2013:p0616:b004:l004","ordinal":123714,"en":"Was a lion unequaled on earth."},{"id":"semetey-1-2013:p0616:b004:l005","ordinal":123715,"en":"Uncle Bakai, hear my words."},{"id":"semetey-1-2013:p0616:b004:l006","ordinal":123716,"en":"When my father Manas died,"},{"id":"semetey-1-2013:p0616:b004:l007","ordinal":123717,"en":"When they said the funeral prayer for him,"},{"id":"semetey-1-2013:p0616:b004:l008","ordinal":123718,"en":"When his people gathered and buried him,"},{"id":"semetey-1-2013:p0616:b004:l009","ordinal":123719,"en":"With how many people did you bury him?"},{"id":"semetey-1-2013:p0616:b004:l010","ordinal":123720,"en":"Laying a girl in his embrace,"},{"id":"semetey-1-2013:p0616:b004:l012","ordinal":123721,"en":"Uncle, you gave him a wondrous burial.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0616:b004:l013","ordinal":123722,"en":"My father is not alone."},{"id":"semetey-1-2013:p0616:b004:l014","ordinal":123723,"en":"Uncle Bakai, hear my words."},{"id":"semetey-1-2013:p0616:b004:l015","ordinal":123724,"en":"You buried him with six people!"},{"id":"semetey-1-2013:p0616:b004:l016","ordinal":123725,"en":"Let me understand every sign."},{"id":"semetey-1-2013:p0616:b004:l017","ordinal":123726,"en":"Uncle Bakai, tell me.”"},{"id":"semetey-1-2013:p0616:b004:l018","ordinal":123727,"en":"The boy spoke; I understood."},{"id":"semetey-1-2013:p0616:b004:l019","ordinal":123728,"en":"“The one who lies on his right—"},{"id":"semetey-1-2013:p0616:b004:l020","ordinal":123729,"en":"Your father blessed by Kydyr"},{"id":"semetey-1-2013:p0616:b004:l021","ordinal":123730,"en":"Met all the mighty men."},{"id":"semetey-1-2013:p0616:b004:l022","ordinal":123731,"en":"Your father blessed by Baabedin"},{"id":"semetey-1-2013:p0616:b004:l023","ordinal":123732,"en":"Was matched by all the heroes."},{"id":"semetey-1-2013:p0616:b004:l024","ordinal":123733,"en":"Your lion father Manas, stirred to action,"},{"id":"semetey-1-2013:p0616:b004:l025","ordinal":123734,"en":"That leopard himself"},{"id":"semetey-1-2013:p0616:b004:l026","ordinal":123735,"en":"Met many fierce-maned warriors."},{"id":"semetey-1-2013:p0616:b004:l027","ordinal":123736,"en":"They migrated to Talas,"},{"id":"semetey-1-2013:p0616:b004:l028","ordinal":123737,"en":"And became companions in this way"},{"id":"semetey-1-2013:p0616:b004:l029","ordinal":123738,"en":"To your father, the late Manas."},{"id":"semetey-1-2013:p0616:b004:l030","ordinal":123739,"en":"The one who lies on his right—"},{"id":"semetey-1-2013:p0616:b004:l031","ordinal":123740,"en":"Long ago he fled the infidels and became their stranger,"},{"id":"semetey-1-2013:p0616:b004:l032","ordinal":123741,"en":"Was cleansed of the dark faith."},{"id":"semetey-1-2013:p0616:b004:l033","ordinal":123742,"en":"Stars stirred in the heavens."},{"id":"semetey-1-2013:p0616:b004:l034","ordinal":123743,"en":"They became friends for the next world."},{"id":"semetey-1-2013:p0616:b004:l035","ordinal":123744,"en":"He settled in Talas,"},{"id":"semetey-1-2013:p0616:b004:l036","ordinal":123745,"en":"And became a companion to your father Sultan Manas."},{"id":"semetey-1-2013:p0616:b004:l037","ordinal":123746,"en":"They fought their enemies together,"},{"id":"semetey-1-2013:p0616:b004:l038","ordinal":123747,"en":"Pressed their claims together,"},{"id":"semetey-1-2013:p0616:b004:l039","ordinal":123748,"en":"Scouted together,"},{"id":"semetey-1-2013:p0617:b003:l001","ordinal":123749,"en":"They took horses from foreign-speaking people together."},{"id":"semetey-1-2013:p0617:b003:l002","ordinal":123750,"en":"To Beijing with its Khagan,"},{"id":"semetey-1-2013:p0617:b003:l003","ordinal":123751,"en":"When Manas went on campaign,"},{"id":"semetey-1-2013:p0617:b003:l004","ordinal":123752,"en":"Against mighty Beijing's Khagan,"},{"id":"semetey-1-2013:p0617:b003:l005","ordinal":123753,"en":"When he unleashed turmoil,"},{"id":"semetey-1-2013:p0617:b003:l006","ordinal":123754,"en":"Into looming Beijing,"},{"id":"semetey-1-2013:p0617:b003:l007","ordinal":123755,"en":"When he entered straight and thrust his spear,"},{"id":"semetey-1-2013:p0617:b003:l008","ordinal":123756,"en":"From hell of grievous torment,"},{"id":"semetey-1-2013:p0617:b003:l009","ordinal":123757,"en":"When he freed the soul,"},{"id":"semetey-1-2013:p0617:b003:l010","ordinal":123758,"en":"Untiring when he scouted,"},{"id":"semetey-1-2013:p0617:b003:l011","ordinal":123759,"en":"Untroubled when he entered the army's rear,"},{"id":"semetey-1-2013:p0617:b003:l012","ordinal":123760,"en":"Unworried when he went on campaign,"},{"id":"semetey-1-2013:p0617:b003:l013","ordinal":123761,"en":"A hungry lion, a peerless warrior,"},{"id":"semetey-1-2013:p0617:b003:l014","ordinal":123762,"en":"A noble hero like Alake."},{"id":"semetey-1-2013:p0617:b003:l015","ordinal":123763,"en":"All the peoples rose,"},{"id":"semetey-1-2013:p0617:b003:l016","ordinal":123764,"en":"Forming forty-two vast hosts."},{"id":"semetey-1-2013:p0617:b003:l017","ordinal":123765,"en":"Drenched in dark blood,"},{"id":"semetey-1-2013:p0617:b003:l018","ordinal":123766,"en":"They fought six months without fleeing."},{"id":"semetey-1-2013:p0617:b003:l019","ordinal":123767,"en":"Fleet-footed runners among the Chinese died;"},{"id":"semetey-1-2013:p0617:b003:l020","ordinal":123768,"en":"Many brave men and giants died."},{"id":"semetey-1-2013:p0617:b003:l021","ordinal":123769,"en":"There were countless multitudes of people."},{"id":"semetey-1-2013:p0617:b003:l022","ordinal":123770,"en":"Your father's banner was raised"},{"id":"semetey-1-2013:p0617:b003:l023","ordinal":123771,"en":"By me, your poor uncle Bakai."},{"id":"semetey-1-2013:p0617:b003:l024","ordinal":123772,"en":"When the Muslim people"},{"id":"semetey-1-2013:p0617:b003:l025","ordinal":123773,"en":"Were distraught and confused,"},{"id":"semetey-1-2013:p0617:b003:l026","ordinal":123774,"en":"The Muslim folk fled in panic,"},{"id":"semetey-1-2013:p0617:b003:l028","ordinal":123775,"en":"Your father Manas, the peerless lion,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0617:b003:l029","ordinal":123776,"en":"Against the red-naveled Chinese"},{"id":"semetey-1-2013:p0617:b003:l030","ordinal":123777,"en":"Roared and unleashed slaughter."},{"id":"semetey-1-2013:p0617:b003:l031","ordinal":123778,"en":"There was not one Muslim left—"},{"id":"semetey-1-2013:p0617:b003:l032","ordinal":123779,"en":"Almambet and Chubak, their names paired,"},{"id":"semetey-1-2013:p0617:b003:l033","ordinal":123780,"en":"Azhibai and Bakai, the two khans,"},{"id":"semetey-1-2013:p0617:b003:l034","ordinal":123781,"en":"Serek and Syrgak, all the warriors,"},{"id":"semetey-1-2013:p0617:b003:l035","ordinal":123782,"en":"These forty Muslims,"},{"id":"semetey-1-2013:p0617:b003:l036","ordinal":123783,"en":"And Manas the Leopard, the finest steed—"},{"id":"semetey-1-2013:p0617:b003:l037","ordinal":123784,"en":"When they fought without turning away,"},{"id":"semetey-1-2013:p0617:b003:l038","ordinal":123785,"en":"The more they were spent, the more they blazed;"},{"id":"semetey-1-2013:p0617:b003:l039","ordinal":123786,"en":"From their very roots they grew stronger."},{"id":"semetey-1-2013:p0617:b005:l001","ordinal":123787,"en":"The more they died, the more they increased;"},{"id":"semetey-1-2013:p0617:b005:l002","ordinal":123788,"en":"The mighty Chinese grew stronger."},{"id":"semetey-1-2013:p0617:b005:l003","ordinal":123789,"en":"News was sent to their khan,"},{"id":"semetey-1-2013:p0617:b005:l004","ordinal":123790,"en":"Their courageous warrior Konurbai,"},{"id":"semetey-1-2013:p0617:b005:l005","ordinal":123791,"en":"To the city of the Khagan Khan."},{"id":"semetey-1-2013:p0617:b005:l006","ordinal":123792,"en":"The earth was rent and shook."},{"id":"semetey-1-2013:p0617:b005:l007","ordinal":123793,"en":"Seventy peoples came."},{"id":"semetey-1-2013:p0617:b005:l008","ordinal":123794,"en":"There were many, many giants."},{"id":"semetey-1-2013:p0617:b005:l009","ordinal":123795,"en":"Of Beijing's Chinese and Manchu,"},{"id":"semetey-1-2013:p0617:b005:l010","ordinal":123796,"en":"All the champions were there."},{"id":"semetey-1-2013:p0617:b005:l011","ordinal":123797,"en":"Warrior Konurbai was there as well."},{"id":"semetey-1-2013:p0617:b005:l012","ordinal":123798,"en":"The infidels on campaign"},{"id":"semetey-1-2013:p0617:b005:l013","ordinal":123799,"en":"Had rhinoceroses and mules among their beasts."},{"id":"semetey-1-2013:p0617:b005:l014","ordinal":123800,"en":"Teeming like ants,"},{"id":"semetey-1-2013:p0617:b005:l015","ordinal":123801,"en":"Swarming more thickly than mosquitoes,"},{"id":"semetey-1-2013:p0617:b005:l016","ordinal":123802,"en":"Iron-headed giants strode about;"},{"id":"semetey-1-2013:p0617:b005:l017","ordinal":123803,"en":"Their strongmen went on foot."},{"id":"semetey-1-2013:p0617:b005:l018","ordinal":123804,"en":"The Chinese swarmed around them;"},{"id":"semetey-1-2013:p0617:b005:l019","ordinal":123805,"en":"The Khagan's people seethed."},{"id":"semetey-1-2013:p0617:b005:l020","ordinal":123806,"en":"The Chinese thundered in multitudes."},{"id":"semetey-1-2013:p0617:b005:l021","ordinal":123807,"en":"Then the Kyrgyz army dwindled, man by man."},{"id":"semetey-1-2013:p0617:b005:l022","ordinal":123808,"en":"The four khans' peoples, the filthy Sarts,"},{"id":"semetey-1-2013:p0617:b005:l023","ordinal":123809,"en":"When they fled toward Islam,"},{"id":"semetey-1-2013:p0617:b005:l024","ordinal":123810,"en":"A palmful of Muslims remained,"},{"id":"semetey-1-2013:p0617:b005:l025","ordinal":123811,"en":"With your fierce-maned father Manas."},{"id":"semetey-1-2013:p0617:b005:l026","ordinal":123812,"en":"They fought in turns,"},{"id":"semetey-1-2013:p0617:b005:l027","ordinal":123813,"en":"Taking turns to stand their ground."},{"id":"semetey-1-2013:p0617:b005:l028","ordinal":123814,"en":"The strongmen broke the ranks with spears."},{"id":"semetey-1-2013:p0617:b005:l029","ordinal":123815,"en":"Those whose death had come fell to bullets."},{"id":"semetey-1-2013:p0617:b005:l030","ordinal":123816,"en":"They faced nets of iron rope,"},{"id":"semetey-1-2013:p0617:b005:l031","ordinal":123817,"en":"Suffered terrible, mighty torment."},{"id":"semetey-1-2013:p0617:b005:l032","ordinal":123818,"en":"When they went against the Khagan Khan,"},{"id":"semetey-1-2013:p0617:b005:l033","ordinal":123819,"en":"When they unleashed turmoil,"},{"id":"semetey-1-2013:p0617:b005:l034","ordinal":123820,"en":"Mankush and the giant Doodur,"},{"id":"semetey-1-2013:p0617:b005:l035","ordinal":123821,"en":"Azhibai of the Argyn khan—"},{"id":"semetey-1-2013:p0617:b005:l037","ordinal":123822,"en":"Kartkurong of sixty mature years,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0617:b005:l038","ordinal":123823,"en":"By the mighty strongman Lama,"},{"id":"semetey-1-2013:p0617:b005:l039","ordinal":123824,"en":"When he was taken captive,"},{"id":"semetey-1-2013:p0618:b003:l001","ordinal":123825,"en":"This is the Chinese custom:"},{"id":"semetey-1-2013:p0618:b003:l002","ordinal":123826,"en":"At all times the infidels"},{"id":"semetey-1-2013:p0618:b003:l003","ordinal":123827,"en":"Have the custom of carrying a banner."},{"id":"semetey-1-2013:p0618:b003:l004","ordinal":123828,"en":"Upon Kartkurong's legs"},{"id":"semetey-1-2013:p0618:b003:l005","ordinal":123829,"en":"They put iron hobbles."},{"id":"semetey-1-2013:p0618:b003:l006","ordinal":123830,"en":"Deafening his ears and head,"},{"id":"semetey-1-2013:p0618:b003:l007","ordinal":123831,"en":"They bound him with straps."},{"id":"semetey-1-2013:p0618:b003:l008","ordinal":123832,"en":"When the Chinese day of triumph came,"},{"id":"semetey-1-2013:p0618:b003:l009","ordinal":123833,"en":"That infidel mounted Kartkurong."},{"id":"semetey-1-2013:p0618:b003:l010","ordinal":123834,"en":"The Chinese red banner,"},{"id":"semetey-1-2013:p0618:b003:l011","ordinal":123835,"en":"Without letting it tilt a hair,"},{"id":"semetey-1-2013:p0618:b003:l012","ordinal":123836,"en":"Lama held upright."},{"id":"semetey-1-2013:p0618:b003:l013","ordinal":123837,"en":"On the horse Ai-sarala,"},{"id":"semetey-1-2013:p0618:b003:l015","ordinal":123838,"en":"He who was your father's sworn brother,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0618:b003:l016","ordinal":123839,"en":"The noble lion named Almambet—"},{"id":"semetey-1-2013:p0618:b003:l017","ordinal":123840,"en":"That was where he fought the slaughter."},{"id":"semetey-1-2013:p0618:b003:l018","ordinal":123841,"en":"Cloudy by day, clear by night,"},{"id":"semetey-1-2013:p0618:b003:l019","ordinal":123842,"en":"Drizzle turning to snow in gusts of wind—"},{"id":"semetey-1-2013:p0618:b003:l020","ordinal":123843,"en":"When Almambet worked his weather magic,"},{"id":"semetey-1-2013:p0618:b003:l021","ordinal":123844,"en":"For fourteen days and nights"},{"id":"semetey-1-2013:p0618:b003:l022","ordinal":123845,"en":"He bewitched the weather."},{"id":"semetey-1-2013:p0618:b003:l023","ordinal":123846,"en":"All the foothills were pelted with hail;"},{"id":"semetey-1-2013:p0618:b003:l024","ordinal":123847,"en":"All the lower country was drenched with rain."},{"id":"semetey-1-2013:p0618:b003:l025","ordinal":123848,"en":"None could stand and face"},{"id":"semetey-1-2013:p0618:b003:l026","ordinal":123849,"en":"Almambet's lion-like might."},{"id":"semetey-1-2013:p0618:b003:l027","ordinal":123850,"en":"The many Chinese and Manchu people"},{"id":"semetey-1-2013:p0618:b003:l028","ordinal":123851,"en":"Were thrown into turmoil and shattered."},{"id":"semetey-1-2013:p0618:b003:l029","ordinal":123852,"en":"Fierce-maned Khan Almambet's"},{"id":"semetey-1-2013:p0618:b003:l030","ordinal":123853,"en":"Wrath—how could they endure it?"},{"id":"semetey-1-2013:p0618:b003:l031","ordinal":123854,"en":"Turning summer's day to winter,"},{"id":"semetey-1-2013:p0618:b003:l032","ordinal":123855,"en":"The thinly dressed Chinese"},{"id":"semetey-1-2013:p0618:b003:l033","ordinal":123856,"en":"He made whimper like girls."},{"id":"semetey-1-2013:p0618:b003:l034","ordinal":123857,"en":"Girding his waist firmly,"},{"id":"semetey-1-2013:p0618:b003:l035","ordinal":123858,"en":"Against seven vast hosts of Black Chinese,"},{"id":"semetey-1-2013:p0618:b003:l036","ordinal":123859,"en":"Almam alone attacked."},{"id":"semetey-1-2013:p0618:b003:l037","ordinal":123860,"en":"Striking Sarala once upon the thigh,"},{"id":"semetey-1-2013:p0618:b003:l038","ordinal":123861,"en":"Furious and grim,"},{"id":"semetey-1-2013:p0618:b003:l039","ordinal":123862,"en":"Almam the Leopard attacked."},{"id":"semetey-1-2013:p0618:b004:l001","ordinal":123863,"en":"The giant Doodur, khan of the dog-eaters,"},{"id":"semetey-1-2013:p0618:b004:l002","ordinal":123864,"en":"And Lama, khan of the Shibe—"},{"id":"semetey-1-2013:p0618:b004:l003","ordinal":123865,"en":"When he reached the two together,"},{"id":"semetey-1-2013:p0618:b004:l004","ordinal":123866,"en":"He brought them both down from their horses,"},{"id":"semetey-1-2013:p0618:b004:l005","ordinal":123867,"en":"Thrusting his spear into them in turn."},{"id":"semetey-1-2013:p0618:b004:l006","ordinal":123868,"en":"When Alake split the giant Doodur"},{"id":"semetey-1-2013:p0618:b004:l007","ordinal":123869,"en":"Into two pieces,"},{"id":"semetey-1-2013:p0618:b004:l008","ordinal":123870,"en":"When Alake reached Lama"},{"id":"semetey-1-2013:p0618:b004:l009","ordinal":123871,"en":"And took his head,"},{"id":"semetey-1-2013:p0618:b004:l010","ordinal":123872,"en":"Lama's club-like hair—"},{"id":"semetey-1-2013:p0618:b004:l011","ordinal":123873,"en":"He stripped off the scalp like a hide,"},{"id":"semetey-1-2013:p0618:b004:l012","ordinal":123874,"en":"And when Almam put it on his head,"},{"id":"semetey-1-2013:p0618:b004:l013","ordinal":123875,"en":"He went about as Lama."},{"id":"semetey-1-2013:p0618:b004:l014","ordinal":123876,"en":"When the Chinese went on campaign,"},{"id":"semetey-1-2013:p0618:b004:l015","ordinal":123877,"en":"When Manas the Leopard was hard pressed,"},{"id":"semetey-1-2013:p0618:b004:l016","ordinal":123878,"en":"Dressed in Lama's coat,"},{"id":"semetey-1-2013:p0618:b004:l017","ordinal":123879,"en":"The Chinese red banner,"},{"id":"semetey-1-2013:p0618:b004:l018","ordinal":123880,"en":"My Alake, blessed by Kydyr,"},{"id":"semetey-1-2013:p0618:b004:l019","ordinal":123881,"en":"Carried away toward Beijing."},{"id":"semetey-1-2013:p0618:b004:l020","ordinal":123882,"en":"When he went to the Kalmyks,"},{"id":"semetey-1-2013:p0618:b004:l021","ordinal":123883,"en":"“The banner is fleeing!” he shouted,"},{"id":"semetey-1-2013:p0618:b004:l022","ordinal":123884,"en":"Raising a battle cry in Kalmyk."},{"id":"semetey-1-2013:p0618:b004:l023","ordinal":123885,"en":"When he went to the Solon,"},{"id":"semetey-1-2013:p0618:b004:l024","ordinal":123886,"en":"He called out in Solon,"},{"id":"semetey-1-2013:p0618:b004:l025","ordinal":123887,"en":"Saying, “The banner is fleeing!”"},{"id":"semetey-1-2013:p0618:b004:l026","ordinal":123888,"en":"When he went to the Shibe,"},{"id":"semetey-1-2013:p0618:b004:l027","ordinal":123889,"en":"He clamored in Shibe,"},{"id":"semetey-1-2013:p0618:b004:l028","ordinal":123890,"en":"Babbling, “The banner is fleeing!”"},{"id":"semetey-1-2013:p0618:b004:l029","ordinal":123891,"en":"When he went to the Manchu,"},{"id":"semetey-1-2013:p0618:b004:l030","ordinal":123892,"en":"He chattered like the Manchu,"},{"id":"semetey-1-2013:p0618:b004:l031","ordinal":123893,"en":"Rattling out, “The banner is fleeing!”"},{"id":"semetey-1-2013:p0618:b004:l032","ordinal":123894,"en":"When he went to the Torgut,"},{"id":"semetey-1-2013:p0618:b004:l034","ordinal":123895,"en":"He shouted in Torgut,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0618:b004:l035","ordinal":123896,"en":"Raising a clamor: “The banner is fleeing!”"},{"id":"semetey-1-2013:p0618:b004:l036","ordinal":123897,"en":"When he went to the Chinese,"},{"id":"semetey-1-2013:p0618:b004:l037","ordinal":123898,"en":"He shouted like the Chinese,"},{"id":"semetey-1-2013:p0618:b004:l038","ordinal":123899,"en":"Making his voice like a girl's,"},{"id":"semetey-1-2013:p0618:b004:l039","ordinal":123900,"en":"Whimpering like young girls,"},{"id":"semetey-1-2013:p0619:b003:l001","ordinal":123901,"en":"Calling, “The banner is fleeing!”"},{"id":"semetey-1-2013:p0619:b003:l002","ordinal":123902,"en":"Speaking in the tongues of forty tribes,"},{"id":"semetey-1-2013:p0619:b003:l003","ordinal":123903,"en":"When Alake fled toward Beijing,"},{"id":"semetey-1-2013:p0619:b003:l005","ordinal":123904,"en":"The many Chinese, the peoples of forty khans,"}]
