[{"id":"seytek-2012:p0512:b005:l030","ordinal":332801,"en":"The warriors who posed as champions,"},{"id":"seytek-2012:p0512:b005:l031","ordinal":332802,"en":"Exalting themselves,"},{"id":"seytek-2012:p0512:b005:l032","ordinal":332803,"en":"Those who said, “I am a champion,”"},{"id":"seytek-2012:p0512:b005:l033","ordinal":332804,"en":"Threw away their lives."},{"id":"seytek-2012:p0512:b006:l001","ordinal":332805,"en":"While the army stood thus,"},{"id":"seytek-2012:p0512:b006:l002","ordinal":332806,"en":"The earth heaved like lake and river;"},{"id":"seytek-2012:p0512:b006:l003","ordinal":332807,"en":"While the people stood thus,"},{"id":"seytek-2012:p0512:b006:l004","ordinal":332808,"en":"The whitening dawn broke,"},{"id":"seytek-2012:p0512:b006:l005","ordinal":332809,"en":"Pouring light upon the earth."},{"id":"seytek-2012:p0512:b006:l006","ordinal":332810,"en":"As day began to dawn,"},{"id":"seytek-2012:p0512:b006:l007","ordinal":332811,"en":"The cold wind before sunrise"},{"id":"seytek-2012:p0512:b006:l008","ordinal":332812,"en":"Swept down the valley;"},{"id":"seytek-2012:p0512:b006:l009","ordinal":332813,"en":"The reed tops shivered,"},{"id":"seytek-2012:p0512:b006:l010","ordinal":332814,"en":"Young larks clamored,"},{"id":"seytek-2012:p0512:b006:l011","ordinal":332815,"en":"All living creatures stirred,"},{"id":"seytek-2012:p0512:b006:l012","ordinal":332816,"en":"Every beast awoke."},{"id":"seytek-2012:p0512:b006:l013","ordinal":332817,"en":"One by one the stars in heaven"},{"id":"seytek-2012:p0512:b006:l014","ordinal":332818,"en":"Quivered toward the qibla;"},{"id":"seytek-2012:p0512:b006:l015","ordinal":332819,"en":"The stars overhead glittered,"},{"id":"seytek-2012:p0512:b006:l016","ordinal":332820,"en":"Hurrying toward the qibla."},{"id":"seytek-2012:p0512:b006:l017","ordinal":332821,"en":"The dawn opened bright,"},{"id":"seytek-2012:p0512:b006:l018","ordinal":332822,"en":"The earth’s twilight withdrew;"},{"id":"seytek-2012:p0512:b006:l019","ordinal":332823,"en":"A light breeze rose to a wind,"},{"id":"seytek-2012:p0512:b006:l020","ordinal":332824,"en":"And the land appeared, filled with troops."},{"id":"seytek-2012:p0512:b006:l021","ordinal":332825,"en":"Shapes emerged from the darkness,"},{"id":"seytek-2012:p0512:b006:l022","ordinal":332826,"en":"And the face of the world appeared."},{"id":"seytek-2012:p0512:b006:l023","ordinal":332827,"en":"When they gathered their baggage,"},{"id":"seytek-2012:p0512:b006:l024","ordinal":332828,"en":"And the camp began to move,"},{"id":"seytek-2012:p0512:b006:l025","ordinal":332829,"en":"The sentries on watch—"},{"id":"seytek-2012:p0512:b006:l026","ordinal":332830,"en":"Those who scouted land and road,"},{"id":"seytek-2012:p0512:b006:l027","ordinal":332831,"en":"And learned the enemy’s order—"},{"id":"seytek-2012:p0512:b006:l028","ordinal":332832,"en":"Surveyed the ground and searched the way,"},{"id":"seytek-2012:p0512:b006:l029","ordinal":332833,"en":"Often exchanging shots."},{"id":"seytek-2012:p0512:b006:l030","ordinal":332834,"en":"They would become entangled"},{"id":"seytek-2012:p0512:b006:l031","ordinal":332835,"en":"In every peril of the foe."},{"id":"seytek-2012:p0512:b006:l032","ordinal":332836,"en":"Dashing about in agitation,"},{"id":"seytek-2012:p0512:b006:l033","ordinal":332837,"en":"They encountered the forward guards,"},{"id":"seytek-2012:p0513:b002:l001","ordinal":332838,"en":"And came to tell the champions."},{"id":"seytek-2012:p0513:b002:l002","ordinal":332839,"en":"Those ill-fated were captured;"},{"id":"seytek-2012:p0513:b002:l003","ordinal":332840,"en":"Some champions whose death had not come"},{"id":"seytek-2012:p0513:b002:l004","ordinal":332841,"en":"Barely managed to escape."},{"id":"seytek-2012:p0513:b002:l005","ordinal":332842,"en":"Sarybai struck the doomed"},{"id":"seytek-2012:p0513:b002:l006","ordinal":332843,"en":"With mace and bow;"},{"id":"seytek-2012:p0513:b002:l007","ordinal":332844,"en":"The fortunate pressed onward,"},{"id":"seytek-2012:p0513:b002:l008","ordinal":332845,"en":"While the wretched fled back."},{"id":"seytek-2012:p0513:b002:l009","ordinal":332846,"en":"Brave hero Seytek was there,"},{"id":"seytek-2012:p0513:b002:l010","ordinal":332847,"en":"Facing them and speaking."},{"id":"seytek-2012:p0513:b002:l011","ordinal":332848,"en":"The vast army grieved,"},{"id":"seytek-2012:p0513:b002:l012","ordinal":332849,"en":"Despairing of their fly-like lives."},{"id":"seytek-2012:p0513:b002:l013","ordinal":332850,"en":"Their bodies went limp with sobbing;"},{"id":"seytek-2012:p0513:b002:l014","ordinal":332851,"en":"Unable to regain their senses,"},{"id":"seytek-2012:p0513:b002:l015","ordinal":332852,"en":"The great host stood clamoring."},{"id":"seytek-2012:p0513:b002:l016","ordinal":332853,"en":"The war drum thundered firmly;"},{"id":"seytek-2012:p0513:b002:l017","ordinal":332854,"en":"Within the army Külchoro"},{"id":"seytek-2012:p0513:b002:l018","ordinal":332855,"en":"Swept forward like a spirit,"},{"id":"seytek-2012:p0513:b002:l019","ordinal":332856,"en":"Finding counsel where none seemed possible."},{"id":"seytek-2012:p0513:b002:l020","ordinal":332857,"en":"The trumpets blared in excitement,"},{"id":"seytek-2012:p0513:b002:l021","ordinal":332858,"en":"And his trumpeter grew fervent."},{"id":"seytek-2012:p0513:b002:l022","ordinal":332859,"en":"Throwing every soul into alarm,"},{"id":"seytek-2012:p0513:b002:l023","ordinal":332860,"en":"He made the gray horse beneath him"},{"id":"seytek-2012:p0513:b002:l024","ordinal":332861,"en":"Stride forward at a stately pace,"},{"id":"seytek-2012:p0513:b002:l025","ordinal":332862,"en":"And leveled his steel weapon."},{"id":"seytek-2012:p0513:b002:l026","ordinal":332863,"en":"He swallowed up the countless host"},{"id":"seytek-2012:p0513:b002:l027","ordinal":332864,"en":"That had panicked helplessly."},{"id":"seytek-2012:p0513:b002:l028","ordinal":332865,"en":"His lashes became leaping flame,"},{"id":"seytek-2012:p0513:b002:l029","ordinal":332866,"en":"His eyes blazed like embers."},{"id":"seytek-2012:p0513:b002:l030","ordinal":332867,"en":"He gnashed his teeth with a crack,"},{"id":"seytek-2012:p0513:b002:l031","ordinal":332868,"en":"His bloodthirsty visage boiling fiercely."},{"id":"seytek-2012:p0513:b002:l032","ordinal":332869,"en":"Flaring with wrath,"},{"id":"seytek-2012:p0513:b002:l033","ordinal":332870,"en":"He addressed the great army:"},{"id":"seytek-2012:p0513:b002:l034","ordinal":332871,"en":"“Damn you, mighty host!"},{"id":"seytek-2012:p0513:b002:l035","ordinal":332872,"en":"You are lions and tigers,"},{"id":"seytek-2012:p0513:b002:l036","ordinal":332873,"en":"Imposing warriors,"},{"id":"seytek-2012:p0513:b002:l037","ordinal":332874,"en":"Who came here seeking battle!"},{"id":"seytek-2012:p0513:b002:l038","ordinal":332875,"en":"But when battle begins, you lose your heads"},{"id":"seytek-2012:p0513:b002:l039","ordinal":332876,"en":"And flee in terror—"},{"id":"seytek-2012:p0513:b002:l040","ordinal":332877,"en":"If you act so, people, you are dead!"},{"id":"seytek-2012:p0513:b003:l001","ordinal":332878,"en":"Those who escaped death"},{"id":"seytek-2012:p0513:b003:l002","ordinal":332879,"en":"Raised a clamor and fled back."},{"id":"seytek-2012:p0513:b003:l003","ordinal":332880,"en":"Some champions are wounded,"},{"id":"seytek-2012:p0513:b003:l004","ordinal":332881,"en":"While some remain wholly unharmed."},{"id":"seytek-2012:p0513:b003:l005","ordinal":332882,"en":"Some champions lost their nerve,"},{"id":"seytek-2012:p0513:b003:l006","ordinal":332883,"en":"Were soundly pierced by spears,"},{"id":"seytek-2012:p0513:b003:l007","ordinal":332884,"en":"And fled without finding a way out."},{"id":"seytek-2012:p0513:b003:l008","ordinal":332885,"en":"May God never show us his face!"},{"id":"seytek-2012:p0513:b003:l009","ordinal":332886,"en":"Sarybai is a horror,"},{"id":"seytek-2012:p0513:b003:l010","ordinal":332887,"en":"They say he turned the army from the hills;"},{"id":"seytek-2012:p0513:b003:l011","ordinal":332888,"en":"They say he slaughtered without a word"},{"id":"seytek-2012:p0513:b003:l012","ordinal":332889,"en":"All whom he encountered."},{"id":"seytek-2012:p0513:b003:l013","ordinal":332890,"en":"None can overcome him in combat,"},{"id":"seytek-2012:p0513:b003:l014","ordinal":332891,"en":"No lion’s teeth can pierce him;"},{"id":"seytek-2012:p0513:b003:l015","ordinal":332892,"en":"His form is strange, his venom strong."},{"id":"seytek-2012:p0513:b003:l016","ordinal":332893,"en":"If you encounter Sarybai,"},{"id":"seytek-2012:p0513:b003:l017","ordinal":332894,"en":"Abandon hope of life and count yourselves dead!"},{"id":"seytek-2012:p0513:b003:l018","ordinal":332895,"en":"He is fire incarnate,"},{"id":"seytek-2012:p0513:b003:l019","ordinal":332896,"en":"The eye of a devouring fiend,"},{"id":"seytek-2012:p0513:b003:l020","ordinal":332897,"en":"The very red essence of disaster."},{"id":"seytek-2012:p0513:b003:l021","ordinal":332898,"en":"We have seen Sarybai’s form:"},{"id":"seytek-2012:p0513:b003:l022","ordinal":332899,"en":"He is like a champion who ruins nations,"},{"id":"seytek-2012:p0513:b003:l023","ordinal":332900,"en":"Driving men like helpless prey,"},{"id":"seytek-2012:p0513:b003:l024","ordinal":332901,"en":"Rending them like a hungry wolf."},{"id":"seytek-2012:p0513:b003:l025","ordinal":332902,"en":"It is as though he gathered the whole world"},{"id":"seytek-2012:p0513:b003:l026","ordinal":332903,"en":"And stuffed it into a single sack."},{"id":"seytek-2012:p0513:b003:l027","ordinal":332904,"en":"Almighty Allah creates"},{"id":"seytek-2012:p0513:b003:l028","ordinal":332905,"en":"His servants in every fashion."},{"id":"seytek-2012:p0513:b003:l029","ordinal":332906,"en":"His two cheeks hang loose,"},{"id":"seytek-2012:p0513:b003:l030","ordinal":332907,"en":"As though two giants had feasted."},{"id":"seytek-2012:p0513:b003:l031","ordinal":332908,"en":"He turns all before him into desert,"},{"id":"seytek-2012:p0513:b003:l032","ordinal":332909,"en":"As though gulping them down whole."},{"id":"seytek-2012:p0513:b003:l033","ordinal":332910,"en":"No vast host can advance against him;"},{"id":"seytek-2012:p0513:b003:l034","ordinal":332911,"en":"None who fights him can survive."},{"id":"seytek-2012:p0513:b003:l035","ordinal":332912,"en":"Black-browed like a recumbent hound,"},{"id":"seytek-2012:p0513:b003:l036","ordinal":332913,"en":"As though vultures roosted upon him,"},{"id":"seytek-2012:p0513:b003:l037","ordinal":332914,"en":"He gnaws whoever meets him,"},{"id":"seytek-2012:p0513:b003:l038","ordinal":332915,"en":"As though swallowing them whole—"},{"id":"seytek-2012:p0513:b003:l039","ordinal":332916,"en":"Such is Sarybai’s appearance."},{"id":"seytek-2012:p0513:b003:l040","ordinal":332917,"en":"However hard each man may struggle,"},{"id":"seytek-2012:p0514:b002:l001","ordinal":332918,"en":"“If I do not slaughter all I meet,"},{"id":"seytek-2012:p0514:b002:l002","ordinal":332919,"en":"If in the end I do not sate myself"},{"id":"seytek-2012:p0514:b002:l003","ordinal":332920,"en":"Upon that dog Sarybai’s blood!”"},{"id":"seytek-2012:p0514:b002:l004","ordinal":332921,"en":"Hero Külchoro spoke these words;"},{"id":"seytek-2012:p0514:b002:l005","ordinal":332922,"en":"Your renowned uncle rose there,"},{"id":"seytek-2012:p0514:b002:l006","ordinal":332923,"en":"Your uncle Külchoro spoke thus,"},{"id":"seytek-2012:p0514:b002:l007","ordinal":332924,"en":"And his eyes glittered like flame."},{"id":"seytek-2012:p0514:b002:l008","ordinal":332925,"en":"When he heard of Sarybai,"},{"id":"seytek-2012:p0514:b002:l009","ordinal":332926,"en":"Fearsome rage seized him."},{"id":"seytek-2012:p0514:b002:l010","ordinal":332927,"en":"His precious, clenched teeth"},{"id":"seytek-2012:p0514:b002:l011","ordinal":332928,"en":"He ground again and again."},{"id":"seytek-2012:p0514:b002:l012","ordinal":332929,"en":"Hell showed upon his face;"},{"id":"seytek-2012:p0514:b002:l013","ordinal":332930,"en":"His lion-hearted valor"},{"id":"seytek-2012:p0514:b002:l014","ordinal":332931,"en":"Surpassed the host and set him apart."},{"id":"seytek-2012:p0514:b002:l015","ordinal":332932,"en":"He gathered himself like a blue tiger,"},{"id":"seytek-2012:p0514:b002:l016","ordinal":332933,"en":"Clad himself in armor no bullet pierced,"},{"id":"seytek-2012:p0514:b002:l017","ordinal":332934,"en":"Set all his weapons in order,"},{"id":"seytek-2012:p0514:b002:l018","ordinal":332935,"en":"And girded on his gleaming sword."},{"id":"seytek-2012:p0514:b002:l019","ordinal":332936,"en":"Hearts sank and parted,"},{"id":"seytek-2012:p0514:b002:l020","ordinal":332937,"en":"As he parted from the vast army,"},{"id":"seytek-2012:p0514:b002:l021","ordinal":332938,"en":"The tasseled standard swaying in his hand."},{"id":"seytek-2012:p0514:b002:l022","ordinal":332939,"en":"And so Külchoro,"},{"id":"seytek-2012:p0514:b002:l023","ordinal":332940,"en":"Galloping upon Surkiyik,"},{"id":"seytek-2012:p0514:b002:l024","ordinal":332941,"en":"Made the earth’s navel quake."},{"id":"seytek-2012:p0514:b002:l025","ordinal":332942,"en":"Tall and broad-shouldered,"},{"id":"seytek-2012:p0514:b002:l026","ordinal":332943,"en":"Both champion and lion,"},{"id":"seytek-2012:p0514:b002:l027","ordinal":332944,"en":"He was a seasoned hero who knew the enemy’s ways."},{"id":"seytek-2012:p0514:b002:l028","ordinal":332945,"en":"Toward the infidel of mighty arms,"},{"id":"seytek-2012:p0514:b002:l029","ordinal":332946,"en":"Toward the hero of abundant courage,"},{"id":"seytek-2012:p0514:b002:l030","ordinal":332947,"en":"Toward the infidel Sarybai,"},{"id":"seytek-2012:p0514:b002:l031","ordinal":332948,"en":"He hastened without pausing for breath,"},{"id":"seytek-2012:p0514:b002:l032","ordinal":332949,"en":"To clash fiercely in combat,"},{"id":"seytek-2012:p0514:b002:l033","ordinal":332950,"en":"To fight to the death,"},{"id":"seytek-2012:p0514:b002:l034","ordinal":332951,"en":"To wreak great slaughter,"},{"id":"seytek-2012:p0514:b002:l035","ordinal":332952,"en":"And meet him face-to-face."},{"id":"seytek-2012:p0514:b002:l036","ordinal":332953,"en":"What he said at dawn was fulfilled by dusk,"},{"id":"seytek-2012:p0514:b002:l037","ordinal":332954,"en":"And his eyes strained with expectation."},{"id":"seytek-2012:p0514:b002:l038","ordinal":332955,"en":"Gripping his spear and grinding his teeth,"},{"id":"seytek-2012:p0514:b002:l039","ordinal":332956,"en":"Truly exultant, his eyes ablaze,"},{"id":"seytek-2012:p0514:b002:l040","ordinal":332957,"en":"He went forth to single combat."},{"id":"seytek-2012:p0514:b003:l001","ordinal":332958,"en":"Do valiant champions"},{"id":"seytek-2012:p0514:b003:l002","ordinal":332959,"en":"Not die against the foe they meet?"},{"id":"seytek-2012:p0514:b003:l003","ordinal":332960,"en":"When need demands, do they not give"},{"id":"seytek-2012:p0514:b003:l004","ordinal":332961,"en":"This life to whatever cause they choose?"},{"id":"seytek-2012:p0514:b003:l005","ordinal":332962,"en":"You lost your senses,"},{"id":"seytek-2012:p0514:b003:l006","ordinal":332963,"en":"Rushed about and raised a clamor,"},{"id":"seytek-2012:p0514:b003:l007","ordinal":332964,"en":"Then fled without finding a way."},{"id":"seytek-2012:p0514:b003:l008","ordinal":332965,"en":"Here are your heroes and warriors;"},{"id":"seytek-2012:p0514:b003:l009","ordinal":332966,"en":"When you begin to stir up words,"},{"id":"seytek-2012:p0514:b003:l010","ordinal":332967,"en":"You have weaklings who grow afraid,"},{"id":"seytek-2012:p0514:b003:l011","ordinal":332968,"en":"And fools who panic without counsel."},{"id":"seytek-2012:p0514:b003:l012","ordinal":332969,"en":"You have men who throw vast armies into chaos,"},{"id":"seytek-2012:p0514:b003:l013","ordinal":332970,"en":"Break their strength, and flee."},{"id":"seytek-2012:p0514:b003:l014","ordinal":332971,"en":"You have cowards and warriors,"},{"id":"seytek-2012:p0514:b003:l015","ordinal":332972,"en":"And weaklings who spread disorder."},{"id":"seytek-2012:p0514:b003:l016","ordinal":332973,"en":"Babbling praise of Sarybai—"},{"id":"seytek-2012:p0514:b003:l017","ordinal":332974,"en":"Damn you, wretched people,"},{"id":"seytek-2012:p0514:b003:l018","ordinal":332975,"en":"God has surely cursed you!"},{"id":"seytek-2012:p0514:b003:l019","ordinal":332976,"en":"Is Sarybai such a peerless lion?"},{"id":"seytek-2012:p0514:b003:l020","ordinal":332977,"en":"Is that infidel, the monster’s son,"},{"id":"seytek-2012:p0514:b003:l021","ordinal":332978,"en":"A greater warrior than I?"},{"id":"seytek-2012:p0514:b003:l022","ordinal":332979,"en":"I shall go to the great battlefield,"},{"id":"seytek-2012:p0514:b003:l023","ordinal":332980,"en":"And grapple with Sarybai."},{"id":"seytek-2012:p0514:b003:l024","ordinal":332981,"en":"I shall fire my gun and draw my bow,"},{"id":"seytek-2012:p0514:b003:l025","ordinal":332982,"en":"And wage a relentless fight."},{"id":"seytek-2012:p0514:b003:l026","ordinal":332983,"en":"Broad Talas is no cheap land;"},{"id":"seytek-2012:p0514:b003:l027","ordinal":332984,"en":"Külchoro, born of the renowned,"},{"id":"seytek-2012:p0514:b003:l028","ordinal":332985,"en":"Is no common warrior."},{"id":"seytek-2012:p0514:b003:l029","ordinal":332986,"en":"Sarybai is the one I shall fight,"},{"id":"seytek-2012:p0514:b003:l030","ordinal":332987,"en":"That infidel whose shape is like a mountain,"},{"id":"seytek-2012:p0514:b003:l031","ordinal":332988,"en":"The warrior Khan Sarybai,"},{"id":"seytek-2012:p0514:b003:l032","ordinal":332989,"en":"The brute who scorches the earth,"},{"id":"seytek-2012:p0514:b003:l033","ordinal":332990,"en":"The champion who destroys nations."},{"id":"seytek-2012:p0514:b003:l034","ordinal":332991,"en":"I shall rain many shots upon him,"},{"id":"seytek-2012:p0514:b003:l035","ordinal":332992,"en":"And slaughter his pampered people."},{"id":"seytek-2012:p0514:b003:l036","ordinal":332993,"en":"If I do not seize his spoils,"},{"id":"seytek-2012:p0514:b003:l037","ordinal":332994,"en":"If I do not unleash a shattering battle,"},{"id":"seytek-2012:p0514:b003:l038","ordinal":332995,"en":"Standing face-to-face with him"},{"id":"seytek-2012:p0514:b003:l039","ordinal":332996,"en":"And fighting until this dear life"},{"id":"seytek-2012:p0514:b003:l040","ordinal":332997,"en":"Vanishes before all eyes,"},{"id":"seytek-2012:p0515:b002:l001","ordinal":332998,"en":"He appeared wherever he could be seen,"},{"id":"seytek-2012:p0515:b002:l002","ordinal":332999,"en":"And in unseen ravines"},{"id":"seytek-2012:p0515:b002:l003","ordinal":333000,"en":"He streamed like blue smoke."},{"id":"seytek-2012:p0515:b002:l004","ordinal":333001,"en":"His eyes shone red,"},{"id":"seytek-2012:p0515:b002:l005","ordinal":333002,"en":"His stride lengthened like an argali’s."},{"id":"seytek-2012:p0515:b002:l006","ordinal":333003,"en":"When he came to a bend,"},{"id":"seytek-2012:p0515:b002:l007","ordinal":333004,"en":"The creature proved a true courser,"},{"id":"seytek-2012:p0515:b002:l008","ordinal":333005,"en":"His eyes reddening like a stag’s."},{"id":"seytek-2012:p0515:b002:l009","ordinal":333006,"en":"When he came to winding ground,"},{"id":"seytek-2012:p0515:b002:l010","ordinal":333007,"en":"He stretched his stride and raised tumult,"},{"id":"seytek-2012:p0515:b002:l011","ordinal":333008,"en":"His fleet pace growing longer."},{"id":"seytek-2012:p0515:b002:l012","ordinal":333009,"en":"His hooves thundered on the earth;"},{"id":"seytek-2012:p0515:b002:l013","ordinal":333010,"en":"The black-steel bit"},{"id":"seytek-2012:p0515:b002:l014","ordinal":333011,"en":"Clattered in his throat."},{"id":"seytek-2012:p0515:b002:l015","ordinal":333012,"en":"He flung his forelock to the sky,"},{"id":"seytek-2012:p0515:b002:l016","ordinal":333013,"en":"And drove his hooves into the ground."},{"id":"seytek-2012:p0515:b002:l017","ordinal":333014,"en":"The black-steel bit"},{"id":"seytek-2012:p0515:b002:l018","ordinal":333015,"en":"Beat against his gullet;"},{"id":"seytek-2012:p0515:b002:l019","ordinal":333016,"en":"His willow-silk tail"},{"id":"seytek-2012:p0515:b002:l020","ordinal":333017,"en":"Lashed his spreading legs."},{"id":"seytek-2012:p0515:b002:l021","ordinal":333018,"en":"He laid back his ears like a kulan"},{"id":"seytek-2012:p0515:b002:l022","ordinal":333019,"en":"And swept the earth like a whirlwind."},{"id":"seytek-2012:p0515:b002:l023","ordinal":333020,"en":"At the sound of clamor he surged,"},{"id":"seytek-2012:p0515:b002:l024","ordinal":333021,"en":"And when he ran, the black earth"},{"id":"seytek-2012:p0515:b002:l025","ordinal":333022,"en":"Split layer upon layer—"},{"id":"seytek-2012:p0515:b002:l026","ordinal":333023,"en":"Such was the nature of that tulpar."},{"id":"seytek-2012:p0515:b002:l027","ordinal":333024,"en":"Spear in hand, breaking formations,"},{"id":"seytek-2012:p0515:b002:l028","ordinal":333025,"en":"Külchoro hastened onward."},{"id":"seytek-2012:p0515:b002:l029","ordinal":333026,"en":"He rode across the rise called Horse-Cannot-Pass,"},{"id":"seytek-2012:p0515:b002:l030","ordinal":333027,"en":"Pressing steadily forward."},{"id":"seytek-2012:p0515:b002:l031","ordinal":333028,"en":"Through the open desert of People-Cannot-Cross,"},{"id":"seytek-2012:p0515:b002:l032","ordinal":333029,"en":"He went to settle the matter."},{"id":"seytek-2012:p0515:b002:l033","ordinal":333030,"en":"Toward the infidel, the monster’s son,"},{"id":"seytek-2012:p0515:b002:l034","ordinal":333031,"en":"He went to fight to the death."},{"id":"seytek-2012:p0515:b002:l035","ordinal":333032,"en":"At the Sheer Cliff of Soul-Cannot-Pass,"},{"id":"seytek-2012:p0515:b002:l036","ordinal":333033,"en":"He went to carve a road."},{"id":"seytek-2012:p0515:b002:l037","ordinal":333034,"en":"Against the raging infidel,"},{"id":"seytek-2012:p0515:b002:l038","ordinal":333035,"en":"Against brave Sarybai,"},{"id":"seytek-2012:p0515:b002:l039","ordinal":333036,"en":"He went to launch his assault."},{"id":"seytek-2012:p0515:b002:l040","ordinal":333037,"en":"Against the master of land and water,"},{"id":"seytek-2012:p0515:b003:l001","ordinal":333038,"en":"The rabid, frenzied Sarybai,"},{"id":"seytek-2012:p0515:b003:l002","ordinal":333039,"en":"He went to capture him if his strength sufficed,"},{"id":"seytek-2012:p0515:b003:l003","ordinal":333040,"en":"To unleash terrible slaughter,"},{"id":"seytek-2012:p0515:b003:l004","ordinal":333041,"en":"To throw all into turmoil,"},{"id":"seytek-2012:p0515:b003:l005","ordinal":333042,"en":"And search every pouch"},{"id":"seytek-2012:p0515:b003:l006","ordinal":333043,"en":"Of that champion-posing swine."},{"id":"seytek-2012:p0515:b003:l007","ordinal":333044,"en":"He went to cast hell upon his ranks,"},{"id":"seytek-2012:p0515:b003:l008","ordinal":333045,"en":"To charge in and fight without stopping,"},{"id":"seytek-2012:p0515:b003:l009","ordinal":333046,"en":"And thrust that infidel Sarybai"},{"id":"seytek-2012:p0515:b003:l010","ordinal":333047,"en":"Headlong to the ground."},{"id":"seytek-2012:p0515:b003:l011","ordinal":333048,"en":"Thus matters came to pass,"},{"id":"seytek-2012:p0515:b003:l012","ordinal":333049,"en":"And Külchoro resolved"},{"id":"seytek-2012:p0515:b003:l013","ordinal":333050,"en":"To meet him face-to-face."},{"id":"seytek-2012:p0515:b003:l014","ordinal":333051,"en":"They would clash and test their strength;"},{"id":"seytek-2012:p0515:b003:l015","ordinal":333052,"en":"If fortune favored the valiant man,"},{"id":"seytek-2012:p0515:b003:l016","ordinal":333053,"en":"He would spill Sarybai’s blood,"},{"id":"seytek-2012:p0515:b003:l017","ordinal":333054,"en":"And if not, he would die."},{"id":"seytek-2012:p0515:b003:l018","ordinal":333055,"en":"Gripping his spear, steeling himself,"},{"id":"seytek-2012:p0515:b003:l019","ordinal":333056,"en":"He bit hard upon his lip."}]
