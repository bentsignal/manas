{"id": "sayakbay-ms-current142:pdf036:l041", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 36, "folio": 2353, "line_in_page": 41, "raw": "Тереңден уулу шер келди,", "text": "Тереңден уулу шер келди,", "en": "From the depths the young warrior came,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "First noun may be a personal name.", "bbox": null}
{"id": "sayakbay-ms-current142:pdf036:l042", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 36, "folio": 2353, "line_in_page": 42, "raw": "Маңдайыбыз тактайдай,", "text": "Маңдайыбыз тактайдай,", "en": "Our foreheads were like boards,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Possessive form is not fully clear.", "bbox": null}
{"id": "sayakbay-ms-current142:pdf036:l043", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 36, "folio": 2353, "line_in_page": 43, "raw": "Келбейин көргөнүң маңдайдай,", "text": "Келбейин көргөнүң маңдайдай,", "en": "What you saw without coming was like fate itself,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Reading and translation are highly tentative.", "bbox": null}
{"id": "sayakbay-ms-current142:pdf036:l044", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 36, "folio": 2353, "line_in_page": 44, "raw": "Бактысыңар зорондой,", "text": "Бактысыңар зорондой,", "en": "Your fortune seemed immense,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Final comparison suffix is unclear.", "bbox": null}
{"id": "sayakbay-ms-current142:pdf036:l045", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 36, "folio": 2353, "line_in_page": 45, "raw": "Кайра кайтып жолундай,", "text": "Кайра кайтып жолундай,", "en": "Turning back along the road,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "First word may differ.", "bbox": null}
