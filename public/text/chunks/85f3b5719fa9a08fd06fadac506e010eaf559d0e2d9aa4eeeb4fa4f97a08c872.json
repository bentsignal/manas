[{"id":"manas-2010:p1532:b001:l035","ordinal":66049,"en":"At the Chinese bringing calamity,"},{"id":"manas-2010:p1532:b001:l036","ordinal":66050,"en":"Almambet charged in"},{"id":"manas-2010:p1532:b001:l037","ordinal":66051,"en":"And entered their midst."},{"id":"manas-2010:p1532:b001:l038","ordinal":66052,"en":"Shouting, “Islam!”"},{"id":"manas-2010:p1532:b001:l039","ordinal":66053,"en":"Cow-rumped Sarala,"},{"id":"manas-2010:p1532:b001:l040","ordinal":66054,"en":"Almambet made wheel and whirl;"},{"id":"manas-2010:p1532:b001:l041","ordinal":66055,"en":"The Chinese who had pursued"},{"id":"manas-2010:p1532:b001:l042","ordinal":66056,"en":"He threw into utter confusion:"},{"id":"manas-2010:p1533:b001:l001","ordinal":66057,"en":"Shouting, “The faith of Islam!”"},{"id":"manas-2010:p1533:b001:l002","ordinal":66058,"en":"Calling the battle cry, “Manas!”"},{"id":"manas-2010:p1533:b001:l003","ordinal":66059,"en":"He drove them back, scattering them."},{"id":"manas-2010:p1533:b001:l004","ordinal":66060,"en":"Making Sarala prance,"},{"id":"manas-2010:p1533:b001:l005","ordinal":66061,"en":"Those Chinese he faced,"},{"id":"manas-2010:p1533:b001:l006","ordinal":66062,"en":"He slaughtered, making them crawl."},{"id":"manas-2010:p1533:b001:l007","ordinal":66063,"en":"When your Alma entered without mercy,"},{"id":"manas-2010:p1533:b001:l008","ordinal":66064,"en":"Look at the earth, look at the dust;"},{"id":"manas-2010:p1533:b001:l009","ordinal":66065,"en":"Falling in group after group,"},{"id":"manas-2010:p1533:b001:l010","ordinal":66066,"en":"Look at the souls lying dead!"},{"id":"manas-2010:p1533:b001:l011","ordinal":66067,"en":"Murmuring like water,"},{"id":"manas-2010:p1533:b001:l012","ordinal":66068,"en":"Look at the blood flowing!"},{"id":"manas-2010:p1533:b001:l013","ordinal":66069,"en":"Roaring like a lion,"},{"id":"manas-2010:p1533:b001:l014","ordinal":66070,"en":"Ranging through the Chinese,"},{"id":"manas-2010:p1533:b001:l015","ordinal":66071,"en":"Look at Almambet, the blue-maned lion!"},{"id":"manas-2010:p1533:b001:l016","ordinal":66072,"en":"Parted from their horses,"},{"id":"manas-2010:p1533:b001:l017","ordinal":66073,"en":"Unable to gather their wits,"},{"id":"manas-2010:p1533:b001:l018","ordinal":66074,"en":"Their minds tormented and dazed,"},{"id":"manas-2010:p1533:b001:l019","ordinal":66075,"en":"Look at the dismounted men lying in groups!"},{"id":"manas-2010:p1533:b001:l020","ordinal":66076,"en":"The mighty Chinese host sweeping upon him,"},{"id":"manas-2010:p1533:b001:l021","ordinal":66077,"en":"Thinking them less than flies,"},{"id":"manas-2010:p1533:b001:l022","ordinal":66078,"en":"Look at a giant like Almambet!"},{"id":"manas-2010:p1533:b001:l023","ordinal":66079,"en":"The Chinese uncountable, he alone,"},{"id":"manas-2010:p1533:b001:l024","ordinal":66080,"en":"Those Chinese—may their daughters be divorced!—"},{"id":"manas-2010:p1533:b001:l025","ordinal":66081,"en":"Have they a crime against the Lord?"},{"id":"manas-2010:p1533:b001:l026","ordinal":66082,"en":"Pressing hard and surrounding him,"},{"id":"manas-2010:p1533:b001:l027","ordinal":66083,"en":"They seemed about to take him alive."},{"id":"manas-2010:p1533:b001:l028","ordinal":66084,"en":"If they captured your Alma,"},{"id":"manas-2010:p1533:b001:l029","ordinal":66085,"en":"They would bring havoc upon his head;"},{"id":"manas-2010:p1533:b001:l030","ordinal":66086,"en":"The Chinese surged forward at a gallop."},{"id":"manas-2010:p1533:b001:l031","ordinal":66087,"en":"“Where is my dear Chubak?” he said,"},{"id":"manas-2010:p1533:b001:l032","ordinal":66088,"en":"And dashed back."},{"id":"manas-2010:p1533:b001:l033","ordinal":66089,"en":"He turned his horse's rump toward them;"},{"id":"manas-2010:p1533:b001:l034","ordinal":66090,"en":"The multitude of Chinese came after him"},{"id":"manas-2010:p1533:b001:l035","ordinal":66091,"en":"And pursued without mercy."},{"id":"manas-2010:p1533:b001:l036","ordinal":66092,"en":"As the pursuing Chinese drew near,"},{"id":"manas-2010:p1533:b001:l037","ordinal":66093,"en":"As they were about to overwhelm him,"},{"id":"manas-2010:p1533:b001:l038","ordinal":66094,"en":"Tall of body, broad of shoulder—"},{"id":"manas-2010:p1533:b001:l039","ordinal":66095,"en":"Have you heard of him?"},{"id":"manas-2010:p1533:b001:l040","ordinal":66096,"en":"Chubak, Khan Baltay's son,"},{"id":"manas-2010:p1533:b001:l041","ordinal":66097,"en":"Whom no man's strength could match in grappling,"},{"id":"manas-2010:p1533:b001:l042","ordinal":66098,"en":"Whom no musket bullet could pierce,"},{"id":"manas-2010:p1534:b001:l001","ordinal":66099,"en":"Who never halted at sight of an enemy,"},{"id":"manas-2010:p1534:b001:l002","ordinal":66100,"en":"The fierce champion of the Oyguts,"},{"id":"manas-2010:p1534:b001:l003","ordinal":66101,"en":"Who had taken a thousand spear-thrusts at once,"},{"id":"manas-2010:p1534:b001:l004","ordinal":66102,"en":"Bearing wounds upon his flesh,"},{"id":"manas-2010:p1534:b001:l005","ordinal":66103,"en":"To recover from his wounds"},{"id":"manas-2010:p1534:b001:l006","ordinal":66104,"en":"And face the Chinese—"},{"id":"manas-2010:p1534:b001:l007","ordinal":66105,"en":"That was hero Chubak's vow."},{"id":"manas-2010:p1534:b001:l008","ordinal":66106,"en":"Wearing a coat of blue ribbed cloth,"},{"id":"manas-2010:p1534:b001:l009","ordinal":66107,"en":"Riding a horse like Kögala,"},{"id":"manas-2010:p1534:b001:l010","ordinal":66108,"en":"He charged in like a vast host."},{"id":"manas-2010:p1534:b001:l011","ordinal":66109,"en":"Not sparing his fly-like soul,"},{"id":"manas-2010:p1534:b001:l012","ordinal":66110,"en":"Calling the battle cry, “Manas!”"},{"id":"manas-2010:p1534:b001:l013","ordinal":66111,"en":"An army thick as ants,"},{"id":"manas-2010:p1534:b001:l014","ordinal":66112,"en":"Chinese as many as the sand,"},{"id":"manas-2010:p1534:b001:l015","ordinal":66113,"en":"Leading the mighty army,"},{"id":"manas-2010:p1534:b001:l016","ordinal":66114,"en":"Six thousand Chinese, a thousand governors,"},{"id":"manas-2010:p1534:b001:l017","ordinal":66115,"en":"With Kongurbay their elder."},{"id":"manas-2010:p1534:b001:l018","ordinal":66116,"en":"When Chubak charged,"},{"id":"manas-2010:p1534:b001:l019","ordinal":66117,"en":"Without sparing brow or eyebrow,"},{"id":"manas-2010:p1534:b001:l020","ordinal":66118,"en":"Kongurbay charged out."},{"id":"manas-2010:p1534:b001:l021","ordinal":66119,"en":"Shouting in wrath,"},{"id":"manas-2010:p1534:b001:l022","ordinal":66120,"en":"Calling his mighty wrestlers,"},{"id":"manas-2010:p1534:b001:l023","ordinal":66121,"en":"“Surge forward, governors, surge forward!” he said."},{"id":"manas-2010:p1534:b001:l024","ordinal":66122,"en":"“Chubak, Khan Baltay's son,"},{"id":"manas-2010:p1534:b001:l025","ordinal":66123,"en":"Let us capture alive;"},{"id":"manas-2010:p1534:b001:l026","ordinal":66124,"en":"Binding his head and eyes in rawhide,"},{"id":"manas-2010:p1534:b001:l027","ordinal":66125,"en":"Before Karykan,"},{"id":"manas-2010:p1534:b001:l028","ordinal":66126,"en":"Let us bring him as tribute!"},{"id":"manas-2010:p1534:b001:l029","ordinal":66127,"en":"Petitioning Karykan,"},{"id":"manas-2010:p1534:b001:l030","ordinal":66128,"en":"‘Give us a mighty army,’ we shall say;"},{"id":"manas-2010:p1534:b001:l031","ordinal":66129,"en":"Let us summon troops."},{"id":"manas-2010:p1534:b001:l032","ordinal":66130,"en":"Upon the Burut who have charged us,"},{"id":"manas-2010:p1534:b001:l033","ordinal":66131,"en":"Let us bring Judgment Day;"},{"id":"manas-2010:p1534:b001:l034","ordinal":66132,"en":"Driving them all the way to Talas,"},{"id":"manas-2010:p1534:b001:l035","ordinal":66133,"en":"Not the Burut’s daughters,"},{"id":"manas-2010:p1534:b001:l036","ordinal":66134,"en":"Let us seize their wives as plunder!"},{"id":"manas-2010:p1534:b001:l037","ordinal":66135,"en":"The Burut who fled before,"},{"id":"manas-2010:p1534:b001:l038","ordinal":66136,"en":"Let us scatter their red blood;"},{"id":"manas-2010:p1534:b001:l039","ordinal":66137,"en":"Leaving the Burut no chance to look back,"},{"id":"manas-2010:p1534:b001:l040","ordinal":66138,"en":"Let us slaughter, cut them down and crush them!"},{"id":"manas-2010:p1534:b001:l041","ordinal":66139,"en":"Let us bend them at the waist;"},{"id":"manas-2010:p1534:b001:l042","ordinal":66140,"en":"The unruly, wayward Burut,"},{"id":"manas-2010:p1535:b001:l001","ordinal":66141,"en":"Plundering their possessions,"},{"id":"manas-2010:p1535:b001:l002","ordinal":66142,"en":"Let us load them toward Beijing."},{"id":"manas-2010:p1535:b001:l003","ordinal":66143,"en":"Keeping your spear steady,"},{"id":"manas-2010:p1535:b001:l004","ordinal":66144,"en":"Hold it firmly, brace yourself;"},{"id":"manas-2010:p1535:b001:l005","ordinal":66145,"en":"Your girth and your head,"},{"id":"manas-2010:p1535:b001:l006","ordinal":66146,"en":"Put them right, make yourself ready."},{"id":"manas-2010:p1535:b001:l007","ordinal":66147,"en":"You who turn and flee,"},{"id":"manas-2010:p1535:b001:l008","ordinal":66148,"en":"Do not think you will escape death!"},{"id":"manas-2010:p1535:b001:l009","ordinal":66149,"en":"Take heed, mighty wrestlers:"},{"id":"manas-2010:p1535:b001:l010","ordinal":66150,"en":"Almambet, Chubak and Syrgak"},{"id":"manas-2010:p1535:b001:l011","ordinal":66151,"en":"Are the backbone of the Burut army."},{"id":"manas-2010:p1535:b001:l012","ordinal":66152,"en":"Were it not for their being Burut,"},{"id":"manas-2010:p1535:b001:l013","ordinal":66153,"en":"All people upon the earth"},{"id":"manas-2010:p1535:b001:l014","ordinal":66154,"en":"They are lions who could throw into confusion."},{"id":"manas-2010:p1535:b001:l015","ordinal":66155,"en":"The Burut's Chubak,"},{"id":"manas-2010:p1535:b001:l016","ordinal":66156,"en":"Having fought no battle for a long time,"},{"id":"manas-2010:p1535:b001:l017","ordinal":66157,"en":"Has grown restless for action!”"},{"id":"manas-2010:p1535:b001:l018","ordinal":66158,"en":"While the grim-faced one spoke,"},{"id":"manas-2010:p1535:b001:l019","ordinal":66159,"en":"Would charging Chubak stand still?"},{"id":"manas-2010:p1535:b001:l020","ordinal":66160,"en":"Speeding upon Kögala,"},{"id":"manas-2010:p1535:b001:l021","ordinal":66161,"en":"Scattering the multitude of Chinese,"},{"id":"manas-2010:p1535:b001:l022","ordinal":66162,"en":"Beside Kongurbay"},{"id":"manas-2010:p1535:b001:l023","ordinal":66163,"en":"Were a thousand governors close at hand;"},{"id":"manas-2010:p1535:b001:l024","ordinal":66164,"en":"When he reached the governors,"},{"id":"manas-2010:p1535:b001:l025","ordinal":66165,"en":"He speared many, many warriors,"},{"id":"manas-2010:p1535:b001:l026","ordinal":66166,"en":"Piercing several together with one thrust."},{"id":"manas-2010:p1535:b001:l027","ordinal":66167,"en":"The Chinese recoiled and fled;"},{"id":"manas-2010:p1535:b001:l028","ordinal":66168,"en":"Hero Chubak went slaughtering,"},{"id":"manas-2010:p1535:b001:l029","ordinal":66169,"en":"Covered in red blood."},{"id":"manas-2010:p1535:b001:l030","ordinal":66170,"en":"The Chinese who fled back,"},{"id":"manas-2010:p1535:b001:l031","ordinal":66171,"en":"Kongurbay, in wrath,"},{"id":"manas-2010:p1535:b001:l032","ordinal":66172,"en":"Not letting a single one turn and flee,"},{"id":"manas-2010:p1535:b001:l033","ordinal":66173,"en":"Beat as he shouted."},{"id":"manas-2010:p1535:b001:l034","ordinal":66174,"en":"The grim-faced one stopped those who fled;"},{"id":"manas-2010:p1535:b001:l035","ordinal":66175,"en":"Those who did not flee, hero Chubak"},{"id":"manas-2010:p1535:b001:l036","ordinal":66176,"en":"Slaughtered and made groan."},{"id":"manas-2010:p1535:b001:l037","ordinal":66177,"en":"Between them, the multitude of Chinese"},{"id":"manas-2010:p1535:b001:l038","ordinal":66178,"en":"Pooled together, unable to escape."},{"id":"manas-2010:p1535:b001:l039","ordinal":66179,"en":"Tasting blood when they smacked their lips,"},{"id":"manas-2010:p1535:b001:l040","ordinal":66180,"en":"Their resourceful men prepared:"},{"id":"manas-2010:p1535:b001:l041","ordinal":66181,"en":"“We shall capture Chubak,” they said;"},{"id":"manas-2010:p1535:b001:l042","ordinal":66182,"en":"The countless Chinese and Manchus"},{"id":"manas-2010:p1536:b001:l001","ordinal":66183,"en":"Surged upon him together."},{"id":"manas-2010:p1536:b001:l002","ordinal":66184,"en":"Struggling, the multitude of Chinese"},{"id":"manas-2010:p1536:b001:l003","ordinal":66185,"en":"Thrust many spears."},{"id":"manas-2010:p1536:b001:l004","ordinal":66186,"en":"Almambet and Syrgak were absent;"},{"id":"manas-2010:p1536:b001:l005","ordinal":66187,"en":"Chubak remained in their midst."},{"id":"manas-2010:p1536:b001:l006","ordinal":66188,"en":"As though an evil spirit had seized his wife,"},{"id":"manas-2010:p1536:b001:l007","ordinal":66189,"en":"As though his pursuers were close behind,"},{"id":"manas-2010:p1536:b001:l008","ordinal":66190,"en":"Kongurbay of the Chinese"},{"id":"manas-2010:p1536:b001:l009","ordinal":66191,"en":"Cried, “Come on, come on, come on!”"},{"id":"manas-2010:p1536:b001:l010","ordinal":66192,"en":"Calling that cry to battle."},{"id":"manas-2010:p1536:b001:l011","ordinal":66193,"en":"“Capture Chubak!” he said,"},{"id":"manas-2010:p1536:b001:l012","ordinal":66194,"en":"Shouting in wrath."},{"id":"manas-2010:p1536:b001:l013","ordinal":66195,"en":"The countless Chinese and Manchus,"},{"id":"manas-2010:p1536:b001:l014","ordinal":66196,"en":"Your dear blue-maned Chubak,"},{"id":"manas-2010:p1536:b001:l015","ordinal":66197,"en":"Except for Kongurbay,"},{"id":"manas-2010:p1536:b001:l016","ordinal":66198,"en":"Thought less than butterflies."},{"id":"manas-2010:p1536:b001:l017","ordinal":66199,"en":"Facing Kongurbay,"},{"id":"manas-2010:p1536:b001:l018","ordinal":66200,"en":"Extending his spear and facing him,"},{"id":"manas-2010:p1536:b001:l019","ordinal":66201,"en":"“At the Kalmyk saddle's pommel,” he said,"},{"id":"manas-2010:p1536:b001:l020","ordinal":66202,"en":"“Right at the heart's head,” he said,"},{"id":"manas-2010:p1536:b001:l021","ordinal":66203,"en":"And thrust hard as he passed."},{"id":"manas-2010:p1536:b001:l022","ordinal":66204,"en":"“At the edge of the golden ammunition belt,” he said,"},{"id":"manas-2010:p1536:b001:l023","ordinal":66205,"en":"“At the lungs and heart themselves,” he said,"},{"id":"manas-2010:p1536:b001:l024","ordinal":66206,"en":"And Kongurbay thrust as he passed."},{"id":"manas-2010:p1536:b001:l025","ordinal":66207,"en":"Behind Kongurbay,"},{"id":"manas-2010:p1536:b001:l026","ordinal":66208,"en":"Uncountable Chinese arrived."},{"id":"manas-2010:p1536:b001:l027","ordinal":66209,"en":"With Kongurbay at their head,"},{"id":"manas-2010:p1536:b001:l028","ordinal":66210,"en":"Seething like ants,"},{"id":"manas-2010:p1536:b001:l029","ordinal":66211,"en":"Swarming as numerous as sand,"},{"id":"manas-2010:p1536:b001:l030","ordinal":66212,"en":"They encircled him."},{"id":"manas-2010:p1536:b001:l031","ordinal":66213,"en":"Hero Chubak, alone,"},{"id":"manas-2010:p1536:b001:l032","ordinal":66214,"en":"Bent beneath his anxious thoughts,"},{"id":"manas-2010:p1536:b001:l033","ordinal":66215,"en":"Despaired of his frail life."},{"id":"manas-2010:p1536:b001:l034","ordinal":66216,"en":"Those who thrust with spears,"},{"id":"manas-2010:p1536:b001:l035","ordinal":66217,"en":"He knocked back and kept away;"},{"id":"manas-2010:p1536:b001:l036","ordinal":66218,"en":"Those who struck with battle-axes,"},{"id":"manas-2010:p1536:b001:l037","ordinal":66219,"en":"He kept from coming near his body."},{"id":"manas-2010:p1536:b001:l038","ordinal":66220,"en":"With his sword on every side,"},{"id":"manas-2010:p1536:b001:l039","ordinal":66221,"en":"Not sparing his thread-like life,"},{"id":"manas-2010:p1536:b001:l040","ordinal":66222,"en":"Hero Chubak parried them."},{"id":"manas-2010:p1536:b001:l041","ordinal":66223,"en":"Kongurbay showed no mercy;"},{"id":"manas-2010:p1536:b001:l042","ordinal":66224,"en":"Hero Chubak was hard pressed."},{"id":"manas-2010:p1537:b001:l001","ordinal":66225,"en":"His two eyes darted about;"},{"id":"manas-2010:p1537:b001:l002","ordinal":66226,"en":"His senses gone, he was stunned."},{"id":"manas-2010:p1537:b001:l003","ordinal":66227,"en":"While Chubak stood dazed,"},{"id":"manas-2010:p1537:b001:l004","ordinal":66228,"en":"A bringer of good fortune in battle,"},{"id":"manas-2010:p1537:b001:l005","ordinal":66229,"en":"Like a vast host in combat,"},{"id":"manas-2010:p1537:b001:l006","ordinal":66230,"en":"The support of the black-capped people,"},{"id":"manas-2010:p1537:b001:l007","ordinal":66231,"en":"Khan Manas's Syrgak,"},{"id":"manas-2010:p1537:b001:l008","ordinal":66232,"en":"Shouting in wrath,"},{"id":"manas-2010:p1537:b001:l009","ordinal":66233,"en":"The Chinese who enclosed him,"},{"id":"manas-2010:p1537:b001:l010","ordinal":66234,"en":"From around hero Chubak,"},{"id":"manas-2010:p1537:b001:l011","ordinal":66235,"en":"Drove away and crushed back."},{"id":"manas-2010:p1537:b001:l012","ordinal":66236,"en":"Licking his mouth and nose,"},{"id":"manas-2010:p1537:b001:l013","ordinal":66237,"en":"Roaring like a lion,"},{"id":"manas-2010:p1537:b001:l014","ordinal":66238,"en":"Hero Syrgak drove them before him."},{"id":"manas-2010:p1537:b001:l015","ordinal":66239,"en":"The countless Chinese and Manchus,"},{"id":"manas-2010:p1537:b001:l016","ordinal":66240,"en":"Making their red blood flow,"},{"id":"manas-2010:p1537:b001:l017","ordinal":66241,"en":"Hero Syrgak slew."},{"id":"manas-2010:p1537:b001:l018","ordinal":66242,"en":"Like a thousand sheep struck by a wolf,"},{"id":"manas-2010:p1537:b001:l019","ordinal":66243,"en":"Hero Syrgak scattered them."},{"id":"manas-2010:p1537:b001:l020","ordinal":66244,"en":"Like jackdaws struck by a falcon,"},{"id":"manas-2010:p1537:b001:l021","ordinal":66245,"en":"Not sparing his life a hair's breadth,"},{"id":"manas-2010:p1537:b001:l022","ordinal":66246,"en":"Hero Syrgak slaughtered them."},{"id":"manas-2010:p1537:b001:l023","ordinal":66247,"en":"Crushing those he met,"},{"id":"manas-2010:p1537:b001:l024","ordinal":66248,"en":"Spearing those he encountered,"},{"id":"manas-2010:p1537:b001:l025","ordinal":66249,"en":"“Where is the khan of the monks?”"},{"id":"manas-2010:p1537:b001:l026","ordinal":66250,"en":"Hero Syrgak shouted as he went."},{"id":"manas-2010:p1537:b001:l027","ordinal":66251,"en":"Without mercy, your lion"},{"id":"manas-2010:p1537:b001:l028","ordinal":66252,"en":"Struck like a falcon."},{"id":"manas-2010:p1537:b001:l029","ordinal":66253,"en":"On Syrgak's outer side,"},{"id":"manas-2010:p1537:b001:l030","ordinal":66254,"en":"Chubak, Khan Baltay's son,"},{"id":"manas-2010:p1537:b001:l031","ordinal":66255,"en":"Gave him support."},{"id":"manas-2010:p1537:b001:l032","ordinal":66256,"en":"The bellowing Chinese,"},{"id":"manas-2010:p1537:b001:l033","ordinal":66257,"en":"Like jackdaws struck by a saker,"},{"id":"manas-2010:p1537:b001:l034","ordinal":66258,"en":"Into the desert of It-Ölbös,"},{"id":"manas-2010:p1537:b001:l035","ordinal":66259,"en":"Driving them back and crushing them,"},{"id":"manas-2010:p1537:b001:l036","ordinal":66260,"en":"Dear Syrgak now entered."},{"id":"manas-2010:p1537:b001:l037","ordinal":66261,"en":"Beyond the measure of one's strength,"},{"id":"manas-2010:p1537:b001:l038","ordinal":66262,"en":"The Chinese people could not be matched;"},{"id":"manas-2010:p1537:b001:l039","ordinal":66263,"en":"Beyond one's strength in a struggle,"},{"id":"manas-2010:p1537:b001:l040","ordinal":66264,"en":"The Chinese were a stalwart people."},{"id":"manas-2010:p1537:b001:l041","ordinal":66265,"en":"Thundering and surging, Ay Jangjung"},{"id":"manas-2010:p1537:b001:l042","ordinal":66266,"en":"Had arrived at full speed."},{"id":"manas-2010:p1538:b001:l001","ordinal":66267,"en":"His shout split stones;"},{"id":"manas-2010:p1538:b001:l002","ordinal":66268,"en":"Leading troops without sparing them,"},{"id":"manas-2010:p1538:b001:l003","ordinal":66269,"en":"Leading an uncountable mighty host,"},{"id":"manas-2010:p1538:b001:l004","ordinal":66270,"en":"Bringing fresh lions to reinforce them,"},{"id":"manas-2010:p1538:b001:l005","ordinal":66271,"en":"Bringing fierce men who spared no lives,"},{"id":"manas-2010:p1538:b001:l006","ordinal":66272,"en":"Ay Jangjung had arrived."},{"id":"manas-2010:p1538:b001:l007","ordinal":66273,"en":"When the two giants arrived,"},{"id":"manas-2010:p1538:b001:l008","ordinal":66274,"en":"Army joined army;"},{"id":"manas-2010:p1538:b001:l009","ordinal":66275,"en":"The face of the earth streamed with them;"},{"id":"manas-2010:p1538:b001:l010","ordinal":66276,"en":"The multitude of Chinese became a flood."},{"id":"manas-2010:p1538:b001:l011","ordinal":66277,"en":"If you looked at their numbers,"},{"id":"manas-2010:p1538:b001:l012","ordinal":66278,"en":"Your eyes could not reach their limits;"},{"id":"manas-2010:p1538:b001:l013","ordinal":66279,"en":"The multitude of Chinese became a lake."},{"id":"manas-2010:p1538:b001:l014","ordinal":66280,"en":"Each Manchu contingent stood apart;"},{"id":"manas-2010:p1538:b001:l015","ordinal":66281,"en":"Of the countless Chinese and Manchus,"},{"id":"manas-2010:p1538:b001:l016","ordinal":66282,"en":"So many had been slaughtered."},{"id":"manas-2010:p1538:b001:l017","ordinal":66283,"en":"“If only I could slaughter the Burut,”"},{"id":"manas-2010:p1538:b001:l018","ordinal":66284,"en":"Biting through their lips,"},{"id":"manas-2010:p1538:b001:l019","ordinal":66285,"en":"The aggrieved ones stood apart;"},{"id":"manas-2010:p1538:b001:l020","ordinal":66286,"en":"Those who cast lassos from afar,"},{"id":"manas-2010:p1538:b001:l021","ordinal":66287,"en":"Their sorcerers, stood apart."},{"id":"manas-2010:p1538:b001:l022","ordinal":66288,"en":"Peoples of every kind among the Chinese,"},{"id":"manas-2010:p1538:b001:l023","ordinal":66289,"en":"A place where they would perish together,"},{"id":"manas-2010:p1538:b001:l024","ordinal":66290,"en":"When the Chinese surged upon them,"},{"id":"manas-2010:p1538:b001:l025","ordinal":66291,"en":"Unable to find a plan, their eyes darting,"},{"id":"manas-2010:p1538:b001:l026","ordinal":66292,"en":"Their resourcefulness fled, their senses gone,"},{"id":"manas-2010:p1538:b001:l027","ordinal":66293,"en":"The Chinese entered in a mass,"},{"id":"manas-2010:p1538:b001:l028","ordinal":66294,"en":"Preparing to bind them."},{"id":"manas-2010:p1538:b001:l029","ordinal":66295,"en":"Look at the cannon shrouded in haze;"},{"id":"manas-2010:p1538:b001:l030","ordinal":66296,"en":"Look at the unfailing shots!"},{"id":"manas-2010:p1538:b001:l031","ordinal":66297,"en":"Syrgak gave no thought to shots,"},{"id":"manas-2010:p1538:b001:l032","ordinal":66298,"en":"Did not reckon, “I shall die,”"},{"id":"manas-2010:p1538:b001:l033","ordinal":66299,"en":"Looked neither up nor down."},{"id":"manas-2010:p1538:b001:l034","ordinal":66300,"en":"Not one of the former men remained;"},{"id":"manas-2010:p1538:b001:l035","ordinal":66301,"en":"The Chinese who had surged in"},{"id":"manas-2010:p1538:b001:l036","ordinal":66302,"en":"Showed no sign of turning to flee."},{"id":"manas-2010:p1538:b001:l037","ordinal":66303,"en":"Charging and thrusting spears,"},{"id":"manas-2010:p1538:b001:l038","ordinal":66304,"en":"If he speared ten and brought them down,"}]
