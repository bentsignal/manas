[{"id":"manas-2010:p1196:b001:l028","ordinal":51969,"en":"Whether it grew or did not,"},{"id":"manas-2010:p1196:b001:l029","ordinal":51970,"en":"For play and amusement,"},{"id":"manas-2010:p1196:b001:l030","ordinal":51971,"en":"I planted a willow, Syrgak!"},{"id":"manas-2010:p1196:b001:l031","ordinal":51972,"en":"Its shoot became a willow large as a house;"},{"id":"manas-2010:p1196:b001:l032","ordinal":51973,"en":"My fortune grew exceedingly;"},{"id":"manas-2010:p1196:b001:l033","ordinal":51974,"en":"Your Alma became khan of Beijing."},{"id":"manas-2010:p1196:b001:l034","ordinal":51975,"en":"Of that willow I had planted,"},{"id":"manas-2010:p1196:b001:l035","ordinal":51976,"en":"The multitude of Chinese then"},{"id":"manas-2010:p1196:b001:l036","ordinal":51977,"en":"Knew the sacred power."},{"id":"manas-2010:p1196:b001:l037","ordinal":51978,"en":"“It sprang up by itself,” they said;"},{"id":"manas-2010:p1196:b001:l038","ordinal":51979,"en":"The multitude of Chinese then"},{"id":"manas-2010:p1196:b001:l039","ordinal":51980,"en":"Bowed to it as a shrine,"},{"id":"manas-2010:p1196:b001:l040","ordinal":51981,"en":"Made pilgrimage to it."},{"id":"manas-2010:p1196:b001:l041","ordinal":51982,"en":"Such was the willow, Syrgak!"},{"id":"manas-2010:p1196:b001:l042","ordinal":51983,"en":"In those times gone by,"},{"id":"manas-2010:p1197:b001:l001","ordinal":51984,"en":"When I crossed the Zhapalak desert,"},{"id":"manas-2010:p1197:b001:l002","ordinal":51985,"en":"With the teeming Chinese people"},{"id":"manas-2010:p1197:b001:l003","ordinal":51986,"en":"I fought alone,"},{"id":"manas-2010:p1197:b001:l004","ordinal":51987,"en":"Suffering great hardship,"},{"id":"manas-2010:p1197:b001:l005","ordinal":51988,"en":"When I fled toward you,"},{"id":"manas-2010:p1197:b001:l006","ordinal":51989,"en":"The Chinese forty thousand, I alone,"},{"id":"manas-2010:p1197:b001:l007","ordinal":51990,"en":"When the Chinese singled me out,"},{"id":"manas-2010:p1197:b001:l008","ordinal":51991,"en":"At the gray hill before you,"},{"id":"manas-2010:p1197:b001:l009","ordinal":51992,"en":"The Chinese Kalcha slave,"},{"id":"manas-2010:p1197:b001:l010","ordinal":51993,"en":"Kongurbay caught up with me, Syrgak!"},{"id":"manas-2010:p1197:b001:l011","ordinal":51994,"en":"Striking once with his spear,"},{"id":"manas-2010:p1197:b001:l012","ordinal":51995,"en":"When Kongurbay pursued and passed,"},{"id":"manas-2010:p1197:b001:l013","ordinal":51996,"en":"The lacquered pipe in my mouth"},{"id":"manas-2010:p1197:b001:l014","ordinal":51997,"en":"Flew from my mouth, Syrgak!"},{"id":"manas-2010:p1197:b001:l015","ordinal":51998,"en":"Without looking behind me,"},{"id":"manas-2010:p1197:b001:l016","ordinal":51999,"en":"I took the straight road."},{"id":"manas-2010:p1197:b001:l017","ordinal":52000,"en":"Unable to retrieve the pipe,"},{"id":"manas-2010:p1197:b001:l018","ordinal":52001,"en":"‘If I return to Beijing,"},{"id":"manas-2010:p1197:b001:l019","ordinal":52002,"en":"I shall take it,’ I said, leaving it in trust."},{"id":"manas-2010:p1197:b001:l020","ordinal":52003,"en":"My days became sorrow,"},{"id":"manas-2010:p1197:b001:l021","ordinal":52004,"en":"My daylight became black night."},{"id":"manas-2010:p1197:b001:l022","ordinal":52005,"en":"Scatter its earth and see;"},{"id":"manas-2010:p1197:b001:l023","ordinal":52006,"en":"If you do not believe me,"},{"id":"manas-2010:p1197:b001:l024","ordinal":52007,"en":"Open the spot I strike and see, Syrgak!”"},{"id":"manas-2010:p1197:b001:l025","ordinal":52008,"en":"Holding his spear far out,"},{"id":"manas-2010:p1197:b001:l026","ordinal":52009,"en":"At sunset, in the gathering dusk,"},{"id":"manas-2010:p1197:b001:l027","ordinal":52010,"en":"Almambet struck the ground."},{"id":"manas-2010:p1197:b001:l028","ordinal":52011,"en":"The gray hill he had shown,"},{"id":"manas-2010:p1197:b001:l029","ordinal":52012,"en":"As Almambet pointed his spear at it,"},{"id":"manas-2010:p1197:b001:l030","ordinal":52013,"en":"Then Syrgak thought this:"},{"id":"manas-2010:p1197:b001:l031","ordinal":52014,"en":"“It is night, not day;"},{"id":"manas-2010:p1197:b001:l032","ordinal":52015,"en":"Since Almambet left,"},{"id":"manas-2010:p1197:b001:l033","ordinal":52016,"en":"So many years have passed."},{"id":"manas-2010:p1197:b001:l034","ordinal":52017,"en":"‘Kongurbay caught and speared me,’ he says,"},{"id":"manas-2010:p1197:b001:l035","ordinal":52018,"en":"‘My golden pipe remained,’ he says."},{"id":"manas-2010:p1197:b001:l036","ordinal":52019,"en":"Look at the lie he tells.”"},{"id":"manas-2010:p1197:b001:l037","ordinal":52020,"en":"With this, warrior Syrgak"},{"id":"manas-2010:p1197:b001:l038","ordinal":52021,"en":"Sprang down from his horse."},{"id":"manas-2010:p1197:b001:l039","ordinal":52022,"en":"The earth at the spear's point"},{"id":"manas-2010:p1197:b001:l040","ordinal":52023,"en":"He broke with his battle-axe,"},{"id":"manas-2010:p1197:b001:l041","ordinal":52024,"en":"Scattering the soil,"},{"id":"manas-2010:p1197:b001:l042","ordinal":52025,"en":"Digging open the point,"},{"id":"manas-2010:p1198:b001:l001","ordinal":52026,"en":"When he opened it and looked,"},{"id":"manas-2010:p1198:b001:l002","ordinal":52027,"en":"The pipe he had spoken of"},{"id":"manas-2010:p1198:b001:l003","ordinal":52028,"en":"Lay there at the point."},{"id":"manas-2010:p1198:b001:l004","ordinal":52029,"en":"When he pulled it out and held it,"},{"id":"manas-2010:p1198:b001:l005","ordinal":52030,"en":"When he had been golden,"},{"id":"manas-2010:p1198:b001:l006","ordinal":52031,"en":"Ruling Beijing,"},{"id":"manas-2010:p1198:b001:l007","ordinal":52032,"en":"He had rubies split and cut,"},{"id":"manas-2010:p1198:b001:l008","ordinal":52033,"en":"Upon the pipe's nipple"},{"id":"manas-2010:p1198:b001:l009","ordinal":52034,"en":"Turning the gems face-down,"},{"id":"manas-2010:p1198:b001:l010","ordinal":52035,"en":"He had them set in eye-shaped patterns."},{"id":"manas-2010:p1198:b001:l011","ordinal":52036,"en":"It had an aged appearance;"},{"id":"manas-2010:p1198:b001:l012","ordinal":52037,"en":"At the place one sucked"},{"id":"manas-2010:p1198:b001:l013","ordinal":52038,"en":"Was grime like rust."},{"id":"manas-2010:p1198:b001:l014","ordinal":52039,"en":"“These are the people of forty khans,” he said,"},{"id":"manas-2010:p1198:b001:l015","ordinal":52040,"en":"Telling Syrgak of his people."},{"id":"manas-2010:p1198:b001:l016","ordinal":52041,"en":"“This was my own dwelling place,” he said,"},{"id":"manas-2010:p1198:b001:l017","ordinal":52042,"en":"Telling Syrgak of his land."},{"id":"manas-2010:p1198:b001:l018","ordinal":52043,"en":"“Grieving for the land left behind,"},{"id":"manas-2010:p1198:b001:l019","ordinal":52044,"en":"What desire will we fulfill?"},{"id":"manas-2010:p1198:b001:l020","ordinal":52045,"en":"There, hazy and angled,"},{"id":"manas-2010:p1198:b001:l021","ordinal":52046,"en":"Drawing to a pointed corner,"},{"id":"manas-2010:p1198:b001:l022","ordinal":52047,"en":"Esenkan's daughter Burulcha"},{"id":"manas-2010:p1198:b001:l023","ordinal":52048,"en":"Lies bored there."},{"id":"manas-2010:p1198:b001:l024","ordinal":52049,"en":"Waiting for me, the poor soul"},{"id":"manas-2010:p1198:b001:l025","ordinal":52050,"en":"Lies weary there."},{"id":"manas-2010:p1198:b001:l026","ordinal":52051,"en":"We shall greet her as we go, Syrgak!"},{"id":"manas-2010:p1198:b001:l027","ordinal":52052,"en":"If we do not reach that place,"},{"id":"manas-2010:p1198:b001:l028","ordinal":52053,"en":"If we do not greet her before leaving,"},{"id":"manas-2010:p1198:b001:l029","ordinal":52054,"en":"Will she not think us ignorant?"},{"id":"manas-2010:p1198:b001:l030","ordinal":52055,"en":"‘For so many years I burned,’ she will say,"},{"id":"manas-2010:p1198:b001:l031","ordinal":52056,"en":"‘I went bearing grief,’ she will say."},{"id":"manas-2010:p1198:b001:l032","ordinal":52057,"en":"When we reach the afterlife,"},{"id":"manas-2010:p1198:b001:l033","ordinal":52058,"en":"Will she not make me a black donkey and ride me?"},{"id":"manas-2010:p1198:b001:l034","ordinal":52059,"en":"Will it not break the oath we swore?"},{"id":"manas-2010:p1198:b001:l035","ordinal":52060,"en":"‘He left without greeting me,’ she will say."},{"id":"manas-2010:p1198:b001:l036","ordinal":52061,"en":"Burulcha, who has borne such sorrow,"},{"id":"manas-2010:p1198:b001:l037","ordinal":52062,"en":"Will she not give up all hope, Syrgak!”"},{"id":"manas-2010:p1198:b001:l038","ordinal":52063,"en":"Said Almambet then,"},{"id":"manas-2010:p1198:b001:l039","ordinal":52064,"en":"Rumbling and prancing,"},{"id":"manas-2010:p1198:b001:l040","ordinal":52065,"en":"Sarala beneath him,"},{"id":"manas-2010:p1198:b001:l041","ordinal":52066,"en":"Slithering like an arrow-snake,"},{"id":"manas-2010:p1198:b001:l042","ordinal":52067,"en":"Onto a yellow plain smooth as a blade,"},{"id":"manas-2010:p1199:b001:l001","ordinal":52068,"en":"When they reached it in an instant,"},{"id":"manas-2010:p1199:b001:l002","ordinal":52069,"en":"There was no hill as big as a knucklebone,"},{"id":"manas-2010:p1199:b001:l003","ordinal":52070,"en":"No ravine as big as a knucklebone,"},{"id":"manas-2010:p1199:b001:l004","ordinal":52071,"en":"No furrow where a plow had passed,"},{"id":"manas-2010:p1199:b001:l005","ordinal":52072,"en":"Badger, marmot and mouse"},{"id":"manas-2010:p1199:b001:l006","ordinal":52073,"en":"Had dug no burrows there."},{"id":"manas-2010:p1199:b001:l007","ordinal":52074,"en":"When they entered the plain,"},{"id":"manas-2010:p1199:b001:l008","ordinal":52075,"en":"Stake-necked Sarala,"},{"id":"manas-2010:p1199:b001:l009","ordinal":52076,"en":"Sending him flying like a winged thing,"},{"id":"manas-2010:p1199:b001:l010","ordinal":52077,"en":"Cow-rumped Sarala,"},{"id":"manas-2010:p1199:b001:l011","ordinal":52078,"en":"Springing like a flying bird,"},{"id":"manas-2010:p1199:b001:l012","ordinal":52079,"en":"Almambet sent him surging."},{"id":"manas-2010:p1199:b001:l013","ordinal":52080,"en":"Leading Kartküröng,"},{"id":"manas-2010:p1199:b001:l014","ordinal":52081,"en":"The wind could not catch his trot;"},{"id":"manas-2010:p1199:b001:l015","ordinal":52082,"en":"At a cry of “Go!” no bullet could catch him."},{"id":"manas-2010:p1199:b001:l016","ordinal":52083,"en":"Galloping along behind,"},{"id":"manas-2010:p1199:b001:l017","ordinal":52084,"en":"Coming at his rear"},{"id":"manas-2010:p1199:b001:l018","ordinal":52085,"en":"Was lion Syrgak, the lord."},{"id":"manas-2010:p1199:b001:l019","ordinal":52086,"en":"For several days they traveled, growing restless."},{"id":"manas-2010:p1199:b001:l020","ordinal":52087,"en":"Kürpüldök's Sary-Suu,"},{"id":"manas-2010:p1199:b001:l021","ordinal":52088,"en":"They came upon the river."},{"id":"manas-2010:p1199:b001:l022","ordinal":52089,"en":"Look along the banks of Sary-Suu:"},{"id":"manas-2010:p1199:b001:l023","ordinal":52090,"en":"It bends among hollow after hollow;"},{"id":"manas-2010:p1199:b001:l024","ordinal":52091,"en":"The grass in the hollows thins."},{"id":"manas-2010:p1199:b001:l025","ordinal":52092,"en":"From the broad branches of the hills"},{"id":"manas-2010:p1199:b001:l026","ordinal":52093,"en":"Wild asses pour down to the water."},{"id":"manas-2010:p1199:b001:l027","ordinal":52094,"en":"Along Sary-Suu lies a valley."},{"id":"manas-2010:p1199:b001:l028","ordinal":52095,"en":"If you look at this valley,"},{"id":"manas-2010:p1199:b001:l029","ordinal":52096,"en":"Its leaves are like hides,"},{"id":"manas-2010:p1199:b001:l030","ordinal":52097,"en":"Its black spiders thick as thumbs,"},{"id":"manas-2010:p1199:b001:l031","ordinal":52098,"en":"Its sorrel thick as wrists."},{"id":"manas-2010:p1199:b001:l032","ordinal":52099,"en":"When its hinds burst out in fright,"},{"id":"manas-2010:p1199:b001:l033","ordinal":52100,"en":"They are like cows fleeing biting flies."},{"id":"manas-2010:p1199:b001:l034","ordinal":52101,"en":"There is distant snow upon its mountains,"},{"id":"manas-2010:p1199:b001:l035","ordinal":52102,"en":"There are rooks in its forest."},{"id":"manas-2010:p1199:b001:l036","ordinal":52103,"en":"Looking through the valley,"},{"id":"manas-2010:p1199:b001:l037","ordinal":52104,"en":"Every living creature is there."},{"id":"manas-2010:p1199:b001:l038","ordinal":52105,"en":"There are stags in its hollows,"},{"id":"manas-2010:p1199:b001:l039","ordinal":52106,"en":"Otters in its sandy water,"},{"id":"manas-2010:p1199:b001:l040","ordinal":52107,"en":"Creatures moving about,"},{"id":"manas-2010:p1199:b001:l041","ordinal":52108,"en":"Meadows in every corner,"},{"id":"manas-2010:p1199:b001:l042","ordinal":52109,"en":"Where even a mouse's nose could not pass,"},{"id":"manas-2010:p1200:b001:l001","ordinal":52110,"en":"There is dense forest too."},{"id":"manas-2010:p1200:b001:l002","ordinal":52111,"en":"Within that forest,"},{"id":"manas-2010:p1200:b001:l003","ordinal":52112,"en":"Heaped in house-sized mounds,"},{"id":"manas-2010:p1200:b001:l004","ordinal":52113,"en":"Are towers of red sand."},{"id":"manas-2010:p1200:b001:l005","ordinal":52114,"en":"Along the bases of the towers"},{"id":"manas-2010:p1200:b001:l006","ordinal":52115,"en":"Stand plane trees like minarets."},{"id":"manas-2010:p1200:b001:l007","ordinal":52116,"en":"Anyone who sees the plane trees once"},{"id":"manas-2010:p1200:b001:l008","ordinal":52117,"en":"Longs to see them again."},{"id":"manas-2010:p1200:b001:l009","ordinal":52118,"en":"Its apples fall and become manure,"},{"id":"manas-2010:p1200:b001:l010","ordinal":52119,"en":"For bears and corsac foxes"},{"id":"manas-2010:p1200:b001:l011","ordinal":52120,"en":"They become food to eat."},{"id":"manas-2010:p1200:b001:l012","ordinal":52121,"en":"Its walnuts ripen and fill the gullies,"},{"id":"manas-2010:p1200:b001:l013","ordinal":52122,"en":"Its apricots ripen, filled with fat,"},{"id":"manas-2010:p1200:b001:l014","ordinal":52123,"en":"Its pistachios ripen into honey."},{"id":"manas-2010:p1200:b001:l015","ordinal":52124,"en":"A land complete in every blessing:"},{"id":"manas-2010:p1200:b001:l016","ordinal":52125,"en":"Those who see it stand astonished."},{"id":"manas-2010:p1200:b001:l017","ordinal":52126,"en":"When nightingales sing in the plane trees,"},{"id":"manas-2010:p1200:b001:l018","ordinal":52127,"en":"A person could not leave its midst."},{"id":"manas-2010:p1200:b001:l019","ordinal":52128,"en":"Amazed at their warbling,"},{"id":"manas-2010:p1200:b001:l020","ordinal":52129,"en":"A sorrowful person could not bear to hear it."},{"id":"manas-2010:p1200:b001:l021","ordinal":52130,"en":"Your Alma could not stay still, restless."},{"id":"manas-2010:p1200:b001:l022","ordinal":52131,"en":"The words your Alma spoke,"},{"id":"manas-2010:p1200:b001:l023","ordinal":52132,"en":"Syrgak stood hearing once again."},{"id":"manas-2010:p1200:b001:l024","ordinal":52133,"en":"“What you see before us"},{"id":"manas-2010:p1200:b001:l025","ordinal":52134,"en":"Is the river Kürpüldök."},{"id":"manas-2010:p1200:b001:l026","ordinal":52135,"en":"Unless a winged creature flies across,"},{"id":"manas-2010:p1200:b001:l027","ordinal":52136,"en":"No one can endure fording it,"},{"id":"manas-2010:p1200:b001:l028","ordinal":52137,"en":"No child of humankind."},{"id":"manas-2010:p1200:b001:l029","ordinal":52138,"en":"Its name is Kürpüldök,"},{"id":"manas-2010:p1200:b001:l030","ordinal":52139,"en":"A fiercely flowing river."},{"id":"manas-2010:p1200:b001:l031","ordinal":52140,"en":"Its roar is heard far away,"},{"id":"manas-2010:p1200:b001:l032","ordinal":52141,"en":"The mountains echoing, booming."},{"id":"manas-2010:p1200:b001:l033","ordinal":52142,"en":"The Chinese people of forty khans,"},{"id":"manas-2010:p1200:b001:l034","ordinal":52143,"en":"I pressed them and had them gathered."},{"id":"manas-2010:p1200:b001:l036","ordinal":52144,"en":"There is a path for a single horse.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p1200:b001:l037","ordinal":52145,"en":"I did not pull away its rope as I fled,"},{"id":"manas-2010:p1200:b001:l038","ordinal":52146,"en":"Almambet has his misfortune."},{"id":"manas-2010:p1200:b001:l039","ordinal":52147,"en":"Now let me tell you my secret,"},{"id":"manas-2010:p1200:b001:l040","ordinal":52148,"en":"My precious Syrgak:"},{"id":"manas-2010:p1200:b001:l041","ordinal":52149,"en":"I have crossed this river many times."},{"id":"manas-2010:p1200:b001:l042","ordinal":52150,"en":"That is why he will not go astray,"},{"id":"manas-2010:p1201:b001:l001","ordinal":52151,"en":"Sarala beneath me,"},{"id":"manas-2010:p1201:b001:l002","ordinal":52152,"en":"From the ford he himself has crossed."},{"id":"manas-2010:p1201:b001:l003","ordinal":52153,"en":"A place crossed so many times,"},{"id":"manas-2010:p1201:b001:l004","ordinal":52154,"en":"Fighting the Chinese,"},{"id":"manas-2010:p1201:b001:l005","ordinal":52155,"en":"A place where I crossed this river."},{"id":"manas-2010:p1201:b001:l006","ordinal":52156,"en":"Where Sarala crosses,"},{"id":"manas-2010:p1201:b001:l007","ordinal":52157,"en":"Do not turn elsewhere;"},{"id":"manas-2010:p1201:b001:l008","ordinal":52158,"en":"Cross just as he crosses."},{"id":"manas-2010:p1201:b001:l009","ordinal":52159,"en":"From Sarala's trail,"},{"id":"manas-2010:p1201:b001:l010","ordinal":52160,"en":"My Syrgak, never stray."},{"id":"manas-2010:p1201:b001:l011","ordinal":52161,"en":"Such is the way through the water."},{"id":"manas-2010:p1201:b001:l012","ordinal":52162,"en":"In my saddlebag, my Syrgak,"},{"id":"manas-2010:p1201:b001:l013","ordinal":52163,"en":"My father Azizkan's,"},{"id":"manas-2010:p1201:b001:l014","ordinal":52164,"en":"The one he wore on outings,"},{"id":"manas-2010:p1201:b001:l015","ordinal":52165,"en":"There is the robe of the half-khan."},{"id":"manas-2010:p1201:b001:l016","ordinal":52166,"en":"I shall put on the robe."},{"id":"manas-2010:p1201:b001:l017","ordinal":52167,"en":"Upon the dark mass of Chinese,"},{"id":"manas-2010:p1201:b001:l018","ordinal":52168,"en":"Watch, my Syrgak,"},{"id":"manas-2010:p1201:b001:l019","ordinal":52169,"en":"I shall bring a great commotion!”"},{"id":"manas-2010:p1201:b001:l020","ordinal":52170,"en":"A white saddlebag at the saddle straps,"},{"id":"manas-2010:p1201:b001:l021","ordinal":52171,"en":"A saddlebag fitting the leopard."},{"id":"manas-2010:p1201:b001:l022","ordinal":52172,"en":"When he took the saddlebag and looked,"},{"id":"manas-2010:p1201:b001:l023","ordinal":52173,"en":"It was of shining gold."},{"id":"manas-2010:p1201:b001:l024","ordinal":52174,"en":"That Beijing would become an enemy,"},{"id":"manas-2010:p1201:b001:l025","ordinal":52175,"en":"Had he not known it when he left?"},{"id":"manas-2010:p1201:b001:l026","ordinal":52176,"en":"“If I return to raid the Chinese,"},{"id":"manas-2010:p1201:b001:l027","ordinal":52177,"en":"The robe will be of use,” he said."},{"id":"manas-2010:p1201:b001:l028","ordinal":52178,"en":"Azizkan's Almambet,"},{"id":"manas-2010:p1201:b001:l029","ordinal":52179,"en":"Thinking of this from the beginning,"},{"id":"manas-2010:p1201:b001:l030","ordinal":52180,"en":"Had he not worn it away?"},{"id":"manas-2010:p1201:b001:l031","ordinal":52181,"en":"Thus Almambet,"},{"id":"manas-2010:p1201:b001:l032","ordinal":52182,"en":"His father's robe of rank,"},{"id":"manas-2010:p1201:b001:l033","ordinal":52183,"en":"When he donned it, standing proudly,"},{"id":"manas-2010:p1201:b001:l034","ordinal":52184,"en":"Rubies had been cut,"},{"id":"manas-2010:p1201:b001:l035","ordinal":52185,"en":"Upon the robe's breast"},{"id":"manas-2010:p1201:b001:l036","ordinal":52186,"en":"Precious stones had been set."},{"id":"manas-2010:p1201:b001:l037","ordinal":52187,"en":"Written and signed in Chinese"},{"id":"manas-2010:p1201:b001:l038","ordinal":52188,"en":"By Karykan in Great Beijing:"},{"id":"manas-2010:p1201:b001:l039","ordinal":52189,"en":"“To Beijing's half-khan"},{"id":"manas-2010:p1201:b001:l040","ordinal":52190,"en":"I have given it,” he truly signed."},{"id":"manas-2010:p1201:b001:l041","ordinal":52191,"en":"The thing that would prove useful"},{"id":"manas-2010:p1201:b001:l042","ordinal":52192,"en":"He had kept without creasing it."},{"id":"manas-2010:p1202:b001:l001","ordinal":52193,"en":"On both sides, by the kidneys,"},{"id":"manas-2010:p1202:b001:l002","ordinal":52194,"en":"Pearls as large as sheep droppings"},{"id":"manas-2010:p1202:b001:l003","ordinal":52195,"en":"He had fastened in rows."},{"id":"manas-2010:p1202:b001:l004","ordinal":52196,"en":"Warrior Syrgak, looking on,"},{"id":"manas-2010:p1202:b001:l005","ordinal":52197,"en":"“He is a true Chinese,” he said,"},{"id":"manas-2010:p1202:b001:l006","ordinal":52198,"en":"Admiring Almambet."},{"id":"manas-2010:p1202:b001:l007","ordinal":52199,"en":"When he wore this robe,"},{"id":"manas-2010:p1202:b001:l008","ordinal":52200,"en":"Unable to look at his face,"},{"id":"manas-2010:p1202:b001:l009","ordinal":52201,"en":"Syrgak's eyes were dazzled."},{"id":"manas-2010:p1202:b001:l010","ordinal":52202,"en":"He stood admiring your Alma."},{"id":"manas-2010:p1202:b001:l011","ordinal":52203,"en":"“May the blue-maned one be safe,” he said,"},{"id":"manas-2010:p1202:b001:l012","ordinal":52204,"en":"Rejoicing inwardly."},{"id":"manas-2010:p1202:b001:l013","ordinal":52205,"en":"“Almambet's coming to us"},{"id":"manas-2010:p1202:b001:l014","ordinal":52206,"en":"Was for the faith of the sovereign sultan."},{"id":"manas-2010:p1202:b001:l015","ordinal":52207,"en":"Here Almambet,"},{"id":"manas-2010:p1202:b001:l016","ordinal":52208,"en":"Of the Chinese people of forty khans,"},{"id":"manas-2010:p1202:b001:l017","ordinal":52209,"en":"Of Beijing, the realm with a royal court,"},{"id":"manas-2010:p1202:b001:l018","ordinal":52210,"en":"Was one of its lords."},{"id":"manas-2010:p1202:b001:l019","ordinal":52211,"en":"That is what Almambet means."},{"id":"manas-2010:p1202:b001:l020","ordinal":52212,"en":"Were it not for our ‘In God's name,’"},{"id":"manas-2010:p1202:b001:l021","ordinal":52213,"en":"In that city of Beijing"},{"id":"manas-2010:p1202:b001:l022","ordinal":52214,"en":"He is the very Chinese who would dwell."},{"id":"manas-2010:p1202:b001:l023","ordinal":52215,"en":"Among these Chinese,"},{"id":"manas-2010:p1202:b001:l024","ordinal":52216,"en":"He is no small man, but a giant."},{"id":"manas-2010:p1202:b001:l025","ordinal":52217,"en":"The Chinese people of forty khans,"},{"id":"manas-2010:p1202:b001:l026","ordinal":52218,"en":"Dyeing them in red blood,"},{"id":"manas-2010:p1202:b001:l027","ordinal":52219,"en":"He is a warrior who could shatter and rule them."},{"id":"manas-2010:p1202:b001:l028","ordinal":52220,"en":"Of this Beijing,"},{"id":"manas-2010:p1202:b001:l029","ordinal":52221,"en":"When I think of Almambet,"},{"id":"manas-2010:p1202:b001:l030","ordinal":52222,"en":"He was a firmly planted fortress."},{"id":"manas-2010:p1202:b001:l031","ordinal":52223,"en":"When Almambet fled,"},{"id":"manas-2010:p1202:b001:l032","ordinal":52224,"en":"The teeming Chinese, roaring,"}]
