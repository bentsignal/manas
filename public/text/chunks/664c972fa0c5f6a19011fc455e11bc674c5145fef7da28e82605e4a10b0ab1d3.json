[{"id":"semetey-2-2013:p0003:b006:l015","ordinal":186369,"en":"And made twelve Kalmaks"},{"id":"semetey-2-2013:p0003:b006:l016","ordinal":186370,"en":"Dance awkwardly before him."},{"id":"semetey-2-2013:p0003:b006:l017","ordinal":186371,"en":"Karagul, source of ruin—"},{"id":"semetey-2-2013:p0003:b006:l018","ordinal":186372,"en":"Look at his appearance!"},{"id":"semetey-2-2013:p0003:b006:l019","ordinal":186373,"en":"That was the wretched slave himself;"},{"id":"semetey-2-2013:p0003:b006:l020","ordinal":186374,"en":"Those were Karagul's eyes!"},{"id":"semetey-2-2013:p0003:b006:l021","ordinal":186375,"en":"Before Karagul"},{"id":"semetey-2-2013:p0003:b006:l022","ordinal":186376,"en":"Bozbala came."},{"id":"semetey-2-2013:p0003:b006:l023","ordinal":186377,"en":"His knee bent to the ground,"},{"id":"semetey-2-2013:p0003:b006:l024","ordinal":186378,"en":"And he bowed like a bride,"},{"id":"semetey-2-2013:p0003:b006:l025","ordinal":186379,"en":"Straining his throat as he roared,"},{"id":"semetey-2-2013:p0003:b006:l026","ordinal":186380,"en":"Shouting in alarm,"},{"id":"semetey-2-2013:p0003:b006:l027","ordinal":186381,"en":"Calling, “Abygyi!”"},{"id":"semetey-2-2013:p0003:b006:l028","ordinal":186382,"en":"“Last night as I slept, I dreamed;"},{"id":"semetey-2-2013:p0003:b006:l029","ordinal":186383,"en":"Abygyi, I shall tell you."},{"id":"semetey-2-2013:p0003:b006:l030","ordinal":186384,"en":"In my dream I saw a wondrous thing!"},{"id":"semetey-2-2013:p0003:b006:l031","ordinal":186385,"en":"My dream last night was terrifying,"},{"id":"semetey-2-2013:p0004:b003:l001","ordinal":186386,"en":"A dream that made my heart leap!"},{"id":"semetey-2-2013:p0004:b003:l002","ordinal":186387,"en":"My dream last night will not leave me well;"},{"id":"semetey-2-2013:p0004:b003:l003","ordinal":186388,"en":"When I consider last night's dream,"},{"id":"semetey-2-2013:p0004:b003:l004","ordinal":186389,"en":"There were eighty-four armed men,"},{"id":"semetey-2-2013:p0004:b003:l005","ordinal":186390,"en":"And wherever they struck was red fire."},{"id":"semetey-2-2013:p0004:b003:l006","ordinal":186391,"en":"His face turned dark with fury:"},{"id":"semetey-2-2013:p0004:b003:l007","ordinal":186392,"en":"Semetey, son of Manas,"},{"id":"semetey-2-2013:p0004:b003:l008","ordinal":186393,"en":"Had come in the dark hour,"},{"id":"semetey-2-2013:p0004:b003:l009","ordinal":186394,"en":"Thick-armed and stone-hearted,"},{"id":"semetey-2-2013:p0004:b003:l010","ordinal":186395,"en":"A great elephant-limbed brute."},{"id":"semetey-2-2013:p0004:b003:l011","ordinal":186396,"en":"His broad-socketed patterned spear"},{"id":"semetey-2-2013:p0004:b003:l012","ordinal":186397,"en":"Was shod with steel at its base."},{"id":"semetey-2-2013:p0004:b003:l013","ordinal":186398,"en":"Against the mortals who clashed with him,"},{"id":"semetey-2-2013:p0004:b003:l014","ordinal":186399,"en":"He showed no fear and gave no opening."},{"id":"semetey-2-2013:p0004:b003:l015","ordinal":186400,"en":"He began a terrible rage;"},{"id":"semetey-2-2013:p0004:b003:l016","ordinal":186401,"en":"Stretching all of us out,"},{"id":"semetey-2-2013:p0004:b003:l017","ordinal":186402,"en":"He seized and slaughtered us."},{"id":"semetey-2-2013:p0004:b003:l018","ordinal":186403,"en":"He gouged out our eyes,"},{"id":"semetey-2-2013:p0004:b003:l019","ordinal":186404,"en":"Slaughtered us in a massacre,"},{"id":"semetey-2-2013:p0004:b003:l020","ordinal":186405,"en":"And made our heads roll;"},{"id":"semetey-2-2013:p0004:b003:l021","ordinal":186406,"en":"The crows drank their fill of blood."},{"id":"semetey-2-2013:p0004:b003:l022","ordinal":186407,"en":"He gathered and seized the herdsmen,"},{"id":"semetey-2-2013:p0004:b003:l023","ordinal":186408,"en":"Led by the great hero,"},{"id":"semetey-2-2013:p0004:b003:l024","ordinal":186409,"en":"Destroyed all of us together,"},{"id":"semetey-2-2013:p0004:b003:l025","ordinal":186410,"en":"And carried out a massacre."},{"id":"semetey-2-2013:p0004:b003:l026","ordinal":186411,"en":"What can this mean?"},{"id":"semetey-2-2013:p0004:b003:l027","ordinal":186412,"en":"Interpret this dream for me!"},{"id":"semetey-2-2013:p0004:b003:l028","ordinal":186413,"en":"Looming like a lion,"},{"id":"semetey-2-2013:p0004:b003:l029","ordinal":186414,"en":"He strode out from the hut;"},{"id":"semetey-2-2013:p0004:b003:l030","ordinal":186415,"en":"Crushing whatever stirred,"},{"id":"semetey-2-2013:p0004:b003:l031","ordinal":186416,"en":"He smashed it with a battle-axe."},{"id":"semetey-2-2013:p0004:b003:l032","ordinal":186417,"en":"What can this mean?"},{"id":"semetey-2-2013:p0004:b003:l033","ordinal":186418,"en":"Interpret this dream for me!"},{"id":"semetey-2-2013:p0004:b003:l034","ordinal":186419,"en":"A flood came against Beijing,"},{"id":"semetey-2-2013:p0004:b003:l035","ordinal":186420,"en":"Shattered the stone fortress,"},{"id":"semetey-2-2013:p0004:b003:l036","ordinal":186421,"en":"And utterly destroyed it."},{"id":"semetey-2-2013:p0004:b003:l037","ordinal":186422,"en":"All its willows lay fallen;"},{"id":"semetey-2-2013:p0004:b003:l038","ordinal":186423,"en":"All the buildings"},{"id":"semetey-2-2013:p0004:b003:l039","ordinal":186424,"en":"Of this Beijing collapsed."},{"id":"semetey-2-2013:p0004:b003:l040","ordinal":186425,"en":"What can this mean?"},{"id":"semetey-2-2013:p0004:b003:l041","ordinal":186426,"en":"Interpret this dream for me!"},{"id":"semetey-2-2013:p0004:b005:l001","ordinal":186427,"en":"Fire came from the west"},{"id":"semetey-2-2013:p0004:b005:l002","ordinal":186428,"en":"And burned all the mighty men."},{"id":"semetey-2-2013:p0004:b005:l003","ordinal":186429,"en":"Caught in the blazing fire,"},{"id":"semetey-2-2013:p0004:b005:l004","ordinal":186430,"en":"You yourself burned away."},{"id":"semetey-2-2013:p0004:b005:l005","ordinal":186431,"en":"What can this mean?"},{"id":"semetey-2-2013:p0004:b005:l006","ordinal":186432,"en":"Interpret this dream for me!"},{"id":"semetey-2-2013:p0004:b005:l007","ordinal":186433,"en":"Semetey, son of Manas,"},{"id":"semetey-2-2013:p0004:b005:l008","ordinal":186434,"en":"Champion of the Buruts,"},{"id":"semetey-2-2013:p0004:b005:l009","ordinal":186435,"en":"Destroyed wherever he reached,"},{"id":"semetey-2-2013:p0004:b005:l010","ordinal":186436,"en":"And his conflict struck us!"},{"id":"semetey-2-2013:p0004:b005:l011","ordinal":186437,"en":"His menace was fierce, his wrath strong;"},{"id":"semetey-2-2013:p0004:b005:l012","ordinal":186438,"en":"He seized and slaughtered, laying all flat."},{"id":"semetey-2-2013:p0004:b005:l013","ordinal":186439,"en":"I fear for your horses;"},{"id":"semetey-2-2013:p0004:b005:l014","ordinal":186440,"en":"I despair of my life."},{"id":"semetey-2-2013:p0004:b005:l015","ordinal":186441,"en":"Countless men led by Manas"},{"id":"semetey-2-2013:p0004:b005:l016","ordinal":186442,"en":"Surged over us,"},{"id":"semetey-2-2013:p0004:b005:l017","ordinal":186443,"en":"And a thousand men led by Bakai"},{"id":"semetey-2-2013:p0004:b005:l018","ordinal":186444,"en":"Thronged around us."},{"id":"semetey-2-2013:p0004:b005:l019","ordinal":186445,"en":"I utterly despaired of life."},{"id":"semetey-2-2013:p0004:b005:l020","ordinal":186446,"en":"Before them"},{"id":"semetey-2-2013:p0004:b005:l021","ordinal":186447,"en":"Rode a man upon a red-gray horse,"},{"id":"semetey-2-2013:p0004:b005:l022","ordinal":186448,"en":"Its hair tail knotted tight:"},{"id":"semetey-2-2013:p0004:b005:l023","ordinal":186449,"en":"Tall and broad-shouldered,"},{"id":"semetey-2-2013:p0004:b005:l024","ordinal":186450,"en":"With a face like oiled wheat,"},{"id":"semetey-2-2013:p0004:b005:l025","ordinal":186451,"en":"Eyes like twilight mist,"},{"id":"semetey-2-2013:p0004:b005:l026","ordinal":186452,"en":"Wide-mouthed and cliff-browed,"},{"id":"semetey-2-2013:p0004:b005:l027","ordinal":186453,"en":"A man resembling an executioner,"},{"id":"semetey-2-2013:p0004:b005:l028","ordinal":186454,"en":"Both champion and hero,"},{"id":"semetey-2-2013:p0004:b005:l029","ordinal":186455,"en":"Who would subjugate the world—"},{"id":"semetey-2-2013:p0004:b005:l030","ordinal":186456,"en":"That hero was a blood-drinking warrior."},{"id":"semetey-2-2013:p0004:b005:l031","ordinal":186457,"en":"He rode a horse no bullet could catch"},{"id":"semetey-2-2013:p0004:b005:l032","ordinal":186458,"en":"And wore armor no bullet could pierce;"},{"id":"semetey-2-2013:p0004:b005:l033","ordinal":186459,"en":"His muscles were like a bull's back,"},{"id":"semetey-2-2013:p0004:b005:l034","ordinal":186460,"en":"As though he would defeat anyone who grappled him."},{"id":"semetey-2-2013:p0004:b005:l035","ordinal":186461,"en":"No mortal could go against him;"},{"id":"semetey-2-2013:p0004:b005:l036","ordinal":186462,"en":"None who struck him remained alive."},{"id":"semetey-2-2013:p0004:b005:l037","ordinal":186463,"en":"His eyes blazed like fire;"},{"id":"semetey-2-2013:p0004:b005:l038","ordinal":186464,"en":"He gnashed his teeth and chewed up heroes."},{"id":"semetey-2-2013:p0004:b005:l039","ordinal":186465,"en":"He himself followed the faith of Islam:"},{"id":"semetey-2-2013:p0004:b005:l040","ordinal":186466,"en":"Semetey, son of Manas,"},{"id":"semetey-2-2013:p0004:b005:l041","ordinal":186467,"en":"Had come and lay there,"},{"id":"semetey-2-2013:p0005:b003:l001","ordinal":186468,"en":"Bearing enmity toward us."},{"id":"semetey-2-2013:p0005:b003:l002","ordinal":186469,"en":"Semetey, son of Manas,"},{"id":"semetey-2-2013:p0005:b003:l003","ordinal":186470,"en":"That mighty hero, had come;"},{"id":"semetey-2-2013:p0005:b003:l004","ordinal":186471,"en":"He had brought splendid slaughter."},{"id":"semetey-2-2013:p0005:b003:l005","ordinal":186472,"en":"Beginning with you, Abygyi,"},{"id":"semetey-2-2013:p0005:b003:l006","ordinal":186473,"en":"He cut off heads with his sword!"},{"id":"semetey-2-2013:p0005:b003:l007","ordinal":186474,"en":"What can this mean?"},{"id":"semetey-2-2013:p0005:b003:l008","ordinal":186475,"en":"Interpret this dream for me!"},{"id":"semetey-2-2013:p0005:b003:l009","ordinal":186476,"en":"He shattered the people among the rocks"},{"id":"semetey-2-2013:p0005:b003:l010","ordinal":186477,"en":"And brought splendid slaughter;"},{"id":"semetey-2-2013:p0005:b003:l011","ordinal":186478,"en":"Beating them into a spectacle,"},{"id":"semetey-2-2013:p0005:b003:l012","ordinal":186479,"en":"He slaughtered upon the road"},{"id":"semetey-2-2013:p0005:b003:l013","ordinal":186480,"en":"All who challenged him"},{"id":"semetey-2-2013:p0005:b003:l014","ordinal":186481,"en":"And divided them among the Dangyts!"},{"id":"semetey-2-2013:p0005:b003:l015","ordinal":186482,"en":"What can this mean?"},{"id":"semetey-2-2013:p0005:b003:l016","ordinal":186483,"en":"Interpret this dream for me!”"},{"id":"semetey-2-2013:p0005:b003:l017","ordinal":186484,"en":"His anger flared and bristled;"},{"id":"semetey-2-2013:p0005:b003:l018","ordinal":186485,"en":"When Karagul heard this,"},{"id":"semetey-2-2013:p0005:b003:l019","ordinal":186486,"en":"He rose in towering rage."},{"id":"semetey-2-2013:p0005:b003:l020","ordinal":186487,"en":"The hair on his crown stood on end;"},{"id":"semetey-2-2013:p0005:b003:l021","ordinal":186488,"en":"Karagul, who descended upon you,"},{"id":"semetey-2-2013:p0005:b003:l022","ordinal":186489,"en":"Had hair bristling at his nape."},{"id":"semetey-2-2013:p0005:b003:l023","ordinal":186490,"en":"He raged against the boy,"},{"id":"semetey-2-2013:p0005:b003:l024","ordinal":186491,"en":"Had him confined in the broad house,"},{"id":"semetey-2-2013:p0005:b003:l025","ordinal":186492,"en":"And blocked his way, Karagul."},{"id":"semetey-2-2013:p0005:b003:l026","ordinal":186493,"en":"For saying he had dreamed, he had him butchered,"},{"id":"semetey-2-2013:p0005:b003:l027","ordinal":186494,"en":"Clubbed and beaten,"},{"id":"semetey-2-2013:p0005:b003:l028","ordinal":186495,"en":"His hands and feet bound,"},{"id":"semetey-2-2013:p0005:b003:l029","ordinal":186496,"en":"And beaten from head to foot."},{"id":"semetey-2-2013:p0005:b003:l030","ordinal":186497,"en":"He had him driven about with blows,"},{"id":"semetey-2-2013:p0005:b003:l031","ordinal":186498,"en":"Had all his clothing torn,"},{"id":"semetey-2-2013:p0005:b003:l032","ordinal":186499,"en":"And made him swallow nine bowls of water"},{"id":"semetey-2-2013:p0005:b003:l033","ordinal":186500,"en":"One after another."},{"id":"semetey-2-2013:p0005:b003:l034","ordinal":186501,"en":"Giving him an ankle bone, he tortured him;"},{"id":"semetey-2-2013:p0005:b003:l035","ordinal":186502,"en":"For saying he had dreamed,"},{"id":"semetey-2-2013:p0005:b003:l036","ordinal":186503,"en":"They all tormented the boy together,"},{"id":"semetey-2-2013:p0005:b003:l037","ordinal":186504,"en":"Dragged him by the ears,"},{"id":"semetey-2-2013:p0005:b003:l038","ordinal":186505,"en":"Had the boy clubbed,"},{"id":"semetey-2-2013:p0005:b003:l039","ordinal":186506,"en":"And had the herdsmen beat him."},{"id":"semetey-2-2013:p0005:b005:l001","ordinal":186507,"en":"Bozbala, who thought himself clever,"},{"id":"semetey-2-2013:p0005:b005:l002","ordinal":186508,"en":"The youngest of the herdsmen,"},{"id":"semetey-2-2013:p0005:b005:l003","ordinal":186509,"en":"Was made to learn his reckoning thus:"},{"id":"semetey-2-2013:p0005:b005:l004","ordinal":186510,"en":"When he bent over,"},{"id":"semetey-2-2013:p0005:b005:l005","ordinal":186511,"en":"The prince had a whip laid across his backside."},{"id":"semetey-2-2013:p0005:b005:l006","ordinal":186512,"en":"“Your dream is fox dung,” he said,"},{"id":"semetey-2-2013:p0005:b005:l007","ordinal":186513,"en":"“And you yourself are my dung."},{"id":"semetey-2-2013:p0005:b005:l008","ordinal":186514,"en":"I am the one who deceived"},{"id":"semetey-2-2013:p0005:b005:l009","ordinal":186515,"en":"His father, bloodthirsty Manas, six times!"},{"id":"semetey-2-2013:p0005:b005:l010","ordinal":186516,"en":"What profit is there in turning back?"},{"id":"semetey-2-2013:p0005:b005:l011","ordinal":186517,"en":"While I, Abygyi, stand here,"},{"id":"semetey-2-2013:p0005:b005:l012","ordinal":186518,"en":"How could the Burut come!"},{"id":"semetey-2-2013:p0005:b005:l013","ordinal":186519,"en":"Look how brazen he is,"},{"id":"semetey-2-2013:p0005:b005:l014","ordinal":186520,"en":"Saying, ‘In my dream I saw"},{"id":"semetey-2-2013:p0005:b005:l015","ordinal":186521,"en":"The orphan son of Manas’!"},{"id":"semetey-2-2013:p0005:b005:l016","ordinal":186522,"en":"Look how worthless he is,"},{"id":"semetey-2-2013:p0005:b005:l017","ordinal":186523,"en":"Saying, ‘I saw Oen's son’!"},{"id":"semetey-2-2013:p0005:b005:l018","ordinal":186524,"en":"Look how useless"},{"id":"semetey-2-2013:p0005:b005:l019","ordinal":186525,"en":"Accursed Bozbala is,"},{"id":"semetey-2-2013:p0005:b005:l020","ordinal":186526,"en":"Saying, ‘I saw the son of Manas’!"},{"id":"semetey-2-2013:p0005:b005:l021","ordinal":186527,"en":"He beat the dreamer like a dog;"},{"id":"semetey-2-2013:p0005:b005:l022","ordinal":186528,"en":"Now no one remained who would dream."},{"id":"semetey-2-2013:p0005:b005:l023","ordinal":186529,"en":"The two-eyed, clairvoyant boy—"},{"id":"semetey-2-2013:p0005:b005:l024","ordinal":186530,"en":"Was he not a bakshy,"},{"id":"semetey-2-2013:p0005:b005:l025","ordinal":186531,"en":"Saying, ‘I saw the son of Manas,’"},{"id":"semetey-2-2013:p0005:b005:l026","ordinal":186532,"en":"And, ‘I learned all that is and is not’?"},{"id":"semetey-2-2013:p0005:b005:l027","ordinal":186533,"en":"Was he not a good boy!"},{"id":"semetey-2-2013:p0005:b005:l028","ordinal":186534,"en":"The accursed Burut"},{"id":"semetey-2-2013:p0005:b005:l029","ordinal":186535,"en":"Has no power to come to China."},{"id":"semetey-2-2013:p0005:b005:l030","ordinal":186536,"en":"All the heroes who would bring"},{"id":"semetey-2-2013:p0005:b005:l031","ordinal":186537,"en":"Splendid slaughter are gone!"},{"id":"semetey-2-2013:p0005:b005:l032","ordinal":186538,"en":"He has no pass on which to set his resolve;"},{"id":"semetey-2-2013:p0005:b005:l033","ordinal":186539,"en":"That orphan who wandered away"},{"id":"semetey-2-2013:p0005:b005:l034","ordinal":186540,"en":"To the city of Temir Khan"},{"id":"semetey-2-2013:p0005:b005:l035","ordinal":186541,"en":"Has no reason to come here!”"},{"id":"semetey-2-2013:p0005:b005:l036","ordinal":186542,"en":"Because Bozbala said he had dreamed,"},{"id":"semetey-2-2013:p0005:b005:l037","ordinal":186543,"en":"Karagul saw it as an evil burden."},{"id":"semetey-2-2013:p0005:b005:l038","ordinal":186544,"en":"His shouting deafened the ears;"},{"id":"semetey-2-2013:p0005:b005:l039","ordinal":186545,"en":"Karagul lay there that day."},{"id":"semetey-2-2013:p0006:b004:l001","ordinal":186546,"en":"Bright dawn broke,"},{"id":"semetey-2-2013:p0006:b004:l002","ordinal":186547,"en":"And light fell upon the earth."},{"id":"semetey-2-2013:p0006:b004:l003","ordinal":186548,"en":"Alööke's Kongurbai"},{"id":"semetey-2-2013:p0006:b004:l004","ordinal":186549,"en":"Rode the length of his horse,"},{"id":"semetey-2-2013:p0006:b004:l005","ordinal":186550,"en":"Traveling four times around"},{"id":"semetey-2-2013:p0006:b004:l006","ordinal":186551,"en":"The four corners of the world."},{"id":"semetey-2-2013:p0006:b004:l007","ordinal":186552,"en":"He exhausted his horse, surveying the land,"},{"id":"semetey-2-2013:p0006:b004:l008","ordinal":186553,"en":"Watching the patrol and tracking signs."},{"id":"semetey-2-2013:p0006:b004:l009","ordinal":186554,"en":"He jerked the golden reins"},{"id":"semetey-2-2013:p0006:b004:l010","ordinal":186555,"en":"And made his horse Algara lunge."},{"id":"semetey-2-2013:p0006:b004:l011","ordinal":186556,"en":"His great boots thrust forward,"},{"id":"semetey-2-2013:p0006:b004:l012","ordinal":186557,"en":"His neck craned like a rooster's;"},{"id":"semetey-2-2013:p0006:b004:l013","ordinal":186558,"en":"He wrapped himself in blue armor."},{"id":"semetey-2-2013:p0006:b004:l014","ordinal":186559,"en":"If you had seen Kongurbai,"},{"id":"semetey-2-2013:p0006:b004:l015","ordinal":186560,"en":"He raged like a blue tiger."},{"id":"semetey-2-2013:p0006:b004:l016","ordinal":186561,"en":"With his gold-tipped patterned pipe,"},{"id":"semetey-2-2013:p0006:b004:l017","ordinal":186562,"en":"The Kalcha huge as a hut,"},{"id":"semetey-2-2013:p0006:b004:l018","ordinal":186563,"en":"With sixty champions and forty kaldays,"},{"id":"semetey-2-2013:p0006:b004:l019","ordinal":186564,"en":"Their elder Kongurbai"},{"id":"semetey-2-2013:p0006:b004:l020","ordinal":186565,"en":"Hurried the herdsmen."},{"id":"semetey-2-2013:p0006:b004:l021","ordinal":186566,"en":"He made his Black Horse rear"},{"id":"semetey-2-2013:p0006:b004:l022","ordinal":186567,"en":"And pace over rise and hollow;"},{"id":"semetey-2-2013:p0006:b004:l023","ordinal":186568,"en":"Such was the sight."},{"id":"semetey-2-2013:p0006:b004:l024","ordinal":186569,"en":"The blue-gray-bearded swine's"},{"id":"semetey-2-2013:p0006:b004:l025","ordinal":186570,"en":"Chest button was the size of a fist."},{"id":"semetey-2-2013:p0006:b004:l026","ordinal":186571,"en":"At his waist was a düngürchök;"},{"id":"semetey-2-2013:p0006:b004:l027","ordinal":186572,"en":"He put his hand into the düngürchök"},{"id":"semetey-2-2013:p0006:b004:l028","ordinal":186573,"en":"And took tobacco from it."},{"id":"semetey-2-2013:p0006:b004:l029","ordinal":186574,"en":"He stuffed in five handfuls,"},{"id":"semetey-2-2013:p0006:b004:l030","ordinal":186575,"en":"Until the hero's pipe"},{"id":"semetey-2-2013:p0006:b004:l031","ordinal":186576,"en":"Lacked only five finger-widths of being full."},{"id":"semetey-2-2013:p0006:b004:l032","ordinal":186577,"en":"Striking Chinese flint and liver-stone,"},{"id":"semetey-2-2013:p0006:b004:l033","ordinal":186578,"en":"He made a spark and set an ember,"},{"id":"semetey-2-2013:p0006:b004:l034","ordinal":186579,"en":"And lit his pipe."},{"id":"semetey-2-2013:p0006:b004:l035","ordinal":186580,"en":"He sucked until it rumbled,"},{"id":"semetey-2-2013:p0006:b004:l036","ordinal":186581,"en":"Until his craving was satisfied."},{"id":"semetey-2-2013:p0006:b006:l001","ordinal":186582,"en":"When he let it go, it rumbled;"},{"id":"semetey-2-2013:p0006:b006:l002","ordinal":186583,"en":"The smoke from his pipe"},{"id":"semetey-2-2013:p0006:b006:l003","ordinal":186584,"en":"Billowed like the smoke of an army."},{"id":"semetey-2-2013:p0006:b006:l004","ordinal":186585,"en":"Algara beneath him—"},{"id":"semetey-2-2013:p0006:b006:l005","ordinal":186586,"en":"Did Algara not have"},{"id":"semetey-2-2013:p0006:b006:l006","ordinal":186587,"en":"Wings upon his flanks?"},{"id":"semetey-2-2013:p0006:b006:l007","ordinal":186588,"en":"This was the infidel's Black Horse."},{"id":"semetey-2-2013:p0006:b006:l008","ordinal":186589,"en":"Alööke's Kongurbai,"},{"id":"semetey-2-2013:p0006:b006:l009","ordinal":186590,"en":"Watching the guard and grieving over the road,"},{"id":"semetey-2-2013:p0006:b006:l010","ordinal":186591,"en":"As was always his custom—"},{"id":"semetey-2-2013:p0006:b006:l011","ordinal":186592,"en":"His tail was sparse and his mane scant;"},{"id":"semetey-2-2013:p0006:b006:l012","ordinal":186593,"en":"If he chased a kulan, it could not escape,"},{"id":"semetey-2-2013:p0006:b006:l013","ordinal":186594,"en":"He was skilled at pursuing an enemy."},{"id":"semetey-2-2013:p0006:b006:l014","ordinal":186595,"en":"Algara turned his head."},{"id":"semetey-2-2013:p0006:b006:l015","ordinal":186596,"en":"Shouting in anger,"},{"id":"semetey-2-2013:p0006:b006:l016","ordinal":186597,"en":"Kongurbai called Karagul."},{"id":"semetey-2-2013:p0006:b006:l017","ordinal":186598,"en":"Karagul came running,"},{"id":"semetey-2-2013:p0006:b006:l018","ordinal":186599,"en":"His knee bending to the ground;"},{"id":"semetey-2-2013:p0006:b006:l019","ordinal":186600,"en":"Before hero Kongurbai"},{"id":"semetey-2-2013:p0006:b006:l020","ordinal":186601,"en":"He bowed like a bride."},{"id":"semetey-2-2013:p0006:b006:l021","ordinal":186602,"en":"There was the dog's bloody name:"},{"id":"semetey-2-2013:p0006:b006:l022","ordinal":186603,"en":"When their chief came before them,"},{"id":"semetey-2-2013:p0006:b006:l023","ordinal":186604,"en":"It was the custom of the Chinese"},{"id":"semetey-2-2013:p0006:b006:l024","ordinal":186605,"en":"To bow like women."},{"id":"semetey-2-2013:p0006:b006:l025","ordinal":186606,"en":"Then Kongurbai"},{"id":"semetey-2-2013:p0006:b006:l026","ordinal":186607,"en":"Said this to Karagul,"},{"id":"semetey-2-2013:p0006:b006:l027","ordinal":186608,"en":"And at will spoke many horrors:"},{"id":"semetey-2-2013:p0006:b006:l028","ordinal":186609,"en":"“Your father's grave, Karagul!"},{"id":"semetey-2-2013:p0006:b006:l029","ordinal":186610,"en":"I reconnoitered the broad steppe and narrow road"},{"id":"semetey-2-2013:p0006:b006:l030","ordinal":186611,"en":"To their very ends;"},{"id":"semetey-2-2013:p0006:b006:l031","ordinal":186612,"en":"I went as far as"},{"id":"semetey-2-2013:p0006:b006:l032","ordinal":186613,"en":"The great and renowned Altai."},{"id":"semetey-2-2013:p0006:b006:l033","ordinal":186614,"en":"I made Algara's back sore"},{"id":"semetey-2-2013:p0006:b006:l034","ordinal":186615,"en":"And greatly pained my backside."},{"id":"semetey-2-2013:p0006:b006:l035","ordinal":186616,"en":"There was no cawing crow,"},{"id":"semetey-2-2013:p0006:b006:l036","ordinal":186617,"en":"No croaking raven,"},{"id":"semetey-2-2013:p0007:b003:l001","ordinal":186618,"en":"No vulture circles overhead;"},{"id":"semetey-2-2013:p0007:b003:l002","ordinal":186619,"en":"My leopard Karagul,"},{"id":"semetey-2-2013:p0007:b003:l003","ordinal":186620,"en":"There is none greater than me."},{"id":"semetey-2-2013:p0007:b003:l004","ordinal":186621,"en":"There is no boat upon the black water;"},{"id":"semetey-2-2013:p0007:b003:l005","ordinal":186622,"en":"While my splendid head remains,"},{"id":"semetey-2-2013:p0007:b003:l006","ordinal":186623,"en":"There is no one who can answer me back."},{"id":"semetey-2-2013:p0007:b003:l007","ordinal":186624,"en":"There is no boat upon the crosswise water;"}]
