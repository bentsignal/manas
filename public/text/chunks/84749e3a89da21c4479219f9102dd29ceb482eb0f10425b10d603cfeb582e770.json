[{"id":"seytek-2012:p0114:b002:l033","ordinal":302593,"en":"This ruined soul cried aloud,"},{"id":"seytek-2012:p0114:b002:l034","ordinal":302594,"en":"Unable even to walk by himself."},{"id":"seytek-2012:p0114:b002:l035","ordinal":302595,"en":"If I would enter the earth, the ground was hard;"},{"id":"seytek-2012:p0114:b002:l036","ordinal":302596,"en":"If I would die, life was sweet."},{"id":"seytek-2012:p0114:b002:l037","ordinal":302597,"en":"Neither dying nor vanishing, I lived on,"},{"id":"seytek-2012:p0114:b002:l038","ordinal":302598,"en":"Wondering what I should do."},{"id":"seytek-2012:p0114:b002:l039","ordinal":302599,"en":"I lived in hope of seeing"},{"id":"seytek-2012:p0114:b002:l040","ordinal":302600,"en":"Even a glimpse of the boy.”"},{"id":"seytek-2012:p0114:b003:l001","ordinal":302601,"en":"His whole being dissolved,"},{"id":"seytek-2012:p0114:b003:l002","ordinal":302602,"en":"His flesh and sinews stretched with yearning;"},{"id":"seytek-2012:p0114:b003:l003","ordinal":302603,"en":"His heart became burning embers,"},{"id":"seytek-2012:p0114:b003:l004","ordinal":302604,"en":"As though his extinguished fire had kindled anew."},{"id":"seytek-2012:p0114:b003:l005","ordinal":302605,"en":"His dying soul revived,"},{"id":"seytek-2012:p0114:b003:l006","ordinal":302606,"en":"As though God had fulfilled his wish,"},{"id":"seytek-2012:p0114:b003:l007","ordinal":302607,"en":"As though the vanished Semetey"},{"id":"seytek-2012:p0114:b003:l008","ordinal":302608,"en":"Had returned alive that very day."},{"id":"seytek-2012:p0114:b003:l009","ordinal":302609,"en":"The wretched Choro’s"},{"id":"seytek-2012:p0114:b003:l010","ordinal":302610,"en":"Pale face softened;"},{"id":"seytek-2012:p0114:b003:l011","ordinal":302611,"en":"Tears flowing from both eyes"},{"id":"seytek-2012:p0114:b003:l012","ordinal":302612,"en":"Poured down his chest."},{"id":"seytek-2012:p0114:b003:l013","ordinal":302613,"en":"The sorrowful ones met,"},{"id":"seytek-2012:p0114:b003:l014","ordinal":302614,"en":"Their hearts burning and dissolving;"},{"id":"seytek-2012:p0114:b003:l015","ordinal":302615,"en":"The lost were found,"},{"id":"seytek-2012:p0114:b003:l016","ordinal":302616,"en":"And the ill-fated Choro’s"},{"id":"seytek-2012:p0114:b003:l017","ordinal":302617,"en":"Honor was restored that day."},{"id":"seytek-2012:p0114:b003:l018","ordinal":302618,"en":"When he saw the boy,"},{"id":"seytek-2012:p0114:b003:l019","ordinal":302619,"en":"How could Külchoro not burn with feeling?"},{"id":"seytek-2012:p0114:b003:l020","ordinal":302620,"en":"Tears streaming down both cheeks"},{"id":"seytek-2012:p0114:b003:l021","ordinal":302621,"en":"Fell upon his chest."},{"id":"seytek-2012:p0114:b003:l022","ordinal":302622,"en":"He wailed with such a cry"},{"id":"seytek-2012:p0114:b003:l023","ordinal":302623,"en":"That his voice reached God;"},{"id":"seytek-2012:p0114:b003:l024","ordinal":302624,"en":"Overcome with anguish, Külchoro"},{"id":"seytek-2012:p0114:b003:l025","ordinal":302625,"en":"Fell upon the boy and embraced him."},{"id":"seytek-2012:p0114:b003:l026","ordinal":302626,"en":"Holding him close, Külchoro"},{"id":"seytek-2012:p0114:b003:l027","ordinal":302627,"en":"Stood weeping with piercing cries."},{"id":"seytek-2012:p0114:b003:l028","ordinal":302628,"en":"Pressing the orphan to his breast,"},{"id":"seytek-2012:p0114:b003:l029","ordinal":302629,"en":"He stood sobbing bitterly."},{"id":"seytek-2012:p0114:b003:l030","ordinal":302630,"en":"As Külchoro held him,"},{"id":"seytek-2012:p0114:b003:l031","ordinal":302631,"en":"The birch wept, the willow wept,"},{"id":"seytek-2012:p0114:b003:l032","ordinal":302632,"en":"And every watching soul wept."},{"id":"seytek-2012:p0114:b003:l033","ordinal":302633,"en":"All those many people cried,"},{"id":"seytek-2012:p0114:b003:l034","ordinal":302634,"en":"Consumed by their own grief;"},{"id":"seytek-2012:p0114:b003:l035","ordinal":302635,"en":"They wept, saying that when misery befalls a hero,"},{"id":"seytek-2012:p0114:b003:l036","ordinal":302636,"en":"This is how it must be."},{"id":"seytek-2012:p0114:b003:l037","ordinal":302637,"en":"Like elder and younger brothers reunited,"},{"id":"seytek-2012:p0114:b003:l038","ordinal":302638,"en":"They stood mingled together;"},{"id":"seytek-2012:p0114:b003:l039","ordinal":302639,"en":"Like the hair of a white gazelle,"},{"id":"seytek-2012:p0114:b003:l040","ordinal":302640,"en":"They stood drawn close together."},{"id":"seytek-2012:p0115:b002:l001","ordinal":302641,"en":"Deprived of my swift steed,"},{"id":"seytek-2012:p0115:b002:l002","ordinal":302642,"en":"I came back a clumsy wretch."},{"id":"seytek-2012:p0115:b002:l003","ordinal":302643,"en":"Deprived of flowing mane and tail,"},{"id":"seytek-2012:p0115:b002:l004","ordinal":302644,"en":"I came back dull and broken."},{"id":"seytek-2012:p0115:b002:l005","ordinal":302645,"en":"My two eyes gouged out,"},{"id":"seytek-2012:p0115:b002:l006","ordinal":302646,"en":"My two shoulders flayed,"},{"id":"seytek-2012:p0115:b002:l007","ordinal":302647,"en":"Captured and grieving,"},{"id":"seytek-2012:p0115:b002:l008","ordinal":302648,"en":"Parted from my beloved,"},{"id":"seytek-2012:p0115:b002:l009","ordinal":302649,"en":"With every spirit beaten from me,"},{"id":"seytek-2012:p0115:b002:l010","ordinal":302650,"en":"I came back meek as a mullah."},{"id":"seytek-2012:p0115:b002:l011","ordinal":302651,"en":"Captured and disgraced,"},{"id":"seytek-2012:p0115:b002:l012","ordinal":302652,"en":"My days passing in humiliation,"},{"id":"seytek-2012:p0115:b002:l013","ordinal":302653,"en":"I came back reduced to a pacing nag."},{"id":"seytek-2012:p0115:b002:l014","ordinal":302654,"en":"My hands bound, my eyes staring,"},{"id":"seytek-2012:p0115:b002:l015","ordinal":302655,"en":"I came back trapped in a net."},{"id":"seytek-2012:p0115:b002:l016","ordinal":302656,"en":"From a place no man could escape,"},{"id":"seytek-2012:p0115:b002:l017","ordinal":302657,"en":"I came back as from a fortress."},{"id":"seytek-2012:p0115:b002:l018","ordinal":302658,"en":"To the infidel in his full strength,"},{"id":"seytek-2012:p0115:b002:l019","ordinal":302659,"en":"To mighty hero Kyyaz,"},{"id":"seytek-2012:p0115:b002:l020","ordinal":302660,"en":"I went as plunder."},{"id":"seytek-2012:p0115:b002:l021","ordinal":302661,"en":"I went after breaking my own pride,"},{"id":"seytek-2012:p0115:b002:l022","ordinal":302662,"en":"I went and surrendered myself as spoil."},{"id":"seytek-2012:p0115:b002:l023","ordinal":302663,"en":"In her old age, Kanykei,"},{"id":"seytek-2012:p0115:b002:l024","ordinal":302664,"en":"And when Chyyrdy had grown aged—"},{"id":"seytek-2012:p0115:b002:l025","ordinal":302665,"en":"Killing my lord day after day,"},{"id":"seytek-2012:p0115:b002:l026","ordinal":302666,"en":"He dragged away from Talas"},{"id":"seytek-2012:p0115:b002:l027","ordinal":302667,"en":"My two venerable mothers,"},{"id":"seytek-2012:p0115:b002:l028","ordinal":302668,"en":"He plundered my people,"},{"id":"seytek-2012:p0115:b002:l029","ordinal":302669,"en":"He broke my back,"},{"id":"seytek-2012:p0115:b002:l030","ordinal":302670,"en":"And raided my village in Keng-Kol."},{"id":"seytek-2012:p0115:b002:l031","ordinal":302671,"en":"Kanchoro took away"},{"id":"seytek-2012:p0115:b002:l032","ordinal":302672,"en":"Akbala, daughter of Jamgyrchy—"},{"id":"seytek-2012:p0115:b002:l033","ordinal":302673,"en":"My wife, the fair Akbala."},{"id":"seytek-2012:p0115:b002:l034","ordinal":302674,"en":"Those swine killed"},{"id":"seytek-2012:p0115:b002:l035","ordinal":302675,"en":"My giant warrior Er Sarykan,"},{"id":"seytek-2012:p0115:b002:l036","ordinal":302676,"en":"They shattered my brain"},{"id":"seytek-2012:p0115:b002:l037","ordinal":302677,"en":"And brought me endless grief."},{"id":"seytek-2012:p0115:b002:l038","ordinal":302678,"en":"When I recall the old days,"},{"id":"seytek-2012:p0115:b002:l039","ordinal":302679,"en":"These ribs of mine"},{"id":"seytek-2012:p0115:b002:l040","ordinal":302680,"en":"Part layer from layer."},{"id":"seytek-2012:p0115:b003:l001","ordinal":302681,"en":"After that, I went about"},{"id":"seytek-2012:p0115:b003:l002","ordinal":302682,"en":"Wishing to die and leave this world."},{"id":"seytek-2012:p0115:b003:l003","ordinal":302683,"en":"Then I saw your orphaned eyes,"},{"id":"seytek-2012:p0115:b003:l004","ordinal":302684,"en":"Young falcon left by the hero,"},{"id":"seytek-2012:p0115:b003:l005","ordinal":302685,"en":"And longed to behold you."},{"id":"seytek-2012:p0115:b003:l006","ordinal":302686,"en":"Eager to see you, I hurried,"},{"id":"seytek-2012:p0115:b003:l007","ordinal":302687,"en":"Staggering beneath firewood,"},{"id":"seytek-2012:p0115:b003:l008","ordinal":302688,"en":"Beaten with clubs by the herdsmen,"},{"id":"seytek-2012:p0115:b003:l009","ordinal":302689,"en":"Ravaged and thrashed,"},{"id":"seytek-2012:p0115:b003:l010","ordinal":302690,"en":"With cudgels raining on my back."},{"id":"seytek-2012:p0115:b003:l011","ordinal":302691,"en":"“Master, show me mercy,” I begged,"},{"id":"seytek-2012:p0115:b003:l012","ordinal":302692,"en":"Pleading even with lowly slaves."},{"id":"seytek-2012:p0115:b003:l013","ordinal":302693,"en":"Your uncle went about flayed raw,"},{"id":"seytek-2012:p0115:b003:l014","ordinal":302694,"en":"With no strength left to fight,"},{"id":"seytek-2012:p0115:b003:l015","ordinal":302695,"en":"His shoulders deeply gouged."},{"id":"seytek-2012:p0115:b003:l016","ordinal":302696,"en":"Your uncle, once like a mighty stallion,"},{"id":"seytek-2012:p0115:b003:l017","ordinal":302697,"en":"Became pliant as leather,"},{"id":"seytek-2012:p0115:b003:l018","ordinal":302698,"en":"And all I saw was turmoil."},{"id":"seytek-2012:p0115:b003:l019","ordinal":302699,"en":"Instead of food, I drank"},{"id":"seytek-2012:p0115:b003:l020","ordinal":302700,"en":"Nine bucketfuls of water,"},{"id":"seytek-2012:p0115:b003:l021","ordinal":302701,"en":"Stretched out like a hide,"},{"id":"seytek-2012:p0115:b003:l022","ordinal":302702,"en":"While a horse’s knobby ankle bone"},{"id":"seytek-2012:p0115:b003:l023","ordinal":302703,"en":"Was given me in place of food."},{"id":"seytek-2012:p0115:b003:l024","ordinal":302704,"en":"Your uncle suffered pillage,"},{"id":"seytek-2012:p0115:b003:l025","ordinal":302705,"en":"His precious body endured beatings."},{"id":"seytek-2012:p0115:b003:l026","ordinal":302706,"en":"Clubs struck my back,"},{"id":"seytek-2012:p0115:b003:l027","ordinal":302707,"en":"Spikes pierced my rump."},{"id":"seytek-2012:p0115:b003:l028","ordinal":302708,"en":"I set out to gather firewood,"},{"id":"seytek-2012:p0115:b003:l029","ordinal":302709,"en":"And three times every day"},{"id":"seytek-2012:p0115:b003:l030","ordinal":302710,"en":"I was wrapped in thorns."},{"id":"seytek-2012:p0115:b003:l031","ordinal":302711,"en":"I was mauled by strongmen,"},{"id":"seytek-2012:p0115:b003:l032","ordinal":302712,"en":"Beaten by the herdsmen."},{"id":"seytek-2012:p0115:b003:l033","ordinal":302713,"en":"Long did I carry firewood,"},{"id":"seytek-2012:p0115:b003:l034","ordinal":302714,"en":"Hoping, if I did not die, to see"},{"id":"seytek-2012:p0115:b003:l035","ordinal":302715,"en":"The orphan left as our legacy."},{"id":"seytek-2012:p0115:b003:l036","ordinal":302716,"en":"May God never inflict upon another"},{"id":"seytek-2012:p0115:b003:l037","ordinal":302717,"en":"The humiliations I endured,"},{"id":"seytek-2012:p0115:b003:l038","ordinal":302718,"en":"My son, nor the torment that befell me."},{"id":"seytek-2012:p0115:b003:l039","ordinal":302719,"en":"My horns broken, left forlorn,"},{"id":"seytek-2012:p0115:b003:l040","ordinal":302720,"en":"I came back shorn of all power."},{"id":"seytek-2012:p0116:b002:l001","ordinal":302721,"en":"No mortal can deny it."},{"id":"seytek-2012:p0116:b002:l002","ordinal":302722,"en":"His fortunes were perfectly balanced;"},{"id":"seytek-2012:p0116:b002:l003","ordinal":302723,"en":"When you looked into his heart,"},{"id":"seytek-2012:p0116:b002:l004","ordinal":302724,"en":"It was broader than the whole earth."},{"id":"seytek-2012:p0116:b002:l005","ordinal":302725,"en":"God will never create another man"},{"id":"seytek-2012:p0116:b002:l006","ordinal":302726,"en":"Made like your father."},{"id":"seytek-2012:p0116:b002:l007","ordinal":302727,"en":"Your father was a fierce gray-maned lion,"},{"id":"seytek-2012:p0116:b002:l008","ordinal":302728,"en":"Who tethered fourteen steeds,"},{"id":"seytek-2012:p0116:b002:l009","ordinal":302729,"en":"And dwelt in central Keng-Kol."},{"id":"seytek-2012:p0116:b002:l010","ordinal":302730,"en":"If an enemy came out shooting,"},{"id":"seytek-2012:p0116:b002:l011","ordinal":302731,"en":"He drove them before him."},{"id":"seytek-2012:p0116:b002:l012","ordinal":302732,"en":"Whoever stirred his wrath,"},{"id":"seytek-2012:p0116:b002:l013","ordinal":302733,"en":"He crushed between his fangs."},{"id":"seytek-2012:p0116:b002:l014","ordinal":302734,"en":"My son, such is my story."},{"id":"seytek-2012:p0116:b002:l015","ordinal":302735,"en":"Your dear father’s confidant,"},{"id":"seytek-2012:p0116:b002:l016","ordinal":302736,"en":"The noble Choro, his companion,"},{"id":"seytek-2012:p0116:b002:l017","ordinal":302737,"en":"Whose stallion carried him to Altai,"},{"id":"seytek-2012:p0116:b002:l018","ordinal":302738,"en":"Was your father’s kinsman."},{"id":"seytek-2012:p0116:b002:l019","ordinal":302739,"en":"They kicked together like foals,"},{"id":"seytek-2012:p0116:b002:l020","ordinal":302740,"en":"And contended for the same breast."},{"id":"seytek-2012:p0116:b002:l021","ordinal":302741,"en":"Liver and choice cuts"},{"id":"seytek-2012:p0116:b002:l022","ordinal":302742,"en":"Were divided equally for them,"},{"id":"seytek-2012:p0116:b002:l023","ordinal":302743,"en":"And the countless Nogai and Kyrgyz"},{"id":"seytek-2012:p0116:b002:l024","ordinal":302744,"en":"Called them the foremost of sons."},{"id":"seytek-2012:p0116:b002:l025","ordinal":302745,"en":"So that we might become true brothers,"},{"id":"seytek-2012:p0116:b002:l026","ordinal":302746,"en":"Our mother Kanykei gave both of us"},{"id":"seytek-2012:p0116:b002:l027","ordinal":302747,"en":"Milk from her own breast."},{"id":"seytek-2012:p0116:b002:l028","ordinal":302748,"en":"From the left breast Kanchoro sucked,"},{"id":"seytek-2012:p0116:b002:l029","ordinal":302749,"en":"Dark crimson blood flowed."},{"id":"seytek-2012:p0116:b002:l030","ordinal":302750,"en":"From the right breast Külchoro sucked,"},{"id":"seytek-2012:p0116:b002:l031","ordinal":302751,"en":"Pure white milk welled like a spring."},{"id":"seytek-2012:p0116:b002:l032","ordinal":302752,"en":"“I have seen an omen in the boys,”"},{"id":"seytek-2012:p0116:b002:l033","ordinal":302753,"en":"Your sorrowful mother wept."},{"id":"seytek-2012:p0116:b002:l034","ordinal":302754,"en":"“Külchoro, for whom milk sprang forth”—"},{"id":"seytek-2012:p0116:b002:l035","ordinal":302755,"en":"These were my mother Kanykei’s words—"},{"id":"seytek-2012:p0116:b002:l036","ordinal":302756,"en":"“If Külchoro survives"},{"id":"seytek-2012:p0116:b002:l037","ordinal":302757,"en":"And you heed my words from the start,"},{"id":"seytek-2012:p0116:b002:l038","ordinal":302758,"en":"He will be your inheritance and support."},{"id":"seytek-2012:p0116:b002:l039","ordinal":302759,"en":"But this Kanchoro here,"},{"id":"seytek-2012:p0116:b002:l040","ordinal":302760,"en":"To tell you the truth,"},{"id":"seytek-2012:p0116:b003:l001","ordinal":302761,"en":"Is a cursed and grievous menace;"},{"id":"seytek-2012:p0116:b003:l002","ordinal":302762,"en":"It shows in your blood-uncle.”"},{"id":"seytek-2012:p0116:b003:l003","ordinal":302763,"en":"The Jediger surged in wildly,"},{"id":"seytek-2012:p0116:b003:l004","ordinal":302764,"en":"And mighty Kyyaz emerged as their chief."},{"id":"seytek-2012:p0116:b003:l005","ordinal":302765,"en":"The enemy among us was Kanchoro,"},{"id":"seytek-2012:p0116:b003:l006","ordinal":302766,"en":"Who became a man of infamous name."},{"id":"seytek-2012:p0116:b003:l007","ordinal":302767,"en":"He shattered my happiness"},{"id":"seytek-2012:p0116:b003:l008","ordinal":302768,"en":"And destroyed my golden throne."},{"id":"seytek-2012:p0116:b003:l009","ordinal":302769,"en":"He left my people wailing"},{"id":"seytek-2012:p0116:b003:l010","ordinal":302770,"en":"And broke my back."},{"id":"seytek-2012:p0116:b003:l011","ordinal":302771,"en":"He felled my flourishing tree,"},{"id":"seytek-2012:p0116:b003:l012","ordinal":302772,"en":"And tore down all my dwellings."},{"id":"seytek-2012:p0116:b003:l013","ordinal":302773,"en":"He made widows of braided women,"},{"id":"seytek-2012:p0116:b003:l014","ordinal":302774,"en":"And trampled proud young lords"},{"id":"seytek-2012:p0116:b003:l015","ordinal":302775,"en":"Underfoot like loose wool."},{"id":"seytek-2012:p0116:b003:l016","ordinal":302776,"en":"He bloodied the mouth of my gateway"},{"id":"seytek-2012:p0116:b003:l017","ordinal":302777,"en":"And turned my black road to dust."},{"id":"seytek-2012:p0116:b003:l018","ordinal":302778,"en":"Many powerful lionhearted warriors"},{"id":"seytek-2012:p0116:b003:l019","ordinal":302779,"en":"He utterly swept away."},{"id":"seytek-2012:p0116:b003:l020","ordinal":302780,"en":"At Talas he slaughtered"},{"id":"seytek-2012:p0116:b003:l021","ordinal":302781,"en":"My giant, Semetey."},{"id":"seytek-2012:p0116:b003:l022","ordinal":302782,"en":"He battered my head again and again,"},{"id":"seytek-2012:p0116:b003:l023","ordinal":302783,"en":"And brought me endless grief."},{"id":"seytek-2012:p0116:b003:l024","ordinal":302784,"en":"My helpless people were plundered;"},{"id":"seytek-2012:p0116:b003:l025","ordinal":302785,"en":"I do not know whether he lives or is dead—"},{"id":"seytek-2012:p0116:b003:l026","ordinal":302786,"en":"My uncle, heroic Bakai."},{"id":"seytek-2012:p0116:b003:l027","ordinal":302787,"en":"He left my land of Talas desolate"},{"id":"seytek-2012:p0116:b003:l028","ordinal":302788,"en":"And scattered my Kyrgyz people."},{"id":"seytek-2012:p0116:b003:l029","ordinal":302789,"en":"He ignored all my pleas"},{"id":"seytek-2012:p0116:b003:l030","ordinal":302790,"en":"And cut down my remaining men with swords."},{"id":"seytek-2012:p0116:b003:l031","ordinal":302791,"en":"In his day your Külchoro"},{"id":"seytek-2012:p0116:b003:l032","ordinal":302792,"en":"Conquered Beijing and grew mighty,"},{"id":"seytek-2012:p0116:b003:l033","ordinal":302793,"en":"But parted from his hero,"},{"id":"seytek-2012:p0116:b003:l034","ordinal":302794,"en":"Your hapless uncle fell into disgrace."},{"id":"seytek-2012:p0116:b003:l035","ordinal":302795,"en":"Your father, the formidable Semetey,"},{"id":"seytek-2012:p0116:b003:l036","ordinal":302796,"en":"Was a lion favored by the spirits."},{"id":"seytek-2012:p0116:b003:l037","ordinal":302797,"en":"God will not soon create"},{"id":"seytek-2012:p0116:b003:l038","ordinal":302798,"en":"Among mortal men"},{"id":"seytek-2012:p0116:b003:l039","ordinal":302799,"en":"Another like your father."},{"id":"seytek-2012:p0116:b003:l040","ordinal":302800,"en":"He was a mighty, steadfast stronghold."},{"id":"seytek-2012:p0117:b002:l001","ordinal":302801,"en":"He enslaved in Talas"},{"id":"seytek-2012:p0117:b002:l002","ordinal":302802,"en":"My mother, noble Kanykei."},{"id":"seytek-2012:p0117:b002:l003","ordinal":302803,"en":"The accursed man seized as plunder"},{"id":"seytek-2012:p0117:b002:l004","ordinal":302804,"en":"My sister-in-law Chachykei."},{"id":"seytek-2012:p0117:b002:l005","ordinal":302805,"en":"He drove away and seized my livestock"},{"id":"seytek-2012:p0117:b002:l006","ordinal":302806,"en":"And drained my blood till I wasted away."},{"id":"seytek-2012:p0117:b002:l007","ordinal":302807,"en":"He made me taste bitter salt"},{"id":"seytek-2012:p0117:b002:l008","ordinal":302808,"en":"And let my daughter be despoiled."},{"id":"seytek-2012:p0117:b002:l009","ordinal":302809,"en":"Those witless dogs grew insolent"},{"id":"seytek-2012:p0117:b002:l010","ordinal":302810,"en":"And turned savagely upon their master."},{"id":"seytek-2012:p0117:b002:l011","ordinal":302811,"en":"The strutting villains gathered"},{"id":"seytek-2012:p0117:b002:l012","ordinal":302812,"en":"And raided my caravan from Keng-Kol."},{"id":"seytek-2012:p0117:b002:l013","ordinal":302813,"en":"Grieving and sorely disgraced,"},{"id":"seytek-2012:p0117:b002:l014","ordinal":302814,"en":"I returned without taking revenge."},{"id":"seytek-2012:p0117:b002:l015","ordinal":302815,"en":"They plundered my old people."},{"id":"seytek-2012:p0117:b002:l016","ordinal":302816,"en":"Against those swaggering dogs,"},{"id":"seytek-2012:p0117:b002:l017","ordinal":302817,"en":"Because I stood alone,"},{"id":"seytek-2012:p0117:b002:l018","ordinal":302818,"en":"I returned unable to ease my pain."},{"id":"seytek-2012:p0117:b002:l019","ordinal":302819,"en":"To gird my waist firmly,"},{"id":"seytek-2012:p0117:b002:l020","ordinal":302820,"en":"To avenge my heroic lord and brother—"},{"id":"seytek-2012:p0117:b002:l021","ordinal":302821,"en":"My tongue speaks, but I have no strength;"},{"id":"seytek-2012:p0117:b002:l022","ordinal":302822,"en":"Though I glare at them, I am helpless."},{"id":"seytek-2012:p0117:b002:l023","ordinal":302823,"en":"To clash with them and raise a battle,"},{"id":"seytek-2012:p0117:b002:l024","ordinal":302824,"en":"I no longer have the thick wrists,"},{"id":"seytek-2012:p0117:b002:l025","ordinal":302825,"en":"The stony heart, or the days I once had."},{"id":"seytek-2012:p0117:b002:l026","ordinal":302826,"en":"My two hands can no longer move;"},{"id":"seytek-2012:p0117:b002:l027","ordinal":302827,"en":"My six limbs are no longer whole."},{"id":"seytek-2012:p0117:b002:l028","ordinal":302828,"en":"I no longer have blood surging beneath my skin,"},{"id":"seytek-2012:p0117:b002:l029","ordinal":302829,"en":"Nor strength to spur against"},{"id":"seytek-2012:p0117:b002:l030","ordinal":302830,"en":"Those dogs accursed by Heaven."},{"id":"seytek-2012:p0117:b002:l031","ordinal":302831,"en":"The thoroughbred once pranced among the herd,"},{"id":"seytek-2012:p0117:b002:l032","ordinal":302832,"en":"But your uncle’s former valor has departed."},{"id":"seytek-2012:p0117:b002:l033","ordinal":302833,"en":"Unable to die though wishing for death,"},{"id":"seytek-2012:p0117:b002:l034","ordinal":302834,"en":"I languish here like this."},{"id":"seytek-2012:p0117:b002:l035","ordinal":302835,"en":"The bright flowers have vanished from the pasture;"},{"id":"seytek-2012:p0117:b002:l036","ordinal":302836,"en":"Your uncle, once a lion of the world,"},{"id":"seytek-2012:p0117:b002:l037","ordinal":302837,"en":"Now languishes like this."},{"id":"seytek-2012:p0117:b002:l038","ordinal":302838,"en":"If I fought them as an equal,"},{"id":"seytek-2012:p0117:b002:l039","ordinal":302839,"en":"I no longer have my towering stature."},{"id":"seytek-2012:p0117:b002:l040","ordinal":302840,"en":"If I met them face-to-face in battle—"},{"id":"seytek-2012:p0117:b003:l001","ordinal":302841,"en":"“He will become your enemy,”"},{"id":"seytek-2012:p0117:b003:l002","ordinal":302842,"en":"My mother had told me."},{"id":"seytek-2012:p0117:b003:l003","ordinal":302843,"en":"“That Choro who will turn foe—"},{"id":"seytek-2012:p0117:b003:l004","ordinal":302844,"en":"Remove him from your sight."},{"id":"seytek-2012:p0117:b003:l005","ordinal":302845,"en":"My precious mother Kanykei"},{"id":"seytek-2012:p0117:b003:l006","ordinal":302846,"en":"Said to cut off his head with a sword."},{"id":"seytek-2012:p0117:b003:l007","ordinal":302847,"en":"“His mischief will harm many;"},{"id":"seytek-2012:p0117:b003:l008","ordinal":302848,"en":"Finish him once and for all."}]
