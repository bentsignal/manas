[{"id":"manas-2010:p1659:b001:l037","ordinal":71425,"en":"Without their lions Almambet and Chubak,"},{"id":"manas-2010:p1659:b001:l038","ordinal":71426,"en":"The Muslims, finding no way out,"},{"id":"manas-2010:p1659:b001:l039","ordinal":71427,"en":"Had taken to flight."},{"id":"manas-2010:p1659:b001:l040","ordinal":71428,"en":"Through their center, Kongurbay,"},{"id":"manas-2010:p1659:b001:l041","ordinal":71429,"en":"Striking his way, pursued them."},{"id":"manas-2010:p1659:b001:l042","ordinal":71430,"en":"Along both flanks, Ezkara,"},{"id":"manas-2010:p1660:b001:l001","ordinal":71431,"en":"Came sweeping through."},{"id":"manas-2010:p1660:b001:l002","ordinal":71432,"en":"Those who had fallen from their horses,"},{"id":"manas-2010:p1660:b001:l003","ordinal":71433,"en":"The trick riders, swift on foot,"},{"id":"manas-2010:p1660:b001:l004","ordinal":71434,"en":"The state's champions,"},{"id":"manas-2010:p1660:b001:l005","ordinal":71435,"en":"Came cutting off their heads."},{"id":"manas-2010:p1660:b001:l006","ordinal":71436,"en":"The handful of Muslims,"},{"id":"manas-2010:p1660:b001:l007","ordinal":71437,"en":"Herding them before them,"},{"id":"manas-2010:p1660:b001:l008","ordinal":71438,"en":"They came striking at them."},{"id":"manas-2010:p1660:b001:l009","ordinal":71439,"en":"The Muslims could not pause long;"},{"id":"manas-2010:p1660:b001:l010","ordinal":71440,"en":"From outside, the many infidels"},{"id":"manas-2010:p1660:b001:l011","ordinal":71441,"en":"Came driving them onward."},{"id":"manas-2010:p1660:b001:l012","ordinal":71442,"en":"Of many swift, winged steeds,"},{"id":"manas-2010:p1660:b001:l013","ordinal":71443,"en":"Saddles and saddlecloths hung at their bellies;"},{"id":"manas-2010:p1660:b001:l014","ordinal":71444,"en":"They came leading them as spare mounts."},{"id":"manas-2010:p1660:b001:l015","ordinal":71445,"en":"“My precious, dear brother"},{"id":"manas-2010:p1660:b001:l016","ordinal":71446,"en":"Has met death at Chinese hands!”"},{"id":"manas-2010:p1660:b001:l017","ordinal":71447,"en":"They came crying aloud."},{"id":"manas-2010:p1660:b001:l018","ordinal":71448,"en":"The two khans, Koshoy and Töshtük—"},{"id":"manas-2010:p1660:b001:l019","ordinal":71449,"en":"The many Chinese raised an uproar"},{"id":"manas-2010:p1660:b001:l020","ordinal":71450,"en":"When they pursued them from behind."},{"id":"manas-2010:p1660:b001:l021","ordinal":71451,"en":"Unable to gather their wits, staggering,"},{"id":"manas-2010:p1660:b001:l022","ordinal":71452,"en":"The Muslims came fleeing;"},{"id":"manas-2010:p1660:b001:l023","ordinal":71453,"en":"In the desert of It-Ölbös,"},{"id":"manas-2010:p1660:b001:l024","ordinal":71454,"en":"They came fleeing in groups."},{"id":"manas-2010:p1660:b001:l025","ordinal":71455,"en":"“Leopard Chubak, Almambet,"},{"id":"manas-2010:p1660:b001:l026","ordinal":71456,"en":"Where have my khans gone?”"},{"id":"manas-2010:p1660:b001:l027","ordinal":71457,"en":"They came fleeing, lamenting their absence."},{"id":"manas-2010:p1660:b001:l028","ordinal":71458,"en":"When he saw the Muslims,"},{"id":"manas-2010:p1660:b001:l029","ordinal":71459,"en":"Unable to turn his swift steed's head,"},{"id":"manas-2010:p1660:b001:l030","ordinal":71460,"en":"Choking, weeping, sobbing,"},{"id":"manas-2010:p1660:b001:l031","ordinal":71461,"en":"Your peerless Alma could not stand still."},{"id":"manas-2010:p1660:b001:l032","ordinal":71462,"en":"Grasping his spear, struggling,"},{"id":"manas-2010:p1660:b001:l033","ordinal":71463,"en":"He pleaded with the forty warriors beside him:"},{"id":"manas-2010:p1660:b001:l034","ordinal":71464,"en":"“My dear forty companions,"},{"id":"manas-2010:p1660:b001:l035","ordinal":71465,"en":"Yesterday, in the hollow of Zhylgynduu,"},{"id":"manas-2010:p1660:b001:l036","ordinal":71466,"en":"Along broad Talas,"},{"id":"manas-2010:p1660:b001:l037","ordinal":71467,"en":"When the many Argyn came down to the plain,"},{"id":"manas-2010:p1660:b001:l038","ordinal":71468,"en":"When they were encamping,"},{"id":"manas-2010:p1660:b001:l039","ordinal":71469,"en":"With fermented mare's milk by day, girls by night,"},{"id":"manas-2010:p1660:b001:l040","ordinal":71470,"en":"When that was how things were,"},{"id":"manas-2010:p1660:b001:l041","ordinal":71471,"en":"The bulletproof black cap,"},{"id":"manas-2010:p1660:b001:l042","ordinal":71472,"en":"When you shaped its edge,"},{"id":"manas-2010:p1661:b001:l001","ordinal":71473,"en":"Knowing the Kyrgyz together,"},{"id":"manas-2010:p1661:b001:l002","ordinal":71474,"en":"When you lived in delight,"},{"id":"manas-2010:p1661:b001:l003","ordinal":71475,"en":"Ravaging Ombu and taking spoils,"},{"id":"manas-2010:p1661:b001:l004","ordinal":71476,"en":"Breaking through its center, opening a road,"},{"id":"manas-2010:p1661:b001:l005","ordinal":71477,"en":"A century without a check"},{"id":"manas-2010:p1661:b001:l006","ordinal":71478,"en":"When you were raiding it,"},{"id":"manas-2010:p1661:b001:l007","ordinal":71479,"en":"The Six Cities and Kokand,"},{"id":"manas-2010:p1661:b001:l008","ordinal":71480,"en":"Driving and beating them,"},{"id":"manas-2010:p1661:b001:l009","ordinal":71481,"en":"Six thousand silver ingots, a thousand otter pelts,"},{"id":"manas-2010:p1661:b001:l010","ordinal":71482,"en":"Imposing tribute each month,"},{"id":"manas-2010:p1661:b001:l011","ordinal":71483,"en":"When you were collecting it,"},{"id":"manas-2010:p1661:b001:l012","ordinal":71484,"en":"When you all stood together,"},{"id":"manas-2010:p1661:b001:l013","ordinal":71485,"en":"I would slice and eat horse rump;"},{"id":"manas-2010:p1661:b001:l014","ordinal":71486,"en":"Afflicting my own life,"},{"id":"manas-2010:p1661:b001:l015","ordinal":71487,"en":"I would say, ‘I shall overthrow the governor-general.’"},{"id":"manas-2010:p1661:b001:l016","ordinal":71488,"en":"Black-steel Zulpuqor—"},{"id":"manas-2010:p1661:b001:l017","ordinal":71489,"en":"You used to say, ‘I shall go clashing in battle.’"},{"id":"manas-2010:p1661:b001:l018","ordinal":71490,"en":"Against the whole world, let alone China,"},{"id":"manas-2010:p1661:b001:l019","ordinal":71491,"en":"You would say, ‘I shall shoulder my way through.’"},{"id":"manas-2010:p1661:b001:l020","ordinal":71492,"en":"The thoughtfully crafted bulletproof armor,"},{"id":"manas-2010:p1661:b001:l021","ordinal":71493,"en":"You would say, ‘I shall put it on.’"},{"id":"manas-2010:p1661:b001:l022","ordinal":71494,"en":"If the handful of the Islamic faith"},{"id":"manas-2010:p1661:b001:l023","ordinal":71495,"en":"Had hardship fall upon their heads,"},{"id":"manas-2010:p1661:b001:l024","ordinal":71496,"en":"Against the eighteen thousand worlds,"},{"id":"manas-2010:p1661:b001:l025","ordinal":71497,"en":"You would say, ‘I shall rise in battle.’"},{"id":"manas-2010:p1661:b001:l026","ordinal":71498,"en":"If an enemy came grasping spears,"},{"id":"manas-2010:p1661:b001:l027","ordinal":71499,"en":"If a claim came from a place of hardship,"},{"id":"manas-2010:p1661:b001:l028","ordinal":71500,"en":"Clashing spears and shouting,"},{"id":"manas-2010:p1661:b001:l029","ordinal":71501,"en":"You would say, ‘I shall prevail.’"},{"id":"manas-2010:p1661:b001:l030","ordinal":71502,"en":"If upon your flanks, from the Chinese,"},{"id":"manas-2010:p1661:b001:l031","ordinal":71503,"en":"A terrible pressure came,"},{"id":"manas-2010:p1661:b001:l032","ordinal":71504,"en":"Entering without looking back, firing,"},{"id":"manas-2010:p1661:b001:l033","ordinal":71505,"en":"You, daughter-divorced, said, ‘I shall hold them off.’"},{"id":"manas-2010:p1661:b001:l034","ordinal":71506,"en":"A precious coat that bullets cannot pierce,"},{"id":"manas-2010:p1661:b001:l035","ordinal":71507,"en":"You would say, ‘I shall put it on.’"},{"id":"manas-2010:p1661:b001:l036","ordinal":71508,"en":"If the Muslims met with grievous trouble,"},{"id":"manas-2010:p1661:b001:l037","ordinal":71509,"en":"Entering without turning, firing,"},{"id":"manas-2010:p1661:b001:l038","ordinal":71510,"en":"You would say, ‘I shall hold them off.’"},{"id":"manas-2010:p1661:b001:l039","ordinal":71511,"en":"Does not a man whose death is due die?"},{"id":"manas-2010:p1661:b001:l040","ordinal":71512,"en":"Does not the poor mortal suffer hardship?"},{"id":"manas-2010:p1661:b001:l041","ordinal":71513,"en":"Will the black earth not hold us?"},{"id":"manas-2010:p1661:b001:l042","ordinal":71514,"en":"Will the grave dug for us not admit us?"},{"id":"manas-2010:p1662:b001:l001","ordinal":71515,"en":"Death is a great guest;"},{"id":"manas-2010:p1662:b001:l002","ordinal":71516,"en":"All those who have not died"},{"id":"manas-2010:p1662:b001:l003","ordinal":71517,"en":"Strive greedily while alive."},{"id":"manas-2010:p1662:b001:l004","ordinal":71518,"en":"From the Creator, the One Almighty,"},{"id":"manas-2010:p1662:b001:l005","ordinal":71519,"en":"When the firm command arrives,"},{"id":"manas-2010:p1662:b001:l006","ordinal":71520,"en":"Gabriel, taker of souls,"},{"id":"manas-2010:p1662:b001:l007","ordinal":71521,"en":"When he firmly stretches out five fingers,"},{"id":"manas-2010:p1662:b001:l008","ordinal":71522,"en":"Your ruddy complexion darkens."},{"id":"manas-2010:p1662:b001:l009","ordinal":71523,"en":"From this death standing here,"},{"id":"manas-2010:p1662:b001:l010","ordinal":71524,"en":"Heroes, what soul can flee and escape?"},{"id":"manas-2010:p1662:b001:l011","ordinal":71525,"en":"At the infidels coming darkly,"},{"id":"manas-2010:p1662:b001:l012","ordinal":71526,"en":"Let us go straight and thrust our spears;"},{"id":"manas-2010:p1662:b001:l013","ordinal":71527,"en":"From hell with its grievous burdens,"},{"id":"manas-2010:p1662:b001:l014","ordinal":71528,"en":"Warriors, let us free our souls!"},{"id":"manas-2010:p1662:b001:l015","ordinal":71529,"en":"At the swarming black infidels,"},{"id":"manas-2010:p1662:b001:l016","ordinal":71530,"en":"Let us charge and stretch out our swords;"},{"id":"manas-2010:p1662:b001:l017","ordinal":71531,"en":"From hell whose very news is grievous,"},{"id":"manas-2010:p1662:b001:l018","ordinal":71532,"en":"Warriors, let us free our souls!"},{"id":"manas-2010:p1662:b001:l019","ordinal":71533,"en":"Upon the swarming black infidels,"},{"id":"manas-2010:p1662:b001:l020","ordinal":71534,"en":"Let us unleash a furious battle."},{"id":"manas-2010:p1662:b001:l021","ordinal":71535,"en":"The tiny band of Islam,"},{"id":"manas-2010:p1662:b001:l022","ordinal":71536,"en":"If we do not rescue them,"},{"id":"manas-2010:p1662:b001:l023","ordinal":71537,"en":"Will they not recognize our ignorance?"},{"id":"manas-2010:p1662:b001:l024","ordinal":71538,"en":"That thing called disgrace,"},{"id":"manas-2010:p1662:b001:l025","ordinal":71539,"en":"Will they not hang it around our necks?"},{"id":"manas-2010:p1662:b001:l026","ordinal":71540,"en":"If what is said is true,"},{"id":"manas-2010:p1662:b001:l027","ordinal":71541,"en":"Tomorrow, on the Day of Resurrection,"},{"id":"manas-2010:p1662:b001:l028","ordinal":71542,"en":"‘You abandoned us,’ they will say;"},{"id":"manas-2010:p1662:b001:l029","ordinal":71543,"en":"The Muslims who died fighting"},{"id":"manas-2010:p1662:b001:l030","ordinal":71544,"en":"Will they not turn us into black donkeys and ride us?"},{"id":"manas-2010:p1662:b001:l031","ordinal":71545,"en":"At the infidels surging like waves,"},{"id":"manas-2010:p1662:b001:l032","ordinal":71546,"en":"Let us fight without stopping."},{"id":"manas-2010:p1662:b001:l033","ordinal":71547,"en":"The many Muslims there,"},{"id":"manas-2010:p1662:b001:l034","ordinal":71548,"en":"Oh heroes, let us rescue them!"},{"id":"manas-2010:p1662:b001:l035","ordinal":71549,"en":"Those left alive among the dead,"},{"id":"manas-2010:p1662:b001:l036","ordinal":71550,"en":"Will the Muslims not escape home?"},{"id":"manas-2010:p1662:b001:l037","ordinal":71551,"en":"‘Manas himself was absent;"},{"id":"manas-2010:p1662:b001:l038","ordinal":71552,"en":"The companions let us be slaughtered,’ they will say."},{"id":"manas-2010:p1662:b001:l039","ordinal":71553,"en":"Will they not spread such slander then?"},{"id":"manas-2010:p1662:b001:l040","ordinal":71554,"en":"Will your people not devour you with gossip?"},{"id":"manas-2010:p1662:b001:l041","ordinal":71555,"en":"‘Their leopard was not here;"},{"id":"manas-2010:p1662:b001:l042","ordinal":71556,"en":"The daughter-divorced forty companions"},{"id":"manas-2010:p1663:b001:l001","ordinal":71557,"en":"Died fleeing,’ will they not say?"},{"id":"manas-2010:p1663:b001:l002","ordinal":71558,"en":"‘All forty came from forty different lands,’ will they not say?"},{"id":"manas-2010:p1663:b001:l003","ordinal":71559,"en":"‘Manas, blessed by Kydyr, was not there;"},{"id":"manas-2010:p1663:b001:l004","ordinal":71560,"en":"The forty companions followed their own whims’—"},{"id":"manas-2010:p1663:b001:l005","ordinal":71561,"en":"Will they not devour us with such words?”"},{"id":"manas-2010:p1663:b001:l006","ordinal":71562,"en":"Almambet, Azizkan's son,"},{"id":"manas-2010:p1663:b001:l007","ordinal":71563,"en":"Surged forward like a lion;"},{"id":"manas-2010:p1663:b001:l008","ordinal":71564,"en":"Khan Manas's forty wolves"},{"id":"manas-2010:p1663:b001:l009","ordinal":71565,"en":"Entered together behind him."},{"id":"manas-2010:p1663:b001:l010","ordinal":71566,"en":"Seven Sufi teachers who came from Mecca,"},{"id":"manas-2010:p1663:b001:l011","ordinal":71567,"en":"They stationed in seven places."},{"id":"manas-2010:p1663:b001:l012","ordinal":71568,"en":"Wherever the fierce champions reached,"},{"id":"manas-2010:p1663:b001:l013","ordinal":71569,"en":"Wherever they reached, they made the Chinese crawl."},{"id":"manas-2010:p1663:b001:l014","ordinal":71570,"en":"They did not count the days,"},{"id":"manas-2010:p1663:b001:l015","ordinal":71571,"en":"They did not take rest each day,"},{"id":"manas-2010:p1663:b001:l016","ordinal":71572,"en":"They did not sleep propped on an elbow,"},{"id":"manas-2010:p1663:b001:l017","ordinal":71573,"en":"They took no peace in even a brief doze,"},{"id":"manas-2010:p1663:b001:l018","ordinal":71574,"en":"They did not rest at all by day."},{"id":"manas-2010:p1663:b001:l019","ordinal":71575,"en":"Almambet, Chubak, the forty companions—"},{"id":"manas-2010:p1663:b001:l020","ordinal":71576,"en":"Heroes, even in death there was no regret."},{"id":"manas-2010:p1663:b001:l021","ordinal":71577,"en":"The warriors shouted, “Islam!”"},{"id":"manas-2010:p1663:b001:l022","ordinal":71578,"en":"Called the battle cry, “Manas!”"},{"id":"manas-2010:p1663:b001:l023","ordinal":71579,"en":"The seething black infidels,"},{"id":"manas-2010:p1663:b001:l024","ordinal":71580,"en":"The dear heroes who entered the campaign,"},{"id":"manas-2010:p1663:b001:l025","ordinal":71581,"en":"Drove back, scattering them."},{"id":"manas-2010:p1663:b001:l026","ordinal":71582,"en":"The hero Khan Kongurbay,"},{"id":"manas-2010:p1663:b001:l027","ordinal":71583,"en":"They drove back, scattering him."},{"id":"manas-2010:p1663:b001:l028","ordinal":71584,"en":"Driving them in utter turmoil,"},{"id":"manas-2010:p1663:b001:l029","ordinal":71585,"en":"Killing whoever they met,"},{"id":"manas-2010:p1663:b001:l030","ordinal":71586,"en":"On the plain of Ötkööldük,"},{"id":"manas-2010:p1663:b001:l031","ordinal":71587,"en":"The Chinese seethed."},{"id":"manas-2010:p1663:b001:l032","ordinal":71588,"en":"Looking at the swarming throng,"},{"id":"manas-2010:p1663:b001:l033","ordinal":71589,"en":"Ajybay, Argyn Khan's son,"},{"id":"manas-2010:p1663:b001:l034","ordinal":71590,"en":"Into the hands of the Kalmyk called Lama,"},{"id":"manas-2010:p1663:b001:l035","ordinal":71591,"en":"Had fallen captive."},{"id":"manas-2010:p1663:b001:l036","ordinal":71592,"en":"Putting a hide torture-cap upon his head,"},{"id":"manas-2010:p1663:b001:l037","ordinal":71593,"en":"Your Ajyke, the Chinese"},{"id":"manas-2010:p1663:b001:l038","ordinal":71594,"en":"Had bound alive."},{"id":"manas-2010:p1663:b001:l039","ordinal":71595,"en":"“Almambet, Chubak, my twin champions,"},{"id":"manas-2010:p1663:b001:l040","ordinal":71596,"en":"When will my twins come?” he said;"},{"id":"manas-2010:p1663:b001:l041","ordinal":71597,"en":"Your Ajyke had lost consciousness."},{"id":"manas-2010:p1663:b001:l042","ordinal":71598,"en":"His eyes darted wildly,"},{"id":"manas-2010:p1664:b001:l001","ordinal":71599,"en":"Your Ajyke's two feet dangled."},{"id":"manas-2010:p1664:b001:l002","ordinal":71600,"en":"Across the saddle-shaped red desert,"},{"id":"manas-2010:p1664:b001:l003","ordinal":71601,"en":"Your Alake rode ahead;"},{"id":"manas-2010:p1664:b001:l004","ordinal":71602,"en":"Of your captured Ajy,"},{"id":"manas-2010:p1664:b001:l005","ordinal":71603,"en":"Your Alake rode nearby."},{"id":"manas-2010:p1664:b001:l006","ordinal":71604,"en":"When he saw your Ajyke,"},{"id":"manas-2010:p1664:b001:l007","ordinal":71605,"en":"Stretching his spear without restraint,"},{"id":"manas-2010:p1664:b001:l008","ordinal":71606,"en":"His back hunched behind him,"},{"id":"manas-2010:p1664:b001:l009","ordinal":71607,"en":"If you looked at his two eyes,"},{"id":"manas-2010:p1664:b001:l010","ordinal":71608,"en":"They bulged outward, staring;"},{"id":"manas-2010:p1664:b001:l011","ordinal":71609,"en":"His spear loomed in his hand."},{"id":"manas-2010:p1664:b001:l012","ordinal":71610,"en":"Chubak, Akbaltay's son,"},{"id":"manas-2010:p1664:b001:l013","ordinal":71611,"en":"Shouted, “Ajybay!”"},{"id":"manas-2010:p1664:b001:l014","ordinal":71612,"en":"He too charged, looming huge."},{"id":"manas-2010:p1664:b001:l015","ordinal":71613,"en":"Your utterly fierce lion Alma,"},{"id":"manas-2010:p1664:b001:l016","ordinal":71614,"en":"The Kalmyk Great Lama,"},{"id":"manas-2010:p1664:b001:l017","ordinal":71615,"en":"Reached him at that very spot."},{"id":"manas-2010:p1664:b001:l018","ordinal":71616,"en":"The painted spear in his hand,"},{"id":"manas-2010:p1664:b001:l019","ordinal":71617,"en":"Your Alake held steady;"},{"id":"manas-2010:p1664:b001:l020","ordinal":71618,"en":"Striking Sarala with his whip,"},{"id":"manas-2010:p1664:b001:l021","ordinal":71619,"en":"He arrived ahead of an arrow:"},{"id":"manas-2010:p1664:b001:l022","ordinal":71620,"en":"“At the edge of the hemp belt,” he said,"},{"id":"manas-2010:p1664:b001:l023","ordinal":71621,"en":"“Upon the right shoulder,” he said."},{"id":"manas-2010:p1664:b001:l024","ordinal":71622,"en":"Holding his spear short,"},{"id":"manas-2010:p1664:b001:l025","ordinal":71623,"en":"Your Alake struck as he passed."},{"id":"manas-2010:p1664:b001:l026","ordinal":71624,"en":"When your Alake struck in passing,"},{"id":"manas-2010:p1664:b001:l027","ordinal":71625,"en":"The Kalmyk Great Lama"},{"id":"manas-2010:p1664:b001:l028","ordinal":71626,"en":"Lost his seat upon the saddle,"},{"id":"manas-2010:p1664:b001:l029","ordinal":71627,"en":"His feet left the stirrups."},{"id":"manas-2010:p1664:b001:l030","ordinal":71628,"en":"His eyes darted wildly,"},{"id":"manas-2010:p1664:b001:l031","ordinal":71629,"en":"His feet dangled;"},{"id":"manas-2010:p1664:b001:l032","ordinal":71630,"en":"Shouting in his panic,"},{"id":"manas-2010:p1664:b001:l033","ordinal":71631,"en":"He cried the battle cry, “Come on!”"},{"id":"manas-2010:p1664:b001:l034","ordinal":71632,"en":"As he ran out of ways to escape,"},{"id":"manas-2010:p1664:b001:l035","ordinal":71633,"en":"Chubak, Akbaltay's son,"},{"id":"manas-2010:p1664:b001:l036","ordinal":71634,"en":"Your devastating Chubak arrived."},{"id":"manas-2010:p1664:b001:l037","ordinal":71635,"en":"Taking Oykuma in hand,"},{"id":"manas-2010:p1664:b001:l038","ordinal":71636,"en":"As he reached Lama,"},{"id":"manas-2010:p1664:b001:l039","ordinal":71637,"en":"Making his blood fall like hail,"},{"id":"manas-2010:p1664:b001:l040","ordinal":71638,"en":"His dear head flew off and fell,"},{"id":"manas-2010:p1664:b001:l041","ordinal":71639,"en":"His blood spilled upon the foothills."},{"id":"manas-2010:p1664:b001:l042","ordinal":71640,"en":"Striking Sarala,"},{"id":"manas-2010:p1665:b001:l001","ordinal":71641,"en":"Turning back toward the Kalmyks,"},{"id":"manas-2010:p1665:b001:l002","ordinal":71642,"en":"Your leopard Alma reached them;"},{"id":"manas-2010:p1665:b001:l003","ordinal":71643,"en":"Throwing them into utter turmoil,"},{"id":"manas-2010:p1665:b001:l004","ordinal":71644,"en":"He drove the Kalmyks before him!"},{"id":"manas-2010:p1665:b001:l005","ordinal":71645,"en":"Almambet, Azizkan's son,"},{"id":"manas-2010:p1665:b001:l006","ordinal":71646,"en":"When he slashed and slashed,"},{"id":"manas-2010:p1665:b001:l007","ordinal":71647,"en":"Twelve died at once."},{"id":"manas-2010:p1665:b001:l008","ordinal":71648,"en":"Your devastating, renowned Alma"},{"id":"manas-2010:p1665:b001:l009","ordinal":71649,"en":"Reached Ajybay."},{"id":"manas-2010:p1665:b001:l010","ordinal":71650,"en":"As he reached your Ajy,"},{"id":"manas-2010:p1665:b001:l011","ordinal":71651,"en":"Slung behind him like a feedbag,"},{"id":"manas-2010:p1665:b001:l012","ordinal":71652,"en":"Your Ajyke, Almambet"},{"id":"manas-2010:p1665:b001:l013","ordinal":71653,"en":"Snatched up and fled past."},{"id":"manas-2010:p1665:b001:l014","ordinal":71654,"en":"Then, with golden forelock, tasseled belt,"},{"id":"manas-2010:p1665:b001:l015","ordinal":71655,"en":"Almambet, Azizkan's son,"},{"id":"manas-2010:p1665:b001:l016","ordinal":71656,"en":"When he saw Kongurbay,"},{"id":"manas-2010:p1665:b001:l017","ordinal":71657,"en":"Sarala beneath him,"},{"id":"manas-2010:p1665:b001:l018","ordinal":71658,"en":"He urged with alternating heels,"},{"id":"manas-2010:p1665:b001:l019","ordinal":71659,"en":"Struck with the whip on either side;"},{"id":"manas-2010:p1665:b001:l020","ordinal":71660,"en":"Your consummate Khan Alma"},{"id":"manas-2010:p1665:b001:l021","ordinal":71661,"en":"Reached Kongurbay ahead of an arrow."},{"id":"manas-2010:p1665:b001:l022","ordinal":71662,"en":"Reaching the grim-faced one,"},{"id":"manas-2010:p1665:b001:l023","ordinal":71663,"en":"From Algara's back,"},{"id":"manas-2010:p1665:b001:l024","ordinal":71664,"en":"He knocked him down as he passed."},{"id":"manas-2010:p1665:b001:l025","ordinal":71665,"en":"His nose bulged like a leather bag;"},{"id":"manas-2010:p1665:b001:l026","ordinal":71666,"en":"From Algara's back,"},{"id":"manas-2010:p1665:b001:l027","ordinal":71667,"en":"Kongurbay flew off,"},{"id":"manas-2010:p1665:b001:l028","ordinal":71668,"en":"Huge as Mount Opol."},{"id":"manas-2010:p1665:b001:l029","ordinal":71669,"en":"I do not know where he came from,"},{"id":"manas-2010:p1665:b001:l030","ordinal":71670,"en":"Chubak, Khan Baltay's son,"},{"id":"manas-2010:p1665:b001:l031","ordinal":71671,"en":"Consummate Chubak, the dear hero—"},{"id":"manas-2010:p1665:b001:l032","ordinal":71672,"en":"As he was reaching Kongurbay,"},{"id":"manas-2010:p1665:b001:l033","ordinal":71673,"en":"About to reach him and cut off his head,"},{"id":"manas-2010:p1665:b001:l034","ordinal":71674,"en":"Then Kongurbay's forty nobles"},{"id":"manas-2010:p1665:b001:l035","ordinal":71675,"en":"Together thrust their spears at Chubak."},{"id":"manas-2010:p1665:b001:l036","ordinal":71676,"en":"The grim-faced one, fallen from his horse,"},{"id":"manas-2010:p1665:b001:l037","ordinal":71677,"en":"They took and mounted on a horse,"},{"id":"manas-2010:p1665:b001:l038","ordinal":71678,"en":"They rescued him."},{"id":"manas-2010:p1665:b001:l039","ordinal":71679,"en":"Sixty sorcerers, a multitude of marksmen,"},{"id":"manas-2010:p1665:b001:l040","ordinal":71680,"en":"Their elder Kojozhash,"}]
