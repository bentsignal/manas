[{"id":"semetey-1-2013:p0610:b004:l026","ordinal":123649,"en":"We used to play our games,"},{"id":"semetey-1-2013:p0610:b004:l027","ordinal":123650,"en":"Used to test our strength."},{"id":"semetey-1-2013:p0610:b004:l028","ordinal":123651,"en":"The firmly rooted birches,"},{"id":"semetey-1-2013:p0610:b004:l029","ordinal":123652,"en":"By their very roots, dear boy,"},{"id":"semetey-1-2013:p0610:b004:l030","ordinal":123653,"en":"We used to pull them out.”"},{"id":"semetey-1-2013:p0610:b004:l031","ordinal":123654,"en":"So saying, mighty Bakai"},{"id":"semetey-1-2013:p0610:b004:l032","ordinal":123655,"en":"The dark rock as large as a small tent"},{"id":"semetey-1-2013:p0610:b004:l033","ordinal":123656,"en":"Wrenched away from the entrance."},{"id":"semetey-1-2013:p0610:b004:l034","ordinal":123657,"en":"“I have no right to enter."},{"id":"semetey-1-2013:p0610:b004:l035","ordinal":123658,"en":"Orphan child, go in."},{"id":"semetey-1-2013:p0610:b004:l036","ordinal":123659,"en":"How Khan Manas lies,"},{"id":"semetey-1-2013:p0610:b004:l037","ordinal":123660,"en":"My orphan, my support, go and see.”"},{"id":"semetey-1-2013:p0610:b004:l038","ordinal":123661,"en":"He sent the boy inside."},{"id":"semetey-1-2013:p0610:b004:l039","ordinal":123662,"en":"The orphan left by Manas"},{"id":"semetey-1-2013:p0611:b003:l001","ordinal":123663,"en":"Wailing as he recited the profession of faith,"},{"id":"semetey-1-2013:p0611:b003:l002","ordinal":123664,"en":"The orphan came and entered."},{"id":"semetey-1-2013:p0611:b003:l003","ordinal":123665,"en":"The fierce-maned mighty conqueror's"},{"id":"semetey-1-2013:p0611:b003:l004","ordinal":123666,"en":"Resting place he now beheld."},{"id":"semetey-1-2013:p0611:b003:l005","ordinal":123667,"en":"The boy stood still, gazing,"},{"id":"semetey-1-2013:p0611:b003:l006","ordinal":123668,"en":"At the inside of that cave"},{"id":"semetey-1-2013:p0611:b003:l007","ordinal":123669,"en":"The orphan boy marveled."},{"id":"semetey-1-2013:p0611:b003:l008","ordinal":123670,"en":"A feat beyond human strength had been performed;"},{"id":"semetey-1-2013:p0611:b003:l009","ordinal":123671,"en":"All its furnishings had been completed."},{"id":"semetey-1-2013:p0611:b003:l010","ordinal":123672,"en":"As he looked, it came into view."},{"id":"semetey-1-2013:p0611:b003:l011","ordinal":123673,"en":"The orphan gazing upon it"},{"id":"semetey-1-2013:p0611:b003:l012","ordinal":123674,"en":"Felt his heart sorely troubled."},{"id":"semetey-1-2013:p0611:b003:l013","ordinal":123675,"en":"The interior was bright and clear,"},{"id":"semetey-1-2013:p0611:b003:l014","ordinal":123676,"en":"Seemed to be lit by the moon."},{"id":"semetey-1-2013:p0611:b003:l015","ordinal":123677,"en":"My poor mother Kanykei"},{"id":"semetey-1-2013:p0611:b003:l016","ordinal":123678,"en":"My khan father's treasury"},{"id":"semetey-1-2013:p0611:b003:l017","ordinal":123679,"en":"Had spent and scattered."},{"id":"semetey-1-2013:p0611:b003:l018","ordinal":123680,"en":"Within that cave"},{"id":"semetey-1-2013:p0611:b003:l019","ordinal":123681,"en":"My valiant mother Kanykei"},{"id":"semetey-1-2013:p0611:b003:l020","ordinal":123682,"en":"Had revealed the likeness of paradise."},{"id":"semetey-1-2013:p0611:b003:l021","ordinal":123683,"en":"She had precious ruby stones cut,"},{"id":"semetey-1-2013:p0611:b003:l022","ordinal":123684,"en":"In the cave's four corners"},{"id":"semetey-1-2013:p0611:b003:l023","ordinal":123685,"en":"Had them set, as large as reclining camels."},{"id":"semetey-1-2013:p0611:b003:l024","ordinal":123686,"en":"She had it encrusted with precious jewels,"},{"id":"semetey-1-2013:p0611:b003:l025","ordinal":123687,"en":"In sections as large as sheep's heads,"},{"id":"semetey-1-2013:p0611:b003:l026","ordinal":123688,"en":"And had them embedded in the ceiling."},{"id":"semetey-1-2013:p0611:b003:l027","ordinal":123689,"en":"The sight stirred the heart."},{"id":"semetey-1-2013:p0611:b003:l028","ordinal":123690,"en":"Bright as daylight,"},{"id":"semetey-1-2013:p0611:b003:l029","ordinal":123691,"en":"The interior appeared clear."},{"id":"semetey-1-2013:p0611:b003:l030","ordinal":123692,"en":"Lest the cave collapse—"},{"id":"semetey-1-2013:p0611:b003:l031","ordinal":123693,"en":"A sight that would dishearten one—"},{"id":"semetey-1-2013:p0611:b003:l032","ordinal":123694,"en":"Four posts in its four corners"},{"id":"semetey-1-2013:p0611:b003:l033","ordinal":123695,"en":"She had shaped from solid gold,"},{"id":"semetey-1-2013:p0611:b003:l034","ordinal":123696,"en":"And had them installed as pillars."},{"id":"semetey-1-2013:p0611:b003:l035","ordinal":123697,"en":"Lest the inside grow foul,"},{"id":"semetey-1-2013:p0611:b003:l036","ordinal":123698,"en":"She displayed her resourcefulness."},{"id":"semetey-1-2013:p0611:b003:l037","ordinal":123699,"en":"Having a channel broken with iron crowbars,"},{"id":"semetey-1-2013:p0611:b003:l038","ordinal":123700,"en":"The flowing spring water"},{"id":"semetey-1-2013:p0611:b003:l039","ordinal":123701,"en":"Through that very cave"},{"id":"semetey-1-2013:p0611:b005:l001","ordinal":123702,"en":"She had made to run."},{"id":"semetey-1-2013:p0611:b005:l002","ordinal":123703,"en":"Satisfying the eye that beheld it,"},{"id":"semetey-1-2013:p0611:b005:l003","ordinal":123704,"en":"Various precious ruby stones"},{"id":"semetey-1-2013:p0611:b005:l004","ordinal":123705,"en":"She had set in different places."},{"id":"semetey-1-2013:p0611:b005:l005","ordinal":123706,"en":"Farther in was another wonder,"},{"id":"semetey-1-2013:p0611:b005:l006","ordinal":123707,"en":"Satisfying the heart that beheld it:"},{"id":"semetey-1-2013:p0611:b005:l007","ordinal":123708,"en":"A bed made of gold."},{"id":"semetey-1-2013:p0611:b005:l008","ordinal":123709,"en":"Her service knew no bounds."},{"id":"semetey-1-2013:p0611:b005:l009","ordinal":123710,"en":"She had it placed toward the north."},{"id":"semetey-1-2013:p0611:b005:l010","ordinal":123711,"en":"Levying tribute from the Kyrgyz,"},{"id":"semetey-1-2013:p0611:b005:l011","ordinal":123712,"en":"She had juniper ash brought."},{"id":"semetey-1-2013:p0611:b005:l012","ordinal":123713,"en":"Lest the underside decay,"},{"id":"semetey-1-2013:p0611:b005:l013","ordinal":123714,"en":"My noble mother Kanykei"},{"id":"semetey-1-2013:p0611:b005:l014","ordinal":123715,"en":"Had a layer of it spread beneath."},{"id":"semetey-1-2013:p0611:b005:l015","ordinal":123716,"en":"No open mind left,"},{"id":"semetey-1-2013:p0611:b005:l016","ordinal":123717,"en":"My poor father Manas"},{"id":"semetey-1-2013:p0611:b005:l017","ordinal":123718,"en":"She wrapped in a fine white cloth shroud."},{"id":"semetey-1-2013:p0611:b005:l018","ordinal":123719,"en":"She had a reed screen drawn on this side."},{"id":"semetey-1-2013:p0611:b005:l019","ordinal":123720,"en":"An undyed robe of the kind an ishan wears,"},{"id":"semetey-1-2013:p0611:b005:l020","ordinal":123721,"en":"My incomparable mother Kanykei"},{"id":"semetey-1-2013:p0611:b005:l021","ordinal":123722,"en":"Had laid across him."},{"id":"semetey-1-2013:p0611:b005:l022","ordinal":123723,"en":"He rested his head upon the holy Qur'an."},{"id":"semetey-1-2013:p0611:b005:l023","ordinal":123724,"en":"My khan father's white face,"},{"id":"semetey-1-2013:p0611:b005:l024","ordinal":123725,"en":"His head she turned toward the north."},{"id":"semetey-1-2013:p0611:b005:l025","ordinal":123726,"en":"She had accomplished her service well."},{"id":"semetey-1-2013:p0611:b005:l026","ordinal":123727,"en":"My dear father's white face"},{"id":"semetey-1-2013:p0611:b005:l027","ordinal":123728,"en":"She turned toward the qibla."},{"id":"semetey-1-2013:p0611:b005:l028","ordinal":123729,"en":"Seeing it, his heart was torn."},{"id":"semetey-1-2013:p0611:b005:l029","ordinal":123730,"en":"Crying, “Father!” the orphan's"},{"id":"semetey-1-2013:p0611:b005:l030","ordinal":123731,"en":"Tears poured from his eyes."},{"id":"semetey-1-2013:p0611:b005:l031","ordinal":123732,"en":"His dear, saker-like eyes"},{"id":"semetey-1-2013:p0611:b005:l032","ordinal":123733,"en":"Shed tears with every blink."},{"id":"semetey-1-2013:p0611:b005:l033","ordinal":123734,"en":"His dear eyes like the morning star"},{"id":"semetey-1-2013:p0611:b005:l034","ordinal":123735,"en":"Shed tears together."},{"id":"semetey-1-2013:p0611:b005:l035","ordinal":123736,"en":"Semetey wept with ringing cries,"},{"id":"semetey-1-2013:p0611:b005:l036","ordinal":123737,"en":"And began to lament Manas:"},{"id":"semetey-1-2013:p0611:b005:l037","ordinal":123738,"en":"“Magnanimous Manas, my lion father!"},{"id":"semetey-1-2013:p0611:b005:l038","ordinal":123739,"en":"Your orphan wandered lost,"},{"id":"semetey-1-2013:p0611:b005:l039","ordinal":123740,"en":"And here I have seen your remains."},{"id":"semetey-1-2013:p0612:b003:l001","ordinal":123741,"en":"Your remains lie here, but your soul is gone."},{"id":"semetey-1-2013:p0612:b003:l002","ordinal":123742,"en":"Your form remains, but your blood is gone."},{"id":"semetey-1-2013:p0612:b003:l003","ordinal":123743,"en":"Your valor is absent from your form."},{"id":"semetey-1-2013:p0612:b003:l004","ordinal":123744,"en":"My father who would rise with a roar,"},{"id":"semetey-1-2013:p0612:b003:l005","ordinal":123745,"en":"My sovereign, is gone as well."},{"id":"semetey-1-2013:p0612:b003:l006","ordinal":123746,"en":"Your bed is like a fortress."},{"id":"semetey-1-2013:p0612:b003:l007","ordinal":123747,"en":"To Temir Khan's city"},{"id":"semetey-1-2013:p0612:b003:l008","ordinal":123748,"en":"Your orphan wandered and lived."},{"id":"semetey-1-2013:p0612:b003:l009","ordinal":123749,"en":"He has come before you."},{"id":"semetey-1-2013:p0612:b003:l010","ordinal":123750,"en":"My ocean-like father, wake up!"},{"id":"semetey-1-2013:p0612:b003:l011","ordinal":123751,"en":"The meeting of two rivers—"},{"id":"semetey-1-2013:p0612:b003:l012","ordinal":123752,"en":"My khan father, like their rushing current!"},{"id":"semetey-1-2013:p0612:b003:l013","ordinal":123753,"en":"The meeting of two mountains—"},{"id":"semetey-1-2013:p0612:b003:l014","ordinal":123754,"en":"My khan father, like their great ridge!"},{"id":"semetey-1-2013:p0612:b003:l015","ordinal":123755,"en":"With the moon overhead and the sun rising,"},{"id":"semetey-1-2013:p0612:b003:l016","ordinal":123756,"en":"I could not be your guiding sign."},{"id":"semetey-1-2013:p0612:b003:l017","ordinal":123757,"en":"For my dear father, this poor soul"},{"id":"semetey-1-2013:p0612:b003:l018","ordinal":123758,"en":"Could not remain a companion."},{"id":"semetey-1-2013:p0612:b003:l019","ordinal":123759,"en":"I never beheld you while you lived."},{"id":"semetey-1-2013:p0612:b003:l020","ordinal":123760,"en":"Until I reached twelve,"},{"id":"semetey-1-2013:p0612:b003:l021","ordinal":123761,"en":"Why could you not live, my formidable father?”"},{"id":"semetey-1-2013:p0612:b003:l022","ordinal":123762,"en":"Reciting the profession of faith, he sobbed,"},{"id":"semetey-1-2013:p0612:b003:l023","ordinal":123763,"en":"Weeping in sorrow, shaking with grief."},{"id":"semetey-1-2013:p0612:b003:l024","ordinal":123764,"en":"“The four corners of the round world,"},{"id":"semetey-1-2013:p0612:b003:l025","ordinal":123765,"en":"I did not gather from all four sides,"},{"id":"semetey-1-2013:p0612:b003:l026","ordinal":123766,"en":"Saying, ‘My lord father died today.’"},{"id":"semetey-1-2013:p0612:b003:l027","ordinal":123767,"en":"I did not serve at your bedside."},{"id":"semetey-1-2013:p0612:b003:l028","ordinal":123768,"en":"I lament to God."},{"id":"semetey-1-2013:p0612:b003:l029","ordinal":123769,"en":"Your resting place is like a rocky fortress."},{"id":"semetey-1-2013:p0612:b003:l030","ordinal":123770,"en":"Your only son has come before you."},{"id":"semetey-1-2013:p0612:b003:l031","ordinal":123771,"en":"My blessed father, wake up!"},{"id":"semetey-1-2013:p0612:b003:l032","ordinal":123772,"en":"Brushing across one's face,"},{"id":"semetey-1-2013:p0612:b003:l033","ordinal":123773,"en":"Is there anything as wretched as the wind?"},{"id":"semetey-1-2013:p0612:b003:l034","ordinal":123774,"en":"Left an orphan by his father,"},{"id":"semetey-1-2013:p0612:b003:l035","ordinal":123775,"en":"Is there anyone as wretched as I?"},{"id":"semetey-1-2013:p0612:b003:l036","ordinal":123776,"en":"The only son of a prince—"},{"id":"semetey-1-2013:p0612:b003:l037","ordinal":123777,"en":"Should he live in hardship?"},{"id":"semetey-1-2013:p0612:b003:l038","ordinal":123778,"en":"Saying, ‘My support has come,’"},{"id":"semetey-1-2013:p0612:b003:l039","ordinal":123779,"en":"My cherished khan father,"},{"id":"semetey-1-2013:p0612:b004:l001","ordinal":123780,"en":"Will there be a day when you rise again?"},{"id":"semetey-1-2013:p0612:b004:l002","ordinal":123781,"en":"The only son of a nobleman—"},{"id":"semetey-1-2013:p0612:b004:l003","ordinal":123782,"en":"Should he wander away?"},{"id":"semetey-1-2013:p0612:b004:l004","ordinal":123783,"en":"Saying, ‘My valiant son has come,’"},{"id":"semetey-1-2013:p0612:b004:l005","ordinal":123784,"en":"My father lying there,"},{"id":"semetey-1-2013:p0612:b004:l006","ordinal":123785,"en":"Will there be a day when you rise again?"},{"id":"semetey-1-2013:p0612:b004:l007","ordinal":123786,"en":"To Kara Khan's city,"},{"id":"semetey-1-2013:p0612:b004:l008","ordinal":123787,"en":"Khan father, I fled in disgrace."},{"id":"semetey-1-2013:p0612:b004:l009","ordinal":123788,"en":"My blood boiled, my heart burned,"},{"id":"semetey-1-2013:p0612:b004:l010","ordinal":123789,"en":"My leopard father, take me with you!"},{"id":"semetey-1-2013:p0612:b004:l011","ordinal":123790,"en":"To Temir Khan's city"},{"id":"semetey-1-2013:p0612:b004:l012","ordinal":123791,"en":"I wandered in disgrace."},{"id":"semetey-1-2013:p0612:b004:l013","ordinal":123792,"en":"My ocean-like father, take me with you!”"},{"id":"semetey-1-2013:p0612:b004:l014","ordinal":123793,"en":"So said Semetey."},{"id":"semetey-1-2013:p0612:b004:l015","ordinal":123794,"en":"In the walled city of Bukhara"},{"id":"semetey-1-2013:p0612:b004:l016","ordinal":123795,"en":"That warrior had studied his lessons."},{"id":"semetey-1-2013:p0612:b004:l017","ordinal":123796,"en":"Sitting down, he recited the Qur'an from memory."},{"id":"semetey-1-2013:p0612:b004:l018","ordinal":123797,"en":"The surah called Ya-Sin"},{"id":"semetey-1-2013:p0612:b004:l019","ordinal":123798,"en":"He read with astonishing speed."},{"id":"semetey-1-2013:p0612:b004:l020","ordinal":123799,"en":"“Amen!” he said, spreading his hands."},{"id":"semetey-1-2013:p0612:b004:l021","ordinal":123800,"en":"For the lion warriors gone to the next world,"},{"id":"semetey-1-2013:p0612:b004:l022","ordinal":123801,"en":"He spread his hands wide for their spirits."},{"id":"semetey-1-2013:p0612:b004:l023","ordinal":123802,"en":"The orphan sobbed and wept bitterly."},{"id":"semetey-1-2013:p0612:b004:l024","ordinal":123803,"en":"For the lion warriors whose protectors live,"},{"id":"semetey-1-2013:p0612:b004:l025","ordinal":123804,"en":"He grieved for their spirits."},{"id":"semetey-1-2013:p0612:b004:l026","ordinal":123805,"en":"Then your hero gathered courage,"},{"id":"semetey-1-2013:p0612:b004:l027","ordinal":123806,"en":"Your valiant son of bloodthirsty Manas."},{"id":"semetey-1-2013:p0612:b004:l028","ordinal":123807,"en":"“If I grieve and wail relentlessly,"},{"id":"semetey-1-2013:p0612:b004:l029","ordinal":123808,"en":"This mouth of mine will never close."},{"id":"semetey-1-2013:p0612:b004:l030","ordinal":123809,"en":"If I lament five days running,"},{"id":"semetey-1-2013:p0612:b004:l031","ordinal":123810,"en":"My valiant father will not be found."},{"id":"semetey-1-2013:p0612:b004:l032","ordinal":123811,"en":"Let me not grieve without end."},{"id":"semetey-1-2013:p0612:b004:l033","ordinal":123812,"en":"Such is this shitty world.”"},{"id":"semetey-1-2013:p0612:b004:l034","ordinal":123813,"en":"Brave Semen, born of Manas,"},{"id":"semetey-1-2013:p0612:b004:l035","ordinal":123814,"en":"The warrior protected by Shai,"},{"id":"semetey-1-2013:p0612:b004:l036","ordinal":123815,"en":"His dear eyes like currants,"},{"id":"semetey-1-2013:p0612:b004:l037","ordinal":123816,"en":"Turned and wiped them now."},{"id":"semetey-1-2013:p0612:b004:l038","ordinal":123817,"en":"At the place where his father lay"},{"id":"semetey-1-2013:p0612:b004:l039","ordinal":123818,"en":"He fixed his gaze closely."},{"id":"semetey-1-2013:p0613:b003:l001","ordinal":123819,"en":"Ah, my valiant mother Kanykei,"},{"id":"semetey-1-2013:p0613:b003:l002","ordinal":123820,"en":"When my valiant father died,"},{"id":"semetey-1-2013:p0613:b003:l003","ordinal":123821,"en":"When your sister-in-law met disaster,"},{"id":"semetey-1-2013:p0613:b003:l004","ordinal":123822,"en":"Performed still greater feats of courage,"},{"id":"semetey-1-2013:p0613:b003:l005","ordinal":123823,"en":"Planned her valor with firm resolve."},{"id":"semetey-1-2013:p0613:b003:l006","ordinal":123824,"en":"She had drawn her line."},{"id":"semetey-1-2013:p0613:b003:l007","ordinal":123825,"en":"My noble mother Kanykei"},{"id":"semetey-1-2013:p0613:b003:l008","ordinal":123826,"en":"Had worked wonders,"},{"id":"semetey-1-2013:p0613:b003:l009","ordinal":123827,"en":"And had brought upon Talas"},{"id":"semetey-1-2013:p0613:b003:l010","ordinal":123828,"en":"A turmoil no person had seen."},{"id":"semetey-1-2013:p0613:b003:l011","ordinal":123829,"en":"Surpassing everyone in wisdom,"},{"id":"semetey-1-2013:p0613:b003:l012","ordinal":123830,"en":"My fierce-maned lion father"},{"id":"semetey-1-2013:p0613:b003:l013","ordinal":123831,"en":"She hid in this cave."},{"id":"semetey-1-2013:p0613:b003:l014","ordinal":123832,"en":"She made herself a warrior though a woman,"},{"id":"semetey-1-2013:p0613:b003:l015","ordinal":123833,"en":"Made her mourning self a banner."},{"id":"semetey-1-2013:p0613:b003:l016","ordinal":123834,"en":"Her precious long, thick hair"},{"id":"semetey-1-2013:p0613:b003:l017","ordinal":123835,"en":"She combed into twelve divisions."},{"id":"semetey-1-2013:p0613:b003:l018","ordinal":123836,"en":"Lest my father be left exposed,"},{"id":"semetey-1-2013:p0613:b003:l019","ordinal":123837,"en":"My precious, ill-fated mother"},{"id":"semetey-1-2013:p0613:b003:l020","ordinal":123838,"en":"Suspected treachery from everyone."},{"id":"semetey-1-2013:p0613:b003:l021","ordinal":123839,"en":"She rebuked the servants."},{"id":"semetey-1-2013:p0613:b003:l022","ordinal":123840,"en":"My father gone to Judgment Day,"},{"id":"semetey-1-2013:p0613:b003:l023","ordinal":123841,"en":"My valiant, ill-fated mother"},{"id":"semetey-1-2013:p0613:b003:l024","ordinal":123842,"en":"Hid away from all mankind."},{"id":"semetey-1-2013:p0613:b003:l025","ordinal":123843,"en":"At the renowned mausoleum,"},{"id":"semetey-1-2013:p0613:b003:l026","ordinal":123844,"en":"She had the ground hollowed with mattocks."},{"id":"semetey-1-2013:p0613:b003:l027","ordinal":123845,"en":"The poplar Bakai had cut—"},{"id":"semetey-1-2013:p0613:b003:l028","ordinal":123846,"en":"‘This is your kingly elder brother,’ she said,"},{"id":"semetey-1-2013:p0613:b003:l029","ordinal":123847,"en":"And had the six wicked ones bury it."},{"id":"semetey-1-2013:p0613:b003:l030","ordinal":123848,"en":"My poor, wretched mother"},{"id":"semetey-1-2013:p0613:b003:l031","ordinal":123849,"en":"Cannot be called a mere woman."},{"id":"semetey-1-2013:p0613:b003:l032","ordinal":123850,"en":"Whoever calls my mother a mere woman"},{"id":"semetey-1-2013:p0613:b003:l033","ordinal":123851,"en":"Will never prosper."},{"id":"semetey-1-2013:p0613:b003:l034","ordinal":123852,"en":"What is seen today is gone tomorrow."},{"id":"semetey-1-2013:p0613:b003:l035","ordinal":123853,"en":"Such is this shitty world."},{"id":"semetey-1-2013:p0613:b003:l036","ordinal":123854,"en":"My father who married my mother"},{"id":"semetey-1-2013:p0613:b003:l037","ordinal":123855,"en":"Had not the smallest cause for regret."},{"id":"semetey-1-2013:p0613:b003:l038","ordinal":123856,"en":"My poor, valiant mother"},{"id":"semetey-1-2013:p0613:b003:l039","ordinal":123857,"en":"Had prepared every sign,"},{"id":"semetey-1-2013:p0613:b004:l001","ordinal":123858,"en":"‘Let the father's son"},{"id":"semetey-1-2013:p0613:b004:l002","ordinal":123859,"en":"Come and see his remains,’ she said,"},{"id":"semetey-1-2013:p0613:b004:l003","ordinal":123860,"en":"And left it as a trust."},{"id":"semetey-1-2013:p0613:b004:l004","ordinal":123861,"en":"My mother knew better than all."},{"id":"semetey-1-2013:p0613:b004:l005","ordinal":123862,"en":"Ah, my cherished, revered mother,"},{"id":"semetey-1-2013:p0613:b004:l006","ordinal":123863,"en":"Along the foot of six cliffs,"},{"id":"semetey-1-2013:p0613:b004:l007","ordinal":123864,"en":"Weeping in exhaustion, walking on foot,"},{"id":"semetey-1-2013:p0613:b004:l008","ordinal":123865,"en":"And hurrying desperately,"},{"id":"semetey-1-2013:p0613:b004:l009","ordinal":123866,"en":"For me, left behind,"},{"id":"semetey-1-2013:p0613:b004:l010","ordinal":123867,"en":"All her treasures and possessions—"},{"id":"semetey-1-2013:p0613:b004:l011","ordinal":123868,"en":"It was right that she scattered them."},{"id":"semetey-1-2013:p0613:b004:l012","ordinal":123869,"en":"To her own kin, in this way,"},{"id":"semetey-1-2013:p0613:b004:l013","ordinal":123870,"en":"It was right that she fled!"},{"id":"semetey-1-2013:p0613:b004:l014","ordinal":123871,"en":"My valiant mother Kanykei,"},{"id":"semetey-1-2013:p0613:b004:l015","ordinal":123872,"en":"‘Let his renowned only son see,’ she said,"},{"id":"semetey-1-2013:p0613:b004:l016","ordinal":123873,"en":"And undertook such toil."},{"id":"semetey-1-2013:p0613:b004:l017","ordinal":123874,"en":"My dear father's cave,"},{"id":"semetey-1-2013:p0613:b004:l018","ordinal":123875,"en":"Ah, my poor mother"},{"id":"semetey-1-2013:p0613:b004:l019","ordinal":123876,"en":"Had made into a paradise."},{"id":"semetey-1-2013:p0613:b004:l020","ordinal":123877,"en":"She hollowed the cave and dug a resting place,"},{"id":"semetey-1-2013:p0613:b004:l021","ordinal":123878,"en":"Dug it with every feature ready."},{"id":"semetey-1-2013:p0613:b004:l022","ordinal":123879,"en":"She had its entrance prepared and cut,"},{"id":"semetey-1-2013:p0613:b004:l023","ordinal":123880,"en":"Large enough for one person to fit."},{"id":"semetey-1-2013:p0613:b004:l024","ordinal":123881,"en":"She had the farther part excavated,"},{"id":"semetey-1-2013:p0613:b004:l025","ordinal":123882,"en":"My golden mother Kanykei,"},{"id":"semetey-1-2013:p0613:b004:l026","ordinal":123883,"en":"Large enough for six thousand sheep to lie down."},{"id":"semetey-1-2013:p0613:b004:l027","ordinal":123884,"en":"If there were urgent need, inside it"},{"id":"semetey-1-2013:p0613:b004:l028","ordinal":123885,"en":"Forty thousand people could fit."},{"id":"semetey-1-2013:p0613:b004:l029","ordinal":123886,"en":"If they were at ease, without haste,"},{"id":"semetey-1-2013:p0613:b004:l030","ordinal":123887,"en":"A thousand people led by Bakai"},{"id":"semetey-1-2013:p0613:b004:l031","ordinal":123888,"en":"Inside this cave"},{"id":"semetey-1-2013:p0613:b004:l032","ordinal":123889,"en":"Could play at hopping on one leg."},{"id":"semetey-1-2013:p0613:b004:l033","ordinal":123890,"en":"Into this cave"},{"id":"semetey-1-2013:p0613:b004:l034","ordinal":123891,"en":"My renowned lion father had entered."},{"id":"semetey-1-2013:p0613:b004:l035","ordinal":123892,"en":"When they were to lay my father there,"},{"id":"semetey-1-2013:p0613:b004:l036","ordinal":123893,"en":"To see the wonders of the place,"},{"id":"semetey-1-2013:p0613:b004:l037","ordinal":123894,"en":"Koshoi and brave Toshtuk entered,"},{"id":"semetey-1-2013:p0613:b004:l038","ordinal":123895,"en":"Forty ishans and Aikozho,"},{"id":"semetey-1-2013:p0613:b004:l039","ordinal":123896,"en":"Ak Eshen and mighty Bakai:"},{"id":"semetey-1-2013:p0614:b003:l001","ordinal":123897,"en":"Maiden Saikal and Kokboru"},{"id":"semetey-1-2013:p0614:b003:l002","ordinal":123898,"en":"Entered together to bid farewell."},{"id":"semetey-1-2013:p0614:b003:l003","ordinal":123899,"en":"A cool breeze blew inside."},{"id":"semetey-1-2013:p0614:b003:l004","ordinal":123900,"en":"When all the giants entered,"},{"id":"semetey-1-2013:p0614:b003:l005","ordinal":123901,"en":"Of this place where my father lay"},{"id":"semetey-1-2013:p0614:b003:l006","ordinal":123902,"en":"They did not fill even one corner."},{"id":"semetey-1-2013:p0614:b003:l007","ordinal":123903,"en":"Her deeds showed Kydyr's blessing."},{"id":"semetey-1-2013:p0614:b003:l008","ordinal":123904,"en":"To my poor, fierce mother"}]
