[{"id":"seytek-2012:p0992:b003:l033","ordinal":371969,"en":"Look at your hard work"},{"id":"seytek-2012:p0992:b003:l034","ordinal":371970,"en":"You did it to yourself."},{"id":"seytek-2012:p0992:b003:l035","ordinal":371971,"en":"Keep your mouth shut,"},{"id":"seytek-2012:p0992:b003:l036","ordinal":371972,"en":"Swallow when you die"},{"id":"seytek-2012:p0992:b003:l037","ordinal":371973,"en":"You are bored,"},{"id":"seytek-2012:p0992:b003:l038","ordinal":371974,"en":"Being bored,"},{"id":"seytek-2012:p0992:b003:l039","ordinal":371975,"en":"Did you kid yourself?"},{"id":"seytek-2012:p0992:b003:l040","ordinal":371976,"en":"Going to be angry,"},{"id":"seytek-2012:p0993:b002:l001","ordinal":371977,"en":"You went to your beloved, you say—"},{"id":"seytek-2012:p0993:b002:l002","ordinal":371978,"en":"With your imperious battle cry,"},{"id":"seytek-2012:p0993:b002:l003","ordinal":371979,"en":"I will snuff you out like a dying fire,"},{"id":"seytek-2012:p0993:b002:l004","ordinal":371980,"en":"Leaving not a single root,"},{"id":"seytek-2012:p0993:b002:l005","ordinal":371981,"en":"I will tear you out root and all,"},{"id":"seytek-2012:p0993:b002:l006","ordinal":371982,"en":"And bury you before you sprout."},{"id":"seytek-2012:p0993:b002:l007","ordinal":371983,"en":"If you rave, you madman,"},{"id":"seytek-2012:p0993:b002:l008","ordinal":371984,"en":"I will break your ribs."},{"id":"seytek-2012:p0993:b002:l009","ordinal":371985,"en":"If you wriggle without cause,"},{"id":"seytek-2012:p0993:b002:l010","ordinal":371986,"en":"I will spill your blood like water."},{"id":"seytek-2012:p0993:b002:l011","ordinal":371987,"en":"Whatever the hour may bring,"},{"id":"seytek-2012:p0993:b002:l012","ordinal":371988,"en":"You never cease your defiance."},{"id":"seytek-2012:p0993:b002:l013","ordinal":371989,"en":"You fawning madman,"},{"id":"seytek-2012:p0993:b002:l014","ordinal":371990,"en":"You shameless swaggerer,"},{"id":"seytek-2012:p0993:b002:l015","ordinal":371991,"en":"Straining upon the spearpoint,"},{"id":"seytek-2012:p0993:b002:l016","ordinal":371992,"en":"You bristled in fury."},{"id":"seytek-2012:p0993:b002:l017","ordinal":371993,"en":"I will bring your death upon you,"},{"id":"seytek-2012:p0993:b002:l018","ordinal":371994,"en":"Extinguish your burning soul,"},{"id":"seytek-2012:p0993:b002:l019","ordinal":371995,"en":"And send you from this world."},{"id":"seytek-2012:p0993:b002:l020","ordinal":371996,"en":"I will strike you down in battle,"},{"id":"seytek-2012:p0993:b002:l021","ordinal":371997,"en":"And settle the true account"},{"id":"seytek-2012:p0993:b002:l022","ordinal":371998,"en":"Of this crackling fool."},{"id":"seytek-2012:p0993:b002:l023","ordinal":371999,"en":"You dog of a wolf, Sarybai,"},{"id":"seytek-2012:p0993:b002:l024","ordinal":372000,"en":"Even a dog is far above you;"},{"id":"seytek-2012:p0993:b002:l025","ordinal":372001,"en":"Even a dog answers when called."},{"id":"seytek-2012:p0993:b002:l026","ordinal":372002,"en":"You are a bird, Sarybai,"},{"id":"seytek-2012:p0993:b002:l027","ordinal":372003,"en":"Even a bird is far above you;"},{"id":"seytek-2012:p0993:b002:l028","ordinal":372004,"en":"Even a bird answers a whistle."},{"id":"seytek-2012:p0993:b002:l029","ordinal":372005,"en":"You heed no spoken word,"},{"id":"seytek-2012:p0993:b002:l030","ordinal":372006,"en":"Nor do you go against distant foes."},{"id":"seytek-2012:p0993:b002:l031","ordinal":372007,"en":"Brisling in fury,"},{"id":"seytek-2012:p0993:b002:l032","ordinal":372008,"en":"You never cease your defiance!”"},{"id":"seytek-2012:p0993:b002:l033","ordinal":372009,"en":"So saying, Kuyaly"},{"id":"seytek-2012:p0993:b002:l034","ordinal":372010,"en":"Gripped the tempered spear in her hand"},{"id":"seytek-2012:p0993:b002:l035","ordinal":372011,"en":"And Sarybai upon its point"},{"id":"seytek-2012:p0993:b002:l036","ordinal":372012,"en":"She shook and violently flung."},{"id":"seytek-2012:p0993:b002:l037","ordinal":372013,"en":"Your sin is upon your own head,"},{"id":"seytek-2012:p0993:b002:l038","ordinal":372014,"en":"Your deeds fall upon your dark crown."},{"id":"seytek-2012:p0993:b002:l039","ordinal":372015,"en":"The bare-shafted tempered spear"},{"id":"seytek-2012:p0993:b002:l040","ordinal":372016,"en":"She clutched firmly,"},{"id":"seytek-2012:p0993:b004:l001","ordinal":372017,"en":"While Sarybai hung above"},{"id":"seytek-2012:p0993:b004:l002","ordinal":372018,"en":"And she swung him to and fro."},{"id":"seytek-2012:p0993:b004:l003","ordinal":372019,"en":"Thus Sarybai"},{"id":"seytek-2012:p0993:b004:l004","ordinal":372020,"en":"Was split in two upon the spear"},{"id":"seytek-2012:p0993:b004:l005","ordinal":372021,"en":"And despaired of his wretched life."},{"id":"seytek-2012:p0993:b004:l006","ordinal":372022,"en":"He lost all warrior courage;"},{"id":"seytek-2012:p0993:b004:l007","ordinal":372023,"en":"His shattered body was hurled,"},{"id":"seytek-2012:p0993:b004:l008","ordinal":372024,"en":"His backbone split in two,"},{"id":"seytek-2012:p0993:b004:l009","ordinal":372025,"en":"And jutting from the other side"},{"id":"seytek-2012:p0993:b004:l010","ordinal":372026,"en":"The tempered spearpoint appeared."},{"id":"seytek-2012:p0993:b004:l011","ordinal":372027,"en":"Kuyaly was truly adroit;"},{"id":"seytek-2012:p0993:b004:l012","ordinal":372028,"en":"She readied the tempered spear,"},{"id":"seytek-2012:p0993:b004:l013","ordinal":372029,"en":"Rent wide his dark liver,"},{"id":"seytek-2012:p0993:b004:l014","ordinal":372030,"en":"And split his heart in two."},{"id":"seytek-2012:p0993:b004:l015","ordinal":372031,"en":"His liver was sliced like cheese,"},{"id":"seytek-2012:p0993:b004:l016","ordinal":372032,"en":"And the cur knew death had come."},{"id":"seytek-2012:p0993:b004:l017","ordinal":372033,"en":"His courage fled, his strength was gone,"},{"id":"seytek-2012:p0993:b004:l018","ordinal":372034,"en":"And Sarybai’s blood poured out."},{"id":"seytek-2012:p0993:b004:l019","ordinal":372035,"en":"His life departed with his strength;"},{"id":"seytek-2012:p0993:b004:l020","ordinal":372036,"en":"She stretched him upon the spearpoint,"},{"id":"seytek-2012:p0993:b004:l021","ordinal":372037,"en":"Overturned him and cast him down,"},{"id":"seytek-2012:p0993:b004:l022","ordinal":372038,"en":"And to the true abode whence none return"},{"id":"seytek-2012:p0993:b004:l023","ordinal":372039,"en":"Sarybai had gone."},{"id":"seytek-2012:p0993:b004:l024","ordinal":372040,"en":"At the hands of the maiden wrestler"},{"id":"seytek-2012:p0993:b004:l025","ordinal":372041,"en":"The swine’s appointed death"},{"id":"seytek-2012:p0993:b004:l026","ordinal":372042,"en":"Had come in just this way."},{"id":"seytek-2012:p0993:b004:l027","ordinal":372043,"en":"Sarybai lay dead,"},{"id":"seytek-2012:p0993:b004:l028","ordinal":372044,"en":"Yet seemed as though the dead man"},{"id":"seytek-2012:p0993:b004:l029","ordinal":372045,"en":"Might revive and rise again."},{"id":"seytek-2012:p0993:b004:l030","ordinal":372046,"en":"They had clashed with thunderous blows,"},{"id":"seytek-2012:p0993:b004:l031","ordinal":372047,"en":"As though to begin the fight anew."},{"id":"seytek-2012:p0993:b004:l032","ordinal":372048,"en":"It seemed the departed man"},{"id":"seytek-2012:p0993:b004:l033","ordinal":372049,"en":"Might revive and rise again."},{"id":"seytek-2012:p0993:b004:l034","ordinal":372050,"en":"As Sarybai lay dead,"},{"id":"seytek-2012:p0993:b004:l035","ordinal":372051,"en":"Drenched in crimson blood,"},{"id":"seytek-2012:p0993:b004:l036","ordinal":372052,"en":"They advanced in their turn"},{"id":"seytek-2012:p0993:b004:l037","ordinal":372053,"en":"And plundered all his wealth."},{"id":"seytek-2012:p0993:b004:l038","ordinal":372054,"en":"His gold and possessions"},{"id":"seytek-2012:p0993:b004:l039","ordinal":372055,"en":"The teeming people seized as spoil,"},{"id":"seytek-2012:p0993:b004:l040","ordinal":372056,"en":"Precious jewels of red gold—"},{"id":"seytek-2012:p0994:b002:l001","ordinal":372057,"en":"The grateful people seized them all,"},{"id":"seytek-2012:p0994:b002:l002","ordinal":372058,"en":"Until they lay in heaps like burial mounds."},{"id":"seytek-2012:p0994:b002:l003","ordinal":372059,"en":"Kuyaly’s vengeance was not sated;"},{"id":"seytek-2012:p0994:b002:l004","ordinal":372060,"en":"She too was a surpassing gray wolf."},{"id":"seytek-2012:p0994:b002:l005","ordinal":372061,"en":"Kuyaly performed a fearsome deed"},{"id":"seytek-2012:p0994:b002:l006","ordinal":372062,"en":"And issued her command."},{"id":"seytek-2012:p0994:b002:l007","ordinal":372063,"en":"The thousand wrestlers under her"},{"id":"seytek-2012:p0994:b002:l008","ordinal":372064,"en":"She now assembled."},{"id":"seytek-2012:p0994:b002:l009","ordinal":372065,"en":"She marched them back and forth,"},{"id":"seytek-2012:p0994:b002:l010","ordinal":372066,"en":"Then formed them into a long column."},{"id":"seytek-2012:p0994:b002:l011","ordinal":372067,"en":"From the countless wrestlers"},{"id":"seytek-2012:p0994:b002:l012","ordinal":372068,"en":"Kuyaly selected one,"},{"id":"seytek-2012:p0994:b002:l013","ordinal":372069,"en":"From the thousand wrestlers"},{"id":"seytek-2012:p0994:b002:l014","ordinal":372070,"en":"Kuyaly brought forth another."},{"id":"seytek-2012:p0994:b002:l015","ordinal":372071,"en":"One by one from every group"},{"id":"seytek-2012:p0994:b002:l016","ordinal":372072,"en":"Kuyaly chose them out."},{"id":"seytek-2012:p0994:b002:l017","ordinal":372073,"en":"When their number reached ninety,"},{"id":"seytek-2012:p0994:b002:l018","ordinal":372074,"en":"Now put the words in their proper place:"},{"id":"seytek-2012:p0994:b002:l019","ordinal":372075,"en":"“Troubled times have befallen us.”"},{"id":"seytek-2012:p0994:b002:l020","ordinal":372076,"en":"With bull necks and camel-like frames,"},{"id":"seytek-2012:p0994:b002:l021","ordinal":372077,"en":"Their struggling could destroy a life."},{"id":"seytek-2012:p0994:b002:l022","ordinal":372078,"en":"Some of the wrestlers there"},{"id":"seytek-2012:p0994:b002:l023","ordinal":372079,"en":"Were broad of chest but short in stature;"},{"id":"seytek-2012:p0994:b002:l024","ordinal":372080,"en":"Some wrestlers were such"},{"id":"seytek-2012:p0994:b002:l025","ordinal":372081,"en":"That their whole bodies seemed black stone."},{"id":"seytek-2012:p0994:b002:l026","ordinal":372082,"en":"Such were some of the wrestlers."},{"id":"seytek-2012:p0994:b002:l027","ordinal":372083,"en":"Their bristling mustaches"},{"id":"seytek-2012:p0994:b002:l028","ordinal":372084,"en":"Were like the hafts of battle-axes."},{"id":"seytek-2012:p0994:b002:l029","ordinal":372085,"en":"When you looked at some,"},{"id":"seytek-2012:p0994:b002:l030","ordinal":372086,"en":"Their finely fashioned noses"},{"id":"seytek-2012:p0994:b002:l031","ordinal":372087,"en":"Were like the sheaths of sabers."},{"id":"seytek-2012:p0994:b002:l032","ordinal":372088,"en":"When you looked at others,"},{"id":"seytek-2012:p0994:b002:l033","ordinal":372089,"en":"Their lower jaws hung loose,"},{"id":"seytek-2012:p0994:b002:l034","ordinal":372090,"en":"Like great leather sacks."},{"id":"seytek-2012:p0994:b002:l035","ordinal":372091,"en":"Some heroic wrestlers"},{"id":"seytek-2012:p0994:b002:l036","ordinal":372092,"en":"Were splendidly formed."},{"id":"seytek-2012:p0994:b002:l037","ordinal":372093,"en":"“Obey whatever you are told,”"},{"id":"seytek-2012:p0994:b002:l038","ordinal":372094,"en":"And each raised his noble head,"},{"id":"seytek-2012:p0994:b002:l039","ordinal":372095,"en":"Ready to perform his service."},{"id":"seytek-2012:p0994:b002:l040","ordinal":372096,"en":"If told to dam a river, they could shatter stone"},{"id":"seytek-2012:p0994:b003:l001","ordinal":372097,"en":"And turn the river from its course;"},{"id":"seytek-2012:p0994:b003:l002","ordinal":372098,"en":"Crushing all without raising their heads,"},{"id":"seytek-2012:p0994:b003:l003","ordinal":372099,"en":"They could grind stones into meal."},{"id":"seytek-2012:p0994:b003:l004","ordinal":372100,"en":"Such wrestlers were among them."},{"id":"seytek-2012:p0994:b003:l005","ordinal":372101,"en":"They had been born into this world"},{"id":"seytek-2012:p0994:b003:l006","ordinal":372102,"en":"And come, it is said, as wrestlers."},{"id":"seytek-2012:p0994:b003:l007","ordinal":372103,"en":"They had faced grievous, burdensome trials"},{"id":"seytek-2012:p0994:b003:l008","ordinal":372104,"en":"And endured much hardship, it is said."},{"id":"seytek-2012:p0994:b003:l009","ordinal":372105,"en":"They were stationed beneath the battle standard,"},{"id":"seytek-2012:p0994:b003:l010","ordinal":372106,"en":"Ready to tie the firmest knot."},{"id":"seytek-2012:p0994:b003:l011","ordinal":372107,"en":"They could swing mattocks with sweeping strokes,"},{"id":"seytek-2012:p0994:b003:l012","ordinal":372108,"en":"Fill their broad bellies,"},{"id":"seytek-2012:p0994:b003:l013","ordinal":372109,"en":"And sustain their mighty bodies."},{"id":"seytek-2012:p0994:b003:l014","ordinal":372110,"en":"She gathered ninety wrestlers,"},{"id":"seytek-2012:p0994:b003:l015","ordinal":372111,"en":"Choosing them from the strongest."},{"id":"seytek-2012:p0994:b003:l016","ordinal":372112,"en":"That infidel Sarybai"},{"id":"seytek-2012:p0994:b003:l017","ordinal":372113,"en":"Was made to pay his true account."},{"id":"seytek-2012:p0994:b003:l018","ordinal":372114,"en":"She had the ninety mighty wrestlers"},{"id":"seytek-2012:p0994:b003:l019","ordinal":372115,"en":"Hack his body into pieces,"},{"id":"seytek-2012:p0994:b003:l020","ordinal":372116,"en":"Making a great spectacle,"},{"id":"seytek-2012:p0994:b003:l021","ordinal":372117,"en":"And gather firewood from the forest."},{"id":"seytek-2012:p0994:b003:l022","ordinal":372118,"en":"To settle his true account,"},{"id":"seytek-2012:p0994:b003:l023","ordinal":372119,"en":"They piled it mountain-high and set it ablaze."},{"id":"seytek-2012:p0994:b003:l024","ordinal":372120,"en":"The contentious villain Sarybai,"},{"id":"seytek-2012:p0994:b003:l025","ordinal":372121,"en":"Who had shown his savagery,"},{"id":"seytek-2012:p0994:b003:l026","ordinal":372122,"en":"Was cast into the fire and burned."},{"id":"seytek-2012:p0994:b003:l027","ordinal":372123,"en":"They shouted the glad tidings,"},{"id":"seytek-2012:p0994:b003:l028","ordinal":372124,"en":"Burned him and scattered his ashes."},{"id":"seytek-2012:p0994:b003:l029","ordinal":372125,"en":"For having defeated Sarybai,"},{"id":"seytek-2012:p0994:b003:l030","ordinal":372126,"en":"Maiden Kuyaly and hero Seytek"},{"id":"seytek-2012:p0994:b003:l031","ordinal":372127,"en":"Had no regret at all;"},{"id":"seytek-2012:p0994:b003:l032","ordinal":372128,"en":"There was no regret that he had died."},{"id":"seytek-2012:p0994:b003:l033","ordinal":372129,"en":"Their wish had fallen into their hands,"},{"id":"seytek-2012:p0994:b003:l034","ordinal":372130,"en":"And fortune had entered their path."},{"id":"seytek-2012:p0994:b003:l035","ordinal":372131,"en":"The offspring of the honor-bound lion,"},{"id":"seytek-2012:p0994:b003:l036","ordinal":372132,"en":"Receiving a blessing from Baabedin,"},{"id":"seytek-2012:p0994:b003:l037","ordinal":372133,"en":"To follow the path of their lion forefather,"},{"id":"seytek-2012:p0994:b003:l038","ordinal":372134,"en":"Received the blessing, “Moon-hoofed one.”"},{"id":"seytek-2012:p0994:b003:l039","ordinal":372135,"en":"They summoned all the people,"},{"id":"seytek-2012:p0994:b003:l040","ordinal":372136,"en":"And for the infidel Khan Sarybai"},{"id":"seytek-2012:p0995:b002:l001","ordinal":372137,"en":"They pitched a royal encampment,"},{"id":"seytek-2012:p0995:b002:l002","ordinal":372138,"en":"With kumiss by day and maidens by night,"},{"id":"seytek-2012:p0995:b002:l003","ordinal":372139,"en":"And held revels through the night."},{"id":"seytek-2012:p0995:b002:l004","ordinal":372140,"en":"That was a land of summer pastures,"},{"id":"seytek-2012:p0995:b002:l005","ordinal":372141,"en":"And he was the lion who brought his people joy."},{"id":"seytek-2012:p0995:b002:l006","ordinal":372142,"en":"The people’s faces brightened;"},{"id":"seytek-2012:p0995:b002:l007","ordinal":372143,"en":"After suffering great humiliation,"},{"id":"seytek-2012:p0995:b002:l008","ordinal":372144,"en":"Being held as though doomed to misery,"},{"id":"seytek-2012:p0995:b002:l009","ordinal":372145,"en":"And grieving without consolation,"},{"id":"seytek-2012:p0995:b002:l010","ordinal":372146,"en":"They were delivered from Sarybai."},{"id":"seytek-2012:p0995:b002:l011","ordinal":372147,"en":"All the assembled people—"},{"id":"seytek-2012:p0995:b002:l012","ordinal":372148,"en":"Their venerable elders,"},{"id":"seytek-2012:p0995:b002:l013","ordinal":372149,"en":"Their sages and eloquent speakers,"},{"id":"seytek-2012:p0995:b002:l014","ordinal":372150,"en":"And their many capable men—"},{"id":"seytek-2012:p0995:b002:l015","ordinal":372151,"en":"Conceived a radiant plan"},{"id":"seytek-2012:p0995:b002:l016","ordinal":372152,"en":"And held a feast in honor"},{"id":"seytek-2012:p0995:b002:l017","ordinal":372153,"en":"Of Kuyaly and the hero Seytek."},{"id":"seytek-2012:p0995:b002:l018","ordinal":372154,"en":"“That infidel Sarybai"},{"id":"seytek-2012:p0995:b002:l019","ordinal":372155,"en":"Plundered brides at his pleasure,” they said."},{"id":"seytek-2012:p0995:b002:l020","ordinal":372156,"en":"When you looked to the farthest reaches,"},{"id":"seytek-2012:p0995:b002:l021","ordinal":372157,"en":"The clouds had vanished,"},{"id":"seytek-2012:p0995:b002:l022","ordinal":372158,"en":"The night was departing and dawn breaking."},{"id":"seytek-2012:p0995:b002:l023","ordinal":372159,"en":"He had no voice left to utter a sound,"},{"id":"seytek-2012:p0995:b002:l024","ordinal":372160,"en":"No hand left to stretch forth."},{"id":"seytek-2012:p0995:b002:l025","ordinal":372161,"en":"“We have given Sarybai his due,” they said;"},{"id":"seytek-2012:p0995:b002:l026","ordinal":372162,"en":"He had vanished from this world."},{"id":"seytek-2012:p0995:b002:l027","ordinal":372163,"en":"“God has granted what we desired,” they said,"},{"id":"seytek-2012:p0995:b002:l028","ordinal":372164,"en":"And the blessed Night of Power descended."},{"id":"seytek-2012:p0995:b002:l029","ordinal":372165,"en":"Allah Most High, the one God,"},{"id":"seytek-2012:p0995:b002:l030","ordinal":372166,"en":"Had now granted it to them."},{"id":"seytek-2012:p0995:b002:l031","ordinal":372167,"en":"The oppressor of the people was subdued,"},{"id":"seytek-2012:p0995:b002:l032","ordinal":372168,"en":"Light poured down upon mankind,"},{"id":"seytek-2012:p0995:b002:l033","ordinal":372169,"en":"And the heavens shone with radiance."},{"id":"seytek-2012:p0995:b002:l034","ordinal":372170,"en":"The grievous calamity and great turmoil"},{"id":"seytek-2012:p0995:b002:l035","ordinal":372171,"en":"Subsided when Sarybai died."},{"id":"seytek-2012:p0995:b002:l036","ordinal":372172,"en":"Ruinous fury disappeared,"},{"id":"seytek-2012:p0995:b002:l037","ordinal":372173,"en":"The people prospered in exultation,"},{"id":"seytek-2012:p0995:b002:l038","ordinal":372174,"en":"And order among the folk was restored."},{"id":"seytek-2012:p0995:b002:l039","ordinal":372175,"en":"Their thoughts turned toward progress,"},{"id":"seytek-2012:p0995:b003:l001","ordinal":372176,"en":"And the times encountered prosperity."},{"id":"seytek-2012:p0995:b003:l002","ordinal":372177,"en":"They scattered his ashes to the sky,"},{"id":"seytek-2012:p0995:b003:l003","ordinal":372178,"en":"And extinguished the scattered brands."},{"id":"seytek-2012:p0995:b003:l004","ordinal":372179,"en":"From this world they cleansed away"},{"id":"seytek-2012:p0995:b003:l005","ordinal":372180,"en":"The infidel entirely."},{"id":"seytek-2012:p0995:b003:l006","ordinal":372181,"en":"Their great desire was fulfilled,"},{"id":"seytek-2012:p0995:b003:l007","ordinal":372182,"en":"And death came to the great villain."},{"id":"seytek-2012:p0995:b003:l008","ordinal":372183,"en":"Goodness entered the world;"},{"id":"seytek-2012:p0995:b003:l009","ordinal":372184,"en":"The incurable sickness that had struck,"},{"id":"seytek-2012:p0995:b003:l010","ordinal":372185,"en":"The myriad arrows lodged in their ribs,"},{"id":"seytek-2012:p0995:b003:l011","ordinal":372186,"en":"Was healed and subsided."},{"id":"seytek-2012:p0995:b003:l012","ordinal":372187,"en":"Resentful brows relaxed,"},{"id":"seytek-2012:p0995:b003:l013","ordinal":372188,"en":"Their wretched anguish abated,"},{"id":"seytek-2012:p0995:b003:l014","ordinal":372189,"en":"And their moon-bright faces cleared."},{"id":"seytek-2012:p0995:b003:l015","ordinal":372190,"en":"The people clamored and held a feast;"},{"id":"seytek-2012:p0995:b003:l016","ordinal":372191,"en":"The wicked swine was gone,"},{"id":"seytek-2012:p0995:b003:l017","ordinal":372192,"en":"And order among the people was restored."},{"id":"seytek-2012:p0995:b003:l018","ordinal":372193,"en":"Sarybai had waged war"},{"id":"seytek-2012:p0995:b003:l019","ordinal":372194,"en":"For many months and many years,"},{"id":"seytek-2012:p0995:b003:l020","ordinal":372195,"en":"And they had suffered, held in misery."},{"id":"seytek-2012:p0995:b003:l021","ordinal":372196,"en":"On that day the multitude,"},{"id":"seytek-2012:p0995:b003:l022","ordinal":372197,"en":"From the dire and savage affliction,"},{"id":"seytek-2012:p0995:b003:l023","ordinal":372198,"en":"Through the support of Seytek"},{"id":"seytek-2012:p0995:b003:l024","ordinal":372199,"en":"And the heroism of Kuyaly,"},{"id":"seytek-2012:p0995:b003:l025","ordinal":372200,"en":"Were delivered from Sarybai."},{"id":"seytek-2012:p0995:b003:l026","ordinal":372201,"en":"The people settled down in peace,"},{"id":"seytek-2012:p0995:b003:l027","ordinal":372202,"en":"Lying at ease upon their well-fed flanks."},{"id":"seytek-2012:p0995:b003:l028","ordinal":372203,"en":"They migrated freely to mountain pastures,"},{"id":"seytek-2012:p0995:b003:l029","ordinal":372204,"en":"And settled upon the foothills."},{"id":"seytek-2012:p0995:b003:l030","ordinal":372205,"en":"They lived according to their will,"},{"id":"seytek-2012:p0995:b003:l031","ordinal":372206,"en":"Hunting deer whenever they grew bored."},{"id":"seytek-2012:p0995:b003:l032","ordinal":372207,"en":"When the multitude was not weary,"},{"id":"seytek-2012:p0995:b003:l033","ordinal":372208,"en":"They played freely together,"},{"id":"seytek-2012:p0995:b003:l034","ordinal":372209,"en":"Rode young horses and flew hunting birds,"},{"id":"seytek-2012:p0995:b003:l035","ordinal":372210,"en":"Marked out the ordo field and cast their knucklebones,"},{"id":"seytek-2012:p0995:b003:l036","ordinal":372211,"en":"And won surpassing honor."},{"id":"seytek-2012:p0995:b003:l037","ordinal":372212,"en":"Amid grand and lively festivities,"},{"id":"seytek-2012:p0995:b003:l038","ordinal":372213,"en":"They raced horses and young steeds,"},{"id":"seytek-2012:p0995:b003:l039","ordinal":372214,"en":"Along the banks of broad Talas."},{"id":"seytek-2012:p0996:b002:l001","ordinal":372215,"en":"On the banks of broad Talas,"},{"id":"seytek-2012:p0996:b002:l002","ordinal":372216,"en":"Below Tört-Kül,"},{"id":"seytek-2012:p0996:b002:l003","ordinal":372217,"en":"In the garden once planted"},{"id":"seytek-2012:p0996:b002:l004","ordinal":372218,"en":"By the gray wolf Prince Manas,"},{"id":"seytek-2012:p0996:b002:l005","ordinal":372219,"en":"The son inherited from his father"},{"id":"seytek-2012:p0996:b002:l006","ordinal":372220,"en":"The throne upon which he sat,"},{"id":"seytek-2012:p0996:b002:l007","ordinal":372221,"en":"And his palace was of gold."},{"id":"seytek-2012:p0996:b002:l008","ordinal":372222,"en":"When they saw Aichürök,"},{"id":"seytek-2012:p0996:b002:l009","ordinal":372223,"en":"At the edge of the open steppe,"},{"id":"seytek-2012:p0996:b002:l010","ordinal":372224,"en":"Near the seer’s dark cave,"}]
