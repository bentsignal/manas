{"id": "sayakbay-ms-current146:pdf153:l001", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 1, "raw": "Ойрон болуп көндүгөм,", "text": "Ойрон болуп көндүгөм,", "en": "I grew accustomed to devastation,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf153:l002", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 2, "raw": "Бетимди Көбөй алды деп,", "text": "Бетимди Көбөй алды деп,", "en": "Saying Köböy had taken my honor,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf153:l003", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 3, "raw": "Каарыман кайран жан,", "text": "Каарыман кайран жан,", "en": "My wrathful, precious soul,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf153:l004", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 4, "raw": "Аркаңдан Ала-Тоо уруп,", "text": "Аркаңдан Ала-Тоо уруп,", "en": "With Ala-Too rising behind you,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf153:l005", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 5, "raw": "Ак калпак кыргыз эл үчүн,", "text": "Ак калпак кыргыз эл үчүн,", "en": "For the white-capped Kyrgyz people,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf153:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 6, "raw": "Намыс үчүн, эр үчүн,", "text": "Намыс үчүн, эр үчүн,", "en": "For honor and for the hero,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf153:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 7, "raw": "Айты күндүн күнүндө,", "text": "Айты күндүн күнүндө,", "en": "On the appointed day,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf153:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 8, "raw": "Жан багуучу мал үчүн,", "text": "Жан багуучу мал үчүн,", "en": "For the livestock that sustains life,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf153:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 9, "raw": "Керектүү жанын берди деп,", "text": "Керектүү жанын берди деп,", "en": "Saying he gave his needed life,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf153:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 10, "raw": "Кетсе кайра кайрылгыс,", "text": "Кетсе кайра кайрылгыс,", "en": "Once gone, he would never return,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf153:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 11, "raw": "Чын дүйнөдө корду деп,", "text": "Чын дүйнөдө корду деп,", "en": "Saying he was humbled in this world,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf153:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 12, "raw": "Күндүз менен түнкүсү,", "text": "Күндүз менен түнкүсү,", "en": "By day and by night,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf153:l013", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 13, "raw": "Ат жүргөн куу түзү,", "text": "Ат жүргөн куу түзү,", "en": "Across the barren plain where horses ran,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf153:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 14, "raw": "Той кылып тоюк мал союп,", "text": "Той кылып тоюк мал союп,", "en": "Holding a feast and slaughtering feast-beasts,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf153:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 15, "raw": "Нур төгүлгөн иш кылып,", "text": "Нур төгүлгөн иш кылып,", "en": "Doing a deed that shed radiance,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf153:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 16, "raw": "Артың Кенен болгон,", "text": "Артың Кенен болгон,", "en": "Kenen stood behind you,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf153:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 17, "raw": "Ар бириңер жол болгон,", "text": "Ар бириңер жол болгон,", "en": "Each of you became a guide,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf153:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 18, "raw": "Кайың, сарык, Алай сарык деп,", "text": "Кайың, сарык, Алай сарык деп,", "en": "Calling the tribes Kayyñ, Saryk, and Alay Saryk,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf153:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 19, "raw": "Элиң өрөөнгө түшкөн,", "text": "Элиң өрөөнгө түшкөн,", "en": "Your people descended into the valley,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf153:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 20, "raw": "Убактысына эр чыгып,", "text": "Убактысына эр чыгып,", "en": "At the appointed time a hero came forth,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf153:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 21, "raw": "Эки арстан тең чыгып,", "text": "Эки арстан тең чыгып,", "en": "The two lions came out together,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf153:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 22, "raw": "Аламанга салган чуулган,", "text": "Аламанга салган чуулган,", "en": "They cast turmoil into the massed battle,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf153:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 23, "raw": "Баатыр жоодон өлбөйбү,", "text": "Баатыр жоодон өлбөйбү,", "en": "Does a warrior not die by the enemy?", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf153:l024", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 24, "raw": "Атта калса дүйнөдө,", "text": "Атта калса дүйнөдө,", "en": "If he remains mounted in this world,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
