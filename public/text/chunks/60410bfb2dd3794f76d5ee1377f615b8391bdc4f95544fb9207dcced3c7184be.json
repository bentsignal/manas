[{"id":"seytek-2012:p0520:b003:l010","ordinal":335617,"en":"As the madman stood thus."},{"id":"seytek-2012:p0520:b003:l011","ordinal":335618,"en":"Whipping the dun kulan-horse,"},{"id":"seytek-2012:p0520:b003:l012","ordinal":335619,"en":"That capable servant, fitted for war,"},{"id":"seytek-2012:p0520:b003:l013","ordinal":335620,"en":"That powerful servant who knew"},{"id":"seytek-2012:p0520:b003:l014","ordinal":335621,"en":"All the stratagems of the foe,"},{"id":"seytek-2012:p0520:b003:l015","ordinal":335622,"en":"Fortunate Külchoro—"},{"id":"seytek-2012:p0520:b003:l016","ordinal":335623,"en":"Was he not the warrior who had struck down"},{"id":"seytek-2012:p0520:b003:l017","ordinal":335624,"en":"Not only Sarybai, but the world?"},{"id":"seytek-2012:p0520:b003:l018","ordinal":335625,"en":"Had he not subdued"},{"id":"seytek-2012:p0520:b003:l019","ordinal":335626,"en":"And conquered the whole world!"},{"id":"seytek-2012:p0520:b003:l020","ordinal":335627,"en":"His eyes saw from afar;"},{"id":"seytek-2012:p0520:b003:l021","ordinal":335628,"en":"He was wiser than multitudes,"},{"id":"seytek-2012:p0520:b003:l022","ordinal":335629,"en":"And stood unmatched in a solitary race."},{"id":"seytek-2012:p0520:b003:l023","ordinal":335630,"en":"A supreme hero, master of the spear,"},{"id":"seytek-2012:p0520:b003:l024","ordinal":335631,"en":"The tiger-warrior and sage"},{"id":"seytek-2012:p0520:b003:l025","ordinal":335632,"en":"Who truly knew the enemy’s stratagems."},{"id":"seytek-2012:p0520:b003:l026","ordinal":335633,"en":"He was a champion apart;"},{"id":"seytek-2012:p0520:b003:l027","ordinal":335634,"en":"Behold, the gray wolf Choro bore"},{"id":"seytek-2012:p0520:b003:l028","ordinal":335635,"en":"The weight of Mount Kap."},{"id":"seytek-2012:p0520:b003:l029","ordinal":335636,"en":"Sarybai faced him"},{"id":"seytek-2012:p0520:b003:l030","ordinal":335637,"en":"And struck with wild abandon."},{"id":"seytek-2012:p0520:b003:l031","ordinal":335638,"en":"When Zhelmaian’s head was turned,"},{"id":"seytek-2012:p0520:b003:l032","ordinal":335639,"en":"And Sarybai swung his mace,"},{"id":"seytek-2012:p0520:b003:l033","ordinal":335640,"en":"Külüstön, upheld by the ancestral spirits,"},{"id":"seytek-2012:p0520:b003:l034","ordinal":335641,"en":"Did not flinch at its ringing blows;"},{"id":"seytek-2012:p0520:b003:l035","ordinal":335642,"en":"He valued Sarybai’s attack"},{"id":"seytek-2012:p0520:b003:l036","ordinal":335643,"en":"No more than the hem of his robe."},{"id":"seytek-2012:p0520:b003:l037","ordinal":335644,"en":"He neither swayed nor stirred;"},{"id":"seytek-2012:p0520:b003:l038","ordinal":335645,"en":"The poor hero upheld by the ancestral spirits"},{"id":"seytek-2012:p0520:b003:l039","ordinal":335646,"en":"Did not move even when his gear was spent."},{"id":"seytek-2012:p0520:b003:l040","ordinal":335647,"en":"He turned his courser’s head,"},{"id":"seytek-2012:p0521:b002:l001","ordinal":335648,"en":"He was a lone-born wolf indeed."},{"id":"seytek-2012:p0521:b002:l002","ordinal":335649,"en":"He was an ocean, a worthy equal,"},{"id":"seytek-2012:p0521:b002:l003","ordinal":335650,"en":"A true gray-wolf hero."},{"id":"seytek-2012:p0521:b002:l004","ordinal":335651,"en":"“Ever since I became Sarybai,"},{"id":"seytek-2012:p0521:b002:l005","ordinal":335652,"en":"Ever since Sarybai mounted a horse,"},{"id":"seytek-2012:p0521:b002:l006","ordinal":335653,"en":"No desert has remained untrodden by me,"},{"id":"seytek-2012:p0521:b002:l007","ordinal":335654,"en":"No people unseen by me."},{"id":"seytek-2012:p0521:b002:l008","ordinal":335655,"en":"I wandered through many lands,"},{"id":"seytek-2012:p0521:b002:l009","ordinal":335656,"en":"Conquering this multitude,"},{"id":"seytek-2012:p0521:b002:l010","ordinal":335657,"en":"Making people scream."},{"id":"seytek-2012:p0521:b002:l011","ordinal":335658,"en":"Those who claimed to be warriors and giants,"},{"id":"seytek-2012:p0521:b002:l012","ordinal":335659,"en":"Who called themselves masters of the earth—"},{"id":"seytek-2012:p0521:b002:l013","ordinal":335660,"en":"I slaughtered many such champions."},{"id":"seytek-2012:p0521:b002:l014","ordinal":335661,"en":"Never among all those have I seen his like;"},{"id":"seytek-2012:p0521:b002:l015","ordinal":335662,"en":"He is truly mighty, truly a hero!”"},{"id":"seytek-2012:p0521:b002:l016","ordinal":335663,"en":"So saying, Sarybai"},{"id":"seytek-2012:p0521:b002:l017","ordinal":335664,"en":"Tested his valor"},{"id":"seytek-2012:p0521:b002:l018","ordinal":335665,"en":"And brought down a mountain’s weight."},{"id":"seytek-2012:p0521:b002:l019","ordinal":335666,"en":"The spear blazed and became an ember;"},{"id":"seytek-2012:p0521:b002:l020","ordinal":335667,"en":"When Külchoro thrust his spear,"},{"id":"seytek-2012:p0521:b002:l021","ordinal":335668,"en":"Sarybai stood fast and endured it."},{"id":"seytek-2012:p0521:b002:l022","ordinal":335669,"en":"Then Külchoro said:"},{"id":"seytek-2012:p0521:b002:l023","ordinal":335670,"en":"“If God delivers the slave to me,”"},{"id":"seytek-2012:p0521:b002:l024","ordinal":335671,"en":"And, holding this thought,"},{"id":"seytek-2012:p0521:b002:l025","ordinal":335672,"en":"Külchoro aimed without withdrawing his spear,"},{"id":"seytek-2012:p0521:b002:l026","ordinal":335673,"en":"And at that infidel Sarybai"},{"id":"seytek-2012:p0521:b002:l027","ordinal":335674,"en":"He thrust sixty times."},{"id":"seytek-2012:p0521:b002:l028","ordinal":335675,"en":"Sarybai rang but paid no heed,"},{"id":"seytek-2012:p0521:b002:l029","ordinal":335676,"en":"Valuing sixty spear thrusts"},{"id":"seytek-2012:p0521:b002:l030","ordinal":335677,"en":"No more than the hem of his robe,"},{"id":"seytek-2012:p0521:b002:l031","ordinal":335678,"en":"Then found a desperate stratagem."},{"id":"seytek-2012:p0521:b002:l032","ordinal":335679,"en":"He struck Külchoro’s spear"},{"id":"seytek-2012:p0521:b002:l033","ordinal":335680,"en":"Across the middle of its shaft."},{"id":"seytek-2012:p0521:b002:l034","ordinal":335681,"en":"The spear broke and was rendered useless;"},{"id":"seytek-2012:p0521:b002:l035","ordinal":335682,"en":"Splintering across the middle,"},{"id":"seytek-2012:p0521:b002:l036","ordinal":335683,"en":"Külchoro’s ornamented spear"},{"id":"seytek-2012:p0521:b002:l037","ordinal":335684,"en":"Whirled shrieking into the sky."},{"id":"seytek-2012:p0521:b002:l038","ordinal":335685,"en":"That gray wolf Külchoro"},{"id":"seytek-2012:p0521:b002:l039","ordinal":335686,"en":"Had his weapon and his beloved;"},{"id":"seytek-2012:p0521:b002:l040","ordinal":335687,"en":"Such strength did the gray wolf possess."},{"id":"seytek-2012:p0521:b003:l001","ordinal":335688,"en":"Its point had been forged in steel"},{"id":"seytek-2012:p0521:b003:l002","ordinal":335689,"en":"That it might pierce wherever it struck,"},{"id":"seytek-2012:p0521:b003:l003","ordinal":335690,"en":"And rip apart wherever it was thrust;"},{"id":"seytek-2012:p0521:b003:l004","ordinal":335691,"en":"Should it chance to hit its mark,"},{"id":"seytek-2012:p0521:b003:l005","ordinal":335692,"en":"It would cut through to the far side."},{"id":"seytek-2012:p0521:b003:l006","ordinal":335693,"en":"Thus had it been fashioned."},{"id":"seytek-2012:p0521:b003:l007","ordinal":335694,"en":"Its point had been forged in steel,"},{"id":"seytek-2012:p0521:b003:l008","ordinal":335695,"en":"And tempered sixty times"},{"id":"seytek-2012:p0521:b003:l009","ordinal":335696,"en":"In a dragon’s venom."},{"id":"seytek-2012:p0521:b003:l010","ordinal":335697,"en":"Death is common to all—this was its fire;"},{"id":"seytek-2012:p0521:b003:l011","ordinal":335698,"en":"Such was the nature of the spear."},{"id":"seytek-2012:p0521:b003:l012","ordinal":335699,"en":"He aimed at the measured spot,"},{"id":"seytek-2012:p0521:b003:l013","ordinal":335700,"en":"And valiant hero Külchoro"},{"id":"seytek-2012:p0521:b003:l014","ordinal":335701,"en":"Thrust and stabbed Sarybai."},{"id":"seytek-2012:p0521:b003:l015","ordinal":335702,"en":"Choro began his furious assault;"},{"id":"seytek-2012:p0521:b003:l016","ordinal":335703,"en":"With both coat fronts flapping,"},{"id":"seytek-2012:p0521:b003:l017","ordinal":335704,"en":"Sarybai nearly tumbled"},{"id":"seytek-2012:p0521:b003:l018","ordinal":335705,"en":"From Zhelmaian."},{"id":"seytek-2012:p0521:b003:l019","ordinal":335706,"en":"Zhelmaian staggered,"},{"id":"seytek-2012:p0521:b003:l020","ordinal":335707,"en":"And Sarybai stood pale,"},{"id":"seytek-2012:p0521:b003:l021","ordinal":335708,"en":"Marvelling at Külchoro:"},{"id":"seytek-2012:p0521:b003:l022","ordinal":335709,"en":"“He is renowned, a mountain indeed,"},{"id":"seytek-2012:p0521:b003:l023","ordinal":335710,"en":"A renowned gray-wolf hero."},{"id":"seytek-2012:p0521:b003:l024","ordinal":335711,"en":"Thick-armed and stone-hearted,"},{"id":"seytek-2012:p0521:b003:l025","ordinal":335712,"en":"A broad fellow with an elephant’s frame."},{"id":"seytek-2012:p0521:b003:l026","ordinal":335713,"en":"Against any rival or enemy"},{"id":"seytek-2012:p0521:b003:l027","ordinal":335714,"en":"He can unleash great havoc."},{"id":"seytek-2012:p0521:b003:l028","ordinal":335715,"en":"He is a warrior and a hero,"},{"id":"seytek-2012:p0521:b003:l029","ordinal":335716,"en":"A singularly born champion."},{"id":"seytek-2012:p0521:b003:l030","ordinal":335717,"en":"His weight is heavy and his venom strong;"},{"id":"seytek-2012:p0521:b003:l031","ordinal":335718,"en":"He surpasses the whole world.”"},{"id":"seytek-2012:p0521:b003:l032","ordinal":335719,"en":"He began a fierce assault,"},{"id":"seytek-2012:p0521:b003:l033","ordinal":335720,"en":"But when Sarybai struck mightily,"},{"id":"seytek-2012:p0521:b003:l034","ordinal":335721,"en":"He nearly fell away."},{"id":"seytek-2012:p0521:b003:l035","ordinal":335722,"en":"“What thick-muscled creature is this?"},{"id":"seytek-2012:p0521:b003:l036","ordinal":335723,"en":"No such man appears in an age."},{"id":"seytek-2012:p0521:b003:l037","ordinal":335724,"en":"I barely stopped myself with a cry;"},{"id":"seytek-2012:p0521:b003:l038","ordinal":335725,"en":"My soul nearly leapt from my breast."},{"id":"seytek-2012:p0521:b003:l039","ordinal":335726,"en":"He is hard as blue iron,"},{"id":"seytek-2012:p0521:b003:l040","ordinal":335727,"en":"One who has destroyed many men,"},{"id":"seytek-2012:p0522:b002:l001","ordinal":335728,"en":"Yet he had no thought of dying."},{"id":"seytek-2012:p0522:b002:l002","ordinal":335729,"en":"The steel shield upon his head"},{"id":"seytek-2012:p0522:b002:l003","ordinal":335730,"en":"Shattered and burst into sparks."},{"id":"seytek-2012:p0522:b002:l004","ordinal":335731,"en":"That infidel son of the Ogre"},{"id":"seytek-2012:p0522:b002:l005","ordinal":335732,"en":"Survived even this and stood fast."},{"id":"seytek-2012:p0522:b002:l006","ordinal":335733,"en":"Sarybai grew fearsome"},{"id":"seytek-2012:p0522:b002:l007","ordinal":335734,"en":"And began his true scourging."},{"id":"seytek-2012:p0522:b002:l008","ordinal":335735,"en":"Overturning mountains and draining lakes,"},{"id":"seytek-2012:p0522:b002:l009","ordinal":335736,"en":"He wrought fierce deeds without pause."},{"id":"seytek-2012:p0522:b002:l010","ordinal":335737,"en":"He consumed all who crossed him;"},{"id":"seytek-2012:p0522:b002:l011","ordinal":335738,"en":"Only the unbroken black earth"},{"id":"seytek-2012:p0522:b002:l012","ordinal":335739,"en":"Halted the mass of his force."},{"id":"seytek-2012:p0522:b002:l013","ordinal":335740,"en":"He leveled every hill,"},{"id":"seytek-2012:p0522:b002:l014","ordinal":335741,"en":"And tore up forests in his might."},{"id":"seytek-2012:p0522:b002:l015","ordinal":335742,"en":"He reduced to dust the very seed"},{"id":"seytek-2012:p0522:b002:l016","ordinal":335743,"en":"Of both the living and the lifeless."},{"id":"seytek-2012:p0522:b002:l017","ordinal":335744,"en":"Furiously making ready,"},{"id":"seytek-2012:p0522:b002:l018","ordinal":335745,"en":"The infidel Sarybai"},{"id":"seytek-2012:p0522:b002:l019","ordinal":335746,"en":"Came charging straight ahead."},{"id":"seytek-2012:p0522:b002:l020","ordinal":335747,"en":"He roared in wrath,"},{"id":"seytek-2012:p0522:b002:l021","ordinal":335748,"en":"Making the whole body"},{"id":"seytek-2012:p0522:b002:l022","ordinal":335749,"en":"Of every onlooker tremble."},{"id":"seytek-2012:p0522:b002:l023","ordinal":335750,"en":"Blazing outright and stirring strife,"},{"id":"seytek-2012:p0522:b002:l024","ordinal":335751,"en":"He bristled in fury"},{"id":"seytek-2012:p0522:b002:l025","ordinal":335752,"en":"And began a savage assault."},{"id":"seytek-2012:p0522:b002:l026","ordinal":335753,"en":"The solid black earth beneath him,"},{"id":"seytek-2012:p0522:b002:l027","ordinal":335754,"en":"Before the scourge of Sarybai’s rage,"},{"id":"seytek-2012:p0522:b002:l028","ordinal":335755,"en":"The infidel’s bitter venom,"},{"id":"seytek-2012:p0522:b002:l029","ordinal":335756,"en":"His crashing fury,"},{"id":"seytek-2012:p0522:b002:l030","ordinal":335757,"en":"And his utterly dreadful aspect,"},{"id":"seytek-2012:p0522:b002:l031","ordinal":335758,"en":"Seemed about to break apart."},{"id":"seytek-2012:p0522:b002:l032","ordinal":335759,"en":"Raging and running mad,"},{"id":"seytek-2012:p0522:b002:l033","ordinal":335760,"en":"He began a savage assault."},{"id":"seytek-2012:p0522:b002:l034","ordinal":335761,"en":"He overturned earth and sky,"},{"id":"seytek-2012:p0522:b002:l035","ordinal":335762,"en":"And swept them away."},{"id":"seytek-2012:p0522:b002:l036","ordinal":335763,"en":"He cursed the beast beneath him;"},{"id":"seytek-2012:p0522:b002:l037","ordinal":335764,"en":"The teeming army on campaign"},{"id":"seytek-2012:p0522:b002:l038","ordinal":335765,"en":"Surged away in panic and stopped,"},{"id":"seytek-2012:p0522:b002:l039","ordinal":335766,"en":"As though ready to flee before him."},{"id":"seytek-2012:p0522:b002:l040","ordinal":335767,"en":"Yet Choro was a champion and a hero,"},{"id":"seytek-2012:p0522:b003:l001","ordinal":335768,"en":"And possessed every weapon."},{"id":"seytek-2012:p0522:b003:l002","ordinal":335769,"en":"The vigilant, noble hero Choro"},{"id":"seytek-2012:p0522:b003:l003","ordinal":335770,"en":"Let the golden-cheeked battle-ax"},{"id":"seytek-2012:p0522:b003:l004","ordinal":335771,"en":"Swing from his wrist,"},{"id":"seytek-2012:p0522:b003:l005","ordinal":335772,"en":"Then gripped it firmly."},{"id":"seytek-2012:p0522:b003:l006","ordinal":335773,"en":"If you ask about the battle-ax,"},{"id":"seytek-2012:p0522:b003:l007","ordinal":335774,"en":"Its broad edge was a handspan wide;"},{"id":"seytek-2012:p0522:b003:l008","ordinal":335775,"en":"Wherever it swung, blood spread."},{"id":"seytek-2012:p0522:b003:l009","ordinal":335776,"en":"Its steel socket was as thick as a fist;"},{"id":"seytek-2012:p0522:b003:l010","ordinal":335777,"en":"Such was the battle-ax."},{"id":"seytek-2012:p0522:b003:l011","ordinal":335778,"en":"Placed upon grass, it set it ablaze;"},{"id":"seytek-2012:p0522:b003:l012","ordinal":335779,"en":"Whatever it struck died at once."},{"id":"seytek-2012:p0522:b003:l013","ordinal":335780,"en":"When swung in battle lust,"},{"id":"seytek-2012:p0522:b003:l014","ordinal":335781,"en":"A head flew broadly away,"},{"id":"seytek-2012:p0522:b003:l015","ordinal":335782,"en":"And blood followed after it."},{"id":"seytek-2012:p0522:b003:l016","ordinal":335783,"en":"When the blood flowed, strength departed,"},{"id":"seytek-2012:p0522:b003:l017","ordinal":335784,"en":"And after the blood, life departed."},{"id":"seytek-2012:p0522:b003:l018","ordinal":335785,"en":"The champion who wielded it rejoiced;"},{"id":"seytek-2012:p0522:b003:l019","ordinal":335786,"en":"It was honed to cleave stone when swung"},{"id":"seytek-2012:p0522:b003:l020","ordinal":335787,"en":"And pass through without glancing aside,"},{"id":"seytek-2012:p0522:b003:l021","ordinal":335788,"en":"So that when brought against an opponent,"},{"id":"seytek-2012:p0522:b003:l022","ordinal":335789,"en":"The blow would reach his very roots."},{"id":"seytek-2012:p0522:b003:l023","ordinal":335790,"en":"Thus its edge was sharpened and refined."},{"id":"seytek-2012:p0522:b003:l024","ordinal":335791,"en":"When men learned how keen it was,"},{"id":"seytek-2012:p0522:b003:l025","ordinal":335792,"en":"Many companions embraced him as friends"},{"id":"seytek-2012:p0522:b003:l026","ordinal":335793,"en":"And begged him for it."},{"id":"seytek-2012:p0522:b003:l027","ordinal":335794,"en":"He would not give it for a life;"},{"id":"seytek-2012:p0522:b003:l028","ordinal":335795,"en":"No living soul had seen such cold cruelty."},{"id":"seytek-2012:p0522:b003:l029","ordinal":335796,"en":"Whoever it struck fell and crawled;"},{"id":"seytek-2012:p0522:b003:l030","ordinal":335797,"en":"No marvel like it had ever been."},{"id":"seytek-2012:p0522:b003:l031","ordinal":335798,"en":"The golden-cheeked battle-ax—"},{"id":"seytek-2012:p0522:b003:l032","ordinal":335799,"en":"The agile hero Choro"},{"id":"seytek-2012:p0522:b003:l033","ordinal":335800,"en":"Gripped it in both hands and swung it around."},{"id":"seytek-2012:p0522:b003:l034","ordinal":335801,"en":"In less time than one could cry “Ah,”"},{"id":"seytek-2012:p0522:b003:l035","ordinal":335802,"en":"The golden-cheeked battle-ax"},{"id":"seytek-2012:p0522:b003:l036","ordinal":335803,"en":"Was drawn back with both hands"},{"id":"seytek-2012:p0522:b003:l037","ordinal":335804,"en":"By the hero Choro, upheld by the spirits."},{"id":"seytek-2012:p0522:b003:l038","ordinal":335805,"en":"He turned Kulansur’s head,"},{"id":"seytek-2012:p0522:b003:l039","ordinal":335806,"en":"And the mighty warrior watched closely"},{"id":"seytek-2012:p0522:b003:l040","ordinal":335807,"en":"The infidel son of the Ogre."},{"id":"seytek-2012:p0523:b002:l001","ordinal":335808,"en":"Sarybay struck with his spear."},{"id":"seytek-2012:p0523:b002:l002","ordinal":335809,"en":"The accursed one’s nature was thus:"},{"id":"seytek-2012:p0523:b002:l003","ordinal":335810,"en":"His fury kept mounting."},{"id":"seytek-2012:p0523:b002:l004","ordinal":335811,"en":"In the blink of an eye,"},{"id":"seytek-2012:p0523:b002:l005","ordinal":335812,"en":"Before a word could be uttered,"},{"id":"seytek-2012:p0523:b002:l006","ordinal":335813,"en":"He kept changing form."},{"id":"seytek-2012:p0523:b002:l007","ordinal":335814,"en":"Beyond human comprehension,"},{"id":"seytek-2012:p0523:b002:l008","ordinal":335815,"en":"He was gaining the upper hand."},{"id":"seytek-2012:p0523:b002:l009","ordinal":335816,"en":"Warriors and whole armies"},{"id":"seytek-2012:p0523:b002:l010","ordinal":335817,"en":"He kept overwhelming."},{"id":"seytek-2012:p0523:b002:l011","ordinal":335818,"en":"Overturning valleys and mountains,"},{"id":"seytek-2012:p0523:b002:l012","ordinal":335819,"en":"The infidel’s furious demon"},{"id":"seytek-2012:p0523:b002:l013","ordinal":335820,"en":"Kept surging forth."},{"id":"seytek-2012:p0523:b002:l014","ordinal":335821,"en":"A thousand times worse than before,"},{"id":"seytek-2012:p0523:b002:l015","ordinal":335822,"en":"The rabid dog’s great fury"},{"id":"seytek-2012:p0523:b002:l016","ordinal":335823,"en":"Kept overflowing."},{"id":"seytek-2012:p0523:b002:l017","ordinal":335824,"en":"Raging in a thousand forms,"},{"id":"seytek-2012:p0523:b002:l018","ordinal":335825,"en":"As though preparing to drain"},{"id":"seytek-2012:p0523:b002:l019","ordinal":335826,"en":"The whole world dry,"},{"id":"seytek-2012:p0523:b002:l020","ordinal":335827,"en":"Such was Sarybay’s nature."},{"id":"seytek-2012:p0523:b002:l021","ordinal":335828,"en":"Whoever witnessed his warrior’s might"},{"id":"seytek-2012:p0523:b002:l022","ordinal":335829,"en":"Despaired of his precious life,"},{"id":"seytek-2012:p0523:b002:l023","ordinal":335830,"en":"Feeling the age close tightly in,"},{"id":"seytek-2012:p0523:b002:l024","ordinal":335831,"en":"His hair and beard bristling,"},{"id":"seytek-2012:p0523:b002:l025","ordinal":335832,"en":"His burning eyes blazed,"},{"id":"seytek-2012:p0523:b002:l026","ordinal":335833,"en":"As Sarybay unleashed his fiercest rage."},{"id":"seytek-2012:p0523:b002:l027","ordinal":335834,"en":"Külchoro, born of noble Kül,"},{"id":"seytek-2012:p0523:b002:l028","ordinal":335835,"en":"With Külchoro at their head,"},{"id":"seytek-2012:p0523:b002:l029","ordinal":335836,"en":"He shook off and scattered"},{"id":"seytek-2012:p0523:b002:l030","ordinal":335837,"en":"A great host of Kül’s people."},{"id":"seytek-2012:p0523:b002:l031","ordinal":335838,"en":"He began speaking in wrath,"},{"id":"seytek-2012:p0523:b002:l032","ordinal":335839,"en":"And his words, more deadly than poison,"},{"id":"seytek-2012:p0523:b002:l033","ordinal":335840,"en":"Struck them down and destroyed them."},{"id":"seytek-2012:p0523:b002:l034","ordinal":335841,"en":"Sarybay stood there, raging,"},{"id":"seytek-2012:p0523:b002:l035","ordinal":335842,"en":"And addressed the vast host:"},{"id":"seytek-2012:p0523:b002:l036","ordinal":335843,"en":"“When my wrath rises and I rear up,"},{"id":"seytek-2012:p0523:b002:l037","ordinal":335844,"en":"I shall unleash a savage battle."},{"id":"seytek-2012:p0523:b002:l038","ordinal":335845,"en":"I shall spare none I can seize,"},{"id":"seytek-2012:p0523:b002:l039","ordinal":335846,"en":"Not leave a spoonful of blood,"},{"id":"seytek-2012:p0523:b002:l040","ordinal":335847,"en":"But slaughter every last one;"},{"id":"seytek-2012:p0523:b003:l001","ordinal":335848,"en":"He too is a hero born apart."},{"id":"seytek-2012:p0523:b003:l002","ordinal":335849,"en":"Külchoro is indeed a valiant man.”"},{"id":"seytek-2012:p0523:b003:l003","ordinal":335850,"en":"Sparing neither life,"},{"id":"seytek-2012:p0523:b003:l004","ordinal":335851,"en":"They fought in desperate fury."},{"id":"seytek-2012:p0523:b003:l005","ordinal":335852,"en":"The sprawling battlefield filled with standards,"},{"id":"seytek-2012:p0523:b003:l006","ordinal":335853,"en":"And an uproar split the sky,"},{"id":"seytek-2012:p0523:b003:l007","ordinal":335854,"en":"As they grappled on and on."},{"id":"seytek-2012:p0523:b003:l008","ordinal":335855,"en":"The hero Sarybay and Külchoro"},{"id":"seytek-2012:p0523:b003:l009","ordinal":335856,"en":"Kept fighting on and on."},{"id":"seytek-2012:p0523:b003:l010","ordinal":335857,"en":"Sarybay, son of the Monster,"},{"id":"seytek-2012:p0523:b003:l011","ordinal":335858,"en":"Was one no mortal could overcome,"},{"id":"seytek-2012:p0523:b003:l012","ordinal":335859,"en":"A swine that smeared the earth,"},{"id":"seytek-2012:p0523:b003:l013","ordinal":335860,"en":"Whom no living man could withstand."},{"id":"seytek-2012:p0523:b003:l014","ordinal":335861,"en":"He seemed as vast as a gorge,"},{"id":"seytek-2012:p0523:b003:l015","ordinal":335862,"en":"As though he would swallow any soul he met."},{"id":"seytek-2012:p0523:b003:l016","ordinal":335863,"en":"When he came face-to-face,"},{"id":"seytek-2012:p0523:b003:l017","ordinal":335864,"en":"It was as if he demanded, “Who are you?”"},{"id":"seytek-2012:p0523:b003:l018","ordinal":335865,"en":"As though he would seize every soul he met,"},{"id":"seytek-2012:p0523:b003:l019","ordinal":335866,"en":"Suck it dry, and devour it."},{"id":"seytek-2012:p0523:b003:l020","ordinal":335867,"en":"Like a fiend who brought nations to ruin,"},{"id":"seytek-2012:p0523:b003:l021","ordinal":335868,"en":"Like a champion who ruled the world."},{"id":"seytek-2012:p0523:b003:l022","ordinal":335869,"en":"He roared, looming huge,"},{"id":"seytek-2012:p0523:b003:l023","ordinal":335870,"en":"And bristled in anger,"},{"id":"seytek-2012:p0523:b003:l024","ordinal":335871,"en":"Ringing out without concern."},{"id":"seytek-2012:p0523:b003:l025","ordinal":335872,"en":"Though struck by spear and axe,"}]
