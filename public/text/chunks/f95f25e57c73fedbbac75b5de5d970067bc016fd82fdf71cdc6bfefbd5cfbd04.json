[{"id":"manas-2010:p1495:b001:l007","ordinal":64513,"en":"Kökchebich, shaped like a roe deer,"},{"id":"manas-2010:p1495:b001:l008","ordinal":64514,"en":"Bounded and sprang;"},{"id":"manas-2010:p1495:b001:l009","ordinal":64515,"en":"Heading straight for Kongurbay,"},{"id":"manas-2010:p1495:b001:l010","ordinal":64516,"en":"The fearless man began to charge."},{"id":"manas-2010:p1495:b001:l011","ordinal":64517,"en":"Those who came close,"},{"id":"manas-2010:p1495:b001:l012","ordinal":64518,"en":"He swept away with his sword;"},{"id":"manas-2010:p1495:b001:l013","ordinal":64519,"en":"The Chinese farther off,"},{"id":"manas-2010:p1495:b001:l014","ordinal":64520,"en":"He felled with his lance."},{"id":"manas-2010:p1495:b001:l015","ordinal":64521,"en":"Like a mountain collapsing,"},{"id":"manas-2010:p1495:b001:l016","ordinal":64522,"en":"Shattering those he encountered,"},{"id":"manas-2010:p1495:b001:l017","ordinal":64523,"en":"Brave Syrgak went slaughtering."},{"id":"manas-2010:p1495:b001:l018","ordinal":64524,"en":"Making the Chinese crawl,"},{"id":"manas-2010:p1495:b001:l019","ordinal":64525,"en":"Those who could split an eyeball with a shot,"},{"id":"manas-2010:p1495:b001:l020","ordinal":64526,"en":"All their marksmen,"},{"id":"manas-2010:p1495:b001:l021","ordinal":64527,"en":"When Syrgak came near,"},{"id":"manas-2010:p1495:b001:l022","ordinal":64528,"en":"Drew bows and sent a rain of arrows;"},{"id":"manas-2010:p1495:b001:l023","ordinal":64529,"en":"Upon brave Syrgak,"},{"id":"manas-2010:p1495:b001:l024","ordinal":64530,"en":"They shot, pouring arrows like hail."},{"id":"manas-2010:p1495:b001:l025","ordinal":64531,"en":"“If death comes, I shall die;"},{"id":"manas-2010:p1495:b001:l026","ordinal":64532,"en":"To the lion-champion Syrgak"},{"id":"manas-2010:p1495:b001:l027","ordinal":64533,"en":"I shall give support!”"},{"id":"manas-2010:p1495:b001:l028","ordinal":64534,"en":"Almambet, that precious keen warrior,"},{"id":"manas-2010:p1495:b001:l029","ordinal":64535,"en":"Charged in behind him."},{"id":"manas-2010:p1495:b001:l030","ordinal":64536,"en":"Akbaltay's Chubak,"},{"id":"manas-2010:p1495:b001:l031","ordinal":64537,"en":"Surging with Kögala,"},{"id":"manas-2010:p1495:b001:l032","ordinal":64538,"en":"Stretching like a lion,"},{"id":"manas-2010:p1495:b001:l033","ordinal":64539,"en":"Also entered battle."},{"id":"manas-2010:p1495:b001:l034","ordinal":64540,"en":"When thought finished, they sprang up anew,"},{"id":"manas-2010:p1495:b001:l035","ordinal":64541,"en":"Growing stronger from their roots:"},{"id":"manas-2010:p1495:b001:l036","ordinal":64542,"en":"The endless Chinese multitude."},{"id":"manas-2010:p1495:b001:l037","ordinal":64543,"en":"His shout splitting stones,"},{"id":"manas-2010:p1495:b001:l038","ordinal":64544,"en":"When Chubak entered without restraint,"},{"id":"manas-2010:p1495:b001:l039","ordinal":64545,"en":"Alöökö's Kongurbay"},{"id":"manas-2010:p1495:b001:l040","ordinal":64546,"en":"Gave his champion orders:"},{"id":"manas-2010:p1495:b001:l041","ordinal":64547,"en":"“Six thousand of the Dagger-Hands,"},{"id":"manas-2010:p1495:b001:l042","ordinal":64548,"en":"Sweep upon Chubak!"},{"id":"manas-2010:p1496:b001:l001","ordinal":64549,"en":"That rash Burut,"},{"id":"manas-2010:p1496:b001:l002","ordinal":64550,"en":"Now put an end to him!”"},{"id":"manas-2010:p1496:b001:l003","ordinal":64551,"en":"Heedless of pits and mounds,"},{"id":"manas-2010:p1496:b001:l004","ordinal":64552,"en":"Not reckoning death or doom,"},{"id":"manas-2010:p1496:b001:l005","ordinal":64553,"en":"He fought without restraint."},{"id":"manas-2010:p1496:b001:l006","ordinal":64554,"en":"Sending his horse Kögala racing,"},{"id":"manas-2010:p1496:b001:l007","ordinal":64555,"en":"The Dagger-Hands who came before him,"},{"id":"manas-2010:p1496:b001:l008","ordinal":64556,"en":"Your lion went slaughtering,"},{"id":"manas-2010:p1496:b001:l009","ordinal":64557,"en":"Tearing them from their horses,"},{"id":"manas-2010:p1496:b001:l010","ordinal":64558,"en":"Tossing them like fur caps."},{"id":"manas-2010:p1496:b001:l011","ordinal":64559,"en":"Like jackdaws struck by a saker falcon,"},{"id":"manas-2010:p1496:b001:l012","ordinal":64560,"en":"He scattered and drove them."},{"id":"manas-2010:p1496:b001:l013","ordinal":64561,"en":"Like small birds struck by a hobby,"},{"id":"manas-2010:p1496:b001:l014","ordinal":64562,"en":"He slaughtered the Chinese multitude."},{"id":"manas-2010:p1496:b001:l015","ordinal":64563,"en":"The giant governor and Kongurbay"},{"id":"manas-2010:p1496:b001:l016","ordinal":64564,"en":"Now saw this battle."},{"id":"manas-2010:p1496:b001:l017","ordinal":64565,"en":"From the pale, mottled sandy plain,"},{"id":"manas-2010:p1496:b001:l018","ordinal":64566,"en":"Kongurbay came thundering;"},{"id":"manas-2010:p1496:b001:l019","ordinal":64567,"en":"Those who saw him shuddered."},{"id":"manas-2010:p1496:b001:l020","ordinal":64568,"en":"That fellow skilled among spearmen,"},{"id":"manas-2010:p1496:b001:l021","ordinal":64569,"en":"That capable fellow versed in enemy tricks,"},{"id":"manas-2010:p1496:b001:l022","ordinal":64570,"en":"Reached brave Chubak now."},{"id":"manas-2010:p1496:b001:l023","ordinal":64571,"en":"Chubak upon Kögala,"},{"id":"manas-2010:p1496:b001:l024","ordinal":64572,"en":"Unprepared, from the flank,"},{"id":"manas-2010:p1496:b001:l025","ordinal":64573,"en":"He struck once with his lance,"},{"id":"manas-2010:p1496:b001:l026","ordinal":64574,"en":"Drove a mighty blow and passed."},{"id":"manas-2010:p1496:b001:l027","ordinal":64575,"en":"The hero left his saddle,"},{"id":"manas-2010:p1496:b001:l028","ordinal":64576,"en":"His foot left the stirrup."},{"id":"manas-2010:p1496:b001:l029","ordinal":64577,"en":"Kögala's sacred mane"},{"id":"manas-2010:p1496:b001:l030","ordinal":64578,"en":"He could not seize in his hand;"},{"id":"manas-2010:p1496:b001:l031","ordinal":64579,"en":"Against the gold-treaded stirrup"},{"id":"manas-2010:p1496:b001:l032","ordinal":64580,"en":"He could not brace his foot."},{"id":"manas-2010:p1496:b001:l033","ordinal":64581,"en":"His two legs spread wide;"},{"id":"manas-2010:p1496:b001:l034","ordinal":64582,"en":"While Chubak swayed in a daze,"},{"id":"manas-2010:p1496:b001:l035","ordinal":64583,"en":"The capable, mighty giant governor"},{"id":"manas-2010:p1496:b001:l036","ordinal":64584,"en":"Began to charge Chubak."},{"id":"manas-2010:p1496:b001:l037","ordinal":64585,"en":"“From Kögala's back"},{"id":"manas-2010:p1496:b001:l038","ordinal":64586,"en":"I shall drive him down with a thrust!”"},{"id":"manas-2010:p1496:b001:l039","ordinal":64587,"en":"He came racing,"},{"id":"manas-2010:p1496:b001:l040","ordinal":64588,"en":"His hems and sleeves rattling;"},{"id":"manas-2010:p1496:b001:l041","ordinal":64589,"en":"The flame coming from his mouth"},{"id":"manas-2010:p1496:b001:l042","ordinal":64590,"en":"Burned and hissed like fire,"},{"id":"manas-2010:p1497:b001:l001","ordinal":64591,"en":"His broad, door-sized teeth,"},{"id":"manas-2010:p1497:b001:l002","ordinal":64592,"en":"When the governor clenched them,"},{"id":"manas-2010:p1497:b001:l003","ordinal":64593,"en":"Crumbled like millet."},{"id":"manas-2010:p1497:b001:l004","ordinal":64594,"en":"Holding his lance steady,"},{"id":"manas-2010:p1497:b001:l005","ordinal":64595,"en":"He came crying, “Come, come!”"},{"id":"manas-2010:p1497:b001:l006","ordinal":64596,"en":"His battle-cry of “Come!”"},{"id":"manas-2010:p1497:b001:l007","ordinal":64597,"en":"Came eating at ears and noses."},{"id":"manas-2010:p1497:b001:l008","ordinal":64598,"en":"Ulak Khan's Syrgak thought,"},{"id":"manas-2010:p1497:b001:l009","ordinal":64599,"en":"“The God who strikes will strike us!"},{"id":"manas-2010:p1497:b001:l010","ordinal":64600,"en":"When this governor arrives,"},{"id":"manas-2010:p1497:b001:l011","ordinal":64601,"en":"He will thrust Chubak down,"},{"id":"manas-2010:p1497:b001:l012","ordinal":64602,"en":"Quenching him like a fire."},{"id":"manas-2010:p1497:b001:l013","ordinal":64603,"en":"While I remain alive and breathing,"},{"id":"manas-2010:p1497:b001:l014","ordinal":64604,"en":"What aim could I achieve?"},{"id":"manas-2010:p1497:b001:l015","ordinal":64605,"en":"From that wretch the governor, Chubak"},{"id":"manas-2010:p1497:b001:l016","ordinal":64606,"en":"Let me rescue!”"},{"id":"manas-2010:p1497:b001:l017","ordinal":64607,"en":"Thus brave Syrgak spoke."},{"id":"manas-2010:p1497:b001:l018","ordinal":64608,"en":"Kökchebich beneath him"},{"id":"manas-2010:p1497:b001:l019","ordinal":64609,"en":"He whipped from side to side."},{"id":"manas-2010:p1497:b001:l020","ordinal":64610,"en":"“Let me arrive before the governor!”"},{"id":"manas-2010:p1497:b001:l021","ordinal":64611,"en":"His dark eyes from their sockets"},{"id":"manas-2010:p1497:b001:l022","ordinal":64612,"en":"Jutted out and flashed."},{"id":"manas-2010:p1497:b001:l023","ordinal":64613,"en":"Kökchebich beneath him"},{"id":"manas-2010:p1497:b001:l024","ordinal":64614,"en":"Lowered his head toward the ground."},{"id":"manas-2010:p1497:b001:l025","ordinal":64615,"en":"If you looked at his speed,"},{"id":"manas-2010:p1497:b001:l026","ordinal":64616,"en":"Three times more than before"},{"id":"manas-2010:p1497:b001:l027","ordinal":64617,"en":"His flesh had warmed to the race."},{"id":"manas-2010:p1497:b001:l028","ordinal":64618,"en":"Before one could say this or that,"},{"id":"manas-2010:p1497:b001:l029","ordinal":64619,"en":"In the opening and closing of an eye,"},{"id":"manas-2010:p1497:b001:l030","ordinal":64620,"en":"The wrestler called Governor,"},{"id":"manas-2010:p1497:b001:l031","ordinal":64621,"en":"Syrgak reached in his charge."},{"id":"manas-2010:p1497:b001:l032","ordinal":64622,"en":"As soon as he reached the governor,"},{"id":"manas-2010:p1497:b001:l033","ordinal":64623,"en":"From the gray mule's back"},{"id":"manas-2010:p1497:b001:l034","ordinal":64624,"en":"He drove him down with a thrust."},{"id":"manas-2010:p1497:b001:l035","ordinal":64625,"en":"Thundering like a mighty mountain,"},{"id":"manas-2010:p1497:b001:l036","ordinal":64626,"en":"The giant governor fell from his mount."},{"id":"manas-2010:p1497:b001:l037","ordinal":64627,"en":"Before a Dagger-Hand, prepared,"},{"id":"manas-2010:p1497:b001:l038","ordinal":64628,"en":"A champion on foot, could arrive,"},{"id":"manas-2010:p1497:b001:l039","ordinal":64629,"en":"Buudayyk Khan's Muzburchak,"},{"id":"manas-2010:p1497:b001:l040","ordinal":64630,"en":"That precious hero who never turned aside,"},{"id":"manas-2010:p1497:b001:l041","ordinal":64631,"en":"The champion, the giant governor,"},{"id":"manas-2010:p1497:b001:l042","ordinal":64632,"en":"He passed and cut his head off."},{"id":"manas-2010:p1498:b001:l001","ordinal":64633,"en":"Cotton sash and broad boots,"},{"id":"manas-2010:p1498:b001:l002","ordinal":64634,"en":"Kongurbay, khan of the shaven priests,"},{"id":"manas-2010:p1498:b001:l003","ordinal":64635,"en":"Amid thick battle and great dust,"},{"id":"manas-2010:p1498:b001:l004","ordinal":64636,"en":"Muzburchak, Kökchö and Bokmurun:"},{"id":"manas-2010:p1498:b001:l005","ordinal":64637,"en":"He reached these three now."},{"id":"manas-2010:p1498:b001:l006","ordinal":64638,"en":"Reaching them, he smashed them all alike,"},{"id":"manas-2010:p1498:b001:l007","ordinal":64639,"en":"Thrust them down and passed."},{"id":"manas-2010:p1498:b001:l008","ordinal":64640,"en":"Before the Fierce One could recover,"},{"id":"manas-2010:p1498:b001:l009","ordinal":64641,"en":"Golden forelock and tasselled sash,"},{"id":"manas-2010:p1498:b001:l010","ordinal":64642,"en":"Azizkhan's Almambet"},{"id":"manas-2010:p1498:b001:l011","ordinal":64643,"en":"Arrived like a bullet."},{"id":"manas-2010:p1498:b001:l012","ordinal":64644,"en":"As soon as he reached the Fierce One,"},{"id":"manas-2010:p1498:b001:l013","ordinal":64645,"en":"From Algara's back"},{"id":"manas-2010:p1498:b001:l014","ordinal":64646,"en":"He thrust him down and passed."},{"id":"manas-2010:p1498:b001:l015","ordinal":64647,"en":"Kongurbay fell from his horse,"},{"id":"manas-2010:p1498:b001:l016","ordinal":64648,"en":"His spectacles gleaming,"},{"id":"manas-2010:p1498:b001:l017","ordinal":64649,"en":"The flask-sized bead-stone"},{"id":"manas-2010:p1498:b001:l018","ordinal":64650,"en":"Flashing upon his head."},{"id":"manas-2010:p1498:b001:l019","ordinal":64651,"en":"Many thoughts filled his heart:"},{"id":"manas-2010:p1498:b001:l020","ordinal":64652,"en":"“If God would grant me this one!”"},{"id":"manas-2010:p1498:b001:l021","ordinal":64653,"en":"The fierce-maned Chubak's"},{"id":"manas-2010:p1498:b001:l022","ordinal":64654,"en":"Tears flowed in ten streams."},{"id":"manas-2010:p1498:b001:l023","ordinal":64655,"en":"“As soon as I reach the Fierce One,"},{"id":"manas-2010:p1498:b001:l024","ordinal":64656,"en":"Let me cut his head off!"},{"id":"manas-2010:p1498:b001:l025","ordinal":64657,"en":"The dark blood from within him,"},{"id":"manas-2010:p1498:b001:l026","ordinal":64658,"en":"Let me scoop and swallow in handfuls!”"},{"id":"manas-2010:p1498:b001:l027","ordinal":64659,"en":"Your Chubak came charging."},{"id":"manas-2010:p1498:b001:l028","ordinal":64660,"en":"Before letting Khan Chubak reach him,"},{"id":"manas-2010:p1498:b001:l029","ordinal":64661,"en":"A thousand Dagger-Hand champions,"},{"id":"manas-2010:p1498:b001:l030","ordinal":64662,"en":"Who had him in their sights,"},{"id":"manas-2010:p1498:b001:l031","ordinal":64663,"en":"All thousand arrived together."},{"id":"manas-2010:p1498:b001:l032","ordinal":64664,"en":"As soon as they reached the Fierce One,"},{"id":"manas-2010:p1498:b001:l033","ordinal":64665,"en":"They mounted him upon Algara"},{"id":"manas-2010:p1498:b001:l034","ordinal":64666,"en":"And carried him away."},{"id":"manas-2010:p1498:b001:l035","ordinal":64667,"en":"Buudayyk Khan's Muzburchak,"},{"id":"manas-2010:p1498:b001:l036","ordinal":64668,"en":"As they were about to seize him alive,"},{"id":"manas-2010:p1498:b001:l037","ordinal":64669,"en":"The Chinese multitude gathered,"},{"id":"manas-2010:p1498:b001:l038","ordinal":64670,"en":"About to put him in their cage."},{"id":"manas-2010:p1498:b001:l039","ordinal":64671,"en":"Ulak Khan's Syrgak,"},{"id":"manas-2010:p1498:b001:l040","ordinal":64672,"en":"In such a hard battle,"},{"id":"manas-2010:p1498:b001:l041","ordinal":64673,"en":"The darling who would not turn back,"},{"id":"manas-2010:p1498:b001:l042","ordinal":64674,"en":"Struck Kökchebich with his whip."},{"id":"manas-2010:p1499:b001:l001","ordinal":64675,"en":"He arrived faster than an arrow."},{"id":"manas-2010:p1499:b001:l002","ordinal":64676,"en":"Seven thousand Shibee, a thousand governors:"},{"id":"manas-2010:p1499:b001:l003","ordinal":64677,"en":"Alone he entered among them."},{"id":"manas-2010:p1499:b001:l004","ordinal":64678,"en":"The governors across his path"},{"id":"manas-2010:p1499:b001:l005","ordinal":64679,"en":"He swept down with straight thrusts."},{"id":"manas-2010:p1499:b001:l006","ordinal":64680,"en":"The governors surrounding him"},{"id":"manas-2010:p1499:b001:l007","ordinal":64681,"en":"He drove back with a shout,"},{"id":"manas-2010:p1499:b001:l008","ordinal":64682,"en":"And reached Muzburchak."},{"id":"manas-2010:p1499:b001:l009","ordinal":64683,"en":"Upon arriving, your Syrgak"},{"id":"manas-2010:p1499:b001:l010","ordinal":64684,"en":"Grasped him once by the right shoulder,"},{"id":"manas-2010:p1499:b001:l011","ordinal":64685,"en":"Set him upon his right knee."},{"id":"manas-2010:p1499:b001:l012","ordinal":64686,"en":"That extraordinary, precious lion Syrgak,"},{"id":"manas-2010:p1499:b001:l013","ordinal":64687,"en":"Showing his lion's nature,"},{"id":"manas-2010:p1499:b001:l014","ordinal":64688,"en":"Carried Muzburchak away"},{"id":"manas-2010:p1499:b001:l015","ordinal":64689,"en":"And mounted him upon Telkyzyl."},{"id":"manas-2010:p1499:b001:l016","ordinal":64690,"en":"At that time, Muzburchak,"},{"id":"manas-2010:p1499:b001:l017","ordinal":64691,"en":"When he had fallen from his horse,"},{"id":"manas-2010:p1499:b001:l018","ordinal":64692,"en":"When they had surrounded him,"},{"id":"manas-2010:p1499:b001:l019","ordinal":64693,"en":"His head had become a bucket of blood."},{"id":"manas-2010:p1499:b001:l020","ordinal":64694,"en":"His entire body"},{"id":"manas-2010:p1499:b001:l021","ordinal":64695,"en":"Was numb and unable to move."},{"id":"manas-2010:p1499:b001:l022","ordinal":64696,"en":"With difficulty, mounting him,"},{"id":"manas-2010:p1499:b001:l023","ordinal":64697,"en":"Leading him along this way,"},{"id":"manas-2010:p1499:b001:l024","ordinal":64698,"en":"When brave Syrgak brought him out,"},{"id":"manas-2010:p1499:b001:l025","ordinal":64699,"en":"The Chinese in their joy"},{"id":"manas-2010:p1499:b001:l026","ordinal":64700,"en":"Had seen their lucky day dawn."},{"id":"manas-2010:p1499:b001:l027","ordinal":64701,"en":"Aydarkhan's Kökchö,"},{"id":"manas-2010:p1499:b001:l028","ordinal":64702,"en":"When he had fallen from his horse,"},{"id":"manas-2010:p1499:b001:l029","ordinal":64703,"en":"They put camel-hide headgear upon his head,"},{"id":"manas-2010:p1499:b001:l030","ordinal":64704,"en":"Mounted him backward upon a horse,"},{"id":"manas-2010:p1499:b001:l031","ordinal":64705,"en":"Before Karykan"},{"id":"manas-2010:p1499:b001:l032","ordinal":64706,"en":"To take him as a gift,"},{"id":"manas-2010:p1499:b001:l033","ordinal":64707,"en":"They bound him alive."},{"id":"manas-2010:p1499:b001:l034","ordinal":64708,"en":"Seeing this, brave Syrgak"},{"id":"manas-2010:p1499:b001:l035","ordinal":64709,"en":"Shouted, “The faith of Islam!”"},{"id":"manas-2010:p1499:b001:l036","ordinal":64710,"en":"Raised the battle-cry, “Manas!”"},{"id":"manas-2010:p1499:b001:l037","ordinal":64711,"en":"Upon the massed Chinese army"},{"id":"manas-2010:p1499:b001:l038","ordinal":64712,"en":"He charged, laying them low."},{"id":"manas-2010:p1499:b001:l039","ordinal":64713,"en":"Through their middle, brave Syrgak"},{"id":"manas-2010:p1499:b001:l040","ordinal":64714,"en":"Mowed and drove his way in;"},{"id":"manas-2010:p1499:b001:l041","ordinal":64715,"en":"Along their edges, brave Shuutu"},{"id":"manas-2010:p1499:b001:l042","ordinal":64716,"en":"Came slaughtering in support."},{"id":"manas-2010:p1500:b001:l001","ordinal":64717,"en":"On one flank, old Kyrgyl"},{"id":"manas-2010:p1500:b001:l002","ordinal":64718,"en":"Came tearing his way in."},{"id":"manas-2010:p1500:b001:l003","ordinal":64719,"en":"Baychoro and Agayar,"},{"id":"manas-2010:p1500:b001:l004","ordinal":64720,"en":"Making a waste of the Chinese,"},{"id":"manas-2010:p1500:b001:l005","ordinal":64721,"en":"Drove their way in."},{"id":"manas-2010:p1500:b001:l006","ordinal":64722,"en":"Girding themselves to risk all,"},{"id":"manas-2010:p1500:b001:l007","ordinal":64723,"en":"The Chinese moving in bands,"},{"id":"manas-2010:p1500:b001:l008","ordinal":64724,"en":"They broke and scattered their bands."},{"id":"manas-2010:p1500:b001:l009","ordinal":64725,"en":"Mountain-sized Kökchö's"},{"id":"manas-2010:p1500:b001:l010","ordinal":64726,"en":"Hands they untied."},{"id":"manas-2010:p1500:b001:l011","ordinal":64727,"en":"Rescuing Kökchö,"},{"id":"manas-2010:p1500:b001:l012","ordinal":64728,"en":"Brave Syrgak brought him out."},{"id":"manas-2010:p1500:b001:l013","ordinal":64729,"en":"Rekindling his extinguished fire,"},{"id":"manas-2010:p1500:b001:l014","ordinal":64730,"en":"Kökchö of the Kazakhs,"},{"id":"manas-2010:p1500:b001:l015","ordinal":64731,"en":"Reviving his deadened life,"},{"id":"manas-2010:p1500:b001:l016","ordinal":64732,"en":"Safe and sound, to his horse"},{"id":"manas-2010:p1500:b001:l017","ordinal":64733,"en":"He brought and mounted him."},{"id":"manas-2010:p1500:b001:l018","ordinal":64734,"en":"The massed Muslims,"},{"id":"manas-2010:p1500:b001:l019","ordinal":64735,"en":"Seeing Syrgak's valor,"},{"id":"manas-2010:p1500:b001:l020","ordinal":64736,"en":"All burst into tears together."},{"id":"manas-2010:p1500:b001:l021","ordinal":64737,"en":"Grateful, they spread their hands"},{"id":"manas-2010:p1500:b001:l022","ordinal":64738,"en":"And loudly gave their blessing."},{"id":"manas-2010:p1500:b001:l023","ordinal":64739,"en":"Kökötöy's Bokmurun,"},{"id":"manas-2010:p1500:b001:l024","ordinal":64740,"en":"When the fierce-maned Fierce One reached him,"},{"id":"manas-2010:p1500:b001:l025","ordinal":64741,"en":"When he fell from his horse,"},{"id":"manas-2010:p1500:b001:l026","ordinal":64742,"en":"All the Chinese thronged,"},{"id":"manas-2010:p1500:b001:l027","ordinal":64743,"en":"All their swordsmen"},{"id":"manas-2010:p1500:b001:l028","ordinal":64744,"en":"Swept upon him in a mass."},{"id":"manas-2010:p1500:b001:l029","ordinal":64745,"en":"Falling while he fought,"},{"id":"manas-2010:p1500:b001:l030","ordinal":64746,"en":"His wing bent back,"},{"id":"manas-2010:p1500:b001:l031","ordinal":64747,"en":"Parted from Maaniker,"},{"id":"manas-2010:p1500:b001:l032","ordinal":64748,"en":"The Chinese swarming upon him,"},{"id":"manas-2010:p1500:b001:l033","ordinal":64749,"en":"Despairing of his life,"},{"id":"manas-2010:p1500:b001:l034","ordinal":64750,"en":"Kökötöy's Bokmurun"},{"id":"manas-2010:p1500:b001:l035","ordinal":64751,"en":"Stood weeping with ringing sobs."},{"id":"manas-2010:p1500:b001:l036","ordinal":64752,"en":"“If I would walk, I have no feet;"},{"id":"manas-2010:p1500:b001:l037","ordinal":64753,"en":"I am like a snake."},{"id":"manas-2010:p1500:b001:l038","ordinal":64754,"en":"I have no tail to wag in fawning;"},{"id":"manas-2010:p1500:b001:l039","ordinal":64755,"en":"I am like a wild ass!"},{"id":"manas-2010:p1500:b001:l040","ordinal":64756,"en":"I knew orphanhood at the beginning;"},{"id":"manas-2010:p1500:b001:l041","ordinal":64757,"en":"I lost my dear father"},{"id":"manas-2010:p1500:b001:l042","ordinal":64758,"en":"When I was twelve years old."},{"id":"manas-2010:p1501:b001:l001","ordinal":64759,"en":"When I travelled far upon a journey,"},{"id":"manas-2010:p1501:b001:l002","ordinal":64760,"en":"I would shoot wild sheep for food,"},{"id":"manas-2010:p1501:b001:l003","ordinal":64761,"en":"And of the one I held in place of a father,"},{"id":"manas-2010:p1501:b001:l004","ordinal":64762,"en":"The generous leopard Manas,"},{"id":"manas-2010:p1501:b001:l005","ordinal":64763,"en":"I would say, ‘May he live in safety.’"},{"id":"manas-2010:p1501:b001:l006","ordinal":64764,"en":"My champion Manas, do not leave me!"},{"id":"manas-2010:p1501:b001:l007","ordinal":64765,"en":"Do not bring me to a hapless day,"},{"id":"manas-2010:p1501:b001:l008","ordinal":64766,"en":"Do not leave me plunged in misery!"},{"id":"manas-2010:p1501:b001:l009","ordinal":64767,"en":"The countless Chinese will swarm upon me,"},{"id":"manas-2010:p1501:b001:l010","ordinal":64768,"en":"Seize me and slaughter me,"}]
