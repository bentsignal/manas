[{"id":"semetey-1-2013:p1352:b003:l034","ordinal":179457,"en":"Nor retreat a hair from death;"},{"id":"semetey-1-2013:p1352:b003:l035","ordinal":179458,"en":"His brow was high, his venom strong,"},{"id":"semetey-1-2013:p1352:b003:l036","ordinal":179459,"en":"And he set right whoever attacked him."},{"id":"semetey-1-2013:p1352:b003:l037","ordinal":179460,"en":"From his fathers and forefathers"},{"id":"semetey-1-2013:p1352:b003:l038","ordinal":179461,"en":"There were eighty-four armed men."},{"id":"semetey-1-2013:p1352:b004:l001","ordinal":179462,"en":"From the beginning, wherever these blue-maned wolves"},{"id":"semetey-1-2013:p1352:b004:l002","ordinal":179463,"en":"Struck, there was red fire."},{"id":"semetey-1-2013:p1352:b004:l003","ordinal":179464,"en":"From his fathers and forefathers,"},{"id":"semetey-1-2013:p1352:b004:l004","ordinal":179465,"en":"He thought only what he himself wished,"},{"id":"semetey-1-2013:p1352:b004:l005","ordinal":179466,"en":"Heedless of anyone,"},{"id":"semetey-1-2013:p1352:b004:l006","ordinal":179467,"en":"Even if his doom arrived now,"},{"id":"semetey-1-2013:p1352:b004:l007","ordinal":179468,"en":"Even if he died at once,"},{"id":"semetey-1-2013:p1352:b004:l008","ordinal":179469,"en":"Taking no other person's word."},{"id":"semetey-1-2013:p1352:b004:l009","ordinal":179470,"en":"He acted on everything he saw,"},{"id":"semetey-1-2013:p1352:b004:l010","ordinal":179471,"en":"Descendant of the empty-headed line,"},{"id":"semetey-1-2013:p1352:b004:l011","ordinal":179472,"en":"Who poured blood into black water,"},{"id":"semetey-1-2013:p1352:b004:l012","ordinal":179473,"en":"Own son of Khan Manas."},{"id":"semetey-1-2013:p1352:b004:l013","ordinal":179474,"en":"He greased the grassy earth,"},{"id":"semetey-1-2013:p1352:b004:l014","ordinal":179475,"en":"And when provoked,"},{"id":"semetey-1-2013:p1352:b004:l015","ordinal":179476,"en":"Laid low even his own kin."},{"id":"semetey-1-2013:p1352:b004:l016","ordinal":179477,"en":"Descendant of the accursed one,"},{"id":"semetey-1-2013:p1352:b004:l017","ordinal":179478,"en":"Smoking more as he was exhausted,"},{"id":"semetey-1-2013:p1352:b004:l018","ordinal":179479,"en":"Own son of turbulent Manas,"},{"id":"semetey-1-2013:p1352:b004:l019","ordinal":179480,"en":"Growing stronger whenever men died."},{"id":"semetey-1-2013:p1352:b004:l020","ordinal":179481,"en":"He took his weapons and made ready,"},{"id":"semetey-1-2013:p1352:b004:l021","ordinal":179482,"en":"Preparing to mount and ride"},{"id":"semetey-1-2013:p1352:b004:l022","ordinal":179483,"en":"Against clamoring China."},{"id":"semetey-1-2013:p1352:b004:l023","ordinal":179484,"en":"Which of his deeds shall I tell?"},{"id":"semetey-1-2013:p1352:b004:l024","ordinal":179485,"en":"This butcher's youthful son"},{"id":"semetey-1-2013:p1352:b004:l025","ordinal":179486,"en":"Drives white deer and makes them cattle;"},{"id":"semetey-1-2013:p1352:b004:l026","ordinal":179487,"en":"He makes the enemy he fights his servant."},{"id":"semetey-1-2013:p1352:b004:l027","ordinal":179488,"en":"He drives blue deer and makes them cattle;"},{"id":"semetey-1-2013:p1352:b004:l028","ordinal":179489,"en":"He makes the enemy he targets his servant."},{"id":"semetey-1-2013:p1352:b004:l029","ordinal":179490,"en":"Sharpening his keen steel,"},{"id":"semetey-1-2013:p1352:b004:l030","ordinal":179491,"en":"Preparing his weapons,"},{"id":"semetey-1-2013:p1352:b004:l031","ordinal":179492,"en":"Rejoicing at the word Beijing,"},{"id":"semetey-1-2013:p1352:b004:l032","ordinal":179493,"en":"The hero's youthful son"},{"id":"semetey-1-2013:p1352:b004:l033","ordinal":179494,"en":"Put on his bulletproof coat."},{"id":"semetey-1-2013:p1352:b004:l034","ordinal":179495,"en":"Ah, poor lion, swaggering,"},{"id":"semetey-1-2013:p1352:b004:l035","ordinal":179496,"en":"His face transformed by wrath—"},{"id":"semetey-1-2013:p1352:b004:l036","ordinal":179497,"en":"(The youth born after"},{"id":"semetey-1-2013:p1352:b004:l037","ordinal":179498,"en":"His father, magnanimous Manas:"},{"id":"semetey-1-2013:p1352:b004:l038","ordinal":179499,"en":"Which of his deeds can we tell?)"},{"id":"semetey-1-2013:p1352:b004:l039","ordinal":179500,"en":"To journey on campaign to Beijing,"},{"id":"semetey-1-2013:p1353:b003:l001","ordinal":179501,"en":"To raid every one of the countless livestock"},{"id":"semetey-1-2013:p1353:b003:l002","ordinal":179502,"en":"Kongurbay gathered as tribute,"},{"id":"semetey-1-2013:p1353:b003:l003","ordinal":179503,"en":"Leaving none behind,"},{"id":"semetey-1-2013:p1353:b003:l004","ordinal":179504,"en":"The prince stood prepared."},{"id":"semetey-1-2013:p1353:b003:l005","ordinal":179505,"en":"His butcher uncle Bakay"},{"id":"semetey-1-2013:p1353:b003:l006","ordinal":179506,"en":"Put on a blue lynx-fur cap,"},{"id":"semetey-1-2013:p1353:b003:l007","ordinal":179507,"en":"Mounted a horse like a blue courser,"},{"id":"semetey-1-2013:p1353:b003:l008","ordinal":179508,"en":"And on the plain of Üch-Koshoy,"},{"id":"semetey-1-2013:p1353:b003:l009","ordinal":179509,"en":"Your elder, old Bakay,"},{"id":"semetey-1-2013:p1353:b003:l010","ordinal":179510,"en":"Beside broad Talas,"},{"id":"semetey-1-2013:p1353:b003:l011","ordinal":179511,"en":"When the predawn hour sounded"},{"id":"semetey-1-2013:p1353:b003:l012","ordinal":179512,"en":"And dawn grew bright,"},{"id":"semetey-1-2013:p1353:b003:l013","ordinal":179513,"en":"His saintly uncle Bakay"},{"id":"semetey-1-2013:p1353:b003:l014","ordinal":179514,"en":"Woke with a start from sleep,"},{"id":"semetey-1-2013:p1353:b003:l015","ordinal":179515,"en":"Turned onto his right side,"},{"id":"semetey-1-2013:p1353:b003:l016","ordinal":179516,"en":"Dipped his hands in water,"},{"id":"semetey-1-2013:p1353:b003:l017","ordinal":179517,"en":"Performed his ablutions,"},{"id":"semetey-1-2013:p1353:b003:l018","ordinal":179518,"en":"Prayed to the one God,"},{"id":"semetey-1-2013:p1353:b003:l019","ordinal":179519,"en":"Quickly recited the namaz,"},{"id":"semetey-1-2013:p1353:b003:l020","ordinal":179520,"en":"And saddled the blue courser."},{"id":"semetey-1-2013:p1353:b003:l021","ordinal":179521,"en":"He girded on his curved sword,"},{"id":"semetey-1-2013:p1353:b003:l022","ordinal":179522,"en":"Paused deep in thought,"},{"id":"semetey-1-2013:p1353:b003:l023","ordinal":179523,"en":"And remembered his former concern:"},{"id":"semetey-1-2013:p1353:b003:l024","ordinal":179524,"en":"To come and take counsel"},{"id":"semetey-1-2013:p1353:b003:l025","ordinal":179525,"en":"With the young son of Oyrong."},{"id":"semetey-1-2013:p1353:b003:l026","ordinal":179526,"en":"Straining like a lion,"},{"id":"semetey-1-2013:p1353:b003:l027","ordinal":179527,"en":"Your lion uncle Bakay"},{"id":"semetey-1-2013:p1353:b003:l028","ordinal":179528,"en":"Received wisdom from the unseen;"},{"id":"semetey-1-2013:p1353:b003:l029","ordinal":179529,"en":"Bakay made ready and reached"},{"id":"semetey-1-2013:p1353:b003:l030","ordinal":179530,"en":"The house of Jetigen."},{"id":"semetey-1-2013:p1353:b003:l031","ordinal":179531,"en":"Bakay brought"},{"id":"semetey-1-2013:p1353:b003:l032","ordinal":179532,"en":"All the weapons,"},{"id":"semetey-1-2013:p1353:b003:l033","ordinal":179533,"en":"And Bakay entered"},{"id":"semetey-1-2013:p1353:b003:l034","ordinal":179534,"en":"Semetey's palace."},{"id":"semetey-1-2013:p1353:b003:l035","ordinal":179535,"en":"The old man faced a hard journey;"},{"id":"semetey-1-2013:p1353:b003:l036","ordinal":179536,"en":"While alive his eyes were open;"},{"id":"semetey-1-2013:p1353:b003:l037","ordinal":179537,"en":"Death is shared, and speech is plain."},{"id":"semetey-1-2013:p1353:b003:l038","ordinal":179538,"en":"He found words in sudden need"},{"id":"semetey-1-2013:p1353:b003:l039","ordinal":179539,"en":"And found sight in darkness."},{"id":"semetey-1-2013:p1353:b005:l001","ordinal":179540,"en":"When he spoke harshly, none recognized him;"},{"id":"semetey-1-2013:p1353:b005:l002","ordinal":179541,"en":"In moonless darkness,"},{"id":"semetey-1-2013:p1353:b005:l003","ordinal":179542,"en":"He never lost the corsac's trail."},{"id":"semetey-1-2013:p1353:b005:l004","ordinal":179543,"en":"While exhausted Manas lived,"},{"id":"semetey-1-2013:p1353:b005:l005","ordinal":179544,"en":"When armies moved glittering by tens of thousands,"},{"id":"semetey-1-2013:p1353:b005:l006","ordinal":179545,"en":"Marching in their full multitude,"},{"id":"semetey-1-2013:p1353:b005:l007","ordinal":179546,"en":"Lion butcher Bakay"},{"id":"semetey-1-2013:p1353:b005:l008","ordinal":179547,"en":"Was leader of the moving host."},{"id":"semetey-1-2013:p1353:b005:l009","ordinal":179548,"en":"The old man who bore the banner"},{"id":"semetey-1-2013:p1353:b005:l010","ordinal":179549,"en":"Was the saint who served"},{"id":"semetey-1-2013:p1353:b005:l011","ordinal":179550,"en":"As butcher Oyrong Manas's standard."},{"id":"semetey-1-2013:p1353:b005:l012","ordinal":179551,"en":"Hearing that the hero's brave son"},{"id":"semetey-1-2013:p1353:b005:l013","ordinal":179552,"en":"Would gird his waist firmly"},{"id":"semetey-1-2013:p1353:b005:l014","ordinal":179553,"en":"And pursue the hero's blood price"},{"id":"semetey-1-2013:p1353:b005:l015","ordinal":179554,"en":"From the Kalmyks in Beijing,"},{"id":"semetey-1-2013:p1353:b005:l016","ordinal":179555,"en":"Poor Khan Bakay, your uncle,"},{"id":"semetey-1-2013:p1353:b005:l017","ordinal":179556,"en":"Put on his battle clothes."},{"id":"semetey-1-2013:p1353:b005:l018","ordinal":179557,"en":"He hung the golden-jawed battle-axe"},{"id":"semetey-1-2013:p1353:b005:l019","ordinal":179558,"en":"From his wrist,"},{"id":"semetey-1-2013:p1353:b005:l020","ordinal":179559,"en":"Put on his warrior's garments,"},{"id":"semetey-1-2013:p1353:b005:l021","ordinal":179560,"en":"And placed upon his head"},{"id":"semetey-1-2013:p1353:b005:l022","ordinal":179561,"en":"A helmet of blue steel."},{"id":"semetey-1-2013:p1353:b005:l023","ordinal":179562,"en":"As the sun began to shimmer upward,"},{"id":"semetey-1-2013:p1353:b005:l024","ordinal":179563,"en":"On the plain of broad Talas,"},{"id":"semetey-1-2013:p1353:b005:l025","ordinal":179564,"en":"Facing Üch-Koshoy,"},{"id":"semetey-1-2013:p1353:b005:l026","ordinal":179565,"en":"At the edge where the Talas flows,"},{"id":"semetey-1-2013:p1353:b005:l027","ordinal":179566,"en":"Below Tört-Kül,"},{"id":"semetey-1-2013:p1353:b005:l028","ordinal":179567,"en":"In the celebrated garden"},{"id":"semetey-1-2013:p1353:b005:l029","ordinal":179568,"en":"First planted by Manas,"},{"id":"semetey-1-2013:p1353:b005:l030","ordinal":179569,"en":"At the black eye of the spring,"},{"id":"semetey-1-2013:p1353:b005:l031","ordinal":179570,"en":"Beside the tall plane tree,"},{"id":"semetey-1-2013:p1353:b005:l032","ordinal":179571,"en":"Within the gated fortress,"},{"id":"semetey-1-2013:p1353:b005:l033","ordinal":179572,"en":"At Kanykey's palace,"},{"id":"semetey-1-2013:p1353:b005:l034","ordinal":179573,"en":"Were five guest palaces,"},{"id":"semetey-1-2013:p1353:b005:l035","ordinal":179574,"en":"Built exceedingly strong;"},{"id":"semetey-1-2013:p1353:b005:l036","ordinal":179575,"en":"Its guards were beyond number,"},{"id":"semetey-1-2013:p1353:b005:l037","ordinal":179576,"en":"And still more were its sentries."},{"id":"semetey-1-2013:p1353:b005:l038","ordinal":179577,"en":"When an enemy appeared,"},{"id":"semetey-1-2013:p1353:b005:l039","ordinal":179578,"en":"They closed it in an instant,"},{"id":"semetey-1-2013:p1354:b003:l001","ordinal":179579,"en":"So no one could approach and enter."},{"id":"semetey-1-2013:p1354:b003:l002","ordinal":179580,"en":"Seventy executioners,"},{"id":"semetey-1-2013:p1354:b003:l003","ordinal":179581,"en":"Who wore human noses and ears"},{"id":"semetey-1-2013:p1354:b003:l004","ordinal":179582,"en":"As amulets,"},{"id":"semetey-1-2013:p1354:b003:l005","ordinal":179583,"en":"Guarded it; your skillful uncle Bakay"},{"id":"semetey-1-2013:p1354:b003:l006","ordinal":179584,"en":"Reached and entered the palace."},{"id":"semetey-1-2013:p1354:b003:l007","ordinal":179585,"en":"The great gate in the wall"},{"id":"semetey-1-2013:p1354:b003:l008","ordinal":179586,"en":"Opened its broad mouth."},{"id":"semetey-1-2013:p1354:b003:l009","ordinal":179587,"en":"When exemplary Bakay arrived,"},{"id":"semetey-1-2013:p1354:b003:l010","ordinal":179588,"en":"Within that palace"},{"id":"semetey-1-2013:p1354:b003:l011","ordinal":179589,"en":"Apples and raisins were scattered,"},{"id":"semetey-1-2013:p1354:b003:l012","ordinal":179590,"en":"And his elder, old Bakay,"},{"id":"semetey-1-2013:p1354:b004:l001","ordinal":179591,"en":"Was taken toward the guest palace"},{"id":"semetey-1-2013:p1354:b004:l002","ordinal":179592,"en":"And received as a guest."},{"id":"semetey-1-2013:p1354:b004:l003","ordinal":179593,"en":"They slaughtered a colt and set out tea,"},{"id":"semetey-1-2013:p1354:b004:l004","ordinal":179594,"en":"And laid out the food in abundance,"},{"id":"semetey-1-2013:p1354:b004:l005","ordinal":179595,"en":"Heaping sugar like snow,"},{"id":"semetey-1-2013:p1354:b004:l006","ordinal":179596,"en":"And piling up yellow butter."},{"id":"semetey-1-2013:p1354:b004:l007","ordinal":179597,"en":"They boiled and served"},{"id":"semetey-1-2013:p1354:b004:l008","ordinal":179598,"en":"A fat lamb and a choice head."},{"id":"semetey-1-2013:p1354:b004:l009","ordinal":179599,"en":"When they had eaten their fill,"},{"id":"semetey-1-2013:p1354:b004:l010","ordinal":179600,"en":"His elder, old Bakay,"},{"id":"semetey-1-2013:p1354:b004:l011","ordinal":179601,"en":"Spread his hands and said, “Amen!”"},{"id":"semetey-1-2013:p1354:b004:l012","ordinal":179602,"en":"And gave a new blessing."},{"id":"semetey-1-2013:p1354:b006:l001","ordinal":179603,"en":"Your dear mother Kanykey,"},{"id":"semetey-1-2013:p1354:b006:l002","ordinal":179604,"en":"Her saintly nature showing,"},{"id":"semetey-1-2013:p1354:b006:l003","ordinal":179605,"en":"Wondered what fate awaited the youth"},{"id":"semetey-1-2013:p1354:b006:l004","ordinal":179606,"en":"Whom she had seen when near death;"},{"id":"semetey-1-2013:p1354:b006:l005","ordinal":179607,"en":"Her tears poured down:"},{"id":"semetey-1-2013:p1354:b006:l006","ordinal":179608,"en":"“To Beijing, whence those who go do not return,"},{"id":"semetey-1-2013:p1354:b006:l007","ordinal":179609,"en":"Elder, old Bakay,"},{"id":"semetey-1-2013:p1354:b006:l008","ordinal":179610,"en":"If you take the boy as your support"},{"id":"semetey-1-2013:p1354:b006:l009","ordinal":179611,"en":"And set out upon the road,"},{"id":"semetey-1-2013:p1354:b006:l010","ordinal":179612,"en":"Beijing is a place of calamity."},{"id":"semetey-1-2013:p1354:b006:l011","ordinal":179613,"en":"No one has bowed and conquered it;"},{"id":"semetey-1-2013:p1354:b006:l012","ordinal":179614,"en":"Whoever attacked it did not survive."},{"id":"semetey-1-2013:p1354:b006:l013","ordinal":179615,"en":"To Beijing, whence those who go do not return,"},{"id":"semetey-1-2013:p1354:b006:l014","ordinal":179616,"en":"Elder, old Bakay,"},{"id":"semetey-1-2013:p1354:b006:l015","ordinal":179617,"en":"If you set out upon the road,"},{"id":"semetey-1-2013:p1354:b006:l016","ordinal":179618,"en":"The one you fight is Kakan-Chyn,"},{"id":"semetey-1-2013:p1354:b006:l017","ordinal":179619,"en":"Who never retreats when attacked."},{"id":"semetey-1-2013:p1354:b006:l018","ordinal":179620,"en":"What people have inhabited Beijing?"},{"id":"semetey-1-2013:p1354:b006:l019","ordinal":179621,"en":"Those who faced it did not return safely."},{"id":"semetey-1-2013:p1354:b006:l020","ordinal":179622,"en":"To Beijing beyond a saint's reach,"},{"id":"semetey-1-2013:p1354:b006:l021","ordinal":179623,"en":"My dear uncle,"},{"id":"semetey-1-2013:p1354:b006:l022","ordinal":179624,"en":"It would be terrible if you let the fine horse stumble!"},{"id":"semetey-1-2013:p1354:b006:l023","ordinal":179625,"en":"My legacy left by the hero,"},{"id":"semetey-1-2013:p1354:b007:l001","ordinal":179626,"en":"My hope needed by the renowned people,"},{"id":"semetey-1-2013:p1354:b007:l002","ordinal":179627,"en":"My dear uncle,"},{"id":"semetey-1-2013:p1354:b007:l003","ordinal":179628,"en":"I entrust him to you!"},{"id":"semetey-1-2013:p1354:b007:l004","ordinal":179629,"en":"My youthful son left by the butcher,"},{"id":"semetey-1-2013:p1354:b007:l005","ordinal":179630,"en":"Royal uncle, I entrust him to you!"},{"id":"semetey-1-2013:p1354:b007:l006","ordinal":179631,"en":"Following your imposing figure,"},{"id":"semetey-1-2013:p1354:b007:l007","ordinal":179632,"en":"You have begun a campaign against the khan."},{"id":"semetey-1-2013:p1354:b007:l008","ordinal":179633,"en":"The small Argyn and Ogoy people,"},{"id":"semetey-1-2013:p1354:b007:l009","ordinal":179634,"en":"Elder, lion Bakay,"},{"id":"semetey-1-2013:p1354:b007:l010","ordinal":179635,"en":"You have again left without protection!"},{"id":"semetey-1-2013:p1354:b007:l011","ordinal":179636,"en":"To Beijing beyond even a holy man's reach,"},{"id":"semetey-1-2013:p1354:b007:l012","ordinal":179637,"en":"Uncle, it would be terrible if you lost him;"},{"id":"semetey-1-2013:p1354:b007:l013","ordinal":179638,"en":"My only one left by the magnanimous hero,"},{"id":"semetey-1-2013:p1354:b007:l014","ordinal":179639,"en":"Uncle, I entrust him to you!"},{"id":"semetey-1-2013:p1354:b007:l015","ordinal":179640,"en":"Return without letting him enter battle;"},{"id":"semetey-1-2013:p1354:b007:l016","ordinal":179641,"en":"Royal uncle Bakay, hear my words!"},{"id":"semetey-1-2013:p1354:b007:l017","ordinal":179642,"en":"Kakan-Chyn's Beijing"},{"id":"semetey-1-2013:p1354:b007:l018","ordinal":179643,"en":"Has a teeming people;"},{"id":"semetey-1-2013:p1354:b007:l019","ordinal":179644,"en":"They leave no attacker unharmed,"},{"id":"semetey-1-2013:p1354:b007:l020","ordinal":179645,"en":"And have a custom of drinking his blood."},{"id":"semetey-1-2013:p1354:b007:l021","ordinal":179646,"en":"It has roads unknown to man,"},{"id":"semetey-1-2013:p1354:b007:l022","ordinal":179647,"en":"And its strength reaches across the world;"},{"id":"semetey-1-2013:p1354:b007:l023","ordinal":179648,"en":"It has the renowned mighty Kongur."},{"id":"semetey-1-2013:p1355:b003:l001","ordinal":179649,"en":"Beijing is not an easy place."},{"id":"semetey-1-2013:p1355:b003:l002","ordinal":179650,"en":"Not the people who take the page!"},{"id":"semetey-1-2013:p1355:b003:l003","ordinal":179651,"en":"No one can bend down,"},{"id":"semetey-1-2013:p1355:b003:l004","ordinal":179652,"en":"Any non-survivor."},{"id":"semetey-1-2013:p1355:b003:l005","ordinal":179653,"en":"Bloody air, you know!"},{"id":"semetey-1-2013:p1355:b003:l006","ordinal":179654,"en":"The path of hardships is dead,"},{"id":"semetey-1-2013:p1355:b003:l007","ordinal":179655,"en":"Heroes died, khans died,"},{"id":"semetey-1-2013:p1355:b003:l008","ordinal":179656,"en":"Every soul is dead."},{"id":"semetey-1-2013:p1355:b003:l009","ordinal":179657,"en":"A long-hidden giant is dead,"},{"id":"semetey-1-2013:p1355:b003:l010","ordinal":179658,"en":"Caught and"},{"id":"semetey-1-2013:p1355:b003:l011","ordinal":179659,"en":"The tribes died in general."},{"id":"semetey-1-2013:p1355:b003:l012","ordinal":179660,"en":"I have a dream,"},{"id":"semetey-1-2013:p1355:b003:l013","ordinal":179661,"en":"White road air, listen!"},{"id":"semetey-1-2013:p1355:b003:l014","ordinal":179662,"en":"Big-Beijing, which was flooded"},{"id":"semetey-1-2013:p1355:b003:l015","ordinal":179663,"en":"Not a place to settle"},{"id":"semetey-1-2013:p1355:b003:l016","ordinal":179664,"en":"As many Chinese as ants"},{"id":"semetey-1-2013:p1355:b003:l017","ordinal":179665,"en":"They are not a people who give money."},{"id":"semetey-1-2013:p1355:b003:l018","ordinal":179666,"en":"Kakan black Chinese people,"},{"id":"semetey-1-2013:p1355:b003:l019","ordinal":179667,"en":"It is thick, there is no faith,"},{"id":"semetey-1-2013:p1355:b003:l020","ordinal":179668,"en":"I want to go to Beijing"},{"id":"semetey-1-2013:p1355:b003:l021","ordinal":179669,"en":"You started a baby"},{"id":"semetey-1-2013:p1355:b003: