[{"id":"manas-2010:p1813:b001:l041","ordinal":77825,"en":"If you do not know who he is:"},{"id":"manas-2010:p1813:b001:l042","ordinal":77826,"en":"The spring of the broad valley,"},{"id":"manas-2010:p1814:b001:l001","ordinal":77827,"en":"Your friend Kokboru's"},{"id":"manas-2010:p1814:b001:l002","ordinal":77828,"en":"Little Koyonaaly."},{"id":"manas-2010:p1814:b001:l003","ordinal":77829,"en":"Alas, Blood-Shedder, let go!” she said,"},{"id":"manas-2010:p1814:b001:l004","ordinal":77830,"en":"And pulled him away by the hand."},{"id":"manas-2010:p1814:b001:l005","ordinal":77831,"en":"“You wretched fierce one, you will come to no good!"},{"id":"manas-2010:p1814:b001:l006","ordinal":77832,"en":"Kanykei, rich in wisdom,"},{"id":"manas-2010:p1814:b001:l007","ordinal":77833,"en":"You never yield."},{"id":"manas-2010:p1814:b001:l008","ordinal":77834,"en":"This child will now fall in his prime."},{"id":"manas-2010:p1814:b001:l009","ordinal":77835,"en":"He will perish while still young;"},{"id":"manas-2010:p1814:b001:l010","ordinal":77836,"en":"He will not last seven days."},{"id":"manas-2010:p1814:b001:l011","ordinal":77837,"en":"Listen to my words:"},{"id":"manas-2010:p1814:b001:l012","ordinal":77838,"en":"We were friends into the next world."},{"id":"manas-2010:p1814:b001:l013","ordinal":77839,"en":"Little Koyonaaly—"},{"id":"manas-2010:p1814:b001:l014","ordinal":77840,"en":"Will you give him to me, Kokboru?"},{"id":"manas-2010:p1814:b001:l015","ordinal":77841,"en":"If you consent to give him,"},{"id":"manas-2010:p1814:b001:l016","ordinal":77842,"en":"My friend, let me tie him to my saddle-straps."},{"id":"manas-2010:p1814:b001:l017","ordinal":77843,"en":"Give him freely, without holding back;"},{"id":"manas-2010:p1814:b001:l018","ordinal":77844,"en":"Let me take my little light as a companion."},{"id":"manas-2010:p1814:b001:l019","ordinal":77845,"en":"Holding the only child in my hand,"},{"id":"manas-2010:p1814:b001:l020","ordinal":77846,"en":"Upon Judgment Day's narrow path,"},{"id":"manas-2010:p1814:b001:l021","ordinal":77847,"en":"Saying, ‘A gift received from my friend,’"},{"id":"manas-2010:p1814:b001:l022","ordinal":77848,"en":"Let me hold him as I go.”"},{"id":"manas-2010:p1814:b001:l023","ordinal":77849,"en":"“My friend, not only my child—take me!"},{"id":"manas-2010:p1814:b001:l024","ordinal":77850,"en":"My friend, pour my blood into a leather flask and take it."},{"id":"manas-2010:p1814:b001:l025","ordinal":77851,"en":"Not merely my child, dear friend:"},{"id":"manas-2010:p1814:b001:l026","ordinal":77852,"en":"If you need it, take my life!”"},{"id":"manas-2010:p1814:b001:l027","ordinal":77853,"en":"Setting forth for the other world,"},{"id":"manas-2010:p1814:b001:l028","ordinal":77854,"en":"There he passed away."},{"id":"manas-2010:p1814:b001:l029","ordinal":77855,"en":"The people wept, the khans wept,"},{"id":"manas-2010:p1814:b001:l030","ordinal":77856,"en":"Koshoi and Toshtuk wept as well,"},{"id":"manas-2010:p1814:b001:l031","ordinal":77857,"en":"Ajybai and old Bakai wept."},{"id":"manas-2010:p1814:b001:l032","ordinal":77858,"en":"Khan Manas's forty companions,"},{"id":"manas-2010:p1814:b001:l033","ordinal":77859,"en":"Planting their spears and shouting,"},{"id":"manas-2010:p1814:b001:l034","ordinal":77860,"en":"Crying, “My Greathearted One!”"},{"id":"manas-2010:p1814:b001:l035","ordinal":77861,"en":"Stood there in a row."},{"id":"manas-2010:p1814:b001:l036","ordinal":77862,"en":"Red willows grew in an enclosing ring;"},{"id":"manas-2010:p1814:b001:l037","ordinal":77863,"en":"Holy masters became his protectors."},{"id":"manas-2010:p1814:b001:l038","ordinal":77864,"en":"Today, there in Ken-Shor,"},{"id":"manas-2010:p1814:b001:l039","ordinal":77865,"en":"That precious woman Kanykei,"},{"id":"manas-2010:p1814:b001:l040","ordinal":77866,"en":"Her precious hair untouched by a comb,"},{"id":"manas-2010:p1814:b001:l041","ordinal":77867,"en":"Seized it by the strands and tore it out."},{"id":"manas-2010:p1814:b001:l042","ordinal":77868,"en":"Then strand upon strand became forests of willows."},{"id":"manas-2010:p1815:b001:l001","ordinal":77869,"en":"To the precious lion, famed throughout the world,"},{"id":"manas-2010:p1815:b001:l002","ordinal":77870,"en":"The Creator himself became a protector."},{"id":"manas-2010:p1815:b001:l003","ordinal":77871,"en":"The dark blood flowing from her face"},{"id":"manas-2010:p1815:b001:l004","ordinal":77872,"en":"Became red stones ankle-deep."},{"id":"manas-2010:p1815:b001:l005","ordinal":77873,"en":"The bloody tears flowing from her eyes"},{"id":"manas-2010:p1815:b001:l006","ordinal":77874,"en":"Became a river of spring-water."},{"id":"manas-2010:p1815:b001:l007","ordinal":77875,"en":"For six days the moon did not rise;"},{"id":"manas-2010:p1815:b001:l008","ordinal":77876,"en":"Oh, alas, the nights were moonless and dark."},{"id":"manas-2010:p1815:b001:l009","ordinal":77877,"en":"Then flat-humped Karanar,"},{"id":"manas-2010:p1815:b001:l010","ordinal":77878,"en":"From the city of Lower Mecca,"},{"id":"manas-2010:p1815:b001:l011","ordinal":77879,"en":"Was a beast the leopard had brought."},{"id":"manas-2010:p1815:b001:l012","ordinal":77880,"en":"No wind could catch its trot,"},{"id":"manas-2010:p1815:b001:l013","ordinal":77881,"en":"No beast could match its walk."},{"id":"manas-2010:p1815:b001:l014","ordinal":77882,"en":"Apart from being called a camel,"},{"id":"manas-2010:p1815:b001:l015","ordinal":77883,"en":"It was a creature of sacred power."},{"id":"manas-2010:p1815:b001:l016","ordinal":77884,"en":"The bulletproof mail,"},{"id":"manas-2010:p1815:b001:l017","ordinal":77885,"en":"Zhelmaian carried folded;"},{"id":"manas-2010:p1815:b001:l018","ordinal":77886,"en":"All the bullets and powder,"},{"id":"manas-2010:p1815:b001:l019","ordinal":77887,"en":"Zhelmaian carried as a load."},{"id":"manas-2010:p1815:b001:l020","ordinal":77888,"en":"Never brushing a birch's crown,"},{"id":"manas-2010:p1815:b001:l021","ordinal":77889,"en":"Flat-humped Karanar"},{"id":"manas-2010:p1815:b001:l022","ordinal":77890,"en":"Never lagged behind on campaign."},{"id":"manas-2010:p1815:b001:l023","ordinal":77891,"en":"Beside the wall where Manas lay,"},{"id":"manas-2010:p1815:b001:l024","ordinal":77892,"en":"Zhelmaian knelt down."},{"id":"manas-2010:p1815:b001:l025","ordinal":77893,"en":"Tears streamed in ten channels;"},{"id":"manas-2010:p1815:b001:l026","ordinal":77894,"en":"Zhelmaian shed them all."},{"id":"manas-2010:p1815:b001:l027","ordinal":77895,"en":"On the nearer side of it,"},{"id":"manas-2010:p1815:b001:l028","ordinal":77896,"en":"From the ridge of Kum-Bulak,"},{"id":"manas-2010:p1815:b001:l029","ordinal":77897,"en":"At the place where he performed ablution,"},{"id":"manas-2010:p1815:b001:l030","ordinal":77898,"en":"He had found Kumaiyk."},{"id":"manas-2010:p1815:b001:l031","ordinal":77899,"en":"Its ravenous mouth toward the sky,"},{"id":"manas-2010:p1815:b001:l032","ordinal":77900,"en":"Kumaiyk opened wide."},{"id":"manas-2010:p1815:b001:l033","ordinal":77901,"en":"Moaning more than a human,"},{"id":"manas-2010:p1815:b001:l034","ordinal":77902,"en":"At Manas's feet"},{"id":"manas-2010:p1815:b001:l035","ordinal":77903,"en":"Kumaiyk lay down."},{"id":"manas-2010:p1815:b001:l036","ordinal":77904,"en":"Not tasting food when offered,"},{"id":"manas-2010:p1815:b001:l037","ordinal":77905,"en":"Though Kumaiyk was a beast,"},{"id":"manas-2010:p1815:b001:l038","ordinal":77906,"en":"Never stilling its wailing voice,"},{"id":"manas-2010:p1815:b001:l039","ordinal":77907,"en":"For many days tasting nothing,"},{"id":"manas-2010:p1815:b001:l040","ordinal":77908,"en":"Kumaiyk wasted away."},{"id":"manas-2010:p1815:b001:l041","ordinal":77909,"en":"Moaning, never leaving the side-wall,"},{"id":"manas-2010:p1815:b001:l042","ordinal":77910,"en":"Kumaiyk howled."},{"id":"manas-2010:p1816:b001:l001","ordinal":77911,"en":"Khan Manas's White Falcon,"},{"id":"manas-2010:p1816:b001:l002","ordinal":77912,"en":"Wheeling and fluttering,"},{"id":"manas-2010:p1816:b001:l003","ordinal":77913,"en":"Flying backward, leaning back,"},{"id":"manas-2010:p1816:b001:l004","ordinal":77914,"en":"All the foul-smelling meat"},{"id":"manas-2010:p1816:b001:l005","ordinal":77915,"en":"The White Falcon scattered."},{"id":"manas-2010:p1816:b001:l006","ordinal":77916,"en":"Vanishing from sight,"},{"id":"manas-2010:p1816:b001:l007","ordinal":77917,"en":"The White Falcon flew away."},{"id":"manas-2010:p1816:b001:l008","ordinal":77918,"en":"Its short golden jesses"},{"id":"manas-2010:p1816:b001:l009","ordinal":77919,"en":"The White Falcon tore apart."},{"id":"manas-2010:p1816:b001:l010","ordinal":77920,"en":"Soaring toward the sky,"},{"id":"manas-2010:p1816:b001:l011","ordinal":77921,"en":"The White Falcon sped away."},{"id":"manas-2010:p1816:b001:l012","ordinal":77922,"en":"Arbuudan, newly come to maturity—"},{"id":"manas-2010:p1816:b001:l013","ordinal":77923,"en":"When sovereign Manas died,"},{"id":"manas-2010:p1816:b001:l014","ordinal":77924,"en":"Tied up, it would not stay still;"},{"id":"manas-2010:p1816:b001:l015","ordinal":77925,"en":"Turned loose, it would not graze."},{"id":"manas-2010:p1816:b001:l016","ordinal":77926,"en":"Though the creature was a beast,"},{"id":"manas-2010:p1816:b001:l017","ordinal":77927,"en":"It had taken up mourning."},{"id":"manas-2010:p1816:b001:l018","ordinal":77928,"en":"Then precious Kanykei,"},{"id":"manas-2010:p1816:b001:l019","ordinal":77929,"en":"Her bloody face torn,"},{"id":"manas-2010:p1816:b001:l020","ordinal":77930,"en":"Her black hair loose,"},{"id":"manas-2010:p1816:b001:l021","ordinal":77931,"en":"Upon her looming dark head,"},{"id":"manas-2010:p1816:b001:l022","ordinal":77932,"en":"Bereft of her Blood-Shedder"},{"id":"manas-2010:p1816:b001:l023","ordinal":77933,"en":"At thirty-two years old:"},{"id":"manas-2010:p1816:b001:l024","ordinal":77934,"en":"“Six san of horses on the hills,"},{"id":"manas-2010:p1816:b001:l025","ordinal":77935,"en":"Thoroughbreds and swift steeds mingled."},{"id":"manas-2010:p1816:b001:l026","ordinal":77936,"en":"To know how to govern his own people,"},{"id":"manas-2010:p1816:b001:l027","ordinal":77937,"en":"Your son left behind is still too young."},{"id":"manas-2010:p1816:b001:l028","ordinal":77938,"en":"Your horses in the mountains have piebald heads,"},{"id":"manas-2010:p1816:b001:l029","ordinal":77939,"en":"Toburchak steeds and swift horses mingled;"},{"id":"manas-2010:p1816:b001:l030","ordinal":77940,"en":"The child who would gather them is young."},{"id":"manas-2010:p1816:b001:l031","ordinal":77941,"en":"Without casting my soul into hell,"},{"id":"manas-2010:p1816:b001:l032","ordinal":77942,"en":"My mountain, blue-maned one, take me along!"},{"id":"manas-2010:p1816:b001:l033","ordinal":77943,"en":"My dresses of every kind—"},{"id":"manas-2010:p1816:b001:l034","ordinal":77944,"en":"When I pull them up, they do not reach my neck."},{"id":"manas-2010:p1816:b001:l035","ordinal":77945,"en":"Without exhausting me, my sultan,"},{"id":"manas-2010:p1816:b001:l036","ordinal":77946,"en":"Draw me into your embrace and take me!"},{"id":"manas-2010:p1816:b001:l037","ordinal":77947,"en":"We joined when small as thumbs;"},{"id":"manas-2010:p1816:b001:l038","ordinal":77948,"en":"My sultan, we united when tiny as lice."},{"id":"manas-2010:p1816:b001:l039","ordinal":77949,"en":"You are the one gone to the other world;"},{"id":"manas-2010:p1816:b001:l040","ordinal":77950,"en":"I am the one left to suffer."},{"id":"manas-2010:p1816:b001:l041","ordinal":77951,"en":"That black-cheeked battle-axe of yours—"},{"id":"manas-2010:p1816:b001:l042","ordinal":77952,"en":"Who will fit its haft without making it crooked?"},{"id":"manas-2010:p1817:b001:l001","ordinal":77953,"en":"Never satisfied with what they demand and consume,"},{"id":"manas-2010:p1817:b001:l002","ordinal":77954,"en":"Never abandoning their greed,"},{"id":"manas-2010:p1817:b001:l003","ordinal":77955,"en":"Your Argyn and Kyrgyz people—"},{"id":"manas-2010:p1817:b001:l004","ordinal":77956,"en":"Who will lead them without turmoil?"},{"id":"manas-2010:p1817:b001:l005","ordinal":77957,"en":"The peerless winged steed has a piebald head;"},{"id":"manas-2010:p1817:b001:l006","ordinal":77958,"en":"All your brothers are enemies."},{"id":"manas-2010:p1817:b001:l007","ordinal":77959,"en":"Without making me bear this torment,"},{"id":"manas-2010:p1817:b001:l008","ordinal":77960,"en":"My greathearted sultan, take me along!"},{"id":"manas-2010:p1817:b001:l009","ordinal":77961,"en":"Leopard, journeying to the other world,"},{"id":"manas-2010:p1817:b001:l010","ordinal":77962,"en":"You have torn my thoughts apart."},{"id":"manas-2010:p1817:b001:l011","ordinal":77963,"en":"To whom have you entrusted"},{"id":"manas-2010:p1817:b001:l012","ordinal":77964,"en":"Your six-month-old son left behind?”"},{"id":"manas-2010:p1817:b001:l013","ordinal":77965,"en":"As she stood weeping thus,"},{"id":"manas-2010:p1817:b001:l014","ordinal":77966,"en":"When your precious lord had died,"},{"id":"manas-2010:p1817:b001:l015","ordinal":77967,"en":"When your great people faced disaster,"},{"id":"manas-2010:p1817:b001:l016","ordinal":77968,"en":"Abyke and Kobosh among them,"},{"id":"manas-2010:p1817:b001:l017","ordinal":77969,"en":"The six scoundrels descended from the hills."},{"id":"manas-2010:p1817:b001:l018","ordinal":77970,"en":"It was mostly amusement, not mourning."},{"id":"manas-2010:p1817:b001:l019","ordinal":77971,"en":"“Ah, the dear departed!” people cried"},{"id":"manas-2010:p1817:b001:l020","ordinal":77972,"en":"Here and there."},{"id":"manas-2010:p1817:b001:l021","ordinal":77973,"en":"The six scoundrels came making noise,"},{"id":"manas-2010:p1817:b001:l022","ordinal":77974,"en":"Their reach extending through the world."},{"id":"manas-2010:p1817:b001:l023","ordinal":77975,"en":"Sharing a father with Manas,"},{"id":"manas-2010:p1817:b001:l024","ordinal":77976,"en":"The six scoundrels were the younger wife's sons."},{"id":"manas-2010:p1817:b001:l025","ordinal":77977,"en":"Abyke and Kobosh, two scoundrels,"},{"id":"manas-2010:p1817:b001:l026","ordinal":77978,"en":"Chiybyt and Kochkor, making four,"},{"id":"manas-2010:p1817:b001:l027","ordinal":77979,"en":"Ajybai and Kolbai, making six."},{"id":"manas-2010:p1817:b001:l028","ordinal":77980,"en":"Moaning here and there,"},{"id":"manas-2010:p1817:b001:l029","ordinal":77981,"en":"“Ah, the dear departed!”"},{"id":"manas-2010:p1817:b001:l030","ordinal":77982,"en":"The six scoundrels let out booming wails."},{"id":"manas-2010:p1817:b001:l031","ordinal":77983,"en":"Seeing these scoundrels,"},{"id":"manas-2010:p1817:b001:l032","ordinal":77984,"en":"Your precious sister-in-law Kanykei thought:"},{"id":"manas-2010:p1817:b001:l033","ordinal":77985,"en":"“These six crooked scoundrels"},{"id":"manas-2010:p1817:b001:l034","ordinal":77986,"en":"Will descend upon my head and crush me."},{"id":"manas-2010:p1817:b001:l035","ordinal":77987,"en":"Without letting my lord's body be buried,"},{"id":"manas-2010:p1817:b001:l036","ordinal":77988,"en":"They will plunder my goods."},{"id":"manas-2010:p1817:b001:l037","ordinal":77989,"en":"The six scoundrels will wreak havoc now.”"},{"id":"manas-2010:p1817:b001:l038","ordinal":77990,"en":"Unable to find a way,"},{"id":"manas-2010:p1817:b001:l039","ordinal":77991,"en":"Your noble sister-in-law Kanykei,"},{"id":"manas-2010:p1817:b001:l040","ordinal":77992,"en":"Dark blood streaming from her face,"},{"id":"manas-2010:p1817:b001:l041","ordinal":77993,"en":"With little cradle-child Semetey"},{"id":"manas-2010:p1817:b001:l042","ordinal":77994,"en":"Pressed beneath her arm for safekeeping,"},{"id":"manas-2010:p1818:b001:l001","ordinal":77995,"en":"Came out before the six scoundrels."},{"id":"manas-2010:p1818:b001:l002","ordinal":77996,"en":"Abyke was a man born kindhearted;"},{"id":"manas-2010:p1818:b001:l003","ordinal":77997,"en":"Kobosh was deeply malicious."},{"id":"manas-2010:p1818:b001:l004","ordinal":77998,"en":"Your precious sister-in-law Kanykei"},{"id":"manas-2010:p1818:b001:l005","ordinal":77999,"en":"Bustled about them,"},{"id":"manas-2010:p1818:b001:l006","ordinal":78000,"en":"Calling, “Sons!”"},{"id":"manas-2010:p1818:b001:l007","ordinal":78001,"en":"Pleading with the six scoundrels."},{"id":"manas-2010:p1818:b001:l008","ordinal":78002,"en":"“The support you relied upon"},{"id":"manas-2010:p1818:b001:l009","ordinal":78003,"en":"Is gone, my son."},{"id":"manas-2010:p1818:b001:l010","ordinal":78004,"en":"Your mighty lion on the heights is gone, my son."},{"id":"manas-2010:p1818:b001:l011","ordinal":78005,"en":"‘When renowned Manas died,"},{"id":"manas-2010:p1818:b001:l012","ordinal":78006,"en":"Those left settled along the heights."},{"id":"manas-2010:p1818:b001:l013","ordinal":78007,"en":"When the khan died, all died;"},{"id":"manas-2010:p1818:b001:l014","ordinal":78008,"en":"They became like an extinguished fire,’ they will say."},{"id":"manas-2010:p1818:b001:l015","ordinal":78009,"en":"My son, do not become like an extinguished fire."},{"id":"manas-2010:p1818:b001:l016","ordinal":78010,"en":"Let those hostile enemies"},{"id":"manas-2010:p1818:b001:l017","ordinal":78011,"en":"Not trample upon your heads,"},{"id":"manas-2010:p1818:b001:l018","ordinal":78012,"en":"Not scatter the four kinds of livestock."},{"id":"manas-2010:p1818:b001:l019","ordinal":78013,"en":"Raiding your mares,"},{"id":"manas-2010:p1818:b001:l020","ordinal":78014,"en":"Let them not slaughter"},{"id":"manas-2010:p1818:b001:l021","ordinal":78015,"en":"The mighty men who have come to this funeral."},{"id":"manas-2010:p1818:b001:l022","ordinal":78016,"en":"Those who answer back—"},{"id":"manas-2010:p1818:b001:l023","ordinal":78017,"en":"Let them not seize and beat them."},{"id":"manas-2010:p1818:b001:l024","ordinal":78018,"en":"Among the Argyn and Kyrgyz in Talas,"},{"id":"manas-2010:p1818:b001:l025","ordinal":78019,"en":"Let them not plunder the khan's estate!”"},{"id":"manas-2010:p1818:b001:l026","ordinal":78020,"en":"As Kanykei stood weeping,"},{"id":"manas-2010:p1818:b001:l027","ordinal":78021,"en":"Kindhearted Abyke"},{"id":"manas-2010:p1818:b001:l028","ordinal":78022,"en":"Yielded readily to her words."},{"id":"manas-2010:p1818:b001:l029","ordinal":78023,"en":"To the Argyn and Kyrgyz"},{"id":"manas-2010:p1818:b001:l030","ordinal":78024,"en":"He called out to receive the guests."},{"id":"manas-2010:p1818:b001:l031","ordinal":78025,"en":"God's decree—"},{"id":"manas-2010:p1818:b001:l032","ordinal":78026,"en":"They accepted that it had ordained this,"},{"id":"manas-2010:p1818:b001:l033","ordinal":78027,"en":"Among the Argyn and Kyrgyz"},{"id":"manas-2010:p1818:b001:l034","ordinal":78028,"en":"They distributed the arriving guests,"},{"id":"manas-2010:p1818:b001:l035","ordinal":78029,"en":"Assigning every last one among the households."},{"id":"manas-2010:p1818:b001:l036","ordinal":78030,"en":"To each of the various khans,"},{"id":"manas-2010:p1818:b001:l037","ordinal":78031,"en":"Eighty camel-loads of firewood"},{"id":"manas-2010:p1818:b001:l038","ordinal":78032,"en":"He gave for their fires."},{"id":"manas-2010:p1818:b001:l039","ordinal":78033,"en":"Eighty wethers and eighty mares"},{"id":"manas-2010:p1818:b001:l040","ordinal":78034,"en":"He gave for slaughter."},{"id":"manas-2010:p1818:b001:l041","ordinal":78035,"en":"Sugar like a reclining camel or a cow"},{"id":"manas-2010:p1818:b001:l042","ordinal":78036,"en":"He gave them to break apart."},{"id":"manas-2010:p1819:b001:l001","ordinal":78037,"en":"Assigning guests to each household,"},{"id":"manas-2010:p1819:b001:l002","ordinal":78038,"en":"For six days the six scoundrels,"},{"id":"manas-2010:p1819:b001:l003","ordinal":78039,"en":"Attending to nothing else,"},{"id":"manas-2010:p1819:b001:l004","ordinal":78040,"en":"Distributed the guests."},{"id":"manas-2010:p1819:b001:l005","ordinal":78041,"en":"As the sun slowly sank,"},{"id":"manas-2010:p1819:b001:l006","ordinal":78042,"en":"When the first of the people lay down,"},{"id":"manas-2010:p1819:b001:l007","ordinal":78043,"en":"Precious Kanykei"},{"id":"manas-2010:p1819:b001:l008","ordinal":78044,"en":"Went weeping to Koshoi."},{"id":"manas-2010:p1819:b001:l009","ordinal":78045,"en":"Her ribs seeming to come apart,"},{"id":"manas-2010:p1819:b001:l010","ordinal":78046,"en":"Her tears pouring down:"},{"id":"manas-2010:p1819:b001:l011","ordinal":78047,"en":"“Of paradise where no weariness dwells,"},{"id":"manas-2010:p1819:b001:l012","ordinal":78048,"en":"My heroic elder, you opened the gate."},{"id":"manas-2010:p1819:b001:l013","ordinal":78049,"en":"Of the gathered unbelievers,"},{"id":"manas-2010:p1819:b001:l014","ordinal":78050,"en":"My lion-elder, you shattered the city."},{"id":"manas-2010:p1819:b001:l015","ordinal":78051,"en":"Spear in hand, you broke the ranks,"},{"id":"manas-2010:p1819:b001:l016","ordinal":78052,"en":"My heroic elder, khan of the world."},{"id":"manas-2010:p1819:b001:l017","ordinal":78053,"en":"I am a hapless woman;"},{"id":"manas-2010:p1819:b001:l018","ordinal":78054,"en":"You are the sovereign, Khan Koshoi."},{"id":"manas-2010:p1819:b001:l019","ordinal":78055,"en":"I have broken apart—join me together!"},{"id":"manas-2010:p1819:b001:l020","ordinal":78056,"en":"Dear elder, I have scattered—gather me!"},{"id":"manas-2010:p1819:b001:l021","ordinal":78057,"en":"Kindle my extinguished fire;"},{"id":"manas-2010:p1819:b001:l022","ordinal":78058,"en":"Dear elder, revive my dead soul."},{"id":"manas-2010:p1819:b001:l023","ordinal":78059,"en":"Your younger brother, greathearted Manas,"},{"id":"manas-2010:p1819:b001:l024","ordinal":78060,"en":"The youngest of six lions,"},{"id":"manas-2010:p1819:b001:l025","ordinal":78061,"en":"God's beloved servant—"},{"id":"manas-2010:p1819:b001:l026","ordinal":78062,"en":"Of fortified Mecca,"},{"id":"manas-2010:p1819:b001:l027","ordinal":78063,"en":"Was not the blue-maned one the backbone?"},{"id":"manas-2010:p1819:b001:l028","ordinal":78064,"en":"Of the faith of Islam that relied upon him,"},{"id":"manas-2010:p1819:b001:l029","ordinal":78065,"en":"Was not the blue-maned one the lion?"},{"id":"manas-2010:p1819:b001:l030","ordinal":78066,"en":"He set fire to grassy land,"},{"id":"manas-2010:p1819:b001:l031","ordinal":78067,"en":"Poured blood into the spring-water,"},{"id":"manas-2010:p1819:b001:l032","ordinal":78068,"en":"Entered bloodshed and grew hardened,"},{"id":"manas-2010:p1819:b001:l033","ordinal":78069,"en":"Won the name Manas the Leopard."},{"id":"manas-2010:p1819:b001:l034","ordinal":78070,"en":"There are those his hand has struck;"},{"id":"manas-2010:p1819:b001:l035","ordinal":78071,"en":"There are places he has humiliated."},{"id":"manas-2010:p1819:b001:l036","ordinal":78072,"en":"If we bury the greathearted one openly,"},{"id":"manas-2010:p1819:b001:l037","ordinal":78073,"en":"Or lay Manas where he can be seen,"},{"id":"manas-2010:p1819:b001:l038","ordinal":78074,"en":"Let them not open his grave,"},{"id":"manas-2010:p1819:b001:l039","ordinal":78075,"en":"Drag him onto the road,"},{"id":"manas-2010:p1819:b001:l040","ordinal":78076,"en":"Seeking vengeance upon the dead,"},{"id":"manas-2010:p1819:b001:l041","ordinal":78077,"en":"And cast him to the dogs."},{"id":"manas-2010:p1819:b001:l042","ordinal":78078,"en":"What course shall we take?"},{"id":"manas-2010:p1820:b001:l001","ordinal":78079,"en":"What means shall we find now?"},{"id":"manas-2010:p1820:b001:l002","ordinal":78080,"en":"When the moon grows dark,"}]
