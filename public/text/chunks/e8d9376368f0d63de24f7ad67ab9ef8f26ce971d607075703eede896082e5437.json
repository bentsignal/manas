[{"id":"sayakbay-ms-current146:pdf093:l024","ordinal":390913,"en":"Every proper remedy will be exhausted,"},{"id":"sayakbay-ms-current146:pdf093:l025","ordinal":390914,"en":"The people will be slaughtered and scattered,"},{"id":"sayakbay-ms-current146:pdf093:l026","ordinal":390915,"en":"Across the ridges, alas,"},{"id":"sayakbay-ms-current146:pdf093:l027","ordinal":390916,"en":"Let him not expose them to ruin."},{"id":"sayakbay-ms-current146:pdf093:l028","ordinal":390917,"en":"Women and young children alike,"},{"id":"sayakbay-ms-current146:pdf093:l029","ordinal":390918,"en":"Great and small, old and young,"},{"id":"sayakbay-ms-current146:pdf093:l030","ordinal":390919,"en":"Women and men together,"},{"id":"sayakbay-ms-current146:pdf093:l031","ordinal":390920,"en":"Their land and resolve will be conquered,"},{"id":"sayakbay-ms-current146:pdf093:l032","ordinal":390921,"en":"They met with Jetpes,"},{"id":"sayakbay-ms-current146:pdf093:l033","ordinal":390922,"en":"Let no blood-guilt remain upon them."},{"id":"sayakbay-ms-current146:pdf093:l034","ordinal":390923,"en":"Let every girded man return without exception,"},{"id":"sayakbay-ms-current146:pdf093:l035","ordinal":390924,"en":"Bring back the message itself,"},{"id":"sayakbay-ms-current146:pdf093:l036","ordinal":390925,"en":"O sons of the white-kalpak Kyrgyz,"}]
