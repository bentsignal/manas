[{"id":"semetey-1-2013:p1292:b004:l013","ordinal":174849,"en":"I hear that you are my kinsman,"},{"id":"semetey-1-2013:p1292:b004:l014","ordinal":174850,"en":"Accursed Semetey;"},{"id":"semetey-1-2013:p1292:b004:l015","ordinal":174851,"en":"I shall kill and bury you,"},{"id":"semetey-1-2013:p1292:b004:l016","ordinal":174852,"en":"And seize your slaves!\""},{"id":"semetey-1-2013:p1292:b004:l017","ordinal":174853,"en":"The earth split with a roar;"},{"id":"semetey-1-2013:p1292:b004:l018","ordinal":174854,"en":"Kojo raged and thundered."},{"id":"semetey-1-2013:p1292:b004:l019","ordinal":174855,"en":"God now struck Kojo,"},{"id":"semetey-1-2013:p1292:b004:l020","ordinal":174856,"en":"And he spoke words of great humiliation."},{"id":"semetey-1-2013:p1292:b004:l021","ordinal":174857,"en":"He stood bald and stark,"},{"id":"semetey-1-2013:p1292:b004:l022","ordinal":174858,"en":"Like a post for tethering horses;"},{"id":"semetey-1-2013:p1292:b004:l023","ordinal":174859,"en":"This Kojo had abandoned the faith"},{"id":"semetey-1-2013:p1292:b004:l024","ordinal":174860,"en":"And become an infidel."},{"id":"semetey-1-2013:p1292:b004:l025","ordinal":174861,"en":"He began a grievous humiliation,"},{"id":"semetey-1-2013:p1292:b004:l026","ordinal":174862,"en":"And was capable of carrying it through;"},{"id":"semetey-1-2013:p1292:b004:l027","ordinal":174863,"en":"Plainly, Kojo was capable"},{"id":"semetey-1-2013:p1292:b004:l028","ordinal":174864,"en":"Of inflicting everlasting humiliation"},{"id":"semetey-1-2013:p1292:b004:l029","ordinal":174865,"en":"Upon the valiant hero."},{"id":"semetey-1-2013:p1292:b004:l030","ordinal":174866,"en":"If Kojo got into his hands"},{"id":"semetey-1-2013:p1292:b004:l031","ordinal":174867,"en":"The orphaned son of Manas,"},{"id":"semetey-1-2013:p1292:b004:l032","ordinal":174868,"en":"He was capable of slaughtering him"},{"id":"semetey-1-2013:p1292:b004:l033","ordinal":174869,"en":"As a sacrifice without hesitation."},{"id":"semetey-1-2013:p1292:b004:l034","ordinal":174870,"en":"He left no honest soul in peace;"},{"id":"semetey-1-2013:p1292:b004:l035","ordinal":174871,"en":"Kojo the kinsman came to no good."},{"id":"semetey-1-2013:p1292:b004:l036","ordinal":174872,"en":"Dear Kojo the kinsman"},{"id":"semetey-1-2013:p1292:b004:l037","ordinal":174873,"en":"Had crookedness in his words"},{"id":"semetey-1-2013:p1292:b004:l038","ordinal":174874,"en":"And cloudiness in his eyes;"},{"id":"semetey-1-2013:p1292:b004:l039","ordinal":174875,"en":"If your uncle Kojo found the strength,"},{"id":"semetey-1-2013:p1293:b003:l001","ordinal":174876,"en":"He was about to strike me down."},{"id":"semetey-1-2013:p1293:b003:l002","ordinal":174877,"en":"There was malice in his words,"},{"id":"semetey-1-2013:p1293:b003:l003","ordinal":174878,"en":"Crookedness in his eyes;"},{"id":"semetey-1-2013:p1293:b003:l004","ordinal":174879,"en":"If I came within his reach,"},{"id":"semetey-1-2013:p1293:b003:l005","ordinal":174880,"en":"He intended to do me harm."},{"id":"semetey-1-2013:p1293:b003:l006","ordinal":174881,"en":"No iron is keen unless it is tempered,"},{"id":"semetey-1-2013:p1293:b003:l007","ordinal":174882,"en":"No accursed people thrive unless raised apart;"},{"id":"semetey-1-2013:p1293:b003:l008","ordinal":174883,"en":"No iron is keen unless it is forged,"},{"id":"semetey-1-2013:p1293:b003:l009","ordinal":174884,"en":"No people are like raging Khojo’s."},{"id":"semetey-1-2013:p1293:b003:l010","ordinal":174885,"en":"An uproar arose ahead;"},{"id":"semetey-1-2013:p1293:b003:l011","ordinal":174886,"en":"That Khojo, not knowing what he said,"},{"id":"semetey-1-2013:p1293:b003:l012","ordinal":174887,"en":"Prepared as though to seize him."},{"id":"semetey-1-2013:p1293:b003:l013","ordinal":174888,"en":"Whipping his black horse,"},{"id":"semetey-1-2013:p1293:b003:l014","ordinal":174889,"en":"Roaring in fury,"},{"id":"semetey-1-2013:p1293:b003:l015","ordinal":174890,"en":"Khojo came then,"},{"id":"semetey-1-2013:p1293:b003:l016","ordinal":174891,"en":"Shouting the battle cry “Shygai!”"},{"id":"semetey-1-2013:p1293:b003:l017","ordinal":174892,"en":"Furiously he thundered;"},{"id":"semetey-1-2013:p1293:b003:l018","ordinal":174893,"en":"At Khojo’s terrible aspect,"},{"id":"semetey-1-2013:p1293:b003:l019","ordinal":174894,"en":"The whole free body"},{"id":"semetey-1-2013:p1293:b003:l020","ordinal":174895,"en":"Of anyone watching shuddered."},{"id":"semetey-1-2013:p1293:b003:l021","ordinal":174896,"en":"Semetey stood without concern:"},{"id":"semetey-1-2013:p1293:b003:l022","ordinal":174897,"en":"“Chynkojo was my kinsman—"},{"id":"semetey-1-2013:p1293:b003:l023","ordinal":174898,"en":"Let him level his spear straight at me;"},{"id":"semetey-1-2013:p1293:b003:l024","ordinal":174899,"en":"If he truly has a grievance,"},{"id":"semetey-1-2013:p1293:b003:l025","ordinal":174900,"en":"Let him thrust and strike!"},{"id":"semetey-1-2013:p1293:b003:l026","ordinal":174901,"en":"Let him unleash his full wrath;"},{"id":"semetey-1-2013:p1293:b003:l027","ordinal":174902,"en":"I shall stand and grant his turn,"},{"id":"semetey-1-2013:p1293:b003:l028","ordinal":174903,"en":"And let him avenge whatever ancient wrong he bears."},{"id":"semetey-1-2013:p1293:b003:l029","ordinal":174904,"en":"Let him level his spear and strike me,"},{"id":"semetey-1-2013:p1293:b003:l030","ordinal":174905,"en":"Truly inflicting open humiliation;"},{"id":"semetey-1-2013:p1293:b003:l031","ordinal":174906,"en":"Will he not then look upon Buudan?"},{"id":"semetey-1-2013:p1293:b003:l032","ordinal":174907,"en":"If I do not strike back,"},{"id":"semetey-1-2013:p1293:b003:l033","ordinal":174908,"en":"Will he not regard me as kin?”"},{"id":"semetey-1-2013:p1293:b003:l034","ordinal":174909,"en":"Without flinching, Semetey"},{"id":"semetey-1-2013:p1293:b003:l035","ordinal":174910,"en":"Now stood looking ahead."},{"id":"semetey-1-2013:p1293:b003:l036","ordinal":174911,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1293:b003:l037","ordinal":174912,"en":"Tensed and thrust his spear."},{"id":"semetey-1-2013:p1293:b003:l038","ordinal":174913,"en":"In fury Chynkojo"},{"id":"semetey-1-2013:p1293:b003:l039","ordinal":174914,"en":"Charged and drove the spear."},{"id":"semetey-1-2013:p1293:b004:l001","ordinal":174915,"en":"His waist bent far backward,"},{"id":"semetey-1-2013:p1293:b004:l002","ordinal":174916,"en":"His eyes bulged out,"},{"id":"semetey-1-2013:p1293:b004:l003","ordinal":174917,"en":"His beard bristled strand by strand;"},{"id":"semetey-1-2013:p1293:b004:l004","ordinal":174918,"en":"Roaring in anger,"},{"id":"semetey-1-2013:p1293:b004:l005","ordinal":174919,"en":"Saying, “This side of the ornamented belt,"},{"id":"semetey-1-2013:p1293:b004:l006","ordinal":174920,"en":"Right at the edge of the lung,”"},{"id":"semetey-1-2013:p1293:b004:l007","ordinal":174921,"en":"He charged and drove his spear."},{"id":"semetey-1-2013:p1293:b004:l008","ordinal":174922,"en":"Semetey did not flinch."},{"id":"semetey-1-2013:p1293:b004:l009","ordinal":174923,"en":"Akolpok, inherited"},{"id":"semetey-1-2013:p1293:b004:l010","ordinal":174924,"en":"From his father, gray-wolf Manas,"},{"id":"semetey-1-2013:p1293:b004:l011","ordinal":174925,"en":"Yielded to no such foe,"},{"id":"semetey-1-2013:p1293:b004:l012","ordinal":174926,"en":"Armor fitted to your lion."},{"id":"semetey-1-2013:p1293:b004:l013","ordinal":174927,"en":"Saying, “It has grown very old,”"},{"id":"semetey-1-2013:p1293:b004:l014","ordinal":174928,"en":"Your poor mother had repaired it,"},{"id":"semetey-1-2013:p1293:b004:l015","ordinal":174929,"en":"Mending every pierced place."},{"id":"semetey-1-2013:p1293:b004:l016","ordinal":174930,"en":"When it reached Akolpok,"},{"id":"semetey-1-2013:p1293:b004:l017","ordinal":174931,"en":"Khojo’s spear"},{"id":"semetey-1-2013:p1293:b004:l018","ordinal":174932,"en":"Shattered into eighty pieces,"},{"id":"semetey-1-2013:p1293:b004:l019","ordinal":174933,"en":"And Khojo’s stratagem failed."},{"id":"semetey-1-2013:p1293:b004:l020","ordinal":174934,"en":"Had he not seen many lands,"},{"id":"semetey-1-2013:p1293:b004:l021","ordinal":174935,"en":"That accomplished Khojo?"},{"id":"semetey-1-2013:p1293:b004:l022","ordinal":174936,"en":"Did he not know the enemy’s stratagems,"},{"id":"semetey-1-2013:p1293:b004:l023","ordinal":174937,"en":"That experienced Khojo?"},{"id":"semetey-1-2013:p1293:b004:l024","ordinal":174938,"en":"A great club as large as a house—"},{"id":"semetey-1-2013:p1293:b004:l025","ordinal":174939,"en":"That road-hardened Khojo"},{"id":"semetey-1-2013:p1293:b004:l026","ordinal":174940,"en":"Seized and swung in his hand;"},{"id":"semetey-1-2013:p1293:b004:l027","ordinal":174941,"en":"Gripping it with both hands,"},{"id":"semetey-1-2013:p1293:b004:l028","ordinal":174942,"en":"At the prince, mighty as Khoja,"},{"id":"semetey-1-2013:p1293:b004:l029","ordinal":174943,"en":"He brought it down upon the crown."},{"id":"semetey-1-2013:p1293:b004:l030","ordinal":174944,"en":"When the club struck his head,"},{"id":"semetey-1-2013:p1293:b004:l031","ordinal":174945,"en":"Chynkojo’s cast-iron mace-head—"},{"id":"semetey-1-2013:p1293:b004:l032","ordinal":174946,"en":"Its shaft burst apart,"},{"id":"semetey-1-2013:p1293:b004:l033","ordinal":174947,"en":"Its head flew rattling away."},{"id":"semetey-1-2013:p1293:b004:l034","ordinal":174948,"en":"The helmet worn upon his head,"},{"id":"semetey-1-2013:p1293:b004:l035","ordinal":174949,"en":"At the very place the blow struck,"},{"id":"semetey-1-2013:p1293:b004:l036","ordinal":174950,"en":"Had stretched and bent;"},{"id":"semetey-1-2013:p1293:b004:l037","ordinal":174951,"en":"But Charaina, fashioned"},{"id":"semetey-1-2013:p1293:b004:l038","ordinal":174952,"en":"By your dear mother Kanykei,"},{"id":"semetey-1-2013:p1293:b004:l039","ordinal":174953,"en":"Had remained and stopped the blow."},{"id":"semetey-1-2013:p1294:b003:l001","ordinal":174954,"en":"When Semetey granted him his turn,"},{"id":"semetey-1-2013:p1294:b003:l002","ordinal":174955,"en":"Those dear eyes like black currants"},{"id":"semetey-1-2013:p1294:b003:l003","ordinal":174956,"en":"He nearly gouged out."},{"id":"semetey-1-2013:p1294:b003:l004","ordinal":174957,"en":"That black-hearted dog Khojo"},{"id":"semetey-1-2013:p1294:b003:l005","ordinal":174958,"en":"The orphaned son of Manas"},{"id":"semetey-1-2013:p1294:b003:l006","ordinal":174959,"en":"He nearly slaughtered."},{"id":"semetey-1-2013:p1294:b003:l007","ordinal":174960,"en":"His kinsman became his enemy,"},{"id":"semetey-1-2013:p1294:b003:l008","ordinal":174961,"en":"And within the leopard prince and sultan"},{"id":"semetey-1-2013:p1294:b003:l009","ordinal":174962,"en":"An enemy arose."},{"id":"semetey-1-2013:p1294:b003:l010","ordinal":174963,"en":"Unable to stand his burning rage,"},{"id":"semetey-1-2013:p1294:b003:l011","ordinal":174964,"en":"The falcon prince and sultan"},{"id":"semetey-1-2013:p1294:b003:l012","ordinal":174965,"en":"Revealed his gray-wolf nature."},{"id":"semetey-1-2013:p1294:b003:l013","ordinal":174966,"en":"His dear teeth, broad as a gate,"},{"id":"semetey-1-2013:p1294:b003:l014","ordinal":174967,"en":"Teeth unlike those of ordinary people,"},{"id":"semetey-1-2013:p1294:b003:l015","ordinal":174968,"en":"Showed apart like grains of millet;"},{"id":"semetey-1-2013:p1294:b003:l016","ordinal":174969,"en":"From his mouth blue flame"},{"id":"semetey-1-2013:p1294:b003:l017","ordinal":174970,"en":"Poured as though from a loaded gun."},{"id":"semetey-1-2013:p1294:b003:l018","ordinal":174971,"en":"His eyes burned like embers,"},{"id":"semetey-1-2013:p1294:b003:l019","ordinal":174972,"en":"Stirring the heart of whoever saw him;"},{"id":"semetey-1-2013:p1294:b003:l020","ordinal":174973,"en":"He looked like a blue tiger."},{"id":"semetey-1-2013:p1294:b003:l021","ordinal":174974,"en":"His wrath darkened his face;"},{"id":"semetey-1-2013:p1294:b003:l022","ordinal":174975,"en":"The great and towering Buurul—"},{"id":"semetey-1-2013:p1294:b003:l023","ordinal":174976,"en":"He pulled the reins and turned its head."},{"id":"semetey-1-2013:p1294:b003:l024","ordinal":174977,"en":"The sultan’s Syrnaiza, which drank blood"},{"id":"semetey-1-2013:p1294:b003:l025","ordinal":174978,"en":"Whenever he leveled it,"},{"id":"semetey-1-2013:p1294:b003:l026","ordinal":174979,"en":"He gripped at full length and thrust."},{"id":"semetey-1-2013:p1294:b003:l027","ordinal":174980,"en":"Seizing and swinging his spear,"},{"id":"semetey-1-2013:p1294:b003:l028","ordinal":174981,"en":"He drew the great Buurul"},{"id":"semetey-1-2013:p1294:b003:l029","ordinal":174982,"en":"Hard beneath his thighs;"},{"id":"semetey-1-2013:p1294:b003:l030","ordinal":174983,"en":"Without looking around,"},{"id":"semetey-1-2013:p1294:b003:l031","ordinal":174984,"en":"Your ocean-like hero charged Khojo,"},{"id":"semetey-1-2013:p1294:b003:l032","ordinal":174985,"en":"With no care at all for his life."},{"id":"semetey-1-2013:p1294:b003:l033","ordinal":174986,"en":"On the spur of the broken mountain,"},{"id":"semetey-1-2013:p1294:b003:l034","ordinal":174987,"en":"At the looming promontory,"},{"id":"semetey-1-2013:p1294:b003:l035","ordinal":174988,"en":"He arrived ahead of an arrow;"},{"id":"semetey-1-2013:p1294:b003:l036","ordinal":174989,"en":"On reaching him, he drove the spear."},{"id":"semetey-1-2013:p1294:b003:l037","ordinal":174990,"en":"That expert Khojo"},{"id":"semetey-1-2013:p1294:b003:l038","ordinal":174991,"en":"Took his battle-axe in hand"},{"id":"semetey-1-2013:p1294:b003:l039","ordinal":174992,"en":"And knocked the spear aside before it struck."},{"id":"semetey-1-2013:p1294:b004:l001","ordinal":174993,"en":"When the spear passed beyond him,"},{"id":"semetey-1-2013:p1294:b004:l002","ordinal":174994,"en":"And flew out without touching him,"},{"id":"semetey-1-2013:p1294:b004:l003","ordinal":174995,"en":"At his side was a small golden pouch,"},{"id":"semetey-1-2013:p1294:b004:l004","ordinal":174996,"en":"In his right hand the gold-cheeked battle-axe."},{"id":"semetey-1-2013:p1294:b004:l005","ordinal":174997,"en":"The lion-hero, seized by rage,"},{"id":"semetey-1-2013:p1294:b004:l006","ordinal":174998,"en":"Gripped it and swung,"},{"id":"semetey-1-2013:p1294:b004:l007","ordinal":174999,"en":"At the lordly Khojo"},{"id":"semetey-1-2013:p1294:b004:l008","ordinal":175000,"en":"He brought it down upon the crown."},{"id":"semetey-1-2013:p1294:b004:l009","ordinal":175001,"en":"Lord Khojo then"},{"id":"semetey-1-2013:p1294:b004:l010","ordinal":175002,"en":"Semetey’s violent humiliation"},{"id":"semetey-1-2013:p1294:b004:l011","ordinal":175003,"en":"Was made to behold."},{"id":"semetey-1-2013:p1294:b004:l012","ordinal":175004,"en":"From the axe that struck his crown,"},{"id":"semetey-1-2013:p1294:b004:l013","ordinal":175005,"en":"He nearly fell dead."},{"id":"semetey-1-2013:p1294:b004:l014","ordinal":175006,"en":"From the axe that struck his crown,"},{"id":"semetey-1-2013:p1294:b004:l015","ordinal":175007,"en":"His shield burst apart;"},{"id":"semetey-1-2013:p1294:b004:l016","ordinal":175008,"en":"His fly-like life shrieked,"},{"id":"semetey-1-2013:p1294:b004:l017","ordinal":175009,"en":"His foot slipped from the stirrup,"},{"id":"semetey-1-2013:p1294:b004:l018","ordinal":175010,"en":"And he slid backward from the saddle."},{"id":"semetey-1-2013:p1294:b004:l019","ordinal":175011,"en":"His two eyes rolled,"},{"id":"semetey-1-2013:p1294:b004:l020","ordinal":175012,"en":"His two legs hung loose,"},{"id":"semetey-1-2013:p1294:b004:l021","ordinal":175013,"en":"His wineskin-like nose flapped,"},{"id":"semetey-1-2013:p1294:b004:l022","ordinal":175014,"en":"And both coat skirts fluttered."},{"id":"semetey-1-2013:p1294:b004:l023","ordinal":175015,"en":"He lost his wits,"},{"id":"semetey-1-2013:p1294:b004:l024","ordinal":175016,"en":"And toward a saddle-shaped ridge"},{"id":"semetey-1-2013:p1294:b004:l025","ordinal":175017,"en":"Khojo fled upward."},{"id":"semetey-1-2013:p1294:b004:l026","ordinal":175018,"en":"Your command-bearing gray wolf"},{"id":"semetey-1-2013:p1294:b004:l027","ordinal":175019,"en":"Now turned Buurul’s head."},{"id":"semetey-1-2013:p1294:b004:l028","ordinal":175020,"en":"Akkelte, inherited"},{"id":"semetey-1-2013:p1294:b004:l029","ordinal":175021,"en":"From his father, lion Manas,"},{"id":"semetey-1-2013:p1294:b004:l030","ordinal":175022,"en":"He took from his shoulder."},{"id":"semetey-1-2013:p1294:b004:l031","ordinal":175023,"en":"Its match burned like an ember;"},{"id":"semetey-1-2013:p1294:b004:l032","ordinal":175024,"en":"It had long stood loaded."},{"id":"semetey-1-2013:p1294:b004:l033","ordinal":175025,"en":"When he took it in hand"},{"id":"semetey-1-2013:p1294:b004:l034","ordinal":175026,"en":"And leveled it at Khojo,"},{"id":"semetey-1-2013:p1294:b004:l035","ordinal":175027,"en":"The purest aid to marksmanship,"},{"id":"semetey-1-2013:p1294:b004:l036","ordinal":175028,"en":"Its forked rest stood ready."},{"id":"semetey-1-2013:p1294:b004:l037","ordinal":175029,"en":"“At the joint of the elbow—"},{"id":"semetey-1-2013:p1294:b004:l038","ordinal":175030,"en":"This, as you see, is truly"},{"id":"semetey-1-2013:p1294:b004:l039","ordinal":175031,"en":"The hour of Khojo’s death,” he said,"},{"id":"semetey-1-2013:p1295:b003:l001","ordinal":175032,"en":"Your gray wolf, born a lion,"},{"id":"semetey-1-2013:p1295:b003:l002","ordinal":175033,"en":"Fired Ak-Kelte once,"},{"id":"semetey-1-2013:p1295:b003:l003","ordinal":175034,"en":"When the gun's report rang out,"},{"id":"semetey-1-2013:p1295:b003:l004","ordinal":175035,"en":"Poor Kojo darted aside."},{"id":"semetey-1-2013:p1295:b003:l005","ordinal":175036,"en":"The shot went astray,"},{"id":"semetey-1-2013:p1295:b003:l006","ordinal":175037,"en":"Missing him then,"},{"id":"semetey-1-2013:p1295:b003:l007","ordinal":175038,"en":"It tore away a mat-sized patch of turf."},{"id":"semetey-1-2013:p1295:b003:l008","ordinal":175039,"en":"Despairing of his precious life,"},{"id":"semetey-1-2013:p1295:b003:l009","ordinal":175040,"en":"That Kojo grew enraged,"},{"id":"semetey-1-2013:p1295:b003:l010","ordinal":175041,"en":"And stirred up God's weather."},{"id":"semetey-1-2013:p1295:b003:l011","ordinal":175042,"en":"The weather-stone inherited"},{"id":"semetey-1-2013:p1295:b003:l012","ordinal":175043,"en":"From noble gray-wolf Alman,"},{"id":"semetey-1-2013:p1295:b003:l013","ordinal":175044,"en":"He took and placed in water,"},{"id":"semetey-1-2013:p1295:b003:l014","ordinal":175045,"en":"And the spell of Chinmachin"},{"id":"semetey-1-2013:p1295:b003:l015","ordinal":175046,"en":"He began to recite in earnest."},{"id":"semetey-1-2013:p1295:b003:l016","ordinal":175047,"en":"Mist arose from level ground,"},{"id":"semetey-1-2013:p1295:b003:l017","ordinal":175048,"en":"Clouds covered the mountains,"},{"id":"semetey-1-2013:p1295:b003:l018","ordinal":175049,"en":"From the towering mountains"},{"id":"semetey-1-2013:p1295:b003:l019","ordinal":175050,"en":"A black wind thundered,"},{"id":"semetey-1-2013:p1295:b003:l020","ordinal":175051,"en":"And in Kojo, son of Shygai,"},{"id":"semetey-1-2013:p1295:b003:l021","ordinal":175052,"en":"The guise of a weather-maker appeared."},{"id":"semetey-1-2013:p1295:b003:l022","ordinal":175053,"en":"As though poured from buckets,"},{"id":"semetey-1-2013:p1295:b003:l023","ordinal":175054,"en":"Blue-speckled hail spilled from the sky,"},{"id":"semetey-1-2013:p1295:b003:l024","ordinal":175055,"en":"Low mist crept down,"},{"id":"semetey-1-2013:p1295:b003:l025","ordinal":175056,"en":"And then there moved"},{"id":"semetey-1-2013:p1295:b003:l026","ordinal":175057,"en":"A red haze and driving sleet."},{"id":"semetey-1-2013:p1295:b003:l027","ordinal":175058,"en":"All the lowlands filled with rain,"},{"id":"semetey-1-2013:p1295:b003:l028","ordinal":175059,"en":"All the foothills filled with hail,"},{"id":"semetey-1-2013:p1295:b003:l029","ordinal":175060,"en":"Flurries and driving sleet,"},{"id":"semetey-1-2013:p1295:b003:l030","ordinal":175061,"en":"Clouds gathered overhead,"},{"id":"semetey-1-2013:p1295:b003:l031","ordinal":175062,"en":"The earth seemed to split,"},{"id":"semetey-1-2013:p1295:b003:l032","ordinal":175063,"en":"And God struck the heavens."},{"id":"semetey-1-2013:p1295:b003:l033","ordinal":175064,"en":"The spell of Kakan-Chin"},{"id":"semetey-1-2013:p1295:b003:l034","ordinal":175065,"en":"Poor Kojo then"},{"id":"semetey-1-2013:p1295:b003:l035","ordinal":175066,"en":"Stood boldly reciting."},{"id":"semetey-1-2013:p1295:b003:l036","ordinal":175067,"en":"His fiery eyes blazed fiercely,"},{"id":"semetey-1-2013:p1295:b003:l037","ordinal":175068,"en":"The lion prince Semetey,"},{"id":"semetey-1-2013:p1295:b003:l038","ordinal":175069,"en":"Truly seized by his bloodlust,"},{"id":"semetey-1-2013:p1295:b003:l039","ordinal":175070,"en":"Was about to assail Kojo,"},{"id":"semetey-1-2013:p1295:b004:l001","ordinal":175071,"en":"Was about to grapple with him."},{"id":"semetey-1-2013:p1295:b004:l002","ordinal":175072,"en":"As he raised Ak-Kelte again,"},{"id":"semetey-1-2013:p1295:b004:l003","ordinal":175073,"en":"As he was about to shoot Kojo,"},{"id":"semetey-1-2013:p1295:b004:l004","ordinal":175074,"en":"Chynkojo's Black Horse—"},{"id":"semetey-1-2013:p1295:b004:l005","ordinal":175075,"en":"That Black Horse, it seems,"},{"id":"semetey-1-2013:p1295:b004:l006","ordinal":175076,"en":"Had wings upon its flanks,"},{"id":"semetey-1-2013:p1295:b004:l007","ordinal":175077,"en":"And, when a wondrous spell was read,"},{"id":"semetey-1-2013:p1295:b004:l008","ordinal":175078,"en":"Was accustomed to fly."},{"id":"semetey-1-2013:p1295:b004:l009","ordinal":175079,"en":"A mighty sorcerer and magician"},{"id":"semetey-1-2013:p1295:b004:l010","ordinal":175080,"en":"Had fashioned this for Kojo:"},{"id":"semetey-1-2013:p1295:b004:l011","ordinal":175081,"en":"Beneath him was his racehorse, the Black Horse."},{"id":"semetey-1-2013:p1295:b004:l012","ordinal":175082,"en":"When his precious life was pressed,"},{"id":"semetey-1-2013:p1295:b004:l013","ordinal":175083,"en":"Whenever it saw an enemy in battle,"},{"id":"semetey-1-2013:p1295:b004:l014","ordinal":175084,"en":"It was accustomed to rise and fly."},{"id":"semetey-1-2013:p1295:b004:l015","ordinal":175085,"en":"That Kojo was a master;"},{"id":"semetey-1-2013:p1295:b004:l016","ordinal":175086,"en":"Ask not the full extent of his powers,"},{"id":"semetey-1-2013:p1295:b004:l017","ordinal":175087,"en":"Kojo was a lion aided by spirits."},{"id":"semetey-1-2013:p1295:b004:l018","ordinal":175088,"en":"Resourceful, he went flying,"},{"id":"semetey-1-2013:p1295:b004:l019","ordinal":175089,"en":"Kojo was a hero of formidable spirit."},{"id":"semetey-1-2013:p1295:b004:l020","ordinal":175090,"en":"Mingling with the mirage,"},{"id":"semetey-1-2013:p1295:b004:l021","ordinal":175091,"en":"Chynkojo entered the tumult."},{"id":"semetey-1-2013:p1295:b004:l022","ordinal":175092,"en":"In a deed no son of man would believe,"},{"id":"semetey-1-2013:p1295:b004:l023","ordinal":175093,"en":"Chynkojo entered the fray."},{"id":"semetey-1-2013:p1295:b004:l024","ordinal":175094,"en":"Much of it is false, much is true;"},{"id":"semetey-1-2013:p1295:b004:l025","ordinal":175095,"en":"No one has gone and seen it,"},{"id":"semetey-1-2013:p1295:b004:l026","ordinal":175096,"en":"And unless manifest God knows,"},{"id":"semetey-1-2013:p1295:b004:l027","ordinal":175097,"en":"We cannot tell whether it is true."},{"id":"semetey-1-2013:p1295:b004:l028","ordinal":175098,"en":"Half is false and half is true;"},{"id":"semetey-1-2013:p1295:b004:l029","ordinal":175099,"en":"Unless the Creator himself knows,"},{"id":"semetey-1-2013:p1295:b004:l030","ordinal":175100,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1295:b004:l031","ordinal":175101,"en":"Kojo whose deeds were formidable,"},{"id":"semetey-1-2013:p1295:b004:l032","ordinal":175102,"en":"Kojo with broad right shoulder,"},{"id":"semetey-1-2013:p1295:b004:l033","ordinal":175103,"en":"Kojo, a hero surpassing the world,"},{"id":"semetey-1-2013:p1295:b004:l034","ordinal":175104,"en":"Kojo perfect in all twelve limbs,"}]
