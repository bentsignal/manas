[{"id":"seytek-2012:p0514:b002:l018","ordinal":335105,"en":"And girded on his gleaming sword."},{"id":"seytek-2012:p0514:b002:l019","ordinal":335106,"en":"Hearts sank and parted,"},{"id":"seytek-2012:p0514:b002:l020","ordinal":335107,"en":"As he parted from the vast army,"},{"id":"seytek-2012:p0514:b002:l021","ordinal":335108,"en":"The tasseled standard swaying in his hand."},{"id":"seytek-2012:p0514:b002:l022","ordinal":335109,"en":"And so Külchoro,"},{"id":"seytek-2012:p0514:b002:l023","ordinal":335110,"en":"Galloping upon Surkiyik,"},{"id":"seytek-2012:p0514:b002:l024","ordinal":335111,"en":"Made the earth’s navel quake."},{"id":"seytek-2012:p0514:b002:l025","ordinal":335112,"en":"Tall and broad-shouldered,"},{"id":"seytek-2012:p0514:b002:l026","ordinal":335113,"en":"Both champion and lion,"},{"id":"seytek-2012:p0514:b002:l027","ordinal":335114,"en":"He was a seasoned hero who knew the enemy’s ways."},{"id":"seytek-2012:p0514:b002:l028","ordinal":335115,"en":"Toward the infidel of mighty arms,"},{"id":"seytek-2012:p0514:b002:l029","ordinal":335116,"en":"Toward the hero of abundant courage,"},{"id":"seytek-2012:p0514:b002:l030","ordinal":335117,"en":"Toward the infidel Sarybai,"},{"id":"seytek-2012:p0514:b002:l031","ordinal":335118,"en":"He hastened without pausing for breath,"},{"id":"seytek-2012:p0514:b002:l032","ordinal":335119,"en":"To clash fiercely in combat,"},{"id":"seytek-2012:p0514:b002:l033","ordinal":335120,"en":"To fight to the death,"},{"id":"seytek-2012:p0514:b002:l034","ordinal":335121,"en":"To wreak great slaughter,"},{"id":"seytek-2012:p0514:b002:l035","ordinal":335122,"en":"And meet him face-to-face."},{"id":"seytek-2012:p0514:b002:l036","ordinal":335123,"en":"What he said at dawn was fulfilled by dusk,"},{"id":"seytek-2012:p0514:b002:l037","ordinal":335124,"en":"And his eyes strained with expectation."},{"id":"seytek-2012:p0514:b002:l038","ordinal":335125,"en":"Gripping his spear and grinding his teeth,"},{"id":"seytek-2012:p0514:b002:l039","ordinal":335126,"en":"Truly exultant, his eyes ablaze,"},{"id":"seytek-2012:p0514:b002:l040","ordinal":335127,"en":"He went forth to single combat."},{"id":"seytek-2012:p0514:b003:l001","ordinal":335128,"en":"Do valiant champions"},{"id":"seytek-2012:p0514:b003:l002","ordinal":335129,"en":"Not die against the foe they meet?"},{"id":"seytek-2012:p0514:b003:l003","ordinal":335130,"en":"When need demands, do they not give"},{"id":"seytek-2012:p0514:b003:l004","ordinal":335131,"en":"This life to whatever cause they choose?"},{"id":"seytek-2012:p0514:b003:l005","ordinal":335132,"en":"You lost your senses,"},{"id":"seytek-2012:p0514:b003:l006","ordinal":335133,"en":"Rushed about and raised a clamor,"},{"id":"seytek-2012:p0514:b003:l007","ordinal":335134,"en":"Then fled without finding a way."},{"id":"seytek-2012:p0514:b003:l008","ordinal":335135,"en":"Here are your heroes and warriors;"},{"id":"seytek-2012:p0514:b003:l009","ordinal":335136,"en":"When you begin to stir up words,"},{"id":"seytek-2012:p0514:b003:l010","ordinal":335137,"en":"You have weaklings who grow afraid,"},{"id":"seytek-2012:p0514:b003:l011","ordinal":335138,"en":"And fools who panic without counsel."},{"id":"seytek-2012:p0514:b003:l012","ordinal":335139,"en":"You have men who throw vast armies into chaos,"},{"id":"seytek-2012:p0514:b003:l013","ordinal":335140,"en":"Break their strength, and flee."},{"id":"seytek-2012:p0514:b003:l014","ordinal":335141,"en":"You have cowards and warriors,"},{"id":"seytek-2012:p0514:b003:l015","ordinal":335142,"en":"And weaklings who spread disorder."},{"id":"seytek-2012:p0514:b003:l016","ordinal":335143,"en":"Babbling praise of Sarybai—"},{"id":"seytek-2012:p0514:b003:l017","ordinal":335144,"en":"Damn you, wretched people,"},{"id":"seytek-2012:p0514:b003:l018","ordinal":335145,"en":"God has surely cursed you!"},{"id":"seytek-2012:p0514:b003:l019","ordinal":335146,"en":"Is Sarybai such a peerless lion?"},{"id":"seytek-2012:p0514:b003:l020","ordinal":335147,"en":"Is that infidel, the monster’s son,"},{"id":"seytek-2012:p0514:b003:l021","ordinal":335148,"en":"A greater warrior than I?"},{"id":"seytek-2012:p0514:b003:l022","ordinal":335149,"en":"I shall go to the great battlefield,"},{"id":"seytek-2012:p0514:b003:l023","ordinal":335150,"en":"And grapple with Sarybai."},{"id":"seytek-2012:p0514:b003:l024","ordinal":335151,"en":"I shall fire my gun and draw my bow,"},{"id":"seytek-2012:p0514:b003:l025","ordinal":335152,"en":"And wage a relentless fight."},{"id":"seytek-2012:p0514:b003:l026","ordinal":335153,"en":"Broad Talas is no cheap land;"},{"id":"seytek-2012:p0514:b003:l027","ordinal":335154,"en":"Külchoro, born of the renowned,"},{"id":"seytek-2012:p0514:b003:l028","ordinal":335155,"en":"Is no common warrior."},{"id":"seytek-2012:p0514:b003:l029","ordinal":335156,"en":"Sarybai is the one I shall fight,"},{"id":"seytek-2012:p0514:b003:l030","ordinal":335157,"en":"That infidel whose shape is like a mountain,"},{"id":"seytek-2012:p0514:b003:l031","ordinal":335158,"en":"The warrior Khan Sarybai,"},{"id":"seytek-2012:p0514:b003:l032","ordinal":335159,"en":"The brute who scorches the earth,"},{"id":"seytek-2012:p0514:b003:l033","ordinal":335160,"en":"The champion who destroys nations."},{"id":"seytek-2012:p0514:b003:l034","ordinal":335161,"en":"I shall rain many shots upon him,"},{"id":"seytek-2012:p0514:b003:l035","ordinal":335162,"en":"And slaughter his pampered people."},{"id":"seytek-2012:p0514:b003:l036","ordinal":335163,"en":"If I do not seize his spoils,"},{"id":"seytek-2012:p0514:b003:l037","ordinal":335164,"en":"If I do not unleash a shattering battle,"},{"id":"seytek-2012:p0514:b003:l038","ordinal":335165,"en":"Standing face-to-face with him"},{"id":"seytek-2012:p0514:b003:l039","ordinal":335166,"en":"And fighting until this dear life"},{"id":"seytek-2012:p0514:b003:l040","ordinal":335167,"en":"Vanishes before all eyes,"},{"id":"seytek-2012:p0515:b002:l001","ordinal":335168,"en":"He appeared wherever he could be seen,"},{"id":"seytek-2012:p0515:b002:l002","ordinal":335169,"en":"And in unseen ravines"},{"id":"seytek-2012:p0515:b002:l003","ordinal":335170,"en":"He streamed like blue smoke."},{"id":"seytek-2012:p0515:b002:l004","ordinal":335171,"en":"His eyes shone red,"},{"id":"seytek-2012:p0515:b002:l005","ordinal":335172,"en":"His stride lengthened like an argali’s."},{"id":"seytek-2012:p0515:b002:l006","ordinal":335173,"en":"When he came to a bend,"},{"id":"seytek-2012:p0515:b002:l007","ordinal":335174,"en":"The creature proved a true courser,"},{"id":"seytek-2012:p0515:b002:l008","ordinal":335175,"en":"His eyes reddening like a stag’s."},{"id":"seytek-2012:p0515:b002:l009","ordinal":335176,"en":"When he came to winding ground,"},{"id":"seytek-2012:p0515:b002:l010","ordinal":335177,"en":"He stretched his stride and raised tumult,"},{"id":"seytek-2012:p0515:b002:l011","ordinal":335178,"en":"His fleet pace growing longer."},{"id":"seytek-2012:p0515:b002:l012","ordinal":335179,"en":"His hooves thundered on the earth;"},{"id":"seytek-2012:p0515:b002:l013","ordinal":335180,"en":"The black-steel bit"},{"id":"seytek-2012:p0515:b002:l014","ordinal":335181,"en":"Clattered in his throat."},{"id":"seytek-2012:p0515:b002:l015","ordinal":335182,"en":"He flung his forelock to the sky,"},{"id":"seytek-2012:p0515:b002:l016","ordinal":335183,"en":"And drove his hooves into the ground."},{"id":"seytek-2012:p0515:b002:l017","ordinal":335184,"en":"The black-steel bit"},{"id":"seytek-2012:p0515:b002:l018","ordinal":335185,"en":"Beat against his gullet;"},{"id":"seytek-2012:p0515:b002:l019","ordinal":335186,"en":"His willow-silk tail"},{"id":"seytek-2012:p0515:b002:l020","ordinal":335187,"en":"Lashed his spreading legs."},{"id":"seytek-2012:p0515:b002:l021","ordinal":335188,"en":"He laid back his ears like a kulan"},{"id":"seytek-2012:p0515:b002:l022","ordinal":335189,"en":"And swept the earth like a whirlwind."},{"id":"seytek-2012:p0515:b002:l023","ordinal":335190,"en":"At the sound of clamor he surged,"},{"id":"seytek-2012:p0515:b002:l024","ordinal":335191,"en":"And when he ran, the black earth"},{"id":"seytek-2012:p0515:b002:l025","ordinal":335192,"en":"Split layer upon layer—"},{"id":"seytek-2012:p0515:b002:l026","ordinal":335193,"en":"Such was the nature of that tulpar."},{"id":"seytek-2012:p0515:b002:l027","ordinal":335194,"en":"Spear in hand, breaking formations,"},{"id":"seytek-2012:p0515:b002:l028","ordinal":335195,"en":"Külchoro hastened onward."},{"id":"seytek-2012:p0515:b002:l029","ordinal":335196,"en":"He rode across the rise called Horse-Cannot-Pass,"},{"id":"seytek-2012:p0515:b002:l030","ordinal":335197,"en":"Pressing steadily forward."},{"id":"seytek-2012:p0515:b002:l031","ordinal":335198,"en":"Through the open desert of People-Cannot-Cross,"},{"id":"seytek-2012:p0515:b002:l032","ordinal":335199,"en":"He went to settle the matter."},{"id":"seytek-2012:p0515:b002:l033","ordinal":335200,"en":"Toward the infidel, the monster’s son,"},{"id":"seytek-2012:p0515:b002:l034","ordinal":335201,"en":"He went to fight to the death."},{"id":"seytek-2012:p0515:b002:l035","ordinal":335202,"en":"At the Sheer Cliff of Soul-Cannot-Pass,"},{"id":"seytek-2012:p0515:b002:l036","ordinal":335203,"en":"He went to carve a road."},{"id":"seytek-2012:p0515:b002:l037","ordinal":335204,"en":"Against the raging infidel,"},{"id":"seytek-2012:p0515:b002:l038","ordinal":335205,"en":"Against brave Sarybai,"},{"id":"seytek-2012:p0515:b002:l039","ordinal":335206,"en":"He went to launch his assault."},{"id":"seytek-2012:p0515:b002:l040","ordinal":335207,"en":"Against the master of land and water,"},{"id":"seytek-2012:p0515:b003:l001","ordinal":335208,"en":"The rabid, frenzied Sarybai,"},{"id":"seytek-2012:p0515:b003:l002","ordinal":335209,"en":"He went to capture him if his strength sufficed,"},{"id":"seytek-2012:p0515:b003:l003","ordinal":335210,"en":"To unleash terrible slaughter,"},{"id":"seytek-2012:p0515:b003:l004","ordinal":335211,"en":"To throw all into turmoil,"},{"id":"seytek-2012:p0515:b003:l005","ordinal":335212,"en":"And search every pouch"},{"id":"seytek-2012:p0515:b003:l006","ordinal":335213,"en":"Of that champion-posing swine."},{"id":"seytek-2012:p0515:b003:l007","ordinal":335214,"en":"He went to cast hell upon his ranks,"},{"id":"seytek-2012:p0515:b003:l008","ordinal":335215,"en":"To charge in and fight without stopping,"},{"id":"seytek-2012:p0515:b003:l009","ordinal":335216,"en":"And thrust that infidel Sarybai"},{"id":"seytek-2012:p0515:b003:l010","ordinal":335217,"en":"Headlong to the ground."},{"id":"seytek-2012:p0515:b003:l011","ordinal":335218,"en":"Thus matters came to pass,"},{"id":"seytek-2012:p0515:b003:l012","ordinal":335219,"en":"And Külchoro resolved"},{"id":"seytek-2012:p0515:b003:l013","ordinal":335220,"en":"To meet him face-to-face."},{"id":"seytek-2012:p0515:b003:l014","ordinal":335221,"en":"They would clash and test their strength;"},{"id":"seytek-2012:p0515:b003:l015","ordinal":335222,"en":"If fortune favored the valiant man,"},{"id":"seytek-2012:p0515:b003:l016","ordinal":335223,"en":"He would spill Sarybai’s blood,"},{"id":"seytek-2012:p0515:b003:l017","ordinal":335224,"en":"And if not, he would die."},{"id":"seytek-2012:p0515:b003:l018","ordinal":335225,"en":"Gripping his spear, steeling himself,"},{"id":"seytek-2012:p0515:b003:l019","ordinal":335226,"en":"He bit hard upon his lip."},{"id":"seytek-2012:p0515:b003:l020","ordinal":335227,"en":"He scowled in fury,"},{"id":"seytek-2012:p0515:b003:l021","ordinal":335228,"en":"And buckled on his gray girdle."},{"id":"seytek-2012:p0515:b003:l022","ordinal":335229,"en":"He arranged and fastened his weapons;"},{"id":"seytek-2012:p0515:b003:l023","ordinal":335230,"en":"When his rage made him bristle,"},{"id":"seytek-2012:p0515:b003:l024","ordinal":335231,"en":"Wrath transformed his face."},{"id":"seytek-2012:p0515:b003:l025","ordinal":335232,"en":"He surveyed the broad plain,"},{"id":"seytek-2012:p0515:b003:l026","ordinal":335233,"en":"And braced his spirit, saying, “I trust in fate.”"},{"id":"seytek-2012:p0515:b003:l027","ordinal":335234,"en":"He seized his black-handled whip,"},{"id":"seytek-2012:p0515:b003:l028","ordinal":335235,"en":"Swung it around,"},{"id":"seytek-2012:p0515:b003:l029","ordinal":335236,"en":"And Surkaiyk, a steed like none but a spirit—"},{"id":"seytek-2012:p0515:b003:l030","ordinal":335237,"en":"Support of his life held in trust,"},{"id":"seytek-2012:p0515:b003:l031","ordinal":335238,"en":"Pearl among all flowing-tailed horses,"},{"id":"seytek-2012:p0515:b003:l032","ordinal":335239,"en":"Foal of the spirit-gray mare,"},{"id":"seytek-2012:p0515:b003:l033","ordinal":335240,"en":"Duldul among the horses of Karanda—"},{"id":"seytek-2012:p0515:b003:l034","ordinal":335241,"en":"That dark-bay Surkaiyk,"},{"id":"seytek-2012:p0515:b003:l035","ordinal":335242,"en":"He circled the whip over him"},{"id":"seytek-2012:p0515:b003:l036","ordinal":335243,"en":"And struck it against his flank."},{"id":"seytek-2012:p0515:b003:l037","ordinal":335244,"en":"He made the rugged ground quake,"},{"id":"seytek-2012:p0515:b003:l038","ordinal":335245,"en":"Galloping onward upon Surkaiyk."},{"id":"seytek-2012:p0515:b003:l039","ordinal":335246,"en":"Külchoro rode out to single combat"},{"id":"seytek-2012:p0515:b003:l040","ordinal":335247,"en":"Upon the fiery Surkaiyk."},{"id":"seytek-2012:p0516:b002:l001","ordinal":335248,"en":"Külchoro, upheld by the spirits,"},{"id":"seytek-2012:p0516:b002:l002","ordinal":335249,"en":"Was tall and broad-shouldered,"},{"id":"seytek-2012:p0516:b002:l003","ordinal":335250,"en":"Both champion and lion,"},{"id":"seytek-2012:p0516:b002:l004","ordinal":335251,"en":"A seasoned hero who knew"},{"id":"seytek-2012:p0516:b002:l005","ordinal":335252,"en":"The enemy’s ways exceedingly well."},{"id":"seytek-2012:p0516:b002:l006","ordinal":335253,"en":"He struck Kulansur once upon the flank,"},{"id":"seytek-2012:p0516:b002:l007","ordinal":335254,"en":"Took up his fine steel spear,"},{"id":"seytek-2012:p0516:b002:l008","ordinal":335255,"en":"And rode straight toward Sarybai."},{"id":"seytek-2012:p0516:b002:l009","ordinal":335256,"en":"Against brave Sarybai"},{"id":"seytek-2012:p0516:b002:l010","ordinal":335257,"en":"He charged alone:"},{"id":"seytek-2012:p0516:b002:l011","ordinal":335258,"en":"“Sarybai, son of the monster,"},{"id":"seytek-2012:p0516:b002:l012","ordinal":335259,"en":"If you are brave Sarybai,"},{"id":"seytek-2012:p0516:b002:l013","ordinal":335260,"en":"And I am brave Külchoro,"},{"id":"seytek-2012:p0516:b002:l014","ordinal":335261,"en":"Let us face each other with leveled spears"},{"id":"seytek-2012:p0516:b002:l015","ordinal":335262,"en":"And meet in single combat;"},{"id":"seytek-2012:p0516:b002:l016","ordinal":335263,"en":"If death comes, let us die!"},{"id":"seytek-2012:p0516:b002:l017","ordinal":335264,"en":"Let us stand face-to-face,"},{"id":"seytek-2012:p0516:b002:l018","ordinal":335265,"en":"Fight without sparing our lives,"},{"id":"seytek-2012:p0516:b002:l019","ordinal":335266,"en":"And bring this to its final end."},{"id":"seytek-2012:p0516:b002:l020","ordinal":335267,"en":"Let our spears begin their work;"},{"id":"seytek-2012:p0516:b002:l021","ordinal":335268,"en":"Let turmoil seize the earth"},{"id":"seytek-2012:p0516:b002:l022","ordinal":335269,"en":"Until it crumbles beneath us."},{"id":"seytek-2012:p0516:b002:l023","ordinal":335270,"en":"If I am the son of Almambet"},{"id":"seytek-2012:p0516:b002:l024","ordinal":335271,"en":"And you the monster’s son,"},{"id":"seytek-2012:p0516:b002:l025","ordinal":335272,"en":"Let me hear your vaunted fury!"},{"id":"seytek-2012:p0516:b002:l026","ordinal":335273,"en":"Though born of a monster,"},{"id":"seytek-2012:p0516:b002:l027","ordinal":335274,"en":"Even if you possessed seven thousand lives,"},{"id":"seytek-2012:p0516:b002:l028","ordinal":335275,"en":"I would kill and bury you in the earth!"},{"id":"seytek-2012:p0516:b002:l029","ordinal":335276,"en":"I shall spread slaughter to your farthest bounds,"},{"id":"seytek-2012:p0516:b002:l030","ordinal":335277,"en":"Leaving not one of you,"},{"id":"seytek-2012:p0516:b002:l031","ordinal":335278,"en":"But putting you all to the sword."},{"id":"seytek-2012:p0516:b002:l032","ordinal":335279,"en":"Let me hear of your courage!"},{"id":"seytek-2012:p0516:b002:l033","ordinal":335280,"en":"Though we fight for months and years,"},{"id":"seytek-2012:p0516:b002:l034","ordinal":335281,"en":"I shall kill and bury you in the earth!"},{"id":"seytek-2012:p0516:b002:l035","ordinal":335282,"en":"I shall trample your encampment"},{"id":"seytek-2012:p0516:b002:l036","ordinal":335283,"en":"And sweep away your champions."},{"id":"seytek-2012:p0516:b002:l037","ordinal":335284,"en":"Without sparing my dark life,"},{"id":"seytek-2012:p0516:b002:l038","ordinal":335285,"en":"I shall pour out my fiercest wrath."},{"id":"seytek-2012:p0516:b002:l039","ordinal":335286,"en":"You infidel, son of the monster,"},{"id":"seytek-2012:p0516:b002:l040","ordinal":335287,"en":"I shall tear apart your ribs!”"},{"id":"seytek-2012:p0516:b003:l001","ordinal":335288,"en":"Toward the lone marauder of deadly venom,"},{"id":"seytek-2012:p0516:b003:l002","ordinal":335289,"en":"Toward the giant Sarybai,"},{"id":"seytek-2012:p0516:b003:l003","ordinal":335290,"en":"Toward death itself,"},{"id":"seytek-2012:p0516:b003:l004","ordinal":335291,"en":"Toward the true devourer’s eye,"},{"id":"seytek-2012:p0516:b003:l005","ordinal":335292,"en":"He pressed on to test himself."},{"id":"seytek-2012:p0516:b003:l006","ordinal":335293,"en":"Along the stony ridge,"},{"id":"seytek-2012:p0516:b003:l007","ordinal":335294,"en":"The tireless lone wolf arrived"},{"id":"seytek-2012:p0516:b003:l008","ordinal":335295,"en":"At the place where they would crush each other."},{"id":"seytek-2012:p0516:b003:l009","ordinal":335296,"en":"At the white ravine of the reedy slope,"},{"id":"seytek-2012:p0516:b003:l010","ordinal":335297,"en":"They faced each other on the battlefield."},{"id":"seytek-2012:p0516:b003:l011","ordinal":335298,"en":"Cutting a road through the army,"},{"id":"seytek-2012:p0516:b003:l012","ordinal":335299,"en":"Külchoro, upheld by the spirits,"},{"id":"seytek-2012:p0516:b003:l013","ordinal":335300,"en":"Assailed Sarybai."},{"id":"seytek-2012:p0516:b003:l014","ordinal":335301,"en":"From this nearer side,"},{"id":"seytek-2012:p0516:b003:l015","ordinal":335302,"en":"At the champions’ outer edge,"},{"id":"seytek-2012:p0516:b003:l016","ordinal":335303,"en":"He tightened his well-fitted belt"},{"id":"seytek-2012:p0516:b003:l017","ordinal":335304,"en":"And charged straight in."},{"id":"seytek-2012:p0516:b003:l018","ordinal":335305,"en":"Spearing all he encountered,"},{"id":"seytek-2012:p0516:b003:l019","ordinal":335306,"en":"He sought everywhere"},{"id":"seytek-2012:p0516:b003:l020","ordinal":335307,"en":"For Sarybai, the monster’s son."},{"id":"seytek-2012:p0516:b003:l021","ordinal":335308,"en":"Such was his lion-hearted valor:"},{"id":"seytek-2012:p0516:b003:l022","ordinal":335309,"en":"Those within reach of his spear"},{"id":"seytek-2012:p0516:b003:l023","ordinal":335310,"en":"He struck down with his spear;"},{"id":"seytek-2012:p0516:b003:l024","ordinal":335311,"en":"Those within reach of his battle-axe"},{"id":"seytek-2012:p0516:b003:l025","ordinal":335312,"en":"He hacked and felled;"},{"id":"seytek-2012:p0516:b003:l026","ordinal":335313,"en":"Those who pressed hard upon his sword"},{"id":"seytek-2012:p0516:b003:l027","ordinal":335314,"en":"He hewed down;"},{"id":"seytek-2012:p0516:b003:l028","ordinal":335315,"en":"Those who came before him"},{"id":"seytek-2012:p0516:b003:l029","ordinal":335316,"en":"He laid waste and struck aside."},{"id":"seytek-2012:p0516:b003:l030","ordinal":335317,"en":"The sky was clear, but the earth grew dark;"},{"id":"seytek-2012:p0516:b003:l031","ordinal":335318,"en":"The ground churned as night descended."},{"id":"seytek-2012:p0516:b003:l032","ordinal":335319,"en":"The armies on either side"},{"id":"seytek-2012:p0516:b003:l033","ordinal":335320,"en":"Mingled together."},{"id":"seytek-2012:p0516:b003:l034","ordinal":335321,"en":"They fought amid battle cries—"},{"id":"seytek-2012:p0516:b003:l035","ordinal":335322,"en":"Who had ever seen such a struggle?"},{"id":"seytek-2012:p0516:b003:l036","ordinal":335323,"en":"The fainthearted withdrew,"},{"id":"seytek-2012:p0516:b003:l037","ordinal":335324,"en":"While every champion confronted the foe."},{"id":"seytek-2012:p0516:b003:l038","ordinal":335325,"en":"Spears shattered and straps fell,"},{"id":"seytek-2012:p0516:b003:l039","ordinal":335326,"en":"Horses fell as though mountains collapsed;"},{"id":"seytek-2012:p0516:b003:l040","ordinal":335327,"en":"A merciless battle raged."},{"id":"seytek-2012:p0517:b002:l001","ordinal":335328,"en":"Pouring out his wrath, he bristled,"},{"id":"seytek-2012:p0517:b002:l002","ordinal":335329,"en":"I have long awaited our clash."},{"id":"seytek-2012:p0517:b002:l003","ordinal":335330,"en":"Now that my mortal enemy,"},{"id":"seytek-2012:p0517:b002:l004","ordinal":335331,"en":"Who would tear out lungs and seize gall, has come,"},{"id":"seytek-2012:p0517:b002:l005","ordinal":335332,"en":"How could I spare my life!"},{"id":"seytek-2012:p0517:b002:l006","ordinal":335333,"en":"Ever since I became Külchoro,"},{"id":"seytek-2012:p0517:b002:l007","ordinal":335334,"en":"I have subdued the whole world,"},{"id":"seytek-2012:p0517:b002:l008","ordinal":335335,"en":"Driving, slaughtering, and despoiling it."},{"id":"seytek-2012:p0517:b002:l009","ordinal":335336,"en":"I donned armor no bullet could pierce,"},{"id":"seytek-2012:p0517:b002:l010","ordinal":335337,"en":"I slaughtered a thousand men like you;"},{"id":"seytek-2012:p0517:b002:l011","ordinal":335338,"en":"Where, then, is my death?!"},{"id":"seytek-2012:p0517:b002:l012","ordinal":335339,"en":"At last, Sarybai,"},{"id":"seytek-2012:p0517:b002:l013","ordinal":335340,"en":"I have met you in your fury."},{"id":"seytek-2012:p0517:b002:l014","ordinal":335341,"en":"Let us make our combat supreme,"},{"id":"seytek-2012:p0517:b002:l015","ordinal":335342,"en":"Fighting without mercy,"},{"id":"seytek-2012:p0517:b002:l016","ordinal":335343,"en":"Let us cry out and thrust our spears!"},{"id":"seytek-2012:p0517:b002:l017","ordinal":335344,"en":"Let us stake our knuckle-sized heads,"},{"id":"seytek-2012:p0517:b002:l018","ordinal":335345,"en":"And swallow lives as great as mountains,"},{"id":"seytek-2012:p0517:b002:l019","ordinal":335346,"en":"Roaming freely over the pasture,"},{"id":"seytek-2012:p0517:b002:l020","ordinal":335347,"en":"And, when we remember, drain each other's lives."},{"id":"seytek-2012:p0517:b002:l021","ordinal":335348,"en":"Let us test the champions,"},{"id":"seytek-2012:p0517:b002:l022","ordinal":335349,"en":"Let us intensify the strife."},{"id":"seytek-2012:p0517:b002:l023","ordinal":335350,"en":"Let us make our fame manifest,"},{"id":"seytek-2012:p0517:b002:l024","ordinal":335351,"en":"And spread the conflict far."},{"id":"seytek-2012:p0517:b002:l025","ordinal":335352,"en":"You began the campaign and war,"},{"id":"seytek-2012:p0517:b002:l026","ordinal":335353,"en":"In which the people were massacred and died;"},{"id":"seytek-2012:p0517:b002:l027","ordinal":335354,"en":"You have grown fond of such deeds!"},{"id":"seytek-2012:p0517:b002:l028","ordinal":335355,"en":"Now behold valor and heroism,"},{"id":"seytek-2012:p0517:b002:l029","ordinal":335356,"en":"Behold such a feat."},{"id":"seytek-2012:p0517:b002:l030","ordinal":335357,"en":"Let our sovereign souls blaze,"},{"id":"seytek-2012:p0517:b002:l031","ordinal":335358,"en":"Let us rouse all our strength,"},{"id":"seytek-2012:p0517:b002:l032","ordinal":335359,"en":"And wage war once more!"},{"id":"seytek-2012:p0517:b002:l033","ordinal":335360,"en":"Our champions and our khans,"}]
