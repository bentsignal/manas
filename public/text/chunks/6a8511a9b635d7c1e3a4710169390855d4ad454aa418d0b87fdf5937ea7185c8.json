[{"id":"semetey-1-2013:p0489:b005:l008","ordinal":114433,"en":"Közkaman who stood exchanging fire—"},{"id":"semetey-1-2013:p0489:b005:l009","ordinal":114434,"en":"His father was Kyrgyz in this way,"},{"id":"semetey-1-2013:p0489:b005:l010","ordinal":114435,"en":"Though his thoughts had turned away."},{"id":"semetey-1-2013:p0489:b005:l011","ordinal":114436,"en":"Karakan and this swine"},{"id":"semetey-1-2013:p0489:b005:l012","ordinal":114437,"en":"Were sons of brothers."},{"id":"semetey-1-2013:p0489:b005:l013","ordinal":114438,"en":"Zhakyp went to the Chinese"},{"id":"semetey-1-2013:p0489:b005:l014","ordinal":114439,"en":"And fathered the lion, leopard Manas."},{"id":"semetey-1-2013:p0489:b005:l015","ordinal":114440,"en":"Orozoi wandered to Beijing."},{"id":"semetey-1-2013:p0489:b005:l016","ordinal":114441,"en":"Orozoi's ten sons,"},{"id":"semetey-1-2013:p0489:b005:l017","ordinal":114442,"en":"Among the dark Kalmyks and Manchu,"},{"id":"semetey-1-2013:p0489:b005:l018","ordinal":114443,"en":"Saying the idol was God,"},{"id":"semetey-1-2013:p0489:b005:l019","ordinal":114444,"en":"Thus found a faith in darkness."},{"id":"semetey-1-2013:p0489:b005:l020","ordinal":114445,"en":"Közkaman, son of Kökchököz—"},{"id":"semetey-1-2013:p0489:b005:l021","ordinal":114446,"en":"These two were of one nest;"},{"id":"semetey-1-2013:p0489:b005:l022","ordinal":114447,"en":"Not merely of one nest, but born in succession,"},{"id":"semetey-1-2013:p0489:b005:l023","ordinal":114448,"en":"Their belts firmly girded."},{"id":"semetey-1-2013:p0489:b005:l024","ordinal":114449,"en":"That unbeliever went to China and was born."},{"id":"semetey-1-2013:p0489:b005:l025","ordinal":114450,"en":"In Beijing's sacred well"},{"id":"semetey-1-2013:p0489:b005:l026","ordinal":114451,"en":"He went and bathed for six months."},{"id":"semetey-1-2013:p0489:b005:l027","ordinal":114452,"en":"At Közkaman's appearance,"},{"id":"semetey-1-2013:p0489:b005:l028","ordinal":114453,"en":"Those who saw him were frightened."},{"id":"semetey-1-2013:p0489:b005:l029","ordinal":114454,"en":"The law of the Chinese"},{"id":"semetey-1-2013:p0489:b005:l030","ordinal":114455,"en":"He had studied thoroughly."},{"id":"semetey-1-2013:p0489:b005:l031","ordinal":114456,"en":"Reciting wondrous spells,"},{"id":"semetey-1-2013:p0489:b005:l032","ordinal":114457,"en":"Those who heard Közkaman's name trembled."},{"id":"semetey-1-2013:p0489:b005:l034","ordinal":114458,"en":"Dust rose from his passage,"},{"id":"semetey-1-2013:p0489:b005:l035","ordinal":114459,"en":"Lives fled before his wrath."},{"id":"semetey-1-2013:p0489:b005:l036","ordinal":114460,"en":"He shattered those he met,"},{"id":"semetey-1-2013:p0489:b005:l037","ordinal":114461,"en":"Destroyed whoever crossed his path."},{"id":"semetey-1-2013:p0489:b005:l038","ordinal":114462,"en":"Kökchököz and Közkaman,"},{"id":"semetey-1-2013:p0489:b005:l039","ordinal":114463,"en":"Skilled horsemen, swift on foot,"},{"id":"semetey-1-2013:p0490:b003:l001","ordinal":114464,"en":"A great wrestler in state service,"},{"id":"semetey-1-2013:p0490:b003:l002","ordinal":114465,"en":"Who spared no life when grappling,"},{"id":"semetey-1-2013:p0490:b003:l003","ordinal":114466,"en":"Who could never drink his fill of blood."},{"id":"semetey-1-2013:p0490:b003:l004","ordinal":114467,"en":"From the very first day, his conduct"},{"id":"semetey-1-2013:p0490:b003:l005","ordinal":114468,"en":"In every place he reached"},{"id":"semetey-1-2013:p0490:b003:l006","ordinal":114469,"en":"Was to sow disorder."},{"id":"semetey-1-2013:p0490:b003:l007","ordinal":114470,"en":"He was the man Karykan of Beijing"},{"id":"semetey-1-2013:p0490:b003:l008","ordinal":114471,"en":"Trusted firmly."},{"id":"semetey-1-2013:p0490:b003:l009","ordinal":114472,"en":"Among the khagan's forty Chinese tribes,"},{"id":"semetey-1-2013:p0490:b003:l010","ordinal":114473,"en":"He was khan of one tribe."},{"id":"semetey-1-2013:p0490:b003:l011","ordinal":114474,"en":"He was the support they relied upon;"},{"id":"semetey-1-2013:p0490:b003:l012","ordinal":114475,"en":"Against all who faced him,"},{"id":"semetey-1-2013:p0490:b003:l013","ordinal":114476,"en":"He too was the hero who brought devastation."},{"id":"semetey-1-2013:p0490:b003:l014","ordinal":114477,"en":"After giving the warrior a strong poison,"},{"id":"semetey-1-2013:p0490:b003:l015","ordinal":114478,"en":"He set out toward Beijing,"},{"id":"semetey-1-2013:p0490:b003:l016","ordinal":114479,"en":"Loading gold coins upon elephants."},{"id":"semetey-1-2013:p0490:b003:l017","ordinal":114480,"en":"“The destroyer Manas is dead;"},{"id":"semetey-1-2013:p0490:b003:l018","ordinal":114481,"en":"He has seen the other world,” he said."},{"id":"semetey-1-2013:p0490:b003:l019","ordinal":114482,"en":"From the Kyrgyz girls,"},{"id":"semetey-1-2013:p0490:b003:l020","ordinal":114483,"en":"Thimble-mouthed, camel-calf-eyed,"},{"id":"semetey-1-2013:p0490:b003:l021","ordinal":114484,"en":"Coquettish beauties,"},{"id":"semetey-1-2013:p0490:b003:l022","ordinal":114485,"en":"He chose a thousand as booty."},{"id":"semetey-1-2013:p0490:b003:l023","ordinal":114486,"en":"He plundered their possessions,"},{"id":"semetey-1-2013:p0490:b003:l024","ordinal":114487,"en":"Wrought thorough destruction."},{"id":"semetey-1-2013:p0490:b003:l025","ordinal":114488,"en":"Whole otter pelts"},{"id":"semetey-1-2013:p0490:b003:l026","ordinal":114489,"en":"He tore apart"},{"id":"semetey-1-2013:p0490:b003:l027","ordinal":114490,"en":"And put upon his trouser-cuffs."},{"id":"semetey-1-2013:p0490:b003:l028","ordinal":114491,"en":"To carry away to Beijing,"},{"id":"semetey-1-2013:p0490:b003:l029","ordinal":114492,"en":"All of Khan Manas's treasure"},{"id":"semetey-1-2013:p0490:b003:l030","ordinal":114493,"en":"He loaded and traveled through the night,"},{"id":"semetey-1-2013:p0490:b003:l031","ordinal":114494,"en":"Taking it as booty."},{"id":"semetey-1-2013:p0490:b003:l032","ordinal":114495,"en":"When dawn broke bright,"},{"id":"semetey-1-2013:p0490:b003:l033","ordinal":114496,"en":"When light touched the earth,"},{"id":"semetey-1-2013:p0490:b003:l034","ordinal":114497,"en":"The stars parted overhead,"},{"id":"semetey-1-2013:p0490:b003:l035","ordinal":114498,"en":"Light poured onto the earth,"},{"id":"semetey-1-2013:p0490:b003:l036","ordinal":114499,"en":"The earth split, and the fescue"},{"id":"semetey-1-2013:p0490:b003:l037","ordinal":114500,"en":"Appeared with its grass."},{"id":"semetey-1-2013:p0490:b003:l038","ordinal":114501,"en":"Khan Manas's forty zaisans,"},{"id":"semetey-1-2013:p0490:b003:l039","ordinal":114502,"en":"The mighty Bakai and Almambet,"},{"id":"semetey-1-2013:p0490:b004:l001","ordinal":114503,"en":"The champion attacking from afar,"},{"id":"semetey-1-2013:p0490:b004:l002","ordinal":114504,"en":"Beyond any man's strength in a grapple,"},{"id":"semetey-1-2013:p0490:b004:l003","ordinal":114505,"en":"Chubak, son of Akbaltai,"},{"id":"semetey-1-2013:p0490:b004:l004","ordinal":114506,"en":"That supremely renowned hero."},{"id":"semetey-1-2013:p0490:b004:l005","ordinal":114507,"en":"Did they know of them,"},{"id":"semetey-1-2013:p0490:b004:l006","ordinal":114508,"en":"Khan Manas's renowned"},{"id":"semetey-1-2013:p0490:b004:l007","ordinal":114509,"en":"Warriors, his forty companions?"},{"id":"semetey-1-2013:p0490:b004:l008","ordinal":114510,"en":"Kökchököz and Közkaman,"},{"id":"semetey-1-2013:p0490:b004:l009","ordinal":114511,"en":"Ögüz-Ashuu and Tai-Ashuu—"},{"id":"semetey-1-2013:p0490:b004:l010","ordinal":114512,"en":"When they crossed these routes,"},{"id":"semetey-1-2013:p0490:b004:l011","ordinal":114513,"en":"Beyond them lay Chong-Zhyldyz."},{"id":"semetey-1-2013:p0490:b004:l012","ordinal":114514,"en":"Resting their horses, sleeping,"},{"id":"semetey-1-2013:p0490:b004:l013","ordinal":114515,"en":"The men lay down together."},{"id":"semetey-1-2013:p0490:b004:l014","ordinal":114516,"en":"Közkaman rushed in haste"},{"id":"semetey-1-2013:p0490:b004:l015","ordinal":114517,"en":"When Khan Manas's forty warriors"},{"id":"semetey-1-2013:p0490:b004:l016","ordinal":114518,"en":"Came down upon them."},{"id":"semetey-1-2013:p0490:b004:l017","ordinal":114519,"en":"The most skillful spearman"},{"id":"semetey-1-2013:p0490:b004:l018","ordinal":114520,"en":"Among those fugitives"},{"id":"semetey-1-2013:p0490:b004:l019","ordinal":114521,"en":"Was the mighty gray-maned Kökchököz."},{"id":"semetey-1-2013:p0490:b004:l020","ordinal":114522,"en":"Without looking about him,"},{"id":"semetey-1-2013:p0490:b004:l021","ordinal":114523,"en":"He spurred on and fought,"},{"id":"semetey-1-2013:p0490:b004:l022","ordinal":114524,"en":"Sparing his life not at all."},{"id":"semetey-1-2013:p0490:b004:l023","ordinal":114525,"en":"Calling out, putting forth his plea,"},{"id":"semetey-1-2013:p0490:b004:l024","ordinal":114526,"en":"Közkaman standing there said:"},{"id":"semetey-1-2013:p0490:b004:l025","ordinal":114527,"en":"“Khan Manas's forty champions,"},{"id":"semetey-1-2013:p0490:b004:l026","ordinal":114528,"en":"Turn your horses this way."},{"id":"semetey-1-2013:p0490:b004:l027","ordinal":114529,"en":"To a single combat with spears"},{"id":"semetey-1-2013:p0490:b004:l028","ordinal":114530,"en":"I pledge myself; stand and face me!"},{"id":"semetey-1-2013:p0490:b004:l029","ordinal":114531,"en":"If you defeat me with your spear,"},{"id":"semetey-1-2013:p0490:b004:l030","ordinal":114532,"en":"I will go and settle in Talas;"},{"id":"semetey-1-2013:p0490:b004:l031","ordinal":114533,"en":"I will become a true Muslim!"},{"id":"semetey-1-2013:p0490:b004:l032","ordinal":114534,"en":"I will eat white wheat flour."},{"id":"semetey-1-2013:p0490:b004:l033","ordinal":114535,"en":"Never again to practice discord or villainy,"},{"id":"semetey-1-2013:p0490:b004:l035","ordinal":114536,"en":"I will hold to the holy creed."},{"id":"semetey-1-2013:p0490:b004:l036","ordinal":114537,"en":"Of Almighty God"},{"id":"semetey-1-2013:p0490:b004:l037","ordinal":114538,"en":"I will acknowledge the oneness."},{"id":"semetey-1-2013:p0490:b004:l038","ordinal":114539,"en":"Bakai, listen carefully to my words,"},{"id":"semetey-1-2013:p0490:b004:l039","ordinal":114540,"en":"Without saying this or that,"},{"id":"semetey-1-2013:p0491:b003:l001","ordinal":114541,"en":"I will enter your true faith!"},{"id":"semetey-1-2013:p0491:b003:l002","ordinal":114542,"en":"If I defeat you with my spear,"},{"id":"semetey-1-2013:p0491:b003:l003","ordinal":114543,"en":"Go and settle under the khagan."},{"id":"semetey-1-2013:p0491:b003:l004","ordinal":114544,"en":"Say that the idol is God,"},{"id":"semetey-1-2013:p0491:b003:l005","ordinal":114545,"en":"And truly become an unbeliever with us!"},{"id":"semetey-1-2013:p0491:b003:l006","ordinal":114546,"en":"Let us mark out a place,"},{"id":"semetey-1-2013:p0491:b003:l007","ordinal":114547,"en":"Let us measure the ground."},{"id":"semetey-1-2013:p0491:b003:l008","ordinal":114548,"en":"My forty lords against forty companions,"},{"id":"semetey-1-2013:p0491:b003:l009","ordinal":114549,"en":"Let us hold single combats."},{"id":"semetey-1-2013:p0491:b003:l010","ordinal":114550,"en":"Fortunate Bakai, leopard,"},{"id":"semetey-1-2013:p0491:b003:l011","ordinal":114551,"en":"Fighting one against one,"},{"id":"semetey-1-2013:p0491:b003:l012","ordinal":114552,"en":"Let us leave no regrets!"},{"id":"semetey-1-2013:p0491:b003:l013","ordinal":114553,"en":"One prince’s attendant,"},{"id":"semetey-1-2013:p0491:b003:l014","ordinal":114554,"en":"The custom is six by six."},{"id":"semetey-1-2013:p0491:b003:l015","ordinal":114555,"en":"If you truly are a khan,"},{"id":"semetey-1-2013:p0491:b003:l016","ordinal":114556,"en":"My khan Bakai, leopard”—"},{"id":"semetey-1-2013:p0491:b003:l017","ordinal":114557,"en":"These were Kökchököz's words."},{"id":"semetey-1-2013:p0491:b003:l018","ordinal":114558,"en":"Fortunate Bakai heard him"},{"id":"semetey-1-2013:p0491:b003:l019","ordinal":114559,"en":"And gave the unbeliever his turn."},{"id":"semetey-1-2013:p0491:b003:l020","ordinal":114560,"en":"To what the dark Manchu and Chinese"},{"id":"semetey-1-2013:p0491:b003:l021","ordinal":114561,"en":"Had said, he agreed."},{"id":"semetey-1-2013:p0491:b003:l022","ordinal":114562,"en":"Almambet and Bakai, matching in name,"},{"id":"semetey-1-2013:p0491:b003:l023","ordinal":114563,"en":"Sent round among the forty zaisans,"},{"id":"semetey-1-2013:p0491:b003:l024","ordinal":114564,"en":"Set them filing out,"},{"id":"semetey-1-2013:p0491:b003:l025","ordinal":114565,"en":"And began to choose a hero."},{"id":"semetey-1-2013:p0491:b003:l026","ordinal":114566,"en":"Khan Manas's forty wolves,"},{"id":"semetey-1-2013:p0491:b003:l027","ordinal":114567,"en":"Some of them confused,"},{"id":"semetey-1-2013:p0491:b003:l028","ordinal":114568,"en":"Some competing for the duel,"},{"id":"semetey-1-2013:p0491:b003:l029","ordinal":114569,"en":"Saying, “I will go!”"},{"id":"semetey-1-2013:p0491:b003:l030","ordinal":114570,"en":"They readied their spears,"},{"id":"semetey-1-2013:p0491:b003:l031","ordinal":114571,"en":"All prepared their winged steeds."},{"id":"semetey-1-2013:p0491:b003:l032","ordinal":114572,"en":"The decree of the Creator,"},{"id":"semetey-1-2013:p0491:b003:l033","ordinal":114573,"en":"Should it fall upon them, they acknowledged."},{"id":"semetey-1-2013:p0491:b003:l034","ordinal":114574,"en":"Helmets of blue iron"},{"id":"semetey-1-2013:p0491:b003:l035","ordinal":114575,"en":"They set upside down upon their heads."},{"id":"semetey-1-2013:p0491:b003:l036","ordinal":114576,"en":"In wrath, that"},{"id":"semetey-1-2013:p0491:b003:l037","ordinal":114577,"en":"Leopard Bakai roared:"},{"id":"semetey-1-2013:p0491:b003:l038","ordinal":114578,"en":"“Khan Manas's forty zaisans,"},{"id":"semetey-1-2013:p0491:b003:l039","ordinal":114579,"en":"Come here!” he called."},{"id":"semetey-1-2013:p0491:b005:l001","ordinal":114580,"en":"“Khan Manas's forty zaisans,"},{"id":"semetey-1-2013:p0491:b005:l002","ordinal":114581,"en":"Let your hero among spearmen come;"},{"id":"semetey-1-2013:p0491:b005:l003","ordinal":114582,"en":"Let your ruthless lion come."},{"id":"semetey-1-2013:p0491:b005:l004","ordinal":114583,"en":"Come all, without hanging back;"},{"id":"semetey-1-2013:p0491:b005:l005","ordinal":114584,"en":"Let your khan who shatters peoples come!"},{"id":"semetey-1-2013:p0491:b005:l006","ordinal":114585,"en":"I will slaughter all forty companions,"},{"id":"semetey-1-2013:p0491:b005:l007","ordinal":114586,"en":"Unless your hearts are foolish."},{"id":"semetey-1-2013:p0491:b005:l008","ordinal":114587,"en":"Damn your fathers' graves, forty companions!"},{"id":"semetey-1-2013:p0491:b005:l009","ordinal":114588,"en":"This is your time to shatter peoples!"},{"id":"semetey-1-2013:p0491:b005:l010","ordinal":114589,"en":"What you lost has been found,"},{"id":"semetey-1-2013:p0491:b005:l011","ordinal":114590,"en":"Your honor covered as with ash."},{"id":"semetey-1-2013:p0491:b005:l012","ordinal":114591,"en":"Champions who lie in idleness,"},{"id":"semetey-1-2013:p0491:b005:l013","ordinal":114592,"en":"Here you have found your diversion."},{"id":"semetey-1-2013:p0491:b005:l014","ordinal":114593,"en":"My dear forty companions,"},{"id":"semetey-1-2013:p0491:b005:l015","ordinal":114594,"en":"When the black gun cracks,"},{"id":"semetey-1-2013:p0491:b005:l016","ordinal":114595,"en":"Do not flee and boil my misery!"},{"id":"semetey-1-2013:p0491:b005:l017","ordinal":114596,"en":"When the fierce gun snaps,"},{"id":"semetey-1-2013:p0491:b005:l018","ordinal":114597,"en":"Do not start with fear and boil my misery!"},{"id":"semetey-1-2013:p0491:b005:l019","ordinal":114598,"en":"Damn your fathers' graves, forty zaisans!"},{"id":"semetey-1-2013:p0491:b005:l020","ordinal":114599,"en":"All forty of you were lions from forty places;"},{"id":"semetey-1-2013:p0491:b005:l022","ordinal":114600,"en":"All forty were wolves for Khan Manas."},{"id":"semetey-1-2013:p0491:b005:l023","ordinal":114601,"en":"Each of you, my forty companions,"},{"id":"semetey-1-2013:p0491:b005:l024","ordinal":114602,"en":"Has a lion's fearsome majesty."},{"id":"semetey-1-2013:p0491:b005:l025","ordinal":114603,"en":"Közkaman comes out to fight;"},{"id":"semetey-1-2013:p0491:b005:l026","ordinal":114604,"en":"Which of you will go to single combat?"},{"id":"semetey-1-2013:p0491:b005:l027","ordinal":114605,"en":"Think well, forty companions:"},{"id":"semetey-1-2013:p0491:b005:l028","ordinal":114606,"en":"Which of you will go to the duel?"},{"id":"semetey-1-2013:p0491:b005:l029","ordinal":114607,"en":"For wounded Sultan Manas,"},{"id":"semetey-1-2013:p0491:b005:l030","ordinal":114608,"en":"Whether it brings sin or merit,"},{"id":"semetey-1-2013:p0491:b005:l031","ordinal":114609,"en":"Which of you will take up the duty?"},{"id":"semetey-1-2013:p0491:b005:l032","ordinal":114610,"en":"My dear ones from forty places,"},{"id":"semetey-1-2013:p0491:b005:l033","ordinal":114611,"en":"Which of you will go to the spear-contest?"},{"id":"semetey-1-2013:p0491:b005:l034","ordinal":114612,"en":"Which of you will raise the dust?"},{"id":"semetey-1-2013:p0491:b005:l035","ordinal":114613,"en":"Consider it, forty champions:"},{"id":"semetey-1-2013:p0491:b005:l036","ordinal":114614,"en":"Which of you will go to battle?"},{"id":"semetey-1-2013:p0491:b005:l037","ordinal":114615,"en":"Does not a mortal creature die?"},{"id":"semetey-1-2013:p0491:b005:l038","ordinal":114616,"en":"Damn your fathers' graves, forty champions!"},{"id":"semetey-1-2013:p0491:b005:l039","ordinal":114617,"en":"Which of you will win honor?"},{"id":"semetey-1-2013:p0492:b003:l001","ordinal":114618,"en":"Fortunate when I send you into battle,"},{"id":"semetey-1-2013:p0492:b003:l002","ordinal":114619,"en":"Like a countless army when I lead you,"},{"id":"semetey-1-2013:p0492:b003:l003","ordinal":114620,"en":"You too are standing here.”"},{"id":"semetey-1-2013:p0492:b003:l004","ordinal":114621,"en":"Your khan Bakai roared,"},{"id":"semetey-1-2013:p0492:b003:l005","ordinal":114622,"en":"Calling the forty champions."},{"id":"semetey-1-2013:p0492:b003:l006","ordinal":114623,"en":"“Golden forelock, tasseled belt,"},{"id":"semetey-1-2013:p0492:b003:l007","ordinal":114624,"en":"The only son of Azyz Khan—"},{"id":"semetey-1-2013:p0492:b003:l008","ordinal":114625,"en":"My red spear-banner,"},{"id":"semetey-1-2013:p0492:b003:l009","ordinal":114626,"en":"My gift that came from China,"},{"id":"semetey-1-2013:p0492:b003:l010","ordinal":114627,"en":"Leopard who came from the khagan,"},{"id":"semetey-1-2013:p0492:b003:l011","ordinal":114628,"en":"Pillar of my only one, Khan Manas,"},{"id":"semetey-1-2013:p0492:b003:l012","ordinal":114629,"en":"Almambet, you stand here."},{"id":"semetey-1-2013:p0492:b003:l013","ordinal":114630,"en":"Against the dark Kalmyk weather-sorcerer,"},{"id":"semetey-1-2013:p0492:b003:l014","ordinal":114631,"en":"Which of you will devise a way?”"},{"id":"semetey-1-2013:p0492:b003:l015","ordinal":114632,"en":"When Bakai Khan had spoken thus,"},{"id":"semetey-1-2013:p0492:b003:l016","ordinal":114633,"en":"Before he could close his mouth,"},{"id":"semetey-1-2013:p0492:b003:l017","ordinal":114634,"en":"The finest of the sixty,"},{"id":"semetey-1-2013:p0492:b003:l018","ordinal":114635,"en":"The champion of the forty companions,"},{"id":"semetey-1-2013:p0492:b003:l019","ordinal":114636,"en":"Riding a splendid courser,"},{"id":"semetey-1-2013:p0492:b003:l020","ordinal":114637,"en":"Wearing a coat blue as iron,"},{"id":"semetey-1-2013:p0492:b003:l021","ordinal":114638,"en":"Not shrinking a hair's breadth from death,"},{"id":"semetey-1-2013:p0492:b003:l022","ordinal":114639,"en":"Not turning back when sent into battle,"},{"id":"semetey-1-2013:p0492:b003:l023","ordinal":114640,"en":"Rejoicing at the mention of death,"},{"id":"semetey-1-2013:p0492:b003:l024","ordinal":114641,"en":"Known to be a khan,"},{"id":"semetey-1-2013:p0492:b003:l025","ordinal":114642,"en":"Never shedding his stern expression,"},{"id":"semetey-1-2013:p0492:b003:l026","ordinal":114643,"en":"Never retreating from a challenge,"},{"id":"semetey-1-2013:p0492:b003:l027","ordinal":114644,"en":"Light upon a horse, suited to a yearling,"},{"id":"semetey-1-2013:p0492:b003:l028","ordinal":114645,"en":"Short of sleep, watchful on the road,"},{"id":"semetey-1-2013:p0492:b003:l029","ordinal":114646,"en":"The edge of black steel—"},{"id":"semetey-1-2013:p0492:b003:l030","ordinal":114647,"en":"Have you heard of him?"},{"id":"semetey-1-2013:p0492:b003:l031","ordinal":114648,"en":"He too was of princely stock,"},{"id":"semetey-1-2013:p0492:b003:l032","ordinal":114649,"en":"Khan Manas's Syrgak,"},{"id":"semetey-1-2013:p0492:b003:l033","ordinal":114650,"en":"Who could throw the whole world into turmoil,"},{"id":"semetey-1-2013:p0492:b003:l034","ordinal":114651,"en":"My dear young scamp."},{"id":"semetey-1-2013:p0492:b003:l035","ordinal":114652,"en":"If he lived and grew to maturity,"},{"id":"semetey-1-2013:p0492:b003:l036","ordinal":114653,"en":"His strength would reach the whole world."},{"id":"semetey-1-2013:p0492:b003:l037","ordinal":114654,"en":"Manas and this Syrgak"},{"id":"semetey-1-2013:p0492:b003:l038","ordinal":114655,"en":"Were sons of brothers."},{"id":"semetey-1-2013:p0492:b003:l039","ordinal":114656,"en":"Of middling height, broad-shouldered,"},{"id":"semetey-1-2013:p0492:b004:l001","ordinal":114657,"en":"Renowned Syrgak the destroyer—"},{"id":"semetey-1-2013:p0492:b004:l002","ordinal":114658,"en":"His time to wreak destruction had come."},{"id":"semetey-1-2013:p0492:b004:l003","ordinal":114659,"en":"Khan Syrgak, son of Ulakkan,"},{"id":"semetey-1-2013:p0492:b004:l004","ordinal":114660,"en":"Turned Kökchebich's head."},{"id":"semetey-1-2013:p0492:b004:l005","ordinal":114661,"en":"“Gray-maned Bakai, dear Almambet,"},{"id":"semetey-1-2013:p0492:b004:l006","ordinal":114662,"en":"Look at me and hear my words!"},{"id":"semetey-1-2013:p0492:b004:l007","ordinal":114663,"en":"With the fugitive of our own stock"},{"id":"semetey-1-2013:p0492:b004:l008","ordinal":114664,"en":"I would join combat,"},{"id":"semetey-1-2013:p0492:b004:l009","ordinal":114665,"en":"To die if death arrives,"},{"id":"semetey-1-2013:p0492:b004:l010","ordinal":114666,"en":"Or, if I have the means, Khan Bakai,"},{"id":"semetey-1-2013:p0492:b004:l011","ordinal":114667,"en":"Upon the unbeliever of the Kalmyk faith"},{"id":"semetey-1-2013:p0492:b004:l012","ordinal":114668,"en":"To inflict humiliation,"},{"id":"semetey-1-2013:p0492:b004:l013","ordinal":114669,"en":"Crossing spears and breaking ranks,"},{"id":"semetey-1-2013:p0492:b004:l014","ordinal":114670,"en":"Falling to a bullet if my death has come,"},{"id":"semetey-1-2013:p0492:b004:l015","ordinal":114671,"en":"Facing the pit already dug,"},{"id":"semetey-1-2013:p0492:b004:l016","ordinal":114672,"en":"Facing the misery already boiled,"},{"id":"semetey-1-2013:p0492:b004:l017","ordinal":114673,"en":"Stopping only short of death,"},{"id":"semetey-1-2013:p0492:b004:l018","ordinal":114674,"en":"Against that Kalmyk servant"},{"id":"semetey-1-2013:p0492:b004:l019","ordinal":114675,"en":"Fighting to the utmost like this..."},{"id":"semetey-1-2013:p0492:b004:l020","ordinal":114676,"en":"Uncle Bakai, Almambet,"},{"id":"semetey-1-2013:p0492:b004:l021","ordinal":114677,"en":"My lions, give your blessing!"},{"id":"semetey-1-2013:p0492:b004:l022","ordinal":114678,"en":"If death draws near,"},{"id":"semetey-1-2013:p0492:b004:l023","ordinal":114679,"en":"Let me see the face of the other world."},{"id":"semetey-1-2013:p0492:b004:l024","ordinal":114680,"en":"Otherwise, if the Creator grants me honor,"},{"id":"semetey-1-2013:p0492:b004:l025","ordinal":114681,"en":"The troops of those fugitive Chinese ahead"},{"id":"semetey-1-2013:p0492:b004:l026","ordinal":114682,"en":"I will split in two."},{"id":"semetey-1-2013:p0492:b004:l027","ordinal":114683,"en":"Közkaman who harmed my uncle—"},{"id":"semetey-1-2013:p0492:b004:l028","ordinal":114684,"en":"If I catch him, I will spill his blood."},{"id":"semetey-1-2013:p0492:b004:l029","ordinal":114685,"en":"I will slaughter him as a sacrifice,"},{"id":"semetey-1-2013:p0492:b004:l030","ordinal":114686,"en":"Have him dragged along the road,"},{"id":"semetey-1-2013:p0492:b004:l031","ordinal":114687,"en":"For the wretch who abandoned proper conduct"},{"id":"semetey-1-2013:p0492:b004:l032","ordinal":114688,"en":"I will make a spectacle!"}]
