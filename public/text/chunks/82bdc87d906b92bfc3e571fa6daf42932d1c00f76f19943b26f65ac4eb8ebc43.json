[{"id":"sayakbay-ms-current144:pdf056:l023","ordinal":392449,"en":"Gnawing whatever crossed its path,"},{"id":"sayakbay-ms-current144:pdf056:l027","ordinal":392450,"en":"Every living beast and creature,"},{"id":"sayakbay-ms-current144:pdf056:l030","ordinal":392451,"en":"Scorched, [scattering sand,]"},{"id":"sayakbay-ms-current144:pdf056:l033","ordinal":392452,"en":"[The two hunting dogs Seytek set loose,]"},{"id":"sayakbay-ms-current144:pdf057:l001","ordinal":392453,"en":"[All creatures despaired of life,]"},{"id":"sayakbay-ms-current144:pdf057:l002","ordinal":392454,"en":"What has happened,"},{"id":"sayakbay-ms-current144:pdf057:l003","ordinal":392455,"en":"She pondered within her dream."},{"id":"sayakbay-ms-current144:pdf057:l014","ordinal":392456,"en":"All the fanged beasts,"},{"id":"sayakbay-ms-current144:pdf057:l018","ordinal":392457,"en":"The four corners of the world,"},{"id":"sayakbay-ms-current144:pdf057:l024","ordinal":392458,"en":"Every renowned place,"},{"id":"sayakbay-ms-current144:pdf058:l002","ordinal":392459,"en":"Riding far, exploring the land,"},{"id":"sayakbay-ms-current144:pdf058:l008","ordinal":392460,"en":"The noble leopard Seytek,"},{"id":"sayakbay-ms-current144:pdf058:l024","ordinal":392461,"en":"Fighting, he could not prevail,"},{"id":"sayakbay-ms-current144:pdf058:l026","ordinal":392462,"en":"It came to rest in the west."},{"id":"sayakbay-ms-current144:pdf058:l027","ordinal":392463,"en":"Scorching the face of the earth,"},{"id":"sayakbay-ms-current144:pdf059:l001","ordinal":392464,"en":"[What he was to do,]"},{"id":"sayakbay-ms-current144:pdf059:l021","ordinal":392465,"en":"The crops they had sown,"},{"id":"sayakbay-ms-current144:pdf059:l023","ordinal":392466,"en":"Those who resisted,"},{"id":"sayakbay-ms-current144:pdf059:l024","ordinal":392467,"en":"It swallowed like flies."},{"id":"sayakbay-ms-current144:pdf059:l030","ordinal":392468,"en":"Those who resisted,"},{"id":"sayakbay-ms-current144:pdf060:l004","ordinal":392469,"en":"Unfortunate Perizaada,"},{"id":"sayakbay-ms-current144:pdf060:l008","ordinal":392470,"en":"The lady Perizaada,"},{"id":"sayakbay-ms-current144:pdf060:l016","ordinal":392471,"en":"The noble leopard Seytek,"},{"id":"sayakbay-ms-current144:pdf060:l018","ordinal":392472,"en":"Dipping his hands in water,"},{"id":"sayakbay-ms-current144:pdf060:l019","ordinal":392473,"en":"The two cycles of dawn prayer,"},{"id":"sayakbay-ms-current144:pdf060:l020","ordinal":392474,"en":"He now performed in the morning,"},{"id":"sayakbay-ms-current144:pdf060:l023","ordinal":392475,"en":"He saddled Kulunsur,"},{"id":"sayakbay-ms-current144:pdf060:l024","ordinal":392476,"en":"Of the prancing dark horse,"},{"id":"sayakbay-ms-current144:pdf060:l027","ordinal":392477,"en":"Lest it chafe his hands,"},{"id":"sayakbay-ms-current144:pdf061:l004","ordinal":392478,"en":"Its rear entirely silver,"},{"id":"sayakbay-ms-current144:pdf061:l005","ordinal":392479,"en":"Its two sides of broad iron,"},{"id":"sayakbay-ms-current144:pdf061:l026","ordinal":392480,"en":"So he would not falter in battle,"},{"id":"sayakbay-ms-current144:pdf061:l028","ordinal":392481,"en":"Not to press the horse's flanks,"},{"id":"sayakbay-ms-current144:pdf062:l002","ordinal":392482,"en":"The carefully crafted saddle,"},{"id":"sayakbay-ms-current144:pdf062:l003","ordinal":392483,"en":"Remember us who fashioned it,"},{"id":"sayakbay-ms-current144:pdf062:l004","ordinal":392484,"en":"[Saddling and mounting the horse,]"},{"id":"sayakbay-ms-current144:pdf062:l005","ordinal":392485,"en":"To saddle it for distant journeys,"},{"id":"sayakbay-ms-current144:pdf062:l006","ordinal":392486,"en":"[The ironworker's steadfast purpose,]"},{"id":"sayakbay-ms-current144:pdf062:l007","ordinal":392487,"en":"Setting a wondrous value upon it,"},{"id":"sayakbay-ms-current144:pdf062:l008","ordinal":392488,"en":"Honoring him, soothing his heart,"},{"id":"sayakbay-ms-current144:pdf062:l009","ordinal":392489,"en":"Reading prayers for the departed,"},{"id":"sayakbay-ms-current144:pdf062:l010","ordinal":392490,"en":"Calling him the generous hero,"},{"id":"sayakbay-ms-current144:pdf062:l013","ordinal":392491,"en":"He saddled Kulunsur,"},{"id":"sayakbay-ms-current144:pdf062:l022","ordinal":392492,"en":"Rejoicing at the mention of death,"},{"id":"sayakbay-ms-current144:pdf062:l031","ordinal":392493,"en":"The lion Akjoltoy,"},{"id":"sayakbay-ms-current144:pdf063:l001","ordinal":392494,"en":"Riding a horse like Kulunsur,"},{"id":"sayakbay-ms-current144:pdf063:l010","ordinal":392495,"en":"[Like a lion guarding a fortress,]"},{"id":"sayakbay-ms-current144:pdf063:l011","ordinal":392496,"en":"[His accustomed fury was mighty,]"},{"id":"sayakbay-ms-current144:pdf063:l012","ordinal":392497,"en":"[Like one protecting countless troops,]"},{"id":"sayakbay-ms-current144:pdf063:l013","ordinal":392498,"en":"If bitter enemies came,"},{"id":"sayakbay-ms-current144:pdf063:l014","ordinal":392499,"en":"If a mighty challenger came to fight,"},{"id":"sayakbay-ms-current144:pdf063:l015","ordinal":392500,"en":"[If a host came by divine power,]"},{"id":"sayakbay-ms-current144:pdf063:l016","ordinal":392501,"en":"[If pointed missiles came in battle,]"},{"id":"sayakbay-ms-current144:pdf063:l017","ordinal":392502,"en":"He never turned back, showing no concern,"},{"id":"sayakbay-ms-current144:pdf063:l018","ordinal":392503,"en":"[Striking with his weapon,]"},{"id":"sayakbay-ms-current144:pdf063:l019","ordinal":392504,"en":"[He would not compare it to his people,]"},{"id":"sayakbay-ms-current144:pdf063:l020","ordinal":392505,"en":"In courage and heroic strength,"},{"id":"sayakbay-ms-current144:pdf063:l021","ordinal":392506,"en":"He knew his people well,"},{"id":"sayakbay-ms-current144:pdf063:l022","ordinal":392507,"en":"He was an immeasurable hero."},{"id":"sayakbay-ms-current144:pdf063:l024","ordinal":392508,"en":"A noble champion, a mighty lion,"},{"id":"sayakbay-ms-current144:pdf063:l025","ordinal":392509,"en":"Renowned among his people."},{"id":"sayakbay-ms-current144:pdf063:l026","ordinal":392510,"en":"[One who gathered his mighty leopards,]"},{"id":"sayakbay-ms-current144:pdf063:l027","ordinal":392511,"en":"Of the noble hero Seytek,"},{"id":"sayakbay-ms-current144:pdf063:l028","ordinal":392512,"en":"[One who continued his journeys,]"},{"id":"sayakbay-ms-current144:pdf063:l029","ordinal":392513,"en":"[He destroys their banner, leveling it,]"},{"id":"sayakbay-ms-current144:pdf063:l030","ordinal":392514,"en":"He makes his enemies his subjects,"},{"id":"sayakbay-ms-current144:pdf064:l001","ordinal":392515,"en":"[Making the level land his own,]"},{"id":"sayakbay-ms-current144:pdf064:l002","ordinal":392516,"en":"[Making the surviving people his subjects,]"},{"id":"sayakbay-ms-current144:pdf064:l003","ordinal":392517,"en":"[A warrior who knew many paths,]"},{"id":"sayakbay-ms-current144:pdf064:l004","ordinal":392518,"en":"A far-seeing wise man,"},{"id":"sayakbay-ms-current144:pdf064:l005","ordinal":392519,"en":"Among the multitude,"},{"id":"sayakbay-ms-current144:pdf064:l007","ordinal":392520,"en":"[Speaking calmly of …,]"},{"id":"sayakbay-ms-current144:pdf064:l008","ordinal":392521,"en":"[Fortune that shattered what split apart,]"},{"id":"sayakbay-ms-current144:pdf064:l009","ordinal":392522,"en":"Many enemies rose against him,"},{"id":"sayakbay-ms-current144:pdf064:l010","ordinal":392523,"en":"The Kalmyks numbering forty thousand,"},{"id":"sayakbay-ms-current144:pdf064:l011","ordinal":392524,"en":"[Karachyt stood apart,]"},{"id":"sayakbay-ms-current144:pdf064:l012","ordinal":392525,"en":"[The reason he became Karakan,]"},{"id":"sayakbay-ms-current144:pdf064:l013","ordinal":392526,"en":"[The Jediger within the seven,]"},{"id":"sayakbay-ms-current144:pdf064:l014","ordinal":392527,"en":"When the youth assembled an army,"},{"id":"sayakbay-ms-current144:pdf064:l015","ordinal":392528,"en":"[Turning the age upside down,]"},{"id":"sayakbay-ms-current144:pdf064:l016","ordinal":392529,"en":"Kankoro, son of Chubak,"},{"id":"sayakbay-ms-current144:pdf064:l017","ordinal":392530,"en":"When he performed lionlike deeds,"},{"id":"sayakbay-ms-current144:pdf064:l018","ordinal":392531,"en":"At a young age, unaware of death,"},{"id":"sayakbay-ms-current144:pdf064:l019","ordinal":392532,"en":"At that time Akjoltoy,"},{"id":"sayakbay-ms-current144:pdf064:l020","ordinal":392533,"en":"Was a boy just thirteen,"},{"id":"sayakbay-ms-current144:pdf064:l021","ordinal":392534,"en":"[Not yet fully grown,]"},{"id":"sayakbay-ms-current144:pdf064:l022","ordinal":392535,"en":"[Not yet filled out into manhood,]"},{"id":"sayakbay-ms-current144:pdf064:l023","ordinal":392536,"en":"After his father Kutubiy died,"},{"id":"sayakbay-ms-current144:pdf064:l024","ordinal":392537,"en":"Before he had a warrior's build,"},{"id":"sayakbay-ms-current144:pdf064:l025","ordinal":392538,"en":"[Still at the age of chasing butterflies,]"},{"id":"sayakbay-ms-current144:pdf064:l026","ordinal":392539,"en":"Joltoy was then a child,"},{"id":"sayakbay-ms-current144:pdf064:l027","ordinal":392540,"en":"[If seized, dearer than life,]"},{"id":"sayakbay-ms-current144:pdf064:l028","ordinal":392541,"en":"Evil-minded Kankoro,"},{"id":"sayakbay-ms-current144:pdf064:l030","ordinal":392542,"en":"[Ordering him to be struck,]"},{"id":"sayakbay-ms-current144:pdf064:l031","ordinal":392543,"en":"[The boy awaiting his turn,]"},{"id":"sayakbay-ms-current144:pdf064:l032","ordinal":392544,"en":"The poor child despairing of life,"},{"id":"sayakbay-ms-current144:pdf065:l001","ordinal":392545,"en":"[Darkness had overtaken his deeds,]"},{"id":"sayakbay-ms-current144:pdf065:l002","ordinal":392546,"en":"[His life lay in torment,]"},{"id":"sayakbay-ms-current144:pdf065:l003","ordinal":392547,"en":"[As noble Seytek appeared,]"},{"id":"sayakbay-ms-current144:pdf065:l004","ordinal":392548,"en":"The warrior Akjoltoy fled."},{"id":"sayakbay-ms-current144:pdf065:l005","ordinal":392549,"en":"Hearing the news, he was alarmed,"},{"id":"sayakbay-ms-current144:pdf065:l006","ordinal":392550,"en":"[The unfortunate one had remained,]"},{"id":"sayakbay-ms-current144:pdf065:l007","ordinal":392551,"en":"[With the forty and the people …,]"},{"id":"sayakbay-ms-current144:pdf065:l008","ordinal":392552,"en":"[Supported by others, he escaped,]"},{"id":"sayakbay-ms-current144:pdf065:l009","ordinal":392553,"en":"[Taking the maiden who gave counsel,]"},{"id":"sayakbay-ms-current144:pdf065:l010","ordinal":392554,"en":"Your poor mother Kanykey,"},{"id":"sayakbay-ms-current144:pdf065:l011","ordinal":392555,"en":"[So blood would not burn …,]"},{"id":"sayakbay-ms-current144:pdf065:l012","ordinal":392556,"en":"[From the departed hero's youth,]"},{"id":"sayakbay-ms-current144:pdf065:l013","ordinal":392557,"en":"[Turning from the offered life,]"},{"id":"sayakbay-ms-current144:pdf065:l014","ordinal":392558,"en":"No swift horse to ride against the foe,"},{"id":"sayakbay-ms-current144:pdf065:l015","ordinal":392559,"en":"No kinsman to offer protection,"},{"id":"sayakbay-ms-current144:pdf065:l016","ordinal":392560,"en":"His heart burning into embers,"},{"id":"sayakbay-ms-current144:pdf065:l017","ordinal":392561,"en":"With no one to counsel him,"},{"id":"sayakbay-ms-current144:pdf065:l018","ordinal":392562,"en":"[Stranded in the midst of it,]"},{"id":"sayakbay-ms-current144:pdf065:l020","ordinal":392563,"en":"No people among whom to settle,"},{"id":"sayakbay-ms-current144:pdf065:l021","ordinal":392564,"en":"Afraid of Kankoro,"},{"id":"sayakbay-ms-current144:pdf065:l022","ordinal":392565,"en":"His soul wept in sorrow,"},{"id":"sayakbay-ms-current144:pdf065:l023","ordinal":392566,"en":"[Sitting and waiting in hope,]"},{"id":"sayakbay-ms-current144:pdf065:l024","ordinal":392567,"en":"[The blood enemy had taken much,]"},{"id":"sayakbay-ms-current144:pdf065:l025","ordinal":392568,"en":"[Escaping so many threats,]"},{"id":"sayakbay-ms-current144:pdf065:l026","ordinal":392569,"en":"[Akjoltoy reading from …,]"},{"id":"sayakbay-ms-current144:pdf065:l027","ordinal":392570,"en":"[He had long been called Joltoy.]"},{"id":"sayakbay-ms-current144:pdf065:l028","ordinal":392571,"en":"[Had it lodged like a thorn?]"},{"id":"sayakbay-ms-current144:pdf065:l029","ordinal":392572,"en":"[Receiving a letter from his lone people,]"},{"id":"sayakbay-ms-current144:pdf065:l030","ordinal":392573,"en":"[With the Kyrgyz alone,]"},{"id":"sayakbay-ms-current144:pdf065:l031","ordinal":392574,"en":"[At white dawn, behind him,]"},{"id":"sayakbay-ms-current144:pdf065:l032","ordinal":392575,"en":"[Hearing much from Umay,]"},{"id":"sayakbay-ms-current144:pdf066:l001","ordinal":392576,"en":"By his command, how many were set against them?"},{"id":"sayakbay-ms-current144:pdf066:l002","ordinal":392577,"en":"Striking them, saying divine power had done it,"},{"id":"sayakbay-ms-current144:pdf066:l003","ordinal":392578,"en":"That act of repudiation was his,"},{"id":"sayakbay-ms-current144:pdf066:l004","ordinal":392579,"en":"His mother was ill-fated,"},{"id":"sayakbay-ms-current144:pdf066:l005","ordinal":392580,"en":"He struck, saying it was wrath,"},{"id":"sayakbay-ms-current144:pdf066:l006","ordinal":392581,"en":"This deed concerned the mighty Jолтой,"},{"id":"sayakbay-ms-current144:pdf066:l007","ordinal":392582,"en":"He struck, calling him a hero,"},{"id":"sayakbay-ms-current144:pdf066:l008","ordinal":392583,"en":"Treating Akjoltoy as of little worth,"},{"id":"sayakbay-ms-current144:pdf066:l009","ordinal":392584,"en":"Turmoil had fallen upon his head,"},{"id":"sayakbay-ms-current144:pdf066:l010","ordinal":392585,"en":"He spoke a false offering,"},{"id":"sayakbay-ms-current144:pdf066:l011","ordinal":392586,"en":"He struck the foe without surveying the ground,"},{"id":"sayakbay-ms-current144:pdf066:l012","ordinal":392587,"en":"Turning the enemy from its road,"},{"id":"sayakbay-ms-current144:pdf066:l013","ordinal":392588,"en":"The troubled souls of the age grew afraid,"},{"id":"sayakbay-ms-current144:pdf066:l014","ordinal":392589,"en":"Only three arrows encircled him,"},{"id":"sayakbay-ms-current144:pdf066:l015","ordinal":392590,"en":"Go forward and awaken,"},{"id":"sayakbay-ms-current144:pdf066:l016","ordinal":392591,"en":"They watched while blood was shed,"},{"id":"sayakbay-ms-current144:pdf066:l017","ordinal":392592,"en":"Ak Joltoy closed his eyes,"},{"id":"sayakbay-ms-current144:pdf066:l018","ordinal":392593,"en":"Dear Joltoy was a lion,"},{"id":"sayakbay-ms-current144:pdf066:l019","ordinal":392594,"en":"When they met, he overcame the warrior,"},{"id":"sayakbay-ms-current144:pdf066:l020","ordinal":392595,"en":"Breaking their ranks, he took the enemy,"},{"id":"sayakbay-ms-current144:pdf066:l021","ordinal":392596,"en":"Advancing without wavering, he took their livestock,"},{"id":"sayakbay-ms-current144:pdf066:l022","ordinal":392597,"en":"At dawn his word sent the army into attack,"},{"id":"sayakbay-ms-current144:pdf066:l023","ordinal":392598,"en":"The child’s eyes were astonished,"},{"id":"sayakbay-ms-current144:pdf066:l024","ordinal":392599,"en":"To sever his own head,"},{"id":"sayakbay-ms-current144:pdf066:l025","ordinal":392600,"en":"They made the second sultan a khan,"},{"id":"sayakbay-ms-current144:pdf066:l026","ordinal":392601,"en":"Toward Kok Bakay’s city,"},{"id":"sayakbay-ms-current144:pdf066:l027","ordinal":392602,"en":"The hearts of those who saw it were shaken,"},{"id":"sayakbay-ms-current144:pdf066:l028","ordinal":392603,"en":"His people cried out the name Seytek,"},{"id":"sayakbay-ms-current144:pdf066:l029","ordinal":392604,"en":"Sixty thousand Chinese lay there,"},{"id":"sayakbay-ms-current144:pdf066:l030","ordinal":392605,"en":"A different day of encounter had come,"},{"id":"sayakbay-ms-current144:pdf066:l031","ordinal":392606,"en":"Ak Joltoy arrived there."},{"id":"sayakbay-ms-current144:pdf067:l001","ordinal":392607,"en":"So that the hidden Chinese would not strike,"},{"id":"sayakbay-ms-current144:pdf067:l002","ordinal":392608,"en":"Seytek’s young son,"},{"id":"sayakbay-ms-current144:pdf067:l003","ordinal":392609,"en":"While Joltoy moved among them,"},{"id":"sayakbay-ms-current144:pdf067:l004","ordinal":392610,"en":"Thousands closed in from behind,"},{"id":"sayakbay-ms-current144:pdf067:l005","ordinal":392611,"en":"He leveled his sword toward the enemy,"},{"id":"sayakbay-ms-current144:pdf067:l006","ordinal":392612,"en":"He split their dark ranks and advanced,"},{"id":"sayakbay-ms-current144:pdf067:l007","ordinal":392613,"en":"Coming onto the plain, he became formidable,"},{"id":"sayakbay-ms-current144:pdf067:l008","ordinal":392614,"en":"There were grim words of battle,"},{"id":"sayakbay-ms-current144:pdf067:l009","ordinal":392615,"en":"Hero Seytek, the gray-maned warrior,"},{"id":"sayakbay-ms-current144:pdf067:l010","ordinal":392616,"en":"Recognizing the young warrior as his own,"},{"id":"sayakbay-ms-current144:pdf067:l011","ordinal":392617,"en":"Seven eagles formed his outer guard,"},{"id":"sayakbay-ms-current144:pdf067:l012","ordinal":392618,"en":"He stayed by day and traveled at night,"},{"id":"sayakbay-ms-current144:pdf067:l013","ordinal":392619,"en":"What living soul could stand firm?"},{"id":"sayakbay-ms-current144:pdf067:l014","ordinal":392620,"en":"The gray-maned warrior chose him as a friend,"},{"id":"sayakbay-ms-current144:pdf067:l015","ordinal":392621,"en":"He found the plain and made it his land,"},{"id":"sayakbay-ms-current144:pdf067:l016","ordinal":392622,"en":"He gathered the Kyrgyz and made them a people,"},{"id":"sayakbay-ms-current144:pdf067:l017","ordinal":392623,"en":"When he rode out, he bound the enemy,"},{"id":"sayakbay-ms-current144:pdf067:l018","ordinal":392624,"en":"He did not fall in battle,"},{"id":"sayakbay-ms-current144:pdf067:l019","ordinal":392625,"en":"When illness came, he recovered,"},{"id":"sayakbay-ms-current144:pdf067:l020","ordinal":392626,"en":"In this life his soul seemed undying,"},{"id":"sayakbay-ms-current144:pdf067:l021","ordinal":392627,"en":"They recognized him and established his camp,"},{"id":"sayakbay-ms-current144:pdf067:l023","ordinal":392628,"en":"For the gray-maned champion and his men,"},{"id":"sayakbay-ms-current144:pdf067:l024","ordinal":392629,"en":"The bells rang out resoundingly,"},{"id":"sayakbay-ms-current144:pdf067:l025","ordinal":392630,"en":"They grew strong beside Seytek,"},{"id":"sayakbay-ms-current144:pdf067:l026","ordinal":392631,"en":"May many strangers never see it,"},{"id":"sayakbay-ms-current144:pdf067:l027","ordinal":392632,"en":"Their strength together became a shield,"},{"id":"sayakbay-ms-current144:pdf067:l028","ordinal":392633,"en":"The choicest provisions were gathered,"},{"id":"sayakbay-ms-current144:pdf067:l029","ordinal":392634,"en":"The companions who had seen the land,"},{"id":"sayakbay-ms-current144:pdf067:l030","ordinal":392635,"en":"While riding the bay colt forward,"},{"id":"sayakbay-ms-current144:pdf067:l032","ordinal":392636,"en":"They adorned it with white pearls."},{"id":"sayakbay-ms-current144:pdf068:l001","ordinal":392637,"en":"While journeying onward, they kept counsel,"},{"id":"sayakbay-ms-current144:pdf068:l002","ordinal":392638,"en":"He was a champion destined to prevail,"},{"id":"sayakbay-ms-current144:pdf068:l003","ordinal":392639,"en":"Many cruel men seemed impossible to kill,"},{"id":"sayakbay-ms-current144:pdf068:l004","ordinal":392640,"en":"His eyes appeared keen as a bird of prey,"},{"id":"sayakbay-ms-current144:pdf068:l005","ordinal":392641,"en":"He addressed his words to the bride,"},{"id":"sayakbay-ms-current144:pdf068:l006","ordinal":392642,"en":"He spoke with a reproachful tone,"},{"id":"sayakbay-ms-current144:pdf068:l007","ordinal":392643,"en":"He stirred what could not be spread out,"},{"id":"sayakbay-ms-current144:pdf068:l008","ordinal":392644,"en":"From your words, sweet as sugar,"},{"id":"sayakbay-ms-current144:pdf068:l009","ordinal":392645,"en":"His bent waist would not let the blow reach him,"},{"id":"sayakbay-ms-current144:pdf068:l010","ordinal":392646,"en":"From the serenely beautiful woman,"},{"id":"sayakbay-ms-current144:pdf068:l012","ordinal":392647,"en":"From rice that could not be reached,"},{"id":"sayakbay-ms-current144:pdf068:l013","ordinal":392648,"en":"They bent back and struggled with the enemy,"},{"id":"sayakbay-ms-current144:pdf068:l014","ordinal":392649,"en":"He truly came among the warriors,"},{"id":"sayakbay-ms-current144:pdf068:l015","ordinal":392650,"en":"A thousand gleamed like maidens,"},{"id":"sayakbay-ms-current144:pdf068:l016","ordinal":392651,"en":"Beauty came upon her,"},{"id":"sayakbay-ms-current144:pdf068:l017","ordinal":392652,"en":"When Ak Joltoy looked upon her,"},{"id":"sayakbay-ms-current144:pdf068:l018","ordinal":392653,"en":"Now stand and understand,"},{"id":"sayakbay-ms-current144:pdf068:l019","ordinal":392654,"en":"The champion abandoned his former manner,"},{"id":"sayakbay-ms-current144:pdf068:l020","ordinal":392655,"en":"Descending from freedom,"},{"id":"sayakbay-ms-current144:pdf068:l021","ordinal":392656,"en":"Emerging from spring, they crowded together,"},{"id":"sayakbay-ms-current144:pdf068:l022","ordinal":392657,"en":"Now then, for Joltoy,"},{"id":"sayakbay-ms-current144:pdf068:l023","ordinal":392658,"en":"Did fortune favor his road?"},{"id":"sayakbay-ms-current144:pdf068:l024","ordinal":392659,"en":"He now took up his fierce bearing,"},{"id":"sayakbay-ms-current144:pdf068:l025","ordinal":392660,"en":"The white switch struck at nothing,"},{"id":"sayakbay-ms-current144:pdf068:l026","ordinal":392661,"en":"They drove Joltoy from their hands,"},{"id":"sayakbay-ms-current144:pdf068:l027","ordinal":392662,"en":"The hidden livestock of one enclosure,"},{"id":"sayakbay-ms-current144:pdf068:l028","ordinal":392663,"en":"From the khans who had fallen,"},{"id":"sayakbay-ms-current144:pdf068:l029","ordinal":392664,"en":"They settled and watched from afar,"},{"id":"sayakbay-ms-current144:pdf068:l030","ordinal":392665,"en":"He paled before setting out,"},{"id":"sayakbay-ms-current144:pdf068:l031","ordinal":392666,"en":"He took hold of the pale horse."},{"id":"sayakbay-ms-current144:pdf069:l001","ordinal":392667,"en":"After the difficult affair had taken place,"},{"id":"sayakbay-ms-current144:pdf069:l002","ordinal":392668,"en":"When he spoke in a burst of spirit,"},{"id":"sayakbay-ms-current144:pdf069:l003","ordinal":392669,"en":"The cauldron of the warriors,"},{"id":"sayakbay-ms-current144:pdf069:l004","ordinal":392670,"en":"The copper-faced old woman appeared,"},{"id":"sayakbay-ms-current144:pdf069:l005","ordinal":392671,"en":"The white pearls were deeply buried,"},{"id":"sayakbay-ms-current144:pdf069:l006","ordinal":392672,"en":"Amid noise and bustle, they tethered the horses,"},{"id":"sayakbay-ms-current144:pdf069:l007","ordinal":392673,"en":"He spoke of his swiftness,"},{"id":"sayakbay-ms-current144:pdf069:l008","ordinal":392674,"en":"They bound one to the swift warrior,"},{"id":"sayakbay-ms-current144:pdf069:l009","ordinal":392675,"en":"His majesty surpassed that of other men,"},{"id":"sayakbay-ms-current144:pdf069:l010","ordinal":392676,"en":"The enemy stood upon reaching one ridge,"},{"id":"sayakbay-ms-current144:pdf069:l011","ordinal":392677,"en":"The marksman’s shot passed a hair’s breadth,"},{"id":"sayakbay-ms-current144:pdf069:l012","ordinal":392678,"en":"Blood dripped from his sword,"},{"id":"sayakbay-ms-current144:pdf069:l013","ordinal":392679,"en":"He drove the Kara-Kalpak onward,"},{"id":"sayakbay-ms-current144:pdf069:l014","ordinal":392680,"en":"They reached the flank of Ala-Too,"},{"id":"sayakbay-ms-current144:pdf069:l015","ordinal":392681,"en":"Such was his swiftness,"},{"id":"sayakbay-ms-current144:pdf069:l016","ordinal":392682,"en":"Now he drew it and remained,"},{"id":"sayakbay-ms-current144:pdf069:l017","ordinal":392683,"en":"After Ak Joltoy arrived,"},{"id":"sayakbay-ms-current144:pdf069:l018","ordinal":392684,"en":"He saw how swift he was,"},{"id":"sayakbay-ms-current144:pdf069:l019","ordinal":392685,"en":"He struck from the flank,"},{"id":"sayakbay-ms-current144:pdf069:l020","ordinal":392686,"en":"These black foes called Joltoy a dog,"},{"id":"sayakbay-ms-current144:pdf069:l021","ordinal":392687,"en":"Their eyes did not trust the Kalmyks,"},{"id":"sayakbay-ms-current144:pdf069:l022","ordinal":392688,"en":"The massed enemy advanced at a trot,"},{"id":"sayakbay-ms-current144:pdf069:l023","ordinal":392689,"en":"The warrior lifted the stake,"},{"id":"sayakbay-ms-current144:pdf069:l024","ordinal":392690,"en":"Of dark-thighed Joltoy,"},{"id":"sayakbay-ms-current144:pdf069:l025","ordinal":392691,"en":"He descended safely,"},{"id":"sayakbay-ms-current144:pdf069:l026","ordinal":392692,"en":"A warrior’s eye and a warrior’s heart,"},{"id":"sayakbay-ms-current144:pdf069:l027","ordinal":392693,"en":"Then the enemy shifted away,"},{"id":"sayakbay-ms-current144:pdf069:l028","ordinal":392694,"en":"At every house he took a life,"},{"id":"sayakbay-ms-current144:pdf069:l029","ordinal":392695,"en":"The marksman gave chase,"},{"id":"sayakbay-ms-current144:pdf069:l030","ordinal":392696,"en":"He entered among forty and came through hardship,"},{"id":"sayakbay-ms-current144:pdf069:l031","ordinal":392697,"en":"Joltoy’s sword was at the ready,"},{"id":"sayakbay-ms-current144:pdf069:l032","ordinal":392698,"en":"Now blood ran from the whip."},{"id":"sayakbay-ms-current144:pdf070:l001","ordinal":392699,"en":"From the edge of the dark ravine,"},{"id":"sayakbay-ms-current144:pdf070:l002","ordinal":392700,"en":"He drove them back with his breast,"},{"id":"sayakbay-ms-current144:pdf070:l003","ordinal":392701,"en":"When warrior Joltoy saw this,"},{"id":"sayakbay-ms-current144:pdf070:l004","ordinal":392702,"en":"He grew angry and prepared himself,"},{"id":"sayakbay-ms-current144:pdf070:l005","ordinal":392703,"en":"Dear Joltoy surged ahead,"},{"id":"sayakbay-ms-current144:pdf070:l006","ordinal":392704,"en":"He prepared without wavering,"}]
