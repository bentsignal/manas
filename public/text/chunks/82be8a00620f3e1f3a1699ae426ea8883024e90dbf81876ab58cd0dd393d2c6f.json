[{"id":"semetey-1-2013:p0413:b003:l028","ordinal":108545,"en":"Fighting for the khanship,"},{"id":"semetey-1-2013:p0413:b003:l029","ordinal":108546,"en":"Renouncing their idols,"},{"id":"semetey-1-2013:p0413:b003:l030","ordinal":108547,"en":"Smashing their people,"},{"id":"semetey-1-2013:p0413:b003:l031","ordinal":108548,"en":"Scattering everything he had amassed,"},{"id":"semetey-1-2013:p0413:b003:l032","ordinal":108549,"en":"Desiring faith alone,"},{"id":"semetey-1-2013:p0413:b003:l033","ordinal":108550,"en":"Staining the golden throne with blood,"},{"id":"semetey-1-2013:p0413:b003:l034","ordinal":108551,"en":"Saying, ‘He will not do as I say,’"},{"id":"semetey-1-2013:p0413:b003:l035","ordinal":108552,"en":"He killed his father."},{"id":"semetey-1-2013:p0413:b003:l036","ordinal":108553,"en":"Without looking about him,"},{"id":"semetey-1-2013:p0413:b003:l037","ordinal":108554,"en":"Without sparing his own life,"},{"id":"semetey-1-2013:p0413:b003:l038","ordinal":108555,"en":"Almambet, son of Khan Azyz,"},{"id":"semetey-1-2013:p0413:b003:l039","ordinal":108556,"en":"Went down into Altai, I heard."},{"id":"semetey-1-2013:p0413:b004:l001","ordinal":108557,"en":"Killing the khan of Altai,"},{"id":"semetey-1-2013:p0413:b004:l002","ordinal":108558,"en":"Growing fierce and hardened,"},{"id":"semetey-1-2013:p0413:b004:l003","ordinal":108559,"en":"Your dark, wolf-like Ala,"},{"id":"semetey-1-2013:p0413:b004:l004","ordinal":108560,"en":"Known as ‘Bloody Neck,’"},{"id":"semetey-1-2013:p0413:b004:l005","ordinal":108561,"en":"Journeyed day and night,"},{"id":"semetey-1-2013:p0413:b004:l006","ordinal":108562,"en":"Rode far without sparing his horse,"},{"id":"semetey-1-2013:p0413:b004:l007","ordinal":108563,"en":"And entered Khangai, I heard."},{"id":"semetey-1-2013:p0413:b004:l008","ordinal":108564,"en":"Bloodied up to his forearms,"},{"id":"semetey-1-2013:p0413:b004:l009","ordinal":108565,"en":"He killed the khan of Khangai."},{"id":"semetey-1-2013:p0413:b004:l010","ordinal":108566,"en":"Finding no place to turn,"},{"id":"semetey-1-2013:p0413:b004:l011","ordinal":108567,"en":"Finding no people like the Muslims,"},{"id":"semetey-1-2013:p0413:b004:l012","ordinal":108568,"en":"Finding no lion to whom he could unburden his grief,"},{"id":"semetey-1-2013:p0413:b004:l013","ordinal":108569,"en":"He came to Sary-Arka, I heard."},{"id":"semetey-1-2013:p0413:b004:l014","ordinal":108570,"en":"For Kokcho in Sary-Arka,"},{"id":"semetey-1-2013:p0413:b004:l015","ordinal":108571,"en":"He brought prosperity to his felt-covered home."},{"id":"semetey-1-2013:p0413:b004:l016","ordinal":108572,"en":"When he met Kokcho,"},{"id":"semetey-1-2013:p0413:b004:l017","ordinal":108573,"en":"He made him khan over lands on every side,"},{"id":"semetey-1-2013:p0413:b004:l018","ordinal":108574,"en":"Accomplishing what he desired,"},{"id":"semetey-1-2013:p0413:b004:l019","ordinal":108575,"en":"Filling all his chests"},{"id":"semetey-1-2013:p0413:b004:l020","ordinal":108576,"en":"With yellow gold and riches,"},{"id":"semetey-1-2013:p0413:b004:l021","ordinal":108577,"en":"Hiding his livestock pens in dust,"},{"id":"semetey-1-2013:p0413:b004:l022","ordinal":108578,"en":"Raising his khanship above the people,"},{"id":"semetey-1-2013:p0413:b004:l023","ordinal":108579,"en":"Hiding his pastures in dust,"},{"id":"semetey-1-2013:p0413:b004:l024","ordinal":108580,"en":"Raising Kokcho, son of Aidarkan,"},{"id":"semetey-1-2013:p0413:b004:l025","ordinal":108581,"en":"To greatness beyond other men."},{"id":"semetey-1-2013:p0413:b004:l026","ordinal":108582,"en":"When he came to hero Kokcho,"},{"id":"semetey-1-2013:p0413:b004:l027","ordinal":108583,"en":"In the foothills of Sary-Arka"},{"id":"semetey-1-2013:p0413:b004:l028","ordinal":108584,"en":"Almam settled for the summer, I heard."},{"id":"semetey-1-2013:p0413:b004:l029","ordinal":108585,"en":"Of the Black Kalmyks and the Manchus,"},{"id":"semetey-1-2013:p0413:b004:l030","ordinal":108586,"en":"He broke their guard and brought back"},{"id":"semetey-1-2013:p0413:b004:l031","ordinal":108587,"en":"Some forty men bound, I heard."},{"id":"semetey-1-2013:p0413:b004:l032","ordinal":108588,"en":"He settled in Sary-Arka."},{"id":"semetey-1-2013:p0413:b004:l033","ordinal":108589,"en":"Since Almambet came to Kokcho,"},{"id":"semetey-1-2013:p0413:b004:l034","ordinal":108590,"en":"Some six years had passed."},{"id":"semetey-1-2013:p0413:b004:l035","ordinal":108591,"en":"Without sitting down to talk,"},{"id":"semetey-1-2013:p0413:b004:l036","ordinal":108592,"en":"Without asking how he was,"},{"id":"semetey-1-2013:p0413:b004:l037","ordinal":108593,"en":"At the season near autumn,"},{"id":"semetey-1-2013:p0413:b004:l038","ordinal":108594,"en":"He would slaughter sixty beasts."},{"id":"semetey-1-2013:p0413:b004:l039","ordinal":108595,"en":"Your hero Almam, idle and restless,"},{"id":"semetey-1-2013:p0414:b003:l001","ordinal":108596,"en":"Finding no enemy to fight,"},{"id":"semetey-1-2013:p0414:b003:l002","ordinal":108597,"en":"Finding no mountain to charge,"},{"id":"semetey-1-2013:p0414:b003:l003","ordinal":108598,"en":"He would vanish six months, seven months,"},{"id":"semetey-1-2013:p0414:b003:l004","ordinal":108599,"en":"Going off on a long hunting expedition."},{"id":"semetey-1-2013:p0414:b003:l005","ordinal":108600,"en":"When he returned from the hunt,"},{"id":"semetey-1-2013:p0414:b003:l006","ordinal":108601,"en":"When my Almam turned back toward Sary-Arka,"},{"id":"semetey-1-2013:p0414:b003:l007","ordinal":108602,"en":"Foolish Kokcho gathered troops,"},{"id":"semetey-1-2013:p0414:b003:l008","ordinal":108603,"en":"Gathered an immeasurable multitude,"},{"id":"semetey-1-2013:p0414:b003:l009","ordinal":108604,"en":"Having heard gossip from the people,"},{"id":"semetey-1-2013:p0414:b003:l010","ordinal":108605,"en":"That Akerkech, his friend's wife,"},{"id":"semetey-1-2013:p0414:b003:l011","ordinal":108606,"en":"Was his lover, so he heard;"},{"id":"semetey-1-2013:p0414:b003:l012","ordinal":108607,"en":"Of skilled wielders of the spear"},{"id":"semetey-1-2013:p0414:b003:l013","ordinal":108608,"en":"He gathered all he could."},{"id":"semetey-1-2013:p0414:b003:l014","ordinal":108609,"en":"Intending to exchange fire,"},{"id":"semetey-1-2013:p0414:b003:l015","ordinal":108610,"en":"While that Kokcho waited,"},{"id":"semetey-1-2013:p0414:b003:l016","ordinal":108611,"en":"Akerkech, Kokcho's wife,"},{"id":"semetey-1-2013:p0414:b003:l017","ordinal":108612,"en":"Wiser than other people,"},{"id":"semetey-1-2013:p0414:b003:l018","ordinal":108613,"en":"Came out to meet him, sobbing,"},{"id":"semetey-1-2013:p0414:b003:l019","ordinal":108614,"en":"Akerkech, his friend's wife,"},{"id":"semetey-1-2013:p0414:b003:l020","ordinal":108615,"en":"Weeping, crying out:"},{"id":"semetey-1-2013:p0414:b003:l021","ordinal":108616,"en":"“My banner on a red spear,"},{"id":"semetey-1-2013:p0414:b003:l022","ordinal":108617,"en":"Dear son, my gift come from China!"},{"id":"semetey-1-2013:p0414:b003:l023","ordinal":108618,"en":"There is no shame in weighty words;"},{"id":"semetey-1-2013:p0414:b003:l024","ordinal":108619,"en":"Turn your horse's head awhile,"},{"id":"semetey-1-2013:p0414:b003:l025","ordinal":108620,"en":"Dear son, stand a little way ahead!"},{"id":"semetey-1-2013:p0414:b003:l026","ordinal":108621,"en":"‘Along the ruddy shelduck's waters,’ they say,"},{"id":"semetey-1-2013:p0414:b003:l027","ordinal":108622,"en":"‘Akerkech, his friend's wife,"},{"id":"semetey-1-2013:p0414:b003:l028","ordinal":108623,"en":"Is this man's lover,’ they say."},{"id":"semetey-1-2013:p0414:b003:l029","ordinal":108624,"en":"‘White wheat flour makes dough,’ they say,"},{"id":"semetey-1-2013:p0414:b003:l030","ordinal":108625,"en":"‘The two of us are intimates,’ they say."},{"id":"semetey-1-2013:p0414:b003:l031","ordinal":108626,"en":"The pit he dug became deep;"},{"id":"semetey-1-2013:p0414:b003:l032","ordinal":108627,"en":"The Kazakhs gathered a mighty army."},{"id":"semetey-1-2013:p0414:b003:l034","ordinal":108628,"en":"The day clouded over, and spring came;"},{"id":"semetey-1-2013:p0414:b003:l035","ordinal":108629,"en":"That bastard Kokcho, Aidarkan's son,"},{"id":"semetey-1-2013:p0414:b003:l036","ordinal":108630,"en":"Became an enemy to his own good fortune."},{"id":"semetey-1-2013:p0414:b003:l037","ordinal":108631,"en":"If it is plentiful, it tastes like honey,"},{"id":"semetey-1-2013:p0414:b003:l038","ordinal":108632,"en":"They say the gazelle’s flesh is finest;"},{"id":"semetey-1-2013:p0414:b003:l039","ordinal":108633,"en":"With the accomplished elder Tölök,"},{"id":"semetey-1-2013:p0414:b004:l001","ordinal":108634,"en":"Toward that damned Kokcho, Aidarkan's son."},{"id":"semetey-1-2013:p0414:b004:l003","ordinal":108635,"en":"These Kazakhs standing here"},{"id":"semetey-1-2013:p0414:b004:l004","ordinal":108636,"en":"Are no men to stop your laughter,"},{"id":"semetey-1-2013:p0414:b004:l005","ordinal":108637,"en":"No lions to break your strength;"},{"id":"semetey-1-2013:p0414:b004:l006","ordinal":108638,"en":"Laughing and playing among the Kazakhs,"},{"id":"semetey-1-2013:p0414:b004:l007","ordinal":108639,"en":"They are no people to settle beside."},{"id":"semetey-1-2013:p0414:b004:l008","ordinal":108640,"en":"You have lost heart in Kokcho;"},{"id":"semetey-1-2013:p0414:b004:l009","ordinal":108641,"en":"Move away to Talas,"},{"id":"semetey-1-2013:p0414:b004:l010","ordinal":108642,"en":"Go and make your camp beside"},{"id":"semetey-1-2013:p0414:b004:l011","ordinal":108643,"en":"Manas, Zhakyp's only son.”"},{"id":"semetey-1-2013:p0414:b004:l012","ordinal":108644,"en":"Akerkech, his friend's wife,"},{"id":"semetey-1-2013:p0414:b004:l013","ordinal":108645,"en":"Had spoken these words;"},{"id":"semetey-1-2013:p0414:b004:l014","ordinal":108646,"en":"Akerkech wept and spoke,"},{"id":"semetey-1-2013:p0414:b004:l015","ordinal":108647,"en":"Brooding on the filthy slander."},{"id":"semetey-1-2013:p0414:b004:l016","ordinal":108648,"en":"Over what had happened last month,"},{"id":"semetey-1-2013:p0414:b004:l017","ordinal":108649,"en":"Offended bitterly, to death,"},{"id":"semetey-1-2013:p0414:b004:l018","ordinal":108650,"en":"Because of Akerkech,"},{"id":"semetey-1-2013:p0414:b004:l019","ordinal":108651,"en":"Because of the troublemaker,"},{"id":"semetey-1-2013:p0414:b004:l020","ordinal":108652,"en":"Over this Erkech's affair,"},{"id":"semetey-1-2013:p0414:b004:l021","ordinal":108653,"en":"Kokcho, Aidarkan's son,"},{"id":"semetey-1-2013:p0414:b004:l022","ordinal":108654,"en":"Deep among the reeds,"},{"id":"semetey-1-2013:p0414:b004:l023","ordinal":108655,"en":"He penned him in and left, I heard."},{"id":"semetey-1-2013:p0414:b004:l024","ordinal":108656,"en":"Making the Kazakhs resound with blows,"},{"id":"semetey-1-2013:p0414:b004:l025","ordinal":108657,"en":"He beat them and left, I heard."},{"id":"semetey-1-2013:p0414:b004:l026","ordinal":108658,"en":"It was that Almam himself;"},{"id":"semetey-1-2013:p0414:b004:l027","ordinal":108659,"en":"It was time for him to enter Mecca"},{"id":"semetey-1-2013:p0414:b004:l028","ordinal":108660,"en":"And return from his pilgrimage."},{"id":"semetey-1-2013:p0414:b004:l029","ordinal":108661,"en":"Your eagle and sword in the dream,"},{"id":"semetey-1-2013:p0414:b004:l030","ordinal":108662,"en":"Were they Almambet himself?"},{"id":"semetey-1-2013:p0414:b004:l031","ordinal":108663,"en":"Your Alake, the one God"},{"id":"semetey-1-2013:p0414:b004:l032","ordinal":108664,"en":"Is about to grant you.”"},{"id":"semetey-1-2013:p0414:b004:l033","ordinal":108665,"en":"I, your unfortunate mother,"},{"id":"semetey-1-2013:p0414:b004:l034","ordinal":108666,"en":"Having heard the truth of this news,"},{"id":"semetey-1-2013:p0414:b004:l035","ordinal":108667,"en":"Having heard King Bakai's words,"},{"id":"semetey-1-2013:p0414:b004:l036","ordinal":108668,"en":"With sixty wives and forty girls"},{"id":"semetey-1-2013:p0414:b004:l037","ordinal":108669,"en":"As attendants by my side,"},{"id":"semetey-1-2013:p0414:b004:l038","ordinal":108670,"en":"Set out from Talas."},{"id":"semetey-1-2013:p0414:b004:l039","ordinal":108671,"en":"I traveled across the face of the earth,"},{"id":"semetey-1-2013:p0415:b003:l001","ordinal":108672,"en":"A saint well versed in mortal ways,"},{"id":"semetey-1-2013:p0415:b003:l002","ordinal":108673,"en":"That uncle Bakai of mine,"},{"id":"semetey-1-2013:p0415:b003:l003","ordinal":108674,"en":"I took as my companion."},{"id":"semetey-1-2013:p0415:b003:l004","ordinal":108675,"en":"Almambet, son of King Azyz,"},{"id":"semetey-1-2013:p0415:b003:l005","ordinal":108676,"en":"Was due to turn back, I thought,"},{"id":"semetey-1-2013:p0415:b003:l006","ordinal":108677,"en":"And I went to meet him in Bukhara."},{"id":"semetey-1-2013:p0415:b003:l007","ordinal":108678,"en":"Having welcomed him in Bukhara,"},{"id":"semetey-1-2013:p0415:b003:l008","ordinal":108679,"en":"I gathered khojas and mullahs,"},{"id":"semetey-1-2013:p0415:b003:l009","ordinal":108680,"en":"And honored him as my guest for nine days."},{"id":"semetey-1-2013:p0415:b003:l010","ordinal":108681,"en":"Aruuke, Agynai's daughter,"},{"id":"semetey-1-2013:p0415:b003:l011","ordinal":108682,"en":"Whose father and mine were brothers,"},{"id":"semetey-1-2013:p0415:b003:l012","ordinal":108683,"en":"My younger cousin, I married to him."},{"id":"semetey-1-2013:p0415:b003:l013","ordinal":108684,"en":"A star moved in the sky;"},{"id":"semetey-1-2013:p0415:b003:l014","ordinal":108685,"en":"Your father and your Alake,"},{"id":"semetey-1-2013:p0415:b003:l015","ordinal":108686,"en":"Friends even in the other world,"},{"id":"semetey-1-2013:p0415:b003:l016","ordinal":108687,"en":"He came and settled in Talas."},{"id":"semetey-1-2013:p0415:b003:l017","ordinal":108688,"en":"As soon as he arrived, he befriended"},{"id":"semetey-1-2013:p0415:b003:l018","ordinal":108689,"en":"Manas, now gone to Judgment."},{"id":"semetey-1-2013:p0415:b003:l019","ordinal":108690,"en":"Your father and your Alake"},{"id":"semetey-1-2013:p0415:b003:l020","ordinal":108691,"en":"Chewed white wheat flour together,"},{"id":"semetey-1-2013:p0415:b003:l021","ordinal":108692,"en":"To enter battle side by side,"},{"id":"semetey-1-2013:p0415:b003:l022","ordinal":108693,"en":"Taking hold of the Holy Quran."},{"id":"semetey-1-2013:p0415:b003:l023","ordinal":108694,"en":"When Almambet settled in Talas,"},{"id":"semetey-1-2013:p0415:b003:l024","ordinal":108695,"en":"When he became your father's companion,"},{"id":"semetey-1-2013:p0415:b003:l025","ordinal":108696,"en":"It was then your royal father said:"},{"id":"semetey-1-2013:p0415:b003:l026","ordinal":108697,"en":"“Ah, Kanykei, my senior wife,"},{"id":"semetey-1-2013:p0415:b003:l027","ordinal":108698,"en":"When paired alaba coats* and sable caps"},{"id":"semetey-1-2013:p0415:b003:l028","ordinal":108699,"en":"This is the time they sway;"},{"id":"semetey-1-2013:p0415:b003:l029","ordinal":108700,"en":"Joining Argyn and Kyrgyz together,"},{"id":"semetey-1-2013:p0415:b003:l030","ordinal":108701,"en":"This is the time we rejoice."},{"id":"semetey-1-2013:p0415:b003:l031","ordinal":108702,"en":"Argyn and Kyrgyz mingled,"},{"id":"semetey-1-2013:p0415:b003:l032","ordinal":108703,"en":"Today they dwell together;"},{"id":"semetey-1-2013:p0415:b003:l033","ordinal":108704,"en":"Kumis by day, girls by night,"},{"id":"semetey-1-2013:p0415:b003:l034","ordinal":108705,"en":"That is the life today."},{"id":"semetey-1-2013:p0415:b003:l035","ordinal":108706,"en":"To this head blessed by Kydyr,"},{"id":"semetey-1-2013:p0415:b003:l036","ordinal":108707,"en":"Have all the mighty now come?"},{"id":"semetey-1-2013:p0415:b003:l037","ordinal":108708,"en":"With my precious Almam found,"},{"id":"semetey-1-2013:p0415:b003:l038","ordinal":108709,"en":"Has the Creator truly granted him?"},{"id":"semetey-1-2013:p0415:b003:l039","ordinal":108710,"en":"My sworn friend, my confidant,"},{"id":"semetey-1-2013:p0415:b004:l001","ordinal":108711,"en":"For that hungry lion, that noble falcon,"},{"id":"semetey-1-2013:p0415:b004:l002","ordinal":108712,"en":"If we do not allot him a coat,"},{"id":"semetey-1-2013:p0415:b004:l003","ordinal":108713,"en":"If we show him no respect,"},{"id":"semetey-1-2013:p0415:b004:l004","ordinal":108714,"en":"Will God not strike us down?"},{"id":"semetey-1-2013:p0415:b004:l005","ordinal":108715,"en":"Wife, will this warrior's spirit not be broken?"},{"id":"semetey-1-2013:p0415:b004:l007","ordinal":108716,"en":"Will God not strike us down from the outset?"},{"id":"semetey-1-2013:p0415:b004:l008","ordinal":108717,"en":"On Almam's arm,"},{"id":"semetey-1-2013:p0415:b004:l009","ordinal":108718,"en":"If we do not hang black steel,"},{"id":"semetey-1-2013:p0415:b004:l010","ordinal":108719,"en":"Not growing thin after six months' riding,"},{"id":"semetey-1-2013:p0415:b004:l011","ordinal":108720,"en":"For that noble soul himself,"},{"id":"semetey-1-2013:p0415:b004:l012","ordinal":108721,"en":"If we do not allot a horse,"},{"id":"semetey-1-2013:p0415:b004:l013","ordinal":108722,"en":"Let us die unworthy of the human name;"},{"id":"semetey-1-2013:p0415:b004:l014","ordinal":108723,"en":"Rather than lumbering about,"},{"id":"semetey-1-2013:p0415:b004:l015","ordinal":108724,"en":"Let the hour of our birth be cursed!"},{"id":"semetey-1-2013:p0415:b004:l016","ordinal":108725,"en":"Making his weapons secure,"},{"id":"semetey-1-2013:p0415:b004:l017","ordinal":108726,"en":"Then the lion"},{"id":"semetey-1-2013:p0415:b004:l018","ordinal":108727,"en":"Let us send forth and see his strength."},{"id":"semetey-1-2013:p0415:b004:l019","ordinal":108728,"en":"I have Chinese on my flank,"},{"id":"semetey-1-2013:p0415:b004:l020","ordinal":108729,"en":"I have Franks before me,"},{"id":"semetey-1-2013:p0415:b004:l021","ordinal":108730,"en":"Many enemies stand ready to oppose me."},{"id":"semetey-1-2013:p0415:b004:l022","ordinal":108731,"en":"Go, my wife, go,"},{"id":"semetey-1-2013:p0415:b004:l023","ordinal":108732,"en":"Your father's Aktulpar,"},{"id":"semetey-1-2013:p0415:b004:l024","ordinal":108733,"en":"Find a way to bring him here;"},{"id":"semetey-1-2013:p0415:b004:l025","ordinal":108734,"en":"Use your privilege as his darling."},{"id":"semetey-1-2013:p0415:b004:l026","ordinal":108735,"en":"When you go humbly to ask for him,"},{"id":"semetey-1-2013:p0415:b004:l027","ordinal":108736,"en":"He will consent to your words;"},{"id":"semetey-1-2013:p0415:b004:l028","ordinal":108737,"en":"If he is truly a king,"},{"id":"semetey-1-2013:p0415:b004:l029","ordinal":108738,"en":"He will give you Aktulpar,"},{"id":"semetey-1-2013:p0415:b004:l030","ordinal":108739,"en":"He will agree to what you say."},{"id":"semetey-1-2013:p0415:b004:l031","ordinal":108740,"en":"With golden forelock and tasselled belt,"},{"id":"semetey-1-2013:p0415:b004:l032","ordinal":108741,"en":"To King Azyz's only son,"},{"id":"semetey-1-2013:p0415:b004:l033","ordinal":108742,"en":"He will surely allot him."},{"id":"semetey-1-2013:p0415:b004:l034","ordinal":108743,"en":"The youngest of twelve daughters,"},{"id":"semetey-1-2013:p0415:b004:l035","ordinal":108744,"en":"If you insist, he will heed your words;"},{"id":"semetey-1-2013:p0415:b004:l036","ordinal":108745,"en":"If he thinks you his true child,"},{"id":"semetey-1-2013:p0415:b004:l037","ordinal":108746,"en":"He will give you Aktulpar.”"},{"id":"semetey-1-2013:p0415:b004:l038","ordinal":108747,"en":"Your father spoke, and I listened;"},{"id":"semetey-1-2013:p0415:b004:l039","ordinal":108748,"en":"I agreed to his words."},{"id":"semetey-1-2013:p0416:b003:l001","ordinal":108749,"en":"Entering the palace,"},{"id":"semetey-1-2013:p0416:b003:l002","ordinal":108750,"en":"Lined inside with silk,"},{"id":"semetey-1-2013:p0416:b003:l003","ordinal":108751,"en":"I, your mother Kanykei,"},{"id":"semetey-1-2013:p0416:b003:l004","ordinal":108752,"en":"Had worked its patterns with my teeth for seven unceasing years;"},{"id":"semetey-1-2013:p0416:b003:l005","ordinal":108753,"en":"Between Orenburg and Margilan,"},{"id":"semetey-1-2013:p0416:b003:l006","ordinal":108754,"en":"I had the intervening country searched,"},{"id":"semetey-1-2013:p0416:b003:l007","ordinal":108755,"en":"The freight-carrier's cotton"},{"id":"semetey-1-2013:p0416:b003:l008","ordinal":108756,"en":"I had taken by force."},{"id":"semetey-1-2013:p0416:b003:l009","ordinal":108757,"en":"The filings of hard iron,"},{"id":"semetey-1-2013:p0416:b003:l010","ordinal":108758,"en":"Its filings carefully fitted,"},{"id":"semetey-1-2013:p0416:b003:l011","ordinal":108759,"en":"I had them placed within;"},{"id":"semetey-1-2013:p0416:b003:l012","ordinal":108760,"en":"It filled anyone who saw it with delight."},{"id":"semetey-1-2013:p0416:b003:l013","ordinal":108761,"en":"Thin iron wire pressed into it,"},{"id":"semetey-1-2013:p0416:b003:l014","ordinal":108762,"en":"It wearied Kelte's bullets."},{"id":"semetey-1-2013:p0416:b003:l015","ordinal":108763,"en":"No musket ball could enter,"},{"id":"semetey-1-2013:p0416:b003:l016","ordinal":108764,"en":"Arkesken's point could not pierce it,"},{"id":"semetey-1-2013:p0416:b003:l017","ordinal":108765,"en":"No spear could pass through when thrust;"},{"id":"semetey-1-2013:p0416:b003:l018","ordinal":108766,"en":"Its collar gold, its sleeves brass,"},{"id":"semetey-1-2013:p0416:b003:l019","ordinal":108767,"en":"Double mail, with lark-eye rings,"},{"id":"semetey-1-2013:p0416:b003:l020","ordinal":108768,"en":"A broad collar, a roomy vest,"},{"id":"semetey-1-2013:p0416:b003:l021","ordinal":108769,"en":"The white padded coat your mother carefully made;"},{"id":"semetey-1-2013:p0416:b003:l022","ordinal":108770,"en":"“Wear it when you go to battle,"},{"id":"semetey-1-2013:p0416:b003:l023","ordinal":108771,"en":"Remember your sister-in-law,” I said,"},{"id":"semetey-1-2013:p0416:b003:l024","ordinal":108772,"en":"And dressed your Alake in it."},{"id":"semetey-1-2013:p0416:b003:l025","ordinal":108773,"en":"When drawn from its sheath with a cry,"},{"id":"semetey-1-2013:p0416:b003:l026","ordinal":108774,"en":"When turned toward the eager enemy,"},{"id":"semetey-1-2013:p0416:b003:l027","ordinal":108775,"en":"It never failed to strike when swung;"},{"id":"semetey-1-2013:p0416:b003:l028","ordinal":108776,"en":"Unless it had drunk its fill of blood,"},{"id":"semetey-1-2013:p0416:b003:l029","ordinal":108777,"en":"It would not enter its sheath when put away."},{"id":"semetey-1-2013:p0416:b003:l030","ordinal":108778,"en":"With all his skill devoted to the work,"},{"id":"semetey-1-2013:p0416:b003:l031","ordinal":108779,"en":"Your godfather Bolokbai"},{"id":"semetey-1-2013:p0416:b003:l032","ordinal":108780,"en":"Had barely made it in six days."},{"id":"semetey-1-2013:p0416:b003:l033","ordinal":108781,"en":"Arkesken from the palace,"},{"id":"semetey-1-2013:p0416:b003:l034","ordinal":108782,"en":"Black steel, a piercingly sharp blade,"},{"id":"semetey-1-2013:p0416:b003:l035","ordinal":108783,"en":"On fierce King Almambet's"},{"id":"semetey-1-2013:p0416:b003:l036","ordinal":108784,"en":"Arm I hung it."},{"id":"semetey-1-2013:p0416:b003:l037","ordinal":108785,"en":"Visiting my father's royal home,"},{"id":"semetey-1-2013:p0416:b003:l038","ordinal":108786,"en":"I went to ask for Aktulpar."},{"id":"semetey-1-2013:p0416:b003:l039","ordinal":108787,"en":"Your father's treasure,"},{"id":"semetey-1-2013:p0416:b004:l001","ordinal":108788,"en":"His treasury I opened."},{"id":"semetey-1-2013:p0416:b004:l002","ordinal":108789,"en":"I had eighty gelded camels saddled,"},{"id":"semetey-1-2013:p0416:b004:l003","ordinal":108790,"en":"Loaded all eighty with gold coins,"},{"id":"semetey-1-2013:p0416:b004:l004","ordinal":108791,"en":"Your father's wealth"},{"id":"semetey-1-2013:p0416:b004:l005","ordinal":108792,"en":"I lavished on Aktulpar."},{"id":"semetey-1-2013:p0416:b004:l006","ordinal":108793,"en":"Wide Andijan and Margilan,"},{"id":"semetey-1-2013:p0416:b004:l007","ordinal":108794,"en":"I traversed the country between."},{"id":"semetey-1-2013:p0416:b004:l008","ordinal":108795,"en":"Your graceful mother, then a young wife,"},{"id":"semetey-1-2013:p0416:b004:l009","ordinal":108796,"en":"Before my father,"},{"id":"semetey-1-2013:p0416:b004:l010","ordinal":108797,"en":"Visiting my distant birth-home,"},{"id":"semetey-1-2013:p0416:b004:l011","ordinal":108798,"en":"I went to ask for Aktulpar."},{"id":"semetey-1-2013:p0416:b004:l012","ordinal":108799,"en":"Refusing to heed my words,"},{"id":"semetey-1-2013:p0416:b004:l013","ordinal":108800,"en":"My father, miserly with wealth,"}]
