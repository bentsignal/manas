[{"id":"manas-2010:p1458:b001:l025","ordinal":62977,"en":"When I look within him,"},{"id":"manas-2010:p1458:b001:l026","ordinal":62978,"en":"He is broader than a river;"},{"id":"manas-2010:p1458:b001:l027","ordinal":62979,"en":"His fortune is complete."},{"id":"manas-2010:p1458:b001:l028","ordinal":62980,"en":"If he rages, Beijing,"},{"id":"manas-2010:p1458:b001:l029","ordinal":62981,"en":"The countless Chinese and Manchus,"},{"id":"manas-2010:p1458:b001:l030","ordinal":62982,"en":"All the Chinese empire,"},{"id":"manas-2010:p1458:b001:l031","ordinal":62983,"en":"Its young and its old,"},{"id":"manas-2010:p1458:b001:l032","ordinal":62984,"en":"He is a warrior who could slaughter alone."},{"id":"manas-2010:p1458:b001:l033","ordinal":62985,"en":"For the Muslim people"},{"id":"manas-2010:p1458:b001:l034","ordinal":62986,"en":"He is a fortress with iron walls."},{"id":"manas-2010:p1458:b001:l035","ordinal":62987,"en":"Were it not that he is Burut,"},{"id":"manas-2010:p1458:b001:l036","ordinal":62988,"en":"For the Chinese emperor’s Beijing"},{"id":"manas-2010:p1458:b001:l037","ordinal":62989,"en":"He would be a fitting khan."},{"id":"manas-2010:p1458:b001:l038","ordinal":62990,"en":"In combat, strength will not suffice;"},{"id":"manas-2010:p1458:b001:l039","ordinal":62991,"en":"In wrestling, might will not suffice."},{"id":"manas-2010:p1458:b001:l040","ordinal":62992,"en":"Even if you fire, no shot will pierce him;"},{"id":"manas-2010:p1458:b001:l041","ordinal":62993,"en":"Neither spear nor sword will pierce him."},{"id":"manas-2010:p1458:b001:l042","ordinal":62994,"en":"If you come to fight him,"},{"id":"manas-2010:p1459:b001:l001","ordinal":62995,"en":"He will bend your back,"},{"id":"manas-2010:p1459:b001:l002","ordinal":62996,"en":"He will ruin your people,"},{"id":"manas-2010:p1459:b001:l003","ordinal":62997,"en":"Set rivers of blood flowing"},{"id":"manas-2010:p1459:b001:l004","ordinal":62998,"en":"And flood your land."},{"id":"manas-2010:p1459:b001:l005","ordinal":62999,"en":"If Manas catches sight of you,"},{"id":"manas-2010:p1459:b001:l006","ordinal":63000,"en":"You will bring trouble down;"},{"id":"manas-2010:p1459:b001:l007","ordinal":63001,"en":"For the Chinese of forty khans"},{"id":"manas-2010:p1459:b001:l008","ordinal":63002,"en":"You will bear the guilt of their suffering."},{"id":"manas-2010:p1459:b001:l009","ordinal":63003,"en":"They have champion Manas as their khan,"},{"id":"manas-2010:p1459:b001:l010","ordinal":63004,"en":"Who count forty thousand as less than a hair—"},{"id":"manas-2010:p1459:b001:l011","ordinal":63005,"en":"He has his forty companions too."},{"id":"manas-2010:p1459:b001:l012","ordinal":63006,"en":"Among those companions"},{"id":"manas-2010:p1459:b001:l013","ordinal":63007,"en":"Are the mighty Almambet and Chubak."},{"id":"manas-2010:p1459:b001:l014","ordinal":63008,"en":"Why should I tell of the others?"},{"id":"manas-2010:p1459:b001:l015","ordinal":63009,"en":"There is that stubborn wolf Syrgak."},{"id":"manas-2010:p1459:b001:l016","ordinal":63010,"en":"Why should I speak but briefly?"},{"id":"manas-2010:p1459:b001:l017","ordinal":63011,"en":"There are masters of the spear,"},{"id":"manas-2010:p1459:b001:l018","ordinal":63012,"en":"There are men skilled to wreck the world."},{"id":"manas-2010:p1459:b001:l019","ordinal":63013,"en":"Unless you take him by a stratagem,"},{"id":"manas-2010:p1459:b001:l020","ordinal":63014,"en":"When we fight with Manas,"},{"id":"manas-2010:p1459:b001:l021","ordinal":63015,"en":"There is no day of escape for us!"},{"id":"manas-2010:p1459:b001:l022","ordinal":63016,"en":"Let me tell you Khan Manas’s secret:"},{"id":"manas-2010:p1459:b001:l023","ordinal":63017,"en":"He is a khan endowed with sacred power."},{"id":"manas-2010:p1459:b001:l024","ordinal":63018,"en":"On every Friday"},{"id":"manas-2010:p1459:b001:l025","ordinal":63019,"en":"He has a certain habit."},{"id":"manas-2010:p1459:b001:l026","ordinal":63020,"en":"As dawn breaks clear,"},{"id":"manas-2010:p1459:b001:l027","ordinal":63021,"en":"As light enters the earth,"},{"id":"manas-2010:p1459:b001:l028","ordinal":63022,"en":"First he washes his backside,"},{"id":"manas-2010:p1459:b001:l029","ordinal":63023,"en":"Then he washes his face,"},{"id":"manas-2010:p1459:b001:l030","ordinal":63024,"en":"Cleanses his whole body,"},{"id":"manas-2010:p1459:b001:l031","ordinal":63025,"en":"And last of all washes his feet."},{"id":"manas-2010:p1459:b001:l032","ordinal":63026,"en":"He puts no boots upon his feet,"},{"id":"manas-2010:p1459:b001:l033","ordinal":63027,"en":"Has no weapons upon his body,"},{"id":"manas-2010:p1459:b001:l034","ordinal":63028,"en":"And wears only a robe."},{"id":"manas-2010:p1459:b001:l035","ordinal":63029,"en":"He fears no one."},{"id":"manas-2010:p1459:b001:l036","ordinal":63030,"en":"Beside his throne there is a tower;"},{"id":"manas-2010:p1459:b001:l037","ordinal":63031,"en":"All around are plane trees."},{"id":"manas-2010:p1459:b001:l038","ordinal":63032,"en":"Before light reaches the earth,"},{"id":"manas-2010:p1459:b001:l039","ordinal":63033,"en":"Before dawn breaks bright,"},{"id":"manas-2010:p1459:b001:l040","ordinal":63034,"en":"Striding proudly with a sway,"},{"id":"manas-2010:p1459:b001:l041","ordinal":63035,"en":"The forty sentries guarding him"},{"id":"manas-2010:p1459:b001:l042","ordinal":63036,"en":"Keep watch all around."},{"id":"manas-2010:p1460:b001:l001","ordinal":63037,"en":"Walking slowly and coughing,"},{"id":"manas-2010:p1460:b001:l002","ordinal":63038,"en":"The warrior Manas goes that way,"},{"id":"manas-2010:p1460:b001:l003","ordinal":63039,"en":"Climbs the tower himself,"},{"id":"manas-2010:p1460:b001:l004","ordinal":63040,"en":"Turns his face toward the west,"},{"id":"manas-2010:p1460:b001:l005","ordinal":63041,"en":"And loudly calls to prayer."},{"id":"manas-2010:p1460:b001:l006","ordinal":63042,"en":"Crying ‘Allah!’ and raising his hands,"},{"id":"manas-2010:p1460:b001:l007","ordinal":63043,"en":"When he is calling to prayer,"},{"id":"manas-2010:p1460:b001:l008","ordinal":63044,"en":"When he performs that rite,"},{"id":"manas-2010:p1460:b001:l009","ordinal":63045,"en":"He looks neither to right nor left."},{"id":"manas-2010:p1460:b001:l010","ordinal":63046,"en":"Even if you come before his eyes,"},{"id":"manas-2010:p1460:b001:l011","ordinal":63047,"en":"To ask, ‘Who are you?’—"},{"id":"manas-2010:p1460:b001:l012","ordinal":63048,"en":"Even if you cut off his head,"},{"id":"manas-2010:p1460:b001:l013","ordinal":63049,"en":"Manas will never turn to look."},{"id":"manas-2010:p1460:b001:l014","ordinal":63050,"en":"Unless you find a stratagem then,"},{"id":"manas-2010:p1460:b001:l015","ordinal":63051,"en":"He will surely gouge out your eyes,"},{"id":"manas-2010:p1460:b001:l016","ordinal":63052,"en":"He will destroy you utterly."},{"id":"manas-2010:p1460:b001:l017","ordinal":63053,"en":"He will dig your dark pit,"},{"id":"manas-2010:p1460:b001:l018","ordinal":63054,"en":"He will boil your brine of misery."},{"id":"manas-2010:p1460:b001:l019","ordinal":63055,"en":"He will break your back;"},{"id":"manas-2010:p1460:b001:l020","ordinal":63056,"en":"Unless you use that stratagem,"},{"id":"manas-2010:p1460:b001:l021","ordinal":63057,"en":"He will destroy your people,"},{"id":"manas-2010:p1460:b001:l022","ordinal":63058,"en":"Slaughter the Chinese and wipe them out,"},{"id":"manas-2010:p1460:b001:l023","ordinal":63059,"en":"And make a dry riverbed of your land."},{"id":"manas-2010:p1460:b001:l024","ordinal":63060,"en":"Unless you find such a stratagem,"},{"id":"manas-2010:p1460:b001:l025","ordinal":63061,"en":"He will plunder all your goods."},{"id":"manas-2010:p1460:b001:l026","ordinal":63062,"en":"These Burut khans who have come"},{"id":"manas-2010:p1460:b001:l027","ordinal":63063,"en":"Will bring misery upon your head.”"},{"id":"manas-2010:p1460:b001:l028","ordinal":63064,"en":"Reading this, Kongurbay"},{"id":"manas-2010:p1460:b001:l029","ordinal":63065,"en":"Was struck speechless and wandered dazed;"},{"id":"manas-2010:p1460:b001:l030","ordinal":63066,"en":"He yellowed with jaundice."},{"id":"manas-2010:p1460:b001:l031","ordinal":63067,"en":"Unable to think of a stratagem,"},{"id":"manas-2010:p1460:b001:l032","ordinal":63068,"en":"Kongurbay lost his wits."},{"id":"manas-2010:p1460:b001:l033","ordinal":63069,"en":"“Unless we devise a cunning plan,"},{"id":"manas-2010:p1460:b001:l034","ordinal":63070,"en":"What Shuykuchu says is true:"},{"id":"manas-2010:p1460:b001:l035","ordinal":63071,"en":"No beast can match Akkula;"},{"id":"manas-2010:p1460:b001:l036","ordinal":63072,"en":"Without that stratagem,"},{"id":"manas-2010:p1460:b001:l037","ordinal":63073,"en":"No strength can master the warrior Manas."},{"id":"manas-2010:p1460:b001:l038","ordinal":63074,"en":"Dust rises wherever he walks;"},{"id":"manas-2010:p1460:b001:l039","ordinal":63075,"en":"That unbelieving Burut—"},{"id":"manas-2010:p1460:b001:l040","ordinal":63076,"en":"His very voice drives out the soul."},{"id":"manas-2010:p1460:b001:l041","ordinal":63077,"en":"Without this stratagem,"},{"id":"manas-2010:p1460:b001:l042","ordinal":63078,"en":"In combat we cannot match him,"},{"id":"manas-2010:p1461:b001:l001","ordinal":63079,"en":"Even grappling with him, our strength will not suffice."},{"id":"manas-2010:p1461:b001:l002","ordinal":63080,"en":"Cotton-sashed, I grew broad;"},{"id":"manas-2010:p1461:b001:l003","ordinal":63081,"en":"Born of Alöökö,"},{"id":"manas-2010:p1461:b001:l004","ordinal":63082,"en":"I became a hero in Great Beijing."},{"id":"manas-2010:p1461:b001:l005","ordinal":63083,"en":"There is no one to find a way;"},{"id":"manas-2010:p1461:b001:l006","ordinal":63084,"en":"I am the one cast into torment."},{"id":"manas-2010:p1461:b001:l007","ordinal":63085,"en":"I became a cliff without a ledge;"},{"id":"manas-2010:p1461:b001:l008","ordinal":63086,"en":"A wretched soul who suffered,"},{"id":"manas-2010:p1461:b001:l009","ordinal":63087,"en":"I became alone, without a nest."},{"id":"manas-2010:p1461:b001:l010","ordinal":63088,"en":"In Beijing, where Solomon would not come,"},{"id":"manas-2010:p1461:b001:l011","ordinal":63089,"en":"I lost my rule;"},{"id":"manas-2010:p1461:b001:l012","ordinal":63090,"en":"In Beijing, which Alexander could not reach,"},{"id":"manas-2010:p1461:b001:l013","ordinal":63091,"en":"I let a mosque be built within."},{"id":"manas-2010:p1461:b001:l014","ordinal":63092,"en":"My idol cast in bronze,"},{"id":"manas-2010:p1461:b001:l015","ordinal":63093,"en":"I lost as spoils to the Burut."},{"id":"manas-2010:p1461:b001:l016","ordinal":63094,"en":"Rather than this, let me die;"},{"id":"manas-2010:p1461:b001:l017","ordinal":63095,"en":"What the wrestler Shuyku said,"},{"id":"manas-2010:p1461:b001:l018","ordinal":63096,"en":"Let me try doing as he said!”"},{"id":"manas-2010:p1461:b001:l019","ordinal":63097,"en":"Raging and hardening himself,"},{"id":"manas-2010:p1461:b001:l020","ordinal":63098,"en":"Gathering courage and strength,"},{"id":"manas-2010:p1461:b001:l021","ordinal":63099,"en":"Looking alertly like a wolf,"},{"id":"manas-2010:p1461:b001:l022","ordinal":63100,"en":"Slaughtering the Chinese,"},{"id":"manas-2010:p1461:b001:l023","ordinal":63101,"en":"He had it made for forty full days,"},{"id":"manas-2010:p1461:b001:l024","ordinal":63102,"en":"Its tip forged without a joint,"},{"id":"manas-2010:p1461:b001:l025","ordinal":63103,"en":"Tempered with poison."},{"id":"manas-2010:p1461:b001:l026","ordinal":63104,"en":"Putting all his equipment in order,"},{"id":"manas-2010:p1461:b001:l027","ordinal":63105,"en":"Girding on his battle-axe,"},{"id":"manas-2010:p1461:b001:l028","ordinal":63106,"en":"From his eyes like pits,"},{"id":"manas-2010:p1461:b001:l029","ordinal":63107,"en":"Tears sprang out in repeated gushes."},{"id":"manas-2010:p1461:b001:l030","ordinal":63108,"en":"His door-sized front teeth"},{"id":"manas-2010:p1461:b001:l031","ordinal":63109,"en":"Cracked when he clenched them."},{"id":"manas-2010:p1461:b001:l032","ordinal":63110,"en":"The hawk, the dear grim-faced one,"},{"id":"manas-2010:p1461:b001:l033","ordinal":63111,"en":"Valuing his life less than a handgrip,"},{"id":"manas-2010:p1461:b001:l034","ordinal":63112,"en":"Buttoning up his mountain-sized body,"},{"id":"manas-2010:p1461:b001:l035","ordinal":63113,"en":"Algara beneath him,"},{"id":"manas-2010:p1461:b001:l036","ordinal":63114,"en":"He adorned with precious cloth."},{"id":"manas-2010:p1461:b001:l037","ordinal":63115,"en":"Your grim-faced one was a sea;"},{"id":"manas-2010:p1461:b001:l038","ordinal":63116,"en":"Without looking around him,"},{"id":"manas-2010:p1461:b001:l039","ordinal":63117,"en":"Without sparing his sea-like life,"},{"id":"manas-2010:p1461:b001:l040","ordinal":63118,"en":"Putting on his armored sleeves,"},{"id":"manas-2010:p1461:b001:l041","ordinal":63119,"en":"Kongurbay stood worshiping,"},{"id":"manas-2010:p1461:b001:l042","ordinal":63120,"en":"Pleading with his idol:"},{"id":"manas-2010:p1462:b001:l001","ordinal":63121,"en":"“If I am crooked, set me right, idol!"},{"id":"manas-2010:p1462:b001:l002","ordinal":63122,"en":"My idol, support me!”"},{"id":"manas-2010:p1462:b001:l003","ordinal":63123,"en":"Bending his knees to the ground,"},{"id":"manas-2010:p1462:b001:l004","ordinal":63124,"en":"He stood praying and bowing;"},{"id":"manas-2010:p1462:b001:l005","ordinal":63125,"en":"He stood weeping in sobs,"},{"id":"manas-2010:p1462:b001:l006","ordinal":63126,"en":"Bellowing, sobbing and shouting,"},{"id":"manas-2010:p1462:b001:l007","ordinal":63127,"en":"Pleading with his idol,"},{"id":"manas-2010:p1462:b001:l008","ordinal":63128,"en":"Counting each day day by day,"},{"id":"manas-2010:p1462:b001:l009","ordinal":63129,"en":"He now made his count of days."},{"id":"manas-2010:p1462:b001:l010","ordinal":63130,"en":"Counting the count of months,"},{"id":"manas-2010:p1462:b001:l011","ordinal":63131,"en":"He now made his count of months."},{"id":"manas-2010:p1462:b001:l012","ordinal":63132,"en":"The seven days in the reckoning"},{"id":"manas-2010:p1462:b001:l013","ordinal":63133,"en":"He finished counting tirelessly."},{"id":"manas-2010:p1462:b001:l014","ordinal":63134,"en":"Algara, like a roe deer,"},{"id":"manas-2010:p1462:b001:l015","ordinal":63135,"en":"He saddled with saddle and saddlecloth."},{"id":"manas-2010:p1462:b001:l016","ordinal":63136,"en":"As though about to destroy the world,"},{"id":"manas-2010:p1462:b001:l017","ordinal":63137,"en":"He tightened the belly-girth firmly,"},{"id":"manas-2010:p1462:b001:l018","ordinal":63138,"en":"Lengthened the crupper,"},{"id":"manas-2010:p1462:b001:l019","ordinal":63139,"en":"Thinking early, finding it late:"},{"id":"manas-2010:p1462:b001:l020","ordinal":63140,"en":"“If only I can reach Manas somehow,”"},{"id":"manas-2010:p1462:b001:l021","ordinal":63141,"en":"His two eyes became four,"},{"id":"manas-2010:p1462:b001:l022","ordinal":63142,"en":"Turning like a lion,"},{"id":"manas-2010:p1462:b001:l023","ordinal":63143,"en":"Unable to contain his wrath,"},{"id":"manas-2010:p1462:b001:l024","ordinal":63144,"en":"Like a black-striped tiger,"},{"id":"manas-2010:p1462:b001:l025","ordinal":63145,"en":"The grim-faced one stood ready."},{"id":"manas-2010:p1462:b001:l026","ordinal":63146,"en":"His sword rang at his side;"},{"id":"manas-2010:p1462:b001:l027","ordinal":63147,"en":"The battle-axe jingled in his hand;"},{"id":"manas-2010:p1462:b001:l028","ordinal":63148,"en":"His spear stood proudly in his hand;"},{"id":"manas-2010:p1462:b001:l029","ordinal":63149,"en":"The matchlock he carried"},{"id":"manas-2010:p1462:b001:l030","ordinal":63150,"en":"Jutted over his right shoulder."},{"id":"manas-2010:p1462:b001:l031","ordinal":63151,"en":"Riding at an angle,"},{"id":"manas-2010:p1462:b001:l032","ordinal":63152,"en":"Venom pouring from his mouth,"},{"id":"manas-2010:p1462:b001:l033","ordinal":63153,"en":"His thoughts torn many ways,"},{"id":"manas-2010:p1462:b001:l034","ordinal":63154,"en":"He rode toward Beijing."},{"id":"manas-2010:p1462:b001:l035","ordinal":63155,"en":"Looming like Mount Opol,"},{"id":"manas-2010:p1462:b001:l036","ordinal":63156,"en":"A khan called Alöökö had arisen;"},{"id":"manas-2010:p1462:b001:l037","ordinal":63157,"en":"Alöökö’s son Kongurbay—"},{"id":"manas-2010:p1462:b001:l038","ordinal":63158,"en":"Hearing of his ancestral might from afar,"},{"id":"manas-2010:p1462:b001:l039","ordinal":63159,"en":"Souls fled their bodies in fear."},{"id":"manas-2010:p1462:b001:l040","ordinal":63160,"en":"By night, not by day,"},{"id":"manas-2010:p1462:b001:l041","ordinal":63161,"en":"Was it not the grim-faced one who traveled?"},{"id":"manas-2010:p1462:b001:l042","ordinal":63162,"en":"Traveling at night as by daylight,"},{"id":"manas-2010:p1463:b001:l001","ordinal":63163,"en":"Alöökö’s son Kongurbay,"},{"id":"manas-2010:p1463:b001:l002","ordinal":63164,"en":"Was he not a champion who knew the way?"},{"id":"manas-2010:p1463:b001:l003","ordinal":63165,"en":"Along cliffs where no owl flew,"},{"id":"manas-2010:p1463:b001:l004","ordinal":63166,"en":"Along ascents he himself knew,"},{"id":"manas-2010:p1463:b001:l005","ordinal":63167,"en":"Along a path for a single horse,"},{"id":"manas-2010:p1463:b001:l006","ordinal":63168,"en":"He came heading forward,"},{"id":"manas-2010:p1463:b001:l007","ordinal":63169,"en":"Taking the road toward the gate."},{"id":"manas-2010:p1463:b001:l008","ordinal":63170,"en":"The grim-faced one drew near."},{"id":"manas-2010:p1463:b001:l009","ordinal":63171,"en":"Of Beijing’s forty gates,"},{"id":"manas-2010:p1463:b001:l010","ordinal":63172,"en":"Going around all forty alike,"},{"id":"manas-2010:p1463:b001:l011","ordinal":63173,"en":"Kongurbay surveyed the heights."},{"id":"manas-2010:p1463:b001:l012","ordinal":63174,"en":"Guarding every entrance,"},{"id":"manas-2010:p1463:b001:l013","ordinal":63175,"en":"At each was one companion."},{"id":"manas-2010:p1463:b001:l014","ordinal":63176,"en":"The gates held by the forty companions,"},{"id":"manas-2010:p1463:b001:l015","ordinal":63177,"en":"No winged bird could visit;"},{"id":"manas-2010:p1463:b001:l016","ordinal":63178,"en":"No supernatural steed could leap across."},{"id":"manas-2010:p1463:b001:l017","ordinal":63179,"en":"It was a fortress guarded by a vast host;"},{"id":"manas-2010:p1463:b001:l018","ordinal":63180,"en":"Its doors were firm as stone."},{"id":"manas-2010:p1463:b001:l019","ordinal":63181,"en":"Unable to enter Great Beijing,"},{"id":"manas-2010:p1463:b001:l020","ordinal":63182,"en":"Kongurbay wandered about."},{"id":"manas-2010:p1463:b001:l021","ordinal":63183,"en":"Never resting upon an elbow,"},{"id":"manas-2010:p1463:b001:l022","ordinal":63184,"en":"Kongurbay went without lying down."},{"id":"manas-2010:p1463:b001:l023","ordinal":63185,"en":"Unable to brave entry into the city,"},{"id":"manas-2010:p1463:b001:l024","ordinal":63186,"en":"Kongurbay did not dare."},{"id":"manas-2010:p1463:b001:l025","ordinal":63187,"en":"Stretching like a scorching wind,"},{"id":"manas-2010:p1463:b001:l026","ordinal":63188,"en":"Grieving, not sparing himself,"},{"id":"manas-2010:p1463:b001:l027","ordinal":63189,"en":"Not caring for his frail life,"},{"id":"manas-2010:p1463:b001:l028","ordinal":63190,"en":"Not thinking, “I shall die,”"},{"id":"manas-2010:p1463:b001:l029","ordinal":63191,"en":"Not considering up or down,"},{"id":"manas-2010:p1463:b001:l030","ordinal":63192,"en":"Through an open doorway,"},{"id":"manas-2010:p1463:b001:l031","ordinal":63193,"en":"Galloping upon Algara,"},{"id":"manas-2010:p1463:b001:l032","ordinal":63194,"en":"Kongurbay resolved to enter."},{"id":"manas-2010:p1463:b001:l033","ordinal":63195,"en":"His hooves scarcely touching the earth,"},{"id":"manas-2010:p1463:b001:l034","ordinal":63196,"en":"His passage unknown to any soul,"},{"id":"manas-2010:p1463:b001:l035","ordinal":63197,"en":"Kongurbay entered the doorway,"},{"id":"manas-2010:p1463:b001:l036","ordinal":63198,"en":"Pleading with his idol."},{"id":"manas-2010:p1463:b001:l037","ordinal":63199,"en":"Old Kyrgyl and Agayar,"},{"id":"manas-2010:p1463:b001:l038","ordinal":63200,"en":"“It is the hour of dawn,” they said,"},{"id":"manas-2010:p1463:b001:l039","ordinal":63201,"en":"Resting upon their elbows for a moment,"},{"id":"manas-2010:p1463:b001:l040","ordinal":63202,"en":"Fell asleep, taking their ease."},{"id":"manas-2010:p1463:b001:l041","ordinal":63203,"en":"Their golden-bladed battle-axes,"},{"id":"manas-2010:p1463:b001:l042","ordinal":63204,"en":"Laid upon their shoulders,"},{"id":"manas-2010:p1464:b001:l001","ordinal":63205,"en":"They had fallen fast asleep."},{"id":"manas-2010:p1464:b001:l002","ordinal":63206,"en":"The grim-faced champion, a resourceful fellow,"},{"id":"manas-2010:p1464:b001:l003","ordinal":63207,"en":"Who knew the enemy’s stratagems,"},{"id":"manas-2010:p1464:b001:l004","ordinal":63208,"en":"A mighty fellow,"},{"id":"manas-2010:p1464:b001:l005","ordinal":63209,"en":"Dashing upon Algara,"},{"id":"manas-2010:p1464:b001:l006","ordinal":63210,"en":"To the plane tree before him"},{"id":"manas-2010:p1464:b001:l007","ordinal":63211,"en":"He galloped and arrived."},{"id":"manas-2010:p1464:b001:l008","ordinal":63212,"en":"When he reached the plane tree,"},{"id":"manas-2010:p1464:b001:l009","ordinal":63213,"en":"He turned Algara’s head."},{"id":"manas-2010:p1464:b001:l010","ordinal":63214,"en":"If he spat, fire burned in his hand;"},{"id":"manas-2010:p1464:b001:l011","ordinal":63215,"en":"The doomed grim-faced one stood there,"},{"id":"manas-2010:p1464:b001:l012","ordinal":63216,"en":"Holding his battle-axe, ready,"},{"id":"manas-2010:p1464:b001:l013","ordinal":63217,"en":"Preparing for what lay beyond,"},{"id":"manas-2010:p1464:b001:l014","ordinal":63218,"en":"The grim-faced one stood watching."},{"id":"manas-2010:p1464:b001:l015","ordinal":63219,"en":"To watch over Manas,"},{"id":"manas-2010:p1464:b001:l016","ordinal":63220,"en":"Among the forty companions,"},{"id":"manas-2010:p1464:b001:l017","ordinal":63221,"en":"On this day had come"},{"id":"manas-2010:p1464:b001:l018","ordinal":63222,"en":"Ajybay’s turn."},{"id":"manas-2010:p1464:b001:l019","ordinal":63223,"en":"Humming heedlessly,"},{"id":"manas-2010:p1464:b001:l020","ordinal":63224,"en":"Khan Manas’s Ajybay,"},{"id":"manas-2010:p1464:b001:l021","ordinal":63225,"en":"“No enemy will come from outside,” he thought,"},{"id":"manas-2010:p1464:b001:l022","ordinal":63226,"en":"And had grown unsuspecting."},{"id":"manas-2010:p1464:b001:l023","ordinal":63227,"en":"Not giving it a thought,"},{"id":"manas-2010:p1464:b001:l024","ordinal":63228,"en":"To the foot of the golden throne"},{"id":"manas-2010:p1464:b001:l025","ordinal":63229,"en":"He had turned Kartküröng’s head."},{"id":"manas-2010:p1464:b001:l026","ordinal":63230,"en":"From horseback, his spear"},{"id":"manas-2010:p1464:b001:l027","ordinal":63231,"en":"He had struck into the dark earth."},{"id":"manas-2010:p1464:b001:l028","ordinal":63232,"en":"He bent over the pommel, arms folded;"}]
