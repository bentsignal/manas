[{"id":"semetey-1-2013:p1253:b004:l033","ordinal":172801,"en":"They mounted to gird themselves,"},{"id":"semetey-1-2013:p1253:b004:l034","ordinal":172802,"en":"To set their faces toward battle,"},{"id":"semetey-1-2013:p1253:b004:l035","ordinal":172803,"en":"And to die if death reached them;"},{"id":"semetey-1-2013:p1253:b004:l036","ordinal":172804,"en":"If their strength sufficed,"},{"id":"semetey-1-2013:p1253:b004:l037","ordinal":172805,"en":"To keep them from facing the Afghan city"},{"id":"semetey-1-2013:p1253:b004:l038","ordinal":172806,"en":"And defeat the Zhediger."},{"id":"semetey-1-2013:p1253:b004:l039","ordinal":172807,"en":"They stood facing one another,"},{"id":"semetey-1-2013:p1254:b003:l001","ordinal":172808,"en":"Firing guns and drawing bows,"},{"id":"semetey-1-2013:p1254:b003:l002","ordinal":172809,"en":"They fought in clashing combat,"},{"id":"semetey-1-2013:p1254:b003:l003","ordinal":172810,"en":"Dying when their death arrived,"},{"id":"semetey-1-2013:p1254:b003:l004","ordinal":172811,"en":"Meeting when all recourse was gone,"},{"id":"semetey-1-2013:p1254:b003:l005","ordinal":172812,"en":"Tearing at one another's muscles,"},{"id":"semetey-1-2013:p1254:b003:l006","ordinal":172813,"en":"Fighting without turning aside."},{"id":"semetey-1-2013:p1254:b003:l007","ordinal":172814,"en":"A great slaughter was about to occur;"},{"id":"semetey-1-2013:p1254:b003:l008","ordinal":172815,"en":"The strong who boasted of their might"},{"id":"semetey-1-2013:p1254:b003:l009","ordinal":172816,"en":"Were about to consume the powerless."},{"id":"semetey-1-2013:p1254:b003:l010","ordinal":172817,"en":"These two sides remained poised"},{"id":"semetey-1-2013:p1254:b003:l011","ordinal":172818,"en":"For a terrible slaughter."},{"id":"semetey-1-2013:p1254:b003:l012","ordinal":172819,"en":"The Afghan champions"},{"id":"semetey-1-2013:p1254:b003:l013","ordinal":172820,"en":"Encountered the Zhediger"},{"id":"semetey-1-2013:p1254:b003:l014","ordinal":172821,"en":"And now began the battle."},{"id":"semetey-1-2013:p1254:b003:l015","ordinal":172822,"en":"They had driven them behind them"},{"id":"semetey-1-2013:p1254:b003:l016","ordinal":172823,"en":"Because of their desire for Aichürök:"},{"id":"semetey-1-2013:p1254:b003:l017","ordinal":172824,"en":"The Afghans saying, \"We will not give Chürök,\""},{"id":"semetey-1-2013:p1254:b003:l018","ordinal":172825,"en":"And Toltoi of the Zhediger saying,"},{"id":"semetey-1-2013:p1254:b003:l019","ordinal":172826,"en":"\"I shall reach and seize Chürök,"},{"id":"semetey-1-2013:p1254:b003:l020","ordinal":172827,"en":"Even if she has gone into the earth.\""},{"id":"semetey-1-2013:p1254:b003:l021","ordinal":172828,"en":"His countless army made the earth sag."},{"id":"semetey-1-2013:p1254:b003:l022","ordinal":172829,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1254:b003:l023","ordinal":172830,"en":"Kojo, vigorous in his deeds,"},{"id":"semetey-1-2013:p1254:b003:l024","ordinal":172831,"en":"Was Kojo who walked in corrupt strife."},{"id":"semetey-1-2013:p1254:b003:l025","ordinal":172832,"en":"Kojo was a mountainlike hero,"},{"id":"semetey-1-2013:p1254:b003:l026","ordinal":172833,"en":"One of the damned."},{"id":"semetey-1-2013:p1254:b003:l027","ordinal":172834,"en":"He wickedly incited Toltoi,"},{"id":"semetey-1-2013:p1254:b003:l028","ordinal":172835,"en":"Had him drive his great people,"},{"id":"semetey-1-2013:p1254:b003:l029","ordinal":172836,"en":"And was the hero who brought them."},{"id":"semetey-1-2013:p1254:b003:l030","ordinal":172837,"en":"He engulfed them by force;"},{"id":"semetey-1-2013:p1254:b003:l031","ordinal":172838,"en":"The slaughter of the great people"},{"id":"semetey-1-2013:p1254:b003:l032","ordinal":172839,"en":"In the Afghan city"},{"id":"semetey-1-2013:p1254:b003:l033","ordinal":172840,"en":"Was Chynkojo's calamity."},{"id":"semetey-1-2013:p1254:b003:l034","ordinal":172841,"en":"Six forefathers before him had been khans;"},{"id":"semetey-1-2013:p1254:b003:l035","ordinal":172842,"en":"His strength reached across the world."},{"id":"semetey-1-2013:p1254:b003:l036","ordinal":172843,"en":"Manas and Chynkojo"},{"id":"semetey-1-2013:p1254:b003:l037","ordinal":172844,"en":"Were sons of brothers;"},{"id":"semetey-1-2013:p1254:b003:l038","ordinal":172845,"en":"Chynkojo's wound"},{"id":"semetey-1-2013:p1254:b003:l039","ordinal":172846,"en":"Would not heal in all the world."},{"id":"semetey-1-2013:p1254:b004:l001","ordinal":172847,"en":"Dear old Tölök"},{"id":"semetey-1-2013:p1254:b004:l002","ordinal":172848,"en":"Quarreled over what did not exist;"},{"id":"semetey-1-2013:p1254:b004:l003","ordinal":172849,"en":"Because of Chynkojo,"},{"id":"semetey-1-2013:p1254:b004:l004","ordinal":172850,"en":"All the people were being slaughtered."},{"id":"semetey-1-2013:p1254:b004:l005","ordinal":172851,"en":"He led the Zhediger."},{"id":"semetey-1-2013:p1254:b004:l006","ordinal":172852,"en":"Their lord named Chynkojo,"},{"id":"semetey-1-2013:p1254:b004:l007","ordinal":172853,"en":"Who had fled from Talas,"},{"id":"semetey-1-2013:p1254:b004:l008","ordinal":172854,"en":"Said he would seize"},{"id":"semetey-1-2013:p1254:b004:l009","ordinal":172855,"en":"The daughter-in-law of bloodthirsty Sultan Manas—"},{"id":"semetey-1-2013:p1254:b004:l010","ordinal":172856,"en":"Such was this infidel's corruption."},{"id":"semetey-1-2013:p1254:b004:l011","ordinal":172857,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1254:b004:l012","ordinal":172858,"en":"And their elder leader Tölöbai"},{"id":"semetey-1-2013:p1254:b004:l013","ordinal":172859,"en":"Had then driven"},{"id":"semetey-1-2013:p1254:b004:l014","ordinal":172860,"en":"All the Zhediger."},{"id":"semetey-1-2013:p1254:b004:l015","ordinal":172861,"en":"Kojo, son of Shygai,"},{"id":"semetey-1-2013:p1254:b004:l016","ordinal":172862,"en":"Was born a hero from the hearth,"},{"id":"semetey-1-2013:p1254:b004:l017","ordinal":172863,"en":"Surpassing many souls."},{"id":"semetey-1-2013:p1254:b004:l018","ordinal":172864,"en":"He was born equal in standing"},{"id":"semetey-1-2013:p1254:b004:l019","ordinal":172865,"en":"To oceanlike hero Manas."},{"id":"semetey-1-2013:p1254:b004:l020","ordinal":172866,"en":"Such was Kojo's condition:"},{"id":"semetey-1-2013:p1254:b004:l021","ordinal":172867,"en":"They were paternal kinsmen of equal rank."},{"id":"semetey-1-2013:p1254:b004:l022","ordinal":172868,"en":"Look at his savage conduct"},{"id":"semetey-1-2013:p1254:b004:l023","ordinal":172869,"en":"Toward lion hero Manas—"},{"id":"semetey-1-2013:p1254:b004:l024","ordinal":172870,"en":"Seeds of one wheat,"},{"id":"semetey-1-2013:p1254:b004:l025","ordinal":172871,"en":"Villages sharing one threshold,"},{"id":"semetey-1-2013:p1254:b004:l026","ordinal":172872,"en":"Their grandfathers closely united,"},{"id":"semetey-1-2013:p1254:b004:l027","ordinal":172873,"en":"Descendants from the same tip,"},{"id":"semetey-1-2013:p1254:b004:l028","ordinal":172874,"en":"Offspring from the same root,"},{"id":"semetey-1-2013:p1254:b004:l029","ordinal":172875,"en":"Sheep sharing one pen,"},{"id":"semetey-1-2013:p1254:b004:l030","ordinal":172876,"en":"Companions sharing one cauldron and meal,"},{"id":"semetey-1-2013:p1254:b004:l031","ordinal":172877,"en":"One in blood and heart,"},{"id":"semetey-1-2013:p1254:b004:l032","ordinal":172878,"en":"One in courage and arm."},{"id":"semetey-1-2013:p1254:b004:l033","ordinal":172879,"en":"Kojo forgot the spirit"},{"id":"semetey-1-2013:p1254:b004:l034","ordinal":172880,"en":"Of Manas, gone to the other world,"},{"id":"semetey-1-2013:p1254:b004:l035","ordinal":172881,"en":"And attacked the in-laws"},{"id":"semetey-1-2013:p1254:b004:l036","ordinal":172882,"en":"Of the princely son of Manas;"},{"id":"semetey-1-2013:p1254:b004:l037","ordinal":172883,"en":"He drove forth an upheaval"},{"id":"semetey-1-2013:p1254:b004:l038","ordinal":172884,"en":"And slaughtered the great people."},{"id":"semetey-1-2013:p1254:b004:l039","ordinal":172885,"en":"His Kara At, born for him to ride,"},{"id":"semetey-1-2013:p1255:b003:l001","ordinal":172886,"en":"Was a thoroughbred that seemed to fly."},{"id":"semetey-1-2013:p1255:b003:l002","ordinal":172887,"en":"Ruinous Kojo would come to no good,"},{"id":"semetey-1-2013:p1255:b003:l003","ordinal":172888,"en":"Though he was Semetey's kinsman;"},{"id":"semetey-1-2013:p1255:b003:l004","ordinal":172889,"en":"He gathered a great Black army"},{"id":"semetey-1-2013:p1255:b003:l005","ordinal":172890,"en":"And engulfed them in battle,"},{"id":"semetey-1-2013:p1255:b003:l006","ordinal":172891,"en":"Having turned black with rage,"},{"id":"semetey-1-2013:p1255:b003:l007","ordinal":172892,"en":"To seize the wife"},{"id":"semetey-1-2013:p1255:b003:l008","ordinal":172893,"en":"Of hero Khan Semetey."},{"id":"semetey-1-2013:p1255:b003:l009","ordinal":172894,"en":"Toltoi inflicted violence;"},{"id":"semetey-1-2013:p1255:b003:l010","ordinal":172895,"en":"By making war on Semetey,"},{"id":"semetey-1-2013:p1255:b003:l011","ordinal":172896,"en":"Chynkojo inflicted humiliation."},{"id":"semetey-1-2013:p1255:b003:l012","ordinal":172897,"en":"The peoples of the world gathered;"},{"id":"semetey-1-2013:p1255:b003:l013","ordinal":172898,"en":"Because of Chynkojo and Toltoi,"},{"id":"semetey-1-2013:p1255:b003:l014","ordinal":172899,"en":"Innocent, meek people were slaughtered."},{"id":"semetey-1-2013:p1255:b003:l015","ordinal":172900,"en":"Khan Akun was no feeble khan;"},{"id":"semetey-1-2013:p1255:b003:l016","ordinal":172901,"en":"Azhibai and Tümönbai"},{"id":"semetey-1-2013:p1255:b003:l017","ordinal":172902,"en":"Were not souls who would simply perish."},{"id":"semetey-1-2013:p1255:b003:l018","ordinal":172903,"en":"Where he cast his gaze was red fire;"},{"id":"semetey-1-2013:p1255:b003:l019","ordinal":172904,"en":"Semetey was no ordinary child."},{"id":"semetey-1-2013:p1255:b003:l020","ordinal":172905,"en":"When he saw the engulfing army,"},{"id":"semetey-1-2013:p1255:b003:l021","ordinal":172906,"en":"Azhibai, son of Azhy,"},{"id":"semetey-1-2013:p1255:b003:l022","ordinal":172907,"en":"Flew like an arrow,"},{"id":"semetey-1-2013:p1255:b003:l023","ordinal":172908,"en":"Hurrying and stumbling onward."},{"id":"semetey-1-2013:p1255:b003:l024","ordinal":172909,"en":"Aichürök's white palace"},{"id":"semetey-1-2013:p1255:b003:l025","ordinal":172910,"en":"Was ringed by a fortress wall,"},{"id":"semetey-1-2013:p1255:b003:l026","ordinal":172911,"en":"Surpassing in its splendor;"},{"id":"semetey-1-2013:p1255:b003:l027","ordinal":172912,"en":"Emil and Ezhibai"},{"id":"semetey-1-2013:p1255:b003:l028","ordinal":172913,"en":"Were guards at its door."},{"id":"semetey-1-2013:p1255:b003:l029","ordinal":172914,"en":"Passing among the guards"},{"id":"semetey-1-2013:p1255:b003:l030","ordinal":172915,"en":"And seeking Semetey's protection,"},{"id":"semetey-1-2013:p1255:b003:l031","ordinal":172916,"en":"When dawn shone white"},{"id":"semetey-1-2013:p1255:b003:l032","ordinal":172917,"en":"And light touched the earth,"},{"id":"semetey-1-2013:p1255:b003:l033","ordinal":172918,"en":"He went to the pavilion in the palace"},{"id":"semetey-1-2013:p1255:b003:l034","ordinal":172919,"en":"And brought news"},{"id":"semetey-1-2013:p1255:b003:l035","ordinal":172920,"en":"To hero Semetey."},{"id":"semetey-1-2013:p1255:b003:l036","ordinal":172921,"en":"His knee bent to the ground"},{"id":"semetey-1-2013:p1255:b003:l037","ordinal":172922,"en":"As he ran in panic."},{"id":"semetey-1-2013:p1255:b003:l038","ordinal":172923,"en":"The young hero, son of Manas,"},{"id":"semetey-1-2013:p1255:b003:l039","ordinal":172924,"en":"Dipped his hands in water"},{"id":"semetey-1-2013:p1255:b004:l001","ordinal":172925,"en":"And performed the hand ablution;"},{"id":"semetey-1-2013:p1255:b004:l002","ordinal":172926,"en":"He hurriedly recited the prayer,"},{"id":"semetey-1-2013:p1255:b004:l003","ordinal":172927,"en":"Saddled Taibuurul,"},{"id":"semetey-1-2013:p1255:b004:l004","ordinal":172928,"en":"And set his arms and armor in order."},{"id":"semetey-1-2013:p1255:b004:l005","ordinal":172929,"en":"He gathered himself like a black tiger;"},{"id":"semetey-1-2013:p1255:b004:l006","ordinal":172930,"en":"Like a cloud about to rain again,"},{"id":"semetey-1-2013:p1255:b004:l007","ordinal":172931,"en":"Wrath spread across his face."},{"id":"semetey-1-2013:p1255:b004:l008","ordinal":172932,"en":"He girded on Zulfiqar,"},{"id":"semetey-1-2013:p1255:b004:l009","ordinal":172933,"en":"Inherited from Manas."},{"id":"semetey-1-2013:p1255:b004:l010","ordinal":172934,"en":"Grieving over Chynkojo,"},{"id":"semetey-1-2013:p1255:b004:l011","ordinal":172935,"en":"He put on Akolpok,"},{"id":"semetey-1-2013:p1255:b004:l012","ordinal":172936,"en":"Slung on Zhazyiyl,"},{"id":"semetey-1-2013:p1255:b004:l013","ordinal":172937,"en":"And prayed to the Creator."},{"id":"semetey-1-2013:p1255:b004:l014","ordinal":172938,"en":"Smoldering anew whenever depleted,"},{"id":"semetey-1-2013:p1255:b004:l015","ordinal":172939,"en":"Growing stronger from the root,"},{"id":"semetey-1-2013:p1255:b004:l016","ordinal":172940,"en":"Such was Manas's deep-rooted line."},{"id":"semetey-1-2013:p1255:b004:l017","ordinal":172941,"en":"Increasing whenever one of them died,"},{"id":"semetey-1-2013:p1255:b004:l018","ordinal":172942,"en":"Such was Manas's ruling line."},{"id":"semetey-1-2013:p1255:b004:l019","ordinal":172943,"en":"Semetey took after Manas;"},{"id":"semetey-1-2013:p1255:b004:l020","ordinal":172944,"en":"Semetey wore"},{"id":"semetey-1-2013:p1255:b004:l021","ordinal":172945,"en":"A blue lynx-fur cap."},{"id":"semetey-1-2013:p1255:b004:l022","ordinal":172946,"en":"He grew wrathful at Kojo,"},{"id":"semetey-1-2013:p1255:b004:l023","ordinal":172947,"en":"As though he had no wife."},{"id":"semetey-1-2013:p1255:b004:l024","ordinal":172948,"en":"With a face like oiled wheat,"},{"id":"semetey-1-2013:p1255:b004:l025","ordinal":172949,"en":"With eyes like twilight mist,"},{"id":"semetey-1-2013:p1255:b004:l026","ordinal":172950,"en":"He was offspring of the brave."},{"id":"semetey-1-2013:p1255:b004:l027","ordinal":172951,"en":"When the inherited fervor"},{"id":"semetey-1-2013:p1255:b004:l028","ordinal":172952,"en":"Of his fathers and grandfathers seized him,"},{"id":"semetey-1-2013:p1255:b004:l029","ordinal":172953,"en":"He burned fortified cities."},{"id":"semetey-1-2013:p1255:b004:l030","ordinal":172954,"en":"When enemies pressed together,"},{"id":"semetey-1-2013:p1255:b004:l031","ordinal":172955,"en":"He never opened his flank in fear."},{"id":"semetey-1-2013:p1255:b004:l032","ordinal":172956,"en":"Whoever grappled with him,"},{"id":"semetey-1-2013:p1255:b004:l033","ordinal":172957,"en":"He crushed into the ground like a hare."},{"id":"semetey-1-2013:p1255:b004:l034","ordinal":172958,"en":"He subdued the enemy he faced;"},{"id":"semetey-1-2013:p1255:b004:l035","ordinal":172959,"en":"No enemy dared come out"},{"id":"semetey-1-2013:p1255:b004:l036","ordinal":172960,"en":"To face the valiant hero."},{"id":"semetey-1-2013:p1255:b004:l037","ordinal":172961,"en":"When an enemy did face him,"},{"id":"semetey-1-2013:p1255:b004:l038","ordinal":172962,"en":"He drenched his sword in blood."},{"id":"semetey-1-2013:p1255:b004:l039","ordinal":172963,"en":"No mortal defeated him face-to-face,"},{"id":"semetey-1-2013:p1256:b003:l001","ordinal":172964,"en":"Let alone any kinsman, the wretch"},{"id":"semetey-1-2013:p1256:b003:l002","ordinal":172965,"en":"Gave no quarter even to"},{"id":"semetey-1-2013:p1256:b003:l003","ordinal":172966,"en":"Kakanchin's Great Beijing."},{"id":"semetey-1-2013:p1256:b003:l004","ordinal":172967,"en":"His bearing was formidable, his venom strong;"},{"id":"semetey-1-2013:p1256:b003:l005","ordinal":172968,"en":"He laid flat whoever grappled with him."},{"id":"semetey-1-2013:p1256:b003:l006","ordinal":172969,"en":"When angered, he was a black-gray wolf;"},{"id":"semetey-1-2013:p1256:b003:l007","ordinal":172970,"en":"This son of the leopard"},{"id":"semetey-1-2013:p1256:b003:l008","ordinal":172971,"en":"Was red fire to whoever challenged him."},{"id":"semetey-1-2013:p1256:b003:l009","ordinal":172972,"en":"He summered at Middle Keng-Kol"},{"id":"semetey-1-2013:p1256:b003:l010","ordinal":172973,"en":"And tethered his fourteen horses."},{"id":"semetey-1-2013:p1256:b003:l011","ordinal":172974,"en":"If an enemy rode out shooting,"},{"id":"semetey-1-2013:p1256:b003:l012","ordinal":172975,"en":"He drove them before him."},{"id":"semetey-1-2013:p1256:b003:l013","ordinal":172976,"en":"When they provoked his anger,"},{"id":"semetey-1-2013:p1256:b003:l014","ordinal":172977,"en":"He caught and chewed them in his fangs."},{"id":"semetey-1-2013:p1256:b003:l015","ordinal":172978,"en":"Offspring of a lion-hero,"},{"id":"semetey-1-2013:p1256:b003:l016","ordinal":172979,"en":"He was never one of the common folk"},{"id":"semetey-1-2013:p1256:b003:l017","ordinal":172980,"en":"To offer resistance."},{"id":"semetey-1-2013:p1256:b003:l018","ordinal":172981,"en":"His courage was high and his venom strong;"},{"id":"semetey-1-2013:p1256:b003:l019","ordinal":172982,"en":"He laid flat whoever challenged him."},{"id":"semetey-1-2013:p1256:b003:l020","ordinal":172983,"en":"When Külchoro arrived safely,"},{"id":"semetey-1-2013:p1256:b003:l021","ordinal":172984,"en":"When Semetey saw his companion,"},{"id":"semetey-1-2013:p1256:b003:l022","ordinal":172985,"en":"He cried out, invoking Babedin;"},{"id":"semetey-1-2013:p1256:b003:l023","ordinal":172986,"en":"Saying that the boy had returned safely,"},{"id":"semetey-1-2013:p1256:b003:l024","ordinal":172987,"en":"Thirty daughters-in-law and thirty girls,"},{"id":"semetey-1-2013:p1256:b003:l025","ordinal":172988,"en":"With peerless Chürök at their head,"},{"id":"semetey-1-2013:p1256:b003:l026","ordinal":172989,"en":"Ran about crying out."},{"id":"semetey-1-2013:p1256:b003:l027","ordinal":172990,"en":"Then Aichürök entertained them as guests"},{"id":"semetey-1-2013:p1256:b003:l028","ordinal":172991,"en":"And held games and diversions,"},{"id":"semetey-1-2013:p1256:b003:l029","ordinal":172992,"en":"Gathering the elegant women."},{"id":"semetey-1-2013:p1256:b003:l030","ordinal":172993,"en":"The outer shell was bead-stone,"},{"id":"semetey-1-2013:p1256:b003:l031","ordinal":172994,"en":"With many kinds of sugary foods."},{"id":"semetey-1-2013:p1256:b003:l032","ordinal":172995,"en":"Crying aloud, \"Babedin!\""},{"id":"semetey-1-2013:p1256:b003:l033","ordinal":172996,"en":"Your formidable sister-in-law Aichürök"},{"id":"semetey-1-2013:p1256:b003:l034","ordinal":172997,"en":"Slaughtered a barren nursing mare,"},{"id":"semetey-1-2013:p1256:b003:l035","ordinal":172998,"en":"Set out the food and drink,"},{"id":"semetey-1-2013:p1256:b003:l036","ordinal":172999,"en":"And served tea in the aptama.*"},{"id":"semetey-1-2013:p1256:b003:l037","ordinal":173000,"en":"She had thirty daughters-in-law and thirty girls"},{"id":"semetey-1-2013:p1256:b003:l038","ordinal":173001,"en":"Gathered in extraordinary numbers,"},{"id":"semetey-1-2013:p1256:b003:l039","ordinal":173002,"en":"Had them play the orompoi game,"},{"id":"semetey-1-2013:p1256:b004:l001","ordinal":173003,"en":"And sated their longing for games."},{"id":"semetey-1-2013:p1256:b004:l002","ordinal":173004,"en":"Small-mouthed and camel-eyed,"},{"id":"semetey-1-2013:p1256:b004:l003","ordinal":173005,"en":"With dark eyes casting sideward glances,"},{"id":"semetey-1-2013:p1256:b004:l004","ordinal":173006,"en":"In crimson dresses and with moonlike waists,"},{"id":"semetey-1-2013:p1256:b004:l005","ordinal":173007,"en":"With dark eyes flashing,"},{"id":"semetey-1-2013:p1256:b004:l006","ordinal":173008,"en":"She had exactly forty"},{"id":"semetey-1-2013:p1256:b004:l007","ordinal":173009,"en":"Of the most precious beauties brought,"},{"id":"semetey-1-2013:p1256:b004:l008","ordinal":173010,"en":"And held magnificent games."},{"id":"semetey-1-2013:p1256:b004:l009","ordinal":173011,"en":"In dürüyö* dresses with foxlike waists,"},{"id":"semetey-1-2013:p1256:b004:l010","ordinal":173012,"en":"She had the dear women brought"},{"id":"semetey-1-2013:p1256:b004:l011","ordinal":173013,"en":"And held games of every kind."},{"id":"semetey-1-2013:p1256:b004:l012","ordinal":173014,"en":"None of the heroes slept;"},{"id":"semetey-1-2013:p1256:b004:l013","ordinal":173015,"en":"Their sides did not touch the earth."},{"id":"semetey-1-2013:p1256:b004:l014","ordinal":173016,"en":"They did not prop themselves on elbows to sleep,"},{"id":"semetey-1-2013:p1256:b004:l015","ordinal":173017,"en":"Nor rest for even a brief doze."},{"id":"semetey-1-2013:p1256:b004:l016","ordinal":173018,"en":"When all the heroes had risen,"},{"id":"semetey-1-2013:p1256:b004:l017","ordinal":173019,"en":"Azhibai came up"},{"id":"semetey-1-2013:p1256:b004:l018","ordinal":173020,"en":"To hero Semetey,"},{"id":"semetey-1-2013:p1256:b004:l019","ordinal":173021,"en":"Offered greeting before him,"},{"id":"semetey-1-2013:p1256:b004:l020","ordinal":173022,"en":"And Semetey returned the greeting."},{"id":"semetey-1-2013:p1256:b004:l021","ordinal":173023,"en":"The formidable orator Azhibai"},{"id":"semetey-1-2013:p1256:b004:l022","ordinal":173024,"en":"Raised his voice and began to speak."},{"id":"semetey-1-2013:p1256:b004:l023","ordinal":173025,"en":"Broad-jawed and flat-tongued,"},{"id":"semetey-1-2013:p1256:b004:l024","ordinal":173026,"en":"He was a servant who never stumbled in speech;"},{"id":"semetey-1-2013:p1256:b004:l025","ordinal":173027,"en":"A swift orator and reasoner,"},{"id":"semetey-1-2013:p1256:b004:l026","ordinal":173028,"en":"He was a courageous speaker."},{"id":"semetey-1-2013:p1256:b004:l027","ordinal":173029,"en":"He sharpened his black tongue"},{"id":"semetey-1-2013:p1256:b004:l028","ordinal":173030,"en":"And sang out before the khan."},{"id":"semetey-1-2013:p1256:b004:l029","ordinal":173031,"en":"When he spoke, he faced a man's soul;"},{"id":"semetey-1-2013:p1256:b004:l030","ordinal":173032,"en":"His words set a man's soul aflame—"},{"id":"semetey-1-2013:p1256:b004:l031","ordinal":173033,"en":"Such a servant was he."},{"id":"semetey-1-2013:p1256:b004:l032","ordinal":173034,"en":"His eloquence and wisdom"},{"id":"semetey-1-2013:p1256:b004:l033","ordinal":173035,"en":"Were equally matched."},{"id":"semetey-1-2013:p1256:b004:l034","ordinal":173036,"en":"They called him Azhibai the orator,"},{"id":"semetey-1-2013:p1256:b004:l035","ordinal":173037,"en":"A resourceful man who found the argument,"},{"id":"semetey-1-2013:p1256:b004:l036","ordinal":173038,"en":"A hero who spared nothing."},{"id":"semetey-1-2013:p1256:b004:l037","ordinal":173039,"en":"To hero Semetey,"},{"id":"semetey-1-2013:p1256:b004:l038","ordinal":173040,"en":"Azhibai spoke a word"},{"id":"semetey-1-2013:p1256:b004:l039","ordinal":173041,"en":"And planted a foul thought in his mind:"},{"id":"semetey-1-2013:p1257:b003:l001","ordinal":173042,"en":"“Silver-eyed and sun-faced,"},{"id":"semetey-1-2013:p1257:b003:l002","ordinal":173043,"en":"My thundering sultan,"},{"id":"semetey-1-2013:p1257:b003:l003","ordinal":173044,"en":"Golden-eyed and moon-faced,"},{"id":"semetey-1-2013:p1257:b003:l004","ordinal":173045,"en":"My dear sultan!"},{"id":"semetey-1-2013:p1257:b003:l005","ordinal":173046,"en":"My hoof left by the tulpar,"},{"id":"semetey-1-2013:p1257:b003:l006","ordinal":173047,"en":"My young hero left to me"},{"id":"semetey-1-2013:p1257:b003:l007","ordinal":173048,"en":"By falcon Manas, the charger!"},{"id":"semetey-1-2013:p1257:b003:l008","ordinal":173049,"en":"My banner fixed upon the spear,"},{"id":"semetey-1-2013:p1257:b003:l009","ordinal":173050,"en":"My gift left by the gray wolf:"},{"id":"semetey-1-2013:p1257:b003:l010","ordinal":173051,"en":"Your Kyrgyz village in Talas,"},{"id":"semetey-1-2013:p1257:b003:l011","ordinal":173052,"en":"Your Afghan in-laws in Orol—"},{"id":"semetey-1-2013:p1257:b003:l012","ordinal":173053,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1257:b003:l013","ordinal":173054,"en":"Has gathered his army and exchanged fire,"},{"id":"semetey-1-2013:p1257:b003:l014","ordinal":173055,"en":"And is about to wipe away your name."},{"id":"semetey-1-2013:p1257:b003:l015","ordinal":173056,"en":"My village is in Orol;"}]
