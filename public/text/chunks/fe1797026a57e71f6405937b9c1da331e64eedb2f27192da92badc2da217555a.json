[{"id":"semetey-1-2013:p1021:b004:l031","ordinal":154113,"en":"If it is a matter of kinship, Khan Akun is our in-law;"},{"id":"semetey-1-2013:p1021:b004:l032","ordinal":154114,"en":"I shall speak closely with Ajybai,"},{"id":"semetey-1-2013:p1021:b004:l033","ordinal":154115,"en":"And cross weapons with Tumenbai."},{"id":"semetey-1-2013:p1021:b004:l034","ordinal":154116,"en":"Yesterday, at Kokotoy's memorial feast,"},{"id":"semetey-1-2013:p1021:b004:l035","ordinal":154117,"en":"With gray-maned Manas at the head,"},{"id":"semetey-1-2013:p1021:b004:l036","ordinal":154118,"en":"When multitudes gathered and the people clamored,"},{"id":"semetey-1-2013:p1021:b004:l037","ordinal":154119,"en":"When infidel and Muslim"},{"id":"semetey-1-2013:p1021:b004:l038","ordinal":154120,"en":"Swarmed like worms,"},{"id":"semetey-1-2013:p1021:b004:l039","ordinal":154121,"en":"And the spectacle reached its height,"}]
