[{"id":"semetey-1-2013:p1282:b004:l025","ordinal":174081,"en":"The Zhediger's ten-thousand-strong army"},{"id":"semetey-1-2013:p1282:b004:l026","ordinal":174082,"en":"Stood facing them head-on."},{"id":"semetey-1-2013:p1282:b004:l027","ordinal":174083,"en":"Shouting in anger,"},{"id":"semetey-1-2013:p1282:b004:l028","ordinal":174084,"en":"They threw their remaining strength into the fight,"},{"id":"semetey-1-2013:p1282:b004:l029","ordinal":174085,"en":"Swarming more thickly than worms"},{"id":"semetey-1-2013:p1282:b004:l030","ordinal":174086,"en":"And teeming like ants."},{"id":"semetey-1-2013:p1282:b004:l031","ordinal":174087,"en":"Their banners stood apart;"},{"id":"semetey-1-2013:p1282:b004:l032","ordinal":174088,"en":"The Zhediger and the Afghans"},{"id":"semetey-1-2013:p1282:b004:l033","ordinal":174089,"en":"Faced each other as though to devour one another."},{"id":"semetey-1-2013:p1282:b004:l034","ordinal":174090,"en":"Standing without coming close,"},{"id":"semetey-1-2013:p1282:b004:l035","ordinal":174091,"en":"They fought with guns."},{"id":"semetey-1-2013:p1282:b004:l036","ordinal":174092,"en":"Unable to close and grapple,"},{"id":"semetey-1-2013:p1282:b004:l037","ordinal":174093,"en":"The two armies stood at a distance,"},{"id":"semetey-1-2013:p1282:b004:l038","ordinal":174094,"en":"Drawing bows and shooting."},{"id":"semetey-1-2013:p1282:b004:l039","ordinal":174095,"en":"They cast themselves upon the spears,"},{"id":"semetey-1-2013:p1283:b003:l001","ordinal":174096,"en":"They began a storied battle."},{"id":"semetey-1-2013:p1283:b003:l002","ordinal":174097,"en":"Standing with faces transformed,"},{"id":"semetey-1-2013:p1283:b003:l003","ordinal":174098,"en":"They leveled and thrust their spears."},{"id":"semetey-1-2013:p1283:b003:l004","ordinal":174099,"en":"Making one place their battlefield,"},{"id":"semetey-1-2013:p1283:b003:l005","ordinal":174100,"en":"They fought by turns."},{"id":"semetey-1-2013:p1283:b003:l006","ordinal":174101,"en":"They sent forth their wrestlers,"},{"id":"semetey-1-2013:p1283:b003:l007","ordinal":174102,"en":"And brought out their heroes"},{"id":"semetey-1-2013:p1283:b003:l008","ordinal":174103,"en":"To fight single combat."},{"id":"semetey-1-2013:p1283:b003:l009","ordinal":174104,"en":"From this side came one champion,"},{"id":"semetey-1-2013:p1283:b003:l010","ordinal":174105,"en":"From that side came another."},{"id":"semetey-1-2013:p1283:b003:l011","ordinal":174106,"en":"They leveled spears one against one"},{"id":"semetey-1-2013:p1283:b003:l012","ordinal":174107,"en":"And fought in single combat."},{"id":"semetey-1-2013:p1283:b003:l013","ordinal":174108,"en":"An Afghan champion"},{"id":"semetey-1-2013:p1283:b003:l014","ordinal":174109,"en":"Reached the Jediger;"},{"id":"semetey-1-2013:p1283:b003:l015","ordinal":174110,"en":"A Jediger champion"},{"id":"semetey-1-2013:p1283:b003:l016","ordinal":174111,"en":"Crushed him into the ground and passed on."},{"id":"semetey-1-2013:p1283:b003:l017","ordinal":174112,"en":"From behind, the Jediger"},{"id":"semetey-1-2013:p1283:b003:l018","ordinal":174113,"en":"Wheeled and surged over them;"},{"id":"semetey-1-2013:p1283:b003:l019","ordinal":174114,"en":"From this side, Khan Akun"},{"id":"semetey-1-2013:p1283:b003:l020","ordinal":174115,"en":"Unleashed the general battle."},{"id":"semetey-1-2013:p1283:b003:l021","ordinal":174116,"en":"Dust curled into the sky"},{"id":"semetey-1-2013:p1283:b003:l022","ordinal":174117,"en":"And poured from the melee."},{"id":"semetey-1-2013:p1283:b003:l023","ordinal":174118,"en":"Commanders of tens swept like sickles;"},{"id":"semetey-1-2013:p1283:b003:l024","ordinal":174119,"en":"Commanders of fifty barked."},{"id":"semetey-1-2013:p1283:b003:l025","ordinal":174120,"en":"Their spears jutted upward."},{"id":"semetey-1-2013:p1283:b003:l026","ordinal":174121,"en":"Commanders of hundreds ran;"},{"id":"semetey-1-2013:p1283:b003:l027","ordinal":174122,"en":"Commanders of thousands grieved."},{"id":"semetey-1-2013:p1283:b003:l028","ordinal":174123,"en":"Standards flapped,"},{"id":"semetey-1-2013:p1283:b003:l029","ordinal":174124,"en":"All the khans cried out,"},{"id":"semetey-1-2013:p1283:b003:l030","ordinal":174125,"en":"And fierce slaughter began."},{"id":"semetey-1-2013:p1283:b003:l031","ordinal":174126,"en":"Jediger and Afghan"},{"id":"semetey-1-2013:p1283:b003:l032","ordinal":174127,"en":"Met face to face."},{"id":"semetey-1-2013:p1283:b003:l033","ordinal":174128,"en":"It became a grave and perilous affair;"},{"id":"semetey-1-2013:p1283:b003:l034","ordinal":174129,"en":"They unleashed a general battle."},{"id":"semetey-1-2013:p1283:b003:l035","ordinal":174130,"en":"Before long,"},{"id":"semetey-1-2013:p1283:b003:l036","ordinal":174131,"en":"Kadyrbay, son of Kalcha,"},{"id":"semetey-1-2013:p1283:b003:l037","ordinal":174132,"en":"Bearing seven sacred standards,"},{"id":"semetey-1-2013:p1283:b003:l038","ordinal":174133,"en":"Raising an earth-splitting clamor,"},{"id":"semetey-1-2013:p1283:b003:l039","ordinal":174134,"en":"With dust curling into the sky,"},{"id":"semetey-1-2013:p1283:b005:l001","ordinal":174135,"en":"Poured in from the flank"},{"id":"semetey-1-2013:p1283:b005:l002","ordinal":174136,"en":"And began battle anew."},{"id":"semetey-1-2013:p1283:b005:l003","ordinal":174137,"en":"Tümönbay, son of Tülkü,"},{"id":"semetey-1-2013:p1283:b005:l004","ordinal":174138,"en":"And Ajybay, son of Ajy,"},{"id":"semetey-1-2013:p1283:b005:l005","ordinal":174139,"en":"Had gathered an exceptional army;"},{"id":"semetey-1-2013:p1283:b005:l006","ordinal":174140,"en":"They too had an answer"},{"id":"semetey-1-2013:p1283:b005:l007","ordinal":174141,"en":"To give the Jediger."},{"id":"semetey-1-2013:p1283:b005:l008","ordinal":174142,"en":"Many heroes stood side by side;"},{"id":"semetey-1-2013:p1283:b005:l009","ordinal":174143,"en":"Ajybay, son of Ajy,"},{"id":"semetey-1-2013:p1283:b005:l010","ordinal":174144,"en":"And broad-throated Kadyrbay"},{"id":"semetey-1-2013:p1283:b005:l011","ordinal":174145,"en":"Now made a spectacle."},{"id":"semetey-1-2013:p1283:b005:l012","ordinal":174146,"en":"Girding on his Oroipo cartridge pouch,"},{"id":"semetey-1-2013:p1283:b005:l013","ordinal":174147,"en":"Ajybay, son of Ajy,"},{"id":"semetey-1-2013:p1283:b005:l014","ordinal":174148,"en":"Charged in without sparing himself."},{"id":"semetey-1-2013:p1283:b005:l015","ordinal":174149,"en":"They stood face to face,"},{"id":"semetey-1-2013:p1283:b005:l016","ordinal":174150,"en":"Leveling their spears in silence;"},{"id":"semetey-1-2013:p1283:b005:l017","ordinal":174151,"en":"No bungler was allowed to flee,"},{"id":"semetey-1-2013:p1283:b005:l018","ordinal":174152,"en":"And heroes emerged after thrusting foes."},{"id":"semetey-1-2013:p1283:b005:l019","ordinal":174153,"en":"It became a clumsy, brutal battle;"},{"id":"semetey-1-2013:p1283:b005:l020","ordinal":174154,"en":"Black muskets cracked,"},{"id":"semetey-1-2013:p1283:b005:l021","ordinal":174155,"en":"Fierce guns boomed."},{"id":"semetey-1-2013:p1283:b005:l022","ordinal":174156,"en":"Slaughter spread starkly;"},{"id":"semetey-1-2013:p1283:b005:l023","ordinal":174157,"en":"Many precious heroes"},{"id":"semetey-1-2013:p1283:b005:l024","ordinal":174158,"en":"Lay dead and outstretched."},{"id":"semetey-1-2013:p1283:b005:l025","ordinal":174159,"en":"The earth became hazy with vapor;"},{"id":"semetey-1-2013:p1283:b005:l026","ordinal":174160,"en":"The armies seethed in uproar."},{"id":"semetey-1-2013:p1283:b005:l027","ordinal":174161,"en":"For those who knew and saw it,"},{"id":"semetey-1-2013:p1283:b005:l028","ordinal":174162,"en":"The tumult never healed."},{"id":"semetey-1-2013:p1283:b005:l029","ordinal":174163,"en":"Many brave men died;"},{"id":"semetey-1-2013:p1283:b005:l030","ordinal":174164,"en":"Those who remained alive"},{"id":"semetey-1-2013:p1283:b005:l031","ordinal":174165,"en":"Were drenched in black blood."},{"id":"semetey-1-2013:p1283:b005:l032","ordinal":174166,"en":"The host glittered and heaved,"},{"id":"semetey-1-2013:p1283:b005:l033","ordinal":174167,"en":"Having entered the clamor."},{"id":"semetey-1-2013:p1283:b005:l034","ordinal":174168,"en":"Many who had not hastened before"},{"id":"semetey-1-2013:p1283:b005:l035","ordinal":174169,"en":"Now entered the tumult."},{"id":"semetey-1-2013:p1283:b005:l036","ordinal":174170,"en":"The brave roared,"},{"id":"semetey-1-2013:p1283:b005:l037","ordinal":174171,"en":"While cowards trembled at the edge."},{"id":"semetey-1-2013:p1283:b005:l038","ordinal":174172,"en":"The grief-stricken cowards"},{"id":"semetey-1-2013:p1283:b005:l039","ordinal":174173,"en":"Fled away one by one."},{"id":"semetey-1-2013:p1284:b003:l001","ordinal":174174,"en":"Every throat was filled with dust;"},{"id":"semetey-1-2013:p1284:b003:l002","ordinal":174175,"en":"Human heads were covered in blood."},{"id":"semetey-1-2013:p1284:b003:l003","ordinal":174176,"en":"The soil spread as drifting dust;"},{"id":"semetey-1-2013:p1284:b003:l004","ordinal":174177,"en":"The sky was clear, but the earth overcast."},{"id":"semetey-1-2013:p1284:b003:l005","ordinal":174178,"en":"Not a blade on earth could be seen."},{"id":"semetey-1-2013:p1284:b003:l006","ordinal":174179,"en":"How many souls lay dying;"},{"id":"semetey-1-2013:p1284:b003:l007","ordinal":174180,"en":"Not a single person could be distinguished."},{"id":"semetey-1-2013:p1284:b003:l008","ordinal":174181,"en":"The people seethed and gathered;"},{"id":"semetey-1-2013:p1284:b003:l009","ordinal":174182,"en":"Those whose doom had come were slaughtered."},{"id":"semetey-1-2013:p1284:b003:l010","ordinal":174183,"en":"Let us leave that there"},{"id":"semetey-1-2013:p1284:b003:l011","ordinal":174184,"en":"And begin the tale"},{"id":"semetey-1-2013:p1284:b003:l012","ordinal":174185,"en":"Of hero Semey, son of Manas,"},{"id":"semetey-1-2013:p1284:b003:l013","ordinal":174186,"en":"The man of surpassing courage:"},{"id":"semetey-1-2013:p1284:b003:l014","ordinal":174187,"en":"Striking Buurul once with his heel,"},{"id":"semetey-1-2013:p1284:b003:l015","ordinal":174188,"en":"Scowling in wrath,"},{"id":"semetey-1-2013:p1284:b003:l016","ordinal":174189,"en":"Against the khoja's host, a whole division,"},{"id":"semetey-1-2013:p1284:b003:l017","ordinal":174190,"en":"Semetey charged."},{"id":"semetey-1-2013:p1284:b003:l018","ordinal":174191,"en":"Born surpassing"},{"id":"semetey-1-2013:p1284:b003:l019","ordinal":174192,"en":"His father, gray wolf Manas."},{"id":"semetey-1-2013:p1284:b003:l020","ordinal":174193,"en":"Which of his deeds can one tell?"},{"id":"semetey-1-2013:p1284:b003:l021","ordinal":174194,"en":"The seven banners that came from Mecca—"},{"id":"semetey-1-2013:p1284:b003:l022","ordinal":174195,"en":"He stationed them in seven places;"},{"id":"semetey-1-2013:p1284:b003:l023","ordinal":174196,"en":"It was the time your accomplished one charged,"},{"id":"semetey-1-2013:p1284:b003:l024","ordinal":174197,"en":"Slaughtering wherever he reached."},{"id":"semetey-1-2013:p1284:b003:l025","ordinal":174198,"en":"The six banners that came from Mecca—"},{"id":"semetey-1-2013:p1284:b003:l026","ordinal":174199,"en":"He stationed them in six places;"},{"id":"semetey-1-2013:p1284:b003:l027","ordinal":174200,"en":"The lion entered like the moon,"},{"id":"semetey-1-2013:p1284:b003:l028","ordinal":174201,"en":"Slaughtering at the first word."},{"id":"semetey-1-2013:p1284:b003:l029","ordinal":174202,"en":"The brave were cut down;"},{"id":"semetey-1-2013:p1284:b003:l030","ordinal":174203,"en":"Cowards stretched out in flight."},{"id":"semetey-1-2013:p1284:b003:l031","ordinal":174204,"en":"Born surpassing"},{"id":"semetey-1-2013:p1284:b003:l032","ordinal":174205,"en":"His father, gray wolf Manas,"},{"id":"semetey-1-2013:p1284:b003:l033","ordinal":174206,"en":"Your wretched hero pursued them roaring;"},{"id":"semetey-1-2013:p1284:b003:l034","ordinal":174207,"en":"The great black Jediger"},{"id":"semetey-1-2013:p1284:b003:l035","ordinal":174208,"en":"Fled in a thundering mass."},{"id":"semetey-1-2013:p1284:b003:l036","ordinal":174209,"en":"Wherever his spear reached,"},{"id":"semetey-1-2013:p1284:b003:l037","ordinal":174210,"en":"He slaughtered them with the spear;"},{"id":"semetey-1-2013:p1284:b003:l038","ordinal":174211,"en":"Thus Semetey took them."},{"id":"semetey-1-2013:p1284:b003:l039","ordinal":174212,"en":"Wherever his sword reached,"},{"id":"semetey-1-2013:p1284:b004:l001","ordinal":174213,"en":"He struck once with the sword;"},{"id":"semetey-1-2013:p1284:b004:l002","ordinal":174214,"en":"Thus Semetey left them behind."},{"id":"semetey-1-2013:p1284:b004:l003","ordinal":174215,"en":"Turning their turmoil into dust,"},{"id":"semetey-1-2013:p1284:b004:l004","ordinal":174216,"en":"He pursued without stopping;"},{"id":"semetey-1-2013:p1284:b004:l005","ordinal":174217,"en":"Shattering their stone fortress,"},{"id":"semetey-1-2013:p1284:b004:l006","ordinal":174218,"en":"He drove them away entirely."},{"id":"semetey-1-2013:p1284:b004:l007","ordinal":174219,"en":"He split them into groups of five and ten."},{"id":"semetey-1-2013:p1284:b004:l008","ordinal":174220,"en":"Those doomed to die died;"},{"id":"semetey-1-2013:p1284:b004:l009","ordinal":174221,"en":"Those who remained alive"},{"id":"semetey-1-2013:p1284:b004:l010","ordinal":174222,"en":"Suffered humiliation like dogs."},{"id":"semetey-1-2013:p1284:b004:l011","ordinal":174223,"en":"All the Jediger"},{"id":"semetey-1-2013:p1284:b004:l012","ordinal":174224,"en":"Fled in a frenzy."},{"id":"semetey-1-2013:p1284:b004:l013","ordinal":174225,"en":"As though seeking to enter the earth,"},{"id":"semetey-1-2013:p1284:b004:l014","ordinal":174226,"en":"They fled in wild panic."},{"id":"semetey-1-2013:p1284:b004:l015","ordinal":174227,"en":"Overflowing with grief,"},{"id":"semetey-1-2013:p1284:b004:l016","ordinal":174228,"en":"All the Jediger"},{"id":"semetey-1-2013:p1284:b004:l017","ordinal":174229,"en":"Despaired of their entrusted lives."},{"id":"semetey-1-2013:p1284:b004:l018","ordinal":174230,"en":"The survivors fled distraught,"},{"id":"semetey-1-2013:p1284:b004:l019","ordinal":174231,"en":"Crying, “Hero, we submit!”"},{"id":"semetey-1-2013:p1284:b004:l020","ordinal":174232,"en":"And pleading with Semetey."},{"id":"semetey-1-2013:p1284:b004:l021","ordinal":174233,"en":"Some, bewildered,"},{"id":"semetey-1-2013:p1284:b004:l022","ordinal":174234,"en":"Quickly dismounted"},{"id":"semetey-1-2013:p1284:b004:l023","ordinal":174235,"en":"And cried, “Ah, hero Semetey,"},{"id":"semetey-1-2013:p1284:b004:l024","ordinal":174236,"en":"Was not our khan the fool?"},{"id":"semetey-1-2013:p1284:b004:l025","ordinal":174237,"en":"What guilt lies upon the multitude?"},{"id":"semetey-1-2013:p1284:b004:l026","ordinal":174238,"en":"We were driven after him"},{"id":"semetey-1-2013:p1284:b004:l027","ordinal":174239,"en":"By one fool who fled his village,"},{"id":"semetey-1-2013:p1284:b004:l028","ordinal":174240,"en":"Through the affliction of the foolish khoja."},{"id":"semetey-1-2013:p1284:b004:l029","ordinal":174241,"en":"Lion son of Manas,"},{"id":"semetey-1-2013:p1284:b004:l030","ordinal":174242,"en":"Here is the commanding city;"},{"id":"semetey-1-2013:p1284:b004:l031","ordinal":174243,"en":"If you would take heads, here are ours!"},{"id":"semetey-1-2013:p1284:b004:l032","ordinal":174244,"en":"If you would dig deep, here is the pit;"},{"id":"semetey-1-2013:p1284:b004:l033","ordinal":174245,"en":"If you would boil us, here is the brine!"},{"id":"semetey-1-2013:p1284:b004:l034","ordinal":174246,"en":"Slaughter every one of us;"},{"id":"semetey-1-2013:p1284:b004:l035","ordinal":174247,"en":"Here is the army that came prepared!"},{"id":"semetey-1-2013:p1284:b004:l036","ordinal":174248,"en":"Do not bring misery upon the meek;"},{"id":"semetey-1-2013:p1284:b004:l037","ordinal":174249,"en":"If you would grapple, here is mighty Khoja!"},{"id":"semetey-1-2013:p1284:b004:l038","ordinal":174250,"en":"Add us to the khoja in humiliation;"},{"id":"semetey-1-2013:p1284:b004:l039","ordinal":174251,"en":"Boil us by force in bitter brine—"},{"id":"semetey-1-2013:p1285:b003:l001","ordinal":174252,"en":"If you would slaughter us, here is the army!”"},{"id":"semetey-1-2013:p1285:b003:l002","ordinal":174253,"en":"The people closed in with cries;"},{"id":"semetey-1-2013:p1285:b003:l003","ordinal":174254,"en":"The great black Jediger"},{"id":"semetey-1-2013:p1285:b003:l004","ordinal":174255,"en":"Dismounted and surrendered."},{"id":"semetey-1-2013:p1285:b003:l005","ordinal":174256,"en":"They cast down spears and swords;"},{"id":"semetey-1-2013:p1285:b003:l006","ordinal":174257,"en":"The strongest men of renowned name,"},{"id":"semetey-1-2013:p1285:b003:l007","ordinal":174258,"en":"Keeping out of Semetey's sight,"},{"id":"semetey-1-2013:p1285:b003:l008","ordinal":174259,"en":"Began to flee toward their villages."},{"id":"semetey-1-2013:p1285:b003:l009","ordinal":174260,"en":"Once the common folk stood thus,"},{"id":"semetey-1-2013:p1285:b003:l010","ordinal":174261,"en":"He did not attack the black multitude"},{"id":"semetey-1-2013:p1285:b003:l011","ordinal":174262,"en":"Nor assault"},{"id":"semetey-1-2013:p1285:b003:l012","ordinal":174263,"en":"The people who had surrendered;"},{"id":"semetey-1-2013:p1285:b003:l013","ordinal":174264,"en":"He stood hearing the lament"},{"id":"semetey-1-2013:p1285:b003:l014","ordinal":174265,"en":"Of the many weeping people."},{"id":"semetey-1-2013:p1285:b003:l015","ordinal":174266,"en":"“It was Khoja who caused the ruin.”"},{"id":"semetey-1-2013:p1285:b003:l016","ordinal":174267,"en":"He flicked his coiled whip;"},{"id":"semetey-1-2013:p1285:b003:l017","ordinal":174268,"en":"His wrath rose and he stiffened,"},{"id":"semetey-1-2013:p1285:b003:l018","ordinal":174269,"en":"His eyes blazing like fire,"},{"id":"semetey-1-2013:p1285:b003:l019","ordinal":174270,"en":"Bloodlust seizing him fiercely."},{"id":"semetey-1-2013:p1285:b003:l020","ordinal":174271,"en":"He moved apart in anger;"},{"id":"semetey-1-2013:p1285:b003:l021","ordinal":174272,"en":"The lion prince Semetey"},{"id":"semetey-1-2013:p1285:b003:l022","ordinal":174273,"en":"Appeared in the form of a lion."},{"id":"semetey-1-2013:p1285:b003:l023","ordinal":174274,"en":"His armed garments numbered eighty-four;"},{"id":"semetey-1-2013:p1285:b003:l024","ordinal":174275,"en":"Semetey, son of the gray wolf—"},{"id":"semetey-1-2013:p1285:b003:l025","ordinal":174276,"en":"Wherever he struck, red fire flared."},{"id":"semetey-1-2013:p1285:b003:l026","ordinal":174277,"en":"From his fathers and forefathers,"},{"id":"semetey-1-2013:p1285:b003:l027","ordinal":174278,"en":"No mortal came against them;"},{"id":"semetey-1-2013:p1285:b003:l028","ordinal":174279,"en":"None who faced them defeated them."},{"id":"semetey-1-2013:p1285:b003:l029","ordinal":174280,"en":"His wrath loomed visibly;"},{"id":"semetey-1-2013:p1285:b003:l030","ordinal":174281,"en":"Those who came saying they would oppose him"},{"id":"semetey-1-2013:p1285:b003:l031","ordinal":174282,"en":"Spilled their darkening blood."},{"id":"semetey-1-2013:p1285:b003:l032","ordinal":174283,"en":"He girded the jekene at his waist;"},{"id":"semetey-1-2013:p1285:b003:l033","ordinal":174284,"en":"His accomplished father Manas,"},{"id":"semetey-1-2013:p1285:b003:l034","ordinal":174285,"en":"Even against seven divisions of black troops,"},{"id":"semetey-1-2013:p1285:b003:l035","ordinal":174286,"en":"Had entered alone among them and attacked."},{"id":"semetey-1-2013:p1285:b003:l036","ordinal":174287,"en":"He did not spare those who fought him,"},{"id":"semetey-1-2013:p1285:b003:l037","ordinal":174288,"en":"Nor drink his fill of blood."},{"id":"semetey-1-2013:p1285:b003:l038","ordinal":174289,"en":"An enemy who came to battle"},{"id":"semetey-1-2013:p1285:b003:l039","ordinal":174290,"en":"He slaughtered without turning back."},{"id":"semetey-1-2013:p1285:b004:l001","ordinal":174291,"en":"From his fathers and forefathers,"},{"id":"semetey-1-2013:p1285:b004:l002","ordinal":174292,"en":"When enemies looked upon them,"},{"id":"semetey-1-2013:p1285:b004:l003","ordinal":174293,"en":"Those born of other fathers"},{"id":"semetey-1-2013:p1285:b004:l004","ordinal":174294,"en":"Could offer no resistance."},{"id":"semetey-1-2013:p1285:b004:l005","ordinal":174295,"en":"His root ancestor was wholly a khan,"},{"id":"semetey-1-2013:p1285:b004:l006","ordinal":174296,"en":"Blessed by Khizir from the root;"},{"id":"semetey-1-2013:p1285:b004:l007","ordinal":174297,"en":"Every forefather was a khan,"},{"id":"semetey-1-2013:p1285:b004:l008","ordinal":174298,"en":"Blessed by Khizir from the beginning."},{"id":"semetey-1-2013:p1285:b004:l009","ordinal":174299,"en":"He burned grassy lands,"},{"id":"semetey-1-2013:p1285:b004:l010","ordinal":174300,"en":"And set reed-filled lands aflame."},{"id":"semetey-1-2013:p1285:b004:l011","ordinal":174301,"en":"He poured blood into black water,"},{"id":"semetey-1-2013:p1285:b004:l012","ordinal":174302,"en":"And greased valleys with streams;"},{"id":"semetey-1-2013:p1285:b004:l013","ordinal":174303,"en":"When provoked in enmity,"},{"id":"semetey-1-2013:p1285:b004:l014","ordinal":174304,"en":"He laid low his own father."},{"id":"semetey-1-2013:p1285:b004:l015","ordinal":174305,"en":"When they crossed him,"},{"id":"semetey-1-2013:p1285:b004:l016","ordinal":174306,"en":"He “honored” the forty companions."},{"id":"semetey-1-2013:p1285:b004:l017","ordinal":174307,"en":"He overturned Abyke"},{"id":"semetey-1-2013:p1285:b004:l018","ordinal":174308,"en":"And sent Köbösh into the grave,"},{"id":"semetey-1-2013:p1285:b004:l019","ordinal":174309,"en":"Making his gray-wolf nature known."},{"id":"semetey-1-2013:p1285:b004:l020","ordinal":174310,"en":"He rejoiced at the word “enemy,”"},{"id":"semetey-1-2013:p1285:b004:l021","ordinal":174311,"en":"And drank blood as though it were water."},{"id":"semetey-1-2013:p1285:b004:l022","ordinal":174312,"en":"He greased his white steel;"},{"id":"semetey-1-2013:p1285:b004:l023","ordinal":174313,"en":"When they angered him,"},{"id":"semetey-1-2013:p1285:b004:l024","ordinal":174314,"en":"He laid low his own elder brother."},{"id":"semetey-1-2013:p1285:b004:l025","ordinal":174315,"en":"The foe who faced him halted;"},{"id":"semetey-1-2013:p1285:b004:l026","ordinal":174316,"en":"Before the hero's son,"},{"id":"semetey-1-2013:p1285:b004:l027","ordinal":174317,"en":"There remained no man to face him."},{"id":"semetey-1-2013:p1285:b004:l028","ordinal":174318,"en":"Among spearmen he became a lion;"},{"id":"semetey-1-2013:p1285:b004:l029","ordinal":174319,"en":"For the prince, son of a lion,"},{"id":"semetey-1-2013:p1285:b004:l030","ordinal":174320,"en":"The black earth became his only opponent."},{"id":"semetey-1-2013:p1285:b004:l031","ordinal":174321,"en":"His fame spread through the world;"},{"id":"semetey-1-2013:p1285:b004:l032","ordinal":174322,"en":"Prince Semetey became a hero."},{"id":"semetey-1-2013:p1285:b004:l033","ordinal":174323,"en":"He greased his keen steel"},{"id":"semetey-1-2013:p1285:b004:l034","ordinal":174324,"en":"And laid low the foe who fought him."},{"id":"semetey-1-2013:p1285:b004:l035","ordinal":174325,"en":"He greased his tempered steel"},{"id":"semetey-1-2013:p1285:b004:l036","ordinal":174326,"en":"And laid low those who pursued him."},{"id":"semetey-1-2013:p1285:b004:l037","ordinal":174327,"en":"The blessing of Khan Koshoy—"},{"id":"semetey-1-2013:p1285:b004:l038","ordinal":174328,"en":"Do you know the tale"},{"id":"semetey-1-2013:p1285:b004:l039","ordinal":174329,"en":"Of Semetey's father?"},{"id":"semetey-1-2013:p1286:b003:l001","ordinal":174330,"en":"Scowling, he girded his waist;"},{"id":"semetey-1-2013:p1286:b003:l002","ordinal":174331,"en":"From Beijing beyond Solomon's reach,"},{"id":"semetey-1-2013:p1286:b003:l003","ordinal":174332,"en":"He exacted judgment and took the throne."},{"id":"semetey-1-2013:p1286:b003:l004","ordinal":174333,"en":"Upon Beijing beyond the reach of Noah's flood,"},{"id":"semetey-1-2013:p1286:b003:l005","ordinal":174334,"en":"He unleashed turmoil and took its blood."},{"id":"semetey-1-2013:p1286:b003:l006","ordinal":174335,"en":"From Beijing beyond Alexander's reach,"},{"id":"semetey-1-2013:p1286:b003:l007","ordinal":174336,"en":"His need arose and he took its craftsmen."}]
