{"id": "sayakbay-ms-current146:pdf158:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 158, "folio": 541, "line_in_page": 32, "raw": "Кайран душман ала албас,", "text": "Кайран душман ала албас,", "en": "The enemy could not take the dear hero,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf158:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 158, "folio": 541, "line_in_page": 33, "raw": "Довулдуу капкан туу башын,", "text": "Довулдуу капкан туу башын,", "en": "His banner-head stood in the stormy trap,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
