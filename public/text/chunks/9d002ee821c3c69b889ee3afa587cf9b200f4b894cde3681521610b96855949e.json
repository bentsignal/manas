[{"id":"semetey-1-2013:p1078:b004:l021","ordinal":158465,"en":"Day passed and night came,"},{"id":"semetey-1-2013:p1078:b004:l022","ordinal":158466,"en":"Darkness settled as brows turned black."},{"id":"semetey-1-2013:p1078:b004:l023","ordinal":158467,"en":"His eyes bound by night travel,"},{"id":"semetey-1-2013:p1078:b004:l024","ordinal":158468,"en":"He crossed winding ravines,"},{"id":"semetey-1-2013:p1078:b004:l025","ordinal":158469,"en":"And passed twisting mountains."},{"id":"semetey-1-2013:p1078:b004:l026","ordinal":158470,"en":"Seeing a broad black river,"},{"id":"semetey-1-2013:p1078:b004:l027","ordinal":158471,"en":"He traveled without turning aside,"},{"id":"semetey-1-2013:p1078:b004:l028","ordinal":158472,"en":"Covering much ground without sparing his horse."},{"id":"semetey-1-2013:p1078:b004:l029","ordinal":158473,"en":"Now he drew near"},{"id":"semetey-1-2013:p1078:b004:l030","ordinal":158474,"en":"The junction of nine roads,"},{"id":"semetey-1-2013:p1078:b004:l031","ordinal":158475,"en":"At the boundary of Börü-Koy:"},{"id":"semetey-1-2013:p1078:b004:l032","ordinal":158476,"en":"One road came into Afghanistan,"},{"id":"semetey-1-2013:p1078:b004:l033","ordinal":158477,"en":"A black road went to Kashgar;"},{"id":"semetey-1-2013:p1078:b004:l034","ordinal":158478,"en":"One road came into Afghanistan,"},{"id":"semetey-1-2013:p1078:b004:l035","ordinal":158479,"en":"A straight road went to Turpan;"},{"id":"semetey-1-2013:p1078:b004:l036","ordinal":158480,"en":"One road came into Afghanistan,"},{"id":"semetey-1-2013:p1078:b004:l037","ordinal":158481,"en":"A marked road went to Beijing;"},{"id":"semetey-1-2013:p1078:b004:l038","ordinal":158482,"en":"One road came into Afghanistan—"}]
