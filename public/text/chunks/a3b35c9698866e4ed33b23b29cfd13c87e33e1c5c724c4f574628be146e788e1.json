[{"id":"semetey-1-2013:p0785:b005:l036","ordinal":136449,"en":"Do not leave your world to stagger;"},{"id":"semetey-1-2013:p0785:b005:l037","ordinal":136450,"en":"My ocean-like father, take it with you."},{"id":"semetey-1-2013:p0785:b005:l038","ordinal":136451,"en":"To Karakan's city"},{"id":"semetey-1-2013:p0785:b005:l039","ordinal":136452,"en":"I wandered away in disgrace."},{"id":"semetey-1-2013:p0786:b003:l001","ordinal":136453,"en":"You have left so much of your wealth to wander;"},{"id":"semetey-1-2013:p0786:b003:l002","ordinal":136454,"en":"My leopard father, take it with you!"},{"id":"semetey-1-2013:p0786:b003:l003","ordinal":136455,"en":"Leaving your child an orphan,"},{"id":"semetey-1-2013:p0786:b003:l004","ordinal":136456,"en":"Leaving your wife a widow,"},{"id":"semetey-1-2013:p0786:b003:l005","ordinal":136457,"en":"The desolate world lies in disgrace."},{"id":"semetey-1-2013:p0786:b003:l006","ordinal":136458,"en":"My dear horse Buurul,"},{"id":"semetey-1-2013:p0786:b003:l007","ordinal":136459,"en":"Twelve years without seeing my people—"},{"id":"semetey-1-2013:p0786:b003:l008","ordinal":136460,"en":"Is there a wretch like me?"},{"id":"semetey-1-2013:p0786:b003:l009","ordinal":136461,"en":"Twelve years without seeing your land—"},{"id":"semetey-1-2013:p0786:b003:l010","ordinal":136462,"en":"Is there a wretch like you?"},{"id":"semetey-1-2013:p0786:b003:l011","ordinal":136463,"en":"To Karakan's city,"},{"id":"semetey-1-2013:p0786:b003:l012","ordinal":136464,"en":"My dear horse Buurul,"},{"id":"semetey-1-2013:p0786:b003:l013","ordinal":136465,"en":"I, poor wretch, fled."},{"id":"semetey-1-2013:p0786:b003:l014","ordinal":136466,"en":"Chipping your hooves on the stones,"},{"id":"semetey-1-2013:p0786:b003:l015","ordinal":136467,"en":"Wondering, ‘When will my falcon come?’"},{"id":"semetey-1-2013:p0786:b003:l016","ordinal":136468,"en":"Though an animal, a living creature,"},{"id":"semetey-1-2013:p0786:b003:l017","ordinal":136469,"en":"You, poor wretch, wandered in anguish."},{"id":"semetey-1-2013:p0786:b003:l018","ordinal":136470,"en":"My kin became my enemies,"},{"id":"semetey-1-2013:p0786:b003:l019","ordinal":136471,"en":"My sorrow remained within me."},{"id":"semetey-1-2013:p0786:b003:l020","ordinal":136472,"en":"My dear horse Buurul,"},{"id":"semetey-1-2013:p0786:b003:l021","ordinal":136473,"en":"The place you fled to was a dark cliff;"},{"id":"semetey-1-2013:p0786:b003:l022","ordinal":136474,"en":"My own kin became my foes."},{"id":"semetey-1-2013:p0786:b003:l023","ordinal":136475,"en":"While I was still a babe in the cradle,"},{"id":"semetey-1-2013:p0786:b003:l025","ordinal":136476,"en":"My fierce mother Kanykei","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0786:b003:l026","ordinal":136477,"en":"Had her breast slashed open."},{"id":"semetey-1-2013:p0786:b003:l027","ordinal":136478,"en":"To my grandfather Temir's city"},{"id":"semetey-1-2013:p0786:b003:l028","ordinal":136479,"en":"I, poor wretch, wandered away."},{"id":"semetey-1-2013:p0786:b003:l029","ordinal":136480,"en":"For twelve years,"},{"id":"semetey-1-2013:p0786:b003:l030","ordinal":136481,"en":"Unable to see the many herds,"},{"id":"semetey-1-2013:p0786:b003:l031","ordinal":136482,"en":"You, poor wretch, roamed in flight."},{"id":"semetey-1-2013:p0786:b003:l032","ordinal":136483,"en":"When my khan father died,"},{"id":"semetey-1-2013:p0786:b003:l033","ordinal":136484,"en":"My dear Narbuudan,"},{"id":"semetey-1-2013:p0786:b003:l034","ordinal":136485,"en":"Did you become known as a vanished horse?"},{"id":"semetey-1-2013:p0786:b003:l035","ordinal":136486,"en":"Did you fall into disgrace?"},{"id":"semetey-1-2013:p0786:b003:l036","ordinal":136487,"en":"My dear horse Buurul,"},{"id":"semetey-1-2013:p0786:b003:l037","ordinal":136488,"en":"For you, who remembered and came,"},{"id":"semetey-1-2013:p0786:b003:l038","ordinal":136489,"en":"May I be a sacrifice,"},{"id":"semetey-1-2013:p0786:b003:l039","ordinal":136490,"en":"For your two shining eyes."},{"id":"semetey-1-2013:p0786:b004:l002","ordinal":136491,"en":"Though an animal, horse Buurul,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0786:b004:l003","ordinal":136492,"en":"You are the swift steed left by my father."},{"id":"semetey-1-2013:p0786:b004:l004","ordinal":136493,"en":"Closer than my six elder kinsmen"},{"id":"semetey-1-2013:p0786:b004:l005","ordinal":136494,"en":"You stand to me."},{"id":"semetey-1-2013:p0786:b004:l006","ordinal":136495,"en":"My learning, my book of lessons,"},{"id":"semetey-1-2013:p0786:b004:l007","ordinal":136496,"en":"My support left by my father,"},{"id":"semetey-1-2013:p0786:b004:l008","ordinal":136497,"en":"My wings that fly without strain,"},{"id":"semetey-1-2013:p0786:b004:l009","ordinal":136498,"en":"My swift one, proven before the people,"},{"id":"semetey-1-2013:p0786:b004:l010","ordinal":136499,"en":"From my mighty father Manas,"},{"id":"semetey-1-2013:p0786:b004:l011","ordinal":136500,"en":"The support I have inherited."},{"id":"semetey-1-2013:p0786:b004:l012","ordinal":136501,"en":"The magnanimous lion who went to the other world"},{"id":"semetey-1-2013:p0786:b004:l013","ordinal":136502,"en":"Took thought for those left behind:"},{"id":"semetey-1-2013:p0786:b004:l014","ordinal":136503,"en":"‘My only son who remains after me,"},{"id":"semetey-1-2013:p0786:b004:l015","ordinal":136504,"en":"My dear Narbuudan,"},{"id":"semetey-1-2013:p0786:b004:l016","ordinal":136505,"en":"Let him ride you as his mount,’ he said."},{"id":"semetey-1-2013:p0786:b004:l017","ordinal":136506,"en":"When I think of my fierce father,"},{"id":"semetey-1-2013:p0786:b004:l018","ordinal":136507,"en":"Grief never leaves my breast."},{"id":"semetey-1-2013:p0786:b004:l019","ordinal":136508,"en":"For a swift steed like you, Taibuurul,"},{"id":"semetey-1-2013:p0786:b004:l020","ordinal":136509,"en":"May all my livestock be sacrificed!”"},{"id":"semetey-1-2013:p0786:b004:l021","ordinal":136510,"en":"Your orphan, the ocean's son,"},{"id":"semetey-1-2013:p0786:b004:l022","ordinal":136511,"en":"Without looking around,"},{"id":"semetey-1-2013:p0786:b004:l023","ordinal":136512,"en":"When he saw Taibuurul,"},{"id":"semetey-1-2013:p0786:b004:l024","ordinal":136513,"en":"Sparing himself nothing,"},{"id":"semetey-1-2013:p0786:b004:l025","ordinal":136514,"en":"As though God had granted his wish,"},{"id":"semetey-1-2013:p0786:b004:l026","ordinal":136515,"en":"As though his father Manas"},{"id":"semetey-1-2013:p0786:b004:l027","ordinal":136516,"en":"Had risen and come to life today,"},{"id":"semetey-1-2013:p0786:b004:l028","ordinal":136517,"en":"As he stood looking at Buurul,"},{"id":"semetey-1-2013:p0786:b004:l029","ordinal":136518,"en":"As though he had seen Manas,"},{"id":"semetey-1-2013:p0786:b004:l030","ordinal":136519,"en":"Buurul, that greatest of beasts,"},{"id":"semetey-1-2013:p0786:b004:l031","ordinal":136520,"en":"He clasped around the neck and sobbed,"},{"id":"semetey-1-2013:p0786:b004:l032","ordinal":136521,"en":"And breathed in the scent of his cheek."},{"id":"semetey-1-2013:p0786:b004:l033","ordinal":136522,"en":"Your orphan, the son of Manas,"},{"id":"semetey-1-2013:p0786:b004:l034","ordinal":136523,"en":"Raised a wailing cry."},{"id":"semetey-1-2013:p0786:b004:l035","ordinal":136524,"en":"His elder, old Bakai,"},{"id":"semetey-1-2013:p0786:b004:l036","ordinal":136525,"en":"The sorrowful sage,"},{"id":"semetey-1-2013:p0786:b004:l037","ordinal":136526,"en":"Parted from his twin companion,"},{"id":"semetey-1-2013:p0786:b004:l038","ordinal":136527,"en":"The sage who had been close to death,"},{"id":"semetey-1-2013:p0786:b004:l039","ordinal":136528,"en":"At seeing the horse Buurul,"},{"id":"semetey-1-2013:p0787:b003:l001","ordinal":136529,"en":"What could sorrowful Bakai do?"},{"id":"semetey-1-2013:p0787:b003:l002","ordinal":136530,"en":"As though he had seen his companion in grief,"},{"id":"semetey-1-2013:p0787:b003:l003","ordinal":136531,"en":"Prince Manas, who had died before,"},{"id":"semetey-1-2013:p0787:b003:l004","ordinal":136532,"en":"As though he had seen his old comrade,"},{"id":"semetey-1-2013:p0787:b003:l005","ordinal":136533,"en":"As though valiant Manas had risen"},{"id":"semetey-1-2013:p0787:b003:l006","ordinal":136534,"en":"And appeared before him today,"},{"id":"semetey-1-2013:p0787:b003:l007","ordinal":136535,"en":"What could your valiant Bakai do?"},{"id":"semetey-1-2013:p0787:b003:l008","ordinal":136536,"en":"Seeing Buurul, Khan Bakai"},{"id":"semetey-1-2013:p0787:b003:l009","ordinal":136537,"en":"Held his forelock and breathed in his scent,"},{"id":"semetey-1-2013:p0787:b003:l010","ordinal":136538,"en":"Snuffling, he breathed it in deeply."},{"id":"semetey-1-2013:p0787:b003:l011","ordinal":136539,"en":"Though Buurul was an animal,"},{"id":"semetey-1-2013:p0787:b003:l012","ordinal":136540,"en":"He wept, ‘He remains from my comrade.’"},{"id":"semetey-1-2013:p0787:b003:l013","ordinal":136541,"en":"The birches wept, the willows wept,"},{"id":"semetey-1-2013:p0787:b003:l014","ordinal":136542,"en":"Every living onlooker wept."},{"id":"semetey-1-2013:p0787:b003:l015","ordinal":136543,"en":"Bakai and Semetey"},{"id":"semetey-1-2013:p0787:b003:l016","ordinal":136544,"en":"Wept side by side in anguish."},{"id":"semetey-1-2013:p0787:b003:l017","ordinal":136545,"en":"The many horses left by Manas,"},{"id":"semetey-1-2013:p0787:b003:l018","ordinal":136546,"en":"As though they would trample them,"},{"id":"semetey-1-2013:p0787:b003:l019","ordinal":136547,"en":"Circled round and neighed."},{"id":"semetey-1-2013:p0787:b003:l020","ordinal":136548,"en":"Since God had granted this,"},{"id":"semetey-1-2013:p0787:b003:l021","ordinal":136549,"en":"Since Buurul had come himself,"},{"id":"semetey-1-2013:p0787:b003:l022","ordinal":136550,"en":"The white reins, plaited in round knots,"},{"id":"semetey-1-2013:p0787:b003:l023","ordinal":136551,"en":"Were left by your mighty Manas,"},{"id":"semetey-1-2013:p0787:b003:l024","ordinal":136552,"en":"Reins that fitted Akkula."},{"id":"semetey-1-2013:p0787:b003:l026","ordinal":136553,"en":"With a steel bit,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0787:b003:l027","ordinal":136554,"en":"The great bridle left by mighty Manas,"},{"id":"semetey-1-2013:p0787:b003:l028","ordinal":136555,"en":"Semetey, saying ‘In God's name,’"},{"id":"semetey-1-2013:p0787:b003:l029","ordinal":136556,"en":"Now fastened upon the horse Buurul."},{"id":"semetey-1-2013:p0787:b003:l030","ordinal":136557,"en":"Like the stars in the sky,"},{"id":"semetey-1-2013:p0787:b003:l031","ordinal":136558,"en":"They gathered together."},{"id":"semetey-1-2013:p0787:b003:l032","ordinal":136559,"en":"Animals and people united,"},{"id":"semetey-1-2013:p0787:b003:l033","ordinal":136560,"en":"They streamed together."},{"id":"semetey-1-2013:p0787:b003:l034","ordinal":136561,"en":"Like flour of white wheat,"},{"id":"semetey-1-2013:p0787:b003:l035","ordinal":136562,"en":"They mingled together."},{"id":"semetey-1-2013:p0787:b003:l036","ordinal":136563,"en":"Like the hair of a white antelope,"},{"id":"semetey-1-2013:p0787:b003:l037","ordinal":136564,"en":"They slipped free together."},{"id":"semetey-1-2013:p0787:b003:l038","ordinal":136565,"en":"Like strained curds mixed for food,"},{"id":"semetey-1-2013:p0787:b003:l039","ordinal":136566,"en":"They mingled together."},{"id":"semetey-1-2013:p0787:b005:l001","ordinal":136567,"en":"Before even that much time had passed,"},{"id":"semetey-1-2013:p0787:b005:l002","ordinal":136568,"en":"There was another marvel."},{"id":"semetey-1-2013:p0787:b005:l003","ordinal":136569,"en":"When the horse Buurul vanished,"},{"id":"semetey-1-2013:p0787:b005:l004","ordinal":136570,"en":"When he fled from this Talas,"},{"id":"semetey-1-2013:p0787:b005:l005","ordinal":136571,"en":"Leading eighty swift horses,"},{"id":"semetey-1-2013:p0787:b005:l006","ordinal":136572,"en":"Wandering the land,"},{"id":"semetey-1-2013:p0787:b005:l007","ordinal":136573,"en":"Then Kambarata and great Bozbee,"},{"id":"semetey-1-2013:p0787:b005:l008","ordinal":136574,"en":"Khan Manas's own livestock,"},{"id":"semetey-1-2013:p0787:b005:l009","ordinal":136575,"en":"Had followed the horse Buurul"},{"id":"semetey-1-2013:p0787:b005:l010","ordinal":136576,"en":"And gone away with him."},{"id":"semetey-1-2013:p0787:b005:l011","ordinal":136577,"en":"Keeping watch, surveying the land,"},{"id":"semetey-1-2013:p0787:b005:l012","ordinal":136578,"en":"Had they not wandered about?"},{"id":"semetey-1-2013:p0787:b005:l013","ordinal":136579,"en":"‘When will Semetey come?’"},{"id":"semetey-1-2013:p0787:b005:l014","ordinal":136580,"en":"Had they not wandered in anguish?"},{"id":"semetey-1-2013:p0787:b005:l015","ordinal":136581,"en":"That Bozbee, neighing,"},{"id":"semetey-1-2013:p0787:b005:l016","ordinal":136582,"en":"Appeared on his right."},{"id":"semetey-1-2013:p0787:b005:l017","ordinal":136583,"en":"Your orphan, the son of Manas,"},{"id":"semetey-1-2013:p0787:b005:l018","ordinal":136584,"en":"Implored his Allah,"},{"id":"semetey-1-2013:p0787:b005:l019","ordinal":136585,"en":"And hung the gray belt-pouch"},{"id":"semetey-1-2013:p0787:b005:l020","ordinal":136586,"en":"Left by Manas around his neck."},{"id":"semetey-1-2013:p0787:b005:l021","ordinal":136587,"en":"‘O Creator!’ he pleaded."},{"id":"semetey-1-2013:p0787:b005:l022","ordinal":136588,"en":"The brave son born of Manas"},{"id":"semetey-1-2013:p0787:b005:l023","ordinal":136589,"en":"Took hold of that standing Bozbee,"},{"id":"semetey-1-2013:p0787:b005:l024","ordinal":136590,"en":"Her ears and forelock,"},{"id":"semetey-1-2013:p0787:b005:l025","ordinal":136591,"en":"Grasping them together."},{"id":"semetey-1-2013:p0787:b005:l026","ordinal":136592,"en":"In honor of his father Manas,"},{"id":"semetey-1-2013:p0787:b005:l027","ordinal":136593,"en":"He dedicated her and made the sacrifice."},{"id":"semetey-1-2013:p0787:b005:l028","ordinal":136594,"en":"Without first casting Bozbee down,"},{"id":"semetey-1-2013:p0787:b005:l029","ordinal":136595,"en":"He cut off her head."},{"id":"semetey-1-2013:p0787:b005:l030","ordinal":136596,"en":"They butchered Bozbee,"},{"id":"semetey-1-2013:p0787:b005:l031","ordinal":136597,"en":"And rejoiced in this way."},{"id":"semetey-1-2013:p0787:b005:l032","ordinal":136598,"en":"Was she not Manas's own livestock?"},{"id":"semetey-1-2013:p0787:b005:l033","ordinal":136599,"en":"They butchered her and spread the meat in the field."},{"id":"semetey-1-2013:p0787:b005:l034","ordinal":136600,"en":"Boiled it in a traveling cauldron."},{"id":"semetey-1-2013:p0787:b005:l035","ordinal":136601,"en":"Bakai and Semetey,"},{"id":"semetey-1-2013:p0787:b005:l036","ordinal":136602,"en":"The horse herders and the elders,"},{"id":"semetey-1-2013:p0787:b005:l037","ordinal":136603,"en":"All who had known Manas were there."},{"id":"semetey-1-2013:p0787:b005:l038","ordinal":136604,"en":"Bozbee was slaughtered as an offering;"},{"id":"semetey-1-2013:p0787:b005:l039","ordinal":136605,"en":"Everyone ate their fill,"},{"id":"semetey-1-2013:p0788:b003:l001","ordinal":136606,"en":"Extinguished fires were lit,"},{"id":"semetey-1-2013:p0788:b003:l002","ordinal":136607,"en":"Dead souls came to life,"},{"id":"semetey-1-2013:p0788:b003:l003","ordinal":136608,"en":"All the valleys and mountains ran."},{"id":"semetey-1-2013:p0788:b003:l004","ordinal":136609,"en":"‘Oh, wonder, he is Manas's son!’"},{"id":"semetey-1-2013:p0788:b003:l005","ordinal":136610,"en":"Everyone who saw him rejoiced."},{"id":"semetey-1-2013:p0788:b003:l006","ordinal":136611,"en":"They cried, ‘Baabedin!’"},{"id":"semetey-1-2013:p0788:b003:l007","ordinal":136612,"en":"‘Manas's only son has come!’"},{"id":"semetey-1-2013:p0788:b003:l009","ordinal":136613,"en":"They shouted the joyful news."},{"id":"semetey-1-2013:p0788:b003:l010","ordinal":136614,"en":"The wealthiest slaughtered mares,"},{"id":"semetey-1-2013:p0788:b003:l011","ordinal":136615,"en":"Those of middling means slaughtered sheep."},{"id":"semetey-1-2013:p0788:b003:l012","ordinal":136616,"en":"Of blessed, fierce Manas,"},{"id":"semetey-1-2013:p0788:b003:l013","ordinal":136617,"en":"The only son has come!"},{"id":"semetey-1-2013:p0788:b003:l014","ordinal":136618,"en":"The Creator God has granted him to us."},{"id":"semetey-1-2013:p0788:b003:l015","ordinal":136619,"en":"When the magnanimous one was alive,"},{"id":"semetey-1-2013:p0788:b003:l016","ordinal":136620,"en":"Among these Kyrgyz and Argyn,"},{"id":"semetey-1-2013:p0788:b003:l018","ordinal":136621,"en":"When they were encamped,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0788:b003:l019","ordinal":136622,"en":"There was kumys by day, girls by night,"},{"id":"semetey-1-2013:p0788:b003:l020","ordinal":136623,"en":"Such were those times."},{"id":"semetey-1-2013:p0788:b003:l022","ordinal":136624,"en":"When those caps swayed,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0788:b003:l024","ordinal":136625,"en":"When they lived in joy.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0788:b003:l025","ordinal":136626,"en":"While Manas was here,"},{"id":"semetey-1-2013:p0788:b003:l026","ordinal":136627,"en":"We took a whole beaver skin,"},{"id":"semetey-1-2013:p0788:b003:l027","ordinal":136628,"en":"Divided it in half,"},{"id":"semetey-1-2013:p0788:b003:l028","ordinal":136629,"en":"And put it on our trouser legs."},{"id":"semetey-1-2013:p0788:b003:l029","ordinal":136630,"en":"Our noses swelled like leather bottles;"},{"id":"semetey-1-2013:p0788:b003:l030","ordinal":136631,"en":"While fierce Manas was here,"},{"id":"semetey-1-2013:p0788:b003:l031","ordinal":136632,"en":"Did we not strut proudly about?"},{"id":"semetey-1-2013:p0788:b003:l032","ordinal":136633,"en":"When Manas died,"},{"id":"semetey-1-2013:p0788:b003:l033","ordinal":136634,"en":"When the dogs' turn came,"},{"id":"semetey-1-2013:p0788:b003:l034","ordinal":136635,"en":"Unable to bear their taxes,"},{"id":"semetey-1-2013:p0788:b003:l035","ordinal":136636,"en":"The Argyn fled to one place."},{"id":"semetey-1-2013:p0788:b003:l036","ordinal":136637,"en":"Unable to bear their conduct,"},{"id":"semetey-1-2013:p0788:b003:l037","ordinal":136638,"en":"The Kyrgyz went to another place."},{"id":"semetey-1-2013:p0788:b003:l038","ordinal":136639,"en":"When Manas died,"},{"id":"semetey-1-2013:p0788:b003:l039","ordinal":136640,"en":"They quenched the fires we had lit."},{"id":"semetey-1-2013:p0788:b004:l001","ordinal":136641,"en":"They tormented the many people"},{"id":"semetey-1-2013:p0788:b004:l002","ordinal":136642,"en":"And drove the whole nation away."},{"id":"semetey-1-2013:p0788:b004:l003","ordinal":136643,"en":"Our elders saw hell;"},{"id":"semetey-1-2013:p0788:b004:l004","ordinal":136644,"en":"As though calamity had struck,"},{"id":"semetey-1-2013:p0788:b004:l005","ordinal":136645,"en":"We all became scattered and destitute."},{"id":"semetey-1-2013:p0788:b004:l006","ordinal":136646,"en":"Abyke and Köbösh, two scoundrels:"},{"id":"semetey-1-2013:p0788:b004:l007","ordinal":136647,"en":"From them we suffered humiliation."},{"id":"semetey-1-2013:p0788:b004:l008","ordinal":136648,"en":"Chiybyt and Kochkor made four scoundrels:"},{"id":"semetey-1-2013:p0788:b004:l009","ordinal":136649,"en":"From them we suffered violence."},{"id":"semetey-1-2013:p0788:b004:l010","ordinal":136650,"en":"Adybai and Kölbai made six scoundrels:"},{"id":"semetey-1-2013:p0788:b004:l011","ordinal":136651,"en":"From them we suffered arrogance."},{"id":"semetey-1-2013:p0788:b004:l012","ordinal":136652,"en":"While those wretched six held power,"},{"id":"semetey-1-2013:p0788:b004:l013","ordinal":136653,"en":"They laid a levy on every household,"},{"id":"semetey-1-2013:p0788:b004:l014","ordinal":136654,"en":"Collected everything, leaving nothing."},{"id":"semetey-1-2013:p0788:b004:l015","ordinal":136655,"en":"Unable to bear their levy,"},{"id":"semetey-1-2013:p0788:b004:l016","ordinal":136656,"en":"These people would have been exhausted."},{"id":"semetey-1-2013:p0788:b004:l017","ordinal":136657,"en":"Now brave Manas's only son"},{"id":"semetey-1-2013:p0788:b004:l018","ordinal":136658,"en":"Has arrived."},{"id":"semetey-1-2013:p0788:b004:l019","ordinal":136659,"en":"The one God has granted"},{"id":"semetey-1-2013:p0788:b004:l020","ordinal":136660,"en":"These many people standing here"},{"id":"semetey-1-2013:p0788:b004:l021","ordinal":136661,"en":"What they longed for."},{"id":"semetey-1-2013:p0788:b004:l022","ordinal":136662,"en":"Those who would slaughter a yearling, slaughter one;"},{"id":"semetey-1-2013:p0788:b004:l023","ordinal":136663,"en":"Those who would slaughter a mare, slaughter one!’"},{"id":"semetey-1-2013:p0788:b004:l024","ordinal":136664,"en":"Argyn and Kyrgyz sobbed,"},{"id":"semetey-1-2013:p0788:b004:l025","ordinal":136665,"en":"Cried out and made offerings."},{"id":"semetey-1-2013:p0788:b004:l026","ordinal":136666,"en":"Their quenched fire was kindled;"},{"id":"semetey-1-2013:p0788:b004:l027","ordinal":136667,"en":"The dead Manas came to life."},{"id":"semetey-1-2013:p0788:b004:l028","ordinal":136668,"en":"‘Manas's son has come!’"},{"id":"semetey-1-2013:p0788:b004:l029","ordinal":136669,"en":"Those in the valleys ran to the mountains"},{"id":"semetey-1-2013:p0788:b004:l030","ordinal":136670,"en":"To bear the joyful news."},{"id":"semetey-1-2013:p0788:b004:l031","ordinal":136671,"en":"Dusk fell and the sun set;"},{"id":"semetey-1-2013:p0788:b004:l032","ordinal":136672,"en":"The first of the people lay asleep."},{"id":"semetey-1-2013:p0788:b004:l033","ordinal":136673,"en":"Manas's sister Kardygach"},{"id":"semetey-1-2013:p0788:b004:l034","ordinal":136674,"en":"Wore out her horse, searching the land,"},{"id":"semetey-1-2013:p0788:b004:l035","ordinal":136675,"en":"Followed tracks without sleep,"},{"id":"semetey-1-2013:p0788:b004:l036","ordinal":136676,"en":"Could not rest even on her elbow,"},{"id":"semetey-1-2013:p0788:b004:l037","ordinal":136677,"en":"Could not sleep even a moment."},{"id":"semetey-1-2013:p0788:b004:l038","ordinal":136678,"en":"That lion-limbed, valiant woman"},{"id":"semetey-1-2013:p0788:b004:l039","ordinal":136679,"en":"Had been born of the same nest as Manas."},{"id":"semetey-1-2013:p0789:b003:l001","ordinal":136680,"en":"If anyone attacked the orphan,"},{"id":"semetey-1-2013:p0789:b003:l002","ordinal":136681,"en":"To charge with a shout and thrust her spear,"},{"id":"semetey-1-2013:p0789:b003:l003","ordinal":136682,"en":"To knock the fury out of anyone she met,"},{"id":"semetey-1-2013:p0789:b003:l004","ordinal":136683,"en":"To strike off his apple-like head,"},{"id":"semetey-1-2013:p0789:b003:l005","ordinal":136684,"en":"To drag him along the road,"},{"id":"semetey-1-2013:p0789:b003:l007","ordinal":136685,"en":"If the six fools acted treacherously,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0789:b003:l008","ordinal":136686,"en":"To make a great spectacle of them,"},{"id":"semetey-1-2013:p0789:b003:l009","ordinal":136687,"en":"If the forty companions showed enmity,"},{"id":"semetey-1-2013:p0789:b003:l010","ordinal":136688,"en":"To leave not a single one of them,"},{"id":"semetey-1-2013:p0789:b003:l011","ordinal":136689,"en":"The elders led by Kyrgyl,"},{"id":"semetey-1-2013:p0789:b003:l012","ordinal":136690,"en":"To slaughter them all,"},{"id":"semetey-1-2013:p0789:b003:l013","ordinal":136691,"en":"That same tiger Kardygach"},{"id":"semetey-1-2013:p0789:b003:l014","ordinal":136692,"en":"Had kept watch,"},{"id":"semetey-1-2013:p0789:b003:l015","ordinal":136693,"en":"And learned that he was safe."},{"id":"semetey-1-2013:p0789:b003:l016","ordinal":136694,"en":"Telküröng beneath her"},{"id":"semetey-1-2013:p0789:b003:l017","ordinal":136695,"en":"Flattened his ears like a spirit-horse,"},{"id":"semetey-1-2013:p0789:b003:l018","ordinal":136696,"en":"Scattered the earth like a whirlwind,"},{"id":"semetey-1-2013:p0789:b003:l019","ordinal":136697,"en":"Raced against flying birds,"},{"id":"semetey-1-2013:p0789:b003:l020","ordinal":136698,"en":"Fought against the bit,"},{"id":"semetey-1-2013:p0789:b003:l021","ordinal":136699,"en":"Reared wildly and strained,"},{"id":"semetey-1-2013:p0789:b003:l022","ordinal":136700,"en":"Thrashed as though her husband had died."},{"id":"semetey-1-2013:p0789:b003:l023","ordinal":136701,"en":"That day Telküröng"},{"id":"semetey-1-2013:p0789:b003:l024","ordinal":136702,"en":"Showed the qualities of a noble steed."},{"id":"semetey-1-2013:p0789:b003:l025","ordinal":136703,"en":"Where he stepped, the dark earth"},{"id":"semetey-1-2013:p0789:b003:l026","ordinal":136704,"en":"Parted like a hearth pit;"}]
