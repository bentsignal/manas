[{"id":"manas-2010:p1141:b001:l026","ordinal":49665,"en":"Such was the deed I began."},{"id":"manas-2010:p1141:b001:l027","ordinal":49666,"en":"His boiling cauldron"},{"id":"manas-2010:p1141:b001:l028","ordinal":49667,"en":"I shattered into sixty pieces."},{"id":"manas-2010:p1141:b001:l029","ordinal":49668,"en":"Red-faced, quarreling,"},{"id":"manas-2010:p1141:b001:l030","ordinal":49669,"en":"What desire would I fulfill?"},{"id":"manas-2010:p1141:b001:l031","ordinal":49670,"en":"Instead, one who understands the heart,"},{"id":"manas-2010:p1141:b001:l032","ordinal":49671,"en":"A mighty one with a welcoming face,"},{"id":"manas-2010:p1141:b001:l033","ordinal":49672,"en":"“Let me go seeking such a warrior,” I said,"},{"id":"manas-2010:p1141:b001:l034","ordinal":49673,"en":"And ran outside."},{"id":"manas-2010:p1141:b001:l035","ordinal":49674,"en":"Cow-rumped Sarala,"},{"id":"manas-2010:p1141:b001:l036","ordinal":49675,"en":"I sprang up tightly onto him."},{"id":"manas-2010:p1141:b001:l037","ordinal":49676,"en":"After I had mounted Sarala,"},{"id":"manas-2010:p1141:b001:l038","ordinal":49677,"en":"With warrior Mazhik following,"},{"id":"manas-2010:p1141:b001:l039","ordinal":49678,"en":"I left the many Kazakhs behind."},{"id":"manas-2010:p1141:b001:l040","ordinal":49679,"en":"After I had turned and gone,"},{"id":"manas-2010:p1141:b001:l041","ordinal":49680,"en":"Relying on Sarala,"},{"id":"manas-2010:p1141:b001:l042","ordinal":49681,"en":"Then I reached"},{"id":"manas-2010:p1142:b001:l001","ordinal":49682,"en":"The approaches of Sary-Arka."},{"id":"manas-2010:p1142:b001:l002","ordinal":49683,"en":"When I reached Sary-Arka,"},{"id":"manas-2010:p1142:b001:l003","ordinal":49684,"en":"Behind me was a great shouting."},{"id":"manas-2010:p1142:b001:l004","ordinal":49685,"en":"Galloping bent over their horses' manes,"},{"id":"manas-2010:p1142:b001:l005","ordinal":49686,"en":"Many Kazakhs shouted,"},{"id":"manas-2010:p1142:b001:l006","ordinal":49687,"en":"Raising the battle cry, “Kökchö!”"},{"id":"manas-2010:p1142:b001:l007","ordinal":49688,"en":"My insides burned to fire."},{"id":"manas-2010:p1142:b001:l008","ordinal":49689,"en":"When I saw their dog-like conduct,"},{"id":"manas-2010:p1142:b001:l009","ordinal":49690,"en":"How could I stay calm?"},{"id":"manas-2010:p1142:b001:l010","ordinal":49691,"en":"Those Kazakhs who pursued me,"},{"id":"manas-2010:p1142:b001:l011","ordinal":49692,"en":"I had not stolen their piebald horse,"},{"id":"manas-2010:p1142:b001:l012","ordinal":49693,"en":"To deserve such a pursuit;"},{"id":"manas-2010:p1142:b001:l013","ordinal":49694,"en":"I had not scattered their silver-coin wealth."},{"id":"manas-2010:p1142:b001:l014","ordinal":49695,"en":"Whatever was brought upon my head,"},{"id":"manas-2010:p1142:b001:l015","ordinal":49696,"en":"“Let me face it,” I thought."},{"id":"manas-2010:p1142:b001:l016","ordinal":49697,"en":"Turning back to attack the Kazakhs,"},{"id":"manas-2010:p1142:b001:l017","ordinal":49698,"en":"“If death has come, at Kökchö's hands"},{"id":"manas-2010:p1142:b001:l018","ordinal":49699,"en":"Let me die,” I thought!"},{"id":"manas-2010:p1142:b001:l019","ordinal":49700,"en":"Then I took Syrbarang,"},{"id":"manas-2010:p1142:b001:l020","ordinal":49701,"en":"I grasped it by the stock,"},{"id":"manas-2010:p1142:b001:l021","ordinal":49702,"en":"I pointed it toward the Kazakhs."},{"id":"manas-2010:p1142:b001:l022","ordinal":49703,"en":"As my fired bullet was about to strike,"},{"id":"manas-2010:p1142:b001:l023","ordinal":49704,"en":"As I was about to fire and enter battle,"},{"id":"manas-2010:p1142:b001:l024","ordinal":49705,"en":"Grasping the reins, making ready,"},{"id":"manas-2010:p1142:b001:l025","ordinal":49706,"en":"“Do not shoot, Alma,” he said."},{"id":"manas-2010:p1142:b001:l026","ordinal":49707,"en":"Not letting go, warrior Mazhik"},{"id":"manas-2010:p1142:b001:l027","ordinal":49708,"en":"Also grasped the gun and pleaded."},{"id":"manas-2010:p1142:b001:l028","ordinal":49709,"en":"Then Mazhik said this,"},{"id":"manas-2010:p1142:b001:l029","ordinal":49710,"en":"My dear one, in distress:"},{"id":"manas-2010:p1142:b001:l030","ordinal":49711,"en":"“My beloved Almambet,"},{"id":"manas-2010:p1142:b001:l031","ordinal":49712,"en":"What guilt lies with the common people?"},{"id":"manas-2010:p1142:b001:l032","ordinal":49713,"en":"Is it not their khan who is a fool,"},{"id":"manas-2010:p1142:b001:l033","ordinal":49714,"en":"This witless Kazakh?"},{"id":"manas-2010:p1142:b001:l034","ordinal":49715,"en":"Stop, Alma, do not shoot."},{"id":"manas-2010:p1142:b001:l035","ordinal":49716,"en":"We too must die in the end!”"},{"id":"manas-2010:p1142:b001:l036","ordinal":49717,"en":"Drawing back the gun,"},{"id":"manas-2010:p1142:b001:l037","ordinal":49718,"en":"I slung it over my broad shoulder."},{"id":"manas-2010:p1142:b001:l038","ordinal":49719,"en":"These words Mazhik spoke,"},{"id":"manas-2010:p1142:b001:l039","ordinal":49720,"en":"I knew they were true."},{"id":"manas-2010:p1142:b001:l040","ordinal":49721,"en":"“If I slaughtered the Kazakhs,"},{"id":"manas-2010:p1142:b001:l041","ordinal":49722,"en":"What desire would I fulfill?"},{"id":"manas-2010:p1142:b001:l042","ordinal":49723,"en":"Instead, the Kazakhs,"},{"id":"manas-2010:p1143:b001:l001","ordinal":49724,"en":"Let me beat them with my whip and go!”"},{"id":"manas-2010:p1143:b001:l002","ordinal":49725,"en":"I took hold of the hawthorn handle."},{"id":"manas-2010:p1143:b001:l003","ordinal":49726,"en":"Into the mass of Kazakhs,"},{"id":"manas-2010:p1143:b001:l004","ordinal":49727,"en":"Into the many people of Sary-Arka,"},{"id":"manas-2010:p1143:b001:l005","ordinal":49728,"en":"I entered with my whip."},{"id":"manas-2010:p1143:b001:l006","ordinal":49729,"en":"All the spearmen"},{"id":"manas-2010:p1143:b001:l007","ordinal":49730,"en":"I drove away shouting."},{"id":"manas-2010:p1143:b001:l008","ordinal":49731,"en":"Overwhelming their marksmen,"},{"id":"manas-2010:p1143:b001:l009","ordinal":49732,"en":"I struck and scattered them to pieces."},{"id":"manas-2010:p1143:b001:l010","ordinal":49733,"en":"The Kazakhs who had surged forward,"},{"id":"manas-2010:p1143:b001:l011","ordinal":49734,"en":"Making them plead, “Dear elder,”"},{"id":"manas-2010:p1143:b001:l012","ordinal":49735,"en":"I drove them into their camp."},{"id":"manas-2010:p1143:b001:l013","ordinal":49736,"en":"When they entered their camp,"},{"id":"manas-2010:p1143:b001:l014","ordinal":49737,"en":"Wailing and sobbing, the many Kazakhs,"},{"id":"manas-2010:p1143:b001:l015","ordinal":49738,"en":"All of them crying bitterly,"},{"id":"manas-2010:p1143:b001:l016","ordinal":49739,"en":"Dismounted and fled from their horses,"},{"id":"manas-2010:p1143:b001:l017","ordinal":49740,"en":"Running in every direction, screaming."},{"id":"manas-2010:p1143:b001:l018","ordinal":49741,"en":"As I looked then,"},{"id":"manas-2010:p1143:b001:l019","ordinal":49742,"en":"Aydarkan's warrior Kökchö"},{"id":"manas-2010:p1143:b001:l020","ordinal":49743,"en":"Was fleeing before me,"},{"id":"manas-2010:p1143:b001:l021","ordinal":49744,"en":"Riding Kögala at a clatter."},{"id":"manas-2010:p1143:b001:l022","ordinal":49745,"en":"Galloping on Sarala,"},{"id":"manas-2010:p1143:b001:l023","ordinal":49746,"en":"I reached him before an arrow."},{"id":"manas-2010:p1143:b001:l024","ordinal":49747,"en":"Upon reaching Kökchö,"},{"id":"manas-2010:p1143:b001:l025","ordinal":49748,"en":"I struck his crown and passed."},{"id":"manas-2010:p1143:b001:l026","ordinal":49749,"en":"With no more than a single blow,"},{"id":"manas-2010:p1143:b001:l027","ordinal":49750,"en":"My dear friend Kökchö,"},{"id":"manas-2010:p1143:b001:l028","ordinal":49751,"en":"I struck him down and went on."},{"id":"manas-2010:p1143:b001:l029","ordinal":49752,"en":"His head split, swelling,"},{"id":"manas-2010:p1143:b001:l030","ordinal":49753,"en":"Separated from Kögala,"},{"id":"manas-2010:p1143:b001:l031","ordinal":49754,"en":"In the middle of the enclosure"},{"id":"manas-2010:p1143:b001:l032","ordinal":49755,"en":"He remained sitting, spread out."},{"id":"manas-2010:p1143:b001:l033","ordinal":49756,"en":"Kögala, whom he would not give if asked,"},{"id":"manas-2010:p1143:b001:l034","ordinal":49757,"en":"I cast a thieving pole upon him."},{"id":"manas-2010:p1143:b001:l035","ordinal":49758,"en":"Kögala, whom he would not give if begged,"},{"id":"manas-2010:p1143:b001:l036","ordinal":49759,"en":"I took along unsaddled."},{"id":"manas-2010:p1143:b001:l037","ordinal":49760,"en":"Turning and urging them on,"},{"id":"manas-2010:p1143:b001:l038","ordinal":49761,"en":"I headed for the road!"},{"id":"manas-2010:p1143:b001:l039","ordinal":49762,"en":"My many cares could not fit in my breast."},{"id":"manas-2010:p1143:b001:l040","ordinal":49763,"en":"Coming out upon my road, sobbing,"},{"id":"manas-2010:p1143:b001:l041","ordinal":49764,"en":"My friend's wife Akerkech,"},{"id":"manas-2010:p1143:b001:l042","ordinal":49765,"en":"Her tears streamed in ten directions."},{"id":"manas-2010:p1144:b001:l001","ordinal":49766,"en":"She could not sniff back her running nose,"},{"id":"manas-2010:p1144:b001:l002","ordinal":49767,"en":"She could not wipe away her tears!"},{"id":"manas-2010:p1144:b001:l003","ordinal":49768,"en":"Wheat-complexioned, black-eyed,"},{"id":"manas-2010:p1144:b001:l004","ordinal":49769,"en":"Tears flowed in separate streams."},{"id":"manas-2010:p1144:b001:l005","ordinal":49770,"en":"Black eyes like currants,"},{"id":"manas-2010:p1144:b001:l006","ordinal":49771,"en":"My dear sister-in-law Akerkech,"},{"id":"manas-2010:p1144:b001:l007","ordinal":49772,"en":"Tears mingled with blood flowed."},{"id":"manas-2010:p1144:b001:l008","ordinal":49773,"en":"When she came out before me,"},{"id":"manas-2010:p1144:b001:l009","ordinal":49774,"en":"“By taking Kökchö's horse,"},{"id":"manas-2010:p1144:b001:l010","ordinal":49775,"en":"What desire will I fulfill?"},{"id":"manas-2010:p1144:b001:l011","ordinal":49776,"en":"My friend's wife, sister Akerkech,"},{"id":"manas-2010:p1144:b001:l012","ordinal":49777,"en":"As booty, as a gift,"},{"id":"manas-2010:p1144:b001:l013","ordinal":49778,"en":"Let me give it to you and go!”"},{"id":"manas-2010:p1144:b001:l014","ordinal":49779,"en":"The leading rope tied with a rounded knot,"},{"id":"manas-2010:p1144:b001:l015","ordinal":49780,"en":"“Take this horse,” I said,"},{"id":"manas-2010:p1144:b001:l016","ordinal":49781,"en":"Throwing it toward Erkech."},{"id":"manas-2010:p1144:b001:l017","ordinal":49782,"en":"After I gave the horse to Erkech,"},{"id":"manas-2010:p1144:b001:l018","ordinal":49783,"en":"Aydarkan's Kökchö,"},{"id":"manas-2010:p1144:b001:l019","ordinal":49784,"en":"After I knew his beastliness,"},{"id":"manas-2010:p1144:b001:l020","ordinal":49785,"en":"With warrior Mazhik following,"},{"id":"manas-2010:p1144:b001:l021","ordinal":49786,"en":"I journeyed without tiring."},{"id":"manas-2010:p1144:b001:l022","ordinal":49787,"en":"Karakan's daughter Kanykey,"},{"id":"manas-2010:p1144:b001:l023","ordinal":49788,"en":"Manas's chief wife,"},{"id":"manas-2010:p1144:b001:l024","ordinal":49789,"en":"Had known I would flee."},{"id":"manas-2010:p1144:b001:l025","ordinal":49790,"en":"“He will not remain at peace with Kökchö;"},{"id":"manas-2010:p1144:b001:l026","ordinal":49791,"en":"He will leave,” she had been saying."},{"id":"manas-2010:p1144:b001:l027","ordinal":49792,"en":"Making his appearance surpass other people's,"},{"id":"manas-2010:p1144:b001:l028","ordinal":49793,"en":"Dressing him in an outer coat,"},{"id":"manas-2010:p1144:b001:l029","ordinal":49794,"en":"Mounting him on a swift riding camel,"},{"id":"manas-2010:p1144:b001:l030","ordinal":49795,"en":"Warrior Shuutu with his roof-felt hat,"},{"id":"manas-2010:p1144:b001:l031","ordinal":49796,"en":"She sent him expressly to meet me."},{"id":"manas-2010:p1144:b001:l032","ordinal":49797,"en":"Her Shuutu whom she sent to meet me,"},{"id":"manas-2010:p1144:b001:l033","ordinal":49798,"en":"On a broad rocky ledge,"},{"id":"manas-2010:p1144:b001:l034","ordinal":49799,"en":"Lay and slept his fill."},{"id":"manas-2010:p1144:b001:l036","ordinal":49800,"en":"He let the riding camel graze.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p1144:b001:l037","ordinal":49801,"en":"Beyond his appointed time, two days"},{"id":"manas-2010:p1144:b001:l038","ordinal":49802,"en":"Had passed by then."},{"id":"manas-2010:p1144:b001:l039","ordinal":49803,"en":"Before me, to Talas,"},{"id":"manas-2010:p1144:b001:l040","ordinal":49804,"en":"Turning back without looking,"},{"id":"manas-2010:p1144:b001:l041","ordinal":49805,"en":"He had already gone."},{"id":"manas-2010:p1144:b001:l042","ordinal":49806,"en":"Not meeting him, my heart grew faint."},{"id":"manas-2010:p1145:b001:l001","ordinal":49807,"en":"What could I do, the road was barred;"},{"id":"manas-2010:p1145:b001:l002","ordinal":49808,"en":"We passed opposite ways then."},{"id":"manas-2010:p1145:b001:l003","ordinal":49809,"en":"I went on without stopping."},{"id":"manas-2010:p1145:b001:l004","ordinal":49810,"en":"When I left Sary-Arka,"},{"id":"manas-2010:p1145:b001:l005","ordinal":49811,"en":"I reached Bukhara."},{"id":"manas-2010:p1145:b001:l006","ordinal":49812,"en":"As a guest in Bukhara,"},{"id":"manas-2010:p1145:b001:l007","ordinal":49813,"en":"Without lingering I passed on."},{"id":"manas-2010:p1145:b001:l008","ordinal":49814,"en":"I reached a great river."},{"id":"manas-2010:p1145:b001:l009","ordinal":49815,"en":"Upon the great river I saw a raft."},{"id":"manas-2010:p1145:b001:l010","ordinal":49816,"en":"With the appearance of a Muslim,"},{"id":"manas-2010:p1145:b001:l011","ordinal":49817,"en":"I saw a rather imposing man."},{"id":"manas-2010:p1145:b001:l012","ordinal":49818,"en":"I greeted him and pleaded."},{"id":"manas-2010:p1145:b001:l013","ordinal":49819,"en":"“May it be a good deed, dear elder,"},{"id":"manas-2010:p1145:b001:l014","ordinal":49820,"en":"Put Sarala aboard,” I said,"},{"id":"manas-2010:p1145:b001:l015","ordinal":49821,"en":"And pleaded with the religious elders."},{"id":"manas-2010:p1145:b001:l016","ordinal":49822,"en":"“Put Sarala aboard,” I said,"},{"id":"manas-2010:p1145:b001:l017","ordinal":49823,"en":"And offered red gold."},{"id":"manas-2010:p1145:b001:l018","ordinal":49824,"en":"The wretched religious elder would not relent."},{"id":"manas-2010:p1145:b001:l019","ordinal":49825,"en":"“I shall not put Sarala aboard,” he said,"},{"id":"manas-2010:p1145:b001:l020","ordinal":49826,"en":"Growling and refusing."},{"id":"manas-2010:p1145:b001:l021","ordinal":49827,"en":"When I offered gold, he did not take it."},{"id":"manas-2010:p1145:b001:l022","ordinal":49828,"en":"However much I pleaded,"},{"id":"manas-2010:p1145:b001:l023","ordinal":49829,"en":"He would not put Sarala aboard."},{"id":"manas-2010:p1145:b001:l024","ordinal":49830,"en":"“If Sarala goes to Mecca,"},{"id":"manas-2010:p1145:b001:l025","ordinal":49831,"en":"Almambet will have no regret."},{"id":"manas-2010:p1145:b001:l026","ordinal":49832,"en":"Parted from Sarala,"},{"id":"manas-2010:p1145:b001:l027","ordinal":49833,"en":"What desire would I fulfill?” I said."},{"id":"manas-2010:p1145:b001:l028","ordinal":49834,"en":"“United with me when I was louse-sized,"},{"id":"manas-2010:p1145:b001:l029","ordinal":49835,"en":"My steed and companion Sarala,"},{"id":"manas-2010:p1145:b001:l030","ordinal":49836,"en":"Where could I abandon him?” I said."},{"id":"manas-2010:p1145:b001:l031","ordinal":49837,"en":"As I stood bewildered,"},{"id":"manas-2010:p1145:b001:l032","ordinal":49838,"en":"“Sarala and Kögala,"},{"id":"manas-2010:p1145:b001:l033","ordinal":49839,"en":"Entrust them to us,” he said,"},{"id":"manas-2010:p1145:b001:l034","ordinal":49840,"en":"And a wandering holy man appeared."},{"id":"manas-2010:p1145:b001:l035","ordinal":49841,"en":"The decree God had sent,"},{"id":"manas-2010:p1145:b001:l036","ordinal":49842,"en":"I saw it was thus."},{"id":"manas-2010:p1145:b001:l037","ordinal":49843,"en":"Kögala and Sarala,"},{"id":"manas-2010:p1145:b001:l038","ordinal":49844,"en":"As a trust then,"},{"id":"manas-2010:p1145:b001:l039","ordinal":49845,"en":"I gave to the wandering holy man."},{"id":"manas-2010:p1145:b001:l040","ordinal":49846,"en":"I boarded the raft."},{"id":"manas-2010:p1145:b001:l041","ordinal":49847,"en":"With warrior Mazhik following,"},{"id":"manas-2010:p1145:b001:l042","ordinal":49848,"en":"I went to Mecca."},{"id":"manas-2010:p1146:b001:l001","ordinal":49849,"en":"Hearing blessings from five spiritual masters,"},{"id":"manas-2010:p1146:b001:l002","ordinal":49850,"en":"I stayed five days in Mecca."},{"id":"manas-2010:p1146:b001:l003","ordinal":49851,"en":"Staying in Mecca, I grieved."},{"id":"manas-2010:p1146:b001:l004","ordinal":49852,"en":"Never far from my mind,"},{"id":"manas-2010:p1146:b001:l005","ordinal":49853,"en":"I longed for Sarala."},{"id":"manas-2010:p1146:b001:l006","ordinal":49854,"en":"As I slept, in my dream,"},{"id":"manas-2010:p1146:b001:l007","ordinal":49855,"en":"Cow-rumped Sarala"},{"id":"manas-2010:p1146:b001:l008","ordinal":49856,"en":"Turned his neck like a mountain ram."},{"id":"manas-2010:p1146:b001:l009","ordinal":49857,"en":"Before my face, my steed,"},{"id":"manas-2010:p1146:b001:l010","ordinal":49858,"en":"Lowering his head as though weeping,"},{"id":"manas-2010:p1146:b001:l011","ordinal":49859,"en":"Stood looking at me."},{"id":"manas-2010:p1146:b001:l012","ordinal":49860,"en":"Sarala said this to me,"},{"id":"manas-2010:p1146:b001:l013","ordinal":49861,"en":"Saying it, he made me mourn:"},{"id":"manas-2010:p1146:b001:l014","ordinal":49862,"en":"“My courser's soul, my precious soul,"},{"id":"manas-2010:p1146:b001:l015","ordinal":49863,"en":"Have you ruined it, Alake?"},{"id":"manas-2010:p1146:b001:l016","ordinal":49864,"en":"Truly without a thought,"},{"id":"manas-2010:p1146:b001:l017","ordinal":49865,"en":"Have you forgotten me, Alake?”"},{"id":"manas-2010:p1146:b001:l018","ordinal":49866,"en":"Day and night, from my thoughts,"},{"id":"manas-2010:p1146:b001:l019","ordinal":49867,"en":"Sarala not leaving for a moment,"},{"id":"manas-2010:p1146:b001:l020","ordinal":49868,"en":"I turned back from Mecca."},{"id":"manas-2010:p1146:b001:l021","ordinal":49869,"en":"My companion though a beast,"},{"id":"manas-2010:p1146:b001:l022","ordinal":49870,"en":"My truly swift noble steed,"},{"id":"manas-2010:p1146:b001:l023","ordinal":49871,"en":"For Sarala's sake,"},{"id":"manas-2010:p1146:b001:l024","ordinal":49872,"en":"When I returned,"},{"id":"manas-2010:p1146:b001:l025","ordinal":49873,"en":"At the place where I left the horse,"},{"id":"manas-2010:p1146:b001:l026","ordinal":49874,"en":"Not even a crow, let alone my horse."},{"id":"manas-2010:p1146:b001:l027","ordinal":49875,"en":"I stood looking helplessly;"},{"id":"manas-2010:p1146:b001:l028","ordinal":49876,"en":"There was no way to find the horse."},{"id":"manas-2010:p1146:b001:l029","ordinal":49877,"en":"When light touched the earth,"},{"id":"manas-2010:p1146:b001:l030","ordinal":49878,"en":"When dawn broke clear,"},{"id":"manas-2010:p1146:b001:l032","ordinal":49879,"en":"The wandering holy man who had remained,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p1146:b001:l033","ordinal":49880,"en":"Sarala and Kögala,"},{"id":"manas-2010:p1146:b001:l034","ordinal":49881,"en":"He brought them, leading them."},{"id":"manas-2010:p1146:b001:l035","ordinal":49882,"en":"When the two horses reached my hands,"},{"id":"manas-2010:p1146:b001:l036","ordinal":49883,"en":"At that time Sarala"},{"id":"manas-2010:p1146:b001:l037","ordinal":49884,"en":"Was in lean racing condition."},{"id":"manas-2010:p1146:b001:l038","ordinal":49885,"en":"When I thought about that moment,"},{"id":"manas-2010:p1146:b001:l039","ordinal":49886,"en":"I thought it night, but it was day."},{"id":"manas-2010:p1146:b001:l040","ordinal":49887,"en":"The holy man who had named me,"},{"id":"manas-2010:p1146:b001:l041","ordinal":49888,"en":"One of the unseen heroes, the Forty Saints,"},{"id":"manas-2010:p1146:b001:l042","ordinal":49889,"en":"Was one of the holy ones."},{"id":"manas-2010:p1147:b001:l001","ordinal":49890,"en":"When I mounted Sarala,"},{"id":"manas-2010:p1147:b001:l002","ordinal":49891,"en":"I truly journeyed far."},{"id":"manas-2010:p1147:b001:l003","ordinal":49892,"en":"Traveling on for several days,"},{"id":"manas-2010:p1147:b001:l004","ordinal":49893,"en":"I reached Bukhara."},{"id":"manas-2010:p1147:b001:l005","ordinal":49894,"en":"Giving an open greeting,"},{"id":"manas-2010:p1147:b001:l006","ordinal":49895,"en":"A man came out before me."},{"id":"manas-2010:p1147:b001:l007","ordinal":49896,"en":"Beneath him was a gray horse."},{"id":"manas-2010:p1147:b001:l008","ordinal":49897,"en":"When I stood observing his bearing,"},{"id":"manas-2010:p1147:b001:l009","ordinal":49898,"en":"The man upon it"},{"id":"manas-2010:p1147:b001:l010","ordinal":49899,"en":"Had the strength of a thousand men."},{"id":"manas-2010:p1147:b001:l011","ordinal":49900,"en":"His face was white as fine cambric,"},{"id":"manas-2010:p1147:b001:l012","ordinal":49901,"en":"His black beard like pistachios,"},{"id":"manas-2010:p1147:b001:l013","ordinal":49902,"en":"His eyes like the hollow of a lake,"},{"id":"manas-2010:p1147:b001:l014","ordinal":49903,"en":"As though to swallow all he saw."},{"id":"manas-2010:p1147:b001:l015","ordinal":49904,"en":"His majesty, if you saw it, was auspicious;"},{"id":"manas-2010:p1147:b001:l016","ordinal":49905,"en":"Entering combat, he was like a vast army."},{"id":"manas-2010:p1147:b001:l017","ordinal":49906,"en":"Wearing a gray lynx-fur cap,"},{"id":"manas-2010:p1147:b001:l018","ordinal":49907,"en":"Wielding a blue iron shield,"},{"id":"manas-2010:p1147:b001:l019","ordinal":49908,"en":"The lordly, mighty Khan Bakay"},{"id":"manas-2010:p1147:b001:l020","ordinal":49909,"en":"Had rinsed his mouth with honey."},{"id":"manas-2010:p1147:b001:l021","ordinal":49910,"en":"His battle-axe stood ready,"},{"id":"manas-2010:p1147:b001:l022","ordinal":49911,"en":"Every item of his equipment"},{"id":"manas-2010:p1147:b001:l023","ordinal":49912,"en":"Prepared upon his body."},{"id":"manas-2010:p1147:b001:l024","ordinal":49913,"en":"Coming up behind me, looming large,"},{"id":"manas-2010:p1147:b001:l025","ordinal":49914,"en":"Holding out his hand broadly,"},{"id":"manas-2010:p1147:b001:l026","ordinal":49915,"en":"He extended it to me:"},{"id":"manas-2010:p1147:b001:l027","ordinal":49916,"en":"“Planted with yellow willows,"},{"id":"manas-2010:p1147:b001:l028","ordinal":49917,"en":"You left your garden in Beijing."},{"id":"manas-2010:p1147:b001:l029","ordinal":49918,"en":"Made of pure gold,"},{"id":"manas-2010:p1147:b001:l030","ordinal":49919,"en":"You left your dwelling in Beijing."},{"id":"manas-2010:p1147:b001:l031","ordinal":49920,"en":"Cleansed of the dark faith,"}]
