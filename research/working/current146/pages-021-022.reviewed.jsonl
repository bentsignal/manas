{"id": "sayakbay-ms-current146:pdf022:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 22, "folio": 405, "line_in_page": 9, "raw": "Сөз сүйлөгөнү былкыл күл,", "text": "Сөз сүйлөгөнү былкыл күл,", "en": "When he spoke, [the final phrase is uncertain],", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Сөз сүйлөгөнү is clear; былкыл күл is a visual approximation whose sense is unresolved.", "bbox": null}
