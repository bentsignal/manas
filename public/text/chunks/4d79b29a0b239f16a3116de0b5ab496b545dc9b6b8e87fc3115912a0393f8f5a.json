[{"id":"semetey-2-2013:p1312:b003:l030","ordinal":286721,"en":"Upon every plane tree"},{"id":"semetey-2-2013:p1312:b003:l031","ordinal":286722,"en":"Let mournful creatures sing and trill,"},{"id":"semetey-2-2013:p1312:b003:l032","ordinal":286723,"en":"And whoever hears them weep tears."},{"id":"semetey-2-2013:p1312:b003:l033","ordinal":286724,"en":"Build her a palace for promenades."},{"id":"semetey-2-2013:p1312:b003:l034","ordinal":286725,"en":"Brave Kyyaz, giant of the Jediger,"},{"id":"semetey-2-2013:p1312:b003:l035","ordinal":286726,"en":"If you are a man, if you are a lion,"},{"id":"semetey-2-2013:p1312:b003:l036","ordinal":286727,"en":"Take these words to heart."},{"id":"semetey-2-2013:p1312:b003:l037","ordinal":286728,"en":"Gather your heroes and hold games;"},{"id":"semetey-2-2013:p1312:b003:l038","ordinal":286729,"en":"Hold the games of Kanchoro Khan."},{"id":"semetey-2-2013:p1312:b003:l039","ordinal":286730,"en":"Carry out the words of a wise hero;"},{"id":"semetey-2-2013:p1312:b004:l001","ordinal":286731,"en":"Without discarding a single word,"},{"id":"semetey-2-2013:p1312:b004:l002","ordinal":286732,"en":"Do exactly as I say."},{"id":"semetey-2-2013:p1312:b004:l003","ordinal":286733,"en":"I tell you ten thousand words—know them;"},{"id":"semetey-2-2013:p1312:b004:l004","ordinal":286734,"en":"Accursed Kyyaz, heed my tongue!"},{"id":"semetey-2-2013:p1312:b004:l005","ordinal":286735,"en":"Prepare all four kinds of livestock,"},{"id":"semetey-2-2013:p1312:b004:l006","ordinal":286736,"en":"And deceive Chürök, who struck from above,"},{"id":"semetey-2-2013:p1312:b004:l007","ordinal":286737,"en":"With all your wealth."},{"id":"semetey-2-2013:p1312:b004:l008","ordinal":286738,"en":"This woman Aychürök—"},{"id":"semetey-2-2013:p1312:b004:l009","ordinal":286739,"en":"What does that shimmering infidel"},{"id":"semetey-2-2013:p1312:b004:l010","ordinal":286740,"en":"Possess, and what does she lack?"},{"id":"semetey-2-2013:p1312:b004:l011","ordinal":286741,"en":"She is good and radiantly beautiful,"},{"id":"semetey-2-2013:p1312:b004:l012","ordinal":286742,"en":"And she also has humanity;"},{"id":"semetey-2-2013:p1312:b004:l013","ordinal":286743,"en":"She is a true sorceress and witch,"},{"id":"semetey-2-2013:p1312:b004:l014","ordinal":286744,"en":"And has an infidel’s nature too."},{"id":"semetey-2-2013:p1312:b004:l015","ordinal":286745,"en":"This is what I tell you, brave Kyyaz:"},{"id":"semetey-2-2013:p1312:b004:l016","ordinal":286746,"en":"Do not raise your whip and strike her;"},{"id":"semetey-2-2013:p1312:b004:l017","ordinal":286747,"en":"Do not take the daylight from beneath her;"},{"id":"semetey-2-2013:p1312:b004:l018","ordinal":286748,"en":"Do not leave yourself in such torment."},{"id":"semetey-2-2013:p1312:b004:l019","ordinal":286749,"en":"Do not rage at her in manly pride;"},{"id":"semetey-2-2013:p1312:b004:l020","ordinal":286750,"en":"Never curse or revile her."},{"id":"semetey-2-2013:p1312:b004:l021","ordinal":286751,"en":"That sorcerous infidel,"},{"id":"semetey-2-2013:p1312:b004:l022","ordinal":286752,"en":"The enchanted woman Chürök—"},{"id":"semetey-2-2013:p1312:b004:l023","ordinal":286753,"en":"If you should accidentally wound her heart,"},{"id":"semetey-2-2013:p1312:b004:l024","ordinal":286754,"en":"If you should quarrel by mischance,"},{"id":"semetey-2-2013:p1312:b004:l025","ordinal":286755,"en":"If you should fight by accident—"},{"id":"semetey-2-2013:p1312:b004:l026","ordinal":286756,"en":"She knows on Friday where a bird has flown,"},{"id":"semetey-2-2013:p1312:b004:l027","ordinal":286757,"en":"And on the holy night she knows its course."},{"id":"semetey-2-2013:p1312:b004:l028","ordinal":286758,"en":"She has skimmed the surface of the earth,"},{"id":"semetey-2-2013:p1312:b004:l029","ordinal":286759,"en":"Flying as she roamed"},{"id":"semetey-2-2013:p1312:b004:l030","ordinal":286760,"en":"The whole world under moon and sky."},{"id":"semetey-2-2013:p1312:b004:l031","ordinal":286761,"en":"That gracious, beautiful infidel,"},{"id":"semetey-2-2013:p1312:b004:l032","ordinal":286762,"en":"That woman Aychürök,"},{"id":"semetey-2-2013:p1312:b004:l033","ordinal":286763,"en":"Has no region she has not known intimately,"},{"id":"semetey-2-2013:p1312:b004:l034","ordinal":286764,"en":"No man she has left untested,"},{"id":"semetey-2-2013:p1312:b004:l035","ordinal":286765,"en":"No region over which she has not flown,"},{"id":"semetey-2-2013:p1312:b004:l036","ordinal":286766,"en":"No man she has failed to visit."},{"id":"semetey-2-2013:p1312:b004:l037","ordinal":286767,"en":"She has roamed the whole world,"},{"id":"semetey-2-2013:p1312:b004:l038","ordinal":286768,"en":"A serving woman who knows six spans,"},{"id":"semetey-2-2013:p1312:b004:l039","ordinal":286769,"en":"And knows all the world"},{"id":"semetey-2-2013:p1313:b003:l001","ordinal":286770,"en":"That serving woman has seen it all while roaming;"},{"id":"semetey-2-2013:p1313:b003:l002","ordinal":286771,"en":"She is the very soul of a man."},{"id":"semetey-2-2013:p1313:b003:l003","ordinal":286772,"en":"This great woman Aychürök"},{"id":"semetey-2-2013:p1313:b003:l004","ordinal":286773,"en":"Is the khan of womankind."},{"id":"semetey-2-2013:p1313:b003:l005","ordinal":286774,"en":"Gather the settled peoples"},{"id":"semetey-2-2013:p1313:b003:l006","ordinal":286775,"en":"Of Jeti-Özön, filled with Jediger;"},{"id":"semetey-2-2013:p1313:b003:l007","ordinal":286776,"en":"There is no sieve over the people’s mouths—"},{"id":"semetey-2-2013:p1313:b003:l008","ordinal":286777,"en":"Restrain your gossiping nation."},{"id":"semetey-2-2013:p1313:b003:l009","ordinal":286778,"en":"Let no rude-tongued troublemaker"},{"id":"semetey-2-2013:p1313:b003:l010","ordinal":286779,"en":"Call her a captive woman."},{"id":"semetey-2-2013:p1313:b003:l011","ordinal":286780,"en":"Let Aychürök not hear, become enraged,"},{"id":"semetey-2-2013:p1313:b003:l012","ordinal":286781,"en":"And fly in fury to the city"},{"id":"semetey-2-2013:p1313:b003:l013","ordinal":286782,"en":"Of her father Akun Khan;"},{"id":"semetey-2-2013:p1313:b003:l014","ordinal":286783,"en":"Let her not gather an army from Afghanistan,"},{"id":"semetey-2-2013:p1313:b003:l015","ordinal":286784,"en":"An immense force no easy thing to face,"},{"id":"semetey-2-2013:p1313:b003:l016","ordinal":286785,"en":"With pale hazy banners like mountains,"},{"id":"semetey-2-2013:p1313:b003:l017","ordinal":286786,"en":"With piercing cries and rallying shouts,"},{"id":"semetey-2-2013:p1313:b003:l018","ordinal":286787,"en":"With a roaring battle tumult,"},{"id":"semetey-2-2013:p1313:b003:l019","ordinal":286788,"en":"Mounted and armed upon gray stallions,"},{"id":"semetey-2-2013:p1313:b003:l020","ordinal":286789,"en":"Carrying mottled gray war standards,"},{"id":"semetey-2-2013:p1313:b003:l021","ordinal":286790,"en":"And wage war without restraint."},{"id":"semetey-2-2013:p1313:b003:l022","ordinal":286791,"en":"Let them not fight summer and winter,"},{"id":"semetey-2-2013:p1313:b003:l023","ordinal":286792,"en":"Stand packed together in battle,"},{"id":"semetey-2-2013:p1313:b003:l024","ordinal":286793,"en":"Choice horses dying among the herds,"},{"id":"semetey-2-2013:p1313:b003:l025","ordinal":286794,"en":"The people shaken and heroes killed,"},{"id":"semetey-2-2013:p1313:b003:l026","ordinal":286795,"en":"The nation subjected to suffering,"},{"id":"semetey-2-2013:p1313:b003:l027","ordinal":286796,"en":"All its champions ruined."},{"id":"semetey-2-2013:p1313:b003:l028","ordinal":286797,"en":"Let there be no further conflict;"},{"id":"semetey-2-2013:p1313:b003:l029","ordinal":286798,"en":"Take care, friend Kyyaz,"},{"id":"semetey-2-2013:p1313:b003:l030","ordinal":286799,"en":"Let there be no such quarrel."},{"id":"semetey-2-2013:p1313:b003:l031","ordinal":286800,"en":"Do not reproach her by accident;"},{"id":"semetey-2-2013:p1313:b003:l032","ordinal":286801,"en":"Hero, do not treat her as your equal in anger."},{"id":"semetey-2-2013:p1313:b003:l033","ordinal":286802,"en":"Approve whatever she says"},{"id":"semetey-2-2013:p1313:b003:l034","ordinal":286803,"en":"And keep inclining your neck to her."},{"id":"semetey-2-2013:p1313:b003:l035","ordinal":286804,"en":"Leave her in peace for six years,"},{"id":"semetey-2-2013:p1313:b003:l036","ordinal":286805,"en":"Then slowly make her your wife."},{"id":"semetey-2-2013:p1313:b003:l037","ordinal":286806,"en":"Submit to what she says,"},{"id":"semetey-2-2013:p1313:b003:l038","ordinal":286807,"en":"Give her whatever she desires,"},{"id":"semetey-2-2013:p1313:b003:l039","ordinal":286808,"en":"And cherish the dear woman Chürök"},{"id":"semetey-2-2013:p1313:b005:l001","ordinal":286809,"en":"Above all your people."},{"id":"semetey-2-2013:p1313:b005:l002","ordinal":286810,"en":"Cast a cold lasso"},{"id":"semetey-2-2013:p1313:b005:l003","ordinal":286811,"en":"On countless horses no petitioner could obtain;"},{"id":"semetey-2-2013:p1313:b005:l004","ordinal":286812,"en":"Take the beautiful woman Chürök yourself,"},{"id":"semetey-2-2013:p1313:b005:l005","ordinal":286813,"en":"And do not leave her dejected."},{"id":"semetey-2-2013:p1313:b005:l006","ordinal":286814,"en":"Win Chürök through hardship,"},{"id":"semetey-2-2013:p1313:b005:l007","ordinal":286815,"en":"And take her as your gift."},{"id":"semetey-2-2013:p1313:b005:l008","ordinal":286816,"en":"Champion, raise the hero Kanchoro"},{"id":"semetey-2-2013:p1313:b005:l009","ordinal":286817,"en":"As khan over the world!”"},{"id":"semetey-2-2013:p1313:b005:l010","ordinal":286818,"en":"All the Jediger together"},{"id":"semetey-2-2013:p1313:b005:l011","ordinal":286819,"en":"Now seated the hero Kanchoro"},{"id":"semetey-2-2013:p1313:b005:l012","ordinal":286820,"en":"Upon a white felt rug."},{"id":"semetey-2-2013:p1313:b005:l013","ordinal":286821,"en":"With a plane-tree garden around him,"},{"id":"semetey-2-2013:p1313:b005:l014","ordinal":286822,"en":"A golden throne in the tower,"},{"id":"semetey-2-2013:p1313:b005:l015","ordinal":286823,"en":"They placed a golden crown upon him,"},{"id":"semetey-2-2013:p1313:b005:l016","ordinal":286824,"en":"Raised him onto the golden throne,"},{"id":"semetey-2-2013:p1313:b005:l017","ordinal":286825,"en":"And proclaimed him khan."},{"id":"semetey-2-2013:p1313:b005:l018","ordinal":286826,"en":"To the walled fortress,"},{"id":"semetey-2-2013:p1313:b005:l019","ordinal":286827,"en":"To Chachykey’s palace,"},{"id":"semetey-2-2013:p1313:b005:l020","ordinal":286828,"en":"News came that brave Semetey had died,"},{"id":"semetey-2-2013:p1313:b005:l021","ordinal":286829,"en":"Had seen the true place"},{"id":"semetey-2-2013:p1313:b005:l022","ordinal":286830,"en":"From which none returns,"},{"id":"semetey-2-2013:p1313:b005:l023","ordinal":286831,"en":"That the dear man had passed away."},{"id":"semetey-2-2013:p1313:b005:l024","ordinal":286832,"en":"Yesterday, when he scattered great wealth,"},{"id":"semetey-2-2013:p1313:b005:l025","ordinal":286833,"en":"When brave Semetey, the mighty gray wolf,"},{"id":"semetey-2-2013:p1313:b005:l026","ordinal":286834,"en":"Set out toward Talas,"},{"id":"semetey-2-2013:p1313:b005:l027","ordinal":286835,"en":"He had gathered eight khojas."},{"id":"semetey-2-2013:p1313:b005:l028","ordinal":286836,"en":"The aged khan, ruler of Bukhara,"},{"id":"semetey-2-2013:p1313:b005:l029","ordinal":286837,"en":"Had given her to him while she was a maiden;"},{"id":"semetey-2-2013:p1313:b005:l030","ordinal":286838,"en":"She was his maternal aunt."},{"id":"semetey-2-2013:p1313:b005:l031","ordinal":286839,"en":"This spoiled woman Chachykey"},{"id":"semetey-2-2013:p1313:b005:l032","ordinal":286840,"en":"Was Semetey’s wife."},{"id":"semetey-2-2013:p1313:b005:l033","ordinal":286841,"en":"She summoned the messenger"},{"id":"semetey-2-2013:p1313:b005:l034","ordinal":286842,"en":"Who had brought the news and said:"},{"id":"semetey-2-2013:p1313:b005:l035","ordinal":286843,"en":"“If what you say is true,"},{"id":"semetey-2-2013:p1313:b005:l036","ordinal":286844,"en":"If it is sound and not a lie,"},{"id":"semetey-2-2013:p1313:b005:l037","ordinal":286845,"en":"I will consent to what you ask;"},{"id":"semetey-2-2013:p1313:b005:l038","ordinal":286846,"en":"I will give you sixty camels"},{"id":"semetey-2-2013:p1313:b005:l039","ordinal":286847,"en":"As your reward for glad tidings.”"},{"id":"semetey-2-2013:p1314:b003:l001","ordinal":286848,"en":"Calling quickly upon Baabedin,"},{"id":"semetey-2-2013:p1314:b003:l002","ordinal":286849,"en":"The woman glowed with delight:"},{"id":"semetey-2-2013:p1314:b003:l003","ordinal":286850,"en":"“My khan Kanchoro will take me!”"},{"id":"semetey-2-2013:p1314:b003:l004","ordinal":286851,"en":"All her sorrow disappeared,"},{"id":"semetey-2-2013:p1314:b003:l005","ordinal":286852,"en":"All her grief was mended;"},{"id":"semetey-2-2013:p1314:b003:l006","ordinal":286853,"en":"The woman brightened and recovered,"},{"id":"semetey-2-2013:p1314:b003:l007","ordinal":286854,"en":"All her resentment dissolved,"},{"id":"semetey-2-2013:p1314:b003:l008","ordinal":286855,"en":"Her burning heart grew calm."},{"id":"semetey-2-2013:p1314:b003:l009","ordinal":286856,"en":"“Yesterday, while the bloodthirsty lord still lived,"},{"id":"semetey-2-2013:p1314:b003:l010","ordinal":286857,"en":"I knew much anguish;"},{"id":"semetey-2-2013:p1314:b003:l011","ordinal":286858,"en":"Kanchoro and I"},{"id":"semetey-2-2013:p1314:b003:l012","ordinal":286859,"en":"Would whisper together."},{"id":"semetey-2-2013:p1314:b003:l013","ordinal":286860,"en":"We had pledged"},{"id":"semetey-2-2013:p1314:b003:l014","ordinal":286861,"en":"To camp freely on the ridge"},{"id":"semetey-2-2013:p1314:b003:l015","ordinal":286862,"en":"And become husband and wife.”"},{"id":"semetey-2-2013:p1314:b003:l016","ordinal":286863,"en":"The spoiled woman Chachykey—"},{"id":"semetey-2-2013:p1314:b003:l017","ordinal":286864,"en":"So much was the shameless one esteemed;"},{"id":"semetey-2-2013:p1314:b003:l018","ordinal":286865,"en":"The scoundrel had attained"},{"id":"semetey-2-2013:p1314:b003:l019","ordinal":286866,"en":"Her promise and desire."},{"id":"semetey-2-2013:p1314:b003:l020","ordinal":286867,"en":"“Take gold for your glad tidings,"},{"id":"semetey-2-2013:p1314:b003:l021","ordinal":286868,"en":"Gold scattered in fist-sized pieces.”"},{"id":"semetey-2-2013:p1314:b003:l022","ordinal":286869,"en":"She rejoiced when her lord died—"},{"id":"semetey-2-2013:p1314:b003:l023","ordinal":286870,"en":"Such was Chachykey’s nature."},{"id":"semetey-2-2013:p1314:b003:l024","ordinal":286871,"en":"Her wickedness stood revealed;"},{"id":"semetey-2-2013:p1314:b003:l025","ordinal":286872,"en":"The woman rejoiced"},{"id":"semetey-2-2013:p1314:b003:l026","ordinal":286873,"en":"That she would marry Kanchoro."},{"id":"semetey-2-2013:p1314:b003:l027","ordinal":286874,"en":"That woman Chachykey,"},{"id":"semetey-2-2013:p1314:b003:l028","ordinal":286875,"en":"That swaggering infidel,"},{"id":"semetey-2-2013:p1314:b003:l029","ordinal":286876,"en":"Slaughtered ninety colts for her feast"},{"id":"semetey-2-2013:p1314:b003:l030","ordinal":286877,"en":"And set her wealth against the cost."},{"id":"semetey-2-2013:p1314:b003:l031","ordinal":286878,"en":"She let the Jediger overrun"},{"id":"semetey-2-2013:p1314:b003:l032","ordinal":286879,"en":"Semetey’s great stronghold;"},{"id":"semetey-2-2013:p1314:b003:l033","ordinal":286880,"en":"She had bright gold and white silver"},{"id":"semetey-2-2013:p1314:b003:l034","ordinal":286881,"en":"Scattered in lavish handfuls,"},{"id":"semetey-2-2013:p1314:b003:l035","ordinal":286882,"en":"And gathered khojas and mullahs."},{"id":"semetey-2-2013:p1314:b003:l036","ordinal":286883,"en":"That woman Chachykey"},{"id":"semetey-2-2013:p1314:b003:l037","ordinal":286884,"en":"Had Kanchoro cut up the meat;"},{"id":"semetey-2-2013:p1314:b003:l038","ordinal":286885,"en":"She made the splendid entertainment"},{"id":"semetey-2-2013:p1314:b003:l039","ordinal":286886,"en":"Surpass that of all the people."},{"id":"semetey-2-2013:p1314:b004:l001","ordinal":286887,"en":"As for saintly old Bakay,"},{"id":"semetey-2-2013:p1314:b004:l002","ordinal":286888,"en":"She had eighty fearsome wrestlers"},{"id":"semetey-2-2013:p1314:b004:l003","ordinal":286889,"en":"Drag him about as their kökbörü carcass,"},{"id":"semetey-2-2013:p1314:b004:l004","ordinal":286890,"en":"Neither killing nor losing him."},{"id":"semetey-2-2013:p1314:b004:l005","ordinal":286891,"en":"Though not eighty but a thousand"},{"id":"semetey-2-2013:p1314:b004:l006","ordinal":286892,"en":"Used brave Bakay for kökbörü,"},{"id":"semetey-2-2013:p1314:b004:l007","ordinal":286893,"en":"Your khanly uncle would not yield."},{"id":"semetey-2-2013:p1314:b004:l008","ordinal":286894,"en":"From ancient times until now,"},{"id":"semetey-2-2013:p1314:b004:l009","ordinal":286895,"en":"That uncle had endured torment."},{"id":"semetey-2-2013:p1314:b004:l010","ordinal":286896,"en":"All his coat was torn,"},{"id":"semetey-2-2013:p1314:b004:l011","ordinal":286897,"en":"All his beard was plucked,"},{"id":"semetey-2-2013:p1314:b004:l012","ordinal":286898,"en":"All his armor was stripped,"},{"id":"semetey-2-2013:p1314:b004:l013","ordinal":286899,"en":"And every whisker of your aged uncle Bakay"},{"id":"semetey-2-2013:p1314:b004:l014","ordinal":286900,"en":"Was torn from his face."},{"id":"semetey-2-2013:p1314:b004:l015","ordinal":286901,"en":"As the wrestlers mauled him,"},{"id":"semetey-2-2013:p1314:b004:l016","ordinal":286902,"en":"Behold your ancestor like Bakay,"},{"id":"semetey-2-2013:p1314:b004:l017","ordinal":286903,"en":"Your prophet-like uncle,"},{"id":"semetey-2-2013:p1314:b004:l018","ordinal":286904,"en":"Parted from those who loved him;"},{"id":"semetey-2-2013:p1314:b004:l019","ordinal":286905,"en":"Behold how he was humiliated."},{"id":"semetey-2-2013:p1314:b004:l020","ordinal":286906,"en":"His swan-white beard turned pale;"},{"id":"semetey-2-2013:p1314:b004:l021","ordinal":286907,"en":"Your ancestor stood withered."},{"id":"semetey-2-2013:p1314:b004:l022","ordinal":286908,"en":"Bereft of those who loved him,"},{"id":"semetey-2-2013:p1314:b004:l023","ordinal":286909,"en":"Behold what that grave-robbing wretch"},{"id":"semetey-2-2013:p1314:b004:l024","ordinal":286910,"en":"Did to your father."},{"id":"semetey-2-2013:p1314:b004:l025","ordinal":286911,"en":"Tears from both eyes spread in ten streams;"},{"id":"semetey-2-2013:p1314:b004:l026","ordinal":286912,"en":"Unable to die though wishing for death,"},{"id":"semetey-2-2013:p1314:b004:l027","ordinal":286913,"en":"Your ancestor went about weeping."},{"id":"semetey-2-2013:p1314:b004:l028","ordinal":286914,"en":"Deprived of those who would sustain him,"},{"id":"semetey-2-2013:p1314:b004:l029","ordinal":286915,"en":"Your poor uncle Bakay—"},{"id":"semetey-2-2013:p1314:b004:l030","ordinal":286916,"en":"Behold how he wailed."},{"id":"semetey-2-2013:p1314:b004:l031","ordinal":286917,"en":"His face wrinkled and wasted;"},{"id":"semetey-2-2013:p1314:b004:l032","ordinal":286918,"en":"Tears flowing from both eyes"},{"id":"semetey-2-2013:p1314:b004:l033","ordinal":286919,"en":"Poured across his breast."},{"id":"semetey-2-2013:p1314:b004:l034","ordinal":286920,"en":"The broad world became narrow;"},{"id":"semetey-2-2013:p1314:b004:l035","ordinal":286921,"en":"Majestic Bakay became old and gray."},{"id":"semetey-2-2013:p1314:b004:l036","ordinal":286922,"en":"What is seen today is gone tomorrow—"},{"id":"semetey-2-2013:p1314:b004:l037","ordinal":286923,"en":"Such filth this world proves to be!"},{"id":"semetey-2-2013:p1314:b004:l038","ordinal":286924,"en":"His insides burned, his heart was gone;"},{"id":"semetey-2-2013:p1314:b004:l039","ordinal":286925,"en":"He had no strength to exchange blows."},{"id":"semetey-2-2013:p1315:b003:l001","ordinal":286926,"en":"He stooped, and strength left his back;"},{"id":"semetey-2-2013:p1315:b003:l002","ordinal":286927,"en":"From your uncle Bakay’s hands"},{"id":"semetey-2-2013:p1315:b003:l003","ordinal":286928,"en":"All courage fled, all power departed."},{"id":"semetey-2-2013:p1315:b003:l004","ordinal":286929,"en":"Certain that he would die,"},{"id":"semetey-2-2013:p1315:b003:l005","ordinal":286930,"en":"The wretched old man mounted in this state."},{"id":"semetey-2-2013:p1315:b003:l006","ordinal":286931,"en":"Sweet words had left his mouth;"},{"id":"semetey-2-2013:p1315:b003:l007","ordinal":286932,"en":"The wide, staring eyes"},{"id":"semetey-2-2013:p1315:b003:l008","ordinal":286933,"en":"Had left your ruined uncle."},{"id":"semetey-2-2013:p1315:b003:l009","ordinal":286934,"en":"All vigor fled from Bakay;"},{"id":"semetey-2-2013:p1315:b003:l010","ordinal":286935,"en":"This was when he sank deep into misery."},{"id":"semetey-2-2013:p1315:b003:l011","ordinal":286936,"en":"He had no life beyond lying still;"},{"id":"semetey-2-2013:p1315:b003:l012","ordinal":286937,"en":"This was when Bakay lay upon his side,"},{"id":"semetey-2-2013:p1315:b003:l013","ordinal":286938,"en":"His only loved one gone,"},{"id":"semetey-2-2013:p1315:b003:l014","ordinal":286939,"en":"While Kanchoro dragged him as a kökbörü carcass."},{"id":"semetey-2-2013:p1315:b003:l015","ordinal":286940,"en":"Brave Bakay went rolling"},{"id":"semetey-2-2013:p1315:b003:l016","ordinal":286941,"en":"Along the path of the stallions;"},{"id":"semetey-2-2013:p1315:b003:l017","ordinal":286942,"en":"Brave Bakay passed through the hands"},{"id":"semetey-2-2013:p1315:b003:l018","ordinal":286943,"en":"Of seventy Jediger wrestlers."},{"id":"semetey-2-2013:p1315:b003:l019","ordinal":286944,"en":"The broad world became narrow;"},{"id":"semetey-2-2013:p1315:b003:l020","ordinal":286945,"en":"Great Bakay could no longer join counsel."},{"id":"semetey-2-2013:p1315:b003:l021","ordinal":286946,"en":"Parted from his children,"},{"id":"semetey-2-2013:p1315:b003:l022","ordinal":286947,"en":"He was subjected to peculiar disgrace."},{"id":"semetey-2-2013:p1315:b003:l023","ordinal":286948,"en":"That costly cap of blue lynx—"},{"id":"semetey-2-2013:p1315:b003:l024","ordinal":286949,"en":"Who had not worn it jauntily?"},{"id":"semetey-2-2013:p1315:b003:l025","ordinal":286950,"en":"When people saw the lion Bakay,"},{"id":"semetey-2-2013:p1315:b003:l026","ordinal":286951,"en":"All beneath moon and sky would tremble."},{"id":"semetey-2-2013:p1315:b003:l027","ordinal":286952,"en":"Now an iron cage surrounded him,"},{"id":"semetey-2-2013:p1315:b003:l028","ordinal":286953,"en":"And thick misery lay upon Bakay Khan."},{"id":"semetey-2-2013:p1315:b003:l029","ordinal":286954,"en":"Bakay the lion, victor in many races,"},{"id":"semetey-2-2013:p1315:b003:l030","ordinal":286955,"en":"Became their kökbörü carcass that day."},{"id":"semetey-2-2013:p1315:b003:l031","ordinal":286956,"en":"“While my fortune was intact,"},{"id":"semetey-2-2013:p1315:b003:l032","ordinal":286957,"en":"I was a man of lofty purpose."},{"id":"semetey-2-2013:p1315:b003:l033","ordinal":286958,"en":"Akbaltay, forefather of this servant,"},{"id":"semetey-2-2013:p1315:b003:l034","ordinal":286959,"en":"How long were you there?"},{"id":"semetey-2-2013:p1315:b003:l035","ordinal":286960,"en":"Alas, may my only one survive,"},{"id":"semetey-2-2013:p1315:b003:l036","ordinal":286961,"en":"May that soul never witness such humiliation!"},{"id":"semetey-2-2013:p1315:b003:l037","ordinal":286962,"en":"In the prime of strength and longing,"},{"id":"semetey-2-2013:p1315:b003:l038","ordinal":286963,"en":"While my only one remained alive,"},{"id":"semetey-2-2013:p1315:b003:l039","ordinal":286964,"en":"Tall, broad-shouldered,"},{"id":"semetey-2-2013:p1315:b005:l001","ordinal":286965,"en":"Both wrestler and lion,"},{"id":"semetey-2-2013:p1315:b005:l002","ordinal":286966,"en":"He was a glowing red ember,"},{"id":"semetey-2-2013:p1315:b005:l003","ordinal":286967,"en":"Peerless in my world;"},{"id":"semetey-2-2013:p1315:b005:l004","ordinal":286968,"en":"My Morning Star companion of the moon,"},{"id":"semetey-2-2013:p1315:b005:l005","ordinal":286969,"en":"My honored sultan,"},{"id":"semetey-2-2013:p1315:b005:l006","ordinal":286970,"en":"The light for my grieving soul,"},{"id":"semetey-2-2013:p1315:b005:l007","ordinal":286971,"en":"My keepsake left"},{"id":"semetey-2-2013:p1315:b005:l008","ordinal":286972,"en":"By Albambet who passed to the other world."},{"id":"semetey-2-2013:p1315:b005:l009","ordinal":286973,"en":"He girded his belt with skill;"},{"id":"semetey-2-2013:p1315:b005:l010","ordinal":286974,"en":"If seven divisions of black foes appeared,"},{"id":"semetey-2-2013:p1315:b005:l011","ordinal":286975,"en":"He entered alone and attacked."},{"id":"semetey-2-2013:p1315:b005:l012","ordinal":286976,"en":"The choicest of the falcons,"}]
