[{"id":"semetey-1-2013:p1266:b003:l032","ordinal":172801,"en":"To enter the original city directly"},{"id":"semetey-1-2013:p1266:b003:l033","ordinal":172802,"en":"And raid it completely."},{"id":"semetey-1-2013:p1266:b003:l034","ordinal":172803,"en":"From a jutting promontory,"},{"id":"semetey-1-2013:p1266:b003:l035","ordinal":172804,"en":"From a pine-covered spur,"},{"id":"semetey-1-2013:p1266:b003:l036","ordinal":172805,"en":"Valiant Manas and Khan Bakai"},{"id":"semetey-1-2013:p1266:b003:l037","ordinal":172806,"en":"Came up onto the pass."},{"id":"semetey-1-2013:p1266:b003:l038","ordinal":172807,"en":"Dragging their wagon,"},{"id":"semetey-1-2013:p1266:b003:l039","ordinal":172808,"en":"Sixty Russian surveyors—"},{"id":"semetey-1-2013:p1266:b004:l001","ordinal":172809,"en":"They saw and captured them on the plain."},{"id":"semetey-1-2013:p1266:b004:l002","ordinal":172810,"en":"Turning red haze into night,"},{"id":"semetey-1-2013:p1266:b004:l003","ordinal":172811,"en":"Bakai brought the sun to a halt."},{"id":"semetey-1-2013:p1266:b004:l004","ordinal":172812,"en":"Keen Bakai and Khan Manas"},{"id":"semetey-1-2013:p1266:b004:l005","ordinal":172813,"en":"Did what had to be done."},{"id":"semetey-1-2013:p1266:b004:l006","ordinal":172814,"en":"They captured the surveyors;"},{"id":"semetey-1-2013:p1266:b004:l007","ordinal":172815,"en":"With the piebald stallion at their head,"},{"id":"semetey-1-2013:p1266:b004:l008","ordinal":172816,"en":"They seized Akkelte."},{"id":"semetey-1-2013:p1266:b004:l009","ordinal":172817,"en":"When they had seized Akkelte,"},{"id":"semetey-1-2013:p1266:b004:l010","ordinal":172818,"en":"Kydyr blessed"},{"id":"semetey-1-2013:p1266:b004:l011","ordinal":172819,"en":"Keen gray-wolf Manas."},{"id":"semetey-1-2013:p1266:b004:l012","ordinal":172820,"en":"The twelve joined hands as one;"},{"id":"semetey-1-2013:p1266:b004:l013","ordinal":172821,"en":"Your keen gray-wolf Manas"},{"id":"semetey-1-2013:p1266:b004:l014","ordinal":172822,"en":"Became renowned as mighty Manas."},{"id":"semetey-1-2013:p1266:b004:l015","ordinal":172823,"en":"Akkelte, taken as spoil"},{"id":"semetey-1-2013:p1266:b004:l016","ordinal":172824,"en":"From the Russians’ palace city,"},{"id":"semetey-1-2013:p1266:b004:l017","ordinal":172825,"en":"Did not deviate when fired afar;"},{"id":"semetey-1-2013:p1266:b004:l018","ordinal":172826,"en":"Akkelte became renowned,"},{"id":"semetey-1-2013:p1266:b004:l019","ordinal":172827,"en":"The sharp weapon that struck at distance,"},{"id":"semetey-1-2013:p1266:b004:l020","ordinal":172828,"en":"The treasure inherited"},{"id":"semetey-1-2013:p1266:b004:l021","ordinal":172829,"en":"From his father, gray-wolf Manas."},{"id":"semetey-1-2013:p1266:b004:l022","ordinal":172830,"en":"Its keenness was proven among the people,"},{"id":"semetey-1-2013:p1266:b004:l023","ordinal":172831,"en":"An inheritance remaining in his hand"},{"id":"semetey-1-2013:p1266:b004:l024","ordinal":172832,"en":"From Manas of matchless fortune."},{"id":"semetey-1-2013:p1266:b004:l025","ordinal":172833,"en":"When enemies approached, he slung it on;"},{"id":"semetey-1-2013:p1266:b004:l026","ordinal":172834,"en":"The gray wolf cast it across his back."},{"id":"semetey-1-2013:p1266:b004:l027","ordinal":172835,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1266:b004:l028","ordinal":172836,"en":"And Semetey with a mighty host"},{"id":"semetey-1-2013:p1266:b004:l029","ordinal":172837,"en":"Were to meet in battle."},{"id":"semetey-1-2013:p1266:b004:l030","ordinal":172838,"en":"With Akkelte slung on,"},{"id":"semetey-1-2013:p1266:b004:l031","ordinal":172839,"en":"The sight stirred the heart;"},{"id":"semetey-1-2013:p1266:b004:l032","ordinal":172840,"en":"In your champion’s hand,"},{"id":"semetey-1-2013:p1266:b004:l033","ordinal":172841,"en":"The beauty of Syrnaiza appeared."},{"id":"semetey-1-2013:p1266:b004:l034","ordinal":172842,"en":"Seeing Syrnaiza,"},{"id":"semetey-1-2013:p1266:b004:l035","ordinal":172843,"en":"The Afghans’ hearts were stirred, saying,"},{"id":"semetey-1-2013:p1266:b004:l036","ordinal":172844,"en":"“Your champion will spare no foe.”"},{"id":"semetey-1-2013:p1266:b004:l037","ordinal":172845,"en":"The Syrnaiza in his hand"},{"id":"semetey-1-2013:p1266:b004:l038","ordinal":172846,"en":"Was made from birch of Orolmo-Too,"},{"id":"semetey-1-2013:p1266:b004:l039","ordinal":172847,"en":"Cut straight from the tree,"},{"id":"semetey-1-2013:p1267:b003:l001","ordinal":172848,"en":"Hardened together with its bark,"},{"id":"semetey-1-2013:p1267:b003:l002","ordinal":172849,"en":"Deliberately hammered and twisted,"},{"id":"semetey-1-2013:p1267:b003:l003","ordinal":172850,"en":"Its crooked parts shaped by filing,"},{"id":"semetey-1-2013:p1267:b003:l004","ordinal":172851,"en":"Its bent places straightened,"},{"id":"semetey-1-2013:p1267:b003:l005","ordinal":172852,"en":"The master smith Bolokbay"},{"id":"semetey-1-2013:p1267:b003:l006","ordinal":172853,"en":"Had repaired the poor thing."},{"id":"semetey-1-2013:p1267:b003:l007","ordinal":172854,"en":"He had it bound with sinew;"},{"id":"semetey-1-2013:p1267:b003:l008","ordinal":172855,"en":"Leaving no hollow place,"},{"id":"semetey-1-2013:p1267:b003:l009","ordinal":172856,"en":"He wrapped it with gold."},{"id":"semetey-1-2013:p1267:b003:l010","ordinal":172857,"en":"So it would not slip from the hand,"},{"id":"semetey-1-2013:p1267:b003:l011","ordinal":172858,"en":"He lacquered its grip"},{"id":"semetey-1-2013:p1267:b003:l012","ordinal":172859,"en":"And covered it with elephant hide."},{"id":"semetey-1-2013:p1267:b003:l013","ordinal":172860,"en":"When leveled and thrust at the enemy,"},{"id":"semetey-1-2013:p1267:b003:l014","ordinal":172861,"en":"It glowed red as an ember;"},{"id":"semetey-1-2013:p1267:b003:l015","ordinal":172862,"en":"When leveled and brandished at the foe,"},{"id":"semetey-1-2013:p1267:b003:l016","ordinal":172863,"en":"A man's soul rejoiced."},{"id":"semetey-1-2013:p1267:b003:l017","ordinal":172864,"en":"When the patterned spear struck,"},{"id":"semetey-1-2013:p1267:b003:l018","ordinal":172865,"en":"It bent without breaking."},{"id":"semetey-1-2013:p1267:b003:l019","ordinal":172866,"en":"So precious was it:"},{"id":"semetey-1-2013:p1267:b003:l020","ordinal":172867,"en":"Its exterior was covered in hide;"},{"id":"semetey-1-2013:p1267:b003:l021","ordinal":172868,"en":"So a spear stroke would not cut it,"},{"id":"semetey-1-2013:p1267:b003:l022","ordinal":172869,"en":"He wrapped it with gold."},{"id":"semetey-1-2013:p1267:b003:l023","ordinal":172870,"en":"Its tip was wolf-tongue steel;"},{"id":"semetey-1-2013:p1267:b003:l024","ordinal":172871,"en":"It felled whomever it was leveled at."},{"id":"semetey-1-2013:p1267:b003:l025","ordinal":172872,"en":"\"Let the place it strikes not remain whole;"},{"id":"semetey-1-2013:p1267:b003:l026","ordinal":172873,"en":"Let him burn and die;"},{"id":"semetey-1-2013:p1267:b003:l027","ordinal":172874,"en":"Let an untimely death reach him,\""},{"id":"semetey-1-2013:p1267:b003:l028","ordinal":172875,"en":"They tempered it with albar steel."},{"id":"semetey-1-2013:p1267:b003:l029","ordinal":172876,"en":"It was of hollow-forged steel,"},{"id":"semetey-1-2013:p1267:b003:l030","ordinal":172877,"en":"Raised high in massive form,"},{"id":"semetey-1-2013:p1267:b003:l031","ordinal":172878,"en":"And crushed a charging enemy"},{"id":"semetey-1-2013:p1267:b003:l032","ordinal":172879,"en":"To the earth like a hare."},{"id":"semetey-1-2013:p1267:b003:l033","ordinal":172880,"en":"Taking the patterned spear and arming himself,"},{"id":"semetey-1-2013:p1267:b003:l034","ordinal":172881,"en":"Your foreign-born lord made ready."},{"id":"semetey-1-2013:p1267:b003:l035","ordinal":172882,"en":"Upon his head he wore"},{"id":"semetey-1-2013:p1267:b003:l036","ordinal":172883,"en":"A black cap of blue lynx."},{"id":"semetey-1-2013:p1267:b003:l037","ordinal":172884,"en":"Do not ask the valiant man's nature:"},{"id":"semetey-1-2013:p1267:b003:l038","ordinal":172885,"en":"The direction he faced became red fire."},{"id":"semetey-1-2013:p1267:b003:l039","ordinal":172886,"en":"Semetey was an ocean;"},{"id":"semetey-1-2013:p1267:b005:l001","ordinal":172887,"en":"His fortunes were complete."},{"id":"semetey-1-2013:p1267:b005:l002","ordinal":172888,"en":"He was the hero born greater"},{"id":"semetey-1-2013:p1267:b005:l003","ordinal":172889,"en":"Than his generous father Manas."},{"id":"semetey-1-2013:p1267:b005:l004","ordinal":172890,"en":"This was when he would battle"},{"id":"semetey-1-2013:p1267:b005:l005","ordinal":172891,"en":"The Jediger who had engulfed them."},{"id":"semetey-1-2013:p1267:b005:l006","ordinal":172892,"en":"The Akkolpok upon him—"},{"id":"semetey-1-2013:p1267:b005:l007","ordinal":172893,"en":"When slaves seized its silk,"},{"id":"semetey-1-2013:p1267:b005:l008","ordinal":172894,"en":"When the horde was destroyed then,"},{"id":"semetey-1-2013:p1267:b005:l009","ordinal":172895,"en":"And it fell into the hands"},{"id":"semetey-1-2013:p1267:b005:l010","ordinal":172896,"en":"Of a man clad in gray thread,"},{"id":"semetey-1-2013:p1267:b005:l011","ordinal":172897,"en":"These dogs had grown in silk"},{"id":"semetey-1-2013:p1267:b005:l012","ordinal":172898,"en":"And put the silk on themselves."},{"id":"semetey-1-2013:p1267:b005:l013","ordinal":172899,"en":"Semetey destroyed their horde"},{"id":"semetey-1-2013:p1267:b005:l014","ordinal":172900,"en":"And took back Akkolpok"},{"id":"semetey-1-2013:p1267:b005:l015","ordinal":172901,"en":"From the scoundrels' hands."},{"id":"semetey-1-2013:p1267:b005:l016","ordinal":172902,"en":"She twisted its filled places;"},{"id":"semetey-1-2013:p1267:b005:l017","ordinal":172903,"en":"Your dear mother Kanykei"},{"id":"semetey-1-2013:p1267:b005:l018","ordinal":172904,"en":"And skillfully repaired it all."},{"id":"semetey-1-2013:p1267:b005:l019","ordinal":172905,"en":"She had obtained the silk before,"},{"id":"semetey-1-2013:p1267:b005:l020","ordinal":172906,"en":"Silk mixed with fine fiber,"},{"id":"semetey-1-2013:p1267:b005:l021","ordinal":172907,"en":"And had its weave made of gold;"},{"id":"semetey-1-2013:p1267:b005:l022","ordinal":172908,"en":"She patched what was torn"},{"id":"semetey-1-2013:p1267:b005:l023","ordinal":172909,"en":"And your dear mother repaired"},{"id":"semetey-1-2013:p1267:b005:l024","ordinal":172910,"en":"Everything that was damaged."},{"id":"semetey-1-2013:p1267:b005:l025","ordinal":172911,"en":"She had the unsuitable parts removed"},{"id":"semetey-1-2013:p1267:b005:l026","ordinal":172912,"en":"And plates of steel"},{"id":"semetey-1-2013:p1267:b005:l027","ordinal":172913,"en":"Poured into its center."},{"id":"semetey-1-2013:p1267:b005:l028","ordinal":172914,"en":"The jaws of tongs could not grip it;"},{"id":"semetey-1-2013:p1267:b005:l029","ordinal":172915,"en":"The edge of Arkesken could not cut it."},{"id":"semetey-1-2013:p1267:b005:l030","ordinal":172916,"en":"No ember passed it when red willow burned;"},{"id":"semetey-1-2013:p1267:b005:l031","ordinal":172917,"en":"No spear pierced it in a joust,"},{"id":"semetey-1-2013:p1267:b005:l032","ordinal":172918,"en":"And no short blade cut its weave."},{"id":"semetey-1-2013:p1267:b005:l033","ordinal":172919,"en":"Its inside was silk and atlas,"},{"id":"semetey-1-2013:p1267:b005:l034","ordinal":172920,"en":"Its collar gold and sleeves brass."},{"id":"semetey-1-2013:p1267:b005:l035","ordinal":172921,"en":"Wearing Akkolpok, he appeared—"},{"id":"semetey-1-2013:p1267:b005:l036","ordinal":172922,"en":"The heroic lord, son of Manas;"},{"id":"semetey-1-2013:p1267:b005:l037","ordinal":172923,"en":"The time for slaughter had come!"},{"id":"semetey-1-2013:p1267:b005:l038","ordinal":172924,"en":"Golden-cheeked battle-axe,"},{"id":"semetey-1-2013:p1267:b005:l039","ordinal":172925,"en":"Of many splendid ornaments,"},{"id":"semetey-1-2013:p1268:b003:l001","ordinal":172926,"en":"Its haft was gold, its edge sharp."},{"id":"semetey-1-2013:p1268:b003:l002","ordinal":172927,"en":"When Turks came from Bukhara,"},{"id":"semetey-1-2013:p1268:b003:l003","ordinal":172928,"en":"Surpassing all after taking food,"},{"id":"semetey-1-2013:p1268:b003:l004","ordinal":172929,"en":"He was a friend of David—"},{"id":"semetey-1-2013:p1268:b003:l005","ordinal":172930,"en":"The master smith Bölökbai,"},{"id":"semetey-1-2013:p1268:b003:l006","ordinal":172931,"en":"Had made the poor thing."},{"id":"semetey-1-2013:p1268:b003:l007","ordinal":172932,"en":"Stars shifted in the sky;"},{"id":"semetey-1-2013:p1268:b003:l008","ordinal":172933,"en":"David and Bolokbay"},{"id":"semetey-1-2013:p1268:b003:l009","ordinal":172934,"en":"Became true friends."},{"id":"semetey-1-2013:p1268:b003:l010","ordinal":172935,"en":"Their charcoal swelled and melted;"},{"id":"semetey-1-2013:p1268:b003:l011","ordinal":172936,"en":"The two joined together."},{"id":"semetey-1-2013:p1268:b003:l012","ordinal":172937,"en":"Unable to withstand their charcoal,"},{"id":"semetey-1-2013:p1268:b003:l013","ordinal":172938,"en":"The forested mountainside was hollowed;"},{"id":"semetey-1-2013:p1268:b003:l014","ordinal":172939,"en":"Unable to withstand their bellows,"},{"id":"semetey-1-2013:p1268:b003:l015","ordinal":172940,"en":"A levy fell upon the Kyrgyz"},{"id":"semetey-1-2013:p1268:b003:l016","ordinal":172941,"en":"And many young bulls were slaughtered."},{"id":"semetey-1-2013:p1268:b003:l017","ordinal":172942,"en":"They joined and formed its point;"},{"id":"semetey-1-2013:p1268:b003:l018","ordinal":172943,"en":"\"Let whoever it touches die in pain,\""},{"id":"semetey-1-2013:p1268:b003:l019","ordinal":172944,"en":"They tempered it six times"},{"id":"semetey-1-2013:p1268:b003:l020","ordinal":172945,"en":"In a dragon's venom."},{"id":"semetey-1-2013:p1268:b003:l021","ordinal":172946,"en":"Its edge was red, its mouth fire;"},{"id":"semetey-1-2013:p1268:b003:l022","ordinal":172947,"en":"Whomever it struck died at once."},{"id":"semetey-1-2013:p1268:b003:l023","ordinal":172948,"en":"Whoever faced it found bitterness;"},{"id":"semetey-1-2013:p1268:b003:l024","ordinal":172949,"en":"One whose death had come met it."},{"id":"semetey-1-2013:p1268:b003:l025","ordinal":172950,"en":"Golden-cheeked battle-axe,"},{"id":"semetey-1-2013:p1268:b003:l026","ordinal":172951,"en":"Gold-adorned side pouch,"},{"id":"semetey-1-2013:p1268:b003:l027","ordinal":172952,"en":"Its excellence visible to the people—"},{"id":"semetey-1-2013:p1268:b003:l028","ordinal":172953,"en":"No one dared face it."},{"id":"semetey-1-2013:p1268:b003:l029","ordinal":172954,"en":"Your valiant-born sultan,"},{"id":"semetey-1-2013:p1268:b003:l030","ordinal":172955,"en":"Terrible in bearing and strong in venom,"},{"id":"semetey-1-2013:p1268:b003:l031","ordinal":172956,"en":"The true son of your generous lord,"},{"id":"semetey-1-2013:p1268:b003:l032","ordinal":172957,"en":"Was deeply troubled."},{"id":"semetey-1-2013:p1268:b003:l033","ordinal":172958,"en":"When one looked before him,"},{"id":"semetey-1-2013:p1268:b003:l034","ordinal":172959,"en":"The generous lord's young son"},{"id":"semetey-1-2013:p1268:b003:l035","ordinal":172960,"en":"Had the might of six thousand men;"},{"id":"semetey-1-2013:p1268:b003:l036","ordinal":172961,"en":"When one looked behind him,"},{"id":"semetey-1-2013:p1268:b003:l037","ordinal":172962,"en":"He bore the form of a dragon."},{"id":"semetey-1-2013:p1268:b003:l038","ordinal":172963,"en":"Towering high along the shortcut,"},{"id":"semetey-1-2013:p1268:b003:l039","ordinal":172964,"en":"The mountain-like Buurul—"},{"id":"semetey-1-2013:p1268:b004:l001","ordinal":172965,"en":"Dear Kanchoro led him."},{"id":"semetey-1-2013:p1268:b004:l002","ordinal":172966,"en":"Upon that Roan's head"},{"id":"semetey-1-2013:p1268:b004:l003","ordinal":172967,"en":"Was a white halter knotted in loops,"},{"id":"semetey-1-2013:p1268:b004:l004","ordinal":172968,"en":"A fitted halter worthy"},{"id":"semetey-1-2013:p1268:b004:l005","ordinal":172969,"en":"Of the mountain-like stallion."},{"id":"semetey-1-2013:p1268:b004:l006","ordinal":172970,"en":"Without haste or confusion, the heroes"},{"id":"semetey-1-2013:p1268:b004:l007","ordinal":172971,"en":"Now saddled and prepared"},{"id":"semetey-1-2013:p1268:b004:l008","ordinal":172972,"en":"The mountain-like Roan."},{"id":"semetey-1-2013:p1268:b004:l009","ordinal":172973,"en":"Semetey's Akkangky,"},{"id":"semetey-1-2013:p1268:b004:l010","ordinal":172974,"en":"A Kangky fitted to the dapple stallion,"},{"id":"semetey-1-2013:p1268:b004:l011","ordinal":172975,"en":"Its pommel pure gold,"},{"id":"semetey-1-2013:p1268:b004:l012","ordinal":172976,"en":"Its cantle solid silver,"},{"id":"semetey-1-2013:p1268:b004:l013","ordinal":172977,"en":"Both bows broad iron—"},{"id":"semetey-1-2013:p1268:b004:l014","ordinal":172978,"en":"Akkangky for riding downhill."},{"id":"semetey-1-2013:p1268:b004:l015","ordinal":172979,"en":"To go to the Jediger,"},{"id":"semetey-1-2013:p1268:b004:l016","ordinal":172980,"en":"To arrive and begin slaughter,"},{"id":"semetey-1-2013:p1268:b004:l017","ordinal":172981,"en":"Displaying his gray-maned courage,"},{"id":"semetey-1-2013:p1268:b004:l018","ordinal":172982,"en":"From before the golden throne,"},{"id":"semetey-1-2013:p1268:b004:l019","ordinal":172983,"en":"The mountain-like Buurul"},{"id":"semetey-1-2013:p1268:b004:l020","ordinal":172984,"en":"They brought and mounted Semetey upon him."},{"id":"semetey-1-2013:p1268:b004:l021","ordinal":172985,"en":"They readied his weapons"},{"id":"semetey-1-2013:p1268:b004:l022","ordinal":172986,"en":"And prepared every piece of armor."},{"id":"semetey-1-2013:p1268:b004:l023","ordinal":172987,"en":"Your lord came out apart,"},{"id":"semetey-1-2013:p1268:b004:l024","ordinal":172988,"en":"Looking like a solitary mountain."},{"id":"semetey-1-2013:p1268:b004:l025","ordinal":172989,"en":"Your lord was alone,"},{"id":"semetey-1-2013:p1268:b004:l026","ordinal":172990,"en":"Your sultan was unsurpassed."},{"id":"semetey-1-2013:p1268:b004:l027","ordinal":172991,"en":"Beside that lord"},{"id":"semetey-1-2013:p1268:b004:l028","ordinal":172992,"en":"There was no forest to flee into,"},{"id":"semetey-1-2013:p1268:b004:l029","ordinal":172993,"en":"No Kyrgyz to make a host."},{"id":"semetey-1-2013:p1268:b004:l030","ordinal":172994,"en":"He had no waist girded beside him,"},{"id":"semetey-1-2013:p1268:b004:l031","ordinal":172995,"en":"No place of ambush."},{"id":"semetey-1-2013:p1268:b004:l032","ordinal":172996,"en":"He had no fortune founded at Keng-Kol,"},{"id":"semetey-1-2013:p1268:b004:l033","ordinal":172997,"en":"No time to stride proudly."},{"id":"semetey-1-2013:p1268:b004:l034","ordinal":172998,"en":"The gray-maned son of Manas"},{"id":"semetey-1-2013:p1268:b004:l035","ordinal":172999,"en":"Had courage beyond all measure."},{"id":"semetey-1-2013:p1268:b004:l036","ordinal":173000,"en":"The Argyn who would have ridden as support"},{"id":"semetey-1-2013:p1268:b004:l037","ordinal":173001,"en":"Was not there."},{"id":"semetey-1-2013:p1268:b004:l038","ordinal":173002,"en":"He had no khan to find counsel;"},{"id":"semetey-1-2013:p1268:b004:l039","ordinal":173003,"en":"The Jediger were set to shoot,"},{"id":"semetey-1-2013:p1269:b003:l001","ordinal":173004,"en":"To devise a means for him,"},{"id":"semetey-1-2013:p1269:b003:l002","ordinal":173005,"en":"Neither Sary Khan nor Bakay was there."},{"id":"semetey-1-2013:p1269:b003:l003","ordinal":173006,"en":"The peerless lion stood utterly alone;"},{"id":"semetey-1-2013:p1269:b003:l004","ordinal":173007,"en":"The poor hero grew angry,"},{"id":"semetey-1-2013:p1269:b003:l005","ordinal":173008,"en":"Towering apart from other men,"},{"id":"semetey-1-2013:p1269:b003:l006","ordinal":173009,"en":"His terrible bearing held high."},{"id":"semetey-1-2013:p1269:b003:l007","ordinal":173010,"en":"As though sixty rivers converged"},{"id":"semetey-1-2013:p1269:b003:l008","ordinal":173011,"en":"And he were formed from their torrents;"},{"id":"semetey-1-2013:p1269:b003:l009","ordinal":173012,"en":"As though he were formed"},{"id":"semetey-1-2013:p1269:b003:l010","ordinal":173013,"en":"From every spur of twelve mountains;"},{"id":"semetey-1-2013:p1269:b003:l011","ordinal":173014,"en":"As though he were formed from the lair"},{"id":"semetey-1-2013:p1269:b003:l012","ordinal":173015,"en":"Of your hungry lion;"},{"id":"semetey-1-2013:p1269:b003:l013","ordinal":173016,"en":"As though he were formed from the supports"},{"id":"semetey-1-2013:p1269:b003:l014","ordinal":173017,"en":"Of heaven and earth."},{"id":"semetey-1-2013:p1269:b003:l015","ordinal":173018,"en":"Raging and champing for battle,"},{"id":"semetey-1-2013:p1269:b003:l016","ordinal":173019,"en":"Leopard-born Semetey"},{"id":"semetey-1-2013:p1269:b003:l017","ordinal":173020,"en":"Set out toward the Jediger."},{"id":"semetey-1-2013:p1269:b003:l018","ordinal":173021,"en":"Young Lord Semetey"},{"id":"semetey-1-2013:p1269:b003:l019","ordinal":173022,"en":"Mounted Buurul,"},{"id":"semetey-1-2013:p1269:b003:l020","ordinal":173023,"en":"Making him spirited then,"},{"id":"semetey-1-2013:p1269:b003:l021","ordinal":173024,"en":"Making him heave as though his master had died."},{"id":"semetey-1-2013:p1269:b003:l022","ordinal":173025,"en":"Semetey emerged"},{"id":"semetey-1-2013:p1269:b003:l023","ordinal":173026,"en":"From the treasury horde;"},{"id":"semetey-1-2013:p1269:b003:l024","ordinal":173027,"en":"The direction he lunged became red fire,"},{"id":"semetey-1-2013:p1269:b003:l025","ordinal":173028,"en":"And all who saw him lost heart."},{"id":"semetey-1-2013:p1269:b003:l026","ordinal":173029,"en":"Nine guardian spirits supported him;"},{"id":"semetey-1-2013:p1269:b003:l027","ordinal":173030,"en":"A black-striped leopard"},{"id":"semetey-1-2013:p1269:b003:l028","ordinal":173031,"en":"Strained at his side."},{"id":"semetey-1-2013:p1269:b003:l029","ordinal":173032,"en":"One of the forty chiltens"},{"id":"semetey-1-2013:p1269:b003:l030","ordinal":173033,"en":"Supported him unseen;"},{"id":"semetey-1-2013:p1269:b003:l031","ordinal":173034,"en":"A stunted gray-maned lion"},{"id":"semetey-1-2013:p1269:b003:l032","ordinal":173035,"en":"Made ready alongside him."},{"id":"semetey-1-2013:p1269:b003:l033","ordinal":173036,"en":"The forty chiltens and Khizr Ilyas"},{"id":"semetey-1-2013:p1269:b003:l034","ordinal":173037,"en":"All joined in supporting him."},{"id":"semetey-1-2013:p1269:b003:l035","ordinal":173038,"en":"A giant black eagle, a zymyr bird,"},{"id":"semetey-1-2013:p1269:b003:l036","ordinal":173039,"en":"As though about to carry him away,"},{"id":"semetey-1-2013:p1269:b003:l037","ordinal":173040,"en":"Stretched its feet down from the sky."},{"id":"semetey-1-2013:p1269:b003:l038","ordinal":173041,"en":"A black-striped dragon"},{"id":"semetey-1-2013:p1269:b003:l039","ordinal":173042,"en":"Crawled beneath him"},{"id":"semetey-1-2013:p1269:b004:l001","ordinal":173043,"en":"As though drawing him onward."},{"id":"semetey-1-2013:p1269:b004:l002","ordinal":173044,"en":"The orphaned son of Manas,"},{"id":"semetey-1-2013:p1269:b004:l003","ordinal":173045,"en":"Your rooster-like lion—"},{"id":"semetey-1-2013:p1269:b004:l004","ordinal":173046,"en":"Manas, whose spirit lived,"},{"id":"semetey-1-2013:p1269:b004:l005","ordinal":173047,"en":"Supported him above all."},{"id":"semetey-1-2013:p1269:b004:l006","ordinal":173048,"en":"Shimmering dark blue,"},{"id":"semetey-1-2013:p1269:b004:l007","ordinal":173049,"en":"The direction he faced became red fire."},{"id":"semetey-1-2013:p1269:b004:l008","ordinal":173050,"en":"At the place where he spent a night,"},{"id":"semetey-1-2013:p1269:b004:l009","ordinal":173051,"en":"A deep-rooted shrine arose;"},{"id":"semetey-1-2013:p1269:b004:l010","ordinal":173052,"en":"Khizr supported from his birth"},{"id":"semetey-1-2013:p1269:b004:l011","ordinal":173053,"en":"The descendant of the inexhaustible one."},{"id":"semetey-1-2013:p1269:b004:l012","ordinal":173054,"en":"At the place he chose to visit,"},{"id":"semetey-1-2013:p1269:b004:l013","ordinal":173055,"en":"A shrine with a city arose."},{"id":"semetey-1-2013:p1269:b004:l014","ordinal":173056,"en":"His sacred power was extraordinary;"}]
