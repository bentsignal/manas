[{"id":"manas-2010:p0165:b002:l036","ordinal":7169,"en":"Of mighty Manas the blood-shedder"},{"id":"manas-2010:p0165:b002:l037","ordinal":7170,"en":"He delivered the news:"},{"id":"manas-2010:p0165:b002:l038","ordinal":7171,"en":"“We are petitioners come before you,"},{"id":"manas-2010:p0165:b002:l039","ordinal":7172,"en":"Ah, my lord, before you"},{"id":"manas-2010:p0165:b002:l040","ordinal":7173,"en":"We are complainants pleading our case."},{"id":"manas-2010:p0165:b002:l041","ordinal":7174,"en":"Slaughtering livestock like an emperor,"},{"id":"manas-2010:p0165:b002:l042","ordinal":7175,"en":"Naming his son ‘Madman,’"},{"id":"manas-2010:p0165:b002:l043","ordinal":7176,"en":"This Jakyp is himself a Burut,"},{"id":"manas-2010:p0165:b002:l044","ordinal":7177,"en":"His exceedingly bloodthirsty son"},{"id":"manas-2010:p0165:b002:l045","ordinal":7178,"en":"This Burut has kept hidden."},{"id":"manas-2010:p0165:b002:l046","ordinal":7179,"en":"Seven hundred, led by Kochku,"},{"id":"manas-2010:p0165:b002:l047","ordinal":7180,"en":"When they proclaimed the khan's command,"},{"id":"manas-2010:p0165:b002:l048","ordinal":7181,"en":"When they turned their swift steeds' heads,"},{"id":"manas-2010:p0166:b002:l001","ordinal":7182,"en":"‘Esenkan's message"},{"id":"manas-2010:p0166:b002:l002","ordinal":7183,"en":"Is truly this,’ they said,"},{"id":"manas-2010:p0166:b002:l003","ordinal":7184,"en":"As they delivered the news,"},{"id":"manas-2010:p0166:b002:l004","ordinal":7185,"en":"He began the havoc,"},{"id":"manas-2010:p0166:b002:l005","ordinal":7186,"en":"With hero Kochku at their head,"},{"id":"manas-2010:p0166:b002:l006","ordinal":7187,"en":"Some seven hundred champions"},{"id":"manas-2010:p0166:b002:l007","ordinal":7188,"en":"He slaughtered to the last."},{"id":"manas-2010:p0166:b002:l008","ordinal":7189,"en":"He reduced their forelocks to loose wool,"},{"id":"manas-2010:p0166:b002:l009","ordinal":7190,"en":"He wiped out every man."},{"id":"manas-2010:p0166:b002:l010","ordinal":7191,"en":"Leaving the kochkus diminished,"},{"id":"manas-2010:p0166:b002:l011","ordinal":7192,"en":"All the champions"},{"id":"manas-2010:p0166:b002:l012","ordinal":7193,"en":"He slaughtered and left stretched out,"},{"id":"manas-2010:p0166:b002:l013","ordinal":7194,"en":"Their mighty Khan Kochku died,"},{"id":"manas-2010:p0166:b002:l014","ordinal":7195,"en":"He unleashed his terrible wrath,"},{"id":"manas-2010:p0166:b002:l015","ordinal":7196,"en":"This Burut seems a day of doom,"},{"id":"manas-2010:p0166:b002:l016","ordinal":7197,"en":"He slaughtered the champions."},{"id":"manas-2010:p0166:b002:l017","ordinal":7198,"en":"His face like wheat glistening with oil,"},{"id":"manas-2010:p0166:b002:l018","ordinal":7199,"en":"His eyes like mist at dusk,"},{"id":"manas-2010:p0166:b002:l019","ordinal":7200,"en":"A broad mouth, cliff-like brows,"},{"id":"manas-2010:p0166:b002:l020","ordinal":7201,"en":"He seems no man to spare a life."},{"id":"manas-2010:p0166:b002:l021","ordinal":7202,"en":"Tall of stature, broad of shoulder,"},{"id":"manas-2010:p0166:b002:l022","ordinal":7203,"en":"He is a lion fit to be a hero,"},{"id":"manas-2010:p0166:b002:l023","ordinal":7204,"en":"Unless you prepare and seize him,"},{"id":"manas-2010:p0166:b002:l024","ordinal":7205,"en":"Unless you cast him in your dungeon,"},{"id":"manas-2010:p0166:b002:l025","ordinal":7206,"en":"Unless you kill and behead him,"},{"id":"manas-2010:p0166:b002:l026","ordinal":7207,"en":"Unless you put an end to him,"},{"id":"manas-2010:p0166:b002:l027","ordinal":7208,"en":"He will smash and slaughter your giants,"},{"id":"manas-2010:p0166:b002:l028","ordinal":7209,"en":"Should he live, you will see,"},{"id":"manas-2010:p0166:b002:l029","ordinal":7210,"en":"My lord, he will grind your people like flour."},{"id":"manas-2010:p0166:b002:l030","ordinal":7211,"en":"He is mighty, he is a lion,"},{"id":"manas-2010:p0166:b002:l031","ordinal":7212,"en":"Of the downtrodden Burut"},{"id":"manas-2010:p0166:b002:l032","ordinal":7213,"en":"Their son Manas is a hero."},{"id":"manas-2010:p0166:b002:l033","ordinal":7214,"en":"He has reached twelve years,"},{"id":"manas-2010:p0166:b002:l034","ordinal":7215,"en":"When he reaches eighteen,"},{"id":"manas-2010:p0166:b002:l035","ordinal":7216,"en":"He will not let a plough be turned,"},{"id":"manas-2010:p0166:b002:l036","ordinal":7217,"en":"Should he live, you will see,"},{"id":"manas-2010:p0166:b002:l037","ordinal":7218,"en":"Chynmachyn and Beejin,"},{"id":"manas-2010:p0166:b002:l038","ordinal":7219,"en":"Your seething people,"},{"id":"manas-2010:p0166:b002:l039","ordinal":7220,"en":"He will not let them dwell in this Beejin,"},{"id":"manas-2010:p0166:b002:l040","ordinal":7221,"en":"He will smash your idols,"},{"id":"manas-2010:p0166:b002:l041","ordinal":7222,"en":"My khan, he will slaughter your people utterly."},{"id":"manas-2010:p0166:b002:l042","ordinal":7223,"en":"If you look upon Manas's form,"},{"id":"manas-2010:p0166:b002:l043","ordinal":7224,"en":"He wears a sword without a sheath,"},{"id":"manas-2010:p0166:b002:l044","ordinal":7225,"en":"Like a cloud about to rain again,"},{"id":"manas-2010:p0166:b002:l045","ordinal":7226,"en":"His wrath has risen to his face,"},{"id":"manas-2010:p0166:b002:l046","ordinal":7227,"en":"A socketed, lacquered spear"},{"id":"manas-2010:p0166:b002:l047","ordinal":7228,"en":"He has raised high aloft,"},{"id":"manas-2010:p0166:b002:l048","ordinal":7229,"en":"He never flinches in fear,"},{"id":"manas-2010:p0167:b002:l001","ordinal":7230,"en":"A man who meets him in combat"},{"id":"manas-2010:p0167:b002:l002","ordinal":7231,"en":"He tramples to earth like a hare,"},{"id":"manas-2010:p0167:b002:l003","ordinal":7232,"en":"Thick of arm, stone-hearted,"},{"id":"manas-2010:p0167:b002:l004","ordinal":7233,"en":"He is an elephant-limbed mighty brute."},{"id":"manas-2010:p0167:b002:l005","ordinal":7234,"en":"His armed array numbers eighty-four,"},{"id":"manas-2010:p0167:b002:l006","ordinal":7235,"en":"Wherever he strikes is red fire,"},{"id":"manas-2010:p0167:b002:l007","ordinal":7236,"en":"Living by deception, that Burut"},{"id":"manas-2010:p0167:b002:l008","ordinal":7237,"en":"Came to be born in Altai,"},{"id":"manas-2010:p0167:b002:l009","ordinal":7238,"en":"He has a pitch-black bristling mane,"},{"id":"manas-2010:p0167:b002:l010","ordinal":7239,"en":"From Kakanchy to Beejin"},{"id":"manas-2010:p0167:b002:l011","ordinal":7240,"en":"He has the strength to wreak havoc,"},{"id":"manas-2010:p0167:b002:l012","ordinal":7241,"en":"His very movement takes men's lives,"},{"id":"manas-2010:p0167:b002:l013","ordinal":7242,"en":"His very voice takes men's lives."},{"id":"manas-2010:p0167:b002:l014","ordinal":7243,"en":"On your upper side, Bakburchun,"},{"id":"manas-2010:p0167:b002:l015","ordinal":7244,"en":"Before you, Kakanchyn,"},{"id":"manas-2010:p0167:b002:l016","ordinal":7245,"en":"Your mighty city Dyngshang—"},{"id":"manas-2010:p0167:b002:l017","ordinal":7246,"en":"We have crossed all these to come,"},{"id":"manas-2010:p0167:b002:l018","ordinal":7247,"en":"He is no creature born for nothing,"},{"id":"manas-2010:p0167:b002:l019","ordinal":7248,"en":"He is no child to stand idle,"},{"id":"manas-2010:p0167:b002:l020","ordinal":7249,"en":"His bulk is like half a mountain,"},{"id":"manas-2010:p0167:b002:l021","ordinal":7250,"en":"All who grapple with him"},{"id":"manas-2010:p0167:b002:l022","ordinal":7251,"en":"He seems ready to devour in wrath."},{"id":"manas-2010:p0167:b002:l023","ordinal":7252,"en":"I saw his bearing—a grey tiger,"},{"id":"manas-2010:p0167:b002:l024","ordinal":7253,"en":"There is no being like this Burut,"},{"id":"manas-2010:p0167:b002:l025","ordinal":7254,"en":"When he roars and thrusts his spear,"},{"id":"manas-2010:p0167:b002:l026","ordinal":7255,"en":"A lion's bearing shows,"},{"id":"manas-2010:p0167:b002:l027","ordinal":7256,"en":"I have seen no such man,"},{"id":"manas-2010:p0167:b002:l028","ordinal":7257,"en":"My lord, before you"},{"id":"manas-2010:p0167:b002:l029","ordinal":7258,"en":"I barely escaped to come."},{"id":"manas-2010:p0167:b002:l030","ordinal":7259,"en":"I have seen such a champion,"},{"id":"manas-2010:p0167:b002:l031","ordinal":7260,"en":"My own eyes saw, my lord,"},{"id":"manas-2010:p0167:b002:l032","ordinal":7261,"en":"The slaughter he brought on those who went."},{"id":"manas-2010:p0167:b002:l033","ordinal":7262,"en":"Rich Jakyp's horses,"},{"id":"manas-2010:p0167:b002:l034","ordinal":7263,"en":"When they drove off the whole herd,"},{"id":"manas-2010:p0167:b002:l035","ordinal":7264,"en":"Riding a horse like Toruchaar,"},{"id":"manas-2010:p0167:b002:l036","ordinal":7265,"en":"He dug and hollowed out the earth,"},{"id":"manas-2010:p0167:b002:l037","ordinal":7266,"en":"All those who had gone,"},{"id":"manas-2010:p0167:b002:l038","ordinal":7267,"en":"He slaughtered without sparing one."},{"id":"manas-2010:p0167:b002:l039","ordinal":7268,"en":"He took their horses as booty,"},{"id":"manas-2010:p0167:b002:l040","ordinal":7269,"en":"The Burut is awash in spoils."},{"id":"manas-2010:p0167:b002:l041","ordinal":7270,"en":"Why should I tell the rest,"},{"id":"manas-2010:p0167:b002:l042","ordinal":7271,"en":"My khan, by sitting here lamenting,"},{"id":"manas-2010:p0167:b002:l043","ordinal":7272,"en":"What wish could I attain?"},{"id":"manas-2010:p0167:b002:l044","ordinal":7273,"en":"Before he was born—may he burn!—"},{"id":"manas-2010:p0167:b002:l045","ordinal":7274,"en":"He was entered in your register,"},{"id":"manas-2010:p0167:b002:l046","ordinal":7275,"en":"He is that bloodthirsty Burut,"},{"id":"manas-2010:p0167:b002:l047","ordinal":7276,"en":"Having reached twelve years,"},{"id":"manas-2010:p0168:b002:l001","ordinal":7277,"en":"He has now come forth.”"},{"id":"manas-2010:p0168:b004:l001","ordinal":7278,"en":"Tagylyk, champion of the Kytay,"},{"id":"manas-2010:p0168:b004:l002","ordinal":7279,"en":"After Tagylyk had spoken thus,"},{"id":"manas-2010:p0168:b004:l003","ordinal":7280,"en":"Black-bearded Boroonchu,"},{"id":"manas-2010:p0168:b004:l004","ordinal":7281,"en":"And Tagylyk of the Kytay speaking,"},{"id":"manas-2010:p0168:b004:l005","ordinal":7282,"en":"When they heard the news of Manas,"},{"id":"manas-2010:p0168:b004:l006","ordinal":7283,"en":"Were left wholly at a loss,"},{"id":"manas-2010:p0168:b004:l007","ordinal":7284,"en":"The many seething lords."},{"id":"manas-2010:p0168:b004:l008","ordinal":7285,"en":"Giant Mankushta, giant Döödür,"},{"id":"manas-2010:p0168:b004:l009","ordinal":7286,"en":"Scissor-eared giant Kaman,"},{"id":"manas-2010:p0168:b004:l010","ordinal":7287,"en":"So many beings could be seen,"},{"id":"manas-2010:p0168:b004:l011","ordinal":7288,"en":"Before Esenkan"},{"id":"manas-2010:p0168:b004:l012","ordinal":7289,"en":"Were khans who governed peoples."},{"id":"manas-2010:p0168:b004:l013","ordinal":7290,"en":"The skilled among spearmen,"},{"id":"manas-2010:p0168:b004:l014","ordinal":7291,"en":"The finest who knew the enemy's designs,"},{"id":"manas-2010:p0168:b004:l015","ordinal":7292,"en":"When they heard the name of Manas,"},{"id":"manas-2010:p0168:b004:l016","ordinal":7293,"en":"All trembled together,"},{"id":"manas-2010:p0168:b004:l017","ordinal":7294,"en":"Their sovereign Esenkan"},{"id":"manas-2010:p0168:b004:l018","ordinal":7295,"en":"Now stood there rumbling,"},{"id":"manas-2010:p0168:b004:l019","ordinal":7296,"en":"Ay-Jangjung and Kün-Jangjung,"},{"id":"manas-2010:p0168:b004:l020","ordinal":7297,"en":"These two were his counselors."},{"id":"manas-2010:p0168:b004:l021","ordinal":7298,"en":"What could Khan Esenkan do,"},{"id":"manas-2010:p0168:b004:l022","ordinal":7299,"en":"Raging and working himself up,"},{"id":"manas-2010:p0168:b004:l023","ordinal":7300,"en":"He began the havoc."},{"id":"manas-2010:p0168:b004:l024","ordinal":7301,"en":"His roar drove life from the people,"},{"id":"manas-2010:p0168:b004:l025","ordinal":7302,"en":"Rousing himself like a grey lion,"},{"id":"manas-2010:p0168:b004:l026","ordinal":7303,"en":"Mighty Esenkan,"},{"id":"manas-2010:p0168:b004:l027","ordinal":7304,"en":"Addressing his people of splendor,"},{"id":"manas-2010:p0168:b004:l028","ordinal":7305,"en":"Unleashed his terrible wrath,"},{"id":"manas-2010:p0168:b004:l029","ordinal":7306,"en":"His shout split stone,"},{"id":"manas-2010:p0168:b004:l030","ordinal":7307,"en":"The champion standing there"},{"id":"manas-2010:p0168:b004:l031","ordinal":7308,"en":"He slaughtered forthwith:"},{"id":"manas-2010:p0168:b004:l032","ordinal":7309,"en":"“You have lords, you have khans,"},{"id":"manas-2010:p0168:b004:l033","ordinal":7310,"en":"All you people are here,"},{"id":"manas-2010:p0168:b004:l034","ordinal":7311,"en":"Calling a worthless boy ‘Manas,’"},{"id":"manas-2010:p0168:b004:l035","ordinal":7312,"en":"Why have you brought this trouble?"},{"id":"manas-2010:p0168:b004:l036","ordinal":7313,"en":"When I sent experts expressly,"},{"id":"manas-2010:p0168:b004:l037","ordinal":7314,"en":"To the damned Burut,"},{"id":"manas-2010:p0168:b004:l038","ordinal":7315,"en":"Why did you leave Manas there?"},{"id":"manas-2010:p0168:b004:l039","ordinal":7316,"en":"You have clairvoyant seers,"},{"id":"manas-2010:p0169:b002:l001","ordinal":7317,"en":"Who have studied wondrous lore,"},{"id":"manas-2010:p0169:b002:l002","ordinal":7318,"en":"You have sages and elders,"},{"id":"manas-2010:p0169:b002:l003","ordinal":7319,"en":"Trouble six months away"},{"id":"manas-2010:p0169:b002:l004","ordinal":7320,"en":"They can behold this instant,"},{"id":"manas-2010:p0169:b002:l005","ordinal":7321,"en":"All the learned ones are here,"},{"id":"manas-2010:p0169:b002:l006","ordinal":7322,"en":"Your khans who maintain courts,"},{"id":"manas-2010:p0169:b002:l007","ordinal":7323,"en":"The trouble of six months hence,"},{"id":"manas-2010:p0169:b002:l008","ordinal":7324,"en":"Your people who know it now,"},{"id":"manas-2010:p0169:b002:l009","ordinal":7325,"en":"Who have studied wondrous lore,"},{"id":"manas-2010:p0169:b002:l010","ordinal":7326,"en":"Among the mighty wearing armor,"},{"id":"manas-2010:p0169:b002:l011","ordinal":7327,"en":"My men whose voices thunder,"},{"id":"manas-2010:p0169:b002:l012","ordinal":7328,"en":"When told to find the blood-shedder,"},{"id":"manas-2010:p0169:b002:l013","ordinal":7329,"en":"You merely claimed, ‘I have found him,’"},{"id":"manas-2010:p0169:b002:l014","ordinal":7330,"en":"To the khan of Kakanchy,"},{"id":"manas-2010:p0169:b002:l015","ordinal":7331,"en":"How can I bear your lies!”"},{"id":"manas-2010:p0169:b002:l016","ordinal":7332,"en":"He summoned his sorcerers,"},{"id":"manas-2010:p0169:b002:l017","ordinal":7333,"en":"Lights were kindled on the tower,"},{"id":"manas-2010:p0169:b002:l018","ordinal":7334,"en":"The bell was struck hard,"},{"id":"manas-2010:p0169:b002:l019","ordinal":7335,"en":"Tagylyk brought the news,"},{"id":"manas-2010:p0169:b002:l020","ordinal":7336,"en":"Before Khan Esen"},{"id":"manas-2010:p0169:b002:l021","ordinal":7337,"en":"The many lords came seething."},{"id":"manas-2010:p0169:b002:l022","ordinal":7338,"en":"His lords came seething in,"},{"id":"manas-2010:p0169:b002:l023","ordinal":7339,"en":"He began the havoc,"},{"id":"manas-2010:p0169:b002:l024","ordinal":7340,"en":"Through Esenkan's wrath,"},{"id":"manas-2010:p0169:b002:l025","ordinal":7341,"en":"The many assembled lords"},{"id":"manas-2010:p0169:b002:l026","ordinal":7342,"en":"Were slaughtered outright."},{"id":"manas-2010:p0169:b002:l027","ordinal":7343,"en":"The chief of the sorcerers,"},{"id":"manas-2010:p0169:b002:l028","ordinal":7344,"en":"His giant Döngö, the great champion."},{"id":"manas-2010:p0169:b002:l029","ordinal":7345,"en":"“The otogot badge of Beejin,"},{"id":"manas-2010:p0169:b002:l030","ordinal":7346,"en":"With collar gold and sleeves copper,"},{"id":"manas-2010:p0169:b002:l031","ordinal":7347,"en":"Impervious to bullets when worn in battle,"},{"id":"manas-2010:p0169:b002:l032","ordinal":7348,"en":"You went without wearing it,"},{"id":"manas-2010:p0169:b002:l033","ordinal":7349,"en":"His appearance and his bearing,"},{"id":"manas-2010:p0169:b002:l034","ordinal":7350,"en":"Beast-like, my champion,"},{"id":"manas-2010:p0169:b002:l035","ordinal":7351,"en":"You went without knowing them!"},{"id":"manas-2010:p0169:b002:l036","ordinal":7352,"en":"I told you before,"},{"id":"manas-2010:p0169:b002:l037","ordinal":7353,"en":"Did you not hear me before,"},{"id":"manas-2010:p0169:b002:l038","ordinal":7354,"en":"His name is Manas, his name is mighty,"},{"id":"manas-2010:p0169:b002:l039","ordinal":7355,"en":"A creature who will slaughter this world."},{"id":"manas-2010:p0169:b002:l040","ordinal":7356,"en":"Did I not tell you before,"},{"id":"manas-2010:p0169:b002:l041","ordinal":7357,"en":"Did you not hear me before,"},{"id":"manas-2010:p0169:b002:l042","ordinal":7358,"en":"From the hostile bloodthirsty Burut,"},{"id":"manas-2010:p0169:b002:l043","ordinal":7359,"en":"From that people called Burut,"},{"id":"manas-2010:p0169:b002:l044","ordinal":7360,"en":"From that people—may they burn!—"},{"id":"manas-2010:p0169:b002:l045","ordinal":7361,"en":"Whose faith is Islam,"},{"id":"manas-2010:p0169:b002:l046","ordinal":7362,"en":"Who are our enemies at the root,"},{"id":"manas-2010:p0169:b002:l047","ordinal":7363,"en":"From them Manas will be born,"},{"id":"manas-2010:p0169:b002:l048","ordinal":7364,"en":"‘Manas's form is like this,’"},{"id":"manas-2010:p0170:b002:l001","ordinal":7365,"en":"Did I not tell you before?"},{"id":"manas-2010:p0170:b002:l002","ordinal":7366,"en":"Of those Burut—may they die raving!—"},{"id":"manas-2010:p0170:b002:l003","ordinal":7367,"en":"Of that people called Burut,"},{"id":"manas-2010:p0170:b002:l004","ordinal":7368,"en":"Of Manas born among them,"},{"id":"manas-2010:p0170:b002:l005","ordinal":7369,"en":"His shape, his stature,"},{"id":"manas-2010:p0170:b002:l006","ordinal":7370,"en":"His living appearance,"},{"id":"manas-2010:p0170:b002:l007","ordinal":7371,"en":"The tips of his ears are pierced,"},{"id":"manas-2010:p0170:b002:l008","ordinal":7372,"en":"His foreskin is cut,"},{"id":"manas-2010:p0170:b002:l009","ordinal":7373,"en":"His sight brings many to dismay,"},{"id":"manas-2010:p0170:b002:l010","ordinal":7374,"en":"All his features are like this,"},{"id":"manas-2010:p0170:b002:l011","ordinal":7375,"en":"Prophet-like—yet bringing dismay."},{"id":"manas-2010:p0170:b002:l012","ordinal":7376,"en":"Though told his signs, you failed to find him,"},{"id":"manas-2010:p0170:b002:l013","ordinal":7377,"en":"You were caught unawares,"},{"id":"manas-2010:p0170:b002:l014","ordinal":7378,"en":"Digging my pit deep,"},{"id":"manas-2010:p0170:b002:l015","ordinal":7379,"en":"When I sent you, you could not find him,"},{"id":"manas-2010:p0170:b002:l016","ordinal":7380,"en":"You damned sorcerers,"},{"id":"manas-2010:p0170:b002:l017","ordinal":7381,"en":"You came back from afar."},{"id":"manas-2010:p0170:b002:l018","ordinal":7382,"en":"All of you telling lies together,"},{"id":"manas-2010:p0170:b002:l019","ordinal":7383,"en":"You came back from the wilderness."},{"id":"manas-2010:p0170:b002:l020","ordinal":7384,"en":"You damned sorcerers,"},{"id":"manas-2010:p0170:b002:l021","ordinal":7385,"en":"You have dug my pit,"},{"id":"manas-2010:p0170:b002:l022","ordinal":7386,"en":"You have brought to the boil"},{"id":"manas-2010:p0170:b002:l023","ordinal":7387,"en":"My far-off misfortune."},{"id":"manas-2010:p0170:b002:l024","ordinal":7388,"en":"‘I found Manas and brought him,’ you said,"},{"id":"manas-2010:p0170:b002:l025","ordinal":7389,"en":"You ill-omened sorcerers,"},{"id":"manas-2010:p0170:b002:l026","ordinal":7390,"en":"How can I bear your lies!"},{"id":"manas-2010:p0170:b002:l027","ordinal":7391,"en":"You heard my words before,"},{"id":"manas-2010:p0170:b002:l028","ordinal":7392,"en":"Springing deceit on me, telling lies,"},{"id":"manas-2010:p0170:b002:l029","ordinal":7393,"en":"You damned sorcerers,"},{"id":"manas-2010:p0170:b002:l030","ordinal":7394,"en":"‘I found the mighty one and brought him,’ you said,"},{"id":"manas-2010:p0170:b002:l031","ordinal":7395,"en":"Your outrageous falsehoods,"},{"id":"manas-2010:p0170:b002:l032","ordinal":7396,"en":"How can I bear your making them prevail!"},{"id":"manas-2010:p0170:b002:l033","ordinal":7397,"en":"Calling a mere nothing ‘Manas,’"},{"id":"manas-2010:p0170:b002:l034","ordinal":7398,"en":"How can I bear your concealment!"},{"id":"manas-2010:p0170:b002:l035","ordinal":7399,"en":"I will not hear your words if you plead,"},{"id":"manas-2010:p0170:b002:l036","ordinal":7400,"en":"Watch now, champions,"},{"id":"manas-2010:p0170:b002:l037","ordinal":7401,"en":"I shall gouge out all your eyes!”"},{"id":"manas-2010:p0170:b002:l038","ordinal":7402,"en":"Khan Esenkan worked himself up,"},{"id":"manas-2010:p0170:b002:l039","ordinal":7403,"en":"Wrath came upon him from the unseen,"},{"id":"manas-2010:p0170:b002:l040","ordinal":7404,"en":"He began the havoc,"},{"id":"manas-2010:p0170:b002:l041","ordinal":7405,"en":"Exactly forty of the sorcerers"},{"id":"manas-2010:p0170:b002:l042","ordinal":7406,"en":"He slaughtered to the last."},{"id":"manas-2010:p0170:b002:l043","ordinal":7407,"en":"A great square lay before the khan,"},{"id":"manas-2010:p0170:b002:l044","ordinal":7408,"en":"He had them brought into the great square,"},{"id":"manas-2010:p0170:b002:l045","ordinal":7409,"en":"In the middle of that square"},{"id":"manas-2010:p0170:b002:l046","ordinal":7410,"en":"He made them pay the full reckoning."},{"id":"manas-2010:p0170:b002:l047","ordinal":7411,"en":"‘They spoke falsely to the khan,’ he said,"},{"id":"manas-2010:p0170:b002:l048","ordinal":7412,"en":"And slaughtered them to the last."},{"id":"manas-2010:p0171:b002:l001","ordinal":7413,"en":"Roaring in fury,"},{"id":"manas-2010:p0171:b002:l002","ordinal":7414,"en":"Calling them close to their khan,"},{"id":"manas-2010:p0171:b002:l003","ordinal":7415,"en":"“Let your hero among spearmen come,"},{"id":"manas-2010:p0171:b002:l004","ordinal":7416,"en":"Let your lion who knows the enemy's designs come,"},{"id":"manas-2010:p0171:b002:l005","ordinal":7417,"en":"Let your skilled spearman come,"},{"id":"manas-2010:p0171:b002:l006","ordinal":7418,"en":"Let your finest who knows the enemy's designs come!"},{"id":"manas-2010:p0171:b002:l007","ordinal":7419,"en":"When the black gun crashes,"},{"id":"manas-2010:p0171:b002:l008","ordinal":7420,"en":"Let the finest who will not flee come,"},{"id":"manas-2010:p0171:b002:l009","ordinal":7421,"en":"When the short gun cracks,"},{"id":"manas-2010:p0171:b002:l010","ordinal":7422,"en":"Let the hero who does not startle come,"},{"id":"manas-2010:p0171:b002:l011","ordinal":7423,"en":"Let those with keen-pointed swords come,"},{"id":"manas-2010:p0171:b002:l012","ordinal":7424,"en":"Let your battle-axe wielding hero come,"}]
