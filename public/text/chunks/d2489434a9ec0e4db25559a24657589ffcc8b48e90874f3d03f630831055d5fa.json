[{"id":"semetey-1-2013:p1028:b007:l002","ordinal":154625,"en":"Thinking, \"How will he attempt the crossing?"},{"id":"semetey-1-2013:p1028:b007:l003","ordinal":154626,"en":"If the enraged lion enters the Urgench"},{"id":"semetey-1-2013:p1028:b007:l004","ordinal":154627,"en":"Without heed,"},{"id":"semetey-1-2013:p1028:b007:l005","ordinal":154628,"en":"He may die there for nothing,\""},{"id":"semetey-1-2013:p1028:b007:l006","ordinal":154629,"en":"She uttered a cold incantation"},{"id":"semetey-1-2013:p1028:b007:l007","ordinal":154630,"en":"And worked magic upon the weather."},{"id":"semetey-1-2013:p1028:b007:l008","ordinal":154631,"en":"Clouds tore open in the sky,"},{"id":"semetey-1-2013:p1028:b007:l009","ordinal":154632,"en":"And over the mountains rising from the foothills,"},{"id":"semetey-1-2013:p1029:b003:l001","ordinal":154633,"en":"There was neither hail nor rain;"},{"id":"semetey-1-2013:p1029:b003:l002","ordinal":154634,"en":"A freezing wind appeared."},{"id":"semetey-1-2013:p1029:b003:l003","ordinal":154635,"en":"All the lesser streams,"},{"id":"semetey-1-2013:p1029:b003:l004","ordinal":154636,"en":"Troubled and splashing,"},{"id":"semetey-1-2013:p1029:b003:l005","ordinal":154637,"en":"Separated and flowed in every direction."},{"id":"semetey-1-2013:p1029:b003:l006","ordinal":154638,"en":"Not one of a thousand running waters remained;"},{"id":"semetey-1-2013:p1029:b003:l007","ordinal":154639,"en":"Only the Great Urgench was left,"},{"id":"semetey-1-2013:p1029:b003:l008","ordinal":154640,"en":"Its stones visible in the riverbed."},{"id":"semetey-1-2013:p1029:b003:l009","ordinal":154641,"en":"Aichurok, the daughter of Akun,"},{"id":"semetey-1-2013:p1029:b003:l010","ordinal":154642,"en":"That clever-born wretched woman,"},{"id":"semetey-1-2013:p1029:b003:l011","ordinal":154643,"en":"Revealed her form as a weather-worker."},{"id":"semetey-1-2013:p1029:b003:l012","ordinal":154644,"en":"Not a spoonful of water ran from the springs;"},{"id":"semetey-1-2013:p1029:b003:l013","ordinal":154645,"en":"It lay frozen outside,"},{"id":"semetey-1-2013:p1029:b003:l014","ordinal":154646,"en":"As though the depths of winter had come."},{"id":"semetey-1-2013:p1029:b003:l015","ordinal":154647,"en":"So powerful was her incantation"},{"id":"semetey-1-2013:p1029:b003:l016","ordinal":154648,"en":"That the heads of the glaciers froze."},{"id":"semetey-1-2013:p1029:b003:l017","ordinal":154649,"en":"Through her spell, the Great Urgench"},{"id":"semetey-1-2013:p1029:b003:l018","ordinal":154650,"en":"Lay without flowing,"},{"id":"semetey-1-2013:p1029:b003:l019","ordinal":154651,"en":"Only a waterskin's little measure of water stirring."},{"id":"semetey-1-2013:p1029:b003:l020","ordinal":154652,"en":"If you would behold Semetey,"},{"id":"semetey-1-2013:p1029:b003:l021","ordinal":154653,"en":"He pleaded with his Allah"},{"id":"semetey-1-2013:p1029:b003:l022","ordinal":154654,"en":"And strained like a white tiger."},{"id":"semetey-1-2013:p1029:b003:l023","ordinal":154655,"en":"Driving fourteen horses from the Argyn,"},{"id":"semetey-1-2013:p1029:b003:l024","ordinal":154656,"en":"He drove all those horses"},{"id":"semetey-1-2013:p1029:b003:l025","ordinal":154657,"en":"So hard they seemed about to die;"},{"id":"semetey-1-2013:p1029:b003:l026","ordinal":154658,"en":"Their white foam streamed."},{"id":"semetey-1-2013:p1029:b003:l027","ordinal":154659,"en":"He drove them swiftly without stopping."},{"id":"semetey-1-2013:p1029:b003:l028","ordinal":154660,"en":"Then Semetey grew furious;"},{"id":"semetey-1-2013:p1029:b003:l029","ordinal":154661,"en":"As though Kalmyks had raided"},{"id":"semetey-1-2013:p1029:b003:l030","ordinal":154662,"en":"The populous Kyrgyz nation,"},{"id":"semetey-1-2013:p1029:b003:l031","ordinal":154663,"en":"He had his trumpet drawn out"},{"id":"semetey-1-2013:p1029:b003:l032","ordinal":154664,"en":"And advanced in dread majesty."},{"id":"semetey-1-2013:p1029:b003:l033","ordinal":154665,"en":"He urged the fourteen horses onward;"},{"id":"semetey-1-2013:p1029:b003:l034","ordinal":154666,"en":"No person could approach his anger,"},{"id":"semetey-1-2013:p1029:b003:l035","ordinal":154667,"en":"And no one wished to see his frowning brow."},{"id":"semetey-1-2013:p1029:b003:l036","ordinal":154668,"en":"Of the extravagantly born gray-maned hero,"},{"id":"semetey-1-2013:p1029:b003:l037","ordinal":154669,"en":"Which deed can one recount?"},{"id":"semetey-1-2013:p1029:b003:l038","ordinal":154670,"en":"He who had pastured at Middle Keng-Kol"},{"id":"semetey-1-2013:p1029:b003:l039","ordinal":154671,"en":"And tethered his fourteen horses—"},{"id":"semetey-1-2013:p1029:b004:l001","ordinal":154672,"en":"If enemies came out shooting,"},{"id":"semetey-1-2013:p1029:b004:l002","ordinal":154673,"en":"He drove them before him,"},{"id":"semetey-1-2013:p1029:b004:l003","ordinal":154674,"en":"And, lion that he was,"},{"id":"semetey-1-2013:p1029:b004:l004","ordinal":154675,"en":"Caught them in his fangs and chewed them."},{"id":"semetey-1-2013:p1029:b004:l005","ordinal":154676,"en":"Watching him, Choro's"},{"id":"semetey-1-2013:p1029:b004:l006","ordinal":154677,"en":"Heart was deeply troubled."},{"id":"semetey-1-2013:p1029:b004:l007","ordinal":154678,"en":"Driving fourteen swift horses,"},{"id":"semetey-1-2013:p1029:b004:l008","ordinal":154679,"en":"The doomed man seemed to have come"},{"id":"semetey-1-2013:p1029:b004:l009","ordinal":154680,"en":"To cross to the farther bank."},{"id":"semetey-1-2013:p1029:b004:l010","ordinal":154681,"en":"Kulchoro started in alarm."},{"id":"semetey-1-2013:p1029:b004:l012","ordinal":154682,"en":"He ran toward Buurul,","gapBefore":"[Passage withheld: sexual content involving a minor]"},{"id":"semetey-1-2013:p1029:b004:l013","ordinal":154683,"en":"Despairing of his entrusted life;"},{"id":"semetey-1-2013:p1029:b004:l014","ordinal":154684,"en":"Distraught, he caught Buurul."},{"id":"semetey-1-2013:p1029:b004:l015","ordinal":154685,"en":"Kulchoro laughed openly"},{"id":"semetey-1-2013:p1029:b004:l016","ordinal":154686,"en":"And pleaded with Aichurok:"},{"id":"semetey-1-2013:p1029:b004:l017","ordinal":154687,"en":"\"My dear sister-in-law!"},{"id":"semetey-1-2013:p1029:b004:l018","ordinal":154688,"en":"The enraged lion"},{"id":"semetey-1-2013:p1029:b004:l019","ordinal":154689,"en":"May kill me for nothing;"},{"id":"semetey-1-2013:p1029:b004:l020","ordinal":154690,"en":"Go smiling openly"},{"id":"semetey-1-2013:p1029:b004:l021","ordinal":154691,"en":"To that bloodthirsty man who loves his wife."},{"id":"semetey-1-2013:p1029:b004:l022","ordinal":154692,"en":"My dear sister-in-law!"},{"id":"semetey-1-2013:p1029:b004:l023","ordinal":154693,"en":"Beg him to spare my blood."},{"id":"semetey-1-2013:p1029:b004:l024","ordinal":154694,"en":"If you do not ask, it will not end well;"},{"id":"semetey-1-2013:p1029:b004:l025","ordinal":154695,"en":"My sultan will not leave me unharmed!\""},{"id":"semetey-1-2013:p1029:b004:l026","ordinal":154696,"en":"Having said this, Kulchoro"},{"id":"semetey-1-2013:p1029:b004:l027","ordinal":154697,"en":"Stood holding the steed."},{"id":"semetey-1-2013:p1029:b004:l028","ordinal":154698,"en":"Seeing her lord, Aichurok"},{"id":"semetey-1-2013:p1029:b004:l029","ordinal":154699,"en":"Stood watching from the riverbank;"},{"id":"semetey-1-2013:p1029:b004:l030","ordinal":154700,"en":"Thirty brides and thirty maidens"},{"id":"semetey-1-2013:p1029:b004:l031","ordinal":154701,"en":"Watched together in wonder."},{"id":"semetey-1-2013:p1029:b004:l032","ordinal":154702,"en":"Beating the fourteen horses,"},{"id":"semetey-1-2013:p1029:b004:l033","ordinal":154703,"en":"Your swaggering unfortunate man"},{"id":"semetey-1-2013:p1029:b004:l034","ordinal":154704,"en":"Made ready to enter the Urgench."},{"id":"semetey-1-2013:p1029:b004:l035","ordinal":154705,"en":"To keep his lord from entering the water,"},{"id":"semetey-1-2013:p1029:b004:l036","ordinal":154706,"en":"Speaking gently in his distress,"},{"id":"semetey-1-2013:p1029:b004:l037","ordinal":154707,"en":"Kanchoro came to his lord"},{"id":"semetey-1-2013:p1029:b004:l038","ordinal":154708,"en":"And pleaded, calling him \"dear uncle\":"},{"id":"semetey-1-2013:p1029:b004:l039","ordinal":154709,"en":"\"I shall babble and tell you one thing:"}]
