[{"id":"manas-2010:p0897:b001:l008","ordinal":39425,"en":"Pursuing him from behind"},{"id":"manas-2010:p0897:b001:l009","ordinal":39426,"en":"Is Karakan's daughter Kanykey,"},{"id":"manas-2010:p0897:b001:l010","ordinal":39427,"en":"A mighty girl with a warrior's frame."},{"id":"manas-2010:p0897:b001:l011","ordinal":39428,"en":"Sending Chubak into a panic,"},{"id":"manas-2010:p0897:b001:l012","ordinal":39429,"en":"She seems to be chasing him!"},{"id":"manas-2010:p0897:b001:l013","ordinal":39430,"en":"I drew upon transmitted lore,"},{"id":"manas-2010:p0897:b001:l014","ordinal":39431,"en":"I asked those who know:"},{"id":"manas-2010:p0897:b001:l015","ordinal":39432,"en":"Akbaltay's Chubak"},{"id":"manas-2010:p0897:b001:l016","ordinal":39433,"en":"Was born in broad Alay."},{"id":"manas-2010:p0897:b001:l017","ordinal":39434,"en":"When he reached twelve years of age,"},{"id":"manas-2010:p0897:b001:l018","ordinal":39435,"en":"In every land he swept over"},{"id":"manas-2010:p0897:b001:l019","ordinal":39436,"en":"He raised an uproar."},{"id":"manas-2010:p0897:b001:l020","ordinal":39437,"en":"He brought humiliation to Kokand, they say;"},{"id":"manas-2010:p0897:b001:l021","ordinal":39438,"en":"Making Margalan a battlefield,"},{"id":"manas-2010:p0897:b001:l022","ordinal":39439,"en":"To the gated city of Bukhara"},{"id":"manas-2010:p0897:b001:l023","ordinal":39440,"en":"He went to fight, they say."},{"id":"manas-2010:p0897:b001:l024","ordinal":39441,"en":"Karakan's daughter Kanykey,"},{"id":"manas-2010:p0897:b001:l025","ordinal":39442,"en":"They say, has extraordinary, boundless prowess."},{"id":"manas-2010:p0897:b001:l026","ordinal":39443,"en":"The hero Chubak, son of Akbaltay,"},{"id":"manas-2010:p0897:b001:l027","ordinal":39444,"en":"Must have been terribly alarmed."},{"id":"manas-2010:p0897:b001:l028","ordinal":39445,"en":"The hosts of Bukhara fell upon him,"},{"id":"manas-2010:p0897:b001:l029","ordinal":39446,"en":"Kanykey came out and fought with spears,"},{"id":"manas-2010:p0897:b001:l030","ordinal":39447,"en":"And when they were about to capture him,"},{"id":"manas-2010:p0897:b001:l031","ordinal":39448,"en":"He must have fled out of his wits!"},{"id":"manas-2010:p0897:b001:l032","ordinal":39449,"en":"Laying grass upon his pale tracks,"},{"id":"manas-2010:p0897:b001:l033","ordinal":39450,"en":"She must have pursued him, growing pale;"},{"id":"manas-2010:p0897:b001:l034","ordinal":39451,"en":"Laying grass upon his yellow tracks,"},{"id":"manas-2010:p0897:b001:l035","ordinal":39452,"en":"She must have pursued him, growing yellow!”"},{"id":"manas-2010:p0897:b001:l036","ordinal":39453,"en":"The saintly lion Bakay—"},{"id":"manas-2010:p0897:b001:l037","ordinal":39454,"en":"Before this or that could be said,"},{"id":"manas-2010:p0897:b001:l038","ordinal":39455,"en":"In the opening and closing of an eye,"},{"id":"manas-2010:p0897:b001:l039","ordinal":39456,"en":"Across the mottled plain at Tash-Moynok"},{"id":"manas-2010:p0897:b001:l040","ordinal":39457,"en":"He comes crossing the rise."},{"id":"manas-2010:p0897:b001:l041","ordinal":39458,"en":"Letting his coat skirts fly,"},{"id":"manas-2010:p0897:b001:l042","ordinal":39459,"en":"Lashing Kögala with his whip,"},{"id":"manas-2010:p0898:b001:l001","ordinal":39460,"en":"Striking with his whip this way and that,"},{"id":"manas-2010:p0898:b001:l002","ordinal":39461,"en":"Spurring on either side,"},{"id":"manas-2010:p0898:b001:l003","ordinal":39462,"en":"He comes fleeing forth."},{"id":"manas-2010:p0898:b001:l004","ordinal":39463,"en":"Kögala beneath him"},{"id":"manas-2010:p0898:b001:l005","ordinal":39464,"en":"Springs and bounds like a gazelle,"},{"id":"manas-2010:p0898:b001:l006","ordinal":39465,"en":"Showing his swiftness;"},{"id":"manas-2010:p0898:b001:l007","ordinal":39466,"en":"Springs and bounds like a mountain sheep,"},{"id":"manas-2010:p0898:b001:l008","ordinal":39467,"en":"Showing his excellence."},{"id":"manas-2010:p0898:b001:l009","ordinal":39468,"en":"He lowers his neck toward the ground;"},{"id":"manas-2010:p0898:b001:l010","ordinal":39469,"en":"Hero Chubak's Kögala"},{"id":"manas-2010:p0898:b001:l011","ordinal":39470,"en":"Takes relentless strides."},{"id":"manas-2010:p0898:b001:l012","ordinal":39471,"en":"His hooves thunder on the earth;"},{"id":"manas-2010:p0898:b001:l013","ordinal":39472,"en":"The black steel bit"},{"id":"manas-2010:p0898:b001:l014","ordinal":39473,"en":"Clatters deep in his mouth:"},{"id":"manas-2010:p0898:b001:l015","ordinal":39474,"en":"Such is Kögala's rush."},{"id":"manas-2010:p0898:b001:l016","ordinal":39475,"en":"The stones he treads upon"},{"id":"manas-2010:p0898:b001:l017","ordinal":39476,"en":"Crumble and scatter like coal,"},{"id":"manas-2010:p0898:b001:l018","ordinal":39477,"en":"Left behind by Kögala."},{"id":"manas-2010:p0898:b001:l019","ordinal":39478,"en":"Resourceful Bakay then,"},{"id":"manas-2010:p0898:b001:l020","ordinal":39479,"en":"When he saw Kögala, said:"},{"id":"manas-2010:p0898:b001:l021","ordinal":39480,"en":"“The wind cannot match his trot;"},{"id":"manas-2010:p0898:b001:l022","ordinal":39481,"en":"Will he escape without being caught?"},{"id":"manas-2010:p0898:b001:l023","ordinal":39482,"en":"No beast can match his stride;"},{"id":"manas-2010:p0898:b001:l024","ordinal":39483,"en":"Will this formidable Kögala"},{"id":"manas-2010:p0898:b001:l025","ordinal":39484,"en":"Go on his way?"},{"id":"manas-2010:p0898:b001:l026","ordinal":39485,"en":"Will Akbaltay's Chubak"},{"id":"manas-2010:p0898:b001:l027","ordinal":39486,"en":"Get away into his own land?”"},{"id":"manas-2010:p0898:b001:l028","ordinal":39487,"en":"Then Lord Bakay,"},{"id":"manas-2010:p0898:b001:l029","ordinal":39488,"en":"Striking Kök Tulpar once on the thigh,"},{"id":"manas-2010:p0898:b001:l030","ordinal":39489,"en":"Around the looming rise,"},{"id":"manas-2010:p0898:b001:l031","ordinal":39490,"en":"On Kök Tulpar at that moment,"},{"id":"manas-2010:p0898:b001:l032","ordinal":39491,"en":"Formidable Bakay then"},{"id":"manas-2010:p0898:b001:l033","ordinal":39492,"en":"Made ten circuits."},{"id":"manas-2010:p0898:b001:l034","ordinal":39493,"en":"Khan Bakay's Kök Tulpar,"},{"id":"manas-2010:p0898:b001:l035","ordinal":39494,"en":"As he swept over the dark earth,"},{"id":"manas-2010:p0898:b001:l036","ordinal":39495,"en":"Planted his hooves like a mountain sheep."},{"id":"manas-2010:p0898:b001:l037","ordinal":39496,"en":"The exceptionally mighty creature"},{"id":"manas-2010:p0898:b001:l038","ordinal":39497,"en":"Showed his nature as a winged steed;"},{"id":"manas-2010:p0898:b001:l039","ordinal":39498,"en":"His mouth opened like a cavernous maw,"},{"id":"manas-2010:p0898:b001:l040","ordinal":39499,"en":"And white foam mingled with blood"},{"id":"manas-2010:p0898:b001:l041","ordinal":39500,"en":"Scattered over his chest."},{"id":"manas-2010:p0898:b001:l042","ordinal":39501,"en":"Then your elder Bakay,"},{"id":"manas-2010:p0899:b001:l001","ordinal":39502,"en":"Driving him in mighty bounds,"},{"id":"manas-2010:p0899:b001:l002","ordinal":39503,"en":"His chest-length protective coat"},{"id":"manas-2010:p0899:b001:l003","ordinal":39504,"en":"Streaming out behind his back,"},{"id":"manas-2010:p0899:b001:l004","ordinal":39505,"en":"Toward Chubak fleeing in confusion,"},{"id":"manas-2010:p0899:b001:l005","ordinal":39506,"en":"Toward that helpless dear fellow,"},{"id":"manas-2010:p0899:b001:l006","ordinal":39507,"en":"Your elder, lion Bakay,"},{"id":"manas-2010:p0899:b001:l007","ordinal":39508,"en":"Arrived before an arrow could."},{"id":"manas-2010:p0899:b001:l008","ordinal":39509,"en":"Where he reached Chubak,"},{"id":"manas-2010:p0899:b001:l009","ordinal":39510,"en":"He caught and seized him as he passed:"},{"id":"manas-2010:p0899:b001:l010","ordinal":39511,"en":"“Oh, my child, born in broad Alay,"},{"id":"manas-2010:p0899:b001:l011","ordinal":39512,"en":"Where ears have heard and eyes have seen,"},{"id":"manas-2010:p0899:b001:l012","ordinal":39513,"en":"You have raised uproar in the land;"},{"id":"manas-2010:p0899:b001:l013","ordinal":39514,"en":"Finding no mountain to charge,"},{"id":"manas-2010:p0899:b001:l014","ordinal":39515,"en":"Finding no enemy to fight,"},{"id":"manas-2010:p0899:b001:l015","ordinal":39516,"en":"Never cowed when entering combat—"},{"id":"manas-2010:p0899:b001:l016","ordinal":39517,"en":"Noble Chubak, are you well?"},{"id":"manas-2010:p0899:b001:l017","ordinal":39518,"en":"For whose feast ninety beasts were slaughtered,"},{"id":"manas-2010:p0899:b001:l018","ordinal":39519,"en":"Who was given the name Chubak—"},{"id":"manas-2010:p0899:b001:l019","ordinal":39520,"en":"Lion Chubak, are you well?"},{"id":"manas-2010:p0899:b001:l020","ordinal":39521,"en":"All the world—"},{"id":"manas-2010:p0899:b001:l021","ordinal":39522,"en":"Chubak who has trodden it, are you well?"},{"id":"manas-2010:p0899:b001:l022","ordinal":39523,"en":"Besieging Kashgar and taking six,"},{"id":"manas-2010:p0899:b001:l023","ordinal":39524,"en":"Truly bringing humiliation to Kokand,"},{"id":"manas-2010:p0899:b001:l024","ordinal":39525,"en":"The finest among sixty,"},{"id":"manas-2010:p0899:b001:l025","ordinal":39526,"en":"The mightiest of forty champions,"},{"id":"manas-2010:p0899:b001:l026","ordinal":39527,"en":"The strongest of all giants—"},{"id":"manas-2010:p0899:b001:l027","ordinal":39528,"en":"Hero Chubak, are you well?"},{"id":"manas-2010:p0899:b001:l028","ordinal":39529,"en":"Finding no mountain to charge,"},{"id":"manas-2010:p0899:b001:l029","ordinal":39530,"en":"You went to besiege Burar."},{"id":"manas-2010:p0899:b001:l030","ordinal":39531,"en":"Finding no foe to fight,"},{"id":"manas-2010:p0899:b001:l031","ordinal":39532,"en":"Left helpless on the plain,"},{"id":"manas-2010:p0899:b001:l032","ordinal":39533,"en":"Alarmed Chubak, are you well?"},{"id":"manas-2010:p0899:b001:l033","ordinal":39534,"en":"From Temirkan's daughter"},{"id":"manas-2010:p0899:b001:l034","ordinal":39535,"en":"Fleeing Chubak, are you well?"},{"id":"manas-2010:p0899:b001:l035","ordinal":39536,"en":"I asked about your origins"},{"id":"manas-2010:p0899:b001:l036","ordinal":39537,"en":"And heard from those who know."},{"id":"manas-2010:p0899:b001:l037","ordinal":39538,"en":"Wearing out horses, scouting the land,"},{"id":"manas-2010:p0899:b001:l038","ordinal":39539,"en":"Releasing hounds and flying hawks,"},{"id":"manas-2010:p0899:b001:l039","ordinal":39540,"en":"I set out expressly to look for you."},{"id":"manas-2010:p0899:b001:l040","ordinal":39541,"en":"This is what I say—agree to it:"},{"id":"manas-2010:p0899:b001:l041","ordinal":39542,"en":"An only son born to his father,"},{"id":"manas-2010:p0899:b001:l042","ordinal":39543,"en":"Against the Black Kalmyks and the Manzhuu,"},{"id":"manas-2010:p0900:b001:l001","ordinal":39544,"en":"Who has raised a mighty uproar—"},{"id":"manas-2010:p0900:b001:l002","ordinal":39545,"en":"To greathearted Lord Manas"},{"id":"manas-2010:p0900:b001:l003","ordinal":39546,"en":"Give your support."},{"id":"manas-2010:p0900:b001:l004","ordinal":39547,"en":"Keep a royal court and be khan,"},{"id":"manas-2010:p0900:b001:l005","ordinal":39548,"en":"Become a man firmly established,"},{"id":"manas-2010:p0900:b001:l006","ordinal":39549,"en":"Go and settle in Talas;"},{"id":"manas-2010:p0900:b001:l007","ordinal":39550,"en":"Become a support and shelter"},{"id":"manas-2010:p0900:b001:l008","ordinal":39551,"en":"For Manas, Jakyp's only son."},{"id":"manas-2010:p0900:b001:l009","ordinal":39552,"en":"No ridge will remain unswept,"},{"id":"manas-2010:p0900:b001:l010","ordinal":39553,"en":"No people will remain unsubdued."},{"id":"manas-2010:p0900:b001:l011","ordinal":39554,"en":"To him whose fortunes are complete,"},{"id":"manas-2010:p0900:b001:l012","ordinal":39555,"en":"Your lion Manas, be a companion!"},{"id":"manas-2010:p0900:b001:l013","ordinal":39556,"en":"Hearing word from Aykojo,"},{"id":"manas-2010:p0900:b001:l014","ordinal":39557,"en":"That Akbaltay's Chubak"},{"id":"manas-2010:p0900:b001:l015","ordinal":39558,"en":"Had arisen as a lion,"},{"id":"manas-2010:p0900:b001:l016","ordinal":39559,"en":"Created by God Most High,"},{"id":"manas-2010:p0900:b001:l017","ordinal":39560,"en":"I tell myself I have no regret."},{"id":"manas-2010:p0900:b001:l018","ordinal":39561,"en":"Chubak, son of Khan Baltay,"},{"id":"manas-2010:p0900:b001:l019","ordinal":39562,"en":"My lion-born champion,"},{"id":"manas-2010:p0900:b001:l020","ordinal":39563,"en":"You have appeared before my eyes!"},{"id":"manas-2010:p0900:b001:l021","ordinal":39564,"en":"If you ask about me,"},{"id":"manas-2010:p0900:b001:l022","ordinal":39565,"en":"I am that saintly old man,"},{"id":"manas-2010:p0900:b001:l023","ordinal":39566,"en":"Khan Manas's confidant;"},{"id":"manas-2010:p0900:b001:l024","ordinal":39567,"en":"I am leopard Bakay, the watchful eye,"},{"id":"manas-2010:p0900:b001:l025","ordinal":39568,"en":"Perhaps you have heard of me:"},{"id":"manas-2010:p0900:b001:l026","ordinal":39569,"en":"I am the khan's son himself."},{"id":"manas-2010:p0900:b001:l027","ordinal":39570,"en":"If you will be a companion, here is land;"},{"id":"manas-2010:p0900:b001:l028","ordinal":39571,"en":"If you will meet him, here is lion Manas."},{"id":"manas-2010:p0900:b001:l029","ordinal":39572,"en":"Who can recognize your knowledge,"},{"id":"manas-2010:p0900:b001:l030","ordinal":39573,"en":"Here am I, knowledgeable Bakay;"},{"id":"manas-2010:p0900:b001:l031","ordinal":39574,"en":"Who knows the tongues of seventy tribes,"},{"id":"manas-2010:p0900:b001:l032","ordinal":39575,"en":"Here too is your accomplished Ajy."},{"id":"manas-2010:p0900:b001:l033","ordinal":39576,"en":"Mare's milk by day, girls by night—"},{"id":"manas-2010:p0900:b001:l034","ordinal":39577,"en":"Here are the Kyrgyz people, if you will settle!"},{"id":"manas-2010:p0900:b001:l035","ordinal":39578,"en":"For Chubak, son of Akbaltay,"},{"id":"manas-2010:p0900:b001:l036","ordinal":39579,"en":"Seen in a dream, filled with great longing,"},{"id":"manas-2010:p0900:b001:l037","ordinal":39580,"en":"Here is lion Manas, if you will meet him!"},{"id":"manas-2010:p0900:b001:l038","ordinal":39581,"en":"Who can discover what troubles you,"},{"id":"manas-2010:p0900:b001:l039","ordinal":39582,"en":"Here am I, laughing Bakay!"},{"id":"manas-2010:p0900:b001:l040","ordinal":39583,"en":"You are my lion, my mighty one;"},{"id":"manas-2010:p0900:b001:l041","ordinal":39584,"en":"Wearing out horses and scouting the land,"},{"id":"manas-2010:p0900:b001:l042","ordinal":39585,"en":"You are the warrior I came expressly to meet.”"},{"id":"manas-2010:p0901:b001:l001","ordinal":39586,"en":"He had just finished speaking;"},{"id":"manas-2010:p0901:b001:l002","ordinal":39587,"en":"When he looked this way,"},{"id":"manas-2010:p0901:b001:l003","ordinal":39588,"en":"Looming upon the great Dun Horse,"},{"id":"manas-2010:p0901:b001:l004","ordinal":39589,"en":"Drawing the heart at the sight,"},{"id":"manas-2010:p0901:b001:l005","ordinal":39590,"en":"Showing his wolf-maned aspect,"},{"id":"manas-2010:p0901:b001:l006","ordinal":39591,"en":"From one side Manas"},{"id":"manas-2010:p0901:b001:l007","ordinal":39592,"en":"Himself appeared in view."},{"id":"manas-2010:p0901:b001:l008","ordinal":39593,"en":"His face was like buttered wheat,"},{"id":"manas-2010:p0901:b001:l009","ordinal":39594,"en":"His eyes like dusky mist,"},{"id":"manas-2010:p0901:b001:l010","ordinal":39595,"en":"As huge as a mountain,"},{"id":"manas-2010:p0901:b001:l011","ordinal":39596,"en":"As though he would devour whoever appeared;"},{"id":"manas-2010:p0901:b001:l012","ordinal":39597,"en":"Wide-mouthed, cliff-browed,"},{"id":"manas-2010:p0901:b001:l013","ordinal":39598,"en":"His heroism was extraordinary,"},{"id":"manas-2010:p0901:b001:l014","ordinal":39599,"en":"His strength immense."},{"id":"manas-2010:p0901:b001:l015","ordinal":39600,"en":"As soon as he saw Manas,"},{"id":"manas-2010:p0901:b001:l016","ordinal":39601,"en":"Bending his knees toward the earth,"},{"id":"manas-2010:p0901:b001:l017","ordinal":39602,"en":"From Kögala's back"},{"id":"manas-2010:p0901:b001:l018","ordinal":39603,"en":"He leaped down in haste."},{"id":"manas-2010:p0901:b001:l019","ordinal":39604,"en":"Wolf-maned Chubak then"},{"id":"manas-2010:p0901:b001:l020","ordinal":39605,"en":"Turned Kögala's head,"},{"id":"manas-2010:p0901:b001:l021","ordinal":39606,"en":"And before the wolf-maned hero"},{"id":"manas-2010:p0901:b001:l022","ordinal":39607,"en":"Stood offering a greeting."},{"id":"manas-2010:p0901:b001:l023","ordinal":39608,"en":"All regret was dispelled;"},{"id":"manas-2010:p0901:b001:l024","ordinal":39609,"en":"Through hero Bakay's mediation,"},{"id":"manas-2010:p0901:b001:l025","ordinal":39610,"en":"For your lion Manas,"},{"id":"manas-2010:p0901:b001:l026","ordinal":39611,"en":"Chubak, son of Akbaltay,"},{"id":"manas-2010:p0901:b001:l027","ordinal":39612,"en":"Was found upon the open plain."},{"id":"manas-2010:p0901:b001:l028","ordinal":39613,"en":"Five sets of nine, headed by a mare,"},{"id":"manas-2010:p0901:b001:l029","ordinal":39614,"en":"They sacrificed to Baabedin."},{"id":"manas-2010:p0901:b001:l030","ordinal":39615,"en":"They chewed white wheat flour,"},{"id":"manas-2010:p0901:b001:l031","ordinal":39616,"en":"And swore upon the holy Quran."},{"id":"manas-2010:p0901:b001:l032","ordinal":39617,"en":"Manas and the hero Chubak"},{"id":"manas-2010:p0901:b001:l033","ordinal":39618,"en":"Became sworn friends."},{"id":"manas-2010:p0901:b001:l034","ordinal":39619,"en":"Like the hairs of a white antelope,"},{"id":"manas-2010:p0901:b001:l035","ordinal":39620,"en":"They stood drawn together;"},{"id":"manas-2010:p0901:b001:l036","ordinal":39621,"en":"Like white wheat flour,"},{"id":"manas-2010:p0901:b001:l037","ordinal":39622,"en":"They stood kneaded into one."},{"id":"manas-2010:p0901:b001:l038","ordinal":39623,"en":"Four groups of stars moved overhead;"},{"id":"manas-2010:p0901:b001:l039","ordinal":39624,"en":"The lord and his companion"},{"id":"manas-2010:p0901:b001:l040","ordinal":39625,"en":"Dismounted on the plain and became friends:"},{"id":"manas-2010:p0901:b001:l041","ordinal":39626,"en":"To scout together,"},{"id":"manas-2010:p0901:b001:l042","ordinal":39627,"en":"To take horses from people of an unknown tongue,"},{"id":"manas-2010:p0902:b001:l001","ordinal":39628,"en":"To endure when struck by a matchlock,"},{"id":"manas-2010:p0902:b001:l002","ordinal":39629,"en":"To die when death arrived."},{"id":"manas-2010:p0902:b001:l003","ordinal":39630,"en":"First considering the affair,"},{"id":"manas-2010:p0902:b001:l004","ordinal":39631,"en":"Of the six sharp blades descended from heaven,"},{"id":"manas-2010:p0902:b001:l005","ordinal":39632,"en":"Zulpukor, which Manas had received—"},{"id":"manas-2010:p0902:b001:l006","ordinal":39633,"en":"They licked Zulpukor's edge."},{"id":"manas-2010:p0902:b001:l007","ordinal":39634,"en":"Speaking thus together,"},{"id":"manas-2010:p0902:b001:l008","ordinal":39635,"en":"They made their promise firm:"},{"id":"manas-2010:p0902:b001:l009","ordinal":39636,"en":"To endure suffering together,"},{"id":"manas-2010:p0902:b001:l010","ordinal":39637,"en":"To die when death arrived."},{"id":"manas-2010:p0902:b001:l011","ordinal":39638,"en":"They made a binding pledge"},{"id":"manas-2010:p0902:b001:l012","ordinal":39639,"en":"And agreed to its terms, they say."},{"id":"manas-2010:p0902:b001:l013","ordinal":39640,"en":"The unity of forty companions"},{"id":"manas-2010:p0902:b001:l014","ordinal":39641,"en":"They gave to Khan Chubak, they say."},{"id":"manas-2010:p0902:b001:l015","ordinal":39642,"en":"“My child Chubak, leopard,"},{"id":"manas-2010:p0902:b001:l016","ordinal":39643,"en":"The Khangay are on your flank;"},{"id":"manas-2010:p0902:b001:l017","ordinal":39644,"en":"You have many foes to fight."},{"id":"manas-2010:p0902:b001:l018","ordinal":39645,"en":"When scouting is needed, scout yourself;"},{"id":"manas-2010:p0902:b001:l019","ordinal":39646,"en":"The responsibility for forty companions"},{"id":"manas-2010:p0902:b001:l020","ordinal":39647,"en":"Now take upon yourself, Chubak!"},{"id":"manas-2010:p0902:b001:l021","ordinal":39648,"en":"Scout with willingness;"},{"id":"manas-2010:p0902:b001:l022","ordinal":39649,"en":"For the champions come from forty lands,"},{"id":"manas-2010:p0902:b001:l023","ordinal":39650,"en":"Whether blame or merit falls to you,"},{"id":"manas-2010:p0902:b001:l024","ordinal":39651,"en":"Take responsibility yourself."},{"id":"manas-2010:p0902:b001:l025","ordinal":39652,"en":"There are those preparing and exchanging winks;"},{"id":"manas-2010:p0902:b001:l026","ordinal":39653,"en":"There are foes to press you from the flank."},{"id":"manas-2010:p0902:b001:l027","ordinal":39654,"en":"Many are the dark, ridged mountains;"},{"id":"manas-2010:p0902:b001:l028","ordinal":39655,"en":"Many are the foes to fight;"},{"id":"manas-2010:p0902:b001:l029","ordinal":39656,"en":"Many are the peoples to subdue;"},{"id":"manas-2010:p0902:b001:l030","ordinal":39657,"en":"Many are the mortals who will enter combat."},{"id":"manas-2010:p0902:b001:l031","ordinal":39658,"en":"If an enemy comes out to fight,"},{"id":"manas-2010:p0902:b001:l032","ordinal":39659,"en":"Shout and bring slaughter!"},{"id":"manas-2010:p0902:b001:l033","ordinal":39660,"en":"All the blame and all the merit,"},{"id":"manas-2010:p0902:b001:l034","ordinal":39661,"en":"For these forty companions standing here,"},{"id":"manas-2010:p0902:b001:l035","ordinal":39662,"en":"Take responsibility, Chubak!"},{"id":"manas-2010:p0902:b001:l036","ordinal":39663,"en":"You were Akbaltay's son,"},{"id":"manas-2010:p0902:b001:l037","ordinal":39664,"en":"And I was Jakyp's son."},{"id":"manas-2010:p0902:b001:l038","ordinal":39665,"en":"Leave my file and take my whetstone;"},{"id":"manas-2010:p0902:b001:l039","ordinal":39666,"en":"Leave my two and take my one!"},{"id":"manas-2010:p0902:b001:l040","ordinal":39667,"en":"Choose a horse from my herds and take it;"},{"id":"manas-2010:p0902:b001:l041","ordinal":39668,"en":"Pour my blood into a leather flask and take it!"},{"id":"manas-2010:p0902:b001:l042","ordinal":39669,"en":"I may give myself in devotion to God:"},{"id":"manas-2010:p0903:b001:l001","ordinal":39670,"en":"Now my anxiety has gone."},{"id":"manas-2010:p0903:b001:l002","ordinal":39671,"en":"Akbaltay's champion"},{"id":"manas-2010:p0903:b001:l003","ordinal":39672,"en":"You have now placed in my hands;"},{"id":"manas-2010:p0903:b001:l004","ordinal":39673,"en":"My beloved God!"},{"id":"manas-2010:p0903:b001:l005","ordinal":39674,"en":"Chubak was found on the plain;"},{"id":"manas-2010:p0903:b001:l006","ordinal":39675,"en":"What a fortunate man I am!"},{"id":"manas-2010:p0903:b001:l007","ordinal":39676,"en":"Grateful to God,"},{"id":"manas-2010:p0903:b001:l008","ordinal":39677,"en":"Lion Lord Manas's"},{"id":"manas-2010:p0903:b001:l009","ordinal":39678,"en":"Single self had become five."},{"id":"manas-2010:p0903:b001:l010","ordinal":39679,"en":"'How mighty my Chubak is,'"},{"id":"manas-2010:p0903:b001:l011","ordinal":39680,"en":"I knew long ago."}]
