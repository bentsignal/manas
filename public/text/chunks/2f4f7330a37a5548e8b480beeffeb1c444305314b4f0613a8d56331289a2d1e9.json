[{"id":"semetey-1-2013:p1280:b003:l014","ordinal":174849,"en":"They fought a monstrous battle,"},{"id":"semetey-1-2013:p1280:b003:l015","ordinal":174850,"en":"Standing face-to-face,"},{"id":"semetey-1-2013:p1280:b003:l016","ordinal":174851,"en":"And fought amid peril."},{"id":"semetey-1-2013:p1280:b003:l017","ordinal":174852,"en":"Let us leave that there;"},{"id":"semetey-1-2013:p1280:b003:l018","ordinal":174853,"en":"His white turban was cauldron-sized,"},{"id":"semetey-1-2013:p1280:b003:l019","ordinal":174854,"en":"And when he shouted his voice rang like the azan—"},{"id":"semetey-1-2013:p1280:b003:l020","ordinal":174855,"en":"Let us begin the tale of Akun:"},{"id":"semetey-1-2013:p1280:b003:l021","ordinal":174856,"en":"With his beard grown white,"},{"id":"semetey-1-2013:p1280:b003:l022","ordinal":174857,"en":"While strength for the journey remained,"},{"id":"semetey-1-2013:p1280:b003:l023","ordinal":174858,"en":"Khan Akun longed for the spear-fight."},{"id":"semetey-1-2013:p1280:b003:l024","ordinal":174859,"en":"He summoned the elders of the people"},{"id":"semetey-1-2013:p1280:b003:l025","ordinal":174860,"en":"And gathered them all."},{"id":"semetey-1-2013:p1280:b003:l026","ordinal":174861,"en":"Crying like a young goose,"},{"id":"semetey-1-2013:p1280:b003:l027","ordinal":174862,"en":"Hero Akun said:"},{"id":"semetey-1-2013:p1280:b003:l028","ordinal":174863,"en":"\"Let us elders gather;"},{"id":"semetey-1-2013:p1280:b003:l029","ordinal":174864,"en":"For hero Manas the lion,"},{"id":"semetey-1-2013:p1280:b003:l030","ordinal":174865,"en":"Let all of us be slain!"},{"id":"semetey-1-2013:p1280:b003:l031","ordinal":174866,"en":"He was a leopard, he was a lion;"},{"id":"semetey-1-2013:p1280:b003:l032","ordinal":174867,"en":"Your Manas who passed away"},{"id":"semetey-1-2013:p1280:b003:l033","ordinal":174868,"en":"Was a black-gray-wolf hero."},{"id":"semetey-1-2013:p1280:b003:l034","ordinal":174869,"en":"The Almighty who creates life"},{"id":"semetey-1-2013:p1280:b003:l035","ordinal":174870,"en":"Will never soon grant"},{"id":"semetey-1-2013:p1280:b003:l036","ordinal":174871,"en":"Another gray wolf like Manas."},{"id":"semetey-1-2013:p1280:b003:l037","ordinal":174872,"en":"The handful of Muslims—"},{"id":"semetey-1-2013:p1280:b003:l038","ordinal":174873,"en":"Fighting the teeming Black infidels,"},{"id":"semetey-1-2013:p1280:b003:l039","ordinal":174874,"en":"He was the hero"},{"id":"semetey-1-2013:p1280:b004:l001","ordinal":174875,"en":"Who set them free."},{"id":"semetey-1-2013:p1280:b004:l002","ordinal":174876,"en":"In Manas's absence,"},{"id":"semetey-1-2013:p1280:b004:l003","ordinal":174877,"en":"The swarming descendants"},{"id":"semetey-1-2013:p1280:b004:l004","ordinal":174878,"en":"Of Kakanchin's Beijing"},{"id":"semetey-1-2013:p1280:b004:l005","ordinal":174879,"en":"Occupied the face of the earth."},{"id":"semetey-1-2013:p1280:b004:l006","ordinal":174880,"en":"Alöökö from Margalang"},{"id":"semetey-1-2013:p1280:b004:l007","ordinal":174881,"en":"Targeted the common people in his hand,"},{"id":"semetey-1-2013:p1280:b004:l008","ordinal":174882,"en":"The Muslims."},{"id":"semetey-1-2013:p1280:b004:l009","ordinal":174883,"en":"The proof that he targeted them was this:"},{"id":"semetey-1-2013:p1280:b004:l010","ordinal":174884,"en":"In the days of Khan Alöökö,"},{"id":"semetey-1-2013:p1280:b004:l011","ordinal":174885,"en":"He exacted tribute in girls;"},{"id":"semetey-1-2013:p1280:b004:l012","ordinal":174886,"en":"Whoever resisted"},{"id":"semetey-1-2013:p1280:b004:l013","ordinal":174887,"en":"He seized then"},{"id":"semetey-1-2013:p1280:b004:l014","ordinal":174888,"en":"And slaughtered as a sacrifice."},{"id":"semetey-1-2013:p1280:b004:l015","ordinal":174889,"en":"He humiliated many,"},{"id":"semetey-1-2013:p1280:b004:l016","ordinal":174890,"en":"Dragged them along the road,"},{"id":"semetey-1-2013:p1280:b004:l017","ordinal":174891,"en":"And had the Dangyts tear them apart."},{"id":"semetey-1-2013:p1280:b004:l018","ordinal":174892,"en":"He collected tribute in gold;"},{"id":"semetey-1-2013:p1280:b004:l019","ordinal":174893,"en":"The handful of Muslims"},{"id":"semetey-1-2013:p1280:b004:l020","ordinal":174894,"en":"Were counted neither among the living"},{"id":"semetey-1-2013:p1280:b004:l021","ordinal":174895,"en":"Nor found among the dead."},{"id":"semetey-1-2013:p1280:b004:l022","ordinal":174896,"en":"Unable to find any recourse,"},{"id":"semetey-1-2013:p1280:b004:l023","ordinal":174897,"en":"The people remained wailing;"},{"id":"semetey-1-2013:p1280:b004:l024","ordinal":174898,"en":"He brought turmoil"},{"id":"semetey-1-2013:p1280:b004:l025","ordinal":174899,"en":"Upon the sons of the Muslims."},{"id":"semetey-1-2013:p1280:b004:l026","ordinal":174900,"en":"No one dared answer him;"},{"id":"semetey-1-2013:p1280:b004:l027","ordinal":174901,"en":"In Manas's absence,"},{"id":"semetey-1-2013:p1280:b004:l028","ordinal":174902,"en":"The people remained crying out."},{"id":"semetey-1-2013:p1280:b004:l029","ordinal":174903,"en":"We saw Alöökö—"},{"id":"semetey-1-2013:p1280:b004:l030","ordinal":174904,"en":"Of the wrestlers he gathered,"},{"id":"semetey-1-2013:p1280:b004:l031","ordinal":174905,"en":"Whoever provoked his anger"},{"id":"semetey-1-2013:p1280:b004:l032","ordinal":174906,"en":"Was subjected to surpassing torment."},{"id":"semetey-1-2013:p1280:b004:l033","ordinal":174907,"en":"He established a chamber of wonders,"},{"id":"semetey-1-2013:p1280:b004:l034","ordinal":174908,"en":"Where a dragon coiled."},{"id":"semetey-1-2013:p1280:b004:l035","ordinal":174909,"en":"Unable to withstand his wrath,"},{"id":"semetey-1-2013:p1280:b004:l036","ordinal":174910,"en":"Sleeping children awoke."},{"id":"semetey-1-2013:p1280:b004:l037","ordinal":174911,"en":"He demanded Margalang;"},{"id":"semetey-1-2013:p1280:b004:l038","ordinal":174912,"en":"Coming then from Beijing,"},{"id":"semetey-1-2013:p1280:b004:l039","ordinal":174913,"en":"A khan named Alöökö emerged,"},{"id":"semetey-1-2013:p1281:b003:l001","ordinal":174914,"en":"No soul could endure his judgment;"},{"id":"semetey-1-2013:p1281:b003:l002","ordinal":174915,"en":"Life left them at the sound of his voice."},{"id":"semetey-1-2013:p1281:b003:l003","ordinal":174916,"en":"Khan Alöökö was incorrigible;"},{"id":"semetey-1-2013:p1281:b003:l004","ordinal":174917,"en":"He had a fortress built"},{"id":"semetey-1-2013:p1281:b003:l005","ordinal":174918,"en":"And installed his marvel within it."},{"id":"semetey-1-2013:p1281:b003:l006","ordinal":174919,"en":"He unleashed extraordinary turmoil and strife;"},{"id":"semetey-1-2013:p1281:b003:l007","ordinal":174920,"en":"That Alöökö was incorrigible,"},{"id":"semetey-1-2013:p1281:b003:l008","ordinal":174921,"en":"And no one could answer back"},{"id":"semetey-1-2013:p1281:b003:l009","ordinal":174922,"en":"To Alöökö himself."},{"id":"semetey-1-2013:p1281:b003:l010","ordinal":174923,"en":"Again and again he seized people,"},{"id":"semetey-1-2013:p1281:b003:l011","ordinal":174924,"en":"And then cast those"},{"id":"semetey-1-2013:p1281:b003:l012","ordinal":174925,"en":"Who fell into his hands"},{"id":"semetey-1-2013:p1281:b003:l013","ordinal":174926,"en":"Into his forty-rope-deep pit."},{"id":"semetey-1-2013:p1281:b003:l014","ordinal":174927,"en":"He delivered the Muslims' punishment"},{"id":"semetey-1-2013:p1281:b003:l015","ordinal":174928,"en":"Into their own hands;"},{"id":"semetey-1-2013:p1281:b003:l016","ordinal":174929,"en":"Many people were caught"},{"id":"semetey-1-2013:p1281:b003:l017","ordinal":174930,"en":"In Alöökö's net."},{"id":"semetey-1-2013:p1281:b003:l018","ordinal":174931,"en":"The peoples of the world gathered;"},{"id":"semetey-1-2013:p1281:b003:l019","ordinal":174932,"en":"Innocent common folk"},{"id":"semetey-1-2013:p1281:b003:l020","ordinal":174933,"en":"Were persecuted and slaughtered."},{"id":"semetey-1-2013:p1281:b003:l021","ordinal":174934,"en":"When Alöökö brought suffering"},{"id":"semetey-1-2013:p1281:b003:l022","ordinal":174935,"en":"And seized control of the people,"},{"id":"semetey-1-2013:p1281:b003:l023","ordinal":174936,"en":"Hero Manas reached fifteen,"},{"id":"semetey-1-2013:p1281:b003:l024","ordinal":174937,"en":"Having been born and raised in Altai."},{"id":"semetey-1-2013:p1281:b003:l025","ordinal":174938,"en":"Everything he undertook prospered;"},{"id":"semetey-1-2013:p1281:b003:l026","ordinal":174939,"en":"He grew to maturity as a hero,"},{"id":"semetey-1-2013:p1281:b003:l027","ordinal":174940,"en":"The equal of any hero's son."},{"id":"semetey-1-2013:p1281:b003:l028","ordinal":174941,"en":"He struck and opened a road"},{"id":"semetey-1-2013:p1281:b003:l029","ordinal":174942,"en":"Through the stone house from which Alöökö ruled,"},{"id":"semetey-1-2013:p1281:b003:l030","ordinal":174943,"en":"And brought Alöökö to humiliation."},{"id":"semetey-1-2013:p1281:b003:l031","ordinal":174944,"en":"When he trod upon"},{"id":"semetey-1-2013:p1281:b003:l032","ordinal":174945,"en":"The lordly Alöökö's head,"},{"id":"semetey-1-2013:p1281:b003:l033","ordinal":174946,"en":"He seized ten thousand treasures;"},{"id":"semetey-1-2013:p1281:b003:l034","ordinal":174947,"en":"When he scattered them among the common people,"},{"id":"semetey-1-2013:p1281:b003:l035","ordinal":174948,"en":"Alöökö, who was a sorcerer,"},{"id":"semetey-1-2013:p1281:b003:l036","ordinal":174949,"en":"Fled toward Beijing."},{"id":"semetey-1-2013:p1281:b003:l037","ordinal":174950,"en":"Manas the leopard from afar"},{"id":"semetey-1-2013:p1281:b003:l038","ordinal":174951,"en":"Placed grass upon his yellow trail,"},{"id":"semetey-1-2013:p1281:b003:l039","ordinal":174952,"en":"Pursued him until he grew pale,"},{"id":"semetey-1-2013:p1281:b005:l001","ordinal":174953,"en":"And greased his inlaid spear;"},{"id":"semetey-1-2013:p1281:b005:l002","ordinal":174954,"en":"The infidel Alöökö"},{"id":"semetey-1-2013:p1281:b005:l003","ordinal":174955,"en":"He laid low at Kum-Aryk."},{"id":"semetey-1-2013:p1281:b005:l004","ordinal":174956,"en":"When he saw the horses gathered as tribute"},{"id":"semetey-1-2013:p1281:b005:l005","ordinal":174957,"en":"Were now booty,"},{"id":"semetey-1-2013:p1281:b005:l006","ordinal":174958,"en":"He divided all that treasure,"},{"id":"semetey-1-2013:p1281:b005:l007","ordinal":174959,"en":"Leaving nothing undistributed"},{"id":"semetey-1-2013:p1281:b005:l008","ordinal":174960,"en":"Among all the Muslims."},{"id":"semetey-1-2013:p1281:b005:l009","ordinal":174961,"en":"The Muslims, clan by clan,"},{"id":"semetey-1-2013:p1281:b005:l010","ordinal":174962,"en":"All shared it equally."},{"id":"semetey-1-2013:p1281:b005:l011","ordinal":174963,"en":"His heroism became known from this,"},{"id":"semetey-1-2013:p1281:b005:l012","ordinal":174964,"en":"And the common people called him Manas."},{"id":"semetey-1-2013:p1281:b005:l013","ordinal":174965,"en":"At Kökötöi's feast,"},{"id":"semetey-1-2013:p1281:b005:l014","ordinal":174966,"en":"Before the great gathering,"},{"id":"semetey-1-2013:p1281:b005:l015","ordinal":174967,"en":"When they were all about to meet their end,"},{"id":"semetey-1-2013:p1281:b005:l016","ordinal":174968,"en":"When the grim Black Chinese"},{"id":"semetey-1-2013:p1281:b005:l017","ordinal":174969,"en":"Were about to engulf them entirely,"},{"id":"semetey-1-2013:p1281:b005:l018","ordinal":174970,"en":"Was it not Manas"},{"id":"semetey-1-2013:p1281:b005:l019","ordinal":174971,"en":"Who brought slaughter upon the whole world?"},{"id":"semetey-1-2013:p1281:b005:l020","ordinal":174972,"en":"Was it not Manas who freed"},{"id":"semetey-1-2013:p1281:b005:l021","ordinal":174973,"en":"The handful of Muslims"},{"id":"semetey-1-2013:p1281:b005:l022","ordinal":174974,"en":"From the Chinese?"},{"id":"semetey-1-2013:p1281:b005:l023","ordinal":174975,"en":"There is no end to the tale."},{"id":"semetey-1-2013:p1281:b005:l024","ordinal":174976,"en":"At Kökötöi's feast,"},{"id":"semetey-1-2013:p1281:b005:l025","ordinal":174977,"en":"Before the great assembly,"},{"id":"semetey-1-2013:p1281:b005:l026","ordinal":174978,"en":"He loaded gold coins on eighty camels"},{"id":"semetey-1-2013:p1281:b005:l027","ordinal":174979,"en":"And formed a marriage alliance there."},{"id":"semetey-1-2013:p1281:b005:l028","ordinal":174980,"en":"With Dubaköi and the others at their head,"},{"id":"semetey-1-2013:p1281:b005:l029","ordinal":174981,"en":"Was not the blessing given?"},{"id":"semetey-1-2013:p1281:b005:l030","ordinal":174982,"en":"For the land of the Muslims,"},{"id":"semetey-1-2013:p1281:b005:l031","ordinal":174983,"en":"Was not lion Manas then"},{"id":"semetey-1-2013:p1281:b005:l032","ordinal":174984,"en":"A father?"},{"id":"semetey-1-2013:p1281:b005:l033","ordinal":174985,"en":"Did he not bring"},{"id":"semetey-1-2013:p1281:b005:l034","ordinal":174986,"en":"Relentless upheaval?"},{"id":"semetey-1-2013:p1281:b005:l035","ordinal":174987,"en":"Did not lion Manas then"},{"id":"semetey-1-2013:p1281:b005:l036","ordinal":174988,"en":"Win equality"},{"id":"semetey-1-2013:p1281:b005:l037","ordinal":174989,"en":"For the Muslims?"},{"id":"semetey-1-2013:p1281:b005:l038","ordinal":174990,"en":"Of the lion who lived so,"},{"id":"semetey-1-2013:p1281:b005:l039","ordinal":174991,"en":"Saying, \"I shall seize his daughter-in-law,\""},{"id":"semetey-1-2013:p1282:b003:l001","ordinal":174992,"en":"Look at the deeds"},{"id":"semetey-1-2013:p1282:b003:l002","ordinal":174993,"en":"Of that accursed Kojo."},{"id":"semetey-1-2013:p1282:b003:l003","ordinal":174994,"en":"I shall not submit to what he says;"},{"id":"semetey-1-2013:p1282:b003:l004","ordinal":174995,"en":"Unless I, Khan Akun, die"},{"id":"semetey-1-2013:p1282:b003:l005","ordinal":174996,"en":"And behold the face of the other world,"},{"id":"semetey-1-2013:p1282:b003:l006","ordinal":174997,"en":"I shall not give Aichürök away."},{"id":"semetey-1-2013:p1282:b003:l007","ordinal":174998,"en":"Before I give Aichürök,"},{"id":"semetey-1-2013:p1282:b003:l008","ordinal":174999,"en":"Let me behold the face of Judgment Day."},{"id":"semetey-1-2013:p1282:b003:l009","ordinal":175000,"en":"Let me die in slaughter"},{"id":"semetey-1-2013:p1282:b003:l010","ordinal":175001,"en":"At the hands of mad Kojo and Toltoi;"},{"id":"semetey-1-2013:p1282:b003:l011","ordinal":175002,"en":"Let me face in battle"},{"id":"semetey-1-2013:p1282:b003:l012","ordinal":175003,"en":"The engulfing Zhediger;"},{"id":"semetey-1-2013:p1282:b003:l013","ordinal":175004,"en":"Let me stand as a shelter"},{"id":"semetey-1-2013:p1282:b003:l014","ordinal":175005,"en":"For Manas's only son, found late in life."},{"id":"semetey-1-2013:p1282:b003:l015","ordinal":175006,"en":"I shall open the mouth of my treasury"},{"id":"semetey-1-2013:p1282:b003:l016","ordinal":175007,"en":"And scatter abundant wealth"},{"id":"semetey-1-2013:p1282:b003:l017","ordinal":175008,"en":"And ten thousand livestock for the war."},{"id":"semetey-1-2013:p1282:b003:l018","ordinal":175009,"en":"Until the pliant reeds ripen,"},{"id":"semetey-1-2013:p1282:b003:l019","ordinal":175010,"en":"Until the blossoms of the steppe grass fly,"},{"id":"semetey-1-2013:p1282:b003:l020","ordinal":175011,"en":"Let me fight fiercely for six months"},{"id":"semetey-1-2013:p1282:b003:l021","ordinal":175012,"en":"And test our strength against them."},{"id":"semetey-1-2013:p1282:b003:l022","ordinal":175013,"en":"He is no black, rugged mountain"},{"id":"semetey-1-2013:p1282:b003:l023","ordinal":175014,"en":"Which the people cannot cross;"},{"id":"semetey-1-2013:p1282:b003:l024","ordinal":175015,"en":"Chynkojo has turned black with rage,"},{"id":"semetey-1-2013:p1282:b003:l025","ordinal":175016,"en":"But he is no enemy come from the Kalmaks."},{"id":"semetey-1-2013:p1282:b003:l026","ordinal":175017,"en":"He is no mountain with high cliffs;"},{"id":"semetey-1-2013:p1282:b003:l027","ordinal":175018,"en":"This accursed Toltoi"},{"id":"semetey-1-2013:p1282:b003:l028","ordinal":175019,"en":"Is no enemy come from China."},{"id":"semetey-1-2013:p1282:b003:l029","ordinal":175020,"en":"Saying he will marry a girl with in-laws,"},{"id":"semetey-1-2013:p1282:b003:l030","ordinal":175021,"en":"Saying he will unleash an upheaval,"},{"id":"semetey-1-2013:p1282:b003:l031","ordinal":175022,"en":"Accursed Toltoi has lost his senses."},{"id":"semetey-1-2013:p1282:b003:l032","ordinal":175023,"en":"While this worthy head remains,"},{"id":"semetey-1-2013:p1282:b003:l033","ordinal":175024,"en":"How can I surrender my child?"},{"id":"semetey-1-2013:p1282:b003:l034","ordinal":175025,"en":"The Zhediger have grown covetous;"},{"id":"semetey-1-2013:p1282:b003:l035","ordinal":175026,"en":"Let me try bringing ruin upon them."},{"id":"semetey-1-2013:p1282:b003:l036","ordinal":175027,"en":"While this dear head remains,"},{"id":"semetey-1-2013:p1282:b003:l037","ordinal":175028,"en":"How can I surrender my people?"},{"id":"semetey-1-2013:p1282:b003:l038","ordinal":175029,"en":"This swine has turned black with rage;"},{"id":"semetey-1-2013:p1282:b003:l039","ordinal":175030,"en":"Let me test myself against him.\""},{"id":"semetey-1-2013:p1282:b004:l001","ordinal":175031,"en":"He said this to the great people,"},{"id":"semetey-1-2013:p1282:b004:l002","ordinal":175032,"en":"Speaking horrors for the common folk to hear;"},{"id":"semetey-1-2013:p1282:b004:l003","ordinal":175033,"en":"He raised the pale-mottled banner,"},{"id":"semetey-1-2013:p1282:b004:l004","ordinal":175034,"en":"Shouted the cry of \"Khan Akun!\""},{"id":"semetey-1-2013:p1282:b004:l005","ordinal":175035,"en":"And his heroes formed a separate band,"},{"id":"semetey-1-2013:p1282:b004:l006","ordinal":175036,"en":"Going in apart—did you see?"},{"id":"semetey-1-2013:p1282:b004:l007","ordinal":175037,"en":"Their khan, hero Khan Akun,"},{"id":"semetey-1-2013:p1282:b004:l008","ordinal":175038,"en":"Gave courage to them all"},{"id":"semetey-1-2013:p1282:b004:l009","ordinal":175039,"en":"And advanced to face the foe—did you see?"},{"id":"semetey-1-2013:p1282:b004:l010","ordinal":175040,"en":"The renowned men were in front,"},{"id":"semetey-1-2013:p1282:b004:l011","ordinal":175041,"en":"The valiant men at the flanks;"},{"id":"semetey-1-2013:p1282:b004:l012","ordinal":175042,"en":"The fearsome men were in front,"},{"id":"semetey-1-2013:p1282:b004:l013","ordinal":175043,"en":"The lions at the flanks."},{"id":"semetey-1-2013:p1282:b004:l014","ordinal":175044,"en":"Akun went out to war,"},{"id":"semetey-1-2013:p1282:b004:l015","ordinal":175045,"en":"To face the peril,"},{"id":"semetey-1-2013:p1282:b004:l016","ordinal":175046,"en":"And the Zhediger who loved danger"},{"id":"semetey-1-2013:p1282:b004:l017","ordinal":175047,"en":"Set their faces toward battle."},{"id":"semetey-1-2013:p1282:b004:l018","ordinal":175048,"en":"They committed their bodies to the spear;"},{"id":"semetey-1-2013:p1282:b004:l019","ordinal":175049,"en":"They raised and leveled"},{"id":"semetey-1-2013:p1282:b004:l020","ordinal":175050,"en":"Their alengir bows and inlaid arrows."},{"id":"semetey-1-2013:p1282:b004:l021","ordinal":175051,"en":"For Aichürök's sake,"},{"id":"semetey-1-2013:p1282:b004:l022","ordinal":175052,"en":"They stood casting away their lives."},{"id":"semetey-1-2013:p1282:b004:l023","ordinal":175053,"en":"With dear Akun at their head,"},{"id":"semetey-1-2013:p1282:b004:l024","ordinal":175054,"en":"They came out of the city and drew apart;"},{"id":"semetey-1-2013:p1282:b004:l025","ordinal":175055,"en":"The Zhediger's ten-thousand-strong army"},{"id":"semetey-1-2013:p1282:b004:l026","ordinal":175056,"en":"Stood facing them head-on."},{"id":"semetey-1-2013:p1282:b004:l027","ordinal":175057,"en":"Shouting in anger,"},{"id":"semetey-1-2013:p1282:b004:l028","ordinal":175058,"en":"They threw their remaining strength into the fight,"},{"id":"semetey-1-2013:p1282:b004:l029","ordinal":175059,"en":"Swarming more thickly than worms"},{"id":"semetey-1-2013:p1282:b004:l030","ordinal":175060,"en":"And teeming like ants."},{"id":"semetey-1-2013:p1282:b004:l031","ordinal":175061,"en":"Their banners stood apart;"},{"id":"semetey-1-2013:p1282:b004:l032","ordinal":175062,"en":"The Zhediger and the Afghans"},{"id":"semetey-1-2013:p1282:b004:l033","ordinal":175063,"en":"Faced each other as though to devour one another."},{"id":"semetey-1-2013:p1282:b004:l034","ordinal":175064,"en":"Standing without coming close,"},{"id":"semetey-1-2013:p1282:b004:l035","ordinal":175065,"en":"They fought with guns."},{"id":"semetey-1-2013:p1282:b004:l036","ordinal":175066,"en":"Unable to close and grapple,"},{"id":"semetey-1-2013:p1282:b004:l037","ordinal":175067,"en":"The two armies stood at a distance,"},{"id":"semetey-1-2013:p1282:b004:l038","ordinal":175068,"en":"Drawing bows and shooting."},{"id":"semetey-1-2013:p1282:b004:l039","ordinal":175069,"en":"They cast themselves upon the spears,"},{"id":"semetey-1-2013:p1283:b003:l001","ordinal":175070,"en":"They began a storied battle."},{"id":"semetey-1-2013:p1283:b003:l002","ordinal":175071,"en":"Standing with faces transformed,"},{"id":"semetey-1-2013:p1283:b003:l003","ordinal":175072,"en":"They leveled and thrust their spears."},{"id":"semetey-1-2013:p1283:b003:l004","ordinal":175073,"en":"Making one place their battlefield,"},{"id":"semetey-1-2013:p1283:b003:l005","ordinal":175074,"en":"They fought by turns."},{"id":"semetey-1-2013:p1283:b003:l006","ordinal":175075,"en":"They sent forth their wrestlers,"},{"id":"semetey-1-2013:p1283:b003:l007","ordinal":175076,"en":"And brought out their heroes"},{"id":"semetey-1-2013:p1283:b003:l008","ordinal":175077,"en":"To fight single combat."},{"id":"semetey-1-2013:p1283:b003:l009","ordinal":175078,"en":"From this side came one champion,"},{"id":"semetey-1-2013:p1283:b003:l010","ordinal":175079,"en":"From that side came another."},{"id":"semetey-1-2013:p1283:b003:l011","ordinal":175080,"en":"They leveled spears one against one"},{"id":"semetey-1-2013:p1283:b003:l012","ordinal":175081,"en":"And fought in single combat."},{"id":"semetey-1-2013:p1283:b003:l013","ordinal":175082,"en":"An Afghan champion"},{"id":"semetey-1-2013:p1283:b003:l014","ordinal":175083,"en":"Reached the Jediger;"},{"id":"semetey-1-2013:p1283:b003:l015","ordinal":175084,"en":"A Jediger champion"},{"id":"semetey-1-2013:p1283:b003:l016","ordinal":175085,"en":"Crushed him into the ground and passed on."},{"id":"semetey-1-2013:p1283:b003:l017","ordinal":175086,"en":"From behind, the Jediger"},{"id":"semetey-1-2013:p1283:b003:l018","ordinal":175087,"en":"Wheeled and surged over them;"},{"id":"semetey-1-2013:p1283:b003:l019","ordinal":175088,"en":"From this side, Khan Akun"},{"id":"semetey-1-2013:p1283:b003:l020","ordinal":175089,"en":"Unleashed the general battle."},{"id":"semetey-1-2013:p1283:b003:l021","ordinal":175090,"en":"Dust curled into the sky"},{"id":"semetey-1-2013:p1283:b003:l022","ordinal":175091,"en":"And poured from the melee."},{"id":"semetey-1-2013:p1283:b003:l023","ordinal":175092,"en":"Commanders of tens swept like sickles;"},{"id":"semetey-1-2013:p1283:b003:l024","ordinal":175093,"en":"Commanders of fifty barked."},{"id":"semetey-1-2013:p1283:b003:l025","ordinal":175094,"en":"Their spears jutted upward."},{"id":"semetey-1-2013:p1283:b003:l026","ordinal":175095,"en":"Commanders of hundreds ran;"},{"id":"semetey-1-2013:p1283:b003:l027","ordinal":175096,"en":"Commanders of thousands grieved."},{"id":"semetey-1-2013:p1283:b003:l028","ordinal":175097,"en":"Standards flapped,"},{"id":"semetey-1-2013:p1283:b003:l029","ordinal":175098,"en":"All the khans cried out,"},{"id":"semetey-1-2013:p1283:b003:l030","ordinal":175099,"en":"And fierce slaughter began."},{"id":"semetey-1-2013:p1283:b003:l031","ordinal":175100,"en":"Jediger and Afghan"},{"id":"semetey-1-2013:p1283:b003:l032","ordinal":175101,"en":"Met face to face."},{"id":"semetey-1-2013:p1283:b003:l033","ordinal":175102,"en":"It became a grave and perilous affair;"},{"id":"semetey-1-2013:p1283:b003:l034","ordinal":175103,"en":"They unleashed a general battle."},{"id":"semetey-1-2013:p1283:b003:l035","ordinal":175104,"en":"Before long,"}]
