d":"seytek-2012:p0845:b002:l030","ordinal":360170,"en":"May all the hills be shot,"},{"id":"seytek-2012:p0845:b002:l031","ordinal":360171,"en":"Kyrgyz people don't stop"},{"id":"seytek-2012:p0845:b002:l032","ordinal":360172,"en":"Let it disappear from Sarybay!"},{"id":"seytek-2012:p0845:b002:l033","ordinal":360173,"en":"This Kyzytalak Kyrgyz nation,"},{"id":"seytek-2012:p0845:b002:l034","ordinal":360174,"en":"Grandfather from father"},{"id":"seytek-2012:p0845:b002:l035","ordinal":360175,"en":"Grown in the field, grew in the field"},{"id":"seytek-2012:p0845:b002:l036","ordinal":360176,"en":"The Red Massacre grew in strife"},{"id":"seytek-2012:p0845:b002:l037","ordinal":360177,"en":"He did not stay in one place for three days,"},{"id":"seytek-2012:p0845:b002:l038","ordinal":360178,"en":"Wasn't it like that,"},{"id":"seytek-2012:p0845:b002:l039","ordinal":360179,"en":"Asking and not getting enough,"},{"id":"seytek-2012:p0845:b002:l040","ordinal":360180,"en":"He did not water,"},{"id":"seytek-2012:p0845:b003:l001","ordinal":360181,"en":"No face to face,"},{"id":"seytek-2012:p0845:b003:l002","ordinal":360182,"en":"Faced with no survivors."},{"id":"seytek-2012:p0845:b003:l003","ordinal":360183,"en":"Who does not turn his neck to anyone,"},{"id":"seytek-2012:p0845:b003:l004","ordinal":360184,"en":"If you see a lot of black worms"},{"id":"seytek-2012:p0845:b003:l005","ordinal":360185,"en":"The seed is abundant."},{"id":"seytek-2012:p0845:b003:l006","ordinal":360186,"en":"Anji-manji, great Kakan"},{"id":"seytek-2012:p0845:b003:l007","ordinal":360187,"en":"Beijing cried blood,"},{"id":"seytek-2012:p0845:b003:l008","ordinal":360188,"en":"Kankor Manas bar"},{"id":"seytek-2012:p0845:b003:l009","ordinal":360189,"en":"The noose is not strong."},{"id":"seytek-2012:p0845:b003:l010","ordinal":360190,"en":"The treasury is full of livestock"},{"id":"seytek-2012:p0845:b003:l011","ordinal":360191,"en":"There were forty different kinds of cattle,"},{"id":"seytek-2012:p0845:b003:l012","ordinal":360192,"en":"His father was a great khan,"}]
