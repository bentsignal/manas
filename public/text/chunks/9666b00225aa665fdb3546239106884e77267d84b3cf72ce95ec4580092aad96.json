[{"id":"semetey-1-2013:p0979:b003:l014","ordinal":151809,"en":"They came below Tört-Kül,"},{"id":"semetey-1-2013:p0979:b003:l015","ordinal":151810,"en":"To Prince Manas’s orchard,"},{"id":"semetey-1-2013:p0979:b003:l016","ordinal":151811,"en":"To the dark eye of the spring,"},{"id":"semetey-1-2013:p0979:b003:l017","ordinal":151812,"en":"To the solitary plane tree,"},{"id":"semetey-1-2013:p0979:b003:l018","ordinal":151813,"en":"To Kanykey’s encampment,"},{"id":"semetey-1-2013:p0979:b003:l019","ordinal":151814,"en":"To Chachykey’s fortress with its gate."},{"id":"semetey-1-2013:p0979:b003:l020","ordinal":151815,"en":"The boys now entered."},{"id":"semetey-1-2013:p0979:b003:l021","ordinal":151816,"en":"The two choros matched their pace;"},{"id":"semetey-1-2013:p0979:b003:l022","ordinal":151817,"en":"Unable to find a way forward,"},{"id":"semetey-1-2013:p0979:b003:l023","ordinal":151818,"en":"The boys whispered together,"},{"id":"semetey-1-2013:p0979:b003:l024","ordinal":151819,"en":"Chatted and laughed softly."},{"id":"semetey-1-2013:p0979:b003:l025","ordinal":151820,"en":"They had long known"},{"id":"semetey-1-2013:p0979:b003:l026","ordinal":151821,"en":"Their sister-in-law’s fierce temper;"},{"id":"semetey-1-2013:p0979:b003:l027","ordinal":151822,"en":"They made a firm agreement,"},{"id":"semetey-1-2013:p0979:b003:l028","ordinal":151823,"en":"And stood without exchanging blessings."},{"id":"semetey-1-2013:p0979:b003:l029","ordinal":151824,"en":"The delicate woman Chachykey"},{"id":"semetey-1-2013:p0979:b003:l030","ordinal":151825,"en":"Had a delicacy all her own,"},{"id":"semetey-1-2013:p0979:b003:l031","ordinal":151826,"en":"Her scarf like a golden amulet,"},{"id":"semetey-1-2013:p0979:b003:l032","ordinal":151827,"en":"A troubled, beautiful white brow."},{"id":"semetey-1-2013:p0979:b003:l033","ordinal":151828,"en":"No man went boldly before her;"},{"id":"semetey-1-2013:p0979:b003:l034","ordinal":151829,"en":"Whoever saw the cherished woman marveled."},{"id":"semetey-1-2013:p0979:b003:l035","ordinal":151830,"en":"No stranger entered her chamber,"},{"id":"semetey-1-2013:p0979:b003:l036","ordinal":151831,"en":"And no soul apart from Semetey"},{"id":"semetey-1-2013:p0979:b003:l037","ordinal":151832,"en":"Walked openly beside her."},{"id":"semetey-1-2013:p0979:b003:l038","ordinal":151833,"en":"Her brow was high and her venom strong—"},{"id":"semetey-1-2013:p0979:b003:l039","ordinal":151834,"en":"Do not ask about your sister-in-law’s nature."},{"id":"semetey-1-2013:p0979:b005:l001","ordinal":151835,"en":"This was one of those dark days,"},{"id":"semetey-1-2013:p0979:b005:l002","ordinal":151836,"en":"The day when her true fury was touched"},{"id":"semetey-1-2013:p0979:b005:l003","ordinal":151837,"en":"And she poured out her wrath."},{"id":"semetey-1-2013:p0979:b005:l004","ordinal":151838,"en":"No traveler came to her,"},{"id":"semetey-1-2013:p0979:b005:l005","ordinal":151839,"en":"And she received no news from me;"},{"id":"semetey-1-2013:p0979:b005:l006","ordinal":151840,"en":"This was one of those dark days."},{"id":"semetey-1-2013:p0979:b005:l007","ordinal":151841,"en":"Beside Chachykey were"},{"id":"semetey-1-2013:p0979:b005:l008","ordinal":151842,"en":"Thirty daughters-in-law and thirty girls,"},{"id":"semetey-1-2013:p0979:b005:l009","ordinal":151843,"en":"A retinue of no small splendor,"},{"id":"semetey-1-2013:p0979:b005:l010","ordinal":151844,"en":"Her attendants gathered for amusement."},{"id":"semetey-1-2013:p0979:b005:l011","ordinal":151845,"en":"Around their throats hung"},{"id":"semetey-1-2013:p0979:b005:l012","ordinal":151846,"en":"Golden earrings and amulets;"},{"id":"semetey-1-2013:p0979:b005:l013","ordinal":151847,"en":"All were stately and beautiful young women."},{"id":"semetey-1-2013:p0979:b005:l014","ordinal":151848,"en":"Semetey had a tower,"},{"id":"semetey-1-2013:p0979:b005:l015","ordinal":151849,"en":"And from the top of that tower"},{"id":"semetey-1-2013:p0979:b005:l016","ordinal":151850,"en":"Your poor sister-in-law Chachykey"},{"id":"semetey-1-2013:p0979:b005:l017","ordinal":151851,"en":"Stood keeping watch."},{"id":"semetey-1-2013:p0979:b005:l018","ordinal":151852,"en":"Realizing that Semetey was absent,"},{"id":"semetey-1-2013:p0979:b005:l019","ordinal":151853,"en":"She cried out wildly—"},{"id":"semetey-1-2013:p0979:b005:l020","ordinal":151854,"en":"God had struck the woman."},{"id":"semetey-1-2013:p0979:b005:l021","ordinal":151855,"en":"Chachykey’s forty daughters-in-law,"},{"id":"semetey-1-2013:p0979:b005:l022","ordinal":151856,"en":"All of them skilled women,"},{"id":"semetey-1-2013:p0979:b005:l023","ordinal":151857,"en":"Stood surrounding her."},{"id":"semetey-1-2013:p0979:b005:l024","ordinal":151858,"en":"Now God had struck the woman;"},{"id":"semetey-1-2013:p0979:b005:l025","ordinal":151859,"en":"The delicate Chachykey"},{"id":"semetey-1-2013:p0979:b005:l026","ordinal":151860,"en":"Spoke to the daughters-in-law:"},{"id":"semetey-1-2013:p0979:b005:l027","ordinal":151861,"en":"“The end time has surely come,” she said;"},{"id":"semetey-1-2013:p0979:b005:l028","ordinal":151862,"en":"“Badisha’s falcon"},{"id":"semetey-1-2013:p0979:b005:l029","ordinal":151863,"en":"Has apparently been taken away"},{"id":"semetey-1-2013:p0979:b005:l030","ordinal":151864,"en":"By some accursed man seeking a hero.”"},{"id":"semetey-1-2013:p0979:b005:l031","ordinal":151865,"en":"Grieving when she saw the boys,"},{"id":"semetey-1-2013:p0979:b005:l032","ordinal":151866,"en":"The delicate woman Chachykey"},{"id":"semetey-1-2013:p0979:b005:l033","ordinal":151867,"en":"Rushed down from the tower"},{"id":"semetey-1-2013:p0979:b005:l034","ordinal":151868,"en":"And came hurtling below."},{"id":"semetey-1-2013:p0979:b005:l035","ordinal":151869,"en":"“The accursed thing has led him astray"},{"id":"semetey-1-2013:p0979:b005:l036","ordinal":151870,"en":"And taken it in the end,” she said."},{"id":"semetey-1-2013:p0979:b005:l037","ordinal":151871,"en":"Her dear eyes, like a quail’s,"},{"id":"semetey-1-2013:p0979:b005:l038","ordinal":151872,"en":"Shed tears in separate streams;"},{"id":"semetey-1-2013:p0979:b005:l039","ordinal":151873,"en":"She sobbed and wept uncontrollably,"},{"id":"semetey-1-2013:p0980:b003:l001","ordinal":151874,"en":"She sobbed beyond measure."},{"id":"semetey-1-2013:p0980:b003:l002","ordinal":151875,"en":"Her attendants beside her,"},{"id":"semetey-1-2013:p0980:b003:l003","ordinal":151876,"en":"Chachykey’s forty daughters-in-law,"},{"id":"semetey-1-2013:p0980:b003:l004","ordinal":151877,"en":"Girls and married women mingled together—"},{"id":"semetey-1-2013:p0980:b003:l005","ordinal":151878,"en":"Among those women"},{"id":"semetey-1-2013:p0980:b003:l006","ordinal":151879,"en":"There was every kind and none lacking:"},{"id":"semetey-1-2013:p0980:b003:l007","ordinal":151880,"en":"Some had handspan waists and moonlike faces,"},{"id":"semetey-1-2013:p0980:b003:l008","ordinal":151881,"en":"Some were radiant beauties,"},{"id":"semetey-1-2013:p0980:b003:l009","ordinal":151882,"en":"Some spoke words sweet as honey,"},{"id":"semetey-1-2013:p0980:b003:l010","ordinal":151883,"en":"Some had wide, fawn-like eyes,"},{"id":"semetey-1-2013:p0980:b003:l011","ordinal":151884,"en":"Some had black hair like meadow grass,"},{"id":"semetey-1-2013:p0980:b003:l012","ordinal":151885,"en":"And some had finely drawn black brows."},{"id":"semetey-1-2013:p0980:b003:l013","ordinal":151886,"en":"Your imperious sister-in-law Chachykey"},{"id":"semetey-1-2013:p0980:b003:l014","ordinal":151887,"en":"Moved with an extraordinary bearing."},{"id":"semetey-1-2013:p0980:b003:l015","ordinal":151888,"en":"Her attendants beside her"},{"id":"semetey-1-2013:p0980:b003:l016","ordinal":151889,"en":"Would not let her feet touch the ground;"},{"id":"semetey-1-2013:p0980:b003:l017","ordinal":151890,"en":"They spread Semetey’s great carpet"},{"id":"semetey-1-2013:p0980:b003:l018","ordinal":151891,"en":"Upon the black earth,"},{"id":"semetey-1-2013:p0980:b003:l019","ordinal":151892,"en":"And would not let her tread God’s bare ground."},{"id":"semetey-1-2013:p0980:b003:l020","ordinal":151893,"en":"The imperious woman Chachykey"},{"id":"semetey-1-2013:p0980:b003:l021","ordinal":151894,"en":"Approached the gated fortress"},{"id":"semetey-1-2013:p0980:b003:l022","ordinal":151895,"en":"And filed inside;"},{"id":"semetey-1-2013:p0980:b003:l023","ordinal":151896,"en":"The boys had not yet arrived from the field."},{"id":"semetey-1-2013:p0980:b003:l024","ordinal":151897,"en":"Kulchoro and Kanchoro"},{"id":"semetey-1-2013:p0980:b003:l025","ordinal":151898,"en":"Could not retreat after hearing her words,"},{"id":"semetey-1-2013:p0980:b003:l026","ordinal":151899,"en":"Nor tell the broad-backed wretch"},{"id":"semetey-1-2013:p0980:b003:l027","ordinal":151900,"en":"What had become of the falcon."},{"id":"semetey-1-2013:p0980:b003:l028","ordinal":151901,"en":"They could not endure"},{"id":"semetey-1-2013:p0980:b003:l029","ordinal":151902,"en":"The heat of that truly formidable woman,"},{"id":"semetey-1-2013:p0980:b003:l030","ordinal":151903,"en":"Could not go before her and speak,"},{"id":"semetey-1-2013:p0980:b003:l031","ordinal":151904,"en":"Yet could not turn back without entering."},{"id":"semetey-1-2013:p0980:b003:l032","ordinal":151905,"en":"The twin choros"},{"id":"semetey-1-2013:p0980:b003:l033","ordinal":151906,"en":"The two twin companions"},{"id":"semetey-1-2013:p0980:b003:l034","ordinal":151907,"en":"Stood taking counsel,"},{"id":"semetey-1-2013:p0980:b003:l035","ordinal":151908,"en":"And shaped their words carefully;"},{"id":"semetey-1-2013:p0980:b003:l036","ordinal":151909,"en":"Neither would heed the other."},{"id":"semetey-1-2013:p0980:b003:l037","ordinal":151910,"en":"Of the woman whose wrath was fierce,"},{"id":"semetey-1-2013:p0980:b003:l038","ordinal":151911,"en":"Unable to enter her encampment,"},{"id":"semetey-1-2013:p0980:b003:l039","ordinal":151912,"en":"Unable to greet her and withdraw,"},{"id":"semetey-1-2013:p0980:b004:l001","ordinal":151913,"en":"“We lost Akshunkar,”"},{"id":"semetey-1-2013:p0980:b004:l002","ordinal":151914,"en":"Or explain what had happened."},{"id":"semetey-1-2013:p0980:b004:l003","ordinal":151915,"en":"They stood braced together,"},{"id":"semetey-1-2013:p0980:b004:l004","ordinal":151916,"en":"Having brought this misery upon themselves."},{"id":"semetey-1-2013:p0980:b004:l005","ordinal":151917,"en":"Kanchoro, the son of Chubak, said:"},{"id":"semetey-1-2013:p0980:b004:l006","ordinal":151918,"en":"“Ah, my dear Kulchoro,"},{"id":"semetey-1-2013:p0980:b004:l007","ordinal":151919,"en":"Heed these words of mine, choro."},{"id":"semetey-1-2013:p0980:b004:l008","ordinal":151920,"en":"Go to your sister-in-law, choro,"},{"id":"semetey-1-2013:p0980:b004:l009","ordinal":151921,"en":"And tell her plainly,"},{"id":"semetey-1-2013:p0980:b004:l010","ordinal":151922,"en":"‘We have lost Akshunkar!’"},{"id":"semetey-1-2013:p0980:b004:l011","ordinal":151923,"en":"Ask whether she knows the falcon,"},{"id":"semetey-1-2013:p0980:b004:l012","ordinal":151924,"en":"And learn where she thinks it may be."},{"id":"semetey-1-2013:p0980:b004:l013","ordinal":151925,"en":"You have a gentle face and fluent tongue,"},{"id":"semetey-1-2013:p0980:b004:l014","ordinal":151926,"en":"And were always a man who did not misspeak."},{"id":"semetey-1-2013:p0980:b004:l015","ordinal":151927,"en":"You are a nimble orator and quick thinker,"},{"id":"semetey-1-2013:p0980:b004:l016","ordinal":151928,"en":"A boy accomplished in speech,"},{"id":"semetey-1-2013:p0980:b004:l017","ordinal":151929,"en":"One who could always find a way with words."},{"id":"semetey-1-2013:p0980:b004:l018","ordinal":151930,"en":"Go to your sister-in-law."},{"id":"semetey-1-2013:p0980:b004:l019","ordinal":151931,"en":"Ask whether she knows of the falcon,"},{"id":"semetey-1-2013:p0980:b004:l020","ordinal":151932,"en":"And approach her with tactful words."},{"id":"semetey-1-2013:p0980:b004:l021","ordinal":151933,"en":"Whether she knows or does not,"},{"id":"semetey-1-2013:p0980:b004:l022","ordinal":151934,"en":"You are a man, my choro—go."},{"id":"semetey-1-2013:p0980:b004:l023","ordinal":151935,"en":"To that devilish woman,"},{"id":"semetey-1-2013:p0980:b004:l024","ordinal":151936,"en":"That impetuous wretch,"},{"id":"semetey-1-2013:p0980:b004:l025","ordinal":151937,"en":"My Kulchoro, go."},{"id":"semetey-1-2013:p0980:b004:l026","ordinal":151938,"en":"Tell her what followed Akshunkar;"},{"id":"semetey-1-2013:p0980:b004:l027","ordinal":151939,"en":"Tell of the suffering that befell it"},{"id":"semetey-1-2013:p0980:b004:l028","ordinal":151940,"en":"Along the shore of Ala-Köl."},{"id":"semetey-1-2013:p0980:b004:l029","ordinal":151941,"en":"She who has licked the edge of a sword—"},{"id":"semetey-1-2013:p0980:b004:l030","ordinal":151942,"en":"If she tells where the falcon is,"},{"id":"semetey-1-2013:p0980:b004:l031","ordinal":151943,"en":"Tell her of your magnanimous lord’s pain!”"},{"id":"semetey-1-2013:p0980:b004:l032","ordinal":151944,"en":"While Kanchoro spoke,"},{"id":"semetey-1-2013:p0980:b004:l033","ordinal":151945,"en":"“Very well, elder, very well,” he said,"},{"id":"semetey-1-2013:p0980:b004:l034","ordinal":151946,"en":"Bending his knee to the ground."},{"id":"semetey-1-2013:p0980:b004:l035","ordinal":151947,"en":"From atop Akborchuk"},{"id":"semetey-1-2013:p0980:b004:l036","ordinal":151948,"en":"He ran down at speed,"},{"id":"semetey-1-2013:p0980:b004:l037","ordinal":151949,"en":"And Kulchoro flew like an arrow,"},{"id":"semetey-1-2013:p0980:b004:l038","ordinal":151950,"en":"Looking to either side"},{"id":"semetey-1-2013:p0980:b004:l039","ordinal":151951,"en":"And licking his lips."},{"id":"semetey-1-2013:p0981:b003:l001","ordinal":151952,"en":"Almambet’s only son"},{"id":"semetey-1-2013:p0981:b003:l002","ordinal":151953,"en":"Was broad across the right shoulder,"},{"id":"semetey-1-2013:p0981:b003:l003","ordinal":151954,"en":"A lion who came from Ogoi,"},{"id":"semetey-1-2013:p0981:b003:l004","ordinal":151955,"en":"Thick-armed and stone-hearted,"},{"id":"semetey-1-2013:p0981:b003:l005","ordinal":151956,"en":"Exceedingly handsome and also a lion,"},{"id":"semetey-1-2013:p0981:b003:l006","ordinal":151957,"en":"A sturdy man of every limb."},{"id":"semetey-1-2013:p0981:b003:l007","ordinal":151958,"en":"He hung his blue sword at his side;"},{"id":"semetey-1-2013:p0981:b003:l008","ordinal":151959,"en":"If you had seen Kulchoro,"},{"id":"semetey-1-2013:p0981:b003:l009","ordinal":151960,"en":"He raged like a blue tiger."},{"id":"semetey-1-2013:p0981:b003:l010","ordinal":151961,"en":"The sight of him divided one’s thoughts;"},{"id":"semetey-1-2013:p0981:b003:l011","ordinal":151962,"en":"Now he plainly reached"},{"id":"semetey-1-2013:p0981:b003:l012","ordinal":151963,"en":"The utterly spoiled beauty."},{"id":"semetey-1-2013:p0981:b003:l013","ordinal":151964,"en":"Before that excitable wretch,"},{"id":"semetey-1-2013:p0981:b003:l014","ordinal":151965,"en":"That exceedingly pampered woman,"},{"id":"semetey-1-2013:p0981:b003:l015","ordinal":151966,"en":"He came crying and ready,"},{"id":"semetey-1-2013:p0981:b003:l016","ordinal":151967,"en":"Swaying as though struck from this side."},{"id":"semetey-1-2013:p0981:b003:l017","ordinal":151968,"en":"Before the stubborn, spoiled wretch,"},{"id":"semetey-1-2013:p0981:b003:l018","ordinal":151969,"en":"Before the boy could speak to her face,"},{"id":"semetey-1-2013:p0981:b003:l019","ordinal":151970,"en":"Your grieving, delicate sister-in-law"},{"id":"semetey-1-2013:p0981:b003:l020","ordinal":151971,"en":"Pranced like a spirited horse,"},{"id":"semetey-1-2013:p0981:b003:l021","ordinal":151972,"en":"And began speaking first,"},{"id":"semetey-1-2013:p0981:b003:l022","ordinal":151973,"en":"Voicing her words slowly and firmly:"},{"id":"semetey-1-2013:p0981:b003:l023","ordinal":151974,"en":"“Your unruly elder Semetey—"},{"id":"semetey-1-2013:p0981:b003:l024","ordinal":151975,"en":"Is that wild man safe and well?"},{"id":"semetey-1-2013:p0981:b003:l025","ordinal":151976,"en":"Is the tulpar beneath him"},{"id":"semetey-1-2013:p0981:b003:l026","ordinal":151977,"en":"Safe and sound,"},{"id":"semetey-1-2013:p0981:b003:l027","ordinal":151978,"en":"And the falcon upon his hand?”"},{"id":"semetey-1-2013:p0981:b003:l028","ordinal":151979,"en":"When your sister-in-law said this,"},{"id":"semetey-1-2013:p0981:b003:l029","ordinal":151980,"en":"The choro stood and replied:"},{"id":"semetey-1-2013:p0981:b003:l030","ordinal":151981,"en":"“Noble sister-in-law Chachykey!"},{"id":"semetey-1-2013:p0981:b003:l031","ordinal":151982,"en":"Your hardship has passed,"},{"id":"semetey-1-2013:p0981:b003:l032","ordinal":151983,"en":"And your fortune has overflowed."},{"id":"semetey-1-2013:p0981:b003:l033","ordinal":151984,"en":"Tell where the sword fits its sheath;"},{"id":"semetey-1-2013:p0981:b003:l034","ordinal":151985,"en":"Sister blessed by Kydyr,"},{"id":"semetey-1-2013:p0981:b003:l035","ordinal":151986,"en":"This time tell the truth!"},{"id":"semetey-1-2013:p0981:b003:l036","ordinal":151987,"en":"Think and tell of every kind"},{"id":"semetey-1-2013:p0981:b003:l037","ordinal":151988,"en":"Of suffering and death."},{"id":"semetey-1-2013:p0981:b003:l038","ordinal":151989,"en":"If you possess knowledge, sister-in-law,"},{"id":"semetey-1-2013:p0981:b003:l039","ordinal":151990,"en":"Leave nothing out when you speak."},{"id":"semetey-1-2013:p0981:b004:l001","ordinal":151991,"en":"We opened tireless Buurul’s stride;"},{"id":"semetey-1-2013:p0981:b004:l002","ordinal":151992,"en":"Along the shore of Ala-Köl"},{"id":"semetey-1-2013:p0981:b004:l003","ordinal":151993,"en":"We lost Akshunkar!"},{"id":"semetey-1-2013:p0981:b004:l004","ordinal":151994,"en":"We heard words from men of counsel:"},{"id":"semetey-1-2013:p0981:b004:l005","ordinal":151995,"en":"Unless you refuse out of obstinacy,"},{"id":"semetey-1-2013:p0981:b004:l006","ordinal":151996,"en":"We heard that you would know."},{"id":"semetey-1-2013:p0981:b004:l007","ordinal":151997,"en":"My elder Semetey,"},{"id":"semetey-1-2013:p0981:b004:l008","ordinal":151998,"en":"If you tell us of the falcon,"},{"id":"semetey-1-2013:p0981:b004:l009","ordinal":151999,"en":"He will say neither this nor that,"},{"id":"semetey-1-2013:p0981:b004:l010","ordinal":152000,"en":"Will not raise his whip against you,"},{"id":"semetey-1-2013:p0981:b004:l011","ordinal":152001,"en":"And will not take another wife after you."},{"id":"semetey-1-2013:p0981:b004:l012","ordinal":152002,"en":"Made an extraordinary promise;"},{"id":"semetey-1-2013:p0981:b004:l013","ordinal":152003,"en":"Tell me, sister-in-law, what does this mean?”"},{"id":"semetey-1-2013:p0981:b004:l014","ordinal":152004,"en":"When the boy had said this,"},{"id":"semetey-1-2013:p0981:b004:l015","ordinal":152005,"en":"Semetey’s wayward, pampered wife"},{"id":"semetey-1-2013:p0981:b004:l016","ordinal":152006,"en":"Burst into a frenzy:"},{"id":"semetey-1-2013:p0981:b004:l017","ordinal":152007,"en":"“Shame, shame upon your face!"},{"id":"semetey-1-2013:p0981:b004:l018","ordinal":152008,"en":"You have spoken cold, ugly words."},{"id":"semetey-1-2013:p0981:b004:l019","ordinal":152009,"en":"The man in the field"},{"id":"semetey-1-2013:p0981:b004:l020","ordinal":152010,"en":"Has business with his bird;"},{"id":"semetey-1-2013:p0981:b004:l021","ordinal":152011,"en":"The woman inside the house"},{"id":"semetey-1-2013:p0981:b004:l022","ordinal":152012,"en":"Has business with her food."},{"id":"semetey-1-2013:p0981:b004:l023","ordinal":152013,"en":"As for the falcon that was lost,"},{"id":"semetey-1-2013:p0981:b004:l024","ordinal":152014,"en":"What business could"},{"id":"semetey-1-2013:p0981:b004:l025","ordinal":152015,"en":"A woman sitting at home have with it?"},{"id":"semetey-1-2013:p0981:b004:l026","ordinal":152016,"en":"Vanish from my sight;"},{"id":"semetey-1-2013:p0981:b004:l027","ordinal":152017,"en":"Do not come near me!"},{"id":"semetey-1-2013:p0981:b004:l028","ordinal":152018,"en":"You who speak with a hiss,"},{"id":"semetey-1-2013:p0981:b004:l029","ordinal":152019,"en":"Who mention the time I was mocked—"},{"id":"semetey-1-2013:p0981:b004:l030","ordinal":152020,"en":"For these words you have spoken,"},{"id":"semetey-1-2013:p0981:b004:l031","ordinal":152021,"en":"By your father’s grave, filthy slave,"},{"id":"semetey-1-2013:p0981:b004:l032","ordinal":152022,"en":"Vanish from my sight!"},{"id":"semetey-1-2013:p0981:b004:l033","ordinal":152023,"en":"I shall slaughter you now;"},{"id":"semetey-1-2013:p0981:b004:l034","ordinal":152024,"en":"By your father’s grave, devil-slave,"},{"id":"semetey-1-2013:p0981:b004:l035","ordinal":152025,"en":"I shall gouge out your eyes!"},{"id":"semetey-1-2013:p0981:b004:l036","ordinal":152026,"en":"Remember what I have said:"},{"id":"semetey-1-2013:p0981:b004:l037","ordinal":152027,"en":"You and your bloodthirsty companion together—"},{"id":"semetey-1-2013:p0981:b004:l038","ordinal":152028,"en":"Go down into the black earth!”"},{"id":"semetey-1-2013:p0981:b004:l039","ordinal":152029,"en":"She raged and swelled with fury,"},{"id":"semetey-1-2013:p0982:b003:l001","ordinal":152030,"en":"The mad woman Chachykey"},{"id":"semetey-1-2013:p0982:b003:l002","ordinal":152031,"en":"Spoke without restraint,"},{"id":"semetey-1-2013:p0982:b003:l003","ordinal":152032,"en":"And became intent upon"},{"id":"semetey-1-2013:p0982:b003:l004","ordinal":152033,"en":"Slaughtering Kulchoro,"},{"id":"semetey-1-2013:p0982:b003:l005","ordinal":152034,"en":"Putting him to death,"},{"id":"semetey-1-2013:p0982:b003:l006","ordinal":152035,"en":"Cutting him down as a sacrifice,"},{"id":"semetey-1-2013:p0982:b003:l007","ordinal":152036,"en":"And ending his life."},{"id":"semetey-1-2013:p0982:b003:l008","ordinal":152037,"en":"The wayward, spoiled mad slave-woman—"},{"id":"semetey-1-2013:p0982:b003:l009","ordinal":152038,"en":"Now God struck the madwoman;"},{"id":"semetey-1-2013:p0982:b003:l010","ordinal":152039,"en":"May He never give such a person"},{"id":"semetey-1-2013:p0982:b003:l011","ordinal":152040,"en":"Such filthy, obscene speech."},{"id":"semetey-1-2013:p0982:b003:l012","ordinal":152041,"en":"When you looked at Chachykey,"},{"id":"semetey-1-2013:p0982:b003:l013","ordinal":152042,"en":"She raged beyond the reach of words;"},{"id":"semetey-1-2013:p0982:b003:l014","ordinal":152043,"en":"Your stubborn sister-in-law spoke,"},{"id":"semetey-1-2013:p0982:b003:l015","ordinal":152044,"en":"Swelled and seethed,"},{"id":"semetey-1-2013:p0982:b003:l016","ordinal":152045,"en":"And your fierce sister-in-law spoke."},{"id":"semetey-1-2013:p0982:b003:l017","ordinal":152046,"en":"Where Semetey lay,"},{"id":"semetey-1-2013:p0982:b003:l018","ordinal":152047,"en":"Here where he remained still,"},{"id":"semetey-1-2013:p0982:b003:l019","ordinal":152048,"en":"For sixty colts and four sheep"},{"id":"semetey-1-2013:p0982:b003:l020","ordinal":152049,"en":"Your noble mother Kanykey"},{"id":"semetey-1-2013:p0982:b003:l021","ordinal":152050,"en":"Had refined white silver."},{"id":"semetey-1-2013:p0982:b003:l022","ordinal":152051,"en":"Amid thirty daughters-in-law and thirty girls,"},{"id":"semetey-1-2013:p0982:b003:l023","ordinal":152052,"en":"Your sister-in-law"},{"id":"semetey-1-2013:p0982:b003:l024","ordinal":152053,"en":"Seized by its handle"},{"id":"semetey-1-2013:p0982:b003:l025","ordinal":152054,"en":"A knife made to slaughter a man,"},{"id":"semetey-1-2013:p0982:b003:l026","ordinal":152055,"en":"Drew it from its sheath,"},{"id":"semetey-1-2013:p0982:b003:l027","ordinal":152056,"en":"And rushed to slaughter Kulchoro,"},{"id":"semetey-1-2013:p0982:b003:l028","ordinal":152057,"en":"To put him to death."},{"id":"semetey-1-2013:p0982:b003:l029","ordinal":152058,"en":"She charged forward in a lunge,"},{"id":"semetey-1-2013:p0982:b003:l030","ordinal":152059,"en":"Knife gripped in her hand,"},{"id":"semetey-1-2013:p0982:b003:l031","ordinal":152060,"en":"And threw herself upon Kulchoro."},{"id":"semetey-1-2013:p0982:b003:l032","ordinal":152061,"en":"From that witless wretch"},{"id":"semetey-1-2013:p0982:b003:l033","ordinal":152062,"en":"Kulchoro fled away,"},{"id":"semetey-1-2013:p0982:b003:l034","ordinal":152063,"en":"Clung to the place of a mother,"},{"id":"semetey-1-2013:p0982:b003:l035","ordinal":152064,"en":"And escaped the woman who had seized a weapon."}]
