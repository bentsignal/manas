[{"id":"sayakbay-ms-current146:pdf173:l019","ordinal":393473,"en":"Across low ridges and open plain,"},{"id":"sayakbay-ms-current146:pdf173:l020","ordinal":393474,"en":"They surged apart in wrath,"},{"id":"sayakbay-ms-current146:pdf173:l021","ordinal":393475,"en":"As though digging lightning from the sky,"},{"id":"sayakbay-ms-current146:pdf173:l022","ordinal":393476,"en":"Spurring horses, the seal fell,"},{"id":"sayakbay-ms-current146:pdf173:l023","ordinal":393477,"en":"Finish them; do not fear,"},{"id":"sayakbay-ms-current146:pdf173:l024","ordinal":393478,"en":"I shall crush and drag them away,"},{"id":"sayakbay-ms-current146:pdf173:l025","ordinal":393479,"en":"He aligned the stones and pressed in,"},{"id":"sayakbay-ms-current146:pdf173:l026","ordinal":393480,"en":"Every living creature,"},{"id":"sayakbay-ms-current146:pdf173:l027","ordinal":393481,"en":"Grew still and then trembled,"},{"id":"sayakbay-ms-current146:pdf173:l028","ordinal":393482,"en":"Thunder spread far and wide,"},{"id":"sayakbay-ms-current146:pdf173:l029","ordinal":393483,"en":"From fighting he could no longer see,"},{"id":"sayakbay-ms-current146:pdf173:l030","ordinal":393484,"en":"The people’s lament knotted within,"},{"id":"sayakbay-ms-current146:pdf173:l031","ordinal":393485,"en":"Every creature that came to mind,"},{"id":"sayakbay-ms-current146:pdf173:l032","ordinal":393486,"en":"Appeared while still alive,"},{"id":"sayakbay-ms-current146:pdf173:l033","ordinal":393487,"en":"The creatures upon the earth,"},{"id":"sayakbay-ms-current146:pdf173:l034","ordinal":393488,"en":"The ember in their breasts tightened,"},{"id":"sayakbay-ms-current146:pdf173:l035","ordinal":393489,"en":"He drove the foe straight through,"},{"id":"sayakbay-ms-current146:pdf173:l036","ordinal":393490,"en":"Across the drifting haze and cliffs."}]
