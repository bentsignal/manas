{"id": "sayakbay-ms-current142:pdf034:l040", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 34, "folio": 2351, "line_in_page": 40, "raw": "Калкымдын көңүлүн толтуруп,", "text": "Калкымдын көңүлүн толтуруп,", "en": "Filling the hearts of my people,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Possessive form and verb are uncertain.", "bbox": null}
{"id": "sayakbay-ms-current142:pdf034:l041", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 34, "folio": 2351, "line_in_page": 41, "raw": "Бирге басып барсаң да,", "text": "Бирге басып барсаң да,", "en": "Even if you walk there together,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Approximate reading.", "bbox": null}
{"id": "sayakbay-ms-current142:pdf034:l042", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 34, "folio": 2351, "line_in_page": 42, "raw": "Ак буурадай жүгүң болсо,", "text": "Ак буурадай жүгүң болсо,", "en": "If your burden is like a white camel’s,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Simile and noun are not completely clear.", "bbox": null}
{"id": "sayakbay-ms-current142:pdf034:l043", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 34, "folio": 2351, "line_in_page": 43, "raw": "Ак оролбой сорулуп,", "text": "Ак оролбой сорулуп,", "en": "Without being wrapped in white, fading away,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Most of the line is uncertain.", "bbox": null}
{"id": "sayakbay-ms-current142:pdf034:l044", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 34, "folio": 2351, "line_in_page": 44, "raw": "Бу кайгыдан баш албай,", "text": "Бу кайгыдан баш албай,", "en": "Unable to lift your head from this sorrow,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Final phrase is inferred.", "bbox": null}
{"id": "sayakbay-ms-current142:pdf034:l045", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 34, "folio": 2351, "line_in_page": 45, "raw": "Тилегиңди жаратып жүрөсүң,", "text": "Тилегиңди жаратып жүрөсүң,", "en": "You continue shaping your wish,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Verb may have another reading.", "bbox": null}
{"id": "sayakbay-ms-current142:pdf034:l046", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 34, "folio": 2351, "line_in_page": 46, "raw": "Теңиңдин найза сунганын,", "text": "Теңиңдин найза сунганын,", "en": "Your equal’s extending of the spear,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Initial noun and final suffix are unclear.", "bbox": null}
{"id": "sayakbay-ms-current142:pdf034:l047", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 34, "folio": 2351, "line_in_page": 47, "raw": "Диниң жана күч менен,", "text": "Диниң жана күч менен,", "en": "With your faith and strength,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Middle conjunction is uncertain.", "bbox": null}
{"id": "sayakbay-ms-current142:pdf034:l048", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 34, "folio": 2351, "line_in_page": 48, "raw": "Ордунда согуш ойноп,", "text": "Ордунда согуш ойноп,", "en": "Waging battle in its place,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Last two words are difficult to distinguish.", "bbox": null}
