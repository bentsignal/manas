[{"id":"semetey-1-2013:p1176:b003:l033","ordinal":166913,"en":"Going to wrestle him."},{"id":"semetey-1-2013:p1176:b003:l034","ordinal":166914,"en":"The giants Koshoi and Töshtük"},{"id":"semetey-1-2013:p1176:b003:l035","ordinal":166915,"en":"Raised their hands and cried out;"},{"id":"semetey-1-2013:p1176:b003:l036","ordinal":166916,"en":"All of them gave their blessing,"},{"id":"semetey-1-2013:p1176:b003:l037","ordinal":166917,"en":"Including old hero Koshoi."},{"id":"semetey-1-2013:p1176:b003:l038","ordinal":166918,"en":"Brave Agysh stepped forward"},{"id":"semetey-1-2013:p1176:b003:l039","ordinal":166919,"en":"And spoke these words to Manas:"},{"id":"semetey-1-2013:p1176:b004:l001","ordinal":166920,"en":"“Against that swaggering swine,"},{"id":"semetey-1-2013:p1176:b004:l002","ordinal":166921,"en":"I will grapple and wrestle fiercely,"},{"id":"semetey-1-2013:p1176:b004:l003","ordinal":166922,"en":"Tearing at whoever stands before me,"},{"id":"semetey-1-2013:p1176:b004:l004","ordinal":166923,"en":"Butting like a blue bull;"},{"id":"semetey-1-2013:p1176:b004:l005","ordinal":166924,"en":"I will wrestle him openly."},{"id":"semetey-1-2013:p1176:b004:l006","ordinal":166925,"en":"Take the black-jawed rawhide whip,"},{"id":"semetey-1-2013:p1176:b004:l007","ordinal":166926,"en":"Grasp it and swing it:"},{"id":"semetey-1-2013:p1176:b004:l008","ordinal":166927,"en":"‘Lift him, Agysh, lift him!’"},{"id":"semetey-1-2013:p1176:b004:l009","ordinal":166928,"en":"‘Take him, Agysh, take him!’"},{"id":"semetey-1-2013:p1176:b004:l010","ordinal":166929,"en":"Across the fish-like flesh of my fat rump,"},{"id":"semetey-1-2013:p1176:b004:l011","ordinal":166930,"en":"Strike and split it open;"},{"id":"semetey-1-2013:p1176:b004:l012","ordinal":166931,"en":"Let my flesh sting,"},{"id":"semetey-1-2013:p1176:b004:l013","ordinal":166932,"en":"Let my blood scatter."},{"id":"semetey-1-2013:p1176:b004:l014","ordinal":166933,"en":"From that swine who plays the hero,"},{"id":"semetey-1-2013:p1176:b004:l015","ordinal":166934,"en":"I will seize him by the shins."},{"id":"semetey-1-2013:p1176:b004:l016","ordinal":166935,"en":"Jerking him up and down,"},{"id":"semetey-1-2013:p1176:b004:l017","ordinal":166936,"en":"I will use my ancient strength."},{"id":"semetey-1-2013:p1176:b004:l018","ordinal":166937,"en":"If you do not strike, it brings shame;"},{"id":"semetey-1-2013:p1176:b004:l019","ordinal":166938,"en":"Your blow is entrusted to us."},{"id":"semetey-1-2013:p1176:b004:l020","ordinal":166939,"en":"When anger rises, I will prevail;"},{"id":"semetey-1-2013:p1176:b004:l021","ordinal":166940,"en":"If my anger does not rise,"},{"id":"semetey-1-2013:p1176:b004:l022","ordinal":166941,"en":"I may merely keep laughing."},{"id":"semetey-1-2013:p1176:b004:l023","ordinal":166942,"en":"When I see your fierce wrath,"},{"id":"semetey-1-2013:p1176:b004:l024","ordinal":166943,"en":"Then I will put forth my strength.”"},{"id":"semetey-1-2013:p1176:b004:l025","ordinal":166944,"en":"Having said this,"},{"id":"semetey-1-2013:p1176:b004:l026","ordinal":166945,"en":"Agysh strode toward the champion,"},{"id":"semetey-1-2013:p1176:b004:l027","ordinal":166946,"en":"Going to wrestle him."},{"id":"semetey-1-2013:p1176:b004:l028","ordinal":166947,"en":"Tükübai of the Kalmyks"},{"id":"semetey-1-2013:p1176:b004:l029","ordinal":166948,"en":"Never released a man he grappled;"},{"id":"semetey-1-2013:p1176:b004:l030","ordinal":166949,"en":"From the flesh of a single swine,"},{"id":"semetey-1-2013:p1176:b004:l031","ordinal":166950,"en":"One meal could not fill him."},{"id":"semetey-1-2013:p1176:b004:l032","ordinal":166951,"en":"Who has seen a hero like this?"},{"id":"semetey-1-2013:p1176:b004:l033","ordinal":166952,"en":"He braced himself and charged."},{"id":"semetey-1-2013:p1176:b004:l034","ordinal":166953,"en":"If Agysh fell into his hands,"},{"id":"semetey-1-2013:p1176:b004:l035","ordinal":166954,"en":"He looked ready to mow him down."},{"id":"semetey-1-2013:p1176:b004:l036","ordinal":166955,"en":"Without even stirring from his place,"},{"id":"semetey-1-2013:p1176:b004:l037","ordinal":166956,"en":"He looked ready to suck him in whole."},{"id":"semetey-1-2013:p1176:b004:l038","ordinal":166957,"en":"The great Hairy-Sole champion"},{"id":"semetey-1-2013:p1176:b004:l039","ordinal":166958,"en":"Charged and reached him."},{"id":"semetey-1-2013:p1177:b003:l001","ordinal":166959,"en":"When he saw him charge,"},{"id":"semetey-1-2013:p1177:b003:l002","ordinal":166960,"en":"What could dear Agysh do?"},{"id":"semetey-1-2013:p1177:b003:l003","ordinal":166961,"en":"He stood and awaited his turn."},{"id":"semetey-1-2013:p1177:b003:l004","ordinal":166962,"en":"When Tükübai reached him,"},{"id":"semetey-1-2013:p1177:b003:l005","ordinal":166963,"en":"Brave Agysh held out his forearm."},{"id":"semetey-1-2013:p1177:b003:l006","ordinal":166964,"en":"They seized each other’s arms;"},{"id":"semetey-1-2013:p1177:b003:l007","ordinal":166965,"en":"Before either could call for a blow,"},{"id":"semetey-1-2013:p1177:b003:l008","ordinal":166966,"en":"The heroes wrenched their arms free."},{"id":"semetey-1-2013:p1177:b003:l009","ordinal":166967,"en":"They heaved and strained,"},{"id":"semetey-1-2013:p1177:b003:l010","ordinal":166968,"en":"Tugging and jerking,"},{"id":"semetey-1-2013:p1177:b003:l011","ordinal":166969,"en":"Grappling at the appointed ground,"},{"id":"semetey-1-2013:p1177:b003:l012","ordinal":166970,"en":"Facing and tripping each other."},{"id":"semetey-1-2013:p1177:b003:l013","ordinal":166971,"en":"They opened their mouths like caverns,"},{"id":"semetey-1-2013:p1177:b003:l014","ordinal":166972,"en":"Shouting as they pressed toward the earth."},{"id":"semetey-1-2013:p1177:b003:l015","ordinal":166973,"en":"The strong men twisted each other’s necks"},{"id":"semetey-1-2013:p1177:b003:l016","ordinal":166974,"en":"And tore at every point of leverage."},{"id":"semetey-1-2013:p1177:b003:l017","ordinal":166975,"en":"Infidel and Muslim alike"},{"id":"semetey-1-2013:p1177:b003:l018","ordinal":166976,"en":"Crowded round and watched,"},{"id":"semetey-1-2013:p1177:b003:l019","ordinal":166977,"en":"As the champions strained."},{"id":"semetey-1-2013:p1177:b003:l020","ordinal":166978,"en":"Everyone who saw it marveled."},{"id":"semetey-1-2013:p1177:b003:l021","ordinal":166979,"en":"They grappled day and night,"},{"id":"semetey-1-2013:p1177:b003:l022","ordinal":166980,"en":"Until two days were complete."},{"id":"semetey-1-2013:p1177:b003:l023","ordinal":166981,"en":"The assembled people watched their struggle"},{"id":"semetey-1-2013:p1177:b003:l024","ordinal":166982,"en":"And knew what was happening—do you see?"},{"id":"semetey-1-2013:p1177:b003:l025","ordinal":166983,"en":"As though he were watching a brother-in-law,"},{"id":"semetey-1-2013:p1177:b003:l026","ordinal":166984,"en":"Agysh burst out laughing then;"},{"id":"semetey-1-2013:p1177:b003:l027","ordinal":166985,"en":"He went on laughing—do you see?"},{"id":"semetey-1-2013:p1177:b003:l028","ordinal":166986,"en":"The youngest of the twelve lions,"},{"id":"semetey-1-2013:p1177:b003:l029","ordinal":166987,"en":"A servant beloved by God,"},{"id":"semetey-1-2013:p1177:b003:l030","ordinal":166988,"en":"The dark gray-maned snow leopard Manas,"},{"id":"semetey-1-2013:p1177:b003:l031","ordinal":166989,"en":"At Agysh’s laughter"},{"id":"semetey-1-2013:p1177:b003:l032","ordinal":166990,"en":"Was seized by anger."},{"id":"semetey-1-2013:p1177:b003:l033","ordinal":166991,"en":"His bloodlust gripped him hard;"},{"id":"semetey-1-2013:p1177:b003:l034","ordinal":166992,"en":"His eyes truly blazed like fire."},{"id":"semetey-1-2013:p1177:b003:l035","ordinal":166993,"en":"His broad front teeth were like a gate,"},{"id":"semetey-1-2013:p1177:b003:l036","ordinal":166994,"en":"Teeth unlike those of ordinary folk,"},{"id":"semetey-1-2013:p1177:b003:l037","ordinal":166995,"en":"And they flashed white as he bared them."},{"id":"semetey-1-2013:p1177:b003:l038","ordinal":166996,"en":"Still swollen with rage, toward Agysh"},{"id":"semetey-1-2013:p1177:b003:l039","ordinal":166997,"en":"The snow leopard rushed."},{"id":"semetey-1-2013:p1177:b005:l001","ordinal":166998,"en":"“Lift him, Agysh—take him!"},{"id":"semetey-1-2013:p1177:b005:l002","ordinal":166999,"en":"This Kalmyk fit for burial,"},{"id":"semetey-1-2013:p1177:b005:l003","ordinal":167000,"en":"Lay him upon the black earth!”"},{"id":"semetey-1-2013:p1177:b005:l004","ordinal":167001,"en":"Snow-leopard Manas roared."},{"id":"semetey-1-2013:p1177:b005:l005","ordinal":167002,"en":"The black-jawed rawhide whip"},{"id":"semetey-1-2013:p1177:b005:l006","ordinal":167003,"en":"He seized and swung."},{"id":"semetey-1-2013:p1177:b005:l007","ordinal":167004,"en":"Charging in then,"},{"id":"semetey-1-2013:p1177:b005:l008","ordinal":167005,"en":"At elbow-sized Agysh"},{"id":"semetey-1-2013:p1177:b005:l009","ordinal":167006,"en":"He lashed across the ankle."},{"id":"semetey-1-2013:p1177:b005:l010","ordinal":167007,"en":"His ankle flared with pain,"},{"id":"semetey-1-2013:p1177:b005:l011","ordinal":167008,"en":"And now his anger reached its height."},{"id":"semetey-1-2013:p1177:b005:l012","ordinal":167009,"en":"Tükübai heaved like a mountain,"},{"id":"semetey-1-2013:p1177:b005:l013","ordinal":167010,"en":"But his maneuver went badly."},{"id":"semetey-1-2013:p1177:b005:l014","ordinal":167011,"en":"By both his lower legs,"},{"id":"semetey-1-2013:p1177:b005:l015","ordinal":167012,"en":"Brave Agysh, a true hero,"},{"id":"semetey-1-2013:p1177:b005:l016","ordinal":167013,"en":"Bent down and seized him."},{"id":"semetey-1-2013:p1177:b005:l017","ordinal":167014,"en":"Giving the infidel no time to breathe,"},{"id":"semetey-1-2013:p1177:b005:l018","ordinal":167015,"en":"He tore him from the ground."},{"id":"semetey-1-2013:p1177:b005:l019","ordinal":167016,"en":"He made the infidel stagger,"},{"id":"semetey-1-2013:p1177:b005:l020","ordinal":167017,"en":"And whirled the champion around."},{"id":"semetey-1-2013:p1177:b005:l021","ordinal":167018,"en":"Hairy-Sole Tükübai—"},{"id":"semetey-1-2013:p1177:b005:l022","ordinal":167019,"en":"Hair sprouted from both his cheeks,"},{"id":"semetey-1-2013:p1177:b005:l023","ordinal":167020,"en":"And a groan came from beneath his hem."},{"id":"semetey-1-2013:p1177:b005:l024","ordinal":167021,"en":"Tükübai’s arms were pinned;"},{"id":"semetey-1-2013:p1177:b005:l025","ordinal":167022,"en":"Above brave Agysh’s head"},{"id":"semetey-1-2013:p1177:b005:l026","ordinal":167023,"en":"He spun like a blue-backed colt."},{"id":"semetey-1-2013:p1177:b005:l027","ordinal":167024,"en":"His plight had turned dire."},{"id":"semetey-1-2013:p1177:b005:l028","ordinal":167025,"en":"A black rock as large as a yurt—"},{"id":"semetey-1-2013:p1177:b005:l029","ordinal":167026,"en":"Skillful Agysh reached it."},{"id":"semetey-1-2013:p1177:b005:l030","ordinal":167027,"en":"A black rock as large as a house:"},{"id":"semetey-1-2013:p1177:b005:l031","ordinal":167028,"en":"The mountain-sized champion"},{"id":"semetey-1-2013:p1177:b005:l032","ordinal":167029,"en":"He dashed upon that stone."},{"id":"semetey-1-2013:p1177:b005:l033","ordinal":167030,"en":"The prowess of brave Agysh,"},{"id":"semetey-1-2013:p1177:b005:l034","ordinal":167031,"en":"The gray-maned wolf, was revealed."},{"id":"semetey-1-2013:p1177:b005:l035","ordinal":167032,"en":"The great champion Tükübai"},{"id":"semetey-1-2013:p1177:b005:l036","ordinal":167033,"en":"Was split into two pieces."},{"id":"semetey-1-2013:p1177:b005:l037","ordinal":167034,"en":"The prowess of elbow-sized Agysh"},{"id":"semetey-1-2013:p1177:b005:l038","ordinal":167035,"en":"Was revealed to all."},{"id":"semetey-1-2013:p1178:b003:l001","ordinal":167036,"en":"“Agysh has thrown the Kalmyk!” they cried."},{"id":"semetey-1-2013:p1178:b003:l002","ordinal":167037,"en":"With bloodthirsty Manas at their head,"},{"id":"semetey-1-2013:p1178:b003:l003","ordinal":167038,"en":"There were a thousand black camels,"},{"id":"semetey-1-2013:p1178:b003:l004","ordinal":167039,"en":"And a thousand black-blazed mares."},{"id":"semetey-1-2013:p1178:b003:l005","ordinal":167040,"en":"“Take them—here is your prize!”"},{"id":"semetey-1-2013:p1178:b003:l006","ordinal":167041,"en":"They drove the herd up to him."},{"id":"semetey-1-2013:p1178:b003:l007","ordinal":167042,"en":"Without accepting that prize,"},{"id":"semetey-1-2013:p1178:b003:l008","ordinal":167043,"en":"Brave Agysh hurried about."},{"id":"semetey-1-2013:p1178:b003:l009","ordinal":167044,"en":"Then Agysh spoke,"},{"id":"semetey-1-2013:p1178:b003:l010","ordinal":167045,"en":"Uttering outrageous words no man would say:"},{"id":"semetey-1-2013:p1178:b003:l011","ordinal":167046,"en":"“I threw your champion; my hands are free."},{"id":"semetey-1-2013:p1178:b003:l012","ordinal":167047,"en":"Release my hand, Manas,"},{"id":"semetey-1-2013:p1178:b003:l013","ordinal":167048,"en":"And show before my eyes"},{"id":"semetey-1-2013:p1178:b003:l014","ordinal":167049,"en":"The marvel I saw earlier."},{"id":"semetey-1-2013:p1178:b003:l015","ordinal":167050,"en":"I will not turn aside for these beasts;"},{"id":"semetey-1-2013:p1178:b003:l016","ordinal":167051,"en":"I will not miss the entertainment."},{"id":"semetey-1-2013:p1178:b003:l017","ordinal":167052,"en":"I will not take this prize;"},{"id":"semetey-1-2013:p1178:b003:l018","ordinal":167053,"en":"I will not leave my maidens."},{"id":"semetey-1-2013:p1178:b003:l019","ordinal":167054,"en":"I will not turn aside for this prize;"},{"id":"semetey-1-2013:p1178:b003:l020","ordinal":167055,"en":"I will not part from the young brides."},{"id":"semetey-1-2013:p1178:b003:l021","ordinal":167056,"en":"I will not accept this prize."},{"id":"semetey-1-2013:p1178:b003:l022","ordinal":167057,"en":"For the exciting games and revelry,"},{"id":"semetey-1-2013:p1178:b004:l001","ordinal":167058,"en":"I will not surrender my girls.”"},{"id":"semetey-1-2013:p1178:b004:l002","ordinal":167059,"en":"Brave Agysh rushed away,"},{"id":"semetey-1-2013:p1178:b004:l003","ordinal":167060,"en":"Running toward the girls;"},{"id":"semetey-1-2013:p1178:b004:l004","ordinal":167061,"en":"Brave Agysh fled off."},{"id":"semetey-1-2013:p1178:b004:l005","ordinal":167062,"en":"Agysh did not take the prize."},{"id":"semetey-1-2013:p1178:b004:l006","ordinal":167063,"en":"The Muslims divided among themselves"},{"id":"semetey-1-2013:p1178:b004:l007","ordinal":167064,"en":"The prize belonging to brave Agysh."},{"id":"semetey-1-2013:p1178:b004:l008","ordinal":167065,"en":"They had seen the unruly gray-maned hero"},{"id":"semetey-1-2013:p1178:b004:l009","ordinal":167066,"en":"Prove himself a true warrior;"},{"id":"semetey-1-2013:p1178:b004:l010","ordinal":167067,"en":"Honoring the forefathers, the Muslim people"},{"id":"semetey-1-2013:p1178:b004:l011","ordinal":167068,"en":"Divided up the prize."},{"id":"semetey-1-2013:p1178:b004:l012","ordinal":167069,"en":"After the prize had been taken and settled,"},{"id":"semetey-1-2013:p1178:b004:l013","ordinal":167070,"en":"When the Muslim faithful stood assembled,"},{"id":"semetey-1-2013:p1178:b004:l014","ordinal":167071,"en":"Akun Khan, khan of Afghanistan,"},{"id":"semetey-1-2013:p1178:b004:l015","ordinal":167072,"en":"Spoke at length of his solemn pledge"},{"id":"semetey-1-2013:p1178:b004:l016","ordinal":167073,"en":"To the hero, bloodthirsty Manas:"},{"id":"semetey-1-2013:p1178:b004:l017","ordinal":167074,"en":"“Hear the end of my words, Khoja;"},{"id":"semetey-1-2013:p1178:b004:l018","ordinal":167075,"en":"Yet my words are not exhausted."},{"id":"semetey-1-2013:p1178:b004:l019","ordinal":167076,"en":"At Khan Kökötöy’s funeral feast,"},{"id":"semetey-1-2013:p1178:b004:l020","ordinal":167077,"en":"Before the great assembly,"},{"id":"semetey-1-2013:p1178:b004:l021","ordinal":167078,"en":"Bloodthirsty Manas and Akun"},{"id":"semetey-1-2013:p1178:b004:l022","ordinal":167079,"en":"Once became pledged in betrothal."},{"id":"semetey-1-2013:p1178:b006:l001","ordinal":167080,"en":"Akun rose and said this:"},{"id":"semetey-1-2013:p1178:b006:l002","ordinal":167081,"en":"“A star moved in the heavens;"},{"id":"semetey-1-2013:p1178:b006:l003","ordinal":167082,"en":"Manas and Akun Khan"},{"id":"semetey-1-2013:p1178:b006:l004","ordinal":167083,"en":"Became friends until the next world."},{"id":"semetey-1-2013:p1178:b006:l005","ordinal":167084,"en":"You gave Koshoy, khan of Katagan,"},{"id":"semetey-1-2013:p1178:b006:l006","ordinal":167085,"en":"A pair of leather wrestling breeches,"},{"id":"semetey-1-2013:p1178:b006:l007","ordinal":167086,"en":"And truly received the blessing"},{"id":"semetey-1-2013:p1178:b006:l008","ordinal":167087,"en":"Of Koshoy, father of the people."},{"id":"semetey-1-2013:p1178:b006:l009","ordinal":167088,"en":"Now, snow-leopard Manas,"},{"id":"semetey-1-2013:p1178:b006:l010","ordinal":167089,"en":"You have been granted a child."},{"id":"semetey-1-2013:p1178:b006:l011","ordinal":167090,"en":"During the summer just past,"},{"id":"semetey-1-2013:p1178:b006:l012","ordinal":167091,"en":"When the people moved toward the highlands,"},{"id":"semetey-1-2013:p1178:b007:l001","ordinal":167092,"en":"In the season when horses’ coats turn dark,"},{"id":"semetey-1-2013:p1178:b007:l002","ordinal":167093,"en":"At Belendi’s Pass,"},{"id":"semetey-1-2013:p1178:b007:l003","ordinal":167094,"en":"Watching argali and chasing gazelles,"},{"id":"semetey-1-2013:p1178:b007:l004","ordinal":167095,"en":"At the place where I hunted game,"},{"id":"semetey-1-2013:p1178:b007:l005","ordinal":167096,"en":"Upon the ridge of Belesche,"},{"id":"semetey-1-2013:p1178:b007:l006","ordinal":167097,"en":"Where the wolf cubs played,"},{"id":"semetey-1-2013:p1178:b007:l007","ordinal":167098,"en":"As I rode toward a certain place,"},{"id":"semetey-1-2013:p1178:b007:l008","ordinal":167099,"en":"A whirlwind was dancing there."},{"id":"semetey-1-2013:p1178:b007:l009","ordinal":167100,"en":"On the slope of Uluu-Too,"},{"id":"semetey-1-2013:p1178:b007:l010","ordinal":167101,"en":"A gathering seemed to be celebrating."},{"id":"semetey-1-2013:p1178:b007:l011","ordinal":167102,"en":"When I rode up and looked,"},{"id":"semetey-1-2013:p1178:b007:l012","ordinal":167103,"en":"Wrapped in a piece of felt,"},{"id":"semetey-1-2013:p1179:b003:l001","ordinal":167104,"en":"A baby lay there."},{"id":"semetey-1-2013:p1179:b003:l002","ordinal":167105,"en":"When I asked, ‘Is it a boy?’ it was a girl,"},{"id":"semetey-1-2013:p1179:b003:l003","ordinal":167106,"en":"The finest among womankind,"},{"id":"semetey-1-2013:p1179:b003:l004","ordinal":167107,"en":"One born of heroes."},{"id":"semetey-1-2013:p1179:b003:l005","ordinal":167108,"en":"‘She is a daughter of the wolf,’"},{"id":"semetey-1-2013:p1179:b003:l006","ordinal":167109,"en":"Was what the heroes said;"},{"id":"semetey-1-2013:p1179:b003:l007","ordinal":167110,"en":"And that was exactly what she was."},{"id":"semetey-1-2013:p1179:b003:l008","ordinal":167111,"en":"Every thought came into my mind:"},{"id":"semetey-1-2013:p1179:b003:l009","ordinal":167112,"en":"Before she should go away to a husband,"},{"id":"semetey-1-2013:p1179:b003:l010","ordinal":167113,"en":"I wished to share in her joys."},{"id":"semetey-1-2013:p1179:b003:l011","ordinal":167114,"en":"Manas was my friend until Judgment Day;"},{"id":"semetey-1-2013:p1179:b003:l012","ordinal":167115,"en":"If Manas should have a son,"},{"id":"semetey-1-2013:p1179:b003:l013","ordinal":167116,"en":"I wished to give her as his bride."},{"id":"semetey-1-2013:p1179:b003:l014","ordinal":167117,"en":"This is the matter I have to tell."},{"id":"semetey-1-2013:p1179:b003:l015","ordinal":167118,"en":"Before God Most High, for the only child,"},{"id":"semetey-1-2013:p1179:b003:l016","ordinal":167119,"en":"I once made that promise."},{"id":"semetey-1-2013:p1179:b003:l017","ordinal":167120,"en":"Having found Chürök and brought her home,"},{"id":"semetey-1-2013:p1179:b003:l018","ordinal":167121,"en":"I slaughtered ninety beasts for her feast."},{"id":"semetey-1-2013:p1179:b003:l019","ordinal":167122,"en":"Saying, ‘My senior wife has borne a maiden,’"},{"id":"semetey-1-2013:p1179:b003:l020","ordinal":167123,"en":"I named her Chürök."},{"id":"semetey-1-2013:p1179:b003:l021","ordinal":167124,"en":"Become my co-father-in-law;"},{"id":"semetey-1-2013:p1179:b003:l022","ordinal":167125,"en":"God has given you a child."},{"id":"semetey-1-2013:p1179:b003:l023","ordinal":167126,"en":"Lion lord, snow leopard,"},{"id":"semetey-1-2013:p1179:b003:l024","ordinal":167127,"en":"Take her to be your daughter-in-law.”"},{"id":"semetey-1-2013:p1179:b003:l025","ordinal":167128,"en":"Akun Khan spoke with pride:"},{"id":"semetey-1-2013:p1179:b003:l026","ordinal":167129,"en":"“The Chürök whom I found"},{"id":"semetey-1-2013:p1179:b003:l027","ordinal":167130,"en":"Is a fitting match for you, Khan Manas.”"},{"id":"semetey-1-2013:p1179:b003:l028","ordinal":167131,"en":"Bloodthirsty snow-leopard Manas,"},{"id":"semetey-1-2013:p1179:b003:l029","ordinal":167132,"en":"Delighted with Akun Khan,"},{"id":"semetey-1-2013:p1179:b003:l030","ordinal":167133,"en":"Drove up seven hundred chestnut horses,"},{"id":"semetey-1-2013:p1179:b003:l031","ordinal":167134,"en":"A sight that distracted all who beheld it."},{"id":"semetey-1-2013:p1179:b003:l032","ordinal":167135,"en":"Among the seven hundred,"},{"id":"semetey-1-2013:p1179:b003:l033","ordinal":167136,"en":"Was a gray stallion of Kambar-Ata’s line;"},{"id":"semetey-1-2013:p1179:b003:l034","ordinal":167137,"en":"He placed the gray stallion at their head,"},{"id":"semetey-1-2013:p1179:b003:l035","ordinal":167138,"en":"And upon the gray stallion’s head"},{"id":"semetey-1-2013:p1179:b003:l036","ordinal":167139,"en":"Displayed a blaze as broad as a pail."},{"id":"semetey-1-2013:p1179:b003:l037","ordinal":167140,"en":"He gave six hundred piebald horses,"},{"id":"semetey-1-2013:p1179:b003:l038","ordinal":167141,"en":"Drove the livestock and became his co-father-in-law."},{"id":"semetey-1-2013:p1179:b005:l001","ordinal":167142,"en":"Great Manas bowed in homage,"},{"id":"semetey-1-2013:p1179:b005:l002","ordinal":167143,"en":"Folded his hands and tasted the ceremonial fat."},{"id":"semetey-1-2013:p1179:b005:l003","ordinal":167144,"en":"Many words remain if one attends to them;"},{"id":"semetey-1-2013:p1179:b005:l004","ordinal":167145,"en":"This was where they became pledged in betrothal."},{"id":"semetey-1-2013:p1179:b005:l005","ordinal":167146,"en":"The matter of that betrothal was settled,"},{"id":"semetey-1-2013:p1179:b005:l006","ordinal":167147,"en":"At the games on Karkyra,"},{"id":"semetey-1-2013:p1179:b005:l007","ordinal":167148,"en":"At Kökötöy’s celebration,"},{"id":"semetey-1-2013:p1179:b005:l008","ordinal":167149,"en":"At Kökötöy’s funeral feast,"},{"id":"semetey-1-2013:p1179:b005:l009","ordinal":167150,"en":"Before the great assembly."},{"id":"semetey-1-2013:p1179:b005:l010","ordinal":167151,"en":"All manner of people were there,"},{"id":"semetey-1-2013:p1179:b005:l011","ordinal":167152,"en":"And the one directing the feast then"},{"id":"semetey-1-2013:p1179:b005:l012","ordinal":167153,"en":"Was generous Khan Manas."},{"id":"semetey-1-2013:p1179:b005:l013","ordinal":167154,"en":"Manas emerged as khan of the Kyrgyz,"},{"id":"semetey-1-2013:p1179:b005:l014","ordinal":167155,"en":"His courage driving the breath from foes."},{"id":"semetey-1-2013:p1179:b005:l015","ordinal":167156,"en":"The Black Kalmyk and Manchu hosts"},{"id":"semetey-1-2013:p1179:b005:l016","ordinal":167157,"en":"Swarmed upon them by force of numbers."},{"id":"semetey-1-2013:p1179:b005:l017","ordinal":167158,"en":"When they were about to plunder and carry all away,"},{"id":"semetey-1-2013:p1179:b005:l018","ordinal":167159,"en":"The sons of the Muslim faith"},{"id":"semetey-1-2013:p1179:b005:l019","ordinal":167160,"en":"Were protected by snow-leopard Manas."},{"id":"semetey-1-2013:p1179:b005:l020","ordinal":167161,"en":"Kökötöy’s gold-crescented"},{"id":"semetey-1-2013:p1179:b005:l021","ordinal":167162,"en":"Crimson banner"},{"id":"semetey-1-2013:p1179:b005:l022","ordinal":167163,"en":"Was raised then by Bokmurun."},{"id":"semetey-1-2013:p1179:b005:l023","ordinal":167164,"en":"The uproar was too great for the earth to bear."},{"id":"semetey-1-2013:p1179:b005:l024","ordinal":167165,"en":"He had fire struck from the flint,"},{"id":"semetey-1-2013:p1179:b005:l025","ordinal":167166,"en":"Bokmurun, the rich man’s son,"},{"id":"semetey-1-2013:p1179:b005:l026","ordinal":167167,"en":"Summoned infidel and Muslim alike,"},{"id":"semetey-1-2013:p1179:b005:l027","ordinal":167168,"en":"Inviting every one without exception."}]
