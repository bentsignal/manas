[{"id":"semetey-1-2013:p0114:b004:l020","ordinal":85505,"en":"When they drove them into the foothills,"},{"id":"semetey-1-2013:p0114:b004:l021","ordinal":85506,"en":"On the narrow road of Zhangyryk,"},{"id":"semetey-1-2013:p0114:b004:l022","ordinal":85507,"en":"There was a black rock like a small yurt."},{"id":"semetey-1-2013:p0114:b004:l023","ordinal":85508,"en":"The tiger-like smith Bölökbay"},{"id":"semetey-1-2013:p0114:b004:l024","ordinal":85509,"en":"Had blocked their path."},{"id":"semetey-1-2013:p0114:b004:l025","ordinal":85510,"en":"Abyke's forty marksmen,"},{"id":"semetey-1-2013:p0114:b004:l026","ordinal":85511,"en":"The hero Köbösh's many marksmen,"},{"id":"semetey-1-2013:p0114:b004:l027","ordinal":85512,"en":"Köbösh had driven there."},{"id":"semetey-1-2013:p0114:b004:l028","ordinal":85513,"en":"In the days of Khan Manas,"},{"id":"semetey-1-2013:p0114:b004:l029","ordinal":85514,"en":"He had often entered battle against a shooting enemy."},{"id":"semetey-1-2013:p0114:b004:l030","ordinal":85515,"en":"Bölökbay had become a practiced fighter."},{"id":"semetey-1-2013:p0114:b004:l032","ordinal":85516,"en":"Knowing the hiding places well,"},{"id":"semetey-1-2013:p0114:b004:l033","ordinal":85517,"en":"Bölökbay had become experienced."},{"id":"semetey-1-2013:p0114:b004:l034","ordinal":85518,"en":"When he aimed, his gun never fired in vain;"},{"id":"semetey-1-2013:p0114:b004:l035","ordinal":85519,"en":"When he shot, his bullet never returned empty."},{"id":"semetey-1-2013:p0114:b004:l036","ordinal":85520,"en":"That mighty smith Bölökbay"},{"id":"semetey-1-2013:p0114:b004:l037","ordinal":85521,"en":"Had blocked the mountain pass."},{"id":"semetey-1-2013:p0114:b004:l038","ordinal":85522,"en":"Tormenting them with torment,"},{"id":"semetey-1-2013:p0114:b004:l039","ordinal":85523,"en":"Overpowering them with violence,"},{"id":"semetey-1-2013:p0115:b003:l001","ordinal":85524,"en":"Abyke and Köbösh, the six scoundrels,"},{"id":"semetey-1-2013:p0115:b003:l002","ordinal":85525,"en":"Had driven forty marksmen there."},{"id":"semetey-1-2013:p0115:b003:l003","ordinal":85526,"en":"That mighty smith Bölökbay,"},{"id":"semetey-1-2013:p0115:b003:l004","ordinal":85527,"en":"Your poor man upon the cliff,"},{"id":"semetey-1-2013:p0115:b003:l005","ordinal":85528,"en":"Upon the scoundrels Abyke and Köbösh,"},{"id":"semetey-1-2013:p0115:b003:l006","ordinal":85529,"en":"Had brought the Day of Judgment."},{"id":"semetey-1-2013:p0115:b003:l007","ordinal":85530,"en":"Köbösh's forty marksmen,"},{"id":"semetey-1-2013:p0115:b003:l008","ordinal":85531,"en":"Bölökbay upon the cliff"},{"id":"semetey-1-2013:p0115:b003:l009","ordinal":85532,"en":"Had slaughtered, letting none escape."},{"id":"semetey-1-2013:p0115:b003:l010","ordinal":85533,"en":"Abyke's forty warriors"},{"id":"semetey-1-2013:p0115:b003:l011","ordinal":85534,"en":"He had shot down in the foothills."},{"id":"semetey-1-2013:p0115:b003:l012","ordinal":85535,"en":"Bölökbay's forty guards"},{"id":"semetey-1-2013:p0115:b003:l013","ordinal":85536,"en":"He had brought through alive."},{"id":"semetey-1-2013:p0115:b003:l014","ordinal":85537,"en":"That Bakay had come,"},{"id":"semetey-1-2013:p0115:b003:l015","ordinal":85538,"en":"That God had granted his wish,"},{"id":"semetey-1-2013:p0115:b003:l016","ordinal":85539,"en":"He saw from the foothills."},{"id":"semetey-1-2013:p0115:b003:l017","ordinal":85540,"en":"The forty guards took counsel:"},{"id":"semetey-1-2013:p0115:b003:l018","ordinal":85541,"en":"“Bölökbay, you were khan to us all."},{"id":"semetey-1-2013:p0115:b003:l019","ordinal":85542,"en":"While sovereign Manas lived,"},{"id":"semetey-1-2013:p0115:b003:l020","ordinal":85543,"en":"You were a friend of David,"},{"id":"semetey-1-2013:p0115:b003:l021","ordinal":85544,"en":"A man like a prophet."},{"id":"semetey-1-2013:p0115:b003:l022","ordinal":85545,"en":"Smoke rises from that bluff;"},{"id":"semetey-1-2013:p0115:b003:l023","ordinal":85546,"en":"With a reddish bay horse,"},{"id":"semetey-1-2013:p0115:b003:l024","ordinal":85547,"en":"A stately man is visible."},{"id":"semetey-1-2013:p0115:b003:l025","ordinal":85548,"en":"It may be the hero Bakay himself,"},{"id":"semetey-1-2013:p0115:b003:l026","ordinal":85549,"en":"With the orphan and the widow,"},{"id":"semetey-1-2013:p0115:b003:l027","ordinal":85550,"en":"Perhaps he is bringing them through."},{"id":"semetey-1-2013:p0115:b003:l028","ordinal":85551,"en":"As I judge his appearance,"},{"id":"semetey-1-2013:p0115:b003:l029","ordinal":85552,"en":"He seems like Bakay."},{"id":"semetey-1-2013:p0115:b003:l030","ordinal":85553,"en":"Can it be my sovereign himself?"},{"id":"semetey-1-2013:p0115:b003:l031","ordinal":85554,"en":"Look closely, forty guards:"},{"id":"semetey-1-2013:p0115:b003:l032","ordinal":85555,"en":"His outline, his bearing,"},{"id":"semetey-1-2013:p0115:b003:l033","ordinal":85556,"en":"His appearance upon horseback—"},{"id":"semetey-1-2013:p0115:b003:l034","ordinal":85557,"en":"It is my elder Bakay himself."},{"id":"semetey-1-2013:p0115:b003:l035","ordinal":85558,"en":"Finding those fugitives,"},{"id":"semetey-1-2013:p0115:b003:l036","ordinal":85559,"en":"My elder, without despairing,"},{"id":"semetey-1-2013:p0115:b003:l037","ordinal":85560,"en":"Has been preparing horses."},{"id":"semetey-1-2013:p0115:b003:l038","ordinal":85561,"en":"The orphan and the widow,"},{"id":"semetey-1-2013:p0115:b003:l039","ordinal":85562,"en":"It is time to send them on their way."},{"id":"semetey-1-2013:p0115:b005:l001","ordinal":85563,"en":"Unless he sends them on and gains peace,"},{"id":"semetey-1-2013:p0115:b005:l002","ordinal":85564,"en":"Otherwise Bakay the tiger"},{"id":"semetey-1-2013:p0115:b005:l003","ordinal":85565,"en":"Seems ready to die."},{"id":"semetey-1-2013:p0115:b005:l004","ordinal":85566,"en":"My sorrow-stricken sister-in-law,"},{"id":"semetey-1-2013:p0115:b005:l005","ordinal":85567,"en":"My tiger-like elder, Khan Bakay,"},{"id":"semetey-1-2013:p0115:b005:l006","ordinal":85568,"en":"Seems to be sending her on her way."},{"id":"semetey-1-2013:p0115:b005:l007","ordinal":85569,"en":"‘I shall come to meet them,’ he said."},{"id":"semetey-1-2013:p0115:b005:l008","ordinal":85570,"en":"O Almighty, Bahauddin!"},{"id":"semetey-1-2013:p0115:b005:l009","ordinal":85571,"en":"Now he has come to us."},{"id":"semetey-1-2013:p0115:b005:l010","ordinal":85572,"en":"It is my elder Bakay himself;"},{"id":"semetey-1-2013:p0115:b005:l011","ordinal":85573,"en":"Not merely himself—his very dark eyes!”"},{"id":"semetey-1-2013:p0115:b005:l012","ordinal":85574,"en":"The mighty hero Bölökbay,"},{"id":"semetey-1-2013:p0115:b005:l013","ordinal":85575,"en":"And the forty guards who supported him,"},{"id":"semetey-1-2013:p0115:b005:l014","ordinal":85576,"en":"Made toward Khan Bakay."},{"id":"semetey-1-2013:p0115:b005:l015","ordinal":85577,"en":"All ran with a clatter,"},{"id":"semetey-1-2013:p0115:b005:l016","ordinal":85578,"en":"Shouting, “Manas! Manas!”"},{"id":"semetey-1-2013:p0115:b005:l017","ordinal":85579,"en":"Calling “Manas!” as their battle cry,"},{"id":"semetey-1-2013:p0115:b005:l018","ordinal":85580,"en":"Shouting their cry as they ran."},{"id":"semetey-1-2013:p0115:b005:l019","ordinal":85581,"en":"Robbed of his treasury,"},{"id":"semetey-1-2013:p0115:b005:l020","ordinal":85582,"en":"Grief-stricken Bölökbay,"},{"id":"semetey-1-2013:p0115:b005:l021","ordinal":85583,"en":"When he saw Khan Bakay,"},{"id":"semetey-1-2013:p0115:b005:l022","ordinal":85584,"en":"Bölökbay burst into tears."},{"id":"semetey-1-2013:p0115:b005:l023","ordinal":85585,"en":"“Elder Bakay, you leopard,"},{"id":"semetey-1-2013:p0115:b005:l024","ordinal":85586,"en":"The forty companions left by Manas"},{"id":"semetey-1-2013:p0115:b005:l025","ordinal":85587,"en":"Have shown themselves to be unruly."},{"id":"semetey-1-2013:p0115:b005:l026","ordinal":85588,"en":"Manas the leopard, favored by Kyzyr,"},{"id":"semetey-1-2013:p0115:b005:l027","ordinal":85589,"en":"Now we know that he is gone!"},{"id":"semetey-1-2013:p0115:b005:l028","ordinal":85590,"en":"The forty guards beside him, his companions,"},{"id":"semetey-1-2013:p0115:b005:l029","ordinal":85591,"en":"Elder Bakay, I prepared as though I would never die."},{"id":"semetey-1-2013:p0115:b005:l030","ordinal":85592,"en":"For twelve days we exchanged fire;"},{"id":"semetey-1-2013:p0115:b005:l031","ordinal":85593,"en":"Only at death's door did I escape those dogs!"},{"id":"semetey-1-2013:p0115:b005:l032","ordinal":85594,"en":"Elder Bakay, I had my muscles spoiled by fire."},{"id":"semetey-1-2013:p0115:b005:l033","ordinal":85595,"en":"It was God's decree."},{"id":"semetey-1-2013:p0115:b005:l034","ordinal":85596,"en":"In my grief, finding no hero like you,"},{"id":"semetey-1-2013:p0115:b005:l035","ordinal":85597,"en":"All my ribs"},{"id":"semetey-1-2013:p0115:b005:l036","ordinal":85598,"en":"Were torn away by arrows."},{"id":"semetey-1-2013:p0115:b005:l037","ordinal":85599,"en":"A deep pit has been dug for me,"},{"id":"semetey-1-2013:p0115:b005:l038","ordinal":85600,"en":"No steadfast hero like you came to my treasury,"},{"id":"semetey-1-2013:p0116:b003:l001","ordinal":85601,"en":"Bölökbay has layer upon layer of boiling sorrow."},{"id":"semetey-1-2013:p0116:b003:l003","ordinal":85602,"en":"Parted from the treasure and possessions,"},{"id":"semetey-1-2013:p0116:b003:l004","ordinal":85603,"en":"I have been left wandering in the wilderness."},{"id":"semetey-1-2013:p0116:b003:l005","ordinal":85604,"en":"Elder Bakay, Semetey, left by the generous hero,"},{"id":"semetey-1-2013:p0116:b003:l007","ordinal":85605,"en":"When he comes in days to come,"},{"id":"semetey-1-2013:p0116:b003:l008","ordinal":85606,"en":"‘Elder Bölökbay, favored by Kyzyr,"},{"id":"semetey-1-2013:p0116:b003:l009","ordinal":85607,"en":"You were a friend of David,"},{"id":"semetey-1-2013:p0116:b003:l010","ordinal":85608,"en":"Where is my treasury?’—when he says that,"},{"id":"semetey-1-2013:p0116:b003:l011","ordinal":85609,"en":"If my appointed death arrives, I shall die."},{"id":"semetey-1-2013:p0116:b003:l012","ordinal":85610,"en":"To that one child, Semetey,"},{"id":"semetey-1-2013:p0116:b003:l013","ordinal":85611,"en":"What answer shall I give?"},{"id":"semetey-1-2013:p0116:b003:l014","ordinal":85612,"en":"Elder Bakay, God has robbed me of my means;"},{"id":"semetey-1-2013:p0116:b003:l015","ordinal":85613,"en":"Allah has exhausted my words."},{"id":"semetey-1-2013:p0116:b003:l016","ordinal":85614,"en":"When my orphan reaches twelve,"},{"id":"semetey-1-2013:p0116:b003:l017","ordinal":85615,"en":"And asks, ‘Where is my treasury?’"},{"id":"semetey-1-2013:p0116:b003:l018","ordinal":85616,"en":"Elder Bakay, find me some way out."},{"id":"semetey-1-2013:p0116:b003:l019","ordinal":85617,"en":"When my sister-in-law, fierce Kanykey, comes,"},{"id":"semetey-1-2013:p0116:b003:l020","ordinal":85618,"en":"What words shall I say!"},{"id":"semetey-1-2013:p0116:b003:l021","ordinal":85619,"en":"Elder Bakay, I was struck on my right side."},{"id":"semetey-1-2013:p0116:b003:l022","ordinal":85620,"en":"The gathered gold and wealth"},{"id":"semetey-1-2013:p0116:b003:l023","ordinal":85621,"en":"I lost to your dogs."},{"id":"semetey-1-2013:p0116:b003:l024","ordinal":85622,"en":"The gold gathered beyond counting,"},{"id":"semetey-1-2013:p0116:b003:l025","ordinal":85623,"en":"Hacking with battle-axes and battering,"},{"id":"semetey-1-2013:p0116:b003:l026","ordinal":85624,"en":"The scoundrels plundered and took it."},{"id":"semetey-1-2013:p0116:b003:l027","ordinal":85625,"en":"Without a renowned lion like you,"},{"id":"semetey-1-2013:p0116:b003:l028","ordinal":85626,"en":"I have been left to suffer torment."},{"id":"semetey-1-2013:p0116:b003:l029","ordinal":85627,"en":"Finding no support to brace myself upon,"},{"id":"semetey-1-2013:p0116:b003:l030","ordinal":85628,"en":"To bind up my waist,"},{"id":"semetey-1-2013:p0116:b003:l031","ordinal":85629,"en":"To slaughter the six scoundrels,"},{"id":"semetey-1-2013:p0116:b003:l032","ordinal":85630,"en":"Finding no renowned hero like you,"},{"id":"semetey-1-2013:p0116:b003:l033","ordinal":85631,"en":"Skirting the cliffs of Zhangyryk,"},{"id":"semetey-1-2013:p0116:b003:l034","ordinal":85632,"en":"Leaning upon Boz-Kelte,"},{"id":"semetey-1-2013:p0116:b003:l035","ordinal":85633,"en":"I escaped from the pass.”"},{"id":"semetey-1-2013:p0116:b003:l036","ordinal":85634,"en":"Then Bölökbay wept and lamented."},{"id":"semetey-1-2013:p0116:b003:l037","ordinal":85635,"en":"Looking at the forty warriors,"},{"id":"semetey-1-2013:p0116:b003:l038","ordinal":85636,"en":"They had no fur caps, their heads were bare."},{"id":"semetey-1-2013:p0116:b004:l001","ordinal":85637,"en":"Some had no trousers and were naked."},{"id":"semetey-1-2013:p0116:b004:l002","ordinal":85638,"en":"Looking at some—"},{"id":"semetey-1-2013:p0116:b004:l003","ordinal":85639,"en":"They were barefoot and bareheaded."},{"id":"semetey-1-2013:p0116:b004:l004","ordinal":85640,"en":"Looking at some—"},{"id":"semetey-1-2013:p0116:b004:l005","ordinal":85641,"en":"Their muscles were ruined by bullets."},{"id":"semetey-1-2013:p0116:b004:l006","ordinal":85642,"en":"Looking at some—"},{"id":"semetey-1-2013:p0116:b004:l007","ordinal":85643,"en":"The backs of their knees were torn by arrows."},{"id":"semetey-1-2013:p0116:b004:l008","ordinal":85644,"en":"In utter turmoil and dust,"},{"id":"semetey-1-2013:p0116:b004:l009","ordinal":85645,"en":"Looking at their whole bodies—"},{"id":"semetey-1-2013:p0116:b004:l010","ordinal":85646,"en":"They were red buckets of blood."},{"id":"semetey-1-2013:p0116:b004:l011","ordinal":85647,"en":"Looking at both their hands—"},{"id":"semetey-1-2013:p0116:b004:l012","ordinal":85648,"en":"They hung paralyzed, unable to rise."},{"id":"semetey-1-2013:p0116:b004:l013","ordinal":85649,"en":"Looking at their whole bodies—"},{"id":"semetey-1-2013:p0116:b004:l014","ordinal":85650,"en":"With the hero Bölökbay at their head,"},{"id":"semetey-1-2013:p0116:b004:l015","ordinal":85651,"en":"They were stunned, unable to stir."},{"id":"semetey-1-2013:p0116:b004:l016","ordinal":85652,"en":"When the dogs attacked them unexpectedly,"},{"id":"semetey-1-2013:p0116:b004:l017","ordinal":85653,"en":"Their dear lives were sorely pressed."},{"id":"semetey-1-2013:p0116:b004:l018","ordinal":85654,"en":"As they fled in panic,"},{"id":"semetey-1-2013:p0116:b004:l019","ordinal":85655,"en":"They had exchanged fire for twelve days,"},{"id":"semetey-1-2013:p0116:b004:l020","ordinal":85656,"en":"And barely escaped death."},{"id":"semetey-1-2013:p0116:b004:l021","ordinal":85657,"en":"With no bluff in which to hide,"},{"id":"semetey-1-2013:p0116:b004:l022","ordinal":85658,"en":"They had become destitute."},{"id":"semetey-1-2013:p0116:b004:l023","ordinal":85659,"en":"Bölökbay and his forty guards"},{"id":"semetey-1-2013:p0116:b004:l024","ordinal":85660,"en":"Had become gaunt."},{"id":"semetey-1-2013:p0116:b004:l025","ordinal":85661,"en":"For seven days in the fighting,"},{"id":"semetey-1-2013:p0116:b004:l026","ordinal":85662,"en":"Taking wounds in seventy places,"},{"id":"semetey-1-2013:p0116:b004:l027","ordinal":85663,"en":"They had seen terrible suffering."},{"id":"semetey-1-2013:p0116:b004:l028","ordinal":85664,"en":"They had loaded their baggage upon a calf."},{"id":"semetey-1-2013:p0116:b004:l029","ordinal":85665,"en":"Sheltering in the mountains, fleeing on foot,"},{"id":"semetey-1-2013:p0116:b004:l030","ordinal":85666,"en":"They had suffered a dreadful hell!"},{"id":"semetey-1-2013:p0116:b004:l032","ordinal":85667,"en":"Then the wide world became narrow;"},{"id":"semetey-1-2013:p0116:b004:l033","ordinal":85668,"en":"When those great dogs overwhelmed them,"},{"id":"semetey-1-2013:p0116:b004:l034","ordinal":85669,"en":"The gray-maned prince Bakay,"},{"id":"semetey-1-2013:p0116:b004:l035","ordinal":85670,"en":"They yearned to see him once."},{"id":"semetey-1-2013:p0116:b004:l036","ordinal":85671,"en":"Bölökbay, the treasury's khan,"},{"id":"semetey-1-2013:p0116:b004:l037","ordinal":85672,"en":"Grieved and longed most bitterly."},{"id":"semetey-1-2013:p0116:b004:l038","ordinal":85673,"en":"When he saw Khan Bakay,"},{"id":"semetey-1-2013:p0117:b003:l001","ordinal":85674,"en":"It was like seeing his companion, Khan Manas."},{"id":"semetey-1-2013:p0117:b003:l002","ordinal":85675,"en":"Walking across the slope, taking a shortcut,"},{"id":"semetey-1-2013:p0117:b003:l003","ordinal":85676,"en":"“I shall entrust it to you;"},{"id":"semetey-1-2013:p0117:b003:l004","ordinal":85677,"en":"Give it to my precious Kanykey,” he said."},{"id":"semetey-1-2013:p0117:b003:l005","ordinal":85678,"en":"Then, leading the brown two-year-old wether,"},{"id":"semetey-1-2013:p0117:b003:l006","ordinal":85679,"en":"“Precious elder, Khan Bakay,"},{"id":"semetey-1-2013:p0117:b003:l007","ordinal":85680,"en":"My wing has been broken,"},{"id":"semetey-1-2013:p0117:b003:l008","ordinal":85681,"en":"I have lost my fierce warrior."},{"id":"semetey-1-2013:p0117:b003:l009","ordinal":85682,"en":"My proud back has been firmly broken."},{"id":"semetey-1-2013:p0117:b003:l010","ordinal":85683,"en":"Elder Bakay, my lion-like spirit has been stilled."},{"id":"semetey-1-2013:p0117:b003:l012","ordinal":85684,"en":"Elder Bakay, look:"},{"id":"semetey-1-2013:p0117:b003:l013","ordinal":85685,"en":"My fortune of Kyzyr has fled from over my head."},{"id":"semetey-1-2013:p0117:b003:l015","ordinal":85686,"en":"Your dogs descended upon me"},{"id":"semetey-1-2013:p0117:b003:l016","ordinal":85687,"en":"And scattered my treasury.”"},{"id":"semetey-1-2013:p0117:b003:l017","ordinal":85688,"en":"When Bölökbay spoke thus,"},{"id":"semetey-1-2013:p0117:b003:l018","ordinal":85689,"en":"Your prince, Bakay the leopard,"},{"id":"semetey-1-2013:p0117:b003:l019","ordinal":85690,"en":"“A precious one left by the prince,” he said,"},{"id":"semetey-1-2013:p0117:b003:l020","ordinal":85691,"en":"Seeing Bölökbay and grieving."},{"id":"semetey-1-2013:p0117:b003:l021","ordinal":85692,"en":"“You who pledged your hand to Khojosan,"},{"id":"semetey-1-2013:p0117:b003:l022","ordinal":85693,"en":"Alas, Manas, would that you had not died!"},{"id":"semetey-1-2013:p0117:b003:l023","ordinal":85694,"en":"Parted from the treasury,"},{"id":"semetey-1-2013:p0117:b003:l024","ordinal":85695,"en":"Lame smith Bölökbay,"},{"id":"semetey-1-2013:p0117:b003:l025","ordinal":85696,"en":"Would that you had not been left wandering in the foothills!"},{"id":"semetey-1-2013:p0117:b003:l026","ordinal":85697,"en":"The suffering of six months' journey,"},{"id":"semetey-1-2013:p0117:b003:l027","ordinal":85698,"en":"I was Bakay who knew it."},{"id":"semetey-1-2013:p0117:b003:l028","ordinal":85699,"en":"You whose star stirred in the sky,"},{"id":"semetey-1-2013:p0117:b003:l029","ordinal":85700,"en":"Who were a friend of David,"},{"id":"semetey-1-2013:p0117:b003:l030","ordinal":85701,"en":"You were that leopard, Bölökö."},{"id":"semetey-1-2013:p0117:b003:l031","ordinal":85702,"en":"Beside Zhylgynduu,"},{"id":"semetey-1-2013:p0117:b003:l032","ordinal":85703,"en":"In the plain of broad Talas,"},{"id":"semetey-1-2013:p0117:b003:l033","ordinal":85704,"en":"We used to slice and eat horse rump meat."},{"id":"semetey-1-2013:p0117:b003:l034","ordinal":85705,"en":"While Manas the leopard lived,"},{"id":"semetey-1-2013:p0117:b003:l035","ordinal":85706,"en":"We spoke of crushing the generals."},{"id":"semetey-1-2013:p0117:b003:l036","ordinal":85707,"en":"When hunger came upon us,"},{"id":"semetey-1-2013:p0117:b003:l037","ordinal":85708,"en":"We used to slice and eat horse-rib fat."},{"id":"semetey-1-2013:p0117:b003:l038","ordinal":85709,"en":"While precious Manas lived,"},{"id":"semetey-1-2013:p0117:b003:l039","ordinal":85710,"en":"Not merely these six scoundrels, Bölökbay,"},{"id":"semetey-1-2013:p0117:b004:l001","ordinal":85711,"en":"We spoke of crushing the Kalmyks."},{"id":"semetey-1-2013:p0117:b004:l002","ordinal":85712,"en":"Bölökbay, the dark steel Zulfiqar—"},{"id":"semetey-1-2013:p0117:b004:l003","ordinal":85713,"en":"Where are your days of fighting with it?"},{"id":"semetey-1-2013:p0117:b004:l004","ordinal":85714,"en":"While the leopard lived,"},{"id":"semetey-1-2013:p0117:b004:l005","ordinal":85715,"en":"Against Beijing of the khakan,"},{"id":"semetey-1-2013:p0117:b004:l006","ordinal":85716,"en":"Bölökö, where are your days of assault?"},{"id":"semetey-1-2013:p0117:b004:l007","ordinal":85717,"en":"While your leopard friend lived,"},{"id":"semetey-1-2013:p0117:b004:l008","ordinal":85718,"en":"At the forked ridge and Tal-Choku,"},{"id":"semetey-1-2013:p0117:b004:l009","ordinal":85719,"en":"Why did we not die as we crossed?"},{"id":"semetey-1-2013:p0117:b004:l010","ordinal":85720,"en":"The dark Chinese beyond,"},{"id":"semetey-1-2013:p0117:b004:l011","ordinal":85721,"en":"Why did we not die as we raided them?!"},{"id":"semetey-1-2013:p0117:b004:l012","ordinal":85722,"en":"Puffing up with our noses like leather bottles,"},{"id":"semetey-1-2013:p0117:b004:l013","ordinal":85723,"en":"Why did we not die in our pride?!"},{"id":"semetey-1-2013:p0117:b004:l014","ordinal":85724,"en":"Lovely-eyed young wives and lovely girls,"},{"id":"semetey-1-2013:p0117:b004:l015","ordinal":85725,"en":"Choosing the loveliest among them,"},{"id":"semetey-1-2013:p0117:b004:l016","ordinal":85726,"en":"Why did we not die as we kissed them?!"},{"id":"semetey-1-2013:p0117:b004:l017","ordinal":85727,"en":"While precious Almambet and Chubak"},{"id":"semetey-1-2013:p0117:b004:l018","ordinal":85728,"en":"Were alive, why did we not die?!"},{"id":"semetey-1-2013:p0117:b004:l019","ordinal":85729,"en":"When his fine mustache lay smooth,"},{"id":"semetey-1-2013:p0117:b004:l020","ordinal":85730,"en":"When he set out toward the world beyond,"},{"id":"semetey-1-2013:p0117:b004:l021","ordinal":85731,"en":"When things had grown so hard,"},{"id":"semetey-1-2013:p0117:b004:l022","ordinal":85732,"en":"Before my friend Manas, favored by Kyzyr,"},{"id":"semetey-1-2013:p0117:b004:l023","ordinal":85733,"en":"Why did we not die before him?!"},{"id":"semetey-1-2013:p0117:b004:l024","ordinal":85734,"en":"Bölökbay, moonless darkness blinds the eyes;"},{"id":"semetey-1-2013:p0117:b004:l025","ordinal":85735,"en":"God has smitten the night."},{"id":"semetey-1-2013:p0117:b004:l026","ordinal":85736,"en":"Like a blackened burning ember,"},{"id":"semetey-1-2013:p0117:b004:l027","ordinal":85737,"en":"God has smitten the day."},{"id":"semetey-1-2013:p0117:b004:l028","ordinal":85738,"en":"Parted from the treasury,"},{"id":"semetey-1-2013:p0117:b004:l029","ordinal":85739,"en":"Fleeing on foot in sorrow,"},{"id":"semetey-1-2013:p0117:b004:l030","ordinal":85740,"en":"Turning toward Kara-Kyr,"},{"id":"semetey-1-2013:p0117:b004:l031","ordinal":85741,"en":"Are you my Bölöm, left to lament?"},{"id":"semetey-1-2013:p0117:b004:l032","ordinal":85742,"en":"Hiding my body as broad as Keng-Kol,"},{"id":"semetey-1-2013:p0117:b004:l033","ordinal":85743,"en":"The stately fierce woman,"},{"id":"semetey-1-2013:p0117:b004:l034","ordinal":85744,"en":"The child without good fortune,"},{"id":"semetey-1-2013:p0117:b004:l035","ordinal":85745,"en":"Making them flee Keng-Kol on foot,"},{"id":"semetey-1-2013:p0117:b004:l036","ordinal":85746,"en":"Grieving, unable to find provisions,"},{"id":"semetey-1-2013:p0117:b004:l037","ordinal":85747,"en":"Am I Bakay, left to grieve?"},{"id":"semetey-1-2013:p0117:b004:l038","ordinal":85748,"en":"Your steel blunted,"},{"id":"semetey-1-2013:p0117:b004:l039","ordinal":85749,"en":"Seven thousand lost,"},{"id":"semetey-1-2013:p0118:b003:l001","ordinal":85750,"en":"Lame smith Bölökbay,"},{"id":"semetey-1-2013:p0118:b003:l002","ordinal":85751,"en":"Are you left to guard the mountain?"},{"id":"semetey-1-2013:p0118:b003:l003","ordinal":85752,"en":"Parted from Semetey,"},{"id":"semetey-1-2013:p0118:b003:l004","ordinal":85753,"en":"Plucking my beard in sorrow,"},{"id":"semetey-1-2013:p0118:b003:l005","ordinal":85754,"en":"Am I Bakay, left to wail?"},{"id":"semetey-1-2013:p0118:b003:l006","ordinal":85755,"en":"Bölökbay, hiding my body as broad as Keng-Kol,"},{"id":"semetey-1-2013:p0118:b003:l008","ordinal":85756,"en":"That afflicted she-wolf,"},{"id":"semetey-1-2013:p0118:b003:l009","ordinal":85757,"en":"Bölökbay, making her flee Keng-Kol on foot,"},{"id":"semetey-1-2013:p0118:b003:l010","ordinal":85758,"en":"Taking her across Zhorgonun-Bel,"},{"id":"semetey-1-2013:p0118:b003:l011","ordinal":85759,"en":"My sorrow-stricken dear friend,"},{"id":"semetey-1-2013:p0118:b003:l012","ordinal":85760,"en":"Making her flee broad Talas,"}]
