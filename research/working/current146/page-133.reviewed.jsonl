{"id": "sayakbay-ms-current146:pdf133:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 133, "folio": 516, "line_in_page": 8, "raw": "Сансыз туру көрүндү.", "text": "Сансыз туру көрүндү.", "en": "Countless troubles came into view.", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; word division, lexical form, or idiomatic interpretation may require review.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf133:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 133, "folio": 516, "line_in_page": 9, "raw": "Ай айладан Төбөлөп,", "text": "Ай айладан Төбөлөп,", "en": "Ah, taking command through cunning,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; word division, lexical form, or idiomatic interpretation may require review.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf133:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 133, "folio": 516, "line_in_page": 10, "raw": "Алуу баркы дагы бар,", "text": "Алуу баркы дагы бар,", "en": "He still possessed the prestige to seize power,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf133:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 133, "folio": 516, "line_in_page": 11, "raw": "Асылым Кенен уул ал.", "text": "Асылым Кенен уул ал.", "en": "That noble one was Kenen’s son.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf133:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 133, "folio": 516, "line_in_page": 12, "raw": "Эки жерин бас экен,", "text": "Эки жерин бас экен,", "en": "He had occupied two lands,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; word division, lexical form, or idiomatic interpretation may require review.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf133:l013", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 133, "folio": 516, "line_in_page": 13, "raw": "Эзелден кытай кас экен,", "text": "Эзелден кытай кас экен,", "en": "From of old the Chinese had been foes,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf133:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 133, "folio": 516, "line_in_page": 14, "raw": "Ала-Тоону кыргызга,", "text": "Ала-Тоону кыргызга,", "en": "As for Ala-Too and the Kyrgyz,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf133:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 133, "folio": 516, "line_in_page": 15, "raw": "Эл болору аз экен.", "text": "Эл болору аз экен.", "en": "Few remained who could become a people.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
