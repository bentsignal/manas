{"id": "sayakbay-ms-current146:pdf096:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 96, "folio": 479, "line_in_page": 33, "raw": "Муну укканда Желжетпес:", "text": "Муну укканда Желжетпес:", "en": "When Jeljetpes heard this:", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
{"id": "sayakbay-ms-current146:pdf096:l034", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 96, "folio": 479, "line_in_page": 34, "raw": "Бар тилегим келди деп,", "text": "Бар тилегим келди деп,", "en": "“All my wishes have come,” he said,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": null, "bbox": null}
