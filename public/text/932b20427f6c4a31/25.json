[{"id":"manas-2010:p0149:b004:l020","ordinal":6401,"en":"The full-grown mighty Kochku—"},{"id":"manas-2010:p0149:b004:l021","ordinal":6402,"en":"Kochku had arrived."},{"id":"manas-2010:p0149:b004:l022","ordinal":6403,"en":"The Kalmyk champion Kochku"},{"id":"manas-2010:p0149:b004:l023","ordinal":6404,"en":"Had raised turmoil."},{"id":"manas-2010:p0149:b004:l024","ordinal":6405,"en":"To bring Jakyp's forty Kyrgyz households"},{"id":"manas-2010:p0149:b004:l025","ordinal":6406,"en":"All together to their end,"},{"id":"manas-2010:p0149:b004:l026","ordinal":6407,"en":"That pig had prepared"},{"id":"manas-2010:p0149:b004:l027","ordinal":6408,"en":"To slaughter every one,"},{"id":"manas-2010:p0149:b004:l028","ordinal":6409,"en":"To plunder their possessions,"},{"id":"manas-2010:p0149:b004:l029","ordinal":6410,"en":"To wreak thorough havoc."},{"id":"manas-2010:p0149:b004:l030","ordinal":6411,"en":"That pig had made ready"},{"id":"manas-2010:p0149:b004:l031","ordinal":6412,"en":"To take Jakyp's livestock"},{"id":"manas-2010:p0149:b004:l032","ordinal":6413,"en":"To Esenkan's treasury,"},{"id":"manas-2010:p0150:b002:l001","ordinal":6414,"en":"To carry them there and put them in."},{"id":"manas-2010:p0150:b002:l002","ordinal":6415,"en":"Kochku came looming,"},{"id":"manas-2010:p0150:b002:l003","ordinal":6416,"en":"His champions towering up,"},{"id":"manas-2010:p0150:b002:l004","ordinal":6417,"en":"Riding a red-chestnut horse,"},{"id":"manas-2010:p0150:b002:l005","ordinal":6418,"en":"Having mounted in wrath,"},{"id":"manas-2010:p0150:b002:l006","ordinal":6419,"en":"Bearing a letter from Esenkan."},{"id":"manas-2010:p0150:b002:l007","ordinal":6420,"en":"What could valiant Kochku do?"},{"id":"manas-2010:p0150:b002:l008","ordinal":6421,"en":"From skilled watchmen,"},{"id":"manas-2010:p0150:b002:l009","ordinal":6422,"en":"From mighty spear wielders,"},{"id":"manas-2010:p0150:b002:l010","ordinal":6423,"en":"Taking about seven hundred troops,"},{"id":"manas-2010:p0150:b002:l011","ordinal":6424,"en":"That Kochku had come,"},{"id":"manas-2010:p0150:b002:l012","ordinal":6425,"en":"His jacket bulging,"},{"id":"manas-2010:p0150:b002:l013","ordinal":6426,"en":"His mail spreading wide."},{"id":"manas-2010:p0150:b002:l014","ordinal":6427,"en":"Dust flew into the sky;"},{"id":"manas-2010:p0150:b002:l015","ordinal":6428,"en":"The army marched in a crowd."},{"id":"manas-2010:p0150:b002:l016","ordinal":6429,"en":"What the soldiers carried"},{"id":"manas-2010:p0150:b002:l017","ordinal":6430,"en":"Were great bows and lacquered arrows."},{"id":"manas-2010:p0150:b002:l018","ordinal":6431,"en":"Upon rich Jakyp's head"},{"id":"manas-2010:p0150:b002:l019","ordinal":6432,"en":"They came and brought trouble."},{"id":"manas-2010:p0150:b002:l020","ordinal":6433,"en":"His roar splitting stones,"},{"id":"manas-2010:p0150:b002:l021","ordinal":6434,"en":"Kochku came in a fury,"},{"id":"manas-2010:p0150:b002:l022","ordinal":6435,"en":"His shout splitting heads:"},{"id":"manas-2010:p0150:b002:l023","ordinal":6436,"en":"‘You bastard, wretched mustache,"},{"id":"manas-2010:p0150:b002:l024","ordinal":6437,"en":"Your conduct is wicked, noisy Burut!"},{"id":"manas-2010:p0150:b002:l025","ordinal":6438,"en":"Keeping livestock like a king,"},{"id":"manas-2010:p0150:b002:l026","ordinal":6439,"en":"You have grown mad,"},{"id":"manas-2010:p0150:b002:l027","ordinal":6440,"en":"Becoming rich after exile to Altai."},{"id":"manas-2010:p0150:b002:l028","ordinal":6441,"en":"Obey what I say, Burut;"},{"id":"manas-2010:p0150:b002:l029","ordinal":6442,"en":"Your unruly son Manas,"},{"id":"manas-2010:p0150:b002:l030","ordinal":6443,"en":"Give him to us now, Burut."},{"id":"manas-2010:p0150:b002:l031","ordinal":6444,"en":"If you do not obey at the first word,"},{"id":"manas-2010:p0150:b002:l032","ordinal":6445,"en":"If you do not hand over Manas,"},{"id":"manas-2010:p0150:b002:l033","ordinal":6446,"en":"I will rage with boundless tyranny"},{"id":"manas-2010:p0150:b002:l034","ordinal":6447,"en":"And bring you all to your end."},{"id":"manas-2010:p0150:b002:l035","ordinal":6448,"en":"You bastard Burut,"},{"id":"manas-2010:p0150:b002:l036","ordinal":6449,"en":"Obey what I say, Burut;"},{"id":"manas-2010:p0150:b002:l037","ordinal":6450,"en":"Give us Manas, Burut."},{"id":"manas-2010:p0150:b002:l038","ordinal":6451,"en":"If you do not obey what I say,"},{"id":"manas-2010:p0150:b002:l039","ordinal":6452,"en":"If you do not give Manas now,"},{"id":"manas-2010:p0150:b002:l040","ordinal":6453,"en":"You were forty Kyrgyz households;"},{"id":"manas-2010:p0150:b002:l041","ordinal":6454,"en":"I will raid your mares in a row,"},{"id":"manas-2010:p0150:b002:l042","ordinal":6455,"en":"I will bring out your far-hidden spite."},{"id":"manas-2010:p0150:b002:l043","ordinal":6456,"en":"If my anger takes hold soon,"},{"id":"manas-2010:p0150:b002:l044","ordinal":6457,"en":"I will punch your brains out!"},{"id":"manas-2010:p0150:b002:l045","ordinal":6458,"en":"Demanding Manas of you,"},{"id":"manas-2010:p0150:b002:l046","ordinal":6459,"en":"I have come to take him, my Burut."},{"id":"manas-2010:p0150:b002:l047","ordinal":6460,"en":"If you do not grant my demand,"},{"id":"manas-2010:p0150:b002:l048","ordinal":6461,"en":"If you do not give what I say,"},{"id":"manas-2010:p0151:b002:l001","ordinal":6462,"en":"I will raise turmoil."},{"id":"manas-2010:p0151:b002:l002","ordinal":6463,"en":"Just watch, my Burut;"},{"id":"manas-2010:p0151:b002:l003","ordinal":6464,"en":"I will plunder your people."},{"id":"manas-2010:p0151:b002:l004","ordinal":6465,"en":"I will dig a well in your place of honor;"},{"id":"manas-2010:p0151:b002:l005","ordinal":6466,"en":"I will scatter your four kinds of stock."},{"id":"manas-2010:p0151:b002:l006","ordinal":6467,"en":"I will make your eyes open wide."},{"id":"manas-2010:p0151:b002:l007","ordinal":6468,"en":"An edict came; I will do this,"},{"id":"manas-2010:p0151:b002:l008","ordinal":6469,"en":"You bastard, wretched Burut."},{"id":"manas-2010:p0151:b002:l009","ordinal":6470,"en":"I will search your bundle."},{"id":"manas-2010:p0151:b002:l010","ordinal":6471,"en":"Esenkan has issued an edict."},{"id":"manas-2010:p0151:b002:l011","ordinal":6472,"en":"I have this authority from Beijing;"},{"id":"manas-2010:p0151:b002:l012","ordinal":6473,"en":"I have my kalday, I have my khan."},{"id":"manas-2010:p0151:b002:l013","ordinal":6474,"en":"Obey these words of mine."},{"id":"manas-2010:p0151:b002:l014","ordinal":6475,"en":"Without making trouble or quarrelling,"},{"id":"manas-2010:p0151:b002:l015","ordinal":6476,"en":"Give Manas to me."},{"id":"manas-2010:p0151:b002:l016","ordinal":6477,"en":"You bastard, wretched Burut,"},{"id":"manas-2010:p0151:b002:l017","ordinal":6478,"en":"You were thus driven from the Kyrgyz;"},{"id":"manas-2010:p0151:b002:l018","ordinal":6479,"en":"You wandered without finding your bounds."},{"id":"manas-2010:p0151:b002:l019","ordinal":6480,"en":"Keeping livestock like a king,"},{"id":"manas-2010:p0151:b002:l020","ordinal":6481,"en":"Around those Altai foothills"},{"id":"manas-2010:p0151:b002:l021","ordinal":6482,"en":"You have been roaming."},{"id":"manas-2010:p0151:b002:l022","ordinal":6483,"en":"Saying, ‘My child's name is Jindi,’"},{"id":"manas-2010:p0151:b002:l023","ordinal":6484,"en":"Our sovereign Esenkan"},{"id":"manas-2010:p0151:b002:l024","ordinal":6485,"en":"You have been deceiving."},{"id":"manas-2010:p0151:b002:l025","ordinal":6486,"en":"Your cunning, from the beginning,"},{"id":"manas-2010:p0151:b002:l026","ordinal":6487,"en":"You have carried to excess."},{"id":"manas-2010:p0151:b002:l027","ordinal":6488,"en":"Your foolish son Manas"},{"id":"manas-2010:p0151:b002:l028","ordinal":6489,"en":"You have been concealing."},{"id":"manas-2010:p0151:b002:l029","ordinal":6490,"en":"Coming to your people and growing rich,"},{"id":"manas-2010:p0151:b002:l030","ordinal":6491,"en":"Your mind at ease every day,"},{"id":"manas-2010:p0151:b002:l031","ordinal":6492,"en":"That was what you meant to do."},{"id":"manas-2010:p0151:b002:l032","ordinal":6493,"en":"To the Kyrgyz left very far away,"},{"id":"manas-2010:p0151:b002:l033","ordinal":6494,"en":"Somehow, one day,"},{"id":"manas-2010:p0151:b002:l034","ordinal":6495,"en":"You meant to depart."},{"id":"manas-2010:p0151:b002:l035","ordinal":6496,"en":"The countless herds gained through gold"},{"id":"manas-2010:p0151:b002:l036","ordinal":6497,"en":"You meant to scatter."},{"id":"manas-2010:p0151:b002:l037","ordinal":6498,"en":"To your open Burut country,"},{"id":"manas-2010:p0151:b002:l038","ordinal":6499,"en":"You bastard, wretched Burut,"},{"id":"manas-2010:p0151:b002:l039","ordinal":6500,"en":"You meant to flee."},{"id":"manas-2010:p0151:b002:l040","ordinal":6501,"en":"Your bloodthirsty son Manas's"},{"id":"manas-2010:p0151:b002:l041","ordinal":6502,"en":"Bloodthirstiness has become known;"},{"id":"manas-2010:p0151:b002:l042","ordinal":6503,"en":"In the mighty lord Esenkan's"},{"id":"manas-2010:p0151:b002:l043","ordinal":6504,"en":"Register it is written."},{"id":"manas-2010:p0151:b002:l044","ordinal":6505,"en":"‘My child's name is Jindi,’ you say,"},{"id":"manas-2010:p0151:b002:l045","ordinal":6506,"en":"You bastard, rich Jakyp;"},{"id":"manas-2010:p0151:b002:l046","ordinal":6507,"en":"What shall I do with your deeds!"},{"id":"manas-2010:p0151:b002:l047","ordinal":6508,"en":"There are words from Esenkan,"},{"id":"manas-2010:p0151:b002:l048","ordinal":6509,"en":"Rich Jakyp of forty Kyrgyz households:"},{"id":"manas-2010:p0152:b002:l001","ordinal":6510,"en":"There is his order to destroy you."},{"id":"manas-2010:p0152:b002:l002","ordinal":6511,"en":"Obey the words spoken;"},{"id":"manas-2010:p0152:b002:l003","ordinal":6512,"en":"Your unruly son Manas,"},{"id":"manas-2010:p0152:b002:l004","ordinal":6513,"en":"Give him to Khan Esenkan."},{"id":"manas-2010:p0152:b002:l005","ordinal":6514,"en":"If you do not obey what he says,"},{"id":"manas-2010:p0152:b002:l006","ordinal":6515,"en":"If you do not give your son,"},{"id":"manas-2010:p0152:b002:l007","ordinal":6516,"en":"I will make trouble and begin a quarrel."},{"id":"manas-2010:p0152:b002:l008","ordinal":6517,"en":"I will put out the fire you lit;"},{"id":"manas-2010:p0152:b002:l009","ordinal":6518,"en":"Into Esenkan's presence"},{"id":"manas-2010:p0152:b002:l010","ordinal":6519,"en":"I will drive you, every soul."},{"id":"manas-2010:p0152:b002:l011","ordinal":6520,"en":"Akbaltay and your rich Jakyp,"},{"id":"manas-2010:p0152:b002:l012","ordinal":6521,"en":"I will deal with you now."},{"id":"manas-2010:p0152:b002:l013","ordinal":6522,"en":"I will draw from your flesh"},{"id":"manas-2010:p0152:b002:l014","ordinal":6523,"en":"The fat that comes from your bones."},{"id":"manas-2010:p0152:b002:l015","ordinal":6524,"en":"The khan's command is Judgment Day."},{"id":"manas-2010:p0152:b002:l016","ordinal":6525,"en":"If you do not give that child,"},{"id":"manas-2010:p0152:b002:l017","ordinal":6526,"en":"I will do violence to your village.’"},{"id":"manas-2010:p0152:b002:l018","ordinal":6527,"en":"His jacket bulging,"},{"id":"manas-2010:p0152:b002:l019","ordinal":6528,"en":"He stood there raging now."},{"id":"manas-2010:p0152:b002:l020","ordinal":6529,"en":"His strength was great, his menace fierce;"},{"id":"manas-2010:p0152:b002:l021","ordinal":6530,"en":"That wrathful unbeliever,"},{"id":"manas-2010:p0152:b002:l022","ordinal":6531,"en":"If he attacked, would slaughter and level all."},{"id":"manas-2010:p0152:b002:l023","ordinal":6532,"en":"He had taken orders from his khan."},{"id":"manas-2010:p0152:b002:l024","ordinal":6533,"en":"When the people saw this champion,"},{"id":"manas-2010:p0152:b002:l025","ordinal":6534,"en":"They despaired of their lives."},{"id":"manas-2010:p0152:b002:l026","ordinal":6535,"en":"Kochku stood thundering;"},{"id":"manas-2010:p0152:b002:l027","ordinal":6536,"en":"From the unbeliever's wrath,"},{"id":"manas-2010:p0152:b002:l028","ordinal":6537,"en":"The earth split with a crash."},{"id":"manas-2010:p0152:b002:l029","ordinal":6538,"en":"Before an eye could blink,"},{"id":"manas-2010:p0152:b002:l030","ordinal":6539,"en":"Before one could say this or that,"},{"id":"manas-2010:p0152:b002:l031","ordinal":6540,"en":"The drum's voice boomed;"},{"id":"manas-2010:p0152:b002:l032","ordinal":6541,"en":"The ringing instrument clattered."},{"id":"manas-2010:p0152:b002:l033","ordinal":6542,"en":"Firing guns and drawing bows,"},{"id":"manas-2010:p0152:b002:l034","ordinal":6543,"en":"Dust whirled into the sky."},{"id":"manas-2010:p0152:b002:l035","ordinal":6544,"en":"His champions all gathered,"},{"id":"manas-2010:p0152:b002:l036","ordinal":6545,"en":"His mighty men in jackets,"},{"id":"manas-2010:p0152:b002:l037","ordinal":6546,"en":"His unbelievers full of wrath."},{"id":"manas-2010:p0152:b002:l038","ordinal":6547,"en":"His champions numbered seven hundred."},{"id":"manas-2010:p0152:b002:l039","ordinal":6548,"en":"The kettledrum was beaten hard."},{"id":"manas-2010:p0152:b002:l040","ordinal":6549,"en":"Tagylyk, who had come as an envoy,"},{"id":"manas-2010:p0152:b002:l041","ordinal":6550,"en":"With the hero Kochku at their head,"},{"id":"manas-2010:p0152:b002:l042","ordinal":6551,"en":"They rushed together to raid the horses."},{"id":"manas-2010:p0152:b002:l043","ordinal":6552,"en":"On the hills were piebald-headed horses;"},{"id":"manas-2010:p0152:b002:l044","ordinal":6553,"en":"Among those horses,"},{"id":"manas-2010:p0152:b002:l045","ordinal":6554,"en":"Argymaks and swift steeds mingled."},{"id":"manas-2010:p0152:b002:l046","ordinal":6555,"en":"Kochku and Tagylyk,"},{"id":"manas-2010:p0152:b002:l047","ordinal":6556,"en":"Leading seven hundred champions,"},{"id":"manas-2010:p0152:b002:l048","ordinal":6557,"en":"Rushed together among the horses,"},{"id":"manas-2010:p0153:b002:l001","ordinal":6558,"en":"Cutting tether lines and raising uproar,"},{"id":"manas-2010:p0153:b002:l002","ordinal":6559,"en":"Putting the forty households to the test."},{"id":"manas-2010:p0153:b002:l003","ordinal":6560,"en":"Having taken orders from his khan,"},{"id":"manas-2010:p0153:b002:l004","ordinal":6561,"en":"He made trouble for rich Jakyp."},{"id":"manas-2010:p0153:b002:l005","ordinal":6562,"en":"Suffering humiliation from the Kalmyks,"},{"id":"manas-2010:p0153:b002:l006","ordinal":6563,"en":"The women and children grieved."},{"id":"manas-2010:p0153:b002:l007","ordinal":6564,"en":"Valiant Baltay and rich Jakyp said:"},{"id":"manas-2010:p0153:b002:l008","ordinal":6565,"en":"‘We have fallen into captivity,’"},{"id":"manas-2010:p0153:b002:l009","ordinal":6566,"en":"Despairing of their precious lives."},{"id":"manas-2010:p0153:b002:l010","ordinal":6567,"en":"‘We have suffered humiliation from Kochku."},{"id":"manas-2010:p0153:b002:l011","ordinal":6568,"en":"If we answer back,"},{"id":"manas-2010:p0153:b002:l012","ordinal":6569,"en":"We shall die, not one left."},{"id":"manas-2010:p0153:b002:l013","ordinal":6570,"en":"If they take the livestock, let the Chinese take them;"},{"id":"manas-2010:p0153:b002:l014","ordinal":6571,"en":"Let them put them in the treasury."},{"id":"manas-2010:p0153:b002:l015","ordinal":6572,"en":"Mighty Allah, Almighty,"},{"id":"manas-2010:p0153:b002:l016","ordinal":6573,"en":"May our precious lives be spared!’ they said."},{"id":"manas-2010:p0153:b002:l017","ordinal":6574,"en":"Kochku began the havoc;"},{"id":"manas-2010:p0153:b002:l018","ordinal":6575,"en":"The dear people, forty Kyrgyz households,"},{"id":"manas-2010:p0153:b002:l019","ordinal":6576,"en":"Gave up hope of life."},{"id":"manas-2010:p0153:b002:l020","ordinal":6577,"en":"From Esenkan's presence,"},{"id":"manas-2010:p0153:b002:l021","ordinal":6578,"en":"Deliberately choosing the Kyrgyz,"},{"id":"manas-2010:p0153:b002:l022","ordinal":6579,"en":"He had come to visit them."},{"id":"manas-2010:p0153:b002:l023","ordinal":6580,"en":"Calamity upon Jakyp—"},{"id":"manas-2010:p0153:b002:l024","ordinal":6581,"en":"He had come to bring it."},{"id":"manas-2010:p0153:b002:l025","ordinal":6582,"en":"To raid his countless herds at once,"},{"id":"manas-2010:p0153:b002:l026","ordinal":6583,"en":"He had come to take them."},{"id":"manas-2010:p0153:b002:l027","ordinal":6584,"en":"Breaking lattice walls and roof poles,"},{"id":"manas-2010:p0153:b002:l028","ordinal":6585,"en":"Making brides and daughters weep,"},{"id":"manas-2010:p0153:b002:l029","ordinal":6586,"en":"The horses at their tethers,"},{"id":"manas-2010:p0153:b002:l030","ordinal":6587,"en":"He raided them all amid uproar."},{"id":"manas-2010:p0153:b002:l031","ordinal":6588,"en":"Before that could be over,"},{"id":"manas-2010:p0153:b002:l032","ordinal":6589,"en":"The twelve-year-old hero Manas,"},{"id":"manas-2010:p0153:b002:l033","ordinal":6590,"en":"Whose mount was Toruchaar,"},{"id":"manas-2010:p0153:b002:l034","ordinal":6591,"en":"Made ready his battle gear,"},{"id":"manas-2010:p0153:b002:l035","ordinal":6592,"en":"Girded on a sword without a sheath."},{"id":"manas-2010:p0153:b002:l036","ordinal":6593,"en":"Like a cloud about to rain again,"},{"id":"manas-2010:p0153:b002:l037","ordinal":6594,"en":"Wrath spread over his face."},{"id":"manas-2010:p0153:b002:l038","ordinal":6595,"en":"Without looking all around,"},{"id":"manas-2010:p0153:b002:l039","ordinal":6596,"en":"Without sparing his life at all,"},{"id":"manas-2010:p0153:b002:l040","ordinal":6597,"en":"Without looking from side to side,"},{"id":"manas-2010:p0153:b002:l041","ordinal":6598,"en":"Without sparing his life a whit:"},{"id":"manas-2010:p0153:b002:l042","ordinal":6599,"en":"‘While I have my strong head,"},{"id":"manas-2010:p0153:b002:l043","ordinal":6600,"en":"How can I give up my swift horse?"},{"id":"manas-2010:p0153:b002:l044","ordinal":6601,"en":"These Kalmyks have grown fierce;"},{"id":"manas-2010:p0153:b002:l045","ordinal":6602,"en":"Let me try a clash with them."},{"id":"manas-2010:p0153:b002:l046","ordinal":6603,"en":"While I have my worthy head,"},{"id":"manas-2010:p0153:b002:l047","ordinal":6604,"en":"How can I give up my livestock?"},{"id":"manas-2010:p0153:b002:l048","ordinal":6605,"en":"Esenkan has gone mad;"},{"id":"manas-2010:p0154:b002:l001","ordinal":6606,"en":"Let me try grappling with him."},{"id":"manas-2010:p0154:b002:l002","ordinal":6607,"en":"Let me bind his champion;"},{"id":"manas-2010:p0154:b002:l003","ordinal":6608,"en":"Upon his Khan Esenkan"},{"id":"manas-2010:p0154:b002:l004","ordinal":6609,"en":"Let me bring calamity."},{"id":"manas-2010:p0154:b002:l005","ordinal":6610,"en":"Dragging him along the road,"},{"id":"manas-2010:p0154:b002:l006","ordinal":6611,"en":"Let me prove myself against the Danggyts."},{"id":"manas-2010:p0154:b002:l007","ordinal":6612,"en":"Let me make the trouble I know;"},{"id":"manas-2010:p0154:b002:l008","ordinal":6613,"en":"Esenkan's champions,"},{"id":"manas-2010:p0154:b002:l009","ordinal":6614,"en":"Let me slaughter them, leaving not one."},{"id":"manas-2010:p0154:b002:l010","ordinal":6615,"en":"These unbelievers have grown fierce."},{"id":"manas-2010:p0154:b002:l011","ordinal":6616,"en":"The unbeliever who came attacking,"},{"id":"manas-2010:p0154:b002:l012","ordinal":6617,"en":"The warrior who raided us himself,"},{"id":"manas-2010:p0154:b002:l013","ordinal":6618,"en":"Let me pursue him as far as Beijing."},{"id":"manas-2010:p0154:b002:l014","ordinal":6619,"en":"The unbelievers in Altai,"},{"id":"manas-2010:p0154:b002:l015","ordinal":6620,"en":"Let me drive and pen them in Kanggay;"},{"id":"manas-2010:p0154:b002:l016","ordinal":6621,"en":"The Black Manchus in Kanggay,"},{"id":"manas-2010:p0154:b002:l017","ordinal":6622,"en":"Let me drive and pen them in Beijing."},{"id":"manas-2010:p0154:b002:l018","ordinal":6623,"en":"If I do not perform this feat,"},{"id":"manas-2010:p0154:b002:l019","ordinal":6624,"en":"If I do not slaughter them just so,"},{"id":"manas-2010:p0154:b002:l020","ordinal":6625,"en":"May I sink away unborn;"},{"id":"manas-2010:p0154:b002:l021","ordinal":6626,"en":"May I die instead of living."},{"id":"manas-2010:p0154:b002:l022","ordinal":6627,"en":"These Chinese have grown eager;"},{"id":"manas-2010:p0154:b002:l023","ordinal":6628,"en":"Let me try a battle of slaughter."},{"id":"manas-2010:p0154:b002:l024","ordinal":6629,"en":"The unbeliever who raided us himself,"},{"id":"manas-2010:p0154:b002:l025","ordinal":6630,"en":"That very champion Kochku—"},{"id":"manas-2010:p0154:b002:l026","ordinal":6631,"en":"For him to raid my horses,"},{"id":"manas-2010:p0154:b002:l027","ordinal":6632,"en":"For him to start the trouble first,"},{"id":"manas-2010:p0154:b002:l028","ordinal":6633,"en":"From that shameless unbeliever"},{"id":"manas-2010:p0154:b002:l029","ordinal":6634,"en":"Did I plunder gold?"},{"id":"manas-2010:p0154:b002:l030","ordinal":6635,"en":"Did I incur some further claim?"},{"id":"manas-2010:p0154:b002:l031","ordinal":6636,"en":"With the mighty Khan Esenkan"},{"id":"manas-2010:p0154:b002:l032","ordinal":6637,"en":"Let me draw the line."},{"id":"manas-2010:p0154:b002:l033","ordinal":6638,"en":"If I let these Chinese have their way,"},{"id":"manas-2010:p0154:b002:l034","ordinal":6639,"en":"They will drive away my livestock."},{"id":"manas-2010:p0154:b002:l035","ordinal":6640,"en":"This pig, may he burn to death,"},{"id":"manas-2010:p0154:b002:l036","ordinal":6641,"en":"Will not leave my life alone."},{"id":"manas-2010:p0154:b002:l037","ordinal":6642,"en":"If I let these Chinese have their way,"},{"id":"manas-2010:p0154:b002:l038","ordinal":6643,"en":"They will begin their sport;"},{"id":"manas-2010:p0154:b002:l039","ordinal":6644,"en":"Upon the Kyrgyz they will wreak"},{"id":"manas-2010:p0154:b002:l040","ordinal":6645,"en":"Havoc no one has ever seen."},{"id":"manas-2010:p0154:b002:l041","ordinal":6646,"en":"Swarming like black spiders,"},{"id":"manas-2010:p0154:b002:l042","ordinal":6647,"en":"These Chinese have multiplied."},{"id":"manas-2010:p0154:b002:l043","ordinal":6648,"en":"Slaughtering, plundering, violating,"},{"id":"manas-2010:p0154:b002:l044","ordinal":6649,"en":"These Chinese are accustomed to it."},{"id":"manas-2010:p0154:b002:l045","ordinal":6650,"en":"While I have my precious head,"},{"id":"manas-2010:p0154:b002:l046","ordinal":6651,"en":"How can I surrender my people?"},{"id":"manas-2010:p0154:b002:l047","ordinal":6652,"en":"If mighty Allah supports me,"},{"id":"manas-2010:p0154:b002:l048","ordinal":6653,"en":"With these seething Chinese"},{"id":"manas-2010:p0155:b002:l001","ordinal":6654,"en":"Let me try to grapple."},{"id":"manas-2010:p0155:b002:l002","ordinal":6655,"en":"Holding a spear and breaking their ranks,"},{"id":"manas-2010:p0155:b002:l003","ordinal":6656,"en":"If death comes, falling to a bullet,"}]
