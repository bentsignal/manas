[{"id":"manas-2010:p0363:b001:l039","ordinal":16641,"en":"Knowing the land, a great traveler,"},{"id":"manas-2010:p0363:b001:l040","ordinal":16642,"en":"He had gone and settled in Beijing."},{"id":"manas-2010:p0363:b001:l041","ordinal":16643,"en":"Because he knew the roads, that swine"},{"id":"manas-2010:p0363:b001:l042","ordinal":16644,"en":"Had gained the name of Zholoy."},{"id":"manas-2010:p0363:b001:l043","ordinal":16645,"en":"If you see Zholoy, do not approach;"},{"id":"manas-2010:p0363:b001:l044","ordinal":16646,"en":"That great glutton has ways of his own."},{"id":"manas-2010:p0363:b001:l045","ordinal":16647,"en":"Countless fescues, eighty grasses—"},{"id":"manas-2010:p0363:b001:l046","ordinal":16648,"en":"Following tracks through yellowed land,"},{"id":"manas-2010:p0363:b001:l047","ordinal":16649,"en":"Countless troops swept over the earth,"},{"id":"manas-2010:p0363:b001:l048","ordinal":16650,"en":"Coming to hem them in."},{"id":"manas-2010:p0364:b001:l001","ordinal":16651,"en":"Forty Kyrgyz households, wealthy Jakyp—"},{"id":"manas-2010:p0364:b001:l002","ordinal":16652,"en":"The tracks they left, warrior Zholoy"},{"id":"manas-2010:p0364:b001:l003","ordinal":16653,"en":"Came pursuing."},{"id":"manas-2010:p0364:b001:l004","ordinal":16654,"en":"Jagged and uneven to the eye,"},{"id":"manas-2010:p0364:b001:l005","ordinal":16655,"en":"On this side of Altai,"},{"id":"manas-2010:p0364:b001:l006","ordinal":16656,"en":"A gaping mountain gorge—"},{"id":"manas-2010:p0364:b001:l007","ordinal":16657,"en":"Their grief was great, their plight was hard;"},{"id":"manas-2010:p0364:b001:l008","ordinal":16658,"en":"The forty migrating Kyrgyz households"},{"id":"manas-2010:p0364:b001:l009","ordinal":16659,"en":"Voiced many a lament!"},{"id":"manas-2010:p0364:b001:l010","ordinal":16660,"en":"Yesterday, when young Manas, Khan Jakyp's son,"},{"id":"manas-2010:p0364:b001:l011","ordinal":16661,"en":"Had done what he had done,"},{"id":"manas-2010:p0364:b001:l012","ordinal":16662,"en":"When Döngö and warrior Kochku"},{"id":"manas-2010:p0364:b001:l013","ordinal":16663,"en":"He had cut down and slaughtered together,"},{"id":"manas-2010:p0364:b001:l014","ordinal":16664,"en":"When Giant Zhoon and Giant Kaman"},{"id":"manas-2010:p0364:b001:l015","ordinal":16665,"en":"He had slaughtered on the pass,"},{"id":"manas-2010:p0364:b001:l016","ordinal":16666,"en":"When Manas struck the Kalmyks,"},{"id":"manas-2010:p0364:b001:l017","ordinal":16667,"en":"When Akbaltay found a plan,"},{"id":"manas-2010:p0364:b001:l018","ordinal":16668,"en":"God's sun clouded in the sky;"},{"id":"manas-2010:p0364:b001:l019","ordinal":16669,"en":"Sixty cares came upon him at once."},{"id":"manas-2010:p0364:b001:l020","ordinal":16670,"en":"Altai was no cherished homeland,"},{"id":"manas-2010:p0364:b001:l021","ordinal":16671,"en":"The Black Kalmyks were no kindred people."},{"id":"manas-2010:p0364:b001:l022","ordinal":16672,"en":"Akbaltay had pondered,"},{"id":"manas-2010:p0364:b001:l023","ordinal":16673,"en":"Riding a stallion along the water,"},{"id":"manas-2010:p0364:b001:l024","ordinal":16674,"en":"Thinking deeply of a better plan:"},{"id":"manas-2010:p0364:b001:l025","ordinal":16675,"en":"To scatter their countless cattle,"},{"id":"manas-2010:p0364:b001:l026","ordinal":16676,"en":"Akbaltay had thought,"},{"id":"manas-2010:p0364:b001:l027","ordinal":16677,"en":"And flee toward the Kyrgyz!"},{"id":"manas-2010:p0364:b001:l028","ordinal":16678,"en":"His son Manas, poison had arisen;"},{"id":"manas-2010:p0364:b001:l029","ordinal":16679,"en":"Uproar arose from broad Altai."},{"id":"manas-2010:p0364:b001:l030","ordinal":16680,"en":"Manas, born in Altai,"},{"id":"manas-2010:p0364:b001:l031","ordinal":16681,"en":"Had thrown the world into commotion."},{"id":"manas-2010:p0364:b001:l032","ordinal":16682,"en":"“He slaughtered those who came,”"},{"id":"manas-2010:p0364:b001:l033","ordinal":16683,"en":"The khan of the unbelievers—"},{"id":"manas-2010:p0364:b001:l034","ordinal":16684,"en":"Khan Esen—had heard it."},{"id":"manas-2010:p0364:b001:l035","ordinal":16685,"en":"From those who went and those who came"},{"id":"manas-2010:p0364:b001:l036","ordinal":16686,"en":"He had heard and weighed his valor."},{"id":"manas-2010:p0364:b001:l037","ordinal":16687,"en":"“He will bring strife to Beijing,”"},{"id":"manas-2010:p0364:b001:l038","ordinal":16688,"en":"Warrior Esenkan then"},{"id":"manas-2010:p0364:b001:l039","ordinal":16689,"en":"Stood out of his wits."},{"id":"manas-2010:p0364:b001:l040","ordinal":16690,"en":"“He will torment the governors-general;"},{"id":"manas-2010:p0364:b001:l041","ordinal":16691,"en":"The governors will be ruined,”"},{"id":"manas-2010:p0364:b001:l042","ordinal":16692,"en":"Esenkan had understood."},{"id":"manas-2010:p0364:b001:l043","ordinal":16693,"en":"“We are forty Kyrgyz households;"},{"id":"manas-2010:p0364:b001:l044","ordinal":16694,"en":"Let us not suffer needlessly,”"},{"id":"manas-2010:p0364:b001:l045","ordinal":16695,"en":"Wealthy Jakyp, that great schemer,"},{"id":"manas-2010:p0364:b001:l046","ordinal":16696,"en":"Had been deeply troubled."},{"id":"manas-2010:p0364:b001:l047","ordinal":16697,"en":"When Akbaltay devised his plan,"},{"id":"manas-2010:p0364:b001:l048","ordinal":16698,"en":"He gelded stallions into riding horses,"},{"id":"manas-2010:p0365:b001:l001","ordinal":16699,"en":"To migrate away from Altai,"},{"id":"manas-2010:p0365:b001:l002","ordinal":16700,"en":"He swiftly settled on this plan."},{"id":"manas-2010:p0365:b001:l003","ordinal":16701,"en":"He castrated rams into wethers,"},{"id":"manas-2010:p0365:b001:l004","ordinal":16702,"en":"He fattened all his sheep."},{"id":"manas-2010:p0365:b001:l005","ordinal":16703,"en":"He gelded breeding camels into pack beasts;"},{"id":"manas-2010:p0365:b001:l006","ordinal":16704,"en":"The Black Kalmyks in Altai—"},{"id":"manas-2010:p0365:b001:l007","ordinal":16705,"en":"He raided their horses and left them afoot."},{"id":"manas-2010:p0365:b001:l008","ordinal":16706,"en":"He castrated bulls into cattle,"},{"id":"manas-2010:p0365:b001:l009","ordinal":16707,"en":"Set the few households in commotion,"},{"id":"manas-2010:p0365:b001:l010","ordinal":16708,"en":"Extinguished the fires they had lit."},{"id":"manas-2010:p0365:b001:l011","ordinal":16709,"en":"Wealthy Jakyp was a wise man;"},{"id":"manas-2010:p0365:b001:l012","ordinal":16710,"en":"His Kyrgyz of few households,"},{"id":"manas-2010:p0365:b001:l013","ordinal":16711,"en":"He moved them all together."},{"id":"manas-2010:p0365:b001:l014","ordinal":16712,"en":"Their shitty bundles of belongings,"},{"id":"manas-2010:p0365:b001:l015","ordinal":16713,"en":"He would not keep, but scattered all."},{"id":"manas-2010:p0365:b001:l016","ordinal":16714,"en":"Pasture after pasture, as in a game,"},{"id":"manas-2010:p0365:b001:l017","ordinal":16715,"en":"They fled, migrating as though at play."},{"id":"manas-2010:p0365:b001:l018","ordinal":16716,"en":"Hurting every heart,"},{"id":"manas-2010:p0365:b001:l019","ordinal":16717,"en":"Galling every pack beast,"},{"id":"manas-2010:p0365:b001:l020","ordinal":16718,"en":"Stringing all the livestock out,"},{"id":"manas-2010:p0365:b001:l021","ordinal":16719,"en":"Making all the children cry,"},{"id":"manas-2010:p0365:b001:l022","ordinal":16720,"en":"Without rest throughout the day,"},{"id":"manas-2010:p0365:b001:l023","ordinal":16721,"en":"Without sleep throughout the night,"},{"id":"manas-2010:p0365:b001:l024","ordinal":16722,"en":"Thus they made their migration."},{"id":"manas-2010:p0365:b001:l025","ordinal":16723,"en":"How could the valiant spare themselves?"},{"id":"manas-2010:p0365:b001:l026","ordinal":16724,"en":"They moved without looking back."},{"id":"manas-2010:p0365:b001:l027","ordinal":16725,"en":"Manas had gone to Koshoy;"},{"id":"manas-2010:p0365:b001:l028","ordinal":16726,"en":"Some time had passed since he left."},{"id":"manas-2010:p0365:b001:l029","ordinal":16727,"en":"For Zholoy to send his army,"},{"id":"manas-2010:p0365:b001:l030","ordinal":16728,"en":"To plunder them without restraint,"},{"id":"manas-2010:p0365:b001:l031","ordinal":16729,"en":"Only three days' road remained."},{"id":"manas-2010:p0365:b001:l032","ordinal":16730,"en":"The fortunate one was Kutubiy;"},{"id":"manas-2010:p0365:b001:l033","ordinal":16731,"en":"Kutubiy was the name given him."},{"id":"manas-2010:p0365:b001:l034","ordinal":16732,"en":"The people trusted his words."},{"id":"manas-2010:p0365:b001:l035","ordinal":16733,"en":"He knew letters from opening the Quran,"},{"id":"manas-2010:p0365:b001:l036","ordinal":16734,"en":"He knew God's name by heart."},{"id":"manas-2010:p0365:b001:l037","ordinal":16735,"en":"The bravest of the forty boys,"},{"id":"manas-2010:p0365:b001:l038","ordinal":16736,"en":"To the magnanimous one touched by Kydyr"},{"id":"manas-2010:p0365:b001:l039","ordinal":16737,"en":"His bearing seemed an equal."},{"id":"manas-2010:p0365:b001:l040","ordinal":16738,"en":"He girded white cloth about his waist;"},{"id":"manas-2010:p0365:b001:l041","ordinal":16739,"en":"When uproar split the sky,"},{"id":"manas-2010:p0365:b001:l042","ordinal":16740,"en":"He entered alone and attacked."},{"id":"manas-2010:p0365:b001:l043","ordinal":16741,"en":"Great in courage, fierce in wrath,"},{"id":"manas-2010:p0365:b001:l044","ordinal":16742,"en":"He laid his challengers flat."},{"id":"manas-2010:p0365:b001:l045","ordinal":16743,"en":"When Manas left for Koshoy,"},{"id":"manas-2010:p0365:b001:l046","ordinal":16744,"en":"Clasping his hand tightly,"},{"id":"manas-2010:p0365:b001:l047","ordinal":16745,"en":"Akbaltay and Jakyp—"},{"id":"manas-2010:p0365:b001:l048","ordinal":16746,"en":"That bloodthirsty one had gone,"},{"id":"manas-2010:p0366:b001:l001","ordinal":16747,"en":"Entrusting them to Kutubiy."},{"id":"manas-2010:p0366:b001:l002","ordinal":16748,"en":"At that time Kutubiy,"},{"id":"manas-2010:p0366:b001:l003","ordinal":16749,"en":"Alarmed, recited his prayers,"},{"id":"manas-2010:p0366:b001:l004","ordinal":16750,"en":"And saddled Telkyzyl."},{"id":"manas-2010:p0366:b001:l005","ordinal":16751,"en":"To the winding mountain's spur"},{"id":"manas-2010:p0366:b001:l006","ordinal":16752,"en":"He rode to keep a lookout,"},{"id":"manas-2010:p0366:b001:l007","ordinal":16753,"en":"Upon the jutting headland."},{"id":"manas-2010:p0366:b003:l001","ordinal":16754,"en":"When he climbed and kept his watch,"},{"id":"manas-2010:p0366:b003:l002","ordinal":16755,"en":"Wishing his people safe,"},{"id":"manas-2010:p0366:b003:l003","ordinal":16756,"en":"Gray haze, burning dust,"},{"id":"manas-2010:p0366:b003:l004","ordinal":16757,"en":"A host as dense as ants—"},{"id":"manas-2010:p0366:b003:l005","ordinal":16758,"en":"There was a great trench dug."},{"id":"manas-2010:p0366:b003:l006","ordinal":16759,"en":"Zholoy, the Kalmyk hero—"},{"id":"manas-2010:p0366:b003:l007","ordinal":16760,"en":"As though slaughter had struck,"},{"id":"manas-2010:p0366:b003:l008","ordinal":16761,"en":"The swarming unbelievers"},{"id":"manas-2010:p0366:b003:l009","ordinal":16762,"en":"Had all swept forward."},{"id":"manas-2010:p0366:b003:l010","ordinal":16763,"en":"Their mighty men in jackets"},{"id":"manas-2010:p0366:b003:l011","ordinal":16764,"en":"Had advanced with all their strength."},{"id":"manas-2010:p0366:b003:l012","ordinal":16765,"en":"No mortal had beaten him face to face,"},{"id":"manas-2010:p0366:b003:l013","ordinal":16766,"en":"No one had bent him down and taken him,"},{"id":"manas-2010:p0366:b003:l014","ordinal":16767,"en":"No one who met him had survived;"},{"id":"manas-2010:p0366:b003:l015","ordinal":16768,"en":"His fame was precious, his name weighty."},{"id":"manas-2010:p0366:b003:l016","ordinal":16769,"en":"Appearing when China faced ruin,"},{"id":"manas-2010:p0366:b003:l017","ordinal":16770,"en":"A trick rider, swift on foot,"},{"id":"manas-2010:p0366:b003:l018","ordinal":16771,"en":"His passage a clamorous upheaval,"},{"id":"manas-2010:p0366:b003:l019","ordinal":16772,"en":"Karazhoy of the treasury"},{"id":"manas-2010:p0366:b003:l020","ordinal":16773,"en":"Had raised a mighty tumult."},{"id":"manas-2010:p0366:b003:l021","ordinal":16774,"en":"Mustered from the governors downward,"},{"id":"manas-2010:p0366:b003:l022","ordinal":16775,"en":"They were sweeping forward."},{"id":"manas-2010:p0366:b003:l023","ordinal":16776,"en":"Look at the reeds, look at the flood,"},{"id":"manas-2010:p0366:b003:l024","ordinal":16777,"en":"Shouting “Emperor!” as their battle cry,"},{"id":"manas-2010:p0366:b003:l025","ordinal":16778,"en":"Look at the Chinese people sweeping on!"},{"id":"manas-2010:p0366:b003:l026","ordinal":16779,"en":"Look at the grass upon the earth;"},{"id":"manas-2010:p0366:b003:l027","ordinal":16780,"en":"Look at Chinese countless as the grass."},{"id":"manas-2010:p0366:b003:l028","ordinal":16781,"en":"Look at the trench they have dug;"},{"id":"manas-2010:p0366:b003:l029","ordinal":16782,"en":"Look at the misery they have brewed!"},{"id":"manas-2010:p0366:b003:l030","ordinal":16783,"en":"A white standard comes,"},{"id":"manas-2010:p0366:b003:l031","ordinal":16784,"en":"A shouting uproar comes;"},{"id":"manas-2010:p0366:b003:l032","ordinal":16785,"en":"The sight weighs heavily upon the soul."},{"id":"manas-2010:p0366:b003:l033","ordinal":16786,"en":"When he looked toward the front,"},{"id":"manas-2010:p0366:b003:l034","ordinal":16787,"en":"His arm guards spreading broad,"},{"id":"manas-2010:p0366:b003:l035","ordinal":16788,"en":"Mighty great Zholoy came."},{"id":"manas-2010:p0366:b003:l036","ordinal":16789,"en":"When he looked to this side,"},{"id":"manas-2010:p0366:b003:l037","ordinal":16790,"en":"Ezkara of the Manchus—"},{"id":"manas-2010:p0366:b003:l038","ordinal":16791,"en":"They had all swept forward."},{"id":"manas-2010:p0367:b001:l001","ordinal":16792,"en":"The drums made for battle"},{"id":"manas-2010:p0367:b001:l002","ordinal":16793,"en":"Were beaten hard and thundered."},{"id":"manas-2010:p0367:b001:l003","ordinal":16794,"en":"Wearing dark Kalmyk fur coats,"},{"id":"manas-2010:p0367:b001:l004","ordinal":16795,"en":"The many seething lords"},{"id":"manas-2010:p0367:b001:l005","ordinal":16796,"en":"From a spur of broad Altai"},{"id":"manas-2010:p0367:b001:l006","ordinal":16797,"en":"Came driving onward."},{"id":"manas-2010:p0367:b001:l007","ordinal":16798,"en":"Indistinguishable from insects,"},{"id":"manas-2010:p0367:b001:l008","ordinal":16799,"en":"They came swarming forth."},{"id":"manas-2010:p0367:b001:l009","ordinal":16800,"en":"From the ridge at Tash-Moynok"},{"id":"manas-2010:p0367:b001:l010","ordinal":16801,"en":"Their multitudes came forth;"},{"id":"manas-2010:p0367:b001:l011","ordinal":16802,"en":"From the rugged, hilly headland"},{"id":"manas-2010:p0367:b001:l012","ordinal":16803,"en":"Half of them came forth."},{"id":"manas-2010:p0367:b001:l013","ordinal":16804,"en":"Black summit, black cliff—"},{"id":"manas-2010:p0367:b001:l014","ordinal":16805,"en":"They came boiling out."},{"id":"manas-2010:p0367:b001:l015","ordinal":16806,"en":"One could not tell them apart;"},{"id":"manas-2010:p0367:b001:l016","ordinal":16807,"en":"The clamoring unbelievers"},{"id":"manas-2010:p0367:b001:l017","ordinal":16808,"en":"Came swarming forth."},{"id":"manas-2010:p0367:b001:l018","ordinal":16809,"en":"“When Akbaltay has grown old,"},{"id":"manas-2010:p0367:b001:l019","ordinal":16810,"en":"When wealthy Jakyp has aged,"},{"id":"manas-2010:p0367:b001:l020","ordinal":16811,"en":"Will this army overwhelm them?"},{"id":"manas-2010:p0367:b001:l021","ordinal":16812,"en":"Valiant Manas is absent too."},{"id":"manas-2010:p0367:b001:l022","ordinal":16813,"en":"Will they make sport of our small people"},{"id":"manas-2010:p0367:b001:l023","ordinal":16814,"en":"And slaughter them all?!"},{"id":"manas-2010:p0367:b001:l024","ordinal":16815,"en":"Upon this unwary people"},{"id":"manas-2010:p0367:b001:l025","ordinal":16816,"en":"Will they descend from above?"},{"id":"manas-2010:p0367:b001:l026","ordinal":16817,"en":"Will they scatter their four kinds of livestock?"},{"id":"manas-2010:p0367:b001:l027","ordinal":16818,"en":"Seen just now, now gone—"},{"id":"manas-2010:p0367:b001:l028","ordinal":16819,"en":"Such is this treacherous world."},{"id":"manas-2010:p0367:b001:l029","ordinal":16820,"en":"Renowned Manas is absent too!"},{"id":"manas-2010:p0367:b001:l030","ordinal":16821,"en":"How can I stay and watch?"},{"id":"manas-2010:p0367:b001:l031","ordinal":16822,"en":"To my forty Kyrgyz households"},{"id":"manas-2010:p0367:b001:l032","ordinal":16823,"en":"Let me tell this grievous news!"},{"id":"manas-2010:p0367:b001:l033","ordinal":16824,"en":"Forty boys from forty homes,"},{"id":"manas-2010:p0367:b001:l034","ordinal":16825,"en":"Let me gather them as my support;"},{"id":"manas-2010:p0367:b001:l035","ordinal":16826,"en":"Let me fight without delay."},{"id":"manas-2010:p0367:b001:l036","ordinal":16827,"en":"‘Flee, scatter!’ to my people"},{"id":"manas-2010:p0367:b001:l037","ordinal":16828,"en":"Let me go and give the warning;"},{"id":"manas-2010:p0367:b001:l038","ordinal":16829,"en":"Then turning back to fight,"},{"id":"manas-2010:p0367:b001:l039","ordinal":16830,"en":"Let me return and launch an attack!”"},{"id":"manas-2010:p0367:b001:l040","ordinal":16831,"en":"So Kutubiy said then."},{"id":"manas-2010:p0367:b001:l041","ordinal":16832,"en":"Telkyzyl beneath him,"},{"id":"manas-2010:p0367:b001:l042","ordinal":16833,"en":"A true courser and battle-steed,"},{"id":"manas-2010:p0367:b001:l043","ordinal":16834,"en":"Had appeared from the unseen."},{"id":"manas-2010:p0367:b001:l044","ordinal":16835,"en":"From Kulan-Talaa's sandy desert—"},{"id":"manas-2010:p0367:b001:l045","ordinal":16836,"en":"There was valiant, hapless Manas;"},{"id":"manas-2010:p0367:b001:l046","ordinal":16837,"en":"He and Kutubiy stood together,"},{"id":"manas-2010:p0367:b001:l047","ordinal":16838,"en":"And while they stood embracing,"},{"id":"manas-2010:p0367:b001:l048","ordinal":16839,"en":"Telkyzyl had come trotting up."},{"id":"manas-2010:p0368:b001:l001","ordinal":16840,"en":"At full-grown age, that noble creature,"},{"id":"manas-2010:p0368:b001:l002","ordinal":16841,"en":"As a Buraq-like horse for Kutu,"},{"id":"manas-2010:p0368:b001:l003","ordinal":16842,"en":"His swift steed had thus arrived."},{"id":"manas-2010:p0368:b001:l004","ordinal":16843,"en":"Beneath him, the courser Telkyzyl,"},{"id":"manas-2010:p0368:b001:l005","ordinal":16844,"en":"Had appeared from the unseen,"},{"id":"manas-2010:p0368:b001:l006","ordinal":16845,"en":"Had been found on the open plain."},{"id":"manas-2010:p0368:b001:l007","ordinal":16846,"en":"Racing with wild asses,"},{"id":"manas-2010:p0368:b001:l008","ordinal":16847,"en":"Whatever else, that noble creature"},{"id":"manas-2010:p0368:b001:l009","ordinal":16848,"en":"Was kin to the wondrous coursers,"},{"id":"manas-2010:p0368:b001:l010","ordinal":16849,"en":"Telkyzyl, a courser true."},{"id":"manas-2010:p0368:b001:l011","ordinal":16850,"en":"Kutubiy had seen the enemy."},{"id":"manas-2010:p0368:b001:l012","ordinal":16851,"en":"Whipping this way and that,"},{"id":"manas-2010:p0368:b001:l013","ordinal":16852,"en":"Spurring right and left,"},{"id":"manas-2010:p0368:b001:l014","ordinal":16853,"en":"To his elder, old Baltay,"},{"id":"manas-2010:p0368:b001:l015","ordinal":16854,"en":"To Akbaltay, Jakyp, all of them,"},{"id":"manas-2010:p0368:b001:l016","ordinal":16855,"en":"To the forty households themselves—"},{"id":"manas-2010:p0368:b001:l017","ordinal":16856,"en":"Whoever heard cried out"},{"id":"manas-2010:p0368:b001:l018","ordinal":16857,"en":"At Kutubiy's words."},{"id":"manas-2010:p0368:b001:l019","ordinal":16858,"en":"“Your father's grave, forty households!"},{"id":"manas-2010:p0368:b001:l020","ordinal":16859,"en":"To your old Jakyp, blessed by Kydyr,"},{"id":"manas-2010:p0368:b001:l021","ordinal":16860,"en":"I have come to bring the news,"},{"id":"manas-2010:p0368:b001:l022","ordinal":16861,"en":"To all you forty Kyrgyz households:"},{"id":"manas-2010:p0368:b001:l023","ordinal":16862,"en":"We have encountered inescapable"},{"id":"manas-2010:p0368:b001:l024","ordinal":16863,"en":"Wrath from the one God!"},{"id":"manas-2010:p0368:b001:l025","ordinal":16864,"en":"There is no forest for shelter,"},{"id":"manas-2010:p0368:b001:l026","ordinal":16865,"en":"No Kyrgyz to flee among;"},{"id":"manas-2010:p0368:b001:l027","ordinal":16866,"en":"Grief within me, fire without!"},{"id":"manas-2010:p0368:b001:l028","ordinal":16867,"en":"To grapple and wage battle,"},{"id":"manas-2010:p0368:b001:l029","ordinal":16868,"en":"To stand as our support,"},{"id":"manas-2010:p0368:b001:l030","ordinal":16869,"en":"He was a lion born a leopard,"},{"id":"manas-2010:p0368:b001:l031","ordinal":16870,"en":"Truly created by God,"},{"id":"manas-2010:p0368:b001:l032","ordinal":16871,"en":"A warrior wolf of battle!"},{"id":"manas-2010:p0368:b001:l033","ordinal":16872,"en":"From the people of Kakanchyn,"},{"id":"manas-2010:p0368:b001:l034","ordinal":16873,"en":"From the mighty-armed unbelievers,"},{"id":"manas-2010:p0368:b001:l035","ordinal":16874,"en":"From the great warrior Zholoy,"},{"id":"manas-2010:p0368:b001:l036","ordinal":16875,"en":"To rescue us,"},{"id":"manas-2010:p0368:b001:l037","ordinal":16876,"en":"To grapple and give battle,"},{"id":"manas-2010:p0368:b001:l038","ordinal":16877,"en":"Our leopard, wolf-man Manas is absent."},{"id":"manas-2010:p0368:b001:l039","ordinal":16878,"en":"Would God strike us down like this?!"},{"id":"manas-2010:p0368:b001:l040","ordinal":16879,"en":"Before Manas returns,"},{"id":"manas-2010:p0368:b001:l041","ordinal":16880,"en":"Will the Black Chinese drive us out?!"},{"id":"manas-2010:p0368:b001:l042","ordinal":16881,"en":"Have you seen what I have seen?"},{"id":"manas-2010:p0368:b001:l043","ordinal":16882,"en":"Have you learned what I have learned?"},{"id":"manas-2010:p0368:b001:l044","ordinal":16883,"en":"Look at the dust of flying earth,"},{"id":"manas-2010:p0368:b001:l045","ordinal":16884,"en":"Look at the mass of Chinese souls!"},{"id":"manas-2010:p0368:b001:l046","ordinal":16885,"en":"Damn this buried world!"},{"id":"manas-2010:p0368:b001:l047","ordinal":16886,"en":"Never had so many swept upon us;"},{"id":"manas-2010:p0368:b001:l048","ordinal":16887,"en":"If the Manchu host attacks,"},{"id":"manas-2010:p0369:b001:l001","ordinal":16888,"en":"If they fall upon us, they will spare no soul!"},{"id":"manas-2010:p0369:b001:l002","ordinal":16889,"en":"A deep pit none can escape—"},{"id":"manas-2010:p0369:b001:l003","ordinal":16890,"en":"The dense host has swept upon us,"},{"id":"manas-2010:p0369:b001:l004","ordinal":16891,"en":"Swarming like ants,"},{"id":"manas-2010:p0369:b001:l005","ordinal":16892,"en":"Buzzing as they move to surround us."},{"id":"manas-2010:p0369:b001:l006","ordinal":16893,"en":"Their army divided into armies;"},{"id":"manas-2010:p0369:b001:l007","ordinal":16894,"en":"Their oppression looked unlike any other."},{"id":"manas-2010:p0369:b001:l008","ordinal":16895,"en":"If we trade blows in battle,"},{"id":"manas-2010:p0369:b001:l009","ordinal":16896,"en":"Blood has poured out like water!"}]
