[{"id":"semetey-2-2013:p1318:b004:l035","ordinal":287233,"en":"Its door was solid iron and tin,"},{"id":"semetey-2-2013:p1318:b004:l036","ordinal":287234,"en":"Its thickness was immense;"},{"id":"semetey-2-2013:p1318:b004:l037","ordinal":287235,"en":"Its entrance was a gate of steel."},{"id":"semetey-2-2013:p1318:b004:l038","ordinal":287236,"en":"The keepers at that gate"},{"id":"semetey-2-2013:p1318:b004:l039","ordinal":287237,"en":"Numbered seventy executioners."},{"id":"semetey-2-2013:p1319:b003:l001","ordinal":287238,"en":"If a living soul appeared, he wrapped himself,"},{"id":"semetey-2-2013:p1319:b003:l002","ordinal":287239,"en":"He wore a person's nose and ears"},{"id":"semetey-2-2013:p1319:b003:l003","ordinal":287240,"en":"As an amulet upon him;"},{"id":"semetey-2-2013:p1319:b003:l004","ordinal":287241,"en":"At the black figure's grim aspect,"},{"id":"semetey-2-2013:p1319:b003:l005","ordinal":287242,"en":"Whoever saw him from afar submitted."},{"id":"semetey-2-2013:p1319:b003:l006","ordinal":287243,"en":"On either side of him"},{"id":"semetey-2-2013:p1319:b003:l007","ordinal":287244,"en":"Stood formidable wrestlers;"},{"id":"semetey-2-2013:p1319:b003:l008","ordinal":287245,"en":"If even one wrestler broke loose,"},{"id":"semetey-2-2013:p1319:b003:l009","ordinal":287246,"en":"A man's very entrails would spill."},{"id":"semetey-2-2013:p1319:b003:l010","ordinal":287247,"en":"Your noble mother Kanykei"},{"id":"semetey-2-2013:p1319:b003:l011","ordinal":287248,"en":"Had the white palace built to her desire;"},{"id":"semetey-2-2013:p1319:b003:l012","ordinal":287249,"en":"Its walls were this thick,"},{"id":"semetey-2-2013:p1319:b003:l013","ordinal":287250,"en":"A palace suited to every need."},{"id":"semetey-2-2013:p1319:b003:l014","ordinal":287251,"en":"When noble, luckless Aichurok came,"},{"id":"semetey-2-2013:p1319:b003:l015","ordinal":287252,"en":"She said, “Take it as your dwelling,”"},{"id":"semetey-2-2013:p1319:b003:l016","ordinal":287253,"en":"And your heroic mother Kanykei"},{"id":"semetey-2-2013:p1319:b003:l017","ordinal":287254,"en":"Gave it to the unfortunate woman."},{"id":"semetey-2-2013:p1319:b003:l018","ordinal":287255,"en":"The noble lady Aichurok"},{"id":"semetey-2-2013:p1319:b003:l019","ordinal":287256,"en":"Made gardens all around it,"},{"id":"semetey-2-2013:p1319:b003:l020","ordinal":287257,"en":"Set a golden throne at its center,"},{"id":"semetey-2-2013:p1319:b003:l021","ordinal":287258,"en":"And made it worthy of your mighty stature—"},{"id":"semetey-2-2013:p1319:b003:l022","ordinal":287259,"en":"An immense white palace,"},{"id":"semetey-2-2013:p1319:b003:l023","ordinal":287260,"en":"A palace fit for the gray-maned lion."},{"id":"semetey-2-2013:p1319:b003:l024","ordinal":287261,"en":"The splendid white palace—"},{"id":"semetey-2-2013:p1319:b003:l025","ordinal":287262,"en":"Such was its magnificence;"},{"id":"semetey-2-2013:p1319:b003:l026","ordinal":287263,"en":"Ah, how wondrous that palace was,"},{"id":"semetey-2-2013:p1319:b003:l027","ordinal":287264,"en":"Thus had she adorned it."},{"id":"semetey-2-2013:p1319:b003:l028","ordinal":287265,"en":"With ruby and jewel stone"},{"id":"semetey-2-2013:p1319:b003:l029","ordinal":287266,"en":"She made it gleam in splendor;"},{"id":"semetey-2-2013:p1319:b003:l030","ordinal":287267,"en":"All around the palace"},{"id":"semetey-2-2013:p1319:b003:l031","ordinal":287268,"en":"She had ornaments set,"},{"id":"semetey-2-2013:p1319:b003:l032","ordinal":287269,"en":"Painted it with gold,"},{"id":"semetey-2-2013:p1319:b003:l033","ordinal":287270,"en":"Bound it about with silver."},{"id":"semetey-2-2013:p1319:b003:l034","ordinal":287271,"en":"If two people spoke within,"},{"id":"semetey-2-2013:p1319:b003:l035","ordinal":287272,"en":"It sang back of its own accord."},{"id":"semetey-2-2013:p1319:b003:l036","ordinal":287273,"en":"She fashioned beams from fir,"},{"id":"semetey-2-2013:p1319:b003:l037","ordinal":287274,"en":"Heaped stone into a mountain;"},{"id":"semetey-2-2013:p1319:b003:l038","ordinal":287275,"en":"A spear thrust could not pierce it,"},{"id":"semetey-2-2013:p1319:b003:l039","ordinal":287276,"en":"And enemies despaired of taking it."},{"id":"semetey-2-2013:p1319:b004:l001","ordinal":287277,"en":"No giant warrior could reach it,"},{"id":"semetey-2-2013:p1319:b004:l002","ordinal":287278,"en":"And of four-footed creatures,"},{"id":"semetey-2-2013:p1319:b004:l003","ordinal":287279,"en":"Not even a mouse could crawl through."},{"id":"semetey-2-2013:p1319:b004:l004","ordinal":287280,"en":"No enemy crossed its ridge,"},{"id":"semetey-2-2013:p1319:b004:l005","ordinal":287281,"en":"No man dared approach it head-on."},{"id":"semetey-2-2013:p1319:b004:l006","ordinal":287282,"en":"Those who saw its outline lamented,"},{"id":"semetey-2-2013:p1319:b004:l007","ordinal":287283,"en":"Unable to advance, they stood amazed."},{"id":"semetey-2-2013:p1319:b004:l008","ordinal":287284,"en":"Lions guarded it all around—"},{"id":"semetey-2-2013:p1319:b004:l009","ordinal":287285,"en":"Such, if you understand, was that place."},{"id":"semetey-2-2013:p1319:b004:l010","ordinal":287286,"en":"In that palace amid the marsh,"},{"id":"semetey-2-2013:p1319:b004:l011","ordinal":287287,"en":"The unfortunate lady Aichurok"},{"id":"semetey-2-2013:p1319:b004:l012","ordinal":287288,"en":"Lay overwhelmed by grief,"},{"id":"semetey-2-2013:p1319:b004:l013","ordinal":287289,"en":"When the master gardener Akjoltoi"},{"id":"semetey-2-2013:p1319:b004:l014","ordinal":287290,"en":"Came running to her."},{"id":"semetey-2-2013:p1319:b004:l015","ordinal":287291,"en":"He told of Kanchoro, her enemy,"},{"id":"semetey-2-2013:p1319:b004:l016","ordinal":287292,"en":"And recounted the whole quarrel;"},{"id":"semetey-2-2013:p1319:b004:l017","ordinal":287293,"en":"He told what his own eyes had seen,"},{"id":"semetey-2-2013:p1319:b004:l018","ordinal":287294,"en":"And all the words he knew."},{"id":"semetey-2-2013:p1319:b004:l019","ordinal":287295,"en":"He related the great,"},{"id":"semetey-2-2013:p1319:b004:l020","ordinal":287296,"en":"Unhealed calamity."},{"id":"semetey-2-2013:p1319:b004:l021","ordinal":287297,"en":"He told of an uproar"},{"id":"semetey-2-2013:p1319:b004:l022","ordinal":287298,"en":"Too dreadful for words;"},{"id":"semetey-2-2013:p1319:b004:l023","ordinal":287299,"en":"He told his sorrow that beneath him"},{"id":"semetey-2-2013:p1319:b004:l024","ordinal":287300,"en":"He had no swift stallion."},{"id":"semetey-2-2013:p1319:b004:l025","ordinal":287301,"en":"He told how the many Black Jediger,"},{"id":"semetey-2-2013:p1319:b004:l026","ordinal":287302,"en":"Forty-two men, surrounded the hero"},{"id":"semetey-2-2013:p1319:b004:l027","ordinal":287303,"en":"And captured him."},{"id":"semetey-2-2013:p1319:b004:l028","ordinal":287304,"en":"He told how the Greathearted One,"},{"id":"semetey-2-2013:p1319:b004:l029","ordinal":287305,"en":"Left without a horse,"},{"id":"semetey-2-2013:p1319:b004:l030","ordinal":287306,"en":"Had remained behind."},{"id":"semetey-2-2013:p1319:b004:l031","ordinal":287307,"en":"Sharpening his bitter tongue,"},{"id":"semetey-2-2013:p1319:b004:l032","ordinal":287308,"en":"Khan Akjoltoi spoke on."},{"id":"semetey-2-2013:p1319:b004:l033","ordinal":287309,"en":"When the Jediger closed around them,"},{"id":"semetey-2-2013:p1319:b004:l034","ordinal":287310,"en":"Kanchoro gave the Jediger"},{"id":"semetey-2-2013:p1319:b004:l035","ordinal":287311,"en":"Every encouragement;"},{"id":"semetey-2-2013:p1319:b004:l036","ordinal":287312,"en":"An enemy arose from among their own,"},{"id":"semetey-2-2013:p1319:b004:l037","ordinal":287313,"en":"And pain welled from the very core."},{"id":"semetey-2-2013:p1319:b004:l038","ordinal":287314,"en":"He told all that had happened:"},{"id":"semetey-2-2013:p1319:b004:l039","ordinal":287315,"en":"“Father, the lion from afar—"},{"id":"semetey-2-2013:p1320:b003:l001","ordinal":287316,"en":"He stood unshaken, ringing like steel,"},{"id":"semetey-2-2013:p1320:b003:l002","ordinal":287317,"en":"Counting the swarming Jediger"},{"id":"semetey-2-2013:p1320:b003:l003","ordinal":287318,"en":"As no more than the hem of his robe."},{"id":"semetey-2-2013:p1320:b003:l004","ordinal":287319,"en":"The Greathearted Lion, left horseless,"},{"id":"semetey-2-2013:p1320:b003:l005","ordinal":287320,"en":"Turned his face toward the qibla,"},{"id":"semetey-2-2013:p1320:b003:l006","ordinal":287321,"en":"Girded on his sharp steel,"},{"id":"semetey-2-2013:p1320:b003:l007","ordinal":287322,"en":"And wrapped himself in his white armor;"},{"id":"semetey-2-2013:p1320:b003:l008","ordinal":287323,"en":"He did not draw back his outstretched foot,"},{"id":"semetey-2-2013:p1320:b003:l009","ordinal":287324,"en":"Nor open his once-closed eyes."},{"id":"semetey-2-2013:p1320:b003:l010","ordinal":287325,"en":"Yesterday Khan Kanchoro and Khan Kyiaz"},{"id":"semetey-2-2013:p1320:b003:l011","ordinal":287326,"en":"Charged and thrust their spears,"},{"id":"semetey-2-2013:p1320:b003:l012","ordinal":287327,"en":"Fired guns and loosed arrows,"},{"id":"semetey-2-2013:p1320:b003:l013","ordinal":287328,"en":"And besieged him where he stood."},{"id":"semetey-2-2013:p1320:b003:l014","ordinal":287329,"en":"I heard the noble lion, left horseless,"},{"id":"semetey-2-2013:p1320:b003:l015","ordinal":287330,"en":"Was treacherously struck by a spear—"},{"id":"semetey-2-2013:p1320:b003:l016","ordinal":287331,"en":"A shameful deed;"},{"id":"semetey-2-2013:p1320:b003:l017","ordinal":287332,"en":"That he died and his bones were never found,"},{"id":"semetey-2-2013:p1320:b003:l018","ordinal":287333,"en":"That the lion you yourselves had seen"},{"id":"semetey-2-2013:p1320:b003:l019","ordinal":287334,"en":"Vanished without a trace."},{"id":"semetey-2-2013:p1320:b003:l020","ordinal":287335,"en":"Mist rose from the ravine,"},{"id":"semetey-2-2013:p1320:b003:l021","ordinal":287336,"en":"And over the summit of Achkaikan-Tau"},{"id":"semetey-2-2013:p1320:b003:l022","ordinal":287337,"en":"Black clouds gathered;"},{"id":"semetey-2-2013:p1320:b003:l023","ordinal":287338,"en":"Mountains collapsed with a roar,"},{"id":"semetey-2-2013:p1320:b003:l024","ordinal":287339,"en":"Floodwater ran and slopes slid,"},{"id":"semetey-2-2013:p1320:b003:l025","ordinal":287340,"en":"Day and night became darkness,"},{"id":"semetey-2-2013:p1320:b003:l026","ordinal":287341,"en":"And the ravine filled with turbulent water."},{"id":"semetey-2-2013:p1320:b003:l027","ordinal":287342,"en":"The trees on the shaded slope"},{"id":"semetey-2-2013:p1320:b003:l028","ordinal":287343,"en":"Stood with their roots torn bare;"},{"id":"semetey-2-2013:p1320:b003:l029","ordinal":287344,"en":"The Jediger's gaunt horses"},{"id":"semetey-2-2013:p1320:b003:l030","ordinal":287345,"en":"Lay utterly dead and swollen."},{"id":"semetey-2-2013:p1320:b003:l031","ordinal":287346,"en":"I heard they reached"},{"id":"semetey-2-2013:p1320:b003:l032","ordinal":287347,"en":"The hero's inheritance;"},{"id":"semetey-2-2013:p1320:b003:l033","ordinal":287348,"en":"I heard my Greathearted One vanished"},{"id":"semetey-2-2013:p1320:b003:l034","ordinal":287349,"en":"And departed from this world."},{"id":"semetey-2-2013:p1320:b003:l035","ordinal":287350,"en":"These were the hero's own words:"},{"id":"semetey-2-2013:p1320:b003:l036","ordinal":287351,"en":"“In his old age, Khan Bakai,"},{"id":"semetey-2-2013:p1320:b003:l037","ordinal":287352,"en":"And in her old age, Chyiyrdy—"},{"id":"semetey-2-2013:p1320:b003:l038","ordinal":287353,"en":"May neither outlive me.”"},{"id":"semetey-2-2013:p1320:b003:l039","ordinal":287354,"en":"He said my aged mother Kanykei,"},{"id":"semetey-2-2013:p1320:b004:l001","ordinal":287355,"en":"Whose brow-bone arches high,"},{"id":"semetey-2-2013:p1320:b004:l002","ordinal":287356,"en":"Had always been fated"},{"id":"semetey-2-2013:p1320:b004:l003","ordinal":287357,"en":"To see few happy days;"},{"id":"semetey-2-2013:p1320:b004:l004","ordinal":287358,"en":"Her hair at the nape was coarse,"},{"id":"semetey-2-2013:p1320:b004:l005","ordinal":287359,"en":"Her lot was heavy sorrow."},{"id":"semetey-2-2013:p1320:b004:l006","ordinal":287360,"en":"“Do not let her shriek and tear her face,"},{"id":"semetey-2-2013:p1320:b004:l007","ordinal":287361,"en":"Do not let her rage,"},{"id":"semetey-2-2013:p1320:b004:l008","ordinal":287362,"en":"Do not let her take her tiny life."},{"id":"semetey-2-2013:p1320:b004:l009","ordinal":287363,"en":"If my dear mother does not die,"},{"id":"semetey-2-2013:p1320:b004:l010","ordinal":287364,"en":"Though senseless hardship may strike her,"},{"id":"semetey-2-2013:p1320:b004:l011","ordinal":287365,"en":"Let her live to see it,"},{"id":"semetey-2-2013:p1320:b004:l012","ordinal":287366,"en":"The child six months formed"},{"id":"semetey-2-2013:p1320:b004:l013","ordinal":287367,"en":"Within Aichurok's womb."},{"id":"semetey-2-2013:p1320:b004:l014","ordinal":287368,"en":"Slaughter ninety beasts for his feast;"},{"id":"semetey-2-2013:p1320:b004:l015","ordinal":287369,"en":"If the child is a boy,"},{"id":"semetey-2-2013:p1320:b004:l016","ordinal":287370,"en":"Give him the name Seitek.”"},{"id":"semetey-2-2013:p1320:b004:l017","ordinal":287371,"en":"Those were the prince's necessary words;"},{"id":"semetey-2-2013:p1320:b004:l018","ordinal":287372,"en":"That is exactly what he said."},{"id":"semetey-2-2013:p1320:b004:l019","ordinal":287373,"en":"“Make him like the morning star in heaven,"},{"id":"semetey-2-2013:p1320:b004:l020","ordinal":287374,"en":"The one appointed by destiny;"},{"id":"semetey-2-2013:p1320:b004:l021","ordinal":287375,"en":"If Kulchoro lives,"},{"id":"semetey-2-2013:p1320:b004:l022","ordinal":287376,"en":"Make the boy his companion."},{"id":"semetey-2-2013:p1320:b004:l023","ordinal":287377,"en":"Against the enemy who comes head-on,"},{"id":"semetey-2-2013:p1320:b004:l024","ordinal":287378,"en":"He will be his host of warriors;"},{"id":"semetey-2-2013:p1320:b004:l025","ordinal":287379,"en":"If Kulchoro survives,"},{"id":"semetey-2-2013:p1320:b004:l026","ordinal":287380,"en":"He will be his wing."},{"id":"semetey-2-2013:p1320:b004:l027","ordinal":287381,"en":"Growing strong and becoming a man,"},{"id":"semetey-2-2013:p1320:b004:l028","ordinal":287382,"en":"He will stand equal to heroes' sons."},{"id":"semetey-2-2013:p1320:b004:l029","ordinal":287383,"en":"The child left in the womb will mature,"},{"id":"semetey-2-2013:p1320:b004:l030","ordinal":287384,"en":"Meet my poor kinsman,"},{"id":"semetey-2-2013:p1320:b004:l031","ordinal":287385,"en":"And find the lands of Jylgyndy,"},{"id":"semetey-2-2013:p1320:b004:l032","ordinal":287386,"en":"Broad Keng-Kol, and wide Talas."},{"id":"semetey-2-2013:p1320:b004:l033","ordinal":287387,"en":"He will find the happy Kyrgyz"},{"id":"semetey-2-2013:p1320:b004:l034","ordinal":287388,"en":"And the many Argyn people.”"},{"id":"semetey-2-2013:p1320:b004:l035","ordinal":287389,"en":"The bloodstained warrior's last command"},{"id":"semetey-2-2013:p1320:b004:l036","ordinal":287390,"en":"Was this, to be told to Aichurok:"},{"id":"semetey-2-2013:p1320:b004:l037","ordinal":287391,"en":"“Do not claw your face bloody,"},{"id":"semetey-2-2013:p1320:b004:l038","ordinal":287392,"en":"Do not loose your black hair."},{"id":"semetey-2-2013:p1320:b004:l039","ordinal":287393,"en":"When this grievous, crushing calamity"},{"id":"semetey-2-2013:p1321:b003:l001","ordinal":287394,"en":"Has fallen upon your noble head,"},{"id":"semetey-2-2013:p1321:b003:l002","ordinal":287395,"en":"Do no such thing."},{"id":"semetey-2-2013:p1321:b003:l003","ordinal":287396,"en":"Make your mourning head a man,"},{"id":"semetey-2-2013:p1321:b003:l004","ordinal":287397,"en":"Make your woman's head a banner;"},{"id":"semetey-2-2013:p1321:b003:l005","ordinal":287398,"en":"Against Kanchoro and Kyiaz"},{"id":"semetey-2-2013:p1321:b003:l006","ordinal":287399,"en":"Raise an uproar no man has seen."},{"id":"semetey-2-2013:p1321:b003:l007","ordinal":287400,"en":"Drive your caravan forth,"},{"id":"semetey-2-2013:p1321:b003:l008","ordinal":287401,"en":"And take revenge without grieving"},{"id":"semetey-2-2013:p1321:b003:l009","ordinal":287402,"en":"On those babbling fools."},{"id":"semetey-2-2013:p1321:b003:l010","ordinal":287403,"en":"Lead your migration from Talas;"},{"id":"semetey-2-2013:p1321:b003:l011","ordinal":287404,"en":"If you are a tigress, a lioness,"},{"id":"semetey-2-2013:p1321:b003:l012","ordinal":287405,"en":"If you truly are Aichurok,"},{"id":"semetey-2-2013:p1321:b003:l013","ordinal":287406,"en":"Take vengeance on the traitors!”"},{"id":"semetey-2-2013:p1321:b003:l014","ordinal":287407,"en":"Thus Akjoltoi"},{"id":"semetey-2-2013:p1321:b003:l015","ordinal":287408,"en":"Spoke these words to her."},{"id":"semetey-2-2013:p1321:b003:l016","ordinal":287409,"en":"Kulchoro, who was your wing,"},{"id":"semetey-2-2013:p1321:b003:l017","ordinal":287410,"en":"Had his temple pierced and was made a slave;"},{"id":"semetey-2-2013:p1321:b003:l018","ordinal":287411,"en":"The warrior's shoulder was cut,"},{"id":"semetey-2-2013:p1321:b003:l019","ordinal":287412,"en":"And he was enslaved as a herdsman."},{"id":"semetey-2-2013:p1321:b003:l020","ordinal":287413,"en":"Kanchoro sharpened his keen broadsword"},{"id":"semetey-2-2013:p1321:b003:l021","ordinal":287414,"en":"And slaughtered all the rest,"},{"id":"semetey-2-2013:p1321:b003:l022","ordinal":287415,"en":"Leaving no one alive."},{"id":"semetey-2-2013:p1321:b003:l023","ordinal":287416,"en":"He spilled and churned their yellow blood;"},{"id":"semetey-2-2013:p1321:b003:l024","ordinal":287417,"en":"My forefather, old Bakai,"},{"id":"semetey-2-2013:p1321:b003:l025","ordinal":287418,"en":"Suffered outrage upon outrage,"},{"id":"semetey-2-2013:p1321:b003:l026","ordinal":287419,"en":"And they dragged him in the kok-boru game."},{"id":"semetey-2-2013:p1321:b003:l027","ordinal":287420,"en":"In fury and anguish,"},{"id":"semetey-2-2013:p1321:b003:l028","ordinal":287421,"en":"The many Argyn and the Kyrgyz host"},{"id":"semetey-2-2013:p1321:b003:l029","ordinal":287422,"en":"Despaired of their precious lives.”"},{"id":"semetey-2-2013:p1321:b003:l030","ordinal":287423,"en":"Ah, when Akjoltoi"},{"id":"semetey-2-2013:p1321:b003:l031","ordinal":287424,"en":"Had said these things,"},{"id":"semetey-2-2013:p1321:b003:l032","ordinal":287425,"en":"Old Chyiyrdy"},{"id":"semetey-2-2013:p1321:b003:l033","ordinal":287426,"en":"Tensed like a hawk,"},{"id":"semetey-2-2013:p1321:b003:l034","ordinal":287427,"en":"And pleading with Kanykei,"},{"id":"semetey-2-2013:p1321:b003:l035","ordinal":287428,"en":"For six thousand camels and a thousand colts,"},{"id":"semetey-2-2013:p1321:b003:l036","ordinal":287429,"en":"She had bought the white dagger;"},{"id":"semetey-2-2013:p1321:b003:l037","ordinal":287430,"en":"She drew it from its sheath."},{"id":"semetey-2-2013:p1321:b003:l038","ordinal":287431,"en":"Shrieking aloud,"},{"id":"semetey-2-2013:p1321:b003:l039","ordinal":287432,"en":"“How can I remain after my darling?”"},{"id":"semetey-2-2013:p1321:b005:l001","ordinal":287433,"en":"She aimed it at her breast."},{"id":"semetey-2-2013:p1321:b005:l002","ordinal":287434,"en":"The old mother herself"},{"id":"semetey-2-2013:p1321:b005:l003","ordinal":287435,"en":"Drew it across her body."},{"id":"semetey-2-2013:p1321:b005:l004","ordinal":287436,"en":"His unfortunate mother Kanykei,"},{"id":"semetey-2-2013:p1321:b005:l005","ordinal":287437,"en":"Wailing and sobbing, could not stand,"},{"id":"semetey-2-2013:p1321:b005:l006","ordinal":287438,"en":"Yet could not take her own life;"},{"id":"semetey-2-2013:p1321:b005:l007","ordinal":287439,"en":"Her color fled and her senses reeled"},{"id":"semetey-2-2013:p1321:b005:l008","ordinal":287440,"en":"As they struggled over the white dagger."},{"id":"semetey-2-2013:p1321:b005:l009","ordinal":287441,"en":"She screamed and wept aloud,"},{"id":"semetey-2-2013:p1321:b005:l010","ordinal":287442,"en":"“Ah, my only one!” she sobbed."},{"id":"semetey-2-2013:p1321:b005:l011","ordinal":287443,"en":"From her quail-like eyes"},{"id":"semetey-2-2013:p1321:b005:l012","ordinal":287444,"en":"Uncommon tears of blood flowed."},{"id":"semetey-2-2013:p1321:b005:l013","ordinal":287445,"en":"Her strength left her as she screamed;"},{"id":"semetey-2-2013:p1321:b005:l014","ordinal":287446,"en":"As she screamed, from her eyes"},{"id":"semetey-2-2013:p1321:b005:l015","ordinal":287447,"en":"Dark blood poured."},{"id":"semetey-2-2013:p1321:b005:l016","ordinal":287448,"en":"“My morning star!” she cried,"},{"id":"semetey-2-2013:p1321:b005:l017","ordinal":287449,"en":"“My only one!” she sobbed."},{"id":"semetey-2-2013:p1321:b005:l018","ordinal":287450,"en":"Her ribs seemed to split apart,"},{"id":"semetey-2-2013:p1321:b005:l019","ordinal":287451,"en":"And tears poured from her eyes."},{"id":"semetey-2-2013:p1321:b005:l020","ordinal":287452,"en":"The palace ridge where she stood"},{"id":"semetey-2-2013:p1321:b005:l021","ordinal":287453,"en":"Was washed by the tears from both eyes,"},{"id":"semetey-2-2013:p1321:b005:l022","ordinal":287454,"en":"Which spread like a flood into a pool."},{"id":"semetey-2-2013:p1321:b005:l023","ordinal":287455,"en":"Your noble mother Kanykei"},{"id":"semetey-2-2013:p1321:b005:l024","ordinal":287456,"en":"Sobbed, “My dear foal!”"},{"id":"semetey-2-2013:p1321:b005:l025","ordinal":287457,"en":"And cried, “My cherished one!”"},{"id":"semetey-2-2013:p1321:b005:l026","ordinal":287458,"en":"Calling him her ash-gray camel calf, she sobbed:"},{"id":"semetey-2-2013:p1321:b005:l027","ordinal":287459,"en":"“Late in life I braided my hair,"},{"id":"semetey-2-2013:p1321:b005:l028","ordinal":287460,"en":"After long yearning I saw your face."},{"id":"semetey-2-2013:p1321:b005:l029","ordinal":287461,"en":"Now before my eyes"},{"id":"semetey-2-2013:p1321:b005:l030","ordinal":287462,"en":"Lies only pitch-black night."},{"id":"semetey-2-2013:p1321:b005:l031","ordinal":287463,"en":"My sole hope and support—"},{"id":"semetey-2-2013:p1321:b005:l032","ordinal":287464,"en":"Whom have I besides you?”"},{"id":"semetey-2-2013:p1321:b005:l033","ordinal":287465,"en":"Thus Kanykei"},{"id":"semetey-2-2013:p1321:b005:l034","ordinal":287466,"en":"Stood weeping in anguish,"},{"id":"semetey-2-2013:p1321:b005:l035","ordinal":287467,"en":"Lamenting and sobbing,"},{"id":"semetey-2-2013:p1321:b005:l036","ordinal":287468,"en":"Unable to catch her breath."},{"id":"semetey-2-2013:p1321:b005:l037","ordinal":287469,"en":"If he was dead, he was not in the grave;"},{"id":"semetey-2-2013:p1321:b005:l038","ordinal":287470,"en":"If alive, he was nowhere among the living."},{"id":"semetey-2-2013:p1321:b005:l039","ordinal":287471,"en":"Exhausted by grief, bleeding,"},{"id":"semetey-2-2013:p1322:b003:l001","ordinal":287472,"en":"Her strength left Kanykei;"},{"id":"semetey-2-2013:p1322:b003:l002","ordinal":287473,"en":"She lost consciousness,"},{"id":"semetey-2-2013:p1322:b003:l003","ordinal":287474,"en":"Her face turned ashen,"},{"id":"semetey-2-2013:p1322:b003:l004","ordinal":287475,"en":"And unable to stand, she fell,"},{"id":"semetey-2-2013:p1322:b003:l005","ordinal":287476,"en":"Lying there insensible."},{"id":"semetey-2-2013:p1322:b003:l006","ordinal":287477,"en":"When Kanykei's voice was heard,"},{"id":"semetey-2-2013:p1322:b003:l007","ordinal":287478,"en":"The birch grieved and the willow wept,"},{"id":"semetey-2-2013:p1322:b003:l008","ordinal":287479,"en":"And all the gathered people wept."},{"id":"semetey-2-2013:p1322:b003:l009","ordinal":287480,"en":"Every nose steamed with breath,"},{"id":"semetey-2-2013:p1322:b003:l010","ordinal":287481,"en":"The heroes raised a great clamor,"},{"id":"semetey-2-2013:p1322:b003:l011","ordinal":287482,"en":"All the people were in uproar;"},{"id":"semetey-2-2013:p1322:b003:l012","ordinal":287483,"en":"The earth shook and stones wept,"},{"id":"semetey-2-2013:p1322:b003:l013","ordinal":287484,"en":"The chiefs of all the Kyrgyz wept,"},{"id":"semetey-2-2013:p1322:b003:l014","ordinal":287485,"en":"The deep earth beneath them wept,"},{"id":"semetey-2-2013:p1322:b003:l015","ordinal":287486,"en":"And the warriors, led by Akjoltoi, wept."},{"id":"semetey-2-2013:p1322:b003:l016","ordinal":287487,"en":"Have you heard the tale from long ago"},{"id":"semetey-2-2013:p1322:b003:l017","ordinal":287488,"en":"Of the creature found by providence"}]
