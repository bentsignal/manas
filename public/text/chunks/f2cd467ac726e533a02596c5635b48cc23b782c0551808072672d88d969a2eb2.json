[{"id":"seytek-2012:p0949:b002:l012","ordinal":369665,"en":"Blood streamed from his charging steed,"},{"id":"seytek-2012:p0949:b002:l013","ordinal":369666,"en":"And blood flowed along the path of his charge."},{"id":"seytek-2012:p0949:b002:l014","ordinal":369667,"en":"Growling in rising passion,"},{"id":"seytek-2012:p0949:b002:l015","ordinal":369668,"en":"He thundered words to himself,"},{"id":"seytek-2012:p0949:b002:l016","ordinal":369669,"en":"Raging and lunging,"},{"id":"seytek-2012:p0949:b002:l017","ordinal":369670,"en":"Writhing with violent force;"},{"id":"seytek-2012:p0949:b002:l018","ordinal":369671,"en":"His brows and lashes flared apart,"},{"id":"seytek-2012:p0949:b002:l019","ordinal":369672,"en":"And venom poured from his mouth."},{"id":"seytek-2012:p0949:b002:l020","ordinal":369673,"en":"Toward the dauntless son of the hero"},{"id":"seytek-2012:p0949:b002:l021","ordinal":369674,"en":"He turned and braced himself,"},{"id":"seytek-2012:p0949:b002:l022","ordinal":369675,"en":"Straining and glaring with courage."},{"id":"seytek-2012:p0949:b002:l023","ordinal":369676,"en":"A mountain-like surge came to a halt,"},{"id":"seytek-2012:p0949:b002:l024","ordinal":369677,"en":"Like a horse tethered to a post."},{"id":"seytek-2012:p0949:b002:l025","ordinal":369678,"en":"At the swine’s thunderous approach,"},{"id":"seytek-2012:p0949:b002:l026","ordinal":369679,"en":"The accursed veteran"},{"id":"seytek-2012:p0949:b002:l027","ordinal":369680,"en":"Readied his fire pit."},{"id":"seytek-2012:p0949:b002:l028","ordinal":369681,"en":"The black earth, without overturning,"},{"id":"seytek-2012:p0949:b002:l029","ordinal":369682,"en":"Held firm beneath the massive weight."},{"id":"seytek-2012:p0949:b002:l030","ordinal":369683,"en":"The boar was rich in strength;"},{"id":"seytek-2012:p0949:b002:l031","ordinal":369684,"en":"The skillful enemy Sarybay"},{"id":"seytek-2012:p0949:b002:l032","ordinal":369685,"en":"Opened his mouth like a wolf,"},{"id":"seytek-2012:p0949:b002:l033","ordinal":369686,"en":"And fire scattered before him."},{"id":"seytek-2012:p0949:b002:l034","ordinal":369687,"en":"He assumed a form of savage courage"},{"id":"seytek-2012:p0949:b002:l035","ordinal":369688,"en":"And stirred grievous strife."},{"id":"seytek-2012:p0949:b002:l036","ordinal":369689,"en":"The mountain-like Tookyzyl"},{"id":"seytek-2012:p0949:b002:l037","ordinal":369690,"en":"Broke the ground beneath its hooves;"},{"id":"seytek-2012:p0949:b002:l038","ordinal":369691,"en":"He made Tookyzyl bound,"},{"id":"seytek-2012:p0949:b002:l039","ordinal":369692,"en":"Spurring it right and left,"},{"id":"seytek-2012:p0949:b002:l040","ordinal":369693,"en":"And lashing from side to side."},{"id":"seytek-2012:p0949:b003:l001","ordinal":369694,"en":"Pouring out his wrath, he shouted,"},{"id":"seytek-2012:p0949:b003:l002","ordinal":369695,"en":"Raising the battle cry, “Where is he?”"},{"id":"seytek-2012:p0949:b003:l003","ordinal":369696,"en":"His violent fury burst forth,"},{"id":"seytek-2012:p0949:b003:l004","ordinal":369697,"en":"And he appeared like a mountain of black rock."},{"id":"seytek-2012:p0949:b003:l005","ordinal":369698,"en":"Sarybay was indeed a warrior;"},{"id":"seytek-2012:p0949:b003:l006","ordinal":369699,"en":"Such was his conduct in combat."},{"id":"seytek-2012:p0949:b003:l007","ordinal":369700,"en":"Vision dimmed amid the tumult;"},{"id":"seytek-2012:p0949:b003:l008","ordinal":369701,"en":"The battle, if seen, was a roaring storm."},{"id":"seytek-2012:p0949:b003:l009","ordinal":369702,"en":"Young Seytek, brave gray-maned wolf,"},{"id":"seytek-2012:p0949:b003:l010","ordinal":369703,"en":"As Sarybay faced him"},{"id":"seytek-2012:p0949:b003:l011","ordinal":369704,"en":"And began the savage slaughter,"},{"id":"seytek-2012:p0949:b003:l012","ordinal":369705,"en":"Before an arrow could arrive,"},{"id":"seytek-2012:p0949:b003:l013","ordinal":369706,"en":"Measured the place he must strike."},{"id":"seytek-2012:p0949:b003:l014","ordinal":369707,"en":"As the man rode to thrust at the boy,"},{"id":"seytek-2012:p0949:b003:l015","ordinal":369708,"en":"“I have met my enemy—"},{"id":"seytek-2012:p0949:b003:l016","ordinal":369709,"en":"May God prosper what follows;"},{"id":"seytek-2012:p0949:b003:l017","ordinal":369710,"en":"May my forefather Manas uphold me,” he said."},{"id":"seytek-2012:p0949:b003:l018","ordinal":369711,"en":"Against the menacing villain,"},{"id":"seytek-2012:p0949:b003:l019","ordinal":369712,"en":"Who swept away all he encountered,"},{"id":"seytek-2012:p0949:b003:l020","ordinal":369713,"en":"The boar, warrior Sarybay,"},{"id":"seytek-2012:p0949:b003:l021","ordinal":369714,"en":"The descendant of the brave gray wolf"},{"id":"seytek-2012:p0949:b003:l022","ordinal":369715,"en":"Turned Kulansur’s head."},{"id":"seytek-2012:p0949:b003:l023","ordinal":369716,"en":"The father’s son"},{"id":"seytek-2012:p0949:b003:l024","ordinal":369717,"en":"Did not fluster or hurry;"},{"id":"seytek-2012:p0949:b003:l025","ordinal":369718,"en":"A descendant of his line"},{"id":"seytek-2012:p0949:b003:l026","ordinal":369719,"en":"Never retreated from a foe,"},{"id":"seytek-2012:p0949:b003:l027","ordinal":369720,"en":"Never fled after yielding ground,"},{"id":"seytek-2012:p0949:b003:l028","ordinal":369721,"en":"Never thought, “I shall die,”"},{"id":"seytek-2012:p0949:b003:l029","ordinal":369722,"en":"And never surrendered his courage to another."},{"id":"seytek-2012:p0949:b003:l030","ordinal":369723,"en":"The black-gray wolf, the peerless lion,"},{"id":"seytek-2012:p0949:b003:l031","ordinal":369724,"en":"With strength compounded like packed sand,"},{"id":"seytek-2012:p0949:b003:l032","ordinal":369725,"en":"Fought there in battle."},{"id":"seytek-2012:p0949:b003:l033","ordinal":369726,"en":"He measured and thrust toward the jaw:"},{"id":"seytek-2012:p0949:b003:l034","ordinal":369727,"en":"“Just beneath the breast,"},{"id":"seytek-2012:p0949:b003:l035","ordinal":369728,"en":"Right through the lung,"},{"id":"seytek-2012:p0949:b003:l036","ordinal":369729,"en":"That is the place of death.”"},{"id":"seytek-2012:p0949:b003:l037","ordinal":369730,"en":"Sarybay now leveled his spear:"},{"id":"seytek-2012:p0949:b003:l038","ordinal":369731,"en":"“Right at the point of the jaw,"},{"id":"seytek-2012:p0949:b003:l039","ordinal":369732,"en":"Right through the heart,"},{"id":"seytek-2012:p0949:b003:l040","ordinal":369733,"en":"That is the measured spot.”"},{"id":"seytek-2012:p0950:b002:l001","ordinal":369734,"en":"“For the grunting boar,"},{"id":"seytek-2012:p0950:b002:l002","ordinal":369735,"en":"This is the moment of death,”"},{"id":"seytek-2012:p0950:b002:l003","ordinal":369736,"en":"He said, taking aim with measured care."},{"id":"seytek-2012:p0950:b002:l004","ordinal":369737,"en":"At the raging infidel,"},{"id":"seytek-2012:p0950:b002:l005","ordinal":369738,"en":"The warrior who had destroyed nations,"},{"id":"seytek-2012:p0950:b002:l006","ordinal":369739,"en":"The youth rode up and thrust."},{"id":"seytek-2012:p0950:b002:l007","ordinal":369740,"en":"Both spears struck together,"},{"id":"seytek-2012:p0950:b002:l008","ordinal":369741,"en":"And when the two spears hit,"},{"id":"seytek-2012:p0950:b002:l009","ordinal":369742,"en":"They burst and splintered to pieces;"},{"id":"seytek-2012:p0950:b002:l010","ordinal":369743,"en":"Fragments as large as tents"},{"id":"seytek-2012:p0950:b002:l011","ordinal":369744,"en":"Flew whirling into the sky."},{"id":"seytek-2012:p0950:b002:l012","ordinal":369745,"en":"Those who watched and saw them,"},{"id":"seytek-2012:p0950:b002:l013","ordinal":369746,"en":"As the two stood face-to-face"},{"id":"seytek-2012:p0950:b002:l014","ordinal":369747,"en":"And in turn drove their spears"},{"id":"seytek-2012:p0950:b002:l015","ordinal":369748,"en":"At one another,"},{"id":"seytek-2012:p0950:b002:l016","ordinal":369749,"en":"Despaired of their lives."},{"id":"seytek-2012:p0950:b002:l017","ordinal":369750,"en":"Their bullet-proof armor split,"},{"id":"seytek-2012:p0950:b002:l018","ordinal":369751,"en":"And Kulansur and Tookyzyl"},{"id":"seytek-2012:p0950:b002:l019","ordinal":369752,"en":"Sank hoof-deep into the ground."},{"id":"seytek-2012:p0950:b002:l020","ordinal":369753,"en":"As the heroes met,"},{"id":"seytek-2012:p0950:b002:l021","ordinal":369754,"en":"Their valor was revealed."},{"id":"seytek-2012:p0950:b002:l022","ordinal":369755,"en":"When they struck spears with cries of “Manas!”"},{"id":"seytek-2012:p0950:b002:l023","ordinal":369756,"en":"The earth split five feet deep;"},{"id":"seytek-2012:p0950:b002:l024","ordinal":369757,"en":"They trampled the ground beneath them,"},{"id":"seytek-2012:p0950:b002:l025","ordinal":369758,"en":"Urging Kulansur on."},{"id":"seytek-2012:p0950:b002:l026","ordinal":369759,"en":"He flung forth his fury,"},{"id":"seytek-2012:p0950:b002:l027","ordinal":369760,"en":"While that monstrous warrior, the wretch,"},{"id":"seytek-2012:p0950:b002:l028","ordinal":369761,"en":"Grew angry with Tookyzyl."},{"id":"seytek-2012:p0950:b002:l029","ordinal":369762,"en":"It turned its deer-like neck;"},{"id":"seytek-2012:p0950:b002:l030","ordinal":369763,"en":"Kulansur would not stand still,"},{"id":"seytek-2012:p0950:b002:l031","ordinal":369764,"en":"While Tookyzyl was a true thoroughbred"},{"id":"seytek-2012:p0950:b002:l032","ordinal":369765,"en":"That sprang up from the earth."},{"id":"seytek-2012:p0950:b002:l033","ordinal":369766,"en":"When they came beneath the horses,"},{"id":"seytek-2012:p0950:b002:l034","ordinal":369767,"en":"Would Sarybay, son of the ogre,"},{"id":"seytek-2012:p0950:b002:l035","ordinal":369768,"en":"Refrain from fighting?"},{"id":"seytek-2012:p0950:b002:l036","ordinal":369769,"en":"His cavernous mouth opened,"},{"id":"seytek-2012:p0950:b002:l037","ordinal":369770,"en":"And burning embers from the bit"},{"id":"seytek-2012:p0950:b002:l038","ordinal":369771,"en":"Scattered in volleys."},{"id":"seytek-2012:p0950:b002:l039","ordinal":369772,"en":"His savage courage showed,"},{"id":"seytek-2012:p0950:b002:l040","ordinal":369773,"en":"And he burned in bitter grief."},{"id":"seytek-2012:p0950:b003:l001","ordinal":369774,"en":"The cause of his grief"},{"id":"seytek-2012:p0950:b003:l002","ordinal":369775,"en":"Was that Sarybay"},{"id":"seytek-2012:p0950:b003:l003","ordinal":369776,"en":"Had never paid anyone the slightest heed;"},{"id":"seytek-2012:p0950:b003:l004","ordinal":369777,"en":"No mortal had dared face him,"},{"id":"seytek-2012:p0950:b003:l005","ordinal":369778,"en":"And he had never deigned to notice a mortal."},{"id":"seytek-2012:p0950:b003:l006","ordinal":369779,"en":"No one had ever leveled a spear at him;"},{"id":"seytek-2012:p0950:b003:l007","ordinal":369780,"en":"He had bowed his neck to no one in the world,"},{"id":"seytek-2012:p0950:b003:l008","ordinal":369781,"en":"And no one had ever challenged him."},{"id":"seytek-2012:p0950:b003:l009","ordinal":369782,"en":"Against that rabid boar,"},{"id":"seytek-2012:p0950:b003:l010","ordinal":369783,"en":"None remained to ready a lasso."},{"id":"seytek-2012:p0950:b003:l011","ordinal":369784,"en":"Khans had died fighting him;"},{"id":"seytek-2012:p0950:b003:l012","ordinal":369785,"en":"Every khan who clashed with him had died."},{"id":"seytek-2012:p0950:b003:l013","ordinal":369786,"en":"Warriors proud of their strength had died;"},{"id":"seytek-2012:p0950:b003:l014","ordinal":369787,"en":"Lions who sought combat had died."},{"id":"seytek-2012:p0950:b003:l015","ordinal":369788,"en":"He had begun savage battles,"},{"id":"seytek-2012:p0950:b003:l016","ordinal":369789,"en":"Renowned in name and fierce in venom;"},{"id":"seytek-2012:p0950:b003:l017","ordinal":369790,"en":"He leveled all who crossed him—"},{"id":"seytek-2012:p0950:b003:l018","ordinal":369791,"en":"At the sight of his wrath, abandon hope."},{"id":"seytek-2012:p0950:b003:l019","ordinal":369792,"en":"Yet on that day the madman’s"},{"id":"seytek-2012:p0950:b003:l020","ordinal":369793,"en":"Evil purpose came undone."},{"id":"seytek-2012:p0950:b003:l021","ordinal":369794,"en":"Seized by fury,"},{"id":"seytek-2012:p0950:b003:l022","ordinal":369795,"en":"Sparing no precious life,"},{"id":"seytek-2012:p0950:b003:l023","ordinal":369796,"en":"He cried out in anger,"},{"id":"seytek-2012:p0950:b003:l024","ordinal":369797,"en":"Shouting menacingly,"},{"id":"seytek-2012:p0950:b003:l025","ordinal":369798,"en":"Churning the blue heavens."},{"id":"seytek-2012:p0950:b003:l026","ordinal":369799,"en":"His spirit seethed and madness boiled;"},{"id":"seytek-2012:p0950:b003:l027","ordinal":369800,"en":"Raging, he ground his teeth,"},{"id":"seytek-2012:p0950:b003:l028","ordinal":369801,"en":"And doom boiled over the warrior who opposed him."},{"id":"seytek-2012:p0950:b003:l029","ordinal":369802,"en":"His form bristled and transformed,"},{"id":"seytek-2012:p0950:b003:l030","ordinal":369803,"en":"Revealing his intent to destroy."},{"id":"seytek-2012:p0950:b003:l031","ordinal":369804,"en":"Then Sarybay"},{"id":"seytek-2012:p0950:b003:l032","ordinal":369805,"en":"And the warrior Seytek"},{"id":"seytek-2012:p0950:b003:l033","ordinal":369806,"en":"Fought without sparing their lives,"},{"id":"seytek-2012:p0950:b003:l034","ordinal":369807,"en":"Drenching themselves in crimson blood."},{"id":"seytek-2012:p0950:b003:l035","ordinal":369808,"en":"They stood thrusting spears,"},{"id":"seytek-2012:p0950:b003:l036","ordinal":369809,"en":"Firing guns and drawing bows,"},{"id":"seytek-2012:p0950:b003:l037","ordinal":369810,"en":"Striking each other in furious combat,"},{"id":"seytek-2012:p0950:b003:l038","ordinal":369811,"en":"And hewing at one another with axes,"},{"id":"seytek-2012:p0950:b003:l039","ordinal":369812,"en":"Until the axes splintered apart"},{"id":"seytek-2012:p0950:b003:l040","ordinal":369813,"en":"And only their shafts remained in hand."},{"id":"seytek-2012:p0951:b002:l001","ordinal":369814,"en":"They clashed with swords,"},{"id":"seytek-2012:p0951:b002:l002","ordinal":369815,"en":"The swords shattered and splintered,"},{"id":"seytek-2012:p0951:b002:l003","ordinal":369816,"en":"Leaving only bare hilts."},{"id":"seytek-2012:p0951:b002:l004","ordinal":369817,"en":"They stood face-to-face,"},{"id":"seytek-2012:p0951:b002:l005","ordinal":369818,"en":"Striking each other with heavy blows,"},{"id":"seytek-2012:p0951:b002:l006","ordinal":369819,"en":"All were drenched in blood,"},{"id":"seytek-2012:p0951:b002:l007","ordinal":369820,"en":"Their arrow-proof coats and trousers"},{"id":"seytek-2012:p0951:b002:l008","ordinal":369821,"en":"Were utterly torn to shreds,"},{"id":"seytek-2012:p0951:b002:l009","ordinal":369822,"en":"Rent apart like saddle straps,"},{"id":"seytek-2012:p0951:b002:l010","ordinal":369823,"en":"All their strength was spent,"},{"id":"seytek-2012:p0951:b002:l011","ordinal":369824,"en":"Ribs were broken one upon another,"},{"id":"seytek-2012:p0951:b002:l012","ordinal":369825,"en":"So fierce was the ordeal, so great the battle,"},{"id":"seytek-2012:p0951:b002:l013","ordinal":369826,"en":"That no regret remained."},{"id":"seytek-2012:p0951:b002:l014","ordinal":369827,"en":"Unable to throw him from the saddle,"},{"id":"seytek-2012:p0951:b002:l015","ordinal":369828,"en":"Unable to defeat brave Seytek."},{"id":"seytek-2012:p0951:b002:l016","ordinal":369829,"en":"Such was Seytek’s state."},{"id":"seytek-2012:p0951:b002:l017","ordinal":369830,"en":"His valor was extraordinary,"},{"id":"seytek-2012:p0951:b002:l018","ordinal":369831,"en":"The young man’s bearing was exceptional,"},{"id":"seytek-2012:p0951:b002:l019","ordinal":369832,"en":"He was the gray-maned champion of his line."},{"id":"seytek-2012:p0951:b002:l020","ordinal":369833,"en":"When Sarybai unleashed his venom,"},{"id":"seytek-2012:p0951:b002:l021","ordinal":369834,"en":"Shouting as he thrust his spear,"},{"id":"seytek-2012:p0951:b002:l022","ordinal":369835,"en":"And each time he swung his battle-axe,"},{"id":"seytek-2012:p0951:b002:l023","ordinal":369836,"en":"The falcon favored by the spirits,"},{"id":"seytek-2012:p0951:b002:l024","ordinal":369837,"en":"That dear lion, proud as a cock,"},{"id":"seytek-2012:p0951:b002:l025","ordinal":369838,"en":"That steadfast hero, never stirred."},{"id":"seytek-2012:p0951:b002:l026","ordinal":369839,"en":"Behold how his fathers and forefathers"},{"id":"seytek-2012:p0951:b002:l027","ordinal":369840,"en":"Came to his aid."},{"id":"seytek-2012:p0951:b002:l028","ordinal":369841,"en":"The wandering saint Khydyr himself,"},{"id":"seytek-2012:p0951:b002:l029","ordinal":369842,"en":"If you mark it, stood beside him,"},{"id":"seytek-2012:p0951:b002:l030","ordinal":369843,"en":"And nine guardian spirits aided him."},{"id":"seytek-2012:p0951:b002:l031","ordinal":369844,"en":"When Sarybai spilled blood,"},{"id":"seytek-2012:p0951:b002:l032","ordinal":369845,"en":"They came and entered the fray:"},{"id":"seytek-2012:p0951:b002:l033","ordinal":369846,"en":"A black-mottled leopard"},{"id":"seytek-2012:p0951:b002:l034","ordinal":369847,"en":"Sprang at him from the flank,"},{"id":"seytek-2012:p0951:b002:l035","ordinal":369848,"en":"A bobtailed gray-maned lion"},{"id":"seytek-2012:p0951:b002:l036","ordinal":369849,"en":"Prepared to strike him head-on,"},{"id":"seytek-2012:p0951:b002:l037","ordinal":369850,"en":"And before the people a fierce tiger—"},{"id":"seytek-2012:p0951:b002:l038","ordinal":369851,"en":"No such being exists among my folk—"},{"id":"seytek-2012:p0951:b002:l039","ordinal":369852,"en":"Fought at Seytek’s side."},{"id":"seytek-2012:p0951:b002:l040","ordinal":369853,"en":"They kept the warrior occupied,"},{"id":"seytek-2012:p0951:b003:l001","ordinal":369854,"en":"And every mighty blow"},{"id":"seytek-2012:p0951:b003:l002","ordinal":369855,"en":"That warrior Sarybai struck,"},{"id":"seytek-2012:p0951:b003:l003","ordinal":369856,"en":"They intercepted before it reached him."},{"id":"seytek-2012:p0951:b003:l004","ordinal":369857,"en":"From his right side forty men"},{"id":"seytek-2012:p0951:b003:l005","ordinal":369858,"en":"Against that infidel Sarybai"},{"id":"seytek-2012:p0951:b003:l006","ordinal":369859,"en":"Leveled their spears in a row."},{"id":"seytek-2012:p0951:b003:l007","ordinal":369860,"en":"Khan Almambet and Chubak were there,"},{"id":"seytek-2012:p0951:b003:l008","ordinal":369861,"en":"Their mighty spirits joining him,"},{"id":"seytek-2012:p0951:b003:l009","ordinal":369862,"en":"Standing as support"},{"id":"seytek-2012:p0951:b003:l010","ordinal":369863,"en":"For young warrior Seytek."},{"id":"seytek-2012:p0951:b003:l011","ordinal":369864,"en":"“Seize him, my son, seize him,” they cried,"},{"id":"seytek-2012:p0951:b003:l012","ordinal":369865,"en":"“Finish him—do not leave him alive!"},{"id":"seytek-2012:p0951:b003:l013","ordinal":369866,"en":"Crush the belly of that villain"},{"id":"seytek-2012:p0951:b003:l014","ordinal":369867,"en":"Who boasts himself a warrior, like the belly of an ass!"},{"id":"seytek-2012:p0951:b003:l015","ordinal":369868,"en":"Gouge out both his eyes!"},{"id":"seytek-2012:p0951:b003:l016","ordinal":369869,"en":"Bring that bellowing wretch down"},{"id":"seytek-2012:p0951:b003:l017","ordinal":369870,"en":"And dash him to the ground!"},{"id":"seytek-2012:p0951:b003:l018","ordinal":369871,"en":"Smash his ribs and back"},{"id":"seytek-2012:p0951:b003:l019","ordinal":369872,"en":"Until they crack and splinter!"},{"id":"seytek-2012:p0951:b003:l020","ordinal":369873,"en":"Pour out his blood in torrents!"},{"id":"seytek-2012:p0951:b003:l021","ordinal":369874,"en":"Take that shameless swine"},{"id":"seytek-2012:p0951:b003:l022","ordinal":369875,"en":"And stretch him full-length!"},{"id":"seytek-2012:p0951:b003:l023","ordinal":369876,"en":"Strip away the villain’s pride,"},{"id":"seytek-2012:p0951:b003:l024","ordinal":369877,"en":"End that monster’s life,"},{"id":"seytek-2012:p0951:b003:l025","ordinal":369878,"en":"Gouge out both his eyes!"},{"id":"seytek-2012:p0951:b003:l026","ordinal":369879,"en":"If you are truly our beloved,"},{"id":"seytek-2012:p0951:b003:l027","ordinal":369880,"en":"Catch him and slaughter him!"},{"id":"seytek-2012:p0951:b003:l028","ordinal":369881,"en":"Strip away every last twitch,"},{"id":"seytek-2012:p0951:b003:l029","ordinal":369882,"en":"Bring the khan to his death,"},{"id":"seytek-2012:p0951:b003:l030","ordinal":369883,"en":"Bring the lord’s devices to nothing,"},{"id":"seytek-2012:p0951:b003:l031","ordinal":369884,"en":"Beat out his raging madness,"},{"id":"seytek-2012:p0951:b003:l032","ordinal":369885,"en":"And settle his account in full!"},{"id":"seytek-2012:p0951:b003:l033","ordinal":369886,"en":"Drive him steadily—do not rush!"},{"id":"seytek-2012:p0951:b003:l034","ordinal":369887,"en":"Pin him fast and let him not stir!”"},{"id":"seytek-2012:p0951:b003:l035","ordinal":369888,"en":"He steeped his steel in blood,"},{"id":"seytek-2012:p0951:b003:l036","ordinal":369889,"en":"Seeking a way to strike fiercely;"},{"id":"seytek-2012:p0951:b003:l037","ordinal":369890,"en":"The cunning swine had gone berserk."},{"id":"seytek-2012:p0951:b003:l038","ordinal":369891,"en":"Almambet, Chubak, and the forty men"},{"id":"seytek-2012:p0951:b003:l039","ordinal":369892,"en":"Raised their voices in a shout—"},{"id":"seytek-2012:p0951:b003:l040","ordinal":369893,"en":"Men who had departed for the other world,"},{"id":"seytek-2012:p0952:b002:l001","ordinal":369894,"en":"They remained beside lion-hearted Seytek,"},{"id":"seytek-2012:p0952:b002:l002","ordinal":369895,"en":"Serving as his comrades."},{"id":"seytek-2012:p0952:b002:l003","ordinal":369896,"en":"Much of this is false and much is true;"},{"id":"seytek-2012:p0952:b002:l004","ordinal":369897,"en":"No one has returned from there after seeing it."},{"id":"seytek-2012:p0952:b002:l005","ordinal":369898,"en":"Half is invention and half is truth;"},{"id":"seytek-2012:p0952:b002:l006","ordinal":369899,"en":"Unless the Creator himself knows,"},{"id":"seytek-2012:p0952:b002:l007","ordinal":369900,"en":"No one has come back from beyond."},{"id":"seytek-2012:p0952:b002:l008","ordinal":369901,"en":"How could we leave untold"},{"id":"seytek-2012:p0952:b002:l009","ordinal":369902,"en":"The tale of your forefathers?"},{"id":"seytek-2012:p0952:b002:l010","ordinal":369903,"en":"The tale has turned into a sorrowful song;"},{"id":"seytek-2012:p0952:b002:l011","ordinal":369904,"en":"Let us speak again of the ordeal"},{"id":"seytek-2012:p0952:b002:l012","ordinal":369905,"en":"Of that vanished warrior,"},{"id":"seytek-2012:p0952:b002:l013","ordinal":369906,"en":"Brave infidel Sarybai."},{"id":"seytek-2012:p0952:b002:l014","ordinal":369907,"en":"His thrusting spear must have pierced,"},{"id":"seytek-2012:p0952:b002:l015","ordinal":369908,"en":"His reach extended across the world;"},{"id":"seytek-2012:p0952:b002:l016","ordinal":369909,"en":"He crushed every man who grappled with him,"},{"id":"seytek-2012:p0952:b002:l017","ordinal":369910,"en":"His strength swelled and overflowed,"},{"id":"seytek-2012:p0952:b002:l018","ordinal":369911,"en":"And in his fury he overran"},{"id":"seytek-2012:p0952:b002:l019","ordinal":369912,"en":"The whole wide world."},{"id":"seytek-2012:p0952:b002:l020","ordinal":369913,"en":"Almambet’s son Külchoro,"},{"id":"seytek-2012:p0952:b002:l021","ordinal":369914,"en":"In the battle of the day before,"},{"id":"seytek-2012:p0952:b002:l022","ordinal":369915,"en":"Had fought for seven days"},{"id":"seytek-2012:p0952:b002:l023","ordinal":369916,"en":"And taken wounds in seven places;"},{"id":"seytek-2012:p0952:b002:l024","ordinal":369917,"en":"With scarcely a spark of life,"},{"id":"seytek-2012:p0952:b002:l025","ordinal":369918,"en":"His lungs pounding painfully,"},{"id":"seytek-2012:p0952:b002:l026","ordinal":369919,"en":"He bore anguish too great for his breast"},{"id":"seytek-2012:p0952:b002:l027","ordinal":369920,"en":"And wounds across much of his body."}]
