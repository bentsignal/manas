[{"id":"manas-2010:p0433:b001:l016","ordinal":19969,"en":"The skilled ones of abundant courage,"},{"id":"manas-2010:p0433:b001:l017","ordinal":19970,"en":"Upon your dear Kutubiy,"},{"id":"manas-2010:p0433:b001:l018","ordinal":19971,"en":"They swept forward."},{"id":"manas-2010:p0433:b001:l019","ordinal":19972,"en":"Champions bearing iron-headed clubs"},{"id":"manas-2010:p0433:b001:l020","ordinal":19973,"en":"Had all swept forward together."},{"id":"manas-2010:p0433:b001:l021","ordinal":19974,"en":"The Chinese ran, seething;"},{"id":"manas-2010:p0433:b001:l022","ordinal":19975,"en":"When they struck with maces and clubs,"},{"id":"manas-2010:p0433:b001:l023","ordinal":19976,"en":"The Kalmyks boiled forth,"},{"id":"manas-2010:p0433:b001:l024","ordinal":19977,"en":"When they made the end of the world,"},{"id":"manas-2010:p0433:b001:l025","ordinal":19978,"en":"Despairing of his precious life,"},{"id":"manas-2010:p0433:b001:l026","ordinal":19979,"en":"Fortunate companion Kutubiy"},{"id":"manas-2010:p0433:b001:l027","ordinal":19980,"en":"Utterly despaired of his life."},{"id":"manas-2010:p0433:b001:l028","ordinal":19981,"en":"The reason he stood thus:"},{"id":"manas-2010:p0433:b001:l029","ordinal":19982,"en":"Look at the grass upon the earth;"},{"id":"manas-2010:p0433:b001:l030","ordinal":19983,"en":"Look at Chinese countless as the grass."},{"id":"manas-2010:p0433:b001:l031","ordinal":19984,"en":"Look at the ants, look at the insects;"},{"id":"manas-2010:p0433:b001:l032","ordinal":19985,"en":"Look at the Chinese people countless as insects!"},{"id":"manas-2010:p0433:b001:l033","ordinal":19986,"en":"The earth swarmed, seething;"},{"id":"manas-2010:p0433:b001:l034","ordinal":19987,"en":"The Chinese arrived, swarming."},{"id":"manas-2010:p0433:b001:l035","ordinal":19988,"en":"Dust that filled the earth arrived;"},{"id":"manas-2010:p0433:b001:l036","ordinal":19989,"en":"When the Chinese arrived and attacked,"},{"id":"manas-2010:p0433:b001:l037","ordinal":19990,"en":"Kutubiy's strength departed."},{"id":"manas-2010:p0433:b001:l038","ordinal":19991,"en":"He had no support to lean his breast upon,"},{"id":"manas-2010:p0433:b001:l039","ordinal":19992,"en":"No Töshtük, no lion Manas."},{"id":"manas-2010:p0433:b001:l040","ordinal":19993,"en":"He had no strength to grapple."},{"id":"manas-2010:p0433:b001:l041","ordinal":19994,"en":"Its falsehood was revealed—"},{"id":"manas-2010:p0433:b001:l042","ordinal":19995,"en":"Such is this treacherous world!"},{"id":"manas-2010:p0433:b001:l043","ordinal":19996,"en":"He had none of the many khans he called friends."},{"id":"manas-2010:p0433:b001:l044","ordinal":19997,"en":"When the Chinese inflicted hell,"},{"id":"manas-2010:p0433:b001:l045","ordinal":19998,"en":"To rescue him,"},{"id":"manas-2010:p0433:b001:l046","ordinal":19999,"en":"Mountain-like Manas was absent too."},{"id":"manas-2010:p0433:b001:l047","ordinal":20000,"en":"There was no one to count on;"},{"id":"manas-2010:p0433:b001:l048","ordinal":20001,"en":"A grievous ordeal had come."},{"id":"manas-2010:p0434:b001:l001","ordinal":20002,"en":"The tumult began."},{"id":"manas-2010:p0434:b001:l002","ordinal":20003,"en":"Khan Zholoy at their head, the mighty giants,"},{"id":"manas-2010:p0434:b001:l003","ordinal":20004,"en":"When they reached him and thrust their spears,"},{"id":"manas-2010:p0434:b001:l004","ordinal":20005,"en":"Reeling on the horse Telkyzyl,"},{"id":"manas-2010:p0434:b001:l005","ordinal":20006,"en":"That born champion, that renowned one,"},{"id":"manas-2010:p0434:b001:l006","ordinal":20007,"en":"Fortunate Kutubiy,"},{"id":"manas-2010:p0434:b001:l007","ordinal":20008,"en":"Was flung off outright."},{"id":"manas-2010:p0434:b001:l008","ordinal":20009,"en":"The Chinese swarmed over the earth, they said;"},{"id":"manas-2010:p0434:b001:l009","ordinal":20010,"en":"Such a dream could not come in sleep."},{"id":"manas-2010:p0434:b001:l010","ordinal":20011,"en":"The Chinese were multitudes, he was alone."},{"id":"manas-2010:p0434:b001:l011","ordinal":20012,"en":"His precious Manas was not there."},{"id":"manas-2010:p0434:b001:l012","ordinal":20013,"en":"Was there such a thing in the world!?"},{"id":"manas-2010:p0434:b001:l013","ordinal":20014,"en":"His foe, Kakanchyn,"},{"id":"manas-2010:p0434:b001:l014","ordinal":20015,"en":"Taking orders from his khan,"},{"id":"manas-2010:p0434:b001:l015","ordinal":20016,"en":"Had begun a grievous ordeal."},{"id":"manas-2010:p0434:b001:l016","ordinal":20017,"en":"Galloping on Kulachaar,"},{"id":"manas-2010:p0434:b001:l017","ordinal":20018,"en":"Upon your valiant lion Manas,"},{"id":"manas-2010:p0434:b001:l018","ordinal":20019,"en":"Champions swarmed in encounter."},{"id":"manas-2010:p0434:b001:l019","ordinal":20020,"en":"No small strife, but a great battle,"},{"id":"manas-2010:p0434:b001:l020","ordinal":20021,"en":"Slaughter was found here."},{"id":"manas-2010:p0434:b001:l021","ordinal":20022,"en":"The forty boys he had as companions,"},{"id":"manas-2010:p0434:b001:l022","ordinal":20023,"en":"Slaughtered and struck by shots,"},{"id":"manas-2010:p0434:b001:l023","ordinal":20024,"en":"Before valiant wolf-man Manas,"},{"id":"manas-2010:p0434:b001:l024","ordinal":20025,"en":"Were found right before him."},{"id":"manas-2010:p0434:b001:l025","ordinal":20026,"en":"Yesterday, against Black Kalmyks and Manchus,"},{"id":"manas-2010:p0434:b001:l026","ordinal":20027,"en":"He had wrought havoc."},{"id":"manas-2010:p0434:b001:l027","ordinal":20028,"en":"Forty boys from forty households,"},{"id":"manas-2010:p0434:b001:l028","ordinal":20029,"en":"Your valiant one endowed by Kydyr"},{"id":"manas-2010:p0434:b001:l029","ordinal":20030,"en":"Had taken as companions."},{"id":"manas-2010:p0434:b001:l030","ordinal":20031,"en":"The Chinese had swept upon them."},{"id":"manas-2010:p0434:b001:l031","ordinal":20032,"en":"While valiant Manas was absent,"},{"id":"manas-2010:p0434:b001:l032","ordinal":20033,"en":"The forty boys, the Chinese"},{"id":"manas-2010:p0434:b001:l033","ordinal":20034,"en":"Had slaughtered them."},{"id":"manas-2010:p0434:b001:l034","ordinal":20035,"en":"“They have cut my speech short;"},{"id":"manas-2010:p0434:b001:l035","ordinal":20036,"en":"Killing them all together,"},{"id":"manas-2010:p0434:b001:l036","ordinal":20037,"en":"They have broken my back."},{"id":"manas-2010:p0434:b001:l037","ordinal":20038,"en":"The Chinese have begun their sport."},{"id":"manas-2010:p0434:b001:l038","ordinal":20039,"en":"The forty boys I counted on,"},{"id":"manas-2010:p0434:b001:l039","ordinal":20040,"en":"These daughter-damned swine"},{"id":"manas-2010:p0434:b001:l040","ordinal":20041,"en":"Have slaughtered them.”"},{"id":"manas-2010:p0434:b001:l041","ordinal":20042,"en":"They had gouged his eyes wide open:"},{"id":"manas-2010:p0434:b001:l042","ordinal":20043,"en":"“Fortunate companion Kutubiy,"},{"id":"manas-2010:p0434:b001:l043","ordinal":20044,"en":"Where have they left the poor man?"},{"id":"manas-2010:p0434:b001:l044","ordinal":20045,"en":"Making sport of that wretch,"},{"id":"manas-2010:p0434:b001:l045","ordinal":20046,"en":"Where have they left his bones?"},{"id":"manas-2010:p0434:b001:l046","ordinal":20047,"en":"Kutubiy, given by divine power,"},{"id":"manas-2010:p0434:b001:l047","ordinal":20048,"en":"Who heeded my words so well,"},{"id":"manas-2010:p0434:b001:l048","ordinal":20049,"en":"Who was a blessing to me,"},{"id":"manas-2010:p0435:b001:l001","ordinal":20050,"en":"Have the Chinese gathered in force,"},{"id":"manas-2010:p0435:b001:l002","ordinal":20051,"en":"Have they surrounded him,"},{"id":"manas-2010:p0435:b001:l003","ordinal":20052,"en":"Sent my poor friend crawling?"},{"id":"manas-2010:p0435:b001:l004","ordinal":20053,"en":"Where have they slaughtered him?!"},{"id":"manas-2010:p0435:b001:l005","ordinal":20054,"en":"If my end comes, let me die."},{"id":"manas-2010:p0435:b001:l006","ordinal":20055,"en":"Against the oppressive Black Kalmyks,"},{"id":"manas-2010:p0435:b001:l007","ordinal":20056,"en":"Let me wage battle."},{"id":"manas-2010:p0435:b001:l008","ordinal":20057,"en":"Let me unleash volleys of shots,"},{"id":"manas-2010:p0435:b001:l009","ordinal":20058,"en":"Fighting six months without rest."},{"id":"manas-2010:p0435:b001:l010","ordinal":20059,"en":"Kutubiy was fortunate;"},{"id":"manas-2010:p0435:b001:l011","ordinal":20060,"en":"If my poor friend still lives,"},{"id":"manas-2010:p0435:b001:l012","ordinal":20061,"en":"Let me rescue him."},{"id":"manas-2010:p0435:b001:l013","ordinal":20062,"en":"Against Black Chinese and Manchus,"},{"id":"manas-2010:p0435:b001:l014","ordinal":20063,"en":"Let me wage fierce combat."},{"id":"manas-2010:p0435:b001:l015","ordinal":20064,"en":"The Chinese who boast of strength,"},{"id":"manas-2010:p0435:b001:l016","ordinal":20065,"en":"Let me batter their fury every day!"},{"id":"manas-2010:p0435:b001:l017","ordinal":20066,"en":"Against the Kalmyks who use force,"},{"id":"manas-2010:p0435:b001:l018","ordinal":20067,"en":"Let me find some means."},{"id":"manas-2010:p0435:b001:l019","ordinal":20068,"en":"The Black Kalmyks who face me,"},{"id":"manas-2010:p0435:b001:l020","ordinal":20069,"en":"Let me face them and make slaughter!"},{"id":"manas-2010:p0435:b001:l021","ordinal":20070,"en":"My precious Kutubiy,"},{"id":"manas-2010:p0435:b001:l022","ordinal":20071,"en":"If the valiant one still lives,"},{"id":"manas-2010:p0435:b001:l023","ordinal":20072,"en":"Let me rescue him!”"},{"id":"manas-2010:p0435:b001:l024","ordinal":20073,"en":"Thus Khan Manas spoke."},{"id":"manas-2010:p0435:b001:l025","ordinal":20074,"en":"His companion pledged by the broad sword,"},{"id":"manas-2010:p0435:b001:l026","ordinal":20075,"en":"Kutubiy, lying in torment,"},{"id":"manas-2010:p0435:b001:l027","ordinal":20076,"en":"Of valiant wolf-man Manas,"},{"id":"manas-2010:p0435:b001:l028","ordinal":20077,"en":"Was a companion to the Day of Judgment."},{"id":"manas-2010:p0435:b001:l029","ordinal":20078,"en":"Wrathful champion, skillful lion,"},{"id":"manas-2010:p0435:b001:l030","ordinal":20079,"en":"Because Kutubiy was missing, your valiant one"},{"id":"manas-2010:p0435:b001:l031","ordinal":20080,"en":"Plunged among the Kalmyks there."},{"id":"manas-2010:p0435:b001:l032","ordinal":20081,"en":"Toruchaar beneath him,"},{"id":"manas-2010:p0435:b001:l033","ordinal":20082,"en":"Whipping this way and that,"},{"id":"manas-2010:p0435:b001:l034","ordinal":20083,"en":"Looming and lurching,"},{"id":"manas-2010:p0435:b001:l035","ordinal":20084,"en":"Staring fiercely, his great frame bristling,"},{"id":"manas-2010:p0435:b001:l036","ordinal":20085,"en":"He had a courser beneath him."},{"id":"manas-2010:p0435:b001:l037","ordinal":20086,"en":"The whole world, the magnanimous lion"},{"id":"manas-2010:p0435:b001:l038","ordinal":20087,"en":"Had the strength to drive before him."},{"id":"manas-2010:p0435:b001:l039","ordinal":20088,"en":"He was the champion, he the lion,"},{"id":"manas-2010:p0435:b001:l040","ordinal":20089,"en":"Drinking blood wherever he faced,"},{"id":"manas-2010:p0435:b001:l041","ordinal":20090,"en":"He was renowned warrior Manas."},{"id":"manas-2010:p0435:b001:l042","ordinal":20091,"en":"A company of nine supported him;"},{"id":"manas-2010:p0435:b001:l043","ordinal":20092,"en":"It was the hour they came to his aid."},{"id":"manas-2010:p0435:b001:l044","ordinal":20093,"en":"The forty Chiltens, Kydyr, Nyyaz,"},{"id":"manas-2010:p0435:b001:l045","ordinal":20094,"en":"To wolf-man Manas blessed by Kydyr,"},{"id":"manas-2010:p0435:b001:l046","ordinal":20095,"en":"Were then his companions."},{"id":"manas-2010:p0435:b001:l047","ordinal":20096,"en":"He was the champion, he the support;"},{"id":"manas-2010:p0435:b001:l048","ordinal":20097,"en":"He was the renowned wolf-man lion."},{"id":"manas-2010:p0436:b001:l001","ordinal":20098,"en":"At the spur like a saddle-shaped pass,"},{"id":"manas-2010:p0436:b001:l002","ordinal":20099,"en":"When Manas bent and looked,"},{"id":"manas-2010:p0436:b001:l003","ordinal":20100,"en":"The Kalmyks had arrived in swarms."},{"id":"manas-2010:p0436:b001:l004","ordinal":20101,"en":"Valiant wolf-man Kutu,"},{"id":"manas-2010:p0436:b001:l005","ordinal":20102,"en":"Forty-two had surrounded him."},{"id":"manas-2010:p0436:b001:l006","ordinal":20103,"en":"Before the magnanimous one could reach him,"},{"id":"manas-2010:p0436:b001:l007","ordinal":20104,"en":"Their spearmen jutted forward;"},{"id":"manas-2010:p0436:b001:l008","ordinal":20105,"en":"Their mighty men with battle-axes"},{"id":"manas-2010:p0436:b001:l009","ordinal":20106,"en":"Had swept upon him, towering."},{"id":"manas-2010:p0436:b001:l010","ordinal":20107,"en":"Their tormenting iron-armed men"},{"id":"manas-2010:p0436:b001:l011","ordinal":20108,"en":"Had drawn close."},{"id":"manas-2010:p0436:b001:l012","ordinal":20109,"en":"Your fortunate Kutubiy,"},{"id":"manas-2010:p0436:b001:l013","ordinal":20110,"en":"To reach and bind him,"},{"id":"manas-2010:p0436:b001:l014","ordinal":20111,"en":"They had come near in a frenzy."},{"id":"manas-2010:p0436:b001:l015","ordinal":20112,"en":"Their mighty men hunched forward;"},{"id":"manas-2010:p0436:b001:l016","ordinal":20113,"en":"Their spearmen crouched deftly."},{"id":"manas-2010:p0436:b001:l017","ordinal":20114,"en":"Their marksmen faced him,"},{"id":"manas-2010:p0436:b001:l018","ordinal":20115,"en":"Thrusting their quivers firmly forward."},{"id":"manas-2010:p0436:b001:l019","ordinal":20116,"en":"Your fortunate Kutubiy,"},{"id":"manas-2010:p0436:b001:l020","ordinal":20117,"en":"They had plunged into great torment."},{"id":"manas-2010:p0436:b001:l021","ordinal":20118,"en":"Raging Zholoy and Ezkara"},{"id":"manas-2010:p0436:b001:l022","ordinal":20119,"en":"Had encircled him."},{"id":"manas-2010:p0436:b001:l023","ordinal":20120,"en":"As though to destroy Kutu,"},{"id":"manas-2010:p0436:b001:l024","ordinal":20121,"en":"They had swept upon him."},{"id":"manas-2010:p0436:b001:l025","ordinal":20122,"en":"Countless troops ran from every side;"},{"id":"manas-2010:p0436:b001:l026","ordinal":20123,"en":"Their champions of fierce wrath"},{"id":"manas-2010:p0436:b001:l027","ordinal":20124,"en":"Were about to seize him."},{"id":"manas-2010:p0436:b001:l028","ordinal":20125,"en":"The Chinese, sweeping inward,"},{"id":"manas-2010:p0436:b001:l029","ordinal":20126,"en":"Your dear Kutubiy,"},{"id":"manas-2010:p0436:b001:l030","ordinal":20127,"en":"Were about to bind him."},{"id":"manas-2010:p0436:b001:l031","ordinal":20128,"en":"Teeming like ants,"},{"id":"manas-2010:p0436:b001:l032","ordinal":20129,"en":"They had surrounded him, swaying."},{"id":"manas-2010:p0436:b001:l033","ordinal":20130,"en":"What their champions drew:"},{"id":"manas-2010:p0436:b001:l034","ordinal":20131,"en":"Destructive bows and lacquered arrows."},{"id":"manas-2010:p0436:b001:l035","ordinal":20132,"en":"Drawing bows like rain,"},{"id":"manas-2010:p0436:b001:l036","ordinal":20133,"en":"Drawing their arrows and shooting,"},{"id":"manas-2010:p0436:b001:l037","ordinal":20134,"en":"The Chinese had come upon him."},{"id":"manas-2010:p0436:b001:l038","ordinal":20135,"en":"Earth flew and piled up;"},{"id":"manas-2010:p0436:b001:l039","ordinal":20136,"en":"When the Chinese overwhelmed him,"},{"id":"manas-2010:p0436:b001:l040","ordinal":20137,"en":"Kutubiy was hard pressed,"},{"id":"manas-2010:p0436:b001:l041","ordinal":20138,"en":"Drenched in crimson blood."},{"id":"manas-2010:p0436:b001:l042","ordinal":20139,"en":"The Chinese ran with an uproar."},{"id":"manas-2010:p0436:b001:l043","ordinal":20140,"en":"“Mighty God, divine Power,"},{"id":"manas-2010:p0436:b001:l044","ordinal":20141,"en":"Grant me faith!” he said."},{"id":"manas-2010:p0436:b001:l045","ordinal":20142,"en":"Despairing of his precious life,"},{"id":"manas-2010:p0436:b001:l046","ordinal":20143,"en":"The warrior's strength failed."},{"id":"manas-2010:p0436:b001:l047","ordinal":20144,"en":"At the surrounding Chinese unbelievers,"},{"id":"manas-2010:p0436:b001:l048","ordinal":20145,"en":"His eyes rolled wildly,"},{"id":"manas-2010:p0437:b001:l001","ordinal":20146,"en":"His legs dangled loose."},{"id":"manas-2010:p0437:b001:l002","ordinal":20147,"en":"Much torment from the Chinese,"},{"id":"manas-2010:p0437:b001:l003","ordinal":20148,"en":"He was about to suffer."},{"id":"manas-2010:p0437:b001:l004","ordinal":20149,"en":"Your wolf-man's Kutubiy,"},{"id":"manas-2010:p0437:b001:l005","ordinal":20150,"en":"From the many Chinese like ravening beasts,"},{"id":"manas-2010:p0437:b001:l006","ordinal":20151,"en":"Was about to die!"},{"id":"manas-2010:p0437:b001:l007","ordinal":20152,"en":"As though weighed down by anxiety,"},{"id":"manas-2010:p0437:b001:l008","ordinal":20153,"en":"His eyes grew dim but would not close."},{"id":"manas-2010:p0437:b001:l009","ordinal":20154,"en":"The Chinese swept upon him and attacked;"},{"id":"manas-2010:p0437:b001:l010","ordinal":20155,"en":"At the very least, upon Kutu,"},{"id":"manas-2010:p0437:b001:l011","ordinal":20156,"en":"Seventy spears struck at once."},{"id":"manas-2010:p0437:b001:l012","ordinal":20157,"en":"The Chinese strove to seize him."},{"id":"manas-2010:p0437:b001:l013","ordinal":20158,"en":"Torn into strips like saddle-thongs,"},{"id":"manas-2010:p0437:b001:l014","ordinal":20159,"en":"Kutu's armor was ripped apart."},{"id":"manas-2010:p0437:b001:l015","ordinal":20160,"en":"Upon Kutu, whose strength was gone,"},{"id":"manas-2010:p0437:b001:l016","ordinal":20161,"en":"Countless Chinese rushed."},{"id":"manas-2010:p0437:b001:l017","ordinal":20162,"en":"“Let me make a dreadful slaughter,"},{"id":"manas-2010:p0437:b001:l018","ordinal":20163,"en":"Let me rescue Kutubiy"},{"id":"manas-2010:p0437:b001:l019","ordinal":20164,"en":"And have him as my companion."},{"id":"manas-2010:p0437:b001:l020","ordinal":20165,"en":"With no one to count on, no support,"},{"id":"manas-2010:p0437:b001:l021","ordinal":20166,"en":"How can I remain alone!"},{"id":"manas-2010:p0437:b001:l022","ordinal":20167,"en":"You made me a lion who slaughters Chinese;"},{"id":"manas-2010:p0437:b001:l023","ordinal":20168,"en":"If I lose my valiant friends,"},{"id":"manas-2010:p0437:b001:l024","ordinal":20169,"en":"Divine Power, what have I done to You?”"},{"id":"manas-2010:p0437:b001:l025","ordinal":20170,"en":"Striking Toruchaar once on the thigh,"},{"id":"manas-2010:p0437:b001:l026","ordinal":20171,"en":"Pitching forward like a mountain,"},{"id":"manas-2010:p0437:b001:l027","ordinal":20172,"en":"Whirling his spear into his hand,"},{"id":"manas-2010:p0437:b001:l028","ordinal":20173,"en":"Into the surging Chinese,"},{"id":"manas-2010:p0437:b001:l029","ordinal":20174,"en":"Manas attacked without stopping."},{"id":"manas-2010:p0437:b001:l030","ordinal":20175,"en":"Manas arrived with a bound;"},{"id":"manas-2010:p0437:b001:l031","ordinal":20176,"en":"Into the host that filled the earth,"},{"id":"manas-2010:p0437:b001:l032","ordinal":20177,"en":"He plunged among them."},{"id":"manas-2010:p0437:b001:l033","ordinal":20178,"en":"Their men who cast lassos,"},{"id":"manas-2010:p0437:b001:l034","ordinal":20179,"en":"Their champions who swung battle-axes,"},{"id":"manas-2010:p0437:b001:l035","ordinal":20180,"en":"Those with nets of iron rope,"},{"id":"manas-2010:p0437:b001:l036","ordinal":20181,"en":"Those all armed with daggers—"},{"id":"manas-2010:p0437:b001:l037","ordinal":20182,"en":"Your ocean-like Manas reached them."},{"id":"manas-2010:p0437:b001:l038","ordinal":20183,"en":"All of them where he arrived,"},{"id":"manas-2010:p0437:b001:l039","ordinal":20184,"en":"He struck down and passed."},{"id":"manas-2010:p0437:b001:l040","ordinal":20185,"en":"Their giants no horse could carry,"},{"id":"manas-2010:p0437:b001:l041","ordinal":20186,"en":"He speared down from their horses."},{"id":"manas-2010:p0437:b001:l042","ordinal":20187,"en":"Their courageous men, their warriors,"},{"id":"manas-2010:p0437:b001:l043","ordinal":20188,"en":"He speared down, stretched out flat."},{"id":"manas-2010:p0437:b001:l044","ordinal":20189,"en":"Bellowing in his wrath,"},{"id":"manas-2010:p0437:b001:l045","ordinal":20190,"en":"The Manchus, like black insects,"},{"id":"manas-2010:p0437:b001:l046","ordinal":20191,"en":"He drove out in a sweeping rout."},{"id":"manas-2010:p0437:b001:l047","ordinal":20192,"en":"Can a mortal challenge and defeat him?"},{"id":"manas-2010:p0437:b001:l048","ordinal":20193,"en":"Against the champion born bloodthirsty,"},{"id":"manas-2010:p0438:b001:l001","ordinal":20194,"en":"Can one who grapples be his equal!"},{"id":"manas-2010:p0438:b001:l002","ordinal":20195,"en":"Girding his waist in a frenzy,"},{"id":"manas-2010:p0438:b001:l003","ordinal":20196,"en":"Into the unbelievers who filled the earth,"},{"id":"manas-2010:p0438:b001:l004","ordinal":20197,"en":"Raging Zholoy and Ezkara,"},{"id":"manas-2010:p0438:b001:l005","ordinal":20198,"en":"Against heroes such as these,"},{"id":"manas-2010:p0438:b001:l006","ordinal":20199,"en":"He entered alone and attacked."},{"id":"manas-2010:p0438:b001:l007","ordinal":20200,"en":"Those with nets of iron rope,"},{"id":"manas-2010:p0438:b001:l008","ordinal":20201,"en":"Those all armed with daggers,"},{"id":"manas-2010:p0438:b001:l009","ordinal":20202,"en":"Khan Manas slaughtered as he went."},{"id":"manas-2010:p0438:b001:l010","ordinal":20203,"en":"The strong men clad in jackets,"},{"id":"manas-2010:p0438:b001:l011","ordinal":20204,"en":"When they saw Manas's bearing,"},{"id":"manas-2010:p0438:b001:l012","ordinal":20205,"en":"Their heroes were thrown into panic."},{"id":"manas-2010:p0438:b001:l013","ordinal":20206,"en":"“That bloodthirsty one—may your house burn—"},{"id":"manas-2010:p0438:b001:l014","ordinal":20207,"en":"He will kill us and finish us,” they said."},{"id":"manas-2010:p0438:b001:l015","ordinal":20208,"en":"“Slaughtering every one of you,"},{"id":"manas-2010:p0438:b001:l016","ordinal":20209,"en":"He will shatter and slay you,” they said."},{"id":"manas-2010:p0438:b001:l017","ordinal":20210,"en":"They broke from the army and fled."},{"id":"manas-2010:p0438:b001:l018","ordinal":20211,"en":"The reason they fled:"},{"id":"manas-2010:p0438:b001:l019","ordinal":20212,"en":"The hearts of those who saw him faltered;"},{"id":"manas-2010:p0438:b001:l020","ordinal":20213,"en":"Your wolf-man, one person,"},{"id":"manas-2010:p0438:b001:l021","ordinal":20214,"en":"Appeared like many men."},{"id":"manas-2010:p0438:b001:l022","ordinal":20215,"en":"When one looked from the front,"},{"id":"manas-2010:p0438:b001:l023","ordinal":20216,"en":"In your champion himself"},{"id":"manas-2010:p0438:b001:l024","ordinal":20217,"en":"Was the terror of five lions."},{"id":"manas-2010:p0438:b001:l025","ordinal":20218,"en":"When one looked from the side,"},{"id":"manas-2010:p0438:b001:l026","ordinal":20219,"en":"He had the shape of a dragon."},{"id":"manas-2010:p0438:b001:l027","ordinal":20220,"en":"His war cry split the rocks;"},{"id":"manas-2010:p0438:b001:l028","ordinal":20221,"en":"He had come driving them onward."},{"id":"manas-2010:p0438:b001:l029","ordinal":20222,"en":"Letting blood flow, spilling stomach contents,"},{"id":"manas-2010:p0438:b001:l030","ordinal":20223,"en":"The Black Kalmyks and Manchus,"},{"id":"manas-2010:p0438:b001:l031","ordinal":20224,"en":"He had come slaughtering them."}]
