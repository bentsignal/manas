[{"id":"semetey-1-2013:p0801:b003:l027","ordinal":138241,"en":"I was like a mother to him."},{"id":"semetey-1-2013:p0801:b003:l028","ordinal":138242,"en":"Allah Almighty, the All-Powerful,"},{"id":"semetey-1-2013:p0801:b003:l029","ordinal":138243,"en":"Seems to have granted him to me."},{"id":"semetey-1-2013:p0801:b003:l030","ordinal":138244,"en":"Before Semetey,"},{"id":"semetey-1-2013:p0801:b003:l031","ordinal":138245,"en":"Drawing within an arrow's flight,"},{"id":"semetey-1-2013:p0801:b003:l032","ordinal":138246,"en":"He seems to have returned!"},{"id":"semetey-1-2013:p0801:b003:l033","ordinal":138247,"en":"My reed-like plant growing in the valley,"},{"id":"semetey-1-2013:p0801:b003:l034","ordinal":138248,"en":"My only child, won at death's door,"},{"id":"semetey-1-2013:p0801:b003:l035","ordinal":138249,"en":"Kumaiyk, left in trust,"},{"id":"semetey-1-2013:p0801:b003:l036","ordinal":138250,"en":"He has brought back to me"},{"id":"semetey-1-2013:p0801:b003:l037","ordinal":138251,"en":"And shown before my eyes.”"},{"id":"semetey-1-2013:p0801:b003:l038","ordinal":138252,"en":"Her poor heart was stirred;"},{"id":"semetey-1-2013:p0801:b003:l039","ordinal":138253,"en":"The one running below"},{"id":"semetey-1-2013:p0801:b005:l001","ordinal":138254,"en":"Was truly Kumaiyk, it seemed."},{"id":"semetey-1-2013:p0801:b005:l002","ordinal":138255,"en":"The one coming behind him—"},{"id":"semetey-1-2013:p0801:b005:l003","ordinal":138256,"en":"“My plump little mottled gray hawk,"},{"id":"semetey-1-2013:p0801:b005:l004","ordinal":138257,"en":"My gray goshawk, my falcon,"},{"id":"semetey-1-2013:p0801:b005:l005","ordinal":138258,"en":"My spring flowing through the valley,"},{"id":"semetey-1-2013:p0801:b005:l006","ordinal":138259,"en":"Comes riding Taibuurul,"},{"id":"semetey-1-2013:p0801:b005:l007","ordinal":138260,"en":"My lamp, won at death's door!”"},{"id":"semetey-1-2013:p0801:b005:l008","ordinal":138261,"en":"Seeing him, her poor heart was stirred:"},{"id":"semetey-1-2013:p0801:b005:l009","ordinal":138262,"en":"“Oh, mother, good tidings!"},{"id":"semetey-1-2013:p0801:b005:l010","ordinal":138263,"en":"My orphan seems to be coming!"},{"id":"semetey-1-2013:p0801:b005:l011","ordinal":138264,"en":"He has granted what I wished;"},{"id":"semetey-1-2013:p0801:b005:l012","ordinal":138265,"en":"My orphan, my support, has come!"},{"id":"semetey-1-2013:p0801:b005:l013","ordinal":138266,"en":"God has granted my desire."},{"id":"semetey-1-2013:p0801:b005:l014","ordinal":138267,"en":"Come, mother, rise up;"},{"id":"semetey-1-2013:p0801:b005:l015","ordinal":138268,"en":"The orphan we watched for has come!"},{"id":"semetey-1-2013:p0801:b005:l016","ordinal":138269,"en":"Your brow will now brighten;"},{"id":"semetey-1-2013:p0801:b005:l017","ordinal":138270,"en":"Your sorrow will now ease."},{"id":"semetey-1-2013:p0801:b005:l018","ordinal":138271,"en":"Seeing him, the heart is stirred;"},{"id":"semetey-1-2013:p0801:b005:l019","ordinal":138272,"en":"In build and bearing"},{"id":"semetey-1-2013:p0801:b005:l020","ordinal":138273,"en":"He looks like Manas."},{"id":"semetey-1-2013:p0801:b005:l021","ordinal":138274,"en":"God has granted my desire;"},{"id":"semetey-1-2013:p0801:b005:l022","ordinal":138275,"en":"My orphan left by Manas"},{"id":"semetey-1-2013:p0801:b005:l023","ordinal":138276,"en":"Has taken what he sought."},{"id":"semetey-1-2013:p0801:b005:l024","ordinal":138277,"en":"Why speak of the rest?"},{"id":"semetey-1-2013:p0801:b005:l025","ordinal":138278,"en":"Left by his father,"},{"id":"semetey-1-2013:p0801:b005:l026","ordinal":138279,"en":"The white falcon he has brought."},{"id":"semetey-1-2013:p0801:b005:l027","ordinal":138280,"en":"That dear bird called the wild duck"},{"id":"semetey-1-2013:p0801:b005:l028","ordinal":138281,"en":"Flies without turning back, in search of food."},{"id":"semetey-1-2013:p0801:b005:l029","ordinal":138282,"en":"How much I have suffered, poor soul,"},{"id":"semetey-1-2013:p0801:b005:l030","ordinal":138283,"en":"For you, who came from my womb!"},{"id":"semetey-1-2013:p0801:b005:l031","ordinal":138284,"en":"That wretched bird called the kite"},{"id":"semetey-1-2013:p0801:b005:l032","ordinal":138285,"en":"Swoops in flight in search of food."},{"id":"semetey-1-2013:p0801:b005:l033","ordinal":138286,"en":"Your two mothers have suffered so much"},{"id":"semetey-1-2013:p0801:b005:l034","ordinal":138287,"en":"For you, who came from the womb!”"},{"id":"semetey-1-2013:p0801:b005:l035","ordinal":138288,"en":"Both his mothers wept;"},{"id":"semetey-1-2013:p0801:b005:l036","ordinal":138289,"en":"Poor Chiyirdi wept especially hard."},{"id":"semetey-1-2013:p0801:b005:l038","ordinal":138290,"en":"The boy entered Bukhara,"},{"id":"semetey-1-2013:p0801:b005:l039","ordinal":138291,"en":"All his gear in readiness."},{"id":"semetey-1-2013:p0802:b003:l001","ordinal":138292,"en":"The trust left by Manas,"},{"id":"semetey-1-2013:p0802:b003:l002","ordinal":138293,"en":"All of it was provided."},{"id":"semetey-1-2013:p0802:b003:l003","ordinal":138294,"en":"Long ago, when the widow fled there,"},{"id":"semetey-1-2013:p0802:b003:l004","ordinal":138295,"en":"Her father had set it apart for her:"},{"id":"semetey-1-2013:p0802:b003:l005","ordinal":138296,"en":"Kanykei's white palace,"},{"id":"semetey-1-2013:p0802:b003:l006","ordinal":138297,"en":"Its doors of iron and solid tin."},{"id":"semetey-1-2013:p0802:b003:l007","ordinal":138298,"en":"Though that unfortunate woman was a widow,"},{"id":"semetey-1-2013:p0802:b003:l008","ordinal":138299,"en":"Her dignity was very great."},{"id":"semetey-1-2013:p0802:b003:l009","ordinal":138300,"en":"The poor orphan, grown imposing,"},{"id":"semetey-1-2013:p0802:b003:l010","ordinal":138301,"en":"Stood grandly like his father Manas."},{"id":"semetey-1-2013:p0802:b003:l011","ordinal":138302,"en":"Seeing him, the heart was stirred;"},{"id":"semetey-1-2013:p0802:b003:l012","ordinal":138303,"en":"Your orphan, the wolf-maned warrior's son,"},{"id":"semetey-1-2013:p0802:b003:l013","ordinal":138304,"en":"Came fully into view."},{"id":"semetey-1-2013:p0802:b003:l014","ordinal":138305,"en":"A black-spotted leopard,"},{"id":"semetey-1-2013:p0802:b003:l015","ordinal":138306,"en":"Springing at his side,"},{"id":"semetey-1-2013:p0802:b003:l016","ordinal":138307,"en":"Secretly lent him protection;"},{"id":"semetey-1-2013:p0802:b003:l017","ordinal":138308,"en":"Round about the boy"},{"id":"semetey-1-2013:p0802:b003:l018","ordinal":138309,"en":"It circled."},{"id":"semetey-1-2013:p0802:b003:l019","ordinal":138310,"en":"Kanykei and Chiyirdi,"},{"id":"semetey-1-2013:p0802:b003:l020","ordinal":138311,"en":"Seeing the boy's form,"},{"id":"semetey-1-2013:p0802:b003:l021","ordinal":138312,"en":"Offered their very lives"},{"id":"semetey-1-2013:p0802:b003:l022","ordinal":138313,"en":"As a sacrifice for him."},{"id":"semetey-1-2013:p0802:b003:l023","ordinal":138314,"en":"When they saw their precious one,"},{"id":"semetey-1-2013:p0802:b003:l024","ordinal":138315,"en":"His two mothers rejoiced."},{"id":"semetey-1-2013:p0802:b003:l025","ordinal":138316,"en":"When they saw Kumaiyk,"},{"id":"semetey-1-2013:p0802:b003:l026","ordinal":138317,"en":"Kanykei and Chiyirdi"},{"id":"semetey-1-2013:p0802:b003:l027","ordinal":138318,"en":"Both grieved together."},{"id":"semetey-1-2013:p0802:b003:l028","ordinal":138319,"en":"He had no tongue to speak with,"},{"id":"semetey-1-2013:p0802:b003:l029","ordinal":138320,"en":"Kumaiyk, wiser than other beasts."},{"id":"semetey-1-2013:p0802:b003:l030","ordinal":138321,"en":"The people were there, their khan was there;"},{"id":"semetey-1-2013:p0802:b003:l031","ordinal":138322,"en":"As Kumaiyk stood thus,"},{"id":"semetey-1-2013:p0802:b003:l032","ordinal":138323,"en":"All the multitude was there."},{"id":"semetey-1-2013:p0802:b003:l033","ordinal":138324,"en":"When he saw the two ladies,"},{"id":"semetey-1-2013:p0802:b003:l034","ordinal":138325,"en":"Crouching like a quail,"},{"id":"semetey-1-2013:p0802:b003:l035","ordinal":138326,"en":"Kumaiyk came crouching low."},{"id":"semetey-1-2013:p0802:b003:l036","ordinal":138327,"en":"Tears welled in his eyes;"},{"id":"semetey-1-2013:p0802:b003:l037","ordinal":138328,"en":"Kumaiyk came shedding them."},{"id":"semetey-1-2013:p0802:b003:l038","ordinal":138329,"en":"When he saw the two ladies,"},{"id":"semetey-1-2013:p0802:b003:l039","ordinal":138330,"en":"Kumaiyk stood distraught;"},{"id":"semetey-1-2013:p0802:b004:l001","ordinal":138331,"en":"Sobbing more than a human,"},{"id":"semetey-1-2013:p0802:b004:l002","ordinal":138332,"en":"Kumaiyk stood howling."},{"id":"semetey-1-2013:p0802:b004:l003","ordinal":138333,"en":"Then Kumaiyk,"},{"id":"semetey-1-2013:p0802:b004:l004","ordinal":138334,"en":"When he saw Kanykei,"},{"id":"semetey-1-2013:p0802:b004:l005","ordinal":138335,"en":"Laid his head upon her breast;"},{"id":"semetey-1-2013:p0802:b004:l006","ordinal":138336,"en":"Like a person weeping,"},{"id":"semetey-1-2013:p0802:b004:l007","ordinal":138337,"en":"He lay down and wailed."},{"id":"semetey-1-2013:p0802:b004:l008","ordinal":138338,"en":"As Kumaiyk did this,"},{"id":"semetey-1-2013:p0802:b004:l009","ordinal":138339,"en":"Your poor mother wept with him."},{"id":"semetey-1-2013:p0802:b004:l010","ordinal":138340,"en":"Her own father Temir Khan,"},{"id":"semetey-1-2013:p0802:b004:l011","ordinal":138341,"en":"Her younger brother Ysmayyl—"},{"id":"semetey-1-2013:p0802:b004:l012","ordinal":138342,"en":"The khan of Bukhara wept with them."},{"id":"semetey-1-2013:p0802:b004:l013","ordinal":138343,"en":"When the khan wept, the people wept;"},{"id":"semetey-1-2013:p0802:b004:l014","ordinal":138344,"en":"All the people wept together."},{"id":"semetey-1-2013:p0802:b004:l015","ordinal":138345,"en":"Chiyirdi, grown old,"},{"id":"semetey-1-2013:p0802:b004:l016","ordinal":138346,"en":"The old woman in her bed, wept."},{"id":"semetey-1-2013:p0802:b004:l017","ordinal":138347,"en":"Ah, that creature Kumaiyk"},{"id":"semetey-1-2013:p0802:b004:l018","ordinal":138348,"en":"Had taken my mother"},{"id":"semetey-1-2013:p0802:b004:l019","ordinal":138349,"en":"As a mother in his own mother's place;"},{"id":"semetey-1-2013:p0802:b004:l020","ordinal":138350,"en":"He laid his head upon her breast."},{"id":"semetey-1-2013:p0802:b004:l021","ordinal":138351,"en":"He sniffed at her right breast,"},{"id":"semetey-1-2013:p0802:b004:l022","ordinal":138352,"en":"Then sniffed at her left."},{"id":"semetey-1-2013:p0802:b004:l023","ordinal":138353,"en":"Kanykei wept bitterly;"},{"id":"semetey-1-2013:p0802:b004:l024","ordinal":138354,"en":"Kumaiyk growled."},{"id":"semetey-1-2013:p0802:b004:l025","ordinal":138355,"en":"“Kumaiyk, whom we had asked after,"},{"id":"semetey-1-2013:p0802:b004:l026","ordinal":138356,"en":"Has come in the flesh,” she said."},{"id":"semetey-1-2013:p0802:b004:l027","ordinal":138357,"en":"“The inheritance I longed for"},{"id":"semetey-1-2013:p0802:b004:l028","ordinal":138358,"en":"Has come back to me,” she said."},{"id":"semetey-1-2013:p0802:b004:l029","ordinal":138359,"en":"Like rain from the sky,"},{"id":"semetey-1-2013:p0802:b004:l030","ordinal":138360,"en":"They caressed one another."},{"id":"semetey-1-2013:p0802:b004:l031","ordinal":138361,"en":"For twelve years they had not seen each other;"},{"id":"semetey-1-2013:p0802:b004:l032","ordinal":138362,"en":"Now they were reunited."},{"id":"semetey-1-2013:p0802:b004:l033","ordinal":138363,"en":"Their lord, Manas the wolf-maned warrior,"},{"id":"semetey-1-2013:p0802:b004:l034","ordinal":138364,"en":"Had indeed been their lord."},{"id":"semetey-1-2013:p0802:b004:l035","ordinal":138365,"en":"Long ago, Manas the leopard,"},{"id":"semetey-1-2013:p0802:b004:l036","ordinal":138366,"en":"At the Pass of Belendi,"},{"id":"semetey-1-2013:p0802:b004:l037","ordinal":138367,"en":"Where he performed his ablutions,"},{"id":"semetey-1-2013:p0802:b004:l038","ordinal":138368,"en":"Had found Kumaiyk,"},{"id":"semetey-1-2013:p0802:b004:l039","ordinal":138369,"en":"Before his eyes had opened."},{"id":"semetey-1-2013:p0803:b003:l001","ordinal":138370,"en":"When he was near to death,"},{"id":"semetey-1-2013:p0803:b003:l002","ordinal":138371,"en":"When he found him and brought him back,"},{"id":"semetey-1-2013:p0803:b003:l003","ordinal":138372,"en":"When he gave him to Kanykei,"},{"id":"semetey-1-2013:p0803:b003:l004","ordinal":138373,"en":"The steel collar upon his neck"},{"id":"semetey-1-2013:p0803:b003:l005","ordinal":138374,"en":"Was fastened by Kanykei."},{"id":"semetey-1-2013:p0803:b003:l006","ordinal":138375,"en":"Becoming his mother then,"},{"id":"semetey-1-2013:p0803:b003:l007","ordinal":138376,"en":"Kanykei had raised him."},{"id":"semetey-1-2013:p0803:b003:l008","ordinal":138377,"en":"Before his eyes had opened,"},{"id":"semetey-1-2013:p0803:b003:l009","ordinal":138378,"en":"When he was no bigger than a hand,"},{"id":"semetey-1-2013:p0803:b003:l010","ordinal":138379,"en":"“If I tend the puppy badly,"},{"id":"semetey-1-2013:p0803:b003:l011","ordinal":138380,"en":"Death will take him needlessly,"},{"id":"semetey-1-2013:p0803:b003:l012","ordinal":138381,"en":"And my hopes will perish with him,” she said."},{"id":"semetey-1-2013:p0803:b003:l013","ordinal":138382,"en":"She fed him milk from her mouth;"},{"id":"semetey-1-2013:p0803:b003:l014","ordinal":138383,"en":"She gave him meat with her hand."},{"id":"semetey-1-2013:p0803:b003:l015","ordinal":138384,"en":"Taking no rest by day,"},{"id":"semetey-1-2013:p0803:b003:l016","ordinal":138385,"en":"Getting no sleep by night,"},{"id":"semetey-1-2013:p0803:b003:l017","ordinal":138386,"en":"Thus she raised the sighthound."},{"id":"semetey-1-2013:p0803:b003:l018","ordinal":138387,"en":"Never once lying idle,"},{"id":"semetey-1-2013:p0803:b003:l019","ordinal":138388,"en":"The sighthound you have seen"},{"id":"semetey-1-2013:p0803:b003:l020","ordinal":138389,"en":"She kept as a mother would."},{"id":"semetey-1-2013:p0803:b003:l021","ordinal":138390,"en":"In raising Kumaiyk,"},{"id":"semetey-1-2013:p0803:b003:l022","ordinal":138391,"en":"She thought and pondered,"},{"id":"semetey-1-2013:p0803:b003:l023","ordinal":138392,"en":"Taking a broad view of the world."},{"id":"semetey-1-2013:p0803:b003:l024","ordinal":138393,"en":"“If this Kumaiyk I am raising"},{"id":"semetey-1-2013:p0803:b003:l025","ordinal":138394,"en":"Should happen to die,"},{"id":"semetey-1-2013:p0803:b003:l026","ordinal":138395,"en":"Should happen to be maimed,"},{"id":"semetey-1-2013:p0803:b003:l027","ordinal":138396,"en":"This whole Bukhara here—"},{"id":"semetey-1-2013:p0803:b003:l028","ordinal":138397,"en":"The leopard, in his wrath,"},{"id":"semetey-1-2013:p0803:b003:l029","ordinal":138398,"en":"Will lay it all waste,"},{"id":"semetey-1-2013:p0803:b003:l030","ordinal":138399,"en":"And thus destroy us utterly,” she said."},{"id":"semetey-1-2013:p0803:b003:l031","ordinal":138400,"en":"She tended and trained him well;"},{"id":"semetey-1-2013:p0803:b003:l032","ordinal":138401,"en":"That poor Kumaiyk"},{"id":"semetey-1-2013:p0803:b003:l033","ordinal":138402,"en":"She kept as her own child."},{"id":"semetey-1-2013:p0803:b003:l034","ordinal":138403,"en":"Reunited with Kanykei,"},{"id":"semetey-1-2013:p0803:b003:l035","ordinal":138404,"en":"When Kumaiyk stood weeping,"},{"id":"semetey-1-2013:p0803:b003:l036","ordinal":138405,"en":"The birch wept, the willow wept;"},{"id":"semetey-1-2013:p0803:b003:l037","ordinal":138406,"en":"Every soul watching wept."},{"id":"semetey-1-2013:p0803:b003:l038","ordinal":138407,"en":"The white-bearded old man wept;"},{"id":"semetey-1-2013:p0803:b003:l039","ordinal":138408,"en":"The people wept, the multitude wept."},{"id":"semetey-1-2013:p0803:b005:l001","ordinal":138409,"en":"All populous Bukhara wept;"},{"id":"semetey-1-2013:p0803:b005:l002","ordinal":138410,"en":"Those who held themselves great wept;"},{"id":"semetey-1-2013:p0803:b005:l003","ordinal":138411,"en":"Her father Temir Khan wept."},{"id":"semetey-1-2013:p0803:b005:l004","ordinal":138412,"en":"Ysmayyl of Bukhara,"},{"id":"semetey-1-2013:p0803:b005:l005","ordinal":138413,"en":"Temir Khan and Koloi Khan,"},{"id":"semetey-1-2013:p0803:b005:l006","ordinal":138414,"en":"With Shaatemir, those four,"},{"id":"semetey-1-2013:p0803:b005:l007","ordinal":138415,"en":"Had six matching gray mares"},{"id":"semetey-1-2013:p0803:b005:l008","ordinal":138416,"en":"Slaughtered in sacrifice,"},{"id":"semetey-1-2013:p0803:b005:l009","ordinal":138417,"en":"Quickly pledging an offering to Bahauddin."},{"id":"semetey-1-2013:p0803:b005:l010","ordinal":138418,"en":"All populous Bukhara sobbed,"},{"id":"semetey-1-2013:p0803:b005:l011","ordinal":138419,"en":"Crying out, “My orphan!”"},{"id":"semetey-1-2013:p0803:b005:l012","ordinal":138420,"en":"Had he not raised him?"},{"id":"semetey-1-2013:p0803:b005:l013","ordinal":138421,"en":"Ysmayyl wept on one side."},{"id":"semetey-1-2013:p0803:b005:l014","ordinal":138422,"en":"“My one and only morning star—"},{"id":"semetey-1-2013:p0803:b005:l015","ordinal":138423,"en":"Who knows his worth?"},{"id":"semetey-1-2013:p0803:b005:l016","ordinal":138424,"en":"If the boy goes about like this,"},{"id":"semetey-1-2013:p0803:b005:l017","ordinal":138425,"en":"Someone's evil eye will strike him,” he said."},{"id":"semetey-1-2013:p0803:b005:l018","ordinal":138426,"en":"Raised at the treasury's expense,"},{"id":"semetey-1-2013:p0803:b005:l019","ordinal":138427,"en":"Nine black bulls"},{"id":"semetey-1-2013:p0803:b005:l020","ordinal":138428,"en":"He had driven to him;"},{"id":"semetey-1-2013:p0803:b005:l021","ordinal":138429,"en":"As a votive offering, all of them"},{"id":"semetey-1-2013:p0803:b005:l022","ordinal":138430,"en":"He had beheaded."},{"id":"semetey-1-2013:p0803:b005:l023","ordinal":138431,"en":"The khoja in a motley robe,"},{"id":"semetey-1-2013:p0803:b005:l024","ordinal":138432,"en":"The mullah in a white turban,"},{"id":"semetey-1-2013:p0803:b005:l025","ordinal":138433,"en":"Those nine black bulls"},{"id":"semetey-1-2013:p0803:b005:l026","ordinal":138434,"en":"He had them cut apart."},{"id":"semetey-1-2013:p0803:b005:l027","ordinal":138435,"en":"Performing a rite for the boy,"},{"id":"semetey-1-2013:p0803:b005:l028","ordinal":138436,"en":"I will scatter him his share."},{"id":"semetey-1-2013:p0803:b005:l029","ordinal":138437,"en":"He had them slaughtered as an offering."},{"id":"semetey-1-2013:p0803:b005:l030","ordinal":138438,"en":"Leaving no rite unperformed,"},{"id":"semetey-1-2013:p0803:b005:l031","ordinal":138439,"en":"She consecrated with a rite"},{"id":"semetey-1-2013:p0803:b005:l032","ordinal":138440,"en":"Unwilling to accept their rites,"},{"id":"semetey-1-2013:p0803:b005:l033","ordinal":138441,"en":"Semetey, whom you have seen,"},{"id":"semetey-1-2013:p0803:b005:l034","ordinal":138442,"en":"Would not turn his heart toward Bukhara."},{"id":"semetey-1-2013:p0803:b005:l035","ordinal":138443,"en":"Truly created by God,"},{"id":"semetey-1-2013:p0803:b005:l036","ordinal":138444,"en":"Did you see that he was His servant?"},{"id":"semetey-1-2013:p0803:b005:l037","ordinal":138445,"en":"Poor Manas the warrior—"},{"id":"semetey-1-2013:p0803:b005:l038","ordinal":138446,"en":"Did you see that he was his son?"},{"id":"semetey-1-2013:p0803:b005:l039","ordinal":138447,"en":"Make your father slow,"},{"id":"semetey-1-2013:p0804:b003:l001","ordinal":138448,"en":"Had taken, have you seen?"},{"id":"semetey-1-2013:p0804:b003:l002","ordinal":138449,"en":"His father's son,"},{"id":"semetey-1-2013:p0804:b003:l003","ordinal":138450,"en":"As his descendant after him,"},{"id":"semetey-1-2013:p0804:b003:l004","ordinal":138451,"en":"Has remained—do you see?\""},{"id":"semetey-1-2013:p0804:b003:l005","ordinal":138452,"en":"Then the boy said:"},{"id":"semetey-1-2013:p0804:b003:l006","ordinal":138453,"en":"\"I have found a land like broad Talas."},{"id":"semetey-1-2013:p0804:b003:l007","ordinal":138454,"en":"I have found a people granted by fate."},{"id":"semetey-1-2013:p0804:b003:l008","ordinal":138455,"en":"I have found a people full of joy;"},{"id":"semetey-1-2013:p0804:b003:l009","ordinal":138456,"en":"I have found a land ordained by fortune."},{"id":"semetey-1-2013:p0804:b003:l010","ordinal":138457,"en":"Until I go to my people, my kinsfolk,"},{"id":"semetey-1-2013:p0804:b003:l011","ordinal":138458,"en":"I shall never turn aside."},{"id":"semetey-1-2013:p0804:b003:l012","ordinal":138459,"en":"Until I reach my people, I shall not rest.\""},{"id":"semetey-1-2013:p0804:b003:l013","ordinal":138460,"en":"Turning toward Kanykei,"},{"id":"semetey-1-2013:p0804:b003:l014","ordinal":138461,"en":"These were the words he spoke:"},{"id":"semetey-1-2013:p0804:b003:l015","ordinal":138462,"en":"\"Should a nobleman's only son"},{"id":"semetey-1-2013:p0804:b003:l016","ordinal":138463,"en":"Have cause to wander in exile?"},{"id":"semetey-1-2013:p0804:b003:l017","ordinal":138464,"en":"Unfortunate mother, where are my people?"},{"id":"semetey-1-2013:p0804:b003:l018","ordinal":138465,"en":"Should the son of a prince"},{"id":"semetey-1-2013:p0804:b003:l019","ordinal":138466,"en":"Have cause to flee?"},{"id":"semetey-1-2013:p0804:b003:l020","ordinal":138467,"en":"Wretched mother, where are my people?"},{"id":"semetey-1-2013:p0804:b003:l021","ordinal":138468,"en":"Fleeing from my people,"},{"id":"semetey-1-2013:p0804:b003:l022","ordinal":138469,"en":"You came and settled in Bukhara."},{"id":"semetey-1-2013:p0804:b003:l023","ordinal":138470,"en":"You had them call you a fugitive woman;"},{"id":"semetey-1-2013:p0804:b003:l024","ordinal":138471,"en":"You earned a bad name."},{"id":"semetey-1-2013:p0804:b003:l025","ordinal":138472,"en":"Acting with great folly,"},{"id":"semetey-1-2013:p0804:b003:l026","ordinal":138473,"en":"Wandering away from my people,"},{"id":"semetey-1-2013:p0804:b003:l027","ordinal":138474,"en":"You reached Bukhara and settled."},{"id":"semetey-1-2013:p0804:b003:l028","ordinal":138475,"en":"You had them call you a wayward woman;"},{"id":"semetey-1-2013:p0804:b003:l029","ordinal":138476,"en":"You earned a bad name."},{"id":"semetey-1-2013:p0804:b003:l030","ordinal":138477,"en":"Fleeing to your birth family,"},{"id":"semetey-1-2013:p0804:b003:l031","ordinal":138478,"en":"Shameless mother, you settled comfortably."},{"id":"semetey-1-2013:p0804:b003:l032","ordinal":138479,"en":"The offspring of a noble line"},{"id":"semetey-1-2013:p0804:b003:l033","ordinal":138480,"en":"You had them call a wandering orphan."},{"id":"semetey-1-2013:p0804:b003:l034","ordinal":138481,"en":"You gave me a bad name."},{"id":"semetey-1-2013:p0804:b003:l035","ordinal":138482,"en":"Coming to your birth family and thriving,"},{"id":"semetey-1-2013:p0804:b003:l036","ordinal":138483,"en":"You, a lord's wife, settled comfortably."},{"id":"semetey-1-2013:p0804:b003:l037","ordinal":138484,"en":"The son of a prince"},{"id":"semetey-1-2013:p0804:b003:l038","ordinal":138485,"en":"You had your younger brother Ysmayyl raise."},{"id":"semetey-1-2013:p0804:b003:l039","ordinal":138486,"en":"Such a spectacle you have made!"},{"id":"semetey-1-2013:p0804:b004:l001","ordinal":138487,"en":"When you fled here from Bukhara,"},{"id":"semetey-1-2013:p0804:b004:l002","ordinal":138488,"en":"When you scattered your wealth,"},{"id":"semetey-1-2013:p0804:b004:l003","ordinal":138489,"en":"Riding Taitoru as your mount,"},{"id":"semetey-1-2013:p0804:b004:l004","ordinal":138490,"en":"You brought me to Bukhara,"},{"id":"semetey-1-2013:p0804:b004:l005","ordinal":138491,"en":"Making me a stranger to my kin."},{"id":"semetey-1-2013:p0804:b004:l006","ordinal":138492,"en":"The descendant of a populous land—"},{"id":"semetey-1-2013:p0804:b004:l007","ordinal":138493,"en":"Why should I live exiled from my people?"},{"id":"semetey-1-2013:p0804:b004:l008","ordinal":138494,"en":"Now, Bukhara, farewell!"},{"id":"semetey-1-2013:p0804:b004:l009","ordinal":138495,"en":"Let me go toward my people."},{"id":"semetey-1-2013:p0804:b004:l010","ordinal":138496,"en":"I shall move away openly, people of Bukhara."}]
