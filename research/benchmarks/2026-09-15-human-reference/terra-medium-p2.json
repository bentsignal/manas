{
  "lines": [
    {"line": 1, "english": "Akbaltai gave his blessing.", "note": ""},
    {"line": 2, "english": "In the marshes of vast Altai,", "note": ""},
    {"line": 3, "english": "when the grieving Kyrgyz were dwelling there,", "note": ""},
    {"line": 4, "english": "the day delayed and the night passed,", "note": ""},
    {"line": 5, "english": "autumn reached its middle and summer passed,", "note": ""},
    {"line": 6, "english": "the season of plenty", "note": ""},
    {"line": 7, "english": "had come to fill three months' time.", "note": ""},
    {"line": 8, "english": "The old woman named Chyyrdy,", "note": ""},
    {"line": 9, "english": "the wife of Jakyp,", "note": ""},
    {"line": 10, "english": "had developed strange cravings.", "note": ""},
    {"line": 11, "english": "He slaughtered eighty mares from the herd,", "note": ""},
    {"line": 12, "english": "yet she did not have her fill, saying, 'It is meat.'", "note": ""},
    {"line": 13, "english": "that old woman Chyyrdy", "note": ""},
    {"line": 14, "english": "did not give up her cravings at all.", "note": ""},
    {"line": 15, "english": "A set of nine led by a camel,", "note": ""},
    {"line": 16, "english": "and then Jakyp slaughtered livestock,", "note": ""},
    {"line": 17, "english": "before the old woman", "note": ""},
    {"line": 18, "english": "he set the meat he had slaughtered as well.", "note": ""}
  ]
}
