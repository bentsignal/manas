[{"id":"semetey-1-2013:p1286:b003:l008","ordinal":174337,"en":"He took beautiful maidens as plunder."},{"id":"semetey-1-2013:p1286:b003:l009","ordinal":174338,"en":"His valor became known among the people;"},{"id":"semetey-1-2013:p1286:b003:l010","ordinal":174339,"en":"He was called bloodthirsty Manas"},{"id":"semetey-1-2013:p1286:b003:l011","ordinal":174340,"en":"And inscribed in the register"},{"id":"semetey-1-2013:p1286:b003:l012","ordinal":174341,"en":"Of Kakan-Chyn's Beijing."},{"id":"semetey-1-2013:p1286:b003:l013","ordinal":174342,"en":"Semetey, left as a gift"},{"id":"semetey-1-2013:p1286:b003:l014","ordinal":174343,"en":"By the valiant gray wolf Manas,"},{"id":"semetey-1-2013:p1286:b003:l015","ordinal":174344,"en":"Rode out facing battle"},{"id":"semetey-1-2013:p1286:b003:l016","ordinal":174345,"en":"And stood amid calamity."},{"id":"semetey-1-2013:p1286:b003:l017","ordinal":174346,"en":"His father had left him as a gift;"},{"id":"semetey-1-2013:p1286:b003:l018","ordinal":174347,"en":"Khan Akun was his father-in-law,"},{"id":"semetey-1-2013:p1286:b003:l019","ordinal":174348,"en":"And Aychürök the wife he would take."},{"id":"semetey-1-2013:p1286:b003:l020","ordinal":174349,"en":"The hero supported by the spirits—"},{"id":"semetey-1-2013:p1286:b003:l021","ordinal":174350,"en":"Saying they would seize his wife,"},{"id":"semetey-1-2013:p1286:b003:l022","ordinal":174351,"en":"The empty-heads whose doom had come,"},{"id":"semetey-1-2013:p1286:b003:l023","ordinal":174352,"en":"Chynkojo and Toltoy, had brought disgrace."},{"id":"semetey-1-2013:p1286:b003:l024","ordinal":174353,"en":"Argyn and Kyrgyz were kin;"},{"id":"semetey-1-2013:p1286:b003:l025","ordinal":174354,"en":"Chynkojo and Semetey"},{"id":"semetey-1-2013:p1286:b003:l026","ordinal":174355,"en":"Were born from equal branches."},{"id":"semetey-1-2013:p1286:b003:l027","ordinal":174356,"en":"He was fire sprung from the core;"},{"id":"semetey-1-2013:p1286:b003:l028","ordinal":174357,"en":"Khoja himself was doomed to die."},{"id":"semetey-1-2013:p1286:b003:l029","ordinal":174358,"en":"Of separate minds but sharing life,"},{"id":"semetey-1-2013:p1286:b003:l030","ordinal":174359,"en":"With the foolish dog Khoja,"},{"id":"semetey-1-2013:p1286:b003:l031","ordinal":174360,"en":"They tended their mingled livestock together."},{"id":"semetey-1-2013:p1286:b003:l032","ordinal":174361,"en":"Their battle cry and encouragement were one;"},{"id":"semetey-1-2013:p1286:b003:l033","ordinal":174362,"en":"Were it not for his foolishness,"},{"id":"semetey-1-2013:p1286:b003:l034","ordinal":174363,"en":"Their wishes and sacrificial rites were one."},{"id":"semetey-1-2013:p1286:b003:l035","ordinal":174364,"en":"They gathered the treasury together,"},{"id":"semetey-1-2013:p1286:b003:l036","ordinal":174365,"en":"Children of one father,"},{"id":"semetey-1-2013:p1286:b003:l037","ordinal":174366,"en":"Seeds of one grain,"},{"id":"semetey-1-2013:p1286:b003:l038","ordinal":174367,"en":"Descendants of one man."},{"id":"semetey-1-2013:p1286:b003:l039","ordinal":174368,"en":"His own kinsman became his enemy;"},{"id":"semetey-1-2013:p1286:b004:l001","ordinal":174369,"en":"Within hero Semetey"},{"id":"semetey-1-2013:p1286:b004:l002","ordinal":174370,"en":"Walked a hostile foe."},{"id":"semetey-1-2013:p1286:b004:l003","ordinal":174371,"en":"The mount beneath him"},{"id":"semetey-1-2013:p1286:b004:l004","ordinal":174372,"en":"Was a charger fit for six months' riding;"},{"id":"semetey-1-2013:p1286:b004:l005","ordinal":174373,"en":"The hero he would fight"},{"id":"semetey-1-2013:p1286:b004:l006","ordinal":174374,"en":"Was his foolish kinsman Khoja,"},{"id":"semetey-1-2013:p1286:b004:l007","ordinal":174375,"en":"Who had escaped from the village."},{"id":"semetey-1-2013:p1286:b004:l008","ordinal":174376,"en":"A mighty tumult beyond a spear's reach—"},{"id":"semetey-1-2013:p1286:b004:l009","ordinal":174377,"en":"That was Chynkojo's doing."},{"id":"semetey-1-2013:p1286:b004:l010","ordinal":174378,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1286:b004:l011","ordinal":174379,"en":"The khoja whose deeds were bold."},{"id":"semetey-1-2013:p1286:b004:l012","ordinal":174380,"en":"Khoja's fortune was complete;"},{"id":"semetey-1-2013:p1286:b004:l013","ordinal":174381,"en":"Were it not for his devilry,"},{"id":"semetey-1-2013:p1286:b004:l014","ordinal":174382,"en":"He was a hero supported by the spirits."},{"id":"semetey-1-2013:p1286:b004:l015","ordinal":174383,"en":"He had a black hat large as a cauldron;"},{"id":"semetey-1-2013:p1286:b004:l016","ordinal":174384,"en":"Dear Khoja was a mighty one."},{"id":"semetey-1-2013:p1286:b004:l017","ordinal":174385,"en":"Across the whole world,"},{"id":"semetey-1-2013:p1286:b004:l018","ordinal":174386,"en":"Whatever he wished, he had power to do."},{"id":"semetey-1-2013:p1286:b004:l019","ordinal":174387,"en":"His courage was precious, his venom strong;"},{"id":"semetey-1-2013:p1286:b004:l020","ordinal":174388,"en":"Lion Khoja was a mighty one."},{"id":"semetey-1-2013:p1286:b004:l021","ordinal":174389,"en":"Beneath him he had thoroughbred stock;"},{"id":"semetey-1-2013:p1286:b004:l022","ordinal":174390,"en":"Across the whole world,"},{"id":"semetey-1-2013:p1286:b004:l023","ordinal":174391,"en":"Dear lion Khoja"},{"id":"semetey-1-2013:p1286:b004:l024","ordinal":174392,"en":"Had strength to strike it down like grain."},{"id":"semetey-1-2013:p1286:b004:l025","ordinal":174393,"en":"Had he not traveled with Manas"},{"id":"semetey-1-2013:p1286:b004:l026","ordinal":174394,"en":"And grown beside him?"},{"id":"semetey-1-2013:p1286:b004:l027","ordinal":174395,"en":"Had he not seen"},{"id":"semetey-1-2013:p1286:b004:l028","ordinal":174396,"en":"Calamitous great tumults?"},{"id":"semetey-1-2013:p1286:b004:l029","ordinal":174397,"en":"Was he not wise among spearmen,"},{"id":"semetey-1-2013:p1286:b004:l030","ordinal":174398,"en":"A resourceful khoja?"},{"id":"semetey-1-2013:p1286:b004:l031","ordinal":174399,"en":"Did he not know the enemy's stratagems well,"},{"id":"semetey-1-2013:p1286:b004:l032","ordinal":174400,"en":"A mighty khoja?"},{"id":"semetey-1-2013:p1286:b004:l033","ordinal":174401,"en":"In his youth, among good men,"},{"id":"semetey-1-2013:p1286:b004:l034","ordinal":174402,"en":"Had Khoja not grown?"},{"id":"semetey-1-2013:p1286:b004:l035","ordinal":174403,"en":"From lion, gray wolf Manas,"},{"id":"semetey-1-2013:p1286:b004:l036","ordinal":174404,"en":"Receiving so much instruction,"},{"id":"semetey-1-2013:p1286:b004:l037","ordinal":174405,"en":"Had Khoja not become seasoned?"},{"id":"semetey-1-2013:p1286:b004:l038","ordinal":174406,"en":"Armor no bullet could pierce—"},{"id":"semetey-1-2013:p1286:b004:l039","ordinal":174407,"en":"Had Khoja not worn it beneath his clothes?"},{"id":"semetey-1-2013:p1287:b003:l001","ordinal":174408,"en":"Having fought in many battles,"},{"id":"semetey-1-2013:p1287:b003:l002","ordinal":174409,"en":"Was Kojo not one who knew"},{"id":"semetey-1-2013:p1287:b003:l003","ordinal":174410,"en":"How to unleash upheaval?"},{"id":"semetey-1-2013:p1287:b003:l004","ordinal":174411,"en":"Yesterday, when your bloodthirsty lion Manas"},{"id":"semetey-1-2013:p1287:b003:l005","ordinal":174412,"en":"Brought turmoil upon Beijing of Chin-Machin"},{"id":"semetey-1-2013:p1287:b003:l006","ordinal":174413,"en":"And the people of the true Kakan,"},{"id":"semetey-1-2013:p1287:b003:l007","ordinal":174414,"en":"When he seized the khanate"},{"id":"semetey-1-2013:p1287:b003:l008","ordinal":174415,"en":"Of the swarming Chinese,"},{"id":"semetey-1-2013:p1287:b003:l009","ordinal":174416,"en":"When he imposed tribute upon China"},{"id":"semetey-1-2013:p1287:b003:l010","ordinal":174417,"en":"And raided its city,"},{"id":"semetey-1-2013:p1287:b003:l011","ordinal":174418,"en":"Was Kojo not the one who besieged"},{"id":"semetey-1-2013:p1287:b003:l012","ordinal":174419,"en":"Its cities looming in might?"},{"id":"semetey-1-2013:p1287:b003:l013","ordinal":174420,"en":"Was Kojo not the one"},{"id":"semetey-1-2013:p1287:b003:l014","ordinal":174421,"en":"Who made their khans stand rigid"},{"id":"semetey-1-2013:p1287:b003:l015","ordinal":174422,"en":"And beat them down?"},{"id":"semetey-1-2013:p1287:b003:l016","ordinal":174423,"en":"Was Kojo not the one"},{"id":"semetey-1-2013:p1287:b003:l017","ordinal":174424,"en":"Who unleashed relentless turmoil?"},{"id":"semetey-1-2013:p1287:b003:l018","ordinal":174425,"en":"At the gate of walled Beijing,"},{"id":"semetey-1-2013:p1287:b003:l019","ordinal":174426,"en":"From the hero called Kangur,"},{"id":"semetey-1-2013:p1287:b003:l020","ordinal":174427,"en":"From sixty sorcerer-warriors"},{"id":"semetey-1-2013:p1287:b003:l021","ordinal":174428,"en":"Learned in wondrous arts,"},{"id":"semetey-1-2013:p1287:b003:l022","ordinal":174429,"en":"Was Kojo not the one who saddled"},{"id":"semetey-1-2013:p1287:b003:l023","ordinal":174430,"en":"The accomplished swift Kara At?"},{"id":"semetey-1-2013:p1287:b003:l024","ordinal":174431,"en":"Was Kojo not the one who remained seven months"},{"id":"semetey-1-2013:p1287:b003:l025","ordinal":174432,"en":"And studied sorcery?"},{"id":"semetey-1-2013:p1287:b003:l026","ordinal":174433,"en":"Was Kojo not the one who wore"},{"id":"semetey-1-2013:p1287:b003:l027","ordinal":174434,"en":"A coat woven with spells?"},{"id":"semetey-1-2013:p1287:b003:l028","ordinal":174435,"en":"Was Kojo not the one who knew"},{"id":"semetey-1-2013:p1287:b003:l029","ordinal":174436,"en":"The Chinese people's mighty war-prayers?"},{"id":"semetey-1-2013:p1287:b003:l030","ordinal":174437,"en":"At the name of your uncle Kojo today,"},{"id":"semetey-1-2013:p1287:b003:l031","ordinal":174438,"en":"People started in fear;"},{"id":"semetey-1-2013:p1287:b003:l032","ordinal":174439,"en":"He had read forty-two forms"},{"id":"semetey-1-2013:p1287:b003:l033","ordinal":174440,"en":"Of the Chinese script."},{"id":"semetey-1-2013:p1287:b003:l034","ordinal":174441,"en":"Was Kojo not the one who went"},{"id":"semetey-1-2013:p1287:b003:l035","ordinal":174442,"en":"To Kakanchin's war?"},{"id":"semetey-1-2013:p1287:b003:l036","ordinal":174443,"en":"Was Kojo not there"},{"id":"semetey-1-2013:p1287:b003:l037","ordinal":174444,"en":"In the seething, terrible slaughter?"},{"id":"semetey-1-2013:p1287:b003:l038","ordinal":174445,"en":"Was Kojo not the one who learned"},{"id":"semetey-1-2013:p1287:b003:l039","ordinal":174446,"en":"The ways of war?"},{"id":"semetey-1-2013:p1287:b004:l001","ordinal":174447,"en":"When the great Chinese and Manchu people,"},{"id":"semetey-1-2013:p1287:b004:l002","ordinal":174448,"en":"Swift on foot before their khan,"},{"id":"semetey-1-2013:p1287:b004:l003","ordinal":174449,"en":"Engulfed them and reached them together,"},{"id":"semetey-1-2013:p1287:b004:l004","ordinal":174450,"en":"When the heroes' shots went astray,"},{"id":"semetey-1-2013:p1287:b004:l005","ordinal":174451,"en":"When, at Beijing's fortress,"},{"id":"semetey-1-2013:p1287:b004:l006","ordinal":174452,"en":"Chubak, son of Akbaltai,"},{"id":"semetey-1-2013:p1287:b004:l007","ordinal":174453,"en":"Was struck by a stray bullet"},{"id":"semetey-1-2013:p1287:b004:l008","ordinal":174454,"en":"And vanished from sight,"},{"id":"semetey-1-2013:p1287:b004:l009","ordinal":174455,"en":"When young Kojo grew wrathful"},{"id":"semetey-1-2013:p1287:b004:l010","ordinal":174456,"en":"And spilled Muslim blood,"},{"id":"semetey-1-2013:p1287:b004:l011","ordinal":174457,"en":"When all sense left"},{"id":"semetey-1-2013:p1287:b004:l012","ordinal":174458,"en":"The Muslims' heads"},{"id":"semetey-1-2013:p1287:b004:l013","ordinal":174459,"en":"And black fog covered them,"},{"id":"semetey-1-2013:p1287:b004:l014","ordinal":174460,"en":"When the greatest of the sixty,"},{"id":"semetey-1-2013:p1287:b004:l015","ordinal":174461,"en":"The finest of the Forty Companions,"},{"id":"semetey-1-2013:p1287:b004:l016","ordinal":174462,"en":"Syrgak, lay dying,"},{"id":"semetey-1-2013:p1287:b004:l017","ordinal":174463,"en":"When young Kojo grew wrathful,"},{"id":"semetey-1-2013:p1287:b004:l018","ordinal":174464,"en":"When Akkula fell to a bullet,"},{"id":"semetey-1-2013:p1287:b004:l019","ordinal":174465,"en":"When Almambet was martyred,"},{"id":"semetey-1-2013:p1287:b004:l020","ordinal":174466,"en":"Was Kojo not the one who went"},{"id":"semetey-1-2013:p1287:b004:l021","ordinal":174467,"en":"To his uncle Almambet's side?"},{"id":"semetey-1-2013:p1287:b004:l022","ordinal":174468,"en":"Was Kojo not the one who took"},{"id":"semetey-1-2013:p1287:b004:l023","ordinal":174469,"en":"The weather-stone that conjures weather,"},{"id":"semetey-1-2013:p1287:b004:l024","ordinal":174470,"en":"Thinking it might one day prove useful?"},{"id":"semetey-1-2013:p1287:b004:l025","ordinal":174471,"en":"Was Kojo not a champion"},{"id":"semetey-1-2013:p1287:b004:l026","ordinal":174472,"en":"Of fighting by stratagem?"},{"id":"semetey-1-2013:p1287:b004:l027","ordinal":174473,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1287:b004:l028","ordinal":174474,"en":"Was taut as red-hot iron;"},{"id":"semetey-1-2013:p1287:b004:l029","ordinal":174475,"en":"When you looked upon his frame,"},{"id":"semetey-1-2013:p1287:b004:l030","ordinal":174476,"en":"He resembled a spur of Kara-Too."},{"id":"semetey-1-2013:p1287:b004:l031","ordinal":174477,"en":"Do not ask what Kojo was like:"},{"id":"semetey-1-2013:p1287:b004:l032","ordinal":174478,"en":"Thick-armed and stone-hearted,"},{"id":"semetey-1-2013:p1287:b004:l033","ordinal":174479,"en":"A giant as large as a mountain,"},{"id":"semetey-1-2013:p1287:b004:l034","ordinal":174480,"en":"With a sable cap upon his head,"},{"id":"semetey-1-2013:p1287:b004:l035","ordinal":174481,"en":"In this false world"},{"id":"semetey-1-2013:p1287:b004:l036","ordinal":174482,"en":"A singular black-gray wolf."},{"id":"semetey-1-2013:p1287:b004:l037","ordinal":174483,"en":"He had the flying Kara At;"},{"id":"semetey-1-2013:p1287:b004:l038","ordinal":174484,"en":"All who challenged him,"},{"id":"semetey-1-2013:p1287:b004:l039","ordinal":174485,"en":"When wrath seized Chynkojo,"},{"id":"semetey-1-2013:p1288:b003:l001","ordinal":174486,"en":"Had the strength to crush them like flour."},{"id":"semetey-1-2013:p1288:b003:l002","ordinal":174487,"en":"His courage was fierce and his venom strong;"},{"id":"semetey-1-2013:p1288:b003:l003","ordinal":174488,"en":"Abandon hope before Chynkojo,"},{"id":"semetey-1-2013:p1288:b003:l004","ordinal":174489,"en":"Whom the spirits had forgotten!"},{"id":"semetey-1-2013:p1288:b003:l005","ordinal":174490,"en":"Let us leave that thus"},{"id":"semetey-1-2013:p1288:b003:l006","ordinal":174491,"en":"And begin with Chynkojo:"},{"id":"semetey-1-2013:p1288:b003:l007","ordinal":174492,"en":"Dear Kojo, renowned lord,"},{"id":"semetey-1-2013:p1288:b003:l008","ordinal":174493,"en":"Had, when he wished, such great worth;"},{"id":"semetey-1-2013:p1288:b003:l009","ordinal":174494,"en":"By custom he drank the blood"},{"id":"semetey-1-2013:p1288:b003:l010","ordinal":174495,"en":"Of whoever came to challenge him."},{"id":"semetey-1-2013:p1288:b003:l011","ordinal":174496,"en":"Saying, \"I shall slaughter Manas's son,"},{"id":"semetey-1-2013:p1288:b003:l012","ordinal":174497,"en":"And bring slaughter"},{"id":"semetey-1-2013:p1288:b003:l013","ordinal":174498,"en":"Upon the accursed fugitive,\""},{"id":"semetey-1-2013:p1288:b003:l014","ordinal":174499,"en":"He grew black with rage;"},{"id":"semetey-1-2013:p1288:b003:l015","ordinal":174500,"en":"Thus remained that renowned lord."},{"id":"semetey-1-2013:p1288:b003:l016","ordinal":174501,"en":"His saddlecloth was leather;"},{"id":"semetey-1-2013:p1288:b003:l017","ordinal":174502,"en":"No mortal could withstand"},{"id":"semetey-1-2013:p1288:b003:l018","ordinal":174503,"en":"This Kojo's courage."},{"id":"semetey-1-2013:p1288:b003:l019","ordinal":174504,"en":"Look at the flood coursing from the slope;"},{"id":"semetey-1-2013:p1288:b003:l020","ordinal":174505,"en":"Look at hero Kojo, like a flood."},{"id":"semetey-1-2013:p1288:b003:l021","ordinal":174506,"en":"Look at the water flowing with a roar;"},{"id":"semetey-1-2013:p1288:b003:l022","ordinal":174507,"en":"Look at the uproar Chynkojo caused."},{"id":"semetey-1-2013:p1288:b003:l023","ordinal":174508,"en":"Look at the dark-sworded conflagration;"},{"id":"semetey-1-2013:p1288:b003:l024","ordinal":174509,"en":"Look at the fire Chynkojo kindled."},{"id":"semetey-1-2013:p1288:b003:l025","ordinal":174510,"en":"Look at the black trench that was dug;"},{"id":"semetey-1-2013:p1288:b003:l026","ordinal":174511,"en":"Look at the suffering"},{"id":"semetey-1-2013:p1288:b003:l027","ordinal":174512,"en":"Dear Kojo the leopard brought engulfing them."},{"id":"semetey-1-2013:p1288:b003:l028","ordinal":174513,"en":"Was Kojo not one born"},{"id":"semetey-1-2013:p1288:b003:l029","ordinal":174514,"en":"And come into this world?"},{"id":"semetey-1-2013:p1288:b003:l030","ordinal":174515,"en":"Was Kojo not one who punished"},{"id":"semetey-1-2013:p1288:b003:l031","ordinal":174516,"en":"Whoever challenged him?"},{"id":"semetey-1-2013:p1288:b003:l032","ordinal":174517,"en":"At a spur of the lower mountain,"},{"id":"semetey-1-2013:p1288:b003:l033","ordinal":174518,"en":"At a jutting, narrowing promontory,"},{"id":"semetey-1-2013:p1288:b003:l034","ordinal":174519,"en":"What did dear Kojo do?"},{"id":"semetey-1-2013:p1288:b003:l035","ordinal":174520,"en":"He unleashed an upheaval"},{"id":"semetey-1-2013:p1288:b003:l036","ordinal":174521,"en":"And drove the fleeing mass of Zhediger"},{"id":"semetey-1-2013:p1288:b003:l037","ordinal":174522,"en":"Before him under the whip:"},{"id":"semetey-1-2013:p1288:b003:l038","ordinal":174523,"en":"\"Damn your fathers, Zhediger;"},{"id":"semetey-1-2013:p1288:b003:l039","ordinal":174524,"en":"If you flee, you have eaten filth!"},{"id":"semetey-1-2013:p1288:b004:l001","ordinal":174525,"en":"Is Zheti-Özön such a feeble land?"},{"id":"semetey-1-2013:p1288:b004:l002","ordinal":174526,"en":"Is Semetey a greater hero than I?"},{"id":"semetey-1-2013:p1288:b004:l003","ordinal":174527,"en":"Not one of you bore a banner;"},{"id":"semetey-1-2013:p1288:b004:l004","ordinal":174528,"en":"You have fled straight away,"},{"id":"semetey-1-2013:p1288:b004:l005","ordinal":174529,"en":"Not remembering that your falcon Kojo lives;"},{"id":"semetey-1-2013:p1288:b004:l006","ordinal":174530,"en":"Unable to stand, you have run."},{"id":"semetey-1-2013:p1288:b004:l007","ordinal":174531,"en":"Zhediger of Zheti-Suu,"},{"id":"semetey-1-2013:p1288:b004:l008","ordinal":174532,"en":"While this accomplished head remains,"},{"id":"semetey-1-2013:p1288:b004:l009","ordinal":174533,"en":"I shall catch and gather you."},{"id":"semetey-1-2013:p1288:b004:l010","ordinal":174534,"en":"I shall slaughter you all,"},{"id":"semetey-1-2013:p1288:b004:l011","ordinal":174535,"en":"And then find Semetey."},{"id":"semetey-1-2013:p1288:b004:l012","ordinal":174536,"en":"Do you not see, Zhediger,"},{"id":"semetey-1-2013:p1288:b004:l013","ordinal":174537,"en":"The heroism I have shown?"},{"id":"semetey-1-2013:p1288:b004:l014","ordinal":174538,"en":"Will you not share, Zhediger,"},{"id":"semetey-1-2013:p1288:b004:l015","ordinal":174539,"en":"The gain I have won?"},{"id":"semetey-1-2013:p1288:b004:l016","ordinal":174540,"en":"My heroism is of another order;"},{"id":"semetey-1-2013:p1288:b004:l017","ordinal":174541,"en":"My wrestling strength beyond measure!"},{"id":"semetey-1-2013:p1288:b004:l018","ordinal":174542,"en":"There is no division at Kara-Suu;"},{"id":"semetey-1-2013:p1288:b004:l019","ordinal":174543,"en":"Babbling Zhediger,"},{"id":"semetey-1-2013:p1288:b004:l020","ordinal":174544,"en":"While this dear head remains,"},{"id":"semetey-1-2013:p1288:b004:l021","ordinal":174545,"en":"There is no death for you at all!"},{"id":"semetey-1-2013:p1288:b004:l022","ordinal":174546,"en":"Do not flee, Zhediger;"},{"id":"semetey-1-2013:p1288:b004:l023","ordinal":174547,"en":"There is no one who can resist!"},{"id":"semetey-1-2013:p1288:b004:l024","ordinal":174548,"en":"Damn your fathers, Zhediger;"},{"id":"semetey-1-2013:p1288:b004:l025","ordinal":174549,"en":"You have white-bearded elders"},{"id":"semetey-1-2013:p1288:b004:l026","ordinal":174550,"en":"And all your resourceful old men."},{"id":"semetey-1-2013:p1288:b004:l027","ordinal":174551,"en":"In alarm before Manas's wretched son,"},{"id":"semetey-1-2013:p1288:b004:l028","ordinal":174552,"en":"You have taken fright;"},{"id":"semetey-1-2013:p1288:b004:l029","ordinal":174553,"en":"Great Black Zhediger,"},{"id":"semetey-1-2013:p1288:b004:l030","ordinal":174554,"en":"All of you in panic"},{"id":"semetey-1-2013:p1288:b004:l031","ordinal":174555,"en":"Have fled away."},{"id":"semetey-1-2013:p1288:b004:l032","ordinal":174556,"en":"If you flee, Zhediger,"},{"id":"semetey-1-2013:p1288:b004:l033","ordinal":174557,"en":"I shall unleash an upheaval;"},{"id":"semetey-1-2013:p1288:b004:l034","ordinal":174558,"en":"If my black fury seizes me,"},{"id":"semetey-1-2013:p1288:b004:l035","ordinal":174559,"en":"I shall seize every one of you"},{"id":"semetey-1-2013:p1288:b004:l036","ordinal":174560,"en":"And turn you into black earth!"},{"id":"semetey-1-2013:p1288:b004:l037","ordinal":174561,"en":"Would men who have seen an enemy"},{"id":"semetey-1-2013:p1288:b004:l038","ordinal":174562,"en":"Panic and lose their wits?"},{"id":"semetey-1-2013:p1288:b004:l039","ordinal":174563,"en":"Accursed Zhediger,"},{"id":"semetey-1-2013:p1289:b003:l001","ordinal":174564,"en":"Would a people with a prince flee?"},{"id":"semetey-1-2013:p1289:b003:l002","ordinal":174565,"en":"You old men in white turbans,"},{"id":"semetey-1-2013:p1289:b003:l003","ordinal":174566,"en":"All of you have fled;"},{"id":"semetey-1-2013:p1289:b003:l004","ordinal":174567,"en":"You resourceful old men,"},{"id":"semetey-1-2013:p1289:b003:l005","ordinal":174568,"en":"All of you have fled!\""},{"id":"semetey-1-2013:p1289:b003:l006","ordinal":174569,"en":"It was the time when Chynkojo"},{"id":"semetey-1-2013:p1289:b003:l007","ordinal":174570,"en":"Surrounded the great Black Zhediger"},{"id":"semetey-1-2013:p1289:b003:l008","ordinal":174571,"en":"And drove them before him."},{"id":"semetey-1-2013:p1289:b003:l009","ordinal":174572,"en":"Whoever resisted,"},{"id":"semetey-1-2013:p1289:b003:l010","ordinal":174573,"en":"He threw belly-down across a horse"},{"id":"semetey-1-2013:p1289:b003:l011","ordinal":174574,"en":"And bound fast."},{"id":"semetey-1-2013:p1289:b003:l012","ordinal":174575,"en":"He inflicted every kind of wrath;"},{"id":"semetey-1-2013:p1289:b003:l013","ordinal":174576,"en":"Chynkojo drove away the Zhediger,"},{"id":"semetey-1-2013:p1289:b003:l014","ordinal":174577,"en":"Leaving not one behind."},{"id":"semetey-1-2013:p1289:b003:l015","ordinal":174578,"en":"Those fated to die perished;"},{"id":"semetey-1-2013:p1289:b003:l016","ordinal":174579,"en":"Those who survived Kojo, son of Shygai,"},{"id":"semetey-1-2013:p1289:b003:l017","ordinal":174580,"en":"After the deaths,"},{"id":"semetey-1-2013:p1289:b003:l018","ordinal":174581,"en":"Suffered utter humiliation."},{"id":"semetey-1-2013:p1289:b003:l019","ordinal":174582,"en":"Roaring in his fury,"},{"id":"semetey-1-2013:p1289:b003:l020","ordinal":174583,"en":"What did dear Kojo do?"},{"id":"semetey-1-2013:p1289:b003:l021","ordinal":174584,"en":"He began an upheaval."},{"id":"semetey-1-2013:p1289:b003:l022","ordinal":174585,"en":"Unable to withstand his wrath,"},{"id":"semetey-1-2013:p1289:b003:l023","ordinal":174586,"en":"The great Black Zhediger"},{"id":"semetey-1-2013:p1289:b003:l024","ordinal":174587,"en":"Were slaughtered and cast down."},{"id":"semetey-1-2013:p1289:b003:l025","ordinal":174588,"en":"He heaped humiliation upon them like sheep;"},{"id":"semetey-1-2013:p1289:b003:l026","ordinal":174589,"en":"What did dear Kojo do?"},{"id":"semetey-1-2013:p1289:b003:l027","ordinal":174590,"en":"He drove away"},{"id":"semetey-1-2013:p1289:b003:l028","ordinal":174591,"en":"Every one of the Zhediger."},{"id":"semetey-1-2013:p1289:b003:l029","ordinal":174592,"en":"Unable to find any recourse,"}]
