[{"id":"semetey-1-2013:p0861:b003:l022","ordinal":142081,"en":"I will avenge my undying grudge,”"},{"id":"semetey-1-2013:p0861:b003:l023","ordinal":142082,"en":"Had joined the gathering."},{"id":"semetey-1-2013:p0861:b003:l024","ordinal":142083,"en":"He who ruled Alty-Shaar,"},{"id":"semetey-1-2013:p0861:b003:l025","ordinal":142084,"en":"Manas's enemy from of old,"},{"id":"semetey-1-2013:p0861:b003:l026","ordinal":142085,"en":"Alabek, khan of the nomads—"},{"id":"semetey-1-2013:p0861:b003:l027","ordinal":142086,"en":"They had brought his army."},{"id":"semetey-1-2013:p0861:b003:l028","ordinal":142087,"en":"They camped along Urbus,"},{"id":"semetey-1-2013:p0861:b003:l029","ordinal":142088,"en":"Raising gray-mottled pennons and banners,"},{"id":"semetey-1-2013:p0861:b003:l030","ordinal":142089,"en":"They filled the place like ants."},{"id":"semetey-1-2013:p0861:b003:l031","ordinal":142090,"en":"All their khans,"},{"id":"semetey-1-2013:p0861:b003:l032","ordinal":142091,"en":"Their elders who ruled the people,"},{"id":"semetey-1-2013:p0861:b003:l033","ordinal":142092,"en":"Their religious elder in a mottled robe,"},{"id":"semetey-1-2013:p0861:b003:l034","ordinal":142093,"en":"Their mullah who studied lessons,"},{"id":"semetey-1-2013:p0861:b003:l035","ordinal":142094,"en":"Abyke and Kobosh's royal camp—"},{"id":"semetey-1-2013:p0861:b003:l036","ordinal":142095,"en":"Stirred up in their royal camp,"},{"id":"semetey-1-2013:p0861:b003:l037","ordinal":142096,"en":"All of them gathered together,"},{"id":"semetey-1-2013:p0861:b003:l038","ordinal":142097,"en":"Swearing an oath unto death,"},{"id":"semetey-1-2013:p0861:b003:l039","ordinal":142098,"en":"Making their promise firm,"},{"id":"semetey-1-2013:p0861:b004:l001","ordinal":142099,"en":"Manas's only orphan—"},{"id":"semetey-1-2013:p0861:b004:l002","ordinal":142100,"en":"To gather and seize him,"},{"id":"semetey-1-2013:p0861:b004:l003","ordinal":142101,"en":"To offer him as a sacrifice,"},{"id":"semetey-1-2013:p0861:b004:l004","ordinal":142102,"en":"To put him to death,"},{"id":"semetey-1-2013:p0861:b004:l005","ordinal":142103,"en":"To kill him and cut off his life,"},{"id":"semetey-1-2013:p0861:b004:l006","ordinal":142104,"en":"To make him like an extinguished fire—"},{"id":"semetey-1-2013:p0861:b004:l007","ordinal":142105,"en":"All the khans who had come,"},{"id":"semetey-1-2013:p0861:b004:l008","ordinal":142106,"en":"Their elders rich in wisdom,"},{"id":"semetey-1-2013:p0861:b004:l009","ordinal":142107,"en":"Made their promise firm,"},{"id":"semetey-1-2013:p0861:b004:l010","ordinal":142108,"en":"Swore an oath unto death,"},{"id":"semetey-1-2013:p0861:b004:l011","ordinal":142109,"en":"Chewed white wheat flour together,"},{"id":"semetey-1-2013:p0861:b004:l012","ordinal":142110,"en":"Swore to one another on the Quran,"},{"id":"semetey-1-2013:p0861:b004:l013","ordinal":142111,"en":"Slaughtered a white-gray mare,"},{"id":"semetey-1-2013:p0861:b004:l014","ordinal":142112,"en":"A holy Quran the size of a horse's head"},{"id":"semetey-1-2013:p0861:b004:l015","ordinal":142113,"en":"They placed against their chests."},{"id":"semetey-1-2013:p0861:b004:l016","ordinal":142114,"en":"Manas's orphan son—"},{"id":"semetey-1-2013:p0861:b004:l017","ordinal":142115,"en":"Whoever would not seize and slaughter him,"},{"id":"semetey-1-2013:p0861:b004:l018","ordinal":142116,"en":"They called a hero only in fine words,"},{"id":"semetey-1-2013:p0861:b004:l019","ordinal":142117,"en":"Called his seven forefathers unbelievers."},{"id":"semetey-1-2013:p0861:b004:l020","ordinal":142118,"en":"Muttering and roaring,"},{"id":"semetey-1-2013:p0861:b004:l021","ordinal":142119,"en":"From their tumult"},{"id":"semetey-1-2013:p0861:b004:l022","ordinal":142120,"en":"The earth split and rumbled."},{"id":"semetey-1-2013:p0861:b004:l023","ordinal":142121,"en":"And beside Kobosh,"},{"id":"semetey-1-2013:p0861:b004:l024","ordinal":142122,"en":"All forty companions,"},{"id":"semetey-1-2013:p0861:b004:l025","ordinal":142123,"en":"Their elders led by Kyrgyl,"},{"id":"semetey-1-2013:p0861:b004:l026","ordinal":142124,"en":"The skilled among the lancers,"},{"id":"semetey-1-2013:p0861:b004:l027","ordinal":142125,"en":"The finest, rich in wisdom,"},{"id":"semetey-1-2013:p0861:b004:l028","ordinal":142126,"en":"Their lions with elephant-like limbs,"},{"id":"semetey-1-2013:p0861:b004:l029","ordinal":142127,"en":"Their unsparing heroes,"},{"id":"semetey-1-2013:p0861:b004:l030","ordinal":142128,"en":"Those who would not recoil from stone,"},{"id":"semetey-1-2013:p0861:b004:l031","ordinal":142129,"en":"Those who would not turn back at death,"},{"id":"semetey-1-2013:p0861:b004:l032","ordinal":142130,"en":"Their broad-chested warriors,"},{"id":"semetey-1-2013:p0861:b004:l033","ordinal":142131,"en":"Their stately champions—"},{"id":"semetey-1-2013:p0861:b004:l034","ordinal":142132,"en":"Into the midst of that seething army"},{"id":"semetey-1-2013:p0861:b004:l035","ordinal":142133,"en":"Khan Sary Khan came."},{"id":"semetey-1-2013:p0861:b004:l036","ordinal":142134,"en":"Khan Manas's companion,"},{"id":"semetey-1-2013:p0861:b004:l037","ordinal":142135,"en":"The leopard Shuutu—what did he do?"},{"id":"semetey-1-2013:p0861:b004:l038","ordinal":142136,"en":"He said this to Sary Khan:"},{"id":"semetey-1-2013:p0861:b004:l039","ordinal":142137,"en":"“The command Allah has laid upon us—"},{"id":"semetey-1-2013:p0862:b003:l001","ordinal":142138,"en":"You have come to see it,"},{"id":"semetey-1-2013:p0862:b003:l002","ordinal":142139,"en":"Before your appointed death, at their hands"},{"id":"semetey-1-2013:p0862:b003:l003","ordinal":142140,"en":"You have come to die!"},{"id":"semetey-1-2013:p0862:b003:l004","ordinal":142141,"en":"More formidable have grown these dogs'"},{"id":"semetey-1-2013:p0862:b003:l005","ordinal":142142,"en":"Trenches they have dug;"},{"id":"semetey-1-2013:p0862:b003:l006","ordinal":142143,"en":"Do you see them making ready,"},{"id":"semetey-1-2013:p0862:b003:l007","ordinal":142144,"en":"Their armies that will sweep over us?"},{"id":"semetey-1-2013:p0862:b003:l008","ordinal":142145,"en":"For an elder like Baimyrza"},{"id":"semetey-1-2013:p0862:b003:l009","ordinal":142146,"en":"They will not go and render service;"},{"id":"semetey-1-2013:p0862:b003:l010","ordinal":142147,"en":"To Manas's orphan son"},{"id":"semetey-1-2013:p0862:b003:l011","ordinal":142148,"en":"They will not stand as kin."},{"id":"semetey-1-2013:p0862:b003:l012","ordinal":142149,"en":"Rein in over rocky ground,"},{"id":"semetey-1-2013:p0862:b003:l013","ordinal":142150,"en":"To Manas's orphan son"},{"id":"semetey-1-2013:p0862:b003:l014","ordinal":142151,"en":"Go and deliver my greeting."},{"id":"semetey-1-2013:p0862:b003:l015","ordinal":142152,"en":"A great dug pit confronts him,"},{"id":"semetey-1-2013:p0862:b003:l017","ordinal":142153,"en":"Manas's orphan son—","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0862:b003:l018","ordinal":142154,"en":"If these men sweep over him,"},{"id":"semetey-1-2013:p0862:b003:l019","ordinal":142155,"en":"What will happen? I ask."},{"id":"semetey-1-2013:p0862:b003:l020","ordinal":142156,"en":"Great peril has come upon his dear head."},{"id":"semetey-1-2013:p0862:b003:l021","ordinal":142157,"en":"An unjust claim has arisen;"},{"id":"semetey-1-2013:p0862:b003:l022","ordinal":142158,"en":"Saying, ‘If Semetey comes, I will slaughter him,’"},{"id":"semetey-1-2013:p0862:b003:l023","ordinal":142159,"en":"Saying, ‘I will put him to death,’"},{"id":"semetey-1-2013:p0862:b003:l024","ordinal":142160,"en":"Fierce enemies have come from every side."},{"id":"semetey-1-2013:p0862:b003:l025","ordinal":142161,"en":"They sent throughout Sary-Arka,"},{"id":"semetey-1-2013:p0862:b003:l026","ordinal":142162,"en":"Summoned the sons of the Kazakhs,"},{"id":"semetey-1-2013:p0862:b003:l027","ordinal":142163,"en":"Sent throughout Alty-Shaar,"},{"id":"semetey-1-2013:p0862:b003:l028","ordinal":142164,"en":"Summoned Alabek's army."},{"id":"semetey-1-2013:p0862:b003:l029","ordinal":142165,"en":"He who dwelt in Eki-Kemin,"},{"id":"semetey-1-2013:p0862:b003:l030","ordinal":142166,"en":"Called a hero like an ogre,"},{"id":"semetey-1-2013:p0862:b003:l031","ordinal":142167,"en":"They sent to brave Urbu,"},{"id":"semetey-1-2013:p0862:b003:l032","ordinal":142168,"en":"Summoned his army;"},{"id":"semetey-1-2013:p0862:b003:l033","ordinal":142169,"en":"Muzburchak's Buyanbek—"},{"id":"semetey-1-2013:p0862:b003:l034","ordinal":142170,"en":"They summoned his army too."},{"id":"semetey-1-2013:p0862:b003:l035","ordinal":142171,"en":"“They have a trench dug,"},{"id":"semetey-1-2013:p0862:b003:l036","ordinal":142172,"en":"They have such a seething army,"},{"id":"semetey-1-2013:p0862:b003:l037","ordinal":142173,"en":"They have an orator with a bewitching tongue."},{"id":"semetey-1-2013:p0862:b003:l038","ordinal":142174,"en":"Uncle Sary, hear my words:"},{"id":"semetey-1-2013:p0862:b003:l039","ordinal":142175,"en":"There are many who will deceive you."},{"id":"semetey-1-2013:p0862:b004:l001","ordinal":142176,"en":"Do not yield to their deception,"},{"id":"semetey-1-2013:p0862:b004:l002","ordinal":142177,"en":"Do not enter their royal camp,"},{"id":"semetey-1-2013:p0862:b004:l003","ordinal":142178,"en":"Do not dismount from your horse,"},{"id":"semetey-1-2013:p0862:b004:l004","ordinal":142179,"en":"Do not die an untimely death."},{"id":"semetey-1-2013:p0862:b004:l005","ordinal":142180,"en":"Ready your battle-axe,"},{"id":"semetey-1-2013:p0862:b004:l006","ordinal":142181,"en":"Sharpen your sword and prepare."},{"id":"semetey-1-2013:p0862:b004:l007","ordinal":142182,"en":"What a time, what a day,"},{"id":"semetey-1-2013:p0862:b004:l008","ordinal":142183,"en":"What a night will it be?"},{"id":"semetey-1-2013:p0862:b004:l009","ordinal":142184,"en":"Drinking spirits and panting,"},{"id":"semetey-1-2013:p0862:b004:l010","ordinal":142185,"en":"All the warriors"},{"id":"semetey-1-2013:p0862:b004:l011","ordinal":142186,"en":"Around Abyke and Kobosh"},{"id":"semetey-1-2013:p0862:b004:l012","ordinal":142187,"en":"Struggled as if mad."},{"id":"semetey-1-2013:p0862:b004:l013","ordinal":142188,"en":"Drinking kumys, growing heated,"},{"id":"semetey-1-2013:p0862:b004:l014","ordinal":142189,"en":"Their bones and skin growing hot,"},{"id":"semetey-1-2013:p0862:b004:l015","ordinal":142190,"en":"Wiping sweat from their brows,"},{"id":"semetey-1-2013:p0862:b004:l016","ordinal":142191,"en":"Against Manas's orphan son"},{"id":"semetey-1-2013:p0862:b004:l017","ordinal":142192,"en":"They swore vengeance, pounding the ground."},{"id":"semetey-1-2013:p0862:b004:l018","ordinal":142193,"en":"Their eyes blazed like fire,"},{"id":"semetey-1-2013:p0862:b004:l019","ordinal":142194,"en":"They bit through their lips,"},{"id":"semetey-1-2013:p0862:b004:l020","ordinal":142195,"en":"Roared in fits of rage,"},{"id":"semetey-1-2013:p0862:b004:l021","ordinal":142196,"en":"Unable to stand still, raving,"},{"id":"semetey-1-2013:p0862:b004:l022","ordinal":142197,"en":"Shouting ‘Kobosh!’ as their battle cry."},{"id":"semetey-1-2013:p0862:b004:l023","ordinal":142198,"en":"Speaking words that would not stand,"},{"id":"semetey-1-2013:p0862:b004:l024","ordinal":142199,"en":"Making their promise firm,"},{"id":"semetey-1-2013:p0862:b004:l025","ordinal":142200,"en":"Shouting with all their might,"},{"id":"semetey-1-2013:p0862:b004:l026","ordinal":142201,"en":"They had plunged into tumult;"},{"id":"semetey-1-2013:p0862:b004:l027","ordinal":142202,"en":"Without sobering at all,"},{"id":"semetey-1-2013:p0862:b004:l028","ordinal":142203,"en":"They had plunged into uproar.”"},{"id":"semetey-1-2013:p0862:b004:l029","ordinal":142204,"en":"While they were roaring together,"},{"id":"semetey-1-2013:p0862:b004:l030","ordinal":142205,"en":"Dear Shuutu went to them."},{"id":"semetey-1-2013:p0862:b004:l031","ordinal":142206,"en":"These are the words Shuutu spoke:"},{"id":"semetey-1-2013:p0862:b004:l032","ordinal":142207,"en":"In the midst of the council,"},{"id":"semetey-1-2013:p0862:b004:l033","ordinal":142208,"en":"Shuutu said this:"},{"id":"semetey-1-2013:p0862:b004:l034","ordinal":142209,"en":"“Riding a gray stallion, bearing a banner,"},{"id":"semetey-1-2013:p0862:b004:l035","ordinal":142210,"en":"At the sight of his bearing"},{"id":"semetey-1-2013:p0862:b004:l036","ordinal":142211,"en":"The Kyrgyz people rejoiced."},{"id":"semetey-1-2013:p0862:b004:l038","ordinal":142212,"en":"His spirits and his kumys","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0862:b004:l039","ordinal":142213,"en":"He made flow across the threshold."},{"id":"semetey-1-2013:p0863:b003:l001","ordinal":142214,"en":"In a single filling of the cauldron"},{"id":"semetey-1-2013:p0863:b003:l002","ordinal":142215,"en":"He boiled the meat of forty yearlings;"},{"id":"semetey-1-2013:p0863:b003:l003","ordinal":142216,"en":"For the destitute poor and needy"},{"id":"semetey-1-2013:p0863:b003:l004","ordinal":142217,"en":"He spread out food and meals."},{"id":"semetey-1-2013:p0863:b003:l005","ordinal":142218,"en":"The rich man's son Baimyrza—"},{"id":"semetey-1-2013:p0863:b003:l006","ordinal":142219,"en":"That generous man has died."},{"id":"semetey-1-2013:p0863:b003:l007","ordinal":142220,"en":"He has become one who will not return or turn back;"},{"id":"semetey-1-2013:p0863:b003:l009","ordinal":142221,"en":"His horse renowned for speed,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0863:b003:l010","ordinal":142222,"en":"Carrying a letter the size of a palm,"},{"id":"semetey-1-2013:p0863:b003:l011","ordinal":142223,"en":"His bowl-like eyes shining,"},{"id":"semetey-1-2013:p0863:b003:l012","ordinal":142224,"en":"Great Sary Khan has come."},{"id":"semetey-1-2013:p0863:b003:l013","ordinal":142225,"en":"Do not ask what Sary Khan is like:"},{"id":"semetey-1-2013:p0863:b003:l014","ordinal":142226,"en":"His words are sweeter than other men's,"},{"id":"semetey-1-2013:p0863:b003:l015","ordinal":142227,"en":"He has one eye on his forehead, as large as a bucket."},{"id":"semetey-1-2013:p0863:b003:l016","ordinal":142228,"en":"He rides a horse no bullet can catch,"},{"id":"semetey-1-2013:p0863:b003:l017","ordinal":142229,"en":"Wears a coat no bullet can pierce,"},{"id":"semetey-1-2013:p0863:b003:l018","ordinal":142230,"en":"Is clad in blue padded armor."},{"id":"semetey-1-2013:p0863:b003:l019","ordinal":142231,"en":"Had you seen Sary Khan,"},{"id":"semetey-1-2013:p0863:b003:l020","ordinal":142232,"en":"He springs like a blue tiger."},{"id":"semetey-1-2013:p0863:b003:l021","ordinal":142233,"en":"His right shoulder-blade is broad;"},{"id":"semetey-1-2013:p0863:b003:l022","ordinal":142234,"en":"He is a lion who can rout the Oirats."},{"id":"semetey-1-2013:p0863:b003:l023","ordinal":142235,"en":"He is skilled among the lancers;"},{"id":"semetey-1-2013:p0863:b003:l025","ordinal":142236,"en":"His size is equal to a mountain's,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0863:b003:l026","ordinal":142237,"en":"Enough to overcome anyone who faces him."},{"id":"semetey-1-2013:p0863:b003:l027","ordinal":142238,"en":"With a warrior's frame and a heart of stone,"},{"id":"semetey-1-2013:p0863:b003:l028","ordinal":142239,"en":"Terrible in majesty, mighty in fury,"},{"id":"semetey-1-2013:p0863:b003:l029","ordinal":142240,"en":"He has the appearance of a dragon."},{"id":"semetey-1-2013:p0863:b003:l030","ordinal":142241,"en":"The hero, brave Semetey's"},{"id":"semetey-1-2013:p0863:b003:l031","ordinal":142242,"en":"Envoy has come: give him an answer!”"},{"id":"semetey-1-2013:p0863:b003:l032","ordinal":142243,"en":"Those who heard this news—"},{"id":"semetey-1-2013:p0863:b003:l033","ordinal":142244,"en":"Eloquent Urbu, the fierce wolf hero,"},{"id":"semetey-1-2013:p0863:b003:l034","ordinal":142245,"en":"His tongue sugar, his heart venom,"},{"id":"semetey-1-2013:p0863:b003:l035","ordinal":142246,"en":"Ran out of the royal camp."},{"id":"semetey-1-2013:p0863:b003:l036","ordinal":142247,"en":"When he saw Sary Khan,"},{"id":"semetey-1-2013:p0863:b003:l037","ordinal":142248,"en":"His eyes blazed like fire;"},{"id":"semetey-1-2013:p0863:b003:l039","ordinal":142249,"en":"Readying his weapons,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0863:b004:l001","ordinal":142250,"en":"He girded on his Arkesken sword,"},{"id":"semetey-1-2013:p0863:b004:l002","ordinal":142251,"en":"To seize Sary Khan,"},{"id":"semetey-1-2013:p0863:b004:l003","ordinal":142252,"en":"To offer him as a sacrifice,"},{"id":"semetey-1-2013:p0863:b004:l004","ordinal":142253,"en":"To bring the end of the world upon him,"},{"id":"semetey-1-2013:p0863:b004:l005","ordinal":142254,"en":"Without speaking with him,"},{"id":"semetey-1-2013:p0863:b004:l006","ordinal":142255,"en":"To cut off his head,"},{"id":"semetey-1-2013:p0863:b004:l007","ordinal":142256,"en":"Urbu came prepared."},{"id":"semetey-1-2013:p0863:b004:l008","ordinal":142257,"en":"Behind that Urbu,"},{"id":"semetey-1-2013:p0863:b004:l009","ordinal":142258,"en":"Kokcho's son Umotoy,"},{"id":"semetey-1-2013:p0863:b004:l010","ordinal":142259,"en":"Muzburchak's Buyanbek,"},{"id":"semetey-1-2013:p0863:b004:l011","ordinal":142260,"en":"Came rushing together too."},{"id":"semetey-1-2013:p0863:b004:l012","ordinal":142261,"en":"All forty companions"},{"id":"semetey-1-2013:p0863:b004:l013","ordinal":142262,"en":"Came again to seize him,"},{"id":"semetey-1-2013:p0863:b004:l014","ordinal":142263,"en":"Their elders led by Kyrgyl;"},{"id":"semetey-1-2013:p0863:b004:l015","ordinal":142264,"en":"They rushed upon your khan,"},{"id":"semetey-1-2013:p0863:b004:l016","ordinal":142265,"en":"The whole seething army."},{"id":"semetey-1-2013:p0863:b004:l017","ordinal":142266,"en":"When the army swept toward him,"},{"id":"semetey-1-2013:p0863:b004:l018","ordinal":142267,"en":"He knew they were enemies."},{"id":"semetey-1-2013:p0863:b004:l019","ordinal":142268,"en":"Once he knew they were enemies,"},{"id":"semetey-1-2013:p0863:b004:l020","ordinal":142269,"en":"Unflustered, unhurried, unconcerned,"},{"id":"semetey-1-2013:p0863:b004:l021","ordinal":142270,"en":"All of them—"},{"id":"semetey-1-2013:p0863:b004:l022","ordinal":142271,"en":"What did your dear uncle do?"},{"id":"semetey-1-2013:p0863:b004:l023","ordinal":142272,"en":"He counted them as nothing."},{"id":"semetey-1-2013:p0863:b004:l024","ordinal":142273,"en":"At the head of the advancing army,"},{"id":"semetey-1-2013:p0863:b004:l025","ordinal":142274,"en":"Dear Urbu readied himself"},{"id":"semetey-1-2013:p0863:b004:l026","ordinal":142275,"en":"To seize Sary Khan."},{"id":"semetey-1-2013:p0863:b004:l027","ordinal":142276,"en":"When Urbu came near,"},{"id":"semetey-1-2013:p0863:b004:l028","ordinal":142277,"en":"Within a lance's length,"},{"id":"semetey-1-2013:p0863:b004:l030","ordinal":142278,"en":"We are one of those who reason;","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0863:b004:l032","ordinal":142279,"en":"We are an envoy serving as mediator.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0863:b004:l033","ordinal":142280,"en":"Please stand a little farther away,"},{"id":"semetey-1-2013:p0863:b004:l034","ordinal":142281,"en":"Listen from where you are!"},{"id":"semetey-1-2013:p0863:b004:l035","ordinal":142282,"en":"You come running in a bluster;"},{"id":"semetey-1-2013:p0863:b004:l036","ordinal":142283,"en":"This conduct of yours is unseemly."},{"id":"semetey-1-2013:p0863:b004:l037","ordinal":142284,"en":"I see in my mind that you are an enemy."},{"id":"semetey-1-2013:p0863:b004:l038","ordinal":142285,"en":"Stand where you are!"},{"id":"semetey-1-2013:p0863:b004:l039","ordinal":142286,"en":"I have come as a messenger,"},{"id":"semetey-1-2013:p0864:b003:l001","ordinal":142287,"en":"Look and listen to my words."},{"id":"semetey-1-2013:p0864:b003:l002","ordinal":142288,"en":"Your wrestlers rush upon me;"},{"id":"semetey-1-2013:p0864:b003:l003","ordinal":142289,"en":"You look as though you mean to bind me."},{"id":"semetey-1-2013:p0864:b003:l004","ordinal":142290,"en":"Your fury is extraordinary."},{"id":"semetey-1-2013:p0864:b003:l005","ordinal":142291,"en":"Your stature and your bearing,"},{"id":"semetey-1-2013:p0864:b003:l006","ordinal":142292,"en":"Your appearance on horseback—"},{"id":"semetey-1-2013:p0864:b003:l007","ordinal":142293,"en":"You have shown a hostile face!"},{"id":"semetey-1-2013:p0864:b003:l008","ordinal":142294,"en":"Drinking kumys and shouting,"},{"id":"semetey-1-2013:p0864:b003:l009","ordinal":142295,"en":"Drinking spirits and panting,"},{"id":"semetey-1-2013:p0864:b003:l010","ordinal":142296,"en":"All of you raving and struggling"},{"id":"semetey-1-2013:p0864:b003:l011","ordinal":142297,"en":"To seize me,"},{"id":"semetey-1-2013:p0864:b003:l012","ordinal":142298,"en":"To offer me as a sacrifice;"},{"id":"semetey-1-2013:p0864:b003:l013","ordinal":142299,"en":"Manas's orphan son—"},{"id":"semetey-1-2013:p0864:b003:l014","ordinal":142300,"en":"To charge headlong and strike him,"},{"id":"semetey-1-2013:p0864:b003:l015","ordinal":142301,"en":"You have gathered and assembled troops,"},{"id":"semetey-1-2013:p0864:b003:l016","ordinal":142302,"en":"Shouting, gathered vast numbers."},{"id":"semetey-1-2013:p0864:b003:l017","ordinal":142303,"en":"I have seen this today."},{"id":"semetey-1-2013:p0864:b003:l018","ordinal":142304,"en":"Your manner has turned wicked;"},{"id":"semetey-1-2013:p0864:b003:l019","ordinal":142305,"en":"Our fury has risen mightily!”"},{"id":"semetey-1-2013:p0864:b003:l020","ordinal":142306,"en":"High-backed, yet low of stature,"},{"id":"semetey-1-2013:p0864:b003:l021","ordinal":142307,"en":"Tuuchunak beneath him—"},{"id":"semetey-1-2013:p0864:b003:l022","ordinal":142308,"en":"He urged Tuuchunak once,"},{"id":"semetey-1-2013:p0864:b003:l023","ordinal":142309,"en":"Took his lacquered lance in hand,"},{"id":"semetey-1-2013:p0864:b003:l024","ordinal":142310,"en":"Before he had finished turning it,"},{"id":"semetey-1-2013:p0864:b003:l025","ordinal":142311,"en":"Attacked brave Urbu;"},{"id":"semetey-1-2013:p0864:b003:l026","ordinal":142312,"en":"The skilled Sary Khan"},{"id":"semetey-1-2013:p0864:b003:l027","ordinal":142313,"en":"Reached brave Urbu."},{"id":"semetey-1-2013:p0864:b003:l028","ordinal":142314,"en":"“This side of the liver,” he said,"},{"id":"semetey-1-2013:p0864:b003:l029","ordinal":142315,"en":"“One edge of the lung,” he said,"},{"id":"semetey-1-2013:p0864:b003:l030","ordinal":142316,"en":"“The rim of the ribs,” he said,"},{"id":"semetey-1-2013:p0864:b003:l032","ordinal":142317,"en":"“The top of his heart,” he said.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0864:b003:l033","ordinal":142318,"en":"The skilled Sary Khan"},{"id":"semetey-1-2013:p0864:b003:l034","ordinal":142319,"en":"Arrived before an arrow could;"},{"id":"semetey-1-2013:p0864:b003:l035","ordinal":142320,"en":"Where he reached Urbu,"},{"id":"semetey-1-2013:p0864:b003:l036","ordinal":142321,"en":"He struck hard as he passed."},{"id":"semetey-1-2013:p0864:b003:l037","ordinal":142322,"en":"Sary Khan thrust unerringly;"},{"id":"semetey-1-2013:p0864:b003:l038","ordinal":142323,"en":"Khan Urbu was shattered."},{"id":"semetey-1-2013:p0864:b003:l039","ordinal":142324,"en":"From Algara the horse's back"},{"id":"semetey-1-2013:p0864:b004:l001","ordinal":142325,"en":"He shot upward with a jerk;"},{"id":"semetey-1-2013:p0864:b004:l002","ordinal":142326,"en":"From the shoulder-blade behind,"},{"id":"semetey-1-2013:p0864:b004:l003","ordinal":142327,"en":"Sary Khan's lance"},{"id":"semetey-1-2013:p0864:b004:l004","ordinal":142328,"en":"Jutted out with a jutting snap."},{"id":"semetey-1-2013:p0864:b004:l005","ordinal":142329,"en":"Having finished off brave Urbu,"},{"id":"semetey-1-2013:p0864:b004:l006","ordinal":142330,"en":"He passed farther on;"},{"id":"semetey-1-2013:p0864:b004:l007","ordinal":142331,"en":"Meeting him face to face,"},{"id":"semetey-1-2013:p0864:b004:l008","ordinal":142332,"en":"He reached Tazbaimat."},{"id":"semetey-1-2013:p0864:b004:l009","ordinal":142333,"en":"Your uncle Sary did not tire;"},{"id":"semetey-1-2013:p0864:b004:l010","ordinal":142334,"en":"Brandishing his lance,"},{"id":"semetey-1-2013:p0864:b004:l011","ordinal":142335,"en":"He struck true as he passed."},{"id":"semetey-1-2013:p0864:b004:l012","ordinal":142336,"en":"Tazbaimat, Manas's companion,"}]
