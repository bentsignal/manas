{"id": "sayakbay-ms-current146:pdf029:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 29, "folio": 412, "line_in_page": 20, "raw": "Чабышканда бети чыккан,", "text": "Чабышканда бети чыккан,", "en": "In battle his face thrust forward,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The verbal phrase is translated contextually.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf029:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 29, "folio": 412, "line_in_page": 21, "raw": "Кайра айткандан коркпогон,", "text": "Кайра айткандан коркпогон,", "en": "He did not fear one who answered back,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf029:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 29, "folio": 412, "line_in_page": 22, "raw": "Кабак силкип койгондо,", "text": "Кабак силкип койгондо,", "en": "When he merely flicked his brow,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The verb appears to be силкип but is not fully secure.", "bbox": null}
