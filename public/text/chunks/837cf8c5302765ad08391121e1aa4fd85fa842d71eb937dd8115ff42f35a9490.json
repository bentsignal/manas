[{"id":"semetey-1-2013:p1163:b003:l009","ordinal":165889,"en":"On the banks of Karkyra,"},{"id":"semetey-1-2013:p1163:b003:l010","ordinal":165890,"en":"Just as he entered"},{"id":"semetey-1-2013:p1163:b003:l011","ordinal":165891,"en":"Khan Manas's camp,"},{"id":"semetey-1-2013:p1163:b003:l012","ordinal":165892,"en":"Kanykei with her forty young wives"},{"id":"semetey-1-2013:p1163:b003:l013","ordinal":165893,"en":"Led the forty young wives"},{"id":"semetey-1-2013:p1163:b003:l014","ordinal":165894,"en":"Out of the camp."},{"id":"semetey-1-2013:p1163:b003:l015","ordinal":165895,"en":"Her rump showed white as a wild ewe's;"},{"id":"semetey-1-2013:p1163:b003:l016","ordinal":165896,"en":"Her white breasts swayed."},{"id":"semetey-1-2013:p1163:b003:l017","ordinal":165897,"en":"With forty young wives following her,"},{"id":"semetey-1-2013:p1163:b003:l018","ordinal":165898,"en":"She spoke softly and sadly"},{"id":"semetey-1-2013:p1163:b003:l019","ordinal":165899,"en":"To the prince who was raging,"},{"id":"semetey-1-2013:p1163:b003:l020","ordinal":165900,"en":"And would not let him go on Akkula."},{"id":"semetey-1-2013:p1163:b003:l021","ordinal":165901,"en":"His nose bulged like a leather flask;"},{"id":"semetey-1-2013:p1163:b003:l022","ordinal":165902,"en":"As he raged and thrashed,"},{"id":"semetey-1-2013:p1163:b003:l023","ordinal":165903,"en":"Twelve companions struggled"},{"id":"semetey-1-2013:p1163:b003:l024","ordinal":165904,"en":"To hold Manas back."},{"id":"semetey-1-2013:p1163:b003:l025","ordinal":165905,"en":"They exchanged muffled words"},{"id":"semetey-1-2013:p1163:b003:l026","ordinal":165906,"en":"And whispered among themselves,"},{"id":"semetey-1-2013:p1163:b003:l027","ordinal":165907,"en":"Thinking with dread,"},{"id":"semetey-1-2013:p1163:b003:l028","ordinal":165908,"en":"“This bloodthirsty man who kills his wife—"},{"id":"semetey-1-2013:p1163:b003:l029","ordinal":165909,"en":"How could he spare us?”"},{"id":"semetey-1-2013:p1163:b003:l030","ordinal":165910,"en":"They would not release the bloodthirsty man,"},{"id":"semetey-1-2013:p1163:b003:l031","ordinal":165911,"en":"But stepped between them."},{"id":"semetey-1-2013:p1163:b003:l032","ordinal":165912,"en":"Shimmering in garments of yellow gold,"},{"id":"semetey-1-2013:p1163:b003:l033","ordinal":165913,"en":"With forty young wives following her,"},{"id":"semetey-1-2013:p1163:b003:l034","ordinal":165914,"en":"She came gleaming before him."},{"id":"semetey-1-2013:p1163:b003:l035","ordinal":165915,"en":"She spoke to the blue-maned lion,"},{"id":"semetey-1-2013:p1163:b003:l036","ordinal":165916,"en":"Saying openly:"},{"id":"semetey-1-2013:p1163:b003:l037","ordinal":165917,"en":"“Here are the teeming multitudes."},{"id":"semetey-1-2013:p1163:b003:l038","ordinal":165918,"en":"You have grown furious;"},{"id":"semetey-1-2013:p1163:b003:l039","ordinal":165919,"en":"Though I am only a woman, hear me."},{"id":"semetey-1-2013:p1163:b005:l001","ordinal":165920,"en":"Here I am—spill my blood."},{"id":"semetey-1-2013:p1163:b005:l002","ordinal":165921,"en":"While the people stand here,"},{"id":"semetey-1-2013:p1163:b005:l003","ordinal":165922,"en":"I have something fitting to say."},{"id":"semetey-1-2013:p1163:b005:l004","ordinal":165923,"en":"If you spill my blood,"},{"id":"semetey-1-2013:p1163:b005:l005","ordinal":165924,"en":"My bloodthirsty lord, I have words for you."},{"id":"semetey-1-2013:p1163:b005:l006","ordinal":165925,"en":"Knowing your elder would wear it,"},{"id":"semetey-1-2013:p1163:b005:l007","ordinal":165926,"en":"I lined its inside with brocade."},{"id":"semetey-1-2013:p1163:b005:l008","ordinal":165927,"en":"For six years without rest, I worked it with my teeth."},{"id":"semetey-1-2013:p1163:b005:l009","ordinal":165928,"en":"While the maidens and young wives embroidered it,"},{"id":"semetey-1-2013:p1163:b005:l010","ordinal":165929,"en":"I had the places I disliked unstitched."},{"id":"semetey-1-2013:p1163:b005:l011","ordinal":165930,"en":"Plate after plate of steel"},{"id":"semetey-1-2013:p1163:b005:l012","ordinal":165931,"en":"I had poured into its midst."},{"id":"semetey-1-2013:p1163:b005:l013","ordinal":165932,"en":"I made it with all my heart."},{"id":"semetey-1-2013:p1163:b005:l014","ordinal":165933,"en":"Weeping in supplication to the one God,"},{"id":"semetey-1-2013:p1163:b005:l015","ordinal":165934,"en":"From the very beginning, wretched as I was,"},{"id":"semetey-1-2013:p1163:b005:l016","ordinal":165935,"en":"I dedicated it to my elder."},{"id":"semetey-1-2013:p1163:b005:l017","ordinal":165936,"en":"I have endless words to tell."},{"id":"semetey-1-2013:p1163:b005:l018","ordinal":165937,"en":"If I made the kandagai wider,"},{"id":"semetey-1-2013:p1163:b005:l019","ordinal":165938,"en":"I feared he would unleash a massacre;"},{"id":"semetey-1-2013:p1163:b005:l020","ordinal":165939,"en":"I feared my bloodthirsty lord would take my head."},{"id":"semetey-1-2013:p1163:b005:l021","ordinal":165940,"en":"That was the measure of my fear."},{"id":"semetey-1-2013:p1163:b005:l022","ordinal":165941,"en":"I kept measuring its dimensions:"},{"id":"semetey-1-2013:p1163:b005:l023","ordinal":165942,"en":"Six spans and four finger-widths"},{"id":"semetey-1-2013:p1163:b005:l024","ordinal":165943,"en":"From the end of the cuff,"},{"id":"semetey-1-2013:p1163:b005:l025","ordinal":165944,"en":"And from the rim of the fat rump,"},{"id":"semetey-1-2013:p1163:b005:l026","ordinal":165945,"en":"I have a clasp joining it shut."},{"id":"semetey-1-2013:p1163:b005:l027","ordinal":165946,"en":"I have many words to tell."},{"id":"semetey-1-2013:p1163:b005:l028","ordinal":165947,"en":"Many cares cannot fit within my heart;"},{"id":"semetey-1-2013:p1163:b005:l029","ordinal":165948,"en":"The tears from my eyes spread in ten directions."},{"id":"semetey-1-2013:p1163:b005:l030","ordinal":165949,"en":"Almambet and Chubak, whose names rhyme,"},{"id":"semetey-1-2013:p1163:b005:l031","ordinal":165950,"en":"Let them take opposing sides and pull.”"},{"id":"semetey-1-2013:p1163:b005:l032","ordinal":165951,"en":"Your furious bloodthirsty man"},{"id":"semetey-1-2013:p1163:b005:l033","ordinal":165952,"en":"Grabbed the black-bladed whip,"},{"id":"semetey-1-2013:p1163:b005:l034","ordinal":165953,"en":"Seized it and turned it around."},{"id":"semetey-1-2013:p1163:b005:l035","ordinal":165954,"en":"The towering leopard"},{"id":"semetey-1-2013:p1163:b005:l036","ordinal":165955,"en":"Pulled it toward the middle;"},{"id":"semetey-1-2013:p1163:b005:l037","ordinal":165956,"en":"With a ripping sound, the trousers tore,"},{"id":"semetey-1-2013:p1163:b005:l038","ordinal":165957,"en":"Their folds came loose and opened."},{"id":"semetey-1-2013:p1163:b005:l039","ordinal":165958,"en":"That queen Kanykei's"},{"id":"semetey-1-2013:p1164:b003:l001","ordinal":165959,"en":"Far-off misery came to an end."},{"id":"semetey-1-2013:p1164:b003:l002","ordinal":165960,"en":"When Khan Koshoi of the Katagan,"},{"id":"semetey-1-2013:p1164:b003:l003","ordinal":165961,"en":"Your elder, father of the people,"},{"id":"semetey-1-2013:p1164:b003:l004","ordinal":165962,"en":"Put on the kandagai,"},{"id":"semetey-1-2013:p1164:b003:l005","ordinal":165963,"en":"Your elder, old Koshoi,"},{"id":"semetey-1-2013:p1164:b003:l006","ordinal":165964,"en":"Cuff upon cuff,"},{"id":"semetey-1-2013:p1164:b003:l007","ordinal":165965,"en":"It was as though fitted in place;"},{"id":"semetey-1-2013:p1164:b003:l008","ordinal":165966,"en":"Fat rump upon fat rump,"},{"id":"semetey-1-2013:p1164:b003:l009","ordinal":165967,"en":"It was as though patched in place."},{"id":"semetey-1-2013:p1164:b003:l010","ordinal":165968,"en":"Old hero Koshoi"},{"id":"semetey-1-2013:p1164:b003:l011","ordinal":165969,"en":"Then tested Kanykei,"},{"id":"semetey-1-2013:p1164:b003:l012","ordinal":165970,"en":"Daughter of Kara Khan,"},{"id":"semetey-1-2013:p1164:b003:l013","ordinal":165971,"en":"The wretched daughter of a saint."},{"id":"semetey-1-2013:p1164:b003:l014","ordinal":165972,"en":"Seeing this, he approved."},{"id":"semetey-1-2013:p1164:b003:l015","ordinal":165973,"en":"Kanykei, the prince's wife,"},{"id":"semetey-1-2013:p1164:b003:l016","ordinal":165974,"en":"Bent her knees to the ground"},{"id":"semetey-1-2013:p1164:b003:l017","ordinal":165975,"en":"And stood bowing"},{"id":"semetey-1-2013:p1164:b003:l018","ordinal":165976,"en":"Before Koshoi, father of the people."},{"id":"semetey-1-2013:p1164:b003:l019","ordinal":165977,"en":"Her prayer to God"},{"id":"semetey-1-2013:p1164:b003:l020","ordinal":165978,"en":"Had reached Him long before."},{"id":"semetey-1-2013:p1164:b003:l021","ordinal":165979,"en":"At Khan Kökötöy's feast,"},{"id":"semetey-1-2013:p1164:b003:l022","ordinal":165980,"en":"While infidels and Muslims"},{"id":"semetey-1-2013:p1164:b003:l023","ordinal":165981,"en":"Seethed there before him,"},{"id":"semetey-1-2013:p1164:b003:l024","ordinal":165982,"en":"When she bowed to her elder khan,"},{"id":"semetey-1-2013:p1164:b003:l025","ordinal":165983,"en":"He became as heavy as lead."},{"id":"semetey-1-2013:p1164:b003:l026","ordinal":165984,"en":"Koshoi tested the fierce woman:"},{"id":"semetey-1-2013:p1164:b003:l027","ordinal":165985,"en":"“Ah, my poor Kanykei,"},{"id":"semetey-1-2013:p1164:b003:l028","ordinal":165986,"en":"Her fortunes are complete;"},{"id":"semetey-1-2013:p1164:b003:l029","ordinal":165987,"en":"Her twelve limbs are ample."},{"id":"semetey-1-2013:p1164:b003:l030","ordinal":165988,"en":"Her courage is great, her wrath is strong;"},{"id":"semetey-1-2013:p1164:b003:l031","ordinal":165989,"en":"She is a woman who will bear a lion."},{"id":"semetey-1-2013:p1164:b003:l032","ordinal":165990,"en":"She is a chosen one among spear-wielders,"},{"id":"semetey-1-2013:p1164:b003:l033","ordinal":165991,"en":"A woman who will bear a hero."},{"id":"semetey-1-2013:p1164:b003:l034","ordinal":165992,"en":"She is a seamstress with golden fingers;"},{"id":"semetey-1-2013:p1164:b003:l035","ordinal":165993,"en":"Among women there can be none like her,"},{"id":"semetey-1-2013:p1164:b003:l036","ordinal":165994,"en":"For she herself is a saint's daughter."},{"id":"semetey-1-2013:p1164:b003:l037","ordinal":165995,"en":"When trouble assails, she will undo it;"},{"id":"semetey-1-2013:p1164:b003:l038","ordinal":165996,"en":"She is one of the finest of people."},{"id":"semetey-1-2013:p1164:b003:l039","ordinal":165997,"en":"For the sacred bloodthirsty man,"},{"id":"semetey-1-2013:p1164:b004:l001","ordinal":165998,"en":"She is the Night of Power itself."},{"id":"semetey-1-2013:p1164:b004:l002","ordinal":165999,"en":"She was born with excellent wisdom;"},{"id":"semetey-1-2013:p1164:b004:l003","ordinal":166000,"en":"Her pelvis is narrow."},{"id":"semetey-1-2013:p1164:b004:l004","ordinal":166001,"en":"Put another way, there is something to say:"},{"id":"semetey-1-2013:p1164:b004:l005","ordinal":166002,"en":"There is a reason she might not bear a child."},{"id":"semetey-1-2013:p1164:b004:l006","ordinal":166003,"en":"Her forehead bone curves back;"},{"id":"semetey-1-2013:p1164:b004:l007","ordinal":166004,"en":"After the hero's eyes close,"},{"id":"semetey-1-2013:p1164:b004:l008","ordinal":166005,"en":"Her chance of surviving is poor."},{"id":"semetey-1-2013:p1164:b004:l009","ordinal":166006,"en":"The hair at her nape is like wool;"},{"id":"semetey-1-2013:p1164:b004:l010","ordinal":166007,"en":"When the hero's eyes close,"},{"id":"semetey-1-2013:p1164:b004:l011","ordinal":166008,"en":"She was born for sorrow."},{"id":"semetey-1-2013:p1164:b004:l012","ordinal":166009,"en":"The hair on her brow is like grass;"},{"id":"semetey-1-2013:p1164:b004:l013","ordinal":166010,"en":"She has little happiness"},{"id":"semetey-1-2013:p1164:b004:l014","ordinal":166011,"en":"And much misfortune.”"},{"id":"semetey-1-2013:p1164:b004:l015","ordinal":166012,"en":"Koshoi spoke these words."},{"id":"semetey-1-2013:p1164:b004:l016","ordinal":166013,"en":"When Koshoi looked again,"},{"id":"semetey-1-2013:p1164:b004:l017","ordinal":166014,"en":"Unable to contain her distress,"},{"id":"semetey-1-2013:p1164:b004:l018","ordinal":166015,"en":"Dear Kanykei"},{"id":"semetey-1-2013:p1164:b004:l019","ordinal":166016,"en":"Was asking God for a child."},{"id":"semetey-1-2013:p1164:b004:l020","ordinal":166017,"en":"From those dear quail-like eyes,"},{"id":"semetey-1-2013:p1164:b004:l021","ordinal":166018,"en":"Tears streamed apart;"},{"id":"semetey-1-2013:p1164:b004:l022","ordinal":166019,"en":"From those dear currant-like eyes,"},{"id":"semetey-1-2013:p1164:b004:l023","ordinal":166020,"en":"Tears streamed a whip's length."},{"id":"semetey-1-2013:p1164:b004:l024","ordinal":166021,"en":"Wailing in repentance,"},{"id":"semetey-1-2013:p1164:b004:l025","ordinal":166022,"en":"Sobbing and weeping without cease,"},{"id":"semetey-1-2013:p1164:b004:l026","ordinal":166023,"en":"Turning over countless cares,"},{"id":"semetey-1-2013:p1164:b004:l027","ordinal":166024,"en":"Asking my Lord for a child,"},{"id":"semetey-1-2013:p1164:b004:l028","ordinal":166025,"en":"Her knees bent to the ground,"},{"id":"semetey-1-2013:p1164:b004:l029","ordinal":166026,"en":"Your sister-in-law bowed"},{"id":"semetey-1-2013:p1164:b004:l030","ordinal":166027,"en":"Before Koshoi of the Katagan."},{"id":"semetey-1-2013:p1164:b004:l031","ordinal":166028,"en":"As soon as he saw your sister-in-law,"},{"id":"semetey-1-2013:p1164:b004:l032","ordinal":166029,"en":"Khan Koshoi gave his blessing."},{"id":"semetey-1-2013:p1164:b004:l033","ordinal":166030,"en":"Infidels and Muslims"},{"id":"semetey-1-2013:p1164:b004:l034","ordinal":166031,"en":"Joined in the blessing:"},{"id":"semetey-1-2013:p1164:b004:l035","ordinal":166032,"en":"“May Kydyr be a fresh young willow for him;"},{"id":"semetey-1-2013:p1164:b004:l036","ordinal":166033,"en":"Until he climbs the mountain ridge,"},{"id":"semetey-1-2013:p1164:b004:l037","ordinal":166034,"en":"May God, who will act for Semetey,"},{"id":"semetey-1-2013:p1164:b004:l038","ordinal":166035,"en":"Be his protector!"},{"id":"semetey-1-2013:p1164:b004:l039","ordinal":166036,"en":"May he grease his white steel;"},{"id":"semetey-1-2013:p1165:b003:l001","ordinal":166037,"en":"When someone provokes his anger,"},{"id":"semetey-1-2013:p1165:b003:l002","ordinal":166038,"en":"May he lay that man's father beside him!"},{"id":"semetey-1-2013:p1165:b003:l003","ordinal":166039,"en":"May he grease his blue steel;"},{"id":"semetey-1-2013:p1165:b003:l004","ordinal":166040,"en":"When someone crosses him,"},{"id":"semetey-1-2013:p1165:b003:l005","ordinal":166041,"en":"May he lay low the forty companions."},{"id":"semetey-1-2013:p1165:b003:l006","ordinal":166042,"en":"May this Semetey become a hero,"},{"id":"semetey-1-2013:p1165:b003:l007","ordinal":166043,"en":"May he become a keen-eared lion."},{"id":"semetey-1-2013:p1165:b003:l008","ordinal":166044,"en":"On a downward slope, may he spear a hero;"},{"id":"semetey-1-2013:p1165:b003:l009","ordinal":166045,"en":"May he spear many in a single row."},{"id":"semetey-1-2013:p1165:b003:l010","ordinal":166046,"en":"May his fortunes be complete."},{"id":"semetey-1-2013:p1165:b003:l011","ordinal":166047,"en":"Descendant of ocean-like Manas,"},{"id":"semetey-1-2013:p1165:b003:l012","ordinal":166048,"en":"May he be a lion like his father!"},{"id":"semetey-1-2013:p1165:b003:l013","ordinal":166049,"en":"May he be a fire blazing on the ridge;"},{"id":"semetey-1-2013:p1165:b003:l014","ordinal":166050,"en":"May no enemy withstand him!"},{"id":"semetey-1-2013:p1165:b003:l015","ordinal":166051,"en":"Amen!” he said, spreading his hands,"},{"id":"semetey-1-2013:p1165:b003:l016","ordinal":166052,"en":"And Koshoi gave the blessing."},{"id":"semetey-1-2013:p1165:b003:l017","ordinal":166053,"en":"Infidels and Muslims,"},{"id":"semetey-1-2013:p1165:b003:l018","ordinal":166054,"en":"Saying, “Such is his sacred rite,”"},{"id":"semetey-1-2013:p1165:b003:l019","ordinal":166055,"en":"Joined in the blessing."},{"id":"semetey-1-2013:p1165:b003:l020","ordinal":166056,"en":"The earth resounded."},{"id":"semetey-1-2013:p1165:b003:l021","ordinal":166057,"en":"Khan Manas received his blessing."},{"id":"semetey-1-2013:p1165:b003:l022","ordinal":166058,"en":"As for your dear elder Koshoi—"},{"id":"semetey-1-2013:p1165:b003:l023","ordinal":166059,"en":"People, look on in wonder!"},{"id":"semetey-1-2013:p1165:b003:l024","ordinal":166060,"en":"Burning and raging,"},{"id":"semetey-1-2013:p1165:b003:l025","ordinal":166061,"en":"He put on the kandagai."},{"id":"semetey-1-2013:p1165:b003:l026","ordinal":166062,"en":"He prayed to the Almighty;"},{"id":"semetey-1-2013:p1165:b003:l027","ordinal":166063,"en":"Your poor elder, the giant Koshoi,"},{"id":"semetey-1-2013:p1165:b003:l028","ordinal":166064,"en":"Made ready like a starving tiger."},{"id":"semetey-1-2013:p1165:b003:l029","ordinal":166065,"en":"If death came, he was ready to die;"},{"id":"semetey-1-2013:p1165:b003:l030","ordinal":166066,"en":"If strength came to your elder,"},{"id":"semetey-1-2013:p1165:b003:l031","ordinal":166067,"en":"He was ready to meet"},{"id":"semetey-1-2013:p1165:b003:l032","ordinal":166068,"en":"The Kalmyks' giant Joloy in combat."},{"id":"semetey-1-2013:p1165:b003:l033","ordinal":166069,"en":"Khan Bakai of surpassing strength,"},{"id":"semetey-1-2013:p1165:b003:l034","ordinal":166070,"en":"Your elder, old Koshoi,"},{"id":"semetey-1-2013:p1165:b003:l035","ordinal":166071,"en":"His white beard flowing,"},{"id":"semetey-1-2013:p1165:b003:l036","ordinal":166072,"en":"Barefoot and bareheaded,"},{"id":"semetey-1-2013:p1165:b003:l037","ordinal":166073,"en":"Advanced toward the wrestler."},{"id":"semetey-1-2013:p1165:b003:l038","ordinal":166074,"en":"Your ancient elder Koshoi's"},{"id":"semetey-1-2013:p1165:b003:l039","ordinal":166075,"en":"Muscles were like a bull's back,"},{"id":"semetey-1-2013:p1165:b004:l001","ordinal":166076,"en":"As though he could devour anyone who grappled him;"},{"id":"semetey-1-2013:p1165:b004:l002","ordinal":166077,"en":"Like a tiger about to pounce—"},{"id":"semetey-1-2013:p1165:b004:l003","ordinal":166078,"en":"Such was Koshoi's fury."},{"id":"semetey-1-2013:p1165:b004:l004","ordinal":166079,"en":"It seemed no man could wrestle him."},{"id":"semetey-1-2013:p1165:b004:l005","ordinal":166080,"en":"Thinking of honor and shame,"},{"id":"semetey-1-2013:p1165:b004:l006","ordinal":166081,"en":"Your elder went out to the wrestler."},{"id":"semetey-1-2013:p1165:b004:l007","ordinal":166082,"en":"Your elder, old Koshoi,"},{"id":"semetey-1-2013:p1165:b004:l008","ordinal":166083,"en":"Who left no one he seized unharmed,"},{"id":"semetey-1-2013:p1165:b004:l009","ordinal":166084,"en":"Was going to contend"},{"id":"semetey-1-2013:p1165:b004:l010","ordinal":166085,"en":"With the Kalmyks' Joloy;"},{"id":"semetey-1-2013:p1165:b004:l011","ordinal":166086,"en":"He was going to fight to the death."},{"id":"semetey-1-2013:p1165:b004:l012","ordinal":166087,"en":"It was Kökötöy's feast,"},{"id":"semetey-1-2013:p1165:b004:l013","ordinal":166088,"en":"Before the great assembly."},{"id":"semetey-1-2013:p1165:b004:l014","ordinal":166089,"en":"Dust flew to the sky;"},{"id":"semetey-1-2013:p1165:b004:l015","ordinal":166090,"en":"People seethed in the dust."},{"id":"semetey-1-2013:p1165:b004:l016","ordinal":166091,"en":"They swarmed like black worms;"},{"id":"semetey-1-2013:p1165:b004:l017","ordinal":166092,"en":"The people gathered, buzzing."},{"id":"semetey-1-2013:p1165:b004:l018","ordinal":166093,"en":"Saying it was Kökötöy's feast,"},{"id":"semetey-1-2013:p1165:b004:l019","ordinal":166094,"en":"The gathering of many leaders,"},{"id":"semetey-1-2013:p1165:b004:l020","ordinal":166095,"en":"Infidels and Muslims"},{"id":"semetey-1-2013:p1165:b004:l021","ordinal":166096,"en":"Said wrestling would be held for sport,"},{"id":"semetey-1-2013:p1165:b004:l022","ordinal":166097,"en":"That whoever threw his opponent would win the prize,"},{"id":"semetey-1-2013:p1165:b004:l023","ordinal":166098,"en":"And whoever fell would be left with nothing."},{"id":"semetey-1-2013:p1165:b004:l024","ordinal":166099,"en":"The prize for all the wrestlers"},{"id":"semetey-1-2013:p1165:b004:l025","ordinal":166100,"en":"Was a thousand black Bactrian camels"},{"id":"semetey-1-2013:p1165:b004:l026","ordinal":166101,"en":"And a thousand black, blaze-faced mares."},{"id":"semetey-1-2013:p1165:b004:l027","ordinal":166102,"en":"Bringing them to war and having them guarded,"},{"id":"semetey-1-2013:p1165:b004:l028","ordinal":166103,"en":"Having anyone who came near them beaten,"},{"id":"semetey-1-2013:p1165:b004:l029","ordinal":166104,"en":"Among infidels and Muslims,"},{"id":"semetey-1-2013:p1165:b004:l030","ordinal":166105,"en":"Hero Manas had set them aside."},{"id":"semetey-1-2013:p1165:b004:l031","ordinal":166106,"en":"When Manas unleashed his wrath,"},{"id":"semetey-1-2013:p1165:b004:l032","ordinal":166107,"en":"The people gathered in a throng."},{"id":"semetey-1-2013:p1165:b004:l033","ordinal":166108,"en":"“The plundering Chinese and Manchus"},{"id":"semetey-1-2013:p1165:b004:l034","ordinal":166109,"en":"Lined up as though they had drunk poison."},{"id":"semetey-1-2013:p1165:b004:l035","ordinal":166110,"en":"The peoples chose not to flee;"},{"id":"semetey-1-2013:p1165:b004:l036","ordinal":166111,"en":"They stayed to watch the spectacle."},{"id":"semetey-1-2013:p1165:b004:l037","ordinal":166112,"en":"When Koshoi advanced, ready,"},{"id":"semetey-1-2013:p1165:b004:l038","ordinal":166113,"en":"Let us leave this matter here"},{"id":"semetey-1-2013:p1165:b004:l039","ordinal":166114,"en":"With the wrestler of the Kalmyks."},{"id":"semetey-1-2013:p1166:b003:l001","ordinal":166115,"en":"Let us begin the tale of Joloy."},{"id":"semetey-1-2013:p1166:b003:l002","ordinal":166116,"en":"For six years he traveled on foot,"},{"id":"semetey-1-2013:p1166:b003:l003","ordinal":166117,"en":"Greasing his great spear,"},{"id":"semetey-1-2013:p1166:b003:l004","ordinal":166118,"en":"Laying low those who fought him—"},{"id":"semetey-1-2013:p1166:b003:l005","ordinal":166119,"en":"Hero Joloy, reeking of blood."},{"id":"semetey-1-2013:p1166:b003:l006","ordinal":166120,"en":"For seven years he traveled on foot,"},{"id":"semetey-1-2013:p1166:b003:l007","ordinal":166121,"en":"Greasing his well-made spear,"},{"id":"semetey-1-2013:p1166:b003:l008","ordinal":166122,"en":"Laying low all he reached—"},{"id":"semetey-1-2013:p1166:b003:l009","ordinal":166123,"en":"Hero Joloy, reeking of demons."},{"id":"semetey-1-2013:p1166:b003:l010","ordinal":166124,"en":"Fuming and roaring in anger,"},{"id":"semetey-1-2013:p1166:b003:l011","ordinal":166125,"en":"Dear Joloy came thundering:"},{"id":"semetey-1-2013:p1166:b003:l012","ordinal":166126,"en":"“I will tear off the head"},{"id":"semetey-1-2013:p1166:b003:l013","ordinal":166127,"en":"Of the Burut who has come to wrestle."},{"id":"semetey-1-2013:p1166:b003:l014","ordinal":166128,"en":"Upon this palm-sized Burut"},{"id":"semetey-1-2013:p1166:b003:l015","ordinal":166129,"en":"I will heap suffering all at once,” he said."},{"id":"semetey-1-2013:p1166:b003:l016","ordinal":166130,"en":"Your infidel Joloy roared."},{"id":"semetey-1-2013:p1166:b003:l017","ordinal":166131,"en":"“I will take"},{"id":"semetey-1-2013:p1166:b003:l018","ordinal":166132,"en":"This fucking Burut's prize."},{"id":"semetey-1-2013:p1166:b003:l019","ordinal":166133,"en":"I will take his prize and bind him,” he said."},{"id":"semetey-1-2013:p1166:b003:l020","ordinal":166134,"en":"“This Burut who calls himself a hero,"},{"id":"semetey-1-2013:p1166:b003:l021","ordinal":166135,"en":"I will chase as far as Mecca,” he said."},{"id":"semetey-1-2013:p1166:b003:l022","ordinal":166136,"en":"From among the infidel people,"},{"id":"semetey-1-2013:p1166:b003:l023","ordinal":166137,"en":"To wrestle on foot,"},{"id":"semetey-1-2013:p1166:b003:l024","ordinal":166138,"en":"Joloy came out alone."},{"id":"semetey-1-2013:p1166:b003:l025","ordinal":166139,"en":"Joloy's form"},{"id":"semetey-1-2013:p1166:b003:l026","ordinal":166140,"en":"Looked as large as a yurt."},{"id":"semetey-1-2013:p1166:b003:l027","ordinal":166141,"en":"Joloy of the Kalmyks"},{"id":"semetey-1-2013:p1166:b003:l028","ordinal":166142,"en":"Was like a hungry lion or tiger;"},{"id":"semetey-1-2013:p1166:b003:l029","ordinal":166143,"en":"No one who wrestled him survived."},{"id":"semetey-1-2013:p1166:b003:l030","ordinal":166144,"en":"On the field where they would wrestle,"}]
