[{"id":"manas-2010:p0203:b001:l029","ordinal":8961,"en":"All their shaven-headed ones died."},{"id":"manas-2010:p0203:b001:l030","ordinal":8962,"en":"Roaring in fierce wrath,"},{"id":"manas-2010:p0203:b001:l031","ordinal":8963,"en":"Not letting them reach the forty households,"},{"id":"manas-2010:p0203:b001:l032","ordinal":8964,"en":"The seething Chinese,"},{"id":"manas-2010:p0203:b001:l033","ordinal":8965,"en":"Manas the leopard, bloodthirsty lion,"},{"id":"manas-2010:p0203:b001:l034","ordinal":8966,"en":"Speared them back in a sweeping rout."},{"id":"manas-2010:p0203:b001:l035","ordinal":8967,"en":"Taking positions on either side,"},{"id":"manas-2010:p0203:b001:l036","ordinal":8968,"en":"If they could not reach with spears,"},{"id":"manas-2010:p0203:b001:l037","ordinal":8969,"en":"They fired guns."},{"id":"manas-2010:p0203:b001:l038","ordinal":8970,"en":"Standing face to face,"},{"id":"manas-2010:p0203:b001:l039","ordinal":8971,"en":"If they were farther apart,"},{"id":"manas-2010:p0203:b001:l040","ordinal":8972,"en":"They fought with guns."},{"id":"manas-2010:p0203:b001:l041","ordinal":8973,"en":"Standing opposite one another,"},{"id":"manas-2010:p0203:b001:l042","ordinal":8974,"en":"Firing guns and drawing bows,"},{"id":"manas-2010:p0203:b001:l043","ordinal":8975,"en":"They fought with resounding crashes."},{"id":"manas-2010:p0203:b001:l044","ordinal":8976,"en":"God, do not let us behold their faces!"},{"id":"manas-2010:p0203:b001:l045","ordinal":8977,"en":"Like flying tumbleweed,"},{"id":"manas-2010:p0203:b001:l046","ordinal":8978,"en":"Looking, the eye could catch nothing."},{"id":"manas-2010:p0203:b001:l047","ordinal":8979,"en":"Bow arrows screamed,"},{"id":"manas-2010:p0203:b001:l048","ordinal":8980,"en":"Where they struck burst apart,"},{"id":"manas-2010:p0204:b001:l001","ordinal":8981,"en":"Blood poured out in streams."},{"id":"manas-2010:p0204:b001:l002","ordinal":8982,"en":"There was fierce slaughter now."},{"id":"manas-2010:p0204:b001:l003","ordinal":8983,"en":"Their giants Döngö and Zholoy,"},{"id":"manas-2010:p0204:b001:l004","ordinal":8984,"en":"Fire burning through their insides,"},{"id":"manas-2010:p0204:b001:l005","ordinal":8985,"en":"Unable to capture Manas,"},{"id":"manas-2010:p0204:b001:l006","ordinal":8986,"en":"Unable to return empty to their khan,"},{"id":"manas-2010:p0204:b001:l007","ordinal":8987,"en":"Unable to die of their shame,"},{"id":"manas-2010:p0204:b001:l008","ordinal":8988,"en":"Their bellowing split stone."},{"id":"manas-2010:p0204:b001:l009","ordinal":8989,"en":"Unable to return empty to their khan,"},{"id":"manas-2010:p0204:b001:l010","ordinal":8990,"en":"They raced along the flanks."},{"id":"manas-2010:p0204:b001:l011","ordinal":8991,"en":"Their black hair like hand-mallets,"},{"id":"manas-2010:p0204:b001:l012","ordinal":8992,"en":"From shame, these two"},{"id":"manas-2010:p0204:b001:l013","ordinal":8993,"en":"Tore out their hair and flung it away."},{"id":"manas-2010:p0204:b001:l014","ordinal":8994,"en":"Unable to stand against Manas,"},{"id":"manas-2010:p0204:b001:l015","ordinal":8995,"en":"The Manchus fled in jolting haste."},{"id":"manas-2010:p0204:b001:l016","ordinal":8996,"en":"From behind, the two giants"},{"id":"manas-2010:p0204:b001:l017","ordinal":8997,"en":"All the Manchus"},{"id":"manas-2010:p0204:b001:l018","ordinal":8998,"en":"Stopped again and beat back."},{"id":"manas-2010:p0204:b001:l019","ordinal":8999,"en":"All the people crowded together;"},{"id":"manas-2010:p0204:b001:l020","ordinal":9000,"en":"An empty waste opened between the two sides."},{"id":"manas-2010:p0204:b001:l021","ordinal":9001,"en":"All the wrestlers were slaughtered."},{"id":"manas-2010:p0204:b001:l022","ordinal":9002,"en":"Who could have known such wonders?"},{"id":"manas-2010:p0204:b001:l023","ordinal":9003,"en":"This was a newly arisen deed."},{"id":"manas-2010:p0204:b001:l024","ordinal":9004,"en":"Intrepid Manas the leopard"},{"id":"manas-2010:p0204:b001:l025","ordinal":9005,"en":"Brought great turmoil to the Chinese."},{"id":"manas-2010:p0204:b001:l026","ordinal":9006,"en":"Whoever saw it would have no regrets."},{"id":"manas-2010:p0204:b001:l027","ordinal":9007,"en":"While bloodthirsty Manas was there,"},{"id":"manas-2010:p0204:b001:l028","ordinal":9008,"en":"He brought great strife to the Kalmyks."},{"id":"manas-2010:p0204:b001:l029","ordinal":9009,"en":"Many strong wrestlers,"},{"id":"manas-2010:p0204:b001:l030","ordinal":9010,"en":"The gray-maned hero Manas,"},{"id":"manas-2010:p0204:b001:l031","ordinal":9011,"en":"Gathered saying “I shall bind him!”"},{"id":"manas-2010:p0204:b001:l032","ordinal":9012,"en":"Bind that dauntless one—how could they?"},{"id":"manas-2010:p0204:b001:l033","ordinal":9013,"en":"They themselves were slaughtered together."},{"id":"manas-2010:p0204:b001:l034","ordinal":9014,"en":"Their lords came and grew frantic."},{"id":"manas-2010:p0204:b001:l035","ordinal":9015,"en":"Coming with “I shall kill him,”"},{"id":"manas-2010:p0204:b001:l036","ordinal":9016,"en":"They scattered their own wealth."},{"id":"manas-2010:p0204:b001:l037","ordinal":9017,"en":"The heroes among their wrestlers,"},{"id":"manas-2010:p0204:b001:l038","ordinal":9018,"en":"The skillful among their spearmen,"},{"id":"manas-2010:p0204:b001:l039","ordinal":9019,"en":"Their experts who knew the enemy's means,"},{"id":"manas-2010:p0204:b001:l040","ordinal":9020,"en":"The heroes among their spearmen,"},{"id":"manas-2010:p0204:b001:l041","ordinal":9021,"en":"The resourceful warriors,"},{"id":"manas-2010:p0204:b001:l042","ordinal":9022,"en":"Wrestler Döngö and warrior Zholoy"},{"id":"manas-2010:p0204:b001:l043","ordinal":9023,"en":"Unleashed fierce wrath."},{"id":"manas-2010:p0204:b001:l044","ordinal":9024,"en":"Those who remained alive after the deaths,"},{"id":"manas-2010:p0204:b001:l045","ordinal":9025,"en":"The wrestlers they drove forward:"},{"id":"manas-2010:p0204:b001:l046","ordinal":9026,"en":"“From the fortune of sovereign rule,"},{"id":"manas-2010:p0204:b001:l047","ordinal":9027,"en":"From warrior Esenkan's throne,"},{"id":"manas-2010:p0204:b001:l048","ordinal":9028,"en":"Where are the mouths that made their boasts?"},{"id":"manas-2010:p0205:b001:l001","ordinal":9029,"en":"These were Esenkan's words:"},{"id":"manas-2010:p0205:b001:l002","ordinal":9030,"en":"‘Jakyp's son Manas—"},{"id":"manas-2010:p0205:b001:l003","ordinal":9031,"en":"Capture him and bring him here,’ he said."},{"id":"manas-2010:p0205:b001:l004","ordinal":9032,"en":"After letting him wreak such wonders,"},{"id":"manas-2010:p0205:b001:l005","ordinal":9033,"en":"After letting all our champions be slaughtered,"},{"id":"manas-2010:p0205:b001:l006","ordinal":9034,"en":"Saying, ‘We suffered horrors from the Burut;"},{"id":"manas-2010:p0205:b001:l007","ordinal":9035,"en":"We died when we met him face to face’—"},{"id":"manas-2010:p0205:b001:l008","ordinal":9036,"en":"How can we withdraw without dying?"},{"id":"manas-2010:p0205:b001:l009","ordinal":9037,"en":"To that stern and mighty king,"},{"id":"manas-2010:p0205:b001:l010","ordinal":9038,"en":"How can we speak without shame?"},{"id":"manas-2010:p0205:b001:l011","ordinal":9039,"en":"By these fucking Buruts"},{"id":"manas-2010:p0205:b001:l012","ordinal":9040,"en":"We are being slaughtered as we retreat."},{"id":"manas-2010:p0205:b001:l013","ordinal":9041,"en":"Until the soft kuray stalks ripen,"},{"id":"manas-2010:p0205:b001:l014","ordinal":9042,"en":"Until autumn gossamer takes flight,"},{"id":"manas-2010:p0205:b001:l015","ordinal":9043,"en":"Let us fight hard for six whole months;"},{"id":"manas-2010:p0205:b001:l016","ordinal":9044,"en":"Let us retreat only after a slaughter."},{"id":"manas-2010:p0205:b001:l017","ordinal":9045,"en":"These fucking Buruts—"},{"id":"manas-2010:p0205:b001:l018","ordinal":9046,"en":"Let us keep driving them out,"},{"id":"manas-2010:p0205:b001:l019","ordinal":9047,"en":"Chase them in terror,"},{"id":"manas-2010:p0205:b001:l020","ordinal":9048,"en":"And pen them where they seek refuge."},{"id":"manas-2010:p0205:b001:l021","ordinal":9049,"en":"Let us wreak boundless havoc."},{"id":"manas-2010:p0205:b001:l022","ordinal":9050,"en":"These fucking Buruts—"},{"id":"manas-2010:p0205:b001:l023","ordinal":9051,"en":"Let us surround and seize them."},{"id":"manas-2010:p0205:b001:l024","ordinal":9052,"en":"Let us follow hard upon their trail,"},{"id":"manas-2010:p0205:b001:l025","ordinal":9053,"en":"Pursue them doggedly to the end.”"},{"id":"manas-2010:p0205:b001:l026","ordinal":9054,"en":"The champion Zholoy roared,"},{"id":"manas-2010:p0205:b001:l027","ordinal":9055,"en":"Addressing them all."},{"id":"manas-2010:p0205:b001:l028","ordinal":9056,"en":"Zholoy spared them no abuse;"},{"id":"manas-2010:p0205:b001:l029","ordinal":9057,"en":"He drove the whole army on."},{"id":"manas-2010:p0205:b001:l030","ordinal":9058,"en":"Warrior Zholoy, from the army's rear,"},{"id":"manas-2010:p0205:b001:l031","ordinal":9059,"en":"Was driving them forward."},{"id":"manas-2010:p0205:b001:l032","ordinal":9060,"en":"The warrior seemed unwilling to spare anyone,"},{"id":"manas-2010:p0205:b001:l033","ordinal":9061,"en":"Flaring up in all his might."},{"id":"manas-2010:p0205:b001:l034","ordinal":9062,"en":"At the army's head was Great Döngö,"},{"id":"manas-2010:p0205:b001:l035","ordinal":9063,"en":"Whose speech no human understood."},{"id":"manas-2010:p0205:b001:l036","ordinal":9064,"en":"Far beyond Beijing,"},{"id":"manas-2010:p0205:b001:l037","ordinal":9065,"en":"There was a people called Sazangshang."},{"id":"manas-2010:p0205:b001:l038","ordinal":9066,"en":"His speech was unknown to men;"},{"id":"manas-2010:p0205:b001:l039","ordinal":9067,"en":"In his head was a single eye like a platter."},{"id":"manas-2010:p0205:b001:l040","ordinal":9068,"en":"His father was a raging Chinese brute;"},{"id":"manas-2010:p0205:b001:l041","ordinal":9069,"en":"Unable to understand human speech,"},{"id":"manas-2010:p0205:b001:l042","ordinal":9070,"en":"He was a beast-like swine."},{"id":"manas-2010:p0205:b001:l043","ordinal":9071,"en":"The hair at his nape stood bristling;"},{"id":"manas-2010:p0205:b001:l044","ordinal":9072,"en":"His anger rose, and he stood rigid,"},{"id":"manas-2010:p0205:b001:l045","ordinal":9073,"en":"Finding no one to grapple with."},{"id":"manas-2010:p0205:b001:l046","ordinal":9074,"en":"That infidel of mighty wrath"},{"id":"manas-2010:p0205:b001:l047","ordinal":9075,"en":"Was a warrior full of strength."},{"id":"manas-2010:p0205:b001:l048","ordinal":9076,"en":"In Beijing, seat of the Khakan,"},{"id":"manas-2010:p0206:b001:l001","ordinal":9077,"en":"They called him formidable Döngö."},{"id":"manas-2010:p0206:b001:l002","ordinal":9078,"en":"His guardian spirit was lofty, his name renowned."},{"id":"manas-2010:p0206:b001:l003","ordinal":9079,"en":"The surpassing champion, warrior Döngö,"},{"id":"manas-2010:p0206:b001:l004","ordinal":9080,"en":"Was a creature uniquely made."},{"id":"manas-2010:p0206:b001:l005","ordinal":9081,"en":"Raging, he grasped his banner;"},{"id":"manas-2010:p0206:b001:l006","ordinal":9082,"en":"The sight of him seized the heart."},{"id":"manas-2010:p0206:b001:l007","ordinal":9083,"en":"He looked like a towering mountain."},{"id":"manas-2010:p0206:b001:l008","ordinal":9084,"en":"When he roared in fury,"},{"id":"manas-2010:p0206:b001:l009","ordinal":9085,"en":"The gorge shook and thundered."},{"id":"manas-2010:p0206:b001:l010","ordinal":9086,"en":"Not merely Manas,"},{"id":"manas-2010:p0206:b001:l011","ordinal":9087,"en":"But the eighteen thousand worlds"},{"id":"manas-2010:p0206:b001:l012","ordinal":9088,"en":"He seemed ready to lay waste."},{"id":"manas-2010:p0206:b001:l013","ordinal":9089,"en":"Formidable Döngö surged forward;"},{"id":"manas-2010:p0206:b001:l014","ordinal":9090,"en":"The steam from his nostrils"},{"id":"manas-2010:p0206:b001:l015","ordinal":9091,"en":"Billowed like a little hide-smoking pit."},{"id":"manas-2010:p0206:b001:l016","ordinal":9092,"en":"As though struck by slaughter,"},{"id":"manas-2010:p0206:b001:l017","ordinal":9093,"en":"Behind him the Chinese army shrieked."},{"id":"manas-2010:p0206:b001:l018","ordinal":9094,"en":"No small host swept forward;"},{"id":"manas-2010:p0206:b001:l019","ordinal":9095,"en":"As the countless army approached with a roar,"},{"id":"manas-2010:p0206:b001:l020","ordinal":9096,"en":"Manas the lion, the generous hero,"},{"id":"manas-2010:p0206:b001:l021","ordinal":9097,"en":"To battle and slaughter the Chinese"},{"id":"manas-2010:p0206:b001:l022","ordinal":9098,"en":"Came there once again."},{"id":"manas-2010:p0206:b001:l023","ordinal":9099,"en":"Surging onward on Toruchaar,"},{"id":"manas-2010:p0206:b001:l024","ordinal":9100,"en":"Roaring in his fury,"},{"id":"manas-2010:p0206:b001:l025","ordinal":9101,"en":"The champions who came sweeping forward—"},{"id":"manas-2010:p0206:b001:l026","ordinal":9102,"en":"Blood-shedding Manas the leopard"},{"id":"manas-2010:p0206:b001:l027","ordinal":9103,"en":"Drove them back in disarray."},{"id":"manas-2010:p0206:b001:l028","ordinal":9104,"en":"If you looked at warrior Döngö,"},{"id":"manas-2010:p0206:b001:l029","ordinal":9105,"en":"He was straining forward on Kylküröng."},{"id":"manas-2010:p0206:b001:l030","ordinal":9106,"en":"From directly ahead, that accursed one,"},{"id":"manas-2010:p0206:b001:l031","ordinal":9107,"en":"To thrust a spear at Manas,"},{"id":"manas-2010:p0206:b001:l032","ordinal":9108,"en":"Had made himself ready."},{"id":"manas-2010:p0206:b001:l033","ordinal":9109,"en":"Setting all his weapons in place,"},{"id":"manas-2010:p0206:b001:l034","ordinal":9110,"en":"As though he would pass through slaughtering,"},{"id":"manas-2010:p0206:b001:l035","ordinal":9111,"en":"Wrath spread across his face."},{"id":"manas-2010:p0206:b001:l036","ordinal":9112,"en":"Pouring forth anger, he roared;"},{"id":"manas-2010:p0206:b001:l037","ordinal":9113,"en":"Before he had reached Manas,"},{"id":"manas-2010:p0206:b001:l038","ordinal":9114,"en":"He spoke as though he would devour him:"},{"id":"manas-2010:p0206:b001:l039","ordinal":9115,"en":"“Why did you slaughter the army?"},{"id":"manas-2010:p0206:b001:l040","ordinal":9116,"en":"When the order came from the great khan,"},{"id":"manas-2010:p0206:b001:l041","ordinal":9117,"en":"What did you do to the camel?"},{"id":"manas-2010:p0206:b001:l042","ordinal":9118,"en":"‘I will slaughter the Chinese’—"},{"id":"manas-2010:p0206:b001:l043","ordinal":9119,"en":"That is what you have been thinking."},{"id":"manas-2010:p0206:b001:l044","ordinal":9120,"en":"Among the battle-shouting Kalmyks,"},{"id":"manas-2010:p0206:b001:l045","ordinal":9121,"en":"You have grappled only with the weak;"},{"id":"manas-2010:p0206:b001:l046","ordinal":9122,"en":"You have merely been playing."},{"id":"manas-2010:p0206:b001:l047","ordinal":9123,"en":"You fucking, wretched Burut,"},{"id":"manas-2010:p0206:b001:l048","ordinal":9124,"en":"Today you have roused my fury."},{"id":"manas-2010:p0207:b001:l001","ordinal":9125,"en":"Today I will ruin your looks."},{"id":"manas-2010:p0207:b001:l002","ordinal":9126,"en":"My anger has risen; I stand unyielding."},{"id":"manas-2010:p0207:b001:l003","ordinal":9127,"en":"Today I will leave none of you unchallenged."},{"id":"manas-2010:p0207:b001:l004","ordinal":9128,"en":"Today I will do as I see fit;"},{"id":"manas-2010:p0207:b001:l005","ordinal":9129,"en":"I will slaughter you without sparing a single one!”"},{"id":"manas-2010:p0207:b001:l006","ordinal":9130,"en":"Thus Döngö thundered."},{"id":"manas-2010:p0207:b001:l007","ordinal":9131,"en":"The cudgel in his hand"},{"id":"manas-2010:p0207:b001:l008","ordinal":9132,"en":"Looked like a traveler's small tent."},{"id":"manas-2010:p0207:b001:l009","ordinal":9133,"en":"A helmet of blue iron"},{"id":"manas-2010:p0207:b001:l010","ordinal":9134,"en":"He had pulled down over his head."},{"id":"manas-2010:p0207:b001:l011","ordinal":9135,"en":"The instant he saw Manas,"},{"id":"manas-2010:p0207:b001:l012","ordinal":9136,"en":"He leveled his blue-steel spear at him."},{"id":"manas-2010:p0207:b001:l013","ordinal":9137,"en":"Lashing Kylküröng with his whip,"},{"id":"manas-2010:p0207:b001:l014","ordinal":9138,"en":"Without sparing his slender life,"},{"id":"manas-2010:p0207:b001:l015","ordinal":9139,"en":"His mouth opened like a ravine;"},{"id":"manas-2010:p0207:b001:l016","ordinal":9140,"en":"Fire poured from his mouth,"},{"id":"manas-2010:p0207:b001:l017","ordinal":9141,"en":"Spraying out in arm-thick streams."},{"id":"manas-2010:p0207:b001:l018","ordinal":9142,"en":"As though about to work some terrible deed,"},{"id":"manas-2010:p0207:b001:l019","ordinal":9143,"en":"His fearsome wonders on display,"},{"id":"manas-2010:p0207:b001:l020","ordinal":9144,"en":"Warrior Döngö from among the Chinese"},{"id":"manas-2010:p0207:b001:l021","ordinal":9145,"en":"Had broken away."},{"id":"manas-2010:p0207:b001:l022","ordinal":9146,"en":"He had come out for single combat."},{"id":"manas-2010:p0207:b001:l023","ordinal":9147,"en":"From the infidel's fury,"},{"id":"manas-2010:p0207:b001:l024","ordinal":9148,"en":"The earth split apart."},{"id":"manas-2010:p0207:b001:l025","ordinal":9149,"en":"The sight of him seized the heart."},{"id":"manas-2010:p0207:b001:l026","ordinal":9150,"en":"That heaving Döngö"},{"id":"manas-2010:p0207:b001:l027","ordinal":9151,"en":"Looked like a mountain's gray ridge."},{"id":"manas-2010:p0207:b001:l028","ordinal":9152,"en":"From behind Döngö,"},{"id":"manas-2010:p0207:b001:l029","ordinal":9153,"en":"The champions sweeping forward"},{"id":"manas-2010:p0207:b001:l030","ordinal":9154,"en":"Launched a mass assault."},{"id":"manas-2010:p0207:b001:l031","ordinal":9155,"en":"Lashing Kylküröng with his whip,"},{"id":"manas-2010:p0207:b001:l032","ordinal":9156,"en":"From among the Chinese,"},{"id":"manas-2010:p0207:b001:l033","ordinal":9157,"en":"Champion Döngö had broken away."},{"id":"manas-2010:p0207:b001:l034","ordinal":9158,"en":"His dread presence was unlike a mortal's;"},{"id":"manas-2010:p0207:b001:l035","ordinal":9159,"en":"Anyone who clashed with him"},{"id":"manas-2010:p0207:b001:l036","ordinal":9160,"en":"He seemed ready to leave dead."},{"id":"manas-2010:p0207:b001:l037","ordinal":9161,"en":"When he saw warrior Döngö,"},{"id":"manas-2010:p0207:b001:l038","ordinal":9162,"en":"Valiant Manas the leopard,"},{"id":"manas-2010:p0207:b001:l039","ordinal":9163,"en":"Upon his swift steed Toruchaar,"},{"id":"manas-2010:p0207:b001:l040","ordinal":9164,"en":"Laid on the whip without pause"},{"id":"manas-2010:p0207:b001:l041","ordinal":9165,"en":"And attacked the Chinese troublemaker."},{"id":"manas-2010:p0207:b001:l042","ordinal":9166,"en":"He turned Toruchaar's head;"},{"id":"manas-2010:p0207:b001:l043","ordinal":9167,"en":"At mountain-like Döngö,"},{"id":"manas-2010:p0207:b001:l044","ordinal":9168,"en":"Without hesitation, he leveled his spear."},{"id":"manas-2010:p0207:b001:l045","ordinal":9169,"en":"Your renowned lion Manas—"},{"id":"manas-2010:p0207:b001:l046","ordinal":9170,"en":"His valor was of quite another kind."},{"id":"manas-2010:p0207:b001:l047","ordinal":9171,"en":"Beijing, seat of the Khakan,"},{"id":"manas-2010:p0207:b001:l048","ordinal":9172,"en":"That fierce, marked warrior would wipe it out."},{"id":"manas-2010:p0208:b001:l001","ordinal":9173,"en":"When the bloodthirsty one fought,"},{"id":"manas-2010:p0208:b001:l002","ordinal":9174,"en":"It was the mild, cool autumn."},{"id":"manas-2010:p0208:b001:l003","ordinal":9175,"en":"Of the Black Kalmyks who challenged him,"},{"id":"manas-2010:p0208:b001:l004","ordinal":9176,"en":"Many were slaughtered;"},{"id":"manas-2010:p0208:b001:l005","ordinal":9177,"en":"Saying, ‘I will fight,’ they were laid flat."},{"id":"manas-2010:p0208:b001:l006","ordinal":9178,"en":"When he saw the hero Döngö,"},{"id":"manas-2010:p0208:b001:l007","ordinal":9179,"en":"He knew they would joust."},{"id":"manas-2010:p0208:b001:l008","ordinal":9180,"en":"Knowing it, your bloodthirsty one"},{"id":"manas-2010:p0208:b001:l009","ordinal":9181,"en":"Now smiled beneath his mustache."},{"id":"manas-2010:p0208:b001:l010","ordinal":9182,"en":"Never drawing back from death,"},{"id":"manas-2010:p0208:b001:l011","ordinal":9183,"en":"Manas never recoiling from his doom,"},{"id":"manas-2010:p0208:b001:l012","ordinal":9184,"en":"He turned Toruchaar's head."},{"id":"manas-2010:p0208:b001:l013","ordinal":9185,"en":"His wondrous iron, lacquered spear,"},{"id":"manas-2010:p0208:b001:l014","ordinal":9186,"en":"Straight at the hero Döngö,"},{"id":"manas-2010:p0208:b001:l015","ordinal":9187,"en":"He thrust it with a thunder."},{"id":"manas-2010:p0208:b001:l016","ordinal":9188,"en":"The valiant Sultan Manas's"},{"id":"manas-2010:p0208:b001:l017","ordinal":9189,"en":"Back was hunched behind him."},{"id":"manas-2010:p0208:b001:l018","ordinal":9190,"en":"His two darting eyes"},{"id":"manas-2010:p0208:b001:l019","ordinal":9191,"en":"Boiled like fire and bulged."},{"id":"manas-2010:p0208:b001:l020","ordinal":9192,"en":"His wrath appeared extraordinary."},{"id":"manas-2010:p0208:b001:l021","ordinal":9193,"en":"The hero beloved of God"},{"id":"manas-2010:p0208:b001:l022","ordinal":9194,"en":"Showed the fearful might of a lion."},{"id":"manas-2010:p0208:b001:l023","ordinal":9195,"en":"His wide eyes were like the morning star;"},{"id":"manas-2010:p0208:b001:l024","ordinal":9196,"en":"Do not ask of the generous one's menace."},{"id":"manas-2010:p0208:b001:l025","ordinal":9197,"en":"His white teeth were like a gate,"},{"id":"manas-2010:p0208:b001:l026","ordinal":9198,"en":"Now teeth unlike other people's;"},{"id":"manas-2010:p0208:b001:l027","ordinal":9199,"en":"They jutted out gleaming white."},{"id":"manas-2010:p0208:b001:l028","ordinal":9200,"en":"His thirst for blood had seized him firmly;"},{"id":"manas-2010:p0208:b001:l029","ordinal":9201,"en":"He had attacked Döngö."},{"id":"manas-2010:p0208:b001:l030","ordinal":9202,"en":"Toruchaar was a tulpar;"},{"id":"manas-2010:p0208:b001:l031","ordinal":9203,"en":"He lowered his head toward the ground"},{"id":"manas-2010:p0208:b001:l032","ordinal":9204,"en":"And took an extraordinary stride."},{"id":"manas-2010:p0208:b001:l033","ordinal":9205,"en":"The black stones he trod"},{"id":"manas-2010:p0208:b001:l034","ordinal":9206,"en":"Shattered into fragments."},{"id":"manas-2010:p0208:b001:l035","ordinal":9207,"en":"His clods, as large as traveling huts,"},{"id":"manas-2010:p0208:b001:l036","ordinal":9208,"en":"Whistled overhead."},{"id":"manas-2010:p0208:b001:l037","ordinal":9209,"en":"Tossing his forelock toward the sky,"},{"id":"manas-2010:p0208:b001:l038","ordinal":9210,"en":"The noble beast drove his hooves into the earth."},{"id":"manas-2010:p0208:b001:l039","ordinal":9211,"en":"Racing with flying birds,"},{"id":"manas-2010:p0208:b001:l040","ordinal":9212,"en":"With the white reins tied short,"},{"id":"manas-2010:p0208:b001:l041","ordinal":9213,"en":"Of the incomparable tulpar,"},{"id":"manas-2010:p0208:b001:l042","ordinal":9214,"en":"The leopard struggled against the horse’s mouth."},{"id":"manas-2010:p0208:b001:l043","ordinal":9215,"en":"Before one could say this or that,"},{"id":"manas-2010:p0208:b001:l044","ordinal":9216,"en":"Before an eye could blink,"}]
