[{"id":"semetey-1-2013:p0268:b004:l003","ordinal":97281,"en":"“Alas, my only one!” he said."},{"id":"semetey-1-2013:p0268:b004:l004","ordinal":97282,"en":"“A khan does not wrestle a wrestler."},{"id":"semetey-1-2013:p0268:b004:l005","ordinal":97283,"en":"What are you doing, my son?” he said."},{"id":"semetey-1-2013:p0268:b004:l006","ordinal":97284,"en":"“Your calves have not filled out."},{"id":"semetey-1-2013:p0268:b004:l007","ordinal":97285,"en":"Let me take your misfortune upon myself."},{"id":"semetey-1-2013:p0268:b004:l008","ordinal":97286,"en":"Your time to challenge has not yet come."},{"id":"semetey-1-2013:p0268:b004:l009","ordinal":97287,"en":"Your flanks have not filled out."},{"id":"semetey-1-2013:p0268:b004:l010","ordinal":97288,"en":"Your time to grapple has not yet come."},{"id":"semetey-1-2013:p0268:b004:l011","ordinal":97289,"en":"You are unformed as an egg."},{"id":"semetey-1-2013:p0268:b004:l012","ordinal":97290,"en":"You yourself are a boy of twelve."},{"id":"semetey-1-2013:p0268:b004:l013","ordinal":97291,"en":"Wrestling Toobalban,"},{"id":"semetey-1-2013:p0268:b004:l014","ordinal":97292,"en":"My foal, you will be shamed!"},{"id":"semetey-1-2013:p0268:b004:l015","ordinal":97293,"en":"You have not yet turned seventeen."},{"id":"semetey-1-2013:p0268:b004:l016","ordinal":97294,"en":"My foal, your time to clash has not yet come."},{"id":"semetey-1-2013:p0268:b004:l017","ordinal":97295,"en":"At twelve years old,"},{"id":"semetey-1-2013:p0268:b004:l018","ordinal":97296,"en":"Do not declare you will wrestle."},{"id":"semetey-1-2013:p0268:b004:l019","ordinal":97297,"en":"Do not bring shame upon yourself.”"},{"id":"semetey-1-2013:p0268:b004:l020","ordinal":97298,"en":"While his father stood saying this,"},{"id":"semetey-1-2013:p0268:b004:l021","ordinal":97299,"en":"The young goshawk Semetey,"},{"id":"semetey-1-2013:p0268:b004:l022","ordinal":97300,"en":"His eyes blazed like a lion's."},{"id":"semetey-1-2013:p0268:b004:l023","ordinal":97301,"en":"Your goshawk born of noble stock,"},{"id":"semetey-1-2013:p0268:b004:l024","ordinal":97302,"en":"His thirst for blood seized him."},{"id":"semetey-1-2013:p0268:b004:l025","ordinal":97303,"en":"He summoned fierce resolve."},{"id":"semetey-1-2013:p0268:b004:l026","ordinal":97304,"en":"His father who held him—"},{"id":"semetey-1-2013:p0268:b004:l028","ordinal":97305,"en":"“Alas, Father, what are you saying?","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0268:b004:l029","ordinal":97306,"en":"You are a wretched man."},{"id":"semetey-1-2013:p0268:b004:l030","ordinal":97307,"en":"You do not even look like a hare."},{"id":"semetey-1-2013:p0268:b004:l031","ordinal":97308,"en":"You are a worthless man!"},{"id":"semetey-1-2013:p0268:b004:l032","ordinal":97309,"en":"Like a black young ram,"},{"id":"semetey-1-2013:p0268:b004:l033","ordinal":97310,"en":"You bob about."},{"id":"semetey-1-2013:p0268:b004:l034","ordinal":97311,"en":"Like a male black crow,"},{"id":"semetey-1-2013:p0268:b004:l035","ordinal":97312,"en":"Foolish as you are,"},{"id":"semetey-1-2013:p0268:b004:l036","ordinal":97313,"en":"You hop about."},{"id":"semetey-1-2013:p0268:b004:l037","ordinal":97314,"en":"Making an omen of a single word,"},{"id":"semetey-1-2013:p0268:b004:l038","ordinal":97315,"en":"Do you take fright?"},{"id":"semetey-1-2013:p0268:b004:l039","ordinal":97316,"en":"Speaking words that would not tire a horse,"},{"id":"semetey-1-2013:p0269:b003:l001","ordinal":97317,"en":"You block my way!"},{"id":"semetey-1-2013:p0269:b003:l002","ordinal":97318,"en":"Think of these words, Father."},{"id":"semetey-1-2013:p0269:b003:l003","ordinal":97319,"en":"Whose honor has been lost?"},{"id":"semetey-1-2013:p0269:b003:l004","ordinal":97320,"en":"Do not babble, Father."},{"id":"semetey-1-2013:p0269:b003:l005","ordinal":97321,"en":"Whose honor has been won?"},{"id":"semetey-1-2013:p0269:b003:l006","ordinal":97322,"en":"Whose horn has been broken?"},{"id":"semetey-1-2013:p0269:b003:l007","ordinal":97323,"en":"Whose bones are aching?"},{"id":"semetey-1-2013:p0269:b003:l008","ordinal":97324,"en":"‘Bukhara has lost its livestock,"},{"id":"semetey-1-2013:p0269:b003:l009","ordinal":97325,"en":"It is utterly bare,’ will they not say?"},{"id":"semetey-1-2013:p0269:b003:l010","ordinal":97326,"en":"‘Not one young man defended his honor."},{"id":"semetey-1-2013:p0269:b003:l011","ordinal":97327,"en":"All the people of Bukhara"},{"id":"semetey-1-2013:p0269:b003:l012","ordinal":97328,"en":"Are women,’ will they not say?"},{"id":"semetey-1-2013:p0269:b003:l013","ordinal":97329,"en":"Over nothing, without cause,"},{"id":"semetey-1-2013:p0269:b003:l014","ordinal":97330,"en":"You take fright."},{"id":"semetey-1-2013:p0269:b003:l015","ordinal":97331,"en":"Speaking such very bad words,"},{"id":"semetey-1-2013:p0269:b003:l016","ordinal":97332,"en":"You block a man's way."},{"id":"semetey-1-2013:p0269:b003:l017","ordinal":97333,"en":"Does not a mortal creature die?"},{"id":"semetey-1-2013:p0269:b003:l018","ordinal":97334,"en":"What has been written for the life held in trust,"},{"id":"semetey-1-2013:p0269:b003:l019","ordinal":97335,"en":"Must not this poor entrusted soul experience?"},{"id":"semetey-1-2013:p0269:b003:l020","ordinal":97336,"en":"When Almighty Allah"},{"id":"semetey-1-2013:p0269:b003:l021","ordinal":97337,"en":"Gives His mighty command,"},{"id":"semetey-1-2013:p0269:b003:l022","ordinal":97338,"en":"The soul-taking angel Azrael,"},{"id":"semetey-1-2013:p0269:b003:l023","ordinal":97339,"en":"Stretching out his five fingers,"},{"id":"semetey-1-2013:p0269:b003:l024","ordinal":97340,"en":"Stands close to a mortal,"},{"id":"semetey-1-2013:p0269:b003:l025","ordinal":97341,"en":"The poor tongue is tied, unable to speak."},{"id":"semetey-1-2013:p0269:b003:l026","ordinal":97342,"en":"From this faithless world,"},{"id":"semetey-1-2013:p0269:b003:l027","ordinal":97343,"en":"Father, who can flee and escape?"},{"id":"semetey-1-2013:p0269:b003:l028","ordinal":97344,"en":"Speaking useless words without cause,"},{"id":"semetey-1-2013:p0269:b003:l029","ordinal":97345,"en":"You take fright."},{"id":"semetey-1-2013:p0269:b003:l030","ordinal":97346,"en":"Letting great honor be lost,"},{"id":"semetey-1-2013:p0269:b003:l031","ordinal":97347,"en":"You block my way.”"},{"id":"semetey-1-2013:p0269:b003:l032","ordinal":97348,"en":"Your gray-maned hero stood brooding:"},{"id":"semetey-1-2013:p0269:b003:l033","ordinal":97349,"en":"“Alas, my father Ismayyl,"},{"id":"semetey-1-2013:p0269:b003:l034","ordinal":97350,"en":"If I do not wrestle at twelve,"},{"id":"semetey-1-2013:p0269:b003:l035","ordinal":97351,"en":"When I reach thirty-five,"},{"id":"semetey-1-2013:p0269:b003:l036","ordinal":97352,"en":"Will I catch a tethered dog?"},{"id":"semetey-1-2013:p0269:b003:l037","ordinal":97353,"en":"If I do not wrestle at eleven,"},{"id":"semetey-1-2013:p0269:b003:l038","ordinal":97354,"en":"When I reach nineteen,"},{"id":"semetey-1-2013:p0269:b003:l039","ordinal":97355,"en":"Will my blow go through dung?"},{"id":"semetey-1-2013:p0269:b004:l001","ordinal":97356,"en":"Do not block my way, Father."},{"id":"semetey-1-2013:p0269:b004:l002","ordinal":97357,"en":"Let go of my hand, Father!”"},{"id":"semetey-1-2013:p0269:b004:l003","ordinal":97358,"en":"However much he spoke, he would not listen."},{"id":"semetey-1-2013:p0269:b004:l004","ordinal":97359,"en":"He humiliated the boy."},{"id":"semetey-1-2013:p0269:b004:l005","ordinal":97360,"en":"‘Do not wrestle,’ he kept blocking him,"},{"id":"semetey-1-2013:p0269:b004:l006","ordinal":97361,"en":"Using force against the boy."},{"id":"semetey-1-2013:p0269:b004:l007","ordinal":97362,"en":"Would he submit to that force?"},{"id":"semetey-1-2013:p0269:b004:l008","ordinal":97363,"en":"Would the boy surrender his equal standing?"},{"id":"semetey-1-2013:p0269:b004:l009","ordinal":97364,"en":"His father Ismayyl,"},{"id":"semetey-1-2013:p0269:b004:l010","ordinal":97365,"en":"He struck him squarely on the cheek,"},{"id":"semetey-1-2013:p0269:b004:l011","ordinal":97366,"en":"And shoved him away."},{"id":"semetey-1-2013:p0269:b004:l012","ordinal":97367,"en":"Like a felled log,"},{"id":"semetey-1-2013:p0269:b004:l013","ordinal":97368,"en":"Ismayyl fell sprawling."},{"id":"semetey-1-2013:p0269:b004:l014","ordinal":97369,"en":"Like a feedbag, jolting,"},{"id":"semetey-1-2013:p0269:b004:l015","ordinal":97370,"en":"Ismayyl fell down."},{"id":"semetey-1-2013:p0269:b004:l016","ordinal":97371,"en":"Breaking free from Ismayyl,"},{"id":"semetey-1-2013:p0269:b004:l017","ordinal":97372,"en":"Then the boy Semetey"},{"id":"semetey-1-2013:p0269:b004:l018","ordinal":97373,"en":"Shouted in anger,"},{"id":"semetey-1-2013:p0269:b004:l019","ordinal":97374,"en":"Calling Toobalban:"},{"id":"semetey-1-2013:p0269:b004:l020","ordinal":97375,"en":"“Turn your horse's head a moment."},{"id":"semetey-1-2013:p0269:b004:l021","ordinal":97376,"en":"By your father's grave, Toobalban,"},{"id":"semetey-1-2013:p0269:b004:l022","ordinal":97377,"en":"Stand out in front a moment!"},{"id":"semetey-1-2013:p0269:b004:l023","ordinal":97378,"en":"Throw me too before you leave."},{"id":"semetey-1-2013:p0269:b004:l024","ordinal":97379,"en":"If you are a mighty wrestler,"},{"id":"semetey-1-2013:p0269:b004:l025","ordinal":97380,"en":"Lay me out full length and go."},{"id":"semetey-1-2013:p0269:b004:l026","ordinal":97381,"en":"My treasury of vast wealth,"},{"id":"semetey-1-2013:p0269:b004:l027","ordinal":97382,"en":"I shall stake it all, leaving nothing out."},{"id":"semetey-1-2013:p0269:b004:l028","ordinal":97383,"en":"Take this along with you too!"},{"id":"semetey-1-2013:p0269:b004:l029","ordinal":97384,"en":"Sate yourself fully with prizes."},{"id":"semetey-1-2013:p0269:b004:l030","ordinal":97385,"en":"If it is too little, O wrestler,"},{"id":"semetey-1-2013:p0269:b004:l031","ordinal":97386,"en":"Let me stake my sovereignty."},{"id":"semetey-1-2013:p0269:b004:l032","ordinal":97387,"en":"Take this along with you too!"},{"id":"semetey-1-2013:p0269:b004:l033","ordinal":97388,"en":"Turn your neck a little."},{"id":"semetey-1-2013:p0269:b004:l034","ordinal":97389,"en":"I shall grapple, wrestler; wait!”"},{"id":"semetey-1-2013:p0269:b004:l035","ordinal":97390,"en":"When Semetey said this,"},{"id":"semetey-1-2013:p0269:b004:l036","ordinal":97391,"en":"Puffed up by having thrown his opponent,"},{"id":"semetey-1-2013:p0269:b004:l037","ordinal":97392,"en":"He stood to face the boy,"},{"id":"semetey-1-2013:p0269:b004:l038","ordinal":97393,"en":"That thoughtless Toobalban."},{"id":"semetey-1-2013:p0269:b004:l039","ordinal":97394,"en":"A curse struck the accursed man,"},{"id":"semetey-1-2013:p0270:b003:l001","ordinal":97395,"en":"Picking a quarrel with a lion favored by Kydyr,"},{"id":"semetey-1-2013:p0270:b003:l002","ordinal":97396,"en":"Faith struck the faith-cursed man."},{"id":"semetey-1-2013:p0270:b003:l003","ordinal":97397,"en":"“Agreed, agreed, agreed,” he said,"},{"id":"semetey-1-2013:p0270:b003:l004","ordinal":97398,"en":"Toobalban loomed with outspread limbs."},{"id":"semetey-1-2013:p0270:b003:l005","ordinal":97399,"en":"His leather-flask-like nose bobbing,"},{"id":"semetey-1-2013:p0270:b003:l006","ordinal":97400,"en":"Toobalban strutted about."},{"id":"semetey-1-2013:p0270:b003:l007","ordinal":97401,"en":"When he heard the boy's voice,"},{"id":"semetey-1-2013:p0270:b003:l008","ordinal":97402,"en":"His heart lay calm as ashes."},{"id":"semetey-1-2013:p0270:b003:l009","ordinal":97403,"en":"“This wretched boy,"},{"id":"semetey-1-2013:p0270:b003:l010","ordinal":97404,"en":"Let me seize and dash him to the ground."},{"id":"semetey-1-2013:p0270:b003:l011","ordinal":97405,"en":"God willing, the golden throne,"},{"id":"semetey-1-2013:p0270:b003:l012","ordinal":97406,"en":"Let me seize it now."},{"id":"semetey-1-2013:p0270:b003:l013","ordinal":97407,"en":"Let me slaughter him while he is young."},{"id":"semetey-1-2013:p0270:b003:l014","ordinal":97408,"en":"Let me put the wretch to death."},{"id":"semetey-1-2013:p0270:b003:l015","ordinal":97409,"en":"While the boy is young,"},{"id":"semetey-1-2013:p0270:b003:l016","ordinal":97410,"en":"Let me sate myself fully on his liver."},{"id":"semetey-1-2013:p0270:b003:l017","ordinal":97411,"en":"The golden throne he sits upon,"},{"id":"semetey-1-2013:p0270:b003:l018","ordinal":97412,"en":"Let me seize it now."},{"id":"semetey-1-2013:p0270:b003:l019","ordinal":97413,"en":"The twelve-year-old orphan,"},{"id":"semetey-1-2013:p0270:b003:l020","ordinal":97414,"en":"Let me put him to death."},{"id":"semetey-1-2013:p0270:b003:l021","ordinal":97415,"en":"Countless treasures and innumerable livestock,"},{"id":"semetey-1-2013:p0270:b003:l022","ordinal":97416,"en":"Let me wrest them from the boy."},{"id":"semetey-1-2013:p0270:b003:l023","ordinal":97417,"en":"The Six Cities and the khan of Kokand,"},{"id":"semetey-1-2013:p0270:b003:l024","ordinal":97418,"en":"God willing, just wait,"},{"id":"semetey-1-2013:p0270:b003:l025","ordinal":97419,"en":"Let me bring them abundant prizes.”"},{"id":"semetey-1-2013:p0270:b003:l026","ordinal":97420,"en":"Thinking these words,"},{"id":"semetey-1-2013:p0270:b003:l027","ordinal":97421,"en":"Toobalban stood to face him."},{"id":"semetey-1-2013:p0270:b003:l028","ordinal":97422,"en":"As though he would suck the boy dry,"},{"id":"semetey-1-2013:p0270:b003:l029","ordinal":97423,"en":"Toobalban came and stood."},{"id":"semetey-1-2013:p0270:b003:l030","ordinal":97424,"en":"The brave only son left by the lord,"},{"id":"semetey-1-2013:p0270:b003:l031","ordinal":97425,"en":"Semetey left by the lord,"},{"id":"semetey-1-2013:p0270:b003:l032","ordinal":97426,"en":"Setting these words out clearly,"},{"id":"semetey-1-2013:p0270:b003:l033","ordinal":97427,"en":"Made a firm promise:"},{"id":"semetey-1-2013:p0270:b003:l034","ordinal":97428,"en":"“By your father's grave, Toobalban,"},{"id":"semetey-1-2013:p0270:b003:l035","ordinal":97429,"en":"Make your promise firm."},{"id":"semetey-1-2013:p0270:b003:l036","ordinal":97430,"en":"Swear an oath invoking God."},{"id":"semetey-1-2013:p0270:b003:l037","ordinal":97431,"en":"If in the wrestlers' contest"},{"id":"semetey-1-2013:p0270:b003:l038","ordinal":97432,"en":"You manage to throw me,"},{"id":"semetey-1-2013:p0270:b003:l039","ordinal":97433,"en":"I shall agree to what you say."},{"id":"semetey-1-2013:p0270:b004:l001","ordinal":97434,"en":"The great gated city of Bukhara,"},{"id":"semetey-1-2013:p0270:b004:l002","ordinal":97435,"en":"However many people dwell there,"},{"id":"semetey-1-2013:p0270:b004:l003","ordinal":97436,"en":"I shall give them with their cream undisturbed."},{"id":"semetey-1-2013:p0270:b004:l004","ordinal":97437,"en":"If you throw me and go,"},{"id":"semetey-1-2013:p0270:b004:l005","ordinal":97438,"en":"I shall proclaim it to my people."},{"id":"semetey-1-2013:p0270:b004:l006","ordinal":97439,"en":"Putting my golden crown on you,"},{"id":"semetey-1-2013:p0270:b004:l007","ordinal":97440,"en":"Seating you on the golden throne,"},{"id":"semetey-1-2013:p0270:b004:l008","ordinal":97441,"en":"This multitude of Bukhara,"},{"id":"semetey-1-2013:p0270:b004:l009","ordinal":97442,"en":"Letting you rule them without their stirring,"},{"id":"semetey-1-2013:p0270:b004:l010","ordinal":97443,"en":"The golden throne I mounted yesterday,"},{"id":"semetey-1-2013:p0270:b004:l011","ordinal":97444,"en":"Seating you upon that throne,"},{"id":"semetey-1-2013:p0270:b004:l012","ordinal":97445,"en":"I shall raise you as khan."},{"id":"semetey-1-2013:p0270:b004:l013","ordinal":97446,"en":"If by chance I throw you,"},{"id":"semetey-1-2013:p0270:b004:l014","ordinal":97447,"en":"Without leaving you alive,"},{"id":"semetey-1-2013:p0270:b004:l015","ordinal":97448,"en":"I shall offer you as a sacrifice."},{"id":"semetey-1-2013:p0270:b004:l016","ordinal":97449,"en":"If I throw you,"},{"id":"semetey-1-2013:p0270:b004:l017","ordinal":97450,"en":"I shall tear apart your ribs,"},{"id":"semetey-1-2013:p0270:b004:l018","ordinal":97451,"en":"Pour out your blood like water."},{"id":"semetey-1-2013:p0270:b004:l019","ordinal":97452,"en":"I shall offer you as a sacrifice."},{"id":"semetey-1-2013:p0270:b004:l020","ordinal":97453,"en":"Whether you die or not,"},{"id":"semetey-1-2013:p0270:b004:l021","ordinal":97454,"en":"I shall tear out your arm!"},{"id":"semetey-1-2013:p0270:b004:l022","ordinal":97455,"en":"Wrestler, I have staked so much livestock;"},{"id":"semetey-1-2013:p0270:b004:l024","ordinal":97456,"en":"Will you, wrestler, stake your life?"},{"id":"semetey-1-2013:p0270:b004:l025","ordinal":97457,"en":"I have staked my golden throne;"},{"id":"semetey-1-2013:p0270:b004:l026","ordinal":97458,"en":"My wrestler, will you stake your life?”"},{"id":"semetey-1-2013:p0270:b004:l027","ordinal":97459,"en":"When Semetey said this,"},{"id":"semetey-1-2013:p0270:b004:l028","ordinal":97460,"en":"A curse struck the accursed man."},{"id":"semetey-1-2013:p0270:b004:l029","ordinal":97461,"en":"Death drove him, a demon struck him."},{"id":"semetey-1-2013:p0270:b004:l030","ordinal":97462,"en":"“Agreed, agreed, agreed,” he said."},{"id":"semetey-1-2013:p0270:b004:l031","ordinal":97463,"en":"“Agreed, good, hero,” he said."},{"id":"semetey-1-2013:p0270:b004:l032","ordinal":97464,"en":"“If I begrudge you my blood,"},{"id":"semetey-1-2013:p0270:b004:l033","ordinal":97465,"en":"May our seven forefathers be unbelievers!”"},{"id":"semetey-1-2013:p0270:b004:l034","ordinal":97466,"en":"Looking to either side,"},{"id":"semetey-1-2013:p0270:b004:l035","ordinal":97467,"en":"Licking his lips and nose,"},{"id":"semetey-1-2013:p0270:b004:l036","ordinal":97468,"en":"Toobalban came up."},{"id":"semetey-1-2013:p0270:b004:l037","ordinal":97469,"en":"When Toobalban came close,"},{"id":"semetey-1-2013:p0270:b004:l038","ordinal":97470,"en":"The lord's son Semetey,"},{"id":"semetey-1-2013:p0270:b004:l039","ordinal":97471,"en":"Knowing they would wrestle,"},{"id":"semetey-1-2013:p0271:b003:l001","ordinal":97472,"en":"“Well done, Toobalban!"},{"id":"semetey-1-2013:p0271:b003:l002","ordinal":97473,"en":"I shall agree to what you say."},{"id":"semetey-1-2013:p0271:b003:l003","ordinal":97474,"en":"Whatever may happen, my wrestler,"},{"id":"semetey-1-2013:p0271:b003:l004","ordinal":97475,"en":"I shall give you the first turn."},{"id":"semetey-1-2013:p0271:b003:l005","ordinal":97476,"en":"If I do not give you your turn,"},{"id":"semetey-1-2013:p0271:b003:l006","ordinal":97477,"en":"Shoeing your white-gray horse,"},{"id":"semetey-1-2013:p0271:b003:l007","ordinal":97478,"en":"On the coming Day of Judgment,"},{"id":"semetey-1-2013:p0271:b003:l008","ordinal":97479,"en":"Do not disgrace me,"},{"id":"semetey-1-2013:p0271:b003:l009","ordinal":97480,"en":"Grabbing my collar to demand your blood-debt."},{"id":"semetey-1-2013:p0271:b003:l010","ordinal":97481,"en":"Take whatever hold you like, wrestler."},{"id":"semetey-1-2013:p0271:b003:l011","ordinal":97482,"en":"Without sparing your skill,"},{"id":"semetey-1-2013:p0271:b003:l012","ordinal":97483,"en":"Use it to the utmost against me, wrestler!"},{"id":"semetey-1-2013:p0271:b003:l013","ordinal":97484,"en":"If you hold back this time,"},{"id":"semetey-1-2013:p0271:b003:l015","ordinal":97485,"en":"Shouting in anger,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0271:b003:l016","ordinal":97486,"en":"When Toobalban came close,"},{"id":"semetey-1-2013:p0271:b003:l017","ordinal":97487,"en":"The lord's son Semetey"},{"id":"semetey-1-2013:p0271:b003:l018","ordinal":97488,"en":"Held out his forearm."},{"id":"semetey-1-2013:p0271:b003:l019","ordinal":97489,"en":"The wrestler took his forearm,"},{"id":"semetey-1-2013:p0271:b003:l020","ordinal":97490,"en":"Applying all the strength he had."},{"id":"semetey-1-2013:p0271:b003:l021","ordinal":97491,"en":"He was a lion touched by Kydyr."},{"id":"semetey-1-2013:p0271:b003:l022","ordinal":97492,"en":"From Toobalban, his forearm,"},{"id":"semetey-1-2013:p0271:b003:l023","ordinal":97493,"en":"He pulled it free without a flinch."},{"id":"semetey-1-2013:p0271:b003:l024","ordinal":97494,"en":"Toobalban held out his forearm."},{"id":"semetey-1-2013:p0271:b003:l025","ordinal":97495,"en":"Now sit and watch"},{"id":"semetey-1-2013:p0271:b003:l026","ordinal":97496,"en":"Semetey's fearful might."},{"id":"semetey-1-2013:p0271:b003:l027","ordinal":97497,"en":"He grasped it firmly,"},{"id":"semetey-1-2013:p0271:b003:l028","ordinal":97498,"en":"Your terror, son of the Blood-Drinker,"},{"id":"semetey-1-2013:p0271:b003:l029","ordinal":97499,"en":"Applied great strength."},{"id":"semetey-1-2013:p0271:b003:l030","ordinal":97500,"en":"Toobalban's forearm,"},{"id":"semetey-1-2013:p0271:b003:l031","ordinal":97501,"en":"He took it in a hard grip."},{"id":"semetey-1-2013:p0271:b003:l032","ordinal":97502,"en":"The boy's right limbs,"},{"id":"semetey-1-2013:p0271:b003:l033","ordinal":97503,"en":"Did you see how evenly they were formed?"},{"id":"semetey-1-2013:p0271:b003:l034","ordinal":97504,"en":"Semetey, born of the destroyer,"},{"id":"semetey-1-2013:p0271:b003:l035","ordinal":97505,"en":"Did you see that he was a lion?"},{"id":"semetey-1-2013:p0271:b003:l036","ordinal":97506,"en":"Trying to jerk, unable to jerk free,"},{"id":"semetey-1-2013:p0271:b003:l037","ordinal":97507,"en":"Toobalban whispered."},{"id":"semetey-1-2013:p0271:b003:l038","ordinal":97508,"en":"Trying to wrench, unable to wrench free,"},{"id":"semetey-1-2013:p0271:b003:l039","ordinal":97509,"en":"Toobalban struggled."},{"id":"semetey-1-2013:p0271:b004:l001","ordinal":97510,"en":"Though he died, there would be no regret;"},{"id":"semetey-1-2013:p0271:b004:l002","ordinal":97511,"en":"Toobalban did not pull his forearm free."},{"id":"semetey-1-2013:p0271:b004:l003","ordinal":97512,"en":"Struggling this way and that,"},{"id":"semetey-1-2013:p0271:b004:l004","ordinal":97513,"en":"Toobalban shuffled about."},{"id":"semetey-1-2013:p0271:b004:l005","ordinal":97514,"en":"Dark blood, a mare-milking's worth,"},{"id":"semetey-1-2013:p0271:b004:l006","ordinal":97515,"en":"When your hero gripped hard,"},{"id":"semetey-1-2013:p0271:b004:l007","ordinal":97516,"en":"From the tips of his five fingers,"},{"id":"semetey-1-2013:p0271:b004:l008","ordinal":97517,"en":"Streamed as though he were pissing."},{"id":"semetey-1-2013:p0271:b004:l009","ordinal":97518,"en":"“Ay-hay! Ay-hay! Ay-hay!” he cried,"},{"id":"semetey-1-2013:p0271:b004:l010","ordinal":97519,"en":"Saying nothing else."},{"id":"semetey-1-2013:p0271:b004:l011","ordinal":97520,"en":"He did not heed his cries."},{"id":"semetey-1-2013:p0271:b004:l012","ordinal":97521,"en":"He did not let go of his forearm."},{"id":"semetey-1-2013:p0271:b004:l013","ordinal":97522,"en":"Seized by a fit of rage, unable to stay still,"},{"id":"semetey-1-2013:p0271:b004:l014","ordinal":97523,"en":"The offspring of the Blood-Drinker"},{"id":"semetey-1-2013:p0271:b004:l015","ordinal":97524,"en":"Gripped him again,"},{"id":"semetey-1-2013:p0271:b004:l016","ordinal":97525,"en":"Clamping down firmly once more,"},{"id":"semetey-1-2013:p0271:b004:l017","ordinal":97526,"en":"He took a hard grip."},{"id":"semetey-1-2013:p0271:b004:l018","ordinal":97527,"en":"The tongue did not remain silent."},{"id":"semetey-1-2013:p0271:b004:l019","ordinal":97528,"en":"When he gripped again,"},{"id":"semetey-1-2013:p0271:b004:l020","ordinal":97529,"en":"The muscles of his forearm,"},{"id":"semetey-1-2013:p0271:b004:l021","ordinal":97530,"en":"The farther forearm, the solid bone,"},{"id":"semetey-1-2013:p0271:b004:l022","ordinal":97531,"en":"Crumbled into fragments."},{"id":"semetey-1-2013:p0271:b004:l023","ordinal":97532,"en":"The Six Cities, the khan of Kokand,"},{"id":"semetey-1-2013:p0271:b004:l024","ordinal":97533,"en":"Andijan behind,"},{"id":"semetey-1-2013:p0271:b004:l025","ordinal":97534,"en":"Margalang at the side,"},{"id":"semetey-1-2013:p0271:b004:l026","ordinal":97535,"en":"Samarkand before their eyes,"},{"id":"semetey-1-2013:p0271:b004:l027","ordinal":97536,"en":"The eight khans who came to the feast,"}]
