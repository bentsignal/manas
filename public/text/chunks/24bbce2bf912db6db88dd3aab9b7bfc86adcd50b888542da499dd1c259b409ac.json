[{"id":"semetey-1-2013:p0147:b003:l031","ordinal":88065,"en":"Shall lead him with me and make him a hero,"},{"id":"semetey-1-2013:p0147:b003:l032","ordinal":88066,"en":"Make him equal to the sons of warriors,"},{"id":"semetey-1-2013:p0147:b003:l033","ordinal":88067,"en":"To the leopard, gray-maned Manas,"},{"id":"semetey-1-2013:p0147:b003:l034","ordinal":88068,"en":"I shall make him equal in every way."},{"id":"semetey-1-2013:p0147:b003:l035","ordinal":88069,"en":"I shall help gird his waist firmly;"},{"id":"semetey-1-2013:p0147:b003:l036","ordinal":88070,"en":"From the Kara-Khitai in Beijing"},{"id":"semetey-1-2013:p0147:b003:l037","ordinal":88071,"en":"I shall seek the blood-price of the valiant one."},{"id":"semetey-1-2013:p0147:b003:l038","ordinal":88072,"en":"If my orphan comes safely,"},{"id":"semetey-1-2013:p0147:b003:l039","ordinal":88073,"en":"I shall set the grassy land afire,"},{"id":"semetey-1-2013:p0147:b005:l001","ordinal":88074,"en":"I shall pour blood into the running water,"},{"id":"semetey-1-2013:p0147:b005:l002","ordinal":88075,"en":"Make the people accept his words."},{"id":"semetey-1-2013:p0147:b005:l003","ordinal":88076,"en":"If my orphan survives,"},{"id":"semetey-1-2013:p0147:b005:l004","ordinal":88077,"en":"I shall make him a mighty fortress for the people."},{"id":"semetey-1-2013:p0147:b005:l005","ordinal":88078,"en":"The poor orphan child,"},{"id":"semetey-1-2013:p0147:b005:l006","ordinal":88079,"en":"If God lets him see Talas,"},{"id":"semetey-1-2013:p0147:b005:l007","ordinal":88080,"en":"I shall place my golden crown upon him."},{"id":"semetey-1-2013:p0147:b005:l008","ordinal":88081,"en":"If the orphan survives,"},{"id":"semetey-1-2013:p0147:b005:l009","ordinal":88082,"en":"I shall seat him on a golden throne."},{"id":"semetey-1-2013:p0147:b005:l010","ordinal":88083,"en":"If his orphan comes safely,"},{"id":"semetey-1-2013:p0147:b005:l011","ordinal":88084,"en":"Bakai will have seen his day."},{"id":"semetey-1-2013:p0147:b005:l012","ordinal":88085,"en":"If the orphan does not come safely,"},{"id":"semetey-1-2013:p0147:b005:l013","ordinal":88086,"en":"King Bakai will be dead!"},{"id":"semetey-1-2013:p0147:b005:l014","ordinal":88087,"en":"If Semetey comes safely,"},{"id":"semetey-1-2013:p0147:b005:l015","ordinal":88088,"en":"Bakai will remain in joy."},{"id":"semetey-1-2013:p0147:b005:l016","ordinal":88089,"en":"If Kanykei is delayed,"},{"id":"semetey-1-2013:p0147:b005:l017","ordinal":88090,"en":"God will have struck Bakai down!"},{"id":"semetey-1-2013:p0147:b005:l018","ordinal":88091,"en":"Until you return safely,"},{"id":"semetey-1-2013:p0147:b005:l019","ordinal":88092,"en":"Until you see the old man,"},{"id":"semetey-1-2013:p0147:b005:l020","ordinal":88093,"en":"I, the noble leopard Bakai,"},{"id":"semetey-1-2013:p0147:b005:l021","ordinal":88094,"en":"Shall fare by herding camels,"},{"id":"semetey-1-2013:p0147:b005:l022","ordinal":88095,"en":"A goatskin coat upon my body,"},{"id":"semetey-1-2013:p0147:b005:l023","ordinal":88096,"en":"Leather trousers upon my backside;"},{"id":"semetey-1-2013:p0147:b005:l024","ordinal":88097,"en":"I shall bear a lowly name!”"},{"id":"semetey-1-2013:p0147:b005:l025","ordinal":88098,"en":"Mighty Bakai wept in sorrow."},{"id":"semetey-1-2013:p0147:b005:l026","ordinal":88099,"en":"It was God's decree;"},{"id":"semetey-1-2013:p0147:b005:l027","ordinal":88100,"en":"He submitted to that word now."},{"id":"semetey-1-2013:p0147:b005:l028","ordinal":88101,"en":"When the leopard Manas had died,"},{"id":"semetey-1-2013:p0147:b005:l029","ordinal":88102,"en":"When his wretched life had known sorrow,"},{"id":"semetey-1-2013:p0147:b005:l030","ordinal":88103,"en":"It had been a famed swift horse,"},{"id":"semetey-1-2013:p0147:b005:l031","ordinal":88104,"en":"Which Koshoi, khan of the Katagan,"},{"id":"semetey-1-2013:p0147:b005:l032","ordinal":88105,"en":"Had given in mourning."},{"id":"semetey-1-2013:p0147:b005:l033","ordinal":88106,"en":"“My orphan and my widow,"},{"id":"semetey-1-2013:p0147:b005:l034","ordinal":88107,"en":"If they journey far away,"},{"id":"semetey-1-2013:p0147:b005:l035","ordinal":88108,"en":"Let them ride it openly,”"},{"id":"semetey-1-2013:p0147:b005:l036","ordinal":88109,"en":"Such had been my wish."},{"id":"semetey-1-2013:p0147:b005:l037","ordinal":88110,"en":"“God has granted my wish,” said"},{"id":"semetey-1-2013:p0147:b005:l038","ordinal":88111,"en":"The aged, old Bakai."},{"id":"semetey-1-2013:p0147:b005:l039","ordinal":88112,"en":"(However far he had journeyed,"},{"id":"semetey-1-2013:p0148:b003:l001","ordinal":88113,"en":"He was a resourceful saint.)"},{"id":"semetey-1-2013:p0148:b003:l002","ordinal":88114,"en":"Of the noble steed Taitoru,"},{"id":"semetey-1-2013:p0148:b003:l003","ordinal":88115,"en":"He tightened the rear belly-girth firmly."},{"id":"semetey-1-2013:p0148:b003:l004","ordinal":88116,"en":"Of the spirit-like steed,"},{"id":"semetey-1-2013:p0148:b003:l005","ordinal":88117,"en":"He lengthened the crupper."},{"id":"semetey-1-2013:p0148:b003:l006","ordinal":88118,"en":"King Bakai, the noble lion,"},{"id":"semetey-1-2013:p0148:b003:l007","ordinal":88119,"en":"Fastened the saddle-girth,"},{"id":"semetey-1-2013:p0148:b003:l008","ordinal":88120,"en":"And all the equipment he possessed"},{"id":"semetey-1-2013:p0148:b003:l009","ordinal":88121,"en":"He had fitted upon Taitoru."},{"id":"semetey-1-2013:p0148:b003:l010","ordinal":88122,"en":"With an easy ambling gait, gentle to ride,"},{"id":"semetey-1-2013:p0148:b003:l011","ordinal":88123,"en":"Akborchuk was good for the road."},{"id":"semetey-1-2013:p0148:b003:l012","ordinal":88124,"en":"Grieving and weeping bitterly,"},{"id":"semetey-1-2013:p0148:b003:l013","ordinal":88125,"en":"In her old age,"},{"id":"semetey-1-2013:p0148:b003:l014","ordinal":88126,"en":"He set it aside for his mother Chyiyrdy."},{"id":"semetey-1-2013:p0148:b003:l015","ordinal":88127,"en":"“If she rides Akborchuk on her journey,"},{"id":"semetey-1-2013:p0148:b003:l016","ordinal":88128,"en":"May she attain her wish,” he thought."},{"id":"semetey-1-2013:p0148:b003:l017","ordinal":88129,"en":"“The orphan left by the gray-maned hero,"},{"id":"semetey-1-2013:p0148:b003:l018","ordinal":88130,"en":"May Chyiyrdy, safe and sound,"},{"id":"semetey-1-2013:p0148:b003:l019","ordinal":88131,"en":"Carry him away in flight,” he thought."},{"id":"semetey-1-2013:p0148:b003:l020","ordinal":88132,"en":"Old Bakai the lion,"},{"id":"semetey-1-2013:p0148:b003:l021","ordinal":88133,"en":"The saint who had seen so much,"},{"id":"semetey-1-2013:p0148:b003:l022","ordinal":88134,"en":"When he went in search of provisions,"},{"id":"semetey-1-2013:p0148:b003:l023","ordinal":88135,"en":"Merciless trouble—"},{"id":"semetey-1-2013:p0148:b003:l024","ordinal":88136,"en":"Had he not brought it?"},{"id":"semetey-1-2013:p0148:b003:l025","ordinal":88137,"en":"Akborchuk, expressly"},{"id":"semetey-1-2013:p0148:b003:l026","ordinal":88138,"en":"For his poor mother to ride,"},{"id":"semetey-1-2013:p0148:b003:l027","ordinal":88139,"en":"Had he not brought it?"},{"id":"semetey-1-2013:p0148:b003:l028","ordinal":88140,"en":"Akborchuk, whom his mother would ride,"},{"id":"semetey-1-2013:p0148:b003:l029","ordinal":88141,"en":"Had its girth fastened."},{"id":"semetey-1-2013:p0148:b003:l030","ordinal":88142,"en":"Beneath its bridle"},{"id":"semetey-1-2013:p0148:b003:l031","ordinal":88143,"en":"Was a white halter tied in the okoro knot,"},{"id":"semetey-1-2013:p0148:b003:l032","ordinal":88144,"en":"Suitable for a journey,"},{"id":"semetey-1-2013:p0148:b003:l033","ordinal":88145,"en":"A halter that fitted Akborchuk."},{"id":"semetey-1-2013:p0148:b003:l034","ordinal":88146,"en":"The valiant old Bakai,"},{"id":"semetey-1-2013:p0148:b003:l035","ordinal":88147,"en":"Showing his gray-maned valor,"},{"id":"semetey-1-2013:p0148:b003:l036","ordinal":88148,"en":"Speaking words of farewell,"},{"id":"semetey-1-2013:p0148:b003:l037","ordinal":88149,"en":"His heart burning fiercely,"},{"id":"semetey-1-2013:p0148:b003:l038","ordinal":88150,"en":"Acting as a father to them both,"},{"id":"semetey-1-2013:p0148:b003:l039","ordinal":88151,"en":"Had brought two winged steeds."},{"id":"semetey-1-2013:p0148:b004:l001","ordinal":88152,"en":"From his mother Chyiyrdy"},{"id":"semetey-1-2013:p0148:b004:l002","ordinal":88153,"en":"Bakai now received a blessing."},{"id":"semetey-1-2013:p0148:b004:l003","ordinal":88154,"en":"The wretched fugitive's"},{"id":"semetey-1-2013:p0148:b004:l004","ordinal":88155,"en":"Widowhood he had seen."},{"id":"semetey-1-2013:p0148:b004:l005","ordinal":88156,"en":"Taitoru and Akborchuk"},{"id":"semetey-1-2013:p0148:b004:l006","ordinal":88157,"en":"To the two fleeing ladies"},{"id":"semetey-1-2013:p0148:b004:l007","ordinal":88158,"en":"He gave as gifts."},{"id":"semetey-1-2013:p0148:b004:l008","ordinal":88159,"en":"That hero of yours, Bakai,"},{"id":"semetey-1-2013:p0148:b004:l009","ordinal":88160,"en":"Had invoked Baabedin."},{"id":"semetey-1-2013:p0148:b004:l010","ordinal":88161,"en":"“My orphan left by Manas,"},{"id":"semetey-1-2013:p0148:b004:l011","ordinal":88162,"en":"Let him take it as provisions;"},{"id":"semetey-1-2013:p0148:b004:l012","ordinal":88163,"en":"Let him attain his wish,” he had said,"},{"id":"semetey-1-2013:p0148:b004:l013","ordinal":88164,"en":"And brought back a two-year-old wether."},{"id":"semetey-1-2013:p0148:b004:l014","ordinal":88165,"en":"The brown wether he had brought—"},{"id":"semetey-1-2013:p0148:b004:l015","ordinal":88166,"en":"Fortunate Bakai and Kanykei,"},{"id":"semetey-1-2013:p0148:b004:l016","ordinal":88167,"en":"For their companion Manas,"},{"id":"semetey-1-2013:p0148:b004:l017","ordinal":88168,"en":"Recited the Quran."},{"id":"semetey-1-2013:p0148:b004:l018","ordinal":88169,"en":"Invoking Baabedin, the wether"},{"id":"semetey-1-2013:p0148:b004:l019","ordinal":88170,"en":"They vowed to God and slaughtered."},{"id":"semetey-1-2013:p0148:b004:l020","ordinal":88171,"en":"They prepared the traveling cauldron;"},{"id":"semetey-1-2013:p0148:b004:l021","ordinal":88172,"en":"Intestines and stomach, lungs and liver,"},{"id":"semetey-1-2013:p0148:b004:l022","ordinal":88173,"en":"They put them in, leaving nothing out."},{"id":"semetey-1-2013:p0148:b004:l023","ordinal":88174,"en":"Tender fat meat and the sweet head,"},{"id":"semetey-1-2013:p0148:b004:l024","ordinal":88175,"en":"To take along as provisions,"},{"id":"semetey-1-2013:p0148:b004:l025","ordinal":88176,"en":"The poor souls boiled vigorously."},{"id":"semetey-1-2013:p0148:b004:l026","ordinal":88177,"en":"“Until they reach the walled city of Bukhara"},{"id":"semetey-1-2013:p0148:b004:l027","ordinal":88178,"en":"In their flight,"},{"id":"semetey-1-2013:p0148:b004:l028","ordinal":88179,"en":"May Semetey, left by my khan,"},{"id":"semetey-1-2013:p0148:b004:l029","ordinal":88180,"en":"The orphan who has a protector, eat,” they said."},{"id":"semetey-1-2013:p0148:b004:l030","ordinal":88181,"en":"They put it in the saddlebags,"},{"id":"semetey-1-2013:p0148:b004:l031","ordinal":88182,"en":"Made ready in every matter,"},{"id":"semetey-1-2013:p0148:b004:l032","ordinal":88183,"en":"And the traveling cauldron left by Manas"},{"id":"semetey-1-2013:p0148:b004:l033","ordinal":88184,"en":"Was tied to the saddle-thongs."},{"id":"semetey-1-2013:p0148:b004:l034","ordinal":88185,"en":"Now they stood prepared."},{"id":"semetey-1-2013:p0148:b004:l035","ordinal":88186,"en":"Then the leopard woman Kanykei"},{"id":"semetey-1-2013:p0148:b004:l036","ordinal":88187,"en":"Spoke to Bakai."},{"id":"semetey-1-2013:p0148:b004:l037","ordinal":88188,"en":"So many worries would not fit inside her breast;"},{"id":"semetey-1-2013:p0148:b004:l038","ordinal":88189,"en":"Your fierce, gray-maned sister-in-law's"},{"id":"semetey-1-2013:p0148:b004:l039","ordinal":88190,"en":"Tears streamed in every direction."},{"id":"semetey-1-2013:p0149:b003:l001","ordinal":88191,"en":"Those dear, currant-black eyes,"},{"id":"semetey-1-2013:p0149:b003:l002","ordinal":88192,"en":"As she spoke to Bakai,"},{"id":"semetey-1-2013:p0149:b003:l003","ordinal":88193,"en":"Sent tears a whip's length down."},{"id":"semetey-1-2013:p0149:b003:l004","ordinal":88194,"en":"Those dear eyes like a quail's,"},{"id":"semetey-1-2013:p0149:b003:l005","ordinal":88195,"en":"As she spoke to Bakai,"},{"id":"semetey-1-2013:p0149:b003:l006","ordinal":88196,"en":"Shed tears drop after drop."},{"id":"semetey-1-2013:p0149:b003:l007","ordinal":88197,"en":"“Uncle Bakai, sultan and khan,"},{"id":"semetey-1-2013:p0149:b003:l008","ordinal":88198,"en":"I have fled toward Bukhara."},{"id":"semetey-1-2013:p0149:b003:l009","ordinal":88199,"en":"Uncle, shall I attain my wish?"},{"id":"semetey-1-2013:p0149:b003:l010","ordinal":88200,"en":"It is God's decree."},{"id":"semetey-1-2013:p0149:b003:l011","ordinal":88201,"en":"An elder such as you—"},{"id":"semetey-1-2013:p0149:b003:l012","ordinal":88202,"en":"Am I to leave you in this place?"},{"id":"semetey-1-2013:p0149:b003:l013","ordinal":88203,"en":"When I reach royal Bukhara,"},{"id":"semetey-1-2013:p0149:b003:l014","ordinal":88204,"en":"My khan and uncle Bakai, consider:"},{"id":"semetey-1-2013:p0149:b003:l015","ordinal":88205,"en":"Shall I reach my birth family and settle?"},{"id":"semetey-1-2013:p0149:b003:l016","ordinal":88206,"en":"Parted from her lord,"},{"id":"semetey-1-2013:p0149:b003:l017","ordinal":88207,"en":"Called a fugitive woman,"},{"id":"semetey-1-2013:p0149:b003:l018","ordinal":88208,"en":"Shall I bear an ill name?"},{"id":"semetey-1-2013:p0149:b003:l019","ordinal":88209,"en":"Uncle, I shall not settle with my birth family."},{"id":"semetey-1-2013:p0149:b003:l021","ordinal":88210,"en":"Called a wandering woman,"},{"id":"semetey-1-2013:p0149:b003:l022","ordinal":88211,"en":"I shall not bear an ill name."},{"id":"semetey-1-2013:p0149:b003:l023","ordinal":88212,"en":"My khan and uncle Bakai, hear my words:"},{"id":"semetey-1-2013:p0149:b003:l024","ordinal":88213,"en":"What shall I do by going to my birth family?"},{"id":"semetey-1-2013:p0149:b003:l025","ordinal":88214,"en":"When I flee to Bukhara,"},{"id":"semetey-1-2013:p0149:b003:l026","ordinal":88215,"en":"What wish shall I attain?"},{"id":"semetey-1-2013:p0149:b003:l027","ordinal":88216,"en":"My hair upon my back, thick as a saddle-girth—"},{"id":"semetey-1-2013:p0149:b003:l028","ordinal":88217,"en":"Uncle Bakai, I have strayed from the Kyrgyz."},{"id":"semetey-1-2013:p0149:b003:l030","ordinal":88218,"en":"Now where will my wretched head find room?"},{"id":"semetey-1-2013:p0149:b003:l031","ordinal":88219,"en":"Of the Sarts in Bukhara,"},{"id":"semetey-1-2013:p0149:b003:l032","ordinal":88220,"en":"Will their gossip not devour me?"},{"id":"semetey-1-2013:p0149:b003:l033","ordinal":88221,"en":"‘Parted from her lord,"},{"id":"semetey-1-2013:p0149:b003:l034","ordinal":88222,"en":"A wandering woman,’ will they not say?"},{"id":"semetey-1-2013:p0149:b003:l035","ordinal":88223,"en":"‘The dark stones of the dark valley—"},{"id":"semetey-1-2013:p0149:b003:l036","ordinal":88224,"en":"A woman who crossed them,’ will they not say?"},{"id":"semetey-1-2013:p0149:b003:l037","ordinal":88225,"en":"‘Her treasure and possessions in Talas—"},{"id":"semetey-1-2013:p0149:b003:l038","ordinal":88226,"en":"A woman who scattered them,’ will they not say?"},{"id":"semetey-1-2013:p0149:b003:l039","ordinal":88227,"en":"‘Unable to bear her distress,"},{"id":"semetey-1-2013:p0149:b004:l001","ordinal":88228,"en":"Wandering desperately toward Bukhara,"},{"id":"semetey-1-2013:p0149:b004:l002","ordinal":88229,"en":"A woman who fled,’ will they not say?"},{"id":"semetey-1-2013:p0149:b004:l003","ordinal":88230,"en":"‘Hunched like a hunting hound,"},{"id":"semetey-1-2013:p0149:b004:l004","ordinal":88231,"en":"A woman who trotted away,’ will they not say?"},{"id":"semetey-1-2013:p0149:b004:l005","ordinal":88232,"en":"‘Plunder and violence at close quarters—"},{"id":"semetey-1-2013:p0149:b004:l006","ordinal":88233,"en":"A woman who saw them,’ will they not say?"},{"id":"semetey-1-2013:p0149:b004:l007","ordinal":88234,"en":"‘The child in her arms"},{"id":"semetey-1-2013:p0149:b004:l008","ordinal":88235,"en":"She handed over in misery,’ they will say."},{"id":"semetey-1-2013:p0149:b004:l009","ordinal":88236,"en":"‘Suffering humiliation through her own fault,"},{"id":"semetey-1-2013:p0149:b004:l010","ordinal":88237,"en":"She came wandering from Talas,’ they will say."},{"id":"semetey-1-2013:p0149:b004:l011","ordinal":88238,"en":"Uncle Bakai, leopard,"},{"id":"semetey-1-2013:p0149:b004:l012","ordinal":88239,"en":"Will they not speak such gossip?"},{"id":"semetey-1-2013:p0149:b004:l013","ordinal":88240,"en":"‘A loose, fugitive woman,’ they will say;"},{"id":"semetey-1-2013:p0149:b004:l014","ordinal":88241,"en":"Will they not mock me cruelly?"},{"id":"semetey-1-2013:p0149:b004:l015","ordinal":88242,"en":"When I hear those words,"},{"id":"semetey-1-2013:p0149:b004:l016","ordinal":88243,"en":"My life not dying of shame,"},{"id":"semetey-1-2013:p0149:b004:l017","ordinal":88244,"en":"Will God not strike the fierce woman down?"},{"id":"semetey-1-2013:p0149:b004:l018","ordinal":88245,"en":"When I flee to Bukhara,"},{"id":"semetey-1-2013:p0149:b004:l019","ordinal":88246,"en":"The hoe-bearing Tajiks—"},{"id":"semetey-1-2013:p0149:b004:l020","ordinal":88247,"en":"Will they not devour me with gossip?"},{"id":"semetey-1-2013:p0149:b004:l021","ordinal":88248,"en":"‘Parted from her lord,"},{"id":"semetey-1-2013:p0149:b004:l022","ordinal":88249,"en":"A wandering woman,’ will they not say?"},{"id":"semetey-1-2013:p0149:b004:l023","ordinal":88250,"en":"If it pleases those people,"},{"id":"semetey-1-2013:p0149:b004:l024","ordinal":88251,"en":"Will they not plunder my goods?"},{"id":"semetey-1-2013:p0149:b004:l025","ordinal":88252,"en":"Calling me a corrupt woman,"},{"id":"semetey-1-2013:p0149:b004:l026","ordinal":88253,"en":"Will they not stir up trouble together?"},{"id":"semetey-1-2013:p0149:b004:l027","ordinal":88254,"en":"Uncle Bakai, gray-maned khan,"},{"id":"semetey-1-2013:p0149:b004:l028","ordinal":88255,"en":"I have words to tell you."},{"id":"semetey-1-2013:p0149:b004:l029","ordinal":88256,"en":"My father Temir Khan"},{"id":"semetey-1-2013:p0149:b004:l030","ordinal":88257,"en":"Has an ill-willed side."},{"id":"semetey-1-2013:p0149:b004:l031","ordinal":88258,"en":"Saying, ‘He is like an unbeliever,’"},{"id":"semetey-1-2013:p0149:b004:l032","ordinal":88259,"en":"Against my father Temir Khan,"},{"id":"semetey-1-2013:p0149:b004:l033","ordinal":88260,"en":"Your dignified child Kanykei"},{"id":"semetey-1-2013:p0149:b004:l034","ordinal":88261,"en":"Has a cause for resentment."},{"id":"semetey-1-2013:p0149:b004:l035","ordinal":88262,"en":"The ten commands given by the saint"},{"id":"semetey-1-2013:p0149:b004:l036","ordinal":88263,"en":"I ceased to call a blessing."},{"id":"semetey-1-2013:p0149:b004:l037","ordinal":88264,"en":"My sickle-nosed father"},{"id":"semetey-1-2013:p0149:b004:l038","ordinal":88265,"en":"I ceased to call my father."},{"id":"semetey-1-2013:p0149:b004:l039","ordinal":88266,"en":"When I became pure from the dark faith,"},{"id":"semetey-1-2013:p0150:b003:l001","ordinal":88267,"en":"Almambet, son of Khan Azyz,"},{"id":"semetey-1-2013:p0150:b003:l002","ordinal":88268,"en":"Fled the unbelievers and became an exile,"},{"id":"semetey-1-2013:p0150:b003:l003","ordinal":88269,"en":"Scattering all he had gathered,"},{"id":"semetey-1-2013:p0150:b003:l004","ordinal":88270,"en":"Seeking faith alone."},{"id":"semetey-1-2013:p0150:b003:l005","ordinal":88271,"en":"Making his golden throne rich,"},{"id":"semetey-1-2013:p0150:b003:l006","ordinal":88272,"en":"Saying, ‘He openly refuses to obey,’"},{"id":"semetey-1-2013:p0150:b003:l007","ordinal":88273,"en":"Saying, ‘He will not heed my words,’"},{"id":"semetey-1-2013:p0150:b003:l008","ordinal":88274,"en":"He slew his father, Khan Azyz, and laid him low."},{"id":"semetey-1-2013:p0150:b003:l010","ordinal":88275,"en":"Staining his silver throne with blood,"},{"id":"semetey-1-2013:p0150:b003:l011","ordinal":88276,"en":"He laid his father Kun Zhang-Zhung low."},{"id":"semetey-1-2013:p0150:b003:l012","ordinal":88277,"en":"Coral rank-buttons and coral stones—"},{"id":"semetey-1-2013:p0150:b003:l013","ordinal":88278,"en":"Among the governors he slew a thousand khans."},{"id":"semetey-1-2013:p0150:b003:l014","ordinal":88279,"en":"Whose armguards loomed large—"},{"id":"semetey-1-2013:p0150:b003:l015","ordinal":88280,"en":"Among the governors he slew a thousand men."},{"id":"semetey-1-2013:p0150:b003:l016","ordinal":88281,"en":"The Chinese with rank-stones on their caps—"},{"id":"semetey-1-2013:p0150:b003:l017","ordinal":88282,"en":"He slew their finest men and made an example of them,"},{"id":"semetey-1-2013:p0150:b003:l018","ordinal":88283,"en":"Upholding the truth of the words ‘In God's name.’"},{"id":"semetey-1-2013:p0150:b003:l019","ordinal":88284,"en":"Your champion brought devastation upon Beijing."},{"id":"semetey-1-2013:p0150:b003:l021","ordinal":88285,"en":"The golden throne he had occupied in Beijing—"},{"id":"semetey-1-2013:p0150:b003:l022","ordinal":88286,"en":"True righteousness having entered his thoughts,"},{"id":"semetey-1-2013:p0150:b003:l023","ordinal":88287,"en":"He utterly renounced it."},{"id":"semetey-1-2013:p0150:b003:l024","ordinal":88288,"en":"Planted from yellow willow,"},{"id":"semetey-1-2013:p0150:b003:l025","ordinal":88289,"en":"His willow remained in Beijing."},{"id":"semetey-1-2013:p0150:b003:l026","ordinal":88290,"en":"Made of pure gold,"},{"id":"semetey-1-2013:p0150:b003:l027","ordinal":88291,"en":"His throne remained in Beijing."},{"id":"semetey-1-2013:p0150:b003:l028","ordinal":88292,"en":"Forty tightly secured doors—"},{"id":"semetey-1-2013:p0150:b003:l029","ordinal":88293,"en":"All remained in Beijing."},{"id":"semetey-1-2013:p0150:b003:l030","ordinal":88294,"en":"Forty Chinese tribes, a valued people—"},{"id":"semetey-1-2013:p0150:b003:l031","ordinal":88295,"en":"His village remained in Beijing."},{"id":"semetey-1-2013:p0150:b003:l032","ordinal":88296,"en":"Parting from the wife he had married,"},{"id":"semetey-1-2013:p0150:b003:l033","ordinal":88297,"en":"That Burulcha, Esen's daughter—"},{"id":"semetey-1-2013:p0150:b003:l034","ordinal":88298,"en":"His wife remained in Beijing."},{"id":"semetey-1-2013:p0150:b003:l035","ordinal":88299,"en":"Renouncing his gold,"},{"id":"semetey-1-2013:p0150:b003:l036","ordinal":88300,"en":"He stirred up strife in Beijing."},{"id":"semetey-1-2013:p0150:b003:l037","ordinal":88301,"en":"Saying, ‘Oh, how can I remain in Beijing?’"},{"id":"semetey-1-2013:p0150:b003:l039","ordinal":88302,"en":"From the black-burning hell,"},{"id":"semetey-1-2013:p0150:b004:l001","ordinal":88303,"en":"Saying, ‘I shall free my soul,’"},{"id":"semetey-1-2013:p0150:b004:l002","ordinal":88304,"en":"Rather than be khan of this Beijing,"},{"id":"semetey-1-2013:p0150:b004:l003","ordinal":88305,"en":"Saying, ‘I shall reach Mecca and settle there,’"},{"id":"semetey-1-2013:p0150:b004:l004","ordinal":88306,"en":"Rather than be khan of these unbelievers,"},{"id":"semetey-1-2013:p0150:b004:l005","ordinal":88307,"en":"Saying, ‘I shall be a Muslim's slave,’"},{"id":"semetey-1-2013:p0150:b004:l007","ordinal":88308,"en":"Saying, ‘How can I remain in Beijing?’"},{"id":"semetey-1-2013:p0150:b004:l009","ordinal":88309,"en":"From the hell stretched out before him,"},{"id":"semetey-1-2013:p0150:b004:l010","ordinal":88310,"en":"Saying, ‘I shall free my soul,’"},{"id":"semetey-1-2013:p0150:b004:l011","ordinal":88311,"en":"He scattered what he had gathered,"},{"id":"semetey-1-2013:p0150:b004:l012","ordinal":88312,"en":"Seeking faith alone."},{"id":"semetey-1-2013:p0150:b004:l013","ordinal":88313,"en":"He regarded as true"},{"id":"semetey-1-2013:p0150:b004:l014","ordinal":88314,"en":"The holy word, the Quran."},{"id":"semetey-1-2013:p0150:b004:l015","ordinal":88315,"en":"He regarded as One"},{"id":"semetey-1-2013:p0150:b004:l016","ordinal":88316,"en":"God alone, the Creator,"},{"id":"semetey-1-2013:p0150:b004:l017","ordinal":88317,"en":"And scattered the countless Chinese."},{"id":"semetey-1-2013:p0150:b004:l018","ordinal":88318,"en":"Then, among those left alive,"},{"id":"semetey-1-2013:p0150:b004:l019","ordinal":88319,"en":"Kongurbay, son of Alooke,"},{"id":"semetey-1-2013:p0150:b004:l020","ordinal":88320,"en":"Fought without rest for six months."}]
