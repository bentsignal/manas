[{"id":"semetey-1-2013:p1028:b007:l002","ordinal":154625,"en":"Thinking, \"How will he attempt the crossing?"},{"id":"semetey-1-2013:p1028:b007:l003","ordinal":154626,"en":"If the enraged lion enters the Urgench"},{"id":"semetey-1-2013:p1028:b007:l004","ordinal":154627,"en":"Without heed,"},{"id":"semetey-1-2013:p1028:b007:l005","ordinal":154628,"en":"He may die there for nothing,\""},{"id":"semetey-1-2013:p1028:b007:l006","ordinal":154629,"en":"She uttered a cold incantation"},{"id":"semetey-1-2013:p1028:b007:l007","ordinal":154630,"en":"And worked magic upon the weather."},{"id":"semetey-1-2013:p1028:b007:l008","ordinal":154631,"en":"Clouds tore open in the sky,"},{"id":"semetey-1-2013:p1028:b007:l009","ordinal":154632,"en":"And over the mountains rising from the foothills,"},{"id":"semetey-1-2013:p1029:b003:l001","ordinal":154633,"en":"There was neither hail nor rain;"},{"id":"semetey-1-2013:p1029:b003:l002","ordinal":154634,"en":"A freezing wind appeared."},{"id":"semetey-1-2013:p1029:b003:l003","ordinal":154635,"en":"All the lesser streams,"},{"id":"semetey-1-2013:p1029:b003:l004","ordinal":154636,"en":"Troubled and splashing,"},{"id":"semetey-1-2013:p1029:b003:l005","ordinal":154637,"en":"Separated and flowed in every direction."},{"id":"semetey-1-2013:p1029:b003:l006","ordinal":154638,"en":"Not one of a thousand running waters remained;"},{"id":"semetey-1-2013:p1029:b003:l007","ordinal":154639,"en":"Only the Great Urgench was left,"},{"id":"semetey-1-2013:p1029:b003:l008","ordinal":154640,"en":"Its stones visible in the riverbed."},{"id":"semetey-1-2013:p1029:b003:l009","ordinal":154641,"en":"Aichurok, the daughter of Akun,"},{"id":"semetey-1-2013:p1029:b003:l010","ordinal":154642,"en":"That clever-born wretched woman,"},{"id":"semetey-1-2013:p1029:b003:l011","ordinal":154643,"en":"Revealed her form as a weather-worker."},{"id":"semetey-1-2013:p1029:b003:l012","ordinal":154644,"en":"Not a spoonful of water ran from the springs;"},{"id":"semetey-1-2013:p1029:b003:l013","ordinal":154645,"en":"It lay frozen outside,"},{"id":"semetey-1-2013:p1029:b003:l014","ordinal":154646,"en":"As though the depths of winter had come."},{"id":"semetey-1-2013:p1029:b003:l015","ordinal":154647,"en":"So powerful was her incantation"},{"id":"semetey-1-2013:p1029:b003:l016","ordinal":154648,"en":"That the heads of the glaciers froze."},{"id":"semetey-1-2013:p1029:b003:l017","ordinal":154649,"en":"Through her spell, the Great Urgench"},{"id":"semetey-1-2013:p1029:b003:l018","ordinal":154650,"en":"Lay without flowing,"},{"id":"semetey-1-2013:p1029:b003:l019","ordinal":154651,"en":"Only a waterskin's little measure of water stirring."},{"id":"semetey-1-2013:p1029:b003:l020","ordinal":154652,"en":"If you would behold Semetey,"},{"id":"semetey-1-2013:p1029:b003:l021","ordinal":154653,"en":"He pleaded with his Allah"},{"id":"semetey-1-2013:p1029:b003:l022","ordinal":154654,"en":"And strained like a white tiger."},{"id":"semetey-1-2013:p1029:b003:l023","ordinal":154655,"en":"Driving fourteen horses from the Argyn,"},{"id":"semetey-1-2013:p1029:b003:l024","ordinal":154656,"en":"He drove all those horses"},{"id":"semetey-1-2013:p1029:b003:l025","ordinal":154657,"en":"So hard they seemed about to die;"},{"id":"semetey-1-2013:p1029:b003:l026","ordinal":154658,"en":"Their white foam streamed."},{"id":"semetey-1-2013:p1029:b003:l027","ordinal":154659,"en":"He drove them swiftly without stopping."},{"id":"semetey-1-2013:p1029:b003:l028","ordinal":154660,"en":"Then Semetey grew furious;"},{"id":"semetey-1-2013:p1029:b003:l029","ordinal":154661,"en":"As though Kalmyks had raided"},{"id":"semetey-1-2013:p1029:b003:l030","ordinal":154662,"en":"The populous Kyrgyz nation,"},{"id":"semetey-1-2013:p1029:b003:l031","ordinal":154663,"en":"He had his trumpet drawn out"},{"id":"semetey-1-2013:p1029:b003:l032","ordinal":154664,"en":"And advanced in dread majesty."},{"id":"semetey-1-2013:p1029:b003:l033","ordinal":154665,"en":"He urged the fourteen horses onward;"},{"id":"semetey-1-2013:p1029:b003:l034","ordinal":154666,"en":"No person could approach his anger,"},{"id":"semetey-1-2013:p1029:b003:l035","ordinal":154667,"en":"And no one wished to see his frowning brow."},{"id":"semetey-1-2013:p1029:b003:l036","ordinal":154668,"en":"Of the extravagantly born gray-maned hero,"},{"id":"semetey-1-2013:p1029:b003:l037","ordinal":154669,"en":"Which deed can one recount?"},{"id":"semetey-1-2013:p1029:b003:l038","ordinal":154670,"en":"He who had pastured at Middle Keng-Kol"},{"id":"semetey-1-2013:p1029:b003:l039","ordinal":154671,"en":"And tethered his fourteen horses—"},{"id":"semetey-1-2013:p1029:b004:l001","ordinal":154672,"en":"If enemies came out shooting,"},{"id":"semetey-1-2013:p1029:b004:l002","ordinal":154673,"en":"He drove them before him,"},{"id":"semetey-1-2013:p1029:b004:l003","ordinal":154674,"en":"And, lion that he was,"},{"id":"semetey-1-2013:p1029:b004:l004","ordinal":154675,"en":"Caught them in his fangs and chewed them."},{"id":"semetey-1-2013:p1029:b004:l005","ordinal":154676,"en":"Watching him, Choro's"},{"id":"semetey-1-2013:p1029:b004:l006","ordinal":154677,"en":"Heart was deeply troubled."},{"id":"semetey-1-2013:p1029:b004:l007","ordinal":154678,"en":"Driving fourteen swift horses,"},{"id":"semetey-1-2013:p1029:b004:l008","ordinal":154679,"en":"The doomed man seemed to have come"},{"id":"semetey-1-2013:p1029:b004:l009","ordinal":154680,"en":"To cross to the farther bank."},{"id":"semetey-1-2013:p1029:b004:l010","ordinal":154681,"en":"Kulchoro started in alarm."},{"id":"semetey-1-2013:p1029:b004:l012","ordinal":154682,"en":"He ran toward Buurul,","gapBefore":"[Passage withheld: sexual content involving a minor]"},{"id":"semetey-1-2013:p1029:b004:l013","ordinal":154683,"en":"Despairing of his entrusted life;"},{"id":"semetey-1-2013:p1029:b004:l014","ordinal":154684,"en":"Distraught, he caught Buurul."},{"id":"semetey-1-2013:p1029:b004:l015","ordinal":154685,"en":"Kulchoro laughed openly"},{"id":"semetey-1-2013:p1029:b004:l016","ordinal":154686,"en":"And pleaded with Aichurok:"},{"id":"semetey-1-2013:p1029:b004:l017","ordinal":154687,"en":"\"My dear sister-in-law!"},{"id":"semetey-1-2013:p1029:b004:l018","ordinal":154688,"en":"The enraged lion"},{"id":"semetey-1-2013:p1029:b004:l019","ordinal":154689,"en":"May kill me for nothing;"},{"id":"semetey-1-2013:p1029:b004:l020","ordinal":154690,"en":"Go smiling openly"},{"id":"semetey-1-2013:p1029:b004:l021","ordinal":154691,"en":"To that bloodthirsty man who loves his wife."},{"id":"semetey-1-2013:p1029:b004:l022","ordinal":154692,"en":"My dear sister-in-law!"},{"id":"semetey-1-2013:p1029:b004:l023","ordinal":154693,"en":"Beg him to spare my blood."},{"id":"semetey-1-2013:p1029:b004:l024","ordinal":154694,"en":"If you do not ask, it will not end well;"},{"id":"semetey-1-2013:p1029:b004:l025","ordinal":154695,"en":"My sultan will not leave me unharmed!\""},{"id":"semetey-1-2013:p1029:b004:l026","ordinal":154696,"en":"Having said this, Kulchoro"},{"id":"semetey-1-2013:p1029:b004:l027","ordinal":154697,"en":"Stood holding the steed."},{"id":"semetey-1-2013:p1029:b004:l028","ordinal":154698,"en":"Seeing her lord, Aichurok"},{"id":"semetey-1-2013:p1029:b004:l029","ordinal":154699,"en":"Stood watching from the riverbank;"},{"id":"semetey-1-2013:p1029:b004:l030","ordinal":154700,"en":"Thirty brides and thirty maidens"},{"id":"semetey-1-2013:p1029:b004:l031","ordinal":154701,"en":"Watched together in wonder."},{"id":"semetey-1-2013:p1029:b004:l032","ordinal":154702,"en":"Beating the fourteen horses,"},{"id":"semetey-1-2013:p1029:b004:l033","ordinal":154703,"en":"Your swaggering unfortunate man"},{"id":"semetey-1-2013:p1029:b004:l034","ordinal":154704,"en":"Made ready to enter the Urgench."},{"id":"semetey-1-2013:p1029:b004:l035","ordinal":154705,"en":"To keep his lord from entering the water,"},{"id":"semetey-1-2013:p1029:b004:l036","ordinal":154706,"en":"Speaking gently in his distress,"},{"id":"semetey-1-2013:p1029:b004:l037","ordinal":154707,"en":"Kanchoro came to his lord"},{"id":"semetey-1-2013:p1029:b004:l038","ordinal":154708,"en":"And pleaded, calling him \"dear uncle\":"},{"id":"semetey-1-2013:p1029:b004:l039","ordinal":154709,"en":"\"I shall babble and tell you one thing:"},{"id":"semetey-1-2013:p1030:b003:l001","ordinal":154710,"en":"Understand my babbling words;"},{"id":"semetey-1-2013:p1030:b003:l002","ordinal":154711,"en":"My fortunate elder brother, heed what I say."},{"id":"semetey-1-2013:p1030:b003:l003","ordinal":154712,"en":"Silver-eyed and sun-faced,"},{"id":"semetey-1-2013:p1030:b003:l004","ordinal":154713,"en":"My thundering elder brother;"},{"id":"semetey-1-2013:p1030:b003:l005","ordinal":154714,"en":"Golden-eyed and moon-faced,"},{"id":"semetey-1-2013:p1030:b003:l006","ordinal":154715,"en":"My dear lordly brother—"},{"id":"semetey-1-2013:p1030:b003:l007","ordinal":154716,"en":"Before us lies this water,"},{"id":"semetey-1-2013:p1030:b003:l008","ordinal":154717,"en":"And here is a manifest enemy."},{"id":"semetey-1-2013:p1030:b003:l009","ordinal":154718,"en":"Let us not be swept away by chance,"},{"id":"semetey-1-2013:p1030:b003:l010","ordinal":154719,"en":"Overtaken suddenly by death,"},{"id":"semetey-1-2013:p1030:b003:l011","ordinal":154720,"en":"And perish in destruction."},{"id":"semetey-1-2013:p1030:b003:l012","ordinal":154721,"en":"Precious lives that did not die by an enemy—"},{"id":"semetey-1-2013:p1030:b003:l013","ordinal":154722,"en":"Let us not lose them to speechless water!"},{"id":"semetey-1-2013:p1030:b003:l014","ordinal":154723,"en":"My dear khan and elder brother,"},{"id":"semetey-1-2013:p1030:b003:l015","ordinal":154724,"en":"Let us line up the fourteen horses;"},{"id":"semetey-1-2013:p1030:b003:l016","ordinal":154725,"en":"Along this immoderately rushing river,"},{"id":"semetey-1-2013:p1030:b003:l017","ordinal":154726,"en":"Let us search apart for a crossing,"},{"id":"semetey-1-2013:p1030:b003:l018","ordinal":154727,"en":"Find a shallow channel,"},{"id":"semetey-1-2013:p1030:b003:l019","ordinal":154728,"en":"And somehow make our way across.\""},{"id":"semetey-1-2013:p1030:b003:l020","ordinal":154729,"en":"When Kanchoro had said this,"},{"id":"semetey-1-2013:p1030:b003:l021","ordinal":154730,"en":"His lord's anger rose;"},{"id":"semetey-1-2013:p1030:b003:l022","ordinal":154731,"en":"He began a tumult"},{"id":"semetey-1-2013:p1030:b003:l023","ordinal":154732,"en":"And nearly swallowed Choro"},{"id":"semetey-1-2013:p1030:b003:l024","ordinal":154733,"en":"Together with his horse:"},{"id":"semetey-1-2013:p1030:b003:l025","ordinal":154734,"en":"\"Damn you, Kanchoro!"},{"id":"semetey-1-2013:p1030:b003:l026","ordinal":154735,"en":"Is it right to fear death?"},{"id":"semetey-1-2013:p1030:b003:l027","ordinal":154736,"en":"In a world where none lives forever,"},{"id":"semetey-1-2013:p1030:b003:l028","ordinal":154737,"en":"Can anyone have a spine of iron?"},{"id":"semetey-1-2013:p1030:b003:l029","ordinal":154738,"en":"You fear the rushing water;"},{"id":"semetey-1-2013:p1030:b003:l030","ordinal":154739,"en":"If ten thousand human enemies appeared,"},{"id":"semetey-1-2013:p1030:b003:l031","ordinal":154740,"en":"How could you not fear them?"},{"id":"semetey-1-2013:p1030:b003:l032","ordinal":154741,"en":"You fear the swollen water;"},{"id":"semetey-1-2013:p1030:b003:l033","ordinal":154742,"en":"When spear points sway,"},{"id":"semetey-1-2013:p1030:b003:l034","ordinal":154743,"en":"When human heads roll,"},{"id":"semetey-1-2013:p1030:b003:l035","ordinal":154744,"en":"If sixty human enemies appeared,"},{"id":"semetey-1-2013:p1030:b003:l036","ordinal":154745,"en":"How could you not fear them?"},{"id":"semetey-1-2013:p1030:b003:l037","ordinal":154746,"en":"You have feared the floodwater;"},{"id":"semetey-1-2013:p1030:b003:l038","ordinal":154747,"en":"May God strike you!"},{"id":"semetey-1-2013:p1030:b003:l039","ordinal":154748,"en":"Does the angel Gabriel,"},{"id":"semetey-1-2013:p1030:b004:l001","ordinal":154749,"en":"Thinking, 'These men will cross the water,'"},{"id":"semetey-1-2013:p1030:b004:l002","ordinal":154750,"en":"Spread out his five fingers,"},{"id":"semetey-1-2013:p1030:b004:l003","ordinal":154751,"en":"Ready his knife and loom there,"},{"id":"semetey-1-2013:p1030:b004:l004","ordinal":154752,"en":"Watching from the farther bank?"},{"id":"semetey-1-2013:p1030:b004:l005","ordinal":154753,"en":"You fear the rushing water;"},{"id":"semetey-1-2013:p1030:b004:l006","ordinal":154754,"en":"Do not babble, you rascal—"},{"id":"semetey-1-2013:p1030:b004:l007","ordinal":154755,"en":"Turn back and go away!"},{"id":"semetey-1-2013:p1030:b004:l008","ordinal":154756,"en":"Will thirty brides and thirty maidens,"},{"id":"semetey-1-2013:p1030:b004:l009","ordinal":154757,"en":"With your sister-in-law among them,"},{"id":"semetey-1-2013:p1030:b004:l010","ordinal":154758,"en":"Not say, 'White divers have come,'"},{"id":"semetey-1-2013:p1030:b004:l011","ordinal":154759,"en":"And devour us without mercy?"},{"id":"semetey-1-2013:p1030:b004:l012","ordinal":154760,"en":"Will they not say, 'Caravan men have come,'"},{"id":"semetey-1-2013:p1030:b004:l013","ordinal":154761,"en":"And torment us with mockery?"},{"id":"semetey-1-2013:p1030:b004:l014","ordinal":154762,"en":"Will they not sing their taunting song,"},{"id":"semetey-1-2013:p1030:b004:l015","ordinal":154763,"en":"And will brave, manly warriors"},{"id":"semetey-1-2013:p1030:b004:l016","ordinal":154764,"en":"Not suffer disgrace from shame?"},{"id":"semetey-1-2013:p1030:b004:l017","ordinal":154765,"en":"May God strike those maidens—"},{"id":"semetey-1-2013:p1030:b004:l018","ordinal":154766,"en":"Will they not mimic us endlessly?"},{"id":"semetey-1-2013:p1030:b004:l019","ordinal":154767,"en":"Will they not recognize our cowardice"},{"id":"semetey-1-2013:p1030:b004:l020","ordinal":154768,"en":"And laugh at us in scorn?"},{"id":"semetey-1-2013:p1030:b004:l021","ordinal":154769,"en":"'Kulchoro was a falcon;"},{"id":"semetey-1-2013:p1030:b004:l022","ordinal":154770,"en":"He entered the water straight on,' they will say."},{"id":"semetey-1-2013:p1030:b004:l023","ordinal":154771,"en":"'Those men did not dare remain;"},{"id":"semetey-1-2013:p1030:b004:l024","ordinal":154772,"en":"They wandered seeking a ford,' they will say."},{"id":"semetey-1-2013:p1030:b004:l025","ordinal":154773,"en":"'Kulchoro was a hero;"},{"id":"semetey-1-2013:p1030:b004:l026","ordinal":154774,"en":"He rode directly into the water,' they will say."},{"id":"semetey-1-2013:p1030:b004:l027","ordinal":154775,"en":"'The caravan man with an aching head"},{"id":"semetey-1-2013:p1030:b004:l028","ordinal":154776,"en":"Wandered seeking a ford,' they will say."},{"id":"semetey-1-2013:p1030:b004:l029","ordinal":154777,"en":"Will they not say, 'Weaklings have come,'"},{"id":"semetey-1-2013:p1030:b004:l030","ordinal":154778,"en":"And devour us with shrill derision?\""},{"id":"semetey-1-2013:p1030:b004:l031","ordinal":154779,"en":"Saying this in fury,"},{"id":"semetey-1-2013:p1030:b004:l032","ordinal":154780,"en":"He hemmed in the horses;"},{"id":"semetey-1-2013:p1030:b004:l033","ordinal":154781,"en":"Without stopping, making the blows crack,"},{"id":"semetey-1-2013:p1030:b004:l034","ordinal":154782,"en":"He began beating the horses."},{"id":"semetey-1-2013:p1030:b004:l035","ordinal":154783,"en":"The bloodthirsty man unleashed his rage;"},{"id":"semetey-1-2013:p1030:b004:l036","ordinal":154784,"en":"Your sovereign utterly beat"},{"id":"semetey-1-2013:p1030:b004:l037","ordinal":154785,"en":"The fourteen horses from Talas"},{"id":"semetey-1-2013:p1030:b004:l038","ordinal":154786,"en":"And left them slaughtered."},{"id":"semetey-1-2013:p1030:b004:l039","ordinal":154787,"en":"The fourteen horses that came from Ogoi,"},{"id":"semetey-1-2013:p1031:b003:l001","ordinal":154788,"en":"Among the fourteen horses were"},{"id":"semetey-1-2013:p1031:b003:l002","ordinal":154789,"en":"The mighty swift horse Buurul;"},{"id":"semetey-1-2013:p1031:b003:l003","ordinal":154790,"en":"Kanykei's courser Karakaska;"},{"id":"semetey-1-2013:p1031:b003:l004","ordinal":154791,"en":"Sarykan's Tuuchunak;"},{"id":"semetey-1-2013:p1031:b003:l005","ordinal":154792,"en":"Kobosh Khan's Kokborchuk;"},{"id":"semetey-1-2013:p1031:b003:l006","ordinal":154793,"en":"Abyke's Aktelki;"},{"id":"semetey-1-2013:p1031:b003:l007","ordinal":154794,"en":"The sturdy Archa-Toru;"},{"id":"semetey-1-2013:p1031:b003:l008","ordinal":154795,"en":"Chyiyrdy's Bozjorgo;"},{"id":"semetey-1-2013:p1031:b003:l009","ordinal":154796,"en":"The spotted red and the blue with a mane;"},{"id":"semetey-1-2013:p1031:b003:l010","ordinal":154797,"en":"Khan Bakai's Kokcholok;"},{"id":"semetey-1-2013:p1031:b003:l011","ordinal":154798,"en":"Taitoru, who came in mourning"},{"id":"semetey-1-2013:p1031:b003:l012","ordinal":154799,"en":"When noble Manas died;"},{"id":"semetey-1-2013:p1031:b003:l013","ordinal":154800,"en":"Bagysh Khan's Surkiyik;"},{"id":"semetey-1-2013:p1031:b003:l014","ordinal":154801,"en":"Muzburchak's Telkyzyl;"},{"id":"semetey-1-2013:p1031:b003:l015","ordinal":154802,"en":"Shaiymbet's Akkokul;"},{"id":"semetey-1-2013:p1031:b003:l016","ordinal":154803,"en":"The maiden's red pacer;"},{"id":"semetey-1-2013:p1031:b003:l017","ordinal":154804,"en":"And Chachykei's Tik-Toru."},{"id":"semetey-1-2013:p1031:b003:l018","ordinal":154805,"en":"He hemmed in the fourteen horses;"},{"id":"semetey-1-2013:p1031:b003:l019","ordinal":154806,"en":"The lion roared"},{"id":"semetey-1-2013:p1031:b003:l020","ordinal":154807,"en":"And beat them without restraint."},{"id":"semetey-1-2013:p1031:b003:l021","ordinal":154808,"en":"Shouting in fury,"},{"id":"semetey-1-2013:p1031:b003:l022","ordinal":154809,"en":"He called, \"Khan Bakai's Kokcholok"},{"id":"semetey-1-2013:p1031:b003:l023","ordinal":154810,"en":"Must lead!\""},{"id":"semetey-1-2013:p1031:b003:l024","ordinal":154811,"en":"Then Khan Bakai's Kokcholok"},{"id":"semetey-1-2013:p1031:b003:l025","ordinal":154812,"en":"Outstripped the horses and led the way."},{"id":"semetey-1-2013:p1031:b003:l026","ordinal":154813,"en":"At the sound of the uproar he sprang apart;"},{"id":"semetey-1-2013:p1031:b003:l027","ordinal":154814,"en":"He had no tongue with which to tell it,"},{"id":"semetey-1-2013:p1031:b003:l028","ordinal":154815,"en":"But the marks of a true courser showed."},{"id":"semetey-1-2013:p1031:b003:l029","ordinal":154816,"en":"He reached the swiftly flowing Urgench"},{"id":"semetey-1-2013:p1031:b003:l030","ordinal":154817,"en":"And entered it at the head of the line."},{"id":"semetey-1-2013:p1031:b003:l031","ordinal":154818,"en":"When Kokcholok entered the water,"},{"id":"semetey-1-2013:p1031:b003:l032","ordinal":154819,"en":"All fourteen horses pitched forward"},{"id":"semetey-1-2013:p1031:b003:l033","ordinal":154820,"en":"And plunged fully into the river."},{"id":"semetey-1-2013:p1031:b003:l034","ordinal":154821,"en":"At the place where they entered, the Great Urgench"},{"id":"semetey-1-2013:p1031:b003:l035","ordinal":154822,"en":"Drove all fourteen horses"},{"id":"semetey-1-2013:p1031:b003:l036","ordinal":154823,"en":"As though pursuing an enemy."},{"id":"semetey-1-2013:p1031:b003:l037","ordinal":154824,"en":"The Urgench flowed with a thunderous roar;"},{"id":"semetey-1-2013:p1031:b003:l038","ordinal":154825,"en":"Its fierce current showed plainly."},{"id":"semetey-1-2013:p1031:b003:l039","ordinal":154826,"en":"All fourteen horses"},{"id":"semetey-1-2013:p1031:b004:l001","ordinal":154827,"en":"Were swept along, floundering like kids,"},{"id":"semetey-1-2013:p1031:b004:l002","ordinal":154828,"en":"And separated from one another."},{"id":"semetey-1-2013:p1031:b004:l003","ordinal":154829,"en":"Your unfortunate lion of a lord,"},{"id":"semetey-1-2013:p1031:b004:l004","ordinal":154830,"en":"When the horses entered the water,"},{"id":"semetey-1-2013:p1031:b004:l005","ordinal":154831,"en":"Entered the river with them."},{"id":"semetey-1-2013:p1031:b004:l006","ordinal":154832,"en":"His hands were soaked in the water;"},{"id":"semetey-1-2013:p1031:b004:l007","ordinal":154833,"en":"Then the lion-like lord"},{"id":"semetey-1-2013:p1031:b004:l008","ordinal":154834,"en":"Pleaded with the one God."},{"id":"semetey-1-2013:p1031:b004:l009","ordinal":154835,"en":"Behind him came Kanchoro:"},{"id":"semetey-1-2013:p1031:b004:l010","ordinal":154836,"en":"\"If I am left and parted from my elder brother,"},{"id":"semetey-1-2013:p1031:b004:l011","ordinal":154837,"en":"To what grave can I go?\" he thought."},{"id":"semetey-1-2013:p1031:b004:l012","ordinal":154838,"en":"He placed his belt around his neck,"},{"id":"semetey-1-2013:p1031:b004:l013","ordinal":154839,"en":"Caught hold of the hem, crying, \"Elder brother!\""},{"id":"semetey-1-2013:p1031:b004:l014","ordinal":154840,"en":"And entered with him, pleading."},{"id":"semetey-1-2013:p1031:b004:l015","ordinal":154841,"en":"All fourteen horses"},{"id":"semetey-1-2013:p1031:b004:l016","ordinal":154842,"en":"Strained to swim upstream;"},{"id":"semetey-1-2013:p1031:b004:l017","ordinal":154843,"en":"Semetey went on then,"},{"id":"semetey-1-2013:p1031:b004:l018","ordinal":154844,"en":"Struggling with the fourteen horses."},{"id":"semetey-1-2013:p1031:b004:l019","ordinal":154845,"en":"Zulpukor, the gift left to him"},{"id":"semetey-1-2013:p1031:b004:l020","ordinal":154846,"en":"By his gray-maned father Manas—"},{"id":"semetey-1-2013:p1031:b004:l021","ordinal":154847,"en":"He drew the sword from its sheath and swung it,"},{"id":"semetey-1-2013:p1031:b004:l022","ordinal":154848,"en":"And the wave that came straight at him"},{"id":"semetey-1-2013:p1031:b004:l023","ordinal":154849,"en":"He cut clean across."},{"id":"semetey-1-2013:p1031:b004:l024","ordinal":154850,"en":"They resisted the water,"},{"id":"semetey-1-2013:p1031:b004:l025","ordinal":154851,"en":"Fighting against the flowing current."},{"id":"semetey-1-2013:p1031:b004:l026","ordinal":154852,"en":"He gathered force like a cuckoo;"},{"id":"semetey-1-2013:p1031:b004:l027","ordinal":154853,"en":"The lion emerged from the water,"},{"id":"semetey-1-2013:p1031:b004:l028","ordinal":154854,"en":"Scolding Kulchoro."},{"id":"semetey-1-2013:p1031:b004:l029","ordinal":154855,"en":"Putting forth all his strength,"},{"id":"semetey-1-2013:p1031:b004:l030","ordinal":154856,"en":"The lion barely made it out, as you see;"},{"id":"semetey-1-2013:p1031:b004:l031","ordinal":154857,"en":"The fourteen horses that came from Ogoi"},{"id":"semetey-1-2013:p1031:b004:l032","ordinal":154858,"en":"Emerged alive, as you see."},{"id":"semetey-1-2013:p1031:b004:l033","ordinal":154859,"en":"Looming at the head of them,"},{"id":"semetey-1-2013:p1031:b004:l034","ordinal":154860,"en":"The hero came out of the Urgench."},{"id":"semetey-1-2013:p1031:b004:l035","ordinal":154861,"en":"His chosen Kyrgyz companions"},{"id":"semetey-1-2013:p1031:b004:l036","ordinal":154862,"en":"Numbered twenty-five souls;"},{"id":"semetey-1-2013:p1031:b004:l037","ordinal":154863,"en":"Each was a tiger worth a thousand men,"},{"id":"semetey-1-2013:p1031:b004:l038","ordinal":154864,"en":"And they emerged alive from the Urgench."},{"id":"semetey-1-2013:p1031:b004:l039","ordinal":154865,"en":"The lion, falcon, bloodthirsty champion,"}]
