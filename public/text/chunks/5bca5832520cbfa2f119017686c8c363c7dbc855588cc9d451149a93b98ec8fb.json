[{"id":"seytek-2012:p0600:b002:l015","ordinal":340737,"en":"If I am the consummate hero of old,"},{"id":"seytek-2012:p0600:b002:l016","ordinal":340738,"en":"If I am Semetey, son of hero Manas,"},{"id":"seytek-2012:p0600:b002:l017","ordinal":340739,"en":"And you are the foe I have sought,"},{"id":"seytek-2012:p0600:b002:l018","ordinal":340740,"en":"I will slaughter all who grapple with me;"},{"id":"seytek-2012:p0600:b002:l019","ordinal":340741,"en":"I will kill and devour them all."},{"id":"seytek-2012:p0600:b002:l020","ordinal":340742,"en":"I am the very image of ferocity,"},{"id":"seytek-2012:p0600:b002:l021","ordinal":340743,"en":"One of those who take men’s lives."},{"id":"seytek-2012:p0600:b002:l022","ordinal":340744,"en":"I am the target that steps into the arena,"},{"id":"seytek-2012:p0600:b002:l023","ordinal":340745,"en":"And I devour every soul that grapples with me."},{"id":"seytek-2012:p0600:b002:l024","ordinal":340746,"en":"I am calamity’s black eye,"},{"id":"seytek-2012:p0600:b002:l025","ordinal":340747,"en":"The blood-drinker himself."},{"id":"seytek-2012:p0600:b002:l026","ordinal":340748,"en":"You vain slave who plays the prince,"},{"id":"seytek-2012:p0600:b002:l027","ordinal":340749,"en":"Today I shall trample your head,"},{"id":"seytek-2012:p0600:b002:l028","ordinal":340750,"en":"And scatter your four kinds of livestock."},{"id":"seytek-2012:p0600:b002:l029","ordinal":340751,"en":"I shall settle your true account"},{"id":"seytek-2012:p0600:b002:l030","ordinal":340752,"en":"And utterly sack your people."},{"id":"seytek-2012:p0600:b002:l031","ordinal":340753,"en":"I shall seize your mares as plunder"},{"id":"seytek-2012:p0600:b002:l032","ordinal":340754,"en":"And bind and capture your giants."},{"id":"seytek-2012:p0600:b002:l033","ordinal":340755,"en":"If all my rage is roused,"},{"id":"seytek-2012:p0600:b002:l034","ordinal":340756,"en":"I shall crush your people"},{"id":"seytek-2012:p0600:b002:l035","ordinal":340757,"en":"And trample your broad Ala-To