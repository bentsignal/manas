[{"id":"semetey-1-2013:p1038:b004:l021","ordinal":155393,"en":"When driven to true fury,"},{"id":"semetey-1-2013:p1038:b004:l022","ordinal":155394,"en":"They say, the madman slaughters his father;"},{"id":"semetey-1-2013:p1038:b004:l023","ordinal":155395,"en":"However excellent you may be,"},{"id":"semetey-1-2013:p1038:b004:l024","ordinal":155396,"en":"Among the six Kyrgyz tribes"},{"id":"semetey-1-2013:p1038:b004:l025","ordinal":155397,"en":"They say there is no fool like you!"},{"id":"semetey-1-2013:p1038:b004:l026","ordinal":155398,"en":"To a husband born unruly,"},{"id":"semetey-1-2013:p1038:b004:l027","ordinal":155399,"en":"Let me stand yearning and speak:"},{"id":"semetey-1-2013:p1038:b004:l028","ordinal":155400,"en":"If you will not take me, do not, my murderer;"},{"id":"semetey-1-2013:p1038:b004:l029","ordinal":155401,"en":"I too shall find my equal and leave!\""},{"id":"semetey-1-2013:p1038:b004:l030","ordinal":155402,"en":"Saying this and tormenting him, Aychürök"},{"id":"semetey-1-2013:p1038:b004:l031","ordinal":155403,"en":"Was deeply hurt by the hero,"},{"id":"semetey-1-2013:p1038:b004:l032","ordinal":155404,"en":"And sobbed and wept bitterly."},{"id":"semetey-1-2013:p1038:b004:l033","ordinal":155405,"en":"Unable to draw back the mucus from her nose,"},{"id":"semetey-1-2013:p1038:b004:l034","ordinal":155406,"en":"Unable to wipe the tears from her eyes—"},{"id":"semetey-1-2013:p1038:b004:l035","ordinal":155407,"en":"Whose first ancestor was Tügöl Khan,"},{"id":"semetey-1-2013:p1038:b004:l036","ordinal":155408,"en":"Whose root was blessed by Khydyr,"},{"id":"semetey-1-2013:p1038:b004:l037","ordinal":155409,"en":"Descendant of the deathless one,"},{"id":"semetey-1-2013:p1038:b004:l038","ordinal":155410,"en":"Growing stronger whenever one died,"},{"id":"semetey-1-2013:p1038:b004:l039","ordinal":155411,"en":"Descendant of a sovereign hero:"},{"id":"semetey-1-2013:p1039:b003:l001","ordinal":155412,"en":"\"I know you, wretch;"},{"id":"semetey-1-2013:p1039:b003:l002","ordinal":155413,"en":"I know the waist you girded,"},{"id":"semetey-1-2013:p1039:b003:l003","ordinal":155414,"en":"I know, Aychürök,"},{"id":"semetey-1-2013:p1039:b003:l004","ordinal":155415,"en":"Your Chinese husband in Beijing!"},{"id":"semetey-1-2013:p1039:b003:l005","ordinal":155416,"en":"I shall break your back,"},{"id":"semetey-1-2013:p1039:b003:l006","ordinal":155417,"en":"I shall cool your breath,"},{"id":"semetey-1-2013:p1039:b003:l007","ordinal":155418,"en":"I shall drive out of you"},{"id":"semetey-1-2013:p1039:b003:l008","ordinal":155419,"en":"All your far-flung bluster—"},{"id":"semetey-1-2013:p1039:b003:l009","ordinal":155420,"en":"The husbands you sought and chose,"},{"id":"semetey-1-2013:p1039:b003:l010","ordinal":155421,"en":"Chynkozho and Toltoy!"},{"id":"semetey-1-2013:p1039:b003:l011","ordinal":155422,"en":"I shall show the strength of my arm,"},{"id":"semetey-1-2013:p1039:b003:l012","ordinal":155423,"en":"And begin many a tumult!"},{"id":"semetey-1-2013:p1039:b003:l013","ordinal":155424,"en":"I shall bring the end of the age,"},{"id":"semetey-1-2013:p1039:b003:l014","ordinal":155425,"en":"And take warrior Toltoy!"},{"id":"semetey-1-2013:p1039:b003:l015","ordinal":155426,"en":"Luckless woman who went seeking men,"},{"id":"semetey-1-2013:p1039:b003:l016","ordinal":155427,"en":"I shall take you and make you pay."},{"id":"semetey-1-2013:p1039:b003:l017","ordinal":155428,"en":"Come here without delay;"},{"id":"semetey-1-2013:p1039:b003:l018","ordinal":155429,"en":"Give me the falcon and I shall leave!\""},{"id":"semetey-1-2013:p1039:b003:l019","ordinal":155430,"en":"Your murderer grew furious"},{"id":"semetey-1-2013:p1039:b003:l020","ordinal":155431,"en":"And now stood hunched over."},{"id":"semetey-1-2013:p1039:b003:l021","ordinal":155432,"en":"From father back to forefather,"},{"id":"semetey-1-2013:p1039:b003:l022","ordinal":155433,"en":"Descendant of black-hearted men—"},{"id":"semetey-1-2013:p1039:b003:l023","ordinal":155434,"en":"\"He will leave without taking me,\" she thought,"},{"id":"semetey-1-2013:p1039:b003:l024","ordinal":155435,"en":"And God now struck Chürök."},{"id":"semetey-1-2013:p1039:b003:l025","ordinal":155436,"en":"Your dear sister-in-law wailed,"},{"id":"semetey-1-2013:p1039:b003:l026","ordinal":155437,"en":"Offended by her murderer."},{"id":"semetey-1-2013:p1039:b003:l027","ordinal":155438,"en":"Weeping hard and sobbing,"},{"id":"semetey-1-2013:p1039:b003:l028","ordinal":155439,"en":"She reeled, her knees giving way,"},{"id":"semetey-1-2013:p1039:b003:l029","ordinal":155440,"en":"Despairing of her destroyer."},{"id":"semetey-1-2013:p1039:b003:l030","ordinal":155441,"en":"In crimson gown, with a moonlike waist,"},{"id":"semetey-1-2013:p1039:b003:l031","ordinal":155442,"en":"Your graceful sister-in-law,"},{"id":"semetey-1-2013:p1039:b003:l032","ordinal":155443,"en":"Her white breast laid bare,"},{"id":"semetey-1-2013:p1039:b003:l033","ordinal":155444,"en":"Her white throat exposed,"},{"id":"semetey-1-2013:p1039:b003:l034","ordinal":155445,"en":"Reeled toward the tent,"},{"id":"semetey-1-2013:p1039:b003:l035","ordinal":155446,"en":"And her breath now went cold."},{"id":"semetey-1-2013:p1039:b003:l036","ordinal":155447,"en":"Kanchoro flew like an arrow"},{"id":"semetey-1-2013:p1039:b003:l037","ordinal":155448,"en":"And went to Külchoro."},{"id":"semetey-1-2013:p1039:b003:l038","ordinal":155449,"en":"The two companions met,"},{"id":"semetey-1-2013:p1039:b003:l039","ordinal":155450,"en":"And after endless counsel,"},{"id":"semetey-1-2013:p1039:b004:l001","ordinal":155451,"en":"They began with these words:"},{"id":"semetey-1-2013:p1039:b004:l002","ordinal":155452,"en":"\"Has our hunched-over elder brother"},{"id":"semetey-1-2013:p1039:b004:l003","ordinal":155453,"en":"Now come to grief?"},{"id":"semetey-1-2013:p1039:b004:l004","ordinal":155454,"en":"Quarreling before he has even seen her,"},{"id":"semetey-1-2013:p1039:b004:l005","ordinal":155455,"en":"Has God taken away"},{"id":"semetey-1-2013:p1039:b004:l006","ordinal":155456,"en":"Our rather arrogant prince like this?!"},{"id":"semetey-1-2013:p1039:b004:l007","ordinal":155457,"en":"If he leaves without taking Chürök,"},{"id":"semetey-1-2013:p1039:b004:l008","ordinal":155458,"en":"And we set out for Afghanistan,"},{"id":"semetey-1-2013:p1039:b004:l009","ordinal":155459,"en":"We shall face merciless turmoil,"},{"id":"semetey-1-2013:p1039:b004:l010","ordinal":155460,"en":"We shall see the end of the age."},{"id":"semetey-1-2013:p1039:b004:l011","ordinal":155461,"en":"How could we bow and plead"},{"id":"semetey-1-2013:p1039:b004:l012","ordinal":155462,"en":"With that ass-embracing woman,"},{"id":"semetey-1-2013:p1039:b004:l013","ordinal":155463,"en":"That infidel of furious temper?"},{"id":"semetey-1-2013:p1039:b004:l014","ordinal":155464,"en":"Would she not taunt and devour us:"},{"id":"semetey-1-2013:p1039:b004:l015","ordinal":155465,"en":"'The wife who went willingly"},{"id":"semetey-1-2013:p1039:b004:l016","ordinal":155466,"en":"He returned without taking,'"},{"id":"semetey-1-2013:p1039:b004:l017","ordinal":155467,"en":"Would she not devour us like this!"},{"id":"semetey-1-2013:p1039:b004:l018","ordinal":155468,"en":"My dear Külchoro,"},{"id":"semetey-1-2013:p1039:b004:l019","ordinal":155469,"en":"You were the more resourceful one,"},{"id":"semetey-1-2013:p1039:b004:l020","ordinal":155470,"en":"A ruddy, handsome-faced"},{"id":"semetey-1-2013:p1039:b004:l021","ordinal":155471,"en":"Lad skilled with maidens."},{"id":"semetey-1-2013:p1039:b004:l022","ordinal":155472,"en":"Find a way, Külchoro;"},{"id":"semetey-1-2013:p1039:b004:l023","ordinal":155473,"en":"Go to your sister-in-law,"},{"id":"semetey-1-2013:p1039:b004:l024","ordinal":155474,"en":"Speak to her with tactful words,"},{"id":"semetey-1-2013:p1039:b004:l025","ordinal":155475,"en":"And bring your sister-in-law back!\""},{"id":"semetey-1-2013:p1039:b004:l026","ordinal":155476,"en":"Külchoro flew like an arrow"},{"id":"semetey-1-2013:p1039:b004:l027","ordinal":155477,"en":"And ran to his sister-in-law;"},{"id":"semetey-1-2013:p1039:b004:l028","ordinal":155478,"en":"Kanchoro, sparing no strength,"},{"id":"semetey-1-2013:p1039:b004:l029","ordinal":155479,"en":"Ran to his elder brother."},{"id":"semetey-1-2013:p1039:b004:l030","ordinal":155480,"en":"When he reached the prince,"},{"id":"semetey-1-2013:p1039:b004:l031","ordinal":155481,"en":"Kanchoro stood and said this:"},{"id":"semetey-1-2013:p1039:b004:l032","ordinal":155482,"en":"\"Father, my dear elder brother,"},{"id":"semetey-1-2013:p1039:b004:l033","ordinal":155483,"en":"Where is your good sense?!"},{"id":"semetey-1-2013:p1039:b004:l034","ordinal":155484,"en":"When we were in Talas,"},{"id":"semetey-1-2013:p1039:b004:l035","ordinal":155485,"en":"We used to carve and eat the horse's haunch;"},{"id":"semetey-1-2013:p1039:b004:l036","ordinal":155486,"en":"We said we would subdue the governor"},{"id":"semetey-1-2013:p1039:b004:l037","ordinal":155487,"en":"Without brawling with a woman."},{"id":"semetey-1-2013:p1039:b004:l038","ordinal":155488,"en":"If we turn and go back,"},{"id":"semetey-1-2013:p1039:b004:l039","ordinal":155489,"en":"What shall we say when we arrive"}]
