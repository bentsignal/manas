[{"id":"manas-2010:p0524:b001:l014","ordinal":23809,"en":"Now take them in your hands."},{"id":"manas-2010:p0524:b001:l015","ordinal":23810,"en":"A fierce enemy hero has arisen;"},{"id":"manas-2010:p0524:b001:l016","ordinal":23811,"en":"From the Burut, lion Manas has arisen."},{"id":"manas-2010:p0524:b001:l017","ordinal":23812,"en":"Do not let him reach this Beijing;"},{"id":"manas-2010:p0524:b001:l018","ordinal":23813,"en":"Repel him and guard the people!"},{"id":"manas-2010:p0524:b001:l019","ordinal":23814,"en":"If you are fierce, if you are a hero,"},{"id":"manas-2010:p0524:b001:l020","ordinal":23815,"en":"If you are Khan Kongurbay,"},{"id":"manas-2010:p0524:b001:l021","ordinal":23816,"en":"We will look to you as our protector."},{"id":"manas-2010:p0524:b001:l022","ordinal":23817,"en":"If you are a timid boy who flees,"},{"id":"manas-2010:p0524:b001:l023","ordinal":23818,"en":"We will ride you as a black donkey!"},{"id":"manas-2010:p0524:b001:l024","ordinal":23819,"en":"Keep the people in mind,"},{"id":"manas-2010:p0524:b001:l025","ordinal":23820,"en":"Keep your eye upon the watch."},{"id":"manas-2010:p0524:b001:l026","ordinal":23821,"en":"A grievous, difficult day has come;"},{"id":"manas-2010:p0524:b001:l027","ordinal":23822,"en":"Protect us from it."},{"id":"manas-2010:p0524:b001:l028","ordinal":23823,"en":"To Chin-Machin and Beijing,"},{"id":"manas-2010:p0524:b001:l029","ordinal":23824,"en":"Become a true father!"},{"id":"manas-2010:p0524:b001:l030","ordinal":23825,"en":"You are my hope, you are my support."},{"id":"manas-2010:p0524:b001:l031","ordinal":23826,"en":"Offering firm resistance to the Burut,"},{"id":"manas-2010:p0524:b001:l032","ordinal":23827,"en":"You are my lion who will face him."},{"id":"manas-2010:p0524:b001:l033","ordinal":23828,"en":"Ah, my colt, Kongurbay,"},{"id":"manas-2010:p0524:b001:l034","ordinal":23829,"en":"Choose the giants from the governors."},{"id":"manas-2010:p0524:b001:l035","ordinal":23830,"en":"Do not let the vast people be slaughtered;"},{"id":"manas-2010:p0524:b001:l036","ordinal":23831,"en":"Keep watch over this Beijing!"},{"id":"manas-2010:p0524:b001:l037","ordinal":23832,"en":"Hero Kongurbay, great grim-looking one,"},{"id":"manas-2010:p0524:b001:l038","ordinal":23833,"en":"I will agree to what you say."},{"id":"manas-2010:p0524:b001:l039","ordinal":23834,"en":"Of this Chinese people of forty clans,"},{"id":"manas-2010:p0524:b001:l040","ordinal":23835,"en":"I will give you one khanate."},{"id":"manas-2010:p0524:b001:l041","ordinal":23836,"en":"Hear what I say."},{"id":"manas-2010:p0524:b001:l042","ordinal":23837,"en":"They are a people mighty in battle;"},{"id":"manas-2010:p0525:b001:l001","ordinal":23838,"en":"Take the khanship of the monks!”"},{"id":"manas-2010:p0525:b001:l002","ordinal":23839,"en":"Khan Esenkan said this,"},{"id":"manas-2010:p0525:b001:l003","ordinal":23840,"en":"Making his worth known to the people."},{"id":"manas-2010:p0525:b001:l004","ordinal":23841,"en":"His arm guards spread broad,"},{"id":"manas-2010:p0525:b001:l005","ordinal":23842,"en":"Upon hero Kongur's head"},{"id":"manas-2010:p0525:b001:l006","ordinal":23843,"en":"He placed the monks' gemstone badge."},{"id":"manas-2010:p0525:b001:l007","ordinal":23844,"en":"The monks' stone suited him;"},{"id":"manas-2010:p0525:b001:l008","ordinal":23845,"en":"He made him a house built on the upland."},{"id":"manas-2010:p0525:b001:l009","ordinal":23846,"en":"“Of Chin-Machin and Kakan,"},{"id":"manas-2010:p0525:b001:l010","ordinal":23847,"en":"Ah, my colt, Kongurbay,"},{"id":"manas-2010:p0525:b001:l011","ordinal":23848,"en":"Watch closely and scout the roads,” he said."},{"id":"manas-2010:p0525:b001:l012","ordinal":23849,"en":"“From the fierce-wrathed blood-drinker,"},{"id":"manas-2010:p0525:b001:l013","ordinal":23850,"en":"From the deceiver who left Altay,"},{"id":"manas-2010:p0525:b001:l014","ordinal":23851,"en":"If you have the means, Kongurbay,"},{"id":"manas-2010:p0525:b001:l015","ordinal":23852,"en":"Free and rescue us,” he said."},{"id":"manas-2010:p0525:b001:l016","ordinal":23853,"en":"Clothing him in a coat no shot could pierce,"},{"id":"manas-2010:p0525:b001:l017","ordinal":23854,"en":"Esenkan was a mighty lord."},{"id":"manas-2010:p0525:b001:l018","ordinal":23855,"en":"Making Manas's circumstances known,"},{"id":"manas-2010:p0525:b001:l019","ordinal":23856,"en":"He advanced his counsel far."},{"id":"manas-2010:p0525:b001:l020","ordinal":23857,"en":"The suspected road where Manas would come,"},{"id":"manas-2010:p0525:b001:l021","ordinal":23858,"en":"He had Kongurbay block."},{"id":"manas-2010:p0525:b001:l022","ordinal":23859,"en":"Six thousand Chinese, countless governors,"},{"id":"manas-2010:p0525:b001:l023","ordinal":23860,"en":"Their chief was Kongurbay."},{"id":"manas-2010:p0525:b001:l024","ordinal":23861,"en":"On the nearer side of him,"},{"id":"manas-2010:p0525:b001:l025","ordinal":23862,"en":"Born in Manguba,"},{"id":"manas-2010:p0525:b001:l026","ordinal":23863,"en":"Upon all the world,"},{"id":"manas-2010:p0525:b001:l027","ordinal":23864,"en":"He had brought extraordinary uproar."},{"id":"manas-2010:p0525:b001:l028","ordinal":23865,"en":"He had speech no human knew;"},{"id":"manas-2010:p0525:b001:l029","ordinal":23866,"en":"He had a single eye in his head."},{"id":"manas-2010:p0525:b001:l030","ordinal":23867,"en":"He spared no soul he fought."},{"id":"manas-2010:p0525:b001:l031","ordinal":23868,"en":"The meat of a single pig"},{"id":"manas-2010:p0525:b001:l032","ordinal":23869,"en":"Could not fill him at one meal."},{"id":"manas-2010:p0525:b001:l033","ordinal":23870,"en":"If you looked at his nose,"},{"id":"manas-2010:p0525:b001:l034","ordinal":23871,"en":"Its shape and appearance,"},{"id":"manas-2010:p0525:b001:l035","ordinal":23872,"en":"The nostril of his nose"},{"id":"manas-2010:p0525:b001:l036","ordinal":23873,"en":"Was like an uncovered storage pit."},{"id":"manas-2010:p0525:b001:l037","ordinal":23874,"en":"The black brow above his eye"},{"id":"manas-2010:p0525:b001:l038","ordinal":23875,"en":"Was like salt ground trampled by livestock."},{"id":"manas-2010:p0525:b001:l039","ordinal":23876,"en":"He would eat those he encountered."},{"id":"manas-2010:p0525:b001:l040","ordinal":23877,"en":"Kakan-Chin's wrestler"},{"id":"manas-2010:p0525:b001:l041","ordinal":23878,"en":"Was called Maamytbek the One-Eyed."},{"id":"manas-2010:p0525:b001:l042","ordinal":23879,"en":"He would unleash a fierce fury."},{"id":"manas-2010:p0526:b001:l001","ordinal":23880,"en":"Whoever challenged him,"},{"id":"manas-2010:p0526:b001:l002","ordinal":23881,"en":"He would tear off his head."},{"id":"manas-2010:p0526:b001:l003","ordinal":23882,"en":"His appointed partner on watch,"},{"id":"manas-2010:p0526:b001:l004","ordinal":23883,"en":"Of that daughter-damned swine,"},{"id":"manas-2010:p0526:b001:l005","ordinal":23884,"en":"Maamytbek became the companion."},{"id":"manas-2010:p0526:b001:l006","ordinal":23885,"en":"Maamytbek's champion—"},{"id":"manas-2010:p0526:b001:l007","ordinal":23886,"en":"If champions gathered to face him,"},{"id":"manas-2010:p0526:b001:l008","ordinal":23887,"en":"They would be torn to shreds."},{"id":"manas-2010:p0526:b001:l009","ordinal":23888,"en":"His prowess was extraordinary;"},{"id":"manas-2010:p0526:b001:l010","ordinal":23889,"en":"When he struggled in wrath,"},{"id":"manas-2010:p0526:b001:l011","ordinal":23890,"en":"He brought down steep-sided mountains."},{"id":"manas-2010:p0526:b001:l012","ordinal":23891,"en":"When he faced them and attacked,"},{"id":"manas-2010:p0526:b001:l013","ordinal":23892,"en":"He laid plane trees low."},{"id":"manas-2010:p0526:b001:l014","ordinal":23893,"en":"Those who heard his name were afraid!"},{"id":"manas-2010:p0526:b001:l015","ordinal":23894,"en":"“Somehow find a way against him."},{"id":"manas-2010:p0526:b001:l016","ordinal":23895,"en":"If you meet the bloodthirsty Burut,"},{"id":"manas-2010:p0526:b001:l017","ordinal":23896,"en":"Strike him with your battle-axe."},{"id":"manas-2010:p0526:b001:l018","ordinal":23897,"en":"Without shrinking, against that bloodthirsty one,"},{"id":"manas-2010:p0526:b001:l019","ordinal":23898,"en":"Find some means!"},{"id":"manas-2010:p0526:b001:l020","ordinal":23899,"en":"You are my support raised up in Beijing,"},{"id":"manas-2010:p0526:b001:l021","ordinal":23900,"en":"You are the warrior I firmly trust."},{"id":"manas-2010:p0526:b001:l022","ordinal":23901,"en":"If the Burut comes to grapple,"},{"id":"manas-2010:p0526:b001:l023","ordinal":23902,"en":"You are my lion who will give me courage!”"},{"id":"manas-2010:p0526:b001:l024","ordinal":23903,"en":"He dressed him in a gray-flowered coat,"},{"id":"manas-2010:p0526:b001:l025","ordinal":23904,"en":"Mounted him upon a gray mule."},{"id":"manas-2010:p0526:b001:l026","ordinal":23905,"en":"He gave him a coat no shot could pierce."},{"id":"manas-2010:p0526:b001:l027","ordinal":23906,"en":"From spearmen, from skillful men,"},{"id":"manas-2010:p0526:b001:l028","ordinal":23907,"en":"From seasoned men who could devise counsel,"},{"id":"manas-2010:p0526:b001:l029","ordinal":23908,"en":"He gave exactly forty Kalmyk troops."},{"id":"manas-2010:p0526:b001:l030","ordinal":23909,"en":"He made him know what he did not know,"},{"id":"manas-2010:p0526:b001:l031","ordinal":23910,"en":"Instructed him and set him on the road."},{"id":"manas-2010:p0526:b001:l032","ordinal":23911,"en":"He readied his skillful men."},{"id":"manas-2010:p0526:b001:l033","ordinal":23912,"en":"Against Khan Manas's coming,"},{"id":"manas-2010:p0526:b001:l034","ordinal":23913,"en":"The Chinese left nothing unprepared."},{"id":"manas-2010:p0526:b001:l035","ordinal":23914,"en":"He admonished his heroes,"},{"id":"manas-2010:p0526:b001:l036","ordinal":23915,"en":"Made his watch firm as stone."},{"id":"manas-2010:p0526:b001:l037","ordinal":23916,"en":"The finest of the watchmen,"},{"id":"manas-2010:p0526:b001:l038","ordinal":23917,"en":"Kongurbay, khan of the Kalmyks,"},{"id":"manas-2010:p0526:b001:l039","ordinal":23918,"en":"Admonished his Kalmyks."},{"id":"manas-2010:p0526:b001:l040","ordinal":23919,"en":"One-eyed Mamytbek,"},{"id":"manas-2010:p0526:b001:l041","ordinal":23920,"en":"Kanyshay with an armful of ass—"},{"id":"manas-2010:p0526:b001:l042","ordinal":23921,"en":"They made the watch secure."},{"id":"manas-2010:p0527:b001:l001","ordinal":23922,"en":"No mortal came to grapple;"},{"id":"manas-2010:p0527:b001:l002","ordinal":23923,"en":"No one had ventured there and seen."},{"id":"manas-2010:p0527:b001:l003","ordinal":23924,"en":"Gray rolling hills and level ridges"},{"id":"manas-2010:p0527:b001:l004","ordinal":23925,"en":"Became mountains to approach with care."},{"id":"manas-2010:p0527:b001:l005","ordinal":23926,"en":"Alöökö's Kongurbay,"},{"id":"manas-2010:p0527:b001:l006","ordinal":23927,"en":"Even if he died, there was no regret."},{"id":"manas-2010:p0527:b001:l007","ordinal":23928,"en":"Against his wrath, no soul could stand;"},{"id":"manas-2010:p0527:b001:l008","ordinal":23929,"en":"None remained to answer him back."},{"id":"manas-2010:p0527:b001:l009","ordinal":23930,"en":"The black horse beneath him,"},{"id":"manas-2010:p0527:b001:l010","ordinal":23931,"en":"That black horse had"},{"id":"manas-2010:p0527:b001:l011","ordinal":23932,"en":"Wings upon its flanks."},{"id":"manas-2010:p0527:b001:l012","ordinal":23933,"en":"Whom ears had heard of and eyes had seen,"},{"id":"manas-2010:p0527:b001:l013","ordinal":23934,"en":"Among the created sons of men,"},{"id":"manas-2010:p0527:b001:l014","ordinal":23935,"en":"Alöökö's Kongurbay"},{"id":"manas-2010:p0527:b001:l015","ordinal":23936,"en":"Had a habit of crushing them like flour."},{"id":"manas-2010:p0527:b001:l016","ordinal":23937,"en":"Dust rose from his movements;"},{"id":"manas-2010:p0527:b001:l017","ordinal":23938,"en":"That formidable gray-maned warrior's"},{"id":"manas-2010:p0527:b001:l018","ordinal":23939,"en":"Voice drove souls out of bodies."},{"id":"manas-2010:p0527:b001:l019","ordinal":23940,"en":"He built houses within a raised fortress."},{"id":"manas-2010:p0527:b001:l020","ordinal":23941,"en":"So much above Esenkan,"},{"id":"manas-2010:p0527:b001:l021","ordinal":23942,"en":"In strength above Kün Jangjung,"},{"id":"manas-2010:p0527:b001:l022","ordinal":23943,"en":"In fame greater than Ay Jangjung,"},{"id":"manas-2010:p0527:b001:l023","ordinal":23944,"en":"Girding himself in readiness,"},{"id":"manas-2010:p0527:b001:l024","ordinal":23945,"en":"Swaying as though a spirit had struck him,"},{"id":"manas-2010:p0527:b001:l025","ordinal":23946,"en":"The creature came out of Beijing."},{"id":"manas-2010:p0527:b001:l026","ordinal":23947,"en":"He unleashed fierce wrath;"},{"id":"manas-2010:p0527:b001:l027","ordinal":23948,"en":"The Chinese who answered him back,"},{"id":"manas-2010:p0527:b001:l028","ordinal":23949,"en":"He slaughtered utterly."},{"id":"manas-2010:p0527:b001:l029","ordinal":23950,"en":"Dust rose from his voice;"},{"id":"manas-2010:p0527:b001:l030","ordinal":23951,"en":"Souls fled before his fury."},{"id":"manas-2010:p0527:b001:l031","ordinal":23952,"en":"Two reins and one lead rope,"},{"id":"manas-2010:p0527:b001:l032","ordinal":23953,"en":"He now took into his hand."},{"id":"manas-2010:p0527:b001:l033","ordinal":23954,"en":"Over Chin-Machin and Beijing,"},{"id":"manas-2010:p0527:b001:l034","ordinal":23955,"en":"Over the true Chinese empire and Tungshang,"},{"id":"manas-2010:p0527:b001:l035","ordinal":23956,"en":"Alöökö's Kongurbay"},{"id":"manas-2010:p0527:b001:l036","ordinal":23957,"en":"Became lord of all these."},{"id":"manas-2010:p0527:b001:l037","ordinal":23958,"en":"Taking authority over the governors,"},{"id":"manas-2010:p0527:b001:l038","ordinal":23959,"en":"He became khan of the Kalmyks."},{"id":"manas-2010:p0527:b001:l039","ordinal":23960,"en":"Even if he died, there was no regret."},{"id":"manas-2010:p0527:b001:l040","ordinal":23961,"en":"Alöökö's Kongurbay,"},{"id":"manas-2010:p0527:b001:l041","ordinal":23962,"en":"Among the Chinese people now,"},{"id":"manas-2010:p0527:b001:l042","ordinal":23963,"en":"None remained to answer him back."},{"id":"manas-2010:p0528:b001:l001","ordinal":23964,"en":"A surpassingly cunning elder,"},{"id":"manas-2010:p0528:b001:l002","ordinal":23965,"en":"Among the Chinese, the peoples of forty khans,"},{"id":"manas-2010:p0528:b001:l003","ordinal":23966,"en":"There was no leader like that formidable one."},{"id":"manas-2010:p0528:b001:l004","ordinal":23967,"en":"His spoken word was deemed right."},{"id":"manas-2010:p0528:b001:l005","ordinal":23968,"en":"Alöökö's Kongurbay,"},{"id":"manas-2010:p0528:b001:l006","ordinal":23969,"en":"For Beijing of weighty renown,"},{"id":"manas-2010:p0528:b001:l007","ordinal":23970,"en":"Became an iron-walled stronghold."},{"id":"manas-2010:p0528:b001:l008","ordinal":23971,"en":"Their lords in jackets"},{"id":"manas-2010:p0528:b001:l009","ordinal":23972,"en":"Bent their knees to the earth."},{"id":"manas-2010:p0528:b001:l010","ordinal":23973,"en":"“Master, what have we done?” they said,"},{"id":"manas-2010:p0528:b001:l011","ordinal":23974,"en":"Before Kongurbay,"},{"id":"manas-2010:p0528:b001:l012","ordinal":23975,"en":"Bowing in reverence."},{"id":"manas-2010:p0528:b001:l013","ordinal":23976,"en":"Outer Beijing submitted to him."},{"id":"manas-2010:p0528:b001:l014","ordinal":23977,"en":"Those who provoked his wrath,"},{"id":"manas-2010:p0528:b001:l015","ordinal":23978,"en":"He beat with resounding blows."},{"id":"manas-2010:p0528:b001:l016","ordinal":23979,"en":"When the people of Deep Beijing gathered,"},{"id":"manas-2010:p0528:b001:l017","ordinal":23980,"en":"Before that formidable one then,"},{"id":"manas-2010:p0528:b001:l018","ordinal":23981,"en":"None remained to speak in answer."},{"id":"manas-2010:p0528:b001:l019","ordinal":23982,"en":"Securing the road to Outer Beijing,"},{"id":"manas-2010:p0528:b001:l020","ordinal":23983,"en":"He lay there, proudly reclining."},{"id":"manas-2010:p0528:b001:l021","ordinal":23984,"en":"That formidable one's encampment—"},{"id":"manas-2010:p0528:b001:l022","ordinal":23985,"en":"Now let us begin again"},{"id":"manas-2010:p0528:b001:l023","ordinal":23986,"en":"The tale of leopard Manas."},{"id":"manas-2010:p0528:b003:l001","ordinal":23987,"en":"Then Manas, that mighty lion,"},{"id":"manas-2010:p0528:b003:l002","ordinal":23988,"en":"Upon Black Kalmyks and Manchus,"},{"id":"manas-2010:p0528:b003:l003","ordinal":23989,"en":"Wrought a terrible slaughter."},{"id":"manas-2010:p0528:b003:l004","ordinal":23990,"en":"All forty households,"},{"id":"manas-2010:p0528:b003:l005","ordinal":23991,"en":"Akbaltay and aged Jakyp,"},{"id":"manas-2010:p0528:b003:l006","ordinal":23992,"en":"He rescued them."},{"id":"manas-2010:p0528:b003:l007","ordinal":23993,"en":"Driving white deer, making them cattle,"},{"id":"manas-2010:p0528:b003:l008","ordinal":23994,"en":"The Black Kalmyks and Manchus,"},{"id":"manas-2010:p0528:b003:l009","ordinal":23995,"en":"Driving and slaughtering, throwing them into uproar,"},{"id":"manas-2010:p0528:b003:l010","ordinal":23996,"en":"Shooting blue deer, making them cattle,"},{"id":"manas-2010:p0528:b003:l011","ordinal":23997,"en":"Throwing the enemy he faced into uproar,"},{"id":"manas-2010:p0528:b003:l012","ordinal":23998,"en":"Hardened by drinking blood,"},{"id":"manas-2010:p0528:b003:l013","ordinal":23999,"en":"When he reached twelve,"},{"id":"manas-2010:p0528:b003:l014","ordinal":24000,"en":"Breaking royal courts and taking spoils,"},{"id":"manas-2010:p0528:b003:l015","ordinal":24001,"en":"He was named the bloodthirsty Burut."},{"id":"manas-2010:p0529:b001:l001","ordinal":24002,"en":"When he charged in his wrath,"},{"id":"manas-2010:p0529:b001:l002","ordinal":24003,"en":"Writhing like a lion,"},{"id":"manas-2010:p0529:b001:l003","ordinal":24004,"en":"Hearing the fame of Manas,"},{"id":"manas-2010:p0529:b001:l004","ordinal":24005,"en":"Beijing's great, mighty khan,"},{"id":"manas-2010:p0529:b001:l005","ordinal":24006,"en":"Karykan of Beijing awoke."},{"id":"manas-2010:p0529:b001:l006","ordinal":24007,"en":"His spear to white steel,"},{"id":"manas-2010:p0529:b001:l007","ordinal":24008,"en":"Fitting it, he rose a giant."},{"id":"manas-2010:p0529:b001:l008","ordinal":24009,"en":"Over the small Kyrgyz people of forty households,"},{"id":"manas-2010:p0529:b001:l009","ordinal":24010,"en":"Leopard Manas became master."},{"id":"manas-2010:p0529:b001:l010","ordinal":24011,"en":"By the forty-tribed Chinese and Manchus,"},{"id":"manas-2010:p0529:b001:l011","ordinal":24012,"en":"He let none strike them from the ridge side."},{"id":"manas-2010:p0529:b001:l012","ordinal":24013,"en":"To the swarming Chinese,"},{"id":"manas-2010:p0529:b001:l013","ordinal":24014,"en":"He yielded not so much as a hair."},{"id":"manas-2010:p0529:b001:l014","ordinal":24015,"en":"Not tribute, not even food did he give."},{"id":"manas-2010:p0529:b001:l015","ordinal":24016,"en":"To the vast forty-tribed Chinese people,"},{"id":"manas-2010:p0529:b001:l016","ordinal":24017,"en":"Valiant Manas then"},{"id":"manas-2010:p0529:b001:l017","ordinal":24018,"en":"Migrated without bowing his head."},{"id":"manas-2010:p0529:b001:l018","ordinal":24019,"en":"The Kyrgyz under oppression,"},{"id":"manas-2010:p0529:b001:l019","ordinal":24020,"en":"For the sake of those Kyrgyz,"},{"id":"manas-2010:p0529:b001:l020","ordinal":24021,"en":"Upon the swarming Chinese,"},{"id":"manas-2010:p0529:b001:l021","ordinal":24022,"en":"He wrought much slaughter."},{"id":"manas-2010:p0529:b001:l022","ordinal":24023,"en":"When he reached twelve,"},{"id":"manas-2010:p0529:b001:l023","ordinal":24024,"en":"Breaking royal courts and firing shots,"},{"id":"manas-2010:p0529:b001:l024","ordinal":24025,"en":"Not bowing to the people of royal courts,"},{"id":"manas-2010:p0529:b001:l025","ordinal":24026,"en":"The Kyrgyz, small as a palm,"},{"id":"manas-2010:p0529:b001:l026","ordinal":24027,"en":"He rescued them."},{"id":"manas-2010:p0529:b001:l027","ordinal":24028,"en":"When the forty Kyrgyz households migrated,"},{"id":"manas-2010:p0529:b001:l028","ordinal":24029,"en":"Their saddlecloth fringes brushed the earth."},{"id":"manas-2010:p0529:b001:l029","ordinal":24030,"en":"They had grown fully rich."},{"id":"manas-2010:p0529:b001:l030","ordinal":24031,"en":"Emerging with strong support, warrior Manas"},{"id":"manas-2010:p0529:b001:l031","ordinal":24032,"en":"The Kyrgyz households then"},{"id":"manas-2010:p0529:b001:l032","ordinal":24033,"en":"Made prosper as they wished."},{"id":"manas-2010:p0529:b001:l033","ordinal":24034,"en":"All their chests"},{"id":"manas-2010:p0529:b001:l034","ordinal":24035,"en":"He filled with yellow gold."},{"id":"manas-2010:p0529:b001:l035","ordinal":24036,"en":"He fulfilled their hearts' desires;"},{"id":"manas-2010:p0529:b001:l036","ordinal":24037,"en":"All their little chests"},{"id":"manas-2010:p0529:b001:l037","ordinal":24038,"en":"He filled with much gold."},{"id":"manas-2010:p0529:b001:l038","ordinal":24039,"en":"He made their wall felts rich with grease;"},{"id":"manas-2010:p0529:b001:l039","ordinal":24040,"en":"The Kyrgyz he encountered,"},{"id":"manas-2010:p0529:b001:l040","ordinal":24041,"en":"He made immeasurably rich."},{"id":"manas-2010:p0529:b001:l041","ordinal":24042,"en":"The forty Kyrgyz households held their heads high;"},{"id":"manas-2010:p0529:b001:l042","ordinal":24043,"en":"Their fortunes had improved,"},{"id":"manas-2010:p0530:b001:l001","ordinal":24044,"en":"Fermented mare's milk by day, girls by night—"},{"id":"manas-2010:p0530:b001:l002","ordinal":24045,"en":"Such had become their life."},{"id":"manas-2010:p0530:b001:l003","ordinal":24046,"en":"Migrating freely, settling at ease,"},{"id":"manas-2010:p0530:b001:l004","ordinal":24047,"en":"Slaughtering colts nursed by barren mares,"},{"id":"manas-2010:p0530:b001:l005","ordinal":24048,"en":"Playing knucklebones, raising cheers,"},{"id":"manas-2010:p0530:b001:l006","ordinal":24049,"en":"Playing chess, raising dust,"},{"id":"manas-2010:p0530:b001:l007","ordinal":24050,"en":"Whole otter pelts"},{"id":"manas-2010:p0530:b001:l008","ordinal":24051,"en":"They divided in half."},{"id":"manas-2010:p0530:b001:l009","ordinal":24052,"en":"“God has lifted our misfortune,” they said,"},{"id":"manas-2010:p0530:b001:l010","ordinal":24053,"en":"And put them on their trouser cuffs."},{"id":"manas-2010:p0530:b001:l011","ordinal":24054,"en":"While valiant Manas was there,"},{"id":"manas-2010:p0530:b001:l012","ordinal":24055,"en":"From the swarming Chinese,"},{"id":"manas-2010:p0530:b001:l013","ordinal":24056,"en":"They took red-tailed camels."},{"id":"manas-2010:p0530:b001:l014","ordinal":24057,"en":"They were not Kyrgyz then,"},{"id":"manas-2010:p0530:b001:l015","ordinal":24058,"en":"While their precious Manas was there,"},{"id":"manas-2010:p0530:b001:l016","ordinal":24059,"en":"Taking livestock enough for ages."},{"id":"manas-2010:p0530:b001:l017","ordinal":24060,"en":"When they drove their horses,"},{"id":"manas-2010:p0530:b001:l018","ordinal":24061,"en":"On the hills, the horses were splendid;"},{"id":"manas-2010:p0530:b001:l019","ordinal":24062,"en":"Among those horses,"},{"id":"manas-2010:p0530:b001:l020","ordinal":24063,"en":"Fine-bred steeds and coursers mingled."},{"id":"manas-2010:p0530:b001:l021","ordinal":24064,"en":"While magnanimous Manas was there,"}]
