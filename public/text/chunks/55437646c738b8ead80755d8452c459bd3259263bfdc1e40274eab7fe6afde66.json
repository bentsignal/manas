[{"id":"manas-2010:p0768:b001:l032","ordinal":34049,"en":"Of devastating champion Manas"},{"id":"manas-2010:p0768:b001:l033","ordinal":34050,"en":"The confidant who shared his death."},{"id":"manas-2010:p0768:b001:l034","ordinal":34051,"en":"Encountered among strangers,"},{"id":"manas-2010:p0768:b001:l035","ordinal":34052,"en":"For the blood-stained man of exceptional fortune"},{"id":"manas-2010:p0768:b001:l036","ordinal":34053,"en":"He proved a faithful companion."},{"id":"manas-2010:p0768:b001:l037","ordinal":34054,"en":"His elder, wolf-man Bakay,"},{"id":"manas-2010:p0768:b001:l038","ordinal":34055,"en":"Who stirred wisdom from the unseen,"},{"id":"manas-2010:p0768:b001:l039","ordinal":34056,"en":"Behold his sagacity!"},{"id":"manas-2010:p0768:b001:l040","ordinal":34057,"en":"Poor Sultan Manas,"},{"id":"manas-2010:p0768:b001:l041","ordinal":34058,"en":"By leading him along he made a warrior,"},{"id":"manas-2010:p0768:b001:l042","ordinal":34059,"en":"Made him equal to warriors' sons."},{"id":"manas-2010:p0769:b001:l001","ordinal":34060,"en":"He built a fortress dwelling in Talas;"},{"id":"manas-2010:p0769:b001:l002","ordinal":34061,"en":"Overthrowing Alöökö,"},{"id":"manas-2010:p0769:b001:l003","ordinal":34062,"en":"Magnanimous lord Manas"},{"id":"manas-2010:p0769:b001:l004","ordinal":34063,"en":"He made khan over eight khans."},{"id":"manas-2010:p0769:b001:l005","ordinal":34064,"en":"When he faced the enemy,"},{"id":"manas-2010:p0769:b001:l006","ordinal":34065,"en":"Lion Manas the leopard"},{"id":"manas-2010:p0769:b001:l007","ordinal":34066,"en":"Crawled forward like a lion."},{"id":"manas-2010:p0769:b001:l008","ordinal":34067,"en":"What his elder Bakay said,"},{"id":"manas-2010:p0769:b001:l009","ordinal":34068,"en":"The lion lord, the leopard,"},{"id":"manas-2010:p0769:b001:l010","ordinal":34069,"en":"Never made him say twice."},{"id":"manas-2010:p0769:b001:l011","ordinal":34070,"en":"“Agreed, elder, agreed,” he said."},{"id":"manas-2010:p0769:b001:l012","ordinal":34071,"en":"Taking a banner with a golden crescent,"},{"id":"manas-2010:p0769:b001:l013","ordinal":34072,"en":"To fight with Shooruk,"},{"id":"manas-2010:p0769:b001:l014","ordinal":34073,"en":"Taking ammunition loaded on elephants,"},{"id":"manas-2010:p0769:b001:l015","ordinal":34074,"en":"Khan Manas's forty wolves,"},{"id":"manas-2010:p0769:b001:l016","ordinal":34075,"en":"Taking them all together,"},{"id":"manas-2010:p0769:b001:l017","ordinal":34076,"en":"The uneven dark mountains,"},{"id":"manas-2010:p0769:b001:l018","ordinal":34077,"en":"Skirting those dark mountains,"},{"id":"manas-2010:p0769:b001:l019","ordinal":34078,"en":"All the finest thoroughbreds"},{"id":"manas-2010:p0769:b001:l020","ordinal":34079,"en":"They shod afresh."},{"id":"manas-2010:p0769:b001:l021","ordinal":34080,"en":"Setting out, seeking an enemy,"},{"id":"manas-2010:p0769:b001:l022","ordinal":34081,"en":"Wearing horses out, scouting the land,"},{"id":"manas-2010:p0769:b001:l023","ordinal":34082,"en":"Mighty wolf-man Manas was there,"},{"id":"manas-2010:p0769:b001:l024","ordinal":34083,"en":"All the mighty men were there."},{"id":"manas-2010:p0769:b001:l025","ordinal":34084,"en":"The formidable one of forty companions,"},{"id":"manas-2010:p0769:b001:l026","ordinal":34085,"en":"Dear old Bakay was there."},{"id":"manas-2010:p0769:b001:l027","ordinal":34086,"en":"Crossing uneven ridges,"},{"id":"manas-2010:p0769:b001:l028","ordinal":34087,"en":"Traversing parched riverbeds,"},{"id":"manas-2010:p0769:b001:l029","ordinal":34088,"en":"They crossed broad Kakshaal,"},{"id":"manas-2010:p0769:b001:l030","ordinal":34089,"en":"They passed over Kum-Talaa."},{"id":"manas-2010:p0769:b001:l031","ordinal":34090,"en":"Looking beyond,"},{"id":"manas-2010:p0769:b001:l032","ordinal":34091,"en":"Haze stretched beyond the eye's reach."},{"id":"manas-2010:p0769:b001:l033","ordinal":34092,"en":"Wolf-man Manas the leopard,"},{"id":"manas-2010:p0769:b001:l034","ordinal":34093,"en":"Peering, could make out no land."},{"id":"manas-2010:p0769:b001:l035","ordinal":34094,"en":"Across the boundless plain,"},{"id":"manas-2010:p0769:b001:l036","ordinal":34095,"en":"Rushing headlong in haste,"},{"id":"manas-2010:p0769:b001:l037","ordinal":34096,"en":"All the finest thoroughbreds'"},{"id":"manas-2010:p0769:b001:l038","ordinal":34097,"en":"Eyes they opened by racing them."},{"id":"manas-2010:p0769:b001:l039","ordinal":34098,"en":"Without tiring or growing weary,"},{"id":"manas-2010:p0769:b001:l040","ordinal":34099,"en":"Your champions traveled,"},{"id":"manas-2010:p0769:b001:l041","ordinal":34100,"en":"Sparing no horses, traveling far,"},{"id":"manas-2010:p0769:b001:l042","ordinal":34101,"en":"Standards fluttering in their hands."},{"id":"manas-2010:p0770:b001:l001","ordinal":34102,"en":"Sweat coming out like black mud"},{"id":"manas-2010:p0770:b001:l002","ordinal":34103,"en":"Splashed as they spurred."},{"id":"manas-2010:p0770:b001:l003","ordinal":34104,"en":"When the winged steeds traveled hard,"},{"id":"manas-2010:p0770:b001:l004","ordinal":34105,"en":"Clear sweat came, running thin."},{"id":"manas-2010:p0770:b001:l005","ordinal":34106,"en":"The sweat flowing from their saddle pads"},{"id":"manas-2010:p0770:b001:l006","ordinal":34107,"en":"Poured down their chests."},{"id":"manas-2010:p0770:b001:l007","ordinal":34108,"en":"To Kayypchy's ridge,"},{"id":"manas-2010:p0770:b001:l008","ordinal":34109,"en":"They called it Kangkung shrine,"},{"id":"manas-2010:p0770:b001:l009","ordinal":34110,"en":"On this nearer edge of Khotan,"},{"id":"manas-2010:p0770:b001:l010","ordinal":34111,"en":"To the plane tree among the poplars,"},{"id":"manas-2010:p0770:b001:l011","ordinal":34112,"en":"The leopard now arrived and camped."},{"id":"manas-2010:p0770:b001:l012","ordinal":34113,"en":"To the fine dark-hazed place"},{"id":"manas-2010:p0770:b001:l013","ordinal":34114,"en":"The lord turned to make camp."},{"id":"manas-2010:p0770:b001:l014","ordinal":34115,"en":"The dear lion, proud as a rooster,"},{"id":"manas-2010:p0770:b001:l015","ordinal":34116,"en":"That was the place he would camp."},{"id":"manas-2010:p0770:b001:l016","ordinal":34117,"en":"Taking his troops behind him,"},{"id":"manas-2010:p0770:b001:l017","ordinal":34118,"en":"The forty men born resourceful"},{"id":"manas-2010:p0770:b001:l018","ordinal":34119,"en":"Spread out their possessions,"},{"id":"manas-2010:p0770:b001:l019","ordinal":34120,"en":"Set the traveling cauldron boiling."},{"id":"manas-2010:p0770:b001:l020","ordinal":34121,"en":"Red raisins, excellent food,"},{"id":"manas-2010:p0770:b001:l021","ordinal":34122,"en":"They camped on the open plain,"},{"id":"manas-2010:p0770:b001:l022","ordinal":34123,"en":"All the mighty men together."},{"id":"manas-2010:p0770:b001:l023","ordinal":34124,"en":"The blood-stained lord; Khan Bakay,"},{"id":"manas-2010:p0770:b001:l024","ordinal":34125,"en":"Argyn Khan's Ajybay,"},{"id":"manas-2010:p0770:b001:l025","ordinal":34126,"en":"Old Kyrgyl, head of the forty,"},{"id":"manas-2010:p0770:b001:l026","ordinal":34127,"en":"These four among the mighty men,"},{"id":"manas-2010:p0770:b001:l027","ordinal":34128,"en":"A tent with golden pillars"},{"id":"manas-2010:p0770:b001:l028","ordinal":34129,"en":"They pitched for repose."},{"id":"manas-2010:p0770:b001:l029","ordinal":34130,"en":"With bronze mallets, copper stakes,"},{"id":"manas-2010:p0770:b001:l030","ordinal":34131,"en":"They drove them firmly into the ground."},{"id":"manas-2010:p0770:b001:l031","ordinal":34132,"en":"All the lords,"},{"id":"manas-2010:p0770:b001:l032","ordinal":34133,"en":"Their learned elder Bakay,"},{"id":"manas-2010:p0770:b001:l033","ordinal":34134,"en":"The forty companions sheltered from the wind,"},{"id":"manas-2010:p0770:b001:l034","ordinal":34135,"en":"Tending them within that tent."},{"id":"manas-2010:p0770:b001:l035","ordinal":34136,"en":"Slicing rump meat, serving neck fat,"},{"id":"manas-2010:p0770:b001:l036","ordinal":34137,"en":"To all the leopards,"},{"id":"manas-2010:p0770:b001:l037","ordinal":34138,"en":"Cutting rib fat, serving fat."},{"id":"manas-2010:p0770:b001:l038","ordinal":34139,"en":"All the winged thoroughbreds,"},{"id":"manas-2010:p0770:b001:l039","ordinal":34140,"en":"They took off their saddles, leaving them bare;"},{"id":"manas-2010:p0770:b001:l040","ordinal":34141,"en":"Lest they act like beasts,"},{"id":"manas-2010:p0770:b001:l041","ordinal":34142,"en":"They put on hobbles, fettering them."},{"id":"manas-2010:p0770:b001:l042","ordinal":34143,"en":"Their lead ropes knotted short,"},{"id":"manas-2010:p0771:b001:l001","ordinal":34144,"en":"Two and a half fathoms each,"},{"id":"manas-2010:p0771:b001:l002","ordinal":34145,"en":"The forty companions' forty steeds,"},{"id":"manas-2010:p0771:b001:l003","ordinal":34146,"en":"The guards of those forty steeds,"},{"id":"manas-2010:p0771:b001:l004","ordinal":34147,"en":"Around a plane tree big as a house,"},{"id":"manas-2010:p0771:b001:l005","ordinal":34148,"en":"Wound them three times,"},{"id":"manas-2010:p0771:b001:l006","ordinal":34149,"en":"And the exceptional winged thoroughbreds"},{"id":"manas-2010:p0771:b001:l007","ordinal":34150,"en":"They tethered high and fast."},{"id":"manas-2010:p0771:b001:l008","ordinal":34151,"en":"There is more to tell:"},{"id":"manas-2010:p0771:b001:l009","ordinal":34152,"en":"Where they spent the night,"},{"id":"manas-2010:p0771:b001:l010","ordinal":34153,"en":"An enduring shrine was established;"},{"id":"manas-2010:p0771:b001:l011","ordinal":34154,"en":"All the signs remain."},{"id":"manas-2010:p0771:b001:l012","ordinal":34155,"en":"All forty mighty men"},{"id":"manas-2010:p0771:b001:l013","ordinal":34156,"en":"Buzzed away, heedless."},{"id":"manas-2010:p0771:b001:l014","ordinal":34157,"en":"Those fiery companions,"},{"id":"manas-2010:p0771:b001:l015","ordinal":34158,"en":"Death and suffering"},{"id":"manas-2010:p0771:b001:l016","ordinal":34159,"en":"They valued less than their trouser hems."},{"id":"manas-2010:p0771:b001:l017","ordinal":34160,"en":"Pillowing their heads on saddles,"},{"id":"manas-2010:p0771:b001:l018","ordinal":34161,"en":"With their heads toward the north,"},{"id":"manas-2010:p0771:b001:l019","ordinal":34162,"en":"All the wolf-men"},{"id":"manas-2010:p0771:b001:l020","ordinal":34163,"en":"Fell into a giant's sleep."},{"id":"manas-2010:p0771:b001:l021","ordinal":34164,"en":"Their stretched legs never drew back,"},{"id":"manas-2010:p0771:b001:l022","ordinal":34165,"en":"Their closed eyes never opened,"},{"id":"manas-2010:p0771:b001:l023","ordinal":34166,"en":"Their snores never ceased;"},{"id":"manas-2010:p0771:b001:l024","ordinal":34167,"en":"They slept a giant's sleep."},{"id":"manas-2010:p0771:b001:l025","ordinal":34168,"en":"All forty winged steeds,"},{"id":"manas-2010:p0771:b001:l026","ordinal":34169,"en":"Moving like hunting hounds,"},{"id":"manas-2010:p0771:b001:l027","ordinal":34170,"en":"In the pale dawn breeze,"},{"id":"manas-2010:p0771:b001:l028","ordinal":34171,"en":"All stood facing it."},{"id":"manas-2010:p0771:b001:l029","ordinal":34172,"en":"The cold dawn wind struck them;"},{"id":"manas-2010:p0771:b001:l030","ordinal":34173,"en":"The forty companions' forty steeds,"},{"id":"manas-2010:p0771:b001:l031","ordinal":34174,"en":"Neighing and tossing their heads,"},{"id":"manas-2010:p0771:b001:l032","ordinal":34175,"en":"Champing their bits and prancing,"},{"id":"manas-2010:p0771:b001:l033","ordinal":34176,"en":"Flattening their ears,"},{"id":"manas-2010:p0771:b001:l034","ordinal":34177,"en":"The surface of the black earth"},{"id":"manas-2010:p0771:b001:l035","ordinal":34178,"en":"They flung upon the forty companions."},{"id":"manas-2010:p0771:b001:l036","ordinal":34179,"en":"Soil flew and scattered;"},{"id":"manas-2010:p0771:b001:l037","ordinal":34180,"en":"The surface of the black earth"},{"id":"manas-2010:p0771:b001:l038","ordinal":34181,"en":"Was dug up in clods,"},{"id":"manas-2010:p0771:b001:l039","ordinal":34182,"en":"Scattered over the forty companions."},{"id":"manas-2010:p0771:b001:l040","ordinal":34183,"en":"Their elders headed by Kyrgyl,"},{"id":"manas-2010:p0771:b001:l041","ordinal":34184,"en":"All forty companions,"},{"id":"manas-2010:p0771:b001:l042","ordinal":34185,"en":"As though swept by a flood,"},{"id":"manas-2010:p0772:b001:l001","ordinal":34186,"en":"All leaped to their feet."},{"id":"manas-2010:p0772:b001:l002","ordinal":34187,"en":"All the mighty men"},{"id":"manas-2010:p0772:b001:l003","ordinal":34188,"en":"Rose, waking from sleep."},{"id":"manas-2010:p0772:b001:l004","ordinal":34189,"en":"When they had all risen,"},{"id":"manas-2010:p0772:b001:l005","ordinal":34190,"en":"The warriors, wolves of war,"},{"id":"manas-2010:p0772:b001:l006","ordinal":34191,"en":"Each ran,"},{"id":"manas-2010:p0772:b001:l007","ordinal":34192,"en":"Each hurried to his horse."},{"id":"manas-2010:p0772:b001:l008","ordinal":34193,"en":"The black steel bits"},{"id":"manas-2010:p0772:b001:l009","ordinal":34194,"en":"They took from their throats."},{"id":"manas-2010:p0772:b001:l010","ordinal":34195,"en":"Letting the thoroughbreds chew,"},{"id":"manas-2010:p0772:b001:l011","ordinal":34196,"en":"They turned them out to graze."},{"id":"manas-2010:p0772:b001:l012","ordinal":34197,"en":"Fox-whisker grass and alfalfa,"},{"id":"manas-2010:p0772:b001:l013","ordinal":34198,"en":"Tufts of fescue,"},{"id":"manas-2010:p0772:b001:l014","ordinal":34199,"en":"They let them crop in mouthfuls."},{"id":"manas-2010:p0772:b001:l015","ordinal":34200,"en":"Leading them a little,"},{"id":"manas-2010:p0772:b001:l016","ordinal":34201,"en":"They filled their throats with grass;"},{"id":"manas-2010:p0772:b001:l017","ordinal":34202,"en":"Leading them a long way,"},{"id":"manas-2010:p0772:b001:l018","ordinal":34203,"en":"They filled their chests with grass;"},{"id":"manas-2010:p0772:b001:l019","ordinal":34204,"en":"Leading them steadily,"},{"id":"manas-2010:p0772:b001:l020","ordinal":34205,"en":"They filled their bare bellies with grass."},{"id":"manas-2010:p0772:b001:l021","ordinal":34206,"en":"Letting them graze a thousand kinds of plants,"},{"id":"manas-2010:p0772:b001:l022","ordinal":34207,"en":"From a bubbling spring"},{"id":"manas-2010:p0772:b001:l023","ordinal":34208,"en":"They quenched the horses' thirst."},{"id":"manas-2010:p0772:b001:l024","ordinal":34209,"en":"The winged steeds, restored to condition,"},{"id":"manas-2010:p0772:b001:l025","ordinal":34210,"en":"Bent like pot supports,"},{"id":"manas-2010:p0772:b001:l026","ordinal":34211,"en":"Leaping and springing like wild asses."},{"id":"manas-2010:p0772:b001:l027","ordinal":34212,"en":"Khan Manas's forty noble men:"},{"id":"manas-2010:p0772:b001:l028","ordinal":34213,"en":"To stir at the word of an enemy"},{"id":"manas-2010:p0772:b001:l029","ordinal":34214,"en":"Was the forty companions' custom."},{"id":"manas-2010:p0772:b001:l030","ordinal":34215,"en":"Of mighty wolf-man Manas,"},{"id":"manas-2010:p0772:b001:l031","ordinal":34216,"en":"The twelve flight feathers, forty tail feathers,"},{"id":"manas-2010:p0772:b001:l032","ordinal":34217,"en":"They were the wings on which he flew."},{"id":"manas-2010:p0772:b001:l033","ordinal":34218,"en":"Each of the forty had his own manner;"},{"id":"manas-2010:p0772:b001:l034","ordinal":34219,"en":"When they entered the battle they desired,"},{"id":"manas-2010:p0772:b001:l035","ordinal":34220,"en":"Bringing red slaughter,"},{"id":"manas-2010:p0772:b001:l036","ordinal":34221,"en":"They were champions who shattered nations."},{"id":"manas-2010:p0772:b001:l037","ordinal":34222,"en":"Dipping their hands in water,"},{"id":"manas-2010:p0772:b001:l038","ordinal":34223,"en":"Performing their ablutions,"},{"id":"manas-2010:p0772:b001:l039","ordinal":34224,"en":"They hurried through their prayers."},{"id":"manas-2010:p0772:b001:l040","ordinal":34225,"en":"All the finest winged steeds,"},{"id":"manas-2010:p0772:b001:l041","ordinal":34226,"en":"With exceptional agility,"},{"id":"manas-2010:p0772:b001:l042","ordinal":34227,"en":"They saddled in a flurry."},{"id":"manas-2010:p0773:b001:l001","ordinal":34228,"en":"Dawn appeared, growing pale;"},{"id":"manas-2010:p0773:b001:l002","ordinal":34229,"en":"The Seven Stars moved from overhead."},{"id":"manas-2010:p0773:b001:l003","ordinal":34230,"en":"The gray coolness that heralded dawn"},{"id":"manas-2010:p0773:b001:l004","ordinal":34231,"en":"Moved toward the direction of prayer."},{"id":"manas-2010:p0773:b001:l005","ordinal":34232,"en":"The face of the earth then"},{"id":"manas-2010:p0773:b001:l006","ordinal":34233,"en":"Appeared bright and clear."},{"id":"manas-2010:p0773:b001:l007","ordinal":34234,"en":"From the north, where Khan Bakay stood,"},{"id":"manas-2010:p0773:b001:l008","ordinal":34235,"en":"The great drum was beaten hard."},{"id":"manas-2010:p0773:b001:l009","ordinal":34236,"en":"Stirring and bustling, the mighty men"},{"id":"manas-2010:p0773:b001:l010","ordinal":34237,"en":"All mounted their winged steeds."},{"id":"manas-2010:p0773:b001:l011","ordinal":34238,"en":"Standards and spears stood apart;"},{"id":"manas-2010:p0773:b001:l012","ordinal":34239,"en":"Each one of the forty companions"},{"id":"manas-2010:p0773:b001:l013","ordinal":34240,"en":"Appeared like a thousand men."},{"id":"manas-2010:p0773:b001:l014","ordinal":34241,"en":"Battle-axes shone at their waists,"},{"id":"manas-2010:p0773:b001:l015","ordinal":34242,"en":"All their equipment glittered."},{"id":"manas-2010:p0773:b001:l016","ordinal":34243,"en":"Bringing suffering when they fought,"},{"id":"manas-2010:p0773:b001:l017","ordinal":34244,"en":"Their noble spirits beyond price,"},{"id":"manas-2010:p0773:b001:l018","ordinal":34245,"en":"When they clashed and attacked the enemy,"},{"id":"manas-2010:p0773:b001:l019","ordinal":34246,"en":"Those companions of fierce wrath"},{"id":"manas-2010:p0773:b001:l020","ordinal":34247,"en":"Were your lion, leopard Manas's"},{"id":"manas-2010:p0773:b001:l021","ordinal":34248,"en":"Close retainers at his side."},{"id":"manas-2010:p0773:b001:l022","ordinal":34249,"en":"All forty companions"},{"id":"manas-2010:p0773:b001:l023","ordinal":34250,"en":"Were tall and broad-shouldered,"},{"id":"manas-2010:p0773:b001:l024","ordinal":34251,"en":"Champions and lions alike,"},{"id":"manas-2010:p0773:b001:l025","ordinal":34252,"en":"A sight to satisfy one's longing,"},{"id":"manas-2010:p0773:b001:l026","ordinal":34253,"en":"All generous, outstanding men."},{"id":"manas-2010:p0773:b001:l027","ordinal":34254,"en":"Whole otter pelts,"},{"id":"manas-2010:p0773:b001:l028","ordinal":34255,"en":"Without calling it sinful waste,"},{"id":"manas-2010:p0773:b001:l029","ordinal":34256,"en":"They cut in half"},{"id":"manas-2010:p0773:b001:l030","ordinal":34257,"en":"And put on their trouser legs."},{"id":"manas-2010:p0773:b001:l031","ordinal":34258,"en":"Stirring at the word of an enemy,"},{"id":"manas-2010:p0773:b001:l032","ordinal":34259,"en":"There were skilled men who faced the foe."},{"id":"manas-2010:p0773:b001:l033","ordinal":34260,"en":"While your accomplished Manas was there,"},{"id":"manas-2010:p0773:b001:l034","ordinal":34261,"en":"If seven great dark hosts came forth,"},{"id":"manas-2010:p0773:b001:l035","ordinal":34262,"en":"There were men who would attack with robes thrown loose,"},{"id":"manas-2010:p0773:b001:l036","ordinal":34263,"en":"Accomplished, formidable, mighty men."},{"id":"manas-2010:p0773:b001:l037","ordinal":34264,"en":"There were champions, there were such men,"},{"id":"manas-2010:p0773:b001:l038","ordinal":34265,"en":"Never drawing back from fire;"},{"id":"manas-2010:p0773:b001:l039","ordinal":34266,"en":"So extraordinary in their prowess,"},{"id":"manas-2010:p0773:b001:l040","ordinal":34267,"en":"They were warriors who could shatter the world."},{"id":"manas-2010:p0773:b001:l041","ordinal":34268,"en":"Leopard Khan Bakay stood;"},{"id":"manas-2010:p0773:b001:l042","ordinal":34269,"en":"As though about to enter battle,"},{"id":"manas-2010:p0774:b001:l001","ordinal":34270,"en":"He beat the great drum hard."},{"id":"manas-2010:p0774:b001:l002","ordinal":34271,"en":"Hurrying, scolding one another,"},{"id":"manas-2010:p0774:b001:l003","ordinal":34272,"en":"The forty companions rushed about,"},{"id":"manas-2010:p0774:b001:l004","ordinal":34273,"en":"Trampling one another."},{"id":"manas-2010:p0774:b001:l005","ordinal":34274,"en":"The reckless champions"},{"id":"manas-2010:p0774:b001:l006","ordinal":34275,"en":"He sent charging from the flank."},{"id":"manas-2010:p0774:b001:l007","ordinal":34276,"en":"Turning their faces to wrath,"},{"id":"manas-2010:p0774:b001:l008","ordinal":34277,"en":"As though to charge and thrust their spears,"},{"id":"manas-2010:p0774:b001:l009","ordinal":34278,"en":"They stood prepared."},{"id":"manas-2010:p0774:b001:l010","ordinal":34279,"en":"Spreading out in bustling groups,"},{"id":"manas-2010:p0774:b001:l011","ordinal":34280,"en":"If you observed the forty companions,"},{"id":"manas-2010:p0774:b001:l012","ordinal":34281,"en":"Their aspect was that of lions."},{"id":"manas-2010:p0774:b001:l013","ordinal":34282,"en":"Each faced the enemy,"},{"id":"manas-2010:p0774:b001:l014","ordinal":34283,"en":"Their spears jutting up."},{"id":"manas-2010:p0774:b001:l015","ordinal":34284,"en":"Any mortal watching"},{"id":"manas-2010:p0774:b001:l016","ordinal":34285,"en":"Found his heart drawn to them."},{"id":"manas-2010:p0774:b001:l017","ordinal":34286,"en":"Khan Manas's forty noble men"},{"id":"manas-2010:p0774:b001:l018","ordinal":34287,"en":"Looked ready to drink blood."},{"id":"manas-2010:p0774:b001:l019","ordinal":34288,"en":"Their gold-cheeked battle-axes,"},{"id":"manas-2010:p0774:b001:l020","ordinal":34289,"en":"With straps of exquisite beauty,"},{"id":"manas-2010:p0774:b001:l021","ordinal":34290,"en":"Shone upon their wrists."},{"id":"manas-2010:p0774:b001:l022","ordinal":34291,"en":"Tipped with pure steel,"},{"id":"manas-2010:p0774:b001:l023","ordinal":34292,"en":"In the companions' hands,"},{"id":"manas-2010:p0774:b001:l024","ordinal":34293,"en":"The spearheads glittered."},{"id":"manas-2010:p0774:b001:l025","ordinal":34294,"en":"Their figures unfolded,"},{"id":"manas-2010:p0774:b001:l026","ordinal":34295,"en":"Separating into groups,"},{"id":"manas-2010:p0774:b001:l027","ordinal":34296,"en":"Their bearing"},{"id":"manas-2010:p0774:b001:l028","ordinal":34297,"en":"Had the aspect of lions."},{"id":"manas-2010:p0774:b001:l029","ordinal":34298,"en":"They charged ahead together,"},{"id":"manas-2010:p0774:b001:l030","ordinal":34299,"en":"Forty coursers, all winged steeds;"},{"id":"manas-2010:p0774:b001:l031","ordinal":34300,"en":"The forty companions of terrible might"},{"id":"manas-2010:p0774:b001:l032","ordinal":34301,"en":"Wrestled with their horses' mouths,"},{"id":"manas-2010:p0774:b001:l033","ordinal":34302,"en":"Stirring them to rear,"},{"id":"manas-2010:p0774:b001:l034","ordinal":34303,"en":"Making them pant and strain."},{"id":"manas-2010:p0774:b001:l035","ordinal":34304,"en":"When the forty steeds moved abreast,"}]
