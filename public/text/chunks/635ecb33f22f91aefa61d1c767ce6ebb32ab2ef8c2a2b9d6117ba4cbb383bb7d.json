[{"id":"semetey-1-2013:p1179:b005:l028","ordinal":167169,"en":"He covered the earth in dust"},{"id":"semetey-1-2013:p1179:b005:l029","ordinal":167170,"en":"And won renown among the people."},{"id":"semetey-1-2013:p1179:b005:l030","ordinal":167171,"en":"The Black Kalmyk and Manchu hosts"},{"id":"semetey-1-2013:p1179:b005:l031","ordinal":167172,"en":"Had their mouths sealed and spoke no word."},{"id":"semetey-1-2013:p1179:b005:l032","ordinal":167173,"en":"The lion lord, brave Manas,"},{"id":"semetey-1-2013:p1179:b005:l033","ordinal":167174,"en":"Was born for the good fortune"},{"id":"semetey-1-2013:p1179:b005:l034","ordinal":167175,"en":"Of the people of the Muslim faith."},{"id":"semetey-1-2013:p1179:b005:l035","ordinal":167176,"en":"All the firewood was cut,"},{"id":"semetey-1-2013:p1179:b005:l036","ordinal":167177,"en":"And the quarrels between infidel and Muslim"},{"id":"semetey-1-2013:p1179:b005:l037","ordinal":167178,"en":"Were brought to an end."},{"id":"semetey-1-2013:p1179:b005:l038","ordinal":167179,"en":"Infidel and Muslim alike"},{"id":"semetey-1-2013:p1179:b005:l039","ordinal":167180,"en":"Seethed in multitudes like black beetles."},{"id":"semetey-1-2013:p1180:b003:l001","ordinal":167181,"en":"All the people gathered;"},{"id":"semetey-1-2013:p1180:b003:l002","ordinal":167182,"en":"There is much grief that must be told."},{"id":"semetey-1-2013:p1180:b003:l003","ordinal":167183,"en":"For Kökötöy's memorial feast,"},{"id":"semetey-1-2013:p1180:b003:l004","ordinal":167184,"en":"Many champions rendered service."},{"id":"semetey-1-2013:p1180:b003:l005","ordinal":167185,"en":"Bokmurun of Kökötöy"},{"id":"semetey-1-2013:p1180:b003:l006","ordinal":167186,"en":"Stirred great commotion among the people;"},{"id":"semetey-1-2013:p1180:b003:l007","ordinal":167187,"en":"Every great pit"},{"id":"semetey-1-2013:p1180:b003:l008","ordinal":167188,"en":"He had dug and prepared properly."},{"id":"semetey-1-2013:p1180:b003:l009","ordinal":167189,"en":"Kökötöy's countless livestock"},{"id":"semetey-1-2013:p1180:b003:l010","ordinal":167190,"en":"He had slaughtered without counting."},{"id":"semetey-1-2013:p1180:b004:l001","ordinal":167191,"en":"Everyone who came"},{"id":"semetey-1-2013:p1180:b004:l002","ordinal":167192,"en":"He filled with fat from the rump."},{"id":"semetey-1-2013:p1180:b004:l003","ordinal":167193,"en":"Bokmurun of Kökötöy"},{"id":"semetey-1-2013:p1180:b004:l004","ordinal":167194,"en":"Was himself a peerless youth;"},{"id":"semetey-1-2013:p1180:b004:l005","ordinal":167195,"en":"Parted from his father,"},{"id":"semetey-1-2013:p1180:b004:l006","ordinal":167196,"en":"He had reached thirteen years of age."},{"id":"semetey-1-2013:p1180:b004:l007","ordinal":167197,"en":"A treasury filling forty rooms—"},{"id":"semetey-1-2013:p1180:b004:l008","ordinal":167198,"en":"He opened the treasury."},{"id":"semetey-1-2013:p1180:b004:l009","ordinal":167199,"en":"Kökötöy's vast wealth"},{"id":"semetey-1-2013:p1180:b004:l010","ordinal":167200,"en":"He scattered like charcoal."},{"id":"semetey-1-2013:p1180:b006:l001","ordinal":167201,"en":"Kökötöy's many strongmen"},{"id":"semetey-1-2013:p1180:b006:l002","ordinal":167202,"en":"Dug and prepared the pit;"},{"id":"semetey-1-2013:p1180:b006:l003","ordinal":167203,"en":"Kökötöy's black male camel"},{"id":"semetey-1-2013:p1180:b006:l004","ordinal":167204,"en":"They tethered in that pit."},{"id":"semetey-1-2013:p1180:b006:l005","ordinal":167205,"en":"Surpassing all people in his custom,"},{"id":"semetey-1-2013:p1180:b006:l006","ordinal":167206,"en":"Upon the black camel's head"},{"id":"semetey-1-2013:p1180:b006:l007","ordinal":167207,"en":"He had a silver bridle fastened"},{"id":"semetey-1-2013:p1180:b006:l008","ordinal":167208,"en":"And a costly carpet spread."},{"id":"semetey-1-2013:p1180:b006:l009","ordinal":167209,"en":"Kökötöy's green-hued"},{"id":"semetey-1-2013:p1180:b006:l010","ordinal":167210,"en":"Blue saddlebag,"},{"id":"semetey-1-2013:p1180:b006:l011","ordinal":167211,"en":"No ordinary camel bag but one for a great bull camel—"},{"id":"semetey-1-2013:p1180:b006:l012","ordinal":167212,"en":"Kökötöy's many treasures"},{"id":"semetey-1-2013:p1180:b006:l013","ordinal":167213,"en":"Filled many saddlebags there."},{"id":"semetey-1-2013:p1180:b006:l014","ordinal":167214,"en":"Inside that saddlebag,"},{"id":"semetey-1-2013:p1180:b006:l015","ordinal":167215,"en":"What was there, and what was not?"},{"id":"semetey-1-2013:p1180:b006:l016","ordinal":167216,"en":"The head grew dizzy at the sight."},{"id":"semetey-1-2013:p1180:b006:l017","ordinal":167217,"en":"Inside that saddlebag,"},{"id":"semetey-1-2013:p1180:b006:l018","ordinal":167218,"en":"Rubies and gold were mingled."},{"id":"semetey-1-2013:p1180:b006:l019","ordinal":167219,"en":"For his father's memorial feast,"},{"id":"semetey-1-2013:p1180:b006:l020","ordinal":167220,"en":"The wretched youth spared not his life:"},{"id":"semetey-1-2013:p1180:b006:l021","ordinal":167221,"en":"“Black male camel left by the prince,"},{"id":"semetey-1-2013:p1180:b006:l022","ordinal":167222,"en":"Masterless beast fallen upon your head—"},{"id":"semetey-1-2013:p1180:b006:l023","ordinal":167223,"en":"How could I begrudge it for my father?"},{"id":"semetey-1-2013:p1180:b006:l024","ordinal":167224,"en":"How could I heed the gaze"},{"id":"semetey-1-2013:p1180:b006:l025","ordinal":167225,"en":"Of this wretched false world?"},{"id":"semetey-1-2013:p1180:b007:l001","ordinal":167226,"en":"I have a spectacle for the people;"},{"id":"semetey-1-2013:p1180:b007:l002","ordinal":167227,"en":"Upon the black male camel"},{"id":"semetey-1-2013:p1180:b007:l003","ordinal":167228,"en":"I have wealth for the multitude to plunder."},{"id":"semetey-1-2013:p1180:b007:l004","ordinal":167229,"en":"I have a secret gathered here;"},{"id":"semetey-1-2013:p1180:b007:l005","ordinal":167230,"en":"For infidel and Muslim,"},{"id":"semetey-1-2013:p1180:b007:l006","ordinal":167231,"en":"There is a wonder that will make them laugh."},{"id":"semetey-1-2013:p1180:b007:l007","ordinal":167232,"en":"I have a song drawn from the camp;"},{"id":"semetey-1-2013:p1180:b007:l008","ordinal":167233,"en":"For Kalmak and Kyrgyz,"},{"id":"semetey-1-2013:p1180:b007:l009","ordinal":167234,"en":"I have a rite to perform."},{"id":"semetey-1-2013:p1180:b007:l010","ordinal":167235,"en":"If you do not submit to that rite,"},{"id":"semetey-1-2013:p1180:b007:l011","ordinal":167236,"en":"I have a quarrel to raise."},{"id":"semetey-1-2013:p1180:b007:l012","ordinal":167237,"en":"To openly strip away"},{"id":"semetey-1-2013:p1180:b007:l013","ordinal":167238,"en":"Kökötöy's many treasures,"},{"id":"semetey-1-2013:p1180:b007:l014","ordinal":167239,"en":"Let naked women come forth;"},{"id":"semetey-1-2013:p1180:b007:l015","ordinal":167240,"en":"Walk up and strip them away."},{"id":"semetey-1-2013:p1180:b007:l016","ordinal":167241,"en":"Remain there having grown rich."},{"id":"semetey-1-2013:p1180:b007:l017","ordinal":167242,"en":"For infidel and Muslim,"},{"id":"semetey-1-2013:p1180:b007:l018","ordinal":167243,"en":"For all the great multitude,"},{"id":"semetey-1-2013:p1180:b007:l019","ordinal":167244,"en":"Put on a spectacle.”"},{"id":"semetey-1-2013:p1180:b007:l020","ordinal":167245,"en":"Infidel and Muslim"},{"id":"semetey-1-2013:p1180:b007:l021","ordinal":167246,"en":"Gathered together,"},{"id":"semetey-1-2013:p1180:b007:l022","ordinal":167247,"en":"Counseling one another and asking,"},{"id":"semetey-1-2013:p1180:b007:l023","ordinal":167248,"en":"“Where is there wealth like this?”"},{"id":"semetey-1-2013:p1180:b007:l024","ordinal":167249,"en":"Until their council was satisfied and complete,"},{"id":"semetey-1-2013:p1180:b007:l025","ordinal":167250,"en":"With a face like an old gourd,"},{"id":"semetey-1-2013:p1181:b003:l001","ordinal":167251,"en":"With buttocks six palms wide,"},{"id":"semetey-1-2013:p1181:b003:l002","ordinal":167252,"en":"Her name was Orongu."},{"id":"semetey-1-2013:p1181:b003:l003","ordinal":167253,"en":"Can a human be like this?"},{"id":"semetey-1-2013:p1181:b003:l004","ordinal":167254,"en":"Grim in appearance and fierce in wrath,"},{"id":"semetey-1-2013:p1181:b003:l005","ordinal":167255,"en":"Her lineage was from the Black Chinese—"},{"id":"semetey-1-2013:p1181:b003:l006","ordinal":167256,"en":"Can a woman be like this?"},{"id":"semetey-1-2013:p1181:b003:l007","ordinal":167257,"en":"This infidel felt no shame;"},{"id":"semetey-1-2013:p1181:b003:l008","ordinal":167258,"en":"Would she spare any living soul?"},{"id":"semetey-1-2013:p1181:b003:l009","ordinal":167259,"en":"While people gathered,"},{"id":"semetey-1-2013:p1181:b003:l010","ordinal":167260,"en":"Swarming like black worms,"},{"id":"semetey-1-2013:p1181:b003:l011","ordinal":167261,"en":"Orongu came out naked."},{"id":"semetey-1-2013:p1181:b003:l012","ordinal":167262,"en":"She prepared every kind of beast;"},{"id":"semetey-1-2013:p1181:b003:l013","ordinal":167263,"en":"Following an ancient rite,"},{"id":"semetey-1-2013:p1181:b003:l014","ordinal":167264,"en":"She had hair two fingers long"},{"id":"semetey-1-2013:p1181:b003:l015","ordinal":167265,"en":"Tied behind her."},{"id":"semetey-1-2013:p1181:b003:l016","ordinal":167266,"en":"Orongu strode forward;"},{"id":"semetey-1-2013:p1181:b003:l017","ordinal":167267,"en":"Hero Ürbü, son of Taz,"},{"id":"semetey-1-2013:p1181:b003:l018","ordinal":167268,"en":"Mounted her like a stallion."},{"id":"semetey-1-2013:p1181:b003:l019","ordinal":167269,"en":"Neighing like a stallion,"},{"id":"semetey-1-2013:p1181:b003:l020","ordinal":167270,"en":"Bleating like a he-goat,"},{"id":"semetey-1-2013:p1181:b003:l021","ordinal":167271,"en":"Surging like a ram,"},{"id":"semetey-1-2013:p1181:b003:l022","ordinal":167272,"en":"Straining like a bull camel,"},{"id":"semetey-1-2013:p1181:b003:l023","ordinal":167273,"en":"Hero Ürbü, who made the people laugh,"},{"id":"semetey-1-2013:p1181:b003:l024","ordinal":167274,"en":"Upon that woman Orongu"},{"id":"semetey-1-2013:p1181:b003:l025","ordinal":167275,"en":"Became like a stallion."},{"id":"semetey-1-2013:p1181:b003:l026","ordinal":167276,"en":"Could any woman's boldness"},{"id":"semetey-1-2013:p1181:b003:l027","ordinal":167277,"en":"Match Orongu's?"},{"id":"semetey-1-2013:p1181:b004:l001","ordinal":167278,"en":"When Ürbü drew near,"},{"id":"semetey-1-2013:p1181:b004:l002","ordinal":167279,"en":"Saying, “I shall untie the camel,”"},{"id":"semetey-1-2013:p1181:b004:l003","ordinal":167280,"en":"Orongu hurried onward."},{"id":"semetey-1-2013:p1181:b004:l004","ordinal":167281,"en":"Gripping her firearm and bleating,"},{"id":"semetey-1-2013:p1181:b004:l005","ordinal":167282,"en":"Hero Ürbü behind her"},{"id":"semetey-1-2013:p1181:b004:l006","ordinal":167283,"en":"Neighed like a stallion."},{"id":"semetey-1-2013:p1181:b004:l007","ordinal":167284,"en":"Bending toward the camel,"},{"id":"semetey-1-2013:p1181:b004:l008","ordinal":167285,"en":"Orongu began the rite."},{"id":"semetey-1-2013:p1181:b004:l009","ordinal":167286,"en":"Hero Ürbü shoved like a stallion"},{"id":"semetey-1-2013:p1181:b004:l010","ordinal":167287,"en":"And flung her over."},{"id":"semetey-1-2013:p1181:b004:l011","ordinal":167288,"en":"Those who valued modesty"},{"id":"semetey-1-2013:p1181:b004:l012","ordinal":167289,"en":"Fled out from among the people."},{"id":"semetey-1-2013:p1181:b004:l013","ordinal":167290,"en":"Watching in amazement"},{"id":"semetey-1-2013:p1181:b004:l014","ordinal":167291,"en":"Stood lion Manas."},{"id":"semetey-1-2013:p1181:b004:l015","ordinal":167292,"en":"Orongu's strongman,"},{"id":"semetey-1-2013:p1181:b004:l016","ordinal":167293,"en":"The black male camel in the pit—"},{"id":"semetey-1-2013:p1181:b004:l017","ordinal":167294,"en":"Bending over, she untied it."},{"id":"semetey-1-2013:p1181:b004:l018","ordinal":167295,"en":"The woman Orongu would not prosper;"},{"id":"semetey-1-2013:p1181:b004:l019","ordinal":167296,"en":"Before all those people,"},{"id":"semetey-1-2013:p1181:b004:l020","ordinal":167297,"en":"Her face did not even pale."},{"id":"semetey-1-2013:p1181:b004:l021","ordinal":167298,"en":"Orongu untied the camel"},{"id":"semetey-1-2013:p1181:b004:l022","ordinal":167299,"en":"And created another spectacle;"},{"id":"semetey-1-2013:p1181:b004:l023","ordinal":167300,"en":"Among women, Orongu"},{"id":"semetey-1-2013:p1181:b004:l024","ordinal":167301,"en":"Was a champion without shame."},{"id":"semetey-1-2013:p1181:b004:l025","ordinal":167302,"en":"She untied the camel;"},{"id":"semetey-1-2013:p1181:b004:l026","ordinal":167303,"en":"The woman Orongu proved a prince"},{"id":"semetey-1-2013:p1181:b004:l027","ordinal":167304,"en":"And remained there enriched."},{"id":"semetey-1-2013:p1181:b006:l001","ordinal":167305,"en":"After the camel-untying contest passed,"},{"id":"semetey-1-2013:p1181:b006:l002","ordinal":167306,"en":"After this spectacle had ended,"},{"id":"semetey-1-2013:p1181:b006:l003","ordinal":167307,"en":"Bokmurun of Kökötöy,"},{"id":"semetey-1-2013:p1181:b006:l004","ordinal":167308,"en":"Scattering his wealth,"},{"id":"semetey-1-2013:p1181:b006:l005","ordinal":167309,"en":"Making every people laugh,"},{"id":"semetey-1-2013:p1181:b006:l006","ordinal":167310,"en":"Made his riches known"},{"id":"semetey-1-2013:p1181:b006:l007","ordinal":167311,"en":"To the whole multitude,"},{"id":"semetey-1-2013:p1181:b006:l008","ordinal":167312,"en":"Infidel and Muslim:"},{"id":"semetey-1-2013:p1181:b007:l001","ordinal":167313,"en":"“Among the Muslims, Khan Koshoy,"},{"id":"semetey-1-2013:p1181:b007:l002","ordinal":167314,"en":"Lion Sultan Khan Manas—"},{"id":"semetey-1-2013:p1181:b007:l003","ordinal":167315,"en":"Your people stand here;"},{"id":"semetey-1-2013:p1181:b007:l004","ordinal":167316,"en":"Your fierce and formidable"},{"id":"semetey-1-2013:p1181:b007:l005","ordinal":167317,"en":"Giants stand here;"},{"id":"semetey-1-2013:p1181:b007:l006","ordinal":167318,"en":"People of the Muslim faith,"},{"id":"semetey-1-2013:p1181:b007:l007","ordinal":167319,"en":"All of you stand here."},{"id":"semetey-1-2013:p1181:b007:l008","ordinal":167320,"en":"I have counsel and words;"},{"id":"semetey-1-2013:p1182:b003:l001","ordinal":167321,"en":"Noble prince and lion,"},{"id":"semetey-1-2013:p1182:b003:l002","ordinal":167322,"en":"I have a matter for your counsel."},{"id":"semetey-1-2013:p1182:b003:l003","ordinal":167323,"en":"I am mint sprung from the water;"},{"id":"semetey-1-2013:p1182:b003:l004","ordinal":167324,"en":"From your Sultan Kökötöy,"},{"id":"semetey-1-2013:p1182:b003:l005","ordinal":167325,"en":"I am the only one left."},{"id":"semetey-1-2013:p1182:b003:l006","ordinal":167326,"en":"When my valiant father passed,"},{"id":"semetey-1-2013:p1182:b003:l007","ordinal":167327,"en":"I had no life apart from him;"},{"id":"semetey-1-2013:p1182:b003:l008","ordinal":167328,"en":"Left behind by my father to bear the burden,"},{"id":"semetey-1-2013:p1182:b003:l009","ordinal":167329,"en":"I have no younger brother beneath me for support."},{"id":"semetey-1-2013:p1182:b003:l010","ordinal":167330,"en":"I have the swift horse Maaniker;"},{"id":"semetey-1-2013:p1182:b003:l011","ordinal":167331,"en":"There is no charger besides him."},{"id":"semetey-1-2013:p1182:b003:l012","ordinal":167332,"en":"Nor have I elder kin behind me;"},{"id":"semetey-1-2013:p1182:b003:l013","ordinal":167333,"en":"I have only my solitary life."},{"id":"semetey-1-2013:p1182:b003:l014","ordinal":167334,"en":"Across the four corners of the world,"},{"id":"semetey-1-2013:p1182:b003:l015","ordinal":167335,"en":"I have livestock surrounding me."},{"id":"semetey-1-2013:p1182:b003:l016","ordinal":167336,"en":"After my dear father passed,"},{"id":"semetey-1-2013:p1182:b003:l017","ordinal":167337,"en":"After he departed without turning back"},{"id":"semetey-1-2013:p1182:b003:l018","ordinal":167338,"en":"To the world from which none return,"},{"id":"semetey-1-2013:p1182:b003:l019","ordinal":167339,"en":"I shall institute contests for the people."},{"id":"semetey-1-2013:p1182:b003:l020","ordinal":167340,"en":"How can I remain empty-handed"},{"id":"semetey-1-2013:p1182:b003:l021","ordinal":167341,"en":"Without arranging contests?"},{"id":"semetey-1-2013:p1182:b003:l022","ordinal":167342,"en":"For Khan Kökötöy's memorial rites,"},{"id":"semetey-1-2013:p1182:b003:l023","ordinal":167343,"en":"Look, assembled people:"},{"id":"semetey-1-2013:p1182:b003:l024","ordinal":167344,"en":"I have strength enough for the people;"},{"id":"semetey-1-2013:p1182:b003:l025","ordinal":167345,"en":"If I held feasts for another five years,"},{"id":"semetey-1-2013:p1182:b003:l026","ordinal":167346,"en":"I have livestock enough to last."},{"id":"semetey-1-2013:p1182:b003:l027","ordinal":167347,"en":"Prepared for the horse-race prizes,"},{"id":"semetey-1-2013:p1182:b003:l028","ordinal":167348,"en":"I have nine camel loads."},{"id":"semetey-1-2013:p1182:b003:l029","ordinal":167349,"en":"I have ninety thousand barren mares;"},{"id":"semetey-1-2013:p1182:b003:l030","ordinal":167350,"en":"I have a feast to give the people."},{"id":"semetey-1-2013:p1182:b003:l031","ordinal":167351,"en":"I have sheep beyond counting;"},{"id":"semetey-1-2013:p1182:b003:l032","ordinal":167352,"en":"When told, I have such wonders."},{"id":"semetey-1-2013:p1182:b003:l033","ordinal":167353,"en":"I have cattle beyond counting."},{"id":"semetey-1-2013:p1182:b003:l034","ordinal":167354,"en":"I had fire struck for Koroson"},{"id":"semetey-1-2013:p1182:b003:l035","ordinal":167355,"en":"And invited every one,"},{"id":"semetey-1-2013:p1182:b003:l036","ordinal":167356,"en":"Infidel and Muslim."},{"id":"semetey-1-2013:p1182:b003:l037","ordinal":167357,"en":"Horse trainers who tether horses,"},{"id":"semetey-1-2013:p1182:b003:l038","ordinal":167358,"en":"Competitors who race horses—"},{"id":"semetey-1-2013:p1182:b003:l039","ordinal":167359,"en":"For my dear father's memorial feast,"},{"id":"semetey-1-2013:p1182:b004:l001","ordinal":167360,"en":"You have gathered in great numbers."},{"id":"semetey-1-2013:p1182:b004:l002","ordinal":167361,"en":"I have seventy divisions of people;"},{"id":"semetey-1-2013:p1182:b004:l003","ordinal":167362,"en":"To all the accomplished people,"},{"id":"semetey-1-2013:p1182:b004:l004","ordinal":167363,"en":"I have words to speak today."},{"id":"semetey-1-2013:p1182:b004:l005","ordinal":167364,"en":"For my father's memorial feast,"},{"id":"semetey-1-2013:p1182:b004:l006","ordinal":167365,"en":"I shall slaughter countless black-blazed mares;"},{"id":"semetey-1-2013:p1182:b004:l007","ordinal":167366,"en":"I shall slaughter tens of thousands of camels."},{"id":"semetey-1-2013:p1182:b004:l008","ordinal":167367,"en":"I shall load goods upon camels and offer them;"},{"id":"semetey-1-2013:p1182:b004:l009","ordinal":167368,"en":"I shall offer slaves together with their children."},{"id":"semetey-1-2013:p1182:b004:l010","ordinal":167369,"en":"The treasury filling forty rooms—"},{"id":"semetey-1-2013:p1182:b004:l011","ordinal":167370,"en":"I shall divide and offer twenty rooms of it."},{"id":"semetey-1-2013:p1182:b004:l012","ordinal":167371,"en":"The people and khans are here;"},{"id":"semetey-1-2013:p1182:b004:l013","ordinal":167372,"en":"To rich Bokmurun's words,"},{"id":"semetey-1-2013:p1182:b004:l014","ordinal":167373,"en":"All of you listen closely."},{"id":"semetey-1-2013:p1182:b004:l015","ordinal":167374,"en":"There are prizes for one hundred nine horses;"},{"id":"semetey-1-2013:p1182:b004:l016","ordinal":167375,"en":"Where is there a prize like this?"},{"id":"semetey-1-2013:p1182:b004:l017","ordinal":167376,"en":"I shall make a thunderous commotion;"},{"id":"semetey-1-2013:p1182:b004:l018","ordinal":167377,"en":"For my dear father's memorial rites,"},{"id":"semetey-1-2013:p1182:b004:l019","ordinal":167378,"en":"I shall turn my wealth to ash."},{"id":"semetey-1-2013:p1182:b004:l020","ordinal":167379,"en":"I have spoken boasting of all I possess;"},{"id":"semetey-1-2013:p1182:b004:l021","ordinal":167380,"en":"For my dear father's rites,"},{"id":"semetey-1-2013:p1182:b004:l022","ordinal":167381,"en":"I shall spend my wealth."},{"id":"semetey-1-2013:p1182:b004:l023","ordinal":167382,"en":"Let no people gossip afterward;"},{"id":"semetey-1-2013:p1182:b004:l024","ordinal":167383,"en":"Out of sparing it from my father,"},{"id":"semetey-1-2013:p1182:b004:l025","ordinal":167384,"en":"May not even one yearling remain to me."},{"id":"semetey-1-2013:p1182:b004:l026","ordinal":167385,"en":"People who have come to the feast,"},{"id":"semetey-1-2013:p1182:b004:l027","ordinal":167386,"en":"For my dear father's memorial feast,"},{"id":"semetey-1-2013:p1182:b004:l028","ordinal":167387,"en":"Leave my two and stake one;"},{"id":"semetey-1-2013:p1182:b004:l029","ordinal":167388,"en":"Leave my other and stake my family."},{"id":"semetey-1-2013:p1182:b004:l030","ordinal":167389,"en":"Stake my people migrated from Tashkent."},{"id":"semetey-1-2013:p1182:b004:l031","ordinal":167390,"en":"If my wealth begins to fall short,"},{"id":"semetey-1-2013:p1182:b004:l032","ordinal":167391,"en":"My dear people,"},{"id":"semetey-1-2013:p1182:b004:l033","ordinal":167392,"en":"Stake me as the chief prize.”"},{"id":"semetey-1-2013:p1182:b004:l034","ordinal":167393,"en":"Bokmurun of Kökötöy"},{"id":"semetey-1-2013:p1182:b004:l035","ordinal":167394,"en":"Before he had closed his mouth,"},{"id":"semetey-1-2013:p1182:b004:l036","ordinal":167395,"en":"Before he had finished his words,"},{"id":"semetey-1-2013:p1182:b004:l037","ordinal":167396,"en":"The bell was struck firmly;"},{"id":"semetey-1-2013:p1182:b004:l038","ordinal":167397,"en":"The red camel of service"},{"id":"semetey-1-2013:p1182:b004:l039","ordinal":167398,"en":"Came crowding in,"},{"id":"semetey-1-2013:p1183:b003:l001","ordinal":167399,"en":"Countless camels came in rows;"},{"id":"semetey-1-2013:p1183:b003:l002","ordinal":167400,"en":"Leading those countless camels,"},{"id":"semetey-1-2013:p1183:b003:l003","ordinal":167401,"en":"A mass of people came on foot."},{"id":"semetey-1-2013:p1183:b003:l004","ordinal":167402,"en":"The people marveled"},{"id":"semetey-1-2013:p1183:b003:l005","ordinal":167403,"en":"And asked many questions:"},{"id":"semetey-1-2013:p1183:b003:l006","ordinal":167404,"en":"\"Whose are all these camels?\""},{"id":"semetey-1-2013:p1183:b003:l007","ordinal":167405,"en":"\"Loaded for Kokotoy's memorial rites—"},{"id":"semetey-1-2013:p1183:b003:l008","ordinal":167406,"en":"These are Kokotoy's camels."},{"id":"semetey-1-2013:p1183:b003:l009","ordinal":167407,"en":"Attending those camels"},{"id":"semetey-1-2013:p1183:b003:l010","ordinal":167408,"en":"Is a countless throng of servants.\""},{"id":"semetey-1-2013:p1183:b003:l011","ordinal":167409,"en":"They came and undid the bindings;"},{"id":"semetey-1-2013:p1183:b003:l012","ordinal":167410,"en":"To be staked as the grand prize,"},{"id":"semetey-1-2013:p1183:b003:l013","ordinal":167411,"en":"Many splendid things had come."},{"id":"semetey-1-2013:p1183:b003:l014","ordinal":167412,"en":"With no mount left wanting, they brought goods,"},{"id":"semetey-1-2013:p1183:b003:l015","ordinal":167413,"en":"Loaded gold coins upon the goods,"},{"id":"semetey-1-2013:p1183:b003:l016","ordinal":167414,"en":"To serve at Kokotoy's celebration,"},{"id":"semetey-1-2013:p1183:b003:l017","ordinal":167415,"en":"All equally as attendants,"},{"id":"semetey-1-2013:p1183:b003:l018","ordinal":167416,"en":"They brought sixty beautiful girls."},{"id":"semetey-1-2013:p1183:b003:l019","ordinal":167417,"en":"Their trailing ornaments brushed the ground."},{"id":"semetey-1-2013:p1183:b003:l020","ordinal":167418,"en":"This vain wealth had reached its height:"},{"id":"semetey-1-2013:p1183:b003:l021","ordinal":167419,"en":"Kokotoy's abundant riches,"},{"id":"semetey-1-2013:p1183:b003:l022","ordinal":167420,"en":"Which flared brighter as they were spent,"},{"id":"semetey-1-2013:p1183:b003:l023","ordinal":167421,"en":"A world of goods arrayed like grass;"},{"id":"semetey-1-2013:p1183:b003:l024","ordinal":167422,"en":"The more was cut away, the broader it grew,"},{"id":"semetey-1-2013:p1183:b003:l025","ordinal":167423,"en":"Abundant wealth that never diminished."},{"id":"semetey-1-2013:p1183:b003:l026","ordinal":167424,"en":"These were the things he had brought."}]
