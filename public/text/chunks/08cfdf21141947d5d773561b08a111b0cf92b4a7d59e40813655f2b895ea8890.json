[{"id":"semetey-2-2013:p1037:b004:l017","ordinal":265473,"en":"Renouncing the milk with which she nursed me,"},{"id":"semetey-2-2013:p1037:b004:l018","ordinal":265474,"en":"Before Almighty God"},{"id":"semetey-2-2013:p1037:b004:l019","ordinal":265475,"en":"And openly disowning me,"},{"id":"semetey-2-2013:p1037:b004:l020","ordinal":265476,"en":"My dear mother Kanykey may say,"},{"id":"semetey-2-2013:p1037:b004:l021","ordinal":265477,"en":"‘May my breast milk strike you down!’"},{"id":"semetey-2-2013:p1037:b004:l022","ordinal":265478,"en":"Alas, my dear mother Kanykey—"},{"id":"semetey-2-2013:p1037:b004:l023","ordinal":265479,"en":"In her anger, the unfortunate woman"},{"id":"semetey-2-2013:p1037:b004:l024","ordinal":265480,"en":"Might suddenly curse me."},{"id":"semetey-2-2013:p1037:b004:l025","ordinal":265481,"en":"My dear elder Semetey"},{"id":"semetey-2-2013:p1037:b004:l026","ordinal":265482,"en":"May say, ‘You attacked a foolish youngster;"},{"id":"semetey-2-2013:p1037:b004:l027","ordinal":265483,"en":"What have you become, little brother?’"},{"id":"semetey-2-2013:p1037:b004:l028","ordinal":265484,"en":"Man, may he not put me to shame!"},{"id":"semetey-2-2013:p1037:b004:l029","ordinal":265485,"en":"He may ask, ‘How could you seize and slaughter"},{"id":"semetey-2-2013:p1037:b004:l030","ordinal":265486,"en":"Our maternal cousin, our guest?"},{"id":"semetey-2-2013:p1037:b004:l031","ordinal":265487,"en":"You truly are a brave man,"},{"id":"semetey-2-2013:p1037:b004:l032","ordinal":265488,"en":"But what have you done"},{"id":"semetey-2-2013:p1037:b004:l033","ordinal":265489,"en":"To a guest who came among your people?"},{"id":"semetey-2-2013:p1037:b004:l034","ordinal":265490,"en":"He is no Chinese and no enemy,"},{"id":"semetey-2-2013:p1037:b004:l035","ordinal":265491,"en":"My formidable lion Külchoro;"},{"id":"semetey-2-2013:p1037:b004:l036","ordinal":265492,"en":"This deed of yours is not sane!’"},{"id":"semetey-2-2013:p1037:b004:l037","ordinal":265493,"en":"Saying this, my elder"},{"id":"semetey-2-2013:p1037:b004:l038","ordinal":265494,"en":"May strike me to the heart with cutting words,"},{"id":"semetey-2-2013:p1037:b004:l039","ordinal":265495,"en":"And my poor soul will truly burn—"},{"id":"semetey-2-2013:p1038:b003:l001","ordinal":265496,"en":"Will I be left in disgrace?"},{"id":"semetey-2-2013:p1038:b003:l002","ordinal":265497,"en":"I would sooner die broken than be shamed;"},{"id":"semetey-2-2013:p1038:b003:l003","ordinal":265498,"en":"Ümötöy is fierce—"},{"id":"semetey-2-2013:p1038:b003:l004","ordinal":265499,"en":"I have never seen the like of him among the dead."},{"id":"semetey-2-2013:p1038:b003:l005","ordinal":265500,"en":"Without stiffening in anger,"},{"id":"semetey-2-2013:p1038:b003:l006","ordinal":265501,"en":"I shall go to my khan and elder."},{"id":"semetey-2-2013:p1038:b003:l007","ordinal":265502,"en":"My silver-eyed, sun-faced,"},{"id":"semetey-2-2013:p1038:b003:l008","ordinal":265503,"en":"Thunderous lion of an elder—"},{"id":"semetey-2-2013:p1038:b003:l009","ordinal":265504,"en":"I shall go and seek his counsel."},{"id":"semetey-2-2013:p1038:b003:l010","ordinal":265505,"en":"Before anyone can cry, ‘Stop and turn aside!’"},{"id":"semetey-2-2013:p1038:b003:l011","ordinal":265506,"en":"Saying, ‘He is your close cousin,’"},{"id":"semetey-2-2013:p1038:b003:l012","ordinal":265507,"en":"In the blink of an eye"},{"id":"semetey-2-2013:p1038:b003:l013","ordinal":265508,"en":"I shall tell Semetey."},{"id":"semetey-2-2013:p1038:b003:l014","ordinal":265509,"en":"If he says, ‘He truly is a Kazakh;"},{"id":"semetey-2-2013:p1038:b003:l015","ordinal":265510,"en":"Leave none of his army standing,’"},{"id":"semetey-2-2013:p1038:b003:l016","ordinal":265511,"en":"Then, raging to my very roots,"},{"id":"semetey-2-2013:p1038:b003:l017","ordinal":265512,"en":"If the fury given me"},{"id":"semetey-2-2013:p1038:b003:l018","ordinal":265513,"en":"By gracious God seizes me now,"},{"id":"semetey-2-2013:p1038:b003:l019","ordinal":265514,"en":"I shall rise in wrath"},{"id":"semetey-2-2013:p1038:b003:l020","ordinal":265515,"en":"And attack one of them."},{"id":"semetey-2-2013:p1038:b003:l021","ordinal":265516,"en":"I shall choose and mount a charger;"},{"id":"semetey-2-2013:p1038:b003:l022","ordinal":265517,"en":"Without demeaning sword or gun,"},{"id":"semetey-2-2013:p1038:b003:l023","ordinal":265518,"en":"I shall charge those accursed Kazakhs"},{"id":"semetey-2-2013:p1038:b003:l024","ordinal":265519,"en":"With only a whip."},{"id":"semetey-2-2013:p1038:b003:l025","ordinal":265520,"en":"If they swarm me, I shall make them pay with their lives,"},{"id":"semetey-2-2013:p1038:b003:l026","ordinal":265521,"en":"And force them to cry, ‘Mercy, dear brother!’"},{"id":"semetey-2-2013:p1038:b003:l027","ordinal":265522,"en":"I shall test their vaunted courage,"},{"id":"semetey-2-2013:p1038:b003:l028","ordinal":265523,"en":"Felling them with my whip,"},{"id":"semetey-2-2013:p1038:b003:l029","ordinal":265524,"en":"And drive the wailing Kazakhs"},{"id":"semetey-2-2013:p1038:b003:l030","ordinal":265525,"en":"Toward Sary-Arka."},{"id":"semetey-2-2013:p1038:b003:l031","ordinal":265526,"en":"I shall drive the sprawling swine"},{"id":"semetey-2-2013:p1038:b003:l032","ordinal":265527,"en":"Into Sary-Arka."},{"id":"semetey-2-2013:p1038:b003:l033","ordinal":265528,"en":"I shall pen them among the reeds,"},{"id":"semetey-2-2013:p1038:b003:l034","ordinal":265529,"en":"And gallop straight at"},{"id":"semetey-2-2013:p1038:b003:l035","ordinal":265530,"en":"The raving Ümötöy himself."},{"id":"semetey-2-2013:p1038:b003:l036","ordinal":265531,"en":"Whether I should attack or not,"},{"id":"semetey-2-2013:p1038:b003:l037","ordinal":265532,"en":"I shall seek my bloodthirsty elder’s answer."},{"id":"semetey-2-2013:p1038:b003:l038","ordinal":265533,"en":"Then I shall wreak devastation"},{"id":"semetey-2-2013:p1038:b003:l039","ordinal":265534,"en":"And turmoil among the Kazakhs."},{"id":"semetey-2-2013:p1038:b004:l001","ordinal":265535,"en":"Ümötöy of Khan Köksö,"},{"id":"semetey-2-2013:p1038:b004:l002","ordinal":265536,"en":"It is true that you are a grim warrior;"},{"id":"semetey-2-2013:p1038:b004:l003","ordinal":265537,"en":"Like thoroughly tempered iron,"},{"id":"semetey-2-2013:p1038:b004:l004","ordinal":265538,"en":"It is true that you are strong."},{"id":"semetey-2-2013:p1038:b004:l005","ordinal":265539,"en":"Known among the people,"},{"id":"semetey-2-2013:p1038:b004:l006","ordinal":265540,"en":"It is true that you are a lion;"},{"id":"semetey-2-2013:p1038:b004:l007","ordinal":265541,"en":"It is true that you can"},{"id":"semetey-2-2013:p1038:b004:l008","ordinal":265542,"en":"Deal with multitudes."},{"id":"semetey-2-2013:p1038:b004:l009","ordinal":265543,"en":"Warrior, it is true that you can"},{"id":"semetey-2-2013:p1038:b004:l010","ordinal":265544,"en":"Ride against the Kyrgyz and wreak slaughter."},{"id":"semetey-2-2013:p1038:b004:l011","ordinal":265545,"en":"Black-maned leopard,"},{"id":"semetey-2-2013:p1038:b004:l012","ordinal":265546,"en":"I shall go to my khan and elder,"},{"id":"semetey-2-2013:p1038:b004:l013","ordinal":265547,"en":"My noble elder Semetey,"},{"id":"semetey-2-2013:p1038:b004:l014","ordinal":265548,"en":"And firmly seek his counsel."},{"id":"semetey-2-2013:p1038:b004:l015","ordinal":265549,"en":"If my elder speaks"},{"id":"semetey-2-2013:p1038:b004:l016","ordinal":265550,"en":"And says, ‘I will pay the blood-price"},{"id":"semetey-2-2013:p1038:b004:l017","ordinal":265551,"en":"For your father, gray-maned Köksö,’"},{"id":"semetey-2-2013:p1038:b004:l018","ordinal":265552,"en":"We shall accept his word."},{"id":"semetey-2-2013:p1038:b004:l019","ordinal":265553,"en":"With gold by the foot and precious ornaments,"},{"id":"semetey-2-2013:p1038:b004:l020","ordinal":265554,"en":"We shall pay your father’s blood-price."},{"id":"semetey-2-2013:p1038:b004:l021","ordinal":265555,"en":"I have many full-grown beasts,"},{"id":"semetey-2-2013:p1038:b004:l022","ordinal":265556,"en":"Their fore-saddles sagging,"},{"id":"semetey-2-2013:p1038:b004:l023","ordinal":265557,"en":"Their twin humps bulging;"},{"id":"semetey-2-2013:p1038:b004:l024","ordinal":265558,"en":"I have many fine animals of great worth."},{"id":"semetey-2-2013:p1038:b004:l025","ordinal":265559,"en":"To those who understand, this is my honor:"},{"id":"semetey-2-2013:p1038:b004:l026","ordinal":265560,"en":"Let us be friends and not revile each other!”"},{"id":"semetey-2-2013:p1038:b004:l027","ordinal":265561,"en":"After pondering in this way,"},{"id":"semetey-2-2013:p1038:b004:l028","ordinal":265562,"en":"He said to Ümötöy:"},{"id":"semetey-2-2013:p1038:b004:l029","ordinal":265563,"en":"“I have means to pay the blood-price."},{"id":"semetey-2-2013:p1038:b004:l030","ordinal":265564,"en":"I will not strike you on this little ridge;"},{"id":"semetey-2-2013:p1038:b004:l031","ordinal":265565,"en":"Wait here, valiant gray-maned warrior."},{"id":"semetey-2-2013:p1038:b004:l032","ordinal":265566,"en":"The man I must face is Semetey;"},{"id":"semetey-2-2013:p1038:b004:l033","ordinal":265567,"en":"I shall not be gone longer than a mare’s milking."},{"id":"semetey-2-2013:p1038:b004:l034","ordinal":265568,"en":"My gray-maned elder Semetey—"},{"id":"semetey-2-2013:p1038:b004:l035","ordinal":265569,"en":"I shall go to Semetey."},{"id":"semetey-2-2013:p1038:b004:l036","ordinal":265570,"en":"I have my lord Bakay,"},{"id":"semetey-2-2013:p1038:b004:l037","ordinal":265571,"en":"Blessed by every saint,"},{"id":"semetey-2-2013:p1038:b004:l038","ordinal":265572,"en":"Father of this multitude of people."},{"id":"semetey-2-2013:p1038:b004:l039","ordinal":265573,"en":"I have my mother Kanykey,"},{"id":"semetey-2-2013:p1039:b003:l001","ordinal":265574,"en":"Who bore a lion for all the world."},{"id":"semetey-2-2013:p1039:b003:l002","ordinal":265575,"en":"I shall seek their counsel."},{"id":"semetey-2-2013:p1039:b003:l003","ordinal":265576,"en":"If your claim proves just,"},{"id":"semetey-2-2013:p1039:b003:l004","ordinal":265577,"en":"If my mother deems it fitting,"},{"id":"semetey-2-2013:p1039:b003:l005","ordinal":265578,"en":"We shall agree to what you have said."},{"id":"semetey-2-2013:p1039:b003:l006","ordinal":265579,"en":"What deeds did"},{"id":"semetey-2-2013:p1039:b003:l007","ordinal":265580,"en":"The bloodthirsty leopard Manas commit?"},{"id":"semetey-2-2013:p1039:b003:l008","ordinal":265581,"en":"And what kind of man was this Köksö,"},{"id":"semetey-2-2013:p1039:b003:l009","ordinal":265582,"en":"Who went to Beijing and fell to a bullet?"},{"id":"semetey-2-2013:p1039:b003:l010","ordinal":265583,"en":"If you will not heed my words,"},{"id":"semetey-2-2013:p1039:b003:l011","ordinal":265584,"en":"I shall return afterward.”"},{"id":"semetey-2-2013:p1039:b003:l012","ordinal":265585,"en":"Thus spoke Külchoro:"},{"id":"semetey-2-2013:p1039:b003:l013","ordinal":265586,"en":"“We ourselves are maternal cousins;"},{"id":"semetey-2-2013:p1039:b003:l014","ordinal":265587,"en":"This conduct of yours will bring shame."},{"id":"semetey-2-2013:p1039:b003:l015","ordinal":265588,"en":"You are our maternal cousin."},{"id":"semetey-2-2013:p1039:b003:l016","ordinal":265589,"en":"Until I return, do not stir;"},{"id":"semetey-2-2013:p1039:b003:l017","ordinal":265590,"en":"Remain right here."},{"id":"semetey-2-2013:p1039:b003:l018","ordinal":265591,"en":"Once I have received an answer,"},{"id":"semetey-2-2013:p1039:b003:l019","ordinal":265592,"en":"You may then raise your great quarrel."},{"id":"semetey-2-2013:p1039:b003:l020","ordinal":265593,"en":"Until I gain the hero’s reply"},{"id":"semetey-2-2013:p1039:b003:l021","ordinal":265594,"en":"And send you word,"},{"id":"semetey-2-2013:p1039:b003:l022","ordinal":265595,"en":"If you are strong, if you are a lion,"},{"id":"semetey-2-2013:p1039:b003:l023","ordinal":265596,"en":"If you are truly your father’s son,"},{"id":"semetey-2-2013:p1039:b003:l024","ordinal":265597,"en":"Remain where you stand!”"},{"id":"semetey-2-2013:p1039:b003:l025","ordinal":265598,"en":"So Külchoro"},{"id":"semetey-2-2013:p1039:b003:l026","ordinal":265599,"en":"Entered Aichürök’s palace,"},{"id":"semetey-2-2013:p1039:b003:l027","ordinal":265600,"en":"As evening was falling,"},{"id":"semetey-2-2013:p1039:b003:l028","ordinal":265601,"en":"In the cool late afternoon,"},{"id":"semetey-2-2013:p1039:b003:l029","ordinal":265602,"en":"And came riding in at a trot."},{"id":"semetey-2-2013:p1039:b003:l030","ordinal":265603,"en":"When the people’s games had ended"},{"id":"semetey-2-2013:p1039:b003:l031","ordinal":265604,"en":"And the mares were being released,"},{"id":"semetey-2-2013:p1039:b003:l032","ordinal":265605,"en":"Fiery warrior Külchoro"},{"id":"semetey-2-2013:p1039:b003:l033","ordinal":265606,"en":"Gathered warrior Bakay and Semetey,"},{"id":"semetey-2-2013:p1039:b003:l034","ordinal":265607,"en":"The two of them, together."},{"id":"semetey-2-2013:p1039:b003:l035","ordinal":265608,"en":"In the marshes of Choguldur,"},{"id":"semetey-2-2013:p1039:b003:l036","ordinal":265609,"en":"All the great lords"},{"id":"semetey-2-2013:p1039:b003:l037","ordinal":265610,"en":"Had assembled;"},{"id":"semetey-2-2013:p1039:b003:l038","ordinal":265611,"en":"In the marshes of Üyrülmö"},{"id":"semetey-2-2013:p1039:b003:l039","ordinal":265612,"en":"They had gathered together."},{"id":"semetey-2-2013:p1039:b004:l001","ordinal":265613,"en":"Then Külchoro—"},{"id":"semetey-2-2013:p1039:b004:l002","ordinal":265614,"en":"The lion Choro aided by the sacred patron,"},{"id":"semetey-2-2013:p1039:b004:l003","ordinal":265615,"en":"Immeasurably swift,"},{"id":"semetey-2-2013:p1039:b004:l004","ordinal":265616,"en":"The resounding warrior Choro—"},{"id":"semetey-2-2013:p1039:b004:l005","ordinal":265617,"en":"Spoke quietly but with grave weight,"},{"id":"semetey-2-2013:p1039:b004:l006","ordinal":265618,"en":"And began his words"},{"id":"semetey-2-2013:p1039:b004:l007","ordinal":265619,"en":"To lion Bakay and Semetey:"},{"id":"semetey-2-2013:p1039:b004:l008","ordinal":265620,"en":"“White-bearded elder Bakay, my motherly guardian,"},{"id":"semetey-2-2013:p1039:b004:l009","ordinal":265621,"en":"You, the elder, are here."},{"id":"semetey-2-2013:p1039:b004:l010","ordinal":265622,"en":"Semetey, my protector,"},{"id":"semetey-2-2013:p1039:b004:l011","ordinal":265623,"en":"You, my elder, are here."},{"id":"semetey-2-2013:p1039:b004:l012","ordinal":265624,"en":"Have you seen what I have seen?"},{"id":"semetey-2-2013:p1039:b004:l013","ordinal":265625,"en":"Do you know what I have learned?"},{"id":"semetey-2-2013:p1039:b004:l014","ordinal":265626,"en":"If you have not seen what I have seen,"},{"id":"semetey-2-2013:p1039:b004:l015","ordinal":265627,"en":"Man, if you do not know what I know,"},{"id":"semetey-2-2013:p1039:b004:l016","ordinal":265628,"en":"Have you heard the news"},{"id":"semetey-2-2013:p1039:b004:l017","ordinal":265629,"en":"Of the one who dwells in Sary-Arka,"},{"id":"semetey-2-2013:p1039:b004:l018","ordinal":265630,"en":"Whom no enemy has defeated in battle,"},{"id":"semetey-2-2013:p1039:b004:l019","ordinal":265631,"en":"Who yields his share to no man,"},{"id":"semetey-2-2013:p1039:b004:l020","ordinal":265632,"en":"The fountainhead of the blue river,"},{"id":"semetey-2-2013:p1039:b004:l021","ordinal":265633,"en":"The young champion of Khan Köksö?"},{"id":"semetey-2-2013:p1039:b004:l022","ordinal":265634,"en":"He had ninety beasts slaughtered for his feast,"},{"id":"semetey-2-2013:p1039:b004:l023","ordinal":265635,"en":"And amid the people’s uproar and the nation’s stir,"},{"id":"semetey-2-2013:p1039:b004:l024","ordinal":265636,"en":"Was given the name Warrior Ümötöy."},{"id":"semetey-2-2013:p1039:b004:l025","ordinal":265637,"en":"Warrior Ümötöy has come."},{"id":"semetey-2-2013:p1039:b004:l026","ordinal":265638,"en":"Saying, ‘Pay my father’s blood-price,’"},{"id":"semetey-2-2013:p1039:b004:l027","ordinal":265639,"en":"He has come to besiege the people."},{"id":"semetey-2-2013:p1039:b004:l028","ordinal":265640,"en":"He says he will massacre"},{"id":"semetey-2-2013:p1039:b004:l029","ordinal":265641,"en":"Even the many venerable elders,"},{"id":"semetey-2-2013:p1039:b004:l030","ordinal":265642,"en":"And everyone he sees."},{"id":"semetey-2-2013:p1039:b004:l031","ordinal":265643,"en":"He says he will plunder their goods,"},{"id":"semetey-2-2013:p1039:b004:l032","ordinal":265644,"en":"He says he will sow utter ruin,"},{"id":"semetey-2-2013:p1039:b004:l033","ordinal":265645,"en":"He says he will settle the score in full."},{"id":"semetey-2-2013:p1039:b004:l034","ordinal":265646,"en":"If his father’s blood-price is not paid,"},{"id":"semetey-2-2013:p1039:b004:l035","ordinal":265647,"en":"He says he will raid and desolate the people."},{"id":"semetey-2-2013:p1039:b004:l036","ordinal":265648,"en":"Ümötöy of Khan Köksö—"},{"id":"semetey-2-2013:p1039:b004:l037","ordinal":265649,"en":"If we quarrel and clash with him,"},{"id":"semetey-2-2013:p1039:b004:l038","ordinal":265650,"en":"How can we ever come to terms?"},{"id":"semetey-2-2013:p1039:b004:l039","ordinal":265651,"en":"If we fight in bitter strife,"},{"id":"semetey-2-2013:p1040:b003:l001","ordinal":265652,"en":"Warrior, what will become of us in the end?"},{"id":"semetey-2-2013:p1040:b003:l002","ordinal":265653,"en":"If we choose and mount swift horses,"},{"id":"semetey-2-2013:p1040:b003:l003","ordinal":265654,"en":"Fire guns and draw bows,"},{"id":"semetey-2-2013:p1040:b003:l004","ordinal":265655,"en":"And thunder forward in pursuit,"},{"id":"semetey-2-2013:p1040:b003:l005","ordinal":265656,"en":"What will become of our blood?”"},{"id":"semetey-2-2013:p1040:b003:l006","ordinal":265657,"en":"So Külchoro"},{"id":"semetey-2-2013:p1040:b003:l007","ordinal":265658,"en":"Recounted the lay of the warrior,"},{"id":"semetey-2-2013:p1040:b003:l008","ordinal":265659,"en":"The mighty infidel, Köksö’s son."},{"id":"semetey-2-2013:p1040:b003:l009","ordinal":265660,"en":"There he stood and sang it."},{"id":"semetey-2-2013:p1040:b003:l010","ordinal":265661,"en":"He truthfully told"},{"id":"semetey-2-2013:p1040:b003:l011","ordinal":265662,"en":"What he had seen and learned."},{"id":"semetey-2-2013:p1040:b003:l012","ordinal":265663,"en":"He revealed the intentions"},{"id":"semetey-2-2013:p1040:b003:l013","ordinal":265664,"en":"Of the Kazakh who had come to meet them."},{"id":"semetey-2-2013:p1040:b003:l014","ordinal":265665,"en":"When Külchoro had spoken thus,"},{"id":"semetey-2-2013:p1040:b003:l015","ordinal":265666,"en":"His elder, lion Bakay—"},{"id":"semetey-2-2013:p1040:b003:l016","ordinal":265667,"en":"Behold his surpassing wisdom—"},{"id":"semetey-2-2013:p1040:b003:l017","ordinal":265668,"en":"Said, “That hero Ümötöy,"},{"id":"semetey-2-2013:p1040:b003:l018","ordinal":265669,"en":"Born to Khan Köksö,"},{"id":"semetey-2-2013:p1040:b003:l019","ordinal":265670,"en":"Has stirred turmoil across many lands."},{"id":"semetey-2-2013:p1040:b003:l020","ordinal":265671,"en":"You see what sort of man he is:"},{"id":"semetey-2-2013:p1040:b003:l021","ordinal":265672,"en":"His banner is motley, his spear brass,"},{"id":"semetey-2-2013:p1040:b003:l022","ordinal":265673,"en":"His horse swift and thunderous,"},{"id":"semetey-2-2013:p1040:b003:l023","ordinal":265674,"en":"His great lungs pounding,"},{"id":"semetey-2-2013:p1040:b003:l024","ordinal":265675,"en":"A sour-buttermilk, woolen-kurut,"},{"id":"semetey-2-2013:p1040:b003:l025","ordinal":265676,"en":"Empty-chested braggart."},{"id":"semetey-2-2013:p1040:b003:l026","ordinal":265677,"en":"To that broad-chested Kazakh,"},{"id":"semetey-2-2013:p1040:b003:l027","ordinal":265678,"en":"That swaggering scourge,"},{"id":"semetey-2-2013:p1040:b003:l028","ordinal":265679,"en":"Make a gift of sixty horses,"},{"id":"semetey-2-2013:p1040:b003:l029","ordinal":265680,"en":"With a stallion at their head."},{"id":"semetey-2-2013:p1040:b003:l030","ordinal":265681,"en":"Without dispute or quarrel,"},{"id":"semetey-2-2013:p1040:b003:l031","ordinal":265682,"en":"Make true peace with him!"},{"id":"semetey-2-2013:p1040:b003:l032","ordinal":265683,"en":"His father Köksö was a hero;"},{"id":"semetey-2-2013:p1040:b003:l033","ordinal":265684,"en":"He had long been"},{"id":"semetey-2-2013:p1040:b003:l034","ordinal":265685,"en":"A sworn comrade to Manas."},{"id":"semetey-2-2013:p1040:b003:l035","ordinal":265686,"en":"Every intention of his was pure;"},{"id":"semetey-2-2013:p1040:b003:l036","ordinal":265687,"en":"The magnanimous Manas and warrior Köksö"},{"id":"semetey-2-2013:p1040:b003:l037","ordinal":265688,"en":"Were true brothers and husbands of sisters."},{"id":"semetey-2-2013:p1040:b003:l038","ordinal":265689,"en":"When they rode to besiege the khan,"},{"id":"semetey-2-2013:p1040:b003:l039","ordinal":265690,"en":"When they brought slaughter upon the Chinese,"},{"id":"semetey-2-2013:p1040:b004:l001","ordinal":265691,"en":"It was Khan Köksö"},{"id":"semetey-2-2013:p1040:b004:l002","ordinal":265692,"en":"Who turned his blue-dappled charger’s head."},{"id":"semetey-2-2013:p1040:b004:l003","ordinal":265693,"en":"Unflinching beneath the banner,"},{"id":"semetey-2-2013:p1040:b004:l004","ordinal":265694,"en":"He stood firm as a fortress."},{"id":"semetey-2-2013:p1040:b004:l005","ordinal":265695,"en":"Strong in majesty and fierce in wrath,"},{"id":"semetey-2-2013:p1040:b004:l006","ordinal":265696,"en":"Köksö, son of Aydarkan,"},{"id":"semetey-2-2013:p1040:b004:l007","ordinal":265697,"en":"Was the mainstay of countless souls."},{"id":"semetey-2-2013:p1040:b004:l008","ordinal":265698,"en":"He was a khan who subdued"},{"id":"semetey-2-2013:p1040:b004:l009","ordinal":265699,"en":"Chynmachyn and the Khagan’s realm."},{"id":"semetey-2-2013:p1040:b004:l010","ordinal":265700,"en":"When they entered Beijing, their wives were kin;"},{"id":"semetey-2-2013:p1040:b004:l011","ordinal":265701,"en":"Köksö and Manas had matching names,"},{"id":"semetey-2-2013:p1040:b004:l012","ordinal":265702,"en":"And such was his valor."},{"id":"semetey-2-2013:p1040:b004:l013","ordinal":265703,"en":"Five sets of nine mares,"},{"id":"semetey-2-2013:p1040:b004:l014","ordinal":265704,"en":"For God’s sake, for my sake,"},{"id":"semetey-2-2013:p1040:b004:l015","ordinal":265705,"en":"And for the sake of the lions Köksö and Manas—"},{"id":"semetey-2-2013:p1040:b004:l016","ordinal":265706,"en":"Go and present them as a gift."},{"id":"semetey-2-2013:p1040:b004:l017","ordinal":265707,"en":"Heed the words I have spoken;"},{"id":"semetey-2-2013:p1040:b004:l018","ordinal":265708,"en":"Give grim-hearted Ümötöy"},{"id":"semetey-2-2013:p1040:b004:l019","ordinal":265709,"en":"Whatever he desires."},{"id":"semetey-2-2013:p1040:b004:l020","ordinal":265710,"en":"Go before him without hostility,"},{"id":"semetey-2-2013:p1040:b004:l021","ordinal":265711,"en":"Saying, ‘Come and go freely among us."},{"id":"semetey-2-2013:p1040:b004:l022","ordinal":265712,"en":"True gray-maned warrior,"},{"id":"semetey-2-2013:p1040:b004:l023","ordinal":265713,"en":"Recognize our kinship,’"},{"id":"semetey-2-2013:p1040:b004:l024","ordinal":265714,"en":"And make him your kinsman.”"},{"id":"semetey-2-2013:p1040:b004:l025","ordinal":265715,"en":"After Bakay had spoken these words,"},{"id":"semetey-2-2013:p1040:b004:l026","ordinal":265716,"en":"Straining to have her say,"},{"id":"semetey-2-2013:p1040:b004:l027","ordinal":265717,"en":"With wisdom inspired from the unseen,"},{"id":"semetey-2-2013:p1040:b004:l028","ordinal":265718,"en":"Kanykey’s turn came."},{"id":"semetey-2-2013:p1040:b004:l029","ordinal":265719,"en":"Then Kanykey said:"},{"id":"semetey-2-2013:p1040:b004:l030","ordinal":265720,"en":"“My princely sons, listen;"},{"id":"semetey-2-2013:p1040:b004:l031","ordinal":265721,"en":"I have a remarkable tale to tell."},{"id":"semetey-2-2013:p1040:b004:l032","ordinal":265722,"en":"If I speak and lament at length,"},{"id":"semetey-2-2013:p1040:b004:l033","ordinal":265723,"en":"The words themselves are precious before God."},{"id":"semetey-2-2013:p1040:b004:l034","ordinal":265724,"en":"In Karakhan’s household"},{"id":"semetey-2-2013:p1040:b004:l035","ordinal":265725,"en":"There were exactly twelve of us girls."},{"id":"semetey-2-2013:p1040:b004:l036","ordinal":265726,"en":"The eldest of the twelve"},{"id":"semetey-2-2013:p1040:b004:l037","ordinal":265727,"en":"Was Akerkech, whom Köksö married;"},{"id":"semetey-2-2013:p1040:b004:l038","ordinal":265728,"en":"Burulkan, whom Buudaykan married;"}]
