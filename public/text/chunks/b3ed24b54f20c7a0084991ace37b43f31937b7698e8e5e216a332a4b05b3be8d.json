[{"id":"semetey-1-2013:p0902:b003:l036","ordinal":145921,"en":"And put an end to him."},{"id":"semetey-1-2013:p0902:b003:l037","ordinal":145922,"en":"Some people tell this tale;"},{"id":"semetey-1-2013:p0902:b003:l038","ordinal":145923,"en":"Who knows whether it is false or true?"},{"id":"semetey-1-2013:p0902:b003:l039","ordinal":145924,"en":"They tell the horror convincingly."},{"id":"semetey-1-2013:p0902:b004:l001","ordinal":145925,"en":"If you support me, forty companions,"},{"id":"semetey-1-2013:p0902:b004:l002","ordinal":145926,"en":"I shall attack Andijan,"},{"id":"semetey-1-2013:p0902:b004:l003","ordinal":145927,"en":"I shall raise an uproar,"},{"id":"semetey-1-2013:p0902:b004:l004","ordinal":145928,"en":"I shall avenge Chubak's blood!"},{"id":"semetey-1-2013:p0902:b004:l005","ordinal":145929,"en":"If what is told is true,"},{"id":"semetey-1-2013:p0902:b004:l006","ordinal":145930,"en":"There is a tale of his wandering away,"},{"id":"semetey-1-2013:p0902:b004:l007","ordinal":145931,"en":"My dauntless lion Chubak"},{"id":"semetey-1-2013:p0902:b004:l008","ordinal":145932,"en":"Saw many things in those places."},{"id":"semetey-1-2013:p0902:b004:l009","ordinal":145933,"en":"Who knows whether this is false or true?"},{"id":"semetey-1-2013:p0902:b004:l010","ordinal":145934,"en":"Only the Creator knows!"},{"id":"semetey-1-2013:p0902:b004:l011","ordinal":145935,"en":"I have drawn upon tradition,"},{"id":"semetey-1-2013:p0902:b004:l012","ordinal":145936,"en":"Weighing out and giving gold,"},{"id":"semetey-1-2013:p0902:b004:l013","ordinal":145937,"en":"I asked about this Chubak's fate"},{"id":"semetey-1-2013:p0902:b004:l014","ordinal":145938,"en":"From the caravan travelers."},{"id":"semetey-1-2013:p0902:b004:l015","ordinal":145939,"en":"Some of the travelers tell this:"},{"id":"semetey-1-2013:p0902:b004:l016","ordinal":145940,"en":"They tell horrors that torment the soul."},{"id":"semetey-1-2013:p0902:b004:l017","ordinal":145941,"en":"Running wild with Kogala,"},{"id":"semetey-1-2013:p0902:b004:l018","ordinal":145942,"en":"And your dauntless Chubak grew frenzied."},{"id":"semetey-1-2013:p0902:b004:l019","ordinal":145943,"en":"His strength failed, his power ebbed,"},{"id":"semetey-1-2013:p0902:b004:l020","ordinal":145944,"en":"Blood flowed streaming from his wound,"},{"id":"semetey-1-2013:p0902:b004:l021","ordinal":145945,"en":"One by one, the feathers are united,"},{"id":"semetey-1-2013:p0902:b004:l022","ordinal":145946,"en":"His joint bones shuddered."},{"id":"semetey-1-2013:p0902:b004:l023","ordinal":145947,"en":"There was no forest to shelter him,"},{"id":"semetey-1-2013:p0902:b004:l024","ordinal":145948,"en":"There was no companion to stand by him."},{"id":"semetey-1-2013:p0902:b004:l025","ordinal":145949,"en":"His strength failed, his power ebbed;"},{"id":"semetey-1-2013:p0902:b004:l026","ordinal":145950,"en":"What could dear Chubak do?"},{"id":"semetey-1-2013:p0902:b004:l027","ordinal":145951,"en":"I heard he entered Margalan."},{"id":"semetey-1-2013:p0902:b004:l028","ordinal":145952,"en":"In Margalan, Malabek"},{"id":"semetey-1-2013:p0902:b004:l029","ordinal":145953,"en":"Had a grudge against him from the first."},{"id":"semetey-1-2013:p0902:b004:l030","ordinal":145954,"en":"That man who had fallen ill,"},{"id":"semetey-1-2013:p0902:b004:l031","ordinal":145955,"en":"Malabek seized him, they say,"},{"id":"semetey-1-2013:p0902:b004:l032","ordinal":145956,"en":"Gave him much burning poison,"},{"id":"semetey-1-2013:p0902:b004:l033","ordinal":145957,"en":"And put an end to him, they say."},{"id":"semetey-1-2013:p0902:b004:l034","ordinal":145958,"en":"His traces lead in every direction;"},{"id":"semetey-1-2013:p0902:b004:l035","ordinal":145959,"en":"My father's companion Chubak—"},{"id":"semetey-1-2013:p0902:b004:l036","ordinal":145960,"en":"If we pursue his story further,"},{"id":"semetey-1-2013:p0902:b004:l037","ordinal":145961,"en":"His affairs have no end."},{"id":"semetey-1-2013:p0902:b004:l038","ordinal":145962,"en":"Who knows whether it is false or a lie?"},{"id":"semetey-1-2013:p0902:b004:l039","ordinal":145963,"en":"Only the Creator knows."},{"id":"semetey-1-2013:p0903:b003:l001","ordinal":145964,"en":"His trail led to Margalan;"},{"id":"semetey-1-2013:p0903:b003:l002","ordinal":145965,"en":"I shall attack Margalan,"},{"id":"semetey-1-2013:p0903:b003:l003","ordinal":145966,"en":"I shall avenge Chubak."},{"id":"semetey-1-2013:p0903:b003:l004","ordinal":145967,"en":"Some people say:"},{"id":"semetey-1-2013:p0903:b003:l005","ordinal":145968,"en":"On the moon-pale yellow plain,"},{"id":"semetey-1-2013:p0903:b003:l006","ordinal":145969,"en":"Chubak staggered, bent over,"},{"id":"semetey-1-2013:p0903:b003:l007","ordinal":145970,"en":"And came upon Samarkan."},{"id":"semetey-1-2013:p0903:b003:l008","ordinal":145971,"en":"On the moon-pale yellow plain,"},{"id":"semetey-1-2013:p0903:b003:l009","ordinal":145972,"en":"Samarkan seized him, they say,"},{"id":"semetey-1-2013:p0903:b003:l010","ordinal":145973,"en":"Had him dragged onto the road,"},{"id":"semetey-1-2013:p0903:b003:l011","ordinal":145974,"en":"And torn apart by the Dangyts, they say."},{"id":"semetey-1-2013:p0903:b003:l012","ordinal":145975,"en":"Some people tell this,"},{"id":"semetey-1-2013:p0903:b003:l013","ordinal":145976,"en":"They tell horrors beyond belief."},{"id":"semetey-1-2013:p0903:b003:l014","ordinal":145977,"en":"Upon the city of Samarkand"},{"id":"semetey-1-2013:p0903:b003:l015","ordinal":145978,"en":"I shall bring the end of the world."},{"id":"semetey-1-2013:p0903:b003:l016","ordinal":145979,"en":"If you support me, forty companions,"},{"id":"semetey-1-2013:p0903:b003:l017","ordinal":145980,"en":"I shall avenge Chubak!"},{"id":"semetey-1-2013:p0903:b003:l018","ordinal":145981,"en":"Its khojas in patterned robes,"},{"id":"semetey-1-2013:p0903:b003:l019","ordinal":145982,"en":"Its mullahs who give lessons,"},{"id":"semetey-1-2013:p0903:b003:l020","ordinal":145983,"en":"I shall slaughter as sacrifices,"},{"id":"semetey-1-2013:p0903:b003:l021","ordinal":145984,"en":"Have them dragged onto the road,"},{"id":"semetey-1-2013:p0903:b003:l022","ordinal":145985,"en":"And torn apart by dogs!"},{"id":"semetey-1-2013:p0903:b003:l023","ordinal":145986,"en":"Once, on the rugged grassy heights,"},{"id":"semetey-1-2013:p0903:b003:l024","ordinal":145987,"en":"Of the misty plain,"},{"id":"semetey-1-2013:p0903:b003:l025","ordinal":145988,"en":"At its nearer grassy edge,"},{"id":"semetey-1-2013:p0903:b003:l026","ordinal":145989,"en":"Of the moon-pale yellow plain,"},{"id":"semetey-1-2013:p0903:b003:l027","ordinal":145990,"en":"At its nearer end,"},{"id":"semetey-1-2013:p0903:b003:l028","ordinal":145991,"en":"Kokand's khan Kozubek"},{"id":"semetey-1-2013:p0903:b003:l029","ordinal":145992,"en":"Seized him in the open, they say,"},{"id":"semetey-1-2013:p0903:b003:l030","ordinal":145993,"en":"There, Chubak's"},{"id":"semetey-1-2013:p0903:b003:l031","ordinal":145994,"en":"Head was cut off, they say."},{"id":"semetey-1-2013:p0903:b003:l032","ordinal":145995,"en":"Some people tell this."},{"id":"semetey-1-2013:p0903:b003:l033","ordinal":145996,"en":"Before reaching my full strength,"},{"id":"semetey-1-2013:p0903:b003:l034","ordinal":145997,"en":"Unless I die before long,"},{"id":"semetey-1-2013:p0903:b003:l035","ordinal":145998,"en":"I shall bring humiliation upon Kokand,"},{"id":"semetey-1-2013:p0903:b003:l036","ordinal":145999,"en":"For Chubak, my father's companion,"},{"id":"semetey-1-2013:p0903:b003:l037","ordinal":146000,"en":"I shall surely take revenge!"},{"id":"semetey-1-2013:p0903:b003:l038","ordinal":146001,"en":"Some people tell this:"},{"id":"semetey-1-2013:p0903:b003:l039","ordinal":146002,"en":"Struck by a bullet, the hero Chubak,"},{"id":"semetey-1-2013:p0903:b004:l001","ordinal":146003,"en":"Black blood flowed from his mouth,"},{"id":"semetey-1-2013:p0903:b004:l002","ordinal":146004,"en":"The leopard's strength ebbed away,"},{"id":"semetey-1-2013:p0903:b004:l003","ordinal":146005,"en":"Khan Chubak wandered on,"},{"id":"semetey-1-2013:p0903:b004:l004","ordinal":146006,"en":"Black blood streaming from his chest,"},{"id":"semetey-1-2013:p0903:b004:l005","ordinal":146007,"en":"Roaming the whole world,"},{"id":"semetey-1-2013:p0903:b004:l006","ordinal":146008,"en":"Through Old Turpan and broad Barbar,"},{"id":"semetey-1-2013:p0903:b004:l007","ordinal":146009,"en":"Traveling from the Kerege side,"},{"id":"semetey-1-2013:p0903:b004:l008","ordinal":146010,"en":"Wandering the gray plain,"},{"id":"semetey-1-2013:p0903:b004:l009","ordinal":146011,"en":"Skirting the gray shrines."},{"id":"semetey-1-2013:p0903:b004:l010","ordinal":146012,"en":"Tradition tells this story:"},{"id":"semetey-1-2013:p0903:b004:l011","ordinal":146013,"en":"Our father Chubak"},{"id":"semetey-1-2013:p0903:b004:l012","ordinal":146014,"en":"Forded Kum-Aryk, they say,"},{"id":"semetey-1-2013:p0903:b004:l013","ordinal":146015,"en":"Wandering through dark groves,"},{"id":"semetey-1-2013:p0903:b004:l014","ordinal":146016,"en":"From a foster child"},{"id":"semetey-1-2013:p0903:b004:l015","ordinal":146017,"en":"Of the poplar-covered promontories,"},{"id":"semetey-1-2013:p0903:b004:l016","ordinal":146018,"en":"He wandered along their tops,"},{"id":"semetey-1-2013:p0903:b004:l017","ordinal":146019,"en":"Looking at the tower,"},{"id":"semetey-1-2013:p0903:b004:l018","ordinal":146020,"en":"Following the banks of Jaman-Suu."},{"id":"semetey-1-2013:p0903:b004:l019","ordinal":146021,"en":"What could dear Chubak do?"},{"id":"semetey-1-2013:p0903:b004:l020","ordinal":146022,"en":"I heard he entered Kashgar."},{"id":"semetey-1-2013:p0903:b004:l021","ordinal":146023,"en":"The people of Kashgar seized him,"},{"id":"semetey-1-2013:p0903:b004:l022","ordinal":146024,"en":"They killed Khan Chubak."},{"id":"semetey-1-2013:p0903:b004:l023","ordinal":146025,"en":"Coughing in harsh bursts,"},{"id":"semetey-1-2013:p0903:b004:l024","ordinal":146026,"en":"Raising my head from the pillow,"},{"id":"semetey-1-2013:p0903:b004:l025","ordinal":146027,"en":"Unless, before I reach my full strength,"},{"id":"semetey-1-2013:p0903:b004:l026","ordinal":146028,"en":"I die before long,"},{"id":"semetey-1-2013:p0903:b004:l027","ordinal":146029,"en":"Upon this Kashgar"},{"id":"semetey-1-2013:p0903:b004:l028","ordinal":146030,"en":"I shall bring upheaval."},{"id":"semetey-1-2013:p0903:b004:l029","ordinal":146031,"en":"For Chubak, my father's companion,"},{"id":"semetey-1-2013:p0903:b004:l030","ordinal":146032,"en":"I shall take revenge without delay."},{"id":"semetey-1-2013:p0903:b004:l031","ordinal":146033,"en":"When my death comes, I shall die."},{"id":"semetey-1-2013:p0903:b004:l032","ordinal":146034,"en":"If you stand by me, forty companions,"},{"id":"semetey-1-2013:p0903:b004:l033","ordinal":146035,"en":"The decree that God has sent,"},{"id":"semetey-1-2013:p0903:b004:l034","ordinal":146036,"en":"I shall face it when it falls upon me."},{"id":"semetey-1-2013:p0903:b004:l035","ordinal":146037,"en":"My khan father was such a hero;"},{"id":"semetey-1-2013:p0903:b004:l036","ordinal":146038,"en":"Against the eighteen thousand worlds"},{"id":"semetey-1-2013:p0903:b004:l037","ordinal":146039,"en":"I shall go on fighting."},{"id":"semetey-1-2013:p0903:b004:l038","ordinal":146040,"en":"I can find no mountain to hurl myself against,"},{"id":"semetey-1-2013:p0903:b004:l039","ordinal":146041,"en":"If you stand by me, forty companions,"},{"id":"semetey-1-2013:p0904:b003:l001","ordinal":146042,"en":"I can find no foe to fight."},{"id":"semetey-1-2013:p0904:b003:l002","ordinal":146043,"en":"Give me a spear and send me against the foe;"},{"id":"semetey-1-2013:p0904:b003:l003","ordinal":146044,"en":"Every mountain I grapple with,"},{"id":"semetey-1-2013:p0904:b003:l004","ordinal":146045,"en":"If I do not crush it to powder,"},{"id":"semetey-1-2013:p0904:b003:l005","ordinal":146046,"en":"Then take my head!"},{"id":"semetey-1-2013:p0904:b003:l006","ordinal":146047,"en":"Stand by me when I enter combat,"},{"id":"semetey-1-2013:p0904:b003:l007","ordinal":146048,"en":"Stand by me when I enter battle!\""},{"id":"semetey-1-2013:p0904:b003:l008","ordinal":146049,"en":"The brave orphan left by Manas,"},{"id":"semetey-1-2013:p0904:b003:l009","ordinal":146050,"en":"Speaking words beyond compare,"},{"id":"semetey-1-2013:p0904:b003:l010","ordinal":146051,"en":"With six multitudes of horses on the hills,"},{"id":"semetey-1-2013:p0904:b003:l011","ordinal":146052,"en":"Thoroughbreds and swift steeds mingled,"},{"id":"semetey-1-2013:p0904:b003:l012","ordinal":146053,"en":"From among those horses"},{"id":"semetey-1-2013:p0904:b003:l013","ordinal":146054,"en":"He slaughtered six hundred white-gray mares."},{"id":"semetey-1-2013:p0904:b003:l014","ordinal":146055,"en":"That son of Manas"},{"id":"semetey-1-2013:p0904:b003:l015","ordinal":146056,"en":"Set all his former deeds aside."},{"id":"semetey-1-2013:p0904:b003:l016","ordinal":146057,"en":"Bakai, at the head of the forty companions,"},{"id":"semetey-1-2013:p0904:b003:l017","ordinal":146058,"en":"He swathed in rich horse fat,"},{"id":"semetey-1-2013:p0904:b003:l018","ordinal":146059,"en":"And propped upon horse tripe."},{"id":"semetey-1-2013:p0904:b003:l019","ordinal":146060,"en":"All the forty companions,"},{"id":"semetey-1-2013:p0904:b003:l020","ordinal":146061,"en":"If bored, he let them shoot roe deer;"},{"id":"semetey-1-2013:p0904:b003:l021","ordinal":146062,"en":"If not bored, he let them rest,"},{"id":"semetey-1-2013:p0904:b003:l022","ordinal":146063,"en":"Settling them back in their places,"},{"id":"semetey-1-2013:p0904:b003:l023","ordinal":146064,"en":"Letting them drink spirits without a care."},{"id":"semetey-1-2013:p0904:b003:l024","ordinal":146065,"en":"When thirsty, he gave them tea;"},{"id":"semetey-1-2013:p0904:b003:l025","ordinal":146066,"en":"When not thirsty, he gave them butter,"},{"id":"semetey-1-2013:p0904:b003:l026","ordinal":146067,"en":"Piling up sugar like snow,"},{"id":"semetey-1-2013:p0904:b003:l027","ordinal":146068,"en":"Heaping up yellow butter,"},{"id":"semetey-1-2013:p0904:b003:l028","ordinal":146069,"en":"Making their yurt felt greasy."},{"id":"semetey-1-2013:p0904:b003:l029","ordinal":146070,"en":"Whenever he met a companion,"},{"id":"semetey-1-2013:p0904:b003:l030","ordinal":146071,"en":"He enriched him on every side."},{"id":"semetey-1-2013:p0904:b003:l031","ordinal":146072,"en":"He clothed them in coats no bullet could pierce,"},{"id":"semetey-1-2013:p0904:b003:l032","ordinal":146073,"en":"Mounted them on horses no bullet could catch,"},{"id":"semetey-1-2013:p0904:b003:l033","ordinal":146074,"en":"Black mountain of Kasman"},{"id":"semetey-1-2013:p0904:b003:l034","ordinal":146075,"en":"Had every piece of their equipment"},{"id":"semetey-1-2013:p0904:b003:l035","ordinal":146076,"en":"Put properly in order,"},{"id":"semetey-1-2013:p0904:b003:l036","ordinal":146077,"en":"Had their spears well prepared,"},{"id":"semetey-1-2013:p0904:b003:l037","ordinal":146078,"en":"Had their battle-axes readied."},{"id":"semetey-1-2013:p0904:b003:l038","ordinal":146079,"en":"To bring slaughter upon the world,"},{"id":"semetey-1-2013:p0904:b003:l039","ordinal":146080,"en":"Semetey, son of the mighty man,"},{"id":"semetey-1-2013:p0904:b004:l001","ordinal":146081,"en":"Prepared with eagerness."},{"id":"semetey-1-2013:p0904:b004:l002","ordinal":146082,"en":"To avenge himself on the Chinese,"},{"id":"semetey-1-2013:p0904:b004:l003","ordinal":146083,"en":"The orphan did not fail to think it through:"},{"id":"semetey-1-2013:p0904:b004:l004","ordinal":146084,"en":"He readied fourteen horses."},{"id":"semetey-1-2013:p0904:b004:l005","ordinal":146085,"en":"And take her as your gift."},{"id":"semetey-1-2013:p0904:b004:l006","ordinal":146086,"en":"They stayed in Talas for five days."},{"id":"semetey-1-2013:p0904:b004:l007","ordinal":146087,"en":"Marking an ordo circle forty foot-lengths across,"},{"id":"semetey-1-2013:p0904:b004:l008","ordinal":146088,"en":"They eagerly shot their knucklebones,"},{"id":"semetey-1-2013:p0904:b004:l009","ordinal":146089,"en":"Staking forty young mares"},{"id":"semetey-1-2013:p0904:b004:l010","ordinal":146090,"en":"As their prizes,"},{"id":"semetey-1-2013:p0904:b004:l011","ordinal":146091,"en":"The winners slaughtering what they won."},{"id":"semetey-1-2013:p0904:b004:l012","ordinal":146092,"en":"With amusements and games,"},{"id":"semetey-1-2013:p0904:b004:l013","ordinal":146093,"en":"The forty companions were thus sated."},{"id":"semetey-1-2013:p0904:b004:l014","ordinal":146094,"en":"While he maintained the forty companions,"},{"id":"semetey-1-2013:p0904:b004:l015","ordinal":146095,"en":"While the boy ruled as khan,"},{"id":"semetey-1-2013:p0904:b004:l016","ordinal":146096,"en":"In Talas at that time,"},{"id":"semetey-1-2013:p0904:b004:l017","ordinal":146097,"en":"Rice was more plentiful than common grain,"},{"id":"semetey-1-2013:p0904:b004:l018","ordinal":146098,"en":"Silver more plentiful than tin,"},{"id":"semetey-1-2013:p0904:b004:l019","ordinal":146099,"en":"Foxes more plentiful than gray hares,"},{"id":"semetey-1-2013:p0904:b004:l020","ordinal":146100,"en":"Much wealth was stored in bundles."},{"id":"semetey-1-2013:p0904:b004:l021","ordinal":146101,"en":"They wore fox and sable furs;"},{"id":"semetey-1-2013:p0904:b004:l022","ordinal":146102,"en":"The forty companions and the multitude—"},{"id":"semetey-1-2013:p0904:b004:l023","ordinal":146103,"en":"Their life in those days,"},{"id":"semetey-1-2013:p0904:b004:l024","ordinal":146104,"en":"To the people of the world's last days,"},{"id":"semetey-1-2013:p0904:b004:l025","ordinal":146105,"en":"Became a tale worthy of telling."},{"id":"semetey-1-2013:p0904:b004:l026","ordinal":146106,"en":"(With rich braid ornaments and broad hips,"},{"id":"semetey-1-2013:p0904:b004:l027","ordinal":146107,"en":"Beautiful were the Kyrgyz brides;"},{"id":"semetey-1-2013:p0904:b004:l028","ordinal":146108,"en":"In red dresses, with crescent waists,"},{"id":"semetey-1-2013:p0904:b004:l029","ordinal":146109,"en":"Beautiful were the Kyrgyz girls;"},{"id":"semetey-1-2013:p0904:b004:l030","ordinal":146110,"en":"In black coats and white kalpaks,"},{"id":"semetey-1-2013:p0904:b004:l031","ordinal":146111,"en":"Handsome were the Kyrgyz young men.)"},{"id":"semetey-1-2013:p0904:b004:l032","ordinal":146112,"en":"In those days, the forty companions,"},{"id":"semetey-1-2013:p0904:b004:l033","ordinal":146113,"en":"With two marten-fur caps apiece"},{"id":"semetey-1-2013:p0904:b004:l034","ordinal":146114,"en":"Set on their brows, swayed in grandeur,"},{"id":"semetey-1-2013:p0904:b004:l035","ordinal":146115,"en":"Over the Argyn and Kyrgyz,"},{"id":"semetey-1-2013:p0904:b004:l036","ordinal":146116,"en":"Living joyfully as sultans."},{"id":"semetey-1-2013:p0904:b004:l037","ordinal":146117,"en":"The lost orphan had been found,"},{"id":"semetey-1-2013:p0904:b004:l038","ordinal":146118,"en":"The Kyrgyz people's shame was covered."},{"id":"semetey-1-2013:p0904:b004:l039","ordinal":146119,"en":"Manas, who had gone to the other world,"},{"id":"semetey-1-2013:p0905:b003:l001","ordinal":146120,"en":"It was as though he were still among them."},{"id":"semetey-1-2013:p0905:b003:l002","ordinal":146121,"en":"Pitching their court, the forty companions"},{"id":"semetey-1-2013:p0905:b003:l003","ordinal":146122,"en":"Settled again in Talas."},{"id":"semetey-1-2013:p0905:b003:l004","ordinal":146123,"en":"All the forty companions"},{"id":"semetey-1-2013:p0905:b003:l005","ordinal":146124,"en":"At Uirulmo-Saz"},{"id":"semetey-1-2013:p0905:b003:l006","ordinal":146125,"en":"Gathered round in assembly,"},{"id":"semetey-1-2013:p0905:b003:l007","ordinal":146126,"en":"At Chogulma-Saz"},{"id":"semetey-1-2013:p0905:b003:l008","ordinal":146127,"en":"Came together in assembly,"},{"id":"semetey-1-2013:p0905:b003:l009","ordinal":146128,"en":"Seeking one another out and meeting,"},{"id":"semetey-1-2013:p0905:b003:l010","ordinal":146129,"en":"Chasing one another in pursuit,"},{"id":"semetey-1-2013:p0905:b003:l011","ordinal":146130,"en":"Growing wild together,"},{"id":"semetey-1-2013:p0905:b003:l012","ordinal":146131,"en":"Hatching wicked plans."},{"id":"semetey-1-2013:p0905:b004:l001","ordinal":146132,"en":"The oath struck those oath-accursed men;"},{"id":"semetey-1-2013:p0905:b004:l002","ordinal":146133,"en":"The forty companions became fools."},{"id":"semetey-1-2013:p0905:b004:l003","ordinal":146134,"en":"A wickedness no one knew"},{"id":"semetey-1-2013:p0905:b004:l004","ordinal":146135,"en":"The forty companions resolved to devise."},{"id":"semetey-1-2013:p0905:b004:l005","ordinal":146136,"en":"They had died in earlier days,"},{"id":"semetey-1-2013:p0905:b004:l006","ordinal":146137,"en":"Tazbaimat and their elder Kyrgyl;"},{"id":"semetey-1-2013:p0905:b004:l007","ordinal":146138,"en":"Now kept that wickedness alive,"},{"id":"semetey-1-2013:p0905:b004:l008","ordinal":146139,"en":"All the forty companions."},{"id":"semetey-1-2013:p0905:b004:l009","ordinal":146140,"en":"Among the forty companions,"},{"id":"semetey-1-2013:p0905:b004:l010","ordinal":146141,"en":"What was there, and what was not?"},{"id":"semetey-1-2013:p0905:b004:l011","ordinal":146142,"en":"Damn you, fleeting world,"},{"id":"semetey-1-2013:p0905:b004:l012","ordinal":146143,"en":"Such was this shitty world!"},{"id":"semetey-1-2013:p0905:b006:l001","ordinal":146144,"en":"The forty swinish companions did not mend,"},{"id":"semetey-1-2013:p0905:b006:l002","ordinal":146145,"en":"They left no lurking wickedness undone,"},{"id":"semetey-1-2013:p0905:b006:l003","ordinal":146146,"en":"They would not side with Semetey."},{"id":"semetey-1-2013:p0905:b006:l004","ordinal":146147,"en":"Among those companions,"},{"id":"semetey-1-2013:p0905:b006:l005","ordinal":146148,"en":"There were leopards among spearmen,"},{"id":"semetey-1-2013:p0905:b006:l006","ordinal":146149,"en":"Skillful companions too;"},{"id":"semetey-1-2013:p0905:b006:l007","ordinal":146150,"en":"Clever in counsel, knowing their work,"},{"id":"semetey-1-2013:p0905:b006:l008","ordinal":146151,"en":"Excellent companions too;"},{"id":"semetey-1-2013:p0905:b006:l009","ordinal":146152,"en":"Wielders of the battle-axe,"},{"id":"semetey-1-2013:p0905:b006:l010","ordinal":146153,"en":"Warrior companions too;"},{"id":"semetey-1-2013:p0905:b006:l011","ordinal":146154,"en":"Whose secrets no one knew,"},{"id":"semetey-1-2013:p0905:b006:l012","ordinal":146155,"en":"Infidel companions too;"},{"id":"semetey-1-2013:p0905:b006:l013","ordinal":146156,"en":"Going wherever someone cried, 'Shoo!'"},{"id":"semetey-1-2013:p0905:b006:l014","ordinal":146157,"en":"Worthless companions too;"},{"id":"semetey-1-2013:p0905:b006:l015","ordinal":146158,"en":"Blustering, unable to grasp words,"},{"id":"semetey-1-2013:p0905:b006:l016","ordinal":146159,"en":"Ignorant companions too;"},{"id":"semetey-1-2013:p0905:b006:l017","ordinal":146160,"en":"Unable to speak or utter words,"},{"id":"semetey-1-2013:p0905:b006:l018","ordinal":146161,"en":"Inarticulate companions too;"},{"id":"semetey-1-2013:p0905:b006:l019","ordinal":146162,"en":"Unable to go outside at night,"},{"id":"semetey-1-2013:p0905:b006:l020","ordinal":146163,"en":"Cowardly companions too;"},{"id":"semetey-1-2013:p0905:b006:l021","ordinal":146164,"en":"Knowing much wisdom and cunning,"},{"id":"semetey-1-2013:p0905:b006:l022","ordinal":146165,"en":"Learned companions too;"},{"id":"semetey-1-2013:p0905:b008:l001","ordinal":146166,"en":"Exceedingly unruly, never keeping peace,"},{"id":"semetey-1-2013:p0905:b008:l002","ordinal":146167,"en":"Cruel companions too;"},{"id":"semetey-1-2013:p0905:b008:l003","ordinal":146168,"en":"Knowing their work in many ways,"},{"id":"semetey-1-2013:p0905:b008:l004","ordinal":146169,"en":"Clear-minded companions too;"},{"id":"semetey-1-2013:p0905:b008:l005","ordinal":146170,"en":"Spreading petty gossip,"},{"id":"semetey-1-2013:p0905:b008:l006","ordinal":146171,"en":"Disruptive companions too."},{"id":"semetey-1-2013:p0905:b008:l007","ordinal":146172,"en":"The best of the forty companions,"},{"id":"semetey-1-2013:p0905:b008:l008","ordinal":146173,"en":"The champion on whom they relied,"},{"id":"semetey-1-2013:p0905:b008:l009","ordinal":146174,"en":"The outstanding one among the forty,"},{"id":"semetey-1-2013:p0905:b008:l010","ordinal":146175,"en":"That God-stricken man was there,"},{"id":"semetey-1-2013:p0905:b008:l011","ordinal":146176,"en":"Chyibyt and Kochkor were there together."}]
