[{"id":"seytek-1991-continuation:p0347:b001:l017","ordinal":387329,"en":"As if a mountain had collapsed,"},{"id":"seytek-1991-continuation:p0347:b001:l018","ordinal":387330,"en":"The dun horse pitched over and lay still."},{"id":"seytek-1991-continuation:p0347:b001:l019","ordinal":387331,"en":"When Chyntengir was left on foot,"},{"id":"seytek-1991-continuation:p0347:b001:l020","ordinal":387332,"en":"Your father, the dear gray-maned hero,"},{"id":"seytek-1991-continuation:p0347:b001:l021","ordinal":387333,"en":"Hewed with his sword"},{"id":"seytek-1991-continuation:p0347:b002:l001","ordinal":387334,"en":"And shouted as he waged battle."},{"id":"seytek-1991-continuation:p0347:b003:l001","ordinal":387335,"en":"The sword shattered on the swine,"},{"id":"seytek-1991-continuation:p0347:b003:l002","ordinal":387336,"en":"Leaving only the hilt in his hand."},{"id":"seytek-1991-continuation:p0347:b003:l003","ordinal":387337,"en":"The Kaldays and chiefs,"},{"id":"seytek-1991-continuation:p0347:b003:l004","ordinal":387338,"en":"Men with iron lariat nets,"},{"id":"seytek-1991-continuation:p0347:b003:l005","ordinal":387339,"en":"All armed in iron,"},{"id":"seytek-1991-continuation:p0347:b003:l006","ordinal":387340,"en":"Fully armed infidels,"},{"id":"seytek-1991-continuation:p0347:b003:l007","ordinal":387341,"en":"Heroes who had come from Kakan,"},{"id":"seytek-1991-continuation:p0347:b003:l008","ordinal":387342,"en":"Mounted Chyntengir again"},{"id":"seytek-1991-continuation:p0347:b003:l009","ordinal":387343,"en":"On another swift stallion."},{"id":"seytek-1991-continuation:p0347:b003:l010","ordinal":387344,"en":"They put their khan on horseback,"},{"id":"seytek-1991-continuation:p0347:b003:l011","ordinal":387345,"en":"Burning Kenen's soul with anguish."},{"id":"seytek-1991-continuation:p0347:b003:l012","ordinal":387346,"en":"Then they cast iron lariat nets"},{"id":"seytek-1991-continuation:p0347:b003:l013","ordinal":387347,"en":"Over Kenen,"},{"id":"seytek-1991-continuation:p0347:b003:l014","ordinal":387348,"en":"Surrounded and attacked him,"},{"id":"seytek-1991-continuation:p0347:b003:l015","ordinal":387349,"en":"And truly robbed him of escape."},{"id":"seytek-1991-continuation:p0347:b003:l016","ordinal":387350,"en":"They firmly bound his hands."},{"id":"seytek-1991-continuation:p0347:b003:l017","ordinal":387351,"en":"Poor Kenen the leopard,"},{"id":"seytek-1991-continuation:p0347:b003:l018","ordinal":387352,"en":"The champion on whom hopes rested,"},{"id":"seytek-1991-continuation:p0347:b003:l019","ordinal":387353,"en":"The renowned hero of the Kyrgyz,"},{"id":"seytek-1991-continuation:p0347:b003:l020","ordinal":387354,"en":"Sultan of the white-capped people—"},{"id":"seytek-1991-continuation:p0347:b003:l021","ordinal":387355,"en":"Kenen was alone and the Chinese were a thousand."},{"id":"seytek-1991-continuation:p0347:b003:l022","ordinal":387356,"en":"They tore and ruined his coat,"},{"id":"seytek-1991-continuation:p0347:b003:l023","ordinal":387357,"en":"Displaying their great force,"},{"id":"seytek-1991-continuation:p0347:b003:l024","ordinal":387358,"en":"Tormenting his fly-like soul."},{"id":"seytek-1991-continuation:p0347:b003:l025","ordinal":387359,"en":"They wound his hands and feet tightly;"},{"id":"seytek-1991-continuation:p0347:b003:l026","ordinal":387360,"en":"Chyntengir bound and enclosed"},{"id":"seytek-1991-continuation:p0347:b003:l027","ordinal":387361,"en":"His entire body in chains."},{"id":"seytek-1991-continuation:p0347:b004:l001","ordinal":387362,"en":"They jerked him until his back bent,"},{"id":"seytek-1991-continuation:p0347:b004:l002","ordinal":387363,"en":"Loaded him upon a gray mule,"},{"id":"seytek-1991-continuation:p0347:b005:l001","ordinal":387364,"en":"And ordered, “Avenge your forefather!”"},{"id":"seytek-1991-continuation:p0347:b006:l001","ordinal":387365,"en":"They had their champions beat him"},{"id":"seytek-1991-continuation:p0347:b006:l002","ordinal":387366,"en":"And drove him before their khan."},{"id":"seytek-1991-continuation:p0347:b006:l003","ordinal":387367,"en":"Poor Kenen saw"},{"id":"seytek-1991-continuation:p0347:b006:l004","ordinal":387368,"en":"A cold and merciless black night."},{"id":"seytek-1991-continuation:p0347:b006:l005","ordinal":387369,"en":"“If you are a hero and a lion,"},{"id":"seytek-1991-continuation:p0347:b006:l006","ordinal":387370,"en":"Descendant of your Kalmyk forefather Kongurbay,"},{"id":"seytek-1991-continuation:p0347:b006:l007","ordinal":387371,"en":"Loosen my hands for a moment."},{"id":"seytek-1991-continuation:p0347:b006:l008","ordinal":387372,"en":"Let me see your heroism,"},{"id":"seytek-1991-continuation:p0347:b006:l009","ordinal":387373,"en":"And then I will take your head."},{"id":"seytek-1991-continuation:p0347:b006:l010","ordinal":387374,"en":"Release my hands,"},{"id":"seytek-1991-continuation:p0347:b006:l011","ordinal":387375,"en":"Then hear my answer."},{"id":"seytek-1991-continuation:p0347:b006:l012","ordinal":387376,"en":"While my eyelashes still move,"},{"id":"seytek-1991-continuation:p0347:b006:l013","ordinal":387377,"en":"How can you bend my back?"},{"id":"seytek-1991-continuation:p0347:b006:l014","ordinal":387378,"en":"How could I surrender my people?”"},{"id":"seytek-1991-continuation:p0347:b006:l015","ordinal":387379,"en":"Hearing this, Chyntengir said:"},{"id":"seytek-1991-continuation:p0347:b006:l016","ordinal":387380,"en":"“The Ala-Too is no land for us;"},{"id":"seytek-1991-continuation:p0347:b006:l017","ordinal":387381,"en":"The old enemy, the vile Burut,"},{"id":"seytek-1991-continuation:p0347:b006:l018","ordinal":387382,"en":"Will never be a people to us."},{"id":"seytek-1991-continuation:p0347:b006:l019","ordinal":387383,"en":"Inflict harsh torment;"},{"id":"seytek-1991-continuation:p0347:b006:l020","ordinal":387384,"en":"Silence his tongue without delay."},{"id":"seytek-1991-continuation:p0347:b006:l021","ordinal":387385,"en":"Bring his death upon him now,"},{"id":"seytek-1991-continuation:p0347:b006:l022","ordinal":387386,"en":"Deprive him of every recourse."},{"id":"seytek-1991-continuation:p0347:b006:l023","ordinal":387387,"en":"Cut strips of hide from his back;"},{"id":"seytek-1991-continuation:p0347:b006:l024","ordinal":387388,"en":"You blood-drinking champions,"},{"id":"seytek-1991-continuation:p0347:b006:l025","ordinal":387389,"en":"Seize him and take his life!"},{"id":"seytek-1991-continuation:p0347:b006:l026","ordinal":387390,"en":"Cut off his sheep-like head;"},{"id":"seytek-1991-continuation:p0347:b006:l027","ordinal":387391,"en":"Rip open his melon-like belly!”"},{"id":"seytek-1991-continuation:p0347:b006:l028","ordinal":387392,"en":"Thus Chyntengir spoke,"},{"id":"seytek-1991-continuation:p0347:b006:l029","ordinal":387393,"en":"Urging and dispatching"},{"id":"seytek-1991-continuation:p0347:b006:l030","ordinal":387394,"en":"His champions and giants,"},{"id":"seytek-1991-continuation:p0347:b006:l031","ordinal":387395,"en":"Rousing and dispatching"},{"id":"seytek-1991-continuation:p0347:b006:l032","ordinal":387396,"en":"His strongest heroes."},{"id":"seytek-1991-continuation:p0347:b006:l033","ordinal":387397,"en":"His champions and warriors"},{"id":"seytek-1991-continuation:p0347:b006:l034","ordinal":387398,"en":"Now began to trample and beat him,"},{"id":"seytek-1991-continuation:p0347:b006:l035","ordinal":387399,"en":"Inflicting every torture they knew."},{"id":"seytek-1991-continuation:p0347:b006:l036","ordinal":387400,"en":"They tormented and took his life,"},{"id":"seytek-1991-continuation:p0347:b006:l037","ordinal":387401,"en":"Cutting off his hands and feet."},{"id":"seytek-1991-continuation:p0347:b006:l038","ordinal":387402,"en":"The champions attacked"},{"id":"seytek-1991-continuation:p0347:b006:l039","ordinal":387403,"en":"The noble gray-maned hero"},{"id":"seytek-1991-continuation:p0347:b006:l040","ordinal":387404,"en":"And took his precious head;"},{"id":"seytek-1991-continuation:p0347:b006:l041","ordinal":387405,"en":"They finished him then and there."},{"id":"seytek-1991-continuation:p0347:b006:l042","ordinal":387406,"en":"“We slaughtered and destroyed the champion"},{"id":"seytek-1991-continuation:p0347:b006:l043","ordinal":387407,"en":"Whose stars crossed ours.”"},{"id":"seytek-1991-continuation:p0347:b006:l044","ordinal":387408,"en":"Breaking through the dead end and opening a road,"},{"id":"seytek-1991-continuation:p0347:b006:l045","ordinal":387409,"en":"The Chinese army attacked directly"},{"id":"seytek-1991-continuation:p0347:b006:l046","ordinal":387410,"en":"Against the true Black Kyrgyz."},{"id":"seytek-1991-continuation:p0348:b001:l001","ordinal":387411,"en":"Alymsaryk and hero Kulan,"},{"id":"seytek-1991-continuation:p0348:b001:l002","ordinal":387412,"en":"Defenders of all the people,"},{"id":"seytek-1991-continuation:p0348:b001:l003","ordinal":387413,"en":"Fought a vicious fight,"},{"id":"seytek-1991-continuation:p0348:b001:l004","ordinal":387414,"en":"Standing face-to-face,"},{"id":"seytek-1991-continuation:p0348:b001:l005","ordinal":387415,"en":"Fighting turn by turn,"},{"id":"seytek-1991-continuation:p0348:b001:l006","ordinal":387416,"en":"Locked in a bloody struggle."},{"id":"seytek-1991-continuation:p0348:b001:l007","ordinal":387417,"en":"Their father, gray-maned Jeljetpes,"},{"id":"seytek-1991-continuation:p0348:b001:l008","ordinal":387418,"en":"Was protecting the twin heroes,"},{"id":"seytek-1991-continuation:p0348:b001:l009","ordinal":387419,"en":"So the champion's line might endure."},{"id":"seytek-1991-continuation:p0348:b001:l010","ordinal":387420,"en":"He turned summer's day into winter,"},{"id":"seytek-1991-continuation:p0348:b001:l011","ordinal":387421,"en":"And plunged the Chinese and Kakan troops"},{"id":"seytek-1991-continuation:p0348:b001:l012","ordinal":387422,"en":"Who came against them into calamity."},{"id":"seytek-1991-continuation:p0348:b001:l013","ordinal":387423,"en":"He sent a flood and made it water."},{"id":"seytek-1991-continuation:p0348:b001:l014","ordinal":387424,"en":"The three heroes raised an uproar,"},{"id":"seytek-1991-continuation:p0348:b001:l015","ordinal":387425,"en":"Cutting through the standing Chinese host."},{"id":"seytek-1991-continuation:p0348:b001:l016","ordinal":387426,"en":"Supporting one another,"},{"id":"seytek-1991-continuation:p0348:b001:l017","ordinal":387427,"en":"They were drenched in bloody dust,"},{"id":"seytek-1991-continuation:p0348:b001:l018","ordinal":387428,"en":"And fought without turning back."},{"id":"seytek-1991-continuation:p0348:b001:l019","ordinal":387429,"en":"Jeljetpes moved through their midst;"},{"id":"seytek-1991-continuation:p0348:b001:l020","ordinal":387430,"en":"Wounded in seven places,"},{"id":"seytek-1991-continuation:p0348:b001:l021","ordinal":387431,"en":"He had a net spread before him."},{"id":"seytek-1991-continuation:p0348:b001:l022","ordinal":387432,"en":"After countless heroes"},{"id":"seytek-1991-continuation:p0348:b001:l023","ordinal":387433,"en":"From the Beijing host thrust at him,"},{"id":"seytek-1991-continuation:p0348:b001:l024","ordinal":387434,"en":"His life was truly scorched."},{"id":"seytek-1991-continuation:p0348:b002:l001","ordinal":387435,"en":"He was snatched from certain death,"},{"id":"seytek-1991-continuation:p0348:b002:l002","ordinal":387436,"en":"Caught in the fatal net,"},{"id":"seytek-1991-continuation:p0348:b002:l003","ordinal":387437,"en":"Yet Jeljetpes broke free and escaped."},{"id":"seytek-1991-continuation:p0348:b002:l004","ordinal":387438,"en":"Alymsaryk and Kulansaryk,"},{"id":"seytek-1991-continuation:p0348:b002:l005","ordinal":387439,"en":"Two fair heroes with rhyming names,"},{"id":"seytek-1991-continuation:p0348:b002:l006","ordinal":387440,"en":"Passed through the solitary foe."},{"id":"seytek-1991-continuation:p0348:b002:l007","ordinal":387441,"en":"Their muscular flesh was torn,"},{"id":"seytek-1991-continuation:p0348:b002:l008","ordinal":387442,"en":"And the flesh of their ribs ripped away;"},{"id":"seytek-1991-continuation:p0348:b002:l009","ordinal":387443,"en":"The two reached a quiet place."},{"id":"seytek-1991-continuation:p0348:b002:l010","ordinal":387444,"en":"Climbing to a mountain pass, they leaned down,"},{"id":"seytek-1991-continuation:p0348:b002:l011","ordinal":387445,"en":"And on a truly sacred hill"},{"id":"seytek-1991-continuation:p0348:b002:l012","ordinal":387446,"en":"They dozed and fell asleep."},{"id":"seytek-1991-continuation:p0348:b002:l013","ordinal":387447,"en":"Their closed eyes would not open,"},{"id":"seytek-1991-continuation:p0348:b002:l014","ordinal":387448,"en":"Their outstretched legs would not draw in,"},{"id":"seytek-1991-continuation:p0348:b002:l015","ordinal":387449,"en":"And their deep snoring did not cease."},{"id":"seytek-1991-continuation:p0348:b002:l016","ordinal":387450,"en":"They sank into a giant's sleep."},{"id":"seytek-1991-continuation:p0348:b002:l017","ordinal":387451,"en":"Jeljetpes and the twin heroes"},{"id":"seytek-1991-continuation:p0348:b002:l018","ordinal":387452,"en":"Let the horses they had ridden to war"},{"id":"seytek-1991-continuation:p0348:b002:l019","ordinal":387453,"en":"Cool fully and drink their fill."},{"id":"seytek-1991-continuation:p0348:b002:l020","ordinal":387454,"en":"They grazed them on feather grass,"},{"id":"seytek-1991-continuation:p0348:b002:l021","ordinal":387455,"en":"Led them a little while,"},{"id":"seytek-1991-continuation:p0348:b002:l022","ordinal":387456,"en":"And filled their throats with grass;"},{"id":"seytek-1991-continuation:p0348:b002:l023","ordinal":387457,"en":"Led them a long while,"},{"id":"seytek-1991-continuation:p0348:b002:l024","ordinal":387458,"en":"And filled their chests with grass."}]
