[{"id":"manas-2010:p1025:b001:l022","ordinal":44801,"en":"Falsely saying, ‘I'll scout ahead,’"},{"id":"manas-2010:p1025:b001:l023","ordinal":44802,"en":"The settled people, the mighty Turks,"},{"id":"manas-2010:p1025:b001:l024","ordinal":44803,"en":"You mean to abandon."},{"id":"manas-2010:p1025:b001:l025","ordinal":44804,"en":"To enjoy your own people's pleasures,"},{"id":"manas-2010:p1025:b001:l026","ordinal":44805,"en":"Scouting without a backward glance,"},{"id":"manas-2010:p1025:b001:l027","ordinal":44806,"en":"You bastard, Chinese dog,"},{"id":"manas-2010:p1025:b001:l028","ordinal":44807,"en":"You mean to go away!"},{"id":"manas-2010:p1025:b001:l029","ordinal":44808,"en":"Let me shatter Beijing,"},{"id":"manas-2010:p1025:b001:l030","ordinal":44809,"en":"Let me break your back!"},{"id":"manas-2010:p1025:b001:l031","ordinal":44810,"en":"You Chinese slave with a rustling robe,"},{"id":"manas-2010:p1025:b001:l032","ordinal":44811,"en":"Shall I chill your breath?!”"},{"id":"manas-2010:p1025:b001:l033","ordinal":44812,"en":"As Chubak stood there raging,"},{"id":"manas-2010:p1025:b001:l034","ordinal":44813,"en":"As God struck Chubak down,"},{"id":"manas-2010:p1025:b001:l035","ordinal":44814,"en":"With brown eyes free of flecks,"},{"id":"manas-2010:p1025:b001:l036","ordinal":44815,"en":"With a fair face free of freckles,"},{"id":"manas-2010:p1025:b001:l037","ordinal":44816,"en":"Azizkan's only son—"},{"id":"manas-2010:p1025:b001:l038","ordinal":44817,"en":"Clouds gathered from the sky;"},{"id":"manas-2010:p1025:b001:l039","ordinal":44818,"en":"Sixty anxieties came at once,"},{"id":"manas-2010:p1025:b001:l040","ordinal":44819,"en":"His ribs seemed to split apart,"},{"id":"manas-2010:p1025:b001:l041","ordinal":44820,"en":"Flame poured from his mouth,"},{"id":"manas-2010:p1025:b001:l042","ordinal":44821,"en":"He looked like a lion,"},{"id":"manas-2010:p1026:b001:l001","ordinal":44822,"en":"Without leaning on his battle-steel,"},{"id":"manas-2010:p1026:b001:l002","ordinal":44823,"en":"Blue-maned tiger Almambet,"},{"id":"manas-2010:p1026:b001:l003","ordinal":44824,"en":"Holding his life cheap before Chubak,"},{"id":"manas-2010:p1026:b001:l004","ordinal":44825,"en":"His face darkened and bristling,"},{"id":"manas-2010:p1026:b001:l005","ordinal":44826,"en":"His hair rose on end."},{"id":"manas-2010:p1026:b001:l006","ordinal":44827,"en":"He thundered in fury,"},{"id":"manas-2010:p1026:b001:l007","ordinal":44828,"en":"Without a thought for his fragile life;"},{"id":"manas-2010:p1026:b001:l008","ordinal":44829,"en":"Like a true lion he roared."},{"id":"manas-2010:p1026:b001:l009","ordinal":44830,"en":"He turned the steed Sarala sideways,"},{"id":"manas-2010:p1026:b001:l010","ordinal":44831,"en":"And to ill-fated Chubak"},{"id":"manas-2010:p1026:b001:l011","ordinal":44832,"en":"Almambet began in earnest:"},{"id":"manas-2010:p1026:b001:l012","ordinal":44833,"en":"“Think a little, Chubak,"},{"id":"manas-2010:p1026:b001:l013","ordinal":44834,"en":"You swaggering bastard!"},{"id":"manas-2010:p1026:b001:l014","ordinal":44835,"en":"For whom do I scout Beijing?"},{"id":"manas-2010:p1026:b001:l015","ordinal":44836,"en":"For the sacred faith,"},{"id":"manas-2010:p1026:b001:l016","ordinal":44837,"en":"For the vast people behind us!"},{"id":"manas-2010:p1026:b001:l017","ordinal":44838,"en":"From Beijing, where the Prophet would not go,"},{"id":"manas-2010:p1026:b001:l018","ordinal":44839,"en":"Lest disaster come upon you—"},{"id":"manas-2010:p1026:b001:l019","ordinal":44840,"en":"Understand, Chubak: it is for you!"},{"id":"manas-2010:p1026:b001:l020","ordinal":44841,"en":"The Chinese defenses are strong;"},{"id":"manas-2010:p1026:b001:l021","ordinal":44842,"en":"Their dust flies up in flames,"},{"id":"manas-2010:p1026:b001:l022","ordinal":44843,"en":"Lest their hell fall upon you,"},{"id":"manas-2010:p1026:b001:l023","ordinal":44844,"en":"For whom do I bar the road?"},{"id":"manas-2010:p1026:b001:l024","ordinal":44845,"en":"For you, hell-bound Chubak!?"},{"id":"manas-2010:p1026:b001:l025","ordinal":44846,"en":"When I lived in Beijing,"},{"id":"manas-2010:p1026:b001:l026","ordinal":44847,"en":"Among the Chinese with rank-buttons on their caps,"},{"id":"manas-2010:p1026:b001:l027","ordinal":44848,"en":"I was the finest man's son."},{"id":"manas-2010:p1026:b001:l028","ordinal":44849,"en":"Ah, my overweening Chubak,"},{"id":"manas-2010:p1026:b001:l029","ordinal":44850,"en":"When was I a slave to the Noygut?"},{"id":"manas-2010:p1026:b001:l030","ordinal":44851,"en":"Among the Chinese in red jackets,"},{"id":"manas-2010:p1026:b001:l031","ordinal":44852,"en":"I was a great warrior's son."},{"id":"manas-2010:p1026:b001:l032","ordinal":44853,"en":"As if it had been yours from the outset,"},{"id":"manas-2010:p1026:b001:l033","ordinal":44854,"en":"You clamour for me to yield the road."},{"id":"manas-2010:p1026:b001:l034","ordinal":44855,"en":"When was I Khan Akbaltay's slave!?"},{"id":"manas-2010:p1026:b001:l035","ordinal":44856,"en":"Among the tightly belted Chinese,"},{"id":"manas-2010:p1026:b001:l036","ordinal":44857,"en":"I was a champion's son."},{"id":"manas-2010:p1026:b001:l037","ordinal":44858,"en":"I was fire when I struck the enemy."},{"id":"manas-2010:p1026:b001:l038","ordinal":44859,"en":"Like you, leaving his father far away,"},{"id":"manas-2010:p1026:b001:l039","ordinal":44860,"en":"Migrating to Talas,"},{"id":"manas-2010:p1026:b001:l040","ordinal":44861,"en":"Becoming Manas's companion,"},{"id":"manas-2010:p1026:b001:l041","ordinal":44862,"en":"Without shame, without honor,"},{"id":"manas-2010:p1026:b001:l042","ordinal":44863,"en":"A half-witted fool, you dog Chubak,"},{"id":"manas-2010:p1027:b001:l001","ordinal":44864,"en":"You flustered bastard—"},{"id":"manas-2010:p1027:b001:l002","ordinal":44865,"en":"I am not such an idiot!"},{"id":"manas-2010:p1027:b001:l003","ordinal":44866,"en":"Leaving your father far away,"},{"id":"manas-2010:p1027:b001:l004","ordinal":44867,"en":"Migrating here to Talas,"},{"id":"manas-2010:p1027:b001:l005","ordinal":44868,"en":"Becoming Manas's companion,"},{"id":"manas-2010:p1027:b001:l006","ordinal":44869,"en":"What are you, shameless Chubak?!"},{"id":"manas-2010:p1027:b001:l007","ordinal":44870,"en":"Renouncing my idol,"},{"id":"manas-2010:p1027:b001:l008","ordinal":44871,"en":"Leaving my Chinese homeland,"},{"id":"manas-2010:p1027:b001:l009","ordinal":44872,"en":"Cleansed of the dark religion,"},{"id":"manas-2010:p1027:b001:l010","ordinal":44873,"en":"From the vast Chinese people"},{"id":"manas-2010:p1027:b001:l011","ordinal":44874,"en":"Estranged through a dispute over faith,"},{"id":"manas-2010:p1027:b001:l012","ordinal":44875,"en":"What am I, living like this?!"},{"id":"manas-2010:p1027:b001:l013","ordinal":44876,"en":"Consider it, Chubak,"},{"id":"manas-2010:p1027:b001:l014","ordinal":44877,"en":"You babbling bastard!"},{"id":"manas-2010:p1027:b001:l015","ordinal":44878,"en":"I let you be all day,"},{"id":"manas-2010:p1027:b001:l016","ordinal":44879,"en":"And you kept sneering ‘Chinese,’"},{"id":"manas-2010:p1027:b001:l017","ordinal":44880,"en":"Spewing whatever came into your head."},{"id":"manas-2010:p1027:b001:l018","ordinal":44881,"en":"If you are a mighty lion blessed by Khizir,"},{"id":"manas-2010:p1027:b001:l019","ordinal":44882,"en":"If you are a warrior born a champion,"},{"id":"manas-2010:p1027:b001:l020","ordinal":44883,"en":"Why came you wandering from your homeland?!"},{"id":"manas-2010:p1027:b001:l021","ordinal":44884,"en":"For the sake of the afterlife,"},{"id":"manas-2010:p1027:b001:l022","ordinal":44885,"en":"Because there is a hell of torment,"},{"id":"manas-2010:p1027:b001:l023","ordinal":44886,"en":"I fled from my people and came."},{"id":"manas-2010:p1027:b001:l024","ordinal":44887,"en":"I broke with my country, calling it unbelieving;"},{"id":"manas-2010:p1027:b001:l025","ordinal":44888,"en":"‘My faith is dearer than the Chinese,’ I said."},{"id":"manas-2010:p1027:b001:l026","ordinal":44889,"en":"Hero, I scattered what I had gathered,"},{"id":"manas-2010:p1027:b001:l027","ordinal":44890,"en":"And upheld the precious faith."},{"id":"manas-2010:p1027:b001:l028","ordinal":44891,"en":"I rode here on Sarala:"},{"id":"manas-2010:p1027:b001:l029","ordinal":44892,"en":"‘Rather than be khan of the Chinese,"},{"id":"manas-2010:p1027:b001:l030","ordinal":44893,"en":"I will be a Muslim's dog,’ I said,"},{"id":"manas-2010:p1027:b001:l031","ordinal":44894,"en":"And wandered here from my people."},{"id":"manas-2010:p1027:b001:l032","ordinal":44895,"en":"It was God's doing."},{"id":"manas-2010:p1027:b001:l033","ordinal":44896,"en":"When I lived in Beijing,"},{"id":"manas-2010:p1027:b001:l034","ordinal":44897,"en":"With metal heels and broad boots,"},{"id":"manas-2010:p1027:b001:l035","ordinal":44898,"en":"Alöökö's Kongurbay—"},{"id":"manas-2010:p1027:b001:l036","ordinal":44899,"en":"How much more a man he was!"},{"id":"manas-2010:p1027:b001:l037","ordinal":44900,"en":"I left Beijing all alone;"},{"id":"manas-2010:p1027:b001:l038","ordinal":44901,"en":"When I ruled Beijing,"},{"id":"manas-2010:p1027:b001:l039","ordinal":44902,"en":"Of the countless Chinese people"},{"id":"manas-2010:p1027:b001:l040","ordinal":44903,"en":"I was the outstanding champion."},{"id":"manas-2010:p1027:b001:l041","ordinal":44904,"en":"For the sake of the world beyond,"},{"id":"manas-2010:p1027:b001:l042","ordinal":44905,"en":"For the sake of the afterlife,"},{"id":"manas-2010:p1028:b001:l001","ordinal":44906,"en":"Planted from yellow willow,"},{"id":"manas-2010:p1028:b001:l002","ordinal":44907,"en":"My willow grove stayed in Beijing."},{"id":"manas-2010:p1028:b001:l003","ordinal":44908,"en":"Fashioned from pure gold,"},{"id":"manas-2010:p1028:b001:l004","ordinal":44909,"en":"My throne stayed in Beijing."},{"id":"manas-2010:p1028:b001:l005","ordinal":44910,"en":"Gated city, teeming people,"},{"id":"manas-2010:p1028:b001:l006","ordinal":44911,"en":"My lineage stayed in Beijing."},{"id":"manas-2010:p1028:b001:l007","ordinal":44912,"en":"Of noble Chinese stock—"},{"id":"manas-2010:p1028:b001:l008","ordinal":44913,"en":"Sixty girls, forty bold women,"},{"id":"manas-2010:p1028:b001:l009","ordinal":44914,"en":"My wives stayed in Beijing."},{"id":"manas-2010:p1028:b001:l010","ordinal":44915,"en":"When I remember vast Beijing,"},{"id":"manas-2010:p1028:b001:l011","ordinal":44916,"en":"Its countless well-built houses,"},{"id":"manas-2010:p1028:b001:l012","ordinal":44917,"en":"The deeply rooted Chinese multitudes,"},{"id":"manas-2010:p1028:b001:l013","ordinal":44918,"en":"When those things come to mind,"},{"id":"manas-2010:p1028:b001:l014","ordinal":44919,"en":"My poor soul cannot hold together."},{"id":"manas-2010:p1028:b001:l015","ordinal":44920,"en":"Sarala, the steed, was well fed;"},{"id":"manas-2010:p1028:b001:l016","ordinal":44921,"en":"Among the countless Chinese"},{"id":"manas-2010:p1028:b001:l017","ordinal":44922,"en":"There was no Islamic faith."},{"id":"manas-2010:p1028:b001:l018","ordinal":44923,"en":"Had there been the Islamic faith,"},{"id":"manas-2010:p1028:b001:l019","ordinal":44924,"en":"To suffer reproaches here,"},{"id":"manas-2010:p1028:b001:l020","ordinal":44925,"en":"To be called a fugitive Chinese,"},{"id":"manas-2010:p1028:b001:l021","ordinal":44926,"en":"To grieve for my people,"},{"id":"manas-2010:p1028:b001:l022","ordinal":44927,"en":"To have you call me Chinese,"},{"id":"manas-2010:p1028:b001:l023","ordinal":44928,"en":"Why would I have left my people?"},{"id":"manas-2010:p1028:b001:l024","ordinal":44929,"en":"Rather than hear these words of yours,"},{"id":"manas-2010:p1028:b001:l025","ordinal":44930,"en":"Let me die at your hands here!"},{"id":"manas-2010:p1028:b001:l026","ordinal":44931,"en":"Even if I scout the whole world,"},{"id":"manas-2010:p1028:b001:l027","ordinal":44932,"en":"Will there ever be a time, dog Chubak,"},{"id":"manas-2010:p1028:b001:l028","ordinal":44933,"en":"When the name ‘Chinese’ leaves me?!"},{"id":"manas-2010:p1028:b001:l029","ordinal":44934,"en":"I came desiring your faith,"},{"id":"manas-2010:p1028:b001:l030","ordinal":44935,"en":"Your spiritual guide, the caliph-sultan!"},{"id":"manas-2010:p1028:b001:l031","ordinal":44936,"en":"You howling slave Chubak,"},{"id":"manas-2010:p1028:b001:l032","ordinal":44937,"en":"Whom did I ask to make me khan?!"},{"id":"manas-2010:p1028:b001:l033","ordinal":44938,"en":"Join forces with your khan,"},{"id":"manas-2010:p1028:b001:l034","ordinal":44939,"en":"You yelping dog Chubak!"},{"id":"manas-2010:p1028:b001:l035","ordinal":44940,"en":"Shall I beat out, here and now,"},{"id":"manas-2010:p1028:b001:l036","ordinal":44941,"en":"Your madness that has gone so far?!"},{"id":"manas-2010:p1028:b001:l037","ordinal":44942,"en":"Shall I turn infidel again,"},{"id":"manas-2010:p1028:b001:l038","ordinal":44943,"en":"Shall I truly break my faith?!"},{"id":"manas-2010:p1028:b001:l039","ordinal":44944,"en":"I had sought your religion,"},{"id":"manas-2010:p1028:b001:l040","ordinal":44945,"en":"Your spiritual guide, the sultan in Mecca."},{"id":"manas-2010:p1028:b001:l041","ordinal":44946,"en":"You shrieking slave Chubak,"},{"id":"manas-2010:p1028:b001:l042","ordinal":44947,"en":"Whom did I ask to make me lord?!"},{"id":"manas-2010:p1029:b001:l001","ordinal":44948,"en":"Were it not for champion Manas,"},{"id":"manas-2010:p1029:b001:l002","ordinal":44949,"en":"I would beat out, dog Chubak,"},{"id":"manas-2010:p1029:b001:l003","ordinal":44950,"en":"Your madness that has gone so far!"},{"id":"manas-2010:p1029:b001:l004","ordinal":44951,"en":"Returning to the Chinese people,"},{"id":"manas-2010:p1029:b001:l005","ordinal":44952,"en":"Let me put an end to your talk."},{"id":"manas-2010:p1029:b001:l006","ordinal":44953,"en":"What if I chill, dog Chubak,"},{"id":"manas-2010:p1029:b001:l007","ordinal":44954,"en":"That breath that gives you courage!"},{"id":"manas-2010:p1029:b001:l008","ordinal":44955,"en":"Let me let out, here and now,"},{"id":"manas-2010:p1029:b001:l009","ordinal":44956,"en":"The wind that swells you up."},{"id":"manas-2010:p1029:b001:l010","ordinal":44957,"en":"Since I settled in Talas,"},{"id":"manas-2010:p1029:b001:l011","ordinal":44958,"en":"I have kept company with your lowliest."},{"id":"manas-2010:p1029:b001:l012","ordinal":44959,"en":"Wavering by day,"},{"id":"manas-2010:p1029:b001:l013","ordinal":44960,"en":"Whining by night,"},{"id":"manas-2010:p1029:b001:l014","ordinal":44961,"en":"With whom have I disputed lordship?!"},{"id":"manas-2010:p1029:b001:l015","ordinal":44962,"en":"Dividing Talas with boundary lines,"},{"id":"manas-2010:p1029:b001:l016","ordinal":44963,"en":"You overweening dog Chubak,"},{"id":"manas-2010:p1029:b001:l017","ordinal":44964,"en":"You bluster and swagger about."},{"id":"manas-2010:p1029:b001:l018","ordinal":44965,"en":"Whom did I approach, saying ‘Make me lord’?"},{"id":"manas-2010:p1029:b001:l019","ordinal":44966,"en":"I destroyed my village, never mind you!"},{"id":"manas-2010:p1029:b001:l020","ordinal":44967,"en":"You howling slave Chubak,"},{"id":"manas-2010:p1029:b001:l021","ordinal":44968,"en":"I slaughtered my father, never mind you!"},{"id":"manas-2010:p1029:b001:l022","ordinal":44969,"en":"I drenched his golden throne in blood."},{"id":"manas-2010:p1029:b001:l023","ordinal":44970,"en":"Ah, slave Chubak,"},{"id":"manas-2010:p1029:b001:l024","ordinal":44971,"en":"I killed Azizkan, never mind you!"},{"id":"manas-2010:p1029:b001:l025","ordinal":44972,"en":"I smeared the silver throne with fat,"},{"id":"manas-2010:p1029:b001:l026","ordinal":44973,"en":"You blustering slave Chubak,"},{"id":"manas-2010:p1029:b001:l027","ordinal":44974,"en":"I slaughtered and killed my father, never mind you!”"},{"id":"manas-2010:p1029:b001:l028","ordinal":44975,"en":"So saying, Almambet,"},{"id":"manas-2010:p1029:b001:l029","ordinal":44976,"en":"On stake-necked Sarala,"},{"id":"manas-2010:p1029:b001:l030","ordinal":44977,"en":"The noble lion leaned back."},{"id":"manas-2010:p1029:b001:l031","ordinal":44978,"en":"His double-edged blue steel"},{"id":"manas-2010:p1029:b001:l032","ordinal":44979,"en":"He drew from its sheath,"},{"id":"manas-2010:p1029:b001:l033","ordinal":44980,"en":"And charged at Chubak:"},{"id":"manas-2010:p1029:b001:l034","ordinal":44981,"en":"“Let me take his apple-like head,"},{"id":"manas-2010:p1029:b001:l035","ordinal":44982,"en":"Kill him upon the road,"},{"id":"manas-2010:p1029:b001:l036","ordinal":44983,"en":"And make him food for dogs!”"},{"id":"manas-2010:p1029:b001:l037","ordinal":44984,"en":"The earth split with a roar;"},{"id":"manas-2010:p1029:b001:l038","ordinal":44985,"en":"Azizkan's Almambet,"},{"id":"manas-2010:p1029:b001:l039","ordinal":44986,"en":"Thundering in his fury,"},{"id":"manas-2010:p1029:b001:l040","ordinal":44987,"en":"Almambet attacked in plain sight."},{"id":"manas-2010:p1029:b001:l041","ordinal":44988,"en":"Speeding on Kögala,"},{"id":"manas-2010:p1029:b001:l042","ordinal":44989,"en":"Without stopping, hero Chubak"},{"id":"manas-2010:p1030:b001:l001","ordinal":44990,"en":"Pulled off his right sleeve and flung it back,"},{"id":"manas-2010:p1030:b001:l002","ordinal":44991,"en":"Took his shield upon his back,"},{"id":"manas-2010:p1030:b001:l003","ordinal":44992,"en":"And grasped his hungry steel."},{"id":"manas-2010:p1030:b001:l004","ordinal":44993,"en":"Your Chubak entered without restraint."},{"id":"manas-2010:p1030:b001:l005","ordinal":44994,"en":"Their many kinds of weapons"},{"id":"manas-2010:p1030:b001:l006","ordinal":44995,"en":"They raised against each other now."},{"id":"manas-2010:p1030:b001:l007","ordinal":44996,"en":"Unable to draw in their reins,"},{"id":"manas-2010:p1030:b001:l008","ordinal":44997,"en":"The two nobly reared warriors"},{"id":"manas-2010:p1030:b001:l009","ordinal":44998,"en":"Could not bear to cut each other down;"},{"id":"manas-2010:p1030:b001:l010","ordinal":44999,"en":"Shouting, unable to strike with swords,"},{"id":"manas-2010:p1030:b001:l011","ordinal":45000,"en":"They stood threatening one another."},{"id":"manas-2010:p1030:b001:l012","ordinal":45001,"en":"Over the blue ridge shaped like a saddle,"},{"id":"manas-2010:p1030:b001:l013","ordinal":45002,"en":"Do you see him coming?"},{"id":"manas-2010:p1030:b001:l014","ordinal":45003,"en":"Speeding on Aybanboz,"},{"id":"manas-2010:p1030:b001:l015","ordinal":45004,"en":"Lion, tiger, leopard—"},{"id":"manas-2010:p1030:b001:l016","ordinal":45005,"en":"Do you see him hurrying?"},{"id":"manas-2010:p1030:b001:l017","ordinal":45006,"en":"His horse Aybanboz bounded on;"},{"id":"manas-2010:p1030:b001:l018","ordinal":45007,"en":"Almambet and Chubak"},{"id":"manas-2010:p1030:b001:l019","ordinal":45008,"en":"Stood lunging and clashing."},{"id":"manas-2010:p1030:b001:l020","ordinal":45009,"en":"Whipping Aybanboz,"},{"id":"manas-2010:p1030:b001:l021","ordinal":45010,"en":"He came riding up:"},{"id":"manas-2010:p1030:b001:l022","ordinal":45011,"en":"“My companions Almambet and Chubak"},{"id":"manas-2010:p1030:b001:l023","ordinal":45012,"en":"May suddenly be killed!”"},{"id":"manas-2010:p1030:b001:l024","ordinal":45013,"en":"Muttering, hero Manas"},{"id":"manas-2010:p1030:b001:l025","ordinal":45014,"en":"Came hurrying up."},{"id":"manas-2010:p1030:b001:l026","ordinal":45015,"en":"Reaching the two warriors,"},{"id":"manas-2010:p1030:b001:l027","ordinal":45016,"en":"These were the words he spoke:"},{"id":"manas-2010:p1030:b001:l028","ordinal":45017,"en":"“My lucky road when sent ahead,"},{"id":"manas-2010:p1030:b001:l029","ordinal":45018,"en":"My countless army when battle begins,"},{"id":"manas-2010:p1030:b001:l030","ordinal":45019,"en":"Almambet and Chubak, my twins,"},{"id":"manas-2010:p1030:b001:l031","ordinal":45020,"en":"My ocean that overwhelms the world,"},{"id":"manas-2010:p1030:b001:l032","ordinal":45021,"en":"My battle-axe of tempered steel,"},{"id":"manas-2010:p1030:b001:l033","ordinal":45022,"en":"Two lions, my great support on month-long marches!"},{"id":"manas-2010:p1030:b001:l034","ordinal":45023,"en":"Drawing swords and shouting,"},{"id":"manas-2010:p1030:b001:l035","ordinal":45024,"en":"Do not stand so close together!"},{"id":"manas-2010:p1030:b001:l036","ordinal":45025,"en":"Burning my poor soul,"},{"id":"manas-2010:p1030:b001:l037","ordinal":45026,"en":"Two lions, my matched pair,"},{"id":"manas-2010:p1030:b001:l038","ordinal":45027,"en":"Do not keep making such a spectacle!"},{"id":"manas-2010:p1030:b001:l039","ordinal":45028,"en":"Quarreling halfway along the road,"},{"id":"manas-2010:p1030:b001:l040","ordinal":45029,"en":"Do not whip each other side by side!”"},{"id":"manas-2010:p1030:b001:l041","ordinal":45030,"en":"Speaking these words, your blue-maned hero,"},{"id":"manas-2010:p1030:b001:l042","ordinal":45031,"en":"Your lion stepped between them."},{"id":"manas-2010:p1031:b001:l001","ordinal":45032,"en":"“They will strike one another;"},{"id":"manas-2010:p1031:b001:l002","ordinal":45033,"en":"The two lions confronting each other"},{"id":"manas-2010:p1031:b001:l003","ordinal":45034,"en":"May suddenly be killed!”"},{"id":"manas-2010:p1031:b001:l004","ordinal":45035,"en":"Manas rode up shouting."},{"id":"manas-2010:p1031:b001:l005","ordinal":45036,"en":"The swift steed Sarala,"},{"id":"manas-2010:p1031:b001:l006","ordinal":45037,"en":"With his right hand Khan Manas"},{"id":"manas-2010:p1031:b001:l007","ordinal":45038,"en":"Now seized by the bit."},{"id":"manas-2010:p1031:b001:l008","ordinal":45039,"en":"Taking Kögala's reins,"},{"id":"manas-2010:p1031:b001:l009","ordinal":45040,"en":"He held them in his left hand."},{"id":"manas-2010:p1031:b001:l010","ordinal":45041,"en":"Your lion, generous lord of battle,"},{"id":"manas-2010:p1031:b001:l011","ordinal":45042,"en":"Now stepped between them;"},{"id":"manas-2010:p1031:b001:l012","ordinal":45043,"en":"Parting them to either side,"},{"id":"manas-2010:p1031:b001:l013","ordinal":45044,"en":"He intervened and separated them."},{"id":"manas-2010:p1031:b001:l014","ordinal":45045,"en":"While Manas held them,"},{"id":"manas-2010:p1031:b001:l015","ordinal":45046,"en":"Struggling in fury,"},{"id":"manas-2010:p1031:b001:l016","ordinal":45047,"en":"Hero Chubak grew bolder:"},{"id":"manas-2010:p1031:b001:l017","ordinal":45048,"en":"“Chinese from Khangay!” he shouted,"},{"id":"manas-2010:p1031:b001:l018","ordinal":45049,"en":"Working himself up and struggling."},{"id":"manas-2010:p1031:b001:l019","ordinal":45050,"en":"Then Azizkan's Almambet said:"},{"id":"manas-2010:p1031:b001:l020","ordinal":45051,"en":"“Let me spill the villain's blood,"},{"id":"manas-2010:p1031:b001:l021","ordinal":45052,"en":"Let me open his stubbornly shut eyes!"},{"id":"manas-2010:p1031:b001:l022","ordinal":45053,"en":"Let go your hand!”"},{"id":"manas-2010:p1031:b001:l023","ordinal":45054,"en":"On the right, Almambet stood thundering."},{"id":"manas-2010:p1031:b001:l024","ordinal":45055,"en":"Blue-maned Khan Manas, lord of battle,"},{"id":"manas-2010:p1031:b001:l025","ordinal":45056,"en":"Held them and rebuked them:"}]
