[{"id":"semetey-1-2013:p0944:b004:l023","ordinal":148225,"en":"If blood falls upon the black earth,"},{"id":"semetey-1-2013:p0944:b004:l024","ordinal":148226,"en":"Look at her flesh, whiter than snow."},{"id":"semetey-1-2013:p0944:b004:l025","ordinal":148227,"en":"If blood falls upon snow,"},{"id":"semetey-1-2013:p0944:b004:l026","ordinal":148228,"en":"Look at the blood, then at her face."},{"id":"semetey-1-2013:p0944:b004:l027","ordinal":148229,"en":"Look at silk, then at her hair;"},{"id":"semetey-1-2013:p0944:b004:l028","ordinal":148230,"en":"Look at an apple, then at her head."},{"id":"semetey-1-2013:p0944:b004:l029","ordinal":148231,"en":"She had words spoken with cunning;"},{"id":"semetey-1-2013:p0944:b004:l030","ordinal":148232,"en":"Churok herself was a seer."},{"id":"semetey-1-2013:p0944:b004:l031","ordinal":148233,"en":"The queen worthy of a khan"},{"id":"semetey-1-2013:p0944:b004:l032","ordinal":148234,"en":"Had many kinds of words."},{"id":"semetey-1-2013:p0944:b004:l033","ordinal":148235,"en":"Above her lip,"},{"id":"semetey-1-2013:p0944:b004:l034","ordinal":148236,"en":"There was a slight upward curl,"},{"id":"semetey-1-2013:p0944:b004:l035","ordinal":148237,"en":"That ill-fated, dear Churok,"},{"id":"semetey-1-2013:p0944:b004:l036","ordinal":148238,"en":"Where was there any flaw in her?"},{"id":"semetey-1-2013:p0944:b004:l037","ordinal":148239,"en":"When she walked, her face shone;"},{"id":"semetey-1-2013:p0944:b004:l038","ordinal":148240,"en":"Sixty buttons, forty clasps,"},{"id":"semetey-1-2013:p0945:b003:l001","ordinal":148241,"en":"Upon that beautifully born dear girl's"},{"id":"semetey-1-2013:p0945:b003:l002","ordinal":148242,"en":"Breast, they jingled."},{"id":"semetey-1-2013:p0945:b003:l004","ordinal":148243,"en":"Unless God Himself knows,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0945:b003:l005","ordinal":148244,"en":"Akun's daughter Churok"},{"id":"semetey-1-2013:p0945:b003:l006","ordinal":148245,"en":"Has words of many kinds."},{"id":"semetey-1-2013:p0945:b003:l007","ordinal":148246,"en":"Unless God Himself knows,"},{"id":"semetey-1-2013:p0945:b003:l008","ordinal":148247,"en":"Akun's daughter Churok"},{"id":"semetey-1-2013:p0945:b003:l009","ordinal":148248,"en":"Has who knows what words."},{"id":"semetey-1-2013:p0945:b003:l010","ordinal":148249,"en":"Once, on Belendi's ridge,"},{"id":"semetey-1-2013:p0945:b003:l011","ordinal":148250,"en":"In the place where peris played,"},{"id":"semetey-1-2013:p0945:b003:l012","ordinal":148251,"en":"Khan Akun found her in a cradle."},{"id":"semetey-1-2013:p0945:b003:l013","ordinal":148252,"en":"If we listen closely, this is the tale:"},{"id":"semetey-1-2013:p0945:b003:l014","ordinal":148253,"en":"For poor Manas's son,"},{"id":"semetey-1-2013:p0945:b003:l015","ordinal":148254,"en":"A marriage alliance had been arranged."},{"id":"semetey-1-2013:p0945:b003:l016","ordinal":148255,"en":"That wily girl, a true seer,"},{"id":"semetey-1-2013:p0945:b004:l001","ordinal":148256,"en":"For Manas's only son"},{"id":"semetey-1-2013:p0945:b004:l002","ordinal":148257,"en":"Had been burning with longing."},{"id":"semetey-1-2013:p0945:b004:l003","ordinal":148258,"en":"Fortunate Toltoi—"},{"id":"semetey-1-2013:p0945:b004:l004","ordinal":148259,"en":"She knew he would become an enemy."},{"id":"semetey-1-2013:p0945:b004:l005","ordinal":148260,"en":"Manas, who had vanished—"},{"id":"semetey-1-2013:p0945:b004:l007","ordinal":148261,"en":"The roaring Kojo's","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0945:b004:l009","ordinal":148262,"en":"Manas, who had gone to the other world—","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0945:b004:l010","ordinal":148263,"en":"She had honored his spirit."},{"id":"semetey-1-2013:p0945:b004:l011","ordinal":148264,"en":"When Toltoi came to besiege her,"},{"id":"semetey-1-2013:p0945:b004:l012","ordinal":148265,"en":"When she suffered Kojo's humiliation,"},{"id":"semetey-1-2013:p0945:b004:l013","ordinal":148266,"en":"As her daily affairs came into order,"},{"id":"semetey-1-2013:p0945:b004:l014","ordinal":148267,"en":"To wander the whole wide world,"},{"id":"semetey-1-2013:p0945:b004:l015","ordinal":148268,"en":"The ill-fated daughter of Akun"},{"id":"semetey-1-2013:p0945:b004:l016","ordinal":148269,"en":"Resolved to disappear in flight."},{"id":"semetey-1-2013:p0945:b006:l001","ordinal":148270,"en":"Stretching like a lynx,"},{"id":"semetey-1-2013:p0945:b006:l002","ordinal":148271,"en":"Reluctant to utter words,"},{"id":"semetey-1-2013:p0945:b006:l003","ordinal":148272,"en":"With an exceedingly deep mind,"},{"id":"semetey-1-2013:p0945:b006:l004","ordinal":148273,"en":"Churok, daughter of a peri,"},{"id":"semetey-1-2013:p0945:b006:l005","ordinal":148274,"en":"Had endless things to say."},{"id":"semetey-1-2013:p0945:b006:l006","ordinal":148275,"en":"The whole world"},{"id":"semetey-1-2013:p0945:b006:l007","ordinal":148276,"en":"Was hers to wander."},{"id":"semetey-1-2013:p0945:b006:l008","ordinal":148277,"en":"No person could detect her;"},{"id":"semetey-1-2013:p0945:b006:l009","ordinal":148278,"en":"Such was her knowledge,"},{"id":"semetey-1-2013:p0945:b006:l010","ordinal":148279,"en":"No person could see her."},{"id":"semetey-1-2013:p0945:b006:l011","ordinal":148280,"en":"The four corners of the round world,"},{"id":"semetey-1-2013:p0945:b006:l012","ordinal":148281,"en":"If she circled them four times,"},{"id":"semetey-1-2013:p0945:b006:l013","ordinal":148282,"en":"She never grew weary or tired."},{"id":"semetey-1-2013:p0945:b006:l014","ordinal":148283,"en":"Even over a forty-day desert,"},{"id":"semetey-1-2013:p0945:b006:l015","ordinal":148284,"en":"She never grew tired or weary."},{"id":"semetey-1-2013:p0945:b006:l016","ordinal":148285,"en":"Whatever the many kinds of matters,"},{"id":"semetey-1-2013:p0945:b006:l017","ordinal":148286,"en":"She considered every one without exception."},{"id":"semetey-1-2013:p0945:b006:l018","ordinal":148287,"en":"Wise among women,"},{"id":"semetey-1-2013:p0945:b008:l001","ordinal":148288,"en":"No thought could flee and escape"},{"id":"semetey-1-2013:p0945:b008:l002","ordinal":148289,"en":"That infidel Churok."},{"id":"semetey-1-2013:p0945:b008:l003","ordinal":148290,"en":"Skilled was that ill-fated girl;"},{"id":"semetey-1-2013:p0945:b008:l004","ordinal":148291,"en":"Reading the Arabic tongue,"},{"id":"semetey-1-2013:p0945:b008:l005","ordinal":148292,"en":"Reciting every prayer at night,"},{"id":"semetey-1-2013:p0945:b008:l006","ordinal":148293,"en":"The day she flew was Friday,"},{"id":"semetey-1-2013:p0945:b008:l007","ordinal":148294,"en":"Her departure was on Qadr Night."},{"id":"semetey-1-2013:p0945:b008:l008","ordinal":148295,"en":"Roaming the whole world,"},{"id":"semetey-1-2013:p0945:b008:l009","ordinal":148296,"en":"Wandering over the earth,"},{"id":"semetey-1-2013:p0945:b008:l010","ordinal":148297,"en":"Chynkojo and Toltoi's"},{"id":"semetey-1-2013:p0945:b008:l011","ordinal":148298,"en":"Humiliation grieved her."},{"id":"semetey-1-2013:p0945:b008:l012","ordinal":148299,"en":"Putting on the form of a swan,"},{"id":"semetey-1-2013:p0945:b008:l013","ordinal":148300,"en":"She left Oogan, swift as a mirage."},{"id":"semetey-1-2013:p0945:b008:l014","ordinal":148301,"en":"Beating her wings, Aichurok"},{"id":"semetey-1-2013:p0945:b008:l015","ordinal":148302,"en":"Approached great Kashgar."},{"id":"semetey-1-2013:p0945:b008:l016","ordinal":148303,"en":"She saw a multitude in Kashgar;"},{"id":"semetey-1-2013:p0945:b008:l017","ordinal":148304,"en":"Your dear sister-in-law was amazed."},{"id":"semetey-1-2013:p0945:b008:l018","ordinal":148305,"en":"As she watched that people,"},{"id":"semetey-1-2013:p0946:b003:l001","ordinal":148306,"en":"They had round baked bread,"},{"id":"semetey-1-2013:p0946:b003:l002","ordinal":148307,"en":"They had four-cornered houses."},{"id":"semetey-1-2013:p0946:b003:l003","ordinal":148308,"en":"At that time, Kashgar"},{"id":"semetey-1-2013:p0946:b003:l004","ordinal":148309,"en":"Was ruled by Kangshybek."},{"id":"semetey-1-2013:p0946:b003:l005","ordinal":148310,"en":"'One of the worthy heroes,' she thought,"},{"id":"semetey-1-2013:p0946:b003:l006","ordinal":148311,"en":"And Aichurok put him to the test."},{"id":"semetey-1-2013:p0946:b003:l007","ordinal":148312,"en":"When she examined Kangshybek,"},{"id":"semetey-1-2013:p0946:b003:l008","ordinal":148313,"en":"With his bristling, tassel-like beard,"},{"id":"semetey-1-2013:p0946:b003:l009","ordinal":148314,"en":"He proved to be one of the wretched ones."},{"id":"semetey-1-2013:p0946:b003:l010","ordinal":148315,"en":"Directing his caravans,"},{"id":"semetey-1-2013:p0946:b003:l011","ordinal":148316,"en":"He was a man of the road."},{"id":"semetey-1-2013:p0946:b003:l012","ordinal":148317,"en":"Making his gray mule hold its head high,"},{"id":"semetey-1-2013:p0946:b003:l013","ordinal":148318,"en":"He rode upon a packsaddle."},{"id":"semetey-1-2013:p0946:b003:l014","ordinal":148319,"en":"He summered in a hot place."},{"id":"semetey-1-2013:p0946:b003:l015","ordinal":148320,"en":"Whether walking or standing, at his waist"},{"id":"semetey-1-2013:p0946:b003:l016","ordinal":148321,"en":"He tied a flatbread as large as a hoe."},{"id":"semetey-1-2013:p0946:b003:l017","ordinal":148322,"en":"A great hoe shaped like a vulture's tail"},{"id":"semetey-1-2013:p0946:b003:l018","ordinal":148323,"en":"He carried over his back."},{"id":"semetey-1-2013:p0946:b003:l019","ordinal":148324,"en":"His shirt open, his chest bare,"},{"id":"semetey-1-2013:p0946:b003:l020","ordinal":148325,"en":"He was neither renowned nor a support,"},{"id":"semetey-1-2013:p0946:b003:l021","ordinal":148326,"en":"No man whom a mortal could trust as a champion"},{"id":"semetey-1-2013:p0946:b003:l022","ordinal":148327,"en":"And take as a husband."},{"id":"semetey-1-2013:p0946:b003:l023","ordinal":148328,"en":"Not wishing to look at him, she passed on,"},{"id":"semetey-1-2013:p0946:b003:l024","ordinal":148329,"en":"Turned this way, wandering,"},{"id":"semetey-1-2013:p0946:b003:l025","ordinal":148330,"en":"Crossed Erkech-Tam,"},{"id":"semetey-1-2013:p0946:b003:l026","ordinal":148331,"en":"And passed through great Andijan."},{"id":"semetey-1-2013:p0946:b003:l027","ordinal":148332,"en":"Synjybek of Andijan—"},{"id":"semetey-1-2013:p0946:b003:l028","ordinal":148333,"en":"She examined him as she passed."},{"id":"semetey-1-2013:p0946:b003:l029","ordinal":148334,"en":"When she judged Synjybek,"},{"id":"semetey-1-2013:p0946:b003:l031","ordinal":148335,"en":"These ruined men—","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0946:b003:l032","ordinal":148336,"en":"All their horses were stallions,"},{"id":"semetey-1-2013:p0946:b003:l033","ordinal":148337,"en":"With no cruppers at all."},{"id":"semetey-1-2013:p0946:b003:l034","ordinal":148338,"en":"His blue overshoes sticking out,"},{"id":"semetey-1-2013:p0946:b003:l035","ordinal":148339,"en":"His thoroughbred holding its head high,"},{"id":"semetey-1-2013:p0946:b003:l036","ordinal":148340,"en":"Like a black young ram,"},{"id":"semetey-1-2013:p0946:b003:l037","ordinal":148341,"en":"He was a slave who balked,"},{"id":"semetey-1-2013:p0946:b003:l038","ordinal":148342,"en":"Like a male black crow,"},{"id":"semetey-1-2013:p0946:b003:l039","ordinal":148343,"en":"He was a fellow who hopped about."},{"id":"semetey-1-2013:p0946:b004:l001","ordinal":148344,"en":"'Calling this one a hero,"},{"id":"semetey-1-2013:p0946:b004:l002","ordinal":148345,"en":"Would a woman who married him prosper?"},{"id":"semetey-1-2013:p0946:b004:l003","ordinal":148346,"en":"May his wish never be granted!"},{"id":"semetey-1-2013:p0946:b004:l004","ordinal":148347,"en":"If the hero Toltoi faced him,"},{"id":"semetey-1-2013:p0946:b004:l005","ordinal":148348,"en":"Would he leave such a Sart alive"},{"id":"semetey-1-2013:p0946:b004:l006","ordinal":148349,"en":"Even long enough to boil tea?"},{"id":"semetey-1-2013:p0946:b004:l007","ordinal":148350,"en":"The Sarts' mottled robes,"},{"id":"semetey-1-2013:p0946:b004:l008","ordinal":148351,"en":"With what face could I wear them?"},{"id":"semetey-1-2013:p0946:b004:l009","ordinal":148352,"en":"How could I marry this one?"},{"id":"semetey-1-2013:p0946:b004:l010","ordinal":148353,"en":"As though I were snub-nosed,"},{"id":"semetey-1-2013:p0946:b004:l011","ordinal":148354,"en":"How could I go about veiled?'"},{"id":"semetey-1-2013:p0946:b004:l012","ordinal":148355,"en":"Passing on from there,"},{"id":"semetey-1-2013:p0946:b004:l013","ordinal":148356,"en":"Aichurok went again,"},{"id":"semetey-1-2013:p0946:b004:l014","ordinal":148357,"en":"Wandering among other peoples."},{"id":"semetey-1-2013:p0946:b004:l015","ordinal":148358,"en":"Malabek in Margalan—"},{"id":"semetey-1-2013:p0946:b004:l016","ordinal":148359,"en":"She examined Malabek."},{"id":"semetey-1-2013:p0946:b004:l017","ordinal":148360,"en":"There were the lands of Kokand and Tashkent,"},{"id":"semetey-1-2013:p0946:b004:l018","ordinal":148361,"en":"Their people alike as hares."},{"id":"semetey-1-2013:p0946:b004:l019","ordinal":148362,"en":"'If I repeat it, it is the same tale;"},{"id":"semetey-1-2013:p0946:b004:l020","ordinal":148363,"en":"Must I go on repeating it?"},{"id":"semetey-1-2013:p0946:b004:l023","ordinal":148364,"en":"Noble Churok grieved,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0946:b004:l024","ordinal":148365,"en":"Despairing of packsaddle riders,"},{"id":"semetey-1-2013:p0946:b004:l025","ordinal":148366,"en":"Drew away in alarm toward this side."},{"id":"semetey-1-2013:p0946:b004:l026","ordinal":148367,"en":"Traversing the earth,"},{"id":"semetey-1-2013:p0946:b004:l027","ordinal":148368,"en":"Of the giants she had heard of,"},{"id":"semetey-1-2013:p0946:b004:l028","ordinal":148369,"en":"She visited every one."},{"id":"semetey-1-2013:p0946:b004:l029","ordinal":148370,"en":"'Let me search over the earth,"},{"id":"semetey-1-2013:p0946:b004:l030","ordinal":148371,"en":"Let me find the one I need."},{"id":"semetey-1-2013:p0946:b004:l031","ordinal":148372,"en":"Why should I go on grieving?"},{"id":"semetey-1-2013:p0946:b004:l032","ordinal":148373,"en":"If I lose hope in the Muslims,"},{"id":"semetey-1-2013:p0946:b004:l033","ordinal":148374,"en":"Let me go among the infidels."},{"id":"semetey-1-2013:p0946:b004:l035","ordinal":148375,"en":"The giants of the Muslims,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0946:b004:l036","ordinal":148376,"en":"Let me visit every one."},{"id":"semetey-1-2013:p0946:b004:l037","ordinal":148377,"en":"Dwelling in Ketmen-Tobo,"},{"id":"semetey-1-2013:p0946:b004:l038","ordinal":148378,"en":"Said to be a stately hero,"},{"id":"semetey-1-2013:p0946:b004:l039","ordinal":148379,"en":"Whose fame has reached Alai,"},{"id":"semetey-1-2013:p0947:b003:l001","ordinal":148380,"en":"Whose ancestral power has spread far,"},{"id":"semetey-1-2013:p0947:b003:l002","ordinal":148381,"en":"Bilerik of Aikojo—"},{"id":"semetey-1-2013:p0947:b003:l003","ordinal":148382,"en":"Let me turn and see him once.'"},{"id":"semetey-1-2013:p0947:b003:l004","ordinal":148383,"en":"Bilerik of Aikojo—"},{"id":"semetey-1-2013:p0947:b003:l005","ordinal":148384,"en":"She came to Bilerik,"},{"id":"semetey-1-2013:p0947:b003:l006","ordinal":148385,"en":"And put him to the test."},{"id":"semetey-1-2013:p0947:b003:l008","ordinal":148386,"en":"He was a man like an ambling horse.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0947:b003:l009","ordinal":148387,"en":"Washing whether he sat or stood,"},{"id":"semetey-1-2013:p0947:b003:l010","ordinal":148388,"en":"He was a mullah-like man."},{"id":"semetey-1-2013:p0947:b003:l011","ordinal":148389,"en":"Never rising from one place,"},{"id":"semetey-1-2013:p0947:b003:l013","ordinal":148390,"en":"His turban never leaving his head,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0947:b003:l014","ordinal":148391,"en":"He was a woman-like man."},{"id":"semetey-1-2013:p0947:b003:l016","ordinal":148392,"en":"'Would wretched Toltoi spare","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0947:b003:l017","ordinal":148393,"en":"This woman-like man of mine?"},{"id":"semetey-1-2013:p0947:b003:l018","ordinal":148394,"en":"A mottled silk dress,"},{"id":"semetey-1-2013:p0947:b003:l019","ordinal":148395,"en":"With what face could I wear it?"},{"id":"semetey-1-2013:p0947:b003:l020","ordinal":148396,"en":"He himself is a flawed man;"},{"id":"semetey-1-2013:p0947:b003:l021","ordinal":148397,"en":"With what face could I marry him?'"},{"id":"semetey-1-2013:p0947:b003:l022","ordinal":148398,"en":"She passed on from there,"},{"id":"semetey-1-2013:p0947:b003:l023","ordinal":148399,"en":"Wandered onward,"},{"id":"semetey-1-2013:p0947:b003:l024","ordinal":148400,"en":"Passed through Maseyil,"},{"id":"semetey-1-2013:p0947:b003:l025","ordinal":148401,"en":"Crossed broad Kakshaal."},{"id":"semetey-1-2013:p0947:b003:l026","ordinal":148402,"en":"In the hollow of that Kakshaal,"},{"id":"semetey-1-2013:p0947:b003:l027","ordinal":148403,"en":"On the banks of Jaman-Suu,"},{"id":"semetey-1-2013:p0947:b003:l028","ordinal":148404,"en":"Dwelling in Saparbai,"},{"id":"semetey-1-2013:p0947:b003:l029","ordinal":148405,"en":"Wintering in Kulansaryk,"},{"id":"semetey-1-2013:p0947:b003:l030","ordinal":148406,"en":"The youngest of nine sons,"},{"id":"semetey-1-2013:p0947:b003:l031","ordinal":148407,"en":"A servant of the one God,"},{"id":"semetey-1-2013:p0947:b003:l032","ordinal":148408,"en":"Eleman's darling."},{"id":"semetey-1-2013:p0947:b003:l033","ordinal":148409,"en":"Dwelling in Kulansaryk,"},{"id":"semetey-1-2013:p0947:b003:l034","ordinal":148410,"en":"That wretched dauntless hero,"},{"id":"semetey-1-2013:p0947:b003:l035","ordinal":148411,"en":"Said to be unlike other mortals,"},{"id":"semetey-1-2013:p0947:b003:l036","ordinal":148412,"en":"Who wore a bulletproof coat,"},{"id":"semetey-1-2013:p0947:b003:l037","ordinal":148413,"en":"Seven giants beneath the earth—"},{"id":"semetey-1-2013:p0947:b003:l038","ordinal":148414,"en":"He went in alone and attacked them,"},{"id":"semetey-1-2013:p0947:b005:l001","ordinal":148415,"en":"When seven tumens of enemies came,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0947:b005:l002","ordinal":148416,"en":"He attacked alone through their midst."},{"id":"semetey-1-2013:p0947:b005:l004","ordinal":148417,"en":"The champion of many giants,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0947:b005:l005","ordinal":148418,"en":"To put the hero Toshtuk to the test,"},{"id":"semetey-1-2013:p0947:b005:l006","ordinal":148419,"en":"To go and see him,"},{"id":"semetey-1-2013:p0947:b005:l007","ordinal":148420,"en":"To marry him if he pleased her,"},{"id":"semetey-1-2013:p0947:b005:l008","ordinal":148421,"en":"Without taking shame or offense,"},{"id":"semetey-1-2013:p0947:b005:l009","ordinal":148422,"en":"To live as his junior wife:"},{"id":"semetey-1-2013:p0947:b005:l010","ordinal":148423,"en":"'If Toshtuk pleases me,"},{"id":"semetey-1-2013:p0947:b005:l011","ordinal":148424,"en":"Let me take him along as my husband,"},{"id":"semetey-1-2013:p0947:b005:l012","ordinal":148425,"en":"Toltoi of the Jediger—"},{"id":"semetey-1-2013:p0947:b005:l013","ordinal":148426,"en":"Let him level him with the black earth,"},{"id":"semetey-1-2013:p0947:b005:l015","ordinal":148427,"en":"If Toshtuk pleases my heart,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0947:b005:l016","ordinal":148428,"en":"If I do not take him as my bridegroom!'"},{"id":"semetey-1-2013:p0947:b005:l017","ordinal":148429,"en":"Speeding through the clouds,"},{"id":"semetey-1-2013:p0947:b005:l018","ordinal":148430,"en":"Toward Eleman's Toshtuk,"},{"id":"semetey-1-2013:p0947:b005:l019","ordinal":148431,"en":"She drew near and entered."},{"id":"semetey-1-2013:p0947:b005:l020","ordinal":148432,"en":"'He is a thick-armed lion,"},{"id":"semetey-1-2013:p0947:b005:l021","ordinal":148433,"en":"Hero Toshtuk is a warrior."},{"id":"semetey-1-2013:p0947:b005:l022","ordinal":148434,"en":"Had I met him in his youth,"},{"id":"semetey-1-2013:p0947:b005:l023","ordinal":148435,"en":"This Sultan Toshtuk"},{"id":"semetey-1-2013:p0947:b005:l024","ordinal":148436,"en":"Would have been a man to marry."},{"id":"semetey-1-2013:p0947:b005:l025","ordinal":148437,"en":"Tall and broad-shouldered,"},{"id":"semetey-1-2013:p0947:b005:l026","ordinal":148438,"en":"Both a champion and a lion,"},{"id":"semetey-1-2013:p0947:b005:l027","ordinal":148439,"en":"He has passed sixty."},{"id":"semetey-1-2013:p0947:b005:l028","ordinal":148440,"en":"The present age of the champion"},{"id":"semetey-1-2013:p0947:b005:l029","ordinal":148441,"en":"Has reached seventy."},{"id":"semetey-1-2013:p0947:b005:l030","ordinal":148442,"en":"He has left his youth behind,"},{"id":"semetey-1-2013:p0947:b005:l031","ordinal":148443,"en":"Has reached old age."},{"id":"semetey-1-2013:p0947:b005:l032","ordinal":148444,"en":"The warmth has left his embrace,"},{"id":"semetey-1-2013:p0947:b005:l033","ordinal":148445,"en":"The vigor has left his play."},{"id":"semetey-1-2013:p0947:b005:l034","ordinal":148446,"en":"To this man in his old age,"},{"id":"semetey-1-2013:p0947:b005:l035","ordinal":148447,"en":"With what face could I marry?"},{"id":"semetey-1-2013:p0947:b005:l036","ordinal":148448,"en":"He is a man grown old."},{"id":"semetey-1-2013:p0947:b005:l037","ordinal":148449,"en":"Looking at his household,"},{"id":"semetey-1-2013:p0947:b005:l038","ordinal":148450,"en":"He has four wives."},{"id":"semetey-1-2013:p0947:b005:l039","ordinal":148451,"en":"Otherwise, Toshtuk is a seer,"},{"id":"semetey-1-2013:p0948:b003:l001","ordinal":148452,"en":"A man of holy lineage."},{"id":"semetey-1-2013:p0948:b003:l002","ordinal":148453,"en":"That hero has grown stooped."},{"id":"semetey-1-2013:p0948:b003:l003","ordinal":148454,"en":"In his youth, giant Toshtuk"},{"id":"semetey-1-2013:p0948:b003:l004","ordinal":148455,"en":"Was champion among many giants."},{"id":"semetey-1-2013:p0948:b003:l005","ordinal":148456,"en":"His golden head has turned white,"},{"id":"semetey-1-2013:p0948:b003:l006","ordinal":148457,"en":"His season of youth has passed,"},{"id":"semetey-1-2013:p0948:b003:l007","ordinal":148458,"en":"He has reached the season of an old man."},{"id":"semetey-1-2013:p0948:b003:l008","ordinal":148459,"en":"Were it not for that fault,"},{"id":"semetey-1-2013:p0948:b003:l009","ordinal":148460,"en":"What could dear Toshtuk not do?"},{"id":"semetey-1-2013:p0948:b003:l010","ordinal":148461,"en":"Wearing such a battle coat as Chaiyingi,"},{"id":"semetey-1-2013:p0948:b003:l011","ordinal":148462,"en":"Riding such a horse as Chalkuiruk,"},{"id":"semetey-1-2013:p0948:b003:l012","ordinal":148463,"en":"Hero Toshtuk would hold himself proudly.'"},{"id":"semetey-1-2013:p0948:b003:l013","ordinal":148464,"en":"Finding him wanting because of old age,"},{"id":"semetey-1-2013:p0948:b003:l014","ordinal":148465,"en":"Aichurok turned back."},{"id":"semetey-1-2013:p0948:b003:l015","ordinal":148466,"en":"Following her course, she flew;"},{"id":"semetey-1-2013:p0948:b003:l016","ordinal":148467,"en":"Then Aichurok"},{"id":"semetey-1-2013:p0948:b003:l017","ordinal":148468,"en":"Descended upon Chech-Tobo."},{"id":"semetey-1-2013:p0948:b003:l018","ordinal":148469,"en":"Dwelling in Chech-Tobo,"},{"id":"semetey-1-2013:p0948:b003:l019","ordinal":148470,"en":"Said to be an immeasurable hero,"},{"id":"semetey-1-2013:p0948:b003:l020","ordinal":148471,"en":"For the warrior held bound,"},{"id":"semetey-1-2013:p0948:b003:l021","ordinal":148472,"en":"Hero Koshoi opened the way to fortune."},{"id":"semetey-1-2013:p0948:b003:l022","ordinal":148473,"en":"For the market that stood closed,"},{"id":"semetey-1-2013:p0948:b003:l023","ordinal":148474,"en":"Hero Koshoi opened its city."},{"id":"semetey-1-2013:p0948:b003:l024","ordinal":148475,"en":"A truly saintly elder,"},{"id":"semetey-1-2013:p0948:b003:l025","ordinal":148476,"en":"A truly knowledgeable seer,"},{"id":"semetey-1-2013:p0948:b003:l026","ordinal":148477,"en":"Whose blessing enriched the people,"},{"id":"semetey-1-2013:p0948:b003:l027","ordinal":148478,"en":"Who brought prosperity to those he watched over,"},{"id":"semetey-1-2013:p0948:b003:l028","ordinal":148479,"en":"A prophet-like saint."},{"id":"semetey-1-2013:p0948:b003:l029","ordinal":148480,"en":"Receiving a letter from the caliph,"}]
