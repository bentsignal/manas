[{"id":"semetey-1-2013:p0717:b004:l016","ordinal":131841,"en":"She felled with her sword."},{"id":"semetey-1-2013:p0717:b004:l017","ordinal":131842,"en":"Shedding the infidels' blood,"},{"id":"semetey-1-2013:p0717:b004:l018","ordinal":131843,"en":"The unfortunate one endured four days."},{"id":"semetey-1-2013:p0717:b004:l019","ordinal":131844,"en":"Furious and grieving,"},{"id":"semetey-1-2013:p0717:b004:l020","ordinal":131845,"en":"The steed she rode on campaign,"},{"id":"semetey-1-2013:p0717:b004:l021","ordinal":131846,"en":"Telkyzyl, she had lost."},{"id":"semetey-1-2013:p0717:b004:l022","ordinal":131847,"en":"Then dust covered her breast;"},{"id":"semetey-1-2013:p0717:b004:l023","ordinal":131848,"en":"Dark blood covered her eyes."},{"id":"semetey-1-2013:p0717:b004:l024","ordinal":131849,"en":"Her wits grew weak, her heart burned;"},{"id":"semetey-1-2013:p0717:b004:l025","ordinal":131850,"en":"Her strength failed, she sagged."},{"id":"semetey-1-2013:p0717:b004:l026","ordinal":131851,"en":"Both her arms hung loose;"},{"id":"semetey-1-2013:p0717:b004:l027","ordinal":131852,"en":"Both her eyes darted wildly."},{"id":"semetey-1-2013:p0717:b004:l028","ordinal":131853,"en":"She had no support to lean upon,"},{"id":"semetey-1-2013:p0717:b004:l029","ordinal":131854,"en":"No renowned lion Manas."},{"id":"semetey-1-2013:p0717:b004:l030","ordinal":131855,"en":"Seven wolves and a single sheep—"},{"id":"semetey-1-2013:p0717:b004:l031","ordinal":131856,"en":"My dear orphan, hear this—"},{"id":"semetey-1-2013:p0717:b004:l032","ordinal":131857,"en":"If they tear at it, will they leave its carcass?"},{"id":"semetey-1-2013:p0717:b004:l033","ordinal":131858,"en":"Seventy Kalmyks and a single girl—"},{"id":"semetey-1-2013:p0717:b004:l034","ordinal":131859,"en":"If they beat her, will they leave her carcass?"},{"id":"semetey-1-2013:p0717:b004:l035","ordinal":131860,"en":"Surrounding her, Ylama"},{"id":"semetey-1-2013:p0717:b004:l036","ordinal":131861,"en":"At last seized her."},{"id":"semetey-1-2013:p0717:b004:l037","ordinal":131862,"en":"Your ocean-like elder sister Kardygach"},{"id":"semetey-1-2013:p0717:b004:l038","ordinal":131863,"en":"Had been taken captive."},{"id":"semetey-1-2013:p0717:b004:l039","ordinal":131864,"en":"When Kardygach was captured,"},{"id":"semetey-1-2013:p0718:b003:l001","ordinal":131865,"en":"With beaded cap ornaments and coral stones,"},{"id":"semetey-1-2013:p0718:b003:l002","ordinal":131866,"en":"They summoned the zungtung khan."},{"id":"semetey-1-2013:p0718:b003:l003","ordinal":131867,"en":"Babbling to Ylama,"},{"id":"semetey-1-2013:p0718:b003:l004","ordinal":131868,"en":"That day they performed the marriage rite."},{"id":"semetey-1-2013:p0718:b003:l005","ordinal":131869,"en":"The pig Ylama took Kardygach."},{"id":"semetey-1-2013:p0718:b003:l006","ordinal":131870,"en":"They mounted her on a mule,"},{"id":"semetey-1-2013:p0718:b003:l007","ordinal":131871,"en":"Taking her as spoil toward Beijing."},{"id":"semetey-1-2013:p0718:b003:l008","ordinal":131872,"en":"Five hundred escorted her away,"},{"id":"semetey-1-2013:p0718:b003:l009","ordinal":131873,"en":"Returning with their captive."},{"id":"semetey-1-2013:p0718:b003:l010","ordinal":131874,"en":"Leopard Manas and warrior Bakai,"},{"id":"semetey-1-2013:p0718:b003:l011","ordinal":131875,"en":"Akbaltai's Chubak,"},{"id":"semetey-1-2013:p0718:b003:l012","ordinal":131876,"en":"The seething infidels"},{"id":"semetey-1-2013:p0718:b003:l013","ordinal":131877,"en":"They speared toward the khakan."},{"id":"semetey-1-2013:p0718:b003:l014","ordinal":131878,"en":"In those days, when the Kyrgyz sun rose,"},{"id":"semetey-1-2013:p0718:b003:l015","ordinal":131879,"en":"They brought torment upon the infidels"},{"id":"semetey-1-2013:p0718:b003:l016","ordinal":131880,"en":"And pursued them toward Beijing."},{"id":"semetey-1-2013:p0718:b003:l017","ordinal":131881,"en":"The people of Beijing fled in panic,"},{"id":"semetey-1-2013:p0718:b003:l018","ordinal":131882,"en":"Surging toward Beijing."},{"id":"semetey-1-2013:p0718:b003:l019","ordinal":131883,"en":"They passed Issyk-Kul,"},{"id":"semetey-1-2013:p0718:b003:l020","ordinal":131884,"en":"Crossed Kyzyl-Kyia,"},{"id":"semetey-1-2013:p0718:b003:l021","ordinal":131885,"en":"Surged along Karkyra."},{"id":"semetey-1-2013:p0718:b003:l022","ordinal":131886,"en":"The multitude of infidels fled."},{"id":"semetey-1-2013:p0718:b003:l023","ordinal":131887,"en":"Those damned Chinese,"},{"id":"semetey-1-2013:p0718:b003:l024","ordinal":131888,"en":"Down through Echki-Ölös,"},{"id":"semetey-1-2013:p0718:b003:l025","ordinal":131889,"en":"They speared without measure."},{"id":"semetey-1-2013:p0718:b003:l026","ordinal":131890,"en":"They went down Mangkan,"},{"id":"semetey-1-2013:p0718:b003:l027","ordinal":131891,"en":"Galloped down Kordoi,"},{"id":"semetey-1-2013:p0718:b003:l028","ordinal":131892,"en":"Fighting like dogs,"},{"id":"semetey-1-2013:p0718:b003:l029","ordinal":131893,"en":"Pursuing them like dogs."},{"id":"semetey-1-2013:p0718:b003:l030","ordinal":131894,"en":"Köngüz and Tekes"},{"id":"semetey-1-2013:p0718:b003:l031","ordinal":131895,"en":"They turned upside down."},{"id":"semetey-1-2013:p0718:b003:l032","ordinal":131896,"en":"Üch-Aral at the head of the Ile,"},{"id":"semetey-1-2013:p0718:b003:l033","ordinal":131897,"en":"They wheeled round in pursuit."},{"id":"semetey-1-2013:p0718:b003:l034","ordinal":131898,"en":"To Ögüz-Ashuu and Tai-Ashuu,"},{"id":"semetey-1-2013:p0718:b003:l035","ordinal":131899,"en":"They drove them onward."},{"id":"semetey-1-2013:p0718:b003:l036","ordinal":131900,"en":"At Chara-Tash of Tai-Ashuu,"},{"id":"semetey-1-2013:p0718:b003:l037","ordinal":131901,"en":"With narrow ground on either side,"},{"id":"semetey-1-2013:p0718:b003:l038","ordinal":131902,"en":"We were hemmed in together;"},{"id":"semetey-1-2013:p0718:b003:l039","ordinal":131903,"en":"We fought a great mêlée."},{"id":"semetey-1-2013:p0718:b004:l001","ordinal":131904,"en":"Leopard Manas, the generous lion,"},{"id":"semetey-1-2013:p0718:b004:l002","ordinal":131905,"en":"The precious warrior gone to the next world,"},{"id":"semetey-1-2013:p0718:b004:l003","ordinal":131906,"en":"The young mare's foal,"},{"id":"semetey-1-2013:p0718:b004:l004","ordinal":131907,"en":"Against the multitude of Chinese infidels,"},{"id":"semetey-1-2013:p0718:b004:l005","ordinal":131908,"en":"That lion had shown his valor."},{"id":"semetey-1-2013:p0718:b004:l006","ordinal":131909,"en":"Among those Chinese,"},{"id":"semetey-1-2013:p0718:b004:l007","ordinal":131910,"en":"The mighty Kongurbai,"},{"id":"semetey-1-2013:p0718:b004:l008","ordinal":131911,"en":"Tikenalp and Shypshaidar,"},{"id":"semetey-1-2013:p0718:b004:l009","ordinal":131912,"en":"Boronchu and warrior Joloi,"},{"id":"semetey-1-2013:p0718:b004:l010","ordinal":131913,"en":"Warrior Börüköz and Ezkara—"},{"id":"semetey-1-2013:p0718:b004:l011","ordinal":131914,"en":"All their giants were there."},{"id":"semetey-1-2013:p0718:b004:l012","ordinal":131915,"en":"They faced us, fighting without cease,"},{"id":"semetey-1-2013:p0718:b004:l013","ordinal":131916,"en":"Bringing torment upon one another,"},{"id":"semetey-1-2013:p0718:b004:l014","ordinal":131917,"en":"Drenched in bloody blood,"},{"id":"semetey-1-2013:p0718:b004:l015","ordinal":131918,"en":"Fighting without fleeing,"},{"id":"semetey-1-2013:p0718:b004:l016","ordinal":131919,"en":"Holding their spears straight to thrust,"},{"id":"semetey-1-2013:p0718:b004:l017","ordinal":131920,"en":"Firing guns and drawing bows,"},{"id":"semetey-1-2013:p0718:b004:l018","ordinal":131921,"en":"Fighting to exhaustion,"},{"id":"semetey-1-2013:p0718:b004:l019","ordinal":131922,"en":"The giants sparing not their lives,"},{"id":"semetey-1-2013:p0718:b004:l020","ordinal":131923,"en":"Afflicting one another."},{"id":"semetey-1-2013:p0718:b004:l021","ordinal":131924,"en":"Infidel and Muslim"},{"id":"semetey-1-2013:p0718:b004:l022","ordinal":131925,"en":"Matched their valor against each other."},{"id":"semetey-1-2013:p0718:b004:l023","ordinal":131926,"en":"They faced each other without retreat,"},{"id":"semetey-1-2013:p0718:b004:l024","ordinal":131927,"en":"Fought without fleeing."},{"id":"semetey-1-2013:p0718:b004:l025","ordinal":131928,"en":"Warrior Manas, gone to the next world,"},{"id":"semetey-1-2013:p0718:b004:l026","ordinal":131929,"en":"Was a lion of surpassing fortune."},{"id":"semetey-1-2013:p0718:b004:l027","ordinal":131930,"en":"Into this world, the Almighty"},{"id":"semetey-1-2013:p0718:b004:l028","ordinal":131931,"en":"Had created such a warrior only once."},{"id":"semetey-1-2013:p0718:b004:l029","ordinal":131932,"en":"His fortune was complete."},{"id":"semetey-1-2013:p0718:b004:l030","ordinal":131933,"en":"If you looked within him,"},{"id":"semetey-1-2013:p0718:b004:l031","ordinal":131934,"en":"He was broader than the face of the earth."},{"id":"semetey-1-2013:p0718:b004:l032","ordinal":131935,"en":"When they came to face him,"},{"id":"semetey-1-2013:p0718:b004:l033","ordinal":131936,"en":"Valiant Lord Manas—"},{"id":"semetey-1-2013:p0718:b004:l034","ordinal":131937,"en":"No mortal could trouble him."},{"id":"semetey-1-2013:p0718:b004:l035","ordinal":131938,"en":"Of the mortals dwelling on earth,"},{"id":"semetey-1-2013:p0718:b004:l036","ordinal":131939,"en":"None remained to turn a lasso pole against him."},{"id":"semetey-1-2013:p0718:b004:l037","ordinal":131940,"en":"The Chinese swarmed and crowded in;"},{"id":"semetey-1-2013:p0718:b004:l038","ordinal":131941,"en":"A great slaughter ensued."},{"id":"semetey-1-2013:p0718:b004:l039","ordinal":131942,"en":"They drew bows, making a rain of arrows,"},{"id":"semetey-1-2013:p0719:b003:l001","ordinal":131943,"en":"Firing shot like hail,"},{"id":"semetey-1-2013:p0719:b003:l002","ordinal":131944,"en":"Spearheads clashing,"},{"id":"semetey-1-2013:p0719:b003:l003","ordinal":131945,"en":"Human heads colliding."},{"id":"semetey-1-2013:p0719:b003:l004","ordinal":131946,"en":"They surged like ants,"},{"id":"semetey-1-2013:p0719:b003:l005","ordinal":131947,"en":"Swarmed and teemed like worms."},{"id":"semetey-1-2013:p0719:b003:l006","ordinal":131948,"en":"The sky was clear, the earth obscured;"},{"id":"semetey-1-2013:p0719:b003:l007","ordinal":131949,"en":"Soil engulfed us, dust flew."},{"id":"semetey-1-2013:p0719:b003:l008","ordinal":131950,"en":"For nine days we fought together."},{"id":"semetey-1-2013:p0719:b003:l009","ordinal":131951,"en":"Our elder Bakai held the banner;"},{"id":"semetey-1-2013:p0719:b003:l010","ordinal":131952,"en":"All of us were scattered and torn."},{"id":"semetey-1-2013:p0719:b003:l011","ordinal":131953,"en":"In dust that hid the ground,"},{"id":"semetey-1-2013:p0719:b003:l012","ordinal":131954,"en":"When full battle raged,"},{"id":"semetey-1-2013:p0719:b003:l013","ordinal":131955,"en":"We struggled for our lives."},{"id":"semetey-1-2013:p0719:b003:l014","ordinal":131956,"en":"When all the Chinese drew their bows,"},{"id":"semetey-1-2013:p0719:b003:l015","ordinal":131957,"en":"The arrows shrieked;"},{"id":"semetey-1-2013:p0719:b003:l016","ordinal":131958,"en":"Whatever they struck burst apart."},{"id":"semetey-1-2013:p0719:b003:l017","ordinal":131959,"en":"Then those whose hour had come died."},{"id":"semetey-1-2013:p0719:b003:l018","ordinal":131960,"en":"Where the arrows struck, flesh burst apart;"},{"id":"semetey-1-2013:p0719:b003:l019","ordinal":131961,"en":"Blood poured out in streams."},{"id":"semetey-1-2013:p0719:b003:l020","ordinal":131962,"en":"Those whose hour had come died,"},{"id":"semetey-1-2013:p0719:b003:l021","ordinal":131963,"en":"And saw the face of the next world."},{"id":"semetey-1-2013:p0719:b003:l022","ordinal":131964,"en":"When that battle took place,"},{"id":"semetey-1-2013:p0719:b003:l023","ordinal":131965,"en":"White-bearded elders died."},{"id":"semetey-1-2013:p0719:b003:l024","ordinal":131966,"en":"Among Chinese and Burut,"},{"id":"semetey-1-2013:p0719:b003:l025","ordinal":131967,"en":"Many more people died."},{"id":"semetey-1-2013:p0719:b003:l026","ordinal":131968,"en":"They fought in bitter anguish,"},{"id":"semetey-1-2013:p0719:b003:l027","ordinal":131969,"en":"Struggled to save their lives,"},{"id":"semetey-1-2013:p0719:b003:l028","ordinal":131970,"en":"Faced each other, staring hard,"},{"id":"semetey-1-2013:p0719:b003:l029","ordinal":131971,"en":"Thrust their spears and shouted,"},{"id":"semetey-1-2013:p0719:b003:l030","ordinal":131972,"en":"Felled those who faced them."},{"id":"semetey-1-2013:p0719:b003:l031","ordinal":131973,"en":"Without rest by day,"},{"id":"semetey-1-2013:p0719:b003:l032","ordinal":131974,"en":"Without sleep by night,"},{"id":"semetey-1-2013:p0719:b003:l033","ordinal":131975,"en":"They fought with all their strength."},{"id":"semetey-1-2013:p0719:b003:l034","ordinal":131976,"en":"Your elder Khan Bakai among them,"},{"id":"semetey-1-2013:p0719:b003:l035","ordinal":131977,"en":"They wrought havoc."},{"id":"semetey-1-2013:p0719:b003:l036","ordinal":131978,"en":"There was Khan Manas, blessed by Khizir;"},{"id":"semetey-1-2013:p0719:b003:l037","ordinal":131979,"en":"All forty companions were there."},{"id":"semetey-1-2013:p0719:b003:l038","ordinal":131980,"en":"Shrill battle cries, fierce rallying shouts—"},{"id":"semetey-1-2013:p0719:b003:l039","ordinal":131981,"en":"Whom a lion's teeth could not pierce,"},{"id":"semetey-1-2013:p0719:b004:l001","ordinal":131982,"en":"Whom the world could not overpower,"},{"id":"semetey-1-2013:p0719:b004:l002","ordinal":131983,"en":"Akbalta's Chubak was there."},{"id":"semetey-1-2013:p0719:b004:l003","ordinal":131984,"en":"Light on a horse, suited to a yearling,"},{"id":"semetey-1-2013:p0719:b004:l004","ordinal":131985,"en":"Sleepless, watchful on the road,"},{"id":"semetey-1-2013:p0719:b004:l005","ordinal":131986,"en":"Ulakkan's son Syrgak was there."},{"id":"semetey-1-2013:p0719:b004:l006","ordinal":131987,"en":"Greater than them all,"},{"id":"semetey-1-2013:p0719:b004:l007","ordinal":131988,"en":"Fortunate Manas, the bloodthirsty lion,"},{"id":"semetey-1-2013:p0719:b004:l008","ordinal":131989,"en":"Untiringly upon the black Chinese"},{"id":"semetey-1-2013:p0719:b004:l009","ordinal":131990,"en":"Wrought destruction there."},{"id":"semetey-1-2013:p0719:b004:l010","ordinal":131991,"en":"They stood without tiring,"},{"id":"semetey-1-2013:p0719:b004:l011","ordinal":131992,"en":"Fought, shattering one another."},{"id":"semetey-1-2013:p0719:b004:l012","ordinal":131993,"en":"They stood facing each other,"},{"id":"semetey-1-2013:p0719:b004:l013","ordinal":131994,"en":"Girded themselves and fought,"},{"id":"semetey-1-2013:p0719:b004:l014","ordinal":131995,"en":"Came out to single combat."},{"id":"semetey-1-2013:p0719:b004:l015","ordinal":131996,"en":"If they had the strength, each other"},{"id":"semetey-1-2013:p0719:b004:l016","ordinal":131997,"en":"They thrust beneath the earth."},{"id":"semetey-1-2013:p0719:b004:l017","ordinal":131998,"en":"As they faced each other in battle,"},{"id":"semetey-1-2013:p0719:b004:l018","ordinal":131999,"en":"Bringing torment upon one another,"},{"id":"semetey-1-2013:p0719:b004:l019","ordinal":132000,"en":"There was the multitude of Chinese."},{"id":"semetey-1-2013:p0719:b004:l020","ordinal":132001,"en":"Of the Manchu Chinese lineage,"},{"id":"semetey-1-2013:p0719:b004:l021","ordinal":132002,"en":"There was the giant Great Döngö."},{"id":"semetey-1-2013:p0719:b004:l022","ordinal":132003,"en":"That Döngö himself"},{"id":"semetey-1-2013:p0719:b004:l023","ordinal":132004,"en":"They mounted on a noble mule."},{"id":"semetey-1-2013:p0719:b004:l024","ordinal":132005,"en":"All iron, with lark-eye mesh,"},{"id":"semetey-1-2013:p0719:b004:l025","ordinal":132006,"en":"They clad him in blue-steel armor."},{"id":"semetey-1-2013:p0719:b004:l026","ordinal":132007,"en":"In that infidel's hand"},{"id":"semetey-1-2013:p0719:b004:l027","ordinal":132008,"en":"Was a painted spear twelve fathoms long."},{"id":"semetey-1-2013:p0719:b004:l028","ordinal":132009,"en":"No mortal could endure his wrath."},{"id":"semetey-1-2013:p0719:b004:l029","ordinal":132010,"en":"He emerged from a ravine."},{"id":"semetey-1-2013:p0719:b004:l030","ordinal":132011,"en":"The bloodthirsty one rode to war."},{"id":"semetey-1-2013:p0719:b004:l031","ordinal":132012,"en":"If you ask about Döngö,"},{"id":"semetey-1-2013:p0719:b004:l032","ordinal":132013,"en":"Of Beijing's khakan khan"},{"id":"semetey-1-2013:p0719:b004:l033","ordinal":132014,"en":"He was entered in the register."},{"id":"semetey-1-2013:p0719:b004:l034","ordinal":132015,"en":"To the forty Chinese tribes, the many people,"},{"id":"semetey-1-2013:p0719:b004:l035","ordinal":132016,"en":"That Döngö who had come—"},{"id":"semetey-1-2013:p0719:b004:l036","ordinal":132017,"en":"His worth was known."},{"id":"semetey-1-2013:p0719:b004:l037","ordinal":132018,"en":"His wrath made blood flow;"},{"id":"semetey-1-2013:p0719:b004:l038","ordinal":132019,"en":"His might made souls depart."},{"id":"semetey-1-2013:p0719:b004:l039","ordinal":132020,"en":"For seven years he walked without rest,"},{"id":"semetey-1-2013:p0720:b003:l001","ordinal":132021,"en":"On this side of Kap-Too,"},{"id":"semetey-1-2013:p0720:b003:l002","ordinal":132022,"en":"He had killed seventy giants."},{"id":"semetey-1-2013:p0720:b003:l003","ordinal":132023,"en":"For six years he walked on foot,"},{"id":"semetey-1-2013:p0720:b003:l004","ordinal":132024,"en":"He wetted and greased his spear,"},{"id":"semetey-1-2013:p0720:b003:l005","ordinal":132025,"en":"Have you heard of them:"},{"id":"semetey-1-2013:p0720:b003:l006","ordinal":132026,"en":"Iron-eared giant Kutan,"},{"id":"semetey-1-2013:p0720:b003:l007","ordinal":132027,"en":"Iron-naveled giant Kiten,"},{"id":"semetey-1-2013:p0720:b003:l008","ordinal":132028,"en":"Iron-browed giant Mangush,"},{"id":"semetey-1-2013:p0720:b003:l009","ordinal":132029,"en":"Giant Kaman riding Karager,"},{"id":"semetey-1-2013:p0720:b003:l010","ordinal":132030,"en":"Giant Sazan riding Saryker?"},{"id":"semetey-1-2013:p0720:b003:l011","ordinal":132031,"en":"Against these five, Great Döngö"},{"id":"semetey-1-2013:p0720:b003:l012","ordinal":132032,"en":"Faced them and thrust his spear,"},{"id":"semetey-1-2013:p0720:b003:l013","ordinal":132033,"en":"Fighting without rest for seven days."},{"id":"semetey-1-2013:p0720:b003:l014","ordinal":132034,"en":"Such was the valor he displayed."},{"id":"semetey-1-2013:p0720:b003:l015","ordinal":132035,"en":"On this side of Kap-Too,"},{"id":"semetey-1-2013:p0720:b003:l016","ordinal":132036,"en":"Of a mountain called Suuk-Tör,"},{"id":"semetey-1-2013:p0720:b003:l017","ordinal":132037,"en":"At its farthest end,"},{"id":"semetey-1-2013:p0720:b003:l018","ordinal":132038,"en":"Eighty giants, wrestlers of noble stock,"},{"id":"semetey-1-2013:p0720:b003:l019","ordinal":132039,"en":"He slaughtered them all."},{"id":"semetey-1-2013:p0720:b003:l020","ordinal":132040,"en":"Ah, that accursed wrestler, Great Döngö,"},{"id":"semetey-1-2013:p0720:b003:l021","ordinal":132041,"en":"Displayed boundless valor."},{"id":"semetey-1-2013:p0720:b003:l022","ordinal":132042,"en":"Five of those eighty,"},{"id":"semetey-1-2013:p0720:b003:l023","ordinal":132043,"en":"To the khan of Khakanchyn,"},{"id":"semetey-1-2013:p0720:b003:l024","ordinal":132044,"en":"He brought alive and bound."},{"id":"semetey-1-2013:p0720:b003:l025","ordinal":132045,"en":"To Beijing's Kary Khan,"},{"id":"semetey-1-2013:p0720:b003:l026","ordinal":132046,"en":"He presented them as tribute."},{"id":"semetey-1-2013:p0720:b003:l027","ordinal":132047,"en":"Then his khan took a liking to Döngö."},{"id":"semetey-1-2013:p0720:b003:l028","ordinal":132048,"en":"The five he brought bound"},{"id":"semetey-1-2013:p0720:b003:l029","ordinal":132049,"en":"He had maintained by the treasury."},{"id":"semetey-1-2013:p0720:b003:l030","ordinal":132050,"en":"Of the forty Chinese tribes,"},{"id":"semetey-1-2013:p0720:b003:l031","ordinal":132051,"en":"Of that damned Beijing,"},{"id":"semetey-1-2013:p0720:b003:l032","ordinal":132052,"en":"Which deeds shall I tell?"},{"id":"semetey-1-2013:p0720:b003:l033","ordinal":132053,"en":"Devising plans no man could conceive,"},{"id":"semetey-1-2013:p0720:b003:l034","ordinal":132054,"en":"They feasted eighty-four days."},{"id":"semetey-1-2013:p0720:b003:l035","ordinal":132055,"en":"The Chinese gathered at the feast,"},{"id":"semetey-1-2013:p0720:b003:l036","ordinal":132056,"en":"Had their booming instruments struck,"},{"id":"semetey-1-2013:p0720:b003:l037","ordinal":132057,"en":"Drums deafening the ears,"},{"id":"semetey-1-2013:p0720:b003:l038","ordinal":132058,"en":"Had their shawms sound shrilly,"},{"id":"semetey-1-2013:p0720:b003:l039","ordinal":132059,"en":"Had their bells rung."},{"id":"semetey-1-2013:p0720:b004:l001","ordinal":132060,"en":"A great idol made of bronze"},{"id":"semetey-1-2013:p0720:b004:l002","ordinal":132061,"en":"They had brought, tied up and suspended."},{"id":"semetey-1-2013:p0720:b004:l003","ordinal":132062,"en":"They made their people stream beneath it,"},{"id":"semetey-1-2013:p0720:b004:l004","ordinal":132063,"en":"Creating such commotion."},{"id":"semetey-1-2013:p0720:b004:l005","ordinal":132064,"en":"At its foot they inscribed Chinese writing,"},{"id":"semetey-1-2013:p0720:b004:l006","ordinal":132065,"en":"And named him Khan Döngö."},{"id":"semetey-1-2013:p0720:b004:l007","ordinal":132066,"en":"They placed a golden crown upon him."},{"id":"semetey-1-2013:p0720:b004:l008","ordinal":132067,"en":"That Döngö alone"},{"id":"semetey-1-2013:p0720:b004:l009","ordinal":132068,"en":"They seated on a golden throne."},{"id":"semetey-1-2013:p0720:b004:l010","ordinal":132069,"en":"They had their seers examine him,"},{"id":"semetey-1-2013:p0720:b004:l011","ordinal":132070,"en":"Their singers sing of him,"},{"id":"semetey-1-2013:p0720:b004:l012","ordinal":132071,"en":"Made the people accept his words,"},{"id":"semetey-1-2013:p0720:b004:l013","ordinal":132072,"en":"Of Beijing's forty Chinese tribes,"},{"id":"semetey-1-2013:p0720:b004:l014","ordinal":132073,"en":"They made him lord over half."},{"id":"semetey-1-2013:p0720:b004:l015","ordinal":132074,"en":"Making his sleeveless jacket bulge,"},{"id":"semetey-1-2013:p0720:b004:l016","ordinal":132075,"en":"That Döngö himself"},{"id":"semetey-1-2013:p0720:b004:l017","ordinal":132076,"en":"They clothed in a mighty man's robe."},{"id":"semetey-1-2013:p0720:b004:l018","ordinal":132077,"en":"His armored arm-guards spreading wide,"},{"id":"semetey-1-2013:p0720:b004:l019","ordinal":132078,"en":"They clothed him in his khan's robe."},{"id":"semetey-1-2013:p0720:b004:l020","ordinal":132079,"en":"They tended him in a cool place,"},{"id":"semetey-1-2013:p0720:b004:l021","ordinal":132080,"en":"Taking a liking to Döngö."},{"id":"semetey-1-2013:p0720:b004:l022","ordinal":132081,"en":"Their seers foresaw:"},{"id":"semetey-1-2013:p0720:b004:l023","ordinal":132082,"en":"‘That raging madman Manas of the Burut,"},{"id":"semetey-1-2013:p0720:b004:l025","ordinal":132083,"en":"Döngö will capture him for us,’"},{"id":"semetey-1-2013:p0720:b004:l026","ordinal":132084,"en":"And cherished that hope."},{"id":"semetey-1-2013:p0720:b004:l027","ordinal":132085,"en":"When they sent Döngö this way,"},{"id":"semetey-1-2013:p0720:b004:l028","ordinal":132086,"en":"Kary Khan and Esen Khan,"},{"id":"semetey-1-2013:p0720:b004:l029","ordinal":132087,"en":"Ai-Jangjung and Kün-Jangjung,"},{"id":"semetey-1-2013:p0720:b004:l030","ordinal":132088,"en":"And Azyz Khan—five khans they were."},{"id":"semetey-1-2013:p0720:b004:l031","ordinal":132089,"en":"Of Khakanchyn Beijing,"},{"id":"semetey-1-2013:p0720:b004:l032","ordinal":132090,"en":"He was its great ruler."},{"id":"semetey-1-2013:p0720:b004:l033","ordinal":132091,"en":"‘This Manas, khan of the Kyrgyz,"},{"id":"semetey-1-2013:p0720:b004:l034","ordinal":132092,"en":"Great Döngö will capture him for us,’"},{"id":"semetey-1-2013:p0720:b004:l035","ordinal":132093,"en":"They held that great hope."},{"id":"semetey-1-2013:p0720:b004:l036","ordinal":132094,"en":"Ask not about Döngö!"},{"id":"semetey-1-2013:p0720:b004:l037","ordinal":132095,"en":"Receiving word from his khan,"},{"id":"semetey-1-2013:p0720:b004:l038","ordinal":132096,"en":"His courage overflowed:"}]
