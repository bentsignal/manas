[{"id":"semetey-2-2013:p1309:b003:l008","ordinal":286465,"en":"Beneath it, a sheer cliff rose."},{"id":"semetey-2-2013:p1309:b003:l009","ordinal":286466,"en":"Wherever he stopped to camp,"},{"id":"semetey-2-2013:p1309:b003:l010","ordinal":286467,"en":"Poplars as broad as a sheepfold stood."},{"id":"semetey-2-2013:p1309:b003:l011","ordinal":286468,"en":"Any enemy who openly opposed him"},{"id":"semetey-2-2013:p1309:b003:l012","ordinal":286469,"en":"Never prospered or multiplied."},{"id":"semetey-2-2013:p1309:b003:l013","ordinal":286470,"en":"“This Choro has struck at the twins;"},{"id":"semetey-2-2013:p1309:b003:l014","ordinal":286471,"en":"Perhaps he will never thrive,"},{"id":"semetey-2-2013:p1309:b003:l015","ordinal":286472,"en":"But will rescue heroes, ruin nations,"},{"id":"semetey-2-2013:p1309:b003:l016","ordinal":286473,"en":"And plunge us into suffering;"},{"id":"semetey-2-2013:p1309:b003:l017","ordinal":286474,"en":"Perhaps he will poison"},{"id":"semetey-2-2013:p1309:b003:l018","ordinal":286475,"en":"All the Jediger;"},{"id":"semetey-2-2013:p1309:b003:l019","ordinal":286476,"en":"Perhaps he will cast them"},{"id":"semetey-2-2013:p1309:b003:l020","ordinal":286477,"en":"Into incurable affliction and turmoil;"},{"id":"semetey-2-2013:p1309:b003:l021","ordinal":286478,"en":"Perhaps he will throw"},{"id":"semetey-2-2013:p1309:b003:l022","ordinal":286479,"en":"All these Jediger into the water;"},{"id":"semetey-2-2013:p1309:b003:l023","ordinal":286480,"en":"Perhaps he will plunge them"},{"id":"semetey-2-2013:p1309:b003:l024","ordinal":286481,"en":"Into a clamor unknown to men and unseen by nations."},{"id":"semetey-2-2013:p1309:b003:l025","ordinal":286482,"en":"Kanchoro has won such renown,"},{"id":"semetey-2-2013:p1309:b003:l026","ordinal":286483,"en":"His quarrel will touch the whole world;"},{"id":"semetey-2-2013:p1309:b003:l027","ordinal":286484,"en":"Will he lie still without raising strife?”"},{"id":"semetey-2-2013:p1309:b003:l028","ordinal":286485,"en":"The massed black Jediger—"},{"id":"semetey-2-2013:p1309:b003:l029","ordinal":286486,"en":"All the Jediger,"},{"id":"semetey-2-2013:p1309:b003:l030","ordinal":286487,"en":"Young and old—"},{"id":"semetey-2-2013:p1309:b003:l031","ordinal":286488,"en":"Considered what would follow and raised an uproar;"},{"id":"semetey-2-2013:p1309:b003:l032","ordinal":286489,"en":"Thinking it over, they made a commotion."},{"id":"semetey-2-2013:p1309:b003:l033","ordinal":286490,"en":"With evil thoughts about the choro,"},{"id":"semetey-2-2013:p1309:b003:l034","ordinal":286491,"en":"The Jediger stood there."},{"id":"semetey-2-2013:p1309:b003:l035","ordinal":286492,"en":"Before the Jediger could close their mouths,"},{"id":"semetey-2-2013:p1309:b003:l036","ordinal":286493,"en":"Kanchoro came out shouting,"},{"id":"semetey-2-2013:p1309:b003:l037","ordinal":286494,"en":"Summoning every last man."},{"id":"semetey-2-2013:p1309:b003:l038","ordinal":286495,"en":"Swelling with anger,"},{"id":"semetey-2-2013:p1309:b003:l039","ordinal":286496,"en":"Against the ill-fated choro,"},{"id":"semetey-2-2013:p1309:b004:l001","ordinal":286497,"en":"He found counsel as if from the unseen"},{"id":"semetey-2-2013:p1309:b004:l002","ordinal":286498,"en":"And began speaking wrathfully."},{"id":"semetey-2-2013:p1309:b004:l003","ordinal":286499,"en":"When Kanchoro grew fierce—"},{"id":"semetey-2-2013:p1309:b004:l004","ordinal":286500,"en":"That cringing madman,"},{"id":"semetey-2-2013:p1309:b004:l005","ordinal":286501,"en":"That treacherous choro—"},{"id":"semetey-2-2013:p1309:b004:l006","ordinal":286502,"en":"He buckled on his unsheathed sword,"},{"id":"semetey-2-2013:p1309:b004:l007","ordinal":286503,"en":"Set all his weapons in place,"},{"id":"semetey-2-2013:p1309:b004:l008","ordinal":286504,"en":"And made ready to speak."},{"id":"semetey-2-2013:p1309:b004:l009","ordinal":286505,"en":"His black eyes filled with blood;"},{"id":"semetey-2-2013:p1309:b004:l010","ordinal":286506,"en":"He roared menacingly,"},{"id":"semetey-2-2013:p1309:b004:l011","ordinal":286507,"en":"Calling all the massed black Jediger"},{"id":"semetey-2-2013:p1309:b004:l012","ordinal":286508,"en":"To come without exception:"},{"id":"semetey-2-2013:p1309:b004:l013","ordinal":286509,"en":"“On the plain of Chogulma"},{"id":"semetey-2-2013:p1309:b004:l014","ordinal":286510,"en":"Hold a gathering together;"},{"id":"semetey-2-2013:p1309:b004:l015","ordinal":286511,"en":"Devise a plan and find a way."},{"id":"semetey-2-2013:p1309:b004:l016","ordinal":286512,"en":"Bakay Khan is their elder—"},{"id":"semetey-2-2013:p1309:b004:l017","ordinal":286513,"en":"Strike down Bakay Khan!"},{"id":"semetey-2-2013:p1309:b004:l018","ordinal":286514,"en":"His beard is white as a swan;"},{"id":"semetey-2-2013:p1309:b004:l019","ordinal":286515,"en":"While his final journey is near,"},{"id":"semetey-2-2013:p1309:b004:l020","ordinal":286516,"en":"His eyes have reddened like a raven’s,"},{"id":"semetey-2-2013:p1309:b004:l021","ordinal":286517,"en":"His swan-white beard has grown long,"},{"id":"semetey-2-2013:p1309:b004:l022","ordinal":286518,"en":"His remaining eye festers,"},{"id":"semetey-2-2013:p1309:b004:l023","ordinal":286519,"en":"And his chest wheezes."},{"id":"semetey-2-2013:p1309:b004:l024","ordinal":286520,"en":"That accursed Bakay Khan—"},{"id":"semetey-2-2013:p1309:b004:l025","ordinal":286521,"en":"Before his head enters the grave,"},{"id":"semetey-2-2013:p1309:b004:l026","ordinal":286522,"en":"Before his soul reaches the earth—"},{"id":"semetey-2-2013:p1309:b004:l027","ordinal":286523,"en":"Still devises perfect counsels"},{"id":"semetey-2-2013:p1309:b004:l028","ordinal":286524,"en":"And will not abandon his mischief."},{"id":"semetey-2-2013:p1309:b004:l029","ordinal":286525,"en":"For Bakay’s many offenses,"},{"id":"semetey-2-2013:p1309:b004:l030","ordinal":286526,"en":"I will make him taste misery;"},{"id":"semetey-2-2013:p1309:b004:l031","ordinal":286527,"en":"I myself will give his punishment."},{"id":"semetey-2-2013:p1309:b004:l032","ordinal":286528,"en":"I will strip him and bend his back,"},{"id":"semetey-2-2013:p1309:b004:l033","ordinal":286529,"en":"Load him upon a yellow gelded camel,"},{"id":"semetey-2-2013:p1309:b004:l034","ordinal":286530,"en":"And heap boiling anguish upon him."},{"id":"semetey-2-2013:p1309:b004:l035","ordinal":286531,"en":"I will make eighty powerful wrestlers"},{"id":"semetey-2-2013:p1309:b004:l036","ordinal":286532,"en":"Use Bakay as their kökbörü carcass"},{"id":"semetey-2-2013:p1309:b004:l037","ordinal":286533,"en":"Three times each week;"},{"id":"semetey-2-2013:p1309:b004:l038","ordinal":286534,"en":"I will have fools maul him,"},{"id":"semetey-2-2013:p1309:b004:l039","ordinal":286535,"en":"And, granting Bakay no counsel,"},{"id":"semetey-2-2013:p1310:b003:l001","ordinal":286536,"en":"I will make him weary of life."},{"id":"semetey-2-2013:p1310:b003:l002","ordinal":286537,"en":"In Bakay’s old age"},{"id":"semetey-2-2013:p1310:b003:l003","ordinal":286538,"en":"I myself will settle his account;"},{"id":"semetey-2-2013:p1310:b003:l004","ordinal":286539,"en":"I will beat out his ancient demon."},{"id":"semetey-2-2013:p1310:b003:l005","ordinal":286540,"en":"I will devise a superior stratagem"},{"id":"semetey-2-2013:p1310:b003:l006","ordinal":286541,"en":"And somehow take the head"},{"id":"semetey-2-2013:p1310:b003:l007","ordinal":286542,"en":"Of arrogant, deathless Bakay."},{"id":"semetey-2-2013:p1310:b003:l008","ordinal":286543,"en":"I will heap humiliation upon him like sheep;"},{"id":"semetey-2-2013:p1310:b003:l009","ordinal":286544,"en":"I will gather without exception"},{"id":"semetey-2-2013:p1310:b003:l010","ordinal":286545,"en":"All the descendants and people of Manas,"},{"id":"semetey-2-2013:p1310:b003:l011","ordinal":286546,"en":"Grind them to stone dust,"},{"id":"semetey-2-2013:p1310:b003:l012","ordinal":286547,"en":"And do as I please."},{"id":"semetey-2-2013:p1310:b003:l013","ordinal":286548,"en":"Massed black Jediger,"},{"id":"semetey-2-2013:p1310:b003:l014","ordinal":286549,"en":"Come, every last one!” he shouted,"},{"id":"semetey-2-2013:p1310:b003:l015","ordinal":286550,"en":"Calling their fiercest men."},{"id":"semetey-2-2013:p1310:b003:l016","ordinal":286551,"en":"Then Kanchoro,"},{"id":"semetey-2-2013:p1310:b003:l017","ordinal":286552,"en":"Summoning them all to come, said:"},{"id":"semetey-2-2013:p1310:b003:l018","ordinal":286553,"en":"“Brave Kyyaz of the Jediger,"},{"id":"semetey-2-2013:p1310:b003:l019","ordinal":286554,"en":"You, their hero, stand here;"},{"id":"semetey-2-2013:p1310:b003:l020","ordinal":286555,"en":"You resourceful, wise"},{"id":"semetey-2-2013:p1310:b003:l021","ordinal":286556,"en":"Champion stand here;"},{"id":"semetey-2-2013:p1310:b003:l022","ordinal":286557,"en":"You who boldly enter battle,"},{"id":"semetey-2-2013:p1310:b003:l023","ordinal":286558,"en":"Khan of the massed black Jediger,"},{"id":"semetey-2-2013:p1310:b003:l024","ordinal":286559,"en":"You stand here."},{"id":"semetey-2-2013:p1310:b003:l025","ordinal":286560,"en":"All you seasoned men who know the people,"},{"id":"semetey-2-2013:p1310:b003:l026","ordinal":286561,"en":"All of you stand here;"},{"id":"semetey-2-2013:p1310:b003:l027","ordinal":286562,"en":"All you farsighted men,"},{"id":"semetey-2-2013:p1310:b003:l028","ordinal":286563,"en":"You long-eared listeners,"},{"id":"semetey-2-2013:p1310:b003:l029","ordinal":286564,"en":"You strong men who know the distant future,"},{"id":"semetey-2-2013:p1310:b003:l030","ordinal":286565,"en":"You strong men who know what is near;"},{"id":"semetey-2-2013:p1310:b003:l031","ordinal":286566,"en":"You broad-chested lions,"},{"id":"semetey-2-2013:p1310:b003:l032","ordinal":286567,"en":"You heroes who do not grieve"},{"id":"semetey-2-2013:p1310:b003:l033","ordinal":286568,"en":"Though both feet burn in fire—"},{"id":"semetey-2-2013:p1310:b003:l034","ordinal":286569,"en":"Turn and come here!"},{"id":"semetey-2-2013:p1310:b003:l035","ordinal":286570,"en":"You unshaken lions,"},{"id":"semetey-2-2013:p1310:b003:l036","ordinal":286571,"en":"You fortunate heroes on the road,"},{"id":"semetey-2-2013:p1310:b003:l037","ordinal":286572,"en":"You mighty black Jediger,"},{"id":"semetey-2-2013:p1310:b003:l038","ordinal":286573,"en":"My tigers, come here!"},{"id":"semetey-2-2013:p1310:b003:l039","ordinal":286574,"en":"Believe the words of Kanchoro Khan,"},{"id":"semetey-2-2013:p1310:b004:l001","ordinal":286575,"en":"All you people;"},{"id":"semetey-2-2013:p1310:b004:l002","ordinal":286576,"en":"Your khan will speak now—"},{"id":"semetey-2-2013:p1310:b004:l003","ordinal":286577,"en":"People, now behold!"},{"id":"semetey-2-2013:p1310:b004:l004","ordinal":286578,"en":"Kanchoro who governs the people—"},{"id":"semetey-2-2013:p1310:b004:l005","ordinal":286579,"en":"You know, great nation,"},{"id":"semetey-2-2013:p1310:b004:l006","ordinal":286580,"en":"Kanchoro’s renown"},{"id":"semetey-2-2013:p1310:b004:l007","ordinal":286581,"en":"And fierce Aychürök’s quarrel."},{"id":"semetey-2-2013:p1310:b004:l008","ordinal":286582,"en":"Will Kyyaz Khan lie still"},{"id":"semetey-2-2013:p1310:b004:l009","ordinal":286583,"en":"Without taking fierce Aychürök,"},{"id":"semetey-2-2013:p1310:b004:l010","ordinal":286584,"en":"That woman Aychürök,"},{"id":"semetey-2-2013:p1310:b004:l011","ordinal":286585,"en":"That glinting infidel,"},{"id":"semetey-2-2013:p1310:b004:l012","ordinal":286586,"en":"She who is famed as beautiful?"},{"id":"semetey-2-2013:p1310:b004:l013","ordinal":286587,"en":"Did the settled Kyrgyz not witness"},{"id":"semetey-2-2013:p1310:b004:l014","ordinal":286588,"en":"The strife she caused?"},{"id":"semetey-2-2013:p1310:b004:l015","ordinal":286589,"en":"Toltoy Khan was to take her,"},{"id":"semetey-2-2013:p1310:b004:l016","ordinal":286590,"en":"But the madman burned to death"},{"id":"semetey-2-2013:p1310:b004:l017","ordinal":286591,"en":"And met his end through Külchoro."},{"id":"semetey-2-2013:p1310:b004:l018","ordinal":286592,"en":"Because of that former affair,"},{"id":"semetey-2-2013:p1310:b004:l019","ordinal":286593,"en":"Because of fierce Aychürök,"},{"id":"semetey-2-2013:p1310:b004:l020","ordinal":286594,"en":"Many khojas and khans died;"},{"id":"semetey-2-2013:p1310:b004:l021","ordinal":286595,"en":"All who grappled with them died,"},{"id":"semetey-2-2013:p1310:b004:l022","ordinal":286596,"en":"And many humble souls died too."},{"id":"semetey-2-2013:p1310:b004:l023","ordinal":286597,"en":"Spears were bundled and heaped;"},{"id":"semetey-2-2013:p1310:b004:l024","ordinal":286598,"en":"Beginning with old Tölök,"},{"id":"semetey-2-2013:p1310:b004:l025","ordinal":286599,"en":"How many were slaughtered together"},{"id":"semetey-2-2013:p1310:b004:l026","ordinal":286600,"en":"And scattered abroad!"},{"id":"semetey-2-2013:p1310:b004:l027","ordinal":286601,"en":"The camps of the Jediger people"},{"id":"semetey-2-2013:p1310:b004:l028","ordinal":286602,"en":"Were broken and scattered;"},{"id":"semetey-2-2013:p1310:b004:l029","ordinal":286603,"en":"Their wives were left widows."},{"id":"semetey-2-2013:p1310:b004:l030","ordinal":286604,"en":"No trace remained,"},{"id":"semetey-2-2013:p1310:b004:l031","ordinal":286605,"en":"No tidings of the Jediger;"},{"id":"semetey-2-2013:p1310:b004:l032","ordinal":286606,"en":"Only their willows remained upon the land,"},{"id":"semetey-2-2013:p1310:b004:l033","ordinal":286607,"en":"Their children left as orphans."},{"id":"semetey-2-2013:p1310:b004:l034","ordinal":286608,"en":"How many of their khans were killed!"},{"id":"semetey-2-2013:p1310:b004:l035","ordinal":286609,"en":"When you met face to face,"},{"id":"semetey-2-2013:p1310:b004:l036","ordinal":286610,"en":"Many of your lives were destroyed."},{"id":"semetey-2-2013:p1310:b004:l037","ordinal":286611,"en":"Seeking to take fierce Chürök,"},{"id":"semetey-2-2013:p1310:b004:l038","ordinal":286612,"en":"All of you were massacred."},{"id":"semetey-2-2013:p1310:b004:l039","ordinal":286613,"en":"Your turn has come: will you not"},{"id":"semetey-2-2013:p1311:b003:l001","ordinal":286614,"en":"Settle your quarrel, Jediger?"},{"id":"semetey-2-2013:p1311:b003:l002","ordinal":286615,"en":"Will you not slaughter"},{"id":"semetey-2-2013:p1311:b003:l003","ordinal":286616,"en":"The enemy fallen into your hands, Jediger?"},{"id":"semetey-2-2013:p1311:b003:l004","ordinal":286617,"en":"Will you not inflict"},{"id":"semetey-2-2013:p1311:b003:l005","ordinal":286618,"en":"A singular, exacting calamity, Jediger?"},{"id":"semetey-2-2013:p1311:b003:l006","ordinal":286619,"en":"Will you not avenge"},{"id":"semetey-2-2013:p1311:b003:l007","ordinal":286620,"en":"The true grievance of the dead, Jediger?"},{"id":"semetey-2-2013:p1311:b003:l008","ordinal":286621,"en":"Your chance has come into your hands—"},{"id":"semetey-2-2013:p1311:b003:l009","ordinal":286622,"en":"Do you not see it, Jediger?"},{"id":"semetey-2-2013:p1311:b003:l010","ordinal":286623,"en":"Will you not divide among yourselves"},{"id":"semetey-2-2013:p1311:b003:l011","ordinal":286624,"en":"The bloodthirsty lord’s wives and children, Jediger?"},{"id":"semetey-2-2013:p1311:b003:l012","ordinal":286625,"en":"Will you not give Kanchoro"},{"id":"semetey-2-2013:p1311:b003:l013","ordinal":286626,"en":"Whomever he desires, Jediger?"},{"id":"semetey-2-2013:p1311:b003:l014","ordinal":286627,"en":"Will you not submit to the decree"},{"id":"semetey-2-2013:p1311:b003:l015","ordinal":286628,"en":"Spoken by your khan, Jediger?"},{"id":"semetey-2-2013:p1311:b003:l016","ordinal":286629,"en":"Will you not find"},{"id":"semetey-2-2013:p1311:b003:l017","ordinal":286630,"en":"Countless riches and abundant spoils, Jediger?"},{"id":"semetey-2-2013:p1311:b003:l018","ordinal":286631,"en":"Will you not raid"},{"id":"semetey-2-2013:p1311:b003:l019","ordinal":286632,"en":"Semetey Khan’s stronghold, Jediger?"},{"id":"semetey-2-2013:p1311:b003:l020","ordinal":286633,"en":"Will you not beat out"},{"id":"semetey-2-2013:p1311:b003:l021","ordinal":286634,"en":"The Kyrgyz madness, Jediger?"},{"id":"semetey-2-2013:p1311:b003:l022","ordinal":286635,"en":"Will you not unleash"},{"id":"semetey-2-2013:p1311:b003:l023","ordinal":286636,"en":"A dreadful affliction and great slaughter, Jediger?"},{"id":"semetey-2-2013:p1311:b003:l024","ordinal":286637,"en":"And the fierce woman Aychürök—"},{"id":"semetey-2-2013:p1311:b003:l025","ordinal":286638,"en":"Will you not take that proud woman as spoil,"},{"id":"semetey-2-2013:p1311:b003:l026","ordinal":286639,"en":"Jediger?"},{"id":"semetey-2-2013:p1311:b003:l027","ordinal":286640,"en":"Will you not boast throughout your lands,"},{"id":"semetey-2-2013:p1311:b003:l028","ordinal":286641,"en":"Raise a clamor, and hold"},{"id":"semetey-2-2013:p1311:b003:l029","ordinal":286642,"en":"A great feast for this, Jediger?"},{"id":"semetey-2-2013:p1311:b003:l030","ordinal":286643,"en":"Will you not gather every nation"},{"id":"semetey-2-2013:p1311:b003:l031","ordinal":286644,"en":"From Jeti-Özön, Jediger?"},{"id":"semetey-2-2013:p1311:b003:l032","ordinal":286645,"en":"Will you not slaughter countless livestock"},{"id":"semetey-2-2013:p1311:b003:l033","ordinal":286646,"en":"For the feast, Jediger?"},{"id":"semetey-2-2013:p1311:b003:l034","ordinal":286647,"en":"Will you not cut her in two"},{"id":"semetey-2-2013:p1311:b003:l035","ordinal":286648,"en":"And leave her for Kyyaz, Jediger?"},{"id":"semetey-2-2013:p1311:b003:l036","ordinal":286649,"en":"Your khojas in white turbans,"},{"id":"semetey-2-2013:p1311:b003:l037","ordinal":286650,"en":"Your mullahs who recite their lessons,"},{"id":"semetey-2-2013:p1311:b003:l038","ordinal":286651,"en":"Your elders who can fly,"},{"id":"semetey-2-2013:p1311:b003:l039","ordinal":286652,"en":"And all who know their crafts—"},{"id":"semetey-2-2013:p1311:b004:l001","ordinal":286653,"en":"Will you not gather them, Jediger?"},{"id":"semetey-2-2013:p1311:b004:l002","ordinal":286654,"en":"For your lord Kyyaz,"},{"id":"semetey-2-2013:p1311:b004:l003","ordinal":286655,"en":"Cutting shares in this way,"},{"id":"semetey-2-2013:p1311:b004:l004","ordinal":286656,"en":"Will you not carve them, Jediger?"},{"id":"semetey-2-2013:p1311:b004:l005","ordinal":286657,"en":"Chürök, beautiful as the sun—"},{"id":"semetey-2-2013:p1311:b004:l006","ordinal":286658,"en":"Grief and calamity follow behind her;"},{"id":"semetey-2-2013:p1311:b004:l007","ordinal":286659,"en":"Such is Chürök’s nature."},{"id":"semetey-2-2013:p1311:b004:l008","ordinal":286660,"en":"With her white breasts exposed,"},{"id":"semetey-2-2013:p1311:b004:l009","ordinal":286661,"en":"Her dawn pale as a mountain sheep,"},{"id":"semetey-2-2013:p1311:b004:l010","ordinal":286662,"en":"Her eyes shining like a camel calf’s,"},{"id":"semetey-2-2013:p1311:b004:l011","ordinal":286663,"en":"Will you not drive her"},{"id":"semetey-2-2013:p1311:b004:l012","ordinal":286664,"en":"Among sixty wrestlers and eighty men,"},{"id":"semetey-2-2013:p1311:b004:l013","ordinal":286665,"en":"Making a spectacle for all"},{"id":"semetey-2-2013:p1311:b004:l014","ordinal":286666,"en":"That ears may hear and eyes may see,"},{"id":"semetey-2-2013:p1311:b004:l015","ordinal":286667,"en":"And heap on Aychürök’s head"},{"id":"semetey-2-2013:p1311:b004:l016","ordinal":286668,"en":"Affliction and strife no nation has witnessed,"},{"id":"semetey-2-2013:p1311:b004:l017","ordinal":286669,"en":"Jediger?"},{"id":"semetey-2-2013:p1311:b004:l018","ordinal":286670,"en":"Beautiful Aychürök is your captive;"},{"id":"semetey-2-2013:p1311:b004:l019","ordinal":286671,"en":"That is Kanchoro’s counsel."},{"id":"semetey-2-2013:p1311:b004:l020","ordinal":286672,"en":"Brave Kyyaz, struck by a man’s curse,"},{"id":"semetey-2-2013:p1311:b004:l021","ordinal":286673,"en":"If you wish, she is your wife;"},{"id":"semetey-2-2013:p1311:b004:l022","ordinal":286674,"en":"If her widowhood is truly disputed,"},{"id":"semetey-2-2013:p1311:b004:l023","ordinal":286675,"en":"She is in truth your own spouse,"},{"id":"semetey-2-2013:p1311:b004:l024","ordinal":286676,"en":"The wife from your village in Jeti-Özön,"},{"id":"semetey-2-2013:p1311:b004:l025","ordinal":286677,"en":"Won through contention in Talas,"},{"id":"semetey-2-2013:p1311:b004:l026","ordinal":286678,"en":"Whom you carried off as your wife."},{"id":"semetey-2-2013:p1311:b004:l027","ordinal":286679,"en":"How is it, Kyyaz, that you sank"},{"id":"semetey-2-2013:p1311:b004:l028","ordinal":286680,"en":"Into merry games and great feasts?"},{"id":"semetey-2-2013:p1311:b004:l029","ordinal":286681,"en":"How is it, Kyyaz, that you lie there,"},{"id":"semetey-2-2013:p1311:b004:l030","ordinal":286682,"en":"Regarding Chürök as a maiden?"},{"id":"semetey-2-2013:p1311:b004:l031","ordinal":286683,"en":"How is it, Kyyaz, that you raised Kanchoro"},{"id":"semetey-2-2013:p1311:b004:l032","ordinal":286684,"en":"And made him khan?"},{"id":"semetey-2-2013:p1311:b004:l033","ordinal":286685,"en":"How is it, Kyyaz, that you feast"},{"id":"semetey-2-2013:p1311:b004:l034","ordinal":286686,"en":"On merry games and entertainment?"},{"id":"semetey-2-2013:p1311:b004:l035","ordinal":286687,"en":"Having won the stronghold and mounted the throne,"},{"id":"semetey-2-2013:p1311:b004:l036","ordinal":286688,"en":"Swelling with great fortune,"},{"id":"semetey-2-2013:p1311:b004:l037","ordinal":286689,"en":"How is it, Kyyaz, that you sank into it?"},{"id":"semetey-2-2013:p1311:b004:l038","ordinal":286690,"en":"How is it, Kyyaz, that you lie"},{"id":"semetey-2-2013:p1311:b004:l039","ordinal":286691,"en":"In broad pleasure and great amusement?"},{"id":"semetey-2-2013:p1312:b003:l001","ordinal":286692,"en":"That scheming infidel—"},{"id":"semetey-2-2013:p1312:b003:l002","ordinal":286693,"en":"That woman Aychürök—"},{"id":"semetey-2-2013:p1312:b003:l003","ordinal":286694,"en":"Know this that I tell you;"},{"id":"semetey-2-2013:p1312:b003:l004","ordinal":286695,"en":"You are a man, Kyyaz, heed my words!"},{"id":"semetey-2-2013:p1312:b003:l005","ordinal":286696,"en":"When you take Aychürök"},{"id":"semetey-2-2013:p1312:b003:l006","ordinal":286697,"en":"And carry her to your village,"},{"id":"semetey-2-2013:p1312:b003:l007","ordinal":286698,"en":"One woman grasping at your collar"},{"id":"semetey-2-2013:p1312:b003:l008","ordinal":286699,"en":"Must not destroy a whole cliff;"},{"id":"semetey-2-2013:p1312:b003:l009","ordinal":286700,"en":"One woman raising a quarrel"},{"id":"semetey-2-2013:p1312:b003:l010","ordinal":286701,"en":"Must not ruin all the livestock."},{"id":"semetey-2-2013:p1312:b003:l011","ordinal":286702,"en":"The two reins and single lead-rope—"},{"id":"semetey-2-2013:p1312:b003:l012","ordinal":286703,"en":"Without treating Chürök merely as a woman,"},{"id":"semetey-2-2013:p1312:b003:l013","ordinal":286704,"en":"Place them wholly in her hands."},{"id":"semetey-2-2013:p1312:b003:l014","ordinal":286705,"en":"Submit to whatever"},{"id":"semetey-2-2013:p1312:b003:l015","ordinal":286706,"en":"That shimmering infidel demands;"},{"id":"semetey-2-2013:p1312:b003:l016","ordinal":286707,"en":"Do the deeds she tells you."},{"id":"semetey-2-2013:p1312:b003:l017","ordinal":286708,"en":"For the fierce woman who overcame you,"},{"id":"semetey-2-2013:p1312:b003:l018","ordinal":286709,"en":"Until seven full years have passed,"},{"id":"semetey-2-2013:p1312:b003:l019","ordinal":286710,"en":"Keep doing whatever she says."},{"id":"semetey-2-2013:p1312:b003:l020","ordinal":286711,"en":"Set up a gilded throne,"},{"id":"semetey-2-2013:p1312:b003:l021","ordinal":286712,"en":"Plant a garden of plane trees around it;"},{"id":"semetey-2-2013:p1312:b003:l022","ordinal":286713,"en":"Let no willow fail to leaf."},{"id":"semetey-2-2013:p1312:b003:l023","ordinal":286714,"en":"Let nightingales and birds of every kind"},{"id":"semetey-2-2013:p1312:b003:l024","ordinal":286715,"en":"Perch in the tower and sing expertly."},{"id":"semetey-2-2013:p1312:b003:l025","ordinal":286716,"en":"Let no resentment remain"},{"id":"semetey-2-2013:p1312:b003:l026","ordinal":286717,"en":"Inside the ill-fated infidel,"},{"id":"semetey-2-2013:p1312:b003:l027","ordinal":286718,"en":"The fierce woman Chürök."},{"id":"semetey-2-2013:p1312:b003:l028","ordinal":286719,"en":"From beneath every plane tree"},{"id":"semetey-2-2013:p1312:b003:l029","ordinal":286720,"en":"Let a spring boil up and overflow;"}]
