[{"id":"manas-2010:p1490:b001:l005","ordinal":64257,"en":"Felling them in tens and fives;"},{"id":"manas-2010:p1490:b001:l006","ordinal":64258,"en":"Turned left and shot once,"},{"id":"manas-2010:p1490:b001:l007","ordinal":64259,"en":"Felling so many on the left."},{"id":"manas-2010:p1490:b001:l008","ordinal":64260,"en":"The Chinese he encountered,"},{"id":"manas-2010:p1490:b001:l009","ordinal":64261,"en":"Like people struck by lingering sickness,"},{"id":"manas-2010:p1490:b001:l010","ordinal":64262,"en":"He slaughtered, drawing his bow."},{"id":"manas-2010:p1490:b001:l011","ordinal":64263,"en":"The eye could not catch them when it looked;"},{"id":"manas-2010:p1490:b001:l012","ordinal":64264,"en":"Infidels and Muslims"},{"id":"manas-2010:p1490:b001:l013","ordinal":64265,"en":"Mingled amid the dust;"},{"id":"manas-2010:p1490:b001:l014","ordinal":64266,"en":"One could not tell which was which."},{"id":"manas-2010:p1490:b001:l015","ordinal":64267,"en":"Flying earth and clouds of dust,"},{"id":"manas-2010:p1490:b001:l016","ordinal":64268,"en":"Scarlet blood flowing without cease;"},{"id":"manas-2010:p1490:b001:l017","ordinal":64269,"en":"Immersed in scarlet blood,"},{"id":"manas-2010:p1490:b001:l018","ordinal":64270,"en":"So many people lay destroyed."},{"id":"manas-2010:p1490:b001:l019","ordinal":64271,"en":"Not caring a whit for those slaughtered,"},{"id":"manas-2010:p1490:b001:l020","ordinal":64272,"en":"Not valuing them at half a penny,"},{"id":"manas-2010:p1490:b001:l021","ordinal":64273,"en":"Upon the Chinese people of forty khans"},{"id":"manas-2010:p1490:b001:l022","ordinal":64274,"en":"Torment fell without mercy."},{"id":"manas-2010:p1490:b001:l023","ordinal":64275,"en":"Troops of every kind arrived;"},{"id":"manas-2010:p1490:b001:l024","ordinal":64276,"en":"The Chinese were stirred from their foundations."},{"id":"manas-2010:p1490:b001:l025","ordinal":64277,"en":"People came in tens of thousands,"},{"id":"manas-2010:p1490:b001:l026","ordinal":64278,"en":"Gathered from many places,"},{"id":"manas-2010:p1490:b001:l027","ordinal":64279,"en":"In immense, uncountable numbers."},{"id":"manas-2010:p1490:b001:l028","ordinal":64280,"en":"In Beijing where Karykan stayed,"},{"id":"manas-2010:p1490:b001:l029","ordinal":64281,"en":"They forged a fortress of iron;"},{"id":"manas-2010:p1490:b001:l030","ordinal":64282,"en":"A great Buddha image as large as a house"},{"id":"manas-2010:p1490:b001:l031","ordinal":64283,"en":"They had bound and suspended."},{"id":"manas-2010:p1490:b001:l032","ordinal":64284,"en":"His lamas and shaven priests"},{"id":"manas-2010:p1490:b001:l033","ordinal":64285,"en":"He had all assembled."},{"id":"manas-2010:p1490:b001:l034","ordinal":64286,"en":"He gathered the people without exception,"},{"id":"manas-2010:p1490:b001:l035","ordinal":64287,"en":"And made them swear an oath unto death:"},{"id":"manas-2010:p1490:b001:l036","ordinal":64288,"en":"“With the moon dark and night overcast,"},{"id":"manas-2010:p1490:b001:l037","ordinal":64289,"en":"Fight in the darkness!"},{"id":"manas-2010:p1490:b001:l038","ordinal":64290,"en":"Though the Chinese multitude be slaughtered,"},{"id":"manas-2010:p1490:b001:l039","ordinal":64291,"en":"Fight, not one of you left out!"},{"id":"manas-2010:p1490:b001:l040","ordinal":64292,"en":"All older than seventeen"},{"id":"manas-2010:p1490:b001:l041","ordinal":64293,"en":"And younger than fifty-five,"},{"id":"manas-2010:p1490:b001:l042","ordinal":64294,"en":"Gather without a single exception!"},{"id":"manas-2010:p1491:b001:l001","ordinal":64295,"en":"If your strength begins to fail,"},{"id":"manas-2010:p1491:b001:l002","ordinal":64296,"en":"Like a flood that flows away,"},{"id":"manas-2010:p1491:b001:l003","ordinal":64297,"en":"Do not remain alive; perish!”"},{"id":"manas-2010:p1491:b001:l004","ordinal":64298,"en":"The Chinese, detachment upon detachment,"},{"id":"manas-2010:p1491:b001:l005","ordinal":64299,"en":"Divided into their detachments;"},{"id":"manas-2010:p1491:b001:l006","ordinal":64300,"en":"The Manzhuu, lineage upon lineage,"},{"id":"manas-2010:p1491:b001:l007","ordinal":64301,"en":"Divided by their lineage."},{"id":"manas-2010:p1491:b001:l008","ordinal":64302,"en":"The Chinese were a vast multitude."},{"id":"manas-2010:p1491:b001:l009","ordinal":64303,"en":"The Chinese from different places"},{"id":"manas-2010:p1491:b001:l010","ordinal":64304,"en":"Divided by their regions."},{"id":"manas-2010:p1491:b001:l011","ordinal":64305,"en":"The troops of many kinds still arriving,"},{"id":"manas-2010:p1491:b001:l012","ordinal":64306,"en":"As though each came out to single combat,"},{"id":"manas-2010:p1491:b001:l013","ordinal":64307,"en":"Fought, sweeping over the earth."},{"id":"manas-2010:p1491:b001:l014","ordinal":64308,"en":"Before the Muslims,"},{"id":"manas-2010:p1491:b001:l015","ordinal":64309,"en":"To the army fighting on this side,"},{"id":"manas-2010:p1491:b001:l016","ordinal":64310,"en":"He gave his people courage:"},{"id":"manas-2010:p1491:b001:l017","ordinal":64311,"en":"Khan Kongurbay shouted,"},{"id":"manas-2010:p1491:b001:l018","ordinal":64312,"en":"“Sweep upon them, massed army!"},{"id":"manas-2010:p1491:b001:l019","ordinal":64313,"en":"Without sparing your lives,"},{"id":"manas-2010:p1491:b001:l020","ordinal":64314,"en":"Here I stand, your leopard!"},{"id":"manas-2010:p1491:b001:l021","ordinal":64315,"en":"Fight without stopping, champions!"},{"id":"manas-2010:p1491:b001:l022","ordinal":64316,"en":"Here I am, your mountain-like shield!"},{"id":"manas-2010:p1491:b001:l023","ordinal":64317,"en":"Do not flee, champions!"},{"id":"manas-2010:p1491:b001:l024","ordinal":64318,"en":"They have no lofty towering crag,"},{"id":"manas-2010:p1491:b001:l025","ordinal":64319,"en":"Who struck terror through the world—"},{"id":"manas-2010:p1491:b001:l026","ordinal":64320,"en":"Their mountain, magnanimous Manas, is absent!"},{"id":"manas-2010:p1491:b001:l027","ordinal":64321,"en":"They have no support to lean upon."},{"id":"manas-2010:p1491:b001:l028","ordinal":64322,"en":"Consider it, vast Chinese people:"},{"id":"manas-2010:p1491:b001:l029","ordinal":64323,"en":"Their lion, champion Manas, is absent!"},{"id":"manas-2010:p1491:b001:l030","ordinal":64324,"en":"Fight, champions,"},{"id":"manas-2010:p1491:b001:l031","ordinal":64325,"en":"Until the pliant stalks ripen,"},{"id":"manas-2010:p1491:b001:l032","ordinal":64326,"en":"Until autumn's gossamer flies!"},{"id":"manas-2010:p1491:b001:l033","ordinal":64327,"en":"If we fight hard for six months,"},{"id":"manas-2010:p1491:b001:l034","ordinal":64328,"en":"Their horses will lose blood,"},{"id":"manas-2010:p1491:b001:l035","ordinal":64329,"en":"They themselves will lose strength."},{"id":"manas-2010:p1491:b001:l036","ordinal":64330,"en":"Let us fight in earnest;"},{"id":"manas-2010:p1491:b001:l037","ordinal":64331,"en":"Those who truly show their valor,"},{"id":"manas-2010:p1491:b001:l038","ordinal":64332,"en":"Let us seize alive!"},{"id":"manas-2010:p1491:b001:l039","ordinal":64333,"en":"Those whose guilt is great,"},{"id":"manas-2010:p1491:b001:l040","ordinal":64334,"en":"Into pits forty cubits deep"},{"id":"manas-2010:p1491:b001:l041","ordinal":64335,"en":"Let us cast for forty years!"},{"id":"manas-2010:p1491:b001:l042","ordinal":64336,"en":"Without killing the Buruts,"},{"id":"manas-2010:p1492:b001:l001","ordinal":64337,"en":"Let us take revenge in this way!"},{"id":"manas-2010:p1492:b001:l002","ordinal":64338,"en":"Let us tread upon their heads,"},{"id":"manas-2010:p1492:b001:l003","ordinal":64339,"en":"Plunder and ruin their possessions,"},{"id":"manas-2010:p1492:b001:l004","ordinal":64340,"en":"Scatter them as far as Mecca!"},{"id":"manas-2010:p1492:b001:l005","ordinal":64341,"en":"Ruin the Buruts, take booty,"},{"id":"manas-2010:p1492:b001:l006","ordinal":64342,"en":"Break their royal camp, open a road,"},{"id":"manas-2010:p1492:b001:l007","ordinal":64343,"en":"Take many beautiful girls!"},{"id":"manas-2010:p1492:b001:l008","ordinal":64344,"en":"If they fall into our hands, the Buruts'"},{"id":"manas-2010:p1492:b001:l009","ordinal":64345,"en":"Uppity unruly men,"},{"id":"manas-2010:p1492:b001:l010","ordinal":64346,"en":"Let us gouge out their eyes!"},{"id":"manas-2010:p1492:b001:l011","ordinal":64347,"en":"All their poor, meek people,"},{"id":"manas-2010:p1492:b001:l012","ordinal":64348,"en":"Let us seize without killing;"},{"id":"manas-2010:p1492:b001:l013","ordinal":64349,"en":"‘Pay tribute for forty years!’"},{"id":"manas-2010:p1492:b001:l014","ordinal":64350,"en":"Let us torment them with that demand!”"},{"id":"manas-2010:p1492:b001:l015","ordinal":64351,"en":"Thus Kongurbay"},{"id":"manas-2010:p1492:b001:l016","ordinal":64352,"en":"Set forth many schemes."},{"id":"manas-2010:p1492:b001:l017","ordinal":64353,"en":"When they heard such words,"},{"id":"manas-2010:p1492:b001:l018","ordinal":64354,"en":"The emperor's Great Beijing"},{"id":"manas-2010:p1492:b001:l019","ordinal":64355,"en":"Gathered courage and thundered;"},{"id":"manas-2010:p1492:b001:l020","ordinal":64356,"en":"All swept forward with a roar."},{"id":"manas-2010:p1492:b001:l021","ordinal":64357,"en":"Roused to courage, rushing,"},{"id":"manas-2010:p1492:b001:l022","ordinal":64358,"en":"As though to sweep upon and devour them,"},{"id":"manas-2010:p1492:b001:l023","ordinal":64359,"en":"Upon the little band of Buruts"},{"id":"manas-2010:p1492:b001:l024","ordinal":64360,"en":"Death seemed to come before its appointed hour."},{"id":"manas-2010:p1492:b001:l025","ordinal":64361,"en":"Almambet and Chubak's valor"},{"id":"manas-2010:p1492:b001:l026","ordinal":64362,"en":"Had no equal in the world."},{"id":"manas-2010:p1492:b001:l027","ordinal":64363,"en":"But he who would enter like a lion,"},{"id":"manas-2010:p1492:b001:l028","ordinal":64364,"en":"Magnanimous Manas, was not here."},{"id":"manas-2010:p1492:b001:l029","ordinal":64365,"en":"They had no support to lean upon;"},{"id":"manas-2010:p1492:b001:l030","ordinal":64366,"en":"Their lion, champion Manas, was absent."},{"id":"manas-2010:p1492:b001:l031","ordinal":64367,"en":"It was a cruel day of distress."},{"id":"manas-2010:p1492:b001:l032","ordinal":64368,"en":"When they saw the Chinese array,"},{"id":"manas-2010:p1492:b001:l033","ordinal":64369,"en":"They drew their horses' reins;"},{"id":"manas-2010:p1492:b001:l034","ordinal":64370,"en":"The Muslims, their resources spent,"},{"id":"manas-2010:p1492:b001:l035","ordinal":64371,"en":"“We are dead!” they said, making last bequests."},{"id":"manas-2010:p1492:b001:l036","ordinal":64372,"en":"“Seen today, gone tomorrow:"},{"id":"manas-2010:p1492:b001:l037","ordinal":64373,"en":"Such is this wayward world!"},{"id":"manas-2010:p1492:b001:l038","ordinal":64374,"en":"When seven wolves attack one creature,"},{"id":"manas-2010:p1492:b001:l039","ordinal":64375,"en":"Will they leave its carcass?"},{"id":"manas-2010:p1492:b001:l040","ordinal":64376,"en":"They have truly swept upon us;"},{"id":"manas-2010:p1492:b001:l041","ordinal":64377,"en":"Will they spare our fly-like lives?"},{"id":"manas-2010:p1492:b001:l042","ordinal":64378,"en":"Pitch-black night has fallen.”"},{"id":"manas-2010:p1493:b001:l001","ordinal":64379,"en":"The Buruts' courage has fled;"},{"id":"manas-2010:p1493:b001:l002","ordinal":64380,"en":"A day of sorrow has fallen upon them."},{"id":"manas-2010:p1493:b001:l003","ordinal":64381,"en":"While the Buruts stood trembling,"},{"id":"manas-2010:p1493:b001:l004","ordinal":64382,"en":"He who never rested on his elbow,"},{"id":"manas-2010:p1493:b001:l005","ordinal":64383,"en":"Who never took a moment's sleep,"},{"id":"manas-2010:p1493:b001:l006","ordinal":64384,"en":"Who never relaxed his stern gaze,"},{"id":"manas-2010:p1493:b001:l007","ordinal":64385,"en":"Who never withdrew what he had extended,"},{"id":"manas-2010:p1493:b001:l008","ordinal":64386,"en":"His sword resting against its sheath,"},{"id":"manas-2010:p1493:b001:l009","ordinal":64387,"en":"Who, when meeting a mighty enemy,"},{"id":"manas-2010:p1493:b001:l010","ordinal":64388,"en":"Drenched him in scarlet blood,"},{"id":"manas-2010:p1493:b001:l011","ordinal":64389,"en":"Who girded his waist in earnest,"},{"id":"manas-2010:p1493:b001:l012","ordinal":64390,"en":"Who, even against an army thick as flies,"},{"id":"manas-2010:p1493:b001:l013","ordinal":64391,"en":"Entered alone and attacked:"},{"id":"manas-2010:p1493:b001:l014","ordinal":64392,"en":"The brim of the black felt hat—"},{"id":"manas-2010:p1493:b001:l015","ordinal":64393,"en":"Have you heard of him,"},{"id":"manas-2010:p1493:b001:l016","ordinal":64394,"en":"Khan Manas's Syrgak,"},{"id":"manas-2010:p1493:b001:l017","ordinal":64395,"en":"To the grieving host of troops,"},{"id":"manas-2010:p1493:b001:l018","ordinal":64396,"en":"The darling who gave courage."},{"id":"manas-2010:p1493:b001:l019","ordinal":64397,"en":"“Look at yourselves, you Muslim multitude!"},{"id":"manas-2010:p1493:b001:l020","ordinal":64398,"en":"Are there any people like you?"},{"id":"manas-2010:p1493:b001:l021","ordinal":64399,"en":"Can one prosper who calls you men?"},{"id":"manas-2010:p1493:b001:l022","ordinal":64400,"en":"The decree God has written,"},{"id":"manas-2010:p1493:b001:l023","ordinal":64401,"en":"Sooner or later you will meet."},{"id":"manas-2010:p1493:b001:l024","ordinal":64402,"en":"Even if you flee to Talas,"},{"id":"manas-2010:p1493:b001:l025","ordinal":64403,"en":"When your appointed death comes, you will die!"},{"id":"manas-2010:p1493:b001:l026","ordinal":64404,"en":"Will one whose time has come not die?"},{"id":"manas-2010:p1493:b001:l027","ordinal":64405,"en":"If he does not die, will he not live his days?"},{"id":"manas-2010:p1493:b001:l028","ordinal":64406,"en":"Fleeing, driven from behind,"},{"id":"manas-2010:p1493:b001:l029","ordinal":64407,"en":"Chased like dogs by the enemy,"},{"id":"manas-2010:p1493:b001:l030","ordinal":64408,"en":"Slaughtered before our appointed death:"},{"id":"manas-2010:p1493:b001:l031","ordinal":64409,"en":"Can we behave in such a way?"},{"id":"manas-2010:p1493:b001:l032","ordinal":64410,"en":"Stand by me, Muslims!"},{"id":"manas-2010:p1493:b001:l033","ordinal":64411,"en":"Let me smash their Great Beijing"},{"id":"manas-2010:p1493:b001:l034","ordinal":64412,"en":"And drive them toward Karykan!"},{"id":"manas-2010:p1493:b001:l035","ordinal":64413,"en":"Laying the Chinese out stiff,"},{"id":"manas-2010:p1493:b001:l036","ordinal":64414,"en":"Let me slaughter them without exception!"},{"id":"manas-2010:p1493:b001:l037","ordinal":64415,"en":"Your shamelessness has no equal!"},{"id":"manas-2010:p1493:b001:l038","ordinal":64416,"en":"When they mass and sweep upon you,"},{"id":"manas-2010:p1493:b001:l039","ordinal":64417,"en":"To say, ‘I shall get away now,’"},{"id":"manas-2010:p1493:b001:l040","ordinal":64418,"en":"Your great Manas is not here!”"},{"id":"manas-2010:p1493:b001:l041","ordinal":64419,"en":"Taking courage, clashing,"},{"id":"manas-2010:p1493:b001:l042","ordinal":64420,"en":"The multitude swept into battle."},{"id":"manas-2010:p1494:b001:l001","ordinal":64421,"en":"Against the massed Chinese and Manzhuu"},{"id":"manas-2010:p1494:b001:l002","ordinal":64422,"en":"They entered battle again."},{"id":"manas-2010:p1494:b001:l003","ordinal":64423,"en":"Akbaltay's Chubak"},{"id":"manas-2010:p1494:b001:l004","ordinal":64424,"en":"And Azizkhan's Almambet"},{"id":"manas-2010:p1494:b001:l005","ordinal":64425,"en":"Roared into the field."},{"id":"manas-2010:p1494:b001:l006","ordinal":64426,"en":"Amid the hazy dust,"},{"id":"manas-2010:p1494:b001:l007","ordinal":64427,"en":"With the countless massed army,"},{"id":"manas-2010:p1494:b001:l008","ordinal":64428,"en":"Setting blood against blood,"},{"id":"manas-2010:p1494:b001:l009","ordinal":64429,"en":"All stood without fleeing."},{"id":"manas-2010:p1494:b001:l010","ordinal":64430,"en":"Chinese and Muslims"},{"id":"manas-2010:p1494:b001:l011","ordinal":64431,"en":"Stood upright, face to face,"},{"id":"manas-2010:p1494:b001:l012","ordinal":64432,"en":"Made blood flow on the battlefield,"},{"id":"manas-2010:p1494:b001:l013","ordinal":64433,"en":"Stepped over corpses like stones."},{"id":"manas-2010:p1494:b001:l014","ordinal":64434,"en":"Against that vast throng of infidels,"},{"id":"manas-2010:p1494:b001:l015","ordinal":64435,"en":"They stood fighting without fleeing."},{"id":"manas-2010:p1494:b001:l016","ordinal":64436,"en":"All the splendid steeds reared;"},{"id":"manas-2010:p1494:b001:l017","ordinal":64437,"en":"The lances, not a handspan left,"},{"id":"manas-2010:p1494:b001:l018","ordinal":64438,"en":"Shattered into fragments."},{"id":"manas-2010:p1494:b001:l019","ordinal":64439,"en":"Shot-proof armor was torn,"},{"id":"manas-2010:p1494:b001:l020","ordinal":64440,"en":"Blood flowed, pouring like water."},{"id":"manas-2010:p1494:b001:l021","ordinal":64441,"en":"Infidels and Muslims"},{"id":"manas-2010:p1494:b001:l022","ordinal":64442,"en":"Divided into separate groups."},{"id":"manas-2010:p1494:b001:l023","ordinal":64443,"en":"Not entering battle, arranging formations,"},{"id":"manas-2010:p1494:b001:l024","ordinal":64444,"en":"Separating out his true heroes,"},{"id":"manas-2010:p1494:b001:l025","ordinal":64445,"en":"Alöökö's Kongurbay"},{"id":"manas-2010:p1494:b001:l026","ordinal":64446,"en":"Was keeping to the side."},{"id":"manas-2010:p1494:b001:l027","ordinal":64447,"en":"Raging without pause,"},{"id":"manas-2010:p1494:b001:l028","ordinal":64448,"en":"Driving all his champions,"},{"id":"manas-2010:p1494:b001:l029","ordinal":64449,"en":"Kongurbay herded them in."},{"id":"manas-2010:p1494:b001:l030","ordinal":64450,"en":"His cowards who turned back,"},{"id":"manas-2010:p1494:b001:l031","ordinal":64451,"en":"Chasing them with cracking blows,"},{"id":"manas-2010:p1494:b001:l032","ordinal":64452,"en":"Kongurbay beat forward."},{"id":"manas-2010:p1494:b001:l033","ordinal":64453,"en":"He set his finest men apart;"},{"id":"manas-2010:p1494:b001:l034","ordinal":64454,"en":"His champions nimble on horseback,"},{"id":"manas-2010:p1494:b001:l035","ordinal":64455,"en":"Those he placed in a separate group."},{"id":"manas-2010:p1494:b001:l036","ordinal":64456,"en":"Furious and preparing,"},{"id":"manas-2010:p1494:b001:l037","ordinal":64457,"en":"His voice drove lives away."},{"id":"manas-2010:p1494:b001:l038","ordinal":64458,"en":"When Kongurbay roused their courage,"},{"id":"manas-2010:p1494:b001:l039","ordinal":64459,"en":"Without looking around,"},{"id":"manas-2010:p1494:b001:l040","ordinal":64460,"en":"As though they would trample everything,"},{"id":"manas-2010:p1494:b001:l041","ordinal":64461,"en":"Not sparing their lives at all,"},{"id":"manas-2010:p1494:b001:l042","ordinal":64462,"en":"The Chinese came sweeping upon them:"},{"id":"manas-2010:p1495:b001:l001","ordinal":64463,"en":"The leopard-heroes saw them now."},{"id":"manas-2010:p1495:b001:l002","ordinal":64464,"en":"That outstanding Syrgak,"},{"id":"manas-2010:p1495:b001:l003","ordinal":64465,"en":"If you looked at his valor,"},{"id":"manas-2010:p1495:b001:l004","ordinal":64466,"en":"Was different from all mankind."},{"id":"manas-2010:p1495:b001:l005","ordinal":64467,"en":"He was twenty-one years old,"},{"id":"manas-2010:p1495:b001:l006","ordinal":64468,"en":"At the age to fear no enemy."},{"id":"manas-2010:p1495:b001:l007","ordinal":64469,"en":"Kökchebich, shaped like a roe deer,"},{"id":"manas-2010:p1495:b001:l008","ordinal":64470,"en":"Bounded and sprang;"},{"id":"manas-2010:p1495:b001:l009","ordinal":64471,"en":"Heading straight for Kongurbay,"},{"id":"manas-2010:p1495:b001:l010","ordinal":64472,"en":"The fearless man began to charge."},{"id":"manas-2010:p1495:b001:l011","ordinal":64473,"en":"Those who came close,"},{"id":"manas-2010:p1495:b001:l012","ordinal":64474,"en":"He swept away with his sword;"},{"id":"manas-2010:p1495:b001:l013","ordinal":64475,"en":"The Chinese farther off,"},{"id":"manas-2010:p1495:b001:l014","ordinal":64476,"en":"He felled with his lance."},{"id":"manas-2010:p1495:b001:l015","ordinal":64477,"en":"Like a mountain collapsing,"},{"id":"manas-2010:p1495:b001:l016","ordinal":64478,"en":"Shattering those he encountered,"},{"id":"manas-2010:p1495:b001:l017","ordinal":64479,"en":"Brave Syrgak went slaughtering."},{"id":"manas-2010:p1495:b001:l018","ordinal":64480,"en":"Making the Chinese crawl,"},{"id":"manas-2010:p1495:b001:l019","ordinal":64481,"en":"Those who could split an eyeball with a shot,"},{"id":"manas-2010:p1495:b001:l020","ordinal":64482,"en":"All their marksmen,"},{"id":"manas-2010:p1495:b001:l021","ordinal":64483,"en":"When Syrgak came near,"},{"id":"manas-2010:p1495:b001:l022","ordinal":64484,"en":"Drew bows and sent a rain of arrows;"},{"id":"manas-2010:p1495:b001:l023","ordinal":64485,"en":"Upon brave Syrgak,"},{"id":"manas-2010:p1495:b001:l024","ordinal":64486,"en":"They shot, pouring arrows like hail."},{"id":"manas-2010:p1495:b001:l025","ordinal":64487,"en":"“If death comes, I shall die;"},{"id":"manas-2010:p1495:b001:l026","ordinal":64488,"en":"To the lion-champion Syrgak"},{"id":"manas-2010:p1495:b001:l027","ordinal":64489,"en":"I shall give support!”"},{"id":"manas-2010:p1495:b001:l028","ordinal":64490,"en":"Almambet, that precious keen warrior,"},{"id":"manas-2010:p1495:b001:l029","ordinal":64491,"en":"Charged in behind him."},{"id":"manas-2010:p1495:b001:l030","ordinal":64492,"en":"Akbaltay's Chubak,"},{"id":"manas-2010:p1495:b001:l031","ordinal":64493,"en":"Surging with Kögala,"},{"id":"manas-2010:p1495:b001:l032","ordinal":64494,"en":"Stretching like a lion,"},{"id":"manas-2010:p1495:b001:l033","ordinal":64495,"en":"Also entered battle."},{"id":"manas-2010:p1495:b001:l034","ordinal":64496,"en":"When thought finished, they sprang up anew,"},{"id":"manas-2010:p1495:b001:l035","ordinal":64497,"en":"Growing stronger from their roots:"},{"id":"manas-2010:p1495:b001:l036","ordinal":64498,"en":"The endless Chinese multitude."},{"id":"manas-2010:p1495:b001:l037","ordinal":64499,"en":"His shout splitting stones,"},{"id":"manas-2010:p1495:b001:l038","ordinal":64500,"en":"When Chubak entered without restraint,"},{"id":"manas-2010:p1495:b001:l039","ordinal":64501,"en":"Alöökö's Kongurbay"},{"id":"manas-2010:p1495:b001:l040","ordinal":64502,"en":"Gave his champion orders:"},{"id":"manas-2010:p1495:b001:l041","ordinal":64503,"en":"“Six thousand of the Dagger-Hands,"},{"id":"manas-2010:p1495:b001:l042","ordinal":64504,"en":"Sweep upon Chubak!"},{"id":"manas-2010:p1496:b001:l001","ordinal":64505,"en":"That rash Burut,"},{"id":"manas-2010:p1496:b001:l002","ordinal":64506,"en":"Now put an end to him!”"},{"id":"manas-2010:p1496:b001:l003","ordinal":64507,"en":"Heedless of pits and mounds,"},{"id":"manas-2010:p1496:b001:l004","ordinal":64508,"en":"Not reckoning death or doom,"},{"id":"manas-2010:p1496:b001:l005","ordinal":64509,"en":"He fought without restraint."},{"id":"manas-2010:p1496:b001:l006","ordinal":64510,"en":"Sending his horse Kögala racing,"},{"id":"manas-2010:p1496:b001:l007","ordinal":64511,"en":"The Dagger-Hands who came before him,"},{"id":"manas-2010:p1496:b001:l008","ordinal":64512,"en":"Your lion went slaughtering,"}]
