[{"id":"seytek-2012:p0515:b003:l020","ordinal":333057,"en":"He scowled in fury,"},{"id":"seytek-2012:p0515:b003:l021","ordinal":333058,"en":"And buckled on his gray girdle."},{"id":"seytek-2012:p0515:b003:l022","ordinal":333059,"en":"He arranged and fastened his weapons;"},{"id":"seytek-2012:p0515:b003:l023","ordinal":333060,"en":"When his rage made him bristle,"},{"id":"seytek-2012:p0515:b003:l024","ordinal":333061,"en":"Wrath transformed his face."},{"id":"seytek-2012:p0515:b003:l025","ordinal":333062,"en":"He surveyed the broad plain,"},{"id":"seytek-2012:p0515:b003:l026","ordinal":333063,"en":"And braced his spirit, saying, “I trust in fate.”"},{"id":"seytek-2012:p0515:b003:l027","ordinal":333064,"en":"He seized his black-handled whip,"},{"id":"seytek-2012:p0515:b003:l028","ordinal":333065,"en":"Swung it around,"},{"id":"seytek-2012:p0515:b003:l029","ordinal":333066,"en":"And Surkaiyk, a steed like none but a spirit—"},{"id":"seytek-2012:p0515:b003:l030","ordinal":333067,"en":"Support of his life held in trust,"},{"id":"seytek-2012:p0515:b003:l031","ordinal":333068,"en":"Pearl among all flowing-tailed horses,"},{"id":"seytek-2012:p0515:b003:l032","ordinal":333069,"en":"Foal of the spirit-gray mare,"},{"id":"seytek-2012:p0515:b003:l033","ordinal":333070,"en":"Duldul among the horses of Karanda—"},{"id":"seytek-2012:p0515:b003:l034","ordinal":333071,"en":"That dark-bay Surkaiyk,"},{"id":"seytek-2012:p0515:b003:l035","ordinal":333072,"en":"He circled the whip over him"},{"id":"seytek-2012:p0515:b003:l036","ordinal":333073,"en":"And struck it against his flank."},{"id":"seytek-2012:p0515:b003:l037","ordinal":333074,"en":"He made the rugged ground quake,"},{"id":"seytek-2012:p0515:b003:l038","ordinal":333075,"en":"Galloping onward upon Surkaiyk."},{"id":"seytek-2012:p0515:b003:l039","ordinal":333076,"en":"Külchoro rode out to single combat"},{"id":"seytek-2012:p0515:b003:l040","ordinal":333077,"en":"Upon the fiery Surkaiyk."},{"id":"seytek-2012:p0516:b002:l001","ordinal":333078,"en":"Külchoro, upheld by the spirits,"},{"id":"seytek-2012:p0516:b002:l002","ordinal":333079,"en":"Was tall and broad-shouldered,"},{"id":"seytek-2012:p0516:b002:l003","ordinal":333080,"en":"Both champion and lion,"},{"id":"seytek-2012:p0516:b002:l004","ordinal":333081,"en":"A seasoned hero who knew"},{"id":"seytek-2012:p0516:b002:l005","ordinal":333082,"en":"The enemy’s ways exceedingly well."},{"id":"seytek-2012:p0516:b002:l006","ordinal":333083,"en":"He struck Kulansur once upon the flank,"},{"id":"seytek-2012:p0516:b002:l007","ordinal":333084,"en":"Took up his fine steel spear,"},{"id":"seytek-2012:p0516:b002:l008","ordinal":333085,"en":"And rode straight toward Sarybai."},{"id":"seytek-2012:p0516:b002:l009","ordinal":333086,"en":"Against brave Sarybai"},{"id":"seytek-2012:p0516:b002:l010","ordinal":333087,"en":"He charged alone:"},{"id":"seytek-2012:p0516:b002:l011","ordinal":333088,"en":"“Sarybai, son of the monster,"},{"id":"seytek-2012:p0516:b002:l012","ordinal":333089,"en":"If you are brave Sarybai,"},{"id":"seytek-2012:p0516:b002:l013","ordinal":333090,"en":"And I am brave Külchoro,"},{"id":"seytek-2012:p0516:b002:l014","ordinal":333091,"en":"Let us face each other with leveled spears"},{"id":"seytek-2012:p0516:b002:l015","ordinal":333092,"en":"And meet in single combat;"},{"id":"seytek-2012:p0516:b002:l016","ordinal":333093,"en":"If death comes, let us die!"},{"id":"seytek-2012:p0516:b002:l017","ordinal":333094,"en":"Let us stand face-to-face,"},{"id":"seytek-2012:p0516:b002:l018","ordinal":333095,"en":"Fight without sparing our lives,"},{"id":"seytek-2012:p0516:b002:l019","ordinal":333096,"en":"And bring this to its final end."},{"id":"seytek-2012:p0516:b002:l020","ordinal":333097,"en":"Let our spears begin their work;"},{"id":"seytek-2012:p0516:b002:l021","ordinal":333098,"en":"Let turmoil seize the earth"},{"id":"seytek-2012:p0516:b002:l022","ordinal":333099,"en":"Until it crumbles beneath us."},{"id":"seytek-2012:p0516:b002:l023","ordinal":333100,"en":"If I am the son of Almambet"},{"id":"seytek-2012:p0516:b002:l024","ordinal":333101,"en":"And you the monster’s son,"},{"id":"seytek-2012:p0516:b002:l025","ordinal":333102,"en":"Let me hear your vaunted fury!"},{"id":"seytek-2012:p0516:b002:l026","ordinal":333103,"en":"Though born of a monster,"},{"id":"seytek-2012:p0516:b002:l027","ordinal":333104,"en":"Even if you possessed seven thousand lives,"},{"id":"seytek-2012:p0516:b002:l028","ordinal":333105,"en":"I would kill and bury you in the earth!"},{"id":"seytek-2012:p0516:b002:l029","ordinal":333106,"en":"I shall spread slaughter to your farthest bounds,"},{"id":"seytek-2012:p0516:b002:l030","ordinal":333107,"en":"Leaving not one of you,"},{"id":"seytek-2012:p0516:b002:l031","ordinal":333108,"en":"But putting you all to the sword."},{"id":"seytek-2012:p0516:b002:l032","ordinal":333109,"en":"Let me hear of your courage!"},{"id":"seytek-2012:p0516:b002:l033","ordinal":333110,"en":"Though we fight for months and years,"},{"id":"seytek-2012:p0516:b002:l034","ordinal":333111,"en":"I shall kill and bury you in the earth!"},{"id":"seytek-2012:p0516:b002:l035","ordinal":333112,"en":"I shall trample your encampment"},{"id":"seytek-2012:p0516:b002:l036","ordinal":333113,"en":"And sweep away your champions."},{"id":"seytek-2012:p0516:b002:l037","ordinal":333114,"en":"Without sparing my dark life,"},{"id":"seytek-2012:p0516:b002:l038","ordinal":333115,"en":"I shall pour out my fiercest wrath."},{"id":"seytek-2012:p0516:b002:l039","ordinal":333116,"en":"You infidel, son of the monster,"},{"id":"seytek-2012:p0516:b002:l040","ordinal":333117,"en":"I shall tear apart your ribs!”"},{"id":"seytek-2012:p0516:b003:l001","ordinal":333118,"en":"Toward the lone marauder of deadly venom,"},{"id":"seytek-2012:p0516:b003:l002","ordinal":333119,"en":"Toward the giant Sarybai,"},{"id":"seytek-2012:p0516:b003:l003","ordinal":333120,"en":"Toward death itself,"},{"id":"seytek-2012:p0516:b003:l004","ordinal":333121,"en":"Toward the true devourer’s eye,"},{"id":"seytek-2012:p0516:b003:l005","ordinal":333122,"en":"He pressed on to test himself."},{"id":"seytek-2012:p0516:b003:l006","ordinal":333123,"en":"Along the stony ridge,"},{"id":"seytek-2012:p0516:b003:l007","ordinal":333124,"en":"The tireless lone wolf arrived"},{"id":"seytek-2012:p0516:b003:l008","ordinal":333125,"en":"At the place where they would crush each other."},{"id":"seytek-2012:p0516:b003:l009","ordinal":333126,"en":"At the white ravine of the reedy slope,"},{"id":"seytek-2012:p0516:b003:l010","ordinal":333127,"en":"They faced each other on the battlefield."},{"id":"seytek-2012:p0516:b003:l011","ordinal":333128,"en":"Cutting a road through the army,"},{"id":"seytek-2012:p0516:b003:l012","ordinal":333129,"en":"Külchoro, upheld by the spirits,"},{"id":"seytek-2012:p0516:b003:l013","ordinal":333130,"en":"Assailed Sarybai."},{"id":"seytek-2012:p0516:b003:l014","ordinal":333131,"en":"From this nearer side,"},{"id":"seytek-2012:p0516:b003:l015","ordinal":333132,"en":"At the champions’ outer edge,"},{"id":"seytek-2012:p0516:b003:l016","ordinal":333133,"en":"He tightened his well-fitted belt"},{"id":"seytek-2012:p0516:b003:l017","ordinal":333134,"en":"And charged straight in."},{"id":"seytek-2012:p0516:b003:l018","ordinal":333135,"en":"Spearing all he encountered,"},{"id":"seytek-2012:p0516:b003:l019","ordinal":333136,"en":"He sought everywhere"},{"id":"seytek-2012:p0516:b003:l020","ordinal":333137,"en":"For Sarybai, the monster’s son."},{"id":"seytek-2012:p0516:b003:l021","ordinal":333138,"en":"Such was his lion-hearted valor:"},{"id":"seytek-2012:p0516:b003:l022","ordinal":333139,"en":"Those within reach of his spear"},{"id":"seytek-2012:p0516:b003:l023","ordinal":333140,"en":"He struck down with his spear;"},{"id":"seytek-2012:p0516:b003:l024","ordinal":333141,"en":"Those within reach of his battle-axe"},{"id":"seytek-2012:p0516:b003:l025","ordinal":333142,"en":"He hacked and felled;"},{"id":"seytek-2012:p0516:b003:l026","ordinal":333143,"en":"Those who pressed hard upon his sword"},{"id":"seytek-2012:p0516:b003:l027","ordinal":333144,"en":"He hewed down;"},{"id":"seytek-2012:p0516:b003:l028","ordinal":333145,"en":"Those who came before him"},{"id":"seytek-2012:p0516:b003:l029","ordinal":333146,"en":"He laid waste and struck aside."},{"id":"seytek-2012:p0516:b003:l030","ordinal":333147,"en":"The sky was clear, but the earth grew dark;"},{"id":"seytek-2012:p0516:b003:l031","ordinal":333148,"en":"The ground churned as night descended."},{"id":"seytek-2012:p0516:b003:l032","ordinal":333149,"en":"The armies on either side"},{"id":"seytek-2012:p0516:b003:l033","ordinal":333150,"en":"Mingled together."},{"id":"seytek-2012:p0516:b003:l034","ordinal":333151,"en":"They fought amid battle cries—"},{"id":"seytek-2012:p0516:b003:l035","ordinal":333152,"en":"Who had ever seen such a struggle?"},{"id":"seytek-2012:p0516:b003:l036","ordinal":333153,"en":"The fainthearted withdrew,"},{"id":"seytek-2012:p0516:b003:l037","ordinal":333154,"en":"While every champion confronted the foe."},{"id":"seytek-2012:p0516:b003:l038","ordinal":333155,"en":"Spears shattered and straps fell,"},{"id":"seytek-2012:p0516:b003:l039","ordinal":333156,"en":"Horses fell as though mountains collapsed;"},{"id":"seytek-2012:p0516:b003:l040","ordinal":333157,"en":"A merciless battle raged."},{"id":"seytek-2012:p0517:b002:l001","ordinal":333158,"en":"Pouring out his wrath, he bristled,"},{"id":"seytek-2012:p0517:b002:l002","ordinal":333159,"en":"I have long awaited our clash."},{"id":"seytek-2012:p0517:b002:l003","ordinal":333160,"en":"Now that my mortal enemy,"},{"id":"seytek-2012:p0517:b002:l004","ordinal":333161,"en":"Who would tear out lungs and seize gall, has come,"},{"id":"seytek-2012:p0517:b002:l005","ordinal":333162,"en":"How could I spare my life!"},{"id":"seytek-2012:p0517:b002:l006","ordinal":333163,"en":"Ever since I became Külchoro,"},{"id":"seytek-2012:p0517:b002:l007","ordinal":333164,"en":"I have subdued the whole world,"},{"id":"seytek-2012:p0517:b002:l008","ordinal":333165,"en":"Driving, slaughtering, and despoiling it."},{"id":"seytek-2012:p0517:b002:l009","ordinal":333166,"en":"I donned armor no bullet could pierce,"},{"id":"seytek-2012:p0517:b002:l010","ordinal":333167,"en":"I slaughtered a thousand men like you;"},{"id":"seytek-2012:p0517:b002:l011","ordinal":333168,"en":"Where, then, is my death?!"},{"id":"seytek-2012:p0517:b002:l012","ordinal":333169,"en":"At last, Sarybai,"},{"id":"seytek-2012:p0517:b002:l013","ordinal":333170,"en":"I have met you in your fury."},{"id":"seytek-2012:p0517:b002:l014","ordinal":333171,"en":"Let us make our combat supreme,"},{"id":"seytek-2012:p0517:b002:l015","ordinal":333172,"en":"Fighting without mercy,"},{"id":"seytek-2012:p0517:b002:l016","ordinal":333173,"en":"Let us cry out and thrust our spears!"},{"id":"seytek-2012:p0517:b002:l017","ordinal":333174,"en":"Let us stake our knuckle-sized heads,"},{"id":"seytek-2012:p0517:b002:l018","ordinal":333175,"en":"And swallow lives as great as mountains,"},{"id":"seytek-2012:p0517:b002:l019","ordinal":333176,"en":"Roaming freely over the pasture,"},{"id":"seytek-2012:p0517:b002:l020","ordinal":333177,"en":"And, when we remember, drain each other's lives."},{"id":"seytek-2012:p0517:b002:l021","ordinal":333178,"en":"Let us test the champions,"},{"id":"seytek-2012:p0517:b002:l022","ordinal":333179,"en":"Let us intensify the strife."},{"id":"seytek-2012:p0517:b002:l023","ordinal":333180,"en":"Let us make our fame manifest,"},{"id":"seytek-2012:p0517:b002:l024","ordinal":333181,"en":"And spread the conflict far."},{"id":"seytek-2012:p0517:b002:l025","ordinal":333182,"en":"You began the campaign and war,"},{"id":"seytek-2012:p0517:b002:l026","ordinal":333183,"en":"In which the people were massacred and died;"},{"id":"seytek-2012:p0517:b002:l027","ordinal":333184,"en":"You have grown fond of such deeds!"},{"id":"seytek-2012:p0517:b002:l028","ordinal":333185,"en":"Now behold valor and heroism,"},{"id":"seytek-2012:p0517:b002:l029","ordinal":333186,"en":"Behold such a feat."},{"id":"seytek-2012:p0517:b002:l030","ordinal":333187,"en":"Let our sovereign souls blaze,"},{"id":"seytek-2012:p0517:b002:l031","ordinal":333188,"en":"Let us rouse all our strength,"},{"id":"seytek-2012:p0517:b002:l032","ordinal":333189,"en":"And wage war once more!"},{"id":"seytek-2012:p0517:b002:l033","ordinal":333190,"en":"Our champions and our khans,"},{"id":"seytek-2012:p0517:b002:l034","ordinal":333191,"en":"As though struck by slaughter,"},{"id":"seytek-2012:p0517:b002:l035","ordinal":333192,"en":"Have all been laid waste."},{"id":"seytek-2012:p0517:b002:l036","ordinal":333193,"en":"Our heroes who boasted of valor—"},{"id":"seytek-2012:p0517:b002:l037","ordinal":333194,"en":"May our mighty backs be broken."},{"id":"seytek-2012:p0517:b002:l038","ordinal":333195,"en":"What are turmoil and strife?"},{"id":"seytek-2012:p0517:b002:l039","ordinal":333196,"en":"If you wish, behold them here!”"},{"id":"seytek-2012:p0517:b002:l040","ordinal":333197,"en":"So saying, Külchoro continued:"},{"id":"seytek-2012:p0517:b003:l001","ordinal":333198,"en":"“I shall spill your blood like water."},{"id":"seytek-2012:p0517:b003:l002","ordinal":333199,"en":"I shall bring your life to a clean end,"},{"id":"seytek-2012:p0517:b003:l003","ordinal":333200,"en":"Cutting off your head like this,"},{"id":"seytek-2012:p0517:b003:l004","ordinal":333201,"en":"And offer up your young life."},{"id":"seytek-2012:p0517:b003:l005","ordinal":333202,"en":"Sarybai, son of the ogre,"},{"id":"seytek-2012:p0517:b003:l006","ordinal":333203,"en":"Why are you so wildly enraged?"},{"id":"seytek-2012:p0517:b003:l007","ordinal":333204,"en":"Why rage and stir up strife,"},{"id":"seytek-2012:p0517:b003:l008","ordinal":333205,"en":"When we have not carried off your land,"},{"id":"seytek-2012:p0517:b003:l009","ordinal":333206,"en":"Nor scattered your treasure,"},{"id":"seytek-2012:p0517:b003:l010","ordinal":333207,"en":"Nor raised an uproar in war,"},{"id":"seytek-2012:p0517:b003:l011","ordinal":333208,"en":"Nor overrun your teeming people?"},{"id":"seytek-2012:p0517:b003:l012","ordinal":333209,"en":"As though we had drained your beloved,"},{"id":"seytek-2012:p0517:b003:l013","ordinal":333210,"en":"As though we had reaped your grain unripe,"},{"id":"seytek-2012:p0517:b003:l014","ordinal":333211,"en":"As though we had plundered the domains"},{"id":"seytek-2012:p0517:b003:l015","ordinal":333212,"en":"Of seven generations of ogre chieftains!"},{"id":"seytek-2012:p0517:b003:l016","ordinal":333213,"en":"Why do you make trouble,"},{"id":"seytek-2012:p0517:b003:l017","ordinal":333214,"en":"Descendant of warriors and heroes,"},{"id":"seytek-2012:p0517:b003:l018","ordinal":333215,"en":"Why do you stand against us?"},{"id":"seytek-2012:p0517:b003:l019","ordinal":333216,"en":"Is Talas such an easy land"},{"id":"seytek-2012:p0517:b003:l020","ordinal":333217,"en":"That you might slaughter it,"},{"id":"seytek-2012:p0517:b003:l021","ordinal":333218,"en":"Take it as spoil,"},{"id":"seytek-2012:p0517:b003:l022","ordinal":333219,"en":"And dig out its roots before departing?"},{"id":"seytek-2012:p0517:b003:l023","ordinal":333220,"en":"No migration of yours crossed the Seven Valleys,"},{"id":"seytek-2012:p0517:b003:l024","ordinal":333221,"en":"You have no vengeance from seventy forefathers."},{"id":"seytek-2012:p0517:b003:l025","ordinal":333222,"en":"Do you possess the might, Sarybai,"},{"id":"seytek-2012:p0517:b003:l026","ordinal":333223,"en":"To bring utter calamity?"},{"id":"seytek-2012:p0517:b003:l027","ordinal":333224,"en":"Do you have the fury, Sarybai,"},{"id":"seytek-2012:p0517:b003:l028","ordinal":333225,"en":"To fight until one of us is ended?"},{"id":"seytek-2012:p0517:b003:l029","ordinal":333226,"en":"Did we tether mares in your valley,"},{"id":"seytek-2012:p0517:b003:l030","ordinal":333227,"en":"Or settle upon your people’s land?"},{"id":"seytek-2012:p0517:b003:l031","ordinal":333228,"en":"Did we massacre and despoil your village,"},{"id":"seytek-2012:p0517:b003:l032","ordinal":333229,"en":"That you should glower so?"},{"id":"seytek-2012:p0517:b003:l033","ordinal":333230,"en":"Did we slaughter your people,"},{"id":"seytek-2012:p0517:b003:l034","ordinal":333231,"en":"That you should swagger and provoke strife?"},{"id":"seytek-2012:p0517:b003:l035","ordinal":333232,"en":"If you are the hero Sarybai,"},{"id":"seytek-2012:p0517:b003:l036","ordinal":333233,"en":"And I am the hero Külchoro,"},{"id":"seytek-2012:p0517:b003:l037","ordinal":333234,"en":"A hero was the foe I sought;"},{"id":"seytek-2012:p0517:b003:l038","ordinal":333235,"en":"What I asked of God,"},{"id":"seytek-2012:p0517:b003:l039","ordinal":333236,"en":"What I prayed for, was you:"},{"id":"seytek-2012:p0517:b003:l040","ordinal":333237,"en":"‘I knew of your enmity,"},{"id":"seytek-2012:p0518:b002:l001","ordinal":333238,"en":"They advanced with noses running,"},{"id":"seytek-2012:p0518:b002:l002","ordinal":333239,"en":"Their weapons numbering eighty-four,"},{"id":"seytek-2012:p0518:b002:l003","ordinal":333240,"en":"Their onslaught blazing like fire."},{"id":"seytek-2012:p0518:b002:l004","ordinal":333241,"en":"When my father, the Ogre,"},{"id":"seytek-2012:p0518:b002:l005","ordinal":333242,"en":"Saw Manas’s bearing,"},{"id":"seytek-2012:p0518:b002:l006","ordinal":333243,"en":"He found no ridge to flee across,"},{"id":"seytek-2012:p0518:b002:l007","ordinal":333244,"en":"No black earth to enter,"},{"id":"seytek-2012:p0518:b002:l008","ordinal":333245,"en":"No grave in which to lie."},{"id":"seytek-2012:p0518:b002:l009","ordinal":333246,"en":"When eagle Bakai and hero Koshoy"},{"id":"seytek-2012:p0518:b002:l010","ordinal":333247,"en":"Blocked the valley of Kerüüchö"},{"id":"seytek-2012:p0518:b002:l011","ordinal":333248,"en":"Without letting anyone stir,"},{"id":"seytek-2012:p0518:b002:l012","ordinal":333249,"en":"When Almambet wrought havoc,"},{"id":"seytek-2012:p0518:b002:l013","ordinal":333250,"en":"And Chubak and hero Syrgak speared"},{"id":"seytek-2012:p0518:b002:l014","ordinal":333251,"en":"The champions who shot in ranks"},{"id":"seytek-2012:p0518:b002:l015","ordinal":333252,"en":"And plundered my countless wealth,"},{"id":"seytek-2012:p0518:b002:l016","ordinal":333253,"en":"When my father, the Ogre,"},{"id":"seytek-2012:p0518:b002:l017","ordinal":333254,"en":"Was slain by hero Manas,"},{"id":"seytek-2012:p0518:b002:l018","ordinal":333255,"en":"They broke open my treasury and made a road through it,"},{"id":"seytek-2012:p0518:b002:l019","ordinal":333256,"en":"And subdued my warriors,"},{"id":"seytek-2012:p0518:b002:l020","ordinal":333257,"en":"Loading all my heaped-up riches"},{"id":"seytek-2012:p0518:b002:l021","ordinal":333258,"en":"Upon my own elephants."},{"id":"seytek-2012:p0518:b002:l022","ordinal":333259,"en":"They tormented my very soul,"},{"id":"seytek-2012:p0518:b002:l023","ordinal":333260,"en":"And plundered all my livestock."},{"id":"seytek-2012:p0518:b002:l024","ordinal":333261,"en":"They bewildered my people,"},{"id":"seytek-2012:p0518:b002:l025","ordinal":333262,"en":"And bent my back many times."},{"id":"seytek-2012:p0518:b002:l026","ordinal":333263,"en":"They tasted much of my salt,"},{"id":"seytek-2012:p0518:b002:l027","ordinal":333264,"en":"Then plundered and carried away"},{"id":"seytek-2012:p0518:b002:l028","ordinal":333265,"en":"My needle-mouthed, camel-eyed,"},{"id":"seytek-2012:p0518:b002:l029","ordinal":333266,"en":"Restless dark-eyed"},{"id":"seytek-2012:p0518:b002:l030","ordinal":333267,"en":"Daughter, beautiful as this,"},{"id":"seytek-2012:p0518:b002:l031","ordinal":333268,"en":"The strength around which I girded my belt,"},{"id":"seytek-2012:p0518:b002:l032","ordinal":333269,"en":"And my people, diminished sixfold."},{"id":"seytek-2012:p0518:b002:l033","ordinal":333270,"en":"After long ruin I recovered,"},{"id":"seytek-2012:p0518:b002:l034","ordinal":333271,"en":"I grew up while still in swaddling clothes."},{"id":"seytek-2012:p0518:b002:l035","ordinal":333272,"en":"I am a warrior and a hero;"},{"id":"seytek-2012:p0518:b002:l036","ordinal":333273,"en":"I am Sarybai the champion!"},{"id":"seytek-2012:p0518:b002:l037","ordinal":333274,"en":"I crush whoever challenges me,"},{"id":"seytek-2012:p0518:b002:l038","ordinal":333275,"en":"I devour whoever meets me;"},{"id":"seytek-2012:p0518:b002:l039","ordinal":333276,"en":"I am the black scourge itself!”"},{"id":"seytek-2012:p0518:b002:l040","ordinal":333277,"en":"Skilled in the ways of war,"},{"id":"seytek-2012:p0518:b003:l001","ordinal":333278,"en":"Külchoro said this to Sarybai,"},{"id":"seytek-2012:p0518:b003:l002","ordinal":333279,"en":"And fierce fury seized him."},{"id":"seytek-2012:p0518:b003:l003","ordinal":333280,"en":"He ground apart"},{"id":"seytek-2012:p0518:b003:l004","ordinal":333281,"en":"His broad, gate-like front teeth;"},{"id":"seytek-2012:p0518:b003:l005","ordinal":333282,"en":"His eyes became burning embers,"},{"id":"seytek-2012:p0518:b003:l006","ordinal":333283,"en":"His lashes blazing fire."},{"id":"seytek-2012:p0518:b003:l007","ordinal":333284,"en":"The warrior could not restrain"},{"id":"seytek-2012:p0518:b003:l008","ordinal":333285,"en":"His surge, like a rushing river:"},{"id":"seytek-2012:p0518:b003:l009","ordinal":333286,"en":"Sarybai was ready to fight."},{"id":"seytek-2012:p0518:b003:l010","ordinal":333287,"en":"Would a gray wolf hold back?"},{"id":"seytek-2012:p0518:b003:l011","ordinal":333288,"en":"After Külchoro spoke thus,"},{"id":"seytek-2012:p0518:b003:l012","ordinal":333289,"en":"The Ogre’s son answered,"},{"id":"seytek-2012:p0518:b003:l013","ordinal":333290,"en":"Utterly dreadful words:"},{"id":"seytek-2012:p0518:b003:l014","ordinal":333291,"en":"“If I do not slaughter your whole lineage,"},{"id":"seytek-2012:p0518:b003:l015","ordinal":333292,"en":"If I do not do all the harm I know,"},{"id":"seytek-2012:p0518:b003:l016","ordinal":333293,"en":"If I heed your words when you plead,"},{"id":"seytek-2012:p0518:b003:l017","ordinal":333294,"en":"If I fail to avenge myself,"},{"id":"seytek-2012:p0518:b003:l018","ordinal":333295,"en":"May I die unworthy of the name Sarybai;"},{"id":"seytek-2012:p0518:b003:l019","ordinal":333296,"en":"May I sink into the depths unborn,"},{"id":"seytek-2012:p0518:b003:l020","ordinal":333297,"en":"As though never born of the Ogre!"},{"id":"seytek-2012:p0518:b003:l021","ordinal":333298,"en":"I have many words to tell,"},{"id":"seytek-2012:p0518:b003:l022","ordinal":333299,"en":"And if you consider the horses wearied and lives tormented,"},{"id":"seytek-2012:p0518:b003:l023","ordinal":333300,"en":"You will see how great my grievance is."},{"id":"seytek-2012:p0518:b003:l024","ordinal":333301,"en":"In Zhelpinish lived Jarmanas,"},{"id":"seytek-2012:p0518:b003:l025","ordinal":333302,"en":"Whose wife was Karjygach;"},{"id":"seytek-2012:p0518:b003:l026","ordinal":333303,"en":"She and Khan Manas were siblings."},{"id":"seytek-2012:p0518:b003:l027","ordinal":333304,"en":"They camped along the cliffs,"},{"id":"seytek-2012:p0518:b003:l028","ordinal":333305,"en":"And, coming to Karjygach’s aid,"},{"id":"seytek-2012:p0518:b003:l029","ordinal":333306,"en":"Gathered an army from the Kyrgyz."},{"id":"seytek-2012:p0518:b003:l030","ordinal":333307,"en":"The noble Bakai and hero Koshoy"},{"id":"seytek-2012:p0518:b003:l031","ordinal":333308,"en":"Led an army such as this,"},{"id":"seytek-2012:p0518:b003:l032","ordinal":333309,"en":"Loosing arrows in punishment,"},{"id":"seytek-2012:p0518:b003:l033","ordinal":333310,"en":"Hiding by night and not marching by day."},{"id":"seytek-2012:p0518:b003:l034","ordinal":333311,"en":"They were warriors of many kinds,"},{"id":"seytek-2012:p0518:b003:l035","ordinal":333312,"en":"Great Manas at the army’s head,"}]
