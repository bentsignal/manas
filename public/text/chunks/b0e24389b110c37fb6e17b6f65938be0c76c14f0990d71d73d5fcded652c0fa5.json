[{"id":"semetey-1-2013:p1250:b004:l011","ordinal":172545,"en":"Tölök and Tölöbay"},{"id":"semetey-1-2013:p1250:b004:l012","ordinal":172546,"en":"Were behind the lower army."},{"id":"semetey-1-2013:p1250:b004:l013","ordinal":172547,"en":"Kalcha and Kadyrbay"},{"id":"semetey-1-2013:p1250:b004:l014","ordinal":172548,"en":"Were at the army's qibla-side flank."},{"id":"semetey-1-2013:p1250:b004:l015","ordinal":172549,"en":"Wearing a black supa coat,"},{"id":"semetey-1-2013:p1250:b004:l016","ordinal":172550,"en":"Riding a black noble horse,"},{"id":"semetey-1-2013:p1250:b004:l017","ordinal":172551,"en":"Dear Kozho was at the flank."},{"id":"semetey-1-2013:p1250:b004:l018","ordinal":172552,"en":"Along the bank road of Kum-Kyya,"},{"id":"semetey-1-2013:p1250:b004:l019","ordinal":172553,"en":"They came forth in splendor;"},{"id":"semetey-1-2013:p1250:b004:l020","ordinal":172554,"en":"Behind raging Kozho,"},{"id":"semetey-1-2013:p1250:b004:l021","ordinal":172555,"en":"He drove them onward."},{"id":"semetey-1-2013:p1250:b004:l022","ordinal":172556,"en":"From beside Tash-Kyya,"},{"id":"semetey-1-2013:p1250:b004:l023","ordinal":172557,"en":"Most of them came forth;"},{"id":"semetey-1-2013:p1250:b004:l024","ordinal":172558,"en":"Along the bank road of Kum-Kyya,"},{"id":"semetey-1-2013:p1250:b004:l025","ordinal":172559,"en":"Half of them came forth."},{"id":"semetey-1-2013:p1250:b004:l026","ordinal":172560,"en":"Their great banner floated;"},{"id":"semetey-1-2013:p1250:b004:l027","ordinal":172561,"en":"The brass horn's voice clattered."},{"id":"semetey-1-2013:p1250:b004:l028","ordinal":172562,"en":"Sword points swayed;"},{"id":"semetey-1-2013:p1250:b004:l029","ordinal":172563,"en":"Spear tips flashed."},{"id":"semetey-1-2013:p1250:b004:l030","ordinal":172564,"en":"Their drums boomed."},{"id":"semetey-1-2013:p1250:b004:l031","ordinal":172565,"en":"Shouting to the great host, “Advance!”"},{"id":"semetey-1-2013:p1250:b004:l032","ordinal":172566,"en":"Hero Toltoy thundered."},{"id":"semetey-1-2013:p1250:b004:l033","ordinal":172567,"en":"Gun barrels appeared,"},{"id":"semetey-1-2013:p1250:b004:l034","ordinal":172568,"en":"Men's minds were shaken;"},{"id":"semetey-1-2013:p1250:b004:l035","ordinal":172569,"en":"As though gone mad, the Jediger"},{"id":"semetey-1-2013:p1250:b004:l036","ordinal":172570,"en":"Came forth clamoring."},{"id":"semetey-1-2013:p1250:b004:l037","ordinal":172571,"en":"Their surging people roared,"},{"id":"semetey-1-2013:p1250:b004:l038","ordinal":172572,"en":"Crying Toltoy's battle cry."},{"id":"semetey-1-2013:p1250:b004:l039","ordinal":172573,"en":"The people stirred and shouted,"},{"id":"semetey-1-2013:p1251:b003:l001","ordinal":172574,"en":"They raised the battle cry of \"Kojo!\""},{"id":"semetey-1-2013:p1251:b003:l002","ordinal":172575,"en":"The Zhediger striking from above"},{"id":"semetey-1-2013:p1251:b003:l003","ordinal":172576,"en":"Made the lower side roar,"},{"id":"semetey-1-2013:p1251:b003:l004","ordinal":172577,"en":"Raising the cry of \"Tölök!\""},{"id":"semetey-1-2013:p1251:b003:l005","ordinal":172578,"en":"Their flanks shouted,"},{"id":"semetey-1-2013:p1251:b003:l006","ordinal":172579,"en":"Raising the cry of \"Kalcha!\""},{"id":"semetey-1-2013:p1251:b003:l007","ordinal":172580,"en":"An agitated army was coming,"},{"id":"semetey-1-2013:p1251:b003:l008","ordinal":172581,"en":"Coming in multitudes to act."},{"id":"semetey-1-2013:p1251:b003:l009","ordinal":172582,"en":"A dug trench was coming,"},{"id":"semetey-1-2013:p1251:b003:l010","ordinal":172583,"en":"A great, seething affliction was coming."},{"id":"semetey-1-2013:p1251:b003:l011","ordinal":172584,"en":"An engulfing army was coming;"},{"id":"semetey-1-2013:p1251:b003:l012","ordinal":172585,"en":"Upon those who watched,"},{"id":"semetey-1-2013:p1251:b003:l013","ordinal":172586,"en":"A mighty upheaval descended."},{"id":"semetey-1-2013:p1251:b003:l014","ordinal":172587,"en":"Many made ready without pause,"},{"id":"semetey-1-2013:p1251:b003:l015","ordinal":172588,"en":"Spurring forward, saying,"},{"id":"semetey-1-2013:p1251:b003:l016","ordinal":172589,"en":"\"We entrust ourselves to the fight.\""},{"id":"semetey-1-2013:p1251:b003:l017","ordinal":172590,"en":"Many lamented, saying,"},{"id":"semetey-1-2013:p1251:b003:l018","ordinal":172591,"en":"\"If we bring this upheaval and war"},{"id":"semetey-1-2013:p1251:b003:l019","ordinal":172592,"en":"And die in it,"},{"id":"semetey-1-2013:p1251:b003:l020","ordinal":172593,"en":"What will become of our poor wives"},{"id":"semetey-1-2013:p1251:b003:l021","ordinal":172594,"en":"And young children?\""},{"id":"semetey-1-2013:p1251:b003:l022","ordinal":172595,"en":"Many lost their wits in panic"},{"id":"semetey-1-2013:p1251:b003:l023","ordinal":172596,"en":"And rushed about."},{"id":"semetey-1-2013:p1251:b003:l024","ordinal":172597,"en":"Many fled, saying,"},{"id":"semetey-1-2013:p1251:b003:l025","ordinal":172598,"en":"\"If we die there,"},{"id":"semetey-1-2013:p1251:b003:l026","ordinal":172599,"en":"What will become of a lone wife"},{"id":"semetey-1-2013:p1251:b003:l027","ordinal":172600,"en":"And a single child?\""},{"id":"semetey-1-2013:p1251:b003:l028","ordinal":172601,"en":"Many, trapped in the midst"},{"id":"semetey-1-2013:p1251:b003:l029","ordinal":172602,"en":"As though God would take them,"},{"id":"semetey-1-2013:p1251:b003:l030","ordinal":172603,"en":"Were subjected to plunder."},{"id":"semetey-1-2013:p1251:b003:l031","ordinal":172604,"en":"Many, saying they would turn back,"},{"id":"semetey-1-2013:p1251:b003:l032","ordinal":172605,"en":"Met the guards"},{"id":"semetey-1-2013:p1251:b003:l033","ordinal":172606,"en":"And were beaten."},{"id":"semetey-1-2013:p1251:b003:l034","ordinal":172607,"en":"The spearmen arrived;"},{"id":"semetey-1-2013:p1251:b003:l035","ordinal":172608,"en":"When their khans drove them forward,"},{"id":"semetey-1-2013:p1251:b003:l036","ordinal":172609,"en":"The great Black Zhediger"},{"id":"semetey-1-2013:p1251:b003:l037","ordinal":172610,"en":"Set out in a rabble."},{"id":"semetey-1-2013:p1251:b003:l038","ordinal":172611,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1251:b003:l039","ordinal":172612,"en":"Kojo, vigorous in his deeds,"},{"id":"semetey-1-2013:p1251:b005:l001","ordinal":172613,"en":"Shouted in anger"},{"id":"semetey-1-2013:p1251:b005:l002","ordinal":172614,"en":"And summoned the Zhediger."},{"id":"semetey-1-2013:p1251:b005:l003","ordinal":172615,"en":"He grew excited like a cuckoo;"},{"id":"semetey-1-2013:p1251:b005:l004","ordinal":172616,"en":"At his flank hero Toltoi"},{"id":"semetey-1-2013:p1251:b005:l005","ordinal":172617,"en":"Spoke to the Zhediger:"},{"id":"semetey-1-2013:p1251:b005:l006","ordinal":172618,"en":"\"Great Black Zhediger,"},{"id":"semetey-1-2013:p1251:b005:l007","ordinal":172619,"en":"Do not turn back and flee;"},{"id":"semetey-1-2013:p1251:b005:l008","ordinal":172620,"en":"Move steadily in your ranks,"},{"id":"semetey-1-2013:p1251:b005:l009","ordinal":172621,"en":"My Zhediger, do not hurry."},{"id":"semetey-1-2013:p1251:b005:l010","ordinal":172622,"en":"Let us surge in shouting"},{"id":"semetey-1-2013:p1251:b005:l011","ordinal":172623,"en":"And unleash a general battle;"},{"id":"semetey-1-2013:p1251:b005:l012","ordinal":172624,"en":"Let us bind the champions"},{"id":"semetey-1-2013:p1251:b005:l013","ordinal":172625,"en":"Of the Afghans who refused the girl."},{"id":"semetey-1-2013:p1251:b005:l014","ordinal":172626,"en":"If the lordly Afghans"},{"id":"semetey-1-2013:p1251:b005:l015","ordinal":172627,"en":"Will not give the old maid,"},{"id":"semetey-1-2013:p1251:b005:l016","ordinal":172628,"en":"Let us bind their prince."},{"id":"semetey-1-2013:p1251:b005:l017","ordinal":172629,"en":"Let us dig a well in their place of honor"},{"id":"semetey-1-2013:p1251:b005:l018","ordinal":172630,"en":"And scatter their four kinds of livestock."},{"id":"semetey-1-2013:p1251:b005:l019","ordinal":172631,"en":"These Afghans have gone mad,"},{"id":"semetey-1-2013:p1251:b005:l020","ordinal":172632,"en":"As though they had raised a champion;"},{"id":"semetey-1-2013:p1251:b005:l021","ordinal":172633,"en":"Let us plunder their goods"},{"id":"semetey-1-2013:p1251:b005:l022","ordinal":172634,"en":"And wreak destruction together."},{"id":"semetey-1-2013:p1251:b005:l023","ordinal":172635,"en":"Let us seize and slaughter their khans"},{"id":"semetey-1-2013:p1251:b005:l024","ordinal":172636,"en":"And gouge out their people's eyes."},{"id":"semetey-1-2013:p1251:b005:l025","ordinal":172637,"en":"If they will not give the old maid,"},{"id":"semetey-1-2013:p1251:b005:l026","ordinal":172638,"en":"Let us cover their plain with smoke,"},{"id":"semetey-1-2013:p1251:b005:l027","ordinal":172639,"en":"Raid everything without remainder,"},{"id":"semetey-1-2013:p1251:b005:l028","ordinal":172640,"en":"Turn water into their gardens"},{"id":"semetey-1-2013:p1251:b005:l029","ordinal":172641,"en":"And make them into vegetable plots."},{"id":"semetey-1-2013:p1251:b005:l030","ordinal":172642,"en":"Turn water onto their poplars"},{"id":"semetey-1-2013:p1251:b005:l031","ordinal":172643,"en":"And leave them staggering."},{"id":"semetey-1-2013:p1251:b005:l032","ordinal":172644,"en":"Let us bind old Akun"},{"id":"semetey-1-2013:p1251:b005:l033","ordinal":172645,"en":"And make him a slave."},{"id":"semetey-1-2013:p1251:b005:l034","ordinal":172646,"en":"Let us make Azhibai and Tümönbai"},{"id":"semetey-1-2013:p1251:b005:l035","ordinal":172647,"en":"Our herdsmen;"},{"id":"semetey-1-2013:p1251:b005:l036","ordinal":172648,"en":"Let us level their straight-built city"},{"id":"semetey-1-2013:p1251:b005:l037","ordinal":172649,"en":"And raid it without leaving a thing."},{"id":"semetey-1-2013:p1251:b005:l038","ordinal":172650,"en":"They have chosen war;"},{"id":"semetey-1-2013:p1251:b005:l039","ordinal":172651,"en":"Let us engage in strife."},{"id":"semetey-1-2013:p1252:b003:l001","ordinal":172652,"en":"Let us come out in single combat,"},{"id":"semetey-1-2013:p1252:b003:l002","ordinal":172653,"en":"Fight for seven days without pause,"},{"id":"semetey-1-2013:p1252:b003:l003","ordinal":172654,"en":"And let those whose death has come die;"},{"id":"semetey-1-2013:p1252:b003:l004","ordinal":172655,"en":"When what Allah has written"},{"id":"semetey-1-2013:p1252:b003:l005","ordinal":172656,"en":"Descends upon our heads, let us meet it."},{"id":"semetey-1-2013:p1252:b003:l006","ordinal":172657,"en":"Let us exhaust one another,"},{"id":"semetey-1-2013:p1252:b003:l007","ordinal":172658,"en":"Test one another's mettle,"},{"id":"semetey-1-2013:p1252:b003:l008","ordinal":172659,"en":"And make the contest splendid."},{"id":"semetey-1-2013:p1252:b003:l009","ordinal":172660,"en":"Not only the maiden Chürök—"},{"id":"semetey-1-2013:p1252:b003:l010","ordinal":172661,"en":"Let us seize all the beauties"},{"id":"semetey-1-2013:p1252:b003:l011","ordinal":172662,"en":"Of the accursed Afghans who lag behind the migration,"},{"id":"semetey-1-2013:p1252:b003:l012","ordinal":172663,"en":"Their sable caps turned back!\""},{"id":"semetey-1-2013:p1252:b003:l013","ordinal":172664,"en":"Toltoi roused himself thus,"},{"id":"semetey-1-2013:p1252:b003:l014","ordinal":172665,"en":"And Chynkojo spoke:"},{"id":"semetey-1-2013:p1252:b003:l015","ordinal":172666,"en":"\"You have lords, you have a khan,"},{"id":"semetey-1-2013:p1252:b003:l016","ordinal":172667,"en":"And all this multitude of people."},{"id":"semetey-1-2013:p1252:b003:l017","ordinal":172668,"en":"Let us wage relentless war"},{"id":"semetey-1-2013:p1252:b003:l018","ordinal":172669,"en":"Against the Afghans whose villages are whole."},{"id":"semetey-1-2013:p1252:b003:l019","ordinal":172670,"en":"Do not lose your wits,"},{"id":"semetey-1-2013:p1252:b003:l020","ordinal":172671,"en":"O Zhediger, do not flee,\""},{"id":"semetey-1-2013:p1252:b003:l021","ordinal":172672,"en":"Chynkojo said, driving them in."},{"id":"semetey-1-2013:p1252:b003:l022","ordinal":172673,"en":"He divided off the bowmen,"},{"id":"semetey-1-2013:p1252:b003:l023","ordinal":172674,"en":"Divided off the strong,"},{"id":"semetey-1-2013:p1252:b003:l024","ordinal":172675,"en":"Divided off the wise,"},{"id":"semetey-1-2013:p1252:b003:l025","ordinal":172676,"en":"And divided off the foolish;"},{"id":"semetey-1-2013:p1252:b003:l026","ordinal":172677,"en":"Thus Chynkojo arranged them."},{"id":"semetey-1-2013:p1252:b003:l027","ordinal":172678,"en":"They came wave after wave in multitudes,"},{"id":"semetey-1-2013:p1252:b003:l028","ordinal":172679,"en":"An army covering the earth,"},{"id":"semetey-1-2013:p1252:b003:l029","ordinal":172680,"en":"Their banners bending to the ground,"},{"id":"semetey-1-2013:p1252:b003:l030","ordinal":172681,"en":"Shouting until the earth resounded,"},{"id":"semetey-1-2013:p1252:b003:l031","ordinal":172682,"en":"Raising the cry of \"Zhediger!\""},{"id":"semetey-1-2013:p1252:b003:l032","ordinal":172683,"en":"Those whose swords were keenest,"},{"id":"semetey-1-2013:p1252:b003:l033","ordinal":172684,"en":"Whose spears had steel points,"},{"id":"semetey-1-2013:p1252:b003:l034","ordinal":172685,"en":"Heroes who struck with battle-axes,"},{"id":"semetey-1-2013:p1252:b003:l035","ordinal":172686,"en":"His heroes who struck with battle-axes,"},{"id":"semetey-1-2013:p1252:b003:l036","ordinal":172687,"en":"His warriors who drew bows,"},{"id":"semetey-1-2013:p1252:b003:l037","ordinal":172688,"en":"He made all surge forward together;"},{"id":"semetey-1-2013:p1252:b003:l038","ordinal":172689,"en":"Thus had Chynkojo arranged them."},{"id":"semetey-1-2013:p1252:b003:l039","ordinal":172690,"en":"He ordered the Zhediger"},{"id":"semetey-1-2013:p1252:b004:l001","ordinal":172691,"en":"And divided them into seven;"},{"id":"semetey-1-2013:p1252:b004:l002","ordinal":172692,"en":"With these he came ringing"},{"id":"semetey-1-2013:p1252:b004:l003","ordinal":172693,"en":"And wholly engulfed the land."},{"id":"semetey-1-2013:p1252:b004:l004","ordinal":172694,"en":"When Khan Akun's sentry"},{"id":"semetey-1-2013:p1252:b004:l005","ordinal":172695,"en":"Took a lamp and looked,"},{"id":"semetey-1-2013:p1252:b004:l006","ordinal":172696,"en":"Along the shore-road of Kum-Kyya"},{"id":"semetey-1-2013:p1252:b004:l007","ordinal":172697,"en":"They came spreading into view."},{"id":"semetey-1-2013:p1252:b004:l008","ordinal":172698,"en":"One could not tell them from worms,"},{"id":"semetey-1-2013:p1252:b004:l009","ordinal":172699,"en":"So thickly they came seething."},{"id":"semetey-1-2013:p1252:b004:l010","ordinal":172700,"en":"Along the side of Tash-Kyya,"},{"id":"semetey-1-2013:p1252:b004:l011","ordinal":172701,"en":"Most of them came into view;"},{"id":"semetey-1-2013:p1252:b004:l012","ordinal":172702,"en":"At the embankment of the shore-road,"},{"id":"semetey-1-2013:p1252:b004:l013","ordinal":172703,"en":"Half of them came into view."},{"id":"semetey-1-2013:p1252:b004:l014","ordinal":172704,"en":"Along the shore-road, moving softly,"},{"id":"semetey-1-2013:p1252:b004:l015","ordinal":172705,"en":"Most of them came into view."},{"id":"semetey-1-2013:p1252:b004:l016","ordinal":172706,"en":"Look at the reeds, look at the flood;"},{"id":"semetey-1-2013:p1252:b004:l017","ordinal":172707,"en":"Look at the people who will engulf them,"},{"id":"semetey-1-2013:p1252:b004:l018","ordinal":172708,"en":"Raising a cry and unleashing upheaval."},{"id":"semetey-1-2013:p1252:b004:l019","ordinal":172709,"en":"Look at the great host engulfing them,"},{"id":"semetey-1-2013:p1252:b004:l020","ordinal":172710,"en":"Raising its customary cry."},{"id":"semetey-1-2013:p1252:b004:l021","ordinal":172711,"en":"Look at the trench being dug;"},{"id":"semetey-1-2013:p1252:b004:l022","ordinal":172712,"en":"Look at the army coming engulfing them,"},{"id":"semetey-1-2013:p1252:b004:l023","ordinal":172713,"en":"Shrieking like crows."},{"id":"semetey-1-2013:p1252:b004:l024","ordinal":172714,"en":"Seeing them, the sentry"},{"id":"semetey-1-2013:p1252:b004:l025","ordinal":172715,"en":"Beat the doolbas."},{"id":"semetey-1-2013:p1252:b004:l026","ordinal":172716,"en":"The tower-mounted doolbas"},{"id":"semetey-1-2013:p1252:b004:l027","ordinal":172717,"en":"Was beaten hard,"},{"id":"semetey-1-2013:p1252:b004:l028","ordinal":172718,"en":"And Khan Akun's many soldiers"},{"id":"semetey-1-2013:p1252:b004:l029","ordinal":172719,"en":"Now rose and gathered."},{"id":"semetey-1-2013:p1252:b004:l030","ordinal":172720,"en":"They readied their coursers"},{"id":"semetey-1-2013:p1252:b004:l031","ordinal":172721,"en":"And tethered their swift steeds;"},{"id":"semetey-1-2013:p1252:b004:l032","ordinal":172722,"en":"Their unsheathed swords swayed."},{"id":"semetey-1-2013:p1252:b004:l033","ordinal":172723,"en":"The Afghans were formidable,"},{"id":"semetey-1-2013:p1252:b004:l034","ordinal":172724,"en":"And drew together in a body."},{"id":"semetey-1-2013:p1252:b004:l035","ordinal":172725,"en":"They had made a trough from pinewood;"},{"id":"semetey-1-2013:p1252:b004:l036","ordinal":172726,"en":"How many heroes had earlier"},{"id":"semetey-1-2013:p1252:b004:l037","ordinal":172727,"en":"Demanded of Akun,"},{"id":"semetey-1-2013:p1252:b004:l038","ordinal":172728,"en":"\"Give us your old maid.\""},{"id":"semetey-1-2013:p1252:b004:l039","ordinal":172729,"en":"Even then Almighty Allah"},{"id":"semetey-1-2013:p1253:b003:l001","ordinal":172730,"en":"Had kept his dear head safe."},{"id":"semetey-1-2013:p1253:b003:l002","ordinal":172731,"en":"All the khans made ready;"},{"id":"semetey-1-2013:p1253:b003:l003","ordinal":172732,"en":"All the warriors"},{"id":"semetey-1-2013:p1253:b003:l004","ordinal":172733,"en":"Readied sword and gun"},{"id":"semetey-1-2013:p1253:b003:l005","ordinal":172734,"en":"And prepared every weapon."},{"id":"semetey-1-2013:p1253:b003:l006","ordinal":172735,"en":"Their hearts were overcome,"},{"id":"semetey-1-2013:p1253:b003:l007","ordinal":172736,"en":"And they looked ravenous."},{"id":"semetey-1-2013:p1253:b003:l008","ordinal":172737,"en":"Their champions put on iron"},{"id":"semetey-1-2013:p1253:b003:l009","ordinal":172738,"en":"And marched in a line."},{"id":"semetey-1-2013:p1253:b003:l010","ordinal":172739,"en":"The Afghans' great army,"},{"id":"semetey-1-2013:p1253:b003:l011","ordinal":172740,"en":"Wrapping turbans about their waists,"},{"id":"semetey-1-2013:p1253:b003:l012","ordinal":172741,"en":"Made ready in frenzy."},{"id":"semetey-1-2013:p1253:b003:l013","ordinal":172742,"en":"With blue caps perched high"},{"id":"semetey-1-2013:p1253:b003:l014","ordinal":172743,"en":"And argamaks holding their heads proud,"},{"id":"semetey-1-2013:p1253:b003:l015","ordinal":172744,"en":"They wrapped broad sashes around themselves,"},{"id":"semetey-1-2013:p1253:b003:l016","ordinal":172745,"en":"Prayed to the Almighty,"},{"id":"semetey-1-2013:p1253:b003:l017","ordinal":172746,"en":"And made ready at the word \"enemy,\""},{"id":"semetey-1-2013:p1253:b003:l018","ordinal":172747,"en":"Preparing in utter commotion."},{"id":"semetey-1-2013:p1253:b003:l019","ordinal":172748,"en":"Tümönbai, son of Tülkü,"},{"id":"semetey-1-2013:p1253:b003:l020","ordinal":172749,"en":"Prepared his various troops."},{"id":"semetey-1-2013:p1253:b003:l021","ordinal":172750,"en":"Azhibai, son of Azhy,"},{"id":"semetey-1-2013:p1253:b003:l022","ordinal":172751,"en":"Did not fail to make ready either."},{"id":"semetey-1-2013:p1253:b003:l023","ordinal":172752,"en":"Army struck against army;"},{"id":"semetey-1-2013:p1253:b003:l024","ordinal":172753,"en":"Refusing to leave their people ungathered,"},{"id":"semetey-1-2013:p1253:b003:l025","ordinal":172754,"en":"Those advanced in years,"},{"id":"semetey-1-2013:p1253:b003:l026","ordinal":172755,"en":"Between fifty and sixty,"},{"id":"semetey-1-2013:p1253:b003:l027","ordinal":172756,"en":"Went into the middle ground."},{"id":"semetey-1-2013:p1253:b003:l028","ordinal":172757,"en":"There were khojas in white turbans"},{"id":"semetey-1-2013:p1253:b003:l029","ordinal":172758,"en":"As large as cauldrons,"},{"id":"semetey-1-2013:p1253:b003:l030","ordinal":172759,"en":"Whose shouts rang like the azan;"},{"id":"semetey-1-2013:p1253:b003:l031","ordinal":172760,"en":"There were mullahs in mottled robes."},{"id":"semetey-1-2013:p1253:b003:l032","ordinal":172761,"en":"Khoja and mullah took command,"},{"id":"semetey-1-2013:p1253:b003:l033","ordinal":172762,"en":"Gathering all their people together."},{"id":"semetey-1-2013:p1253:b003:l034","ordinal":172763,"en":"Khan Akun formed one division,"},{"id":"semetey-1-2013:p1253:b003:l035","ordinal":172764,"en":"And he too came out prepared,"},{"id":"semetey-1-2013:p1253:b003:l036","ordinal":172765,"en":"Taking troops of every age."},{"id":"semetey-1-2013:p1253:b003:l037","ordinal":172766,"en":"Tümönbai's force formed one division,"},{"id":"semetey-1-2013:p1253:b003:l038","ordinal":172767,"en":"Driving a vast, great army,"},{"id":"semetey-1-2013:p1253:b003:l039","ordinal":172768,"en":"Bringing forward in numbers"},{"id":"semetey-1-2013:p1253:b004:l001","ordinal":172769,"en":"The lions of the many Afghans."},{"id":"semetey-1-2013:p1253:b004:l002","ordinal":172770,"en":"Azhibai's force formed one division."},{"id":"semetey-1-2013:p1253:b004:l003","ordinal":172771,"en":"Their dust struck the sky;"},{"id":"semetey-1-2013:p1253:b004:l004","ordinal":172772,"en":"When the Zhediger engulfed them,"},{"id":"semetey-1-2013:p1253:b004:l005","ordinal":172773,"en":"The Afghan people gathered."},{"id":"semetey-1-2013:p1253:b004:l006","ordinal":172774,"en":"The black road seethed with dust,"},{"id":"semetey-1-2013:p1253:b004:l007","ordinal":172775,"en":"And people's heads reeled."},{"id":"semetey-1-2013:p1253:b004:l008","ordinal":172776,"en":"Many among the Afghan common folk,"},{"id":"semetey-1-2013:p1253:b004:l009","ordinal":172777,"en":"Like unbroken horses,"},{"id":"semetey-1-2013:p1253:b004:l010","ordinal":172778,"en":"Bucked about up and down."},{"id":"semetey-1-2013:p1253:b004:l011","ordinal":172779,"en":"Many went weeping, saying,"},{"id":"semetey-1-2013:p1253:b004:l012","ordinal":172780,"en":"\"Poor wives and young children"},{"id":"semetey-1-2013:p1253:b004:l013","ordinal":172781,"en":"Will all be killed.\""},{"id":"semetey-1-2013:p1253:b004:l014","ordinal":172782,"en":"Many trampled about, saying,"},{"id":"semetey-1-2013:p1253:b004:l015","ordinal":172783,"en":"\"These are people who have seen hell.\""},{"id":"semetey-1-2013:p1253:b004:l016","ordinal":172784,"en":"Many reviled Chürök,"},{"id":"semetey-1-2013:p1253:b004:l017","ordinal":172785,"en":"Saying, \"May hellish Chürök come to no good.\""},{"id":"semetey-1-2013:p1253:b004:l018","ordinal":172786,"en":"Many pondered Asan Kaigy-like grief,"},{"id":"semetey-1-2013:p1253:b004:l019","ordinal":172787,"en":"Thinking, \"Now we have been slaughtered,\""},{"id":"semetey-1-2013:p1253:b004:l020","ordinal":172788,"en":"And rushed about."},{"id":"semetey-1-2013:p1253:b004:l021","ordinal":172789,"en":"Despite their panic,"},{"id":"semetey-1-2013:p1253:b004:l022","ordinal":172790,"en":"They gathered them from the city,"},{"id":"semetey-1-2013:p1253:b004:l023","ordinal":172791,"en":"Good and bad mixed together,"},{"id":"semetey-1-2013:p1253:b004:l024","ordinal":172792,"en":"And assembled them all."},{"id":"semetey-1-2013:p1253:b004:l025","ordinal":172793,"en":"Khan Akun's gatekeeper,"},{"id":"semetey-1-2013:p1253:b004:l026","ordinal":172794,"en":"And the keeper under the gatekeeper,"},{"id":"semetey-1-2013:p1253:b004:l027","ordinal":172795,"en":"All mounted without exception."},{"id":"semetey-1-2013:p1253:b004:l028","ordinal":172796,"en":"The patrolmen and guards"},{"id":"semetey-1-2013:p1253:b004:l029","ordinal":172797,"en":"Also mounted without exception."},{"id":"semetey-1-2013:p1253:b004:l030","ordinal":172798,"en":"Thundering warriors"},{"id":"semetey-1-2013:p1253:b004:l031","ordinal":172799,"en":"And roaring heroes"},{"id":"semetey-1-2013:p1253:b004:l032","ordinal":172800,"en":"Mounted, not one remaining."}]
