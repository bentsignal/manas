[{"id":"manas-2010:p1543:b001:l039","ordinal":66561,"en":"They drove and pressed them back."},{"id":"manas-2010:p1543:b001:l040","ordinal":66562,"en":"Where they waged their campaign,"},{"id":"manas-2010:p1543:b001:l041","ordinal":66563,"en":"Where they clashed fiercely,"},{"id":"manas-2010:p1543:b001:l042","ordinal":66564,"en":"Was the place called It-Ölbös,"},{"id":"manas-2010:p1544:b001:l001","ordinal":66565,"en":"A journey of forty days;"},{"id":"manas-2010:p1544:b001:l002","ordinal":66566,"en":"When a swan flew, its tail,"},{"id":"manas-2010:p1544:b001:l003","ordinal":66567,"en":"When a wild ass walked, its hooves,"},{"id":"manas-2010:p1544:b001:l004","ordinal":66568,"en":"Would be utterly burned in that land."},{"id":"manas-2010:p1544:b001:l005","ordinal":66569,"en":"Not a pinch of grass to eat,"},{"id":"manas-2010:p1544:b001:l006","ordinal":66570,"en":"Not a drop of water to splash,"},{"id":"manas-2010:p1544:b001:l007","ordinal":66571,"en":"When they reached that desert,"},{"id":"manas-2010:p1544:b001:l008","ordinal":66572,"en":"Kongurbay gathered courage;"},{"id":"manas-2010:p1544:b001:l009","ordinal":66573,"en":"The grim-faced khan came out before them;"},{"id":"manas-2010:p1544:b001:l010","ordinal":66574,"en":"At his voice, souls fled their bodies."},{"id":"manas-2010:p1544:b001:l011","ordinal":66575,"en":"Ay Jangjung and Kün Jangjung,"},{"id":"manas-2010:p1544:b001:l012","ordinal":66576,"en":"As comrades to the grim-faced one,"},{"id":"manas-2010:p1544:b001:l013","ordinal":66577,"en":"Had joined him in their fury."},{"id":"manas-2010:p1544:b001:l014","ordinal":66578,"en":"Kongurbay, Alöökö's son,"},{"id":"manas-2010:p1544:b001:l015","ordinal":66579,"en":"Charged without wavering;"},{"id":"manas-2010:p1544:b001:l016","ordinal":66580,"en":"Six thousand Chinese, a thousand governors,"},{"id":"manas-2010:p1544:b001:l017","ordinal":66581,"en":"Their outstanding one, Kongurbay,"},{"id":"manas-2010:p1544:b001:l018","ordinal":66582,"en":"He too came surging up."},{"id":"manas-2010:p1544:b001:l019","ordinal":66583,"en":"From the flank, Ay Jangjung,"},{"id":"manas-2010:p1544:b001:l020","ordinal":66584,"en":"With so many troops of soldiers,"},{"id":"manas-2010:p1544:b001:l021","ordinal":66585,"en":"He too swept upon them."},{"id":"manas-2010:p1544:b001:l022","ordinal":66586,"en":"Wind issuing from his mouth,"},{"id":"manas-2010:p1544:b001:l023","ordinal":66587,"en":"Fire pouring from his eyes,"},{"id":"manas-2010:p1544:b001:l024","ordinal":66588,"en":"Bringing many, many warriors,"},{"id":"manas-2010:p1544:b001:l025","ordinal":66589,"en":"Kün Jangjung entered thundering."},{"id":"manas-2010:p1544:b001:l026","ordinal":66590,"en":"The multitude of Chinese enclosed them like iron"},{"id":"manas-2010:p1544:b001:l027","ordinal":66591,"en":"And took them into their midst."},{"id":"manas-2010:p1544:b001:l028","ordinal":66592,"en":"Spearpoints clashed;"},{"id":"manas-2010:p1544:b001:l029","ordinal":66593,"en":"Human heads struck together;"},{"id":"manas-2010:p1544:b001:l030","ordinal":66594,"en":"Sword met sword;"},{"id":"manas-2010:p1544:b001:l031","ordinal":66595,"en":"They charged against one another;"},{"id":"manas-2010:p1544:b001:l032","ordinal":66596,"en":"Such a campaign now unfolded."},{"id":"manas-2010:p1544:b001:l033","ordinal":66597,"en":"Kongurbay, Alöökö's son,"},{"id":"manas-2010:p1544:b001:l034","ordinal":66598,"en":"Striking Algara with his whip,"},{"id":"manas-2010:p1544:b001:l035","ordinal":66599,"en":"Came charging at Chubak."},{"id":"manas-2010:p1544:b001:l036","ordinal":66600,"en":"When he was about to reach him at full charge,"},{"id":"manas-2010:p1544:b001:l037","ordinal":66601,"en":"From atop Kögala,"},{"id":"manas-2010:p1544:b001:l038","ordinal":66602,"en":"When he was about to knock him down in passing,"},{"id":"manas-2010:p1544:b001:l039","ordinal":66603,"en":"Almambet saw it."},{"id":"manas-2010:p1544:b001:l040","ordinal":66604,"en":"Sarala beneath him,"},{"id":"manas-2010:p1544:b001:l041","ordinal":66605,"en":"He spurred on one side, then the other,"},{"id":"manas-2010:p1544:b001:l042","ordinal":66606,"en":"Striking with his whip right and left."},{"id":"manas-2010:p1545:b001:l001","ordinal":66607,"en":"Then your Alma caught up;"},{"id":"manas-2010:p1545:b001:l002","ordinal":66608,"en":"At the edge of the hemp belt,"},{"id":"manas-2010:p1545:b001:l003","ordinal":66609,"en":"He struck as he passed."},{"id":"manas-2010:p1545:b001:l004","ordinal":66610,"en":"As the grim-faced one toppled,"},{"id":"manas-2010:p1545:b001:l005","ordinal":66611,"en":"The forty lords beside him"},{"id":"manas-2010:p1545:b001:l006","ordinal":66612,"en":"Supported him and fled."},{"id":"manas-2010:p1545:b001:l007","ordinal":66613,"en":"With a shout, Ay Jangjung"},{"id":"manas-2010:p1545:b001:l008","ordinal":66614,"en":"Reached Almambet."},{"id":"manas-2010:p1545:b001:l009","ordinal":66615,"en":"“At the edge of the gray belt,” he said,"},{"id":"manas-2010:p1545:b001:l010","ordinal":66616,"en":"“Below the lungs,” he said,"},{"id":"manas-2010:p1545:b001:l011","ordinal":66617,"en":"And struck as he passed."},{"id":"manas-2010:p1545:b001:l012","ordinal":66618,"en":"Not letting your Alma fall from his horse,"},{"id":"manas-2010:p1545:b001:l013","ordinal":66619,"en":"Chubak, Akbaltay's son,"},{"id":"manas-2010:p1545:b001:l014","ordinal":66620,"en":"Supported him from horseback as he passed."},{"id":"manas-2010:p1545:b001:l015","ordinal":66621,"en":"The support of the black-capped people,"},{"id":"manas-2010:p1545:b001:l016","ordinal":66622,"en":"Khan Manas's Syrgak,"},{"id":"manas-2010:p1545:b001:l017","ordinal":66623,"en":"Smashing seven thousand of them,"},{"id":"manas-2010:p1545:b001:l018","ordinal":66624,"en":"Spearing those he met,"},{"id":"manas-2010:p1545:b001:l019","ordinal":66625,"en":"After Ay Jangjung had speared your Alma,"},{"id":"manas-2010:p1545:b001:l020","ordinal":66626,"en":"Before he could recover his position and ride on,"},{"id":"manas-2010:p1545:b001:l021","ordinal":66627,"en":"That hero Ay Jangjung,"},{"id":"manas-2010:p1545:b001:l022","ordinal":66628,"en":"From atop his gray rhinoceros,"},{"id":"manas-2010:p1545:b001:l023","ordinal":66629,"en":"He knocked down as he passed."},{"id":"manas-2010:p1545:b001:l024","ordinal":66630,"en":"Falling from his mount, limbs dangling,"},{"id":"manas-2010:p1545:b001:l025","ordinal":66631,"en":"His two eyes darting,"},{"id":"manas-2010:p1545:b001:l026","ordinal":66632,"en":"As he was losing consciousness,"},{"id":"manas-2010:p1545:b001:l027","ordinal":66633,"en":"Hero Almambet saw him."},{"id":"manas-2010:p1545:b001:l028","ordinal":66634,"en":"Taking his hungry steel in hand,"},{"id":"manas-2010:p1545:b001:l029","ordinal":66635,"en":"Before your Alma could charge up,"},{"id":"manas-2010:p1545:b001:l030","ordinal":66636,"en":"And that mountain-sized Jangjung’s"},{"id":"manas-2010:p1545:b001:l031","ordinal":66637,"en":"Head could be struck off in passing,"},{"id":"manas-2010:p1545:b001:l032","ordinal":66638,"en":"Kongurbay, Alöökö's son,"},{"id":"manas-2010:p1545:b001:l033","ordinal":66639,"en":"Had reached Ay Jangjung."},{"id":"manas-2010:p1545:b001:l034","ordinal":66640,"en":"Reaching him and mounting him,"},{"id":"manas-2010:p1545:b001:l035","ordinal":66641,"en":"Not letting even the wind touch Jangjung,"},{"id":"manas-2010:p1545:b001:l036","ordinal":66642,"en":"He took him away safely."},{"id":"manas-2010:p1545:b001:l037","ordinal":66643,"en":"Drenched in bloody blood,"},{"id":"manas-2010:p1545:b001:l038","ordinal":66644,"en":"Standing and fighting without fleeing,"},{"id":"manas-2010:p1545:b001:l039","ordinal":66645,"en":"Many, many warriors died;"},{"id":"manas-2010:p1545:b001:l040","ordinal":66646,"en":"Those who remained alive,"},{"id":"manas-2010:p1545:b001:l041","ordinal":66647,"en":"Covered in red blood,"},{"id":"manas-2010:p1545:b001:l042","ordinal":66648,"en":"With dust engulfing their chests,"},{"id":"manas-2010:p1546:b001:l001","ordinal":66649,"en":"Mostly parched with thirst, their strength gone,"},{"id":"manas-2010:p1546:b001:l002","ordinal":66650,"en":"Their steeds exhausted and worn out,"},{"id":"manas-2010:p1546:b001:l003","ordinal":66651,"en":"The warriors' eyes grown dim,"},{"id":"manas-2010:p1546:b001:l004","ordinal":66652,"en":"The Chinese people—may their land be deserted!—"},{"id":"manas-2010:p1546:b001:l005","ordinal":66653,"en":"Came surging in with growing force."},{"id":"manas-2010:p1546:b001:l006","ordinal":66654,"en":"If you saw how they grew stronger,"},{"id":"manas-2010:p1546:b001:l007","ordinal":66655,"en":"A dark ridge rising in steep banks,"},{"id":"manas-2010:p1546:b001:l008","ordinal":66656,"en":"What seemed a dark ridge was a flood."},{"id":"manas-2010:p1546:b001:l009","ordinal":66657,"en":"How many more than before,"},{"id":"manas-2010:p1546:b001:l010","ordinal":66658,"en":"The Chinese people swept upon them."},{"id":"manas-2010:p1546:b001:l011","ordinal":66659,"en":"Not even a winged crow could escape;"},{"id":"manas-2010:p1546:b001:l012","ordinal":66660,"en":"It was their hour of wrath."},{"id":"manas-2010:p1546:b001:l013","ordinal":66661,"en":"Falling into inescapable misery,"},{"id":"manas-2010:p1546:b001:l014","ordinal":66662,"en":"It was the Muslims' hour to grieve."},{"id":"manas-2010:p1546:b001:l015","ordinal":66663,"en":"What is seen today is gone tomorrow;"},{"id":"manas-2010:p1546:b001:l016","ordinal":66664,"en":"Such is this wayward world."},{"id":"manas-2010:p1546:b001:l017","ordinal":66665,"en":"Syrgak remained to bar the way;"},{"id":"manas-2010:p1546:b001:l018","ordinal":66666,"en":"Despairing of their dear lives,"},{"id":"manas-2010:p1546:b001:l019","ordinal":66667,"en":"With Khan Almambet at their head,"},{"id":"manas-2010:p1546:b001:l020","ordinal":66668,"en":"The forty companions fled at a gallop."},{"id":"manas-2010:p1546:b001:l021","ordinal":66669,"en":"Not wearying from exchanging shots,"},{"id":"manas-2010:p1546:b001:l022","ordinal":66670,"en":"Not tiring from striking blows,"},{"id":"manas-2010:p1546:b001:l023","ordinal":66671,"en":"Not sleeping upon an elbow,"},{"id":"manas-2010:p1546:b001:l024","ordinal":66672,"en":"Not resting even for a moment,"},{"id":"manas-2010:p1546:b001:l025","ordinal":66673,"en":"Not letting them cross It-Ölbös,"},{"id":"manas-2010:p1546:b001:l026","ordinal":66674,"en":"Not letting them take a step this way,"},{"id":"manas-2010:p1546:b001:l027","ordinal":66675,"en":"Not reckoning, “I shall die,”"},{"id":"manas-2010:p1546:b001:l028","ordinal":66676,"en":"Thoroughly barring the Chinese,"},{"id":"manas-2010:p1546:b001:l029","ordinal":66677,"en":"He stood for about seven days."},{"id":"manas-2010:p1546:b001:l030","ordinal":66678,"en":"When the sun sank slowly,"},{"id":"manas-2010:p1546:b001:l031","ordinal":66679,"en":"Turning back at a dash,"},{"id":"manas-2010:p1546:b001:l032","ordinal":66680,"en":"Galloping unseen,"},{"id":"manas-2010:p1546:b001:l033","ordinal":66681,"en":"Hero Syrgak drew back."},{"id":"manas-2010:p1546:b001:l034","ordinal":66682,"en":"Kökchebich beneath him,"},{"id":"manas-2010:p1546:b001:l035","ordinal":66683,"en":"At the first “Go!” as he set off,"},{"id":"manas-2010:p1546:b001:l036","ordinal":66684,"en":"Shattered the stones he trod;"},{"id":"manas-2010:p1546:b001:l037","ordinal":66685,"en":"Clods as large as great cauldrons"},{"id":"manas-2010:p1546:b001:l038","ordinal":66686,"en":"Whistled above Syrgak's head."},{"id":"manas-2010:p1546:b001:l039","ordinal":66687,"en":"His bit clattered;"},{"id":"manas-2010:p1546:b001:l040","ordinal":66688,"en":"Kökchebich's flesh grew hot;"},{"id":"manas-2010:p1546:b001:l041","ordinal":66689,"en":"His tail like strands of silk"},{"id":"manas-2010:p1546:b001:l042","ordinal":66690,"en":"Lashed between his hind legs,"},{"id":"manas-2010:p1547:b001:l001","ordinal":66691,"en":"His hooves clattered on the ground,"},{"id":"manas-2010:p1547:b001:l002","ordinal":66692,"en":"The black steel bit"},{"id":"manas-2010:p1547:b001:l003","ordinal":66693,"en":"Clanged within his throat."},{"id":"manas-2010:p1547:b001:l004","ordinal":66694,"en":"When he entered a descent,"},{"id":"manas-2010:p1547:b001:l005","ordinal":66695,"en":"His forelegs planted like a roe deer's;"},{"id":"manas-2010:p1547:b001:l006","ordinal":66696,"en":"When he turned uphill,"},{"id":"manas-2010:p1547:b001:l007","ordinal":66697,"en":"His mane and tail spread wide,"},{"id":"manas-2010:p1547:b001:l008","ordinal":66698,"en":"The earth was flayed and furrowed."},{"id":"manas-2010:p1547:b001:l009","ordinal":66699,"en":"Syrgak, who had been left alone,"},{"id":"manas-2010:p1547:b001:l010","ordinal":66700,"en":"Rejoined the forty companions safe and sound."},{"id":"manas-2010:p1547:b001:l011","ordinal":66701,"en":"When dawn broke bright,"},{"id":"manas-2010:p1547:b001:l012","ordinal":66702,"en":"When light fell upon the earth,"},{"id":"manas-2010:p1547:b001:l013","ordinal":66703,"en":"Tracking their very footprints,"},{"id":"manas-2010:p1547:b001:l014","ordinal":66704,"en":"They pursued relentlessly."},{"id":"manas-2010:p1547:b001:l015","ordinal":66705,"en":"Not losing the departing trail,"},{"id":"manas-2010:p1547:b001:l016","ordinal":66706,"en":"Not turning to either side,"},{"id":"manas-2010:p1547:b001:l017","ordinal":66707,"en":"Kongurbay, khan of the shaven priests,"},{"id":"manas-2010:p1547:b001:l018","ordinal":66708,"en":"Pursued without a care."},{"id":"manas-2010:p1547:b001:l019","ordinal":66709,"en":"The ninety Beijings rose;"},{"id":"manas-2010:p1547:b001:l020","ordinal":66710,"en":"Ay Zhang-Zhung, huge as a mountain,"},{"id":"manas-2010:p1547:b001:l021","ordinal":66711,"en":"The Chinese in their bands"},{"id":"manas-2010:p1547:b001:l022","ordinal":66712,"en":"Drove onward without stopping."},{"id":"manas-2010:p1547:b001:l023","ordinal":66713,"en":"What their own hands had fashioned,"},{"id":"manas-2010:p1547:b001:l024","ordinal":66714,"en":"The Buddha image made of bronze,"},{"id":"manas-2010:p1547:b001:l025","ordinal":66715,"en":"Saying that this was God,"},{"id":"manas-2010:p1547:b001:l026","ordinal":66716,"en":"They worshipped."},{"id":"manas-2010:p1547:b001:l027","ordinal":66717,"en":"The Chinese people surged in frenzy"},{"id":"manas-2010:p1547:b001:l028","ordinal":66718,"en":"And brought hardship upon them."},{"id":"manas-2010:p1547:b001:l029","ordinal":66719,"en":"At the echoing cliff-path,"},{"id":"manas-2010:p1547:b001:l030","ordinal":66720,"en":"A single horse could pass in file."},{"id":"manas-2010:p1547:b001:l031","ordinal":66721,"en":"He turned Sarala's head;"},{"id":"manas-2010:p1547:b001:l032","ordinal":66722,"en":"Azizkhan's Almambet,"},{"id":"manas-2010:p1547:b001:l033","ordinal":66723,"en":"To put up a dog's running fight,"},{"id":"manas-2010:p1547:b001:l034","ordinal":66724,"en":"Turned back now."},{"id":"manas-2010:p1547:b001:l035","ordinal":66725,"en":"Ay Zhang-Zhung and Kün Zhang-Zhung,"},{"id":"manas-2010:p1547:b001:l036","ordinal":66726,"en":"And their surpassing hero Kongurbay,"},{"id":"manas-2010:p1547:b001:l037","ordinal":66727,"en":"Upon your lone fierce-maned Alma"},{"id":"manas-2010:p1547:b001:l038","ordinal":66728,"en":"Swarmed and swept together."},{"id":"manas-2010:p1547:b001:l039","ordinal":66729,"en":"Sarala with cowlike lean haunches,"},{"id":"manas-2010:p1547:b001:l040","ordinal":66730,"en":"He wheeled about and attacked;"},{"id":"manas-2010:p1547:b001:l041","ordinal":66731,"en":"Sarala with his matted tail,"},{"id":"manas-2010:p1547:b001:l042","ordinal":66732,"en":"He sent whirling into the attack."},{"id":"manas-2010:p1548:b001:l001","ordinal":66733,"en":"Thrusting heroes down on the slope,"},{"id":"manas-2010:p1548:b001:l002","ordinal":66734,"en":"Thrusting many in succession,"},{"id":"manas-2010:p1548:b001:l003","ordinal":66735,"en":"Turning across with a shout,"},{"id":"manas-2010:p1548:b001:l004","ordinal":66736,"en":"Raising the battle-cry, “Manas!”"},{"id":"manas-2010:p1548:b001:l005","ordinal":66737,"en":"Scattering them in every direction,"},{"id":"manas-2010:p1548:b001:l006","ordinal":66738,"en":"Those who kept farther off"},{"id":"manas-2010:p1548:b001:l007","ordinal":66739,"en":"He felled with his lance;"},{"id":"manas-2010:p1548:b001:l008","ordinal":66740,"en":"Those who came close before him"},{"id":"manas-2010:p1548:b001:l009","ordinal":66741,"en":"He felled with his sword;"},{"id":"manas-2010:p1548:b001:l010","ordinal":66742,"en":"Those who came knee to knee"},{"id":"manas-2010:p1548:b001:l011","ordinal":66743,"en":"He shattered with his battle-axe."},{"id":"manas-2010:p1548:b001:l012","ordinal":66744,"en":"The shaven ones swept suddenly upon him;"},{"id":"manas-2010:p1548:b001:l013","ordinal":66745,"en":"Those who came closer"},{"id":"manas-2010:p1548:b001:l014","ordinal":66746,"en":"He struck with his lacquered musket."},{"id":"manas-2010:p1548:b001:l015","ordinal":66747,"en":"When the lacquered musket sounded,"},{"id":"manas-2010:p1548:b001:l016","ordinal":66748,"en":"The Chinese suddenly fled."},{"id":"manas-2010:p1548:b001:l017","ordinal":66749,"en":"Putting on a dog's threatening front,"},{"id":"manas-2010:p1548:b001:l018","ordinal":66750,"en":"They fought, taking breath between attacks."},{"id":"manas-2010:p1548:b001:l019","ordinal":66751,"en":"Azizkhan's Almambet,"},{"id":"manas-2010:p1548:b001:l020","ordinal":66752,"en":"So much gold,"},{"id":"manas-2010:p1548:b001:l021","ordinal":66753,"en":"Was it not your Alma who shared it out?"},{"id":"manas-2010:p1548:b001:l022","ordinal":66754,"en":"With his mother shot down,"},{"id":"manas-2010:p1548:b001:l023","ordinal":66755,"en":"Was it not your Alma who came?"},{"id":"manas-2010:p1548:b001:l024","ordinal":66756,"en":"Who bloodied the golden throne,"},{"id":"manas-2010:p1548:b001:l025","ordinal":66757,"en":"Saying, “He will not enter the Muslim faith,”"},{"id":"manas-2010:p1548:b001:l026","ordinal":66758,"en":"Who killed his father Azizkhan."},{"id":"manas-2010:p1548:b001:l027","ordinal":66759,"en":"Who renounced their idols,"},{"id":"manas-2010:p1548:b001:l028","ordinal":66760,"en":"Who shattered the Chinese lands."},{"id":"manas-2010:p1548:b001:l029","ordinal":66761,"en":"So many torments"},{"id":"manas-2010:p1548:b001:l030","ordinal":66762,"en":"Before this, from the Chinese,"},{"id":"manas-2010:p1548:b001:l031","ordinal":66763,"en":"Had your Alma not suffered?"},{"id":"manas-2010:p1548:b001:l032","ordinal":66764,"en":"To slaughter and mutual combat,"},{"id":"manas-2010:p1548:b001:l033","ordinal":66765,"en":"Was your Alma not accustomed?"},{"id":"manas-2010:p1548:b001:l034","ordinal":66766,"en":"Over forked ridges and curving heights,"},{"id":"manas-2010:p1548:b001:l035","ordinal":66767,"en":"Your Alma never feared to cross."},{"id":"manas-2010:p1548:b001:l036","ordinal":66768,"en":"Into the campaign before him,"},{"id":"manas-2010:p1548:b001:l037","ordinal":66769,"en":"Would your Alma fear to charge?"},{"id":"manas-2010:p1548:b001:l038","ordinal":66770,"en":"While your Alma stood to meet them,"},{"id":"manas-2010:p1548:b001:l039","ordinal":66771,"en":"While he fought without stopping,"},{"id":"manas-2010:p1548:b001:l040","ordinal":66772,"en":"They turned their horses' rumps;"},{"id":"manas-2010:p1548:b001:l041","ordinal":66773,"en":"When one drew back,"},{"id":"manas-2010:p1548:b001:l042","ordinal":66774,"en":"Another remained and fought."},{"id":"manas-2010:p1549:b001:l001","ordinal":66775,"en":"The Chinese pressed their pursuit;"},{"id":"manas-2010:p1549:b001:l002","ordinal":66776,"en":"They went on confronting one another."},{"id":"manas-2010:p1549:b001:l003","ordinal":66777,"en":"Kün Zhang-Zhung before the army,"},{"id":"manas-2010:p1549:b001:l004","ordinal":66778,"en":"Ay Zhang-Zhung pursuing without pause,"},{"id":"manas-2010:p1549:b001:l005","ordinal":66779,"en":"And imposing Kongurbay,"},{"id":"manas-2010:p1549:b001:l006","ordinal":66780,"en":"Baring his arm to wield his lance,"},{"id":"manas-2010:p1549:b001:l007","ordinal":66781,"en":"When the Buruts took flight,"},{"id":"manas-2010:p1549:b001:l008","ordinal":66782,"en":"When they turned their horses' rumps,"},{"id":"manas-2010:p1549:b001:l009","ordinal":66783,"en":"On the moon-yellow plain,"},{"id":"manas-2010:p1549:b001:l010","ordinal":66784,"en":"The Chinese multitude teemed,"},{"id":"manas-2010:p1549:b001:l011","ordinal":66785,"en":"Swarming like ants,"},{"id":"manas-2010:p1549:b001:l012","ordinal":66786,"en":"And came sweeping into view."},{"id":"manas-2010:p1549:b001:l013","ordinal":66787,"en":"On the broad, empty plain,"},{"id":"manas-2010:p1549:b001:l014","ordinal":66788,"en":"They came boiling into view."},{"id":"manas-2010:p1549:b001:l015","ordinal":66789,"en":"The uncountable massed army"},{"id":"manas-2010:p1549:b001:l016","ordinal":66790,"en":"Came pouring into view."},{"id":"manas-2010:p1549:b001:l017","ordinal":66791,"en":"To your Alma, left alone,"},{"id":"manas-2010:p1549:b001:l018","ordinal":66792,"en":"Thundering Kün Zhang-Zhung cried,"},{"id":"manas-2010:p1549:b001:l019","ordinal":66793,"en":"“You fugitive wretch on the run,"},{"id":"manas-2010:p1549:b001:l020","ordinal":66794,"en":"I shall spear you!"},{"id":"manas-2010:p1549:b001:l021","ordinal":66795,"en":"Leaving no one able to resist,"},{"id":"manas-2010:p1549:b001:l022","ordinal":66796,"en":"I shall bring ruin upon the Buruts."},{"id":"manas-2010:p1549:b001:l023","ordinal":66797,"en":"To the girls who went to Talas,"},{"id":"manas-2010:p1549:b001:l024","ordinal":66798,"en":"Adding another thousand girls,"},{"id":"manas-2010:p1549:b001:l025","ordinal":66799,"en":"I shall take them back!”"},{"id":"manas-2010:p1549:b001:l026","ordinal":66800,"en":"Of the Chinese with rank-buttons,"},{"id":"manas-2010:p1549:b001:l027","ordinal":66801,"en":"The finest divided off;"},{"id":"manas-2010:p1549:b001:l028","ordinal":66802,"en":"Of the Chinese with red tassels,"},{"id":"manas-2010:p1549:b001:l029","ordinal":66803,"en":"The keen warriors divided off."},{"id":"manas-2010:p1549:b001:l030","ordinal":66804,"en":"Among the jacket-wearing Manzhuu,"},{"id":"manas-2010:p1549:b001:l031","ordinal":66805,"en":"Kün Zhang-Zhung loomed like a mountain."},{"id":"manas-2010:p1549:b001:l032","ordinal":66806,"en":"If you looked at his brows and eyelids,"},{"id":"manas-2010:p1549:b001:l033","ordinal":66807,"en":"They were like a desert in dusk;"},{"id":"manas-2010:p1549:b001:l034","ordinal":66808,"en":"The two eyes in his forehead"},{"id":"manas-2010:p1549:b001:l035","ordinal":66809,"en":"Were like still-standing lakes."},{"id":"manas-2010:p1549:b001:l036","ordinal":66810,"en":"His stiff moustache bristled,"},{"id":"manas-2010:p1549:b001:l037","ordinal":66811,"en":"Like the handle of a battle-axe."},{"id":"manas-2010:p1549:b001:l038","ordinal":66812,"en":"With giant Kün Zhang-Zhung at their head,"},{"id":"manas-2010:p1549:b001:l039","ordinal":66813,"en":"The Chinese swept upon him."},{"id":"manas-2010:p1549:b001:l040","ordinal":66814,"en":"Almambet, left alone,"},{"id":"manas-2010:p1549:b001:l041","ordinal":66815,"en":"The Chinese multitude swarmed over;"},{"id":"manas-2010:p1549:b001:l042","ordinal":66816,"en":"They surrounded him before and behind,"}]
