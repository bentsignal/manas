[{"id":"semetey-1-2013:p0780:b004:l019","ordinal":136705,"en":"Gathering speed, Toruaygyr ran,"},{"id":"semetey-1-2013:p0780:b004:l020","ordinal":136706,"en":"Ran and reached the tether."},{"id":"semetey-1-2013:p0780:b004:l021","ordinal":136707,"en":"When he reached it and stopped short,"},{"id":"semetey-1-2013:p0780:b004:l022","ordinal":136708,"en":"That dog Kobosh, fit for burial,"},{"id":"semetey-1-2013:p0780:b004:l023","ordinal":136709,"en":"Was flung from his back."},{"id":"semetey-1-2013:p0780:b004:l024","ordinal":136710,"en":"Headlong went brave Kobosh,"},{"id":"semetey-1-2013:p0780:b004:l025","ordinal":136711,"en":"Falling to the ground."},{"id":"semetey-1-2013:p0780:b004:l026","ordinal":136712,"en":"A black stone beside the hearth—"},{"id":"semetey-1-2013:p0780:b004:l027","ordinal":136713,"en":"His head struck against it."},{"id":"semetey-1-2013:p0780:b004:l028","ordinal":136714,"en":"His head was battered,"},{"id":"semetey-1-2013:p0780:b004:l029","ordinal":136715,"en":"His blood streamed out."},{"id":"semetey-1-2013:p0780:b004:l030","ordinal":136716,"en":"Akylay ran up in distress;"},{"id":"semetey-1-2013:p0780:b004:l031","ordinal":136717,"en":"A broad finger-span and a fingerbreadth,"},{"id":"semetey-1-2013:p0780:b004:l032","ordinal":136718,"en":"Kobosh's head was split."},{"id":"semetey-1-2013:p0780:b004:l033","ordinal":136719,"en":"This foolish dog Kobosh's"},{"id":"semetey-1-2013:p0780:b004:l034","ordinal":136720,"en":"Crookedness was revealed."},{"id":"semetey-1-2013:p0780:b004:l035","ordinal":136721,"en":"Beaten by Toruaygyr,"},{"id":"semetey-1-2013:p0780:b004:l036","ordinal":136722,"en":"His wicked blood spilled,"},{"id":"semetey-1-2013:p0780:b004:l037","ordinal":136723,"en":"For seven days, weakened,"},{"id":"semetey-1-2013:p0780:b004:l038","ordinal":136724,"en":"Kobosh lay bleeding."},{"id":"semetey-1-2013:p0780:b004:l039","ordinal":136725,"en":"While Kobosh lay like this,"},{"id":"semetey-1-2013:p0781:b003:l001","ordinal":136726,"en":"The elders led by Kyrgyl,"},{"id":"semetey-1-2013:p0781:b003:l002","ordinal":136727,"en":"As though disaster had struck them,"},{"id":"semetey-1-2013:p0781:b003:l003","ordinal":136728,"en":"All forty companions"},{"id":"semetey-1-2013:p0781:b003:l004","ordinal":136729,"en":"Had gone scouting, surveying the land,"},{"id":"semetey-1-2013:p0781:b003:l005","ordinal":136730,"en":"Ten days' journey away."},{"id":"semetey-1-2013:p0781:b003:l006","ordinal":136731,"en":"Before the companions returned from their patrol,"},{"id":"semetey-1-2013:p0781:b003:l007","ordinal":136732,"en":"As though an evil spirit had struck him,"},{"id":"semetey-1-2013:p0781:b003:l008","ordinal":136733,"en":"That very fool Köbösh"},{"id":"semetey-1-2013:p0781:b003:l009","ordinal":136734,"en":"Had been struck down by God."},{"id":"semetey-1-2013:p0781:b003:l010","ordinal":136735,"en":"His wealth had been plundered;"},{"id":"semetey-1-2013:p0781:b003:l011","ordinal":136736,"en":"Bakai and Semetey"},{"id":"semetey-1-2013:p0781:b003:l012","ordinal":136737,"en":"Together had finished off that dog."},{"id":"semetey-1-2013:p0781:b003:l013","ordinal":136738,"en":"The possessions left by Manas"},{"id":"semetey-1-2013:p0781:b003:l014","ordinal":136739,"en":"They had carried away together."},{"id":"semetey-1-2013:p0781:b003:l015","ordinal":136740,"en":"The wealth left by Manas—"},{"id":"semetey-1-2013:p0781:b003:l016","ordinal":136741,"en":"Akolpok and Akkelte,"},{"id":"semetey-1-2013:p0781:b003:l017","ordinal":136742,"en":"The gray belt-pouch and Altykurch—"},{"id":"semetey-1-2013:p0781:b003:l018","ordinal":136743,"en":"Of Manas, that great, fierce hero,"},{"id":"semetey-1-2013:p0781:b003:l019","ordinal":136744,"en":"The painted spear was gone too."},{"id":"semetey-1-2013:p0781:b003:l020","ordinal":136745,"en":"“The orphan has plundered them!”"},{"id":"semetey-1-2013:p0781:b003:l021","ordinal":136746,"en":"Akylai stood snarling,"},{"id":"semetey-1-2013:p0781:b003:l022","ordinal":136747,"en":"Urging all forty companions on,"},{"id":"semetey-1-2013:p0781:b003:l023","ordinal":136748,"en":"Shrieking out her cries:"},{"id":"semetey-1-2013:p0781:b003:l024","ordinal":136749,"en":"“Damn you, forty companions!"},{"id":"semetey-1-2013:p0781:b003:l025","ordinal":136750,"en":"With my magnanimous Khan Manas"},{"id":"semetey-1-2013:p0781:b003:l026","ordinal":136751,"en":"You joined when tiny as lice,"},{"id":"semetey-1-2013:p0781:b003:l027","ordinal":136752,"en":"You met when small as ticks."},{"id":"semetey-1-2013:p0781:b003:l028","ordinal":136753,"en":"My dear forty companions,"},{"id":"semetey-1-2013:p0781:b003:l029","ordinal":136754,"en":"Raise the battle cry against the fugitive;"},{"id":"semetey-1-2013:p0781:b003:l030","ordinal":136755,"en":"The possessions he carried off,"},{"id":"semetey-1-2013:p0781:b003:l031","ordinal":136756,"en":"Bring them back to me."},{"id":"semetey-1-2013:p0781:b003:l032","ordinal":136757,"en":"For Manas, whose spirit is mighty,"},{"id":"semetey-1-2013:p0781:b003:l033","ordinal":136758,"en":"For his spirit's sake, forty companions,"},{"id":"semetey-1-2013:p0781:b003:l034","ordinal":136759,"en":"Raise a mighty battle cry!”"},{"id":"semetey-1-2013:p0781:b003:l035","ordinal":136760,"en":"As though pierced by an awl,"},{"id":"semetey-1-2013:p0781:b003:l036","ordinal":136761,"en":"The forty companions sprang up."},{"id":"semetey-1-2013:p0781:b003:l037","ordinal":136762,"en":"Ajybai and Shuutu said:"},{"id":"semetey-1-2013:p0781:b003:l038","ordinal":136763,"en":"“You bellow, Akylai,"},{"id":"semetey-1-2013:p0781:b003:l039","ordinal":136764,"en":"And fill our hearts with care."},{"id":"semetey-1-2013:p0781:b004:l001","ordinal":136765,"en":"The forty companions will perish in the wilds."},{"id":"semetey-1-2013:p0781:b004:l002","ordinal":136766,"en":"How could we dare attack"},{"id":"semetey-1-2013:p0781:b004:l003","ordinal":136767,"en":"The child of Manas, blessed by Khyzyr,"},{"id":"semetey-1-2013:p0781:b004:l004","ordinal":136768,"en":"The son he had at his death?"},{"id":"semetey-1-2013:p0781:b004:l005","ordinal":136769,"en":"When the forty warriors were mighty,"},{"id":"semetey-1-2013:p0781:b004:l006","ordinal":136770,"en":"He is no dark, rugged mountain"},{"id":"semetey-1-2013:p0781:b004:l007","ordinal":136771,"en":"For us to charge and fight;"},{"id":"semetey-1-2013:p0781:b004:l008","ordinal":136772,"en":"That leopard Semetey"},{"id":"semetey-1-2013:p0781:b004:l009","ordinal":136773,"en":"Is no enemy come from the Kalmyks."},{"id":"semetey-1-2013:p0781:b004:l010","ordinal":136774,"en":"Sister-in-law Akylai, listen:"},{"id":"semetey-1-2013:p0781:b004:l011","ordinal":136775,"en":"This idea of yours is mad."},{"id":"semetey-1-2013:p0781:b004:l012","ordinal":136776,"en":"If we defy that righteous spirit,"},{"id":"semetey-1-2013:p0781:b004:l013","ordinal":136777,"en":"Will God strike the companions down"},{"id":"semetey-1-2013:p0781:b004:l014","ordinal":136778,"en":"Of the falcon, brave Manas,"},{"id":"semetey-1-2013:p0781:b004:l015","ordinal":136779,"en":"For attacking his only son?"},{"id":"semetey-1-2013:p0781:b004:l016","ordinal":136780,"en":"Manas's salt has great power;"},{"id":"semetey-1-2013:p0781:b004:l017","ordinal":136781,"en":"Will his salt not destroy us?"},{"id":"semetey-1-2013:p0781:b004:l018","ordinal":136782,"en":"Manas's spirit has great power;"},{"id":"semetey-1-2013:p0781:b004:l019","ordinal":136783,"en":"Will his spirit not destroy us?"},{"id":"semetey-1-2013:p0781:b004:l020","ordinal":136784,"en":"The lord’s only son—"},{"id":"semetey-1-2013:p0781:b004:l021","ordinal":136785,"en":"Can anyone who attacks him prosper?"},{"id":"semetey-1-2013:p0781:b004:l022","ordinal":136786,"en":"Would one rise after a blow from the side?"},{"id":"semetey-1-2013:p0781:b004:l023","ordinal":136787,"en":"Can anyone prosper who attacks the lord?"},{"id":"semetey-1-2013:p0781:b004:l024","ordinal":136788,"en":"Would one rise after a blow from above?"},{"id":"semetey-1-2013:p0781:b004:l025","ordinal":136789,"en":"Can anyone prosper who attacks the only son?"},{"id":"semetey-1-2013:p0781:b004:l026","ordinal":136790,"en":"Would one rise after a blow at the soul?"},{"id":"semetey-1-2013:p0781:b004:l027","ordinal":136791,"en":"When Semetey was born,"},{"id":"semetey-1-2013:p0781:b004:l028","ordinal":136792,"en":"All forty companions were there,"},{"id":"semetey-1-2013:p0781:b004:l029","ordinal":136793,"en":"The elders led by Kyrgyl were there."},{"id":"semetey-1-2013:p0781:b004:l030","ordinal":136794,"en":"When nine hundred barren mares were slaughtered for his feast,"},{"id":"semetey-1-2013:p0781:b004:l031","ordinal":136795,"en":"When he was named Semetey,"},{"id":"semetey-1-2013:p0781:b004:l032","ordinal":136796,"en":"Khyzyr ate at his feast and departed,"},{"id":"semetey-1-2013:p0781:b004:l033","ordinal":136797,"en":"Saying, ‘If this little fellow lives,"},{"id":"semetey-1-2013:p0781:b004:l034","ordinal":136798,"en":"He will accomplish much.’"},{"id":"semetey-1-2013:p0781:b004:l035","ordinal":136799,"en":"When Kanykei had just given birth,"},{"id":"semetey-1-2013:p0781:b004:l036","ordinal":136800,"en":"Manas swelled with pride;"},{"id":"semetey-1-2013:p0781:b004:l037","ordinal":136801,"en":"The ninety giants who came to the feast,"},{"id":"semetey-1-2013:p0781:b004:l038","ordinal":136802,"en":"Led by mountain-like Koshoi,"},{"id":"semetey-1-2013:p0781:b004:l039","ordinal":136803,"en":"Lavished praise upon him,"},{"id":"semetey-1-2013:p0782:b003:l001","ordinal":136804,"en":"As though allotting him an inheritance,"},{"id":"semetey-1-2013:p0782:b003:l002","ordinal":136805,"en":"They all took him in their arms and weighed him:"},{"id":"semetey-1-2013:p0782:b003:l003","ordinal":136806,"en":"‘The fierce hero's only offspring,’ they said,"},{"id":"semetey-1-2013:p0782:b003:l004","ordinal":136807,"en":"‘The little fellow born so late.’"},{"id":"semetey-1-2013:p0782:b003:l005","ordinal":136808,"en":"He received Koshoi's blessing,"},{"id":"semetey-1-2013:p0782:b003:l006","ordinal":136809,"en":"The great men's favor rested on him."},{"id":"semetey-1-2013:p0782:b003:l007","ordinal":136810,"en":"Whoever rivals him will not prosper;"},{"id":"semetey-1-2013:p0782:b003:l008","ordinal":136811,"en":"Whoever attacks him will not remain whole."},{"id":"semetey-1-2013:p0782:b003:l009","ordinal":136812,"en":"When the orphan, Manas's son,"},{"id":"semetey-1-2013:p0782:b003:l010","ordinal":136813,"en":"Had only just been born,"},{"id":"semetey-1-2013:p0782:b003:l011","ordinal":136814,"en":"There is a tale that never ends,"},{"id":"semetey-1-2013:p0782:b003:l012","ordinal":136815,"en":"Growing stronger whenever it seemed spent,"},{"id":"semetey-1-2013:p0782:b003:l013","ordinal":136816,"en":"His roots have a saintly quality."},{"id":"semetey-1-2013:p0782:b003:l014","ordinal":136817,"en":"‘When she had just given birth,"},{"id":"semetey-1-2013:p0782:b003:l015","ordinal":136818,"en":"We witnessed a great miracle,’"},{"id":"semetey-1-2013:p0782:b003:l016","ordinal":136819,"en":"Six women said."},{"id":"semetey-1-2013:p0782:b003:l017","ordinal":136820,"en":"Let me tell you who the six were:"},{"id":"semetey-1-2013:p0782:b003:l018","ordinal":136821,"en":"Almambet's Aruuke,"},{"id":"semetey-1-2013:p0782:b003:l019","ordinal":136822,"en":"Khan Bakai's Körpöjan,"},{"id":"semetey-1-2013:p0782:b003:l020","ordinal":136823,"en":"Brave Chubak's Altynai,"},{"id":"semetey-1-2013:p0782:b003:l021","ordinal":136824,"en":"Ajybai's Alymkan,"},{"id":"semetey-1-2013:p0782:b003:l022","ordinal":136825,"en":"Brave Shuutu's Burmakan."},{"id":"semetey-1-2013:p0782:b003:l023","ordinal":136826,"en":"While Kanykei labored greatly,"},{"id":"semetey-1-2013:p0782:b003:l024","ordinal":136827,"en":"Sarala is a blue sheep"},{"id":"semetey-1-2013:p0782:b003:l025","ordinal":136828,"en":"Dear brother,"},{"id":"semetey-1-2013:p0782:b003:l026","ordinal":136829,"en":"She bore the warrior, brave Semetey,"},{"id":"semetey-1-2013:p0782:b003:l027","ordinal":136830,"en":"Upright, with his feet first."},{"id":"semetey-1-2013:p0782:b003:l028","ordinal":136831,"en":"In his right hand, dark blood—"},{"id":"semetey-1-2013:p0782:b003:l029","ordinal":136832,"en":"I hear he was born clutching it."},{"id":"semetey-1-2013:p0782:b003:l030","ordinal":136833,"en":"That he was born clutching dark blood"},{"id":"semetey-1-2013:p0782:b004:l001","ordinal":136834,"en":"Meant, ‘The enemy who attacks me,"},{"id":"semetey-1-2013:p0782:b004:l002","ordinal":136835,"en":"When I fight him in fury,"},{"id":"semetey-1-2013:p0782:b004:l003","ordinal":136836,"en":"I shall spill his blood.’"},{"id":"semetey-1-2013:p0782:b004:l004","ordinal":136837,"en":"The reason his left hand"},{"id":"semetey-1-2013:p0782:b004:l005","ordinal":136838,"en":"Was born grasping yellow venom"},{"id":"semetey-1-2013:p0782:b004:l006","ordinal":136839,"en":"Was, ‘I shall turn them yellow as venom;"},{"id":"semetey-1-2013:p0782:b004:l007","ordinal":136840,"en":"Until only one descendant remains,"},{"id":"semetey-1-2013:p0782:b004:l008","ordinal":136841,"en":"I shall dig out their roots.’"},{"id":"semetey-1-2013:p0782:b004:l009","ordinal":136842,"en":"At Abyke's palace,"},{"id":"semetey-1-2013:p0782:b004:l010","ordinal":136843,"en":"All forty companions,"},{"id":"semetey-1-2013:p0782:b004:l011","ordinal":136844,"en":"The elders led by Kyrgyl,"},{"id":"semetey-1-2013:p0782:b004:l012","ordinal":136845,"en":"When they heard the blessed words,"},{"id":"semetey-1-2013:p0782:b004:l013","ordinal":136846,"en":"All collapsed,"},{"id":"semetey-1-2013:p0782:b004:l014","ordinal":136847,"en":"Hung up their weapons,"},{"id":"semetey-1-2013:p0782:b004:l015","ordinal":136848,"en":"And took to drinking."},{"id":"semetey-1-2013:p0782:b004:l016","ordinal":136849,"en":"In Abyke's house,"},{"id":"semetey-1-2013:p0782:b004:l017","ordinal":136850,"en":"Strong liquor stood by the wall."},{"id":"semetey-1-2013:p0782:b004:l018","ordinal":136851,"en":"Spirits in a Kalmyk leather flask—"},{"id":"semetey-1-2013:p0782:b004:l019","ordinal":136852,"en":"They poured it into traveling cups,"},{"id":"semetey-1-2013:p0782:b004:l020","ordinal":136853,"en":"They all passed it round."},{"id":"semetey-1-2013:p0782:b004:l021","ordinal":136854,"en":"Those wretched forty companions,"},{"id":"semetey-1-2013:p0782:b004:l022","ordinal":136855,"en":"Fighting without sparing his life."},{"id":"semetey-1-2013:p0782:b004:l023","ordinal":136856,"en":"As for the orphan, Manas's son,"},{"id":"semetey-1-2013:p0782:b004:l024","ordinal":136857,"en":"The forty companions cared nothing;"},{"id":"semetey-1-2013:p0782:b004:l025","ordinal":136858,"en":"No one asked, ‘Where are you?’"},{"id":"semetey-1-2013:p0782:b004:l026","ordinal":136859,"en":"They drank liquor and panted,"},{"id":"semetey-1-2013:p0782:b004:l027","ordinal":136860,"en":"They drank kumys and shouted."},{"id":"semetey-1-2013:p0782:b004:l028","ordinal":136861,"en":"The scandal of the forty companions—"},{"id":"semetey-1-2013:p0782:b004:l029","ordinal":136862,"en":"Now let me tell"},{"id":"semetey-1-2013:p0782:b004:l030","ordinal":136863,"en":"The tale of brave Semetey."},{"id":"semetey-1-2013:p0783:b004:l001","ordinal":136864,"en":"Brave Bakai led him"},{"id":"semetey-1-2013:p0783:b004:l002","ordinal":136865,"en":"Across the yellow, rugged ridge,"},{"id":"semetey-1-2013:p0783:b004:l003","ordinal":136866,"en":"Through the ranks of upland valleys—"},{"id":"semetey-1-2013:p0783:b004:l004","ordinal":136867,"en":"May I be his sacrifice!—"},{"id":"semetey-1-2013:p0783:b004:l005","ordinal":136868,"en":"Across the yellow, rugged ridge."},{"id":"semetey-1-2013:p0783:b004:l006","ordinal":136869,"en":"The little hills of Kan-Jailak"},{"id":"semetey-1-2013:p0783:b004:l007","ordinal":136870,"en":"Showed in mottled patches."},{"id":"semetey-1-2013:p0783:b004:l008","ordinal":136871,"en":"The heart of staunch, fierce Bakai"},{"id":"semetey-1-2013:p0783:b004:l009","ordinal":136872,"en":"Was sorely troubled."},{"id":"semetey-1-2013:p0783:b004:l010","ordinal":136873,"en":"Hill after hill came into view;"},{"id":"semetey-1-2013:p0783:b004:l011","ordinal":136874,"en":"Horses stood out upon the hills."},{"id":"semetey-1-2013:p0783:b004:l012","ordinal":136875,"en":"From grieving, fierce Bakai's eyes"},{"id":"semetey-1-2013:p0783:b004:l013","ordinal":136876,"en":"The tears poured down."},{"id":"semetey-1-2013:p0783:b004:l014","ordinal":136877,"en":"Watching him, Semetey"},{"id":"semetey-1-2013:p0783:b004:l015","ordinal":136878,"en":"Seemed greatly troubled."},{"id":"semetey-1-2013:p0783:b004:l016","ordinal":136879,"en":"His white beard grew thin;"},{"id":"semetey-1-2013:p0783:b004:l017","ordinal":136880,"en":"The dark tears from his eyes"},{"id":"semetey-1-2013:p0783:b004:l018","ordinal":136881,"en":"Of your valiant elder Bakai,"},{"id":"semetey-1-2013:p0783:b004:l019","ordinal":136882,"en":"Poured down his collarbone."},{"id":"semetey-1-2013:p0783:b004:l020","ordinal":136883,"en":"Without speaking a word,"},{"id":"semetey-1-2013:p0783:b004:l021","ordinal":136884,"en":"Your caravan-leader Bakai trembled,"},{"id":"semetey-1-2013:p0783:b004:l022","ordinal":136885,"en":"Thinking much of the old days;"},{"id":"semetey-1-2013:p0783:b004:l023","ordinal":136886,"en":"The poor man stood shaking."},{"id":"semetey-1-2013:p0783:b004:l024","ordinal":136887,"en":"“My dear orphan,"},{"id":"semetey-1-2013:p0783:b004:l025","ordinal":136888,"en":"Unseen by me for twelve years,"},{"id":"semetey-1-2013:p0783:b004:l026","ordinal":136889,"en":"The livestock left without an owner"},{"id":"semetey-1-2013:p0783:b004:l027","ordinal":136890,"en":"Appear before my eyes like a vision."},{"id":"semetey-1-2013:p0783:b004:l028","ordinal":136891,"en":"This accursed, empty world"},{"id":"semetey-1-2013:p0783:b004:l029","ordinal":136892,"en":"Seems to deal with us like this."},{"id":"semetey-1-2013:p0783:b004:l030","ordinal":136893,"en":"Those precious herds upon the hills,"},{"id":"semetey-1-2013:p0783:b004:l031","ordinal":136894,"en":"Their stallion descended from Kambar Ata,"},{"id":"semetey-1-2013:p0783:b004:l032","ordinal":136895,"en":"Fine piebald steeds,"},{"id":"semetey-1-2013:p0783:b004:l033","ordinal":136896,"en":"To tell you of the old days,"},{"id":"semetey-1-2013:p0783:b004:l034","ordinal":136897,"en":"They were Manas's livestock."},{"id":"semetey-1-2013:p0783:b004:l035","ordinal":136898,"en":"To tell you of today,"},{"id":"semetey-1-2013:p0783:b004:l036","ordinal":136899,"en":"Abyke and Köbösh, those six scoundrels,"},{"id":"semetey-1-2013:p0783:b005:l001","ordinal":136900,"en":"Caught Manas's Kambar Ata stallion"},{"id":"semetey-1-2013:p0783:b005:l002","ordinal":136901,"en":"And slaughtered him for winter meat."},{"id":"semetey-1-2013:p0783:b005:l003","ordinal":136902,"en":"It was as though he had made slaves"},{"id":"semetey-1-2013:p0783:b005:l004","ordinal":136903,"en":"He made death."},{"id":"semetey-1-2013:p0783:b005:l005","ordinal":136904,"en":"They butchered the fleet-footed steed."},{"id":"semetey-1-2013:p0783:b005:l006","ordinal":136905,"en":"Those precious beasts resembling Buurul,"},{"id":"semetey-1-2013:p0783:b005:l007","ordinal":136906,"en":"God had struck it down."},{"id":"semetey-1-2013:p0783:b005:l008","ordinal":136907,"en":"With fine tails and fine manes,"},{"id":"semetey-1-2013:p0783:b005:l009","ordinal":136908,"en":"Such were those precious herds."},{"id":"semetey-1-2013:p0783:b005:l010","ordinal":136909,"en":"They named him Bokmurun."},{"id":"semetey-1-2013:p0783:b005:l011","ordinal":136910,"en":"His winged steed, had been well fed;"},{"id":"semetey-1-2013:p0783:b005:l012","ordinal":136911,"en":"Abyke and Köbösh became their owners,"},{"id":"semetey-1-2013:p0783:b005:l013","ordinal":136912,"en":"And the wealth has dwindled away.”"},{"id":"semetey-1-2013:p0783:b005:l014","ordinal":136913,"en":"So Khan Bakai lamented."},{"id":"semetey-1-2013:p0783:b005:l015","ordinal":136914,"en":"To a saddle-shaped mountain pass"},{"id":"semetey-1-2013:p0783:b005:l016","ordinal":136915,"en":"Brave Semetey and Khan Bakai"},{"id":"semetey-1-2013:p0783:b005:l017","ordinal":136916,"en":"Now climbed."},{"id":"semetey-1-2013:p0783:b005:l018","ordinal":136917,"en":"When he looked north,"},{"id":"semetey-1-2013:p0783:b005:l019","ordinal":136918,"en":"Dust rose in billowing clouds."},{"id":"semetey-1-2013:p0783:b005:l020","ordinal":136919,"en":"When he saw the billowing dust,"},{"id":"semetey-1-2013:p0783:b005:l021","ordinal":136920,"en":"Khan Bakai nearly lost his soul."},{"id":"semetey-1-2013:p0783:b005:l022","ordinal":136921,"en":"He turned Kökcholok's head:"},{"id":"semetey-1-2013:p0783:b005:l023","ordinal":136922,"en":"“My orphan!” he called,"},{"id":"semetey-1-2013:p0783:b005:l024","ordinal":136923,"en":"Shouting, “Come here!”"},{"id":"semetey-1-2013:p0783:b005:l025","ordinal":136924,"en":"Valiant Bakai stood there."},{"id":"semetey-1-2013:p0783:b005:l026","ordinal":136925,"en":"He cried, “Baabedin!”"},{"id":"semetey-1-2013:p0783:b005:l027","ordinal":136926,"en":"And called for Semetey:"},{"id":"semetey-1-2013:p0783:b005:l028","ordinal":136927,"en":"“My dear Semetey,"},{"id":"semetey-1-2013:p0783:b005:l029","ordinal":136928,"en":"My comfort left by my Khan Manas,"},{"id":"semetey-1-2013:p0783:b005:l030","ordinal":136929,"en":"Whom I have seen at my death,"},{"id":"semetey-1-2013:p0783:b005:l031","ordinal":136930,"en":"Have you seen what I have seen?"},{"id":"semetey-1-2013:p0783:b005:l032","ordinal":136931,"en":"Have you sensed what I have sensed?"},{"id":"semetey-1-2013:p0783:b005:l033","ordinal":136932,"en":"Have you understood what I have understood?"},{"id":"semetey-1-2013:p0783:b005:l034","ordinal":136933,"en":"Today your elder Bakai's"},{"id":"semetey-1-2013:p0783:b005:l035","ordinal":136934,"en":"Rib bones tremble,"},{"id":"semetey-1-2013:p0783:b005:l036","ordinal":136935,"en":"His living heart quakes."},{"id":"semetey-1-2013:p0784:b003:l001","ordinal":136936,"en":"Today your elder, Khan Bakai,"},{"id":"semetey-1-2013:p0784:b003:l002","ordinal":136937,"en":"Wakes startled from sleep,"},{"id":"semetey-1-2013:p0784:b003:l003","ordinal":136938,"en":"Turns onto his right side,"},{"id":"semetey-1-2013:p0784:b003:l004","ordinal":136939,"en":"Dips his hands in water,"},{"id":"semetey-1-2013:p0784:b003:l005","ordinal":136940,"en":"And performs his ablution."},{"id":"semetey-1-2013:p0784:b003:l006","ordinal":136941,"en":"He pleads with the one God,"},{"id":"semetey-1-2013:p0784:b003:l007","ordinal":136942,"en":"Hastens to say his prayer,"},{"id":"semetey-1-2013:p0784:b003:l008","ordinal":136943,"en":"And saddles Kökcholok."},{"id":"semetey-1-2013:p0784:b003:l009","ordinal":136944,"en":"This very day your elder"},{"id":"semetey-1-2013:p0784:b003:l010","ordinal":136945,"en":"Will see a night of calamity"},{"id":"semetey-1-2013:p0784:b003:l011","ordinal":136946,"en":"Or a day upon which light shines."},{"id":"semetey-1-2013:p0784:b003:l012","ordinal":136947,"en":"Today your elder Bakai"},{"id":"semetey-1-2013:p0784:b003:l013","ordinal":136948,"en":"Will either meet death and die,"},{"id":"semetey-1-2013:p0784:b003:l014","ordinal":136949,"en":"And see the face of Judgment,"},{"id":"semetey-1-2013:p0784:b003:l015","ordinal":136950,"en":"Or else Khan Bakai"},{"id":"semetey-1-2013:p0784:b003:l016","ordinal":136951,"en":"Will see the delights of the world."},{"id":"semetey-1-2013:p0784:b003:l017","ordinal":136952,"en":"Since the mighty Manas died,"},{"id":"semetey-1-2013:p0784:b003:l018","ordinal":136953,"en":"Twelve full years have passed."},{"id":"semetey-1-2013:p0784:b003:l019","ordinal":136954,"en":"The forlorn remnant that fled"},{"id":"semetey-1-2013:p0784:b003:l020","ordinal":136955,"en":"Seems to have returned this year."},{"id":"semetey-1-2013:p0784:b003:l021","ordinal":136956,"en":"This elder Bakai of yours may die;"},{"id":"semetey-1-2013:p0784:b003:l022","ordinal":136957,"en":"If your elder Bakai does not die,"},{"id":"semetey-1-2013:p0784:b003:l023","ordinal":136958,"en":"He will witness a marvel."},{"id":"semetey-1-2013:p0784:b003:l024","ordinal":136959,"en":"Oh, my dear orphan,"},{"id":"semetey-1-2013:p0784:b003:l025","ordinal":136960,"en":"Have you seen the billowing dust?"}]
