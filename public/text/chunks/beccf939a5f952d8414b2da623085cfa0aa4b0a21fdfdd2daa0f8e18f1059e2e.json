[{"id":"manas-2010:p1513:b001:l019","ordinal":65281,"en":"Flame coming from his eyes,"},{"id":"manas-2010:p1513:b001:l020","ordinal":65282,"en":"Rumbled like a falling stone."},{"id":"manas-2010:p1513:b001:l021","ordinal":65283,"en":"As he gritted his white teeth,"},{"id":"manas-2010:p1513:b001:l022","ordinal":65284,"en":"They crumbled like millet."},{"id":"manas-2010:p1513:b001:l023","ordinal":65285,"en":"He charged at the Kalcha,"},{"id":"manas-2010:p1513:b001:l024","ordinal":65286,"en":"Roaring like a lion."},{"id":"manas-2010:p1513:b001:l025","ordinal":65287,"en":"Before hero Syrgak"},{"id":"manas-2010:p1513:b001:l026","ordinal":65288,"en":"Was a path for just one horse;"},{"id":"manas-2010:p1513:b001:l027","ordinal":65289,"en":"Prepared beforehand,"},{"id":"manas-2010:p1513:b001:l028","ordinal":65290,"en":"There was a deep pit dug."},{"id":"manas-2010:p1513:b001:l029","ordinal":65291,"en":"When Syrgak began his charge,"},{"id":"manas-2010:p1513:b001:l030","ordinal":65292,"en":"Almambet saw him from afar."},{"id":"manas-2010:p1513:b001:l031","ordinal":65293,"en":"“Now Syrgak is dead!” he cried,"},{"id":"manas-2010:p1513:b001:l032","ordinal":65294,"en":"Spurring right and left,"},{"id":"manas-2010:p1513:b001:l033","ordinal":65295,"en":"Lashing with his whip every which way."},{"id":"manas-2010:p1513:b001:l034","ordinal":65296,"en":"From afar he shouted, “Go!”"},{"id":"manas-2010:p1513:b001:l035","ordinal":65297,"en":"“O Syrgak!” he yelled."},{"id":"manas-2010:p1513:b001:l036","ordinal":65298,"en":"His many worries would not fit his chest;"},{"id":"manas-2010:p1513:b001:l037","ordinal":65299,"en":"Tears streamed in ten directions."},{"id":"manas-2010:p1513:b001:l038","ordinal":65300,"en":"He arrived before an arrow could;"},{"id":"manas-2010:p1513:b001:l039","ordinal":65301,"en":"Reaching Syrgak,"},{"id":"manas-2010:p1513:b001:l040","ordinal":65302,"en":"He caught hold of the reins,"},{"id":"manas-2010:p1513:b001:l041","ordinal":65303,"en":"Keeping him from reaching Kongurbay,"},{"id":"manas-2010:p1513:b001:l042","ordinal":65304,"en":"Making him rage and struggle,"},{"id":"manas-2010:p1514:b001:l001","ordinal":65305,"en":"Like a woman whose husband had died,"},{"id":"manas-2010:p1514:b001:l002","ordinal":65306,"en":"Making the leopard struggle,"},{"id":"manas-2010:p1514:b001:l003","ordinal":65307,"en":"He led him out and away."},{"id":"manas-2010:p1514:b001:l004","ordinal":65308,"en":"Then Almambet said this:"},{"id":"manas-2010:p1514:b001:l005","ordinal":65309,"en":"“That dark ridge shaped like a saddle"},{"id":"manas-2010:p1514:b001:l006","ordinal":65310,"en":"Is no ridge to cross without counsel;"},{"id":"manas-2010:p1514:b001:l007","ordinal":65311,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1514:b001:l008","ordinal":65312,"en":"Is no warrior to slaughter without caution!"},{"id":"manas-2010:p1514:b001:l009","ordinal":65313,"en":"Whatever place it may be,"},{"id":"manas-2010:p1514:b001:l010","ordinal":65314,"en":"The land of Beijing is no place"},{"id":"manas-2010:p1514:b001:l011","ordinal":65315,"en":"To enter blindly!"},{"id":"manas-2010:p1514:b001:l012","ordinal":65316,"en":"To reach him now,"},{"id":"manas-2010:p1514:b001:l013","ordinal":65317,"en":"A rope's length in front of him"},{"id":"manas-2010:p1514:b001:l014","ordinal":65318,"en":"There is a pit he has dug;"},{"id":"manas-2010:p1514:b001:l015","ordinal":65319,"en":"Beyond the edge of the pit"},{"id":"manas-2010:p1514:b001:l016","ordinal":65320,"en":"Is a salt marsh where a horse will sink."},{"id":"manas-2010:p1514:b001:l017","ordinal":65321,"en":"Either when you fall into the pit"},{"id":"manas-2010:p1514:b001:l018","ordinal":65322,"en":"Or when your horse is bogged down,"},{"id":"manas-2010:p1514:b001:l019","ordinal":65323,"en":"To cut off your head,"},{"id":"manas-2010:p1514:b001:l020","ordinal":65324,"en":"There stands that mighty Kalcha.”"},{"id":"manas-2010:p1514:b001:l021","ordinal":65325,"en":"When your Almambet reached and rescued him,"},{"id":"manas-2010:p1514:b001:l022","ordinal":65326,"en":"Leading him out beside him,"},{"id":"manas-2010:p1514:b001:l023","ordinal":65327,"en":"Upon the Chinese people of forty khans"},{"id":"manas-2010:p1514:b001:l024","ordinal":65328,"en":"Pressure had fallen."},{"id":"manas-2010:p1514:b001:l025","ordinal":65329,"en":"Riding and prancing a rhinoceros,"},{"id":"manas-2010:p1514:b001:l026","ordinal":65330,"en":"Destroying all he met,"},{"id":"manas-2010:p1514:b001:l027","ordinal":65331,"en":"Tiken the giant had arrived."},{"id":"manas-2010:p1514:b001:l028","ordinal":65332,"en":"Joining Tiken the giant,"},{"id":"manas-2010:p1514:b001:l029","ordinal":65333,"en":"The true marksman Agayar,"},{"id":"manas-2010:p1514:b001:l030","ordinal":65334,"en":"Who had studied with Almambet,"},{"id":"manas-2010:p1514:b001:l031","ordinal":65335,"en":"He too had arrived."},{"id":"manas-2010:p1514:b001:l032","ordinal":65336,"en":"For the many Chinese driven back,"},{"id":"manas-2010:p1514:b001:l033","ordinal":65337,"en":"A day of rejoicing had dawned;"},{"id":"manas-2010:p1514:b001:l034","ordinal":65338,"en":"They had begun to beat their drums."},{"id":"manas-2010:p1514:b001:l035","ordinal":65339,"en":"A lion whose size was a mountain,"},{"id":"manas-2010:p1514:b001:l036","ordinal":65340,"en":"The arriving Tiken the giant"},{"id":"manas-2010:p1514:b001:l037","ordinal":65341,"en":"Was a lion from Beijing."},{"id":"manas-2010:p1514:b001:l038","ordinal":65342,"en":"His marksmen led by Agayar,"},{"id":"manas-2010:p1514:b001:l039","ordinal":65343,"en":"Tiken the giant arrayed them and charged."},{"id":"manas-2010:p1514:b001:l040","ordinal":65344,"en":"Angrily he said to the Kalcha,"},{"id":"manas-2010:p1514:b001:l041","ordinal":65345,"en":"“How have you ruled the people,"},{"id":"manas-2010:p1514:b001:l042","ordinal":65346,"en":"Mounted the golden throne,"},{"id":"manas-2010:p1515:b001:l001","ordinal":65347,"en":"And until now the Burut—"},{"id":"manas-2010:p1515:b001:l002","ordinal":65348,"en":"Why have you left them alive?”"},{"id":"manas-2010:p1515:b001:l003","ordinal":65349,"en":"Putting the Kalcha before him,"},{"id":"manas-2010:p1515:b001:l004","ordinal":65350,"en":"Tiken the giant drove him forward."},{"id":"manas-2010:p1515:b001:l005","ordinal":65351,"en":"Joined when they were small as lice,"},{"id":"manas-2010:p1515:b001:l006","ordinal":65352,"en":"Together when they were thumb-sized,"},{"id":"manas-2010:p1515:b001:l007","ordinal":65353,"en":"Azizkan's Almambet"},{"id":"manas-2010:p1515:b001:l008","ordinal":65354,"en":"Knew the ways of the Chinese."},{"id":"manas-2010:p1515:b001:l009","ordinal":65355,"en":"That they were Agayar and Tiken,"},{"id":"manas-2010:p1515:b001:l010","ordinal":65356,"en":"That they had now arrived,"},{"id":"manas-2010:p1515:b001:l011","ordinal":65357,"en":"Almambet knew."},{"id":"manas-2010:p1515:b001:l012","ordinal":65358,"en":"Then your Almambet said this:"},{"id":"manas-2010:p1515:b001:l013","ordinal":65359,"en":"“In the kakan's Beijing,"},{"id":"manas-2010:p1515:b001:l014","ordinal":65360,"en":"There was a champion kept and nourished."},{"id":"manas-2010:p1515:b001:l015","ordinal":65361,"en":"Karykan, khan of Beijing,"},{"id":"manas-2010:p1515:b001:l016","ordinal":65362,"en":"Torment and death"},{"id":"manas-2010:p1515:b001:l017","ordinal":65363,"en":"Could know six months beforehand;"},{"id":"manas-2010:p1515:b001:l018","ordinal":65364,"en":"He was rich in wisdom."},{"id":"manas-2010:p1515:b001:l019","ordinal":65365,"en":"‘In Beijing untouched by the Flood,"},{"id":"manas-2010:p1515:b001:l020","ordinal":65366,"en":"When a hellish battle comes,"},{"id":"manas-2010:p1515:b001:l021","ordinal":65367,"en":"When the Chinese rise,"},{"id":"manas-2010:p1515:b001:l022","ordinal":65368,"en":"He will come out without delay,’ he said,"},{"id":"manas-2010:p1515:b001:l023","ordinal":65369,"en":"And kept that man nourished."},{"id":"manas-2010:p1515:b001:l024","ordinal":65370,"en":"His champion has arrived;"},{"id":"manas-2010:p1515:b001:l025","ordinal":65371,"en":"Named Tiken the giant,"},{"id":"manas-2010:p1515:b001:l026","ordinal":65372,"en":"His fortress has arrived."},{"id":"manas-2010:p1515:b001:l027","ordinal":65373,"en":"In my childhood,"},{"id":"manas-2010:p1515:b001:l028","ordinal":65374,"en":"Before the dragon,"},{"id":"manas-2010:p1515:b001:l029","ordinal":65375,"en":"When, saying, ‘We shall study,’"},{"id":"manas-2010:p1515:b001:l030","ordinal":65376,"en":"Six thousand children went,"},{"id":"manas-2010:p1515:b001:l031","ordinal":65377,"en":"And six thousand of them perished,"},{"id":"manas-2010:p1515:b001:l032","ordinal":65378,"en":"When six children remained,"},{"id":"manas-2010:p1515:b001:l033","ordinal":65379,"en":"One of them was Agayar;"},{"id":"manas-2010:p1515:b001:l034","ordinal":65380,"en":"He too has now arrived."},{"id":"manas-2010:p1515:b001:l035","ordinal":65381,"en":"A great marksman in the treasury's service,"},{"id":"manas-2010:p1515:b001:l036","ordinal":65382,"en":"Who comes out when the Chinese rise;"},{"id":"manas-2010:p1515:b001:l037","ordinal":65383,"en":"Be ready to defend your life,"},{"id":"manas-2010:p1515:b001:l038","ordinal":65384,"en":"My darling Syrgak!"},{"id":"manas-2010:p1515:b001:l039","ordinal":65385,"en":"I shall not let them take me;"},{"id":"manas-2010:p1515:b001:l040","ordinal":65386,"en":"The reason they shall not take me—"},{"id":"manas-2010:p1515:b001:l041","ordinal":65387,"en":"I have saddled Sarala."},{"id":"manas-2010:p1515:b001:l042","ordinal":65388,"en":"When I was a headstrong child,"},{"id":"manas-2010:p1516:b001:l001","ordinal":65389,"en":"Than these two who have arrived,"},{"id":"manas-2010:p1516:b001:l002","ordinal":65390,"en":"I studied about six months earlier.”"},{"id":"manas-2010:p1516:b001:l003","ordinal":65391,"en":"Before he had closed his mouth,"},{"id":"manas-2010:p1516:b001:l004","ordinal":65392,"en":"Agayar, who lay in wait,"},{"id":"manas-2010:p1516:b001:l005","ordinal":65393,"en":"Bent his knees to the ground."},{"id":"manas-2010:p1516:b001:l006","ordinal":65394,"en":"Agayar did not move straight ahead;"},{"id":"manas-2010:p1516:b001:l007","ordinal":65395,"en":"He ran sideways."},{"id":"manas-2010:p1516:b001:l008","ordinal":65396,"en":"Changing his cap,"},{"id":"manas-2010:p1516:b001:l009","ordinal":65397,"en":"He had dressed himself in green,"},{"id":"manas-2010:p1516:b001:l010","ordinal":65398,"en":"And had gone into their midst."},{"id":"manas-2010:p1516:b001:l011","ordinal":65399,"en":"The plane tree of the mountain passes,"},{"id":"manas-2010:p1516:b001:l012","ordinal":65400,"en":"Kökötöy's shining lamp,"},{"id":"manas-2010:p1516:b001:l013","ordinal":65401,"en":"The star above his head,"},{"id":"manas-2010:p1516:b001:l014","ordinal":65402,"en":"Kökötöy's only son,"},{"id":"manas-2010:p1516:b001:l015","ordinal":65403,"en":"The spring that feeds the river—"},{"id":"manas-2010:p1516:b001:l016","ordinal":65404,"en":"When they saw Agayar,"},{"id":"manas-2010:p1516:b001:l017","ordinal":65405,"en":"The Chinese parted and dashed away."},{"id":"manas-2010:p1516:b001:l018","ordinal":65406,"en":"As he sat proudly on Maaniker,"},{"id":"manas-2010:p1516:b001:l019","ordinal":65407,"en":"Holding him crosswise,"},{"id":"manas-2010:p1516:b001:l020","ordinal":65408,"en":"That bastard marksman Agayar"},{"id":"manas-2010:p1516:b001:l021","ordinal":65409,"en":"Shot Bokmurun once."},{"id":"manas-2010:p1516:b001:l022","ordinal":65410,"en":"Kökötöy's only son,"},{"id":"manas-2010:p1516:b001:l023","ordinal":65411,"en":"His appointed death come, fell to the bullet;"},{"id":"manas-2010:p1516:b001:l024","ordinal":65412,"en":"He flew from his horse and fell with a thud."},{"id":"manas-2010:p1516:b001:l025","ordinal":65413,"en":"His half-open eyes barely showing,"},{"id":"manas-2010:p1516:b001:l026","ordinal":65414,"en":"His fine moustache lying smooth,"},{"id":"manas-2010:p1516:b001:l027","ordinal":65415,"en":"He set out for Judgment."},{"id":"manas-2010:p1516:b001:l028","ordinal":65416,"en":"Seeing this, Kongurbay"},{"id":"manas-2010:p1516:b001:l029","ordinal":65417,"en":"Stood roaring and shouting."},{"id":"manas-2010:p1516:b001:l030","ordinal":65418,"en":"Of ninety thousand Chinese and Manchu,"},{"id":"manas-2010:p1516:b001:l031","ordinal":65419,"en":"He scattered the tumult to dust,"},{"id":"manas-2010:p1516:b001:l032","ordinal":65420,"en":"Breaking up their ranks."},{"id":"manas-2010:p1516:b001:l033","ordinal":65421,"en":"“Their Syrgak, no bigger than a knucklebone—"},{"id":"manas-2010:p1516:b001:l034","ordinal":65422,"en":"Shoot him!” he roared."},{"id":"manas-2010:p1516:b001:l035","ordinal":65423,"en":"Hearing this, Agayar"},{"id":"manas-2010:p1516:b001:l036","ordinal":65424,"en":"Dashed toward Syrgak."},{"id":"manas-2010:p1516:b001:l037","ordinal":65425,"en":"At a lone ledge, a rocky cliff,"},{"id":"manas-2010:p1516:b001:l038","ordinal":65426,"en":"Just as he went to lie down,"},{"id":"manas-2010:p1516:b001:l039","ordinal":65427,"en":"At Syrgak who was nearby,"},{"id":"manas-2010:p1516:b001:l040","ordinal":65428,"en":"Just as he took aim to shoot,"},{"id":"manas-2010:p1516:b001:l041","ordinal":65429,"en":"The skilled Almambet"},{"id":"manas-2010:p1516:b001:l042","ordinal":65430,"en":"Took his lacquered musket in hand,"},{"id":"manas-2010:p1517:b001:l001","ordinal":65431,"en":"And aimed at the sorcerer."},{"id":"manas-2010:p1517:b001:l002","ordinal":65432,"en":"The expert marksman's"},{"id":"manas-2010:p1517:b001:l003","ordinal":65433,"en":"Hammer stood ready."},{"id":"manas-2010:p1517:b001:l004","ordinal":65434,"en":"“Agayar's head,” he said,"},{"id":"manas-2010:p1517:b001:l005","ordinal":65435,"en":"“His moon-like brow,” he said,"},{"id":"manas-2010:p1517:b001:l006","ordinal":65436,"en":"And pulled it once."},{"id":"manas-2010:p1517:b001:l007","ordinal":65437,"en":"His bullet reached him with a roar;"},{"id":"manas-2010:p1517:b001:l008","ordinal":65438,"en":"Of the sorcerer lying on the rock,"},{"id":"manas-2010:p1517:b001:l009","ordinal":65439,"en":"It tore off his head as it passed."},{"id":"manas-2010:p1517:b001:l010","ordinal":65440,"en":"From the farther side, Tiken the giant,"},{"id":"manas-2010:p1517:b001:l011","ordinal":65441,"en":"Whipping his rhinoceros,"},{"id":"manas-2010:p1517:b001:l012","ordinal":65442,"en":"Thundering like a storm,"},{"id":"manas-2010:p1517:b001:l013","ordinal":65443,"en":"Came toward your Almambet."},{"id":"manas-2010:p1517:b001:l014","ordinal":65444,"en":"When he drew near Almambet,"},{"id":"manas-2010:p1517:b001:l015","ordinal":65445,"en":"With his black hat's brim,"},{"id":"manas-2010:p1517:b001:l016","ordinal":65446,"en":"From where did he swoop like a falcon,"},{"id":"manas-2010:p1517:b001:l017","ordinal":65447,"en":"Khan Manas's Syrgak?"},{"id":"manas-2010:p1517:b001:l018","ordinal":65448,"en":"Before he could reach Almambet,"},{"id":"manas-2010:p1517:b001:l019","ordinal":65449,"en":"Syrgak reached him from the side;"},{"id":"manas-2010:p1517:b001:l020","ordinal":65450,"en":"As soon as he reached Tiken,"},{"id":"manas-2010:p1517:b001:l021","ordinal":65451,"en":"He struck him in the flank and rode past."},{"id":"manas-2010:p1517:b001:l022","ordinal":65452,"en":"When Syrgak had thrust and passed,"},{"id":"manas-2010:p1517:b001:l023","ordinal":65453,"en":"The mighty wolf born Almambet"},{"id":"manas-2010:p1517:b001:l024","ordinal":65454,"en":"Set himself aright;"},{"id":"manas-2010:p1517:b001:l025","ordinal":65455,"en":"To spear Tiken,"},{"id":"manas-2010:p1517:b001:l026","ordinal":65456,"en":"He moved in close."},{"id":"manas-2010:p1517:b001:l027","ordinal":65457,"en":"If you looked, Tiken was a hero,"},{"id":"manas-2010:p1517:b001:l028","ordinal":65458,"en":"A lion born of Beijing."},{"id":"manas-2010:p1517:b001:l029","ordinal":65459,"en":"He was thirty-five years old,"},{"id":"manas-2010:p1517:b001:l030","ordinal":65460,"en":"In the fullness of his prime."},{"id":"manas-2010:p1517:b001:l031","ordinal":65461,"en":"Though two lances struck at once,"},{"id":"manas-2010:p1517:b001:l032","ordinal":65462,"en":"Though both lions thrust together,"},{"id":"manas-2010:p1517:b001:l033","ordinal":65463,"en":"Even then Tiken did not stir."},{"id":"manas-2010:p1517:b001:l034","ordinal":65464,"en":"All the warriors grew excited;"},{"id":"manas-2010:p1517:b001:l035","ordinal":65465,"en":"Leaving the poor ones behind,"},{"id":"manas-2010:p1517:b001:l036","ordinal":65466,"en":"Only the foremost faced each other;"},{"id":"manas-2010:p1517:b001:l037","ordinal":65467,"en":"They joined together in battle."},{"id":"manas-2010:p1517:b001:l038","ordinal":65468,"en":"Muzburchak and Kökchö, two giants—"},{"id":"manas-2010:p1517:b001:l039","ordinal":65469,"en":"Before a word could be spoken, these two"},{"id":"manas-2010:p1517:b001:l040","ordinal":65470,"en":"Tiken the giant reached as well."},{"id":"manas-2010:p1517:b001:l041","ordinal":65471,"en":"As soon as he reached them,"},{"id":"manas-2010:p1517:b001:l042","ordinal":65472,"en":"He knocked both down and passed."},{"id":"manas-2010:p1518:b001:l001","ordinal":65473,"en":"Before the champions behind them"},{"id":"manas-2010:p1518:b001:l002","ordinal":65474,"en":"Could reach these two,"},{"id":"manas-2010:p1518:b001:l003","ordinal":65475,"en":"Azizkan's Almambet"},{"id":"manas-2010:p1518:b001:l004","ordinal":65476,"en":"Reached Muzburchak."},{"id":"manas-2010:p1518:b001:l005","ordinal":65477,"en":"As soon as he reached him, Almambet"},{"id":"manas-2010:p1518:b001:l006","ordinal":65478,"en":"Slung him behind like a feedbag,"},{"id":"manas-2010:p1518:b001:l007","ordinal":65479,"en":"And carried him swiftly away."},{"id":"manas-2010:p1518:b001:l008","ordinal":65480,"en":"Keeping him from capture, he put him on a horse"},{"id":"manas-2010:p1518:b001:l009","ordinal":65481,"en":"And took him away alive."},{"id":"manas-2010:p1518:b001:l010","ordinal":65482,"en":"To Aydarkan's Kökchö,"},{"id":"manas-2010:p1518:b001:l011","ordinal":65483,"en":"The lion Chubak came."},{"id":"manas-2010:p1518:b001:l012","ordinal":65484,"en":"As soon as he reached Kökchö,"},{"id":"manas-2010:p1518:b001:l013","ordinal":65485,"en":"He leaned down and scooped him up;"},{"id":"manas-2010:p1518:b001:l014","ordinal":65486,"en":"He mounted him on Kögala,"},{"id":"manas-2010:p1518:b001:l015","ordinal":65487,"en":"Dressed him in his blue armor,"},{"id":"manas-2010:p1518:b001:l016","ordinal":65488,"en":"And took him away alive."},{"id":"manas-2010:p1518:b001:l017","ordinal":65489,"en":"Watching at that moment,"},{"id":"manas-2010:p1518:b001:l018","ordinal":65490,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1518:b001:l019","ordinal":65491,"en":"Toward Akbaltay's Chubak"},{"id":"manas-2010:p1518:b001:l020","ordinal":65492,"en":"He too came with a roar."},{"id":"manas-2010:p1518:b001:l021","ordinal":65493,"en":"From the back of Kögala,"},{"id":"manas-2010:p1518:b001:l022","ordinal":65494,"en":"Chubak, vast as a mountain,"},{"id":"manas-2010:p1518:b001:l023","ordinal":65495,"en":"He knocked down and rode past."},{"id":"manas-2010:p1518:b001:l024","ordinal":65496,"en":"Before the Kalcha turned back into position,"},{"id":"manas-2010:p1518:b001:l025","ordinal":65497,"en":"Khan Ulak's Syrgak,"},{"id":"manas-2010:p1518:b001:l026","ordinal":65498,"en":"Whipping Kökchebich,"},{"id":"manas-2010:p1518:b001:l027","ordinal":65499,"en":"Arrived before an arrow could."},{"id":"manas-2010:p1518:b001:l028","ordinal":65500,"en":"The imposing Kalcha,"},{"id":"manas-2010:p1518:b001:l029","ordinal":65501,"en":"As soon as hero Syrgak reached him,"},{"id":"manas-2010:p1518:b001:l030","ordinal":65502,"en":"From the back of Algara"},{"id":"manas-2010:p1518:b001:l031","ordinal":65503,"en":"He knocked him down and rode past."},{"id":"manas-2010:p1518:b001:l032","ordinal":65504,"en":"Whipping Sarala,"},{"id":"manas-2010:p1518:b001:l033","ordinal":65505,"en":"Spurring on this side and that,"},{"id":"manas-2010:p1518:b001:l034","ordinal":65506,"en":"“I shall cut off his head,”"},{"id":"manas-2010:p1518:b001:l035","ordinal":65507,"en":"Almambet came, crying, “Go!”"},{"id":"manas-2010:p1518:b001:l036","ordinal":65508,"en":"At that time Tiken the giant,"},{"id":"manas-2010:p1518:b001:l037","ordinal":65509,"en":"Taking a club as big as a house,"},{"id":"manas-2010:p1518:b001:l038","ordinal":65510,"en":"Was coming toward Chubak,"},{"id":"manas-2010:p1518:b001:l039","ordinal":65511,"en":"The daredevil fallen from his horse."},{"id":"manas-2010:p1518:b001:l040","ordinal":65512,"en":"His mount Kögala stood there;"},{"id":"manas-2010:p1518:b001:l041","ordinal":65513,"en":"Argynkan's Azhybay"},{"id":"manas-2010:p1518:b001:l042","ordinal":65514,"en":"Came leading him alongside."},{"id":"manas-2010:p1519:b001:l001","ordinal":65515,"en":"As soon as he reached Chubak,"},{"id":"manas-2010:p1519:b001:l002","ordinal":65516,"en":"He mounted him on Kögala"},{"id":"manas-2010:p1519:b001:l003","ordinal":65517,"en":"And took him away alive."},{"id":"manas-2010:p1519:b001:l004","ordinal":65518,"en":"Before Almambet could arrive,"},{"id":"manas-2010:p1519:b001:l005","ordinal":65519,"en":"Before he could cut off his head,"},{"id":"manas-2010:p1519:b001:l006","ordinal":65520,"en":"Forty champions of the Chinese"},{"id":"manas-2010:p1519:b001:l007","ordinal":65521,"en":"Had reached Kongurbay;"},{"id":"manas-2010:p1519:b001:l008","ordinal":65522,"en":"They mounted him on Algara"},{"id":"manas-2010:p1519:b001:l009","ordinal":65523,"en":"And took him away alive."},{"id":"manas-2010:p1519:b001:l010","ordinal":65524,"en":"Drenched in dark blood,"},{"id":"manas-2010:p1519:b001:l011","ordinal":65525,"en":"Fighting this way and that,"},{"id":"manas-2010:p1519:b001:l012","ordinal":65526,"en":"A mighty battle took place."},{"id":"manas-2010:p1519:b001:l013","ordinal":65527,"en":"Stained with red blood,"},{"id":"manas-2010:p1519:b001:l014","ordinal":65528,"en":"Not sparing their lives a hair,"},{"id":"manas-2010:p1519:b001:l015","ordinal":65529,"en":"The wolves faced one another;"},{"id":"manas-2010:p1519:b001:l016","ordinal":65530,"en":"A terrible battle took place."},{"id":"manas-2010:p1519:b001:l017","ordinal":65531,"en":"At that time hero Syrgak,"},{"id":"manas-2010:p1519:b001:l018","ordinal":65532,"en":"The many champions and mighty lions—"},{"id":"manas-2010:p1519:b001:l019","ordinal":65533,"en":"He gave them not a speck of thought;"},{"id":"manas-2010:p1519:b001:l020","ordinal":65534,"en":"Not sparing his life a hair,"},{"id":"manas-2010:p1519:b001:l021","ordinal":65535,"en":"Beside Tiken the giant,"},{"id":"manas-2010:p1519:b001:l022","ordinal":65536,"en":"His warriors gathered as one;"}]
