[{"id":"seytek-2012:p0884:b002:l005","ordinal":363265,"en":"With human tears."},{"id":"seytek-2012:p0884:b002:l006","ordinal":363266,"en":"Along its flank"},{"id":"seytek-2012:p0884:b002:l007","ordinal":363267,"en":"It was covered with black horsehair,"},{"id":"seytek-2012:p0884:b002:l008","ordinal":363268,"en":"A tempered spear fit for war,"},{"id":"seytek-2012:p0884:b002:l009","ordinal":363269,"en":"Forged by Sarybay—"},{"id":"seytek-2012:p0884:b002:l010","ordinal":363270,"en":"Such was the manner of this strife."},{"id":"seytek-2012:p0884:b002:l011","ordinal":363271,"en":"When it found the measured mark,"},{"id":"seytek-2012:p0884:b002:l012","ordinal":363272,"en":"When it struck the mortal place,"},{"id":"seytek-2012:p0884:b002:l013","ordinal":363273,"en":"He did not flinch though it rang and rang;"},{"id":"seytek-2012:p0884:b002:l014","ordinal":363274,"en":"Even when death was at hand,"},{"id":"seytek-2012:p0884:b002:l015","ordinal":363275,"en":"He counted it less than a trifle."},{"id":"seytek-2012:p0884:b002:l016","ordinal":363276,"en":"He neither reeled nor stirred,"},{"id":"seytek-2012:p0884:b002:l017","ordinal":363277,"en":"The fearsome wrestler, mighty in wrath,"},{"id":"seytek-2012:p0884:b002:l018","ordinal":363278,"en":"Never budged a hair."},{"id":"seytek-2012:p0884:b002:l019","ordinal":363279,"en":"Furious yet unshaken,"},{"id":"seytek-2012:p0884:b002:l020","ordinal":363280,"en":"Strength and gigantic stature"},{"id":"seytek-2012:p0884:b002:l021","ordinal":363281,"en":"The Lord Most High had bestowed"},{"id":"seytek-2012:p0884:b002:l022","ordinal":363282,"en":"Upon that swine without measure."},{"id":"seytek-2012:p0884:b002:l023","ordinal":363283,"en":"Without blinking or twitching,"},{"id":"seytek-2012:p0884:b002:l024","ordinal":363284,"en":"Sarybay stood utterly still."},{"id":"seytek-2012:p0884:b002:l025","ordinal":363285,"en":"When Sarybay was pierced,"},{"id":"seytek-2012:p0884:b002:l026","ordinal":363286,"en":"The ancient tempered steel spear,"},{"id":"seytek-2012:p0884:b002:l027","ordinal":363287,"en":"The precious heirloom from his father,"},{"id":"seytek-2012:p0884:b002:l028","ordinal":363288,"en":"Splintered through the middle."},{"id":"seytek-2012:p0884:b002:l029","ordinal":363289,"en":"Then the prowess of brave, gray-maned Sarybay"},{"id":"seytek-2012:p0884:b002:l030","ordinal":363290,"en":"Was made manifest"},{"id":"seytek-2012:p0884:b002:l031","ordinal":363291,"en":"And revealed before the warriors."},{"id":"seytek-2012:p0884:b002:l032","ordinal":363292,"en":"He could shatter any mountain he met,"},{"id":"seytek-2012:p0884:b002:l033","ordinal":363293,"en":"While the white steed broad as a house"},{"id":"seytek-2012:p0884:b002:l034","ordinal":363294,"en":"Flew thundering over the plain."},{"id":"seytek-2012:p0884:b002:l035","ordinal":363295,"en":"There was no time to ready another spear—"},{"id":"seytek-2012:p0884:b002:l036","ordinal":363296,"en":"Damn this filthy world!"},{"id":"seytek-2012:p0884:b002:l037","ordinal":363297,"en":"No other course remained."},{"id":"seytek-2012:p0884:b002:l038","ordinal":363298,"en":"When laid to turf it kindled fire;"},{"id":"seytek-2012:p0884:b002:l039","ordinal":363299,"en":"Whatever it struck died in an instant;"},{"id":"seytek-2012:p0884:b002:l040","ordinal":363300,"en":"Wherever it landed, blood flowed,"},{"id":"seytek-2012:p0884:b003:l001","ordinal":363301,"en":"Wherever it slashed, life departed."},{"id":"seytek-2012:p0884:b003:l002","ordinal":363302,"en":"Life fled at its stroke:"},{"id":"seytek-2012:p0884:b003:l003","ordinal":363303,"en":"The Zulfiqar inherited"},{"id":"seytek-2012:p0884:b003:l004","ordinal":363304,"en":"From gray-maned Manas of old."},{"id":"seytek-2012:p0884:b003:l005","ordinal":363305,"en":"Seizing it by the hilt,"},{"id":"seytek-2012:p0884:b003:l006","ordinal":363306,"en":"Drawing it from its sheath,"},{"id":"seytek-2012:p0884:b003:l007","ordinal":363307,"en":"He reached him before one could shout, “Strike!”"},{"id":"seytek-2012:p0884:b003:l008","ordinal":363308,"en":"And with it the noble lion"},{"id":"seytek-2012:p0884:b003:l009","ordinal":363309,"en":"Slashed once again as he passed."},{"id":"seytek-2012:p0884:b003:l010","ordinal":363310,"en":"The other never saw the stroke, not even by a hair;"},{"id":"seytek-2012:p0884:b003:l011","ordinal":363311,"en":"From the calamity of doom and death,"},{"id":"seytek-2012:p0884:b003:l012","ordinal":363312,"en":"The swine saw no escape at last."},{"id":"seytek-2012:p0884:b003:l013","ordinal":363313,"en":"Roaring in menace,"},{"id":"seytek-2012:p0884:b003:l014","ordinal":363314,"en":"Bellowing in rage,"},{"id":"seytek-2012:p0884:b003:l015","ordinal":363315,"en":"Cracking like lightning,"},{"id":"seytek-2012:p0884:b003:l016","ordinal":363316,"en":"Thunderous as a dragon,"},{"id":"seytek-2012:p0884:b003:l017","ordinal":363317,"en":"He made every onlooker’s"},{"id":"seytek-2012:p0884:b003:l018","ordinal":363318,"en":"Whole body shudder."},{"id":"seytek-2012:p0884:b003:l019","ordinal":363319,"en":"His wrestler’s form stood revealed"},{"id":"seytek-2012:p0884:b003:l020","ordinal":363320,"en":"As he girded on his blue-mottled sword,"},{"id":"seytek-2012:p0884:b003:l021","ordinal":363321,"en":"Sprang like a blue tiger,"},{"id":"seytek-2012:p0884:b003:l022","ordinal":363322,"en":"Poured out his wrath and ground his teeth;"},{"id":"seytek-2012:p0884:b003:l023","ordinal":363323,"en":"His attacking arm knotted with power,"},{"id":"seytek-2012:p0884:b003:l024","ordinal":363324,"en":"His fury made the blood run cold,"},{"id":"seytek-2012:p0884:b003:l025","ordinal":363325,"en":"And when enraged, misery boiled over."},{"id":"seytek-2012:p0884:b003:l026","ordinal":363326,"en":"The accursed monster’s son,"},{"id":"seytek-2012:p0884:b003:l027","ordinal":363327,"en":"With his cast-iron head broad as a house—"},{"id":"seytek-2012:p0884:b003:l028","ordinal":363328,"en":"Flee far away if you see his deeds!"},{"id":"seytek-2012:p0884:b003:l029","ordinal":363329,"en":"He hacked down all who crossed him,"},{"id":"seytek-2012:p0884:b003:l030","ordinal":363330,"en":"Gnawed apart all he encountered,"},{"id":"seytek-2012:p0884:b003:l031","ordinal":363331,"en":"Destroyed all he set his eyes upon,"},{"id":"seytek-2012:p0884:b003:l032","ordinal":363332,"en":"Reduced matchlock-men to ashes,"},{"id":"seytek-2012:p0884:b003:l033","ordinal":363333,"en":"Filled his quiver with arrows,"},{"id":"seytek-2012:p0884:b003:l034","ordinal":363334,"en":"And annihilated all who fought him."},{"id":"seytek-2012:p0884:b003:l035","ordinal":363335,"en":"That was the deft one, that was the lion,"},{"id":"seytek-2012:p0884:b003:l036","ordinal":363336,"en":"That was the man endowed with courage."},{"id":"seytek-2012:p0884:b003:l037","ordinal":363337,"en":"He turned upon brave Seytek,"},{"id":"seytek-2012:p0884:b003:l038","ordinal":363338,"en":"Raising his battle-axe and sword"},{"id":"seytek-2012:p0884:b003:l039","ordinal":363339,"en":"Higher and higher,"},{"id":"seytek-2012:p0884:b003:l040","ordinal":363340,"en":"His black eyes filling with blood."},{"id":"seytek-2012:p0885:b002:l001","ordinal":363341,"en":"His cavernous mouth gaped wide,"},{"id":"seytek-2012:p0885:b002:l002","ordinal":363342,"en":"And the fire pouring from it"},{"id":"seytek-2012:p0885:b002:l003","ordinal":363343,"en":"Shot upward toward the sky."},{"id":"seytek-2012:p0885:b002:l004","ordinal":363344,"en":"His flesh quivered and his eyes blazed;"},{"id":"seytek-2012:p0885:b002:l005","ordinal":363345,"en":"His color fled, his arms drew taut."},{"id":"seytek-2012:p0885:b002:l006","ordinal":363346,"en":"Parting away in fury,"},{"id":"seytek-2012:p0885:b002:l007","ordinal":363347,"en":"Terrible in bearing and potent in venom,"},{"id":"seytek-2012:p0885:b002:l008","ordinal":363348,"en":"He took on the aspect of a dragon."},{"id":"seytek-2012:p0885:b002:l009","ordinal":363349,"en":"Wild with frenzy, he sprang,"},{"id":"seytek-2012:p0885:b002:l010","ordinal":363350,"en":"Preparing to attack brave Seytek,"},{"id":"seytek-2012:p0885:b002:l011","ordinal":363351,"en":"Raising his pinewood spear,"},{"id":"seytek-2012:p0885:b002:l012","ordinal":363352,"en":"And riding straight against him."},{"id":"seytek-2012:p0885:b002:l013","ordinal":363353,"en":"His staring eyes opened wide,"},{"id":"seytek-2012:p0885:b002:l014","ordinal":363354,"en":"And black venom from both corners of his mouth"},{"id":"seytek-2012:p0885:b002:l015","ordinal":363355,"en":"Spattered toward his ears."},{"id":"seytek-2012:p0885:b002:l016","ordinal":363356,"en":"His face bristled with coarse hair,"},{"id":"seytek-2012:p0885:b002:l017","ordinal":363357,"en":"Sparks flew from his mace,"},{"id":"seytek-2012:p0885:b002:l018","ordinal":363358,"en":"Fire flashed from both eyes,"},{"id":"seytek-2012:p0885:b002:l019","ordinal":363359,"en":"And dust rose from his heart."},{"id":"seytek-2012:p0885:b002:l020","ordinal":363360,"en":"He unleashed a terrible wrath;"},{"id":"seytek-2012:p0885:b002:l021","ordinal":363361,"en":"The people clamored and tumult broke out,"},{"id":"seytek-2012:p0885:b002:l022","ordinal":363362,"en":"And many, overcome with terror,"},{"id":"seytek-2012:p0885:b002:l023","ordinal":363363,"en":"Lost their senses and fled in disarray."},{"id":"seytek-2012:p0885:b002:l024","ordinal":363364,"en":"“The moon is dark, the night close at hand—"},{"id":"seytek-2012:p0885:b002:l025","ordinal":363365,"en":"What will this night bring?"},{"id":"seytek-2012:p0885:b002:l026","ordinal":363366,"en":"When the offspring of that fearsome lion"},{"id":"seytek-2012:p0885:b002:l027","ordinal":363367,"en":"Meets such a day of upheaval,"},{"id":"seytek-2012:p0885:b002:l028","ordinal":363368,"en":"What will daylight bring?”"},{"id":"seytek-2012:p0885:b002:l029","ordinal":363369,"en":"Sarybay was the one who clashed with him,"},{"id":"seytek-2012:p0885:b002:l030","ordinal":363370,"en":"Malicious in thought and narrow of heart."},{"id":"seytek-2012:p0885:b002:l031","ordinal":363371,"en":"He assailed the wrathful lion,"},{"id":"seytek-2012:p0885:b002:l032","ordinal":363372,"en":"And the hero became entangled in disaster;"},{"id":"seytek-2012:p0885:b002:l033","ordinal":363373,"en":"He had challenged a champion unlike any other."},{"id":"seytek-2012:p0885:b002:l034","ordinal":363374,"en":"“O lion who departed for the other world,"},{"id":"seytek-2012:p0885:b002:l035","ordinal":363375,"en":"Gray-maned one, cast down your gaze!"},{"id":"seytek-2012:p0885:b002:l036","ordinal":363376,"en":"Watch over the child sheltered by your shade,"},{"id":"seytek-2012:p0885:b002:l037","ordinal":363377,"en":"The figure left behind you,"},{"id":"seytek-2012:p0885:b002:l038","ordinal":363378,"en":"The falcon you reared,"},{"id":"seytek-2012:p0885:b002:l039","ordinal":363379,"en":"The courser you suckled,"},{"id":"seytek-2012:p0885:b002:l040","ordinal":363380,"en":"The young hero left as your gift,"},{"id":"seytek-2012:p0885:b003:l001","ordinal":363381,"en":"The lamp burning upon the ridge."},{"id":"seytek-2012:p0885:b003:l002","ordinal":363382,"en":"Spirit of gray-maned Manas,"},{"id":"seytek-2012:p0885:b003:l003","ordinal":363383,"en":"Come yourself and sustain him!"},{"id":"seytek-2012:p0885:b003:l004","ordinal":363384,"en":"Bind fast the path"},{"id":"seytek-2012:p0885:b003:l005","ordinal":363385,"en":"Of this wrathful warrior-lion!"},{"id":"seytek-2012:p0885:b003:l006","ordinal":363386,"en":"Entangle and bar"},{"id":"seytek-2012:p0885:b003:l007","ordinal":363387,"en":"The way of that infidel Sarybay!"},{"id":"seytek-2012:p0885:b003:l008","ordinal":363388,"en":"True Almambet and brave Chubak,"},{"id":"seytek-2012:p0885:b003:l009","ordinal":363389,"en":"Protect the cherished boy Seytek;"},{"id":"seytek-2012:p0885:b003:l010","ordinal":363390,"en":"From the calamity of doom and death,"},{"id":"seytek-2012:p0885:b003:l011","ordinal":363391,"en":"Come to Seytek’s aid!”"},{"id":"seytek-2012:p0885:b003:l012","ordinal":363392,"en":"All the champions joined together,"},{"id":"seytek-2012:p0885:b003:l013","ordinal":363393,"en":"And the people cried out in tumult,"},{"id":"seytek-2012:p0885:b003:l014","ordinal":363394,"en":"Praying sincerely"},{"id":"seytek-2012:p0885:b003:l015","ordinal":363395,"en":"To the Creator, the spirits, and God:"},{"id":"seytek-2012:p0885:b003:l016","ordinal":363396,"en":"“O host of holy masters who protect us,"},{"id":"seytek-2012:p0885:b003:l017","ordinal":363397,"en":"Come and lend your aid;"},{"id":"seytek-2012:p0885:b003:l018","ordinal":363398,"en":"Forty holy guardians, Khizr and Ilyas,"},{"id":"seytek-2012:p0885:b003:l019","ordinal":363399,"en":"Come and shield the boy!"},{"id":"seytek-2012:p0885:b003:l020","ordinal":363400,"en":"From death’s bullet of steel,"},{"id":"seytek-2012:p0885:b003:l021","ordinal":363401,"en":"From the enemy’s iron snare,"},{"id":"seytek-2012:p0885:b003:l022","ordinal":363402,"en":"From the wrathful one’s hand,"},{"id":"seytek-2012:p0885:b003:l023","ordinal":363403,"en":"From the pit dug deep,"},{"id":"seytek-2012:p0885:b003:l024","ordinal":363404,"en":"From the bitterness boiled for him,"},{"id":"seytek-2012:p0885:b003:l025","ordinal":363405,"en":"From the fiery embers of hell,"},{"id":"seytek-2012:p0885:b003:l026","ordinal":363406,"en":"From the merciless, grim-faced"},{"id":"seytek-2012:p0885:b003:l027","ordinal":363407,"en":"True enemy’s hand—"},{"id":"seytek-2012:p0885:b003:l028","ordinal":363408,"en":"God, preserve the boy!”"},{"id":"seytek-2012:p0885:b003:l029","ordinal":363409,"en":"The people streamed about, crying aloud,"},{"id":"seytek-2012:p0885:b003:l030","ordinal":363410,"en":"Raising a roar as though the earth had split."},{"id":"seytek-2012:p0885:b003:l031","ordinal":363411,"en":"The poor folk lost their senses,"},{"id":"seytek-2012:p0885:b003:l032","ordinal":363412,"en":"Their thoughts scattered and divided."},{"id":"seytek-2012:p0885:b003:l033","ordinal":363413,"en":"Of monstrous strength and venom,"},{"id":"seytek-2012:p0885:b003:l034","ordinal":363414,"en":"Sarybay looked dreadful."},{"id":"seytek-2012:p0885:b003:l035","ordinal":363415,"en":"The vast host watching him"},{"id":"seytek-2012:p0885:b003:l036","ordinal":363416,"en":"Were dumbfounded and distraught."},{"id":"seytek-2012:p0885:b003:l037","ordinal":363417,"en":"The people lamented in anguish:"},{"id":"seytek-2012:p0885:b003:l038","ordinal":363418,"en":"“What will become of the boy?”"},{"id":"seytek-2012:p0885:b003:l039","ordinal":363419,"en":"The watching multitude"},{"id":"seytek-2012:p0885:b003:l040","ordinal":363420,"en":"Despaired of their tiny lives."},{"id":"seytek-2012:p0886:b002:l001","ordinal":363421,"en":"They swiftly cried, “Baabedin!”"},{"id":"seytek-2012:p0886:b002:l002","ordinal":363422,"en":"And those who knew the invocations"},{"id":"seytek-2012:p0886:b002:l003","ordinal":363423,"en":"Called on Aituyak,"},{"id":"seytek-2012:p0886:b002:l004","ordinal":363424,"en":"Quickly uttering every prayer:"},{"id":"seytek-2012:p0886:b002:l005","ordinal":363425,"en":"“His strength is strange, his fury great—"},{"id":"seytek-2012:p0886:b002:l006","ordinal":363426,"en":"God, cast the infidel beneath him!"},{"id":"seytek-2012:p0886:b002:l007","ordinal":363427,"en":"Let the cherished one, black as a crow,"},{"id":"seytek-2012:p0886:b002:l008","ordinal":363428,"en":"Let God set the boy above him!”"},{"id":"seytek-2012:p0886:b002:l009","ordinal":363429,"en":"Brave Seytek, bearer of the sacred standard,"},{"id":"seytek-2012:p0886:b002:l010","ordinal":363430,"en":"Was the lord of the people, a lion;"},{"id":"seytek-2012:p0886:b002:l011","ordinal":363431,"en":"He was the stronghold of their inheritance."},{"id":"seytek-2012:p0886:b002:l012","ordinal":363432,"en":"Set him in the vanguard and he brought good fortune;"},{"id":"seytek-2012:p0886:b002:l013","ordinal":363433,"en":"Let him lead, and he was like a myriad troops."},{"id":"seytek-2012:p0886:b002:l014","ordinal":363434,"en":"From a ridge he saw keenly;"},{"id":"seytek-2012:p0886:b002:l015","ordinal":363435,"en":"He was the heir bound to the people’s back."},{"id":"seytek-2012:p0886:b002:l016","ordinal":363436,"en":"While this boy lived,"},{"id":"seytek-2012:p0886:b002:l017","ordinal":363437,"en":"He was a black, snow-covered crag,"},{"id":"seytek-2012:p0886:b002:l018","ordinal":363438,"en":"And the people were his cherished own."},{"id":"seytek-2012:p0886:b002:l019","ordinal":363439,"en":"The people reeled in anguish,"},{"id":"seytek-2012:p0886:b002:l020","ordinal":363440,"en":"Praying to the figure"},{"id":"seytek-2012:p0886:b002:l021","ordinal":363441,"en":"Of the gray-maned lion dear as a crow."},{"id":"seytek-2012:p0886:b002:l022","ordinal":363442,"en":"The young champion who faced him"},{"id":"seytek-2012:p0886:b002:l023","ordinal":363443,"en":"Fought Sarybay—"},{"id":"seytek-2012:p0886:b002:l024","ordinal":363444,"en":"Such was their grappling."},{"id":"seytek-2012:p0886:b002:l025","ordinal":363445,"en":"As the people prayed in distress,"},{"id":"seytek-2012:p0886:b002:l026","ordinal":363446,"en":"Sarybay poured out his wrath"},{"id":"seytek-2012:p0886:b002:l027","ordinal":363447,"en":"And prepared to attack brave Seytek."},{"id":"seytek-2012:p0886:b002:l028","ordinal":363448,"en":"Beneath him was Tookyzyl,"},{"id":"seytek-2012:p0886:b002:l029","ordinal":363449,"en":"The red mountain that flew like a cloud,"},{"id":"seytek-2012:p0886:b002:l030","ordinal":363450,"en":"Both swift and steady;"},{"id":"seytek-2012:p0886:b002:l031","ordinal":363451,"en":"He tugged and trailed the reins,"},{"id":"seytek-2012:p0886:b002:l032","ordinal":363452,"en":"His doe-like eyes turning red,"},{"id":"seytek-2012:p0886:b002:l033","ordinal":363453,"en":"His argali stride stretching long."},{"id":"seytek-2012:p0886:b002:l034","ordinal":363454,"en":"Set upon stone, he never slipped;"},{"id":"seytek-2012:p0886:b002:l035","ordinal":363455,"en":"He never faltered on sandy ground,"},{"id":"seytek-2012:p0886:b002:l036","ordinal":363456,"en":"Never stumbled or tired,"},{"id":"seytek-2012:p0886:b002:l037","ordinal":363457,"en":"His parrot-like tail streaming."},{"id":"seytek-2012:p0886:b002:l038","ordinal":363458,"en":"A fully grown giant demon had come"},{"id":"seytek-2012:p0886:b002:l039","ordinal":363459,"en":"And asked for Tookyzyl;"},{"id":"seytek-2012:p0886:b002:l040","ordinal":363460,"en":"When he asked, the horse was not given,"},{"id":"seytek-2012:p0886:b003:l001","ordinal":363461,"en":"Nor had any cold-hearted stranger ridden him."},{"id":"seytek-2012:p0886:b003:l002","ordinal":363462,"en":"He pulled free and twisted the reins,"},{"id":"seytek-2012:p0886:b003:l003","ordinal":363463,"en":"And leapt whenever he saw water or ravine."},{"id":"seytek-2012:p0886:b003:l004","ordinal":363464,"en":"He never panicked at a battle cry;"},{"id":"seytek-2012:p0886:b003:l005","ordinal":363465,"en":"Once his hooves strode forward,"},{"id":"seytek-2012:p0886:b003:l006","ordinal":363466,"en":"He never stepped twice in the same track."},{"id":"seytek-2012:p0886:b003:l007","ordinal":363467,"en":"When he burst away, he left all others behind;"},{"id":"seytek-2012:p0886:b003:l008","ordinal":363468,"en":"When he ran, the black earth"},{"id":"seytek-2012:p0886:b003:l009","ordinal":363469,"en":"Split apart layer by layer."},{"id":"seytek-2012:p0886:b003:l010","ordinal":363470,"en":"Ill-fated Tookyzyl"},{"id":"seytek-2012:p0886:b003:l011","ordinal":363471,"en":"Revealed a supernatural form."},{"id":"seytek-2012:p0886:b003:l012","ordinal":363472,"en":"Set upon stone, he never slipped;"},{"id":"seytek-2012:p0886:b003:l013","ordinal":363473,"en":"Chasing wild asses, he caught them,"},{"id":"seytek-2012:p0886:b003:l014","ordinal":363474,"en":"And never tired of a full gallop."},{"id":"seytek-2012:p0886:b003:l015","ordinal":363475,"en":"He never slid from the heights,"},{"id":"seytek-2012:p0886:b003:l016","ordinal":363476,"en":"Nor did his speed diminish"},{"id":"seytek-2012:p0886:b003:l017","ordinal":363477,"en":"Against the mountain’s wild asses and deer."},{"id":"seytek-2012:p0886:b003:l018","ordinal":363478,"en":"When relentless Tookyzyl gave chase,"},{"id":"seytek-2012:p0886:b003:l019","ordinal":363479,"en":"No wild ass escaped him."},{"id":"seytek-2012:p0886:b003:l020","ordinal":363480,"en":"With his pale, low-lying mane,"},{"id":"seytek-2012:p0886:b003:l021","ordinal":363481,"en":"When sparkling springs and lakes appeared,"},{"id":"seytek-2012:p0886:b003:l022","ordinal":363482,"en":"When some mighty creature opposed him,"},{"id":"seytek-2012:p0886:b003:l023","ordinal":363483,"en":"When a giant came intending to seize him,"},{"id":"seytek-2012:p0886:b003:l024","ordinal":363484,"en":"He flung his forelock to the sky,"},{"id":"seytek-2012:p0886:b003:l025","ordinal":363485,"en":"Drove his hooves into the earth,"},{"id":"seytek-2012:p0886:b003:l026","ordinal":363486,"en":"And planted all four feet,"},{"id":"seytek-2012:p0886:b003:l027","ordinal":363487,"en":"Until whoever faced him wearied."},{"id":"seytek-2012:p0886:b003:l028","ordinal":363488,"en":"When that rabid Sarybay"},{"id":"seytek-2012:p0886:b003:l029","ordinal":363489,"en":"Was struck by Seytek’s spear,"},{"id":"seytek-2012:p0886:b003:l030","ordinal":363490,"en":"He raged in injured pride,"},{"id":"seytek-2012:p0886:b003:l031","ordinal":363491,"en":"Swelled with menace and constriction,"},{"id":"seytek-2012:p0886:b003:l032","ordinal":363492,"en":"Thrashing over the blood-slick earth."},{"id":"seytek-2012:p0886:b003:l033","ordinal":363493,"en":"The accursed one remained there,"},{"id":"seytek-2012:p0886:b003:l034","ordinal":363494,"en":"Wild enough to scorch the mountains."},{"id":"seytek-2012:p0886:b003:l035","ordinal":363495,"en":"He launched a dreadful frenzy,"},{"id":"seytek-2012:p0886:b003:l036","ordinal":363496,"en":"Ravaging valley and mountain,"},{"id":"seytek-2012:p0886:b003:l037","ordinal":363497,"en":"His blood burning from fury,"},{"id":"seytek-2012:p0886:b003:l038","ordinal":363498,"en":"Men losing their lives at the mere news of him,"},{"id":"seytek-2012:p0886:b003:l039","ordinal":363499,"en":"Blood streaming from both his eyes,"},{"id":"seytek-2012:p0886:b003:l040","ordinal":363500,"en":"Raving and running mad."},{"id":"seytek-2012:p0887:b002:l001","ordinal":363501,"en":"The ill-fated swine’s"},{"id":"seytek-2012:p0887:b002:l002","ordinal":363502,"en":"Bloodthirstiness stood revealed."},{"id":"seytek-2012:p0887:b002:l003","ordinal":363503,"en":"He turned Tookyzyl’s head,"},{"id":"seytek-2012:p0887:b002:l004","ordinal":363504,"en":"Hellfire blazing from his eyes;"},{"id":"seytek-2012:p0887:b002:l005","ordinal":363505,"en":"Thus did God strike"},{"id":"seytek-2012:p0887:b002:l006","ordinal":363506,"en":"The warrior, brave Sarybay."},{"id":"seytek-2012:p0887:b002:l007","ordinal":363507,"en":"Raging and springing forward,"},{"id":"seytek-2012:p0887:b002:l008","ordinal":363508,"en":"He slung crosswise his black-steel,"},{"id":"seytek-2012:p0887:b002:l009","ordinal":363509,"en":"All-cutting sword."},{"id":"seytek-2012:p0887:b002:l010","ordinal":363510,"en":"His soul boiled with bitter fury,"},{"id":"seytek-2012:p0887:b002:l011","ordinal":363511,"en":"His eyes blazed like a wolf’s."},{"id":"seytek-2012:p0887:b002:l012","ordinal":363512,"en":"He turned his courser’s head,"},{"id":"seytek-2012:p0887:b002:l013","ordinal":363513,"en":"And the raving madman"},{"id":"seytek-2012:p0887:b002:l014","ordinal":363514,"en":"At once renewed the battle."},{"id":"seytek-2012:p0887:b002:l015","ordinal":363515,"en":"Facing brave Seytek,"},{"id":"seytek-2012:p0887:b002:l016","ordinal":363516,"en":"He rumbled and worked himself up,"},{"id":"seytek-2012:p0887:b002:l017","ordinal":363517,"en":"Transfigured by his straining strength."},{"id":"seytek-2012:p0887:b002:l018","ordinal":363518,"en":"His shout could split a head,"},{"id":"seytek-2012:p0887:b002:l019","ordinal":363519,"en":"Set snow aflame, and shatter stone:"},{"id":"seytek-2012:p0887:b002:l020","ordinal":363520,"en":"“Since I became Sarybay,"}]
