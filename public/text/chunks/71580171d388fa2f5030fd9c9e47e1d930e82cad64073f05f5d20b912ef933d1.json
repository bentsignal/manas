[{"id":"seytek-2012:p0035:b003:l040","ordinal":296705,"en":"Look kindly upon it and approve."},{"id":"seytek-2012:p0036:b002:l001","ordinal":296706,"en":"So they plunge into intrigue."},{"id":"seytek-2012:p0036:b002:l002","ordinal":296707,"en":"If you ask what our people are like:"},{"id":"seytek-2012:p0036:b002:l003","ordinal":296708,"en":"They share one heart with warriors,"},{"id":"seytek-2012:p0036:b002:l004","ordinal":296709,"en":"Match strength with wrestlers,"},{"id":"seytek-2012:p0036:b002:l005","ordinal":296710,"en":"Stand face-to-face with champions,"},{"id":"seytek-2012:p0036:b002:l006","ordinal":296711,"en":"And rival orators in eloquence!"},{"id":"seytek-2012:p0036:b002:l007","ordinal":296712,"en":"Leopards favored by the wolf’s fortune,"},{"id":"seytek-2012:p0036:b002:l008","ordinal":296713,"en":"A singular and blessed nation,"},{"id":"seytek-2012:p0036:b002:l009","ordinal":296714,"en":"Whom no man dares confront"},{"id":"seytek-2012:p0036:b002:l010","ordinal":296715,"en":"And no enemy has defeated."},{"id":"seytek-2012:p0036:b002:l011","ordinal":296716,"en":"The bravest of heroes dwell among us—"},{"id":"seytek-2012:p0036:b002:l012","ordinal":296717,"en":"What a splendid people are ours!"},{"id":"seytek-2012:p0036:b002:l013","ordinal":296718,"en":"Our dark fields abound in rice;"},{"id":"seytek-2012:p0036:b002:l014","ordinal":296719,"en":"Such is the richness of our land."},{"id":"seytek-2012:p0036:b002:l015","ordinal":296720,"en":"We have more silver than tin,"},{"id":"seytek-2012:p0036:b002:l016","ordinal":296721,"en":"More camels than other livestock,"},{"id":"seytek-2012:p0036:b002:l017","ordinal":296722,"en":"And more giants than weaklings—"},{"id":"seytek-2012:p0036:b002:l018","ordinal":296723,"en":"What a splendid people are ours!"},{"id":"seytek-2012:p0036:b002:l019","ordinal":296724,"en":"Herds of wild asses gather on the plains,"},{"id":"seytek-2012:p0036:b002:l020","ordinal":296725,"en":"Argali graze upon the hills,"},{"id":"seytek-2012:p0036:b002:l021","ordinal":296726,"en":"Ibex roam the crags,"},{"id":"seytek-2012:p0036:b002:l022","ordinal":296727,"en":"Wolves prowl the lower slopes,"},{"id":"seytek-2012:p0036:b002:l023","ordinal":296728,"en":"And foxes frolic on the rolling steppe."},{"id":"seytek-2012:p0036:b002:l024","ordinal":296729,"en":"Nightingales sing in the willows."},{"id":"seytek-2012:p0036:b002:l025","ordinal":296730,"en":"In our broad Talas valley,"},{"id":"seytek-2012:p0036:b002:l026","ordinal":296731,"en":"Not a single tree lacks delight."},{"id":"seytek-2012:p0036:b002:l027","ordinal":296732,"en":"Red deer bellow in the thickets,"},{"id":"seytek-2012:p0036:b002:l028","ordinal":296733,"en":"Cuckoos call from the plane trees,"},{"id":"seytek-2012:p0036:b002:l029","ordinal":296734,"en":"Eagles beat their wings on the rocks,"},{"id":"seytek-2012:p0036:b002:l030","ordinal":296735,"en":"And falcons strain upon their perches."},{"id":"seytek-2012:p0036:b002:l031","ordinal":296736,"en":"Every creature that possesses life"},{"id":"seytek-2012:p0036:b002:l032","ordinal":296737,"en":"Lives in Talas, our land—"},{"id":"seytek-2012:p0036:b002:l033","ordinal":296738,"en":"All living things are there."},{"id":"seytek-2012:p0036:b002:l034","ordinal":296739,"en":"When will we reach that broad green-mottled valley?"},{"id":"seytek-2012:p0036:b002:l035","ordinal":296740,"en":"When will that day come?"},{"id":"seytek-2012:p0036:b002:l036","ordinal":296741,"en":"Dearly remembered Karachach,"},{"id":"seytek-2012:p0036:b002:l037","ordinal":296742,"en":"When will we reach our people?”"},{"id":"seytek-2012:p0036:b002:l038","ordinal":296743,"en":"To share one inheritance,"},{"id":"seytek-2012:p0036:b002:l039","ordinal":296744,"en":"And, if happy days returned,"},{"id":"seytek-2012:p0036:b002:l040","ordinal":296745,"en":"To go back to Talas,"},{"id":"seytek-2012:p0036:b003:l001","ordinal":296746,"en":"There was a woman named Karachach."},{"id":"seytek-2012:p0036:b003:l002","ordinal":296747,"en":"She lived as a lowly serving woman,"},{"id":"seytek-2012:p0036:b003:l003","ordinal":296748,"en":"A soul enduring humiliation."},{"id":"seytek-2012:p0036:b003:l004","ordinal":296749,"en":"After Aichürök arrived,"},{"id":"seytek-2012:p0036:b003:l005","ordinal":296750,"en":"Her weary spirit revived,"},{"id":"seytek-2012:p0036:b003:l006","ordinal":296751,"en":"All her sorrows vanished,"},{"id":"seytek-2012:p0036:b003:l007","ordinal":296752,"en":"Her hollow parts filled with milk,"},{"id":"seytek-2012:p0036:b003:l008","ordinal":296753,"en":"Her gaunt limbs filled with flesh,"},{"id":"seytek-2012:p0036:b003:l009","ordinal":296754,"en":"What had been broken was restored,"},{"id":"seytek-2012:p0036:b003:l010","ordinal":296755,"en":"What had been scattered was gathered,"},{"id":"seytek-2012:p0036:b003:l011","ordinal":296756,"en":"And her misery and anguish disappeared."},{"id":"seytek-2012:p0036:b003:l012","ordinal":296757,"en":"The wretched woman and Aichürök"},{"id":"seytek-2012:p0036:b003:l013","ordinal":296758,"en":"Spoke of God together,"},{"id":"seytek-2012:p0036:b003:l014","ordinal":296759,"en":"And swore an oath unto death."},{"id":"seytek-2012:p0036:b003:l015","ordinal":296760,"en":"When they sat, they sat side by side;"},{"id":"seytek-2012:p0036:b003:l016","ordinal":296761,"en":"When they prepared food, they did so together."},{"id":"seytek-2012:p0036:b003:l017","ordinal":296762,"en":"Whenever they sat or rose, they spoke"},{"id":"seytek-2012:p0036:b003:l018","ordinal":296763,"en":"Of returning to broad Talas"},{"id":"seytek-2012:p0036:b003:l019","ordinal":296764,"en":"And coming into a shared inheritance."},{"id":"seytek-2012:p0036:b003:l020","ordinal":296765,"en":"They sealed their pledge,"},{"id":"seytek-2012:p0036:b003:l021","ordinal":296766,"en":"And among the women and children of the house"},{"id":"seytek-2012:p0036:b003:l022","ordinal":296767,"en":"Swore an oath binding unto death."},{"id":"seytek-2012:p0036:b003:l023","ordinal":296768,"en":"Aichürök would continually"},{"id":"seytek-2012:p0036:b003:l024","ordinal":296769,"en":"Tell Karachach about her people"},{"id":"seytek-2012:p0036:b003:l025","ordinal":296770,"en":"And praise them to her;"},{"id":"seytek-2012:p0036:b003:l026","ordinal":296771,"en":"She praised Jylgyndy, Keng-Kol, and broad Talas,"},{"id":"seytek-2012:p0036:b003:l027","ordinal":296772,"en":"And ever extolled her homeland."},{"id":"seytek-2012:p0036:b003:l028","ordinal":296773,"en":"“Our Talas is like this,” she said."},{"id":"seytek-2012:p0036:b003:l029","ordinal":296774,"en":"“Our Kyrgyz are a splendid people:"},{"id":"seytek-2012:p0036:b003:l030","ordinal":296775,"en":"With jingling hair ornaments and generous hips,"},{"id":"seytek-2012:p0036:b003:l031","ordinal":296776,"en":"Beautiful are the young wives of our land."},{"id":"seytek-2012:p0036:b003:l032","ordinal":296777,"en":"In red dresses, with waists curved like the moon,"},{"id":"seytek-2012:p0036:b003:l033","ordinal":296778,"en":"Beautiful are the maidens of our people."},{"id":"seytek-2012:p0036:b003:l034","ordinal":296779,"en":"In black coats and white kalpaks,"},{"id":"seytek-2012:p0036:b003:l035","ordinal":296780,"en":"Handsome are the young men of our land."},{"id":"seytek-2012:p0036:b003:l036","ordinal":296781,"en":"If you ask what our people are like,"},{"id":"seytek-2012:p0036:b003:l037","ordinal":296782,"en":"When bored, they hunt roe deer;"},{"id":"seytek-2012:p0036:b003:l038","ordinal":296783,"en":"When not bored, there in Talas"},{"id":"seytek-2012:p0036:b003:l039","ordinal":296784,"en":"They play at leisure."},{"id":"seytek-2012:p0036:b003:l040","ordinal":296785,"en":"They drink kumis and court the girls,"},{"id":"seytek-2012:p0037:b002:l001","ordinal":296786,"en":"To Aichürök’s side"},{"id":"seytek-2012:p0037:b002:l002","ordinal":296787,"en":"To bewitch her and take her child,"},{"id":"seytek-2012:p0037:b002:l003","ordinal":296788,"en":"They had gone in,"},{"id":"seytek-2012:p0037:b002:l004","ordinal":296789,"en":"Intent on bringing Chürök"},{"id":"seytek-2012:p0037:b002:l005","ordinal":296790,"en":"To some dreadful harm."},{"id":"seytek-2012:p0037:b002:l006","ordinal":296791,"en":"Once she knew their enmity,"},{"id":"seytek-2012:p0037:b002:l007","ordinal":296792,"en":"Moonlike Aichürök—"},{"id":"seytek-2012:p0037:b002:l008","ordinal":296793,"en":"Who could skim above a horse’s mane,"},{"id":"seytek-2012:p0037:b002:l009","ordinal":296794,"en":"Who could fly through the air,"},{"id":"seytek-2012:p0037:b002:l010","ordinal":296795,"en":"Who knew well how to fly—"},{"id":"seytek-2012:p0037:b002:l011","ordinal":296796,"en":"Would she fail to know an enemy?"},{"id":"seytek-2012:p0037:b002:l012","ordinal":296797,"en":"If she did, could she be Chürök!"},{"id":"seytek-2012:p0037:b002:l013","ordinal":296798,"en":"The keen-witted maid Karachach,"},{"id":"seytek-2012:p0037:b002:l014","ordinal":296799,"en":"The noble-born maid,"},{"id":"seytek-2012:p0037:b002:l015","ordinal":296800,"en":"When the wicked old women entered,"},{"id":"seytek-2012:p0037:b002:l016","ordinal":296801,"en":"Cast a chilling spell,"},{"id":"seytek-2012:p0037:b002:l017","ordinal":296802,"en":"And with boundless sorcery"},{"id":"seytek-2012:p0037:b002:l018","ordinal":296803,"en":"Blinded the eyes"},{"id":"seytek-2012:p0037:b002:l019","ordinal":296804,"en":"Of all seven old women."},{"id":"seytek-2012:p0037:b002:l020","ordinal":296805,"en":"The seven razors they had prepared"},{"id":"seytek-2012:p0037:b002:l021","ordinal":296806,"en":"Karachach secretly stole,"},{"id":"seytek-2012:p0037:b002:l022","ordinal":296807,"en":"And into a bottomless black well"},{"id":"seytek-2012:p0037:b002:l023","ordinal":296808,"en":"She carried and cast them:"},{"id":"seytek-2012:p0037:b002:l024","ordinal":296809,"en":"The instant the razors"},{"id":"seytek-2012:p0037:b002:l025","ordinal":296810,"en":"Struck the well,"},{"id":"seytek-2012:p0037:b002:l026","ordinal":296811,"en":"Unable to withstand their poison,"},{"id":"seytek-2012:p0037:b002:l027","ordinal":296812,"en":"The black stone beneath the water"},{"id":"seytek-2012:p0037:b002:l028","ordinal":296813,"en":"Split clean in two."},{"id":"seytek-2012:p0037:b002:l029","ordinal":296814,"en":"The old women wandered in a daze,"},{"id":"seytek-2012:p0037:b002:l030","ordinal":296815,"en":"Neither mad nor sane,"},{"id":"seytek-2012:p0037:b002:l031","ordinal":296816,"en":"And lost the razors"},{"id":"seytek-2012:p0037:b002:l032","ordinal":296817,"en":"The warrior had given them."},{"id":"seytek-2012:p0037:b002:l033","ordinal":296818,"en":"Yesterday, when they heaped humiliation upon us like sheep,"},{"id":"seytek-2012:p0037:b002:l034","ordinal":296819,"en":"When they plundered our royal camp,"},{"id":"seytek-2012:p0037:b002:l035","ordinal":296820,"en":"My valiant mother Kanykey"},{"id":"seytek-2012:p0037:b002:l036","ordinal":296821,"en":"Left this solemn charge: “Should you fail to guard him,"},{"id":"seytek-2012:p0037:b002:l037","ordinal":296822,"en":"Then to the enemy who counts us foes,"},{"id":"seytek-2012:p0037:b002:l038","ordinal":296823,"en":"When my foal is in desperate straits,"},{"id":"seytek-2012:p0037:b002:l039","ordinal":296824,"en":"Hand him over.”"},{"id":"seytek-2012:p0037:b002:l040","ordinal":296825,"en":"Yesterday, when havoc was wrought in Künjüt,"},{"id":"seytek-2012:p0037:b003:l001","ordinal":296826,"en":"Chürök proved a wise soul;"},{"id":"seytek-2012:p0037:b003:l002","ordinal":296827,"en":"She and Karachach"},{"id":"seytek-2012:p0037:b003:l003","ordinal":296828,"en":"Had made a pact."},{"id":"seytek-2012:p0037:b003:l004","ordinal":296829,"en":"How Kyyaz meant to bring disaster,"},{"id":"seytek-2012:p0037:b003:l005","ordinal":296830,"en":"And what the seven old women"},{"id":"seytek-2012:p0037:b003:l006","ordinal":296831,"en":"Had promised Kyyaz,"},{"id":"seytek-2012:p0037:b003:l007","ordinal":296832,"en":"Karachach had overheard."},{"id":"seytek-2012:p0037:b003:l008","ordinal":296833,"en":"Her knees buckling to the ground,"},{"id":"seytek-2012:p0037:b003:l009","ordinal":296834,"en":"She ran and reached Chürök,"},{"id":"seytek-2012:p0037:b003:l010","ordinal":296835,"en":"Who labored in birth,"},{"id":"seytek-2012:p0037:b003:l011","ordinal":296836,"en":"Her heart torn apart,"},{"id":"seytek-2012:p0037:b003:l012","ordinal":296837,"en":"Tears streaming from her eyes."},{"id":"seytek-2012:p0037:b003:l013","ordinal":296838,"en":"Before another word could be said,"},{"id":"seytek-2012:p0037:b003:l014","ordinal":296839,"en":"Karachach, flustered and frantic,"},{"id":"seytek-2012:p0037:b003:l015","ordinal":296840,"en":"Came to Aichürök:"},{"id":"seytek-2012:p0037:b003:l016","ordinal":296841,"en":"“My dearest elder sister,"},{"id":"seytek-2012:p0037:b003:l017","ordinal":296842,"en":"If only I see you safe, my heart will rest;"},{"id":"seytek-2012:p0037:b003:l018","ordinal":296843,"en":"I have no refuge but you."},{"id":"seytek-2012:p0037:b003:l019","ordinal":296844,"en":"Have you seen what I have seen?"},{"id":"seytek-2012:p0037:b003:l020","ordinal":296845,"en":"Do you know what I know?"},{"id":"seytek-2012:p0037:b003:l021","ordinal":296846,"en":"If you do not know what I know:"},{"id":"seytek-2012:p0037:b003:l022","ordinal":296847,"en":"Kyyaz, son of Bagysh—"},{"id":"seytek-2012:p0037:b003:l023","ordinal":296848,"en":"The Seven Valleys are no land for you,"},{"id":"seytek-2012:p0037:b003:l024","ordinal":296849,"en":"The Jediger are no people for you,"},{"id":"seytek-2012:p0037:b003:l025","ordinal":296850,"en":"And brave Kyyaz is no husband for you."},{"id":"seytek-2012:p0037:b003:l026","ordinal":296851,"en":"If you bear a son,"},{"id":"seytek-2012:p0037:b003:l027","ordinal":296852,"en":"All the old women have plotted"},{"id":"seytek-2012:p0037:b003:l028","ordinal":296853,"en":"To bewitch you, gouge out your eyes,"},{"id":"seytek-2012:p0037:b003:l029","ordinal":296854,"en":"Seize your child and slaughter him;"},{"id":"seytek-2012:p0037:b003:l030","ordinal":296855,"en":"They have sealed their pledge."},{"id":"seytek-2012:p0037:b003:l031","ordinal":296856,"en":"You were a lioness among women."},{"id":"seytek-2012:p0037:b003:l032","ordinal":296857,"en":"From wandering Almighty God,"},{"id":"seytek-2012:p0037:b003:l033","ordinal":296858,"en":"You were the one I prayed for."},{"id":"seytek-2012:p0037:b003:l034","ordinal":296859,"en":"Find a way to outwit"},{"id":"seytek-2012:p0037:b003:l035","ordinal":296860,"en":"The seven wicked old women, sister;"},{"id":"seytek-2012:p0037:b003:l036","ordinal":296861,"en":"Find the right words to answer"},{"id":"seytek-2012:p0037:b003:l037","ordinal":296862,"en":"The fierce infidel Kyyaz, sister!”"},{"id":"seytek-2012:p0037:b003:l038","ordinal":296863,"en":"Thus Karachach spoke,"},{"id":"seytek-2012:p0037:b003:l039","ordinal":296864,"en":"And before she had closed her mouth,"},{"id":"seytek-2012:p0037:b003:l040","ordinal":296865,"en":"The seven spell-casting old women—"},{"id":"seytek-2012:p0038:b002:l001","ordinal":296866,"en":"“All my flesh and bones"},{"id":"seytek-2012:p0038:b002:l002","ordinal":296867,"en":"Are about to burst apart."},{"id":"seytek-2012:p0038:b002:l003","ordinal":296868,"en":"Your hands bring healing to all they touch;"},{"id":"seytek-2012:p0038:b002:l004","ordinal":296869,"en":"You seven have come as holy women."},{"id":"seytek-2012:p0038:b002:l005","ordinal":296870,"en":"Lay hands upon the place that hurts,"},{"id":"seytek-2012:p0038:b002:l006","ordinal":296871,"en":"Mothers who master every remedy,"},{"id":"seytek-2012:p0038:b002:l007","ordinal":296872,"en":"Open my eyes, swollen like lumps of dough!”"},{"id":"seytek-2012:p0038:b002:l008","ordinal":296873,"en":"Thus Aichürök spoke"},{"id":"seytek-2012:p0038:b002:l009","ordinal":296874,"en":"And closed her mouth."},{"id":"seytek-2012:p0038:b002:l010","ordinal":296875,"en":"From the kumis mixed with poison,"},{"id":"seytek-2012:p0038:b002:l011","ordinal":296876,"en":"Seven bowls of kumis"},{"id":"seytek-2012:p0038:b002:l012","ordinal":296877,"en":"The deft and capable Karachach"},{"id":"seytek-2012:p0038:b002:l013","ordinal":296878,"en":"Poured for the old women."},{"id":"seytek-2012:p0038:b002:l014","ordinal":296879,"en":"Immeasurably nimble,"},{"id":"seytek-2012:p0038:b002:l015","ordinal":296880,"en":"The quick-moving poor girl"},{"id":"seytek-2012:p0038:b002:l016","ordinal":296881,"en":"Steeled herself like a hawk,"},{"id":"seytek-2012:p0038:b002:l017","ordinal":296882,"en":"Fawned upon the false old women,"},{"id":"seytek-2012:p0038:b002:l018","ordinal":296883,"en":"Measured poison by the ladle,"},{"id":"seytek-2012:p0038:b002:l019","ordinal":296884,"en":"And gave them water by the spoon."},{"id":"seytek-2012:p0038:b002:l020","ordinal":296885,"en":"She served all seven alike,"},{"id":"seytek-2012:p0038:b002:l021","ordinal":296886,"en":"Quickly, betraying no suspicion."},{"id":"seytek-2012:p0038:b002:l022","ordinal":296887,"en":"At dusk, as the sun went down"},{"id":"seytek-2012:p0038:b002:l023","ordinal":296888,"en":"And all the people lay sound asleep,"},{"id":"seytek-2012:p0038:b002:l024","ordinal":296889,"en":"She made every arrow ready in the quiver"},{"id":"seytek-2012:p0038:b002:l025","ordinal":296890,"en":"And sent the seven ill-fated old women"},{"id":"seytek-2012:p0038:b002:l026","ordinal":296891,"en":"Out of this world."},{"id":"seytek-2012:p0038:b002:l027","ordinal":296892,"en":"Beside the hearth"},{"id":"seytek-2012:p0038:b002:l028","ordinal":296893,"en":"She dug a pit,"},{"id":"seytek-2012:p0038:b002:l029","ordinal":296894,"en":"And the accomplished Aichürök"},{"id":"seytek-2012:p0038:b002:l030","ordinal":296895,"en":"Managed to slaughter all seven."},{"id":"seytek-2012:p0038:b002:l031","ordinal":296896,"en":"Folding them double at the waist,"},{"id":"seytek-2012:p0038:b002:l032","ordinal":296897,"en":"At the edge of the hearth"},{"id":"seytek-2012:p0038:b002:l033","ordinal":296898,"en":"She laid them in a hidden grave."},{"id":"seytek-2012:p0038:b002:l034","ordinal":296899,"en":"Without a single person knowing,"},{"id":"seytek-2012:p0038:b002:l035","ordinal":296900,"en":"Without anyone seeing,"},{"id":"seytek-2012:p0038:b002:l036","ordinal":296901,"en":"The seven witches died;"},{"id":"seytek-2012:p0038:b002:l037","ordinal":296902,"en":"The seven troublemakers went"},{"id":"seytek-2012:p0038:b002:l038","ordinal":296903,"en":"To the true abode from which none return."},{"id":"seytek-2012:p0038:b002:l039","ordinal":296904,"en":"Their seven lives were stilled,"},{"id":"seytek-2012:p0038:b002:l040","ordinal":296905,"en":"And the world was rid of all seven together."},{"id":"seytek-2012:p0038:b003:l001","ordinal":296906,"en":"When roaring leopard Manas"},{"id":"seytek-2012:p0038:b003:l002","ordinal":296907,"en":"Raided Künjüt long ago,"},{"id":"seytek-2012:p0038:b003:l003","ordinal":296908,"en":"This poison had brought merciless devastation;"},{"id":"seytek-2012:p0038:b003:l004","ordinal":296909,"en":"It was an evil that slaughtered men,"},{"id":"seytek-2012:p0038:b003:l005","ordinal":296910,"en":"A poison called “Soundless Death.”"},{"id":"seytek-2012:p0038:b003:l006","ordinal":296911,"en":"Whoever smelled it died;"},{"id":"seytek-2012:p0038:b003:l007","ordinal":296912,"en":"Whoever tasted it saw"},{"id":"seytek-2012:p0038:b003:l008","ordinal":296913,"en":"The true abode from which none return."},{"id":"seytek-2012:p0038:b003:l009","ordinal":296914,"en":"Its odor carried as far as men,"},{"id":"seytek-2012:p0038:b003:l010","ordinal":296915,"en":"And when anyone breathed it in,"},{"id":"seytek-2012:p0038:b003:l011","ordinal":296916,"en":"His gall would burst and he would die."},{"id":"seytek-2012:p0038:b003:l012","ordinal":296917,"en":"Whoever came within its scent perished;"},{"id":"seytek-2012:p0038:b003:l013","ordinal":296918,"en":"Any soul who came with evil intent"},{"id":"seytek-2012:p0038:b003:l014","ordinal":296919,"en":"Received his rightful punishment."},{"id":"seytek-2012:p0038:b003:l015","ordinal":296920,"en":"Aichürök, truly laboring in birth,"},{"id":"seytek-2012:p0038:b003:l016","ordinal":296921,"en":"Had poison ready,"},{"id":"seytek-2012:p0038:b003:l017","ordinal":296922,"en":"And meant to raise a terrible uproar"},{"id":"seytek-2012:p0038:b003:l018","ordinal":296923,"en":"Among the seven witching crones."},{"id":"seytek-2012:p0038:b003:l019","ordinal":296924,"en":"She ordered her maid:"},{"id":"seytek-2012:p0038:b003:l020","ordinal":296925,"en":"“Rise, Karachach, rise!"},{"id":"seytek-2012:p0038:b003:l021","ordinal":296926,"en":"These mothers have come thirsty;"},{"id":"seytek-2012:p0038:b003:l022","ordinal":296927,"en":"From the fresh golden kumis"},{"id":"seytek-2012:p0038:b003:l023","ordinal":296928,"en":"Pour some for your mothers."},{"id":"seytek-2012:p0038:b003:l024","ordinal":296929,"en":"Let their thirst be quenched,"},{"id":"seytek-2012:p0038:b003:l025","ordinal":296930,"en":"Let their swollen eyes open."},{"id":"seytek-2012:p0038:b003:l026","ordinal":296931,"en":"Hunger brings on illness,"},{"id":"seytek-2012:p0038:b003:l027","ordinal":296932,"en":"But a full belly restores good sense."},{"id":"seytek-2012:p0038:b003:l028","ordinal":296933,"en":"These mothers, healers of suffering,"},{"id":"seytek-2012:p0038:b003:l029","ordinal":296934,"en":"Bestow great blessings;"},{"id":"seytek-2012:p0038:b003:l030","ordinal":296935,"en":"From death and agony"},{"id":"seytek-2012:p0038:b003:l031","ordinal":296936,"en":"They wrench us free."},{"id":"seytek-2012:p0038:b003:l032","ordinal":296937,"en":"Their hands grasp the wrist and know their craft;"},{"id":"seytek-2012:p0038:b003:l033","ordinal":296938,"en":"They have two clear-seeing eyes,"},{"id":"seytek-2012:p0038:b003:l034","ordinal":296939,"en":"And speak true words when asked."},{"id":"seytek-2012:p0038:b003:l035","ordinal":296940,"en":"God creates the soul—"},{"id":"seytek-2012:p0038:b003:l036","ordinal":296941,"en":"You seven, find some remedy,"},{"id":"seytek-2012:p0038:b003:l037","ordinal":296942,"en":"For my soul is leaving me!"},{"id":"seytek-2012:p0038:b003:l038","ordinal":296943,"en":"My eyes stare dimly,"},{"id":"seytek-2012:p0038:b003:l039","ordinal":296944,"en":"My bones hang limp,"},{"id":"seytek-2012:p0038:b003:l040","ordinal":296945,"en":"And my fly-sized soul shrieks in pain.”"},{"id":"seytek-2012:p0039:b002:l001","ordinal":296946,"en":"“A falcon with talons of steel!”"},{"id":"seytek-2012:p0039:b002:l002","ordinal":296947,"en":"Overjoyed, Aichürök"},{"id":"seytek-2012:p0039:b002:l003","ordinal":296948,"en":"Throbbed with gratitude,"},{"id":"seytek-2012:p0039:b002:l004","ordinal":296949,"en":"And trembled with delight."},{"id":"seytek-2012:p0039:b002:l005","ordinal":296950,"en":"Wrapped in pure silk,"},{"id":"seytek-2012:p0039:b002:l006","ordinal":296951,"en":"Drenched entirely in blood,"},{"id":"seytek-2012:p0039:b002:l007","ordinal":296952,"en":"From the moment of birth this child"},{"id":"seytek-2012:p0039:b002:l008","ordinal":296953,"en":"Looked unlike any other:"},{"id":"seytek-2012:p0039:b002:l009","ordinal":296954,"en":"A black mane down his back"},{"id":"seytek-2012:p0039:b002:l010","ordinal":296955,"en":"Parted in two and streamed,"},{"id":"seytek-2012:p0039:b002:l011","ordinal":296956,"en":"And he looked exactly like"},{"id":"seytek-2012:p0039:b002:l012","ordinal":296957,"en":"His mighty gray-wolf lion of a father."},{"id":"seytek-2012:p0039:b002:l013","ordinal":296958,"en":"“His lashes are flame, his eyes live coals;"},{"id":"seytek-2012:p0039:b002:l014","ordinal":296959,"en":"No child like him was ever born."},{"id":"seytek-2012:p0039:b002:l015","ordinal":296960,"en":"Broad-browed and wide-shouldered,"}]
