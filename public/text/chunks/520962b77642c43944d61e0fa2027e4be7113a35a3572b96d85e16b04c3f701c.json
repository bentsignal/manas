[{"id":"semetey-1-2013:p0614:b003:l009","ordinal":123905,"en":"They appealed, led by Khan Koshoi."},{"id":"semetey-1-2013:p0614:b003:l010","ordinal":123906,"en":"‘She is greatly unfortunate,’ they said."},{"id":"semetey-1-2013:p0614:b003:l011","ordinal":123907,"en":"Ak Eshen looked and was awed."},{"id":"semetey-1-2013:p0614:b003:l012","ordinal":123908,"en":"Without leaving that cave,"},{"id":"semetey-1-2013:p0614:b003:l013","ordinal":123909,"en":"For my lion father himself,"},{"id":"semetey-1-2013:p0614:b003:l014","ordinal":123910,"en":"The forty ishans who served him"},{"id":"semetey-1-2013:p0614:b003:l015","ordinal":123911,"en":"Sixty times the Qur'an"},{"id":"semetey-1-2013:p0614:b003:l016","ordinal":123912,"en":"Recited from beginning to end."},{"id":"semetey-1-2013:p0614:b003:l017","ordinal":123913,"en":"Taking forty mighty strides,"},{"id":"semetey-1-2013:p0614:b003:l018","ordinal":123914,"en":"Your orphan left by the precious one"},{"id":"semetey-1-2013:p0614:b003:l019","ordinal":123915,"en":"Went farther inward."},{"id":"semetey-1-2013:p0614:b003:l020","ordinal":123916,"en":"At magnanimous Sultan Manas"},{"id":"semetey-1-2013:p0614:b003:l021","ordinal":123917,"en":"He fixed his gaze."},{"id":"semetey-1-2013:p0614:b003:l022","ordinal":123918,"en":"Smiling with his eyes closed,"},{"id":"semetey-1-2013:p0614:b003:l023","ordinal":123919,"en":"My khan father lay."},{"id":"semetey-1-2013:p0614:b003:l024","ordinal":123920,"en":"Among many loving companions"},{"id":"semetey-1-2013:p0614:b003:l025","ordinal":123921,"en":"My khan father lay surrounded."},{"id":"semetey-1-2013:p0614:b003:l026","ordinal":123922,"en":"My father was not alone;"},{"id":"semetey-1-2013:p0614:b003:l027","ordinal":123923,"en":"He was no khan to lie alone."},{"id":"semetey-1-2013:p0614:b003:l028","ordinal":123924,"en":"He was surrounded by many wonders."},{"id":"semetey-1-2013:p0614:b003:l029","ordinal":123925,"en":"My fierce-maned father, the noble lion,"},{"id":"semetey-1-2013:p0614:b003:l030","ordinal":123926,"en":"Tall and broad-shouldered,"},{"id":"semetey-1-2013:p0614:b003:l031","ordinal":123927,"en":"Both a mighty wrestler and a lion,"},{"id":"semetey-1-2013:p0614:b003:l032","ordinal":123928,"en":"A beauty of dusky complexion,"},{"id":"semetey-1-2013:p0614:b003:l033","ordinal":123929,"en":"Islam's young foal,"},{"id":"semetey-1-2013:p0614:b003:l034","ordinal":123930,"en":"Her waist slender as a sheath, her face like the moon—"},{"id":"semetey-1-2013:p0614:b003:l035","ordinal":123931,"en":"With a renowned beautiful maiden"},{"id":"semetey-1-2013:p0614:b003:l036","ordinal":123932,"en":"My khan father lay embracing,"},{"id":"semetey-1-2013:p0614:b003:l037","ordinal":123933,"en":"They lay together."},{"id":"semetey-1-2013:p0614:b003:l038","ordinal":123934,"en":"When he looked to the right,"},{"id":"semetey-1-2013:p0614:b003:l039","ordinal":123935,"en":"Brown eyes without a trace of gray,"},{"id":"semetey-1-2013:p0614:b004:l001","ordinal":123936,"en":"A white face without a freckle,"},{"id":"semetey-1-2013:p0614:b004:l002","ordinal":123937,"en":"A golden-bladed battle-ax,"},{"id":"semetey-1-2013:p0614:b004:l003","ordinal":123938,"en":"Its wrist-loop wound five times,"},{"id":"semetey-1-2013:p0614:b004:l004","ordinal":123939,"en":"Hung from his wrist."},{"id":"semetey-1-2013:p0614:b004:l005","ordinal":123940,"en":"Golden coats that no bullet could pierce—"},{"id":"semetey-1-2013:p0614:b004:l006","ordinal":123941,"en":"He wore ninety, one over another."},{"id":"semetey-1-2013:p0614:b004:l007","ordinal":123942,"en":"Girded with a silver belt,"},{"id":"semetey-1-2013:p0614:b004:l008","ordinal":123943,"en":"His sun-like face touched by radiance,"},{"id":"semetey-1-2013:p0614:b004:l009","ordinal":123944,"en":"Girded with a golden belt,"},{"id":"semetey-1-2013:p0614:b004:l010","ordinal":123945,"en":"His moon-like face touched by radiance,"},{"id":"semetey-1-2013:p0614:b004:l011","ordinal":123946,"en":"Smiling yet solemn,"},{"id":"semetey-1-2013:p0614:b004:l012","ordinal":123947,"en":"At my father's right"},{"id":"semetey-1-2013:p0614:b004:l013","ordinal":123948,"en":"Was a man of radiant countenance."},{"id":"semetey-1-2013:p0614:b004:l014","ordinal":123949,"en":"His mustache had grown long and trailing."},{"id":"semetey-1-2013:p0614:b004:l015","ordinal":123950,"en":"His face glowed red like a precious stone."},{"id":"semetey-1-2013:p0614:b004:l016","ordinal":123951,"en":"He did not open his closed eyes,"},{"id":"semetey-1-2013:p0614:b004:l017","ordinal":123952,"en":"Did not draw back his outstretched legs."},{"id":"semetey-1-2013:p0614:b004:l018","ordinal":123953,"en":"A man with a beautiful face,"},{"id":"semetey-1-2013:p0614:b004:l019","ordinal":123954,"en":"At my father's right"},{"id":"semetey-1-2013:p0614:b004:l020","ordinal":123955,"en":"Lay turned toward him."},{"id":"semetey-1-2013:p0614:b004:l021","ordinal":123956,"en":"When he looked to the left,"},{"id":"semetey-1-2013:p0614:b004:l022","ordinal":123957,"en":"As vast as half a mountain,"},{"id":"semetey-1-2013:p0614:b004:l023","ordinal":123958,"en":"If encountered in life,"},{"id":"semetey-1-2013:p0614:b004:l024","ordinal":123959,"en":"He seemed ready to devour whoever he faced."},{"id":"semetey-1-2013:p0614:b004:l025","ordinal":123960,"en":"The most skilled of spearmen,"},{"id":"semetey-1-2013:p0614:b004:l026","ordinal":123961,"en":"The finest among mankind,"},{"id":"semetey-1-2013:p0614:b004:l027","ordinal":123962,"en":"With the aspect of a hungry lion,"},{"id":"semetey-1-2013:p0614:b004:l028","ordinal":123963,"en":"His complexion tawny and dusky,"},{"id":"semetey-1-2013:p0614:b004:l029","ordinal":123964,"en":"Er Jamgyrchy shirt"},{"id":"semetey-1-2013:p0614:b004:l030","ordinal":123965,"en":"His countenance unlike that of any giant,"},{"id":"semetey-1-2013:p0614:b004:l031","ordinal":123966,"en":"Broad-chested and fearsome,"},{"id":"semetey-1-2013:p0614:b004:l032","ordinal":123967,"en":"Handsome and courageous,"},{"id":"semetey-1-2013:p0614:b004:l033","ordinal":123968,"en":"He did not draw back his outstretched legs,"},{"id":"semetey-1-2013:p0614:b004:l034","ordinal":123969,"en":"Did not open his closed eyes."},{"id":"semetey-1-2013:p0614:b004:l035","ordinal":123970,"en":"All his equipment was in readiness."},{"id":"semetey-1-2013:p0614:b004:l036","ordinal":123971,"en":"A golden-bladed battle-ax"},{"id":"semetey-1-2013:p0614:b004:l037","ordinal":123972,"en":"Lay ready at his right."},{"id":"semetey-1-2013:p0614:b004:l038","ordinal":123973,"en":"Smiling and lying rigid,"},{"id":"semetey-1-2013:p0614:b004:l039","ordinal":123974,"en":"His shovel-like teeth gleamed white,"},{"id":"semetey-1-2013:p0615:b003:l001","ordinal":123975,"en":"At my father's left,"},{"id":"semetey-1-2013:p0615:b003:l002","ordinal":123976,"en":"His gold-collared jacket"},{"id":"semetey-1-2013:p0615:b003:l003","ordinal":123977,"en":"Draped wide across him,"},{"id":"semetey-1-2013:p0615:b003:l004","ordinal":123978,"en":"Beside my dear father"},{"id":"semetey-1-2013:p0615:b003:l005","ordinal":123979,"en":"Lay another man."},{"id":"semetey-1-2013:p0615:b003:l006","ordinal":123980,"en":"At my father's feet"},{"id":"semetey-1-2013:p0615:b003:l007","ordinal":123981,"en":"Lay another man."},{"id":"semetey-1-2013:p0615:b003:l008","ordinal":123982,"en":"Of medium height, broad-shouldered,"},{"id":"semetey-1-2013:p0615:b003:l009","ordinal":123983,"en":"He too was a skilled spearman,"},{"id":"semetey-1-2013:p0615:b003:l010","ordinal":123984,"en":"The finest of the martyrs."},{"id":"semetey-1-2013:p0615:b003:l011","ordinal":123985,"en":"His head was like a great cauldron;"},{"id":"semetey-1-2013:p0615:b003:l012","ordinal":123986,"en":"His black brows seemed drawn with a line."},{"id":"semetey-1-2013:p0615:b003:l013","ordinal":123987,"en":"Between his two eyes"},{"id":"semetey-1-2013:p0615:b003:l014","ordinal":123988,"en":"Radiance poured forth; a lamp burned."},{"id":"semetey-1-2013:p0615:b003:l015","ordinal":123989,"en":"He was about twenty years old."},{"id":"semetey-1-2013:p0615:b003:l016","ordinal":123990,"en":"The sight of him burned the heart."},{"id":"semetey-1-2013:p0615:b003:l017","ordinal":123991,"en":"He wore a coat of blue iron,"},{"id":"semetey-1-2013:p0615:b003:l018","ordinal":123992,"en":"Rested his sword in its sheath."},{"id":"semetey-1-2013:p0615:b003:l019","ordinal":123993,"en":"His face was somewhat pale with sorrow,"},{"id":"semetey-1-2013:p0615:b003:l020","ordinal":123994,"en":"His features especially boyish."},{"id":"semetey-1-2013:p0615:b003:l021","ordinal":123995,"en":"At my father's feet"},{"id":"semetey-1-2013:p0615:b003:l022","ordinal":123996,"en":"There was a man lying with him."},{"id":"semetey-1-2013:p0615:b003:l023","ordinal":123997,"en":"The poor boy marveled."},{"id":"semetey-1-2013:p0615:b003:l024","ordinal":123998,"en":"When he looked toward the very head,"},{"id":"semetey-1-2013:p0615:b003:l025","ordinal":123999,"en":"A tall, true support,"},{"id":"semetey-1-2013:p0615:b003:l026","ordinal":124000,"en":"His appearance unlike anyone else's,"},{"id":"semetey-1-2013:p0615:b003:l027","ordinal":124001,"en":"At his temples, as a ritual sign,"},{"id":"semetey-1-2013:p0615:b003:l028","ordinal":124002,"en":"Locks of hair had been left."},{"id":"semetey-1-2013:p0615:b003:l029","ordinal":124003,"en":"He seemed to be a child in years,"},{"id":"semetey-1-2013:p0615:b003:l030","ordinal":124004,"en":"No more than twelve."},{"id":"semetey-1-2013:p0615:b003:l031","ordinal":124005,"en":"If he came to maturity,"},{"id":"semetey-1-2013:p0615:b003:l032","ordinal":124006,"en":"His right shoulder was broad—"},{"id":"semetey-1-2013:p0615:b003:l033","ordinal":124007,"en":"He would be a warrior to destroy the Oirats."},{"id":"semetey-1-2013:p0615:b003:l034","ordinal":124008,"en":"With the holy Qur'an as his pillow,"},{"id":"semetey-1-2013:p0615:b003:l035","ordinal":124009,"en":"His head toward the qibla,"},{"id":"semetey-1-2013:p0615:b003:l036","ordinal":124010,"en":"Crowded close at his head,"},{"id":"semetey-1-2013:p0615:b003:l037","ordinal":124011,"en":"Another boy lay with him."},{"id":"semetey-1-2013:p0615:b003:l038","ordinal":124012,"en":"“Ah, has my precious father died?"},{"id":"semetey-1-2013:p0615:b003:l039","ordinal":124013,"en":"Was he buried with all his people?"},{"id":"semetey-1-2013:p0615:b004:l001","ordinal":124014,"en":"To give my father delight,"},{"id":"semetey-1-2013:p0615:b004:l002","ordinal":124015,"en":"Pressing a girl against his breast,"},{"id":"semetey-1-2013:p0615:b004:l003","ordinal":124016,"en":"Did they bury him with a girl lying there?"},{"id":"semetey-1-2013:p0615:b004:l004","ordinal":124017,"en":"My leopard father, the bloodthirsty one,"},{"id":"semetey-1-2013:p0615:b004:l005","ordinal":124018,"en":"‘Let him lie without sorrow,’ they said—"},{"id":"semetey-1-2013:p0615:b004:l006","ordinal":124019,"en":"Did they place a girl in his embrace?"},{"id":"semetey-1-2013:p0615:b004:l007","ordinal":124020,"en":"‘Let them surround him,’ they said—"},{"id":"semetey-1-2013:p0615:b004:l008","ordinal":124021,"en":"Did they give him his ocean-like companions?"},{"id":"semetey-1-2013:p0615:b004:l009","ordinal":124022,"en":"When my father grew weary,"},{"id":"semetey-1-2013:p0615:b004:l010","ordinal":124023,"en":"‘Let someone amuse him,’ they said—"},{"id":"semetey-1-2013:p0615:b004:l011","ordinal":124024,"en":"Look at these foolish people,"},{"id":"semetey-1-2013:p0615:b004:l012","ordinal":124025,"en":"Did they send a child along with him?”"},{"id":"semetey-1-2013:p0615:b004:l013","ordinal":124026,"en":"The sight tore his heart."},{"id":"semetey-1-2013:p0615:b004:l014","ordinal":124027,"en":"The orphan left by Manas"},{"id":"semetey-1-2013:p0615:b004:l015","ordinal":124028,"en":"Shed tears from his eyes."},{"id":"semetey-1-2013:p0615:b004:l016","ordinal":124029,"en":"“Into my father's embrace"},{"id":"semetey-1-2013:p0615:b004:l017","ordinal":124030,"en":"Perhaps I too should enter."},{"id":"semetey-1-2013:p0615:b004:l018","ordinal":124031,"en":"Alas, beside my sultan father"},{"id":"semetey-1-2013:p0615:b004:l019","ordinal":124032,"en":"Perhaps I too should lie!"},{"id":"semetey-1-2013:p0615:b004:l020","ordinal":124033,"en":"Between him and the girl he embraces,"},{"id":"semetey-1-2013:p0615:b004:l021","ordinal":124034,"en":"Perhaps I should enter."},{"id":"semetey-1-2013:p0615:b004:l022","ordinal":124035,"en":"What a marvel, what a thing!"},{"id":"semetey-1-2013:p0615:b004:l023","ordinal":124036,"en":"What misfortune, what a dream!"},{"id":"semetey-1-2013:p0615:b004:l024","ordinal":124037,"en":"If I lie with my father and die,"},{"id":"semetey-1-2013:p0615:b004:l025","ordinal":124038,"en":"My old leopard uncle,"},{"id":"semetey-1-2013:p0615:b004:l026","ordinal":124039,"en":"Will my uncle Khan Bakai die?"},{"id":"semetey-1-2013:p0615:b004:l027","ordinal":124040,"en":"My grieving mother Kanykei,"},{"id":"semetey-1-2013:p0615:b004:l028","ordinal":124041,"en":"Will she see torment again?"},{"id":"semetey-1-2013:p0615:b004:l029","ordinal":124042,"en":"Chyiyrdy, at ninety-five,"},{"id":"semetey-1-2013:p0615:b004:l030","ordinal":124043,"en":"Will she plunge a knife into herself?"},{"id":"semetey-1-2013:p0615:b004:l031","ordinal":124044,"en":"Will all these people suddenly"},{"id":"semetey-1-2013:p0615:b004:l032","ordinal":124045,"en":"Be struck by death?"},{"id":"semetey-1-2013:p0615:b004:l033","ordinal":124046,"en":"My uncle Bakai, blessed by Kydyr,"},{"id":"semetey-1-2013:p0615:b004:l034","ordinal":124047,"en":"Let me ask him about this wonder."},{"id":"semetey-1-2013:p0615:b004:l035","ordinal":124048,"en":"He teaches what I do not know;"},{"id":"semetey-1-2013:p0615:b004:l036","ordinal":124049,"en":"Let me go to my uncle."},{"id":"semetey-1-2013:p0615:b004:l037","ordinal":124050,"en":"O Almighty, a thousand times I repent!"},{"id":"semetey-1-2013:p0615:b004:l038","ordinal":124051,"en":"My lion father's state"},{"id":"semetey-1-2013:p0615:b004:l039","ordinal":124052,"en":"Let me tell Khan Bakai."},{"id":"semetey-1-2013:p0616:b003:l001","ordinal":124053,"en":"Let me gather every word."},{"id":"semetey-1-2013:p0616:b003:l002","ordinal":124054,"en":"From my wise uncle Bakai"},{"id":"semetey-1-2013:p0616:b003:l003","ordinal":124055,"en":"Let me ask about this.”"},{"id":"semetey-1-2013:p0616:b003:l004","ordinal":124056,"en":"So saying, Semetey"},{"id":"semetey-1-2013:p0616:b003:l005","ordinal":124057,"en":"Came out of the cave, calling aloud."},{"id":"semetey-1-2013:p0616:b003:l006","ordinal":124058,"en":"To his uncle Sultan Bakai"},{"id":"semetey-1-2013:p0616:b003:l007","ordinal":124059,"en":"He waved his hand and called."},{"id":"semetey-1-2013:p0616:b003:l008","ordinal":124060,"en":"When Bakai came near,"},{"id":"semetey-1-2013:p0616:b003:l009","ordinal":124061,"en":"“Warrior uncle, hear my words."},{"id":"semetey-1-2013:p0616:b003:l010","ordinal":124062,"en":"Let me stay as your guest tonight,"},{"id":"semetey-1-2013:p0616:b003:l011","ordinal":124063,"en":"And tell you my tale.”"},{"id":"semetey-1-2013:p0616:b003:l012","ordinal":124064,"en":"Then Bakai said:"},{"id":"semetey-1-2013:p0616:b003:l013","ordinal":124065,"en":"“I know your tale."},{"id":"semetey-1-2013:p0616:b003:l014","ordinal":124066,"en":"May your journey prosper, Semetey."},{"id":"semetey-1-2013:p0616:b003:l015","ordinal":124067,"en":"May God set your affairs right."},{"id":"semetey-1-2013:p0616:b003:l016","ordinal":124068,"en":"He was a lion whose spirit lives;"},{"id":"semetey-1-2013:p0616:b003:l017","ordinal":124069,"en":"May your father Manas protect you!"},{"id":"semetey-1-2013:p0616:b003:l018","ordinal":124070,"en":"Pledged to twelve spiritual masters,"},{"id":"semetey-1-2013:p0616:b003:l019","ordinal":124071,"en":"That is your saintly lion father."},{"id":"semetey-1-2013:p0616:b003:l020","ordinal":124072,"en":"Appearing before your eyes,"},{"id":"semetey-1-2013:p0616:b003:l021","ordinal":124073,"en":"That is how he gives his aid."},{"id":"semetey-1-2013:p0616:b003:l022","ordinal":124074,"en":"Your father Manas, blessed by Kydyr—"},{"id":"semetey-1-2013:p0616:b003:l023","ordinal":124075,"en":"That is how he sets things right.”"},{"id":"semetey-1-2013:p0616:b003:l024","ordinal":124076,"en":"So saying, Khan Bakai"},{"id":"semetey-1-2013:p0616:b003:l025","ordinal":124077,"en":"Took the dark stone as large as a small tent"},{"id":"semetey-1-2013:p0616:b003:l026","ordinal":124078,"en":"Up into his hands."},{"id":"semetey-1-2013:p0616:b003:l027","ordinal":124079,"en":"Bakai sealed it in an instant."},{"id":"semetey-1-2013:p0616:b003:l028","ordinal":124080,"en":"One could not see it by looking;"},{"id":"semetey-1-2013:p0616:b003:l029","ordinal":124081,"en":"The cave vanished into the unseen."},{"id":"semetey-1-2013:p0616:b003:l030","ordinal":124082,"en":"Its whereabouts could not be known;"},{"id":"semetey-1-2013:p0616:b003:l031","ordinal":124083,"en":"The cave disappeared."},{"id":"semetey-1-2013:p0616:b003:l032","ordinal":124084,"en":"Bakai sealed the cave,"},{"id":"semetey-1-2013:p0616:b003:l033","ordinal":124085,"en":"And when it had vanished,"},{"id":"semetey-1-2013:p0616:b003:l034","ordinal":124086,"en":"Semetey stood gazing."},{"id":"semetey-1-2013:p0616:b003:l035","ordinal":124087,"en":"The rascal left by Manas"},{"id":"semetey-1-2013:p0616:b003:l036","ordinal":124088,"en":"Astonished at this wonder:"},{"id":"semetey-1-2013:p0616:b003:l037","ordinal":124089,"en":"“My father is a lion!"},{"id":"semetey-1-2013:p0616:b003:l038","ordinal":124090,"en":"He is a warrior whose spirit is present."},{"id":"semetey-1-2013:p0616:b003:l039","ordinal":124091,"en":"For this small Muslim people"},{"id":"semetey-1-2013:p0616:b004:l001","ordinal":124092,"en":"He was a fortress built of iron."},{"id":"semetey-1-2013:p0616:b004:l002","ordinal":124093,"en":"May I be sacrificed to God!"},{"id":"semetey-1-2013:p0616:b004:l003","ordinal":124094,"en":"My father who went to the next world"},{"id":"semetey-1-2013:p0616:b004:l004","ordinal":124095,"en":"Was a lion unequaled on earth."},{"id":"semetey-1-2013:p0616:b004:l005","ordinal":124096,"en":"Uncle Bakai, hear my words."},{"id":"semetey-1-2013:p0616:b004:l006","ordinal":124097,"en":"When my father Manas died,"},{"id":"semetey-1-2013:p0616:b004:l007","ordinal":124098,"en":"When they said the funeral prayer for him,"},{"id":"semetey-1-2013:p0616:b004:l008","ordinal":124099,"en":"When his people gathered and buried him,"},{"id":"semetey-1-2013:p0616:b004:l009","ordinal":124100,"en":"With how many people did you bury him?"},{"id":"semetey-1-2013:p0616:b004:l010","ordinal":124101,"en":"Laying a girl in his embrace,"},{"id":"semetey-1-2013:p0616:b004:l011","ordinal":124102,"en":"My father gone to Judgment Day,"},{"id":"semetey-1-2013:p0616:b004:l012","ordinal":124103,"en":"Uncle, you gave him a wondrous burial."},{"id":"semetey-1-2013:p0616:b004:l013","ordinal":124104,"en":"My father is not alone."},{"id":"semetey-1-2013:p0616:b004:l014","ordinal":124105,"en":"Uncle Bakai, hear my words."},{"id":"semetey-1-2013:p0616:b004:l015","ordinal":124106,"en":"You buried him with six people!"},{"id":"semetey-1-2013:p0616:b004:l016","ordinal":124107,"en":"Let me understand every sign."},{"id":"semetey-1-2013:p0616:b004:l017","ordinal":124108,"en":"Uncle Bakai, tell me.”"},{"id":"semetey-1-2013:p0616:b004:l018","ordinal":124109,"en":"The boy spoke; I understood."},{"id":"semetey-1-2013:p0616:b004:l019","ordinal":124110,"en":"“The one who lies on his right—"},{"id":"semetey-1-2013:p0616:b004:l020","ordinal":124111,"en":"Your father blessed by Kydyr"},{"id":"semetey-1-2013:p0616:b004:l021","ordinal":124112,"en":"Met all the mighty men."},{"id":"semetey-1-2013:p0616:b004:l022","ordinal":124113,"en":"Your father blessed by Baabedin"},{"id":"semetey-1-2013:p0616:b004:l023","ordinal":124114,"en":"Was matched by all the heroes."},{"id":"semetey-1-2013:p0616:b004:l024","ordinal":124115,"en":"Your lion father Manas, stirred to action,"},{"id":"semetey-1-2013:p0616:b004:l025","ordinal":124116,"en":"That leopard himself"},{"id":"semetey-1-2013:p0616:b004:l026","ordinal":124117,"en":"Met many fierce-maned warriors."},{"id":"semetey-1-2013:p0616:b004:l027","ordinal":124118,"en":"They migrated to Talas,"},{"id":"semetey-1-2013:p0616:b004:l028","ordinal":124119,"en":"And became companions in this way"},{"id":"semetey-1-2013:p0616:b004:l029","ordinal":124120,"en":"To your father, the late Manas."},{"id":"semetey-1-2013:p0616:b004:l030","ordinal":124121,"en":"The one who lies on his right—"},{"id":"semetey-1-2013:p0616:b004:l031","ordinal":124122,"en":"Long ago he fled the infidels and became their stranger,"},{"id":"semetey-1-2013:p0616:b004:l032","ordinal":124123,"en":"Was cleansed of the dark faith."},{"id":"semetey-1-2013:p0616:b004:l033","ordinal":124124,"en":"Stars stirred in the heavens."},{"id":"semetey-1-2013:p0616:b004:l034","ordinal":124125,"en":"They became friends for the next world."},{"id":"semetey-1-2013:p0616:b004:l035","ordinal":124126,"en":"He settled in Talas,"},{"id":"semetey-1-2013:p0616:b004:l036","ordinal":124127,"en":"And became a companion to your father Sultan Manas."},{"id":"semetey-1-2013:p0616:b004:l037","ordinal":124128,"en":"They fought their enemies together,"},{"id":"semetey-1-2013:p0616:b004:l038","ordinal":124129,"en":"Pressed their claims together,"},{"id":"semetey-1-2013:p0616:b004:l039","ordinal":124130,"en":"Scouted together,"},{"id":"semetey-1-2013:p0617:b003:l001","ordinal":124131,"en":"They took horses from foreign-speaking people together."},{"id":"semetey-1-2013:p0617:b003:l002","ordinal":124132,"en":"To Beijing with its Khagan,"},{"id":"semetey-1-2013:p0617:b003:l003","ordinal":124133,"en":"When Manas went on campaign,"},{"id":"semetey-1-2013:p0617:b003:l004","ordinal":124134,"en":"Against mighty Beijing's Khagan,"},{"id":"semetey-1-2013:p0617:b003:l005","ordinal":124135,"en":"When he unleashed turmoil,"},{"id":"semetey-1-2013:p0617:b003:l006","ordinal":124136,"en":"Into looming Beijing,"},{"id":"semetey-1-2013:p0617:b003:l007","ordinal":124137,"en":"When he entered straight and thrust his spear,"},{"id":"semetey-1-2013:p0617:b003:l008","ordinal":124138,"en":"From hell of grievous torment,"},{"id":"semetey-1-2013:p0617:b003:l009","ordinal":124139,"en":"When he freed the soul,"},{"id":"semetey-1-2013:p0617:b003:l010","ordinal":124140,"en":"Untiring when he scouted,"},{"id":"semetey-1-2013:p0617:b003:l011","ordinal":124141,"en":"Untroubled when he entered the army's rear,"},{"id":"semetey-1-2013:p0617:b003:l012","ordinal":124142,"en":"Unworried when he went on campaign,"},{"id":"semetey-1-2013:p0617:b003:l013","ordinal":124143,"en":"A hungry lion, a peerless warrior,"},{"id":"semetey-1-2013:p0617:b003:l014","ordinal":124144,"en":"A noble hero like Alake."},{"id":"semetey-1-2013:p0617:b003:l015","ordinal":124145,"en":"All the peoples rose,"},{"id":"semetey-1-2013:p0617:b003:l016","ordinal":124146,"en":"Forming forty-two vast hosts."},{"id":"semetey-1-2013:p0617:b003:l017","ordinal":124147,"en":"Drenched in dark blood,"},{"id":"semetey-1-2013:p0617:b003:l018","ordinal":124148,"en":"They fought six months without fleeing."},{"id":"semetey-1-2013:p0617:b003:l019","ordinal":124149,"en":"Fleet-footed runners among the Chinese died;"},{"id":"semetey-1-2013:p0617:b003:l020","ordinal":124150,"en":"Many brave men and giants died."},{"id":"semetey-1-2013:p0617:b003:l021","ordinal":124151,"en":"There were countless multitudes of people."},{"id":"semetey-1-2013:p0617:b003:l022","ordinal":124152,"en":"Your father's banner was raised"},{"id":"semetey-1-2013:p0617:b003:l023","ordinal":124153,"en":"By me, your poor uncle Bakai."},{"id":"semetey-1-2013:p0617:b003:l024","ordinal":124154,"en":"When the Muslim people"},{"id":"semetey-1-2013:p0617:b003:l025","ordinal":124155,"en":"Were distraught and confused,"},{"id":"semetey-1-2013:p0617:b003:l026","ordinal":124156,"en":"The Muslim folk fled in panic,"},{"id":"semetey-1-2013:p0617:b003:l027","ordinal":124157,"en":"When he fled into the sand,"},{"id":"semetey-1-2013:p0617:b003:l028","ordinal":124158,"en":"Your father Manas, the peerless lion,"},{"id":"semetey-1-2013:p0617:b003:l029","ordinal":124159,"en":"Against the red-naveled Chinese"},{"id":"semetey-1-2013:p0617:b003:l030","ordinal":124160,"en":"Roared and unleashed slaughter."}]
