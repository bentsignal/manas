[{"id":"semetey-1-2013:p0207:b003:l031","ordinal":92673,"en":"But all the people of Bukhara"},{"id":"semetey-1-2013:p0207:b003:l032","ordinal":92674,"en":"Split apart and scurried away,"},{"id":"semetey-1-2013:p0207:b003:l033","ordinal":92675,"en":"Calling out greetings."},{"id":"semetey-1-2013:p0207:b003:l034","ordinal":92676,"en":"Bukhara stood halted in confusion."},{"id":"semetey-1-2013:p0207:b003:l035","ordinal":92677,"en":"Not knowing she was a woman,"},{"id":"semetey-1-2013:p0207:b003:l036","ordinal":92678,"en":"Astonished at your sister-in-law,"},{"id":"semetey-1-2013:p0207:b003:l037","ordinal":92679,"en":"Many of the people of Bukhara"},{"id":"semetey-1-2013:p0207:b003:l038","ordinal":92680,"en":"Crowded round and whispered:"},{"id":"semetey-1-2013:p0207:b003:l039","ordinal":92681,"en":"\"He is renowned; he is a support."},{"id":"semetey-1-2013:p0207:b004:l001","ordinal":92682,"en":"Where has this hero come from?"},{"id":"semetey-1-2013:p0207:b004:l002","ordinal":92683,"en":"Broad of chest, wide of breast,"},{"id":"semetey-1-2013:p0207:b004:l003","ordinal":92684,"en":"He is an imposing lion."},{"id":"semetey-1-2013:p0207:b004:l004","ordinal":92685,"en":"All twelve parts of his body are sound."},{"id":"semetey-1-2013:p0207:b004:l005","ordinal":92686,"en":"For this realm here,"},{"id":"semetey-1-2013:p0207:b004:l006","ordinal":92687,"en":"He is an iron fortress of defense."},{"id":"semetey-1-2013:p0207:b004:l007","ordinal":92688,"en":"The Chinese beyond the ridge,"},{"id":"semetey-1-2013:p0207:b004:l008","ordinal":92689,"en":"He is a hero who could slaughter them."},{"id":"semetey-1-2013:p0207:b004:l009","ordinal":92690,"en":"Those who give insolent replies,"},{"id":"semetey-1-2013:p0207:b004:l010","ordinal":92691,"en":"His words could silence."},{"id":"semetey-1-2013:p0207:b004:l011","ordinal":92692,"en":"If an enemy boldly rose up,"},{"id":"semetey-1-2013:p0207:b004:l012","ordinal":92693,"en":"For this palm-sized realm,"},{"id":"semetey-1-2013:p0207:b004:l013","ordinal":92694,"en":"He is a lion who could lend support."},{"id":"semetey-1-2013:p0207:b004:l014","ordinal":92695,"en":"Six amulets at a time upon his horse,"},{"id":"semetey-1-2013:p0207:b004:l015","ordinal":92696,"en":"He is a hero who would fasten them."},{"id":"semetey-1-2013:p0207:b004:l016","ordinal":92697,"en":"This palm-sized realm of Islam,"},{"id":"semetey-1-2013:p0207:b004:l017","ordinal":92698,"en":"Without chafing their mounts' backs,"},{"id":"semetey-1-2013:p0207:b004:l018","ordinal":92699,"en":"Without hurting their hearts,"},{"id":"semetey-1-2013:p0207:b004:l019","ordinal":92700,"en":"He is a lion who could care for them."},{"id":"semetey-1-2013:p0207:b004:l020","ordinal":92701,"en":"His appearance and bearing,"},{"id":"semetey-1-2013:p0207:b004:l021","ordinal":92702,"en":"His figure on horseback,"},{"id":"semetey-1-2013:p0207:b004:l022","ordinal":92703,"en":"Look like Manas."},{"id":"semetey-1-2013:p0207:b004:l023","ordinal":92704,"en":"Perhaps he is Manas's sister's son,"},{"id":"semetey-1-2013:p0207:b004:l024","ordinal":92705,"en":"Or perhaps Manas's maternal uncle."},{"id":"semetey-1-2013:p0207:b004:l025","ordinal":92706,"en":"What is his battle cry, what is his identity?"},{"id":"semetey-1-2013:p0207:b004:l026","ordinal":92707,"en":"What lineage does he come from?"},{"id":"semetey-1-2013:p0207:b004:l027","ordinal":92708,"en":"Your father's grave, Muslims!"},{"id":"semetey-1-2013:p0207:b004:l028","ordinal":92709,"en":"When that Manas died,"},{"id":"semetey-1-2013:p0207:b004:l029","ordinal":92710,"en":"The people of Islam were hard pressed."},{"id":"semetey-1-2013:p0207:b004:l030","ordinal":92711,"en":"When mighty Manas died,"},{"id":"semetey-1-2013:p0207:b004:l031","ordinal":92712,"en":"We of Islam were left lamenting;"},{"id":"semetey-1-2013:p0207:b004:l032","ordinal":92713,"en":"We Muslims were left weeping."},{"id":"semetey-1-2013:p0207:b004:l033","ordinal":92714,"en":"God does not leave a place empty."},{"id":"semetey-1-2013:p0207:b004:l034","ordinal":92715,"en":"He is a lion like Manas."},{"id":"semetey-1-2013:p0207:b004:l035","ordinal":92716,"en":"This palm-sized realm of Islam,"},{"id":"semetey-1-2013:p0207:b004:l036","ordinal":92717,"en":"He is a hero who could protect it."},{"id":"semetey-1-2013:p0207:b004:l037","ordinal":92718,"en":"Setting honor aside, here"},{"id":"semetey-1-2013:p0207:b004:l038","ordinal":92719,"en":"If we raise this man as khan,"},{"id":"semetey-1-2013:p0207:b004:l039","ordinal":92720,"en":"He will drive white deer and make them cattle;"},{"id":"semetey-1-2013:p0208:b003:l001","ordinal":92721,"en":"He will throw the whole world into confusion;"},{"id":"semetey-1-2013:p0208:b003:l002","ordinal":92722,"en":"He will drive blue-gray deer and make them cattle,"},{"id":"semetey-1-2013:p0208:b003:l003","ordinal":92723,"en":"And confound everyone he sees."},{"id":"semetey-1-2013:p0208:b003:l004","ordinal":92724,"en":"The one God had granted"},{"id":"semetey-1-2013:p0208:b003:l005","ordinal":92725,"en":"Whatever he wished."},{"id":"semetey-1-2013:p0208:b003:l006","ordinal":92726,"en":"His age had reached forty-four;"},{"id":"semetey-1-2013:p0208:b003:l007","ordinal":92727,"en":"That was the age he had attained.\""},{"id":"semetey-1-2013:p0208:b003:l008","ordinal":92728,"en":"The peoples of eight khans were astonished,"},{"id":"semetey-1-2013:p0208:b003:l009","ordinal":92729,"en":"All crowding round to look."},{"id":"semetey-1-2013:p0208:b003:l010","ordinal":92730,"en":"The eight khans who did not recognize her,"},{"id":"semetey-1-2013:p0208:b003:l011","ordinal":92731,"en":"Let us leave them thus."},{"id":"semetey-1-2013:p0208:b003:l012","ordinal":92732,"en":"The people of Bukhara who knew her,"},{"id":"semetey-1-2013:p0208:b003:l013","ordinal":92733,"en":"Let us begin to tell of them."},{"id":"semetey-1-2013:p0208:b003:l014","ordinal":92734,"en":"The people of Bukhara saw your sister-in-law,"},{"id":"semetey-1-2013:p0208:b003:l015","ordinal":92735,"en":"Stabbing at the tracks she left."},{"id":"semetey-1-2013:p0208:b003:l016","ordinal":92736,"en":"All Bukhara gathered,"},{"id":"semetey-1-2013:p0208:b003:l017","ordinal":92737,"en":"Slandering your sister-in-law:"},{"id":"semetey-1-2013:p0208:b003:l018","ordinal":92738,"en":"\"A woman who goes wrong never comes to good."},{"id":"semetey-1-2013:p0208:b003:l019","ordinal":92739,"en":"People, those called women"},{"id":"semetey-1-2013:p0208:b003:l020","ordinal":92740,"en":"Can never be true Muslims."},{"id":"semetey-1-2013:p0208:b003:l021","ordinal":92741,"en":"The reason they cannot—"},{"id":"semetey-1-2013:p0208:b003:l022","ordinal":92742,"en":"She trotted like a hunting hound."},{"id":"semetey-1-2013:p0208:b003:l023","ordinal":92743,"en":"Bereft of Khan Manas,"},{"id":"semetey-1-2013:p0208:b003:l024","ordinal":92744,"en":"That bitch came wandering from Talas the other day."},{"id":"semetey-1-2013:p0208:b003:l026","ordinal":92745,"en":"She had no means of livelihood at all."},{"id":"semetey-1-2013:p0208:b003:l027","ordinal":92746,"en":"Hardship had fallen upon her head."},{"id":"semetey-1-2013:p0208:b003:l028","ordinal":92747,"en":"Bereft of her Slayer,"},{"id":"semetey-1-2013:p0208:b003:l029","ordinal":92748,"en":"At thirty-two years of age,"},{"id":"semetey-1-2013:p0208:b003:l030","ordinal":92749,"en":"Letting them find her weakness,"},{"id":"semetey-1-2013:p0208:b003:l031","ordinal":92750,"en":"Letting the six wretches slash her breast,"},{"id":"semetey-1-2013:p0208:b003:l032","ordinal":92751,"en":"Letting her wealth be plundered,"},{"id":"semetey-1-2013:p0208:b003:l033","ordinal":92752,"en":"Letting the six wretches wreak havoc."},{"id":"semetey-1-2013:p0208:b003:l034","ordinal":92753,"en":"In felt socks, without overshoes,"},{"id":"semetey-1-2013:p0208:b003:l035","ordinal":92754,"en":"She came grieving and wandering."},{"id":"semetey-1-2013:p0208:b003:l036","ordinal":92755,"en":"Without boots, in felt socks,"},{"id":"semetey-1-2013:p0208:b003:l037","ordinal":92756,"en":"She barely kept herself alive."},{"id":"semetey-1-2013:p0208:b003:l038","ordinal":92757,"en":"Wandering here on the brink of death,"},{"id":"semetey-1-2013:p0208:b003:l039","ordinal":92758,"en":"The child she had borne"},{"id":"semetey-1-2013:p0208:b004:l001","ordinal":92759,"en":"She gave to our Ysmayyl."},{"id":"semetey-1-2013:p0208:b004:l002","ordinal":92760,"en":"Wearing a loose felt cloak,"},{"id":"semetey-1-2013:p0208:b004:l003","ordinal":92761,"en":"Riding a brown young mare, swaying about,"},{"id":"semetey-1-2013:p0208:b004:l004","ordinal":92762,"en":"She came grieving and wandering."},{"id":"semetey-1-2013:p0208:b004:l005","ordinal":92763,"en":"The child in her arms,"},{"id":"semetey-1-2013:p0208:b004:l006","ordinal":92764,"en":"Having his little twig cut,"},{"id":"semetey-1-2013:p0208:b004:l007","ordinal":92765,"en":"Having the ritual performed,"},{"id":"semetey-1-2013:p0208:b004:l008","ordinal":92766,"en":"Having him step over a dog's bowl,"},{"id":"semetey-1-2013:p0208:b004:l009","ordinal":92767,"en":"Having him step over a sword's edge,"},{"id":"semetey-1-2013:p0208:b004:l010","ordinal":92768,"en":"Saying, 'Ysmayyl, raise him,'"},{"id":"semetey-1-2013:p0208:b004:l011","ordinal":92769,"en":"She came wandering from Talas."},{"id":"semetey-1-2013:p0208:b004:l012","ordinal":92770,"en":"The only child she counted as her fortune"},{"id":"semetey-1-2013:p0208:b004:l013","ordinal":92771,"en":"She gave to Ysmayyl."},{"id":"semetey-1-2013:p0208:b004:l014","ordinal":92772,"en":"The child being raised"},{"id":"semetey-1-2013:p0208:b004:l015","ordinal":92773,"en":"Reached twelve this year."},{"id":"semetey-1-2013:p0208:b004:l016","ordinal":92774,"en":"Since the death of Manas the Slayer,"},{"id":"semetey-1-2013:p0208:b004:l017","ordinal":92775,"en":"Twelve years have passed this year."},{"id":"semetey-1-2013:p0208:b004:l018","ordinal":92776,"en":"Calling from the mountaintop,"},{"id":"semetey-1-2013:p0208:b004:l019","ordinal":92777,"en":"This year she has become a snowcock."},{"id":"semetey-1-2013:p0208:b004:l020","ordinal":92778,"en":"Somehow to marry a man,"},{"id":"semetey-1-2013:p0208:b004:l021","ordinal":92779,"en":"To go about seeking men,"},{"id":"semetey-1-2013:p0208:b004:l022","ordinal":92780,"en":"This bitch has become eager."},{"id":"semetey-1-2013:p0208:b004:l023","ordinal":92781,"en":"Rejoicing at her husband's death,"},{"id":"semetey-1-2013:p0208:b004:l024","ordinal":92782,"en":"Dressing in men's clothes,"},{"id":"semetey-1-2013:p0208:b004:l025","ordinal":92783,"en":"Taking a direct route along a narrow path,"},{"id":"semetey-1-2013:p0208:b004:l026","ordinal":92784,"en":"In her old age, a horse of hers"},{"id":"semetey-1-2013:p0208:b004:l027","ordinal":92785,"en":"She leads, saying, 'I shall race him.'"},{"id":"semetey-1-2013:p0208:b004:l028","ordinal":92786,"en":"Let him cut the willow on the knoll;"},{"id":"semetey-1-2013:p0208:b004:l029","ordinal":92787,"en":"The khan of Bukhara, Temir Khan,"},{"id":"semetey-1-2013:p0208:b004:l030","ordinal":92788,"en":"Let him restrain his wayward daughter!"},{"id":"semetey-1-2013:p0208:b004:l031","ordinal":92789,"en":"Let him cut the willow on the hillside;"},{"id":"semetey-1-2013:p0208:b004:l032","ordinal":92790,"en":"The khan of Bukhara, Temir Khan,"},{"id":"semetey-1-2013:p0208:b004:l033","ordinal":92791,"en":"Let him restrain his shameless daughter!"},{"id":"semetey-1-2013:p0208:b004:l034","ordinal":92792,"en":"If this daughter will not be restrained,"},{"id":"semetey-1-2013:p0208:b004:l035","ordinal":92793,"en":"Let him gather the peoples of eight khans,"},{"id":"semetey-1-2013:p0208:b004:l036","ordinal":92794,"en":"Or have her married to someone."},{"id":"semetey-1-2013:p0208:b004:l037","ordinal":92795,"en":"This daughter who goes about astray,"},{"id":"semetey-1-2013:p0208:b004:l038","ordinal":92796,"en":"Let him restrain her like this!"},{"id":"semetey-1-2013:p0208:b004:l039","ordinal":92797,"en":"Taking a shortcut along a narrow path,"},{"id":"semetey-1-2013:p0209:b003:l001","ordinal":92798,"en":"In her old age, a horse of hers"},{"id":"semetey-1-2013:p0209:b003:l002","ordinal":92799,"en":"She leads, saying, 'I shall race him.'"},{"id":"semetey-1-2013:p0209:b003:l003","ordinal":92800,"en":"If the horse she races lumbers along,"},{"id":"semetey-1-2013:p0209:b003:l004","ordinal":92801,"en":"And falls behind, floundering,"},{"id":"semetey-1-2013:p0209:b003:l005","ordinal":92802,"en":"Will they not call her that man's shameless"},{"id":"semetey-1-2013:p0209:b003:l006","ordinal":92803,"en":"Widowed daughter?"},{"id":"semetey-1-2013:p0209:b003:l007","ordinal":92804,"en":"The eight khans will ridicule us,"},{"id":"semetey-1-2013:p0209:b003:l008","ordinal":92805,"en":"And afterward devour us, will they not?"},{"id":"semetey-1-2013:p0209:b003:l009","ordinal":92806,"en":"Will they not call her his daughter"},{"id":"semetey-1-2013:p0209:b003:l010","ordinal":92807,"en":"Who scattered so much wealth and gold?"},{"id":"semetey-1-2013:p0209:b003:l011","ordinal":92808,"en":"Wandering on foot toward Bukhara,"},{"id":"semetey-1-2013:p0209:b003:l012","ordinal":92809,"en":"Will they not call her his daughter who fled?"},{"id":"semetey-1-2013:p0209:b003:l013","ordinal":92810,"en":"A woman who goes wrong never comes to good."},{"id":"semetey-1-2013:p0209:b003:l014","ordinal":92811,"en":"Those accursed creatures called females"},{"id":"semetey-1-2013:p0209:b003:l015","ordinal":92812,"en":"Will surely never come to good."},{"id":"semetey-1-2013:p0209:b003:l016","ordinal":92813,"en":"Look at the unbeliever's"},{"id":"semetey-1-2013:p0209:b003:l017","ordinal":92814,"en":"Wild excitement while a widow!"},{"id":"semetey-1-2013:p0209:b003:l018","ordinal":92815,"en":"Saying, 'I shall race a horse in Bukhara,'"},{"id":"semetey-1-2013:p0209:b003:l019","ordinal":92816,"en":"Look at her arrogance!"},{"id":"semetey-1-2013:p0209:b003:l020","ordinal":92817,"en":"This woman, in men's clothes,"},{"id":"semetey-1-2013:p0209:b003:l021","ordinal":92818,"en":"Look how she has dressed!"},{"id":"semetey-1-2013:p0209:b003:l022","ordinal":92819,"en":"Delighted at her husband's death,"},{"id":"semetey-1-2013:p0209:b003:l023","ordinal":92820,"en":"Look at her rejoicing!"},{"id":"semetey-1-2013:p0209:b003:l024","ordinal":92821,"en":"Listen, people; listen, khan."},{"id":"semetey-1-2013:p0209:b003:l025","ordinal":92822,"en":"All of you, the whole people, listen."},{"id":"semetey-1-2013:p0209:b003:l026","ordinal":92823,"en":"Such is the salt of our Bukhara:"},{"id":"semetey-1-2013:p0209:b003:l027","ordinal":92824,"en":"A young falcon that comes finds ease;"},{"id":"semetey-1-2013:p0209:b003:l028","ordinal":92825,"en":"A wanderer that comes grows rich."},{"id":"semetey-1-2013:p0209:b003:l029","ordinal":92826,"en":"If one stays six years in Bukhara,"},{"id":"semetey-1-2013:p0209:b003:l030","ordinal":92827,"en":"One's heart becomes perfectly at ease."},{"id":"semetey-1-2013:p0209:b003:l031","ordinal":92828,"en":"Not acknowledging God at all,"},{"id":"semetey-1-2013:p0209:b003:l032","ordinal":92829,"en":"Such a wanderer comes and grows rich."},{"id":"semetey-1-2013:p0209:b003:l033","ordinal":92830,"en":"Let him gather the peoples of eight khans;"},{"id":"semetey-1-2013:p0209:b003:l034","ordinal":92831,"en":"If Temir Khan will heed advice,"},{"id":"semetey-1-2013:p0209:b003:l035","ordinal":92832,"en":"Let him restrain this wandering daughter."},{"id":"semetey-1-2013:p0209:b003:l036","ordinal":92833,"en":"Let her stop spurring on to race a horse,"},{"id":"semetey-1-2013:p0209:b003:l037","ordinal":92834,"en":"And not have people call her Temir Khan's"},{"id":"semetey-1-2013:p0209:b003:l038","ordinal":92835,"en":"Shameless daughter.\""},{"id":"semetey-1-2013:p0209:b003:l039","ordinal":92836,"en":"Saying this, the assembled people,"},{"id":"semetey-1-2013:p0209:b005:l001","ordinal":92837,"en":"Bending their knees to the ground,"},{"id":"semetey-1-2013:p0209:b005:l002","ordinal":92838,"en":"Before Temir Khan"},{"id":"semetey-1-2013:p0209:b005:l003","ordinal":92839,"en":"Came in, speaking ill of her;"},{"id":"semetey-1-2013:p0209:b005:l004","ordinal":92840,"en":"All his people came running."},{"id":"semetey-1-2013:p0209:b005:l005","ordinal":92841,"en":"Treading the ground where she walked,"},{"id":"semetey-1-2013:p0209:b005:l006","ordinal":92842,"en":"They began crying out,"},{"id":"semetey-1-2013:p0209:b005:l007","ordinal":92843,"en":"Speaking ill of Kanykey:"},{"id":"semetey-1-2013:p0209:b005:l008","ordinal":92844,"en":"\"Sire, dislike us if you will,"},{"id":"semetey-1-2013:p0209:b005:l009","ordinal":92845,"en":"Cut down the willow on the knoll;"},{"id":"semetey-1-2013:p0209:b005:l010","ordinal":92846,"en":"Restrain your wayward daughter!"},{"id":"semetey-1-2013:p0209:b005:l011","ordinal":92847,"en":"From this city of Bukhara,"},{"id":"semetey-1-2013:p0209:b005:l012","ordinal":92848,"en":"Gather those burdened by sorrow and regret;"},{"id":"semetey-1-2013:p0209:b005:l013","ordinal":92849,"en":"Restrain your shameless daughter!"},{"id":"semetey-1-2013:p0209:b005:l014","ordinal":92850,"en":"From Bukhara, whose food one savors,"},{"id":"semetey-1-2013:p0209:b005:l015","ordinal":92851,"en":"God has cursed your salt."},{"id":"semetey-1-2013:p0209:b005:l016","ordinal":92852,"en":"Rejoicing at her husband's death,"},{"id":"semetey-1-2013:p0209:b005:l017","ordinal":92853,"en":"Dressing in men's clothes,"},{"id":"semetey-1-2013:p0209:b005:l018","ordinal":92854,"en":"Taking the direct road of corruption,"},{"id":"semetey-1-2013:p0209:b005:l019","ordinal":92855,"en":"Leading a horse grown old,"},{"id":"semetey-1-2013:p0209:b005:l020","ordinal":92856,"en":"Saying, 'I shall race him,'"},{"id":"semetey-1-2013:p0209:b005:l021","ordinal":92857,"en":"God has cursed your daughter!"},{"id":"semetey-1-2013:p0209:b005:l022","ordinal":92858,"en":"Your daughter has grown arrogant."},{"id":"semetey-1-2013:p0209:b005:l023","ordinal":92859,"en":"God has cursed her beyond measure!"},{"id":"semetey-1-2013:p0209:b005:l024","ordinal":92860,"en":"Will they not call her Temir Khan's wandering daughter?"},{"id":"semetey-1-2013:p0209:b005:l026","ordinal":92861,"en":"Will they not devour us thus?"},{"id":"semetey-1-2013:p0209:b005:l027","ordinal":92862,"en":"Will she not disgrace us?"},{"id":"semetey-1-2013:p0209:b005:l028","ordinal":92863,"en":"Will she not slaughter us thus?"},{"id":"semetey-1-2013:p0209:b005:l029","ordinal":92864,"en":"Gather all the people;"},{"id":"semetey-1-2013:p0209:b005:l030","ordinal":92865,"en":"Restrain this daughter of yours!\""},{"id":"semetey-1-2013:p0209:b005:l031","ordinal":92866,"en":"After his people spoke like this,"},{"id":"semetey-1-2013:p0209:b005:l032","ordinal":92867,"en":"The khan of Bukhara, Temir Khan,"},{"id":"semetey-1-2013:p0209:b005:l033","ordinal":92868,"en":"Heard their narrow-mindedness."},{"id":"semetey-1-2013:p0209:b005:l034","ordinal":92869,"en":"Thus he felt deeply ashamed."},{"id":"semetey-1-2013:p0209:b005:l035","ordinal":92870,"en":"Rebuking his many people,"},{"id":"semetey-1-2013:p0209:b005:l036","ordinal":92871,"en":"Temir Khan grew resolute:"},{"id":"semetey-1-2013:p0209:b005:l037","ordinal":92872,"en":"\"Your swan-white-bearded elders—"},{"id":"semetey-1-2013:p0209:b005:l038","ordinal":92873,"en":"May God take all of you!"},{"id":"semetey-1-2013:p0209:b005:l039","ordinal":92874,"en":"Slandering my own child,"},{"id":"semetey-1-2013:p0210:b003:l001","ordinal":92875,"en":"You meant to burn my soul!"},{"id":"semetey-1-2013:p0210:b003:l002","ordinal":92876,"en":"In this city of Bukhara"},{"id":"semetey-1-2013:p0210:b003:l003","ordinal":92877,"en":"I became sovereign in my youth."},{"id":"semetey-1-2013:p0210:b003:l004","ordinal":92878,"en":"At first I had no children."},{"id":"semetey-1-2013:p0210:b003:l005","ordinal":92879,"en":"Among females, I saw a skilled one;"},{"id":"semetey-1-2013:p0210:b003:l006","ordinal":92880,"en":"I had thirteen daughters in succession."},{"id":"semetey-1-2013:p0210:b003:l007","ordinal":92881,"en":"The youngest of twelve daughters,"},{"id":"semetey-1-2013:p0210:b003:l008","ordinal":92882,"en":"God's beloved servant,"},{"id":"semetey-1-2013:p0210:b003:l009","ordinal":92883,"en":"This Kanykey here,"},{"id":"semetey-1-2013:p0210:b003:l010","ordinal":92884,"en":"The beauty among the dark-complexioned,"},{"id":"semetey-1-2013:p0210:b003:l011","ordinal":92885,"en":"The radiant one among Muslims."},{"id":"semetey-1-2013:p0210:b003:l012","ordinal":92886,"en":"When she reached six years old,"},{"id":"semetey-1-2013:p0210:b003:l013","ordinal":92887,"en":"I cherished her and braided her hair."},{"id":"semetey-1-2013:p0210:b003:l014","ordinal":92888,"en":"More than sixty ranks of men,"},{"id":"semetey-1-2013:p0210:b003:l015","ordinal":92889,"en":"Even today I love her."},{"id":"semetey-1-2013:p0210:b003:l016","ordinal":92890,"en":"The reason I love her:"},{"id":"semetey-1-2013:p0210:b003:l017","ordinal":92891,"en":"She went to the caliph and received a letter;"},{"id":"semetey-1-2013:p0210:b003:l018","ordinal":92892,"en":"She received a blessing from the prince."},{"id":"semetey-1-2013:p0210:b003:l019","ordinal":92893,"en":"When she reached twelve years old,"},{"id":"semetey-1-2013:p0210:b003:l020","ordinal":92894,"en":"She was named the Tigress."},{"id":"semetey-1-2013:p0210:b003:l021","ordinal":92895,"en":"When she reached thirteen,"},{"id":"semetey-1-2013:p0210:b003:l022","ordinal":92896,"en":"Samarkand, Kokand, Andijan—"},{"id":"semetey-1-2013:p0210:b003:l023","ordinal":92897,"en":"She laid them waste and took six."},{"id":"semetey-1-2013:p0210:b003:l024","ordinal":92898,"en":"When she reached fourteen,"},{"id":"semetey-1-2013:p0210:b003:l025","ordinal":92899,"en":"From Baghdad and Egypt"},{"id":"semetey-1-2013:p0210:b003:l026","ordinal":92900,"en":"They studied with her for eight months."},{"id":"semetey-1-2013:p0210:b003:l027","ordinal":92901,"en":"Saying, 'Fierce Kanykey has risen from Bukhara,'"},{"id":"semetey-1-2013:p0210:b003:l029","ordinal":92902,"en":"Those who heard her fame were afraid."},{"id":"semetey-1-2013:p0210:b003:l030","ordinal":92903,"en":"When she reached fourteen,"},{"id":"semetey-1-2013:p0210:b003:l031","ordinal":92904,"en":"The khan of Kakan grieved."},{"id":"semetey-1-2013:p0210:b003:l032","ordinal":92905,"en":"Saying, 'A fierce woman who will know my worth,'"},{"id":"semetey-1-2013:p0210:b003:l033","ordinal":92906,"en":"Leopard Khan Manas heard and rejoiced."},{"id":"semetey-1-2013:p0210:b003:l034","ordinal":92907,"en":"When she reached fourteen,"},{"id":"semetey-1-2013:p0210:b003:l035","ordinal":92908,"en":"We dedicated and slaughtered a white-gray mare."},{"id":"semetey-1-2013:p0210:b003:l036","ordinal":92909,"en":"Khan Bakay intervened,"},{"id":"semetey-1-2013:p0210:b003:l037","ordinal":92910,"en":"And we became close in-laws."},{"id":"semetey-1-2013:p0210:b003:l038","ordinal":92911,"en":"When she completed her fourteenth year,"},{"id":"semetey-1-2013:p0210:b003:l039","ordinal":92912,"en":"Her household settled in Talas,"},{"id":"semetey-1-2013:p0210:b004:l001","ordinal":92913,"en":"And she became Manas's wife."},{"id":"semetey-1-2013:p0210:b004:l002","ordinal":92914,"en":"My valiant child Kanykey"},{"id":"semetey-1-2013:p0210:b004:l003","ordinal":92915,"en":"Did not stand idly by."},{"id":"semetey-1-2013:p0210:b004:l004","ordinal":92916,"en":"For the valiant gray-maned Manas,"},{"id":"semetey-1-2013:p0210:b004:l005","ordinal":92917,"en":"She gathered what was scattered,"},{"id":"semetey-1-2013:p0210:b004:l006","ordinal":92918,"en":"She joined what was severed."},{"id":"semetey-1-2013:p0210:b004:l007","ordinal":92919,"en":"Planting, she made a garden;"},{"id":"semetey-1-2013:p0210:b004:l008","ordinal":92920,"en":"Building, she made a house."},{"id":"semetey-1-2013:p0210:b004:l009","ordinal":92921,"en":"Illustrious Manas"},{"id":"semetey-1-2013:p0210:b004:l010","ordinal":92922,"en":"She made khan over the world's people."},{"id":"semetey-1-2013:p0210:b004:l011","ordinal":92923,"en":"Making her imposing head a banner,"},{"id":"semetey-1-2013:p0210:b004:l012","ordinal":92924,"en":"She made her woman's self a hero."},{"id":"semetey-1-2013:p0210:b004:l013","ordinal":92925,"en":"Her gray-maned khan Manas"},{"id":"semetey-1-2013:p0210:b004:l014","ordinal":92926,"en":"She made a lion for the many people."},{"id":"semetey-1-2013:p0210:b004:l015","ordinal":92927,"en":"Preparing arrowproof coats,"},{"id":"semetey-1-2013:p0210:b004:l016","ordinal":92928,"en":"Preparing abundant ammunition,"}]
