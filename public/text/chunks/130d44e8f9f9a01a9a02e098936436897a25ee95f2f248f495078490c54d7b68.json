[{"id":"semetey-1-2013:p1372:b004:l019","ordinal":180993,"en":"Running hounds and flying birds—"},{"id":"semetey-1-2013:p1372:b004:l020","ordinal":180994,"en":"Your young son of the Bloodthirsty One"},{"id":"semetey-1-2013:p1372:b004:l021","ordinal":180995,"en":"Was journeying toward Kakan."},{"id":"semetey-1-2013:p1372:b004:l022","ordinal":180996,"en":"He crossed rugged passes,"},{"id":"semetey-1-2013:p1372:b004:l023","ordinal":180997,"en":"Passed over many turning uplands,"},{"id":"semetey-1-2013:p1372:b004:l024","ordinal":180998,"en":"And skirted the mountain foothills;"},{"id":"semetey-1-2013:p1372:b004:l025","ordinal":180999,"en":"Your gray wolf journeyed on,"},{"id":"semetey-1-2013:p1372:b004:l026","ordinal":181000,"en":"Roaming through Ala-Too,"},{"id":"semetey-1-2013:p1372:b004:l027","ordinal":181001,"en":"Crossing Kötörmö,"},{"id":"semetey-1-2013:p1372:b004:l028","ordinal":181002,"en":"And traversing broad Suusamyr."},{"id":"semetey-1-2013:p1372:b004:l029","ordinal":181003,"en":"By the mountain of Kyz-Art,"},{"id":"semetey-1-2013:p1372:b004:l030","ordinal":181004,"en":"For his coming battle with Great Beijing,"},{"id":"semetey-1-2013:p1372:b004:l031","ordinal":181005,"en":"Your gray wolf had"},{"id":"semetey-1-2013:p1372:b004:l032","ordinal":181006,"en":"All the fine thoroughbreds"},{"id":"semetey-1-2013:p1372:b004:l033","ordinal":181007,"en":"Shod with steel."},{"id":"semetey-1-2013:p1372:b004:l034","ordinal":181008,"en":"Along deserted Elkin-Too,"},{"id":"semetey-1-2013:p1372:b004:l035","ordinal":181009,"en":"He skirted Elkin-Too;"},{"id":"semetey-1-2013:p1372:b004:l036","ordinal":181010,"en":"He bent down and looked"},{"id":"semetey-1-2013:p1372:b004:l037","ordinal":181011,"en":"A blue lake appeared,"},{"id":"semetey-1-2013:p1372:b004:l038","ordinal":181012,"en":"And the many ducks resting on the lake"},{"id":"semetey-1-2013:p1372:b004:l039","ordinal":181013,"en":"Scattered when a falcon struck."},{"id":"semetey-1-2013:p1373:b003:l001","ordinal":181014,"en":"Ah, wondrous Issyk-Köl—"},{"id":"semetey-1-2013:p1373:b003:l002","ordinal":181015,"en":"Is it not the rump of the earth?"},{"id":"semetey-1-2013:p1373:b003:l003","ordinal":181016,"en":"Would anyone dwelling here ever leave?!"},{"id":"semetey-1-2013:p1373:b003:l004","ordinal":181017,"en":"It has its Küngöi and its Teskei,"},{"id":"semetey-1-2013:p1373:b003:l005","ordinal":181018,"en":"With mountains rising into view;"},{"id":"semetey-1-2013:p1373:b003:l006","ordinal":181019,"en":"When one looks toward their foothills,"},{"id":"semetey-1-2013:p1373:b003:l007","ordinal":181020,"en":"The human heart is overcome."},{"id":"semetey-1-2013:p1373:b003:l008","ordinal":181021,"en":"On its slopes pines grow thick in heaps,"},{"id":"semetey-1-2013:p1373:b003:l009","ordinal":181022,"en":"And crystal-clear springs pour from the hollows."},{"id":"semetey-1-2013:p1373:b003:l010","ordinal":181023,"en":"Its bounty is complete;"},{"id":"semetey-1-2013:p1373:b003:l011","ordinal":181024,"en":"God willing"},{"id":"semetey-1-2013:p1373:b003:l012","ordinal":181025,"en":"It's a memorable place!"},{"id":"semetey-1-2013:p1373:b003:l013","ordinal":181026,"en":"Are its summer pastures not nearby?"},{"id":"semetey-1-2013:p1373:b003:l014","ordinal":181027,"en":"Would the Kyrgyz not settle there for summer!"},{"id":"semetey-1-2013:p1373:b003:l015","ordinal":181028,"en":"Are its winter quarters not nearby?"},{"id":"semetey-1-2013:p1373:b003:l016","ordinal":181029,"en":"Would the Kyrgyz not winter there!"},{"id":"semetey-1-2013:p1373:b003:l017","ordinal":181030,"en":"Roe deer cry from the slopes,"},{"id":"semetey-1-2013:p1373:b003:l018","ordinal":181031,"en":"And owls call from the rugged ground."},{"id":"semetey-1-2013:p1373:b003:l019","ordinal":181032,"en":"It's a blessed place,"},{"id":"semetey-1-2013:p1373:b003:l020","ordinal":181033,"en":"Its hillsides bear fescue and wormwood."},{"id":"semetey-1-2013:p1373:b003:l021","ordinal":181034,"en":"The great Kyrgyz people would choose it"},{"id":"semetey-1-2013:p1373:b003:l022","ordinal":181035,"en":"It was a place to stay."},{"id":"semetey-1-2013:p1373:b003:l023","ordinal":181036,"en":"With kumis by day and girls by night,"},{"id":"semetey-1-2013:p1373:b003:l024","ordinal":181037,"en":"It's a place to be."},{"id":"semetey-1-2013:p1373:b003:l025","ordinal":181038,"en":"Ah, wondrous Issyk-Köl—"},{"id":"semetey-1-2013:p1373:b003:l026","ordinal":181039,"en":"Is it not the rump of the earth?"},{"id":"semetey-1-2013:p1373:b003:l027","ordinal":181040,"en":"Would any mortal dwelling there ever leave?!"},{"id":"semetey-1-2013:p1373:b003:l028","ordinal":181041,"en":"Looking toward the Küngöi side—"},{"id":"semetey-1-2013:p1373:b003:l029","ordinal":181042,"en":"Haze lies over Chaar-Tal;"},{"id":"semetey-1-2013:p1373:b003:l030","ordinal":181043,"en":"Looking at the opposite side -"},{"id":"semetey-1-2013:p1373:b003:l031","ordinal":181044,"en":"Munaryktap Kara-Tal."},{"id":"semetey-1-2013:p1373:b003:l032","ordinal":181045,"en":"Between these two"},{"id":"semetey-1-2013:p1373:b003:l033","ordinal":181046,"en":"Are many kinds of unseen creatures."},{"id":"semetey-1-2013:p1373:b003:l034","ordinal":181047,"en":"There is a deer, there is a tiger,"},{"id":"semetey-1-2013:p1373:b003:l035","ordinal":181048,"en":"Wherever one turns are countless wonders."},{"id":"semetey-1-2013:p1373:b003:l036","ordinal":181049,"en":"Rich in crops, spacious for cattle,"},{"id":"semetey-1-2013:p1373:b003:l037","ordinal":181050,"en":"It has countless splendid places."},{"id":"semetey-1-2013:p1373:b003:l038","ordinal":181051,"en":"There are ibex on its terraces,"},{"id":"semetey-1-2013:p1373:b003:l039","ordinal":181052,"en":"Argali on its hills,"},{"id":"semetey-1-2013:p1373:b004:l001","ordinal":181053,"en":"There's a deer on the bend,"},{"id":"semetey-1-2013:p1373:b004:l002","ordinal":181054,"en":"Marshes in patch after patch,"},{"id":"semetey-1-2013:p1373:b004:l003","ordinal":181055,"en":"And separate swans and geese."},{"id":"semetey-1-2013:p1373:b004:l004","ordinal":181056,"en":"There is a forest, there is a willow,"},{"id":"semetey-1-2013:p1373:b004:l005","ordinal":181057,"en":"Along this Issyk-Köl"},{"id":"semetey-1-2013:p1373:b004:l006","ordinal":181058,"en":"Every living creature is found."},{"id":"semetey-1-2013:p1373:b004:l007","ordinal":181059,"en":"It has demoiselle cranes, ducks, and geese,"},{"id":"semetey-1-2013:p1373:b004:l008","ordinal":181060,"en":"And many kinds of marshland."},{"id":"semetey-1-2013:p1373:b004:l009","ordinal":181061,"en":"There is a fox on the plain,"},{"id":"semetey-1-2013:p1373:b004:l010","ordinal":181062,"en":"For those who dwell there, Issyk-Köl"},{"id":"semetey-1-2013:p1373:b004:l011","ordinal":181063,"en":"Has wealth waiting to be found."},{"id":"semetey-1-2013:p1373:b004:l012","ordinal":181064,"en":"Its deep ravines hold many foxes,"},{"id":"semetey-1-2013:p1373:b004:l013","ordinal":181065,"en":"And its abundance brings much laughter."},{"id":"semetey-1-2013:p1373:b004:l014","ordinal":181066,"en":"Its thousand valleys are each distinct;"},{"id":"semetey-1-2013:p1373:b004:l015","ordinal":181067,"en":"Its delights are famed among the people."},{"id":"semetey-1-2013:p1373:b004:l016","ordinal":181068,"en":"Gold seems poured among its stones,"},{"id":"semetey-1-2013:p1373:b004:l017","ordinal":181069,"en":"And the Kyrgyz would settle there content;"},{"id":"semetey-1-2013:p1373:b004:l018","ordinal":181070,"en":"Almighty Allah"},{"id":"semetey-1-2013:p1373:b004:l019","ordinal":181071,"en":"Made every kind of land."},{"id":"semetey-1-2013:p1373:b004:l020","ordinal":181072,"en":"Could it be a land too small"},{"id":"semetey-1-2013:p1373:b004:l021","ordinal":181073,"en":"To pitch a royal camp and hold games?"},{"id":"semetey-1-2013:p1373:b004:l022","ordinal":181074,"en":"Could it be a land where one would not shoot"},{"id":"semetey-1-2013:p1373:b004:l023","ordinal":181075,"en":"The maral in its marshes?!"},{"id":"semetey-1-2013:p1373:b004:l024","ordinal":181076,"en":"O yawning gorge,"},{"id":"semetey-1-2013:p1373:b004:l025","ordinal":181077,"en":"Uncle Bakai, O gray wolf,"},{"id":"semetey-1-2013:p1373:b004:l026","ordinal":181078,"en":"I have many laments to tell!"},{"id":"semetey-1-2013:p1373:b004:l027","ordinal":181079,"en":"The spring flows,"},{"id":"semetey-1-2013:p1373:b004:l028","ordinal":181080,"en":"The nightingale sang in wonder,"},{"id":"semetey-1-2013:p1373:b004:l029","ordinal":181081,"en":"The listener is moved to tears;"},{"id":"semetey-1-2013:p1373:b004:l030","ordinal":181082,"en":"Such an interesting place!"},{"id":"semetey-1-2013:p1373:b004:l031","ordinal":181083,"en":"Uncle Bakai, bringer of good fortune,"},{"id":"semetey-1-2013:p1373:b004:l032","ordinal":181084,"en":"Look at the forest!"},{"id":"semetey-1-2013:p1373:b004:l033","ordinal":181085,"en":"It has noisy wild beasts;"},{"id":"semetey-1-2013:p1373:b004:l034","ordinal":181086,"en":"Look at the mountain side"},{"id":"semetey-1-2013:p1373:b004:l035","ordinal":181087,"en":"There is snow upon its summit!"},{"id":"semetey-1-2013:p1373:b004:l036","ordinal":181088,"en":"Your Almighty God"},{"id":"semetey-1-2013:p1373:b004:l037","ordinal":181089,"en":"Truly created this land"},{"id":"semetey-1-2013:p1373:b004:l038","ordinal":181090,"en":"In surpassing beauty!"},{"id":"semetey-1-2013:p1373:b004:l039","ordinal":181091,"en":"It is a lake that opens one's grief,"},{"id":"semetey-1-2013:p1374:b003:l001","ordinal":181092,"en":"It is a place that dispels sorrow."},{"id":"semetey-1-2013:p1374:b003:l002","ordinal":181093,"en":"There are different grasses,"},{"id":"semetey-1-2013:p1374:b003:l003","ordinal":181094,"en":"It has lands unlike any others."},{"id":"semetey-1-2013:p1374:b003:l004","ordinal":181095,"en":"My uncle Bakai, my old one,"},{"id":"semetey-1-2013:p1374:b003:l005","ordinal":181096,"en":"My beloved saint!"},{"id":"semetey-1-2013:p1374:b003:l006","ordinal":181097,"en":"While your gray wolf was alive,"},{"id":"semetey-1-2013:p1374:b003:l007","ordinal":181098,"en":"While the wide world remained whole,"},{"id":"semetey-1-2013:p1374:b003:l008","ordinal":181099,"en":"While your worthy one was alive,"},{"id":"semetey-1-2013:p1374:b003:l009","ordinal":181100,"en":"While your fortune remained whole,"},{"id":"semetey-1-2013:p1374:b003:l010","ordinal":181101,"en":"There was no people you had not fought,"},{"id":"semetey-1-2013:p1374:b003:l011","ordinal":181102,"en":"No land you had not subdued."},{"id":"semetey-1-2013:p1374:b003:l012","ordinal":181103,"en":"When you humiliated Kokon,"},{"id":"semetey-1-2013:p1374:b003:l013","ordinal":181104,"en":"When you alone brought turmoil"},{"id":"semetey-1-2013:p1374:b003:l014","ordinal":181105,"en":"Upon the face of the earth,"},{"id":"semetey-1-2013:p1374:b003:l015","ordinal":181106,"en":"While your bloodthirsty hero lived,"},{"id":"semetey-1-2013:p1374:b003:l016","ordinal":181107,"en":"Kara-Shaar, Kambyl"},{"id":"semetey-1-2013:p1374:b003:l017","ordinal":181108,"en":"When you besieged them,"},{"id":"semetey-1-2013:p1374:b003:l018","ordinal":181109,"en":"When you beat down"},{"id":"semetey-1-2013:p1374:b003:l019","ordinal":181110,"en":"The kalday and the Soloons,"},{"id":"semetey-1-2013:p1374:b003:l020","ordinal":181111,"en":"When you caused true upheaval,"},{"id":"semetey-1-2013:p1374:b003:l021","ordinal":181112,"en":"When you seized the khanate"},{"id":"semetey-1-2013:p1374:b003:l022","ordinal":181113,"en":"When you seized the khanate,"},{"id":"semetey-1-2013:p1374:b003:l023","ordinal":181114,"en":"Why didn't you know this place?!"},{"id":"semetey-1-2013:p1374:b003:l024","ordinal":181115,"en":"Why, uncle,"},{"id":"semetey-1-2013:p1374:b003:l025","ordinal":181116,"en":"Did you not travel through this place?!"},{"id":"semetey-1-2013:p1374:b003:l026","ordinal":181117,"en":"Uncle Bakai, my gray wolf,"},{"id":"semetey-1-2013:p1374:b003:l027","ordinal":181118,"en":"You failed to see this land—"},{"id":"semetey-1-2013:p1374:b003:l028","ordinal":181119,"en":"What a cause for regret!"},{"id":"semetey-1-2013:p1374:b003:l029","ordinal":181120,"en":"The world's delight,"},{"id":"semetey-1-2013:p1374:b003:l030","ordinal":181121,"en":"A paradise* unseen around the bend,"},{"id":"semetey-1-2013:p1374:b003:l031","ordinal":181122,"en":"Has remained here!"},{"id":"semetey-1-2013:p1374:b003:l032","ordinal":181123,"en":"Could it be a land where people"},{"id":"semetey-1-2013:p1374:b003:l033","ordinal":181124,"en":"Would scatter through the valley and not camp?"},{"id":"semetey-1-2013:p1374:b003:l034","ordinal":181125,"en":"Could it be a land where every man"},{"id":"semetey-1-2013:p1374:b003:l035","ordinal":181126,"en":"Would not become a hero!"},{"id":"semetey-1-2013:p1374:b003:l036","ordinal":181127,"en":"Could it be a land where old women"},{"id":"semetey-1-2013:p1374:b003:l037","ordinal":181128,"en":"Would not slice and chew rump-fat?"},{"id":"semetey-1-2013:p1374:b003:l038","ordinal":181129,"en":"Could it be a land where brave men"},{"id":"semetey-1-2013:p1374:b003:l039","ordinal":181130,"en":"Would not drive a thousand horses?"},{"id":"semetey-1-2013:p1374:b004:l001","ordinal":181131,"en":"Could it be a land where men would not strut"},{"id":"semetey-1-2013:p1374:b004:l002","ordinal":181132,"en":"In pairs of sable caps!"},{"id":"semetey-1-2013:p1374:b004:l003","ordinal":181133,"en":"Could our people camp in neighboring corrals"},{"id":"semetey-1-2013:p1374:b004:l004","ordinal":181134,"en":"And fail to prosper!\""},{"id":"semetey-1-2013:p1374:b004:l005","ordinal":181135,"en":"Aryslan Bakay started the journey,"},{"id":"semetey-1-2013:p1374:b004:l006","ordinal":181136,"en":"At Kongur-Ölöng and Kopo,"},{"id":"semetey-1-2013:p1374:b004:l007","ordinal":181137,"en":"He had a sheep slaughtered there;"},{"id":"semetey-1-2013:p1374:b004:l008","ordinal":181138,"en":"A gentle breeze, a cool summer,"},{"id":"semetey-1-2013:p1374:b004:l009","ordinal":181139,"en":"He pitched the wide screen,"},{"id":"semetey-1-2013:p1374:b004:l010","ordinal":181140,"en":"And removed the saddles"},{"id":"semetey-1-2013:p1374:b004:l011","ordinal":181141,"en":"From all the fine thoroughbreds."},{"id":"semetey-1-2013:p1374:b004:l012","ordinal":181142,"en":"He rested the coursers overnight,"},{"id":"semetey-1-2013:p1374:b004:l013","ordinal":181143,"en":"Keeping them tethered until dawn."},{"id":"semetey-1-2013:p1374:b004:l014","ordinal":181144,"en":"Using Akkangky as a pillow,"},{"id":"semetey-1-2013:p1374:b004:l015","ordinal":181145,"en":"All the valiant men"},{"id":"semetey-1-2013:p1374:b004:l016","ordinal":181146,"en":"Lay with their heads toward the qibla,*"},{"id":"semetey-1-2013:p1374:b004:l017","ordinal":181147,"en":"Resting upon their elbows,"},{"id":"semetey-1-2013:p1374:b004:l018","ordinal":181148,"en":"And took a brief sleep."},{"id":"semetey-1-2013:p1374:b004:l019","ordinal":181149,"en":"Not much time had passed"},{"id":"semetey-1-2013:p1374:b004:l020","ordinal":181150,"en":"When true dawn arrived"},{"id":"semetey-1-2013:p1374:b004:l021","ordinal":181151,"en":"And daybreak turned yellow."},{"id":"semetey-1-2013:p1374:b004:l022","ordinal":181152,"en":"The rim of dawn swelled;"},{"id":"semetey-1-2013:p1374:b004:l023","ordinal":181153,"en":"When the cold wind blows,"},{"id":"semetey-1-2013:p1374:b004:l024","ordinal":181154,"en":"The boys awoke from sleep."},{"id":"semetey-1-2013:p1374:b004:l025","ordinal":181155,"en":"They let all the fine coursers"},{"id":"semetey-1-2013:p1374:b004:l026","ordinal":181156,"en":"Drink their fill of water,"},{"id":"semetey-1-2013:p1374:b004:l027","ordinal":181157,"en":"And graze great mouthfuls"},{"id":"semetey-1-2013:p1374:b004:l028","ordinal":181158,"en":"Of one fescue among eighty grasses."},{"id":"semetey-1-2013:p1374:b004:l029","ordinal":181159,"en":"From a gushing, pure spring,"},{"id":"semetey-1-2013:p1374:b004:l030","ordinal":181160,"en":"Without letting the coursers rise,"},{"id":"semetey-1-2013:p1374:b004:l031","ordinal":181161,"en":"They quenched their thirst."},{"id":"semetey-1-2013:p1374:b004:l032","ordinal":181162,"en":"Leading them about for a long while,"},{"id":"semetey-1-2013:p1374:b004:l033","ordinal":181163,"en":"They filled the stomachs"},{"id":"semetey-1-2013:p1374:b004:l034","ordinal":181164,"en":"Of the fourteen thoroughbred horses with grass."},{"id":"semetey-1-2013:p1374:b004:l035","ordinal":181165,"en":"When the sun reached midmorning,"},{"id":"semetey-1-2013:p1374:b004:l036","ordinal":181166,"en":"The companions stood"},{"id":"semetey-1-2013:p1374:b004:l037","ordinal":181167,"en":"Serving their prince;"},{"id":"semetey-1-2013:p1374:b004:l038","ordinal":181168,"en":"All were champions bound for China."},{"id":"semetey-1-2013:p1374:b004:l039","ordinal":181169,"en":"Such was the condition of the boys."},{"id":"semetey-1-2013:p1375:b003:l001","ordinal":181170,"en":"They loaded the baggage and bustled about,"},{"id":"semetey-1-2013:p1375:b003:l002","ordinal":181171,"en":"Bounding and bunching like roe deer,"},{"id":"semetey-1-2013:p1375:b003:l003","ordinal":181172,"en":"Drawing the ropes and loading the packs;"},{"id":"semetey-1-2013:p1375:b003:l004","ordinal":181173,"en":"Before one could say this or that,"},{"id":"semetey-1-2013:p1375:b003:l005","ordinal":181174,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p1375:b003:l006","ordinal":181175,"en":"They loaded the ammunition stored in saddlebags,"},{"id":"semetey-1-2013:p1375:b003:l007","ordinal":181176,"en":"Loaded up a great wealth of goods,"},{"id":"semetey-1-2013:p1375:b003:l008","ordinal":181177,"en":"And for aged Lord Bakai"},{"id":"semetey-1-2013:p1375:b003:l009","ordinal":181178,"en":"Carved rump meat and served him mane-fat,"},{"id":"semetey-1-2013:p1375:b003:l010","ordinal":181179,"en":"Dipped bread in fat and gave it to him."},{"id":"semetey-1-2013:p1375:b003:l011","ordinal":181180,"en":"Lion Bakai and Semetey,"},{"id":"semetey-1-2013:p1375:b003:l012","ordinal":181181,"en":"With the two companions who followed them,"},{"id":"semetey-1-2013:p1375:b003:l013","ordinal":181182,"en":"Set out and traveled on their journey,"},{"id":"semetey-1-2013:p1375:b003:l014","ordinal":181183,"en":"Riding hard and covering much ground."},{"id":"semetey-1-2013:p1375:b003:l015","ordinal":181184,"en":"When the sun was sinking low,"},{"id":"semetey-1-2013:p1375:b003:l016","ordinal":181185,"en":"At the dark pass of Kapka-Tash,"},{"id":"semetey-1-2013:p1375:b003:l017","ordinal":181186,"en":"They halted at Kapka-Tash."},{"id":"semetey-1-2013:p1375:b003:l018","ordinal":181187,"en":"When they stopped, hero Bakai"},{"id":"semetey-1-2013:p1375:b003:l019","ordinal":181188,"en":"Lamented his grief from long ago!"},{"id":"semetey-1-2013:p1375:b003:l020","ordinal":181189,"en":"His white beard had grown sparse,"},{"id":"semetey-1-2013:p1375:b003:l021","ordinal":181190,"en":"And the tears flowing from his two eyes"},{"id":"semetey-1-2013:p1375:b003:l022","ordinal":181191,"en":"Poured down over his chest:"},{"id":"semetey-1-2013:p1375:b003:l023","ordinal":181192,"en":"“When my noble Manas was alive,"},{"id":"semetey-1-2013:p1375:b003:l024","ordinal":181193,"en":"We wore the flanks of our horses lean,"},{"id":"semetey-1-2013:p1375:b003:l025","ordinal":181194,"en":"Roaming the four corners"},{"id":"semetey-1-2013:p1375:b003:l026","ordinal":181195,"en":"Of the encircling world,"},{"id":"semetey-1-2013:p1375:b003:l027","ordinal":181196,"en":"While my lord was alive."},{"id":"semetey-1-2013:p1375:b003:l028","ordinal":181197,"en":"In Beijing of the Kakanchin,"},{"id":"semetey-1-2013:p1375:b003:l029","ordinal":181198,"en":"My lord Almam, the leopard, was there;"},{"id":"semetey-1-2013:p1375:b003:l030","ordinal":181199,"en":"When I reconnoitered his road,"},{"id":"semetey-1-2013:p1375:b003:l031","ordinal":181200,"en":"From its nobles and its khan,"},{"id":"semetey-1-2013:p1375:b003:l032","ordinal":181201,"en":"From the great city of Beijing,"},{"id":"semetey-1-2013:p1375:b003:l033","ordinal":181202,"en":"When we rode out to reconnoiter the road,"},{"id":"semetey-1-2013:p1375:b003:l034","ordinal":181203,"en":"When we went to demand an answer,"},{"id":"semetey-1-2013:p1375:b003:l035","ordinal":181204,"en":"Indeed, Almam and I"},{"id":"semetey-1-2013:p1375:b003:l036","ordinal":181205,"en":"Stayed at Issyk-Köl."},{"id":"semetey-1-2013:p1375:b003:l037","ordinal":181206,"en":"When we faced and besieged"},{"id":"semetey-1-2013:p1375:b003:l038","ordinal":181207,"en":"Beijing, which lay tightly shut,"},{"id":"semetey-1-2013:p1375:b003:l039","ordinal":181208,"en":"We lived in this world"},{"id":"semetey-1-2013:p1375:b004:l001","ordinal":181209,"en":"Free by our own will for a time."},{"id":"semetey-1-2013:p1375:b004:l002","ordinal":181210,"en":"Almam the formidable and I"},{"id":"semetey-1-2013:p1375:b004:l003","ordinal":181211,"en":"Stayed in this very place."},{"id":"semetey-1-2013:p1375:b004:l004","ordinal":181212,"en":"At that time dusk came and the sun set;"},{"id":"semetey-1-2013:p1375:b004:l005","ordinal":181213,"en":"The spur of that mountain over there,"},{"id":"semetey-1-2013:p1375:b004:l006","ordinal":181214,"en":"The nose of the gray ridge,"},{"id":"semetey-1-2013:p1375:b004:l007","ordinal":181215,"en":"Was a slope with a spring."},{"id":"semetey-1-2013:p1375:b004:l008","ordinal":181216,"en":"The shrine that the leopard Almam named"},{"id":"semetey-1-2013:p1375:b004:l009","ordinal":181217,"en":"Was called Boz-Uchuk Shrine!"},{"id":"semetey-1-2013:p1375:b004:l010","ordinal":181218,"en":"On that broad slope itself"},{"id":"semetey-1-2013:p1375:b004:l011","ordinal":181219,"en":"The people pitched their camp;"},{"id":"semetey-1-2013:p1375:b004:l012","ordinal":181220,"en":"The gray hill on this side"},{"id":"semetey-1-2013:p1375:b004:l013","ordinal":181221,"en":"Was the place where your uncle,"},{"id":"semetey-1-2013:p1375:b004:l014","ordinal":181222,"en":"Hero Bakai, kept watch."},{"id":"semetey-1-2013:p1375:b004:l015","ordinal":181223,"en":"My land remains, but my people are gone."},{"id":"semetey-1-2013:p1375:b004:l016","ordinal":181224,"en":"Now that my beard is white,"},{"id":"semetey-1-2013:p1375:b004:l017","ordinal":181225,"en":"Now that my journey nears its end,"},{"id":"semetey-1-2013:p1375:b004:l018","ordinal":181226,"en":"Parted from those valiant men,"},{"id":"semetey-1-2013:p1375:b004:l019","ordinal":181227,"en":"I alone remain alive in this filthy world."},{"id":"semetey-1-2013:p1375:b004:l020","ordinal":181228,"en":"I have none of my own age, none my equal,"},{"id":"semetey-1-2013:p1375:b004:l021","ordinal":181229,"en":"No hero to ride beside me!"},{"id":"semetey-1-2013:p1375:b004:l022","ordinal":181230,"en":"My dear children,"},{"id":"semetey-1-2013:p1375:b004:l023","ordinal":181231,"en":"This was a place where a holy father lay;"},{"id":"semetey-1-2013:p1375:b004:l024","ordinal":181232,"en":"They called it Boz-Uchuk-Ata."},{"id":"semetey-1-2013:p1375:b004:l025","ordinal":181233,"en":"Boz-Uchuk is a noble shrine—"},{"id":"semetey-1-2013:p1375:b004:l026","ordinal":181234,"en":"Let us camp at Boz-Uchuk!"},{"id":"semetey-1-2013:p1375:b004:l027","ordinal":181235,"en":"Let us survey the lay of the land;"},{"id":"semetey-1-2013:p1375:b004:l028","ordinal":181236,"en":"O calamity-stricken orphans,"},{"id":"semetey-1-2013:p1375:b004:l029","ordinal":181237,"en":"Let us gauge the length of the road!"},{"id":"semetey-1-2013:p1375:b004:l030","ordinal":181238,"en":"Clearing enemies and traveling the road,"},{"id":"semetey-1-2013:p1375:b004:l031","ordinal":181239,"en":"Let us scout that Beijing!"},{"id":"semetey-1-2013:p1375:b004:l032","ordinal":181240,"en":"Let us reach the khan of the Kakanchin,"},{"id":"semetey-1-2013:p1375:b004:l033","ordinal":181241,"en":"The teeming city of Beijing,"},{"id":"semetey-1-2013:p1375:b004:l034","ordinal":181242,"en":"Measuring the land as we go."},{"id":"semetey-1-2013:p1375:b004:l035","ordinal":181243,"en":"It has nobles, it has giants,"},{"id":"semetey-1-2013:p1375:b004:l036","ordinal":181244,"en":"It has peoples of many kinds;"},{"id":"semetey-1-2013:p1375:b004:l037","ordinal":181245,"en":"And among those people"},{"id":"semetey-1-2013:p1375:b004:l038","ordinal":181246,"en":"There is the blue-mottled, gray-bearded great Manchu,"},{"id":"semetey-1-2013:p1375:b004:l039","ordinal":181247,"en":"Hero Kongurbai, famed and mighty."},{"id":"semetey-1-2013:p1376:b003:l001","ordinal":181248,"en":"That raging, death-dealing swine"}]
