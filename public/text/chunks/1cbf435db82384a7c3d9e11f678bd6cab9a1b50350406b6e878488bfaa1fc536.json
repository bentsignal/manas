[{"id":"manas-2010:p1818:b001:l015","ordinal":78081,"en":"My son, do not become like an extinguished fire."},{"id":"manas-2010:p1818:b001:l016","ordinal":78082,"en":"Let those hostile enemies"},{"id":"manas-2010:p1818:b001:l017","ordinal":78083,"en":"Not trample upon your heads,"},{"id":"manas-2010:p1818:b001:l018","ordinal":78084,"en":"Not scatter the four kinds of livestock."},{"id":"manas-2010:p1818:b001:l019","ordinal":78085,"en":"Raiding your mares,"},{"id":"manas-2010:p1818:b001:l020","ordinal":78086,"en":"Let them not slaughter"},{"id":"manas-2010:p1818:b001:l021","ordinal":78087,"en":"The mighty men who have come to this funeral."},{"id":"manas-2010:p1818:b001:l022","ordinal":78088,"en":"Those who answer back—"},{"id":"manas-2010:p1818:b001:l023","ordinal":78089,"en":"Let them not seize and beat them."},{"id":"manas-2010:p1818:b001:l024","ordinal":78090,"en":"Among the Argyn and Kyrgyz in Talas,"},{"id":"manas-2010:p1818:b001:l025","ordinal":78091,"en":"Let them not plunder the khan's estate!”"},{"id":"manas-2010:p1818:b001:l026","ordinal":78092,"en":"As Kanykei stood weeping,"},{"id":"manas-2010:p1818:b001:l027","ordinal":78093,"en":"Kindhearted Abyke"},{"id":"manas-2010:p1818:b001:l028","ordinal":78094,"en":"Yielded readily to her words."},{"id":"manas-2010:p1818:b001:l029","ordinal":78095,"en":"To the Argyn and Kyrgyz"},{"id":"manas-2010:p1818:b001:l030","ordinal":78096,"en":"He called out to receive the guests."},{"id":"manas-2010:p1818:b001:l031","ordinal":78097,"en":"God's decree—"},{"id":"manas-2010:p1818:b001:l032","ordinal":78098,"en":"They accepted that it had ordained this,"},{"id":"manas-2010:p1818:b001:l033","ordinal":78099,"en":"Among the Argyn and Kyrgyz"},{"id":"manas-2010:p1818:b001:l034","ordinal":78100,"en":"They distributed the arriving guests,"},{"id":"manas-2010:p1818:b001:l035","ordinal":78101,"en":"Assigning every last one among the households."},{"id":"manas-2010:p1818:b001:l036","ordinal":78102,"en":"To each of the various khans,"},{"id":"manas-2010:p1818:b001:l037","ordinal":78103,"en":"Eighty camel-loads of firewood"},{"id":"manas-2010:p1818:b001:l038","ordinal":78104,"en":"He gave for their fires."},{"id":"manas-2010:p1818:b001:l039","ordinal":78105,"en":"Eighty wethers and eighty mares"},{"id":"manas-2010:p1818:b001:l040","ordinal":78106,"en":"He gave for slaughter."},{"id":"manas-2010:p1818:b001:l041","ordinal":78107,"en":"Sugar like a reclining camel or a cow"},{"id":"manas-2010:p1818:b001:l042","ordinal":78108,"en":"He gave them to break apart."},{"id":"manas-2010:p1819:b001:l001","ordinal":78109,"en":"Assigning guests to each household,"},{"id":"manas-2010:p1819:b001:l002","ordinal":78110,"en":"For six days the six scoundrels,"},{"id":"manas-2010:p1819:b001:l003","ordinal":78111,"en":"Attending to nothing else,"},{"id":"manas-2010:p1819:b001:l004","ordinal":78112,"en":"Distributed the guests."},{"id":"manas-2010:p1819:b001:l005","ordinal":78113,"en":"As the sun slowly sank,"},{"id":"manas-2010:p1819:b001:l006","ordinal":78114,"en":"When the first of the people lay down,"},{"id":"manas-2010:p1819:b001:l007","ordinal":78115,"en":"Precious Kanykei"},{"id":"manas-2010:p1819:b001:l008","ordinal":78116,"en":"Went weeping to Koshoi."},{"id":"manas-2010:p1819:b001:l009","ordinal":78117,"en":"Her ribs seeming to come apart,"},{"id":"manas-2010:p1819:b001:l010","ordinal":78118,"en":"Her tears pouring down:"},{"id":"manas-2010:p1819:b001:l011","ordinal":78119,"en":"“Of paradise where no weariness dwells,"},{"id":"manas-2010:p1819:b001:l012","ordinal":78120,"en":"My heroic elder, you opened the gate."},{"id":"manas-2010:p1819:b001:l013","ordinal":78121,"en":"Of the gathered unbelievers,"},{"id":"manas-2010:p1819:b001:l014","ordinal":78122,"en":"My lion-elder, you shattered the city."},{"id":"manas-2010:p1819:b001:l015","ordinal":78123,"en":"Spear in hand, you broke the ranks,"},{"id":"manas-2010:p1819:b001:l016","ordinal":78124,"en":"My heroic elder, khan of the world."},{"id":"manas-2010:p1819:b001:l017","ordinal":78125,"en":"I am a hapless woman;"},{"id":"manas-2010:p1819:b001:l018","ordinal":78126,"en":"You are the sovereign, Khan Koshoi."},{"id":"manas-2010:p1819:b001:l019","ordinal":78127,"en":"I have broken apart—join me together!"},{"id":"manas-2010:p1819:b001:l020","ordinal":78128,"en":"Dear elder, I have scattered—gather me!"},{"id":"manas-2010:p1819:b001:l021","ordinal":78129,"en":"Kindle my extinguished fire;"},{"id":"manas-2010:p1819:b001:l022","ordinal":78130,"en":"Dear elder, revive my dead soul."},{"id":"manas-2010:p1819:b001:l023","ordinal":78131,"en":"Your younger brother, greathearted Manas,"},{"id":"manas-2010:p1819:b001:l024","ordinal":78132,"en":"The youngest of six lions,"},{"id":"manas-2010:p1819:b001:l025","ordinal":78133,"en":"God's beloved servant—"},{"id":"manas-2010:p1819:b001:l026","ordinal":78134,"en":"Of fortified Mecca,"},{"id":"manas-2010:p1819:b001:l027","ordinal":78135,"en":"Was not the blue-maned one the backbone?"},{"id":"manas-2010:p1819:b001:l028","ordinal":78136,"en":"Of the faith of Islam that relied upon him,"},{"id":"manas-2010:p1819:b001:l029","ordinal":78137,"en":"Was not the blue-maned one the lion?"},{"id":"manas-2010:p1819:b001:l030","ordinal":78138,"en":"He set fire to grassy land,"},{"id":"manas-2010:p1819:b001:l031","ordinal":78139,"en":"Poured blood into the spring-water,"},{"id":"manas-2010:p1819:b001:l032","ordinal":78140,"en":"Entered bloodshed and grew hardened,"},{"id":"manas-2010:p1819:b001:l033","ordinal":78141,"en":"Won the name Manas the Leopard."},{"id":"manas-2010:p1819:b001:l034","ordinal":78142,"en":"There are those his hand has struck;"},{"id":"manas-2010:p1819:b001:l035","ordinal":78143,"en":"There are places he has humiliated."},{"id":"manas-2010:p1819:b001:l036","ordinal":78144,"en":"If we bury the greathearted one openly,"},{"id":"manas-2010:p1819:b001:l037","ordinal":78145,"en":"Or lay Manas where he can be seen,"},{"id":"manas-2010:p1819:b001:l038","ordinal":78146,"en":"Let them not open his grave,"},{"id":"manas-2010:p1819:b001:l039","ordinal":78147,"en":"Drag him onto the road,"},{"id":"manas-2010:p1819:b001:l040","ordinal":78148,"en":"Seeking vengeance upon the dead,"},{"id":"manas-2010:p1819:b001:l041","ordinal":78149,"en":"And cast him to the dogs."},{"id":"manas-2010:p1819:b001:l042","ordinal":78150,"en":"What course shall we take?"},{"id":"manas-2010:p1820:b001:l001","ordinal":78151,"en":"What means shall we find now?"},{"id":"manas-2010:p1820:b001:l002","ordinal":78152,"en":"When the moon grows dark,"},{"id":"manas-2010:p1820:b001:l003","ordinal":78153,"en":"Dear elder, what will the night become?"},{"id":"manas-2010:p1820:b001:l004","ordinal":78154,"en":"The son left behind is young;"},{"id":"manas-2010:p1820:b001:l005","ordinal":78155,"en":"What will become of his days?"},{"id":"manas-2010:p1820:b001:l006","ordinal":78156,"en":"The six kinsmen—"},{"id":"manas-2010:p1820:b001:l007","ordinal":78157,"en":"Treachery stands in their eyes."},{"id":"manas-2010:p1820:b001:l008","ordinal":78158,"en":"If they find the chance,"},{"id":"manas-2010:p1820:b001:l009","ordinal":78159,"en":"They are poised to trip me up.”"},{"id":"manas-2010:p1820:b001:l010","ordinal":78160,"en":"Unable to find a way,"},{"id":"manas-2010:p1820:b001:l011","ordinal":78161,"en":"Khan Koshoi stood bewildered."},{"id":"manas-2010:p1820:b001:l012","ordinal":78162,"en":"“This is the world's end,” he said;"},{"id":"manas-2010:p1820:b001:l013","ordinal":78163,"en":"Toshtuk too was filled with sorrow."},{"id":"manas-2010:p1820:b001:l014","ordinal":78164,"en":"Then your sister-in-law Kanykei,"},{"id":"manas-2010:p1820:b001:l015","ordinal":78165,"en":"In the midst of the night,"},{"id":"manas-2010:p1820:b001:l016","ordinal":78166,"en":"Led them all along."},{"id":"manas-2010:p1820:b001:l017","ordinal":78167,"en":"A man of sacred power had come;"},{"id":"manas-2010:p1820:b001:l018","ordinal":78168,"en":"From lower golden Mecca"},{"id":"manas-2010:p1820:b001:l019","ordinal":78169,"en":"He had come as an imam to Islam."},{"id":"manas-2010:p1820:b001:l020","ordinal":78170,"en":"She led out the mighty Koshoi and Toshtuk,"},{"id":"manas-2010:p1820:b001:l021","ordinal":78171,"en":"Brought them in a file from the court,"},{"id":"manas-2010:p1820:b001:l022","ordinal":78172,"en":"Kokboru and Koyonaaly on foot."},{"id":"manas-2010:p1820:b001:l023","ordinal":78173,"en":"She brought them out in a file,"},{"id":"manas-2010:p1820:b001:l024","ordinal":78174,"en":"Those forty holy men on foot."},{"id":"manas-2010:p1820:b001:l025","ordinal":78175,"en":"The body of sovereign Khan Manas—"},{"id":"manas-2010:p1820:b001:l026","ordinal":78176,"en":"She had Khans Koshoi and Toshtuk"},{"id":"manas-2010:p1820:b001:l027","ordinal":78177,"en":"Wash it in ritual purity,"},{"id":"manas-2010:p1820:b001:l028","ordinal":78178,"en":"Wrap it in fine white cloth,"},{"id":"manas-2010:p1820:b001:l029","ordinal":78179,"en":"And laid it upon the bier."},{"id":"manas-2010:p1820:b001:l030","ordinal":78180,"en":"Kanykei, newly clad in mourning,"},{"id":"manas-2010:p1820:b001:l031","ordinal":78181,"en":"And the little cradle-child Semetey—"},{"id":"manas-2010:p1820:b001:l032","ordinal":78182,"en":"Six thousand, headed by horses,"},{"id":"manas-2010:p1820:b001:l033","ordinal":78183,"en":"She had made ready for his absolution rite,"},{"id":"manas-2010:p1820:b001:l034","ordinal":78184,"en":"Had Khan Koshoi recite his funeral prayer."},{"id":"manas-2010:p1820:b001:l035","ordinal":78185,"en":"She had him bound head to foot in a carpet."},{"id":"manas-2010:p1820:b001:l036","ordinal":78186,"en":"Your noble sister-in-law Kanykei"},{"id":"manas-2010:p1820:b001:l037","ordinal":78187,"en":"Mounted Taibuurul;"},{"id":"manas-2010:p1820:b001:l038","ordinal":78188,"en":"Taking a gem-lit lamp in her hand,"},{"id":"manas-2010:p1820:b001:l039","ordinal":78189,"en":"She went ahead to lead the way."},{"id":"manas-2010:p1820:b001:l040","ordinal":78190,"en":"In the rock of Echkilik,"},{"id":"manas-2010:p1820:b001:l041","ordinal":78191,"en":"Before Manas had died,"},{"id":"manas-2010:p1820:b001:l042","ordinal":78192,"en":"She had prepared a resting-place beforehand."},{"id":"manas-2010:p1821:b001:l001","ordinal":78193,"en":"Kanykei had dug its entrance"},{"id":"manas-2010:p1821:b001:l002","ordinal":78194,"en":"To admit a single person."},{"id":"manas-2010:p1821:b001:l003","ordinal":78195,"en":"She had the space beyond hollowed out"},{"id":"manas-2010:p1821:b001:l004","ordinal":78196,"en":"To hold six thousand sheep."},{"id":"manas-2010:p1821:b001:l005","ordinal":78197,"en":"Its interior was bright and clear."},{"id":"manas-2010:p1821:b001:l006","ordinal":78198,"en":"Rubies and precious gems,"},{"id":"manas-2010:p1821:b001:l007","ordinal":78199,"en":"She had set shining together;"},{"id":"manas-2010:p1821:b001:l008","ordinal":78200,"en":"In all its six corners"},{"id":"manas-2010:p1821:b001:l009","ordinal":78201,"en":"She had light cast from them."},{"id":"manas-2010:p1821:b001:l010","ordinal":78202,"en":"“Lest the roof collapse,” she said,"},{"id":"manas-2010:p1821:b001:l011","ordinal":78203,"en":"At sixty selected places"},{"id":"manas-2010:p1821:b001:l012","ordinal":78204,"en":"She had golden pillars erected."},{"id":"manas-2010:p1821:b001:l013","ordinal":78205,"en":"“Lest the interior turn soggy,” she said,"},{"id":"manas-2010:p1821:b001:l014","ordinal":78206,"en":"She had a passage broken with iron crowbars,"},{"id":"manas-2010:p1821:b001:l015","ordinal":78207,"en":"Showing her skill;"},{"id":"manas-2010:p1821:b001:l016","ordinal":78208,"en":"The spring-water overhead"},{"id":"manas-2010:p1821:b001:l017","ordinal":78209,"en":"She made flow through the cave."},{"id":"manas-2010:p1821:b001:l018","ordinal":78210,"en":"Where the warrior was to lie,"},{"id":"manas-2010:p1821:b001:l019","ordinal":78211,"en":"She had a bed of gold made."},{"id":"manas-2010:p1821:b001:l020","ordinal":78212,"en":"“Lest the underside rot,” she said,"},{"id":"manas-2010:p1821:b001:l021","ordinal":78213,"en":"She had juniper ashes spread."},{"id":"manas-2010:p1821:b001:l022","ordinal":78214,"en":"Soaked in water forty years,"},{"id":"manas-2010:p1821:b001:l023","ordinal":78215,"en":"Its edges would not fade at all;"},{"id":"manas-2010:p1821:b001:l024","ordinal":78216,"en":"Soaked in water eighty years,"},{"id":"manas-2010:p1821:b001:l025","ordinal":78217,"en":"Its edges would not fray."},{"id":"manas-2010:p1821:b001:l026","ordinal":78218,"en":"The carpet with its golden patterns,"},{"id":"manas-2010:p1821:b001:l027","ordinal":78219,"en":"She had spread snugly beneath him."},{"id":"manas-2010:p1821:b001:l028","ordinal":78220,"en":"Precious Kanykei"},{"id":"manas-2010:p1821:b001:l029","ordinal":78221,"en":"Had made it a paradise upon this earth."},{"id":"manas-2010:p1821:b001:l030","ordinal":78222,"en":"The elders Koshoi and Toshtuk"},{"id":"manas-2010:p1821:b001:l031","ordinal":78223,"en":"Entered the cave,"},{"id":"manas-2010:p1821:b001:l032","ordinal":78224,"en":"With all the forty holy men present."},{"id":"manas-2010:p1821:b001:l033","ordinal":78225,"en":"Planting their spears and wailing,"},{"id":"manas-2010:p1821:b001:l034","ordinal":78226,"en":"Allah, whose decree is precious—"},{"id":"manas-2010:p1821:b001:l035","ordinal":78227,"en":"Grieving even at his decree,"},{"id":"manas-2010:p1821:b001:l036","ordinal":78228,"en":"There they laid your swift steed Manas to rest."},{"id":"manas-2010:p1821:b001:l037","ordinal":78229,"en":"Submitting to his decree,"},{"id":"manas-2010:p1821:b001:l038","ordinal":78230,"en":"The Quran's chapter “Tappat”"},{"id":"manas-2010:p1821:b001:l039","ordinal":78231,"en":"They recited with care."},{"id":"manas-2010:p1821:b001:l040","ordinal":78232,"en":"Khan Koshoi of the Katagan"},{"id":"manas-2010:p1821:b001:l041","ordinal":78233,"en":"Stood looking on in distress,"},{"id":"manas-2010:p1821:b001:l042","ordinal":78234,"en":"Then implored Kanykei:"},{"id":"manas-2010:p1822:b001:l001","ordinal":78235,"en":"“My child Kanykei, fairest of the dark-complexioned,"},{"id":"manas-2010:p1822:b001:l002","ordinal":78236,"en":"Radiant one among the Muslims,"},{"id":"manas-2010:p1822:b001:l003","ordinal":78237,"en":"My child, may whoever calls you a mere woman come to no good!"},{"id":"manas-2010:p1822:b001:l004","ordinal":78238,"en":"Whoever calls you a mere female,"},{"id":"manas-2010:p1822:b001:l005","ordinal":78239,"en":"May nothing he does ever prosper!”"},{"id":"manas-2010:p1822:b001:l006","ordinal":78240,"en":"Saying these words then,"},{"id":"manas-2010:p1822:b001:l007","ordinal":78241,"en":"The khans filed out."},{"id":"manas-2010:p1822:b001:l008","ordinal":78242,"en":"Grieving deeply for Manas,"},{"id":"manas-2010:p1822:b001:l009","ordinal":78243,"en":"Behind those filing out,"},{"id":"manas-2010:p1822:b001:l010","ordinal":78244,"en":"The khans came forth crying aloud."},{"id":"manas-2010:p1822:b001:l011","ordinal":78245,"en":"Walking sorrowfully without stopping,"},{"id":"manas-2010:p1822:b001:l012","ordinal":78246,"en":"The precious khan lamented:"},{"id":"manas-2010:p1822:b001:l013","ordinal":78247,"en":"“While Manas was here,"},{"id":"manas-2010:p1822:b001:l014","ordinal":78248,"en":"Islam's heart was at peace."},{"id":"manas-2010:p1822:b001:l015","ordinal":78249,"en":"Bereft of the leopard,"},{"id":"manas-2010:p1822:b001:l016","ordinal":78250,"en":"Not the slightest blessing remains for us."},{"id":"manas-2010:p1822:b001:l017","ordinal":78251,"en":"Honored Manas's eyes have closed."},{"id":"manas-2010:p1822:b001:l018","ordinal":78252,"en":"You few followers of Islam,"},{"id":"manas-2010:p1822:b001:l019","ordinal":78253,"en":"Parted from your Manas,"},{"id":"manas-2010:p1822:b001:l020","ordinal":78254,"en":"Has your soul found peace now?"},{"id":"manas-2010:p1822:b001:l021","ordinal":78255,"en":"Your Blood-Shedder Manas has fallen."},{"id":"manas-2010:p1822:b001:l022","ordinal":78256,"en":"We are finished, Muslims;"},{"id":"manas-2010:p1822:b001:l023","ordinal":78257,"en":"The deeply rooted plane tree has fallen.”"},{"id":"manas-2010:p1822:b001:l024","ordinal":78258,"en":"Before the pale dawn broke,"},{"id":"manas-2010:p1822:b001:l025","ordinal":78259,"en":"They turned back."},{"id":"manas-2010:p1822:b001:l026","ordinal":78260,"en":"To Khan Manas's court"},{"id":"manas-2010:p1822:b001:l027","ordinal":78261,"en":"Your people returned."},{"id":"manas-2010:p1822:b001:l028","ordinal":78262,"en":"Bakai the lion, boundlessly skilled,"},{"id":"manas-2010:p1822:b001:l029","ordinal":78263,"en":"Had cut down a poplar"},{"id":"manas-2010:p1822:b001:l030","ordinal":78264,"en":"And fashioned a towering figure,"},{"id":"manas-2010:p1822:b001:l031","ordinal":78265,"en":"An effigy exactly like Manas."},{"id":"manas-2010:p1822:b001:l032","ordinal":78266,"en":"Matching hand to hand,"},{"id":"manas-2010:p1822:b001:l033","ordinal":78267,"en":"Shaping foot to foot,"},{"id":"manas-2010:p1822:b001:l034","ordinal":78268,"en":"Wrapping it in fine white cloth,"},{"id":"manas-2010:p1822:b001:l035","ordinal":78269,"en":"Having it covered with leather,"},{"id":"manas-2010:p1822:b001:l036","ordinal":78270,"en":"Draping it in white felt,"},{"id":"manas-2010:p1822:b001:l037","ordinal":78271,"en":"Making it just like Manas,"},{"id":"manas-2010:p1822:b001:l038","ordinal":78272,"en":"He had laid it upon the bier."},{"id":"manas-2010:p1822:b001:l039","ordinal":78273,"en":"A thousand black camels"},{"id":"manas-2010:p1822:b001:l040","ordinal":78274,"en":"He had tied for the absolution rite."},{"id":"manas-2010:p1822:b001:l041","ordinal":78275,"en":"Andijan's yellow-patterned cloth with its costly weft,"},{"id":"manas-2010:p1822:b001:l042","ordinal":78276,"en":"Bukhara's costly dark-patterned cloth,"},{"id":"manas-2010:p1823:b001:l001","ordinal":78277,"en":"He had torn into mourning gifts."},{"id":"manas-2010:p1823:b001:l002","ordinal":78278,"en":"Six hundred, headed by horses,"},{"id":"manas-2010:p1823:b001:l003","ordinal":78279,"en":"He gave to the holy man in white."},{"id":"manas-2010:p1823:b001:l004","ordinal":78280,"en":"Nine hundred, headed by camels,"},{"id":"manas-2010:p1823:b001:l005","ordinal":78281,"en":"He gave to the forty holy men."},{"id":"manas-2010:p1823:b001:l006","ordinal":78282,"en":"To those owed small debts,"},{"id":"manas-2010:p1823:b001:l007","ordinal":78283,"en":"He gave sleek mares."},{"id":"manas-2010:p1823:b001:l008","ordinal":78284,"en":"To khans pressing claims,"},{"id":"manas-2010:p1823:b001:l009","ordinal":78285,"en":"He gave fine gold by the pood."},{"id":"manas-2010:p1823:b001:l010","ordinal":78286,"en":"Manas escaped the torment of Judgment Day."},{"id":"manas-2010:p1823:b001:l011","ordinal":78287,"en":"The sovereign remained uncleared"},{"id":"manas-2010:p1823:b001:l012","ordinal":78288,"en":"Of a small transgression harbored in his bosom."},{"id":"manas-2010:p1823:b001:l013","ordinal":78289,"en":"Otherwise, precious Kanykei"},{"id":"manas-2010:p1823:b001:l014","ordinal":78290,"en":"Had rescued Manas"},{"id":"manas-2010:p1823:b001:l015","ordinal":78291,"en":"From the torment he would face in the other world."},{"id":"manas-2010:p1823:b001:l016","ordinal":78292,"en":"His heedless drinking of grain beer,"},{"id":"manas-2010:p1823:b001:l017","ordinal":78293,"en":"His beating a holy man till he wailed,"},{"id":"manas-2010:p1823:b001:l018","ordinal":78294,"en":"His taking liquor and drinking it,"},{"id":"manas-2010:p1823:b001:l019","ordinal":78295,"en":"His lying with a prostitute beautiful as glass—"},{"id":"manas-2010:p1823:b001:l020","ordinal":78296,"en":"She freed him from their punishment."},{"id":"manas-2010:p1823:b001:l021","ordinal":78297,"en":"When the six scoundrels entered,"},{"id":"manas-2010:p1823:b001:l022","ordinal":78298,"en":"She consented to what they said."},{"id":"manas-2010:p1823:b001:l023","ordinal":78299,"en":"Placing Manas upon the bier,"},{"id":"manas-2010:p1823:b001:l024","ordinal":78300,"en":"To the Argyn and Kyrgyz,"},{"id":"manas-2010:p1823:b001:l025","ordinal":78301,"en":"To the six scoundrels, she handed him over."},{"id":"manas-2010:p1823:b001:l026","ordinal":78302,"en":"They carried him away wailing,"},{"id":"manas-2010:p1823:b001:l027","ordinal":78303,"en":"Booming, “My Greathearted One!”"},{"id":"manas-2010:p1823:b001:l028","ordinal":78304,"en":"To Khan Manas's enclosure,"},{"id":"manas-2010:p1823:b001:l029","ordinal":78305,"en":"To the enclosure they brought him."},{"id":"manas-2010:p1823:b001:l030","ordinal":78306,"en":"Crying, “My Greathearted One!” they set it sprawled out"},{"id":"manas-2010:p1823:b001:l031","ordinal":78307,"en":"And buried the wooden figure."},{"id":"manas-2010:p1823:b001:l032","ordinal":78308,"en":"Koshoi and Toshtuk stood there,"},{"id":"manas-2010:p1823:b001:l033","ordinal":78309,"en":"Swearing an oath upon their lives,"},{"id":"manas-2010:p1823:b001:l034","ordinal":78310,"en":"Chewing white wheat flour,"},{"id":"manas-2010:p1823:b001:l035","ordinal":78311,"en":"Holding the Holy Quran,"},{"id":"manas-2010:p1823:b001:l036","ordinal":78312,"en":"Making their promise firm,"},{"id":"manas-2010:p1823:b001:l037","ordinal":78313,"en":"Pledging themselves unto death."},{"id":"manas-2010:p1823:b001:l038","ordinal":78314,"en":"Horses of every kind have piebald heads;"},{"id":"manas-2010:p1823:b001:l039","ordinal":78315,"en":"The greathearted one's son left behind is young."},{"id":"manas-2010:p1823:b001:l040","ordinal":78316,"en":"“Let us serve him faithfully,"},{"id":"manas-2010:p1823:b001:l041","ordinal":78317,"en":"Making his fame known to the great people."},{"id":"manas-2010:p1823:b001:l042","ordinal":78318,"en":"Let us stand together at Manas's memorial feast;"},{"id":"manas-2010:p1824:b001:l001","ordinal":78319,"en":"Let us take counsel together."},{"id":"manas-2010:p1824:b001:l002","ordinal":78320,"en":"If anyone should harbor enmity,"},{"id":"manas-2010:p1824:b001:l003","ordinal":78321,"en":"Let us trample upon his head,"},{"id":"manas-2010:p1824:b001:l004","ordinal":78322,"en":"Scatter his four kinds of livestock,"},{"id":"manas-2010:p1824:b001:l005","ordinal":78323,"en":"Raid his mares."},{"id":"manas-2010:p1824:b001:l006","ordinal":78324,"en":"If he comes near, let us strike his brains out,"},{"id":"manas-2010:p1824:b001:l007","ordinal":78325,"en":"Let us drive them out thus,"},{"id":"manas-2010:p1824:b001:l008","ordinal":78326,"en":"Even those from far away."},{"id":"manas-2010:p1824:b001:l009","ordinal":78327,"en":"Binding many of their mighty men,"},{"id":"manas-2010:p1824:b001:l010","ordinal":78328,"en":"Let us strike their brains out."},{"id":"manas-2010:p1824:b001:l011","ordinal":78329,"en":"Making their children scream,"},{"id":"manas-2010:p1824:b001:l012","ordinal":78330,"en":"If they oppress the orphan,"},{"id":"manas-2010:p1824:b001:l013","ordinal":78331,"en":"Let us burn to the ground"},{"id":"manas-2010:p1824:b001:l014","ordinal":78332,"en":"The city of those who attack him."},{"id":"manas-2010:p1824:b001:l015","ordinal":78333,"en":"Let us fasten banners to our spears."},{"id":"manas-2010:p1824:b001:l016","ordinal":78334,"en":"This greathearted one's child,"},{"id":"manas-2010:p1824:b001:l017","ordinal":78335,"en":"Until he reaches twelve,"},{"id":"manas-2010:p1824:b001:l018","ordinal":78336,"en":"Let us watch over and raise him."}]
