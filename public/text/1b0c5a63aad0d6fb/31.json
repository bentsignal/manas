[{"id":"manas-2010:p0182:b002:l002","ordinal":7937,"en":"Valiant Manas was immersed,"},{"id":"manas-2010:p0182:b002:l003","ordinal":7938,"en":"On a yellow, rolling rise,"},{"id":"manas-2010:p0182:b002:l004","ordinal":7939,"en":"He was playing ordo."},{"id":"manas-2010:p0182:b002:l005","ordinal":7940,"en":"His idle game was shooting ordo,"},{"id":"manas-2010:p0182:b002:l006","ordinal":7941,"en":"The forty boys beside him"},{"id":"manas-2010:p0182:b002:l007","ordinal":7942,"en":"Were lion Manas's companions."},{"id":"manas-2010:p0182:b002:l008","ordinal":7943,"en":"The merry boy Chalybay,"},{"id":"manas-2010:p0182:b002:l009","ordinal":7944,"en":"From the boys of forty households,"},{"id":"manas-2010:p0182:b002:l010","ordinal":7945,"en":"Had gathered his friends, ah,"},{"id":"manas-2010:p0182:b002:l011","ordinal":7946,"en":"They had drawn the boundary line."},{"id":"manas-2010:p0182:b002:l012","ordinal":7947,"en":"Stepping fairly, not foully,"},{"id":"manas-2010:p0182:b002:l013","ordinal":7948,"en":"Stepping exactly, without crookedness,"},{"id":"manas-2010:p0182:b002:l014","ordinal":7949,"en":"Making the kadamak shots,"},{"id":"manas-2010:p0182:b002:l015","ordinal":7950,"en":"As they played the game,"},{"id":"manas-2010:p0182:b002:l016","ordinal":7951,"en":"As they made the toorumak shots,"},{"id":"manas-2010:p0182:b002:l017","ordinal":7952,"en":"Mighty Manas went inside,"},{"id":"manas-2010:p0182:b002:l018","ordinal":7953,"en":"In the great game of flicking knucklebones,"},{"id":"manas-2010:p0182:b002:l019","ordinal":7954,"en":"Mighty Manas set to work."},{"id":"manas-2010:p0182:b002:l020","ordinal":7955,"en":"When deeply immersed in the pleasure,"},{"id":"manas-2010:p0182:b002:l021","ordinal":7956,"en":"As he was flicking knucklebones,"},{"id":"manas-2010:p0182:b002:l022","ordinal":7957,"en":"Esenkan's forty nar camels,"},{"id":"manas-2010:p0182:b002:l023","ordinal":7958,"en":"Loaded with gold and gold coins,"},{"id":"manas-2010:p0182:b002:l024","ordinal":7959,"en":"At the head of those forty nar camels,"},{"id":"manas-2010:p0182:b002:l025","ordinal":7960,"en":"A red nar from the treasury,"},{"id":"manas-2010:p0182:b002:l026","ordinal":7961,"en":"Much gold and costly goods,"},{"id":"manas-2010:p0182:b002:l027","ordinal":7962,"en":"With six Sarts leading them at the front,"},{"id":"manas-2010:p0182:b002:l028","ordinal":7963,"en":"Toward Manas flicking knucklebones,"},{"id":"manas-2010:p0182:b002:l029","ordinal":7964,"en":"Some two hundred champions from behind"},{"id":"manas-2010:p0182:b002:l030","ordinal":7965,"en":"Hurried the servants on,"},{"id":"manas-2010:p0182:b002:l031","ordinal":7966,"en":"Of the ordo game they were playing,"},{"id":"manas-2010:p0182:b002:l032","ordinal":7967,"en":"They made them walk straight through the middle."},{"id":"manas-2010:p0182:b002:l033","ordinal":7968,"en":"The lion bristled in menace:"},{"id":"manas-2010:p0182:b002:l034","ordinal":7969,"en":"“Caravan men, merchants,"},{"id":"manas-2010:p0182:b002:l035","ordinal":7970,"en":"Find your road and drive along it,"},{"id":"manas-2010:p0182:b002:l036","ordinal":7971,"en":"You infidels who deceive the people,"},{"id":"manas-2010:p0182:b002:l037","ordinal":7972,"en":"I shall show you a fine sight now!”"},{"id":"manas-2010:p0182:b002:l038","ordinal":7973,"en":"That Manas grew angry,"},{"id":"manas-2010:p0182:b002:l039","ordinal":7974,"en":"He flicked a single knucklebone,"},{"id":"manas-2010:p0182:b002:l040","ordinal":7975,"en":"The knucklebone flew with a whine,"},{"id":"manas-2010:p0182:b002:l041","ordinal":7976,"en":"Esenkan's two nar camels,"},{"id":"manas-2010:p0182:b002:l042","ordinal":7977,"en":"The leg bones struck by the knucklebone,"},{"id":"manas-2010:p0182:b002:l043","ordinal":7978,"en":"Shattered to fragments,"},{"id":"manas-2010:p0182:b002:l044","ordinal":7979,"en":"The red nar collapsed and fell."},{"id":"manas-2010:p0182:b002:l045","ordinal":7980,"en":"The champions worked themselves up,"},{"id":"manas-2010:p0182:b002:l046","ordinal":7981,"en":"Among those champions,"},{"id":"manas-2010:p0182:b002:l047","ordinal":7982,"en":"The giant Döödür spoke out,"},{"id":"manas-2010:p0182:b002:l048","ordinal":7983,"en":"God had struck that champion,"},{"id":"manas-2010:p0183:b002:l002","ordinal":7984,"en":"The hair on his crown bristling,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p0183:b002:l003","ordinal":7985,"en":"Raging and working himself up,"},{"id":"manas-2010:p0183:b002:l004","ordinal":7986,"en":"Addressing Khan Manas,"},{"id":"manas-2010:p0183:b002:l005","ordinal":7987,"en":"The axemen ran,"},{"id":"manas-2010:p0183:b002:l006","ordinal":7988,"en":"The forty boys beside him,"},{"id":"manas-2010:p0183:b002:l007","ordinal":7989,"en":"“We are dead!” they said, despairing of life,"},{"id":"manas-2010:p0183:b002:l008","ordinal":7990,"en":"Khan Manas, blessed by Khizir,"},{"id":"manas-2010:p0183:b002:l009","ordinal":7991,"en":"Was about to draw the line,"},{"id":"manas-2010:p0183:b002:l010","ordinal":7992,"en":"Was about to begin the havoc,"},{"id":"manas-2010:p0183:b002:l011","ordinal":7993,"en":"Twelve champions bearing clubs,"},{"id":"manas-2010:p0183:b002:l012","ordinal":7994,"en":"Sixty champions bearing spears,"},{"id":"manas-2010:p0183:b002:l013","ordinal":7995,"en":"Their arm armor spreading wide,"},{"id":"manas-2010:p0183:b002:l014","ordinal":7996,"en":"Their armored jackets bulging,"},{"id":"manas-2010:p0183:b002:l015","ordinal":7997,"en":"Shooting bows like rain,"},{"id":"manas-2010:p0183:b002:l016","ordinal":7998,"en":"Firing shot like hail,"},{"id":"manas-2010:p0183:b002:l017","ordinal":7999,"en":"Two hundred champions rushed upon him,"},{"id":"manas-2010:p0183:b002:l018","ordinal":8000,"en":"To seize Manas,"},{"id":"manas-2010:p0183:b002:l019","ordinal":8001,"en":"To capture him alive,"},{"id":"manas-2010:p0183:b002:l020","ordinal":8002,"en":"Then Manas the leopard,"},{"id":"manas-2010:p0183:b002:l021","ordinal":8003,"en":"His eyes blazing like a lion's,"},{"id":"manas-2010:p0183:b002:l022","ordinal":8004,"en":"His thirst for blood truly seized him,"},{"id":"manas-2010:p0183:b002:l023","ordinal":8005,"en":"His world was complete,"},{"id":"manas-2010:p0183:b002:l024","ordinal":8006,"en":"If you looked within him,"},{"id":"manas-2010:p0183:b002:l025","ordinal":8007,"en":"He was wider than the face of the earth."},{"id":"manas-2010:p0183:b002:l026","ordinal":8008,"en":"The youngest of six lions,"},{"id":"manas-2010:p0183:b002:l027","ordinal":8009,"en":"God's beloved servant,"},{"id":"manas-2010:p0183:b002:l028","ordinal":8010,"en":"Whom no one had troubled,"},{"id":"manas-2010:p0183:b002:l029","ordinal":8011,"en":"His fortune surpassing, his name mighty,"},{"id":"manas-2010:p0183:b002:l030","ordinal":8012,"en":"None remained to turn a catching-pole on the grey-maned one."},{"id":"manas-2010:p0183:b002:l031","ordinal":8013,"en":"When he saw the champions,"},{"id":"manas-2010:p0183:b002:l032","ordinal":8014,"en":"Keen warrior Manas the lion"},{"id":"manas-2010:p0183:b002:l033","ordinal":8015,"en":"Wrought wonders here,"},{"id":"manas-2010:p0183:b002:l034","ordinal":8016,"en":"Taking a club and roaring,"},{"id":"manas-2010:p0183:b002:l035","ordinal":8017,"en":"As he came on, playing, playing,"},{"id":"manas-2010:p0183:b002:l036","ordinal":8018,"en":"Twelve champions died together."},{"id":"manas-2010:p0183:b002:l037","ordinal":8019,"en":"Manas unleashed his wrath,"},{"id":"manas-2010:p0183:b002:l038","ordinal":8020,"en":"Stretching sixty of them out,"},{"id":"manas-2010:p0183:b002:l039","ordinal":8021,"en":"The lion slaughtered them."},{"id":"manas-2010:p0183:b002:l040","ordinal":8022,"en":"Bending their club-like necks,"},{"id":"manas-2010:p0183:b002:l041","ordinal":8023,"en":"He tore out their throats."},{"id":"manas-2010:p0183:b002:l042","ordinal":8024,"en":"Attacking the bloodthirsty lion,"},{"id":"manas-2010:p0183:b002:l043","ordinal":8025,"en":"So many champions lay stretched out,"},{"id":"manas-2010:p0183:b002:l044","ordinal":8026,"en":"Champions like small travel tents"},{"id":"manas-2010:p0183:b002:l045","ordinal":8027,"en":"Lay dead, limbs sprawled."},{"id":"manas-2010:p0183:b002:l046","ordinal":8028,"en":"As though mixing ground grain,"},{"id":"manas-2010:p0183:b002:l047","ordinal":8029,"en":"May God never show you such a sight,"},{"id":"manas-2010:p0183:b002:l048","ordinal":8030,"en":"He began the havoc,"},{"id":"manas-2010:p0184:b002:l001","ordinal":8031,"en":"Their champions numbered two hundred,"},{"id":"manas-2010:p0184:b002:l002","ordinal":8032,"en":"Noble Manas the leopard"},{"id":"manas-2010:p0184:b002:l003","ordinal":8033,"en":"Slaughtered them all."},{"id":"manas-2010:p0184:b002:l004","ordinal":8034,"en":"Among those champions,"},{"id":"manas-2010:p0184:b002:l005","ordinal":8035,"en":"Great Döödür riding a rhinoceros,"},{"id":"manas-2010:p0184:b002:l006","ordinal":8036,"en":"Was in a chaos of dust,"},{"id":"manas-2010:p0184:b002:l007","ordinal":8037,"en":"If you looked at his head and face,"},{"id":"manas-2010:p0184:b002:l008","ordinal":8038,"en":"They were a red bucket of blood,"},{"id":"manas-2010:p0184:b002:l009","ordinal":8039,"en":"As the champions were being slaughtered,"},{"id":"manas-2010:p0184:b002:l010","ordinal":8040,"en":"Having plunged deep into their midst,"},{"id":"manas-2010:p0184:b002:l011","ordinal":8041,"en":"Great Döödür had remained,"},{"id":"manas-2010:p0184:b002:l012","ordinal":8042,"en":"Döödür escaped in flight,"},{"id":"manas-2010:p0184:b002:l013","ordinal":8043,"en":"Wounded in seventy places,"},{"id":"manas-2010:p0184:b002:l014","ordinal":8044,"en":"His head split, covered in blood,"},{"id":"manas-2010:p0184:b002:l015","ordinal":8045,"en":"The whole of his body,"},{"id":"manas-2010:p0184:b002:l016","ordinal":8046,"en":"A red bucket of blood,"},{"id":"manas-2010:p0184:b002:l017","ordinal":8047,"en":"Let us leave this here,"},{"id":"manas-2010:p0184:b002:l018","ordinal":8048,"en":"His father, rich Jakyp,"},{"id":"manas-2010:p0184:b002:l019","ordinal":8049,"en":"Let us begin the news of him."},{"id":"manas-2010:p0184:b002:l020","ordinal":8050,"en":"Jakyp came in anger,"},{"id":"manas-2010:p0184:b002:l021","ordinal":8051,"en":"Speaking to your Manas."},{"id":"manas-2010:p0184:b002:l022","ordinal":8052,"en":"“My son, my child, you have turned out wild,"},{"id":"manas-2010:p0184:b002:l023","ordinal":8053,"en":"Your unruliness and quarrels,"},{"id":"manas-2010:p0184:b002:l024","ordinal":8054,"en":"Have no equal in this world,"},{"id":"manas-2010:p0184:b002:l025","ordinal":8055,"en":"Your voice raises dust,"},{"id":"manas-2010:p0184:b002:l026","ordinal":8056,"en":"Your very movement takes men's lives,"},{"id":"manas-2010:p0184:b002:l027","ordinal":8057,"en":"Plundering the khan's camels,"},{"id":"manas-2010:p0184:b002:l028","ordinal":8058,"en":"Ill-omened, wretched son,"},{"id":"manas-2010:p0184:b002:l029","ordinal":8059,"en":"You have brought havoc and calamity!"},{"id":"manas-2010:p0184:b002:l030","ordinal":8060,"en":"Depriving me of my countless livestock,"},{"id":"manas-2010:p0184:b002:l031","ordinal":8061,"en":"The humiliation I suffered before,"},{"id":"manas-2010:p0184:b002:l032","ordinal":8062,"en":"You have brought it today, my foal,"},{"id":"manas-2010:p0184:b002:l033","ordinal":8063,"en":"An oppression no man should see."},{"id":"manas-2010:p0184:b002:l034","ordinal":8064,"en":"Why did you begin the fight,"},{"id":"manas-2010:p0184:b002:l035","ordinal":8065,"en":"Esenkan's envoys,"},{"id":"manas-2010:p0184:b002:l036","ordinal":8066,"en":"My precious son, may you not prosper,"},{"id":"manas-2010:p0184:b002:l037","ordinal":8067,"en":"Why did you slaughter them?!"},{"id":"manas-2010:p0184:b002:l038","ordinal":8068,"en":"From this you have begun calamity,"},{"id":"manas-2010:p0184:b002:l039","ordinal":8069,"en":"Seething like ants,"},{"id":"manas-2010:p0184:b002:l040","ordinal":8070,"en":"Will the raging Kytay not arrive,"},{"id":"manas-2010:p0184:b002:l041","ordinal":8071,"en":"We were a Kyrgyz people of forty households,"},{"id":"manas-2010:p0184:b002:l042","ordinal":8072,"en":"Will they not destroy and plunder us!"},{"id":"manas-2010:p0184:b002:l043","ordinal":8073,"en":"There is no forest to flee into,"},{"id":"manas-2010:p0184:b002:l044","ordinal":8074,"en":"There is no Ogoy to give us shelter,"},{"id":"manas-2010:p0184:b002:l045","ordinal":8075,"en":"Fire will engulf the wealth I gathered,"},{"id":"manas-2010:p0184:b002:l046","ordinal":8076,"en":"My boundlessly unruly wretch,"},{"id":"manas-2010:p0184:b002:l047","ordinal":8077,"en":"You have brought me to ruin!"},{"id":"manas-2010:p0184:b002:l048","ordinal":8078,"en":"My unruly son, may you not prosper,"},{"id":"manas-2010:p0185:b002:l001","ordinal":8079,"en":"Seven wolves, one sheep:"},{"id":"manas-2010:p0185:b002:l002","ordinal":8080,"en":"If they attack it, will they leave its carcass?"},{"id":"manas-2010:p0185:b002:l003","ordinal":8081,"en":"Seven thousand men, forty souls:"},{"id":"manas-2010:p0185:b002:l004","ordinal":8082,"en":"If they beat them, will they leave their carcasses?"},{"id":"manas-2010:p0185:b002:l005","ordinal":8083,"en":"The infidels like black insects,"},{"id":"manas-2010:p0185:b002:l006","ordinal":8084,"en":"You have now roused their wrath,"},{"id":"manas-2010:p0185:b002:l007","ordinal":8085,"en":"The wrath of warrior Khan Esenkan."},{"id":"manas-2010:p0185:b002:l008","ordinal":8086,"en":"You struck a lord and battered him."},{"id":"manas-2010:p0185:b002:l009","ordinal":8087,"en":"My son Manas, may you never prosper!"},{"id":"manas-2010:p0185:b002:l010","ordinal":8088,"en":"This is how you have stroked us!"},{"id":"manas-2010:p0185:b002:l011","ordinal":8089,"en":"Raging, the Chinese and Manchu peoples"},{"id":"manas-2010:p0185:b002:l012","ordinal":8090,"en":"Will now plunder our court,"},{"id":"manas-2010:p0185:b002:l013","ordinal":8091,"en":"Truly bring ruin upon our heads."},{"id":"manas-2010:p0185:b002:l014","ordinal":8092,"en":"Altay was a land for us too;"},{"id":"manas-2010:p0185:b002:l015","ordinal":8093,"en":"You have truly frozen our steps."},{"id":"manas-2010:p0185:b002:l016","ordinal":8094,"en":"The Kalmyks were a people for us too.”"},{"id":"manas-2010:p0185:b002:l017","ordinal":8095,"en":"Grieving, rich Jakyp"},{"id":"manas-2010:p0185:b002:l018","ordinal":8096,"en":"Stood in wrath."},{"id":"manas-2010:p0185:b002:l019","ordinal":8097,"en":"Akbaltay came with vigor,"},{"id":"manas-2010:p0185:b002:l020","ordinal":8098,"en":"Addressing rich Jakyp:"},{"id":"manas-2010:p0185:b002:l021","ordinal":8099,"en":"“If they die, there is no regret at all."},{"id":"manas-2010:p0185:b002:l022","ordinal":8100,"en":"Let the many wrestlers die!"},{"id":"manas-2010:p0185:b002:l023","ordinal":8101,"en":"While intrepid Manas is here,"},{"id":"manas-2010:p0185:b002:l024","ordinal":8102,"en":"He will bring great strife to the Chinese."},{"id":"manas-2010:p0185:b002:l025","ordinal":8103,"en":"If intrepid Manas lives,"},{"id":"manas-2010:p0185:b002:l026","ordinal":8104,"en":"If God Most High, the Almighty,"},{"id":"manas-2010:p0185:b002:l027","ordinal":8105,"en":"Calls us His servants and stands beside us,"},{"id":"manas-2010:p0185:b002:l028","ordinal":8106,"en":"If a teeming army comes from Beijing,"},{"id":"manas-2010:p0185:b002:l029","ordinal":8107,"en":"If that army comes in great numbers, not few,"},{"id":"manas-2010:p0185:b002:l030","ordinal":8108,"en":"Do not grieve, rich Jakyp."},{"id":"manas-2010:p0185:b002:l031","ordinal":8109,"en":"We shall try our strength in combat;"},{"id":"manas-2010:p0185:b002:l032","ordinal":8110,"en":"When death comes, we shall die."},{"id":"manas-2010:p0185:b002:l033","ordinal":8111,"en":"Who has known this world?"},{"id":"manas-2010:p0185:b002:l034","ordinal":8112,"en":"While Manas the leopard is here,"},{"id":"manas-2010:p0185:b002:l035","ordinal":8113,"en":"He will bring great turmoil to the kakan."},{"id":"manas-2010:p0185:b002:l036","ordinal":8114,"en":"While gray-maned Manas is here,"},{"id":"manas-2010:p0185:b002:l037","ordinal":8115,"en":"He is our companion, he our strength."},{"id":"manas-2010:p0185:b002:l038","ordinal":8116,"en":"The one we keep as our support,"},{"id":"manas-2010:p0185:b002:l039","ordinal":8117,"en":"He is the lion, Manas the leopard."},{"id":"manas-2010:p0185:b002:l040","ordinal":8118,"en":"So that we might live,"},{"id":"manas-2010:p0185:b002:l041","ordinal":8119,"en":"God Most High, the Almighty,"},{"id":"manas-2010:p0185:b002:l042","ordinal":8120,"en":"Has granted us Manas here."},{"id":"manas-2010:p0185:b002:l043","ordinal":8121,"en":"The prize the hero won,"},{"id":"manas-2010:p0185:b002:l044","ordinal":8122,"en":"The spoils he took from the rout,"},{"id":"manas-2010:p0185:b002:l045","ordinal":8123,"en":"The gold coins on forty nar camels,"},{"id":"manas-2010:p0185:b002:l046","ordinal":8124,"en":"Let us load them as booty and go."},{"id":"manas-2010:p0185:b002:l047","ordinal":8125,"en":"What God lays upon our heads,"},{"id":"manas-2010:p0185:b002:l048","ordinal":8126,"en":"Let us face it tomorrow."},{"id":"manas-2010:p0186:b002:l001","ordinal":8127,"en":"The gold coins won today,"},{"id":"manas-2010:p0186:b002:l002","ordinal":8128,"en":"Let us divide them as booty."},{"id":"manas-2010:p0186:b002:l003","ordinal":8129,"en":"Let us show fierce wrath."},{"id":"manas-2010:p0186:b002:l004","ordinal":8130,"en":"The offspring of Muslims,"},{"id":"manas-2010:p0186:b002:l005","ordinal":8131,"en":"The six Sarts leading camels,"},{"id":"manas-2010:p0186:b002:l006","ordinal":8132,"en":"Let us take them as companions too.”"},{"id":"manas-2010:p0186:b002:l007","ordinal":8133,"en":"Akbaltay was wise indeed:"},{"id":"manas-2010:p0186:b002:l008","ordinal":8134,"en":"“From these forty Kyrgyz households,"},{"id":"manas-2010:p0186:b002:l009","ordinal":8135,"en":"Let us prepare a force of men."},{"id":"manas-2010:p0186:b002:l010","ordinal":8136,"en":"Now let us equip all the warriors."},{"id":"manas-2010:p0186:b002:l011","ordinal":8137,"en":"Raising a crescent-crested banner,"},{"id":"manas-2010:p0186:b002:l012","ordinal":8138,"en":"Calling upon the Holy One with cries,"},{"id":"manas-2010:p0186:b002:l013","ordinal":8139,"en":"Let us scatter our san of cattle;"},{"id":"manas-2010:p0186:b002:l014","ordinal":8140,"en":"Let us flee this Altay!"},{"id":"manas-2010:p0186:b002:l015","ordinal":8141,"en":"Let us fight like dogs."},{"id":"manas-2010:p0186:b002:l016","ordinal":8142,"en":"We are among those who died long ago."},{"id":"manas-2010:p0186:b002:l017","ordinal":8143,"en":"The warrior sultan Manas,"},{"id":"manas-2010:p0186:b002:l018","ordinal":8144,"en":"Without trembling, rich Jakyp,"},{"id":"manas-2010:p0186:b002:l019","ordinal":8145,"en":"Let us bind him at our waist as strength."},{"id":"manas-2010:p0186:b002:l020","ordinal":8146,"en":"This san of cattle standing here,"},{"id":"manas-2010:p0186:b002:l021","ordinal":8147,"en":"These wretched herds without fidelity,"},{"id":"manas-2010:p0186:b002:l022","ordinal":8148,"en":"Why should we keep tending them?"},{"id":"manas-2010:p0186:b002:l023","ordinal":8149,"en":"Entering slaughter and fighting,"},{"id":"manas-2010:p0186:b002:l024","ordinal":8150,"en":"Those of us not killed by the Chinese,"},{"id":"manas-2010:p0186:b002:l025","ordinal":8151,"en":"Let us reach the Muslims!"},{"id":"manas-2010:p0186:b002:l026","ordinal":8152,"en":"Until the pliant stalks ripen,"},{"id":"manas-2010:p0186:b002:l027","ordinal":8153,"en":"Until autumn gossamer flies,"},{"id":"manas-2010:p0186:b002:l028","ordinal":8154,"en":"Fighting firmly for six months,"},{"id":"manas-2010:p0186:b002:l029","ordinal":8155,"en":"Let us scatter everything we gathered;"},{"id":"manas-2010:p0186:b002:l030","ordinal":8156,"en":"Let us flee this Altay!"},{"id":"manas-2010:p0186:b002:l031","ordinal":8157,"en":"To the surpassing land of Ala-Too,"},{"id":"manas-2010:p0186:b002:l032","ordinal":8158,"en":"Let us go to the Kyrgyz people.”"},{"id":"manas-2010:p0186:b002:l033","ordinal":8159,"en":"Akbaltay spoke these words,"},{"id":"manas-2010:p0186:b002:l034","ordinal":8160,"en":"Extinguished the fire they had lit,"},{"id":"manas-2010:p0186:b002:l035","ordinal":8161,"en":"The dear people of forty Kyrgyz households,"},{"id":"manas-2010:p0186:b002:l036","ordinal":8162,"en":"He moved them all together."},{"id":"manas-2010:p0186:b004:l001","ordinal":8163,"en":"Akbaltay was wise indeed."},{"id":"manas-2010:p0186:b004:l002","ordinal":8164,"en":"Six years before this,"},{"id":"manas-2010:p0186:b004:l003","ordinal":8165,"en":"That valiant one had made preparations."},{"id":"manas-2010:p0186:b004:l004","ordinal":8166,"en":"Castrating his stallions into geldings,"},{"id":"manas-2010:p0186:b004:l005","ordinal":8167,"en":"Making all the horses ready,"},{"id":"manas-2010:p0186:b004:l006","ordinal":8168,"en":"Castrating his rams into wethers,"},{"id":"manas-2010:p0186:b004:l007","ordinal":8169,"en":"Making all his sheep fat,"},{"id":"manas-2010:p0187:b002:l001","ordinal":8170,"en":"Castrating his bulls into oxen,"},{"id":"manas-2010:p0187:b002:l002","ordinal":8171,"en":"Taking down roof poles without a rattle,"},{"id":"manas-2010:p0187:b002:l003","ordinal":8172,"en":"Fording water without a splash,"},{"id":"manas-2010:p0187:b002:l004","ordinal":8173,"en":"Tying up all the racing steeds,"},{"id":"manas-2010:p0187:b002:l005","ordinal":8174,"en":"The san of cattle they had raised,"},{"id":"manas-2010:p0187:b002:l006","ordinal":8175,"en":"They drove them off in their entirety."},{"id":"manas-2010:p0187:b002:l007","ordinal":8176,"en":"“Make way for Baabedin!” they said,"},{"id":"manas-2010:p0187:b002:l008","ordinal":8177,"en":"And slaughtered a white-gray mare."},{"id":"manas-2010:p0187:b002:l009","ordinal":8178,"en":"Setting their fighting force in good order,"},{"id":"manas-2010:p0187:b002:l010","ordinal":8179,"en":"Their stout men, their lions,"},{"id":"manas-2010:p0187:b002:l011","ordinal":8180,"en":"Their spear-thrusting warriors,"},{"id":"manas-2010:p0187:b002:l012","ordinal":8181,"en":"Their battle-axe wielding heroes,"},{"id":"manas-2010:p0187:b002:l013","ordinal":8182,"en":"He bound them at his waist as strength,"},{"id":"manas-2010:p0187:b002:l014","ordinal":8183,"en":"Your warrior, Manas the leopard."},{"id":"manas-2010:p0187:b002:l015","ordinal":8184,"en":"Rich Jakyp at the caravan's front,"},{"id":"manas-2010:p0187:b002:l016","ordinal":8185,"en":"Akbaltay at its rear,"},{"id":"manas-2010:p0187:b002:l017","ordinal":8186,"en":"Leaving all they had gathered,"},{"id":"manas-2010:p0187:b002:l018","ordinal":8187,"en":"Seeking faith alone,"},{"id":"manas-2010:p0187:b002:l019","ordinal":8188,"en":"They scattered the san of cattle."},{"id":"manas-2010:p0187:b002:l020","ordinal":8189,"en":"The Prophet is true, my faith is true;"},{"id":"manas-2010:p0187:b002:l021","ordinal":8190,"en":"Altay remained behind."},{"id":"manas-2010:p0187:b002:l022","ordinal":8191,"en":"The forty households migrated from Altay."},{"id":"manas-2010:p0187:b002:l023","ordinal":8192,"en":"Let us leave them thus;"}]
