[{"id":"semetey-1-2013:p1390:b003:l003","ordinal":183297,"en":"He has words of countless kinds."},{"id":"semetey-1-2013:p1390:b003:l004","ordinal":183298,"en":"If we journey farther,"},{"id":"semetey-1-2013:p1390:b003:l005","ordinal":183299,"en":"I have a place where I can leave"},{"id":"semetey-1-2013:p1390:b003:l006","ordinal":183300,"en":"My dear boys with the baggage train!"},{"id":"semetey-1-2013:p1390:b003:l007","ordinal":183301,"en":"When I count the days of old,"},{"id":"semetey-1-2013:p1390:b003:l008","ordinal":183302,"en":"My insides burn and my liver is aflame;"},{"id":"semetey-1-2013:p1390:b003:l009","ordinal":183303,"en":"What does this Bakai hold within him,"},{"id":"semetey-1-2013:p1390:b003:l010","ordinal":183304,"en":"And what does he not!"},{"id":"semetey-1-2013:p1390:b003:l011","ordinal":183305,"en":"When I tell the tale of my earlier days,"},{"id":"semetey-1-2013:p1390:b003:l012","ordinal":183306,"en":"I seem to remember them."},{"id":"semetey-1-2013:p1390:b003:l013","ordinal":183307,"en":"When this wretched soul counts his companion,"},{"id":"semetey-1-2013:p1390:b003:l014","ordinal":183308,"en":"I wither and wither away!"},{"id":"semetey-1-2013:p1390:b003:l015","ordinal":183309,"en":"When I speak of my former days,"},{"id":"semetey-1-2013:p1390:b003:l016","ordinal":183310,"en":"With my beard white as a swan,"},{"id":"semetey-1-2013:p1390:b003:l017","ordinal":183311,"en":"At the time I leave on a journey,"},{"id":"semetey-1-2013:p1390:b003:l018","ordinal":183312,"en":"I seem to boast!"},{"id":"semetey-1-2013:p1390:b003:l019","ordinal":183313,"en":"There is the land of Beijing to strike,"},{"id":"semetey-1-2013:p1390:b003:l020","ordinal":183314,"en":"And a marvelous people for us to fight!"},{"id":"semetey-1-2013:p1390:b003:l021","ordinal":183315,"en":"If we leave the baggage train for six months,"},{"id":"semetey-1-2013:p1390:b003:l022","ordinal":183316,"en":"There is a place mortals long to see!"},{"id":"semetey-1-2013:p1390:b003:l023","ordinal":183317,"en":"There is a pass made secure,"},{"id":"semetey-1-2013:p1390:b003:l024","ordinal":183318,"en":"There is a place mortals do not see;"},{"id":"semetey-1-2013:p1390:b003:l025","ordinal":183319,"en":"I have a support on whom I can rely."},{"id":"semetey-1-2013:p1390:b003:l026","ordinal":183320,"en":"If we travel onward from here,"},{"id":"semetey-1-2013:p1390:b003:l027","ordinal":183321,"en":"Let me tell you the nature of the land:"},{"id":"semetey-1-2013:p1390:b003:l028","ordinal":183322,"en":"Pass follows pass,"},{"id":"semetey-1-2013:p1390:b003:l029","ordinal":183323,"en":"And low, rolling hills appear!"},{"id":"semetey-1-2013:p1390:b003:l030","ordinal":183324,"en":"Many a rounded mountain appears;"},{"id":"semetey-1-2013:p1390:b003:l031","ordinal":183325,"en":"If we travel along the mountain foot,"},{"id":"semetey-1-2013:p1390:b003:l032","ordinal":183326,"en":"We come to the lands of Kök-Suu and Kushtai."},{"id":"semetey-1-2013:p1390:b003:l033","ordinal":183327,"en":"We shall pass beyond those two;"},{"id":"semetey-1-2013:p1390:b003:l034","ordinal":183328,"en":"The twin ravines of Echki-Ölbös"},{"id":"semetey-1-2013:p1390:b003:l035","ordinal":183329,"en":"Rise with their ridges in view,"},{"id":"semetey-1-2013:p1390:b003:l036","ordinal":183330,"en":"And your mighty uncle Bakai's"},{"id":"semetey-1-2013:p1390:b003:l037","ordinal":183331,"en":"Heart will then be torn!"},{"id":"semetey-1-2013:p1390:b003:l038","ordinal":183332,"en":"When we climb that ridge,"},{"id":"semetey-1-2013:p1390:b003:l039","ordinal":183333,"en":"Its corners appear dim,"},{"id":"semetey-1-2013:p1390:b003:l040","ordinal":183334,"en":"And its peaks rise hazy!"},{"id":"semetey-1-2013:p1390:b004:l001","ordinal":183335,"en":"Bulging beyond the reach of sight,"},{"id":"semetey-1-2013:p1390:b004:l002","ordinal":183336,"en":"The mountain summit appears."},{"id":"semetey-1-2013:p1390:b004:l003","ordinal":183337,"en":"My dear foals,"},{"id":"semetey-1-2013:p1390:b004:l004","ordinal":183338,"en":"My heart is torn here!"},{"id":"semetey-1-2013:p1390:b004:l005","ordinal":183339,"en":"On a jutting mountain spur,"},{"id":"semetey-1-2013:p1390:b004:l006","ordinal":183340,"en":"Upon a hanging promontory,"},{"id":"semetey-1-2013:p1390:b004:l007","ordinal":183341,"en":"Are rugged black ridges—"},{"id":"semetey-1-2013:p1390:b004:l008","ordinal":183342,"en":"Here is a wondrous tale!"},{"id":"semetey-1-2013:p1390:b004:l009","ordinal":183343,"en":"There are Üch-Jyrgalang and Köngüz;"},{"id":"semetey-1-2013:p1390:b004:l010","ordinal":183344,"en":"If you see this place,"},{"id":"semetey-1-2013:p1390:b004:l011","ordinal":183345,"en":"It holds a whole, level world!"},{"id":"semetey-1-2013:p1390:b004:l012","ordinal":183346,"en":"There are wild boars in its forest,"},{"id":"semetey-1-2013:p1390:b004:l013","ordinal":183347,"en":"Red deer at its bends,"},{"id":"semetey-1-2013:p1390:b004:l014","ordinal":183348,"en":"Argali upon its hills,"},{"id":"semetey-1-2013:p1390:b004:l015","ordinal":183349,"en":"Foxes upon its plains,"},{"id":"semetey-1-2013:p1390:b004:l016","ordinal":183350,"en":"Tigers upon its ridges."},{"id":"semetey-1-2013:p1390:b004:l017","ordinal":183351,"en":"Lofty mountains rise jagged;"},{"id":"semetey-1-2013:p1390:b004:l018","ordinal":183352,"en":"Upon those heights dwell"},{"id":"semetey-1-2013:p1390:b004:l019","ordinal":183353,"en":"Wild goats and ibex!"},{"id":"semetey-1-2013:p1390:b004:l020","ordinal":183354,"en":"There are bears upon its slopes,"},{"id":"semetey-1-2013:p1390:b004:l021","ordinal":183355,"en":"And how many wondrous creatures."},{"id":"semetey-1-2013:p1390:b004:l022","ordinal":183356,"en":"There is snow upon its mountains,"},{"id":"semetey-1-2013:p1390:b004:l023","ordinal":183357,"en":"And rooks within its forests;"},{"id":"semetey-1-2013:p1390:b004:l024","ordinal":183358,"en":"Every living creature is there!"},{"id":"semetey-1-2013:p1390:b004:l025","ordinal":183359,"en":"What a wonder it is to behold:"},{"id":"semetey-1-2013:p1390:b004:l026","ordinal":183360,"en":"Its birds hatch in the birches;"},{"id":"semetey-1-2013:p1390:b004:l027","ordinal":183361,"en":"If you do not die, boys, you will see"},{"id":"semetey-1-2013:p1390:b004:l028","ordinal":183362,"en":"How they lash the air in flight."},{"id":"semetey-1-2013:p1390:b004:l029","ordinal":183363,"en":"Its birds hatch in the poplars,"},{"id":"semetey-1-2013:p1390:b004:l030","ordinal":183364,"en":"Driving the air with their wings!"},{"id":"semetey-1-2013:p1390:b004:l031","ordinal":183365,"en":"The breeds of game are scattered there;"},{"id":"semetey-1-2013:p1390:b004:l032","ordinal":183366,"en":"A brave man's heart opens,"},{"id":"semetey-1-2013:p1390:b004:l033","ordinal":183367,"en":"And an eager youth rejoices."},{"id":"semetey-1-2013:p1390:b004:l034","ordinal":183368,"en":"When bright dawn breaks,"},{"id":"semetey-1-2013:p1390:b004:l035","ordinal":183369,"en":"When light falls upon the earth,"},{"id":"semetey-1-2013:p1390:b004:l036","ordinal":183370,"en":"Geese, cranes, and demoiselle cranes"},{"id":"semetey-1-2013:p1390:b004:l037","ordinal":183371,"en":"Cry out loudly enough to split the ears!"},{"id":"semetey-1-2013:p1390:b004:l038","ordinal":183372,"en":"There are swans among its reeds;"},{"id":"semetey-1-2013:p1390:b004:l039","ordinal":183373,"en":"Ripe walnuts fill the ravines,"},{"id":"semetey-1-2013:p1390:b004:l040","ordinal":183374,"en":"And its apples lie in dark heaps;"},{"id":"semetey-1-2013:p1391:b003:l001","ordinal":183375,"en":"It was a land where people could travel."},{"id":"semetey-1-2013:p1391:b003:l002","ordinal":183376,"en":"The tops of its willows bent low;"},{"id":"semetey-1-2013:p1391:b003:l003","ordinal":183377,"en":"The surface of its sands lay finely traced."},{"id":"semetey-1-2013:p1391:b003:l004","ordinal":183378,"en":"Whoever saw it marveled,"},{"id":"semetey-1-2013:p1391:b003:l005","ordinal":183379,"en":"And any brave man rejoiced to see it!"},{"id":"semetey-1-2013:p1391:b003:l006","ordinal":183380,"en":"When you descend there, my boys,"},{"id":"semetey-1-2013:p1391:b003:l007","ordinal":183381,"en":"If you grow weary, your longing is eased:"},{"id":"semetey-1-2013:p1391:b003:l008","ordinal":183382,"en":"There are creatures of countless kinds!"},{"id":"semetey-1-2013:p1391:b003:l009","ordinal":183383,"en":"When a hero descends and enters,"},{"id":"semetey-1-2013:p1391:b003:l010","ordinal":183384,"en":"There lie Mangkan and Kordoi,"},{"id":"semetey-1-2013:p1391:b003:l011","ordinal":183385,"en":"And many choice lands."},{"id":"semetey-1-2013:p1391:b003:l012","ordinal":183386,"en":"Honor the words"},{"id":"semetey-1-2013:p1391:b003:l013","ordinal":183387,"en":"Your able uncle Bakai has spoken!"},{"id":"semetey-1-2013:p1391:b003:l014","ordinal":183388,"en":"While my dear one was alive,"},{"id":"semetey-1-2013:p1391:b003:l015","ordinal":183389,"en":"What did I not see,"},{"id":"semetey-1-2013:p1391:b003:l016","ordinal":183390,"en":"And what did I not learn!"},{"id":"semetey-1-2013:p1391:b003:l017","ordinal":183391,"en":"In wonders, festivities, and many games,"},{"id":"semetey-1-2013:p1391:b003:l018","ordinal":183392,"en":"How often I plunged and reveled!"},{"id":"semetey-1-2013:p1391:b003:l019","ordinal":183393,"en":"While my beloved Manas lived,"},{"id":"semetey-1-2013:p1391:b003:l020","ordinal":183394,"en":"From sunrise to sunset,"},{"id":"semetey-1-2013:p1391:b003:l021","ordinal":183395,"en":"I reconnoitered it all!"},{"id":"semetey-1-2013:p1391:b003:l022","ordinal":183396,"en":"While my noble Manas lived,"},{"id":"semetey-1-2013:p1391:b003:l023","ordinal":183397,"en":"I wore the flanks of my horse lean;"},{"id":"semetey-1-2013:p1391:b003:l024","ordinal":183398,"en":"Through the four corners of the world,"},{"id":"semetey-1-2013:p1391:b003:l025","ordinal":183399,"en":"I roamed and traveled!"},{"id":"semetey-1-2013:p1391:b003:l026","ordinal":183400,"en":"While my able Manas lived,"},{"id":"semetey-1-2013:p1391:b003:l027","ordinal":183401,"en":"Over mountains, rocks, and waters,"},{"id":"semetey-1-2013:p1391:b003:l028","ordinal":183402,"en":"Here am I, Bakai, who crossed them!"},{"id":"semetey-1-2013:p1391:b003:l029","ordinal":183403,"en":"To the end of the earth, to Jelpinish,"},{"id":"semetey-1-2013:p1391:b003:l030","ordinal":183404,"en":"And Beijing in the east—"},{"id":"semetey-1-2013:p1391:b003:l031","ordinal":183405,"en":"Here am I, Bakai, who saw them!"},{"id":"semetey-1-2013:p1391:b003:l032","ordinal":183406,"en":"Before the eyes of your uncle who saw them,"},{"id":"semetey-1-2013:p1391:b003:l033","ordinal":183407,"en":"Before your grandfather who saw so much,"},{"id":"semetey-1-2013:p1391:b003:l034","ordinal":183408,"en":"Was there anywhere beneath the sky"},{"id":"semetey-1-2013:p1391:b003:l035","ordinal":183409,"en":"That, while my able one lived,"},{"id":"semetey-1-2013:p1391:b003:l036","ordinal":183410,"en":"His gray tulpar did not tread?"},{"id":"semetey-1-2013:p1391:b003:l037","ordinal":183411,"en":"Was there any whole people"},{"id":"semetey-1-2013:p1391:b003:l038","ordinal":183412,"en":"Untouched by the point of his blue spear!"},{"id":"semetey-1-2013:p1391:b003:l039","ordinal":183413,"en":"Was there any wild place"},{"id":"semetey-1-2013:p1391:b003:l040","ordinal":183414,"en":"The pale falcon did not strike?"},{"id":"semetey-1-2013:p1391:b004:l001","ordinal":183415,"en":"While my companion Manas lived,"},{"id":"semetey-1-2013:p1391:b004:l002","ordinal":183416,"en":"Was there any whole people"},{"id":"semetey-1-2013:p1391:b004:l003","ordinal":183417,"en":"Untouched by Bakai's hand!"},{"id":"semetey-1-2013:p1391:b004:l004","ordinal":183418,"en":"Through the four corners of the world,"},{"id":"semetey-1-2013:p1391:b004:l005","ordinal":183419,"en":"Was it not Bakai who swept,"},{"id":"semetey-1-2013:p1391:b004:l006","ordinal":183420,"en":"Across the whole universe,"},{"id":"semetey-1-2013:p1391:b004:l007","ordinal":183421,"en":"Roaming far and wide—"},{"id":"semetey-1-2013:p1391:b004:l008","ordinal":183422,"en":"Was it not Bakai who traveled?"},{"id":"semetey-1-2013:p1391:b004:l009","ordinal":183423,"en":"Leaving no mountain, large or small,"},{"id":"semetey-1-2013:p1391:b004:l010","ordinal":183424,"en":"Leaving not half a spring or stream,"},{"id":"semetey-1-2013:p1391:b004:l011","ordinal":183425,"en":"While radiant Manas lived,"},{"id":"semetey-1-2013:p1391:b004:l012","ordinal":183426,"en":"Was it not Bakai who traveled them?"},{"id":"semetey-1-2013:p1391:b004:l013","ordinal":183427,"en":"He saw peoples in many lands,"},{"id":"semetey-1-2013:p1391:b004:l014","ordinal":183428,"en":"And lands in difficult places;"},{"id":"semetey-1-2013:p1391:b004:l015","ordinal":183429,"en":"He commanded the countless host."},{"id":"semetey-1-2013:p1391:b004:l016","ordinal":183430,"en":"This wretched world—"},{"id":"semetey-1-2013:p1391:b004:l017","ordinal":183431,"en":"Your auspicious uncle Bakai"},{"id":"semetey-1-2013:p1391:b004:l018","ordinal":183432,"en":"Surveyed it and left it behind!"},{"id":"semetey-1-2013:p1391:b004:l019","ordinal":183433,"en":"Scattering golden words from his mouth,"},{"id":"semetey-1-2013:p1391:b004:l020","ordinal":183434,"en":"Bakai goes onward;"},{"id":"semetey-1-2013:p1391:b004:l021","ordinal":183435,"en":"Along the familiar road he himself had seen,"},{"id":"semetey-1-2013:p1391:b004:l022","ordinal":183436,"en":"Bakai travels."},{"id":"semetey-1-2013:p1391:b004:l023","ordinal":183437,"en":"A great valley no man sees"},{"id":"semetey-1-2013:p1391:b004:l024","ordinal":183438,"en":"Bakai leaves behind;"},{"id":"semetey-1-2013:p1391:b004:l025","ordinal":183439,"en":"Through rugged mountain necks,"},{"id":"semetey-1-2013:p1391:b004:l026","ordinal":183440,"en":"Bakai leads the way."},{"id":"semetey-1-2013:p1391:b004:l027","ordinal":183441,"en":"All that your noble uncle Bakai"},{"id":"semetey-1-2013:p1391:b004:l028","ordinal":183442,"en":"Has said is true."},{"id":"semetey-1-2013:p1391:b004:l029","ordinal":183443,"en":"When he reaches the open plain,"},{"id":"semetey-1-2013:p1391:b004:l030","ordinal":183444,"en":"Its tortoises are as large as pitchers;"},{"id":"semetey-1-2013:p1391:b004:l031","ordinal":183445,"en":"Your uncle, elder Bakai,"},{"id":"semetey-1-2013:p1391:b004:l032","ordinal":183446,"en":"Mingles with the beasts,"},{"id":"semetey-1-2013:p1391:b004:l033","ordinal":183447,"en":"As though the two were born the same day."},{"id":"semetey-1-2013:p1391:b004:l034","ordinal":183448,"en":"It is a sheath fitted to a sword—"},{"id":"semetey-1-2013:p1391:b004:l035","ordinal":183449,"en":"This accursed, barren world;"},{"id":"semetey-1-2013:p1391:b004:l036","ordinal":183450,"en":"What precious Bakai has said"},{"id":"semetey-1-2013:p1391:b004:l037","ordinal":183451,"en":"Is no lie, but truth."},{"id":"semetey-1-2013:p1391:b004:l038","ordinal":183452,"en":"If told again, it is another tale;"},{"id":"semetey-1-2013:p1391:b004:l039","ordinal":183453,"en":"Can we tell it once again,"},{"id":"semetey-1-2013:p1391:b004:l040","ordinal":183454,"en":"Just as it was before?"},{"id":"semetey-1-2013:p1392:b004:l001","ordinal":183455,"en":"Two rode horseback and two went on foot—"},{"id":"semetey-1-2013:p1392:b004:l002","ordinal":183456,"en":"The journeying adventure"},{"id":"semetey-1-2013:p1392:b004:l003","ordinal":183457,"en":"Of the champion son of the gray wolf,"},{"id":"semetey-1-2013:p1392:b004:l004","ordinal":183458,"en":"Who set his course toward Beijing,"},{"id":"semetey-1-2013:p1392:b004:l005","ordinal":183459,"en":"The valiant man's bold exploit."},{"id":"semetey-1-2013:p1392:b004:l006","ordinal":183460,"en":"Along the road he himself had seen,"},{"id":"semetey-1-2013:p1392:b004:l007","ordinal":183461,"en":"Beside valleys, springs, and streams,"},{"id":"semetey-1-2013:p1392:b004:l008","ordinal":183462,"en":"Leading them on their way came"},{"id":"semetey-1-2013:p1392:b004:l009","ordinal":183463,"en":"Their remarkable uncle Bakai."},{"id":"semetey-1-2013:p1392:b004:l010","ordinal":183464,"en":"Their uncle, elder Bakai,"},{"id":"semetey-1-2013:p1392:b004:l011","ordinal":183465,"en":"Was an exceptionally knowing saint!"},{"id":"semetey-1-2013:p1392:b004:l012","ordinal":183466,"en":"His words were clear while he lived;"},{"id":"semetey-1-2013:p1392:b004:l013","ordinal":183467,"en":"Bakai, a judge of warriors,"},{"id":"semetey-1-2013:p1392:b004:l014","ordinal":183468,"en":"Was clairvoyant in this world."},{"id":"semetey-1-2013:p1392:b004:l015","ordinal":183469,"en":"His speech was open and plain,"},{"id":"semetey-1-2013:p1392:b004:l016","ordinal":183470,"en":"A resourceful saint,"},{"id":"semetey-1-2013:p1392:b004:l017","ordinal":183471,"en":"Your uncle, elder Bakai!"},{"id":"semetey-1-2013:p1392:b004:l018","ordinal":183472,"en":"Crossing lands of many kinds,"},{"id":"semetey-1-2013:p1392:b004:l019","ordinal":183473,"en":"Passing three successive ridges,"},{"id":"semetey-1-2013:p1392:b004:l020","ordinal":183474,"en":"How could your valiant man hold back?"},{"id":"semetey-1-2013:p1392:b004:l021","ordinal":183475,"en":"Ögüz-Ashuu and Tai-Ashuu,"},{"id":"semetey-1-2013:p1392:b004:l022","ordinal":183476,"en":"The six successive Chon-Chapky passes—"},{"id":"semetey-1-2013:p1392:b004:l023","ordinal":183477,"en":"He reached the broad valley."},{"id":"semetey-1-2013:p1392:b004:l024","ordinal":183478,"en":"Kichi-Jyldyz and Chon-Jyldyz—"},{"id":"semetey-1-2013:p1392:b004:l025","ordinal":183479,"en":"He crossed the two Jyldyz lands,"},{"id":"semetey-1-2013:p1392:b004:l026","ordinal":183480,"en":"Into the hollow of Kichi-Jyldyz,"},{"id":"semetey-1-2013:p1392:b004:l027","ordinal":183481,"en":"Along the Kara-Suu,"},{"id":"semetey-1-2013:p1392:b004:l028","ordinal":183482,"en":"To Chatkal with its winding ford,"},{"id":"semetey-1-2013:p1392:b004:l029","ordinal":183483,"en":"Where the former host had gathered"},{"id":"semetey-1-2013:p1392:b004:l030","ordinal":183484,"en":"And marched in a winding column."},{"id":"semetey-1-2013:p1392:b004:l031","ordinal":183485,"en":"On the qibla side stood Boz-Döbö,"},{"id":"semetey-1-2013:p1392:b004:l032","ordinal":183486,"en":"Where wretched Manas and his forty companions,"},{"id":"semetey-1-2013:p1392:b004:l033","ordinal":183487,"en":"Reveling wildly and raising dust,"},{"id":"semetey-1-2013:p1392:b004:l034","ordinal":183488,"en":"Used to play ordo."},{"id":"semetey-1-2013:p1392:b004:l035","ordinal":183489,"en":"Within that ordo ground"},{"id":"semetey-1-2013:p1392:b004:l036","ordinal":183490,"en":"Were the khan's knucklebone and all the rest,"},{"id":"semetey-1-2013:p1392:b005:l001","ordinal":183491,"en":"Everything left behind"},{"id":"semetey-1-2013:p1392:b005:l002","ordinal":183492,"en":"By the bloodthirsty holy prince!"},{"id":"semetey-1-2013:p1392:b005:l003","ordinal":183493,"en":"At the nape of Boz-Döbö,"},{"id":"semetey-1-2013:p1392:b005:l004","ordinal":183494,"en":"At the place called Kejige, he halted;"},{"id":"semetey-1-2013:p1392:b005:l005","ordinal":183495,"en":"In his grief, your uncle"},{"id":"semetey-1-2013:p1392:b005:l006","ordinal":183496,"en":"Lamented the hero sultan."},{"id":"semetey-1-2013:p1392:b005:l007","ordinal":183497,"en":"He began with sorrowful words,"},{"id":"semetey-1-2013:p1392:b005:l008","ordinal":183498,"en":"And began to voice his grief!"},{"id":"semetey-1-2013:p1392:b005:l009","ordinal":183499,"en":"“With my paired sable cap"},{"id":"semetey-1-2013:p1392:b005:l010","ordinal":183500,"en":"Swaying upon my head,"},{"id":"semetey-1-2013:p1392:b005:l011","ordinal":183501,"en":"While we joined Manas in lament and song,"},{"id":"semetey-1-2013:p1392:b005:l012","ordinal":183502,"en":"In the days when I lived in joy,"},{"id":"semetey-1-2013:p1392:b005:l013","ordinal":183503,"en":"Ajybay and I were the strongest"},{"id":"semetey-1-2013:p1392:b005:l014","ordinal":183504,"en":"Of the forty companions, and we were khans."},{"id":"semetey-1-2013:p1392:b005:l015","ordinal":183505,"en":"While noble Manas lived,"},{"id":"semetey-1-2013:p1392:b005:l016","ordinal":183506,"en":"Even when only we two remained,"},{"id":"semetey-1-2013:p1392:b005:l017","ordinal":183507,"en":"We were men like prophets!"},{"id":"semetey-1-2013:p1392:b005:l018","ordinal":183508,"en":"Now my camp has shifted and the night has passed;"},{"id":"semetey-1-2013:p1392:b005:l019","ordinal":183509,"en":"Alas, while Manas lived,"},{"id":"semetey-1-2013:p1392:b005:l020","ordinal":183510,"en":"Those joyful days passed too."},{"id":"semetey-1-2013:p1392:b005:l021","ordinal":183511,"en":"The land remains, but he is gone;"},{"id":"semetey-1-2013:p1392:b005:l022","ordinal":183512,"en":"When I reflect, such days have passed."},{"id":"semetey-1-2013:p1392:b005:l023","ordinal":183513,"en":"Leaving Khan Bakai to lament,"},{"id":"semetey-1-2013:p1392:b005:l024","ordinal":183514,"en":"This cruel world has tormented me!”"},{"id":"semetey-1-2013:p1392:b005:l025","ordinal":183515,"en":"Their uncle, elder Bakai,"},{"id":"semetey-1-2013:p1392:b005:l026","ordinal":183516,"en":"His golden-cheeked battle-axe"},{"id":"semetey-1-2013:p1392:b005:l027","ordinal":183517,"en":"Braced against his side, groaning,"},{"id":"semetey-1-2013:p1392:b005:l028","ordinal":183518,"en":"Mighty Bakai in his ordo"},{"id":"semetey-1-2013:p1392:b005:l029","ordinal":183519,"en":"Slumped down with a groan!"},{"id":"semetey-1-2013:p1392:b005:l030","ordinal":183520,"en":"His former grief flared anew;"},{"id":"semetey-1-2013:p1392:b005:l031","ordinal":183521,"en":"The breast of your mighty uncle Bakai"},{"id":"semetey-1-2013:p1392:b005:l032","ordinal":183522,"en":"Rattled and heaved,"},{"id":"semetey-1-2013:p1392:b005:l033","ordinal":183523,"en":"His beard trembling strand by strand;"},{"id":"semetey-1-2013:p1392:b005:l034","ordinal":183524,"en":"Tears flowing from both eyes"},{"id":"semetey-1-2013:p1392:b005:l035","ordinal":183525,"en":"Quivered down over his chest!"},{"id":"semetey-1-2013:p1392:b005:l036","ordinal":183526,"en":"On this side lay the Kara-Suu,"},{"id":"semetey-1-2013:p1393:b003:l001","ordinal":183527,"en":"With their ears pricked upright,"},{"id":"semetey-1-2013:p1393:b003:l002","ordinal":183528,"en":"It was a land where wolves roamed;"},{"id":"semetey-1-2013:p1393:b003:l003","ordinal":183529,"en":"With their tails trailing behind,"},{"id":"semetey-1-2013:p1393:b003:l004","ordinal":183530,"en":"It was a land where foxes roamed."},{"id":"semetey-1-2013:p1393:b003:l005","ordinal":183531,"en":"Crawling over the sands by day,"},{"id":"semetey-1-2013:p1393:b003:l006","ordinal":183532,"en":"Its young were as large as yearling colts,"},{"id":"semetey-1-2013:p1393:b003:l007","ordinal":183533,"en":"Galloping proudly like young horses,"},{"id":"semetey-1-2013:p1393:b003:l008","ordinal":183534,"en":"They played over the open plain!"},{"id":"semetey-1-2013:p1393:b003:l009","ordinal":183535,"en":"Its wonders dazzled the eye;"},{"id":"semetey-1-2013:p1393:b003:l010","ordinal":183536,"en":"No living man could tire of them."},{"id":"semetey-1-2013:p1393:b003:l011","ordinal":183537,"en":"Its cold allowed no mosquitoes!"},{"id":"semetey-1-2013:p1393:b003:l012","ordinal":183538,"en":"In the fiercest forty days of winter,"},{"id":"semetey-1-2013:p1393:b003:l013","ordinal":183539,"en":"Kites, falcons, and saker falcons—"},{"id":"semetey-1-2013:p1393:b003:l014","ordinal":183540,"en":"These birds made the place their home."},{"id":"semetey-1-2013:p1393:b003:l015","ordinal":183541,"en":"It curved through hillock after hillock;"},{"id":"semetey-1-2013:p1393:b003:l016","ordinal":183542,"en":"Deer poured out from the hummocks."},{"id":"semetey-1-2013:p1393:b003:l017","ordinal":183543,"en":"The trail descended toward the saddlebags,"},{"id":"semetey-1-2013:p1393:b003:l018","ordinal":183544,"en":"Where the grass on the hummocks grew sparse."},{"id":"semetey-1-2013:p1393:b003:l019","ordinal":183545,"en":"Wild asses snorted on the level ground;"},{"id":"semetey-1-2013:p1393:b003:l020","ordinal":183546,"en":"What a wondrous place this Jyldyz was—"},{"id":"semetey-1-2013:p1393:b003:l021","ordinal":183547,"en":"Snakes hissed in the gullies!"},{"id":"semetey-1-2013:p1393:b003:l022","ordinal":183548,"en":"Beyond Kichi-Jyldyz,"},{"id":"semetey-1-2013:p1393:b003:l023","ordinal":183549,"en":"On this side of Chon-Jyldyz,"},{"id":"semetey-1-2013:p1393:b003:l024","ordinal":183550,"en":"The projecting headland of Kara-Kyr—"},{"id":"semetey-1-2013:p1393:b003:l025","ordinal":183551,"en":"The land Khan Almam made his home,"},{"id":"semetey-1-2013:p1393:b003:l026","ordinal":183552,"en":"This is the sacred place!"}]
