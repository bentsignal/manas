[{"id":"semetey-1-2013:p0923:b005:l036","ordinal":146689,"en":"Upon the unbelievers like black worms"},{"id":"semetey-1-2013:p0923:b005:l037","ordinal":146690,"en":"I shall bring devastation."},{"id":"semetey-1-2013:p0923:b005:l038","ordinal":146691,"en":"From that dog, not for one father alone,"},{"id":"semetey-1-2013:p0923:b005:l039","ordinal":146692,"en":"But for forty fathers I shall take revenge."},{"id":"semetey-1-2013:p0924:b003:l001","ordinal":146693,"en":"Uncle Bakai, Ormonbek,"},{"id":"semetey-1-2013:p0924:b003:l002","ordinal":146694,"en":"Kulchoro and Kanchoro,"},{"id":"semetey-1-2013:p0924:b003:l003","ordinal":146695,"en":"You four go and return."},{"id":"semetey-1-2013:p0924:b003:l004","ordinal":146696,"en":"Shygai's son Chynkozho,"},{"id":"semetey-1-2013:p0924:b003:l005","ordinal":146697,"en":"A khoja capable in all he does,"},{"id":"semetey-1-2013:p0924:b003:l006","ordinal":146698,"en":"Who dwells at Kebez-Too,"},{"id":"semetey-1-2013:p0924:b003:l007","ordinal":146699,"en":"A hero said to be stately,"},{"id":"semetey-1-2013:p0924:b003:l008","ordinal":146700,"en":"Who wears a black flower-patterned coat,"},{"id":"semetey-1-2013:p0924:b003:l009","ordinal":146701,"en":"Who rides a black racehorse,"},{"id":"semetey-1-2013:p0924:b003:l010","ordinal":146702,"en":"Thick-armed and stone-hearted,"},{"id":"semetey-1-2013:p0924:b003:l011","ordinal":146703,"en":"Was one of the discerning heroes."},{"id":"semetey-1-2013:p0924:b003:l012","ordinal":146704,"en":"That bold man, built like an elephant,"},{"id":"semetey-1-2013:p0924:b003:l013","ordinal":146705,"en":"Is the support to fasten at our waist."},{"id":"semetey-1-2013:p0924:b003:l014","ordinal":146706,"en":"Against the khagan's Beijing,"},{"id":"semetey-1-2013:p0924:b003:l015","ordinal":146707,"en":"If we should come to blows,"},{"id":"semetey-1-2013:p0924:b003:l016","ordinal":146708,"en":"He is the hero who will show courage."},{"id":"semetey-1-2013:p0924:b003:l017","ordinal":146709,"en":"If we firmly level our spears,"},{"id":"semetey-1-2013:p0924:b003:l018","ordinal":146710,"en":"Fire guns and draw bows,"},{"id":"semetey-1-2013:p0924:b003:l019","ordinal":146711,"en":"And fight with crashing blows,"},{"id":"semetey-1-2013:p0924:b003:l020","ordinal":146712,"en":"He will stand beneath the standard,"},{"id":"semetey-1-2013:p0924:b003:l021","ordinal":146713,"en":"And slaughter the Chinese."},{"id":"semetey-1-2013:p0924:b003:l022","ordinal":146714,"en":"If an evil day comes and blood flows,"},{"id":"semetey-1-2013:p0924:b003:l023","ordinal":146715,"en":"If a day of terrible hardship dawns,"},{"id":"semetey-1-2013:p0924:b003:l024","ordinal":146716,"en":"He will stand without flinching,"},{"id":"semetey-1-2013:p0924:b003:l025","ordinal":146717,"en":"And show courage to the full."},{"id":"semetey-1-2013:p0924:b003:l026","ordinal":146718,"en":"He is the support to fasten at our waist,"},{"id":"semetey-1-2013:p0924:b003:l027","ordinal":146719,"en":"The hero who will go to Beijing."},{"id":"semetey-1-2013:p0924:b003:l028","ordinal":146720,"en":"Uncle Bakai, you four,"},{"id":"semetey-1-2013:p0924:b003:l029","ordinal":146721,"en":"Bring that man here!"},{"id":"semetey-1-2013:p0924:b003:l030","ordinal":146722,"en":"Chynkozho and I"},{"id":"semetey-1-2013:p0924:b003:l031","ordinal":146723,"en":"Were strongmen joined in strength,"},{"id":"semetey-1-2013:p0924:b003:l032","ordinal":146724,"en":"Heroes joined at heart."},{"id":"semetey-1-2013:p0924:b003:l033","ordinal":146725,"en":"If I follow the old accounts,"},{"id":"semetey-1-2013:p0924:b003:l034","ordinal":146726,"en":"If I ask those who know,"},{"id":"semetey-1-2013:p0924:b003:l035","ordinal":146727,"en":"When the dark gun crashes,"},{"id":"semetey-1-2013:p0924:b003:l036","ordinal":146728,"en":"He is a hero who does not flee."},{"id":"semetey-1-2013:p0924:b003:l037","ordinal":146729,"en":"When the fierce gun cracks,"},{"id":"semetey-1-2013:p0924:b003:l038","ordinal":146730,"en":"He is one who feels no fear."},{"id":"semetey-1-2013:p0924:b003:l039","ordinal":146731,"en":"Before, when my bloodthirsty father lived,"},{"id":"semetey-1-2013:p0924:b004:l001","ordinal":146732,"en":"Lest the people fall into disorder,"},{"id":"semetey-1-2013:p0924:b004:l002","ordinal":146733,"en":"Dwelling at broad Sary-Kol,"},{"id":"semetey-1-2013:p0924:b004:l003","ordinal":146734,"en":"Among the people known as Oigut,"},{"id":"semetey-1-2013:p0924:b004:l004","ordinal":146735,"en":"Akbaltai, khan of the Oigut,"},{"id":"semetey-1-2013:p0924:b004:l005","ordinal":146736,"en":"Had asked for hostages and received them."},{"id":"semetey-1-2013:p0924:b004:l006","ordinal":146737,"en":"Shygai and Chynkozho,"},{"id":"semetey-1-2013:p0924:b004:l007","ordinal":146738,"en":"By the command of God,"},{"id":"semetey-1-2013:p0924:b004:l008","ordinal":146739,"en":"Had remained at Kebez-Too."},{"id":"semetey-1-2013:p0924:b004:l009","ordinal":146740,"en":"That was the reason these kinsmen"},{"id":"semetey-1-2013:p0924:b004:l010","ordinal":146741,"en":"Had become separated."},{"id":"semetey-1-2013:p0924:b004:l011","ordinal":146742,"en":"Thus Chynkozho,"},{"id":"semetey-1-2013:p0924:b004:l012","ordinal":146743,"en":"After his father Shygai died,"},{"id":"semetey-1-2013:p0924:b004:l013","ordinal":146744,"en":"Had grown distant."},{"id":"semetey-1-2013:p0924:b004:l014","ordinal":146745,"en":"When from Temir Khan's city"},{"id":"semetey-1-2013:p0924:b004:l015","ordinal":146746,"en":"I wandered here and settled,"},{"id":"semetey-1-2013:p0924:b004:l016","ordinal":146747,"en":"He made no joyful feast,"},{"id":"semetey-1-2013:p0924:b004:l017","ordinal":146748,"en":"Slaughtered no welcoming sheep."},{"id":"semetey-1-2013:p0924:b004:l018","ordinal":146749,"en":"‘My orphan younger kinsman has come’—"},{"id":"semetey-1-2013:p0924:b004:l019","ordinal":146750,"en":"He did not even show his face,"},{"id":"semetey-1-2013:p0924:b004:l020","ordinal":146751,"en":"Nor offer food to gladden me."},{"id":"semetey-1-2013:p0924:b004:l021","ordinal":146752,"en":"Before, when my gray-maned father died,"},{"id":"semetey-1-2013:p0924:b004:l022","ordinal":146753,"en":"When the people gathered and buried him,"},{"id":"semetey-1-2013:p0924:b004:l023","ordinal":146754,"en":"Not one came to offer prayers."},{"id":"semetey-1-2013:p0924:b004:l024","ordinal":146755,"en":"My grieving mother Kanykei—"},{"id":"semetey-1-2013:p0924:b004:l025","ordinal":146756,"en":"Not one came to see her."},{"id":"semetey-1-2013:p0924:b004:l026","ordinal":146757,"en":"On slopes across from one another,"},{"id":"semetey-1-2013:p0924:b004:l027","ordinal":146758,"en":"Let him ponder these words of mine:"},{"id":"semetey-1-2013:p0924:b004:l028","ordinal":146759,"en":"We share one root and one nest."},{"id":"semetey-1-2013:p0924:b004:l029","ordinal":146760,"en":"If Chynkozho joins us in unity,"},{"id":"semetey-1-2013:p0924:b004:l030","ordinal":146761,"en":"If he settles along Ken-Kol,"},{"id":"semetey-1-2013:p0924:b004:l031","ordinal":146762,"en":"And I settle along broad Talas,"},{"id":"semetey-1-2013:p0924:b004:l032","ordinal":146763,"en":"If we bring our wisdom together,"},{"id":"semetey-1-2013:p0924:b004:l033","ordinal":146764,"en":"If we stir six clusters of stars in heaven,"},{"id":"semetey-1-2013:p0924:b004:l035","ordinal":146765,"en":"If we become friends unto the next world,"},{"id":"semetey-1-2013:p0924:b004:l036","ordinal":146766,"en":"If the two of us become one,"},{"id":"semetey-1-2013:p0924:b004:l037","ordinal":146767,"en":"Could any fingered man prevail against us?"},{"id":"semetey-1-2013:p0924:b004:l038","ordinal":146768,"en":"Could any nail-bearing person attack us?"},{"id":"semetey-1-2013:p0925:b003:l001","ordinal":146769,"en":"Could Khan Kongurbai attack us?","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0925:b003:l002","ordinal":146770,"en":"If we are kin to the khoja,"},{"id":"semetey-1-2013:p0925:b003:l003","ordinal":146771,"en":"Present six swift horses,"},{"id":"semetey-1-2013:p0925:b003:l004","ordinal":146772,"en":"And promptly offer wealth without stint."},{"id":"semetey-1-2013:p0925:b003:l005","ordinal":146773,"en":"Bring Chynkozho here,"},{"id":"semetey-1-2013:p0925:b003:l006","ordinal":146774,"en":"To the orphan, his father's only son."},{"id":"semetey-1-2013:p0925:b003:l007","ordinal":146775,"en":"Uncle Bakai, you leopard,"},{"id":"semetey-1-2013:p0925:b003:l008","ordinal":146776,"en":"Make him my companion!"},{"id":"semetey-1-2013:p0925:b003:l009","ordinal":146777,"en":"Our fathers are equal kin;"},{"id":"semetey-1-2013:p0925:b003:l010","ordinal":146778,"en":"We are brothers of a single root."},{"id":"semetey-1-2013:p0925:b003:l012","ordinal":146779,"en":"Have him move his camp here.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0925:b003:l013","ordinal":146780,"en":"If he does not agree to my words,"},{"id":"semetey-1-2013:p0925:b003:l014","ordinal":146781,"en":"‘The tribute owed to my father,"},{"id":"semetey-1-2013:p0925:b003:l015","ordinal":146782,"en":"Counting the years exactly,"},{"id":"semetey-1-2013:p0925:b003:l016","ordinal":146783,"en":"Pay it now,’ tell him."},{"id":"semetey-1-2013:p0925:b003:l017","ordinal":146784,"en":"Bring this stern demand upon him!"},{"id":"semetey-1-2013:p0925:b003:l018","ordinal":146785,"en":"If he will not heed you,"},{"id":"semetey-1-2013:p0925:b003:l019","ordinal":146786,"en":"Tell Chubak's son Kanchoro"},{"id":"semetey-1-2013:p0925:b003:l020","ordinal":146787,"en":"To raise an uproar."},{"id":"semetey-1-2013:p0925:b003:l021","ordinal":146788,"en":"Tell Almambet's Kulchoro"},{"id":"semetey-1-2013:p0925:b003:l022","ordinal":146789,"en":"To raid and take his horses."},{"id":"semetey-1-2013:p0925:b003:l023","ordinal":146790,"en":"If he will not accept your plan,"},{"id":"semetey-1-2013:p0925:b003:l024","ordinal":146791,"en":"If he will not heed your words,"},{"id":"semetey-1-2013:p0925:b003:l025","ordinal":146792,"en":"Tell him, ‘May your sworn oath strike you down!"},{"id":"semetey-1-2013:p0925:b003:l026","ordinal":146793,"en":"Without appearing before my eyes,"},{"id":"semetey-1-2013:p0925:b003:l027","ordinal":146794,"en":"Let him become my enemy!’”"},{"id":"semetey-1-2013:p0925:b003:l028","ordinal":146795,"en":"Earnestly pleading for this,"},{"id":"semetey-1-2013:p0925:b003:l029","ordinal":146796,"en":"He gave six swift horses,"},{"id":"semetey-1-2013:p0925:b003:l030","ordinal":146797,"en":"And a letter the size of a palm."},{"id":"semetey-1-2013:p0925:b003:l031","ordinal":146798,"en":"His heart burning, he turned about,"},{"id":"semetey-1-2013:p0925:b003:l032","ordinal":146799,"en":"And sent the four impartial men."},{"id":"semetey-1-2013:p0925:b003:l033","ordinal":146800,"en":"The young sultan, the gray-maned hero,"},{"id":"semetey-1-2013:p0925:b003:l034","ordinal":146801,"en":"Displayed his princely rank."},{"id":"semetey-1-2013:p0925:b003:l035","ordinal":146802,"en":"Upon Abyke's Aktelki"},{"id":"semetey-1-2013:p0925:b003:l036","ordinal":146803,"en":"He mounted Kulchoro;"},{"id":"semetey-1-2013:p0925:b003:l037","ordinal":146804,"en":"Upon Khan Kobosh's Kokteke"},{"id":"semetey-1-2013:p0925:b003:l038","ordinal":146805,"en":"He mounted Kanchoro."},{"id":"semetey-1-2013:p0925:b003:l039","ordinal":146806,"en":"Those four impartial men"},{"id":"semetey-1-2013:p0925:b004:l001","ordinal":146807,"en":"He sent to Chynkozho."},{"id":"semetey-1-2013:p0925:b004:l002","ordinal":146808,"en":"When set at the front, a bringer of good fortune,"},{"id":"semetey-1-2013:p0925:b004:l004","ordinal":146809,"en":"Traveling along the mountain tops,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0925:b004:l006","ordinal":146810,"en":"Crossing hill after hill,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0925:b004:l007","ordinal":146811,"en":"Crossing mottled, ridged passes,"},{"id":"semetey-1-2013:p0925:b004:l008","ordinal":146812,"en":"The hero Bakai, the leopard,"},{"id":"semetey-1-2013:p0925:b004:l009","ordinal":146813,"en":"Along the ridge stretching across,"},{"id":"semetey-1-2013:p0925:b004:l010","ordinal":146814,"en":"Along the clear spring waters,"},{"id":"semetey-1-2013:p0925:b004:l011","ordinal":146815,"en":"The hero Bakai led the way."},{"id":"semetey-1-2013:p0925:b004:l012","ordinal":146816,"en":"They crossed Maseyil,"},{"id":"semetey-1-2013:p0925:b004:l013","ordinal":146817,"en":"Traveled through broad Kashgar,"},{"id":"semetey-1-2013:p0925:b004:l014","ordinal":146818,"en":"Skirted great Khotan,"},{"id":"semetey-1-2013:p0925:b004:l015","ordinal":146819,"en":"Wearing out their peerless steeds,"},{"id":"semetey-1-2013:p0925:b004:l016","ordinal":146820,"en":"And reached Kebez-Too."},{"id":"semetey-1-2013:p0925:b004:l017","ordinal":146821,"en":"Your caravan guide, old Bakai,"},{"id":"semetey-1-2013:p0925:b004:l018","ordinal":146822,"en":"Your saint with sweet words,"},{"id":"semetey-1-2013:p0925:b004:l019","ordinal":146823,"en":"To the hero Kozho's royal court,"},{"id":"semetey-1-2013:p0925:b004:l020","ordinal":146824,"en":"To his fortified stronghold—"},{"id":"semetey-1-2013:p0925:b004:l021","ordinal":146825,"en":"Zhangyryk's Zhar-Kyya,"},{"id":"semetey-1-2013:p0925:b004:l022","ordinal":146826,"en":"Above it was Kebez-Too."},{"id":"semetey-1-2013:p0925:b004:l024","ordinal":146827,"en":"Shygai's son Chynkozho,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0925:b004:l025","ordinal":146828,"en":"Who dwelt at Kebez-Too,"},{"id":"semetey-1-2013:p0925:b004:l026","ordinal":146829,"en":"Was said to be a stately hero."},{"id":"semetey-1-2013:p0925:b004:l027","ordinal":146830,"en":"When Chynkozho grew wrathful,"},{"id":"semetey-1-2013:p0925:b004:l028","ordinal":146831,"en":"Wings sprang out beneath him."},{"id":"semetey-1-2013:p0925:b004:l029","ordinal":146832,"en":"Not China alone, but the whole world"},{"id":"semetey-1-2013:p0925:b004:l030","ordinal":146833,"en":"He was wont to shatter to powder."},{"id":"semetey-1-2013:p0925:b004:l031","ordinal":146834,"en":"Chynkozho crackled"},{"id":"semetey-1-2013:p0925:b004:l032","ordinal":146835,"en":"Like red-hot, tempered iron."},{"id":"semetey-1-2013:p0925:b004:l033","ordinal":146836,"en":"He was no enemy to grapple with lightly,"},{"id":"semetey-1-2013:p0925:b004:l034","ordinal":146837,"en":"His bulk half a mountain."},{"id":"semetey-1-2013:p0925:b004:l035","ordinal":146838,"en":"His eyes were like the beds of lakes."},{"id":"semetey-1-2013:p0925:b004:l037","ordinal":146839,"en":"As though he would suck the life from anyone he saw.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0925:b004:l038","ordinal":146840,"en":"The strongman he had set on watch"},{"id":"semetey-1-2013:p0925:b004:l039","ordinal":146841,"en":"Ran to take their horses,"},{"id":"semetey-1-2013:p0926:b003:l001","ordinal":146842,"en":"One man flew like an arrow"},{"id":"semetey-1-2013:p0926:b003:l002","ordinal":146843,"en":"And pulled the door open."},{"id":"semetey-1-2013:p0926:b003:l003","ordinal":146844,"en":"Aged Lord Bakai,"},{"id":"semetey-1-2013:p0926:b003:l004","ordinal":146845,"en":"The saint who had seen so much,"},{"id":"semetey-1-2013:p0926:b003:l005","ordinal":146846,"en":"Led the way inside,"},{"id":"semetey-1-2013:p0926:b003:l006","ordinal":146847,"en":"And to tigerlike Kozho"},{"id":"semetey-1-2013:p0926:b003:l007","ordinal":146848,"en":"Offered his greeting."},{"id":"semetey-1-2013:p0926:b003:l008","ordinal":146849,"en":"Your uncle Bakai, bringer of good fortune,"},{"id":"semetey-1-2013:p0926:b003:l009","ordinal":146850,"en":"Spoke these words:"},{"id":"semetey-1-2013:p0926:b003:l010","ordinal":146851,"en":"“We were neighboring hills upon one slope."},{"id":"semetey-1-2013:p0926:b003:l011","ordinal":146852,"en":"Are you well, Kozho, my foal,"},{"id":"semetey-1-2013:p0926:b003:l012","ordinal":146853,"en":"Of one woven thread, of one nest with me?"},{"id":"semetey-1-2013:p0926:b003:l013","ordinal":146854,"en":"Offering six swift horses,"},{"id":"semetey-1-2013:p0926:b003:l014","ordinal":146855,"en":"Offering a letter the size of a palm,"},{"id":"semetey-1-2013:p0926:b003:l015","ordinal":146856,"en":"Offering my applelike golden head before you,"},{"id":"semetey-1-2013:p0926:b003:l016","ordinal":146857,"en":"Traveling without sparing the horses,"},{"id":"semetey-1-2013:p0926:b003:l017","ordinal":146858,"en":"Traveling far without stopping on the way,"},{"id":"semetey-1-2013:p0926:b003:l018","ordinal":146859,"en":"I have come before you, as you see."},{"id":"semetey-1-2013:p0926:b003:l019","ordinal":146860,"en":"‘This is my khan-uncle Bakai,’ say,"},{"id":"semetey-1-2013:p0926:b003:l020","ordinal":146861,"en":"And take heed of me, Bakai!"},{"id":"semetey-1-2013:p0926:b003:l021","ordinal":146862,"en":"My sorrow has long been swelling:"},{"id":"semetey-1-2013:p0926:b003:l022","ordinal":146863,"en":"You moved to Kebez-Too, to the Oigut,"},{"id":"semetey-1-2013:p0926:b003:l023","ordinal":146864,"en":"And went away as a hostage."},{"id":"semetey-1-2013:p0926:b003:l024","ordinal":146865,"en":"When Lord Sultan Manas,"},{"id":"semetey-1-2013:p0926:b003:l025","ordinal":146866,"en":"His thin mustache smoothed,"},{"id":"semetey-1-2013:p0926:b003:l026","ordinal":146867,"en":"Departed toward Judgment Day,"},{"id":"semetey-1-2013:p0926:b003:l027","ordinal":146868,"en":"You did not cast a handful of earth."},{"id":"semetey-1-2013:p0926:b003:l028","ordinal":146869,"en":"You were kin to us at your roots,"},{"id":"semetey-1-2013:p0926:b003:l029","ordinal":146870,"en":"Yet you rendered no true service."},{"id":"semetey-1-2013:p0926:b003:l030","ordinal":146871,"en":"When your leopard died,"},{"id":"semetey-1-2013:p0926:b003:l031","ordinal":146872,"en":"When the people gathered and buried him,"},{"id":"semetey-1-2013:p0926:b003:l032","ordinal":146873,"en":"You did not stand crying, ‘My uncle!’"},{"id":"semetey-1-2013:p0926:b003:l033","ordinal":146874,"en":"My champion Kozho, hear my words."},{"id":"semetey-1-2013:p0926:b003:l034","ordinal":146875,"en":"Our path was touched by Khizr;"},{"id":"semetey-1-2013:p0926:b003:l035","ordinal":146876,"en":"Our army numbered forty-two myriads,"},{"id":"semetey-1-2013:p0926:b003:l036","ordinal":146877,"en":"With twelve pairs of khans."},{"id":"semetey-1-2013:p0926:b003:l037","ordinal":146878,"en":"The guide to that great army"},{"id":"semetey-1-2013:p0926:b003:l038","ordinal":146879,"en":"Was the leopard Almam."},{"id":"semetey-1-2013:p0926:b003:l039","ordinal":146880,"en":"When we scattered the unbelievers' livestock,"},{"id":"semetey-1-2013:p0926:b004:l002","ordinal":146881,"en":"Into dark and brooding Great Beijing,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0926:b004:l003","ordinal":146882,"en":"When we went straight in with level spears,"},{"id":"semetey-1-2013:p0926:b004:l004","ordinal":146883,"en":"Against the grim-looking dark Chinese"},{"id":"semetey-1-2013:p0926:b004:l005","ordinal":146884,"en":"When we firmly waged a holy war,"},{"id":"semetey-1-2013:p0926:b004:l006","ordinal":146885,"en":"Against the unbelievers of the dark faith,"},{"id":"semetey-1-2013:p0926:b004:l007","ordinal":146886,"en":"When the hero Khan Kongurbai's"},{"id":"semetey-1-2013:p0926:b004:l008","ordinal":146887,"en":"Khanate we wrested away,"},{"id":"semetey-1-2013:p0926:b004:l009","ordinal":146888,"en":"Noble brides and beautiful girls"},{"id":"semetey-1-2013:p0926:b004:l010","ordinal":146889,"en":"We left unable to gather all as spoils;"},{"id":"semetey-1-2013:p0926:b004:l011","ordinal":146890,"en":"Gold and silver"},{"id":"semetey-1-2013:p0926:b004:l012","ordinal":146891,"en":"We left unable to load it all."},{"id":"semetey-1-2013:p0926:b004:l013","ordinal":146892,"en":"Against the teeming Chinese,"},{"id":"semetey-1-2013:p0926:b004:l014","ordinal":146893,"en":"When we charged and brought slaughter,"},{"id":"semetey-1-2013:p0926:b004:l015","ordinal":146894,"en":"You vanished without showing your face!"},{"id":"semetey-1-2013:p0926:b004:l016","ordinal":146895,"en":"On the journey back,"},{"id":"semetey-1-2013:p0926:b004:l017","ordinal":146896,"en":"The khans Muzburchak and Kokcho died;"},{"id":"semetey-1-2013:p0926:b004:l018","ordinal":146897,"en":"All whom we encountered died."},{"id":"semetey-1-2013:p0926:b004:l019","ordinal":146898,"en":"We lost Almambet,"},{"id":"semetey-1-2013:p0926:b004:l020","ordinal":146899,"en":"And had Chubak offered as a gift."},{"id":"semetey-1-2013:p0926:b004:l021","ordinal":146900,"en":"All our honored lions"},{"id":"semetey-1-2013:p0926:b004:l022","ordinal":146901,"en":"We lost to the khagan's realm."},{"id":"semetey-1-2013:p0926:b004:l023","ordinal":146902,"en":"When we returned,"},{"id":"semetey-1-2013:p0926:b004:l024","ordinal":146903,"en":"Between his back and neck,"},{"id":"semetey-1-2013:p0926:b004:l026","ordinal":146904,"en":"The wound of your Magnanimous One—","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0926:b004:l027","ordinal":146905,"en":"When Manas passed from the world,"},{"id":"semetey-1-2013:p0926:b004:l028","ordinal":146906,"en":"Kanykei was left in mourning,"},{"id":"semetey-1-2013:p0926:b004:l029","ordinal":146907,"en":"And Semetey fled away."},{"id":"semetey-1-2013:p0926:b004:l030","ordinal":146908,"en":"His later affairs turned out well;"},{"id":"semetey-1-2013:p0926:b004:l031","ordinal":146909,"en":"He went to Bukhara and grew up."},{"id":"semetey-1-2013:p0926:b004:l032","ordinal":146910,"en":"A lion favored by an unseen protector arose,"},{"id":"semetey-1-2013:p0926:b004:l033","ordinal":146911,"en":"He came and settled in Talas."},{"id":"semetey-1-2013:p0926:b004:l034","ordinal":146912,"en":"The orphan grew to maturity,"},{"id":"semetey-1-2013:p0926:b004:l035","ordinal":146913,"en":"And joined the ranks himself."},{"id":"semetey-1-2013:p0926:b004:l036","ordinal":146914,"en":"When he came and settled in Talas,"},{"id":"semetey-1-2013:p0926:b004:l037","ordinal":146915,"en":"Longing greatly for you,"},{"id":"semetey-1-2013:p0926:b004:l038","ordinal":146916,"en":"That orphan son of Manas"},{"id":"semetey-1-2013:p0926:b004:l039","ordinal":146917,"en":"Said, ‘I would see your face.’"},{"id":"semetey-1-2013:p0927:b003:l001","ordinal":146918,"en":"Look, Chynkozho,"},{"id":"semetey-1-2013:p0927:b003:l002","ordinal":146919,"en":"He is the very image of a prince."},{"id":"semetey-1-2013:p0927:b003:l003","ordinal":146920,"en":"Dear Kozho, heed my words."},{"id":"semetey-1-2013:p0927:b003:l004","ordinal":146921,"en":"Move back to Talas;"},{"id":"semetey-1-2013:p0927:b003:l005","ordinal":146922,"en":"Go and mourn for Manas."},{"id":"semetey-1-2013:p0927:b003:l006","ordinal":146923,"en":"Pasture your livestock upon the steppe."},{"id":"semetey-1-2013:p0927:b003:l007","ordinal":146924,"en":"Go and give support"},{"id":"semetey-1-2013:p0927:b003:l008","ordinal":146925,"en":"To the boy Semetey."},{"id":"semetey-1-2013:p0927:b003:l009","ordinal":146926,"en":"There is the place where you will find prosperity."},{"id":"semetey-1-2013:p0927:b003:l010","ordinal":146927,"en":"Go and settle in Talas."},{"id":"semetey-1-2013:p0927:b003:l011","ordinal":146928,"en":"He is the hero who will welcome you,"},{"id":"semetey-1-2013:p0927:b003:l012","ordinal":146929,"en":"The lion who will ease your anxiety."},{"id":"semetey-1-2013:p0927:b003:l013","ordinal":146930,"en":"He greased his blue steel."},{"id":"semetey-1-2013:p0927:b003:l014","ordinal":146931,"en":"The one who sorely provoked him—"},{"id":"semetey-1-2013:p0927:b003:l015","ordinal":146932,"en":"Khan Kobosh—he slew."},{"id":"semetey-1-2013:p0927:b003:l016","ordinal":146933,"en":"When they stirred his stubborn anger,"},{"id":"semetey-1-2013:p0927:b003:l017","ordinal":146934,"en":"He destroyed his own father."},{"id":"semetey-1-2013:p0927:b003:l018","ordinal":146935,"en":"When they provoked his wrath,"},{"id":"semetey-1-2013:p0927:b003:l019","ordinal":146936,"en":"He destroyed the forty companions."},{"id":"semetey-1-2013:p0927:b003:l020","ordinal":146937,"en":"He devoured Khan Zhakyp."},{"id":"semetey-1-2013:p0927:b003:l021","ordinal":146938,"en":"No mortal remained"},{"id":"semetey-1-2013:p0927:b003:l022","ordinal":146939,"en":"Who could withstand the boy."},{"id":"semetey-1-2013:p0927:b003:l023","ordinal":146940,"en":"The reason for our coming to you—"},{"id":"semetey-1-2013:p0927:b003:l024","ordinal":146941,"en":"Against the unbeliever like a venomous spider,"},{"id":"semetey-1-2013:p0927:b003:l025","ordinal":146942,"en":"The hero Khan Kongurbai,"},{"id":"semetey-1-2013:p0927:b003:l026","ordinal":146943,"en":"To wage a holy war in earnest,"},{"id":"semetey-1-2013:p0927:b003:l027","ordinal":146944,"en":"Placing the standard in your hands,"}]
