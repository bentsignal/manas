[{"id":"semetey-1-2013:p1182:b004:l016","ordinal":166401,"en":"Where is such a prize?"},{"id":"semetey-1-2013:p1182:b004:l017","ordinal":166402,"en":"I will make a riotous wholesale,"},{"id":"semetey-1-2013:p1182:b004:l018","ordinal":166403,"en":"My father's funeral"},{"id":"semetey-1-2013:p1182:b004:l019","ordinal":166404,"en":"I will make my world laugh."},{"id":"semetey-1-2013:p1182:b004:l020","ordinal":166405,"en":"I spoke proudly,"},{"id":"semetey-1-2013:p1182:b004:l021","ordinal":166406,"en":"My father's funeral"},{"id":"semetey-1-2013:p1182:b004:l022","ordinal":166407,"en":"I will spend my life."},{"id":"semetey-1-2013:p1182:b004:l023","ordinal":166408,"en":"Don't let the people gossip,"},{"id":"semetey-1-2013:p1182:b004:l024","ordinal":166409,"en":"Sorry for my father,"},{"id":"semetey-1-2013:p1182:b004:l025","ordinal":166410,"en":"Don't be left alone."},{"id":"semetey-1-2013:p1182:b004:l026","ordinal":166411,"en":"People who came to the memorial feast,"},{"id":"semetey-1-2013:p1182:b004:l027","ordinal":166412,"en":"To my father"},{"id":"semetey-1-2013:p1182:b004:l028","ordinal":166413,"en":"Put both of them down, put one on,"},{"id":"semetey-1-2013:p1182:b004:l029","ordinal":166414,"en":"Put my son and my family."},{"id":"semetey-1-2013:p1182:b004:l030","ordinal":166415,"en":"My people moved from Tashkent."},{"id":"semetey-1-2013:p1182:b004:l031","ordinal":166416,"en":"If the world is not enough,"},{"id":"semetey-1-2013:p1182:b004:l032","ordinal":166417,"en":"Let's go around"},{"id":"semetey-1-2013:p1182:b004:l033","ordinal":166418,"en":"Call me the grand prize.\""},{"id":"semetey-1-2013:p1182:b004:l034","ordinal":166419,"en":"Kökötöy's feast"},{"id":"semetey-1-2013:p1182:b004:l035","ordinal":166420,"en":"Before closing his mouth,"},{"id":"semetey-1-2013:p1182:b004:l036","ordinal":166421,"en":"Until he stopped talking,"},{"id":"semetey-1-2013:p1182:b004:l037","ordinal":166422,"en":"The bell rings loudly,"},{"id":"semetey-1-2013:p1182:b004:l038","ordinal":166423,"en":"Serving red camel,"},{"id":"semetey-1-2013:p1182:b004:l039","ordinal":166424,"en":"came in and closed,"}]
