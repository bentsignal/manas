[{"id":"semetey-1-2013:p0630:b004:l018","ordinal":125185,"en":"Thrust out spears and roared,"},{"id":"semetey-1-2013:p0630:b004:l019","ordinal":125186,"en":"All shouting “Kobosh!” as their battle cry."},{"id":"semetey-1-2013:p0630:b004:l020","ordinal":125187,"en":"Taking battle-axes, leaning back,"},{"id":"semetey-1-2013:p0630:b004:l021","ordinal":125188,"en":"The treasury of Manas"},{"id":"semetey-1-2013:p0630:b004:l022","ordinal":125189,"en":"They rushed into and wrecked."},{"id":"semetey-1-2013:p0630:b004:l023","ordinal":125190,"en":"Whole otter pelts"},{"id":"semetey-1-2013:p0630:b004:l024","ordinal":125191,"en":"They tore apart and divided;"},{"id":"semetey-1-2013:p0630:b004:l025","ordinal":125192,"en":"The forty companions left by Manas"},{"id":"semetey-1-2013:p0630:b004:l026","ordinal":125193,"en":"Used them to trim their trouser legs."},{"id":"semetey-1-2013:p0630:b004:l027","ordinal":125194,"en":"Bustling, their broad bodies looming,"},{"id":"semetey-1-2013:p0630:b004:l028","ordinal":125195,"en":"Their wineskin-like noses bobbing,"},{"id":"semetey-1-2013:p0630:b004:l029","ordinal":125196,"en":"Looting gold, hurrying about,"},{"id":"semetey-1-2013:p0630:b004:l030","ordinal":125197,"en":"Their strange pig snouts twitching."},{"id":"semetey-1-2013:p0630:b004:l031","ordinal":125198,"en":"They dealt him a cruel reckoning;"},{"id":"semetey-1-2013:p0630:b004:l032","ordinal":125199,"en":"Bolokbay's flank"},{"id":"semetey-1-2013:p0630:b004:l033","ordinal":125200,"en":"Was shot by the six scoundrels."},{"id":"semetey-1-2013:p0630:b004:l034","ordinal":125201,"en":"From the treasury, Bolokbay"},{"id":"semetey-1-2013:p0630:b004:l035","ordinal":125202,"en":"Took no fox pelt to make a cap,"},{"id":"semetey-1-2013:p0630:b004:l036","ordinal":125203,"en":"Took no valuables for his needs,"},{"id":"semetey-1-2013:p0630:b004:l037","ordinal":125204,"en":"Took no yearling colt to ride;"},{"id":"semetey-1-2013:p0630:b004:l038","ordinal":125205,"en":"Howling, weeping, grieving,"},{"id":"semetey-1-2013:p0630:b004:l039","ordinal":125206,"en":"Having lost his great lord, Khan Manas,"},{"id":"semetey-1-2013:p0631:b003:l001","ordinal":125207,"en":"Suffering violence, hardship, oppression,"},{"id":"semetey-1-2013:p0631:b003:l002","ordinal":125208,"en":"Suffering from the six scoundrels what no mortal should see."},{"id":"semetey-1-2013:p0631:b003:l004","ordinal":125209,"en":"The many treasures, the abundant gold,"},{"id":"semetey-1-2013:p0631:b003:l005","ordinal":125210,"en":"When they passed beyond his keeping,"},{"id":"semetey-1-2013:p0631:b003:l006","ordinal":125211,"en":"Without valuing the wealth a hair's breadth,"},{"id":"semetey-1-2013:p0631:b003:l007","ordinal":125212,"en":"When warrior Bolokbay let it scatter,"},{"id":"semetey-1-2013:p0631:b003:l008","ordinal":125213,"en":"Unable to find his bearings,"},{"id":"semetey-1-2013:p0631:b003:l009","ordinal":125214,"en":"Kayypchy's dark cave—"},{"id":"semetey-1-2013:p0631:b003:l010","ordinal":125215,"en":"When he fled toward the dark cave,"},{"id":"semetey-1-2013:p0631:b003:l011","ordinal":125216,"en":"The six scoundrels wrecked his settlement."},{"id":"semetey-1-2013:p0631:b003:l012","ordinal":125217,"en":"Your poor man left behind by Manas,"},{"id":"semetey-1-2013:p0631:b003:l013","ordinal":125218,"en":"Skirting Kara-Too,"},{"id":"semetey-1-2013:p0631:b003:l014","ordinal":125219,"en":"Saying, “When will my dear Semetey come?”"},{"id":"semetey-1-2013:p0631:b003:l016","ordinal":125220,"en":"The wretched man passed his days,"},{"id":"semetey-1-2013:p0631:b003:l017","ordinal":125221,"en":"Placing his hopes in Semetey."},{"id":"semetey-1-2013:p0631:b003:l018","ordinal":125222,"en":"That was after Khan Manas had died,"},{"id":"semetey-1-2013:p0631:b003:l019","ordinal":125223,"en":"When Bolokbay fled and wandered,"},{"id":"semetey-1-2013:p0631:b003:l020","ordinal":125224,"en":"Making his living among the great cliffs."},{"id":"semetey-1-2013:p0631:b003:l021","ordinal":125225,"en":"Roaming through Kangshaak-Tash,"},{"id":"semetey-1-2013:p0631:b003:l022","ordinal":125226,"en":"Sheltering in the dark cave,"},{"id":"semetey-1-2013:p0631:b003:l023","ordinal":125227,"en":"Not dead, not in a grave,"},{"id":"semetey-1-2013:p0631:b003:l024","ordinal":125228,"en":"Bolokbay at that time,"},{"id":"semetey-1-2013:p0631:b003:l025","ordinal":125229,"en":"With his forty guards foremost,"},{"id":"semetey-1-2013:p0631:b003:l026","ordinal":125230,"en":"Was not counted among the living."},{"id":"semetey-1-2013:p0631:b003:l027","ordinal":125231,"en":"That night Bolokbay"},{"id":"semetey-1-2013:p0631:b003:l028","ordinal":125232,"en":"Woke with a start from sleep,"},{"id":"semetey-1-2013:p0631:b003:l029","ordinal":125233,"en":"Entered farther into him,"},{"id":"semetey-1-2013:p0631:b003:l030","ordinal":125234,"en":"His only Semetey had entered his dream."},{"id":"semetey-1-2013:p0631:b003:l031","ordinal":125235,"en":"Crying, “Baabedin!”"},{"id":"semetey-1-2013:p0631:b003:l032","ordinal":125236,"en":"He called his guards."},{"id":"semetey-1-2013:p0631:b003:l033","ordinal":125237,"en":"Bolokbay, himself a hunter,"},{"id":"semetey-1-2013:p0631:b003:l034","ordinal":125238,"en":"Went scouting through the foothills;"},{"id":"semetey-1-2013:p0631:b003:l035","ordinal":125239,"en":"Six wild ewes and four wild rams"},{"id":"semetey-1-2013:p0631:b003:l036","ordinal":125240,"en":"Bolokbay shot and took,"},{"id":"semetey-1-2013:p0631:b003:l037","ordinal":125241,"en":"And on top of the dark cliff"},{"id":"semetey-1-2013:p0631:b003:l038","ordinal":125242,"en":"Offered them to Baabedin."},{"id":"semetey-1-2013:p0631:b003:l039","ordinal":125243,"en":"Then Bolokbay, the lame smith—"},{"id":"semetey-1-2013:p0631:b004:l001","ordinal":125244,"en":"Mist stirred above;"},{"id":"semetey-1-2013:p0631:b004:l002","ordinal":125245,"en":"Dootu and Bolokbay"},{"id":"semetey-1-2013:p0631:b004:l003","ordinal":125246,"en":"Were friends for the next world."},{"id":"semetey-1-2013:p0631:b004:l004","ordinal":125247,"en":"He was that peerless smith, that warrior;"},{"id":"semetey-1-2013:p0631:b004:l005","ordinal":125248,"en":"As he lay sleeping,"},{"id":"semetey-1-2013:p0631:b004:l006","ordinal":125249,"en":"Of the boy Semetey"},{"id":"semetey-1-2013:p0631:b004:l007","ordinal":125250,"en":"He had seen a sign just then."},{"id":"semetey-1-2013:p0631:b004:l008","ordinal":125251,"en":"“My dear forty guards,"},{"id":"semetey-1-2013:p0631:b004:l009","ordinal":125252,"en":"Who fled and wandered in the mountains,"},{"id":"semetey-1-2013:p0631:b004:l010","ordinal":125253,"en":"My wretched guards, come here!"},{"id":"semetey-1-2013:p0631:b004:l011","ordinal":125254,"en":"Deprived of the treasury,"},{"id":"semetey-1-2013:p0631:b004:l012","ordinal":125255,"en":"My emaciated guards, come here!"},{"id":"semetey-1-2013:p0631:b004:l013","ordinal":125256,"en":"My dear forty guards,"},{"id":"semetey-1-2013:p0631:b004:l014","ordinal":125257,"en":"Is there a night like the Night of Power?"},{"id":"semetey-1-2013:p0631:b004:l015","ordinal":125258,"en":"Will the day come when Semetey returns?"},{"id":"semetey-1-2013:p0631:b004:l016","ordinal":125259,"en":"With my honor restored thus,"},{"id":"semetey-1-2013:p0631:b004:l017","ordinal":125260,"en":"Your exposed places covered,"},{"id":"semetey-1-2013:p0631:b004:l018","ordinal":125261,"en":"All grief scattered,"},{"id":"semetey-1-2013:p0631:b004:l019","ordinal":125262,"en":"All pent-up anguish released,"},{"id":"semetey-1-2013:p0631:b004:l020","ordinal":125263,"en":"Will the day come when Semetey returns?"},{"id":"semetey-1-2013:p0631:b004:l021","ordinal":125264,"en":"We fled to the mountains for our lives,"},{"id":"semetey-1-2013:p0631:b004:l022","ordinal":125265,"en":"Praying hard to the true God;"},{"id":"semetey-1-2013:p0631:b004:l023","ordinal":125266,"en":"Your staying alive and well"},{"id":"semetey-1-2013:p0631:b004:l024","ordinal":125267,"en":"Is for the boy Semetey alone."},{"id":"semetey-1-2013:p0631:b004:l025","ordinal":125268,"en":"If my orphan is still alive,"},{"id":"semetey-1-2013:p0631:b004:l026","ordinal":125269,"en":"He must have reached twelve years;"},{"id":"semetey-1-2013:p0631:b004:l027","ordinal":125270,"en":"Kanykey, reckoning the time,"},{"id":"semetey-1-2013:p0631:b004:l028","ordinal":125271,"en":"Must have chosen this year to send him."},{"id":"semetey-1-2013:p0631:b004:l029","ordinal":125272,"en":"My dear forty guards,"},{"id":"semetey-1-2013:p0631:b004:l030","ordinal":125273,"en":"This wretch's eyelid"},{"id":"semetey-1-2013:p0631:b004:l031","ordinal":125274,"en":"Keeps fluttering, twitching hard."},{"id":"semetey-1-2013:p0631:b004:l032","ordinal":125275,"en":"What can this mean?"},{"id":"semetey-1-2013:p0631:b004:l033","ordinal":125276,"en":"Interpret this sign of mine!"},{"id":"semetey-1-2013:p0631:b004:l034","ordinal":125277,"en":"My dear forty guards,"},{"id":"semetey-1-2013:p0631:b004:l035","ordinal":125278,"en":"May generous Manas never die,"},{"id":"semetey-1-2013:p0631:b004:l036","ordinal":125279,"en":"May this poor soul never suffer!"},{"id":"semetey-1-2013:p0631:b004:l037","ordinal":125280,"en":"Skirting the mountains, seeing no people,"},{"id":"semetey-1-2013:p0631:b004:l038","ordinal":125281,"en":"Seeing no land of famous Talas,"},{"id":"semetey-1-2013:p0631:b004:l039","ordinal":125282,"en":"Seeing no white-kalpak Kyrgyz people,"},{"id":"semetey-1-2013:p0632:b003:l001","ordinal":125283,"en":"Is this how my fate will end?"},{"id":"semetey-1-2013:p0632:b003:l002","ordinal":125284,"en":"Fleeing, dying in the mountains,"},{"id":"semetey-1-2013:p0632:b003:l003","ordinal":125285,"en":"Will death reach us in this way?"},{"id":"semetey-1-2013:p0632:b003:l004","ordinal":125286,"en":"When I lay at night and dreamed,"},{"id":"semetey-1-2013:p0632:b003:l005","ordinal":125287,"en":"The bloodthirsty one's son, Semetey,"},{"id":"semetey-1-2013:p0632:b003:l006","ordinal":125288,"en":"My orphan, had arrived."},{"id":"semetey-1-2013:p0632:b003:l007","ordinal":125289,"en":"On Abyke's Kanjailak,"},{"id":"semetey-1-2013:p0632:b003:l008","ordinal":125290,"en":"He played and strode with legs spread wide,"},{"id":"semetey-1-2013:p0632:b003:l009","ordinal":125291,"en":"And showed great valor."},{"id":"semetey-1-2013:p0632:b003:l010","ordinal":125292,"en":"Setting fire to the grassy ground,"},{"id":"semetey-1-2013:p0632:b003:l011","ordinal":125293,"en":"He brought upon Abyke"},{"id":"semetey-1-2013:p0632:b003:l012","ordinal":125294,"en":"A great and mighty turmoil."},{"id":"semetey-1-2013:p0632:b003:l013","ordinal":125295,"en":"Has Semetey arrived?"},{"id":"semetey-1-2013:p0632:b003:l014","ordinal":125296,"en":"Has God granted him to us?"},{"id":"semetey-1-2013:p0632:b003:l015","ordinal":125297,"en":"At Kaikychak's lookout rock,"},{"id":"semetey-1-2013:p0632:b003:l016","ordinal":125298,"en":"My dear forty guards,"},{"id":"semetey-1-2013:p0632:b003:l017","ordinal":125299,"en":"Let me go and keep a watch."},{"id":"semetey-1-2013:p0632:b003:l018","ordinal":125300,"en":"If I see a sign from Bakai,"},{"id":"semetey-1-2013:p0632:b003:l019","ordinal":125301,"en":"I will shout aloud!”"},{"id":"semetey-1-2013:p0632:b003:l020","ordinal":125302,"en":"Saying this, Bölökbai"},{"id":"semetey-1-2013:p0632:b003:l021","ordinal":125303,"en":"Came to the lookout rock."},{"id":"semetey-1-2013:p0632:b003:l022","ordinal":125304,"en":"As he sat and watched from there,"},{"id":"semetey-1-2013:p0632:b003:l023","ordinal":125305,"en":"Smoke rose in billowing plumes."},{"id":"semetey-1-2013:p0632:b003:l024","ordinal":125306,"en":"A man who looked like Bakai"},{"id":"semetey-1-2013:p0632:b003:l025","ordinal":125307,"en":"Could be seen gathering firewood."},{"id":"semetey-1-2013:p0632:b003:l026","ordinal":125308,"en":"God must have granted the wish;"},{"id":"semetey-1-2013:p0632:b003:l027","ordinal":125309,"en":"The orphan we awaited must have come!"},{"id":"semetey-1-2013:p0632:b003:l028","ordinal":125310,"en":"God must have granted our desire;"},{"id":"semetey-1-2013:p0632:b003:l029","ordinal":125311,"en":"My orphan, my support, must have come."},{"id":"semetey-1-2013:p0632:b003:l030","ordinal":125312,"en":"Without a cap, his head bare,"},{"id":"semetey-1-2013:p0632:b003:l031","ordinal":125313,"en":"He comes down the slope, broad-bodied,"},{"id":"semetey-1-2013:p0632:b003:l032","ordinal":125314,"en":"Runs lumbering in his shirt."},{"id":"semetey-1-2013:p0632:b003:l033","ordinal":125315,"en":"Could it be fierce Khan Bakai himself?"},{"id":"semetey-1-2013:p0632:b003:l034","ordinal":125316,"en":"His orphan has come, and lion Bakai"},{"id":"semetey-1-2013:p0632:b003:l035","ordinal":125317,"en":"Must be overcome with excitement."},{"id":"semetey-1-2013:p0632:b003:l036","ordinal":125318,"en":"The broad figure in a shirt,"},{"id":"semetey-1-2013:p0632:b003:l037","ordinal":125319,"en":"Visible there in front,"},{"id":"semetey-1-2013:p0632:b003:l038","ordinal":125320,"en":"Must be Khan Bakai himself."},{"id":"semetey-1-2013:p0632:b003:l039","ordinal":125321,"en":"His boy has come; his wish"},{"id":"semetey-1-2013:p0632:b004:l001","ordinal":125322,"en":"Must now have been fulfilled!”"},{"id":"semetey-1-2013:p0632:b004:l002","ordinal":125323,"en":"He shouted to his forty guards,"},{"id":"semetey-1-2013:p0632:b004:l003","ordinal":125324,"en":"Calling, “Come here!”"},{"id":"semetey-1-2013:p0632:b004:l004","ordinal":125325,"en":"Barefoot and bareheaded,"},{"id":"semetey-1-2013:p0632:b004:l005","ordinal":125326,"en":"Bölökbai at the head of forty guards,"},{"id":"semetey-1-2013:p0632:b004:l006","ordinal":125327,"en":"They were naked, without clothes."},{"id":"semetey-1-2013:p0632:b004:l007","ordinal":125328,"en":"All their robes had fallen apart."},{"id":"semetey-1-2013:p0632:b004:l008","ordinal":125329,"en":"Over those twelve years,"},{"id":"semetey-1-2013:p0632:b004:l009","ordinal":125330,"en":"Finding no clothing, the guards"},{"id":"semetey-1-2013:p0632:b004:l010","ordinal":125331,"en":"Had their wretched parts exposed."},{"id":"semetey-1-2013:p0632:b004:l011","ordinal":125332,"en":"Before dying, to be as dead—"},{"id":"semetey-1-2013:p0632:b004:l012","ordinal":125333,"en":"The forty guards were close to that,"},{"id":"semetey-1-2013:p0632:b004:l013","ordinal":125334,"en":"Close to facing the Last Judgment."},{"id":"semetey-1-2013:p0632:b004:l014","ordinal":125335,"en":"All the forty guards had gained"},{"id":"semetey-1-2013:p0632:b004:l015","ordinal":125336,"en":"Was the wild game they found."},{"id":"semetey-1-2013:p0632:b004:l016","ordinal":125337,"en":"The hides of that game"},{"id":"semetey-1-2013:p0632:b004:l017","ordinal":125338,"en":"They laid over their fleshy buttocks."},{"id":"semetey-1-2013:p0632:b004:l018","ordinal":125339,"en":"The forty guards, wearing no mail,"},{"id":"semetey-1-2013:p0632:b004:l019","ordinal":125340,"en":"Were humiliated worse than all."},{"id":"semetey-1-2013:p0632:b004:l020","ordinal":125341,"en":"The trousers they wore split apart;"},{"id":"semetey-1-2013:p0632:b004:l021","ordinal":125342,"en":"The forty guards could find no remedy."},{"id":"semetey-1-2013:p0632:b004:l022","ordinal":125343,"en":"Their private parts were exposed;"},{"id":"semetey-1-2013:p0632:b004:l023","ordinal":125344,"en":"Their flesh had wasted, their strength was gone,"},{"id":"semetey-1-2013:p0632:b004:l024","ordinal":125345,"en":"Their livestock gone from the forty guards."},{"id":"semetey-1-2013:p0632:b004:l025","ordinal":125346,"en":"When they heard Bölökbai's voice,"},{"id":"semetey-1-2013:p0632:b004:l026","ordinal":125347,"en":"Leading their gray two-year-old wether,"},{"id":"semetey-1-2013:p0632:b004:l027","ordinal":125348,"en":"They all came running together."},{"id":"semetey-1-2013:p0632:b004:l028","ordinal":125349,"en":"“My dear Bölökbai,"},{"id":"semetey-1-2013:p0632:b004:l029","ordinal":125350,"en":"Your shout rings out so strongly."},{"id":"semetey-1-2013:p0632:b004:l030","ordinal":125351,"en":"Has God granted us our honor?"},{"id":"semetey-1-2013:p0632:b004:l031","ordinal":125352,"en":"Has the suffering orphan come?"},{"id":"semetey-1-2013:p0632:b004:l032","ordinal":125353,"en":"My dear Bölökbai,"},{"id":"semetey-1-2013:p0632:b004:l033","ordinal":125354,"en":"Blue steam rises from your exposed flesh."},{"id":"semetey-1-2013:p0632:b004:l035","ordinal":125355,"en":"Is there news, Bölökö,"},{"id":"semetey-1-2013:p0632:b004:l036","ordinal":125356,"en":"Of that orphan, Manas's son?"},{"id":"semetey-1-2013:p0632:b004:l037","ordinal":125357,"en":"Has Semetey come, Bölökö,"},{"id":"semetey-1-2013:p0632:b004:l038","ordinal":125358,"en":"With exposed flesh covered,"},{"id":"semetey-1-2013:p0632:b004:l039","ordinal":125359,"en":"And all our honor restored,"},{"id":"semetey-1-2013:p0633:b003:l001","ordinal":125360,"en":"Oh God, will you grant such a day?"},{"id":"semetey-1-2013:p0633:b003:l002","ordinal":125361,"en":"Shodding our feet in rawhide shoes,"},{"id":"semetey-1-2013:p0633:b003:l003","ordinal":125362,"en":"Skirting Kara-Too,"},{"id":"semetey-1-2013:p0633:b003:l004","ordinal":125363,"en":"We have suffered much sorrow."},{"id":"semetey-1-2013:p0633:b003:l005","ordinal":125364,"en":"My dear Bölökbai,"},{"id":"semetey-1-2013:p0633:b003:l006","ordinal":125365,"en":"Will a day come when this sorrow leaves?"},{"id":"semetey-1-2013:p0633:b003:l007","ordinal":125366,"en":"We carved arrows, uttering spells,"},{"id":"semetey-1-2013:p0633:b003:l008","ordinal":125367,"en":"Roamed tirelessly to keep ourselves alive,"},{"id":"semetey-1-2013:p0633:b003:l009","ordinal":125368,"en":"Chasing what God had lost."},{"id":"semetey-1-2013:p0633:b003:l010","ordinal":125369,"en":"Will a day come when this is forgotten?”"},{"id":"semetey-1-2013:p0633:b003:l011","ordinal":125370,"en":"The forty guards wept and sobbed;"},{"id":"semetey-1-2013:p0633:b003:l012","ordinal":125371,"en":"Among them Bölökbai wept with cries."},{"id":"semetey-1-2013:p0633:b003:l014","ordinal":125372,"en":"Along the foot of the lower mountains"},{"id":"semetey-1-2013:p0633:b003:l015","ordinal":125373,"en":"The forty guards were coming,"},{"id":"semetey-1-2013:p0633:b003:l016","ordinal":125374,"en":"Leading the gray two-year-old wether."},{"id":"semetey-1-2013:p0633:b003:l017","ordinal":125375,"en":"When terrible madness raged,"},{"id":"semetey-1-2013:p0633:b003:l018","ordinal":125376,"en":"When the six vile ones came and raided the treasury,"},{"id":"semetey-1-2013:p0633:b003:l020","ordinal":125377,"en":"This gray wether standing here"},{"id":"semetey-1-2013:p0633:b003:l021","ordinal":125378,"en":"Was the animal that gave them support."},{"id":"semetey-1-2013:p0633:b003:l022","ordinal":125379,"en":"“When the orphan comes, grown up,"},{"id":"semetey-1-2013:p0633:b003:l023","ordinal":125380,"en":"I will slaughter it for Baabedin,” he said;"},{"id":"semetey-1-2013:p0633:b003:l024","ordinal":125381,"en":"It was the beast set apart for that."},{"id":"semetey-1-2013:p0633:b003:l025","ordinal":125382,"en":"The forty guards came walking,"},{"id":"semetey-1-2013:p0633:b003:l026","ordinal":125383,"en":"Their tears pouring down,"},{"id":"semetey-1-2013:p0633:b003:l027","ordinal":125384,"en":"With no way to cover themselves,"},{"id":"semetey-1-2013:p0633:b003:l028","ordinal":125385,"en":"Their bare flesh showing."},{"id":"semetey-1-2013:p0633:b003:l029","ordinal":125386,"en":"While Bölökbai stood weeping,"},{"id":"semetey-1-2013:p0633:b003:l030","ordinal":125387,"en":"Your orphan, Manas's son,"},{"id":"semetey-1-2013:p0633:b003:l031","ordinal":125388,"en":"Waiting patiently till the meat was cooked—"},{"id":"semetey-1-2013:p0633:b003:l032","ordinal":125389,"en":"For many days and many nights,"},{"id":"semetey-1-2013:p0633:b003:l033","ordinal":125390,"en":"Your orphan had gone without sleep."},{"id":"semetey-1-2013:p0633:b003:l034","ordinal":125391,"en":"Pillowing his head upon Ak-Kangky,"},{"id":"semetey-1-2013:p0633:b003:l035","ordinal":125392,"en":"Turning his head toward the qibla,"},{"id":"semetey-1-2013:p0633:b003:l036","ordinal":125393,"en":"He had fallen asleep;"},{"id":"semetey-1-2013:p0633:b003:l037","ordinal":125394,"en":"It was Semetey himself."},{"id":"semetey-1-2013:p0633:b003:l038","ordinal":125395,"en":"The forty guards came all together,"},{"id":"semetey-1-2013:p0633:b003:l039","ordinal":125396,"en":"Beseeching Khan Bakai."},{"id":"semetey-1-2013:p0633:b005:l001","ordinal":125397,"en":"The forty guards stood and said:"},{"id":"semetey-1-2013:p0633:b005:l002","ordinal":125398,"en":"“You who find words when taken by surprise,"},{"id":"semetey-1-2013:p0633:b005:l003","ordinal":125399,"en":"You who find sight in darkness,"},{"id":"semetey-1-2013:p0633:b005:l004","ordinal":125400,"en":"Is my dear uncle well?"},{"id":"semetey-1-2013:p0633:b005:l005","ordinal":125401,"en":"The painted pinewood spear—"},{"id":"semetey-1-2013:p0633:b005:l006","ordinal":125402,"en":"Is my uncle who bound it well?"},{"id":"semetey-1-2013:p0633:b005:l007","ordinal":125403,"en":"Who slaughtered and trampled unbelievers,"},{"id":"semetey-1-2013:p0633:b005:l008","ordinal":125404,"en":"Is my warring uncle well?"},{"id":"semetey-1-2013:p0633:b005:l009","ordinal":125405,"en":"Through east and west,"},{"id":"semetey-1-2013:p0633:b005:l010","ordinal":125406,"en":"Is my uncle who traveled well?"},{"id":"semetey-1-2013:p0633:b005:l011","ordinal":125407,"en":"Who fired shots at unbelievers,"},{"id":"semetey-1-2013:p0633:b005:l012","ordinal":125408,"en":"Is my lion uncle well?"},{"id":"semetey-1-2013:p0633:b005:l013","ordinal":125409,"en":"The mail no shot could pierce—"},{"id":"semetey-1-2013:p0633:b005:l014","ordinal":125410,"en":"Is my uncle who wore it well?"},{"id":"semetey-1-2013:p0633:b005:l015","ordinal":125411,"en":"Beijing with its twelve gates—"},{"id":"semetey-1-2013:p0633:b005:l016","ordinal":125412,"en":"Is my uncle who raided it well?"},{"id":"semetey-1-2013:p0633:b005:l017","ordinal":125413,"en":"Making Talas his homeland,"},{"id":"semetey-1-2013:p0633:b005:l018","ordinal":125414,"en":"Is my uncle who settled there well?"},{"id":"semetey-1-2013:p0633:b005:l019","ordinal":125415,"en":"An iron fort for Muslims,"},{"id":"semetey-1-2013:p0633:b005:l020","ordinal":125416,"en":"Is my uncle, their stronghold, well?"},{"id":"semetey-1-2013:p0633:b005:l021","ordinal":125417,"en":"Who made his deeds pure before Allah,"},{"id":"semetey-1-2013:p0633:b005:l022","ordinal":125418,"en":"Is my uncle who pleased him well?"},{"id":"semetey-1-2013:p0633:b005:l023","ordinal":125419,"en":"His orphaned camels, through great hardship—"},{"id":"semetey-1-2013:p0633:b005:l024","ordinal":125420,"en":"Is my uncle who tended them well?"},{"id":"semetey-1-2013:p0633:b005:l025","ordinal":125421,"en":"Living long through many years,"},{"id":"semetey-1-2013:p0633:b005:l026","ordinal":125422,"en":"Is my uncle who has not died well?"},{"id":"semetey-1-2013:p0633:b005:l027","ordinal":125423,"en":"For twelve years I have not seen his face—"},{"id":"semetey-1-2013:p0633:b005:l028","ordinal":125424,"en":"Is my uncle whom I have not seen well?"},{"id":"semetey-1-2013:p0633:b005:l029","ordinal":125425,"en":"Bek-Jailoo above Besh-Tash—"},{"id":"semetey-1-2013:p0633:b005:l030","ordinal":125426,"en":"Is my uncle who stayed there well?"},{"id":"semetey-1-2013:p0633:b005:l031","ordinal":125427,"en":"Destroying those he faced,"},{"id":"semetey-1-2013:p0633:b005:l032","ordinal":125428,"en":"Is my uncle who fired upon them well?"},{"id":"semetey-1-2013:p0633:b005:l033","ordinal":125429,"en":"You became mighty cliffs blessed by Khydyr;"},{"id":"semetey-1-2013:p0633:b005:l034","ordinal":125430,"en":"Uncle Bakai, have you seen your orphan?”"},{"id":"semetey-1-2013:p0633:b005:l036","ordinal":125431,"en":"Then Bakai said:"},{"id":"semetey-1-2013:p0633:b005:l037","ordinal":125432,"en":"“Oh Bölökbai, forty guards,"},{"id":"semetey-1-2013:p0633:b005:l038","ordinal":125433,"en":"What you lost has been found;"},{"id":"semetey-1-2013:p0633:b005:l039","ordinal":125434,"en":"Your exposed flesh has been covered."},{"id":"semetey-1-2013:p0634:b003:l001","ordinal":125435,"en":"Your orphan has come; you are whole again."},{"id":"semetey-1-2013:p0634:b003:l002","ordinal":125436,"en":"What was broken has been joined,"},{"id":"semetey-1-2013:p0634:b003:l003","ordinal":125437,"en":"What was scattered has been gathered."},{"id":"semetey-1-2013:p0634:b003:l004","ordinal":125438,"en":"God has granted your wish."},{"id":"semetey-1-2013:p0634:b003:l005","ordinal":125439,"en":"Your only one left by Manas,"},{"id":"semetey-1-2013:p0634:b003:l006","ordinal":125440,"en":"That orphan has arrived."}]
