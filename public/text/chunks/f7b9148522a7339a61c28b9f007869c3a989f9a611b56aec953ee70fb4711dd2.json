[{"id":"manas-2010:p0915:b001:l020","ordinal":40193,"en":"Created with exceptional fortune,"},{"id":"manas-2010:p0915:b001:l021","ordinal":40194,"en":"You are truly a lion;"},{"id":"manas-2010:p0915:b001:l022","ordinal":40195,"en":"The last of the six lions,"},{"id":"manas-2010:p0915:b001:l023","ordinal":40196,"en":"You are truly a hero!"},{"id":"manas-2010:p0915:b001:l024","ordinal":40197,"en":"Bloodstained warrior, your prowess"},{"id":"manas-2010:p0915:b001:l025","ordinal":40198,"en":"I prized and knew long ago."},{"id":"manas-2010:p0915:b001:l026","ordinal":40199,"en":"'To take you by the hand,"},{"id":"manas-2010:p0915:b001:l027","ordinal":40200,"en":"To lend a hand and support you,'"},{"id":"manas-2010:p0915:b001:l028","ordinal":40201,"en":"This I had been asking."},{"id":"manas-2010:p0915:b001:l029","ordinal":40202,"en":"You are guileless, you are a lion;"},{"id":"manas-2010:p0915:b001:l030","ordinal":40203,"en":"You are an openhearted warrior."},{"id":"manas-2010:p0915:b001:l031","ordinal":40204,"en":"Your ancestral spirit was created greater;"},{"id":"manas-2010:p0915:b001:l032","ordinal":40205,"en":"You are a lion who shows no mercy."},{"id":"manas-2010:p0915:b001:l033","ordinal":40206,"en":"If you strike with battle-axe and spear,"},{"id":"manas-2010:p0915:b001:l034","ordinal":40207,"en":"If you fight amid battle cries,"},{"id":"manas-2010:p0915:b001:l035","ordinal":40208,"en":"And in wrath against the enemy"},{"id":"manas-2010:p0915:b001:l036","ordinal":40209,"en":"Stand facing them,"},{"id":"manas-2010:p0915:b001:l037","ordinal":40210,"en":"I shall keep you from the wrong road"},{"id":"manas-2010:p0915:b001:l038","ordinal":40211,"en":"And set you on the right path myself."},{"id":"manas-2010:p0915:b001:l039","ordinal":40212,"en":"If you roar in anger,"},{"id":"manas-2010:p0915:b001:l040","ordinal":40213,"en":"If you call, 'Shai Ata!'"},{"id":"manas-2010:p0915:b001:l041","ordinal":40214,"en":"I shall ride a gray horse vast as the sky"},{"id":"manas-2010:p0915:b001:l042","ordinal":40215,"en":"And raise a piercing battle cry,"},{"id":"manas-2010:p0916:b001:l001","ordinal":40216,"en":"If hardship threatens your entrusted life,"},{"id":"manas-2010:p0916:b001:l002","ordinal":40217,"en":"My lion, at your side"},{"id":"manas-2010:p0916:b001:l003","ordinal":40218,"en":"I shall be your companion."},{"id":"manas-2010:p0916:b001:l004","ordinal":40219,"en":"March in holy war against the unbelievers,"},{"id":"manas-2010:p0916:b001:l005","ordinal":40220,"en":"And keep me in your thoughts!"},{"id":"manas-2010:p0916:b001:l006","ordinal":40221,"en":"If you find yourself hard pressed,"},{"id":"manas-2010:p0916:b001:l007","ordinal":40222,"en":"I myself shall come to your aid;"},{"id":"manas-2010:p0916:b001:l008","ordinal":40223,"en":"If fierce strife and turmoil arise,"},{"id":"manas-2010:p0916:b001:l009","ordinal":40224,"en":"I shall be your companion!”"},{"id":"manas-2010:p0916:b001:l010","ordinal":40225,"en":"With these words, Shai Ata"},{"id":"manas-2010:p0916:b001:l011","ordinal":40226,"en":"Turned Kayypboz's head."},{"id":"manas-2010:p0916:b001:l012","ordinal":40227,"en":"With Ajybai, Bakai, and Chubak,"},{"id":"manas-2010:p0916:b001:l013","ordinal":40228,"en":"And generous Manas—all four—"},{"id":"manas-2010:p0916:b001:l014","ordinal":40229,"en":"Again and again Shai Ata"},{"id":"manas-2010:p0916:b001:l015","ordinal":40230,"en":"Clasped their hands."},{"id":"manas-2010:p0916:b001:l016","ordinal":40231,"en":"The five holy elders who clasped hands"},{"id":"manas-2010:p0916:b001:l017","ordinal":40232,"en":"Were Shai Ata himself;"},{"id":"manas-2010:p0916:b001:l018","ordinal":40233,"en":"They looked, but could not see him,"},{"id":"manas-2010:p0916:b001:l019","ordinal":40234,"en":"None knew where he had gone:"},{"id":"manas-2010:p0916:b001:l020","ordinal":40235,"en":"He vanished from their sight."},{"id":"manas-2010:p0916:b001:l021","ordinal":40236,"en":"For the generous prince Manas,"},{"id":"manas-2010:p0916:b001:l022","ordinal":40237,"en":"Zhelmaian had been found,"},{"id":"manas-2010:p0916:b001:l023","ordinal":40238,"en":"And his honor was thus secured."},{"id":"manas-2010:p0916:b001:l024","ordinal":40239,"en":"Taking a shortcut along the narrow path,"},{"id":"manas-2010:p0916:b001:l025","ordinal":40240,"en":"Ajybai and Bakai led the way."},{"id":"manas-2010:p0916:b001:l026","ordinal":40241,"en":"Father Shai had come and given his hand:"},{"id":"manas-2010:p0916:b001:l027","ordinal":40242,"en":"Khizir's blessing met him in the wilderness."},{"id":"manas-2010:p0916:b001:l028","ordinal":40243,"en":"Through this, the hero Manas"},{"id":"manas-2010:p0916:b001:l029","ordinal":40244,"en":"Gained the title “Lion”!"},{"id":"manas-2010:p0916:b001:l030","ordinal":40245,"en":"Wherever he spent a night,"},{"id":"manas-2010:p0916:b001:l031","ordinal":40246,"en":"Leafy plane trees and willows sprang up."},{"id":"manas-2010:p0916:b001:l032","ordinal":40247,"en":"For the blood-shedding leopard Manas,"},{"id":"manas-2010:p0916:b001:l033","ordinal":40248,"en":"God had been a helper from the first."},{"id":"manas-2010:p0916:b001:l034","ordinal":40249,"en":"Wherever he made camp,"},{"id":"manas-2010:p0916:b001:l035","ordinal":40250,"en":"A plane tree stood to keep watch."},{"id":"manas-2010:p0916:b001:l036","ordinal":40251,"en":"The champion favored by Khizir"},{"id":"manas-2010:p0916:b001:l037","ordinal":40252,"en":"Was supported by Khoja Khizir."},{"id":"manas-2010:p0916:b001:l038","ordinal":40253,"en":"His forefathers were all khans,"},{"id":"manas-2010:p0916:b001:l039","ordinal":40254,"en":"Favored by Khizir from their beginnings;"},{"id":"manas-2010:p0916:b001:l040","ordinal":40255,"en":"His earliest ancestors were all khans,"},{"id":"manas-2010:p0916:b001:l041","ordinal":40256,"en":"Favored by Khizir from the first."},{"id":"manas-2010:p0916:b001:l042","ordinal":40257,"en":"When he attacked in fury,"},{"id":"manas-2010:p0917:b001:l001","ordinal":40258,"en":"No enemy could stand against him."},{"id":"manas-2010:p0917:b001:l002","ordinal":40259,"en":"He was that noble lion himself;"},{"id":"manas-2010:p0917:b001:l003","ordinal":40260,"en":"None who opposed him escaped alive:"},{"id":"manas-2010:p0917:b001:l004","ordinal":40261,"en":"He was the very eye of the leopard."},{"id":"manas-2010:p0917:b001:l005","ordinal":40262,"en":"Zhelmaian and Chubak had been found,"},{"id":"manas-2010:p0917:b001:l006","ordinal":40263,"en":"Seven saints had given him their hands:"},{"id":"manas-2010:p0917:b001:l007","ordinal":40264,"en":"That was when the lion Manas"},{"id":"manas-2010:p0917:b001:l008","ordinal":40265,"en":"Was touched by their blessing."},{"id":"manas-2010:p0917:b001:l009","ordinal":40266,"en":"Leaving minds astonished,"},{"id":"manas-2010:p0917:b001:l010","ordinal":40267,"en":"The generous prince then"},{"id":"manas-2010:p0917:b001:l011","ordinal":40268,"en":"Loomed like the Ala-Too mountains."},{"id":"manas-2010:p0917:b001:l012","ordinal":40269,"en":"At one glance, a thousand men;"},{"id":"manas-2010:p0917:b001:l013","ordinal":40270,"en":"At another glance, one man:"},{"id":"manas-2010:p0917:b001:l014","ordinal":40271,"en":"The wolf-maned hero of great fortune"},{"id":"manas-2010:p0917:b001:l015","ordinal":40272,"en":"Had powers to bring to bear on many."},{"id":"manas-2010:p0917:b001:l016","ordinal":40273,"en":"While valiant Manas was there,"},{"id":"manas-2010:p0917:b001:l017","ordinal":40274,"en":"Could any mortal face him?"},{"id":"manas-2010:p0917:b001:l018","ordinal":40275,"en":"Could an enemy confront and defeat him?"},{"id":"manas-2010:p0917:b001:l019","ordinal":40276,"en":"Could anyone bring suffering on his people?"},{"id":"manas-2010:p0917:b001:l020","ordinal":40277,"en":"Could those who clashed with him survive?"},{"id":"manas-2010:p0917:b001:l021","ordinal":40278,"en":"The mortals who obeyed his words"},{"id":"manas-2010:p0917:b001:l022","ordinal":40279,"en":"He brought to submission with words;"},{"id":"manas-2010:p0917:b001:l023","ordinal":40280,"en":"The fools who would not obey"},{"id":"manas-2010:p0917:b001:l024","ordinal":40281,"en":"He subdued with fury."},{"id":"manas-2010:p0917:b001:l025","ordinal":40282,"en":"In tamarisk-covered Keng-Kol, broad Talas,"},{"id":"manas-2010:p0917:b001:l026","ordinal":40283,"en":"And Uch-Koshoy he spent the summers."},{"id":"manas-2010:p0917:b001:l027","ordinal":40284,"en":"Whoever provoked his anger"},{"id":"manas-2010:p0917:b001:l028","ordinal":40285,"en":"He took between his fangs and chewed."},{"id":"manas-2010:p0917:b001:l029","ordinal":40286,"en":"Wherever his reach extended,"},{"id":"manas-2010:p0917:b001:l030","ordinal":40287,"en":"Of the prince favored by Khojosan"},{"id":"manas-2010:p0917:b001:l031","ordinal":40288,"en":"There was no mortal who did not ask."},{"id":"manas-2010:p0917:b001:l032","ordinal":40289,"en":"His companion was the hero Bakai."},{"id":"manas-2010:p0917:b001:l033","ordinal":40290,"en":"Of dear Prince Manas,"},{"id":"manas-2010:p0917:b001:l034","ordinal":40291,"en":"Which deeds could one begin to tell?"},{"id":"manas-2010:p0917:b001:l035","ordinal":40292,"en":"Mighty Bakai led the way;"},{"id":"manas-2010:p0917:b001:l036","ordinal":40293,"en":"Ajybai of the Argyn khan,"},{"id":"manas-2010:p0917:b001:l037","ordinal":40294,"en":"And Akbaltay's son Chubak"},{"id":"manas-2010:p0917:b001:l038","ordinal":40295,"en":"Sought hunting expeditions, searching for game,"},{"id":"manas-2010:p0917:b001:l039","ordinal":40296,"en":"Hunting argali, pursuing wild asses,"},{"id":"manas-2010:p0917:b001:l040","ordinal":40297,"en":"Never weary of seeking game."},{"id":"manas-2010:p0917:b001:l041","ordinal":40298,"en":"On the open yellow plain,"},{"id":"manas-2010:p0917:b001:l042","ordinal":40299,"en":"Wild asses, six at a time,"},{"id":"manas-2010:p0918:b001:l001","ordinal":40300,"en":"They shot and brought tumbling down,"},{"id":"manas-2010:p0918:b001:l002","ordinal":40301,"en":"Then loaded onto Zhelmaian."},{"id":"manas-2010:p0918:b001:l003","ordinal":40302,"en":"They crossed the Mediyen desert;"},{"id":"manas-2010:p0918:b001:l004","ordinal":40303,"en":"Kayyp-Mazar, Kara-Kyr—"},{"id":"manas-2010:p0918:b001:l005","ordinal":40304,"en":"Past the shrine of Kayypchy"},{"id":"manas-2010:p0918:b001:l006","ordinal":40305,"en":"Manas had just gone."},{"id":"manas-2010:p0918:b001:l007","ordinal":40306,"en":"From Zhanggaktuu's grassy upper slopes,"},{"id":"manas-2010:p0918:b001:l008","ordinal":40307,"en":"With Manas at their head,"},{"id":"manas-2010:p0918:b001:l009","ordinal":40308,"en":"The hero Bakai then,"},{"id":"manas-2010:p0918:b001:l010","ordinal":40309,"en":"At the place of their ablutions,"},{"id":"manas-2010:p0918:b001:l011","ordinal":40310,"en":"Put their hands into the water;"},{"id":"manas-2010:p0918:b001:l012","ordinal":40311,"en":"They washed their hands for prayer,"},{"id":"manas-2010:p0918:b001:l013","ordinal":40312,"en":"Put their feet into the water,"},{"id":"manas-2010:p0918:b001:l014","ordinal":40313,"en":"And washed their feet for prayer."},{"id":"manas-2010:p0918:b001:l015","ordinal":40314,"en":"The generous Bakai then"},{"id":"manas-2010:p0918:b001:l016","ordinal":40315,"en":"Raised the ringing call to prayer."},{"id":"manas-2010:p0918:b001:l017","ordinal":40316,"en":"As they recited their prayers,"},{"id":"manas-2010:p0918:b001:l018","ordinal":40317,"en":"And had just offered a blessing,"},{"id":"manas-2010:p0918:b001:l019","ordinal":40318,"en":"On the ridge of Kum-Bulak,"},{"id":"manas-2010:p0918:b001:l020","ordinal":40319,"en":"At the place of their ablutions,"},{"id":"manas-2010:p0918:b001:l021","ordinal":40320,"en":"Something appeared from the unseen:"},{"id":"manas-2010:p0918:b001:l022","ordinal":40321,"en":"A gray puppy the size of a hand,"},{"id":"manas-2010:p0918:b001:l023","ordinal":40322,"en":"Its eyes not yet open,"},{"id":"manas-2010:p0918:b001:l024","ordinal":40323,"en":"Only just newly born,"},{"id":"manas-2010:p0918:b001:l025","ordinal":40324,"en":"Was found by Manas Khan."},{"id":"manas-2010:p0918:b001:l026","ordinal":40325,"en":"To Manas, favored by Khizir,"},{"id":"manas-2010:p0918:b001:l027","ordinal":40326,"en":"All the finest creatures came;"},{"id":"manas-2010:p0918:b001:l028","ordinal":40327,"en":"To Manas, favored by Baabedin—"},{"id":"manas-2010:p0918:b001:l029","ordinal":40328,"en":"The other day, at Kara-Buura and Chatkal,"},{"id":"manas-2010:p0918:b001:l030","ordinal":40329,"en":"While the Kyrgyz lay at ease,"},{"id":"manas-2010:p0918:b001:l031","ordinal":40330,"en":"He went out eagerly hunting."},{"id":"manas-2010:p0918:b001:l032","ordinal":40331,"en":"To the champion favored by Khizir"},{"id":"manas-2010:p0918:b001:l033","ordinal":40332,"en":"Every precious thing came his way."},{"id":"manas-2010:p0918:b001:l034","ordinal":40333,"en":"His fortune blossomed anew;"},{"id":"manas-2010:p0918:b001:l035","ordinal":40334,"en":"Upon the champion of surpassing fortune"},{"id":"manas-2010:p0918:b001:l036","ordinal":40335,"en":"God's light of blessing shone."},{"id":"manas-2010:p0918:b001:l037","ordinal":40336,"en":"Zhelmaian, the gift of Shai Ata,"},{"id":"manas-2010:p0918:b001:l038","ordinal":40337,"en":"For wolf-maned Manas himself,"},{"id":"manas-2010:p0918:b001:l039","ordinal":40338,"en":"Was a mainstay for carrying loads."},{"id":"manas-2010:p0918:b001:l040","ordinal":40339,"en":"His Chubak, who had come from afar,"},{"id":"manas-2010:p0918:b001:l041","ordinal":40340,"en":"Was a fortunate path when sent ahead,"},{"id":"manas-2010:p0918:b001:l042","ordinal":40341,"en":"An entire host when driven into battle."},{"id":"manas-2010:p0919:b001:l001","ordinal":40342,"en":"A gray pup the size of a fist—"},{"id":"manas-2010:p0919:b001:l002","ordinal":40343,"en":"The inheritance he had found."},{"id":"manas-2010:p0919:b001:l003","ordinal":40344,"en":"Never shrinking from a bear,"},{"id":"manas-2010:p0919:b001:l004","ordinal":40345,"en":"Never fleeing from a tiger,"},{"id":"manas-2010:p0919:b001:l005","ordinal":40346,"en":"Your wolf-maned lion Manas"},{"id":"manas-2010:p0919:b001:l006","ordinal":40347,"en":"Found Kumayyk and cried aloud,"},{"id":"manas-2010:p0919:b001:l007","ordinal":40348,"en":"Calling to his uncle Bakay:"},{"id":"manas-2010:p0919:b001:l008","ordinal":40349,"en":"“Come quickly!” he shouted."},{"id":"manas-2010:p0919:b001:l009","ordinal":40350,"en":"When Bakay hurried over,"},{"id":"manas-2010:p0919:b001:l010","ordinal":40351,"en":"The gray pup, its eyes still closed,"},{"id":"manas-2010:p0919:b001:l011","ordinal":40352,"en":"Was resting there in Manas's"},{"id":"manas-2010:p0919:b001:l012","ordinal":40353,"en":"Right-hand palm."},{"id":"manas-2010:p0919:b001:l013","ordinal":40354,"en":"On seeing Kumayyk,"},{"id":"manas-2010:p0919:b001:l014","ordinal":40355,"en":"He cried, “Baabedin!”"},{"id":"manas-2010:p0919:b001:l015","ordinal":40356,"en":"Your elder Bakay then"},{"id":"manas-2010:p0919:b001:l016","ordinal":40357,"en":"Called for Ajybay."},{"id":"manas-2010:p0919:b001:l017","ordinal":40358,"en":"Then Ajybay said this:"},{"id":"manas-2010:p0919:b001:l018","ordinal":40359,"en":"“My wolf-maned lion Manas,"},{"id":"manas-2010:p0919:b001:l019","ordinal":40360,"en":"May your puppy bring you blessings!"},{"id":"manas-2010:p0919:b001:l020","ordinal":40361,"en":"My champion touched by Kydyr,"},{"id":"manas-2010:p0919:b001:l021","ordinal":40362,"en":"So many wonders have come your way;"},{"id":"manas-2010:p0919:b001:l022","ordinal":40363,"en":"The true Kumayyk has been found."},{"id":"manas-2010:p0919:b001:l023","ordinal":40364,"en":"It is indeed the true Kumayyk,"},{"id":"manas-2010:p0919:b001:l024","ordinal":40365,"en":"Born and left by a gray vulture."},{"id":"manas-2010:p0919:b001:l025","ordinal":40366,"en":"For you, my precious champion,"},{"id":"manas-2010:p0919:b001:l026","ordinal":40367,"en":"Allah Most High, your God,"},{"id":"manas-2010:p0919:b001:l027","ordinal":40368,"en":"Has brought it at this fitting hour."},{"id":"manas-2010:p0919:b001:l028","ordinal":40369,"en":"This Kumayyk here,"},{"id":"manas-2010:p0919:b001:l029","ordinal":40370,"en":"If passed through human hands,"},{"id":"manas-2010:p0919:b001:l030","ordinal":40371,"en":"They said, would suffer harm."},{"id":"manas-2010:p0919:b001:l031","ordinal":40372,"en":"If a man rears it,"},{"id":"manas-2010:p0919:b001:l032","ordinal":40373,"en":"Once six days have passed,"},{"id":"manas-2010:p0919:b001:l033","ordinal":40374,"en":"They said, it will vanish."},{"id":"manas-2010:p0919:b001:l034","ordinal":40375,"en":"The pale gray mare led along with us—"},{"id":"manas-2010:p0919:b001:l035","ordinal":40376,"en":"Hey, Chubak, bring her here!"},{"id":"manas-2010:p0919:b001:l036","ordinal":40377,"en":"Let us slaughter the pale gray mare,"},{"id":"manas-2010:p0919:b001:l037","ordinal":40378,"en":"Let us eat our fill of her meat,"},{"id":"manas-2010:p0919:b001:l038","ordinal":40379,"en":"All of us with open palms,"},{"id":"manas-2010:p0919:b001:l039","ordinal":40380,"en":"Let us give our blessing,"},{"id":"manas-2010:p0919:b001:l040","ordinal":40381,"en":"And name it the true Kumayyk!”"},{"id":"manas-2010:p0919:b001:l041","ordinal":40382,"en":"Hearing this, Khan Manas"},{"id":"manas-2010:p0919:b001:l042","ordinal":40383,"en":"To his uncle Bakay"},{"id":"manas-2010:p0920:b001:l001","ordinal":40384,"en":"Now handed Kumayyk."},{"id":"manas-2010:p0920:b001:l002","ordinal":40385,"en":"Barren for seven years,"},{"id":"manas-2010:p0920:b001:l003","ordinal":40386,"en":"The thoroughly fat pale gray mare—"},{"id":"manas-2010:p0920:b001:l004","ordinal":40387,"en":"Bloodthirsty Manas, the leopard,"},{"id":"manas-2010:p0920:b001:l005","ordinal":40388,"en":"By the ear and forelock"},{"id":"manas-2010:p0920:b001:l006","ordinal":40389,"en":"Now seized her together."},{"id":"manas-2010:p0920:b001:l007","ordinal":40390,"en":"Bozkise, descended from heaven,"},{"id":"manas-2010:p0920:b001:l008","ordinal":40391,"en":"Hung around his neck."},{"id":"manas-2010:p0920:b001:l009","ordinal":40392,"en":"For sixty yearlings, a hundred yearlings,"},{"id":"manas-2010:p0920:b001:l010","ordinal":40393,"en":"He had bought Aktinte;"},{"id":"manas-2010:p0920:b001:l011","ordinal":40394,"en":"Now he drew it from its sheath."},{"id":"manas-2010:p0920:b001:l012","ordinal":40395,"en":"Not letting the huge mare stir—"},{"id":"manas-2010:p0920:b001:l013","ordinal":40396,"en":"Know his strength from this—"},{"id":"manas-2010:p0920:b001:l014","ordinal":40397,"en":"He turned her toward Mecca"},{"id":"manas-2010:p0920:b001:l015","ordinal":40398,"en":"And now cut off her head."},{"id":"manas-2010:p0920:b001:l016","ordinal":40399,"en":"Chubak slit open her belly;"},{"id":"manas-2010:p0920:b001:l017","ordinal":40400,"en":"Her rib fat was a span thick."},{"id":"manas-2010:p0920:b001:l018","ordinal":40401,"en":"The magnanimous hero Bakay went,"},{"id":"manas-2010:p0920:b001:l019","ordinal":40402,"en":"Taking Kumayyk along,"},{"id":"manas-2010:p0920:b001:l020","ordinal":40403,"en":"And dipped its muzzle in the fat."},{"id":"manas-2010:p0920:b001:l021","ordinal":40404,"en":"He wrapped it in a soiled shirt,"},{"id":"manas-2010:p0920:b001:l022","ordinal":40405,"en":"Saying, “It is the true Kumayyk,”"},{"id":"manas-2010:p0920:b001:l023","ordinal":40406,"en":"And judged “Kumayyk” its fitting name."},{"id":"manas-2010:p0920:b001:l024","ordinal":40407,"en":"They quickly butchered the pale gray mare."},{"id":"manas-2010:p0920:b001:l025","ordinal":40408,"en":"Magnanimous Bakay then"},{"id":"manas-2010:p0920:b001:l026","ordinal":40409,"en":"Named it “Kumayyk.”"},{"id":"manas-2010:p0920:b001:l027","ordinal":40410,"en":"Readying himself like a goshawk,"},{"id":"manas-2010:p0920:b001:l028","ordinal":40411,"en":"Your fierce elder Bakay"},{"id":"manas-2010:p0920:b001:l029","ordinal":40412,"en":"Received wisdom from the unseen."},{"id":"manas-2010:p0920:b001:l030","ordinal":40413,"en":"Speaking softly, laying it down firmly,"},{"id":"manas-2010:p0920:b001:l031","ordinal":40414,"en":"Your elder Bakay began to speak:"},{"id":"manas-2010:p0920:b001:l032","ordinal":40415,"en":"“Wolf-maned Manas, leopard,"},{"id":"manas-2010:p0920:b001:l033","ordinal":40416,"en":"This is no gray pup, but blessed good fortune;"},{"id":"manas-2010:p0920:b001:l034","ordinal":40417,"en":"Hear and understand these words of mine."},{"id":"manas-2010:p0920:b001:l035","ordinal":40418,"en":"Truly, on the grass-grown surface"},{"id":"manas-2010:p0920:b001:l036","ordinal":40419,"en":"Of the earth, no such thing is found."},{"id":"manas-2010:p0920:b001:l037","ordinal":40420,"en":"Where ears have heard and eyes have seen,"},{"id":"manas-2010:p0920:b001:l038","ordinal":40421,"en":"Can such a thing be found among the people?"},{"id":"manas-2010:p0920:b001:l039","ordinal":40422,"en":"A gray pup in the open wilderness—"},{"id":"manas-2010:p0920:b001:l040","ordinal":40423,"en":"Where ears have heard and eyes have seen,"},{"id":"manas-2010:p0920:b001:l041","ordinal":40424,"en":"No human ever encounters one."},{"id":"manas-2010:p0920:b001:l042","ordinal":40425,"en":"This is no Kumayyk, but blessed good fortune—"},{"id":"manas-2010:p0921:b001:l001","ordinal":40426,"en":"My companion Manas, know this!"},{"id":"manas-2010:p0921:b001:l002","ordinal":40427,"en":"Except that its fur marks it a beast,"},{"id":"manas-2010:p0921:b001:l003","ordinal":40428,"en":"That dog surpasses a human."},{"id":"manas-2010:p0921:b001:l004","ordinal":40429,"en":"Allah Most High has made it;"},{"id":"manas-2010:p0921:b001:l005","ordinal":40430,"en":"Upon your brow, Manas,"},{"id":"manas-2010:p0921:b001:l006","ordinal":40431,"en":"He has written that treasure as your fate!"},{"id":"manas-2010:p0921:b001:l007","ordinal":40432,"en":"When this Kumayyk grows,"},{"id":"manas-2010:p0921:b001:l008","ordinal":40433,"en":"It will be your companion."},{"id":"manas-2010:p0921:b001:l009","ordinal":40434,"en":"Till death its longing will not be sated;"},{"id":"manas-2010:p0921:b001:l010","ordinal":40435,"en":"It will appear once before your eyes."},{"id":"manas-2010:p0921:b001:l011","ordinal":40436,"en":"If you set it on a bear and cry, “Get it!”"},{"id":"manas-2010:p0921:b001:l012","ordinal":40437,"en":"Let loose, it will make one laugh with joy."},{"id":"manas-2010:p0921:b001:l013","ordinal":40438,"en":"Whatever Kumayyk bites,"},{"id":"manas-2010:p0921:b001:l014","ordinal":40439,"en":"It will utterly destroy."},{"id":"manas-2010:p0921:b001:l015","ordinal":40440,"en":"Kumayyk, the good fortune you encountered—"},{"id":"manas-2010:p0921:b001:l016","ordinal":40441,"en":"Would it shrink from a tiger?"},{"id":"manas-2010:p0921:b001:l017","ordinal":40442,"en":"When this Kumayyk grows,"},{"id":"manas-2010:p0921:b001:l018","ordinal":40443,"en":"Would it recoil from anything?"},{"id":"manas-2010:p0921:b001:l019","ordinal":40444,"en":"Its lion-like nature is complete."},{"id":"manas-2010:p0921:b001:l020","ordinal":40445,"en":"This creature Kumayyk—"},{"id":"manas-2010:p0921:b001:l021","ordinal":40446,"en":"Will it not do as it pleases,"},{"id":"manas-2010:p0921:b001:l022","ordinal":40447,"en":"And wolves, whole packs of them,"},{"id":"manas-2010:p0921:b001:l023","ordinal":40448,"en":"Slaughter before your eyes?"}]
