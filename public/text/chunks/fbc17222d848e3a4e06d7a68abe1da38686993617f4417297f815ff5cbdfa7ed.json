[{"id":"semetey-1-2013:p0930:b004:l018","ordinal":147201,"en":"Having taken a whipping from a child,"},{"id":"semetey-1-2013:p0930:b004:l019","ordinal":147202,"en":"Grew cold and stared blankly."},{"id":"semetey-1-2013:p0930:b004:l020","ordinal":147203,"en":"For as long as it takes meat to cook,"},{"id":"semetey-1-2013:p0930:b004:l021","ordinal":147204,"en":"The hero Kozho lost consciousness."},{"id":"semetey-1-2013:p0930:b004:l022","ordinal":147205,"en":"Before Kozho regained his senses,"},{"id":"semetey-1-2013:p0930:b004:l023","ordinal":147206,"en":"Kulchoro mounted."},{"id":"semetey-1-2013:p0930:b004:l024","ordinal":147207,"en":"His father was a gray-maned hero;"},{"id":"semetey-1-2013:p0930:b004:l025","ordinal":147208,"en":"He moved without haste."},{"id":"semetey-1-2013:p0930:b004:l026","ordinal":147209,"en":"Abyke's Aktelki—"},{"id":"semetey-1-2013:p0930:b004:l028","ordinal":147210,"en":"Raiding and shattering his settlement,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0930:b004:l029","ordinal":147211,"en":"He attacked the hero Kozho."},{"id":"semetey-1-2013:p0930:b004:l030","ordinal":147212,"en":"Kulchoro grew wrathful."},{"id":"semetey-1-2013:p0930:b004:l031","ordinal":147213,"en":"What the champion carried upon his back"},{"id":"semetey-1-2013:p0930:b004:l032","ordinal":147214,"en":"Was his appointed ammunition."},{"id":"semetey-1-2013:p0930:b004:l033","ordinal":147215,"en":"Valiant, gray-maned Kulchoro—"},{"id":"semetey-1-2013:p0930:b004:l034","ordinal":147216,"en":"The horse he rode beneath him"},{"id":"semetey-1-2013:p0930:b004:l035","ordinal":147217,"en":"Was Abyke's peerless steed."},{"id":"semetey-1-2013:p0930:b004:l036","ordinal":147218,"en":"What he held in his hand"},{"id":"semetey-1-2013:p0930:b004:l037","ordinal":147219,"en":"Was Almambet's Oikuma;"},{"id":"semetey-1-2013:p0930:b004:l038","ordinal":147220,"en":"What he slung upon his broad shoulder"},{"id":"semetey-1-2013:p0930:b004:l039","ordinal":147221,"en":"Was Almambet's Syrbaran."},{"id":"semetey-1-2013:p0931:b003:l001","ordinal":147222,"en":"Choro broke away in a frenzy,"},{"id":"semetey-1-2013:p0931:b003:l002","ordinal":147223,"en":"And turned toward Chynkozho,"},{"id":"semetey-1-2013:p0931:b003:l003","ordinal":147224,"en":"As though to bring him utterly to his end."},{"id":"semetey-1-2013:p0931:b003:l004","ordinal":147225,"en":"If they let him go, Kozho"},{"id":"semetey-1-2013:p0931:b003:l005","ordinal":147226,"en":"He seemed ready to destroy completely."},{"id":"semetey-1-2013:p0931:b003:l006","ordinal":147227,"en":"When the boy came near,"},{"id":"semetey-1-2013:p0931:b003:l007","ordinal":147228,"en":"Bakai caught and held him."},{"id":"semetey-1-2013:p0931:b003:l008","ordinal":147229,"en":"Keeping him from reaching the hero Kozho,"},{"id":"semetey-1-2013:p0931:b003:l009","ordinal":147230,"en":"Though he struggled like a bereaved wife,"},{"id":"semetey-1-2013:p0931:b003:l010","ordinal":147231,"en":"He intervened and restrained him:"},{"id":"semetey-1-2013:p0931:b003:l011","ordinal":147232,"en":"“My darling Kulchoro!"},{"id":"semetey-1-2013:p0931:b003:l012","ordinal":147233,"en":"After six months of riding, untiring—"},{"id":"semetey-1-2013:p0931:b003:l013","ordinal":147234,"en":"Is such a noble steed not needed?"},{"id":"semetey-1-2013:p0931:b003:l014","ordinal":147235,"en":"To share counsel and confidences,"},{"id":"semetey-1-2013:p0931:b003:l015","ordinal":147236,"en":"Is a kinsman not needed?"},{"id":"semetey-1-2013:p0931:b003:l016","ordinal":147237,"en":"Shygai's son Chynkozho,"},{"id":"semetey-1-2013:p0931:b003:l017","ordinal":147238,"en":"Kozho is capable in all he does."},{"id":"semetey-1-2013:p0931:b003:l018","ordinal":147239,"en":"Be patient, my Choro, be patient."},{"id":"semetey-1-2013:p0931:b003:l019","ordinal":147240,"en":"Can a man who fights prosper?"},{"id":"semetey-1-2013:p0931:b003:l020","ordinal":147241,"en":"Can those who battle fare well?"},{"id":"semetey-1-2013:p0931:b003:l021","ordinal":147242,"en":"Every stain will cling to you."},{"id":"semetey-1-2013:p0931:b003:l022","ordinal":147243,"en":"My gray-maned Choro, hear my words:"},{"id":"semetey-1-2013:p0931:b003:l023","ordinal":147244,"en":"Where else will elder and younger brothers be found?”"},{"id":"semetey-1-2013:p0931:b003:l024","ordinal":147245,"en":"Traveling toward Talas,"},{"id":"semetey-1-2013:p0931:b003:l025","ordinal":147246,"en":"Around the spur of Kebez-Too,"},{"id":"semetey-1-2013:p0931:b003:l026","ordinal":147247,"en":"Past its jutting headland,"},{"id":"semetey-1-2013:p0931:b003:l027","ordinal":147248,"en":"On the rise covered with fescue,"},{"id":"semetey-1-2013:p0931:b003:l029","ordinal":147249,"en":"With smoke spreading in the sky,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0931:b003:l030","ordinal":147250,"en":"Yellow-mottled like starlings,"},{"id":"semetey-1-2013:p0931:b003:l031","ordinal":147251,"en":"Chynkozho's great horse herd"},{"id":"semetey-1-2013:p0931:b003:l032","ordinal":147252,"en":"Appeared along the road."},{"id":"semetey-1-2013:p0931:b003:l033","ordinal":147253,"en":"Kulchoro, born a gray-maned hero,"},{"id":"semetey-1-2013:p0931:b003:l034","ordinal":147254,"en":"Felt his heart stirred."},{"id":"semetey-1-2013:p0931:b003:l035","ordinal":147255,"en":"Kulchoro and Kanchoro,"},{"id":"semetey-1-2013:p0931:b003:l036","ordinal":147256,"en":"Complete in every way,"},{"id":"semetey-1-2013:p0931:b003:l037","ordinal":147257,"en":"Truly took after their fathers."},{"id":"semetey-1-2013:p0931:b003:l038","ordinal":147258,"en":"Except for the weight of his sacred might,"},{"id":"semetey-1-2013:p0931:b003:l039","ordinal":147259,"en":"They were greater heroes than Semetey."},{"id":"semetey-1-2013:p0931:b005:l001","ordinal":147260,"en":"Turning toward the great horse herd,"},{"id":"semetey-1-2013:p0931:b005:l002","ordinal":147261,"en":"Raising shrill cries and clamor,"},{"id":"semetey-1-2013:p0931:b005:l003","ordinal":147262,"en":"Beating the war drum,"},{"id":"semetey-1-2013:p0931:b005:l004","ordinal":147263,"en":"With the painted musket and blue musket"},{"id":"semetey-1-2013:p0931:b005:l005","ordinal":147264,"en":"The two fired in turn."},{"id":"semetey-1-2013:p0931:b005:l006","ordinal":147265,"en":"Their thunder deafened the ears."},{"id":"semetey-1-2013:p0931:b005:l007","ordinal":147266,"en":"Chynkozho's horses"},{"id":"semetey-1-2013:p0931:b005:l008","ordinal":147267,"en":"All stampeded with a roar."},{"id":"semetey-1-2013:p0931:b005:l009","ordinal":147268,"en":"Through the center Ormonbek"},{"id":"semetey-1-2013:p0931:b005:l010","ordinal":147269,"en":"Carved a way, driving them in a scattering rush."},{"id":"semetey-1-2013:p0931:b005:l011","ordinal":147270,"en":"From the right the companions"},{"id":"semetey-1-2013:p0931:b005:l012","ordinal":147271,"en":"Raised “Manas!” as their battle cry."},{"id":"semetey-1-2013:p0931:b005:l013","ordinal":147272,"en":"The weak, stunted foals and yearlings,"},{"id":"semetey-1-2013:p0931:b005:l014","ordinal":147273,"en":"Beyond broad Kashgar,"},{"id":"semetey-1-2013:p0931:b005:l015","ordinal":147274,"en":"They slaughtered on the bare ground."},{"id":"semetey-1-2013:p0931:b005:l016","ordinal":147275,"en":"Making the mares toss their heads,"},{"id":"semetey-1-2013:p0931:b005:l018","ordinal":147276,"en":"The slow-moving yearlings and foals","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0931:b005:l019","ordinal":147277,"en":"They slaughtered upon the steppe."},{"id":"semetey-1-2013:p0931:b005:l020","ordinal":147278,"en":"The sleek mares"},{"id":"semetey-1-2013:p0931:b005:l021","ordinal":147279,"en":"They drove away without their young."},{"id":"semetey-1-2013:p0931:b005:l022","ordinal":147280,"en":"Shygai's son Kozho's"},{"id":"semetey-1-2013:p0931:b005:l023","ordinal":147281,"en":"Horses they took away,"},{"id":"semetey-1-2013:p0931:b005:l024","ordinal":147282,"en":"And drove sleep from his eyes."},{"id":"semetey-1-2013:p0931:b005:l025","ordinal":147283,"en":"Then Shygai's son Chynkozho—"},{"id":"semetey-1-2013:p0931:b005:l026","ordinal":147284,"en":"What could dear Kozho do?"},{"id":"semetey-1-2013:p0931:b005:l027","ordinal":147285,"en":"Wishing to die, he could not die;"},{"id":"semetey-1-2013:p0931:b005:l028","ordinal":147286,"en":"Kozho could not take his own life."},{"id":"semetey-1-2013:p0931:b005:l029","ordinal":147287,"en":"When he came out in fury,"},{"id":"semetey-1-2013:p0931:b005:l030","ordinal":147288,"en":"The tethered Black Horse—"},{"id":"semetey-1-2013:p0931:b005:l031","ordinal":147289,"en":"The raging slave Kulchoro"},{"id":"semetey-1-2013:p0931:b005:l032","ordinal":147290,"en":"Had cut its ear,"},{"id":"semetey-1-2013:p0931:b005:l033","ordinal":147291,"en":"And put Ogoy's notched earmark upon it."},{"id":"semetey-1-2013:p0931:b005:l034","ordinal":147292,"en":"He came to the pasture: there were no horses."},{"id":"semetey-1-2013:p0931:b005:l035","ordinal":147293,"en":"“He has brought utter ruin now;"},{"id":"semetey-1-2013:p0931:b005:l036","ordinal":147294,"en":"He has raided them all."},{"id":"semetey-1-2013:p0931:b005:l037","ordinal":147295,"en":"He has inflicted terrible suffering."},{"id":"semetey-1-2013:p0931:b005:l038","ordinal":147296,"en":"The Chinese killed his father,"},{"id":"semetey-1-2013:p0931:b005:l039","ordinal":147297,"en":"And he has taken revenge upon me."},{"id":"semetey-1-2013:p0932:b003:l001","ordinal":147298,"en":"My mares like white gulls"},{"id":"semetey-1-2013:p0932:b003:l002","ordinal":147299,"en":"He has let Khan Bakai raid."},{"id":"semetey-1-2013:p0932:b003:l003","ordinal":147300,"en":"The Black Horse no lasso could touch"},{"id":"semetey-1-2013:p0932:b003:l004","ordinal":147301,"en":"He has let slaves ride bareback."},{"id":"semetey-1-2013:p0932:b003:l005","ordinal":147302,"en":"I have suffered such humiliation!"},{"id":"semetey-1-2013:p0932:b003:l006","ordinal":147303,"en":"I shall bring utter ruin upon him."},{"id":"semetey-1-2013:p0932:b003:l007","ordinal":147304,"en":"The Zhediger's hero Toltoy—"},{"id":"semetey-1-2013:p0932:b003:l008","ordinal":147305,"en":"I shall go and join him."},{"id":"semetey-1-2013:p0932:b003:l009","ordinal":147306,"en":"His bloodthirsty father Manas—"},{"id":"semetey-1-2013:p0932:b003:l010","ordinal":147307,"en":"This hand of mine deceived him six times."},{"id":"semetey-1-2013:p0932:b003:l011","ordinal":147308,"en":"Fighting and shooting in earnest,"},{"id":"semetey-1-2013:p0932:b003:l012","ordinal":147309,"en":"I shall bring utter ruin upon him."},{"id":"semetey-1-2013:p0932:b003:l013","ordinal":147310,"en":"The Zhediger's Toltoy,"},{"id":"semetey-1-2013:p0932:b003:l014","ordinal":147311,"en":"From the countless troops that bend the earth,"},{"id":"semetey-1-2013:p0932:b003:l015","ordinal":147312,"en":"I shall go and gather to my side."},{"id":"semetey-1-2013:p0932:b003:l016","ordinal":147313,"en":"To Temir Khan's city"},{"id":"semetey-1-2013:p0932:b003:l017","ordinal":147314,"en":"The orphan wandered away—"},{"id":"semetey-1-2013:p0932:b003:l018","ordinal":147315,"en":"I shall sweep across all the Afghan land,"},{"id":"semetey-1-2013:p0932:b003:l019","ordinal":147316,"en":"And seize his wife."},{"id":"semetey-1-2013:p0932:b003:l020","ordinal":147317,"en":"Until the swaying stalks ripen,"},{"id":"semetey-1-2013:p0932:b003:l021","ordinal":147318,"en":"Until the autumn gossamer flies,"},{"id":"semetey-1-2013:p0932:b003:l022","ordinal":147319,"en":"Fighting firmly for six months,"},{"id":"semetey-1-2013:p0932:b003:l023","ordinal":147320,"en":"Thus I shall bring him to his end."},{"id":"semetey-1-2013:p0932:b003:l024","ordinal":147321,"en":"That fool, the son of Manas—"},{"id":"semetey-1-2013:p0932:b003:l025","ordinal":147322,"en":"Akun Khan was his father-in-law;"},{"id":"semetey-1-2013:p0932:b003:l026","ordinal":147323,"en":"Aichurok was his wife."},{"id":"semetey-1-2013:p0932:b003:l027","ordinal":147324,"en":"I shall sweep into the Afghan land,"},{"id":"semetey-1-2013:p0932:b003:l028","ordinal":147325,"en":"And bring a day of misery."},{"id":"semetey-1-2013:p0932:b003:l029","ordinal":147326,"en":"The bloodthirsty hero's orphan son—"},{"id":"semetey-1-2013:p0932:b003:l030","ordinal":147327,"en":"I shall seize his wife."},{"id":"semetey-1-2013:p0932:b003:l031","ordinal":147328,"en":"To Toltoy of the Zhediger"},{"id":"semetey-1-2013:p0932:b003:l032","ordinal":147329,"en":"I shall go and pitch my camp."},{"id":"semetey-1-2013:p0932:b003:l033","ordinal":147330,"en":"Fighting for seven years without pause,"},{"id":"semetey-1-2013:p0932:b003:l034","ordinal":147331,"en":"I shall slaughter Semetey!"},{"id":"semetey-1-2013:p0932:b003:l035","ordinal":147332,"en":"Bagysh's son Toltoy"},{"id":"semetey-1-2013:p0932:b003:l036","ordinal":147333,"en":"I shall fasten at my waist as support."},{"id":"semetey-1-2013:p0932:b003:l037","ordinal":147334,"en":"The orphan who thinks himself a champion"},{"id":"semetey-1-2013:p0932:b003:l038","ordinal":147335,"en":"I shall slaughter with his slaves."},{"id":"semetey-1-2013:p0932:b003:l039","ordinal":147336,"en":"Shattering his stone fortress,"},{"id":"semetey-1-2013:p0932:b004:l001","ordinal":147337,"en":"I shall raid it utterly."},{"id":"semetey-1-2013:p0932:b004:l002","ordinal":147338,"en":"I shall bring devastation,"},{"id":"semetey-1-2013:p0932:b004:l003","ordinal":147339,"en":"Shatter his great multitude,"},{"id":"semetey-1-2013:p0932:b004:l004","ordinal":147340,"en":"And sweep down in a raid."},{"id":"semetey-1-2013:p0932:b004:l005","ordinal":147341,"en":"Pitching my camp beside Toltoy,"},{"id":"semetey-1-2013:p0932:b004:l006","ordinal":147342,"en":"Stirring the stars in heaven,"},{"id":"semetey-1-2013:p0932:b004:l007","ordinal":147343,"en":"Becoming friends unto the next world,"},{"id":"semetey-1-2013:p0932:b004:l008","ordinal":147344,"en":"Tying our horses' tails for battle,"},{"id":"semetey-1-2013:p0932:b004:l009","ordinal":147345,"en":"Driving our foes this way and that,"},{"id":"semetey-1-2013:p0932:b004:l010","ordinal":147346,"en":"Until the blazing heat retreats,"},{"id":"semetey-1-2013:p0932:b004:l011","ordinal":147347,"en":"Until the people move to lower lands,"},{"id":"semetey-1-2013:p0932:b004:l012","ordinal":147348,"en":"I shall fight without tiring."},{"id":"semetey-1-2013:p0932:b004:l013","ordinal":147349,"en":"From Manas's fugitive son"},{"id":"semetey-1-2013:p0932:b004:l014","ordinal":147350,"en":"Thus I shall take revenge!"},{"id":"semetey-1-2013:p0932:b004:l015","ordinal":147351,"en":"I have heard news from those who came."},{"id":"semetey-1-2013:p0932:b004:l016","ordinal":147352,"en":"When he returned this way,"},{"id":"semetey-1-2013:p0932:b004:l017","ordinal":147353,"en":"When he moved from Bukhara toward us,"},{"id":"semetey-1-2013:p0932:b004:l018","ordinal":147354,"en":"She was the hero Toltoy's wife:"},{"id":"semetey-1-2013:p0932:b004:l019","ordinal":147355,"en":"Shah Temir's Chachykei,"},{"id":"semetey-1-2013:p0932:b004:l020","ordinal":147356,"en":"I heard Semetey took her."},{"id":"semetey-1-2013:p0932:b004:l021","ordinal":147357,"en":"Would God strike Toltoy down?"},{"id":"semetey-1-2013:p0932:b004:l022","ordinal":147358,"en":"If I stirred him into revolt,"},{"id":"semetey-1-2013:p0932:b004:l023","ordinal":147359,"en":"Unless Toltoy were utterly wretched,"},{"id":"semetey-1-2013:p0932:b004:l024","ordinal":147360,"en":"Would he refrain from striking back!”"},{"id":"semetey-1-2013:p0932:b004:l025","ordinal":147361,"en":"Kozho moved his camp in fury,"},{"id":"semetey-1-2013:p0932:b004:l026","ordinal":147362,"en":"From his land at Kebez-Too."},{"id":"semetey-1-2013:p0932:b004:l027","ordinal":147363,"en":"An extraordinary strongman, a mighty hero,"},{"id":"semetey-1-2013:p0932:b004:l028","ordinal":147364,"en":"Chynkozho broke away"},{"id":"semetey-1-2013:p0932:b004:l029","ordinal":147365,"en":"From the familiar Oigut people."},{"id":"semetey-1-2013:p0932:b004:l030","ordinal":147366,"en":"What did dear Kozho do?"},{"id":"semetey-1-2013:p0932:b004:l031","ordinal":147367,"en":"He castrated his rams and made them wethers."},{"id":"semetey-1-2013:p0932:b004:l032","ordinal":147368,"en":"He made all his sheep large and fat."},{"id":"semetey-1-2013:p0932:b004:l033","ordinal":147369,"en":"He castrated his stallions and made them geldings."},{"id":"semetey-1-2013:p0932:b004:l034","ordinal":147370,"en":"Kozho swiftly brought suffering."},{"id":"semetey-1-2013:p0932:b004:l035","ordinal":147371,"en":"He castrated his bulls,"},{"id":"semetey-1-2013:p0932:b004:l036","ordinal":147372,"en":"And made them oxen, as you know."},{"id":"semetey-1-2013:p0932:b004:l037","ordinal":147373,"en":"All the subjects in his hands"},{"id":"semetey-1-2013:p0932:b004:l038","ordinal":147374,"en":"He made submit, leaving none out."},{"id":"semetey-1-2013:p0932:b004:l039","ordinal":147375,"en":"He castrated his camel bulls and made them gelded camels."},{"id":"semetey-1-2013:p0933:b003:l001","ordinal":147376,"en":"He left his warriors on foot."},{"id":"semetey-1-2013:p0933:b003:l002","ordinal":147377,"en":"He sold his possessions and turned them into sable pelts."},{"id":"semetey-1-2013:p0933:b003:l003","ordinal":147378,"en":"Taking offense at his kinsman,"},{"id":"semetey-1-2013:p0933:b003:l004","ordinal":147379,"en":"Dear Kozho raged,"},{"id":"semetey-1-2013:p0933:b003:l005","ordinal":147380,"en":"And did things no human would do."},{"id":"semetey-1-2013:p0933:b003:l006","ordinal":147381,"en":"At Kebez-Too were his subjects;"},{"id":"semetey-1-2013:p0933:b003:l007","ordinal":147382,"en":"He had so many people in his hands,"},{"id":"semetey-1-2013:p0933:b003:l008","ordinal":147383,"en":"And all his strongmen were there."},{"id":"semetey-1-2013:p0933:b003:l009","ordinal":147384,"en":"Kozho too was no ordinary hero;"},{"id":"semetey-1-2013:p0933:b003:l010","ordinal":147385,"en":"He had mighty men of many kinds."},{"id":"semetey-1-2013:p0933:b003:l011","ordinal":147386,"en":"Driving them all, Chynkozho said:"},{"id":"semetey-1-2013:p0933:b003:l012","ordinal":147387,"en":"“If Toltoy of the Zhediger"},{"id":"semetey-1-2013:p0933:b003:l013","ordinal":147388,"en":"Will not heed me when I arrive,"},{"id":"semetey-1-2013:p0933:b003:l014","ordinal":147389,"en":"Watch, you great multitude:"},{"id":"semetey-1-2013:p0933:b003:l015","ordinal":147390,"en":"I shall flood his gardens,"},{"id":"semetey-1-2013:p0933:b003:l016","ordinal":147391,"en":"Throw all he has into turmoil,"},{"id":"semetey-1-2013:p0933:b003:l017","ordinal":147392,"en":"And raid it all!"},{"id":"semetey-1-2013:p0933:b003:l018","ordinal":147393,"en":"Think, you great multitude!"},{"id":"semetey-1-2013:p0933:b003:l019","ordinal":147394,"en":"His Talas is no superior land;"},{"id":"semetey-1-2013:p0933:b003:l020","ordinal":147395,"en":"Manas's fugitive is no greater hero than I."},{"id":"semetey-1-2013:p0933:b003:l021","ordinal":147396,"en":"Shygai's son Chynkozho"},{"id":"semetey-1-2013:p0933:b003:l022","ordinal":147397,"en":"Is inferior to none in the world."},{"id":"semetey-1-2013:p0933:b003:l023","ordinal":147398,"en":"If I pitch my camp beside Toltoy"},{"id":"semetey-1-2013:p0933:b003:l024","ordinal":147399,"en":"And do not gather his army,"},{"id":"semetey-1-2013:p0933:b003:l025","ordinal":147400,"en":"If I do not inflict grievous humiliation,"},{"id":"semetey-1-2013:p0933:b003:l026","ordinal":147401,"en":"Better that I had never been born;"},{"id":"semetey-1-2013:p0933:b003:l027","ordinal":147402,"en":"May I die instead of living!”"},{"id":"semetey-1-2013:p0933:b003:l028","ordinal":147403,"en":"Kozho shouted these words,"},{"id":"semetey-1-2013:p0933:b003:l029","ordinal":147404,"en":"Spoke of unheard-of horrors,"},{"id":"semetey-1-2013:p0933:b003:l030","ordinal":147405,"en":"And tormented the peaceful people."},{"id":"semetey-1-2013:p0933:b004:l001","ordinal":147406,"en":"The poor people in his hands—"},{"id":"semetey-1-2013:p0933:b004:l002","ordinal":147407,"en":"He extinguished their burning hearths,"},{"id":"semetey-1-2013:p0933:b004:l003","ordinal":147408,"en":"Made every one of them migrate,"},{"id":"semetey-1-2013:p0933:b004:l004","ordinal":147409,"en":"Drove their beasts into a frenzy,"},{"id":"semetey-1-2013:p0933:b004:l005","ordinal":147410,"en":"And made their girls and women weep."},{"id":"semetey-1-2013:p0933:b004:l006","ordinal":147411,"en":"Chynkozho moved his camp along."},{"id":"semetey-1-2013:p0933:b004:l007","ordinal":147412,"en":"Oppressing them, Chynkozho"},{"id":"semetey-1-2013:p0933:b004:l008","ordinal":147413,"en":"All the great multitude"},{"id":"semetey-1-2013:p0933:b004:l009","ordinal":147414,"en":"Drove before him, towering over them."},{"id":"semetey-1-2013:p0933:b004:l011","ordinal":147415,"en":"He inflicted humiliation upon those people.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0933:b004:l012","ordinal":147416,"en":"Driving them all under guard,"},{"id":"semetey-1-2013:p0933:b004:l013","ordinal":147417,"en":"He migrated for months and years."},{"id":"semetey-1-2013:p0933:b004:l014","ordinal":147418,"en":"To Toltoy of the Zhediger—"},{"id":"semetey-1-2013:p0933:b004:l015","ordinal":147419,"en":"What did dear Kozho do?"},{"id":"semetey-1-2013:p0933:b004:l016","ordinal":147420,"en":"He reached him at last."},{"id":"semetey-1-2013:p0933:b004:l017","ordinal":147421,"en":"Your wrathful Kozho"},{"id":"semetey-1-2013:p0933:b004:l018","ordinal":147422,"en":"Had a black fur cap like a cauldron."},{"id":"semetey-1-2013:p0933:b004:l019","ordinal":147423,"en":"The eighteen thousand worlds"},{"id":"semetey-1-2013:p0933:b004:l020","ordinal":147424,"en":"He had the power to suck dry at once."},{"id":"semetey-1-2013:p0933:b004:l021","ordinal":147425,"en":"Your elder brother, Lord Kozho—"},{"id":"semetey-1-2013:p0933:b004:l022","ordinal":147426,"en":"Look at these deeds of his."},{"id":"semetey-1-2013:p0933:b004:l023","ordinal":147427,"en":"To the Zhediger people,"},{"id":"semetey-1-2013:p0933:b004:l024","ordinal":147428,"en":"A mighty man came, a pillar came."},{"id":"semetey-1-2013:p0933:b004:l025","ordinal":147429,"en":"Of an appearance unlike other mortals,"},{"id":"semetey-1-2013:p0933:b004:l026","ordinal":147430,"en":"The renowned lion Kozho came."},{"id":"semetey-1-2013:p0933:b004:l027","ordinal":147431,"en":"Upon the hero Toltoy's head"},{"id":"semetey-1-2013:p0933:b004:l028","ordinal":147432,"en":"A standard as great as Mount Opol came."},{"id":"semetey-1-2013:p0933:b004:l029","ordinal":147433,"en":"Upon the people's heads"},{"id":"semetey-1-2013:p0933:b004:l030","ordinal":147434,"en":"An unending tumult came."},{"id":"semetey-1-2013:p0934:b004:l001","ordinal":147435,"en":"The great mass of common people"},{"id":"semetey-1-2013:p0934:b004:l002","ordinal":147436,"en":"Spoke these words in sorrow,"},{"id":"semetey-1-2013:p0934:b004:l003","ordinal":147437,"en":"Their white-bearded elders,"},{"id":"semetey-1-2013:p0934:b004:l004","ordinal":147438,"en":"All the Zhediger:"},{"id":"semetey-1-2013:p0934:b004:l005","ordinal":147439,"en":"“He has come as a subject."},{"id":"semetey-1-2013:p0934:b004:l006","ordinal":147440,"en":"The gray-maned hero Kozho"},{"id":"semetey-1-2013:p0934:b004:l007","ordinal":147441,"en":"We have seen with our own eyes,"},{"id":"semetey-1-2013:p0934:b004:l008","ordinal":147442,"en":"That unbeliever full of devils."},{"id":"semetey-1-2013:p0934:b004:l009","ordinal":147443,"en":"The hero Toltoy was mild;"},{"id":"semetey-1-2013:p0934:b004:l010","ordinal":147444,"en":"Kozho will take power,"},{"id":"semetey-1-2013:p0934:b004:l011","ordinal":147445,"en":"And afflict us with incurable sorrow."},{"id":"semetey-1-2013:p0934:b004:l012","ordinal":147446,"en":"Chynkozho has pitched his camp."},{"id":"semetey-1-2013:p0934:b004:l013","ordinal":147447,"en":"If you live, you will see:"},{"id":"semetey-1-2013:p0934:b004:l014","ordinal":147448,"en":"He will devise many reckonings,"},{"id":"semetey-1-2013:p0934:b004:l015","ordinal":147449,"en":"And shake much dust out of us."},{"id":"semetey-1-2013:p0934:b004:l016","ordinal":147450,"en":"We were a thoroughly peaceful people."},{"id":"semetey-1-2013:p0934:b004:l017","ordinal":147451,"en":"That accursed Chynkozho,"},{"id":"semetey-1-2013:p0934:b004:l018","ordinal":147452,"en":"Bullying and driving us onward,"},{"id":"semetey-1-2013:p0934:b004:l019","ordinal":147453,"en":"Will slaughter us to the last."},{"id":"semetey-1-2013:p0934:b004:l020","ordinal":147454,"en":"May he sink into the earth! Will he not"},{"id":"semetey-1-2013:p0934:b004:l021","ordinal":147455,"en":"Bear the guilt for these people?"},{"id":"semetey-1-2013:p0934:b004:l022","ordinal":147456,"en":"Have you seen Kozho?"}]
