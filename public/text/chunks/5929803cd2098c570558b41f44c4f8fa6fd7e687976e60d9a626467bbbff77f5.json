[{"id":"sayakbay-ms-current145:pdf041:l016","ordinal":396289,"en":"If the enemy came in force behind shields,"},{"id":"sayakbay-ms-current145:pdf041:l017","ordinal":396290,"en":"Even in numbers they could not take him,"},{"id":"sayakbay-ms-current145:pdf041:l018","ordinal":396291,"en":"If many set upon him from behind,"},{"id":"sayakbay-ms-current145:pdf041:l019","ordinal":396292,"en":"Why would you not go straight at them?"},{"id":"sayakbay-ms-current145:pdf041:l020","ordinal":396293,"en":"He was of a fierce disposition,"},{"id":"sayakbay-ms-current145:pdf041:l021","ordinal":396294,"en":"In battle he would brook no distinction,"},{"id":"sayakbay-ms-current145:pdf041:l022","ordinal":396295,"en":"I shall know you well,"},{"id":"sayakbay-ms-current145:pdf041:l023","ordinal":396296,"en":"When I speak, my words are clear,"},{"id":"sayakbay-ms-current145:pdf041:l024","ordinal":396297,"en":"In this world, keen-sighted,"},{"id":"sayakbay-ms-current145:pdf041:l025","ordinal":396298,"en":"By his father’s measure, the warrior is lofty,"},{"id":"sayakbay-ms-current145:pdf041:l026","ordinal":396299,"en":"Now his manifest strength,"},{"id":"sayakbay-ms-current145:pdf041:l027","ordinal":396300,"en":"If the thoroughbred came against the foe,"},{"id":"sayakbay-ms-current145:pdf041:l028","ordinal":396301,"en":"Now to scatter the white bellies,"},{"id":"sayakbay-ms-current145:pdf041:l029","ordinal":396302,"en":"Seeing his majesty, they were frightened,"},{"id":"sayakbay-ms-current145:pdf041:l030","ordinal":396303,"en":"When I looked at his two eyes,"},{"id":"sayakbay-ms-current145:pdf041:l031","ordinal":396304,"en":"They were like pits dug in the open field,"},{"id":"sayakbay-ms-current145:pdf041:l032","ordinal":396305,"en":"When I looked at his nose,"},{"id":"sayakbay-ms-current145:pdf042:l001","ordinal":396306,"en":"Like the slope of a rugged mountain,"},{"id":"sayakbay-ms-current145:pdf042:l002","ordinal":396307,"en":"His two eyes were exceptional,"},{"id":"sayakbay-ms-current145:pdf042:l003","ordinal":396308,"en":"His two sides were like bedding laid out,"},{"id":"sayakbay-ms-current145:pdf042:l004","ordinal":396309,"en":"His ribs were a solid shield,"},{"id":"sayakbay-ms-current145:pdf042:l005","ordinal":396310,"en":"The hero’s aspect was like a broad hollow."},{"id":"sayakbay-ms-current145:pdf042:l006","ordinal":396311,"en":"No crow dared confront him,"},{"id":"sayakbay-ms-current145:pdf042:l007","ordinal":396312,"en":"No croaking raven flew there,"},{"id":"sayakbay-ms-current145:pdf042:l008","ordinal":396313,"en":"It became a desert that boiled the brain,"},{"id":"sayakbay-ms-current145:pdf042:l009","ordinal":396314,"en":"It became land they had traversed,"},{"id":"sayakbay-ms-current145:pdf042:l010","ordinal":396315,"en":"They grappled in a great struggle,"},{"id":"sayakbay-ms-current145:pdf042:l011","ordinal":396316,"en":"They remained warm-backed,"},{"id":"sayakbay-ms-current145:pdf042:l012","ordinal":396317,"en":"Taking a giant as vast as ninety tracts,"},{"id":"sayakbay-ms-current145:pdf042:l013","ordinal":396318,"en":"Twisting about, unable to find a way,"},{"id":"sayakbay-ms-current145:pdf042:l014","ordinal":396319,"en":"Like a poor, bewildered child,"},{"id":"sayakbay-ms-current145:pdf042:l015","ordinal":396320,"en":"Seeing the bay horse’s fat as a coat,"},{"id":"sayakbay-ms-current145:pdf042:l016","ordinal":396321,"en":"Ak Joltoy proved superior,"},{"id":"sayakbay-ms-current145:pdf042:l017","ordinal":396322,"en":"Every part of him was like a host of troops,"},{"id":"sayakbay-ms-current145:pdf042:l018","ordinal":396323,"en":"The wicked giant [?],"},{"id":"sayakbay-ms-current145:pdf042:l019","ordinal":396324,"en":"The mace tore across his face,"},{"id":"sayakbay-ms-current145:pdf042:l020","ordinal":396325,"en":"That warrior Ak Joltoy,"},{"id":"sayakbay-ms-current145:pdf042:l021","ordinal":396326,"en":"Without yielding beneath the sun,"},{"id":"sayakbay-ms-current145:pdf042:l022","ordinal":396327,"en":"Fighting day and night,"},{"id":"sayakbay-ms-current145:pdf042:l023","ordinal":396328,"en":"Shouting, those champions mounted,"},{"id":"sayakbay-ms-current145:pdf042:l024","ordinal":396329,"en":"Joltoy had fallen behind,"},{"id":"sayakbay-ms-current145:pdf042:l025","ordinal":396330,"en":"The many horses taken from the Burut,"},{"id":"sayakbay-ms-current145:pdf042:l026","ordinal":396331,"en":"He had stayed there guarding them without leaving,"},{"id":"sayakbay-ms-current145:pdf042:l027","ordinal":396332,"en":"With the prosperous household,"},{"id":"sayakbay-ms-current145:pdf042:l028","ordinal":396333,"en":"With the unfortunate hero Kairy,"},{"id":"sayakbay-ms-current145:pdf042:l029","ordinal":396334,"en":"With the mighty champion-warrior,"},{"id":"sayakbay-ms-current145:pdf042:l030","ordinal":396335,"en":"They had continued without being able to prevail,"},{"id":"sayakbay-ms-current145:pdf042:l031","ordinal":396336,"en":"Preparing Jardyger’s army,"},{"id":"sayakbay-ms-current145:pdf042:l032","ordinal":396337,"en":"The champion Jayy was there,"},{"id":"sayakbay-ms-current145:pdf042:l033","ordinal":396338,"en":"The hero’s valiant son arrived,"},{"id":"sayakbay-ms-current145:pdf043:l001","ordinal":396339,"en":"Kulansur and Kuluker"},{"id":"sayakbay-ms-current145:pdf043:l002","ordinal":396340,"en":"The charger had suffered"},{"id":"sayakbay-ms-current145:pdf043:l003","ordinal":396341,"en":"For four days without rest"},{"id":"sayakbay-ms-current145:pdf043:l004","ordinal":396342,"en":"Sitting after making one victory known"},{"id":"sayakbay-ms-current145:pdf043:l005","ordinal":396343,"en":"If the separated thousands were true"},{"id":"sayakbay-ms-current145:pdf043:l006","ordinal":396344,"en":"Saying he passed ahead of them"},{"id":"sayakbay-ms-current145:pdf043:l007","ordinal":396345,"en":"The two chargers surged"},{"id":"sayakbay-ms-current145:pdf043:l008","ordinal":396346,"en":"The horses’ labor numbered in thousands"},{"id":"sayakbay-ms-current145:pdf043:l009","ordinal":396347,"en":"Straining along the road"},{"id":"sayakbay-ms-current145:pdf043:l010","ordinal":396348,"en":"If the road led toward China"},{"id":"sayakbay-ms-current145:pdf043:l011","ordinal":396349,"en":"He led the road without delay"},{"id":"sayakbay-ms-current145:pdf043:l012","ordinal":396350,"en":"Against the mass of enemies"},{"id":"sayakbay-ms-current145:pdf043:l013","ordinal":396351,"en":"His people were separated between them"},{"id":"sayakbay-ms-current145:pdf043:l014","ordinal":396352,"en":"He returned again to Talas"},{"id":"sayakbay-ms-current145:pdf043:l015","ordinal":396353,"en":"Keeping the court and becoming khan"},{"id":"sayakbay-ms-current145:pdf043:l016","ordinal":396354,"en":"Alive in thirty places"},{"id":"sayakbay-ms-current145:pdf043:l017","ordinal":396355,"en":"Taking a letter from the Kalmyks"},{"id":"sayakbay-ms-current145:pdf043:l018","ordinal":396356,"en":"Traveling through many lands"},{"id":"sayakbay-ms-current145:pdf043:l019","ordinal":396357,"en":"His thoughts divided among the people"},{"id":"sayakbay-ms-current145:pdf043:l020","ordinal":396358,"en":"He was named the hero Kenen"},{"id":"sayakbay-ms-current145:pdf043:l021","ordinal":396359,"en":"Pouring blood into the black water"},{"id":"sayakbay-ms-current145:pdf043:l022","ordinal":396360,"en":"Setting fire to the land of booty"},{"id":"sayakbay-ms-current145:pdf043:l023","ordinal":396361,"en":"Traveling and gathering lions"},{"id":"sayakbay-ms-current145:pdf043:l024","ordinal":396362,"en":"The Chinese awaited warriors"},{"id":"sayakbay-ms-current145:pdf043:l025","ordinal":396363,"en":"Counting their strength, they broke apart"},{"id":"sayakbay-ms-current145:pdf043:l026","ordinal":396364,"en":"Their countless treasure was exhausted"},{"id":"sayakbay-ms-current145:pdf043:l027","ordinal":396365,"en":"Sating them with yellow gold"},{"id":"sayakbay-ms-current145:pdf043:l028","ordinal":396366,"en":"Enriching them with brown horses"},{"id":"sayakbay-ms-current145:pdf043:l029","ordinal":396367,"en":"All that belonged to Kulansur"},{"id":"sayakbay-ms-current145:pdf043:l030","ordinal":396368,"en":"Mounting the blue Altai horse"},{"id":"sayakbay-ms-current145:pdf043:l031","ordinal":396369,"en":"Keeping the charger ready"},{"id":"sayakbay-ms-current145:pdf043:l032","ordinal":396370,"en":"Becoming known to the ancestral people"},{"id":"sayakbay-ms-current145:pdf044:l001","ordinal":396371,"en":"Would any person face him"},{"id":"sayakbay-ms-current145:pdf044:l004","ordinal":396372,"en":"When mighty Kiten heard this"},{"id":"sayakbay-ms-current145:pdf044:l005","ordinal":396373,"en":"After hearing news from Bilgich"},{"id":"sayakbay-ms-current145:pdf044:l006","ordinal":396374,"en":"His eyes filled with tears"},{"id":"sayakbay-ms-current145:pdf044:l007","ordinal":396375,"en":"Gathering the Kalmyks and preparing"},{"id":"sayakbay-ms-current145:pdf044:l008","ordinal":396376,"en":"It was a grief to thousands"},{"id":"sayakbay-ms-current145:pdf044:l009","ordinal":396377,"en":"The people were pledged to sorrow"},{"id":"sayakbay-ms-current145:pdf044:l010","ordinal":396378,"en":"When several years had passed"},{"id":"sayakbay-ms-current145:pdf044:l011","ordinal":396379,"en":"From Kakan who ruled the Chinese"},{"id":"sayakbay-ms-current145:pdf044:l012","ordinal":396380,"en":"Gathering his great host"},{"id":"sayakbay-ms-current145:pdf044:l013","ordinal":396381,"en":"Of the Chinese in motley coats"},{"id":"sayakbay-ms-current145:pdf044:l014","ordinal":396382,"en":"A harsh burden befell them"},{"id":"sayakbay-ms-current145:pdf044:l015","ordinal":396383,"en":"Against the wretched Burut"},{"id":"sayakbay-ms-current145:pdf044:l016","ordinal":396384,"en":"To bring about his end"},{"id":"sayakbay-ms-current145:pdf044:l017","ordinal":396385,"en":"No man could reach him"},{"id":"sayakbay-ms-current145:pdf044:l018","ordinal":396386,"en":"A tiger descended to play"},{"id":"sayakbay-ms-current145:pdf044:l019","ordinal":396387,"en":"No warrior dared go"},{"id":"sayakbay-ms-current145:pdf044:l020","ordinal":396388,"en":"No warrior remained on the march"},{"id":"sayakbay-ms-current145:pdf044:l021","ordinal":396389,"en":"Give account to all Beijing"},{"id":"sayakbay-ms-current145:pdf044:l022","ordinal":396390,"en":"You will take the great bellows"},{"id":"sayakbay-ms-current145:pdf044:l023","ordinal":396391,"en":"With a horse swift as the moon"},{"id":"sayakbay-ms-current145:pdf044:l024","ordinal":396392,"en":"He had a messenger found"},{"id":"sayakbay-ms-current145:pdf044:l025","ordinal":396393,"en":"Forty thousand of Beijing"},{"id":"sayakbay-ms-current145:pdf044:l026","ordinal":396394,"en":"He had the great gate opened"},{"id":"sayakbay-ms-current145:pdf044:l027","ordinal":396395,"en":"To populous Beijing"},{"id":"sayakbay-ms-current145:pdf044:l028","ordinal":396396,"en":"Let us send the true report"},{"id":"sayakbay-ms-current145:pdf044:l029","ordinal":396397,"en":"The widowed women fixed their eyes"},{"id":"sayakbay-ms-current145:pdf044:l030","ordinal":396398,"en":"Let us proclaim it through Beijing"},{"id":"sayakbay-ms-current145:pdf044:l031","ordinal":396399,"en":"Frightening all the people"},{"id":"sayakbay-ms-current145:pdf044:l032","ordinal":396400,"en":"From the force hidden from sight"},{"id":"sayakbay-ms-current145:pdf044:l033","ordinal":396401,"en":"His court turned to ruin"},{"id":"sayakbay-ms-current145:pdf045:l001","ordinal":396402,"en":"Without sparing the women of Kakan"},{"id":"sayakbay-ms-current145:pdf045:l002","ordinal":396403,"en":"From where arrows flew by tens"},{"id":"sayakbay-ms-current145:pdf045:l003","ordinal":396404,"en":"Leaving no maiden in Beijing"},{"id":"sayakbay-ms-current145:pdf045:l004","ordinal":396405,"en":"Let us gather the thousands around"},{"id":"sayakbay-ms-current145:pdf045:l005","ordinal":396406,"en":"If they are not satisfied by the spoken word"},{"id":"sayakbay-ms-current145:pdf045:l006","ordinal":396407,"en":"If they do not yield before it"},{"id":"sayakbay-ms-current145:pdf045:l007","ordinal":396408,"en":"Forty tribes from forty thousand"},{"id":"sayakbay-ms-current145:pdf045:l008","ordinal":396409,"en":"Purifying it every dawn"},{"id":"sayakbay-ms-current145:pdf045:l009","ordinal":396410,"en":"To sit upon the throne"},{"id":"sayakbay-ms-current145:pdf045:l010","ordinal":396411,"en":"To rule over the Chinese people"},{"id":"sayakbay-ms-current145:pdf045:l011","ordinal":396412,"en":"What the people knew in the end"},{"id":"sayakbay-ms-current145:pdf045:l012","ordinal":396413,"en":"Let us send word to appoint him"},{"id":"sayakbay-ms-current145:pdf045:l013","ordinal":396414,"en":"More precious than spoken counsel"},{"id":"sayakbay-ms-current145:pdf045:l014","ordinal":396415,"en":"Let us send news that it was given"},{"id":"sayakbay-ms-current145:pdf045:l015","ordinal":396416,"en":"The two disputed these words"},{"id":"sayakbay-ms-current145:pdf045:l016","ordinal":396417,"en":"Let us send news of the booty"},{"id":"sayakbay-ms-current145:pdf045:l017","ordinal":396418,"en":"To all Chinese Beijing"},{"id":"sayakbay-ms-current145:pdf045:l018","ordinal":396419,"en":"Let us send word that he shall settle"},{"id":"sayakbay-ms-current145:pdf045:l019","ordinal":396420,"en":"A khan’s decree is not twofold"},{"id":"sayakbay-ms-current145:pdf045:l020","ordinal":396421,"en":"What the Kalmyk gave"},{"id":"sayakbay-ms-current145:pdf045:l021","ordinal":396422,"en":"Let us report the booty"},{"id":"sayakbay-ms-current145:pdf045:l022","ordinal":396423,"en":"The oath arose from this deed"},{"id":"sayakbay-ms-current145:pdf045:l023","ordinal":396424,"en":"In this land of Beijing"},{"id":"sayakbay-ms-current145:pdf045:l024","ordinal":396425,"en":"Leaving no unbridled colt"},{"id":"sayakbay-ms-current145:pdf045:l025","ordinal":396426,"en":"Let the lords issue a decree"},{"id":"sayakbay-ms-current145:pdf045:l026","ordinal":396427,"en":"The celebration of the Chinese"},{"id":"sayakbay-ms-current145:pdf045:l027","ordinal":396428,"en":"Belonged to the watched women"},{"id":"sayakbay-ms-current145:pdf045:l028","ordinal":396429,"en":"Great Beijing with forty barriers"},{"id":"sayakbay-ms-current145:pdf045:l029","ordinal":396430,"en":"The elder authority of Kakan"},{"id":"sayakbay-ms-current145:pdf045:l030","ordinal":396431,"en":"Let forty thousand set out"},{"id":"sayakbay-ms-current145:pdf045:l031","ordinal":396432,"en":"To approach those who came"},{"id":"sayakbay-ms-current145:pdf046:l001","ordinal":396433,"en":"The angered soul took hold"},{"id":"sayakbay-ms-current145:pdf046:l002","ordinal":396434,"en":"Leading his people for forty days"},{"id":"sayakbay-ms-current145:pdf046:l003","ordinal":396435,"en":"Throwing the whole age into uproar"},{"id":"sayakbay-ms-current145:pdf046:l004","ordinal":396436,"en":"Against the wretched Burut"},{"id":"sayakbay-ms-current145:pdf046:l005","ordinal":396437,"en":"To wage the bloody struggle"},{"id":"sayakbay-ms-current145:pdf046:l006","ordinal":396438,"en":"To take up the moving arrow"},{"id":"sayakbay-ms-current145:pdf046:l007","ordinal":396439,"en":"To drive him to the root"},{"id":"sayakbay-ms-current145:pdf046:l008","ordinal":396440,"en":"Kakan raged in his wrath"},{"id":"sayakbay-ms-current145:pdf046:l009","ordinal":396441,"en":"Having the judges examine them"},{"id":"sayakbay-ms-current145:pdf046:l010","ordinal":396442,"en":"Having weapons fitted by the lattice wall"},{"id":"sayakbay-ms-current145:pdf046:l011","ordinal":396443,"en":"Having them lie beside the herdsman"},{"id":"sayakbay-ms-current145:pdf046:l012","ordinal":396444,"en":"Those deep-rooted Chinese"},{"id":"sayakbay-ms-current145:pdf046:l013","ordinal":396445,"en":"To Beijing’s golden throne"},{"id":"sayakbay-ms-current145:pdf046:l014","ordinal":396446,"en":"Guarding it so no soul approached"},{"id":"sayakbay-ms-current145:pdf046:l015","ordinal":396447,"en":"Gathering the attendants"},{"id":"sayakbay-ms-current145:pdf046:l016","ordinal":396448,"en":"Having the marriage rite performed"},{"id":"sayakbay-ms-current145:pdf046:l017","ordinal":396449,"en":"Let us destroy all of Kakan"},{"id":"sayakbay-ms-current145:pdf046:l018","ordinal":396450,"en":"If she bears a son from him"},{"id":"sayakbay-ms-current145:pdf046:l019","ordinal":396451,"en":"Let us name him Chyngteñir"},{"id":"sayakbay-ms-current145:pdf046:l020","ordinal":396452,"en":"When Chyngteñir grows up"},{"id":"sayakbay-ms-current145:pdf046:l021","ordinal":396453,"en":"See how mighty he will become"},{"id":"sayakbay-ms-current145:pdf046:l022","ordinal":396454,"en":"The Chinese understood the order"},{"id":"sayakbay-ms-current145:pdf046:l023","ordinal":396455,"en":"He became an orator among the Chinese"},{"id":"sayakbay-ms-current145:pdf046:l024","ordinal":396456,"en":"Blinding those who would not see"},{"id":"sayakbay-ms-current145:pdf046:l025","ordinal":396457,"en":"Setting him over many domains"},{"id":"sayakbay-ms-current145:pdf046:l026","ordinal":396458,"en":"Awakening his burning force"},{"id":"sayakbay-ms-current145:pdf046:l027","ordinal":396459,"en":"Moving him across seven broad rivers"},{"id":"sayakbay-ms-current145:pdf046:l028","ordinal":396460,"en":"Calling together the Chinese host"},{"id":"sayakbay-ms-current145:pdf046:l029","ordinal":396461,"en":"Humbling the people of the white kalpak"},{"id":"sayakbay-ms-current145:pdf046:l030","ordinal":396462,"en":"He turned gently from the valley"},{"id":"sayakbay-ms-current145:pdf046:l031","ordinal":396463,"en":"The Chinese joined together"},{"id":"sayakbay-ms-current145:pdf046:l032","ordinal":396464,"en":"Great Bilgich came to speech"},{"id":"sayakbay-ms-current145:pdf046:l033","ordinal":396465,"en":"His tongue formed these words"},{"id":"sayakbay-ms-current145:pdf047:l001","ordinal":396466,"en":"Know what I have told you"},{"id":"sayakbay-ms-current145:pdf051:l001","ordinal":396467,"en":"In the world arrayed in garments"},{"id":"sayakbay-ms-current145:pdf051:l002","ordinal":396468,"en":"The Chinese opened their eyes"},{"id":"sayakbay-ms-current145:pdf051:l003","ordinal":396469,"en":"Having treasure scattered"},{"id":"sayakbay-ms-current145:pdf051:l004","ordinal":396470,"en":"The souls who had been seized and confined"},{"id":"sayakbay-ms-current145:pdf051:l005","ordinal":396471,"en":"Came forth again"},{"id":"sayakbay-ms-current145:pdf051:l006","ordinal":396472,"en":"Longing for the good"},{"id":"sayakbay-ms-current145:pdf051:l007","ordinal":396473,"en":"The children went to their games"},{"id":"sayakbay-ms-current145:pdf051:l008","ordinal":396474,"en":"Calling Mount Chyng a mighty mountain"},{"id":"sayakbay-ms-current145:pdf051:l009","ordinal":396475,"en":"They cast banners toward the sky"},{"id":"sayakbay-ms-current145:pdf051:l010","ordinal":396476,"en":"Raising his people above other nations"},{"id":"sayakbay-ms-current145:pdf051:l011","ordinal":396477,"en":"Bringing fortune upon his head"},{"id":"sayakbay-ms-current145:pdf051:l012","ordinal":396478,"en":"Rallying his stricken Chinese"},{"id":"sayakbay-ms-current145:pdf051:l013","ordinal":396479,"en":"Saying the lord of Beijing had come"},{"id":"sayakbay-ms-current145:pdf051:l014","ordinal":396480,"en":"Inscribing it in his fortune"},{"id":"sayakbay-ms-current145:pdf051:l015","ordinal":396481,"en":"Ilik, Kiyik, and old souls"},{"id":"sayakbay-ms-current145:pdf051:l022","ordinal":396482,"en":"In the form of a dragon"},{"id":"sayakbay-ms-current145:pdf051:l024","ordinal":396483,"en":"How the Chinese rejoiced"},{"id":"sayakbay-ms-current145:pdf051:l025","ordinal":396484,"en":"In that teeming place"},{"id":"sayakbay-ms-current145:pdf051:l028","ordinal":396485,"en":"A peerless enemy lurked there"},{"id":"sayakbay-ms-current145:pdf051:l029","ordinal":396486,"en":"That was the gleaming well"},{"id":"sayakbay-ms-current145:pdf051:l030","ordinal":396487,"en":"Its poison was fierce"},{"id":"sayakbay-ms-current145:pdf051:l032","ordinal":396488,"en":"Sixty dragon young"},{"id":"sayakbay-ms-current145:pdf051:l033","ordinal":396489,"en":"Dragging six men down from the earth"},{"id":"sayakbay-ms-current145:pdf052:l002","ordinal":396490,"en":"The young child Urumtai"},{"id":"sayakbay-ms-current145:pdf052:l003","ordinal":396491,"en":"The people who committed crimes"},{"id":"sayakbay-ms-current145:pdf052:l004","ordinal":396492,"en":"The dragon would squeeze them"},{"id":"sayakbay-ms-current145:pdf052:l006","ordinal":396493,"en":"Looking upon his daughter like a bead"},{"id":"sayakbay-ms-current145:pdf052:l007","ordinal":396494,"en":"That black camel sat awaiting"},{"id":"sayakbay-ms-current145:pdf052:l008","ordinal":396495,"en":"This well ruled the people"},{"id":"sayakbay-ms-current145:pdf052:l010","ordinal":396496,"en":"It became a ruthless enemy"},{"id":"sayakbay-ms-current145:pdf052:l011","ordinal":396497,"en":"It sucked in long hair"},{"id":"sayakbay-ms-current145:pdf052:l013","ordinal":396498,"en":"Even a strong camel would grow weary"},{"id":"sayakbay-ms-current145:pdf052:l014","ordinal":396499,"en":"They carried them away with a rush"},{"id":"sayakbay-ms-current145:pdf052:l016","ordinal":396500,"en":"Scarcely a person remained"},{"id":"sayakbay-ms-current145:pdf052:l017","ordinal":396501,"en":"Great Teñir over such a people"},{"id":"sayakbay-ms-current145:pdf052:l019","ordinal":396502,"en":"Saying Bural had made him Chinese"},{"id":"sayakbay-ms-current145:pdf052:l020","ordinal":396503,"en":"They seated Teñir on the throne"},{"id":"sayakbay-ms-current145:pdf052:l021","ordinal":396504,"en":"Seven whole souls bowed down"},{"id":"sayakbay-ms-current145:pdf052:l022","ordinal":396505,"en":"Many spoke corrupt words"},{"id":"sayakbay-ms-current145:pdf052:l023","ordinal":396506,"en":"Their eyes looked ominous"},{"id":"sayakbay-ms-current145:pdf052:l024","ordinal":396507,"en":"The lifeless seemed to threaten the living"},{"id":"sayakbay-ms-current145:pdf052:l027","ordinal":396508,"en":"They wrapped and swaddled him"},{"id":"sayakbay-ms-current145:pdf052:l028","ordinal":396509,"en":"Watching over him day by day"},{"id":"sayakbay-ms-current145:pdf052:l029","ordinal":396510,"en":"Saying he would become a surpassing child"},{"id":"sayakbay-ms-current145:pdf052:l030","ordinal":396511,"en":"Cunning as a dragon"},{"id":"sayakbay-ms-current145:pdf052:l031","ordinal":396512,"en":"Saying his body shone brighter than the moon"},{"id":"sayakbay-ms-current145:pdf052:l032","ordinal":396513,"en":"If misfortune should fall upon Kakana"},{"id":"sayakbay-ms-current145:pdf053:l001","ordinal":396514,"en":"The Chinese hero who made all sway"},{"id":"sayakbay-ms-current145:pdf053:l002","ordinal":396515,"en":"None in Beijing could equal him"},{"id":"sayakbay-ms-current145:pdf053:l003","ordinal":396516,"en":"Chyng became their great ruler"},{"id":"sayakbay-ms-current145:pdf053:l004","ordinal":396517,"en":"Chyng Teñir, for whom the people labored"},{"id":"sayakbay-ms-current145:pdf053:l005","ordinal":396518,"en":"Taking tribute from every subject"},{"id":"sayakbay-ms-current145:pdf053:l006","ordinal":396519,"en":"For forty days feeding forty sheep"},{"id":"sayakbay-ms-current145:pdf053:l009","ordinal":396520,"en":"No people could stand against his coming"},{"id":"sayakbay-ms-current145:pdf053:l010","ordinal":396521,"en":"The Chinese people did not avert their gaze"},{"id":"sayakbay-ms-current145:pdf053:l011","ordinal":396522,"en":"The great Chinese spoke among the clans"},{"id":"sayakbay-ms-current145:pdf053:l012","ordinal":396523,"en":"None remained to raise a clamor"},{"id":"sayakbay-ms-current145:pdf053:l016","ordinal":396524,"en":"Became khan from month to month"},{"id":"sayakbay-ms-current145:pdf053:l017","ordinal":396525,"en":"The Kalmyk champion"},{"id":"sayakbay-ms-current145:pdf053:l019","ordinal":396526,"en":"Setting his gain upon the throne"},{"id":"sayakbay-ms-current145:pdf053:l021","ordinal":396527,"en":"Now he would not bend from the straight path"},{"id":"sayakbay-ms-current145:pdf053:l022","ordinal":396528,"en":"No champion could meet his gaze"},{"id":"sayakbay-ms-current145:pdf053:l024","ordinal":396529,"en":"Prevailing across the earth"},{"id":"sayakbay-ms-current145:pdf053:l027","ordinal":396530,"en":"He became a mounted foe"},{"id":"sayakbay-ms-current145:pdf053:l029","ordinal":396531,"en":"The child’s early years passed"},{"id":"sayakbay-ms-current145:pdf053:l030","ordinal":396532,"en":"He brought all Beijing under him"},{"id":"sayakbay-ms-current145:pdf054:l003","ordinal":396533,"en":"Making a home for his white falcon"},{"id":"sayakbay-ms-current145:pdf054:l006","ordinal":396534,"en":"Covering it with precious ornament"},{"id":"sayakbay-ms-current145:pdf054:l007","ordinal":396535,"en":"Driving cattle toward the mountain"},{"id":"sayakbay-ms-current145:pdf054:l009","ordinal":396536,"en":"Digging a pit where baltyrgan grew"},{"id":"sayakbay-ms-current145:pdf054:l010","ordinal":396537,"en":"Plating it in pure gold"},{"id":"sayakbay-ms-current145:pdf054:l011","ordinal":396538,"en":"Having the nobles praise it"},{"id":"sayakbay-ms-current145:pdf054:l013","ordinal":396539,"en":"The open face of the mountain"},{"id":"sayakbay-ms-current145:pdf054:l018","ordinal":396540,"en":"Saying none would remain standing"},{"id":"sayakbay-ms-current145:pdf054:l022","ordinal":396541,"en":"Surrounding its bounds twice"},{"id":"sayakbay-ms-current145:pdf054:l024","ordinal":396542,"en":"So none might come and ruin it"},{"id":"sayakbay-ms-current145:pdf054:l025","ordinal":396543,"en":"O ruthless Chinese people"},{"id":"sayakbay-ms-current145:pdf054:l026","ordinal":396544,"en":"Chyng Teñir, who knew how to command"}]
