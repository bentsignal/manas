[{"id":"manas-2010:p0872:b001:l023","ordinal":38401,"en":"‘Let it pierce when thrust against iron,"},{"id":"manas-2010:p0872:b001:l024","ordinal":38402,"en":"Let it enter without stopping,’ she said."},{"id":"manas-2010:p0872:b001:l025","ordinal":38403,"en":"Shaping the steel like a wolf's tongue,"},{"id":"manas-2010:p0872:b001:l026","ordinal":38404,"en":"She had it joined in separate pieces."},{"id":"manas-2010:p0872:b001:l027","ordinal":38405,"en":"‘Whatever it strikes,"},{"id":"manas-2010:p0872:b001:l028","ordinal":38406,"en":"Let the wound quickly worsen,’ she said."},{"id":"manas-2010:p0872:b001:l029","ordinal":38407,"en":"It was quenched in human tears."},{"id":"manas-2010:p0872:b001:l030","ordinal":38408,"en":"A woman spearing enemies,"},{"id":"manas-2010:p0872:b001:l031","ordinal":38409,"en":"Could there be such a soul,"},{"id":"manas-2010:p0872:b001:l032","ordinal":38410,"en":"Who brought joy to Bukhara's people!"},{"id":"manas-2010:p0872:b001:l033","ordinal":38411,"en":"At that time Kanykey"},{"id":"manas-2010:p0872:b001:l034","ordinal":38412,"en":"Had not yet reached twelve;"},{"id":"manas-2010:p0872:b001:l035","ordinal":38413,"en":"She was still a little girl."},{"id":"manas-2010:p0872:b001:l036","ordinal":38414,"en":"Her hair had not grown beyond its braids."},{"id":"manas-2010:p0872:b001:l037","ordinal":38415,"en":"Had she been a man instead of a woman,"},{"id":"manas-2010:p0872:b001:l038","ordinal":38416,"en":"She would have been among the conquerors,"},{"id":"manas-2010:p0872:b001:l039","ordinal":38417,"en":"Slaughter upon the world,"},{"id":"manas-2010:p0872:b001:l040","ordinal":38418,"en":"She would have been among those who brought it."},{"id":"manas-2010:p0872:b001:l041","ordinal":38419,"en":"A skilled hero fitted for battle,"},{"id":"manas-2010:p0872:b001:l042","ordinal":38420,"en":"Upon Khan Baltay's Chubak,"},{"id":"manas-2010:p0873:b001:l001","ordinal":38421,"en":"She was the lion who would unleash havoc."},{"id":"manas-2010:p0873:b001:l002","ordinal":38422,"en":"Her agility was immeasurable."},{"id":"manas-2010:p0873:b001:l003","ordinal":38423,"en":"When the ill-fated one came forth,"},{"id":"manas-2010:p0873:b001:l004","ordinal":38424,"en":"All Bukhara marveled at her."},{"id":"manas-2010:p0873:b001:l005","ordinal":38425,"en":"Religious lords and teachers together,"},{"id":"manas-2010:p0873:b001:l006","ordinal":38426,"en":"‘Alas, that fierce, ill-fated girl's"},{"id":"manas-2010:p0873:b001:l007","ordinal":38427,"en":"Fate, what will it be?’ they said,"},{"id":"manas-2010:p0873:b001:l008","ordinal":38428,"en":"And stood crowding round to watch."},{"id":"manas-2010:p0873:b001:l009","ordinal":38429,"en":"She bears the name of girl and woman;"},{"id":"manas-2010:p0873:b001:l010","ordinal":38430,"en":"What will the valiant one do!"},{"id":"manas-2010:p0873:b001:l011","ordinal":38431,"en":"‘Being a girl, not a man,"},{"id":"manas-2010:p0873:b001:l012","ordinal":38432,"en":"Will she let herself be dragged from the saddle?"},{"id":"manas-2010:p0873:b001:l013","ordinal":38433,"en":"By that boundlessly mighty warrior,"},{"id":"manas-2010:p0873:b001:l014","ordinal":38434,"en":"Will she let herself be defeated?’ they said."},{"id":"manas-2010:p0873:b001:l015","ordinal":38435,"en":"While the people stood amazed,"},{"id":"manas-2010:p0873:b001:l016","ordinal":38436,"en":"Kanykey's white palace,"},{"id":"manas-2010:p0873:b001:l017","ordinal":38437,"en":"Though the ill-fated one was a girl,"},{"id":"manas-2010:p0873:b001:l018","ordinal":38438,"en":"Her splendor far surpassed many."},{"id":"manas-2010:p0873:b001:l019","ordinal":38439,"en":"Within that palace,"},{"id":"manas-2010:p0873:b001:l020","ordinal":38440,"en":"Magnificently appointed,"},{"id":"manas-2010:p0873:b001:l021","ordinal":38441,"en":"For riding when battle came,"},{"id":"manas-2010:p0873:b001:l022","ordinal":38442,"en":"Sixty wondrous steeds were tethered."},{"id":"manas-2010:p0873:b001:l023","ordinal":38443,"en":"The swiftest of those steeds,"},{"id":"manas-2010:p0873:b001:l024","ordinal":38444,"en":"Which faced Chubak,"},{"id":"manas-2010:p0873:b001:l025","ordinal":38445,"en":"For the city of broad Bukhara,"},{"id":"manas-2010:p0873:b001:l026","ordinal":38446,"en":"Was Kanykey's commotion."},{"id":"manas-2010:p0873:b001:l027","ordinal":38447,"en":"Among those wondrous steeds,"},{"id":"manas-2010:p0873:b001:l028","ordinal":38448,"en":"A black, white-blazed thoroughbred,"},{"id":"manas-2010:p0873:b001:l029","ordinal":38449,"en":"His solid hooves like large bowls,"},{"id":"manas-2010:p0873:b001:l030","ordinal":38450,"en":"Behind him, his croup"},{"id":"manas-2010:p0873:b001:l031","ordinal":38451,"en":"Was like a broad, open plain."},{"id":"manas-2010:p0873:b001:l032","ordinal":38452,"en":"From that unbeliever Kanykey,"},{"id":"manas-2010:p0873:b001:l033","ordinal":38453,"en":"No wisdom could flee and escape,"},{"id":"manas-2010:p0873:b001:l034","ordinal":38454,"en":"From that poor one of surpassing wisdom."},{"id":"manas-2010:p0873:b001:l035","ordinal":38455,"en":"The black, white-blazed thoroughbred"},{"id":"manas-2010:p0873:b001:l036","ordinal":38456,"en":"Was a creature skilled in battle."},{"id":"manas-2010:p0873:b001:l037","ordinal":38457,"en":"‘Whatever grievous hardship comes,"},{"id":"manas-2010:p0873:b001:l038","ordinal":38458,"en":"Let him carry Kanykey away,’"},{"id":"manas-2010:p0873:b001:l039","ordinal":38459,"en":"He was a beast set aside for her."},{"id":"manas-2010:p0873:b001:l040","ordinal":38460,"en":"Alarmed by the enemy's arrival,"},{"id":"manas-2010:p0873:b001:l041","ordinal":38461,"en":"Kanykey hurried eagerly,"},{"id":"manas-2010:p0873:b001:l042","ordinal":38462,"en":"And saddled the thoroughbred,"},{"id":"manas-2010:p0874:b001:l001","ordinal":38463,"en":"Pulling the rear girth tight,"},{"id":"manas-2010:p0874:b001:l002","ordinal":38464,"en":"Lengthening the crupper."},{"id":"manas-2010:p0874:b001:l003","ordinal":38465,"en":"The war-drum to beat against the foe,"},{"id":"manas-2010:p0874:b001:l004","ordinal":38466,"en":"If you hear its voice, flee far away!"},{"id":"manas-2010:p0874:b001:l005","ordinal":38467,"en":"Binding it back snugly,"},{"id":"manas-2010:p0874:b001:l006","ordinal":38468,"en":"Dear, fierce Kanykey"},{"id":"manas-2010:p0874:b001:l007","ordinal":38469,"en":"Fastened it to the saddle-straps."},{"id":"manas-2010:p0874:b001:l008","ordinal":38470,"en":"Her blue spear stood proudly up;"},{"id":"manas-2010:p0874:b001:l009","ordinal":38471,"en":"Soft blue leather stretched upon her feet."},{"id":"manas-2010:p0874:b001:l010","ordinal":38472,"en":"Teeming Bukhara marveled,"},{"id":"manas-2010:p0874:b001:l011","ordinal":38473,"en":"Crowding round Kanykey."},{"id":"manas-2010:p0874:b001:l012","ordinal":38474,"en":"‘What sort of soul does she possess?’ they said."},{"id":"manas-2010:p0874:b001:l013","ordinal":38475,"en":"‘What hero will she marry?’ they said."},{"id":"manas-2010:p0874:b001:l014","ordinal":38476,"en":"Those who watched crowded round."},{"id":"manas-2010:p0874:b001:l015","ordinal":38477,"en":"‘Going out alone to face the foe,"},{"id":"manas-2010:p0874:b001:l016","ordinal":38478,"en":"Can a woman be like this?"},{"id":"manas-2010:p0874:b001:l017","ordinal":38479,"en":"This ill-fated Kanykey,"},{"id":"manas-2010:p0874:b001:l018","ordinal":38480,"en":"Could one rightly call her a woman?"},{"id":"manas-2010:p0874:b001:l019","ordinal":38481,"en":"If she quarrels with her husband,"},{"id":"manas-2010:p0874:b001:l020","ordinal":38482,"en":"Will he come through alive?’"},{"id":"manas-2010:p0874:b001:l021","ordinal":38483,"en":"Teeming Bukhara crowded round,"},{"id":"manas-2010:p0874:b001:l022","ordinal":38484,"en":"And stood watching in amazement."},{"id":"manas-2010:p0874:b001:l023","ordinal":38485,"en":"She felt no anxious fear;"},{"id":"manas-2010:p0874:b001:l024","ordinal":38486,"en":"She saddled the thoroughbred."},{"id":"manas-2010:p0874:b001:l025","ordinal":38487,"en":"Wrath spread across her face."},{"id":"manas-2010:p0874:b001:l026","ordinal":38488,"en":"The black steel sword,"},{"id":"manas-2010:p0874:b001:l027","ordinal":38489,"en":"She strapped close against her body."},{"id":"manas-2010:p0874:b001:l028","ordinal":38490,"en":"Readying herself at the word enemy,"},{"id":"manas-2010:p0874:b001:l029","ordinal":38491,"en":"The ill-fated tigress now set forth."},{"id":"manas-2010:p0874:b001:l030","ordinal":38492,"en":"From the treasury palace,"},{"id":"manas-2010:p0874:b001:l031","ordinal":38493,"en":"Many souls stood astonished;"},{"id":"manas-2010:p0874:b001:l032","ordinal":38494,"en":"Many champions watched."},{"id":"manas-2010:p0874:b001:l033","ordinal":38495,"en":"Those who saw her were amazed."},{"id":"manas-2010:p0874:b001:l034","ordinal":38496,"en":"‘Of this warrior Karakan,"},{"id":"manas-2010:p0874:b001:l035","ordinal":38497,"en":"What will become of his daughter?’ they said."},{"id":"manas-2010:p0874:b001:l036","ordinal":38498,"en":"The people stood grieving and fretting."},{"id":"manas-2010:p0874:b001:l037","ordinal":38499,"en":"Without coming into the people's sight,"},{"id":"manas-2010:p0874:b001:l038","ordinal":38500,"en":"She now headed toward the gate."},{"id":"manas-2010:p0874:b001:l039","ordinal":38501,"en":"The black, white-blazed thoroughbred,"},{"id":"manas-2010:p0874:b001:l040","ordinal":38502,"en":"Without turning back, she vaulted onto him."},{"id":"manas-2010:p0874:b001:l041","ordinal":38503,"en":"Taking her blue spear, readying herself,"},{"id":"manas-2010:p0874:b001:l042","ordinal":38504,"en":"Had you seen her then,"},{"id":"manas-2010:p0875:b001:l001","ordinal":38505,"en":"Kanykey was wolf-maned,"},{"id":"manas-2010:p0875:b001:l002","ordinal":38506,"en":"Charging like a blue tiger."},{"id":"manas-2010:p0875:b001:l003","ordinal":38507,"en":"In Karakan's city,"},{"id":"manas-2010:p0875:b001:l004","ordinal":38508,"en":"In the settlement of great Bukhara,"},{"id":"manas-2010:p0875:b001:l005","ordinal":38509,"en":"There was a treasury tower;"},{"id":"manas-2010:p0875:b001:l006","ordinal":38510,"en":"Do not ask about that tower!"},{"id":"manas-2010:p0875:b001:l007","ordinal":38511,"en":"This unbeliever Kanykey of yours,"},{"id":"manas-2010:p0875:b001:l008","ordinal":38512,"en":"Your warrior who cultivated wisdom,"},{"id":"manas-2010:p0875:b001:l009","ordinal":38513,"en":"At the foot of the tower"},{"id":"manas-2010:p0875:b001:l010","ordinal":38514,"en":"Had made a field for spear-fighting."},{"id":"manas-2010:p0875:b001:l011","ordinal":38515,"en":"‘If someone falls, let it be soft,’ she said;"},{"id":"manas-2010:p0875:b001:l012","ordinal":38516,"en":"Paying out gold by weight,"},{"id":"manas-2010:p0875:b001:l013","ordinal":38517,"en":"She had it bedded with black sand."},{"id":"manas-2010:p0875:b001:l014","ordinal":38518,"en":"She had bagfuls of sand poured down,"},{"id":"manas-2010:p0875:b001:l015","ordinal":38519,"en":"And champions trample it firm."},{"id":"manas-2010:p0875:b001:l016","ordinal":38520,"en":"She wrapped the posts in gold."},{"id":"manas-2010:p0875:b001:l017","ordinal":38521,"en":"For spear-fighting and wrestling,"},{"id":"manas-2010:p0875:b001:l018","ordinal":38522,"en":"The ill-fated one beset by hardship"},{"id":"manas-2010:p0875:b001:l019","ordinal":38523,"en":"Had planned it suitably."},{"id":"manas-2010:p0875:b001:l020","ordinal":38524,"en":"Of Karakan's treasury,"},{"id":"manas-2010:p0875:b001:l021","ordinal":38525,"en":"When that arena was built,"},{"id":"manas-2010:p0875:b001:l022","ordinal":38526,"en":"A great deal had been spent."},{"id":"manas-2010:p0875:b001:l023","ordinal":38527,"en":"Onto the spear-fighting field,"},{"id":"manas-2010:p0875:b001:l024","ordinal":38528,"en":"Taking and brandishing her blue spear,"},{"id":"manas-2010:p0875:b001:l025","ordinal":38529,"en":"The sight drew one's attention."},{"id":"manas-2010:p0875:b001:l026","ordinal":38530,"en":"Venom poured from her mouth;"},{"id":"manas-2010:p0875:b001:l027","ordinal":38531,"en":"Excited and fierce, she roared:"},{"id":"manas-2010:p0875:b001:l028","ordinal":38532,"en":"‘Come here for single combat!’"},{"id":"manas-2010:p0875:b001:l029","ordinal":38533,"en":"Calling hero Chubak,"},{"id":"manas-2010:p0875:b001:l030","ordinal":38534,"en":"They stood upon opposite sides,"},{"id":"manas-2010:p0875:b001:l031","ordinal":38535,"en":"Swearing an oath to the death."},{"id":"manas-2010:p0875:b001:l032","ordinal":38536,"en":"They stood face to face,"},{"id":"manas-2010:p0875:b001:l033","ordinal":38537,"en":"Swearing an oath not to flee."},{"id":"manas-2010:p0875:b001:l034","ordinal":38538,"en":"Speaking softly, delivering firmly,"},{"id":"manas-2010:p0875:b001:l035","ordinal":38539,"en":"Ill-fated Kanykey began:"},{"id":"manas-2010:p0875:b001:l036","ordinal":38540,"en":"‘Wearing a blue rep-cloth coat,"},{"id":"manas-2010:p0875:b001:l037","ordinal":38541,"en":"Riding a horse like Kögala,"},{"id":"manas-2010:p0875:b001:l038","ordinal":38542,"en":"Leaving no part of the earth,"},{"id":"manas-2010:p0875:b001:l039","ordinal":38543,"en":"You look as though you have searched it all."},{"id":"manas-2010:p0875:b001:l040","ordinal":38544,"en":"Smashing whoever you encountered,"},{"id":"manas-2010:p0875:b001:l041","ordinal":38545,"en":"You look as though you have conquered them."},{"id":"manas-2010:p0875:b001:l042","ordinal":38546,"en":"Coveting great Bukhara,"},{"id":"manas-2010:p0876:b001:l001","ordinal":38547,"en":"You seem to have lingered here."},{"id":"manas-2010:p0876:b001:l002","ordinal":38548,"en":"You are not one who can take it;"},{"id":"manas-2010:p0876:b001:l003","ordinal":38549,"en":"I am not one who will surrender it."},{"id":"manas-2010:p0876:b001:l004","ordinal":38550,"en":"Let me come out to meet you."},{"id":"manas-2010:p0876:b001:l005","ordinal":38551,"en":"Tell me your sorrow and grievance;"},{"id":"manas-2010:p0876:b001:l006","ordinal":38552,"en":"Woman though I am, let me hear!"},{"id":"manas-2010:p0876:b001:l007","ordinal":38553,"en":"My warrior mounted on Kögala,"},{"id":"manas-2010:p0876:b001:l008","ordinal":38554,"en":"My champion who has seen many lands,"},{"id":"manas-2010:p0876:b001:l009","ordinal":38555,"en":"Stand by your promise;"},{"id":"manas-2010:p0876:b001:l010","ordinal":38556,"en":"Swear an oath unto death!"},{"id":"manas-2010:p0876:b001:l011","ordinal":38557,"en":"If you are a man, a son,"},{"id":"manas-2010:p0876:b001:l012","ordinal":38558,"en":"If you are a servant beloved of God,"},{"id":"manas-2010:p0876:b001:l013","ordinal":38559,"en":"If you are a champion, a lion,"},{"id":"manas-2010:p0876:b001:l014","ordinal":38560,"en":"Turn Kögala toward me;"},{"id":"manas-2010:p0876:b001:l015","ordinal":38561,"en":"Hear the many words I shall speak!"},{"id":"manas-2010:p0876:b001:l016","ordinal":38562,"en":"Fighting with spears, one against one,"},{"id":"manas-2010:p0876:b001:l017","ordinal":38563,"en":"If you are a champion, a warrior,"},{"id":"manas-2010:p0876:b001:l018","ordinal":38564,"en":"Let us measure our strength."},{"id":"manas-2010:p0876:b001:l019","ordinal":38565,"en":"With no time to reckon our strength,"},{"id":"manas-2010:p0876:b001:l020","ordinal":38566,"en":"If I am pierced and fall upon my back,"},{"id":"manas-2010:p0876:b001:l021","ordinal":38567,"en":"Let me accept your demands,"},{"id":"manas-2010:p0876:b001:l022","ordinal":38568,"en":"Let me give what you desire."},{"id":"manas-2010:p0876:b001:l023","ordinal":38569,"en":"If you are a man, a lion,"},{"id":"manas-2010:p0876:b001:l024","ordinal":38570,"en":"Let me accept your demands."},{"id":"manas-2010:p0876:b001:l025","ordinal":38571,"en":"The city with its gates—"},{"id":"manas-2010:p0876:b001:l026","ordinal":38572,"en":"Let me give you the khanate of Bukhara."},{"id":"manas-2010:p0876:b001:l027","ordinal":38573,"en":"If you defeat me with your spear,"},{"id":"manas-2010:p0876:b001:l028","ordinal":38574,"en":"I stake my city of Bukhara."},{"id":"manas-2010:p0876:b001:l029","ordinal":38575,"en":"I shall let you rule"},{"id":"manas-2010:p0876:b001:l030","ordinal":38576,"en":"Everything of mine that moves."},{"id":"manas-2010:p0876:b001:l031","ordinal":38577,"en":"Let me send word to my people,"},{"id":"manas-2010:p0876:b001:l032","ordinal":38578,"en":"Place my golden crown upon you,"},{"id":"manas-2010:p0876:b001:l033","ordinal":38579,"en":"Seat you on the golden throne,"},{"id":"manas-2010:p0876:b001:l034","ordinal":38580,"en":"Of resounding Bukhara,"},{"id":"manas-2010:p0876:b001:l035","ordinal":38581,"en":"Leaving not the smallest thing,"},{"id":"manas-2010:p0876:b001:l036","ordinal":38582,"en":"Letting you rule all this,"},{"id":"manas-2010:p0876:b001:l037","ordinal":38583,"en":"Over Bukhara's twelve gates"},{"id":"manas-2010:p0876:b001:l038","ordinal":38584,"en":"Let me make you governor."},{"id":"manas-2010:p0876:b001:l039","ordinal":38585,"en":"If you are a champion, a warrior,"},{"id":"manas-2010:p0876:b001:l040","ordinal":38586,"en":"If you are a lion who shatters the world,"},{"id":"manas-2010:p0876:b001:l041","ordinal":38587,"en":"Make your promise;"},{"id":"manas-2010:p0876:b001:l042","ordinal":38588,"en":"If you yourself are a human being,"},{"id":"manas-2010:p0877:b001:l001","ordinal":38589,"en":"Stand by what you say!"},{"id":"manas-2010:p0877:b001:l002","ordinal":38590,"en":"I stake my city of Bukhara."},{"id":"manas-2010:p0877:b001:l003","ordinal":38591,"en":"Leaving nothing out, I stake"},{"id":"manas-2010:p0877:b001:l004","ordinal":38592,"en":"Everything of mine that stirs."},{"id":"manas-2010:p0877:b001:l005","ordinal":38593,"en":"If I defeat you with my spear,"},{"id":"manas-2010:p0877:b001:l006","ordinal":38594,"en":"Will you stake your blood?"},{"id":"manas-2010:p0877:b001:l007","ordinal":38595,"en":"Let me display unbounded valor,"},{"id":"manas-2010:p0877:b001:l008","ordinal":38596,"en":"Let me strike with skill."},{"id":"manas-2010:p0877:b001:l009","ordinal":38597,"en":"If I bend you down and unhorse you,"},{"id":"manas-2010:p0877:b001:l010","ordinal":38598,"en":"Let me cut off your head."},{"id":"manas-2010:p0877:b001:l011","ordinal":38599,"en":"I have staked my golden throne;"},{"id":"manas-2010:p0877:b001:l012","ordinal":38600,"en":"Will you stake your life?’"},{"id":"manas-2010:p0877:b001:l013","ordinal":38601,"en":"When Kanykey said this,"},{"id":"manas-2010:p0877:b001:l014","ordinal":38602,"en":"Wrathful Chubak began to speak:"},{"id":"manas-2010:p0877:b001:l015","ordinal":38603,"en":"‘You speak with a warrior's stature;"},{"id":"manas-2010:p0877:b001:l016","ordinal":38604,"en":"These words of yours are heroic."},{"id":"manas-2010:p0877:b001:l017","ordinal":38605,"en":"Whoever fails to do exactly this—"},{"id":"manas-2010:p0877:b001:l018","ordinal":38606,"en":"His seven forefathers are unbelievers!"},{"id":"manas-2010:p0877:b001:l019","ordinal":38607,"en":"Making the promise firm,"},{"id":"manas-2010:p0877:b001:l020","ordinal":38608,"en":"Swearing an oath unto death,"},{"id":"manas-2010:p0877:b001:l021","ordinal":38609,"en":"Let me accept your terms."},{"id":"manas-2010:p0877:b001:l022","ordinal":38610,"en":"If you bend me down and spear me,"},{"id":"manas-2010:p0877:b001:l023","ordinal":38611,"en":"This life standing here,"},{"id":"manas-2010:p0877:b001:l024","ordinal":38612,"en":"Let me sacrifice it to you."},{"id":"manas-2010:p0877:b001:l025","ordinal":38613,"en":"Oh, my young one, your shape and dignity,"},{"id":"manas-2010:p0877:b001:l026","ordinal":38614,"en":"Your bearing on horseback,"},{"id":"manas-2010:p0877:b001:l027","ordinal":38615,"en":"Seem like a warrior's."},{"id":"manas-2010:p0877:b001:l028","ordinal":38616,"en":"Tell me your story."},{"id":"manas-2010:p0877:b001:l029","ordinal":38617,"en":"Of what land are you khan?"},{"id":"manas-2010:p0877:b001:l030","ordinal":38618,"en":"Tell me your circumstances;"},{"id":"manas-2010:p0877:b001:l031","ordinal":38619,"en":"Let us ask about each other."},{"id":"manas-2010:p0877:b001:l032","ordinal":38620,"en":"Then, facing each other,"},{"id":"manas-2010:p0877:b001:l033","ordinal":38621,"en":"Let us charge and thrust our spears!’"},{"id":"manas-2010:p0877:b001:l034","ordinal":38622,"en":"Then the fierce woman said:"},{"id":"manas-2010:p0877:b001:l035","ordinal":38623,"en":"‘In manhood I am lacking;"},{"id":"manas-2010:p0877:b001:l036","ordinal":38624,"en":"To finish my words, I am a woman."},{"id":"manas-2010:p0877:b001:l037","ordinal":38625,"en":"I am a beauty among women,"},{"id":"manas-2010:p0877:b001:l038","ordinal":38626,"en":"The youngest of twelve daughters,"},{"id":"manas-2010:p0877:b001:l039","ordinal":38627,"en":"A servant beloved of God,"},{"id":"manas-2010:p0877:b001:l040","ordinal":38628,"en":"A beauty of dusky complexion,"},{"id":"manas-2010:p0877:b001:l041","ordinal":38629,"en":"A radiant one among Muslims."},{"id":"manas-2010:p0877:b001:l042","ordinal":38630,"en":"If you ask about my father—"},{"id":"manas-2010:p0878:b001:l001","ordinal":38631,"en":"I am Temirkan's daughter."},{"id":"manas-2010:p0878:b001:l002","ordinal":38632,"en":"Breaking marriage bonds, spearing warriors,"},{"id":"manas-2010:p0878:b001:l003","ordinal":38633,"en":"I am one of the suffering slave women,"},{"id":"manas-2010:p0878:b001:l004","ordinal":38634,"en":"Upon so many, turmoil—"},{"id":"manas-2010:p0878:b001:l005","ordinal":38635,"en":"I am the hapless one who brought it."},{"id":"manas-2010:p0878:b001:l006","ordinal":38636,"en":"Coveting what my father Karakan has,"},{"id":"manas-2010:p0878:b001:l007","ordinal":38637,"en":"“I shall bring devastation,” they said,"},{"id":"manas-2010:p0878:b001:l008","ordinal":38638,"en":"“All his daughters"},{"id":"manas-2010:p0878:b001:l009","ordinal":38639,"en":"I shall drag away as spoils.”"},{"id":"manas-2010:p0878:b001:l010","ordinal":38640,"en":"There were giants among men's sons,"},{"id":"manas-2010:p0878:b001:l011","ordinal":38641,"en":"All from lands one has seen."},{"id":"manas-2010:p0878:b001:l012","ordinal":38642,"en":"The khan's nephew, Zhügörü,"},{"id":"manas-2010:p0878:b001:l013","ordinal":38643,"en":"Who brought upheaval in battle,"},{"id":"manas-2010:p0878:b001:l014","ordinal":38644,"en":"And all the mighty giants were there."},{"id":"manas-2010:p0878:b001:l015","ordinal":38645,"en":"Aydarkan from among the Kazakhs—"},{"id":"manas-2010:p0878:b001:l016","ordinal":38646,"en":"That warrior was there too."},{"id":"manas-2010:p0878:b001:l017","ordinal":38647,"en":"Kökbörü, Urumkan's son,"},{"id":"manas-2010:p0878:b001:l018","ordinal":38648,"en":"Was there among the spearmen."},{"id":"manas-2010:p0878:b001:l019","ordinal":38649,"en":"Buudayyk of the golden crown,"},{"id":"manas-2010:p0878:b001:l020","ordinal":38650,"en":"The khan of Khiva, was there too."},{"id":"manas-2010:p0878:b001:l021","ordinal":38651,"en":"There were elders who knew by hearing;"},{"id":"manas-2010:p0878:b001:l022","ordinal":38652,"en":"All those many giants were there."},{"id":"manas-2010:p0878:b001:l023","ordinal":38653,"en":"Making troughs of pine,"},{"id":"manas-2010:p0878:b001:l024","ordinal":38654,"en":"All the giants gathered,"},{"id":"manas-2010:p0878:b001:l025","ordinal":38655,"en":"Making demands of my khan father:"},{"id":"manas-2010:p0878:b001:l026","ordinal":38656,"en":"“Accept our words,” they said,"}]
