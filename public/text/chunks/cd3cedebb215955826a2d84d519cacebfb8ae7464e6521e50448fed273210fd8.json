[{"id":"semetey-1-2013:p1152:b004:l025","ordinal":165121,"en":"And began words of entertainment."},{"id":"semetey-1-2013:p1152:b004:l026","ordinal":165122,"en":"Infidel and Muslim alike"},{"id":"semetey-1-2013:p1152:b004:l027","ordinal":165123,"en":"Gathered around shared cauldrons;"},{"id":"semetey-1-2013:p1152:b004:l028","ordinal":165124,"en":"Their clashing subsided."},{"id":"semetey-1-2013:p1152:b004:l029","ordinal":165125,"en":"They gathered after their disorder,"},{"id":"semetey-1-2013:p1152:b004:l030","ordinal":165126,"en":"And all the trouble ceased."},{"id":"semetey-1-2013:p1152:b004:l031","ordinal":165127,"en":"The people reconciled and prospered,"},{"id":"semetey-1-2013:p1152:b004:l032","ordinal":165128,"en":"And merriment began again."},{"id":"semetey-1-2013:p1152:b004:l033","ordinal":165129,"en":"As the people stood thus,"},{"id":"semetey-1-2013:p1152:b004:l034","ordinal":165130,"en":"Kökötöy's Bokmurun"},{"id":"semetey-1-2013:p1152:b004:l035","ordinal":165131,"en":"Regained his spirit,"},{"id":"semetey-1-2013:p1152:b004:l036","ordinal":165132,"en":"Came back to life,"},{"id":"semetey-1-2013:p1152:b004:l037","ordinal":165133,"en":"And recovered his speech."},{"id":"semetey-1-2013:p1152:b004:l038","ordinal":165134,"en":"Over hill and mountain, Maaniker"},{"id":"semetey-1-2013:p1153:b003:l001","ordinal":165135,"en":"It seemed to be running."},{"id":"semetey-1-2013:p1153:b003:l002","ordinal":165136,"en":"Having died, he seemed"},{"id":"semetey-1-2013:p1153:b003:l003","ordinal":165137,"en":"To come alive again."},{"id":"semetey-1-2013:p1153:b003:l004","ordinal":165138,"en":"The treasure-filled forty rooms—"},{"id":"semetey-1-2013:p1153:b003:l005","ordinal":165139,"en":"He opened their mouths wide as sacks,"},{"id":"semetey-1-2013:p1153:b003:l006","ordinal":165140,"en":"For the sake of the spectacle,"},{"id":"semetey-1-2013:p1153:b003:l007","ordinal":165141,"en":"He squandered and scattered it."},{"id":"semetey-1-2013:p1153:b003:l008","ordinal":165142,"en":"He had horns and trumpets sounded"},{"id":"semetey-1-2013:p1153:b004:l001","ordinal":165143,"en":"And word proclaimed by the herald:"},{"id":"semetey-1-2013:p1153:b004:l002","ordinal":165144,"en":"\"Infidel and Muslim alike,"},{"id":"semetey-1-2013:p1153:b004:l003","ordinal":165145,"en":"Your peoples have come here."},{"id":"semetey-1-2013:p1153:b004:l004","ordinal":165146,"en":"Many seething great lords,"},{"id":"semetey-1-2013:p1153:b004:l005","ordinal":165147,"en":"All of you have come here."},{"id":"semetey-1-2013:p1153:b004:l006","ordinal":165148,"en":"My father Kökötöy has died;"},{"id":"semetey-1-2013:p1153:b004:l007","ordinal":165149,"en":"The journey from which none return—"},{"id":"semetey-1-2013:p1153:b004:l008","ordinal":165150,"en":"My khan-father has undergone it."},{"id":"semetey-1-2013:p1153:b006:l001","ordinal":165151,"en":"Let one champion from the infidels"},{"id":"semetey-1-2013:p1153:b006:l002","ordinal":165152,"en":"And one champion from the Muslims"},{"id":"semetey-1-2013:p1153:b006:l003","ordinal":165153,"en":"Wrestle in the center;"},{"id":"semetey-1-2013:p1153:b006:l004","ordinal":165154,"en":"Let them seize each other's trouser cuffs."},{"id":"semetey-1-2013:p1153:b006:l005","ordinal":165155,"en":"Let the champions step forward"},{"id":"semetey-1-2013:p1153:b006:l006","ordinal":165156,"en":"And begin the spectacle."},{"id":"semetey-1-2013:p1153:b006:l007","ordinal":165157,"en":"For these excited people,"},{"id":"semetey-1-2013:p1153:b006:l008","ordinal":165158,"en":"Let them provide a spectacle."},{"id":"semetey-1-2013:p1153:b006:l009","ordinal":165159,"en":"At Kökötöy's feast,"},{"id":"semetey-1-2013:p1153:b006:l010","ordinal":165160,"en":"Let them say such was the custom;"},{"id":"semetey-1-2013:p1153:b006:l011","ordinal":165161,"en":"Infidel and Muslim alike,"},{"id":"semetey-1-2013:p1153:b006:l012","ordinal":165162,"en":"Let them tell their peoples."},{"id":"semetey-1-2013:p1153:b006:l013","ordinal":165163,"en":"As the wrestling prize,"},{"id":"semetey-1-2013:p1153:b006:l014","ordinal":165164,"en":"I stake a thousand black camels"},{"id":"semetey-1-2013:p1153:b006:l015","ordinal":165165,"en":"And a thousand black-blazed mares."},{"id":"semetey-1-2013:p1153:b006:l016","ordinal":165166,"en":"From red gold coins,"},{"id":"semetey-1-2013:p1153:b006:l017","ordinal":165167,"en":"Filling one saddlebag,"},{"id":"semetey-1-2013:p1153:b006:l018","ordinal":165168,"en":"I stake it with all its contents;"},{"id":"semetey-1-2013:p1153:b006:l019","ordinal":165169,"en":"I stake a bondwoman with her child."},{"id":"semetey-1-2013:p1153:b006:l020","ordinal":165170,"en":"Of all that ears have heard and eyes have seen,"},{"id":"semetey-1-2013:p1153:b006:l021","ordinal":165171,"en":"Who has staked prizes like me?"},{"id":"semetey-1-2013:p1153:b006:l022","ordinal":165172,"en":"Dust flies into the sky;"},{"id":"semetey-1-2013:p1153:b006:l023","ordinal":165173,"en":"Infidel and Muslim alike,"},{"id":"semetey-1-2013:p1153:b006:l024","ordinal":165174,"en":"You have gathered in a mass."},{"id":"semetey-1-2013:p1153:b006:l025","ordinal":165175,"en":"It is Khan Kökötöy's feast,"},{"id":"semetey-1-2013:p1153:b006:l026","ordinal":165176,"en":"The place of the great gathering."},{"id":"semetey-1-2013:p1153:b006:l027","ordinal":165177,"en":"There is the swift horse Maaniker."},{"id":"semetey-1-2013:p1153:b008:l001","ordinal":165178,"en":"Do not think my wealth exhausted;"},{"id":"semetey-1-2013:p1153:b008:l002","ordinal":165179,"en":"There are six rooms full of possessions."},{"id":"semetey-1-2013:p1153:b008:l003","ordinal":165180,"en":"I migrated here from Tashken;"},{"id":"semetey-1-2013:p1153:b008:l004","ordinal":165181,"en":"There is a line already drawn."},{"id":"semetey-1-2013:p1153:b008:l005","ordinal":165182,"en":"For infidel and Muslim alike,"},{"id":"semetey-1-2013:p1153:b008:l006","ordinal":165183,"en":"There is a spectacle to display."},{"id":"semetey-1-2013:p1153:b008:l007","ordinal":165184,"en":"I have a song to sing;"},{"id":"semetey-1-2013:p1153:b008:l008","ordinal":165185,"en":"For infidel and Muslim alike,"},{"id":"semetey-1-2013:p1153:b008:l009","ordinal":165186,"en":"I have a contest to begin."},{"id":"semetey-1-2013:p1153:b008:l010","ordinal":165187,"en":"Even in forty years it would not end—"},{"id":"semetey-1-2013:p1153:b008:l011","ordinal":165188,"en":"I have livestock left by my father."},{"id":"semetey-1-2013:p1153:b008:l012","ordinal":165189,"en":"Why should I tell of the rest?"},{"id":"semetey-1-2013:p1153:b008:l013","ordinal":165190,"en":"For carrying red gold,"},{"id":"semetey-1-2013:p1153:b008:l014","ordinal":165191,"en":"I have a myriad red camels,"},{"id":"semetey-1-2013:p1153:b008:l015","ordinal":165192,"en":"And livestock worth a great deal."},{"id":"semetey-1-2013:p1153:b008:l016","ordinal":165193,"en":"Infidel and Muslim alike,"},{"id":"semetey-1-2013:p1153:b008:l017","ordinal":165194,"en":"Divide Kökötöy's prizes"},{"id":"semetey-1-2013:p1153:b008:l018","ordinal":165195,"en":"Fairly among yourselves.\""},{"id":"semetey-1-2013:p1153:b008:l019","ordinal":165196,"en":"After Bokmurun issued the decree,"},{"id":"semetey-1-2013:p1153:b008:l020","ordinal":165197,"en":"The common people heard."},{"id":"semetey-1-2013:p1153:b008:l021","ordinal":165198,"en":"From the black Kalmyk people,"},{"id":"semetey-1-2013:p1153:b008:l022","ordinal":165199,"en":"Saying, \"I shall go out,\""},{"id":"semetey-1-2013:p1153:b008:l023","ordinal":165200,"en":"Khan Zholoy stepped forward."},{"id":"semetey-1-2013:p1153:b008:l024","ordinal":165201,"en":"Do not ask of Zholoy's station:"},{"id":"semetey-1-2013:p1153:b008:l025","ordinal":165202,"en":"He was as large as a mountain,"},{"id":"semetey-1-2013:p1153:b008:l026","ordinal":165203,"en":"As though he would eat whoever appeared."},{"id":"semetey-1-2013:p1153:b008:l027","ordinal":165204,"en":"Khan Zholoy of the black Kalmyks"},{"id":"semetey-1-2013:p1154:b003:l001","ordinal":165205,"en":"Never spared one who wrestled him;"},{"id":"semetey-1-2013:p1154:b003:l002","ordinal":165206,"en":"The meat of one whole pig"},{"id":"semetey-1-2013:p1154:b003:l003","ordinal":165207,"en":"Did not fill him at a sitting."},{"id":"semetey-1-2013:p1154:b003:l004","ordinal":165208,"en":"His fame spread through the world—"},{"id":"semetey-1-2013:p1154:b003:l005","ordinal":165209,"en":"Was he not capable Zholoy?"},{"id":"semetey-1-2013:p1154:b003:l006","ordinal":165210,"en":"Was he not Zholoy who shattered"},{"id":"semetey-1-2013:p1154:b003:l007","ordinal":165211,"en":"And took so many lands?"},{"id":"semetey-1-2013:p1154:b003:l008","ordinal":165212,"en":"The great Kalmyk who towered over you"},{"id":"semetey-1-2013:p1154:b003:l009","ordinal":165213,"en":"Could knock down a camel with one punch—"},{"id":"semetey-1-2013:p1154:b003:l010","ordinal":165214,"en":"Was he not the champion Zholoy?"},{"id":"semetey-1-2013:p1154:b003:l011","ordinal":165215,"en":"When he met a man on foot,"},{"id":"semetey-1-2013:p1154:b003:l012","ordinal":165216,"en":"His brow was like the reedy edge of a lake,"},{"id":"semetey-1-2013:p1154:b003:l013","ordinal":165217,"en":"As though he would swallow whoever appeared."},{"id":"semetey-1-2013:p1154:b003:l014","ordinal":165218,"en":"Wearing yellow leather trousers,"},{"id":"semetey-1-2013:p1154:b003:l015","ordinal":165219,"en":"Zholoy of auspicious hour prepared."},{"id":"semetey-1-2013:p1154:b003:l016","ordinal":165220,"en":"If you had seen great Zholoy,"},{"id":"semetey-1-2013:p1154:b003:l017","ordinal":165221,"en":"He raged like a blue boar:"},{"id":"semetey-1-2013:p1154:b003:l018","ordinal":165222,"en":"\"If a bastard Burut"},{"id":"semetey-1-2013:p1154:b003:l019","ordinal":165223,"en":"Comes to wrestle, I shall throw him;"},{"id":"semetey-1-2013:p1154:b003:l020","ordinal":165224,"en":"I shall seize him"},{"id":"semetey-1-2013:p1154:b003:l021","ordinal":165225,"en":"And thrust him alive into the grave."},{"id":"semetey-1-2013:p1154:b003:l022","ordinal":165226,"en":"I shall take alone"},{"id":"semetey-1-2013:p1154:b003:l023","ordinal":165227,"en":"All the Muslims' great prizes."},{"id":"semetey-1-2013:p1154:b003:l024","ordinal":165228,"en":"When the jostling turmoil begins,"},{"id":"semetey-1-2013:p1154:b003:l025","ordinal":165229,"en":"I shall unleash a single havoc.\""},{"id":"semetey-1-2013:p1154:b003:l026","ordinal":165230,"en":"The spirit of those who saw him failed;"},{"id":"semetey-1-2013:p1154:b003:l027","ordinal":165231,"en":"Zholoy came out from the Kalmyks,"},{"id":"semetey-1-2013:p1154:b003:l028","ordinal":165232,"en":"Appearing like Mount Opol."},{"id":"semetey-1-2013:p1154:b003:l029","ordinal":165233,"en":"When they saw Zholoy's form,"},{"id":"semetey-1-2013:p1154:b003:l030","ordinal":165234,"en":"The handful of Muslims"},{"id":"semetey-1-2013:p1154:b003:l031","ordinal":165235,"en":"Their courage failed badly"},{"id":"semetey-1-2013:p1154:b003:l032","ordinal":165236,"en":"And they lost their wits."},{"id":"semetey-1-2013:p1154:b003:l033","ordinal":165237,"en":"When the would-be Muslim champions"},{"id":"semetey-1-2013:p1154:b003:l034","ordinal":165238,"en":"Saw Khan Zholoy,"},{"id":"semetey-1-2013:p1154:b003:l035","ordinal":165239,"en":"They fled from among the people."},{"id":"semetey-1-2013:p1154:b003:l036","ordinal":165240,"en":"Against the enraged infidel,"},{"id":"semetey-1-2013:p1154:b003:l037","ordinal":165241,"en":"Wondering which champion would go out,"},{"id":"semetey-1-2013:p1154:b003:l038","ordinal":165242,"en":"Khan Manas too grew anxious."},{"id":"semetey-1-2013:p1154:b003:l039","ordinal":165243,"en":"Dear elder Koshoy"},{"id":"semetey-1-2013:p1154:b004:l001","ordinal":165244,"en":"And hero Töshtük, son of Eleman,"},{"id":"semetey-1-2013:p1154:b004:l002","ordinal":165245,"en":"Stood in a row then,"},{"id":"semetey-1-2013:p1154:b004:l003","ordinal":165246,"en":"As did all the Muslims."},{"id":"semetey-1-2013:p1154:b004:l004","ordinal":165247,"en":"With a black hat large as a house,"},{"id":"semetey-1-2013:p1154:b004:l005","ordinal":165248,"en":"The tiger, bloodthirsty Manas,"},{"id":"semetey-1-2013:p1154:b004:l006","ordinal":165249,"en":"For the Muslim people,"},{"id":"semetey-1-2013:p1154:b004:l007","ordinal":165250,"en":"Born as their black stallion of honor:"},{"id":"semetey-1-2013:p1154:b004:l008","ordinal":165251,"en":"\"Is there a giant among you"},{"id":"semetey-1-2013:p1154:b004:l009","ordinal":165252,"en":"Who will take the infidel champion?"},{"id":"semetey-1-2013:p1154:b004:l010","ordinal":165253,"en":"Who will seize his trouser cuffs,"},{"id":"semetey-1-2013:p1154:b004:l011","ordinal":165254,"en":"Wrestle like a champion,"},{"id":"semetey-1-2013:p1154:b004:l012","ordinal":165255,"en":"Tear whatever comes to hand,"},{"id":"semetey-1-2013:p1154:b004:l013","ordinal":165256,"en":"Butt like a blue bull,"},{"id":"semetey-1-2013:p1154:b004:l014","ordinal":165257,"en":"And bring merciless havoc"},{"id":"semetey-1-2013:p1154:b004:l015","ordinal":165258,"en":"Upon the foremost black Kalmyk?"},{"id":"semetey-1-2013:p1154:b004:l016","ordinal":165259,"en":"Is there such a man?"},{"id":"semetey-1-2013:p1154:b004:l017","ordinal":165260,"en":"Is there one who will win"},{"id":"semetey-1-2013:p1154:b004:l018","ordinal":165261,"en":"Honor for the Muslims?\""},{"id":"semetey-1-2013:p1154:b004:l019","ordinal":165262,"en":"Gray-wolf Manas, the tiger,"},{"id":"semetey-1-2013:p1154:b004:l020","ordinal":165263,"en":"Mounted a blue racehorse:"},{"id":"semetey-1-2013:p1154:b004:l021","ordinal":165264,"en":"\"To wrestle once,"},{"id":"semetey-1-2013:p1154:b004:l022","ordinal":165265,"en":"To provide the people a spectacle,"},{"id":"semetey-1-2013:p1154:b004:l023","ordinal":165266,"en":"To learn what sort of hero is seething there,"},{"id":"semetey-1-2013:p1154:b004:l024","ordinal":165267,"en":"What the Burut are like—"},{"id":"semetey-1-2013:p1154:b004:l025","ordinal":165268,"en":"Let the black Kalmyk and Manchu people"},{"id":"semetey-1-2013:p1154:b004:l026","ordinal":165269,"en":"Tell forever—"},{"id":"semetey-1-2013:p1154:b004:l027","ordinal":165270,"en":"Hero Töshtük, son of Eleman,"},{"id":"semetey-1-2013:p1154:b004:l028","ordinal":165271,"en":"Youngest of nine sons,"},{"id":"semetey-1-2013:p1154:b004:l029","ordinal":165272,"en":"Eleman's cherished one,"},{"id":"semetey-1-2013:p1154:b004:l030","ordinal":165273,"en":"A mortal of the one God,"},{"id":"semetey-1-2013:p1154:b004:l031","ordinal":165274,"en":"How are you against the champion,"},{"id":"semetey-1-2013:p1154:b004:l032","ordinal":165275,"en":"With that dog who boasts of strength,"},{"id":"semetey-1-2013:p1154:b004:l033","ordinal":165276,"en":"To grapple with him?\""},{"id":"semetey-1-2013:p1154:b004:l034","ordinal":165277,"en":"When Manas spoke thus,"},{"id":"semetey-1-2013:p1154:b004:l035","ordinal":165278,"en":"Töshtük stood and said:"},{"id":"semetey-1-2013:p1154:b004:l036","ordinal":165279,"en":"\"My time to wrestle"},{"id":"semetey-1-2013:p1154:b004:l037","ordinal":165280,"en":"The boasting Kalmyk has not yet come;"},{"id":"semetey-1-2013:p1154:b004:l038","ordinal":165281,"en":"My strength has not yet filled my body."},{"id":"semetey-1-2013:p1154:b004:l039","ordinal":165282,"en":"My flesh remains raw and bruised."},{"id":"semetey-1-2013:p1155:b003:l001","ordinal":165283,"en":"My blood remains one spoonful."},{"id":"semetey-1-2013:p1155:b003:l002","ordinal":165284,"en":"My joints have failed; I have no strength,"},{"id":"semetey-1-2013:p1155:b003:l003","ordinal":165285,"en":"No power to wrestle."},{"id":"semetey-1-2013:p1155:b003:l004","ordinal":165286,"en":"If I jostle with this infidel,"},{"id":"semetey-1-2013:p1155:b003:l005","ordinal":165287,"en":"My joints will come apart,"},{"id":"semetey-1-2013:p1155:b003:l006","ordinal":165288,"en":"And my body will sway."},{"id":"semetey-1-2013:p1155:b003:l007","ordinal":165289,"en":"The reason I am like this:"},{"id":"semetey-1-2013:p1155:b003:l008","ordinal":165290,"en":"I descended beneath the earth,"},{"id":"semetey-1-2013:p1155:b003:l009","ordinal":165291,"en":"And seven years were completed;"},{"id":"semetey-1-2013:p1155:b003:l010","ordinal":165292,"en":"Since I came above the earth,"},{"id":"semetey-1-2013:p1155:b003:l011","ordinal":165293,"en":"Barely seven days have passed."},{"id":"semetey-1-2013:p1155:b003:l012","ordinal":165294,"en":"What I say is true; I have no recourse."},{"id":"semetey-1-2013:p1155:b003:l013","ordinal":165295,"en":"I have no strength to wrestle"},{"id":"semetey-1-2013:p1155:b003:l014","ordinal":165296,"en":"The swaggering crow-like Kalmyk."},{"id":"semetey-1-2013:p1155:b003:l015","ordinal":165297,"en":"I have declined from my former days;"},{"id":"semetey-1-2013:p1155:b003:l016","ordinal":165298,"en":"You asked whether I was formidable,"},{"id":"semetey-1-2013:p1155:b003:l017","ordinal":165299,"en":"But today your Töshtük"},{"id":"semetey-1-2013:p1155:b003:l018","ordinal":165300,"en":"Stands in the form of doomsday."},{"id":"semetey-1-2013:p1155:b003:l019","ordinal":165301,"en":"If I unexpectedly wrestled"},{"id":"semetey-1-2013:p1155:b003:l020","ordinal":165302,"en":"The swaggering black Kalmyk,"},{"id":"semetey-1-2013:p1155:b003:l021","ordinal":165303,"en":"Would my hip not strike the earth,"},{"id":"semetey-1-2013:p1155:b003:l022","ordinal":165304,"en":"And would not the handful of Muslims"},{"id":"semetey-1-2013:p1155:b003:l023","ordinal":165305,"en":"Lose all their honor together?"},{"id":"semetey-1-2013:p1155:b003:l024","ordinal":165306,"en":"Would the black earth not swallow me?"},{"id":"semetey-1-2013:p1155:b003:l025","ordinal":165307,"en":"If I fell sprawling,"},{"id":"semetey-1-2013:p1155:b003:l026","ordinal":165308,"en":"Would that not be my deathbed?"},{"id":"semetey-1-2013:p1155:b003:l027","ordinal":165309,"en":"If I speak plainly,"},{"id":"semetey-1-2013:p1155:b003:l028","ordinal":165310,"en":"My tale is unending:"},{"id":"semetey-1-2013:p1155:b003:l029","ordinal":165311,"en":"When the giant black bird Zymyryk"},{"id":"semetey-1-2013:p1155:b003:l030","ordinal":165312,"en":"Was driven beyond all recourse,"},{"id":"semetey-1-2013:p1155:b003:l031","ordinal":165313,"en":"I cut flesh from my thick thigh"},{"id":"semetey-1-2013:p1155:b003:l032","ordinal":165314,"en":"And gave it as food."},{"id":"semetey-1-2013:p1155:b003:l033","ordinal":165315,"en":"I bear such a wound."},{"id":"semetey-1-2013:p1155:b003:l034","ordinal":165316,"en":"Will the Kalmyk not seize upon my weakness,"},{"id":"semetey-1-2013:p1155:b003:l035","ordinal":165317,"en":"Throw me down stiffly,"},{"id":"semetey-1-2013:p1155:b003:l036","ordinal":165318,"en":"Take his unspent vengeance,"},{"id":"semetey-1-2013:p1155:b003:l037","ordinal":165319,"en":"And break the back"},{"id":"semetey-1-2013:p1155:b003:l038","ordinal":165320,"en":"Of the steadfast Muslims?\""},{"id":"semetey-1-2013:p1155:b003:l039","ordinal":165321,"en":"When Töshtük spoke thus,"},{"id":"semetey-1-2013:p1155:b005:l001","ordinal":165322,"en":"Lord Manas left him."},{"id":"semetey-1-2013:p1155:b005:l002","ordinal":165323,"en":"He seized Zhamgyrchy"},{"id":"semetey-1-2013:p1155:b005:l003","ordinal":165324,"en":"Of the Eshtek people:"},{"id":"semetey-1-2013:p1155:b005:l004","ordinal":165325,"en":"\"You are a hero of the Eshtek,"},{"id":"semetey-1-2013:p1155:b005:l005","ordinal":165326,"en":"The lion of a whole clan;"},{"id":"semetey-1-2013:p1155:b005:l006","ordinal":165327,"en":"How are you against the champion,"},{"id":"semetey-1-2013:p1155:b005:l007","ordinal":165328,"en":"To throw him and win the prize?\""},{"id":"semetey-1-2013:p1155:b005:l008","ordinal":165329,"en":"Losing his wits,"},{"id":"semetey-1-2013:p1155:b005:l009","ordinal":165330,"en":"Zhamgyrchy of the Eshtek"},{"id":"semetey-1-2013:p1155:b005:l010","ordinal":165331,"en":"Fled from among the people:"},{"id":"semetey-1-2013:p1155:b005:l011","ordinal":165332,"en":"\"I shall not approach Zholoy,"},{"id":"semetey-1-2013:p1155:b005:l012","ordinal":165333,"en":"Nor attack the Kalmyk."},{"id":"semetey-1-2013:p1155:b005:l013","ordinal":165334,"en":"I have given Manas my answer:"},{"id":"semetey-1-2013:p1155:b005:l014","ordinal":165335,"en":"I will not go to the Kalmyk"},{"id":"semetey-1-2013:p1155:b005:l015","ordinal":165336,"en":"And die for nothing.\""},{"id":"semetey-1-2013:p1155:b005:l016","ordinal":165337,"en":"\"Hero Bagysh of the Zhediger!"},{"id":"semetey-1-2013:p1155:b005:l017","ordinal":165338,"en":"How are you against the champion—"},{"id":"semetey-1-2013:p1155:b005:l018","ordinal":165339,"en":"To win the prize if you throw him,"},{"id":"semetey-1-2013:p1155:b005:l019","ordinal":165340,"en":"And be left with nothing if you fall?\""},{"id":"semetey-1-2013:p1155:b005:l020","ordinal":165341,"en":"Then Bagysh said:"},{"id":"semetey-1-2013:p1155:b005:l021","ordinal":165342,"en":"\"I will not go to the Kalmyk;"},{"id":"semetey-1-2013:p1155:b005:l022","ordinal":165343,"en":"I will not die needlessly"},{"id":"semetey-1-2013:p1155:b005:l023","ordinal":165344,"en":"At the hands of mighty infidel Zholoy."},{"id":"semetey-1-2013:p1155:b005:l024","ordinal":165345,"en":"I have a land called Zheti-Özön,"},{"id":"semetey-1-2013:p1155:b005:l025","ordinal":165346,"en":"And a people called Zhediger."},{"id":"semetey-1-2013:p1155:b005:l026","ordinal":165347,"en":"I made dear Zheti-Özön"},{"id":"semetey-1-2013:p1155:b005:l027","ordinal":165348,"en":"Into a homeland by my own skill;"},{"id":"semetey-1-2013:p1155:b005:l028","ordinal":165349,"en":"I made the seven Zhediger clans"},{"id":"semetey-1-2013:p1155:b005:l029","ordinal":165350,"en":"Into a people by my own skill."},{"id":"semetey-1-2013:p1155:b005:l030","ordinal":165351,"en":"I raised a kite into a hunting bird,"},{"id":"semetey-1-2013:p1155:b005:l031","ordinal":165352,"en":"Gathered a mixture into a nation;"},{"id":"semetey-1-2013:p1155:b005:l032","ordinal":165353,"en":"I trained a wandering bird into a hunting bird,"},{"id":"semetey-1-2013:p1155:b005:l033","ordinal":165354,"en":"Gathered wanderers into a nation."},{"id":"semetey-1-2013:p1155:b005:l034","ordinal":165355,"en":"If Zholoy kills me,"},{"id":"semetey-1-2013:p1155:b005:l035","ordinal":165356,"en":"The kite will return to its place,"},{"id":"semetey-1-2013:p1155:b005:l036","ordinal":165357,"en":"The gathered mixture to its people;"},{"id":"semetey-1-2013:p1155:b005:l037","ordinal":165358,"en":"The wandering bird will return to its place,"},{"id":"semetey-1-2013:p1155:b005:l038","ordinal":165359,"en":"And the wanderer to his kin."},{"id":"semetey-1-2013:p1155:b005:l039","ordinal":165360,"en":"I will not go to the Kalmyk;"},{"id":"semetey-1-2013:p1156:b003:l001","ordinal":165361,"en":"I shall not wrestle and fail to win the prize!\""},{"id":"semetey-1-2013:p1156:b003:l002","ordinal":165362,"en":"How he lost his wits—"},{"id":"semetey-1-2013:p1156:b003:l003","ordinal":165363,"en":"I saw it with my own eyes,"},{"id":"semetey-1-2013:p1156:b003:l004","ordinal":165364,"en":"Hero Bagysh of the Zhediger"},{"id":"semetey-1-2013:p1156:b003:l005","ordinal":165365,"en":"Fleeing from among the people."},{"id":"semetey-1-2013:p1156:b003:l006","ordinal":165366,"en":"Growing angry with the khans,"},{"id":"semetey-1-2013:p1156:b003:l007","ordinal":165367,"en":"The lion, tiger Manas,"},{"id":"semetey-1-2013:p1156:b003:l008","ordinal":165368,"en":"Whipped his steed"},{"id":"semetey-1-2013:p1156:b003:l009","ordinal":165369,"en":"And rode toward Koshoy."},{"id":"semetey-1-2013:p1156:b003:l010","ordinal":165370,"en":"\"My uncle, elder Koshoy,"},{"id":"semetey-1-2013:p1156:b003:l011","ordinal":165371,"en":"Saint who has sheltered me!"},{"id":"semetey-1-2013:p1156:b003:l012","ordinal":165372,"en":"At the point of death, take one last meal:"},{"id":"semetey-1-2013:p1156:b003:l013","ordinal":165373,"en":"Against the black Kalmyk like an ox,"},{"id":"semetey-1-2013:p1156:b003:l014","ordinal":165374,"en":"Go down yourself, elder!"},{"id":"semetey-1-2013:p1156:b003:l015","ordinal":165375,"en":"They are a host lying in countless ranks;"},{"id":"semetey-1-2013:p1156:b003:l016","ordinal":165376,"en":"Among the scattered Muslims,"}]
