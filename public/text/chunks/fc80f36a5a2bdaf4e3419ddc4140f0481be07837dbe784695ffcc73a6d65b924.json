[{"id":"manas-2010:p1410:b001:l031","ordinal":60929,"en":"Over Beijing, which Solomon could not reach,"},{"id":"manas-2010:p1410:b001:l032","ordinal":60930,"en":"They now exercised rule;"},{"id":"manas-2010:p1410:b001:l033","ordinal":60931,"en":"Upon Beijing, which Alexander could not reach,"},{"id":"manas-2010:p1410:b001:l034","ordinal":60932,"en":"They now levied taxes."},{"id":"manas-2010:p1410:b001:l035","ordinal":60933,"en":"They made mares their slaughter meat;"},{"id":"manas-2010:p1410:b001:l036","ordinal":60934,"en":"Taking great levies and taxes,"},{"id":"manas-2010:p1410:b001:l037","ordinal":60935,"en":"They left many Chinese on foot."},{"id":"manas-2010:p1410:b001:l038","ordinal":60936,"en":"When the Muslim became khan,"},{"id":"manas-2010:p1410:b001:l039","ordinal":60937,"en":"Of Beijing in Kakan-Chin,"},{"id":"manas-2010:p1410:b001:l040","ordinal":60938,"en":"He plundered its riches."},{"id":"manas-2010:p1410:b001:l041","ordinal":60939,"en":"Bearing great levies and taxes,"},{"id":"manas-2010:p1410:b001:l042","ordinal":60940,"en":"The Chinese were left in torment."},{"id":"manas-2010:p1411:b001:l001","ordinal":60941,"en":"“One cauldron for every two households—"},{"id":"manas-2010:p1411:b001:l002","ordinal":60942,"en":"Keep yourselves alive,” he commanded."},{"id":"manas-2010:p1411:b001:l003","ordinal":60943,"en":"In gold, silver and precious stones,"},{"id":"manas-2010:p1411:b001:l004","ordinal":60944,"en":"He demanded and took tribute."},{"id":"manas-2010:p1411:b001:l005","ordinal":60945,"en":"From Esenkan’s people,"},{"id":"manas-2010:p1411:b001:l006","ordinal":60946,"en":"He gathered a countless multitude."},{"id":"manas-2010:p1411:b001:l007","ordinal":60947,"en":"Holding a feast for sixty days,"},{"id":"manas-2010:p1411:b001:l008","ordinal":60948,"en":"The Chinese man called Shuykuchu"},{"id":"manas-2010:p1411:b001:l009","ordinal":60949,"en":"He made a true Muslim."},{"id":"manas-2010:p1411:b001:l010","ordinal":60950,"en":"A Chinese man like Shuykuchu,"},{"id":"manas-2010:p1411:b001:l011","ordinal":60951,"en":"Having him cut with a sword,"},{"id":"manas-2010:p1411:b001:l012","ordinal":60952,"en":"Having him pressed down with an axe,"},{"id":"manas-2010:p1411:b001:l013","ordinal":60953,"en":"According to the Burut’s will,"},{"id":"manas-2010:p1411:b001:l014","ordinal":60954,"en":"Shuykuchu went along."},{"id":"manas-2010:p1411:b001:l015","ordinal":60955,"en":"Falsely a Muslim,"},{"id":"manas-2010:p1411:b001:l016","ordinal":60956,"en":"In truth remaining Chinese,"},{"id":"manas-2010:p1411:b001:l017","ordinal":60957,"en":"Shuykuchu went on living."},{"id":"manas-2010:p1411:b001:l018","ordinal":60958,"en":"Becoming a cook for Manas,"},{"id":"manas-2010:p1411:b001:l019","ordinal":60959,"en":"Shuykuchu kept entering his presence."},{"id":"manas-2010:p1411:b001:l020","ordinal":60960,"en":"How he conducted his affairs,"},{"id":"manas-2010:p1411:b001:l021","ordinal":60961,"en":"The weaknesses of Khan Manas,"},{"id":"manas-2010:p1411:b001:l022","ordinal":60962,"en":"Shuykuchu kept learning."},{"id":"manas-2010:p1411:b001:l023","ordinal":60963,"en":"His conduct and his deeds,"},{"id":"manas-2010:p1411:b001:l024","ordinal":60964,"en":"Shuykuchu kept writing down."},{"id":"manas-2010:p1411:b001:l025","ordinal":60965,"en":"In Beijing, where Solomon had not gone,"},{"id":"manas-2010:p1411:b001:l026","ordinal":60966,"en":"Having become a splendid khan,"},{"id":"manas-2010:p1411:b001:l027","ordinal":60967,"en":"Let us leave Manas thus;"},{"id":"manas-2010:p1411:b001:l028","ordinal":60968,"en":"Now let us begin the tale"},{"id":"manas-2010:p1411:b001:l029","ordinal":60969,"en":"Of him who fled to Beijing,"},{"id":"manas-2010:p1411:b001:l030","ordinal":60970,"en":"Let us begin with Kongurbay."},{"id":"manas-2010:p1411:b001:l031","ordinal":60971,"en":"To Inner Beijing itself,"},{"id":"manas-2010:p1411:b001:l032","ordinal":60972,"en":"Before Karykan,"},{"id":"manas-2010:p1411:b001:l033","ordinal":60973,"en":"Kongurbay had gone;"},{"id":"manas-2010:p1411:b001:l034","ordinal":60974,"en":"Throughout the world,"},{"id":"manas-2010:p1411:b001:l035","ordinal":60975,"en":"Kongurbay had sent word."},{"id":"manas-2010:p1411:b001:l036","ordinal":60976,"en":"“We have let the Muslims overcome us;"},{"id":"manas-2010:p1411:b001:l037","ordinal":60977,"en":"Esenkan’s Burulcha,"},{"id":"manas-2010:p1411:b001:l038","ordinal":60978,"en":"We have lost her to the Burut."},{"id":"manas-2010:p1411:b001:l039","ordinal":60979,"en":"In the fighting, khans died;"},{"id":"manas-2010:p1411:b001:l040","ordinal":60980,"en":"All the common soldiery died."},{"id":"manas-2010:p1411:b001:l041","ordinal":60981,"en":"The great wrestler with iron ears,"},{"id":"manas-2010:p1411:b001:l042","ordinal":60982,"en":"Kutan the Giant, went and was slain."},{"id":"manas-2010:p1412:b001:l001","ordinal":60983,"en":"With his forty lords at their head,"},{"id":"manas-2010:p1412:b001:l002","ordinal":60984,"en":"Ezkara, khan of the Manchu,"},{"id":"manas-2010:p1412:b001:l003","ordinal":60985,"en":"Was captured and bound."},{"id":"manas-2010:p1412:b001:l004","ordinal":60986,"en":"Of your Black Kalmyk people,"},{"id":"manas-2010:p1412:b001:l005","ordinal":60987,"en":"Dear Khan Zholoy died;"},{"id":"manas-2010:p1412:b001:l006","ordinal":60988,"en":"Among the khans of the Lower Sibe,"},{"id":"manas-2010:p1412:b001:l007","ordinal":60989,"en":"The wrestler Ylama died too."},{"id":"manas-2010:p1412:b001:l008","ordinal":60990,"en":"She was khan of the Torgut;"},{"id":"manas-2010:p1412:b001:l009","ordinal":60991,"en":"Though a woman, Kanyshay"},{"id":"manas-2010:p1412:b001:l010","ordinal":60992,"en":"Was a soul we relied upon."},{"id":"manas-2010:p1412:b001:l011","ordinal":60993,"en":"When the Burut swarmed in,"},{"id":"manas-2010:p1412:b001:l012","ordinal":60994,"en":"She died among the Torgut."},{"id":"manas-2010:p1412:b001:l013","ordinal":60995,"en":"Of your people called Solon,"},{"id":"manas-2010:p1412:b001:l014","ordinal":60996,"en":"Remaining where they had not died,"},{"id":"manas-2010:p1412:b001:l015","ordinal":60997,"en":"Fighting six months without rest,"},{"id":"manas-2010:p1412:b001:l016","ordinal":60998,"en":"Esenkan’s Börüköz—"},{"id":"manas-2010:p1412:b001:l017","ordinal":60999,"en":"A hero like him died."},{"id":"manas-2010:p1412:b001:l018","ordinal":61000,"en":"I had fierce battle fought;"},{"id":"manas-2010:p1412:b001:l019","ordinal":61001,"en":"Mighty, fierce heroes"},{"id":"manas-2010:p1412:b001:l020","ordinal":61002,"en":"I lost to the Burut."},{"id":"manas-2010:p1412:b001:l021","ordinal":61003,"en":"Now I am afraid:"},{"id":"manas-2010:p1412:b001:l022","ordinal":61004,"en":"‘He will plunder my riches;"},{"id":"manas-2010:p1412:b001:l023","ordinal":61005,"en":"If we do not pay his tribute in full,"},{"id":"manas-2010:p1412:b001:l024","ordinal":61006,"en":"If we do not obey his words,"},{"id":"manas-2010:p1412:b001:l025","ordinal":61007,"en":"Manas will bring torment,’ I fear."},{"id":"manas-2010:p1412:b001:l026","ordinal":61008,"en":"Their Manas is a mighty hero,"},{"id":"manas-2010:p1412:b001:l027","ordinal":61009,"en":"A lion guarded by the unseen patron."},{"id":"manas-2010:p1412:b001:l028","ordinal":61010,"en":"Set the others aside:"},{"id":"manas-2010:p1412:b001:l029","ordinal":61011,"en":"This Beijing where we stand,"},{"id":"manas-2010:p1412:b001:l030","ordinal":61012,"en":"He is a hero who could slaughter it alone."},{"id":"manas-2010:p1412:b001:l031","ordinal":61013,"en":"Chinese and Burut intermingled,"},{"id":"manas-2010:p1412:b001:l032","ordinal":61014,"en":"When the great battle took place,"},{"id":"manas-2010:p1412:b001:l033","ordinal":61015,"en":"Had it not been for Khan Madykan,"},{"id":"manas-2010:p1412:b001:l034","ordinal":61016,"en":"He would have resolved to strike;"},{"id":"manas-2010:p1412:b001:l035","ordinal":61017,"en":"Upon your heads, Karykan,"},{"id":"manas-2010:p1412:b001:l036","ordinal":61018,"en":"He would have done wonders no other man could do!"},{"id":"manas-2010:p1412:b001:l037","ordinal":61019,"en":"Dust rose from the intervening ground;"},{"id":"manas-2010:p1412:b001:l038","ordinal":61020,"en":"The fugitive pig, knower of secrets,"},{"id":"manas-2010:p1412:b001:l039","ordinal":61021,"en":"Almambet too came out to battle."},{"id":"manas-2010:p1412:b001:l040","ordinal":61022,"en":"Syrgak, Ulak Khan’s son—"},{"id":"manas-2010:p1412:b001:l041","ordinal":61023,"en":"I have never seen such a hero."},{"id":"manas-2010:p1412:b001:l042","ordinal":61024,"en":"He shook me fully awake;"},{"id":"manas-2010:p1413:b001:l001","ordinal":61025,"en":"Syrgak slaughtered"},{"id":"manas-2010:p1413:b001:l002","ordinal":61026,"en":"Your mighty Chinese people."},{"id":"manas-2010:p1413:b001:l003","ordinal":61027,"en":"Tall of body and broad of shoulder,"},{"id":"manas-2010:p1413:b001:l004","ordinal":61028,"en":"He is a hero equal to Manas,"},{"id":"manas-2010:p1413:b001:l005","ordinal":61029,"en":"Chubak, Akbaltay’s son."},{"id":"manas-2010:p1413:b001:l006","ordinal":61030,"en":"Finding words in a sudden crisis,"},{"id":"manas-2010:p1413:b001:l007","ordinal":61031,"en":"Finding eyes in darkness,"},{"id":"manas-2010:p1413:b001:l008","ordinal":61032,"en":"Finding a fortified ridge,"},{"id":"manas-2010:p1413:b001:l009","ordinal":61033,"en":"He is a hero who girds himself with resolve,"},{"id":"manas-2010:p1413:b001:l010","ordinal":61034,"en":"The one called champion Bakay."},{"id":"manas-2010:p1413:b001:l011","ordinal":61035,"en":"A lion among humankind,"},{"id":"manas-2010:p1413:b001:l012","ordinal":61036,"en":"All of those men,"},{"id":"manas-2010:p1413:b001:l013","ordinal":61037,"en":"Their Manas, who keeps them together,"},{"id":"manas-2010:p1413:b001:l014","ordinal":61038,"en":"Has the might of a mountain."},{"id":"manas-2010:p1413:b001:l015","ordinal":61039,"en":"At one glance, he is one man;"},{"id":"manas-2010:p1413:b001:l016","ordinal":61040,"en":"Approach him, and he is a thousand men."},{"id":"manas-2010:p1413:b001:l017","ordinal":61041,"en":"If I charge him from behind,"},{"id":"manas-2010:p1413:b001:l018","ordinal":61042,"en":"He has a dragon’s appearance."},{"id":"manas-2010:p1413:b001:l019","ordinal":61043,"en":"When he roars and extends his spear,"},{"id":"manas-2010:p1413:b001:l020","ordinal":61044,"en":"He has the terror of six thousand heroes."},{"id":"manas-2010:p1413:b001:l021","ordinal":61045,"en":"Throughout the face of the earth,"},{"id":"manas-2010:p1413:b001:l022","ordinal":61046,"en":"Respect for Manas has spread."},{"id":"manas-2010:p1413:b001:l023","ordinal":61047,"en":"His companions who came from everywhere,"},{"id":"manas-2010:p1413:b001:l024","ordinal":61048,"en":"Just like Manas himself,"},{"id":"manas-2010:p1413:b001:l025","ordinal":61049,"en":"Had become Khan Manas."},{"id":"manas-2010:p1413:b001:l026","ordinal":61050,"en":"Not just anyone could torment"},{"id":"manas-2010:p1413:b001:l027","ordinal":61051,"en":"This Manas who has come."},{"id":"manas-2010:p1413:b001:l028","ordinal":61052,"en":"Among the people of the whole wide world,"},{"id":"manas-2010:p1413:b001:l029","ordinal":61053,"en":"No champion remains who can resist him."},{"id":"manas-2010:p1413:b001:l030","ordinal":61054,"en":"When they face and enter the enemy,"},{"id":"manas-2010:p1413:b001:l031","ordinal":61055,"en":"If you ask of the champions,"},{"id":"manas-2010:p1413:b001:l032","ordinal":61056,"en":"Almambet and Chubak are there too;"},{"id":"manas-2010:p1413:b001:l033","ordinal":61057,"en":"To enter battle shouting,"},{"id":"manas-2010:p1413:b001:l034","ordinal":61058,"en":"His khans Ajybay and Bakay are there."},{"id":"manas-2010:p1413:b001:l035","ordinal":61059,"en":"Girls, gold and precious stones,"},{"id":"manas-2010:p1413:b001:l036","ordinal":61060,"en":"If we do not give them without hesitation,"},{"id":"manas-2010:p1413:b001:l037","ordinal":61061,"en":"He can bring a terrible spectacle upon us."},{"id":"manas-2010:p1413:b001:l038","ordinal":61062,"en":"When his Syrgak exerts himself,"},{"id":"manas-2010:p1413:b001:l039","ordinal":61063,"en":"He is like hardened red iron;"},{"id":"manas-2010:p1413:b001:l040","ordinal":61064,"en":"When his Manas truly roars,"},{"id":"manas-2010:p1413:b001:l041","ordinal":61065,"en":"His bulk is equal to a mountain.”"},{"id":"manas-2010:p1413:b001:l042","ordinal":61066,"en":"So many thoughts would not fit in his breast;"},{"id":"manas-2010:p1414:b001:l001","ordinal":61067,"en":"When he went to his great khan,"},{"id":"manas-2010:p1414:b001:l002","ordinal":61068,"en":"Kongurbay of the Chinese,"},{"id":"manas-2010:p1414:b001:l003","ordinal":61069,"en":"His tears streamed across ten fields."},{"id":"manas-2010:p1414:b001:l004","ordinal":61070,"en":"To Kongurbay himself,"},{"id":"manas-2010:p1414:b001:l005","ordinal":61071,"en":"Karykan stood and said:"},{"id":"manas-2010:p1414:b001:l006","ordinal":61072,"en":"“Of Beijing’s forty gates,"},{"id":"manas-2010:p1414:b001:l007","ordinal":61073,"en":"Have you seen one doorway?"},{"id":"manas-2010:p1414:b001:l008","ordinal":61074,"en":"Opening toward the setting sun,"},{"id":"manas-2010:p1414:b001:l009","ordinal":61075,"en":"‘Until the age of Judgment Day,"},{"id":"manas-2010:p1414:b001:l010","ordinal":61076,"en":"The city of Beijing shall not be taken,’"},{"id":"manas-2010:p1414:b001:l011","ordinal":61077,"en":"Is written upon its gate."},{"id":"manas-2010:p1414:b001:l012","ordinal":61078,"en":"‘Beijing shall not die of hunger,’"},{"id":"manas-2010:p1414:b001:l013","ordinal":61079,"en":"Upon this standing Beijing"},{"id":"manas-2010:p1414:b001:l014","ordinal":61080,"en":"God’s radiance has been scattered."},{"id":"manas-2010:p1414:b001:l015","ordinal":61081,"en":"This is the land upon which light poured down;"},{"id":"manas-2010:p1414:b001:l016","ordinal":61082,"en":"Thirty men, from ancient times,"},{"id":"manas-2010:p1414:b001:l017","ordinal":61083,"en":"Mounted golden thrones in this place."},{"id":"manas-2010:p1414:b001:l018","ordinal":61084,"en":"Solomon came to Beijing;"},{"id":"manas-2010:p1414:b001:l019","ordinal":61085,"en":"He was a hero who turned back."},{"id":"manas-2010:p1414:b001:l020","ordinal":61086,"en":"Untouched by the assault of a hostile army,"},{"id":"manas-2010:p1414:b001:l021","ordinal":61087,"en":"It is a people that remained unharmed."},{"id":"manas-2010:p1414:b001:l022","ordinal":61088,"en":"Knowing Manas’s valor,"},{"id":"manas-2010:p1414:b001:l023","ordinal":61089,"en":"Though I pressed the Burut many times,"},{"id":"manas-2010:p1414:b001:l024","ordinal":61090,"en":"I am the one who could not take them."},{"id":"manas-2010:p1414:b001:l025","ordinal":61091,"en":"Against this city of Beijing,"},{"id":"manas-2010:p1414:b001:l026","ordinal":61092,"en":"So many champions rode;"},{"id":"manas-2010:p1414:b001:l027","ordinal":61093,"en":"‘An enemy of discord shall arise within,"},{"id":"manas-2010:p1414:b001:l028","ordinal":61094,"en":"And over this standing Beijing"},{"id":"manas-2010:p1414:b001:l029","ordinal":61095,"en":"He shall rule for six months’—"},{"id":"manas-2010:p1414:b001:l030","ordinal":61096,"en":"Khan Manas, six years before,"},{"id":"manas-2010:p1414:b001:l031","ordinal":61097,"en":"Was recorded in our register."},{"id":"manas-2010:p1414:b001:l032","ordinal":61098,"en":"That standing Manas—"},{"id":"manas-2010:p1414:b001:l033","ordinal":61099,"en":"Those who heard the news grieved:"},{"id":"manas-2010:p1414:b001:l034","ordinal":61100,"en":"‘Almambet and Manas shall unite"},{"id":"manas-2010:p1414:b001:l035","ordinal":61101,"en":"And take the rule of Beijing,’"},{"id":"manas-2010:p1414:b001:l036","ordinal":61102,"en":"Was written in its book."},{"id":"manas-2010:p1414:b001:l037","ordinal":61103,"en":"Manas shall be khan for six months;"},{"id":"manas-2010:p1414:b001:l038","ordinal":61104,"en":"After that, there shall be peace."},{"id":"manas-2010:p1414:b001:l039","ordinal":61105,"en":"If he takes tribute without sparing,"},{"id":"manas-2010:p1414:b001:l040","ordinal":61106,"en":"Do not cling to wealth.”"},{"id":"manas-2010:p1414:b001:l041","ordinal":61107,"en":"Speaking thus, Karykan"},{"id":"manas-2010:p1414:b001:l042","ordinal":61108,"en":"Now showed terrible wrath,"}]
