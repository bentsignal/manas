[{"id":"sayakbay-ms-current144:pdf007:l019","ordinal":391937,"en":"All clamoring with one purpose."},{"id":"sayakbay-ms-current144:pdf007:l020","ordinal":391938,"en":"Should the born heroes remain behind?"},{"id":"sayakbay-ms-current144:pdf007:l021","ordinal":391939,"en":"Let us heed his words."},{"id":"sayakbay-ms-current144:pdf007:l023","ordinal":391940,"en":"Let us give them to Seytek."},{"id":"sayakbay-ms-current144:pdf007:l024","ordinal":391941,"en":"Let us notify the people,"},{"id":"sayakbay-ms-current144:pdf007:l025","ordinal":391942,"en":"[Bestowing?] the golden throne,"},{"id":"sayakbay-ms-current144:pdf007:l026","ordinal":391943,"en":"Appoint him and enthrone him,"},{"id":"sayakbay-ms-current144:pdf007:l027","ordinal":391944,"en":"Let us heed his words."},{"id":"sayakbay-ms-current144:pdf007:l028","ordinal":391945,"en":"Of the hero's surviving son,"},{"id":"sayakbay-ms-current144:pdf007:l029","ordinal":391946,"en":"Let us entrust him with authority."},{"id":"sayakbay-ms-current144:pdf007:l030","ordinal":391947,"en":"Let us notify the people,"},{"id":"sayakbay-ms-current144:pdf007:l031","ordinal":391948,"en":"The hero's surviving son,"},{"id":"sayakbay-ms-current144:pdf007:l032","ordinal":391949,"en":"For the white-capped Kyrgyz,"},{"id":"sayakbay-ms-current144:pdf007:l033","ordinal":391950,"en":"Let us raise him as khan."},{"id":"sayakbay-ms-current144:pdf008:l001","ordinal":391951,"en":"The reason for raising a khan:"},{"id":"sayakbay-ms-current144:pdf008:l002","ordinal":391952,"en":"We have the Russians [to summon?],"},{"id":"sayakbay-ms-current144:pdf008:l003","ordinal":391953,"en":"There are Kalmyks […]"},{"id":"sayakbay-ms-current144:pdf008:l004","ordinal":391954,"en":"There are mighty warriors […]"},{"id":"sayakbay-ms-current144:pdf008:l005","ordinal":391955,"en":"There are many rival enemies,"},{"id":"sayakbay-ms-current144:pdf008:l006","ordinal":391956,"en":"Ascending Ala-Too,"},{"id":"sayakbay-ms-current144:pdf008:l007","ordinal":391957,"en":"The Kyrgyz have their migrating camps."},{"id":"sayakbay-ms-current144:pdf008:l008","ordinal":391958,"en":"They would attack if able,"},{"id":"sayakbay-ms-current144:pdf008:l009","ordinal":391959,"en":"Rending lungs and spilling gall,"},{"id":"sayakbay-ms-current144:pdf008:l010","ordinal":391960,"en":"There is the populous Kyrgyz nation."},{"id":"sayakbay-ms-current144:pdf008:l011","ordinal":391961,"en":"There are many enemies to fight."},{"id":"sayakbay-ms-current144:pdf008:l015","ordinal":391962,"en":"Quickly invoking Baabedin,"},{"id":"sayakbay-ms-current144:pdf008:l017","ordinal":391963,"en":"Vast herds, worldly possessions,"},{"id":"sayakbay-ms-current144:pdf009:l001","ordinal":391964,"en":"The Kyrgyz of Ala-Too,"},{"id":"sayakbay-ms-current144:pdf009:l006","ordinal":391965,"en":"Black-bellied, blue-backed,"},{"id":"sayakbay-ms-current144:pdf009:l010","ordinal":391966,"en":"He was inscribed in their records."},{"id":"sayakbay-ms-current144:pdf010:l024","ordinal":391967,"en":"Of seething Kakanchy,"},{"id":"sayakbay-ms-current144:pdf011:l014","ordinal":391968,"en":"The youngest of sixty jaysangs,"},{"id":"sayakbay-ms-current144:pdf011:l016","ordinal":391969,"en":"The ridge’s pavilion with guy ropes,"},{"id":"sayakbay-ms-current144:pdf011:l020","ordinal":391970,"en":"Bearing a blue-steel spear,"},{"id":"sayakbay-ms-current144:pdf011:l031","ordinal":391971,"en":"Baikongur was a sovereign,"},{"id":"sayakbay-ms-current144:pdf012:l011","ordinal":391972,"en":"The once seething Kakan,"},{"id":"sayakbay-ms-current144:pdf012:l016","ordinal":391973,"en":"He ruled all Beijing,"},{"id":"sayakbay-ms-current144:pdf013:l020","ordinal":391974,"en":"While he ruled,"},{"id":"sayakbay-ms-current144:pdf013:l028","ordinal":391975,"en":"Those who opposed him,"},{"id":"sayakbay-ms-current144:pdf013:l029","ordinal":391976,"en":"The tether from their caps,"},{"id":"sayakbay-ms-current144:pdf013:l030","ordinal":391977,"en":"While he cut it away,"},{"id":"sayakbay-ms-current144:pdf013:l031","ordinal":391978,"en":"Kakanchy's golden throne,"},{"id":"sayakbay-ms-current144:pdf014:l002","ordinal":391979,"en":"While he ruled them,"},{"id":"sayakbay-ms-current144:pdf014:l006","ordinal":391980,"en":"While he ruled,"},{"id":"sayakbay-ms-current144:pdf014:l007","ordinal":391981,"en":"This wondrous, transient world,"},{"id":"sayakbay-ms-current144:pdf014:l026","ordinal":391982,"en":"Despaired of their lives,"},{"id":"sayakbay-ms-current144:pdf014:l032","ordinal":391983,"en":"When dueling with spears,"},{"id":"sayakbay-ms-current144:pdf015:l006","ordinal":391984,"en":"He had studied wondrous arts,"},{"id":"sayakbay-ms-current144:pdf015:l020","ordinal":391985,"en":"That scorched, raging wretch,"},{"id":"sayakbay-ms-current144:pdf015:l031","ordinal":391986,"en":"Despaired of their lives."},{"id":"sayakbay-ms-current144:pdf016:l016","ordinal":391987,"en":"All those who remained,"},{"id":"sayakbay-ms-current144:pdf016:l017","ordinal":391988,"en":"Fearing terrible upheaval,"},{"id":"sayakbay-ms-current144:pdf016:l018","ordinal":391989,"en":"Despaired of their lives,"},{"id":"sayakbay-ms-current144:pdf016:l020","ordinal":391990,"en":"Asking what had happened to the khan,"},{"id":"sayakbay-ms-current144:pdf016:l029","ordinal":391991,"en":"Despairing of their lives,"},{"id":"sayakbay-ms-current144:pdf017:l002","ordinal":391992,"en":"Do not ask about his tower."},{"id":"sayakbay-ms-current144:pdf017:l018","ordinal":391993,"en":"He too had assembled them."},{"id":"sayakbay-ms-current144:pdf017:l023","ordinal":391994,"en":"[Bound like a stone mist?],"},{"id":"sayakbay-ms-current144:pdf018:l005","ordinal":391995,"en":"He had poured into its foundations,"},{"id":"sayakbay-ms-current144:pdf018:l011","ordinal":391996,"en":"That scorched, raging wretch,"},{"id":"sayakbay-ms-current144:pdf018:l017","ordinal":391997,"en":"Do not ask about his tower,"},{"id":"sayakbay-ms-current144:pdf019:l003","ordinal":391998,"en":"That scorched, raging wretch,"},{"id":"sayakbay-ms-current144:pdf019:l014","ordinal":391999,"en":"The enemies who fought him,"},{"id":"sayakbay-ms-current144:pdf019:l032","ordinal":392000,"en":"[Uncertain: Bedoo's … places.]"},{"id":"sayakbay-ms-current144:pdf020:l001","ordinal":392001,"en":"[May he devastate and burn them?],"},{"id":"sayakbay-ms-current144:pdf020:l002","ordinal":392002,"en":"You have seen suffering […],"},{"id":"sayakbay-ms-current144:pdf020:l003","ordinal":392003,"en":"Without razing it utterly,"},{"id":"sayakbay-ms-current144:pdf020:l014","ordinal":392004,"en":"The sorcerer guarding the gate,"},{"id":"sayakbay-ms-current144:pdf020:l017","ordinal":392005,"en":"Speaking softly, then firmly,"},{"id":"sayakbay-ms-current144:pdf020:l018","ordinal":392006,"en":"He began his speech."},{"id":"sayakbay-ms-current144:pdf021:l016","ordinal":392007,"en":"His fortune deserted him,"},{"id":"sayakbay-ms-current144:pdf021:l021","ordinal":392008,"en":"Came through my royal father,"},{"id":"sayakbay-ms-current144:pdf021:l024","ordinal":392009,"en":"The moon waned and days passed,"},{"id":"sayakbay-ms-current144:pdf021:l031","ordinal":392010,"en":"He reached ninety-five years,"},{"id":"sayakbay-ms-current144:pdf022:l006","ordinal":392011,"en":"He pursued vengeance for Manas."},{"id":"sayakbay-ms-current144:pdf022:l018","ordinal":392012,"en":"Of this faithless world,"},{"id":"sayakbay-ms-current144:pdf022:l024","ordinal":392013,"en":"If my darling lives,"},{"id":"sayakbay-ms-current144:pdf022:l027","ordinal":392014,"en":"A father's vengeance remained,"},{"id":"sayakbay-ms-current144:pdf022:l028","ordinal":392015,"en":"His grandfather died, leaving vengeance."},{"id":"sayakbay-ms-current144:pdf023:l002","ordinal":392016,"en":"He will unleash a slaughter,"},{"id":"sayakbay-ms-current144:pdf023:l005","ordinal":392017,"en":"Deepest sorrow was revealed,"},{"id":"sayakbay-ms-current144:pdf023:l006","ordinal":392018,"en":"Saying, the Burut humiliated us,"},{"id":"sayakbay-ms-current144:pdf023:l007","ordinal":392019,"en":"We suffered disgrace and hardship,"},{"id":"sayakbay-ms-current144:pdf023:l008","ordinal":392020,"en":"All the neighboring peoples,"},{"id":"sayakbay-ms-current144:pdf023:l009","ordinal":392021,"en":"Young and old alike,"},{"id":"sayakbay-ms-current144:pdf023:l010","ordinal":392022,"en":"[Selecting them, he slaughtered the people?],"},{"id":"sayakbay-ms-current144:pdf023:l011","ordinal":392023,"en":"He wielded such a heavy fist,"},{"id":"sayakbay-ms-current144:pdf023:l012","ordinal":392024,"en":"The aftermath was a calamity,"},{"id":"sayakbay-ms-current144:pdf023:l013","ordinal":392025,"en":"He mowed down those he encountered,"},{"id":"sayakbay-ms-current144:pdf023:l014","ordinal":392026,"en":"My grandfather in his old age,"},{"id":"sayakbay-ms-current144:pdf023:l015","ordinal":392027,"en":"The attacking Kyrgyz cut down,"},{"id":"sayakbay-ms-current144:pdf023:l016","ordinal":392028,"en":"He crushed [the multitude?] severely,"},{"id":"sayakbay-ms-current144:pdf023:l017","ordinal":392029,"en":"The Chinese people of forty khans,"},{"id":"sayakbay-ms-current144:pdf023:l018","ordinal":392030,"en":"He left leaderless and poor,"},{"id":"sayakbay-ms-current144:pdf023:l019","ordinal":392031,"en":"He inflicted extreme oppression,"},{"id":"sayakbay-ms-current144:pdf023:l020","ordinal":392032,"en":"That commanding, raging wretch,"},{"id":"sayakbay-ms-current144:pdf023:l021","ordinal":392033,"en":"He acted by spreading terror,"},{"id":"sayakbay-ms-current144:pdf023:l022","ordinal":392034,"en":"He inflicted [terrible?] plunder,"},{"id":"sayakbay-ms-current144:pdf023:l023","ordinal":392035,"en":"The khans adorned with stones,"},{"id":"sayakbay-ms-current144:pdf023:l024","ordinal":392036,"en":"He smashed to pieces,"},{"id":"sayakbay-ms-current144:pdf023:l025","ordinal":392037,"en":"What devastation he wrought,"},{"id":"sayakbay-ms-current144:pdf023:l026","ordinal":392038,"en":"The grieving people cried out,"},{"id":"sayakbay-ms-current144:pdf023:l027","ordinal":392039,"en":"How many of Kakan lamented,"},{"id":"sayakbay-ms-current144:pdf023:l028","ordinal":392040,"en":"Through his fury, many souls,"},{"id":"sayakbay-ms-current144:pdf023:l029","ordinal":392041,"en":"[Had not yet looked upon it?],"},{"id":"sayakbay-ms-current144:pdf023:l031","ordinal":392042,"en":"The dignitaries adorned with stones,"},{"id":"sayakbay-ms-current144:pdf023:l032","ordinal":392043,"en":"The capable rulers of the people,"},{"id":"sayakbay-ms-current144:pdf023:l033","ordinal":392044,"en":"Kakan's foremost leaders,"},{"id":"sayakbay-ms-current144:pdf024:l001","ordinal":392045,"en":"The Burut slew them all,"},{"id":"sayakbay-ms-current144:pdf024:l002","ordinal":392046,"en":"That scorched, raging wretch,"},{"id":"sayakbay-ms-current144:pdf024:l003","ordinal":392047,"en":"Committing monstrous deeds,"},{"id":"sayakbay-ms-current144:pdf024:l004","ordinal":392048,"en":"Cold, unapproachable Beijing,"},{"id":"sayakbay-ms-current144:pdf024:l005","ordinal":392049,"en":"He leveled its ancient fortress,"},{"id":"sayakbay-ms-current144:pdf024:l006","ordinal":392050,"en":"The Chinese tribes as kin,"},{"id":"sayakbay-ms-current144:pdf024:l007","ordinal":392051,"en":"Every one endured humiliation,"},{"id":"sayakbay-ms-current144:pdf024:l008","ordinal":392052,"en":"Its khans, lords and gates,"},{"id":"sayakbay-ms-current144:pdf024:l009","ordinal":392053,"en":"His terrible fury was known,"},{"id":"sayakbay-ms-current144:pdf024:l010","ordinal":392054,"en":"The devastation wrought by the Burut,"},{"id":"sayakbay-ms-current144:pdf024:l011","ordinal":392055,"en":"From ancient times, among the Chinese,"},{"id":"sayakbay-ms-current144:pdf024:l012","ordinal":392056,"en":"Was inscribed in their records,"},{"id":"sayakbay-ms-current144:pdf024:l013","ordinal":392057,"en":"Pouring out fury, wringing out blood,"},{"id":"sayakbay-ms-current144:pdf024:l014","ordinal":392058,"en":"After bloodthirsty Manas,"},{"id":"sayakbay-ms-current144:pdf024:l015","ordinal":392059,"en":"Brave Semetey, Manas's son,"},{"id":"sayakbay-ms-current144:pdf024:l016","ordinal":392060,"en":"His enormous destruction,"},{"id":"sayakbay-ms-current144:pdf024:l017","ordinal":392061,"en":"Of the great Chinese nation,"},{"id":"sayakbay-ms-current144:pdf024:l018","ordinal":392062,"en":"Was entered in its records."},{"id":"sayakbay-ms-current144:pdf024:l020","ordinal":392063,"en":"Killing and troubling the people,"},{"id":"sayakbay-ms-current144:pdf024:l021","ordinal":392064,"en":"Of overturned Kakan,"},{"id":"sayakbay-ms-current144:pdf024:l022","ordinal":392065,"en":"Spreading nets in its forests,"},{"id":"sayakbay-ms-current144:pdf024:l023","ordinal":392066,"en":"Attacking the scattered people,"},{"id":"sayakbay-ms-current144:pdf024:l024","ordinal":392067,"en":"Wherever white yurts stood,"},{"id":"sayakbay-ms-current144:pdf024:l025","ordinal":392068,"en":"He slew your distant forefather,"},{"id":"sayakbay-ms-current144:pdf024:l026","ordinal":392069,"en":"In this ravaged Beijing,"},{"id":"sayakbay-ms-current144:pdf024:l027","ordinal":392070,"en":"Not one elder remained."},{"id":"sayakbay-ms-current144:pdf024:l032","ordinal":392071,"en":"Many [Kaldai?] who saw his bearing,"},{"id":"sayakbay-ms-current144:pdf025:l001","ordinal":392072,"en":"No one could find a remedy,"},{"id":"sayakbay-ms-current144:pdf025:l002","ordinal":392073,"en":"Despairing of their lives,"},{"id":"sayakbay-ms-current144:pdf025:l003","ordinal":392074,"en":"Before mighty Kite,"},{"id":"sayakbay-ms-current144:pdf025:l004","ordinal":392075,"en":"They gathered at his call,"},{"id":"sayakbay-ms-current144:pdf025:l005","ordinal":392076,"en":"Finding no suitable words,"},{"id":"sayakbay-ms-current144:pdf025:l006","ordinal":392077,"en":"Neither turning nor shaking their heads,"},{"id":"sayakbay-ms-current144:pdf025:l007","ordinal":392078,"en":"They despaired, thinking themselves lost,"},{"id":"sayakbay-ms-current144:pdf025:l008","ordinal":392079,"en":"Those who came murmured,"},{"id":"sayakbay-ms-current144:pdf025:l009","ordinal":392080,"en":"No one could endure his wrath,"},{"id":"sayakbay-ms-current144:pdf025:l010","ordinal":392081,"en":"They did not speak boldly to their khan,"},{"id":"sayakbay-ms-current144:pdf025:l011","ordinal":392082,"en":"Shuffling and digging at the ground,"},{"id":"sayakbay-ms-current144:pdf025:l012","ordinal":392083,"en":"Like twigs cast into water,"},{"id":"sayakbay-ms-current144:pdf025:l013","ordinal":392084,"en":"They swayed, finding no solution,"},{"id":"sayakbay-ms-current144:pdf025:l014","ordinal":392085,"en":"[The khan demanded service?],"},{"id":"sayakbay-ms-current144:pdf025:l015","ordinal":392086,"en":"Reasoned words were needed,"},{"id":"sayakbay-ms-current144:pdf025:l016","ordinal":392087,"en":"The khan, now a dragon,"},{"id":"sayakbay-ms-current144:pdf025:l017","ordinal":392088,"en":"Needed a hero to approach cautiously."},{"id":"sayakbay-ms-current144:pdf025:l018","ordinal":392089,"en":"Wondering what befell the khan,"},{"id":"sayakbay-ms-current144:pdf025:l019","ordinal":392090,"en":"The multitude witnessed his wrath,"},{"id":"sayakbay-ms-current144:pdf025:l020","ordinal":392091,"en":"He was a great man and a lion,"},{"id":"sayakbay-ms-current144:pdf025:l021","ordinal":392092,"en":"His menace extraordinary, his venom strong,"},{"id":"sayakbay-ms-current144:pdf025:l022","ordinal":392093,"en":"When told, he performed the task properly,"},{"id":"sayakbay-ms-current144:pdf025:l023","ordinal":392094,"en":"When he braced himself resolutely,"},{"id":"sayakbay-ms-current144:pdf025:l024","ordinal":392095,"en":"That wavering, god-cursed man."},{"id":"sayakbay-ms-current144:pdf025:l025","ordinal":392096,"en":"Do not ask about Kite,"},{"id":"sayakbay-ms-current144:pdf025:l026","ordinal":392097,"en":"His imposing stature did not diminish,"},{"id":"sayakbay-ms-current144:pdf026:l003","ordinal":392098,"en":"He began commanding from the tower,"},{"id":"sayakbay-ms-current144:pdf026:l008","ordinal":392099,"en":"Who could say a second word?"},{"id":"sayakbay-ms-current144:pdf026:l022","ordinal":392100,"en":"At Kentung in Kendeme,"},{"id":"sayakbay-ms-current144:pdf027:l006","ordinal":392101,"en":"Those schooled in wondrous arts,"},{"id":"sayakbay-ms-current144:pdf027:l021","ordinal":392102,"en":"Summer clouds to winter days,"},{"id":"sayakbay-ms-current144:pdf027:l023","ordinal":392103,"en":"The dark khan from Beijing,"},{"id":"sayakbay-ms-current144:pdf028:l001","ordinal":392104,"en":"The worthy rulers of the people,"},{"id":"sayakbay-ms-current144:pdf028:l002","ordinal":392105,"en":"Those of [equally?] rough conduct,"},{"id":"sayakbay-ms-current144:pdf028:l003","ordinal":392106,"en":"Bad and good gathered together,"},{"id":"sayakbay-ms-current144:pdf028:l004","ordinal":392107,"en":"Chongbilgich, schooled in wonders,"},{"id":"sayakbay-ms-current144:pdf028:l005","ordinal":392108,"en":"The mighty champion, great [Tongus?],"},{"id":"sayakbay-ms-current144:pdf028:l006","ordinal":392109,"en":"His distant forefather Kara Joy,"},{"id":"sayakbay-ms-current144:pdf028:l007","ordinal":392110,"en":"That warrior who bore the banner,"},{"id":"sayakbay-ms-current144:pdf028:l008","ordinal":392111,"en":"The people standing beneath the banner,"},{"id":"sayakbay-ms-current144:pdf028:l009","ordinal":392112,"en":"His own father Kojojash,"},{"id":"sayakbay-ms-current144:pdf028:l010","ordinal":392113,"en":"A warrior who oversaw the world,"},{"id":"sayakbay-ms-current144:pdf028:l011","ordinal":392114,"en":"Chongbilgich, descended from Kojojash,"},{"id":"sayakbay-ms-current144:pdf028:l012","ordinal":392115,"en":"Wiser still than his forefather,"},{"id":"sayakbay-ms-current144:pdf028:l013","ordinal":392116,"en":"Beyond champions and others,"},{"id":"sayakbay-ms-current144:pdf028:l014","ordinal":392117,"en":"The foremost sorcerer and distinguished man,"},{"id":"sayakbay-ms-current144:pdf028:l015","ordinal":392118,"en":"Wiser than the spearmen,"},{"id":"sayakbay-ms-current144:pdf028:l016","ordinal":392119,"en":"[He did not rage like a savage?],"},{"id":"sayakbay-ms-current144:pdf028:l017","ordinal":392120,"en":"Among khans such as these,"},{"id":"sayakbay-ms-current144:pdf028:l018","ordinal":392121,"en":"The raging wretch spared none,"},{"id":"sayakbay-ms-current144:pdf028:l019","ordinal":392122,"en":"[His head full of much wisdom?],"},{"id":"sayakbay-ms-current144:pdf028:l020","ordinal":392123,"en":"Beijing's people gathered,"},{"id":"sayakbay-ms-current144:pdf028:l021","ordinal":392124,"en":"Slaughtering mules, boars and camels,"},{"id":"sayakbay-ms-current144:pdf028:l022","ordinal":392125,"en":"[We washed in the idol temple?],"},{"id":"sayakbay-ms-current144:pdf028:l023","ordinal":392126,"en":"They held a feast for their deity,"},{"id":"sayakbay-ms-current144:pdf028:l024","ordinal":392127,"en":"[He had them tested at the tablecloth?],"},{"id":"sayakbay-ms-current144:pdf028:l025","ordinal":392128,"en":"He entrusted it to skilled craftsmen,"},{"id":"sayakbay-ms-current144:pdf028:l026","ordinal":392129,"en":"[Without appointing a lord in Beijing?],"},{"id":"sayakbay-ms-current144:pdf028:l027","ordinal":392130,"en":"Firmly fastening his collared coat,"},{"id":"sayakbay-ms-current144:pdf028:l028","ordinal":392131,"en":"Gathering many of Beijing's people,"},{"id":"sayakbay-ms-current144:pdf028:l029","ordinal":392132,"en":"He made the promise firm,"},{"id":"sayakbay-ms-current144:pdf028:l030","ordinal":392133,"en":"At the foot of the golden throne,"},{"id":"sayakbay-ms-current144:pdf028:l031","ordinal":392134,"en":"To serve the khan, he said."},{"id":"sayakbay-ms-current144:pdf029:l001","ordinal":392135,"en":"If fire consumes the earth's surface,"},{"id":"sayakbay-ms-current144:pdf029:l002","ordinal":392136,"en":"If mountains engulf all the plains,"},{"id":"sayakbay-ms-current144:pdf029:l003","ordinal":392137,"en":"If enemies conquer Beijing,"},{"id":"sayakbay-ms-current144:pdf029:l005","ordinal":392138,"en":"Without swaying or budging,"},{"id":"sayakbay-ms-current144:pdf029:l006","ordinal":392139,"en":"Let the sage stand farther back,"},{"id":"sayakbay-ms-current144:pdf029:l007","ordinal":392140,"en":"His father and grandfather,"},{"id":"sayakbay-ms-current144:pdf029:l008","ordinal":392141,"en":"Let them serve Beijing,"},{"id":"sayakbay-ms-current144:pdf029:l009","ordinal":392142,"en":"The great giant guarding the throne,"},{"id":"sayakbay-ms-current144:pdf029:l010","ordinal":392143,"en":"Let him stand motionless,"},{"id":"sayakbay-ms-current144:pdf029:l011","ordinal":392144,"en":"Raiding and raising an uproar,"},{"id":"sayakbay-ms-current144:pdf029:l012","ordinal":392145,"en":"[Exercising authority?] and making a stir,"},{"id":"sayakbay-ms-current144:pdf029:l013","ordinal":392146,"en":"Scolding those who would not obey,"},{"id":"sayakbay-ms-current144:pdf029:l014","ordinal":392147,"en":"A looming presence like Mount Kap,"},{"id":"sayakbay-ms-current144:pdf029:l015","ordinal":392148,"en":"Lest he turn to rebellion,"},{"id":"sayakbay-ms-current144:pdf029:l016","ordinal":392149,"en":"He had secured him thus,"},{"id":"sayakbay-ms-current144:pdf029:l017","ordinal":392150,"en":"The dark khan's golden throne,"},{"id":"sayakbay-ms-current144:pdf029:l018","ordinal":392151,"en":"[He secured the space before the throne?],"},{"id":"sayakbay-ms-current144:pdf029:l019","ordinal":392152,"en":"Not knowing this, great Kite,"},{"id":"sayakbay-ms-current144:pdf029:l020","ordinal":392153,"en":"Late in the afternoon,"},{"id":"sayakbay-ms-current144:pdf029:l021","ordinal":392154,"en":"Kojojash's sage,"},{"id":"sayakbay-ms-current144:pdf029:l022","ordinal":392155,"en":"[Swifter to seize than a lion?],"},{"id":"sayakbay-ms-current144:pdf029:l023","ordinal":392156,"en":"Let him leave his throne and come,"},{"id":"sayakbay-ms-current144:pdf029:l024","ordinal":392157,"en":"Let him obey these words,"},{"id":"sayakbay-ms-current144:pdf029:l025","ordinal":392158,"en":"If the learned man rules,"},{"id":"sayakbay-ms-current144:pdf029:l026","ordinal":392159,"en":"If the wretch acts proudly,"},{"id":"sayakbay-ms-current144:pdf029:l027","ordinal":392160,"en":"Of the Solon, Shibe and Manchu,"},{"id":"sayakbay-ms-current144:pdf029:l028","ordinal":392161,"en":"The dog-eating, louse-eating Chinese,"},{"id":"sayakbay-ms-current144:pdf029:l029","ordinal":392162,"en":"[Your troublesome, salt-born one?],"},{"id":"sayakbay-ms-current144:pdf029:l030","ordinal":392163,"en":"Let him witness it from his house,"},{"id":"sayakbay-ms-current144:pdf029:l031","ordinal":392164,"en":"His throne will be smashed, he said."},{"id":"sayakbay-ms-current144:pdf030:l012","ordinal":392165,"en":"Saying, these are Manchu and Chinese,"},{"id":"sayakbay-ms-current144:pdf030:l023","ordinal":392166,"en":"To the foot of Kendeme,"},{"id":"sayakbay-ms-current144:pdf031:l010","ordinal":392167,"en":"They say the Burut slew his grandfather,"},{"id":"sayakbay-ms-current144:pdf031:l011","ordinal":392168,"en":"Those who struck his forefather,"},{"id":"sayakbay-ms-current144:pdf031:l012","ordinal":392169,"en":"They say they gouged out his eyes,"},{"id":"sayakbay-ms-current144:pdf031:l013","ordinal":392170,"en":"From fierce, valiant Kalcha,"},{"id":"sayakbay-ms-current144:pdf031:l014","ordinal":392171,"en":"He was not left childless, they say,"},{"id":"sayakbay-ms-current144:pdf031:l015","ordinal":392172,"en":"When the Burut slew his father,"},{"id":"sayakbay-ms-current144:pdf031:l016","ordinal":392173,"en":"Baikongur remained, they say,"},{"id":"sayakbay-ms-current144:pdf031:l017","ordinal":392174,"en":"When he reached forty-nine,"},{"id":"sayakbay-ms-current144:pdf031:l018","ordinal":392175,"en":"God struck Kongur down, they say,"},{"id":"sayakbay-ms-current144:pdf031:l019","ordinal":392176,"en":"Kite was born of Kongur,"},{"id":"sayakbay-ms-current144:pdf031:l020","ordinal":392177,"en":"Black-headed and two-legged,"},{"id":"sayakbay-ms-current144:pdf031:l021","ordinal":392178,"en":"He became no better than a beast,"},{"id":"sayakbay-ms-current144:pdf031:l022","ordinal":392179,"en":"The people shouted in uproar,"},{"id":"sayakbay-ms-current144:pdf031:l023","ordinal":392180,"en":"They raised an unheard-of clamor,"},{"id":"sayakbay-ms-current144:pdf031:l024","ordinal":392181,"en":"Not one but thousands spoke,"},{"id":"sayakbay-ms-current144:pdf031:l025","ordinal":392182,"en":"Bringing slander and strife upon me,"},{"id":"sayakbay-ms-current144:pdf031:l026","ordinal":392183,"en":"He was great among the Chinese,"},{"id":"sayakbay-ms-current144:pdf031:l027","ordinal":392184,"en":"My grandfather Kalcha, the lionlike hero,"},{"id":"sayakbay-ms-current144:pdf031:l028","ordinal":392185,"en":"Among the Chinese in ceremonial robes,"},{"id":"sayakbay-ms-current144:pdf031:l029","ordinal":392186,"en":"They had never seen such a warrior born,"},{"id":"sayakbay-ms-current144:pdf031:l030","ordinal":392187,"en":"[The troublesome Kyrgyz saw him?],"},{"id":"sayakbay-ms-current144:pdf031:l031","ordinal":392188,"en":"Killing him like a dog,"},{"id":"sayakbay-ms-current144:pdf031:l032","ordinal":392189,"en":"The Kyrgyz brought about his end."},{"id":"sayakbay-ms-current144:pdf032:l001","ordinal":392190,"en":"[Ankam?] died after my grandfather,"},{"id":"sayakbay-ms-current144:pdf032:l002","ordinal":392191,"en":"His son was Semetey,"},{"id":"sayakbay-ms-current144:pdf032:l003","ordinal":392192,"en":"Making Ala-Too his homeland,"}]
