[{"id":"semetey-1-2013:p0617:b003:l031","ordinal":124161,"en":"There was not one Muslim left—"},{"id":"semetey-1-2013:p0617:b003:l032","ordinal":124162,"en":"Almambet and Chubak, their names paired,"},{"id":"semetey-1-2013:p0617:b003:l033","ordinal":124163,"en":"Azhibai and Bakai, the two khans,"},{"id":"semetey-1-2013:p0617:b003:l034","ordinal":124164,"en":"Serek and Syrgak, all the warriors,"},{"id":"semetey-1-2013:p0617:b003:l035","ordinal":124165,"en":"These forty Muslims,"},{"id":"semetey-1-2013:p0617:b003:l036","ordinal":124166,"en":"And Manas the Leopard, the finest steed—"},{"id":"semetey-1-2013:p0617:b003:l037","ordinal":124167,"en":"When they fought without turning away,"},{"id":"semetey-1-2013:p0617:b003:l038","ordinal":124168,"en":"The more they were spent, the more they blazed;"},{"id":"semetey-1-2013:p0617:b003:l039","ordinal":124169,"en":"From their very roots they grew stronger."},{"id":"semetey-1-2013:p0617:b005:l001","ordinal":124170,"en":"The more they died, the more they increased;"},{"id":"semetey-1-2013:p0617:b005:l002","ordinal":124171,"en":"The mighty Chinese grew stronger."},{"id":"semetey-1-2013:p0617:b005:l003","ordinal":124172,"en":"News was sent to their khan,"},{"id":"semetey-1-2013:p0617:b005:l004","ordinal":124173,"en":"Their courageous warrior Konurbai,"},{"id":"semetey-1-2013:p0617:b005:l005","ordinal":124174,"en":"To the city of the Khagan Khan."},{"id":"semetey-1-2013:p0617:b005:l006","ordinal":124175,"en":"The earth was rent and shook."},{"id":"semetey-1-2013:p0617:b005:l007","ordinal":124176,"en":"Seventy peoples came."},{"id":"semetey-1-2013:p0617:b005:l008","ordinal":124177,"en":"There were many, many giants."},{"id":"semetey-1-2013:p0617:b005:l009","ordinal":124178,"en":"Of Beijing's Chinese and Manchu,"},{"id":"semetey-1-2013:p0617:b005:l010","ordinal":124179,"en":"All the champions were there."},{"id":"semetey-1-2013:p0617:b005:l011","ordinal":124180,"en":"Warrior Konurbai was there as well."},{"id":"semetey-1-2013:p0617:b005:l012","ordinal":124181,"en":"The infidels on campaign"},{"id":"semetey-1-2013:p0617:b005:l013","ordinal":124182,"en":"Had rhinoceroses and mules among their beasts."},{"id":"semetey-1-2013:p0617:b005:l014","ordinal":124183,"en":"Teeming like ants,"},{"id":"semetey-1-2013:p0617:b005:l015","ordinal":124184,"en":"Swarming more thickly than mosquitoes,"},{"id":"semetey-1-2013:p0617:b005:l016","ordinal":124185,"en":"Iron-headed giants strode about;"},{"id":"semetey-1-2013:p0617:b005:l017","ordinal":124186,"en":"Their strongmen went on foot."},{"id":"semetey-1-2013:p0617:b005:l018","ordinal":124187,"en":"The Chinese swarmed around them;"},{"id":"semetey-1-2013:p0617:b005:l019","ordinal":124188,"en":"The Khagan's people seethed."},{"id":"semetey-1-2013:p0617:b005:l020","ordinal":124189,"en":"The Chinese thundered in multitudes."},{"id":"semetey-1-2013:p0617:b005:l021","ordinal":124190,"en":"Then the Kyrgyz army dwindled, man by man."},{"id":"semetey-1-2013:p0617:b005:l022","ordinal":124191,"en":"The four khans' peoples, the filthy Sarts,"},{"id":"semetey-1-2013:p0617:b005:l023","ordinal":124192,"en":"When they fled toward Islam,"},{"id":"semetey-1-2013:p0617:b005:l024","ordinal":124193,"en":"A palmful of Muslims remained,"},{"id":"semetey-1-2013:p0617:b005:l025","ordinal":124194,"en":"With your fierce-maned father Manas."},{"id":"semetey-1-2013:p0617:b005:l026","ordinal":124195,"en":"They fought in turns,"},{"id":"semetey-1-2013:p0617:b005:l027","ordinal":124196,"en":"Taking turns to stand their ground."},{"id":"semetey-1-2013:p0617:b005:l028","ordinal":124197,"en":"The strongmen broke the ranks with spears."},{"id":"semetey-1-2013:p0617:b005:l029","ordinal":124198,"en":"Those whose death had come fell to bullets."},{"id":"semetey-1-2013:p0617:b005:l030","ordinal":124199,"en":"They faced nets of iron rope,"},{"id":"semetey-1-2013:p0617:b005:l031","ordinal":124200,"en":"Suffered terrible, mighty torment."},{"id":"semetey-1-2013:p0617:b005:l032","ordinal":124201,"en":"When they went against the Khagan Khan,"},{"id":"semetey-1-2013:p0617:b005:l033","ordinal":124202,"en":"When they unleashed turmoil,"},{"id":"semetey-1-2013:p0617:b005:l034","ordinal":124203,"en":"Mankush and the giant Doodur,"},{"id":"semetey-1-2013:p0617:b005:l035","ordinal":124204,"en":"Azhibai of the Argyn khan—"},{"id":"semetey-1-2013:p0617:b005:l036","ordinal":124205,"en":"They speared toward the khakan."},{"id":"semetey-1-2013:p0617:b005:l037","ordinal":124206,"en":"Kartkurong of sixty mature years,"},{"id":"semetey-1-2013:p0617:b005:l038","ordinal":124207,"en":"By the mighty strongman Lama,"},{"id":"semetey-1-2013:p0617:b005:l039","ordinal":124208,"en":"When he was taken captive,"},{"id":"semetey-1-2013:p0618:b003:l001","ordinal":124209,"en":"This is the Chinese custom:"},{"id":"semetey-1-2013:p0618:b003:l002","ordinal":124210,"en":"At all times the infidels"},{"id":"semetey-1-2013:p0618:b003:l003","ordinal":124211,"en":"Have the custom of carrying a banner."},{"id":"semetey-1-2013:p0618:b003:l004","ordinal":124212,"en":"Upon Kartkurong's legs"},{"id":"semetey-1-2013:p0618:b003:l005","ordinal":124213,"en":"They put iron hobbles."},{"id":"semetey-1-2013:p0618:b003:l006","ordinal":124214,"en":"Deafening his ears and head,"},{"id":"semetey-1-2013:p0618:b003:l007","ordinal":124215,"en":"They bound him with straps."},{"id":"semetey-1-2013:p0618:b003:l008","ordinal":124216,"en":"When the Chinese day of triumph came,"},{"id":"semetey-1-2013:p0618:b003:l009","ordinal":124217,"en":"That infidel mounted Kartkurong."},{"id":"semetey-1-2013:p0618:b003:l010","ordinal":124218,"en":"The Chinese red banner,"},{"id":"semetey-1-2013:p0618:b003:l011","ordinal":124219,"en":"Without letting it tilt a hair,"},{"id":"semetey-1-2013:p0618:b003:l012","ordinal":124220,"en":"Lama held upright."},{"id":"semetey-1-2013:p0618:b003:l013","ordinal":124221,"en":"On the horse Ai-sarala,"},{"id":"semetey-1-2013:p0618:b003:l014","ordinal":124222,"en":"And send six swift horses"},{"id":"semetey-1-2013:p0618:b003:l015","ordinal":124223,"en":"He who was your father's sworn brother,"},{"id":"semetey-1-2013:p0618:b003:l016","ordinal":124224,"en":"The noble lion named Almambet—"},{"id":"semetey-1-2013:p0618:b003:l017","ordinal":124225,"en":"That was where he fought the slaughter."},{"id":"semetey-1-2013:p0618:b003:l018","ordinal":124226,"en":"Cloudy by day, clear by night,"},{"id":"semetey-1-2013:p0618:b003:l019","ordinal":124227,"en":"Drizzle turning to snow in gusts of wind—"},{"id":"semetey-1-2013:p0618:b003:l020","ordinal":124228,"en":"When Almambet worked his weather magic,"},{"id":"semetey-1-2013:p0618:b003:l021","ordinal":124229,"en":"For fourteen days and nights"},{"id":"semetey-1-2013:p0618:b003:l022","ordinal":124230,"en":"He bewitched the weather."},{"id":"semetey-1-2013:p0618:b003:l023","ordinal":124231,"en":"All the foothills were pelted with hail;"},{"id":"semetey-1-2013:p0618:b003:l024","ordinal":124232,"en":"All the lower country was drenched with rain."},{"id":"semetey-1-2013:p0618:b003:l025","ordinal":124233,"en":"None could stand and face"},{"id":"semetey-1-2013:p0618:b003:l026","ordinal":124234,"en":"Almambet's lion-like might."},{"id":"semetey-1-2013:p0618:b003:l027","ordinal":124235,"en":"The many Chinese and Manchu people"},{"id":"semetey-1-2013:p0618:b003:l028","ordinal":124236,"en":"Were thrown into turmoil and shattered."},{"id":"semetey-1-2013:p0618:b003:l029","ordinal":124237,"en":"Fierce-maned Khan Almambet's"},{"id":"semetey-1-2013:p0618:b003:l030","ordinal":124238,"en":"Wrath—how could they endure it?"},{"id":"semetey-1-2013:p0618:b003:l031","ordinal":124239,"en":"Turning summer's day to winter,"},{"id":"semetey-1-2013:p0618:b003:l032","ordinal":124240,"en":"The thinly dressed Chinese"},{"id":"semetey-1-2013:p0618:b003:l033","ordinal":124241,"en":"He made whimper like girls."},{"id":"semetey-1-2013:p0618:b003:l034","ordinal":124242,"en":"Girding his waist firmly,"},{"id":"semetey-1-2013:p0618:b003:l035","ordinal":124243,"en":"Against seven vast hosts of Black Chinese,"},{"id":"semetey-1-2013:p0618:b003:l036","ordinal":124244,"en":"Almam alone attacked."},{"id":"semetey-1-2013:p0618:b003:l037","ordinal":124245,"en":"Striking Sarala once upon the thigh,"},{"id":"semetey-1-2013:p0618:b003:l038","ordinal":124246,"en":"Furious and grim,"},{"id":"semetey-1-2013:p0618:b003:l039","ordinal":124247,"en":"Almam the Leopard attacked."},{"id":"semetey-1-2013:p0618:b004:l001","ordinal":124248,"en":"The giant Doodur, khan of the dog-eaters,"},{"id":"semetey-1-2013:p0618:b004:l002","ordinal":124249,"en":"And Lama, khan of the Shibe—"},{"id":"semetey-1-2013:p0618:b004:l003","ordinal":124250,"en":"When he reached the two together,"},{"id":"semetey-1-2013:p0618:b004:l004","ordinal":124251,"en":"He brought them both down from their horses,"},{"id":"semetey-1-2013:p0618:b004:l005","ordinal":124252,"en":"Thrusting his spear into them in turn."},{"id":"semetey-1-2013:p0618:b004:l006","ordinal":124253,"en":"When Alake split the giant Doodur"},{"id":"semetey-1-2013:p0618:b004:l007","ordinal":124254,"en":"Into two pieces,"},{"id":"semetey-1-2013:p0618:b004:l008","ordinal":124255,"en":"When Alake reached Lama"},{"id":"semetey-1-2013:p0618:b004:l009","ordinal":124256,"en":"And took his head,"},{"id":"semetey-1-2013:p0618:b004:l010","ordinal":124257,"en":"Lama's club-like hair—"},{"id":"semetey-1-2013:p0618:b004:l011","ordinal":124258,"en":"He stripped off the scalp like a hide,"},{"id":"semetey-1-2013:p0618:b004:l012","ordinal":124259,"en":"And when Almam put it on his head,"},{"id":"semetey-1-2013:p0618:b004:l013","ordinal":124260,"en":"He went about as Lama."},{"id":"semetey-1-2013:p0618:b004:l014","ordinal":124261,"en":"When the Chinese went on campaign,"},{"id":"semetey-1-2013:p0618:b004:l015","ordinal":124262,"en":"When Manas the Leopard was hard pressed,"},{"id":"semetey-1-2013:p0618:b004:l016","ordinal":124263,"en":"Dressed in Lama's coat,"},{"id":"semetey-1-2013:p0618:b004:l017","ordinal":124264,"en":"The Chinese red banner,"},{"id":"semetey-1-2013:p0618:b004:l018","ordinal":124265,"en":"My Alake, blessed by Kydyr,"},{"id":"semetey-1-2013:p0618:b004:l019","ordinal":124266,"en":"Carried away toward Beijing."},{"id":"semetey-1-2013:p0618:b004:l020","ordinal":124267,"en":"When he went to the Kalmyks,"},{"id":"semetey-1-2013:p0618:b004:l021","ordinal":124268,"en":"“The banner is fleeing!” he shouted,"},{"id":"semetey-1-2013:p0618:b004:l022","ordinal":124269,"en":"Raising a battle cry in Kalmyk."},{"id":"semetey-1-2013:p0618:b004:l023","ordinal":124270,"en":"When he went to the Solon,"},{"id":"semetey-1-2013:p0618:b004:l024","ordinal":124271,"en":"He called out in Solon,"},{"id":"semetey-1-2013:p0618:b004:l025","ordinal":124272,"en":"Saying, “The banner is fleeing!”"},{"id":"semetey-1-2013:p0618:b004:l026","ordinal":124273,"en":"When he went to the Shibe,"},{"id":"semetey-1-2013:p0618:b004:l027","ordinal":124274,"en":"He clamored in Shibe,"},{"id":"semetey-1-2013:p0618:b004:l028","ordinal":124275,"en":"Babbling, “The banner is fleeing!”"},{"id":"semetey-1-2013:p0618:b004:l029","ordinal":124276,"en":"When he went to the Manchu,"},{"id":"semetey-1-2013:p0618:b004:l030","ordinal":124277,"en":"He chattered like the Manchu,"},{"id":"semetey-1-2013:p0618:b004:l031","ordinal":124278,"en":"Rattling out, “The banner is fleeing!”"},{"id":"semetey-1-2013:p0618:b004:l032","ordinal":124279,"en":"When he went to the Torgut,"},{"id":"semetey-1-2013:p0618:b004:l033","ordinal":124280,"en":"Raising the white sacred banner,"},{"id":"semetey-1-2013:p0618:b004:l034","ordinal":124281,"en":"He shouted in Torgut,"},{"id":"semetey-1-2013:p0618:b004:l035","ordinal":124282,"en":"Raising a clamor: “The banner is fleeing!”"},{"id":"semetey-1-2013:p0618:b004:l036","ordinal":124283,"en":"When he went to the Chinese,"},{"id":"semetey-1-2013:p0618:b004:l037","ordinal":124284,"en":"He shouted like the Chinese,"},{"id":"semetey-1-2013:p0618:b004:l038","ordinal":124285,"en":"Making his voice like a girl's,"},{"id":"semetey-1-2013:p0618:b004:l039","ordinal":124286,"en":"Whimpering like young girls,"},{"id":"semetey-1-2013:p0619:b003:l001","ordinal":124287,"en":"Calling, “The banner is fleeing!”"},{"id":"semetey-1-2013:p0619:b003:l002","ordinal":124288,"en":"Speaking in the tongues of forty tribes,"},{"id":"semetey-1-2013:p0619:b003:l003","ordinal":124289,"en":"When Alake fled toward Beijing,"},{"id":"semetey-1-2013:p0619:b003:l005","ordinal":124290,"en":"The many Chinese, the peoples of forty khans,"},{"id":"semetey-1-2013:p0619:b003:l006","ordinal":124291,"en":"Rushed toward Beijing,"},{"id":"semetey-1-2013:p0619:b003:l007","ordinal":124292,"en":"All fleeing and crying out."},{"id":"semetey-1-2013:p0619:b003:l008","ordinal":124293,"en":"The infidels, thick as black willows,"},{"id":"semetey-1-2013:p0619:b003:l009","ordinal":124294,"en":"He swept toward Beijing."},{"id":"semetey-1-2013:p0619:b003:l010","ordinal":124295,"en":"The fleeing Chinese—"},{"id":"semetey-1-2013:p0619:b003:l011","ordinal":124296,"en":"When Almambet brought this about,"},{"id":"semetey-1-2013:p0619:b003:l012","ordinal":124297,"en":"Your outstanding leopard father"},{"id":"semetey-1-2013:p0619:b003:l013","ordinal":124298,"en":"Pursued them from behind and slaughtered them."},{"id":"semetey-1-2013:p0619:b003:l014","ordinal":124299,"en":"The whole Beijing army died;"},{"id":"semetey-1-2013:p0619:b003:l015","ordinal":124300,"en":"Many Chinese giants died."},{"id":"semetey-1-2013:p0619:b003:l016","ordinal":124301,"en":"When the Chinese fled to Beijing,"},{"id":"semetey-1-2013:p0619:b003:l017","ordinal":124302,"en":"Clamoring, “The banner is fleeing!”"},{"id":"semetey-1-2013:p0619:b003:l018","ordinal":124303,"en":"The Chinese stood crying out."},{"id":"semetey-1-2013:p0619:b003:l019","ordinal":124304,"en":"When the fierce-maned warrior"},{"id":"semetey-1-2013:p0619:b003:l020","ordinal":124305,"en":"Cut through their middle,"},{"id":"semetey-1-2013:p0619:b003:l021","ordinal":124306,"en":"When around them the forty champions"},{"id":"semetey-1-2013:p0619:b003:l022","ordinal":124307,"en":"Came slaughtering,"},{"id":"semetey-1-2013:p0619:b003:l023","ordinal":124308,"en":"When Khan Manas, in their very midst,"},{"id":"semetey-1-2013:p0619:b003:l024","ordinal":124309,"en":"Hemmed them in and unleashed slaughter,"},{"id":"semetey-1-2013:p0619:b003:l025","ordinal":124310,"en":"When the forty champions around them"},{"id":"semetey-1-2013:p0619:b003:l026","ordinal":124311,"en":"Cut them down and slew them,"},{"id":"semetey-1-2013:p0619:b003:l027","ordinal":124312,"en":"Into Beijing where the Prophet never trod,"},{"id":"semetey-1-2013:p0619:b003:l028","ordinal":124313,"en":"Your father came in his glory."},{"id":"semetey-1-2013:p0619:b003:l029","ordinal":124314,"en":"When he advanced, driving them before him,"},{"id":"semetey-1-2013:p0619:b003:l030","ordinal":124315,"en":"The Four Companions came to your lion father."},{"id":"semetey-1-2013:p0619:b003:l031","ordinal":124316,"en":"When your father took Beijing,"},{"id":"semetey-1-2013:p0619:b003:l032","ordinal":124317,"en":"Their hearts were at ease."},{"id":"semetey-1-2013:p0619:b003:l033","ordinal":124318,"en":"The Muslim people became rich."},{"id":"semetey-1-2013:p0619:b003:l034","ordinal":124319,"en":"The most excellent warriors"},{"id":"semetey-1-2013:p0619:b003:l035","ordinal":124320,"en":"Took six thousand horses apiece."},{"id":"semetey-1-2013:p0619:b003:l036","ordinal":124321,"en":"The least successful among them"},{"id":"semetey-1-2013:p0619:b003:l037","ordinal":124322,"en":"Took six hundred horses apiece."},{"id":"semetey-1-2013:p0619:b003:l038","ordinal":124323,"en":"The accomplished champions"},{"id":"semetey-1-2013:p0619:b003:l039","ordinal":124324,"en":"Took seven thousand horses apiece."},{"id":"semetey-1-2013:p0619:b005:l001","ordinal":124325,"en":"The lesser men who could not match them"},{"id":"semetey-1-2013:p0619:b005:l002","ordinal":124326,"en":"Took seven hundred horses apiece."},{"id":"semetey-1-2013:p0619:b005:l003","ordinal":124327,"en":"The most excellent warriors"},{"id":"semetey-1-2013:p0619:b005:l004","ordinal":124328,"en":"Took six girls apiece."},{"id":"semetey-1-2013:p0619:b005:l005","ordinal":124329,"en":"All the people were filled to abundance."},{"id":"semetey-1-2013:p0619:b005:l006","ordinal":124330,"en":"The heroes fat and pent-up;"},{"id":"semetey-1-2013:p0619:b005:l007","ordinal":124331,"en":"Taking many excellent craftswomen,"},{"id":"semetey-1-2013:p0619:b005:l008","ordinal":124332,"en":"Esenkan's Burulcha,"},{"id":"semetey-1-2013:p0619:b005:l009","ordinal":124333,"en":"And Zhang-zhung's Birmyskal—"},{"id":"semetey-1-2013:p0619:b005:l010","ordinal":124334,"en":"Taking such girls as these,"},{"id":"semetey-1-2013:p0619:b005:l011","ordinal":124335,"en":"They offered them as tribute."},{"id":"semetey-1-2013:p0619:b005:l012","ordinal":124336,"en":"They dressed him in a Chinese coat."},{"id":"semetey-1-2013:p0619:b005:l013","ordinal":124337,"en":"The golden throne in Beijing—"},{"id":"semetey-1-2013:p0619:b005:l014","ordinal":124338,"en":"They made your father ruler,"},{"id":"semetey-1-2013:p0619:b005:l015","ordinal":124339,"en":"And seated him upon that golden throne."},{"id":"semetey-1-2013:p0619:b005:l016","ordinal":124340,"en":"Your father ruled as khan for six months."},{"id":"semetey-1-2013:p0619:b005:l017","ordinal":124341,"en":"Beijing with its Khagan rose."},{"id":"semetey-1-2013:p0619:b005:l018","ordinal":124342,"en":"Their chief was mighty Kalcha."},{"id":"semetey-1-2013:p0619:b005:l019","ordinal":124343,"en":"Seventy executioners"},{"id":"semetey-1-2013:p0619:b005:l020","ordinal":124344,"en":"Were set to beating their drums."},{"id":"semetey-1-2013:p0619:b005:l021","ordinal":124345,"en":"Caught unaware, by Kalcha"},{"id":"semetey-1-2013:p0619:b005:l022","ordinal":124346,"en":"He was struck at the back of the head."},{"id":"semetey-1-2013:p0619:b005:l023","ordinal":124347,"en":"Manas was wounded."},{"id":"semetey-1-2013:p0619:b005:l024","ordinal":124348,"en":"When he turned back this way,"},{"id":"semetey-1-2013:p0619:b005:l025","ordinal":124349,"en":"Those Muslims who survived the dead,"},{"id":"semetey-1-2013:p0619:b005:l026","ordinal":124350,"en":"When they returned this way,"},{"id":"semetey-1-2013:p0619:b005:l027","ordinal":124351,"en":"The earth was rent and turned to dust."},{"id":"semetey-1-2013:p0619:b005:l028","ordinal":124352,"en":"Ninety Beijings rose."},{"id":"semetey-1-2013:p0619:b005:l029","ordinal":124353,"en":"Many warriors broke through the ranks;"},{"id":"semetey-1-2013:p0619:b005:l030","ordinal":124354,"en":"Many men fell to bullets."},{"id":"semetey-1-2013:p0619:b005:l031","ordinal":124355,"en":"Many mighty men died."},{"id":"semetey-1-2013:p0619:b005:l032","ordinal":124356,"en":"Ezhigei and Sheiren died as well."},{"id":"semetey-1-2013:p0619:b005:l033","ordinal":124357,"en":"Countless lives were lost."},{"id":"semetey-1-2013:p0619:b005:l034","ordinal":124358,"en":"Muzburchak and Kokcho died."},{"id":"semetey-1-2013:p0619:b005:l035","ordinal":124359,"en":"Kokotoy's Bokmurun died as well."},{"id":"semetey-1-2013:p0619:b005:l036","ordinal":124360,"en":"Many renowned supporters died."},{"id":"semetey-1-2013:p0619:b005:l037","ordinal":124361,"en":"Many died in the fighting."},{"id":"semetey-1-2013:p0619:b005:l038","ordinal":124362,"en":"Your father Manas, the magnanimous lion,"},{"id":"semetey-1-2013:p0619:b005:l039","ordinal":124363,"en":"That was where he suffered,"},{"id":"semetey-1-2013:p0620:b003:l001","ordinal":124364,"en":"Many places where they were shattered and fell—"},{"id":"semetey-1-2013:p0620:b003:l002","ordinal":124365,"en":"That was where they fought to the death."},{"id":"semetey-1-2013:p0620:b003:l003","ordinal":124366,"en":"Returning from the Khagan's realm,"},{"id":"semetey-1-2013:p0620:b003:l004","ordinal":124367,"en":"He had lost the one he relied upon,"},{"id":"semetey-1-2013:p0620:b003:l005","ordinal":124368,"en":"Khan Chubak."},{"id":"semetey-1-2013:p0620:b003:l006","ordinal":124369,"en":"Taking much wealth from Beijing,"},{"id":"semetey-1-2013:p0620:b003:l007","ordinal":124370,"en":"Those who had been a band about his waist—"},{"id":"semetey-1-2013:p0620:b003:l008","ordinal":124371,"en":"Your valiant father had consumed his champions."},{"id":"semetey-1-2013:p0620:b003:l009","ordinal":124372,"en":"Returning from Great Beijing,"},{"id":"semetey-1-2013:p0620:b003:l010","ordinal":124373,"en":"Bereft of his fierce-maned warriors,"},{"id":"semetey-1-2013:p0620:b003:l011","ordinal":124374,"en":"With Akkula fallen to a bullet,"},{"id":"semetey-1-2013:p0620:b003:l012","ordinal":124375,"en":"With Almambet dead a martyr,"},{"id":"semetey-1-2013:p0620:b003:l013","ordinal":124376,"en":"Syrgak and Serek, the two lions—"},{"id":"semetey-1-2013:p0620:b003:l014","ordinal":124377,"en":"Bereft of both of them,"},{"id":"semetey-1-2013:p0620:b003:l015","ordinal":124378,"en":"Your saintly father grieved."},{"id":"semetey-1-2013:p0620:b003:l016","ordinal":124379,"en":"Then I, Bakai, at that moment,"},{"id":"semetey-1-2013:p0620:b003:l017","ordinal":124380,"en":"Showed my lion-like courage."},{"id":"semetey-1-2013:p0620:b003:l018","ordinal":124381,"en":"When your father stood wailing, on foot,"},{"id":"semetey-1-2013:p0620:b003:l019","ordinal":124382,"en":"When forty-two Chinese surrounded him,"},{"id":"semetey-1-2013:p0620:b003:l020","ordinal":124383,"en":"Furious, I went straight through."},{"id":"semetey-1-2013:p0620:b003:l021","ordinal":124384,"en":"To my bloodthirsty one, dear soul,"},{"id":"semetey-1-2013:p0620:b003:l022","ordinal":124385,"en":"(It was a horse set apart for you),"},{"id":"semetey-1-2013:p0620:b003:l023","ordinal":124386,"en":"I led the roan horse."},{"id":"semetey-1-2013:p0620:b003:l024","ordinal":124387,"en":"Showing my resourcefulness,"},{"id":"semetey-1-2013:p0620:b003:l025","ordinal":124388,"en":"I contrived to reach him, poor soul,"},{"id":"semetey-1-2013:p0620:b003:l026","ordinal":124389,"en":"And mounted him on Taibuurul."},{"id":"semetey-1-2013:p0620:b003:l027","ordinal":124390,"en":"When we thrust back against the Chinese,"},{"id":"semetey-1-2013:p0620:b003:l028","ordinal":124391,"en":"Konurbai survived,"},{"id":"semetey-1-2013:p0620:b003:l029","ordinal":124392,"en":"While we slaughtered the rest."},{"id":"semetey-1-2013:p0620:b003:l030","ordinal":124393,"en":"Turning back toward the Kyrgyz,"},{"id":"semetey-1-2013:p0620:b003:l031","ordinal":124394,"en":"When we left them unable to pursue,"},{"id":"semetey-1-2013:p0620:b003:l032","ordinal":124395,"en":"That fierce-maned Alake"},{"id":"semetey-1-2013:p0620:b003:l033","ordinal":124396,"en":"We recovered from the Chinese."},{"id":"semetey-1-2013:p0620:b003:l034","ordinal":124397,"en":"Your leopard father held him across his saddle."},{"id":"semetey-1-2013:p0620:b003:l035","ordinal":124398,"en":"When he plunged into a night of grief,"},{"id":"semetey-1-2013:p0620:b003:l036","ordinal":124399,"en":"Pressing his cheek against his cheek,"},{"id":"semetey-1-2013:p0620:b003:l037","ordinal":124400,"en":"And lay there wailing:"},{"id":"semetey-1-2013:p0620:b003:l038","ordinal":124401,"en":"“My companion, my twin lamb,"},{"id":"semetey-1-2013:p0620:b003:l039","ordinal":124402,"en":"Alake, bereft of you,"},{"id":"semetey-1-2013:p0620:b004:l001","ordinal":124403,"en":"How can I go on without dying?"},{"id":"semetey-1-2013:p0620:b004:l002","ordinal":124404,"en":"My support when I climbed upward,"},{"id":"semetey-1-2013:p0620:b004:l003","ordinal":124405,"en":"My prop when I descended,"},{"id":"semetey-1-2013:p0620:b004:l004","ordinal":124406,"en":"My good fortune when he went scouting,"},{"id":"semetey-1-2013:p0620:b004:l005","ordinal":124407,"en":"My countless host when he entered slaughter,"},{"id":"semetey-1-2013:p0620:b004:l006","ordinal":124408,"en":"I have lost him, to my disgrace,"},{"id":"semetey-1-2013:p0620:b004:l007","ordinal":124409,"en":"My soul-companion in the next world."},{"id":"semetey-1-2013:p0620:b004:l008","ordinal":124410,"en":"Alas, uncle, avenge this!"},{"id":"semetey-1-2013:p0620:b004:l009","ordinal":124411,"en":"Your father wailed and cried aloud."},{"id":"semetey-1-2013:p0620:b004:l010","ordinal":124412,"en":"When he suffered in this way,"},{"id":"semetey-1-2013:p0620:b004:l011","ordinal":124413,"en":"The valiant, fierce-maned Almam"},{"id":"semetey-1-2013:p0620:b004:l012","ordinal":124414,"en":"We took by the waist and bent over,"},{"id":"semetey-1-2013:p0620:b004:l013","ordinal":124415,"en":"And loaded onto Sarala as a sacred trust."},{"id":"semetey-1-2013:p0620:b004:l014","ordinal":124416,"en":"The beautiful man on his right,"}]
