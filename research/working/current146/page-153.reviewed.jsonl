{"id": "sayakbay-ms-current146:pdf153:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 26, "raw": "Кайыштуу калың эл,", "text": "Кайыштуу калың эл,", "en": "O enduring multitude of people,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf153:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 27, "raw": "Айткан менен мында журт,", "text": "Айткан менен мында журт,", "en": "Though spoken, the people here,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf153:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 28, "raw": "Чын Көбөйгө көп элди,", "text": "Чын Көбөйгө көп элди,", "en": "To true Köböy, the many people,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf153:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 29, "raw": "Өлдүң деп чындан кайгырып,", "text": "Өлдүң деп чындан кайгырып,", "en": "Grieved sincerely, saying you had died,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf153:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 153, "folio": 536, "line_in_page": 30, "raw": "Чының жандан айрылып,", "text": "Чының жандан айрылып,", "en": "Your true self parted from life,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
