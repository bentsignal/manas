[{"id":"manas-2010:p1330:b001:l018","ordinal":57601,"en":"There are Almambet and generous Manas;"},{"id":"manas-2010:p1330:b001:l019","ordinal":57602,"en":"Consider it, Muslims!"},{"id":"manas-2010:p1330:b001:l020","ordinal":57603,"en":"With warrior Chubak at our head,"},{"id":"manas-2010:p1330:b001:l021","ordinal":57604,"en":"We remained in a place where we did not die."},{"id":"manas-2010:p1330:b001:l022","ordinal":57605,"en":"We began shooting without mercy."},{"id":"manas-2010:p1330:b001:l023","ordinal":57606,"en":"Over the city of Outer Beijing,"},{"id":"manas-2010:p1330:b001:l024","ordinal":57607,"en":"Generous warrior Manas,"},{"id":"manas-2010:p1330:b001:l025","ordinal":57608,"en":"We have raised him as khan."},{"id":"manas-2010:p1330:b001:l026","ordinal":57609,"en":"To ride to feasts and memorial banquets,"},{"id":"manas-2010:p1330:b001:l027","ordinal":57610,"en":"To go moving smoothly along,"},{"id":"manas-2010:p1330:b001:l028","ordinal":57611,"en":"With shoes of gold,"},{"id":"manas-2010:p1330:b001:l029","ordinal":57612,"en":"We have taken countless pacers."},{"id":"manas-2010:p1330:b001:l030","ordinal":57613,"en":"After those pacers,"},{"id":"manas-2010:p1330:b001:l031","ordinal":57614,"en":"We took the finest among women."},{"id":"manas-2010:p1330:b001:l032","ordinal":57615,"en":"Esenkan's Burulcha,"},{"id":"manas-2010:p1330:b001:l033","ordinal":57616,"en":"We took that girl of immeasurable beauty."},{"id":"manas-2010:p1330:b001:l034","ordinal":57617,"en":"The governor-general's daughter Birmyskal,"},{"id":"manas-2010:p1330:b001:l035","ordinal":57618,"en":"They gave us as a gift."},{"id":"manas-2010:p1330:b001:l036","ordinal":57619,"en":"We stirred strife among the Chinese host."},{"id":"manas-2010:p1330:b001:l037","ordinal":57620,"en":"Kökchebich beneath me,"},{"id":"manas-2010:p1330:b001:l038","ordinal":57621,"en":"This is my winged horse."},{"id":"manas-2010:p1330:b001:l039","ordinal":57622,"en":"‘Let them all come, none staying behind,’"},{"id":"manas-2010:p1330:b001:l040","ordinal":57623,"en":"This is the letter Manas the leopard wrote!"},{"id":"manas-2010:p1330:b001:l041","ordinal":57624,"en":"‘Let him stir the people and gather them,’ he says."},{"id":"manas-2010:p1330:b001:l042","ordinal":57625,"en":"‘The two girls taken as spoils,"},{"id":"manas-2010:p1331:b001:l001","ordinal":57626,"en":"To Almambet and Chubak,"},{"id":"manas-2010:p1331:b001:l002","ordinal":57627,"en":"Let Aykhozho perform their marriage rites,’ he says.”"},{"id":"manas-2010:p1331:b001:l003","ordinal":57628,"en":"When they heard this news,"},{"id":"manas-2010:p1331:b001:l004","ordinal":57629,"en":"Aykhozho and old Koshoy,"},{"id":"manas-2010:p1331:b001:l005","ordinal":57630,"en":"Surrounding him, crying out,"},{"id":"manas-2010:p1331:b001:l006","ordinal":57631,"en":"The boy Syrgak, vast as the sea,"},{"id":"manas-2010:p1331:b001:l007","ordinal":57632,"en":"All the Muslims gathered round."},{"id":"manas-2010:p1331:b001:l008","ordinal":57633,"en":"If you looked then,"},{"id":"manas-2010:p1331:b001:l009","ordinal":57634,"en":"His face had filled out, radiant."},{"id":"manas-2010:p1331:b001:l010","ordinal":57635,"en":"A vigorous courser, a brave young man,"},{"id":"manas-2010:p1331:b001:l011","ordinal":57636,"en":"They were ready to prove their worth."},{"id":"manas-2010:p1331:b001:l012","ordinal":57637,"en":"All the khans made ready,"},{"id":"manas-2010:p1331:b001:l013","ordinal":57638,"en":"Praying to the one God."},{"id":"manas-2010:p1331:b001:l014","ordinal":57639,"en":"“He whose death has come will die,” they said."},{"id":"manas-2010:p1331:b001:l015","ordinal":57640,"en":"“If there is suffering, he will endure it,” they said."},{"id":"manas-2010:p1331:b001:l016","ordinal":57641,"en":"“The young man spared suffering,"},{"id":"manas-2010:p1331:b001:l017","ordinal":57642,"en":"From the city of Deep Beijing,"},{"id":"manas-2010:p1331:b001:l018","ordinal":57643,"en":"If he does not die, will take spoils home,” they said."},{"id":"manas-2010:p1331:b001:l019","ordinal":57644,"en":"“We shall plunder their goods."},{"id":"manas-2010:p1331:b001:l020","ordinal":57645,"en":"While blue-maned Manas is here,"},{"id":"manas-2010:p1331:b001:l021","ordinal":57646,"en":"We shall wage a mighty battle."},{"id":"manas-2010:p1331:b001:l022","ordinal":57647,"en":"We shall plunder and scatter their gold."},{"id":"manas-2010:p1331:b001:l023","ordinal":57648,"en":"Of locked-up Beijing,"},{"id":"manas-2010:p1331:b001:l024","ordinal":57649,"en":"We shall open the gates!”"},{"id":"manas-2010:p1331:b001:l025","ordinal":57650,"en":"Speaking words to give them courage,"},{"id":"manas-2010:p1331:b001:l026","ordinal":57651,"en":"Many more rejoiced at this."},{"id":"manas-2010:p1331:b001:l027","ordinal":57652,"en":"“To Beijing, untouched by Iskender,"},{"id":"manas-2010:p1331:b001:l028","ordinal":57653,"en":"We have journeyed all this way."},{"id":"manas-2010:p1331:b001:l029","ordinal":57654,"en":"Then we shall not return unharmed."},{"id":"manas-2010:p1331:b001:l030","ordinal":57655,"en":"If death comes from God,"},{"id":"manas-2010:p1331:b001:l031","ordinal":57656,"en":"Not one of us will return alive."},{"id":"manas-2010:p1331:b001:l032","ordinal":57657,"en":"They call it a land of dreadful renown,"},{"id":"manas-2010:p1331:b001:l033","ordinal":57658,"en":"They call the Chinese a numerous people."},{"id":"manas-2010:p1331:b001:l034","ordinal":57659,"en":"Among those Chinese,"},{"id":"manas-2010:p1331:b001:l035","ordinal":57660,"en":"They say that familiar Kalcha is a warrior."},{"id":"manas-2010:p1331:b001:l036","ordinal":57661,"en":"We have heard from many people:"},{"id":"manas-2010:p1331:b001:l037","ordinal":57662,"en":"Madykan, riding a blue bull,"},{"id":"manas-2010:p1331:b001:l038","ordinal":57663,"en":"Of the Chinese and the Manchu,"},{"id":"manas-2010:p1331:b001:l039","ordinal":57664,"en":"They say he does not know their language."},{"id":"manas-2010:p1331:b001:l040","ordinal":57665,"en":"The bull beneath him"},{"id":"manas-2010:p1331:b001:l041","ordinal":57666,"en":"Has a single horn upon its snout."},{"id":"manas-2010:p1331:b001:l042","ordinal":57667,"en":"Unless strength is given to Manas,"},{"id":"manas-2010:p1332:b001:l001","ordinal":57668,"en":"The rest of us have no remedy."},{"id":"manas-2010:p1332:b001:l002","ordinal":57669,"en":"If Madykan grows wrathful,"},{"id":"manas-2010:p1332:b001:l003","ordinal":57670,"en":"He will shatter our people,"},{"id":"manas-2010:p1332:b001:l004","ordinal":57671,"en":"And all our khans,"},{"id":"manas-2010:p1332:b001:l005","ordinal":57672,"en":"They say he will bind and carry off."},{"id":"manas-2010:p1332:b001:l006","ordinal":57673,"en":"‘Generous warrior Manas,"},{"id":"manas-2010:p1332:b001:l007","ordinal":57674,"en":"I shall kill him and raid his people,’ he says."},{"id":"manas-2010:p1332:b001:l008","ordinal":57675,"en":"We ourselves have fallen into suffering."},{"id":"manas-2010:p1332:b001:l009","ordinal":57676,"en":"God knows whether we shall return,"},{"id":"manas-2010:p1332:b001:l010","ordinal":57677,"en":"Whether we shall turn back safe and sound,"},{"id":"manas-2010:p1332:b001:l011","ordinal":57678,"en":"Whether we shall return to our people."},{"id":"manas-2010:p1332:b001:l012","ordinal":57679,"en":"Where no one has inflicted harm,"},{"id":"manas-2010:p1332:b001:l013","ordinal":57680,"en":"Where no one has gone to grapple,"},{"id":"manas-2010:p1332:b001:l014","ordinal":57681,"en":"That is the famed Beijing."},{"id":"manas-2010:p1332:b001:l015","ordinal":57682,"en":"They have fallen into suffering,"},{"id":"manas-2010:p1332:b001:l016","ordinal":57683,"en":"Our simple-minded people,”"},{"id":"manas-2010:p1332:b001:l017","ordinal":57684,"en":"They said; then among the vast host,"},{"id":"manas-2010:p1332:b001:l018","ordinal":57685,"en":"Many more grieved at this."},{"id":"manas-2010:p1332:b001:l019","ordinal":57686,"en":"Their steadfast supporter, Khan Bakay,"},{"id":"manas-2010:p1332:b001:l020","ordinal":57687,"en":"The elder who led the people,"},{"id":"manas-2010:p1332:b001:l021","ordinal":57688,"en":"His wisdom a fertile river,"},{"id":"manas-2010:p1332:b001:l022","ordinal":57689,"en":"Bakay stood reading the letter,"},{"id":"manas-2010:p1332:b001:l023","ordinal":57690,"en":"Reading swiftly, making the people hear."},{"id":"manas-2010:p1332:b001:l024","ordinal":57691,"en":"Beijing, the people of forty khans,"},{"id":"manas-2010:p1332:b001:l025","ordinal":57692,"en":"When he had read it all to them,"},{"id":"manas-2010:p1332:b001:l026","ordinal":57693,"en":"All of them without a pause,"},{"id":"manas-2010:p1332:b001:l027","ordinal":57694,"en":"Old Koshoy among them,"},{"id":"manas-2010:p1332:b001:l028","ordinal":57695,"en":"Mounted their horses with a roar."},{"id":"manas-2010:p1332:b001:l029","ordinal":57696,"en":"All cried out together."},{"id":"manas-2010:p1332:b001:l030","ordinal":57697,"en":"The whole army that had come,"},{"id":"manas-2010:p1332:b001:l031","ordinal":57698,"en":"All the leaders of tens,"},{"id":"manas-2010:p1332:b001:l032","ordinal":57699,"en":"Came into the middle, sweeping round."},{"id":"manas-2010:p1332:b001:l033","ordinal":57700,"en":"The wise leaders of fifties,"},{"id":"manas-2010:p1332:b001:l034","ordinal":57701,"en":"Each apart with his fifty,"},{"id":"manas-2010:p1332:b001:l035","ordinal":57702,"en":"Moved conspicuously at the front."},{"id":"manas-2010:p1332:b001:l036","ordinal":57703,"en":"All the leaders of hundreds,"},{"id":"manas-2010:p1332:b001:l037","ordinal":57704,"en":"Moved separately by hundreds."},{"id":"manas-2010:p1332:b001:l038","ordinal":57705,"en":"Each in his own place,"},{"id":"manas-2010:p1332:b001:l039","ordinal":57706,"en":"Dividing in due order,"},{"id":"manas-2010:p1332:b001:l040","ordinal":57707,"en":"The leaders of thousands stood apart,"},{"id":"manas-2010:p1332:b001:l041","ordinal":57708,"en":"Their standards fluttering in their hands."},{"id":"manas-2010:p1332:b001:l042","ordinal":57709,"en":"Any mortal who saw them marveled,"},{"id":"manas-2010:p1333:b001:l001","ordinal":57710,"en":"The mighty army, like a lake,"},{"id":"manas-2010:p1333:b001:l002","ordinal":57711,"en":"Moved onward in high spirits."},{"id":"manas-2010:p1333:b001:l003","ordinal":57712,"en":"The sky was clear, the earth overcast;"},{"id":"manas-2010:p1333:b001:l004","ordinal":57713,"en":"The face of the earth could not be seen."},{"id":"manas-2010:p1333:b001:l005","ordinal":57714,"en":"The whole plain became dust;"},{"id":"manas-2010:p1333:b001:l006","ordinal":57715,"en":"Its hollows and hills alike"},{"id":"manas-2010:p1333:b001:l007","ordinal":57716,"en":"Were filled with men like ants."},{"id":"manas-2010:p1333:b001:l008","ordinal":57717,"en":"Not merely humans, but beasts,"},{"id":"manas-2010:p1333:b001:l009","ordinal":57718,"en":"Even winged birds were stupefied."},{"id":"manas-2010:p1333:b001:l010","ordinal":57719,"en":"Within that army,"},{"id":"manas-2010:p1333:b001:l011","ordinal":57720,"en":"There were elders fertile in wisdom."},{"id":"manas-2010:p1333:b001:l012","ordinal":57721,"en":"Who would charge the enemy without fear,"},{"id":"manas-2010:p1333:b001:l013","ordinal":57722,"en":"All the brave men were there."},{"id":"manas-2010:p1333:b001:l014","ordinal":57723,"en":"Men had come, clan by clan."},{"id":"manas-2010:p1333:b001:l015","ordinal":57724,"en":"“To the Muslim army,"},{"id":"manas-2010:p1333:b001:l016","ordinal":57725,"en":"I shall serve as imam,” he said."},{"id":"manas-2010:p1333:b001:l017","ordinal":57726,"en":"Aykhozho from Mecca,"},{"id":"manas-2010:p1333:b001:l018","ordinal":57727,"en":"He had come expressly with that wish."},{"id":"manas-2010:p1333:b001:l019","ordinal":57728,"en":"Within this army,"},{"id":"manas-2010:p1333:b001:l020","ordinal":57729,"en":"How many worthy men there were!"},{"id":"manas-2010:p1333:b001:l021","ordinal":57730,"en":"Bearing the Muslim standard,"},{"id":"manas-2010:p1333:b001:l022","ordinal":57731,"en":"Old Koshoy was there too."},{"id":"manas-2010:p1333:b001:l023","ordinal":57732,"en":"The jutting spurs and promontories,"},{"id":"manas-2010:p1333:b001:l024","ordinal":57733,"en":"They went on cutting through them."},{"id":"manas-2010:p1333:b001:l025","ordinal":57734,"en":"The finest parts of many lands,"},{"id":"manas-2010:p1333:b001:l026","ordinal":57735,"en":"They went on seeing them."},{"id":"manas-2010:p1333:b001:l027","ordinal":57736,"en":"“This is Ak-Zholoochu Ridge,” they said."},{"id":"manas-2010:p1333:b001:l028","ordinal":57737,"en":"“A place for warriors to travel,” they said."},{"id":"manas-2010:p1333:b001:l029","ordinal":57738,"en":"Marveling at the land they saw,"},{"id":"manas-2010:p1333:b001:l030","ordinal":57739,"en":"All the accomplished warriors"},{"id":"manas-2010:p1333:b001:l031","ordinal":57740,"en":"Prepared their battle equipment."},{"id":"manas-2010:p1333:b001:l032","ordinal":57741,"en":"Twelve Muslim khans,"},{"id":"manas-2010:p1333:b001:l033","ordinal":57742,"en":"Khans had come from every clan."},{"id":"manas-2010:p1333:b001:l034","ordinal":57743,"en":"Among these khans,"},{"id":"manas-2010:p1333:b001:l035","ordinal":57744,"en":"A warrior indeed, that daughter-fucker,"},{"id":"manas-2010:p1333:b001:l036","ordinal":57745,"en":"Khan Buudayyk's Muzburchak,"},{"id":"manas-2010:p1333:b001:l037","ordinal":57746,"en":"He was young, not old."},{"id":"manas-2010:p1333:b001:l038","ordinal":57747,"en":"After warrior Manas,"},{"id":"manas-2010:p1333:b001:l039","ordinal":57748,"en":"He was a chief who would rule the people."},{"id":"manas-2010:p1333:b001:l040","ordinal":57749,"en":"The stars in the sky were pale;"},{"id":"manas-2010:p1333:b001:l041","ordinal":57750,"en":"Blue-maned Manas and Muzburchak"},{"id":"manas-2010:p1333:b001:l042","ordinal":57751,"en":"Were friends for the afterlife."},{"id":"manas-2010:p1334:b001:l001","ordinal":57752,"en":"He was khan of Crimea down below."},{"id":"manas-2010:p1334:b001:l002","ordinal":57753,"en":"In this very year, Muzburchak"},{"id":"manas-2010:p1334:b001:l003","ordinal":57754,"en":"Had reached twenty-five;"},{"id":"manas-2010:p1334:b001:l004","ordinal":57755,"en":"He had just turned that age."},{"id":"manas-2010:p1334:b001:l005","ordinal":57756,"en":"What he rode beneath him"},{"id":"manas-2010:p1334:b001:l006","ordinal":57757,"en":"Was the courser Telkyzyl."},{"id":"manas-2010:p1334:b001:l007","ordinal":57758,"en":"Khan Buudayyk's Muzburchak,"},{"id":"manas-2010:p1334:b001:l008","ordinal":57759,"en":"Who never drew back from death,"},{"id":"manas-2010:p1334:b001:l009","ordinal":57760,"en":"Was a stubborn warrior."},{"id":"manas-2010:p1334:b001:l010","ordinal":57761,"en":"With a standard bearing a golden crescent,"},{"id":"manas-2010:p1334:b001:l011","ordinal":57762,"en":"With the uproar of shouts,"},{"id":"manas-2010:p1334:b001:l012","ordinal":57763,"en":"Galloping on Telkyzyl,"},{"id":"manas-2010:p1334:b001:l013","ordinal":57764,"en":"From that immense host,"},{"id":"manas-2010:p1334:b001:l014","ordinal":57765,"en":"Muzburchak separated his own army."},{"id":"manas-2010:p1334:b001:l015","ordinal":57766,"en":"He went out separately in front,"},{"id":"manas-2010:p1334:b001:l016","ordinal":57767,"en":"Looking like a lion."},{"id":"manas-2010:p1334:b001:l017","ordinal":57768,"en":"Riding on, calling out,"},{"id":"manas-2010:p1334:b001:l018","ordinal":57769,"en":"Without letting a single soul know,"},{"id":"manas-2010:p1334:b001:l019","ordinal":57770,"en":"Körögöch beside him,"},{"id":"manas-2010:p1334:b001:l020","ordinal":57771,"en":"He called, “Come here!”"},{"id":"manas-2010:p1334:b001:l021","ordinal":57772,"en":"“You were perceptive, Körögöch!"},{"id":"manas-2010:p1334:b001:l022","ordinal":57773,"en":"Do you know what I know!"},{"id":"manas-2010:p1334:b001:l023","ordinal":57774,"en":"Have you seen what I have seen?"},{"id":"manas-2010:p1334:b001:l024","ordinal":57775,"en":"If you do not know what I know,"},{"id":"manas-2010:p1334:b001:l025","ordinal":57776,"en":"‘My dear falcon Manas"},{"id":"manas-2010:p1334:b001:l026","ordinal":57777,"en":"Has gone and taken Beijing,’ they say."},{"id":"manas-2010:p1334:b001:l027","ordinal":57778,"en":"Those men are telling lies."},{"id":"manas-2010:p1334:b001:l028","ordinal":57779,"en":"In the kakan's Beijing,"},{"id":"manas-2010:p1334:b001:l029","ordinal":57780,"en":"Aybanboz has ceased to move;"},{"id":"manas-2010:p1334:b001:l030","ordinal":57781,"en":"They have surrounded Manas."},{"id":"manas-2010:p1334:b001:l031","ordinal":57782,"en":"‘He has taken girls as spoils,’ he says."},{"id":"manas-2010:p1334:b001:l032","ordinal":57783,"en":"That champion boy Syrgak's"},{"id":"manas-2010:p1334:b001:l033","ordinal":57784,"en":"Enticing us like this"},{"id":"manas-2010:p1334:b001:l034","ordinal":57785,"en":"Is because Manas is hard pressed."},{"id":"manas-2010:p1334:b001:l035","ordinal":57786,"en":"Come here, Körögöch,"},{"id":"manas-2010:p1334:b001:l036","ordinal":57787,"en":"To charge straight in and wage battle."},{"id":"manas-2010:p1334:b001:l037","ordinal":57788,"en":"Sparing no living soul,"},{"id":"manas-2010:p1334:b001:l038","ordinal":57789,"en":"Wading knee-deep in crimson blood,"},{"id":"manas-2010:p1334:b001:l039","ordinal":57790,"en":"For one who wages war on Beijing,"},{"id":"manas-2010:p1334:b001:l040","ordinal":57791,"en":"How could any wish remain unfulfilled!"},{"id":"manas-2010:p1334:b001:l041","ordinal":57792,"en":"When he heard these words,"},{"id":"manas-2010:p1334:b001:l042","ordinal":57793,"en":"Körögöch followed behind;"},{"id":"manas-2010:p1335:b001:l001","ordinal":57794,"en":"Muzburchak went in front."},{"id":"manas-2010:p1335:b001:l002","ordinal":57795,"en":"The immeasurably mighty warriors,"},{"id":"manas-2010:p1335:b001:l003","ordinal":57796,"en":"Körögöch whetted their resolve."},{"id":"manas-2010:p1335:b001:l004","ordinal":57797,"en":"The simple-minded braggarts,"},{"id":"manas-2010:p1335:b001:l005","ordinal":57798,"en":"‘If you arrive there first,"},{"id":"manas-2010:p1335:b001:l006","ordinal":57799,"en":"You will get the women and girls,’ he said."},{"id":"manas-2010:p1335:b001:l007","ordinal":57800,"en":"Körögöch spurred them on."},{"id":"manas-2010:p1335:b001:l008","ordinal":57801,"en":"The sly ones with wicked schemes,"},{"id":"manas-2010:p1335:b001:l009","ordinal":57802,"en":"Körögöch drove them onward."},{"id":"manas-2010:p1335:b001:l010","ordinal":57803,"en":"Making some of them dash forward,"},{"id":"manas-2010:p1335:b001:l011","ordinal":57804,"en":"Körögöch went on his way."},{"id":"manas-2010:p1335:b001:l012","ordinal":57805,"en":"“Our purpose is, to Beijing,"},{"id":"manas-2010:p1335:b001:l013","ordinal":57806,"en":"Let us arrive there first."},{"id":"manas-2010:p1335:b001:l014","ordinal":57807,"en":"From Manas of endless bounty,"},{"id":"manas-2010:p1335:b001:l015","ordinal":57808,"en":"The yellow gold and their girls,"},{"id":"manas-2010:p1335:b001:l016","ordinal":57809,"en":"Let us receive them as gifts."},{"id":"manas-2010:p1335:b001:l017","ordinal":57810,"en":"A mighty army of twelve san,"},{"id":"manas-2010:p1335:b001:l018","ordinal":57811,"en":"Consider it, men of resolve,"},{"id":"manas-2010:p1335:b001:l019","ordinal":57812,"en":"Let us be foremost among the people!”"},{"id":"manas-2010:p1335:b001:l020","ordinal":57813,"en":"Those who heard this,"},{"id":"manas-2010:p1335:b001:l021","ordinal":57814,"en":"Those on gray horses went apart."},{"id":"manas-2010:p1335:b001:l022","ordinal":57815,"en":"Not sparing their vigorous lives,"},{"id":"manas-2010:p1335:b001:l023","ordinal":57816,"en":"They divided in groups."},{"id":"manas-2010:p1335:b001:l024","ordinal":57817,"en":"They took their spears in hand,"},{"id":"manas-2010:p1335:b001:l025","ordinal":57818,"en":"They let their horses have their heads."},{"id":"manas-2010:p1335:b001:l026","ordinal":57819,"en":"Their horses carried them away;"},{"id":"manas-2010:p1335:b001:l027","ordinal":57820,"en":"Both their arms grew rigid."},{"id":"manas-2010:p1335:b001:l028","ordinal":57821,"en":"Within that army,"},{"id":"manas-2010:p1335:b001:l029","ordinal":57822,"en":"One portion were Sarts."},{"id":"manas-2010:p1335:b001:l030","ordinal":57823,"en":"They were no people to lean upon,"},{"id":"manas-2010:p1335:b001:l031","ordinal":57824,"en":"No people to trust firmly;"},{"id":"manas-2010:p1335:b001:l032","ordinal":57825,"en":"They were an affliction like backache."},{"id":"manas-2010:p1335:b001:l033","ordinal":57826,"en":"Dust rose up to the sky as they came."},{"id":"manas-2010:p1335:b001:l034","ordinal":57827,"en":"As though those here were too few,"},{"id":"manas-2010:p1335:b001:l035","ordinal":57828,"en":"They had come from India as well."},{"id":"manas-2010:p1335:b001:l036","ordinal":57829,"en":"Behind Muzburchak,"},{"id":"manas-2010:p1335:b001:l037","ordinal":57830,"en":"Their thoroughbreds holding their heads high,"},{"id":"manas-2010:p1335:b001:l038","ordinal":57831,"en":"Their blue slippers sticking out,"},{"id":"manas-2010:p1335:b001:l039","ordinal":57832,"en":"Their turbans spreading broad,"},{"id":"manas-2010:p1335:b001:l040","ordinal":57833,"en":"Their beards waving,"},{"id":"manas-2010:p1335:b001:l041","ordinal":57834,"en":"Their thoroughbreds thudding,"},{"id":"manas-2010:p1335:b001:l042","ordinal":57835,"en":"The stout-lunged, booming men,"},{"id":"manas-2010:p1336:b001:l001","ordinal":57836,"en":"The Sart army now moved."},{"id":"manas-2010:p1336:b001:l002","ordinal":57837,"en":"Behind this army,"},{"id":"manas-2010:p1336:b001:l003","ordinal":57838,"en":"With lattice walls of wood,"},{"id":"manas-2010:p1336:b001:l004","ordinal":57839,"en":"Whose earliest forefather was Alash,"},{"id":"manas-2010:p1336:b001:l005","ordinal":57840,"en":"His blue boots and their heels,"},{"id":"manas-2010:p1336:b001:l006","ordinal":57841,"en":"Aydarkan's Kökchö,"},{"id":"manas-2010:p1336:b001:l007","ordinal":57842,"en":"Who dwelt in Sary-Arka,"},{"id":"manas-2010:p1336:b001:l008","ordinal":57843,"en":"Said to be a weighty, mighty warrior,"},{"id":"manas-2010:p1336:b001:l009","ordinal":57844,"en":"Who husked his millet clean as stone,"},{"id":"manas-2010:p1336:b001:l010","ordinal":57845,"en":"Who praised his wife like a maiden,"},{"id":"manas-2010:p1336:b001:l011","ordinal":57846,"en":"Your champion, warrior Kökchö,"},{"id":"manas-2010:p1336:b001:l012","ordinal":57847,"en":"Surging upon Kögala,"},{"id":"manas-2010:p1336:b001:l013","ordinal":57848,"en":"As though he would allot inheritances,"},{"id":"manas-2010:p1336:b001:l014","ordinal":57849,"en":"Singing his songs loudly,"},{"id":"manas-2010:p1336:b001:l015","ordinal":57850,"en":"His warriors raising a clamor,"},{"id":"manas-2010:p1336:b001:l016","ordinal":57851,"en":"Rejoicing at the word enemy,"},{"id":"manas-2010:p1336:b001:l017","ordinal":57852,"en":"Bending like hungry lions,"},{"id":"manas-2010:p1336:b001:l018","ordinal":57853,"en":"The many Kazakhs moved on."},{"id":"manas-2010:p1336:b001:l019","ordinal":57854,"en":"What his troops rode,"},{"id":"manas-2010:p1336:b001:l020","ordinal":57855,"en":"All were alike, dun-colored,"},{"id":"manas-2010:p1336:b001:l021","ordinal":57856,"en":"With amulet-shaped marks on their foreheads."}]
