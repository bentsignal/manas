{"id": "sayakbay-ms-current142:pdf027:l041", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 27, "folio": 2344, "line_in_page": 41, "raw": "Жолдон чыгып баарысы,", "text": "Жолдон чыгып баарысы,", "en": "All of them came off the road,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Reading is probable but not fully clear.", "bbox": null}
{"id": "sayakbay-ms-current142:pdf027:l042", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 27, "folio": 2344, "line_in_page": 42, "raw": "Босого жерине урагын,", "text": "Босого жерине урагын,", "en": "At the threshold, strike him down,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Imperative verb is uncertain.", "bbox": null}
{"id": "sayakbay-ms-current142:pdf027:l043", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 27, "folio": 2344, "line_in_page": 43, "raw": "Буйругу чукал мен эмеспи,", "text": "Буйругу чукал мен эмеспи,", "en": "Was I not the one whose command was harsh,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Adjective and final particle are difficult.", "bbox": null}
{"id": "sayakbay-ms-current142:pdf027:l044", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 27, "folio": 2344, "line_in_page": 44, "raw": "Будуң менен турбадың,", "text": "Будуң менен турбадың,", "en": "You did not stand with your whole body,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "First noun may be another word.", "bbox": null}
{"id": "sayakbay-ms-current142:pdf027:l045", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 27, "folio": 2344, "line_in_page": 45, "raw": "Түшүм бузуп, эмне болдуң,", "text": "Түшүм бузуп, эмне болдуң,", "en": "Disturbing my dream, what happened to you,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Possessive ending and last verb are uncertain.", "bbox": null}
{"id": "sayakbay-ms-current142:pdf027:l046", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 27, "folio": 2344, "line_in_page": 46, "raw": "Казар койду Карчабай,", "text": "Казар койду Карчабай,", "en": "Karchabai set [them] digging,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Personal name and initial verb are tentative.", "bbox": null}
{"id": "sayakbay-ms-current142:pdf027:l047", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 27, "folio": 2344, "line_in_page": 47, "raw": "Бузулганы көп болуп,", "text": "Бузулганы көп болуп,", "en": "Much had fallen into ruin,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Some letters in the first word are merged.", "bbox": null}
