{"id": "sayakbay-ms-current146:pdf029:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 29, "folio": 412, "line_in_page": 8, "raw": "Суурулган менен Чыңтеңир,", "text": "Суурулган менен Чыңтеңир,", "en": "Chyngtenir came surging forth,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The proper name follows the published counterpart; the participial construction is translated contextually.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf029:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 29, "folio": 412, "line_in_page": 9, "raw": "Айбатынан жан коркуп,", "text": "Айбатынан жан коркуп,", "en": "At his menace, souls took fright,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf029:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 29, "folio": 412, "line_in_page": 10, "raw": "Ажарынан кан качып,", "text": "Ажарынан кан качып,", "en": "At his visage, the blood drained away,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf029:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 29, "folio": 412, "line_in_page": 11, "raw": "Турпаты экен беле экен,", "text": "Турпаты экен беле экен,", "en": "What a figure he proved to be,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The middle and final words are faint; this completion-first reading follows the visible letter forms and parallel formula.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf029:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 29, "folio": 412, "line_in_page": 12, "raw": "Теңегиши тең экен,", "text": "Теңегиши тең экен,", "en": "His equal was truly his match,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The first word is difficult in the hand and may be a nearby formulaic form.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf029:l013", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 29, "folio": 412, "line_in_page": 13, "raw": "Эң кайраттуу, заары күч,", "text": "Эң кайраттуу, заары күч,", "en": "Most valiant, with fierce wrath,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf029:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 29, "folio": 412, "line_in_page": 14, "raw": "Жан казандай башы бар,", "text": "Жан казандай башы бар,", "en": "With a head like a small cauldron,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf029:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 29, "folio": 412, "line_in_page": 15, "raw": "Жаткан нардай кашы бар,", "text": "Жаткан нардай кашы бар,", "en": "With brows like a recumbent camel,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The first comparison noun is difficult; нардай is the best visible reading.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf029:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 29, "folio": 412, "line_in_page": 16, "raw": "Камчыдай тиши бар,", "text": "Камчыдай тиши бар,", "en": "With teeth like a whip,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The comparison word is provisional; the handwriting is indistinct.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf029:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 29, "folio": 412, "line_in_page": 17, "raw": "Ай-ааламдай бети чыккан,", "text": "Ай-ааламдай бети чыккан,", "en": "His face loomed as vast as the whole world,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The final verb is slightly faint but readable in context.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf029:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 29, "folio": 412, "line_in_page": 18, "raw": "Жаанга төбөс курч бар,", "text": "Жаанга төбөс курч бар,", "en": "His crown stood sharp against the rain,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Several letters in this epithet are difficult; translation is a literal completion-first rendering.", "bbox": null}
