[{"id":"manas-2010:p1092:b001:l034","ordinal":47617,"en":"When the sun sank to its nest,"},{"id":"manas-2010:p1092:b001:l035","ordinal":47618,"en":"I reached my mother."},{"id":"manas-2010:p1092:b001:l036","ordinal":47619,"en":"Help came from Heaven;"},{"id":"manas-2010:p1092:b001:l037","ordinal":47620,"en":"God shed His light, I thought."},{"id":"manas-2010:p1092:b001:l038","ordinal":47621,"en":"Tash-Köpürö, forty days away—"},{"id":"manas-2010:p1092:b001:l039","ordinal":47622,"en":"Now, when I think of it,"},{"id":"manas-2010:p1092:b001:l040","ordinal":47623,"en":"The angel Gabriel"},{"id":"manas-2010:p1092:b001:l041","ordinal":47624,"en":"Must have drawn in the earth's measuring-rope."},{"id":"manas-2010:p1092:b001:l042","ordinal":47625,"en":"That difficult forty-day road,"},{"id":"manas-2010:p1093:b001:l001","ordinal":47626,"en":"The wondrously swift Sarala"},{"id":"manas-2010:p1093:b001:l002","ordinal":47627,"en":"Covered in half a day."},{"id":"manas-2010:p1093:b001:l003","ordinal":47628,"en":"Fearing my horse would collapse and die,"},{"id":"manas-2010:p1093:b001:l004","ordinal":47629,"en":"Lose his mane and tail,"},{"id":"manas-2010:p1093:b001:l005","ordinal":47630,"en":"And suffer as never before,"},{"id":"manas-2010:p1093:b001:l006","ordinal":47631,"en":"I grasped his sacred mane."},{"id":"manas-2010:p1093:b001:l007","ordinal":47632,"en":"He had a mane like a lead-rope;"},{"id":"manas-2010:p1093:b001:l008","ordinal":47633,"en":"Sarala, the swift creature,"},{"id":"manas-2010:p1093:b001:l009","ordinal":47634,"en":"Had tethered himself."},{"id":"manas-2010:p1093:b001:l010","ordinal":47635,"en":"On that day Sarala"},{"id":"manas-2010:p1093:b001:l011","ordinal":47636,"en":"Was ready to fly."},{"id":"manas-2010:p1093:b001:l012","ordinal":47637,"en":"As the sun sank slowly,"},{"id":"manas-2010:p1093:b001:l013","ordinal":47638,"en":"I reached my mother."},{"id":"manas-2010:p1093:b001:l014","ordinal":47639,"en":"Around Azizkan's great pillar"},{"id":"manas-2010:p1093:b001:l015","ordinal":47640,"en":"I looped the lead-rope."},{"id":"manas-2010:p1093:b001:l016","ordinal":47641,"en":"I thought her dead, but she was alive."},{"id":"manas-2010:p1093:b001:l017","ordinal":47642,"en":"A curse upon such living!"},{"id":"manas-2010:p1093:b001:l018","ordinal":47643,"en":"Through sorrow and anguish,"},{"id":"manas-2010:p1093:b001:l019","ordinal":47644,"en":"She was as one of the dead."},{"id":"manas-2010:p1093:b001:l020","ordinal":47645,"en":"When I saw my mother,"},{"id":"manas-2010:p1093:b001:l021","ordinal":47646,"en":"I did not stretch my neck and turn."},{"id":"manas-2010:p1093:b001:l022","ordinal":47647,"en":"With no thought of becoming Muslim,"},{"id":"manas-2010:p1093:b001:l023","ordinal":47648,"en":"A wretched soul Chinese from the first,"},{"id":"manas-2010:p1093:b001:l024","ordinal":47649,"en":"Bending my knees and bowing,"},{"id":"manas-2010:p1093:b001:l025","ordinal":47650,"en":"I paid homage in the Chinese fashion."},{"id":"manas-2010:p1093:b001:l026","ordinal":47651,"en":"Altynay, my dear mother,"},{"id":"manas-2010:p1093:b001:l027","ordinal":47652,"en":"Did not look at my fair face."},{"id":"manas-2010:p1093:b001:l028","ordinal":47653,"en":"Turning sharply away,"},{"id":"manas-2010:p1093:b001:l029","ordinal":47654,"en":"Jerking round in the opposite direction,"},{"id":"manas-2010:p1093:b001:l030","ordinal":47655,"en":"She did not come to greet me."},{"id":"manas-2010:p1093:b001:l031","ordinal":47656,"en":"She poured no bowl, gave me no food,"},{"id":"manas-2010:p1093:b001:l032","ordinal":47657,"en":"Not food, not even a black stone."},{"id":"manas-2010:p1093:b001:l033","ordinal":47658,"en":"In Tash-Köpürö's fortress,"},{"id":"manas-2010:p1093:b001:l034","ordinal":47659,"en":"When it was time for people to sleep,"},{"id":"manas-2010:p1093:b001:l035","ordinal":47660,"en":"She laid out white down,"},{"id":"manas-2010:p1093:b001:l036","ordinal":47661,"en":"With its head toward the prayer-direction."},{"id":"manas-2010:p1093:b001:l037","ordinal":47662,"en":"My mother made a bed; I lay down."},{"id":"manas-2010:p1093:b001:l038","ordinal":47663,"en":"When my eyes closed in sleep,"},{"id":"manas-2010:p1093:b001:l039","ordinal":47664,"en":"I found myself lying in sunlight."},{"id":"manas-2010:p1093:b001:l040","ordinal":47665,"en":"As I lay there, in my dream,"},{"id":"manas-2010:p1093:b001:l041","ordinal":47666,"en":"Cleansed of the dark religion,"},{"id":"manas-2010:p1093:b001:l042","ordinal":47667,"en":"I was entering the faith."},{"id":"manas-2010:p1094:b001:l001","ordinal":47668,"en":"A holy man's staff was in my hand,"},{"id":"manas-2010:p1094:b001:l002","ordinal":47669,"en":"A white turban was on my head."},{"id":"manas-2010:p1094:b001:l003","ordinal":47670,"en":"I ran barefoot, painfully onward."},{"id":"manas-2010:p1094:b001:l004","ordinal":47671,"en":"May no mortal suffer it:"},{"id":"manas-2010:p1094:b001:l005","ordinal":47672,"en":"I came upon a road of calamity."},{"id":"manas-2010:p1094:b001:l006","ordinal":47673,"en":"If I tried to walk, I screamed;"},{"id":"manas-2010:p1094:b001:l007","ordinal":47674,"en":"My poor legs, all of them,"},{"id":"manas-2010:p1094:b001:l008","ordinal":47675,"en":"Were stripped up to the knees."},{"id":"manas-2010:p1094:b001:l009","ordinal":47676,"en":"If I tried not to walk, I screamed;"},{"id":"manas-2010:p1094:b001:l010","ordinal":47677,"en":"My fly-like soul was scorched."},{"id":"manas-2010:p1094:b001:l011","ordinal":47678,"en":"When I looked to my right—"},{"id":"manas-2010:p1094:b001:l012","ordinal":47679,"en":"May a faithful young man not die!"},{"id":"manas-2010:p1094:b001:l013","ordinal":47680,"en":"The torment that I saw,"},{"id":"manas-2010:p1094:b001:l014","ordinal":47681,"en":"May no human being receive it!"},{"id":"manas-2010:p1094:b001:l015","ordinal":47682,"en":"When I looked to my left,"},{"id":"manas-2010:p1094:b001:l016","ordinal":47683,"en":"Seven doors appeared."},{"id":"manas-2010:p1094:b001:l017","ordinal":47684,"en":"When I saw those seven doors,"},{"id":"manas-2010:p1094:b001:l018","ordinal":47685,"en":"Tears poured from my eyes."},{"id":"manas-2010:p1094:b001:l019","ordinal":47686,"en":"Those who said, “I'll go and see,”"},{"id":"manas-2010:p1094:b001:l020","ordinal":47687,"en":"Champions who vaunted their strength,"},{"id":"manas-2010:p1094:b001:l021","ordinal":47688,"en":"Those who consumed another's due—"},{"id":"manas-2010:p1094:b001:l022","ordinal":47689,"en":"It was a place where the ignorant lay."},{"id":"manas-2010:p1094:b001:l023","ordinal":47690,"en":"When I looked closely then,"},{"id":"manas-2010:p1094:b001:l024","ordinal":47691,"en":"It was the hell of torment."},{"id":"manas-2010:p1094:b001:l025","ordinal":47692,"en":"God subjected me to suffering."},{"id":"manas-2010:p1094:b001:l026","ordinal":47693,"en":"Just then I encountered"},{"id":"manas-2010:p1094:b001:l027","ordinal":47694,"en":"That old white-bearded holy wanderer."},{"id":"manas-2010:p1094:b001:l028","ordinal":47695,"en":"I thrashed up and down."},{"id":"manas-2010:p1094:b001:l029","ordinal":47696,"en":"“Explain its meaning to me,”"},{"id":"manas-2010:p1094:b001:l030","ordinal":47697,"en":"I asked the holy man."},{"id":"manas-2010:p1094:b001:l031","ordinal":47698,"en":"The holy man stood and said:"},{"id":"manas-2010:p1094:b001:l032","ordinal":47699,"en":"“First profess your faith, my son."},{"id":"manas-2010:p1094:b001:l033","ordinal":47700,"en":"While you still can, Almambet,"},{"id":"manas-2010:p1094:b001:l034","ordinal":47701,"en":"Turn to the Islamic faith, my son."},{"id":"manas-2010:p1094:b001:l035","ordinal":47702,"en":"Seen today, gone tomorrow,"},{"id":"manas-2010:p1094:b001:l036","ordinal":47703,"en":"Distracting you in this way,"},{"id":"manas-2010:p1094:b001:l037","ordinal":47704,"en":"The mischievous world deceives you!"},{"id":"manas-2010:p1094:b001:l038","ordinal":47705,"en":"My son, look to your right:"},{"id":"manas-2010:p1094:b001:l039","ordinal":47706,"en":"Palaces built there, cool houses,"},{"id":"manas-2010:p1094:b001:l040","ordinal":47707,"en":"Apples joined in pairs,"},{"id":"manas-2010:p1094:b001:l041","ordinal":47708,"en":"Beautiful girls arm in arm—"},{"id":"manas-2010:p1094:b001:l042","ordinal":47709,"en":"Let me explain these things."},{"id":"manas-2010:p1095:b001:l001","ordinal":47710,"en":"The palaces and cool houses"},{"id":"manas-2010:p1095:b001:l002","ordinal":47711,"en":"Are allotted to faithful servants;"},{"id":"manas-2010:p1095:b001:l003","ordinal":47712,"en":"That is where Muslims will dwell."},{"id":"manas-2010:p1095:b001:l004","ordinal":47713,"en":"The many apples joined together,"},{"id":"manas-2010:p1095:b001:l005","ordinal":47714,"en":"Which quench thirst when eaten,"},{"id":"manas-2010:p1095:b001:l006","ordinal":47715,"en":"Are the food that Muslims will eat."},{"id":"manas-2010:p1095:b001:l007","ordinal":47716,"en":"The beautiful girls arm in arm,"},{"id":"manas-2010:p1095:b001:l008","ordinal":47717,"en":"Granted to the faithful,"},{"id":"manas-2010:p1095:b001:l009","ordinal":47718,"en":"A virgin each day, though lain with each day—"},{"id":"manas-2010:p1095:b001:l010","ordinal":47719,"en":"On the coming Day of Judgment,"},{"id":"manas-2010:p1095:b001:l011","ordinal":47720,"en":"Those are the wives Muslims will receive."},{"id":"manas-2010:p1095:b001:l012","ordinal":47721,"en":"As you wish, pass away an infidel, my son;"},{"id":"manas-2010:p1095:b001:l013","ordinal":47722,"en":"You will go to the ravine on the left,"},{"id":"manas-2010:p1095:b001:l014","ordinal":47723,"en":"If you die a Muslim.”"},{"id":"manas-2010:p1095:b001:l015","ordinal":47724,"en":"Saying this, the holy man"},{"id":"manas-2010:p1095:b001:l016","ordinal":47725,"en":"Vanished from sight."},{"id":"manas-2010:p1095:b001:l017","ordinal":47726,"en":"I awoke with a start,"},{"id":"manas-2010:p1095:b001:l018","ordinal":47727,"en":"And turned onto my right side."},{"id":"manas-2010:p1095:b001:l019","ordinal":47728,"en":"It was a dream seen in sleep;"},{"id":"manas-2010:p1095:b001:l020","ordinal":47729,"en":"It was God's doing."},{"id":"manas-2010:p1095:b001:l021","ordinal":47730,"en":"Bright dawn had broken;"},{"id":"manas-2010:p1095:b001:l022","ordinal":47731,"en":"Light had come upon the earth."},{"id":"manas-2010:p1095:b001:l023","ordinal":47732,"en":"My mother Altynay,"},{"id":"manas-2010:p1095:b001:l024","ordinal":47733,"en":"Her head upon the prayer-rug,"},{"id":"manas-2010:p1095:b001:l025","ordinal":47734,"en":"Facing the direction of prayer,"},{"id":"manas-2010:p1095:b001:l026","ordinal":47735,"en":"Was immersed in great delight."},{"id":"manas-2010:p1095:b001:l027","ordinal":47736,"en":"In the Muslim manner, my mother"},{"id":"manas-2010:p1095:b001:l028","ordinal":47737,"en":"Was reciting her prayers."},{"id":"manas-2010:p1095:b001:l029","ordinal":47738,"en":"My heart was deeply disturbed;"},{"id":"manas-2010:p1095:b001:l030","ordinal":47739,"en":"Chinese from the first, a wretched soul,"},{"id":"manas-2010:p1095:b001:l031","ordinal":47740,"en":"“With her backside raised,"},{"id":"manas-2010:p1095:b001:l032","ordinal":47741,"en":"What kind of prayer is she praying?” I thought."},{"id":"manas-2010:p1095:b001:l033","ordinal":47742,"en":"It looked ugly to my eyes."},{"id":"manas-2010:p1095:b001:l034","ordinal":47743,"en":"When she had said her prayers,"},{"id":"manas-2010:p1095:b001:l035","ordinal":47744,"en":"When she folded her prayer-rug,"},{"id":"manas-2010:p1095:b001:l036","ordinal":47745,"en":"I told her what had happened."},{"id":"manas-2010:p1095:b001:l037","ordinal":47746,"en":"I related to my mother"},{"id":"manas-2010:p1095:b001:l038","ordinal":47747,"en":"The dream I had seen that night."},{"id":"manas-2010:p1095:b001:l039","ordinal":47748,"en":"Then my mother said this:"},{"id":"manas-2010:p1095:b001:l040","ordinal":47749,"en":"“O my son, I was the wife of Light;"},{"id":"manas-2010:p1095:b001:l041","ordinal":47750,"en":"Pure in spirit from birth,"},{"id":"manas-2010:p1095:b001:l042","ordinal":47751,"en":"You were the son of Light."},{"id":"manas-2010:p1096:b001:l001","ordinal":47752,"en":"Lingering among the Chinese,"},{"id":"manas-2010:p1096:b001:l002","ordinal":47753,"en":"What wish will you fulfill?"},{"id":"manas-2010:p1096:b001:l003","ordinal":47754,"en":"Grabbing me by the hair, you dark night,"},{"id":"manas-2010:p1096:b001:l004","ordinal":47755,"en":"Into that hell"},{"id":"manas-2010:p1096:b001:l005","ordinal":47756,"en":"You will drag me with you."},{"id":"manas-2010:p1096:b001:l006","ordinal":47757,"en":"Speak, my son, profess it, my son!"},{"id":"manas-2010:p1096:b001:l007","ordinal":47758,"en":"Draw your horse's reins, my son."},{"id":"manas-2010:p1096:b001:l008","ordinal":47759,"en":"Go to the white palace, my son;"},{"id":"manas-2010:p1096:b001:l009","ordinal":47760,"en":"Bathe your body in water, my son."},{"id":"manas-2010:p1096:b001:l010","ordinal":47761,"en":"Afterward come back,"},{"id":"manas-2010:p1096:b001:l011","ordinal":47762,"en":"And see your mother's face,” she said."},{"id":"manas-2010:p1096:b001:l012","ordinal":47763,"en":"A washing ewer filled"},{"id":"manas-2010:p1096:b001:l013","ordinal":47764,"en":"With water she put in my hand."},{"id":"manas-2010:p1096:b001:l014","ordinal":47765,"en":"A razor made of steel—"},{"id":"manas-2010:p1096:b001:l015","ordinal":47766,"en":"“Cleanse yourself front and back,"},{"id":"manas-2010:p1096:b001:l016","ordinal":47767,"en":"Then come afterward,” she said,"},{"id":"manas-2010:p1096:b001:l017","ordinal":47768,"en":"And gave that into my hand too."},{"id":"manas-2010:p1096:b001:l018","ordinal":47769,"en":"My mother drove me out, and I went."},{"id":"manas-2010:p1096:b001:l019","ordinal":47770,"en":"I went to the white palace;"},{"id":"manas-2010:p1096:b001:l020","ordinal":47771,"en":"I bathed my body in water."},{"id":"manas-2010:p1096:b001:l021","ordinal":47772,"en":"With the razor made of steel,"},{"id":"manas-2010:p1096:b001:l022","ordinal":47773,"en":"I cleansed myself front and back."},{"id":"manas-2010:p1096:b001:l023","ordinal":47774,"en":"Then to my mother"},{"id":"manas-2010:p1096:b001:l024","ordinal":47775,"en":"I came walking back."},{"id":"manas-2010:p1096:b001:l025","ordinal":47776,"en":"My mother's shining white face"},{"id":"manas-2010:p1096:b001:l026","ordinal":47777,"en":"I saw only afterward."},{"id":"manas-2010:p1096:b001:l027","ordinal":47778,"en":"My friend Manas, leopard,"},{"id":"manas-2010:p1096:b001:l028","ordinal":47779,"en":"I, your Almambet standing before you,"},{"id":"manas-2010:p1096:b001:l029","ordinal":47780,"en":"Entered the faith in this way."},{"id":"manas-2010:p1096:b001:l030","ordinal":47781,"en":"Because there is a Judgment Day,"},{"id":"manas-2010:p1096:b001:l031","ordinal":47782,"en":"Because of the hair-thin bridge,"},{"id":"manas-2010:p1096:b001:l032","ordinal":47783,"en":"I came to my people without looking back."},{"id":"manas-2010:p1096:b001:l033","ordinal":47784,"en":"Khan Manas, I renounced my idol,"},{"id":"manas-2010:p1096:b001:l034","ordinal":47785,"en":"I left my Chinese homeland."},{"id":"manas-2010:p1096:b001:l035","ordinal":47786,"en":"I scattered what I had gathered,"},{"id":"manas-2010:p1096:b001:l036","ordinal":47787,"en":"And came seeking faith."},{"id":"manas-2010:p1096:b001:l037","ordinal":47788,"en":"I fled my people, calling them unbelievers;"},{"id":"manas-2010:p1096:b001:l038","ordinal":47789,"en":"I sought the faith as dearer to me."},{"id":"manas-2010:p1096:b001:l039","ordinal":47790,"en":"You have deeply wounded my heart,"},{"id":"manas-2010:p1096:b001:l040","ordinal":47791,"en":"Calling me an infidel to my face."},{"id":"manas-2010:p1096:b001:l041","ordinal":47792,"en":"Let me leave that aside."},{"id":"manas-2010:p1096:b001:l042","ordinal":47793,"en":"The countless Chinese, people of forty khans—"},{"id":"manas-2010:p1097:b001:l001","ordinal":47794,"en":"Let me begin where I shattered them."},{"id":"manas-2010:p1097:b001:l002","ordinal":47795,"en":"Finding no place in the rough country,"},{"id":"manas-2010:p1097:b001:l003","ordinal":47796,"en":"Finding no people to turn to,"},{"id":"manas-2010:p1097:b001:l004","ordinal":47797,"en":"I, wretched soul, went to Khangay."},{"id":"manas-2010:p1097:b001:l005","ordinal":47798,"en":"I called upon Khangay's khan,"},{"id":"manas-2010:p1097:b001:l006","ordinal":47799,"en":"And told him, “Become a Muslim.”"},{"id":"manas-2010:p1097:b001:l007","ordinal":47800,"en":"When Khangay would not agree,"},{"id":"manas-2010:p1097:b001:l008","ordinal":47801,"en":"I killed the khan of Khangay,"},{"id":"manas-2010:p1097:b001:l009","ordinal":47802,"en":"And turned back and came."},{"id":"manas-2010:p1097:b001:l010","ordinal":47803,"en":"Let it be, Manas, leopard!"},{"id":"manas-2010:p1097:b001:l011","ordinal":47804,"en":"My sun clouds over in the sky;"},{"id":"manas-2010:p1097:b001:l012","ordinal":47805,"en":"When I remember vast Beijing,"},{"id":"manas-2010:p1097:b001:l013","ordinal":47806,"en":"Sixty anxieties come upon me at once."},{"id":"manas-2010:p1097:b001:l014","ordinal":47807,"en":"The Chinese in Beijing had plenty;"},{"id":"manas-2010:p1097:b001:l015","ordinal":47808,"en":"But your champion, Sultan Almambet,"},{"id":"manas-2010:p1097:b001:l016","ordinal":47809,"en":"Had no kinsman to support him."},{"id":"manas-2010:p1097:b001:l017","ordinal":47810,"en":"If my words sound like lament to you,"},{"id":"manas-2010:p1097:b001:l018","ordinal":47811,"en":"These Chinese standing here—"},{"id":"manas-2010:p1097:b001:l019","ordinal":47812,"en":"Divide them into a thousand groups:"},{"id":"manas-2010:p1097:b001:l020","ordinal":47813,"en":"If in even one of them"},{"id":"manas-2010:p1097:b001:l021","ordinal":47814,"en":"There were someone to follow me,"},{"id":"manas-2010:p1097:b001:l022","ordinal":47815,"en":"Would I not strengthen my claim,"},{"id":"manas-2010:p1097:b001:l023","ordinal":47816,"en":"Would I not mark out my own borders?"},{"id":"manas-2010:p1097:b001:l024","ordinal":47817,"en":"Renouncing my idol,"},{"id":"manas-2010:p1097:b001:l025","ordinal":47818,"en":"How could I have abandoned"},{"id":"manas-2010:p1097:b001:l026","ordinal":47819,"en":"My vast Chinese people?"},{"id":"manas-2010:p1097:b001:l027","ordinal":47820,"en":"Through this unfortunate one's wildness,"},{"id":"manas-2010:p1097:b001:l028","ordinal":47821,"en":"I fled from Beijing and came,"},{"id":"manas-2010:p1097:b001:l029","ordinal":47822,"en":"For want of a supportive companion."},{"id":"manas-2010:p1097:b001:l030","ordinal":47823,"en":"Seeking my Muslim faith,"},{"id":"manas-2010:p1097:b001:l031","ordinal":47824,"en":"I laid low many of their khans."},{"id":"manas-2010:p1097:b001:l032","ordinal":47825,"en":"In the Chinese realm's Beijing,"},{"id":"manas-2010:p1097:b001:l033","ordinal":47826,"en":"Unable to find the Muslim faith,"},{"id":"manas-2010:p1097:b001:l034","ordinal":47827,"en":"How many beautiful women and girls"},{"id":"manas-2010:p1097:b001:l035","ordinal":47828,"en":"I made scream and weep!"},{"id":"manas-2010:p1097:b001:l036","ordinal":47829,"en":"Of so many Chinese,"},{"id":"manas-2010:p1097:b001:l037","ordinal":47830,"en":"I laid their companies low."},{"id":"manas-2010:p1097:b001:l038","ordinal":47831,"en":"Of the Chinese who faced me,"},{"id":"manas-2010:p1097:b001:l039","ordinal":47832,"en":"I brought down many warriors."},{"id":"manas-2010:p1097:b001:l040","ordinal":47833,"en":"I rode on Sarala,"},{"id":"manas-2010:p1097:b001:l041","ordinal":47834,"en":"And came to my mother Altynay."},{"id":"manas-2010:p1097:b001:l042","ordinal":47835,"en":"Then my mother said this to me:"},{"id":"manas-2010:p1098:b001:l001","ordinal":47836,"en":"“My only one,"},{"id":"manas-2010:p1098:b001:l002","ordinal":47837,"en":"Do not begin a war against Beijing."},{"id":"manas-2010:p1098:b001:l003","ordinal":47838,"en":"Take him as your companion;"},{"id":"manas-2010:p1098:b001:l004","ordinal":47839,"en":"Do not abandon your Mazhik!"},{"id":"manas-2010:p1098:b001:l005","ordinal":47840,"en":"The Chinese robe, having no choice,"},{"id":"manas-2010:p1098:b001:l006","ordinal":47841,"en":"Your Mazhik wears."},{"id":"manas-2010:p1098:b001:l007","ordinal":47842,"en":"‘When will my Almambet come?’"},{"id":"manas-2010:p1098:b001:l008","ordinal":47843,"en":"Your Mazhik pines and wonders."},{"id":"manas-2010:p1098:b001:l009","ordinal":47844,"en":"If you leave your Mazhik,"},{"id":"manas-2010:p1098:b001:l010","ordinal":47845,"en":"You do not know his foolishness."},{"id":"manas-2010:p1098:b001:l011","ordinal":47846,"en":"If what is told is true,"},{"id":"manas-2010:p1098:b001:l012","ordinal":47847,"en":"Will he not say, ‘He was a dog’?"},{"id":"manas-2010:p1098:b001:l013","ordinal":47848,"en":"When you reach the afterlife,"},{"id":"manas-2010:p1098:b001:l014","ordinal":47849,"en":"May he not make you a black donkey to ride!"},{"id":"manas-2010:p1098:b001:l015","ordinal":47850,"en":"Do not begin a war against Beijing;"},{"id":"manas-2010:p1098:b001:l016","ordinal":47851,"en":"If you fight against Beijing,"},{"id":"manas-2010:p1098:b001:l017","ordinal":47852,"en":"Never abandon Mazhik."},{"id":"manas-2010:p1098:b001:l018","ordinal":47853,"en":"Along the broad street"},{"id":"manas-2010:p1098:b001:l019","ordinal":47854,"en":"Is Mazhik, tending cattle."},{"id":"manas-2010:p1098:b001:l020","ordinal":47855,"en":"Heed my words and go to him;"},{"id":"manas-2010:p1098:b001:l021","ordinal":47856,"en":"Mazhik of the pure faith,"},{"id":"manas-2010:p1098:b001:l022","ordinal":47857,"en":"Bring him back as your companion."},{"id":"manas-2010:p1098:b001:l023","ordinal":47858,"en":"Your Mazhik, tending cattle,"},{"id":"manas-2010:p1098:b001:l024","ordinal":47859,"en":"Held under guard among the Chinese,"},{"id":"manas-2010:p1098:b001:l025","ordinal":47860,"en":"He is that unfortunate warrior."},{"id":"manas-2010:p1098:b001:l026","ordinal":47861,"en":"If you seek vengeance against Beijing,"},{"id":"manas-2010:p1098:b001:l027","ordinal":47862,"en":"He is the lion to take as companion."},{"id":"manas-2010:p1098:b001:l028","ordinal":47863,"en":"Pure in spirit from birth,"},{"id":"manas-2010:p1098:b001:l029","ordinal":47864,"en":"He belongs to the people of Islam.”"},{"id":"manas-2010:p1098:b001:l030","ordinal":47865,"en":"This account of Mazhik"},{"id":"manas-2010:p1098:b001:l031","ordinal":47866,"en":"I heard from my mother."},{"id":"manas-2010:p1098:b001:l032","ordinal":47867,"en":"Unable to endure my burning heart,"},{"id":"manas-2010:p1098:b001:l033","ordinal":47868,"en":"I went down the broad street."},{"id":"manas-2010:p1098:b001:l034","ordinal":47869,"en":"When I passed along the broad street,"},{"id":"manas-2010:p1098:b001:l035","ordinal":47870,"en":"All the cattle had stampeded,"},{"id":"manas-2010:p1098:b001:l036","ordinal":47871,"en":"Fled into the streams,"},{"id":"manas-2010:p1098:b001:l037","ordinal":47872,"en":"And taken shelter there."}]
