[{"id":"semetey-1-2013:p0612:b003:l030","ordinal":123393,"en":"Your only son has come before you."},{"id":"semetey-1-2013:p0612:b003:l031","ordinal":123394,"en":"My blessed father, wake up!"},{"id":"semetey-1-2013:p0612:b003:l032","ordinal":123395,"en":"Brushing across one's face,"},{"id":"semetey-1-2013:p0612:b003:l033","ordinal":123396,"en":"Is there anything as wretched as the wind?"},{"id":"semetey-1-2013:p0612:b003:l034","ordinal":123397,"en":"Left an orphan by his father,"},{"id":"semetey-1-2013:p0612:b003:l035","ordinal":123398,"en":"Is there anyone as wretched as I?"},{"id":"semetey-1-2013:p0612:b003:l036","ordinal":123399,"en":"The only son of a prince—"},{"id":"semetey-1-2013:p0612:b003:l037","ordinal":123400,"en":"Should he live in hardship?"},{"id":"semetey-1-2013:p0612:b003:l038","ordinal":123401,"en":"Saying, ‘My support has come,’"},{"id":"semetey-1-2013:p0612:b003:l039","ordinal":123402,"en":"My cherished khan father,"},{"id":"semetey-1-2013:p0612:b004:l001","ordinal":123403,"en":"Will there be a day when you rise again?"},{"id":"semetey-1-2013:p0612:b004:l002","ordinal":123404,"en":"The only son of a nobleman—"},{"id":"semetey-1-2013:p0612:b004:l003","ordinal":123405,"en":"Should he wander away?"},{"id":"semetey-1-2013:p0612:b004:l004","ordinal":123406,"en":"Saying, ‘My valiant son has come,’"},{"id":"semetey-1-2013:p0612:b004:l005","ordinal":123407,"en":"My father lying there,"},{"id":"semetey-1-2013:p0612:b004:l006","ordinal":123408,"en":"Will there be a day when you rise again?"},{"id":"semetey-1-2013:p0612:b004:l007","ordinal":123409,"en":"To Kara Khan's city,"},{"id":"semetey-1-2013:p0612:b004:l008","ordinal":123410,"en":"Khan father, I fled in disgrace."},{"id":"semetey-1-2013:p0612:b004:l010","ordinal":123411,"en":"My leopard father, take me with you!","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0612:b004:l011","ordinal":123412,"en":"To Temir Khan's city"},{"id":"semetey-1-2013:p0612:b004:l012","ordinal":123413,"en":"I wandered in disgrace."},{"id":"semetey-1-2013:p0612:b004:l013","ordinal":123414,"en":"My ocean-like father, take me with you!”"},{"id":"semetey-1-2013:p0612:b004:l014","ordinal":123415,"en":"So said Semetey."},{"id":"semetey-1-2013:p0612:b004:l015","ordinal":123416,"en":"In the walled city of Bukhara"},{"id":"semetey-1-2013:p0612:b004:l016","ordinal":123417,"en":"That warrior had studied his lessons."},{"id":"semetey-1-2013:p0612:b004:l017","ordinal":123418,"en":"Sitting down, he recited the Qur'an from memory."},{"id":"semetey-1-2013:p0612:b004:l018","ordinal":123419,"en":"The surah called Ya-Sin"},{"id":"semetey-1-2013:p0612:b004:l019","ordinal":123420,"en":"He read with astonishing speed."},{"id":"semetey-1-2013:p0612:b004:l020","ordinal":123421,"en":"“Amen!” he said, spreading his hands."},{"id":"semetey-1-2013:p0612:b004:l021","ordinal":123422,"en":"For the lion warriors gone to the next world,"},{"id":"semetey-1-2013:p0612:b004:l022","ordinal":123423,"en":"He spread his hands wide for their spirits."},{"id":"semetey-1-2013:p0612:b004:l023","ordinal":123424,"en":"The orphan sobbed and wept bitterly."},{"id":"semetey-1-2013:p0612:b004:l024","ordinal":123425,"en":"For the lion warriors whose protectors live,"},{"id":"semetey-1-2013:p0612:b004:l025","ordinal":123426,"en":"He grieved for their spirits."},{"id":"semetey-1-2013:p0612:b004:l026","ordinal":123427,"en":"Then your hero gathered courage,"},{"id":"semetey-1-2013:p0612:b004:l027","ordinal":123428,"en":"Your valiant son of bloodthirsty Manas."},{"id":"semetey-1-2013:p0612:b004:l028","ordinal":123429,"en":"“If I grieve and wail relentlessly,"},{"id":"semetey-1-2013:p0612:b004:l029","ordinal":123430,"en":"This mouth of mine will never close."},{"id":"semetey-1-2013:p0612:b004:l030","ordinal":123431,"en":"If I lament five days running,"},{"id":"semetey-1-2013:p0612:b004:l031","ordinal":123432,"en":"My valiant father will not be found."},{"id":"semetey-1-2013:p0612:b004:l032","ordinal":123433,"en":"Let me not grieve without end."},{"id":"semetey-1-2013:p0612:b004:l033","ordinal":123434,"en":"Such is this shitty world.”"},{"id":"semetey-1-2013:p0612:b004:l034","ordinal":123435,"en":"Brave Semen, born of Manas,"},{"id":"semetey-1-2013:p0612:b004:l035","ordinal":123436,"en":"The warrior protected by Shai,"},{"id":"semetey-1-2013:p0612:b004:l036","ordinal":123437,"en":"His dear eyes like currants,"},{"id":"semetey-1-2013:p0612:b004:l037","ordinal":123438,"en":"Turned and wiped them now."},{"id":"semetey-1-2013:p0612:b004:l038","ordinal":123439,"en":"At the place where his father lay"},{"id":"semetey-1-2013:p0612:b004:l039","ordinal":123440,"en":"He fixed his gaze closely."},{"id":"semetey-1-2013:p0613:b003:l001","ordinal":123441,"en":"Ah, my valiant mother Kanykei,"},{"id":"semetey-1-2013:p0613:b003:l002","ordinal":123442,"en":"When my valiant father died,"},{"id":"semetey-1-2013:p0613:b003:l004","ordinal":123443,"en":"Performed still greater feats of courage,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0613:b003:l005","ordinal":123444,"en":"Planned her valor with firm resolve."},{"id":"semetey-1-2013:p0613:b003:l006","ordinal":123445,"en":"She had drawn her line."},{"id":"semetey-1-2013:p0613:b003:l007","ordinal":123446,"en":"My noble mother Kanykei"},{"id":"semetey-1-2013:p0613:b003:l008","ordinal":123447,"en":"Had worked wonders,"},{"id":"semetey-1-2013:p0613:b003:l009","ordinal":123448,"en":"And had brought upon Talas"},{"id":"semetey-1-2013:p0613:b003:l010","ordinal":123449,"en":"A turmoil no person had seen."},{"id":"semetey-1-2013:p0613:b003:l011","ordinal":123450,"en":"Surpassing everyone in wisdom,"},{"id":"semetey-1-2013:p0613:b003:l012","ordinal":123451,"en":"My fierce-maned lion father"},{"id":"semetey-1-2013:p0613:b003:l013","ordinal":123452,"en":"She hid in this cave."},{"id":"semetey-1-2013:p0613:b003:l014","ordinal":123453,"en":"She made herself a warrior though a woman,"},{"id":"semetey-1-2013:p0613:b003:l015","ordinal":123454,"en":"Made her mourning self a banner."},{"id":"semetey-1-2013:p0613:b003:l016","ordinal":123455,"en":"Her precious long, thick hair"},{"id":"semetey-1-2013:p0613:b003:l017","ordinal":123456,"en":"She combed into twelve divisions."},{"id":"semetey-1-2013:p0613:b003:l018","ordinal":123457,"en":"Lest my father be left exposed,"},{"id":"semetey-1-2013:p0613:b003:l019","ordinal":123458,"en":"My precious, ill-fated mother"},{"id":"semetey-1-2013:p0613:b003:l020","ordinal":123459,"en":"Suspected treachery from everyone."},{"id":"semetey-1-2013:p0613:b003:l021","ordinal":123460,"en":"She rebuked the servants."},{"id":"semetey-1-2013:p0613:b003:l022","ordinal":123461,"en":"My father gone to Judgment Day,"},{"id":"semetey-1-2013:p0613:b003:l023","ordinal":123462,"en":"My valiant, ill-fated mother"},{"id":"semetey-1-2013:p0613:b003:l024","ordinal":123463,"en":"Hid away from all mankind."},{"id":"semetey-1-2013:p0613:b003:l025","ordinal":123464,"en":"At the renowned mausoleum,"},{"id":"semetey-1-2013:p0613:b003:l026","ordinal":123465,"en":"She had the ground hollowed with mattocks."},{"id":"semetey-1-2013:p0613:b003:l027","ordinal":123466,"en":"The poplar Bakai had cut—"},{"id":"semetey-1-2013:p0613:b003:l028","ordinal":123467,"en":"‘This is your kingly elder brother,’ she said,"},{"id":"semetey-1-2013:p0613:b003:l029","ordinal":123468,"en":"And had the six wicked ones bury it."},{"id":"semetey-1-2013:p0613:b003:l030","ordinal":123469,"en":"My poor, wretched mother"},{"id":"semetey-1-2013:p0613:b003:l031","ordinal":123470,"en":"Cannot be called a mere woman."},{"id":"semetey-1-2013:p0613:b003:l032","ordinal":123471,"en":"Whoever calls my mother a mere woman"},{"id":"semetey-1-2013:p0613:b003:l033","ordinal":123472,"en":"Will never prosper."},{"id":"semetey-1-2013:p0613:b003:l034","ordinal":123473,"en":"What is seen today is gone tomorrow."},{"id":"semetey-1-2013:p0613:b003:l035","ordinal":123474,"en":"Such is this shitty world."},{"id":"semetey-1-2013:p0613:b003:l036","ordinal":123475,"en":"My father who married my mother"},{"id":"semetey-1-2013:p0613:b003:l037","ordinal":123476,"en":"Had not the smallest cause for regret."},{"id":"semetey-1-2013:p0613:b003:l038","ordinal":123477,"en":"My poor, valiant mother"},{"id":"semetey-1-2013:p0613:b003:l039","ordinal":123478,"en":"Had prepared every sign,"},{"id":"semetey-1-2013:p0613:b004:l001","ordinal":123479,"en":"‘Let the father's son"},{"id":"semetey-1-2013:p0613:b004:l002","ordinal":123480,"en":"Come and see his remains,’ she said,"},{"id":"semetey-1-2013:p0613:b004:l003","ordinal":123481,"en":"And left it as a trust."},{"id":"semetey-1-2013:p0613:b004:l004","ordinal":123482,"en":"My mother knew better than all."},{"id":"semetey-1-2013:p0613:b004:l005","ordinal":123483,"en":"Ah, my cherished, revered mother,"},{"id":"semetey-1-2013:p0613:b004:l006","ordinal":123484,"en":"Along the foot of six cliffs,"},{"id":"semetey-1-2013:p0613:b004:l007","ordinal":123485,"en":"Weeping in exhaustion, walking on foot,"},{"id":"semetey-1-2013:p0613:b004:l008","ordinal":123486,"en":"And hurrying desperately,"},{"id":"semetey-1-2013:p0613:b004:l009","ordinal":123487,"en":"For me, left behind,"},{"id":"semetey-1-2013:p0613:b004:l010","ordinal":123488,"en":"All her treasures and possessions—"},{"id":"semetey-1-2013:p0613:b004:l011","ordinal":123489,"en":"It was right that she scattered them."},{"id":"semetey-1-2013:p0613:b004:l012","ordinal":123490,"en":"To her own kin, in this way,"},{"id":"semetey-1-2013:p0613:b004:l013","ordinal":123491,"en":"It was right that she fled!"},{"id":"semetey-1-2013:p0613:b004:l014","ordinal":123492,"en":"My valiant mother Kanykei,"},{"id":"semetey-1-2013:p0613:b004:l015","ordinal":123493,"en":"‘Let his renowned only son see,’ she said,"},{"id":"semetey-1-2013:p0613:b004:l016","ordinal":123494,"en":"And undertook such toil."},{"id":"semetey-1-2013:p0613:b004:l017","ordinal":123495,"en":"My dear father's cave,"},{"id":"semetey-1-2013:p0613:b004:l018","ordinal":123496,"en":"Ah, my poor mother"},{"id":"semetey-1-2013:p0613:b004:l019","ordinal":123497,"en":"Had made into a paradise."},{"id":"semetey-1-2013:p0613:b004:l020","ordinal":123498,"en":"She hollowed the cave and dug a resting place,"},{"id":"semetey-1-2013:p0613:b004:l021","ordinal":123499,"en":"Dug it with every feature ready."},{"id":"semetey-1-2013:p0613:b004:l022","ordinal":123500,"en":"She had its entrance prepared and cut,"},{"id":"semetey-1-2013:p0613:b004:l023","ordinal":123501,"en":"Large enough for one person to fit."},{"id":"semetey-1-2013:p0613:b004:l024","ordinal":123502,"en":"She had the farther part excavated,"},{"id":"semetey-1-2013:p0613:b004:l025","ordinal":123503,"en":"My golden mother Kanykei,"},{"id":"semetey-1-2013:p0613:b004:l026","ordinal":123504,"en":"Large enough for six thousand sheep to lie down."},{"id":"semetey-1-2013:p0613:b004:l027","ordinal":123505,"en":"If there were urgent need, inside it"},{"id":"semetey-1-2013:p0613:b004:l028","ordinal":123506,"en":"Forty thousand people could fit."},{"id":"semetey-1-2013:p0613:b004:l029","ordinal":123507,"en":"If they were at ease, without haste,"},{"id":"semetey-1-2013:p0613:b004:l030","ordinal":123508,"en":"A thousand people led by Bakai"},{"id":"semetey-1-2013:p0613:b004:l031","ordinal":123509,"en":"Inside this cave"},{"id":"semetey-1-2013:p0613:b004:l032","ordinal":123510,"en":"Could play at hopping on one leg."},{"id":"semetey-1-2013:p0613:b004:l033","ordinal":123511,"en":"Into this cave"},{"id":"semetey-1-2013:p0613:b004:l034","ordinal":123512,"en":"My renowned lion father had entered."},{"id":"semetey-1-2013:p0613:b004:l035","ordinal":123513,"en":"When they were to lay my father there,"},{"id":"semetey-1-2013:p0613:b004:l036","ordinal":123514,"en":"To see the wonders of the place,"},{"id":"semetey-1-2013:p0613:b004:l037","ordinal":123515,"en":"Koshoi and brave Toshtuk entered,"},{"id":"semetey-1-2013:p0613:b004:l038","ordinal":123516,"en":"Forty ishans and Aikozho,"},{"id":"semetey-1-2013:p0613:b004:l039","ordinal":123517,"en":"Ak Eshen and mighty Bakai:"},{"id":"semetey-1-2013:p0614:b003:l001","ordinal":123518,"en":"Maiden Saikal and Kokboru"},{"id":"semetey-1-2013:p0614:b003:l002","ordinal":123519,"en":"Entered together to bid farewell."},{"id":"semetey-1-2013:p0614:b003:l003","ordinal":123520,"en":"A cool breeze blew inside."},{"id":"semetey-1-2013:p0614:b003:l004","ordinal":123521,"en":"When all the giants entered,"},{"id":"semetey-1-2013:p0614:b003:l005","ordinal":123522,"en":"Of this place where my father lay"},{"id":"semetey-1-2013:p0614:b003:l006","ordinal":123523,"en":"They did not fill even one corner."},{"id":"semetey-1-2013:p0614:b003:l007","ordinal":123524,"en":"Her deeds showed Kydyr's blessing."},{"id":"semetey-1-2013:p0614:b003:l008","ordinal":123525,"en":"To my poor, fierce mother"},{"id":"semetey-1-2013:p0614:b003:l009","ordinal":123526,"en":"They appealed, led by Khan Koshoi."},{"id":"semetey-1-2013:p0614:b003:l010","ordinal":123527,"en":"‘She is greatly unfortunate,’ they said."},{"id":"semetey-1-2013:p0614:b003:l011","ordinal":123528,"en":"Ak Eshen looked and was awed."},{"id":"semetey-1-2013:p0614:b003:l012","ordinal":123529,"en":"Without leaving that cave,"},{"id":"semetey-1-2013:p0614:b003:l013","ordinal":123530,"en":"For my lion father himself,"},{"id":"semetey-1-2013:p0614:b003:l014","ordinal":123531,"en":"The forty ishans who served him"},{"id":"semetey-1-2013:p0614:b003:l015","ordinal":123532,"en":"Sixty times the Qur'an"},{"id":"semetey-1-2013:p0614:b003:l016","ordinal":123533,"en":"Recited from beginning to end."},{"id":"semetey-1-2013:p0614:b003:l017","ordinal":123534,"en":"Taking forty mighty strides,"},{"id":"semetey-1-2013:p0614:b003:l018","ordinal":123535,"en":"Your orphan left by the precious one"},{"id":"semetey-1-2013:p0614:b003:l019","ordinal":123536,"en":"Went farther inward."},{"id":"semetey-1-2013:p0614:b003:l020","ordinal":123537,"en":"At magnanimous Sultan Manas"},{"id":"semetey-1-2013:p0614:b003:l021","ordinal":123538,"en":"He fixed his gaze."},{"id":"semetey-1-2013:p0614:b003:l022","ordinal":123539,"en":"Smiling with his eyes closed,"},{"id":"semetey-1-2013:p0614:b003:l023","ordinal":123540,"en":"My khan father lay."},{"id":"semetey-1-2013:p0614:b003:l024","ordinal":123541,"en":"Among many loving companions"},{"id":"semetey-1-2013:p0614:b003:l025","ordinal":123542,"en":"My khan father lay surrounded."},{"id":"semetey-1-2013:p0614:b003:l026","ordinal":123543,"en":"My father was not alone;"},{"id":"semetey-1-2013:p0614:b003:l027","ordinal":123544,"en":"He was no khan to lie alone."},{"id":"semetey-1-2013:p0614:b003:l028","ordinal":123545,"en":"He was surrounded by many wonders."},{"id":"semetey-1-2013:p0614:b003:l029","ordinal":123546,"en":"My fierce-maned father, the noble lion,"},{"id":"semetey-1-2013:p0614:b003:l030","ordinal":123547,"en":"Tall and broad-shouldered,"},{"id":"semetey-1-2013:p0614:b003:l031","ordinal":123548,"en":"Both a mighty wrestler and a lion,"},{"id":"semetey-1-2013:p0614:b003:l032","ordinal":123549,"en":"A beauty of dusky complexion,"},{"id":"semetey-1-2013:p0614:b003:l034","ordinal":123550,"en":"Her waist slender as a sheath, her face like the moon—","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0614:b003:l035","ordinal":123551,"en":"With a renowned beautiful maiden"},{"id":"semetey-1-2013:p0614:b003:l036","ordinal":123552,"en":"My khan father lay embracing,"},{"id":"semetey-1-2013:p0614:b003:l037","ordinal":123553,"en":"They lay together."},{"id":"semetey-1-2013:p0614:b003:l038","ordinal":123554,"en":"When he looked to the right,"},{"id":"semetey-1-2013:p0614:b003:l039","ordinal":123555,"en":"Brown eyes without a trace of gray,"},{"id":"semetey-1-2013:p0614:b004:l001","ordinal":123556,"en":"A white face without a freckle,"},{"id":"semetey-1-2013:p0614:b004:l002","ordinal":123557,"en":"A golden-bladed battle-ax,"},{"id":"semetey-1-2013:p0614:b004:l003","ordinal":123558,"en":"Its wrist-loop wound five times,"},{"id":"semetey-1-2013:p0614:b004:l004","ordinal":123559,"en":"Hung from his wrist."},{"id":"semetey-1-2013:p0614:b004:l005","ordinal":123560,"en":"Golden coats that no bullet could pierce—"},{"id":"semetey-1-2013:p0614:b004:l006","ordinal":123561,"en":"He wore ninety, one over another."},{"id":"semetey-1-2013:p0614:b004:l007","ordinal":123562,"en":"Girded with a silver belt,"},{"id":"semetey-1-2013:p0614:b004:l008","ordinal":123563,"en":"His sun-like face touched by radiance,"},{"id":"semetey-1-2013:p0614:b004:l009","ordinal":123564,"en":"Girded with a golden belt,"},{"id":"semetey-1-2013:p0614:b004:l010","ordinal":123565,"en":"His moon-like face touched by radiance,"},{"id":"semetey-1-2013:p0614:b004:l011","ordinal":123566,"en":"Smiling yet solemn,"},{"id":"semetey-1-2013:p0614:b004:l012","ordinal":123567,"en":"At my father's right"},{"id":"semetey-1-2013:p0614:b004:l013","ordinal":123568,"en":"Was a man of radiant countenance."},{"id":"semetey-1-2013:p0614:b004:l014","ordinal":123569,"en":"His mustache had grown long and trailing."},{"id":"semetey-1-2013:p0614:b004:l015","ordinal":123570,"en":"His face glowed red like a precious stone."},{"id":"semetey-1-2013:p0614:b004:l016","ordinal":123571,"en":"He did not open his closed eyes,"},{"id":"semetey-1-2013:p0614:b004:l017","ordinal":123572,"en":"Did not draw back his outstretched legs."},{"id":"semetey-1-2013:p0614:b004:l018","ordinal":123573,"en":"A man with a beautiful face,"},{"id":"semetey-1-2013:p0614:b004:l019","ordinal":123574,"en":"At my father's right"},{"id":"semetey-1-2013:p0614:b004:l020","ordinal":123575,"en":"Lay turned toward him."},{"id":"semetey-1-2013:p0614:b004:l021","ordinal":123576,"en":"When he looked to the left,"},{"id":"semetey-1-2013:p0614:b004:l022","ordinal":123577,"en":"As vast as half a mountain,"},{"id":"semetey-1-2013:p0614:b004:l023","ordinal":123578,"en":"If encountered in life,"},{"id":"semetey-1-2013:p0614:b004:l024","ordinal":123579,"en":"He seemed ready to devour whoever he faced."},{"id":"semetey-1-2013:p0614:b004:l025","ordinal":123580,"en":"The most skilled of spearmen,"},{"id":"semetey-1-2013:p0614:b004:l026","ordinal":123581,"en":"The finest among mankind,"},{"id":"semetey-1-2013:p0614:b004:l027","ordinal":123582,"en":"With the aspect of a hungry lion,"},{"id":"semetey-1-2013:p0614:b004:l028","ordinal":123583,"en":"His complexion tawny and dusky,"},{"id":"semetey-1-2013:p0614:b004:l030","ordinal":123584,"en":"His countenance unlike that of any giant,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0614:b004:l031","ordinal":123585,"en":"Broad-chested and fearsome,"},{"id":"semetey-1-2013:p0614:b004:l032","ordinal":123586,"en":"Handsome and courageous,"},{"id":"semetey-1-2013:p0614:b004:l033","ordinal":123587,"en":"He did not draw back his outstretched legs,"},{"id":"semetey-1-2013:p0614:b004:l034","ordinal":123588,"en":"Did not open his closed eyes."},{"id":"semetey-1-2013:p0614:b004:l035","ordinal":123589,"en":"All his equipment was in readiness."},{"id":"semetey-1-2013:p0614:b004:l036","ordinal":123590,"en":"A golden-bladed battle-ax"},{"id":"semetey-1-2013:p0614:b004:l037","ordinal":123591,"en":"Lay ready at his right."},{"id":"semetey-1-2013:p0614:b004:l038","ordinal":123592,"en":"Smiling and lying rigid,"},{"id":"semetey-1-2013:p0614:b004:l039","ordinal":123593,"en":"His shovel-like teeth gleamed white,"},{"id":"semetey-1-2013:p0615:b003:l001","ordinal":123594,"en":"At my father's left,"},{"id":"semetey-1-2013:p0615:b003:l002","ordinal":123595,"en":"His gold-collared jacket"},{"id":"semetey-1-2013:p0615:b003:l003","ordinal":123596,"en":"Draped wide across him,"},{"id":"semetey-1-2013:p0615:b003:l004","ordinal":123597,"en":"Beside my dear father"},{"id":"semetey-1-2013:p0615:b003:l005","ordinal":123598,"en":"Lay another man."},{"id":"semetey-1-2013:p0615:b003:l006","ordinal":123599,"en":"At my father's feet"},{"id":"semetey-1-2013:p0615:b003:l007","ordinal":123600,"en":"Lay another man."},{"id":"semetey-1-2013:p0615:b003:l008","ordinal":123601,"en":"Of medium height, broad-shouldered,"},{"id":"semetey-1-2013:p0615:b003:l009","ordinal":123602,"en":"He too was a skilled spearman,"},{"id":"semetey-1-2013:p0615:b003:l010","ordinal":123603,"en":"The finest of the martyrs."},{"id":"semetey-1-2013:p0615:b003:l011","ordinal":123604,"en":"His head was like a great cauldron;"},{"id":"semetey-1-2013:p0615:b003:l012","ordinal":123605,"en":"His black brows seemed drawn with a line."},{"id":"semetey-1-2013:p0615:b003:l013","ordinal":123606,"en":"Between his two eyes"},{"id":"semetey-1-2013:p0615:b003:l014","ordinal":123607,"en":"Radiance poured forth; a lamp burned."},{"id":"semetey-1-2013:p0615:b003:l015","ordinal":123608,"en":"He was about twenty years old."},{"id":"semetey-1-2013:p0615:b003:l016","ordinal":123609,"en":"The sight of him burned the heart."},{"id":"semetey-1-2013:p0615:b003:l017","ordinal":123610,"en":"He wore a coat of blue iron,"},{"id":"semetey-1-2013:p0615:b003:l018","ordinal":123611,"en":"Rested his sword in its sheath."},{"id":"semetey-1-2013:p0615:b003:l019","ordinal":123612,"en":"His face was somewhat pale with sorrow,"},{"id":"semetey-1-2013:p0615:b003:l020","ordinal":123613,"en":"His features especially boyish."},{"id":"semetey-1-2013:p0615:b003:l021","ordinal":123614,"en":"At my father's feet"},{"id":"semetey-1-2013:p0615:b003:l022","ordinal":123615,"en":"There was a man lying with him."},{"id":"semetey-1-2013:p0615:b003:l023","ordinal":123616,"en":"The poor boy marveled."},{"id":"semetey-1-2013:p0615:b003:l024","ordinal":123617,"en":"When he looked toward the very head,"},{"id":"semetey-1-2013:p0615:b003:l025","ordinal":123618,"en":"A tall, true support,"},{"id":"semetey-1-2013:p0615:b003:l026","ordinal":123619,"en":"His appearance unlike anyone else's,"},{"id":"semetey-1-2013:p0615:b003:l027","ordinal":123620,"en":"At his temples, as a ritual sign,"},{"id":"semetey-1-2013:p0615:b003:l028","ordinal":123621,"en":"Locks of hair had been left."},{"id":"semetey-1-2013:p0615:b003:l029","ordinal":123622,"en":"He seemed to be a child in years,"},{"id":"semetey-1-2013:p0615:b003:l030","ordinal":123623,"en":"No more than twelve."},{"id":"semetey-1-2013:p0615:b003:l031","ordinal":123624,"en":"If he came to maturity,"},{"id":"semetey-1-2013:p0615:b003:l032","ordinal":123625,"en":"His right shoulder was broad—"},{"id":"semetey-1-2013:p0615:b003:l033","ordinal":123626,"en":"He would be a warrior to destroy the Oirats."},{"id":"semetey-1-2013:p0615:b003:l034","ordinal":123627,"en":"With the holy Qur'an as his pillow,"},{"id":"semetey-1-2013:p0615:b003:l035","ordinal":123628,"en":"His head toward the qibla,"},{"id":"semetey-1-2013:p0615:b003:l036","ordinal":123629,"en":"Crowded close at his head,"},{"id":"semetey-1-2013:p0615:b003:l037","ordinal":123630,"en":"Another boy lay with him."},{"id":"semetey-1-2013:p0615:b003:l038","ordinal":123631,"en":"“Ah, has my precious father died?"},{"id":"semetey-1-2013:p0615:b003:l039","ordinal":123632,"en":"Was he buried with all his people?"},{"id":"semetey-1-2013:p0615:b004:l001","ordinal":123633,"en":"To give my father delight,"},{"id":"semetey-1-2013:p0615:b004:l002","ordinal":123634,"en":"Pressing a girl against his breast,"},{"id":"semetey-1-2013:p0615:b004:l003","ordinal":123635,"en":"Did they bury him with a girl lying there?"},{"id":"semetey-1-2013:p0615:b004:l004","ordinal":123636,"en":"My leopard father, the bloodthirsty one,"},{"id":"semetey-1-2013:p0615:b004:l005","ordinal":123637,"en":"‘Let him lie without sorrow,’ they said—"},{"id":"semetey-1-2013:p0615:b004:l006","ordinal":123638,"en":"Did they place a girl in his embrace?"},{"id":"semetey-1-2013:p0615:b004:l007","ordinal":123639,"en":"‘Let them surround him,’ they said—"},{"id":"semetey-1-2013:p0615:b004:l008","ordinal":123640,"en":"Did they give him his ocean-like companions?"},{"id":"semetey-1-2013:p0615:b004:l009","ordinal":123641,"en":"When my father grew weary,"},{"id":"semetey-1-2013:p0615:b004:l010","ordinal":123642,"en":"‘Let someone amuse him,’ they said—"},{"id":"semetey-1-2013:p0615:b004:l011","ordinal":123643,"en":"Look at these foolish people,"},{"id":"semetey-1-2013:p0615:b004:l012","ordinal":123644,"en":"Did they send a child along with him?”"},{"id":"semetey-1-2013:p0615:b004:l013","ordinal":123645,"en":"The sight tore his heart."},{"id":"semetey-1-2013:p0615:b004:l014","ordinal":123646,"en":"The orphan left by Manas"},{"id":"semetey-1-2013:p0615:b004:l015","ordinal":123647,"en":"Shed tears from his eyes."},{"id":"semetey-1-2013:p0615:b004:l016","ordinal":123648,"en":"“Into my father's embrace"}]
