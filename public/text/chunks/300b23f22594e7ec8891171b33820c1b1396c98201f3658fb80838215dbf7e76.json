[{"id":"manas-2010:p0427:b001:l047","ordinal":19713,"en":"He laid multitudes low."},{"id":"manas-2010:p0427:b001:l048","ordinal":19714,"en":"Making his Toruchaar prance,"},{"id":"manas-2010:p0428:b001:l001","ordinal":19715,"en":"Of the Chinese who filled the field,"},{"id":"manas-2010:p0428:b001:l002","ordinal":19716,"en":"He broke the ranks and sent them crawling."},{"id":"manas-2010:p0428:b001:l003","ordinal":19717,"en":"Valiant Jakyp and Akbaltay"},{"id":"manas-2010:p0428:b001:l004","ordinal":19718,"en":"Had given him a breastplate as a gift;"},{"id":"manas-2010:p0428:b001:l005","ordinal":19719,"en":"He fixed it firmly on his head,"},{"id":"manas-2010:p0428:b001:l006","ordinal":19720,"en":"Sending those he faced crawling."},{"id":"manas-2010:p0428:b001:l007","ordinal":19721,"en":"Wherever his spear could reach,"},{"id":"manas-2010:p0428:b001:l008","ordinal":19722,"en":"With his spear he overturned them."},{"id":"manas-2010:p0428:b001:l009","ordinal":19723,"en":"Those who rushed close in their fury,"},{"id":"manas-2010:p0428:b001:l010","ordinal":19724,"en":"With his sword he shattered."},{"id":"manas-2010:p0428:b001:l011","ordinal":19725,"en":"Twisting and whirling his spear,"},{"id":"manas-2010:p0428:b001:l012","ordinal":19726,"en":"Of the Chinese surging forward,"},{"id":"manas-2010:p0428:b001:l013","ordinal":19727,"en":"He broke apart the ranks."},{"id":"manas-2010:p0428:b001:l014","ordinal":19728,"en":"When one looked upon the world,"},{"id":"manas-2010:p0428:b001:l015","ordinal":19729,"en":"Haze had fallen, all was dust."},{"id":"manas-2010:p0428:b001:l016","ordinal":19730,"en":"Blood ran through the gullies;"},{"id":"manas-2010:p0428:b001:l017","ordinal":19731,"en":"The gushing springs were blood."},{"id":"manas-2010:p0428:b001:l018","ordinal":19732,"en":"Both champion and lion,"},{"id":"manas-2010:p0428:b001:l019","ordinal":19733,"en":"When his people migrated from Altai,"},{"id":"manas-2010:p0428:b001:l020","ordinal":19734,"en":"While your valiant Manas was there,"},{"id":"manas-2010:p0428:b001:l021","ordinal":19735,"en":"That was the place of mutual slaughter."},{"id":"manas-2010:p0428:b001:l022","ordinal":19736,"en":"Their giants strange, their mighty ones lions,"},{"id":"manas-2010:p0428:b001:l023","ordinal":19737,"en":"They faced one another, a wondrous sight."},{"id":"manas-2010:p0428:b001:l024","ordinal":19738,"en":"While your valiant Manas was there,"},{"id":"manas-2010:p0428:b001:l025","ordinal":19739,"en":"That was the place of mutual slaughter."},{"id":"manas-2010:p0428:b001:l026","ordinal":19740,"en":"Shouting and thrusting spears,"},{"id":"manas-2010:p0428:b001:l027","ordinal":19741,"en":"No clash could be like this,"},{"id":"manas-2010:p0428:b001:l028","ordinal":19742,"en":"However many days they fought."},{"id":"manas-2010:p0428:b001:l029","ordinal":19743,"en":"The reason for their battle:"},{"id":"manas-2010:p0428:b001:l030","ordinal":19744,"en":"When the Chinese wrought oppression,"},{"id":"manas-2010:p0428:b001:l031","ordinal":19745,"en":"To seize the few households,"},{"id":"manas-2010:p0428:b001:l032","ordinal":19746,"en":"If they captured Manas,"},{"id":"manas-2010:p0428:b001:l033","ordinal":19747,"en":"To slaughter him in sacrifice,"},{"id":"manas-2010:p0428:b001:l034","ordinal":19748,"en":"To work every trouble they knew,"},{"id":"manas-2010:p0428:b001:l035","ordinal":19749,"en":"Once Manas fell into their hands,"},{"id":"manas-2010:p0428:b001:l036","ordinal":19750,"en":"The Muslims, small as a palm,"},{"id":"manas-2010:p0428:b001:l037","ordinal":19751,"en":"To drive them all away"},{"id":"manas-2010:p0428:b001:l038","ordinal":19752,"en":"And slaughter as far as Mecca—"},{"id":"manas-2010:p0428:b001:l039","ordinal":19753,"en":"To the Black Chinese and Manchus,"},{"id":"manas-2010:p0428:b001:l040","ordinal":19754,"en":"Would he submit to what they said?"},{"id":"manas-2010:p0428:b001:l041","ordinal":19755,"en":"Without falling to a shot when death came,"},{"id":"manas-2010:p0428:b001:l042","ordinal":19756,"en":"The Kyrgyz, all who were Kyrgyz,"},{"id":"manas-2010:p0428:b001:l043","ordinal":19757,"en":"Would valiant Manas give them up?"},{"id":"manas-2010:p0428:b001:l044","ordinal":19758,"en":"Would the bloodthirsty one be sated with blood?"},{"id":"manas-2010:p0428:b001:l045","ordinal":19759,"en":"With the seething Manchu people,"},{"id":"manas-2010:p0428:b001:l046","ordinal":19760,"en":"Would he fail to grapple?"},{"id":"manas-2010:p0428:b001:l047","ordinal":19761,"en":"His valor, never sated with blood,"},{"id":"manas-2010:p0428:b001:l048","ordinal":19762,"en":"Was known to Kakanchyn,"},{"id":"manas-2010:p0429:b001:l001","ordinal":19763,"en":"The leopard's lion courage."},{"id":"manas-2010:p0429:b001:l002","ordinal":19764,"en":"His valor was known to the people."},{"id":"manas-2010:p0429:b001:l003","ordinal":19765,"en":"Six years before, in Beijing's"},{"id":"manas-2010:p0429:b001:l004","ordinal":19766,"en":"“Lion Manas will now be born,”"},{"id":"manas-2010:p0429:b001:l005","ordinal":19767,"en":"It was inscribed in their register."},{"id":"manas-2010:p0429:b001:l006","ordinal":19768,"en":"Karykan was a knowing man:"},{"id":"manas-2010:p0429:b001:l007","ordinal":19769,"en":"“Manas will arise from the Buruts,”"},{"id":"manas-2010:p0429:b001:l008","ordinal":19770,"en":"He had told his people."},{"id":"manas-2010:p0429:b001:l009","ordinal":19771,"en":"His appearance and his form,"},{"id":"manas-2010:p0429:b001:l010","ordinal":19772,"en":"In Kakanchyn's, in Beijing's"},{"id":"manas-2010:p0429:b001:l011","ordinal":19773,"en":"Great register, they had drawn."},{"id":"manas-2010:p0429:b001:l012","ordinal":19774,"en":"Their lords had gathered,"},{"id":"manas-2010:p0429:b001:l013","ordinal":19775,"en":"Had begun with weighty words."},{"id":"manas-2010:p0429:b001:l014","ordinal":19776,"en":"When mighty Manas was born,"},{"id":"manas-2010:p0429:b001:l015","ordinal":19777,"en":"Upon Kakanchyn's Beijing,"},{"id":"manas-2010:p0429:b001:l016","ordinal":19778,"en":"Rain fell for eighty days;"},{"id":"manas-2010:p0429:b001:l017","ordinal":19779,"en":"There was a mighty earthquake,"},{"id":"manas-2010:p0429:b001:l018","ordinal":19780,"en":"And it was utterly wrecked."},{"id":"manas-2010:p0429:b001:l019","ordinal":19781,"en":"His world was broad indeed;"},{"id":"manas-2010:p0429:b001:l020","ordinal":19782,"en":"This Burut, a wolf-man by birth,"},{"id":"manas-2010:p0429:b001:l021","ordinal":19783,"en":"Was the lion of the Muslims."},{"id":"manas-2010:p0429:b001:l022","ordinal":19784,"en":"Whirling his spear without stopping,"},{"id":"manas-2010:p0429:b001:l023","ordinal":19785,"en":"Of the Chinese surging forward,"},{"id":"manas-2010:p0429:b001:l024","ordinal":19786,"en":"He broke apart the ranks."},{"id":"manas-2010:p0429:b001:l025","ordinal":19787,"en":"Forty boy companions at his side,"},{"id":"manas-2010:p0429:b001:l026","ordinal":19788,"en":"Thrusting spears and striking swords,"},{"id":"manas-2010:p0429:b001:l027","ordinal":19789,"en":"Magnanimous Manas, bloodthirsty lion,"},{"id":"manas-2010:p0429:b001:l028","ordinal":19790,"en":"When he entered the uproar,"},{"id":"manas-2010:p0429:b001:l029","ordinal":19791,"en":"Something vast no man could bear to see—"},{"id":"manas-2010:p0429:b001:l030","ordinal":19792,"en":"When he entered that tumult,"},{"id":"manas-2010:p0429:b001:l031","ordinal":19793,"en":"Laying their champions stretched out,"},{"id":"manas-2010:p0429:b001:l032","ordinal":19794,"en":"He made a dreadful slaughter."},{"id":"manas-2010:p0429:b001:l033","ordinal":19795,"en":"The wolf-man touched by Kydyr,"},{"id":"manas-2010:p0429:b001:l034","ordinal":19796,"en":"The forty boys lost sight of him."},{"id":"manas-2010:p0429:b001:l035","ordinal":19797,"en":"Khan Zholoy of the Kalmyks,"},{"id":"manas-2010:p0429:b001:l036","ordinal":19798,"en":"And black-maned Boroonchu,"},{"id":"manas-2010:p0429:b001:l037","ordinal":19799,"en":"On the slope of great Altai,"},{"id":"manas-2010:p0429:b001:l038","ordinal":19800,"en":"Beside the clear spring water,"},{"id":"manas-2010:p0429:b001:l039","ordinal":19801,"en":"Those madmen had encountered"},{"id":"manas-2010:p0429:b001:l040","ordinal":19802,"en":"The forty boys themselves."},{"id":"manas-2010:p0429:b001:l041","ordinal":19803,"en":"Drawing bows like rain,"},{"id":"manas-2010:p0429:b001:l042","ordinal":19804,"en":"Firing shots like hail,"},{"id":"manas-2010:p0429:b001:l043","ordinal":19805,"en":"They overwhelmed the forty boys."},{"id":"manas-2010:p0429:b001:l044","ordinal":19806,"en":"Boroonchu among the spearmen,"},{"id":"manas-2010:p0429:b001:l045","ordinal":19807,"en":"And mighty champion warrior Zholoy"},{"id":"manas-2010:p0429:b001:l046","ordinal":19808,"en":"Had taken them into their midst."},{"id":"manas-2010:p0429:b001:l047","ordinal":19809,"en":"Fighting and slaughtering,"},{"id":"manas-2010:p0429:b001:l048","ordinal":19810,"en":"They made a dreadful slaughter."},{"id":"manas-2010:p0430:b001:l001","ordinal":19811,"en":"Not meeting whom they ought to meet,"},{"id":"manas-2010:p0430:b001:l002","ordinal":19812,"en":"Meeting whom they should not meet,"},{"id":"manas-2010:p0430:b001:l003","ordinal":19813,"en":"Their fortune had utterly dried up."},{"id":"manas-2010:p0430:b001:l004","ordinal":19814,"en":"His companions blessed by Kydyr,"},{"id":"manas-2010:p0430:b001:l005","ordinal":19815,"en":"The forty boys he counted on,"},{"id":"manas-2010:p0430:b001:l006","ordinal":19816,"en":"Were being slaughtered."},{"id":"manas-2010:p0430:b001:l007","ordinal":19817,"en":"They had no means to escape slaughter;"},{"id":"manas-2010:p0430:b001:l008","ordinal":19818,"en":"Their helplessness was beyond measure."},{"id":"manas-2010:p0430:b001:l009","ordinal":19819,"en":"Lion Manas, the leopard,"},{"id":"manas-2010:p0430:b001:l010","ordinal":19820,"en":"To rescue them,"},{"id":"manas-2010:p0430:b001:l011","ordinal":19821,"en":"Was not there for the moment."},{"id":"manas-2010:p0430:b001:l012","ordinal":19822,"en":"They had no support to trust,"},{"id":"manas-2010:p0430:b001:l013","ordinal":19823,"en":"No renowned lion Manas."},{"id":"manas-2010:p0430:b001:l014","ordinal":19824,"en":"Champions had swept upon them in crowds."},{"id":"manas-2010:p0430:b001:l015","ordinal":19825,"en":"Your father's grave, those ravagers—"},{"id":"manas-2010:p0430:b001:l016","ordinal":19826,"en":"Your wolf-man's companions,"},{"id":"manas-2010:p0430:b001:l017","ordinal":19827,"en":"The forty boys, had become martyrs."},{"id":"manas-2010:p0430:b001:l018","ordinal":19828,"en":"That the forty boys were dead,"},{"id":"manas-2010:p0430:b001:l019","ordinal":19829,"en":"Valiant Kutu saw."},{"id":"manas-2010:p0430:b001:l020","ordinal":19830,"en":"Too many cares to fit his breast,"},{"id":"manas-2010:p0430:b001:l021","ordinal":19831,"en":"Fortunate hero Kutubiy,"},{"id":"manas-2010:p0430:b001:l022","ordinal":19832,"en":"His tears streamed in ten channels;"},{"id":"manas-2010:p0430:b001:l023","ordinal":19833,"en":"These men had seen their deaths."},{"id":"manas-2010:p0430:b001:l024","ordinal":19834,"en":"Seeing it, Kutubiy"},{"id":"manas-2010:p0430:b001:l025","ordinal":19835,"en":"Girded his waist securely."},{"id":"manas-2010:p0430:b001:l026","ordinal":19836,"en":"Zholoy and Boroonchu,"},{"id":"manas-2010:p0430:b001:l027","ordinal":19837,"en":"Those champions he attacked."},{"id":"manas-2010:p0430:b001:l028","ordinal":19838,"en":"He turned Telküröng's mouth;"},{"id":"manas-2010:p0430:b001:l029","ordinal":19839,"en":"Your valiant Kutu plunged in."},{"id":"manas-2010:p0430:b001:l030","ordinal":19840,"en":"Without looking around him,"},{"id":"manas-2010:p0430:b001:l031","ordinal":19841,"en":"Without sparing his life from death,"},{"id":"manas-2010:p0430:b001:l032","ordinal":19842,"en":"Bending down, he speared warriors."},{"id":"manas-2010:p0430:b001:l033","ordinal":19843,"en":"Whirling his iron spear,"},{"id":"manas-2010:p0430:b001:l034","ordinal":19844,"en":"He unleashed a slaughter."},{"id":"manas-2010:p0430:b001:l035","ordinal":19845,"en":"When he looked to this side,"},{"id":"manas-2010:p0430:b001:l036","ordinal":19846,"en":"As large as half a mountain,"},{"id":"manas-2010:p0430:b001:l037","ordinal":19847,"en":"As though to devour his challengers,"},{"id":"manas-2010:p0430:b001:l038","ordinal":19848,"en":"Attacking their governor,"},{"id":"manas-2010:p0430:b001:l039","ordinal":19849,"en":"He advanced in battle."},{"id":"manas-2010:p0430:b001:l040","ordinal":19850,"en":"Boroonchu on a gray mule,"},{"id":"manas-2010:p0430:b001:l041","ordinal":19851,"en":"Before Kutubiy"},{"id":"manas-2010:p0430:b001:l042","ordinal":19852,"en":"Came forth in line."},{"id":"manas-2010:p0430:b001:l043","ordinal":19853,"en":"His good fortune was exceptional,"},{"id":"manas-2010:p0430:b001:l044","ordinal":19854,"en":"That hapless companion of Manas."},{"id":"manas-2010:p0430:b001:l045","ordinal":19855,"en":"His heroism was extraordinary,"},{"id":"manas-2010:p0430:b001:l046","ordinal":19856,"en":"His prowess as a champion was great."},{"id":"manas-2010:p0430:b001:l047","ordinal":19857,"en":"His speech was sugar, his words honey;"},{"id":"manas-2010:p0430:b001:l048","ordinal":19858,"en":"He never drew back from a contest,"},{"id":"manas-2010:p0431:b001:l001","ordinal":19859,"en":"No such soul is born among men."},{"id":"manas-2010:p0431:b001:l002","ordinal":19860,"en":"Before a word could be said,"},{"id":"manas-2010:p0431:b001:l003","ordinal":19861,"en":"In the opening and closing of an eye,"},{"id":"manas-2010:p0431:b001:l004","ordinal":19862,"en":"Accomplished hero Kutubiy"},{"id":"manas-2010:p0431:b001:l005","ordinal":19863,"en":"Arrived before an arrow could."},{"id":"manas-2010:p0431:b001:l006","ordinal":19864,"en":"At the black-wrathful Kalmyk,"},{"id":"manas-2010:p0431:b001:l007","ordinal":19865,"en":"“This side of his pouch-belt,” he aimed,"},{"id":"manas-2010:p0431:b001:l008","ordinal":19866,"en":"“At the place that marks his lung,”"},{"id":"manas-2010:p0431:b001:l009","ordinal":19867,"en":"He thrust and passed him by."},{"id":"manas-2010:p0431:b001:l010","ordinal":19868,"en":"He was a warrior who claimed high rank;"},{"id":"manas-2010:p0431:b001:l011","ordinal":19869,"en":"The tribal Chinese people of Beijing"},{"id":"manas-2010:p0431:b001:l012","ordinal":19870,"en":"Called him hero Boroonchu."},{"id":"manas-2010:p0431:b001:l013","ordinal":19871,"en":"When Kutubiy struck and passed,"},{"id":"manas-2010:p0431:b001:l014","ordinal":19872,"en":"The warrior slipped from his saddle,"},{"id":"manas-2010:p0431:b001:l015","ordinal":19873,"en":"His foot slipped from the stirrup,"},{"id":"manas-2010:p0431:b001:l016","ordinal":19874,"en":"His eyes rolled wildly,"},{"id":"manas-2010:p0431:b001:l017","ordinal":19875,"en":"His legs dangled loose."},{"id":"manas-2010:p0431:b001:l018","ordinal":19876,"en":"Forged together out of steel,"},{"id":"manas-2010:p0431:b001:l019","ordinal":19877,"en":"That finely made lacquered spear—"},{"id":"manas-2010:p0431:b001:l020","ordinal":19878,"en":"Able to test the steel,"},{"id":"manas-2010:p0431:b001:l021","ordinal":19879,"en":"It would not glance off when thrust at stone,"},{"id":"manas-2010:p0431:b001:l022","ordinal":19880,"en":"But entered more easily than mud."},{"id":"manas-2010:p0431:b001:l023","ordinal":19881,"en":"When he struck with the spear,"},{"id":"manas-2010:p0431:b001:l024","ordinal":19882,"en":"It reached Boroonchu;"},{"id":"manas-2010:p0431:b001:l025","ordinal":19883,"en":"Right through the middle of his lung,"},{"id":"manas-2010:p0431:b001:l026","ordinal":19884,"en":"It tore and passed through."},{"id":"manas-2010:p0431:b001:l027","ordinal":19885,"en":"“Our precious one is dead,” they said,"},{"id":"manas-2010:p0431:b001:l028","ordinal":19886,"en":"“He has seen the face of Judgment,” they said."},{"id":"manas-2010:p0431:b001:l029","ordinal":19887,"en":"Seeing it there, Ezkara"},{"id":"manas-2010:p0431:b001:l030","ordinal":19888,"en":"Was filled with rage."},{"id":"manas-2010:p0431:b001:l031","ordinal":19889,"en":"Was Ezkara not a khan?"},{"id":"manas-2010:p0431:b001:l032","ordinal":19890,"en":"Bellowing for his governors,"},{"id":"manas-2010:p0431:b001:l033","ordinal":19891,"en":"Summoning many of them,"},{"id":"manas-2010:p0431:b001:l034","ordinal":19892,"en":"Furious with the champion,"},{"id":"manas-2010:p0431:b001:l035","ordinal":19893,"en":"His anger grew fierce."},{"id":"manas-2010:p0431:b001:l036","ordinal":19894,"en":"The hair on his crown bristled,"},{"id":"manas-2010:p0431:b001:l037","ordinal":19895,"en":"The hair at his nape stood up."},{"id":"manas-2010:p0431:b001:l038","ordinal":19896,"en":"Unable to stand still, he raged;"},{"id":"manas-2010:p0431:b001:l039","ordinal":19897,"en":"He addressed the champions:"},{"id":"manas-2010:p0431:b001:l040","ordinal":19898,"en":"“Know now that what I say is right!"},{"id":"manas-2010:p0431:b001:l041","ordinal":19899,"en":"Go into the earth, unworthy champions!"},{"id":"manas-2010:p0431:b001:l042","ordinal":19900,"en":"Your valor is so great,"},{"id":"manas-2010:p0431:b001:l043","ordinal":19901,"en":"Your prowess so extraordinary—"},{"id":"manas-2010:p0431:b001:l044","ordinal":19902,"en":"Letting his bow and quiver be struck down,"},{"id":"manas-2010:p0431:b001:l045","ordinal":19903,"en":"Mighty champion Boroonchu,"},{"id":"manas-2010:p0431:b001:l046","ordinal":19904,"en":"Losing him to this Burut,"},{"id":"manas-2010:p0431:b001:l047","ordinal":19905,"en":"How shall we face our lord,"},{"id":"manas-2010:p0431:b001:l048","ordinal":19906,"en":"Without all being slaughtered and dying,"},{"id":"manas-2010:p0432:b001:l001","ordinal":19907,"en":"Daughter-damned Esenkan"},{"id":"manas-2010:p0432:b001:l002","ordinal":19908,"en":"Was a khan of unmatched wrath."},{"id":"manas-2010:p0432:b001:l003","ordinal":19909,"en":"Before that khan,"},{"id":"manas-2010:p0432:b001:l004","ordinal":19910,"en":"Our people slaughtered, our nation scattered,"},{"id":"manas-2010:p0432:b001:l005","ordinal":19911,"en":"‘We let a warrior slaughter them,’ saying this,"},{"id":"manas-2010:p0432:b001:l006","ordinal":19912,"en":"Alive and not ourselves slaughtered,"},{"id":"manas-2010:p0432:b001:l007","ordinal":19913,"en":"That great khan of terrible strength,"},{"id":"manas-2010:p0432:b001:l008","ordinal":19914,"en":"How can we look upon his face?"},{"id":"manas-2010:p0432:b001:l009","ordinal":19915,"en":"By this accursed, burning Burut,"},{"id":"manas-2010:p0432:b001:l010","ordinal":19916,"en":"Letting ourselves be struck sideways from afar,"},{"id":"manas-2010:p0432:b001:l011","ordinal":19917,"en":"All our mighty men,"},{"id":"manas-2010:p0432:b001:l012","ordinal":19918,"en":"Losing them to the Buruts,"},{"id":"manas-2010:p0432:b001:l013","ordinal":19919,"en":"How can we leave without shame?"},{"id":"manas-2010:p0432:b001:l014","ordinal":19920,"en":"Having let one of our lords be killed,"},{"id":"manas-2010:p0432:b001:l015","ordinal":19921,"en":"Without fighting and dying together,"},{"id":"manas-2010:p0432:b001:l016","ordinal":19922,"en":"What legacy shall we attain?"},{"id":"manas-2010:p0432:b001:l017","ordinal":19923,"en":"Better, those Buruts,"},{"id":"manas-2010:p0432:b001:l018","ordinal":19924,"en":"Let us trample beneath the earth."},{"id":"manas-2010:p0432:b001:l019","ordinal":19925,"en":"Leaving not one Burut,"},{"id":"manas-2010:p0432:b001:l020","ordinal":19926,"en":"Like bulls pawing the ground,"},{"id":"manas-2010:p0432:b001:l021","ordinal":19927,"en":"Let us drive them down in ruin."},{"id":"manas-2010:p0432:b001:l022","ordinal":19928,"en":"Leaving this one no life,"},{"id":"manas-2010:p0432:b001:l023","ordinal":19929,"en":"Let us sever his fly-sized soul!”"},{"id":"manas-2010:p0432:b001:l024","ordinal":19930,"en":"They deemed Ezkara's words right;"},{"id":"manas-2010:p0432:b001:l025","ordinal":19931,"en":"The champions obeyed him."},{"id":"manas-2010:p0432:b001:l026","ordinal":19932,"en":"Upon that Kutubiy of yours,"},{"id":"manas-2010:p0432:b001:l027","ordinal":19933,"en":"They began to sweep forward."},{"id":"manas-2010:p0432:b001:l028","ordinal":19934,"en":"There were lords and there were khans,"},{"id":"manas-2010:p0432:b001:l029","ordinal":19935,"en":"All their heroes were there."},{"id":"manas-2010:p0432:b001:l030","ordinal":19936,"en":"Of the Chinese with rank buttons on their caps,"},{"id":"manas-2010:p0432:b001:l031","ordinal":19937,"en":"Their bald men were there too."},{"id":"manas-2010:p0432:b001:l032","ordinal":19938,"en":"Sparing no soul in combat,"},{"id":"manas-2010:p0432:b001:l033","ordinal":19939,"en":"Never sated with blood in battle,"},{"id":"manas-2010:p0432:b001:l034","ordinal":19940,"en":"Mighty Döödür was there too."},{"id":"manas-2010:p0432:b001:l035","ordinal":19941,"en":"Their quiver-bearers and bowmen,"},{"id":"manas-2010:p0432:b001:l036","ordinal":19942,"en":"Their spearmen and champions"},{"id":"manas-2010:p0432:b001:l037","ordinal":19943,"en":"Took him into their midst."},{"id":"manas-2010:p0432:b001:l038","ordinal":19944,"en":"His lion, mighty Manas, was absent;"},{"id":"manas-2010:p0432:b001:l039","ordinal":19945,"en":"Kutu remained in the middle."},{"id":"manas-2010:p0432:b001:l040","ordinal":19946,"en":"Their champions with battle-axes,"},{"id":"manas-2010:p0432:b001:l041","ordinal":19947,"en":"The skilled among their spearmen,"},{"id":"manas-2010:p0432:b001:l042","ordinal":19948,"en":"Their seasoned masters of war,"},{"id":"manas-2010:p0432:b001:l043","ordinal":19949,"en":"Their khans wearing arm guards,"},{"id":"manas-2010:p0432:b001:l044","ordinal":19950,"en":"Raising tumult and uproar,"},{"id":"manas-2010:p0432:b001:l045","ordinal":19951,"en":"They swept upon him."},{"id":"manas-2010:p0432:b001:l046","ordinal":19952,"en":"The unbelievers pressed harder,"},{"id":"manas-2010:p0432:b001:l047","ordinal":19953,"en":"Their champions of every kind."},{"id":"manas-2010:p0432:b001:l048","ordinal":19954,"en":"A murky cloud fell and billowed,"},{"id":"manas-2010:p0433:b001:l001","ordinal":19955,"en":"Whichever way you looked,"},{"id":"manas-2010:p0433:b001:l002","ordinal":19956,"en":"Arrows from bows shrieked."},{"id":"manas-2010:p0433:b001:l003","ordinal":19957,"en":"An immeasurable army massed;"},{"id":"manas-2010:p0433:b001:l004","ordinal":19958,"en":"They had surged forth."},{"id":"manas-2010:p0433:b001:l005","ordinal":19959,"en":"Tagylyk of the Sibe,"},{"id":"manas-2010:p0433:b001:l006","ordinal":19960,"en":"Courageous champions, many lords,"},{"id":"manas-2010:p0433:b001:l007","ordinal":19961,"en":"Had come out to block the way."},{"id":"manas-2010:p0433:b001:l008","ordinal":19962,"en":"His warrior strength was extraordinary;"},{"id":"manas-2010:p0433:b001:l009","ordinal":19963,"en":"He had come out ahead."},{"id":"manas-2010:p0433:b001:l010","ordinal":19964,"en":"Drawing his bow like rain,"},{"id":"manas-2010:p0433:b001:l011","ordinal":19965,"en":"He trampled past."},{"id":"manas-2010:p0433:b001:l012","ordinal":19966,"en":"The Kalmyks' champion Zholoy"},{"id":"manas-2010:p0433:b001:l013","ordinal":19967,"en":"Had swept upon him."},{"id":"manas-2010:p0433:b001:l014","ordinal":19968,"en":"Ezkara of the Manchus"}]
