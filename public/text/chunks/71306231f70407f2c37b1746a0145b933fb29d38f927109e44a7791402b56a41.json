[{"id":"semetey-1-2013:p0642:b004:l019","ordinal":125697,"en":"Many wonders, many objects"},{"id":"semetey-1-2013:p0642:b004:l020","ordinal":125698,"en":"Were standing farther inside."},{"id":"semetey-1-2013:p0642:b004:l021","ordinal":125699,"en":"She had had them placed without measure,"},{"id":"semetey-1-2013:p0642:b004:l022","ordinal":125700,"en":"Twelve, like reclining camels,"},{"id":"semetey-1-2013:p0642:b004:l023","ordinal":125701,"en":"Bound in a row."},{"id":"semetey-1-2013:p0642:b004:l024","ordinal":125702,"en":"When those bundles were untied,"},{"id":"semetey-1-2013:p0642:b004:l025","ordinal":125703,"en":"It was a wondrous sight to see:"},{"id":"semetey-1-2013:p0642:b004:l026","ordinal":125704,"en":"My mother had left"},{"id":"semetey-1-2013:p0642:b004:l027","ordinal":125705,"en":"Many fitting things."},{"id":"semetey-1-2013:p0642:b004:l028","ordinal":125706,"en":"My poor mother Kanykei,"},{"id":"semetey-1-2013:p0642:b004:l029","ordinal":125707,"en":"‘If my orphan stays well,"},{"id":"semetey-1-2013:p0642:b004:l030","ordinal":125708,"en":"If my dear one does not die,"},{"id":"semetey-1-2013:p0642:b004:l031","ordinal":125709,"en":"He will return to Talas,’ she thought."},{"id":"semetey-1-2013:p0642:b004:l032","ordinal":125710,"en":"‘His mother's worth,"},{"id":"semetey-1-2013:p0642:b004:l033","ordinal":125711,"en":"If he becomes a man, he will know."},{"id":"semetey-1-2013:p0642:b004:l034","ordinal":125712,"en":"The wretched orphan left by the generous one,"},{"id":"semetey-1-2013:p0642:b004:l035","ordinal":125713,"en":"When he enters battle, he will wear these.’"},{"id":"semetey-1-2013:p0642:b004:l036","ordinal":125714,"en":"She had hidden coats of every kind."},{"id":"semetey-1-2013:p0642:b004:l037","ordinal":125715,"en":"Oh, my afflicted, unfortunate mother,"},{"id":"semetey-1-2013:p0642:b004:l038","ordinal":125716,"en":"She had hidden abundant wealth."},{"id":"semetey-1-2013:p0642:b004:l039","ordinal":125717,"en":"My dear mother Kanykei"},{"id":"semetey-1-2013:p0643:b003:l001","ordinal":125718,"en":"Clothes for war were set apart,"},{"id":"semetey-1-2013:p0643:b003:l002","ordinal":125719,"en":"Clothes for disputes were set apart,"},{"id":"semetey-1-2013:p0643:b003:l003","ordinal":125720,"en":"And a khan's clothes were set apart."},{"id":"semetey-1-2013:p0643:b003:l004","ordinal":125721,"en":"Lest lice infest them,"},{"id":"semetey-1-2013:p0643:b003:l005","ordinal":125722,"en":"A thousand separate changes against lice;"},{"id":"semetey-1-2013:p0643:b003:l006","ordinal":125723,"en":"Lest dirt soil them,"},{"id":"semetey-1-2013:p0643:b003:l007","ordinal":125724,"en":"A thousand separate changes against dirt."},{"id":"semetey-1-2013:p0643:b003:l008","ordinal":125725,"en":"Summer clothes were set apart,"},{"id":"semetey-1-2013:p0643:b003:l009","ordinal":125726,"en":"And winter clothes were set apart."},{"id":"semetey-1-2013:p0643:b003:l010","ordinal":125727,"en":"Binding and folding them again,"},{"id":"semetey-1-2013:p0643:b003:l011","ordinal":125728,"en":"Inside the treasury,"},{"id":"semetey-1-2013:p0643:b003:l012","ordinal":125729,"en":"My mother had left them,"},{"id":"semetey-1-2013:p0643:b003:l013","ordinal":125730,"en":"Entrusting them to her dear Semetey."},{"id":"semetey-1-2013:p0643:b003:l014","ordinal":125731,"en":"‘If God alone grants him life,"},{"id":"semetey-1-2013:p0643:b003:l015","ordinal":125732,"en":"If the orphan grows up without dying,"},{"id":"semetey-1-2013:p0643:b003:l016","ordinal":125733,"en":"He will enter the treasury."},{"id":"semetey-1-2013:p0643:b003:l017","ordinal":125734,"en":"If my orphan has understanding,"},{"id":"semetey-1-2013:p0643:b003:l018","ordinal":125735,"en":"He will know my worth."},{"id":"semetey-1-2013:p0643:b003:l019","ordinal":125736,"en":"Then this son of mine"},{"id":"semetey-1-2013:p0643:b003:l020","ordinal":125737,"en":"Will heed what I say."},{"id":"semetey-1-2013:p0643:b003:l021","ordinal":125738,"en":"To the poor ones left by Manas,"},{"id":"semetey-1-2013:p0643:b003:l022","ordinal":125739,"en":"He will give these as gifts.’"},{"id":"semetey-1-2013:p0643:b003:l023","ordinal":125740,"en":"Your warrior mother Kanykei"},{"id":"semetey-1-2013:p0643:b003:l024","ordinal":125741,"en":"Had undertaken all this toil."},{"id":"semetey-1-2013:p0643:b003:l025","ordinal":125742,"en":"‘My orphan will need them,’ she said."},{"id":"semetey-1-2013:p0643:b003:l026","ordinal":125743,"en":"That accomplished, bold woman"},{"id":"semetey-1-2013:p0643:b003:l028","ordinal":125744,"en":"Toward the mouth of that cave,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0643:b003:l029","ordinal":125745,"en":"Warrior Bakai, Bölökbai,"},{"id":"semetey-1-2013:p0643:b003:l030","ordinal":125746,"en":"And the forty guards who had wept so hard,"},{"id":"semetey-1-2013:p0643:b003:l031","ordinal":125747,"en":"All turned and stood now."},{"id":"semetey-1-2013:p0643:b003:l032","ordinal":125748,"en":"The renowned orphan Semetey"},{"id":"semetey-1-2013:p0643:b003:l033","ordinal":125749,"en":"Displayed his warrior generosity now."},{"id":"semetey-1-2013:p0643:b003:l034","ordinal":125750,"en":"His forefathers were all khans,"},{"id":"semetey-1-2013:p0643:b003:l035","ordinal":125751,"en":"Blessed by Khizir from the root,"},{"id":"semetey-1-2013:p0643:b003:l036","ordinal":125752,"en":"Descendant of a firmly rooted land,"},{"id":"semetey-1-2013:p0643:b003:l037","ordinal":125753,"en":"His first ancestors were all khans,"},{"id":"semetey-1-2013:p0643:b003:l038","ordinal":125754,"en":"Blessed by Khizir from the beginning—"},{"id":"semetey-1-2013:p0643:b003:l039","ordinal":125755,"en":"Such was your warrior himself."},{"id":"semetey-1-2013:p0643:b005:l001","ordinal":125756,"en":"He opened the treasury's entrance now."},{"id":"semetey-1-2013:p0643:b005:l002","ordinal":125757,"en":"Andijan's thick-weft yellow-mottled cloth,"},{"id":"semetey-1-2013:p0643:b005:l003","ordinal":125758,"en":"Bukhara's precious black-mottled cloth—"},{"id":"semetey-1-2013:p0643:b005:l004","ordinal":125759,"en":"All this wealth"},{"id":"semetey-1-2013:p0643:b005:l005","ordinal":125760,"en":"He distributed freely now."},{"id":"semetey-1-2013:p0643:b005:l006","ordinal":125761,"en":"With neither excess nor shortfall,"},{"id":"semetey-1-2013:p0643:b005:l007","ordinal":125762,"en":"The orphan slave, born just,"},{"id":"semetey-1-2013:p0643:b005:l008","ordinal":125763,"en":"Gave it to the guards."},{"id":"semetey-1-2013:p0643:b005:l009","ordinal":125764,"en":"Truly created by God—"},{"id":"semetey-1-2013:p0643:b005:l010","ordinal":125765,"en":"Have you seen that he is His servant?"},{"id":"semetey-1-2013:p0643:b005:l011","ordinal":125766,"en":"Of poor Lord Manas,"},{"id":"semetey-1-2013:p0643:b005:l012","ordinal":125767,"en":"Have you seen that he is the son?"},{"id":"semetey-1-2013:p0643:b005:l013","ordinal":125768,"en":"For twelve years crying out,"},{"id":"semetey-1-2013:p0643:b005:l014","ordinal":125769,"en":"All those poor men—"},{"id":"semetey-1-2013:p0643:b005:l015","ordinal":125770,"en":"Have you seen their longing?"},{"id":"semetey-1-2013:p0643:b005:l016","ordinal":125771,"en":"Coming here to Talas,"},{"id":"semetey-1-2013:p0643:b005:l017","ordinal":125772,"en":"The orphan born fortunate—"},{"id":"semetey-1-2013:p0643:b005:l018","ordinal":125773,"en":"Have you seen him found?"},{"id":"semetey-1-2013:p0643:b005:l019","ordinal":125774,"en":"Battle clothing was set apart."},{"id":"semetey-1-2013:p0643:b005:l020","ordinal":125775,"en":"Here he saw their nakedness;"},{"id":"semetey-1-2013:p0643:b005:l021","ordinal":125776,"en":"Here he gave them battle clothing."},{"id":"semetey-1-2013:p0643:b005:l022","ordinal":125777,"en":"The reason he gave them clothes—"},{"id":"semetey-1-2013:p0643:b005:l023","ordinal":125778,"en":"Their coats were torn to shreds."},{"id":"semetey-1-2013:p0643:b005:l024","ordinal":125779,"en":"When the forty guards stood in a row,"},{"id":"semetey-1-2013:p0643:b005:l026","ordinal":125780,"en":"They had no means to cover them;","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0643:b005:l027","ordinal":125781,"en":"What else could the forty guards do?"},{"id":"semetey-1-2013:p0643:b005:l028","ordinal":125782,"en":"They had no strength to conceal them."},{"id":"semetey-1-2013:p0643:b005:l029","ordinal":125783,"en":"The honorable orphan was found,"},{"id":"semetey-1-2013:p0643:b005:l030","ordinal":125784,"en":"A gift from God."},{"id":"semetey-1-2013:p0643:b005:l031","ordinal":125785,"en":"Their shameful parts were covered;"},{"id":"semetey-1-2013:p0643:b005:l032","ordinal":125786,"en":"Their lion orphan had come."},{"id":"semetey-1-2013:p0643:b005:l033","ordinal":125787,"en":"The forty guards stood in a row."},{"id":"semetey-1-2013:p0643:b005:l034","ordinal":125788,"en":"Saying, ‘In God's name!’ to Bakai,"},{"id":"semetey-1-2013:p0643:b005:l035","ordinal":125789,"en":"A golden collar, copper sleeves,"},{"id":"semetey-1-2013:p0643:b005:l036","ordinal":125790,"en":"Double mail, with rings like larks' eyes,"},{"id":"semetey-1-2013:p0643:b005:l037","ordinal":125791,"en":"A braid-trimmed vest, a broad neckband,"},{"id":"semetey-1-2013:p0643:b005:l038","ordinal":125792,"en":"Mail to wear in battle,"},{"id":"semetey-1-2013:p0643:b005:l039","ordinal":125793,"en":"Lined inside with silk,"},{"id":"semetey-1-2013:p0644:b003:l001","ordinal":125794,"en":"Dear lady Kanykei,"},{"id":"semetey-1-2013:p0644:b003:l002","ordinal":125795,"en":"For many days and nights,"},{"id":"semetey-1-2013:p0644:b003:l003","ordinal":125796,"en":"Had worked to make it proof against shots."},{"id":"semetey-1-2013:p0644:b003:l004","ordinal":125797,"en":"Orenburg and Margilan—"},{"id":"semetey-1-2013:p0644:b003:l005","ordinal":125798,"en":"She had the lands between them searched."},{"id":"semetey-1-2013:p0644:b003:l006","ordinal":125799,"en":"The fine cloth from that region,"},{"id":"semetey-1-2013:p0644:b003:l007","ordinal":125800,"en":"That formidable, bold woman"},{"id":"semetey-1-2013:p0644:b003:l008","ordinal":125801,"en":"Had brought by force."},{"id":"semetey-1-2013:p0644:b003:l009","ordinal":125802,"en":"She had fine sand sifted,"},{"id":"semetey-1-2013:p0644:b003:l011","ordinal":125803,"en":"Had it laid in many layers.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0644:b003:l012","ordinal":125804,"en":"Such was the clothing for war:"},{"id":"semetey-1-2013:p0644:b003:l013","ordinal":125805,"en":"She had thin iron wire worked into it,"},{"id":"semetey-1-2013:p0644:b003:l014","ordinal":125806,"en":"Making shots from the short gun powerless."},{"id":"semetey-1-2013:p0644:b003:l015","ordinal":125807,"en":"Worn in a shooting battle, no shot pierced it;"},{"id":"semetey-1-2013:p0644:b003:l016","ordinal":125808,"en":"Worn in a joust, no spear pierced it;"},{"id":"semetey-1-2013:p0644:b003:l017","ordinal":125809,"en":"In sword fighting, no blade cut it."},{"id":"semetey-1-2013:p0644:b003:l018","ordinal":125810,"en":"Such was the precious garment."},{"id":"semetey-1-2013:p0644:b003:l019","ordinal":125811,"en":"He clothed them in battle dress."},{"id":"semetey-1-2013:p0644:b003:l020","ordinal":125812,"en":"When they put those clothes on,"},{"id":"semetey-1-2013:p0644:b003:l021","ordinal":125813,"en":"What had been exposed was covered;"},{"id":"semetey-1-2013:p0644:b003:l022","ordinal":125814,"en":"Their dignity was thus restored."},{"id":"semetey-1-2013:p0644:b003:l023","ordinal":125815,"en":"Raising their hands, crying aloud,"},{"id":"semetey-1-2013:p0644:b003:l024","ordinal":125816,"en":"They pleaded with your orphan."},{"id":"semetey-1-2013:p0644:b003:l025","ordinal":125817,"en":"To keep lice from infesting them,"},{"id":"semetey-1-2013:p0644:b003:l026","ordinal":125818,"en":"Separate changes against lice,"},{"id":"semetey-1-2013:p0644:b003:l027","ordinal":125819,"en":"He had them put on underneath."},{"id":"semetey-1-2013:p0644:b003:l028","ordinal":125820,"en":"Ceremonial clothes were set apart;"},{"id":"semetey-1-2013:p0644:b003:l029","ordinal":125821,"en":"He clothed them in ceremonial dress."},{"id":"semetey-1-2013:p0644:b003:l030","ordinal":125822,"en":"Your dear son of Manas,"},{"id":"semetey-1-2013:p0644:b003:l031","ordinal":125823,"en":"Revealing his prowess then,"},{"id":"semetey-1-2013:p0644:b003:l032","ordinal":125824,"en":"Transformed them with the coats he gave!"},{"id":"semetey-1-2013:p0644:b003:l033","ordinal":125825,"en":"In the foothills, blaze-headed horses,"},{"id":"semetey-1-2013:p0644:b003:l034","ordinal":125826,"en":"Thoroughbreds and coursers together,"},{"id":"semetey-1-2013:p0644:b003:l035","ordinal":125827,"en":"Fine beasts left by his father Manas—"},{"id":"semetey-1-2013:p0644:b003:l036","ordinal":125828,"en":"The forty guards and Bölökbai,"},{"id":"semetey-1-2013:p0644:b003:l037","ordinal":125829,"en":"He mounted them on their choice of these."},{"id":"semetey-1-2013:p0644:b003:l038","ordinal":125830,"en":"(Truly created by God—"},{"id":"semetey-1-2013:p0644:b003:l039","ordinal":125831,"en":"Have you seen that he is His servant,"},{"id":"semetey-1-2013:p0644:b004:l001","ordinal":125832,"en":"Of poor Sultan Manas,"},{"id":"semetey-1-2013:p0644:b004:l002","ordinal":125833,"en":"Have you seen that he is the son?)"},{"id":"semetey-1-2013:p0644:b004:l003","ordinal":125834,"en":"From joy, the forty guards"},{"id":"semetey-1-2013:p0644:b004:l004","ordinal":125835,"en":"Were running about there."},{"id":"semetey-1-2013:p0644:b004:l005","ordinal":125836,"en":"There their leopard father Manas"},{"id":"semetey-1-2013:p0644:b004:l006","ordinal":125837,"en":"Stood alive again."},{"id":"semetey-1-2013:p0644:b004:l007","ordinal":125838,"en":"Meanwhile, a wondrous thing:"},{"id":"semetey-1-2013:p0644:b004:l008","ordinal":125839,"en":"My dear mother Kanykei"},{"id":"semetey-1-2013:p0644:b004:l009","ordinal":125840,"en":"Had left another store of goods."},{"id":"semetey-1-2013:p0644:b004:l010","ordinal":125841,"en":"‘Should my orphan"},{"id":"semetey-1-2013:p0644:b004:l011","ordinal":125842,"en":"Grow to full strength and become a warrior,"},{"id":"semetey-1-2013:p0644:b004:l012","ordinal":125843,"en":"Equal to the sons of warriors,"},{"id":"semetey-1-2013:p0644:b004:l013","ordinal":125844,"en":"And come to dwell in Talas,"},{"id":"semetey-1-2013:p0644:b004:l014","ordinal":125845,"en":"Should a weighty dispute arise,"},{"id":"semetey-1-2013:p0644:b004:l015","ordinal":125846,"en":"Should a troublesome enemy confront him,"},{"id":"semetey-1-2013:p0644:b004:l016","ordinal":125847,"en":"He might fall needlessly into suffering."},{"id":"semetey-1-2013:p0644:b004:l017","ordinal":125848,"en":"When that future day comes,"},{"id":"semetey-1-2013:p0644:b004:l018","ordinal":125849,"en":"He will see these and take them as gifts.’"},{"id":"semetey-1-2013:p0644:b004:l019","ordinal":125850,"en":"There was much equipment for war,"},{"id":"semetey-1-2013:p0644:b004:l020","ordinal":125851,"en":"Left by my dear mother Kanykei."},{"id":"semetey-1-2013:p0644:b004:l021","ordinal":125852,"en":"Then the lacquered spears she had hidden—"},{"id":"semetey-1-2013:p0644:b004:l022","ordinal":125853,"en":"Forty spears for forty guards,"},{"id":"semetey-1-2013:p0644:b004:l023","ordinal":125854,"en":"Semetey took and gave."},{"id":"semetey-1-2013:p0644:b004:l024","ordinal":125855,"en":"Forty swords for these forty men"},{"id":"semetey-1-2013:p0644:b004:l025","ordinal":125856,"en":"Semetey gave as well."},{"id":"semetey-1-2013:p0644:b004:l026","ordinal":125857,"en":"Forty guns for forty guards"},{"id":"semetey-1-2013:p0644:b004:l027","ordinal":125858,"en":"Semetey also gave."},{"id":"semetey-1-2013:p0644:b004:l028","ordinal":125859,"en":"If you looked at the forty guards,"},{"id":"semetey-1-2013:p0644:b004:l029","ordinal":125860,"en":"Their bearing, their appearance,"},{"id":"semetey-1-2013:p0644:b004:l030","ordinal":125861,"en":"Their look mounted upon horses,"},{"id":"semetey-1-2013:p0644:b004:l031","ordinal":125862,"en":"Drew the eyes of all who saw."},{"id":"semetey-1-2013:p0644:b004:l032","ordinal":125863,"en":"As though their sovereign, dear lion Manas,"},{"id":"semetey-1-2013:p0644:b004:l033","ordinal":125864,"en":"Were still present, they appeared."},{"id":"semetey-1-2013:p0644:b004:l034","ordinal":125865,"en":"What the forty guards wore—"},{"id":"semetey-1-2013:p0644:b004:l035","ordinal":125866,"en":"No shot could pierce it in a clash."},{"id":"semetey-1-2013:p0644:b004:l036","ordinal":125867,"en":"What the forty guards rode—"},{"id":"semetey-1-2013:p0644:b004:l037","ordinal":125868,"en":"No shot could catch them in a crisis."},{"id":"semetey-1-2013:p0644:b004:l038","ordinal":125869,"en":"Their banners fluttered;"},{"id":"semetey-1-2013:p0644:b004:l039","ordinal":125870,"en":"Black-bladed battle-axes"},{"id":"semetey-1-2013:p0645:b003:l001","ordinal":125871,"en":"Flashed at their wrists."},{"id":"semetey-1-2013:p0645:b003:l002","ordinal":125872,"en":"The forty guards' winged steeds"},{"id":"semetey-1-2013:p0645:b003:l003","ordinal":125873,"en":"Were all alike in their dun color,"},{"id":"semetey-1-2013:p0645:b003:l004","ordinal":125874,"en":"With amulet-shaped marks upon their brows."},{"id":"semetey-1-2013:p0645:b003:l005","ordinal":125875,"en":"If you looked at the forty guards,"},{"id":"semetey-1-2013:p0645:b003:l006","ordinal":125876,"en":"All were equally outstanding,"},{"id":"semetey-1-2013:p0645:b003:l007","ordinal":125877,"en":"Their appearance unlike other men."},{"id":"semetey-1-2013:p0645:b003:l008","ordinal":125878,"en":"Then Semetey,"},{"id":"semetey-1-2013:p0645:b003:l009","ordinal":125879,"en":"The boy, spoke these words:"},{"id":"semetey-1-2013:p0645:b003:l010","ordinal":125880,"en":"“My bringer of good fortune, Bölökbai,"},{"id":"semetey-1-2013:p0645:b003:l011","ordinal":125881,"en":"My support left by my father,"},{"id":"semetey-1-2013:p0645:b003:l012","ordinal":125882,"en":"Let us put the day in writing;"},{"id":"semetey-1-2013:p0645:b003:l013","ordinal":125883,"en":"Let us set the appointed time."},{"id":"semetey-1-2013:p0645:b003:l014","ordinal":125884,"en":"To my kinsmen Abyke and Köbösh,"},{"id":"semetey-1-2013:p0645:b003:l015","ordinal":125885,"en":"I am going to see them."},{"id":"semetey-1-2013:p0645:b003:l016","ordinal":125886,"en":"If those dogs rant too much,"},{"id":"semetey-1-2013:p0645:b003:l017","ordinal":125887,"en":"I am going to meet death at their hands."},{"id":"semetey-1-2013:p0645:b003:l018","ordinal":125888,"en":"My father's countless possessions,"},{"id":"semetey-1-2013:p0645:b003:l019","ordinal":125889,"en":"I am going to take them."},{"id":"semetey-1-2013:p0645:b003:l020","ordinal":125890,"en":"I have reached twelve years of age,"},{"id":"semetey-1-2013:p0645:b003:l021","ordinal":125891,"en":"I, the orphan left by my khan father Manas."},{"id":"semetey-1-2013:p0645:b003:l023","ordinal":125892,"en":"To my elder kinsmen's homes,"},{"id":"semetey-1-2013:p0645:b003:l024","ordinal":125893,"en":"I am going to go."},{"id":"semetey-1-2013:p0645:b003:l025","ordinal":125894,"en":"If there are good, reasonable words,"},{"id":"semetey-1-2013:p0645:b003:l026","ordinal":125895,"en":"I am going to agree."},{"id":"semetey-1-2013:p0645:b003:l027","ordinal":125896,"en":"If there is honesty in them,"},{"id":"semetey-1-2013:p0645:b003:l028","ordinal":125897,"en":"This dear, fierce mother of mine,"},{"id":"semetey-1-2013:p0645:b003:l029","ordinal":125898,"en":"To one of my six elder kinsmen,"},{"id":"semetey-1-2013:p0645:b003:l030","ordinal":125899,"en":"I am going to give her."},{"id":"semetey-1-2013:p0645:b003:l031","ordinal":125900,"en":"My father Manas's remaining kin,"},{"id":"semetey-1-2013:p0645:b003:l032","ordinal":125901,"en":"Elders, I am going to see them."},{"id":"semetey-1-2013:p0645:b003:l033","ordinal":125902,"en":"If I turn back safely,"},{"id":"semetey-1-2013:p0645:b003:l034","ordinal":125903,"en":"If I return without dying or disappearing,"},{"id":"semetey-1-2013:p0645:b003:l035","ordinal":125904,"en":"I shall stay there thirty days."},{"id":"semetey-1-2013:p0645:b003:l036","ordinal":125905,"en":"I shall travel back for ten days;"},{"id":"semetey-1-2013:p0645:b003:l037","ordinal":125906,"en":"I shall stay in Bukhara for ten days;"},{"id":"semetey-1-2013:p0645:b003:l038","ordinal":125907,"en":"I shall journey for ten days."},{"id":"semetey-1-2013:p0645:b003:l039","ordinal":125908,"en":"From beginning to end, that much—"},{"id":"semetey-1-2013:p0645:b004:l001","ordinal":125909,"en":"I shall come in sixty days."},{"id":"semetey-1-2013:p0645:b004:l002","ordinal":125910,"en":"If I am gone beyond sixty days,"},{"id":"semetey-1-2013:p0645:b004:l003","ordinal":125911,"en":"I shall have met my death."},{"id":"semetey-1-2013:p0645:b004:l004","ordinal":125912,"en":"If I am kept safe from death,"},{"id":"semetey-1-2013:p0645:b004:l005","ordinal":125913,"en":"I shall return and see you."},{"id":"semetey-1-2013:p0645:b004:l006","ordinal":125914,"en":"Khan Bölökbai, forty guards,"},{"id":"semetey-1-2013:p0645:b004:l007","ordinal":125915,"en":"If I am gone beyond eighty days,"},{"id":"semetey-1-2013:p0645:b004:l008","ordinal":125916,"en":"Shoot wild sheep and eat them."},{"id":"semetey-1-2013:p0645:b004:l009","ordinal":125917,"en":"My support left by Manas,"},{"id":"semetey-1-2013:p0645:b004:l010","ordinal":125918,"en":"Say that I have died."},{"id":"semetey-1-2013:p0645:b004:l011","ordinal":125919,"en":"If I come in sixty days,"},{"id":"semetey-1-2013:p0645:b004:l012","ordinal":125920,"en":"God has granted your wish."},{"id":"semetey-1-2013:p0645:b004:l013","ordinal":125921,"en":"If I am gone beyond sixty days,"},{"id":"semetey-1-2013:p0645:b004:l014","ordinal":125922,"en":"My allotted death has come; I have died.”"},{"id":"semetey-1-2013:p0645:b004:l015","ordinal":125923,"en":"Giving coats that were not torn,"},{"id":"semetey-1-2013:p0645:b004:l016","ordinal":125924,"en":"Giving peerless winged steeds,"},{"id":"semetey-1-2013:p0645:b004:l017","ordinal":125925,"en":"Making the promise promptly,"},{"id":"semetey-1-2013:p0645:b004:l018","ordinal":125926,"en":"Setting this many days as the time,"},{"id":"semetey-1-2013:p0645:b004:l019","ordinal":125927,"en":"“Keep my only one safe;"},{"id":"semetey-1-2013:p0645:b004:l020","ordinal":125928,"en":"If my mirror, my orphan, returns,"},{"id":"semetey-1-2013:p0645:b004:l021","ordinal":125929,"en":"If God grants my wish,”"},{"id":"semetey-1-2013:p0645:b004:l022","ordinal":125930,"en":"Praying thus and sobbing,"},{"id":"semetey-1-2013:p0645:b004:l023","ordinal":125931,"en":"All forty guards"},{"id":"semetey-1-2013:p0645:b004:l024","ordinal":125932,"en":"Cried aloud in supplication."},{"id":"semetey-1-2013:p0645:b004:l025","ordinal":125933,"en":"To Jar-Kiya of Jangirik,"},{"id":"semetey-1-2013:p0645:b004:l026","ordinal":125934,"en":"By a path for beasts in single file,"},{"id":"semetey-1-2013:p0645:b004:l027","ordinal":125935,"en":"They took the road toward the river."},{"id":"semetey-1-2013:p0645:b004:l028","ordinal":125936,"en":"All forty guards"},{"id":"semetey-1-2013:p0645:b004:l029","ordinal":125937,"en":"Played with the horn striker, raising dust;"},{"id":"semetey-1-2013:p0645:b004:l030","ordinal":125938,"en":"All made a great commotion."},{"id":"semetey-1-2013:p0645:b004:l031","ordinal":125939,"en":"To shoot roe deer if bored,"},{"id":"semetey-1-2013:p0645:b004:l032","ordinal":125940,"en":"And if not bored, the forty guards"},{"id":"semetey-1-2013:p0645:b004:l033","ordinal":125941,"en":"Would stay and keep their watch."},{"id":"semetey-1-2013:p0645:b004:l034","ordinal":125942,"en":"Their wretched hearts were gladdened;"},{"id":"semetey-1-2013:p0645:b004:l035","ordinal":125943,"en":"They had at last seen safe and well"},{"id":"semetey-1-2013:p0645:b004:l036","ordinal":125944,"en":"The boy left by Manas."},{"id":"semetey-1-2013:p0645:b004:l037","ordinal":125945,"en":"Crying, ‘Oh God!’ they swore,"},{"id":"semetey-1-2013:p0645:b004:l038","ordinal":125946,"en":"Made their promise firm,"},{"id":"semetey-1-2013:p0645:b004:l039","ordinal":125947,"en":"And went to the appointed place."},{"id":"semetey-1-2013:p0646:b003:l001","ordinal":125948,"en":"Kayipchi's dark ridge,"},{"id":"semetey-1-2013:p0646:b003:l002","ordinal":125949,"en":"They firmly held it now."},{"id":"semetey-1-2013:p0646:b003:l003","ordinal":125950,"en":"They camped at their ease,"},{"id":"semetey-1-2013:p0646:b003:l004","ordinal":125951,"en":"As though your bloodthirsty, fierce Manas"},{"id":"semetey-1-2013:p0646:b003:l005","ordinal":125952,"en":"Had come alive again."}]
