[{"id":"semetey-2-2013:p1270:b003:l028","ordinal":284417,"en":"I'm in bed."},{"id":"semetey-2-2013:p1270:b003:l029","ordinal":284418,"en":"Nothing is left of hands and feet"},{"id":"semetey-2-2013:p1270:b003:l030","ordinal":284419,"en":"I am in custody."},{"id":"semetey-2-2013:p1270:b003:l031","ordinal":284420,"en":"My ice cream is unbreakable"},{"id":"semetey-2-2013:p1270:b003:l032","ordinal":284421,"en":"I'm trapped,"},{"id":"semetey-2-2013:p1270:b003:l033","ordinal":284422,"en":"Life is inevitable"},{"id":"semetey-2-2013:p1270:b003:l034","ordinal":284423,"en":"I'm trapped,"},{"id":"semetey-2-2013:p1270:b003:l035","ordinal":284424,"en":"Our road is dug"},{"id":"semetey-2-2013:p1270:b003:l036","ordinal":284425,"en":"It was boiled and very salty"},{"id":"semetey-2-2013:p1270:b003:l037","ordinal":284426,"en":"lion lost the lion,"},{"id":"semetey-2-2013:p1270:b003:l038","ordinal":284427,"en":"Both hands are tied."},{"id":"semetey-2-2013:p1270:b003:l039","ordinal":284428,"en":"Our word is over."},{"id":"semetey-2-2013:p1270:b004:l001","ordinal":284429,"en":"Abakemen lost"},{"id":"semetey-2-2013:p1270:b004:l002","ordinal":284430,"en":"Today, two eyes are sharp."},{"id":"semetey-2-2013:p1270:b004:l003","ordinal":284431,"en":"The day is over,"},{"id":"semetey-2-2013:p1270:b004:l004","ordinal":284432,"en":"The tongue is tied"},{"id":"semetey-2-2013:p1270:b004:l005","ordinal":284433,"en":"The tree was burned,"},{"id":"semetey-2-2013:p1270:b004:l006","ordinal":284434,"en":"It's over, you'll see!\""},{"id":"semetey-2-2013:p1270:b004:l007","ordinal":284435,"en":"That's how Kulchoro said"},{"id":"semetey-2-2013:p1270:b004:l008","ordinal":284436,"en":"The white color is diluted,"},{"id":"semetey-2-2013:p1270:b004:l009","ordinal":284437,"en":"Tears flowing from both sides"},{"id":"semetey-2-2013:p1270:b004:l010","ordinal":284438,"en":"Poured down slowly."},{"id":"semetey-2-2013:p1270:b004:l011","ordinal":284439,"en":"Weeping and crying"},{"id":"semetey-2-2013:p1270:b004:l012","ordinal":284440,"en":"Leaning on a golden-cheeked beast,"},{"id":"semetey-2-2013:p1270:b004:l013","ordinal":284441,"en":"Generation yellow water,"},{"id":"semetey-2-2013:p1270:b004:l014","ordinal":284442,"en":"The earth trembled,"},{"id":"semetey-2-2013:p1270:b004:l015","ordinal":284443,"en":"The world became night,"},{"id":"semetey-2-2013:p1270:b004:l016","ordinal":284444,"en":"It is a difficult task."},{"id":"semetey-2-2013:p1270:b004:l017","ordinal":284445,"en":"Angry, Kulchoro"},{"id":"semetey-2-2013:p1270:b004:l018","ordinal":284446,"en":"After nine days,"},{"id":"semetey-2-2013:p1270:b004:l019","ordinal":284447,"en":"Poor thing"},{"id":"semetey-2-2013:p1270:b004:l020","ordinal":284448,"en":"Eat wounds from ninety places,"},{"id":"semetey-2-2013:p1270:b004:l021","ordinal":284449,"en":"She was tired and left."},{"id":"semetey-2-2013:p1270:b004:l022","ordinal":284450,"en":"Black blood from the body"},{"id":"semetey-2-2013:p1270:b004:l023","ordinal":284451,"en":"\"It's a bad day, don't die,"},{"id":"semetey-2-2013:p1270:b004:l024","ordinal":284452,"en":"Don't be a fool to be insulted."},{"id":"semetey-2-2013:p1270:b004:l025","ordinal":284453,"en":"Yesterday when God took my father"},{"id":"semetey-2-2013:p1270:b004:l026","ordinal":284454,"en":"Losing parents"},{"id":"semetey-2-2013:p1270:b004:l027","ordinal":284455,"en":"When he was a baby"},{"id":"semetey-2-2013:p1270:b004:l028","ordinal":284456,"en":"Adopted and saved,"},{"id":"semetey-2-2013:p1270:b004:l029","ordinal":284457,"en":"My father did the same with his son,"},{"id":"semetey-2-2013:p1270:b004:l030","ordinal":284458,"en":"I told you that I am a lion,"},{"id":"semetey-2-2013:p1270:b004:l031","ordinal":284459,"en":"Mounted on his neck,"},{"id":"semetey-2-2013:p1270:b004:l032","ordinal":284460,"en":"The stomach will open - saying,"},{"id":"semetey-2-2013:p1270:b004:l033","ordinal":284461,"en":"Cut off by the judge,"},{"id":"semetey-2-2013:p1270:b004:l034","ordinal":284462,"en":"To be a true brother,"},{"id":"semetey-2-2013:p1270:b004:l035","ordinal":284463,"en":"My grandmother Kanikei's breast"},{"id":"semetey-2-2013:p1270:b004:l036","ordinal":284464,"en":"Breastfed equally"},{"id":"semetey-2-2013:p1270:b004:l037","ordinal":284465,"en":"Argyn and Kyrgyz"},{"id":"semetey-2-2013:p1270:b004:l038","ordinal":284466,"en":"When did they call us slaves?"},{"id":"semetey-2-2013:p1270:b004:l039","ordinal":284467,"en":"Cuddling children"},{"id":"semetey-2-2013:p1271:b003:l001","ordinal":284468,"en":"He had a tail fastened to the bay horse,"},{"id":"semetey-2-2013:p1271:b003:l002","ordinal":284469,"en":"Lest the summer heat strike him,"},{"id":"semetey-2-2013:p1271:b003:l003","ordinal":284470,"en":"And kept him in the shade,"},{"id":"semetey-2-2013:p1271:b003:l004","ordinal":284471,"en":"Saying, “He will be my companion,”"},{"id":"semetey-2-2013:p1271:b003:l005","ordinal":284472,"en":"Leading him about and training him,"},{"id":"semetey-2-2013:p1271:b003:l006","ordinal":284473,"en":"Saying, “He will wreak slaughter upon the foe,"},{"id":"semetey-2-2013:p1271:b003:l007","ordinal":284474,"en":"And vanquish every enemy he faces,”"},{"id":"semetey-2-2013:p1271:b003:l008","ordinal":284475,"en":"Tempering him like white steel."},{"id":"semetey-2-2013:p1271:b003:l009","ordinal":284476,"en":"Ill-fated in your bereavement,"},{"id":"semetey-2-2013:p1271:b003:l010","ordinal":284477,"en":"My dear Külchoro,"},{"id":"semetey-2-2013:p1271:b003:l011","ordinal":284478,"en":"Take me with you—do not leave me wailing."},{"id":"semetey-2-2013:p1271:b003:l012","ordinal":284479,"en":"While my heroic uncle lived,"},{"id":"semetey-2-2013:p1271:b003:l013","ordinal":284480,"en":"I ate my meals as his pampered child;"},{"id":"semetey-2-2013:p1271:b003:l014","ordinal":284481,"en":"Against the eighteen thousand worlds,"},{"id":"semetey-2-2013:p1271:b003:l015","ordinal":284482,"en":"If my devastating uncle were here,"},{"id":"semetey-2-2013:p1271:b003:l016","ordinal":284483,"en":"I used to say, “I shall wreak carnage.”"},{"id":"semetey-2-2013:p1271:b003:l017","ordinal":284484,"en":"I was a lofty white peak, but now I am laid low;"},{"id":"semetey-2-2013:p1271:b003:l018","ordinal":284485,"en":"Parted from my magnanimous lion,"},{"id":"semetey-2-2013:p1271:b003:l019","ordinal":284486,"en":"I have fallen into utter misery."},{"id":"semetey-2-2013:p1271:b003:l020","ordinal":284487,"en":"I entered battle, then turned back;"},{"id":"semetey-2-2013:p1271:b003:l021","ordinal":284488,"en":"My own kinsman became my foe,"},{"id":"semetey-2-2013:p1271:b003:l022","ordinal":284489,"en":"And I lost you, my khan and uncle."},{"id":"semetey-2-2013:p1271:b003:l023","ordinal":284490,"en":"Among the encircling hosts, I stand alone;"},{"id":"semetey-2-2013:p1271:b003:l024","ordinal":284491,"en":"A bullet struck and tore through my shoulder,"},{"id":"semetey-2-2013:p1271:b003:l025","ordinal":284492,"en":"And I cannot turn around."},{"id":"semetey-2-2013:p1271:b003:l026","ordinal":284493,"en":"Amid the thousands surrounding me, I stand alone;"},{"id":"semetey-2-2013:p1271:b003:l027","ordinal":284494,"en":"A bullet shattered my ankle,"},{"id":"semetey-2-2013:p1271:b003:l028","ordinal":284495,"en":"And I cannot move."},{"id":"semetey-2-2013:p1271:b003:l029","ordinal":284496,"en":"Helpless and growing weak,"},{"id":"semetey-2-2013:p1271:b003:l030","ordinal":284497,"en":"My strength gone as I bleed,"},{"id":"semetey-2-2013:p1271:b003:l031","ordinal":284498,"en":"My soul screaming, my vigor spent,"},{"id":"semetey-2-2013:p1271:b003:l032","ordinal":284499,"en":"All power fled, steeped in grief,"},{"id":"semetey-2-2013:p1271:b003:l033","ordinal":284500,"en":"Parted from my dear uncle,"},{"id":"semetey-2-2013:p1271:b003:l034","ordinal":284501,"en":"Here I sit in this plight."},{"id":"semetey-2-2013:p1271:b003:l035","ordinal":284502,"en":"The wings meant for flight were crooked;"},{"id":"semetey-2-2013:p1271:b003:l036","ordinal":284503,"en":"My true fortune was meager."},{"id":"semetey-2-2013:p1271:b003:l037","ordinal":284504,"en":"A deep pit was all I was destined to see;"},{"id":"semetey-2-2013:p1271:b003:l038","ordinal":284505,"en":"My own kinsman Kanchoro"},{"id":"semetey-2-2013:p1271:b003:l039","ordinal":284506,"en":"Had no trace of brotherhood in him."},{"id":"semetey-2-2013:p1271:b004:l001","ordinal":284507,"en":"My own kin became my enemy;"},{"id":"semetey-2-2013:p1271:b004:l002","ordinal":284508,"en":"Parted from my beloved lion,"},{"id":"semetey-2-2013:p1271:b004:l003","ordinal":284509,"en":"My sorrow will not leave me."},{"id":"semetey-2-2013:p1271:b004:l004","ordinal":284510,"en":"A fire burns within my core;"},{"id":"semetey-2-2013:p1271:b004:l005","ordinal":284511,"en":"My own kinsman became my foe,"},{"id":"semetey-2-2013:p1271:b004:l006","ordinal":284512,"en":"And bitter misery became my lot."},{"id":"semetey-2-2013:p1271:b004:l007","ordinal":284513,"en":"The sky is clear, yet the earth is overcast;"},{"id":"semetey-2-2013:p1271:b004:l008","ordinal":284514,"en":"This is a woeful, calamitous day."},{"id":"semetey-2-2013:p1271:b004:l009","ordinal":284515,"en":"I am left wandering, ill-fated;"},{"id":"semetey-2-2013:p1271:b004:l010","ordinal":284516,"en":"Alas, my uncle, take me with you."},{"id":"semetey-2-2013:p1271:b004:l011","ordinal":284517,"en":"My aged grandfather Bakay is gone;"},{"id":"semetey-2-2013:p1271:b004:l012","ordinal":284518,"en":"My mountain-like uncle is gone."},{"id":"semetey-2-2013:p1271:b004:l013","ordinal":284519,"en":"So this is what you are like, treacherous world—"},{"id":"semetey-2-2013:p1271:b004:l014","ordinal":284520,"en":"Damn you, worthless world!"},{"id":"semetey-2-2013:p1271:b004:l015","ordinal":284521,"en":"Wandering in grief,"},{"id":"semetey-2-2013:p1271:b004:l016","ordinal":284522,"en":"My beloved Semetey—"},{"id":"semetey-2-2013:p1271:b004:l017","ordinal":284523,"en":"Parted from Semetey,"},{"id":"semetey-2-2013:p1271:b004:l018","ordinal":284524,"en":"I am about to fall to a foe"},{"id":"semetey-2-2013:p1271:b004:l019","ordinal":284525,"en":"Who spares no life, however one pleads."},{"id":"semetey-2-2013:p1271:b004:l020","ordinal":284526,"en":"Am I to plunge into a calamity"},{"id":"semetey-2-2013:p1271:b004:l021","ordinal":284527,"en":"No man can wade through?"},{"id":"semetey-2-2013:p1271:b004:l022","ordinal":284528,"en":"Shorn of my wings,"},{"id":"semetey-2-2013:p1271:b004:l023","ordinal":284529,"en":"Am I about to be captured?"},{"id":"semetey-2-2013:p1271:b004:l024","ordinal":284530,"en":"Pleading, “Spare my blood,”"},{"id":"semetey-2-2013:p1271:b004:l025","ordinal":284531,"en":"Are we to die a wretched death?"},{"id":"semetey-2-2013:p1271:b004:l026","ordinal":284532,"en":"These pressing Jediger"},{"id":"semetey-2-2013:p1271:b004:l027","ordinal":284533,"en":"Are not the red, misty mountains;"},{"id":"semetey-2-2013:p1271:b004:l028","ordinal":284534,"en":"Those pressing in to take my life"},{"id":"semetey-2-2013:p1271:b004:l029","ordinal":284535,"en":"Are not an enemy come from China,"},{"id":"semetey-2-2013:p1271:b004:l030","ordinal":284536,"en":"Nor are they the dark, rugged mountains."},{"id":"semetey-2-2013:p1271:b004:l031","ordinal":284537,"en":"The Jediger swarming over me"},{"id":"semetey-2-2013:p1271:b004:l032","ordinal":284538,"en":"Are not an enemy sprung from the Kalmyks."},{"id":"semetey-2-2013:p1271:b004:l033","ordinal":284539,"en":"Their lungs bursting, their hearts aflame—"},{"id":"semetey-2-2013:p1271:b004:l034","ordinal":284540,"en":"These Jediger are surely mad."},{"id":"semetey-2-2013:p1271:b004:l035","ordinal":284541,"en":"Though Kyrgyz, they fired upon us"},{"id":"semetey-2-2013:p1271:b004:l036","ordinal":284542,"en":"And did worse than the Chinese."},{"id":"semetey-2-2013:p1271:b004:l037","ordinal":284543,"en":"Where no enemy dared advance,"},{"id":"semetey-2-2013:p1271:b004:l038","ordinal":284544,"en":"The Ala-Too was our land;"},{"id":"semetey-2-2013:p1271:b004:l039","ordinal":284545,"en":"Black-coated and white-capped,"},{"id":"semetey-2-2013:p1272:b003:l001","ordinal":284546,"en":"Our dear Kyrgyz were our people."},{"id":"semetey-2-2013:p1272:b003:l002","ordinal":284547,"en":"You fired your guns with thunderous cracks—"},{"id":"semetey-2-2013:p1272:b003:l003","ordinal":284548,"en":"My dear people, do as you will."},{"id":"semetey-2-2013:p1272:b003:l004","ordinal":284549,"en":"Our backs have turned against one another;"},{"id":"semetey-2-2013:p1272:b003:l005","ordinal":284550,"en":"Alas, our people have become corrupt."},{"id":"semetey-2-2013:p1272:b003:l006","ordinal":284551,"en":"Our nature has utterly changed;"},{"id":"semetey-2-2013:p1272:b003:l007","ordinal":284552,"en":"The Kyrgyz people are ruined."},{"id":"semetey-2-2013:p1272:b003:l008","ordinal":284553,"en":"They are not an enemy from the Chinese khagan,"},{"id":"semetey-2-2013:p1272:b003:l009","ordinal":284554,"en":"Yet, doing worse than the Chinese,"},{"id":"semetey-2-2013:p1272:b003:l010","ordinal":284555,"en":"Our hearts have turned against each other."},{"id":"semetey-2-2013:p1272:b003:l011","ordinal":284556,"en":"The lion died and our strength departed;"},{"id":"semetey-2-2013:p1272:b003:l012","ordinal":284557,"en":"All fortune and prosperity vanished."},{"id":"semetey-2-2013:p1272:b003:l013","ordinal":284558,"en":"From Jylgyn, Keng-Kol, and Talas,"},{"id":"semetey-2-2013:p1272:b003:l014","ordinal":284559,"en":"The yellow-ridged passes were lost."},{"id":"semetey-2-2013:p1272:b003:l015","ordinal":284560,"en":"Semetey, defender of the people—"},{"id":"semetey-2-2013:p1272:b003:l016","ordinal":284561,"en":"My lionhearted uncle departed from the Kyrgyz."},{"id":"semetey-2-2013:p1272:b003:l017","ordinal":284562,"en":"Wandering in grief,"},{"id":"semetey-2-2013:p1272:b003:l018","ordinal":284563,"en":"Parted from my khan and lion of an uncle,"},{"id":"semetey-2-2013:p1272:b003:l019","ordinal":284564,"en":"My two eyes dart about,"},{"id":"semetey-2-2013:p1272:b003:l020","ordinal":284565,"en":"My two legs hang limp."},{"id":"semetey-2-2013:p1272:b003:l021","ordinal":284566,"en":"My strength exhausted, my vigor gone,"},{"id":"semetey-2-2013:p1272:b003:l022","ordinal":284567,"en":"Dark blood drains from my body."},{"id":"semetey-2-2013:p1272:b003:l023","ordinal":284568,"en":"The face of the world has turned to snow;"},{"id":"semetey-2-2013:p1272:b003:l024","ordinal":284569,"en":"My courage fails and my heart burns."},{"id":"semetey-2-2013:p1272:b003:l025","ordinal":284570,"en":"My bones gone slack, I cannot walk;"},{"id":"semetey-2-2013:p1272:b003:l026","ordinal":284571,"en":"There is no hollow where I may hide."},{"id":"semetey-2-2013:p1272:b003:l027","ordinal":284572,"en":"My poor soul burns and feels confined;"},{"id":"semetey-2-2013:p1272:b003:l028","ordinal":284573,"en":"I find no pass by which to flee,"},{"id":"semetey-2-2013:p1272:b003:l029","ordinal":284574,"en":"No refuge where I may shelter—"},{"id":"semetey-2-2013:p1272:b003:l030","ordinal":284575,"en":"Such torment Külchoro endured."},{"id":"semetey-2-2013:p1272:b003:l031","ordinal":284576,"en":"Clouds covered the sky;"},{"id":"semetey-2-2013:p1272:b003:l032","ordinal":284577,"en":"Sixty calamities came at once."},{"id":"semetey-2-2013:p1272:b003:l033","ordinal":284578,"en":"He limped along, sparing himself,"},{"id":"semetey-2-2013:p1272:b003:l034","ordinal":284579,"en":"Leaning upon his father’s legacy,"},{"id":"semetey-2-2013:p1272:b003:l035","ordinal":284580,"en":"The long matchlock rifle."},{"id":"semetey-2-2013:p1272:b003:l036","ordinal":284581,"en":"Early prophecies had come true too late;"},{"id":"semetey-2-2013:p1272:b003:l037","ordinal":284582,"en":"Eager to end his wretched life,"},{"id":"semetey-2-2013:p1272:b003:l038","ordinal":284583,"en":"His eyes stared wide."},{"id":"semetey-2-2013:p1272:b003:l039","ordinal":284584,"en":"He sobbed, crying, “My uncle!”"},{"id":"semetey-2-2013:p1272:b004:l001","ordinal":284585,"en":"And, “My forefather Manas, long departed!”"},{"id":"semetey-2-2013:p1272:b004:l002","ordinal":284586,"en":"While your beloved one stood thus,"},{"id":"semetey-2-2013:p1272:b004:l003","ordinal":284587,"en":"If only you had mounted Buurul and made him rear,"},{"id":"semetey-2-2013:p1272:b004:l004","ordinal":284588,"en":"Spurring him into a frenzy,"},{"id":"semetey-2-2013:p1272:b004:l005","ordinal":284589,"en":"Raging like a mountain torrent,"},{"id":"semetey-2-2013:p1272:b004:l006","ordinal":284590,"en":"With the bearing of a mountain lion,"},{"id":"semetey-2-2013:p1272:b004:l007","ordinal":284591,"en":"Dark-backed and blue-flanked—"},{"id":"semetey-2-2013:p1272:b004:l008","ordinal":284592,"en":"If only my lionhearted uncle"},{"id":"semetey-2-2013:p1272:b004:l009","ordinal":284593,"en":"Had watched while the Jediger pressed me,"},{"id":"semetey-2-2013:p1272:b004:l010","ordinal":284594,"en":"While they inflicted this disgrace,"},{"id":"semetey-2-2013:p1272:b004:l011","ordinal":284595,"en":"While my dear uncle looked on,"},{"id":"semetey-2-2013:p1272:b004:l012","ordinal":284596,"en":"Then let the vast black host of Jediger"},{"id":"semetey-2-2013:p1272:b004:l013","ordinal":284597,"en":"Have tried to shame me so!"},{"id":"semetey-2-2013:p1272:b004:l014","ordinal":284598,"en":"Mounted on the horse Aisarala,"},{"id":"semetey-2-2013:p1272:b004:l015","ordinal":284599,"en":"Carrying a spear without a tassel,"},{"id":"semetey-2-2013:p1272:b004:l016","ordinal":284600,"en":"Calmly filled with fury,"},{"id":"semetey-2-2013:p1272:b004:l017","ordinal":284601,"en":"A scabbardless sword at his waist,"},{"id":"semetey-2-2013:p1272:b004:l018","ordinal":284602,"en":"Saying, “I shall stand beside the lone warrior,”"},{"id":"semetey-2-2013:p1272:b004:l019","ordinal":284603,"en":"If only my lion father Almambet, gone to eternity,"},{"id":"semetey-2-2013:p1272:b004:l020","ordinal":284604,"en":"Had stood watching!"},{"id":"semetey-2-2013:p1272:b004:l021","ordinal":284605,"en":"Then let the vast black host of Jediger"},{"id":"semetey-2-2013:p1272:b004:l022","ordinal":284606,"en":"Have aimed their hatred and fired,"},{"id":"semetey-2-2013:p1272:b004:l023","ordinal":284607,"en":"And tried their tyranny!"},{"id":"semetey-2-2013:p1272:b004:l024","ordinal":284608,"en":"He seemed as vast as the blue sky;"},{"id":"semetey-2-2013:p1272:b004:l025","ordinal":284609,"en":"Not only men, but even beasts"},{"id":"semetey-2-2013:p1272:b004:l026","ordinal":284610,"en":"Were shaken at the sight of him."},{"id":"semetey-2-2013:p1272:b004:l027","ordinal":284611,"en":"His quiver was like the back of a rhinoceros,"},{"id":"semetey-2-2013:p1272:b004:l028","ordinal":284612,"en":"Its weight enough to crush a soul."},{"id":"semetey-2-2013:p1272:b004:l029","ordinal":284613,"en":"Throwing the whole world into alarm,"},{"id":"semetey-2-2013:p1272:b004:l030","ordinal":284614,"en":"He made the Kula horse beneath him"},{"id":"semetey-2-2013:p1272:b004:l031","ordinal":284615,"en":"Stride proudly."},{"id":"semetey-2-2013:p1272:b004:l032","ordinal":284616,"en":"He leveled his Akkelte,"},{"id":"semetey-2-2013:p1272:b004:l033","ordinal":284617,"en":"And felled every enemy he met."},{"id":"semetey-2-2013:p1272:b004:l034","ordinal":284618,"en":"He loaded ammunition upon the packhorse;"},{"id":"semetey-2-2013:p1272:b004:l035","ordinal":284619,"en":"When he came in wrath,"},{"id":"semetey-2-2013:p1272:b004:l036","ordinal":284620,"en":"He swept away the Chinese khagan’s hosts."},{"id":"semetey-2-2013:p1272:b004:l037","ordinal":284621,"en":"None who faced him defeated him;"},{"id":"semetey-2-2013:p1272:b004:l038","ordinal":284622,"en":"None who fought him escaped death."},{"id":"semetey-2-2013:p1272:b004:l039","ordinal":284623,"en":"Of singular form and terrible venom,"},{"id":"semetey-2-2013:p1273:b003:l001","ordinal":284624,"en":"My mountain-lion father, Khan Manas,"},{"id":"semetey-2-2013:p1273:b003:l002","ordinal":284625,"en":"His bulletproof armor billowing—"},{"id":"semetey-2-2013:p1273:b003:l003","ordinal":284626,"en":"If only that destroyer had stood watching!"},{"id":"semetey-2-2013:p1273:b003:l004","ordinal":284627,"en":"Then let these Jediger here"},{"id":"semetey-2-2013:p1273:b003:l005","ordinal":284628,"en":"Have shamed the suffering warrior,"},{"id":"semetey-2-2013:p1273:b003:l006","ordinal":284629,"en":"Have inflicted this disgrace,"},{"id":"semetey-2-2013:p1273:b003:l007","ordinal":284630,"en":"And then taken his life!"},{"id":"semetey-2-2013:p1273:b003:l008","ordinal":284631,"en":"Wearing a blue-lynx cap,"},{"id":"semetey-2-2013:p1273:b003:l009","ordinal":284632,"en":"Wielding a mottled blue shield,"},{"id":"semetey-2-2013:p1273:b003:l010","ordinal":284633,"en":"When ten thousand foes appeared before him,"},{"id":"semetey-2-2013:p1273:b003:l011","ordinal":284634,"en":"He gave them no longer than meat takes to cook."},{"id":"semetey-2-2013:p1273:b003:l012","ordinal":284635,"en":"His eyes saw into the distance;"},{"id":"semetey-2-2013:p1273:b003:l013","ordinal":284636,"en":"He stood alone and unmatched in every contest."},{"id":"semetey-2-2013:p1273:b003:l014","ordinal":284637,"en":"The consummate sage Bakay,"},{"id":"semetey-2-2013:p1273:b003:l015","ordinal":284638,"en":"Our forefather, mighty as a hero—"},{"id":"semetey-2-2013:p1273:b003:l016","ordinal":284639,"en":"Our poor uncle Bakay"},{"id":"semetey-2-2013:p1273:b003:l017","ordinal":284640,"en":"Was not watching from the ridge."},{"id":"semetey-2-2013:p1273:b003:l018","ordinal":284641,"en":"So the treacherous Kanchoro"},{"id":"semetey-2-2013:p1273:b003:l019","ordinal":284642,"en":"Did not then commit his outrage,"},{"id":"semetey-2-2013:p1273:b003:l020","ordinal":284643,"en":"Nor did he take my life."},{"id":"semetey-2-2013:p1273:b003:l021","ordinal":284644,"en":"He knew seventy winding tongues;"},{"id":"semetey-2-2013:p1273:b003:l022","ordinal":284645,"en":"He traveled roads that led toward death."},{"id":"semetey-2-2013:p1273:b003:l023","ordinal":284646,"en":"He whetted his eloquence,"},{"id":"semetey-2-2013:p1273:b003:l024","ordinal":284647,"en":"And never shrank or stayed behind in war."},{"id":"semetey-2-2013:p1273:b003:l025","ordinal":284648,"en":"He spoke before the people;"},{"id":"semetey-2-2013:p1273:b003:l026","ordinal":284649,"en":"No enemy who faced him prospered,"},{"id":"semetey-2-2013:p1273:b003:l027","ordinal":284650,"en":"And never was his word in vain."},{"id":"semetey-2-2013:p1273:b003:l028","ordinal":284651,"en":"A six-month ordeal"},{"id":"semetey-2-2013:p1273:b003:l029","ordinal":284652,"en":"He foresaw from afar."},{"id":"semetey-2-2013:p1273:b003:l030","ordinal":284653,"en":"Descendant of Kök-Terek,"},{"id":"semetey-2-2013:p1273:b003:l031","ordinal":284654,"en":"Eloquent spokesman of gray-maned Manas,"},{"id":"semetey-2-2013:p1273:b003:l032","ordinal":284655,"en":"Achybay, son of the Argyn khan—"},{"id":"semetey-2-2013:p1273:b003:l033","ordinal":284656,"en":"If only that cunning man had stood watching!"},{"id":"semetey-2-2013:p1273:b003:l034","ordinal":284657,"en":"Then let the Jediger"},{"id":"semetey-2-2013:p1273:b003:l035","ordinal":284658,"en":"Have inflicted this disgrace!"},{"id":"semetey-2-2013:p1273:b003:l036","ordinal":284659,"en":"Thick-armed and stone-hearted,"},{"id":"semetey-2-2013:p1273:b003:l037","ordinal":284660,"en":"Stout and powerfully built,"},{"id":"semetey-2-2013:p1273:b003:l038","ordinal":284661,"en":"A scabbardless sword at his waist,"},{"id":"semetey-2-2013:p1273:b003:l039","ordinal":284662,"en":"Like a cloud returning with rain,"},{"id":"semetey-2-2013:p1273:b005:l001","ordinal":284663,"en":"His wrath spread across his face."},{"id":"semetey-2-2013:p1273:b005:l002","ordinal":284664,"en":"He broke through seven lines and opened a road;"},{"id":"semetey-2-2013:p1273:b005:l003","ordinal":284665,"en":"If seventy thousand foes came,"},{"id":"semetey-2-2013:p1273:b005:l004","ordinal":284666,"en":"He charged alone into their midst."},{"id":"semetey-2-2013:p1273:b005:l005","ordinal":284667,"en":"Foremost among the sixty,"},{"id":"semetey-2-2013:p1273:b005:l006","ordinal":284668,"en":"Fiercest of the falcons,"},{"id":"semetey-2-2013:p1273:b005:l007","ordinal":284669,"en":"Best of the spearmen,"},{"id":"semetey-2-2013:p1273:b005:l008","ordinal":284670,"en":"Best of the warriors,"},{"id":"semetey-2-2013:p1273:b005:l009","ordinal":284671,"en":"Black steel was his blade—"},{"id":"semetey-2-2013:p1273:b005:l010","ordinal":284672,"en":"Syrgak of my father Khan Manas."}]
