{"id": "sayakbay-ms-current146:pdf023:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 23, "folio": 406, "line_in_page": 26, "raw": "Кишөөгө байлап тарттырып,", "text": "Кишөөгө байлап тарттырып,", "en": "Binding them in fetters and having them dragged,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The opening appears to be a dialectal or nonstandard form related to кишен; the remaining verbs are visually clearer.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf023:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 23, "folio": 406, "line_in_page": 27, "raw": "Кара сай дүйнөгө,", "text": "Кара сай дүйнөгө,", "en": "Into the dark ravine of the world,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The final word is pale and may not be дүйнөгө; English follows this provisional reading.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf023:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 23, "folio": 406, "line_in_page": 28, "raw": "Алга миңге чабарман,", "text": "Алга миңге чабарман,", "en": "Forward, a courier to the thousand,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "The middle word appears to be миңге; the relation among the words is uncertain.", "bbox": null}
