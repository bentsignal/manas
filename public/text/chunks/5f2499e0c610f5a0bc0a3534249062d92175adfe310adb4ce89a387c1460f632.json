[{"id":"semetey-1-2013:p0919:b003:l009","ordinal":147201,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p0919:b003:l010","ordinal":147202,"en":"Before a word could be spoken,"},{"id":"semetey-1-2013:p0919:b003:l011","ordinal":147203,"en":"He came near the orphan,"},{"id":"semetey-1-2013:p0919:b003:l012","ordinal":147204,"en":"And rode in among them."},{"id":"semetey-1-2013:p0919:b003:l013","ordinal":147205,"en":"That orphan, the forty companions—"},{"id":"semetey-1-2013:p0919:b003:l014","ordinal":147206,"en":"Had slaughtered them to the last."},{"id":"semetey-1-2013:p0919:b003:l015","ordinal":147207,"en":"He had gathered their corpses in the valley."},{"id":"semetey-1-2013:p0919:b003:l016","ordinal":147208,"en":"The aged hero Bakai,"},{"id":"semetey-1-2013:p0919:b003:l017","ordinal":147209,"en":"My uncle Bakai, the saint,"},{"id":"semetey-1-2013:p0919:b003:l018","ordinal":147210,"en":"Taking a hare's paw in his hand,"},{"id":"semetey-1-2013:p0919:b003:l019","ordinal":147211,"en":"Opened his eyes and shuddered."},{"id":"semetey-1-2013:p0919:b003:l020","ordinal":147212,"en":"Trembling, overcome with tears,"},{"id":"semetey-1-2013:p0919:b003:l021","ordinal":147213,"en":"Bakai began to weep."},{"id":"semetey-1-2013:p0919:b003:l022","ordinal":147214,"en":"Alas, with the hero Bakai"},{"id":"semetey-1-2013:p0919:b003:l023","ordinal":147215,"en":"They had shared sheep in one fold,"},{"id":"semetey-1-2013:p0919:b003:l024","ordinal":147216,"en":"Shared food as comrades,"},{"id":"semetey-1-2013:p0919:b003:l025","ordinal":147217,"en":"Shared death and life together."},{"id":"semetey-1-2013:p0919:b003:l026","ordinal":147218,"en":"Bakai's heart was troubled."},{"id":"semetey-1-2013:p0919:b003:l027","ordinal":147219,"en":"Out on the steppe Khan Bakai saw"},{"id":"semetey-1-2013:p0919:b003:l028","ordinal":147220,"en":"The corpses of the forty companions."},{"id":"semetey-1-2013:p0919:b003:l029","ordinal":147221,"en":"When he saw them slaughtered,"},{"id":"semetey-1-2013:p0919:b003:l030","ordinal":147222,"en":"Your precious uncle Bakai"},{"id":"semetey-1-2013:p0919:b003:l031","ordinal":147223,"en":"Turned back to the khans,"},{"id":"semetey-1-2013:p0919:b003:l032","ordinal":147224,"en":"And spoke these words:"},{"id":"semetey-1-2013:p0919:b003:l033","ordinal":147225,"en":"“Zhamgyrchy and Sary Khan,"},{"id":"semetey-1-2013:p0919:b003:l034","ordinal":147226,"en":"My heart is sorely troubled."},{"id":"semetey-1-2013:p0919:b003:l035","ordinal":147227,"en":"The forty damned companions"},{"id":"semetey-1-2013:p0919:b003:l036","ordinal":147228,"en":"Lie slaughtered before us."},{"id":"semetey-1-2013:p0919:b003:l037","ordinal":147229,"en":"Those dogs with crooked minds"},{"id":"semetey-1-2013:p0919:b003:l038","ordinal":147230,"en":"Have left their corpses upon the ridge."},{"id":"semetey-1-2013:p0919:b003:l039","ordinal":147231,"en":"Can anything good come of quarreling?"},{"id":"semetey-1-2013:p0919:b004:l001","ordinal":147232,"en":"Their blood has spilled upon the steppe."},{"id":"semetey-1-2013:p0919:b004:l002","ordinal":147233,"en":"The forty companions born of wickedness—"},{"id":"semetey-1-2013:p0919:b004:l003","ordinal":147234,"en":"Their bones lie buried on the steppe."},{"id":"semetey-1-2013:p0919:b004:l004","ordinal":147235,"en":"The forty companion-friends are dead;"},{"id":"semetey-1-2013:p0919:b004:l005","ordinal":147236,"en":"Bakai has seen their deaths."},{"id":"semetey-1-2013:p0919:b004:l006","ordinal":147237,"en":"Kochkor and Chyybyt died together;"},{"id":"semetey-1-2013:p0919:b004:l007","ordinal":147238,"en":"Adybai and Kolbai are dead.”"},{"id":"semetey-1-2013:p0919:b004:l008","ordinal":147239,"en":"While they stood grieving,"},{"id":"semetey-1-2013:p0919:b004:l009","ordinal":147240,"en":"Lively Semetey,"},{"id":"semetey-1-2013:p0919:b004:l010","ordinal":147241,"en":"With a black marten cap upon his head,"},{"id":"semetey-1-2013:p0919:b004:l011","ordinal":147242,"en":"The noble scion born of Manas,"},{"id":"semetey-1-2013:p0919:b004:l012","ordinal":147243,"en":"Looking to either side,"},{"id":"semetey-1-2013:p0919:b004:l013","ordinal":147244,"en":"Licking his lips and nose,"},{"id":"semetey-1-2013:p0919:b004:l014","ordinal":147245,"en":"Came up to Bakai."},{"id":"semetey-1-2013:p0919:b004:l015","ordinal":147246,"en":"Look at him in his sorrow:"},{"id":"semetey-1-2013:p0919:b004:l016","ordinal":147247,"en":"Did not let the child sense his misgivings—"},{"id":"semetey-1-2013:p0919:b004:l017","ordinal":147248,"en":"Your leopard uncle Bakai."},{"id":"semetey-1-2013:p0919:b004:l018","ordinal":147249,"en":"“Hey, my orphan, son of Manas,"},{"id":"semetey-1-2013:p0919:b004:l019","ordinal":147250,"en":"Your fugitive uncles, the forty companions,"},{"id":"semetey-1-2013:p0919:b004:l020","ordinal":147251,"en":"You have pursued them fiercely."},{"id":"semetey-1-2013:p0919:b004:l021","ordinal":147252,"en":"Without bearing their faults a little,"},{"id":"semetey-1-2013:p0919:b004:l022","ordinal":147253,"en":"You have slaughtered them."},{"id":"semetey-1-2013:p0919:b004:l023","ordinal":147254,"en":"My orphan touched by Khizr,"},{"id":"semetey-1-2013:p0919:b004:l024","ordinal":147255,"en":"You have taken ample vengeance!"},{"id":"semetey-1-2013:p0919:b004:l025","ordinal":147256,"en":"The forty companions your father left—"},{"id":"semetey-1-2013:p0919:b004:l026","ordinal":147257,"en":"You have slaughtered them!"},{"id":"semetey-1-2013:p0919:b004:l027","ordinal":147258,"en":"Red tail get knowledge,"},{"id":"semetey-1-2013:p0919:b004:l028","ordinal":147259,"en":"My precious orphan, heed my words."},{"id":"semetey-1-2013:p0919:b004:l029","ordinal":147260,"en":"The inheritance left by Manas,"},{"id":"semetey-1-2013:p0919:b004:l030","ordinal":147261,"en":"All forty companions alike—"},{"id":"semetey-1-2013:p0919:b004:l031","ordinal":147262,"en":"Their remedy has been found."},{"id":"semetey-1-2013:p0919:b004:l032","ordinal":147263,"en":"They have all been shattered."},{"id":"semetey-1-2013:p0919:b004:l033","ordinal":147264,"en":"Their thin mustaches smoothed,"},{"id":"semetey-1-2013:p0919:b004:l034","ordinal":147265,"en":"They have all gone to the world beyond."},{"id":"semetey-1-2013:p0919:b004:l035","ordinal":147266,"en":"They have all fallen crooked,"},{"id":"semetey-1-2013:p0919:b004:l036","ordinal":147267,"en":"My darling Semetey,"},{"id":"semetey-1-2013:p0919:b004:l037","ordinal":147268,"en":"The old and young together."},{"id":"semetey-1-2013:p0919:b004:l038","ordinal":147269,"en":"With your elder kinsmen foremost,"},{"id":"semetey-1-2013:p0919:b004:l039","ordinal":147270,"en":"You have slaughtered the forty companions."},{"id":"semetey-1-2013:p0920:b003:l001","ordinal":147271,"en":"My orphan touched by Khizr,"},{"id":"semetey-1-2013:p0920:b003:l002","ordinal":147272,"en":"You have drunk your fill of their blood."},{"id":"semetey-1-2013:p0920:b003:l003","ordinal":147273,"en":"Drawing bows in a rain of arrows,"},{"id":"semetey-1-2013:p0920:b003:l004","ordinal":147274,"en":"They attacked, and you slaughtered them."},{"id":"semetey-1-2013:p0920:b003:l005","ordinal":147275,"en":"Great torment came upon your soul,"},{"id":"semetey-1-2013:p0920:b003:l006","ordinal":147276,"en":"And you put an end to them!"},{"id":"semetey-1-2013:p0920:b003:l007","ordinal":147277,"en":"The forty companions left by Manas—"},{"id":"semetey-1-2013:p0920:b003:l008","ordinal":147278,"en":"If we leave without covering their faces,"},{"id":"semetey-1-2013:p0920:b003:l009","ordinal":147279,"en":"Their dear currant-like eyes"},{"id":"semetey-1-2013:p0920:b003:l010","ordinal":147280,"en":"The cawing crows must not gouge out."},{"id":"semetey-1-2013:p0920:b003:l011","ordinal":147281,"en":"Their door-sized white teeth"},{"id":"semetey-1-2013:p0920:b003:l012","ordinal":147282,"en":"The magpies must not shit upon!"},{"id":"semetey-1-2013:p0920:b003:l013","ordinal":147283,"en":"The wolves must not tear out their kidneys;"},{"id":"semetey-1-2013:p0920:b003:l014","ordinal":147284,"en":"On all the rest of their flesh"},{"id":"semetey-1-2013:p0920:b003:l015","ordinal":147285,"en":"The accursed foxes must not feast!"},{"id":"semetey-1-2013:p0920:b003:l016","ordinal":147286,"en":"Slaughter their mounts before you go;"},{"id":"semetey-1-2013:p0920:b003:l017","ordinal":147287,"en":"Dig the earth with mattocks before you go."},{"id":"semetey-1-2013:p0920:b003:l018","ordinal":147288,"en":"Dedicate and slaughter their mounts;"},{"id":"semetey-1-2013:p0920:b003:l019","ordinal":147289,"en":"All the forty companions"},{"id":"semetey-1-2013:p0920:b003:l020","ordinal":147290,"en":"Lay in marked graves before you go!”"},{"id":"semetey-1-2013:p0920:b003:l021","ordinal":147291,"en":"Heeding Bakai's words,"},{"id":"semetey-1-2013:p0920:b003:l022","ordinal":147292,"en":"Travelers passing this way and that"},{"id":"semetey-1-2013:p0920:b003:l023","ordinal":147293,"en":"He gathered together."},{"id":"semetey-1-2013:p0920:b003:l024","ordinal":147294,"en":"Kochkor and Chyybyt, the two,"},{"id":"semetey-1-2013:p0920:b003:l025","ordinal":147295,"en":"With Adybai and Kolbai, the four,"},{"id":"semetey-1-2013:p0920:b003:l026","ordinal":147296,"en":"He laid side by side."},{"id":"semetey-1-2013:p0920:b003:l027","ordinal":147297,"en":"For the forty companions, forty tombs"},{"id":"semetey-1-2013:p0920:b003:l028","ordinal":147298,"en":"He built in wondrous fashion."},{"id":"semetey-1-2013:p0920:b003:l029","ordinal":147299,"en":"There were ninety trading Sarts,"},{"id":"semetey-1-2013:p0920:b003:l030","ordinal":147300,"en":"With Kyzyl Sart as caravan leader."},{"id":"semetey-1-2013:p0920:b003:l031","ordinal":147301,"en":"Making friends with Kyzyl Sart,"},{"id":"semetey-1-2013:p0920:b003:l032","ordinal":147302,"en":"He summoned the Sarts' craftsmen."},{"id":"semetey-1-2013:p0920:b003:l033","ordinal":147303,"en":"He had them knead and tread the clay,"},{"id":"semetey-1-2013:p0920:b003:l034","ordinal":147304,"en":"And cattle hair mixed with goat hair"},{"id":"semetey-1-2013:p0920:b003:l035","ordinal":147305,"en":"He had scattered into the clay."},{"id":"semetey-1-2013:p0920:b003:l036","ordinal":147306,"en":"She had them tread the mud."},{"id":"semetey-1-2013:p0920:b003:l037","ordinal":147307,"en":"Whether it stood crooked or straight,"},{"id":"semetey-1-2013:p0920:b003:l038","ordinal":147308,"en":"He had Kyzyl Sart inspect it."},{"id":"semetey-1-2013:p0920:b003:l039","ordinal":147309,"en":"For the forty companions, forty tombs"},{"id":"semetey-1-2013:p0920:b004:l001","ordinal":147310,"en":"And levy a heavy fine;"},{"id":"semetey-1-2013:p0920:b004:l002","ordinal":147311,"en":"He had Surkyzyl slaughtered."},{"id":"semetey-1-2013:p0920:b004:l003","ordinal":147312,"en":"“May all the people dwelling here"},{"id":"semetey-1-2013:p0920:b004:l004","ordinal":147313,"en":"Butt one another like rams,” he said."},{"id":"semetey-1-2013:p0920:b004:l006","ordinal":147314,"en":"That place where the tombs stood"},{"id":"semetey-1-2013:p0920:b004:l007","ordinal":147315,"en":"He had named “Kochkor” and “Chyybyt.”"},{"id":"semetey-1-2013:p0920:b004:l008","ordinal":147316,"en":"Having buried the forty companions, Semetey"},{"id":"semetey-1-2013:p0920:b004:l009","ordinal":147317,"en":"Received Khan Bakai's blessing."},{"id":"semetey-1-2013:p0920:b004:l010","ordinal":147318,"en":"Thus that place"},{"id":"semetey-1-2013:p0920:b004:l011","ordinal":147319,"en":"Came to be called Kochkor."},{"id":"semetey-1-2013:p0920:b004:l012","ordinal":147320,"en":"After slaughtering the forty companions,"},{"id":"semetey-1-2013:p0920:b004:l013","ordinal":147321,"en":"After slaughtering them and finding relief,"},{"id":"semetey-1-2013:p0920:b004:l014","ordinal":147322,"en":"He returned to Talas."},{"id":"semetey-1-2013:p0920:b004:l015","ordinal":147323,"en":"Semetey had no regret,"},{"id":"semetey-1-2013:p0920:b004:l016","ordinal":147324,"en":"And became a sultan in Talas."},{"id":"semetey-1-2013:p0920:b004:l017","ordinal":147325,"en":"His name was heard in Alai,"},{"id":"semetey-1-2013:p0920:b004:l018","ordinal":147326,"en":"His spiritual might spread far and wide."},{"id":"semetey-1-2013:p0920:b004:l019","ordinal":147327,"en":"Ment the opponent,"},{"id":"semetey-1-2013:p0920:b004:l020","ordinal":147328,"en":"He stood firm by his word,"},{"id":"semetey-1-2013:p0920:b004:l021","ordinal":147329,"en":"A noble scion as strong as iron,"},{"id":"semetey-1-2013:p0920:b004:l022","ordinal":147330,"en":"Maintaining a royal court, a khan,"},{"id":"semetey-1-2013:p0920:b004:l023","ordinal":147331,"en":"A man born of saints."},{"id":"semetey-1-2013:p0920:b004:l024","ordinal":147332,"en":"Word was sent to the people."},{"id":"semetey-1-2013:p0920:b004:l025","ordinal":147333,"en":"They set a golden crown upon him,"},{"id":"semetey-1-2013:p0920:b004:l026","ordinal":147334,"en":"And seated him upon a golden throne."},{"id":"semetey-1-2013:p0920:b004:l027","ordinal":147335,"en":"Over the Argyn and the Kyrgyz"},{"id":"semetey-1-2013:p0920:b004:l028","ordinal":147336,"en":"They gave him unshaken rule,"},{"id":"semetey-1-2013:p0920:b004:l029","ordinal":147337,"en":"And raised him as khan."},{"id":"semetey-1-2013:p0920:b004:l030","ordinal":147338,"en":"His father, gray-maned Manas—"},{"id":"semetey-1-2013:p0920:b004:l031","ordinal":147339,"en":"Semetey was born surpassing him,"},{"id":"semetey-1-2013:p0920:b004:l032","ordinal":147340,"en":"And now became a sultan."},{"id":"semetey-1-2013:p0920:b004:l033","ordinal":147341,"en":"Of the Argyn and Kyrgyz,"},{"id":"semetey-1-2013:p0920:b004:l034","ordinal":147342,"en":"He joined what had been torn,"},{"id":"semetey-1-2013:p0920:b004:l035","ordinal":147343,"en":"And gathered what had been scattered."},{"id":"semetey-1-2013:p0920:b004:l036","ordinal":147344,"en":"All his twelve bodily members grew complete."},{"id":"semetey-1-2013:p0920:b004:l037","ordinal":147345,"en":"Manas, who went to the other world—"},{"id":"semetey-1-2013:p0920:b004:l038","ordinal":147346,"en":"A hero had arisen fully equal to him."},{"id":"semetey-1-2013:p0920:b004:l039","ordinal":147347,"en":"If you ask about the boy,"},{"id":"semetey-1-2013:p0921:b003:l001","ordinal":147348,"en":"His forefather Tugol Khan"},{"id":"semetey-1-2013:p0921:b003:l002","ordinal":147349,"en":"Had been blessed by Khizr from the beginning."},{"id":"semetey-1-2013:p0921:b003:l003","ordinal":147350,"en":"His roots were in the line of saints."},{"id":"semetey-1-2013:p0921:b003:l004","ordinal":147351,"en":"His distant ancestor was Boyon Khan;"},{"id":"semetey-1-2013:p0921:b003:l005","ordinal":147352,"en":"From Boyon Khan came Chayan Khan,"},{"id":"semetey-1-2013:p0921:b003:l006","ordinal":147353,"en":"From Chayan Khan, Bala Khan."},{"id":"semetey-1-2013:p0921:b003:l007","ordinal":147354,"en":"Bala Khan's hero,"},{"id":"semetey-1-2013:p0921:b003:l008","ordinal":147355,"en":"Who never drew back from what he faced,"},{"id":"semetey-1-2013:p0921:b003:l009","ordinal":147356,"en":"Who never turned away from death,"},{"id":"semetey-1-2013:p0921:b003:l010","ordinal":147357,"en":"Was Ogoy Khan, born a warrior."},{"id":"semetey-1-2013:p0921:b003:l011","ordinal":147358,"en":"High-browed and fierce in wrath,"},{"id":"semetey-1-2013:p0921:b003:l012","ordinal":147359,"en":"He too laid much of China low."},{"id":"semetey-1-2013:p0921:b003:l013","ordinal":147360,"en":"He brought strife to many places,"},{"id":"semetey-1-2013:p0921:b003:l014","ordinal":147361,"en":"Broke royal courts and took spoils,"},{"id":"semetey-1-2013:p0921:b003:l015","ordinal":147362,"en":"Saw deserts where no soul traveled,"},{"id":"semetey-1-2013:p0921:b003:l016","ordinal":147363,"en":"Roamed the world and saw its lands."},{"id":"semetey-1-2013:p0921:b003:l017","ordinal":147364,"en":"He traveled along the rivers."},{"id":"semetey-1-2013:p0921:b003:l018","ordinal":147365,"en":"Before impetuous Ogoy,"},{"id":"semetey-1-2013:p0921:b003:l019","ordinal":147366,"en":"Those who faced him crawled."},{"id":"semetey-1-2013:p0921:b003:l020","ordinal":147367,"en":"It brought the Muslims joy;"},{"id":"semetey-1-2013:p0921:b003:l021","ordinal":147368,"en":"Renowned Ogoy rose as khan;"},{"id":"semetey-1-2013:p0921:b003:l022","ordinal":147369,"en":"His voice drove the life from men."},{"id":"semetey-1-2013:p0921:b003:l023","ordinal":147370,"en":"He had been lowly at the hearth,"},{"id":"semetey-1-2013:p0921:b003:l024","ordinal":147371,"en":"And grew mighty through sucking blood."},{"id":"semetey-1-2013:p0921:b003:l025","ordinal":147372,"en":"With that dear Ogoy Khan,"},{"id":"semetey-1-2013:p0921:b003:l026","ordinal":147373,"en":"Those who clashed were brought low."},{"id":"semetey-1-2013:p0921:b003:l027","ordinal":147374,"en":"From Ogoy Khan came Kara Khan;"},{"id":"semetey-1-2013:p0921:b003:l028","ordinal":147375,"en":"From ill-intentioned Zhakyp,"},{"id":"semetey-1-2013:p0921:b003:l029","ordinal":147376,"en":"From the dark, gray-maned hero,"},{"id":"semetey-1-2013:p0921:b003:l030","ordinal":147377,"en":"From renowned gray-maned Manas,"},{"id":"semetey-1-2013:p0921:b003:l031","ordinal":147378,"en":"Semetey was born with sacred might."},{"id":"semetey-1-2013:p0921:b003:l032","ordinal":147379,"en":"Zhylgynduu and Talas became his land;"},{"id":"semetey-1-2013:p0921:b003:l033","ordinal":147380,"en":"A hero named Semetey arose."},{"id":"semetey-1-2013:p0921:b003:l034","ordinal":147381,"en":"Before, to Temir Khan's city"},{"id":"semetey-1-2013:p0921:b003:l035","ordinal":147382,"en":"He had wandered and suffered humiliation."},{"id":"semetey-1-2013:p0921:b003:l036","ordinal":147383,"en":"Semetey found his lineage,"},{"id":"semetey-1-2013:p0921:b003:l037","ordinal":147384,"en":"Came to Talas and grew mighty,"},{"id":"semetey-1-2013:p0921:b003:l038","ordinal":147385,"en":"And among the Argyn and Kyrgyz"},{"id":"semetey-1-2013:p0921:b003:l039","ordinal":147386,"en":"Stood as a fortress."},{"id":"semetey-1-2013:p0921:b005:l001","ordinal":147387,"en":"Of the Argyn and Kyrgyz,"},{"id":"semetey-1-2013:p0921:b005:l002","ordinal":147388,"en":"Those left alive after the deaths said:"},{"id":"semetey-1-2013:p0921:b005:l003","ordinal":147389,"en":"“Semetey has become sultan;"},{"id":"semetey-1-2013:p0921:b005:l004","ordinal":147390,"en":"He has settled once more upon his seat."},{"id":"semetey-1-2013:p0921:b005:l005","ordinal":147391,"en":"The thin horses have grown fat,"},{"id":"semetey-1-2013:p0921:b005:l006","ordinal":147392,"en":"The hungry bellies have been filled."},{"id":"semetey-1-2013:p0921:b005:l007","ordinal":147393,"en":"Now things have turned out well.”"},{"id":"semetey-1-2013:p0921:b005:l008","ordinal":147394,"en":"He made Talas his homeland,"},{"id":"semetey-1-2013:p0921:b005:l009","ordinal":147395,"en":"Gathered the scattered into a people,"},{"id":"semetey-1-2013:p0921:b005:l010","ordinal":147396,"en":"Made the grieving folk a people."},{"id":"semetey-1-2013:p0921:b005:l011","ordinal":147397,"en":"To the poor who came without livestock,"},{"id":"semetey-1-2013:p0921:b005:l012","ordinal":147398,"en":"There are six horses on the hill"},{"id":"semetey-1-2013:p0921:b005:l013","ordinal":147399,"en":"He allotted shares and made them wealthy,"},{"id":"semetey-1-2013:p0921:b005:l014","ordinal":147400,"en":"And thus set their hearts at ease."},{"id":"semetey-1-2013:p0921:b005:l015","ordinal":147401,"en":"When I wore at a jaunty tilt"},{"id":"semetey-1-2013:p0921:b005:l016","ordinal":147402,"en":"And taken shelter there."},{"id":"semetey-1-2013:p0921:b005:l017","ordinal":147403,"en":"Maintaining a royal court, a khan,"},{"id":"semetey-1-2013:p0921:b005:l018","ordinal":147404,"en":"He became a man securely established."},{"id":"semetey-1-2013:p0921:b005:l019","ordinal":147405,"en":"His anxious heart relaxed,"},{"id":"semetey-1-2013:p0921:b005:l020","ordinal":147406,"en":"Everything is opened,"},{"id":"semetey-1-2013:p0921:b005:l021","ordinal":147407,"en":"His troubled sorrow healed,"},{"id":"semetey-1-2013:p0921:b005:l022","ordinal":147408,"en":"All the villains vanished."},{"id":"semetey-1-2013:p0921:b005:l023","ordinal":147409,"en":"The bold son of Manas"},{"id":"semetey-1-2013:p0921:b005:l024","ordinal":147410,"en":"Had come to live in this way."},{"id":"semetey-1-2013:p0921:b005:l025","ordinal":147411,"en":"Like a deep-rooted, towering willow,"},{"id":"semetey-1-2013:p0921:b005:l026","ordinal":147412,"en":"Semetey had come from Bukhara,"},{"id":"semetey-1-2013:p0921:b005:l027","ordinal":147413,"en":"And over the Argyn and Kyrgyz"},{"id":"semetey-1-2013:p0921:b005:l028","ordinal":147414,"en":"Become governor, sultan and khan."},{"id":"semetey-1-2013:p0921:b005:l029","ordinal":147415,"en":"Taking the boy as their protector,"},{"id":"semetey-1-2013:p0921:b005:l030","ordinal":147416,"en":"When Argyn and Kyrgyz sought the lowlands,"},{"id":"semetey-1-2013:p0921:b005:l031","ordinal":147417,"en":"They had settled there."},{"id":"semetey-1-2013:p0921:b005:l032","ordinal":147418,"en":"Spirits by day, meat by night—"},{"id":"semetey-1-2013:p0921:b005:l033","ordinal":147419,"en":"That was how things had become."},{"id":"semetey-1-2013:p0921:b005:l034","ordinal":147420,"en":"All of the Kyrgyz,"},{"id":"semetey-1-2013:p0921:b005:l035","ordinal":147421,"en":"The young and the old,"},{"id":"semetey-1-2013:p0921:b005:l036","ordinal":147422,"en":"Drank kumis and courted girls,"},{"id":"semetey-1-2013:p0921:b005:l037","ordinal":147423,"en":"In many games and entertainments"},{"id":"semetey-1-2013:p0921:b005:l038","ordinal":147424,"en":"They were immersed."},{"id":"semetey-1-2013:p0921:b005:l039","ordinal":147425,"en":"Racing horses, playing ordo,"},{"id":"semetey-1-2013:p0922:b003:l001","ordinal":147426,"en":"In entertainments such as these"},{"id":"semetey-1-2013:p0922:b003:l002","ordinal":147427,"en":"They were immersed."},{"id":"semetey-1-2013:p0922:b003:l003","ordinal":147428,"en":"Riding horses in their third year, flying hawks,"},{"id":"semetey-1-2013:p0922:b003:l004","ordinal":147429,"en":"They played in wild delight."},{"id":"semetey-1-2013:p0922:b003:l005","ordinal":147430,"en":"An entire otter pelt"},{"id":"semetey-1-2013:p0922:b003:l006","ordinal":147431,"en":"They split in two,"},{"id":"semetey-1-2013:p0922:b003:l007","ordinal":147432,"en":"And trimmed their trouser legs with it."},{"id":"semetey-1-2013:p0922:b003:l008","ordinal":147433,"en":"At Zhylgynduu, Ken-Kol and broad Talas"},{"id":"semetey-1-2013:p0922:b003:l009","ordinal":147434,"en":"They settled in bustling throngs."},{"id":"semetey-1-2013:p0922:b004:l001","ordinal":147435,"en":"Even those calling themselves the poorest"},{"id":"semetey-1-2013:p0922:b004:l002","ordinal":147436,"en":"Tethered a thousand foals apiece."},{"id":"semetey-1-2013:p0922:b004:l003","ordinal":147437,"en":"Thus increasing their splendor,"},{"id":"semetey-1-2013:p0922:b004:l004","ordinal":147438,"en":"From pale, fresh kumis"},{"id":"semetey-1-2013:p0922:b004:l005","ordinal":147439,"en":"They had spirits distilled in streams."},{"id":"semetey-1-2013:p0922:b004:l006","ordinal":147440,"en":"Such were the Kyrgyz people's pleasures."},{"id":"semetey-1-2013:p0922:b004:l007","ordinal":147441,"en":"Now let us tell another tale:"},{"id":"semetey-1-2013:p0922:b004:l008","ordinal":147442,"en":"Semetey and Chynkozho,"},{"id":"semetey-1-2013:p0922:b004:l009","ordinal":147443,"en":"And the bitter quarrel that arose!"},{"id":"semetey-1-2013:p0922:b006:l001","ordinal":147444,"en":"On Friday's sacred Night of Power,"},{"id":"semetey-1-2013:p0922:b006:l002","ordinal":147445,"en":"In Semetey's royal court"},{"id":"semetey-1-2013:p0922:b006:l003","ordinal":147446,"en":"Was his aged uncle Bakai."},{"id":"semetey-1-2013:p0922:b006:l004","ordinal":147447,"en":"Along Uch-Koshoi,"},{"id":"semetey-1-2013:p0922:b006:l005","ordinal":147448,"en":"The Argyn khan, Sary Khan,"},{"id":"semetey-1-2013:p0922:b006:l006","ordinal":147449,"en":"Was there too, to offer counsel."},{"id":"semetey-1-2013:p0922:b006:l007","ordinal":147450,"en":"His mother Kanykei—"},{"id":"semetey-1-2013:p0922:b006:l008","ordinal":147451,"en":"A saint in a white headscarf—"},{"id":"semetey-1-2013:p0922:b006:l009","ordinal":147452,"en":"His unfortunate mother Kanykei was there."},{"id":"semetey-1-2013:p0922:b006:l010","ordinal":147453,"en":"All the wise khans were there."},{"id":"semetey-1-2013:p0922:b006:l011","ordinal":147454,"en":"Bringing his forty treasury guards,"},{"id":"semetey-1-2013:p0922:b006:l012","ordinal":147455,"en":"An inheritance left by Manas,"},{"id":"semetey-1-2013:p0922:b006:l013","ordinal":147456,"en":"Who had stirred the stars in heaven,"}]
