[{"id":"seytek-2012:p0950:b003:l014","ordinal":367617,"en":"Lions who sought combat had died."},{"id":"seytek-2012:p0950:b003:l015","ordinal":367618,"en":"He had begun savage battles,"},{"id":"seytek-2012:p0950:b003:l016","ordinal":367619,"en":"Renowned in name and fierce in venom;"},{"id":"seytek-2012:p0950:b003:l017","ordinal":367620,"en":"He leveled all who crossed him—"},{"id":"seytek-2012:p0950:b003:l018","ordinal":367621,"en":"At the sight of his wrath, abandon hope."},{"id":"seytek-2012:p0950:b003:l019","ordinal":367622,"en":"Yet on that day the madman’s"},{"id":"seytek-2012:p0950:b003:l020","ordinal":367623,"en":"Evil purpose came undone."},{"id":"seytek-2012:p0950:b003:l021","ordinal":367624,"en":"Seized by fury,"},{"id":"seytek-2012:p0950:b003:l022","ordinal":367625,"en":"Sparing no precious life,"},{"id":"seytek-2012:p0950:b003:l023","ordinal":367626,"en":"He cried out in anger,"},{"id":"seytek-2012:p0950:b003:l024","ordinal":367627,"en":"Shouting menacingly,"},{"id":"seytek-2012:p0950:b003:l025","ordinal":367628,"en":"Churning the blue heavens."},{"id":"seytek-2012:p0950:b003:l026","ordinal":367629,"en":"His spirit seethed and madness boiled;"},{"id":"seytek-2012:p0950:b003:l027","ordinal":367630,"en":"Raging, he ground his teeth,"},{"id":"seytek-2012:p0950:b003:l028","ordinal":367631,"en":"And doom boiled over the warrior who opposed him."},{"id":"seytek-2012:p0950:b003:l029","ordinal":367632,"en":"His form bristled and transformed,"},{"id":"seytek-2012:p0950:b003:l030","ordinal":367633,"en":"Revealing his intent to destroy."},{"id":"seytek-2012:p0950:b003:l031","ordinal":367634,"en":"Then Sarybay"},{"id":"seytek-2012:p0950:b003:l032","ordinal":367635,"en":"And the warrior Seytek"},{"id":"seytek-2012:p0950:b003:l033","ordinal":367636,"en":"Fought without sparing their lives,"},{"id":"seytek-2012:p0950:b003:l034","ordinal":367637,"en":"Drenching themselves in crimson blood."},{"id":"seytek-2012:p0950:b003:l035","ordinal":367638,"en":"They stood thrusting spears,"},{"id":"seytek-2012:p0950:b003:l036","ordinal":367639,"en":"Firing guns and drawing bows,"},{"id":"seytek-2012:p0950:b003:l037","ordinal":367640,"en":"Striking each other in furious combat,"},{"id":"seytek-2012:p0950:b003:l038","ordinal":367641,"en":"And hewing at one another with axes,"},{"id":"seytek-2012:p0950:b003:l039","ordinal":367642,"en":"Until the axes splintered apart"},{"id":"seytek-2012:p0950:b003:l040","ordinal":367643,"en":"And only their shafts remained in hand."},{"id":"seytek-2012:p0951:b002:l001","ordinal":367644,"en":"They clashed with swords,"},{"id":"seytek-2012:p0951:b002:l002","ordinal":367645,"en":"The swords shattered and splintered,"},{"id":"seytek-2012:p0951:b002:l003","ordinal":367646,"en":"Leaving only bare hilts."},{"id":"seytek-2012:p0951:b002:l004","ordinal":367647,"en":"They stood face-to-face,"},{"id":"seytek-2012:p0951:b002:l005","ordinal":367648,"en":"Striking each other with heavy blows,"},{"id":"seytek-2012:p0951:b002:l006","ordinal":367649,"en":"All were drenched in blood,"},{"id":"seytek-2012:p0951:b002:l007","ordinal":367650,"en":"Their arrow-proof coats and trousers"},{"id":"seytek-2012:p0951:b002:l008","ordinal":367651,"en":"Were utterly torn to shreds,"},{"id":"seytek-2012:p0951:b002:l009","ordinal":367652,"en":"Rent apart like saddle straps,"},{"id":"seytek-2012:p0951:b002:l010","ordinal":367653,"en":"All their strength was spent,"},{"id":"seytek-2012:p0951:b002:l011","ordinal":367654,"en":"Ribs were broken one upon another,"},{"id":"seytek-2012:p0951:b002:l012","ordinal":367655,"en":"So fierce was the ordeal, so great the battle,"},{"id":"seytek-2012:p0951:b002:l013","ordinal":367656,"en":"That no regret remained."},{"id":"seytek-2012:p0951:b002:l014","ordinal":367657,"en":"Unable to throw him from the saddle,"},{"id":"seytek-2012:p0951:b002:l015","ordinal":367658,"en":"Unable to defeat brave Seytek."},{"id":"seytek-2012:p0951:b002:l016","ordinal":367659,"en":"Such was Seytek’s state."},{"id":"seytek-2012:p0951:b002:l017","ordinal":367660,"en":"His valor was extraordinary,"},{"id":"seytek-2012:p0951:b002:l018","ordinal":367661,"en":"The young man’s bearing was exceptional,"},{"id":"seytek-2012:p0951:b002:l019","ordinal":367662,"en":"He was the gray-maned champion of his line."},{"id":"seytek-2012:p0951:b002:l020","ordinal":367663,"en":"When Sarybai unleashed his venom,"},{"id":"seytek-2012:p0951:b002:l021","ordinal":367664,"en":"Shouting as he thrust his spear,"},{"id":"seytek-2012:p0951:b002:l022","ordinal":367665,"en":"And each time he swung his battle-axe,"},{"id":"seytek-2012:p0951:b002:l023","ordinal":367666,"en":"The falcon favored by the spirits,"},{"id":"seytek-2012:p0951:b002:l024","ordinal":367667,"en":"That dear lion, proud as a cock,"},{"id":"seytek-2012:p0951:b002:l025","ordinal":367668,"en":"That steadfast hero, never stirred."},{"id":"seytek-2012:p0951:b002:l026","ordinal":367669,"en":"Behold how his fathers and forefathers"},{"id":"seytek-2012:p0951:b002:l027","ordinal":367670,"en":"Came to his aid."},{"id":"seytek-2012:p0951:b002:l028","ordinal":367671,"en":"The wandering saint Khydyr himself,"},{"id":"seytek-2012:p0951:b002:l029","ordinal":367672,"en":"If you mark it, stood beside him,"},{"id":"seytek-2012:p0951:b002:l030","ordinal":367673,"en":"And nine guardian spirits aided him."},{"id":"seytek-2012:p0951:b002:l031","ordinal":367674,"en":"When Sarybai spilled blood,"},{"id":"seytek-2012:p0951:b002:l032","ordinal":367675,"en":"They came and entered the fray:"},{"id":"seytek-2012:p0951:b002:l033","ordinal":367676,"en":"A black-mottled leopard"},{"id":"seytek-2012:p0951:b002:l034","ordinal":367677,"en":"Sprang at him from the flank,"},{"id":"seytek-2012:p0951:b002:l035","ordinal":367678,"en":"A bobtailed gray-maned lion"},{"id":"seytek-2012:p0951:b002:l036","ordinal":367679,"en":"Prepared to strike him head-on,"},{"id":"seytek-2012:p0951:b002:l037","ordinal":367680,"en":"And before the people a fierce tiger—"},{"id":"seytek-2012:p0951:b002:l038","ordinal":367681,"en":"No such being exists among my folk—"},{"id":"seytek-2012:p0951:b002:l039","ordinal":367682,"en":"Fought at Seytek’s side."},{"id":"seytek-2012:p0951:b002:l040","ordinal":367683,"en":"They kept the warrior occupied,"},{"id":"seytek-2012:p0951:b003:l001","ordinal":367684,"en":"And every mighty blow"},{"id":"seytek-2012:p0951:b003:l002","ordinal":367685,"en":"That warrior Sarybai struck,"},{"id":"seytek-2012:p0951:b003:l003","ordinal":367686,"en":"They intercepted before it reached him."},{"id":"seytek-2012:p0951:b003:l004","ordinal":367687,"en":"From his right side forty men"},{"id":"seytek-2012:p0951:b003:l005","ordinal":367688,"en":"Against that infidel Sarybai"},{"id":"seytek-2012:p0951:b003:l006","ordinal":367689,"en":"Leveled their spears in a row."},{"id":"seytek-2012:p0951:b003:l007","ordinal":367690,"en":"Khan Almambet and Chubak were there,"},{"id":"seytek-2012:p0951:b003:l008","ordinal":367691,"en":"Their mighty spirits joining him,"},{"id":"seytek-2012:p0951:b003:l009","ordinal":367692,"en":"Standing as support"},{"id":"seytek-2012:p0951:b003:l010","ordinal":367693,"en":"For young warrior Seytek."},{"id":"seytek-2012:p0951:b003:l011","ordinal":367694,"en":"“Seize him, my son, seize him,” they cried,"},{"id":"seytek-2012:p0951:b003:l012","ordinal":367695,"en":"“Finish him—do not leave him alive!"},{"id":"seytek-2012:p0951:b003:l013","ordinal":367696,"en":"Crush the belly of that villain"},{"id":"seytek-2012:p0951:b003:l014","ordinal":367697,"en":"Who boasts himself a warrior, like the belly of an ass!"},{"id":"seytek-2012:p0951:b003:l015","ordinal":367698,"en":"Gouge out both his eyes!"},{"id":"seytek-2012:p0951:b003:l016","ordinal":367699,"en":"Bring that bellowing wretch down"},{"id":"seytek-2012:p0951:b003:l017","ordinal":367700,"en":"And dash him to the ground!"},{"id":"seytek-2012:p0951:b003:l018","ordinal":367701,"en":"Smash his ribs and back"},{"id":"seytek-2012:p0951:b003:l019","ordinal":367702,"en":"Until they crack and splinter!"},{"id":"seytek-2012:p0951:b003:l020","ordinal":367703,"en":"Pour out his blood in torrents!"},{"id":"seytek-2012:p0951:b003:l021","ordinal":367704,"en":"Take that shameless swine"},{"id":"seytek-2012:p0951:b003:l022","ordinal":367705,"en":"And stretch him full-length!"},{"id":"seytek-2012:p0951:b003:l023","ordinal":367706,"en":"Strip away the villain’s pride,"},{"id":"seytek-2012:p0951:b003:l024","ordinal":367707,"en":"End that monster’s life,"},{"id":"seytek-2012:p0951:b003:l025","ordinal":367708,"en":"Gouge out both his eyes!"},{"id":"seytek-2012:p0951:b003:l026","ordinal":367709,"en":"If you are truly our beloved,"},{"id":"seytek-2012:p0951:b003:l027","ordinal":367710,"en":"Catch him and slaughter him!"},{"id":"seytek-2012:p0951:b003:l028","ordinal":367711,"en":"Strip away every last twitch,"},{"id":"seytek-2012:p0951:b003:l029","ordinal":367712,"en":"Bring the khan to his death,"},{"id":"seytek-2012:p0951:b003:l030","ordinal":367713,"en":"Bring the lord’s devices to nothing,"},{"id":"seytek-2012:p0951:b003:l031","ordinal":367714,"en":"Beat out his raging madness,"},{"id":"seytek-2012:p0951:b003:l032","ordinal":367715,"en":"And settle his account in full!"},{"id":"seytek-2012:p0951:b003:l033","ordinal":367716,"en":"Drive him steadily—do not rush!"},{"id":"seytek-2012:p0951:b003:l034","ordinal":367717,"en":"Pin him fast and let him not stir!”"},{"id":"seytek-2012:p0951:b003:l035","ordinal":367718,"en":"He steeped his steel in blood,"},{"id":"seytek-2012:p0951:b003:l036","ordinal":367719,"en":"Seeking a way to strike fiercely;"},{"id":"seytek-2012:p0951:b003:l037","ordinal":367720,"en":"The cunning swine had gone berserk."},{"id":"seytek-2012:p0951:b003:l038","ordinal":367721,"en":"Almambet, Chubak, and the forty men"},{"id":"seytek-2012:p0951:b003:l039","ordinal":367722,"en":"Raised their voices in a shout—"},{"id":"seytek-2012:p0951:b003:l040","ordinal":367723,"en":"Men who had departed for the other world,"},{"id":"seytek-2012:p0952:b002:l001","ordinal":367724,"en":"They remained beside lion-hearted Seytek,"},{"id":"seytek-2012:p0952:b002:l002","ordinal":367725,"en":"Serving as his comrades."},{"id":"seytek-2012:p0952:b002:l003","ordinal":367726,"en":"Much of this is false and much is true;"},{"id":"seytek-2012:p0952:b002:l004","ordinal":367727,"en":"No one has returned from there after seeing it."},{"id":"seytek-2012:p0952:b002:l005","ordinal":367728,"en":"Half is invention and half is truth;"},{"id":"seytek-2012:p0952:b002:l006","ordinal":367729,"en":"Unless the Creator himself knows,"},{"id":"seytek-2012:p0952:b002:l007","ordinal":367730,"en":"No one has come back from beyond."},{"id":"seytek-2012:p0952:b002:l008","ordinal":367731,"en":"How could we leave untold"},{"id":"seytek-2012:p0952:b002:l009","ordinal":367732,"en":"The tale of your forefathers?"},{"id":"seytek-2012:p0952:b002:l010","ordinal":367733,"en":"The tale has turned into a sorrowful song;"},{"id":"seytek-2012:p0952:b002:l011","ordinal":367734,"en":"Let us speak again of the ordeal"},{"id":"seytek-2012:p0952:b002:l012","ordinal":367735,"en":"Of that vanished warrior,"},{"id":"seytek-2012:p0952:b002:l013","ordinal":367736,"en":"Brave infidel Sarybai."},{"id":"seytek-2012:p0952:b002:l014","ordinal":367737,"en":"His thrusting spear must have pierced,"},{"id":"seytek-2012:p0952:b002:l015","ordinal":367738,"en":"His reach extended across the world;"},{"id":"seytek-2012:p0952:b002:l016","ordinal":367739,"en":"He crushed every man who grappled with him,"},{"id":"seytek-2012:p0952:b002:l017","ordinal":367740,"en":"His strength swelled and overflowed,"},{"id":"seytek-2012:p0952:b002:l018","ordinal":367741,"en":"And in his fury he overran"},{"id":"seytek-2012:p0952:b002:l019","ordinal":367742,"en":"The whole wide world."},{"id":"seytek-2012:p0952:b002:l020","ordinal":367743,"en":"Almambet’s son Külchoro,"},{"id":"seytek-2012:p0952:b002:l021","ordinal":367744,"en":"In the battle of the day before,"},{"id":"seytek-2012:p0952:b002:l022","ordinal":367745,"en":"Had fought for seven days"},{"id":"seytek-2012:p0952:b002:l023","ordinal":367746,"en":"And taken wounds in seven places;"},{"id":"seytek-2012:p0952:b002:l024","ordinal":367747,"en":"With scarcely a spark of life,"},{"id":"seytek-2012:p0952:b002:l025","ordinal":367748,"en":"His lungs pounding painfully,"},{"id":"seytek-2012:p0952:b002:l026","ordinal":367749,"en":"He bore anguish too great for his breast"},{"id":"seytek-2012:p0952:b002:l027","ordinal":367750,"en":"And wounds across much of his body."},{"id":"seytek-2012:p0952:b002:l028","ordinal":367751,"en":"A spear had lodged in his side;"},{"id":"seytek-2012:p0952:b002:l029","ordinal":367752,"en":"When he seized and wrenched its head,"},{"id":"seytek-2012:p0952:b002:l030","ordinal":367753,"en":"A blue flame flared."},{"id":"seytek-2012:p0952:b002:l031","ordinal":367754,"en":"He had raced upon Kulansur,"},{"id":"seytek-2012:p0952:b002:l032","ordinal":367755,"en":"And before fair Saikal"},{"id":"seytek-2012:p0952:b002:l033","ordinal":367756,"en":"Had vied steed against steed."},{"id":"seytek-2012:p0952:b002:l034","ordinal":367757,"en":"The great army was caught in the flames,"},{"id":"seytek-2012:p0952:b002:l035","ordinal":367758,"en":"And spirit-favored Külchoro"},{"id":"seytek-2012:p0952:b002:l036","ordinal":367759,"en":"Barely escaped death."},{"id":"seytek-2012:p0952:b002:l037","ordinal":367760,"en":"Because the mighty Kyrgyz host was there,"},{"id":"seytek-2012:p0952:b002:l038","ordinal":367761,"en":"Drawing near in a darkened mass, he was saved."},{"id":"seytek-2012:p0952:b002:l039","ordinal":367762,"en":"Before this, Sarybai’s"},{"id":"seytek-2012:p0952:b002:l040","ordinal":367763,"en":"Dread power had become clear,"},{"id":"seytek-2012:p0952:b003:l001","ordinal":367764,"en":"And the people had despaired of life."},{"id":"seytek-2012:p0952:b003:l002","ordinal":367765,"en":"But then Manas appeared,"},{"id":"seytek-2012:p0952:b003:l003","ordinal":367766,"en":"Dazzling every heart,"},{"id":"seytek-2012:p0952:b003:l004","ordinal":367767,"en":"Looking vast as blue Song-Köl,"},{"id":"seytek-2012:p0952:b003:l005","ordinal":367768,"en":"His majesty striking terror into souls,"},{"id":"seytek-2012:p0952:b003:l006","ordinal":367769,"en":"Making the Kula horse beneath him"},{"id":"seytek-2012:p0952:b003:l007","ordinal":367770,"en":"Step proudly and high."},{"id":"seytek-2012:p0952:b003:l008","ordinal":367771,"en":"He dazzled every heart:"},{"id":"seytek-2012:p0952:b003:l009","ordinal":367772,"en":"The lion whose patron spirit lived,"},{"id":"seytek-2012:p0952:b003:l010","ordinal":367773,"en":"The youngest of the six heroes,"},{"id":"seytek-2012:p0952:b003:l011","ordinal":367774,"en":"A servant of almighty God."},{"id":"seytek-2012:p0952:b003:l012","ordinal":367775,"en":"He dazzled every heart,"},{"id":"seytek-2012:p0952:b003:l013","ordinal":367776,"en":"Appearing before their eyes as though alive."},{"id":"seytek-2012:p0952:b003:l014","ordinal":367777,"en":"The wandering saint Khydyr"},{"id":"seytek-2012:p0952:b003:l015","ordinal":367778,"en":"Came straight forward to lend aid,"},{"id":"seytek-2012:p0952:b003:l016","ordinal":367779,"en":"Leading the proud-stepping Kula horse,"},{"id":"seytek-2012:p0952:b003:l017","ordinal":367780,"en":"With twelve noble warriors in his train."},{"id":"seytek-2012:p0952:b003:l018","ordinal":367781,"en":"He dazzled every heart,"},{"id":"seytek-2012:p0952:b003:l019","ordinal":367782,"en":"Appearing like a lofty blue mountain pass."},{"id":"seytek-2012:p0952:b003:l020","ordinal":367783,"en":"Such was the man’s form."},{"id":"seytek-2012:p0952:b003:l021","ordinal":367784,"en":"He seemed to fill the sky,"},{"id":"seytek-2012:p0952:b003:l022","ordinal":367785,"en":"Appearing as though alive,"},{"id":"seytek-2012:p0952:b003:l023","ordinal":367786,"en":"Like an alloy"},{"id":"seytek-2012:p0952:b003:l024","ordinal":367787,"en":"Of gold and silver,"},{"id":"seytek-2012:p0952:b003:l025","ordinal":367788,"en":"Like the moon and sun"},{"id":"seytek-2012:p0952:b003:l026","ordinal":367789,"en":"United in a single being."},{"id":"seytek-2012:p0952:b003:l027","ordinal":367790,"en":"Look closely upon this marvel:"},{"id":"seytek-2012:p0952:b003:l028","ordinal":367791,"en":"He seemed able to pass through the spindle-narrow cleft"},{"id":"seytek-2012:p0952:b003:l029","ordinal":367792,"en":"Of a gaping gorge."},{"id":"seytek-2012:p0952:b003:l030","ordinal":367793,"en":"His vast majesty rose like a glacier;"},{"id":"seytek-2012:p0952:b003:l031","ordinal":367794,"en":"Not merely Sarybai, but the whole world"},{"id":"seytek-2012:p0952:b003:l032","ordinal":367795,"en":"He seemed able to conquer if it opposed him."},{"id":"seytek-2012:p0952:b003:l033","ordinal":367796,"en":"The horse he rode was Akkula,"},{"id":"seytek-2012:p0952:b003:l034","ordinal":367797,"en":"Akkula, the racehorse swift as an arrow."},{"id":"seytek-2012:p0952:b003:l035","ordinal":367798,"en":"Manas loomed enormous as a hill,"},{"id":"seytek-2012:p0952:b003:l036","ordinal":367799,"en":"Broad and towering as a blue mountain spur."},{"id":"seytek-2012:p0952:b003:l037","ordinal":367800,"en":"The living spirit of your forefather"},{"id":"seytek-2012:p0952:b003:l038","ordinal":367801,"en":"Stood grandly as his companion,"},{"id":"seytek-2012:p0952:b003:l039","ordinal":367802,"en":"Taking his place at his right hand."},{"id":"seytek-2012:p0952:b003:l040","ordinal":367803,"en":"His destiny was to wreak destruction—"},{"id":"seytek-2012:p0953:b002:l001","ordinal":367804,"en":"Such was the wonder they beheld."},{"id":"seytek-2012:p0953:b002:l002","ordinal":367805,"en":"His forefather, mighty Manas,"},{"id":"seytek-2012:p0953:b002:l003","ordinal":367806,"en":"Cried, “Stand firm beside my child!”"},{"id":"seytek-2012:p0953:b002:l004","ordinal":367807,"en":"Shouting in a ringing voice,"},{"id":"seytek-2012:p0953:b002:l005","ordinal":367808,"en":"He reached out and laid hold,"},{"id":"seytek-2012:p0953:b002:l006","ordinal":367809,"en":"Supporting him beneath the arm."},{"id":"seytek-2012:p0953:b002:l007","ordinal":367810,"en":"He set right what had been broken,"},{"id":"seytek-2012:p0953:b002:l008","ordinal":367811,"en":"Rejoined what had been severed,"},{"id":"seytek-2012:p0953:b002:l009","ordinal":367812,"en":"And gathered what had been scattered."},{"id":"seytek-2012:p0953:b002:l010","ordinal":367813,"en":"“May the ancestral spirits be my companions,”"},{"id":"seytek-2012:p0953:b002:l011","ordinal":367814,"en":"Sarybai had once prayed."},{"id":"seytek-2012:p0953:b002:l012","ordinal":367815,"en":"But now, “Spirit of my true forefather,"},{"id":"seytek-2012:p0953:b002:l013","ordinal":367816,"en":"Drive back the bloodthirsty son!"},{"id":"seytek-2012:p0953:b002:l014","ordinal":367817,"en":"Drive all five claws of the spirit"},{"id":"seytek-2012:p0953:b002:l015","ordinal":367818,"en":"Into the flank"},{"id":"seytek-2012:p0953:b002:l016","ordinal":367819,"en":"Of that vaunting boar!”"},{"id":"seytek-2012:p0953:b002:l017","ordinal":367820,"en":"Then a dazzling vision appeared:"},{"id":"seytek-2012:p0953:b002:l018","ordinal":367821,"en":"Gray-maned Manas, the leopard,"},{"id":"seytek-2012:p0953:b002:l019","ordinal":367822,"en":"Seemed like a battle standard"},{"id":"seytek-2012:p0953:b002:l020","ordinal":367823,"en":"To young warrior Seytek."},{"id":"seytek-2012:p0953:b002:l021","ordinal":367824,"en":"“Drive on, my son, drive on!"},{"id":"seytek-2012:p0953:b002:l022","ordinal":367825,"en":"Seize that slave before you!"},{"id":"seytek-2012:p0953:b002:l023","ordinal":367826,"en":"Terrify the life from him!"},{"id":"seytek-2012:p0953:b002:l024","ordinal":367827,"en":"Do not spare him from death—"},{"id":"seytek-2012:p0953:b002:l025","ordinal":367828,"en":"Steep your spear in blood!”"},{"id":"seytek-2012:p0953:b002:l026","ordinal":367829,"en":"With Maral at their head, forty men"},{"id":"seytek-2012:p0953:b002:l027","ordinal":367830,"en":"Shouted before him,"},{"id":"seytek-2012:p0953:b002:l028","ordinal":367831,"en":"And when he looked, they had become tigers."},{"id":"seytek-2012:p0953:b002:l029","ordinal":367832,"en":"A lion opened its jaws,"},{"id":"seytek-2012:p0953:b002:l030","ordinal":367833,"en":"And the spirit of my heroic father Manas"},{"id":"seytek-2012:p0953:b002:l031","ordinal":367834,"en":"Grasped Seytek by the hem,"},{"id":"seytek-2012:p0953:b002:l032","ordinal":367835,"en":"Holding and supporting him without release."},{"id":"seytek-2012:p0953:b002:l033","ordinal":367836,"en":"“Do not fear when battle comes!”"},{"id":"seytek-2012:p0953:b002:l034","ordinal":367837,"en":"Thus brave Seytek"},{"id":"seytek-2012:p0953:b002:l035","ordinal":367838,"en":"Launched a furious struggle with him."},{"id":"seytek-2012:p0953:b002:l036","ordinal":367839,"en":"May God never show us its like!"},{"id":"seytek-2012:p0953:b002:l037","ordinal":367840,"en":"Clashing their pinewood spears,"},{"id":"seytek-2012:p0953:b002:l038","ordinal":367841,"en":"Seytek and Sarybai"},{"id":"seytek-2012:p0953:b002:l039","ordinal":367842,"en":"Stood their ground and thrust at each other."},{"id":"seytek-2012:p0953:b002:l040","ordinal":367843,"en":"The earth broke and split,"},{"id":"seytek-2012:p0953:b004:l001","ordinal":367844,"en":"And all who saw it stood aghast;"},{"id":"seytek-2012:p0953:b004:l002","ordinal":367845,"en":"Their bosoms filled with clotted blood."},{"id":"seytek-2012:p0953:b004:l003","ordinal":367846,"en":"They struck ever harder,"},{"id":"seytek-2012:p0953:b004:l004","ordinal":367847,"en":"Thrusting face-to-face,"},{"id":"seytek-2012:p0953:b004:l005","ordinal":367848,"en":"Pressing knee against knee,"},{"id":"seytek-2012:p0953:b004:l006","ordinal":367849,"en":"Seizing each other’s collars and tugging,"},{"id":"seytek-2012:p0953:b004:l007","ordinal":367850,"en":"And whenever the gray-maned champions found an opening,"},{"id":"seytek-2012:p0953:b004:l008","ordinal":367851,"en":"They struck with their fists."},{"id":"seytek-2012:p0953:b004:l009","ordinal":367852,"en":"As the fierce conflict mounted,"},{"id":"seytek-2012:p0953:b004:l010","ordinal":367853,"en":"Those who drew close and saw them"},{"id":"seytek-2012:p0953:b004:l011","ordinal":367854,"en":"Spared not their lives,"},{"id":"seytek-2012:p0953:b004:l012","ordinal":367855,"en":"But grappled collar-to-collar."},{"id":"seytek-2012:p0953:b004:l013","ordinal":367856,"en":"Their coats were torn to tatters,"},{"id":"seytek-2012:p0953:b004:l014","ordinal":367857,"en":"Their bodies were gashed all over,"},{"id":"seytek-2012:p0953:b004:l015","ordinal":367858,"en":"And at every place they struck,"},{"id":"seytek-2012:p0953:b004:l016","ordinal":367859,"en":"Their clenched hands filled with flesh."},{"id":"seytek-2012:p0953:b004:l017","ordinal":367860,"en":"They butted like rams,"},{"id":"seytek-2012:p0953:b004:l018","ordinal":367861,"en":"Seizing each other’s collars and tugging."},{"id":"seytek-2012:p0953:b004:l019","ordinal":367862,"en":"The savage struggle mounted,"},{"id":"seytek-2012:p0953:b004:l020","ordinal":367863,"en":"They planted their feet and wrestled,"},{"id":"seytek-2012:p0953:b004:l021","ordinal":367864,"en":"And again the champions came to grips,"},{"id":"seytek-2012:p0953:b004:l022","ordinal":367865,"en":"Spitting at one another."},{"id":"seytek-2012:p0953:b004:l023","ordinal":367866,"en":"Spears, swords, and battle-axes"},{"id":"seytek-2012:p0953:b004:l024","ordinal":367867,"en":"Were utterly shattered between them."},{"id":"seytek-2012:p0953:b004:l025","ordinal":367868,"en":"If you would see a marvel, behold this:"},{"id":"seytek-2012:p0953:b004:l026","ordinal":367869,"en":"The immense battle thundered,"},{"id":"seytek-2012:p0953:b004:l027","ordinal":367870,"en":"The wondrous tumult rose,"},{"id":"seytek-2012:p0953:b004:l028","ordinal":367871,"en":"As Sarybai and brave Seytek"},{"id":"seytek-2012:p0953:b004:l029","ordinal":367872,"en":"Thrust at one another face-to-face."}]
