[{"id":"semetey-1-2013:p0402:b004:l025","ordinal":107521,"en":"The beloved lion, like a rooster,"},{"id":"semetey-1-2013:p0402:b004:l026","ordinal":107522,"en":"Lamented in sorrow, burning within."},{"id":"semetey-1-2013:p0402:b004:l027","ordinal":107523,"en":"Agitated, unable to stand still,"},{"id":"semetey-1-2013:p0402:b004:l028","ordinal":107524,"en":"He made ready in his wrath."},{"id":"semetey-1-2013:p0402:b004:l029","ordinal":107525,"en":"Your leopard father mounted;"},{"id":"semetey-1-2013:p0402:b004:l030","ordinal":107526,"en":"Toward Karacha's Saikal,"},{"id":"semetey-1-2013:p0402:b004:l031","ordinal":107527,"en":"He set out to thrust his spear,"},{"id":"semetey-1-2013:p0402:b004:l032","ordinal":107528,"en":"The swift horses of the forty dignitaries,"},{"id":"semetey-1-2013:p0402:b004:l033","ordinal":107529,"en":"If the chance came, from Saikal"},{"id":"semetey-1-2013:p0402:b004:l034","ordinal":107530,"en":"To win them back,"},{"id":"semetey-1-2013:p0402:b004:l035","ordinal":107531,"en":"To gather khojas and mullahs,"},{"id":"semetey-1-2013:p0402:b004:l036","ordinal":107532,"en":"And, if he could overcome Saikal,"},{"id":"semetey-1-2013:p0402:b004:l037","ordinal":107533,"en":"To solemnize their marriage at high noon."},{"id":"semetey-1-2013:p0402:b004:l038","ordinal":107534,"en":"Furious, making ready,"},{"id":"semetey-1-2013:p0402:b004:l039","ordinal":107535,"en":"Toward Karacha's Saikal,"},{"id":"semetey-1-2013:p0403:b003:l001","ordinal":107536,"en":"Your leopard father rode out."},{"id":"semetey-1-2013:p0403:b003:l002","ordinal":107537,"en":"Seven banners brought from Mecca,"},{"id":"semetey-1-2013:p0403:b003:l003","ordinal":107538,"en":"He had set in seven places."},{"id":"semetey-1-2013:p0403:b003:l004","ordinal":107539,"en":"A white-gray mare brought from the Kyrgyz,"},{"id":"semetey-1-2013:p0403:b003:l005","ordinal":107540,"en":"He had led before him."},{"id":"semetey-1-2013:p0403:b003:l006","ordinal":107541,"en":"Your outstanding father Manas"},{"id":"semetey-1-2013:p0403:b003:l007","ordinal":107542,"en":"Had it offered as a moon-hoofed sacrifice."},{"id":"semetey-1-2013:p0403:b003:l008","ordinal":107543,"en":"He had the war drum beaten;"},{"id":"semetey-1-2013:p0403:b003:l009","ordinal":107544,"en":"He had the great drum struck."},{"id":"semetey-1-2013:p0403:b003:l010","ordinal":107545,"en":"The hearts of those who saw were shaken;"},{"id":"semetey-1-2013:p0403:b003:l011","ordinal":107546,"en":"Your fierce father loomed like an immense mountain."},{"id":"semetey-1-2013:p0403:b003:l012","ordinal":107547,"en":"Through haze upon the saddle-shaped ridge,"},{"id":"semetey-1-2013:p0403:b003:l013","ordinal":107548,"en":"He bent forward, scouting his way."},{"id":"semetey-1-2013:p0403:b003:l014","ordinal":107549,"en":"Against Karacha's Saikal,"},{"id":"semetey-1-2013:p0403:b003:l015","ordinal":107550,"en":"Your leopard father attacked."},{"id":"semetey-1-2013:p0403:b003:l016","ordinal":107551,"en":"They took turns thrusting spears;"},{"id":"semetey-1-2013:p0403:b003:l017","ordinal":107552,"en":"Karacha's Saikal"},{"id":"semetey-1-2013:p0403:b003:l018","ordinal":107553,"en":"The two exhausted one another."},{"id":"semetey-1-2013:p0403:b003:l019","ordinal":107554,"en":"Shouting, they thrust their spears;"},{"id":"semetey-1-2013:p0403:b003:l020","ordinal":107555,"en":"Neither could overcome the other."},{"id":"semetey-1-2013:p0403:b003:l021","ordinal":107556,"en":"Almambet and Bakai were not there;"},{"id":"semetey-1-2013:p0403:b003:l022","ordinal":107557,"en":"Your father fought alone."},{"id":"semetey-1-2013:p0403:b003:l023","ordinal":107558,"en":"Day and night, for many days,"},{"id":"semetey-1-2013:p0403:b003:l024","ordinal":107559,"en":"Neither could overcome the other."},{"id":"semetey-1-2013:p0403:b003:l025","ordinal":107560,"en":"When they went downhill,"},{"id":"semetey-1-2013:p0403:b003:l026","ordinal":107561,"en":"At Karacha's Saikal,"},{"id":"semetey-1-2013:p0403:b003:l027","ordinal":107562,"en":"Your father the khan struck five times,"},{"id":"semetey-1-2013:p0403:b003:l028","ordinal":107563,"en":"Breaking five spears in succession."},{"id":"semetey-1-2013:p0403:b003:l029","ordinal":107564,"en":"From the spur where the mountain ended,"},{"id":"semetey-1-2013:p0403:b003:l030","ordinal":107565,"en":"At your father, blood-shedding Khan Manas,"},{"id":"semetey-1-2013:p0403:b003:l031","ordinal":107566,"en":"Saikal came and struck four times,"},{"id":"semetey-1-2013:p0403:b003:l032","ordinal":107567,"en":"Breaking four spears in succession."},{"id":"semetey-1-2013:p0403:b003:l033","ordinal":107568,"en":"They stood and took their turns;"},{"id":"semetey-1-2013:p0403:b003:l034","ordinal":107569,"en":"Your father and Maiden Saikal"},{"id":"semetey-1-2013:p0403:b003:l035","ordinal":107570,"en":"Fought each other turn by turn."},{"id":"semetey-1-2013:p0403:b003:l036","ordinal":107571,"en":"They fought with axes;"},{"id":"semetey-1-2013:p0403:b003:l037","ordinal":107572,"en":"The axe heads shattered,"},{"id":"semetey-1-2013:p0403:b003:l038","ordinal":107573,"en":"Leaving the handles in their hands."},{"id":"semetey-1-2013:p0403:b003:l039","ordinal":107574,"en":"They fought with swords;"},{"id":"semetey-1-2013:p0403:b005:l001","ordinal":107575,"en":"All the swords shattered,"},{"id":"semetey-1-2013:p0403:b005:l002","ordinal":107576,"en":"Leaving the sheaths in their hands."},{"id":"semetey-1-2013:p0403:b005:l003","ordinal":107577,"en":"They grappled by the hems of their coats;"},{"id":"semetey-1-2013:p0403:b005:l004","ordinal":107578,"en":"At that time, the two heroes"},{"id":"semetey-1-2013:p0403:b005:l005","ordinal":107579,"en":"Exhausted one another."},{"id":"semetey-1-2013:p0403:b005:l006","ordinal":107580,"en":"Grasping collars, they pulled and struggled."},{"id":"semetey-1-2013:p0403:b005:l007","ordinal":107581,"en":"Maiden Saikal's Alkara"},{"id":"semetey-1-2013:p0403:b005:l008","ordinal":107582,"en":"And your father's Ak-kula,"},{"id":"semetey-1-2013:p0403:b005:l009","ordinal":107583,"en":"Under the strain of these champions,"},{"id":"semetey-1-2013:p0403:b005:l010","ordinal":107584,"en":"The beasts could not hold out;"},{"id":"semetey-1-2013:p0403:b005:l011","ordinal":107585,"en":"They sank knee-deep into sand."},{"id":"semetey-1-2013:p0403:b005:l012","ordinal":107586,"en":"Unable to endure by day,"},{"id":"semetey-1-2013:p0403:b005:l013","ordinal":107587,"en":"Taking no sleep at night,"},{"id":"semetey-1-2013:p0403:b005:l014","ordinal":107588,"en":"They stood through days and nights,"},{"id":"semetey-1-2013:p0403:b005:l015","ordinal":107589,"en":"Fighting without respite."},{"id":"semetey-1-2013:p0403:b005:l016","ordinal":107590,"en":"On the fescue-covered slope,"},{"id":"semetey-1-2013:p0403:b005:l017","ordinal":107591,"en":"Your father and Maiden Saikal,"},{"id":"semetey-1-2013:p0403:b005:l018","ordinal":107592,"en":"Where they faced each other,"},{"id":"semetey-1-2013:p0403:b005:l019","ordinal":107593,"en":"At the pass of Yrgaity,"},{"id":"semetey-1-2013:p0403:b005:l020","ordinal":107594,"en":"As they swayed back and forth,"},{"id":"semetey-1-2013:p0403:b005:l021","ordinal":107595,"en":"God struck Saikal."},{"id":"semetey-1-2013:p0403:b005:l022","ordinal":107596,"en":"That bitch, fierce Saikal,"},{"id":"semetey-1-2013:p0403:b005:l023","ordinal":107597,"en":"Stood gathering her strength."},{"id":"semetey-1-2013:p0403:b005:l024","ordinal":107598,"en":"Alkara beneath her,"},{"id":"semetey-1-2013:p0403:b005:l025","ordinal":107599,"en":"She whipped on either side,"},{"id":"semetey-1-2013:p0403:b005:l026","ordinal":107600,"en":"Spurring left and right,"},{"id":"semetey-1-2013:p0403:b005:l027","ordinal":107601,"en":"Shouting in fury,"},{"id":"semetey-1-2013:p0403:b005:l028","ordinal":107602,"en":"Crying 'Karacha!' as her battle cry."},{"id":"semetey-1-2013:p0403:b005:l029","ordinal":107603,"en":"She was sustained by Shai;"},{"id":"semetey-1-2013:p0403:b005:l030","ordinal":107604,"en":"She was a female lion, a mighty beast."},{"id":"semetey-1-2013:p0403:b005:l031","ordinal":107605,"en":"Your father Manas puffed and panted;"},{"id":"semetey-1-2013:p0403:b005:l032","ordinal":107606,"en":"Your warrior father could not bend down,"},{"id":"semetey-1-2013:p0403:b005:l033","ordinal":107607,"en":"For he had grown very fat."},{"id":"semetey-1-2013:p0403:b005:l034","ordinal":107608,"en":"Saikal came charging;"},{"id":"semetey-1-2013:p0403:b005:l035","ordinal":107609,"en":"The muscle about his ribs,"},{"id":"semetey-1-2013:p0403:b005:l036","ordinal":107610,"en":"She punched it as she swept past."},{"id":"semetey-1-2013:p0403:b005:l037","ordinal":107611,"en":"Coughing in great bursts,"},{"id":"semetey-1-2013:p0403:b005:l038","ordinal":107612,"en":"Like one stricken with grief,"},{"id":"semetey-1-2013:p0403:b005:l039","ordinal":107613,"en":"Your great hulking father Manas,"},{"id":"semetey-1-2013:p0404:b003:l001","ordinal":107614,"en":"Then she seized him;"},{"id":"semetey-1-2013:p0404:b003:l002","ordinal":107615,"en":"Maiden Saikal lifted him from his horse."},{"id":"semetey-1-2013:p0404:b003:l003","ordinal":107616,"en":"To throw him off his mount,"},{"id":"semetey-1-2013:p0404:b003:l004","ordinal":107617,"en":"Noble Saikal could not bring herself."},{"id":"semetey-1-2013:p0404:b003:l005","ordinal":107618,"en":"For bringing calamity upon the hero,"},{"id":"semetey-1-2013:p0404:b003:l006","ordinal":107619,"en":"Your warrior Saikal felt no shame."},{"id":"semetey-1-2013:p0404:b003:l007","ordinal":107620,"en":"Allah's sun grew overcast in the sky;"},{"id":"semetey-1-2013:p0404:b003:l008","ordinal":107621,"en":"Upon Maiden Saikal's head"},{"id":"semetey-1-2013:p0404:b003:l009","ordinal":107622,"en":"Sixty worries came at once:"},{"id":"semetey-1-2013:p0404:b003:l010","ordinal":107623,"en":"'This Khan Manas here"},{"id":"semetey-1-2013:p0404:b003:l011","ordinal":107624,"en":"Was a lion who slaughtered infidels;"},{"id":"semetey-1-2013:p0404:b003:l012","ordinal":107625,"en":"His fortune was complete."},{"id":"semetey-1-2013:p0404:b003:l013","ordinal":107626,"en":"When I looked within him,"},{"id":"semetey-1-2013:p0404:b003:l014","ordinal":107627,"en":"He was broader than the earth."},{"id":"semetey-1-2013:p0404:b003:l015","ordinal":107628,"en":"The youngest of six lions,"},{"id":"semetey-1-2013:p0404:b003:l016","ordinal":107629,"en":"God's beloved mortal,"},{"id":"semetey-1-2013:p0404:b003:l017","ordinal":107630,"en":"He was a mighty conquering warrior."},{"id":"semetey-1-2013:p0404:b003:l018","ordinal":107631,"en":"A soul like generous Sultan Manas,"},{"id":"semetey-1-2013:p0404:b003:l019","ordinal":107632,"en":"The Creator who fashions life"},{"id":"semetey-1-2013:p0404:b003:l020","ordinal":107633,"en":"Will not give again soon."},{"id":"semetey-1-2013:p0404:b003:l021","ordinal":107634,"en":"On my upland side are the Chinese;"},{"id":"semetey-1-2013:p0404:b003:l022","ordinal":107635,"en":"Above me are the Barang."},{"id":"semetey-1-2013:p0404:b003:l023","ordinal":107636,"en":"Many foes would contend with us."},{"id":"semetey-1-2013:p0404:b003:l024","ordinal":107637,"en":"\"A woman speared Manas,\" they will say."},{"id":"semetey-1-2013:p0404:b003:l025","ordinal":107638,"en":"A people of forty tribes:"},{"id":"semetey-1-2013:p0404:b003:l026","ordinal":107639,"en":"Will God strike the Chinese?"},{"id":"semetey-1-2013:p0404:b003:l027","ordinal":107640,"en":"He was the lion of the Muslims;"},{"id":"semetey-1-2013:p0404:b003:l028","ordinal":107641,"en":"Will Islam's backbone break?"},{"id":"semetey-1-2013:p0404:b003:l029","ordinal":107642,"en":"Konurbai in Kakan,"},{"id":"semetey-1-2013:p0404:b003:l030","ordinal":107643,"en":"Will he come pouring in"},{"id":"semetey-1-2013:p0404:b003:l031","ordinal":107644,"en":"And slaughter these Kyrgyz people?"},{"id":"semetey-1-2013:p0404:b003:l032","ordinal":107645,"en":"\"You acted fiercely,\" they will say;"},{"id":"semetey-1-2013:p0404:b003:l033","ordinal":107646,"en":"Will God strike me openly?"},{"id":"semetey-1-2013:p0404:b003:l034","ordinal":107647,"en":"The great Chinese people of forty tribes,"},{"id":"semetey-1-2013:p0404:b003:l035","ordinal":107648,"en":"If news reaches them and suddenly"},{"id":"semetey-1-2013:p0404:b003:l036","ordinal":107649,"en":"They come pouring in here,"},{"id":"semetey-1-2013:p0404:b003:l037","ordinal":107650,"en":"Unable to rescue them,"},{"id":"semetey-1-2013:p0404:b003:l038","ordinal":107651,"en":"Will my fortune plainly break?"},{"id":"semetey-1-2013:p0404:b003:l039","ordinal":107652,"en":"Will the people know my dog's deed?"},{"id":"semetey-1-2013:p0404:b004:l001","ordinal":107653,"en":"On the dawn of Judgment Day,"},{"id":"semetey-1-2013:p0404:b004:l002","ordinal":107654,"en":"If a Muslim looks upon it,"},{"id":"semetey-1-2013:p0404:b004:l003","ordinal":107655,"en":"Will they make a black donkey of me?"},{"id":"semetey-1-2013:p0404:b004:l004","ordinal":107656,"en":"Shoeing his white-gray horse,"},{"id":"semetey-1-2013:p0404:b004:l005","ordinal":107657,"en":"He was the lion of the Muslims."},{"id":"semetey-1-2013:p0404:b004:l006","ordinal":107658,"en":"\"You caused such suffering,\" he will say;"},{"id":"semetey-1-2013:p0404:b004:l007","ordinal":107659,"en":"Will he leave me, the unfortunate one, alone,"},{"id":"semetey-1-2013:p0404:b004:l008","ordinal":107660,"en":"Seizing my collar in a place of peril?"},{"id":"semetey-1-2013:p0404:b004:l009","ordinal":107661,"en":"He was a lion who laid infidels low;"},{"id":"semetey-1-2013:p0404:b004:l010","ordinal":107662,"en":"His fortune was complete.'"},{"id":"semetey-1-2013:p0404:b004:l011","ordinal":107663,"en":"So Maiden Saikal thought then."},{"id":"semetey-1-2013:p0404:b004:l012","ordinal":107664,"en":"Because of Judgment,"},{"id":"semetey-1-2013:p0404:b004:l013","ordinal":107665,"en":"And because that wretched hell exists,"},{"id":"semetey-1-2013:p0404:b004:l014","ordinal":107666,"en":"Your father Sultan Manas"},{"id":"semetey-1-2013:p0404:b004:l015","ordinal":107667,"en":"She set back upon his horse."},{"id":"semetey-1-2013:p0404:b004:l016","ordinal":107668,"en":"Just as she was doing so,"},{"id":"semetey-1-2013:p0404:b004:l017","ordinal":107669,"en":"Riding the horse Aisarala,"},{"id":"semetey-1-2013:p0404:b004:l018","ordinal":107670,"en":"Wearing yellow leather trousers,"},{"id":"semetey-1-2013:p0404:b004:l019","ordinal":107671,"en":"Carrying a spear without a tuft,"},{"id":"semetey-1-2013:p0404:b004:l020","ordinal":107672,"en":"A naked sword strapped at his side,"},{"id":"semetey-1-2013:p0404:b004:l021","ordinal":107673,"en":"Who fled darkness and became pure,"},{"id":"semetey-1-2013:p0404:b004:l022","ordinal":107674,"en":"Who turned away from the dark faith,"},{"id":"semetey-1-2013:p0404:b004:l023","ordinal":107675,"en":"A sharer of wealth while alive,"},{"id":"semetey-1-2013:p0404:b004:l024","ordinal":107676,"en":"A brother in faith when dead,"},{"id":"semetey-1-2013:p0404:b004:l025","ordinal":107677,"en":"One in soul when riding on raids,"},{"id":"semetey-1-2013:p0404:b004:l026","ordinal":107678,"en":"One in blood when entering battle,"},{"id":"semetey-1-2013:p0404:b004:l027","ordinal":107679,"en":"Sharing livestock while alive,"},{"id":"semetey-1-2013:p0404:b004:l028","ordinal":107680,"en":"Six kinds of stars stirred in the sky:"},{"id":"semetey-1-2013:p0404:b004:l030","ordinal":107681,"en":"With your father Manas the lion,"},{"id":"semetey-1-2013:p0404:b004:l031","ordinal":107682,"en":"He had been a friend through sixty journeys."},{"id":"semetey-1-2013:p0404:b004:l032","ordinal":107683,"en":"Stirred by his valor,"},{"id":"semetey-1-2013:p0404:b004:l033","ordinal":107684,"en":"At the pass of Yrgaity,"},{"id":"semetey-1-2013:p0404:b004:l034","ordinal":107685,"en":"As they swayed back and forth,"},{"id":"semetey-1-2013:p0404:b004:l035","ordinal":107686,"en":"At Karacha's Saikal,"},{"id":"semetey-1-2013:p0404:b004:l036","ordinal":107687,"en":"Charging from her flank,"},{"id":"semetey-1-2013:p0404:b004:l037","ordinal":107688,"en":"Your leopard Almam came upon her."},{"id":"semetey-1-2013:p0404:b004:l038","ordinal":107689,"en":"Striking Sarala on the thigh,"},{"id":"semetey-1-2013:p0404:b004:l039","ordinal":107690,"en":"Raising 'Khan Manas!' as his cry,"},{"id":"semetey-1-2013:p0405:b003:l001","ordinal":107691,"en":"He attacked Khan Saikal:"},{"id":"semetey-1-2013:p0405:b003:l002","ordinal":107692,"en":"“He was the lion who shattered the unbelievers,"},{"id":"semetey-1-2013:p0405:b003:l003","ordinal":107693,"en":"His world complete on every side."},{"id":"semetey-1-2013:p0405:b003:l004","ordinal":107694,"en":"You have struck my lord and made him sway—"},{"id":"semetey-1-2013:p0405:b003:l005","ordinal":107695,"en":"Woman, where did you come from?"},{"id":"semetey-1-2013:p0405:b003:l007","ordinal":107696,"en":"He was the lion who shattered China."},{"id":"semetey-1-2013:p0405:b003:l008","ordinal":107697,"en":"You struck my precious lord and grew arrogant—"},{"id":"semetey-1-2013:p0405:b003:l009","ordinal":107698,"en":"Woman, where did such a lion come from?"},{"id":"semetey-1-2013:p0405:b003:l011","ordinal":107699,"en":"Take your hand away!"},{"id":"semetey-1-2013:p0405:b003:l012","ordinal":107700,"en":"Now I shall do to you"},{"id":"semetey-1-2013:p0405:b003:l013","ordinal":107701,"en":"What no one has ever done!”"},{"id":"semetey-1-2013:p0405:b003:l014","ordinal":107702,"en":"Speaking thus, Almambet"},{"id":"semetey-1-2013:p0405:b003:l015","ordinal":107703,"en":"Charged at Saikal;"},{"id":"semetey-1-2013:p0405:b003:l016","ordinal":107704,"en":"They fought with spears upon the open plain."},{"id":"semetey-1-2013:p0405:b003:l017","ordinal":107705,"en":"There was no reckoning night or day."},{"id":"semetey-1-2013:p0405:b003:l018","ordinal":107706,"en":"Such is this filthy world!"},{"id":"semetey-1-2013:p0405:b003:l019","ordinal":107707,"en":"They wore one another out."},{"id":"semetey-1-2013:p0405:b003:l020","ordinal":107708,"en":"The dear lion suffered hardship;"},{"id":"semetey-1-2013:p0405:b003:l021","ordinal":107709,"en":"Your father, wolf-like Manas,"},{"id":"semetey-1-2013:p0405:b003:l022","ordinal":107710,"en":"They managed to rescue."},{"id":"semetey-1-2013:p0405:b003:l023","ordinal":107711,"en":"Hearing news from a messenger,"},{"id":"semetey-1-2013:p0405:b003:l024","ordinal":107712,"en":"I, your mother, dwelling in Talas,"},{"id":"semetey-1-2013:p0405:b003:l025","ordinal":107713,"en":"Heard that Karacha's Saikal"},{"id":"semetey-1-2013:p0405:b003:l026","ordinal":107714,"en":"Had overcome my wolf-like lord."},{"id":"semetey-1-2013:p0405:b003:l027","ordinal":107715,"en":"Hearing evil tidings in the rumors,"},{"id":"semetey-1-2013:p0405:b003:l028","ordinal":107716,"en":"I heard that formidable Saikal"},{"id":"semetey-1-2013:p0405:b003:l029","ordinal":107717,"en":"Had struck with her spear"},{"id":"semetey-1-2013:p0405:b003:l030","ordinal":107718,"en":"Your father Khan Manas, my wolf-like lord."},{"id":"semetey-1-2013:p0405:b003:l031","ordinal":107719,"en":"My wretched heart was torn,"},{"id":"semetey-1-2013:p0405:b003:l032","ordinal":107720,"en":"The tears poured from my eyes."},{"id":"semetey-1-2013:p0405:b003:l033","ordinal":107721,"en":"I could not rise, crying and wailing."},{"id":"semetey-1-2013:p0405:b003:l034","ordinal":107722,"en":"My strength of mind deserted me;"},{"id":"semetey-1-2013:p0405:b003:l035","ordinal":107723,"en":"I could find no smallest way out."},{"id":"semetey-1-2013:p0405:b003:l036","ordinal":107724,"en":"I had brought my khan to ruin,"},{"id":"semetey-1-2013:p0405:b003:l037","ordinal":107725,"en":"I had ruined my own condition."},{"id":"semetey-1-2013:p0405:b003:l038","ordinal":107726,"en":"My dear hair, thick as a saddle-girth,"},{"id":"semetey-1-2013:p0405:b003:l039","ordinal":107727,"en":"I bound tightly upon my crown."},{"id":"semetey-1-2013:p0405:b004:l001","ordinal":107728,"en":"My black, blaze-faced thoroughbred"},{"id":"semetey-1-2013:p0405:b004:l002","ordinal":107729,"en":"I saddled firmly and mounted."},{"id":"semetey-1-2013:p0405:b004:l003","ordinal":107730,"en":"I left Talas and journeyed on,"},{"id":"semetey-1-2013:p0405:b004:l004","ordinal":107731,"en":"Rode far, without sparing the horse."},{"id":"semetey-1-2013:p0405:b004:l005","ordinal":107732,"en":"I summered in Taragai."},{"id":"semetey-1-2013:p0405:b004:l006","ordinal":107733,"en":"When I reached Zhoo-Zhurok,"},{"id":"semetey-1-2013:p0405:b004:l007","ordinal":107734,"en":"I separated the young mares and tethered them for milking."},{"id":"semetey-1-2013:p0405:b004:l008","ordinal":107735,"en":"Because of your father,"},{"id":"semetey-1-2013:p0405:b004:l009","ordinal":107736,"en":"Because of the maiden Saikal,"},{"id":"semetey-1-2013:p0405:b004:l010","ordinal":107737,"en":"I, wretched and stricken with shame,"},{"id":"semetey-1-2013:p0405:b004:l011","ordinal":107738,"en":"Summered in that cold place."},{"id":"semetey-1-2013:p0405:b004:l012","ordinal":107739,"en":"My heart burned in secret."},{"id":"semetey-1-2013:p0405:b004:l013","ordinal":107740,"en":"To your empty-headed father"},{"id":"semetey-1-2013:p0405:b004:l014","ordinal":107741,"en":"I gave water, calling it kymyz."},{"id":"semetey-1-2013:p0405:b004:l015","ordinal":107742,"en":"The reason I gave it was this:"},{"id":"semetey-1-2013:p0405:b004:l016","ordinal":107743,"en":"That foolish wife Akylai,"},{"id":"semetey-1-2013:p0405:b004:l017","ordinal":107744,"en":"That witless wretch,"},{"id":"semetey-1-2013:p0405:b004:l018","ordinal":107745,"en":"Had sliced him horse-belly fat and given him honey,"},{"id":"semetey-1-2013:p0405:b004:l019","ordinal":107746,"en":"Sliced rump meat and given him neck fat,"},{"id":"semetey-1-2013:p0405:b004:l020","ordinal":107747,"en":"Fat lamb and a delicious head,"},{"id":"semetey-1-2013:p0405:b004:l021","ordinal":107748,"en":"Meat boiled through and through,"},{"id":"semetey-1-2013:p0405:b004:l022","ordinal":107749,"en":"Plenty of fattening food."},{"id":"semetey-1-2013:p0405:b004:l023","ordinal":107750,"en":"That witless mother of yours,"},{"id":"semetey-1-2013:p0405:b004:l024","ordinal":107751,"en":"Clinging constantly to Manas,"},{"id":"semetey-1-2013:p0405:b004:l025","ordinal":107752,"en":"Had made him terribly fat."},{"id":"semetey-1-2013:p0405:b004:l026","ordinal":107753,"en":"At the pass of Yrgaity,"},{"id":"semetey-1-2013:p0405:b004:l027","ordinal":107754,"en":"When they grappled to and fro,"},{"id":"semetey-1-2013:p0405:b004:l028","ordinal":107755,"en":"Your father, Khan Manas,"},{"id":"semetey-1-2013:p0405:b004:l029","ordinal":107756,"en":"Stood swollen with all that flesh."},{"id":"semetey-1-2013:p0405:b004:l030","ordinal":107757,"en":"Your father had grown so fat,"},{"id":"semetey-1-2013:p0405:b004:l031","ordinal":107758,"en":"So vast he could not bend."},{"id":"semetey-1-2013:p0405:b004:l032","ordinal":107759,"en":"Skillful Saikal struck him with her spear."},{"id":"semetey-1-2013:p0405:b004:l033","ordinal":107760,"en":"Your father had grown so fat"},{"id":"semetey-1-2013:p0405:b004:l034","ordinal":107761,"en":"That he could not bend."},{"id":"semetey-1-2013:p0405:b004:l035","ordinal":107762,"en":"In anguish I, poor soul, went there"},{"id":"semetey-1-2013:p0405:b004:l036","ordinal":107763,"en":"And summered in Taragai."},{"id":"semetey-1-2013:p0405:b004:l037","ordinal":107764,"en":"Without his knowing, with my own hands,"},{"id":"semetey-1-2013:p0405:b004:l038","ordinal":107765,"en":"I thus kept your foolish father,"},{"id":"semetey-1-2013:p0405:b004:l039","ordinal":107766,"en":"Manas, under restraint."},{"id":"semetey-1-2013:p0406:b003:l001","ordinal":107767,"en":"Into your father Sultan Manas"},{"id":"semetey-1-2013:p0406:b003:l002","ordinal":107768,"en":"I put a carving knife, as it were."},{"id":"semetey-1-2013:p0406:b003:l003","ordinal":107769,"en":"All the fat within him,"},{"id":"semetey-1-2013:p0406:b003:l004","ordinal":107770,"en":"I, your unfortunate mother,"},{"id":"semetey-1-2013:p0406:b003:l005","ordinal":107771,"en":"Removed by my own skill alone."},{"id":"semetey-1-2013:p0406:b003:l006","ordinal":107772,"en":"Ak-kula, the horse beneath him,"},{"id":"semetey-1-2013:p0406:b003:l007","ordinal":107773,"en":"I fed barley from a hanging feedbag,"},{"id":"semetey-1-2013:p0406:b003:l008","ordinal":107774,"en":"And trained him to a sweat each month."},{"id":"semetey-1-2013:p0406:b003:l009","ordinal":107775,"en":"I fed him barnyard millet from the rice fields,"},{"id":"semetey-1-2013:p0406:b003:l010","ordinal":107776,"en":"And trained him to a sweat every day."}]
