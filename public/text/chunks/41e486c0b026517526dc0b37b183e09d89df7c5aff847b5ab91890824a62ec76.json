[{"id":"sayakbay-ms-current144:pdf129:l006","ordinal":391937,"en":"Frightened by a demon, he recoiled,"},{"id":"sayakbay-ms-current144:pdf129:l007","ordinal":391938,"en":"Saying his gray turban was ready,"},{"id":"sayakbay-ms-current144:pdf129:l008","ordinal":391939,"en":"The hero’s wish,"},{"id":"sayakbay-ms-current144:pdf129:l009","ordinal":391940,"en":"Saying, “I shall spill Ak Joltoy’s blood,”"},{"id":"sayakbay-ms-current144:pdf129:l010","ordinal":391941,"en":"To cast the Kyrgyz down in disgrace,"},{"id":"sayakbay-ms-current144:pdf129:l011","ordinal":391942,"en":"They gathered like ringing bells,"},{"id":"sayakbay-ms-current144:pdf129:l012","ordinal":391943,"en":"To drive them toward that place,"},{"id":"sayakbay-ms-current144:pdf129:l013","ordinal":391944,"en":"Mighty Joltoy had indeed exerted his strength,"},{"id":"sayakbay-ms-current144:pdf129:l014","ordinal":391945,"en":"Chong Bilgich had rejoiced,"},{"id":"sayakbay-ms-current144:pdf129:l016","ordinal":391946,"en":"The great hound fixed its eyes upon the ground,"},{"id":"sayakbay-ms-current144:pdf129:l017","ordinal":391947,"en":"Upon that very hound,"},{"id":"sayakbay-ms-current144:pdf129:l019","ordinal":391948,"en":"The gray beast had no tooth that could break it,"},{"id":"sayakbay-ms-current144:pdf129:l020","ordinal":391949,"en":"It had no work of digging out marmots,"},{"id":"sayakbay-ms-current144:pdf129:l021","ordinal":391950,"en":"It had no weighty stone like a beard,"},{"id":"sayakbay-ms-current144:pdf129:l022","ordinal":391951,"en":"Hungry, it did not feed the boar,"},{"id":"sayakbay-ms-current144:pdf129:l023","ordinal":391952,"en":"The gray steppe did not bend,"},{"id":"sayakbay-ms-current144:pdf129:l024","ordinal":391953,"en":"Made by the Creator, it seemed exceptional,"},{"id":"sayakbay-ms-current144:pdf129:l025","ordinal":391954,"en":"A mighty child sent by God,"},{"id":"sayakbay-ms-current144:pdf129:l026","ordinal":391955,"en":"From his wrath, no blood remained,"},{"id":"sayakbay-ms-current144:pdf129:l027","ordinal":391956,"en":"No soul survived the hound he loosed,"},{"id":"sayakbay-ms-current144:pdf129:l028","ordinal":391957,"en":"Trusting in God, they called him a marksman,"},{"id":"sayakbay-ms-current144:pdf129:l029","ordinal":391958,"en":"Ak Joltoy delivered a mighty blow."},{"id":"sayakbay-ms-current144:pdf130:l001","ordinal":391959,"en":"His eyes had known much anxiety,"},{"id":"sayakbay-ms-current144:pdf130:l002","ordinal":391960,"en":"He encountered an evil giant,"},{"id":"sayakbay-ms-current144:pdf130:l003","ordinal":391961,"en":"You plead with God,"},{"id":"sayakbay-ms-current144:pdf130:l004","ordinal":391962,"en":"Asking that He Himself send aid,"},{"id":"sayakbay-ms-current144:pdf130:l005","ordinal":391963,"en":"From the wrath that had been invoked,"},{"id":"sayakbay-ms-current144:pdf130:l006","ordinal":391964,"en":"He longed as though ready to carry it off,"},{"id":"sayakbay-ms-current144:pdf130:l007","ordinal":391965,"en":"Without abandoning the heavenly command,"},{"id":"sayakbay-ms-current144:pdf130:l008","ordinal":391966,"en":"There are a thousand dark paradises,"},{"id":"sayakbay-ms-current144:pdf130:l009","ordinal":391967,"en":"The wrathful Bilgich left it behind,"},{"id":"sayakbay-ms-current144:pdf130:l010","ordinal":391968,"en":"Saying, “May the Creator Himself support us,”"},{"id":"sayakbay-ms-current144:pdf130:l011","ordinal":391969,"en":"Saying, “Be a shield to the lonely people,”"},{"id":"sayakbay-ms-current144:pdf130:l012","ordinal":391970,"en":"The spirits drew everything before their eyes,"},{"id":"sayakbay-ms-current144:pdf130:l015","ordinal":391971,"en":"The enraged Chong Bilgich,"},{"id":"sayakbay-ms-current144:pdf130:l016","ordinal":391972,"en":"The great racer was like a cloud,"},{"id":"sayakbay-ms-current144:pdf130:l017","ordinal":391973,"en":"His people were mortal men,"},{"id":"sayakbay-ms-current144:pdf130:l018","ordinal":391974,"en":"He came after beginning the task,"},{"id":"sayakbay-ms-current144:pdf130:l019","ordinal":391975,"en":"He saw the rising wrath,"},{"id":"sayakbay-ms-current144:pdf130:l020","ordinal":391976,"en":"His appearance was fierce and his venom strong,"},{"id":"sayakbay-ms-current144:pdf130:l021","ordinal":391977,"en":"His wrath was stronger than a shield,"},{"id":"sayakbay-ms-current144:pdf130:l022","ordinal":391978,"en":"He marked the head between the bay horse’s eyes,"},{"id":"sayakbay-ms-current144:pdf130:l023","ordinal":391979,"en":"Taking aim, sever the enemy’s life,"},{"id":"sayakbay-ms-current144:pdf130:l024","ordinal":391980,"en":"Ak Joltoy was noble,"},{"id":"sayakbay-ms-current144:pdf130:l025","ordinal":391981,"en":"Helpless, he turned to God,"},{"id":"sayakbay-ms-current144:pdf130:l026","ordinal":391982,"en":"Mighty Joltoy did not shrink from death,"},{"id":"sayakbay-ms-current144:pdf130:l027","ordinal":391983,"en":"God took his side firmly,"},{"id":"sayakbay-ms-current144:pdf130:l028","ordinal":391984,"en":"His ordained fate was laid upon him."},{"id":"sayakbay-ms-current144:pdf131:l001","ordinal":391985,"en":"May faith be granted when the soul departs,"},{"id":"sayakbay-ms-current144:pdf131:l002","ordinal":391986,"en":"He pleaded with the Creator."},{"id":"sayakbay-ms-current144:pdf131:l003","ordinal":391987,"en":"Kulan Sur beneath him,"},{"id":"sayakbay-ms-current144:pdf131:l005","ordinal":391988,"en":"Speaking of none but God,"},{"id":"sayakbay-ms-current144:pdf131:l006","ordinal":391989,"en":"[Rumbling], he stood looking now."},{"id":"sayakbay-ms-current144:pdf131:l007","ordinal":391990,"en":"Ah, the splendid creature Kulan Sur,"},{"id":"sayakbay-ms-current144:pdf131:l009","ordinal":391991,"en":"[His joined waist like a trap],"},{"id":"sayakbay-ms-current144:pdf131:l010","ordinal":391992,"en":"He had a tail and a mane,"},{"id":"sayakbay-ms-current144:pdf131:l011","ordinal":391993,"en":"Such a wondrous steed was he."},{"id":"sayakbay-ms-current144:pdf131:l012","ordinal":391994,"en":"[To present different forms to the enemy],"},{"id":"sayakbay-ms-current144:pdf131:l013","ordinal":391995,"en":"[A racer worth a thousand],"},{"id":"sayakbay-ms-current144:pdf131:l014","ordinal":391996,"en":"Though an animal, this creature,"},{"id":"sayakbay-ms-current144:pdf131:l015","ordinal":391997,"en":"His mane and tail spreading,"},{"id":"sayakbay-ms-current144:pdf131:l017","ordinal":391998,"en":"Gnawing on his bit,"},{"id":"sayakbay-ms-current144:pdf131:l020","ordinal":391999,"en":"His tail like strands of silk,"},{"id":"sayakbay-ms-current144:pdf131:l021","ordinal":392000,"en":"[Those left watching],"},{"id":"sayakbay-ms-current144:pdf131:l022","ordinal":392001,"en":"[Lashing it from side to side]."},{"id":"sayakbay-ms-current144:pdf131:l023","ordinal":392002,"en":"[Moving and striking, no sword pierced him],"},{"id":"sayakbay-ms-current144:pdf131:l024","ordinal":392003,"en":"[No head passed where he stood],"},{"id":"sayakbay-ms-current144:pdf131:l026","ordinal":392004,"en":"Facing toward [Kutpa],"},{"id":"sayakbay-ms-current144:pdf131:l027","ordinal":392005,"en":"Kulan Sur stood there."},{"id":"sayakbay-ms-current144:pdf132:l004","ordinal":392006,"en":"And stood giving him his turn."},{"id":"sayakbay-ms-current144:pdf132:l005","ordinal":392007,"en":"[Meeting, unable to endure],"},{"id":"sayakbay-ms-current144:pdf132:l006","ordinal":392008,"en":"Fighting by turns,"},{"id":"sayakbay-ms-current144:pdf132:l008","ordinal":392009,"en":"Great Bilgich, son of Kojojas,"},{"id":"sayakbay-ms-current144:pdf132:l009","ordinal":392010,"en":"Take your turn, Bilgich."},{"id":"sayakbay-ms-current144:pdf132:l011","ordinal":392011,"en":"[Spare no speed], Bilgich."},{"id":"sayakbay-ms-current144:pdf132:l012","ordinal":392012,"en":"Strike in anger, Bilgich."},{"id":"sayakbay-ms-current144:pdf132:l013","ordinal":392013,"en":"If you are a hero, a warrior,"},{"id":"sayakbay-ms-current144:pdf132:l014","ordinal":392014,"en":"If you are a ruler's son,"},{"id":"sayakbay-ms-current144:pdf132:l019","ordinal":392015,"en":"Wretch, you came from the khagan [arising]."},{"id":"sayakbay-ms-current144:pdf132:l020","ordinal":392016,"en":"May death not take you helplessly."},{"id":"sayakbay-ms-current144:pdf132:l023","ordinal":392017,"en":"Then Joltoy said this,"},{"id":"sayakbay-ms-current144:pdf132:l025","ordinal":392018,"en":"Speaking with a laugh, [standing firm],"},{"id":"sayakbay-ms-current144:pdf132:l026","ordinal":392019,"en":"[The flowing blood did a kindness],"},{"id":"sayakbay-ms-current144:pdf132:l028","ordinal":392020,"en":"Giving the warrior his turn,"},{"id":"sayakbay-ms-current144:pdf133:l004","ordinal":392021,"en":"Their fragile lives straining,"},{"id":"sayakbay-ms-current144:pdf133:l005","ordinal":392022,"en":"True hardship came at last."},{"id":"sayakbay-ms-current144:pdf133:l006","ordinal":392023,"en":"[The mighty courser] Kulan Sur,"},{"id":"sayakbay-ms-current144:pdf133:l010","ordinal":392024,"en":"He began a fierce rage."},{"id":"sayakbay-ms-current144:pdf133:l012","ordinal":392025,"en":"[The destructive hothead],"},{"id":"sayakbay-ms-current144:pdf133:l013","ordinal":392026,"en":"He bound it to a thread."},{"id":"sayakbay-ms-current144:pdf133:l015","ordinal":392027,"en":"[Following mountains to strike],"},{"id":"sayakbay-ms-current144:pdf133:l019","ordinal":392028,"en":"Such was [the pestilence],"},{"id":"sayakbay-ms-current144:pdf133:l021","ordinal":392029,"en":"He had tied it to a thread."},{"id":"sayakbay-ms-current144:pdf133:l022","ordinal":392030,"en":"Dust rose from his steps,"},{"id":"sayakbay-ms-current144:pdf133:l023","ordinal":392031,"en":"[Souls fled at his voice],"},{"id":"sayakbay-ms-current144:pdf133:l029","ordinal":392032,"en":"[Seeing his aspect, making a quarrel],"},{"id":"sayakbay-ms-current144:pdf134:l001","ordinal":392033,"en":"Fat flowed from his fingers,"},{"id":"sayakbay-ms-current144:pdf134:l003","ordinal":392034,"en":"[A gaping-mouthed gray arrow],"},{"id":"sayakbay-ms-current144:pdf134:l004","ordinal":392035,"en":"He shot a hundred with it."},{"id":"sayakbay-ms-current144:pdf134:l005","ordinal":392036,"en":"Joltoy, who had given him his turn,"},{"id":"sayakbay-ms-current144:pdf134:l006","ordinal":392037,"en":"He made him bend low."},{"id":"sayakbay-ms-current144:pdf134:l007","ordinal":392038,"en":"[A slender] birch arrow,"},{"id":"sayakbay-ms-current144:pdf134:l009","ordinal":392039,"en":"He fired a hundred with that,"},{"id":"sayakbay-ms-current144:pdf134:l010","ordinal":392040,"en":"[An exceptionally stout white arrow],"},{"id":"sayakbay-ms-current144:pdf134:l011","ordinal":392041,"en":"[He took aim at the back],"},{"id":"sayakbay-ms-current144:pdf134:l013","ordinal":392042,"en":"Drawing his bow, making rain,"},{"id":"sayakbay-ms-current144:pdf134:l016","ordinal":392043,"en":"[Three sharp edges, its socket steel],"},{"id":"sayakbay-ms-current144:pdf134:l017","ordinal":392044,"en":"[The supple steel spear],"},{"id":"sayakbay-ms-current144:pdf134:l018","ordinal":392045,"en":"He thrust it with a thunderous roar."},{"id":"sayakbay-ms-current144:pdf134:l019","ordinal":392046,"en":"When bows and guns reached him,"},{"id":"sayakbay-ms-current144:pdf134:l021","ordinal":392047,"en":"[With trouble crowding behind him],"},{"id":"sayakbay-ms-current144:pdf134:l023","ordinal":392048,"en":"Pouring out his wrath and roaring,"},{"id":"sayakbay-ms-current144:pdf134:l025","ordinal":392049,"en":"From the infidel's fury,"},{"id":"sayakbay-ms-current144:pdf134:l028","ordinal":392050,"en":"[The measure of the killing place],"},{"id":"sayakbay-ms-current144:pdf134:l029","ordinal":392051,"en":"[A warrior who had taken many strongholds]."},{"id":"sayakbay-ms-current144:pdf135:l001","ordinal":392052,"en":"His waist narrowed like a trap,"},{"id":"sayakbay-ms-current144:pdf135:l002","ordinal":392053,"en":"His rib bones crackled,"},{"id":"sayakbay-ms-current144:pdf135:l003","ordinal":392054,"en":"[His marksman's eyes flashing],"},{"id":"sayakbay-ms-current144:pdf135:l004","ordinal":392055,"en":"Raging and thundering,"},{"id":"sayakbay-ms-current144:pdf135:l009","ordinal":392056,"en":"[As the blows were about to begin],"},{"id":"sayakbay-ms-current144:pdf135:l010","ordinal":392057,"en":"[His spear toward the striking side],"},{"id":"sayakbay-ms-current144:pdf135:l011","ordinal":392058,"en":"[The cunning wrestler] Ak Joltoy,"},{"id":"sayakbay-ms-current144:pdf135:l012","ordinal":392059,"en":"Now found his stratagem."},{"id":"sayakbay-ms-current144:pdf135:l013","ordinal":392060,"en":"Never pulling back when his horse charged,"},{"id":"sayakbay-ms-current144:pdf135:l015","ordinal":392061,"en":"[The allotted span of his entrusted life],"},{"id":"sayakbay-ms-current144:pdf135:l017","ordinal":392062,"en":"When Joltoy came to the desert,"},{"id":"sayakbay-ms-current144:pdf135:l018","ordinal":392063,"en":"[The wretch struggled along the road],"},{"id":"sayakbay-ms-current144:pdf135:l019","ordinal":392064,"en":"There was no cawing crow,"},{"id":"sayakbay-ms-current144:pdf135:l020","ordinal":392065,"en":"No raven flying with its call,"},{"id":"sayakbay-ms-current144:pdf135:l021","ordinal":392066,"en":"No living soul traveled beyond it."},{"id":"sayakbay-ms-current144:pdf135:l022","ordinal":392067,"en":"From the difficult desert of Mediyan,"},{"id":"sayakbay-ms-current144:pdf135:l025","ordinal":392068,"en":"[It glanced when striking stone],"},{"id":"sayakbay-ms-current144:pdf136:l001","ordinal":392069,"en":"[Deceiving his entrusted life],"},{"id":"sayakbay-ms-current144:pdf136:l002","ordinal":392070,"en":"[He ran with exceptional speed]."},{"id":"sayakbay-ms-current144:pdf136:l003","ordinal":392071,"en":"As the spear came hurtling toward him,"},{"id":"sayakbay-ms-current144:pdf136:l004","ordinal":392072,"en":"[Leaving no easy moment for life],"},{"id":"sayakbay-ms-current144:pdf136:l005","ordinal":392073,"en":"As it reached him to strike,"},{"id":"sayakbay-ms-current144:pdf136:l007","ordinal":392074,"en":"When the thrusting spear arrived,"},{"id":"sayakbay-ms-current144:pdf136:l012","ordinal":392075,"en":"Keeping the spear from his body,"},{"id":"sayakbay-ms-current144:pdf136:l013","ordinal":392076,"en":"Joltoy struck the spear."},{"id":"sayakbay-ms-current144:pdf136:l014","ordinal":392077,"en":"The spear broke in the middle,"},{"id":"sayakbay-ms-current144:pdf136:l015","ordinal":392078,"en":"Joltoy appeared unharmed."},{"id":"sayakbay-ms-current144:pdf136:l016","ordinal":392079,"en":"When Ak Joltoy found his stratagem,"},{"id":"sayakbay-ms-current144:pdf136:l017","ordinal":392080,"en":"In the blink of an eye,"},{"id":"sayakbay-ms-current144:pdf136:l018","ordinal":392081,"en":"Before one could say this or that,"},{"id":"sayakbay-ms-current144:pdf136:l019","ordinal":392082,"en":"Saving a life from death,"},{"id":"sayakbay-ms-current144:pdf136:l020","ordinal":392083,"en":"At the middle of the spear,"},{"id":"sayakbay-ms-current144:pdf136:l026","ordinal":392084,"en":"[Repelling the enemy's obligation],"},{"id":"sayakbay-ms-current144:pdf136:l029","ordinal":392085,"en":"[Even a whirlwind's wind cannot touch you],"},{"id":"sayakbay-ms-current144:pdf136:l031","ordinal":392086,"en":"For this wretched Kyrgyz people,"},{"id":"sayakbay-ms-current144:pdf137:l001","ordinal":392087,"en":"It is you, Ak Joltoy."},{"id":"sayakbay-ms-current144:pdf137:l003","ordinal":392088,"en":"[Unbroken even when the whip strikes],"},{"id":"sayakbay-ms-current144:pdf137:l005","ordinal":392089,"en":"Born for your good fortune,"},{"id":"sayakbay-ms-current144:pdf137:l007","ordinal":392090,"en":"You are an exceptional companion,"},{"id":"sayakbay-ms-current144:pdf137:l008","ordinal":392091,"en":"It is you, Ak Joltoy."},{"id":"sayakbay-ms-current144:pdf137:l009","ordinal":392092,"en":"[Standing firm against a flood],"},{"id":"sayakbay-ms-current144:pdf137:l010","ordinal":392093,"en":"It is you, Ak Joltoy."},{"id":"sayakbay-ms-current144:pdf137:l011","ordinal":392094,"en":"[Chosen from the countless throng],"},{"id":"sayakbay-ms-current144:pdf137:l013","ordinal":392095,"en":"[There was little fault to speak of],"},{"id":"sayakbay-ms-current144:pdf137:l014","ordinal":392096,"en":"[From the red, rugged ridge]."},{"id":"sayakbay-ms-current144:pdf137:l018","ordinal":392097,"en":"Here are my precious people,"},{"id":"sayakbay-ms-current144:pdf137:l021","ordinal":392098,"en":"Into the great gaping ravine,"},{"id":"sayakbay-ms-current144:pdf137:l023","ordinal":392099,"en":"[Into the resounding great ravine],"},{"id":"sayakbay-ms-current144:pdf137:l025","ordinal":392100,"en":"Saying, take your turn,"},{"id":"sayakbay-ms-current144:pdf137:l029","ordinal":392101,"en":"He was a lord and a khan,"},{"id":"sayakbay-ms-current144:pdf137:l030","ordinal":392102,"en":"[He was mighty] and a lion,"},{"id":"sayakbay-ms-current144:pdf137:l031","ordinal":392103,"en":"One who split a black hair exactly,"},{"id":"sayakbay-ms-current144:pdf138:l001","ordinal":392104,"en":"He was a khan who stood impartially."},{"id":"sayakbay-ms-current144:pdf138:l002","ordinal":392105,"en":"[He ruled the people of forty khans],"},{"id":"sayakbay-ms-current144:pdf138:l003","ordinal":392106,"en":"He guarded the treasury,"},{"id":"sayakbay-ms-current144:pdf138:l004","ordinal":392107,"en":"[A giant supplied what was needed],"},{"id":"sayakbay-ms-current144:pdf138:l005","ordinal":392108,"en":"[He established Thursday],"},{"id":"sayakbay-ms-current144:pdf138:l012","ordinal":392109,"en":"Bilgich stood waiting."},{"id":"sayakbay-ms-current144:pdf138:l015","ordinal":392110,"en":"[Earnestly turning to his god],"},{"id":"sayakbay-ms-current144:pdf138:l017","ordinal":392111,"en":"To the idol fashioned by hand,"},{"id":"sayakbay-ms-current144:pdf138:l018","ordinal":392112,"en":"[The supporter from behind],"},{"id":"sayakbay-ms-current144:pdf138:l021","ordinal":392113,"en":"If you truly are my khan,"},{"id":"sayakbay-ms-current144:pdf138:l022","ordinal":392114,"en":"[Do not disgrace Cholpon's blood],"},{"id":"sayakbay-ms-current144:pdf138:l024","ordinal":392115,"en":"The spear in his hand,"},{"id":"sayakbay-ms-current144:pdf138:l025","ordinal":392116,"en":"[Turn it aside], he said."},{"id":"sayakbay-ms-current144:pdf138:l027","ordinal":392117,"en":"[He begged him and deceived himself],"},{"id":"sayakbay-ms-current144:pdf138:l029","ordinal":392118,"en":"Kulan Sur beneath him,"},{"id":"sayakbay-ms-current144:pdf138:l030","ordinal":392119,"en":"Even the wind could not match his trot,"},{"id":"sayakbay-ms-current144:pdf139:l001","ordinal":392120,"en":"No beast could match his pace,"},{"id":"sayakbay-ms-current144:pdf139:l002","ordinal":392121,"en":"[Four feet driving stakes],"},{"id":"sayakbay-ms-current144:pdf139:l004","ordinal":392122,"en":"[His mane and tail bristling],"},{"id":"sayakbay-ms-current144:pdf139:l006","ordinal":392123,"en":"[Blood flowing amid the clash],"},{"id":"sayakbay-ms-current144:pdf139:l009","ordinal":392124,"en":"Biting hard into his lip,"},{"id":"sayakbay-ms-current144:pdf139:l010","ordinal":392125,"en":"His flintlike eyes grew dim,"},{"id":"sayakbay-ms-current144:pdf139:l012","ordinal":392126,"en":"[His deep-set eyes fixed],"},{"id":"sayakbay-ms-current144:pdf139:l013","ordinal":392127,"en":"[I looked behind him],"},{"id":"sayakbay-ms-current144:pdf139:l014","ordinal":392128,"en":"Wolves and vultures would feast."},{"id":"sayakbay-ms-current144:pdf139:l016","ordinal":392129,"en":"For the white-capped Kyrgyz,"},{"id":"sayakbay-ms-current144:pdf139:l017","ordinal":392130,"en":"I was a resourceful man."},{"id":"sayakbay-ms-current144:pdf139:l019","ordinal":392131,"en":"[I was a gray-ridged fortress],"},{"id":"sayakbay-ms-current144:pdf139:l022","ordinal":392132,"en":"Thus Ak Joltoy spoke,"},{"id":"sayakbay-ms-current144:pdf139:l024","ordinal":392133,"en":"[Beside Chynok],"},{"id":"sayakbay-ms-current144:pdf139:l025","ordinal":392134,"en":"[This is the place to die or thrust],"},{"id":"sayakbay-ms-current144:pdf139:l026","ordinal":392135,"en":"[Both flanks turning to ashes],"},{"id":"sayakbay-ms-current144:pdf139:l027","ordinal":392136,"en":"[Saying, it is time to be caught],"},{"id":"sayakbay-ms-current144:pdf140:l001","ordinal":392137,"en":"[He used all his strength],"},{"id":"sayakbay-ms-current144:pdf140:l003","ordinal":392138,"en":"Amid gray, hazy dust,"},{"id":"sayakbay-ms-current144:pdf140:l005","ordinal":392139,"en":"[He measured and aligned his aim],"},{"id":"sayakbay-ms-current144:pdf140:l006","ordinal":392140,"en":"He struck a fatal spot."},{"id":"sayakbay-ms-current144:pdf140:l007","ordinal":392141,"en":"His skill was formidable."},{"id":"sayakbay-ms-current144:pdf140:l008","ordinal":392142,"en":"[As though striking a stone],"},{"id":"sayakbay-ms-current144:pdf140:l010","ordinal":392143,"en":"His insides burned like embers,"},{"id":"sayakbay-ms-current144:pdf140:l013","ordinal":392144,"en":"[Paid no heed, standing boldly],"},{"id":"sayakbay-ms-current144:pdf140:l015","ordinal":392145,"en":"Not reckoning him worth a hem,"},{"id":"sayakbay-ms-current144:pdf140:l016","ordinal":392146,"en":"Without moving brow or eyebrow,"},{"id":"sayakbay-ms-current144:pdf140:l018","ordinal":392147,"en":"Firing guns and drawing bows,"},{"id":"sayakbay-ms-current144:pdf140:l019","ordinal":392148,"en":"[They fought with clattering blows],"},{"id":"sayakbay-ms-current144:pdf140:l020","ordinal":392149,"en":"Exchanging axe blows in combat,"},{"id":"sayakbay-ms-current144:pdf140:l021","ordinal":392150,"en":"[Against a death-dealing mace],"},{"id":"sayakbay-ms-current144:pdf140:l022","ordinal":392151,"en":"[They charged right through],"},{"id":"sayakbay-ms-current144:pdf140:l024","ordinal":392152,"en":"Fighting and clashing together."},{"id":"sayakbay-ms-current144:pdf140:l029","ordinal":392153,"en":"[Their patched coats hung along them],"},{"id":"sayakbay-ms-current144:pdf140:l030","ordinal":392154,"en":"In some places the two warriors,"},{"id":"sayakbay-ms-current144:pdf141:l001","ordinal":392155,"en":"If you consider it, it will not be overturned,"},{"id":"sayakbay-ms-current144:pdf141:l002","ordinal":392156,"en":"They stood grappling with one another,"},{"id":"sayakbay-ms-current144:pdf141:l003","ordinal":392157,"en":"Cruel humiliation fell upon the good man,"},{"id":"sayakbay-ms-current144:pdf141:l004","ordinal":392158,"en":"The two warriors attacked one another,"},{"id":"sayakbay-ms-current144:pdf141:l005","ordinal":392159,"en":"For six days and six nights,"},{"id":"sayakbay-ms-current144:pdf141:l007","ordinal":392160,"en":"Covering much ground, the enemy did not advance,"},{"id":"sayakbay-ms-current144:pdf141:l008","ordinal":392161,"en":"They fought while circling one another,"},{"id":"sayakbay-ms-current144:pdf141:l009","ordinal":392162,"en":"Which Kyrgyz had ever fought like this?"},{"id":"sayakbay-ms-current144:pdf141:l010","ordinal":392163,"en":"When one looked, they moved too quickly for the eye,"},{"id":"sayakbay-ms-current144:pdf141:l012","ordinal":392164,"en":"The two were companions,"},{"id":"sayakbay-ms-current144:pdf141:l013","ordinal":392165,"en":"No one could tell where they were,"},{"id":"sayakbay-ms-current144:pdf141:l014","ordinal":392166,"en":"They continued until they were nearly exhausted,"},{"id":"sayakbay-ms-current144:pdf141:l015","ordinal":392167,"en":"All their provisions were exhausted,"},{"id":"sayakbay-ms-current144:pdf141:l016","ordinal":392168,"en":"With no recourse left, they separated,"},{"id":"sayakbay-ms-current144:pdf141:l017","ordinal":392169,"en":"Wondering how they might save their lives,"},{"id":"sayakbay-ms-current144:pdf141:l018","ordinal":392170,"en":"The two warriors grieved,"},{"id":"sayakbay-ms-current144:pdf141:l019","ordinal":392171,"en":"Seeing this, Chong Bilgich,"},{"id":"sayakbay-ms-current144:pdf141:l020","ordinal":392172,"en":"Spoke profound and lucid words,"},{"id":"sayakbay-ms-current144:pdf141:l021","ordinal":392173,"en":"He was wise and clear-sighted,"},{"id":"sayakbay-ms-current144:pdf141:l022","ordinal":392174,"en":"Chong Bilgich was indeed a sage,"},{"id":"sayakbay-ms-current144:pdf141:l023","ordinal":392175,"en":"Jadyger was resourceful,"},{"id":"sayakbay-ms-current144:pdf141:l024","ordinal":392176,"en":"Chong Bilgich was formidable,"},{"id":"sayakbay-ms-current144:pdf141:l025","ordinal":392177,"en":"They understood that trouble had befallen them,"},{"id":"sayakbay-ms-current144:pdf141:l026","ordinal":392178,"en":"Chong Bilgich had turned pale,"},{"id":"sayakbay-ms-current144:pdf141:l027","ordinal":392179,"en":"What a great marksman Aizan was,"},{"id":"sayakbay-ms-current144:pdf141:l028","ordinal":392180,"en":"He was a warrior endowed with reason,"},{"id":"sayakbay-ms-current144:pdf141:l029","ordinal":392181,"en":"When one looked, the eye could not reach the end,"},{"id":"sayakbay-ms-current144:pdf141:l030","ordinal":392182,"en":"Words could not encompass the multitude."},{"id":"sayakbay-ms-current144:pdf142:l001","ordinal":392183,"en":"The earth rose like a mound of down,"},{"id":"sayakbay-ms-current144:pdf142:l002","ordinal":392184,"en":"The accomplished Bilgich was cunning,"},{"id":"sayakbay-ms-current144:pdf142:l005","ordinal":392185,"en":"The body of Chong Bilgich,"},{"id":"sayakbay-ms-current144:pdf142:l007","ordinal":392186,"en":"It reddened and bled,"},{"id":"sayakbay-ms-current144:pdf142:l009","ordinal":392187,"en":"Poor Joltoy had exhausted his devices,"},{"id":"sayakbay-ms-current144:pdf142:l010","ordinal":392188,"en":"He tested him after seeing his suffering,"},{"id":"sayakbay-ms-current144:pdf142:l012","ordinal":392189,"en":"His soul fell into misery,"},{"id":"sayakbay-ms-current144:pdf142:l013","ordinal":392190,"en":"He had been burning with anguish,"},{"id":"sayakbay-ms-current144:pdf142:l014","ordinal":392191,"en":"They fought beyond any man’s endurance,"},{"id":"sayakbay-ms-current144:pdf142:l017","ordinal":392192,"en":"He was the very blue-maned champion,"}]
