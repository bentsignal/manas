[{"id":"semetey-1-2013:p1058:b004:l022","ordinal":156929,"en":"Such was his wisdom:"},{"id":"semetey-1-2013:p1058:b004:l023","ordinal":156930,"en":"\"He will send the pretentious Kozho"},{"id":"semetey-1-2013:p1058:b004:l024","ordinal":156931,"en":"Over the hill,\" he thought;"},{"id":"semetey-1-2013:p1058:b004:l025","ordinal":156932,"en":"\"This pig who struck from above"},{"id":"semetey-1-2013:p1058:b004:l026","ordinal":156933,"en":"Will be left disgraced.\""},{"id":"semetey-1-2013:p1058:b004:l027","ordinal":156934,"en":"As he was about to make the tale compelling,"},{"id":"semetey-1-2013:p1058:b004:l028","ordinal":156935,"en":"Toltoy and Chynkozho,"},{"id":"semetey-1-2013:p1058:b004:l029","ordinal":156936,"en":"And the swarming Zhediger—"},{"id":"semetey-1-2013:p1058:b004:l030","ordinal":156937,"en":"As he was now about to deceive them,"},{"id":"semetey-1-2013:p1058:b004:l031","ordinal":156938,"en":"\"God has taken the fool;"},{"id":"semetey-1-2013:p1058:b004:l032","ordinal":156939,"en":"He has begun the ruin now,\" he thought."},{"id":"semetey-1-2013:p1058:b004:l033","ordinal":156940,"en":"Azhybay struggled to intervene,"},{"id":"semetey-1-2013:p1058:b004:l034","ordinal":156941,"en":"Quarreling with Tümönbay."},{"id":"semetey-1-2013:p1058:b004:l035","ordinal":156942,"en":"Raging and straining,"},{"id":"semetey-1-2013:p1058:b004:l036","ordinal":156943,"en":"From the other side Chynkozho"},{"id":"semetey-1-2013:p1058:b004:l037","ordinal":156944,"en":"Now stood surging forward,"},{"id":"semetey-1-2013:p1058:b004:l038","ordinal":156945,"en":"Beating the earth as he strained,"},{"id":"semetey-1-2013:p1058:b004:l039","ordinal":156946,"en":"And surging in anger."}]
