[{"id":"semetey-1-2013:p0841:b003:l025","ordinal":141313,"en":"Sated with blood and hardened,"},{"id":"semetey-1-2013:p0841:b003:l026","ordinal":141314,"en":"Renowned as a fierce leopard,"},{"id":"semetey-1-2013:p0841:b003:l027","ordinal":141315,"en":"They had left Bukhara,"},{"id":"semetey-1-2013:p0841:b003:l028","ordinal":141316,"en":"And passed toward Talas."},{"id":"semetey-1-2013:p0841:b003:l029","ordinal":141317,"en":"His mother Kanykei’s Aman-Jol—"},{"id":"semetey-1-2013:p0841:b003:l030","ordinal":141318,"en":"They now followed Aman-Jol."},{"id":"semetey-1-2013:p0841:b003:l031","ordinal":141319,"en":"The orphan did not weary of the journey;"},{"id":"semetey-1-2013:p0841:b003:l032","ordinal":141320,"en":"They reached the Syr-Darya."},{"id":"semetey-1-2013:p0841:b003:l033","ordinal":141321,"en":"To the banks of the Syr-Darya,"},{"id":"semetey-1-2013:p0841:b003:l034","ordinal":141322,"en":"When they drew near,"},{"id":"semetey-1-2013:p0841:b003:l035","ordinal":141323,"en":"After enduring much grief and torment,"},{"id":"semetey-1-2013:p0841:b003:l036","ordinal":141324,"en":"When they reached the place she had crossed,"},{"id":"semetey-1-2013:p0841:b003:l037","ordinal":141325,"en":"In winter’s fiercest cold,"},{"id":"semetey-1-2013:p0841:b003:l038","ordinal":141326,"en":"Forty-two times zigzagging through that water,"},{"id":"semetey-1-2013:p0841:b003:l039","ordinal":141327,"en":"When they reached the place she had forded,"},{"id":"semetey-1-2013:p0841:b005:l001","ordinal":141328,"en":"Then your mother Kanykei—"},{"id":"semetey-1-2013:p0841:b005:l002","ordinal":141329,"en":"Would God take her merely for lamenting?"},{"id":"semetey-1-2013:p0841:b005:l003","ordinal":141330,"en":"She had prayed for her only child."},{"id":"semetey-1-2013:p0841:b005:l004","ordinal":141331,"en":"The ice then frozen to her calves—"},{"id":"semetey-1-2013:p0841:b005:l005","ordinal":141332,"en":"Could it ever leave her very bones?"},{"id":"semetey-1-2013:p0841:b005:l006","ordinal":141333,"en":"When she saw the road she had come,"},{"id":"semetey-1-2013:p0841:b005:l007","ordinal":141334,"en":"Her heart was deeply troubled,"},{"id":"semetey-1-2013:p0841:b005:l008","ordinal":141335,"en":"Tears poured from her eyes,"},{"id":"semetey-1-2013:p0841:b005:l009","ordinal":141336,"en":"Her ribs seemed to come apart,"},{"id":"semetey-1-2013:p0841:b005:l010","ordinal":141337,"en":"Her heart burned with grief."},{"id":"semetey-1-2013:p0841:b005:l011","ordinal":141338,"en":"She stood gazing, aching,"},{"id":"semetey-1-2013:p0841:b005:l012","ordinal":141339,"en":"And to the orphan left by Manas"},{"id":"semetey-1-2013:p0841:b005:l013","ordinal":141340,"en":"The meaning of the Syr-Darya"},{"id":"semetey-1-2013:p0841:b005:l014","ordinal":141341,"en":"She told with sobs:"},{"id":"semetey-1-2013:p0841:b005:l015","ordinal":141342,"en":"“Once, when I scattered my countless possessions,"},{"id":"semetey-1-2013:p0841:b005:l016","ordinal":141343,"en":"When I fled Talas on foot,"},{"id":"semetey-1-2013:p0841:b005:l017","ordinal":141344,"en":"My child, for your sake,"},{"id":"semetey-1-2013:p0841:b005:l018","ordinal":141345,"en":"I roamed along the mountains’ edges."},{"id":"semetey-1-2013:p0841:b005:l019","ordinal":141346,"en":"‘The only one left by the hero,’ I said,"},{"id":"semetey-1-2013:p0841:b005:l020","ordinal":141347,"en":"In the fold of my wraparound skirt"},{"id":"semetey-1-2013:p0841:b005:l021","ordinal":141348,"en":"I tucked you securely and fastened you,"},{"id":"semetey-1-2013:p0841:b005:l022","ordinal":141349,"en":"Chafing my heels,"},{"id":"semetey-1-2013:p0841:b005:l023","ordinal":141350,"en":"Aching in the flesh of my calves."},{"id":"semetey-1-2013:p0841:b005:l024","ordinal":141351,"en":"The child cried from hunger;"},{"id":"semetey-1-2013:p0841:b005:l025","ordinal":141352,"en":"I, your mother, a wretched slave,"},{"id":"semetey-1-2013:p0841:b005:l026","ordinal":141353,"en":"Sobbed, finding no way out."},{"id":"semetey-1-2013:p0841:b005:l027","ordinal":141354,"en":"Unable to ford the Syr-Darya,"},{"id":"semetey-1-2013:p0841:b005:l028","ordinal":141355,"en":"Unable to reach my desire,"},{"id":"semetey-1-2013:p0841:b005:l029","ordinal":141356,"en":"Allah’s sun in heaven clouded over;"},{"id":"semetey-1-2013:p0841:b005:l030","ordinal":141357,"en":"Sixty worries fell upon me together."},{"id":"semetey-1-2013:p0841:b005:l031","ordinal":141358,"en":"My mother upon my back,"},{"id":"semetey-1-2013:p0841:b005:l032","ordinal":141359,"en":"You, my child, at my waist,"},{"id":"semetey-1-2013:p0841:b005:l033","ordinal":141360,"en":"I carried you both without wearying;"},{"id":"semetey-1-2013:p0841:b005:l034","ordinal":141361,"en":"Your old grandmother coughed on my back."},{"id":"semetey-1-2013:p0841:b005:l035","ordinal":141362,"en":"Would God take me merely for lamenting?"},{"id":"semetey-1-2013:p0841:b005:l036","ordinal":141363,"en":"The ice frozen to my shins—"},{"id":"semetey-1-2013:p0841:b005:l037","ordinal":141364,"en":"Could it ever leave my very bones?"},{"id":"semetey-1-2013:p0841:b005:l038","ordinal":141365,"en":"Unable to cross this water,"},{"id":"semetey-1-2013:p0842:b003:l001","ordinal":141366,"en":"Unable to reach the place I sought,"},{"id":"semetey-1-2013:p0842:b003:l002","ordinal":141367,"en":"The flesh of my soles wore away and split;"},{"id":"semetey-1-2013:p0842:b003:l003","ordinal":141368,"en":"The dark blood flowing from my calves"},{"id":"semetey-1-2013:p0842:b003:l004","ordinal":141369,"en":"Streamed down the length of a saddle strap."},{"id":"semetey-1-2013:p0842:b003:l005","ordinal":141370,"en":"My voice reached God;"},{"id":"semetey-1-2013:p0842:b003:l006","ordinal":141371,"en":"I fell and crawled upon the earth."},{"id":"semetey-1-2013:p0842:b003:l007","ordinal":141372,"en":"When you can't find a way,"},{"id":"semetey-1-2013:p0842:b003:l008","ordinal":141373,"en":"Noble Bakai, the valiant one,"},{"id":"semetey-1-2013:p0842:b003:l009","ordinal":141374,"en":"Your father’s dear companion,"},{"id":"semetey-1-2013:p0842:b003:l010","ordinal":141375,"en":"His companion unto Judgment,"},{"id":"semetey-1-2013:p0842:b003:l011","ordinal":141376,"en":"His comrade blessed by Kydyr—"},{"id":"semetey-1-2013:p0842:b003:l012","ordinal":141377,"en":"Your fierce father Manas’s"},{"id":"semetey-1-2013:p0842:b003:l013","ordinal":141378,"en":"Dear adviser,"},{"id":"semetey-1-2013:p0842:b003:l014","ordinal":141379,"en":"Noble Bakai, the falcon,"},{"id":"semetey-1-2013:p0842:b003:l015","ordinal":141380,"en":"Brought two swift horses,"},{"id":"semetey-1-2013:p0842:b003:l016","ordinal":141381,"en":"Brought two skins of milk."},{"id":"semetey-1-2013:p0842:b003:l017","ordinal":141382,"en":"On the banks of the Syr-Darya,"},{"id":"semetey-1-2013:p0842:b003:l018","ordinal":141383,"en":"Your noble elder Bakai’s"},{"id":"semetey-1-2013:p0842:b003:l019","ordinal":141384,"en":"Wether slaughtered for our food—"},{"id":"semetey-1-2013:p0842:b003:l020","ordinal":141385,"en":"How can they leave my memory,"},{"id":"semetey-1-2013:p0842:b003:l021","ordinal":141386,"en":"The deeds of those six scoundrels?"},{"id":"semetey-1-2013:p0842:b003:l022","ordinal":141387,"en":"Jaiyk-Kechüü and Tash-Kechüü—"},{"id":"semetey-1-2013:p0842:b003:l023","ordinal":141388,"en":"Your royal elder Bakai,"},{"id":"semetey-1-2013:p0842:b003:l024","ordinal":141389,"en":"The sage who knew them all,"},{"id":"semetey-1-2013:p0842:b003:l025","ordinal":141390,"en":"Kindling the extinguished fire,"},{"id":"semetey-1-2013:p0842:b003:l026","ordinal":141391,"en":"Reviving the dead,"},{"id":"semetey-1-2013:p0842:b003:l027","ordinal":141392,"en":"Toward Khan Bukhara"},{"id":"semetey-1-2013:p0842:b003:l028","ordinal":141393,"en":"The sage set us on the road.”"},{"id":"semetey-1-2013:p0842:b003:l029","ordinal":141394,"en":"Tash-Kechüü, which Bakai found,"},{"id":"semetey-1-2013:p0842:b003:l030","ordinal":141395,"en":"The familiar ford the sage found—"},{"id":"semetey-1-2013:p0842:b003:l031","ordinal":141396,"en":"Your formidable mother Kanykei"},{"id":"semetey-1-2013:p0842:b003:l032","ordinal":141397,"en":"Now took Tash-Kechüü."},{"id":"semetey-1-2013:p0842:b003:l033","ordinal":141398,"en":"Leading all the pack animals in a line,"},{"id":"semetey-1-2013:p0842:b003:l034","ordinal":141399,"en":"They safely crossed,"},{"id":"semetey-1-2013:p0842:b003:l035","ordinal":141400,"en":"And set out upon the open plain."},{"id":"semetey-1-2013:p0842:b003:l036","ordinal":141401,"en":"Taking no rest by day,"},{"id":"semetey-1-2013:p0842:b003:l037","ordinal":141402,"en":"Taking no sleep at night,"},{"id":"semetey-1-2013:p0842:b003:l038","ordinal":141403,"en":"Never lying down for a full sleep,"},{"id":"semetey-1-2013:p0842:b003:l039","ordinal":141404,"en":"Never letting the swift horses weary,"},{"id":"semetey-1-2013:p0842:b004:l001","ordinal":141405,"en":"Thus they moved toward Talas."},{"id":"semetey-1-2013:p0842:b004:l002","ordinal":141406,"en":"Traveling across the open plain,"},{"id":"semetey-1-2013:p0842:b004:l003","ordinal":141407,"en":"Going far and tiring their horses,"},{"id":"semetey-1-2013:p0842:b004:l004","ordinal":141408,"en":"Loading their pack animals,"},{"id":"semetey-1-2013:p0842:b004:l005","ordinal":141409,"en":"Having openly departed Bukhara,"},{"id":"semetey-1-2013:p0842:b004:l006","ordinal":141410,"en":"They moved toward Talas."},{"id":"semetey-1-2013:p0842:b004:l007","ordinal":141411,"en":"Over ridge after hilly ridge,"},{"id":"semetey-1-2013:p0842:b004:l008","ordinal":141412,"en":"Over ridges of the open plain,"},{"id":"semetey-1-2013:p0842:b004:l009","ordinal":141413,"en":"At Chiyyrchyk and Salar-Ata,"},{"id":"semetey-1-2013:p0842:b004:l010","ordinal":141414,"en":"They prayed as they passed."},{"id":"semetey-1-2013:p0842:b004:l011","ordinal":141415,"en":"Turkestan, hazy in the distance,"},{"id":"semetey-1-2013:p0842:b004:l012","ordinal":141416,"en":"The great shrine of Tümön-Ata—"},{"id":"semetey-1-2013:p0842:b004:l013","ordinal":141417,"en":"Leaving none of them unvisited,"},{"id":"semetey-1-2013:p0842:b004:l014","ordinal":141418,"en":"They paid reverence as they went."},{"id":"semetey-1-2013:p0842:b004:l015","ordinal":141419,"en":"Crossing passes, moving along the road,"},{"id":"semetey-1-2013:p0842:b004:l016","ordinal":141420,"en":"Seeing many wondrous ridges,"},{"id":"semetey-1-2013:p0842:b004:l017","ordinal":141421,"en":"Seeing sacred places,"},{"id":"semetey-1-2013:p0842:b004:l018","ordinal":141422,"en":"Into jagged ridges,"},{"id":"semetey-1-2013:p0842:b004:l019","ordinal":141423,"en":"Into gaping places,"},{"id":"semetey-1-2013:p0842:b004:l020","ordinal":141424,"en":"They now came."},{"id":"semetey-1-2013:p0842:b004:l021","ordinal":141425,"en":"They saw a ridge rise from the level plain;"},{"id":"semetey-1-2013:p0842:b004:l022","ordinal":141426,"en":"As though a person had made them,"},{"id":"semetey-1-2013:p0842:b004:l023","ordinal":141427,"en":"They saw hills in various places."},{"id":"semetey-1-2013:p0842:b004:l024","ordinal":141428,"en":"Traveling day and night,"},{"id":"semetey-1-2013:p0842:b004:l025","ordinal":141429,"en":"They moved on with a rumble."},{"id":"semetey-1-2013:p0842:b004:l026","ordinal":141430,"en":"Traveling for many days,"},{"id":"semetey-1-2013:p0842:b004:l027","ordinal":141431,"en":"Moving far, no little distance,"},{"id":"semetey-1-2013:p0842:b004:l028","ordinal":141432,"en":"They journeyed eagerly without wearying."},{"id":"semetey-1-2013:p0842:b004:l029","ordinal":141433,"en":"A wondrous place no person had seen"},{"id":"semetey-1-2013:p0842:b004:l030","ordinal":141434,"en":"Came forth to meet them."},{"id":"semetey-1-2013:p0842:b004:l031","ordinal":141435,"en":"It had steep banks and hills,"},{"id":"semetey-1-2013:p0842:b004:l032","ordinal":141436,"en":"Places marvelous to behold,"},{"id":"semetey-1-2013:p0842:b004:l033","ordinal":141437,"en":"Hillocks and ridges."},{"id":"semetey-1-2013:p0842:b004:l034","ordinal":141438,"en":"Looking closely at this land,"},{"id":"semetey-1-2013:p0842:b004:l035","ordinal":141439,"en":"There were places beyond human telling."},{"id":"semetey-1-2013:p0842:b004:l036","ordinal":141440,"en":"Seeing craggy, jutting mountains,"},{"id":"semetey-1-2013:p0842:b004:l037","ordinal":141441,"en":"Seeing places no person trod,"},{"id":"semetey-1-2013:p0842:b004:l038","ordinal":141442,"en":"To a pass like a saddle ridge"},{"id":"semetey-1-2013:p0842:b004:l039","ordinal":141443,"en":"They now climbed."},{"id":"semetey-1-2013:p0843:b004:l001","ordinal":141444,"en":"When they climbed onto the ridge,"},{"id":"semetey-1-2013:p0843:b004:l002","ordinal":141445,"en":"Do not ask the hero’s state;"},{"id":"semetey-1-2013:p0843:b004:l003","ordinal":141446,"en":"When they climbed that hill,"},{"id":"semetey-1-2013:p0843:b004:l004","ordinal":141447,"en":"Do not ask your wretched mother’s state!"},{"id":"semetey-1-2013:p0843:b004:l005","ordinal":141448,"en":"When she beheld the land,"},{"id":"semetey-1-2013:p0843:b004:l006","ordinal":141449,"en":"She spoke of what its places meant."},{"id":"semetey-1-2013:p0843:b004:l007","ordinal":141450,"en":"“Showing through the haze—"},{"id":"semetey-1-2013:p0843:b004:l008","ordinal":141451,"en":"Oluya-Ata and broad Merki."},{"id":"semetey-1-2013:p0843:b004:l009","ordinal":141452,"en":"Oh, my orphan, what can I do?"},{"id":"semetey-1-2013:p0843:b004:l010","ordinal":141453,"en":"The past comes into my mind!"},{"id":"semetey-1-2013:p0843:b004:l011","ordinal":141454,"en":"Visible farther beyond,"},{"id":"semetey-1-2013:p0843:b004:l012","ordinal":141455,"en":"Kara-Balta and Sokuluk"},{"id":"semetey-1-2013:p0843:b004:l013","ordinal":141456,"en":"Show dark and beautiful."},{"id":"semetey-1-2013:p0843:b004:l014","ordinal":141457,"en":"Your mother, whose fortune has withered,"},{"id":"semetey-1-2013:p0843:b004:l015","ordinal":141458,"en":"Pours tears from her eyes."},{"id":"semetey-1-2013:p0843:b004:l016","ordinal":141459,"en":"My child whom I gained at death’s door,"},{"id":"semetey-1-2013:p0843:b004:l017","ordinal":141460,"en":"What is seen today is gone tomorrow;"},{"id":"semetey-1-2013:p0843:b004:l018","ordinal":141461,"en":"Such is this shitty world!"},{"id":"semetey-1-2013:p0843:b004:l019","ordinal":141462,"en":"That gaping gorge there—"},{"id":"semetey-1-2013:p0843:b004:l020","ordinal":141463,"en":"Listen to the torment, orphan;"},{"id":"semetey-1-2013:p0843:b004:l021","ordinal":141464,"en":"Your mother will tell much of her sorrow."},{"id":"semetey-1-2013:p0843:b004:l022","ordinal":141465,"en":"That is Küyük Pass."},{"id":"semetey-1-2013:p0843:b004:l023","ordinal":141466,"en":"My voice reached God,"},{"id":"semetey-1-2013:p0843:b004:l024","ordinal":141467,"en":"My very bones ached;"},{"id":"semetey-1-2013:p0843:b004:l025","ordinal":141468,"en":"I cried out, but God did not take me."},{"id":"semetey-1-2013:p0843:b004:l026","ordinal":141469,"en":"The place where she scattered her wealth,"},{"id":"semetey-1-2013:p0843:b004:l027","ordinal":141470,"en":"The place where your mother fled on foot,"},{"id":"semetey-1-2013:p0843:b004:l028","ordinal":141471,"en":"When your mother suffered humiliation,"},{"id":"semetey-1-2013:p0843:b004:l029","ordinal":141472,"en":"All these places,"},{"id":"semetey-1-2013:p0843:b004:l030","ordinal":141473,"en":"Leaving none, she crossed."},{"id":"semetey-1-2013:p0843:b004:l031","ordinal":141474,"en":"That gray, backward-sloping hill—"},{"id":"semetey-1-2013:p0843:b004:l032","ordinal":141475,"en":"That is the pass called Chakmak."},{"id":"semetey-1-2013:p0843:b004:l033","ordinal":141476,"en":"Weary from fleeing, exhausted,"},{"id":"semetey-1-2013:p0843:b004:l034","ordinal":141477,"en":"I was the wretch who lamented there."},{"id":"semetey-1-2013:p0843:b004:l035","ordinal":141478,"en":"The gray round hill, leaning back—"},{"id":"semetey-1-2013:p0843:b004:l036","ordinal":141479,"en":"That is Jorgo Pass."},{"id":"semetey-1-2013:p0843:b006:l001","ordinal":141480,"en":"Sobbing in grief, unable to cross,"},{"id":"semetey-1-2013:p0843:b006:l002","ordinal":141481,"en":"I was the one who suffered torment."},{"id":"semetey-1-2013:p0843:b006:l003","ordinal":141482,"en":"I, your mother Kanykei,"},{"id":"semetey-1-2013:p0843:b006:l004","ordinal":141483,"en":"Could not cross Küyük Pass;"},{"id":"semetey-1-2013:p0843:b006:l005","ordinal":141484,"en":"Burning with grief, I could not walk."},{"id":"semetey-1-2013:p0843:b006:l006","ordinal":141485,"en":"I could not cross Jorgo Pass;"},{"id":"semetey-1-2013:p0843:b006:l007","ordinal":141486,"en":"Sobbing in grief, I could not walk."},{"id":"semetey-1-2013:p0843:b006:l008","ordinal":141487,"en":"I could not cross Chakmak Pass;"},{"id":"semetey-1-2013:p0843:b006:l009","ordinal":141488,"en":"Weary and weeping, I could not walk."},{"id":"semetey-1-2013:p0843:b006:l010","ordinal":141489,"en":"Dark blood flowed from my calves;"},{"id":"semetey-1-2013:p0843:b006:l011","ordinal":141490,"en":"My strength left me, wretched as I was."},{"id":"semetey-1-2013:p0843:b006:l012","ordinal":141491,"en":"Swaying, dragging myself along,"},{"id":"semetey-1-2013:p0843:b006:l013","ordinal":141492,"en":"The skin of my soles all stripped away,"},{"id":"semetey-1-2013:p0843:b006:l014","ordinal":141493,"en":"My heels chafed,"},{"id":"semetey-1-2013:p0843:b006:l015","ordinal":141494,"en":"The flesh of my calves aching,"},{"id":"semetey-1-2013:p0843:b006:l016","ordinal":141495,"en":"For two days in one place"},{"id":"semetey-1-2013:p0843:b006:l017","ordinal":141496,"en":"Never lying down, I fled."},{"id":"semetey-1-2013:p0843:b006:l018","ordinal":141497,"en":"On the face of the earth, my precious life"},{"id":"semetey-1-2013:p0843:b006:l019","ordinal":141498,"en":"Found no room, and I fled."},{"id":"semetey-1-2013:p0843:b006:l020","ordinal":141499,"en":"A span of my flank rubbed raw,"},{"id":"semetey-1-2013:p0843:b006:l022","ordinal":141500,"en":"My heart plunged into darkness and pain,"},{"id":"semetey-1-2013:p0843:b006:l023","ordinal":141501,"en":"My orphan child, for your sake,"},{"id":"semetey-1-2013:p0843:b006:l024","ordinal":141502,"en":"What did I not see?"},{"id":"semetey-1-2013:p0843:b006:l025","ordinal":141503,"en":"What did I not become?"},{"id":"semetey-1-2013:p0843:b006:l026","ordinal":141504,"en":"When God laid this upon my head,"},{"id":"semetey-1-2013:p0843:b006:l027","ordinal":141505,"en":"Black night fell over me."},{"id":"semetey-1-2013:p0843:b006:l028","ordinal":141506,"en":"With no shoes, in my stockings,"},{"id":"semetey-1-2013:p0843:b006:l029","ordinal":141507,"en":"When your mother fled this way,"},{"id":"semetey-1-2013:p0843:b006:l030","ordinal":141508,"en":"Though I grieved, my wretched life would not end."},{"id":"semetey-1-2013:p0843:b006:l031","ordinal":141509,"en":"My boots worn out, in stockings,"},{"id":"semetey-1-2013:p0843:b006:l032","ordinal":141510,"en":"Unless He wished to take it,"},{"id":"semetey-1-2013:p0843:b006:l033","ordinal":141511,"en":"This obstinate life would not die!"},{"id":"semetey-1-2013:p0843:b006:l034","ordinal":141512,"en":"My child, for your sake,"},{"id":"semetey-1-2013:p0843:b006:l035","ordinal":141513,"en":"Sobbing, weeping, crying aloud,"},{"id":"semetey-1-2013:p0843:b006:l036","ordinal":141514,"en":"I called upon the dead."},{"id":"semetey-1-2013:p0844:b003:l001","ordinal":141515,"en":"“Though I speak, sorrow does not end;"},{"id":"semetey-1-2013:p0844:b003:l002","ordinal":141516,"en":"Your fierce father cannot be found."},{"id":"semetey-1-2013:p0844:b003:l003","ordinal":141517,"en":"Weeping and crying for so long,"},{"id":"semetey-1-2013:p0844:b003:l004","ordinal":141518,"en":"‘My bloodthirsty hero!’ I sobbed.”"},{"id":"semetey-1-2013:p0844:b003:l005","ordinal":141519,"en":"Your mother Kanykei said this,"},{"id":"semetey-1-2013:p0844:b003:l006","ordinal":141520,"en":"Told of terrors no one had heard,"},{"id":"semetey-1-2013:p0844:b003:l007","ordinal":141521,"en":"Told of ridge after ridge,"},{"id":"semetey-1-2013:p0844:b003:l008","ordinal":141522,"en":"Told of many separate places."},{"id":"semetey-1-2013:p0844:b003:l009","ordinal":141523,"en":"The yellow, hilly rises—"},{"id":"semetey-1-2013:p0844:b003:l010","ordinal":141524,"en":"They crossed their lower slopes."},{"id":"semetey-1-2013:p0844:b003:l011","ordinal":141525,"en":"The shrine of Oluya-Ata—"},{"id":"semetey-1-2013:p0844:b003:l012","ordinal":141526,"en":"They passed above it."},{"id":"semetey-1-2013:p0844:b003:l013","ordinal":141527,"en":"When they reached Oluya-Ata,"},{"id":"semetey-1-2013:p0844:b003:l014","ordinal":141528,"en":"The dark hill leaning backward"},{"id":"semetey-1-2013:p0844:b003:l015","ordinal":141529,"en":"Was the pass called Jorgo."},{"id":"semetey-1-2013:p0844:b003:l016","ordinal":141530,"en":"Your mother, grown familiar with it,"},{"id":"semetey-1-2013:p0844:b003:l017","ordinal":141531,"en":"Had crossed that place."},{"id":"semetey-1-2013:p0844:b003:l018","ordinal":141532,"en":"They crossed Jorgo Pass;"},{"id":"semetey-1-2013:p0844:b003:l019","ordinal":141533,"en":"The land they met was great Talas."},{"id":"semetey-1-2013:p0844:b003:l020","ordinal":141534,"en":"Hill after hill stood separate;"},{"id":"semetey-1-2013:p0844:b003:l021","ordinal":141535,"en":"The hilly mountain pass appeared."},{"id":"semetey-1-2013:p0844:b003:l022","ordinal":141536,"en":"The grass of the pass was sparse;"},{"id":"semetey-1-2013:p0844:b003:l023","ordinal":141537,"en":"Wild sheep poured down like sand."},{"id":"semetey-1-2013:p0844:b003:l024","ordinal":141538,"en":"Bit by bit,"},{"id":"semetey-1-2013:p0844:b003:l025","ordinal":141539,"en":"The grass on the hillocks was sparse;"},{"id":"semetey-1-2013:p0844:b003:l026","ordinal":141540,"en":"Deer poured down like sand."},{"id":"semetey-1-2013:p0844:b003:l027","ordinal":141541,"en":"Wild asses raced across the plain;"},{"id":"semetey-1-2013:p0844:b003:l028","ordinal":141542,"en":"Nightingales sang in the willows;"},{"id":"semetey-1-2013:p0844:b003:l029","ordinal":141543,"en":"Frogs croaked in the water;"},{"id":"semetey-1-2013:p0844:b003:l030","ordinal":141544,"en":"Cuckoos called from the mountains;"},{"id":"semetey-1-2013:p0844:b003:l031","ordinal":141545,"en":"Parrots spoke from the plane trees."},{"id":"semetey-1-2013:p0844:b003:l032","ordinal":141546,"en":"Looking closely at this Talas,"},{"id":"semetey-1-2013:p0844:b003:l033","ordinal":141547,"en":"Feather grass sways waist-high,"},{"id":"semetey-1-2013:p0844:b003:l034","ordinal":141548,"en":"Left deserted for twelve years,"},{"id":"semetey-1-2013:p0844:b003:l035","ordinal":141549,"en":"The land’s wild game was beyond counting,"},{"id":"semetey-1-2013:p0844:b003:l036","ordinal":141550,"en":"Its leaves varied in color;"},{"id":"semetey-1-2013:p0844:b003:l037","ordinal":141551,"en":"Roe deer barked from within."},{"id":"semetey-1-2013:p0844:b003:l038","ordinal":141552,"en":"Since the land had grown lush,"},{"id":"semetey-1-2013:p0844:b003:l039","ordinal":141553,"en":"Wild game had come to possess it."},{"id":"semetey-1-2013:p0844:b004:l001","ordinal":141554,"en":"The young of stags and hinds"},{"id":"semetey-1-2013:p0844:b004:l002","ordinal":141555,"en":"Chased one another."},{"id":"semetey-1-2013:p0844:b004:l003","ordinal":141556,"en":"There was no land astir with life,"},{"id":"semetey-1-2013:p0844:b004:l004","ordinal":141557,"en":"No people surging about,"},{"id":"semetey-1-2013:p0844:b004:l005","ordinal":141558,"en":"Not a crow to give a caw."},{"id":"semetey-1-2013:p0844:b004:l006","ordinal":141559,"en":"Talas lay deserted;"},{"id":"semetey-1-2013:p0844:b004:l007","ordinal":141560,"en":"Not a raven croaking there."},{"id":"semetey-1-2013:p0844:b004:l008","ordinal":141561,"en":"When she saw the deserted land,"},{"id":"semetey-1-2013:p0844:b004:l009","ordinal":141562,"en":"The yellow, hilly outline—"},{"id":"semetey-1-2013:p0844:b004:l010","ordinal":141563,"en":"Seeing the ridge, she wept;"},{"id":"semetey-1-2013:p0844:b004:l011","ordinal":141564,"en":"Broad Talas spread before her—"},{"id":"semetey-1-2013:p0844:b004:l012","ordinal":141565,"en":"Seeing the land, she wept."},{"id":"semetey-1-2013:p0844:b004:l013","ordinal":141566,"en":"Of Kara-Buura’s high grassy slopes,"},{"id":"semetey-1-2013:p0844:b004:l014","ordinal":141567,"en":"Seeing its secluded hollows, she wept."},{"id":"semetey-1-2013:p0844:b004:l015","ordinal":141568,"en":"The familiar Keng-Kol and Talas—"}]
