[{"id":"manas-2010:p1661:b001:l001","ordinal":71425,"en":"Knowing the Kyrgyz together,"},{"id":"manas-2010:p1661:b001:l002","ordinal":71426,"en":"When you lived in delight,"},{"id":"manas-2010:p1661:b001:l003","ordinal":71427,"en":"Ravaging Ombu and taking spoils,"},{"id":"manas-2010:p1661:b001:l004","ordinal":71428,"en":"Breaking through its center, opening a road,"},{"id":"manas-2010:p1661:b001:l006","ordinal":71429,"en":"When you were raiding it,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p1661:b001:l007","ordinal":71430,"en":"The Six Cities and Kokand,"},{"id":"manas-2010:p1661:b001:l008","ordinal":71431,"en":"Driving and beating them,"},{"id":"manas-2010:p1661:b001:l009","ordinal":71432,"en":"Six thousand silver ingots, a thousand otter pelts,"},{"id":"manas-2010:p1661:b001:l010","ordinal":71433,"en":"Imposing tribute each month,"},{"id":"manas-2010:p1661:b001:l011","ordinal":71434,"en":"When you were collecting it,"},{"id":"manas-2010:p1661:b001:l012","ordinal":71435,"en":"When you all stood together,"},{"id":"manas-2010:p1661:b001:l013","ordinal":71436,"en":"I would slice and eat horse rump;"},{"id":"manas-2010:p1661:b001:l014","ordinal":71437,"en":"Afflicting my own life,"},{"id":"manas-2010:p1661:b001:l015","ordinal":71438,"en":"I would say, ‘I shall overthrow the governor-general.’"},{"id":"manas-2010:p1661:b001:l016","ordinal":71439,"en":"Black-steel Zulpuqor—"},{"id":"manas-2010:p1661:b001:l018","ordinal":71440,"en":"Against the whole world, let alone China,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p1661:b001:l019","ordinal":71441,"en":"You would say, ‘I shall shoulder my way through.’"},{"id":"manas-2010:p1661:b001:l020","ordinal":71442,"en":"The thoughtfully crafted bulletproof armor,"},{"id":"manas-2010:p1661:b001:l021","ordinal":71443,"en":"You would say, ‘I shall put it on.’"},{"id":"manas-2010:p1661:b001:l022","ordinal":71444,"en":"If the handful of the Islamic faith"},{"id":"manas-2010:p1661:b001:l023","ordinal":71445,"en":"Had hardship fall upon their heads,"},{"id":"manas-2010:p1661:b001:l024","ordinal":71446,"en":"Against the eighteen thousand worlds,"},{"id":"manas-2010:p1661:b001:l025","ordinal":71447,"en":"You would say, ‘I shall rise in battle.’"},{"id":"manas-2010:p1661:b001:l026","ordinal":71448,"en":"If an enemy came grasping spears,"},{"id":"manas-2010:p1661:b001:l027","ordinal":71449,"en":"If a claim came from a place of hardship,"},{"id":"manas-2010:p1661:b001:l028","ordinal":71450,"en":"Clashing spears and shouting,"},{"id":"manas-2010:p1661:b001:l029","ordinal":71451,"en":"You would say, ‘I shall prevail.’"},{"id":"manas-2010:p1661:b001:l030","ordinal":71452,"en":"If upon your flanks, from the Chinese,"},{"id":"manas-2010:p1661:b001:l031","ordinal":71453,"en":"A terrible pressure came,"},{"id":"manas-2010:p1661:b001:l032","ordinal":71454,"en":"Entering without looking back, firing,"},{"id":"manas-2010:p1661:b001:l033","ordinal":71455,"en":"You, daughter-divorced, said, ‘I shall hold them off.’"},{"id":"manas-2010:p1661:b001:l034","ordinal":71456,"en":"A precious coat that bullets cannot pierce,"},{"id":"manas-2010:p1661:b001:l035","ordinal":71457,"en":"You would say, ‘I shall put it on.’"},{"id":"manas-2010:p1661:b001:l036","ordinal":71458,"en":"If the Muslims met with grievous trouble,"},{"id":"manas-2010:p1661:b001:l037","ordinal":71459,"en":"Entering without turning, firing,"},{"id":"manas-2010:p1661:b001:l038","ordinal":71460,"en":"You would say, ‘I shall hold them off.’"},{"id":"manas-2010:p1661:b001:l039","ordinal":71461,"en":"Does not a man whose death is due die?"},{"id":"manas-2010:p1661:b001:l040","ordinal":71462,"en":"Does not the poor mortal suffer hardship?"},{"id":"manas-2010:p1661:b001:l041","ordinal":71463,"en":"Will the black earth not hold us?"},{"id":"manas-2010:p1661:b001:l042","ordinal":71464,"en":"Will the grave dug for us not admit us?"},{"id":"manas-2010:p1662:b001:l001","ordinal":71465,"en":"Death is a great guest;"},{"id":"manas-2010:p1662:b001:l002","ordinal":71466,"en":"All those who have not died"},{"id":"manas-2010:p1662:b001:l003","ordinal":71467,"en":"Strive greedily while alive."},{"id":"manas-2010:p1662:b001:l004","ordinal":71468,"en":"From the Creator, the One Almighty,"},{"id":"manas-2010:p1662:b001:l005","ordinal":71469,"en":"When the firm command arrives,"},{"id":"manas-2010:p1662:b001:l006","ordinal":71470,"en":"Gabriel, taker of souls,"},{"id":"manas-2010:p1662:b001:l007","ordinal":71471,"en":"When he firmly stretches out five fingers,"},{"id":"manas-2010:p1662:b001:l008","ordinal":71472,"en":"Your ruddy complexion darkens."},{"id":"manas-2010:p1662:b001:l009","ordinal":71473,"en":"From this death standing here,"},{"id":"manas-2010:p1662:b001:l010","ordinal":71474,"en":"Heroes, what soul can flee and escape?"},{"id":"manas-2010:p1662:b001:l011","ordinal":71475,"en":"At the infidels coming darkly,"},{"id":"manas-2010:p1662:b001:l012","ordinal":71476,"en":"Let us go straight and thrust our spears;"},{"id":"manas-2010:p1662:b001:l013","ordinal":71477,"en":"From hell with its grievous burdens,"},{"id":"manas-2010:p1662:b001:l014","ordinal":71478,"en":"Warriors, let us free our souls!"},{"id":"manas-2010:p1662:b001:l015","ordinal":71479,"en":"At the swarming black infidels,"},{"id":"manas-2010:p1662:b001:l016","ordinal":71480,"en":"Let us charge and stretch out our swords;"},{"id":"manas-2010:p1662:b001:l017","ordinal":71481,"en":"From hell whose very news is grievous,"},{"id":"manas-2010:p1662:b001:l018","ordinal":71482,"en":"Warriors, let us free our souls!"},{"id":"manas-2010:p1662:b001:l019","ordinal":71483,"en":"Upon the swarming black infidels,"},{"id":"manas-2010:p1662:b001:l020","ordinal":71484,"en":"Let us unleash a furious battle."},{"id":"manas-2010:p1662:b001:l021","ordinal":71485,"en":"The tiny band of Islam,"},{"id":"manas-2010:p1662:b001:l022","ordinal":71486,"en":"If we do not rescue them,"},{"id":"manas-2010:p1662:b001:l023","ordinal":71487,"en":"Will they not recognize our ignorance?"},{"id":"manas-2010:p1662:b001:l024","ordinal":71488,"en":"That thing called disgrace,"},{"id":"manas-2010:p1662:b001:l025","ordinal":71489,"en":"Will they not hang it around our necks?"},{"id":"manas-2010:p1662:b001:l026","ordinal":71490,"en":"If what is said is true,"},{"id":"manas-2010:p1662:b001:l027","ordinal":71491,"en":"Tomorrow, on the Day of Resurrection,"},{"id":"manas-2010:p1662:b001:l028","ordinal":71492,"en":"‘You abandoned us,’ they will say;"},{"id":"manas-2010:p1662:b001:l029","ordinal":71493,"en":"The Muslims who died fighting"},{"id":"manas-2010:p1662:b001:l030","ordinal":71494,"en":"Will they not turn us into black donkeys and ride us?"},{"id":"manas-2010:p1662:b001:l031","ordinal":71495,"en":"At the infidels surging like waves,"},{"id":"manas-2010:p1662:b001:l032","ordinal":71496,"en":"Let us fight without stopping."},{"id":"manas-2010:p1662:b001:l033","ordinal":71497,"en":"The many Muslims there,"},{"id":"manas-2010:p1662:b001:l034","ordinal":71498,"en":"Oh heroes, let us rescue them!"},{"id":"manas-2010:p1662:b001:l035","ordinal":71499,"en":"Those left alive among the dead,"},{"id":"manas-2010:p1662:b001:l036","ordinal":71500,"en":"Will the Muslims not escape home?"},{"id":"manas-2010:p1662:b001:l037","ordinal":71501,"en":"‘Manas himself was absent;"},{"id":"manas-2010:p1662:b001:l038","ordinal":71502,"en":"The companions let us be slaughtered,’ they will say."},{"id":"manas-2010:p1662:b001:l039","ordinal":71503,"en":"Will they not spread such slander then?"},{"id":"manas-2010:p1662:b001:l040","ordinal":71504,"en":"Will your people not devour you with gossip?"},{"id":"manas-2010:p1662:b001:l041","ordinal":71505,"en":"‘Their leopard was not here;"},{"id":"manas-2010:p1662:b001:l042","ordinal":71506,"en":"The daughter-divorced forty companions"},{"id":"manas-2010:p1663:b001:l001","ordinal":71507,"en":"Died fleeing,’ will they not say?"},{"id":"manas-2010:p1663:b001:l002","ordinal":71508,"en":"‘All forty came from forty different lands,’ will they not say?"},{"id":"manas-2010:p1663:b001:l003","ordinal":71509,"en":"‘Manas, blessed by Kydyr, was not there;"},{"id":"manas-2010:p1663:b001:l004","ordinal":71510,"en":"The forty companions followed their own whims’—"},{"id":"manas-2010:p1663:b001:l005","ordinal":71511,"en":"Will they not devour us with such words?”"},{"id":"manas-2010:p1663:b001:l006","ordinal":71512,"en":"Almambet, Azizkan's son,"},{"id":"manas-2010:p1663:b001:l007","ordinal":71513,"en":"Surged forward like a lion;"},{"id":"manas-2010:p1663:b001:l008","ordinal":71514,"en":"Khan Manas's forty wolves"},{"id":"manas-2010:p1663:b001:l009","ordinal":71515,"en":"Entered together behind him."},{"id":"manas-2010:p1663:b001:l010","ordinal":71516,"en":"Seven Sufi teachers who came from Mecca,"},{"id":"manas-2010:p1663:b001:l011","ordinal":71517,"en":"They stationed in seven places."},{"id":"manas-2010:p1663:b001:l012","ordinal":71518,"en":"Wherever the fierce champions reached,"},{"id":"manas-2010:p1663:b001:l013","ordinal":71519,"en":"Wherever they reached, they made the Chinese crawl."},{"id":"manas-2010:p1663:b001:l014","ordinal":71520,"en":"They did not count the days,"},{"id":"manas-2010:p1663:b001:l015","ordinal":71521,"en":"They did not take rest each day,"},{"id":"manas-2010:p1663:b001:l016","ordinal":71522,"en":"They did not sleep propped on an elbow,"},{"id":"manas-2010:p1663:b001:l017","ordinal":71523,"en":"They took no peace in even a brief doze,"},{"id":"manas-2010:p1663:b001:l018","ordinal":71524,"en":"They did not rest at all by day."},{"id":"manas-2010:p1663:b001:l019","ordinal":71525,"en":"Almambet, Chubak, the forty companions—"},{"id":"manas-2010:p1663:b001:l020","ordinal":71526,"en":"Heroes, even in death there was no regret."},{"id":"manas-2010:p1663:b001:l021","ordinal":71527,"en":"The warriors shouted, “Islam!”"},{"id":"manas-2010:p1663:b001:l022","ordinal":71528,"en":"Called the battle cry, “Manas!”"},{"id":"manas-2010:p1663:b001:l023","ordinal":71529,"en":"The seething black infidels,"},{"id":"manas-2010:p1663:b001:l024","ordinal":71530,"en":"The dear heroes who entered the campaign,"},{"id":"manas-2010:p1663:b001:l025","ordinal":71531,"en":"Drove back, scattering them."},{"id":"manas-2010:p1663:b001:l026","ordinal":71532,"en":"The hero Khan Kongurbay,"},{"id":"manas-2010:p1663:b001:l027","ordinal":71533,"en":"They drove back, scattering him."},{"id":"manas-2010:p1663:b001:l028","ordinal":71534,"en":"Driving them in utter turmoil,"},{"id":"manas-2010:p1663:b001:l029","ordinal":71535,"en":"Killing whoever they met,"},{"id":"manas-2010:p1663:b001:l030","ordinal":71536,"en":"On the plain of Ötkööldük,"},{"id":"manas-2010:p1663:b001:l031","ordinal":71537,"en":"The Chinese seethed."},{"id":"manas-2010:p1663:b001:l032","ordinal":71538,"en":"Looking at the swarming throng,"},{"id":"manas-2010:p1663:b001:l033","ordinal":71539,"en":"Ajybay, Argyn Khan's son,"},{"id":"manas-2010:p1663:b001:l034","ordinal":71540,"en":"Into the hands of the Kalmyk called Lama,"},{"id":"manas-2010:p1663:b001:l035","ordinal":71541,"en":"Had fallen captive."},{"id":"manas-2010:p1663:b001:l036","ordinal":71542,"en":"Putting a hide torture-cap upon his head,"},{"id":"manas-2010:p1663:b001:l037","ordinal":71543,"en":"Your Ajyke, the Chinese"},{"id":"manas-2010:p1663:b001:l038","ordinal":71544,"en":"Had bound alive."},{"id":"manas-2010:p1663:b001:l039","ordinal":71545,"en":"“Almambet, Chubak, my twin champions,"},{"id":"manas-2010:p1663:b001:l040","ordinal":71546,"en":"When will my twins come?” he said;"},{"id":"manas-2010:p1663:b001:l041","ordinal":71547,"en":"Your Ajyke had lost consciousness."},{"id":"manas-2010:p1663:b001:l042","ordinal":71548,"en":"His eyes darted wildly,"},{"id":"manas-2010:p1664:b001:l001","ordinal":71549,"en":"Your Ajyke's two feet dangled."},{"id":"manas-2010:p1664:b001:l002","ordinal":71550,"en":"Across the saddle-shaped red desert,"},{"id":"manas-2010:p1664:b001:l003","ordinal":71551,"en":"Your Alake rode ahead;"},{"id":"manas-2010:p1664:b001:l004","ordinal":71552,"en":"Of your captured Ajy,"},{"id":"manas-2010:p1664:b001:l005","ordinal":71553,"en":"Your Alake rode nearby."},{"id":"manas-2010:p1664:b001:l006","ordinal":71554,"en":"When he saw your Ajyke,"},{"id":"manas-2010:p1664:b001:l007","ordinal":71555,"en":"Stretching his spear without restraint,"},{"id":"manas-2010:p1664:b001:l008","ordinal":71556,"en":"His back hunched behind him,"},{"id":"manas-2010:p1664:b001:l009","ordinal":71557,"en":"If you looked at his two eyes,"},{"id":"manas-2010:p1664:b001:l010","ordinal":71558,"en":"They bulged outward, staring;"},{"id":"manas-2010:p1664:b001:l011","ordinal":71559,"en":"His spear loomed in his hand."},{"id":"manas-2010:p1664:b001:l012","ordinal":71560,"en":"Chubak, Akbaltay's son,"},{"id":"manas-2010:p1664:b001:l013","ordinal":71561,"en":"Shouted, “Ajybay!”"},{"id":"manas-2010:p1664:b001:l014","ordinal":71562,"en":"He too charged, looming huge."},{"id":"manas-2010:p1664:b001:l015","ordinal":71563,"en":"Your utterly fierce lion Alma,"},{"id":"manas-2010:p1664:b001:l016","ordinal":71564,"en":"The Kalmyk Great Lama,"},{"id":"manas-2010:p1664:b001:l017","ordinal":71565,"en":"Reached him at that very spot."},{"id":"manas-2010:p1664:b001:l018","ordinal":71566,"en":"The painted spear in his hand,"},{"id":"manas-2010:p1664:b001:l019","ordinal":71567,"en":"Your Alake held steady;"},{"id":"manas-2010:p1664:b001:l020","ordinal":71568,"en":"Striking Sarala with his whip,"},{"id":"manas-2010:p1664:b001:l021","ordinal":71569,"en":"He arrived ahead of an arrow:"},{"id":"manas-2010:p1664:b001:l022","ordinal":71570,"en":"“At the edge of the hemp belt,” he said,"},{"id":"manas-2010:p1664:b001:l023","ordinal":71571,"en":"“Upon the right shoulder,” he said."},{"id":"manas-2010:p1664:b001:l024","ordinal":71572,"en":"Holding his spear short,"},{"id":"manas-2010:p1664:b001:l025","ordinal":71573,"en":"Your Alake struck as he passed."},{"id":"manas-2010:p1664:b001:l026","ordinal":71574,"en":"When your Alake struck in passing,"},{"id":"manas-2010:p1664:b001:l027","ordinal":71575,"en":"The Kalmyk Great Lama"},{"id":"manas-2010:p1664:b001:l028","ordinal":71576,"en":"Lost his seat upon the saddle,"},{"id":"manas-2010:p1664:b001:l029","ordinal":71577,"en":"His feet left the stirrups."},{"id":"manas-2010:p1664:b001:l030","ordinal":71578,"en":"His eyes darted wildly,"},{"id":"manas-2010:p1664:b001:l031","ordinal":71579,"en":"His feet dangled;"},{"id":"manas-2010:p1664:b001:l032","ordinal":71580,"en":"Shouting in his panic,"},{"id":"manas-2010:p1664:b001:l033","ordinal":71581,"en":"He cried the battle cry, “Come on!”"},{"id":"manas-2010:p1664:b001:l034","ordinal":71582,"en":"As he ran out of ways to escape,"},{"id":"manas-2010:p1664:b001:l035","ordinal":71583,"en":"Chubak, Akbaltay's son,"},{"id":"manas-2010:p1664:b001:l036","ordinal":71584,"en":"Your devastating Chubak arrived."},{"id":"manas-2010:p1664:b001:l037","ordinal":71585,"en":"Taking Oykuma in hand,"},{"id":"manas-2010:p1664:b001:l038","ordinal":71586,"en":"As he reached Lama,"},{"id":"manas-2010:p1664:b001:l040","ordinal":71587,"en":"His dear head flew off and fell,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p1664:b001:l041","ordinal":71588,"en":"His blood spilled upon the foothills."},{"id":"manas-2010:p1664:b001:l042","ordinal":71589,"en":"Striking Sarala,"},{"id":"manas-2010:p1665:b001:l001","ordinal":71590,"en":"Turning back toward the Kalmyks,"},{"id":"manas-2010:p1665:b001:l002","ordinal":71591,"en":"Your leopard Alma reached them;"},{"id":"manas-2010:p1665:b001:l003","ordinal":71592,"en":"Throwing them into utter turmoil,"},{"id":"manas-2010:p1665:b001:l004","ordinal":71593,"en":"He drove the Kalmyks before him!"},{"id":"manas-2010:p1665:b001:l005","ordinal":71594,"en":"Almambet, Azizkan's son,"},{"id":"manas-2010:p1665:b001:l006","ordinal":71595,"en":"When he slashed and slashed,"},{"id":"manas-2010:p1665:b001:l007","ordinal":71596,"en":"Twelve died at once."},{"id":"manas-2010:p1665:b001:l008","ordinal":71597,"en":"Your devastating, renowned Alma"},{"id":"manas-2010:p1665:b001:l009","ordinal":71598,"en":"Reached Ajybay."},{"id":"manas-2010:p1665:b001:l010","ordinal":71599,"en":"As he reached your Ajy,"},{"id":"manas-2010:p1665:b001:l011","ordinal":71600,"en":"Slung behind him like a feedbag,"},{"id":"manas-2010:p1665:b001:l012","ordinal":71601,"en":"Your Ajyke, Almambet"},{"id":"manas-2010:p1665:b001:l013","ordinal":71602,"en":"Snatched up and fled past."},{"id":"manas-2010:p1665:b001:l014","ordinal":71603,"en":"Then, with golden forelock, tasseled belt,"},{"id":"manas-2010:p1665:b001:l015","ordinal":71604,"en":"Almambet, Azizkan's son,"},{"id":"manas-2010:p1665:b001:l016","ordinal":71605,"en":"When he saw Kongurbay,"},{"id":"manas-2010:p1665:b001:l017","ordinal":71606,"en":"Sarala beneath him,"},{"id":"manas-2010:p1665:b001:l018","ordinal":71607,"en":"He urged with alternating heels,"},{"id":"manas-2010:p1665:b001:l019","ordinal":71608,"en":"Struck with the whip on either side;"},{"id":"manas-2010:p1665:b001:l020","ordinal":71609,"en":"Your consummate Khan Alma"},{"id":"manas-2010:p1665:b001:l021","ordinal":71610,"en":"Reached Kongurbay ahead of an arrow."},{"id":"manas-2010:p1665:b001:l022","ordinal":71611,"en":"Reaching the grim-faced one,"},{"id":"manas-2010:p1665:b001:l023","ordinal":71612,"en":"From Algara's back,"},{"id":"manas-2010:p1665:b001:l024","ordinal":71613,"en":"He knocked him down as he passed."},{"id":"manas-2010:p1665:b001:l025","ordinal":71614,"en":"His nose bulged like a leather bag;"},{"id":"manas-2010:p1665:b001:l026","ordinal":71615,"en":"From Algara's back,"},{"id":"manas-2010:p1665:b001:l027","ordinal":71616,"en":"Kongurbay flew off,"},{"id":"manas-2010:p1665:b001:l028","ordinal":71617,"en":"Huge as Mount Opol."},{"id":"manas-2010:p1665:b001:l029","ordinal":71618,"en":"I do not know where he came from,"},{"id":"manas-2010:p1665:b001:l030","ordinal":71619,"en":"Chubak, Khan Baltay's son,"},{"id":"manas-2010:p1665:b001:l031","ordinal":71620,"en":"Consummate Chubak, the dear hero—"},{"id":"manas-2010:p1665:b001:l032","ordinal":71621,"en":"As he was reaching Kongurbay,"},{"id":"manas-2010:p1665:b001:l033","ordinal":71622,"en":"About to reach him and cut off his head,"},{"id":"manas-2010:p1665:b001:l034","ordinal":71623,"en":"Then Kongurbay's forty nobles"},{"id":"manas-2010:p1665:b001:l035","ordinal":71624,"en":"Together thrust their spears at Chubak."},{"id":"manas-2010:p1665:b001:l036","ordinal":71625,"en":"The grim-faced one, fallen from his horse,"},{"id":"manas-2010:p1665:b001:l037","ordinal":71626,"en":"They took and mounted on a horse,"},{"id":"manas-2010:p1665:b001:l038","ordinal":71627,"en":"They rescued him."},{"id":"manas-2010:p1665:b001:l039","ordinal":71628,"en":"Sixty sorcerers, a multitude of marksmen,"},{"id":"manas-2010:p1665:b001:l040","ordinal":71629,"en":"Their elder Kojozhash,"},{"id":"manas-2010:p1665:b001:l041","ordinal":71630,"en":"Blocked the way from the hills."},{"id":"manas-2010:p1665:b001:l042","ordinal":71631,"en":"Kojozhash surpassed all in marksmanship;"},{"id":"manas-2010:p1666:b001:l001","ordinal":71632,"en":"A hulking mountain upon the ridge,"},{"id":"manas-2010:p1666:b001:l002","ordinal":71633,"en":"He hid among the feather grass,"},{"id":"manas-2010:p1666:b001:l003","ordinal":71634,"en":"Dressed in bright red colors,"},{"id":"manas-2010:p1666:b001:l004","ordinal":71635,"en":"Running ahead of an arrow,"},{"id":"manas-2010:p1666:b001:l005","ordinal":71636,"en":"The wind could not match his trot,"},{"id":"manas-2010:p1666:b001:l006","ordinal":71637,"en":"No beast could match his stride."},{"id":"manas-2010:p1666:b001:l007","ordinal":71638,"en":"(The Chinese fled from ridge to ridge,"},{"id":"manas-2010:p1666:b001:l008","ordinal":71639,"en":"Rushed away.)"},{"id":"manas-2010:p1666:b001:l009","ordinal":71640,"en":"While Chubak wielded his sword,"},{"id":"manas-2010:p1666:b001:l010","ordinal":71641,"en":"Then Kojozhash, Karazhoy's son,"},{"id":"manas-2010:p1666:b001:l011","ordinal":71642,"en":"Clad in green, changing his appearance,"},{"id":"manas-2010:p1666:b001:l012","ordinal":71643,"en":"Chubak before him,"},{"id":"manas-2010:p1666:b001:l013","ordinal":71644,"en":"Oh hero, lay watching him."},{"id":"manas-2010:p1666:b001:l014","ordinal":71645,"en":"Then grease came from his thumb;"},{"id":"manas-2010:p1666:b001:l015","ordinal":71646,"en":"Of that enraged infidel,"},{"id":"manas-2010:p1666:b001:l016","ordinal":71647,"en":"Blood came from his nails."},{"id":"manas-2010:p1666:b001:l017","ordinal":71648,"en":"Without staggering or hurrying in confusion,"},{"id":"manas-2010:p1666:b001:l018","ordinal":71649,"en":"Never missing the point he fixed his gaze on,"},{"id":"manas-2010:p1666:b001:l019","ordinal":71650,"en":"The dog's trigger stood ready;"},{"id":"manas-2010:p1666:b001:l020","ordinal":71651,"en":"A master in marksmanship."},{"id":"manas-2010:p1666:b001:l021","ordinal":71652,"en":"Chubak, Akbaltay's son,"},{"id":"manas-2010:p1666:b001:l022","ordinal":71653,"en":"Oh hero, his appointed death had come!"},{"id":"manas-2010:p1666:b001:l023","ordinal":71654,"en":"From a whip's length to his flank,"},{"id":"manas-2010:p1666:b001:l024","ordinal":71655,"en":"With a steel bullet in his hand,"},{"id":"manas-2010:p1666:b001:l025","ordinal":71656,"en":"Then the practiced marksman fired once!"},{"id":"manas-2010:p1666:b001:l026","ordinal":71657,"en":"Oh hero, the matchlock shot struck his belly,"},{"id":"manas-2010:p1666:b001:l027","ordinal":71658,"en":"Fire flashed upon Chubak's breast!"},{"id":"manas-2010:p1666:b001:l028","ordinal":71659,"en":"Then, with life barely remaining,"},{"id":"manas-2010:p1666:b001:l029","ordinal":71660,"en":"Amid dust that hid the earth,"},{"id":"manas-2010:p1666:b001:l030","ordinal":71661,"en":"The yellow gold taken from Beijing,"},{"id":"manas-2010:p1666:b001:l031","ordinal":71662,"en":"He scattered it as he went—did you see?"},{"id":"manas-2010:p1666:b001:l032","ordinal":71663,"en":"Your Chubak, turned coward, toward his people,"},{"id":"manas-2010:p1666:b001:l033","ordinal":71664,"en":"Fled away—did you see?"},{"id":"manas-2010:p1666:b001:l035","ordinal":71665,"en":"Chubak, Khan Baltay's son,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"manas-2010:p1666:b001:l036","ordinal":71666,"en":"Fled away to his people."},{"id":"manas-2010:p1666:b001:l037","ordinal":71667,"en":"Down the single road of It-Ölbös,"},{"id":"manas-2010:p1666:b001:l038","ordinal":71668,"en":"He fled and escaped."},{"id":"manas-2010:p1666:b001:l039","ordinal":71669,"en":"Kögala, the supernaturally supported racer,"},{"id":"manas-2010:p1666:b001:l040","ordinal":71670,"en":"Akbaltay's only son,"},{"id":"manas-2010:p1666:b001:l041","ordinal":71671,"en":"Oh hero, carried him away in flight and escaped."},{"id":"manas-2010:p1666:b001:l042","ordinal":71672,"en":"The handful of the Islamic faith,"},{"id":"manas-2010:p1667:b001:l001","ordinal":71673,"en":"Turned back and rushed away."},{"id":"manas-2010:p1667:b001:l002","ordinal":71674,"en":"The swine dressed in green, changing his appearance;"},{"id":"manas-2010:p1667:b001:l003","ordinal":71675,"en":"Bokmurun, Kökötöy's son,"},{"id":"manas-2010:p1667:b001:l004","ordinal":71676,"en":"Hero Shygay of the Zhediger,"},{"id":"manas-2010:p1667:b001:l005","ordinal":71677,"en":"He struck both together with one shot."},{"id":"manas-2010:p1667:b001:l006","ordinal":71678,"en":"Khan Koshoy of the Katagan,"},{"id":"manas-2010:p1667:b001:l007","ordinal":71679,"en":"Zhamgyrchy of the Eshtek—"},{"id":"manas-2010:p1667:b001:l008","ordinal":71680,"en":"Bokmurun and hero Shygay,"}]
