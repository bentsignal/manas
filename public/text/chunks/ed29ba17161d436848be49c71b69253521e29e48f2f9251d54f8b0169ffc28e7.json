[{"id":"semetey-1-2013:p1199:b003:l015","ordinal":167681,"en":"The lions Agybay and Bakai"},{"id":"semetey-1-2013:p1199:b003:l016","ordinal":167682,"en":"Would make a massacre"},{"id":"semetey-1-2013:p1199:b003:l017","ordinal":167683,"en":"Of the fucking Chinese as they passed."},{"id":"semetey-1-2013:p1199:b003:l018","ordinal":167684,"en":"Hero Manas the leopard,"},{"id":"semetey-1-2013:p1199:b003:l019","ordinal":167685,"en":"His nose bulging like a leather flask,"},{"id":"semetey-1-2013:p1199:b003:l020","ordinal":167686,"en":"Was truly seized by thirst for blood."},{"id":"semetey-1-2013:p1199:b003:l021","ordinal":167687,"en":"Manas had forty companions;"},{"id":"semetey-1-2013:p1199:b003:l022","ordinal":167688,"en":"Kongurbay had forty princes."},{"id":"semetey-1-2013:p1199:b003:l023","ordinal":167689,"en":"Behind Kongurbay"},{"id":"semetey-1-2013:p1199:b003:l024","ordinal":167690,"en":"Were bellowing Manchus,"},{"id":"semetey-1-2013:p1199:b003:l025","ordinal":167691,"en":"Swaying Shibe,"},{"id":"semetey-1-2013:p1199:b003:l026","ordinal":167692,"en":"Their cuirasses hanging loose,"},{"id":"semetey-1-2013:p1199:b003:l027","ordinal":167693,"en":"And all the kalday governors."},{"id":"semetey-1-2013:p1199:b003:l028","ordinal":167694,"en":"Among Kongurbay's supporters"},{"id":"semetey-1-2013:p1199:b003:l029","ordinal":167695,"en":"Were skillful spearmen"},{"id":"semetey-1-2013:p1199:b003:l030","ordinal":167696,"en":"And excellent bowmen."},{"id":"semetey-1-2013:p1199:b003:l031","ordinal":167697,"en":"There were warriors no horse could bear;"},{"id":"semetey-1-2013:p1199:b003:l032","ordinal":167698,"en":"If they happened to dismount,"},{"id":"semetey-1-2013:p1199:b003:l033","ordinal":167699,"en":"They would reach a man before an arrow,"},{"id":"semetey-1-2013:p1199:b003:l034","ordinal":167700,"en":"And upon reaching the fucking wretch,"},{"id":"semetey-1-2013:p1199:b003:l035","ordinal":167701,"en":"Lift him and mount him on a horse."},{"id":"semetey-1-2013:p1199:b003:l036","ordinal":167702,"en":"There were footmen skilled in mounted games;"},{"id":"semetey-1-2013:p1199:b003:l037","ordinal":167703,"en":"There were giants unlike human beings."},{"id":"semetey-1-2013:p1199:b003:l038","ordinal":167704,"en":"Each had made ready to fight;"},{"id":"semetey-1-2013:p1199:b003:l039","ordinal":167705,"en":"Those fine fellows had come."},{"id":"semetey-1-2013:p1199:b003:l040","ordinal":167706,"en":"Were it not for Manas the leopard,"},{"id":"semetey-1-2013:p1199:b004:l001","ordinal":167707,"en":"The many kinds of Chinese"},{"id":"semetey-1-2013:p1199:b004:l002","ordinal":167708,"en":"Would all have engulfed them"},{"id":"semetey-1-2013:p1199:b004:l003","ordinal":167709,"en":"And brought them together to their end."},{"id":"semetey-1-2013:p1199:b004:l004","ordinal":167710,"en":"The reason they could engulf them was this:"},{"id":"semetey-1-2013:p1199:b004:l005","ordinal":167711,"en":"They came as a flood covering the land,"},{"id":"semetey-1-2013:p1199:b004:l006","ordinal":167712,"en":"As one with the face of the earth—"},{"id":"semetey-1-2013:p1199:b004:l007","ordinal":167713,"en":"The infidels had come."},{"id":"semetey-1-2013:p1199:b004:l008","ordinal":167714,"en":"If you looked at Kongurbay,"},{"id":"semetey-1-2013:p1199:b004:l009","ordinal":167715,"en":"He too was a blue-maned lion."},{"id":"semetey-1-2013:p1199:b004:l010","ordinal":167716,"en":"Jerking his golden reins,"},{"id":"semetey-1-2013:p1199:b004:l011","ordinal":167717,"en":"Making Algara rear and lunge,"},{"id":"semetey-1-2013:p1199:b004:l012","ordinal":167718,"en":"He turned the black horse's head."},{"id":"semetey-1-2013:p1199:b004:l013","ordinal":167719,"en":"The carefree Kalcha khan"},{"id":"semetey-1-2013:p1199:b004:l014","ordinal":167720,"en":"Stood facing the single combat."},{"id":"semetey-1-2013:p1199:b004:l015","ordinal":167721,"en":"Then Manas said this:"},{"id":"semetey-1-2013:p1199:b004:l016","ordinal":167722,"en":"“This one was the khan of the Chinese,"},{"id":"semetey-1-2013:p1199:b004:l017","ordinal":167723,"en":"And I was the khan of the Muslims."},{"id":"semetey-1-2013:p1199:b004:l018","ordinal":167724,"en":"If I do not grant him his turn,"},{"id":"semetey-1-2013:p1199:b004:l019","ordinal":167725,"en":"It will seem I am mocking him;"},{"id":"semetey-1-2013:p1199:b004:l020","ordinal":167726,"en":"If I do not give him the first course,"},{"id":"semetey-1-2013:p1199:b004:l021","ordinal":167727,"en":"It will seem I am mistreating him."},{"id":"semetey-1-2013:p1199:b004:l022","ordinal":167728,"en":"Take your turn, Chinese!” he said."},{"id":"semetey-1-2013:p1199:b004:l023","ordinal":167729,"en":"Khan Manas stood upon the bank."},{"id":"semetey-1-2013:p1199:b004:l024","ordinal":167730,"en":"Kongurbay charged and thrust;"},{"id":"semetey-1-2013:p1199:b004:l025","ordinal":167731,"en":"The leopard born of a lion"},{"id":"semetey-1-2013:p1199:b004:l026","ordinal":167732,"en":"Did not flinch at the ringing blow."},{"id":"semetey-1-2013:p1199:b004:l027","ordinal":167733,"en":"Kongurbay's bronze spear"},{"id":"semetey-1-2013:p1199:b004:l028","ordinal":167734,"en":"Shattered and flew apart;"},{"id":"semetey-1-2013:p1199:b004:l029","ordinal":167735,"en":"He did not count it worth his trouser cuff."},{"id":"semetey-1-2013:p1199:b004:l030","ordinal":167736,"en":"“Take your turn, Burut,” he said."},{"id":"semetey-1-2013:p1199:b004:l031","ordinal":167737,"en":"Kongurbay stood stretching tall."},{"id":"semetey-1-2013:p1199:b004:l032","ordinal":167738,"en":"The Chinese warrior stood on the height;"},{"id":"semetey-1-2013:p1199:b004:l033","ordinal":167739,"en":"Hero Manas stretched and thrust."},{"id":"semetey-1-2013:p1199:b004:l034","ordinal":167740,"en":"The bronze spear broke apart completely;"},{"id":"semetey-1-2013:p1199:b004:l035","ordinal":167741,"en":"Kongurbay did not start."},{"id":"semetey-1-2013:p1199:b004:l036","ordinal":167742,"en":"Khan Agybay came"},{"id":"semetey-1-2013:p1199:b004:l037","ordinal":167743,"en":"Galloping on Kartküröng."},{"id":"semetey-1-2013:p1199:b004:l038","ordinal":167744,"en":"Into your bloodthirsty hero's hand"},{"id":"semetey-1-2013:p1199:b004:l039","ordinal":167745,"en":"He gave another spear."},{"id":"semetey-1-2013:p1200:b003:l001","ordinal":167746,"en":"Kongurbay charged and thrust;"},{"id":"semetey-1-2013:p1200:b003:l002","ordinal":167747,"en":"Khan Manas did not sway."},{"id":"semetey-1-2013:p1200:b003:l003","ordinal":167748,"en":"The leopard thrust from the side;"},{"id":"semetey-1-2013:p1200:b003:l004","ordinal":167749,"en":"Kongurbay did not sway."},{"id":"semetey-1-2013:p1200:b003:l005","ordinal":167750,"en":"They thrust in turns,"},{"id":"semetey-1-2013:p1200:b003:l006","ordinal":167751,"en":"Shouting as they leveled their spears."},{"id":"semetey-1-2013:p1200:b003:l007","ordinal":167752,"en":"Kongurbay and Manas then"},{"id":"semetey-1-2013:p1200:b003:l008","ordinal":167753,"en":"Broke sixty spears."},{"id":"semetey-1-2013:p1200:b003:l009","ordinal":167754,"en":"The teeming Chinese roared,"},{"id":"semetey-1-2013:p1200:b003:l010","ordinal":167755,"en":"Crying their Kakan battle cry."},{"id":"semetey-1-2013:p1200:b003:l011","ordinal":167756,"en":"The Muslim faithful roared,"},{"id":"semetey-1-2013:p1200:b003:l012","ordinal":167757,"en":"Crying their Islam battle cry."},{"id":"semetey-1-2013:p1200:b003:l013","ordinal":167758,"en":"May God never show us such a sight:"},{"id":"semetey-1-2013:p1200:b003:l014","ordinal":167759,"en":"Their spear points struck,"},{"id":"semetey-1-2013:p1200:b003:l015","ordinal":167760,"en":"Driving each other up and down."},{"id":"semetey-1-2013:p1200:b003:l016","ordinal":167761,"en":"When they fought with spears,"},{"id":"semetey-1-2013:p1200:b003:l017","ordinal":167762,"en":"The spears broke and splintered;"},{"id":"semetey-1-2013:p1200:b003:l018","ordinal":167763,"en":"Shafts thick as cauldron handles"},{"id":"semetey-1-2013:p1200:b003:l019","ordinal":167764,"en":"Flew about with a clatter."},{"id":"semetey-1-2013:p1200:b003:l020","ordinal":167765,"en":"Chasing and thrusting at one another,"},{"id":"semetey-1-2013:p1200:b003:l021","ordinal":167766,"en":"God had struck them."},{"id":"semetey-1-2013:p1200:b003:l022","ordinal":167767,"en":"The madman's Black Horse"},{"id":"semetey-1-2013:p1200:b003:l023","ordinal":167768,"en":"Had grown warm down to its flesh."},{"id":"semetey-1-2013:p1200:b003:l024","ordinal":167769,"en":"Thrusting three times for every single thrust,"},{"id":"semetey-1-2013:p1200:b003:l025","ordinal":167770,"en":"Kongurbay meant to prove himself."},{"id":"semetey-1-2013:p1200:b003:l026","ordinal":167771,"en":"The copper lance gave a shrill cry;"},{"id":"semetey-1-2013:p1200:b003:l027","ordinal":167772,"en":"In the broad ravine where no bird flew,"},{"id":"semetey-1-2013:p1200:b003:l028","ordinal":167773,"en":"No enemy escaped the spear,"},{"id":"semetey-1-2013:p1200:b003:l029","ordinal":167774,"en":"No person escaped death."},{"id":"semetey-1-2013:p1200:b003:l030","ordinal":167775,"en":"Alöökö's Kongurbay"},{"id":"semetey-1-2013:p1200:b003:l031","ordinal":167776,"en":"Showed the form of a lion;"},{"id":"semetey-1-2013:p1200:b003:l032","ordinal":167777,"en":"His courage was unlike another soul's,"},{"id":"semetey-1-2013:p1200:b003:l033","ordinal":167778,"en":"And it was plain he was a hero."},{"id":"semetey-1-2013:p1200:b003:l034","ordinal":167779,"en":"Shouting as he extended his spear,"},{"id":"semetey-1-2013:p1200:b003:l035","ordinal":167780,"en":"Crying the Möndü battle cry,"},{"id":"semetey-1-2013:p1200:b003:l036","ordinal":167781,"en":"Kongurbay now reached"},{"id":"semetey-1-2013:p1200:b003:l037","ordinal":167782,"en":"Blue-maned Manas himself."},{"id":"semetey-1-2013:p1200:b003:l038","ordinal":167783,"en":"When he reached him, the bronze spear"},{"id":"semetey-1-2013:p1200:b003:l039","ordinal":167784,"en":"Struck him and drove through."},{"id":"semetey-1-2013:p1200:b004:l001","ordinal":167785,"en":"Did you see that he was"},{"id":"semetey-1-2013:p1200:b004:l002","ordinal":167786,"en":"The strength of Beijing's Chinese?"},{"id":"semetey-1-2013:p1200:b004:l003","ordinal":167787,"en":"Did you see that renowned Kongurbay"},{"id":"semetey-1-2013:p1200:b004:l004","ordinal":167788,"en":"Was a lion?"},{"id":"semetey-1-2013:p1200:b004:l005","ordinal":167789,"en":"Kalkaman's Black Horse,"},{"id":"semetey-1-2013:p1200:b004:l006","ordinal":167790,"en":"Its pelvis narrow and its strength slight,"},{"id":"semetey-1-2013:p1200:b004:l007","ordinal":167791,"en":"Seemed about to fall backward."},{"id":"semetey-1-2013:p1200:b004:l008","ordinal":167792,"en":"When it rose upright"},{"id":"semetey-1-2013:p1200:b004:l009","ordinal":167793,"en":"And was about to topple over,"},{"id":"semetey-1-2013:p1200:b004:l010","ordinal":167794,"en":"As Manas neared the ground,"},{"id":"semetey-1-2013:p1200:b004:l011","ordinal":167795,"en":"Manas seized"},{"id":"semetey-1-2013:p1200:b004:l012","ordinal":167796,"en":"The Zulpukor in his hand"},{"id":"semetey-1-2013:p1200:b004:l013","ordinal":167797,"en":"And cut the infidel's bronze spear"},{"id":"semetey-1-2013:p1200:b004:l014","ordinal":167798,"en":"Clean through the middle."},{"id":"semetey-1-2013:p1200:b004:l015","ordinal":167799,"en":"His spear broke and vanished;"},{"id":"semetey-1-2013:p1200:b004:l016","ordinal":167800,"en":"Was Manas not upheld by Shai?"},{"id":"semetey-1-2013:p1200:b004:l017","ordinal":167801,"en":"The lion Manas righted himself."},{"id":"semetey-1-2013:p1200:b004:l018","ordinal":167802,"en":"Fastening his clasps,"},{"id":"semetey-1-2013:p1200:b004:l019","ordinal":167803,"en":"He put on Akolpok."},{"id":"semetey-1-2013:p1200:b004:l020","ordinal":167804,"en":"Sarala, who had accompanied him—"},{"id":"semetey-1-2013:p1200:b004:l021","ordinal":167805,"en":"He sprang bareback"},{"id":"semetey-1-2013:p1200:b004:l022","ordinal":167806,"en":"Onto the bow-like thoroughbred."},{"id":"semetey-1-2013:p1200:b004:l023","ordinal":167807,"en":"Roaring like Opol-Too,"},{"id":"semetey-1-2013:p1200:b004:l024","ordinal":167808,"en":"Noble Manas caught him."},{"id":"semetey-1-2013:p1200:b004:l025","ordinal":167809,"en":"Before the teeming Chinese host,"},{"id":"semetey-1-2013:p1200:b004:l026","ordinal":167810,"en":"Before he could dodge away,"},{"id":"semetey-1-2013:p1200:b004:l027","ordinal":167811,"en":"The mighty khan Manas"},{"id":"semetey-1-2013:p1200:b004:l028","ordinal":167812,"en":"Struck the Kamar-like Kalcha"},{"id":"semetey-1-2013:p1200:b004:l029","ordinal":167813,"en":"And passed on."},{"id":"semetey-1-2013:p1200:b004:l030","ordinal":167814,"en":"From atop Algara,"},{"id":"semetey-1-2013:p1200:b004:l031","ordinal":167815,"en":"As though a mountain had collapsed,"},{"id":"semetey-1-2013:p1200:b004:l032","ordinal":167816,"en":"Alöökö's Kongurbay"},{"id":"semetey-1-2013:p1200:b004:l033","ordinal":167817,"en":"Fell crashing down."},{"id":"semetey-1-2013:p1200:b004:l034","ordinal":167818,"en":"Khan Manas raged,"},{"id":"semetey-1-2013:p1200:b004:l035","ordinal":167819,"en":"Roaring like Opol-Too."},{"id":"semetey-1-2013:p1200:b004:l036","ordinal":167820,"en":"When noble Manas came,"},{"id":"semetey-1-2013:p1200:b004:l037","ordinal":167821,"en":"The Manchu people wailed,"},{"id":"semetey-1-2013:p1200:b004:l038","ordinal":167822,"en":"Bowing like young brides,"},{"id":"semetey-1-2013:p1202:b003:l001","ordinal":167823,"en":"They scattered and cleared the road."},{"id":"semetey-1-2013:p1202:b003:l002","ordinal":167824,"en":"The consummate, peerless Manas"},{"id":"semetey-1-2013:p1202:b003:l003","ordinal":167825,"en":"Reached him before an arrow."},{"id":"semetey-1-2013:p1202:b003:l004","ordinal":167826,"en":"Kongurbay's Algara—"},{"id":"semetey-1-2013:p1202:b003:l005","ordinal":167827,"en":"He caught it then"},{"id":"semetey-1-2013:p1202:b003:l006","ordinal":167828,"en":"And took it away as booty."},{"id":"semetey-1-2013:p1202:b003:l007","ordinal":167829,"en":"Sarala flew like an arrow,"},{"id":"semetey-1-2013:p1202:b003:l008","ordinal":167830,"en":"Taking the narrow shortcut;"},{"id":"semetey-1-2013:p1202:b003:l009","ordinal":167831,"en":"Kongurbay's Algara"},{"id":"semetey-1-2013:p1202:b003:l010","ordinal":167832,"en":"He turned toward the lowlands,"},{"id":"semetey-1-2013:p1202:b003:l011","ordinal":167833,"en":"Leading it away as booty."},{"id":"semetey-1-2013:p1202:b003:l012","ordinal":167834,"en":"As Manas was taking it away,"},{"id":"semetey-1-2013:p1202:b003:l013","ordinal":167835,"en":"His knees bending to the ground,"},{"id":"semetey-1-2013:p1202:b003:l014","ordinal":167836,"en":"Alöökö's Kongurbay"},{"id":"semetey-1-2013:p1202:b003:l015","ordinal":167837,"en":"Said, “Leave Algara with me,”"},{"id":"semetey-1-2013:p1202:b003:l016","ordinal":167838,"en":"And, turning aside toward Manas,"},{"id":"semetey-1-2013:p1202:b003:l017","ordinal":167839,"en":"Bowed like a young bride."},{"id":"semetey-1-2013:p1202:b003:l018","ordinal":167840,"en":"As Kongurbay stood this way,"},{"id":"semetey-1-2013:p1202:b003:l019","ordinal":167841,"en":"Crying, “Generous Manas, grant it as a gift!”"},{"id":"semetey-1-2013:p1202:b003:l020","ordinal":167842,"en":"Almambet came from beyond,"},{"id":"semetey-1-2013:p1202:b003:l021","ordinal":167843,"en":"Flying like an arrow, his limbs outstretched,"},{"id":"semetey-1-2013:p1202:b003:l022","ordinal":167844,"en":"Crying, “Generous Manas, grant it as a gift!”"},{"id":"semetey-1-2013:p1202:b003:l023","ordinal":167845,"en":"The two skirts of his coat flapping."},{"id":"semetey-1-2013:p1202:b003:l024","ordinal":167846,"en":"Before Almambet could reach him,"},{"id":"semetey-1-2013:p1202:b003:l025","ordinal":167847,"en":"Kongurbay's Algara—"},{"id":"semetey-1-2013:p1202:b003:l026","ordinal":167848,"en":"Before he could take it away as booty,"},{"id":"semetey-1-2013:p1202:b003:l027","ordinal":167849,"en":"Khan Manas thought wisely:"},{"id":"semetey-1-2013:p1202:b003:l028","ordinal":167850,"en":"“Another man's coat is no coat;"},{"id":"semetey-1-2013:p1202:b003:l029","ordinal":167851,"en":"Another man's horse is no horse."},{"id":"semetey-1-2013:p1202:b003:l030","ordinal":167852,"en":"Kongurbay was a hero;"},{"id":"semetey-1-2013:p1202:b003:l031","ordinal":167853,"en":"What shall I do with his horse?"},{"id":"semetey-1-2013:p1202:b003:l032","ordinal":167854,"en":"If I seize his horse,"},{"id":"semetey-1-2013:p1202:b003:l033","ordinal":167855,"en":"What inheritance will it bring me?"},{"id":"semetey-1-2013:p1202:b003:l034","ordinal":167856,"en":"Better than that, here and now,"},{"id":"semetey-1-2013:p1202:b003:l035","ordinal":167857,"en":"I will leave his horse with him.”"},{"id":"semetey-1-2013:p1202:b003:l036","ordinal":167858,"en":"To the Kalcha who stood bowing,"},{"id":"semetey-1-2013:p1202:b003:l037","ordinal":167859,"en":"Manas showed his contempt."},{"id":"semetey-1-2013:p1202:b003:l038","ordinal":167860,"en":"“Here, infidel, is your horse,” he said."},{"id":"semetey-1-2013:p1202:b003:l039","ordinal":167861,"en":"Snarling in anger,"},{"id":"semetey-1-2013:p1202:b004:l001","ordinal":167862,"en":"He hurled the reins knotted with an okoro"},{"id":"semetey-1-2013:p1202:b004:l002","ordinal":167863,"en":"Toward Kongurbay."},{"id":"semetey-1-2013:p1202:b004:l003","ordinal":167864,"en":"The many Manchus, barely standing,"},{"id":"semetey-1-2013:p1202:b004:l004","ordinal":167865,"en":"Took Algara"},{"id":"semetey-1-2013:p1202:b004:l005","ordinal":167866,"en":"And set the infidels' master horseman and footrunner,"},{"id":"semetey-1-2013:p1202:b004:l006","ordinal":167867,"en":"The lion Kongur Kalcha,"},{"id":"semetey-1-2013:p1202:b004:l007","ordinal":167868,"en":"Upon the horse."},{"id":"semetey-1-2013:p1202:b004:l008","ordinal":167869,"en":"The helpless Almambet,"},{"id":"semetey-1-2013:p1202:b004:l009","ordinal":167870,"en":"With many cares too great for his breast,"},{"id":"semetey-1-2013:p1202:b004:l010","ordinal":167871,"en":"Said, “Alas, bloodthirsty man, may you never prosper!”"},{"id":"semetey-1-2013:p1202:b004:l011","ordinal":167872,"en":"His tears streamed in ten directions."},{"id":"semetey-1-2013:p1202:b004:l012","ordinal":167873,"en":"“Alas, Manas, may you come to ruin;"},{"id":"semetey-1-2013:p1202:b004:l013","ordinal":167874,"en":"May you never have a second chance!"},{"id":"semetey-1-2013:p1202:b004:l014","ordinal":167875,"en":"Would anyone release"},{"id":"semetey-1-2013:p1202:b004:l015","ordinal":167876,"en":"A hare that had fallen into his hands?"},{"id":"semetey-1-2013:p1202:b004:l016","ordinal":167877,"en":"Could anyone be like you?!"},{"id":"semetey-1-2013:p1202:b004:l017","ordinal":167878,"en":"Lion prince, leopard,"},{"id":"semetey-1-2013:p1202:b004:l018","ordinal":167879,"en":"Could any person behave so?"},{"id":"semetey-1-2013:p1202:b004:l019","ordinal":167880,"en":"Was Kongurbay not"},{"id":"semetey-1-2013:p1202:b004:l020","ordinal":167881,"en":"The strength of steadfast Beijing?"},{"id":"semetey-1-2013:p1202:b004:l021","ordinal":167882,"en":"Had you given me Algara,"},{"id":"semetey-1-2013:p1202:b004:l022","ordinal":167883,"en":"Would I not have drawn the line?"},{"id":"semetey-1-2013:p1202:b004:l023","ordinal":167884,"en":"Would I not have made sport"},{"id":"semetey-1-2013:p1202:b004:l024","ordinal":167885,"en":"Of the dark mass of Chinese?"},{"id":"semetey-1-2013:p1202:b004:l025","ordinal":167886,"en":"If he were parted from Algara,"},{"id":"semetey-1-2013:p1202:b004:l026","ordinal":167887,"en":"Would I not have shown him the city?"},{"id":"semetey-1-2013:p1202:b004:l027","ordinal":167888,"en":"Would I not have brought upon the Chinese"},{"id":"semetey-1-2013:p1202:b004:l028","ordinal":167889,"en":"A calamity no person had seen?"},{"id":"semetey-1-2013:p1202:b004:l029","ordinal":167890,"en":"Would I not have requited my old grievance"},{"id":"semetey-1-2013:p1202:b004:l030","ordinal":167891,"en":"And exacted from the Kalcha"},{"id":"semetey-1-2013:p1202:b004:l031","ordinal":167892,"en":"My affliction from long ago?"},{"id":"semetey-1-2013:p1202:b004:l032","ordinal":167893,"en":"From Beijing itself,"},{"id":"semetey-1-2013:p1202:b004:l033","ordinal":167894,"en":"This Kongurbay will not disappear."},{"id":"semetey-1-2013:p1202:b004:l034","ordinal":167895,"en":"Unless this Kongurbay dies"},{"id":"semetey-1-2013:p1202:b004:l035","ordinal":167896,"en":"And beholds the face of Judgment Day,"},{"id":"semetey-1-2013:p1202:b004:l036","ordinal":167897,"en":"The Kyrgyz cause will not prosper."},{"id":"semetey-1-2013:p1202:b004:l037","ordinal":167898,"en":"He is that renowned, formidable stronghold;"},{"id":"semetey-1-2013:p1202:b004:l038","ordinal":167899,"en":"He is that lion unlike any mortal,"},{"id":"semetey-1-2013:p1202:b004:l039","ordinal":167900,"en":"The most skillful among spearmen—"}]
