[{"id":"manas-2010:p1685:b001:l023","ordinal":72449,"en":"His dear eyes like a saker falcon's,"},{"id":"manas-2010:p1685:b001:l024","ordinal":72450,"en":"Unblinking, filled with tears."},{"id":"manas-2010:p1685:b001:l025","ordinal":72451,"en":"Wounded Manas grieved,"},{"id":"manas-2010:p1685:b001:l026","ordinal":72452,"en":"His rib bones felt torn apart,"},{"id":"manas-2010:p1685:b001:l027","ordinal":72453,"en":"Your khan's heart was distracted."},{"id":"manas-2010:p1685:b001:l028","ordinal":72454,"en":"When he grew furious,"},{"id":"manas-2010:p1685:b001:l029","ordinal":72455,"en":"If you watched his face,"},{"id":"manas-2010:p1685:b001:l030","ordinal":72456,"en":"His bloodlust gripped him hard;"},{"id":"manas-2010:p1685:b001:l031","ordinal":72457,"en":"Hair rose in sock-thick tufts."},{"id":"manas-2010:p1685:b001:l032","ordinal":72458,"en":"Then Manas shook and heaved."},{"id":"manas-2010:p1685:b001:l033","ordinal":72459,"en":"When he heard dear Alma's plight,"},{"id":"manas-2010:p1685:b001:l034","ordinal":72460,"en":"He roared in fury."},{"id":"manas-2010:p1685:b001:l035","ordinal":72461,"en":"His eyes blazed like a lion's."},{"id":"manas-2010:p1685:b001:l036","ordinal":72462,"en":"His great teeth, like doors,"},{"id":"manas-2010:p1685:b001:l037","ordinal":72463,"en":"Your khan, leopard Manas,"},{"id":"manas-2010:p1685:b001:l038","ordinal":72464,"en":"Ground them apart, piece by piece."},{"id":"manas-2010:p1685:b001:l039","ordinal":72465,"en":"“My companion, my twin lamb!"},{"id":"manas-2010:p1685:b001:l040","ordinal":72466,"en":"Having devoured my twins,"},{"id":"manas-2010:p1685:b001:l041","ordinal":72467,"en":"How can I go on now?"},{"id":"manas-2010:p1685:b001:l042","ordinal":72468,"en":"The decree Allah has laid down"},{"id":"manas-2010:p1686:b001:l001","ordinal":72469,"en":"Has fallen upon my neck—unless I face it,"},{"id":"manas-2010:p1686:b001:l002","ordinal":72470,"en":"Bereft of the noble ones,"},{"id":"manas-2010:p1686:b001:l003","ordinal":72471,"en":"Rather than stand empty and helpless,"},{"id":"manas-2010:p1686:b001:l004","ordinal":72472,"en":"Unless I enter Beijing and die,"},{"id":"manas-2010:p1686:b001:l005","ordinal":72473,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1686:b001:l006","ordinal":72474,"en":"Unless I cut off his head,"},{"id":"manas-2010:p1686:b001:l007","ordinal":72475,"en":"Kojozhash, son of Karazhoy,"},{"id":"manas-2010:p1686:b001:l008","ordinal":72476,"en":"The champion who slaughtered my Alma,"},{"id":"manas-2010:p1686:b001:l009","ordinal":72477,"en":"Unless I seize him in the field"},{"id":"manas-2010:p1686:b001:l010","ordinal":72478,"en":"And offer him as a sacrifice,"},{"id":"manas-2010:p1686:b001:l011","ordinal":72479,"en":"The Kara-Kytay in Altay,"},{"id":"manas-2010:p1686:b001:l012","ordinal":72480,"en":"Unless I drive them through Altay,"},{"id":"manas-2010:p1686:b001:l013","ordinal":72481,"en":"The black Kalmyks in Khangay,"},{"id":"manas-2010:p1686:b001:l014","ordinal":72482,"en":"Unless I drive them into Khangay,"},{"id":"manas-2010:p1686:b001:l015","ordinal":72483,"en":"The ill-willed Chinese,"},{"id":"manas-2010:p1686:b001:l016","ordinal":72484,"en":"Unless I drive them all the way to Beijing,"},{"id":"manas-2010:p1686:b001:l017","ordinal":72485,"en":"May I die no longer Manas!"},{"id":"manas-2010:p1686:b001:l018","ordinal":72486,"en":"Bereft of the mighty ones,"},{"id":"manas-2010:p1686:b001:l019","ordinal":72487,"en":"Rather than stand watching in anguish,"},{"id":"manas-2010:p1686:b001:l020","ordinal":72488,"en":"Let me sink away as though never born."},{"id":"manas-2010:p1686:b001:l021","ordinal":72489,"en":"Among the jacket-wearing governors,"},{"id":"manas-2010:p1686:b001:l022","ordinal":72490,"en":"Let me seize the strongest."},{"id":"manas-2010:p1686:b001:l023","ordinal":72491,"en":"Among the Chinese with rank-buttons,"},{"id":"manas-2010:p1686:b001:l024","ordinal":72492,"en":"Killing the finest,"},{"id":"manas-2010:p1686:b001:l025","ordinal":72493,"en":"Let me avenge Almambet."},{"id":"manas-2010:p1686:b001:l026","ordinal":72494,"en":"Laying waste their broad lands,"},{"id":"manas-2010:p1686:b001:l027","ordinal":72495,"en":"The Chinese taken alive"},{"id":"manas-2010:p1686:b001:l028","ordinal":72496,"en":"Enslaving till Judgment Day,"},{"id":"manas-2010:p1686:b001:l029","ordinal":72497,"en":"Thus let me take my vengeance!”"},{"id":"manas-2010:p1686:b001:l030","ordinal":72498,"en":"As the generous one stood grieving,"},{"id":"manas-2010:p1686:b001:l031","ordinal":72499,"en":"The Muslims, at their wits' end,"},{"id":"manas-2010:p1686:b001:l032","ordinal":72500,"en":"Stood bewildered and wept."},{"id":"manas-2010:p1686:b001:l033","ordinal":72501,"en":"To the fierce-maned one barely enduring,"},{"id":"manas-2010:p1686:b001:l034","ordinal":72502,"en":"The God-struck Muslims"},{"id":"manas-2010:p1686:b001:l035","ordinal":72503,"en":"Cried out their complaints."},{"id":"manas-2010:p1686:b001:l036","ordinal":72504,"en":"Some spoke,"},{"id":"manas-2010:p1686:b001:l037","ordinal":72505,"en":"Saying, “I have only one horse.”"},{"id":"manas-2010:p1686:b001:l038","ordinal":72506,"en":"Mostly they spoke nonsense,"},{"id":"manas-2010:p1686:b001:l039","ordinal":72507,"en":"Saying, “I am an only son.”"},{"id":"manas-2010:p1686:b001:l040","ordinal":72508,"en":"Khan Manas grew furious:"},{"id":"manas-2010:p1686:b001:l041","ordinal":72509,"en":"“Whoever says, ‘I have only one horse’—"},{"id":"manas-2010:p1686:b001:l042","ordinal":72510,"en":"Your father's grave, Muslims!—"},{"id":"manas-2010:p1687:b001:l001","ordinal":72511,"en":"I shall slaughter his horse and eat it too."},{"id":"manas-2010:p1687:b001:l002","ordinal":72512,"en":"Whoever says, ‘I am an only son,’"},{"id":"manas-2010:p1687:b001:l003","ordinal":72513,"en":"I shall slaughter him and eat him too."},{"id":"manas-2010:p1687:b001:l004","ordinal":72514,"en":"Whoever says, ‘My strength is feeble,’"},{"id":"manas-2010:p1687:b001:l005","ordinal":72515,"en":"I shall slaughter him now and eat him too!"},{"id":"manas-2010:p1687:b001:l006","ordinal":72516,"en":"If my darling dies, if lives are lost,"},{"id":"manas-2010:p1687:b001:l007","ordinal":72517,"en":"If all the heroes die,"},{"id":"manas-2010:p1687:b001:l008","ordinal":72518,"en":"What answer will you give?"},{"id":"manas-2010:p1687:b001:l009","ordinal":72519,"en":"You people born witless as swine,"},{"id":"manas-2010:p1687:b001:l010","ordinal":72520,"en":"What are you babbling about?"},{"id":"manas-2010:p1687:b001:l011","ordinal":72521,"en":"If you lack courage, worthless people,"},{"id":"manas-2010:p1687:b001:l012","ordinal":72522,"en":"You will destroy this multitude."},{"id":"manas-2010:p1687:b001:l013","ordinal":72523,"en":"If all of you scatter,"},{"id":"manas-2010:p1687:b001:l014","ordinal":72524,"en":"Following your every trace,"},{"id":"manas-2010:p1687:b001:l015","ordinal":72525,"en":"Will they not pursue and scatter you?"},{"id":"manas-2010:p1687:b001:l016","ordinal":72526,"en":"You wailing, worthless people,"},{"id":"manas-2010:p1687:b001:l017","ordinal":72527,"en":"If you are divided, will your Chinese"},{"id":"manas-2010:p1687:b001:l018","ordinal":72528,"en":"Not slaughter every one of you?”"},{"id":"manas-2010:p1687:b001:l019","ordinal":72529,"en":"As Khan Manas stood speaking thus,"},{"id":"manas-2010:p1687:b001:l020","ordinal":72530,"en":"Your multitude trembled,"},{"id":"manas-2010:p1687:b001:l021","ordinal":72531,"en":"Your people quivered helplessly."},{"id":"manas-2010:p1687:b001:l022","ordinal":72532,"en":"When the mighty generous lion"},{"id":"manas-2010:p1687:b001:l023","ordinal":72533,"en":"Gave one shout,"},{"id":"manas-2010:p1687:b001:l024","ordinal":72534,"en":"Their collarbones shook;"},{"id":"manas-2010:p1687:b001:l025","ordinal":72535,"en":"The Muslims were struck speechless,"},{"id":"manas-2010:p1687:b001:l026","ordinal":72536,"en":"All shuddering together."},{"id":"manas-2010:p1687:b001:l027","ordinal":72537,"en":"All the warriors grieved;"},{"id":"manas-2010:p1687:b001:l028","ordinal":72538,"en":"The worthless men without courage"},{"id":"manas-2010:p1687:b001:l029","ordinal":72539,"en":"Despaired of their dear lives."},{"id":"manas-2010:p1687:b001:l030","ordinal":72540,"en":"Their eyes widened;"},{"id":"manas-2010:p1687:b001:l031","ordinal":72541,"en":"Your many people stood distressed."},{"id":"manas-2010:p1687:b001:l032","ordinal":72542,"en":"Blood-drinking leopard Manas"},{"id":"manas-2010:p1687:b001:l033","ordinal":72543,"en":"Now firmly mustered his courage."},{"id":"manas-2010:p1687:b001:l034","ordinal":72544,"en":"Earlier, over the khoja in Kokand,"},{"id":"manas-2010:p1687:b001:l035","ordinal":72545,"en":"When his power had reached him,"},{"id":"manas-2010:p1687:b001:l036","ordinal":72546,"en":"Mungchu in Bukhara,"},{"id":"manas-2010:p1687:b001:l037","ordinal":72547,"en":"When he had overthrown him,"},{"id":"manas-2010:p1687:b001:l038","ordinal":72548,"en":"The Six Cities and Andijan,"},{"id":"manas-2010:p1687:b001:l039","ordinal":72549,"en":"Down to Kokand and Marghilan,"},{"id":"manas-2010:p1687:b001:l040","ordinal":72550,"en":"Upon these places, tumult"},{"id":"manas-2010:p1687:b001:l041","ordinal":72551,"en":"When he had brought it,"},{"id":"manas-2010:p1687:b001:l042","ordinal":72552,"en":"Six thousand silver ingots, a thousand beaver pelts,"},{"id":"manas-2010:p1688:b001:l001","ordinal":72553,"en":"Such was the tribute, like this,"},{"id":"manas-2010:p1688:b001:l002","ordinal":72554,"en":"Month by month from the Sarts,"},{"id":"manas-2010:p1688:b001:l003","ordinal":72555,"en":"When he was taking tribute,"},{"id":"manas-2010:p1688:b001:l004","ordinal":72556,"en":"Disorder upon the face of the earth"},{"id":"manas-2010:p1688:b001:l005","ordinal":72557,"en":"When he was bringing it:"},{"id":"manas-2010:p1688:b001:l006","ordinal":72558,"en":"The gray leather belt descended from heaven,"},{"id":"manas-2010:p1688:b001:l007","ordinal":72559,"en":"The belt that befriended his dear life."},{"id":"manas-2010:p1688:b001:l008","ordinal":72560,"en":"Some ignorant people say,"},{"id":"manas-2010:p1688:b001:l009","ordinal":72561,"en":"“When he brought oppression to Kokand,"},{"id":"manas-2010:p1688:b001:l010","ordinal":72562,"en":"It was a belt he took as booty.”"},{"id":"manas-2010:p1688:b001:l011","ordinal":72563,"en":"Those who know say,"},{"id":"manas-2010:p1688:b001:l012","ordinal":72564,"en":"“A gray leather belt descended from heaven,"},{"id":"manas-2010:p1688:b001:l013","ordinal":72565,"en":"A belt that befriends life held in trust."},{"id":"manas-2010:p1688:b001:l014","ordinal":72566,"en":"When he shouted and bound it at his waist,"},{"id":"manas-2010:p1688:b001:l015","ordinal":72567,"en":"The forty hidden saints became his companions."},{"id":"manas-2010:p1688:b001:l016","ordinal":72568,"en":"When he cried out and bound it at his waist,"},{"id":"manas-2010:p1688:b001:l017","ordinal":72569,"en":"The white holy man led his camp."},{"id":"manas-2010:p1688:b001:l018","ordinal":72570,"en":"If an enemy came forth to fight,"},{"id":"manas-2010:p1688:b001:l019","ordinal":72571,"en":"Driving them and shouting,"},{"id":"manas-2010:p1688:b001:l020","ordinal":72572,"en":"The leopard slaughtered them all.”"},{"id":"manas-2010:p1688:b001:l021","ordinal":72573,"en":"He had tethered Akkula;"},{"id":"manas-2010:p1688:b001:l022","ordinal":72574,"en":"If an enemy met him in battle,"},{"id":"manas-2010:p1688:b001:l023","ordinal":72575,"en":"Their misery boiled up."},{"id":"manas-2010:p1688:b001:l024","ordinal":72576,"en":"His protector, Khojosan,"},{"id":"manas-2010:p1688:b001:l025","ordinal":72577,"en":"Prepared beneath his arm;"},{"id":"manas-2010:p1688:b001:l026","ordinal":72578,"en":"A black-spotted lion"},{"id":"manas-2010:p1688:b001:l027","ordinal":72579,"en":"Raged at his flank."},{"id":"manas-2010:p1688:b001:l028","ordinal":72580,"en":"To bring slaughter upon the Chinese,"},{"id":"manas-2010:p1688:b001:l029","ordinal":72581,"en":"Your mighty lord prepared."},{"id":"manas-2010:p1688:b001:l030","ordinal":72582,"en":"Akkula, wondrous among steeds,"},{"id":"manas-2010:p1688:b001:l031","ordinal":72583,"en":"Whose trot the wind could not match,"},{"id":"manas-2010:p1688:b001:l032","ordinal":72584,"en":"Whose walk no beast could match,"},{"id":"manas-2010:p1688:b001:l033","ordinal":72585,"en":"The hardy, noble-blooded charger,"},{"id":"manas-2010:p1688:b001:l034","ordinal":72586,"en":"With sieve-like lungs and copper wings,"},{"id":"manas-2010:p1688:b001:l035","ordinal":72587,"en":"Would not tire if ridden six months."},{"id":"manas-2010:p1688:b001:l036","ordinal":72588,"en":"Your noble one's Akkula,"},{"id":"manas-2010:p1688:b001:l037","ordinal":72589,"en":"Until sixty years into his maturity,"},{"id":"manas-2010:p1688:b001:l038","ordinal":72590,"en":"Would not grow old with worn-down molars."},{"id":"manas-2010:p1688:b001:l039","ordinal":72591,"en":"A bulletproof fine white covering—"},{"id":"manas-2010:p1688:b001:l040","ordinal":72592,"en":"Made by that bitch Kanykey,"},{"id":"manas-2010:p1688:b001:l041","ordinal":72593,"en":"A covering perfectly fitted to Akkula."},{"id":"manas-2010:p1688:b001:l042","ordinal":72594,"en":"Taking his battle-axe in hand,"},{"id":"manas-2010:p1689:b001:l001","ordinal":72595,"en":"Thundering in fury,"},{"id":"manas-2010:p1689:b001:l002","ordinal":72596,"en":"From the stone stronghold firmly held,"},{"id":"manas-2010:p1689:b001:l003","ordinal":72597,"en":"Then Manas came pounding,"},{"id":"manas-2010:p1689:b001:l004","ordinal":72598,"en":"Your distinguished champion Manas."},{"id":"manas-2010:p1689:b001:l005","ordinal":72599,"en":"How could the lion spare himself?"},{"id":"manas-2010:p1689:b001:l006","ordinal":72600,"en":"Leaning upon Akkelte,"},{"id":"manas-2010:p1689:b001:l007","ordinal":72601,"en":"He went straight inward,"},{"id":"manas-2010:p1689:b001:l008","ordinal":72602,"en":"Leading Akkula."},{"id":"manas-2010:p1689:b001:l009","ordinal":72603,"en":"The dear lion, like a fighting cock,"},{"id":"manas-2010:p1689:b001:l010","ordinal":72604,"en":"Stood stiffly gazing on."},{"id":"manas-2010:p1689:b001:l011","ordinal":72605,"en":"Then Kojozhash, son of Karazhoy,"},{"id":"manas-2010:p1689:b001:l012","ordinal":72606,"en":"Bent his knees to the earth;"},{"id":"manas-2010:p1689:b001:l013","ordinal":72607,"en":"Running faster than an arrow,"},{"id":"manas-2010:p1689:b001:l014","ordinal":72608,"en":"His marksmanship surpassing all,"},{"id":"manas-2010:p1689:b001:l015","ordinal":72609,"en":"At the ridge's black cliff,"},{"id":"manas-2010:p1689:b001:l016","ordinal":72610,"en":"Kojozhash reached concealment."},{"id":"manas-2010:p1689:b001:l017","ordinal":72611,"en":"Clad in red garments,"},{"id":"manas-2010:p1689:b001:l018","ordinal":72612,"en":"Coiling more tightly than a flea,"},{"id":"manas-2010:p1689:b001:l019","ordinal":72613,"en":"Before him the many Chinese generals"},{"id":"manas-2010:p1689:b001:l020","ordinal":72614,"en":"Fled with a thunderous rush."},{"id":"manas-2010:p1689:b001:l021","ordinal":72615,"en":"A shot would not pierce Manas himself;"},{"id":"manas-2010:p1689:b001:l022","ordinal":72616,"en":"Akkula beneath him—"},{"id":"manas-2010:p1689:b001:l023","ordinal":72617,"en":"Kojozhash, lying in wait,"},{"id":"manas-2010:p1689:b001:l024","ordinal":72618,"en":"Fired once at the vertebra."},{"id":"manas-2010:p1689:b001:l025","ordinal":72619,"en":"The projectile reached its mark;"},{"id":"manas-2010:p1689:b001:l026","ordinal":72620,"en":"Where it struck Akkula,"},{"id":"manas-2010:p1689:b001:l027","ordinal":72621,"en":"The first neck vertebra's bone"},{"id":"manas-2010:p1689:b001:l028","ordinal":72622,"en":"It grazed as it passed."},{"id":"manas-2010:p1689:b001:l029","ordinal":72623,"en":"The leopard's Akkula,"},{"id":"manas-2010:p1689:b001:l030","ordinal":72624,"en":"Dark blood flowed from his neck artery."},{"id":"manas-2010:p1689:b001:l031","ordinal":72625,"en":"Your Sultan Manas heaved;"},{"id":"manas-2010:p1689:b001:l032","ordinal":72626,"en":"Your king's strength ebbed."},{"id":"manas-2010:p1689:b001:l033","ordinal":72627,"en":"The leopard's Akkula"},{"id":"manas-2010:p1689:b001:l034","ordinal":72628,"en":"Neighed once,"},{"id":"manas-2010:p1689:b001:l035","ordinal":72629,"en":"Turned toward Manas,"},{"id":"manas-2010:p1689:b001:l036","ordinal":72630,"en":"And rested his chin upon him."},{"id":"manas-2010:p1689:b001:l037","ordinal":72631,"en":"Then Khan Manas saw"},{"id":"manas-2010:p1689:b001:l038","ordinal":72632,"en":"The falsehood of this world."},{"id":"manas-2010:p1689:b001:l039","ordinal":72633,"en":"The wondrously swift dun horse"},{"id":"manas-2010:p1689:b001:l040","ordinal":72634,"en":"Had not a spoonful of blood left."},{"id":"manas-2010:p1689:b001:l041","ordinal":72635,"en":"When he tried to lead him, he would not stand."},{"id":"manas-2010:p1689:b001:l042","ordinal":72636,"en":"Turning to face the north,"},{"id":"manas-2010:p1690:b001:l001","ordinal":72637,"en":"As though a mountain fell,"},{"id":"manas-2010:p1690:b001:l002","ordinal":72638,"en":"Your wretched one's Akkula"},{"id":"manas-2010:p1690:b001:l003","ordinal":72639,"en":"Collapsed at that moment."},{"id":"manas-2010:p1690:b001:l004","ordinal":72640,"en":"“Perish, world of torment!” he cried."},{"id":"manas-2010:p1690:b001:l005","ordinal":72641,"en":"Unable to stand bearing such sorrow,"},{"id":"manas-2010:p1690:b001:l006","ordinal":72642,"en":"The king bit his thumb till it split."},{"id":"manas-2010:p1690:b001:l007","ordinal":72643,"en":"The white saber with its striped neck"},{"id":"manas-2010:p1690:b001:l008","ordinal":72644,"en":"The dear lion seized"},{"id":"manas-2010:p1690:b001:l009","ordinal":72645,"en":"And slaughtered Akkula."},{"id":"manas-2010:p1690:b001:l010","ordinal":72646,"en":"“Perish, immeasurable world!"},{"id":"manas-2010:p1690:b001:l011","ordinal":72647,"en":"How can I arrive without dying?"},{"id":"manas-2010:p1690:b001:l012","ordinal":72648,"en":"If I see Talas alive,"},{"id":"manas-2010:p1690:b001:l013","ordinal":72649,"en":"My beloved Akkula's forelock"},{"id":"manas-2010:p1690:b001:l014","ordinal":72650,"en":"I shall smell as a keepsake.”"},{"id":"manas-2010:p1690:b001:l015","ordinal":72651,"en":"His ear and forelock"},{"id":"manas-2010:p1690:b001:l016","ordinal":72652,"en":"Your champion cut off."},{"id":"manas-2010:p1690:b001:l017","ordinal":72653,"en":"Moaning, he could only smell them;"},{"id":"manas-2010:p1690:b001:l018","ordinal":72654,"en":"Clasping them, he could only smell them."},{"id":"manas-2010:p1690:b001:l019","ordinal":72655,"en":"‘My companion, my dun horse!’ he said, smelling them."},{"id":"manas-2010:p1690:b001:l020","ordinal":72656,"en":"Your champion Manas, the fierce-maned khan,"},{"id":"manas-2010:p1690:b001:l021","ordinal":72657,"en":"Affliction upon his toil-worn life,"},{"id":"manas-2010:p1690:b001:l022","ordinal":72658,"en":"The leopard stood in deep distress."},{"id":"manas-2010:p1690:b001:l023","ordinal":72659,"en":"How could your champion spare himself?"},{"id":"manas-2010:p1690:b001:l024","ordinal":72660,"en":"Leaning upon Akkelte,"},{"id":"manas-2010:p1690:b001:l025","ordinal":72661,"en":"Having lost Akkula to a bullet,"},{"id":"manas-2010:p1690:b001:l026","ordinal":72662,"en":"Having let Almambet pass as a martyr,"},{"id":"manas-2010:p1690:b001:l027","ordinal":72663,"en":"Having had his wings broken,"},{"id":"manas-2010:p1690:b001:l028","ordinal":72664,"en":"Sitting in mourning,"},{"id":"manas-2010:p1690:b001:l029","ordinal":72665,"en":"Bereft of Khan Chubak,"},{"id":"manas-2010:p1690:b001:l030","ordinal":72666,"en":"When the champions had all been there,"},{"id":"manas-2010:p1690:b001:l031","ordinal":72667,"en":"From that damned Beijing"},{"id":"manas-2010:p1690:b001:l032","ordinal":72668,"en":"He had plundered and taken many girls."},{"id":"manas-2010:p1690:b001:l033","ordinal":72669,"en":"A day of ruin fell upon his head;"},{"id":"manas-2010:p1690:b001:l034","ordinal":72670,"en":"Your generous one had devoured his champions."},{"id":"manas-2010:p1690:b001:l035","ordinal":72671,"en":"Against seething Beijing,"},{"id":"manas-2010:p1690:b001:l036","ordinal":72672,"en":"Charging, he thrust his lance once."},{"id":"manas-2010:p1690:b001:l037","ordinal":72673,"en":"“Having plundered so much gold,"},{"id":"manas-2010:p1690:b001:l038","ordinal":72674,"en":"O God, now I am to leave defeated,"},{"id":"manas-2010:p1690:b001:l039","ordinal":72675,"en":"Having devoured the noble ones."},{"id":"manas-2010:p1690:b001:l040","ordinal":72676,"en":"Almambet leading was my lucky path,"},{"id":"manas-2010:p1690:b001:l041","ordinal":72677,"en":"Syrgak driving the foe was my vast army."},{"id":"manas-2010:p1690:b001:l042","ordinal":72678,"en":"Bereft of my vast army,"},{"id":"manas-2010:p1691:b001:l001","ordinal":72679,"en":"Was this the time for wasting sickness to strike?"},{"id":"manas-2010:p1691:b001:l002","ordinal":72680,"en":"Bereft of my illustrious Chubak,"},{"id":"manas-2010:p1691:b001:l003","ordinal":72681,"en":"Was this the hour to leave like this?"},{"id":"manas-2010:p1691:b001:l004","ordinal":72682,"en":"Earlier, in the hollow of Zhylgyndy,"},{"id":"manas-2010:p1691:b001:l005","ordinal":72683,"en":"Along the broad Talas,"},{"id":"manas-2010:p1691:b001:l006","ordinal":72684,"en":"I used to cut and eat horse-rump meat."},{"id":"manas-2010:p1691:b001:l007","ordinal":72685,"en":"If Chubak was at my side,"},{"id":"manas-2010:p1691:b001:l008","ordinal":72686,"en":"I thought, ‘I shall overthrow Zhang-Zhung.’"},{"id":"manas-2010:p1691:b001:l009","ordinal":72687,"en":"When I rested peacefully, wretched soul,"},{"id":"manas-2010:p1691:b001:l010","ordinal":72688,"en":"I used to cut and eat horse-belly fat."},{"id":"manas-2010:p1691:b001:l011","ordinal":72689,"en":"When honored Almambet watched over me,"},{"id":"manas-2010:p1691:b001:l012","ordinal":72690,"en":"I thought, ‘Who could contend with me?’"},{"id":"manas-2010:p1691:b001:l013","ordinal":72691,"en":"The black-steel Zulpuqor,"},{"id":"manas-2010:p1691:b001:l014","ordinal":72692,"en":"I thought I would wield and thrust."},{"id":"manas-2010:p1691:b001:l015","ordinal":72693,"en":"When Syrgak watched over me,"},{"id":"manas-2010:p1691:b001:l016","ordinal":72694,"en":"The eighteen thousand worlds,"},{"id":"manas-2010:p1691:b001:l017","ordinal":72695,"en":"Wretched soul, I thought I would jostle them all!"},{"id":"manas-2010:p1691:b001:l018","ordinal":72696,"en":"A bulletproof outer robe,"},{"id":"manas-2010:p1691:b001:l019","ordinal":72697,"en":"I thought I would wear."},{"id":"manas-2010:p1691:b001:l020","ordinal":72698,"en":"If the devastating one was at my side,"},{"id":"manas-2010:p1691:b001:l021","ordinal":72699,"en":"The eighteen thousand worlds,"},{"id":"manas-2010:p1691:b001:l022","ordinal":72700,"en":"I thought I would challenge them all!"},{"id":"manas-2010:p1691:b001:l023","ordinal":72701,"en":"The Russians upon my right,"},{"id":"manas-2010:p1691:b001:l024","ordinal":72702,"en":"When I was mowing them down,"},{"id":"manas-2010:p1691:b001:l025","ordinal":72703,"en":"The Chinese upon my flank,"},{"id":"manas-2010:p1691:b001:l026","ordinal":72704,"en":"When I was slaughtering them,"}]
