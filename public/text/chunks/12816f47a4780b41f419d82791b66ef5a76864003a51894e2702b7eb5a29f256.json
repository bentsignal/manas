[{"id":"seytek-2012:p0931:b002:l037","ordinal":366081,"en":"Like a bolt of lightning;"},{"id":"seytek-2012:p0931:b002:l038","ordinal":366082,"en":"The breath from his mouth"},{"id":"seytek-2012:p0931:b002:l039","ordinal":366083,"en":"Was like the embers of burning saxaul."},{"id":"seytek-2012:p0931:b002:l040","ordinal":366084,"en":"His fury was unmatched, his venom strong;"},{"id":"seytek-2012:p0931:b004:l001","ordinal":366085,"en":"Such was the sight of him."},{"id":"seytek-2012:p0931:b004:l002","ordinal":366086,"en":"If he charged in wrath,"},{"id":"seytek-2012:p0931:b004:l003","ordinal":366087,"en":"His assault seemed bound to end all."},{"id":"seytek-2012:p0931:b004:l004","ordinal":366088,"en":"His dangling beard"},{"id":"seytek-2012:p0931:b004:l005","ordinal":366089,"en":"And bushy mustache"},{"id":"seytek-2012:p0931:b004:l006","ordinal":366090,"en":"Were such that pied crows and magpies"},{"id":"seytek-2012:p0931:b004:l007","ordinal":366091,"en":"Could fearlessly roost in them."},{"id":"seytek-2012:p0931:b004:l008","ordinal":366092,"en":"At nightfall they might lodge there till dawn;"},{"id":"seytek-2012:p0931:b004:l009","ordinal":366093,"en":"Whoever encountered him would spill blood."},{"id":"seytek-2012:p0931:b004:l010","ordinal":366094,"en":"Such was Sarybay’s nature."},{"id":"seytek-2012:p0931:b004:l011","ordinal":366095,"en":"He turned Tor-Kyzyl’s head;"},{"id":"seytek-2012:p0931:b004:l012","ordinal":366096,"en":"Surely God had struck"},{"id":"seytek-2012:p0931:b004:l013","ordinal":366097,"en":"That hellish, wrathful swine."},{"id":"seytek-2012:p0931:b004:l014","ordinal":366098,"en":"Before one could cry out,"},{"id":"seytek-2012:p0931:b004:l015","ordinal":366099,"en":"He wheeled Tor-Kyzyl around."},{"id":"seytek-2012:p0931:b004:l016","ordinal":366100,"en":"With his nine-knobbed steel spear,"},{"id":"seytek-2012:p0931:b004:l017","ordinal":366101,"en":"Before the nimble woman could pull it round,"},{"id":"seytek-2012:p0931:b004:l018","ordinal":366102,"en":"And hold it twisted at the ready,"},{"id":"seytek-2012:p0931:b004:l019","ordinal":366103,"en":"Before Zhelzhetpes could find his bearing"},{"id":"seytek-2012:p0931:b004:l020","ordinal":366104,"en":"And come straight onto the path,"},{"id":"seytek-2012:p0931:b004:l021","ordinal":366105,"en":"He thrust his spear without pause…"},{"id":"seytek-2012:p0931:b004:l022","ordinal":366106,"en":"A great calamity began."},{"id":"seytek-2012:p0931:b004:l023","ordinal":366107,"en":"Atop Zhelzhetpes,"},{"id":"seytek-2012:p0931:b004:l024","ordinal":366108,"en":"The consummate warrior, the lioness,"},{"id":"seytek-2012:p0931:b004:l025","ordinal":366109,"en":"Was a girl whose strength boiled over,"},{"id":"seytek-2012:p0931:b004:l026","ordinal":366110,"en":"A girl who had overcome the whole world"},{"id":"seytek-2012:p0931:b004:l027","ordinal":366111,"en":"Through wrestling and combat."},{"id":"seytek-2012:p0931:b004:l028","ordinal":366112,"en":"She neither swayed nor flinched,"},{"id":"seytek-2012:p0931:b004:l029","ordinal":366113,"en":"And cared nothing if she died."},{"id":"seytek-2012:p0931:b004:l030","ordinal":366114,"en":"Sarybay’s thrust,"},{"id":"seytek-2012:p0931:b004:l031","ordinal":366115,"en":"And all the havoc he wrought,"},{"id":"seytek-2012:p0931:b004:l032","ordinal":366116,"en":"She did not count worth her boot-tip."},{"id":"seytek-2012:p0931:b004:l033","ordinal":366117,"en":"Her heart did not falter,"},{"id":"seytek-2012:p0931:b004:l034","ordinal":366118,"en":"And the cowardly knave’s spear"},{"id":"seytek-2012:p0931:b004:l035","ordinal":366119,"en":"She deemed no harder than tumbleweed."},{"id":"seytek-2012:p0931:b004:l036","ordinal":366120,"en":"When Sarybay drove in his spear"},{"id":"seytek-2012:p0931:b004:l037","ordinal":366121,"en":"And it crashed against the warrior maiden,"},{"id":"seytek-2012:p0931:b004:l038","ordinal":366122,"en":"Yet she did not so much as stir,"},{"id":"seytek-2012:p0931:b004:l039","ordinal":366123,"en":"Sarybay flew into a rage"},{"id":"seytek-2012:p0931:b004:l040","ordinal":366124,"en":"And shouted to his vast army:"},{"id":"seytek-2012:p0932:b002:l001","ordinal":366125,"en":"“Every one of you, swarm over her!"},{"id":"seytek-2012:p0932:b002:l002","ordinal":366126,"en":"Trample this creature called a woman,"},{"id":"seytek-2012:p0932:b002:l003","ordinal":366127,"en":"This bitch, into the black earth!"},{"id":"seytek-2012:p0932:b002:l004","ordinal":366128,"en":"The madwoman is a champion—"},{"id":"seytek-2012:p0932:b002:l005","ordinal":366129,"en":"Overwhelm her in a mass,"},{"id":"seytek-2012:p0932:b002:l006","ordinal":366130,"en":"Fall upon her with spears and axes,"},{"id":"seytek-2012:p0932:b002:l007","ordinal":366131,"en":"And tear her limb from limb!"},{"id":"seytek-2012:p0932:b002:l008","ordinal":366132,"en":"Slaughter her giant Ulukman,"},{"id":"seytek-2012:p0932:b002:l009","ordinal":366133,"en":"Gouge out his eyes and blind him!"},{"id":"seytek-2012:p0932:b002:l010","ordinal":366134,"en":"Close in from every side,"},{"id":"seytek-2012:p0932:b002:l011","ordinal":366135,"en":"And thrust your spears all together."},{"id":"seytek-2012:p0932:b002:l012","ordinal":366136,"en":"Plunge into turmoil and battle"},{"id":"seytek-2012:p0932:b002:l013","ordinal":366137,"en":"And take this bitch’s life!"},{"id":"seytek-2012:p0932:b002:l014","ordinal":366138,"en":"My intimates and confidants,"},{"id":"seytek-2012:p0932:b002:l015","ordinal":366139,"en":"My companions who grew up beside me,"},{"id":"seytek-2012:p0932:b002:l016","ordinal":366140,"en":"Who shared adventures with me,"},{"id":"seytek-2012:p0932:b002:l017","ordinal":366141,"en":"Who joined me in hunting argali,"},{"id":"seytek-2012:p0932:b002:l018","ordinal":366142,"en":"Who rode on raids with me,"},{"id":"seytek-2012:p0932:b002:l019","ordinal":366143,"en":"Who walked beside me"},{"id":"seytek-2012:p0932:b002:l020","ordinal":366144,"en":"Into the seething ranks of foes,"},{"id":"seytek-2012:p0932:b002:l021","ordinal":366145,"en":"Facing the dire bullets meant for me!"},{"id":"seytek-2012:p0932:b002:l022","ordinal":366146,"en":"She is molded like pure wheat dough,"},{"id":"seytek-2012:p0932:b002:l023","ordinal":366147,"en":"Slender as a white gazelle;"},{"id":"seytek-2012:p0932:b002:l024","ordinal":366148,"en":"Unable to spear this bitch,"},{"id":"seytek-2012:p0932:b002:l025","ordinal":366149,"en":"My tiny soul has burned away."},{"id":"seytek-2012:p0932:b002:l026","ordinal":366150,"en":"My spear bent at my waist,"},{"id":"seytek-2012:p0932:b002:l027","ordinal":366151,"en":"And such force has come upon my body"},{"id":"seytek-2012:p0932:b002:l028","ordinal":366152,"en":"That my spine aches,"},{"id":"seytek-2012:p0932:b002:l029","ordinal":366153,"en":"My right ribs have folded,"},{"id":"seytek-2012:p0932:b002:l030","ordinal":366154,"en":"And ruinous pain has struck my head."},{"id":"seytek-2012:p0932:b002:l031","ordinal":366155,"en":"My sight has dimmed and my strength is gone;"},{"id":"seytek-2012:p0932:b002:l032","ordinal":366156,"en":"After jousting with such mighty force,"},{"id":"seytek-2012:p0932:b002:l033","ordinal":366157,"en":"The ill-fated bitch of a champion"},{"id":"seytek-2012:p0932:b002:l034","ordinal":366158,"en":"Has shown her stubbornness."},{"id":"seytek-2012:p0932:b002:l035","ordinal":366159,"en":"She stretched forth and struck once with her spear,"},{"id":"seytek-2012:p0932:b002:l036","ordinal":366160,"en":"And Sarybay despaired of life."},{"id":"seytek-2012:p0932:b002:l037","ordinal":366161,"en":"His insides burned like embers;"},{"id":"seytek-2012:p0932:b002:l038","ordinal":366162,"en":"Nothing like it had been seen in the world."},{"id":"seytek-2012:p0932:b002:l039","ordinal":366163,"en":"Sarybay was shattered to pieces"},{"id":"seytek-2012:p0932:b002:l040","ordinal":366164,"en":"And seemed utterly consumed."},{"id":"seytek-2012:p0932:b003:l001","ordinal":366165,"en":"My dear champions,"},{"id":"seytek-2012:p0932:b003:l002","ordinal":366166,"en":"Comrades who share death with me,"},{"id":"seytek-2012:p0932:b003:l003","ordinal":366167,"en":"Companions gathered in life,"},{"id":"seytek-2012:p0932:b003:l004","ordinal":366168,"en":"Faithful mourners if I depart,"},{"id":"seytek-2012:p0932:b003:l005","ordinal":366169,"en":"Stand not idle—thrust your spears!"},{"id":"seytek-2012:p0932:b003:l006","ordinal":366170,"en":"Friends dearer than brothers,"},{"id":"seytek-2012:p0932:b003:l007","ordinal":366171,"en":"Ever since I became Sarybay,"},{"id":"seytek-2012:p0932:b003:l008","ordinal":366172,"en":"Ever since Sarybay mounted a horse,"},{"id":"seytek-2012:p0932:b003:l009","ordinal":366173,"en":"I have worn a golden crown.”"},{"id":"seytek-2012:p0932:b003:l010","ordinal":366174,"en":"Then Sarybay,"},{"id":"seytek-2012:p0932:b003:l011","ordinal":366175,"en":"Roaring menacingly,"},{"id":"seytek-2012:p0932:b003:l012","ordinal":366176,"en":"Sat astride his horse with legs spread wide."},{"id":"seytek-2012:p0932:b003:l013","ordinal":366177,"en":"“I have seen countless holy wars and conflicts,"},{"id":"seytek-2012:p0932:b003:l014","ordinal":366178,"en":"And never died amid their seething tumult."},{"id":"seytek-2012:p0932:b003:l015","ordinal":366179,"en":"Never upon the earth have I seen"},{"id":"seytek-2012:p0932:b003:l016","ordinal":366180,"en":"A calamity like this warrior girl."},{"id":"seytek-2012:p0932:b003:l017","ordinal":366181,"en":"Swarm over her from every side!"},{"id":"seytek-2012:p0932:b003:l018","ordinal":366182,"en":"The work of the many is a lake, a river—"},{"id":"seytek-2012:p0932:b003:l019","ordinal":366183,"en":"Stand not idle; level your spears!"},{"id":"seytek-2012:p0932:b003:l020","ordinal":366184,"en":"Stand not idle; unleash the battle!"},{"id":"seytek-2012:p0932:b003:l021","ordinal":366185,"en":"Rescue your falcon, Sarybay,"},{"id":"seytek-2012:p0932:b003:l022","ordinal":366186,"en":"And bear him away!"},{"id":"seytek-2012:p0932:b003:l023","ordinal":366187,"en":"Confidants who heed my words,"},{"id":"seytek-2012:p0932:b003:l024","ordinal":366188,"en":"Companions who restore life to me,"},{"id":"seytek-2012:p0932:b003:l025","ordinal":366189,"en":"Men who stand beneath my banner,"},{"id":"seytek-2012:p0932:b003:l026","ordinal":366190,"en":"Men ready to sacrifice their lives!”"},{"id":"seytek-2012:p0932:b003:l027","ordinal":366191,"en":"When Sarybay had spoken thus,"},{"id":"seytek-2012:p0932:b003:l028","ordinal":366192,"en":"The vast host surged forward;"},{"id":"seytek-2012:p0932:b003:l029","ordinal":366193,"en":"Such is the way of a general mêlée."},{"id":"seytek-2012:p0932:b003:l030","ordinal":366194,"en":"Arrows filled the air like rain;"},{"id":"seytek-2012:p0932:b003:l031","ordinal":366195,"en":"Those whose appointed death had truly come"},{"id":"seytek-2012:p0932:b003:l032","ordinal":366196,"en":"Fell to the shafts and boiled in misery."},{"id":"seytek-2012:p0932:b003:l033","ordinal":366197,"en":"The earth was torn apart and night descended;"},{"id":"seytek-2012:p0932:b003:l034","ordinal":366198,"en":"Think of it—a day of calamity had come."},{"id":"seytek-2012:p0932:b003:l035","ordinal":366199,"en":"With frenzied snarling,"},{"id":"seytek-2012:p0932:b003:l036","ordinal":366200,"en":"Musket balls whistled,"},{"id":"seytek-2012:p0932:b003:l037","ordinal":366201,"en":"And arrows from bows flashed;"},{"id":"seytek-2012:p0932:b003:l038","ordinal":366202,"en":"Wherever they struck, bodies burst apart,"},{"id":"seytek-2012:p0932:b003:l039","ordinal":366203,"en":"Blood poured in streams,"},{"id":"seytek-2012:p0932:b003:l040","ordinal":366204,"en":"And the gnawed earth was gouged into hollows."},{"id":"seytek-2012:p0933:b002:l001","ordinal":366205,"en":"Every person they met was slaughtered,"},{"id":"seytek-2012:p0933:b002:l002","ordinal":366206,"en":"Sarybay’s countless host,"},{"id":"seytek-2012:p0933:b002:l003","ordinal":366207,"en":"When their khan gave the command,"},{"id":"seytek-2012:p0933:b002:l004","ordinal":366208,"en":"Swept over the land that day."},{"id":"seytek-2012:p0933:b002:l005","ordinal":366209,"en":"The maiden Kuyaly, lion-hearted girl,"},{"id":"seytek-2012:p0933:b002:l006","ordinal":366210,"en":"While they swarmed like ants,"},{"id":"seytek-2012:p0933:b002:l007","ordinal":366211,"en":"They surged up and surrounded her,"},{"id":"seytek-2012:p0933:b002:l008","ordinal":366212,"en":"Thrusting spears and shouting,"},{"id":"seytek-2012:p0933:b002:l009","ordinal":366213,"en":"Each of them a grave menace,"},{"id":"seytek-2012:p0933:b002:l010","ordinal":366214,"en":"Raising the cry of “Sarybay!”"},{"id":"seytek-2012:p0933:b002:l011","ordinal":366215,"en":"When their numbers overwhelmed her,"},{"id":"seytek-2012:p0933:b002:l012","ordinal":366216,"en":"The earth was churned into dust,"},{"id":"seytek-2012:p0933:b002:l013","ordinal":366217,"en":"As they closed in and encircled her,"},{"id":"seytek-2012:p0933:b002:l014","ordinal":366218,"en":"The ground sagged beneath the massed host,"},{"id":"seytek-2012:p0933:b002:l015","ordinal":366219,"en":"The maiden Kuyaly, the champion,"},{"id":"seytek-2012:p0933:b002:l016","ordinal":366220,"en":"As they were about to trap her in their midst,"},{"id":"seytek-2012:p0933:b002:l017","ordinal":366221,"en":"A roar arose upon their flank,"},{"id":"seytek-2012:p0933:b002:l018","ordinal":366222,"en":"A clamor splitting the sky,"},{"id":"seytek-2012:p0933:b002:l019","ordinal":366223,"en":"His warriors and lions,"},{"id":"seytek-2012:p0933:b002:l020","ordinal":366224,"en":"His champions and heroes,"},{"id":"seytek-2012:p0933:b002:l021","ordinal":366225,"en":"Those most skillful with the spear,"},{"id":"seytek-2012:p0933:b002:l022","ordinal":366226,"en":"Those strongest at devising stratagems,"},{"id":"seytek-2012:p0933:b002:l023","ordinal":366227,"en":"Brave Seytek, the hero’s son,"},{"id":"seytek-2012:p0933:b002:l024","ordinal":366228,"en":"Was coming forth with his chosen men,"},{"id":"seytek-2012:p0933:b002:l025","ordinal":366229,"en":"The swiftest fierce as ogres,"},{"id":"seytek-2012:p0933:b002:l026","ordinal":366230,"en":"Swooping like hawks upon their targets,"},{"id":"seytek-2012:p0933:b002:l027","ordinal":366231,"en":"Brave Seytek, the hero’s son,"},{"id":"seytek-2012:p0933:b002:l028","ordinal":366232,"en":"Was driving them forward."},{"id":"seytek-2012:p0933:b002:l029","ordinal":366233,"en":"Stretching out all who faced him,"},{"id":"seytek-2012:p0933:b002:l030","ordinal":366234,"en":"He came steadily onward."},{"id":"seytek-2012:p0933:b002:l031","ordinal":366235,"en":"“If fate has come, I shall die,” he said,"},{"id":"seytek-2012:p0933:b002:l032","ordinal":366236,"en":"“For the champion maiden Kuyaly,"},{"id":"seytek-2012:p0933:b002:l033","ordinal":366237,"en":"I shall stand as her protector,” he said,"},{"id":"seytek-2012:p0933:b002:l034","ordinal":366238,"en":"Brave Seytek, son of the lion,"},{"id":"seytek-2012:p0933:b002:l035","ordinal":366239,"en":"Drove back all who crowded upon him,"},{"id":"seytek-2012:p0933:b002:l036","ordinal":366240,"en":"Spearing heroes on the slope,"},{"id":"seytek-2012:p0933:b002:l037","ordinal":366241,"en":"Piercing many in succession,"},{"id":"seytek-2012:p0933:b002:l038","ordinal":366242,"en":"His spears split the army apart."},{"id":"seytek-2012:p0933:b002:l039","ordinal":366243,"en":"By the time the hero’s son arrived,"},{"id":"seytek-2012:p0933:b002:l040","ordinal":366244,"en":"Broad in spirit as Talas,"},{"id":"seytek-2012:p0933:b003:l001","ordinal":366245,"en":"In stature the image of Manas,"},{"id":"seytek-2012:p0933:b003:l002","ordinal":366246,"en":"In judgment the equal of Koshoy,"},{"id":"seytek-2012:p0933:b003:l003","ordinal":366247,"en":"Charging like a wild boar,"},{"id":"seytek-2012:p0933:b003:l004","ordinal":366248,"en":"The way he cleaved through their ranks"},{"id":"seytek-2012:p0933:b003:l005","ordinal":366249,"en":"Was like a winter blizzard."},{"id":"seytek-2012:p0933:b003:l006","ordinal":366250,"en":"Terrified at the sight of this,"},{"id":"seytek-2012:p0933:b003:l007","ordinal":366251,"en":"Sarybay, son of an ogre,"},{"id":"seytek-2012:p0933:b003:l008","ordinal":366252,"en":"Found no deep grave in which to hide,"},{"id":"seytek-2012:p0933:b003:l009","ordinal":366253,"en":"No friendly host to flee toward,"},{"id":"seytek-2012:p0933:b003:l010","ordinal":366254,"en":"As the dark army poured in,"},{"id":"seytek-2012:p0933:b003:l011","ordinal":366255,"en":"That was how they faced one another."},{"id":"seytek-2012:p0933:b003:l012","ordinal":366256,"en":"Standing face-to-face,"},{"id":"seytek-2012:p0933:b003:l013","ordinal":366257,"en":"Firing guns and drawing bows,"},{"id":"seytek-2012:p0933:b003:l014","ordinal":366258,"en":"They fought with wet, crushing blows,"},{"id":"seytek-2012:p0933:b003:l015","ordinal":366259,"en":"Clashing their spears,"},{"id":"seytek-2012:p0933:b003:l016","ordinal":366260,"en":"Raising a fearsome tumult,"},{"id":"seytek-2012:p0933:b003:l017","ordinal":366261,"en":"The armies met and uproar rose,"},{"id":"seytek-2012:p0933:b003:l018","ordinal":366262,"en":"Host crashed against host,"},{"id":"seytek-2012:p0933:b003:l019","ordinal":366263,"en":"They hammered one another,"},{"id":"seytek-2012:p0933:b003:l020","ordinal":366264,"en":"May God never show us such a sight,"},{"id":"seytek-2012:p0933:b003:l021","ordinal":366265,"en":"The tasseled standards seethed aloft,"},{"id":"seytek-2012:p0933:b003:l022","ordinal":366266,"en":"Their battle cries became a mighty roar,"},{"id":"seytek-2012:p0933:b003:l023","ordinal":366267,"en":"Such was the dreadful struggle,"},{"id":"seytek-2012:p0933:b003:l024","ordinal":366268,"en":"When the armies confronted each other,"},{"id":"seytek-2012:p0933:b003:l025","ordinal":366269,"en":"And waged battle without yielding,"},{"id":"seytek-2012:p0933:b003:l026","ordinal":366270,"en":"Baring their great teeth,"},{"id":"seytek-2012:p0933:b003:l027","ordinal":366271,"en":"Horses died until mountains were blocked,"},{"id":"seytek-2012:p0933:b003:l028","ordinal":366272,"en":"Mustaches bristled,"},{"id":"seytek-2012:p0933:b003:l029","ordinal":366273,"en":"Corpses of heroes rose like hills,"},{"id":"seytek-2012:p0933:b003:l030","ordinal":366274,"en":"Many mortals there beheld"},{"id":"seytek-2012:p0933:b003:l031","ordinal":366275,"en":"The journey from which none return,"},{"id":"seytek-2012:p0933:b003:l032","ordinal":366276,"en":"Drenched in crimson blood,"},{"id":"seytek-2012:p0933:b003:l033","ordinal":366277,"en":"Many mortals lay dying."},{"id":"seytek-2012:p0933:b003:l034","ordinal":366278,"en":"It was a grievous, mighty conflict,"},{"id":"seytek-2012:p0933:b003:l035","ordinal":366279,"en":"The people were slaughtered without mercy."},{"id":"seytek-2012:p0933:b003:l036","ordinal":366280,"en":"Spears shattered and lashings fell,"},{"id":"seytek-2012:p0933:b003:l037","ordinal":366281,"en":"Corpses of heroes formed mountains,"},{"id":"seytek-2012:p0933:b003:l038","ordinal":366282,"en":"An immeasurable slaughter took place."},{"id":"seytek-2012:p0933:b003:l039","ordinal":366283,"en":"The hollow filled with crimson blood,"},{"id":"seytek-2012:p0933:b003:l040","ordinal":366284,"en":"Deep ravines filled with corpses."},{"id":"seytek-2012:p0934:b002:l001","ordinal":366285,"en":"The souls of the living burned with anguish,"},{"id":"seytek-2012:p0934:b002:l002","ordinal":366286,"en":"And whoever looked upon that age"},{"id":"seytek-2012:p0934:b002:l003","ordinal":366287,"en":"Saw its falseness revealed,"},{"id":"seytek-2012:p0934:b002:l004","ordinal":366288,"en":"All scattered in confusion,"},{"id":"seytek-2012:p0934:b002:l005","ordinal":366289,"en":"Crushing without respite"},{"id":"seytek-2012:p0934:b002:l006","ordinal":366290,"en":"Those they had marked for their ranks,"},{"id":"seytek-2012:p0934:b002:l007","ordinal":366291,"en":"Engaged in riotous slaughter."},{"id":"seytek-2012:p0934:b002:l008","ordinal":366292,"en":"Many a splendid warhorse,"},{"id":"seytek-2012:p0934:b002:l009","ordinal":366293,"en":"Wandered riderless and bare of saddle."},{"id":"seytek-2012:p0934:b002:l010","ordinal":366294,"en":"Many a fleet courser,"},{"id":"seytek-2012:p0934:b002:l011","ordinal":366295,"en":"Neighed while dragging its reins,"},{"id":"seytek-2012:p0934:b002:l012","ordinal":366296,"en":"Its riderless heart grieving."},{"id":"seytek-2012:p0934:b002:l013","ordinal":366297,"en":"It was a dreadful, mighty conflict,"},{"id":"seytek-2012:p0934:b002:l014","ordinal":366298,"en":"Many among the people witnessed it,"},{"id":"seytek-2012:p0934:b002:l015","ordinal":366299,"en":"And many mortals lay dying."},{"id":"seytek-2012:p0934:b002:l016","ordinal":366300,"en":"All the warriors trembled,"},{"id":"seytek-2012:p0934:b002:l017","ordinal":366301,"en":"The people cried out one by one,"},{"id":"seytek-2012:p0934:b002:l018","ordinal":366302,"en":"Thrusting and fencing with spears,"},{"id":"seytek-2012:p0934:b002:l019","ordinal":366303,"en":"They kept slaughtering one another,"},{"id":"seytek-2012:p0934:b002:l020","ordinal":366304,"en":"The great conflict tightened its coils,"},{"id":"seytek-2012:p0934:b002:l021","ordinal":366305,"en":"Becoming a chaos beyond understanding,"},{"id":"seytek-2012:p0934:b002:l022","ordinal":366306,"en":"As they continued their strife,"},{"id":"seytek-2012:p0934:b002:l023","ordinal":366307,"en":"A terrible massacre took place."},{"id":"seytek-2012:p0934:b002:l024","ordinal":366308,"en":"When Sarybay’s troops saw brave Seytek’s bearing,"},{"id":"seytek-2012:p0934:b002:l025","ordinal":366309,"en":"They surrendered,"},{"id":"seytek-2012:p0934:b002:l026","ordinal":366310,"en":"Some heroes after others,"},{"id":"seytek-2012:p0934:b002:l027","ordinal":366311,"en":"Their knees buckling,"},{"id":"seytek-2012:p0934:b002:l028","ordinal":366312,"en":"Ran after him and bowed,"},{"id":"seytek-2012:p0934:b002:l029","ordinal":366313,"en":"Taking reins knotted with loops,"},{"id":"seytek-2012:p0934:b002:l030","ordinal":366314,"en":"And hanging them around their necks,"},{"id":"seytek-2012:p0934:b002:l031","ordinal":366315,"en":"While one man from another"},{"id":"seytek-2012:p0934:b002:l032","ordinal":366316,"en":"Contended to offer him a warhorse."},{"id":"seytek-2012:p0934:b002:l033","ordinal":366317,"en":"Hurrying and trotting forward,"},{"id":"seytek-2012:p0934:b002:l034","ordinal":366318,"en":"They came as envoys,"},{"id":"seytek-2012:p0934:b002:l035","ordinal":366319,"en":"Submitting to the hero,"},{"id":"seytek-2012:p0934:b002:l036","ordinal":366320,"en":"And vying to offer livestock."},{"id":"seytek-2012:p0934:b002:l037","ordinal":366321,"en":"They began according to ancient custom,"},{"id":"seytek-2012:p0934:b002:l038","ordinal":366322,"en":"And thus brought the fighting"},{"id":"seytek-2012:p0934:b002:l039","ordinal":366323,"en":"And conflict to an end."},{"id":"seytek-2012:p0934:b002:l040","ordinal":366324,"en":"The two armies that had clashed"},{"id":"seytek-2012:p0934:b003:l001","ordinal":366325,"en":"Made peace that day,"},{"id":"seytek-2012:p0934:b003:l002","ordinal":366326,"en":"They began speaking to one another,"},{"id":"seytek-2012:p0934:b003:l003","ordinal":366327,"en":"Gathered their wits and opened counsel,"},{"id":"seytek-2012:p0934:b003:l004","ordinal":366328,"en":"And began their sorrowful plea:"},{"id":"seytek-2012:p0934:b003:l005","ordinal":366329,"en":"“Because of what has happened,"},{"id":"seytek-2012:p0934:b003:l006","ordinal":366330,"en":"Because of Sarybay,"},{"id":"seytek-2012:p0934:b003:l007","ordinal":366331,"en":"We became an army tens of thousands strong,"},{"id":"seytek-2012:p0934:b003:l008","ordinal":366332,"en":"And the whole world was stirred."},{"id":"seytek-2012:p0934:b003:l009","ordinal":366333,"en":"Sarybay drove us here,"},{"id":"seytek-2012:p0934:b003:l010","ordinal":366334,"en":"Though he had neither rope nor cord,"},{"id":"seytek-2012:p0934:b003:l011","ordinal":366335,"en":"Sarybay brought us here in bonds."},{"id":"seytek-2012:p0934:b003:l012","ordinal":366336,"en":"He unleashed his terrible wrath,"}]
