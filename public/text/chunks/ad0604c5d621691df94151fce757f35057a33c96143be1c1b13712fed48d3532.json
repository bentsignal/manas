[{"id":"manas-2010:p1348:b001:l030","ordinal":58369,"en":"Alöökö's Kongurbay,"},{"id":"manas-2010:p1348:b001:l031","ordinal":58370,"en":"Separating from his army,"},{"id":"manas-2010:p1348:b001:l032","ordinal":58371,"en":"Before Khan Manas,"},{"id":"manas-2010:p1348:b001:l033","ordinal":58372,"en":"Kongurbay, looming large,"},{"id":"manas-2010:p1348:b001:l034","ordinal":58373,"en":"Came out into view."},{"id":"manas-2010:p1348:b001:l035","ordinal":58374,"en":"When he saw Kongurbay,"},{"id":"manas-2010:p1348:b001:l036","ordinal":58375,"en":"Your generous hero grew wrathful."},{"id":"manas-2010:p1348:b001:l037","ordinal":58376,"en":"Your champion, Khan Manas,"},{"id":"manas-2010:p1348:b001:l038","ordinal":58377,"en":"Wind pouring from his mouth,"},{"id":"manas-2010:p1348:b001:l039","ordinal":58378,"en":"Fire coming from his eyes,"},{"id":"manas-2010:p1348:b001:l040","ordinal":58379,"en":"“The other Chinese, the countless governors,"},{"id":"manas-2010:p1348:b001:l041","ordinal":58380,"en":"Why should I attack those wretches?"},{"id":"manas-2010:p1348:b001:l042","ordinal":58381,"en":"Cotton sash, wide boots,"},{"id":"manas-2010:p1349:b001:l001","ordinal":58382,"en":"Let me reach that swaggering dog!”"},{"id":"manas-2010:p1349:b001:l002","ordinal":58383,"en":"Thinking this, hero Manas,"},{"id":"manas-2010:p1349:b001:l003","ordinal":58384,"en":"Without turning back, the mighty lion,"},{"id":"manas-2010:p1349:b001:l004","ordinal":58385,"en":"The hero who stood untroubled,"},{"id":"manas-2010:p1349:b001:l005","ordinal":58386,"en":"At the Fierce One as huge as a hut,"},{"id":"manas-2010:p1349:b001:l006","ordinal":58387,"en":"Roaring, leveled his lance."},{"id":"manas-2010:p1349:b001:l007","ordinal":58388,"en":"His face like buttered wheat,"},{"id":"manas-2010:p1349:b001:l008","ordinal":58389,"en":"His eyes like mist at dusk,"},{"id":"manas-2010:p1349:b001:l009","ordinal":58390,"en":"Above that lance"},{"id":"manas-2010:p1349:b001:l010","ordinal":58391,"en":"Holding his steel blade as well,"},{"id":"manas-2010:p1349:b001:l011","ordinal":58392,"en":"The peerless steed Akkula—"},{"id":"manas-2010:p1349:b001:l012","ordinal":58393,"en":"He gave him his head."},{"id":"manas-2010:p1349:b001:l013","ordinal":58394,"en":"The Fierce One saw his valor;"},{"id":"manas-2010:p1349:b001:l014","ordinal":58395,"en":"Unable to endure his heat,"},{"id":"manas-2010:p1349:b001:l015","ordinal":58396,"en":"Unable to bear his rushing force,"},{"id":"manas-2010:p1349:b001:l016","ordinal":58397,"en":"On the lone path beside the water"},{"id":"manas-2010:p1349:b001:l017","ordinal":58398,"en":"He wheeled and darted aside."},{"id":"manas-2010:p1349:b001:l018","ordinal":58399,"en":"Dodging like a fox,"},{"id":"manas-2010:p1349:b001:l019","ordinal":58400,"en":"He fled back and slipped away."},{"id":"manas-2010:p1349:b001:l020","ordinal":58401,"en":"Akkula, a steed among beasts,"},{"id":"manas-2010:p1349:b001:l021","ordinal":58402,"en":"Had not yet been ridden much against the foe;"},{"id":"manas-2010:p1349:b001:l022","ordinal":58403,"en":"He had regained his flesh, curse him,"},{"id":"manas-2010:p1349:b001:l023","ordinal":58404,"en":"And clenching the bit firmly,"},{"id":"manas-2010:p1349:b001:l024","ordinal":58405,"en":"He carried Manas flying onward."},{"id":"manas-2010:p1349:b001:l025","ordinal":58406,"en":"With no wings to fly across,"},{"id":"manas-2010:p1349:b001:l026","ordinal":58407,"en":"Akkula, a steed among horses,"},{"id":"manas-2010:p1349:b001:l027","ordinal":58408,"en":"Into Kürpüldök's great river"},{"id":"manas-2010:p1349:b001:l028","ordinal":58409,"en":"Plunged at its swiftest current."},{"id":"manas-2010:p1349:b001:l029","ordinal":58410,"en":"His lance stuck up in his hand;"},{"id":"manas-2010:p1349:b001:l030","ordinal":58411,"en":"The Magnanimous One's head bobbed in the water."},{"id":"manas-2010:p1349:b001:l031","ordinal":58412,"en":"The cunning warrior Kongurbay—"},{"id":"manas-2010:p1349:b001:l032","ordinal":58413,"en":"A warrior who knew the enemy's stratagems—"},{"id":"manas-2010:p1349:b001:l033","ordinal":58414,"en":"Shouted and drove the Chinese on:"},{"id":"manas-2010:p1349:b001:l034","ordinal":58415,"en":"“Reach the water; do not let him out!"},{"id":"manas-2010:p1349:b001:l035","ordinal":58416,"en":"Crush Manas as you go!”"},{"id":"manas-2010:p1349:b001:l036","ordinal":58417,"en":"The Chinese multitude made ready;"},{"id":"manas-2010:p1349:b001:l037","ordinal":58418,"en":"At his bobbing head,"},{"id":"manas-2010:p1349:b001:l038","ordinal":58419,"en":"Pouring like rain, they drew their bows,"},{"id":"manas-2010:p1349:b001:l039","ordinal":58420,"en":"Firing shot like hail."},{"id":"manas-2010:p1349:b001:l040","ordinal":58421,"en":"When the Chinese closed around him,"},{"id":"manas-2010:p1349:b001:l041","ordinal":58422,"en":"When they were forcing him into the water—"},{"id":"manas-2010:p1349:b001:l042","ordinal":58423,"en":"Having forded many rushing rivers,"},{"id":"manas-2010:p1350:b001:l001","ordinal":58424,"en":"Khan Bakay had become an expert;"},{"id":"manas-2010:p1350:b001:l002","ordinal":58425,"en":"Having been together since tiny childhood,"},{"id":"manas-2010:p1350:b001:l003","ordinal":58426,"en":"Of flowing Kürpüldök"},{"id":"manas-2010:p1350:b001:l004","ordinal":58427,"en":"Almambet knew the ways."},{"id":"manas-2010:p1350:b001:l005","ordinal":58428,"en":"Wise-born hero Bakay,"},{"id":"manas-2010:p1350:b001:l006","ordinal":58429,"en":"A hair rope some forty fathoms long,"},{"id":"manas-2010:p1350:b001:l007","ordinal":58430,"en":"Shouting, came to Manas"},{"id":"manas-2010:p1350:b001:l008","ordinal":58431,"en":"And cast it without letting him slip away."},{"id":"manas-2010:p1350:b001:l009","ordinal":58432,"en":"Azizkhan's Almambet,"},{"id":"manas-2010:p1350:b001:l010","ordinal":58433,"en":"Holding his lance out to Manas,"},{"id":"manas-2010:p1350:b001:l011","ordinal":58434,"en":"Stood ready."},{"id":"manas-2010:p1350:b001:l012","ordinal":58435,"en":"Then that same Bakay,"},{"id":"manas-2010:p1350:b001:l013","ordinal":58436,"en":"Against his belly, the rope"},{"id":"manas-2010:p1350:b001:l014","ordinal":58437,"en":"Pressed firmly and held."},{"id":"manas-2010:p1350:b001:l015","ordinal":58438,"en":"The steed beneath him"},{"id":"manas-2010:p1350:b001:l016","ordinal":58439,"en":"He struck on the thigh with his whip."},{"id":"manas-2010:p1350:b001:l017","ordinal":58440,"en":"Looming as huge as a hut,"},{"id":"manas-2010:p1350:b001:l018","ordinal":58441,"en":"Lion Manas, the fierce-maned one,"},{"id":"manas-2010:p1350:b001:l019","ordinal":58442,"en":"He dragged out, his great body sprawling."},{"id":"manas-2010:p1350:b001:l020","ordinal":58443,"en":"When he reached the shallows,"},{"id":"manas-2010:p1350:b001:l021","ordinal":58444,"en":"Azizkhan's Almambet"},{"id":"manas-2010:p1350:b001:l022","ordinal":58445,"en":"Took hold of the stirrup."},{"id":"manas-2010:p1350:b001:l023","ordinal":58446,"en":"The armies of twelve khans,"},{"id":"manas-2010:p1350:b001:l024","ordinal":58447,"en":"That fierce-maned lord Manas,"},{"id":"manas-2010:p1350:b001:l025","ordinal":58448,"en":"Surrounded him where he stood."},{"id":"manas-2010:p1350:b001:l026","ordinal":58449,"en":"After he had come out of the water,"},{"id":"manas-2010:p1350:b001:l027","ordinal":58450,"en":"Sultan Manas, your keen warrior,"},{"id":"manas-2010:p1350:b001:l028","ordinal":58451,"en":"Did not rest even for a day,"},{"id":"manas-2010:p1350:b001:l029","ordinal":58452,"en":"Did not take a day's respite;"},{"id":"manas-2010:p1350:b001:l030","ordinal":58453,"en":"He fought through days and nights."},{"id":"manas-2010:p1350:b001:l031","ordinal":58454,"en":"Your goshawk-born lord of battles"},{"id":"manas-2010:p1350:b001:l032","ordinal":58455,"en":"Drank much, much blood."},{"id":"manas-2010:p1350:b001:l033","ordinal":58456,"en":"At the end of that battle,"},{"id":"manas-2010:p1350:b001:l034","ordinal":58457,"en":"Lion-born Khan Manas,"},{"id":"manas-2010:p1350:b001:l035","ordinal":58458,"en":"Making the Chinese cry out,"},{"id":"manas-2010:p1350:b001:l036","ordinal":58459,"en":"Toward the Chinese emperor's Beijing,"},{"id":"manas-2010:p1350:b001:l037","ordinal":58460,"en":"Turning the heavens to dust,"},{"id":"manas-2010:p1350:b001:l038","ordinal":58461,"en":"Turning the earth's face to blood,"},{"id":"manas-2010:p1350:b001:l039","ordinal":58462,"en":"Drove them into the river."},{"id":"manas-2010:p1350:b001:l040","ordinal":58463,"en":"When they saw Manas's fury,"},{"id":"manas-2010:p1350:b001:l041","ordinal":58464,"en":"The Chinese fled in a surging mass,"},{"id":"manas-2010:p1350:b001:l042","ordinal":58465,"en":"All crying out together;"},{"id":"manas-2010:p1351:b001:l001","ordinal":58466,"en":"They all entered the river."},{"id":"manas-2010:p1351:b001:l002","ordinal":58467,"en":"Obscured in mist, unseen,"},{"id":"manas-2010:p1351:b001:l003","ordinal":58468,"en":"When the multitude of Chinese entered,"},{"id":"manas-2010:p1351:b001:l004","ordinal":58469,"en":"With no telling who was who,"},{"id":"manas-2010:p1351:b001:l005","ordinal":58470,"en":"Unable to ford the river,"},{"id":"manas-2010:p1351:b001:l006","ordinal":58471,"en":"Many were swept away and perished."},{"id":"manas-2010:p1351:b001:l007","ordinal":58472,"en":"Kongurbay came out safely;"},{"id":"manas-2010:p1351:b001:l008","ordinal":58473,"en":"Half of the Chinese multitude emerged."},{"id":"manas-2010:p1351:b001:l009","ordinal":58474,"en":"When the flood swept over them,"},{"id":"manas-2010:p1351:b001:l010","ordinal":58475,"en":"A host of them remained alive."},{"id":"manas-2010:p1351:b001:l011","ordinal":58476,"en":"Though half had gone into the water,"},{"id":"manas-2010:p1351:b001:l012","ordinal":58477,"en":"The numbers that remained"},{"id":"manas-2010:p1351:b001:l013","ordinal":58478,"en":"Ten times the Kyrgyz in number,"},{"id":"manas-2010:p1351:b001:l014","ordinal":58479,"en":"Such was their advantage."},{"id":"manas-2010:p1351:b001:l015","ordinal":58480,"en":"Kongurbay, son of Alöökö,"},{"id":"manas-2010:p1351:b001:l016","ordinal":58481,"en":"After he came out of the water,"},{"id":"manas-2010:p1351:b001:l017","ordinal":58482,"en":"To all the many Chinese"},{"id":"manas-2010:p1351:b001:l018","ordinal":58483,"en":"Sent word at that moment,"},{"id":"manas-2010:p1351:b001:l019","ordinal":58484,"en":"To the city of Innermost Beijing."},{"id":"manas-2010:p1351:b001:l020","ordinal":58485,"en":"When he heard this news,"},{"id":"manas-2010:p1351:b001:l021","ordinal":58486,"en":"The emperor of the Chinese multitude"},{"id":"manas-2010:p1351:b001:l022","ordinal":58487,"en":"Gathered his people then,"},{"id":"manas-2010:p1351:b001:l023","ordinal":58488,"en":"Leaving no fighting man behind."},{"id":"manas-2010:p1351:b001:l024","ordinal":58489,"en":"“Fight the Buruts!” he said,"},{"id":"manas-2010:p1351:b001:l025","ordinal":58490,"en":"And armies countless as grains of sand"},{"id":"manas-2010:p1351:b001:l026","ordinal":58491,"en":"He sent to Kongurbay."},{"id":"manas-2010:p1351:b001:l027","ordinal":58492,"en":"Madykan, mounted on a gray bull,"},{"id":"manas-2010:p1351:b001:l028","ordinal":58493,"en":"With a single eye in his head,"},{"id":"manas-2010:p1351:b001:l029","ordinal":58494,"en":"He sent at their head against the foe."},{"id":"manas-2010:p1351:b001:l030","ordinal":58495,"en":"Before Madykan arrived,"},{"id":"manas-2010:p1351:b001:l031","ordinal":58496,"en":"Golden forelock and tasselled belt—"},{"id":"manas-2010:p1351:b001:l032","ordinal":58497,"en":"Azizkhan's only son,"},{"id":"manas-2010:p1351:b001:l033","ordinal":58498,"en":"Lion-born Almambet,"},{"id":"manas-2010:p1351:b001:l034","ordinal":58499,"en":"Turned bright day into night,"},{"id":"manas-2010:p1351:b001:l035","ordinal":58500,"en":"Turned summer's day into winter."},{"id":"manas-2010:p1351:b001:l036","ordinal":58501,"en":"Changing the weather by magic,"},{"id":"manas-2010:p1351:b001:l037","ordinal":58502,"en":"Kürpüldök's great river"},{"id":"manas-2010:p1351:b001:l038","ordinal":58503,"en":"He froze so people could cross."},{"id":"manas-2010:p1351:b001:l039","ordinal":58504,"en":"When Almambet's skill"},{"id":"manas-2010:p1351:b001:l040","ordinal":58505,"en":"Was seen by the multitude of Buruts,"},{"id":"manas-2010:p1351:b001:l041","ordinal":58506,"en":"They were all equally amazed,"},{"id":"manas-2010:p1351:b001:l042","ordinal":58507,"en":"And all were grateful."},{"id":"manas-2010:p1352:b001:l001","ordinal":58508,"en":"Manas led them in imploring praise:"},{"id":"manas-2010:p1352:b001:l002","ordinal":58509,"en":"“My red lance, my banner,"},{"id":"manas-2010:p1352:b001:l003","ordinal":58510,"en":"My keen one, warrior Almambet,"},{"id":"manas-2010:p1352:b001:l004","ordinal":58511,"en":"My gift that came from China,"},{"id":"manas-2010:p1352:b001:l005","ordinal":58512,"en":"On the day of distress,"},{"id":"manas-2010:p1352:b001:l006","ordinal":58513,"en":"My aid to this frail life,"},{"id":"manas-2010:p1352:b001:l007","ordinal":58514,"en":"To the city of Beijing before us"},{"id":"manas-2010:p1352:b001:l008","ordinal":58515,"en":"Having come on holy war,"},{"id":"manas-2010:p1352:b001:l009","ordinal":58516,"en":"The multitude of Kyrgyz here—"},{"id":"manas-2010:p1352:b001:l010","ordinal":58517,"en":"May all offer themselves for you!”"},{"id":"manas-2010:p1352:b001:l011","ordinal":58518,"en":"Rejoicing in Almambet,"},{"id":"manas-2010:p1352:b001:l012","ordinal":58519,"en":"Before they could close their mouths,"},{"id":"manas-2010:p1352:b001:l013","ordinal":58520,"en":"Before the great armies of twelve khans"},{"id":"manas-2010:p1352:b001:l014","ordinal":58521,"en":"From the river left in ice"},{"id":"manas-2010:p1352:b001:l015","ordinal":58522,"en":"Had all come out,"},{"id":"manas-2010:p1352:b001:l016","ordinal":58523,"en":"The earth whirled and turned to dust."},{"id":"manas-2010:p1352:b001:l017","ordinal":58524,"en":"Madykan came forth for single combat;"},{"id":"manas-2010:p1352:b001:l018","ordinal":58525,"en":"Unable to bear his fury,"},{"id":"manas-2010:p1352:b001:l019","ordinal":58526,"en":"The face of the earth shook."},{"id":"manas-2010:p1352:b001:l020","ordinal":58527,"en":"Beyond all those Chinese,"},{"id":"manas-2010:p1352:b001:l021","ordinal":58528,"en":"Warrior Madykan was a greater hero."},{"id":"manas-2010:p1352:b001:l022","ordinal":58529,"en":"Frail life was hard pressed;"},{"id":"manas-2010:p1352:b001:l023","ordinal":58530,"en":"This was where slaughter would come."},{"id":"manas-2010:p1352:b001:l024","ordinal":58531,"en":"A shot-proof iron shield"},{"id":"manas-2010:p1352:b001:l025","ordinal":58532,"en":"He had put on."},{"id":"manas-2010:p1352:b001:l026","ordinal":58533,"en":"With a single horn on its head,"},{"id":"manas-2010:p1352:b001:l027","ordinal":58534,"en":"A gray bull as large as a mountain"},{"id":"manas-2010:p1352:b001:l028","ordinal":58535,"en":"He was riding."},{"id":"manas-2010:p1352:b001:l029","ordinal":58536,"en":"The swift beast beneath him—"},{"id":"manas-2010:p1352:b001:l030","ordinal":58537,"en":"No wind could match its trot,"},{"id":"manas-2010:p1352:b001:l031","ordinal":58538,"en":"No beast could match its walk."},{"id":"manas-2010:p1352:b001:l032","ordinal":58539,"en":"Madykan upon its back,"},{"id":"manas-2010:p1352:b001:l033","ordinal":58540,"en":"No strength could overcome in combat."},{"id":"manas-2010:p1352:b001:l034","ordinal":58541,"en":"Gathering speed on his bull,"},{"id":"manas-2010:p1352:b001:l035","ordinal":58542,"en":"He entered first, launching an attack."},{"id":"manas-2010:p1352:b001:l036","ordinal":58543,"en":"Before a word could be said,"},{"id":"manas-2010:p1352:b001:l037","ordinal":58544,"en":"Before an eye could open and close,"},{"id":"manas-2010:p1352:b001:l038","ordinal":58545,"en":"He arrived before an arrow could,"},{"id":"manas-2010:p1352:b001:l039","ordinal":58546,"en":"And Koshoy and Muzburchak"},{"id":"manas-2010:p1352:b001:l040","ordinal":58547,"en":"He pierced together as he passed."},{"id":"manas-2010:p1352:b001:l041","ordinal":58548,"en":"When they fell from their horses,"},{"id":"manas-2010:p1352:b001:l042","ordinal":58549,"en":"From behind, a thousand shaven-headed ones,"},{"id":"manas-2010:p1353:b001:l001","ordinal":58550,"en":"Koshoy and Muzburchak"},{"id":"manas-2010:p1353:b001:l002","ordinal":58551,"en":"Bound together and carried away."},{"id":"manas-2010:p1353:b001:l003","ordinal":58552,"en":"Before he could wheel this way,"},{"id":"manas-2010:p1353:b001:l004","ordinal":58553,"en":"Bokmurun and Kökchö"},{"id":"manas-2010:p1353:b001:l005","ordinal":58554,"en":"He reached together as well."},{"id":"manas-2010:p1353:b001:l006","ordinal":58555,"en":"Maaniker and Kögala—"},{"id":"manas-2010:p1353:b001:l007","ordinal":58556,"en":"From the backs of those two"},{"id":"manas-2010:p1353:b001:l008","ordinal":58557,"en":"He hurled them as he passed."},{"id":"manas-2010:p1353:b001:l009","ordinal":58558,"en":"Before they all could flee,"},{"id":"manas-2010:p1353:b001:l010","ordinal":58559,"en":"Hero Chubak, like a hobby falcon,"},{"id":"manas-2010:p1353:b001:l011","ordinal":58560,"en":"Kökötöy's Bokmurun"},{"id":"manas-2010:p1353:b001:l012","ordinal":58561,"en":"Scooped up from the ground;"},{"id":"manas-2010:p1353:b001:l013","ordinal":58562,"en":"Setting him on Maaniker,"},{"id":"manas-2010:p1353:b001:l014","ordinal":58563,"en":"He carried him safely away."},{"id":"manas-2010:p1353:b001:l015","ordinal":58564,"en":"To hero Kökchö, Khan Bakay"},{"id":"manas-2010:p1353:b001:l016","ordinal":58565,"en":"Arrived before the others."},{"id":"manas-2010:p1353:b001:l017","ordinal":58566,"en":"Whipping the gray steed,"},{"id":"manas-2010:p1353:b001:l018","ordinal":58567,"en":"Not letting the many Chinese reach him,"},{"id":"manas-2010:p1353:b001:l019","ordinal":58568,"en":"Kökchö, son of Aydarkhan,"},{"id":"manas-2010:p1353:b001:l020","ordinal":58569,"en":"He set on Kögala"},{"id":"manas-2010:p1353:b001:l021","ordinal":58570,"en":"And carried safely away."},{"id":"manas-2010:p1353:b001:l022","ordinal":58571,"en":"The Buruts fell into distress;"},{"id":"manas-2010:p1353:b001:l023","ordinal":58572,"en":"A terrible battle raged."},{"id":"manas-2010:p1353:b001:l024","ordinal":58573,"en":"Koshoy and Muzburchak,"},{"id":"manas-2010:p1353:b001:l025","ordinal":58574,"en":"When they had been captured,"},{"id":"manas-2010:p1353:b001:l026","ordinal":58575,"en":"Their hands and feet were bound tight."},{"id":"manas-2010:p1353:b001:l027","ordinal":58576,"en":"With Börüköz at their head,"},{"id":"manas-2010:p1353:b001:l028","ordinal":58577,"en":"They had loaded them upon mules."},{"id":"manas-2010:p1353:b001:l029","ordinal":58578,"en":"Meeting them face to face,"},{"id":"manas-2010:p1353:b001:l030","ordinal":58579,"en":"Syrgak appeared."},{"id":"manas-2010:p1353:b001:l031","ordinal":58580,"en":"The people's elder Koshoy,"},{"id":"manas-2010:p1353:b001:l032","ordinal":58581,"en":"When he saw him bound,"},{"id":"manas-2010:p1353:b001:l033","ordinal":58582,"en":"And Muzburchak, son of Buudayyk Khan,"},{"id":"manas-2010:p1353:b001:l034","ordinal":58583,"en":"When he saw the two loaded upon mules"},{"id":"manas-2010:p1353:b001:l035","ordinal":58584,"en":"And driven away,"},{"id":"manas-2010:p1353:b001:l036","ordinal":58585,"en":"Warrior Syrgak, that mighty hero—"},{"id":"manas-2010:p1353:b001:l037","ordinal":58586,"en":"His strength could match the world;"},{"id":"manas-2010:p1353:b001:l038","ordinal":58587,"en":"He and Manas shared one forefather,"},{"id":"manas-2010:p1353:b001:l039","ordinal":58588,"en":"Children of kinsmen."},{"id":"manas-2010:p1353:b001:l040","ordinal":58589,"en":"Whipping Kökchebich,"},{"id":"manas-2010:p1353:b001:l041","ordinal":58590,"en":"Hero Syrgak launched his charge."},{"id":"manas-2010:p1353:b001:l042","ordinal":58591,"en":"Shouting out “Manas!”"},{"id":"manas-2010:p1354:b001:l001","ordinal":58592,"en":"The champions who had bound them,"},{"id":"manas-2010:p1354:b001:l002","ordinal":58593,"en":"He slaughtered all, sweeping them down."},{"id":"manas-2010:p1354:b001:l003","ordinal":58594,"en":"Torment no man had heard of"},{"id":"manas-2010:p1354:b001:l004","ordinal":58595,"en":"Hero Syrgak unleashed."},{"id":"manas-2010:p1354:b001:l005","ordinal":58596,"en":"Muzburchak and Koshoy,"},{"id":"manas-2010:p1354:b001:l006","ordinal":58597,"en":"Tearing them free of the Chinese,"},{"id":"manas-2010:p1354:b001:l007","ordinal":58598,"en":"Hero Syrgak brought out."},{"id":"manas-2010:p1354:b001:l008","ordinal":58599,"en":"Then your elder Koshoy"},{"id":"manas-2010:p1354:b001:l009","ordinal":58600,"en":"And Muzburchak, the two of them—"},{"id":"manas-2010:p1354:b001:l010","ordinal":58601,"en":"Their extinguished fire he rekindled,"},{"id":"manas-2010:p1354:b001:l011","ordinal":58602,"en":"Their deadened lives he revived."},{"id":"manas-2010:p1354:b001:l012","ordinal":58603,"en":"Telkyzyl and Kabylan,"},{"id":"manas-2010:p1354:b001:l013","ordinal":58604,"en":"Their horses, he set them upon"},{"id":"manas-2010:p1354:b001:l014","ordinal":58605,"en":"And led them safely away."},{"id":"manas-2010:p1354:b001:l015","ordinal":58606,"en":"Look at the deep pit that was dug!"},{"id":"manas-2010:p1354:b001:l016","ordinal":58607,"en":"Falling this way and that,"},{"id":"manas-2010:p1354:b001:l017","ordinal":58608,"en":"Infidels and Muslims,"},{"id":"manas-2010:p1354:b001:l018","ordinal":58609,"en":"Their corpses mingled;"},{"id":"manas-2010:p1354:b001:l019","ordinal":58610,"en":"Look at the writhing lives!"},{"id":"manas-2010:p1354:b001:l020","ordinal":58611,"en":"Yielding to no host of people,"},{"id":"manas-2010:p1354:b001:l021","ordinal":58612,"en":"Slaughtering, destroying and smashing,"},{"id":"manas-2010:p1354:b001:l022","ordinal":58613,"en":"He continued waging war,"},{"id":"manas-2010:p1354:b001:l023","ordinal":58614,"en":"Madykan of the Chinese."},{"id":"manas-2010:p1354:b001:l024","ordinal":58615,"en":"As he wrought such slaughter,"},{"id":"manas-2010:p1354:b001:l025","ordinal":58616,"en":"“If Madykan is allowed his way,"},{"id":"manas-2010:p1354:b001:l026","ordinal":58617,"en":"The Chinese have reached our very roots;"},{"id":"manas-2010:p1354:b001:l027","ordinal":58618,"en":"He will slaughter everyone!” they said."},{"id":"manas-2010:p1354:b001:l028","ordinal":58619,"en":"Then Manas, hero and lord of battles,"},{"id":"manas-2010:p1354:b001:l029","ordinal":58620,"en":"Standing apart from the throng,"},{"id":"manas-2010:p1354:b001:l030","ordinal":58621,"en":"Faced Madykan."},{"id":"manas-2010:p1354:b001:l031","ordinal":58622,"en":"Still surviving there,"},{"id":"manas-2010:p1354:b001:l032","ordinal":58623,"en":"The two kept fighting."},{"id":"manas-2010:p1354:b001:l033","ordinal":58624,"en":"When they saw this battle,"}]
