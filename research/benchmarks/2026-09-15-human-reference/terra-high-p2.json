{
  "lines": [
    {"line": 1, "english": "Akbaltai gave his blessing,", "note": ""},
    {"line": 2, "english": "while in the marshes of broad Altai", "note": ""},
    {"line": 3, "english": "the Kyrgyz lay in sorrow.", "note": ""},
    {"line": 4, "english": "The days lagged on and the nights passed,", "note": ""},
    {"line": 5, "english": "autumn reached its middle and summer had gone by;", "note": ""},
    {"line": 6, "english": "the season of plenty", "note": ""},
    {"line": 7, "english": "had run its course for three months.", "note": ""},
    {"line": 8, "english": "The senior wife named Chyyrdy,", "note": ""},
    {"line": 9, "english": "the wife of Jakyp,", "note": ""},
    {"line": 10, "english": "had developed a strange craving.", "note": ""},
    {"line": 11, "english": "He slaughtered eighty mares from his horses,", "note": ""},
    {"line": 12, "english": "but she was not satisfied with meat,", "note": ""},
    {"line": 13, "english": "that senior wife, Chyyrdy,", "note": ""},
    {"line": 14, "english": "and did not abandon her craving at all.", "note": ""},
    {"line": 15, "english": "A set of nine, led by a camel,", "note": ""},
    {"line": 16, "english": "and Jakyp slaughtered more livestock;", "note": ""},
    {"line": 17, "english": "before the senior wife", "note": ""},
    {"line": 18, "english": "he also set the meat he had slaughtered.", "note": ""}
  ]
}
