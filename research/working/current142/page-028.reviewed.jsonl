{"id": "sayakbay-ms-current142:pdf028:l011", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 28, "folio": 2345, "line_in_page": 11, "raw": "Айбын туулган кеби ушу,", "text": "Айбын туулган кеби ушу,", "en": "This was the proud-born one's speech,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "First two words are difficult.", "bbox": null}
{"id": "sayakbay-ms-current142:pdf028:l012", "source_id": "sayakbay-ms-current142", "pdf_sha256": "2b1fd33d35b9fec662724180743e44a26bc44d8b347d5f99c373acf98cb6c73f", "page": 28, "folio": 2345, "line_in_page": 12, "raw": "Эр Сарбагыш баштаган,", "text": "Эр Сарбагыш баштаган,", "en": "Led by brave Sarbagysh,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Proper name read as Сарбагыш.", "bbox": null}
