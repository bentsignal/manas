[{"id":"semetey-1-2013:p1059:b003:l033","ordinal":157953,"en":"If you speak evil words again,"},{"id":"semetey-1-2013:p1059:b003:l034","ordinal":157954,"en":"Will a living soul not move in anger?"},{"id":"semetey-1-2013:p1059:b003:l035","ordinal":157955,"en":"After Aychürök is given in tribute,"},{"id":"semetey-1-2013:p1059:b003:l036","ordinal":157956,"en":"Will poor Tümönbay not burn with shame?"},{"id":"semetey-1-2013:p1059:b003:l037","ordinal":157957,"en":"When matters were about to enter agreement,"},{"id":"semetey-1-2013:p1059:b003:l038","ordinal":157958,"en":"When they were about to make an offering before you,"},{"id":"semetey-1-2013:p1059:b003:l039","ordinal":157959,"en":"When they were about to give their daughter,"},{"id":"semetey-1-2013:p1059:b005:l001","ordinal":157960,"en":"You prove a foolish man;"},{"id":"semetey-1-2013:p1059:b005:l002","ordinal":157961,"en":"Why did God strike you?\""},{"id":"semetey-1-2013:p1059:b005:l003","ordinal":157962,"en":"Speaking such words,"},{"id":"semetey-1-2013:p1059:b005:l004","ordinal":157963,"en":"He spoke many words that humbled"},{"id":"semetey-1-2013:p1059:b005:l005","ordinal":157964,"en":"Kozho, son of Shygay."},{"id":"semetey-1-2013:p1059:b005:l006","ordinal":157965,"en":"Raging and making him strain,"},{"id":"semetey-1-2013:p1059:b005:l007","ordinal":157966,"en":"What could dear Tölök do?"},{"id":"semetey-1-2013:p1059:b005:l008","ordinal":157967,"en":"He held Kozho, son of Shygay,"},{"id":"semetey-1-2013:p1059:b005:l009","ordinal":157968,"en":"And kept him struggling."},{"id":"semetey-1-2013:p1059:b005:l010","ordinal":157969,"en":"Clinging without releasing him,"},{"id":"semetey-1-2013:p1059:b005:l011","ordinal":157970,"en":"Grappling with Tümönbay,"},{"id":"semetey-1-2013:p1059:b005:l012","ordinal":157971,"en":"They stopped between the sides,"},{"id":"semetey-1-2013:p1059:b005:l013","ordinal":157972,"en":"And bristled at one another."},{"id":"semetey-1-2013:p1059:b005:l014","ordinal":157973,"en":"Stopping in the space between,"},{"id":"semetey-1-2013:p1059:b005:l015","ordinal":157974,"en":"They cursed one another aloud;"},{"id":"semetey-1-2013:p1059:b005:l016","ordinal":157975,"en":"Unable to reach each other,"},{"id":"semetey-1-2013:p1059:b005:l017","ordinal":157976,"en":"They fought with their mouths."},{"id":"semetey-1-2013:p1059:b005:l018","ordinal":157977,"en":"Displaying his superiority,"},{"id":"semetey-1-2013:p1059:b005:l019","ordinal":157978,"en":"Tölök brought Kozho, son of Shygay,"},{"id":"semetey-1-2013:p1059:b005:l020","ordinal":157979,"en":"To heed his words."},{"id":"semetey-1-2013:p1059:b005:l021","ordinal":157980,"en":"Displaying his eloquence,"},{"id":"semetey-1-2013:p1059:b005:l022","ordinal":157981,"en":"Azhybay barely brought"},{"id":"semetey-1-2013:p1059:b005:l023","ordinal":157982,"en":"Tümönbay to heed his words."},{"id":"semetey-1-2013:p1059:b005:l024","ordinal":157983,"en":"Deceiving him all the while, Azhybay"},{"id":"semetey-1-2013:p1059:b005:l025","ordinal":157984,"en":"Had Tümönbay mounted"},{"id":"semetey-1-2013:p1059:b005:l026","ordinal":157985,"en":"On his black-blazed thoroughbred."},{"id":"semetey-1-2013:p1059:b005:l027","ordinal":157986,"en":"Tümönbay came to a halt."},{"id":"semetey-1-2013:p1059:b005:l028","ordinal":157987,"en":"These two among the Zhediger"},{"id":"semetey-1-2013:p1059:b005:l029","ordinal":157988,"en":"Made an entertaining tale of it;"},{"id":"semetey-1-2013:p1059:b005:l030","ordinal":157989,"en":"Tümönbay, son of Tülkü,"},{"id":"semetey-1-2013:p1059:b005:l031","ordinal":157990,"en":"Was left with a bad name."},{"id":"semetey-1-2013:p1059:b005:l032","ordinal":157991,"en":"Trampling the ground he walked,"},{"id":"semetey-1-2013:p1059:b005:l033","ordinal":157992,"en":"They spoke ill of Tümönbay."},{"id":"semetey-1-2013:p1059:b005:l034","ordinal":157993,"en":"Azhybay, son of Azhy,"},{"id":"semetey-1-2013:p1059:b005:l035","ordinal":157994,"en":"Was a swift-tongued eloquent servant,"},{"id":"semetey-1-2013:p1059:b005:l036","ordinal":157995,"en":"A son who found sound arguments;"},{"id":"semetey-1-2013:p1059:b005:l037","ordinal":157996,"en":"When he acted with wisdom,"},{"id":"semetey-1-2013:p1059:b005:l038","ordinal":157997,"en":"For the entire world"},{"id":"semetey-1-2013:p1059:b005:l039","ordinal":157998,"en":"He was a servant beyond price."},{"id":"semetey-1-2013:p1060:b003:l001","ordinal":157999,"en":"This one was fit to govern a people,"},{"id":"semetey-1-2013:p1060:b003:l002","ordinal":158000,"en":"That one was fit to remain among them."},{"id":"semetey-1-2013:p1060:b003:l003","ordinal":158001,"en":"This one was a true man."},{"id":"semetey-1-2013:p1060:b003:l004","ordinal":158002,"en":"As the Zhediger stood so,"},{"id":"semetey-1-2013:p1060:b003:l005","ordinal":158003,"en":"Raging and straining,"},{"id":"semetey-1-2013:p1060:b003:l006","ordinal":158004,"en":"Tümönbay, son of Tülkü,"},{"id":"semetey-1-2013:p1060:b003:l007","ordinal":158005,"en":"Jerking his black-blazed thoroughbred"},{"id":"semetey-1-2013:p1060:b003:l008","ordinal":158006,"en":"As though its rider had died,"},{"id":"semetey-1-2013:p1060:b003:l009","ordinal":158007,"en":"Brandishing his spear and shouting:"},{"id":"semetey-1-2013:p1060:b003:l010","ordinal":158008,"en":"\"I will make your mother my wife!"},{"id":"semetey-1-2013:p1060:b003:l011","ordinal":158009,"en":"Come out now for single combat!\""},{"id":"semetey-1-2013:p1060:b003:l012","ordinal":158010,"en":"The black-blazed thoroughbred"},{"id":"semetey-1-2013:p1060:b003:l013","ordinal":158011,"en":"He reined in and turned;"},{"id":"semetey-1-2013:p1060:b003:l014","ordinal":158012,"en":"Tümönbay, son of Tülkü,"},{"id":"semetey-1-2013:p1060:b003:l015","ordinal":158013,"en":"Surged forward holding his spear,"},{"id":"semetey-1-2013:p1060:b003:l016","ordinal":158014,"en":"And leveled it straight before him."},{"id":"semetey-1-2013:p1060:b003:l017","ordinal":158015,"en":"Tölök and Chynkozho,"},{"id":"semetey-1-2013:p1060:b003:l018","ordinal":158016,"en":"Without letting Tümönbay hear,"},{"id":"semetey-1-2013:p1060:b003:l019","ordinal":158017,"en":"Called Azhybay and spoke:"},{"id":"semetey-1-2013:p1060:b003:l020","ordinal":158018,"en":"\"You are the guardian of human honor,"},{"id":"semetey-1-2013:p1060:b003:l021","ordinal":158019,"en":"Azhybay, son of Azhy;"},{"id":"semetey-1-2013:p1060:b003:l022","ordinal":158020,"en":"You are one of the wise!"},{"id":"semetey-1-2013:p1060:b003:l023","ordinal":158021,"en":"You are skilled in speech,"},{"id":"semetey-1-2013:p1060:b003:l024","ordinal":158022,"en":"The best at loosening knots."},{"id":"semetey-1-2013:p1060:b003:l025","ordinal":158023,"en":"Judge it yourself and know yourself:"},{"id":"semetey-1-2013:p1060:b003:l026","ordinal":158024,"en":"Tümönbay, son of Tülkü,"},{"id":"semetey-1-2013:p1060:b003:l027","ordinal":158025,"en":"That ill-tempered hero—"},{"id":"semetey-1-2013:p1060:b003:l028","ordinal":158026,"en":"From now on do not let him near,"},{"id":"semetey-1-2013:p1060:b003:l029","ordinal":158027,"en":"That infidel with a white devil!"},{"id":"semetey-1-2013:p1060:b003:l030","ordinal":158028,"en":"Azhybay, son of Azhy,"},{"id":"semetey-1-2013:p1060:b003:l031","ordinal":158029,"en":"Your honesty became clear today."},{"id":"semetey-1-2013:p1060:b003:l032","ordinal":158030,"en":"Akun's daughter Chürök—"},{"id":"semetey-1-2013:p1060:b003:l033","ordinal":158031,"en":"If you will give her, tell us your trouble;"},{"id":"semetey-1-2013:p1060:b003:l034","ordinal":158032,"en":"Toltoy may take Chürök—"},{"id":"semetey-1-2013:p1060:b003:l035","ordinal":158033,"en":"Tell us the day!"},{"id":"semetey-1-2013:p1060:b003:l036","ordinal":158034,"en":"Stand beneath the banner before you leave,"},{"id":"semetey-1-2013:p1060:b003:l037","ordinal":158035,"en":"Make your pledge before you leave;"},{"id":"semetey-1-2013:p1060:b003:l038","ordinal":158036,"en":"Say, 'I shall certainly give Chürök!'"},{"id":"semetey-1-2013:p1060:b003:l039","ordinal":158037,"en":"And put the day in writing before you leave."},{"id":"semetey-1-2013:p1060:b004:l001","ordinal":158038,"en":"Take the appointed date with you;"},{"id":"semetey-1-2013:p1060:b004:l002","ordinal":158039,"en":"Say, 'I shall certainly give Chürök,'"},{"id":"semetey-1-2013:p1060:b004:l003","ordinal":158040,"en":"And make the pledge before you leave!"},{"id":"semetey-1-2013:p1060:b004:l004","ordinal":158041,"en":"We too will make a pledge;"},{"id":"semetey-1-2013:p1060:b004:l005","ordinal":158042,"en":"Swear your dying oath before you leave!"},{"id":"semetey-1-2013:p1060:b004:l006","ordinal":158043,"en":"Chew and offer the white wheat,"},{"id":"semetey-1-2013:p1060:b004:l007","ordinal":158044,"en":"And hold out the oath-token."},{"id":"semetey-1-2013:p1060:b004:l008","ordinal":158045,"en":"Let brave Toltoy be the bridegroom."},{"id":"semetey-1-2013:p1060:b004:l009","ordinal":158046,"en":"Without letting a single person know,"},{"id":"semetey-1-2013:p1060:b004:l010","ordinal":158047,"en":"Without letting a single person learn of it,"},{"id":"semetey-1-2013:p1060:b004:l011","ordinal":158048,"en":"I shall give as her bride-price"},{"id":"semetey-1-2013:p1060:b004:l012","ordinal":158049,"en":"Eight hundred black horses like hair."},{"id":"semetey-1-2013:p1060:b004:l013","ordinal":158050,"en":"For Aychürök's bride-price,"},{"id":"semetey-1-2013:p1060:b004:l014","ordinal":158051,"en":"I am now preparing to bring"},{"id":"semetey-1-2013:p1060:b004:l015","ordinal":158052,"en":"Before Khan Akun"},{"id":"semetey-1-2013:p1060:b004:l016","ordinal":158053,"en":"One thousand piebald horses like hair."},{"id":"semetey-1-2013:p1060:b004:l017","ordinal":158054,"en":"Aychürök of Khan Akun,"},{"id":"semetey-1-2013:p1060:b004:l018","ordinal":158055,"en":"The beauty whose fame has spread,"},{"id":"semetey-1-2013:p1060:b004:l019","ordinal":158056,"en":"I shall take the girl through marriage alliance;"},{"id":"semetey-1-2013:p1060:b004:l020","ordinal":158057,"en":"I shall take a skilled beauty like her."},{"id":"semetey-1-2013:p1060:b004:l021","ordinal":158058,"en":"If it can be managed, for Chürök,"},{"id":"semetey-1-2013:p1060:b004:l022","ordinal":158059,"en":"For Khan Akun himself,"},{"id":"semetey-1-2013:p1060:b004:l023","ordinal":158060,"en":"I have prepared from the beginning"},{"id":"semetey-1-2013:p1060:b004:l024","ordinal":158061,"en":"Eighty red pack-loads;"},{"id":"semetey-1-2013:p1060:b004:l025","ordinal":158062,"en":"Loaded upon those packs"},{"id":"semetey-1-2013:p1060:b004:l026","ordinal":158063,"en":"I have red gold and silk;"},{"id":"semetey-1-2013:p1060:b004:l027","ordinal":158064,"en":"To set the loads right and tie them on,"},{"id":"semetey-1-2013:p1060:b004:l028","ordinal":158065,"en":"I have exactly sixty servants."},{"id":"semetey-1-2013:p1060:b004:l029","ordinal":158066,"en":"The price of a single load"},{"id":"semetey-1-2013:p1060:b004:l030","ordinal":158067,"en":"Is the blood-price of ninety men."},{"id":"semetey-1-2013:p1060:b004:l031","ordinal":158068,"en":"I have been preparing the bride-price;"},{"id":"semetey-1-2013:p1060:b004:l032","ordinal":158069,"en":"Listen well, dear Azhy."},{"id":"semetey-1-2013:p1060:b004:l033","ordinal":158070,"en":"I too know the worth of people."},{"id":"semetey-1-2013:p1060:b004:l034","ordinal":158071,"en":"When Akun's daughter Aychürök"},{"id":"semetey-1-2013:p1060:b004:l035","ordinal":158072,"en":"And Khan Akun, without speaking ill of us,"},{"id":"semetey-1-2013:p1060:b004:l036","ordinal":158073,"en":"Come to the summer pasture,"},{"id":"semetey-1-2013:p1060:b004:l037","ordinal":158074,"en":"I have been hoping"},{"id":"semetey-1-2013:p1060:b004:l038","ordinal":158075,"en":"To surround them and make a marriage alliance."},{"id":"semetey-1-2013:p1060:b004:l039","ordinal":158076,"en":"If you give your daughter Chürök—"},{"id":"semetey-1-2013:p1061:b003:l001","ordinal":158077,"en":"I shall agree to what you say;"},{"id":"semetey-1-2013:p1061:b003:l002","ordinal":158078,"en":"I shall weigh out the gold by the pood"},{"id":"semetey-1-2013:p1061:b003:l003","ordinal":158079,"en":"And give it as the matchmaker's gift."},{"id":"semetey-1-2013:p1061:b003:l004","ordinal":158080,"en":"By wedding Toltoy,"},{"id":"semetey-1-2013:p1061:b003:l005","ordinal":158081,"en":"I shall see your sincerity."},{"id":"semetey-1-2013:p1061:b003:l006","ordinal":158082,"en":"The peri's daughter Chürök—"},{"id":"semetey-1-2013:p1061:b003:l007","ordinal":158083,"en":"If it is truly certain you will give her,"},{"id":"semetey-1-2013:p1061:b003:l008","ordinal":158084,"en":"With a golden collar and copper sleeves,"},{"id":"semetey-1-2013:p1061:b003:l009","ordinal":158085,"en":"I shall clothe you in a coat of mail;"},{"id":"semetey-1-2013:p1061:b003:l010","ordinal":158086,"en":"The Karat horse beneath me—"},{"id":"semetey-1-2013:p1061:b003:l011","ordinal":158087,"en":"I shall have you mount it."},{"id":"semetey-1-2013:p1061:b003:l012","ordinal":158088,"en":"Brave Toltoy's Surkoen"},{"id":"semetey-1-2013:p1061:b003:l013","ordinal":158089,"en":"I shall give as a ceremonial horse;"},{"id":"semetey-1-2013:p1061:b003:l014","ordinal":158090,"en":"I shall agree to what you say."},{"id":"semetey-1-2013:p1061:b003:l015","ordinal":158091,"en":"To carry your caravan's loads,"},{"id":"semetey-1-2013:p1061:b003:l016","ordinal":158092,"en":"I shall choose and give a stud camel."},{"id":"semetey-1-2013:p1061:b003:l017","ordinal":158093,"en":"If you will give Chürök,"},{"id":"semetey-1-2013:p1061:b003:l018","ordinal":158094,"en":"I shall firmly give a great bride-price."},{"id":"semetey-1-2013:p1061:b003:l019","ordinal":158095,"en":"If it lies within my reach, unstintingly"},{"id":"semetey-1-2013:p1061:b003:l020","ordinal":158096,"en":"I shall show you honor and shelter;"},{"id":"semetey-1-2013:p1061:b003:l021","ordinal":158097,"en":"As customary bride-price,"},{"id":"semetey-1-2013:p1061:b003:l022","ordinal":158098,"en":"I shall give seventy women as servants!\""},{"id":"semetey-1-2013:p1061:b003:l023","ordinal":158099,"en":"When Kozho spoke thus,"},{"id":"semetey-1-2013:p1061:b003:l024","ordinal":158100,"en":"To Kozho, who spoke empty words,"},{"id":"semetey-1-2013:p1061:b003:l025","ordinal":158101,"en":"Your Azhy bowed low;"},{"id":"semetey-1-2013:p1061:b003:l026","ordinal":158102,"en":"Rising before Kozho,"},{"id":"semetey-1-2013:p1061:b003:l027","ordinal":158103,"en":"He made obeisance to him."},{"id":"semetey-1-2013:p1061:b003:l028","ordinal":158104,"en":"Azhybay stood before Kozho:"},{"id":"semetey-1-2013:p1061:b003:l029","ordinal":158105,"en":"\"Agreed, heroic Kozho,\" he said."},{"id":"semetey-1-2013:p1061:b003:l030","ordinal":158106,"en":"\"If I do not give Aychürök,"},{"id":"semetey-1-2013:p1061:b003:l031","ordinal":158107,"en":"May my seven forefathers be infidels;"},{"id":"semetey-1-2013:p1061:b003:l032","ordinal":158108,"en":"Let him accept what I have said,"},{"id":"semetey-1-2013:p1061:b003:l033","ordinal":158109,"en":"And let your hero, bridegroom Toltoy,"},{"id":"semetey-1-2013:p1061:b003:l034","ordinal":158110,"en":"Come in seven days.\""},{"id":"semetey-1-2013:p1061:b003:l035","ordinal":158111,"en":"He pledged it and made ready;"},{"id":"semetey-1-2013:p1061:b003:l036","ordinal":158112,"en":"Azhybay rode toward the city."},{"id":"semetey-1-2013:p1061:b003:l037","ordinal":158113,"en":"Tümönbay, son of Tülkü,"},{"id":"semetey-1-2013:p1061:b003:l038","ordinal":158114,"en":"Burst from the flank in fury,"},{"id":"semetey-1-2013:p1061:b003:l039","ordinal":158115,"en":"And spoke angrily to Azhybay:"},{"id":"semetey-1-2013:p1061:b004:l001","ordinal":158116,"en":"\"You son of a bitch, Azhybay,"},{"id":"semetey-1-2013:p1061:b004:l002","ordinal":158117,"en":"Why could you not keep your mouth shut?"},{"id":"semetey-1-2013:p1061:b004:l003","ordinal":158118,"en":"Without babbling, 'I shall give the girl,'"},{"id":"semetey-1-2013:p1061:b004:l004","ordinal":158119,"en":"Taking eight hundred matching horses,"},{"id":"semetey-1-2013:p1061:b004:l005","ordinal":158120,"en":"Will you be the one made rich?!"},{"id":"semetey-1-2013:p1061:b004:l006","ordinal":158121,"en":"Eating no meat from a knucklebone,"},{"id":"semetey-1-2013:p1061:b004:l007","ordinal":158122,"en":"Riding no dappled pacing horse,"},{"id":"semetey-1-2013:p1061:b004:l008","ordinal":158123,"en":"Am I to be left forlorn?!"},{"id":"semetey-1-2013:p1061:b004:l009","ordinal":158124,"en":"Taking a thousand black camels,"},{"id":"semetey-1-2013:p1061:b004:l010","ordinal":158125,"en":"Loading gold upon their packs,"},{"id":"semetey-1-2013:p1061:b004:l011","ordinal":158126,"en":"Putting it into your treasury,"},{"id":"semetey-1-2013:p1061:b004:l012","ordinal":158127,"en":"Lying there with your belly swollen—"},{"id":"semetey-1-2013:p1061:b004:l013","ordinal":158128,"en":"Will that be you, dear Azhy?!"},{"id":"semetey-1-2013:p1061:b004:l014","ordinal":158129,"en":"Eating no knucklebone's meat,"},{"id":"semetey-1-2013:p1061:b004:l015","ordinal":158130,"en":"Riding no dappled pacing horse,"},{"id":"semetey-1-2013:p1061:b004:l016","ordinal":158131,"en":"Am I to be left forlorn?!"},{"id":"semetey-1-2013:p1061:b004:l017","ordinal":158132,"en":"God surely exists, Azhybay,"},{"id":"semetey-1-2013:p1061:b004:l018","ordinal":158133,"en":"For your speech that boasts of eloquence,"},{"id":"semetey-1-2013:p1061:b004:l019","ordinal":158134,"en":"For this boundless deed of yours."},{"id":"semetey-1-2013:p1061:b004:l020","ordinal":158135,"en":"Who will hear your words"},{"id":"semetey-1-2013:p1061:b004:l021","ordinal":158136,"en":"After this deed you have done?"},{"id":"semetey-1-2013:p1061:b004:l022","ordinal":158137,"en":"I have seen what you have done.\""},{"id":"semetey-1-2013:p1061:b004:l023","ordinal":158138,"en":"Azhybay quarreled with Tümönbay,"},{"id":"semetey-1-2013:p1061:b004:l024","ordinal":158139,"en":"And Tümönbay quarreled with Azhybay;"},{"id":"semetey-1-2013:p1061:b004:l025","ordinal":158140,"en":"They stopped there together,"},{"id":"semetey-1-2013:p1061:b004:l026","ordinal":158141,"en":"And traded angry abuse."},{"id":"semetey-1-2013:p1061:b004:l027","ordinal":158142,"en":"Toward Khan Akun's city,"},{"id":"semetey-1-2013:p1061:b004:l028","ordinal":158143,"en":"They now arrived;"},{"id":"semetey-1-2013:p1061:b004:l029","ordinal":158144,"en":"Toward Khan Akun's fortress,"},{"id":"semetey-1-2013:p1061:b004:l030","ordinal":158145,"en":"Toward the palace where the khan dwelt,"},{"id":"semetey-1-2013:p1061:b004:l031","ordinal":158146,"en":"Aychürök now kept watch."},{"id":"semetey-1-2013:p1061:b004:l032","ordinal":158147,"en":"To seize Chürök,"},{"id":"semetey-1-2013:p1061:b004:l033","ordinal":158148,"en":"To take her as a gift"},{"id":"semetey-1-2013:p1061:b004:l034","ordinal":158149,"en":"To Toltoy of the Zhediger,"},{"id":"semetey-1-2013:p1061:b004:l035","ordinal":158150,"en":"And to preserve alive"},{"id":"semetey-1-2013:p1061:b004:l036","ordinal":158151,"en":"The vast multitude of Afghans,"},{"id":"semetey-1-2013:p1061:b004:l037","ordinal":158152,"en":"Azhybay and Tümönbay"},{"id":"semetey-1-2013:p1061:b004:l038","ordinal":158153,"en":"Stalked Aychürök,"},{"id":"semetey-1-2013:p1061:b004:l039","ordinal":158154,"en":"Skirting the place where she slept."},{"id":"semetey-1-2013:p1062:b003:l001","ordinal":158155,"en":"If they came near the palace,"},{"id":"semetey-1-2013:p1062:b003:l002","ordinal":158156,"en":"Aychürök, daughter of Akun,"},{"id":"semetey-1-2013:p1062:b003:l003","ordinal":158157,"en":"Was exceedingly prudent and wise;"},{"id":"semetey-1-2013:p1062:b003:l004","ordinal":158158,"en":"Yet wit alone could not save"},{"id":"semetey-1-2013:p1062:b003:l005","ordinal":158159,"en":"Poor Chürök from the infidels."},{"id":"semetey-1-2013:p1062:b003:l006","ordinal":158160,"en":"Keeping the hero's condition unknown,"},{"id":"semetey-1-2013:p1062:b003:l007","ordinal":158161,"en":"She had become absorbed in diversion;"},{"id":"semetey-1-2013:p1062:b003:l008","ordinal":158162,"en":"For many days on end"},{"id":"semetey-1-2013:p1062:b003:l009","ordinal":158163,"en":"She had lain beside Semetey."},{"id":"semetey-1-2013:p1062:b003:l010","ordinal":158164,"en":"Azhybay and Tümönbay"},{"id":"semetey-1-2013:p1062:b003:l011","ordinal":158165,"en":"Had learned of the one between them."},{"id":"semetey-1-2013:p1062:b003:l012","ordinal":158166,"en":"Wondering, \"How will those two come?\""},{"id":"semetey-1-2013:p1062:b003:l013","ordinal":158167,"en":"She had gone into her bed."},{"id":"semetey-1-2013:p1062:b003:l014","ordinal":158168,"en":"For many days and many nights,"},{"id":"semetey-1-2013:p1062:b003:l015","ordinal":158169,"en":"The doomed woman had not slept;"},{"id":"semetey-1-2013:p1062:b003:l016","ordinal":158170,"en":"She had sunk into pleasure."},{"id":"semetey-1-2013:p1062:b003:l017","ordinal":158171,"en":"When those two arrived,"},{"id":"semetey-1-2013:p1062:b003:l018","ordinal":158172,"en":"She lay sleeping without stirring."},{"id":"semetey-1-2013:p1062:b003:l019","ordinal":158173,"en":"At Aychürök's house,"},{"id":"semetey-1-2013:p1062:b003:l020","ordinal":158174,"en":"By her door, the gatekeeper"},{"id":"semetey-1-2013:p1062:b003:l021","ordinal":158175,"en":"Began a conversation;"},{"id":"semetey-1-2013:p1062:b003:l022","ordinal":158176,"en":"They asked the gatekeeper:"},{"id":"semetey-1-2013:p1062:b003:l023","ordinal":158177,"en":"\"Aychürök, daughter of Akun—"},{"id":"semetey-1-2013:p1062:b003:l024","ordinal":158178,"en":"Is Chürök in the house?"},{"id":"semetey-1-2013:p1062:b003:l025","ordinal":158179,"en":"The turmoil that stirred the whole world—"},{"id":"semetey-1-2013:p1062:b003:l026","ordinal":158180,"en":"Is that trouble in the house?\""},{"id":"semetey-1-2013:p1062:b003:l027","ordinal":158181,"en":"If you ask how Chürök fared,"},{"id":"semetey-1-2013:p1062:b003:l028","ordinal":158182,"en":"She woke with a start from sleep,"},{"id":"semetey-1-2013:p1062:b003:l029","ordinal":158183,"en":"And rolled onto her right side;"},{"id":"semetey-1-2013:p1062:b003:l030","ordinal":158184,"en":"Her excited heart grew calm,"},{"id":"semetey-1-2013:p1062:b003:l031","ordinal":158185,"en":"Her eyes opened wide as bowls,"},{"id":"semetey-1-2013:p1062:b003:l032","ordinal":158186,"en":"And Aychürök sprang up."},{"id":"semetey-1-2013:p1062:b003:l033","ordinal":158187,"en":"From outside the door came a shout:"},{"id":"semetey-1-2013:p1062:b003:l034","ordinal":158188,"en":"Azhybay and Tümönbay"},{"id":"semetey-1-2013:p1062:b003:l035","ordinal":158189,"en":"Were calling out for Aychürök."},{"id":"semetey-1-2013:p1062:b003:l036","ordinal":158190,"en":"Aychürök, daughter of Akun,"},{"id":"semetey-1-2013:p1062:b003:l037","ordinal":158191,"en":"Rose thoughtfully, drawing out her thoughts,"},{"id":"semetey-1-2013:p1062:b003:l038","ordinal":158192,"en":"Stretching tall like a young plane tree,"},{"id":"semetey-1-2013:p1062:b003:l039","ordinal":158193,"en":"Arching herself like a lynx,"},{"id":"semetey-1-2013:p1062:b004:l001","ordinal":158194,"en":"Reluctant to utter a word,"},{"id":"semetey-1-2013:p1062:b004:l002","ordinal":158195,"en":"Maturing in beauty like a doe,"},{"id":"semetey-1-2013:p1062:b004:l003","ordinal":158196,"en":"Her hair winding around her head,"},{"id":"semetey-1-2013:p1062:b004:l004","ordinal":158197,"en":"Maturing in beauty like a deer,"},{"id":"semetey-1-2013:p1062:b004:l005","ordinal":158198,"en":"Her hair winding around her feet."},{"id":"semetey-1-2013:p1062:b004:l006","ordinal":158199,"en":"Radiant Aychürök"},{"id":"semetey-1-2013:p1062:b004:l007","ordinal":158200,"en":"Turned and came out through the door."},{"id":"semetey-1-2013:p1062:b004:l008","ordinal":158201,"en":"\"I have a grave already dug;"},{"id":"semetey-1-2013:p1062:b004:l009","ordinal":158202,"en":"My dear Aychürök,"},{"id":"semetey-1-2013:p1062:b004:l010","ordinal":158203,"en":"I have boiling misery."},{"id":"semetey-1-2013:p1062:b004:l011","ordinal":158204,"en":"Toltoy of the Zhediger"},{"id":"semetey-1-2013:p1062:b004:l012","ordinal":158205,"en":"And his consummate hero Kozho"},{"id":"semetey-1-2013:p1062:b004:l013","ordinal":158206,"en":"Have descended upon our heads;"},{"id":"semetey-1-2013:p1062:b004:l014","ordinal":158207,"en":"They have scattered all our livestock."},{"id":"semetey-1-2013:p1062:b004:l015","ordinal":158208,"en":"Unless we give you as a tribute,"}]
