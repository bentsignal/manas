[{"id":"manas-2010:p0353:b001:l007","ordinal":16129,"en":"Among the skilled who drew the bow,"},{"id":"manas-2010:p0353:b001:l008","ordinal":16130,"en":"Among the finest who cast lassos,"},{"id":"manas-2010:p0353:b001:l009","ordinal":16131,"en":"Among the very bravest,"},{"id":"manas-2010:p0353:b001:l010","ordinal":16132,"en":"Among countless marksmen,"},{"id":"manas-2010:p0353:b001:l011","ordinal":16133,"en":"Among the skilled whose courage was full,"},{"id":"manas-2010:p0353:b001:l012","ordinal":16134,"en":"Among the mighty who never retreated,"},{"id":"manas-2010:p0353:b001:l013","ordinal":16135,"en":"Unhurried when floods overwhelmed him,"},{"id":"manas-2010:p0353:b001:l014","ordinal":16136,"en":"No ordinary man, that accursed one,"},{"id":"manas-2010:p0353:b001:l015","ordinal":16137,"en":"Never retreating before fire,"},{"id":"manas-2010:p0353:b001:l016","ordinal":16138,"en":"Among those who stood beneath the banner,"},{"id":"manas-2010:p0353:b001:l017","ordinal":16139,"en":"Charging at the cry of 'Enemy!'"},{"id":"manas-2010:p0353:b001:l018","ordinal":16140,"en":"Among those who girded their waists tight,"},{"id":"manas-2010:p0353:b001:l019","ordinal":16141,"en":"Karazhoy set out along the road"},{"id":"manas-2010:p0353:b001:l020","ordinal":16142,"en":"To capture Manas and bind him,"},{"id":"manas-2010:p0353:b001:l021","ordinal":16143,"en":"To bring calamity,"},{"id":"manas-2010:p0353:b001:l022","ordinal":16144,"en":"He too with an army of one thousand!"},{"id":"manas-2010:p0353:b001:l023","ordinal":16145,"en":"Behind him,"},{"id":"manas-2010:p0353:b001:l024","ordinal":16146,"en":"A mighty man wearing a short coat,"},{"id":"manas-2010:p0353:b001:l025","ordinal":16147,"en":"Skilled, a cultivator of wisdom,"},{"id":"manas-2010:p0353:b001:l026","ordinal":16148,"en":"Outstanding among spearmen,"},{"id":"manas-2010:p0353:b001:l027","ordinal":16149,"en":"Excellent and renowned in war,"},{"id":"manas-2010:p0353:b001:l028","ordinal":16150,"en":"In short, a hero in battle,"},{"id":"manas-2010:p0353:b001:l029","ordinal":16151,"en":"A master thoroughly versed in the enemy's tactics,"},{"id":"manas-2010:p0353:b001:l030","ordinal":16152,"en":"A cruel-hearted unbeliever,"},{"id":"manas-2010:p0353:b001:l031","ordinal":16153,"en":"A hero who knew the enemy's stratagems,"},{"id":"manas-2010:p0353:b001:l032","ordinal":16154,"en":"His sword with a precious keen edge,"},{"id":"manas-2010:p0353:b001:l033","ordinal":16155,"en":"His spear with an exceptional point,"},{"id":"manas-2010:p0353:b001:l034","ordinal":16156,"en":"Sated with dark blood,"},{"id":"manas-2010:p0353:b001:l035","ordinal":16157,"en":"Standing to fight without fleeing,"},{"id":"manas-2010:p0353:b001:l036","ordinal":16158,"en":"Posted in a perilous place,"},{"id":"manas-2010:p0353:b001:l037","ordinal":16159,"en":"As though about to strike,"},{"id":"manas-2010:p0353:b001:l038","ordinal":16160,"en":"Tethered with a collar and chain,"},{"id":"manas-2010:p0353:b001:l039","ordinal":16161,"en":"Choosing troops from the formidable,"},{"id":"manas-2010:p0353:b001:l040","ordinal":16162,"en":"Döödür set out along the road,"},{"id":"manas-2010:p0353:b001:l041","ordinal":16163,"en":"He too with an army of one thousand."},{"id":"manas-2010:p0353:b001:l042","ordinal":16164,"en":"Taking orders from his khan"},{"id":"manas-2010:p0353:b001:l043","ordinal":16165,"en":"To unleash terrible wrath,"},{"id":"manas-2010:p0353:b001:l044","ordinal":16166,"en":"Upon the Burut lord Manas,"},{"id":"manas-2010:p0353:b001:l045","ordinal":16167,"en":"To descend upon his head,"},{"id":"manas-2010:p0353:b001:l046","ordinal":16168,"en":"Slaughtering, butchering and destroying,"},{"id":"manas-2010:p0353:b001:l047","ordinal":16169,"en":"To scatter his four kinds of livestock."},{"id":"manas-2010:p0353:b001:l048","ordinal":16170,"en":"Maintaining champions and gathering troops,"},{"id":"manas-2010:p0354:b001:l001","ordinal":16171,"en":"Esenkan gave his command,"},{"id":"manas-2010:p0354:b001:l002","ordinal":16172,"en":"Against the fierce hero Manas"},{"id":"manas-2010:p0354:b001:l003","ordinal":16173,"en":"He gathered calamities in abundance."},{"id":"manas-2010:p0354:b001:l004","ordinal":16174,"en":"Of Beijing with its nested fortifications,"},{"id":"manas-2010:p0354:b001:l005","ordinal":16175,"en":"Esenkan was the ruler."},{"id":"manas-2010:p0354:b001:l006","ordinal":16176,"en":"A khan of mighty wrath:"},{"id":"manas-2010:p0354:b001:l007","ordinal":16177,"en":"“If Manas grows to manhood,"},{"id":"manas-2010:p0354:b001:l008","ordinal":16178,"en":"He will bring havoc,” he thought,"},{"id":"manas-2010:p0354:b001:l009","ordinal":16179,"en":"And feared him greatly."},{"id":"manas-2010:p0354:b001:l010","ordinal":16180,"en":"A keen judge, a commanding lion,"},{"id":"manas-2010:p0354:b001:l011","ordinal":16181,"en":"Esenkan, master of Beijing,"},{"id":"manas-2010:p0354:b001:l012","ordinal":16182,"en":"Was a formidable man, craftier than others."},{"id":"manas-2010:p0354:b001:l013","ordinal":16183,"en":"His sovereignty was extraordinary,"},{"id":"manas-2010:p0354:b001:l014","ordinal":16184,"en":"His knowledge was considerable."},{"id":"manas-2010:p0354:b001:l015","ordinal":16185,"en":"He was both ruler and khan;"},{"id":"manas-2010:p0354:b001:l016","ordinal":16186,"en":"This fierce Esenkan"},{"id":"manas-2010:p0354:b001:l017","ordinal":16187,"en":"Possessed the gift of second sight."},{"id":"manas-2010:p0354:b001:l018","ordinal":16188,"en":"A judge of heroes, deeply knowing,"},{"id":"manas-2010:p0354:b001:l019","ordinal":16189,"en":"He was a man beyond reckoning."},{"id":"manas-2010:p0354:b001:l020","ordinal":16190,"en":"When that great Esenkan"},{"id":"manas-2010:p0354:b001:l021","ordinal":16191,"en":"Exerted his stern resolve,"},{"id":"manas-2010:p0354:b001:l022","ordinal":16192,"en":"His words were never idle;"},{"id":"manas-2010:p0354:b001:l023","ordinal":16193,"en":"From those days to these,"},{"id":"manas-2010:p0354:b001:l024","ordinal":16194,"en":"Once Esenkan gave an order,"},{"id":"manas-2010:p0354:b001:l025","ordinal":16195,"en":"He did not have to speak twice."},{"id":"manas-2010:p0354:b001:l026","ordinal":16196,"en":"Know his sovereignty by this:"},{"id":"manas-2010:p0354:b001:l027","ordinal":16197,"en":"Beijing's forty Chinese tribes"},{"id":"manas-2010:p0354:b001:l028","ordinal":16198,"en":"He held and gathered all together."},{"id":"manas-2010:p0354:b001:l029","ordinal":16199,"en":"When Esenkan gave command,"},{"id":"manas-2010:p0354:b001:l030","ordinal":16200,"en":"The great drum was beaten hard."},{"id":"manas-2010:p0354:b001:l031","ordinal":16201,"en":"He was a mighty Manchu khan;"},{"id":"manas-2010:p0354:b001:l032","ordinal":16202,"en":"Ezkara's forces massed together."},{"id":"manas-2010:p0354:b001:l033","ordinal":16203,"en":"There were khans wearing arm guards,"},{"id":"manas-2010:p0354:b001:l034","ordinal":16204,"en":"All their champions were there,"},{"id":"manas-2010:p0354:b001:l035","ordinal":16205,"en":"Strong men dressed in jackets,"},{"id":"manas-2010:p0354:b001:l036","ordinal":16206,"en":"Renowned masters of the spear,"},{"id":"manas-2010:p0354:b001:l037","ordinal":16207,"en":"Seasoned men who knew the enemy's devices."},{"id":"manas-2010:p0354:b001:l038","ordinal":16208,"en":"There were giants as great as mountains,"},{"id":"manas-2010:p0354:b001:l039","ordinal":16209,"en":"Titans no horse could carry;"},{"id":"manas-2010:p0354:b001:l040","ordinal":16210,"en":"A mortal could want for nothing—"},{"id":"manas-2010:p0354:b001:l041","ordinal":16211,"en":"He had people of every kind."},{"id":"manas-2010:p0354:b001:l042","ordinal":16212,"en":"Much is false, and much is true;"},{"id":"manas-2010:p0354:b001:l043","ordinal":16213,"en":"No one has returned from seeing it."},{"id":"manas-2010:p0354:b001:l044","ordinal":16214,"en":"Unless God knows it plainly,"},{"id":"manas-2010:p0354:b001:l045","ordinal":16215,"en":"Half is false and half is true;"},{"id":"manas-2010:p0354:b001:l046","ordinal":16216,"en":"Unless the Creator himself knows,"},{"id":"manas-2010:p0354:b001:l047","ordinal":16217,"en":"No one has come back from beside him."},{"id":"manas-2010:p0354:b001:l048","ordinal":16218,"en":"He dressed him in a coat of mail,"},{"id":"manas-2010:p0355:b001:l001","ordinal":16219,"en":"Mounted him on Chong-Küröng,"},{"id":"manas-2010:p0355:b001:l002","ordinal":16220,"en":"Gave him a thousand Manchu troops,"},{"id":"manas-2010:p0355:b001:l003","ordinal":16221,"en":"Each worth a thousand men,"},{"id":"manas-2010:p0355:b001:l004","ordinal":16222,"en":"Gave him many mighty fighters,"},{"id":"manas-2010:p0355:b001:l005","ordinal":16223,"en":"And sent Ezkara away."},{"id":"manas-2010:p0355:b001:l006","ordinal":16224,"en":"Bells rang thick and fast,"},{"id":"manas-2010:p0355:b001:l007","ordinal":16225,"en":"Troops surged and massed together;"},{"id":"manas-2010:p0355:b001:l008","ordinal":16226,"en":"The eye could not take them in."},{"id":"manas-2010:p0355:b001:l009","ordinal":16227,"en":"May God spare us the sight—"},{"id":"manas-2010:p0355:b001:l010","ordinal":16228,"en":"Their full extent could not be known."},{"id":"manas-2010:p0355:b001:l011","ordinal":16229,"en":"Swaying, stretching out along the edge,"},{"id":"manas-2010:p0355:b001:l012","ordinal":16230,"en":"Seven thousand mighty fighters swept forward."},{"id":"manas-2010:p0355:b001:l013","ordinal":16231,"en":"The earth shook and split apart."},{"id":"manas-2010:p0355:b001:l014","ordinal":16232,"en":"Those who would not flinch at a sword-stroke—"},{"id":"manas-2010:p0355:b001:l015","ordinal":16233,"en":"He set those hardened men apart."},{"id":"manas-2010:p0355:b001:l016","ordinal":16234,"en":"Those who would not cry “Ah!” under an axe—"},{"id":"manas-2010:p0355:b001:l017","ordinal":16235,"en":"He set those heroes apart."},{"id":"manas-2010:p0355:b001:l018","ordinal":16236,"en":"Those who aimed their shots at the foe—"},{"id":"manas-2010:p0355:b001:l019","ordinal":16237,"en":"He set his marksmen apart."},{"id":"manas-2010:p0355:b001:l020","ordinal":16238,"en":"Skilled and cunning with the spear—"},{"id":"manas-2010:p0355:b001:l021","ordinal":16239,"en":"He set those seasoned men apart."},{"id":"manas-2010:p0355:b001:l022","ordinal":16240,"en":"He divided them into separate groups;"},{"id":"manas-2010:p0355:b001:l023","ordinal":16241,"en":"Their opponents were forty households."},{"id":"manas-2010:p0355:b001:l024","ordinal":16242,"en":"Displaying their hostile purpose,"},{"id":"manas-2010:p0355:b001:l025","ordinal":16243,"en":"Riding long-eared mules,"},{"id":"manas-2010:p0355:b001:l026","ordinal":16244,"en":"Wearing swords without scabbards,"},{"id":"manas-2010:p0355:b001:l027","ordinal":16245,"en":"Like clouds about to rain again,"},{"id":"manas-2010:p0355:b001:l028","ordinal":16246,"en":"Their faces turned to wrath—"},{"id":"manas-2010:p0355:b001:l029","ordinal":16247,"en":"He set those seasoned men apart."},{"id":"manas-2010:p0355:b001:l030","ordinal":16248,"en":"Dun-colored, with dark rings on their legs—"},{"id":"manas-2010:p0355:b001:l031","ordinal":16249,"en":"He set the riders of gray horses apart."},{"id":"manas-2010:p0355:b001:l032","ordinal":16250,"en":"So fat their rumps were hollowed, unable to trot—"},{"id":"manas-2010:p0355:b001:l033","ordinal":16251,"en":"He set the riders of idle horses apart."},{"id":"manas-2010:p0355:b001:l034","ordinal":16252,"en":"Drawing the eye when seen,"},{"id":"manas-2010:p0355:b001:l035","ordinal":16253,"en":"Looking like white tents—"},{"id":"manas-2010:p0355:b001:l036","ordinal":16254,"en":"He set the riders of pale horses apart."},{"id":"manas-2010:p0355:b001:l037","ordinal":16255,"en":"Driving troops forward in successive waves,"},{"id":"manas-2010:p0355:b001:l038","ordinal":16256,"en":"Driving all the troops together,"},{"id":"manas-2010:p0355:b001:l039","ordinal":16257,"en":"The earth split and heaved;"},{"id":"manas-2010:p0355:b001:l040","ordinal":16258,"en":"All his titans and giants were there."},{"id":"manas-2010:p0355:b001:l041","ordinal":16259,"en":"A force of some seven thousand,"},{"id":"manas-2010:p0355:b001:l042","ordinal":16260,"en":"With trumpets and shawms sounding,"},{"id":"manas-2010:p0355:b001:l043","ordinal":16261,"en":"With loads also strapped to rhinoceroses,"},{"id":"manas-2010:p0355:b001:l044","ordinal":16262,"en":"Their broad arm guards jutting out,"},{"id":"manas-2010:p0355:b001:l045","ordinal":16263,"en":"His governors formed separate ranks."},{"id":"manas-2010:p0355:b001:l046","ordinal":16264,"en":"Only God could know it all:"},{"id":"manas-2010:p0355:b001:l047","ordinal":16265,"en":"When seven wolves tear at one sheep,"},{"id":"manas-2010:p0355:b001:l048","ordinal":16266,"en":"Will they leave its carcass whole?"},{"id":"manas-2010:p0356:b001:l001","ordinal":16267,"en":"The multitude of Chinese covering the earth—"},{"id":"manas-2010:p0356:b001:l002","ordinal":16268,"en":"If they struck, would they leave a carcass whole?"},{"id":"manas-2010:p0356:b001:l003","ordinal":16269,"en":"Some mighty fighters held"},{"id":"manas-2010:p0356:b001:l004","ordinal":16270,"en":"Iron nets for catching men."},{"id":"manas-2010:p0356:b001:l005","ordinal":16271,"en":"Earth flew, dust blazed;"},{"id":"manas-2010:p0356:b001:l006","ordinal":16272,"en":"Now misfortune was boiling over!"},{"id":"manas-2010:p0356:b001:l007","ordinal":16273,"en":"Long ago, in the prophet Noah's time,"},{"id":"manas-2010:p0356:b001:l008","ordinal":16274,"en":"When the Flood swept over this place,"},{"id":"manas-2010:p0356:b001:l009","ordinal":16275,"en":"When it spread across the earth,"},{"id":"manas-2010:p0356:b001:l010","ordinal":16276,"en":"The eighteen thousand worlds"},{"id":"manas-2010:p0356:b001:l011","ordinal":16277,"en":"It overran and overwhelmed,"},{"id":"manas-2010:p0356:b001:l012","ordinal":16278,"en":"Many sorrows dwell within the heart—"},{"id":"manas-2010:p0356:b001:l013","ordinal":16279,"en":"Beyond the Flood's reach,"},{"id":"manas-2010:p0356:b001:l014","ordinal":16280,"en":"Eight hundred households had remained."},{"id":"manas-2010:p0356:b001:l015","ordinal":16281,"en":"Later, when the holy prophet Mustafa"},{"id":"manas-2010:p0356:b001:l016","ordinal":16282,"en":"Ascended to the Heavenly Throne,"},{"id":"manas-2010:p0356:b001:l017","ordinal":16283,"en":"Upon Beijing light was poured;"},{"id":"manas-2010:p0356:b001:l018","ordinal":16284,"en":"Though they tried to shut its gate,"},{"id":"manas-2010:p0356:b001:l019","ordinal":16285,"en":"It opened toward the north."},{"id":"manas-2010:p0356:b001:l020","ordinal":16286,"en":"“They have much restraint, but no faith;"},{"id":"manas-2010:p0356:b001:l021","ordinal":16287,"en":"The eighteen thousand worlds"},{"id":"manas-2010:p0356:b001:l022","ordinal":16288,"en":"They would lay waste if they stirred”—"},{"id":"manas-2010:p0356:b001:l023","ordinal":16289,"en":"Upon this very Beijing"},{"id":"manas-2010:p0356:b001:l024","ordinal":16290,"en":"God shed the light of abundance."},{"id":"manas-2010:p0356:b001:l025","ordinal":16291,"en":"No one journeyed there,"},{"id":"manas-2010:p0356:b001:l026","ordinal":16292,"en":"No one bowed it down for questioning."},{"id":"manas-2010:p0356:b001:l027","ordinal":16293,"en":"From upon his golden throne,"},{"id":"manas-2010:p0356:b001:l028","ordinal":16294,"en":"Esenkan gave his command."},{"id":"manas-2010:p0356:b001:l029","ordinal":16295,"en":"Its gate had doors of steel."},{"id":"manas-2010:p0356:b001:l030","ordinal":16296,"en":"His sovereignty was extraordinary—"},{"id":"manas-2010:p0356:b001:l031","ordinal":16297,"en":"Such was Esenkan, if you looked."},{"id":"manas-2010:p0356:b001:l032","ordinal":16298,"en":"A deep moat had been dug;"},{"id":"manas-2010:p0356:b001:l033","ordinal":16299,"en":"The khagan's people rose,"},{"id":"manas-2010:p0356:b001:l034","ordinal":16300,"en":"Leaving none they met alive,"},{"id":"manas-2010:p0356:b001:l035","ordinal":16301,"en":"Slaying those who opposed them."},{"id":"manas-2010:p0356:b001:l036","ordinal":16302,"en":"Zholoy, khan of the unbelievers,"},{"id":"manas-2010:p0356:b001:l037","ordinal":16303,"en":"Strong of arm, a hero himself,"},{"id":"manas-2010:p0356:b001:l038","ordinal":16304,"en":"Had a head like a great cauldron,"},{"id":"manas-2010:p0356:b001:l039","ordinal":16305,"en":"Eyebrows like a dog lying down,"},{"id":"manas-2010:p0356:b001:l040","ordinal":16306,"en":"A broad, thick body, short in height,"},{"id":"manas-2010:p0356:b001:l041","ordinal":16307,"en":"Heavy as a mountain of black rock."},{"id":"manas-2010:p0356:b001:l042","ordinal":16308,"en":"Could anyone who fought him live?"},{"id":"manas-2010:p0356:b001:l043","ordinal":16309,"en":"If you see Zholoy, flee far away!"},{"id":"manas-2010:p0356:b001:l044","ordinal":16310,"en":"Broad of face and wide of shoulder,"},{"id":"manas-2010:p0356:b001:l045","ordinal":16311,"en":"His strength was extraordinary,"},{"id":"manas-2010:p0356:b001:l046","ordinal":16312,"en":"His valor was considerable."},{"id":"manas-2010:p0356:b001:l047","ordinal":16313,"en":"Given him by brave Esenkan,"},{"id":"manas-2010:p0356:b001:l048","ordinal":16314,"en":"He wrapped himself in the white padded armor."},{"id":"manas-2010:p0357:b001:l001","ordinal":16315,"en":"Great Zholoy, cursed by the spirits,"},{"id":"manas-2010:p0357:b001:l002","ordinal":16316,"en":"Sprang like a hungry tiger."},{"id":"manas-2010:p0357:b001:l003","ordinal":16317,"en":"The horse he rode was Achbuudan,"},{"id":"manas-2010:p0357:b001:l004","ordinal":16318,"en":"High-backed, with a low saddle,"},{"id":"manas-2010:p0357:b001:l005","ordinal":16319,"en":"Unwearied by six months of riding,"},{"id":"manas-2010:p0357:b001:l006","ordinal":16320,"en":"Short in forelegs, long in hind legs,"},{"id":"manas-2010:p0357:b001:l007","ordinal":16321,"en":"The mount of raging Zholoy."},{"id":"manas-2010:p0357:b001:l008","ordinal":16322,"en":"Taking seven thousand soldiers,"},{"id":"manas-2010:p0357:b001:l009","ordinal":16323,"en":"Zholoy rode in a frenzy;"},{"id":"manas-2010:p0357:b001:l010","ordinal":16324,"en":"Into the desert of Kürpüldök"},{"id":"manas-2010:p0357:b001:l011","ordinal":16325,"en":"The army's vanguard entered."},{"id":"manas-2010:p0357:b001:l012","ordinal":16326,"en":"At the spur where the mountain ended,"},{"id":"manas-2010:p0357:b001:l013","ordinal":16327,"en":"At the blunt, projecting headland,"},{"id":"manas-2010:p0357:b001:l014","ordinal":16328,"en":"Zholoy arrived in his frenzy."},{"id":"manas-2010:p0357:b001:l015","ordinal":16329,"en":"He turned Achbuudan's head now;"},{"id":"manas-2010:p0357:b001:l016","ordinal":16330,"en":"With piercing cries and hollow cheers"},{"id":"manas-2010:p0357:b001:l017","ordinal":16331,"en":"He stood and shouted now."},{"id":"manas-2010:p0357:b001:l018","ordinal":16332,"en":"He bellowed at the Manchus,"},{"id":"manas-2010:p0357:b001:l019","ordinal":16333,"en":"He summoned the champions."},{"id":"manas-2010:p0357:b001:l020","ordinal":16334,"en":"Their arm guards spreading broad,"},{"id":"manas-2010:p0357:b001:l021","ordinal":16335,"en":"All their khans came forth."},{"id":"manas-2010:p0357:b001:l022","ordinal":16336,"en":"Mountain-sized warrior Zholoy"},{"id":"manas-2010:p0357:b001:l023","ordinal":16337,"en":"Began to speak his mind."},{"id":"manas-2010:p0357:b001:l024","ordinal":16338,"en":"“Had you heard of this?"},{"id":"manas-2010:p0357:b001:l025","ordinal":16339,"en":"My khan, you stand here;"},{"id":"manas-2010:p0357:b001:l026","ordinal":16340,"en":"Ezkara, khan of the Manchus,"},{"id":"manas-2010:p0357:b001:l027","ordinal":16341,"en":"You too stand here!"},{"id":"manas-2010:p0357:b001:l028","ordinal":16342,"en":"Giant Döödür and Karazhoy,"},{"id":"manas-2010:p0357:b001:l029","ordinal":16343,"en":"You also stand here!"},{"id":"manas-2010:p0357:b001:l030","ordinal":16344,"en":"Gray rolling hills and dark ridges"},{"id":"manas-2010:p0357:b001:l031","ordinal":16345,"en":"Are no mountains to cross unscouted."},{"id":"manas-2010:p0357:b001:l032","ordinal":16346,"en":"Leopard Manas, bloodthirsty lion,"},{"id":"manas-2010:p0357:b001:l033","ordinal":16347,"en":"Is no ordinary mother's son,"},{"id":"manas-2010:p0357:b001:l034","ordinal":16348,"en":"No slave who will let us prosper!"},{"id":"manas-2010:p0357:b001:l035","ordinal":16349,"en":"Let us scout his road with care,"},{"id":"manas-2010:p0357:b001:l036","ordinal":16350,"en":"Let us measure out his land."},{"id":"manas-2010:p0357:b001:l037","ordinal":16351,"en":"Those with nets of iron rope,"},{"id":"manas-2010:p0357:b001:l038","ordinal":16352,"en":"Those all armed with daggers,"},{"id":"manas-2010:p0357:b001:l039","ordinal":16353,"en":"Footmen wielding rough-hewn clubs,"},{"id":"manas-2010:p0357:b001:l040","ordinal":16354,"en":"Giants no horse can carry,"},{"id":"manas-2010:p0357:b001:l041","ordinal":16355,"en":"Those skilled in thrusting spears,"},{"id":"manas-2010:p0357:b001:l042","ordinal":16356,"en":"Those deft at striking with battle-axes,"},{"id":"manas-2010:p0357:b001:l043","ordinal":16357,"en":"The strong who show no mercy,"},{"id":"manas-2010:p0357:b001:l044","ordinal":16358,"en":"Those ready at the word of battle,"},{"id":"manas-2010:p0357:b001:l045","ordinal":16359,"en":"Those who know the enemy's devices—"},{"id":"manas-2010:p0357:b001:l046","ordinal":16360,"en":"The seasoned men—"},{"id":"manas-2010:p0357:b001:l047","ordinal":16361,"en":"Let us drive them to the front."},{"id":"manas-2010:p0357:b001:l048","ordinal":16362,"en":"Those who draw their bows like rain,"},{"id":"manas-2010:p0358:b001:l001","ordinal":16363,"en":"Those who fire their shots like hail,"},{"id":"manas-2010:p0358:b001:l002","ordinal":16364,"en":"Every one of those skilled men,"},{"id":"manas-2010:p0358:b001:l003","ordinal":16365,"en":"Let us send along the ridges."},{"id":"manas-2010:p0358:b001:l004","ordinal":16366,"en":"That daughter-damned bloodthirsty one,"},{"id":"manas-2010:p0358:b001:l005","ordinal":16367,"en":"That deceiver who has wrecked the world,"},{"id":"manas-2010:p0358:b001:l006","ordinal":16368,"en":"Let us overwhelm him together;"},{"id":"manas-2010:p0358:b001:l007","ordinal":16369,"en":"With that grim-faced slave"},{"id":"manas-2010:p0358:b001:l008","ordinal":16370,"en":"Let us settle matters to the end!"},{"id":"manas-2010:p0358:b001:l009","ordinal":16371,"en":"These were your khan's own words:"},{"id":"manas-2010:p0358:b001:l010","ordinal":16372,"en":"That bloodthirsty son of Jakyp—"},{"id":"manas-2010:p0358:b001:l011","ordinal":16373,"en":"He ordered us to bring him bound!"},{"id":"manas-2010:p0358:b001:l012","ordinal":16374,"en":"The command our khan has given,"},{"id":"manas-2010:p0358:b001:l013","ordinal":16375,"en":"Let us hold it firmly in mind."},{"id":"manas-2010:p0358:b001:l014","ordinal":16376,"en":"Fierce battle and slaughter—"},{"id":"manas-2010:p0358:b001:l015","ordinal":16377,"en":"Do not flee, champions—"},{"id":"manas-2010:p0358:b001:l016","ordinal":16378,"en":"Let us inflict them on this Burut!"},{"id":"manas-2010:p0358:b001:l017","ordinal":16379,"en":"Jakyp and Akbaltay,"},{"id":"manas-2010:p0358:b001:l018","ordinal":16380,"en":"Let us devour them, leaving neither alive!"},{"id":"manas-2010:p0358:b001:l019","ordinal":16381,"en":"Brave but without sense,"},{"id":"manas-2010:p0358:b001:l020","ordinal":16382,"en":"Caring nothing for anything,"},{"id":"manas-2010:p0358:b001:l021","ordinal":16383,"en":"That troublesome bloodthirsty Manas,"},{"id":"manas-2010:p0358:b001:l022","ordinal":16384,"en":"Let us capture him alive,"}]
