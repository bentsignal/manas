[{"id":"semetey-1-2013:p1203:b003:l037","ordinal":167937,"en":"The valiant hero Kalcha."},{"id":"semetey-1-2013:p1203:b003:l038","ordinal":167938,"en":"A slave deft with a spear,"},{"id":"semetey-1-2013:p1203:b003:l039","ordinal":167939,"en":"Kongurbay, who has long fought,"},{"id":"semetey-1-2013:p1203:b005:l001","ordinal":167940,"en":"Is a mighty slave"},{"id":"semetey-1-2013:p1203:b005:l002","ordinal":167941,"en":"Who knows the enemy's devices."},{"id":"semetey-1-2013:p1203:b005:l003","ordinal":167942,"en":"By returning the Kalcha's horse,"},{"id":"semetey-1-2013:p1203:b005:l004","ordinal":167943,"en":"You have exhausted my every means.\""},{"id":"semetey-1-2013:p1203:b005:l005","ordinal":167944,"en":"Before Almambet, who spoke these words,"},{"id":"semetey-1-2013:p1203:b005:l006","ordinal":167945,"en":"Had closed his mouth,"},{"id":"semetey-1-2013:p1203:b005:l007","ordinal":167946,"en":"Kokotoy's thousand black camels apiece,"},{"id":"semetey-1-2013:p1203:b005:l008","ordinal":167947,"en":"The great loads of gold,"},{"id":"semetey-1-2013:p1203:b005:l009","ordinal":167948,"en":"The thick-woven piebald cloth of Andijan,"},{"id":"semetey-1-2013:p1203:b005:l010","ordinal":167949,"en":"The costly black-patterned silk of Bukhara—"},{"id":"semetey-1-2013:p1203:b005:l011","ordinal":167950,"en":"The prize staked for the joust—"},{"id":"semetey-1-2013:p1203:b005:l012","ordinal":167951,"en":"The Muslim kinsmen"},{"id":"semetey-1-2013:p1203:b005:l013","ordinal":167952,"en":"Now witnessed that spectacle."},{"id":"semetey-1-2013:p1203:b005:l014","ordinal":167953,"en":"According to their clans,"},{"id":"semetey-1-2013:p1203:b005:l015","ordinal":167954,"en":"He distributed it among the khans."},{"id":"semetey-1-2013:p1203:b005:l016","ordinal":167955,"en":"Those who won the prize"},{"id":"semetey-1-2013:p1203:b005:l017","ordinal":167956,"en":"Were content at heart,"},{"id":"semetey-1-2013:p1203:b005:l018","ordinal":167957,"en":"Swaggering in their wealth,"},{"id":"semetey-1-2013:p1203:b005:l019","ordinal":167958,"en":"And enjoyed the splendid spectacle."},{"id":"semetey-1-2013:p1203:b005:l020","ordinal":167959,"en":"They measured the jousting prize by the whip"},{"id":"semetey-1-2013:p1203:b005:l021","ordinal":167960,"en":"And divided it;"},{"id":"semetey-1-2013:p1203:b005:l022","ordinal":167961,"en":"Their strongest men grappled"},{"id":"semetey-1-2013:p1203:b005:l023","ordinal":167962,"en":"And fell to whipping one another."},{"id":"semetey-1-2013:p1203:b005:l024","ordinal":167963,"en":"They made the people weary"},{"id":"semetey-1-2013:p1203:b005:l025","ordinal":167964,"en":"Of all that wealth."},{"id":"semetey-1-2013:p1203:b005:l026","ordinal":167965,"en":"From the great loaded stores,"},{"id":"semetey-1-2013:p1203:b005:l027","ordinal":167966,"en":"They let everyone who reached them"},{"id":"semetey-1-2013:p1203:b005:l028","ordinal":167967,"en":"Plunder one kerchief apiece."},{"id":"semetey-1-2013:p1203:b005:l029","ordinal":167968,"en":"They enjoyed a mighty spectacle,"},{"id":"semetey-1-2013:p1203:b005:l030","ordinal":167969,"en":"Measured Khan Manas's prize by the whip,"},{"id":"semetey-1-2013:p1203:b005:l031","ordinal":167970,"en":"And divided it."},{"id":"semetey-1-2013:p1203:b005:l032","ordinal":167971,"en":"From the gold loaded on pack animals,"},{"id":"semetey-1-2013:p1203:b005:l033","ordinal":167972,"en":"They poured heaps"},{"id":"semetey-1-2013:p1203:b005:l034","ordinal":167973,"en":"For every kinsman."},{"id":"semetey-1-2013:p1203:b005:l035","ordinal":167974,"en":"The Muslims plundered gold"},{"id":"semetey-1-2013:p1203:b005:l036","ordinal":167975,"en":"As their prize."},{"id":"semetey-1-2013:p1203:b005:l037","ordinal":167976,"en":"Let us leave this matter here;"},{"id":"semetey-1-2013:p1203:b005:l038","ordinal":167977,"en":"Jamby shooting is another contest,"},{"id":"semetey-1-2013:p1203:b005:l039","ordinal":167978,"en":"And let us begin its tale."},{"id":"semetey-1-2013:p1204:b004:l001","ordinal":167979,"en":"A pine pole"},{"id":"semetey-1-2013:p1204:b004:l002","ordinal":167980,"en":"Was raised high."},{"id":"semetey-1-2013:p1204:b004:l003","ordinal":167981,"en":"At Kokotoy's celebration"},{"id":"semetey-1-2013:p1204:b004:l004","ordinal":167982,"en":"They began an immense game."},{"id":"semetey-1-2013:p1204:b004:l005","ordinal":167983,"en":"They spread riches all around"},{"id":"semetey-1-2013:p1204:b004:l006","ordinal":167984,"en":"And tied a precious jamby"},{"id":"semetey-1-2013:p1204:b004:l007","ordinal":167985,"en":"To the tip of that pole."},{"id":"semetey-1-2013:p1204:b004:l008","ordinal":167986,"en":"Each man had his own desire,"},{"id":"semetey-1-2013:p1204:b004:l009","ordinal":167987,"en":"Saying, \"May we shoot down the jamby.\""},{"id":"semetey-1-2013:p1204:b004:l010","ordinal":167988,"en":"Exactly sixty tanap of cord"},{"id":"semetey-1-2013:p1204:b004:l011","ordinal":167989,"en":"Were tied to that jamby."},{"id":"semetey-1-2013:p1204:b004:l012","ordinal":167990,"en":"They proclaimed it widely:"},{"id":"semetey-1-2013:p1204:b004:l013","ordinal":167991,"en":"\"Your able young marksmen,"},{"id":"semetey-1-2013:p1204:b004:l014","ordinal":167992,"en":"Shoot at the jamby,\" they said."},{"id":"semetey-1-2013:p1204:b004:l015","ordinal":167993,"en":"For shooting the jamby,"},{"id":"semetey-1-2013:p1204:b004:l016","ordinal":167994,"en":"Kongurbay, khan of the Kechils,"},{"id":"semetey-1-2013:p1204:b004:l017","ordinal":167995,"en":"With cotton sash and broad boots,"},{"id":"semetey-1-2013:p1204:b004:l018","ordinal":167996,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b004:l019","ordinal":167997,"en":"Khan Joloy of the Kalmyks"},{"id":"semetey-1-2013:p1204:b004:l020","ordinal":167998,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b004:l021","ordinal":167999,"en":"Orongu the woman champion"},{"id":"semetey-1-2013:p1204:b004:l022","ordinal":168000,"en":"Sent out a thousand champions."},{"id":"semetey-1-2013:p1204:b004:l023","ordinal":168001,"en":"Muzkindik of the Shibees"},{"id":"semetey-1-2013:p1204:b004:l024","ordinal":168002,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b004:l025","ordinal":168003,"en":"Ezkara, khan of the Manchus,"},{"id":"semetey-1-2013:p1204:b004:l026","ordinal":168004,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b004:l027","ordinal":168005,"en":"The enormous champion Orokkyr"},{"id":"semetey-1-2013:p1204:b004:l028","ordinal":168006,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b004:l029","ordinal":168007,"en":"Jamgyrchy of the Esheks"},{"id":"semetey-1-2013:p1204:b004:l030","ordinal":168008,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b004:l031","ordinal":168009,"en":"Muzburchak of Buudayyk"},{"id":"semetey-1-2013:p1204:b004:l032","ordinal":168010,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b004:l033","ordinal":168011,"en":"Hero Toshtuk of Eleman"},{"id":"semetey-1-2013:p1204:b004:l034","ordinal":168012,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b004:l035","ordinal":168013,"en":"Khan Kokcho of the Kazakhs"},{"id":"semetey-1-2013:p1204:b004:l036","ordinal":168014,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b004:l037","ordinal":168015,"en":"Kozubek of Kokon Khan"},{"id":"semetey-1-2013:p1204:b005:l001","ordinal":168016,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b005:l002","ordinal":168017,"en":"Fork-bearded Synchybek of Andijan"},{"id":"semetey-1-2013:p1204:b005:l003","ordinal":168018,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b005:l004","ordinal":168019,"en":"Alabek of the Six Cities"},{"id":"semetey-1-2013:p1204:b005:l005","ordinal":168020,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b005:l006","ordinal":168021,"en":"Akun Khan, khan of Afghanistan,"},{"id":"semetey-1-2013:p1204:b005:l007","ordinal":168022,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b005:l008","ordinal":168023,"en":"The pair Janaaly and Karach"},{"id":"semetey-1-2013:p1204:b005:l009","ordinal":168024,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b005:l010","ordinal":168025,"en":"Kokboru, son of Urum Khan,"},{"id":"semetey-1-2013:p1204:b005:l011","ordinal":168026,"en":"Sent out a thousand marksmen."},{"id":"semetey-1-2013:p1204:b005:l012","ordinal":168027,"en":"At the foot of that jamby,"},{"id":"semetey-1-2013:p1204:b005:l013","ordinal":168028,"en":"Their guns rattling,"},{"id":"semetey-1-2013:p1204:b005:l014","ordinal":168029,"en":"The marksmen came leaping forward."},{"id":"semetey-1-2013:p1204:b005:l015","ordinal":168030,"en":"For the marksmen's spectacle,"},{"id":"semetey-1-2013:p1204:b005:l016","ordinal":168031,"en":"They clenched their whips in their teeth"},{"id":"semetey-1-2013:p1204:b005:l017","ordinal":168032,"en":"And urged their horses onward."},{"id":"semetey-1-2013:p1204:b005:l018","ordinal":168033,"en":"All the marksmen"},{"id":"semetey-1-2013:p1204:b005:l019","ordinal":168034,"en":"Stretched their necks,"},{"id":"semetey-1-2013:p1204:b005:l020","ordinal":168035,"en":"Their matchcords glowing red."},{"id":"semetey-1-2013:p1204:b005:l021","ordinal":168036,"en":"He raised a flag by the jamby;"},{"id":"semetey-1-2013:p1204:b005:l022","ordinal":168037,"en":"The frantic Bokmurun"},{"id":"semetey-1-2013:p1204:b005:l023","ordinal":168038,"en":"Raised a clamor among the people."},{"id":"semetey-1-2013:p1204:b005:l024","ordinal":168039,"en":"They fired in waves of thousands,"},{"id":"semetey-1-2013:p1204:b005:l025","ordinal":168040,"en":"But lay unable to hit it."},{"id":"semetey-1-2013:p1204:b005:l026","ordinal":168041,"en":"Stray bullets flew unknowingly,"},{"id":"semetey-1-2013:p1204:b005:l027","ordinal":168042,"en":"And many died there."},{"id":"semetey-1-2013:p1204:b005:l028","ordinal":168043,"en":"Many watched"},{"id":"semetey-1-2013:p1204:b005:l029","ordinal":168044,"en":"What the Almighty had wrought."},{"id":"semetey-1-2013:p1204:b005:l030","ordinal":168045,"en":"Many tilted their bows"},{"id":"semetey-1-2013:p1204:b005:l031","ordinal":168046,"en":"And went about drawing them."},{"id":"semetey-1-2013:p1204:b005:l032","ordinal":168047,"en":"Can a person be sated with wealth?"},{"id":"semetey-1-2013:p1204:b005:l033","ordinal":168048,"en":"Many were immersed"},{"id":"semetey-1-2013:p1204:b005:l034","ordinal":168049,"en":"In a spectacle no man had seen."},{"id":"semetey-1-2013:p1204:b005:l035","ordinal":168050,"en":"Heroes who deemed themselves heroes"},{"id":"semetey-1-2013:p1204:b005:l036","ordinal":168051,"en":"Were torn from beneath their mounts,"},{"id":"semetey-1-2013:p1204:b005:l037","ordinal":168052,"en":"As black smoke billowed,"},{"id":"semetey-1-2013:p1205:b003:l001","ordinal":168053,"en":"Grain powder roasted in the guns;"},{"id":"semetey-1-2013:p1205:b003:l002","ordinal":168054,"en":"The long guns cracked,"},{"id":"semetey-1-2013:p1205:b003:l003","ordinal":168055,"en":"The short guns shrieked,"},{"id":"semetey-1-2013:p1205:b003:l004","ordinal":168056,"en":"The ochogor guns boomed,"},{"id":"semetey-1-2013:p1205:b003:l005","ordinal":168057,"en":"And the syrbarang guns thundered."},{"id":"semetey-1-2013:p1205:b003:l006","ordinal":168058,"en":"The jamby stood unmoving."},{"id":"semetey-1-2013:p1205:b003:l007","ordinal":168059,"en":"With cotton sash and broad boots,"},{"id":"semetey-1-2013:p1205:b003:l008","ordinal":168060,"en":"Kongurbay, khan of the Kechils,"},{"id":"semetey-1-2013:p1205:b003:l009","ordinal":168061,"en":"Stretched tall and fired;"},{"id":"semetey-1-2013:p1205:b003:l010","ordinal":168062,"en":"His archer drew the bow,"},{"id":"semetey-1-2013:p1205:b003:l011","ordinal":168063,"en":"But the jamby did not move."},{"id":"semetey-1-2013:p1205:b003:l012","ordinal":168064,"en":"Ezkara, khan of the Manchus,"},{"id":"semetey-1-2013:p1205:b003:l013","ordinal":168065,"en":"Advanced and fired;"},{"id":"semetey-1-2013:p1205:b003:l014","ordinal":168066,"en":"His shot vanished from sight,"},{"id":"semetey-1-2013:p1205:b003:l015","ordinal":168067,"en":"And no one knew"},{"id":"semetey-1-2013:p1205:b003:l016","ordinal":168068,"en":"Where his bullet had gone."},{"id":"semetey-1-2013:p1205:b003:l017","ordinal":168069,"en":"The Black Kalmyks lamented;"},{"id":"semetey-1-2013:p1205:b003:l018","ordinal":168070,"en":"All the rest"},{"id":"semetey-1-2013:p1205:b003:l019","ordinal":168071,"en":"Shouted in the Kakanchyn tongue"},{"id":"semetey-1-2013:p1205:b003:l020","ordinal":168072,"en":"And fired again, crying out."},{"id":"semetey-1-2013:p1205:b003:l021","ordinal":168073,"en":"The jamby did not bend"},{"id":"semetey-1-2013:p1205:b003:l022","ordinal":168074,"en":"When the infidels shot and passed."},{"id":"semetey-1-2013:p1205:b003:l023","ordinal":168075,"en":"Koshoy charged and arrived;"},{"id":"semetey-1-2013:p1205:b003:l024","ordinal":168076,"en":"Under Koshoy's command"},{"id":"semetey-1-2013:p1205:b003:l025","ordinal":168077,"en":"Were expert marksmen who could shoot an eye."},{"id":"semetey-1-2013:p1205:b003:l026","ordinal":168078,"en":"With your uncle Koshoy at their head,"},{"id":"semetey-1-2013:p1205:b003:l027","ordinal":168079,"en":"The specialists came."},{"id":"semetey-1-2013:p1205:b003:l028","ordinal":168080,"en":"Closing in with a thousand marksmen,"},{"id":"semetey-1-2013:p1205:b003:l029","ordinal":168081,"en":"Koshoy kept firing,"},{"id":"semetey-1-2013:p1205:b003:l030","ordinal":168082,"en":"But the jamby did not stir or twitch,"},{"id":"semetey-1-2013:p1205:b003:l031","ordinal":168083,"en":"Nor shift or quiver."},{"id":"semetey-1-2013:p1205:b003:l032","ordinal":168084,"en":"They fired turn by turn"},{"id":"semetey-1-2013:p1205:b003:l033","ordinal":168085,"en":"And lay taking turns."},{"id":"semetey-1-2013:p1205:b003:l034","ordinal":168086,"en":"All the marksmen side by side"},{"id":"semetey-1-2013:p1205:b003:l035","ordinal":168087,"en":"Saw such a spectacle."},{"id":"semetey-1-2013:p1205:b003:l036","ordinal":168088,"en":"All their bullets whistled,"},{"id":"semetey-1-2013:p1205:b003:l037","ordinal":168089,"en":"Flashed like stars,"},{"id":"semetey-1-2013:p1205:b003:l038","ordinal":168090,"en":"And from the ochogor's mouth"},{"id":"semetey-1-2013:p1205:b003:l039","ordinal":168091,"en":"Smoke billowed like a chimney."},{"id":"semetey-1-2013:p1205:b004:l001","ordinal":168092,"en":"The marksmen craned forward,"},{"id":"semetey-1-2013:p1205:b004:l002","ordinal":168093,"en":"The bowmen stood on tiptoe."},{"id":"semetey-1-2013:p1205:b004:l003","ordinal":168094,"en":"Toshtuk entered and fired,"},{"id":"semetey-1-2013:p1205:b004:l004","ordinal":168095,"en":"But the jamby did not bend."},{"id":"semetey-1-2013:p1205:b004:l005","ordinal":168096,"en":"They raced and shot;"},{"id":"semetey-1-2013:p1205:b004:l006","ordinal":168097,"en":"Infidel and Muslim"},{"id":"semetey-1-2013:p1205:b004:l007","ordinal":168098,"en":"Fired in alternation,"},{"id":"semetey-1-2013:p1205:b004:l008","ordinal":168099,"en":"Struggling over"},{"id":"semetey-1-2013:p1205:b004:l009","ordinal":168100,"en":"Kokotoy's jamby."},{"id":"semetey-1-2013:p1205:b004:l010","ordinal":168101,"en":"Infidel and Muslim"},{"id":"semetey-1-2013:p1205:b004:l011","ordinal":168102,"en":"Brought strength to their khans;"},{"id":"semetey-1-2013:p1205:b004:l012","ordinal":168103,"en":"It became a deed never forgotten"},{"id":"semetey-1-2013:p1205:b004:l013","ordinal":168104,"en":"Until the end of the age."},{"id":"semetey-1-2013:p1205:b004:l014","ordinal":168105,"en":"Powder shook from their breastplates."},{"id":"semetey-1-2013:p1205:b004:l015","ordinal":168106,"en":"\"This is an ill-starred game,\" they said,"},{"id":"semetey-1-2013:p1205:b004:l016","ordinal":168107,"en":"And the khans despaired of life."},{"id":"semetey-1-2013:p1205:b004:l017","ordinal":168108,"en":"When the people had lost hope,"},{"id":"semetey-1-2013:p1205:b004:l018","ordinal":168109,"en":"Saintly hero Bakay,"},{"id":"semetey-1-2013:p1205:b004:l019","ordinal":168110,"en":"Follower of Khan Manas—"},{"id":"semetey-1-2013:p1205:b004:l020","ordinal":168111,"en":"His sacred power was immense;"},{"id":"semetey-1-2013:p1205:b004:l021","ordinal":168112,"en":"Surely dear Bakay was no common man."},{"id":"semetey-1-2013:p1205:b004:l022","ordinal":168113,"en":"He whipped his blue tulpar,"},{"id":"semetey-1-2013:p1205:b004:l023","ordinal":168114,"en":"Rode up and fired once,"},{"id":"semetey-1-2013:p1205:b004:l024","ordinal":168115,"en":"And cut through one tanap of cord."},{"id":"semetey-1-2013:p1205:b004:l025","ordinal":168116,"en":"Making Kartkurong prance,"},{"id":"semetey-1-2013:p1205:b004:l026","ordinal":168117,"en":"Agybay of Argyn Khan"},{"id":"semetey-1-2013:p1205:b004:l027","ordinal":168118,"en":"Rode up and fired once,"},{"id":"semetey-1-2013:p1205:b004:l028","ordinal":168119,"en":"And cut through one tanap of cord."},{"id":"semetey-1-2013:p1205:b004:l029","ordinal":168120,"en":"He who turned from the black faith to the true,"},{"id":"semetey-1-2013:p1205:b004:l030","ordinal":168121,"en":"Who fled the infidels and became an exile,"},{"id":"semetey-1-2013:p1205:b004:l031","ordinal":168122,"en":"Almambet rode up and fired once,"},{"id":"semetey-1-2013:p1205:b004:l032","ordinal":168123,"en":"And cut through one tanap of cord."},{"id":"semetey-1-2013:p1205:b004:l033","ordinal":168124,"en":"Wearing a blue rapys coat,"},{"id":"semetey-1-2013:p1205:b004:l034","ordinal":168125,"en":"Mounted on a mottled blue horse,"},{"id":"semetey-1-2013:p1205:b004:l035","ordinal":168126,"en":"Whom no wrestler could overpower"},{"id":"semetey-1-2013:p1205:b004:l036","ordinal":168127,"en":"And no lion's tooth could pierce,"},{"id":"semetey-1-2013:p1205:b004:l037","ordinal":168128,"en":"Chubak rode up and fired once,"},{"id":"semetey-1-2013:p1205:b004:l038","ordinal":168129,"en":"And cut through one tanap of cord."},{"id":"semetey-1-2013:p1206:b003:l001","ordinal":168130,"en":"The finest of sixty,"},{"id":"semetey-1-2013:p1206:b003:l002","ordinal":168131,"en":"Best of the forty companions,"},{"id":"semetey-1-2013:p1206:b003:l003","ordinal":168132,"en":"Blade of black steel,"},{"id":"semetey-1-2013:p1206:b003:l004","ordinal":168133,"en":"Syrgak of Khan Manas,"},{"id":"semetey-1-2013:p1206:b003:l005","ordinal":168134,"en":"Rode up and fired once too,"},{"id":"semetey-1-2013:p1206:b003:l006","ordinal":168135,"en":"And cut through one tanap of cord."},{"id":"semetey-1-2013:p1206:b003:l007","ordinal":168136,"en":"Yrchyuul, son of Yraman,"},{"id":"semetey-1-2013:p1206:b003:l008","ordinal":168137,"en":"With forty tassels at his waistband,"},{"id":"semetey-1-2013:p1206:b003:l009","ordinal":168138,"en":"Rode up and fired once too,"},{"id":"semetey-1-2013:p1206:b003:l010","ordinal":168139,"en":"And cut through one tanap of cord."},{"id":"semetey-1-2013:p1206:b003:l011","ordinal":168140,"en":"Hero Shuutu in his tent-shaped kalpak"},{"id":"semetey-1-2013:p1206:b003:l012","ordinal":168141,"en":"Came and fired once too,"},{"id":"semetey-1-2013:p1206:b003:l013","ordinal":168142,"en":"And cut through one tanap of cord."},{"id":"semetey-1-2013:p1206:b003:l014","ordinal":168143,"en":"Kuldur and Chalybay"},{"id":"semetey-1-2013:p1206:b003:l015","ordinal":168144,"en":"Arrived abreast and fired once,"},{"id":"semetey-1-2013:p1206:b003:l016","ordinal":168145,"en":"Cutting through one tanap of cord."},{"id":"semetey-1-2013:p1206:b003:l017","ordinal":168146,"en":"Kyrgylchal, head of the forty,"},{"id":"semetey-1-2013:p1206:b003:l018","ordinal":168147,"en":"Came and fired once too,"},{"id":"semetey-1-2013:p1206:b003:l019","ordinal":168148,"en":"And cut through one tanap of cord."},{"id":"semetey-1-2013:p1206:b003:l020","ordinal":168149,"en":"The red-chested hero,"},{"id":"semetey-1-2013:p1206:b003:l021","ordinal":168150,"en":"The valiant man who shook the age,"},{"id":"semetey-1-2013:p1206:b003:l022","ordinal":168151,"en":"Bozuul came and fired once,"},{"id":"semetey-1-2013:p1206:b003:l023","ordinal":168152,"en":"And cut through one tanap of cord."},{"id":"semetey-1-2013:p1206:b003:l024","ordinal":168153,"en":"Like a stack of white wheat,"},{"id":"semetey-1-2013:p1206:b003:l025","ordinal":168154,"en":"He too was Manas's companion:"},{"id":"semetey-1-2013:p1206:b003:l026","ordinal":168155,"en":"Merry Tazbaymat"},{"id":"semetey-1-2013:p1206:b003:l027","ordinal":168156,"en":"Arrived and fired once too,"},{"id":"semetey-1-2013:p1206:b003:l028","ordinal":168157,"en":"Cutting through one tanap of cord."},{"id":"semetey-1-2013:p1206:b003:l029","ordinal":168158,"en":"His jester Majik"},{"id":"semetey-1-2013:p1206:b003:l030","ordinal":168159,"en":"Arrived and fired once too,"},{"id":"semetey-1-2013:p1206:b003:l031","ordinal":168160,"en":"And cut through one tanap of cord."},{"id":"semetey-1-2013:p1206:b003:l032","ordinal":168161,"en":"Black Tologu the diviner,"},{"id":"semetey-1-2013:p1206:b003:l033","ordinal":168162,"en":"Whose divination surpassed the people's,"},{"id":"semetey-1-2013:p1206:b003:l034","ordinal":168163,"en":"Rode up and fired once too,"},{"id":"semetey-1-2013:p1206:b003:l035","ordinal":168164,"en":"And cut through one tanap of cord."},{"id":"semetey-1-2013:p1206:b003:l036","ordinal":168165,"en":"Carefree Serek,"},{"id":"semetey-1-2013:p1206:b003:l037","ordinal":168166,"en":"Useful to Khan Manas,"},{"id":"semetey-1-2013:p1206:b003:l038","ordinal":168167,"en":"Arrived and fired once too,"},{"id":"semetey-1-2013:p1206:b004:l001","ordinal":168168,"en":"And cut through one tanap of cord."},{"id":"semetey-1-2013:p1206:b004:l002","ordinal":168169,"en":"Manas had many companions;"},{"id":"semetey-1-2013:p1206:b004:l003","ordinal":168170,"en":"Strongest of them all was Agayar."},{"id":"semetey-1-2013:p1206:b004:l004","ordinal":168171,"en":"When he grew angry,"},{"id":"semetey-1-2013:p1206:b004:l005","ordinal":168172,"en":"He began a great tumult;"},{"id":"semetey-1-2013:p1206:b004:l006","ordinal":168173,"en":"When his true wrath came,"},{"id":"semetey-1-2013:p1206:b004:l007","ordinal":168174,"en":"He