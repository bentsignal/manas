[{"id":"manas-2010:p1282:b001:l009","ordinal":55553,"en":"Despaired of his life."},{"id":"manas-2010:p1282:b001:l010","ordinal":55554,"en":"“When will he reach me?” he thought."},{"id":"manas-2010:p1282:b001:l011","ordinal":55555,"en":"“From the vast Chinese army,"},{"id":"manas-2010:p1282:b001:l012","ordinal":55556,"en":"When will he break me free?” he thought."},{"id":"manas-2010:p1282:b001:l013","ordinal":55557,"en":"He watched with desperate longing."},{"id":"manas-2010:p1282:b001:l014","ordinal":55558,"en":"“When will he bring slaughter?” he thought."},{"id":"manas-2010:p1282:b001:l015","ordinal":55559,"en":"“At this time when I am hard pressed,"},{"id":"manas-2010:p1282:b001:l016","ordinal":55560,"en":"When will warrior Chubak arrive"},{"id":"manas-2010:p1282:b001:l017","ordinal":55561,"en":"And break me free?” he thought."},{"id":"manas-2010:p1282:b001:l018","ordinal":55562,"en":"As for your Chubak, leaving Manas aside,"},{"id":"manas-2010:p1282:b001:l019","ordinal":55563,"en":"He could find no way to save himself."},{"id":"manas-2010:p1282:b001:l020","ordinal":55564,"en":"Orokkyr and Börüköz,"},{"id":"manas-2010:p1282:b001:l021","ordinal":55565,"en":"The two had waged battle against him."},{"id":"manas-2010:p1282:b001:l022","ordinal":55566,"en":"Steeped in crimson blood,"},{"id":"manas-2010:p1282:b001:l023","ordinal":55567,"en":"He could not turn to look."},{"id":"manas-2010:p1282:b001:l024","ordinal":55568,"en":"Seeing this, your Manas"},{"id":"manas-2010:p1282:b001:l025","ordinal":55569,"en":"At Akbaltay's Chubak"},{"id":"manas-2010:p1282:b001:l026","ordinal":55570,"en":"Took deep offense."},{"id":"manas-2010:p1282:b001:l027","ordinal":55571,"en":"Bringing slaughter to the Chinese,"},{"id":"manas-2010:p1282:b001:l028","ordinal":55572,"en":"Almambet, born a champion,"},{"id":"manas-2010:p1282:b001:l029","ordinal":55573,"en":"Was proving his worth."},{"id":"manas-2010:p1282:b001:l030","ordinal":55574,"en":"“That daughter-fucking gray mule,"},{"id":"manas-2010:p1282:b001:l031","ordinal":55575,"en":"When will it cease to move?” he thought."},{"id":"manas-2010:p1282:b001:l032","ordinal":55576,"en":"Glancing back like a white falcon,"},{"id":"manas-2010:p1282:b001:l033","ordinal":55577,"en":"From time to time, far off,"},{"id":"manas-2010:p1282:b001:l034","ordinal":55578,"en":"Casting his eyes from afar,"},{"id":"manas-2010:p1282:b001:l035","ordinal":55579,"en":"Was he not keeping watch!"},{"id":"manas-2010:p1282:b001:l036","ordinal":55580,"en":"When Almambet looked closely,"},{"id":"manas-2010:p1282:b001:l037","ordinal":55581,"en":"With the Kalcha Kongurbay at their head,"},{"id":"manas-2010:p1282:b001:l038","ordinal":55582,"en":"Manas, born a leopard,"},{"id":"manas-2010:p1282:b001:l039","ordinal":55583,"en":"They had encircled twelve deep."},{"id":"manas-2010:p1282:b001:l040","ordinal":55584,"en":"Isolating Manas,"},{"id":"manas-2010:p1282:b001:l041","ordinal":55585,"en":"To capture him alive,"},{"id":"manas-2010:p1282:b001:l042","ordinal":55586,"en":"They had brought him torment."},{"id":"manas-2010:p1283:b001:l001","ordinal":55587,"en":"When your Almam saw this,"},{"id":"manas-2010:p1283:b001:l002","ordinal":55588,"en":"Your Almam could not bear to stand still."},{"id":"manas-2010:p1283:b001:l003","ordinal":55589,"en":"“To Manas in distress"},{"id":"manas-2010:p1283:b001:l004","ordinal":55590,"en":"Let me reach him without looking back!"},{"id":"manas-2010:p1283:b001:l005","ordinal":55591,"en":"Slaughtering the Chinese,"},{"id":"manas-2010:p1283:b001:l006","ordinal":55592,"en":"Manas, my friend unto Judgment Day,"},{"id":"manas-2010:p1283:b001:l007","ordinal":55593,"en":"Let me tear him free!”"},{"id":"manas-2010:p1283:b001:l008","ordinal":55594,"en":"Leaving the great armies, Almambet,"},{"id":"manas-2010:p1283:b001:l009","ordinal":55595,"en":"On stake-necked Sarala,"},{"id":"manas-2010:p1283:b001:l010","ordinal":55596,"en":"Spurred away at flying speed."},{"id":"manas-2010:p1283:b001:l011","ordinal":55597,"en":"Entering among the Chinese,"},{"id":"manas-2010:p1283:b001:l012","ordinal":55598,"en":"The Fierce One in their midst,"},{"id":"manas-2010:p1283:b001:l013","ordinal":55599,"en":"From the flank, without mercy,"},{"id":"manas-2010:p1283:b001:l014","ordinal":55600,"en":"He struck once with his lance."},{"id":"manas-2010:p1283:b001:l015","ordinal":55601,"en":"When Almambet thrust his lance,"},{"id":"manas-2010:p1283:b001:l016","ordinal":55602,"en":"Kongurbay lost his strength;"},{"id":"manas-2010:p1283:b001:l017","ordinal":55603,"en":"Clinging to Algara's neck,"},{"id":"manas-2010:p1283:b001:l018","ordinal":55604,"en":"Kongurbay writhed."},{"id":"manas-2010:p1283:b001:l019","ordinal":55605,"en":"Beating his own head,"},{"id":"manas-2010:p1283:b001:l020","ordinal":55606,"en":"Cursing your Almam bitterly,"},{"id":"manas-2010:p1283:b001:l021","ordinal":55607,"en":"Kongurbay went away weeping."},{"id":"manas-2010:p1283:b001:l022","ordinal":55608,"en":"“Godless, cunning fugitive!"},{"id":"manas-2010:p1283:b001:l023","ordinal":55609,"en":"He had his waist-cord twisted from hair,"},{"id":"manas-2010:p1283:b001:l024","ordinal":55610,"en":"And went to the Buruts to have his intact part pierced!"},{"id":"manas-2010:p1283:b001:l025","ordinal":55611,"en":"Had this fugitive not been here,"},{"id":"manas-2010:p1283:b001:l026","ordinal":55612,"en":"At Great Beijing's gate"},{"id":"manas-2010:p1283:b001:l027","ordinal":55613,"en":"Would I not have drawn the line?"},{"id":"manas-2010:p1283:b001:l028","ordinal":55614,"en":"Having bound Manas,"},{"id":"manas-2010:p1283:b001:l029","ordinal":55615,"en":"Would I not have made a spectacle?"},{"id":"manas-2010:p1283:b001:l030","ordinal":55616,"en":"All the Burut Muslims—"},{"id":"manas-2010:p1283:b001:l031","ordinal":55617,"en":"Would I not have brought them torment?"},{"id":"manas-2010:p1283:b001:l032","ordinal":55618,"en":"Would I not have burned their tents?"},{"id":"manas-2010:p1283:b001:l033","ordinal":55619,"en":"Would I not have killed their warriors?"},{"id":"manas-2010:p1283:b001:l034","ordinal":55620,"en":"May your dark eyes go blind!"},{"id":"manas-2010:p1283:b001:l035","ordinal":55621,"en":"From where did he see this?"},{"id":"manas-2010:p1283:b001:l036","ordinal":55622,"en":"A hare that has fallen into one's hands—"},{"id":"manas-2010:p1283:b001:l037","ordinal":55623,"en":"Can the man who frees it prosper?”"},{"id":"manas-2010:p1283:b001:l038","ordinal":55624,"en":"Saying this, Kongurbay"},{"id":"manas-2010:p1283:b001:l039","ordinal":55625,"en":"Stood there chattering."},{"id":"manas-2010:p1283:b001:l040","ordinal":55626,"en":"As Almambet reached him again,"},{"id":"manas-2010:p1283:b001:l041","ordinal":55627,"en":"The complaining Fierce One,"},{"id":"manas-2010:p1283:b001:l042","ordinal":55628,"en":"While he stood bewildered,"},{"id":"manas-2010:p1284:b001:l001","ordinal":55629,"en":"As he was about to knock him down,"},{"id":"manas-2010:p1284:b001:l002","ordinal":55630,"en":"Bending his neck like a wild sheep,"},{"id":"manas-2010:p1284:b001:l003","ordinal":55631,"en":"Your Fierce One, whose horse was swift,"},{"id":"manas-2010:p1284:b001:l004","ordinal":55632,"en":"Sped out in a rush."},{"id":"manas-2010:p1284:b001:l005","ordinal":55633,"en":"After Kongurbay had escaped,"},{"id":"manas-2010:p1284:b001:l006","ordinal":55634,"en":"When your Almam saw the others,"},{"id":"manas-2010:p1284:b001:l007","ordinal":55635,"en":"Felling everyone he encountered,"},{"id":"manas-2010:p1284:b001:l008","ordinal":55636,"en":"Almambet killed his way through."},{"id":"manas-2010:p1284:b001:l009","ordinal":55637,"en":"The massed Chinese and Manzhuu,"},{"id":"manas-2010:p1284:b001:l010","ordinal":55638,"en":"Away from Khan Manas,"},{"id":"manas-2010:p1284:b001:l011","ordinal":55639,"en":"Pushing them back a great distance,"},{"id":"manas-2010:p1284:b001:l012","ordinal":55640,"en":"Almambet drove them out."},{"id":"manas-2010:p1284:b001:l013","ordinal":55641,"en":"At that moment Almambet"},{"id":"manas-2010:p1284:b001:l014","ordinal":55642,"en":"Came up to Manas."},{"id":"manas-2010:p1284:b001:l015","ordinal":55643,"en":"“Oh, warrior, you mean to dig my pit!"},{"id":"manas-2010:p1284:b001:l016","ordinal":55644,"en":"Never heeding words,"},{"id":"manas-2010:p1284:b001:l017","ordinal":55645,"en":"You mean to make my misery boil!"},{"id":"manas-2010:p1284:b001:l018","ordinal":55646,"en":"Did I not tell you before?"},{"id":"manas-2010:p1284:b001:l019","ordinal":55647,"en":"Did you not hear it too?"},{"id":"manas-2010:p1284:b001:l020","ordinal":55648,"en":"That is the support they rely upon;"},{"id":"manas-2010:p1284:b001:l021","ordinal":55649,"en":"These Chinese outnumber other mortals;"},{"id":"manas-2010:p1284:b001:l022","ordinal":55650,"en":"They are a flood that will engulf us."},{"id":"manas-2010:p1284:b001:l023","ordinal":55651,"en":"When told beforehand, refusing to listen,"},{"id":"manas-2010:p1284:b001:l024","ordinal":55652,"en":"You are the one who has brought this trouble."},{"id":"manas-2010:p1284:b001:l025","ordinal":55653,"en":"God knows whether from this place"},{"id":"manas-2010:p1284:b001:l026","ordinal":55654,"en":"We shall turn back alive,"},{"id":"manas-2010:p1284:b001:l027","ordinal":55655,"en":"Whether from this Beijing before us"},{"id":"manas-2010:p1284:b001:l028","ordinal":55656,"en":"We shall return unharmed."},{"id":"manas-2010:p1284:b001:l029","ordinal":55657,"en":"Could you not take care,"},{"id":"manas-2010:p1284:b001:l030","ordinal":55658,"en":"Precious Manas, my bold champion?"},{"id":"manas-2010:p1284:b001:l031","ordinal":55659,"en":"This Great Beijing before us—"},{"id":"manas-2010:p1284:b001:l032","ordinal":55660,"en":"This is a place of lofty heights."},{"id":"manas-2010:p1284:b001:l033","ordinal":55661,"en":"When its anger is aroused,"},{"id":"manas-2010:p1284:b001:l034","ordinal":55662,"en":"Not just a small people like us,"},{"id":"manas-2010:p1284:b001:l035","ordinal":55663,"en":"But the whole wide world"},{"id":"manas-2010:p1284:b001:l036","ordinal":55664,"en":"These people could plunge into torment."},{"id":"manas-2010:p1284:b001:l037","ordinal":55665,"en":"Contending with that dog for khanly rule,"},{"id":"manas-2010:p1284:b001:l038","ordinal":55666,"en":"Called Almambet the fugitive,"},{"id":"manas-2010:p1284:b001:l039","ordinal":55667,"en":"I am the one who came to you."},{"id":"manas-2010:p1284:b001:l040","ordinal":55668,"en":"Not being wary of Beijing,"},{"id":"manas-2010:p1284:b001:l041","ordinal":55669,"en":"You are the one who treated it as a game."},{"id":"manas-2010:p1284:b001:l042","ordinal":55670,"en":"When I thought it over and advised you at first,"},{"id":"manas-2010:p1285:b001:l001","ordinal":55671,"en":"Refusing to listen this time,"},{"id":"manas-2010:p1285:b001:l002","ordinal":55672,"en":"You are the one who brought us torment."},{"id":"manas-2010:p1285:b001:l003","ordinal":55673,"en":"My fierce-maned one, you did not heed my words;"},{"id":"manas-2010:p1285:b001:l004","ordinal":55674,"en":"I am the one left in the fire!"},{"id":"manas-2010:p1285:b001:l005","ordinal":55675,"en":"This time, when the many Chinese"},{"id":"manas-2010:p1285:b001:l006","ordinal":55676,"en":"Surrounded us,"},{"id":"manas-2010:p1285:b001:l007","ordinal":55677,"en":"Had your horse not stopped going,"},{"id":"manas-2010:p1285:b001:l008","ordinal":55678,"en":"Would I not have raided again"},{"id":"manas-2010:p1285:b001:l009","ordinal":55679,"en":"The Chinese emperor's city?"},{"id":"manas-2010:p1285:b001:l010","ordinal":55680,"en":"Would I not have brought down"},{"id":"manas-2010:p1285:b001:l011","ordinal":55681,"en":"Disaster upon the countless Chinese?"},{"id":"manas-2010:p1285:b001:l012","ordinal":55682,"en":"Upon Beijing, where no prophet goes,"},{"id":"manas-2010:p1285:b001:l013","ordinal":55683,"en":"As I was about to bring calamity,"},{"id":"manas-2010:p1285:b001:l014","ordinal":55684,"en":"The Chinese people of forty khans,"},{"id":"manas-2010:p1285:b001:l015","ordinal":55685,"en":"When my time to slaughter them had come,"},{"id":"manas-2010:p1285:b001:l016","ordinal":55686,"en":"You bound both my hands;"},{"id":"manas-2010:p1285:b001:l017","ordinal":55687,"en":"My friend, you did not clear my way!”"},{"id":"manas-2010:p1285:b001:l018","ordinal":55688,"en":"Almambet spoke in this fashion;"},{"id":"manas-2010:p1285:b001:l019","ordinal":55689,"en":"Before he could close his mouth,"},{"id":"manas-2010:p1285:b001:l020","ordinal":55690,"en":"The brim of the black felt hat—"},{"id":"manas-2010:p1285:b001:l021","ordinal":55691,"en":"From where he came, I do not know—"},{"id":"manas-2010:p1285:b001:l022","ordinal":55692,"en":"The leopard lord's Syrgak appeared."},{"id":"manas-2010:p1285:b001:l023","ordinal":55693,"en":"Behind dear Syrgak,"},{"id":"manas-2010:p1285:b001:l024","ordinal":55694,"en":"Stained with crimson blood,"},{"id":"manas-2010:p1285:b001:l025","ordinal":55695,"en":"Spurring on Kögala,"},{"id":"manas-2010:p1285:b001:l026","ordinal":55696,"en":"Chubak arrived then."},{"id":"manas-2010:p1285:b001:l027","ordinal":55697,"en":"With a red pennon on his lance,"},{"id":"manas-2010:p1285:b001:l028","ordinal":55698,"en":"He became a fortress for Manas,"},{"id":"manas-2010:p1285:b001:l029","ordinal":55699,"en":"Hero Almambet, his champion."},{"id":"manas-2010:p1285:b001:l030","ordinal":55700,"en":"When they saw Khan Manas,"},{"id":"manas-2010:p1285:b001:l031","ordinal":55701,"en":"When the Chinese charged with a shout,"},{"id":"manas-2010:p1285:b001:l032","ordinal":55702,"en":"When your Almam understood the danger,"},{"id":"manas-2010:p1285:b001:l033","ordinal":55703,"en":"The lead-rope knotted short"},{"id":"manas-2010:p1285:b001:l034","ordinal":55704,"en":"He snatched from Manas."},{"id":"manas-2010:p1285:b001:l035","ordinal":55705,"en":"Against the stirrup-leather"},{"id":"manas-2010:p1285:b001:l036","ordinal":55706,"en":"He pinned it firmly."},{"id":"manas-2010:p1285:b001:l037","ordinal":55707,"en":"He opened his mouth like a ravening maw;"},{"id":"manas-2010:p1285:b001:l038","ordinal":55708,"en":"Dragging him toward Tal-Choku,"},{"id":"manas-2010:p1285:b001:l039","ordinal":55709,"en":"Making Manas jolt along,"},{"id":"manas-2010:p1285:b001:l040","ordinal":55710,"en":"Almambet carried him away."},{"id":"manas-2010:p1285:b001:l041","ordinal":55711,"en":"At Manas's right side,"},{"id":"manas-2010:p1285:b001:l042","ordinal":55712,"en":"Syrgak rode alongside."},{"id":"manas-2010:p1286:b001:l001","ordinal":55713,"en":"From behind, hero Chubak,"},{"id":"manas-2010:p1286:b001:l002","ordinal":55714,"en":"The Chinese who swept up to them,"},{"id":"manas-2010:p1286:b001:l003","ordinal":55715,"en":"Repeatedly drove them back."},{"id":"manas-2010:p1286:b001:l004","ordinal":55716,"en":"Manas, Syrgak and Almambet"},{"id":"manas-2010:p1286:b001:l005","ordinal":55717,"en":"Went ahead of him."},{"id":"manas-2010:p1286:b001:l006","ordinal":55718,"en":"Though Aybanboz could no longer go,"},{"id":"manas-2010:p1286:b001:l007","ordinal":55719,"en":"When the Chinese pressed upon them,"},{"id":"manas-2010:p1286:b001:l008","ordinal":55720,"en":"Fire flared from both his eyes;"},{"id":"manas-2010:p1286:b001:l009","ordinal":55721,"en":"Manas would not yield, but blustered,"},{"id":"manas-2010:p1286:b001:l010","ordinal":55722,"en":"Pulling back on his reins,"},{"id":"manas-2010:p1286:b001:l011","ordinal":55723,"en":"“I shall fight!” he shouted."},{"id":"manas-2010:p1286:b001:l012","ordinal":55724,"en":"Seeing the infidels' appearance,"},{"id":"manas-2010:p1286:b001:l013","ordinal":55725,"en":"Almambet was hard pressed"},{"id":"manas-2010:p1286:b001:l014","ordinal":55726,"en":"By headstrong Manas."},{"id":"manas-2010:p1286:b001:l015","ordinal":55727,"en":"Taking turns in battle,"},{"id":"manas-2010:p1286:b001:l016","ordinal":55728,"en":"Hero Chubak, son of Akbaltay,"},{"id":"manas-2010:p1286:b001:l017","ordinal":55729,"en":"And joining him again,"},{"id":"manas-2010:p1286:b001:l018","ordinal":55730,"en":"Fought without stopping,"},{"id":"manas-2010:p1286:b001:l019","ordinal":55731,"en":"Hero Syrgak, son of Ulak Khan."},{"id":"manas-2010:p1286:b001:l020","ordinal":55732,"en":"When the Chinese pressed harder,"},{"id":"manas-2010:p1286:b001:l021","ordinal":55733,"en":"The face of the earth turned to dust."},{"id":"manas-2010:p1286:b001:l022","ordinal":55734,"en":"Fighting again and again,"},{"id":"manas-2010:p1286:b001:l023","ordinal":55735,"en":"Leopard Syrgak and hero Chubak"},{"id":"manas-2010:p1286:b001:l024","ordinal":55736,"en":"Became mottled red with blood;"},{"id":"manas-2010:p1286:b001:l025","ordinal":55737,"en":"Their whole bodies were exhausted."},{"id":"manas-2010:p1286:b001:l026","ordinal":55738,"en":"How could the heroes spare themselves?"},{"id":"manas-2010:p1286:b001:l027","ordinal":55739,"en":"Fighting many times,"},{"id":"manas-2010:p1286:b001:l028","ordinal":55740,"en":"Just as they cried, “I am dying, I am dying,”"},{"id":"manas-2010:p1286:b001:l029","ordinal":55741,"en":"They reached Tal-Choku."},{"id":"manas-2010:p1286:b001:l030","ordinal":55742,"en":"As they were approaching Tal-Choku,"},{"id":"manas-2010:p1286:b001:l031","ordinal":55743,"en":"The saddle-shaped ridge—"},{"id":"manas-2010:p1286:b001:l032","ordinal":55744,"en":"Aybanboz would not cross it."},{"id":"manas-2010:p1286:b001:l033","ordinal":55745,"en":"Manas lost his wits;"},{"id":"manas-2010:p1286:b001:l034","ordinal":55746,"en":"Even dragging was no use."},{"id":"manas-2010:p1286:b001:l035","ordinal":55747,"en":"Bathed in dark sweat,"},{"id":"manas-2010:p1286:b001:l036","ordinal":55748,"en":"Aybanboz would not move."},{"id":"manas-2010:p1286:b001:l037","ordinal":55749,"en":"When Aybanboz stopped moving,"},{"id":"manas-2010:p1286:b001:l038","ordinal":55750,"en":"The Chinese rushed upon them."},{"id":"manas-2010:p1286:b001:l039","ordinal":55751,"en":"Seeing this, hero Manas"},{"id":"manas-2010:p1286:b001:l040","ordinal":55752,"en":"Despaired of his precious life."},{"id":"manas-2010:p1286:b001:l041","ordinal":55753,"en":"Always refusing to heed advice,"},{"id":"manas-2010:p1286:b001:l042","ordinal":55754,"en":"Hero Manas now suffered torment."},{"id":"manas-2010:p1287:b001:l001","ordinal":55755,"en":"The white saddle and the bridle,"},{"id":"manas-2010:p1287:b001:l002","ordinal":55756,"en":"The leopard lord tied them firmly"},{"id":"manas-2010:p1287:b001:l003","ordinal":55757,"en":"And hoisted them onto his back."},{"id":"manas-2010:p1287:b001:l004","ordinal":55758,"en":"Trudging heavily uphill,"},{"id":"manas-2010:p1287:b001:l005","ordinal":55759,"en":"Leaning on the gray short musket,"},{"id":"manas-2010:p1287:b001:l006","ordinal":55760,"en":"Despairing of his fleeting life,"},{"id":"manas-2010:p1287:b001:l007","ordinal":55761,"en":"His life was truly hard pressed."},{"id":"manas-2010:p1287:b001:l008","ordinal":55762,"en":"He walked toward Tal-Choku;"},{"id":"manas-2010:p1287:b001:l009","ordinal":55763,"en":"Walking on and looking back,"},{"id":"manas-2010:p1287:b001:l010","ordinal":55764,"en":"To Almambet and Chubak,"},{"id":"manas-2010:p1287:b001:l011","ordinal":55765,"en":"To Syrgak, son of Ulak Khan,"},{"id":"manas-2010:p1287:b001:l012","ordinal":55766,"en":"Manas spoke his last wishes."},{"id":"manas-2010:p1287:b001:l013","ordinal":55767,"en":"“Almambet, Chubak, my Syrgak,"},{"id":"manas-2010:p1287:b001:l014","ordinal":55768,"en":"My champions who shatter the world!"},{"id":"manas-2010:p1287:b001:l015","ordinal":55769,"en":"My plane trees among the people,"},{"id":"manas-2010:p1287:b001:l016","ordinal":55770,"en":"Always before the enemy,"},{"id":"manas-2010:p1287:b001:l017","ordinal":55771,"en":"My dark-marked hunting hawks!"},{"id":"manas-2010:p1287:b001:l018","ordinal":55772,"en":"What is seen today is gone tomorrow."},{"id":"manas-2010:p1287:b001:l019","ordinal":55773,"en":"Distracting us, that trickster—"},{"id":"manas-2010:p1287:b001:l020","ordinal":55774,"en":"The mischievous world deceives us!"},{"id":"manas-2010:p1287:b001:l021","ordinal":55775,"en":"The multitude of Chinese massing,"},{"id":"manas-2010:p1287:b001:l022","ordinal":55776,"en":"All gathering together,"},{"id":"manas-2010:p1287:b001:l023","ordinal":55777,"en":"Your Manas alive—"},{"id":"manas-2010:p1287:b001:l024","ordinal":55778,"en":"Will they seize him now, I fear?"},{"id":"manas-2010:p1287:b001:l025","ordinal":55779,"en":"Heaven will strike the faithless, I think;"},{"id":"manas-2010:p1287:b001:l026","ordinal":55780,"en":"Having captured Manas,"},{"id":"manas-2010:p1287:b001:l027","ordinal":55781,"en":"Will they do what has never been done?"},{"id":"manas-2010:p1287:b001:l028","ordinal":55782,"en":"Fallen captive and humiliated,"},{"id":"manas-2010:p1287:b001:l029","ordinal":55783,"en":"Carried away bound in their hands,"},{"id":"manas-2010:p1287:b001:l030","ordinal":55784,"en":"Alas, will Manas stand there thus?"},{"id":"manas-2010:p1287:b001:l031","ordinal":55785,"en":"Almambet, Chubak, my precious ones,"},{"id":"manas-2010:p1287:b001:l032","ordinal":55786,"en":"And Syrgak, my champion,"},{"id":"manas-2010:p1287:b001:l033","ordinal":55787,"en":"Piebald-headed horses on the hills—"},{"id":"manas-2010:p1287:b001:l034","ordinal":55788,"en":"Deceitful world, what can I do?"},{"id":"manas-2010:p1287:b001:l035","ordinal":55789,"en":"The son I leave behind is young;"},{"id":"manas-2010:p1287:b001:l036","ordinal":55790,"en":"All my kinsmen are enemies!"},{"id":"manas-2010:p1287:b001:l037","ordinal":55791,"en":"Those treacherous Abyke and Köbösh,"},{"id":"manas-2010:p1287:b001:l038","ordinal":55792,"en":"Deception lurks in their eyes."},{"id":"manas-2010:p1287:b001:l039","ordinal":55793,"en":"If they had the strength, the six villains"},{"id":"manas-2010:p1287:b001:l040","ordinal":55794,"en":"Would be trying to strike me down."},{"id":"manas-2010:p1287:b001:l041","ordinal":55795,"en":"There is crookedness in their words;"},{"id":"manas-2010:p1287:b001:l042","ordinal":55796,"en":"Those villains, enemies in their very bearing,"},{"id":"manas-2010:p1288:b001:l001","ordinal":55797,"en":"Have been plotting against me."},{"id":"manas-2010:p1288:b001:l002","ordinal":55798,"en":"Moon dark, night overcast—"},{"id":"manas-2010:p1288:b001:l003","ordinal":55799,"en":"What will become of the day?"},{"id":"manas-2010:p1288:b001:l004","ordinal":55800,"en":"Kanykey, the khan's daughter whom I married—"},{"id":"manas-2010:p1288:b001:l005","ordinal":55801,"en":"What will become of her?"},{"id":"manas-2010:p1288:b001:l006","ordinal":55802,"en":"Almambet, Chubak, my twins,"},{"id":"manas-2010:p1288:b001:l007","ordinal":55803,"en":"Precious Syrgak, my ocean,"},{"id":"manas-2010:p1288:b001:l008","ordinal":55804,"en":"The battle-axe with its hawthorn handle—"},{"id":"manas-2010:p1288:b001:l009","ordinal":55805,"en":"Who will fit it without twisting it?"},{"id":"manas-2010:p1288:b001:l010","ordinal":55806,"en":"The surging Nogoy and numerous Argyn,"},{"id":"manas-2010:p1288:b001:l011","ordinal":55807,"en":"The multitude of my beloved people—"},{"id":"manas-2010:p1288:b001:l012","ordinal":55808,"en":"Who will lead them without scattering them?"}]
