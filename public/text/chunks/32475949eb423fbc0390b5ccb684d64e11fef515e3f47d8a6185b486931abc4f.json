[{"id":"seytek-2012:p0027:b003:l038","ordinal":295169,"en":"Make this grievous pain subside,"},{"id":"seytek-2012:p0027:b003:l039","ordinal":295170,"en":"Brighten this mirror-like face!”"},{"id":"seytek-2012:p0027:b003:l040","ordinal":295171,"en":"Her spirit was sorrow and her heart was pain;"},{"id":"seytek-2012:p0028:b002:l001","ordinal":295172,"en":"This woman earnestly begged"},{"id":"seytek-2012:p0028:b002:l002","ordinal":295173,"en":"The true God for a child."},{"id":"seytek-2012:p0028:b002:l003","ordinal":295174,"en":"After seven days had passed,"},{"id":"seytek-2012:p0028:b002:l004","ordinal":295175,"en":"When Chürök’s true labor"},{"id":"seytek-2012:p0028:b002:l005","ordinal":295176,"en":"Had lasted seven days,"},{"id":"seytek-2012:p0028:b002:l006","ordinal":295177,"en":"Her blood was spent and her strength was gone,"},{"id":"seytek-2012:p0028:b002:l007","ordinal":295178,"en":"Her power failed and her breath grew faint."},{"id":"seytek-2012:p0028:b002:l008","ordinal":295179,"en":"Wailing and wasting away for the child,"},{"id":"seytek-2012:p0028:b002:l009","ordinal":295180,"en":"She was left utterly helpless."},{"id":"seytek-2012:p0028:b002:l010","ordinal":295181,"en":"Then Aichürök"},{"id":"seytek-2012:p0028:b002:l011","ordinal":295182,"en":"Raised her voice in a scream;"},{"id":"seytek-2012:p0028:b002:l012","ordinal":295183,"en":"The lifeless trees wept,"},{"id":"seytek-2012:p0028:b002:l013","ordinal":295184,"en":"All the Creator’s works wept,"},{"id":"seytek-2012:p0028:b002:l014","ordinal":295185,"en":"Every living creature wept—"},{"id":"seytek-2012:p0028:b002:l015","ordinal":295186,"en":"Chürök’s ordeal had begun."},{"id":"seytek-2012:p0028:b002:l016","ordinal":295187,"en":"Sixty stars and seven wild sheep,"},{"id":"seytek-2012:p0028:b002:l017","ordinal":295188,"en":"Arrayed high overhead,"},{"id":"seytek-2012:p0028:b002:l018","ordinal":295189,"en":"The moon and stars sharing her travail,"},{"id":"seytek-2012:p0028:b002:l019","ordinal":295190,"en":"Labored together above her."},{"id":"seytek-2012:p0028:b002:l020","ordinal":295191,"en":"Gathering all around,"},{"id":"seytek-2012:p0028:b002:l021","ordinal":295192,"en":"The shamans of every tribe"},{"id":"seytek-2012:p0028:b002:l022","ordinal":295193,"en":"Joined her travail in a great throng."},{"id":"seytek-2012:p0028:b002:l023","ordinal":295194,"en":"Then Aichürök"},{"id":"seytek-2012:p0028:b002:l024","ordinal":295195,"en":"Labored without pause for eight days;"},{"id":"seytek-2012:p0028:b002:l025","ordinal":295196,"en":"Only a spoonful of blood remained."},{"id":"seytek-2012:p0028:b002:l026","ordinal":295197,"en":"She lost consciousness, unable even to groan,"},{"id":"seytek-2012:p0028:b002:l027","ordinal":295198,"en":"And her flesh became a bruised, blue pulp."},{"id":"seytek-2012:p0028:b002:l028","ordinal":295199,"en":"She had no voice left even to moan,"},{"id":"seytek-2012:p0028:b002:l029","ordinal":295200,"en":"And no strength remained"},{"id":"seytek-2012:p0028:b002:l030","ordinal":295201,"en":"To hide her state from Kyyaz of the Jediger."},{"id":"seytek-2012:p0028:b002:l031","ordinal":295202,"en":"Agonized by true labor,"},{"id":"seytek-2012:p0028:b002:l032","ordinal":295203,"en":"The poor woman could endure no more"},{"id":"seytek-2012:p0028:b002:l033","ordinal":295204,"en":"And despaired of her frail, fly-like life."},{"id":"seytek-2012:p0028:b002:l034","ordinal":295205,"en":"When nine days had passed,"},{"id":"seytek-2012:p0028:b002:l035","ordinal":295206,"en":"There was no way to restrain herself;"},{"id":"seytek-2012:p0028:b002:l036","ordinal":295207,"en":"None of her own gathered people were there."},{"id":"seytek-2012:p0028:b002:l037","ordinal":295208,"en":"When the bright dawn advanced"},{"id":"seytek-2012:p0028:b002:l038","ordinal":295209,"en":"And its first light glimmered,"},{"id":"seytek-2012:p0028:b002:l039","ordinal":295210,"en":"When daylight touched the earth,"},{"id":"seytek-2012:p0028:b002:l040","ordinal":295211,"en":"Stars poured down from the sky."},{"id":"seytek-2012:p0028:b003:l001","ordinal":295212,"en":"Her many thoughts unraveled,"},{"id":"seytek-2012:p0028:b003:l002","ordinal":295213,"en":"Her bewildered mind broke apart;"},{"id":"seytek-2012:p0028:b003:l003","ordinal":295214,"en":"The dark earth, sealed below,"},{"id":"seytek-2012:p0028:b003:l004","ordinal":295215,"en":"Seemed ready to take her"},{"id":"seytek-2012:p0028:b003:l005","ordinal":295216,"en":"If her head survived this ordeal."},{"id":"seytek-2012:p0028:b003:l006","ordinal":295217,"en":"From the distraught poor woman’s"},{"id":"seytek-2012:p0028:b003:l007","ordinal":295218,"en":"Quail-like eyes,"},{"id":"seytek-2012:p0028:b003:l008","ordinal":295219,"en":"Tears fell one after another;"},{"id":"seytek-2012:p0028:b003:l009","ordinal":295220,"en":"From her currant-dark eyes,"},{"id":"seytek-2012:p0028:b003:l010","ordinal":295221,"en":"As the wretched woman trembled,"},{"id":"seytek-2012:p0028:b003:l011","ordinal":295222,"en":"Tears fell a whip’s length."},{"id":"seytek-2012:p0028:b003:l012","ordinal":295223,"en":"Unable to gather and steady her thoughts,"},{"id":"seytek-2012:p0028:b003:l013","ordinal":295224,"en":"She wept in anguish from her sorrow"},{"id":"seytek-2012:p0028:b003:l014","ordinal":295225,"en":"And could not even draw back the mucus from her nose."},{"id":"seytek-2012:p0028:b003:l015","ordinal":295226,"en":"As the distraught woman lamented,"},{"id":"seytek-2012:p0028:b003:l016","ordinal":295227,"en":"Her joints loosened and came apart;"},{"id":"seytek-2012:p0028:b003:l017","ordinal":295228,"en":"Brave Kyyaz of the Jediger"},{"id":"seytek-2012:p0028:b003:l018","ordinal":295229,"en":"Appeared before her eyes"},{"id":"seytek-2012:p0028:b003:l019","ordinal":295230,"en":"Like a ravenous monster."},{"id":"seytek-2012:p0028:b003:l020","ordinal":295231,"en":"The golden doorway and gate"},{"id":"seytek-2012:p0028:b003:l021","ordinal":295232,"en":"Had panels of solid tin."},{"id":"seytek-2012:p0028:b003:l022","ordinal":295233,"en":"As for the approach to Khan Kyyaz,"},{"id":"seytek-2012:p0028:b003:l023","ordinal":295234,"en":"The looming figure’s"},{"id":"seytek-2012:p0028:b003:l024","ordinal":295235,"en":"Appearance was like this:"},{"id":"seytek-2012:p0028:b003:l025","ordinal":295236,"en":"Within the white palace,"},{"id":"seytek-2012:p0028:b003:l026","ordinal":295237,"en":"Beside the dark spring,"},{"id":"seytek-2012:p0028:b003:l027","ordinal":295238,"en":"Right by the plane tree,"},{"id":"seytek-2012:p0028:b003:l028","ordinal":295239,"en":"Surrounded by a fortress of lions—"},{"id":"seytek-2012:p0028:b003:l029","ordinal":295240,"en":"Who among humankind had ever possessed such things?"},{"id":"seytek-2012:p0028:b003:l030","ordinal":295241,"en":"Your radiant Chürök,"},{"id":"seytek-2012:p0028:b003:l031","ordinal":295242,"en":"Your formidable wonder,"},{"id":"seytek-2012:p0028:b003:l032","ordinal":295243,"en":"Your moon-beautiful wife,"},{"id":"seytek-2012:p0028:b003:l033","ordinal":295244,"en":"Your infidel rich in wisdom,"},{"id":"seytek-2012:p0028:b003:l034","ordinal":295245,"en":"Had grown old among the people, keeping the nation,"},{"id":"seytek-2012:p0028:b003:l035","ordinal":295246,"en":"And become renowned."},{"id":"seytek-2012:p0028:b003:l036","ordinal":295247,"en":"Without shame she had Mother Umai Zuura"},{"id":"seytek-2012:p0028:b003:l037","ordinal":295248,"en":"Set her womb aright,"},{"id":"seytek-2012:p0028:b003:l038","ordinal":295249,"en":"And, letting no one suspect,"},{"id":"seytek-2012:p0028:b003:l039","ordinal":295250,"en":"The distraught woman labored for seven days,"},{"id":"seytek-2012:p0028:b003:l040","ordinal":295251,"en":"Spending her frail, fly-like life."},{"id":"seytek-2012:p0030:b002:l001","ordinal":295252,"en":"From atop that tower"},{"id":"seytek-2012:p0030:b002:l002","ordinal":295253,"en":"She called out to all the assembled people."},{"id":"seytek-2012:p0030:b002:l003","ordinal":295254,"en":"“Surging hosts of the Jediger,"},{"id":"seytek-2012:p0030:b002:l004","ordinal":295255,"en":"Come, all of you!” she cried."},{"id":"seytek-2012:p0030:b002:l005","ordinal":295256,"en":"“Great dark host of the Jediger,"},{"id":"seytek-2012:p0030:b002:l006","ordinal":295257,"en":"The khan’s doorway is like Judgment Day;"},{"id":"seytek-2012:p0030:b002:l007","ordinal":295258,"en":"We need a way to pass through it."},{"id":"seytek-2012:p0030:b002:l008","ordinal":295259,"en":"The khan’s heart is massive iron;"},{"id":"seytek-2012:p0030:b002:l009","ordinal":295260,"en":"We need a way to melt it."},{"id":"seytek-2012:p0030:b002:l010","ordinal":295261,"en":"Let the renowned Jediger people"},{"id":"seytek-2012:p0030:b002:l011","ordinal":295262,"en":"Take counsel two by two."},{"id":"seytek-2012:p0030:b002:l012","ordinal":295263,"en":"Now, what do you say?"},{"id":"seytek-2012:p0030:b002:l013","ordinal":295264,"en":"Behold this dreadful matter:"},{"id":"seytek-2012:p0030:b002:l014","ordinal":295265,"en":"The tormented, ill-fated woman"},{"id":"seytek-2012:p0030:b002:l015","ordinal":295266,"en":"Has fallen into grievous labor;"},{"id":"seytek-2012:p0030:b002:l016","ordinal":295267,"en":"Come and judge her suffering."},{"id":"seytek-2012:p0030:b002:l017","ordinal":295268,"en":"Come, elders grown old among the people,"},{"id":"seytek-2012:p0030:b002:l018","ordinal":295269,"en":"All you long-eared men of wide experience"},{"id":"seytek-2012:p0030:b002:l019","ordinal":295270,"en":"Who understand the words you hear."},{"id":"seytek-2012:p0030:b002:l020","ordinal":295271,"en":"Come, you who calculate the months,"},{"id":"seytek-2012:p0030:b002:l021","ordinal":295272,"en":"You who reckon the lunar count;"},{"id":"seytek-2012:p0030:b002:l022","ordinal":295273,"en":"Come, men skilled in calculation,"},{"id":"seytek-2012:p0030:b002:l023","ordinal":295274,"en":"And hear the question I shall pose."},{"id":"seytek-2012:p0030:b002:l024","ordinal":295275,"en":"If Aichürök, Akun’s daughter,"},{"id":"seytek-2012:p0030:b002:l025","ordinal":295276,"en":"Should suddenly bear a child,"},{"id":"seytek-2012:p0030:b002:l026","ordinal":295277,"en":"Whose will it be? Consider!"},{"id":"seytek-2012:p0030:b002:l027","ordinal":295278,"en":"If moonlike Chürök"},{"id":"seytek-2012:p0030:b002:l028","ordinal":295279,"en":"Bears a child today,"},{"id":"seytek-2012:p0030:b002:l029","ordinal":295280,"en":"Whose will it be? Consider!”"},{"id":"seytek-2012:p0030:b002:l030","ordinal":295281,"en":"When the Jediger heard this,"},{"id":"seytek-2012:p0030:b002:l031","ordinal":295282,"en":"They set down the days in writing"},{"id":"seytek-2012:p0030:b002:l032","ordinal":295283,"en":"And made their reckoning of them."},{"id":"seytek-2012:p0030:b002:l033","ordinal":295284,"en":"Then they set down the months"},{"id":"seytek-2012:p0030:b002:l034","ordinal":295285,"en":"And calculated their count."},{"id":"seytek-2012:p0030:b002:l035","ordinal":295286,"en":"The shrewd and skillful elders,"},{"id":"seytek-2012:p0030:b002:l036","ordinal":295287,"en":"Like men struck by slaughter,"},{"id":"seytek-2012:p0030:b002:l037","ordinal":295288,"en":"The hard-pressed Jediger,"},{"id":"seytek-2012:p0030:b002:l038","ordinal":295289,"en":"All seethed with agitation."},{"id":"seytek-2012:p0030:b002:l039","ordinal":295290,"en":"In the marsh of Üyrülmö Hill,"},{"id":"seytek-2012:p0030:b002:l040","ordinal":295291,"en":"They held council for three days."},{"id":"seytek-2012:p0030:b003:l001","ordinal":295292,"en":"A great reverberation struck the earth;"},{"id":"seytek-2012:p0030:b003:l002","ordinal":295293,"en":"Stars appeared one by one overhead,"},{"id":"seytek-2012:p0030:b003:l003","ordinal":295294,"en":"And light quivered upon the ground."},{"id":"seytek-2012:p0030:b003:l004","ordinal":295295,"en":"Stars flashed in the heavens,"},{"id":"seytek-2012:p0030:b003:l005","ordinal":295296,"en":"Cries rang toward the qibla,"},{"id":"seytek-2012:p0030:b003:l006","ordinal":295297,"en":"The bitter wind before dawn whistled,"},{"id":"seytek-2012:p0030:b003:l007","ordinal":295298,"en":"The reed tops rattled,"},{"id":"seytek-2012:p0030:b003:l008","ordinal":295299,"en":"And fledgling larks clamored."},{"id":"seytek-2012:p0030:b003:l009","ordinal":295300,"en":"Full daylight touched the earth,"},{"id":"seytek-2012:p0030:b003:l010","ordinal":295301,"en":"And the radiant dawn advanced."},{"id":"seytek-2012:p0030:b003:l011","ordinal":295302,"en":"Every beast and living creature"},{"id":"seytek-2012:p0030:b003:l012","ordinal":295303,"en":"Raised a clamor from the earth;"},{"id":"seytek-2012:p0030:b003:l013","ordinal":295304,"en":"Upon every mountaintop,"},{"id":"seytek-2012:p0030:b003:l014","ordinal":295305,"en":"Radiance poured as the sun rose."},{"id":"seytek-2012:p0030:b003:l015","ordinal":295306,"en":"From the palace in the tower,"},{"id":"seytek-2012:p0030:b003:l016","ordinal":295307,"en":"Holding a golden staff,"},{"id":"seytek-2012:p0030:b003:l017","ordinal":295308,"en":"Waving her white kerchief,"},{"id":"seytek-2012:p0030:b003:l018","ordinal":295309,"en":"Wrapped in a loose fur coat,"},{"id":"seytek-2012:p0030:b003:l019","ordinal":295310,"en":"The unfortunate woman walked with measured grace,"},{"id":"seytek-2012:p0030:b003:l020","ordinal":295311,"en":"Imploring the Creator."},{"id":"seytek-2012:p0030:b003:l021","ordinal":295312,"en":"Within the tower with its threshold,"},{"id":"seytek-2012:p0030:b003:l022","ordinal":295313,"en":"The helpless, ill-fated woman"},{"id":"seytek-2012:p0030:b003:l023","ordinal":295314,"en":"Stood in true labor."},{"id":"seytek-2012:p0030:b003:l024","ordinal":295315,"en":"Mountainous Kyyaz now saw"},{"id":"seytek-2012:p0030:b003:l025","ordinal":295316,"en":"Your sister-in-law’s travail."},{"id":"seytek-2012:p0030:b003:l026","ordinal":295317,"en":"Seeing it, brave Kyyaz"},{"id":"seytek-2012:p0030:b003:l027","ordinal":295318,"en":"Prepared himself like a hawk;"},{"id":"seytek-2012:p0030:b003:l028","ordinal":295319,"en":"An idea from the unseen"},{"id":"seytek-2012:p0030:b003:l029","ordinal":295320,"en":"Came to brave Kyyaz."},{"id":"seytek-2012:p0030:b003:l030","ordinal":295321,"en":"Rumbling in fury,"},{"id":"seytek-2012:p0030:b003:l031","ordinal":295322,"en":"He addressed the great dark host of the Jediger:"},{"id":"seytek-2012:p0030:b003:l032","ordinal":295323,"en":"“Assemble before the khan!”"},{"id":"seytek-2012:p0030:b003:l033","ordinal":295324,"en":"Khan Kyyaz began to rage."},{"id":"seytek-2012:p0030:b003:l034","ordinal":295325,"en":"When they saw Khan Kyyaz’s wrath,"},{"id":"seytek-2012:p0030:b003:l035","ordinal":295326,"en":"The Jediger acted as though an enemy had come;"},{"id":"seytek-2012:p0030:b003:l036","ordinal":295327,"en":"Crying, “May our people’s road be fortunate!”"},{"id":"seytek-2012:p0030:b003:l037","ordinal":295328,"en":"They scattered in fright."},{"id":"seytek-2012:p0030:b003:l038","ordinal":295329,"en":"The tower was the emblem of the khan—"},{"id":"seytek-2012:p0030:b003:l039","ordinal":295330,"en":"Ask no more about that tower:"},{"id":"seytek-2012:p0030:b003:l040","ordinal":295331,"en":"Its full height was magnificent."},{"id":"seytek-2012:p0031:b002:l001","ordinal":295332,"en":"Seeing him would set the heart at ease,"},{"id":"seytek-2012:p0031:b002:l002","ordinal":295333,"en":"Saying, “A son born of a khan,”"},{"id":"seytek-2012:p0031:b002:l003","ordinal":295334,"en":"Looking upon him would satisfy my blood,"},{"id":"seytek-2012:p0031:b002:l004","ordinal":295335,"en":"We have made him our ward and have no regrets."},{"id":"seytek-2012:p0031:b002:l005","ordinal":295336,"en":"If he matures into a hero,"},{"id":"seytek-2012:p0031:b002:l006","ordinal":295337,"en":"If he becomes the equal of heroic sons,"},{"id":"seytek-2012:p0031:b002:l007","ordinal":295338,"en":"We shall give him the throne and make him khan,"},{"id":"seytek-2012:p0031:b002:l008","ordinal":295339,"en":"And make him a worthy hero,"},{"id":"seytek-2012:p0031:b002:l009","ordinal":295340,"en":"We shall take shelter in him"},{"id":"seytek-2012:p0031:b002:l010","ordinal":295341,"en":"When this child grows up."},{"id":"seytek-2012:p0031:b002:l011","ordinal":295342,"en":"He will reach Afghanistan and lay it waste;"},{"id":"seytek-2012:p0031:b002:l012","ordinal":295343,"en":"How could Jet-Kait escape unharmed?"},{"id":"seytek-2012:p0031:b002:l013","ordinal":295344,"en":"They will don armor no arrow can pierce,"},{"id":"seytek-2012:p0031:b002:l014","ordinal":295345,"en":"And attack a people"},{"id":"seytek-2012:p0031:b002:l015","ordinal":295346,"en":"No man has heard of or seen."},{"id":"seytek-2012:p0031:b002:l016","ordinal":295347,"en":"They will journey to lands"},{"id":"seytek-2012:p0031:b002:l017","ordinal":295348,"en":"No ear has heard of and no nation has seen."},{"id":"seytek-2012:p0031:b002:l018","ordinal":295349,"en":"If your child survives,"},{"id":"seytek-2012:p0031:b002:l019","ordinal":295350,"en":"Firwood spears will clash,"},{"id":"seytek-2012:p0031:b002:l020","ordinal":295351,"en":"And wherever he strikes, war will rage."},{"id":"seytek-2012:p0031:b002:l021","ordinal":295352,"en":"If your son lives,"},{"id":"seytek-2012:p0031:b002:l022","ordinal":295353,"en":"The Jediger of Jeti-Özön"},{"id":"seytek-2012:p0031:b002:l023","ordinal":295354,"en":"Will reach the foe and feast on spoils."},{"id":"seytek-2012:p0031:b002:l024","ordinal":295355,"en":"Across the face of the earth"},{"id":"seytek-2012:p0031:b002:l025","ordinal":295356,"en":"He will be famed as Kyyaz’s son."},{"id":"seytek-2012:p0031:b002:l026","ordinal":295357,"en":"Our dream has turned out well:"},{"id":"seytek-2012:p0031:b002:l027","ordinal":295358,"en":"The captive woman will bear a son,"},{"id":"seytek-2012:p0031:b002:l028","ordinal":295359,"en":"And our cause will not fare badly."},{"id":"seytek-2012:p0031:b002:l029","ordinal":295360,"en":"The child this woman bears you"},{"id":"seytek-2012:p0031:b002:l030","ordinal":295361,"en":"Will have perfect fortune;"},{"id":"seytek-2012:p0031:b002:l031","ordinal":295362,"en":"The enemy who challenges him will be humbled."},{"id":"seytek-2012:p0031:b002:l032","ordinal":295363,"en":"His gaze will be a surging flood;"},{"id":"seytek-2012:p0031:b002:l033","ordinal":295364,"en":"Whoever grapples with him will be humbled."},{"id":"seytek-2012:p0031:b002:l034","ordinal":295365,"en":"The way he faces will blaze like fire;"},{"id":"seytek-2012:p0031:b002:l035","ordinal":295366,"en":"The enemy will halt without confronting him."},{"id":"seytek-2012:p0031:b002:l036","ordinal":295367,"en":"He will be a flame burning on the mountain pass;"},{"id":"seytek-2012:p0031:b002:l037","ordinal":295368,"en":"Without confronting him, the enemy"},{"id":"seytek-2012:p0031:b002:l038","ordinal":295369,"en":"Will halt!"},{"id":"seytek-2012:p0031:b002:l039","ordinal":295370,"en":"If your child survives,"},{"id":"seytek-2012:p0031:b002:l040","ordinal":295371,"en":"See what his valor will be:"},{"id":"seytek-2012:p0031:b003:l001","ordinal":295372,"en":"In the marshes of Chogulma"},{"id":"seytek-2012:p0031:b003:l002","ordinal":295373,"en":"They had gathered together."},{"id":"seytek-2012:p0031:b003:l003","ordinal":295374,"en":"They recorded the days,"},{"id":"seytek-2012:p0031:b003:l004","ordinal":295375,"en":"Saying, “This is the count of days,”"},{"id":"seytek-2012:p0031:b003:l005","ordinal":295376,"en":"And vied in calculation."},{"id":"seytek-2012:p0031:b003:l006","ordinal":295377,"en":"They recorded the months,"},{"id":"seytek-2012:p0031:b003:l007","ordinal":295378,"en":"Saying, “This is the count of months,”"},{"id":"seytek-2012:p0031:b003:l008","ordinal":295379,"en":"And disputed among themselves."},{"id":"seytek-2012:p0031:b003:l009","ordinal":295380,"en":"They reckoned the count of days"},{"id":"seytek-2012:p0031:b003:l010","ordinal":295381,"en":"And entered the days in writing."},{"id":"seytek-2012:p0031:b003:l011","ordinal":295382,"en":"They reckoned the count of months"},{"id":"seytek-2012:p0031:b003:l012","ordinal":295383,"en":"And learned the truth for certain."},{"id":"seytek-2012:p0031:b003:l013","ordinal":295384,"en":"Speaking softly but firmly,"},{"id":"seytek-2012:p0031:b003:l014","ordinal":295385,"en":"Bearded hero Kutu"},{"id":"seytek-2012:p0031:b003:l015","ordinal":295386,"en":"Began to address brave Kyyaz:"},{"id":"seytek-2012:p0031:b003:l016","ordinal":295387,"en":"“When we count the months,"},{"id":"seytek-2012:p0031:b003:l017","ordinal":295388,"en":"A full twelve months have passed;"},{"id":"seytek-2012:p0031:b003:l018","ordinal":295389,"en":"The child the woman is to bear"},{"id":"seytek-2012:p0031:b003:l019","ordinal":295390,"en":"Is truly your own child."},{"id":"seytek-2012:p0031:b003:l020","ordinal":295391,"en":"When the woman gives birth,"},{"id":"seytek-2012:p0031:b003:l021","ordinal":295392,"en":"Slaughter ninety beasts for the feast"},{"id":"seytek-2012:p0031:b003:l022","ordinal":295393,"en":"And give the child a fitting name."},{"id":"seytek-2012:p0031:b003:l023","ordinal":295394,"en":"Let your heart know no doubt:"},{"id":"seytek-2012:p0031:b003:l024","ordinal":295395,"en":"Truly, the child sprung from your loins"},{"id":"seytek-2012:p0031:b003:l025","ordinal":295396,"en":"Is your own."},{"id":"seytek-2012:p0031:b003:l026","ordinal":295397,"en":"If it is a son,"},{"id":"seytek-2012:p0031:b003:l027","ordinal":295398,"en":"Choose the finest of all names."},{"id":"seytek-2012:p0031:b003:l028","ordinal":295399,"en":"Saying, ‘Kyyaz has gained a child,’"},{"id":"seytek-2012:p0031:b003:l029","ordinal":295400,"en":"Wash away every last sorrow"},{"id":"seytek-2012:p0031:b003:l030","ordinal":295401,"en":"From your heart."},{"id":"seytek-2012:p0031:b003:l031","ordinal":295402,"en":"If a fierce enemy host should come,"},{"id":"seytek-2012:p0031:b003:l032","ordinal":295403,"en":"We shall set him against them,"},{"id":"seytek-2012:p0031:b003:l033","ordinal":295404,"en":"And make him our war club."},{"id":"seytek-2012:p0031:b003:l034","ordinal":295405,"en":"We shall make him master among the people,"},{"id":"seytek-2012:p0031:b003:l035","ordinal":295406,"en":"A giant among the Jediger nation,"},{"id":"seytek-2012:p0031:b003:l036","ordinal":295407,"en":"And take him as our champion ram."},{"id":"seytek-2012:p0031:b003:l037","ordinal":295408,"en":"If his daily fortunes prosper"},{"id":"seytek-2012:p0031:b003:l038","ordinal":295409,"en":"And he grows greater day by day,"},{"id":"seytek-2012:p0031:b003:l039","ordinal":295410,"en":"Like that towering mountain,"},{"id":"seytek-2012:p0031:b003:l040","ordinal":295411,"en":"We shall make him our mighty bulwark."},{"id":"seytek-2012:p0032:b002:l001","ordinal":295412,"en":"Saying, ‘Now he has come of age,’"},{"id":"seytek-2012:p0032:b002:l002","ordinal":295413,"en":"Heed these words."},{"id":"seytek-2012:p0032:b002:l003","ordinal":295414,"en":"If a son is born, Jediger,"},{"id":"seytek-2012:p0032:b002:l004","ordinal":295415,"en":"Slaughter countless beasts for his feast,"},{"id":"seytek-2012:p0032:b002:l005","ordinal":295416,"en":"And put aside all such"},{"id":"seytek-2012:p0032:b002:l006","ordinal":295417,"en":"Slurred and foolish talk."},{"id":"seytek-2012:p0032:b002:l007","ordinal":295418,"en":"Let us strike down whoever goes astray;"},{"id":"seytek-2012:p0032:b002:l008","ordinal":295419,"en":"So none may babble slander,"},{"id":"seytek-2012:p0032:b002:l009","ordinal":295420,"en":"My people, let us lick"},{"id":"seytek-2012:p0032:b002:l010","ordinal":295421,"en":"The edge of the sword!”"},{"id":"seytek-2012:p0032:b002:l011","ordinal":295422,"en":"They kissed the bullets and swore an oath."},{"id":"seytek-2012:p0032:b002:l012","ordinal":295423,"en":"When the Jediger heard this, they said:"},{"id":"seytek-2012:p0032:b002:l013","ordinal":295424,"en":"“Enough, warrior Kutu,"}]
