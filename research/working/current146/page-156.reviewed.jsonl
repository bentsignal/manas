{"id": "sayakbay-ms-current146:pdf156:l001", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 1, "raw": "Арстандай көзү жайнады,", "text": "Арстандай көзү жайнады,", "en": "His eyes flashed like a lion’s,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l002", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 2, "raw": "Каар туткагы кармады,", "text": "Каар туткагы кармады,", "en": "A fit of rage seized him,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l003", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 3, "raw": "Баягы каалгадай кашка тиш,", "text": "Баягы каалгадай кашка тиш,", "en": "Those broad front teeth, like a gate,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l004", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 4, "raw": "Карсылдата чайнады.", "text": "Карсылдата чайнады.", "en": "He ground together with a crash.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l005", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 5, "raw": "Керик оозун бурду эми,", "text": "Керик оозун бурду эми,", "en": "Now he turned his rhinoceros-like muzzle,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l006", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 6, "raw": "Өрдөйдү уруп эми,", "text": "Өрдөйдү уруп эми,", "en": "And surged forward like a rising flood,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: this cursive line is an insertion or variant without a secure exact one-to-one printed counterpart.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l007", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 7, "raw": "Каарын тутуп каптады,", "text": "Каарын тутуп каптады,", "en": "Gripped by fury, he swept in,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: this cursive line is an insertion or variant without a secure exact one-to-one printed counterpart.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l008", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 8, "raw": "Каарданган заары чачып,", "text": "Каарданган заары чачып,", "en": "Scattering the venom of his rage,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: this cursive line is an insertion or variant without a secure exact one-to-one printed counterpart.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l009", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 9, "raw": "Ач айдаардай ооз ачып,", "text": "Ач айдаардай ооз ачып,", "en": "Opening his mouth as if to drive off hunger,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: this cursive line is an insertion or variant without a secure exact one-to-one printed counterpart.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l010", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 10, "raw": "Талааны бузуп, жол салып,", "text": "Талааны бузуп, жол салып,", "en": "Tearing across the field and opening a path,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l011", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 11, "raw": "Эр Көгөйгө кол салды.", "text": "Эр Көгөйгө кол салды.", "en": "He attacked the warrior Kögöy.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l012", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 12, "raw": "Көк жал тулган эр эле,", "text": "Көк жал тулган эр эле,", "en": "He was a warrior with a gray wolf’s mane,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: this cursive line is an insertion or variant without a secure exact one-to-one printed counterpart.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l013", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 13, "raw": "Эр Көгөй кандай болор деп,", "text": "Эр Көгөй кандай болор деп,", "en": "Wondering what would become of Kögöy,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: this cursive line is an insertion or variant without a secure exact one-to-one printed counterpart.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l014", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 14, "raw": "Ишин кудай оңдо деп,", "text": "Ишин кудай оңдо деп,", "en": "They prayed that God would prosper his undertaking,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: this cursive line is an insertion or variant without a secure exact one-to-one printed counterpart.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l015", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 15, "raw": "Жараткандан жалгыз падыша,", "text": "Жараткандан жалгыз падыша,", "en": "To the Creator, the sole sovereign,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: this cursive line is an insertion or variant without a secure exact one-to-one printed counterpart.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l016", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 16, "raw": "Баатырды кудай колдо деп,", "text": "Баатырды кудай колдо деп,", "en": "They prayed, “God, protect the warrior,”", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: this cursive line is an insertion or variant without a secure exact one-to-one printed counterpart.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l017", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 17, "raw": "Каралап адам зыркырап,", "text": "Каралап адам зыркырап,", "en": "The watching people trembled and wailed,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: this cursive line is an insertion or variant without a secure exact one-to-one printed counterpart.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l018", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 18, "raw": "Ага да эле, баа да эле,", "text": "Ага да эле, баа да эле,", "en": "They cried out to him in alarm,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: this cursive line is an insertion or variant without a secure exact one-to-one printed counterpart.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l019", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 19, "raw": "Аралашат душманга,", "text": "Аралашат душманга,", "en": "As he plunged among the enemy,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: this cursive line is an insertion or variant without a secure exact one-to-one printed counterpart.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l020", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 20, "raw": "Баатырды кудай сакта деп,", "text": "Баатырды кудай сакта деп,", "en": "“God, preserve the warrior,” they prayed,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: this cursive line is an insertion or variant without a secure exact one-to-one printed counterpart.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l021", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 21, "raw": "Ак калпак кыргыз чуркурап,", "text": "Ак калпак кыргыз чуркурап,", "en": "The white-kalpak Kyrgyz cried out together,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: this cursive line is an insertion or variant without a secure exact one-to-one printed counterpart.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l022", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 22, "raw": "Кудай бергин, кор кылба,", "text": "Кудай бергин, кор кылба,", "en": "“God, grant victory; do not disgrace him,”", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: this cursive line is an insertion or variant without a secure exact one-to-one printed counterpart.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l023", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 23, "raw": "Аркы баатыр, берки дөө,", "text": "Аркы баатыр, берки дөө,", "en": "The warrior on one side, the giant on the other,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l024", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 24, "raw": "Айкырып айза сунушту,", "text": "Айкырып айза сунушту,", "en": "Shouting, they leveled their spears,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l025", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 25, "raw": "Кезме-кезек урушту.", "text": "Кезме-кезек урушту.", "en": "They fought in turn.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l026", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 26, "raw": "Өлчөөлөшүп тушташты,", "text": "Өлчөөлөшүп тушташты,", "en": "Measuring one another, they met face-to-face,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l027", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 27, "raw": "Найза менен мушташты,", "text": "Найза менен мушташты,", "en": "They battled with spears,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l028", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 28, "raw": "Маңдайлаша барышып,", "text": "Маңдайлаша барышып,", "en": "Advancing straight at one another,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 29, "raw": "Чоюнбаш менен чабышты.", "text": "Чоюнбаш менен чабышты.", "en": "They struck with iron-headed maces.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l030", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 30, "raw": "Көк темирден туулга,", "text": "Көк темирден туулга,", "en": "The helmet of blue iron,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l031", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 31, "raw": "Кыры кыйрап сүзүлдү,", "text": "Кыры кыйрап сүзүлдү,", "en": "Had its rim shattered and crushed,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l032", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 32, "raw": "Көр баскан туулга,", "text": "Көр баскан туулга,", "en": "The helmet that covered his sight,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: this cursive line is an insertion or variant without a secure exact one-to-one printed counterpart.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l033", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 33, "raw": "Кырылып кайран сүзүлдү,", "text": "Кырылып кайран сүзүлдү,", "en": "Was scraped and battered apart,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional manuscript reading: this cursive line is an insertion or variant without a secure exact one-to-one printed counterpart.", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l034", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 34, "raw": "Чалгынга минсе чарчабас,", "text": "Чалгынга минсе чарчабас,", "en": "Tireless when ridden on patrol,", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
{"id": "sayakbay-ms-current146:pdf156:l035", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 156, "folio": 539, "line_in_page": 35, "raw": "Кетмен туяк, кең соору.", "text": "Кетмен туяк, кең соору.", "en": "With mattock-like hooves and broad hindquarters.", "classification": "narrative", "transcription_status": "visually_transcribed", "uncertainty_note": "", "bbox": null}
