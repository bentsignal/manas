[{"id":"seytek-1991-continuation:p0347:b006:l015","ordinal":388353,"en":"Hearing this, Chyntengir said:"},{"id":"seytek-1991-continuation:p0347:b006:l016","ordinal":388354,"en":"“The Ala-Too is no land for us;"},{"id":"seytek-1991-continuation:p0347:b006:l017","ordinal":388355,"en":"The old enemy, the vile Burut,"},{"id":"seytek-1991-continuation:p0347:b006:l018","ordinal":388356,"en":"Will never be a people to us."},{"id":"seytek-1991-continuation:p0347:b006:l019","ordinal":388357,"en":"Inflict harsh torment;"},{"id":"seytek-1991-continuation:p0347:b006:l020","ordinal":388358,"en":"Silence his tongue without delay."},{"id":"seytek-1991-continuation:p0347:b006:l021","ordinal":388359,"en":"Bring his death upon him now,"},{"id":"seytek-1991-continuation:p0347:b006:l022","ordinal":388360,"en":"Deprive him of every recourse."},{"id":"seytek-1991-continuation:p0347:b006:l023","ordinal":388361,"en":"Cut strips of hide from his back;"},{"id":"seytek-1991-continuation:p0347:b006:l024","ordinal":388362,"en":"You blood-drinking champions,"},{"id":"seytek-1991-continuation:p0347:b006:l025","ordinal":388363,"en":"Seize him and take his life!"},{"id":"seytek-1991-continuation:p0347:b006:l026","ordinal":388364,"en":"Cut off his sheep-like head;"},{"id":"seytek-1991-continuation:p0347:b006:l027","ordinal":388365,"en":"Rip open his melon-like belly!”"},{"id":"seytek-1991-continuation:p0347:b006:l028","ordinal":388366,"en":"Thus Chyntengir spoke,"},{"id":"seytek-1991-continuation:p0347:b006:l029","ordinal":388367,"en":"Urging and dispatching"},{"id":"seytek-1991-continuation:p0347:b006:l030","ordinal":388368,"en":"His champions and giants,"},{"id":"seytek-1991-continuation:p0347:b006:l031","ordinal":388369,"en":"Rousing and dispatching"},{"id":"seytek-1991-continuation:p0347:b006:l032","ordinal":388370,"en":"His strongest heroes."},{"id":"seytek-1991-continuation:p0347:b006:l033","ordinal":388371,"en":"His champions and warriors"},{"id":"seytek-1991-continuation:p0347:b006:l034","ordinal":388372,"en":"Now began to trample and beat him,"},{"id":"seytek-1991-continuation:p0347:b006:l035","ordinal":388373,"en":"Inflicting every torture they knew."},{"id":"seytek-1991-continuation:p0347:b006:l036","ordinal":388374,"en":"They tormented and took his life,"},{"id":"seytek-1991-continuation:p0347:b006:l037","ordinal":388375,"en":"Cutting off his hands and feet."},{"id":"seytek-1991-continuation:p0347:b006:l038","ordinal":388376,"en":"The champions attacked"},{"id":"seytek-1991-continuation:p0347:b006:l039","ordinal":388377,"en":"The noble gray-maned hero"},{"id":"seytek-1991-continuation:p0347:b006:l040","ordinal":388378,"en":"And took his precious head;"},{"id":"seytek-1991-continuation:p0347:b006:l041","ordinal":388379,"en":"They finished him then and there."},{"id":"seytek-1991-continuation:p0347:b006:l042","ordinal":388380,"en":"“We slaughtered and destroyed the champion"},{"id":"seytek-1991-continuation:p0347:b006:l043","ordinal":388381,"en":"Whose stars crossed ours.”"},{"id":"seytek-1991-continuation:p0347:b006:l044","ordinal":388382,"en":"Breaking through the dead end and opening a road,"},{"id":"seytek-1991-continuation:p0347:b006:l045","ordinal":388383,"en":"The Chinese army attacked directly"},{"id":"seytek-1991-continuation:p0347:b006:l046","ordinal":388384,"en":"Against the true Black Kyrgyz."},{"id":"seytek-1991-continuation:p0348:b001:l001","ordinal":388385,"en":"Alymsaryk and hero Kulan,"},{"id":"seytek-1991-continuation:p0348:b001:l002","ordinal":388386,"en":"Defenders of all the people,"},{"id":"seytek-1991-continuation:p0348:b001:l003","ordinal":388387,"en":"Fought a vicious fight,"},{"id":"seytek-1991-continuation:p0348:b001:l004","ordinal":388388,"en":"Standing face-to-face,"},{"id":"seytek-1991-continuation:p0348:b001:l005","ordinal":388389,"en":"Fighting turn by turn,"},{"id":"seytek-1991-continuation:p0348:b001:l006","ordinal":388390,"en":"Locked in a bloody struggle."},{"id":"seytek-1991-continuation:p0348:b001:l007","ordinal":388391,"en":"Their father, gray-maned Jeljetpes,"},{"id":"seytek-1991-continuation:p0348:b001:l008","ordinal":388392,"en":"Was protecting the twin heroes,"},{"id":"seytek-1991-continuation:p0348:b001:l009","ordinal":388393,"en":"So the champion's line might endure."},{"id":"seytek-1991-continuation:p0348:b001:l010","ordinal":388394,"en":"He turned summer's day into winter,"},{"id":"seytek-1991-continuation:p0348:b001:l011","ordinal":388395,"en":"And plunged the Chinese and Kakan troops"},{"id":"seytek-1991-continuation:p0348:b001:l012","ordinal":388396,"en":"Who came against them into calamity."},{"id":"seytek-1991-continuation:p0348:b001:l013","ordinal":388397,"en":"He sent a flood and made it water."},{"id":"seytek-1991-continuation:p0348:b001:l014","ordinal":388398,"en":"The three heroes raised an uproar,"},{"id":"seytek-1991-continuation:p0348:b001:l015","ordinal":388399,"en":"Cutting through the standing Chinese host."},{"id":"seytek-1991-continuation:p0348:b001:l016","ordinal":388400,"en":"Supporting one another,"},{"id":"seytek-1991-continuation:p0348:b001:l017","ordinal":388401,"en":"They were drenched in bloody dust,"},{"id":"seytek-1991-continuation:p0348:b001:l018","ordinal":388402,"en":"And fought without turning back."},{"id":"seytek-1991-continuation:p0348:b001:l019","ordinal":388403,"en":"Jeljetpes moved through their midst;"},{"id":"seytek-1991-continuation:p0348:b001:l020","ordinal":388404,"en":"Wounded in seven places,"},{"id":"seytek-1991-continuation:p0348:b001:l021","ordinal":388405,"en":"He had a net spread before him."},{"id":"seytek-1991-continuation:p0348:b001:l022","ordinal":388406,"en":"After countless heroes"},{"id":"seytek-1991-continuation:p0348:b001:l023","ordinal":388407,"en":"From the Beijing host thrust at him,"},{"id":"seytek-1991-continuation:p0348:b001:l024","ordinal":388408,"en":"His life was truly scorched."},{"id":"seytek-1991-continuation:p0348:b002:l001","ordinal":388409,"en":"He was snatched from certain death,"},{"id":"seytek-1991-continuation:p0348:b002:l002","ordinal":388410,"en":"Caught in the fatal net,"},{"id":"seytek-1991-continuation:p0348:b002:l003","ordinal":388411,"en":"Yet Jeljetpes broke free and escaped."},{"id":"seytek-1991-continuation:p0348:b002:l004","ordinal":388412,"en":"Alymsaryk and Kulansaryk,"},{"id":"seytek-1991-continuation:p0348:b002:l005","ordinal":388413,"en":"Two fair heroes with rhyming names,"},{"id":"seytek-1991-continuation:p0348:b002:l006","ordinal":388414,"en":"Passed through the solitary foe."},{"id":"seytek-1991-continuation:p0348:b002:l007","ordinal":388415,"en":"Their muscular flesh was torn,"},{"id":"seytek-1991-continuation:p0348:b002:l008","ordinal":388416,"en":"And the flesh of their ribs ripped away;"},{"id":"seytek-1991-continuation:p0348:b002:l009","ordinal":388417,"en":"The two reached a quiet place."},{"id":"seytek-1991-continuation:p0348:b002:l010","ordinal":388418,"en":"Climbing to a mountain pass, they leaned down,"},{"id":"seytek-1991-continuation:p0348:b002:l011","ordinal":388419,"en":"And on a truly sacred hill"},{"id":"seytek-1991-continuation:p0348:b002:l012","ordinal":388420,"en":"They dozed and fell asleep."},{"id":"seytek-1991-continuation:p0348:b002:l013","ordinal":388421,"en":"Their closed eyes would not open,"},{"id":"seytek-1991-continuation:p0348:b002:l014","ordinal":388422,"en":"Their outstretched legs would not draw in,"},{"id":"seytek-1991-continuation:p0348:b002:l015","ordinal":388423,"en":"And their deep snoring did not cease."},{"id":"seytek-1991-continuation:p0348:b002:l016","ordinal":388424,"en":"They sank into a giant's sleep."},{"id":"seytek-1991-continuation:p0348:b002:l017","ordinal":388425,"en":"Jeljetpes and the twin heroes"},{"id":"seytek-1991-continuation:p0348:b002:l018","ordinal":388426,"en":"Let the horses they had ridden to war"},{"id":"seytek-1991-continuation:p0348:b002:l019","ordinal":388427,"en":"Cool fully and drink their fill."},{"id":"seytek-1991-continuation:p0348:b002:l020","ordinal":388428,"en":"They grazed them on feather grass,"},{"id":"seytek-1991-continuation:p0348:b002:l021","ordinal":388429,"en":"Led them a little while,"},{"id":"seytek-1991-continuation:p0348:b002:l022","ordinal":388430,"en":"And filled their throats with grass;"},{"id":"seytek-1991-continuation:p0348:b002:l023","ordinal":388431,"en":"Led them a long while,"},{"id":"seytek-1991-continuation:p0348:b002:l024","ordinal":388432,"en":"And filled their chests with grass."}]
