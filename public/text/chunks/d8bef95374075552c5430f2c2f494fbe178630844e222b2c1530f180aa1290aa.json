[{"id":"semetey-1-2013:p0400:b003:l009","ordinal":107521,"en":"That warrior climbed,"},{"id":"semetey-1-2013:p0400:b003:l010","ordinal":107522,"en":"Sparing not his threadlike life."},{"id":"semetey-1-2013:p0400:b003:l011","ordinal":107523,"en":"At Zhalpak-Kyya and Zhar-Tash,"},{"id":"semetey-1-2013:p0400:b003:l012","ordinal":107524,"en":"He lay down and slept his fill,"},{"id":"semetey-1-2013:p0400:b003:l013","ordinal":107525,"en":"Took a little nap,"},{"id":"semetey-1-2013:p0400:b003:l014","ordinal":107526,"en":"Rested upon his elbow."},{"id":"semetey-1-2013:p0400:b003:l015","ordinal":107527,"en":"The stars parted in the sky;"},{"id":"semetey-1-2013:p0400:b003:l016","ordinal":107528,"en":"The earth showed bright and clear."},{"id":"semetey-1-2013:p0400:b003:l017","ordinal":107529,"en":"When the Taraza stars had set,"},{"id":"semetey-1-2013:p0400:b003:l018","ordinal":107530,"en":"When the dawn broke bright,"},{"id":"semetey-1-2013:p0400:b003:l019","ordinal":107531,"en":"The stars above parted;"},{"id":"semetey-1-2013:p0400:b003:l020","ordinal":107532,"en":"Daybreak opened into view."},{"id":"semetey-1-2013:p0400:b003:l021","ordinal":107533,"en":"As warrior Serek looked,"},{"id":"semetey-1-2013:p0400:b003:l022","ordinal":107534,"en":"At the edge of Lop's forest,"},{"id":"semetey-1-2013:p0400:b003:l023","ordinal":107535,"en":"At a jutting headland,"},{"id":"semetey-1-2013:p0400:b003:l024","ordinal":107536,"en":"Looming through a haze,"},{"id":"semetey-1-2013:p0400:b003:l025","ordinal":107537,"en":"Upon the slope of Chong-Tokoi,"},{"id":"semetey-1-2013:p0400:b003:l026","ordinal":107538,"en":"Riding a panting black horse,"},{"id":"semetey-1-2013:p0400:b003:l027","ordinal":107539,"en":"Its hairy tail tied tight,"},{"id":"semetey-1-2013:p0400:b003:l028","ordinal":107540,"en":"As huge as half a mountain,"},{"id":"semetey-1-2013:p0400:b003:l029","ordinal":107541,"en":"As though to devour all who appeared,"},{"id":"semetey-1-2013:p0400:b003:l030","ordinal":107542,"en":"Of middle height and broad shoulders,"},{"id":"semetey-1-2013:p0400:b003:l031","ordinal":107543,"en":"Seeming a hungry lion,"},{"id":"semetey-1-2013:p0400:b003:l032","ordinal":107544,"en":"With a fearsome countenance,"},{"id":"semetey-1-2013:p0400:b003:l033","ordinal":107545,"en":"Her beloved hair thick as a girth strap,"},{"id":"semetey-1-2013:p0400:b003:l034","ordinal":107546,"en":"Bound firmly upon her crown,"},{"id":"semetey-1-2013:p0400:b003:l035","ordinal":107547,"en":"All her battle equipment"},{"id":"semetey-1-2013:p0400:b003:l036","ordinal":107548,"en":"Worn to match together,"},{"id":"semetey-1-2013:p0400:b003:l037","ordinal":107549,"en":"A somewhat sullen figure"},{"id":"semetey-1-2013:p0400:b003:l038","ordinal":107550,"en":"Struck Algara on the thigh,"},{"id":"semetey-1-2013:p0400:b003:l039","ordinal":107551,"en":"Raising 'Oigut!' as her battle cry."},{"id":"semetey-1-2013:p0400:b004:l001","ordinal":107552,"en":"The hearts of those who saw were shaken;"},{"id":"semetey-1-2013:p0400:b004:l002","ordinal":107553,"en":"Syrnaiza, the spear she held out,"},{"id":"semetey-1-2013:p0400:b004:l003","ordinal":107554,"en":"Seemed forty fathoms long."},{"id":"semetey-1-2013:p0400:b004:l004","ordinal":107555,"en":"Serek, who stood watching,"},{"id":"semetey-1-2013:p0400:b004:l005","ordinal":107556,"en":"Had his heart sorely shaken."},{"id":"semetey-1-2013:p0400:b004:l006","ordinal":107557,"en":"The black horse beneath her,"},{"id":"semetey-1-2013:p0400:b004:l007","ordinal":107558,"en":"Foam poured from its mouth."},{"id":"semetey-1-2013:p0400:b004:l008","ordinal":107559,"en":"Going downhill, that black horse"},{"id":"semetey-1-2013:p0400:b004:l009","ordinal":107560,"en":"Planted its forelegs like a roe deer;"},{"id":"semetey-1-2013:p0400:b004:l010","ordinal":107561,"en":"As it climbed uphill,"},{"id":"semetey-1-2013:p0400:b004:l011","ordinal":107562,"en":"Its mane and tail streamed out."},{"id":"semetey-1-2013:p0400:b004:l012","ordinal":107563,"en":"When it reached uneven ground,"},{"id":"semetey-1-2013:p0400:b004:l013","ordinal":107564,"en":"Its bull-like neck bulged;"},{"id":"semetey-1-2013:p0400:b004:l014","ordinal":107565,"en":"When it reached the hills,"},{"id":"semetey-1-2013:p0400:b004:l015","ordinal":107566,"en":"Its eyes flashed like flint."},{"id":"semetey-1-2013:p0400:b004:l016","ordinal":107567,"en":"Striking the black horse on the thigh,"},{"id":"semetey-1-2013:p0400:b004:l017","ordinal":107568,"en":"Maiden Saikal, daughter of Khan Karacha,"},{"id":"semetey-1-2013:p0400:b004:l018","ordinal":107569,"en":"Then attacked the watchman"},{"id":"semetey-1-2013:p0400:b004:l019","ordinal":107570,"en":"And reached him sooner than an arrow."},{"id":"semetey-1-2013:p0400:b004:l020","ordinal":107571,"en":"Upon reaching him, Maiden Saikal,"},{"id":"semetey-1-2013:p0400:b004:l021","ordinal":107572,"en":"From Kalkaman's black horse,"},{"id":"semetey-1-2013:p0400:b004:l022","ordinal":107573,"en":"Thrust at Serek as she came"},{"id":"semetey-1-2013:p0400:b004:l023","ordinal":107574,"en":"And struck him down as she swept past."},{"id":"semetey-1-2013:p0400:b004:l024","ordinal":107575,"en":"Kalkaman's black horse,"},{"id":"semetey-1-2013:p0400:b004:l025","ordinal":107576,"en":"Its watchman pierced by a spear,"},{"id":"semetey-1-2013:p0400:b004:l026","ordinal":107577,"en":"To Karacha's fierce daughter"},{"id":"semetey-1-2013:p0400:b004:l027","ordinal":107578,"en":"Fell as booty."},{"id":"semetey-1-2013:p0400:b004:l028","ordinal":107579,"en":"Khan Manas's forty dignitaries,"},{"id":"semetey-1-2013:p0400:b004:l029","ordinal":107580,"en":"Whom the twelve tribes could not bring down,"},{"id":"semetey-1-2013:p0400:b004:l030","ordinal":107581,"en":"With no one left who could withstand them,"},{"id":"semetey-1-2013:p0400:b004:l031","ordinal":107582,"en":"Told to drink water, they drank poison;"},{"id":"semetey-1-2013:p0400:b004:l032","ordinal":107583,"en":"Told to take a hat, they cut off a head;"},{"id":"semetey-1-2013:p0400:b004:l033","ordinal":107584,"en":"Told to spill blood, they spilled stomach contents."},{"id":"semetey-1-2013:p0400:b004:l034","ordinal":107585,"en":"Khan Manas's mighty warrior,"},{"id":"semetey-1-2013:p0400:b004:l035","ordinal":107586,"en":"When the watchman had thus fallen,"},{"id":"semetey-1-2013:p0400:b004:l036","ordinal":107587,"en":"They all came rushing together."},{"id":"semetey-1-2013:p0400:b004:l037","ordinal":107588,"en":"They struck the drum;"},{"id":"semetey-1-2013:p0400:b004:l038","ordinal":107589,"en":"All cried out, 'Manas!'"},{"id":"semetey-1-2013:p0400:b004:l039","ordinal":107590,"en":"Shouting face to face,"},{"id":"semetey-1-2013:p0401:b003:l001","ordinal":107591,"en":"They all arrived,"},{"id":"semetey-1-2013:p0401:b003:l002","ordinal":107592,"en":"Then raising 'Manas!' as their battle cry."},{"id":"semetey-1-2013:p0401:b003:l003","ordinal":107593,"en":"Your father Khan Manas's forty dignitaries"},{"id":"semetey-1-2013:p0401:b003:l005","ordinal":107594,"en":"And Maiden Saikal's forty warriors"},{"id":"semetey-1-2013:p0401:b003:l006","ordinal":107595,"en":"Mingled in battle."},{"id":"semetey-1-2013:p0401:b003:l007","ordinal":107596,"en":"For six days and six nights,"},{"id":"semetey-1-2013:p0401:b003:l008","ordinal":107597,"en":"On the plain of Acha-Moinok,"},{"id":"semetey-1-2013:p0401:b003:l009","ordinal":107598,"en":"They fought with spears without mercy."},{"id":"semetey-1-2013:p0401:b003:l010","ordinal":107599,"en":"Neither could take the other;"},{"id":"semetey-1-2013:p0401:b003:l011","ordinal":107600,"en":"Neither side could"},{"id":"semetey-1-2013:p0401:b003:l012","ordinal":107601,"en":"Put the other to death."},{"id":"semetey-1-2013:p0401:b003:l013","ordinal":107602,"en":"Facing one another,"},{"id":"semetey-1-2013:p0401:b003:l014","ordinal":107603,"en":"Pressing in to fight,"},{"id":"semetey-1-2013:p0401:b003:l015","ordinal":107604,"en":"While neither could overcome the other,"},{"id":"semetey-1-2013:p0401:b003:l016","ordinal":107605,"en":"Karacha's Khan Saikal"},{"id":"semetey-1-2013:p0401:b003:l017","ordinal":107606,"en":"Came charging up."},{"id":"semetey-1-2013:p0401:b003:l018","ordinal":107607,"en":"Yraman's Yrchyuul,"},{"id":"semetey-1-2013:p0401:b003:l019","ordinal":107608,"en":"Warrior Shuutu, with a hat like roof felt,"},{"id":"semetey-1-2013:p0401:b003:l020","ordinal":107609,"en":"Kyrgylchal, leader of the forty,"},{"id":"semetey-1-2013:p0401:b003:l021","ordinal":107610,"en":"Baichoro of the powerful arms,"},{"id":"semetey-1-2013:p0401:b003:l022","ordinal":107611,"en":"And Bozuul, son of Bodokhan:"},{"id":"semetey-1-2013:p0401:b003:l023","ordinal":107612,"en":"Saikal bore down upon them relentlessly."},{"id":"semetey-1-2013:p0401:b003:l024","ordinal":107613,"en":"Where she struck, seven of them"},{"id":"semetey-1-2013:p0401:b003:l025","ordinal":107614,"en":"She knocked down as she passed."},{"id":"semetey-1-2013:p0401:b003:l026","ordinal":107615,"en":"Warrior Bolot, son of Khan Ermek,"},{"id":"semetey-1-2013:p0401:b003:l027","ordinal":107616,"en":"Was Maiden Saikal's champion."},{"id":"semetey-1-2013:p0401:b003:l028","ordinal":107617,"en":"Of Khan Manas's forty dignitaries,"},{"id":"semetey-1-2013:p0401:b003:l029","ordinal":107618,"en":"The horses of those who fell,"},{"id":"semetey-1-2013:p0401:b003:l030","ordinal":107619,"en":"Warrior Bolot took as booty."},{"id":"semetey-1-2013:p0401:b003:l031","ordinal":107620,"en":"Saikal wreaked devastation;"},{"id":"semetey-1-2013:p0401:b003:l032","ordinal":107621,"en":"She unhorsed those she faced,"},{"id":"semetey-1-2013:p0401:b003:l033","ordinal":107622,"en":"And renowned Saikal took them."},{"id":"semetey-1-2013:p0401:b003:l034","ordinal":107623,"en":"With a golden forelock and tasseled belt,"},{"id":"semetey-1-2013:p0401:b003:l035","ordinal":107624,"en":"Almambet, son of Khan Azyz,"},{"id":"semetey-1-2013:p0401:b003:l036","ordinal":107625,"en":"Tall and broad-shouldered,"},{"id":"semetey-1-2013:p0401:b003:l037","ordinal":107626,"en":"Both a champion and a lion,"},{"id":"semetey-1-2013:p0401:b003:l038","ordinal":107627,"en":"Against Beezhin beyond the Four Companions' reach,"},{"id":"semetey-1-2013:p0401:b003:l039","ordinal":107628,"en":"The beloved warrior whose strength sufficed:"},{"id":"semetey-1-2013:p0401:b005:l001","ordinal":107629,"en":"Almambet's Sarala,"},{"id":"semetey-1-2013:p0401:b005:l002","ordinal":107630,"en":"With hoe-like hooves and broad haunches,"},{"id":"semetey-1-2013:p0401:b005:l003","ordinal":107631,"en":"The tulpar of wide lands,"},{"id":"semetey-1-2013:p0401:b005:l004","ordinal":107632,"en":"Stood firm in battle."},{"id":"semetey-1-2013:p0401:b005:l005","ordinal":107633,"en":"Gripping his red spear,"},{"id":"semetey-1-2013:p0401:b005:l006","ordinal":107634,"en":"With all forty choros left on foot,"},{"id":"semetey-1-2013:p0401:b005:l007","ordinal":107635,"en":"Fighting with Maiden Saikal,"},{"id":"semetey-1-2013:p0401:b005:l008","ordinal":107636,"en":"For forty-seven days your Alake"},{"id":"semetey-1-2013:p0401:b005:l009","ordinal":107637,"en":"Held out all alone."},{"id":"semetey-1-2013:p0401:b005:l010","ordinal":107638,"en":"Your Alake stood upon a summit;"},{"id":"semetey-1-2013:p0401:b005:l011","ordinal":107639,"en":"Maiden Saikal stretched out and thrust;"},{"id":"semetey-1-2013:p0401:b005:l012","ordinal":107640,"en":"Your lion Almam did not flinch."},{"id":"semetey-1-2013:p0401:b005:l013","ordinal":107641,"en":"Maiden Saikal stood upon a cliff;"},{"id":"semetey-1-2013:p0401:b005:l014","ordinal":107642,"en":"Your Alake shouted and thrust;"},{"id":"semetey-1-2013:p0401:b005:l015","ordinal":107643,"en":"Maiden Saikal did not bend."},{"id":"semetey-1-2013:p0401:b005:l016","ordinal":107644,"en":"Standing, they fought with spears;"},{"id":"semetey-1-2013:p0401:b005:l017","ordinal":107645,"en":"The spear points bent."},{"id":"semetey-1-2013:p0401:b005:l018","ordinal":107646,"en":"Drenched in dark dust,"},{"id":"semetey-1-2013:p0401:b005:l019","ordinal":107647,"en":"They fought without retreat."},{"id":"semetey-1-2013:p0401:b005:l020","ordinal":107648,"en":"The spears they fought with shattered;"},{"id":"semetey-1-2013:p0401:b005:l021","ordinal":107649,"en":"Earth flew, tinder burned;"},{"id":"semetey-1-2013:p0401:b005:l022","ordinal":107650,"en":"Spears broke under the strain."},{"id":"semetey-1-2013:p0401:b005:l023","ordinal":107651,"en":"Almambet, your father's sworn brother,"},{"id":"semetey-1-2013:p0401:b005:l024","ordinal":107652,"en":"Fought with spears for sixty days"},{"id":"semetey-1-2013:p0401:b005:l025","ordinal":107653,"en":"And held out against Maiden Saikal."},{"id":"semetey-1-2013:p0401:b005:l026","ordinal":107654,"en":"Almambet, your father's sworn brother,"},{"id":"semetey-1-2013:p0401:b005:l027","ordinal":107655,"en":"Then setting his wounded pride aside,"},{"id":"semetey-1-2013:p0401:b005:l028","ordinal":107656,"en":"'Give me six days' grace,'"},{"id":"semetey-1-2013:p0401:b005:l029","ordinal":107657,"en":"He asked Maiden Saikal."},{"id":"semetey-1-2013:p0401:b005:l030","ordinal":107658,"en":"She agreed to his request;"},{"id":"semetey-1-2013:p0401:b005:l031","ordinal":107659,"en":"Khan Saikal, daughter of Khan Karacha,"},{"id":"semetey-1-2013:p0401:b005:l032","ordinal":107660,"en":"Granted six days' grace."},{"id":"semetey-1-2013:p0401:b005:l033","ordinal":107661,"en":"Then Almambet"},{"id":"semetey-1-2013:p0401:b005:l034","ordinal":107662,"en":"Came to his generous hero."},{"id":"semetey-1-2013:p0401:b005:l035","ordinal":107663,"en":"'My generous one, Manas, hear my words."},{"id":"semetey-1-2013:p0401:b005:l036","ordinal":107664,"en":"In many places I have waded through embers;"},{"id":"semetey-1-2013:p0401:b005:l037","ordinal":107665,"en":"On campaigns I have crossed thick showers of shot."},{"id":"semetey-1-2013:p0401:b005:l038","ordinal":107666,"en":"I have seen dark pits dug;"},{"id":"semetey-1-2013:p0401:b005:l039","ordinal":107667,"en":"I have seen misery set to boil."},{"id":"semetey-1-2013:p0402:b003:l001","ordinal":107668,"en":"I have faced foes in many places,"},{"id":"semetey-1-2013:p0402:b003:l002","ordinal":107669,"en":"Yet here I have come to this."},{"id":"semetey-1-2013:p0402:b003:l003","ordinal":107670,"en":"I was struck on my vulnerable side."},{"id":"semetey-1-2013:p0402:b003:l004","ordinal":107671,"en":"The forty mighty warriors lost their mounts;"},{"id":"semetey-1-2013:p0402:b003:l005","ordinal":107672,"en":"I let them all be taken."},{"id":"semetey-1-2013:p0402:b003:l006","ordinal":107673,"en":"I have seen a pass of hellish hardship;"},{"id":"semetey-1-2013:p0402:b003:l007","ordinal":107674,"en":"I have seen a lion among women."},{"id":"semetey-1-2013:p0402:b003:l008","ordinal":107675,"en":"One who could throw the whole world into turmoil,"},{"id":"semetey-1-2013:p0402:b003:l009","ordinal":107676,"en":"I have seen a surpassing champion warrior.'"},{"id":"semetey-1-2013:p0402:b003:l010","ordinal":107677,"en":"After Almambet said this,"},{"id":"semetey-1-2013:p0402:b003:l011","ordinal":107678,"en":"Your father Khan Manas, the beloved lion,"},{"id":"semetey-1-2013:p0402:b003:l012","ordinal":107679,"en":"Raised a tumult."},{"id":"semetey-1-2013:p0402:b003:l013","ordinal":107680,"en":"Khan Bakai and Almambet,"},{"id":"semetey-1-2013:p0402:b003:l014","ordinal":107681,"en":"Both together, warrior Manas"},{"id":"semetey-1-2013:p0402:b003:l015","ordinal":107682,"en":"Nearly swallowed them whole."},{"id":"semetey-1-2013:p0402:b003:l016","ordinal":107683,"en":"'When I was in Talas,"},{"id":"semetey-1-2013:p0402:b003:l017","ordinal":107684,"en":"Think of it, O my Almam:"},{"id":"semetey-1-2013:p0402:b003:l018","ordinal":107685,"en":"I went about eating slices of horse rump."},{"id":"semetey-1-2013:p0402:b003:l019","ordinal":107686,"en":"Not merely a bitch, but the Kalmaks,"},{"id":"semetey-1-2013:p0402:b003:l020","ordinal":107687,"en":"I thought I would grind to powder."},{"id":"semetey-1-2013:p0402:b003:l021","ordinal":107688,"en":"I went about eating slices of horse-belly fat."},{"id":"semetey-1-2013:p0402:b003:l022","ordinal":107689,"en":"My supports, Bakai and Almambet,"},{"id":"semetey-1-2013:p0402:b003:l023","ordinal":107690,"en":"If both stood beside me,"},{"id":"semetey-1-2013:p0402:b003:l024","ordinal":107691,"en":"Not merely a woman, precious souls,"},{"id":"semetey-1-2013:p0402:b003:l025","ordinal":107692,"en":"I thought I would destroy the kaldai."},{"id":"semetey-1-2013:p0402:b003:l026","ordinal":107693,"en":"With dark spear and Zhoibolot,"},{"id":"semetey-1-2013:p0402:b003:l027","ordinal":107694,"en":"I thought I would clash in battle."},{"id":"semetey-1-2013:p0402:b003:l028","ordinal":107695,"en":"Not merely a woman, but the Chinese,"},{"id":"semetey-1-2013:p0402:b003:l029","ordinal":107696,"en":"I thought I would grapple with them."},{"id":"semetey-1-2013:p0402:b003:l030","ordinal":107697,"en":"If my precious self remained alive,"},{"id":"semetey-1-2013:p0402:b003:l031","ordinal":107698,"en":"With you two, my supports, there,"},{"id":"semetey-1-2013:p0402:b003:l032","ordinal":107699,"en":"If I bound up Ak-kula's tail,"},{"id":"semetey-1-2013:p0402:b003:l033","ordinal":107700,"en":"I used to think my horse would prevail."},{"id":"semetey-1-2013:p0402:b003:l034","ordinal":107701,"en":"Not merely a woman, but so many others,"},{"id":"semetey-1-2013:p0402:b003:l035","ordinal":107702,"en":"If my support Almambet stood beside me,"},{"id":"semetey-1-2013:p0402:b003:l036","ordinal":107703,"en":"I used to think my claim would prevail."},{"id":"semetey-1-2013:p0402:b003:l037","ordinal":107704,"en":"Pah, pah, pah, my Almam, let the night hear it;"},{"id":"semetey-1-2013:p0402:b003:l038","ordinal":107705,"en":"Who should hear those gloomy words of yours, my Almam?"},{"id":"semetey-1-2013:p0402:b004:l001","ordinal":107706,"en":"Let the deep dug pit hear them;"},{"id":"semetey-1-2013:p0402:b004:l002","ordinal":107707,"en":"Let the misery set to boil hear them, my Almam."},{"id":"semetey-1-2013:p0402:b004:l003","ordinal":107708,"en":"Let the rushing water hear them;"},{"id":"semetey-1-2013:p0402:b004:l004","ordinal":107709,"en":"Those words of yours,"},{"id":"semetey-1-2013:p0402:b004:l005","ordinal":107710,"en":"Let the cliff with its high pass hear them."},{"id":"semetey-1-2013:p0402:b004:l006","ordinal":107711,"en":"Let the dark dug grave hear them;"},{"id":"semetey-1-2013:p0402:b004:l007","ordinal":107712,"en":"Who else should hear them?"},{"id":"semetey-1-2013:p0402:b004:l008","ordinal":107713,"en":"Pah, pah, my Almam, death is certain."},{"id":"semetey-1-2013:p0402:b004:l009","ordinal":107714,"en":"Defeated by a wretched girl,"},{"id":"semetey-1-2013:p0402:b004:l010","ordinal":107715,"en":"Perhaps our fortune has broken!'"},{"id":"semetey-1-2013:p0402:b004:l011","ordinal":107716,"en":"Khan Manas grew furious,"},{"id":"semetey-1-2013:p0402:b004:l012","ordinal":107717,"en":"Girded his waist tightly,"},{"id":"semetey-1-2013:p0402:b004:l013","ordinal":107718,"en":"Cried out, praying for faith,"},{"id":"semetey-1-2013:p0402:b004:l014","ordinal":107719,"en":"Sullen with grief,"},{"id":"semetey-1-2013:p0402:b004:l015","ordinal":107720,"en":"His eyes blazed like fire."},{"id":"semetey-1-2013:p0402:b004:l016","ordinal":107721,"en":"His great teeth, broad as doors,"},{"id":"semetey-1-2013:p0402:b004:l017","ordinal":107722,"en":"He clenched and ground hard."},{"id":"semetey-1-2013:p0402:b004:l018","ordinal":107723,"en":"Bloodlust truly seized him;"},{"id":"semetey-1-2013:p0402:b004:l019","ordinal":107724,"en":"Startled, he said his prayers."},{"id":"semetey-1-2013:p0402:b004:l020","ordinal":107725,"en":"The foal of a young mare,"},{"id":"semetey-1-2013:p0402:b004:l021","ordinal":107726,"en":"The Duldul of the horse herds,"},{"id":"semetey-1-2013:p0402:b004:l022","ordinal":107727,"en":"Ak-kula, he saddled."},{"id":"semetey-1-2013:p0402:b004:l023","ordinal":107728,"en":"He strapped on Zulpukor"},{"id":"semetey-1-2013:p0402:b004:l024","ordinal":107729,"en":"And made his weapons ready."},{"id":"semetey-1-2013:p0402:b004:l025","ordinal":107730,"en":"The beloved lion, like a rooster,"},{"id":"semetey-1-2013:p0402:b004:l026","ordinal":107731,"en":"Lamented in sorrow, burning within."},{"id":"semetey-1-2013:p0402:b004:l027","ordinal":107732,"en":"Agitated, unable to stand still,"},{"id":"semetey-1-2013:p0402:b004:l028","ordinal":107733,"en":"He made ready in his wrath."},{"id":"semetey-1-2013:p0402:b004:l029","ordinal":107734,"en":"Your leopard father mounted;"},{"id":"semetey-1-2013:p0402:b004:l030","ordinal":107735,"en":"Toward Karacha's Saikal,"},{"id":"semetey-1-2013:p0402:b004:l031","ordinal":107736,"en":"He set out to thrust his spear,"},{"id":"semetey-1-2013:p0402:b004:l032","ordinal":107737,"en":"The swift horses of the forty dignitaries,"},{"id":"semetey-1-2013:p0402:b004:l033","ordinal":107738,"en":"If the chance came, from Saikal"},{"id":"semetey-1-2013:p0402:b004:l034","ordinal":107739,"en":"To win them back,"},{"id":"semetey-1-2013:p0402:b004:l035","ordinal":107740,"en":"To gather khojas and mullahs,"},{"id":"semetey-1-2013:p0402:b004:l036","ordinal":107741,"en":"And, if he could overcome Saikal,"},{"id":"semetey-1-2013:p0402:b004:l037","ordinal":107742,"en":"To solemnize their marriage at high noon."},{"id":"semetey-1-2013:p0402:b004:l038","ordinal":107743,"en":"Furious, making ready,"},{"id":"semetey-1-2013:p0402:b004:l039","ordinal":107744,"en":"Toward Karacha's Saikal,"},{"id":"semetey-1-2013:p0403:b003:l001","ordinal":107745,"en":"Your leopard father rode out."},{"id":"semetey-1-2013:p0403:b003:l002","ordinal":107746,"en":"Seven banners brought from Mecca,"},{"id":"semetey-1-2013:p0403:b003:l003","ordinal":107747,"en":"He had set in seven places."},{"id":"semetey-1-2013:p0403:b003:l004","ordinal":107748,"en":"A white-gray mare brought from the Kyrgyz,"},{"id":"semetey-1-2013:p0403:b003:l005","ordinal":107749,"en":"He had led before him."},{"id":"semetey-1-2013:p0403:b003:l006","ordinal":107750,"en":"Your outstanding father Manas"},{"id":"semetey-1-2013:p0403:b003:l007","ordinal":107751,"en":"Had it offered as a moon-hoofed sacrifice."},{"id":"semetey-1-2013:p0403:b003:l008","ordinal":107752,"en":"He had the war drum beaten;"},{"id":"semetey-1-2013:p0403:b003:l009","ordinal":107753,"en":"He had the great drum struck."},{"id":"semetey-1-2013:p0403:b003:l010","ordinal":107754,"en":"The hearts of those who saw were shaken;"},{"id":"semetey-1-2013:p0403:b003:l011","ordinal":107755,"en":"Your fierce father loomed like an immense mountain."},{"id":"semetey-1-2013:p0403:b003:l012","ordinal":107756,"en":"Through haze upon the saddle-shaped ridge,"},{"id":"semetey-1-2013:p0403:b003:l013","ordinal":107757,"en":"He bent forward, scouting his way."},{"id":"semetey-1-2013:p0403:b003:l014","ordinal":107758,"en":"Against Karacha's Saikal,"},{"id":"semetey-1-2013:p0403:b003:l015","ordinal":107759,"en":"Your leopard father attacked."},{"id":"semetey-1-2013:p0403:b003:l016","ordinal":107760,"en":"They took turns thrusting spears;"},{"id":"semetey-1-2013:p0403:b003:l017","ordinal":107761,"en":"Karacha's Saikal"},{"id":"semetey-1-2013:p0403:b003:l018","ordinal":107762,"en":"The two exhausted one another."},{"id":"semetey-1-2013:p0403:b003:l019","ordinal":107763,"en":"Shouting, they thrust their spears;"},{"id":"semetey-1-2013:p0403:b003:l020","ordinal":107764,"en":"Neither could overcome the other."},{"id":"semetey-1-2013:p0403:b003:l021","ordinal":107765,"en":"Almambet and Bakai were not there;"},{"id":"semetey-1-2013:p0403:b003:l022","ordinal":107766,"en":"Your father fought alone."},{"id":"semetey-1-2013:p0403:b003:l023","ordinal":107767,"en":"Day and night, for many days,"},{"id":"semetey-1-2013:p0403:b003:l024","ordinal":107768,"en":"Neither could overcome the other."},{"id":"semetey-1-2013:p0403:b003:l025","ordinal":107769,"en":"When they went downhill,"},{"id":"semetey-1-2013:p0403:b003:l026","ordinal":107770,"en":"At Karacha's Saikal,"},{"id":"semetey-1-2013:p0403:b003:l027","ordinal":107771,"en":"Your father the khan struck five times,"},{"id":"semetey-1-2013:p0403:b003:l028","ordinal":107772,"en":"Breaking five spears in succession."},{"id":"semetey-1-2013:p0403:b003:l029","ordinal":107773,"en":"From the spur where the mountain ended,"},{"id":"semetey-1-2013:p0403:b003:l030","ordinal":107774,"en":"At your father, blood-shedding Khan Manas,"},{"id":"semetey-1-2013:p0403:b003:l031","ordinal":107775,"en":"Saikal came and struck four times,"},{"id":"semetey-1-2013:p0403:b003:l032","ordinal":107776,"en":"Breaking four spears in succession."}]
