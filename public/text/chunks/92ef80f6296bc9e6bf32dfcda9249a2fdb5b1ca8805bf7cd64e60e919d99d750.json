[{"id":"semetey-2-2013:p0022:b004:l039","ordinal":186881,"en":"Was seventy years of age."},{"id":"semetey-2-2013:p0023:b003:l001","ordinal":186882,"en":"Unless not a handspan of rein remained,"},{"id":"semetey-2-2013:p0023:b003:l002","ordinal":186883,"en":"Unless forty disasters struck,"},{"id":"semetey-2-2013:p0023:b003:l003","ordinal":186884,"en":"He would not let his rider be taken by the enemy."},{"id":"semetey-2-2013:p0023:b003:l004","ordinal":186885,"en":"Such was this Black Horse."},{"id":"semetey-2-2013:p0023:b003:l005","ordinal":186886,"en":"Born in the desert and raised among stones,"},{"id":"semetey-2-2013:p0023:b003:l006","ordinal":186887,"en":"The accursed one never became desert-worn;"},{"id":"semetey-2-2013:p0023:b003:l007","ordinal":186888,"en":"Raised apart by the unseen,"},{"id":"semetey-2-2013:p0023:b003:l008","ordinal":186889,"en":"The accursed one, in his third year,"},{"id":"semetey-2-2013:p0023:b003:l009","ordinal":186890,"en":"Raced with the kulan."},{"id":"semetey-2-2013:p0023:b003:l010","ordinal":186891,"en":"Have you heard of it?"},{"id":"semetey-2-2013:p0023:b003:l011","ordinal":186892,"en":"Kyz Saikal, daughter of Karacha Khan—"},{"id":"semetey-2-2013:p0023:b003:l012","ordinal":186893,"en":"The horse Kyz Saikal rode,"},{"id":"semetey-2-2013:p0023:b003:l013","ordinal":186894,"en":"The mighty tulpar Algara,"},{"id":"semetey-2-2013:p0023:b003:l014","ordinal":186895,"en":"Was born together with him."},{"id":"semetey-2-2013:p0023:b003:l015","ordinal":186896,"en":"When his mouth was released,"},{"id":"semetey-2-2013:p0023:b003:l016","ordinal":186897,"en":"When urged forward with a burst,"},{"id":"semetey-2-2013:p0023:b003:l017","ordinal":186898,"en":"He had a way of turning into an arrow."},{"id":"semetey-2-2013:p0023:b003:l018","ordinal":186899,"en":"When your uncle tells it,"},{"id":"semetey-2-2013:p0023:b003:l019","ordinal":186900,"en":"His tale has no end."},{"id":"semetey-2-2013:p0023:b003:l020","ordinal":186901,"en":"Such was Algara."},{"id":"semetey-2-2013:p0023:b003:l021","ordinal":186902,"en":"His tail and mane were no common things;"},{"id":"semetey-2-2013:p0023:b003:l022","ordinal":186903,"en":"Apart from hero Kalcha,"},{"id":"semetey-2-2013:p0023:b003:l023","ordinal":186904,"en":"No mortal ever rode him."},{"id":"semetey-2-2013:p0023:b003:l024","ordinal":186905,"en":"When he entered a crisis"},{"id":"semetey-2-2013:p0023:b003:l025","ordinal":186906,"en":"And opened his mouth,"},{"id":"semetey-2-2013:p0023:b003:l026","ordinal":186907,"en":"The beast flew roaring like a cloud;"},{"id":"semetey-2-2013:p0023:b003:l027","ordinal":186908,"en":"When stone touched his hoof,"},{"id":"semetey-2-2013:p0023:b003:l028","ordinal":186909,"en":"It burst apart layer by layer."},{"id":"semetey-2-2013:p0023:b003:l029","ordinal":186910,"en":"When angrily urged forward,"},{"id":"semetey-2-2013:p0023:b003:l030","ordinal":186911,"en":"His flesh separated like a sheep's,"},{"id":"semetey-2-2013:p0023:b003:l031","ordinal":186912,"en":"And his back straightened like a broad ridge."},{"id":"semetey-2-2013:p0023:b003:l032","ordinal":186913,"en":"When Kongurbai grew impassioned,"},{"id":"semetey-2-2013:p0023:b003:l033","ordinal":186914,"en":"He tied on his berenji waist-armor;"},{"id":"semetey-2-2013:p0023:b003:l034","ordinal":186915,"en":"The great Black Horse, swiftest of steeds,"},{"id":"semetey-2-2013:p0023:b003:l035","ordinal":186916,"en":"Circled Beijing of the Kakanchin"},{"id":"semetey-2-2013:p0023:b003:l036","ordinal":186917,"en":"In twelve days."},{"id":"semetey-2-2013:p0023:b003:l037","ordinal":186918,"en":"If you ride, the Black Horse is that steed;"},{"id":"semetey-2-2013:p0023:b003:l038","ordinal":186919,"en":"From the speed of this beast,"},{"id":"semetey-2-2013:p0023:b003:l039","ordinal":186920,"en":"In a fierce spear fight,"},{"id":"semetey-2-2013:p0023:b004:l001","ordinal":186921,"en":"Yesterday, when the clash came,"},{"id":"semetey-2-2013:p0023:b004:l002","ordinal":186922,"en":"Within the fortress"},{"id":"semetey-2-2013:p0023:b004:l003","ordinal":186923,"en":"Where your father gray-wolf Manas fought,"},{"id":"semetey-2-2013:p0023:b004:l004","ordinal":186924,"en":"When he entered dire straits,"},{"id":"semetey-2-2013:p0023:b004:l005","ordinal":186925,"en":"In the forty-day desert,"},{"id":"semetey-2-2013:p0023:b004:l006","ordinal":186926,"en":"Your khan father's Aimanboz,"},{"id":"semetey-2-2013:p0023:b004:l007","ordinal":186927,"en":"After going six days without water,"},{"id":"semetey-2-2013:p0023:b004:l008","ordinal":186928,"en":"Yesterday could travel no farther."},{"id":"semetey-2-2013:p0023:b004:l009","ordinal":186929,"en":"Six thousand Chinese and countless kaldays,"},{"id":"semetey-2-2013:p0023:b004:l010","ordinal":186930,"en":"With white-bearded Kongurbai,"},{"id":"semetey-2-2013:p0023:b004:l011","ordinal":186931,"en":"Shouted and leveled their spears;"},{"id":"semetey-2-2013:p0023:b004:l012","ordinal":186932,"en":"All the Chinese and many Manchus"},{"id":"semetey-2-2013:p0023:b004:l013","ordinal":186933,"en":"Surrounded your oceanlike gray-wolf father."},{"id":"semetey-2-2013:p0023:b004:l014","ordinal":186934,"en":"At a loss and alarmed,"},{"id":"semetey-2-2013:p0023:b004:l015","ordinal":186935,"en":"When Aimanboz turned his head,"},{"id":"semetey-2-2013:p0023:b004:l016","ordinal":186936,"en":"Saying, “What remedy can there be?”"},{"id":"semetey-2-2013:p0023:b004:l017","ordinal":186937,"en":"The gray wolf stood bereft of means."},{"id":"semetey-2-2013:p0023:b004:l018","ordinal":186938,"en":"Then gold-tressed, bright-belted"},{"id":"semetey-2-2013:p0023:b004:l019","ordinal":186939,"en":"Almambet, son of Aziz Khan,"},{"id":"semetey-2-2013:p0023:b004:l020","ordinal":186940,"en":"His companion like a star at the cairn,"},{"id":"semetey-2-2013:p0023:b004:l021","ordinal":186941,"en":"The companion of Khan Manas,"},{"id":"semetey-2-2013:p0023:b004:l022","ordinal":186942,"en":"Shared one road in reconnaissance,"},{"id":"semetey-2-2013:p0023:b004:l023","ordinal":186943,"en":"And one arm in battle;"},{"id":"semetey-2-2013:p0023:b004:l024","ordinal":186944,"en":"They shared food as comrades"},{"id":"semetey-2-2013:p0023:b004:l025","ordinal":186945,"en":"And livestock in one enclosure."},{"id":"semetey-2-2013:p0023:b004:l026","ordinal":186946,"en":"Noble Alman, gray-wolf hero,"},{"id":"semetey-2-2013:p0023:b004:l027","ordinal":186947,"en":"Mounted stake-necked Sarala,"},{"id":"semetey-2-2013:p0023:b004:l028","ordinal":186948,"en":"And made him rear in battle,"},{"id":"semetey-2-2013:p0023:b004:l029","ordinal":186949,"en":"Girded his leather belt,"},{"id":"semetey-2-2013:p0023:b004:l030","ordinal":186950,"en":"And against hero Kongurbai,"},{"id":"semetey-2-2013:p0023:b004:l031","ordinal":186951,"en":"Without making support of his kalday,"},{"id":"semetey-2-2013:p0023:b004:l032","ordinal":186952,"en":"Entered the host alone and attacked."},{"id":"semetey-2-2013:p0023:b004:l033","ordinal":186953,"en":"He arrived before the arrow;"},{"id":"semetey-2-2013:p0023:b004:l034","ordinal":186954,"en":"This Kongurbai of Alööke"},{"id":"semetey-2-2013:p0023:b004:l035","ordinal":186955,"en":"Received Almambet's spear,"},{"id":"semetey-2-2013:p0023:b004:l036","ordinal":186956,"en":"Was gravely wounded,"},{"id":"semetey-2-2013:p0023:b004:l037","ordinal":186957,"en":"And immediately fared badly:"},{"id":"semetey-2-2013:p0023:b004:l038","ordinal":186958,"en":"His backside tipped from the saddle,"},{"id":"semetey-2-2013:p0023:b004:l039","ordinal":186959,"en":"And his foot slipped from the stirrup."},{"id":"semetey-2-2013:p0024:b003:l001","ordinal":186960,"en":"As the Kalcha reeled,"},{"id":"semetey-2-2013:p0024:b003:l002","ordinal":186961,"en":"Hero Alman seized him"},{"id":"semetey-2-2013:p0024:b003:l003","ordinal":186962,"en":"From the lower skirts."},{"id":"semetey-2-2013:p0024:b003:l004","ordinal":186963,"en":"He was about to stretch him out"},{"id":"semetey-2-2013:p0024:b003:l005","ordinal":186964,"en":"And slaughter him as a sacrifice."},{"id":"semetey-2-2013:p0024:b003:l006","ordinal":186965,"en":"When the crisis came,"},{"id":"semetey-2-2013:p0024:b003:l007","ordinal":186966,"en":"This accursed Black Horse"},{"id":"semetey-2-2013:p0024:b003:l008","ordinal":186967,"en":"Turned his neck like a spirit,"},{"id":"semetey-2-2013:p0024:b003:l009","ordinal":186968,"en":"And flew like an arrow"},{"id":"semetey-2-2013:p0024:b003:l010","ordinal":186969,"en":"Across cliffs a rope-length high."},{"id":"semetey-2-2013:p0024:b003:l011","ordinal":186970,"en":"Because that Black Horse was there,"},{"id":"semetey-2-2013:p0024:b003:l012","ordinal":186971,"en":"His extinguished fire was kindled,"},{"id":"semetey-2-2013:p0024:b003:l013","ordinal":186972,"en":"And his dead soul revived."},{"id":"semetey-2-2013:p0024:b003:l014","ordinal":186973,"en":"Saying this was Kongurbai the Kalcha's horse,"},{"id":"semetey-2-2013:p0024:b003:l015","ordinal":186974,"en":"Karagul said: “My dear foal,"},{"id":"semetey-2-2013:p0024:b003:l016","ordinal":186975,"en":"Choose it and ride it."},{"id":"semetey-2-2013:p0024:b003:l017","ordinal":186976,"en":"Present it as a gift"},{"id":"semetey-2-2013:p0024:b003:l018","ordinal":186977,"en":"To your aged uncle Bakai."},{"id":"semetey-2-2013:p0024:b003:l019","ordinal":186978,"en":"That foolish hero Kongurbai"},{"id":"semetey-2-2013:p0024:b003:l020","ordinal":186979,"en":"Has no other livestock,"},{"id":"semetey-2-2013:p0024:b003:l021","ordinal":186980,"en":"No other life than this."},{"id":"semetey-2-2013:p0024:b003:l022","ordinal":186981,"en":"Once he is left horseless,"},{"id":"semetey-2-2013:p0024:b003:l023","ordinal":186982,"en":"Enter straight in and make war;"},{"id":"semetey-2-2013:p0024:b003:l024","ordinal":186983,"en":"This is what I say—afterward,"},{"id":"semetey-2-2013:p0024:b003:l025","ordinal":186984,"en":"Take that slave's head.”"},{"id":"semetey-2-2013:p0024:b003:l026","ordinal":186985,"en":"Thus Karagul then"},{"id":"semetey-2-2013:p0024:b003:l027","ordinal":186986,"en":"Set about deceiving him."},{"id":"semetey-2-2013:p0024:b003:l028","ordinal":186987,"en":"Upon the foolish son of Manas,"},{"id":"semetey-2-2013:p0024:b003:l029","ordinal":186988,"en":"Saying, “This is Kongurbai's armor,”"},{"id":"semetey-2-2013:p0024:b003:l030","ordinal":186989,"en":"He put the mail coat;"},{"id":"semetey-2-2013:p0024:b003:l031","ordinal":186990,"en":"Saying, “This is Kongurbai's horse,”"},{"id":"semetey-2-2013:p0024:b003:l032","ordinal":186991,"en":"He mounted him on great Kyyduukara."},{"id":"semetey-2-2013:p0024:b003:l033","ordinal":186992,"en":"Karagul, son of Katal,"},{"id":"semetey-2-2013:p0024:b003:l034","ordinal":186993,"en":"Revealed his monstrous nature."},{"id":"semetey-2-2013:p0024:b003:l035","ordinal":186994,"en":"The Sary-Suu of Kürpüldök—"},{"id":"semetey-2-2013:p0024:b003:l036","ordinal":186995,"en":"Here was the dark hour."},{"id":"semetey-2-2013:p0024:b003:l037","ordinal":186996,"en":"Forty ropes lowered into that water"},{"id":"semetey-2-2013:p0024:b003:l038","ordinal":186997,"en":"Would not reach its depth;"},{"id":"semetey-2-2013:p0024:b003:l039","ordinal":186998,"en":"At the ford of that water,"},{"id":"semetey-2-2013:p0024:b004:l001","ordinal":186999,"en":"Even a tulpar could not pass."},{"id":"semetey-2-2013:p0024:b004:l002","ordinal":187000,"en":"Looking toward its edge,"},{"id":"semetey-2-2013:p0024:b004:l003","ordinal":187001,"en":"There was brine rising to the knees;"},{"id":"semetey-2-2013:p0024:b004:l004","ordinal":187002,"en":"Looking toward its middle,"},{"id":"semetey-2-2013:p0024:b004:l005","ordinal":187003,"en":"There was a great excavated trench."},{"id":"semetey-2-2013:p0024:b004:l006","ordinal":187004,"en":"Your hero, brave but without sense,"},{"id":"semetey-2-2013:p0024:b004:l007","ordinal":187005,"en":"Born of a warrior,"},{"id":"semetey-2-2013:p0024:b004:l008","ordinal":187006,"en":"Entered the water like fire."},{"id":"semetey-2-2013:p0024:b004:l009","ordinal":187007,"en":"Looking behind him,"},{"id":"semetey-2-2013:p0024:b004:l010","ordinal":187008,"en":"Karagul, son of Katal—"},{"id":"semetey-2-2013:p0024:b004:l011","ordinal":187009,"en":"Here was the dark hour—"},{"id":"semetey-2-2013:p0024:b004:l012","ordinal":187010,"en":"Had remained there"},{"id":"semetey-2-2013:p0024:b004:l013","ordinal":187011,"en":"With the shaggy, sore-backed five-year-old mare."},{"id":"semetey-2-2013:p0024:b004:l014","ordinal":187012,"en":"When Semetey saw it,"},{"id":"semetey-2-2013:p0024:b004:l015","ordinal":187013,"en":"He raged in anguish,"},{"id":"semetey-2-2013:p0024:b004:l016","ordinal":187014,"en":"Pleading, “Uncle!”"},{"id":"semetey-2-2013:p0024:b004:l017","ordinal":187015,"en":"“My dear uncle,"},{"id":"semetey-2-2013:p0024:b004:l018","ordinal":187016,"en":"You dug my deep trench"},{"id":"semetey-2-2013:p0024:b004:l019","ordinal":187017,"en":"And remained on the farther bank,"},{"id":"semetey-2-2013:p0024:b004:l020","ordinal":187018,"en":"Making my misery boil."},{"id":"semetey-2-2013:p0024:b004:l021","ordinal":187019,"en":"Among that vast, desolate herd,"},{"id":"semetey-2-2013:p0024:b004:l022","ordinal":187020,"en":"Uncle, was no horse allotted to you?"},{"id":"semetey-2-2013:p0024:b004:l023","ordinal":187021,"en":"Among those many desolate possessions,"},{"id":"semetey-2-2013:p0024:b004:l024","ordinal":187022,"en":"Was no coat allotted to you?"},{"id":"semetey-2-2013:p0024:b004:l025","ordinal":187023,"en":"While there was a tulpar fit for campaigns,"},{"id":"semetey-2-2013:p0024:b004:l026","ordinal":187024,"en":"Why were you humiliated by a sore-backed nag?"},{"id":"semetey-2-2013:p0024:b004:l027","ordinal":187025,"en":"While there was a tulpar with a good gait,"},{"id":"semetey-2-2013:p0024:b004:l028","ordinal":187026,"en":"Why were you humiliated by a mare?"},{"id":"semetey-2-2013:p0024:b004:l029","ordinal":187027,"en":"When we raided"},{"id":"semetey-2-2013:p0024:b004:l030","ordinal":187028,"en":"That vast, desolate herd completely"},{"id":"semetey-2-2013:p0024:b004:l031","ordinal":187029,"en":"And set it on the right road,"},{"id":"semetey-2-2013:p0024:b004:l032","ordinal":187030,"en":"When they ask, ‘Where is your uncle,"},{"id":"semetey-2-2013:p0024:b004:l033","ordinal":187031,"en":"Your father Manas's confidant,"},{"id":"semetey-2-2013:p0024:b004:l034","ordinal":187032,"en":"His companion for the afterlife?’"},{"id":"semetey-2-2013:p0024:b004:l035","ordinal":187033,"en":"What shall I say?"},{"id":"semetey-2-2013:p0024:b004:l036","ordinal":187034,"en":"Leaving you behind and driving the herd,"},{"id":"semetey-2-2013:p0024:b004:l037","ordinal":187035,"en":"Uncle, what inheritance shall I attain?"},{"id":"semetey-2-2013:p0024:b004:l038","ordinal":187036,"en":"My dear uncle, met through providence,"},{"id":"semetey-2-2013:p0024:b004:l039","ordinal":187037,"en":"My dear, beloved uncle—"},{"id":"semetey-2-2013:p0025:b003:l001","ordinal":187038,"en":"How can I abandon him?\""},{"id":"semetey-2-2013:p0025:b003:l002","ordinal":187039,"en":"So saying, Semetey"},{"id":"semetey-2-2013:p0025:b003:l003","ordinal":187040,"en":"Pulled hard upon the reins,"},{"id":"semetey-2-2013:p0025:b003:l004","ordinal":187041,"en":"But Kyldykara, fit to be slaughtered,"},{"id":"semetey-2-2013:p0025:b003:l005","ordinal":187042,"en":"Into the roaring Sary-Suu,"},{"id":"semetey-2-2013:p0025:b003:l006","ordinal":187043,"en":"Into the heart of Sary-Suu,"},{"id":"semetey-2-2013:p0025:b003:l007","ordinal":187044,"en":"Bolted away and entered."},{"id":"semetey-2-2013:p0025:b003:l008","ordinal":187045,"en":"When he reached the water,"},{"id":"semetey-2-2013:p0025:b003:l009","ordinal":187046,"en":"He fell without staying upright."},{"id":"semetey-2-2013:p0025:b003:l010","ordinal":187047,"en":"Semetey, who had deemed himself a hero,"},{"id":"semetey-2-2013:p0025:b003:l011","ordinal":187048,"en":"Plunged headfirst into the water."},{"id":"semetey-2-2013:p0025:b003:l012","ordinal":187049,"en":"Enraged and grief-stricken,"},{"id":"semetey-2-2013:p0025:b003:l013","ordinal":187050,"en":"There amid the water, from the Black Horse,"},{"id":"semetey-2-2013:p0025:b003:l014","ordinal":187051,"en":"He was torn apart and left behind."},{"id":"semetey-2-2013:p0025:b003:l015","ordinal":187052,"en":"He bobbed along like a drifting log,"},{"id":"semetey-2-2013:p0025:b003:l016","ordinal":187053,"en":"The gray wolf's head kept dipping down."},{"id":"semetey-2-2013:p0025:b003:l017","ordinal":187054,"en":"When he wrenched his precious head up,"},{"id":"semetey-2-2013:p0025:b003:l018","ordinal":187055,"en":"At times it could be seen,"},{"id":"semetey-2-2013:p0025:b003:l019","ordinal":187056,"en":"And when it vanished, thinking, \"I am dead,\""},{"id":"semetey-2-2013:p0025:b003:l020","ordinal":187057,"en":"The gray wolf's spirit faltered."},{"id":"semetey-2-2013:p0025:b003:l021","ordinal":187058,"en":"The moonless night grew dark,"},{"id":"semetey-2-2013:p0025:b003:l022","ordinal":187059,"en":"The day when death would come had arrived."},{"id":"semetey-2-2013:p0025:b003:l023","ordinal":187060,"en":"On the farther bank stood the saddle-galled bay,"},{"id":"semetey-2-2013:p0025:b003:l024","ordinal":187061,"en":"It was Algara himself,"},{"id":"semetey-2-2013:p0025:b003:l025","ordinal":187062,"en":"For that accursed man's Black Horse"},{"id":"semetey-2-2013:p0025:b003:l026","ordinal":187063,"en":"Had taken on another form just then."},{"id":"semetey-2-2013:p0025:b003:l027","ordinal":187064,"en":"Karagul, son of Katal,"},{"id":"semetey-2-2013:p0025:b003:l028","ordinal":187065,"en":"When he saw Semetey,"},{"id":"semetey-2-2013:p0025:b003:l029","ordinal":187066,"en":"Was at that moment wearing"},{"id":"semetey-2-2013:p0025:b003:l030","ordinal":187067,"en":"A felt cloak with a golden collar."},{"id":"semetey-2-2013:p0025:b003:l031","ordinal":187068,"en":"With sparse tail and little mane,"},{"id":"semetey-2-2013:p0025:b003:l032","ordinal":187069,"en":"That accursed man's Black Horse"},{"id":"semetey-2-2013:p0025:b003:l033","ordinal":187070,"en":"Was the mount he rode just then."},{"id":"semetey-2-2013:p0025:b003:l034","ordinal":187071,"en":"Look closely at Karagul's conduct,"},{"id":"semetey-2-2013:p0025:b003:l035","ordinal":187072,"en":"Here is the black-hearted man."},{"id":"semetey-2-2013:p0025:b003:l036","ordinal":187073,"en":"He was an exceptionally cunning slave,"},{"id":"semetey-2-2013:p0025:b003:l037","ordinal":187074,"en":"A stratagem that men could know,"},{"id":"semetey-2-2013:p0025:b003:l038","ordinal":187075,"en":"He was a lad who knew still more."},{"id":"semetey-2-2013:p0025:b003:l039","ordinal":187076,"en":"From the ridge the wind broke loose, glowing red,"},{"id":"semetey-2-2013:p0025:b005:l001","ordinal":187077,"en":"In the sky a leaden cloud appeared,"},{"id":"semetey-2-2013:p0025:b005:l002","ordinal":187078,"en":"Mist covered the ravine,"},{"id":"semetey-2-2013:p0025:b005:l003","ordinal":187079,"en":"And hail struck upon the foothills."},{"id":"semetey-2-2013:p0025:b005:l004","ordinal":187080,"en":"Then Karagul"},{"id":"semetey-2-2013:p0025:b005:l005","ordinal":187081,"en":"Said, \"There is no living soul but me,\""},{"id":"semetey-2-2013:p0025:b005:l006","ordinal":187082,"en":"And prayed to himself."},{"id":"semetey-2-2013:p0025:b005:l007","ordinal":187083,"en":"Upon the Black Horse beneath him,"},{"id":"semetey-2-2013:p0025:b005:l008","ordinal":187084,"en":"He struck his whip this way and that,"},{"id":"semetey-2-2013:p0025:b005:l009","ordinal":187085,"en":"And spurred him on both sides."},{"id":"semetey-2-2013:p0025:b005:l010","ordinal":187086,"en":"Such was the mischief of the raging slave,"},{"id":"semetey-2-2013:p0025:b005:l011","ordinal":187087,"en":"Such was the sport he made of the boy."},{"id":"semetey-2-2013:p0025:b005:l012","ordinal":187088,"en":"Shyta Crossing, Tash Crossing—"},{"id":"semetey-2-2013:p0025:b005:l013","ordinal":187089,"en":"For that shrewd Karagul,"},{"id":"semetey-2-2013:p0025:b005:l014","ordinal":187090,"en":"It was a crossing perfectly familiar to him."},{"id":"semetey-2-2013:p0025:b005:l015","ordinal":187091,"en":"When Karagul cracked his whip,"},{"id":"semetey-2-2013:p0025:b005:l016","ordinal":187092,"en":"Could the Black Horse fail to run?"},{"id":"semetey-2-2013:p0025:b005:l017","ordinal":187093,"en":"Crushing the ground beneath his tread,"},{"id":"semetey-2-2013:p0025:b005:l018","ordinal":187094,"en":"He sprang through Tash Crossing,"},{"id":"semetey-2-2013:p0025:b005:l019","ordinal":187095,"en":"And Karagul came out."},{"id":"semetey-2-2013:p0025:b005:l020","ordinal":187096,"en":"When he had emerged from the water,"},{"id":"semetey-2-2013:p0025:b005:l021","ordinal":187097,"en":"That fine son of Katal thought:"},{"id":"semetey-2-2013:p0025:b005:l022","ordinal":187098,"en":"\"It was I who opened the road"},{"id":"semetey-2-2013:p0025:b005:l023","ordinal":187099,"en":"From Kakan to Bakburchun;"},{"id":"semetey-2-2013:p0025:b005:l024","ordinal":187100,"en":"His father, foolish Manas,"},{"id":"semetey-2-2013:p0025:b005:l025","ordinal":187101,"en":"Was a slave whom I deceived six times."},{"id":"semetey-2-2013:p0025:b005:l026","ordinal":187102,"en":"While my mighty head remains,"},{"id":"semetey-2-2013:p0025:b005:l027","ordinal":187103,"en":"How could I give up my swift horse?"},{"id":"semetey-2-2013:p0025:b005:l028","ordinal":187104,"en":"This orphan seems to have grown bold;"},{"id":"semetey-2-2013:p0025:b005:l029","ordinal":187105,"en":"I shall try trading blows with him!"},{"id":"semetey-2-2013:p0025:b005:l030","ordinal":187106,"en":"While my heroic head remains,"},{"id":"semetey-2-2013:p0025:b005:l031","ordinal":187107,"en":"How could I give up my livestock?"},{"id":"semetey-2-2013:p0025:b005:l032","ordinal":187108,"en":"This orphan has gone mad;"},{"id":"semetey-2-2013:p0025:b005:l033","ordinal":187109,"en":"I shall try grappling with him!"},{"id":"semetey-2-2013:p0025:b005:l034","ordinal":187110,"en":"Look how the fine son of the bloodthirsty man,"},{"id":"semetey-2-2013:p0025:b005:l035","ordinal":187111,"en":"Fixing his hostile gaze upon this place,"},{"id":"semetey-2-2013:p0025:b005:l036","ordinal":187112,"en":"Has come here!"},{"id":"semetey-2-2013:p0025:b005:l037","ordinal":187113,"en":"Now, before he can so much as speak"},{"id":"semetey-2-2013:p0025:b005:l038","ordinal":187114,"en":"Or utter a word before my hand,"},{"id":"semetey-2-2013:p0025:b005:l039","ordinal":187115,"en":"Just watch him die!\""},{"id":"semetey-2-2013:p0026:b003:l001","ordinal":187116,"en":"The one who reads the stars in the heavens—"},{"id":"semetey-2-2013:p0026:b003:l002","ordinal":187117,"en":"Could it happen that"},{"id":"semetey-2-2013:p0026:b003:l003","ordinal":187118,"en":"The old scourge Bakai is his companion?"},{"id":"semetey-2-2013:p0026:b003:l004","ordinal":187119,"en":"May they not reach the very end together,"},{"id":"semetey-2-2013:p0026:b003:l005","ordinal":187120,"en":"May they not drive away entirely"},{"id":"semetey-2-2013:p0026:b003:l006","ordinal":187121,"en":"Every last thoroughbred horse."},{"id":"semetey-2-2013:p0026:b003:l007","ordinal":187122,"en":"Since I am Karagul,"},{"id":"semetey-2-2013:p0026:b003:l008","ordinal":187123,"en":"I shall unleash my wrath fiercely."},{"id":"semetey-2-2013:p0026:b003:l009","ordinal":187124,"en":"The thoroughbreds ridden into battle—"},{"id":"semetey-2-2013:p0026:b003:l010","ordinal":187125,"en":"I shall cut them off and keep every one,"},{"id":"semetey-2-2013:p0026:b003:l011","ordinal":187126,"en":"Then I shall address my words"},{"id":"semetey-2-2013:p0026:b003:l012","ordinal":187127,"en":"To the foolish son of Manas."},{"id":"semetey-2-2013:p0026:b003:l013","ordinal":187128,"en":"There is no boat on the black water;"},{"id":"semetey-2-2013:p0026:b003:l014","ordinal":187129,"en":"While Algara stands beneath me,"},{"id":"semetey-2-2013:p0026:b003:l015","ordinal":187130,"en":"There is no creature who can oppose me."},{"id":"semetey-2-2013:p0026:b003:l016","ordinal":187131,"en":"I shall avenge myself for all the past."},{"id":"semetey-2-2013:p0026:b003:l017","ordinal":187132,"en":"Saying, \"I put an end"},{"id":"semetey-2-2013:p0026:b003:l018","ordinal":187133,"en":"To the infidel son of the bloodthirsty man,\""},{"id":"semetey-2-2013:p0026:b003:l019","ordinal":187134,"en":"To the khan of Kakan,"},{"id":"semetey-2-2013:p0026:b003:l020","ordinal":187135,"en":"Before Khan Kongurbai,"},{"id":"semetey-2-2013:p0026:b003:l021","ordinal":187136,"en":"I shall go to claim my glad tidings."}]
