[{"id":"semetey-1-2013:p1279:b004:l003","ordinal":173825,"en":"Those who came especially close"},{"id":"semetey-1-2013:p1279:b004:l004","ordinal":173826,"en":"Seized each other by the collar."},{"id":"semetey-1-2013:p1279:b004:l005","ordinal":173827,"en":"Keeping the battle in mind,"},{"id":"semetey-1-2013:p1279:b004:l006","ordinal":173828,"en":"They fought in utter confusion;"},{"id":"semetey-1-2013:p1279:b004:l007","ordinal":173829,"en":"When one looked, the eye could distinguish nothing."},{"id":"semetey-1-2013:p1279:b004:l008","ordinal":173830,"en":"The tumultuous battle grew immense,"},{"id":"semetey-1-2013:p1279:b004:l009","ordinal":173831,"en":"And no one could tell which side was which."},{"id":"semetey-1-2013:p1279:b004:l010","ordinal":173832,"en":"Many more stood devising plans"},{"id":"semetey-1-2013:p1279:b004:l011","ordinal":173833,"en":"And pondering words."},{"id":"semetey-1-2013:p1279:b004:l012","ordinal":173834,"en":"“Ah, wicked Aychürök,"},{"id":"semetey-1-2013:p1279:b004:l013","ordinal":173835,"en":"Until she grew old she took no husband;"},{"id":"semetey-1-2013:p1279:b004:l014","ordinal":173836,"en":"She understood none of the words spoken,"},{"id":"semetey-1-2013:p1279:b004:l015","ordinal":173837,"en":"And roamed without marrying a man;"},{"id":"semetey-1-2013:p1279:b004:l016","ordinal":173838,"en":"She never ceased stirring corruption!”"},{"id":"semetey-1-2013:p1279:b004:l017","ordinal":173839,"en":"Many more went about reviling her."},{"id":"semetey-1-2013:p1279:b004:l018","ordinal":173840,"en":"Many more stood brandishing spears"},{"id":"semetey-1-2013:p1279:b004:l019","ordinal":173841,"en":"And swaggering."},{"id":"semetey-1-2013:p1279:b004:l020","ordinal":173842,"en":"Saying, “She truly is shameless,”"},{"id":"semetey-1-2013:p1279:b004:l021","ordinal":173843,"en":"The great host and Aychürök—"},{"id":"semetey-1-2013:p1279:b004:l022","ordinal":173844,"en":"Many more fought over her."},{"id":"semetey-1-2013:p1279:b004:l023","ordinal":173845,"en":"“Since it was the khan's command,"},{"id":"semetey-1-2013:p1279:b004:l024","ordinal":173846,"en":"How could we refuse to fight?”"},{"id":"semetey-1-2013:p1279:b004:l025","ordinal":173847,"en":"So saying and exhorting one another,"},{"id":"semetey-1-2013:p1279:b004:l026","ordinal":173848,"en":"Many more strove in battle."},{"id":"semetey-1-2013:p1279:b004:l027","ordinal":173849,"en":"Black and blue, born of the same mother,"},{"id":"semetey-1-2013:p1279:b004:l028","ordinal":173850,"en":"Sparing not their mortal lives,"},{"id":"semetey-1-2013:p1279:b004:l029","ordinal":173851,"en":"Many more exchanged fire."},{"id":"semetey-1-2013:p1279:b004:l030","ordinal":173852,"en":"“If we die, so be it—we trust in fate,”"},{"id":"semetey-1-2013:p1279:b004:l031","ordinal":173853,"en":"So saying and fighting,"},{"id":"semetey-1-2013:p1279:b004:l032","ordinal":173854,"en":"Many more exchanged blows."},{"id":"semetey-1-2013:p1279:b004:l033","ordinal":173855,"en":"Those without spears"},{"id":"semetey-1-2013:p1279:b004:l034","ordinal":173856,"en":"Found other means in great numbers;"},{"id":"semetey-1-2013:p1279:b004:l035","ordinal":173857,"en":"With whips, one another"},{"id":"semetey-1-2013:p1279:b004:l036","ordinal":173858,"en":"Many more struck."},{"id":"semetey-1-2013:p1279:b004:l037","ordinal":173859,"en":"Bracing knee against knee and driving forward,"},{"id":"semetey-1-2013:p1279:b004:l038","ordinal":173860,"en":"Many more clashed."},{"id":"semetey-1-2013:p1279:b004:l039","ordinal":173861,"en":"The elders of Jediger and Afghanistan,"},{"id":"semetey-1-2013:p1280:b003:l001","ordinal":173862,"en":"All had become slaughter;"},{"id":"semetey-1-2013:p1280:b003:l002","ordinal":173863,"en":"The common people gathered,"},{"id":"semetey-1-2013:p1280:b003:l003","ordinal":173864,"en":"And in the clashing battle"},{"id":"semetey-1-2013:p1280:b003:l004","ordinal":173865,"en":"How many people were killed."},{"id":"semetey-1-2013:p1280:b003:l005","ordinal":173866,"en":"Meek men and cruel men died;"},{"id":"semetey-1-2013:p1280:b003:l006","ordinal":173867,"en":"In the upheaval that arose,"},{"id":"semetey-1-2013:p1280:b003:l007","ordinal":173868,"en":"How many people died together."},{"id":"semetey-1-2013:p1280:b003:l008","ordinal":173869,"en":"Those who survived without dying"},{"id":"semetey-1-2013:p1280:b003:l009","ordinal":173870,"en":"Staggered about wounded,"},{"id":"semetey-1-2013:p1280:b003:l010","ordinal":173871,"en":"The two fronts of their coats flapping;"},{"id":"semetey-1-2013:p1280:b003:l011","ordinal":173872,"en":"All their robes were torn,"},{"id":"semetey-1-2013:p1280:b003:l012","ordinal":173873,"en":"All the heroes hard-pressed,"},{"id":"semetey-1-2013:p1280:b003:l013","ordinal":173874,"en":"And all the people thrown into disorder."},{"id":"semetey-1-2013:p1280:b003:l014","ordinal":173875,"en":"They fought a monstrous battle,"},{"id":"semetey-1-2013:p1280:b003:l015","ordinal":173876,"en":"Standing face-to-face,"},{"id":"semetey-1-2013:p1280:b003:l016","ordinal":173877,"en":"And fought amid peril."},{"id":"semetey-1-2013:p1280:b003:l017","ordinal":173878,"en":"Let us leave that there;"},{"id":"semetey-1-2013:p1280:b003:l018","ordinal":173879,"en":"His white turban was cauldron-sized,"},{"id":"semetey-1-2013:p1280:b003:l019","ordinal":173880,"en":"And when he shouted his voice rang like the azan—"},{"id":"semetey-1-2013:p1280:b003:l020","ordinal":173881,"en":"Let us begin the tale of Akun:"},{"id":"semetey-1-2013:p1280:b003:l021","ordinal":173882,"en":"With his beard grown white,"},{"id":"semetey-1-2013:p1280:b003:l022","ordinal":173883,"en":"While strength for the journey remained,"},{"id":"semetey-1-2013:p1280:b003:l023","ordinal":173884,"en":"Khan Akun longed for the spear-fight."},{"id":"semetey-1-2013:p1280:b003:l024","ordinal":173885,"en":"He summoned the elders of the people"},{"id":"semetey-1-2013:p1280:b003:l025","ordinal":173886,"en":"And gathered them all."},{"id":"semetey-1-2013:p1280:b003:l026","ordinal":173887,"en":"Crying like a young goose,"},{"id":"semetey-1-2013:p1280:b003:l027","ordinal":173888,"en":"Hero Akun said:"},{"id":"semetey-1-2013:p1280:b003:l028","ordinal":173889,"en":"\"Let us elders gather;"},{"id":"semetey-1-2013:p1280:b003:l029","ordinal":173890,"en":"For hero Manas the lion,"},{"id":"semetey-1-2013:p1280:b003:l030","ordinal":173891,"en":"Let all of us be slain!"},{"id":"semetey-1-2013:p1280:b003:l031","ordinal":173892,"en":"He was a leopard, he was a lion;"},{"id":"semetey-1-2013:p1280:b003:l032","ordinal":173893,"en":"Your Manas who passed away"},{"id":"semetey-1-2013:p1280:b003:l033","ordinal":173894,"en":"Was a black-gray-wolf hero."},{"id":"semetey-1-2013:p1280:b003:l034","ordinal":173895,"en":"The Almighty who creates life"},{"id":"semetey-1-2013:p1280:b003:l035","ordinal":173896,"en":"Will never soon grant"},{"id":"semetey-1-2013:p1280:b003:l036","ordinal":173897,"en":"Another gray wolf like Manas."},{"id":"semetey-1-2013:p1280:b003:l037","ordinal":173898,"en":"The handful of Muslims—"},{"id":"semetey-1-2013:p1280:b003:l038","ordinal":173899,"en":"Fighting the teeming Black infidels,"},{"id":"semetey-1-2013:p1280:b003:l039","ordinal":173900,"en":"He was the hero"},{"id":"semetey-1-2013:p1280:b004:l001","ordinal":173901,"en":"Who set them free."},{"id":"semetey-1-2013:p1280:b004:l002","ordinal":173902,"en":"In Manas's absence,"},{"id":"semetey-1-2013:p1280:b004:l003","ordinal":173903,"en":"The swarming descendants"},{"id":"semetey-1-2013:p1280:b004:l004","ordinal":173904,"en":"Of Kakanchin's Beijing"},{"id":"semetey-1-2013:p1280:b004:l005","ordinal":173905,"en":"Occupied the face of the earth."},{"id":"semetey-1-2013:p1280:b004:l006","ordinal":173906,"en":"Alöökö from Margalang"},{"id":"semetey-1-2013:p1280:b004:l007","ordinal":173907,"en":"Targeted the common people in his hand,"},{"id":"semetey-1-2013:p1280:b004:l008","ordinal":173908,"en":"The Muslims."},{"id":"semetey-1-2013:p1280:b004:l009","ordinal":173909,"en":"The proof that he targeted them was this:"},{"id":"semetey-1-2013:p1280:b004:l010","ordinal":173910,"en":"In the days of Khan Alöökö,"},{"id":"semetey-1-2013:p1280:b004:l011","ordinal":173911,"en":"He exacted tribute in girls;"},{"id":"semetey-1-2013:p1280:b004:l012","ordinal":173912,"en":"Whoever resisted"},{"id":"semetey-1-2013:p1280:b004:l013","ordinal":173913,"en":"He seized then"},{"id":"semetey-1-2013:p1280:b004:l014","ordinal":173914,"en":"And slaughtered as a sacrifice."},{"id":"semetey-1-2013:p1280:b004:l015","ordinal":173915,"en":"He humiliated many,"},{"id":"semetey-1-2013:p1280:b004:l016","ordinal":173916,"en":"Dragged them along the road,"},{"id":"semetey-1-2013:p1280:b004:l017","ordinal":173917,"en":"And had the Dangyts tear them apart."},{"id":"semetey-1-2013:p1280:b004:l018","ordinal":173918,"en":"He collected tribute in gold;"},{"id":"semetey-1-2013:p1280:b004:l019","ordinal":173919,"en":"The handful of Muslims"},{"id":"semetey-1-2013:p1280:b004:l020","ordinal":173920,"en":"Were counted neither among the living"},{"id":"semetey-1-2013:p1280:b004:l021","ordinal":173921,"en":"Nor found among the dead."},{"id":"semetey-1-2013:p1280:b004:l022","ordinal":173922,"en":"Unable to find any recourse,"},{"id":"semetey-1-2013:p1280:b004:l023","ordinal":173923,"en":"The people remained wailing;"},{"id":"semetey-1-2013:p1280:b004:l024","ordinal":173924,"en":"He brought turmoil"},{"id":"semetey-1-2013:p1280:b004:l025","ordinal":173925,"en":"Upon the sons of the Muslims."},{"id":"semetey-1-2013:p1280:b004:l026","ordinal":173926,"en":"No one dared answer him;"},{"id":"semetey-1-2013:p1280:b004:l027","ordinal":173927,"en":"In Manas's absence,"},{"id":"semetey-1-2013:p1280:b004:l028","ordinal":173928,"en":"The people remained crying out."},{"id":"semetey-1-2013:p1280:b004:l029","ordinal":173929,"en":"We saw Alöökö—"},{"id":"semetey-1-2013:p1280:b004:l030","ordinal":173930,"en":"Of the wrestlers he gathered,"},{"id":"semetey-1-2013:p1280:b004:l031","ordinal":173931,"en":"Whoever provoked his anger"},{"id":"semetey-1-2013:p1280:b004:l032","ordinal":173932,"en":"Was subjected to surpassing torment."},{"id":"semetey-1-2013:p1280:b004:l033","ordinal":173933,"en":"He established a chamber of wonders,"},{"id":"semetey-1-2013:p1280:b004:l034","ordinal":173934,"en":"Where a dragon coiled."},{"id":"semetey-1-2013:p1280:b004:l035","ordinal":173935,"en":"Unable to withstand his wrath,"},{"id":"semetey-1-2013:p1280:b004:l036","ordinal":173936,"en":"Sleeping children awoke."},{"id":"semetey-1-2013:p1280:b004:l037","ordinal":173937,"en":"He demanded Margalang;"},{"id":"semetey-1-2013:p1280:b004:l038","ordinal":173938,"en":"Coming then from Beijing,"},{"id":"semetey-1-2013:p1280:b004:l039","ordinal":173939,"en":"A khan named Alöökö emerged,"},{"id":"semetey-1-2013:p1281:b003:l001","ordinal":173940,"en":"No soul could endure his judgment;"},{"id":"semetey-1-2013:p1281:b003:l002","ordinal":173941,"en":"Life left them at the sound of his voice."},{"id":"semetey-1-2013:p1281:b003:l003","ordinal":173942,"en":"Khan Alöökö was incorrigible;"},{"id":"semetey-1-2013:p1281:b003:l004","ordinal":173943,"en":"He had a fortress built"},{"id":"semetey-1-2013:p1281:b003:l005","ordinal":173944,"en":"And installed his marvel within it."},{"id":"semetey-1-2013:p1281:b003:l006","ordinal":173945,"en":"He unleashed extraordinary turmoil and strife;"},{"id":"semetey-1-2013:p1281:b003:l007","ordinal":173946,"en":"That Alöökö was incorrigible,"},{"id":"semetey-1-2013:p1281:b003:l008","ordinal":173947,"en":"And no one could answer back"},{"id":"semetey-1-2013:p1281:b003:l009","ordinal":173948,"en":"To Alöökö himself."},{"id":"semetey-1-2013:p1281:b003:l010","ordinal":173949,"en":"Again and again he seized people,"},{"id":"semetey-1-2013:p1281:b003:l011","ordinal":173950,"en":"And then cast those"},{"id":"semetey-1-2013:p1281:b003:l012","ordinal":173951,"en":"Who fell into his hands"},{"id":"semetey-1-2013:p1281:b003:l013","ordinal":173952,"en":"Into his forty-rope-deep pit."},{"id":"semetey-1-2013:p1281:b003:l014","ordinal":173953,"en":"He delivered the Muslims' punishment"},{"id":"semetey-1-2013:p1281:b003:l015","ordinal":173954,"en":"Into their own hands;"},{"id":"semetey-1-2013:p1281:b003:l016","ordinal":173955,"en":"Many people were caught"},{"id":"semetey-1-2013:p1281:b003:l017","ordinal":173956,"en":"In Alöökö's net."},{"id":"semetey-1-2013:p1281:b003:l018","ordinal":173957,"en":"The peoples of the world gathered;"},{"id":"semetey-1-2013:p1281:b003:l019","ordinal":173958,"en":"Innocent common folk"},{"id":"semetey-1-2013:p1281:b003:l020","ordinal":173959,"en":"Were persecuted and slaughtered."},{"id":"semetey-1-2013:p1281:b003:l021","ordinal":173960,"en":"When Alöökö brought suffering"},{"id":"semetey-1-2013:p1281:b003:l022","ordinal":173961,"en":"And seized control of the people,"},{"id":"semetey-1-2013:p1281:b003:l023","ordinal":173962,"en":"Hero Manas reached fifteen,"},{"id":"semetey-1-2013:p1281:b003:l024","ordinal":173963,"en":"Having been born and raised in Altai."},{"id":"semetey-1-2013:p1281:b003:l025","ordinal":173964,"en":"Everything he undertook prospered;"},{"id":"semetey-1-2013:p1281:b003:l026","ordinal":173965,"en":"He grew to maturity as a hero,"},{"id":"semetey-1-2013:p1281:b003:l027","ordinal":173966,"en":"The equal of any hero's son."},{"id":"semetey-1-2013:p1281:b003:l028","ordinal":173967,"en":"He struck and opened a road"},{"id":"semetey-1-2013:p1281:b003:l029","ordinal":173968,"en":"Through the stone house from which Alöökö ruled,"},{"id":"semetey-1-2013:p1281:b003:l030","ordinal":173969,"en":"And brought Alöökö to humiliation."},{"id":"semetey-1-2013:p1281:b003:l031","ordinal":173970,"en":"When he trod upon"},{"id":"semetey-1-2013:p1281:b003:l032","ordinal":173971,"en":"The lordly Alöökö's head,"},{"id":"semetey-1-2013:p1281:b003:l033","ordinal":173972,"en":"He seized ten thousand treasures;"},{"id":"semetey-1-2013:p1281:b003:l034","ordinal":173973,"en":"When he scattered them among the common people,"},{"id":"semetey-1-2013:p1281:b003:l035","ordinal":173974,"en":"Alöökö, who was a sorcerer,"},{"id":"semetey-1-2013:p1281:b003:l036","ordinal":173975,"en":"Fled toward Beijing."},{"id":"semetey-1-2013:p1281:b003:l037","ordinal":173976,"en":"Manas the leopard from afar"},{"id":"semetey-1-2013:p1281:b003:l038","ordinal":173977,"en":"Placed grass upon his yellow trail,"},{"id":"semetey-1-2013:p1281:b003:l039","ordinal":173978,"en":"Pursued him until he grew pale,"},{"id":"semetey-1-2013:p1281:b005:l001","ordinal":173979,"en":"And greased his inlaid spear;"},{"id":"semetey-1-2013:p1281:b005:l002","ordinal":173980,"en":"The infidel Alöökö"},{"id":"semetey-1-2013:p1281:b005:l003","ordinal":173981,"en":"He laid low at Kum-Aryk."},{"id":"semetey-1-2013:p1281:b005:l004","ordinal":173982,"en":"When he saw the horses gathered as tribute"},{"id":"semetey-1-2013:p1281:b005:l005","ordinal":173983,"en":"Were now booty,"},{"id":"semetey-1-2013:p1281:b005:l006","ordinal":173984,"en":"He divided all that treasure,"},{"id":"semetey-1-2013:p1281:b005:l007","ordinal":173985,"en":"Leaving nothing undistributed"},{"id":"semetey-1-2013:p1281:b005:l008","ordinal":173986,"en":"Among all the Muslims."},{"id":"semetey-1-2013:p1281:b005:l009","ordinal":173987,"en":"The Muslims, clan by clan,"},{"id":"semetey-1-2013:p1281:b005:l010","ordinal":173988,"en":"All shared it equally."},{"id":"semetey-1-2013:p1281:b005:l011","ordinal":173989,"en":"His heroism became known from this,"},{"id":"semetey-1-2013:p1281:b005:l012","ordinal":173990,"en":"And the common people called him Manas."},{"id":"semetey-1-2013:p1281:b005:l013","ordinal":173991,"en":"At Kökötöi's feast,"},{"id":"semetey-1-2013:p1281:b005:l014","ordinal":173992,"en":"Before the great gathering,"},{"id":"semetey-1-2013:p1281:b005:l015","ordinal":173993,"en":"When they were all about to meet their end,"},{"id":"semetey-1-2013:p1281:b005:l016","ordinal":173994,"en":"When the grim Black Chinese"},{"id":"semetey-1-2013:p1281:b005:l017","ordinal":173995,"en":"Were about to engulf them entirely,"},{"id":"semetey-1-2013:p1281:b005:l018","ordinal":173996,"en":"Was it not Manas"},{"id":"semetey-1-2013:p1281:b005:l019","ordinal":173997,"en":"Who brought slaughter upon the whole world?"},{"id":"semetey-1-2013:p1281:b005:l020","ordinal":173998,"en":"Was it not Manas who freed"},{"id":"semetey-1-2013:p1281:b005:l021","ordinal":173999,"en":"The handful of Muslims"},{"id":"semetey-1-2013:p1281:b005:l022","ordinal":174000,"en":"From the Chinese?"},{"id":"semetey-1-2013:p1281:b005:l023","ordinal":174001,"en":"There is no end to the tale."},{"id":"semetey-1-2013:p1281:b005:l024","ordinal":174002,"en":"At Kökötöi's feast,"},{"id":"semetey-1-2013:p1281:b005:l025","ordinal":174003,"en":"Before the great assembly,"},{"id":"semetey-1-2013:p1281:b005:l026","ordinal":174004,"en":"He loaded gold coins on eighty camels"},{"id":"semetey-1-2013:p1281:b005:l027","ordinal":174005,"en":"And formed a marriage alliance there."},{"id":"semetey-1-2013:p1281:b005:l028","ordinal":174006,"en":"With Dubaköi and the others at their head,"},{"id":"semetey-1-2013:p1281:b005:l029","ordinal":174007,"en":"Was not the blessing given?"},{"id":"semetey-1-2013:p1281:b005:l030","ordinal":174008,"en":"For the land of the Muslims,"},{"id":"semetey-1-2013:p1281:b005:l031","ordinal":174009,"en":"Was not lion Manas then"},{"id":"semetey-1-2013:p1281:b005:l032","ordinal":174010,"en":"A father?"},{"id":"semetey-1-2013:p1281:b005:l033","ordinal":174011,"en":"Did he not bring"},{"id":"semetey-1-2013:p1281:b005:l034","ordinal":174012,"en":"Relentless upheaval?"},{"id":"semetey-1-2013:p1281:b005:l035","ordinal":174013,"en":"Did not lion Manas then"},{"id":"semetey-1-2013:p1281:b005:l036","ordinal":174014,"en":"Win equality"},{"id":"semetey-1-2013:p1281:b005:l037","ordinal":174015,"en":"For the Muslims?"},{"id":"semetey-1-2013:p1281:b005:l038","ordinal":174016,"en":"Of the lion who lived so,"},{"id":"semetey-1-2013:p1281:b005:l039","ordinal":174017,"en":"Saying, \"I shall seize his daughter-in-law,\""},{"id":"semetey-1-2013:p1282:b003:l001","ordinal":174018,"en":"Look at the deeds"},{"id":"semetey-1-2013:p1282:b003:l002","ordinal":174019,"en":"Of that accursed Kojo."},{"id":"semetey-1-2013:p1282:b003:l003","ordinal":174020,"en":"I shall not submit to what he says;"},{"id":"semetey-1-2013:p1282:b003:l004","ordinal":174021,"en":"Unless I, Khan Akun, die"},{"id":"semetey-1-2013:p1282:b003:l005","ordinal":174022,"en":"And behold the face of the other world,"},{"id":"semetey-1-2013:p1282:b003:l006","ordinal":174023,"en":"I shall not give Aichürök away."},{"id":"semetey-1-2013:p1282:b003:l007","ordinal":174024,"en":"Before I give Aichürök,"},{"id":"semetey-1-2013:p1282:b003:l008","ordinal":174025,"en":"Let me behold the face of Judgment Day."},{"id":"semetey-1-2013:p1282:b003:l009","ordinal":174026,"en":"Let me die in slaughter"},{"id":"semetey-1-2013:p1282:b003:l010","ordinal":174027,"en":"At the hands of mad Kojo and Toltoi;"},{"id":"semetey-1-2013:p1282:b003:l011","ordinal":174028,"en":"Let me face in battle"},{"id":"semetey-1-2013:p1282:b003:l012","ordinal":174029,"en":"The engulfing Zhediger;"},{"id":"semetey-1-2013:p1282:b003:l013","ordinal":174030,"en":"Let me stand as a shelter"},{"id":"semetey-1-2013:p1282:b003:l014","ordinal":174031,"en":"For Manas's only son, found late in life."},{"id":"semetey-1-2013:p1282:b003:l015","ordinal":174032,"en":"I shall open the mouth of my treasury"},{"id":"semetey-1-2013:p1282:b003:l016","ordinal":174033,"en":"And scatter abundant wealth"},{"id":"semetey-1-2013:p1282:b003:l017","ordinal":174034,"en":"And ten thousand livestock for the war."},{"id":"semetey-1-2013:p1282:b003:l018","ordinal":174035,"en":"Until the pliant reeds ripen,"},{"id":"semetey-1-2013:p1282:b003:l019","ordinal":174036,"en":"Until the blossoms of the steppe grass fly,"},{"id":"semetey-1-2013:p1282:b003:l020","ordinal":174037,"en":"Let me fight fiercely for six months"},{"id":"semetey-1-2013:p1282:b003:l021","ordinal":174038,"en":"And test our strength against them."},{"id":"semetey-1-2013:p1282:b003:l022","ordinal":174039,"en":"He is no black, rugged mountain"},{"id":"semetey-1-2013:p1282:b003:l023","ordinal":174040,"en":"Which the people cannot cross;"},{"id":"semetey-1-2013:p1282:b003:l024","ordinal":174041,"en":"Chynkojo has turned black with rage,"},{"id":"semetey-1-2013:p1282:b003:l025","ordinal":174042,"en":"But he is no enemy come from the Kalmaks."},{"id":"semetey-1-2013:p1282:b003:l026","ordinal":174043,"en":"He is no mountain with high cliffs;"},{"id":"semetey-1-2013:p1282:b003:l027","ordinal":174044,"en":"This accursed Toltoi"},{"id":"semetey-1-2013:p1282:b003:l028","ordinal":174045,"en":"Is no enemy come from China."},{"id":"semetey-1-2013:p1282:b003:l029","ordinal":174046,"en":"Saying he will marry a girl with in-laws,"},{"id":"semetey-1-2013:p1282:b003:l030","ordinal":174047,"en":"Saying he will unleash an upheaval,"},{"id":"semetey-1-2013:p1282:b003:l031","ordinal":174048,"en":"Accursed Toltoi has lost his senses."},{"id":"semetey-1-2013:p1282:b003:l032","ordinal":174049,"en":"While this worthy head remains,"},{"id":"semetey-1-2013:p1282:b003:l033","ordinal":174050,"en":"How can I surrender my child?"},{"id":"semetey-1-2013:p1282:b003:l034","ordinal":174051,"en":"The Zhediger have grown covetous;"},{"id":"semetey-1-2013:p1282:b003:l035","ordinal":174052,"en":"Let me try bringing ruin upon them."},{"id":"semetey-1-2013:p1282:b003:l036","ordinal":174053,"en":"While this dear head remains,"},{"id":"semetey-1-2013:p1282:b003:l037","ordinal":174054,"en":"How can I surrender my people?"},{"id":"semetey-1-2013:p1282:b003:l038","ordinal":174055,"en":"This swine has turned black with rage;"},{"id":"semetey-1-2013:p1282:b003:l039","ordinal":174056,"en":"Let me test myself against him.\""},{"id":"semetey-1-2013:p1282:b004:l001","ordinal":174057,"en":"He said this to the great people,"},{"id":"semetey-1-2013:p1282:b004:l002","ordinal":174058,"en":"Speaking horrors for the common folk to hear;"},{"id":"semetey-1-2013:p1282:b004:l003","ordinal":174059,"en":"He raised the pale-mottled banner,"},{"id":"semetey-1-2013:p1282:b004:l004","ordinal":174060,"en":"Shouted the cry of \"Khan Akun!\""},{"id":"semetey-1-2013:p1282:b004:l005","ordinal":174061,"en":"And his heroes formed a separate band,"},{"id":"semetey-1-2013:p1282:b004:l006","ordinal":174062,"en":"Going in apart—did you see?"},{"id":"semetey-1-2013:p1282:b004:l007","ordinal":174063,"en":"Their khan, hero Khan Akun,"},{"id":"semetey-1-2013:p1282:b004:l008","ordinal":174064,"en":"Gave courage to them all"},{"id":"semetey-1-2013:p1282:b004:l009","ordinal":174065,"en":"And advanced to face the foe—did you see?"},{"id":"semetey-1-2013:p1282:b004:l010","ordinal":174066,"en":"The renowned men were in front,"},{"id":"semetey-1-2013:p1282:b004:l011","ordinal":174067,"en":"The valiant men at the flanks;"},{"id":"semetey-1-2013:p1282:b004:l012","ordinal":174068,"en":"The fearsome men were in front,"},{"id":"semetey-1-2013:p1282:b004:l013","ordinal":174069,"en":"The lions at the flanks."},{"id":"semetey-1-2013:p1282:b004:l014","ordinal":174070,"en":"Akun went out to war,"},{"id":"semetey-1-2013:p1282:b004:l015","ordinal":174071,"en":"To face the peril,"},{"id":"semetey-1-2013:p1282:b004:l016","ordinal":174072,"en":"And the Zhediger who loved danger"},{"id":"semetey-1-2013:p1282:b004:l017","ordinal":174073,"en":"Set their faces toward battle."},{"id":"semetey-1-2013:p1282:b004:l018","ordinal":174074,"en":"They committed their bodies to the spear;"},{"id":"semetey-1-2013:p1282:b004:l019","ordinal":174075,"en":"They raised and leveled"},{"id":"semetey-1-2013:p1282:b004:l020","ordinal":174076,"en":"Their alengir bows and inlaid arrows."},{"id":"semetey-1-2013:p1282:b004:l021","ordinal":174077,"en":"For Aichürök's sake,"},{"id":"semetey-1-2013:p1282:b004:l022","ordinal":174078,"en":"They stood casting away their lives."},{"id":"semetey-1-2013:p1282:b004:l023","ordinal":174079,"en":"With dear Akun at their head,"},{"id":"semetey-1-2013:p1282:b004:l024","ordinal":174080,"en":"They came out of the city and drew apart;"}]
