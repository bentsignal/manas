[{"id":"manas-2010:p1422:b001:l001","ordinal":61441,"en":"Your herds grew, and for the people"},{"id":"manas-2010:p1422:b001:l002","ordinal":61442,"en":"You became a plane tree and a willow."},{"id":"manas-2010:p1422:b001:l003","ordinal":61443,"en":"If Manas closes his eyes,"},{"id":"manas-2010:p1422:b001:l004","ordinal":61444,"en":"The plane tree will be felled."},{"id":"manas-2010:p1422:b001:l005","ordinal":61445,"en":"The khanship you hold now"},{"id":"manas-2010:p1422:b001:l006","ordinal":61446,"en":"Will be quenched as if with water."},{"id":"manas-2010:p1422:b001:l007","ordinal":61447,"en":"Refusing to obey your word,"},{"id":"manas-2010:p1422:b001:l008","ordinal":61448,"en":"The Argyn will move elsewhere."},{"id":"manas-2010:p1422:b001:l009","ordinal":61449,"en":"Refusing to heed what you say,"},{"id":"manas-2010:p1422:b001:l010","ordinal":61450,"en":"The Nogoy will go another way."},{"id":"manas-2010:p1422:b001:l011","ordinal":61451,"en":"If I live, I shall see it: from those six dogs"},{"id":"manas-2010:p1422:b001:l012","ordinal":61452,"en":"You will suffer incurable torment."},{"id":"manas-2010:p1422:b001:l013","ordinal":61453,"en":"“Fierce-maned Manas, my morning star!”"},{"id":"manas-2010:p1422:b001:l014","ordinal":61454,"en":"You will lament then, dried-up old man,"},{"id":"manas-2010:p1422:b001:l015","ordinal":61455,"en":"And die before your appointed death!"},{"id":"manas-2010:p1422:b001:l016","ordinal":61456,"en":"Your wish unfulfilled,"},{"id":"manas-2010:p1422:b001:l017","ordinal":61457,"en":"You will wail, dried-up old man;"},{"id":"manas-2010:p1422:b001:l018","ordinal":61458,"en":"Your bones will remain unburied."},{"id":"manas-2010:p1422:b001:l019","ordinal":61459,"en":"Take heed, dried-up old man:"},{"id":"manas-2010:p1422:b001:l020","ordinal":61460,"en":"Common iron is no tempered steel."},{"id":"manas-2010:p1422:b001:l021","ordinal":61461,"en":"Do not trust them as your sons, dried-up head;"},{"id":"manas-2010:p1422:b001:l022","ordinal":61462,"en":"Your six sons are no people to support you!"},{"id":"manas-2010:p1422:b001:l023","ordinal":61463,"en":"Patched-together iron is no tempered steel;"},{"id":"manas-2010:p1422:b001:l024","ordinal":61464,"en":"Those rabid dogs are no people to support you!"},{"id":"manas-2010:p1422:b001:l025","ordinal":61465,"en":"When magnanimous Manas dies,"},{"id":"manas-2010:p1422:b001:l026","ordinal":61466,"en":"Your gold will not be worth charcoal."},{"id":"manas-2010:p1422:b001:l027","ordinal":61467,"en":"Tormenting you, those six wretches,"},{"id":"manas-2010:p1422:b001:l028","ordinal":61468,"en":"Once grown fat, will raid your camp."},{"id":"manas-2010:p1422:b001:l029","ordinal":61469,"en":"Your silver will not be worth iron."},{"id":"manas-2010:p1422:b001:l030","ordinal":61470,"en":"After your sun Manas dies,"},{"id":"manas-2010:p1422:b001:l031","ordinal":61471,"en":"Those six accursed wretches,"},{"id":"manas-2010:p1422:b001:l032","ordinal":61472,"en":"Once grown fat, will raid your people."},{"id":"manas-2010:p1422:b001:l033","ordinal":61473,"en":"Your mail will not be worth felt;"},{"id":"manas-2010:p1422:b001:l034","ordinal":61474,"en":"They will not value you at a penny."},{"id":"manas-2010:p1422:b001:l035","ordinal":61475,"en":"If the falcon closes his eyes,"},{"id":"manas-2010:p1422:b001:l036","ordinal":61476,"en":"Will your fostered foals not devour you?"},{"id":"manas-2010:p1422:b001:l037","ordinal":61477,"en":"“Stop fidgeting, useless beard!"},{"id":"manas-2010:p1422:b001:l038","ordinal":61478,"en":"Sit still!” will they not say?"},{"id":"manas-2010:p1422:b001:l039","ordinal":61479,"en":"Think, alas, dried-up old man!"},{"id":"manas-2010:p1422:b001:l040","ordinal":61480,"en":"Will those words not eat at you?"},{"id":"manas-2010:p1422:b001:l041","ordinal":61481,"en":"I do not rate a hollow as a plain;"},{"id":"manas-2010:p1422:b001:l042","ordinal":61482,"en":"I do not rate those six fellows of yours"},{"id":"manas-2010:p1423:b001:l001","ordinal":61483,"en":"As I rate your champion son Manas."},{"id":"manas-2010:p1423:b001:l002","ordinal":61484,"en":"The marten-fur cap upon your head"},{"id":"manas-2010:p1423:b001:l003","ordinal":61485,"en":"She is coming to make you toss with joy."},{"id":"manas-2010:p1423:b001:l004","ordinal":61486,"en":"Having mounted her child upon a horse,"},{"id":"manas-2010:p1423:b001:l005","ordinal":61487,"en":"Seeking your blessing from you,"},{"id":"manas-2010:p1423:b001:l006","ordinal":61488,"en":"With goodwill, bringing gold,"},{"id":"manas-2010:p1423:b001:l007","ordinal":61489,"en":"She is coming to give you joy."},{"id":"manas-2010:p1423:b001:l008","ordinal":61490,"en":"Winning your heart,"},{"id":"manas-2010:p1423:b001:l009","ordinal":61491,"en":"She is coming to set you at ease."},{"id":"manas-2010:p1423:b001:l010","ordinal":61492,"en":"Kanykey, who knows proper custom,"},{"id":"manas-2010:p1423:b001:l011","ordinal":61493,"en":"In your old age, useless beard,"},{"id":"manas-2010:p1423:b001:l012","ordinal":61494,"en":"Is coming to make you rich.”"},{"id":"manas-2010:p1423:b001:l013","ordinal":61495,"en":"(Such a senior wife as Bakdöölöt!)"},{"id":"manas-2010:p1423:b001:l014","ordinal":61496,"en":"Dear daughter-in-law Kanykey,"},{"id":"manas-2010:p1423:b001:l015","ordinal":61497,"en":"Gleaming in mail armor,"},{"id":"manas-2010:p1423:b001:l016","ordinal":61498,"en":"To ask Jakyp's blessing,"},{"id":"manas-2010:p1423:b001:l017","ordinal":61499,"en":"Came walking, radiant."},{"id":"manas-2010:p1423:b001:l018","ordinal":61500,"en":"“Khan-father, give me your blessing to receive;"},{"id":"manas-2010:p1423:b001:l019","ordinal":61501,"en":"To the son who has gone on a journey,"},{"id":"manas-2010:p1423:b001:l020","ordinal":61502,"en":"Then let me send the news—"},{"id":"manas-2010:p1423:b001:l021","ordinal":61503,"en":"Your child who has gone far away!"},{"id":"manas-2010:p1423:b001:l022","ordinal":61504,"en":"After sending word to him,"},{"id":"manas-2010:p1423:b001:l023","ordinal":61505,"en":"Semetey, whom I have cradled,"},{"id":"manas-2010:p1423:b001:l024","ordinal":61506,"en":"My morning star beside the moon,"},{"id":"manas-2010:p1423:b001:l025","ordinal":61507,"en":"My moon, my sun, my sultan,"},{"id":"manas-2010:p1423:b001:l026","ordinal":61508,"en":"My only one, whom I hold as my companion!"},{"id":"manas-2010:p1423:b001:l027","ordinal":61509,"en":"My morning star above my head,"},{"id":"manas-2010:p1423:b001:l028","ordinal":61510,"en":"My precious fur and otter at my collar,"},{"id":"manas-2010:p1423:b001:l029","ordinal":61511,"en":"The one I open my mouth to kiss,"},{"id":"manas-2010:p1423:b001:l030","ordinal":61512,"en":"The one I open my eyes to see,"},{"id":"manas-2010:p1423:b001:l031","ordinal":61513,"en":"My spring flowing through the valley,"},{"id":"manas-2010:p1423:b001:l032","ordinal":61514,"en":"My little one granted when I was near death,"},{"id":"manas-2010:p1423:b001:l033","ordinal":61515,"en":"My dark-marked hunting hawk,"},{"id":"manas-2010:p1423:b001:l034","ordinal":61516,"en":"My plane tree granted by fate,"},{"id":"manas-2010:p1423:b001:l035","ordinal":61517,"en":"My falcon among the winged,"},{"id":"manas-2010:p1423:b001:l036","ordinal":61518,"en":"My splendid steed among the four-footed—"},{"id":"manas-2010:p1423:b001:l037","ordinal":61519,"en":"I have come to ask your blessing;"},{"id":"manas-2010:p1423:b001:l038","ordinal":61520,"en":"Khan-father, I beg it of you.”"},{"id":"manas-2010:p1423:b001:l039","ordinal":61521,"en":"Thus Kanykey spoke then."},{"id":"manas-2010:p1423:b001:l040","ordinal":61522,"en":"(The gold and rubies"},{"id":"manas-2010:p1423:b001:l041","ordinal":61523,"en":"Kanykey took out and gave.)"},{"id":"manas-2010:p1423:b001:l042","ordinal":61524,"en":"Lifting her child,"},{"id":"manas-2010:p1424:b001:l001","ordinal":61525,"en":"Bowing in homage,"},{"id":"manas-2010:p1424:b001:l002","ordinal":61526,"en":"Bending to ask a blessing,"},{"id":"manas-2010:p1424:b001:l003","ordinal":61527,"en":"Kanykey stood looking at him."},{"id":"manas-2010:p1424:b001:l004","ordinal":61528,"en":"His grandfather Khan Jakyp"},{"id":"manas-2010:p1424:b001:l005","ordinal":61529,"en":"Looked over the rubies."},{"id":"manas-2010:p1424:b001:l006","ordinal":61530,"en":"Ill-intentioned Khan Jakyp,"},{"id":"manas-2010:p1424:b001:l007","ordinal":61531,"en":"To the only child Semetey,"},{"id":"manas-2010:p1424:b001:l008","ordinal":61532,"en":"Gave a half-hearted blessing."},{"id":"manas-2010:p1424:b001:l009","ordinal":61533,"en":"Receiving Jakyp's blessing,"},{"id":"manas-2010:p1424:b001:l010","ordinal":61534,"en":"Poor woman Kanykey,"},{"id":"manas-2010:p1424:b001:l011","ordinal":61535,"en":"Walking with a sway and a rustle,"},{"id":"manas-2010:p1424:b001:l012","ordinal":61536,"en":"Returned to the royal camp."},{"id":"manas-2010:p1424:b001:l013","ordinal":61537,"en":"When she reached the royal camp,"},{"id":"manas-2010:p1424:b001:l014","ordinal":61538,"en":"“Beijing where no saint would go—"},{"id":"manas-2010:p1424:b001:l015","ordinal":61539,"en":"If he stays heedlessly, he will die."},{"id":"manas-2010:p1424:b001:l016","ordinal":61540,"en":"My lord, my lion, my magnanimous one,"},{"id":"manas-2010:p1424:b001:l017","ordinal":61541,"en":"When will he return to the royal camp?"},{"id":"manas-2010:p1424:b001:l018","ordinal":61542,"en":"Beijing the Flood cannot cover—"},{"id":"manas-2010:p1424:b001:l019","ordinal":61543,"en":"If he stays there, he will die."},{"id":"manas-2010:p1424:b001:l020","ordinal":61544,"en":"My champion, sultan, leopard,"},{"id":"manas-2010:p1424:b001:l021","ordinal":61545,"en":"When will he see his wretched woman?”"},{"id":"manas-2010:p1424:b001:l022","ordinal":61546,"en":"She cried, weeping and shrieking."},{"id":"manas-2010:p1424:b001:l023","ordinal":61547,"en":"She gave six swift horses;"},{"id":"manas-2010:p1424:b001:l024","ordinal":61548,"en":"Setting him upon Taibuurul,"},{"id":"manas-2010:p1424:b001:l025","ordinal":61549,"en":"“Go back quickly!” she said."},{"id":"manas-2010:p1424:b001:l026","ordinal":61550,"en":"Entrusting the charge to Shuutu,"},{"id":"manas-2010:p1424:b001:l027","ordinal":61551,"en":"She gave him a palm-sized letter."},{"id":"manas-2010:p1424:b001:l028","ordinal":61552,"en":"While Kanykey was speaking thus,"},{"id":"manas-2010:p1424:b001:l029","ordinal":61553,"en":"Aruuke, daughter of Agynay, said:"},{"id":"manas-2010:p1424:b001:l030","ordinal":61554,"en":"“Little remains until my month is due;"},{"id":"manas-2010:p1424:b001:l031","ordinal":61555,"en":"I am about to give birth."},{"id":"manas-2010:p1424:b001:l032","ordinal":61556,"en":"From the anguish of longing,"},{"id":"manas-2010:p1424:b001:l033","ordinal":61557,"en":"Before bearing the child,"},{"id":"manas-2010:p1424:b001:l034","ordinal":61558,"en":"On the journey to Judgment Day"},{"id":"manas-2010:p1424:b001:l035","ordinal":61559,"en":"I feel I am about to depart."},{"id":"manas-2010:p1424:b001:l036","ordinal":61560,"en":"My patterned golden kerchief,"},{"id":"manas-2010:p1424:b001:l037","ordinal":61561,"en":"My champion, warrior Shuutu,"},{"id":"manas-2010:p1424:b001:l038","ordinal":61562,"en":"Take this as a gift."},{"id":"manas-2010:p1424:b001:l039","ordinal":61563,"en":"‘She is about to give birth,’ say,"},{"id":"manas-2010:p1424:b001:l040","ordinal":61564,"en":"And from my noble-born lord"},{"id":"manas-2010:p1424:b001:l041","ordinal":61565,"en":"Receive your reward for the good news!"},{"id":"manas-2010:p1424:b001:l042","ordinal":61566,"en":"The bridle kept for his horse—"},{"id":"manas-2010:p1425:b001:l001","ordinal":61567,"en":"Who knows whether boy or girl?"},{"id":"manas-2010:p1425:b001:l002","ordinal":61568,"en":"The child in the womb is nearly full-grown.”"},{"id":"manas-2010:p1425:b001:l003","ordinal":61569,"en":"Hearing this, Shuutu,"},{"id":"manas-2010:p1425:b001:l004","ordinal":61570,"en":"Mounted Buurul and made him surge,"},{"id":"manas-2010:p1425:b001:l005","ordinal":61571,"en":"Urging him like a widow bereaved,"},{"id":"manas-2010:p1425:b001:l006","ordinal":61572,"en":"Taibuurul beneath him"},{"id":"manas-2010:p1425:b001:l007","ordinal":61573,"en":"Raced with flying birds."},{"id":"manas-2010:p1425:b001:l008","ordinal":61574,"en":"The white reins tied in a rounded knot"},{"id":"manas-2010:p1425:b001:l009","ordinal":61575,"en":"Were gripped tight in his right hand."},{"id":"manas-2010:p1425:b001:l010","ordinal":61576,"en":"With exceptionally swift Buurul,"},{"id":"manas-2010:p1425:b001:l011","ordinal":61577,"en":"He struggled against the horse's mouth."},{"id":"manas-2010:p1425:b001:l012","ordinal":61578,"en":"Hooves clattered upon the ground;"},{"id":"manas-2010:p1425:b001:l013","ordinal":61579,"en":"The black steel bit"},{"id":"manas-2010:p1425:b001:l014","ordinal":61580,"en":"Clanked at his throat."},{"id":"manas-2010:p1425:b001:l015","ordinal":61581,"en":"Appearing for a moment,"},{"id":"manas-2010:p1425:b001:l016","ordinal":61582,"en":"Then vanishing as he stretched away,"},{"id":"manas-2010:p1425:b001:l017","ordinal":61583,"en":"Breaking away like blue smoke,"},{"id":"manas-2010:p1425:b001:l018","ordinal":61584,"en":"Shattering the stones he trod,"},{"id":"manas-2010:p1425:b001:l019","ordinal":61585,"en":"Speeding like a flying bird,"},{"id":"manas-2010:p1425:b001:l020","ordinal":61586,"en":"He had lost flesh."},{"id":"manas-2010:p1425:b001:l021","ordinal":61587,"en":"The extraordinary steed Taibuurul—"},{"id":"manas-2010:p1425:b001:l022","ordinal":61588,"en":"If you ask the whole account,"},{"id":"manas-2010:p1425:b001:l023","ordinal":61589,"en":"Since leaving broad Talas,"},{"id":"manas-2010:p1425:b001:l024","ordinal":61590,"en":"Traveling six days,"},{"id":"manas-2010:p1425:b001:l025","ordinal":61591,"en":"Covering much ground without holding back,"},{"id":"manas-2010:p1425:b001:l026","ordinal":61592,"en":"Near Beijing"},{"id":"manas-2010:p1425:b001:l027","ordinal":61593,"en":"Hero Shuutu had now come."},{"id":"manas-2010:p1425:b001:l028","ordinal":61594,"en":"His foresight surpassed"},{"id":"manas-2010:p1425:b001:l029","ordinal":61595,"en":"All the people of the age;"},{"id":"manas-2010:p1425:b001:l030","ordinal":61596,"en":"Kongurbay, son of Alöökö,"},{"id":"manas-2010:p1425:b001:l031","ordinal":61597,"en":"“News will come from Talas,” he thought."},{"id":"manas-2010:p1425:b001:l032","ordinal":61598,"en":"At the base of Innermost Beijing,"},{"id":"manas-2010:p1425:b001:l033","ordinal":61599,"en":"Sleeping neither at night"},{"id":"manas-2010:p1425:b001:l034","ordinal":61600,"en":"Nor resting by day,"},{"id":"manas-2010:p1425:b001:l035","ordinal":61601,"en":"Watching the roads in ambush,"},{"id":"manas-2010:p1425:b001:l036","ordinal":61602,"en":"He was lying in wait."},{"id":"manas-2010:p1425:b001:l037","ordinal":61603,"en":"“This year, on Beijing's throne,"},{"id":"manas-2010:p1425:b001:l038","ordinal":61604,"en":"The time has come for him to settle."},{"id":"manas-2010:p1425:b001:l039","ordinal":61605,"en":"The discerning woman Kanykey"},{"id":"manas-2010:p1425:b001:l040","ordinal":61606,"en":"Was a cultivator of wisdom."},{"id":"manas-2010:p1425:b001:l041","ordinal":61607,"en":"It is time for her to learn this;"},{"id":"manas-2010:p1425:b001:l042","ordinal":61608,"en":"She will send someone between them."},{"id":"manas-2010:p1426:b001:l001","ordinal":61609,"en":"From the Buruts staying in Beijing,"},{"id":"manas-2010:p1426:b001:l002","ordinal":61610,"en":"The woman will obtain news."},{"id":"manas-2010:p1426:b001:l003","ordinal":61611,"en":"If he hears word from Kanykey,"},{"id":"manas-2010:p1426:b001:l004","ordinal":61612,"en":"Manas will strengthen his defenses."},{"id":"manas-2010:p1426:b001:l005","ordinal":61613,"en":"The Chinese multitude in Beijing,"},{"id":"manas-2010:p1426:b001:l006","ordinal":61614,"en":"Even worse than this, the Buruts"},{"id":"manas-2010:p1426:b001:l007","ordinal":61615,"en":"Will cast into further trouble.”"},{"id":"manas-2010:p1426:b001:l008","ordinal":61616,"en":"So Kongurbay, khan of the shaven-headed ones,"},{"id":"manas-2010:p1426:b001:l009","ordinal":61617,"en":"Whose strength could match the whole world,"},{"id":"manas-2010:p1426:b001:l010","ordinal":61618,"en":"Whose reach extended to Beijing,"},{"id":"manas-2010:p1426:b001:l011","ordinal":61619,"en":"Had become a khan of full understanding."},{"id":"manas-2010:p1426:b001:l012","ordinal":61620,"en":"Dust rose wherever he went;"},{"id":"manas-2010:p1426:b001:l013","ordinal":61621,"en":"Lives departed at his voice."},{"id":"manas-2010:p1426:b001:l014","ordinal":61622,"en":"His cunning was great and skillful;"},{"id":"manas-2010:p1426:b001:l015","ordinal":61623,"en":"His might was beyond any man's reach."},{"id":"manas-2010:p1426:b001:l016","ordinal":61624,"en":"Everything favored him."},{"id":"manas-2010:p1426:b001:l017","ordinal":61625,"en":"Thinking over schemes and stratagems,"},{"id":"manas-2010:p1426:b001:l018","ordinal":61626,"en":"He was watching Manas in ambush."},{"id":"manas-2010:p1426:b001:l019","ordinal":61627,"en":"This year was his time to take his prize;"},{"id":"manas-2010:p1426:b001:l020","ordinal":61628,"en":"Shuutu, who came with news,"},{"id":"manas-2010:p1426:b001:l021","ordinal":61629,"en":"He was watching for."},{"id":"manas-2010:p1426:b001:l022","ordinal":61630,"en":"The Fierce One, huge as a hut,"},{"id":"manas-2010:p1426:b001:l023","ordinal":61631,"en":"Would spare nothing against Shuutu."},{"id":"manas-2010:p1426:b001:l024","ordinal":61632,"en":"When Shuutu looked carefully,"},{"id":"manas-2010:p1426:b001:l025","ordinal":61633,"en":"He lost his reason and went numb."},{"id":"manas-2010:p1426:b001:l026","ordinal":61634,"en":"When he saw Kongurbay,"},{"id":"manas-2010:p1426:b001:l027","ordinal":61635,"en":"Unable to find a single plan,"},{"id":"manas-2010:p1426:b001:l028","ordinal":61636,"en":"He stood utterly bewildered."},{"id":"manas-2010:p1426:b001:l029","ordinal":61637,"en":"When he looked at Kongurbay,"},{"id":"manas-2010:p1426:b001:l030","ordinal":61638,"en":"His eyes were like mouths of graves,"},{"id":"manas-2010:p1426:b001:l031","ordinal":61639,"en":"As though sucking in all they saw;"},{"id":"manas-2010:p1426:b001:l032","ordinal":61640,"en":"His eyes were like hollows of a lake,"},{"id":"manas-2010:p1426:b001:l033","ordinal":61641,"en":"As though swallowing all they saw."},{"id":"manas-2010:p1426:b001:l034","ordinal":61642,"en":"His nose was like a mountain ridge;"},{"id":"manas-2010:p1426:b001:l035","ordinal":61643,"en":"He himself was like Heaven above."},{"id":"manas-2010:p1426:b001:l036","ordinal":61644,"en":"Between his brows and eyelids"},{"id":"manas-2010:p1426:b001:l037","ordinal":61645,"en":"Was like a grave whose roof had fallen."},{"id":"manas-2010:p1426:b001:l038","ordinal":61646,"en":"Broad forehead, wide and flat,"},{"id":"manas-2010:p1426:b001:l039","ordinal":61647,"en":"Like a camel standing apart,"},{"id":"manas-2010:p1426:b001:l040","ordinal":61648,"en":"The war-wolf, hero Fierce One,"},{"id":"manas-2010:p1426:b001:l041","ordinal":61649,"en":"Without mercy where they met,"},{"id":"manas-2010:p1426:b001:l042","ordinal":61650,"en":"Made the steed Algara surge,"},{"id":"manas-2010:p1427:b001:l001","ordinal":61651,"en":"Urging him like a widow bereaved,"},{"id":"manas-2010:p1427:b001:l002","ordinal":61652,"en":"His eyes flashing like a tiger's,"},{"id":"manas-2010:p1427:b001:l003","ordinal":61653,"en":"His broad, door-sized teeth"},{"id":"manas-2010:p1427:b001:l004","ordinal":61654,"en":"Crackling as he clenched them,"},{"id":"manas-2010:p1427:b001:l005","ordinal":61655,"en":"Fire flashing from his eyes,"},{"id":"manas-2010:p1427:b001:l006","ordinal":61656,"en":"Wind issuing from his mouth,"},{"id":"manas-2010:p1427:b001:l007","ordinal":61657,"en":"Unable to contain his wrath,"},{"id":"manas-2010:p1427:b001:l008","ordinal":61658,"en":"Alöökö's Kongurbay,"},{"id":"manas-2010:p1427:b001:l009","ordinal":61659,"en":"Like a crag falling from a mountain,"},{"id":"manas-2010:p1427:b001:l010","ordinal":61660,"en":"Came thundering along."},{"id":"manas-2010:p1427:b001:l011","ordinal":61661,"en":"When he saw Kongurbay,"},{"id":"manas-2010:p1427:b001:l012","ordinal":61662,"en":"Shuutu, the servant bringing news,"},{"id":"manas-2010:p1427:b001:l013","ordinal":61663,"en":"Lost the strength in his arms,"},{"id":"manas-2010:p1427:b001:l014","ordinal":61664,"en":"Lost the casing of his heart."},{"id":"manas-2010:p1427:b001:l015","ordinal":61665,"en":"There was no way to turn back:"},{"id":"manas-2010:p1427:b001:l016","ordinal":61666,"en":"Kongurbay had met him head-on."},{"id":"manas-2010:p1427:b001:l017","ordinal":61667,"en":"Unable to withstand his wrath,"},{"id":"manas-2010:p1427:b001:l018","ordinal":61668,"en":"Unable to endure his heat,"},{"id":"manas-2010:p1427:b001:l019","ordinal":61669,"en":"His black rawhide whip"},{"id":"manas-2010:p1427:b001:l020","ordinal":61670,"en":"He grasped and swung around,"},{"id":"manas-2010:p1427:b001:l021","ordinal":61671,"en":"And struck Buurul, entering his fifth year,"},{"id":"manas-2010:p1427:b001:l022","ordinal":61672,"en":"Across the hocks."},{"id":"manas-2010:p1427:b001:l023","ordinal":61673,"en":"When the whip struck his hocks,"},{"id":"manas-2010:p1427:b001:l024","ordinal":61674,"en":"Taibuurul beneath him"},{"id":"manas-2010:p1427:b001:l025","ordinal":61675,"en":"Broke away like a mirage,"},{"id":"manas-2010:p1427:b001:l026","ordinal":61676,"en":"As though he had taken flight;"},{"id":"manas-2010:p1427:b001:l027","ordinal":61677,"en":"The dark earth turned over,"},{"id":"manas-2010:p1427:b001:l028","ordinal":61678,"en":"Folding away behind him."},{"id":"manas-2010:p1427:b001:l029","ordinal":61679,"en":"The face of the earth shimmered,"},{"id":"manas-2010:p1427:b001:l030","ordinal":61680,"en":"His four feet clattered;"},{"id":"manas-2010:p1427:b001:l031","ordinal":61681,"en":"No one could tell where he was,"},{"id":"manas-2010:p1427:b001:l032","ordinal":61682,"en":"His hooves never caught the ground:"},{"id":"manas-2010:p1427:b001:l033","ordinal":61683,"en":"Taibuurul went flying."},{"id":"manas-2010:p1427:b001:l034","ordinal":61684,"en":"The dark earth his hooves struck"},{"id":"manas-2010:p1427:b001:l035","ordinal":61685,"en":"Was hollowed like a hearth-pit;"},{"id":"manas-2010:p1427:b001:l036","ordinal":61686,"en":"The ground he trod crumbled,"},{"id":"manas-2010:p1427:b001:l037","ordinal":61687,"en":"And the thunder of four feet"},{"id":"manas-2010:p1427:b001:l038","ordinal":61688,"en":"Roared right overhead."},{"id":"manas-2010:p1427:b001:l039","ordinal":61689,"en":"He bolted, wild with excitement,"},{"id":"manas-2010:p1427:b001:l040","ordinal":61690,"en":"Appearing now and then,"},{"id":"manas-2010:p1427:b001:l041","ordinal":61691,"en":"Appearing, yet eluding the eye,"},{"id":"manas-2010:p1427:b001:l042","ordinal":61692,"en":"Breaking away like a cloud,"},{"id":"manas-2010:p1428:b001:l001","ordinal":61693,"en":"Taibuurul drew far ahead,"},{"id":"manas-2010:p1428:b001:l002","ordinal":61694,"en":"From a steed like Algara"},{"id":"manas-2010:p1428:b001:l003","ordinal":61695,"en":"Springing a whole calling-distance clear!"},{"id":"manas-2010:p1428:b001:l004","ordinal":61696,"en":"No wind could catch his trot:"}]
