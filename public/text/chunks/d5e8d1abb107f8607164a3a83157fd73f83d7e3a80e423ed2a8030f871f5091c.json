[{"id":"manas-2010:p1519:b001:l023","ordinal":65537,"en":"Those who spared not their own lives,"},{"id":"manas-2010:p1519:b001:l024","ordinal":65538,"en":"The outstanding ones stood apart."},{"id":"manas-2010:p1519:b001:l025","ordinal":65539,"en":"All of these,"},{"id":"manas-2010:p1519:b001:l026","ordinal":65540,"en":"With Tiken the giant at their head,"},{"id":"manas-2010:p1519:b001:l027","ordinal":65541,"en":"Like creatures struck by a lion,"},{"id":"manas-2010:p1519:b001:l028","ordinal":65542,"en":"He drove before him in pursuit."},{"id":"manas-2010:p1519:b001:l029","ordinal":65543,"en":"Shouting, “Islam!”"},{"id":"manas-2010:p1519:b001:l030","ordinal":65544,"en":"Making them start like a falcon,"},{"id":"manas-2010:p1519:b001:l031","ordinal":65545,"en":"He drove the Chinese away."},{"id":"manas-2010:p1519:b001:l032","ordinal":65546,"en":"From the kakan's Beijing,"},{"id":"manas-2010:p1519:b001:l033","ordinal":65547,"en":"The Chinese who had swept upon them"},{"id":"manas-2010:p1519:b001:l034","ordinal":65548,"en":"He drove back again."},{"id":"manas-2010:p1519:b001:l035","ordinal":65549,"en":"Through their middle, hero Syrgak"},{"id":"manas-2010:p1519:b001:l036","ordinal":65550,"en":"Went cutting and slaughtering;"},{"id":"manas-2010:p1519:b001:l037","ordinal":65551,"en":"Around their edges, Almambet"},{"id":"manas-2010:p1519:b001:l038","ordinal":65552,"en":"Went slaughtering as he rode."},{"id":"manas-2010:p1519:b001:l039","ordinal":65553,"en":"The forty companions, every one a wolf,"},{"id":"manas-2010:p1519:b001:l040","ordinal":65554,"en":"Sweeping them from forty places,"},{"id":"manas-2010:p1519:b001:l041","ordinal":65555,"en":"Drove them on, scattering them;"},{"id":"manas-2010:p1519:b001:l042","ordinal":65556,"en":"Making their heads like peas,"},{"id":"manas-2010:p1520:b001:l001","ordinal":65557,"en":"They cut them off and rode on."},{"id":"manas-2010:p1520:b001:l002","ordinal":65558,"en":"Brandishing his adze,"},{"id":"manas-2010:p1520:b001:l003","ordinal":65559,"en":"Making all he met crawl,"},{"id":"manas-2010:p1520:b001:l004","ordinal":65560,"en":"His roar splitting stones,"},{"id":"manas-2010:p1520:b001:l005","ordinal":65561,"en":"His shout splitting heads,"},{"id":"manas-2010:p1520:b001:l006","ordinal":65562,"en":"Turning back now to charge,"},{"id":"manas-2010:p1520:b001:l007","ordinal":65563,"en":"Mountain-like Tiken the giant,"},{"id":"manas-2010:p1520:b001:l008","ordinal":65564,"en":"Plunging through without stopping,"},{"id":"manas-2010:p1520:b001:l009","ordinal":65565,"en":"Spearing those he met,"},{"id":"manas-2010:p1520:b001:l010","ordinal":65566,"en":"Tiken the giant charged in."},{"id":"manas-2010:p1520:b001:l011","ordinal":65567,"en":"At once, with a roar,"},{"id":"manas-2010:p1520:b001:l012","ordinal":65568,"en":"Baychoro and Yrchy Uul,"},{"id":"manas-2010:p1520:b001:l013","ordinal":65569,"en":"Argynkan's Azhybay—"},{"id":"manas-2010:p1520:b001:l014","ordinal":65570,"en":"He reached these three."},{"id":"manas-2010:p1520:b001:l015","ordinal":65571,"en":"As soon as he reached them,"},{"id":"manas-2010:p1520:b001:l016","ordinal":65572,"en":"He sent them tumbling from their horses,"},{"id":"manas-2010:p1520:b001:l017","ordinal":65573,"en":"Knocking them down as he passed."},{"id":"manas-2010:p1520:b001:l018","ordinal":65574,"en":"When they saw Tiken the giant,"},{"id":"manas-2010:p1520:b001:l019","ordinal":65575,"en":"The great host of Burut Muslims"},{"id":"manas-2010:p1520:b001:l020","ordinal":65576,"en":"Drew back, clamoring;"},{"id":"manas-2010:p1520:b001:l021","ordinal":65577,"en":"“Now we are dead!” they wailed."},{"id":"manas-2010:p1520:b001:l022","ordinal":65578,"en":"Seeing this, the many Chinese"},{"id":"manas-2010:p1520:b001:l023","ordinal":65579,"en":"Were about to surge upon them again,"},{"id":"manas-2010:p1520:b001:l024","ordinal":65580,"en":"The three heroes fallen from their horses"},{"id":"manas-2010:p1520:b001:l025","ordinal":65581,"en":"About to bind them alive and carry them away,"},{"id":"manas-2010:p1520:b001:l026","ordinal":65582,"en":"When Akbaltay's Chubak"},{"id":"manas-2010:p1520:b001:l027","ordinal":65583,"en":"Entered alone to fight;"},{"id":"manas-2010:p1520:b001:l028","ordinal":65584,"en":"The Manchu and many Chinese before him,"},{"id":"manas-2010:p1520:b001:l029","ordinal":65585,"en":"He plunged among them, grappling."},{"id":"manas-2010:p1520:b001:l030","ordinal":65586,"en":"Fortified Beijing's"},{"id":"manas-2010:p1520:b001:l031","ordinal":65587,"en":"Support had arrived;"},{"id":"manas-2010:p1520:b001:l032","ordinal":65588,"en":"Different from the earlier ones,"},{"id":"manas-2010:p1520:b001:l033","ordinal":65589,"en":"Its people had arrived."},{"id":"manas-2010:p1520:b001:l034","ordinal":65590,"en":"The wolf-maned lion Chubak"},{"id":"manas-2010:p1520:b001:l035","ordinal":65591,"en":"They had taken into their midst."},{"id":"manas-2010:p1520:b001:l036","ordinal":65592,"en":"When Chubak was surrounded,"},{"id":"manas-2010:p1520:b001:l037","ordinal":65593,"en":"There was no one who saw it."},{"id":"manas-2010:p1520:b001:l038","ordinal":65594,"en":"Fighting each on his own side,"},{"id":"manas-2010:p1520:b001:l039","ordinal":65595,"en":"The forty companions locked in slaughter"},{"id":"manas-2010:p1520:b001:l040","ordinal":65596,"en":"Had no thought for Chubak!"},{"id":"manas-2010:p1520:b001:l041","ordinal":65597,"en":"The many Chinese gathered together;"},{"id":"manas-2010:p1520:b001:l042","ordinal":65598,"en":"The three fallen from their horses,"},{"id":"manas-2010:p1521:b001:l001","ordinal":65599,"en":"Just as they were about to bind them,"},{"id":"manas-2010:p1521:b001:l002","ordinal":65600,"en":"Azizkan's Almambet"},{"id":"manas-2010:p1521:b001:l003","ordinal":65601,"en":"And Khan Ulak's Syrgak,"},{"id":"manas-2010:p1521:b001:l004","ordinal":65602,"en":"Lions who wrought unsparing slaughter,"},{"id":"manas-2010:p1521:b001:l005","ordinal":65603,"en":"Drenched in red blood,"},{"id":"manas-2010:p1521:b001:l006","ordinal":65604,"en":"Fighting against the Chinese,"},{"id":"manas-2010:p1521:b001:l007","ordinal":65605,"en":"The three warriors standing on foot"},{"id":"manas-2010:p1521:b001:l008","ordinal":65606,"en":"They tore free and rescued."},{"id":"manas-2010:p1521:b001:l009","ordinal":65607,"en":"It was the Chinese people who surged upon them;"},{"id":"manas-2010:p1521:b001:l010","ordinal":65608,"en":"When you thought them finished, they flared up,"},{"id":"manas-2010:p1521:b001:l011","ordinal":65609,"en":"An inexhaustible multitude."},{"id":"manas-2010:p1521:b001:l012","ordinal":65610,"en":"Almambet and hero Syrgak"},{"id":"manas-2010:p1521:b001:l013","ordinal":65611,"en":"Were the Muslims' support;"},{"id":"manas-2010:p1521:b001:l014","ordinal":65612,"en":"Never giving death a thought,"},{"id":"manas-2010:p1521:b001:l015","ordinal":65613,"en":"They were lions born among men."},{"id":"manas-2010:p1521:b001:l016","ordinal":65614,"en":"Akbaltay's Chubak,"},{"id":"manas-2010:p1521:b001:l017","ordinal":65615,"en":"The shining lamp of the Burut,"},{"id":"manas-2010:p1521:b001:l018","ordinal":65616,"en":"The Chinese had taken into their midst."},{"id":"manas-2010:p1521:b001:l019","ordinal":65617,"en":"With Tiken the giant at their head,"},{"id":"manas-2010:p1521:b001:l020","ordinal":65618,"en":"They had surrounded him."},{"id":"manas-2010:p1521:b001:l021","ordinal":65619,"en":"Thousands of lances struck at once;"},{"id":"manas-2010:p1521:b001:l022","ordinal":65620,"en":"Losing his senses, he drooped."},{"id":"manas-2010:p1521:b001:l023","ordinal":65621,"en":"“Where have the warriors gone?”"},{"id":"manas-2010:p1521:b001:l024","ordinal":65622,"en":"Looking frantically on both sides,"},{"id":"manas-2010:p1521:b001:l025","ordinal":65623,"en":"He searched for your Almambet."},{"id":"manas-2010:p1521:b001:l026","ordinal":65624,"en":"“How the Chinese press upon me—"},{"id":"manas-2010:p1521:b001:l027","ordinal":65625,"en":"If only Almambet and Syrgak saw!”"},{"id":"manas-2010:p1521:b001:l028","ordinal":65626,"en":"Shaking his head and swaying,"},{"id":"manas-2010:p1521:b001:l029","ordinal":65627,"en":"Blue smoke coming from his mouth"},{"id":"manas-2010:p1521:b001:l030","ordinal":65628,"en":"Billowed like mist."},{"id":"manas-2010:p1521:b001:l031","ordinal":65629,"en":"Hero Chubak stood looking,"},{"id":"manas-2010:p1521:b001:l032","ordinal":65630,"en":"His two eyes staring helplessly."},{"id":"manas-2010:p1521:b001:l033","ordinal":65631,"en":"“While things stand thus,"},{"id":"manas-2010:p1521:b001:l034","ordinal":65632,"en":"If only Akkula turned his head,"},{"id":"manas-2010:p1521:b001:l035","ordinal":65633,"en":"If only my lion, leopard Manas,"},{"id":"manas-2010:p1521:b001:l036","ordinal":65634,"en":"Stood watching beside me!"},{"id":"manas-2010:p1521:b001:l037","ordinal":65635,"en":"Then let me die,"},{"id":"manas-2010:p1521:b001:l038","ordinal":65636,"en":"Let me suffer such humiliation!”"},{"id":"manas-2010:p1521:b001:l039","ordinal":65637,"en":"Before he had closed his mouth,"},{"id":"manas-2010:p1521:b001:l040","ordinal":65638,"en":"He came running,"},{"id":"manas-2010:p1521:b001:l041","ordinal":65639,"en":"Tiken making his rhinoceros bound."},{"id":"manas-2010:p1521:b001:l042","ordinal":65640,"en":"When Chubak saw this,"},{"id":"manas-2010:p1522:b001:l001","ordinal":65641,"en":"He despaired of his life."},{"id":"manas-2010:p1522:b001:l002","ordinal":65642,"en":"Tiken gave the Chinese an order:"},{"id":"manas-2010:p1522:b001:l003","ordinal":65643,"en":"“Shoot Chubak!” he said."},{"id":"manas-2010:p1522:b001:l004","ordinal":65644,"en":"Then all the Chinese together"},{"id":"manas-2010:p1522:b001:l005","ordinal":65645,"en":"Drew their bows like falling rain,"},{"id":"manas-2010:p1522:b001:l006","ordinal":65646,"en":"Fired their shots like hail."},{"id":"manas-2010:p1522:b001:l007","ordinal":65647,"en":"From one side, the many Chinese,"},{"id":"manas-2010:p1522:b001:l008","ordinal":65648,"en":"Drawing swords from their sheaths,"},{"id":"manas-2010:p1522:b001:l009","ordinal":65649,"en":"Grasping battle-axes by the haft,"},{"id":"manas-2010:p1522:b001:l010","ordinal":65650,"en":"Their spears swaying,"},{"id":"manas-2010:p1522:b001:l011","ordinal":65651,"en":"Surged upon him in waves."},{"id":"manas-2010:p1522:b001:l012","ordinal":65652,"en":"Then Almambet"},{"id":"manas-2010:p1522:b001:l013","ordinal":65653,"en":"And Khan Ulak's hero Syrgak said,"},{"id":"manas-2010:p1522:b001:l014","ordinal":65654,"en":"“Having come to Beijing to fight,"},{"id":"manas-2010:p1522:b001:l015","ordinal":65655,"en":"From the mighty wolf, champion Chubak,"},{"id":"manas-2010:p1522:b001:l016","ordinal":65656,"en":"If we part here,"},{"id":"manas-2010:p1522:b001:l017","ordinal":65657,"en":"How can we return to Talas?"},{"id":"manas-2010:p1522:b001:l018","ordinal":65658,"en":"We entrust ourselves to fate!” they cried."},{"id":"manas-2010:p1522:b001:l019","ordinal":65659,"en":"Unable to restrain themselves, the two lions,"},{"id":"manas-2010:p1522:b001:l020","ordinal":65660,"en":"Crying out Chubak’s name,"},{"id":"manas-2010:p1522:b001:l021","ordinal":65661,"en":"Into the Chinese as numerous as ants"},{"id":"manas-2010:p1522:b001:l022","ordinal":65662,"en":"Plunged and mingled."},{"id":"manas-2010:p1522:b001:l023","ordinal":65663,"en":"Looking, one could not see them;"},{"id":"manas-2010:p1522:b001:l024","ordinal":65664,"en":"Earth flew up in clouds of dust,"},{"id":"manas-2010:p1522:b001:l025","ordinal":65665,"en":"And no one could tell which was which."},{"id":"manas-2010:p1522:b001:l026","ordinal":65666,"en":"When wrathful Tiken the giant"},{"id":"manas-2010:p1522:b001:l027","ordinal":65667,"en":"Was about to reach hero Chubak,"},{"id":"manas-2010:p1522:b001:l028","ordinal":65668,"en":"From the back of Kögala"},{"id":"manas-2010:p1522:b001:l029","ordinal":65669,"en":"About to knock him down and pass,"},{"id":"manas-2010:p1522:b001:l030","ordinal":65670,"en":"The skilled Almambet"},{"id":"manas-2010:p1522:b001:l031","ordinal":65671,"en":"Faced Tiken the giant."},{"id":"manas-2010:p1522:b001:l032","ordinal":65672,"en":"“The edge of his broad belt,” he said,"},{"id":"manas-2010:p1522:b001:l033","ordinal":65673,"en":"“The place of his lungs and heart,” he said,"},{"id":"manas-2010:p1522:b001:l034","ordinal":65674,"en":"“The bow of his golden saddle,” he said."},{"id":"manas-2010:p1522:b001:l035","ordinal":65675,"en":"Arriving like a bullet, Almambet"},{"id":"manas-2010:p1522:b001:l036","ordinal":65676,"en":"Struck once with his lance."},{"id":"manas-2010:p1522:b001:l037","ordinal":65677,"en":"The rhinoceros beneath him"},{"id":"manas-2010:p1522:b001:l038","ordinal":65678,"en":"Stumbled as it passed;"},{"id":"manas-2010:p1522:b001:l039","ordinal":65679,"en":"The shield upon his head"},{"id":"manas-2010:p1522:b001:l040","ordinal":65680,"en":"Flew off and struck the ground."},{"id":"manas-2010:p1522:b001:l041","ordinal":65681,"en":"Then Tiken the giant,"},{"id":"manas-2010:p1522:b001:l042","ordinal":65682,"en":"The warrior slipping from his saddle,"},{"id":"manas-2010:p1523:b001:l001","ordinal":65683,"en":"His feet slipping from the stirrups,"},{"id":"manas-2010:p1523:b001:l002","ordinal":65684,"en":"As he cried, “Oh!” from his mouth"},{"id":"manas-2010:p1523:b001:l003","ordinal":65685,"en":"Blood gushed in repeated streams;"},{"id":"manas-2010:p1523:b001:l004","ordinal":65686,"en":"Strength left his body."},{"id":"manas-2010:p1523:b001:l005","ordinal":65687,"en":"Azizkan's Almambet"},{"id":"manas-2010:p1523:b001:l006","ordinal":65688,"en":"Had thrust without mercy and passed."},{"id":"manas-2010:p1523:b001:l007","ordinal":65689,"en":"The marrow and upper chamber of his heart"},{"id":"manas-2010:p1523:b001:l008","ordinal":65690,"en":"He had torn open as he went."},{"id":"manas-2010:p1523:b001:l009","ordinal":65691,"en":"Struggling for life, swaying,"},{"id":"manas-2010:p1523:b001:l010","ordinal":65692,"en":"As Tiken stood staring helplessly,"},{"id":"manas-2010:p1523:b001:l011","ordinal":65693,"en":"Syrgak reached him again."},{"id":"manas-2010:p1523:b001:l012","ordinal":65694,"en":"As soon as he arrived, Arkesken"},{"id":"manas-2010:p1523:b001:l013","ordinal":65695,"en":"The leopard drew out;"},{"id":"manas-2010:p1523:b001:l014","ordinal":65696,"en":"The champion Tiken the giant"},{"id":"manas-2010:p1523:b001:l015","ordinal":65697,"en":"He struck on the head as he passed."},{"id":"manas-2010:p1523:b001:l016","ordinal":65698,"en":"His head burst into fragments."},{"id":"manas-2010:p1523:b001:l017","ordinal":65699,"en":"When Tiken died,"},{"id":"manas-2010:p1523:b001:l018","ordinal":65700,"en":"The Chinese who stood watching"},{"id":"manas-2010:p1523:b001:l019","ordinal":65701,"en":"Sent cries that reached Heaven."},{"id":"manas-2010:p1523:b001:l020","ordinal":65702,"en":"With pale mottled and red banners,"},{"id":"manas-2010:p1523:b001:l021","ordinal":65703,"en":"All gathering and surging together,"},{"id":"manas-2010:p1523:b001:l022","ordinal":65704,"en":"They plunged into battle."},{"id":"manas-2010:p1523:b001:l023","ordinal":65705,"en":"With Kongurbay at their head,"},{"id":"manas-2010:p1523:b001:l024","ordinal":65706,"en":"They entered battle again."},{"id":"manas-2010:p1523:b001:l025","ordinal":65707,"en":"The Chinese people of forty khans,"},{"id":"manas-2010:p1523:b001:l026","ordinal":65708,"en":"When you thought they would die, increased;"},{"id":"manas-2010:p1523:b001:l027","ordinal":65709,"en":"The more they died, the stronger they grew;"},{"id":"manas-2010:p1523:b001:l028","ordinal":65710,"en":"The more they dwindled, the more they blazed;"},{"id":"manas-2010:p1523:b001:l029","ordinal":65711,"en":"Beijing grew stronger from its roots."},{"id":"manas-2010:p1523:b001:l030","ordinal":65712,"en":"Karykan sent word:"},{"id":"manas-2010:p1523:b001:l031","ordinal":65713,"en":"“Since the champion Tiken is dead,"},{"id":"manas-2010:p1523:b001:l032","ordinal":65714,"en":"Perish, all of you alike!"},{"id":"manas-2010:p1523:b001:l033","ordinal":65715,"en":"Where the Flood never burst in,"},{"id":"manas-2010:p1523:b001:l034","ordinal":65716,"en":"You multitude of Beijing's descendants,"},{"id":"manas-2010:p1523:b001:l035","ordinal":65717,"en":"Gather, every one of you!”"},{"id":"manas-2010:p1523:b001:l036","ordinal":65718,"en":"Once their khan had given his command,"},{"id":"manas-2010:p1523:b001:l037","ordinal":65719,"en":"Could they stand watching without fighting?"},{"id":"manas-2010:p1523:b001:l038","ordinal":65720,"en":"Without resting in the day,"},{"id":"manas-2010:p1523:b001:l039","ordinal":65721,"en":"Without taking a day's rest,"},{"id":"manas-2010:p1523:b001:l040","ordinal":65722,"en":"The face of the plain became dust;"},{"id":"manas-2010:p1523:b001:l041","ordinal":65723,"en":"Unbelievers and Muslims"},{"id":"manas-2010:p1523:b001:l042","ordinal":65724,"en":"Summoned their courage and fought."},{"id":"manas-2010:p1524:b001:l001","ordinal":65725,"en":"Those without courage stood bewildered,"},{"id":"manas-2010:p1524:b001:l002","ordinal":65726,"en":"Spears bent in their hands,"},{"id":"manas-2010:p1524:b001:l003","ordinal":65727,"en":"They thrust without sparing themselves."},{"id":"manas-2010:p1524:b001:l004","ordinal":65728,"en":"The wounded lay strewn everywhere,"},{"id":"manas-2010:p1524:b001:l005","ordinal":65729,"en":"And still more lay dead."},{"id":"manas-2010:p1524:b001:l006","ordinal":65730,"en":"“If this goes on, the Buruts"},{"id":"manas-2010:p1524:b001:l007","ordinal":65731,"en":"Will bring my people to their end!"},{"id":"manas-2010:p1524:b001:l008","ordinal":65732,"en":"The Chinese and Manchus"},{"id":"manas-2010:p1524:b001:l009","ordinal":65733,"en":"They will slaughter, leaving no descendants!” he said."},{"id":"manas-2010:p1524:b001:l010","ordinal":65734,"en":"Kongurbay brought his numbers to bear;"},{"id":"manas-2010:p1524:b001:l011","ordinal":65735,"en":"The people of ninety tribes swept in,"},{"id":"manas-2010:p1524:b001:l012","ordinal":65736,"en":"A flood that overturned mountains swept in,"},{"id":"manas-2010:p1524:b001:l013","ordinal":65737,"en":"The countless Chinese now arrived."},{"id":"manas-2010:p1524:b001:l014","ordinal":65738,"en":"Almambet, Chubak and warrior Syrgak—"},{"id":"manas-2010:p1524:b001:l015","ordinal":65739,"en":"Could they scatter earth upon so many?—"},{"id":"manas-2010:p1524:b001:l016","ordinal":65740,"en":"Were now hard pressed indeed!"},{"id":"manas-2010:p1524:b001:l017","ordinal":65741,"en":"The heroes went on fighting,"},{"id":"manas-2010:p1524:b001:l018","ordinal":65742,"en":"Hemmed in by the many dead,"},{"id":"manas-2010:p1524:b001:l019","ordinal":65743,"en":"Their horses up to their knees"},{"id":"manas-2010:p1524:b001:l020","ordinal":65744,"en":"Were dyed with red blood."},{"id":"manas-2010:p1524:b001:l021","ordinal":65745,"en":"When the Chinese came in greater force,"},{"id":"manas-2010:p1524:b001:l022","ordinal":65746,"en":"Then Syrgak the leopard,"},{"id":"manas-2010:p1524:b001:l023","ordinal":65747,"en":"Without pausing, his leather belt"},{"id":"manas-2010:p1524:b001:l024","ordinal":65748,"en":"He girded, crying, “I trust to fate!”"},{"id":"manas-2010:p1524:b001:l025","ordinal":65749,"en":"The mass of Chinese and Manchus"},{"id":"manas-2010:p1524:b001:l026","ordinal":65750,"en":"He halted by attacking once again."},{"id":"manas-2010:p1524:b001:l027","ordinal":65751,"en":"While Syrgak held them off,"},{"id":"manas-2010:p1524:b001:l028","ordinal":65752,"en":"Chubak plunged among them."},{"id":"manas-2010:p1524:b001:l029","ordinal":65753,"en":"Fighting for nine days,"},{"id":"manas-2010:p1524:b001:l030","ordinal":65754,"en":"Chubak came out stained with blood,"},{"id":"manas-2010:p1524:b001:l031","ordinal":65755,"en":"Wounded in ninety places."},{"id":"manas-2010:p1524:b001:l032","ordinal":65756,"en":"When mountain-like Chubak emerged,"},{"id":"manas-2010:p1524:b001:l033","ordinal":65757,"en":"Having come to this campaign of death"},{"id":"manas-2010:p1524:b001:l034","ordinal":65758,"en":"From broad Talas,"},{"id":"manas-2010:p1524:b001:l035","ordinal":65759,"en":"The great host of Burut Muslims"},{"id":"manas-2010:p1524:b001:l036","ordinal":65760,"en":"Had fallen into torment."},{"id":"manas-2010:p1524:b001:l037","ordinal":65761,"en":"Argynkhan’s Ajybai,"},{"id":"manas-2010:p1524:b001:l038","ordinal":65762,"en":"Whose mount was swift Kartkurong,"},{"id":"manas-2010:p1524:b001:l039","ordinal":65763,"en":"Now sixty years into its maturity,"},{"id":"manas-2010:p1524:b001:l040","ordinal":65764,"en":"Not letting the foe seize his horse’s lead,"},{"id":"manas-2010:p1524:b001:l041","ordinal":65765,"en":"Not yielding to a determined enemy,"},{"id":"manas-2010:p1524:b001:l042","ordinal":65766,"en":"Plunging into the campaign,"},{"id":"manas-2010:p1525:b001:l001","ordinal":65767,"en":"He too entered and fought."},{"id":"manas-2010:p1525:b001:l002","ordinal":65768,"en":"When Ajybai went in,"},{"id":"manas-2010:p1525:b001:l003","ordinal":65769,"en":"See the reeds, see the flood,"},{"id":"manas-2010:p1525:b001:l004","ordinal":65770,"en":"See the Chinese people surging in!"},{"id":"manas-2010:p1525:b001:l005","ordinal":65771,"en":"See the cannon shot, swifter than clouds,"},{"id":"manas-2010:p1525:b001:l006","ordinal":65772,"en":"See the bullets striking without swerving!"},{"id":"manas-2010:p1525:b001:l007","ordinal":65773,"en":"For six days he plunged among them;"},{"id":"manas-2010:p1525:b001:l008","ordinal":65774,"en":"Ajybai came out stained with blood,"},{"id":"manas-2010:p1525:b001:l009","ordinal":65775,"en":"Wounded in sixty places."},{"id":"manas-2010:p1525:b001:l010","ordinal":65776,"en":"After Ajybai,"},{"id":"manas-2010:p1525:b001:l011","ordinal":65777,"en":"Shouting, “I trust to fate!”"},{"id":"manas-2010:p1525:b001:l012","ordinal":65778,"en":"Calling the battle cry, “Manas!”"},{"id":"manas-2010:p1525:b001:l013","ordinal":65779,"en":"For seven days he plunged among them,"},{"id":"manas-2010:p1525:b001:l014","ordinal":65780,"en":"Wounded in seventy places;"},{"id":"manas-2010:p1525:b001:l015","ordinal":65781,"en":"Yrchy Uul came out covered in blood,"},{"id":"manas-2010:p1525:b001:l016","ordinal":65782,"en":"Stiff, unable even to sway."},{"id":"manas-2010:p1525:b001:l017","ordinal":65783,"en":"Old Kyrgyl, leader of the forty,"},{"id":"manas-2010:p1525:b001:l018","ordinal":65784,"en":"A mighty elder, proud among his forty,"},{"id":"manas-2010:p1525:b001:l019","ordinal":65785,"en":"Were it not for his perverse temper,"},{"id":"manas-2010:p1525:b001:l020","ordinal":65786,"en":"An elder skilled among spearmen,"},{"id":"manas-2010:p1525:b001:l021","ordinal":65787,"en":"Plunged among them for two days,"},{"id":"manas-2010:p1525:b001:l022","ordinal":65788,"en":"Was wounded in many places,"},{"id":"manas-2010:p1525:b001:l023","ordinal":65789,"en":"His head a bucketful of blood,"},{"id":"manas-2010:p1525:b001:l024","ordinal":65790,"en":"The whole of his body"},{"id":"manas-2010:p1525:b001:l025","ordinal":65791,"en":"Stiff, unable to stir,"},{"id":"manas-2010:p1525:b001:l026","ordinal":65792,"en":"And returned from the battle."}]
