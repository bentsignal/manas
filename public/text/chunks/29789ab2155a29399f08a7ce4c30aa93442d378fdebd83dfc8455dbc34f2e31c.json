[{"id":"semetey-1-2013:p0981:b004:l025","ordinal":151041,"en":"A woman sitting at home have with it?"},{"id":"semetey-1-2013:p0981:b004:l026","ordinal":151042,"en":"Vanish from my sight;"},{"id":"semetey-1-2013:p0981:b004:l027","ordinal":151043,"en":"Do not come near me!"},{"id":"semetey-1-2013:p0981:b004:l028","ordinal":151044,"en":"You who speak with a hiss,"},{"id":"semetey-1-2013:p0981:b004:l029","ordinal":151045,"en":"Who mention the time I was mocked—"},{"id":"semetey-1-2013:p0981:b004:l030","ordinal":151046,"en":"For these words you have spoken,"},{"id":"semetey-1-2013:p0981:b004:l031","ordinal":151047,"en":"By your father’s grave, filthy slave,"},{"id":"semetey-1-2013:p0981:b004:l032","ordinal":151048,"en":"Vanish from my sight!"},{"id":"semetey-1-2013:p0981:b004:l033","ordinal":151049,"en":"I shall slaughter you now;"},{"id":"semetey-1-2013:p0981:b004:l034","ordinal":151050,"en":"By your father’s grave, devil-slave,"},{"id":"semetey-1-2013:p0981:b004:l035","ordinal":151051,"en":"I shall gouge out your eyes!"},{"id":"semetey-1-2013:p0981:b004:l036","ordinal":151052,"en":"Remember what I have said:"},{"id":"semetey-1-2013:p0981:b004:l037","ordinal":151053,"en":"You and your bloodthirsty companion together—"},{"id":"semetey-1-2013:p0981:b004:l038","ordinal":151054,"en":"Go down into the black earth!”"},{"id":"semetey-1-2013:p0981:b004:l039","ordinal":151055,"en":"She raged and swelled with fury,"}]
