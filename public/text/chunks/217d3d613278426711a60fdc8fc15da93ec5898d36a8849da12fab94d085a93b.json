[{"id":"seytek-2012:p0948:b002:l008","ordinal":368385,"en":"This boy is insolent,"},{"id":"seytek-2012:p0948:b002:l009","ordinal":368386,"en":"So I shall settle his great account.”"},{"id":"seytek-2012:p0948:b002:l010","ordinal":368387,"en":"He readied himself, gripping his axe,"},{"id":"seytek-2012:p0948:b002:l011","ordinal":368388,"en":"While the other leveled his spear."},{"id":"seytek-2012:p0948:b002:l012","ordinal":368389,"en":"In less time than it takes to speak,"},{"id":"seytek-2012:p0948:b002:l013","ordinal":368390,"en":"Urging on gray Kulansur,"},{"id":"seytek-2012:p0948:b002:l014","ordinal":368391,"en":"Seytek reached him."},{"id":"seytek-2012:p0948:b002:l015","ordinal":368392,"en":"At the swine who came to face him,"},{"id":"seytek-2012:p0948:b002:l016","ordinal":368393,"en":"He aimed his grooved steel ornamented spear"},{"id":"seytek-2012:p0948:b002:l017","ordinal":368394,"en":"And drove it squarely toward the jaw."},{"id":"seytek-2012:p0948:b002:l018","ordinal":368395,"en":"Heedless when it struck,"},{"id":"seytek-2012:p0948:b002:l019","ordinal":368396,"en":"The accursed Sarybay regarded"},{"id":"seytek-2012:p0948:b002:l020","ordinal":368397,"en":"The thrust Seytek had delivered"},{"id":"seytek-2012:p0948:b002:l021","ordinal":368398,"en":"As less than a touch upon his hem."},{"id":"seytek-2012:p0948:b002:l022","ordinal":368399,"en":"He neither swayed nor flinched;"},{"id":"seytek-2012:p0948:b002:l023","ordinal":368400,"en":"The wrathful swine did not stir."},{"id":"seytek-2012:p0948:b002:l024","ordinal":368401,"en":"He did not die from that single thrust,"},{"id":"seytek-2012:p0948:b002:l025","ordinal":368402,"en":"Nor did he reckon Seytek’s blow"},{"id":"seytek-2012:p0948:b002:l026","ordinal":368403,"en":"Worthy even of a cough."},{"id":"seytek-2012:p0948:b002:l027","ordinal":368404,"en":"Pouring out his wrath, unconcerned,"},{"id":"seytek-2012:p0948:b002:l028","ordinal":368405,"en":"Not counting the warrior his equal,"},{"id":"seytek-2012:p0948:b002:l029","ordinal":368406,"en":"He deemed the fierce battle and great peril"},{"id":"seytek-2012:p0948:b002:l030","ordinal":368407,"en":"Less than a touch upon his hem."},{"id":"seytek-2012:p0948:b002:l031","ordinal":368408,"en":"So Sarybay stood there,"},{"id":"seytek-2012:p0948:b002:l032","ordinal":368409,"en":"While the noble, impassioned warrior"},{"id":"seytek-2012:p0948:b002:l033","ordinal":368410,"en":"Gathered all his strength into his body."},{"id":"seytek-2012:p0948:b002:l034","ordinal":368411,"en":"Sarybay grew furious;"},{"id":"seytek-2012:p0948:b002:l035","ordinal":368412,"en":"His menace was terrible, his venom strong—"},{"id":"seytek-2012:p0948:b002:l036","ordinal":368413,"en":"Such was the villain."},{"id":"seytek-2012:p0948:b002:l037","ordinal":368414,"en":"The cunning boar"},{"id":"seytek-2012:p0948:b002:l038","ordinal":368415,"en":"Was thick-armed and highly skilled,"},{"id":"seytek-2012:p0948:b002:l039","ordinal":368416,"en":"Perfect in guile and fierce in venom,"},{"id":"seytek-2012:p0948:b002:l040","ordinal":368417,"en":"Powerfully built and supreme,"},{"id":"seytek-2012:p0948:b003:l001","ordinal":368418,"en":"One who had leveled the whole world."},{"id":"seytek-2012:p0948:b003:l002","ordinal":368419,"en":"At the sight of him, abandon hope;"},{"id":"seytek-2012:p0948:b003:l003","ordinal":368420,"en":"Such was the accursed man."},{"id":"seytek-2012:p0948:b003:l004","ordinal":368421,"en":"All the powers in the world,"},{"id":"seytek-2012:p0948:b003:l005","ordinal":368422,"en":"Countless conflicts, countless quarrels,"},{"id":"seytek-2012:p0948:b003:l006","ordinal":368423,"en":"Countless perils, countless dark nights—"},{"id":"seytek-2012:p0948:b003:l007","ordinal":368424,"en":"To all such things he was accustomed."},{"id":"seytek-2012:p0948:b003:l008","ordinal":368425,"en":"Wrathful Sarybay,"},{"id":"seytek-2012:p0948:b003:l009","ordinal":368426,"en":"The many-muscled swine,"},{"id":"seytek-2012:p0948:b003:l010","ordinal":368427,"en":"Bit hard upon his tongue"},{"id":"seytek-2012:p0948:b003:l011","ordinal":368428,"en":"As his blood-drinking nature seized him."},{"id":"seytek-2012:p0948:b003:l012","ordinal":368429,"en":"His eyes blazed like a lion’s;"},{"id":"seytek-2012:p0948:b003:l013","ordinal":368430,"en":"He bit his lips through,"},{"id":"seytek-2012:p0948:b003:l014","ordinal":368431,"en":"And the swine would not cease until he had grappled."},{"id":"seytek-2012:p0948:b003:l015","ordinal":368432,"en":"Facing him in combat,"},{"id":"seytek-2012:p0948:b003:l016","ordinal":368433,"en":"“I shall axe off his head,” he said,"},{"id":"seytek-2012:p0948:b003:l017","ordinal":368434,"en":"“And reach the root of all he is.”"},{"id":"seytek-2012:p0948:b003:l018","ordinal":368435,"en":"He roared menacingly,"},{"id":"seytek-2012:p0948:b003:l019","ordinal":368436,"en":"Churning the blue heavens;"},{"id":"seytek-2012:p0948:b003:l020","ordinal":368437,"en":"His beard and mustache bristled strand by strand,"},{"id":"seytek-2012:p0948:b003:l021","ordinal":368438,"en":"And he thundered like an onrushing flood."},{"id":"seytek-2012:p0948:b003:l022","ordinal":368439,"en":"Anyone who watched him closely"},{"id":"seytek-2012:p0948:b003:l023","ordinal":368440,"en":"Despaired of his borrowed mortal life."},{"id":"seytek-2012:p0948:b003:l024","ordinal":368441,"en":"Breaking through hills to make a road,"},{"id":"seytek-2012:p0948:b003:l025","ordinal":368442,"en":"He attacked Seytek."},{"id":"seytek-2012:p0948:b003:l026","ordinal":368443,"en":"His black-jawed leather club"},{"id":"seytek-2012:p0948:b003:l027","ordinal":368444,"en":"Deafened the ears when it struck."},{"id":"seytek-2012:p0948:b003:l028","ordinal":368445,"en":"The hide of a full-grown ox"},{"id":"seytek-2012:p0948:b003:l029","ordinal":368446,"en":"Had been stretched over its core;"},{"id":"seytek-2012:p0948:b003:l030","ordinal":368447,"en":"The hides of six wethers"},{"id":"seytek-2012:p0948:b003:l031","ordinal":368448,"en":"Had been packed and braided around it."},{"id":"seytek-2012:p0948:b003:l032","ordinal":368449,"en":"Its grip was glassy,"},{"id":"seytek-2012:p0948:b003:l033","ordinal":368450,"en":"Its wrist-loop stout as a jar;"},{"id":"seytek-2012:p0948:b003:l034","ordinal":368451,"en":"Embers seemed set in its palm,"},{"id":"seytek-2012:p0948:b003:l035","ordinal":368452,"en":"And blue thunderbolts lay within it."},{"id":"seytek-2012:p0948:b003:l036","ordinal":368453,"en":"Sarybay was adroit;"},{"id":"seytek-2012:p0948:b003:l037","ordinal":368454,"en":"Such was his supreme courage."},{"id":"seytek-2012:p0948:b003:l038","ordinal":368455,"en":"He swung the leather club in a sweeping arc,"},{"id":"seytek-2012:p0948:b003:l039","ordinal":368456,"en":"Then spurred the thoroughbred Tookyzyl,"},{"id":"seytek-2012:p0948:b003:l040","ordinal":368457,"en":"Driving his heels into its flanks."},{"id":"seytek-2012:p0949:b002:l001","ordinal":368458,"en":"He aligned and wheeled his spear,"},{"id":"seytek-2012:p0949:b002:l002","ordinal":368459,"en":"Thundered menacingly,"},{"id":"seytek-2012:p0949:b002:l003","ordinal":368460,"en":"And spared no effort."},{"id":"seytek-2012:p0949:b002:l004","ordinal":368461,"en":"Its shaft was mounted with silver,"},{"id":"seytek-2012:p0949:b002:l005","ordinal":368462,"en":"Its edge was faced with steel—"},{"id":"seytek-2012:p0949:b002:l006","ordinal":368463,"en":"A steel-headed battle-axe."},{"id":"seytek-2012:p0949:b002:l007","ordinal":368464,"en":"Gripping it firmly, he braced himself,"},{"id":"seytek-2012:p0949:b002:l008","ordinal":368465,"en":"Drew in his frame and made ready."},{"id":"seytek-2012:p0949:b002:l009","ordinal":368466,"en":"Fire poured from his mouth,"},{"id":"seytek-2012:p0949:b002:l010","ordinal":368467,"en":"And his courage showed in full;"},{"id":"seytek-2012:p0949:b002:l011","ordinal":368468,"en":"God had smitten him with fury."},{"id":"seytek-2012:p0949:b002:l012","ordinal":368469,"en":"Blood streamed from his charging steed,"},{"id":"seytek-2012:p0949:b002:l013","ordinal":368470,"en":"And blood flowed along the path of his charge."},{"id":"seytek-2012:p0949:b002:l014","ordinal":368471,"en":"Growling in rising passion,"},{"id":"seytek-2012:p0949:b002:l015","ordinal":368472,"en":"He thundered words to himself,"},{"id":"seytek-2012:p0949:b002:l016","ordinal":368473,"en":"Raging and lunging,"},{"id":"seytek-2012:p0949:b002:l017","ordinal":368474,"en":"Writhing with violent force;"},{"id":"seytek-2012:p0949:b002:l018","ordinal":368475,"en":"His brows and lashes flared apart,"},{"id":"seytek-2012:p0949:b002:l019","ordinal":368476,"en":"And venom poured from his mouth."},{"id":"seytek-2012:p0949:b002:l020","ordinal":368477,"en":"Toward the dauntless son of the hero"},{"id":"seytek-2012:p0949:b002:l021","ordinal":368478,"en":"He turned and braced himself,"},{"id":"seytek-2012:p0949:b002:l022","ordinal":368479,"en":"Straining and glaring with courage."},{"id":"seytek-2012:p0949:b002:l023","ordinal":368480,"en":"A mountain-like surge came to a halt,"},{"id":"seytek-2012:p0949:b002:l024","ordinal":368481,"en":"Like a horse tethered to a post."},{"id":"seytek-2012:p0949:b002:l025","ordinal":368482,"en":"At the swine’s thunderous approach,"},{"id":"seytek-2012:p0949:b002:l026","ordinal":368483,"en":"The accursed veteran"},{"id":"seytek-2012:p0949:b002:l027","ordinal":368484,"en":"Readied his fire pit."},{"id":"seytek-2012:p0949:b002:l028","ordinal":368485,"en":"The black earth, without overturning,"},{"id":"seytek-2012:p0949:b002:l029","ordinal":368486,"en":"Held firm beneath the massive weight."},{"id":"seytek-2012:p0949:b002:l030","ordinal":368487,"en":"The boar was rich in strength;"},{"id":"seytek-2012:p0949:b002:l031","ordinal":368488,"en":"The skillful enemy Sarybay"},{"id":"seytek-2012:p0949:b002:l032","ordinal":368489,"en":"Opened his mouth like a wolf,"},{"id":"seytek-2012:p0949:b002:l033","ordinal":368490,"en":"And fire scattered before him."},{"id":"seytek-2012:p0949:b002:l034","ordinal":368491,"en":"He assumed a form of savage courage"},{"id":"seytek-2012:p0949:b002:l035","ordinal":368492,"en":"And stirred grievous strife."},{"id":"seytek-2012:p0949:b002:l036","ordinal":368493,"en":"The mountain-like Tookyzyl"},{"id":"seytek-2012:p0949:b002:l037","ordinal":368494,"en":"Broke the ground beneath its hooves;"},{"id":"seytek-2012:p0949:b002:l038","ordinal":368495,"en":"He made Tookyzyl bound,"},{"id":"seytek-2012:p0949:b002:l039","ordinal":368496,"en":"Spurring it right and left,"},{"id":"seytek-2012:p0949:b002:l040","ordinal":368497,"en":"And lashing from side to side."},{"id":"seytek-2012:p0949:b003:l001","ordinal":368498,"en":"Pouring out his wrath, he shouted,"},{"id":"seytek-2012:p0949:b003:l002","ordinal":368499,"en":"Raising the battle cry, “Where is he?”"},{"id":"seytek-2012:p0949:b003:l003","ordinal":368500,"en":"His violent fury burst forth,"},{"id":"seytek-2012:p0949:b003:l004","ordinal":368501,"en":"And he appeared like a mountain of black rock."},{"id":"seytek-2012:p0949:b003:l005","ordinal":368502,"en":"Sarybay was indeed a warrior;"},{"id":"seytek-2012:p0949:b003:l006","ordinal":368503,"en":"Such was his conduct in combat."},{"id":"seytek-2012:p0949:b003:l007","ordinal":368504,"en":"Vision dimmed amid the tumult;"},{"id":"seytek-2012:p0949:b003:l008","ordinal":368505,"en":"The battle, if seen, was a roaring storm."},{"id":"seytek-2012:p0949:b003:l009","ordinal":368506,"en":"Young Seytek, brave gray-maned wolf,"},{"id":"seytek-2012:p0949:b003:l010","ordinal":368507,"en":"As Sarybay faced him"},{"id":"seytek-2012:p0949:b003:l011","ordinal":368508,"en":"And began the savage slaughter,"},{"id":"seytek-2012:p0949:b003:l012","ordinal":368509,"en":"Before an arrow could arrive,"},{"id":"seytek-2012:p0949:b003:l013","ordinal":368510,"en":"Measured the place he must strike."},{"id":"seytek-2012:p0949:b003:l014","ordinal":368511,"en":"As the man rode to thrust at the boy,"},{"id":"seytek-2012:p0949:b003:l015","ordinal":368512,"en":"“I have met my enemy—"},{"id":"seytek-2012:p0949:b003:l016","ordinal":368513,"en":"May God prosper what follows;"},{"id":"seytek-2012:p0949:b003:l017","ordinal":368514,"en":"May my forefather Manas uphold me,” he said."},{"id":"seytek-2012:p0949:b003:l018","ordinal":368515,"en":"Against the menacing villain,"},{"id":"seytek-2012:p0949:b003:l019","ordinal":368516,"en":"Who swept away all he encountered,"},{"id":"seytek-2012:p0949:b003:l020","ordinal":368517,"en":"The boar, warrior Sarybay,"},{"id":"seytek-2012:p0949:b003:l021","ordinal":368518,"en":"The descendant of the brave gray wolf"},{"id":"seytek-2012:p0949:b003:l022","ordinal":368519,"en":"Turned Kulansur’s head."},{"id":"seytek-2012:p0949:b003:l023","ordinal":368520,"en":"The father’s son"},{"id":"seytek-2012:p0949:b003:l024","ordinal":368521,"en":"Did not fluster or hurry;"},{"id":"seytek-2012:p0949:b003:l025","ordinal":368522,"en":"A descendant of his line"},{"id":"seytek-2012:p0949:b003:l026","ordinal":368523,"en":"Never retreated from a foe,"},{"id":"seytek-2012:p0949:b003:l027","ordinal":368524,"en":"Never fled after yielding ground,"},{"id":"seytek-2012:p0949:b003:l028","ordinal":368525,"en":"Never thought, “I shall die,”"},{"id":"seytek-2012:p0949:b003:l029","ordinal":368526,"en":"And never surrendered his courage to another."},{"id":"seytek-2012:p0949:b003:l030","ordinal":368527,"en":"The black-gray wolf, the peerless lion,"},{"id":"seytek-2012:p0949:b003:l031","ordinal":368528,"en":"With strength compounded like packed sand,"},{"id":"seytek-2012:p0949:b003:l032","ordinal":368529,"en":"Fought there in battle."},{"id":"seytek-2012:p0949:b003:l033","ordinal":368530,"en":"He measured and thrust toward the jaw:"},{"id":"seytek-2012:p0949:b003:l034","ordinal":368531,"en":"“Just beneath the breast,"},{"id":"seytek-2012:p0949:b003:l035","ordinal":368532,"en":"Right through the lung,"},{"id":"seytek-2012:p0949:b003:l036","ordinal":368533,"en":"That is the place of death.”"},{"id":"seytek-2012:p0949:b003:l037","ordinal":368534,"en":"Sarybay now leveled his spear:"},{"id":"seytek-2012:p0949:b003:l038","ordinal":368535,"en":"“Right at the point of the jaw,"},{"id":"seytek-2012:p0949:b003:l039","ordinal":368536,"en":"Right through the heart,"},{"id":"seytek-2012:p0949:b003:l040","ordinal":368537,"en":"That is the measured spot.”"},{"id":"seytek-2012:p0950:b002:l001","ordinal":368538,"en":"“For the grunting boar,"},{"id":"seytek-2012:p0950:b002:l002","ordinal":368539,"en":"This is the moment of death,”"},{"id":"seytek-2012:p0950:b002:l003","ordinal":368540,"en":"He said, taking aim with measured care."},{"id":"seytek-2012:p0950:b002:l004","ordinal":368541,"en":"At the raging infidel,"},{"id":"seytek-2012:p0950:b002:l005","ordinal":368542,"en":"The warrior who had destroyed nations,"},{"id":"seytek-2012:p0950:b002:l006","ordinal":368543,"en":"The youth rode up and thrust."},{"id":"seytek-2012:p0950:b002:l007","ordinal":368544,"en":"Both spears struck together,"},{"id":"seytek-2012:p0950:b002:l008","ordinal":368545,"en":"And when the two spears hit,"},{"id":"seytek-2012:p0950:b002:l009","ordinal":368546,"en":"They burst and splintered to pieces;"},{"id":"seytek-2012:p0950:b002:l010","ordinal":368547,"en":"Fragments as large as tents"},{"id":"seytek-2012:p0950:b002:l011","ordinal":368548,"en":"Flew whirling into the sky."},{"id":"seytek-2012:p0950:b002:l012","ordinal":368549,"en":"Those who watched and saw them,"},{"id":"seytek-2012:p0950:b002:l013","ordinal":368550,"en":"As the two stood face-to-face"},{"id":"seytek-2012:p0950:b002:l014","ordinal":368551,"en":"And in turn drove their spears"},{"id":"seytek-2012:p0950:b002:l015","ordinal":368552,"en":"At one another,"},{"id":"seytek-2012:p0950:b002:l016","ordinal":368553,"en":"Despaired of their lives."},{"id":"seytek-2012:p0950:b002:l017","ordinal":368554,"en":"Their bullet-proof armor split,"},{"id":"seytek-2012:p0950:b002:l018","ordinal":368555,"en":"And Kulansur and Tookyzyl"},{"id":"seytek-2012:p0950:b002:l019","ordinal":368556,"en":"Sank hoof-deep into the ground."},{"id":"seytek-2012:p0950:b002:l020","ordinal":368557,"en":"As the heroes met,"},{"id":"seytek-2012:p0950:b002:l021","ordinal":368558,"en":"Their valor was revealed."},{"id":"seytek-2012:p0950:b002:l022","ordinal":368559,"en":"When they struck spears with cries of “Manas!”"},{"id":"seytek-2012:p0950:b002:l023","ordinal":368560,"en":"The earth split five feet deep;"},{"id":"seytek-2012:p0950:b002:l024","ordinal":368561,"en":"They trampled the ground beneath them,"},{"id":"seytek-2012:p0950:b002:l025","ordinal":368562,"en":"Urging Kulansur on."},{"id":"seytek-2012:p0950:b002:l026","ordinal":368563,"en":"He flung forth his fury,"},{"id":"seytek-2012:p0950:b002:l027","ordinal":368564,"en":"While that monstrous warrior, the wretch,"},{"id":"seytek-2012:p0950:b002:l028","ordinal":368565,"en":"Grew angry with Tookyzyl."},{"id":"seytek-2012:p0950:b002:l029","ordinal":368566,"en":"It turned its deer-like neck;"},{"id":"seytek-2012:p0950:b002:l030","ordinal":368567,"en":"Kulansur would not stand still,"},{"id":"seytek-2012:p0950:b002:l031","ordinal":368568,"en":"While Tookyzyl was a true thoroughbred"},{"id":"seytek-2012:p0950:b002:l032","ordinal":368569,"en":"That sprang up from the earth."},{"id":"seytek-2012:p0950:b002:l033","ordinal":368570,"en":"When they came beneath the horses,"},{"id":"seytek-2012:p0950:b002:l034","ordinal":368571,"en":"Would Sarybay, son of the ogre,"},{"id":"seytek-2012:p0950:b002:l035","ordinal":368572,"en":"Refrain from fighting?"},{"id":"seytek-2012:p0950:b002:l036","ordinal":368573,"en":"His cavernous mouth opened,"},{"id":"seytek-2012:p0950:b002:l037","ordinal":368574,"en":"And burning embers from the bit"},{"id":"seytek-2012:p0950:b002:l038","ordinal":368575,"en":"Scattered in volleys."},{"id":"seytek-2012:p0950:b002:l039","ordinal":368576,"en":"His savage courage showed,"},{"id":"seytek-2012:p0950:b002:l040","ordinal":368577,"en":"And he burned in bitter grief."},{"id":"seytek-2012:p0950:b003:l001","ordinal":368578,"en":"The cause of his grief"},{"id":"seytek-2012:p0950:b003:l002","ordinal":368579,"en":"Was that Sarybay"},{"id":"seytek-2012:p0950:b003:l003","ordinal":368580,"en":"Had never paid anyone the slightest heed;"},{"id":"seytek-2012:p0950:b003:l004","ordinal":368581,"en":"No mortal had dared face him,"},{"id":"seytek-2012:p0950:b003:l005","ordinal":368582,"en":"And he had never deigned to notice a mortal."},{"id":"seytek-2012:p0950:b003:l006","ordinal":368583,"en":"No one had ever leveled a spear at him;"},{"id":"seytek-2012:p0950:b003:l007","ordinal":368584,"en":"He had bowed his neck to no one in the world,"},{"id":"seytek-2012:p0950:b003:l008","ordinal":368585,"en":"And no one had ever challenged him."},{"id":"seytek-2012:p0950:b003:l009","ordinal":368586,"en":"Against that rabid boar,"},{"id":"seytek-2012:p0950:b003:l010","ordinal":368587,"en":"None remained to ready a lasso."},{"id":"seytek-2012:p0950:b003:l011","ordinal":368588,"en":"Khans had died fighting him;"},{"id":"seytek-2012:p0950:b003:l012","ordinal":368589,"en":"Every khan who clashed with him had died."},{"id":"seytek-2012:p0950:b003:l013","ordinal":368590,"en":"Warriors proud of their strength had died;"},{"id":"seytek-2012:p0950:b003:l014","ordinal":368591,"en":"Lions who sought combat had died."},{"id":"seytek-2012:p0950:b003:l015","ordinal":368592,"en":"He had begun savage battles,"},{"id":"seytek-2012:p0950:b003:l016","ordinal":368593,"en":"Renowned in name and fierce in venom;"},{"id":"seytek-2012:p0950:b003:l017","ordinal":368594,"en":"He leveled all who crossed him—"},{"id":"seytek-2012:p0950:b003:l018","ordinal":368595,"en":"At the sight of his wrath, abandon hope."},{"id":"seytek-2012:p0950:b003:l019","ordinal":368596,"en":"Yet on that day the madman’s"},{"id":"seytek-2012:p0950:b003:l020","ordinal":368597,"en":"Evil purpose came undone."},{"id":"seytek-2012:p0950:b003:l021","ordinal":368598,"en":"Seized by fury,"},{"id":"seytek-2012:p0950:b003:l022","ordinal":368599,"en":"Sparing no precious life,"},{"id":"seytek-2012:p0950:b003:l023","ordinal":368600,"en":"He cried out in anger,"},{"id":"seytek-2012:p0950:b003:l024","ordinal":368601,"en":"Shouting menacingly,"},{"id":"seytek-2012:p0950:b003:l025","ordinal":368602,"en":"Churning the blue heavens."},{"id":"seytek-2012:p0950:b003:l026","ordinal":368603,"en":"His spirit seethed and madness boiled;"},{"id":"seytek-2012:p0950:b003:l027","ordinal":368604,"en":"Raging, he ground his teeth,"},{"id":"seytek-2012:p0950:b003:l028","ordinal":368605,"en":"And doom boiled over the warrior who opposed him."},{"id":"seytek-2012:p0950:b003:l029","ordinal":368606,"en":"His form bristled and transformed,"},{"id":"seytek-2012:p0950:b003:l030","ordinal":368607,"en":"Revealing his intent to destroy."},{"id":"seytek-2012:p0950:b003:l031","ordinal":368608,"en":"Then Sarybay"},{"id":"seytek-2012:p0950:b003:l032","ordinal":368609,"en":"And the warrior Seytek"},{"id":"seytek-2012:p0950:b003:l033","ordinal":368610,"en":"Fought without sparing their lives,"},{"id":"seytek-2012:p0950:b003:l034","ordinal":368611,"en":"Drenching themselves in crimson blood."},{"id":"seytek-2012:p0950:b003:l035","ordinal":368612,"en":"They stood thrusting spears,"},{"id":"seytek-2012:p0950:b003:l036","ordinal":368613,"en":"Firing guns and drawing bows,"},{"id":"seytek-2012:p0950:b003:l037","ordinal":368614,"en":"Striking each other in furious combat,"},{"id":"seytek-2012:p0950:b003:l038","ordinal":368615,"en":"And hewing at one another with axes,"},{"id":"seytek-2012:p0950:b003:l039","ordinal":368616,"en":"Until the axes splintered apart"},{"id":"seytek-2012:p0950:b003:l040","ordinal":368617,"en":"And only their shafts remained in hand."},{"id":"seytek-2012:p0951:b002:l001","ordinal":368618,"en":"They clashed with swords,"},{"id":"seytek-2012:p0951:b002:l002","ordinal":368619,"en":"The swords shattered and splintered,"},{"id":"seytek-2012:p0951:b002:l003","ordinal":368620,"en":"Leaving only bare hilts."},{"id":"seytek-2012:p0951:b002:l004","ordinal":368621,"en":"They stood face-to-face,"},{"id":"seytek-2012:p0951:b002:l005","ordinal":368622,"en":"Striking each other with heavy blows,"},{"id":"seytek-2012:p0951:b002:l006","ordinal":368623,"en":"All were drenched in blood,"},{"id":"seytek-2012:p0951:b002:l007","ordinal":368624,"en":"Their arrow-proof coats and trousers"},{"id":"seytek-2012:p0951:b002:l008","ordinal":368625,"en":"Were utterly torn to shreds,"},{"id":"seytek-2012:p0951:b002:l009","ordinal":368626,"en":"Rent apart like saddle straps,"},{"id":"seytek-2012:p0951:b002:l010","ordinal":368627,"en":"All their strength was spent,"},{"id":"seytek-2012:p0951:b002:l011","ordinal":368628,"en":"Ribs were broken one upon another,"},{"id":"seytek-2012:p0951:b002:l012","ordinal":368629,"en":"So fierce was the ordeal, so great the battle,"},{"id":"seytek-2012:p0951:b002:l013","ordinal":368630,"en":"That no regret remained."},{"id":"seytek-2012:p0951:b002:l014","ordinal":368631,"en":"Unable to throw him from the saddle,"},{"id":"seytek-2012:p0951:b002:l015","ordinal":368632,"en":"Unable to defeat brave Seytek."},{"id":"seytek-2012:p0951:b002:l016","ordinal":368633,"en":"Such was Seytek’s state."},{"id":"seytek-2012:p0951:b002:l017","ordinal":368634,"en":"His valor was extraordinary,"},{"id":"seytek-2012:p0951:b002:l018","ordinal":368635,"en":"The young man’s bearing was exceptional,"},{"id":"seytek-2012:p0951:b002:l019","ordinal":368636,"en":"He was the gray-maned champion of his line."},{"id":"seytek-2012:p0951:b002:l020","ordinal":368637,"en":"When Sarybai unleashed his venom,"},{"id":"seytek-2012:p0951:b002:l021","ordinal":368638,"en":"Shouting as he thrust his spear,"},{"id":"seytek-2012:p0951:b002:l022","ordinal":368639,"en":"And each time he swung his battle-axe,"},{"id":"seytek-2012:p0951:b002:l023","ordinal":368640,"en":"The falcon favored by the spirits,"}]
