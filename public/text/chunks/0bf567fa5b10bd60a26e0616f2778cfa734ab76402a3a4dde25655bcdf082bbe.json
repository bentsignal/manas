[{"id":"semetey-1-2013:p0200:b004:l022","ordinal":92161,"en":"All his ribs"},{"id":"semetey-1-2013:p0200:b004:l023","ordinal":92162,"en":"Stood apart like whip handles."},{"id":"semetey-1-2013:p0200:b004:l024","ordinal":92163,"en":"When she turned and came back,"},{"id":"semetey-1-2013:p0200:b004:l025","ordinal":92164,"en":"Your dignified, fierce sister-in-law's,"},{"id":"semetey-1-2013:p0200:b004:l026","ordinal":92165,"en":"Kanykey's white palace"},{"id":"semetey-1-2013:p0200:b004:l027","ordinal":92166,"en":"Had an iron door of solid tin."},{"id":"semetey-1-2013:p0200:b004:l028","ordinal":92167,"en":"However much a fugitive she was,"},{"id":"semetey-1-2013:p0200:b004:l029","ordinal":92168,"en":"Your sister-in-law kept her dignity."},{"id":"semetey-1-2013:p0200:b004:l030","ordinal":92169,"en":"She had much stateliness."},{"id":"semetey-1-2013:p0200:b004:l031","ordinal":92170,"en":"To the plane tree before the house,"},{"id":"semetey-1-2013:p0200:b004:l032","ordinal":92171,"en":"The precious woman Kanykey"},{"id":"semetey-1-2013:p0200:b004:l033","ordinal":92172,"en":"The courser Taytoru's"},{"id":"semetey-1-2013:p0200:b004:l034","ordinal":92173,"en":"Saddle she removed, leaving him bare,"},{"id":"semetey-1-2013:p0200:b004:l035","ordinal":92174,"en":"And brought the courser over."},{"id":"semetey-1-2013:p0200:b004:l036","ordinal":92175,"en":"Tethering him high, binding his lower leg,"},{"id":"semetey-1-2013:p0200:b004:l037","ordinal":92176,"en":"She tied him up high,"},{"id":"semetey-1-2013:p0200:b004:l038","ordinal":92177,"en":"And left him standing through the night."},{"id":"semetey-1-2013:p0200:b004:l039","ordinal":92178,"en":"When dawn broke bright,"},{"id":"semetey-1-2013:p0201:b003:l001","ordinal":92179,"en":"When light touched the earth,"},{"id":"semetey-1-2013:p0201:b003:l002","ordinal":92180,"en":"The stars trembled in the sky,"},{"id":"semetey-1-2013:p0201:b003:l003","ordinal":92181,"en":"One by one toward the qibla."},{"id":"semetey-1-2013:p0201:b003:l004","ordinal":92182,"en":"Stars scattered from overhead,"},{"id":"semetey-1-2013:p0201:b003:l005","ordinal":92183,"en":"And dawn opened bright."},{"id":"semetey-1-2013:p0201:b003:l006","ordinal":92184,"en":"The lord's wife Kanykey"},{"id":"semetey-1-2013:p0201:b003:l007","ordinal":92185,"en":"Walked to the plane tree,"},{"id":"semetey-1-2013:p0201:b003:l008","ordinal":92186,"en":"And the courser Taytoru"},{"id":"semetey-1-2013:p0201:b003:l009","ordinal":92187,"en":"She untied from the plane tree."},{"id":"semetey-1-2013:p0201:b003:l010","ordinal":92188,"en":"She put him to good grazing."},{"id":"semetey-1-2013:p0201:b003:l011","ordinal":92189,"en":"Leading him a little,"},{"id":"semetey-1-2013:p0201:b003:l012","ordinal":92190,"en":"Of the fourteen thoroughbred horses with grass."},{"id":"semetey-1-2013:p0201:b003:l013","ordinal":92191,"en":"She kept at it without tiring,"},{"id":"semetey-1-2013:p0201:b003:l014","ordinal":92192,"en":"Filling his stomach with grass."},{"id":"semetey-1-2013:p0201:b003:l015","ordinal":92193,"en":"Ten fescues, eighty grasses,"},{"id":"semetey-1-2013:p0201:b003:l016","ordinal":92194,"en":"Letting him crop them in swathes;"},{"id":"semetey-1-2013:p0201:b003:l017","ordinal":92195,"en":"With the surging spring water"},{"id":"semetey-1-2013:p0201:b003:l018","ordinal":92196,"en":"She quenched his thirst."},{"id":"semetey-1-2013:p0201:b003:l019","ordinal":92197,"en":"Grieving and calling on God,"},{"id":"semetey-1-2013:p0201:b003:l020","ordinal":92198,"en":"She put his bit back in."},{"id":"semetey-1-2013:p0201:b003:l021","ordinal":92199,"en":"It was the time of midmorning."},{"id":"semetey-1-2013:p0201:b003:l022","ordinal":92200,"en":"To the copper post in the palace"},{"id":"semetey-1-2013:p0201:b003:l023","ordinal":92201,"en":"She tied him up high."},{"id":"semetey-1-2013:p0201:b003:l024","ordinal":92202,"en":"The rich, patterned horsecloth"},{"id":"semetey-1-2013:p0201:b003:l025","ordinal":92203,"en":"Your sister-in-law gently took off."},{"id":"semetey-1-2013:p0201:b003:l026","ordinal":92204,"en":"The courser Taytoru"},{"id":"semetey-1-2013:p0201:b003:l027","ordinal":92205,"en":"She scraped with a scraper,"},{"id":"semetey-1-2013:p0201:b003:l028","ordinal":92206,"en":"And struck him with a ramrod."},{"id":"semetey-1-2013:p0201:b003:l029","ordinal":92207,"en":"She drew his covering back,"},{"id":"semetey-1-2013:p0201:b003:l030","ordinal":92208,"en":"And wiped his sweat clean."},{"id":"semetey-1-2013:p0201:b003:l031","ordinal":92209,"en":"Until death, her words were frank;"},{"id":"semetey-1-2013:p0201:b003:l032","ordinal":92210,"en":"While alive, your sister-in-law was clear-sighted."},{"id":"semetey-1-2013:p0201:b003:l033","ordinal":92211,"en":"After she had wiped his sweat,"},{"id":"semetey-1-2013:p0201:b003:l034","ordinal":92212,"en":"When she looked at Taytoru,"},{"id":"semetey-1-2013:p0201:b003:l035","ordinal":92213,"en":"Who raced the flying birds,"},{"id":"semetey-1-2013:p0201:b003:l036","ordinal":92214,"en":"The belly flesh from which fat is taken"},{"id":"semetey-1-2013:p0201:b003:l037","ordinal":92215,"en":"On Taytoru had become"},{"id":"semetey-1-2013:p0201:b003:l038","ordinal":92216,"en":"Pressed against his lower ribs."},{"id":"semetey-1-2013:p0201:b003:l039","ordinal":92217,"en":"His eyes flashed like the Morning Star."},{"id":"semetey-1-2013:p0201:b005:l001","ordinal":92218,"en":"Without bristling, his hairs lay separate."},{"id":"semetey-1-2013:p0201:b005:l002","ordinal":92219,"en":"He looked to either side,"},{"id":"semetey-1-2013:p0201:b005:l003","ordinal":92220,"en":"Licking his lips and muzzle."},{"id":"semetey-1-2013:p0201:b005:l004","ordinal":92221,"en":"The black steel bit"},{"id":"semetey-1-2013:p0201:b005:l005","ordinal":92222,"en":"He knocked against his throat."},{"id":"semetey-1-2013:p0201:b005:l006","ordinal":92223,"en":"His tail, like strands of silk,"},{"id":"semetey-1-2013:p0201:b005:l007","ordinal":92224,"en":"He lashed against his thighs."},{"id":"semetey-1-2013:p0201:b005:l008","ordinal":92225,"en":"So Taytoru had become."},{"id":"semetey-1-2013:p0201:b005:l009","ordinal":92226,"en":"Grinding and gnawing his teeth,"},{"id":"semetey-1-2013:p0201:b005:l010","ordinal":92227,"en":"Tearing up the ground he trod,"},{"id":"semetey-1-2013:p0201:b005:l011","ordinal":92228,"en":"So Taytoru had become."},{"id":"semetey-1-2013:p0201:b005:l012","ordinal":92229,"en":"\"This dear courser of mine,"},{"id":"semetey-1-2013:p0201:b005:l013","ordinal":92230,"en":"Unless my ill fortune prevents it,"},{"id":"semetey-1-2013:p0201:b005:l014","ordinal":92231,"en":"Will lower his head to the ground."},{"id":"semetey-1-2013:p0201:b005:l015","ordinal":92232,"en":"Without letting them call me a wandering woman,"},{"id":"semetey-1-2013:p0201:b005:l016","ordinal":92233,"en":"Today, of Bukhara"},{"id":"semetey-1-2013:p0201:b005:l017","ordinal":92234,"en":"He will take the highest prize."},{"id":"semetey-1-2013:p0201:b005:l018","ordinal":92235,"en":"But if it does not happen, what shall I do?"},{"id":"semetey-1-2013:p0201:b005:l019","ordinal":92236,"en":"Today I, this fierce woman,"},{"id":"semetey-1-2013:p0201:b005:l020","ordinal":92237,"en":"Will braid the hair down my back."},{"id":"semetey-1-2013:p0201:b005:l021","ordinal":92238,"en":"Without letting them call me a shameless woman,"},{"id":"semetey-1-2013:p0201:b005:l022","ordinal":92239,"en":"If Taytoru falls behind,"},{"id":"semetey-1-2013:p0201:b005:l023","ordinal":92240,"en":"I shall die before my appointed death."},{"id":"semetey-1-2013:p0201:b005:l024","ordinal":92241,"en":"My forehead bone was sloping;"},{"id":"semetey-1-2013:p0201:b005:l025","ordinal":92242,"en":"After the sovereign passed away,"},{"id":"semetey-1-2013:p0201:b005:l026","ordinal":92243,"en":"I, this fierce woman, was left like this,"},{"id":"semetey-1-2013:p0201:b005:l027","ordinal":92244,"en":"With few days left to live."},{"id":"semetey-1-2013:p0201:b005:l028","ordinal":92245,"en":"An iron net was drawn beneath me."},{"id":"semetey-1-2013:p0201:b005:l029","ordinal":92246,"en":"If Taytoru falls behind,"},{"id":"semetey-1-2013:p0201:b005:l030","ordinal":92247,"en":"What will become of our ill fortune?\""},{"id":"semetey-1-2013:p0201:b005:l031","ordinal":92248,"en":"Her thoughts are torn with sorrow."},{"id":"semetey-1-2013:p0201:b005:l032","ordinal":92249,"en":"At that moment, the fierce woman's"},{"id":"semetey-1-2013:p0201:b005:l033","ordinal":92250,"en":"Tears pour from her eyes."},{"id":"semetey-1-2013:p0201:b005:l034","ordinal":92251,"en":"\"I have no forest to flee into,"},{"id":"semetey-1-2013:p0201:b005:l035","ordinal":92252,"en":"No support to lean on,"},{"id":"semetey-1-2013:p0201:b005:l036","ordinal":92253,"en":"No people to rely upon.\""},{"id":"semetey-1-2013:p0201:b005:l037","ordinal":92254,"en":"So Taytoru stood."},{"id":"semetey-1-2013:p0201:b005:l038","ordinal":92255,"en":"\"Would that ill-fated one find good fortune,"},{"id":"semetey-1-2013:p0201:b005:l039","ordinal":92256,"en":"That one who had been wandering in flight—"},{"id":"semetey-1-2013:p0202:b003:l001","ordinal":92257,"en":"Saying, 'It is a fugitive's horse,'"},{"id":"semetey-1-2013:p0202:b003:l002","ordinal":92258,"en":"Would he block my horse's path?"},{"id":"semetey-1-2013:p0202:b003:l003","ordinal":92259,"en":"Making me feel my solitude,"},{"id":"semetey-1-2013:p0202:b003:l004","ordinal":92260,"en":"Tormenting my soul like this,"},{"id":"semetey-1-2013:p0202:b003:l005","ordinal":92261,"en":"The courser Taytoru,"},{"id":"semetey-1-2013:p0202:b003:l006","ordinal":92262,"en":"If he should come in front,"},{"id":"semetey-1-2013:p0202:b003:l007","ordinal":92263,"en":"Would they seize him on the road?"},{"id":"semetey-1-2013:p0202:b003:l008","ordinal":92264,"en":"Bringing him onto the road,"},{"id":"semetey-1-2013:p0202:b003:l009","ordinal":92265,"en":"Would they trample him underfoot?"},{"id":"semetey-1-2013:p0202:b003:l010","ordinal":92266,"en":"If some wretch comes to no good,"},{"id":"semetey-1-2013:p0202:b003:l011","ordinal":92267,"en":"If he blocks my horse's path,"},{"id":"semetey-1-2013:p0202:b003:l012","ordinal":92268,"en":"If he wishes it, let me seize him,"},{"id":"semetey-1-2013:p0202:b003:l013","ordinal":92269,"en":"Every khan who interferes."},{"id":"semetey-1-2013:p0202:b003:l014","ordinal":92270,"en":"Would some wretch find good fortune,"},{"id":"semetey-1-2013:p0202:b003:l015","ordinal":92271,"en":"Saying, 'It is a woman's horse,'"},{"id":"semetey-1-2013:p0202:b003:l016","ordinal":92272,"en":"And suddenly block his path?"},{"id":"semetey-1-2013:p0202:b003:l017","ordinal":92273,"en":"Who would show affection"},{"id":"semetey-1-2013:p0202:b003:l018","ordinal":92274,"en":"To a widow like me?"},{"id":"semetey-1-2013:p0202:b003:l019","ordinal":92275,"en":"Alas, would they kick him down,"},{"id":"semetey-1-2013:p0202:b003:l020","ordinal":92276,"en":"My steed Taytoru?"},{"id":"semetey-1-2013:p0202:b003:l021","ordinal":92277,"en":"Six Cities and Margilan—"},{"id":"semetey-1-2013:p0202:b003:l022","ordinal":92278,"en":"Malice lurked in their eyes,"},{"id":"semetey-1-2013:p0202:b003:l023","ordinal":92279,"en":"Crookedness lurked in their words."},{"id":"semetey-1-2013:p0202:b003:l024","ordinal":92280,"en":"If their strength allowed, they would destroy me;"},{"id":"semetey-1-2013:p0202:b003:l025","ordinal":92281,"en":"They were bent on striking me."},{"id":"semetey-1-2013:p0202:b003:l026","ordinal":92282,"en":"Deceit lurked in their words,"},{"id":"semetey-1-2013:p0202:b003:l027","ordinal":92283,"en":"Mischief lurked in their eyes."},{"id":"semetey-1-2013:p0202:b003:l028","ordinal":92284,"en":"If fate allowed, these people"},{"id":"semetey-1-2013:p0202:b003:l029","ordinal":92285,"en":"Were bent on ruining me."},{"id":"semetey-1-2013:p0202:b003:l030","ordinal":92286,"en":"Kökchö, khan of the Kazakhs,"},{"id":"semetey-1-2013:p0202:b003:l031","ordinal":92287,"en":"Was khan of the Kangdy,"},{"id":"semetey-1-2013:p0202:b003:l032","ordinal":92288,"en":"A man of sacred virtue."},{"id":"semetey-1-2013:p0202:b003:l033","ordinal":92289,"en":"Kökchö's son Ümötöy"},{"id":"semetey-1-2013:p0202:b003:l034","ordinal":92290,"en":"Had an even greater score to settle."},{"id":"semetey-1-2013:p0202:b003:l035","ordinal":92291,"en":"Jamgyrchy of the Eshtek"},{"id":"semetey-1-2013:p0202:b003:l036","ordinal":92292,"en":"Still had an ancient score to settle."},{"id":"semetey-1-2013:p0202:b003:l037","ordinal":92293,"en":"Hero Töshtük, Eleman's son,"},{"id":"semetey-1-2013:p0202:b003:l038","ordinal":92294,"en":"He too had a score to settle."},{"id":"semetey-1-2013:p0202:b003:l039","ordinal":92295,"en":"If someone interferes with my horse,"},{"id":"semetey-1-2013:p0202:b004:l001","ordinal":92296,"en":"Let me die before my appointed death."},{"id":"semetey-1-2013:p0202:b004:l002","ordinal":92297,"en":"If someone comes to no good,"},{"id":"semetey-1-2013:p0202:b004:l003","ordinal":92298,"en":"And blocks my horse's path,"},{"id":"semetey-1-2013:p0202:b004:l004","ordinal":92299,"en":"I was a soul dead long ago."},{"id":"semetey-1-2013:p0202:b004:l005","ordinal":92300,"en":"Letting them oppress me meanwhile,"},{"id":"semetey-1-2013:p0202:b004:l006","ordinal":92301,"en":"How can I remain alive?"},{"id":"semetey-1-2013:p0202:b004:l007","ordinal":92302,"en":"A whole group of those who interfere"},{"id":"semetey-1-2013:p0202:b004:l008","ordinal":92303,"en":"Let me offer up as a sacrifice."},{"id":"semetey-1-2013:p0202:b004:l009","ordinal":92304,"en":"If someone interferes with my horse,"},{"id":"semetey-1-2013:p0202:b004:l010","ordinal":92305,"en":"Let me offer him up as a sacrifice."},{"id":"semetey-1-2013:p0202:b004:l011","ordinal":92306,"en":"If someone interferes with my horse,"},{"id":"semetey-1-2013:p0202:b004:l012","ordinal":92307,"en":"Let me descend upon his head,"},{"id":"semetey-1-2013:p0202:b004:l013","ordinal":92308,"en":"Let me scatter his four kinds of livestock."},{"id":"semetey-1-2013:p0202:b004:l014","ordinal":92309,"en":"Let me raid all his mares."},{"id":"semetey-1-2013:p0202:b004:l015","ordinal":92310,"en":"If the old wretch comes near,"},{"id":"semetey-1-2013:p0202:b004:l016","ordinal":92311,"en":"Let me strike his brains out,"},{"id":"semetey-1-2013:p0202:b004:l017","ordinal":92312,"en":"And then exact"},{"id":"semetey-1-2013:p0202:b004:l018","ordinal":92313,"en":"A reckoning for his long-past deeds."},{"id":"semetey-1-2013:p0202:b004:l019","ordinal":92314,"en":"Weeping like this, all alone,"},{"id":"semetey-1-2013:p0202:b004:l020","ordinal":92315,"en":"Standing and shrieking in tears,"},{"id":"semetey-1-2013:p0202:b004:l021","ordinal":92316,"en":"What wish can I attain?"},{"id":"semetey-1-2013:p0202:b004:l022","ordinal":92317,"en":"Rather than suffer humiliation alive,"},{"id":"semetey-1-2013:p0202:b004:l023","ordinal":92318,"en":"Let me die like this.\""},{"id":"semetey-1-2013:p0202:b004:l024","ordinal":92319,"en":"Her thoughts torn with sorrow,"},{"id":"semetey-1-2013:p0202:b004:l025","ordinal":92320,"en":"Tears pouring from her eyes;"},{"id":"semetey-1-2013:p0202:b004:l026","ordinal":92321,"en":"From her unhappy currant-like eyes"},{"id":"semetey-1-2013:p0202:b004:l027","ordinal":92322,"en":"Tears streamed a whip's length."},{"id":"semetey-1-2013:p0202:b004:l028","ordinal":92323,"en":"From her dear quail-like eyes"},{"id":"semetey-1-2013:p0202:b004:l029","ordinal":92324,"en":"Tears fell in separate drops."},{"id":"semetey-1-2013:p0202:b004:l030","ordinal":92325,"en":"Your dear mother Kanykey"},{"id":"semetey-1-2013:p0202:b004:l031","ordinal":92326,"en":"Her dear hair, thick as a girth,"},{"id":"semetey-1-2013:p0202:b004:l032","ordinal":92327,"en":"Bound snugly on her crown."},{"id":"semetey-1-2013:p0202:b004:l033","ordinal":92328,"en":"Saying, 'My Semetey will wear it,'"},{"id":"semetey-1-2013:p0202:b004:l034","ordinal":92329,"en":"The marten-fur hat she had been making"},{"id":"semetey-1-2013:p0202:b004:l035","ordinal":92330,"en":"She pressed onto her head."},{"id":"semetey-1-2013:p0202:b004:l036","ordinal":92331,"en":"The golden-cheeked battle-axe,"},{"id":"semetey-1-2013:p0202:b004:l037","ordinal":92332,"en":"The heirloom left by her noble one,"},{"id":"semetey-1-2013:p0202:b004:l038","ordinal":92333,"en":"She fastened snugly at her wrist."},{"id":"semetey-1-2013:p0202:b004:l039","ordinal":92334,"en":"Formerly, Manas the leopard,"},{"id":"semetey-1-2013:p0203:b003:l001","ordinal":92335,"en":"Having grown into a mighty man,"},{"id":"semetey-1-2013:p0203:b003:l002","ordinal":92336,"en":"The equal of heroic sons,"},{"id":"semetey-1-2013:p0203:b003:l003","ordinal":92337,"en":"A lion supported by the Patron,"},{"id":"semetey-1-2013:p0203:b003:l004","ordinal":92338,"en":"All twelve parts of his body sound;"},{"id":"semetey-1-2013:p0203:b003:l005","ordinal":92339,"en":"Where Akkula had not run or walked,"},{"id":"semetey-1-2013:p0203:b003:l006","ordinal":92340,"en":"Not a single patch of ground remained;"},{"id":"semetey-1-2013:p0203:b003:l007","ordinal":92341,"en":"That had not heard his battle cry,"},{"id":"semetey-1-2013:p0203:b003:l008","ordinal":92342,"en":"Not a single people remained."},{"id":"semetey-1-2013:p0203:b003:l009","ordinal":92343,"en":"When he visited Medina,"},{"id":"semetey-1-2013:p0203:b003:l010","ordinal":92344,"en":"When he journeyed to Mecca,"},{"id":"semetey-1-2013:p0203:b003:l011","ordinal":92345,"en":"Receiving a letter from the khan-khoja,"},{"id":"semetey-1-2013:p0203:b003:l012","ordinal":92346,"en":"Receiving a blessing from the caliph;"},{"id":"semetey-1-2013:p0203:b003:l013","ordinal":92347,"en":"Called the Illustrious,"},{"id":"semetey-1-2013:p0203:b003:l014","ordinal":92348,"en":"With lion Bakay as his companion,"},{"id":"semetey-1-2013:p0203:b003:l015","ordinal":92349,"en":"And his soul-companion Ajybay of the Argyn khan,"},{"id":"semetey-1-2013:p0203:b003:l017","ordinal":92350,"en":"A lion such as he;"},{"id":"semetey-1-2013:p0203:b003:l018","ordinal":92351,"en":"When he turned back toward Islam,"},{"id":"semetey-1-2013:p0203:b003:l019","ordinal":92352,"en":"When he set out from Mecca,"},{"id":"semetey-1-2013:p0203:b003:l020","ordinal":92353,"en":"At the pass of Munaryk,"},{"id":"semetey-1-2013:p0203:b003:l021","ordinal":92354,"en":"In the desert of Mediyan,"},{"id":"semetey-1-2013:p0203:b003:l022","ordinal":92355,"en":"For the gray-maned hero visited by Khizr,"},{"id":"semetey-1-2013:p0203:b003:l023","ordinal":92356,"en":"Mighty blades were found."},{"id":"semetey-1-2013:p0203:b003:l024","ordinal":92357,"en":"Six blades bestowed as he wished"},{"id":"semetey-1-2013:p0203:b003:l025","ordinal":92358,"en":"Were found from the unseen world."},{"id":"semetey-1-2013:p0203:b003:l026","ordinal":92359,"en":"Of blade-flat Sary-Talaa,"},{"id":"semetey-1-2013:p0203:b003:l027","ordinal":92360,"en":"They appeared in the very midst."},{"id":"semetey-1-2013:p0203:b003:l028","ordinal":92361,"en":"Among swords, the very finest,"},{"id":"semetey-1-2013:p0203:b003:l029","ordinal":92362,"en":"Zulpukor, acquired by Manas—"},{"id":"semetey-1-2013:p0203:b003:l030","ordinal":92363,"en":"When he scattered the unbelievers' livestock,"},{"id":"semetey-1-2013:p0203:b003:l031","ordinal":92364,"en":"When he launched a holy campaign against Kakan,"},{"id":"semetey-1-2013:p0203:b003:l032","ordinal":92365,"en":"Into dark, brooding Beijing,"},{"id":"semetey-1-2013:p0203:b003:l033","ordinal":92366,"en":"When he entered straight and thrust his spear,"},{"id":"semetey-1-2013:p0203:b003:l034","ordinal":92367,"en":"The diverse Manchus, the many Chinese,"},{"id":"semetey-1-2013:p0203:b003:l035","ordinal":92368,"en":"When he slaughtered them all to the last;"},{"id":"semetey-1-2013:p0203:b003:l036","ordinal":92369,"en":"Against the Black Kalmyks and Mongols,"},{"id":"semetey-1-2013:p0203:b003:l037","ordinal":92370,"en":"When he fought a fierce war;"},{"id":"semetey-1-2013:p0203:b003:l038","ordinal":92371,"en":"Twelve mighty khans died,"},{"id":"semetey-1-2013:p0203:b003:l039","ordinal":92372,"en":"Twelve hosts of troops died,"},{"id":"semetey-1-2013:p0203:b005:l001","ordinal":92373,"en":"Lions Almambet and Chubak died,"},{"id":"semetey-1-2013:p0203:b005:l002","ordinal":92374,"en":"The finest of the sixty,"},{"id":"semetey-1-2013:p0203:b005:l003","ordinal":92375,"en":"The most precious of the forty companions,"},{"id":"semetey-1-2013:p0203:b005:l004","ordinal":92376,"en":"Heroes Serek and Syrgak died."},{"id":"semetey-1-2013:p0203:b005:l005","ordinal":92377,"en":"Entering Kakan, suffering loss,"},{"id":"semetey-1-2013:p0203:b005:l006","ordinal":92378,"en":"Across the ridge of his backbone,"},{"id":"semetey-1-2013:p0203:b005:l007","ordinal":92379,"en":"With a white jezail and red plume,"},{"id":"semetey-1-2013:p0203:b005:l008","ordinal":92380,"en":"By Kongurbay, Alööke's son,"},{"id":"semetey-1-2013:p0203:b005:l009","ordinal":92381,"en":"His back was pierced open."},{"id":"semetey-1-2013:p0203:b005:l010","ordinal":92382,"en":"Reaching Talas alive,"},{"id":"semetey-1-2013:p0203:b005:l011","ordinal":92383,"en":"When your magnanimous Manas died,"},{"id":"semetey-1-2013:p0203:b005:l012","ordinal":92384,"en":"Kanykey was left in mourning."},{"id":"semetey-1-2013:p0203:b005:l013","ordinal":92385,"en":"All the countless riches,"},{"id":"semetey-1-2013:p0203:b005:l014","ordinal":92386,"en":"When those dogs scattered and divided them,"},{"id":"semetey-1-2013:p0203:b005:l015","ordinal":92387,"en":"When your sister-in-law suffered humiliation,"},{"id":"semetey-1-2013:p0203:b005:l016","ordinal":92388,"en":"The merciless torment,"},{"id":"semetey-1-2013:p0203:b005:l017","ordinal":92389,"en":"Your noble sister-in-law Kanykey,"},{"id":"semetey-1-2013:p0203:b005:l018","ordinal":92390,"en":"Had she not brought it with her?"},{"id":"semetey-1-2013:p0203:b005:l019","ordinal":92391,"en":"Zulpukor, left by noble Manas,"},{"id":"semetey-1-2013:p0203:b005:l020","ordinal":92392,"en":"Saying, 'My descendant will need it,'"},{"id":"semetey-1-2013:p0203:b005:l021","ordinal":92393,"en":"Had she not brought it with her?"},{"id":"semetey-1-2013:p0203:b005:l022","ordinal":92394,"en":"Zulpukor, left by Manas,"},{"id":"semetey-1-2013:p0203:b005:l023","ordinal":92395,"en":"Your noble sister-in-law Kanykey"},{"id":"semetey-1-2013:p0203:b005:l024","ordinal":92396,"en":"Hung across her shoulder blades."},{"id":"semetey-1-2013:p0203:b005:l025","ordinal":92397,"en":"The old one, with golden collar, copper sleeves,"},{"id":"semetey-1-2013:p0203:b005:l026","ordinal":92398,"en":"Double mail, with lark-eye rings,"},{"id":"semetey-1-2013:p0203:b005:l027","ordinal":92399,"en":"A broad battle-coat with gold-thread trim,"},{"id":"semetey-1-2013:p0203:b005:l028","ordinal":92400,"en":"The fine, becoming cotton coat,"},{"id":"semetey-1-2013:p0203:b005:l029","ordinal":92401,"en":"Your poor sister-in-law Kanykey"},{"id":"semetey-1-2013:p0203:b005:l030","ordinal":92402,"en":"Pulled on over herself."},{"id":"semetey-1-2013:p0203:b005:l031","ordinal":92403,"en":"The Gray Belt that fell from the sky"},{"id":"semetey-1-2013:p0203:b005:l032","ordinal":92404,"en":"For the exceptionally fortunate hero"},{"id":"semetey-1-2013:p0203:b005:l033","ordinal":92405,"en":"Had appeared on the level steppe."},{"id":"semetey-1-2013:p0203:b005:l034","ordinal":92406,"en":"For the hero visited by Khizr,"},{"id":"semetey-1-2013:p0203:b005:l035","ordinal":92407,"en":"It had appeared in a place of distress."},{"id":"semetey-1-2013:p0203:b005:l036","ordinal":92408,"en":"Red-whipped Shypshaydar"},{"id":"semetey-1-2013:p0203:b005:l037","ordinal":92409,"en":"Was Sooronduk's son,"},{"id":"semetey-1-2013:p0203:b005:l038","ordinal":92410,"en":"Almambet's maternal uncle;"},{"id":"semetey-1-2013:p0203:b005:l039","ordinal":92411,"en":"Giant Tiken, Börüköz's son—"},{"id":"semetey-1-2013:p0204:b003:l001","ordinal":92412,"en":"The palm-sized realm of Islam"},{"id":"semetey-1-2013:p0204:b003:l002","ordinal":92413,"en":"Had no strength to match those two."},{"id":"semetey-1-2013:p0204:b003:l003","ordinal":92414,"en":"At that time, troubled were"},{"id":"semetey-1-2013:p0204:b003:l004","ordinal":92415,"en":"The thoughts of Almambet and Chubak."},{"id":"semetey-1-2013:p0204:b003:l005","ordinal":92416,"en":"When they saw the pair's appearance,"}]
