[{"id":"semetey-1-2013:p1065:b005:l038","ordinal":158465,"en":"And the staring light deserted Azhybay's eyes."},{"id":"semetey-1-2013:p1066:b003:l001","ordinal":158466,"en":"Straining harder as they heaved,"},{"id":"semetey-1-2013:p1066:b003:l002","ordinal":158467,"en":"The fourteen tigers roared;"},{"id":"semetey-1-2013:p1066:b003:l003","ordinal":158468,"en":"From their terror,"},{"id":"semetey-1-2013:p1066:b003:l004","ordinal":158469,"en":"The men's beards trembled."},{"id":"semetey-1-2013:p1066:b003:l005","ordinal":158470,"en":"The fourteen tigers growled;"},{"id":"semetey-1-2013:p1066:b003:l006","ordinal":158471,"en":"Azhybay's and Tümönbay's"},{"id":"semetey-1-2013:p1066:b003:l007","ordinal":158472,"en":"Beards quivered strand by strand."},{"id":"semetey-1-2013:p1066:b003:l008","ordinal":158473,"en":"Chürök moved toward the palace,"},{"id":"semetey-1-2013:p1066:b003:l009","ordinal":158474,"en":"Pacing at an amble."},{"id":"semetey-1-2013:p1066:b003:l010","ordinal":158475,"en":"With all recourse gone then,"},{"id":"semetey-1-2013:p1066:b003:l011","ordinal":158476,"en":"Azhybay and Tümönbay"},{"id":"semetey-1-2013:p1066:b003:l012","ordinal":158477,"en":"Cowered close to Aychürök."},{"id":"semetey-1-2013:p1066:b003:l013","ordinal":158478,"en":"The two had lost their senses,"},{"id":"semetey-1-2013:p1066:b003:l014","ordinal":158479,"en":"Their wits gone and faces distorted."},{"id":"semetey-1-2013:p1066:b004:l001","ordinal":158480,"en":"Here and there the two men"},{"id":"semetey-1-2013:p1066:b004:l002","ordinal":158481,"en":"Went along vomiting."},{"id":"semetey-1-2013:p1066:b004:l003","ordinal":158482,"en":"At Aychürök's palace,"},{"id":"semetey-1-2013:p1066:b004:l004","ordinal":158483,"en":"When they drew near,"},{"id":"semetey-1-2013:p1066:b004:l005","ordinal":158484,"en":"Her guards were beyond counting,"},{"id":"semetey-1-2013:p1066:b004:l006","ordinal":158485,"en":"And her watchmen more numerous still."},{"id":"semetey-1-2013:p1066:b004:l007","ordinal":158486,"en":"Around the foot of that palace"},{"id":"semetey-1-2013:p1066:b004:l008","ordinal":158487,"en":"Stood a grove of plane trees."},{"id":"semetey-1-2013:p1066:b004:l009","ordinal":158488,"en":"When they entered that palace,"},{"id":"semetey-1-2013:p1066:b004:l010","ordinal":158489,"en":"Appearing like Opol Mountain,"},{"id":"semetey-1-2013:p1066:b004:l011","ordinal":158490,"en":"As stately as a prince's riding camel,"},{"id":"semetey-1-2013:p1066:b004:l012","ordinal":158491,"en":"Azhybay and Tümönbay"},{"id":"semetey-1-2013:p1066:b004:l013","ordinal":158492,"en":"The hero Semetey—"},{"id":"semetey-1-2013:p1066:b004:l014","ordinal":158493,"en":"At that moment they saw him."},{"id":"semetey-1-2013:p1066:b006:l001","ordinal":158494,"en":"Akun's daughter Chürök"},{"id":"semetey-1-2013:p1066:b006:l002","ordinal":158495,"en":"Had an inexhaustible tale;"},{"id":"semetey-1-2013:p1066:b006:l003","ordinal":158496,"en":"Without showing him to any person,"},{"id":"semetey-1-2013:p1066:b006:l004","ordinal":158497,"en":"The tiger, brave Semetey,"},{"id":"semetey-1-2013:p1066:b006:l005","ordinal":158498,"en":"Aychürök had brought by night"},{"id":"semetey-1-2013:p1066:b006:l006","ordinal":158499,"en":"And hidden away."},{"id":"semetey-1-2013:p1066:b006:l007","ordinal":158500,"en":"When they went in and looked,"},{"id":"semetey-1-2013:p1066:b006:l008","ordinal":158501,"en":"Semetey, son of Manas,"},{"id":"semetey-1-2013:p1066:b006:l009","ordinal":158502,"en":"Had a face like oiled wheat,"},{"id":"semetey-1-2013:p1066:b006:l010","ordinal":158503,"en":"And eyes like twilight mist."},{"id":"semetey-1-2013:p1066:b006:l011","ordinal":158504,"en":"He was as large as half a mountain,"},{"id":"semetey-1-2013:p1066:b006:l012","ordinal":158505,"en":"As though he would devour any attacker;"},{"id":"semetey-1-2013:p1066:b006:l013","ordinal":158506,"en":"His right shoulder was broad,"},{"id":"semetey-1-2013:p1066:b006:l014","ordinal":158507,"en":"A lion who could shatter the Oirats."},{"id":"semetey-1-2013:p1066:b006:l015","ordinal":158508,"en":"His brow was like rugged foothills;"},{"id":"semetey-1-2013:p1066:b006:l016","ordinal":158509,"en":"If he caught Chynkozho and Toltoy,"},{"id":"semetey-1-2013:p1066:b006:l017","ordinal":158510,"en":"He looked certain to swallow them."},{"id":"semetey-1-2013:p1066:b006:l018","ordinal":158511,"en":"His brow was high, his menace strong;"},{"id":"semetey-1-2013:p1066:b006:l019","ordinal":158512,"en":"Like Khan Manas himself,"},{"id":"semetey-1-2013:p1066:b006:l020","ordinal":158513,"en":"He would flatten any attacker!"},{"id":"semetey-1-2013:p1066:b007:l001","ordinal":158514,"en":"By Manas, who had gone to the next world,"},{"id":"semetey-1-2013:p1066:b007:l002","ordinal":158515,"en":"Semetey was left behind;"},{"id":"semetey-1-2013:p1066:b007:l003","ordinal":158516,"en":"He was himself an orphaned bridegroom;"},{"id":"semetey-1-2013:p1066:b007:l004","ordinal":158517,"en":"He had now come of age, his wife"},{"id":"semetey-1-2013:p1066:b007:l005","ordinal":158518,"en":"Was what he was seeking to take."},{"id":"semetey-1-2013:p1066:b007:l006","ordinal":158519,"en":"Azhybay recognized him;"},{"id":"semetey-1-2013:p1066:b007:l007","ordinal":158520,"en":"Running forward with folded hands,"},{"id":"semetey-1-2013:p1066:b007:l008","ordinal":158521,"en":"He offered his greeting:"},{"id":"semetey-1-2013:p1066:b007:l009","ordinal":158522,"en":"\"Peace upon peace be with you,"},{"id":"semetey-1-2013:p1066:b007:l010","ordinal":158523,"en":"Our splendid bridegroom!"},{"id":"semetey-1-2013:p1066:b007:l011","ordinal":158524,"en":"'The blood-taking bridegroom lives,'"},{"id":"semetey-1-2013:p1066:b007:l012","ordinal":158525,"en":"We have kept hearing the news."},{"id":"semetey-1-2013:p1066:b007:l013","ordinal":158526,"en":"These are our words of greeting:"},{"id":"semetey-1-2013:p1066:b007:l014","ordinal":158527,"en":"Do they live safe and well,"},{"id":"semetey-1-2013:p1066:b007:l015","ordinal":158528,"en":"The inheritance your father left,"},{"id":"semetey-1-2013:p1066:b007:l016","ordinal":158529,"en":"Your people of the six Kyrgyz tribes?"},{"id":"semetey-1-2013:p1066:b007:l017","ordinal":158530,"en":"Argyn and Kyrgyz mingled together,"},{"id":"semetey-1-2013:p1066:b007:l018","ordinal":158531,"en":"Are all of you safe?"},{"id":"semetey-1-2013:p1066:b007:l019","ordinal":158532,"en":"Shield of the peoples of the world,"},{"id":"semetey-1-2013:p1066:b007:l020","ordinal":158533,"en":"Your aged Bakay?"},{"id":"semetey-1-2013:p1067:b003:l001","ordinal":158534,"en":"My son, does it stand safe and sound,"},{"id":"semetey-1-2013:p1067:b003:l002","ordinal":158535,"en":"Your tethering line set up in Talas?"},{"id":"semetey-1-2013:p1067:b003:l003","ordinal":158536,"en":"And aged Chyyyrdy,"},{"id":"semetey-1-2013:p1067:b003:l004","ordinal":158537,"en":"And dear lady Kanykey—"},{"id":"semetey-1-2013:p1067:b003:l005","ordinal":158538,"en":"Does she live safe and sound,"},{"id":"semetey-1-2013:p1067:b003:l006","ordinal":158539,"en":"Your mother who suffered torment?"},{"id":"semetey-1-2013:p1067:b003:l007","ordinal":158540,"en":"Is your divided people still there?"},{"id":"semetey-1-2013:p1067:b003:l008","ordinal":158541,"en":"And Bölökbay, who guarded"},{"id":"semetey-1-2013:p1067:b003:l009","ordinal":158542,"en":"Manas's treasury and was"},{"id":"semetey-1-2013:p1067:b003:l010","ordinal":158543,"en":"A friend to the giant Dөөтү—is he alive?"},{"id":"semetey-1-2013:p1067:b003:l011","ordinal":158544,"en":"Did you safely find"},{"id":"semetey-1-2013:p1067:b003:l012","ordinal":158545,"en":"The remnant of the scattered people?"},{"id":"semetey-1-2013:p1067:b003:l013","ordinal":158546,"en":"Did you safely find"},{"id":"semetey-1-2013:p1067:b003:l014","ordinal":158547,"en":"The descendants of Almambet and Chubak?"},{"id":"semetey-1-2013:p1067:b003:l015","ordinal":158548,"en":"Did you see within Talas"},{"id":"semetey-1-2013:p1067:b003:l016","ordinal":158549,"en":"Your fox like a gray hare?"},{"id":"semetey-1-2013:p1067:b003:l017","ordinal":158550,"en":"Did you take back without scattering any"},{"id":"semetey-1-2013:p1067:b003:l018","ordinal":158551,"en":"Your property left by Manas?!"},{"id":"semetey-1-2013:p1067:b003:l019","ordinal":158552,"en":"If we follow the words of tradition,"},{"id":"semetey-1-2013:p1067:b003:l020","ordinal":158553,"en":"If we ask those who know,"},{"id":"semetey-1-2013:p1067:b003:l021","ordinal":158554,"en":"We heard news of you from Bukhara."},{"id":"semetey-1-2013:p1067:b003:l022","ordinal":158555,"en":"We have kept safe"},{"id":"semetey-1-2013:p1067:b003:l023","ordinal":158556,"en":"Your wife, Aychürök."},{"id":"semetey-1-2013:p1067:b003:l024","ordinal":158557,"en":"Because of where she had gone,"},{"id":"semetey-1-2013:p1067:b003:l025","ordinal":158558,"en":"Because of your bride,"},{"id":"semetey-1-2013:p1067:b003:l026","ordinal":158559,"en":"A lamb's meat seemed a fur coat to us;"},{"id":"semetey-1-2013:p1067:b003:l027","ordinal":158560,"en":"We saw hell loom terribly great."},{"id":"semetey-1-2013:p1067:b003:l028","ordinal":158561,"en":"Because of Aychürök,"},{"id":"semetey-1-2013:p1067:b003:l029","ordinal":158562,"en":"Embers sprang from the hearth;"},{"id":"semetey-1-2013:p1067:b003:l030","ordinal":158563,"en":"Demanding, 'Give us Aychürök,'"},{"id":"semetey-1-2013:p1067:b003:l031","ordinal":158564,"en":"Mighty Chynkozho and Toltoy arose!\""},{"id":"semetey-1-2013:p1067:b003:l032","ordinal":158565,"en":"Beginning his account with Chynkozho,"},{"id":"semetey-1-2013:p1067:b003:l033","ordinal":158566,"en":"While he stood saying this,"},{"id":"semetey-1-2013:p1067:b003:l034","ordinal":158567,"en":"The young prince Semetey,"},{"id":"semetey-1-2013:p1067:b003:l035","ordinal":158568,"en":"That dear lion, proud as a cock,"},{"id":"semetey-1-2013:p1067:b003:l036","ordinal":158569,"en":"Stirred and began to speak;"},{"id":"semetey-1-2013:p1067:b003:l037","ordinal":158570,"en":"The dear hero returned the greeting:"},{"id":"semetey-1-2013:p1067:b003:l038","ordinal":158571,"en":"\"The people are safe, the khan is safe,"},{"id":"semetey-1-2013:p1067:b003:l039","ordinal":158572,"en":"Lion Bakay too is safe;"},{"id":"semetey-1-2013:p1067:b005:l001","ordinal":158573,"en":"The land of Zhylygnduu and Keng-Kol is safe,"},{"id":"semetey-1-2013:p1067:b005:l002","ordinal":158574,"en":"The happy Kyrgyz people are safe."},{"id":"semetey-1-2013:p1067:b005:l003","ordinal":158575,"en":"Kanykey and Chyyyrdy,"},{"id":"semetey-1-2013:p1067:b005:l004","ordinal":158576,"en":"My two mothers, are safe."},{"id":"semetey-1-2013:p1067:b005:l005","ordinal":158577,"en":"Let us greet one another, elder in-law;"},{"id":"semetey-1-2013:p1067:b005:l006","ordinal":158578,"en":"You whom I have newly seen are safe."},{"id":"semetey-1-2013:p1067:b005:l007","ordinal":158579,"en":"Our fox that goes forth like poison,"},{"id":"semetey-1-2013:p1067:b005:l008","ordinal":158580,"en":"Is lying safe and sound,"},{"id":"semetey-1-2013:p1067:b005:l009","ordinal":158581,"en":"Our inheritance left by our father."},{"id":"semetey-1-2013:p1067:b005:l010","ordinal":158582,"en":"We have come to act as intermediaries;"},{"id":"semetey-1-2013:p1067:b005:l011","ordinal":158583,"en":"Our intentions are pure."},{"id":"semetey-1-2013:p1067:b005:l012","ordinal":158584,"en":"Do they live safe and sound,"},{"id":"semetey-1-2013:p1067:b005:l013","ordinal":158585,"en":"My two elder in-laws,"},{"id":"semetey-1-2013:p1067:b005:l014","ordinal":158586,"en":"Your Afghan people at Opol?"},{"id":"semetey-1-2013:p1067:b005:l015","ordinal":158587,"en":"Our influence reaches our Kozho;"},{"id":"semetey-1-2013:p1067:b005:l016","ordinal":158588,"en":"Do your Afghan people here"},{"id":"semetey-1-2013:p1067:b005:l017","ordinal":158589,"en":"Remain undisturbed and safe?\""},{"id":"semetey-1-2013:p1067:b005:l018","ordinal":158590,"en":"From atop the golden throne,"},{"id":"semetey-1-2013:p1067:b005:l019","ordinal":158591,"en":"Your gray-maned lion, sitting unmoved,"},{"id":"semetey-1-2013:p1067:b005:l020","ordinal":158592,"en":"Leaned forward and stretched out his hand."},{"id":"semetey-1-2013:p1067:b005:l021","ordinal":158593,"en":"What else could Azhybay and Tümönbay do"},{"id":"semetey-1-2013:p1067:b005:l022","ordinal":158594,"en":"But panic?"},{"id":"semetey-1-2013:p1067:b005:l023","ordinal":158595,"en":"Both stretched out their hands,"},{"id":"semetey-1-2013:p1067:b005:l024","ordinal":158596,"en":"Struck by God in their haste."},{"id":"semetey-1-2013:p1067:b005:l025","ordinal":158597,"en":"Semetey, son of Manas,"},{"id":"semetey-1-2013:p1067:b005:l026","ordinal":158598,"en":"Stretched his hand toward the two;"},{"id":"semetey-1-2013:p1067:b005:l027","ordinal":158599,"en":"When he grasped them both together,"},{"id":"semetey-1-2013:p1067:b005:l028","ordinal":158600,"en":"They did not even fill his palm."},{"id":"semetey-1-2013:p1067:b005:l029","ordinal":158601,"en":"\"Would a hero fail to take interest"},{"id":"semetey-1-2013:p1067:b005:l030","ordinal":158602,"en":"In such feeble men?"},{"id":"semetey-1-2013:p1067:b005:l031","ordinal":158603,"en":"If two thousand weaklings like these"},{"id":"semetey-1-2013:p1067:b005:l032","ordinal":158604,"en":"Came together as one,"},{"id":"semetey-1-2013:p1067:b005:l033","ordinal":158605,"en":"Would my poor head be satisfied?"},{"id":"semetey-1-2013:p1067:b005:l034","ordinal":158606,"en":"Weak men like these—"},{"id":"semetey-1-2013:p1067:b005:l035","ordinal":158607,"en":"Would Toltoy and Chynkozho fail"},{"id":"semetey-1-2013:p1067:b005:l036","ordinal":158608,"en":"To heap humiliation upon their heads"},{"id":"semetey-1-2013:p1067:b005:l037","ordinal":158609,"en":"And shut them away?"},{"id":"semetey-1-2013:p1067:b005:l038","ordinal":158610,"en":"Your young champion, son of the blood-taker,"},{"id":"semetey-1-2013:p1067:b005:l039","ordinal":158611,"en":"Held both men's hands at once,"},{"id":"semetey-1-2013:p1068:b003:l001","ordinal":158612,"en":"His palm was still not filled."},{"id":"semetey-1-2013:p1068:b003:l002","ordinal":158613,"en":"Aychürök, daughter of Akun,"},{"id":"semetey-1-2013:p1068:b003:l003","ordinal":158614,"en":"Disparaging the two men,"},{"id":"semetey-1-2013:p1068:b003:l004","ordinal":158615,"en":"She now spoke plainly:"},{"id":"semetey-1-2013:p1068:b003:l005","ordinal":158616,"en":"\"You have courage but no sense;"},{"id":"semetey-1-2013:p1068:b003:l006","ordinal":158617,"en":"What can I say, my sultan?"},{"id":"semetey-1-2013:p1068:b003:l007","ordinal":158618,"en":"Leave off your foolishness, my prince."},{"id":"semetey-1-2013:p1068:b003:l008","ordinal":158619,"en":"This place is called Opol;"},{"id":"semetey-1-2013:p1068:b003:l009","ordinal":158620,"en":"It is no land like Talas."},{"id":"semetey-1-2013:p1068:b003:l010","ordinal":158621,"en":"Your elder in-law is not your own people."},{"id":"semetey-1-2013:p1068:b003:l011","ordinal":158622,"en":"Your village is in Talas;"},{"id":"semetey-1-2013:p1068:b003:l012","ordinal":158623,"en":"These Afghans are your wife's kin."},{"id":"semetey-1-2013:p1068:b003:l013","ordinal":158624,"en":"If you trust your elder in-law,"},{"id":"semetey-1-2013:p1068:b003:l014","ordinal":158625,"en":"My prince, all news of you will vanish!"},{"id":"semetey-1-2013:p1068:b003:l015","ordinal":158626,"en":"When it comes to speaking reason,"},{"id":"semetey-1-2013:p1068:b003:l016","ordinal":158627,"en":"Does your elder in-law have words?"},{"id":"semetey-1-2013:p1068:b003:l017","ordinal":158628,"en":"When it comes to carrying a matchmaker's gift,"},{"id":"semetey-1-2013:p1068:b003:l018","ordinal":158629,"en":"Does your elder in-law have skill?"},{"id":"semetey-1-2013:p1068:b003:l019","ordinal":158630,"en":"His tongue is eloquent, but he has no wisdom;"},{"id":"semetey-1-2013:p1068:b003:l020","ordinal":158631,"en":"There is no infidel like your elder in-law."},{"id":"semetey-1-2013:p1068:b003:l021","ordinal":158632,"en":"To be given to a prepared bridegroom,"},{"id":"semetey-1-2013:p1068:b003:l022","ordinal":158633,"en":"Your elder in-law keeps arranging it;"},{"id":"semetey-1-2013:p1068:b003:l023","ordinal":158634,"en":"Every day your elder in-law drives me on,"},{"id":"semetey-1-2013:p1068:b003:l024","ordinal":158635,"en":"Saying, 'Marry Toltoy!'"},{"id":"semetey-1-2013:p1068:b003:l025","ordinal":158636,"en":"'A blue dress patterned with flowers—"},{"id":"semetey-1-2013:p1068:b003:l026","ordinal":158637,"en":"Put it on,' your elder in-law says!"},{"id":"semetey-1-2013:p1068:b003:l027","ordinal":158638,"en":"'Toltoy of the Zhediger—"},{"id":"semetey-1-2013:p1068:b003:l028","ordinal":158639,"en":"Marry him,' your elder in-law says!"},{"id":"semetey-1-2013:p1068:b003:l029","ordinal":158640,"en":"When he goes between sides and makes strife,"},{"id":"semetey-1-2013:p1068:b003:l030","ordinal":158641,"en":"Does your elder in-law have sense?"},{"id":"semetey-1-2013:p1068:b003:l031","ordinal":158642,"en":"'Toltoy of the Zhediger—"},{"id":"semetey-1-2013:p1068:b003:l032","ordinal":158643,"en":"Marry him every day,' he says,"},{"id":"semetey-1-2013:p1068:b003:l033","ordinal":158644,"en":"And your elder in-law leads me on!"},{"id":"semetey-1-2013:p1068:b003:l034","ordinal":158645,"en":"If I do not go to the Zhediger,"},{"id":"semetey-1-2013:p1068:b003:l035","ordinal":158646,"en":"Your elder in-law means to stretch me on the rack;"},{"id":"semetey-1-2013:p1068:b003:l036","ordinal":158647,"en":"He means to lead me to Toltoy"},{"id":"semetey-1-2013:p1068:b003:l037","ordinal":158648,"en":"And hand me over.\""},{"id":"semetey-1-2013:p1068:b003:l038","ordinal":158649,"en":"After she had spoken thus,"},{"id":"semetey-1-2013:p1068:b003:l039","ordinal":158650,"en":"Azhybay stood and began to speak;"},{"id":"semetey-1-2013:p1068:b004:l001","ordinal":158651,"en":"Azhybay, eloquent beyond measure,"},{"id":"semetey-1-2013:p1068:b004:l002","ordinal":158652,"en":"Spoke softly but struck hard:"},{"id":"semetey-1-2013:p1068:b004:l003","ordinal":158653,"en":"\"Chürök, slander has entered your mind;"},{"id":"semetey-1-2013:p1068:b004:l004","ordinal":158654,"en":"Do not disgrace me"},{"id":"semetey-1-2013:p1068:b004:l005","ordinal":158655,"en":"Before the husband beside you."},{"id":"semetey-1-2013:p1068:b004:l006","ordinal":158656,"en":"You noisy, wretched woman,"},{"id":"semetey-1-2013:p1068:b004:l007","ordinal":158657,"en":"What you said is indeed true;"},{"id":"semetey-1-2013:p1068:b004:l008","ordinal":158658,"en":"All that you said is true!"},{"id":"semetey-1-2013:p1068:b004:l009","ordinal":158659,"en":"To give you to brave Toltoy—"},{"id":"semetey-1-2013:p1068:b004:l010","ordinal":158660,"en":"It is true that I arranged it;"},{"id":"semetey-1-2013:p1068:b004:l011","ordinal":158661,"en":"Driving you on until breathless—"},{"id":"semetey-1-2013:p1068:b004:l012","ordinal":158662,"en":"It is true that I did it!"},{"id":"semetey-1-2013:p1068:b004:l013","ordinal":158663,"en":"Because of what has happened,"},{"id":"semetey-1-2013:p1068:b004:l014","ordinal":158664,"en":"Because of you, Chürök,"},{"id":"semetey-1-2013:p1068:b004:l015","ordinal":158665,"en":"Chynkozho, son of Shygay,"},{"id":"semetey-1-2013:p1068:b004:l016","ordinal":158666,"en":"The Kozho forceful in his deeds,"},{"id":"semetey-1-2013:p1068:b004:l017","ordinal":158667,"en":"In springtime would not let us"},{"id":"semetey-1-2013:p1068:b004:l018","ordinal":158668,"en":"Mount a mare with a flowing mane;"},{"id":"semetey-1-2013:p1068:b004:l019","ordinal":158669,"en":"In wintertime he would not let us"},{"id":"semetey-1-2013:p1068:b004:l020","ordinal":158670,"en":"Eat a fat-tailed yearling sheep."},{"id":"semetey-1-2013:p1068:b004:l021","ordinal":158671,"en":"He brought turmoil upon us"},{"id":"semetey-1-2013:p1068:b004:l022","ordinal":158672,"en":"And came contending for Chürök."},{"id":"semetey-1-2013:p1068:b004:l023","ordinal":158673,"en":"When they laid a foul siege,"},{"id":"semetey-1-2013:p1068:b004:l024","ordinal":158674,"en":"And Toltoy of the Zhediger"},{"id":"semetey-1-2013:p1068:b004:l025","ordinal":158675,"en":"Slaughtered every person"},{"id":"semetey-1-2013:p1068:b004:l026","ordinal":158676,"en":"Who ventured outside,"},{"id":"semetey-1-2013:p1068:b004:l027","ordinal":158677,"en":"We stood and raced our horses;"},{"id":"semetey-1-2013:p1068:b004:l028","ordinal":158678,"en":"Because of you, Aychürök,"},{"id":"semetey-1-2013:p1068:b004:l029","ordinal":158679,"en":"We fired guns and drew bows,"},{"id":"semetey-1-2013:p1068:b004:l030","ordinal":158680,"en":"And stood fighting without fleeing!"},{"id":"semetey-1-2013:p1068:b004:l031","ordinal":158681,"en":"We held our ground for nine months;"},{"id":"semetey-1-2013:p1068:b004:l032","ordinal":158682,"en":"For nine days we fought without rest."},{"id":"semetey-1-2013:p1068:b004:l033","ordinal":158683,"en":"With teeth jutting out,"},{"id":"semetey-1-2013:p1068:b004:l034","ordinal":158684,"en":"Horse corpses became a mountain;"},{"id":"semetey-1-2013:p1068:b004:l035","ordinal":158685,"en":"With mustaches drooping,"},{"id":"semetey-1-2013:p1068:b004:l036","ordinal":158686,"en":"Men's corpses became bundled heaps."},{"id":"semetey-1-2013:p1068:b004:l037","ordinal":158687,"en":"Many formidable beks died;"},{"id":"semetey-1-2013:p1068:b004:l038","ordinal":158688,"en":"Many innocent people died."},{"id":"semetey-1-2013:p1068:b004:l039","ordinal":158689,"en":"Demanding, 'Give us Aychürök,'"},{"id":"semetey-1-2013:p1069:b003:l001","ordinal":158690,"en":"Saying, 'Agree to what I say,'"},{"id":"semetey-1-2013:p1069:b003:l002","ordinal":158691,"en":"They came and overran us again;"},{"id":"semetey-1-2013:p1069:b003:l003","ordinal":158692,"en":"When death drew near,"},{"id":"semetey-1-2013:p1069:b003:l004","ordinal":158693,"en":"When all our strength was gone,"},{"id":"semetey-1-2013:p1069:b003:l005","ordinal":158694,"en":"They would not let us prepare Shamyyan,"},{"id":"semetey-1-2013:p1069:b003:l006","ordinal":158695,"en":"Would not let us plow crops into the earth,"},{"id":"semetey-1-2013:p1069:b003:l007","ordinal":158696,"en":"Would not let us break the earth's surface,"},{"id":"semetey-1-2013:p1069:b003:l008","ordinal":158697,"en":"Would not let us scatter a handful of seed."},{"id":"semetey-1-2013:p1069:b003:l009","ordinal":158698,"en":"After they laid their foul siege,"},{"id":"semetey-1-2013:p1069:b003:l010","ordinal":158699,"en":"After they made all pleasure costly,"},{"id":"semetey-1-2013:p1069:b003:l011","ordinal":158700,"en":"After they slaughtered the people without looking back,"},{"id":"semetey-1-2013:p1069:b003:l012","ordinal":158701,"en":"So the people might be saved,"},{"id":"semetey-1-2013:p1069:b003:l013","ordinal":158702,"en":"It is true that I resolved to agree!"},{"id":"semetey-1-2013:p1069:b003:l014","ordinal":158703,"en":"To Toltoy of the Zhediger,"},{"id":"semetey-1-2013:p1069:b003:l015","ordinal":158704,"en":"To bind you and take you,"},{"id":"semetey-1-2013:p1069:b003:l016","ordinal":158705,"en":"It is true that I meant to give you!"},{"id":"semetey-1-2013:p1069:b003:l017","ordinal":158706,"en":"Corruption has entered your mind;"},{"id":"semetey-1-2013:p1069:b003:l018","ordinal":158707,"en":"Do not bring disgrace"},{"id":"semetey-1-2013:p1069:b003:l019","ordinal":158708,"en":"Before your renowned princely husband."},{"id":"semetey-1-2013:p1069:b003:l020","ordinal":158709,"en":"Who will believe your words?"},{"id":"semetey-1-2013:p1069:b003:l021","ordinal":158710,"en":"Stop playing coy with your husband."},{"id":"semetey-1-2013:p1069:b003:l022","ordinal":158711,"en":"If suffering comes upon me,"},{"id":"semetey-1-2013:p1069:b003:l023","ordinal":158712,"en":"To charge forth and make war,"},{"id":"semetey-1-2013:p1069:b003:l024","ordinal":158713,"en":"I have my Argyn people and my own strength."},{"id":"semetey-1-2013:p1069:b003:l025","ordinal":158714,"en":"You are my lawfully wedded wife in my embrace;"},{"id":"semetey-1-2013:p1069:b003:l026","ordinal":158715,"en":"If hardship presses a son of a bitch,"},{"id":"semetey-1-2013:p1069:b003:l027","ordinal":158716,"en":"I may resolve to give even her away!"},{"id":"semetey-1-2013:p1069:b003:l028","ordinal":158717,"en":"For the waist you have girded,"},{"id":"semetey-1-2013:p1069:b003:l029","ordinal":158718,"en":"Do not keep fiercely maligning"},{"id":"semetey-1-2013:p1069:b003:l030","ordinal":158719,"en":"Your renowned gray-maned husband!"},{"id":"semetey-1-2013:p1069:b003:l031","ordinal":158720,"en":"From his father, gray-maned Manas,"}]
