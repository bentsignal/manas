[{"id":"semetey-1-2013:p0741:b003:l030","ordinal":133121,"en":"It was heroic Shuutu, with a hat like a yurt's roof felt,"},{"id":"semetey-1-2013:p0741:b003:l031","ordinal":133122,"en":"The hawk among humankind,"},{"id":"semetey-1-2013:p0741:b003:l032","ordinal":133123,"en":"Manas, gone to the Last Judgment,"},{"id":"semetey-1-2013:p0741:b003:l033","ordinal":133124,"en":"He had not forgotten, poor soul."},{"id":"semetey-1-2013:p0741:b003:l034","ordinal":133125,"en":"The finest of the forty warriors,"},{"id":"semetey-1-2013:p0741:b003:l035","ordinal":133126,"en":"Wolf-maned Bakai the Leopard's"},{"id":"semetey-1-2013:p0741:b003:l036","ordinal":133127,"en":"Suitable partner for counsel,"},{"id":"semetey-1-2013:p0741:b003:l037","ordinal":133128,"en":"Himself the son of a prince,"},{"id":"semetey-1-2013:p0741:b003:l038","ordinal":133129,"en":"Noble Shuutu, his heroic peer,"},{"id":"semetey-1-2013:p0741:b003:l039","ordinal":133130,"en":"While alive, one to gather with;"},{"id":"semetey-1-2013:p0741:b004:l001","ordinal":133131,"en":"If dead, a companion in faith."},{"id":"semetey-1-2013:p0741:b004:l002","ordinal":133132,"en":"In this Kobosh's hands,"},{"id":"semetey-1-2013:p0741:b004:l003","ordinal":133133,"en":"Powerless, Shuutu the bondsman"},{"id":"semetey-1-2013:p0741:b004:l004","ordinal":133134,"en":"Was in a net forty ropes long."},{"id":"semetey-1-2013:p0741:b004:l005","ordinal":133135,"en":"He went about grieving much:"},{"id":"semetey-1-2013:p0741:b004:l006","ordinal":133136,"en":"“Manas the Leopard,” he kept saying."},{"id":"semetey-1-2013:p0741:b004:l007","ordinal":133137,"en":"“Kanykei left in mourning;"},{"id":"semetey-1-2013:p0741:b004:l008","ordinal":133138,"en":"Semetey fled away."},{"id":"semetey-1-2013:p0741:b004:l009","ordinal":133139,"en":"The Bloodthirsty One's wife and child,"},{"id":"semetey-1-2013:p0741:b004:l010","ordinal":133140,"en":"What became of them?” he kept asking."},{"id":"semetey-1-2013:p0741:b004:l011","ordinal":133141,"en":"He heard accounts from knowledgeable men,"},{"id":"semetey-1-2013:p0741:b004:l012","ordinal":133142,"en":"And asked much of those who knew."},{"id":"semetey-1-2013:p0741:b004:l013","ordinal":133143,"en":"He went about grieving much:"},{"id":"semetey-1-2013:p0741:b004:l014","ordinal":133144,"en":"“My Bloodthirsty One's Semetey,"},{"id":"semetey-1-2013:p0741:b004:l015","ordinal":133145,"en":"Will he come?” he kept asking."},{"id":"semetey-1-2013:p0741:b004:l016","ordinal":133146,"en":"Abyke and Kobosh, the two villains,"},{"id":"semetey-1-2013:p0741:b004:l018","ordinal":133147,"en":"“God has given us Manas,” they said.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0741:b004:l019","ordinal":133148,"en":"Their brows grew bright and clear;"},{"id":"semetey-1-2013:p0741:b004:l020","ordinal":133149,"en":"Their foreboding healed and lifted."},{"id":"semetey-1-2013:p0741:b004:l021","ordinal":133150,"en":"In the marsh of Uyrulmo,"},{"id":"semetey-1-2013:p0741:b004:l022","ordinal":133151,"en":"They gathered in a circle."},{"id":"semetey-1-2013:p0741:b004:l023","ordinal":133152,"en":"In the marsh of Chogulma,"},{"id":"semetey-1-2013:p0741:b004:l024","ordinal":133153,"en":"They assembled together."},{"id":"semetey-1-2013:p0741:b004:l025","ordinal":133154,"en":"Crying, “Baabedin!”"},{"id":"semetey-1-2013:p0741:b004:l026","ordinal":133155,"en":"Raising the war cry, “Kobosh!”"},{"id":"semetey-1-2013:p0741:b004:l027","ordinal":133156,"en":"All the six villains,"},{"id":"semetey-1-2013:p0741:b004:l028","ordinal":133157,"en":"And the elders of the forty warriors, Kyrgyl at their head,"},{"id":"semetey-1-2013:p0741:b004:l030","ordinal":133158,"en":"Abyke and Kobosh justified themselves:"},{"id":"semetey-1-2013:p0741:b004:l031","ordinal":133159,"en":"“We have imposed tribute like this,” they said."},{"id":"semetey-1-2013:p0741:b004:l032","ordinal":133160,"en":"“We have become sultans,” they said."},{"id":"semetey-1-2013:p0741:b004:l033","ordinal":133161,"en":"Abyke, Kobosh, the six villains,"},{"id":"semetey-1-2013:p0741:b004:l034","ordinal":133162,"en":"Boasted to the forty warriors."},{"id":"semetey-1-2013:p0741:b004:l035","ordinal":133163,"en":"In Kobosh's house,"},{"id":"semetey-1-2013:p0741:b004:l036","ordinal":133164,"en":"In the corner was strong liquor,"},{"id":"semetey-1-2013:p0741:b004:l037","ordinal":133165,"en":"Liquor in a Kalmyk-style leather flask."},{"id":"semetey-1-2013:p0741:b004:l038","ordinal":133166,"en":"Opening their tall leather vessels,"},{"id":"semetey-1-2013:p0741:b004:l039","ordinal":133167,"en":"The liquor in flasks and tall leather vessels,"},{"id":"semetey-1-2013:p0742:b003:l001","ordinal":133168,"en":"They opened them and poured it out."},{"id":"semetey-1-2013:p0742:b003:l002","ordinal":133169,"en":"A formidable man, a formidable business,"},{"id":"semetey-1-2013:p0742:b003:l003","ordinal":133170,"en":"Performing rites in Kalmyk fashion,"},{"id":"semetey-1-2013:p0742:b003:l004","ordinal":133171,"en":"Chattering noisily, they offered drinks."},{"id":"semetey-1-2013:p0742:b003:l005","ordinal":133172,"en":"Drinking his liquor, justifying himself,"},{"id":"semetey-1-2013:p0742:b003:l006","ordinal":133173,"en":"That empty-hearted bastard,"},{"id":"semetey-1-2013:p0742:b003:l007","ordinal":133174,"en":"Dog Kobosh stood boasting."},{"id":"semetey-1-2013:p0742:b003:l008","ordinal":133175,"en":"Shouting to the forty warriors,"},{"id":"semetey-1-2013:p0742:b003:l009","ordinal":133176,"en":"Their elders with Kyrgyl at their head,"},{"id":"semetey-1-2013:p0742:b003:l010","ordinal":133177,"en":"He called, “Come here!"},{"id":"semetey-1-2013:p0742:b003:l011","ordinal":133178,"en":"When your mighty Manas lived,"},{"id":"semetey-1-2013:p0742:b003:l012","ordinal":133179,"en":"You forty came from forty different places."},{"id":"semetey-1-2013:p0742:b003:l014","ordinal":133180,"en":"When that simpleton of yours, Manas, lived,"},{"id":"semetey-1-2013:p0742:b003:l015","ordinal":133181,"en":"When were you khans as you are under me?"},{"id":"semetey-1-2013:p0742:b003:l016","ordinal":133182,"en":"When Manas lived,"},{"id":"semetey-1-2013:p0742:b003:l017","ordinal":133183,"en":"You became his equals by fighting his enemies."},{"id":"semetey-1-2013:p0742:b003:l018","ordinal":133184,"en":"Now that I am here,"},{"id":"semetey-1-2013:p0742:b003:l020","ordinal":133185,"en":"When Manas lived,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0742:b003:l021","ordinal":133186,"en":"You wearied yourselves on reconnaissance."},{"id":"semetey-1-2013:p0742:b003:l022","ordinal":133187,"en":"Forty warriors, you grew old fighting."},{"id":"semetey-1-2013:p0742:b003:l024","ordinal":133188,"en":"Your elders suffered humiliation;"},{"id":"semetey-1-2013:p0742:b003:l025","ordinal":133189,"en":"All of you went childless."},{"id":"semetey-1-2013:p0742:b003:l026","ordinal":133190,"en":"Damn you, forty warriors!"},{"id":"semetey-1-2013:p0742:b003:l027","ordinal":133191,"en":"Your day has come—laugh now,"},{"id":"semetey-1-2013:p0742:b003:l028","ordinal":133192,"en":"And recognize this service of mine."},{"id":"semetey-1-2013:p0742:b003:l029","ordinal":133193,"en":"Your misfortune has now been undone;"},{"id":"semetey-1-2013:p0742:b003:l030","ordinal":133194,"en":"Forty warriors, value it dearly."},{"id":"semetey-1-2013:p0742:b003:l031","ordinal":133195,"en":"If I, Kobosh, stand face to face,"},{"id":"semetey-1-2013:p0742:b003:l032","ordinal":133196,"en":"I strike down one as huge as a mountain."},{"id":"semetey-1-2013:p0742:b003:l033","ordinal":133197,"en":"At this very moment,"},{"id":"semetey-1-2013:p0742:b003:l034","ordinal":133198,"en":"What have I become?"},{"id":"semetey-1-2013:p0742:b003:l035","ordinal":133199,"en":"Forty warriors, judge it all in turn."},{"id":"semetey-1-2013:p0742:b003:l036","ordinal":133200,"en":"What were the days of Manas like?"},{"id":"semetey-1-2013:p0742:b003:l037","ordinal":133201,"en":"What are my days like?"},{"id":"semetey-1-2013:p0742:b003:l038","ordinal":133202,"en":"Forty warriors, judge today!"},{"id":"semetey-1-2013:p0742:b003:l039","ordinal":133203,"en":"Forty warriors, sing your song;"},{"id":"semetey-1-2013:p0742:b004:l001","ordinal":133204,"en":"Tell your secret as truthfully as your faith.”"},{"id":"semetey-1-2013:p0742:b004:l002","ordinal":133205,"en":"Puffing and swelling with pride,"},{"id":"semetey-1-2013:p0742:b004:l003","ordinal":133206,"en":"While Kobosh stood thus,"},{"id":"semetey-1-2013:p0742:b004:l004","ordinal":133207,"en":"Kyrgyl and Tazbaimat,"},{"id":"semetey-1-2013:p0742:b004:l005","ordinal":133208,"en":"Fawning and flattering,"},{"id":"semetey-1-2013:p0742:b004:l006","ordinal":133209,"en":"Cowered beneath Kobosh's arm."},{"id":"semetey-1-2013:p0742:b004:l007","ordinal":133210,"en":"When God had struck Kyrgyl,"},{"id":"semetey-1-2013:p0742:b004:l008","ordinal":133211,"en":"While he stood flattering,"},{"id":"semetey-1-2013:p0742:b004:l009","ordinal":133212,"en":"What could poor Kyrgyl do?"},{"id":"semetey-1-2013:p0742:b004:l011","ordinal":133213,"en":"Of the six struck by darkness,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0742:b004:l012","ordinal":133214,"en":"He could find not one heroic deed."},{"id":"semetey-1-2013:p0742:b004:l013","ordinal":133215,"en":"Looking, he could meet no one's eyes;"},{"id":"semetey-1-2013:p0742:b004:l014","ordinal":133216,"en":"Trying to speak, no words came."},{"id":"semetey-1-2013:p0742:b004:l015","ordinal":133217,"en":"There was no saddlecloth to saddle up and ride,"},{"id":"semetey-1-2013:p0742:b004:l016","ordinal":133218,"en":"Nor courage to cleave the ranks."},{"id":"semetey-1-2013:p0742:b004:l017","ordinal":133219,"en":"Deeply ashamed, Kyrgylchal"},{"id":"semetey-1-2013:p0742:b004:l018","ordinal":133220,"en":"Toppled and fell sideways."},{"id":"semetey-1-2013:p0742:b004:l019","ordinal":133221,"en":"God-stricken Tazbaimat"},{"id":"semetey-1-2013:p0742:b004:l020","ordinal":133222,"en":"Stood scratching at the earth."},{"id":"semetey-1-2013:p0742:b004:l021","ordinal":133223,"en":"Khan Manas's forty warriors,"},{"id":"semetey-1-2013:p0742:b004:l022","ordinal":133224,"en":"When looked at, not one spoke."},{"id":"semetey-1-2013:p0742:b004:l023","ordinal":133225,"en":"As though struck dumb,"},{"id":"semetey-1-2013:p0742:b004:l024","ordinal":133226,"en":"Not one said a word to Kobosh."},{"id":"semetey-1-2013:p0742:b004:l025","ordinal":133227,"en":"As though struck dumb,"},{"id":"semetey-1-2013:p0742:b004:l026","ordinal":133228,"en":"They were left speechless."},{"id":"semetey-1-2013:p0742:b004:l027","ordinal":133229,"en":"Their elders, Kyrgyl at their head,"},{"id":"semetey-1-2013:p0742:b004:l028","ordinal":133230,"en":"Shifted uneasily and scratched the ground,"},{"id":"semetey-1-2013:p0742:b004:l029","ordinal":133231,"en":"All the forty warriors."},{"id":"semetey-1-2013:p0742:b004:l030","ordinal":133232,"en":"Among those warriors,"},{"id":"semetey-1-2013:p0742:b004:l031","ordinal":133233,"en":"Heroic Shuutu, with a hat like a yurt's roof felt,"},{"id":"semetey-1-2013:p0742:b004:l032","ordinal":133234,"en":"And Yraman's son Yrchy,"},{"id":"semetey-1-2013:p0742:b004:l033","ordinal":133235,"en":"These two spoke the truth."},{"id":"semetey-1-2013:p0742:b004:l034","ordinal":133236,"en":"They said bitter things that pierced the marrow:"},{"id":"semetey-1-2013:p0742:b004:l035","ordinal":133237,"en":"“What was Manas like, what a lion!"},{"id":"semetey-1-2013:p0742:b004:l036","ordinal":133238,"en":"When bloodthirsty Manas lived,"},{"id":"semetey-1-2013:p0742:b004:l037","ordinal":133239,"en":"What were the days we passed like?"},{"id":"semetey-1-2013:p0742:b004:l038","ordinal":133240,"en":"Speak today, Khan Kobosh,"},{"id":"semetey-1-2013:p0742:b004:l039","ordinal":133241,"en":"Like roasted flour stirred into water,"},{"id":"semetey-1-2013:p0743:b003:l001","ordinal":133242,"en":"When wolf-maned Manas lived,"},{"id":"semetey-1-2013:p0743:b003:l002","ordinal":133243,"en":"We fought with many lands;"},{"id":"semetey-1-2013:p0743:b003:l003","ordinal":133244,"en":"We raided their horses openly."},{"id":"semetey-1-2013:p0743:b003:l004","ordinal":133245,"en":"We jousted with many giants;"},{"id":"semetey-1-2013:p0743:b003:l005","ordinal":133246,"en":"We satisfied every itching urge,"},{"id":"semetey-1-2013:p0743:b003:l006","ordinal":133247,"en":"And lived immersed in delight."},{"id":"semetey-1-2013:p0743:b003:l007","ordinal":133248,"en":"Into liquor poured in leather flasks like yours,"},{"id":"semetey-1-2013:p0743:b003:l009","ordinal":133249,"en":"When wild fury seized us,"},{"id":"semetey-1-2013:p0743:b003:l010","ordinal":133250,"en":"We would grasp such a flask by its mouth,"},{"id":"semetey-1-2013:p0743:b003:l011","ordinal":133251,"en":"And piss into it in a stream."},{"id":"semetey-1-2013:p0743:b003:l012","ordinal":133252,"en":"You gathered forty warriors and became khan;"},{"id":"semetey-1-2013:p0743:b003:l013","ordinal":133253,"en":"Uncle Kobosh, when will you perform a heroic deed?"},{"id":"semetey-1-2013:p0743:b003:l014","ordinal":133254,"en":"These words of yours are empty talk;"},{"id":"semetey-1-2013:p0743:b003:l015","ordinal":133255,"en":"Uncle Kobosh, you stand praising your liquor."},{"id":"semetey-1-2013:p0743:b003:l016","ordinal":133256,"en":"Liquor is bitter fare;"},{"id":"semetey-1-2013:p0743:b003:l017","ordinal":133257,"en":"The drinker's head becomes confused."},{"id":"semetey-1-2013:p0743:b003:l018","ordinal":133258,"en":"A man who has filled himself with liquor"},{"id":"semetey-1-2013:p0743:b003:l019","ordinal":133259,"en":"Attacks even his own mother."},{"id":"semetey-1-2013:p0743:b003:l020","ordinal":133260,"en":"You boast of your liquor and food;"},{"id":"semetey-1-2013:p0743:b003:l021","ordinal":133261,"en":"Whenever I look,"},{"id":"semetey-1-2013:p0743:b003:l022","ordinal":133262,"en":"Your brow never leaves the house."},{"id":"semetey-1-2013:p0743:b003:l023","ordinal":133263,"en":"When bloodthirsty Manas lived,"},{"id":"semetey-1-2013:p0743:b003:l024","ordinal":133264,"en":"When the Leopard was alive,"},{"id":"semetey-1-2013:p0743:b003:l025","ordinal":133265,"en":"Damn you, forty warriors!"},{"id":"semetey-1-2013:p0743:b003:l026","ordinal":133266,"en":"We all settled in Talas;"},{"id":"semetey-1-2013:p0743:b003:l027","ordinal":133267,"en":"We became Manas's warriors."},{"id":"semetey-1-2013:p0743:b003:l028","ordinal":133268,"en":"Fattening our horses, we grew skilled;"},{"id":"semetey-1-2013:p0743:b003:l029","ordinal":133269,"en":"Camping as neighbors, we became forty."},{"id":"semetey-1-2013:p0743:b003:l030","ordinal":133270,"en":"When Manas the Tiger lived,"},{"id":"semetey-1-2013:p0743:b003:l031","ordinal":133271,"en":"We fought the enemy together;"},{"id":"semetey-1-2013:p0743:b003:l032","ordinal":133272,"en":"We pressed our claims together;"},{"id":"semetey-1-2013:p0743:b003:l033","ordinal":133273,"en":"We scouted together;"},{"id":"semetey-1-2013:p0743:b003:l034","ordinal":133274,"en":"We took horses from foreign-speaking peoples."},{"id":"semetey-1-2013:p0743:b003:l035","ordinal":133275,"en":"With Manas the Leopard, that lion,"},{"id":"semetey-1-2013:p0743:b003:l036","ordinal":133276,"en":"When did we ever fall out?"},{"id":"semetey-1-2013:p0743:b003:l037","ordinal":133277,"en":"In death we died together;"},{"id":"semetey-1-2013:p0743:b003:l038","ordinal":133278,"en":"We enjoyed happiness together."},{"id":"semetey-1-2013:p0743:b004:l001","ordinal":133279,"en":"We threw into the middle,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0743:b004:l002","ordinal":133280,"en":"And split it into equal shares."},{"id":"semetey-1-2013:p0743:b004:l003","ordinal":133281,"en":"With sovereign Manas the Lion,"},{"id":"semetey-1-2013:p0743:b004:l004","ordinal":133282,"en":"We united when tiny as lice;"},{"id":"semetey-1-2013:p0743:b004:l005","ordinal":133283,"en":"We joined when thumb-small."},{"id":"semetey-1-2013:p0743:b004:l006","ordinal":133284,"en":"When we lived in open delight,"},{"id":"semetey-1-2013:p0743:b004:l007","ordinal":133285,"en":"Each of you forty warriors,"},{"id":"semetey-1-2013:p0743:b004:l008","ordinal":133286,"en":"Into your treasuries yellow gold"},{"id":"semetey-1-2013:p0743:b004:l009","ordinal":133287,"en":"Was being weighed in equal loads."},{"id":"semetey-1-2013:p0743:b004:l010","ordinal":133288,"en":"When bored, we shot roe deer;"},{"id":"semetey-1-2013:p0743:b004:l011","ordinal":133289,"en":"When not bored, in Talas,"},{"id":"semetey-1-2013:p0743:b004:l012","ordinal":133290,"en":"We rode two-year-olds and flew hawks,"},{"id":"semetey-1-2013:p0743:b004:l013","ordinal":133291,"en":"And played in wild delight."},{"id":"semetey-1-2013:p0743:b004:l014","ordinal":133292,"en":"When Manas the Swift Steed lived,"},{"id":"semetey-1-2013:p0743:b004:l015","ordinal":133293,"en":"Whole otter pelts"},{"id":"semetey-1-2013:p0743:b004:l016","ordinal":133294,"en":"We would split in half,"},{"id":"semetey-1-2013:p0743:b004:l017","ordinal":133295,"en":"And made them into trouser legs."},{"id":"semetey-1-2013:p0743:b004:l018","ordinal":133296,"en":"When Manas the Leopard lived,"},{"id":"semetey-1-2013:p0743:b004:l019","ordinal":133297,"en":"Untouched by a further spear-thrust,"},{"id":"semetey-1-2013:p0743:b004:l020","ordinal":133298,"en":"No people remained intact."},{"id":"semetey-1-2013:p0743:b004:l021","ordinal":133299,"en":"Untrodden by our noble winged steeds,"},{"id":"semetey-1-2013:p0743:b004:l022","ordinal":133300,"en":"No land remained intact."},{"id":"semetey-1-2013:p0743:b004:l023","ordinal":133301,"en":"When noble Manas lived,"},{"id":"semetey-1-2013:p0743:b004:l024","ordinal":133302,"en":"We drove white deer and made them cattle;"},{"id":"semetey-1-2013:p0743:b004:l025","ordinal":133303,"en":"We threw the enemy we fought into confusion."},{"id":"semetey-1-2013:p0743:b004:l026","ordinal":133304,"en":"Anyone who played the ruler,"},{"id":"semetey-1-2013:p0743:b004:l027","ordinal":133305,"en":"We fell upon without mercy and quarreled with."},{"id":"semetey-1-2013:p0743:b004:l028","ordinal":133306,"en":"We drove gray deer and made them cattle."},{"id":"semetey-1-2013:p0743:b004:l029","ordinal":133307,"en":"When wolf-maned Manas lived,"},{"id":"semetey-1-2013:p0743:b004:l030","ordinal":133308,"en":"We threw our chosen enemy into confusion."},{"id":"semetey-1-2013:p0743:b004:l031","ordinal":133309,"en":"If anyone grew puffed up,"},{"id":"semetey-1-2013:p0743:b004:l032","ordinal":133310,"en":"We openly worked him like softened hide."},{"id":"semetey-1-2013:p0743:b004:l033","ordinal":133311,"en":"We filled our cartridge pouches with bullets."},{"id":"semetey-1-2013:p0743:b004:l034","ordinal":133312,"en":"When Manas lived,"},{"id":"semetey-1-2013:p0743:b004:l035","ordinal":133313,"en":"We wiped out our chosen enemy."},{"id":"semetey-1-2013:p0743:b004:l036","ordinal":133314,"en":"Truly, when Manas lived,"},{"id":"semetey-1-2013:p0743:b004:l037","ordinal":133315,"en":"All you warriors were in earnest."},{"id":"semetey-1-2013:p0743:b004:l038","ordinal":133316,"en":"Here is your elder Kyrgyl."},{"id":"semetey-1-2013:p0743:b004:l039","ordinal":133317,"en":"When we blocked Chylan's road,"},{"id":"semetey-1-2013:p0744:b003:l001","ordinal":133318,"en":"Upon Beijing of Chynmachyn"},{"id":"semetey-1-2013:p0744:b003:l002","ordinal":133319,"en":"We unleashed a true upheaval."},{"id":"semetey-1-2013:p0744:b003:l003","ordinal":133320,"en":"Of the Black Kalmyk Zholoy's"},{"id":"semetey-1-2013:p0744:b003:l004","ordinal":133321,"en":"Sixty giants we killed,"},{"id":"semetey-1-2013:p0744:b003:l005","ordinal":133322,"en":"And took his tea on a thousand camels."},{"id":"semetey-1-2013:p0744:b003:l006","ordinal":133323,"en":"Together we unleashed a battle."},{"id":"semetey-1-2013:p0744:b003:l007","ordinal":133324,"en":"Before the valiant, gray-maned Manas,"},{"id":"semetey-1-2013:p0744:b003:l008","ordinal":133325,"en":"Any mortal who faced him lay prostrate,"},{"id":"semetey-1-2013:p0744:b003:l009","ordinal":133326,"en":"Those who came to face him fell."},{"id":"semetey-1-2013:p0744:b003:l010","ordinal":133327,"en":"Of that Manas's turmoil,"},{"id":"semetey-1-2013:p0744:b003:l011","ordinal":133328,"en":"When they took heed and heard,"},{"id":"semetey-1-2013:p0744:b003:l012","ordinal":133329,"en":"Of Beijing in Kakanchyn,"},{"id":"semetey-1-2013:p0744:b003:l013","ordinal":133330,"en":"Karykan wept."},{"id":"semetey-1-2013:p0744:b003:l014","ordinal":133331,"en":"You cannot equal Manas."},{"id":"semetey-1-2013:p0744:b003:l015","ordinal":133332,"en":"Take heed, good-for-nothing Kobosh!"},{"id":"semetey-1-2013:p0744:b003:l016","ordinal":133333,"en":"When I think of Manas,"},{"id":"semetey-1-2013:p0744:b003:l017","ordinal":133334,"en":"I burn and blaze like fire."},{"id":"semetey-1-2013:p0744:b003:l018","ordinal":133335,"en":"I would die, but life is sweet;"},{"id":"semetey-1-2013:p0744:b003:l019","ordinal":133336,"en":"That is why I do not die."},{"id":"semetey-1-2013:p0744:b003:l020","ordinal":133337,"en":"When Manas, our noble steed, lived,"},{"id":"semetey-1-2013:p0744:b003:l021","ordinal":133338,"en":"We broke into Ombu and took spoils."},{"id":"semetey-1-2013:p0744:b003:l022","ordinal":133339,"en":"We broke through its center and made a road."},{"id":"semetey-1-2013:p0744:b003:l023","ordinal":133340,"en":"We took abundant plunder there."},{"id":"semetey-1-2013:p0744:b003:l024","ordinal":133341,"en":"In those days we made Kakan's people weep."},{"id":"semetey-1-2013:p0744:b003:l025","ordinal":133342,"en":"The Black Chinese and the Manchu—"},{"id":"semetey-1-2013:p0744:b003:l026","ordinal":133343,"en":"We slaughtered and destroyed them all."},{"id":"semetey-1-2013:p0744:b003:l027","ordinal":133344,"en":"We made Kakan's people lament."},{"id":"semetey-1-2013:p0744:b003:l028","ordinal":133345,"en":"Khan Kongurbai and Karykan—"},{"id":"semetey-1-2013:p0744:b003:l029","ordinal":133346,"en":"We openly crippled them thus."},{"id":"semetey-1-2013:p0744:b003:l030","ordinal":133347,"en":"When magnanimous Manas lived,"},{"id":"semetey-1-2013:p0744:b003:l031","ordinal":133348,"en":"From the Six Cities and Kokand"},{"id":"semetey-1-2013:p0744:b003:l032","ordinal":133349,"en":"We took tribute."},{"id":"semetey-1-2013:p0744:b003:l033","ordinal":133350,"en":"When noble Manas lived,"},{"id":"semetey-1-2013:p0744:b003:l034","ordinal":133351,"en":"We used to humble Kokand."},{"id":"semetey-1-2013:p0744:b003:l035","ordinal":133352,"en":"Six thousand ingots and a thousand otter pelts"},{"id":"semetey-1-2013:p0744:b003:l036","ordinal":133353,"en":"We used to take as tribute."},{"id":"semetey-1-2013:p0744:b003:l037","ordinal":133354,"en":"Such were the pleasures we enjoyed;"},{"id":"semetey-1-2013:p0744:b003:l038","ordinal":133355,"en":"Such was the wealth we amassed."},{"id":"semetey-1-2013:p0744:b003:l039","ordinal":133356,"en":"Now, Kobosh, in your time,"},{"id":"semetey-1-2013:p0744:b004:l001","ordinal":133357,"en":"We have become great fools."},{"id":"semetey-1-2013:p0744:b004:l002","ordinal":133358,"en":"Giving us no shit, let alone tribute,"},{"id":"semetey-1-2013:p0744:b004:l003","ordinal":133359,"en":"The Six Cities have gone their own way."},{"id":"semetey-1-2013:p0744:b004:l004","ordinal":133360,"en":"Alas, when Manas lived,"},{"id":"semetey-1-2013:p0744:b004:l005","ordinal":133361,"en":"We raided everywhere and took skilled craftswomen."},{"id":"semetey-1-2013:p0744:b004:l006","ordinal":133362,"en":"We raided the Afghans and took elephants."},{"id":"semetey-1-2013:p0744:b004:l007","ordinal":133363,"en":"We took gold coins loaded on elephants."},{"id":"semetey-1-2013:p0744:b004:l008","ordinal":133364,"en":"We took a thousand dark-eyed women."},{"id":"semetey-1-2013:p0744:b004:l009","ordinal":133365,"en":"When devastating Manas lived,"},{"id":"semetey-1-2013:p0744:b004:l010","ordinal":133366,"en":"When the forty warriors were mighty,"},{"id":"semetey-1-2013:p0744:b004:l011","ordinal":133367,"en":"Why did I not die then?\""},{"id":"semetey-1-2013:p0744:b004:l012","ordinal":133368,"en":"So spoke the hero Shuutu,"},{"id":"semetey-1-2013:p0744:b004:l013","ordinal":133369,"en":"Remembering Khan Manas often,"},{"id":"semetey-1-2013:p0744:b004:l014","ordinal":133370,"en":"Recalling him: \"Do not die, Manas!\""},{"id":"semetey-1-2013:p0744:b004:l015","ordinal":133371,"en":"Voicing his grievance to God,"},{"id":"semetey-1-2013:p0744:b004:l016","ordinal":133372,"en":"He was sobbing bitterly."},{"id":"semetey-1-2013:p0744:b004:l017","ordinal":133373,"en":"That day the forty warriors"},{"id":"semetey-1-2013:p0744:b004:l018","ordinal":133374,"en":"Had drunk liquor and run wild,"},{"id":"semetey-1-2013:p0744:b004:l019","ordinal":133375,"en":"With little thought in their heads,"},{"id":"semetey-1-2013:p0744:b004:l020","ordinal":133376,"en":"Blind drunk,"}]
