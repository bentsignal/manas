[{"id":"semetey-1-2013:p0916:b004:l035","ordinal":146177,"en":"When the orphan clenched them,"},{"id":"semetey-1-2013:p0916:b004:l036","ordinal":146178,"en":"Broke apart like grains of millet."},{"id":"semetey-1-2013:p0916:b004:l038","ordinal":146179,"en":"Now he would give them a tale to tell!","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0916:b004:l039","ordinal":146180,"en":"That son of the oceanlike hero"},{"id":"semetey-1-2013:p0917:b003:l001","ordinal":146181,"en":"Did not look about him,"},{"id":"semetey-1-2013:p0917:b003:l002","ordinal":146182,"en":"And spared his life not at all."},{"id":"semetey-1-2013:p0917:b003:l003","ordinal":146183,"en":"Boz Kise, fallen from heaven,"},{"id":"semetey-1-2013:p0917:b003:l004","ordinal":146184,"en":"He girded on, crying “Allah!”"},{"id":"semetey-1-2013:p0917:b003:l005","ordinal":146185,"en":"Zulfiqar, left by his father Khan Manas,"},{"id":"semetey-1-2013:p0917:b003:l007","ordinal":146186,"en":"He grasped by its hilt"},{"id":"semetey-1-2013:p0917:b003:l008","ordinal":146187,"en":"And drew from its sheath."},{"id":"semetey-1-2013:p0917:b003:l009","ordinal":146188,"en":"In one of the orphan's hands"},{"id":"semetey-1-2013:p0917:b003:l010","ordinal":146189,"en":"Was the gold-cheeked battle-axe;"},{"id":"semetey-1-2013:p0917:b003:l011","ordinal":146190,"en":"Beneath the orphan's thigh"},{"id":"semetey-1-2013:p0917:b003:l012","ordinal":146191,"en":"Was Syrnaiza, left by Manas."},{"id":"semetey-1-2013:p0917:b003:l013","ordinal":146192,"en":"At his right side could be seen"},{"id":"semetey-1-2013:p0917:b003:l014","ordinal":146193,"en":"A gilded pouch."},{"id":"semetey-1-2013:p0917:b003:l015","ordinal":146194,"en":"Those who saw him were troubled."},{"id":"semetey-1-2013:p0917:b003:l016","ordinal":146195,"en":"Your orphan, the gray-maned hero's son,"},{"id":"semetey-1-2013:p0917:b003:l017","ordinal":146196,"en":"Appeared as great as Mount Opol."},{"id":"semetey-1-2013:p0917:b003:l018","ordinal":146197,"en":"Girding on a golden belt,"},{"id":"semetey-1-2013:p0917:b003:l019","ordinal":146198,"en":"Light shone upon his moonlike face."},{"id":"semetey-1-2013:p0917:b003:l020","ordinal":146199,"en":"Girding on a silver belt,"},{"id":"semetey-1-2013:p0917:b003:l021","ordinal":146200,"en":"Light shone upon his sunlike face."},{"id":"semetey-1-2013:p0917:b003:l022","ordinal":146201,"en":"Growing fierce and wrathful,"},{"id":"semetey-1-2013:p0917:b003:l023","ordinal":146202,"en":"His pupils blazed."},{"id":"semetey-1-2013:p0917:b003:l024","ordinal":146203,"en":"Your orphan, who knew no measure,"},{"id":"semetey-1-2013:p0917:b003:l025","ordinal":146204,"en":"Was seized by thirst for blood."},{"id":"semetey-1-2013:p0917:b003:l026","ordinal":146205,"en":"The forty companions stood thrusting spears."},{"id":"semetey-1-2013:p0917:b003:l027","ordinal":146206,"en":"He struck Taibuurul once,"},{"id":"semetey-1-2013:p0917:b003:l028","ordinal":146207,"en":"Leveled his spear and shouted,"},{"id":"semetey-1-2013:p0917:b003:l029","ordinal":146208,"en":"Raising “Manas!” as his battle cry,"},{"id":"semetey-1-2013:p0917:b003:l030","ordinal":146209,"en":"And attacked the forty companions."},{"id":"semetey-1-2013:p0917:b003:l031","ordinal":146210,"en":"The seven standards left by Manas"},{"id":"semetey-1-2013:p0917:b003:l032","ordinal":146211,"en":"He planted in seven places."},{"id":"semetey-1-2013:p0917:b003:l033","ordinal":146212,"en":"Now your orphan entered the fight,"},{"id":"semetey-1-2013:p0917:b003:l034","ordinal":146213,"en":"Sending men crawling wherever he reached."},{"id":"semetey-1-2013:p0917:b003:l035","ordinal":146214,"en":"The six honored standards"},{"id":"semetey-1-2013:p0917:b003:l036","ordinal":146215,"en":"He planted in six places."},{"id":"semetey-1-2013:p0917:b003:l037","ordinal":146216,"en":"Your orphan drove in,"},{"id":"semetey-1-2013:p0917:b003:l038","ordinal":146217,"en":"Sending them crawling from the first."},{"id":"semetey-1-2013:p0917:b003:l039","ordinal":146218,"en":"Among the mighty, Kuldur died;"},{"id":"semetey-1-2013:p0917:b004:l001","ordinal":146219,"en":"He was a servant born foolish;"},{"id":"semetey-1-2013:p0917:b004:l002","ordinal":146220,"en":"The hero Baichoro died."},{"id":"semetey-1-2013:p0917:b004:l003","ordinal":146221,"en":"There where he made a mighty spectacle,"},{"id":"semetey-1-2013:p0917:b004:l004","ordinal":146222,"en":"Along great Kyzart,"},{"id":"semetey-1-2013:p0917:b004:l005","ordinal":146223,"en":"Along broad Kochkor,"},{"id":"semetey-1-2013:p0917:b004:l006","ordinal":146224,"en":"His mount a white-marked peerless steed,"},{"id":"semetey-1-2013:p0917:b004:l007","ordinal":146225,"en":"Among the forty companions,"},{"id":"semetey-1-2013:p0917:b004:l008","ordinal":146226,"en":"Kochkor and Chyybyt together—"},{"id":"semetey-1-2013:p0917:b004:l010","ordinal":146227,"en":"The offspring of the raging one","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0917:b004:l011","ordinal":146228,"en":"Attacked before they could cry out."},{"id":"semetey-1-2013:p0917:b004:l012","ordinal":146229,"en":"Of the bewildered forty companions,"},{"id":"semetey-1-2013:p0917:b004:l013","ordinal":146230,"en":"Six died in a single place."},{"id":"semetey-1-2013:p0917:b004:l014","ordinal":146231,"en":"Their renowned men died upon the ridge."},{"id":"semetey-1-2013:p0917:b004:l015","ordinal":146232,"en":"His elder kinsmen Kochkor and Chyybyt"},{"id":"semetey-1-2013:p0917:b004:l016","ordinal":146233,"en":"Died where they came together."},{"id":"semetey-1-2013:p0917:b004:l017","ordinal":146234,"en":"Adybai and Kolbai died."},{"id":"semetey-1-2013:p0917:b004:l018","ordinal":146235,"en":"The best of the forty companions,"},{"id":"semetey-1-2013:p0917:b004:l019","ordinal":146236,"en":"Precious Kuldur, died."},{"id":"semetey-1-2013:p0917:b004:l020","ordinal":146237,"en":"Tolomon's Tolgochu,"},{"id":"semetey-1-2013:p0917:b004:l021","ordinal":146238,"en":"The darling of wealthy Tortkuron,"},{"id":"semetey-1-2013:p0917:b004:l022","ordinal":146239,"en":"Argyn Khan's Azhybai—"},{"id":"semetey-1-2013:p0917:b004:l023","ordinal":146240,"en":"The leader of the forty companions,"},{"id":"semetey-1-2013:p0917:b004:l024","ordinal":146241,"en":"Korogoch, born a gray-maned hero—"},{"id":"semetey-1-2013:p0917:b004:l025","ordinal":146242,"en":"Their brave leaders died here."},{"id":"semetey-1-2013:p0917:b004:l026","ordinal":146243,"en":"When their affairs went ruinously awry,"},{"id":"semetey-1-2013:p0917:b004:l027","ordinal":146244,"en":"The forty companions came together,"},{"id":"semetey-1-2013:p0917:b004:l028","ordinal":146245,"en":"Beseeching Semetey."},{"id":"semetey-1-2013:p0917:b004:l029","ordinal":146246,"en":"When the companions came pleading,"},{"id":"semetey-1-2013:p0917:b004:l032","ordinal":146247,"en":"The rest of the forty companions","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0917:b004:l033","ordinal":146248,"en":"He seized, every one."},{"id":"semetey-1-2013:p0917:b004:l034","ordinal":146249,"en":"Dragging them out upon the road,"},{"id":"semetey-1-2013:p0917:b004:l035","ordinal":146250,"en":"He tore them apart for the great hounds."},{"id":"semetey-1-2013:p0917:b004:l036","ordinal":146251,"en":"Semetey was a sultan:"},{"id":"semetey-1-2013:p0917:b004:l037","ordinal":146252,"en":"As though to quench his thirst,"},{"id":"semetey-1-2013:p0917:b004:l038","ordinal":146253,"en":"He swallowed their blood."},{"id":"semetey-1-2013:p0917:b004:l039","ordinal":146254,"en":"The forty companions left by Manas—"},{"id":"semetey-1-2013:p0918:b003:l001","ordinal":146255,"en":"With his four elder kinsmen foremost,"},{"id":"semetey-1-2013:p0918:b003:l002","ordinal":146256,"en":"He slaughtered them completely."},{"id":"semetey-1-2013:p0918:b003:l003","ordinal":146257,"en":"He slaughtered the forty companions,"},{"id":"semetey-1-2013:p0918:b003:l004","ordinal":146258,"en":"And only after slaughter found relief."},{"id":"semetey-1-2013:p0918:b003:l005","ordinal":146259,"en":"He set the grasslands ablaze,"},{"id":"semetey-1-2013:p0918:b003:l006","ordinal":146260,"en":"And kindled the meadows."},{"id":"semetey-1-2013:p0918:b003:l007","ordinal":146261,"en":"Pouring blood into the dark waters,"},{"id":"semetey-1-2013:p0918:b003:l008","ordinal":146262,"en":"He truly earned the name Bloodthirsty."},{"id":"semetey-1-2013:p0918:b003:l009","ordinal":146263,"en":"He fattened the land along the rivers."},{"id":"semetey-1-2013:p0918:b003:l010","ordinal":146264,"en":"When their feud grew bitter,"},{"id":"semetey-1-2013:p0918:b003:l011","ordinal":146265,"en":"He slew his own elder kinsmen."},{"id":"semetey-1-2013:p0918:b003:l012","ordinal":146266,"en":"He hardened himself by shedding blood,"},{"id":"semetey-1-2013:p0918:b003:l013","ordinal":146267,"en":"And won the name Bloodthirsty."},{"id":"semetey-1-2013:p0918:b003:l014","ordinal":146268,"en":"He came and settled in Talas,"},{"id":"semetey-1-2013:p0918:b003:l015","ordinal":146269,"en":"Destroyed the forty companions,"},{"id":"semetey-1-2013:p0918:b003:l016","ordinal":146270,"en":"And was left alone."},{"id":"semetey-1-2013:p0918:b003:l017","ordinal":146271,"en":"He had slaughtered the forty companions."},{"id":"semetey-1-2013:p0918:b003:l018","ordinal":146272,"en":"He had repaid them for their deeds,"},{"id":"semetey-1-2013:p0918:b003:l019","ordinal":146273,"en":"And only after slaughter found relief."},{"id":"semetey-1-2013:p0918:b003:l020","ordinal":146274,"en":"He devoured Khan Zhakyp."},{"id":"semetey-1-2013:p0918:b003:l021","ordinal":146275,"en":"In the orphan son of Manas"},{"id":"semetey-1-2013:p0918:b003:l022","ordinal":146276,"en":"Not the least regret remained."},{"id":"semetey-1-2013:p0918:b003:l023","ordinal":146277,"en":"He sent Kobosh to the grave,"},{"id":"semetey-1-2013:p0918:b003:l024","ordinal":146278,"en":"And showed his gray-maned fierceness."},{"id":"semetey-1-2013:p0918:b003:l025","ordinal":146279,"en":"He struck Abyke down,"},{"id":"semetey-1-2013:p0918:b003:l026","ordinal":146280,"en":"And destroyed the man himself."},{"id":"semetey-1-2013:p0918:b003:l027","ordinal":146281,"en":"He grew hardened, sated with blood."},{"id":"semetey-1-2013:p0918:b003:l028","ordinal":146282,"en":"Semetey, the Bloodthirsty One's son,"},{"id":"semetey-1-2013:p0918:b003:l029","ordinal":146283,"en":"Was named the blood-drinking, gray-maned hero."},{"id":"semetey-1-2013:p0918:b003:l030","ordinal":146284,"en":"He killed the enemies who faced him."},{"id":"semetey-1-2013:p0918:b003:l031","ordinal":146285,"en":"Never to draw back from blood,"},{"id":"semetey-1-2013:p0918:b003:l032","ordinal":146286,"en":"He licked his sword and swore an oath."},{"id":"semetey-1-2013:p0918:b003:l033","ordinal":146287,"en":"Killing his own close kin,"},{"id":"semetey-1-2013:p0918:b003:l034","ordinal":146288,"en":"He imposed his decree upon the people."},{"id":"semetey-1-2013:p0918:b003:l035","ordinal":146289,"en":"The true news of himself, Semetey"},{"id":"semetey-1-2013:p0918:b003:l036","ordinal":146290,"en":"To the khan of Chin-Machin,"},{"id":"semetey-1-2013:p0918:b003:l037","ordinal":146291,"en":"Kongurbai, made known."},{"id":"semetey-1-2013:p0918:b003:l038","ordinal":146292,"en":"This orphan was twelve years old,"},{"id":"semetey-1-2013:p0918:b003:l039","ordinal":146293,"en":"No ordinary one, this wily orphan."},{"id":"semetey-1-2013:p0918:b004:l001","ordinal":146294,"en":"His fame became known to the people:"},{"id":"semetey-1-2013:p0918:b004:l002","ordinal":146295,"en":"“He slaughtered his elder kinsmen,” they said."},{"id":"semetey-1-2013:p0918:b004:l003","ordinal":146296,"en":"In forty-gated Beijing's"},{"id":"semetey-1-2013:p0918:b004:l004","ordinal":146297,"en":"Register it was written down."},{"id":"semetey-1-2013:p0918:b004:l005","ordinal":146298,"en":"A lion had arisen who slew his elder kinsmen;"},{"id":"semetey-1-2013:p0918:b004:l006","ordinal":146299,"en":"A hero had arisen to conquer the world."},{"id":"semetey-1-2013:p0918:b004:l007","ordinal":146300,"en":"Precious old Bakai,"},{"id":"semetey-1-2013:p0918:b004:l008","ordinal":146301,"en":"Sary Khan and Zhamgyrchy"},{"id":"semetey-1-2013:p0918:b004:l009","ordinal":146302,"en":"Quickly saddled their horses,"},{"id":"semetey-1-2013:p0918:b004:l010","ordinal":146303,"en":"And were setting out,"},{"id":"semetey-1-2013:p0918:b004:l011","ordinal":146304,"en":"Alarmed for their orphan."},{"id":"semetey-1-2013:p0918:b004:l012","ordinal":146305,"en":"His uncle, Lion Bakai—"},{"id":"semetey-1-2013:p0918:b004:l013","ordinal":146306,"en":"Look at the wisdom of the man,"},{"id":"semetey-1-2013:p0918:b004:l014","ordinal":146307,"en":"Of Bakai, the true saint,"},{"id":"semetey-1-2013:p0918:b004:l015","ordinal":146308,"en":"The clarity of his judgment."},{"id":"semetey-1-2013:p0918:b004:l017","ordinal":146309,"en":"The narrow path of Judgment Day—","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0918:b004:l018","ordinal":146310,"en":"“Has he seen it?” he wondered."},{"id":"semetey-1-2013:p0918:b004:l019","ordinal":146311,"en":"“This damned orphan—"},{"id":"semetey-1-2013:p0918:b004:l020","ordinal":146312,"en":"Has he died?” he wondered."},{"id":"semetey-1-2013:p0918:b004:l021","ordinal":146313,"en":"His beard grew thin,"},{"id":"semetey-1-2013:p0918:b004:l022","ordinal":146314,"en":"And the tears flowing down both cheeks"},{"id":"semetey-1-2013:p0918:b004:l023","ordinal":146315,"en":"Poured below his collarbones."},{"id":"semetey-1-2013:p0918:b004:l024","ordinal":146316,"en":"The forty companions left by Manas,"},{"id":"semetey-1-2013:p0918:b004:l025","ordinal":146317,"en":"Forty quarrelsome companions come from forty places,"},{"id":"semetey-1-2013:p0918:b004:l027","ordinal":146318,"en":"Might suddenly have begun shooting,"},{"id":"semetey-1-2013:p0918:b004:l028","ordinal":146319,"en":"Might suddenly have begun fighting."},{"id":"semetey-1-2013:p0918:b004:l029","ordinal":146320,"en":"“He has not yet gone grieving into battle;"},{"id":"semetey-1-2013:p0918:b004:l030","ordinal":146321,"en":"He has not yet learned an enemy's worth."},{"id":"semetey-1-2013:p0918:b004:l031","ordinal":146322,"en":"Has Semetey met them"},{"id":"semetey-1-2013:p0918:b004:l032","ordinal":146323,"en":"And died?” he wondered."},{"id":"semetey-1-2013:p0918:b004:l033","ordinal":146324,"en":"The narrow path of Judgment Day—"},{"id":"semetey-1-2013:p0918:b004:l034","ordinal":146325,"en":"“Has he seen it?” he wondered."},{"id":"semetey-1-2013:p0918:b004:l035","ordinal":146326,"en":"Your uncle Bakai grieved;"},{"id":"semetey-1-2013:p0918:b004:l036","ordinal":146327,"en":"Look at that wolf of war!"},{"id":"semetey-1-2013:p0918:b004:l037","ordinal":146328,"en":"Two khans followed him."},{"id":"semetey-1-2013:p0918:b004:l038","ordinal":146329,"en":"The Muslim could not gather his senses;"},{"id":"semetey-1-2013:p0918:b004:l039","ordinal":146330,"en":"His mustache grew thin,"},{"id":"semetey-1-2013:p0919:b003:l001","ordinal":146331,"en":"And water poured from his nose."},{"id":"semetey-1-2013:p0919:b003:l002","ordinal":146332,"en":"Unable to wipe his tears,"},{"id":"semetey-1-2013:p0919:b003:l003","ordinal":146333,"en":"Unable to draw back his mucus,"},{"id":"semetey-1-2013:p0919:b003:l004","ordinal":146334,"en":"Khan Bakai was deeply distressed."},{"id":"semetey-1-2013:p0919:b003:l005","ordinal":146335,"en":"He sped along upon Kokcholok,"},{"id":"semetey-1-2013:p0919:b003:l006","ordinal":146336,"en":"Flinging hoof-clods the size of basins."},{"id":"semetey-1-2013:p0919:b003:l007","ordinal":146337,"en":"When given his head, Kokcholok"},{"id":"semetey-1-2013:p0919:b003:l008","ordinal":146338,"en":"Flew onward like a shimmer."},{"id":"semetey-1-2013:p0919:b003:l009","ordinal":146339,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p0919:b003:l010","ordinal":146340,"en":"Before a word could be spoken,"},{"id":"semetey-1-2013:p0919:b003:l011","ordinal":146341,"en":"He came near the orphan,"},{"id":"semetey-1-2013:p0919:b003:l012","ordinal":146342,"en":"And rode in among them."},{"id":"semetey-1-2013:p0919:b003:l013","ordinal":146343,"en":"That orphan, the forty companions—"},{"id":"semetey-1-2013:p0919:b003:l014","ordinal":146344,"en":"Had slaughtered them to the last."},{"id":"semetey-1-2013:p0919:b003:l015","ordinal":146345,"en":"He had gathered their corpses in the valley."},{"id":"semetey-1-2013:p0919:b003:l016","ordinal":146346,"en":"The aged hero Bakai,"},{"id":"semetey-1-2013:p0919:b003:l017","ordinal":146347,"en":"My uncle Bakai, the saint,"},{"id":"semetey-1-2013:p0919:b003:l019","ordinal":146348,"en":"Opened his eyes and shuddered.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0919:b003:l020","ordinal":146349,"en":"Trembling, overcome with tears,"},{"id":"semetey-1-2013:p0919:b003:l021","ordinal":146350,"en":"Bakai began to weep."},{"id":"semetey-1-2013:p0919:b003:l022","ordinal":146351,"en":"Alas, with the hero Bakai"},{"id":"semetey-1-2013:p0919:b003:l023","ordinal":146352,"en":"They had shared sheep in one fold,"},{"id":"semetey-1-2013:p0919:b003:l024","ordinal":146353,"en":"Shared food as comrades,"},{"id":"semetey-1-2013:p0919:b003:l025","ordinal":146354,"en":"Shared death and life together."},{"id":"semetey-1-2013:p0919:b003:l026","ordinal":146355,"en":"Bakai's heart was troubled."},{"id":"semetey-1-2013:p0919:b003:l027","ordinal":146356,"en":"Out on the steppe Khan Bakai saw"},{"id":"semetey-1-2013:p0919:b003:l028","ordinal":146357,"en":"The corpses of the forty companions."},{"id":"semetey-1-2013:p0919:b003:l029","ordinal":146358,"en":"When he saw them slaughtered,"},{"id":"semetey-1-2013:p0919:b003:l030","ordinal":146359,"en":"Your precious uncle Bakai"},{"id":"semetey-1-2013:p0919:b003:l031","ordinal":146360,"en":"Turned back to the khans,"},{"id":"semetey-1-2013:p0919:b003:l032","ordinal":146361,"en":"And spoke these words:"},{"id":"semetey-1-2013:p0919:b003:l033","ordinal":146362,"en":"“Zhamgyrchy and Sary Khan,"},{"id":"semetey-1-2013:p0919:b003:l034","ordinal":146363,"en":"My heart is sorely troubled."},{"id":"semetey-1-2013:p0919:b003:l035","ordinal":146364,"en":"The forty damned companions"},{"id":"semetey-1-2013:p0919:b003:l036","ordinal":146365,"en":"Lie slaughtered before us."},{"id":"semetey-1-2013:p0919:b003:l037","ordinal":146366,"en":"Those dogs with crooked minds"},{"id":"semetey-1-2013:p0919:b003:l038","ordinal":146367,"en":"Have left their corpses upon the ridge."},{"id":"semetey-1-2013:p0919:b003:l039","ordinal":146368,"en":"Can anything good come of quarreling?"},{"id":"semetey-1-2013:p0919:b004:l001","ordinal":146369,"en":"Their blood has spilled upon the steppe."},{"id":"semetey-1-2013:p0919:b004:l002","ordinal":146370,"en":"The forty companions born of wickedness—"},{"id":"semetey-1-2013:p0919:b004:l003","ordinal":146371,"en":"Their bones lie buried on the steppe."},{"id":"semetey-1-2013:p0919:b004:l004","ordinal":146372,"en":"The forty companion-friends are dead;"},{"id":"semetey-1-2013:p0919:b004:l005","ordinal":146373,"en":"Bakai has seen their deaths."},{"id":"semetey-1-2013:p0919:b004:l006","ordinal":146374,"en":"Kochkor and Chyybyt died together;"},{"id":"semetey-1-2013:p0919:b004:l007","ordinal":146375,"en":"Adybai and Kolbai are dead.”"},{"id":"semetey-1-2013:p0919:b004:l008","ordinal":146376,"en":"While they stood grieving,"},{"id":"semetey-1-2013:p0919:b004:l009","ordinal":146377,"en":"Lively Semetey,"},{"id":"semetey-1-2013:p0919:b004:l010","ordinal":146378,"en":"With a black marten cap upon his head,"},{"id":"semetey-1-2013:p0919:b004:l011","ordinal":146379,"en":"The noble scion born of Manas,"},{"id":"semetey-1-2013:p0919:b004:l012","ordinal":146380,"en":"Looking to either side,"},{"id":"semetey-1-2013:p0919:b004:l013","ordinal":146381,"en":"Licking his lips and nose,"},{"id":"semetey-1-2013:p0919:b004:l014","ordinal":146382,"en":"Came up to Bakai."},{"id":"semetey-1-2013:p0919:b004:l015","ordinal":146383,"en":"Look at him in his sorrow:"},{"id":"semetey-1-2013:p0919:b004:l016","ordinal":146384,"en":"Did not let the child sense his misgivings—"},{"id":"semetey-1-2013:p0919:b004:l017","ordinal":146385,"en":"Your leopard uncle Bakai."},{"id":"semetey-1-2013:p0919:b004:l018","ordinal":146386,"en":"“Hey, my orphan, son of Manas,"},{"id":"semetey-1-2013:p0919:b004:l019","ordinal":146387,"en":"Your fugitive uncles, the forty companions,"},{"id":"semetey-1-2013:p0919:b004:l020","ordinal":146388,"en":"You have pursued them fiercely."},{"id":"semetey-1-2013:p0919:b004:l021","ordinal":146389,"en":"Without bearing their faults a little,"},{"id":"semetey-1-2013:p0919:b004:l022","ordinal":146390,"en":"You have slaughtered them."},{"id":"semetey-1-2013:p0919:b004:l023","ordinal":146391,"en":"My orphan touched by Khizr,"},{"id":"semetey-1-2013:p0919:b004:l024","ordinal":146392,"en":"You have taken ample vengeance!"},{"id":"semetey-1-2013:p0919:b004:l025","ordinal":146393,"en":"The forty companions your father left—"},{"id":"semetey-1-2013:p0919:b004:l026","ordinal":146394,"en":"You have slaughtered them!"},{"id":"semetey-1-2013:p0919:b004:l028","ordinal":146395,"en":"My precious orphan, heed my words.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0919:b004:l029","ordinal":146396,"en":"The inheritance left by Manas,"},{"id":"semetey-1-2013:p0919:b004:l030","ordinal":146397,"en":"All forty companions alike—"},{"id":"semetey-1-2013:p0919:b004:l031","ordinal":146398,"en":"Their remedy has been found."},{"id":"semetey-1-2013:p0919:b004:l032","ordinal":146399,"en":"They have all been shattered."},{"id":"semetey-1-2013:p0919:b004:l033","ordinal":146400,"en":"Their thin mustaches smoothed,"},{"id":"semetey-1-2013:p0919:b004:l034","ordinal":146401,"en":"They have all gone to the world beyond."},{"id":"semetey-1-2013:p0919:b004:l035","ordinal":146402,"en":"They have all fallen crooked,"},{"id":"semetey-1-2013:p0919:b004:l036","ordinal":146403,"en":"My darling Semetey,"},{"id":"semetey-1-2013:p0919:b004:l037","ordinal":146404,"en":"The old and young together."},{"id":"semetey-1-2013:p0919:b004:l038","ordinal":146405,"en":"With your elder kinsmen foremost,"},{"id":"semetey-1-2013:p0919:b004:l039","ordinal":146406,"en":"You have slaughtered the forty companions."},{"id":"semetey-1-2013:p0920:b003:l001","ordinal":146407,"en":"My orphan touched by Khizr,"},{"id":"semetey-1-2013:p0920:b003:l002","ordinal":146408,"en":"You have drunk your fill of their blood."},{"id":"semetey-1-2013:p0920:b003:l003","ordinal":146409,"en":"Drawing bows in a rain of arrows,"},{"id":"semetey-1-2013:p0920:b003:l004","ordinal":146410,"en":"They attacked, and you slaughtered them."},{"id":"semetey-1-2013:p0920:b003:l005","ordinal":146411,"en":"Great torment came upon your soul,"},{"id":"semetey-1-2013:p0920:b003:l006","ordinal":146412,"en":"And you put an end to them!"},{"id":"semetey-1-2013:p0920:b003:l007","ordinal":146413,"en":"The forty companions left by Manas—"},{"id":"semetey-1-2013:p0920:b003:l008","ordinal":146414,"en":"If we leave without covering their faces,"},{"id":"semetey-1-2013:p0920:b003:l009","ordinal":146415,"en":"Their dear currant-like eyes"},{"id":"semetey-1-2013:p0920:b003:l010","ordinal":146416,"en":"The cawing crows must not gouge out."},{"id":"semetey-1-2013:p0920:b003:l011","ordinal":146417,"en":"Their door-sized white teeth"},{"id":"semetey-1-2013:p0920:b003:l012","ordinal":146418,"en":"The magpies must not shit upon!"},{"id":"semetey-1-2013:p0920:b003:l013","ordinal":146419,"en":"The wolves must not tear out their kidneys;"},{"id":"semetey-1-2013:p0920:b003:l014","ordinal":146420,"en":"On all the rest of their flesh"},{"id":"semetey-1-2013:p0920:b003:l015","ordinal":146421,"en":"The accursed foxes must not feast!"},{"id":"semetey-1-2013:p0920:b003:l016","ordinal":146422,"en":"Slaughter their mounts before you go;"},{"id":"semetey-1-2013:p0920:b003:l017","ordinal":146423,"en":"Dig the earth with mattocks before you go."},{"id":"semetey-1-2013:p0920:b003:l018","ordinal":146424,"en":"Dedicate and slaughter their mounts;"},{"id":"semetey-1-2013:p0920:b003:l019","ordinal":146425,"en":"All the forty companions"},{"id":"semetey-1-2013:p0920:b003:l020","ordinal":146426,"en":"Lay in marked graves before you go!”"},{"id":"semetey-1-2013:p0920:b003:l021","ordinal":146427,"en":"Heeding Bakai's words,"},{"id":"semetey-1-2013:p0920:b003:l022","ordinal":146428,"en":"Travelers passing this way and that"},{"id":"semetey-1-2013:p0920:b003:l023","ordinal":146429,"en":"He gathered together."},{"id":"semetey-1-2013:p0920:b003:l024","ordinal":146430,"en":"Kochkor and Chyybyt, the two,"},{"id":"semetey-1-2013:p0920:b003:l025","ordinal":146431,"en":"With Adybai and Kolbai, the four,"},{"id":"semetey-1-2013:p0920:b003:l026","ordinal":146432,"en":"He laid side by side."}]
