[{"id":"semetey-1-2013:p0473:b003:l001","ordinal":112897,"en":"And named it “Green-Black.”"},{"id":"semetey-1-2013:p0473:b003:l002","ordinal":112898,"en":"If poisoned Manas drank it,"},{"id":"semetey-1-2013:p0473:b003:l003","ordinal":112899,"en":"His pain would subside,"},{"id":"semetey-1-2013:p0473:b003:l004","ordinal":112900,"en":"His eyes would open wide."},{"id":"semetey-1-2013:p0473:b003:l005","ordinal":112901,"en":"Rare indeed for anyone to find,"},{"id":"semetey-1-2013:p0473:b003:l006","ordinal":112902,"en":"That was the true healing medicine."},{"id":"semetey-1-2013:p0473:b003:l007","ordinal":112903,"en":"To the khan of Baghdad"},{"id":"semetey-1-2013:p0473:b003:l008","ordinal":112904,"en":"I sent poods of gold and precious metal."},{"id":"semetey-1-2013:p0473:b003:l009","ordinal":112905,"en":"Traveling by night, resting by day,"},{"id":"semetey-1-2013:p0473:b003:l010","ordinal":112906,"en":"In places heard of but never seen,"},{"id":"semetey-1-2013:p0473:b003:l011","ordinal":112907,"en":"I had the face of the earth searched."},{"id":"semetey-1-2013:p0473:b003:l012","ordinal":112908,"en":"Spending all my wealth,"},{"id":"semetey-1-2013:p0473:b003:l013","ordinal":112909,"en":"Sparing not my own life,"},{"id":"semetey-1-2013:p0473:b003:l014","ordinal":112910,"en":"I had it brought from broad Baghdad."},{"id":"semetey-1-2013:p0473:b003:l015","ordinal":112911,"en":"For your poisoned lion-hearted father,"},{"id":"semetey-1-2013:p0473:b003:l016","ordinal":112912,"en":"I stirred it in a mortar."},{"id":"semetey-1-2013:p0473:b003:l017","ordinal":112913,"en":"I saw how potent it was"},{"id":"semetey-1-2013:p0473:b003:l018","ordinal":112914,"en":"And measured it out by the spoonful."},{"id":"semetey-1-2013:p0473:b003:l019","ordinal":112915,"en":"Whenever your khan father drank it,"},{"id":"semetey-1-2013:p0473:b003:l020","ordinal":112916,"en":"His pain would subside,"},{"id":"semetey-1-2013:p0473:b003:l021","ordinal":112917,"en":"His eyes would open wide."},{"id":"semetey-1-2013:p0473:b003:l022","ordinal":112918,"en":"When your father retched, “Oh!”"},{"id":"semetey-1-2013:p0473:b003:l023","ordinal":112919,"en":"Gush after gush of poison came out,"},{"id":"semetey-1-2013:p0473:b003:l024","ordinal":112920,"en":"And your mother's strength ebbed away."},{"id":"semetey-1-2013:p0473:b003:l025","ordinal":112921,"en":"Whenever he drank the medicine,"},{"id":"semetey-1-2013:p0473:b003:l026","ordinal":112922,"en":"From your father's mouth"},{"id":"semetey-1-2013:p0473:b003:l027","ordinal":112923,"en":"Came handfuls upon handfuls of poison."},{"id":"semetey-1-2013:p0473:b003:l028","ordinal":112924,"en":"The poison's potency abated;"},{"id":"semetey-1-2013:p0473:b003:l029","ordinal":112925,"en":"Then your lion-hearted father's"},{"id":"semetey-1-2013:p0473:b003:l030","ordinal":112926,"en":"Eyes opened wide."},{"id":"semetey-1-2013:p0473:b003:l031","ordinal":112927,"en":"Stricken by that poisonous sickness,"},{"id":"semetey-1-2013:p0473:b003:l032","ordinal":112928,"en":"Your father Manas was a lion."},{"id":"semetey-1-2013:p0473:b003:l033","ordinal":112929,"en":"He barely recovered from death,"},{"id":"semetey-1-2013:p0473:b003:l034","ordinal":112930,"en":"Pierced in forty places."},{"id":"semetey-1-2013:p0473:b003:l035","ordinal":112931,"en":"Taking no rest by day,"},{"id":"semetey-1-2013:p0473:b003:l036","ordinal":112932,"en":"Thus I nursed your father."},{"id":"semetey-1-2013:p0473:b003:l037","ordinal":112933,"en":"Getting no sleep at night,"},{"id":"semetey-1-2013:p0473:b003:l038","ordinal":112934,"en":"Thus I nursed your father."},{"id":"semetey-1-2013:p0473:b003:l039","ordinal":112935,"en":"I, your ill-fated mother,"},{"id":"semetey-1-2013:p0473:b005:l001","ordinal":112936,"en":"Thinking it would heal the holes,"},{"id":"semetey-1-2013:p0473:b005:l002","ordinal":112937,"en":"All the poison within him,"},{"id":"semetey-1-2013:p0473:b005:l003","ordinal":112938,"en":"I thought it would draw outside."},{"id":"semetey-1-2013:p0473:b005:l004","ordinal":112939,"en":"Forty young unfoaled mares—"},{"id":"semetey-1-2013:p0473:b005:l005","ordinal":112940,"en":"I had them all slaughtered."},{"id":"semetey-1-2013:p0473:b005:l006","ordinal":112941,"en":"I had their belly fat cut out."},{"id":"semetey-1-2013:p0473:b005:l007","ordinal":112942,"en":"Thus I, your mother, sustained him."},{"id":"semetey-1-2013:p0473:b005:l008","ordinal":112943,"en":"Your lion-hearted father himself,"},{"id":"semetey-1-2013:p0473:b005:l009","ordinal":112944,"en":"Until sixty days had passed,"},{"id":"semetey-1-2013:p0473:b005:l010","ordinal":112945,"en":"I wrapped in horse fat day and night."},{"id":"semetey-1-2013:p0473:b005:l011","ordinal":112946,"en":"Thus I brought him back to his senses."},{"id":"semetey-1-2013:p0473:b005:l012","ordinal":112947,"en":"For the “Green-Black” medicine"},{"id":"semetey-1-2013:p0473:b005:l013","ordinal":112948,"en":"I caused many people to be killed."},{"id":"semetey-1-2013:p0473:b005:l014","ordinal":112949,"en":"If I speak, I have still more to tell."},{"id":"semetey-1-2013:p0473:b005:l015","ordinal":112950,"en":"Upon me, your wretched mother,"},{"id":"semetey-1-2013:p0473:b005:l016","ordinal":112951,"en":"For those I destroyed though innocent,"},{"id":"semetey-1-2013:p0473:b005:l017","ordinal":112952,"en":"Lies the blood of many believers."},{"id":"semetey-1-2013:p0473:b005:l018","ordinal":112953,"en":"I, your wretched mother,"},{"id":"semetey-1-2013:p0473:b005:l019","ordinal":112954,"en":"My valiant son, listen,"},{"id":"semetey-1-2013:p0473:b005:l020","ordinal":112955,"en":"Have an endless tale to tell."},{"id":"semetey-1-2013:p0473:b005:l021","ordinal":112956,"en":"On the coming Day of Resurrection,"},{"id":"semetey-1-2013:p0473:b005:l022","ordinal":112957,"en":"If what is said is true,"},{"id":"semetey-1-2013:p0473:b005:l023","ordinal":112958,"en":"This fierce mother of yours"},{"id":"semetey-1-2013:p0473:b005:l024","ordinal":112959,"en":"May well become a black donkey."},{"id":"semetey-1-2013:p0473:b005:l025","ordinal":112960,"en":"My only one, one day I too must die."},{"id":"semetey-1-2013:p0473:b005:l026","ordinal":112961,"en":"Upon Judgment Day's narrow path,"},{"id":"semetey-1-2013:p0473:b005:l027","ordinal":112962,"en":"If those believers demand their blood,"},{"id":"semetey-1-2013:p0473:b005:l028","ordinal":112963,"en":"What answer shall I give them?"},{"id":"semetey-1-2013:p0473:b005:l029","ordinal":112964,"en":"My precious son, listen"},{"id":"semetey-1-2013:p0473:b005:l030","ordinal":112965,"en":"To the blessing bestowed on you by a saint."},{"id":"semetey-1-2013:p0473:b005:l031","ordinal":112966,"en":"I, your unhappy mother,"},{"id":"semetey-1-2013:p0473:b005:l032","ordinal":112967,"en":"Bore your father's suffering."},{"id":"semetey-1-2013:p0473:b005:l033","ordinal":112968,"en":"Your father was a gray-maned khan."},{"id":"semetey-1-2013:p0473:b005:l034","ordinal":112969,"en":"When confronted, he acted:"},{"id":"semetey-1-2013:p0473:b005:l035","ordinal":112970,"en":"Such was his valor."},{"id":"semetey-1-2013:p0473:b005:l036","ordinal":112971,"en":"Your father Manas was a lion."},{"id":"semetey-1-2013:p0473:b005:l037","ordinal":112972,"en":"A soul like your father"},{"id":"semetey-1-2013:p0473:b005:l038","ordinal":112973,"en":"God will never create again."},{"id":"semetey-1-2013:p0473:b005:l039","ordinal":112974,"en":"The suffering of your father Manas—"},{"id":"semetey-1-2013:p0474:b003:l001","ordinal":112975,"en":"Almighty Allah ordained it;"},{"id":"semetey-1-2013:p0474:b003:l002","ordinal":112976,"en":"I was the one who bore that suffering."},{"id":"semetey-1-2013:p0474:b003:l003","ordinal":112977,"en":"They made me endure terrible hardship,"},{"id":"semetey-1-2013:p0474:b003:l004","ordinal":112978,"en":"Those Kalmyks to whom he had given a share."},{"id":"semetey-1-2013:p0474:b003:l005","ordinal":112979,"en":"I, your wretched, fierce mother,"},{"id":"semetey-1-2013:p0474:b003:l006","ordinal":112980,"en":"Had my breast torn open by a shot."},{"id":"semetey-1-2013:p0474:b003:l007","ordinal":112981,"en":"Your father Manas was a warrior."},{"id":"semetey-1-2013:p0474:b003:l008","ordinal":112982,"en":"Unbelievers who knew no faith"},{"id":"semetey-1-2013:p0474:b003:l009","ordinal":112983,"en":"He bound and taught the faith."},{"id":"semetey-1-2013:p0474:b003:l010","ordinal":112984,"en":"The obstinate who would not obey"},{"id":"semetey-1-2013:p0474:b003:l011","ordinal":112985,"en":"He drove before him and subdued."},{"id":"semetey-1-2013:p0474:b003:l012","ordinal":112986,"en":"He emptied the bullets from his pouch."},{"id":"semetey-1-2013:p0474:b003:l013","ordinal":112987,"en":"Wherever foes came out to shoot,"},{"id":"semetey-1-2013:p0474:b003:l014","ordinal":112988,"en":"Your father struck terror into all the world."},{"id":"semetey-1-2013:p0474:b003:l015","ordinal":112989,"en":"He dwelt in Great Talas."},{"id":"semetey-1-2013:p0474:b003:l016","ordinal":112990,"en":"When enemies came out to fight,"},{"id":"semetey-1-2013:p0474:b003:l017","ordinal":112991,"en":"He drove them before him."},{"id":"semetey-1-2013:p0474:b003:l018","ordinal":112992,"en":"Those who provoked his anger"},{"id":"semetey-1-2013:p0474:b003:l019","ordinal":112993,"en":"He crushed between his fangs."},{"id":"semetey-1-2013:p0474:b003:l020","ordinal":112994,"en":"The renowned Manas became khan."},{"id":"semetey-1-2013:p0474:b003:l021","ordinal":112995,"en":"His voice alone could kill."},{"id":"semetey-1-2013:p0474:b003:l022","ordinal":112996,"en":"He set the grassy land ablaze,"},{"id":"semetey-1-2013:p0474:b003:l023","ordinal":112997,"en":"Kindled the lands covered in dry grass."},{"id":"semetey-1-2013:p0474:b003:l024","ordinal":112998,"en":"He melted those he charged against;"},{"id":"semetey-1-2013:p0474:b003:l025","ordinal":112999,"en":"Where he set his gaze, he raised a tumult."},{"id":"semetey-1-2013:p0474:b003:l026","ordinal":113000,"en":"He chased white deer and made them cattle."},{"id":"semetey-1-2013:p0474:b003:l027","ordinal":113001,"en":"Thus he threw the world into confusion."},{"id":"semetey-1-2013:p0474:b003:l028","ordinal":113002,"en":"He reared gray deer and made them cattle."},{"id":"semetey-1-2013:p0474:b003:l029","ordinal":113003,"en":"Wherever he aimed, he threw it into confusion."},{"id":"semetey-1-2013:p0474:b003:l030","ordinal":113004,"en":"He grew hardened, drinking blood,"},{"id":"semetey-1-2013:p0474:b003:l031","ordinal":113005,"en":"Won the name of gray-maned leopard."},{"id":"semetey-1-2013:p0474:b003:l032","ordinal":113006,"en":"He wrecked strongholds and took booty,"},{"id":"semetey-1-2013:p0474:b003:l033","ordinal":113007,"en":"Raided Omsk and opened a road."},{"id":"semetey-1-2013:p0474:b003:l034","ordinal":113008,"en":"Such was your father Manas."},{"id":"semetey-1-2013:p0474:b003:l035","ordinal":113009,"en":"None upon whom he set his gaze escaped unhurt."},{"id":"semetey-1-2013:p0474:b003:l036","ordinal":113010,"en":"Your father Manas, the gray-maned warrior,"},{"id":"semetey-1-2013:p0474:b003:l037","ordinal":113011,"en":"Turned and bristled like a lion."},{"id":"semetey-1-2013:p0474:b003:l038","ordinal":113012,"en":"When he heard your father's fame,"},{"id":"semetey-1-2013:p0474:b003:l039","ordinal":113013,"en":"The khan of Beijing awoke."},{"id":"semetey-1-2013:p0474:b004:l001","ordinal":113014,"en":"Because your gray-maned father Manas"},{"id":"semetey-1-2013:p0474:b004:l002","ordinal":113015,"en":"Would not recover,"},{"id":"semetey-1-2013:p0474:b004:l003","ordinal":113016,"en":"I searched all manner of places"},{"id":"semetey-1-2013:p0474:b004:l004","ordinal":113017,"en":"And obtained a thousand kinds of medicine."},{"id":"semetey-1-2013:p0474:b004:l005","ordinal":113018,"en":"I cut out horse fat and wrapped him in it."},{"id":"semetey-1-2013:p0474:b004:l006","ordinal":113019,"en":"I eased his aching wounds."},{"id":"semetey-1-2013:p0474:b004:l007","ordinal":113020,"en":"Your ruin-bringing, gray-maned father's"},{"id":"semetey-1-2013:p0474:b004:l008","ordinal":113021,"en":"Eyes I made open wide."},{"id":"semetey-1-2013:p0474:b004:l009","ordinal":113022,"en":"I showed my resourcefulness."},{"id":"semetey-1-2013:p0474:b004:l010","ordinal":113023,"en":"After nursing him in hardship forty-one days,"},{"id":"semetey-1-2013:p0474:b004:l011","ordinal":113024,"en":"I got your father onto a horse."},{"id":"semetey-1-2013:p0474:b004:l012","ordinal":113025,"en":"Your khan father recovered."},{"id":"semetey-1-2013:p0474:b004:l013","ordinal":113026,"en":"I wrested your khan father back from death;"},{"id":"semetey-1-2013:p0474:b004:l014","ordinal":113027,"en":"After lying long, he barely recovered."},{"id":"semetey-1-2013:p0474:b004:l015","ordinal":113028,"en":"Let us leave that aside"},{"id":"semetey-1-2013:p0474:b004:l016","ordinal":113029,"en":"Kozkaman, who caused that suffering—"},{"id":"semetey-1-2013:p0474:b004:l017","ordinal":113030,"en":"Let us begin to tell of that villain."},{"id":"semetey-1-2013:p0474:b004:l018","ordinal":113031,"en":"Although he was an unbeliever,"},{"id":"semetey-1-2013:p0474:b004:l019","ordinal":113032,"en":"Let us not belittle that swine."},{"id":"semetey-1-2013:p0474:b004:l020","ordinal":113033,"en":"A slave skilled among spearmen,"},{"id":"semetey-1-2013:p0474:b004:l021","ordinal":113034,"en":"A capable slave who knew the enemy's stratagems,"},{"id":"semetey-1-2013:p0474:b004:l023","ordinal":113035,"en":"He too had been a khan guarding the Khagan."},{"id":"semetey-1-2013:p0474:b004:l024","ordinal":113036,"en":"No Chinese dared answer him back."},{"id":"semetey-1-2013:p0474:b004:l025","ordinal":113037,"en":"He too had been a khan who amassed treasure."},{"id":"semetey-1-2013:p0474:b004:l026","ordinal":113038,"en":"He rode Konkulboz in his revels,"},{"id":"semetey-1-2013:p0474:b004:l027","ordinal":113039,"en":"Spared no enemy he faced."},{"id":"semetey-1-2013:p0474:b004:l028","ordinal":113040,"en":"“Valiant Manas has died,"},{"id":"semetey-1-2013:p0474:b004:l029","ordinal":113041,"en":"He has seen Judgment Day,”"},{"id":"semetey-1-2013:p0474:b004:l030","ordinal":113042,"en":"That Kalmyk thought."},{"id":"semetey-1-2013:p0474:b004:l031","ordinal":113043,"en":"The treasure stores, countless riches—"},{"id":"semetey-1-2013:p0474:b004:l032","ordinal":113044,"en":"He plundered all the wealth."},{"id":"semetey-1-2013:p0474:b004:l033","ordinal":113045,"en":"He wrought thorough destruction,"},{"id":"semetey-1-2013:p0474:b004:l034","ordinal":113046,"en":"Overpowered everyone he encountered."},{"id":"semetey-1-2013:p0474:b004:l035","ordinal":113047,"en":"The vast treasure, the yellow gold,"},{"id":"semetey-1-2013:p0474:b004:l036","ordinal":113048,"en":"He loaded onto his mule."},{"id":"semetey-1-2013:p0474:b004:l037","ordinal":113049,"en":"Akayar, who had been fighting him,"},{"id":"semetey-1-2013:p0474:b004:l038","ordinal":113050,"en":"“Might carry word to the Kyrgyz,” he thought:"},{"id":"semetey-1-2013:p0474:b004:l039","ordinal":113051,"en":"He bound him instead of killing him."},{"id":"semetey-1-2013:p0475:b003:l001","ordinal":113052,"en":"A great dungeon, forty rope-lengths deep,"},{"id":"semetey-1-2013:p0475:b003:l002","ordinal":113053,"en":"He had dug in Great Talas"},{"id":"semetey-1-2013:p0475:b003:l003","ordinal":113054,"en":"And cast him into it alive."},{"id":"semetey-1-2013:p0475:b003:l004","ordinal":113055,"en":"The cunning men among the Kalmyks"},{"id":"semetey-1-2013:p0475:b003:l005","ordinal":113056,"en":"Thus took their revenge."},{"id":"semetey-1-2013:p0475:b003:l006","ordinal":113057,"en":"Any guard who emerged alive,"},{"id":"semetey-1-2013:p0475:b003:l007","ordinal":113058,"en":"Without letting anyone see,"},{"id":"semetey-1-2013:p0475:b003:l008","ordinal":113059,"en":"Without letting anyone know,"},{"id":"semetey-1-2013:p0475:b003:l009","ordinal":113060,"en":"They seized, slaughtered, and disposed of."},{"id":"semetey-1-2013:p0475:b003:l010","ordinal":113061,"en":"All the treasure"},{"id":"semetey-1-2013:p0475:b003:l011","ordinal":113062,"en":"They meant to carry off as booty,"},{"id":"semetey-1-2013:p0475:b003:l012","ordinal":113063,"en":"And all the Kyrgyz living there"},{"id":"semetey-1-2013:p0475:b003:l013","ordinal":113064,"en":"They meant utterly to destroy."},{"id":"semetey-1-2013:p0475:b003:l014","ordinal":113065,"en":"Rare gold and precious gems,"},{"id":"semetey-1-2013:p0475:b003:l015","ordinal":113066,"en":"The treasury of Khan Manas,"},{"id":"semetey-1-2013:p0475:b003:l016","ordinal":113067,"en":"He loaded onto his mule."},{"id":"semetey-1-2013:p0475:b003:l017","ordinal":113068,"en":"He crossed Kotormo,"},{"id":"semetey-1-2013:p0475:b003:l018","ordinal":113069,"en":"Traveled along Suusamyr,"},{"id":"semetey-1-2013:p0475:b003:l019","ordinal":113070,"en":"Skirted the misty mountain,"},{"id":"semetey-1-2013:p0475:b003:l020","ordinal":113071,"en":"Made his way through the foothills."},{"id":"semetey-1-2013:p0475:b003:l021","ordinal":113072,"en":"He traveled far, sparing no horse,"},{"id":"semetey-1-2013:p0475:b003:l022","ordinal":113073,"en":"Kept his guards watching closely,"},{"id":"semetey-1-2013:p0475:b003:l023","ordinal":113074,"en":"Had any sleeper beaten,"},{"id":"semetey-1-2013:p0475:b003:l024","ordinal":113075,"en":"And hurried on in haste."},{"id":"semetey-1-2013:p0475:b003:l025","ordinal":113076,"en":"“We have slaughtered their generous lord,” he said,"},{"id":"semetey-1-2013:p0475:b003:l026","ordinal":113077,"en":"Traveling by night, resting by day."},{"id":"semetey-1-2013:p0475:b003:l027","ordinal":113078,"en":"He traveled over the mountain heights,"},{"id":"semetey-1-2013:p0475:b003:l028","ordinal":113079,"en":"Went far, sparing no horse,"},{"id":"semetey-1-2013:p0475:b003:l029","ordinal":113080,"en":"Skirted the precipitous slopes,"},{"id":"semetey-1-2013:p0475:b003:l031","ordinal":113081,"en":"Descended Echki-Olbos,","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0475:b003:l032","ordinal":113082,"en":"And made camp at Eki-Chat,"},{"id":"semetey-1-2013:p0475:b003:l033","ordinal":113083,"en":"Kozkaman, that day."},{"id":"semetey-1-2013:p0475:b003:l034","ordinal":113084,"en":"Konkulboz, a tulpar among horses,"},{"id":"semetey-1-2013:p0475:b003:l035","ordinal":113085,"en":"He unsaddled and left barebacked."},{"id":"semetey-1-2013:p0475:b003:l036","ordinal":113086,"en":"The twisted golden hobbles"},{"id":"semetey-1-2013:p0475:b003:l037","ordinal":113087,"en":"He brought and fastened above its hooves."},{"id":"semetey-1-2013:p0475:b003:l038","ordinal":113088,"en":"The Kalmyk pillowed his head on his saddle,"},{"id":"semetey-1-2013:p0475:b003:l039","ordinal":113089,"en":"Laying his head toward the sunrise,"},{"id":"semetey-1-2013:p0475:b005:l001","ordinal":113090,"en":"And fell into a warrior's deep sleep."},{"id":"semetey-1-2013:p0475:b005:l002","ordinal":113091,"en":"For many days and many nights"},{"id":"semetey-1-2013:p0475:b005:l003","ordinal":113092,"en":"He slept without tiring of it."},{"id":"semetey-1-2013:p0475:b005:l004","ordinal":113093,"en":"Among horses, a tulpar with a blazed head—"},{"id":"semetey-1-2013:p0475:b005:l005","ordinal":113094,"en":"Setting stakes and playing ordo,"},{"id":"semetey-1-2013:p0475:b005:l006","ordinal":113095,"en":"Amid the merry games,"},{"id":"semetey-1-2013:p0475:b005:l007","ordinal":113096,"en":"Together with Almambet and Chubak,"},{"id":"semetey-1-2013:p0475:b005:l008","ordinal":113097,"en":"Hearing rumors, whispered talk,"},{"id":"semetey-1-2013:p0475:b005:l009","ordinal":113098,"en":"How the Chinese deceived him and gave him poison,"},{"id":"semetey-1-2013:p0475:b005:l010","ordinal":113099,"en":"And hearing that Manas had died,"},{"id":"semetey-1-2013:p0475:b005:l011","ordinal":113100,"en":"Kyrgylchal, leader of the forty—"},{"id":"semetey-1-2013:p0475:b005:l012","ordinal":113101,"en":"That wild old man, swaggering among the forty,"},{"id":"semetey-1-2013:p0475:b005:l013","ordinal":113102,"en":"Always thinking up mischievous words—"},{"id":"semetey-1-2013:p0475:b005:l014","ordinal":113103,"en":"Even if he caused a thousand troubles,"},{"id":"semetey-1-2013:p0475:b005:l015","ordinal":113104,"en":"The leopard Manas, that noble lion,"},{"id":"semetey-1-2013:p0475:b005:l016","ordinal":113105,"en":"Never blamed him for the damage."},{"id":"semetey-1-2013:p0475:b005:l017","ordinal":113106,"en":"Ker-kuron was his winged mount."},{"id":"semetey-1-2013:p0475:b005:l018","ordinal":113107,"en":"Each of the forty companions"},{"id":"semetey-1-2013:p0475:b005:l019","ordinal":113108,"en":"Took his turn on guard:"},{"id":"semetey-1-2013:p0475:b005:l020","ordinal":113109,"en":"Such was their custom."},{"id":"semetey-1-2013:p0475:b005:l021","ordinal":113110,"en":"Along the broad Talas,"},{"id":"semetey-1-2013:p0475:b005:l022","ordinal":113111,"en":"Into the hollow of Zhylygynduu,"},{"id":"semetey-1-2013:p0475:b005:l023","ordinal":113112,"en":"To Kainar's dark spring-eye,"},{"id":"semetey-1-2013:p0475:b005:l024","ordinal":113113,"en":"To the very plane tree,"},{"id":"semetey-1-2013:p0475:b005:l025","ordinal":113114,"en":"Kyrgylchal came riding."},{"id":"semetey-1-2013:p0475:b005:l026","ordinal":113115,"en":"No crow cawed,"},{"id":"semetey-1-2013:p0475:b005:l027","ordinal":113116,"en":"No raven croaked."},{"id":"semetey-1-2013:p0475:b005:l028","ordinal":113117,"en":"Kanykei's white palace,"},{"id":"semetey-1-2013:p0475:b005:l029","ordinal":113118,"en":"Its doors of iron and solid tin—"},{"id":"semetey-1-2013:p0475:b005:l030","ordinal":113119,"en":"Though she was a woman, that ill-fated one"},{"id":"semetey-1-2013:p0475:b005:l031","ordinal":113120,"en":"Had possessed great splendor."},{"id":"semetey-1-2013:p0475:b005:l032","ordinal":113121,"en":"From Kanykei's palace"},{"id":"semetey-1-2013:p0475:b005:l033","ordinal":113122,"en":"They had pulled out the supporting pillar."},{"id":"semetey-1-2013:p0475:b005:l034","ordinal":113123,"en":"Sixty of the guards"},{"id":"semetey-1-2013:p0475:b005:l035","ordinal":113124,"en":"They had slaughtered as a sacrifice."},{"id":"semetey-1-2013:p0475:b005:l036","ordinal":113125,"en":"Wearing human noses and ears"},{"id":"semetey-1-2013:p0475:b005:l037","ordinal":113126,"en":"As amulets upon themselves,"},{"id":"semetey-1-2013:p0475:b005:l038","ordinal":113127,"en":"Subduing all who saw them,"},{"id":"semetey-1-2013:p0475:b005:l039","ordinal":113128,"en":"There had been seven demonic beings,"},{"id":"semetey-1-2013:p0476:b003:l001","ordinal":113129,"en":"Before her doorway;"},{"id":"semetey-1-2013:p0476:b003:l002","ordinal":113130,"en":"They had slaughtered them all."},{"id":"semetey-1-2013:p0476:b003:l003","ordinal":113131,"en":"They had plundered the wealth,"},{"id":"semetey-1-2013:p0476:b003:l004","ordinal":113132,"en":"Wrought thorough destruction,"},{"id":"semetey-1-2013:p0476:b003:l005","ordinal":113133,"en":"Broken into the treasury,"},{"id":"semetey-1-2013:p0476:b003:l006","ordinal":113134,"en":"Long since brought them to ruin."},{"id":"semetey-1-2013:p0476:b003:l007","ordinal":113135,"en":"The smiting God had struck them,"},{"id":"semetey-1-2013:p0476:b003:l008","ordinal":113136,"en":"Left them like an extinguished fire."},{"id":"semetey-1-2013:p0476:b003:l009","ordinal":113137,"en":"They had pulled out the pillar and toppled it,"},{"id":"semetey-1-2013:p0476:b003:l010","ordinal":113138,"en":"Cut down the plane tree and laid it low."},{"id":"semetey-1-2013:p0476:b003:l011","ordinal":113139,"en":"They had shown themselves true enemies."},{"id":"semetey-1-2013:p0476:b003:l012","ordinal":113140,"en":"All their dark eyes plunged into grief,"},{"id":"semetey-1-2013:p0476:b003:l013","ordinal":113141,"en":"Bereft of Khan Manas,"},{"id":"semetey-1-2013:p0476:b003:l014","ordinal":113142,"en":"They had long since met their ruin."},{"id":"semetey-1-2013:p0476:b003:l015","ordinal":113143,"en":"Breaking and wrecking the treasury,"},{"id":"semetey-1-2013:p0476:b003:l016","ordinal":113144,"en":"They had utterly sacked it."},{"id":"semetey-1-2013:p0476:b003:l017","ordinal":113145,"en":"Seeing this, Kyrgylchal"},{"id":"semetey-1-2013:p0476:b003:l018","ordinal":113146,"en":"Roared loud enough to split a rock,"},{"id":"semetey-1-2013:p0476:b003:l019","ordinal":113147,"en":"Cried loud enough to split a head,"},{"id":"semetey-1-2013:p0476:b003:l020","ordinal":113148,"en":"Tore out his mustache and flung it away,"},{"id":"semetey-1-2013:p0476:b003:l021","ordinal":113149,"en":"Plucked out his beard and flung it away:"},{"id":"semetey-1-2013:p0476:b003:l022","ordinal":113150,"en":"“Has the smiting God struck us,"},{"id":"semetey-1-2013:p0476:b003:l023","ordinal":113151,"en":"Crushed him from above?"},{"id":"semetey-1-2013:p0476:b003:l024","ordinal":113152,"en":"While he lay sleeping,"}]
