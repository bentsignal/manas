[{"id":"semetey-1-2013:p1122:b007:l005","ordinal":162817,"en":"I shall raid and seize your feast,"},{"id":"semetey-1-2013:p1122:b007:l006","ordinal":162818,"en":"And crush all your far-flung deeds,"},{"id":"semetey-1-2013:p1122:b007:l007","ordinal":162819,"en":"Burut!"},{"id":"semetey-1-2013:p1122:b007:l008","ordinal":162820,"en":"At the feast I shall dig"},{"id":"semetey-1-2013:p1122:b007:l009","ordinal":162821,"en":"The pit into which you will fall, Burut."},{"id":"semetey-1-2013:p1122:b007:l010","ordinal":162822,"en":"If I grow angry now,"},{"id":"semetey-1-2013:p1122:b007:l011","ordinal":162823,"en":"I shall send my army swarming, Burut,"},{"id":"semetey-1-2013:p1122:b007:l012","ordinal":162824,"en":"Upon this very place where you hold the feast!"},{"id":"semetey-1-2013:p1122:b007:l013","ordinal":162825,"en":"Is the one in whom you place such trust"},{"id":"semetey-1-2013:p1122:b007:l014","ordinal":162826,"en":"Your bloodthirsty hero Manas?"},{"id":"semetey-1-2013:p1122:b007:l015","ordinal":162827,"en":"I shall plunge my hand into the cauldron, Burut,"},{"id":"semetey-1-2013:p1122:b007:l016","ordinal":162828,"en":"And plunder your meat, Burut!"},{"id":"semetey-1-2013:p1122:b007:l017","ordinal":162829,"en":"I shall lay hands upon your leader, Burut,"},{"id":"semetey-1-2013:p1123:b003:l001","ordinal":162830,"en":"I shall plunder your fatty meat, Burut!"},{"id":"semetey-1-2013:p1123:b003:l002","ordinal":162831,"en":"I shall stride far—make room, Burut;"},{"id":"semetey-1-2013:p1123:b003:l003","ordinal":162832,"en":"Prepare now what I have demanded, Burut!"},{"id":"semetey-1-2013:p1123:b003:l004","ordinal":162833,"en":"If you will not prepare it, speak your words, Burut;"},{"id":"semetey-1-2013:p1123:b003:l005","ordinal":162834,"en":"Name the place where you will fight, Burut!\""},{"id":"semetey-1-2013:p1123:b003:l006","ordinal":162835,"en":"Speaking wrathful words, Ezkara"},{"id":"semetey-1-2013:p1123:b003:l007","ordinal":162836,"en":"Turned aside and raised a cloud of pale dust;"},{"id":"semetey-1-2013:p1123:b003:l008","ordinal":162837,"en":"Playing a pipe made of pale brass,"},{"id":"semetey-1-2013:p1123:b003:l009","ordinal":162838,"en":"He galloped away on Chongküröng."},{"id":"semetey-1-2013:p1123:b003:l010","ordinal":162839,"en":"To Kongurbay and Zholoy,"},{"id":"semetey-1-2013:p1123:b003:l011","ordinal":162840,"en":"He came for counsel."},{"id":"semetey-1-2013:p1123:b003:l012","ordinal":162841,"en":"\"Hey, Kongurbay, great Zholoy,"},{"id":"semetey-1-2013:p1123:b003:l013","ordinal":162842,"en":"I shall settle accounts"},{"id":"semetey-1-2013:p1123:b003:l014","ordinal":162843,"en":"With these foolish Kyrgyz Burut."},{"id":"semetey-1-2013:p1123:b003:l015","ordinal":162844,"en":"Let us not stand watching their feast;"},{"id":"semetey-1-2013:p1123:b003:l016","ordinal":162845,"en":"Let us test how many giants they have."},{"id":"semetey-1-2013:p1123:b003:l017","ordinal":162846,"en":"If their giants have no strength,"},{"id":"semetey-1-2013:p1123:b003:l018","ordinal":162847,"en":"Let us thrust spears into their feast"},{"id":"semetey-1-2013:p1123:b003:l019","ordinal":162848,"en":"And slaughter every one without remainder."},{"id":"semetey-1-2013:p1123:b003:l020","ordinal":162849,"en":"Let us seize their racehorses;"},{"id":"semetey-1-2013:p1123:b003:l021","ordinal":162850,"en":"Here in the midst of this feast,"},{"id":"semetey-1-2013:p1123:b003:l022","ordinal":162851,"en":"Let us firmly unleash disorder."},{"id":"semetey-1-2013:p1123:b003:l023","ordinal":162852,"en":"Let us plunder their cooking hearths"},{"id":"semetey-1-2013:p1123:b003:l024","ordinal":162853,"en":"And beat those who have come."},{"id":"semetey-1-2013:p1123:b003:l025","ordinal":162854,"en":"Let us trample the place of the feast"},{"id":"semetey-1-2013:p1123:b003:l026","ordinal":162855,"en":"And swarm upon the servants"},{"id":"semetey-1-2013:p1123:b003:l027","ordinal":162856,"en":"Who sit cooking the meat."},{"id":"semetey-1-2013:p1123:b003:l028","ordinal":162857,"en":"Speaking taunting, chilling words,"},{"id":"semetey-1-2013:p1123:b003:l029","ordinal":162858,"en":"Calling them bastard Burut,"},{"id":"semetey-1-2013:p1123:b003:l030","ordinal":162859,"en":"Wearing shameless coats,"},{"id":"semetey-1-2013:p1123:b003:l031","ordinal":162860,"en":"Let us jostle and attack them."},{"id":"semetey-1-2013:p1123:b003:l032","ordinal":162861,"en":"Let us utterly plunder"},{"id":"semetey-1-2013:p1123:b003:l033","ordinal":162862,"en":"The spectacle-loving Burut."},{"id":"semetey-1-2013:p1123:b003:l034","ordinal":162863,"en":"Let us stop the feast they have given,"},{"id":"semetey-1-2013:p1123:b003:l035","ordinal":162864,"en":"Push aside their leaders,"},{"id":"semetey-1-2013:p1123:b003:l036","ordinal":162865,"en":"And take possession of all their livestock."},{"id":"semetey-1-2013:p1123:b003:l037","ordinal":162866,"en":"Whoever resists,"},{"id":"semetey-1-2013:p1123:b003:l038","ordinal":162867,"en":"Let us slaughter utterly, leaving none;"},{"id":"semetey-1-2013:p1123:b003:l039","ordinal":162868,"en":"The meek who know no words,"},{"id":"semetey-1-2013:p1123:b005:l001","ordinal":162869,"en":"Let us bind them alive"},{"id":"semetey-1-2013:p1123:b005:l002","ordinal":162870,"en":"And make them denekul"},{"id":"semetey-1-2013:p1123:b005:l003","ordinal":162871,"en":"In the land of Kakan-Chyn.\""},{"id":"semetey-1-2013:p1123:b005:l004","ordinal":162872,"en":"When their khan spoke thus,"},{"id":"semetey-1-2013:p1123:b005:l005","ordinal":162873,"en":"Would the mass of black commoners"},{"id":"semetey-1-2013:p1123:b005:l006","ordinal":162874,"en":"Merely stand and watch?"},{"id":"semetey-1-2013:p1123:b005:l007","ordinal":162875,"en":"Would God strike the people"},{"id":"semetey-1-2013:p1123:b005:l008","ordinal":162876,"en":"For standing still and watching?"},{"id":"semetey-1-2013:p1123:b005:l009","ordinal":162877,"en":"The Chinese and Kalmyk champions"},{"id":"semetey-1-2013:p1123:b005:l010","ordinal":162878,"en":"Fell upon Kökötöy's meat-cooking hearth"},{"id":"semetey-1-2013:p1123:b005:l011","ordinal":162879,"en":"And began plundering it."},{"id":"semetey-1-2013:p1123:b005:l012","ordinal":162880,"en":"Not allowing the plunder to pass,"},{"id":"semetey-1-2013:p1123:b005:l013","ordinal":162881,"en":"They beat the servants."},{"id":"semetey-1-2013:p1123:b005:l014","ordinal":162882,"en":"The black Kalmyks and Manchu people—"},{"id":"semetey-1-2013:p1123:b005:l015","ordinal":162883,"en":"Their multitude was ten thousand black worms."},{"id":"semetey-1-2013:p1123:b005:l016","ordinal":162884,"en":"They gathered together,"},{"id":"semetey-1-2013:p1123:b005:l017","ordinal":162885,"en":"Fighting over uncooked meat."},{"id":"semetey-1-2013:p1123:b005:l018","ordinal":162886,"en":"The stronger among them"},{"id":"semetey-1-2013:p1123:b005:l019","ordinal":162887,"en":"Snatched it thundering from the weak;"},{"id":"semetey-1-2013:p1123:b005:l020","ordinal":162888,"en":"Unable to understand one another's speech,"},{"id":"semetey-1-2013:p1123:b005:l021","ordinal":162889,"en":"They stuffed it into sacks."},{"id":"semetey-1-2013:p1123:b005:l022","ordinal":162890,"en":"Those teeming Chinese had grown up indoors,"},{"id":"semetey-1-2013:p1123:b005:l023","ordinal":162891,"en":"A people who had never seen the outside."},{"id":"semetey-1-2013:p1123:b005:l024","ordinal":162892,"en":"The snarling infidels"},{"id":"semetey-1-2013:p1123:b005:l025","ordinal":162893,"en":"Never before, at any time,"},{"id":"semetey-1-2013:p1123:b005:l026","ordinal":162894,"en":"Had been a people who saw meat."},{"id":"semetey-1-2013:p1123:b005:l027","ordinal":162895,"en":"From the middle of some meat,"},{"id":"semetey-1-2013:p1123:b005:l028","ordinal":162896,"en":"Dark blood glistened;"},{"id":"semetey-1-2013:p1123:b005:l029","ordinal":162897,"en":"At the edge of some meat,"},{"id":"semetey-1-2013:p1123:b005:l030","ordinal":162898,"en":"Bloody foam seethed."},{"id":"semetey-1-2013:p1123:b005:l031","ordinal":162899,"en":"The black Kalmyks snarled,"},{"id":"semetey-1-2013:p1123:b005:l032","ordinal":162900,"en":"Not knowing it was blood."},{"id":"semetey-1-2013:p1123:b005:l033","ordinal":162901,"en":"The foolish Chinese fumed,"},{"id":"semetey-1-2013:p1123:b005:l034","ordinal":162902,"en":"Not knowing it was blood;"},{"id":"semetey-1-2013:p1123:b005:l035","ordinal":162903,"en":"They did not know it was raw."},{"id":"semetey-1-2013:p1123:b005:l036","ordinal":162904,"en":"Fighting over bloody meat,"},{"id":"semetey-1-2013:p1123:b005:l037","ordinal":162905,"en":"The smiling wretches"},{"id":"semetey-1-2013:p1123:b005:l038","ordinal":162906,"en":"Beat one another with bones."},{"id":"semetey-1-2013:p1123:b005:l039","ordinal":162907,"en":"Kökötöy's servants,"},{"id":"semetey-1-2013:p1124:b003:l001","ordinal":162908,"en":"Losing their wits,"},{"id":"semetey-1-2013:p1124:b003:l002","ordinal":162909,"en":"Abandoned the cauldrons"},{"id":"semetey-1-2013:p1124:b003:l003","ordinal":162910,"en":"And fled toward the mountains."},{"id":"semetey-1-2013:p1124:b003:l004","ordinal":162911,"en":"The pale-mottled red banners—"},{"id":"semetey-1-2013:p1124:b003:l005","ordinal":162912,"en":"The wailing Chinese"},{"id":"semetey-1-2013:p1124:b003:l006","ordinal":162913,"en":"Raised unceasing tumult."},{"id":"semetey-1-2013:p1124:b003:l007","ordinal":162914,"en":"They fell upon the meat,"},{"id":"semetey-1-2013:p1124:b003:l008","ordinal":162915,"en":"And all was confusion."},{"id":"semetey-1-2013:p1124:b003:l009","ordinal":162916,"en":"The Muslims who saw this"},{"id":"semetey-1-2013:p1124:b003:l010","ordinal":162917,"en":"Lost their wits,"},{"id":"semetey-1-2013:p1124:b003:l011","ordinal":162918,"en":"And fled to ask aid"},{"id":"semetey-1-2013:p1124:b003:l012","ordinal":162919,"en":"From Koshoy and Töshtük."},{"id":"semetey-1-2013:p1124:b003:l013","ordinal":162920,"en":"They rushed about in panic,"},{"id":"semetey-1-2013:p1124:b003:l014","ordinal":162921,"en":"Unable to find their bearings."},{"id":"semetey-1-2013:p1124:b003:l015","ordinal":162922,"en":"The Muslims lost their senses;"},{"id":"semetey-1-2013:p1124:b003:l016","ordinal":162923,"en":"Kökötöy's Bokmurun—"},{"id":"semetey-1-2013:p1124:b003:l017","ordinal":162924,"en":"They cursed his mother and father."},{"id":"semetey-1-2013:p1124:b003:l018","ordinal":162925,"en":"Fleeing, bolting, and running,"},{"id":"semetey-1-2013:p1124:b003:l019","ordinal":162926,"en":"The Muslims reeled in panic,"},{"id":"semetey-1-2013:p1124:b003:l020","ordinal":162927,"en":"Despairing of their dear lives."},{"id":"semetey-1-2013:p1124:b003:l021","ordinal":162928,"en":"Ezkara, khan of the Manchus,"},{"id":"semetey-1-2013:p1124:b003:l022","ordinal":162929,"en":"Raged on Chongküröng;"},{"id":"semetey-1-2013:p1124:b003:l023","ordinal":162930,"en":"The peerless, cunning diviner"},{"id":"semetey-1-2013:p1124:b003:l024","ordinal":162931,"en":"Prepared to test the heroes."},{"id":"semetey-1-2013:p1124:b003:l025","ordinal":162932,"en":"He wrapped himself in his armored coat"},{"id":"semetey-1-2013:p1124:b003:l026","ordinal":162933,"en":"And girded his unsheathed sword."},{"id":"semetey-1-2013:p1124:b003:l027","ordinal":162934,"en":"If you had seen Ezkara,"},{"id":"semetey-1-2013:p1124:b003:l028","ordinal":162935,"en":"He raged like a blue boar."},{"id":"semetey-1-2013:p1124:b003:l029","ordinal":162936,"en":"The hero Manas was not there;"},{"id":"semetey-1-2013:p1124:b003:l030","ordinal":162937,"en":"If the chance arose, Ezkara"},{"id":"semetey-1-2013:p1124:b003:l031","ordinal":162938,"en":"Prepared to slaughter"},{"id":"semetey-1-2013:p1124:b003:l032","ordinal":162939,"en":"All the Muslims."},{"id":"semetey-1-2013:p1124:b003:l033","ordinal":162940,"en":"Ezkara, khan of the infidels,"},{"id":"semetey-1-2013:p1124:b003:l034","ordinal":162941,"en":"Had a form as great as half a mountain;"},{"id":"semetey-1-2013:p1124:b003:l035","ordinal":162942,"en":"Were there no means from Khan Manas,"},{"id":"semetey-1-2013:p1124:b003:l036","ordinal":162943,"en":"He looked able to devour"},{"id":"semetey-1-2013:p1124:b003:l037","ordinal":162944,"en":"All the Muslims without remainder."},{"id":"semetey-1-2013:p1124:b003:l038","ordinal":162945,"en":"His fangs protruding,"},{"id":"semetey-1-2013:p1124:b003:l039","ordinal":162946,"en":"He slowly gathered"},{"id":"semetey-1-2013:p1124:b004:l001","ordinal":162947,"en":"Every swift horse"},{"id":"semetey-1-2013:p1124:b004:l002","ordinal":162948,"en":"And placed them in procession."},{"id":"semetey-1-2013:p1124:b004:l003","ordinal":162949,"en":"Leaving no Muslim aside,"},{"id":"semetey-1-2013:p1124:b004:l004","ordinal":162950,"en":"Did you see him gather their heroes?"},{"id":"semetey-1-2013:p1124:b004:l005","ordinal":162951,"en":"He gathered their heroes,"},{"id":"semetey-1-2013:p1124:b004:l006","ordinal":162952,"en":"Placed great Koshoy at their head,"},{"id":"semetey-1-2013:p1124:b004:l007","ordinal":162953,"en":"And arranged them in procession."},{"id":"semetey-1-2013:p1124:b004:l008","ordinal":162954,"en":"Khan Koshoy of the Katagan—"},{"id":"semetey-1-2013:p1124:b004:l009","ordinal":162955,"en":"He looked upon and assessed him:"},{"id":"semetey-1-2013:p1124:b004:l010","ordinal":162956,"en":"\"He made Chech-Döbö at At-Bashy"},{"id":"semetey-1-2013:p1124:b004:l011","ordinal":162957,"en":"Into a proper homeland,"},{"id":"semetey-1-2013:p1124:b004:l012","ordinal":162958,"en":"And made the scattered Kyrgyz"},{"id":"semetey-1-2013:p1124:b004:l013","ordinal":162959,"en":"Into a proper people."},{"id":"semetey-1-2013:p1124:b004:l014","ordinal":162960,"en":"Khan Koshoy of the Katagan"},{"id":"semetey-1-2013:p1124:b004:l015","ordinal":162961,"en":"Has reached eighty-five;"},{"id":"semetey-1-2013:p1124:b004:l016","ordinal":162962,"en":"All his courage"},{"id":"semetey-1-2013:p1124:b004:l017","ordinal":162963,"en":"Has fled his body."},{"id":"semetey-1-2013:p1124:b004:l018","ordinal":162964,"en":"His neck has grown long,"},{"id":"semetey-1-2013:p1124:b004:l019","ordinal":162965,"en":"His sunken eyes have reddened,"},{"id":"semetey-1-2013:p1124:b004:l020","ordinal":162966,"en":"His joints have grown loose,"},{"id":"semetey-1-2013:p1124:b004:l021","ordinal":162967,"en":"And his eyes glint off to the side."},{"id":"semetey-1-2013:p1124:b004:l022","ordinal":162968,"en":"Both corners of his eyes fester;"},{"id":"semetey-1-2013:p1124:b004:l023","ordinal":162969,"en":"His whole body trembles."},{"id":"semetey-1-2013:p1124:b004:l024","ordinal":162970,"en":"He is a man grown old—"},{"id":"semetey-1-2013:p1124:b004:l025","ordinal":162971,"en":"How many stratagems"},{"id":"semetey-1-2013:p1124:b004:l026","ordinal":162972,"en":"Can Koshoy of the Burut possess?"},{"id":"semetey-1-2013:p1124:b004:l027","ordinal":162973,"en":"If I become angry, I shall not relent;"},{"id":"semetey-1-2013:p1124:b004:l028","ordinal":162974,"en":"I would not be satisfied"},{"id":"semetey-1-2013:p1124:b004:l029","ordinal":162975,"en":"With eighty old men like this.\""},{"id":"semetey-1-2013:p1124:b004:l030","ordinal":162976,"en":"Then he saw"},{"id":"semetey-1-2013:p1124:b004:l031","ordinal":162977,"en":"Er Töshtük, son of Eleman,"},{"id":"semetey-1-2013:p1124:b004:l032","ordinal":162978,"en":"Cast his exceptional gaze upon him,"},{"id":"semetey-1-2013:p1124:b004:l033","ordinal":162979,"en":"And began to assess him."},{"id":"semetey-1-2013:p1124:b004:l034","ordinal":162980,"en":"What could dear Töshtük do?"},{"id":"semetey-1-2013:p1124:b004:l035","ordinal":162981,"en":"His right shoulder was broad;"},{"id":"semetey-1-2013:p1124:b004:l036","ordinal":162982,"en":"He was a hero who could shatter the Oirat."},{"id":"semetey-1-2013:p1124:b004:l037","ordinal":162983,"en":"Thick-wristed and stone-hearted,"},{"id":"semetey-1-2013:p1124:b004:l038","ordinal":162984,"en":"His prowess was of another kind."},{"id":"semetey-1-2013:p1124:b004:l039","ordinal":162985,"en":"The lion among born heroes,"},{"id":"semetey-1-2013:p1125:b003:l001","ordinal":162986,"en":"He himself was the people's blessed elder."},{"id":"semetey-1-2013:p1125:b003:l002","ordinal":162987,"en":"He was an exceptional hero."},{"id":"semetey-1-2013:p1125:b003:l003","ordinal":162988,"en":"He had stubborn joints"},{"id":"semetey-1-2013:p1125:b003:l004","ordinal":162989,"en":"That would not heal in six years."},{"id":"semetey-1-2013:p1125:b003:l005","ordinal":162990,"en":"His flesh was raw and bruised,"},{"id":"semetey-1-2013:p1125:b003:l006","ordinal":162991,"en":"His blood remained but one spoonful."},{"id":"semetey-1-2013:p1125:b003:l007","ordinal":162992,"en":"Until his rib bones filled out,"},{"id":"semetey-1-2013:p1125:b003:l008","ordinal":162993,"en":"Until seven years had passed,"},{"id":"semetey-1-2013:p1125:b003:l009","ordinal":162994,"en":"If we fought, I would not be sated with blood;"},{"id":"semetey-1-2013:p1125:b003:l010","ordinal":162995,"en":"I would not spare this Töshtük."},{"id":"semetey-1-2013:p1125:b003:l011","ordinal":162996,"en":"With weapons filling an armful,"},{"id":"semetey-1-2013:p1125:b003:l012","ordinal":162997,"en":"There was Muzburchak of Khan Buudayyk,"},{"id":"semetey-1-2013:p1125:b003:l013","ordinal":162998,"en":"Watching the uproar;"},{"id":"semetey-1-2013:p1125:b003:l014","ordinal":162999,"en":"He tested him as well."},{"id":"semetey-1-2013:p1125:b003:l015","ordinal":163000,"en":"What could dear Burchak do?"},{"id":"semetey-1-2013:p1125:b003:l016","ordinal":163001,"en":"His fierce eyes were like Venus,"},{"id":"semetey-1-2013:p1125:b003:l017","ordinal":163002,"en":"His moonlike ears were shields,"},{"id":"semetey-1-2013:p1125:b003:l018","ordinal":163003,"en":"And his neck was wholly thick."},{"id":"semetey-1-2013:p1125:b003:l019","ordinal":163004,"en":"Looking over his whole body,"},{"id":"semetey-1-2013:p1125:b003:l020","ordinal":163005,"en":"He had the strength of ninety men."},{"id":"semetey-1-2013:p1125:b003:l021","ordinal":163006,"en":"An exceptional man had been born;"},{"id":"semetey-1-2013:p1125:b003:l022","ordinal":163007,"en":"In figure, dignity,"},{"id":"semetey-1-2013:p1125:b003:l023","ordinal":163008,"en":"And appearance on horseback,"},{"id":"semetey-1-2013:p1125:b003:l024","ordinal":163009,"en":"He matched Orokkyr,"},{"id":"semetey-1-2013:p1125:b003:l025","ordinal":163010,"en":"Khan of the Shibee."},{"id":"semetey-1-2013:p1125:b003:l026","ordinal":163011,"en":"His axe was unusually grim;"},{"id":"semetey-1-2013:p1125:b003:l027","ordinal":163012,"en":"Considering his substance,"},{"id":"semetey-1-2013:p1125:b003:l028","ordinal":163013,"en":"He was one of the heroes."},{"id":"semetey-1-2013:p1125:b003:l029","ordinal":163014,"en":"Then hero Kökchö, son of Aydarkan,"},{"id":"semetey-1-2013:p1125:b003:l030","ordinal":163015,"en":"Came before him,"},{"id":"semetey-1-2013:p1125:b003:l031","ordinal":163016,"en":"And he assessed him:"},{"id":"semetey-1-2013:p1125:b003:l032","ordinal":163017,"en":"\"His blue-mottled horse stamps noisily;"},{"id":"semetey-1-2013:p1125:b003:l033","ordinal":163018,"en":"His great lungs wheeze."},{"id":"semetey-1-2013:p1125:b003:l034","ordinal":163019,"en":"Thin, clattering ayran, a narrow sieve—"},{"id":"semetey-1-2013:p1125:b003:l035","ordinal":163020,"en":"The shrill-voiced hero Kökchö"},{"id":"semetey-1-2013:p1125:b003:l036","ordinal":163021,"en":"Is a chatterer with a maiden's courage."},{"id":"semetey-1-2013:p1125:b003:l037","ordinal":163022,"en":"One who tucks letters in his hem—"},{"id":"semetey-1-2013:p1125:b003:l038","ordinal":163023,"en":"What fool gave this man"},{"id":"semetey-1-2013:p1125:b003:l039","ordinal":163024,"en":"The name hero Kökchö?\""},{"id":"semetey-1-2013:p1125:b004:l001","ordinal":163025,"en":"Seeing Kökchö, Ezkara mocked him,"},{"id":"semetey-1-2013:p1125:b004:l002","ordinal":163026,"en":"Tormented him,"},{"id":"semetey-1-2013:p1125:b004:l003","ordinal":163027,"en":"And trampled the many Kazakhs."},{"id":"semetey-1-2013:p1125:b004:l004","ordinal":163028,"en":"On this nearer side"},{"id":"semetey-1-2013:p1125:b004:l005","ordinal":163029,"en":"Was elbow-sized hero Agysh,"},{"id":"semetey-1-2013:p1125:b004:l006","ordinal":163030,"en":"His whole body sinew."},{"id":"semetey-1-2013:p1125:b004:l007","ordinal":163031,"en":"He looked upon him"},{"id":"semetey-1-2013:p1125:b004:l008","ordinal":163032,"en":"And assessed him closely."},{"id":"semetey-1-2013:p1125:b004:l009","ordinal":163033,"en":"Every soul who saw him felt content;"},{"id":"semetey-1-2013:p1125:b004:l010","ordinal":163034,"en":"A champion on foot, useless on horseback,"},{"id":"semetey-1-2013:p1125:b004:l011","ordinal":163035,"en":"He set fire to those who grappled with him."},{"id":"semetey-1-2013:p1125:b004:l012","ordinal":163036,"en":"Bull-necked, with thighs like a stallion,"},{"id":"semetey-1-2013:p1125:b004:l013","ordinal":163037,"en":"His build differed from a man's;"},{"id":"semetey-1-2013:p1125:b004:l014","ordinal":163038,"en":"He ruined those who wrestled him."},{"id":"semetey-1-2013:p1125:b004:l015","ordinal":163039,"en":"When he thrust his spear and shouted,"},{"id":"semetey-1-2013:p1125:b004:l016","ordinal":163040,"en":"He possessed great skill."},{"id":"semetey-1-2013:p1125:b004:l017","ordinal":163041,"en":"When he gripped the trigger and drew the bow,"},{"id":"semetey-1-2013:p1125:b004:l018","ordinal":163042,"en":"He possessed great prowess."},{"id":"semetey-1-2013:p1125:b004:l019","ordinal":163043,"en":"With the chest of a hungry lion"},{"id":"semetey-1-2013:p1125:b004:l020","ordinal":163044,"en":"And the eyes of a hunting eagle,"},{"id":"semetey-1-2013:p1125:b004:l021","ordinal":163045,"en":"He raised high at the feast"},{"id":"semetey-1-2013:p1125:b004:l022","ordinal":163046,"en":"A fine steel-patterned spear,"},{"id":"semetey-1-2013:p1125:b004:l023","ordinal":163047,"en":"And threw down and crushed"},{"id":"semetey-1-2013:p1125:b004:l024","ordinal":163048,"en":"The champion who faced him."},{"id":"semetey-1-2013:p1125:b004:l025","ordinal":163049,"en":"Spear shafts bent at the middle"},{"id":"semetey-1-2013:p1125:b004:l026","ordinal":163050,"en":"If they unexpectedly quarreled;"},{"id":"semetey-1-2013:p1125:b004:l027","ordinal":163051,"en":"In Beijing of Kakan-Chyn,"},{"id":"semetey-1-2013:p1125:b004:l028","ordinal":163052,"en":"They would joust this way for six days.\""},{"id":"semetey-1-2013:p1125:b004:l029","ordinal":163053,"en":"He took a slight liking"},{"id":"semetey-1-2013:p1125:b004:l030","ordinal":163054,"en":"To elbow-sized Agysh."},{"id":"semetey-1-2013:p1125:b004:l031","ordinal":163055,"en":"Raging upon a pale-gray stake of a horse,"},{"id":"semetey-1-2013:p1125:b004:l032","ordinal":163056,"en":"Surging straight before him,"},{"id":"semetey-1-2013:p1125:b004:l033","ordinal":163057,"en":"Kökbörü appeared;"},{"id":"semetey-1-2013:p1125:b004:l034","ordinal":163058,"en":"He assessed him."},{"id":"semetey-1-2013:p1125:b004:l035","ordinal":163059,"en":"His fortune was complete;"},{"id":"semetey-1-2013:p1125:b004:l036","ordinal":163060,"en":"Kökbörü, son of Urumkan,"},{"id":"semetey-1-2013:p1125:b004:l037","ordinal":163061,"en":"Was a merciless hero."},{"id":"semetey-1-2013:p1125:b004:l038","ordinal":163062,"en":"Broad-chested and wide-breasted,"},{"id":"semetey-1-2013:p1125:b004:l039","ordinal":163063,"en":"Both champion and lion."},{"id":"semetey-1-2013:p1126:b003:l001","ordinal":163064,"en":"His beard was sparse, hair by hair;"},{"id":"semetey-1-2013:p1126:b003:l002","ordinal":163065,"en":"He was beardless."},{"id":"semetey-1-2013:p1126:b003:l003","ordinal":163066,"en":"He was practiced at facing the enemy;"},{"id":"semetey-1-2013:p1126:b003:l004","ordinal":163067,"en":"He possessed leadership."},{"id":"semetey-1-2013:p1126:b003:l005","ordinal":163068,"en":"With red spear and Zulpukor,"},{"id":"semetey-1-2013:p1126:b003:l006","ordinal":163069,"en":"He was a hero who struck in turn."},{"id":"semetey-1-2013:p1126:b003:l007","ordinal":163070,"en":"In our Kakan and Beijing,"},{"id":"semetey-1-2013:p1126:b003:l008","ordinal":163071,"en":"He was a hero who could endure"},{"id":"semetey-1-2013:p1126:b003:l009","ordinal":163072,"en":"Forty days of jousting."}]
