[{"id":"semetey-1-2013:p0429:b004:l008","ordinal":109569,"en":"Kongurbay was himself fierce."},{"id":"semetey-1-2013:p0429:b004:l009","ordinal":109570,"en":"They thrust at one another in turns,"},{"id":"semetey-1-2013:p0429:b004:l010","ordinal":109571,"en":"Each seizing his turn."},{"id":"semetey-1-2013:p0429:b004:l011","ordinal":109572,"en":"Of the warriors who entered their midst,"},{"id":"semetey-1-2013:p0429:b004:l012","ordinal":109573,"en":"Sixty at a time, seventy,"},{"id":"semetey-1-2013:p0429:b004:l013","ordinal":109574,"en":"They slew outright."},{"id":"semetey-1-2013:p0429:b004:l014","ordinal":109575,"en":"Earth flew; dust covered all."},{"id":"semetey-1-2013:p0429:b004:l015","ordinal":109576,"en":"The sky was clear, the earth overcast."},{"id":"semetey-1-2013:p0429:b004:l016","ordinal":109577,"en":"Not a single blade was visible on the ground;"},{"id":"semetey-1-2013:p0429:b004:l017","ordinal":109578,"en":"Looking, the eye could catch nothing."},{"id":"semetey-1-2013:p0429:b004:l018","ordinal":109579,"en":"As though tumbleweed were flying,"},{"id":"semetey-1-2013:p0429:b004:l019","ordinal":109580,"en":"No one could tell which was which."},{"id":"semetey-1-2013:p0429:b004:l020","ordinal":109581,"en":"The sun glimmered and grew dim;"},{"id":"semetey-1-2013:p0429:b004:l021","ordinal":109582,"en":"The sun's eye was veiled."},{"id":"semetey-1-2013:p0429:b004:l022","ordinal":109583,"en":"The moon glimmered and grew dim;"},{"id":"semetey-1-2013:p0429:b004:l023","ordinal":109584,"en":"The moon's eye was veiled."},{"id":"semetey-1-2013:p0429:b004:l024","ordinal":109585,"en":"Darkness settled and spread;"},{"id":"semetey-1-2013:p0429:b004:l025","ordinal":109586,"en":"People's sight was bound."},{"id":"semetey-1-2013:p0429:b004:l026","ordinal":109587,"en":"Gray, hazy dust rose;"},{"id":"semetey-1-2013:p0429:b004:l027","ordinal":109588,"en":"Earth flew whistling."},{"id":"semetey-1-2013:p0429:b004:l028","ordinal":109589,"en":"In Talas, the Kyrgyz and Argyn—"},{"id":"semetey-1-2013:p0429:b004:l029","ordinal":109590,"en":"Their women and girls cried out."},{"id":"semetey-1-2013:p0429:b004:l030","ordinal":109591,"en":"Losing their bearings and their strength,"},{"id":"semetey-1-2013:p0429:b004:l031","ordinal":109592,"en":"They fell into confusion."},{"id":"semetey-1-2013:p0429:b004:l032","ordinal":109593,"en":"Alone enduring hardship,"},{"id":"semetey-1-2013:p0429:b004:l033","ordinal":109594,"en":"Your generous father fought."},{"id":"semetey-1-2013:p0429:b004:l034","ordinal":109595,"en":"With Alakoo's Kongurbay,"},{"id":"semetey-1-2013:p0429:b004:l035","ordinal":109596,"en":"They stood shouting at one another."},{"id":"semetey-1-2013:p0429:b004:l036","ordinal":109597,"en":"Roaring, they thrust their spears;"},{"id":"semetey-1-2013:p0429:b004:l037","ordinal":109598,"en":"The spears they thrust broke."},{"id":"semetey-1-2013:p0429:b004:l038","ordinal":109599,"en":"Men wearied; strength ebbed,"},{"id":"semetey-1-2013:p0429:b004:l039","ordinal":109600,"en":"In the slaughter where they met,"},{"id":"semetey-1-2013:p0430:b003:l001","ordinal":109601,"en":"Weakened as his dark blood flowed,"},{"id":"semetey-1-2013:p0430:b003:l002","ordinal":109602,"en":"When he was in dire distress,"},{"id":"semetey-1-2013:p0430:b003:l003","ordinal":109603,"en":"Your father grinned broadly,"},{"id":"semetey-1-2013:p0430:b003:l004","ordinal":109604,"en":"Utterly unconcerned,"},{"id":"semetey-1-2013:p0430:b003:l005","ordinal":109605,"en":"The countless Chinese wrestlers"},{"id":"semetey-1-2013:p0430:b003:l006","ordinal":109606,"en":"He deemed worth less than his trouser hem."},{"id":"semetey-1-2013:p0430:b003:l007","ordinal":109607,"en":"His guardian spirit Kojosan"},{"id":"semetey-1-2013:p0430:b003:l008","ordinal":109608,"en":"Rushed in to support his arms."},{"id":"semetey-1-2013:p0430:b003:l010","ordinal":109609,"en":"They gathered like forty thousand souls.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0430:b003:l011","ordinal":109610,"en":"The black-spotted leopard—"},{"id":"semetey-1-2013:p0430:b003:l012","ordinal":109611,"en":"If you looked, your fierce father—"},{"id":"semetey-1-2013:p0430:b003:l013","ordinal":109612,"en":"It leapt beside his flank."},{"id":"semetey-1-2013:p0430:b003:l014","ordinal":109613,"en":"The short-tailed, fierce-maned lion"},{"id":"semetey-1-2013:p0430:b003:l015","ordinal":109614,"en":"Made ready close beside him."},{"id":"semetey-1-2013:p0430:b003:l016","ordinal":109615,"en":"When your fortunate leopard father"},{"id":"semetey-1-2013:p0430:b003:l017","ordinal":109616,"en":"Charged ahead,"},{"id":"semetey-1-2013:p0430:b003:l018","ordinal":109617,"en":"He seemed like six thousand troops."},{"id":"semetey-1-2013:p0430:b003:l019","ordinal":109618,"en":"At the sight of that great form,"},{"id":"semetey-1-2013:p0430:b003:l020","ordinal":109619,"en":"The Chinese scattered in flight."},{"id":"semetey-1-2013:p0430:b003:l021","ordinal":109620,"en":"Those Chinese who had fled"},{"id":"semetey-1-2013:p0430:b003:l022","ordinal":109621,"en":"Shed blood when he caught them."},{"id":"semetey-1-2013:p0430:b003:l023","ordinal":109622,"en":"Among the fleeing Chinese,"},{"id":"semetey-1-2013:p0430:b003:l024","ordinal":109623,"en":"Kongurbay gathered his courage."},{"id":"semetey-1-2013:p0430:b003:l025","ordinal":109624,"en":"Just because he was Chinese,"},{"id":"semetey-1-2013:p0430:b003:l026","ordinal":109625,"en":"Let us not belittle Kongurbay."},{"id":"semetey-1-2013:p0430:b003:l027","ordinal":109626,"en":"Fortune favored him in all things;"},{"id":"semetey-1-2013:p0430:b003:l028","ordinal":109627,"en":"He was a hero born in Beijing."},{"id":"semetey-1-2013:p0430:b003:l029","ordinal":109628,"en":"From the countless seething host"},{"id":"semetey-1-2013:p0430:b003:l030","ordinal":109629,"en":"Came blood-red-whipped Shypshaydar,"},{"id":"semetey-1-2013:p0430:b003:l031","ordinal":109630,"en":"The khan called Shypshaydar."},{"id":"semetey-1-2013:p0430:b003:l032","ordinal":109631,"en":"Ill-natured Kongurbay—"},{"id":"semetey-1-2013:p0430:b003:l033","ordinal":109632,"en":"The wretch's voice could frighten souls away."},{"id":"semetey-1-2013:p0430:b003:l034","ordinal":109633,"en":"Kongurbay's black horse,"},{"id":"semetey-1-2013:p0430:b003:l035","ordinal":109634,"en":"That black horse had"},{"id":"semetey-1-2013:p0430:b003:l036","ordinal":109635,"en":"Wings upon its flanks."},{"id":"semetey-1-2013:p0430:b003:l037","ordinal":109636,"en":"When his precious life was pressed,"},{"id":"semetey-1-2013:p0430:b003:l038","ordinal":109637,"en":"Ill-natured Kongurbay"},{"id":"semetey-1-2013:p0430:b003:l039","ordinal":109638,"en":"The Black Kalmyks and Manchus—"},{"id":"semetey-1-2013:p0430:b004:l001","ordinal":109639,"en":"He would beat their mighty warriors:"},{"id":"semetey-1-2013:p0430:b004:l002","ordinal":109640,"en":"Driving them forward was his custom."},{"id":"semetey-1-2013:p0430:b004:l003","ordinal":109641,"en":"The coat-clad Chinese—"},{"id":"semetey-1-2013:p0430:b004:l004","ordinal":109642,"en":"He beat their strongest men"},{"id":"semetey-1-2013:p0430:b004:l005","ordinal":109643,"en":"And drove them into battle."},{"id":"semetey-1-2013:p0430:b004:l006","ordinal":109644,"en":"His armguards looming broad,"},{"id":"semetey-1-2013:p0430:b004:l007","ordinal":109645,"en":"Kongurbay pressed in to surround him."},{"id":"semetey-1-2013:p0430:b004:l008","ordinal":109646,"en":"The Black Kalmyks and Manchus"},{"id":"semetey-1-2013:p0430:b004:l009","ordinal":109647,"en":"Kongurbay drove in with blows."},{"id":"semetey-1-2013:p0430:b004:l010","ordinal":109648,"en":"The reason he drove them in—"},{"id":"semetey-1-2013:p0430:b004:l011","ordinal":109649,"en":"Was Kongurbay not a hero?"},{"id":"semetey-1-2013:p0430:b004:l012","ordinal":109650,"en":"Of Beijing’s Chinese and Manchus,"},{"id":"semetey-1-2013:p0430:b004:l013","ordinal":109651,"en":"Was Kongurbay not the backbone?"},{"id":"semetey-1-2013:p0430:b004:l014","ordinal":109652,"en":"Do not despise him as an unbeliever:"},{"id":"semetey-1-2013:p0430:b004:l015","ordinal":109653,"en":"Was Kongurbay not a lion?"},{"id":"semetey-1-2013:p0430:b004:l016","ordinal":109654,"en":"His coat of mail spreading wide,"},{"id":"semetey-1-2013:p0430:b004:l017","ordinal":109655,"en":"He beat his mighty warriors"},{"id":"semetey-1-2013:p0430:b004:l018","ordinal":109656,"en":"And hammered them forward."},{"id":"semetey-1-2013:p0430:b004:l019","ordinal":109657,"en":"Mace-bearing Tiken the mighty,"},{"id":"semetey-1-2013:p0430:b004:l020","ordinal":109658,"en":"The men with iron-rope nets,"},{"id":"semetey-1-2013:p0430:b004:l021","ordinal":109659,"en":"And all the Dagger-Hands—"},{"id":"semetey-1-2013:p0430:b004:l022","ordinal":109660,"en":"Once their khan had swarmed upon him,"},{"id":"semetey-1-2013:p0430:b004:l023","ordinal":109661,"en":"The great Chinese host grew thick."},{"id":"semetey-1-2013:p0430:b004:l024","ordinal":109662,"en":"Once they had all swarmed upon him,"},{"id":"semetey-1-2013:p0430:b004:l025","ordinal":109663,"en":"They would cast an iron net,"},{"id":"semetey-1-2013:p0430:b004:l026","ordinal":109664,"en":"Surround your father,"},{"id":"semetey-1-2013:p0430:b004:l027","ordinal":109665,"en":"And take him alive."},{"id":"semetey-1-2013:p0430:b004:l028","ordinal":109666,"en":"To Beijing's highborn women"},{"id":"semetey-1-2013:p0430:b004:l029","ordinal":109667,"en":"They would take him as a breeding stallion,"},{"id":"semetey-1-2013:p0430:b004:l030","ordinal":109668,"en":"On your own father, fierce Manas,"},{"id":"semetey-1-2013:p0430:b004:l031","ordinal":109669,"en":"They would take vengeance thus..."},{"id":"semetey-1-2013:p0430:b004:l032","ordinal":109670,"en":"Gray haze and burning dust,"},{"id":"semetey-1-2013:p0430:b004:l033","ordinal":109671,"en":"So many dying souls—"},{"id":"semetey-1-2013:p0430:b004:l034","ordinal":109672,"en":"With his wits shaken and strength gone,"},{"id":"semetey-1-2013:p0430:b004:l035","ordinal":109673,"en":"There was your father,"},{"id":"semetey-1-2013:p0430:b004:l036","ordinal":109674,"en":"Surrounded by the Chinese host."},{"id":"semetey-1-2013:p0430:b004:l037","ordinal":109675,"en":"Many strong warriors reached him."},{"id":"semetey-1-2013:p0430:b004:l038","ordinal":109676,"en":"As the swarming Chinese drew near,"},{"id":"semetey-1-2013:p0430:b004:l039","ordinal":109677,"en":"Your noble, fierce father—"},{"id":"semetey-1-2013:p0431:b003:l001","ordinal":109678,"en":"As they were about to take him alive,"},{"id":"semetey-1-2013:p0431:b003:l002","ordinal":109679,"en":"And bring him to such ruin,"},{"id":"semetey-1-2013:p0431:b003:l003","ordinal":109680,"en":"I, your unfortunate mother, said:"},{"id":"semetey-1-2013:p0431:b003:l004","ordinal":109681,"en":"'If my death has come, let me die;"},{"id":"semetey-1-2013:p0431:b003:l005","ordinal":109682,"en":"For my own generous lord,"},{"id":"semetey-1-2013:p0431:b003:l006","ordinal":109683,"en":"If I live, this woman"},{"id":"semetey-1-2013:p0431:b003:l007","ordinal":109684,"en":"Will stand at his side.'"},{"id":"semetey-1-2013:p0431:b003:l008","ordinal":109685,"en":"Saying this, wretched as I was,"},{"id":"semetey-1-2013:p0431:b003:l009","ordinal":109686,"en":"I leveled my spear and shouted,"},{"id":"semetey-1-2013:p0431:b003:l010","ordinal":109687,"en":"Concealing that I was a woman."},{"id":"semetey-1-2013:p0431:b003:l011","ordinal":109688,"en":"With 'Manas!' as my battle cry,"},{"id":"semetey-1-2013:p0431:b003:l012","ordinal":109689,"en":"Those shameless Chinese and Manchus"},{"id":"semetey-1-2013:p0431:b003:l013","ordinal":109690,"en":"From your fierce father Manas"},{"id":"semetey-1-2013:p0431:b003:l014","ordinal":109691,"en":"I drove back in confusion."},{"id":"semetey-1-2013:p0431:b003:l015","ordinal":109692,"en":"My crown chilled, my arms grew weary,"},{"id":"semetey-1-2013:p0431:b003:l016","ordinal":109693,"en":"As we aimed blows at one another's heads,"},{"id":"semetey-1-2013:p0431:b003:l017","ordinal":109694,"en":"Clashing with our spears,"},{"id":"semetey-1-2013:p0431:b003:l018","ordinal":109695,"en":"Struggling this way and that,"},{"id":"semetey-1-2013:p0431:b003:l019","ordinal":109696,"en":"The steadily leveled spears"},{"id":"semetey-1-2013:p0431:b003:l020","ordinal":109697,"en":"We parried from the front."},{"id":"semetey-1-2013:p0431:b003:l021","ordinal":109698,"en":"Those whose death had come died,"},{"id":"semetey-1-2013:p0431:b003:l022","ordinal":109699,"en":"And what Allah had ordained,"},{"id":"semetey-1-2013:p0431:b003:l023","ordinal":109700,"en":"Our wretched heads endured."},{"id":"semetey-1-2013:p0431:b003:l024","ordinal":109701,"en":"Your father, Manas the lion—"},{"id":"semetey-1-2013:p0431:b003:l025","ordinal":109702,"en":"They had heard he was a hero."},{"id":"semetey-1-2013:p0431:b003:l026","ordinal":109703,"en":"Clashing with the bloody khan,"},{"id":"semetey-1-2013:p0431:b003:l027","ordinal":109704,"en":"Your leopard father, fierce hero,"},{"id":"semetey-1-2013:p0431:b003:l028","ordinal":109705,"en":"Fought without retreating."},{"id":"semetey-1-2013:p0431:b003:l029","ordinal":109706,"en":"Leaning low, he speared a warrior,"},{"id":"semetey-1-2013:p0431:b003:l030","ordinal":109707,"en":"And the ancient Shibe and Manchu—"},{"id":"semetey-1-2013:p0431:b003:l031","ordinal":109708,"en":"He speared many of them in a row."},{"id":"semetey-1-2013:p0431:b003:l032","ordinal":109709,"en":"Wheeling Akkula about,"},{"id":"semetey-1-2013:p0431:b003:l033","ordinal":109710,"en":"He made the Shibe and Torgut fighters"},{"id":"semetey-1-2013:p0431:b003:l034","ordinal":109711,"en":"Who faced him fall and crawl."},{"id":"semetey-1-2013:p0431:b003:l035","ordinal":109712,"en":"When your khan father, blessed by Kyzyr,"},{"id":"semetey-1-2013:p0431:b003:l036","ordinal":109713,"en":"Wrought that dreadful slaughter,"},{"id":"semetey-1-2013:p0431:b003:l037","ordinal":109714,"en":"When the Argyn and Kyrgyz people"},{"id":"semetey-1-2013:p0431:b003:l038","ordinal":109715,"en":"From those Chinese hands"},{"id":"semetey-1-2013:p0431:b003:l039","ordinal":109716,"en":"He rescued,"},{"id":"semetey-1-2013:p0431:b004:l001","ordinal":109717,"en":"Of your father's Akkula,"},{"id":"semetey-1-2013:p0431:b004:l002","ordinal":109718,"en":"The swift steed, let me tell:"},{"id":"semetey-1-2013:p0431:b004:l003","ordinal":109719,"en":"When his precious life was pressed"},{"id":"semetey-1-2013:p0431:b004:l004","ordinal":109720,"en":"And the immense Chinese host came,"},{"id":"semetey-1-2013:p0431:b004:l005","ordinal":109721,"en":"As he ran downhill,"},{"id":"semetey-1-2013:p0431:b004:l006","ordinal":109722,"en":"Your father's Akkula"},{"id":"semetey-1-2013:p0431:b004:l007","ordinal":109723,"en":"Planted his forelegs like a roe deer."},{"id":"semetey-1-2013:p0431:b004:l008","ordinal":109724,"en":"As he headed uphill,"},{"id":"semetey-1-2013:p0431:b004:l009","ordinal":109725,"en":"That peerless winged steed"},{"id":"semetey-1-2013:p0431:b004:l010","ordinal":109726,"en":"Spread his mane and tail."},{"id":"semetey-1-2013:p0431:b004:l011","ordinal":109727,"en":"When he came to rounded hillocks,"},{"id":"semetey-1-2013:p0431:b004:l013","ordinal":109728,"en":"Bounding and darting as he ran.","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0431:b004:l014","ordinal":109729,"en":"When he came to hilly ground,"},{"id":"semetey-1-2013:p0431:b004:l015","ordinal":109730,"en":"His eyes flashed like flint."},{"id":"semetey-1-2013:p0431:b004:l016","ordinal":109731,"en":"When he truly raced straight ahead,"},{"id":"semetey-1-2013:p0431:b004:l017","ordinal":109732,"en":"His mane and tail spread wide,"},{"id":"semetey-1-2013:p0431:b004:l018","ordinal":109733,"en":"And white foam mixed with blood"},{"id":"semetey-1-2013:p0431:b004:l019","ordinal":109734,"en":"Clung to his breast."},{"id":"semetey-1-2013:p0431:b004:l020","ordinal":109735,"en":"I watched in wonder,"},{"id":"semetey-1-2013:p0431:b004:l021","ordinal":109736,"en":"Saying, 'God, protect my only one!'"},{"id":"semetey-1-2013:p0431:b004:l022","ordinal":109737,"en":"And pleading with the Creator."},{"id":"semetey-1-2013:p0431:b004:l023","ordinal":109738,"en":"In some places,"},{"id":"semetey-1-2013:p0431:b004:l024","ordinal":109739,"en":"Your father's Akkula"},{"id":"semetey-1-2013:p0431:b004:l025","ordinal":109740,"en":"Raced the flying birds."},{"id":"semetey-1-2013:p0431:b004:l026","ordinal":109741,"en":"The specially braided white reins"},{"id":"semetey-1-2013:p0431:b004:l027","ordinal":109742,"en":"Grew rigid in his palm,"},{"id":"semetey-1-2013:p0431:b004:l028","ordinal":109743,"en":"Of that immeasurably swift steed,"},{"id":"semetey-1-2013:p0431:b004:l029","ordinal":109744,"en":"He wrestled with the bit."},{"id":"semetey-1-2013:p0431:b004:l030","ordinal":109745,"en":"Your father's Akkula—"},{"id":"semetey-1-2013:p0431:b004:l031","ordinal":109746,"en":"No animal matched his walk,"},{"id":"semetey-1-2013:p0431:b004:l032","ordinal":109747,"en":"No wind matched his trot."},{"id":"semetey-1-2013:p0431:b004:l033","ordinal":109748,"en":"The wind could not match him"},{"id":"semetey-1-2013:p0431:b004:l034","ordinal":109749,"en":"Because he was the Duldul of horses."},{"id":"semetey-1-2013:p0431:b004:l035","ordinal":109750,"en":"His custom was to ride six horses."},{"id":"semetey-1-2013:p0431:b004:l036","ordinal":109751,"en":"Your father's wings—"},{"id":"semetey-1-2013:p0431:b004:l037","ordinal":109752,"en":"Raiding the village and causing strife"},{"id":"semetey-1-2013:p0431:b004:l038","ordinal":109753,"en":"Was Kongurbay's custom."},{"id":"semetey-1-2013:p0431:b004:l039","ordinal":109754,"en":"'I will bind Manas and take him,' he said."},{"id":"semetey-1-2013:p0432:b003:l001","ordinal":109755,"en":"Raiding and causing strife—"},{"id":"semetey-1-2013:p0432:b003:l002","ordinal":109756,"en":"Such was Ezkara's campaign."},{"id":"semetey-1-2013:p0432:b003:l003","ordinal":109757,"en":"The massed Chinese, the emperor's people,"},{"id":"semetey-1-2013:p0432:b003:l004","ordinal":109758,"en":"Stood defiant and raised strife again."},{"id":"semetey-1-2013:p0432:b003:l005","ordinal":109759,"en":"The most skillful spearmen,"},{"id":"semetey-1-2013:p0432:b003:l006","ordinal":109760,"en":"The finest battle-axe wielders,"},{"id":"semetey-1-2013:p0432:b003:l007","ordinal":109761,"en":"The nimble, crafty, formidable men,"},{"id":"semetey-1-2013:p0432:b003:l008","ordinal":109762,"en":"The captains of ten and a thousand—"},{"id":"semetey-1-2013:p0432:b003:l009","ordinal":109763,"en":"The captains of ten bobbed in their saddles,"},{"id":"semetey-1-2013:p0432:b003:l010","ordinal":109764,"en":"Their spears jutting out."},{"id":"semetey-1-2013:p0432:b003:l011","ordinal":109765,"en":"The captain of a thousand grew excited;"},{"id":"semetey-1-2013:p0432:b003:l012","ordinal":109766,"en":"Captains of fifty and ten"},{"id":"semetey-1-2013:p0432:b003:l013","ordinal":109767,"en":"Raged beyond all reckoning."},{"id":"semetey-1-2013:p0432:b003:l014","ordinal":109768,"en":"They fired bullets like rain,"},{"id":"semetey-1-2013:p0432:b003:l015","ordinal":109769,"en":"And shot arrows like hail."},{"id":"semetey-1-2013:p0432:b003:l016","ordinal":109770,"en":"Look at the darkly burning embers,"},{"id":"semetey-1-2013:p0432:b003:l017","ordinal":109771,"en":"Coming straight at your khan father;"},{"id":"semetey-1-2013:p0432:b003:l018","ordinal":109772,"en":"Look at the bullets swarming over him."},{"id":"semetey-1-2013:p0432:b003:l019","ordinal":109773,"en":"Look at the hail, look at the embers,"},{"id":"semetey-1-2013:p0432:b003:l020","ordinal":109774,"en":"Look at the bullets striking separately."},{"id":"semetey-1-2013:p0432:b003:l021","ordinal":109775,"en":"Look at the trench they had dug,"},{"id":"semetey-1-2013:p0432:b003:l023","ordinal":109776,"en":"The massed Chinese and countless Torgut—","gapBefore":"[Source wording unresolved; translation pending]"},{"id":"semetey-1-2013:p0432:b003:l024","ordinal":109777,"en":"Look at the troops swarming over him."},{"id":"semetey-1-2013:p0432:b003:l025","ordinal":109778,"en":"Not sparing his own life,"},{"id":"semetey-1-2013:p0432:b003:l026","ordinal":109779,"en":"Kongurbay charged in fiercely."},{"id":"semetey-1-2013:p0432:b003:l027","ordinal":109780,"en":"Look at that great, renowned Kalcha."},{"id":"semetey-1-2013:p0432:b003:l028","ordinal":109781,"en":"His wrestlers, Yyby and Shyyky,"},{"id":"semetey-1-2013:p0432:b003:l029","ordinal":109782,"en":"Cast lassos at him from the side."},{"id":"semetey-1-2013:p0432:b003:l030","ordinal":109783,"en":"Ezkara, khan of the Manchus,"},{"id":"semetey-1-2013:p0432:b003:l031","ordinal":109784,"en":"Also shouted and thrust his spear."},{"id":"semetey-1-2013:p0432:b003:l032","ordinal":109785,"en":"Although many spears cut at once,"},{"id":"semetey-1-2013:p0432:b003:l033","ordinal":109786,"en":"Your father, blessed by Kyzyr,"},{"id":"semetey-1-2013:p0432:b003:l034","ordinal":109787,"en":"Stood looking on without flinching!"},{"id":"semetey-1-2013:p0432:b003:l035","ordinal":109788,"en":"Fortune favored him in everything."},{"id":"semetey-1-2013:p0432:b003:l036","ordinal":109789,"en":"If you looked within him,"},{"id":"semetey-1-2013:p0432:b003:l037","ordinal":109790,"en":"He was broader than the earth."},{"id":"semetey-1-2013:p0432:b003:l038","ordinal":109791,"en":"When it came to the Muslims,"},{"id":"semetey-1-2013:p0432:b003:l039","ordinal":109792,"en":"He was an unbreakable iron fortress,"},{"id":"semetey-1-2013:p0432:b004:l001","ordinal":109793,"en":"A lion of surpassing fortune."},{"id":"semetey-1-2013:p0432:b004:l002","ordinal":109794,"en":"A soul like your father—the one God"},{"id":"semetey-1-2013:p0432:b004:l003","ordinal":109795,"en":"Would never create, my orphan!"},{"id":"semetey-1-2013:p0432:b004:l004","ordinal":109796,"en":"When the Chinese pressed hard,"},{"id":"semetey-1-2013:p0432:b004:l005","ordinal":109797,"en":"When the shouting Chinese and many Manchus"},{"id":"semetey-1-2013:p0432:b004:l006","ordinal":109798,"en":"Your father, blessed by Kyzyr,"},{"id":"semetey-1-2013:p0432:b004:l007","ordinal":109799,"en":"Had surrounded,"},{"id":"semetey-1-2013:p0432:b004:l008","ordinal":109800,"en":"The massed Chinese stood defiant"},{"id":"semetey-1-2013:p0432:b004:l009","ordinal":109801,"en":"And swarmed in, clamoring."},{"id":"semetey-1-2013:p0432:b004:l010","ordinal":109802,"en":"When your father turned to look—"},{"id":"semetey-1-2013:p0432:b004:l011","ordinal":109803,"en":"Did you see what a lion he was?—"},{"id":"semetey-1-2013:p0432:b004:l012","ordinal":109804,"en":"The massed Chinese and many Manchus"},{"id":"semetey-1-2013:p0432:b004:l013","ordinal":109805,"en":"Fled away, clamoring."},{"id":"semetey-1-2013:p0432:b004:l014","ordinal":109806,"en":"When the Chinese advanced,"},{"id":"semetey-1-2013:p0432:b004:l015","ordinal":109807,"en":"When they attacked your father,"},{"id":"semetey-1-2013:p0432:b004:l016","ordinal":109808,"en":"Many a swift winged steed"},{"id":"semetey-1-2013:p0432:b004:l017","ordinal":109809,"en":"Had its saddle under its belly;"},{"id":"semetey-1-2013:p0432:b004:l018","ordinal":109810,"en":"Even more ran about, refusing capture."},{"id":"semetey-1-2013:p0432:b004:l019","ordinal":109811,"en":"Whimpering in Chinese,"},{"id":"semetey-1-2013:p0432:b004:l020","ordinal":109812,"en":"Chattering in Kalmyk,"},{"id":"semetey-1-2013:p0432:b004:l021","ordinal":109813,"en":"Fleeing, hurrying across the fields,"},{"id":"semetey-1-2013:p0432:b004:l022","ordinal":109814,"en":"Still more were coming to a halt."},{"id":"semetey-1-2013:p0432:b004:l023","ordinal":109815,"en":"'My precious, dear kinsman"},{"id":"semetey-1-2013:p0432:b004:l024","ordinal":109816,"en":"Died in such-and-such a place,' they said;"},{"id":"semetey-1-2013:p0432:b004:l025","ordinal":109817,"en":"Still more went about lamenting."},{"id":"semetey-1-2013:p0432:b004:l026","ordinal":109818,"en":"Separated from one another,"},{"id":"semetey-1-2013:p0432:b004:l027","ordinal":109819,"en":"Still more stood looking about."},{"id":"semetey-1-2013:p0432:b004:l028","ordinal":109820,"en":"Putting on a false show of courage,"},{"id":"semetey-1-2013:p0432:b004:l029","ordinal":109821,"en":"They blocked one another's way back"},{"id":"semetey-1-2013:p0432:b004:l030","ordinal":109822,"en":"And beat one another, many more."},{"id":"semetey-1-2013:p0432:b004:l031","ordinal":109823,"en":"Saying Khan Manas would slaughter them,"},{"id":"semetey-1-2013:p0432:b004:l032","ordinal":109824,"en":"They fled in terror, one by one;"}]
