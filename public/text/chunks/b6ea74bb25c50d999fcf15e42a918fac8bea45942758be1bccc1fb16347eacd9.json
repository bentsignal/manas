[{"id":"semetey-1-2013:p1175:b004:l022","ordinal":165889,"en":"If the prize is lost,"},{"id":"semetey-1-2013:p1175:b004:l023","ordinal":165890,"en":"Do not live on—die there."},{"id":"semetey-1-2013:p1175:b004:l024","ordinal":165891,"en":"If you are a champion, Agysh,"},{"id":"semetey-1-2013:p1175:b004:l025","ordinal":165892,"en":"Tear apart the ribs"},{"id":"semetey-1-2013:p1175:b004:l026","ordinal":165893,"en":"Of an infidel like Tükübai."},{"id":"semetey-1-2013:p1175:b004:l027","ordinal":165894,"en":"If you heed me, know that"},{"id":"semetey-1-2013:p1175:b004:l028","ordinal":165895,"en":"I myself have come to you, brave Agysh."},{"id":"semetey-1-2013:p1175:b004:l029","ordinal":165896,"en":"To put you into the wrestling,"},{"id":"semetey-1-2013:p1175:b004:l030","ordinal":165897,"en":"Your time has come, brave Agysh."},{"id":"semetey-1-2013:p1175:b004:l031","ordinal":165898,"en":"Go grapple fiercely"},{"id":"semetey-1-2013:p1175:b004:l032","ordinal":165899,"en":"With that swaggering swine;"},{"id":"semetey-1-2013:p1175:b004:l033","ordinal":165900,"en":"From the hulking, mountain-like infidel,"},{"id":"semetey-1-2013:p1175:b004:l034","ordinal":165901,"en":"Win us one prize.”"},{"id":"semetey-1-2013:p1175:b004:l035","ordinal":165902,"en":"Kyrgylchal, leader of the Forty,"},{"id":"semetey-1-2013:p1175:b004:l036","ordinal":165903,"en":"With the twelve choros at his head,"},{"id":"semetey-1-2013:p1175:b004:l037","ordinal":165904,"en":"Selected Agysh"},{"id":"semetey-1-2013:p1175:b004:l038","ordinal":165905,"en":"And drove him to the place"},{"id":"semetey-1-2013:p1175:b004:l039","ordinal":165906,"en":"Where all the people had gathered."},{"id":"semetey-1-2013:p1176:b003:l001","ordinal":165907,"en":"To Khan Manas’s encampment"},{"id":"semetey-1-2013:p1176:b003:l002","ordinal":165908,"en":"Dear Agysh came."},{"id":"semetey-1-2013:p1176:b003:l003","ordinal":165909,"en":"They dressed him in badana armor;"},{"id":"semetey-1-2013:p1176:b003:l004","ordinal":165910,"en":"Badana was the name of the trousers."},{"id":"semetey-1-2013:p1176:b003:l005","ordinal":165911,"en":"They made him run up and down;"},{"id":"semetey-1-2013:p1176:b003:l006","ordinal":165912,"en":"Those badana trousers were exceptional,"},{"id":"semetey-1-2013:p1176:b003:l007","ordinal":165913,"en":"Fashioned to fit him"},{"id":"semetey-1-2013:p1176:b003:l008","ordinal":165914,"en":"By your poor, fair sister-in-law."},{"id":"semetey-1-2013:p1176:b003:l009","ordinal":165915,"en":"Silk within and cotton cloth without,"},{"id":"semetey-1-2013:p1176:b003:l010","ordinal":165916,"en":"Double-layered badana with lark-eye links:"},{"id":"semetey-1-2013:p1176:b003:l011","ordinal":165917,"en":"Fire would not pass through if tinder burned,"},{"id":"semetey-1-2013:p1176:b003:l012","ordinal":165918,"en":"Nor a bullet if a musket fired."},{"id":"semetey-1-2013:p1176:b003:l013","ordinal":165919,"en":"Now was the time to wear them."},{"id":"semetey-1-2013:p1176:b003:l014","ordinal":165920,"en":"They were half a kez thick."},{"id":"semetey-1-2013:p1176:b003:l015","ordinal":165921,"en":"From a treasury saddlebag,"},{"id":"semetey-1-2013:p1176:b003:l016","ordinal":165922,"en":"The unfortunate khan’s wife"},{"id":"semetey-1-2013:p1176:b003:l017","ordinal":165923,"en":"Displayed her careful provision;"},{"id":"semetey-1-2013:p1176:b003:l018","ordinal":165924,"en":"Upon Agysh, as was fitting,"},{"id":"semetey-1-2013:p1176:b003:l019","ordinal":165925,"en":"She put the badana armor."},{"id":"semetey-1-2013:p1176:b003:l020","ordinal":165926,"en":"When they saw her provision,"},{"id":"semetey-1-2013:p1176:b003:l021","ordinal":165927,"en":"Infidel and Muslim,"},{"id":"semetey-1-2013:p1176:b003:l022","ordinal":165928,"en":"All the assembled people,"},{"id":"semetey-1-2013:p1176:b003:l023","ordinal":165929,"en":"And khans as huge as mountains,"},{"id":"semetey-1-2013:p1176:b003:l024","ordinal":165930,"en":"Said, “She is truly a lord’s wife,”"},{"id":"semetey-1-2013:p1176:b003:l025","ordinal":165931,"en":"And every khan was pleased."},{"id":"semetey-1-2013:p1176:b003:l026","ordinal":165932,"en":"Her chest held riches beyond count;"},{"id":"semetey-1-2013:p1176:b003:l027","ordinal":165933,"en":"Kanysh, wife of Manas,"},{"id":"semetey-1-2013:p1176:b003:l028","ordinal":165934,"en":"Had everything one could name."},{"id":"semetey-1-2013:p1176:b003:l029","ordinal":165935,"en":"Against the mountain-sized champion,"},{"id":"semetey-1-2013:p1176:b003:l030","ordinal":165936,"en":"Elbow-sized brave Agysh,"},{"id":"semetey-1-2013:p1176:b003:l031","ordinal":165937,"en":"All sinew from head to foot,"},{"id":"semetey-1-2013:p1176:b003:l032","ordinal":165938,"en":"Stepped forward then,"},{"id":"semetey-1-2013:p1176:b003:l033","ordinal":165939,"en":"Going to wrestle him."},{"id":"semetey-1-2013:p1176:b003:l034","ordinal":165940,"en":"The giants Koshoi and Töshtük"},{"id":"semetey-1-2013:p1176:b003:l035","ordinal":165941,"en":"Raised their hands and cried out;"},{"id":"semetey-1-2013:p1176:b003:l036","ordinal":165942,"en":"All of them gave their blessing,"},{"id":"semetey-1-2013:p1176:b003:l037","ordinal":165943,"en":"Including old hero Koshoi."},{"id":"semetey-1-2013:p1176:b003:l038","ordinal":165944,"en":"Brave Agysh stepped forward"},{"id":"semetey-1-2013:p1176:b003:l039","ordinal":165945,"en":"And spoke these words to Manas:"},{"id":"semetey-1-2013:p1176:b004:l001","ordinal":165946,"en":"“Against that swaggering swine,"},{"id":"semetey-1-2013:p1176:b004:l002","ordinal":165947,"en":"I will grapple and wrestle fiercely,"},{"id":"semetey-1-2013:p1176:b004:l003","ordinal":165948,"en":"Tearing at whoever stands before me,"},{"id":"semetey-1-2013:p1176:b004:l004","ordinal":165949,"en":"Butting like a blue bull;"},{"id":"semetey-1-2013:p1176:b004:l005","ordinal":165950,"en":"I will wrestle him openly."},{"id":"semetey-1-2013:p1176:b004:l006","ordinal":165951,"en":"Take the black-jawed rawhide whip,"},{"id":"semetey-1-2013:p1176:b004:l007","ordinal":165952,"en":"Grasp it and swing it:"},{"id":"semetey-1-2013:p1176:b004:l008","ordinal":165953,"en":"‘Lift him, Agysh, lift him!’"},{"id":"semetey-1-2013:p1176:b004:l009","ordinal":165954,"en":"‘Take him, Agysh, take him!’"},{"id":"semetey-1-2013:p1176:b004:l010","ordinal":165955,"en":"Across the fish-like flesh of my fat rump,"},{"id":"semetey-1-2013:p1176:b004:l011","ordinal":165956,"en":"Strike and split it open;"},{"id":"semetey-1-2013:p1176:b004:l012","ordinal":165957,"en":"Let my flesh sting,"},{"id":"semetey-1-2013:p1176:b004:l013","ordinal":165958,"en":"Let my blood scatter."},{"id":"semetey-1-2013:p1176:b004:l014","ordinal":165959,"en":"From that swine who plays the hero,"},{"id":"semetey-1-2013:p1176:b004:l015","ordinal":165960,"en":"I will seize him by the shins."},{"id":"semetey-1-2013:p1176:b004:l016","ordinal":165961,"en":"Jerking him up and down,"},{"id":"semetey-1-2013:p1176:b004:l017","ordinal":165962,"en":"I will use my ancient strength."},{"id":"semetey-1-2013:p1176:b004:l018","ordinal":165963,"en":"If you do not strike, it brings shame;"},{"id":"semetey-1-2013:p1176:b004:l019","ordinal":165964,"en":"Your blow is entrusted to us."},{"id":"semetey-1-2013:p1176:b004:l020","ordinal":165965,"en":"When anger rises, I will prevail;"},{"id":"semetey-1-2013:p1176:b004:l021","ordinal":165966,"en":"If my anger does not rise,"},{"id":"semetey-1-2013:p1176:b004:l022","ordinal":165967,"en":"I may merely keep laughing."},{"id":"semetey-1-2013:p1176:b004:l023","ordinal":165968,"en":"When I see your fierce wrath,"},{"id":"semetey-1-2013:p1176:b004:l024","ordinal":165969,"en":"Then I will put forth my strength.”"},{"id":"semetey-1-2013:p1176:b004:l025","ordinal":165970,"en":"Having said this,"},{"id":"semetey-1-2013:p1176:b004:l026","ordinal":165971,"en":"Agysh strode toward the champion,"},{"id":"semetey-1-2013:p1176:b004:l027","ordinal":165972,"en":"Going to wrestle him."},{"id":"semetey-1-2013:p1176:b004:l028","ordinal":165973,"en":"Tükübai of the Kalmyks"},{"id":"semetey-1-2013:p1176:b004:l029","ordinal":165974,"en":"Never released a man he grappled;"},{"id":"semetey-1-2013:p1176:b004:l030","ordinal":165975,"en":"From the flesh of a single swine,"},{"id":"semetey-1-2013:p1176:b004:l031","ordinal":165976,"en":"One meal could not fill him."},{"id":"semetey-1-2013:p1176:b004:l032","ordinal":165977,"en":"Who has seen a hero like this?"},{"id":"semetey-1-2013:p1176:b004:l033","ordinal":165978,"en":"He braced himself and charged."},{"id":"semetey-1-2013:p1176:b004:l034","ordinal":165979,"en":"If Agysh fell into his hands,"},{"id":"semetey-1-2013:p1176:b004:l035","ordinal":165980,"en":"He looked ready to mow him down."},{"id":"semetey-1-2013:p1176:b004:l036","ordinal":165981,"en":"Without even stirring from his place,"},{"id":"semetey-1-2013:p1176:b004:l037","ordinal":165982,"en":"He looked ready to suck him in whole."},{"id":"semetey-1-2013:p1176:b004:l038","ordinal":165983,"en":"The great Hairy-Sole champion"},{"id":"semetey-1-2013:p1176:b004:l039","ordinal":165984,"en":"Charged and reached him."},{"id":"semetey-1-2013:p1177:b003:l001","ordinal":165985,"en":"When he saw him charge,"},{"id":"semetey-1-2013:p1177:b003:l002","ordinal":165986,"en":"What could dear Agysh do?"},{"id":"semetey-1-2013:p1177:b003:l003","ordinal":165987,"en":"He stood and awaited his turn."},{"id":"semetey-1-2013:p1177:b003:l004","ordinal":165988,"en":"When Tükübai reached him,"},{"id":"semetey-1-2013:p1177:b003:l005","ordinal":165989,"en":"Brave Agysh held out his forearm."},{"id":"semetey-1-2013:p1177:b003:l006","ordinal":165990,"en":"They seized each other’s arms;"},{"id":"semetey-1-2013:p1177:b003:l007","ordinal":165991,"en":"Before either could call for a blow,"},{"id":"semetey-1-2013:p1177:b003:l008","ordinal":165992,"en":"The heroes wrenched their arms free."},{"id":"semetey-1-2013:p1177:b003:l009","ordinal":165993,"en":"They heaved and strained,"},{"id":"semetey-1-2013:p1177:b003:l010","ordinal":165994,"en":"Tugging and jerking,"},{"id":"semetey-1-2013:p1177:b003:l011","ordinal":165995,"en":"Grappling at the appointed ground,"},{"id":"semetey-1-2013:p1177:b003:l012","ordinal":165996,"en":"Facing and tripping each other."},{"id":"semetey-1-2013:p1177:b003:l013","ordinal":165997,"en":"They opened their mouths like caverns,"},{"id":"semetey-1-2013:p1177:b003:l014","ordinal":165998,"en":"Shouting as they pressed toward the earth."},{"id":"semetey-1-2013:p1177:b003:l015","ordinal":165999,"en":"The strong men twisted each other’s necks"},{"id":"semetey-1-2013:p1177:b003:l016","ordinal":166000,"en":"And tore at every point of leverage."},{"id":"semetey-1-2013:p1177:b003:l017","ordinal":166001,"en":"Infidel and Muslim alike"},{"id":"semetey-1-2013:p1177:b003:l018","ordinal":166002,"en":"Crowded round and watched,"},{"id":"semetey-1-2013:p1177:b003:l019","ordinal":166003,"en":"As the champions strained."},{"id":"semetey-1-2013:p1177:b003:l020","ordinal":166004,"en":"Everyone who saw it marveled."},{"id":"semetey-1-2013:p1177:b003:l021","ordinal":166005,"en":"They grappled day and night,"},{"id":"semetey-1-2013:p1177:b003:l022","ordinal":166006,"en":"Until two days were complete."},{"id":"semetey-1-2013:p1177:b003:l023","ordinal":166007,"en":"The assembled people watched their struggle"},{"id":"semetey-1-2013:p1177:b003:l024","ordinal":166008,"en":"And knew what was happening—do you see?"},{"id":"semetey-1-2013:p1177:b003:l025","ordinal":166009,"en":"As though he were watching a brother-in-law,"},{"id":"semetey-1-2013:p1177:b003:l026","ordinal":166010,"en":"Agysh burst out laughing then;"},{"id":"semetey-1-2013:p1177:b003:l027","ordinal":166011,"en":"He went on laughing—do you see?"},{"id":"semetey-1-2013:p1177:b003:l028","ordinal":166012,"en":"The youngest of the twelve lions,"},{"id":"semetey-1-2013:p1177:b003:l029","ordinal":166013,"en":"A servant beloved by God,"},{"id":"semetey-1-2013:p1177:b003:l030","ordinal":166014,"en":"The dark gray-maned snow leopard Manas,"},{"id":"semetey-1-2013:p1177:b003:l031","ordinal":166015,"en":"At Agysh’s laughter"},{"id":"semetey-1-2013:p1177:b003:l032","ordinal":166016,"en":"Was seized by anger."},{"id":"semetey-1-2013:p1177:b003:l033","ordinal":166017,"en":"His bloodlust gripped him hard;"},{"id":"semetey-1-2013:p1177:b003:l034","ordinal":166018,"en":"His eyes truly blazed like fire."},{"id":"semetey-1-2013:p1177:b003:l035","ordinal":166019,"en":"His broad front teeth were like a gate,"},{"id":"semetey-1-2013:p1177:b003:l036","ordinal":166020,"en":"Teeth unlike those of ordinary folk,"},{"id":"semetey-1-2013:p1177:b003:l037","ordinal":166021,"en":"And they flashed white as he bared them."},{"id":"semetey-1-2013:p1177:b003:l038","ordinal":166022,"en":"Still swollen with rage, toward Agysh"},{"id":"semetey-1-2013:p1177:b003:l039","ordinal":166023,"en":"The snow leopard rushed."},{"id":"semetey-1-2013:p1177:b005:l001","ordinal":166024,"en":"“Lift him, Agysh—take him!"},{"id":"semetey-1-2013:p1177:b005:l002","ordinal":166025,"en":"This Kalmyk fit for burial,"},{"id":"semetey-1-2013:p1177:b005:l003","ordinal":166026,"en":"Lay him upon the black earth!”"},{"id":"semetey-1-2013:p1177:b005:l004","ordinal":166027,"en":"Snow-leopard Manas roared."},{"id":"semetey-1-2013:p1177:b005:l005","ordinal":166028,"en":"The black-jawed rawhide whip"},{"id":"semetey-1-2013:p1177:b005:l006","ordinal":166029,"en":"He seized and swung."},{"id":"semetey-1-2013:p1177:b005:l007","ordinal":166030,"en":"Charging in then,"},{"id":"semetey-1-2013:p1177:b005:l008","ordinal":166031,"en":"At elbow-sized Agysh"},{"id":"semetey-1-2013:p1177:b005:l009","ordinal":166032,"en":"He lashed across the ankle."},{"id":"semetey-1-2013:p1177:b005:l010","ordinal":166033,"en":"His ankle flared with pain,"},{"id":"semetey-1-2013:p1177:b005:l011","ordinal":166034,"en":"And now his anger reached its height."},{"id":"semetey-1-2013:p1177:b005:l012","ordinal":166035,"en":"Tükübai heaved like a mountain,"},{"id":"semetey-1-2013:p1177:b005:l013","ordinal":166036,"en":"But his maneuver went badly."},{"id":"semetey-1-2013:p1177:b005:l014","ordinal":166037,"en":"By both his lower legs,"},{"id":"semetey-1-2013:p1177:b005:l015","ordinal":166038,"en":"Brave Agysh, a true hero,"},{"id":"semetey-1-2013:p1177:b005:l016","ordinal":166039,"en":"Bent down and seized him."},{"id":"semetey-1-2013:p1177:b005:l017","ordinal":166040,"en":"Giving the infidel no time to breathe,"},{"id":"semetey-1-2013:p1177:b005:l018","ordinal":166041,"en":"He tore him from the ground."},{"id":"semetey-1-2013:p1177:b005:l019","ordinal":166042,"en":"He made the infidel stagger,"},{"id":"semetey-1-2013:p1177:b005:l020","ordinal":166043,"en":"And whirled the champion around."},{"id":"semetey-1-2013:p1177:b005:l021","ordinal":166044,"en":"Hairy-Sole Tükübai—"},{"id":"semetey-1-2013:p1177:b005:l022","ordinal":166045,"en":"Hair sprouted from both his cheeks,"},{"id":"semetey-1-2013:p1177:b005:l023","ordinal":166046,"en":"And a groan came from beneath his hem."},{"id":"semetey-1-2013:p1177:b005:l024","ordinal":166047,"en":"Tükübai’s arms were pinned;"},{"id":"semetey-1-2013:p1177:b005:l025","ordinal":166048,"en":"Above brave Agysh’s head"},{"id":"semetey-1-2013:p1177:b005:l026","ordinal":166049,"en":"He spun like a blue-backed colt."},{"id":"semetey-1-2013:p1177:b005:l027","ordinal":166050,"en":"His plight had turned dire."},{"id":"semetey-1-2013:p1177:b005:l028","ordinal":166051,"en":"A black rock as large as a yurt—"},{"id":"semetey-1-2013:p1177:b005:l029","ordinal":166052,"en":"Skillful Agysh reached it."},{"id":"semetey-1-2013:p1177:b005:l030","ordinal":166053,"en":"A black rock as large as a house:"},{"id":"semetey-1-2013:p1177:b005:l031","ordinal":166054,"en":"The mountain-sized champion"},{"id":"semetey-1-2013:p1177:b005:l032","ordinal":166055,"en":"He dashed upon that stone."},{"id":"semetey-1-2013:p1177:b005:l033","ordinal":166056,"en":"The prowess of brave Agysh,"},{"id":"semetey-1-2013:p1177:b005:l034","ordinal":166057,"en":"The gray-maned wolf, was revealed."},{"id":"semetey-1-2013:p1177:b005:l035","ordinal":166058,"en":"The great champion Tükübai"},{"id":"semetey-1-2013:p1177:b005:l036","ordinal":166059,"en":"Was split into two pieces."},{"id":"semetey-1-2013:p1177:b005:l037","ordinal":166060,"en":"The prowess of elbow-sized Agysh"},{"id":"semetey-1-2013:p1177:b005:l038","ordinal":166061,"en":"Was revealed to all."},{"id":"semetey-1-2013:p1178:b003:l001","ordinal":166062,"en":"“Agysh has thrown the Kalmyk!” they cried."},{"id":"semetey-1-2013:p1178:b003:l002","ordinal":166063,"en":"With bloodthirsty Manas at their head,"},{"id":"semetey-1-2013:p1178:b003:l003","ordinal":166064,"en":"There were a thousand black camels,"},{"id":"semetey-1-2013:p1178:b003:l004","ordinal":166065,"en":"And a thousand black-blazed mares."},{"id":"semetey-1-2013:p1178:b003:l005","ordinal":166066,"en":"“Take them—here is your prize!”"},{"id":"semetey-1-2013:p1178:b003:l006","ordinal":166067,"en":"They drove the herd up to him."},{"id":"semetey-1-2013:p1178:b003:l007","ordinal":166068,"en":"Without accepting that prize,"},{"id":"semetey-1-2013:p1178:b003:l008","ordinal":166069,"en":"Brave Agysh hurried about."},{"id":"semetey-1-2013:p1178:b003:l009","ordinal":166070,"en":"Then Agysh spoke,"},{"id":"semetey-1-2013:p1178:b003:l010","ordinal":166071,"en":"Uttering outrageous words no man would say:"},{"id":"semetey-1-2013:p1178:b003:l011","ordinal":166072,"en":"“I threw your champion; my hands are free."},{"id":"semetey-1-2013:p1178:b003:l012","ordinal":166073,"en":"Release my hand, Manas,"},{"id":"semetey-1-2013:p1178:b003:l013","ordinal":166074,"en":"And show before my eyes"},{"id":"semetey-1-2013:p1178:b003:l014","ordinal":166075,"en":"The marvel I saw earlier."},{"id":"semetey-1-2013:p1178:b003:l015","ordinal":166076,"en":"I will not turn aside for these beasts;"},{"id":"semetey-1-2013:p1178:b003:l016","ordinal":166077,"en":"I will not miss the entertainment."},{"id":"semetey-1-2013:p1178:b003:l017","ordinal":166078,"en":"I will not take this prize;"},{"id":"semetey-1-2013:p1178:b003:l018","ordinal":166079,"en":"I will not leave my maidens."},{"id":"semetey-1-2013:p1178:b003:l019","ordinal":166080,"en":"I will not turn aside for this prize;"},{"id":"semetey-1-2013:p1178:b003:l020","ordinal":166081,"en":"I will not part from the young brides."},{"id":"semetey-1-2013:p1178:b003:l021","ordinal":166082,"en":"I will not accept this prize."},{"id":"semetey-1-2013:p1178:b003:l022","ordinal":166083,"en":"For the exciting games and revelry,"},{"id":"semetey-1-2013:p1178:b004:l001","ordinal":166084,"en":"I will not surrender my girls.”"},{"id":"semetey-1-2013:p1178:b004:l002","ordinal":166085,"en":"Brave Agysh rushed away,"},{"id":"semetey-1-2013:p1178:b004:l003","ordinal":166086,"en":"Running toward the girls;"},{"id":"semetey-1-2013:p1178:b004:l004","ordinal":166087,"en":"Brave Agysh fled off."},{"id":"semetey-1-2013:p1178:b004:l005","ordinal":166088,"en":"Agysh did not take the prize."},{"id":"semetey-1-2013:p1178:b004:l006","ordinal":166089,"en":"The Muslims divided among themselves"},{"id":"semetey-1-2013:p1178:b004:l007","ordinal":166090,"en":"The prize belonging to brave Agysh."},{"id":"semetey-1-2013:p1178:b004:l008","ordinal":166091,"en":"They had seen the unruly gray-maned hero"},{"id":"semetey-1-2013:p1178:b004:l009","ordinal":166092,"en":"Prove himself a true warrior;"},{"id":"semetey-1-2013:p1178:b004:l010","ordinal":166093,"en":"Honoring the forefathers, the Muslim people"},{"id":"semetey-1-2013:p1178:b004:l011","ordinal":166094,"en":"Divided up the prize."},{"id":"semetey-1-2013:p1178:b004:l012","ordinal":166095,"en":"After the prize had been taken and settled,"},{"id":"semetey-1-2013:p1178:b004:l013","ordinal":166096,"en":"When the Muslim faithful stood assembled,"},{"id":"semetey-1-2013:p1178:b004:l014","ordinal":166097,"en":"Akun Khan, khan of Afghanistan,"},{"id":"semetey-1-2013:p1178:b004:l015","ordinal":166098,"en":"Spoke at length of his solemn pledge"},{"id":"semetey-1-2013:p1178:b004:l016","ordinal":166099,"en":"To the hero, bloodthirsty Manas:"},{"id":"semetey-1-2013:p1178:b004:l017","ordinal":166100,"en":"“Hear the end of my words, Khoja;"},{"id":"semetey-1-2013:p1178:b004:l018","ordinal":166101,"en":"Yet my words are not exhausted."},{"id":"semetey-1-2013:p1178:b004:l019","ordinal":166102,"en":"At Khan Kökötöy’s funeral feast,"},{"id":"semetey-1-2013:p1178:b004:l020","ordinal":166103,"en":"Before the great assembly,"},{"id":"semetey-1-2013:p1178:b004:l021","ordinal":166104,"en":"Bloodthirsty Manas and Akun"},{"id":"semetey-1-2013:p1178:b004:l022","ordinal":166105,"en":"Once became pledged in betrothal."},{"id":"semetey-1-2013:p1178:b006:l001","ordinal":166106,"en":"Akun rose and said this:"},{"id":"semetey-1-2013:p1178:b006:l002","ordinal":166107,"en":"“A star moved in the heavens;"},{"id":"semetey-1-2013:p1178:b006:l003","ordinal":166108,"en":"Manas and Akun Khan"},{"id":"semetey-1-2013:p1178:b006:l004","ordinal":166109,"en":"Became friends until the next world."},{"id":"semetey-1-2013:p1178:b006:l005","ordinal":166110,"en":"You gave Koshoy, khan of Katagan,"},{"id":"semetey-1-2013:p1178:b006:l006","ordinal":166111,"en":"A pair of leather wrestling breeches,"},{"id":"semetey-1-2013:p1178:b006:l007","ordinal":166112,"en":"And truly received the blessing"},{"id":"semetey-1-2013:p1178:b006:l008","ordinal":166113,"en":"Of Koshoy, father of the people."},{"id":"semetey-1-2013:p1178:b006:l009","ordinal":166114,"en":"Now, snow-leopard Manas,"},{"id":"semetey-1-2013:p1178:b006:l010","ordinal":166115,"en":"You have been granted a child."},{"id":"semetey-1-2013:p1178:b006:l011","ordinal":166116,"en":"During the summer just past,"},{"id":"semetey-1-2013:p1178:b006:l012","ordinal":166117,"en":"When the people moved toward the highlands,"},{"id":"semetey-1-2013:p1178:b007:l001","ordinal":166118,"en":"In the season when horses’ coats turn dark,"},{"id":"semetey-1-2013:p1178:b007:l002","ordinal":166119,"en":"At Belendi’s Pass,"},{"id":"semetey-1-2013:p1178:b007:l003","ordinal":166120,"en":"Watching argali and chasing gazelles,"},{"id":"semetey-1-2013:p1178:b007:l004","ordinal":166121,"en":"At the place where I hunted game,"},{"id":"semetey-1-2013:p1178:b007:l005","ordinal":166122,"en":"Upon the ridge of Belesche,"},{"id":"semetey-1-2013:p1178:b007:l006","ordinal":166123,"en":"Where the wolf cubs played,"},{"id":"semetey-1-2013:p1178:b007:l007","ordinal":166124,"en":"As I rode toward a certain place,"},{"id":"semetey-1-2013:p1178:b007:l008","ordinal":166125,"en":"A whirlwind was dancing there."},{"id":"semetey-1-2013:p1178:b007:l009","ordinal":166126,"en":"On the slope of Uluu-Too,"},{"id":"semetey-1-2013:p1178:b007:l010","ordinal":166127,"en":"A gathering seemed to be celebrating."},{"id":"semetey-1-2013:p1178:b007:l011","ordinal":166128,"en":"When I rode up and looked,"},{"id":"semetey-1-2013:p1178:b007:l012","ordinal":166129,"en":"Wrapped in a piece of felt,"},{"id":"semetey-1-2013:p1179:b003:l001","ordinal":166130,"en":"A baby lay there."},{"id":"semetey-1-2013:p1179:b003:l002","ordinal":166131,"en":"When I asked, ‘Is it a boy?’ it was a girl,"},{"id":"semetey-1-2013:p1179:b003:l003","ordinal":166132,"en":"The finest among womankind,"},{"id":"semetey-1-2013:p1179:b003:l004","ordinal":166133,"en":"One born of heroes."},{"id":"semetey-1-2013:p1179:b003:l005","ordinal":166134,"en":"‘She is a daughter of the wolf,’"},{"id":"semetey-1-2013:p1179:b003:l006","ordinal":166135,"en":"Was what the heroes said;"},{"id":"semetey-1-2013:p1179:b003:l007","ordinal":166136,"en":"And that was exactly what she was."},{"id":"semetey-1-2013:p1179:b003:l008","ordinal":166137,"en":"Every thought came into my mind:"},{"id":"semetey-1-2013:p1179:b003:l009","ordinal":166138,"en":"Before she should go away to a husband,"},{"id":"semetey-1-2013:p1179:b003:l010","ordinal":166139,"en":"I wished to share in her joys."},{"id":"semetey-1-2013:p1179:b003:l011","ordinal":166140,"en":"Manas was my friend until Judgment Day;"},{"id":"semetey-1-2013:p1179:b003:l012","ordinal":166141,"en":"If Manas should have a son,"},{"id":"semetey-1-2013:p1179:b003:l013","ordinal":166142,"en":"I wished to give her as his bride."},{"id":"semetey-1-2013:p1179:b003:l014","ordinal":166143,"en":"This is the matter I have to tell."},{"id":"semetey-1-2013:p1179:b003:l015","ordinal":166144,"en":"Before God Most High, for the only child,"}]
