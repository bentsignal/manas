[{"id":"semetey-1-2013:p1132:b003:l019","ordinal":162561,"en":"Along the banks of Karkyra,"},{"id":"semetey-1-2013:p1132:b003:l020","ordinal":162562,"en":"At Khan Kökötöy's feast,"},{"id":"semetey-1-2013:p1132:b003:l021","ordinal":162563,"en":"Below Aygyr-Zhal,"},{"id":"semetey-1-2013:p1132:b003:l022","ordinal":162564,"en":"In the hollow of Ükürchü,"},{"id":"semetey-1-2013:p1132:b003:l023","ordinal":162565,"en":"Along Üch-Kapkak,"},{"id":"semetey-1-2013:p1132:b003:l024","ordinal":162566,"en":"Before the assembled people,"},{"id":"semetey-1-2013:p1132:b003:l025","ordinal":162567,"en":"At Khan Kökötöy's memorial feast."},{"id":"semetey-1-2013:p1132:b003:l026","ordinal":162568,"en":"The people filled the land in crowds;"},{"id":"semetey-1-2013:p1132:b003:l027","ordinal":162569,"en":"Dust flew into the sky."},{"id":"semetey-1-2013:p1132:b003:l028","ordinal":162570,"en":"When I looked over the people,"},{"id":"semetey-1-2013:p1132:b003:l029","ordinal":162571,"en":"When I looked toward sunset,"},{"id":"semetey-1-2013:p1132:b003:l030","ordinal":162572,"en":"The seething multitude"},{"id":"semetey-1-2013:p1132:b003:l031","ordinal":162573,"en":"Was on the heights of Kyzyl-Kyya."},{"id":"semetey-1-2013:p1132:b003:l032","ordinal":162574,"en":"When I looked toward sunrise,"},{"id":"semetey-1-2013:p1132:b003:l033","ordinal":162575,"en":"The seething multitude"},{"id":"semetey-1-2013:p1132:b003:l034","ordinal":162576,"en":"Was along Chöl-Adyr."},{"id":"semetey-1-2013:p1132:b003:l035","ordinal":162577,"en":"In the hollows of Charyn and Ketmen,"},{"id":"semetey-1-2013:p1132:b003:l036","ordinal":162578,"en":"Those of the army who could not fit"},{"id":"semetey-1-2013:p1132:b003:l037","ordinal":162579,"en":"Were on the face of Chong-Kegen."},{"id":"semetey-1-2013:p1132:b003:l038","ordinal":162580,"en":"The great army on the rearward side"},{"id":"semetey-1-2013:p1132:b003:l039","ordinal":162581,"en":"Was at the upper edge of Teek."},{"id":"semetey-1-2013:p1132:b004:l001","ordinal":162582,"en":"Those of the great army who could not fit"},{"id":"semetey-1-2013:p1132:b004:l002","ordinal":162583,"en":"Were among Karkyra's pines,"},{"id":"semetey-1-2013:p1132:b004:l003","ordinal":162584,"en":"Upon the pine-clad slopes."},{"id":"semetey-1-2013:p1132:b004:l004","ordinal":162585,"en":"The southern side of the gathering"},{"id":"semetey-1-2013:p1132:b004:l005","ordinal":162586,"en":"Was along Aygay-Tash."},{"id":"semetey-1-2013:p1132:b004:l006","ordinal":162587,"en":"Then young Aydar with flowing forelocks,"},{"id":"semetey-1-2013:p1132:b004:l007","ordinal":162588,"en":"Wearing a coat like mail,"},{"id":"semetey-1-2013:p1132:b004:l008","ordinal":162589,"en":"Riding a horse like Maaniker,"},{"id":"semetey-1-2013:p1132:b004:l009","ordinal":162590,"en":"Skimmed over the face of the earth."},{"id":"semetey-1-2013:p1132:b004:l010","ordinal":162591,"en":"Among every son of man who had heard,"},{"id":"semetey-1-2013:p1132:b004:l011","ordinal":162592,"en":"He visited each without omission."},{"id":"semetey-1-2013:p1132:b004:l012","ordinal":162593,"en":"He traveled by day and night,"},{"id":"semetey-1-2013:p1132:b004:l013","ordinal":162594,"en":"Went far without sparing his horse,"},{"id":"semetey-1-2013:p1132:b004:l014","ordinal":162595,"en":"Never stopping overnight on the way,"},{"id":"semetey-1-2013:p1132:b004:l015","ordinal":162596,"en":"Never resting or catching his breath."},{"id":"semetey-1-2013:p1132:b004:l016","ordinal":162597,"en":"He reached Talas"},{"id":"semetey-1-2013:p1132:b004:l017","ordinal":162598,"en":"And now prepared to deliver the message"},{"id":"semetey-1-2013:p1132:b004:l018","ordinal":162599,"en":"To princely Manas the leopard."},{"id":"semetey-1-2013:p1132:b004:l019","ordinal":162600,"en":"Young Aydar with flowing forelocks"},{"id":"semetey-1-2013:p1132:b004:l020","ordinal":162601,"en":"Had circled and traveled"},{"id":"semetey-1-2013:p1132:b004:l021","ordinal":162602,"en":"The four corners of the whole world;"},{"id":"semetey-1-2013:p1132:b004:l022","ordinal":162603,"en":"He was the man who carried the news."},{"id":"semetey-1-2013:p1132:b004:l023","ordinal":162604,"en":"Khan Manas had been left without word;"},{"id":"semetey-1-2013:p1132:b004:l024","ordinal":162605,"en":"The burden weighed upon his mortal soul,"},{"id":"semetey-1-2013:p1132:b004:l025","ordinal":162606,"en":"And now the messenger arrived."},{"id":"semetey-1-2013:p1132:b004:l026","ordinal":162607,"en":"Manas had been left without news"},{"id":"semetey-1-2013:p1132:b004:l027","ordinal":162608,"en":"Because, drunk on his countless livestock,"},{"id":"semetey-1-2013:p1132:b004:l028","ordinal":162609,"en":"Ill-fated Bokmurun"},{"id":"semetey-1-2013:p1132:b004:l029","ordinal":162610,"en":"Had sent him no message."},{"id":"semetey-1-2013:p1132:b004:l030","ordinal":162611,"en":"Kökötöy's arrogant son Bokmurun,"},{"id":"semetey-1-2013:p1132:b004:l031","ordinal":162612,"en":"When Khan Kökötöy died,"},{"id":"semetey-1-2013:p1132:b004:l032","ordinal":162613,"en":"Had hastened to gather a multitude."},{"id":"semetey-1-2013:p1132:b004:l033","ordinal":162614,"en":"Receiving no news and hearing no account,"},{"id":"semetey-1-2013:p1132:b004:l034","ordinal":162615,"en":"Khan Manas remained offended."},{"id":"semetey-1-2013:p1132:b004:l035","ordinal":162616,"en":"His eyes blazed like fire;"},{"id":"semetey-1-2013:p1132:b004:l036","ordinal":162617,"en":"If you had seen the leopard,"},{"id":"semetey-1-2013:p1132:b004:l037","ordinal":162618,"en":"His thirst for blood had seized him."},{"id":"semetey-1-2013:p1132:b004:l038","ordinal":162619,"en":"In all the eighteen thousand worlds,"},{"id":"semetey-1-2013:p1132:b004:l039","ordinal":162620,"en":"For righteous, bloodthirsty Manas—"},{"id":"semetey-1-2013:p1133:b003:l001","ordinal":162621,"en":"Not even a stick for a horse-catching pole remained."},{"id":"semetey-1-2013:p1133:b003:l002","ordinal":162622,"en":"Khan Manas's royal encampment,"},{"id":"semetey-1-2013:p1133:b003:l003","ordinal":162623,"en":"Kanykei's white palace,"},{"id":"semetey-1-2013:p1133:b003:l004","ordinal":162624,"en":"Its gate of solid tin,"},{"id":"semetey-1-2013:p1133:b003:l005","ordinal":162625,"en":"Was a place no person brought news to,"},{"id":"semetey-1-2013:p1133:b003:l006","ordinal":162626,"en":"And no soul visited."},{"id":"semetey-1-2013:p1133:b003:l007","ordinal":162627,"en":"Of anyone who went without an answer,"},{"id":"semetey-1-2013:p1133:b003:l008","ordinal":162628,"en":"Not one remained alive."},{"id":"semetey-1-2013:p1133:b003:l009","ordinal":162629,"en":"Before its door,"},{"id":"semetey-1-2013:p1133:b003:l010","ordinal":162630,"en":"Standing sternly with swords in hand,"},{"id":"semetey-1-2013:p1133:b003:l011","ordinal":162631,"en":"Were exactly forty wrestler guards;"},{"id":"semetey-1-2013:p1133:b003:l012","ordinal":162632,"en":"Its gatekeepers were beyond number."},{"id":"semetey-1-2013:p1133:b003:l013","ordinal":162633,"en":"They wore human noses and ears"},{"id":"semetey-1-2013:p1133:b003:l014","ordinal":162634,"en":"As amulets,"},{"id":"semetey-1-2013:p1133:b003:l015","ordinal":162635,"en":"And were covered in the hides"},{"id":"semetey-1-2013:p1133:b003:l016","ordinal":162636,"en":"Of seventy executioners."},{"id":"semetey-1-2013:p1133:b003:l017","ordinal":162637,"en":"At the mouth of that doorway"},{"id":"semetey-1-2013:p1133:b003:l018","ordinal":162638,"en":"Was a war drum for announcing news;"},{"id":"semetey-1-2013:p1133:b003:l019","ordinal":162639,"en":"When any enemy approached,"},{"id":"semetey-1-2013:p1133:b003:l020","ordinal":162640,"en":"His wrestlers beat it."},{"id":"semetey-1-2013:p1133:b003:l021","ordinal":162641,"en":"When they heard the drum's sound,"},{"id":"semetey-1-2013:p1133:b003:l022","ordinal":162642,"en":"With brave Manas at their head,"},{"id":"semetey-1-2013:p1133:b003:l023","ordinal":162643,"en":"When all forty companions came forth,"},{"id":"semetey-1-2013:p1133:b003:l024","ordinal":162644,"en":"The courage utterly left"},{"id":"semetey-1-2013:p1133:b003:l025","ordinal":162645,"en":"Anyone who drew near."},{"id":"semetey-1-2013:p1133:b003:l026","ordinal":162646,"en":"They had made Talas their homeland"},{"id":"semetey-1-2013:p1133:b003:l027","ordinal":162647,"en":"And settled there, he thought;"},{"id":"semetey-1-2013:p1133:b003:l028","ordinal":162648,"en":"Young Aydar stood amazed,"},{"id":"semetey-1-2013:p1133:b003:l029","ordinal":162649,"en":"Thinking they had become a whole world,"},{"id":"semetey-1-2013:p1133:b003:l030","ordinal":162650,"en":"Let alone merely Chinese."},{"id":"semetey-1-2013:p1133:b003:l031","ordinal":162651,"en":"Manas the keen-eyed leopard"},{"id":"semetey-1-2013:p1133:b003:l032","ordinal":162652,"en":"Was at the point of unleashing"},{"id":"semetey-1-2013:p1133:b003:l033","ordinal":162653,"en":"Festivities upon the Chinese."},{"id":"semetey-1-2013:p1133:b003:l034","ordinal":162654,"en":"If nocturnal Beijing and Kakanchyn"},{"id":"semetey-1-2013:p1133:b003:l035","ordinal":162655,"en":"Attacked with all their might,"},{"id":"semetey-1-2013:p1133:b003:l036","ordinal":162656,"en":"He was at the point of taking them all,"},{"id":"semetey-1-2013:p1133:b003:l037","ordinal":162657,"en":"Leaving not a hair behind."},{"id":"semetey-1-2013:p1133:b003:l038","ordinal":162658,"en":"Young Aydar saw Manas"},{"id":"semetey-1-2013:p1133:b003:l039","ordinal":162659,"en":"And, saying, “He looks fearsome,”"},{"id":"semetey-1-2013:p1133:b004:l001","ordinal":162660,"en":"Rejoiced with all his soul!"},{"id":"semetey-1-2013:p1133:b004:l002","ordinal":162661,"en":"“Brave Manas the leopard"},{"id":"semetey-1-2013:p1133:b004:l003","ordinal":162662,"en":"Is broad across the right shoulder."},{"id":"semetey-1-2013:p1133:b004:l004","ordinal":162663,"en":"For the mere handful of Muslims,"},{"id":"semetey-1-2013:p1133:b004:l005","ordinal":162664,"en":"He is a lion who will remain"},{"id":"semetey-1-2013:p1133:b004:l006","ordinal":162665,"en":"As their supporting pillar!"},{"id":"semetey-1-2013:p1133:b004:l007","ordinal":162666,"en":"Kökötöy's son Bokmurun"},{"id":"semetey-1-2013:p1133:b004:l008","ordinal":162667,"en":"Has grown arrogant,"},{"id":"semetey-1-2013:p1133:b004:l009","ordinal":162668,"en":"Failing to send word to the gray wolf!"},{"id":"semetey-1-2013:p1133:b004:l010","ordinal":162669,"en":"I wore down my horse's flanks;"},{"id":"semetey-1-2013:p1133:b004:l011","ordinal":162670,"en":"Among all people upon the earth,"},{"id":"semetey-1-2013:p1133:b004:l012","ordinal":162671,"en":"I visited every one."},{"id":"semetey-1-2013:p1133:b004:l013","ordinal":162672,"en":"When I saw Manas's form,"},{"id":"semetey-1-2013:p1133:b004:l014","ordinal":162673,"en":"My mind was deeply shaken."},{"id":"semetey-1-2013:p1133:b004:l015","ordinal":162674,"en":"Among infidels and Muslims,"},{"id":"semetey-1-2013:p1133:b004:l016","ordinal":162675,"en":"Among all the giants on earth,"},{"id":"semetey-1-2013:p1133:b004:l017","ordinal":162676,"en":"Where has another like him appeared!"},{"id":"semetey-1-2013:p1133:b004:l018","ordinal":162677,"en":"His fortune is complete;"},{"id":"semetey-1-2013:p1133:b004:l019","ordinal":162678,"en":"He is a hero who receives and protects"},{"id":"semetey-1-2013:p1133:b004:l020","ordinal":162679,"en":"The wretched people without making them wander."},{"id":"semetey-1-2013:p1133:b004:l021","ordinal":162680,"en":"His brow is high and his face venomous;"},{"id":"semetey-1-2013:p1133:b004:l022","ordinal":162681,"en":"What soul survives when the bloodthirsty one kills?"},{"id":"semetey-1-2013:p1133:b004:l023","ordinal":162682,"en":"His face is like oiled wheat,"},{"id":"semetey-1-2013:p1133:b004:l024","ordinal":162683,"en":"His eyes like twilight mist."},{"id":"semetey-1-2013:p1133:b004:l025","ordinal":162684,"en":"The madman who confronts him—"},{"id":"semetey-1-2013:p1133:b004:l026","ordinal":162685,"en":"The way he faces becomes a red fire."},{"id":"semetey-1-2013:p1133:b004:l027","ordinal":162686,"en":"His courage is formidable, his venom strong;"},{"id":"semetey-1-2013:p1133:b004:l028","ordinal":162687,"en":"He lays flat whoever attacks him!”"},{"id":"semetey-1-2013:p1133:b004:l029","ordinal":162688,"en":"His prince sat firm as a camel;"},{"id":"semetey-1-2013:p1133:b004:l030","ordinal":162689,"en":"With mighty Bakai at their head,"},{"id":"semetey-1-2013:p1133:b004:l031","ordinal":162690,"en":"Twenty were on his right."},{"id":"semetey-1-2013:p1133:b004:l032","ordinal":162691,"en":"Each was worth a thousand,"},{"id":"semetey-1-2013:p1133:b004:l033","ordinal":162692,"en":"All gray-wolf champions of noble stock."},{"id":"semetey-1-2013:p1133:b004:l034","ordinal":162693,"en":"With Khan Almanbet at their head,"},{"id":"semetey-1-2013:p1133:b004:l035","ordinal":162694,"en":"Twenty were on his left."},{"id":"semetey-1-2013:p1133:b004:l036","ordinal":162695,"en":"Their waists girded for single combat,"},{"id":"semetey-1-2013:p1133:b004:l037","ordinal":162696,"en":"Against an army of seven countless hosts,"},{"id":"semetey-1-2013:p1133:b004:l038","ordinal":162697,"en":"They charged alone through its midst,"},{"id":"semetey-1-2013:p1133:b004:l039","ordinal":162698,"en":"A brood like monsters."},{"id":"semetey-1-2013:p1134:b003:l001","ordinal":162699,"en":"Khan Manas's forty companions—"},{"id":"semetey-1-2013:p1134:b003:l002","ordinal":162700,"en":"The most cunning of spearmen."},{"id":"semetey-1-2013:p1134:b003:l003","ordinal":162701,"en":"Among those companions,"},{"id":"semetey-1-2013:p1134:b003:l004","ordinal":162702,"en":"Azhibai and Chubak were the strongest."},{"id":"semetey-1-2013:p1134:b003:l005","ordinal":162703,"en":"Khan Manas's forty companions—"},{"id":"semetey-1-2013:p1134:b003:l006","ordinal":162704,"en":"The sight of them divides one's attention;"},{"id":"semetey-1-2013:p1134:b003:l007","ordinal":162705,"en":"Most looked like naked blades."},{"id":"semetey-1-2013:p1134:b003:l008","ordinal":162706,"en":"Told to take a hat, they cut off a head;"},{"id":"semetey-1-2013:p1134:b003:l009","ordinal":162707,"en":"Told to drink water, they drank poison."},{"id":"semetey-1-2013:p1134:b003:l010","ordinal":162708,"en":"Each was a gray-wolf peerless champion,"},{"id":"semetey-1-2013:p1134:b003:l011","ordinal":162709,"en":"Forty distinguished men"},{"id":"semetey-1-2013:p1134:b003:l012","ordinal":162710,"en":"Who came from forty different places."},{"id":"semetey-1-2013:p1134:b003:l013","ordinal":162711,"en":"Each of the forty had a different way,"},{"id":"semetey-1-2013:p1134:b003:l014","ordinal":162712,"en":"With barbed spears and red caps,"},{"id":"semetey-1-2013:p1134:b003:l015","ordinal":162713,"en":"Like blazing red fire."},{"id":"semetey-1-2013:p1134:b003:l016","ordinal":162714,"en":"The forty companions, wolves of war:"},{"id":"semetey-1-2013:p1134:b003:l017","ordinal":162715,"en":"Tölömön's diviner"},{"id":"semetey-1-2013:p1134:b003:l018","ordinal":162716,"en":"Cast omens at their head;"},{"id":"semetey-1-2013:p1134:b003:l019","ordinal":162717,"en":"Yrchyuul, son of Yraman,"},{"id":"semetey-1-2013:p1134:b003:l020","ordinal":162718,"en":"Sang beside them."},{"id":"semetey-1-2013:p1134:b003:l021","ordinal":162719,"en":"Their wrath turned outward;"},{"id":"semetey-1-2013:p1134:b003:l022","ordinal":162720,"en":"Khan Manas's forty companions"},{"id":"semetey-1-2013:p1134:b003:l023","ordinal":162721,"en":"Bound on swords without scabbards."},{"id":"semetey-1-2013:p1134:b003:l024","ordinal":162722,"en":"Beside Khan Manas,"},{"id":"semetey-1-2013:p1134:b003:l025","ordinal":162723,"en":"They stood raging,"},{"id":"semetey-1-2013:p1134:b003:l026","ordinal":162724,"en":"Finding no mountain to strike,"},{"id":"semetey-1-2013:p1134:b003:l027","ordinal":162725,"en":"Finding no enemy to fight,"},{"id":"semetey-1-2013:p1134:b003:l028","ordinal":162726,"en":"Gathering themselves with a growl."},{"id":"semetey-1-2013:p1134:b003:l029","ordinal":162727,"en":"The forty companions wore"},{"id":"semetey-1-2013:p1134:b003:l030","ordinal":162728,"en":"Blue-lynx and sable hats;"},{"id":"semetey-1-2013:p1134:b003:l031","ordinal":162729,"en":"The way they faced was red fire."},{"id":"semetey-1-2013:p1134:b003:l032","ordinal":162730,"en":"Young Aydar walked"},{"id":"semetey-1-2013:p1134:b003:l033","ordinal":162731,"en":"Before valiant Manas,"},{"id":"semetey-1-2013:p1134:b003:l034","ordinal":162732,"en":"Giving him six swift horses"},{"id":"semetey-1-2013:p1134:b003:l035","ordinal":162733,"en":"And a palm-sized letter:"},{"id":"semetey-1-2013:p1134:b003:l036","ordinal":162734,"en":"“Koshoy and Töshtük are your khans;"},{"id":"semetey-1-2013:p1134:b003:l037","ordinal":162735,"en":"Our souls are sorely afflicted."},{"id":"semetey-1-2013:p1134:b003:l038","ordinal":162736,"en":"At Khan Kökötöy's memorial feast,"},{"id":"semetey-1-2013:p1134:b003:l039","ordinal":162737,"en":"A great gathering assembled,"},{"id":"semetey-1-2013:p1134:b004:l001","ordinal":162738,"en":"And we are all about to be slaughtered."},{"id":"semetey-1-2013:p1134:b004:l002","ordinal":162739,"en":"Gray-wolf Manas, go"},{"id":"semetey-1-2013:p1134:b004:l003","ordinal":162740,"en":"To Kökötöy's memorial feast."},{"id":"semetey-1-2013:p1134:b004:l004","ordinal":162741,"en":"The Muslims lie in humiliation;"},{"id":"semetey-1-2013:p1134:b004:l005","ordinal":162742,"en":"Rescue them"},{"id":"semetey-1-2013:p1134:b004:l006","ordinal":162743,"en":"From the Black Chinese and Manchus!"},{"id":"semetey-1-2013:p1134:b004:l007","ordinal":162744,"en":"If you do not rescue them,"},{"id":"semetey-1-2013:p1134:b004:l008","ordinal":162745,"en":"The fearsome Black Chinese"},{"id":"semetey-1-2013:p1134:b004:l009","ordinal":162746,"en":"Will bring hardship upon their heads"},{"id":"semetey-1-2013:p1134:b004:l010","ordinal":162747,"en":"And strike them down to the last."},{"id":"semetey-1-2013:p1134:b004:l011","ordinal":162748,"en":"Koshoy and Töshtük may die;"},{"id":"semetey-1-2013:p1134:b004:l012","ordinal":162749,"en":"The Black Chinese and Manchus"},{"id":"semetey-1-2013:p1134:b004:l013","ordinal":162750,"en":"May divide all the Muslims"},{"id":"semetey-1-2013:p1134:b004:l014","ordinal":162751,"en":"Into shares measured by the whip."},{"id":"semetey-1-2013:p1134:b004:l015","ordinal":162752,"en":"They may slaughter every one, leaving none;"},{"id":"semetey-1-2013:p1134:b004:l016","ordinal":162753,"en":"Kalcha, Zholoy, and Ezkara—"},{"id":"semetey-1-2013:p1134:b004:l017","ordinal":162754,"en":"These three have joined together"},{"id":"semetey-1-2013:p1134:b004:l018","ordinal":162755,"en":"And may do whatever they please."},{"id":"semetey-1-2013:p1134:b004:l019","ordinal":162756,"en":"At our very hearth we suffered humiliation;"},{"id":"semetey-1-2013:p1134:b004:l020","ordinal":162757,"en":"Among the Black Chinese and Manchus,"},{"id":"semetey-1-2013:p1134:b004:l021","ordinal":162758,"en":"We saw a tyrant named Kongurbai."},{"id":"semetey-1-2013:p1134:b004:l022","ordinal":162759,"en":"Zholoy used his force,"},{"id":"semetey-1-2013:p1134:b004:l023","ordinal":162760,"en":"Demanding that Maaniker be given him;"},{"id":"semetey-1-2013:p1134:b004:l024","ordinal":162761,"en":"Ezkara inflicted humiliation."},{"id":"semetey-1-2013:p1134:b004:l025","ordinal":162762,"en":"They were ready to make us taste salt,"},{"id":"semetey-1-2013:p1134:b004:l026","ordinal":162763,"en":"And ready to plunder the girls."},{"id":"semetey-1-2013:p1134:b004:l027","ordinal":162764,"en":"They seized and ate the meat;"},{"id":"semetey-1-2013:p1134:b004:l028","ordinal":162765,"en":"They were ready to destroy every face."},{"id":"semetey-1-2013:p1134:b004:l029","ordinal":162766,"en":"If you, the burdened one, do not go,"},{"id":"semetey-1-2013:p1134:b004:l030","ordinal":162767,"en":"They may cast a cold catching-pole"},{"id":"semetey-1-2013:p1134:b004:l031","ordinal":162768,"en":"Upon the racehorse that would not be given when asked."},{"id":"semetey-1-2013:p1134:b004:l032","ordinal":162769,"en":"They may leave all the Muslim giants"},{"id":"semetey-1-2013:p1134:b004:l033","ordinal":162770,"en":"Entirely on foot"},{"id":"semetey-1-2013:p1134:b004:l034","ordinal":162771,"en":"And seize their horses."},{"id":"semetey-1-2013:p1134:b004:l035","ordinal":162772,"en":"Before all the other peoples, those Chinese,"},{"id":"semetey-1-2013:p1134:b004:l036","ordinal":162773,"en":"If allowed to have their way,"},{"id":"semetey-1-2013:p1134:b004:l037","ordinal":162774,"en":"May use force at the feast."},{"id":"semetey-1-2013:p1134:b004:l038","ordinal":162775,"en":"I saw it with my own eyes."},{"id":"semetey-1-2013:p1134:b004:l039","ordinal":162776,"en":"They besieged the Muslims,"},{"id":"semetey-1-2013:p1135:b003:l001","ordinal":162777,"en":"The black Kalmyks plundered"},{"id":"semetey-1-2013:p1135:b003:l002","ordinal":162778,"en":"Kökötöy's fatty meat."},{"id":"semetey-1-2013:p1135:b003:l003","ordinal":162779,"en":"Unable to restrain the many infidels,"},{"id":"semetey-1-2013:p1135:b003:l004","ordinal":162780,"en":"The Muslims grew weary."},{"id":"semetey-1-2013:p1135:b003:l005","ordinal":162781,"en":"From Ezkara came a challenge;"},{"id":"semetey-1-2013:p1135:b003:l006","ordinal":162782,"en":"From Zholoy the black Kalmyk"},{"id":"semetey-1-2013:p1135:b003:l007","ordinal":162783,"en":"Came fierce turmoil and strife."},{"id":"semetey-1-2013:p1135:b003:l008","ordinal":162784,"en":"If you truly are a hero,"},{"id":"semetey-1-2013:p1135:b003:l009","ordinal":162785,"en":"Go now, Manas;"},{"id":"semetey-1-2013:p1135:b003:l010","ordinal":162786,"en":"The Muslims are about to be destroyed—"},{"id":"semetey-1-2013:p1135:b003:l011","ordinal":162787,"en":"Go and separate them!"},{"id":"semetey-1-2013:p1135:b003:l012","ordinal":162788,"en":"You are a khan, a tiger!"},{"id":"semetey-1-2013:p1135:b003:l013","ordinal":162789,"en":"Here is the city with many towers;"},{"id":"semetey-1-2013:p1135:b003:l014","ordinal":162790,"en":"Here am I, if you would cut off my head!"},{"id":"semetey-1-2013:p1135:b003:l015","ordinal":162791,"en":"Külaiym, seated in mourning for Kökötöy—"},{"id":"semetey-1-2013:p1135:b003:l016","ordinal":162792,"en":"The infidel stretched out his hand,"},{"id":"semetey-1-2013:p1135:b003:l017","ordinal":162793,"en":"Laid hands upon the bereaved woman,"},{"id":"semetey-1-2013:p1135:b003:l018","ordinal":162794,"en":"And God struck the Kalmyk."},{"id":"semetey-1-2013:p1135:b003:l019","ordinal":162795,"en":"With hero Kongurbay at their head,"},{"id":"semetey-1-2013:p1135:b003:l020","ordinal":162796,"en":"The Chinese girded their waists firmly,"},{"id":"semetey-1-2013:p1135:b003:l021","ordinal":162797,"en":"Ready, if they found the means,"},{"id":"semetey-1-2013:p1135:b003:l022","ordinal":162798,"en":"To pursue Alööke's blood-price,"},{"id":"semetey-1-2013:p1135:b003:l023","ordinal":162799,"en":"To raid the villages of the Muslims"},{"id":"semetey-1-2013:p1135:b003:l024","ordinal":162800,"en":"Who had gone to the feast;"},{"id":"semetey-1-2013:p1135:b003:l025","ordinal":162801,"en":"Zholoy of the Kalmyks"},{"id":"semetey-1-2013:p1135:b003:l026","ordinal":162802,"en":"Was ready to bring utter destruction."},{"id":"semetey-1-2013:p1135:b003:l027","ordinal":162803,"en":"Bloodthirsty Manas, the tiger,"},{"id":"semetey-1-2013:p1135:b003:l028","ordinal":162804,"en":"If you truly are a khan,"},{"id":"semetey-1-2013:p1135:b003:l029","ordinal":162805,"en":"You will rise in courage."},{"id":"semetey-1-2013:p1135:b003:l030","ordinal":162806,"en":"When you aim at the Manchu whose turn has come,"},{"id":"semetey-1-2013:p1135:b003:l031","ordinal":162807,"en":"You will reach him, Manas."},{"id":"semetey-1-2013:p1135:b003:l032","ordinal":162808,"en":"At Khan Kökötöy's feast,"},{"id":"semetey-1-2013:p1135:b003:l033","ordinal":162809,"en":"You, tiger Manas, were absent."},{"id":"semetey-1-2013:p1135:b003:l034","ordinal":162810,"en":"We struck the Koroson firestone"},{"id":"semetey-1-2013:p1135:b003:l035","ordinal":162811,"en":"Infidel and Muslim alike,"},{"id":"semetey-1-2013:p1135:b003:l036","ordinal":162812,"en":"We summoned every one of them."},{"id":"semetey-1-2013:p1135:b003:l037","ordinal":162813,"en":"The people gathered in a mass;"},{"id":"semetey-1-2013:p1135:b003:l038","ordinal":162814,"en":"Dust flew into the sky."},{"id":"semetey-1-2013:p1135:b003:l039","ordinal":162815,"en":"Swarming like black worms,"},{"id":"semetey-1-2013:p1135:b004:l001","ordinal":162816,"en":"They escaped the eye when one looked,"}]
