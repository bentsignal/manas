[{"id":"semetey-1-2013:p0894:b004:l029","ordinal":145409,"en":"Entered his lung."},{"id":"semetey-1-2013:p0894:b004:l030","ordinal":145410,"en":"Abyke and Kobosh’s"},{"id":"semetey-1-2013:p0894:b004:l031","ordinal":145411,"en":"Appointed deaths had both arrived."},{"id":"semetey-1-2013:p0894:b004:l032","ordinal":145412,"en":"Overturning Abyke,"},{"id":"semetey-1-2013:p0894:b004:l033","ordinal":145413,"en":"Sending Kobosh to the grave,"},{"id":"semetey-1-2013:p0894:b004:l034","ordinal":145414,"en":"The boy Semetey again"},{"id":"semetey-1-2013:p0894:b004:l035","ordinal":145415,"en":"Showed his fierce nature."},{"id":"semetey-1-2013:p0894:b004:l036","ordinal":145416,"en":"He soaked the valley in fat;"},{"id":"semetey-1-2013:p0894:b004:l037","ordinal":145417,"en":"When enmity flared,"},{"id":"semetey-1-2013:p0894:b004:l038","ordinal":145418,"en":"He killed his own elder kinsman."},{"id":"semetey-1-2013:p0894:b004:l039","ordinal":145419,"en":"He poured blood into the dark water,"},{"id":"semetey-1-2013:p0895:b003:l001","ordinal":145420,"en":"He set the grassy land ablaze,"},{"id":"semetey-1-2013:p0895:b003:l002","ordinal":145421,"en":"Set fire to the meadows."},{"id":"semetey-1-2013:p0895:b003:l003","ordinal":145422,"en":"Growing to manhood as an orphan,"},{"id":"semetey-1-2013:p0895:b003:l004","ordinal":145423,"en":"He joined the ranks himself,"},{"id":"semetey-1-2013:p0895:b003:l005","ordinal":145424,"en":"Matured and became a man,"},{"id":"semetey-1-2013:p0895:b003:l006","ordinal":145425,"en":"An equal among heroes’ sons."},{"id":"semetey-1-2013:p0895:b003:l007","ordinal":145426,"en":"Alabek of Alty-Shaar,"},{"id":"semetey-1-2013:p0895:b003:l008","ordinal":145427,"en":"Buyanbek of Khan Buudaiyk—"},{"id":"semetey-1-2013:p0895:b003:l009","ordinal":145428,"en":"The great armies of those two,"},{"id":"semetey-1-2013:p0895:b003:l010","ordinal":145429,"en":"Making Tuuchunak rear and plunge,"},{"id":"semetey-1-2013:p0895:b003:l011","ordinal":145430,"en":"What did your uncle Sary Khan do?"},{"id":"semetey-1-2013:p0895:b003:l012","ordinal":145431,"en":"Those two with their great armies"},{"id":"semetey-1-2013:p0895:b003:l013","ordinal":145432,"en":"He utterly slaughtered and destroyed."},{"id":"semetey-1-2013:p0895:b003:l014","ordinal":145433,"en":"While Sary Khan"},{"id":"semetey-1-2013:p0895:b003:l015","ordinal":145434,"en":"Did as he saw fit,"},{"id":"semetey-1-2013:p0895:b003:l016","ordinal":145435,"en":"Scattering them up and down,"},{"id":"semetey-1-2013:p0895:b003:l017","ordinal":145436,"en":"While he slaughtered them,"},{"id":"semetey-1-2013:p0895:b003:l018","ordinal":145437,"en":"Khan Bakai’s Baitailak"},{"id":"semetey-1-2013:p0895:b003:l019","ordinal":145438,"en":"Shouted along the steep bank,"},{"id":"semetey-1-2013:p0895:b003:l020","ordinal":145439,"en":"Cried “Manas!” as his battle cry,"},{"id":"semetey-1-2013:p0895:b003:l021","ordinal":145440,"en":"And the many Sarts on packsaddles"},{"id":"semetey-1-2013:p0895:b003:l022","ordinal":145441,"en":"He swept down and slaughtered."},{"id":"semetey-1-2013:p0895:b003:l023","ordinal":145442,"en":"Sary Khan’s Kalyk,"},{"id":"semetey-1-2013:p0895:b003:l024","ordinal":145443,"en":"When he once felled the kaldai’s standard,"},{"id":"semetey-1-2013:p0895:b003:l026","ordinal":145444,"en":"Upon the Muslim people"},{"id":"semetey-1-2013:p0895:b003:l027","ordinal":145445,"en":"His light had shone in a special way."},{"id":"semetey-1-2013:p0895:b003:l028","ordinal":145446,"en":"His intentions too were pure."},{"id":"semetey-1-2013:p0895:b003:l029","ordinal":145447,"en":"Sary Khan’s son"},{"id":"semetey-1-2013:p0895:b003:l030","ordinal":145448,"en":"Shouted and leveled his spear,"},{"id":"semetey-1-2013:p0895:b003:l031","ordinal":145449,"en":"Slaughtered a great many."},{"id":"semetey-1-2013:p0895:b003:l032","ordinal":145450,"en":"Jamgyrchy's Shaiymbet,"},{"id":"semetey-1-2013:p0895:b003:l033","ordinal":145451,"en":"Licking his lips like a hungry wolf,"},{"id":"semetey-1-2013:p0895:b003:l034","ordinal":145452,"en":"Looked about him."},{"id":"semetey-1-2013:p0895:b003:l035","ordinal":145453,"en":"Shaiymbet was an ocean;"},{"id":"semetey-1-2013:p0895:b003:l036","ordinal":145454,"en":"He stood beneath the standard."},{"id":"semetey-1-2013:p0895:b003:l037","ordinal":145455,"en":"Struck by Kanykei’s spear,"},{"id":"semetey-1-2013:p0895:b003:l038","ordinal":145456,"en":"The forty companions, cursed by the spirits,"},{"id":"semetey-1-2013:p0895:b003:l039","ordinal":145457,"en":"Had fallen captive."},{"id":"semetey-1-2013:p0895:b004:l001","ordinal":145458,"en":"Kanykei and Chiyyrdy"},{"id":"semetey-1-2013:p0895:b004:l002","ordinal":145459,"en":"To Semetey’s grandfather,"},{"id":"semetey-1-2013:p0895:b004:l003","ordinal":145460,"en":"Great Jakyp, went."},{"id":"semetey-1-2013:p0895:b004:l004","ordinal":145461,"en":"That swine Jakyp"},{"id":"semetey-1-2013:p0895:b004:l005","ordinal":145462,"en":"They trampled upon the head."},{"id":"semetey-1-2013:p0895:b004:l006","ordinal":145463,"en":"Three elder women joined together"},{"id":"semetey-1-2013:p0895:b004:l007","ordinal":145464,"en":"And scattered his four kinds of livestock."},{"id":"semetey-1-2013:p0895:b004:l008","ordinal":145465,"en":"Let us teach him a lesson."},{"id":"semetey-1-2013:p0895:b004:l009","ordinal":145466,"en":"They struck his brains out,"},{"id":"semetey-1-2013:p0895:b004:l010","ordinal":145467,"en":"Slaughtered his grandfather, the swine khan,"},{"id":"semetey-1-2013:p0895:b004:l011","ordinal":145468,"en":"Gouged out both his eyes,"},{"id":"semetey-1-2013:p0895:b004:l012","ordinal":145469,"en":"Boiled it without letting it be unlawful meat,"},{"id":"semetey-1-2013:p0895:b004:l013","ordinal":145470,"en":"Made kuurdak of his head and ate their fill."},{"id":"semetey-1-2013:p0895:b004:l014","ordinal":145471,"en":"The grief of a burning heart—"},{"id":"semetey-1-2013:p0895:b004:l015","ordinal":145472,"en":"Your dear sister-in-law Kanykei"},{"id":"semetey-1-2013:p0895:b004:l016","ordinal":145473,"en":"Wiped them out, leaving none."},{"id":"semetey-1-2013:p0895:b004:l017","ordinal":145474,"en":"Her pain subsided;"},{"id":"semetey-1-2013:p0895:b004:l018","ordinal":145475,"en":"Then your sister-in-law Kanykei"},{"id":"semetey-1-2013:p0895:b004:l019","ordinal":145476,"en":"Her eyes opened wide,"},{"id":"semetey-1-2013:p0895:b004:l020","ordinal":145477,"en":"Manas’s wife Akylai—"},{"id":"semetey-1-2013:p0895:b004:l021","ordinal":145478,"en":"She had no sense, good heavens!"},{"id":"semetey-1-2013:p0895:b004:l022","ordinal":145479,"en":"The pampered wife Akylai—"},{"id":"semetey-1-2013:p0895:b004:l023","ordinal":145480,"en":"Born foolish, good heavens—"},{"id":"semetey-1-2013:p0895:b004:l024","ordinal":145481,"en":"Had married Kobosh."},{"id":"semetey-1-2013:p0895:b004:l025","ordinal":145482,"en":"Many people knew her conduct."},{"id":"semetey-1-2013:p0895:b004:l026","ordinal":145483,"en":"Your dear mother Kanykei"},{"id":"semetey-1-2013:p0895:b004:l027","ordinal":145484,"en":"She had set her astride a pole,"},{"id":"semetey-1-2013:p0895:b004:l028","ordinal":145485,"en":"Making the fierce woman scream,"},{"id":"semetey-1-2013:p0895:b004:l029","ordinal":145486,"en":"She dragged her by her very hair."},{"id":"semetey-1-2013:p0895:b004:l030","ordinal":145487,"en":"“Your precious hair, thick as a girth—"},{"id":"semetey-1-2013:p0895:b004:l031","ordinal":145488,"en":"How could you cast it over your breast?"},{"id":"semetey-1-2013:p0895:b004:l032","ordinal":145489,"en":"With dogs born of ravens,"},{"id":"semetey-1-2013:p0895:b004:l033","ordinal":145490,"en":"How could you lie in lust?"},{"id":"semetey-1-2013:p0895:b004:l034","ordinal":145491,"en":"Of the lord born of a falcon,"},{"id":"semetey-1-2013:p0895:b004:l035","ordinal":145492,"en":"How could you let them trample his bed?"},{"id":"semetey-1-2013:p0895:b004:l036","ordinal":145493,"en":"My bloodthirsty hero’s treasury"},{"id":"semetey-1-2013:p0895:b004:l037","ordinal":145494,"en":"You let a multitude of dogs scatter."},{"id":"semetey-1-2013:p0895:b004:l038","ordinal":145495,"en":"The thick-laid bed of the bloodthirsty hero"},{"id":"semetey-1-2013:p0895:b004:l039","ordinal":145496,"en":"You let six scoundrels trample."},{"id":"semetey-1-2013:p0896:b003:l001","ordinal":145497,"en":"“You too were Manas’s wife;"},{"id":"semetey-1-2013:p0896:b003:l002","ordinal":145498,"en":"I too was Manas’s wife."},{"id":"semetey-1-2013:p0896:b003:l003","ordinal":145499,"en":"To Temirkan’s city,"},{"id":"semetey-1-2013:p0896:b003:l004","ordinal":145500,"en":"For whose sake did I wander?"},{"id":"semetey-1-2013:p0896:b003:l005","ordinal":145501,"en":"Wandering to Bukhara,"},{"id":"semetey-1-2013:p0896:b003:l006","ordinal":145502,"en":"Settling there as a wandering neighbor,"},{"id":"semetey-1-2013:p0896:b003:l007","ordinal":145503,"en":"Acquiring a bad name—"},{"id":"semetey-1-2013:p0896:b003:l008","ordinal":145504,"en":"Woman, it was for your sake!"},{"id":"semetey-1-2013:p0896:b003:l009","ordinal":145505,"en":"When the bloodthirsty hero died,"},{"id":"semetey-1-2013:p0896:b003:l010","ordinal":145506,"en":"Before forty days had passed since his death,"},{"id":"semetey-1-2013:p0896:b003:l011","ordinal":145507,"en":"You married a man, made a spectacle,"},{"id":"semetey-1-2013:p0896:b003:l012","ordinal":145508,"en":"And caused this havoc."},{"id":"semetey-1-2013:p0896:b003:l013","ordinal":145509,"en":"Wretched woman, because of you,"},{"id":"semetey-1-2013:p0896:b003:l014","ordinal":145510,"en":"Chafing my heels,"},{"id":"semetey-1-2013:p0896:b003:l015","ordinal":145511,"en":"Aching in the flesh of my calves,"},{"id":"semetey-1-2013:p0896:b003:l016","ordinal":145512,"en":"I scattered my countless treasures,"},{"id":"semetey-1-2013:p0896:b003:l017","ordinal":145513,"en":"Fled toward Bukhara!"},{"id":"semetey-1-2013:p0896:b003:l018","ordinal":145514,"en":"For whose sake was this humiliation?"},{"id":"semetey-1-2013:p0896:b003:l019","ordinal":145515,"en":"Treacherous woman, for your sake!”"},{"id":"semetey-1-2013:p0896:b003:l020","ordinal":145516,"en":"Having said this, Kanykei"},{"id":"semetey-1-2013:p0896:b003:l021","ordinal":145517,"en":"The depraved woman Akylai"},{"id":"semetey-1-2013:p0896:b003:l022","ordinal":145518,"en":"First seized,"},{"id":"semetey-1-2013:p0896:b003:l023","ordinal":145519,"en":"Dragged her onto the road,"},{"id":"semetey-1-2013:p0896:b003:l024","ordinal":145520,"en":"And had dogs tear her apart."},{"id":"semetey-1-2013:p0896:b003:l025","ordinal":145521,"en":"Her enemy who bore her malice"},{"id":"semetey-1-2013:p0896:b003:l026","ordinal":145522,"en":"She slaughtered as a sacrifice."},{"id":"semetey-1-2013:p0896:b003:l027","ordinal":145523,"en":"Your dear sister-in-law Kanykei"},{"id":"semetey-1-2013:p0896:b003:l028","ordinal":145524,"en":"Kapkai took revenge."},{"id":"semetey-1-2013:p0896:b003:l029","ordinal":145525,"en":"Her craving for vengeance satisfied,"},{"id":"semetey-1-2013:p0896:b003:l030","ordinal":145526,"en":"Before the leopard orphan arrived,"},{"id":"semetey-1-2013:p0896:b003:l031","ordinal":145527,"en":"The forty companions taken captive,"},{"id":"semetey-1-2013:p0896:b003:l032","ordinal":145528,"en":"The vast host surrounding them,"},{"id":"semetey-1-2013:p0896:b003:l033","ordinal":145529,"en":"Raised a commotion, shouting."},{"id":"semetey-1-2013:p0896:b003:l034","ordinal":145530,"en":"Let us leave this thus."},{"id":"semetey-1-2013:p0896:b003:l035","ordinal":145531,"en":"The people taken captive,"},{"id":"semetey-1-2013:p0896:b003:l036","ordinal":145532,"en":"Before they slaughtered them without letting them stir,"},{"id":"semetey-1-2013:p0896:b003:l037","ordinal":145533,"en":"Champion Bakai the leopard,"},{"id":"semetey-1-2013:p0896:b003:l038","ordinal":145534,"en":"Wearing a gray lynx-fur cap,"},{"id":"semetey-1-2013:p0896:b003:l039","ordinal":145535,"en":"Brandishing his mottled shield,"},{"id":"semetey-1-2013:p0896:b004:l001","ordinal":145536,"en":"Clad in shining mail,"},{"id":"semetey-1-2013:p0896:b004:l002","ordinal":145537,"en":"Calling out like a young goose,"},{"id":"semetey-1-2013:p0896:b004:l003","ordinal":145538,"en":"Royal Bakai began to speak:"},{"id":"semetey-1-2013:p0896:b004:l004","ordinal":145539,"en":"“Oh, Kanykei, Sary Khan!"},{"id":"semetey-1-2013:p0896:b004:l005","ordinal":145540,"en":"This conduct of yours is cruel."},{"id":"semetey-1-2013:p0896:b004:l006","ordinal":145541,"en":"What guilt have the many people?"},{"id":"semetey-1-2013:p0896:b004:l007","ordinal":145542,"en":"Remain where you are."},{"id":"semetey-1-2013:p0896:b004:l008","ordinal":145543,"en":"Until the orphan, our support, arrives,"},{"id":"semetey-1-2013:p0896:b004:l009","ordinal":145544,"en":"Wait patiently."},{"id":"semetey-1-2013:p0896:b004:l010","ordinal":145545,"en":"I shall speak words worthy of heed."},{"id":"semetey-1-2013:p0896:b004:l011","ordinal":145546,"en":"Both of you, listen without delay!"},{"id":"semetey-1-2013:p0896:b004:l012","ordinal":145547,"en":"A broad valley needs land;"},{"id":"semetey-1-2013:p0896:b004:l013","ordinal":145548,"en":"The orphan who has grown and returned"},{"id":"semetey-1-2013:p0896:b004:l014","ordinal":145549,"en":"Will need a people tomorrow!"},{"id":"semetey-1-2013:p0896:b004:l015","ordinal":145550,"en":"A hilly mountain needs a ridge;"},{"id":"semetey-1-2013:p0896:b004:l016","ordinal":145551,"en":"A hero needs a people!"},{"id":"semetey-1-2013:p0896:b004:l017","ordinal":145552,"en":"As great as a mountain crest,"},{"id":"semetey-1-2013:p0896:b004:l018","ordinal":145553,"en":"Semetey, Manas’s son,"},{"id":"semetey-1-2013:p0896:b004:l019","ordinal":145554,"en":"When he comes and settles in Talas,"},{"id":"semetey-1-2013:p0896:b004:l020","ordinal":145555,"en":"‘He destroyed all his people,"},{"id":"semetey-1-2013:p0896:b004:l021","ordinal":145556,"en":"He slaughtered them’—do not let that be said."},{"id":"semetey-1-2013:p0896:b004:l022","ordinal":145557,"en":"Is not their khan a fool?"},{"id":"semetey-1-2013:p0896:b004:l023","ordinal":145558,"en":"What guilt have the many people?"},{"id":"semetey-1-2013:p0896:b004:l024","ordinal":145559,"en":"What guilt have all the people?"},{"id":"semetey-1-2013:p0896:b004:l025","ordinal":145560,"en":"Turning your intentions toward evil,"},{"id":"semetey-1-2013:p0896:b004:l026","ordinal":145561,"en":"Oh, my foal Kanykei,"},{"id":"semetey-1-2013:p0896:b004:l027","ordinal":145562,"en":"With what face can you slaughter"},{"id":"semetey-1-2013:p0896:b004:l028","ordinal":145563,"en":"Your people left by Manas?”"},{"id":"semetey-1-2013:p0896:b004:l029","ordinal":145564,"en":"Royal Bakai called out,"},{"id":"semetey-1-2013:p0896:b004:l030","ordinal":145565,"en":"Stepped between them,"},{"id":"semetey-1-2013:p0896:b004:l031","ordinal":145566,"en":"And all those people"},{"id":"semetey-1-2013:p0896:b004:l032","ordinal":145567,"en":"He saved by interceding."},{"id":"semetey-1-2013:p0896:b004:l033","ordinal":145568,"en":"They bowed to Khan Bakai,"},{"id":"semetey-1-2013:p0896:b004:l034","ordinal":145569,"en":"The sage, fierce Bakai’s"},{"id":"semetey-1-2013:p0896:b004:l035","ordinal":145570,"en":"Words they readily accepted,"},{"id":"semetey-1-2013:p0896:b004:l036","ordinal":145571,"en":"Granted what he wished."},{"id":"semetey-1-2013:p0896:b004:l037","ordinal":145572,"en":"Your elder Bakai brought good fortune,"},{"id":"semetey-1-2013:p0896:b004:l038","ordinal":145573,"en":"An old man who showed the way,"},{"id":"semetey-1-2013:p0896:b004:l039","ordinal":145574,"en":"Truly a sage himself."},{"id":"semetey-1-2013:p0897:b003:l001","ordinal":145575,"en":"No evil word could cling to him;"},{"id":"semetey-1-2013:p0897:b003:l002","ordinal":145576,"en":"Even if he entered the grave,"},{"id":"semetey-1-2013:p0897:b003:l003","ordinal":145577,"en":"Fierce Bakai would not go astray."},{"id":"semetey-1-2013:p0897:b003:l004","ordinal":145578,"en":"The whole wide world—"},{"id":"semetey-1-2013:p0897:b003:l005","ordinal":145579,"en":"Was it not Bakai who apportioned it?"},{"id":"semetey-1-2013:p0897:b003:l006","ordinal":145580,"en":"Living as a hero in the world,"},{"id":"semetey-1-2013:p0897:b003:l007","ordinal":145581,"en":"Was it not Bakai who had seen it?"},{"id":"semetey-1-2013:p0897:b003:l008","ordinal":145582,"en":"The door that stood locked—"},{"id":"semetey-1-2013:p0897:b003:l009","ordinal":145583,"en":"Was it not Bakai who opened it?"},{"id":"semetey-1-2013:p0897:b003:l010","ordinal":145584,"en":"Gold and silver,"},{"id":"semetey-1-2013:p0897:b003:l011","ordinal":145585,"en":"Spending them freely across the land,"},{"id":"semetey-1-2013:p0897:b003:l012","ordinal":145586,"en":"Was it not Bakai who scattered them?"},{"id":"semetey-1-2013:p0897:b003:l013","ordinal":145587,"en":"For the mortal seeking support,"},{"id":"semetey-1-2013:p0897:b003:l014","ordinal":145588,"en":"Was not Bakai that support?"},{"id":"semetey-1-2013:p0897:b003:l015","ordinal":145589,"en":"Created for humankind,"},{"id":"semetey-1-2013:p0897:b003:l016","ordinal":145590,"en":"Was not Bakai its lion?"},{"id":"semetey-1-2013:p0897:b003:l017","ordinal":145591,"en":"His speech was sweet, his words honey."},{"id":"semetey-1-2013:p0897:b003:l018","ordinal":145592,"en":"Do not ask of Khan Bakai;"},{"id":"semetey-1-2013:p0897:b003:l019","ordinal":145593,"en":"He had surpassingly clear sight."},{"id":"semetey-1-2013:p0897:b003:l020","ordinal":145594,"en":"His understanding was complete; in every way,"},{"id":"semetey-1-2013:p0897:b003:l021","ordinal":145595,"en":"He began to speak with reason."},{"id":"semetey-1-2013:p0897:b003:l022","ordinal":145596,"en":"Your dear, quick-witted Bakai—"},{"id":"semetey-1-2013:p0897:b003:l023","ordinal":145597,"en":"His kingship known to the people,"},{"id":"semetey-1-2013:p0897:b003:l024","ordinal":145598,"en":"Old leopard Bakai—"},{"id":"semetey-1-2013:p0897:b003:l025","ordinal":145599,"en":"There he turned Kökcholok’s head;"},{"id":"semetey-1-2013:p0897:b003:l026","ordinal":145600,"en":"There he stood interceding."},{"id":"semetey-1-2013:p0897:b003:l027","ordinal":145601,"en":"Before even that much time had passed,"},{"id":"semetey-1-2013:p0897:b003:l028","ordinal":145602,"en":"The young lord Semetey"},{"id":"semetey-1-2013:p0897:b003:l029","ordinal":145603,"en":"Also arrived."},{"id":"semetey-1-2013:p0897:b003:l030","ordinal":145604,"en":"Khan Manas’s forty companions,"},{"id":"semetey-1-2013:p0897:b003:l031","ordinal":145605,"en":"When they saw Semetey,"},{"id":"semetey-1-2013:p0897:b003:l032","ordinal":145606,"en":"Stood in a row, sobbing."},{"id":"semetey-1-2013:p0897:b003:l033","ordinal":145607,"en":"“The only son left by my khan Manas!”"},{"id":"semetey-1-2013:p0897:b003:l035","ordinal":145608,"en":"They cried aloud."},{"id":"semetey-1-2013:p0897:b003:l036","ordinal":145609,"en":"“My shelter left by Manas,"},{"id":"semetey-1-2013:p0897:b003:l037","ordinal":145610,"en":"My good fortune left by his blessing!"},{"id":"semetey-1-2013:p0897:b003:l038","ordinal":145611,"en":"For Manas, gone before us,"},{"id":"semetey-1-2013:p0897:b003:l039","ordinal":145612,"en":"Whether we sit or stand, we grieve."},{"id":"semetey-1-2013:p0897:b005:l001","ordinal":145613,"en":"My shelter left by Manas,"},{"id":"semetey-1-2013:p0897:b005:l002","ordinal":145614,"en":"We pray for your wishes to come true."},{"id":"semetey-1-2013:p0897:b005:l003","ordinal":145615,"en":"If you scout, here is the road;"},{"id":"semetey-1-2013:p0897:b005:l004","ordinal":145616,"en":"He had lost the one he relied upon,"},{"id":"semetey-1-2013:p0897:b005:l005","ordinal":145617,"en":"Here are we, your forty companion-uncles."},{"id":"semetey-1-2013:p0897:b005:l006","ordinal":145618,"en":"Here is bush-covered Talas, your land;"},{"id":"semetey-1-2013:p0897:b005:l007","ordinal":145619,"en":"Here are we, the companions of old."},{"id":"semetey-1-2013:p0897:b005:l008","ordinal":145620,"en":"The inheritance left by your father—"},{"id":"semetey-1-2013:p0897:b005:l009","ordinal":145621,"en":"If you will receive it, here we are."},{"id":"semetey-1-2013:p0897:b005:l010","ordinal":145622,"en":"Here are the Kyrgyz people with their ruler;"},{"id":"semetey-1-2013:p0897:b005:l011","ordinal":145623,"en":"If you will take heads, here we are."},{"id":"semetey-1-2013:p0897:b005:l012","ordinal":145624,"en":"Orphan, our support, listen:"},{"id":"semetey-1-2013:p0897:b005:l013","ordinal":145625,"en":"If you will dig deep, here is the pit;"},{"id":"semetey-1-2013:p0897:b005:l014","ordinal":145626,"en":"If you will boil, here is the brine."},{"id":"semetey-1-2013:p0897:b005:l015","ordinal":145627,"en":"My only one left by the ruler,"},{"id":"semetey-1-2013:p0897:b005:l016","ordinal":145628,"en":"Bind and kill us—here are our hands."},{"id":"semetey-1-2013:p0897:b005:l017","ordinal":145629,"en":"Struck by the spirits, smitten by the oath,"},{"id":"semetey-1-2013:p0897:b005:l018","ordinal":145630,"en":"Here are we of treacherous intent!"},{"id":"semetey-1-2013:p0897:b005:l019","ordinal":145631,"en":"Was given by almighty Allah"},{"id":"semetey-1-2013:p0897:b005:l020","ordinal":145632,"en":"Almighty God in his power"},{"id":"semetey-1-2013:p0897:b005:l021","ordinal":145633,"en":"Not fearing oath or ancestral spirits,"},{"id":"semetey-1-2013:p0897:b005:l022","ordinal":145634,"en":"In the end it strikes us!"},{"id":"semetey-1-2013:p0897:b005:l023","ordinal":145635,"en":"We forty companions scattered"},{"id":"semetey-1-2013:p0897:b005:l024","ordinal":145636,"en":"When your fortunate elder died,"},{"id":"semetey-1-2013:p0897:b005:l025","ordinal":145637,"en":"Hiding ourselves in Talas,"},{"id":"semetey-1-2013:p0897:b005:l026","ordinal":145638,"en":"You, whom we took as our support,"},{"id":"semetey-1-2013:p0897:b005:l027","ordinal":145639,"en":"We drove fleeing toward Bukhara."},{"id":"semetey-1-2013:p0897:b005:l028","ordinal":145640,"en":"When your fearless father was alive,"},{"id":"semetey-1-2013:p0897:b005:l029","ordinal":145641,"en":"We exacted tribute and became khans."},{"id":"semetey-1-2013:p0897:b005:l030","ordinal":145642,"en":"Acting like the damned, firing shots,"},{"id":"semetey-1-2013:p0897:b005:l031","ordinal":145643,"en":"All of us fell into turmoil;"},{"id":"semetey-1-2013:p0897:b005:l032","ordinal":145644,"en":"Today you have laid us low."},{"id":"semetey-1-2013:p0897:b005:l033","ordinal":145645,"en":"If you desire, slaughter us;"},{"id":"semetey-1-2013:p0897:b005:l034","ordinal":145646,"en":"If your heart is unwilling,"},{"id":"semetey-1-2013:p0897:b005:l035","ordinal":145647,"en":"Leave us alive, sprawled as we are!"},{"id":"semetey-1-2013:p0897:b005:l036","ordinal":145648,"en":"If you seek spoils, here is the livestock;"},{"id":"semetey-1-2013:p0897:b005:l037","ordinal":145649,"en":"If you wish it to flow, here is red blood;"},{"id":"semetey-1-2013:p0897:b005:l038","ordinal":145650,"en":"If you will cut it short, here is life!"},{"id":"semetey-1-2013:p0897:b005:l039","ordinal":145651,"en":"Khan Manas’s orphan,"},{"id":"semetey-1-2013:p0898:b003:l001","ordinal":145652,"en":"Disheartened, from various places"},{"id":"semetey-1-2013:p0898:b003:l002","ordinal":145653,"en":"We moved to Talas."},{"id":"semetey-1-2013:p0898:b003:l003","ordinal":145654,"en":"We gathered as companions"},{"id":"semetey-1-2013:p0898:b003:l004","ordinal":145655,"en":"Around Lord Manas, the leopard."},{"id":"semetey-1-2013:p0898:b003:l005","ordinal":145656,"en":"Our horses grew fat, and we grew strong,"},{"id":"semetey-1-2013:p0898:b003:l006","ordinal":145657,"en":"Coming from many places, we became forty."},{"id":"semetey-1-2013:p0898:b003:l007","ordinal":145658,"en":"We grew eager for heroic deeds;"},{"id":"semetey-1-2013:p0898:b003:l008","ordinal":145659,"en":"We gathered from forty places."},{"id":"semetey-1-2013:p0898:b003:l009","ordinal":145660,"en":"Our elders, led by Kyrgyl,"},{"id":"semetey-1-2013:p0898:b003:l010","ordinal":145661,"en":"All the forty companions—"},{"id":"semetey-1-2013:p0898:b003:l011","ordinal":145662,"en":"We became a spectacle and were slaughtered."},{"id":"semetey-1-2013:p0898:b003:l012","ordinal":145663,"en":"Forgetting the past,"},{"id":"semetey-1-2013:p0898:b003:l013","ordinal":145664,"en":"We turned back toward the ancestral spirit."}]
