[{"id":"manas-2010:p0720:b001:l001","ordinal":32001,"en":"To the headland where the mountains ended"},{"id":"manas-2010:p0720:b001:l002","ordinal":32002,"en":"Bakai rode,"},{"id":"manas-2010:p0720:b001:l003","ordinal":32003,"en":"Scouting the patrol's route."},{"id":"manas-2010:p0720:b001:l004","ordinal":32004,"en":"Your valiant elder Bakai"},{"id":"manas-2010:p0720:b001:l005","ordinal":32005,"en":"Climbed up to keep watch."},{"id":"manas-2010:p0720:b001:l006","ordinal":32006,"en":"When he looked out carefully,"},{"id":"manas-2010:p0720:b001:l007","ordinal":32007,"en":"Beside Böyrök and Ak-Chiy,"},{"id":"manas-2010:p0720:b001:l008","ordinal":32008,"en":"From the mountain called Akchyk,"},{"id":"manas-2010:p0720:b001:l009","ordinal":32009,"en":"In its descending hollow,"},{"id":"manas-2010:p0720:b001:l010","ordinal":32010,"en":"Beside the great Ak-Chiy,"},{"id":"manas-2010:p0720:b001:l011","ordinal":32011,"en":"That swine's tent stood pitched,"},{"id":"manas-2010:p0720:b001:l012","ordinal":32012,"en":"With its golden fastening cords."},{"id":"manas-2010:p0720:b001:l013","ordinal":32013,"en":"He had halted for a day's rest,"},{"id":"manas-2010:p0720:b001:l014","ordinal":32014,"en":"The warrior Khan Alööke."},{"id":"manas-2010:p0720:b001:l015","ordinal":32015,"en":"Smoke rose in billowing streams;"},{"id":"manas-2010:p0720:b001:l016","ordinal":32016,"en":"Alööke's countless troops"},{"id":"manas-2010:p0720:b001:l017","ordinal":32017,"en":"Could be seen encamped."},{"id":"manas-2010:p0720:b001:l018","ordinal":32018,"en":"They slept propped on their elbows,"},{"id":"manas-2010:p0720:b001:l019","ordinal":32019,"en":"Sounded trumpets and rested at ease."},{"id":"manas-2010:p0720:b001:l020","ordinal":32020,"en":"From a mule that had a foal"},{"id":"manas-2010:p0720:b001:l021","ordinal":32021,"en":"They slew her foal, leaving her alone,"},{"id":"manas-2010:p0720:b001:l022","ordinal":32022,"en":"“From bloodthirsty Manas the warrior,"},{"id":"manas-2010:p0720:b001:l023","ordinal":32023,"en":"We have escaped,” they thought."},{"id":"manas-2010:p0720:b001:l024","ordinal":32024,"en":"The mighty Torghut and Manchu men"},{"id":"manas-2010:p0720:b001:l025","ordinal":32025,"en":"Lay sprawling without a stir,"},{"id":"manas-2010:p0720:b001:l026","ordinal":32026,"en":"At the thought, “An enemy may come pursuing,”"},{"id":"manas-2010:p0720:b001:l027","ordinal":32027,"en":"Untroubled, without a stir."},{"id":"manas-2010:p0720:b001:l028","ordinal":32028,"en":"There lay Alööke;"},{"id":"manas-2010:p0720:b001:l029","ordinal":32029,"en":"Countless stores of gold and silver,"},{"id":"manas-2010:p0720:b001:l030","ordinal":32030,"en":"Taken as booty from the Burut,"},{"id":"manas-2010:p0720:b001:l031","ordinal":32031,"en":"Alööke had loaded up."},{"id":"manas-2010:p0720:b001:l032","ordinal":32032,"en":"They were surely no ordinary horses:"},{"id":"manas-2010:p0720:b001:l033","ordinal":32033,"en":"The beasts he kept were his weapons."},{"id":"manas-2010:p0720:b001:l034","ordinal":32034,"en":"Every one of those accursed creatures"},{"id":"manas-2010:p0720:b001:l035","ordinal":32035,"en":"Had hooves of cast iron."},{"id":"manas-2010:p0720:b001:l036","ordinal":32036,"en":"All his equipment was complete."},{"id":"manas-2010:p0720:b001:l037","ordinal":32037,"en":"That accursed Alööke"},{"id":"manas-2010:p0720:b001:l038","ordinal":32038,"en":"To all eighteen thousand worlds,"},{"id":"manas-2010:p0720:b001:l039","ordinal":32039,"en":"He seemed invincible."},{"id":"manas-2010:p0720:b001:l040","ordinal":32040,"en":"No beast could catch them in pursuit;"},{"id":"manas-2010:p0720:b001:l041","ordinal":32041,"en":"His beasts flew like clouds."},{"id":"manas-2010:p0720:b001:l042","ordinal":32042,"en":"If vast hosts of foes barred his way,"}]
