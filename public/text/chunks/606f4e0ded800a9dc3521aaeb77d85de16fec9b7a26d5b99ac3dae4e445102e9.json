[{"id":"manas-2010:p1757:b001:l017","ordinal":75521,"en":"Azizkan's Almambet"},{"id":"manas-2010:p1757:b001:l018","ordinal":75522,"en":"Fought for sixty days,"},{"id":"manas-2010:p1757:b001:l019","ordinal":75523,"en":"Trading spear thrusts with her."},{"id":"manas-2010:p1757:b001:l020","ordinal":75524,"en":"Apart from Almambet,"},{"id":"manas-2010:p1757:b001:l021","ordinal":75525,"en":"She utterly exhausted them all,"},{"id":"manas-2010:p1757:b001:l022","ordinal":75526,"en":"Spearing them off their horses."},{"id":"manas-2010:p1757:b001:l023","ordinal":75527,"en":"My rashness roused me:"},{"id":"manas-2010:p1757:b001:l024","ordinal":75528,"en":"Karacha's daughter Saikal—"},{"id":"manas-2010:p1757:b001:l025","ordinal":75529,"en":"I went out before her and met her."},{"id":"manas-2010:p1757:b001:l026","ordinal":75530,"en":"Shouting, we leveled our spears;"},{"id":"manas-2010:p1757:b001:l027","ordinal":75531,"en":"On the moonlike yellow plain"},{"id":"manas-2010:p1757:b001:l028","ordinal":75532,"en":"Neither could overcome the other."},{"id":"manas-2010:p1757:b001:l029","ordinal":75533,"en":"At a rather level rise,"},{"id":"manas-2010:p1757:b001:l030","ordinal":75534,"en":"At the mountain's flat spur,"},{"id":"manas-2010:p1757:b001:l031","ordinal":75535,"en":"When we came to our final clash,"},{"id":"manas-2010:p1757:b001:l032","ordinal":75536,"en":"Khan Saikal grew angry"},{"id":"manas-2010:p1757:b001:l033","ordinal":75537,"en":"And struck with her spear."},{"id":"manas-2010:p1757:b001:l034","ordinal":75538,"en":"Helpless, I sprawled wide;"},{"id":"manas-2010:p1757:b001:l035","ordinal":75539,"en":"My nose bulged like a wineskin,"},{"id":"manas-2010:p1757:b001:l036","ordinal":75540,"en":"My legs hung loose,"},{"id":"manas-2010:p1757:b001:l037","ordinal":75541,"en":"My eyes rolled wildly."},{"id":"manas-2010:p1757:b001:l038","ordinal":75542,"en":"The man left his saddle,"},{"id":"manas-2010:p1757:b001:l039","ordinal":75543,"en":"His feet left the stirrups;"},{"id":"manas-2010:p1757:b001:l040","ordinal":75544,"en":"Such was Saikal's prowess"},{"id":"manas-2010:p1757:b001:l041","ordinal":75545,"en":"That I lost my senses."},{"id":"manas-2010:p1757:b001:l042","ordinal":75546,"en":"Coughing in fury,"},{"id":"manas-2010:p1758:b001:l001","ordinal":75547,"en":"Your dear blue-maned Saikal,"},{"id":"manas-2010:p1758:b001:l002","ordinal":75548,"en":"Towering like a mighty mountain,"},{"id":"manas-2010:p1758:b001:l003","ordinal":75549,"en":"From Akkula's back"},{"id":"manas-2010:p1758:b001:l004","ordinal":75550,"en":"She lifted me up."},{"id":"manas-2010:p1758:b001:l005","ordinal":75551,"en":"Then Saikal thought:"},{"id":"manas-2010:p1758:b001:l006","ordinal":75552,"en":"‘He is the Muslims' lion."},{"id":"manas-2010:p1758:b001:l007","ordinal":75553,"en":"If I fling him down in anger,"},{"id":"manas-2010:p1758:b001:l008","ordinal":75554,"en":"Islam's backbone will break."},{"id":"manas-2010:p1758:b001:l009","ordinal":75555,"en":"“Manas was speared by a woman"},{"id":"manas-2010:p1758:b001:l010","ordinal":75556,"en":"And left a helpless wreck”—"},{"id":"manas-2010:p1758:b001:l011","ordinal":75557,"en":"If the unbelievers hear this news,"},{"id":"manas-2010:p1758:b001:l012","ordinal":75558,"en":"God's wrath will strike anew."},{"id":"manas-2010:p1758:b001:l013","ordinal":75559,"en":"Why should I drag him from his horse?"},{"id":"manas-2010:p1758:b001:l014","ordinal":75560,"en":"By unhorsing the greathearted one,"},{"id":"manas-2010:p1758:b001:l015","ordinal":75561,"en":"What legacy would I gain?’"},{"id":"manas-2010:p1758:b001:l016","ordinal":75562,"en":"So she set me back in the saddle."},{"id":"manas-2010:p1758:b001:l017","ordinal":75563,"en":"As that wretched Saikal stood there,"},{"id":"manas-2010:p1758:b001:l018","ordinal":75564,"en":"‘You made me a lion who shattered the unbelievers,"},{"id":"manas-2010:p1758:b001:l019","ordinal":75565,"en":"Yet not the equal of one woman—"},{"id":"manas-2010:p1758:b001:l020","ordinal":75566,"en":"Why have you made me so feeble?’"},{"id":"manas-2010:p1758:b001:l021","ordinal":75567,"en":"I said, poor soul that I was."},{"id":"manas-2010:p1758:b001:l022","ordinal":75568,"en":"Rallying myself, I fought again;"},{"id":"manas-2010:p1758:b001:l023","ordinal":75569,"en":"We grappled foot against foot"},{"id":"manas-2010:p1758:b001:l024","ordinal":75570,"en":"And seized each other's collars."},{"id":"manas-2010:p1758:b001:l025","ordinal":75571,"en":"Satisfying our yearning for combat,"},{"id":"manas-2010:p1758:b001:l026","ordinal":75572,"en":"We struck with battle-axes,"},{"id":"manas-2010:p1758:b001:l027","ordinal":75573,"en":"Hacked with swords"},{"id":"manas-2010:p1758:b001:l028","ordinal":75574,"en":"Until only hilts remained in our hands."},{"id":"manas-2010:p1758:b001:l029","ordinal":75575,"en":"In the desert of Kum-Talaa"},{"id":"manas-2010:p1758:b001:l030","ordinal":75576,"en":"I defeated Saikal."},{"id":"manas-2010:p1758:b001:l031","ordinal":75577,"en":"Hoisting her like a fodder-bag,"},{"id":"manas-2010:p1758:b001:l032","ordinal":75578,"en":"When my anger reached its height,"},{"id":"manas-2010:p1758:b001:l033","ordinal":75579,"en":"I snatched Saikal from her horse."},{"id":"manas-2010:p1758:b001:l034","ordinal":75580,"en":"‘I shall put a bridal kerchief on her head;"},{"id":"manas-2010:p1758:b001:l035","ordinal":75581,"en":"This fury has tormented me enough."},{"id":"manas-2010:p1758:b001:l036","ordinal":75582,"en":"I shall marry her at high noon,’ I said."},{"id":"manas-2010:p1758:b001:l037","ordinal":75583,"en":"When Aikozho in his motley robe"},{"id":"manas-2010:p1758:b001:l038","ordinal":75584,"en":"Stood between us—"},{"id":"manas-2010:p1758:b001:l039","ordinal":75585,"en":"He was the spiritual patron I revered—"},{"id":"manas-2010:p1758:b001:l040","ordinal":75586,"en":"And solemnized our marriage for the Last Judgment,"},{"id":"manas-2010:p1758:b001:l041","ordinal":75587,"en":"Khan Saikal, daughter of Karacha Khan,"},{"id":"manas-2010:p1758:b001:l042","ordinal":75588,"en":"Made this promise:"},{"id":"manas-2010:p1759:b001:l001","ordinal":75589,"en":"‘When you die, for forty days"},{"id":"manas-2010:p1759:b001:l002","ordinal":75590,"en":"I shall attend your funeral rites,’ she said,"},{"id":"manas-2010:p1759:b001:l003","ordinal":75591,"en":"And swore upon the Quran."},{"id":"manas-2010:p1759:b001:l004","ordinal":75592,"en":"Send word to Khan Saikal;"},{"id":"manas-2010:p1759:b001:l005","ordinal":75593,"en":"When Saikal comes, bury me."},{"id":"manas-2010:p1759:b001:l006","ordinal":75594,"en":"On that day, my fierce one,"},{"id":"manas-2010:p1759:b001:l007","ordinal":75595,"en":"You may do as you please."},{"id":"manas-2010:p1759:b001:l008","ordinal":75596,"en":"In the land called Lower Crimea,"},{"id":"manas-2010:p1759:b001:l009","ordinal":75597,"en":"Forty days' journey away,"},{"id":"manas-2010:p1759:b001:l010","ordinal":75598,"en":"Lives Urumkan's son Kokboru."},{"id":"manas-2010:p1759:b001:l011","ordinal":75599,"en":"Together we stirred clouds in the sky"},{"id":"manas-2010:p1759:b001:l012","ordinal":75600,"en":"And pledged friendship into the next world."},{"id":"manas-2010:p1759:b001:l013","ordinal":75601,"en":"We joined when tiny as lice,"},{"id":"manas-2010:p1759:b001:l014","ordinal":75602,"en":"United when small as thumbs;"},{"id":"manas-2010:p1759:b001:l015","ordinal":75603,"en":"Together we played and wrestled."},{"id":"manas-2010:p1759:b001:l016","ordinal":75604,"en":"In the city of Lower Mecca"},{"id":"manas-2010:p1759:b001:l017","ordinal":75605,"en":"We studied for five years."},{"id":"manas-2010:p1759:b001:l018","ordinal":75606,"en":"We talked together,"},{"id":"manas-2010:p1759:b001:l019","ordinal":75607,"en":"Pledging friendship thrice in one day."},{"id":"manas-2010:p1759:b001:l020","ordinal":75608,"en":"Send word to Kokboru;"},{"id":"manas-2010:p1759:b001:l021","ordinal":75609,"en":"Let my poor soul not depart with eyes unclosed."},{"id":"manas-2010:p1759:b001:l022","ordinal":75610,"en":"Ever acting as befits his name,"},{"id":"manas-2010:p1759:b001:l023","ordinal":75611,"en":"Let your greathearted one's honor suffer no loss through this."},{"id":"manas-2010:p1759:b001:l024","ordinal":75612,"en":"Listen, hapless Kanykei, I have something to say."},{"id":"manas-2010:p1759:b001:l025","ordinal":75613,"en":"There are forty holy men in Andijan:"},{"id":"manas-2010:p1759:b001:l026","ordinal":75614,"en":"Have them brought here"},{"id":"manas-2010:p1759:b001:l027","ordinal":75615,"en":"To perform my rite of absolution."},{"id":"manas-2010:p1759:b001:l028","ordinal":75616,"en":"Let Andijan's Aikozho"},{"id":"manas-2010:p1759:b001:l029","ordinal":75617,"en":"Attend my funeral prayer."},{"id":"manas-2010:p1759:b001:l030","ordinal":75618,"en":"Be sure to bring him;"},{"id":"manas-2010:p1759:b001:l031","ordinal":75619,"en":"Spend my livestock,"},{"id":"manas-2010:p1759:b001:l032","ordinal":75620,"en":"Giving him half of all I own!"},{"id":"manas-2010:p1759:b001:l033","ordinal":75621,"en":"The reason you must give it:"},{"id":"manas-2010:p1759:b001:l034","ordinal":75622,"en":"When drunk on mare's milk,"},{"id":"manas-2010:p1759:b001:l035","ordinal":75623,"en":"I imprisoned Aikozho"},{"id":"manas-2010:p1759:b001:l036","ordinal":75624,"en":"And beat the forty holy men."},{"id":"manas-2010:p1759:b001:l037","ordinal":75625,"en":"When they truly angered me,"},{"id":"manas-2010:p1759:b001:l038","ordinal":75626,"en":"I plundered their turbans"},{"id":"manas-2010:p1759:b001:l039","ordinal":75627,"en":"And penned them up like dogs."},{"id":"manas-2010:p1759:b001:l040","ordinal":75628,"en":"When drunk on liquor,"},{"id":"manas-2010:p1759:b001:l041","ordinal":75629,"en":"When young and lacking sense,"},{"id":"manas-2010:p1759:b001:l042","ordinal":75630,"en":"I persisted in drinking grain beer"},{"id":"manas-2010:p1760:b001:l001","ordinal":75631,"en":"And beat him till he wailed."},{"id":"manas-2010:p1760:b001:l002","ordinal":75632,"en":"I took liquor and drank it."},{"id":"manas-2010:p1760:b001:l003","ordinal":75633,"en":"When I go to the next world,"},{"id":"manas-2010:p1760:b001:l004","ordinal":75634,"en":"Kanykei, what shall I do about"},{"id":"manas-2010:p1760:b001:l005","ordinal":75635,"en":"The transgression laid upon my neck?”"},{"id":"manas-2010:p1760:b001:l006","ordinal":75636,"en":"So Manas muttered,"},{"id":"manas-2010:p1760:b001:l007","ordinal":75637,"en":"His thin mustache lying flat,"},{"id":"manas-2010:p1760:b001:l008","ordinal":75638,"en":"As though bound for Judgment Day."},{"id":"manas-2010:p1760:b001:l009","ordinal":75639,"en":"Manas turned and lay upon his side,"},{"id":"manas-2010:p1760:b001:l010","ordinal":75640,"en":"His keen eyes peering faintly."},{"id":"manas-2010:p1760:b001:l011","ordinal":75641,"en":"Khan Manas was in a dreadful state,"},{"id":"manas-2010:p1760:b001:l012","ordinal":75642,"en":"As though bound for Judgment Day,"},{"id":"manas-2010:p1760:b001:l013","ordinal":75643,"en":"Seized by distress, his limbs gone slack."},{"id":"manas-2010:p1760:b001:l014","ordinal":75644,"en":"Seeing this sickness of his,"},{"id":"manas-2010:p1760:b001:l015","ordinal":75645,"en":"His thin mustache lying flat,"},{"id":"manas-2010:p1760:b001:l016","ordinal":75646,"en":"As though bound for Judgment Day,"},{"id":"manas-2010:p1760:b001:l017","ordinal":75647,"en":"She saw his eyes rolling wildly,"},{"id":"manas-2010:p1760:b001:l018","ordinal":75648,"en":"As though bound for the next world,"},{"id":"manas-2010:p1760:b001:l019","ordinal":75649,"en":"Gravely ill, his limbs gone slack."},{"id":"manas-2010:p1760:b001:l020","ordinal":75650,"en":"Coughing with crack upon crack,"},{"id":"manas-2010:p1760:b001:l021","ordinal":75651,"en":"Exhausting his fierce wife,"},{"id":"manas-2010:p1760:b001:l022","ordinal":75652,"en":"He lifted his head from the pillow."},{"id":"manas-2010:p1760:b001:l023","ordinal":75653,"en":"When he rose and cried, “Oh!”"},{"id":"manas-2010:p1760:b001:l024","ordinal":75654,"en":"Blood poured out in gushes."},{"id":"manas-2010:p1760:b001:l025","ordinal":75655,"en":"Wailing and weeping without cease,"},{"id":"manas-2010:p1760:b001:l026","ordinal":75656,"en":"Kanykei lost her strength."},{"id":"manas-2010:p1760:b001:l027","ordinal":75657,"en":"Coughing with thud upon thud,"},{"id":"manas-2010:p1760:b001:l028","ordinal":75658,"en":"He lifted his head from the bed."},{"id":"manas-2010:p1760:b001:l029","ordinal":75659,"en":"When he rose and cried, “Oh!”"},{"id":"manas-2010:p1760:b001:l030","ordinal":75660,"en":"From the sovereign's mouth"},{"id":"manas-2010:p1760:b001:l031","ordinal":75661,"en":"Blood poured out by the bowlful."},{"id":"manas-2010:p1760:b001:l032","ordinal":75662,"en":"Weeping in anguish and crying out,"},{"id":"manas-2010:p1760:b001:l033","ordinal":75663,"en":"Your sister-in-law lost her strength."},{"id":"manas-2010:p1760:b001:l034","ordinal":75664,"en":"As the blue-maned khan grew sicker,"},{"id":"manas-2010:p1760:b001:l035","ordinal":75665,"en":"Unable to twist her reinlike hair,"},{"id":"manas-2010:p1760:b001:l036","ordinal":75666,"en":"Your sister-in-law could not stand for shrieking and weeping."},{"id":"manas-2010:p1760:b001:l037","ordinal":75667,"en":"Your sovereign fell dreadfully ill."},{"id":"manas-2010:p1760:b001:l038","ordinal":75668,"en":"The dark blood issuing from his mouth"},{"id":"manas-2010:p1760:b001:l039","ordinal":75669,"en":"Filled twelve whole pits."},{"id":"manas-2010:p1760:b001:l040","ordinal":75670,"en":"Seeing the blood that flowed,"},{"id":"manas-2010:p1760:b001:l041","ordinal":75671,"en":"Your sister-in-law screamed and wept,"},{"id":"manas-2010:p1760:b001:l042","ordinal":75672,"en":"Unable to find even a fly's worth of help:"},{"id":"manas-2010:p1761:b001:l001","ordinal":75673,"en":"“The leopard's hour of death has come;"},{"id":"manas-2010:p1761:b001:l002","ordinal":75674,"en":"This unfortunate woman has no recourse."},{"id":"manas-2010:p1761:b001:l003","ordinal":75675,"en":"My brow bone slopes away;"},{"id":"manas-2010:p1761:b001:l004","ordinal":75676,"en":"When my sovereign has passed away,"},{"id":"manas-2010:p1761:b001:l005","ordinal":75677,"en":"This unfortunate woman's fortune will be scant."},{"id":"manas-2010:p1761:b001:l006","ordinal":75678,"en":"This poor head will drink mare's milk no more."},{"id":"manas-2010:p1761:b001:l007","ordinal":75679,"en":"When the lord has passed away,"},{"id":"manas-2010:p1761:b001:l008","ordinal":75680,"en":"I shall yearn even for brackish water."},{"id":"manas-2010:p1761:b001:l009","ordinal":75681,"en":"When the mighty one's eyes close,"},{"id":"manas-2010:p1761:b001:l010","ordinal":75682,"en":"My poor life will be abased.”"},{"id":"manas-2010:p1761:b001:l011","ordinal":75683,"en":"Then Manas said these words"},{"id":"manas-2010:p1761:b001:l012","ordinal":75684,"en":"(His illness now beyond all measure):"},{"id":"manas-2010:p1761:b001:l013","ordinal":75685,"en":"“Kanykei, its collar gold, its sleeves brass,"},{"id":"manas-2010:p1761:b001:l014","ordinal":75686,"en":"Its double mail with lark's-eye links,"},{"id":"manas-2010:p1761:b001:l015","ordinal":75687,"en":"Its brocade sash, its ample jacket,"},{"id":"manas-2010:p1761:b001:l016","ordinal":75688,"en":"Reinforced in places with fine iron wire,"},{"id":"manas-2010:p1761:b001:l017","ordinal":75689,"en":"Thwarting even Kelte's bullets,"},{"id":"manas-2010:p1761:b001:l018","ordinal":75690,"en":"Beyond the reach of arrows,"},{"id":"manas-2010:p1761:b001:l019","ordinal":75691,"en":"Impenetrable to steel points,"},{"id":"manas-2010:p1761:b001:l020","ordinal":75692,"en":"Though one fought six months without rest,"},{"id":"manas-2010:p1761:b001:l021","ordinal":75693,"en":"No bullet could pierce it."},{"id":"manas-2010:p1761:b001:l022","ordinal":75694,"en":"I had Andijan and Kokand searched;"},{"id":"manas-2010:p1761:b001:l023","ordinal":75695,"en":"The cotton of the Six Cities and Kokand"},{"id":"manas-2010:p1761:b001:l024","ordinal":75696,"en":"I had brought in as tribute."},{"id":"manas-2010:p1761:b001:l025","ordinal":75697,"en":"I had every part made strong,"},{"id":"manas-2010:p1761:b001:l026","ordinal":75698,"en":"Had it worked without stint."},{"id":"manas-2010:p1761:b001:l027","ordinal":75699,"en":"Wearing it satisfied the heart;"},{"id":"manas-2010:p1761:b001:l028","ordinal":75700,"en":"No howling blizzard touched the body."},{"id":"manas-2010:p1761:b001:l029","ordinal":75701,"en":"Akolpok, fit for battle—"},{"id":"manas-2010:p1761:b001:l030","ordinal":75702,"en":"Kanykei, lay it over me!"},{"id":"manas-2010:p1761:b001:l031","ordinal":75703,"en":"Let me turn my face to the True One;"},{"id":"manas-2010:p1761:b001:l032","ordinal":75704,"en":"When the angel of death draws near,"},{"id":"manas-2010:p1761:b001:l033","ordinal":75705,"en":"Let me close my eyes saying, ‘Allah!’"},{"id":"manas-2010:p1761:b001:l034","ordinal":75706,"en":"Until my dear soul gives its cry,"},{"id":"manas-2010:p1761:b001:l035","ordinal":75707,"en":"With Akolpok, worn in firefights,"},{"id":"manas-2010:p1761:b001:l036","ordinal":75708,"en":"Let me comfort myself."},{"id":"manas-2010:p1761:b001:l037","ordinal":75709,"en":"Slung over the back, a mirror to the moonlike shoulders,"},{"id":"manas-2010:p1761:b001:l038","ordinal":75710,"en":"When life is sorely pressed,"},{"id":"manas-2010:p1761:b001:l039","ordinal":75711,"en":"A solace to the soul held in trust,"},{"id":"manas-2010:p1761:b001:l040","ordinal":75712,"en":"A matchlock when fired in play,"},{"id":"manas-2010:p1761:b001:l041","ordinal":75713,"en":"A Koichagyr gun when striking in earnest,"},{"id":"manas-2010:p1761:b001:l042","ordinal":75714,"en":"The living gun Akkelte—"},{"id":"manas-2010:p1762:b001:l001","ordinal":75715,"en":"Earlier, beyond Andijan,"},{"id":"manas-2010:p1762:b001:l002","ordinal":75716,"en":"On this side of Namangan,"},{"id":"manas-2010:p1762:b001:l003","ordinal":75717,"en":"Under the khan of Kokand's wing,"},{"id":"manas-2010:p1762:b001:l004","ordinal":75718,"en":"From the moon-yellow plain,"},{"id":"manas-2010:p1762:b001:l005","ordinal":75719,"en":"Sixty Russian land surveyors,"},{"id":"manas-2010:p1762:b001:l006","ordinal":75720,"en":"When they came forth,"},{"id":"manas-2010:p1762:b001:l007","ordinal":75721,"en":"When I turned my steed toward them,"},{"id":"manas-2010:p1762:b001:l008","ordinal":75722,"en":"When we stood opposed,"},{"id":"manas-2010:p1762:b001:l009","ordinal":75723,"en":"Fled away in a clattering rush."},{"id":"manas-2010:p1762:b001:l010","ordinal":75724,"en":"Those sixty Russian champions,"},{"id":"manas-2010:p1762:b001:l011","ordinal":75725,"en":"Slaughtered and plundered in the field—"},{"id":"manas-2010:p1762:b001:l012","ordinal":75726,"en":"Akkelte, taken as booty,"},{"id":"manas-2010:p1762:b001:l013","ordinal":75727,"en":"Kanykey, lay it beside me!"},{"id":"manas-2010:p1762:b001:l014","ordinal":75728,"en":"Let me repent before Allah;"},{"id":"manas-2010:p1762:b001:l015","ordinal":75729,"en":"Until my appointed due draws near,"},{"id":"manas-2010:p1762:b001:l016","ordinal":75730,"en":"Let me take comfort in it."},{"id":"manas-2010:p1762:b001:l017","ordinal":75731,"en":"When the angel firmly lays on his five hands,"},{"id":"manas-2010:p1762:b001:l018","ordinal":75732,"en":"Only then shall I let it be."},{"id":"manas-2010:p1762:b001:l019","ordinal":75733,"en":"Until my entrusted life departs,"},{"id":"manas-2010:p1762:b001:l020","ordinal":75734,"en":"Until my death comes directly,"},{"id":"manas-2010:p1762:b001:l021","ordinal":75735,"en":"The living musket Akkelte,"},{"id":"manas-2010:p1762:b001:l022","ordinal":75736,"en":"Lay it beside me;"},{"id":"manas-2010:p1762:b001:l023","ordinal":75737,"en":"Let me take comfort in that."},{"id":"manas-2010:p1762:b001:l024","ordinal":75738,"en":"The gray leather belt descended from heaven,"},{"id":"manas-2010:p1762:b001:l025","ordinal":75739,"en":"The belt that befriends dear life,"},{"id":"manas-2010:p1762:b001:l026","ordinal":75740,"en":"When I myself reached eleven,"},{"id":"manas-2010:p1762:b001:l027","ordinal":75741,"en":"‘Bind this about your waist,’"},{"id":"manas-2010:p1762:b001:l028","ordinal":75742,"en":"Father Aykojo said as he gave it."},{"id":"manas-2010:p1762:b001:l029","ordinal":75743,"en":"The face of the earth stirred;"},{"id":"manas-2010:p1762:b001:l030","ordinal":75744,"en":"Every living soul stood still."},{"id":"manas-2010:p1762:b001:l031","ordinal":75745,"en":"Aykojo, who gave the belt,"},{"id":"manas-2010:p1762:b001:l032","ordinal":75746,"en":"Vanished unseen from sight."},{"id":"manas-2010:p1762:b001:l033","ordinal":75747,"en":"When I entered a desperate battle,"},{"id":"manas-2010:p1762:b001:l034","ordinal":75748,"en":"When I shouted and bound it at my waist,"},{"id":"manas-2010:p1762:b001:l035","ordinal":75749,"en":"The forty hidden saints became my companions."},{"id":"manas-2010:p1762:b001:l036","ordinal":75750,"en":"When I saw a hostile foe,"},{"id":"manas-2010:p1762:b001:l037","ordinal":75751,"en":"When I girded it in fury,"},{"id":"manas-2010:p1762:b001:l038","ordinal":75752,"en":"A black-spotted leopard"},{"id":"manas-2010:p1762:b001:l039","ordinal":75753,"en":"Raged beside my flank."},{"id":"manas-2010:p1762:b001:l040","ordinal":75754,"en":"When I shouted and bound it at my waist,"},{"id":"manas-2010:p1762:b001:l041","ordinal":75755,"en":"A short-tailed lion"},{"id":"manas-2010:p1762:b001:l042","ordinal":75756,"en":"Prepared at my side."},{"id":"manas-2010:p1763:b001:l001","ordinal":75757,"en":"The gray leather belt descended from heaven,"},{"id":"manas-2010:p1763:b001:l002","ordinal":75758,"en":"The belt that befriends my life—"},{"id":"manas-2010:p1763:b001:l003","ordinal":75759,"en":"Those who knew told the tale:"},{"id":"manas-2010:p1763:b001:l004","ordinal":75760,"en":"It came from the unseen,"},{"id":"manas-2010:p1763:b001:l005","ordinal":75761,"en":"Found through God's love."},{"id":"manas-2010:p1763:b001:l006","ordinal":75762,"en":"‘A belt descended from heaven,’ they said."},{"id":"manas-2010:p1763:b001:l007","ordinal":75763,"en":"The ignorant, who did not know, said:"},{"id":"manas-2010:p1763:b001:l008","ordinal":75764,"en":"‘When he oppressed Kokand,"},{"id":"manas-2010:p1763:b001:l009","ordinal":75765,"en":"When he conquered Marghilan,"},{"id":"manas-2010:p1763:b001:l010","ordinal":75766,"en":"He imprisoned the dervish,"},{"id":"manas-2010:p1763:b001:l011","ordinal":75767,"en":"He beat the wandering holy man."},{"id":"manas-2010:p1763:b001:l012","ordinal":75768,"en":"Driving white deer as cattle,"},{"id":"manas-2010:p1763:b001:l013","ordinal":75769,"en":"Throwing the earth into uproar,"},{"id":"manas-2010:p1763:b001:l014","ordinal":75770,"en":"Then he seized the belt by force.’"},{"id":"manas-2010:p1763:b001:l015","ordinal":75771,"en":"So spoke the ignorant, who did not know."},{"id":"manas-2010:p1763:b001:l016","ordinal":75772,"en":"Kanykey, hang it close beside me!"},{"id":"manas-2010:p1763:b001:l017","ordinal":75773,"en":"The great Quran brought from Mecca,"},{"id":"manas-2010:p1763:b001:l018","ordinal":75774,"en":"My lady, place it beneath my head!"},{"id":"manas-2010:p1763:b001:l019","ordinal":75775,"en":"The six keen blades descended from heaven,"},{"id":"manas-2010:p1763:b001:l020","ordinal":75776,"en":"The very finest swords:"}]
