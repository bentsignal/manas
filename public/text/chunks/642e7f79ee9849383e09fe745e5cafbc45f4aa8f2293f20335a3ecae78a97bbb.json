p0748:b003:l014","ordinal":351464,"en":"I cried in anger,"},{"id":"seytek-2012:p0748:b003:l015","ordinal":351465,"en":"I will slaughter your people."},{"id":"seytek-2012:p0748:b003:l016","ordinal":351466,"en":"Cheers to Kyrgyz"},{"id":"seytek-2012:p0748:b003:l017","ordinal":351467,"en":"I will correct it."},{"id":"seytek-2012:p0748:b003:l018","ordinal":351468,"en":"I'm mad at Olukma,"},{"id":"seytek-2012:p0748:b003:l019","ordinal":351469,"en":"I will do one for Kyrgyz."},{"id":"seytek-2012:p0748:b003:l020","ordinal":351470,"en":"If I don't hold tight,"},{"id":"seytek-2012:p0748:b003:l021","ordinal":351471,"en":"If I don't get what I want,"},{"id":"seytek-2012:p0748:b003:l022","ordinal":351472,"en":"My father is a monster"},{"id":"seytek-2012:p0748:b003:l023","ordinal":351473,"en":"If I don't get angry like this."},{"id":"seytek-2012:p0748:b003:l024","ordinal":351474,"en":"Let me die without being poor,"},{"id":"seytek-2012:p0748:b003:l025","ordinal":351475,"en":"It's really summer"},{"id":"seytek-2012:p0748:b003:l026","ordinal":351476,"en":"Let me see when I have courage."},{"id":"seytek-2012:p0748:b003:l027","ordinal":351477,"en":"If I don't put my mind to it,"},{"id":"seytek-2012:p0748:b003:l028","ordinal":351478,"en":"Fight till the end"},{"id":"seytek-2012:p0748:b003:l029","ordinal":351479,"en":"If I don't hold a grudge against my father."},{"id":"seytek-2012:p0748:b003:l030","ordinal":351480,"en":"The one that came out of Zelpinish,"},{"id":"seytek-2012:p0748:b003:l031","ordinal":351481,"en":"The horse squeals on the ground,"},{"id":"seytek-2012:p0748:b003:l032","ordinal":351482,"en":"Take loot from anywhere"},{"id":"seytek-2012:p0748:b003:l033","ordinal":351483,"en":"The frozen mountain passes,"},{"id":"seytek-2012:p0748:b003:l034","ordinal":351484,"en":"I will punch your heart,"},{"id":"seytek-2012:p0748:b003:l035","ordinal":351485,"en":"Such is my courage,"},{"id":"seytek-2012:p0748:b003:l036","ordinal":351486,"en":"To your waist,"},{"id":"seytek-2012:p0748:b003:l037","ordinal":351487,"en":"If I have trouble swallowing,"},{"id":"seytek-2012:p0748:b003:l038","ordinal":351488,"en":"Greetings to your people."}]
