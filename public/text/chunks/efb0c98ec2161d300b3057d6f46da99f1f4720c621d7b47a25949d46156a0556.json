[{"id":"seytek-2012:p0028:b003:l008","ordinal":296193,"en":"Tears fell one after another;"},{"id":"seytek-2012:p0028:b003:l009","ordinal":296194,"en":"From her currant-dark eyes,"},{"id":"seytek-2012:p0028:b003:l010","ordinal":296195,"en":"As the wretched woman trembled,"},{"id":"seytek-2012:p0028:b003:l011","ordinal":296196,"en":"Tears fell a whip’s length."},{"id":"seytek-2012:p0028:b003:l012","ordinal":296197,"en":"Unable to gather and steady her thoughts,"},{"id":"seytek-2012:p0028:b003:l013","ordinal":296198,"en":"She wept in anguish from her sorrow"},{"id":"seytek-2012:p0028:b003:l014","ordinal":296199,"en":"And could not even draw back the mucus from her nose."},{"id":"seytek-2012:p0028:b003:l015","ordinal":296200,"en":"As the distraught woman lamented,"},{"id":"seytek-2012:p0028:b003:l016","ordinal":296201,"en":"Her joints loosened and came apart;"},{"id":"seytek-2012:p0028:b003:l017","ordinal":296202,"en":"Brave Kyyaz of the Jediger"},{"id":"seytek-2012:p0028:b003:l018","ordinal":296203,"en":"Appeared before her eyes"},{"id":"seytek-2012:p0028:b003:l019","ordinal":296204,"en":"Like a ravenous monster."},{"id":"seytek-2012:p0028:b003:l020","ordinal":296205,"en":"The golden doorway and gate"},{"id":"seytek-2012:p0028:b003:l021","ordinal":296206,"en":"Had panels of solid tin."},{"id":"seytek-2012:p0028:b003:l022","ordinal":296207,"en":"As for the approach to Khan Kyyaz,"},{"id":"seytek-2012:p0028:b003:l023","ordinal":296208,"en":"The looming figure’s"},{"id":"seytek-2012:p0028:b003:l024","ordinal":296209,"en":"Appearance was like this:"},{"id":"seytek-2012:p0028:b003:l025","ordinal":296210,"en":"Within the white palace,"},{"id":"seytek-2012:p0028:b003:l026","ordinal":296211,"en":"Beside the dark spring,"},{"id":"seytek-2012:p0028:b003:l027","ordinal":296212,"en":"Right by the plane tree,"},{"id":"seytek-2012:p0028:b003:l028","ordinal":296213,"en":"Surrounded by a fortress of lions—"},{"id":"seytek-2012:p0028:b003:l029","ordinal":296214,"en":"Who among humankind had ever possessed such things?"},{"id":"seytek-2012:p0028:b003:l030","ordinal":296215,"en":"Your radiant Chürök,"},{"id":"seytek-2012:p0028:b003:l031","ordinal":296216,"en":"Your formidable wonder,"},{"id":"seytek-2012:p0028:b003:l032","ordinal":296217,"en":"Your moon-beautiful wife,"},{"id":"seytek-2012:p0028:b003:l033","ordinal":296218,"en":"Your infidel rich in wisdom,"},{"id":"seytek-2012:p0028:b003:l034","ordinal":296219,"en":"Had grown old among the people, keeping the nation,"},{"id":"seytek-2012:p0028:b003:l035","ordinal":296220,"en":"And become renowned."},{"id":"seytek-2012:p0028:b003:l036","ordinal":296221,"en":"Without shame she had Mother Umai Zuura"},{"id":"seytek-2012:p0028:b003:l037","ordinal":296222,"en":"Set her womb aright,"},{"id":"seytek-2012:p0028:b003:l038","ordinal":296223,"en":"And, letting no one suspect,"},{"id":"seytek-2012:p0028:b003:l039","ordinal":296224,"en":"The distraught woman labored for seven days,"},{"id":"seytek-2012:p0028:b003:l040","ordinal":296225,"en":"Spending her frail, fly-like life."},{"id":"seytek-2012:p0030:b002:l001","ordinal":296226,"en":"From atop that tower"},{"id":"seytek-2012:p0030:b002:l002","ordinal":296227,"en":"She called out to all the assembled people."},{"id":"seytek-2012:p0030:b002:l003","ordinal":296228,"en":"“Surging hosts of the Jediger,"},{"id":"seytek-2012:p0030:b002:l004","ordinal":296229,"en":"Come, all of you!” she cried."},{"id":"seytek-2012:p0030:b002:l005","ordinal":296230,"en":"“Great dark host of the Jediger,"},{"id":"seytek-2012:p0030:b002:l006","ordinal":296231,"en":"The khan’s doorway is like Judgment Day;"},{"id":"seytek-2012:p0030:b002:l007","ordinal":296232,"en":"We need a way to pass through it."},{"id":"seytek-2012:p0030:b002:l008","ordinal":296233,"en":"The khan’s heart is massive iron;"},{"id":"seytek-2012:p0030:b002:l009","ordinal":296234,"en":"We need a way to melt it."},{"id":"seytek-2012:p0030:b002:l010","ordinal":296235,"en":"Let the renowned Jediger people"},{"id":"seytek-2012:p0030:b002:l011","ordinal":296236,"en":"Take counsel two by two."},{"id":"seytek-2012:p0030:b002:l012","ordinal":296237,"en":"Now, what do you say?"},{"id":"seytek-2012:p0030:b002:l013","ordinal":296238,"en":"Behold this dreadful matter:"},{"id":"seytek-2012:p0030:b002:l014","ordinal":296239,"en":"The tormented, ill-fated woman"},{"id":"seytek-2012:p0030:b002:l015","ordinal":296240,"en":"Has fallen into grievous labor;"},{"id":"seytek-2012:p0030:b002:l016","ordinal":296241,"en":"Come and judge her suffering."},{"id":"seytek-2012:p0030:b002:l017","ordinal":296242,"en":"Come, elders grown old among the people,"},{"id":"seytek-2012:p0030:b002:l018","ordinal":296243,"en":"All you long-eared men of wide experience"},{"id":"seytek-2012:p0030:b002:l019","ordinal":296244,"en":"Who understand the words you hear."},{"id":"seytek-2012:p0030:b002:l020","ordinal":296245,"en":"Come, you who calculate the months,"},{"id":"seytek-2012:p0030:b002:l021","ordinal":296246,"en":"You who reckon the lunar count;"},{"id":"seytek-2012:p0030:b002:l022","ordinal":296247,"en":"Come, men skilled in calculation,"},{"id":"seytek-2012:p0030:b002:l023","ordinal":296248,"en":"And hear the question I shall pose."},{"id":"seytek-2012:p0030:b002:l024","ordinal":296249,"en":"If Aichürök, Akun’s daughter,"},{"id":"seytek-2012:p0030:b002:l025","ordinal":296250,"en":"Should suddenly bear a child,"},{"id":"seytek-2012:p0030:b002:l026","ordinal":296251,"en":"Whose will it be? Consider!"},{"id":"seytek-2012:p0030:b002:l027","ordinal":296252,"en":"If moonlike Chürök"},{"id":"seytek-2012:p0030:b002:l028","ordinal":296253,"en":"Bears a child today,"},{"id":"seytek-2012:p0030:b002:l029","ordinal":296254,"en":"Whose will it be? Consider!”"},{"id":"seytek-2012:p0030:b002:l030","ordinal":296255,"en":"When the Jediger heard this,"},{"id":"seytek-2012:p0030:b002:l031","ordinal":296256,"en":"They set down the days in writing"},{"id":"seytek-2012:p0030:b002:l032","ordinal":296257,"en":"And made their reckoning of them."},{"id":"seytek-2012:p0030:b002:l033","ordinal":296258,"en":"Then they set down the months"},{"id":"seytek-2012:p0030:b002:l034","ordinal":296259,"en":"And calculated their count."},{"id":"seytek-2012:p0030:b002:l035","ordinal":296260,"en":"The shrewd and skillful elders,"},{"id":"seytek-2012:p0030:b002:l036","ordinal":296261,"en":"Like men struck by slaughter,"},{"id":"seytek-2012:p0030:b002:l037","ordinal":296262,"en":"The hard-pressed Jediger,"},{"id":"seytek-2012:p0030:b002:l038","ordinal":296263,"en":"All seethed with agitation."},{"id":"seytek-2012:p0030:b002:l039","ordinal":296264,"en":"In the marsh of Üyrülmö Hill,"},{"id":"seytek-2012:p0030:b002:l040","ordinal":296265,"en":"They held council for three days."},{"id":"seytek-2012:p0030:b003:l001","ordinal":296266,"en":"A great reverberation struck the earth;"},{"id":"seytek-2012:p0030:b003:l002","ordinal":296267,"en":"Stars appeared one by one overhead,"},{"id":"seytek-2012:p0030:b003:l003","ordinal":296268,"en":"And light quivered upon the ground."},{"id":"seytek-2012:p0030:b003:l004","ordinal":296269,"en":"Stars flashed in the heavens,"},{"id":"seytek-2012:p0030:b003:l005","ordinal":296270,"en":"Cries rang toward the qibla,"},{"id":"seytek-2012:p0030:b003:l006","ordinal":296271,"en":"The bitter wind before dawn whistled,"},{"id":"seytek-2012:p0030:b003:l007","ordinal":296272,"en":"The reed tops rattled,"},{"id":"seytek-2012:p0030:b003:l008","ordinal":296273,"en":"And fledgling larks clamored."},{"id":"seytek-2012:p0030:b003:l009","ordinal":296274,"en":"Full daylight touched the earth,"},{"id":"seytek-2012:p0030:b003:l010","ordinal":296275,"en":"And the radiant dawn advanced."},{"id":"seytek-2012:p0030:b003:l011","ordinal":296276,"en":"Every beast and living creature"},{"id":"seytek-2012:p0030:b003:l012","ordinal":296277,"en":"Raised a clamor from the earth;"},{"id":"seytek-2012:p0030:b003:l013","ordinal":296278,"en":"Upon every mountaintop,"},{"id":"seytek-2012:p0030:b003:l014","ordinal":296279,"en":"Radiance poured as the sun rose."},{"id":"seytek-2012:p0030:b003:l015","ordinal":296280,"en":"From the palace in the tower,"},{"id":"seytek-2012:p0030:b003:l016","ordinal":296281,"en":"Holding a golden staff,"},{"id":"seytek-2012:p0030:b003:l017","ordinal":296282,"en":"Waving her white kerchief,"},{"id":"seytek-2012:p0030:b003:l018","ordinal":296283,"en":"Wrapped in a loose fur coat,"},{"id":"seytek-2012:p0030:b003:l019","ordinal":296284,"en":"The unfortunate woman walked with measured grace,"},{"id":"seytek-2012:p0030:b003:l020","ordinal":296285,"en":"Imploring the Creator."},{"id":"seytek-2012:p0030:b003:l021","ordinal":296286,"en":"Within the tower with its threshold,"},{"id":"seytek-2012:p0030:b003:l022","ordinal":296287,"en":"The helpless, ill-fated woman"},{"id":"seytek-2012:p0030:b003:l023","ordinal":296288,"en":"Stood in true labor."},{"id":"seytek-2012:p0030:b003:l024","ordinal":296289,"en":"Mountainous Kyyaz now saw"},{"id":"seytek-2012:p0030:b003:l025","ordinal":296290,"en":"Your sister-in-law’s travail."},{"id":"seytek-2012:p0030:b003:l026","ordinal":296291,"en":"Seeing it, brave Kyyaz"},{"id":"seytek-2012:p0030:b003:l027","ordinal":296292,"en":"Prepared himself like a hawk;"},{"id":"seytek-2012:p0030:b003:l028","ordinal":296293,"en":"An idea from the unseen"},{"id":"seytek-2012:p0030:b003:l029","ordinal":296294,"en":"Came to brave Kyyaz."},{"id":"seytek-2012:p0030:b003:l030","ordinal":296295,"en":"Rumbling in fury,"},{"id":"seytek-2012:p0030:b003:l031","ordinal":296296,"en":"He addressed the great dark host of the Jediger:"},{"id":"seytek-2012:p0030:b003:l032","ordinal":296297,"en":"“Assemble before the khan!”"},{"id":"seytek-2012:p0030:b003:l033","ordinal":296298,"en":"Khan Kyyaz began to rage."},{"id":"seytek-2012:p0030:b003:l034","ordinal":296299,"en":"When they saw Khan Kyyaz’s wrath,"},{"id":"seytek-2012:p0030:b003:l035","ordinal":296300,"en":"The Jediger acted as though an enemy had come;"},{"id":"seytek-2012:p0030:b003:l036","ordinal":296301,"en":"Crying, “May our people’s road be fortunate!”"},{"id":"seytek-2012:p0030:b003:l037","ordinal":296302,"en":"They scattered in fright."},{"id":"seytek-2012:p0030:b003:l038","ordinal":296303,"en":"The tower was the emblem of the khan—"},{"id":"seytek-2012:p0030:b003:l039","ordinal":296304,"en":"Ask no more about that tower:"},{"id":"seytek-2012:p0030:b003:l040","ordinal":296305,"en":"Its full height was magnificent."},{"id":"seytek-2012:p0031:b002:l001","ordinal":296306,"en":"Seeing him would set the heart at ease,"},{"id":"seytek-2012:p0031:b002:l002","ordinal":296307,"en":"Saying, “A son born of a khan,”"},{"id":"seytek-2012:p0031:b002:l003","ordinal":296308,"en":"Looking upon him would satisfy my blood,"},{"id":"seytek-2012:p0031:b002:l004","ordinal":296309,"en":"We have made him our ward and have no regrets."},{"id":"seytek-2012:p0031:b002:l005","ordinal":296310,"en":"If he matures into a hero,"},{"id":"seytek-2012:p0031:b002:l006","ordinal":296311,"en":"If he becomes the equal of heroic sons,"},{"id":"seytek-2012:p0031:b002:l007","ordinal":296312,"en":"We shall give him the throne and make him khan,"},{"id":"seytek-2012:p0031:b002:l008","ordinal":296313,"en":"And make him a worthy hero,"},{"id":"seytek-2012:p0031:b002:l009","ordinal":296314,"en":"We shall take shelter in him"},{"id":"seytek-2012:p0031:b002:l010","ordinal":296315,"en":"When this child grows up."},{"id":"seytek-2012:p0031:b002:l011","ordinal":296316,"en":"He will reach Afghanistan and lay it waste;"},{"id":"seytek-2012:p0031:b002:l012","ordinal":296317,"en":"How could Jet-Kait escape unharmed?"},{"id":"seytek-2012:p0031:b002:l013","ordinal":296318,"en":"They will don armor no arrow can pierce,"},{"id":"seytek-2012:p0031:b002:l014","ordinal":296319,"en":"And attack a people"},{"id":"seytek-2012:p0031:b002:l015","ordinal":296320,"en":"No man has heard of or seen."},{"id":"seytek-2012:p0031:b002:l016","ordinal":296321,"en":"They will journey to lands"},{"id":"seytek-2012:p0031:b002:l017","ordinal":296322,"en":"No ear has heard of and no nation has seen."},{"id":"seytek-2012:p0031:b002:l018","ordinal":296323,"en":"If your child survives,"},{"id":"seytek-2012:p0031:b002:l019","ordinal":296324,"en":"Firwood spears will clash,"},{"id":"seytek-2012:p0031:b002:l020","ordinal":296325,"en":"And wherever he strikes, war will rage."},{"id":"seytek-2012:p0031:b002:l021","ordinal":296326,"en":"If your son lives,"},{"id":"seytek-2012:p0031:b002:l022","ordinal":296327,"en":"The Jediger of Jeti-Özön"},{"id":"seytek-2012:p0031:b002:l023","ordinal":296328,"en":"Will reach the foe and feast on spoils."},{"id":"seytek-2012:p0031:b002:l024","ordinal":296329,"en":"Across the face of the earth"},{"id":"seytek-2012:p0031:b002:l025","ordinal":296330,"en":"He will be famed as Kyyaz’s son."},{"id":"seytek-2012:p0031:b002:l026","ordinal":296331,"en":"Our dream has turned out well:"},{"id":"seytek-2012:p0031:b002:l027","ordinal":296332,"en":"The captive woman will bear a son,"},{"id":"seytek-2012:p0031:b002:l028","ordinal":296333,"en":"And our cause will not fare badly."},{"id":"seytek-2012:p0031:b002:l029","ordinal":296334,"en":"The child this woman bears you"},{"id":"seytek-2012:p0031:b002:l030","ordinal":296335,"en":"Will have perfect fortune;"},{"id":"seytek-2012:p0031:b002:l031","ordinal":296336,"en":"The enemy who challenges him will be humbled."},{"id":"seytek-2012:p0031:b002:l032","ordinal":296337,"en":"His gaze will be a surging flood;"},{"id":"seytek-2012:p0031:b002:l033","ordinal":296338,"en":"Whoever grapples with him will be humbled."},{"id":"seytek-2012:p0031:b002:l034","ordinal":296339,"en":"The way he faces will blaze like fire;"},{"id":"seytek-2012:p0031:b002:l035","ordinal":296340,"en":"The enemy will halt without confronting him."},{"id":"seytek-2012:p0031:b002:l036","ordinal":296341,"en":"He will be a flame burning on the mountain pass;"},{"id":"seytek-2012:p0031:b002:l037","ordinal":296342,"en":"Without confronting him, the enemy"},{"id":"seytek-2012:p0031:b002:l038","ordinal":296343,"en":"Will halt!"},{"id":"seytek-2012:p0031:b002:l039","ordinal":296344,"en":"If your child survives,"},{"id":"seytek-2012:p0031:b002:l040","ordinal":296345,"en":"See what his valor will be:"},{"id":"seytek-2012:p0031:b003:l001","ordinal":296346,"en":"In the marshes of Chogulma"},{"id":"seytek-2012:p0031:b003:l002","ordinal":296347,"en":"They had gathered together."},{"id":"seytek-2012:p0031:b003:l003","ordinal":296348,"en":"They recorded the days,"},{"id":"seytek-2012:p0031:b003:l004","ordinal":296349,"en":"Saying, “This is the count of days,”"},{"id":"seytek-2012:p0031:b003:l005","ordinal":296350,"en":"And vied in calculation."},{"id":"seytek-2012:p0031:b003:l006","ordinal":296351,"en":"They recorded the months,"},{"id":"seytek-2012:p0031:b003:l007","ordinal":296352,"en":"Saying, “This is the count of months,”"},{"id":"seytek-2012:p0031:b003:l008","ordinal":296353,"en":"And disputed among themselves."},{"id":"seytek-2012:p0031:b003:l009","ordinal":296354,"en":"They reckoned the count of days"},{"id":"seytek-2012:p0031:b003:l010","ordinal":296355,"en":"And entered the days in writing."},{"id":"seytek-2012:p0031:b003:l011","ordinal":296356,"en":"They reckoned the count of months"},{"id":"seytek-2012:p0031:b003:l012","ordinal":296357,"en":"And learned the truth for certain."},{"id":"seytek-2012:p0031:b003:l013","ordinal":296358,"en":"Speaking softly but firmly,"},{"id":"seytek-2012:p0031:b003:l014","ordinal":296359,"en":"Bearded hero Kutu"},{"id":"seytek-2012:p0031:b003:l015","ordinal":296360,"en":"Began to address brave Kyyaz:"},{"id":"seytek-2012:p0031:b003:l016","ordinal":296361,"en":"“When we count the months,"},{"id":"seytek-2012:p0031:b003:l017","ordinal":296362,"en":"A full twelve months have passed;"},{"id":"seytek-2012:p0031:b003:l018","ordinal":296363,"en":"The child the woman is to bear"},{"id":"seytek-2012:p0031:b003:l019","ordinal":296364,"en":"Is truly your own child."},{"id":"seytek-2012:p0031:b003:l020","ordinal":296365,"en":"When the woman gives birth,"},{"id":"seytek-2012:p0031:b003:l021","ordinal":296366,"en":"Slaughter ninety beasts for the feast"},{"id":"seytek-2012:p0031:b003:l022","ordinal":296367,"en":"And give the child a fitting name."},{"id":"seytek-2012:p0031:b003:l023","ordinal":296368,"en":"Let your heart know no doubt:"},{"id":"seytek-2012:p0031:b003:l024","ordinal":296369,"en":"Truly, the child sprung from your loins"},{"id":"seytek-2012:p0031:b003:l025","ordinal":296370,"en":"Is your own."},{"id":"seytek-2012:p0031:b003:l026","ordinal":296371,"en":"If it is a son,"},{"id":"seytek-2012:p0031:b003:l027","ordinal":296372,"en":"Choose the finest of all names."},{"id":"seytek-2012:p0031:b003:l028","ordinal":296373,"en":"Saying, ‘Kyyaz has gained a child,’"},{"id":"seytek-2012:p0031:b003:l029","ordinal":296374,"en":"Wash away every last sorrow"},{"id":"seytek-2012:p0031:b003:l030","ordinal":296375,"en":"From your heart."},{"id":"seytek-2012:p0031:b003:l031","ordinal":296376,"en":"If a fierce enemy host should come,"},{"id":"seytek-2012:p0031:b003:l032","ordinal":296377,"en":"We shall set him against them,"},{"id":"seytek-2012:p0031:b003:l033","ordinal":296378,"en":"And make him our war club."},{"id":"seytek-2012:p0031:b003:l034","ordinal":296379,"en":"We shall make him master among the people,"},{"id":"seytek-2012:p0031:b003:l035","ordinal":296380,"en":"A giant among the Jediger nation,"},{"id":"seytek-2012:p0031:b003:l036","ordinal":296381,"en":"And take him as our champion ram."},{"id":"seytek-2012:p0031:b003:l037","ordinal":296382,"en":"If his daily fortunes prosper"},{"id":"seytek-2012:p0031:b003:l038","ordinal":296383,"en":"And he grows greater day by day,"},{"id":"seytek-2012:p0031:b003:l039","ordinal":296384,"en":"Like that towering mountain,"},{"id":"seytek-2012:p0031:b003:l040","ordinal":296385,"en":"We shall make him our mighty bulwark."},{"id":"seytek-2012:p0032:b002:l001","ordinal":296386,"en":"Saying, ‘Now he has come of age,’"},{"id":"seytek-2012:p0032:b002:l002","ordinal":296387,"en":"Heed these words."},{"id":"seytek-2012:p0032:b002:l003","ordinal":296388,"en":"If a son is born, Jediger,"},{"id":"seytek-2012:p0032:b002:l004","ordinal":296389,"en":"Slaughter countless beasts for his feast,"},{"id":"seytek-2012:p0032:b002:l005","ordinal":296390,"en":"And put aside all such"},{"id":"seytek-2012:p0032:b002:l006","ordinal":296391,"en":"Slurred and foolish talk."},{"id":"seytek-2012:p0032:b002:l007","ordinal":296392,"en":"Let us strike down whoever goes astray;"},{"id":"seytek-2012:p0032:b002:l008","ordinal":296393,"en":"So none may babble slander,"},{"id":"seytek-2012:p0032:b002:l009","ordinal":296394,"en":"My people, let us lick"},{"id":"seytek-2012:p0032:b002:l010","ordinal":296395,"en":"The edge of the sword!”"},{"id":"seytek-2012:p0032:b002:l011","ordinal":296396,"en":"They kissed the bullets and swore an oath."},{"id":"seytek-2012:p0032:b002:l012","ordinal":296397,"en":"When the Jediger heard this, they said:"},{"id":"seytek-2012:p0032:b002:l013","ordinal":296398,"en":"“Enough, warrior Kutu,"},{"id":"seytek-2012:p0032:b002:l014","ordinal":296399,"en":"What you say is sound counsel."},{"id":"seytek-2012:p0032:b002:l015","ordinal":296400,"en":"May the seven forefathers of anyone"},{"id":"seytek-2012:p0032:b002:l016","ordinal":296401,"en":"Who disobeys you be infidels."},{"id":"seytek-2012:p0032:b002:l017","ordinal":296402,"en":"Do not babble, Jediger;"},{"id":"seytek-2012:p0032:b002:l018","ordinal":296403,"en":"Our father Kutu’s words"},{"id":"seytek-2012:p0032:b002:l019","ordinal":296404,"en":"Are wisdom.”"},{"id":"seytek-2012:p0032:b002:l020","ordinal":296405,"en":"All manner of men live among a people;"},{"id":"seytek-2012:p0032:b002:l021","ordinal":296406,"en":"If someone should suddenly babble,"},{"id":"seytek-2012:p0032:b002:l022","ordinal":296407,"en":"Or rave without warning,"},{"id":"seytek-2012:p0032:b002:l023","ordinal":296408,"en":"Let us beat him to pieces"},{"id":"seytek-2012:p0032:b002:l024","ordinal":296409,"en":"And punish him cruelly."},{"id":"seytek-2012:p0032:b002:l025","ordinal":296410,"en":"Let us ignore his pleas"},{"id":"seytek-2012:p0032:b002:l026","ordinal":296411,"en":"And gouge out his eyes in punishment."},{"id":"seytek-2012:p0032:b002:l027","ordinal":296412,"en":"Let us raid his mares from the pasture;"},{"id":"seytek-2012:p0032:b002:l028","ordinal":296413,"en":"One who spreads such idle talk"},{"id":"seytek-2012:p0032:b002:l029","ordinal":296414,"en":"May well have his wrath aroused.”"},{"id":"seytek-2012:p0032:b002:l030","ordinal":296415,"en":"The Jediger shouted and the people stirred,"},{"id":"seytek-2012:p0032:b002:l031","ordinal":296416,"en":"And they sealed their pledge."},{"id":"seytek-2012:p0032:b002:l032","ordinal":296417,"en":"After Kutu had spoken these words,"},{"id":"seytek-2012:p0032:b002:l033","ordinal":296418,"en":"The Jediger dispersed."},{"id":"seytek-2012:p0032:b002:l034","ordinal":296419,"en":"The people departed one by one,"},{"id":"seytek-2012:p0032:b002:l035","ordinal":296420,"en":"And the Jediger rode away."},{"id":"seytek-2012:p0032:b002:l036","ordinal":296421,"en":"While matters stood thus among the Jediger,"},{"id":"seytek-2012:p0032:b002:l037","ordinal":296422,"en":"The Jediger’s brave Kyyaz"},{"id":"seytek-2012:p0032:b002:l038","ordinal":296423,"en":"Was an extraordinary champion,"},{"id":"seytek-2012:p0032:b002:l039","ordinal":296424,"en":"Yet Kyyaz’s treachery"},{"id":"seytek-2012:p0032:b002:l040","ordinal":296425,"en":"Was as vast as Ala-Too."},{"id":"seytek-2012:p0032:b003:l001","ordinal":296426,"en":"He would weary those who fought him"},{"id":"seytek-2012:p0032:b003:l002","ordinal":296427,"en":"And make those who grappled with him crawl."},{"id":"seytek-2012:p0032:b003:l003","ordinal":296428,"en":"He would bewilder whoever met him"},{"id":"seytek-2012:p0032:b003:l004","ordinal":296429,"en":"And straighten whoever opposed him."},{"id":"seytek-2012:p0032:b003:l005","ordinal":296430,"en":"No man could face him."},{"id":"seytek-2012:p0032:b003:l006","ordinal":296431,"en":"If this son of yours survives,"},{"id":"seytek-2012:p0032:b003:l007","ordinal":296432,"en":"He will ride along the Sombuk River,"},{"id":"seytek-2012:p0032:b003:l008","ordinal":296433,"en":"And the man who contests him will crawl."},{"id":"seytek-2012:p0032:b003:l009","ordinal":296434,"en":"He will meet anyone who challenges him;"},{"id":"seytek-2012:p0032:b003:l010","ordinal":296435,"en":"If your son matures into a champion,"},{"id":"seytek-2012:p0032:b003:l011","ordinal":296436,"en":"Whoever clashes with him will crawl."},{"id":"seytek-2012:p0032:b003:l012","ordinal":296437,"en":"If he turns, strife will begin;"},{"id":"seytek-2012:p0032:b003:l013","ordinal":296438,"en":"Many who see him"},{"id":"seytek-2012:p0032:b003:l014","ordinal":296439,"en":"Will break ranks and flee."},{"id":"seytek-2012:p0032:b003:l015","ordinal":296440,"en":"When the child is old enough to play,"},{"id":"seytek-2012:p0032:b003:l016","ordinal":296441,"en":"Let us hang a sword from his neck."},{"id":"seytek-2012:p0032:b003:l017","ordinal":296442,"en":"Let no winged creature strike him,"},{"id":"seytek-2012:p0032:b003:l018","ordinal":296443,"en":"No beaked creature peck him;"},{"id":"seytek-2012:p0032:b003:l019","ordinal":296444,"en":"Let him drink from no dirty vessel"},{"id":"seytek-2012:p0032:b003:l020","ordinal":296445,"en":"And wear no soiled clothing."},{"id":"seytek-2012:p0032:b003:l021","ordinal":296446,"en":"Saying, “He is heroic Kyyaz’s son,"},{"id":"seytek-2012:p0032:b003:l022","ordinal":296447,"en":"Himself a manifest hero,”"},{"id":"seytek-2012:p0032:b003:l023","ordinal":296448,"en":"Let us cherish him as our protector."}]
