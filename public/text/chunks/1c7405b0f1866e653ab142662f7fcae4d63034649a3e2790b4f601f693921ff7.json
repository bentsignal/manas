[{"id":"semetey-1-2013:p1349:b003:l012","ordinal":179201,"en":"What the Creator has ordained;"},{"id":"semetey-1-2013:p1349:b003:l013","ordinal":179202,"en":"Fighting without sparing my life"},{"id":"semetey-1-2013:p1349:b003:l014","ordinal":179203,"en":"Against the teeming black Chinese,"},{"id":"semetey-1-2013:p1349:b003:l015","ordinal":179204,"en":"I am going forth to die."},{"id":"semetey-1-2013:p1349:b003:l016","ordinal":179205,"en":"Girding my waist firmly,"},{"id":"semetey-1-2013:p1349:b003:l017","ordinal":179206,"en":"I am going forth to subdue them."},{"id":"semetey-1-2013:p1349:b003:l018","ordinal":179207,"en":"I am going to pursue the great blood price"},{"id":"semetey-1-2013:p1349:b003:l019","ordinal":179208,"en":"Of my hero Syrgak."},{"id":"semetey-1-2013:p1349:b003:l020","ordinal":179209,"en":"I am going to enter"},{"id":"semetey-1-2013:p1349:b003:l021","ordinal":179210,"en":"The teeming khan's domain,"},{"id":"semetey-1-2013:p1349:b003:l022","ordinal":179211,"en":"And drive this way all the countless livestock"},{"id":"semetey-1-2013:p1349:b003:l023","ordinal":179212,"en":"Gathered as tribute,"},{"id":"semetey-1-2013:p1349:b003:l024","ordinal":179213,"en":"Taking them in a raid."},{"id":"semetey-1-2013:p1349:b003:l025","ordinal":179214,"en":"I am going to see"},{"id":"semetey-1-2013:p1349:b003:l026","ordinal":179215,"en":"What the Creator has ordained;"},{"id":"semetey-1-2013:p1349:b003:l027","ordinal":179216,"en":"For the sake of my hero father,"},{"id":"semetey-1-2013:p1349:b003:l028","ordinal":179217,"en":"Rather than remain alive in the world,"},{"id":"semetey-1-2013:p1349:b003:l029","ordinal":179218,"en":"I am going forth to die."},{"id":"semetey-1-2013:p1349:b003:l030","ordinal":179219,"en":"The land I face is Beijing;"},{"id":"semetey-1-2013:p1349:b003:l031","ordinal":179220,"en":"I will wage fierce war,"},{"id":"semetey-1-2013:p1349:b003:l032","ordinal":179221,"en":"Trample the black Kalmyks,"},{"id":"semetey-1-2013:p1349:b003:l033","ordinal":179222,"en":"And break apart their nest;"},{"id":"semetey-1-2013:p1349:b003:l034","ordinal":179223,"en":"I will tread upon the head"},{"id":"semetey-1-2013:p1349:b003:l035","ordinal":179224,"en":"Of lordly Kongurbay,"},{"id":"semetey-1-2013:p1349:b003:l036","ordinal":179225,"en":"And scatter the four kinds of livestock"},{"id":"semetey-1-2013:p1349:b003:l037","ordinal":179226,"en":"Of the chief who struck you from above."},{"id":"semetey-1-2013:p1349:b003:l038","ordinal":179227,"en":"I took courage and made ready;"},{"id":"semetey-1-2013:p1349:b003:l039","ordinal":179228,"en":"For black-Chinese Beijing,"},{"id":"semetey-1-2013:p1349:b004:l001","ordinal":179229,"en":"I have longed to fight."},{"id":"semetey-1-2013:p1349:b004:l002","ordinal":179230,"en":"If I travel toward the khan,"},{"id":"semetey-1-2013:p1349:b004:l003","ordinal":179231,"en":"And travel far, not a little,"},{"id":"semetey-1-2013:p1349:b004:l004","ordinal":179232,"en":"Why should I trouble"},{"id":"semetey-1-2013:p1349:b004:l005","ordinal":179233,"en":"My small Kyrgyz people and drive them as an army,"},{"id":"semetey-1-2013:p1349:b004:l006","ordinal":179234,"en":"Bringing them calamity,"},{"id":"semetey-1-2013:p1349:b004:l007","ordinal":179235,"en":"Making every one of them weep,"},{"id":"semetey-1-2013:p1349:b004:l008","ordinal":179236,"en":"Compelling them with cries"},{"id":"semetey-1-2013:p1349:b004:l009","ordinal":179237,"en":"That I am Manas's son?"},{"id":"semetey-1-2013:p1349:b004:l010","ordinal":179238,"en":"What inheritance would I attain?"},{"id":"semetey-1-2013:p1349:b004:l011","ordinal":179239,"en":"Against the teeming infidel,"},{"id":"semetey-1-2013:p1349:b004:l012","ordinal":179240,"en":"Against warrior Khan Kongurbay,"},{"id":"semetey-1-2013:p1349:b004:l013","ordinal":179241,"en":"I will go with four men."},{"id":"semetey-1-2013:p1349:b004:l014","ordinal":179242,"en":"To ride in the hot desert,"},{"id":"semetey-1-2013:p1349:b004:l015","ordinal":179243,"en":"And breach and enter"},{"id":"semetey-1-2013:p1349:b004:l016","ordinal":179244,"en":"The fortress of the fortified black Chinese,"},{"id":"semetey-1-2013:p1349:b004:l017","ordinal":179245,"en":"I will take fourteen horses from Ogoy"},{"id":"semetey-1-2013:p1349:b004:l018","ordinal":179246,"en":"And receive the old saint's blessing."},{"id":"semetey-1-2013:p1349:b004:l019","ordinal":179247,"en":"The warrior known to the people,"},{"id":"semetey-1-2013:p1349:b004:l020","ordinal":179248,"en":"Left by my royal elder, the lion,"},{"id":"semetey-1-2013:p1349:b004:l021","ordinal":179249,"en":"Is far-seeing Bakay."},{"id":"semetey-1-2013:p1349:b004:l022","ordinal":179250,"en":"I have my uncle Bakay,"},{"id":"semetey-1-2013:p1349:b004:l023","ordinal":179251,"en":"Sated with campaigns and roads,"},{"id":"semetey-1-2013:p1349:b004:l024","ordinal":179252,"en":"Who brought a calamity"},{"id":"semetey-1-2013:p1349:b004:l025","ordinal":179253,"en":"Upon Beijing."},{"id":"semetey-1-2013:p1349:b004:l026","ordinal":179254,"en":"My heroic uncle Bakay"},{"id":"semetey-1-2013:p1349:b004:l027","ordinal":179255,"en":"Is the waist I gird upon my own!"},{"id":"semetey-1-2013:p1349:b004:l028","ordinal":179256,"en":"My support, like a vast army to my soul,"},{"id":"semetey-1-2013:p1349:b004:l029","ordinal":179257,"en":"Master of roads and knower of lands,"},{"id":"semetey-1-2013:p1349:b004:l030","ordinal":179258,"en":"Is he not skillful Bakay,"},{"id":"semetey-1-2013:p1349:b004:l031","ordinal":179259,"en":"And in Beijing where battles were waged,"},{"id":"semetey-1-2013:p1349:b004:l032","ordinal":179260,"en":"Is he not renowned Bakay?"},{"id":"semetey-1-2013:p1349:b004:l033","ordinal":179261,"en":"My uncle Bakay who knows the road,"},{"id":"semetey-1-2013:p1349:b004:l034","ordinal":179262,"en":"My grandfather like a prophet,"},{"id":"semetey-1-2013:p1349:b004:l035","ordinal":179263,"en":"My uncle Bakay like a father,"},{"id":"semetey-1-2013:p1349:b004:l036","ordinal":179264,"en":"Who sits giving counsel,"},{"id":"semetey-1-2013:p1349:b004:l037","ordinal":179265,"en":"I will lead onto the road to Beijing,"},{"id":"semetey-1-2013:p1349:b004:l038","ordinal":179266,"en":"Whence no traveler returns—"},{"id":"semetey-1-2013:p1349:b004:l039","ordinal":179267,"en":"My tiger uncle Bakay."},{"id":"semetey-1-2013:p1350:b003:l001","ordinal":179268,"en":"My elder, wise old Bakay,"},{"id":"semetey-1-2013:p1350:b003:l002","ordinal":179269,"en":"My saint left above all others"},{"id":"semetey-1-2013:p1350:b003:l003","ordinal":179270,"en":"By my father Sultan Manas!"},{"id":"semetey-1-2013:p1350:b003:l004","ordinal":179271,"en":"My father's confidant,"},{"id":"semetey-1-2013:p1350:b003:l005","ordinal":179272,"en":"The eternal companion"},{"id":"semetey-1-2013:p1350:b003:l006","ordinal":179273,"en":"Of my lion father, the hero."},{"id":"semetey-1-2013:p1350:b003:l007","ordinal":179274,"en":"They shared death and shared life,"},{"id":"semetey-1-2013:p1350:b003:l008","ordinal":179275,"en":"Companions gathered in this world,"},{"id":"semetey-1-2013:p1350:b003:l009","ordinal":179276,"en":"Faithful companions sharing death."},{"id":"semetey-1-2013:p1350:b003:l010","ordinal":179277,"en":"When scouting, they shared one road;"},{"id":"semetey-1-2013:p1350:b003:l011","ordinal":179278,"en":"Entering battle, they shared one army."},{"id":"semetey-1-2013:p1350:b003:l012","ordinal":179279,"en":"Lion Sultan Bakay—"},{"id":"semetey-1-2013:p1350:b003:l013","ordinal":179280,"en":"I choose him and send him on the road."},{"id":"semetey-1-2013:p1350:b003:l014","ordinal":179281,"en":"Great Kalmyk Khan Kongurbay—"},{"id":"semetey-1-2013:p1350:b003:l015","ordinal":179282,"en":"If Almighty Allah supports me,"},{"id":"semetey-1-2013:p1350:b003:l016","ordinal":179283,"en":"I will raid his horses."},{"id":"semetey-1-2013:p1350:b003:l017","ordinal":179284,"en":"Yesterday, while my lion father lived,"},{"id":"semetey-1-2013:p1350:b003:l018","ordinal":179285,"en":"While the falcons remained safe,"},{"id":"semetey-1-2013:p1350:b003:l019","ordinal":179286,"en":"Butcher-prince Bakay—"},{"id":"semetey-1-2013:p1350:b003:l020","ordinal":179287,"en":"Was he not the uncle who went there?"},{"id":"semetey-1-2013:p1350:b003:l021","ordinal":179288,"en":"Calamity upon the khan—"},{"id":"semetey-1-2013:p1350:b003:l022","ordinal":179289,"en":"Was he not the uncle who brought it?"},{"id":"semetey-1-2013:p1350:b003:l023","ordinal":179290,"en":"Gathering tribute from Beijing,"},{"id":"semetey-1-2013:p1350:b003:l024","ordinal":179291,"en":"Was it not Bakay who took it?"},{"id":"semetey-1-2013:p1350:b003:l025","ordinal":179292,"en":"The gloomy city of Tüp-Beijing—"},{"id":"semetey-1-2013:p1350:b003:l026","ordinal":179293,"en":"Was it not Bakay who besieged it?"},{"id":"semetey-1-2013:p1350:b003:l027","ordinal":179294,"en":"Of Beijing's Manchu Chinese,"},{"id":"semetey-1-2013:p1350:b003:l028","ordinal":179295,"en":"Their strong men in armored coats,"},{"id":"semetey-1-2013:p1350:b003:l029","ordinal":179296,"en":"Their bald men who girded stones—"},{"id":"semetey-1-2013:p1350:b003:l030","ordinal":179297,"en":"Was it not Bakay who beat them?"},{"id":"semetey-1-2013:p1350:b003:l031","ordinal":179298,"en":"Riding a courser and grasping the banner,"},{"id":"semetey-1-2013:p1350:b003:l032","ordinal":179299,"en":"Was it not Bakay who went forth?"},{"id":"semetey-1-2013:p1350:b003:l033","ordinal":179300,"en":"Was it not Bakay who fought six months without cease"},{"id":"semetey-1-2013:p1350:b003:l034","ordinal":179301,"en":"And drove them before him"},{"id":"semetey-1-2013:p1350:b003:l035","ordinal":179302,"en":"While lion Manas lived?"},{"id":"semetey-1-2013:p1350:b003:l036","ordinal":179303,"en":"Was it not Bakay who brought"},{"id":"semetey-1-2013:p1350:b003:l037","ordinal":179304,"en":"True slaughter upon the khan,"},{"id":"semetey-1-2013:p1350:b003:l038","ordinal":179305,"en":"In the days of true Manas,"},{"id":"semetey-1-2013:p1350:b003:l039","ordinal":179306,"en":"The golden throne ridden by Chylava—"},{"id":"semetey-1-2013:p1350:b004:l001","ordinal":179307,"en":"Truly entering Beijing,"},{"id":"semetey-1-2013:p1350:b004:l002","ordinal":179308,"en":"Was it not Bakay who seized it?"},{"id":"semetey-1-2013:p1350:b004:l003","ordinal":179309,"en":"Armor that no bullet could pierce—"},{"id":"semetey-1-2013:p1350:b004:l004","ordinal":179310,"en":"Was it not Bakay who wore it?"},{"id":"semetey-1-2013:p1350:b004:l005","ordinal":179311,"en":"The teeming infidel,"},{"id":"semetey-1-2013:p1350:b004:l006","ordinal":179312,"en":"Warrior Khan Kongurbay—"},{"id":"semetey-1-2013:p1350:b004:l007","ordinal":179313,"en":"Was it not Bakay who surveyed their land"},{"id":"semetey-1-2013:p1350:b004:l008","ordinal":179314,"en":"And traveled knowing it well?"},{"id":"semetey-1-2013:p1350:b004:l009","ordinal":179315,"en":"The road to Beijing has five branches;"},{"id":"semetey-1-2013:p1350:b004:l010","ordinal":179316,"en":"Marking and distinguishing them all,"},{"id":"semetey-1-2013:p1350:b004:l011","ordinal":179317,"en":"Was it not Bakay who knew them?"},{"id":"semetey-1-2013:p1350:b004:l012","ordinal":179318,"en":"The blue courser's head—"},{"id":"semetey-1-2013:p1350:b004:l013","ordinal":179319,"en":"Was it not Bakay who once turned it?"},{"id":"semetey-1-2013:p1350:b004:l014","ordinal":179320,"en":"Thrusting his spear into the many foes,"},{"id":"semetey-1-2013:p1350:b004:l015","ordinal":179321,"en":"Was it not Bakay who stood?"},{"id":"semetey-1-2013:p1350:b004:l016","ordinal":179322,"en":"Shattering those who opposed him,"},{"id":"semetey-1-2013:p1350:b004:l017","ordinal":179323,"en":"Was it not Bakay who slaughtered them?"},{"id":"semetey-1-2013:p1350:b004:l018","ordinal":179324,"en":"When bows poured arrows like rain"},{"id":"semetey-1-2013:p1350:b004:l019","ordinal":179325,"en":"And guns fired bullets like hail,"},{"id":"semetey-1-2013:p1350:b004:l020","ordinal":179326,"en":"Was it not Bakay who stood unmoving"},{"id":"semetey-1-2013:p1350:b004:l021","ordinal":179327,"en":"Beneath the banner?"},{"id":"semetey-1-2013:p1350:b004:l022","ordinal":179328,"en":"Beijing's daughter as tribute—"},{"id":"semetey-1-2013:p1350:b004:l023","ordinal":179329,"en":"Was it not Bakay who took her?"},{"id":"semetey-1-2013:p1350:b004:l024","ordinal":179330,"en":"While his dear Manas lived,"},{"id":"semetey-1-2013:p1350:b004:l025","ordinal":179331,"en":"Slaughter upon those who challenged them—"},{"id":"semetey-1-2013:p1350:b004:l026","ordinal":179332,"en":"Was it not Bakay who brought it?"},{"id":"semetey-1-2013:p1350:b004:l027","ordinal":179333,"en":"My uncle Bakay, my falcon,"},{"id":"semetey-1-2013:p1350:b004:l028","ordinal":179334,"en":"The inheritance left by Manas;"},{"id":"semetey-1-2013:p1350:b004:l029","ordinal":179335,"en":"The one I will fight is Kakan-Chyn,"},{"id":"semetey-1-2013:p1350:b004:l030","ordinal":179336,"en":"The one I will confront is Bakburchun."},{"id":"semetey-1-2013:p1350:b004:l031","ordinal":179337,"en":"My heroic uncle Bakay—"},{"id":"semetey-1-2013:p1350:b004:l032","ordinal":179338,"en":"If I make him my renowned companion,"},{"id":"semetey-1-2013:p1350:b004:l033","ordinal":179339,"en":"Kongurbay is indeed a hero;"},{"id":"semetey-1-2013:p1350:b004:l034","ordinal":179340,"en":"I will face him, fight six months,"},{"id":"semetey-1-2013:p1350:b004:l035","ordinal":179341,"en":"And bring conflict upon that swine."},{"id":"semetey-1-2013:p1350:b004:l036","ordinal":179342,"en":"The road to Beijing has five defiles;"},{"id":"semetey-1-2013:p1350:b004:l037","ordinal":179343,"en":"My renowned uncle Bakay"},{"id":"semetey-1-2013:p1350:b004:l038","ordinal":179344,"en":"Will lead me straight against the enemy."},{"id":"semetey-1-2013:p1350:b004:l039","ordinal":179345,"en":"Great Beijing, ancient people,"},{"id":"semetey-1-2013:p1351:b003:l001","ordinal":179346,"en":"Whose multitude, we hear, is like black worms."},{"id":"semetey-1-2013:p1351:b003:l002","ordinal":179347,"en":"We continued from tradition"},{"id":"semetey-1-2013:p1351:b003:l003","ordinal":179348,"en":"And asked those who knew."},{"id":"semetey-1-2013:p1351:b003:l004","ordinal":179349,"en":"To Beijing, which Alexander could not conquer,"},{"id":"semetey-1-2013:p1351:b003:l005","ordinal":179350,"en":"Leveling his spear and drawing his bow,"},{"id":"semetey-1-2013:p1351:b003:l006","ordinal":179351,"en":"Was it not Bakay who went?"},{"id":"semetey-1-2013:p1351:b003:l007","ordinal":179352,"en":"While my Sultan Manas lived,"},{"id":"semetey-1-2013:p1351:b003:l008","ordinal":179353,"en":"Beijing, which Solomon could not conquer—"},{"id":"semetey-1-2013:p1351:b003:l009","ordinal":179354,"en":"Seizing its khanate there,"},{"id":"semetey-1-2013:p1351:b003:l010","ordinal":179355,"en":"Was it not Bakay who took it?"},{"id":"semetey-1-2013:p1351:b003:l011","ordinal":179356,"en":"When battle begins, a bringer of good fortune,"},{"id":"semetey-1-2013:p1351:b003:l012","ordinal":179357,"en":"Against a fighting foe, like a vast army—"},{"id":"semetey-1-2013:p1351:b003:l013","ordinal":179358,"en":"Is he not skillful Bakay?"},{"id":"semetey-1-2013:p1351:b003:l014","ordinal":179359,"en":"Making known what was unknown,"},{"id":"semetey-1-2013:p1351:b003:l015","ordinal":179360,"en":"My learned old Bakay;"},{"id":"semetey-1-2013:p1351:b003:l016","ordinal":179361,"en":"Making one perceive what was unnoticed,"},{"id":"semetey-1-2013:p1351:b003:l017","ordinal":179362,"en":"My falcon, saintly Bakay."},{"id":"semetey-1-2013:p1351:b003:l018","ordinal":179363,"en":"My elder, old Bakay,"},{"id":"semetey-1-2013:p1351:b003:l019","ordinal":179364,"en":"A saint who has seen much;"},{"id":"semetey-1-2013:p1351:b003:l020","ordinal":179365,"en":"Though my elder is old,"},{"id":"semetey-1-2013:p1351:b003:l021","ordinal":179366,"en":"I will take him as my companion."},{"id":"semetey-1-2013:p1351:b003:l022","ordinal":179367,"en":"The reason I make him my companion:"},{"id":"semetey-1-2013:p1351:b003:l023","ordinal":179368,"en":"My poor uncle Bakay"},{"id":"semetey-1-2013:p1351:b003:l024","ordinal":179369,"en":"Is my falcon left as an inheritance"},{"id":"semetey-1-2013:p1351:b003:l025","ordinal":179370,"en":"By my departed father Manas."},{"id":"semetey-1-2013:p1351:b003:l026","ordinal":179371,"en":"If I put my falcon uncle Bakay before me,"},{"id":"semetey-1-2013:p1351:b003:l027","ordinal":179372,"en":"He brings good fortune;"},{"id":"semetey-1-2013:p1351:b003:l028","ordinal":179373,"en":"If he walks behind me, he is my blessing;"},{"id":"semetey-1-2013:p1351:b003:l029","ordinal":179374,"en":"If I take shelter in him, he is like a vast army."},{"id":"semetey-1-2013:p1351:b003:l030","ordinal":179375,"en":"I will journey to the khan,"},{"id":"semetey-1-2013:p1351:b003:l031","ordinal":179376,"en":"For I know the greatness"},{"id":"semetey-1-2013:p1351:b003:l032","ordinal":179377,"en":"Of my blue-maned uncle Bakay."},{"id":"semetey-1-2013:p1351:b003:l033","ordinal":179378,"en":"One road to Beijing"},{"id":"semetey-1-2013:p1351:b003:l034","ordinal":179379,"en":"Has a dug-out pit."},{"id":"semetey-1-2013:p1351:b003:l035","ordinal":179380,"en":"One road, I hear,"},{"id":"semetey-1-2013:p1351:b003:l036","ordinal":179381,"en":"Has boiling salt water."},{"id":"semetey-1-2013:p1351:b003:l037","ordinal":179382,"en":"One road to Beijing"},{"id":"semetey-1-2013:p1351:b003:l038","ordinal":179383,"en":"Has a blocked pass."},{"id":"semetey-1-2013:p1351:b003:l039","ordinal":179384,"en":"One road to Beijing, I hear,"},{"id":"semetey-1-2013:p1351:b004:l001","ordinal":179385,"en":"Has a flood that sweeps all away."},{"id":"semetey-1-2013:p1351:b004:l002","ordinal":179386,"en":"When pursuing my royal father's blood price,"},{"id":"semetey-1-2013:p1351:b004:l003","ordinal":179387,"en":"If I extinguish the fire kindled"},{"id":"semetey-1-2013:p1351:b004:l004","ordinal":179388,"en":"By the clamoring Chinese,"},{"id":"semetey-1-2013:p1351:b004:l005","ordinal":179389,"en":"Seize the khanate"},{"id":"semetey-1-2013:p1351:b004:l006","ordinal":179390,"en":"From their lord, Manchu Kongurbay,"},{"id":"semetey-1-2013:p1351:b004:l007","ordinal":179391,"en":"And drive him toward the khan."},{"id":"semetey-1-2013:p1351:b004:l008","ordinal":179392,"en":"My mind has turned to hardship,"},{"id":"semetey-1-2013:p1351:b004:l009","ordinal":179393,"en":"To girding my waist firmly,"},{"id":"semetey-1-2013:p1351:b004:l010","ordinal":179394,"en":"To rolling up my sleeves against"},{"id":"semetey-1-2013:p1351:b004:l011","ordinal":179395,"en":"Kongurbay in Beijing,"},{"id":"semetey-1-2013:p1351:b004:l012","ordinal":179396,"en":"And pursuing my father's blood price."},{"id":"semetey-1-2013:p1351:b004:l013","ordinal":179397,"en":"Upon the Gün-zhang-zhung people"},{"id":"semetey-1-2013:p1351:b004:l014","ordinal":179398,"en":"I will bring terrible slaughter;"},{"id":"semetey-1-2013:p1351:b004:l015","ordinal":179399,"en":"This year I will avenge"},{"id":"semetey-1-2013:p1351:b004:l016","ordinal":179400,"en":"Falcon Chubak and Almam."},{"id":"semetey-1-2013:p1351:b004:l017","ordinal":179401,"en":"Great Beijing, unreachable by flood—"},{"id":"semetey-1-2013:p1351:b004:l018","ordinal":179402,"en":"If venturesome Allah supports me,"},{"id":"semetey-1-2013:p1351:b004:l019","ordinal":179403,"en":"I will test myself against it;"},{"id":"semetey-1-2013:p1351:b004:l020","ordinal":179404,"en":"If fate arrives and my days end,"},{"id":"semetey-1-2013:p1351:b004:l021","ordinal":179405,"en":"I will die in Great Beijing."},{"id":"semetey-1-2013:p1351:b004:l022","ordinal":179406,"en":"How can I live"},{"id":"semetey-1-2013:p1351:b004:l023","ordinal":179407,"en":"Without charging and waging war"},{"id":"semetey-1-2013:p1351:b004:l024","ordinal":179408,"en":"Against the teeming khan,"},{"id":"semetey-1-2013:p1351:b004:l025","ordinal":179409,"en":"Without avenging my royal father?"},{"id":"semetey-1-2013:p1351:b004:l026","ordinal":179410,"en":"For the sake of the falcons,"},{"id":"semetey-1-2013:p1351:b004:l027","ordinal":179411,"en":"I will bring slaughter upon China;"},{"id":"semetey-1-2013:p1351:b004:l028","ordinal":179412,"en":"I will go and avenge the falcons"},{"id":"semetey-1-2013:p1351:b004:l029","ordinal":179413,"en":"Who met Judgment Day"},{"id":"semetey-1-2013:p1351:b004:l030","ordinal":179414,"en":"At the hands of the red-naveled Kalmyks."},{"id":"semetey-1-2013:p1351:b004:l031","ordinal":179415,"en":"I will bring slaughter upon Beijing."},{"id":"semetey-1-2013:p1351:b004:l032","ordinal":179416,"en":"Without avenging my hero father, the lion,"},{"id":"semetey-1-2013:p1351:b004:l033","ordinal":179417,"en":"And the falcons,"},{"id":"semetey-1-2013:p1351:b004:l034","ordinal":179418,"en":"How can I remain alive?"},{"id":"semetey-1-2013:p1351:b004:l035","ordinal":179419,"en":"I will campaign against Kakan-Chyn,"},{"id":"semetey-1-2013:p1351:b004:l036","ordinal":179420,"en":"And contend in battle"},{"id":"semetey-1-2013:p1351:b004:l037","ordinal":179421,"en":"With warrior Khan Kongurbay;"},{"id":"semetey-1-2013:p1351:b004:l038","ordinal":179422,"en":"I will fight him at close quarters"},{"id":"semetey-1-2013:p1351:b004:l039","ordinal":179423,"en":"And spill his blood without ceasing."},{"id":"semetey-1-2013:p1352:b003:l001","ordinal":179424,"en":"I will tread upon the head"},{"id":"semetey-1-2013:p1352:b003:l002","ordinal":179425,"en":"Of the lordly Chinese,"},{"id":"semetey-1-2013:p1352:b003:l003","ordinal":179426,"en":"And scatter the four kinds of livestock"},{"id":"semetey-1-2013:p1352:b003:l004","ordinal":179427,"en":"Of the swine who struck you from above."},{"id":"semetey-1-2013:p1352:b003:l005","ordinal":179428,"en":"If I do not ride forth facing"},{"id":"semetey-1-2013:p1352:b003:l006","ordinal":179429,"en":"Heroic Beijing,"},{"id":"semetey-1-2013:p1352:b003:l007","ordinal":179430,"en":"And lay grievous hardship"},{"id":"semetey-1-2013:p1352:b003:l008","ordinal":179431,"en":"Upon the Kalmyks at Beijing's gate!"},{"id":"semetey-1-2013:p1352:b003:l009","ordinal":179432,"en":"If I do not truly enter"},{"id":"semetey-1-2013:p1352:b003:l010","ordinal":179433,"en":"Chynmachyn's Beijing and bring slaughter,"},{"id":"semetey-1-2013:p1352:b003:l011","ordinal":179434,"en":"And this year avenge the falcons"},{"id":"semetey-1-2013:p1352:b003:l012","ordinal":179435,"en":"Who departed for the true world!”"},{"id":"semetey-1-2013:p1352:b003:l013","ordinal":179436,"en":"The fine brave son of Manas,"},{"id":"semetey-1-2013:p1352:b003:l014","ordinal":179437,"en":"Speaking many words with flashing eyes,"},{"id":"semetey-1-2013:p1352:b003:l015","ordinal":179438,"en":"Was impossible to look upon;"},{"id":"semetey-1-2013:p1352:b003:l016","ordinal":179439,"en":"The hero's youthful son"},{"id":"semetey-1-2013:p1352:b003:l017","ordinal":179440,"en":"Was truly seized by bloodlust."},{"id":"semetey-1-2013:p1352:b003:l018","ordinal":179441,"en":"Flame poured from his mouth,"},{"id":"semetey-1-2013:p1352:b003:l019","ordinal":179442,"en":"And the warrior aspect"},{"id":"semetey-1-2013:p1352:b003:l020","ordinal":179443,"en":"Of Manas's blue-maned son appeared."},{"id":"semetey-1-2013:p1352:b003:l021","ordinal":179444,"en":"The dear lion grew agitated,"},{"id":"semetey-1-2013:p1352:b003:l022","ordinal":179445,"en":"Girding on his gray purse,"},{"id":"semetey-1-2013:p1352:b003:l023","ordinal":179446,"en":"Scowling in fury,"},{"id":"semetey-1-2013:p1352:b003:l024","ordinal":179447,"en":"Distracting the minds of all who saw him."},{"id":"semetey-1-2013:p1352:b003:l025","ordinal":179448,"en":"When he came in anger,"},{"id":"semetey-1-2013:p1352:b003:l026","ordinal":179449,"en":"The descendant of the blood-drinker"},{"id":"semetey-1-2013:p1352:b003:l027","ordinal":179450,"en":"Showed the form of a lion."},{"id":"semetey-1-2013:p1352:b003:l028","ordinal":179451,"en":"Straining like a gray tiger,"},{"id":"semetey-1-2013:p1352:b003:l029","ordinal":179452,"en":"He prepared to pursue the blood price"},{"id":"semetey-1-2013:p1352:b003:l030","ordinal":179453,"en":"From Kakan-Chyn's Beijing."},{"id":"semetey-1-2013:p1352:b003:l031","ordinal":179454,"en":"The ill-starred heir left as a gift"},{"id":"semetey-1-2013:p1352:b003:l032","ordinal":179455,"en":"By blue-maned hero Manas"},{"id":"semetey-1-2013:p1352:b003:l033","ordinal":179456,"en":"Would not turn back from doom,"}]
