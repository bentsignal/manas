[{"id":"semetey-1-2013:p1048:b004:l034","ordinal":156161,"en":"They appeared like ravenous devourers."},{"id":"semetey-1-2013:p1048:b004:l035","ordinal":156162,"en":"The dense black Zhediger"},{"id":"semetey-1-2013:p1048:b004:l036","ordinal":156163,"en":"Separated into division after division,"},{"id":"semetey-1-2013:p1048:b004:l037","ordinal":156164,"en":"And split into distinct groups."},{"id":"semetey-1-2013:p1048:b004:l038","ordinal":156165,"en":"Upon the face of Bolbogur,"},{"id":"semetey-1-2013:p1048:b004:l039","ordinal":156166,"en":"At the edge rode one upon a gray horse,"}]
