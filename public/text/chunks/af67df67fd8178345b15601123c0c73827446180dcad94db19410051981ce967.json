[{"id":"manas-2010:p0866:b001:l029","ordinal":38145,"en":"Upon Alty-Shaar and Kokand,"},{"id":"manas-2010:p0866:b001:l030","ordinal":38146,"en":"He wrought terrible havoc, they say."},{"id":"manas-2010:p0866:b001:l031","ordinal":38147,"en":"Subduing those who clashed with him,"},{"id":"manas-2010:p0866:b001:l032","ordinal":38148,"en":"Hero Chubak went on conquering."},{"id":"manas-2010:p0866:b001:l033","ordinal":38149,"en":"Smashing like a wild boar,"},{"id":"manas-2010:p0866:b001:l034","ordinal":38150,"en":"Everyone who grappled with him,"},{"id":"manas-2010:p0866:b001:l035","ordinal":38151,"en":"Hero Chubak went on cutting down."},{"id":"manas-2010:p0866:b001:l036","ordinal":38152,"en":"Leopard Chubak's fame,"},{"id":"manas-2010:p0866:b001:l037","ordinal":38153,"en":"How far his strife had reached!"},{"id":"manas-2010:p0866:b001:l038","ordinal":38154,"en":"He never once retreats from death;"},{"id":"manas-2010:p0866:b001:l039","ordinal":38155,"en":"Would he lie idle without fighting?"},{"id":"manas-2010:p0866:b001:l040","ordinal":38156,"en":"He did as he pleased, they say."},{"id":"manas-2010:p0866:b001:l041","ordinal":38157,"en":"Andijan's striped cloth with its thick weft,"},{"id":"manas-2010:p0866:b001:l042","ordinal":38158,"en":"Akbaltay's Chubak"},{"id":"manas-2010:p0867:b001:l001","ordinal":38159,"en":"Took it as tribute, they say."},{"id":"manas-2010:p0867:b001:l002","ordinal":38160,"en":"Unable to bear his tribute,"},{"id":"manas-2010:p0867:b001:l003","ordinal":38161,"en":"Hearing talk from various sides,"},{"id":"manas-2010:p0867:b001:l004","ordinal":38162,"en":"One said, ‘Temirkan in Bukhara,"},{"id":"manas-2010:p0867:b001:l005","ordinal":38163,"en":"They say he is a man of terrible wrath."},{"id":"manas-2010:p0867:b001:l006","ordinal":38164,"en":"His brow is high, his venom fierce;"},{"id":"manas-2010:p0867:b001:l007","ordinal":38165,"en":"Whoever attacks him, abandon hope!"},{"id":"manas-2010:p0867:b001:l008","ordinal":38166,"en":"To that Bukhara there,"},{"id":"manas-2010:p0867:b001:l009","ordinal":38167,"en":"No mortal turns to go, they say."},{"id":"manas-2010:p0867:b001:l010","ordinal":38168,"en":"Before this, from Bukhara,"},{"id":"manas-2010:p0867:b001:l011","ordinal":38169,"en":"No one has exacted an accounting,’ they say."},{"id":"manas-2010:p0867:b001:l012","ordinal":38170,"en":"‘Bukhara, where no mortal goes,"},{"id":"manas-2010:p0867:b001:l013","ordinal":38171,"en":"I shall bring it to submission,’ he said."},{"id":"manas-2010:p0867:b001:l014","ordinal":38172,"en":"‘Temirkan has grown unruly;"},{"id":"manas-2010:p0867:b001:l015","ordinal":38173,"en":"I shall make him a subject,’ he said."},{"id":"manas-2010:p0867:b001:l016","ordinal":38174,"en":"‘Temir's women and girls,"},{"id":"manas-2010:p0867:b001:l017","ordinal":38175,"en":"I shall take as tribute,’ he said."},{"id":"manas-2010:p0867:b001:l018","ordinal":38176,"en":"‘Upon renowned Bukhara,"},{"id":"manas-2010:p0867:b001:l019","ordinal":38177,"en":"I shall unleash calamity,’ he said."},{"id":"manas-2010:p0867:b001:l020","ordinal":38178,"en":"‘If he does not yield to my might,"},{"id":"manas-2010:p0867:b001:l021","ordinal":38179,"en":"Of the vast city of Bukhara,"},{"id":"manas-2010:p0867:b001:l022","ordinal":38180,"en":"If Temir does not surrender his kingship,"},{"id":"manas-2010:p0867:b001:l023","ordinal":38181,"en":"Surging into Bukhara,"},{"id":"manas-2010:p0867:b001:l024","ordinal":38182,"en":"I shall wreak havoc,’ he said."},{"id":"manas-2010:p0867:b001:l025","ordinal":38183,"en":"Growing dark and lowering,"},{"id":"manas-2010:p0867:b001:l026","ordinal":38184,"en":"He rode forth from Alay."},{"id":"manas-2010:p0867:b001:l027","ordinal":38185,"en":"Noble Chubak, wolf-maned hero,"},{"id":"manas-2010:p0867:b001:l028","ordinal":38186,"en":"Traveling without sparing his horse,"},{"id":"manas-2010:p0867:b001:l029","ordinal":38187,"en":"Traveling far, no little distance,"},{"id":"manas-2010:p0867:b001:l030","ordinal":38188,"en":"Kögala beneath him,"},{"id":"manas-2010:p0867:b001:l031","ordinal":38189,"en":"The ground he trod crumbled;"},{"id":"manas-2010:p0867:b001:l032","ordinal":38190,"en":"He sped like a flying bird."},{"id":"manas-2010:p0867:b001:l033","ordinal":38191,"en":"The vast city of Bukhara,"},{"id":"manas-2010:p0867:b001:l034","ordinal":38192,"en":"Chubak reached and besieged it."},{"id":"manas-2010:p0867:b001:l035","ordinal":38193,"en":"The guards at the gate,"},{"id":"manas-2010:p0867:b001:l036","ordinal":38194,"en":"He slaughtered the guards."},{"id":"manas-2010:p0867:b001:l037","ordinal":38195,"en":"He made whatever strife he knew."},{"id":"manas-2010:p0867:b001:l038","ordinal":38196,"en":"Drawing his bow, sending arrows like rain,"},{"id":"manas-2010:p0867:b001:l039","ordinal":38197,"en":"Hero Chubak, a terrible scourge,"},{"id":"manas-2010:p0867:b001:l040","ordinal":38198,"en":"Hero Chubak's valor"},{"id":"manas-2010:p0867:b001:l041","ordinal":38199,"en":"No mortal could ever produce."},{"id":"manas-2010:p0867:b001:l042","ordinal":38200,"en":"The red sword Zulpukor,"},{"id":"manas-2010:p0868:b001:l001","ordinal":38201,"en":"He was waving it about."},{"id":"manas-2010:p0868:b001:l002","ordinal":38202,"en":"Sparing none who attacked him,"},{"id":"manas-2010:p0868:b001:l003","ordinal":38203,"en":"He was shoving them aside."},{"id":"manas-2010:p0868:b001:l004","ordinal":38204,"en":"Leaving no part of the earth,"},{"id":"manas-2010:p0868:b001:l005","ordinal":38205,"en":"‘I alone shall rule it,’ he said,"},{"id":"manas-2010:p0868:b001:l006","ordinal":38206,"en":"He was taking possession."},{"id":"manas-2010:p0868:b001:l007","ordinal":38207,"en":"Such was Chubak's nature:"},{"id":"manas-2010:p0868:b001:l008","ordinal":38208,"en":"His shape and stately bearing,"},{"id":"manas-2010:p0868:b001:l009","ordinal":38209,"en":"His posture upon horseback,"},{"id":"manas-2010:p0868:b001:l010","ordinal":38210,"en":"His bulk like half a mountain,"},{"id":"manas-2010:p0868:b001:l011","ordinal":38211,"en":"As though he could butcher and eat the world."},{"id":"manas-2010:p0868:b001:l012","ordinal":38212,"en":"His brow was high, his venom fierce;"},{"id":"manas-2010:p0868:b001:l013","ordinal":38213,"en":"He levels whoever attacks him."},{"id":"manas-2010:p0868:b001:l014","ordinal":38214,"en":"Cloth-wide mouth and cliff-like brow,"},{"id":"manas-2010:p0868:b001:l015","ordinal":38215,"en":"A bold fellow skilled with the spear,"},{"id":"manas-2010:p0868:b001:l016","ordinal":38216,"en":"An exceedingly brave and mighty fellow."},{"id":"manas-2010:p0868:b001:l017","ordinal":38217,"en":"Showing his wolf-maned valor,"},{"id":"manas-2010:p0868:b001:l018","ordinal":38218,"en":"He turned Kögala's head."},{"id":"manas-2010:p0868:b001:l019","ordinal":38219,"en":"Temirkan, khan of Bukhara,"},{"id":"manas-2010:p0868:b001:l020","ordinal":38220,"en":"Khan Baltay's hero Chubak"},{"id":"manas-2010:p0868:b001:l021","ordinal":38221,"en":"Now stood besieging him."},{"id":"manas-2010:p0868:b001:l022","ordinal":38222,"en":"‘Obey what I say,’ he said."},{"id":"manas-2010:p0868:b001:l023","ordinal":38223,"en":"‘Without quarrels, without strife,"},{"id":"manas-2010:p0868:b001:l024","ordinal":38224,"en":"The golden throne beneath you,"},{"id":"manas-2010:p0868:b001:l025","ordinal":38225,"en":"Step down and give it to me,’ he said."},{"id":"manas-2010:p0868:b001:l026","ordinal":38226,"en":"‘If you have a mind to submit,"},{"id":"manas-2010:p0868:b001:l027","ordinal":38227,"en":"Give your daughters as tribute,’ he said."},{"id":"manas-2010:p0868:b001:l028","ordinal":38228,"en":"‘If you have a mind to fight with spears,"},{"id":"manas-2010:p0868:b001:l029","ordinal":38229,"en":"Come onto the field at once,’ he said."},{"id":"manas-2010:p0868:b001:l030","ordinal":38230,"en":"‘Hear the news and understand:"},{"id":"manas-2010:p0868:b001:l031","ordinal":38231,"en":"Chubak, son of Khan Baltay,"},{"id":"manas-2010:p0868:b001:l032","ordinal":38232,"en":"When his wrath is roused,"},{"id":"manas-2010:p0868:b001:l033","ordinal":38233,"en":"The ruthless one who could ravage the world,"},{"id":"manas-2010:p0868:b001:l034","ordinal":38234,"en":"Obey these words of his,’ he said."},{"id":"manas-2010:p0868:b001:l035","ordinal":38235,"en":"‘Of gated Bukhara city,"},{"id":"manas-2010:p0868:b001:l036","ordinal":38236,"en":"Give me the kingship,’ he said."},{"id":"manas-2010:p0868:b001:l037","ordinal":38237,"en":"He now stood besieging it."},{"id":"manas-2010:p0868:b001:l038","ordinal":38238,"en":"The elder who guarded the gate"},{"id":"manas-2010:p0868:b001:l039","ordinal":38239,"en":"Now fled to Karakan."},{"id":"manas-2010:p0868:b001:l040","ordinal":38240,"en":"All the guards,"},{"id":"manas-2010:p0868:b001:l041","ordinal":38241,"en":"Their religious lords scurrying,"},{"id":"manas-2010:p0868:b001:l042","ordinal":38242,"en":"All the religious teachers,"},{"id":"manas-2010:p0869:b001:l001","ordinal":38243,"en":"Unable to gather their wits,"},{"id":"manas-2010:p0869:b001:l002","ordinal":38244,"en":"Fled in a bobbing rush."},{"id":"manas-2010:p0869:b001:l003","ordinal":38245,"en":"Running before the khan,"},{"id":"manas-2010:p0869:b001:l004","ordinal":38246,"en":"The people now spoke:"},{"id":"manas-2010:p0869:b001:l005","ordinal":38247,"en":"‘We have seen grievous hardship;"},{"id":"manas-2010:p0869:b001:l006","ordinal":38248,"en":"We have suffered force from one man!"},{"id":"manas-2010:p0869:b001:l007","ordinal":38249,"en":"Tiger's courage and a mighty heart,"},{"id":"manas-2010:p0869:b001:l008","ordinal":38250,"en":"Upon whoever approaches he could bring"},{"id":"manas-2010:p0869:b001:l009","ordinal":38251,"en":"Great, unending turmoil."},{"id":"manas-2010:p0869:b001:l010","ordinal":38252,"en":"No mortal could make him bend;"},{"id":"manas-2010:p0869:b001:l011","ordinal":38253,"en":"No one could endure to approach."},{"id":"manas-2010:p0869:b001:l012","ordinal":38254,"en":"He wears a coat of blue iron,"},{"id":"manas-2010:p0869:b001:l013","ordinal":38255,"en":"He rides a horse like Kögala,"},{"id":"manas-2010:p0869:b001:l014","ordinal":38256,"en":"He has the wondrous steed Kögala."},{"id":"manas-2010:p0869:b001:l015","ordinal":38257,"en":"He is a great blood-drinker indeed."},{"id":"manas-2010:p0869:b001:l016","ordinal":38258,"en":"Wrath has spread across his face."},{"id":"manas-2010:p0869:b001:l017","ordinal":38259,"en":"An iron-headed mace like a small yurt"},{"id":"manas-2010:p0869:b001:l018","ordinal":38260,"en":"Is strapped upon one side."},{"id":"manas-2010:p0869:b001:l019","ordinal":38261,"en":"Shrill battle cries and piercing shouts,"},{"id":"manas-2010:p0869:b001:l020","ordinal":38262,"en":"A devastating bow and painted arrows,"},{"id":"manas-2010:p0869:b001:l021","ordinal":38263,"en":"If we do not obey his words,"},{"id":"manas-2010:p0869:b001:l022","ordinal":38264,"en":"He will raise trouble now!"},{"id":"manas-2010:p0869:b001:l023","ordinal":38265,"en":"He is a hero and a lion;"},{"id":"manas-2010:p0869:b001:l024","ordinal":38266,"en":"Without dismounting, Bukhara,"},{"id":"manas-2010:p0869:b001:l025","ordinal":38267,"en":"He is a hero who could scoop it up."},{"id":"manas-2010:p0869:b001:l026","ordinal":38268,"en":"If he attacks with a roar,"},{"id":"manas-2010:p0869:b001:l027","ordinal":38269,"en":"He could mow us through the middle."},{"id":"manas-2010:p0869:b001:l028","ordinal":38270,"en":"Bukhara with its twelve gates,"},{"id":"manas-2010:p0869:b001:l029","ordinal":38271,"en":"As I consider it, this hero"},{"id":"manas-2010:p0869:b001:l030","ordinal":38272,"en":"Could suck it dry, letting nothing out."},{"id":"manas-2010:p0869:b001:l031","ordinal":38273,"en":"Unless you gather abundant soldiers,"},{"id":"manas-2010:p0869:b001:l032","ordinal":38274,"en":"Unless you devise a firm stratagem,"},{"id":"manas-2010:p0869:b001:l033","ordinal":38275,"en":"His eyes are red, his body vast;"},{"id":"manas-2010:p0869:b001:l034","ordinal":38276,"en":"No such being can be seen in the world.’"},{"id":"manas-2010:p0869:b001:l035","ordinal":38277,"en":"People clamored, the crowd panicked;"},{"id":"manas-2010:p0869:b001:l036","ordinal":38278,"en":"Chubak unleashed his wrath."},{"id":"manas-2010:p0869:b001:l037","ordinal":38279,"en":"When they heard this news,"},{"id":"manas-2010:p0869:b001:l038","ordinal":38280,"en":"Warriors feared and the people panicked."},{"id":"manas-2010:p0869:b001:l039","ordinal":38281,"en":"All Bukhara then"},{"id":"manas-2010:p0869:b001:l040","ordinal":38282,"en":"Was being slaughtered."},{"id":"manas-2010:p0869:b001:l041","ordinal":38283,"en":"While the people clamored,"},{"id":"manas-2010:p0869:b001:l042","ordinal":38284,"en":"The youngest of twelve daughters,"},{"id":"manas-2010:p0870:b001:l001","ordinal":38285,"en":"God's beloved servant,"},{"id":"manas-2010:p0870:b001:l002","ordinal":38286,"en":"The loveliest of the dark-complexioned,"},{"id":"manas-2010:p0870:b001:l003","ordinal":38287,"en":"The radiant one among Muslims,"},{"id":"manas-2010:p0870:b001:l004","ordinal":38288,"en":"The ablest of the long-haired,"},{"id":"manas-2010:p0870:b001:l005","ordinal":38289,"en":"The strongest of women,"},{"id":"manas-2010:p0870:b001:l006","ordinal":38290,"en":"The finest of those in flowing dresses,"},{"id":"manas-2010:p0870:b001:l007","ordinal":38291,"en":"The queen of women,"},{"id":"manas-2010:p0870:b001:l008","ordinal":38292,"en":"That poor fairy-born one's"},{"id":"manas-2010:p0870:b001:l009","ordinal":38293,"en":"Prowess was renowned."},{"id":"manas-2010:p0870:b001:l010","ordinal":38294,"en":"Making her woman's self a warrior,"},{"id":"manas-2010:p0870:b001:l011","ordinal":38295,"en":"Her strength carried her out on patrol."},{"id":"manas-2010:p0870:b001:l012","ordinal":38296,"en":"In her maiden days, the ill-fated one,"},{"id":"manas-2010:p0870:b001:l013","ordinal":38297,"en":"Shaking peoples and ravaging lands,"},{"id":"manas-2010:p0870:b001:l014","ordinal":38298,"en":"Such was Kanykey's habit."},{"id":"manas-2010:p0870:b001:l015","ordinal":38299,"en":"The youngest of twelve daughters,"},{"id":"manas-2010:p0870:b001:l016","ordinal":38300,"en":"Who braided the hair upon her crown,"},{"id":"manas-2010:p0870:b001:l017","ordinal":38301,"en":"More than four thousand sons in a row,"},{"id":"manas-2010:p0870:b001:l018","ordinal":38302,"en":"They loved her."},{"id":"manas-2010:p0870:b001:l019","ordinal":38303,"en":"To whoever spoke to her,"},{"id":"manas-2010:p0870:b001:l020","ordinal":38304,"en":"Her words, when she spoke, were precious."},{"id":"manas-2010:p0870:b001:l021","ordinal":38305,"en":"Of six months' hardship ahead,"},{"id":"manas-2010:p0870:b001:l022","ordinal":38306,"en":"Who could tell at once,"},{"id":"manas-2010:p0870:b001:l023","ordinal":38307,"en":"Upon that girl's right shoulder"},{"id":"manas-2010:p0870:b001:l024","ordinal":38308,"en":"There was a naked child."},{"id":"manas-2010:p0870:b001:l025","ordinal":38309,"en":"Temirkan's daughter Kanykey,"},{"id":"manas-2010:p0870:b001:l026","ordinal":38310,"en":"Do you still remember her?"},{"id":"manas-2010:p0870:b001:l027","ordinal":38311,"en":"From childhood, Kanykey"},{"id":"manas-2010:p0870:b001:l028","ordinal":38312,"en":"Had been a mighty, ill-fated champion."},{"id":"manas-2010:p0870:b001:l029","ordinal":38313,"en":"Wherever she went, havoc,"},{"id":"manas-2010:p0870:b001:l030","ordinal":38314,"en":"That ill-fated one had wrought it."},{"id":"manas-2010:p0870:b001:l031","ordinal":38315,"en":"When she saw hero Chubak,"},{"id":"manas-2010:p0870:b001:l032","ordinal":38316,"en":"Springing like a roe deer,"},{"id":"manas-2010:p0870:b001:l033","ordinal":38317,"en":"Before Temirkan,"},{"id":"manas-2010:p0870:b001:l034","ordinal":38318,"en":"She now came running,"},{"id":"manas-2010:p0870:b001:l035","ordinal":38319,"en":"To the palace of the royal court,"},{"id":"manas-2010:p0870:b001:l036","ordinal":38320,"en":"Before her father."},{"id":"manas-2010:p0870:b001:l037","ordinal":38321,"en":"That Kanykey said:"},{"id":"manas-2010:p0870:b001:l038","ordinal":38322,"en":"‘An unbounded being has come to the gate."},{"id":"manas-2010:p0870:b001:l039","ordinal":38323,"en":"If my doom has come, let me die."},{"id":"manas-2010:p0870:b001:l040","ordinal":38324,"en":"If my skill can match him,"},{"id":"manas-2010:p0870:b001:l041","ordinal":38325,"en":"Let me try him in combat."},{"id":"manas-2010:p0870:b001:l042","ordinal":38326,"en":"If I let that being defeat me,"},{"id":"manas-2010:p0871:b001:l001","ordinal":38327,"en":"You will suffer oppression like sheep;"},{"id":"manas-2010:p0871:b001:l002","ordinal":38328,"en":"All of you will die, not one remaining."},{"id":"manas-2010:p0871:b001:l003","ordinal":38329,"en":"If I overcome him,"},{"id":"manas-2010:p0871:b001:l004","ordinal":38330,"en":"Without killing or destroying him,"},{"id":"manas-2010:p0871:b001:l005","ordinal":38331,"en":"I shall capture him alive."},{"id":"manas-2010:p0871:b001:l006","ordinal":38332,"en":"Fighting ceaselessly for six months,"},{"id":"manas-2010:p0871:b001:l007","ordinal":38333,"en":"I shall put him straight down."},{"id":"manas-2010:p0871:b001:l008","ordinal":38334,"en":"Back again to Bukhara,"},{"id":"manas-2010:p0871:b001:l009","ordinal":38335,"en":"Let me make sure he never comes,"},{"id":"manas-2010:p0871:b001:l010","ordinal":38336,"en":"Coveting the city of Bukhara,"},{"id":"manas-2010:p0871:b001:l011","ordinal":38337,"en":"That being, after this,"},{"id":"manas-2010:p0871:b001:l012","ordinal":38338,"en":"Let me make sure we never see him!’"},{"id":"manas-2010:p0871:b001:l013","ordinal":38339,"en":"So spoke Kanykey:"},{"id":"manas-2010:p0871:b001:l014","ordinal":38340,"en":"‘He is alone, I am alone."},{"id":"manas-2010:p0871:b001:l015","ordinal":38341,"en":"Fighting with spears upon the open plain,"},{"id":"manas-2010:p0871:b001:l016","ordinal":38342,"en":"Let me make a fierce encounter."},{"id":"manas-2010:p0871:b001:l017","ordinal":38343,"en":"Striking and grappling,"},{"id":"manas-2010:p0871:b001:l018","ordinal":38344,"en":"That fellow who goes about raiding,"},{"id":"manas-2010:p0871:b001:l019","ordinal":38345,"en":"Let me test his strength."},{"id":"manas-2010:p0871:b001:l020","ordinal":38346,"en":"Let me rouse him and learn his might."},{"id":"manas-2010:p0871:b001:l021","ordinal":38347,"en":"If my strength suffices,"},{"id":"manas-2010:p0871:b001:l022","ordinal":38348,"en":"Let me drive him back to his own land!"},{"id":"manas-2010:p0871:b001:l023","ordinal":38349,"en":"If he is an enemy from the unbelievers,"},{"id":"manas-2010:p0871:b001:l024","ordinal":38350,"en":"Let me cut off his head with my sword."},{"id":"manas-2010:p0871:b001:l025","ordinal":38351,"en":"If he is a hero from Islam,"},{"id":"manas-2010:p0871:b001:l026","ordinal":38352,"en":"Let me give him a mocking rebuke."},{"id":"manas-2010:p0871:b001:l027","ordinal":38353,"en":"Capturing him alive, before you,"},{"id":"manas-2010:p0871:b001:l028","ordinal":38354,"en":"Let me present him as tribute!’"},{"id":"manas-2010:p0871:b001:l029","ordinal":38355,"en":"So said Kanykey."},{"id":"manas-2010:p0871:b001:l030","ordinal":38356,"en":"Tucking up her flowing dress,"},{"id":"manas-2010:p0871:b001:l031","ordinal":38357,"en":"The graceful, ill-fated one"},{"id":"manas-2010:p0871:b001:l032","ordinal":38358,"en":"Made her battle clothing secure."},{"id":"manas-2010:p0871:b001:l033","ordinal":38359,"en":"Treasury riches counted for nothing;"},{"id":"manas-2010:p0871:b001:l034","ordinal":38360,"en":"That shameless one herself,"},{"id":"manas-2010:p0871:b001:l035","ordinal":38361,"en":"What did she have, what did she lack!"},{"id":"manas-2010:p0871:b001:l036","ordinal":38362,"en":"Delighted at the word enemy,"},{"id":"manas-2010:p0871:b001:l037","ordinal":38363,"en":"The ill-fated one with a warrior's build,"},{"id":"manas-2010:p0871:b001:l038","ordinal":38364,"en":"Dressed herself in men's clothing."},{"id":"manas-2010:p0871:b001:l039","ordinal":38365,"en":"Hurrying eagerly, unconcerned,"},{"id":"manas-2010:p0871:b001:l040","ordinal":38366,"en":"‘He might defeat me,’"},{"id":"manas-2010:p0871:b001:l041","ordinal":38367,"en":"This Chubak standing there,"},{"id":"manas-2010:p0871:b001:l042","ordinal":38368,"en":"She did not reckon him worth a trouser-leg,"},{"id":"manas-2010:p0872:b001:l001","ordinal":38369,"en":"Her lovely hair, thick as a girth,"},{"id":"manas-2010:p0872:b001:l002","ordinal":38370,"en":"She bound snugly atop her head."},{"id":"manas-2010:p0872:b001:l003","ordinal":38371,"en":"A helmet no bullet could pierce,"},{"id":"manas-2010:p0872:b001:l004","ordinal":38372,"en":"Of deep-blue iron and keen steel,"},{"id":"manas-2010:p0872:b001:l005","ordinal":38373,"en":"She now lowered over her head."},{"id":"manas-2010:p0872:b001:l006","ordinal":38374,"en":"Armor to protect the ribs,"},{"id":"manas-2010:p0872:b001:l007","ordinal":38375,"en":"Above her navel,"},{"id":"manas-2010:p0872:b001:l008","ordinal":38376,"en":"That ill-fated one had put on"},{"id":"manas-2010:p0872:b001:l009","ordinal":38377,"en":"Iron no bullet could pierce."},{"id":"manas-2010:p0872:b001:l010","ordinal":38378,"en":"Fastening buttons over her whole body,"},{"id":"manas-2010:p0872:b001:l011","ordinal":38379,"en":"Her lovely, full-cheeked face,"},{"id":"manas-2010:p0872:b001:l012","ordinal":38380,"en":"She enclosed securely in armor."},{"id":"manas-2010:p0872:b001:l013","ordinal":38381,"en":"A gold-cheeked battle-axe,"},{"id":"manas-2010:p0872:b001:l014","ordinal":38382,"en":"Ready to seize it and strike,"},{"id":"manas-2010:p0872:b001:l015","ordinal":38383,"en":"Preparing and making ready,"},{"id":"manas-2010:p0872:b001:l016","ordinal":38384,"en":"She equipped herself thoroughly."},{"id":"manas-2010:p0872:b001:l017","ordinal":38385,"en":"A bright dagger for use in combat,"},{"id":"manas-2010:p0872:b001:l018","ordinal":38386,"en":"She hung upon her bare forearm."},{"id":"manas-2010:p0872:b001:l019","ordinal":38387,"en":"A gold-cheeked steel bow,"},{"id":"manas-2010:p0872:b001:l020","ordinal":38388,"en":"She hung upon her shoulder-blade."},{"id":"manas-2010:p0872:b001:l021","ordinal":38389,"en":"A painted spear with a socketed head,"},{"id":"manas-2010:p0872:b001:l022","ordinal":38390,"en":"Its point joined with steel,"},{"id":"manas-2010:p0872:b001:l023","ordinal":38391,"en":"‘Let it pierce when thrust against iron,"},{"id":"manas-2010:p0872:b001:l024","ordinal":38392,"en":"Let it enter without stopping,’ she said."},{"id":"manas-2010:p0872:b001:l025","ordinal":38393,"en":"Shaping the steel like a wolf's tongue,"},{"id":"manas-2010:p0872:b001:l026","ordinal":38394,"en":"She had it joined in separate pieces."},{"id":"manas-2010:p0872:b001:l027","ordinal":38395,"en":"‘Whatever it strikes,"},{"id":"manas-2010:p0872:b001:l028","ordinal":38396,"en":"Let the wound quickly worsen,’ she said."},{"id":"manas-2010:p0872:b001:l029","ordinal":38397,"en":"It was quenched in human tears."},{"id":"manas-2010:p0872:b001:l030","ordinal":38398,"en":"A woman spearing enemies,"},{"id":"manas-2010:p0872:b001:l031","ordinal":38399,"en":"Could there be such a soul,"},{"id":"manas-2010:p0872:b001:l032","ordinal":38400,"en":"Who brought joy to Bukhara's people!"}]
