[{"id":"manas-2010:p1355:b001:l027","ordinal":58625,"en":"They took no day's respite;"},{"id":"manas-2010:p1355:b001:l028","ordinal":58626,"en":"They did not rest at night,"},{"id":"manas-2010:p1355:b001:l029","ordinal":58627,"en":"They took no night's respite."},{"id":"manas-2010:p1355:b001:l030","ordinal":58628,"en":"Their heads became buckets of blood;"},{"id":"manas-2010:p1355:b001:l031","ordinal":58629,"en":"Their entire bodies"},{"id":"manas-2010:p1355:b001:l032","ordinal":58630,"en":"Were numb, unable to move."},{"id":"manas-2010:p1355:b001:l033","ordinal":58631,"en":"The dead were piled like mountains,"},{"id":"manas-2010:p1355:b001:l034","ordinal":58632,"en":"Gathered into mounds."},{"id":"manas-2010:p1355:b001:l035","ordinal":58633,"en":"The Chinese and the Kyrgyz then"},{"id":"manas-2010:p1355:b001:l036","ordinal":58634,"en":"Perished, making blood flow."},{"id":"manas-2010:p1355:b001:l037","ordinal":58635,"en":"The Chinese seethed in great numbers."},{"id":"manas-2010:p1355:b001:l038","ordinal":58636,"en":"Khan Manas's forty companions—"},{"id":"manas-2010:p1355:b001:l039","ordinal":58637,"en":"What kept them alive"},{"id":"manas-2010:p1355:b001:l040","ordinal":58638,"en":"Was broad-humped Zhelmaian,"},{"id":"manas-2010:p1355:b001:l041","ordinal":58639,"en":"Khan Manas's black camel Karanar,"},{"id":"manas-2010:p1355:b001:l042","ordinal":58640,"en":"With a golden halter on its head."},{"id":"manas-2010:p1356:b001:l001","ordinal":58641,"en":"No wind could match its trot,"},{"id":"manas-2010:p1356:b001:l002","ordinal":58642,"en":"No beast could match its walk."},{"id":"manas-2010:p1356:b001:l003","ordinal":58643,"en":"Without sparing its own life,"},{"id":"manas-2010:p1356:b001:l004","ordinal":58644,"en":"Zhelmaian had come along;"},{"id":"manas-2010:p1356:b001:l005","ordinal":58645,"en":"The travel food Kanykey had given,"},{"id":"manas-2010:p1356:b001:l006","ordinal":58646,"en":"Zhelmaian had carried as its load."},{"id":"manas-2010:p1356:b001:l007","ordinal":58647,"en":"In that fierce, slaughtering battle,"},{"id":"manas-2010:p1356:b001:l008","ordinal":58648,"en":"They dismounted in turns"},{"id":"manas-2010:p1356:b001:l009","ordinal":58649,"en":"And ate their fill."},{"id":"manas-2010:p1356:b001:l010","ordinal":58650,"en":"Khan Manas's forty companions"},{"id":"manas-2010:p1356:b001:l011","ordinal":58651,"en":"All mounted their horses"},{"id":"manas-2010:p1356:b001:l012","ordinal":58652,"en":"And entered the battle together."},{"id":"manas-2010:p1356:b001:l013","ordinal":58653,"en":"The Chinese people of forty khans"},{"id":"manas-2010:p1356:b001:l014","ordinal":58654,"en":"Had swept in and filled the place."},{"id":"manas-2010:p1356:b001:l015","ordinal":58655,"en":"Until now, the Great Campaign"},{"id":"manas-2010:p1356:b001:l016","ordinal":58656,"en":"Had been a battle such as this."},{"id":"manas-2010:p1356:b001:l017","ordinal":58657,"en":"The forty companions entered again,"},{"id":"manas-2010:p1356:b001:l018","ordinal":58658,"en":"With the remaining Burut heroes,"},{"id":"manas-2010:p1356:b001:l019","ordinal":58659,"en":"Their Khan Manas at their head,"},{"id":"manas-2010:p1356:b001:l020","ordinal":58660,"en":"And waged a fierce battle."},{"id":"manas-2010:p1356:b001:l021","ordinal":58661,"en":"The earth whirled and turned to dust;"},{"id":"manas-2010:p1356:b001:l022","ordinal":58662,"en":"Mixed with dust, the earth's face"},{"id":"manas-2010:p1356:b001:l023","ordinal":58663,"en":"Became a red river of blood."},{"id":"manas-2010:p1356:b001:l024","ordinal":58664,"en":"The peoples of forty khans were stirred;"},{"id":"manas-2010:p1356:b001:l025","ordinal":58665,"en":"The turmoil of this battle"},{"id":"manas-2010:p1356:b001:l026","ordinal":58666,"en":"Became the talk of the whole world."},{"id":"manas-2010:p1356:b001:l027","ordinal":58667,"en":"The Iron Giant and the Cast-Iron Giant"},{"id":"manas-2010:p1356:b001:l028","ordinal":58668,"en":"Had arrived there."},{"id":"manas-2010:p1356:b001:l029","ordinal":58669,"en":"Beyond all of them,"},{"id":"manas-2010:p1356:b001:l030","ordinal":58670,"en":"Madykan was the greater warrior."},{"id":"manas-2010:p1356:b001:l031","ordinal":58671,"en":"Had Khan Manas not been there,"},{"id":"manas-2010:p1356:b001:l032","ordinal":58672,"en":"Slaughtering the Buruts to the last,"},{"id":"manas-2010:p1356:b001:l033","ordinal":58673,"en":"He would have swept over them."},{"id":"manas-2010:p1356:b001:l034","ordinal":58674,"en":"Not letting Madykan through,"},{"id":"manas-2010:p1356:b001:l035","ordinal":58675,"en":"Warrior Manas, the leopard,"},{"id":"manas-2010:p1356:b001:l036","ordinal":58676,"en":"Was standing in his way."},{"id":"manas-2010:p1356:b001:l037","ordinal":58677,"en":"(With a heart like a lake, Manas—"},{"id":"manas-2010:p1356:b001:l038","ordinal":58678,"en":"Did you see how generous he was?"},{"id":"manas-2010:p1356:b001:l039","ordinal":58679,"en":"That imposing marvel—"},{"id":"manas-2010:p1356:b001:l040","ordinal":58680,"en":"Did you see what a lion he was?)"},{"id":"manas-2010:p1356:b001:l041","ordinal":58681,"en":"Madykan stood aiming his weapon;"},{"id":"manas-2010:p1356:b001:l042","ordinal":58682,"en":"Khan Manas stretched out and thrust."},{"id":"manas-2010:p1357:b001:l001","ordinal":58683,"en":"Madykan would not flinch;"},{"id":"manas-2010:p1357:b001:l002","ordinal":58684,"en":"Mighty Manas took no fright."},{"id":"manas-2010:p1357:b001:l003","ordinal":58685,"en":"Whipping his bull,"},{"id":"manas-2010:p1357:b001:l004","ordinal":58686,"en":"Surging forward with a roar,"},{"id":"manas-2010:p1357:b001:l005","ordinal":58687,"en":"Fire coming from his mouth,"},{"id":"manas-2010:p1357:b001:l006","ordinal":58688,"en":"Madykan thrust with both hands."},{"id":"manas-2010:p1357:b001:l007","ordinal":58689,"en":"Hero Manas stood unmoved."},{"id":"manas-2010:p1357:b001:l008","ordinal":58690,"en":"Raising pale clouds of dust,"},{"id":"manas-2010:p1357:b001:l009","ordinal":58691,"en":"They thrust without fleeing,"},{"id":"manas-2010:p1357:b001:l010","ordinal":58692,"en":"Sparing neither one another,"},{"id":"manas-2010:p1357:b001:l011","ordinal":58693,"en":"Striking with battle-axes,"},{"id":"manas-2010:p1357:b001:l012","ordinal":58694,"en":"Nor their own lives."},{"id":"manas-2010:p1357:b001:l013","ordinal":58695,"en":"Even then, neither could win;"},{"id":"manas-2010:p1357:b001:l014","ordinal":58696,"en":"The two lions stood staring at each other."},{"id":"manas-2010:p1357:b001:l015","ordinal":58697,"en":"Their inability to overcome each other"},{"id":"manas-2010:p1357:b001:l016","ordinal":58698,"en":"The Fierce One saw from afar."},{"id":"manas-2010:p1357:b001:l017","ordinal":58699,"en":"Cotton belt and broad boots—"},{"id":"manas-2010:p1357:b001:l018","ordinal":58700,"en":"Kongurbay, khan of the shaven-headed ones,"},{"id":"manas-2010:p1357:b001:l019","ordinal":58701,"en":"The wretch was foremost among lancers,"},{"id":"manas-2010:p1357:b001:l020","ordinal":58702,"en":"A clever wretch who knew the enemy's stratagems."},{"id":"manas-2010:p1357:b001:l021","ordinal":58703,"en":"“If your appointed hour comes, die!"},{"id":"manas-2010:p1357:b001:l022","ordinal":58704,"en":"If your appointed hour has not come,"},{"id":"manas-2010:p1357:b001:l023","ordinal":58705,"en":"Give your presence as support!” he said."},{"id":"manas-2010:p1357:b001:l024","ordinal":58706,"en":"All the champions,"},{"id":"manas-2010:p1357:b001:l025","ordinal":58707,"en":"The Chinese young and old,"},{"id":"manas-2010:p1357:b001:l026","ordinal":58708,"en":"Driving them on without leaving one,"},{"id":"manas-2010:p1357:b001:l027","ordinal":58709,"en":"Against Khan Manas"},{"id":"manas-2010:p1357:b001:l028","ordinal":58710,"en":"Kongurbay sent them in."},{"id":"manas-2010:p1357:b001:l029","ordinal":58711,"en":"The foremost lancers stood apart,"},{"id":"manas-2010:p1357:b001:l030","ordinal":58712,"en":"The crafty and the strongest,"},{"id":"manas-2010:p1357:b001:l031","ordinal":58713,"en":"All the champions,"},{"id":"manas-2010:p1357:b001:l032","ordinal":58714,"en":"All together as one,"},{"id":"manas-2010:p1357:b001:l033","ordinal":58715,"en":"Appeared ready to fight."},{"id":"manas-2010:p1357:b001:l034","ordinal":58716,"en":"The Flood had not swept in to scatter them;"},{"id":"manas-2010:p1357:b001:l035","ordinal":58717,"en":"They were a people who had survived."},{"id":"manas-2010:p1357:b001:l036","ordinal":58718,"en":"Alexander had left no footprints there;"},{"id":"manas-2010:p1357:b001:l037","ordinal":58719,"en":"The Chinese were an undisturbed people."},{"id":"manas-2010:p1357:b001:l038","ordinal":58720,"en":"They were numerous as sand and grass;"},{"id":"manas-2010:p1357:b001:l039","ordinal":58721,"en":"The more they died, the more they grew."},{"id":"manas-2010:p1357:b001:l040","ordinal":58722,"en":"The Chinese were a people reckless of death."},{"id":"manas-2010:p1357:b001:l041","ordinal":58723,"en":"When one thought them finished, they flared up;"},{"id":"manas-2010:p1357:b001:l042","ordinal":58724,"en":"Pressing like mist, they grew stronger."},{"id":"manas-2010:p1358:b001:l001","ordinal":58725,"en":"The Chinese were a deeply rooted people."},{"id":"manas-2010:p1358:b001:l002","ordinal":58726,"en":"The Chinese multitude"},{"id":"manas-2010:p1358:b001:l003","ordinal":58727,"en":"Was more numerous than ants."},{"id":"manas-2010:p1358:b001:l004","ordinal":58728,"en":"The campaign against Beijing"},{"id":"manas-2010:p1358:b001:l005","ordinal":58729,"en":"Was the misfortune of the Kyrgyz host."},{"id":"manas-2010:p1358:b001:l006","ordinal":58730,"en":"All around, the Chinese,"},{"id":"manas-2010:p1358:b001:l007","ordinal":58731,"en":"Seething like ants,"},{"id":"manas-2010:p1358:b001:l008","ordinal":58732,"en":"Were an army thicker than sand."},{"id":"manas-2010:p1358:b001:l009","ordinal":58733,"en":"When Khan Kongurbay drove them on,"},{"id":"manas-2010:p1358:b001:l010","ordinal":58734,"en":"Börüköz and Muzkindik"},{"id":"manas-2010:p1358:b001:l011","ordinal":58735,"en":"Entered together, ready for battle."},{"id":"manas-2010:p1358:b001:l012","ordinal":58736,"en":"Their great Lama champion,"},{"id":"manas-2010:p1358:b001:l013","ordinal":58737,"en":"Their Kalmyk, great Zholoy,"},{"id":"manas-2010:p1358:b001:l014","ordinal":58738,"en":"All swept in together."},{"id":"manas-2010:p1358:b001:l015","ordinal":58739,"en":"Riding a horse like Sarala,"},{"id":"manas-2010:p1358:b001:l016","ordinal":58740,"en":"Wearing yellow leather trousers,"},{"id":"manas-2010:p1358:b001:l017","ordinal":58741,"en":"Bearing a lance without a tassel,"},{"id":"manas-2010:p1358:b001:l018","ordinal":58742,"en":"With a bare sword girded on,"},{"id":"manas-2010:p1358:b001:l019","ordinal":58743,"en":"Azizkhan's Almambet"},{"id":"manas-2010:p1358:b001:l020","ordinal":58744,"en":"Entered among them."},{"id":"manas-2010:p1358:b001:l021","ordinal":58745,"en":"Wearing a blue ribbed-cloth coat,"},{"id":"manas-2010:p1358:b001:l022","ordinal":58746,"en":"Riding a horse like Kögala,"},{"id":"manas-2010:p1358:b001:l023","ordinal":58747,"en":"Tall in stature, broad in shoulder,"},{"id":"manas-2010:p1358:b001:l024","ordinal":58748,"en":"As huge as half a mountain,"},{"id":"manas-2010:p1358:b001:l025","ordinal":58749,"en":"Chubak, son of Akbaltay,"},{"id":"manas-2010:p1358:b001:l026","ordinal":58750,"en":"Whom no man's strength could overcome,"},{"id":"manas-2010:p1358:b001:l027","ordinal":58751,"en":"Whom a lion's teeth could not pierce,"},{"id":"manas-2010:p1358:b001:l028","ordinal":58752,"en":"Without sparing himself, into battle"},{"id":"manas-2010:p1358:b001:l029","ordinal":58753,"en":"He too entered with a roar."},{"id":"manas-2010:p1358:b001:l030","ordinal":58754,"en":"Behind that Chubak,"},{"id":"manas-2010:p1358:b001:l031","ordinal":58755,"en":"A bringer of good fortune when set in front,"},{"id":"manas-2010:p1358:b001:l032","ordinal":58756,"en":"Like a vast army when following behind,"},{"id":"manas-2010:p1358:b001:l033","ordinal":58757,"en":"Riding a horse like the gray steed,"},{"id":"manas-2010:p1358:b001:l034","ordinal":58758,"en":"Wearing a gray lynx-fur cap,"},{"id":"manas-2010:p1358:b001:l035","ordinal":58759,"en":"Never turning back from the foe,"},{"id":"manas-2010:p1358:b001:l036","ordinal":58760,"en":"Never retreating at the word of death,"},{"id":"manas-2010:p1358:b001:l037","ordinal":58761,"en":"Hero Bakay, that saintly old man,"},{"id":"manas-2010:p1358:b001:l038","ordinal":58762,"en":"Entered the battle there."},{"id":"manas-2010:p1358:b001:l039","ordinal":58763,"en":"The hour for death had come."},{"id":"manas-2010:p1358:b001:l040","ordinal":58764,"en":"Into the Chinese he plunged—"},{"id":"manas-2010:p1358:b001:l041","ordinal":58765,"en":"Have you heard of him?—"},{"id":"manas-2010:p1358:b001:l042","ordinal":58766,"en":"Khan Manas's Syrgak."},{"id":"manas-2010:p1359:b001:l001","ordinal":58767,"en":"All the champions moved apart;"},{"id":"manas-2010:p1359:b001:l002","ordinal":58768,"en":"All the champions"},{"id":"manas-2010:p1359:b001:l003","ordinal":58769,"en":"Entered against the Chinese together."},{"id":"manas-2010:p1359:b001:l004","ordinal":58770,"en":"Khan Manas's forty companions,"},{"id":"manas-2010:p1359:b001:l005","ordinal":58771,"en":"Without looking round,"},{"id":"manas-2010:p1359:b001:l006","ordinal":58772,"en":"Without sparing their frail lives,"},{"id":"manas-2010:p1359:b001:l007","ordinal":58773,"en":"Entered the battle in earnest."},{"id":"manas-2010:p1359:b001:l008","ordinal":58774,"en":"“Against the looming Chinese multitude"},{"id":"manas-2010:p1359:b001:l009","ordinal":58775,"en":"I shall level my lance straight;"},{"id":"manas-2010:p1359:b001:l010","ordinal":58776,"en":"From this hell of grievous torment"},{"id":"manas-2010:p1359:b001:l011","ordinal":58777,"en":"I shall free my soul!” they said."},{"id":"manas-2010:p1359:b001:l012","ordinal":58778,"en":"Khan Manas's forty companions"},{"id":"manas-2010:p1359:b001:l013","ordinal":58779,"en":"All entered together,"},{"id":"manas-2010:p1359:b001:l014","ordinal":58780,"en":"Their lances swaying in their hands,"},{"id":"manas-2010:p1359:b001:l015","ordinal":58781,"en":"Bathed in dark sweat."},{"id":"manas-2010:p1359:b001:l016","ordinal":58782,"en":"The forty companions went forward,"},{"id":"manas-2010:p1359:b001:l017","ordinal":58783,"en":"Bringing slaughter upon the Chinese,"},{"id":"manas-2010:p1359:b001:l018","ordinal":58784,"en":"Drenched in red blood."},{"id":"manas-2010:p1359:b001:l019","ordinal":58785,"en":"With Muzburchak and Kökchö as khans,"},{"id":"manas-2010:p1359:b001:l020","ordinal":58786,"en":"And Koshoy and Töshtük as heroes,"},{"id":"manas-2010:p1359:b001:l021","ordinal":58787,"en":"They entered the battle again."},{"id":"manas-2010:p1359:b001:l022","ordinal":58788,"en":"The earth's face became blood;"},{"id":"manas-2010:p1359:b001:l023","ordinal":58789,"en":"The whole sky became dust."},{"id":"manas-2010:p1359:b001:l024","ordinal":58790,"en":"Losing their reason,"},{"id":"manas-2010:p1359:b001:l025","ordinal":58791,"en":"All who witnessed it"},{"id":"manas-2010:p1359:b001:l026","ordinal":58792,"en":"Lost their senses and stood numb."},{"id":"manas-2010:p1359:b001:l027","ordinal":58793,"en":"The earth whirled and surged;"},{"id":"manas-2010:p1359:b001:l028","ordinal":58794,"en":"With no telling who was who,"},{"id":"manas-2010:p1359:b001:l029","ordinal":58795,"en":"The Chinese and the Kyrgyz then"},{"id":"manas-2010:p1359:b001:l030","ordinal":58796,"en":"Mingled, their reins side by side."},{"id":"manas-2010:p1359:b001:l031","ordinal":58797,"en":"They joined, then broke apart;"},{"id":"manas-2010:p1359:b001:l032","ordinal":58798,"en":"Their seams split and they separated."},{"id":"manas-2010:p1359:b001:l033","ordinal":58799,"en":"On that field of battle"},{"id":"manas-2010:p1359:b001:l034","ordinal":58800,"en":"Many corpses lay."},{"id":"manas-2010:p1359:b001:l035","ordinal":58801,"en":"Within this battle,"},{"id":"manas-2010:p1359:b001:l036","ordinal":58802,"en":"Remembered by the name Great Campaign,"},{"id":"manas-2010:p1359:b001:l037","ordinal":58803,"en":"They grappled, leaving no regret,"},{"id":"manas-2010:p1359:b001:l038","ordinal":58804,"en":"They fought without sparing one another."},{"id":"manas-2010:p1359:b001:l039","ordinal":58805,"en":"Those whose hour had come died,"},{"id":"manas-2010:p1359:b001:l040","ordinal":58806,"en":"Pouring out red blood."},{"id":"manas-2010:p1359:b001:l041","ordinal":58807,"en":"Many a splendid steed died;"},{"id":"manas-2010:p1359:b001:l042","ordinal":58808,"en":"Fighting men and heroes died."},{"id":"manas-2010:p1360:b001:l001","ordinal":58809,"en":"Many a mighty khan died;"},{"id":"manas-2010:p1360:b001:l002","ordinal":58810,"en":"All who encountered them died."},{"id":"manas-2010:p1360:b001:l003","ordinal":58811,"en":"They fought one against one,"},{"id":"manas-2010:p1360:b001:l004","ordinal":58812,"en":"Separating to grapple."},{"id":"manas-2010:p1360:b001:l005","ordinal":58813,"en":"The heroes, heated with battle,"},{"id":"manas-2010:p1360:b001:l006","ordinal":58814,"en":"Turned back and fought,"},{"id":"manas-2010:p1360:b001:l007","ordinal":58815,"en":"Wrenching one another from horseback,"},{"id":"manas-2010:p1360:b001:l008","ordinal":58816,"en":"Heaving this way and that."},{"id":"manas-2010:p1360:b001:l009","ordinal":58817,"en":"Those whose horses had died"},{"id":"manas-2010:p1360:b001:l010","ordinal":58818,"en":"Wrestled on foot,"},{"id":"manas-2010:p1360:b001:l011","ordinal":58819,"en":"Unable to throw one another."},{"id":"manas-2010:p1360:b001:l012","ordinal":58820,"en":"Their clothes were torn to shreds;"},{"id":"manas-2010:p1360:b001:l013","ordinal":58821,"en":"They shoved this way and that."},{"id":"manas-2010:p1360:b001:l014","ordinal":58822,"en":"Some, having thrown their foe,"},{"id":"manas-2010:p1360:b001:l015","ordinal":58823,"en":"Cut off his head;"},{"id":"manas-2010:p1360:b001:l016","ordinal":58824,"en":"They split open bellies and entrails,"},{"id":"manas-2010:p1360:b001:l017","ordinal":58825,"en":"Sparing neither one another,"},{"id":"manas-2010:p1360:b001:l018","ordinal":58826,"en":"Nor heeding whether few or many,"},{"id":"manas-2010:p1360:b001:l019","ordinal":58827,"en":"And made blood flow then."},{"id":"manas-2010:p1360:b001:l020","ordinal":58828,"en":"Azizkhan's Almambet,"},{"id":"manas-2010:p1360:b001:l021","ordinal":58829,"en":"Whipping Sarala,"},{"id":"manas-2010:p1360:b001:l022","ordinal":58830,"en":"That majestic, mighty lion,"},{"id":"manas-2010:p1360:b001:l023","ordinal":58831,"en":"Reached Börüköz."},{"id":"manas-2010:p1360:b001:l024","ordinal":58832,"en":"That champion Börüköz"},{"id":"manas-2010:p1360:b001:l025","ordinal":58833,"en":"He hurled down as he passed."},{"id":"manas-2010:p1360:b001:l026","ordinal":58834,"en":"The keen-eyed one who had seen much,"},{"id":"manas-2010:p1360:b001:l027","ordinal":58835,"en":"Fierce-maned Bakay, the leopard—"},{"id":"manas-2010:p1360:b001:l028","ordinal":58836,"en":"Before a Chinese champion"},{"id":"manas-2010:p1360:b001:l029","ordinal":58837,"en":"Could lift him onto a horse,"},{"id":"manas-2010:p1360:b001:l030","ordinal":58838,"en":"He struck his head off as he passed."},{"id":"manas-2010:p1360:b001:l031","ordinal":58839,"en":"“Börüköz is dead!” they said,"},{"id":"manas-2010:p1360:b001:l032","ordinal":58840,"en":"Sending word to their khan,"},{"id":"manas-2010:p1360:b001:l033","ordinal":58841,"en":"To the Chinese emperor's city."},{"id":"manas-2010:p1360:b001:l034","ordinal":58842,"en":"In the mist of the thick battle,"},{"id":"manas-2010:p1360:b001:l035","ordinal":58843,"en":"Fierce-maned Khan Azhybay,"},{"id":"manas-2010:p1360:b001:l036","ordinal":58844,"en":"From the back of Kartküröng,"},{"id":"manas-2010:p1360:b001:l037","ordinal":58845,"en":"Khan Zholoy of the Kalmyks"},{"id":"manas-2010:p1360:b001:l038","ordinal":58846,"en":"Had hurled down as he passed."},{"id":"manas-2010:p1360:b001:l039","ordinal":58847,"en":"His swift horse Kartküröng"},{"id":"manas-2010:p1360:b001:l040","ordinal":58848,"en":"Into the hands of the great Kalmyk Lama"},{"id":"manas-2010:p1360:b001:l041","ordinal":58849,"en":"Had fallen."},{"id":"manas-2010:p1360:b001:l042","ordinal":58850,"en":"With his wing broken,"},{"id":"manas-2010:p1361:b001:l001","ordinal":58851,"en":"Your champion Khan Azhybay"},{"id":"manas-2010:p1361:b001:l002","ordinal":58852,"en":"Had been parted from Kartküröng."},{"id":"manas-2010:p1361:b001:l003","ordinal":58853,"en":"Kartküröng was being led along,"},{"id":"manas-2010:p1361:b001:l004","ordinal":58854,"en":"In the Lama's hands."},{"id":"manas-2010:p1361:b001:l005","ordinal":58855,"en":"“This is how to destroy the Buruts!”"},{"id":"manas-2010:p1361:b001:l006","ordinal":58856,"en":"The Lama kept training him."},{"id":"manas-2010:p1361:b001:l007","ordinal":58857,"en":"“A splendid steed taken from the Buruts!”"},{"id":"manas-2010:p1361:b001:l008","ordinal":58858,"en":"The Lama kept praising him."},{"id":"manas-2010:p1361:b001:l009","ordinal":58859,"en":"“If a saddle-pad is laid upon him,"},{"id":"manas-2010:p1361:b001:l010","ordinal":58860,"en":"He is a beast to ride to Beijing."},{"id":"manas-2010:p1361:b001:l011","ordinal":58861,"en":"With its protective covering on,"},{"id":"manas-2010:p1361:b001:l012","ordinal":58862,"en":"He is a beast for a governor to ride."},{"id":"manas-2010:p1361:b001:l013","ordinal":58863,"en":"To load with gold and silver,"},{"id":"manas-2010:p1361:b001:l014","ordinal":58864,"en":"To present to Esenkan,"},{"id":"manas-2010:p1361:b001:l015","ordinal":58865,"en":"He is a swift and fitting beast!”"},{"id":"manas-2010:p1361:b001:l016","ordinal":58866,"en":"Kartküröng was being led along,"},{"id":"manas-2010:p1361:b001:l017","ordinal":58867,"en":"In the Lama's hands."},{"id":"manas-2010:p1361:b001:l018","ordinal":58868,"en":"Azhybay went about wailing,"},{"id":"manas-2010:p1361:b001:l019","ordinal":58869,"en":"His hatchet and short musket on his back."},{"id":"manas-2010:p1361:b001:l020","ordinal":58870,"en":"The Chinese ran in surging ranks;"},{"id":"manas-2010:p1361:b001:l021","ordinal":58871,"en":"When they came pressing upon him,"},{"id":"manas-2010:p1361:b001:l022","ordinal":58872,"en":"Azhybay despaired of his life."},{"id":"manas-2010:p1361:b001:l023","ordinal":58873,"en":"Ezkara and Karazhoy,"},{"id":"manas-2010:p1361:b001:l024","ordinal":58874,"en":"Their khans, now arrived."},{"id":"manas-2010:p1361:b001:l025","ordinal":58875,"en":"To seize Azhybay,"},{"id":"manas-2010:p1361:b001:l026","ordinal":58876,"en":"The Chinese massed together."},{"id":"manas-2010:p1361:b001:l027","ordinal":58877,"en":"At that moment hero Syrgak,"},{"id":"manas-2010:p1361:b001:l028","ordinal":58878,"en":"Seeing this, went toward him."},{"id":"manas-2010:p1361:b001:l029","ordinal":58879,"en":"Never resting upon an elbow,"},{"id":"manas-2010:p1361:b001:l030","ordinal":58880,"en":"Never taking a moment's sleep,"}]
