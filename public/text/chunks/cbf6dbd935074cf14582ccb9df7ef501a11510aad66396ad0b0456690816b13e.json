[{"id":"semetey-1-2013:p1186:b004:l013","ordinal":167681,"en":"Struck at the horses and drove them."},{"id":"semetey-1-2013:p1186:b004:l014","ordinal":167682,"en":"Beside young Aydar"},{"id":"semetey-1-2013:p1186:b004:l015","ordinal":167683,"en":"Were exactly two hundred champions."},{"id":"semetey-1-2013:p1186:b004:l016","ordinal":167684,"en":"Old leopard Bakay"},{"id":"semetey-1-2013:p1186:b004:l017","ordinal":167685,"en":"Shouted in anger,"},{"id":"semetey-1-2013:p1186:b004:l018","ordinal":167686,"en":"Calling to young Aydar:"},{"id":"semetey-1-2013:p1186:b004:l019","ordinal":167687,"en":"\"Hey, young Aydar, drive the horses;"},{"id":"semetey-1-2013:p1186:b004:l020","ordinal":167688,"en":"Drive all the horses swiftly."},{"id":"semetey-1-2013:p1186:b004:l021","ordinal":167689,"en":"If you drive on from here,"},{"id":"semetey-1-2013:p1186:b004:l022","ordinal":167690,"en":"Ridge after ridge will come,"},{"id":"semetey-1-2013:p1186:b004:l023","ordinal":167691,"en":"Rough foothills will come,"},{"id":"semetey-1-2013:p1186:b004:l024","ordinal":167692,"en":"And a shimmering desert will come."},{"id":"semetey-1-2013:p1186:b004:l025","ordinal":167693,"en":"Where a raven goes, its ears,"},{"id":"semetey-1-2013:p1186:b004:l026","ordinal":167694,"en":"Where a kulan goes, its hooves,"},{"id":"semetey-1-2013:p1186:b004:l027","ordinal":167695,"en":"Will be scorched by the ground."},{"id":"semetey-1-2013:p1186:b004:l028","ordinal":167696,"en":"As you continue driving them,"},{"id":"semetey-1-2013:p1186:b004:l029","ordinal":167697,"en":"Among saxaul wood and black sand,"},{"id":"semetey-1-2013:p1186:b004:l030","ordinal":167698,"en":"This is where you must release them:"},{"id":"semetey-1-2013:p1186:b004:l031","ordinal":167699,"en":"At that lower black ridge."},{"id":"semetey-1-2013:p1186:b004:l032","ordinal":167700,"en":"Foal of a bay mare,"},{"id":"semetey-1-2013:p1186:b004:l033","ordinal":167701,"en":"Tulpar of the black herd—"},{"id":"semetey-1-2013:p1186:b004:l034","ordinal":167702,"en":"When you release Akkula,"},{"id":"semetey-1-2013:p1186:b004:l035","ordinal":167703,"en":"That is Akkula's country.\""},{"id":"semetey-1-2013:p1186:b004:l036","ordinal":167704,"en":"Young Aydar of the flowing forelock—"},{"id":"semetey-1-2013:p1186:b004:l037","ordinal":167705,"en":"To young Aydar himself"},{"id":"semetey-1-2013:p1186:b004:l038","ordinal":167706,"en":"He taught what he did not know."},{"id":"semetey-1-2013:p1187:b003:l001","ordinal":167707,"en":"Thus setting them upon the road,"},{"id":"semetey-1-2013:p1187:b003:l002","ordinal":167708,"en":"The racehorses streamed out in splendor."},{"id":"semetey-1-2013:p1187:b003:l003","ordinal":167709,"en":"All the chosen tulpar steeds,"},{"id":"semetey-1-2013:p1187:b003:l004","ordinal":167710,"en":"While infidel and Muslim"},{"id":"semetey-1-2013:p1187:b003:l005","ordinal":167711,"en":"Stood clashing together,"},{"id":"semetey-1-2013:p1187:b003:l006","ordinal":167712,"en":"Young Aydar of the flowing forelock"},{"id":"semetey-1-2013:p1187:b003:l007","ordinal":167713,"en":"Went out and drove them."},{"id":"semetey-1-2013:p1187:b004:l001","ordinal":167714,"en":"Two hundred youths were beside him."},{"id":"semetey-1-2013:p1187:b004:l002","ordinal":167715,"en":"After young Aydar drove them away,"},{"id":"semetey-1-2013:p1187:b004:l003","ordinal":167716,"en":"After they reached the starting place,"},{"id":"semetey-1-2013:p1187:b004:l004","ordinal":167717,"en":"Let us leave that matter there"},{"id":"semetey-1-2013:p1187:b004:l005","ordinal":167718,"en":"And begin from this side:"},{"id":"semetey-1-2013:p1187:b004:l006","ordinal":167719,"en":"Kokotoy's Bokmurun"},{"id":"semetey-1-2013:p1187:b004:l007","ordinal":167720,"en":"Sent out another announcement."},{"id":"semetey-1-2013:p1187:b006:l001","ordinal":167721,"en":"Kokotoy's Bokmurun"},{"id":"semetey-1-2013:p1187:b006:l002","ordinal":167722,"en":"Proclaimed before the multitude:"},{"id":"semetey-1-2013:p1187:b006:l003","ordinal":167723,"en":"\"Sons of Adam have gathered;"},{"id":"semetey-1-2013:p1187:b006:l004","ordinal":167724,"en":"You old men have come."},{"id":"semetey-1-2013:p1187:b006:l005","ordinal":167725,"en":"All you heroes and noble champions"},{"id":"semetey-1-2013:p1187:b006:l006","ordinal":167726,"en":"Have come."},{"id":"semetey-1-2013:p1187:b006:l007","ordinal":167727,"en":"The leopard supported by the Shah,"},{"id":"semetey-1-2013:p1187:b006:l008","ordinal":167728,"en":"Your lion, has come."},{"id":"semetey-1-2013:p1187:b006:l009","ordinal":167729,"en":"The hero who knows well the enemy's devices"},{"id":"semetey-1-2013:p1187:b006:l010","ordinal":167730,"en":"Has come."},{"id":"semetey-1-2013:p1187:b006:l011","ordinal":167731,"en":"He who says, 'I trust in God above,'"},{"id":"semetey-1-2013:p1187:b006:l012","ordinal":167732,"en":"Has come."},{"id":"semetey-1-2013:p1187:b006:l013","ordinal":167733,"en":"The tireless noble champion,"},{"id":"semetey-1-2013:p1187:b006:l014","ordinal":167734,"en":"Your valiant man, has come."},{"id":"semetey-1-2013:p1187:b006:l015","ordinal":167735,"en":"This is the foremost of great gatherings;"},{"id":"semetey-1-2013:p1187:b006:l016","ordinal":167736,"en":"This is my khan father's memorial feast."},{"id":"semetey-1-2013:p1187:b006:l017","ordinal":167737,"en":"The horses must reach their ground;"},{"id":"semetey-1-2013:p1187:b006:l018","ordinal":167738,"en":"Until the horses return,"},{"id":"semetey-1-2013:p1187:b006:l019","ordinal":167739,"en":"Will the people not grow weary?"},{"id":"semetey-1-2013:p1187:b006:l020","ordinal":167740,"en":"I stake a camel with its load,"},{"id":"semetey-1-2013:p1187:b006:l021","ordinal":167741,"en":"And exactly sixty servants."},{"id":"semetey-1-2013:p1187:b006:l022","ordinal":167742,"en":"Let one champion come from the infidels"},{"id":"semetey-1-2013:p1187:b006:l023","ordinal":167743,"en":"And one champion from the Muslims."},{"id":"semetey-1-2013:p1187:b006:l024","ordinal":167744,"en":"Let their lances bend;"},{"id":"semetey-1-2013:p1187:b006:l025","ordinal":167745,"en":"Let the heroes come out and joust."},{"id":"semetey-1-2013:p1187:b006:l026","ordinal":167746,"en":"Let those whose death has come die,"},{"id":"semetey-1-2013:p1187:b006:l027","ordinal":167747,"en":"And spill a lion's blood."},{"id":"semetey-1-2013:p1187:b006:l028","ordinal":167748,"en":"Let them charge and pierce"},{"id":"semetey-1-2013:p1187:b008:l001","ordinal":167749,"en":"The ridge of the ribs;"},{"id":"semetey-1-2013:p1187:b008:l002","ordinal":167750,"en":"Let them make a spectacle for the people"},{"id":"semetey-1-2013:p1187:b008:l003","ordinal":167751,"en":"And fight lance against lance."},{"id":"semetey-1-2013:p1187:b008:l004","ordinal":167752,"en":"Let them come out to joust;"},{"id":"semetey-1-2013:p1187:b008:l005","ordinal":167753,"en":"Let the one who strikes win the prize,"},{"id":"semetey-1-2013:p1187:b008:l006","ordinal":167754,"en":"And the one struck remain empty-handed.\""},{"id":"semetey-1-2013:p1187:b008:l007","ordinal":167755,"en":"When Bokmurun said this,"},{"id":"semetey-1-2013:p1187:b008:l008","ordinal":167756,"en":"To gain much profit as plunder—"},{"id":"semetey-1-2013:p1187:b008:l009","ordinal":167757,"en":"That was when Kongurbay had failed."},{"id":"semetey-1-2013:p1187:b008:l010","ordinal":167758,"en":"Algara beneath him,"},{"id":"semetey-1-2013:p1187:b008:l011","ordinal":167759,"en":"The prancing black horse,"},{"id":"semetey-1-2013:p1187:b008:l012","ordinal":167760,"en":"He had not been able to race."},{"id":"semetey-1-2013:p1187:b008:l013","ordinal":167761,"en":"He was destined to joust with Manas"},{"id":"semetey-1-2013:p1187:b008:l014","ordinal":167762,"en":"And cause turmoil"},{"id":"semetey-1-2013:p1187:b008:l015","ordinal":167763,"en":"At Kokotoy's feast."},{"id":"semetey-1-2013:p1187:b008:l016","ordinal":167764,"en":"That Akkula would race—"},{"id":"semetey-1-2013:p1187:b008:l017","ordinal":167765,"en":"Kongurbay knew it."},{"id":"semetey-1-2013:p1187:b008:l018","ordinal":167766,"en":"\"May he lose Akkula"},{"id":"semetey-1-2013:p1187:b008:l019","ordinal":167767,"en":"And stand gawking on foot;"},{"id":"semetey-1-2013:p1187:b008:l020","ordinal":167768,"en":"May I take revenge for my father.\""},{"id":"semetey-1-2013:p1187:b008:l021","ordinal":167769,"en":"He had long desired this."},{"id":"semetey-1-2013:p1187:b008:l022","ordinal":167770,"en":"\"Before he can pull aside,"},{"id":"semetey-1-2013:p1187:b008:l023","ordinal":167771,"en":"Stallion-like Manas—"},{"id":"semetey-1-2013:p1187:b008:l024","ordinal":167772,"en":"I will thrust a spear into his muscle;"},{"id":"semetey-1-2013:p1187:b008:l025","ordinal":167773,"en":"Raging Manas—"},{"id":"semetey-1-2013:p1187:b008:l026","ordinal":167774,"en":"I will split him before the assembled people;"},{"id":"semetey-1-2013:p1187:b008:l027","ordinal":167775,"en":"From bloodletter Manas the Burut,"},{"id":"semetey-1-2013:p1187:b008:l028","ordinal":167776,"en":"I will take my revenge alone."},{"id":"semetey-1-2013:p1188:b003:l001","ordinal":167777,"en":"If I spear his Manas and lay him low,"},{"id":"semetey-1-2013:p1188:b003:l002","ordinal":167778,"en":"I will crush and drive away"},{"id":"semetey-1-2013:p1188:b003:l003","ordinal":167779,"en":"The Buruts who came to the feast,"},{"id":"semetey-1-2013:p1188:b003:l004","ordinal":167780,"en":"Humiliate Khan Koshoy,"},{"id":"semetey-1-2013:p1188:b003:l005","ordinal":167781,"en":"Overpower Khan Bakay,"},{"id":"semetey-1-2013:p1188:b003:l006","ordinal":167782,"en":"And bind without killing"},{"id":"semetey-1-2013:p1188:b003:l007","ordinal":167783,"en":"Old Koshoy and Bakay."},{"id":"semetey-1-2013:p1188:b003:l008","ordinal":167784,"en":"I will utterly smash and slaughter"},{"id":"semetey-1-2013:p1188:b003:l009","ordinal":167785,"en":"All the Buruts."},{"id":"semetey-1-2013:p1188:b003:l010","ordinal":167786,"en":"I will not let them taste their salt;"},{"id":"semetey-1-2013:p1188:b003:l011","ordinal":167787,"en":"I will plunder their daughters,"},{"id":"semetey-1-2013:p1188:b003:l012","ordinal":167788,"en":"Bind their heroes,"},{"id":"semetey-1-2013:p1188:b003:l013","ordinal":167789,"en":"Of the accursed Buruts,"},{"id":"semetey-1-2013:p1188:b003:l014","ordinal":167790,"en":"And take their wives as booty.\""},{"id":"semetey-1-2013:p1188:b003:l015","ordinal":167791,"en":"He angrily spurred"},{"id":"semetey-1-2013:p1188:b003:l016","ordinal":167792,"en":"The horse Algara beneath him;"},{"id":"semetey-1-2013:p1188:b003:l017","ordinal":167793,"en":"Incorrigible Kongurbay"},{"id":"semetey-1-2013:p1188:b003:l018","ordinal":167794,"en":"Made it pace over rise and hollow."},{"id":"semetey-1-2013:p1188:b003:l019","ordinal":167795,"en":"Wrapped in blue armor,"},{"id":"semetey-1-2013:p1188:b003:l020","ordinal":167796,"en":"Kongurbay, if you saw him,"},{"id":"semetey-1-2013:p1188:b003:l021","ordinal":167797,"en":"Strained like a blue tiger."},{"id":"semetey-1-2013:p1188:b003:l022","ordinal":167798,"en":"His eyes were the size of a lake;"},{"id":"semetey-1-2013:p1188:b003:l023","ordinal":167799,"en":"If you saw the Chinese man,"},{"id":"semetey-1-2013:p1188:b003:l024","ordinal":167800,"en":"Kongurbay was gray-maned."},{"id":"semetey-1-2013:p1188:b003:l025","ordinal":167801,"en":"He had brows like a lying dog"},{"id":"semetey-1-2013:p1188:b003:l026","ordinal":167802,"en":"And a head like a great cauldron."},{"id":"semetey-1-2013:p1188:b003:l027","ordinal":167803,"en":"He had reached twenty-five;"},{"id":"semetey-1-2013:p1188:b003:l028","ordinal":167804,"en":"That was his age this year."},{"id":"semetey-1-2013:p1188:b003:l029","ordinal":167805,"en":"His right shoulder was broad;"},{"id":"semetey-1-2013:p1188:b003:l030","ordinal":167806,"en":"He was a lion born under favor."},{"id":"semetey-1-2013:p1188:b003:l031","ordinal":167807,"en":"All twelve limbs were perfectly matched."},{"id":"semetey-1-2013:p1188:b003:l032","ordinal":167808,"en":"For Beijing in Kakanchyn,"},{"id":"semetey-1-2013:p1188:b003:l033","ordinal":167809,"en":"God Almighty had created him"},{"id":"semetey-1-2013:p1188:b003:l034","ordinal":167810,"en":"As a defending lion."},{"id":"semetey-1-2013:p1188:b003:l035","ordinal":167811,"en":"His bearing was extraordinary:"},{"id":"semetey-1-2013:p1188:b003:l036","ordinal":167812,"en":"Kongurbay, son of Alooke,"},{"id":"semetey-1-2013:p1188:b003:l037","ordinal":167813,"en":"The noble champion who came from Beijing."},{"id":"semetey-1-2013:p1188:b003:l038","ordinal":167814,"en":"Among the Chinese in Beijing"},{"id":"semetey-1-2013:p1188:b003:l039","ordinal":167815,"en":"A khan named Alooke arose;"},{"id":"semetey-1-2013:p1188:b004:l001","ordinal":167816,"en":"Kongurbay, son of Alooke,"},{"id":"semetey-1-2013:p1188:b004:l002","ordinal":167817,"en":"Drove life out with his voice,"},{"id":"semetey-1-2013:p1188:b004:l003","ordinal":167818,"en":"And drew embers from the hearth."},{"id":"semetey-1-2013:p1188:b004:l004","ordinal":167819,"en":"For Kokotoy's joust"},{"id":"semetey-1-2013:p1188:b004:l005","ordinal":167820,"en":"The mighty Kongurbay came out."},{"id":"semetey-1-2013:p1188:b004:l006","ordinal":167821,"en":"Roaring and swaggering,"},{"id":"semetey-1-2013:p1188:b004:l007","ordinal":167822,"en":"Raging and stamping,"},{"id":"semetey-1-2013:p1188:b004:l008","ordinal":167823,"en":"Kongurbay and Algara"},{"id":"semetey-1-2013:p1188:b004:l009","ordinal":167824,"en":"Came together."},{"id":"semetey-1-2013:p1188:b004:l010","ordinal":167825,"en":"Six thousand Chinese and forty commanders"},{"id":"semetey-1-2013:p1188:b004:l011","ordinal":167826,"en":"Mingled as his followers,"},{"id":"semetey-1-2013:p1188:b004:l012","ordinal":167827,"en":"Leading Kongurbay,"},{"id":"semetey-1-2013:p1188:b004:l013","ordinal":167828,"en":"Preparing his every maneuver,"},{"id":"semetey-1-2013:p1188:b004:l014","ordinal":167829,"en":"And placing exactly sixty spears"},{"id":"semetey-1-2013:p1188:b004:l015","ordinal":167830,"en":"In the Manchus' hands."},{"id":"semetey-1-2013:p1188:b004:l016","ordinal":167831,"en":"Leather belt and twisted waist,"},{"id":"semetey-1-2013:p1188:b004:l017","ordinal":167832,"en":"The raging hero Kalcha;"},{"id":"semetey-1-2013:p1188:b004:l018","ordinal":167833,"en":"Golden crest and tasseled belt,"},{"id":"semetey-1-2013:p1188:b004:l019","ordinal":167834,"en":"The lordly great Kalcha;"},{"id":"semetey-1-2013:p1188:b004:l020","ordinal":167835,"en":"His bristling mustache"},{"id":"semetey-1-2013:p1188:b004:l021","ordinal":167836,"en":"Was like nettles grown by an outhouse,"},{"id":"semetey-1-2013:p1188:b004:l022","ordinal":167837,"en":"And the filth of his pipe"},{"id":"semetey-1-2013:p1188:b004:l023","ordinal":167838,"en":"Like grain mash eaten by sooty children."},{"id":"semetey-1-2013:p1188:b004:l024","ordinal":167839,"en":"He strained upon Algara,"},{"id":"semetey-1-2013:p1188:b004:l025","ordinal":167840,"en":"Jerking the golden reins."},{"id":"semetey-1-2013:p1188:b004:l026","ordinal":167841,"en":"The sight made one's heart waver;"},{"id":"semetey-1-2013:p1188:b004:l027","ordinal":167842,"en":"If you saw Kongurbay,"},{"id":"semetey-1-2013:p1188:b004:l028","ordinal":167843,"en":"He loomed like Ala-Too."},{"id":"semetey-1-2013:p1188:b004:l029","ordinal":167844,"en":"Bulletproof blue armor,"},{"id":"semetey-1-2013:p1188:b004:l030","ordinal":167845,"en":"Strong armor upon his chest,"},{"id":"semetey-1-2013:p1188:b004:l031","ordinal":167846,"en":"He wore it twelve layers deep."},{"id":"semetey-1-2013:p1188:b004:l032","ordinal":167847,"en":"He rejoiced at the word \"enemy.\""},{"id":"semetey-1-2013:p1188:b004:l033","ordinal":167848,"en":"With noble champion Manas—"},{"id":"semetey-1-2013:p1188:b004:l034","ordinal":167849,"en":"He knew he would fight to the death."},{"id":"semetey-1-2013:p1188:b004:l035","ordinal":167850,"en":"The bulletproof mail—"},{"id":"semetey-1-2013:p1188:b004:l036","ordinal":167851,"en":"He knew he would wear it."},{"id":"semetey-1-2013:p1188:b004:l037","ordinal":167852,"en":"Destroyer Manas and Kongurbay—"},{"id":"semetey-1-2013:p1188:b004:l038","ordinal":167853,"en":"He knew they would clash."},{"id":"semetey-1-2013:p1188:b004:l039","ordinal":167854,"en":"Sixty noblemen,"},{"id":"semetey-1-2013:p1189:b003:l001","ordinal":167855,"en":"Youngest son of Khan Alooke,"},{"id":"semetey-1-2013:p1189:b003:l002","ordinal":167856,"en":"He was a fortress set against the foe."},{"id":"semetey-1-2013:p1189:b003:l003","ordinal":167857,"en":"At that time Kongurbay"},{"id":"semetey-1-2013:p1189:b003:l004","ordinal":167858,"en":"Was the mightiest khan of the Kechils."},{"id":"semetey-1-2013:p1189:b003:l005","ordinal":167859,"en":"\"They slaughtered my father!\" he said;"},{"id":"semetey-1-2013:p1189:b003:l006","ordinal":167860,"en":"He bore a grudge."},{"id":"semetey-1-2013:p1189:b003:l007","ordinal":167861,"en":"Terrible in bearing, powerful in venom,"},{"id":"semetey-1-2013:p1189:b003:l008","ordinal":167862,"en":"Kongurbay, son of Alooke,"},{"id":"semetey-1-2013:p1189:b003:l009","ordinal":167863,"en":"Laid low whoever challenged him."},{"id":"semetey-1-2013:p1189:b003:l010","ordinal":167864,"en":"The black horse beneath him—"},{"id":"semetey-1-2013:p1189:b003:l011","ordinal":167865,"en":"That black horse"},{"id":"semetey-1-2013:p1189:b003:l012","ordinal":167866,"en":"Had wings upon its sides."},{"id":"semetey-1-2013:p1189:b003:l013","ordinal":167867,"en":"Whoever challenged him—"},{"id":"semetey-1-2013:p1189:b003:l014","ordinal":167868,"en":"Kongurbay, son of Alooke,"},{"id":"semetey-1-2013:p1189:b003:l015","ordinal":167869,"en":"Habitually threshed them like grain."},{"id":"semetey-1-2013:p1189:b003:l016","ordinal":167870,"en":"His waist was bound with cotton;"},{"id":"semetey-1-2013:p1189:b003:l017","ordinal":167871,"en":"He was born in broad Andijan."},{"id":"semetey-1-2013:p1189:b003:l018","ordinal":167872,"en":"At six years old"},{"id":"semetey-1-2013:p1189:b003:l019","ordinal":167873,"en":"He caused an uproar in Beijing."},{"id":"semetey-1-2013:p1189:b003:l020","ordinal":167874,"en":"At seven years old"},{"id":"semetey-1-2013:p1189:b003:l021","ordinal":167875,"en":"The Manchus and Chinese wearied of him."},{"id":"semetey-1-2013:p1189:b003:l022","ordinal":167876,"en":"When he reached eight,"},{"id":"semetey-1-2013:p1189:b003:l023","ordinal":167877,"en":"He scourged Beijing of Kakanchyn,"},{"id":"semetey-1-2013:p1189:b003:l024","ordinal":167878,"en":"Making its people cry out."},{"id":"semetey-1-2013:p1189:b003:l025","ordinal":167879,"en":"At nine he stopped;"},{"id":"semetey-1-2013:p1189:b003:l026","ordinal":167880,"en":"When he reached ten,"},{"id":"semetey-1-2013:p1189:b003:l027","ordinal":167881,"en":"Great walled Beijing—"},{"id":"semetey-1-2013:p1189:b003:l028","ordinal":167882,"en":"He devastated and ravaged it."},{"id":"semetey-1-2013:p1189:b003:l029","ordinal":167883,"en":"When he reached eleven,"},{"id":"semetey-1-2013:p1189:b003:l030","ordinal":167884,"en":"He besieged great Beijing."},{"id":"semetey-1-2013:p1189:b003:l031","ordinal":167885,"en":"Kongurbay ground them like grain,"},{"id":"semetey-1-2013:p1189:b003:l032","ordinal":167886,"en":"The stone-fortified Chinese—"},{"id":"semetey-1-2013:p1189:b003:l033","ordinal":167887,"en":"He beat their finest men."},{"id":"semetey-1-2013:p1189:b003:l034","ordinal":167888,"en":"When he reached twelve,"},{"id":"semetey-1-2013:p1189:b003:l035","ordinal":167889,"en":"He was entered in the chronicle"},{"id":"semetey-1-2013:p1189:b003:l036","ordinal":167890,"en":"Of Beijing in Kakanchyn,"},{"id":"semetey-1-2013:p1189:b003:l037","ordinal":167891,"en":"And became known to the great men"},{"id":"semetey-1-2013:p1189:b003:l038","ordinal":167892,"en":"Of the seething Chinese host."},{"id":"semetey-1-2013:p1189:b003:l039","ordinal":167893,"en":"The frightened Chinese"},{"id":"semetey-1-2013:p1189:b004:l001","ordinal":167894,"en":"Made him a fortress against the foe"},{"id":"semetey-1-2013:p1189:b004:l002","ordinal":167895,"en":"And the mightiest khan of the Kechils."},{"id":"semetey-1-2013:p1189:b004:l003","ordinal":167896,"en":"Kongurbay, son of Alooke,"},{"id":"semetey-1-2013:p1189:b004:l004","ordinal":167897,"en":"Laid low everyone he met."},{"id":"semetey-1-2013:p1189:b004:l005","ordinal":167898,"en":"Kongurbay was that gray-maned lion;"},{"id":"semetey-1-2013:p1189:b004:l006","ordinal":167899,"en":"At Khan Kokotoy's feast,"},{"id":"semetey-1-2013:p1189:b004:l007","ordinal":167900,"en":"This was where Khan Manas and Kongurbay"},{"id":"semetey-1-2013:p1189:b004:l008","ordinal":167901,"en":"Were destined to clash."},{"id":"semetey-1-2013:p1189:b004:l009","ordinal":167902,"en":"He mounted Algara"},{"id":"semetey-1-2013:p1189:b004:l010","ordinal":167903,"en":"And put on a golden coat."},{"id":"semetey-1-2013:p1189:b004:l011","ordinal":167904,"en":"Taking the white spear in hand,"},{"id":"semetey-1-2013:p1189:b004:l012","ordinal":167905,"en":"He waved a bay-piebald pennant."},{"id":"semetey-1-2013:p1189:b004:l013","ordinal":167906,"en":"A great breastplate shaped like a leather flask"},{"id":"semetey-1-2013:p1189:b004:l014","ordinal":167907,"en":"Flashed beside his horse;"},{"id":"semetey-1-2013:p1189:b004:l015","ordinal":167908,"en":"Bowl-sized gold and coral stones"},{"id":"semetey-1-2013:p1189:b004:l016","ordinal":167909,"en":"Shone from the crown of his head."},{"id":"semetey-1-2013:p1189:b004:l017","ordinal":167910,"en":"His spectacles gleamed."},{"id":"semetey-1-2013:p1189:b004:l018","ordinal":167911,"en":"Cotton boots and hempen waist,"},{"id":"semetey-1-2013:p1189:b004:l019","ordinal":167912,"en":"The swaggering great Kalcha;"},{"id":"semetey-1-2013:p1189:b004:l020","ordinal":167913,"en":"Leather boots and belted waist,"},{"id":"semetey-1-2013:p1189:b004:l021","ordinal":167914,"en":"The raging great Kalcha;"},{"id":"semetey-1-2013:p1189:b004:l022","ordinal":167915,"en":"Girt with latticework iron,"},{"id":"semetey-1-2013:p1189:b004:l023","ordinal":167916,"en":"The hulking great Kalcha."},{"id":"semetey-1-2013:p1189:b004:l024","ordinal":167917,"en":"His eyes were like the whole of a lake,"},{"id":"semetey-1-2013:p1189:b004:l025","ordinal":167918,"en":"As though they would swallow whatever they saw."},{"id":"semetey-1-2013:p1189:b004:l026","ordinal":167919,"en":"The black brows above his eyes"},{"id":"semetey-1-2013:p1189:b004:l027","ordinal":167920,"en":"Were like a folded cloak."},{"id":"semetey-1-2013:p1189:b004:l028","ordinal":167921,"en":"He bore the head of a crouching tiger"},{"id":"semetey-1-2013:p1189:b004:l029","ordinal":167922,"en":"And the brows of a molting tiger."},{"id":"semetey-1-2013:p1189:b004:l030","ordinal":167923,"en":"He narrowed his slanting eyes"},{"id":"semetey-1-2013:p1189:b004:l031","ordinal":167924,"en":"And stroked his hair-thin mustache."},{"id":"semetey-1-2013:p1189:b004:l032","ordinal":167925,"en":"If you looked at his mustaches,"},{"id":"semetey-1-2013:p1189:b004:l033","ordinal":167926,"en":"They were like the haft of a great axe."},{"id":"semetey-1-2013:p1189:b004:l034","ordinal":167927,"en":"If you looked at his nostrils,"},{"id":"semetey-1-2013:p1189:b004:l035","ordinal":167928,"en":"They were like the pouch of a selebe."},{"id":"semetey-1-2013:p1189:b004:l036","ordinal":167929,"en":"The dirty-nosed Kongurbay"},{"id":"semetey-1-2013:p1189:b004:l037","ordinal":167930,"en":"Of the Chinese,"},{"id":"semetey-1-2013:p1189:b004:l038","ordinal":167931,"en":"With a separately made golden bowl,"},{"id":"semetey-1-2013:p1189:b004:l039","ordinal":167932,"en":"And tobacco six spans long,"},{"id":"semetey-1-2013:p1190:b003:l001","ordinal":167933,"en":"Spread it out and took it,"},{"id":"semetey-1-2013:p1190:b003:l002","ordinal":167934,"en":"Drawing until others were frightened."},{"id":"semetey-1-2013:p1190:b003:l003","ordinal":167935,"en":"The coarse-headed, stone-skulled man"},{"id":"semetey-1-2013:p1190:b003:l004","ordinal":167936,"en":"Stood forth upon the field."}]
