[{"id":"semetey-1-2013:p1257:b003:l016","ordinal":173057,"en":"Aychürök is your wife."},{"id":"semetey-1-2013:p1257:b003:l017","ordinal":173058,"en":"Because of Aychürök,"},{"id":"semetey-1-2013:p1257:b003:l018","ordinal":173059,"en":"Toltoy surged upon us then"},{"id":"semetey-1-2013:p1257:b003:l019","ordinal":173060,"en":"And was about to wipe away my name."},{"id":"semetey-1-2013:p1257:b003:l020","ordinal":173061,"en":"A true black army glittered;"},{"id":"semetey-1-2013:p1257:b003:l021","ordinal":173062,"en":"Chynkojo has engulfed us."},{"id":"semetey-1-2013:p1257:b003:l022","ordinal":173063,"en":"Turn your eyes toward us;"},{"id":"semetey-1-2013:p1257:b003:l023","ordinal":173064,"en":"If your gray-wolf nature is true,"},{"id":"semetey-1-2013:p1257:b003:l024","ordinal":173065,"en":"Come and rescue us!"},{"id":"semetey-1-2013:p1257:b003:l025","ordinal":173066,"en":"The deeply dug pit has come;"},{"id":"semetey-1-2013:p1257:b003:l026","ordinal":173067,"en":"My support, child Semetey,"},{"id":"semetey-1-2013:p1257:b003:l027","ordinal":173068,"en":"It presses hard upon our mortal lives."},{"id":"semetey-1-2013:p1257:b003:l028","ordinal":173069,"en":"Saying, ‘I shall level the inner fortress"},{"id":"semetey-1-2013:p1257:b003:l029","ordinal":173070,"en":"And slaughter them all,’"},{"id":"semetey-1-2013:p1257:b003:l030","ordinal":173071,"en":"Saying, ‘I shall smash the stone fortress"},{"id":"semetey-1-2013:p1257:b003:l031","ordinal":173072,"en":"And slaughter them utterly,’"},{"id":"semetey-1-2013:p1257:b003:l032","ordinal":173073,"en":"The accursed mighty Khoja has come;"},{"id":"semetey-1-2013:p1257:b003:l033","ordinal":173074,"en":"Upon your weak Afghan in-laws"},{"id":"semetey-1-2013:p1257:b003:l034","ordinal":173075,"en":"He has brought merciless force."},{"id":"semetey-1-2013:p1257:b003:l035","ordinal":173076,"en":"Driving them after him,"},{"id":"semetey-1-2013:p1257:b003:l036","ordinal":173077,"en":"Through his desire for Aychürök,"},{"id":"semetey-1-2013:p1257:b003:l037","ordinal":173078,"en":"Though we said she had a husband, he attacked."},{"id":"semetey-1-2013:p1257:b003:l038","ordinal":173079,"en":"Before this, Chynkojo,"},{"id":"semetey-1-2013:p1257:b003:l039","ordinal":173080,"en":"Saying, ‘Give us your eldest daughter,’"},{"id":"semetey-1-2013:p1257:b005:l001","ordinal":173081,"en":"Exchanged fire six times."},{"id":"semetey-1-2013:p1257:b005:l002","ordinal":173082,"en":"Riding out with shouts to single combat,"},{"id":"semetey-1-2013:p1257:b005:l003","ordinal":173083,"en":"Gray argamaks died;"},{"id":"semetey-1-2013:p1257:b005:l004","ordinal":173084,"en":"In the mounted single combats,"},{"id":"semetey-1-2013:p1257:b005:l005","ordinal":173085,"en":"Brave heroes died."},{"id":"semetey-1-2013:p1257:b005:l006","ordinal":173086,"en":"Those whose doom had come perished;"},{"id":"semetey-1-2013:p1257:b005:l007","ordinal":173087,"en":"Crying, ‘Ah, Aychürök, may you not prosper!’"},{"id":"semetey-1-2013:p1257:b005:l008","ordinal":173088,"en":"The Afghan people wept."},{"id":"semetey-1-2013:p1257:b005:l009","ordinal":173089,"en":"Many heroes from their side died;"},{"id":"semetey-1-2013:p1257:b005:l010","ordinal":173090,"en":"Many heroes from ours died;"},{"id":"semetey-1-2013:p1257:b005:l011","ordinal":173091,"en":"The dead became the black earth."},{"id":"semetey-1-2013:p1257:b005:l012","ordinal":173092,"en":"Saying, ‘Give your daughter as tribute,’"},{"id":"semetey-1-2013:p1257:b005:l013","ordinal":173093,"en":"Accursed Khoja raged;"},{"id":"semetey-1-2013:p1257:b005:l014","ordinal":173094,"en":"Saying, ‘Give your daughter quickly,’"},{"id":"semetey-1-2013:p1257:b005:l015","ordinal":173095,"en":"Accursed Toltoy strained greedily."},{"id":"semetey-1-2013:p1257:b005:l016","ordinal":173096,"en":"They took all the livestock,"},{"id":"semetey-1-2013:p1257:b005:l017","ordinal":173097,"en":"And destroyed many cities;"},{"id":"semetey-1-2013:p1257:b005:l018","ordinal":173098,"en":"They shattered yurt frames and roof poles,"},{"id":"semetey-1-2013:p1257:b005:l019","ordinal":173099,"en":"And made wives and maidens weep."},{"id":"semetey-1-2013:p1257:b005:l020","ordinal":173100,"en":"Chynkojo brought humiliation;"},{"id":"semetey-1-2013:p1257:b005:l021","ordinal":173101,"en":"He proved a skilled horseman,"},{"id":"semetey-1-2013:p1257:b005:l022","ordinal":173102,"en":"And now imposed great oppression."},{"id":"semetey-1-2013:p1257:b005:l023","ordinal":173103,"en":"The time to slaughter one another has come;"},{"id":"semetey-1-2013:p1257:b005:l024","ordinal":173104,"en":"The hour of massacre has come."},{"id":"semetey-1-2013:p1257:b005:l025","ordinal":173105,"en":"The low gray hills have come;"},{"id":"semetey-1-2013:p1257:b005:l026","ordinal":173106,"en":"Khoja's enemy host has stormed in."},{"id":"semetey-1-2013:p1257:b005:l027","ordinal":173107,"en":"A mass bullets cannot pierce has come;"},{"id":"semetey-1-2013:p1257:b005:l028","ordinal":173108,"en":"A grim-faced army has come."},{"id":"semetey-1-2013:p1257:b005:l029","ordinal":173109,"en":"Unless you yourself are my mighty champion,"},{"id":"semetey-1-2013:p1257:b005:l030","ordinal":173110,"en":"Mighty Toltoy has come"},{"id":"semetey-1-2013:p1257:b005:l031","ordinal":173111,"en":"To overturn the mountain pass."},{"id":"semetey-1-2013:p1257:b005:l032","ordinal":173112,"en":"Tölöbay, son of Tölök,"},{"id":"semetey-1-2013:p1257:b005:l033","ordinal":173113,"en":"Has engulfed us from below."},{"id":"semetey-1-2013:p1257:b005:l034","ordinal":173114,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1257:b005:l035","ordinal":173115,"en":"The khoja whose deeds were bold—"},{"id":"semetey-1-2013:p1257:b005:l036","ordinal":173116,"en":"Let us not belittle the hero,"},{"id":"semetey-1-2013:p1257:b005:l037","ordinal":173117,"en":"The valiant Toltoy who has come."},{"id":"semetey-1-2013:p1257:b005:l038","ordinal":173118,"en":"If we do not give Aychürök as tribute,"},{"id":"semetey-1-2013:p1257:b005:l039","ordinal":173119,"en":"The time has come for him to bring slaughter."},{"id":"semetey-1-2013:p1258:b003:l001","ordinal":173120,"en":"The hour has come for him to slaughter us."},{"id":"semetey-1-2013:p1258:b003:l002","ordinal":173121,"en":"Chynkojo, son of Shygai,"},{"id":"semetey-1-2013:p1258:b003:l003","ordinal":173122,"en":"The khoja whose deeds were bold,"},{"id":"semetey-1-2013:p1258:b003:l004","ordinal":173123,"en":"When summer came,"},{"id":"semetey-1-2013:p1258:b003:l005","ordinal":173124,"en":"Would not let us mount even a maned filly;"},{"id":"semetey-1-2013:p1258:b003:l006","ordinal":173125,"en":"He brought suffering upon my village."},{"id":"semetey-1-2013:p1258:b003:l007","ordinal":173126,"en":"When autumn came,"},{"id":"semetey-1-2013:p1258:b003:l008","ordinal":173127,"en":"He would not let us eat even a tailed lamb;"},{"id":"semetey-1-2013:p1258:b003:l009","ordinal":173128,"en":"He brought humiliation upon my land."},{"id":"semetey-1-2013:p1258:b003:l010","ordinal":173129,"en":"He let no tent trappings be prepared,"},{"id":"semetey-1-2013:p1258:b003:l011","ordinal":173130,"en":"No crops of any kind be sown,"},{"id":"semetey-1-2013:p1258:b003:l012","ordinal":173131,"en":"No furrow be opened in the earth,"},{"id":"semetey-1-2013:p1258:b003:l013","ordinal":173132,"en":"No handful of grain be scattered."},{"id":"semetey-1-2013:p1258:b003:l014","ordinal":173133,"en":"Chynkojo's humiliation"},{"id":"semetey-1-2013:p1258:b003:l015","ordinal":173134,"en":"Never leaves my innermost heart;"},{"id":"semetey-1-2013:p1258:b003:l016","ordinal":173135,"en":"Such is the accursed man's oppression."},{"id":"semetey-1-2013:p1258:b003:l017","ordinal":173136,"en":"All the great people"},{"id":"semetey-1-2013:p1258:b003:l018","ordinal":173137,"en":"He broke apart and dispersed;"},{"id":"semetey-1-2013:p1258:b003:l019","ordinal":173138,"en":"He imposed hell by force,"},{"id":"semetey-1-2013:p1258:b003:l020","ordinal":173139,"en":"And gathered his army complete."},{"id":"semetey-1-2013:p1258:b003:l021","ordinal":173140,"en":"Saying, ‘Give your eldest daughter,’"},{"id":"semetey-1-2013:p1258:b003:l022","ordinal":173141,"en":"He used force against Khan Akun."},{"id":"semetey-1-2013:p1258:b003:l023","ordinal":173142,"en":"If we do not obey what he says,"},{"id":"semetey-1-2013:p1258:b003:l024","ordinal":173143,"en":"If we do not give Aychürök,"},{"id":"semetey-1-2013:p1258:b003:l025","ordinal":173144,"en":"He will level the straight fortress"},{"id":"semetey-1-2013:p1258:b003:l026","ordinal":173145,"en":"And raid us entirely;"},{"id":"semetey-1-2013:p1258:b003:l027","ordinal":173146,"en":"The accursed mighty Khoja has come."},{"id":"semetey-1-2013:p1258:b003:l028","ordinal":173147,"en":"Leading an army like black worms,"},{"id":"semetey-1-2013:p1258:b003:l029","ordinal":173148,"en":"Infidel Khoja is coming;"},{"id":"semetey-1-2013:p1258:b003:l030","ordinal":173149,"en":"To bring slaughter upon the people,"},{"id":"semetey-1-2013:p1258:b003:l031","ordinal":173150,"en":"Hero Khoja is coming."},{"id":"semetey-1-2013:p1258:b003:l032","ordinal":173151,"en":"Toltoy of the Jediger"},{"id":"semetey-1-2013:p1258:b003:l033","ordinal":173152,"en":"Leads an army that bends the earth,"},{"id":"semetey-1-2013:p1258:b003:l034","ordinal":173153,"en":"Driving all the Jediger together,"},{"id":"semetey-1-2013:p1258:b003:l035","ordinal":173154,"en":"Prepared to ride out in single combat."},{"id":"semetey-1-2013:p1258:b003:l036","ordinal":173155,"en":"Like an enraged tiger,"},{"id":"semetey-1-2013:p1258:b003:l037","ordinal":173156,"en":"Leaving no attacker alive,"},{"id":"semetey-1-2013:p1258:b003:l038","ordinal":173157,"en":"The deeply dug pit comes;"},{"id":"semetey-1-2013:p1258:b003:l039","ordinal":173158,"en":"Misfortune comes to whoever angers him."},{"id":"semetey-1-2013:p1258:b004:l001","ordinal":173159,"en":"An army comes that will engulf"},{"id":"semetey-1-2013:p1258:b004:l002","ordinal":173160,"en":"The few Afghans."},{"id":"semetey-1-2013:p1258:b004:l003","ordinal":173161,"en":"A gray-piebald banner comes;"},{"id":"semetey-1-2013:p1258:b004:l004","ordinal":173162,"en":"Unless you are our own defender,"},{"id":"semetey-1-2013:p1258:b004:l005","ordinal":173163,"en":"A wailing uproar comes."},{"id":"semetey-1-2013:p1258:b004:l006","ordinal":173164,"en":"A white-mottled banner comes;"},{"id":"semetey-1-2013:p1258:b004:l007","ordinal":173165,"en":"Hungry shouts and uproar come."},{"id":"semetey-1-2013:p1258:b004:l008","ordinal":173166,"en":"My courageous hero Toltoy—"},{"id":"semetey-1-2013:p1258:b004:l009","ordinal":173167,"en":"Where was he born,"},{"id":"semetey-1-2013:p1258:b004:l010","ordinal":173168,"en":"That while he has Chynkojo"},{"id":"semetey-1-2013:p1258:b004:l011","ordinal":173169,"en":"He unleashes turmoil upon us?"},{"id":"semetey-1-2013:p1258:b004:l012","ordinal":173170,"en":"The Jediger have spurred forward"},{"id":"semetey-1-2013:p1258:b004:l013","ordinal":173171,"en":"And engulfed us evenly;"},{"id":"semetey-1-2013:p1258:b004:l014","ordinal":173172,"en":"Half bear guns and half spears,"},{"id":"semetey-1-2013:p1258:b004:l015","ordinal":173173,"en":"Bringing slaughter upon you."},{"id":"semetey-1-2013:p1258:b004:l016","ordinal":173174,"en":"The Jediger are surging upon us;"},{"id":"semetey-1-2013:p1258:b004:l017","ordinal":173175,"en":"What remedy can we devise?"},{"id":"semetey-1-2013:p1258:b004:l018","ordinal":173176,"en":"Only son of the king,"},{"id":"semetey-1-2013:p1258:b004:l019","ordinal":173177,"en":"Here is sovereign Afghan land;"},{"id":"semetey-1-2013:p1258:b004:l020","ordinal":173178,"en":"If you do not rescue it,"},{"id":"semetey-1-2013:p1258:b004:l021","ordinal":173179,"en":"Slaughter it with your own hand—"},{"id":"semetey-1-2013:p1258:b004:l022","ordinal":173180,"en":"If you would take heads, here are ours."},{"id":"semetey-1-2013:p1258:b004:l023","ordinal":173181,"en":"The time has come to receive judgment;"},{"id":"semetey-1-2013:p1258:b004:l024","ordinal":173182,"en":"Unless you yourself are sharp,"},{"id":"semetey-1-2013:p1258:b004:l025","ordinal":173183,"en":"The hour has come for us to die."},{"id":"semetey-1-2013:p1258:b004:l026","ordinal":173184,"en":"The time for a spectacle has come;"},{"id":"semetey-1-2013:p1258:b004:l027","ordinal":173185,"en":"Unless you yourself are our precious one,"},{"id":"semetey-1-2013:p1258:b004:l028","ordinal":173186,"en":"The hour has come for us to be slaughtered."},{"id":"semetey-1-2013:p1258:b004:l029","ordinal":173187,"en":"Wrathful Toltoy has come;"},{"id":"semetey-1-2013:p1258:b004:l030","ordinal":173188,"en":"Blood ready to flow has come."},{"id":"semetey-1-2013:p1258:b004:l031","ordinal":173189,"en":"If his Khoja raises a shout,"},{"id":"semetey-1-2013:p1258:b004:l032","ordinal":173190,"en":"Lives ready to be cut down have come."},{"id":"semetey-1-2013:p1258:b004:l033","ordinal":173191,"en":"If we match strength with Toltoy,"},{"id":"semetey-1-2013:p1258:b004:l034","ordinal":173192,"en":"He seems able to uproot the pillars;"},{"id":"semetey-1-2013:p1258:b004:l035","ordinal":173193,"en":"If we struggle with Chynkojo,"},{"id":"semetey-1-2013:p1258:b004:l036","ordinal":173194,"en":"He seems able to slaughter us without remainder."},{"id":"semetey-1-2013:p1258:b004:l037","ordinal":173195,"en":"From the flank, his Tölök"},{"id":"semetey-1-2013:p1258:b004:l038","ordinal":173196,"en":"Seems able to mow down the great people."},{"id":"semetey-1-2013:p1258:b004:l039","ordinal":173197,"en":"If they engulf Afghanistan,"},{"id":"semetey-1-2013:p1259:b003:l001","ordinal":173198,"en":"Tölöbay and Kalcha seem able to swallow us."},{"id":"semetey-1-2013:p1259:b003:l002","ordinal":173199,"en":"Unless you yourself defend us,"},{"id":"semetey-1-2013:p1259:b003:l003","ordinal":173200,"en":"They seem able to plunder our goods."},{"id":"semetey-1-2013:p1259:b003:l004","ordinal":173201,"en":"With Aychürök at their head,"},{"id":"semetey-1-2013:p1259:b003:l005","ordinal":173202,"en":"Smashing stone to rubble,"},{"id":"semetey-1-2013:p1259:b003:l006","ordinal":173203,"en":"They seem able to seize"},{"id":"semetey-1-2013:p1259:b003:l007","ordinal":173204,"en":"Every wife and maiden as plunder."},{"id":"semetey-1-2013:p1259:b003:l008","ordinal":173205,"en":"The pit has been dug deep;"},{"id":"semetey-1-2013:p1259:b003:l009","ordinal":173206,"en":"Unless you yourself are our noble one,"},{"id":"semetey-1-2013:p1259:b003:l010","ordinal":173207,"en":"Our bitter brine has begun to boil."},{"id":"semetey-1-2013:p1259:b003:l011","ordinal":173208,"en":"Upon Chürök, whom my father raised,"},{"id":"semetey-1-2013:p1259:b003:l012","ordinal":173209,"en":"They have brought great turmoil to her village."},{"id":"semetey-1-2013:p1259:b003:l013","ordinal":173210,"en":"A claimant comes to bring disaster;"},{"id":"semetey-1-2013:p1259:b003:l014","ordinal":173211,"en":"An enemy comes to face us!”"},{"id":"semetey-1-2013:p1259:b003:l015","ordinal":173212,"en":"When Ajybay said this,"},{"id":"semetey-1-2013:p1259:b003:l016","ordinal":173213,"en":"The lion prince Semetey"},{"id":"semetey-1-2013:p1259:b003:l017","ordinal":173214,"en":"Swelled like a lion."},{"id":"semetey-1-2013:p1259:b003:l018","ordinal":173215,"en":"His anger came and would not cease;"},{"id":"semetey-1-2013:p1259:b003:l019","ordinal":173216,"en":"The former fury"},{"id":"semetey-1-2013:p1259:b003:l020","ordinal":173217,"en":"Of the gray wolf, son of Manas, flared."},{"id":"semetey-1-2013:p1259:b003:l021","ordinal":173218,"en":"As Ajybay stood speaking thus,"},{"id":"semetey-1-2013:p1259:b003:l022","ordinal":173219,"en":"His eyes blazed like fire;"},{"id":"semetey-1-2013:p1259:b003:l023","ordinal":173220,"en":"Descendant of the accursed one,"},{"id":"semetey-1-2013:p1259:b003:l024","ordinal":173221,"en":"Bloodlust seized him."},{"id":"semetey-1-2013:p1259:b003:l025","ordinal":173222,"en":"His broad white teeth like a gate—"},{"id":"semetey-1-2013:p1259:b003:l026","ordinal":173223,"en":"Grinding them then,"},{"id":"semetey-1-2013:p1259:b003:l027","ordinal":173224,"en":"He chewed them section by section."},{"id":"semetey-1-2013:p1259:b003:l028","ordinal":173225,"en":"“Ah, Ajybay, my brother-in-law!"},{"id":"semetey-1-2013:p1259:b003:l029","ordinal":173226,"en":"I have oiled my white steel."},{"id":"semetey-1-2013:p1259:b003:l030","ordinal":173227,"en":"When they sorely provoked my anger,"},{"id":"semetey-1-2013:p1259:b003:l031","ordinal":173228,"en":"I laid low the lions"},{"id":"semetey-1-2013:p1259:b003:l032","ordinal":173229,"en":"Of Argyn and Kyrgyz."},{"id":"semetey-1-2013:p1259:b003:l033","ordinal":173230,"en":"Of battles and slaughters such as this,"},{"id":"semetey-1-2013:p1259:b003:l034","ordinal":173231,"en":"I have seen many!”"},{"id":"semetey-1-2013:p1259:b003:l035","ordinal":173232,"en":"Saying this then,"},{"id":"semetey-1-2013:p1259:b003:l036","ordinal":173233,"en":"Semetey raged."},{"id":"semetey-1-2013:p1259:b003:l037","ordinal":173234,"en":"He had karnays and surnays sounded,"},{"id":"semetey-1-2013:p1259:b003:l038","ordinal":173235,"en":"Loaded the army upon camels,"},{"id":"semetey-1-2013:p1259:b003:l039","ordinal":173236,"en":"Had the tulpars tethered,"},{"id":"semetey-1-2013:p1259:b005:l001","ordinal":173237,"en":"And the brave men made ready."},{"id":"semetey-1-2013:p1259:b005:l002","ordinal":173238,"en":"Running like a lion,"},{"id":"semetey-1-2013:p1259:b005:l003","ordinal":173239,"en":"He prepared to exchange fire with Toltoy;"},{"id":"semetey-1-2013:p1259:b005:l004","ordinal":173240,"en":"The lion boy Semetey"},{"id":"semetey-1-2013:p1259:b005:l005","ordinal":173241,"en":"Donned his battle clothing:"},{"id":"semetey-1-2013:p1259:b005:l006","ordinal":173242,"en":"“Let me lift my lower leg"},{"id":"semetey-1-2013:p1259:b005:l007","ordinal":173243,"en":"Upon a charger like Taybuurul;"},{"id":"semetey-1-2013:p1259:b005:l008","ordinal":173244,"en":"Let me test myself in combat"},{"id":"semetey-1-2013:p1259:b005:l009","ordinal":173245,"en":"Against that one who boasts of his might,"},{"id":"semetey-1-2013:p1259:b005:l010","ordinal":173246,"en":"Against my kinsman Chynkojo!”"},{"id":"semetey-1-2013:p1259:b005:l011","ordinal":173247,"en":"From his royal father Manas,"},{"id":"semetey-1-2013:p1259:b005:l012","ordinal":173248,"en":"When entering true slaughter,"},{"id":"semetey-1-2013:p1259:b005:l013","ordinal":173249,"en":"There was a doolbas drum to be beaten;"},{"id":"semetey-1-2013:p1259:b005:l014","ordinal":173250,"en":"When struck, the earth grew still"},{"id":"semetey-1-2013:p1259:b005:l015","ordinal":173251,"en":"And cowards' faces changed."},{"id":"semetey-1-2013:p1259:b005:l016","ordinal":173252,"en":"When beaten, it deafened the ears"},{"id":"semetey-1-2013:p1259:b005:l017","ordinal":173253,"en":"And could be heard from far away."},{"id":"semetey-1-2013:p1259:b005:l018","ordinal":173254,"en":"Made only from the hide of bil,"},{"id":"semetey-1-2013:p1259:b005:l019","ordinal":173255,"en":"When covered it measured three fathoms;"},{"id":"semetey-1-2013:p1259:b005:l020","ordinal":173256,"en":"When the enemy surged upon them,"},{"id":"semetey-1-2013:p1259:b005:l021","ordinal":173257,"en":"His champion beat it for the omen—"},{"id":"semetey-1-2013:p1259:b005:l022","ordinal":173258,"en":"Hear its voice and flee far away."},{"id":"semetey-1-2013:p1259:b005:l023","ordinal":173259,"en":"When the doolbas was beaten,"},{"id":"semetey-1-2013:p1259:b005:l024","ordinal":173260,"en":"It deafened the ears when heard;"},{"id":"semetey-1-2013:p1259:b005:l025","ordinal":173261,"en":"While your falcons lived,"},{"id":"semetey-1-2013:p1259:b005:l026","ordinal":173262,"en":"It had brought turmoil upon many."},{"id":"semetey-1-2013:p1259:b005:l027","ordinal":173263,"en":"At this time Semetey"},{"id":"semetey-1-2013:p1259:b005:l028","ordinal":173264,"en":"Was roused at the word “war,”"},{"id":"semetey-1-2013:p1259:b005:l029","ordinal":173265,"en":"And surged at the word “slaughter.”"},{"id":"semetey-1-2013:p1259:b005:l030","ordinal":173266,"en":"He raged at the word “spear fight”;"},{"id":"semetey-1-2013:p1259:b005:l031","ordinal":173267,"en":"When your gray wolf charged,"},{"id":"semetey-1-2013:p1259:b005:l032","ordinal":173268,"en":"He strained greedily like a wolf."},{"id":"semetey-1-2013:p1259:b005:l033","ordinal":173269,"en":"When had Khoja ever raged"},{"id":"semetey-1-2013:p1259:b005:l034","ordinal":173270,"en":"And attacked the blessed hero?”"},{"id":"semetey-1-2013:p1259:b005:l035","ordinal":173271,"en":"From Aychürök's palace,"},{"id":"semetey-1-2013:p1259:b005:l036","ordinal":173272,"en":"The doolbas was beaten firmly;"},{"id":"semetey-1-2013:p1259:b005:l037","ordinal":173273,"en":"Thirty brides and thirty maidens,"},{"id":"semetey-1-2013:p1259:b005:l038","ordinal":173274,"en":"With Aychürök at their head,"},{"id":"semetey-1-2013:p1259:b005:l039","ordinal":173275,"en":"The girls lost their senses."},{"id":"semetey-1-2013:p1260:b003:l001","ordinal":173276,"en":"Baitailak, son of Bakai Khan,"},{"id":"semetey-1-2013:p1260:b003:l002","ordinal":173277,"en":"Kalyk, son of Sary Khan,"},{"id":"semetey-1-2013:p1260:b003:l003","ordinal":173278,"en":"Shaiymbet, son of Zhamgyrchy,"},{"id":"semetey-1-2013:p1260:b003:l004","ordinal":173279,"en":"Kanchoro, son of Chubak,"},{"id":"semetey-1-2013:p1260:b003:l005","ordinal":173280,"en":"Külchoro, son of Almambet—"},{"id":"semetey-1-2013:p1260:b003:l006","ordinal":173281,"en":"All sons of khans,"},{"id":"semetey-1-2013:p1260:b003:l007","ordinal":173282,"en":"Gathered around Semetey."},{"id":"semetey-1-2013:p1260:b003:l008","ordinal":173283,"en":"His knees bending to the ground,"},{"id":"semetey-1-2013:p1260:b003:l009","ordinal":173284,"en":"To his uncle’s side"},{"id":"semetey-1-2013:p1260:b003:l010","ordinal":173285,"en":"Külchoro came running."},{"id":"semetey-1-2013:p1260:b003:l011","ordinal":173286,"en":"Looking to either side,"},{"id":"semetey-1-2013:p1260:b003:l012","ordinal":173287,"en":"Licking his lips like a hungry wolf,"},{"id":"semetey-1-2013:p1260:b003:l013","ordinal":173288,"en":"The spear bending in his hand,"},{"id":"semetey-1-2013:p1260:b003:l014","ordinal":173289,"en":"Arkeskene at his neck"},{"id":"semetey-1-2013:p1260:b003:l015","ordinal":173290,"en":"Hung a full fathom long."},{"id":"semetey-1-2013:p1260:b003:l016","ordinal":173291,"en":"All distinguished heroes,"},{"id":"semetey-1-2013:p1260:b003:l017","ordinal":173292,"en":"Gathered tight like deer,"},{"id":"semetey-1-2013:p1260:b003:l018","ordinal":173293,"en":"All tiger-like heroes,"},{"id":"semetey-1-2013:p1260:b003:l019","ordinal":173294,"en":"His attendant comrades beside him,"},{"id":"semetey-1-2013:p1260:b003:l020","ordinal":173295,"en":"They all came together"},{"id":"semetey-1-2013:p1260:b003:l021","ordinal":173296,"en":"To see Semetey."},{"id":"semetey-1-2013:p1260:b003:l022","ordinal":173297,"en":"The great Buurul—"},{"id":"semetey-1-2013:p1260:b003:l023","ordinal":173298,"en":"The radiant Aichürök,"},{"id":"semetey-1-2013:p1260:b003:l024","ordinal":173299,"en":"Her argali eyes shining,"},{"id":"semetey-1-2013:p1260:b003:l025","ordinal":173300,"en":"Had six brides and six maidens,"},{"id":"semetey-1-2013:p1260:b003:l026","ordinal":173301,"en":"Twelve in all, hold him."},{"id":"semetey-1-2013:p1260:b003:l027","ordinal":173302,"en":"Leather saddlecloth and white pad,"},{"id":"semetey-1-2013:p1260:b003:l028","ordinal":173303,"en":"A saddle fitted to Buurul."},{"id":"semetey-1-2013:p1260:b003:l029","ordinal":173304,"en":"Akkangky, made by Almambet,"},{"id":"semetey-1-2013:p1260:b003:l030","ordinal":173305,"en":"Its front bow of white gold,"},{"id":"semetey-1-2013:p1260:b003:l031","ordinal":173306,"en":"Its rear bow of pure silver,"},{"id":"semetey-1-2013:p1260:b003:l032","ordinal":173307,"en":"Both sides broad iron—"},{"id":"semetey-1-2013:p1260:b003:l033","ordinal":173308,"en":"Aichürök saddled him carefully,"},{"id":"semetey-1-2013:p1260:b003:l034","ordinal":173309,"en":"Making him strain as though his master had died."},{"id":"semetey-1-2013:p1260:b003:l035","ordinal":173310,"en":"The dear surviving Buurul"},{"id":"semetey-1-2013:p1260:b003:l036","ordinal":173311,"en":"She now stood holding."},{"id":"semetey-1-2013:p1260:b003:l037","ordinal":173312,"en":"When the khans’ sons ran"}]
