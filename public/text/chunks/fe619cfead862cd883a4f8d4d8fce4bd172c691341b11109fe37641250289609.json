[{"id":"semetey-1-2013:p1166:b003:l031","ordinal":166145,"en":"At the high center"},{"id":"semetey-1-2013:p1166:b003:l032","ordinal":166146,"en":"Of the gleaming plain,"},{"id":"semetey-1-2013:p1166:b003:l033","ordinal":166147,"en":"Ancient Koshoi stood."},{"id":"semetey-1-2013:p1166:b003:l034","ordinal":166148,"en":"Saying, “I will seize and throw the old man,”"},{"id":"semetey-1-2013:p1166:b003:l035","ordinal":166149,"en":"God had struck Joloy."},{"id":"semetey-1-2013:p1166:b003:l036","ordinal":166150,"en":"Do not ask what Joloy was like:"},{"id":"semetey-1-2013:p1166:b003:l037","ordinal":166151,"en":"He was drunk on liquor;"},{"id":"semetey-1-2013:p1166:b003:l038","ordinal":166152,"en":"This infidel was"},{"id":"semetey-1-2013:p1166:b003:l039","ordinal":166153,"en":"Far younger than your elder."},{"id":"semetey-1-2013:p1166:b004:l001","ordinal":166154,"en":"It was the time when he settled"},{"id":"semetey-1-2013:p1166:b004:l002","ordinal":166155,"en":"The Black Kalmyks' disputes."},{"id":"semetey-1-2013:p1166:b004:l003","ordinal":166156,"en":"It was the time when that infidel,"},{"id":"semetey-1-2013:p1166:b004:l004","ordinal":166157,"en":"Steeled with courage, was in full force."},{"id":"semetey-1-2013:p1166:b004:l005","ordinal":166158,"en":"It was the time when Joloy"},{"id":"semetey-1-2013:p1166:b004:l006","ordinal":166159,"en":"Was mounting in strength like a stallion."},{"id":"semetey-1-2013:p1166:b004:l007","ordinal":166160,"en":"The Kalmyks' küpsör garment"},{"id":"semetey-1-2013:p1166:b004:l008","ordinal":166161,"en":"He wrapped puffed around his waist."},{"id":"semetey-1-2013:p1166:b004:l009","ordinal":166162,"en":"Sixty billy-goat hides"},{"id":"semetey-1-2013:p1166:b004:l010","ordinal":166163,"en":"He had sewn together as its outer layer"},{"id":"semetey-1-2013:p1166:b004:l011","ordinal":166164,"en":"And made into trousers."},{"id":"semetey-1-2013:p1166:b004:l012","ordinal":166165,"en":"Bareheaded, his head huge as a cauldron,"},{"id":"semetey-1-2013:p1166:b004:l013","ordinal":166166,"en":"Down the back of that damned infidel"},{"id":"semetey-1-2013:p1166:b004:l014","ordinal":166167,"en":"Hung braided"},{"id":"semetey-1-2013:p1166:b004:l015","ordinal":166168,"en":"Black hair thick as a club."},{"id":"semetey-1-2013:p1166:b004:l016","ordinal":166169,"en":"Koshoi went striding forward;"},{"id":"semetey-1-2013:p1166:b004:l017","ordinal":166170,"en":"Hero Joloy, a mighty man,"},{"id":"semetey-1-2013:p1166:b004:l018","ordinal":166171,"en":"Came out before him."},{"id":"semetey-1-2013:p1166:b004:l019","ordinal":166172,"en":"Joloy spoke to Koshoi:"},{"id":"semetey-1-2013:p1166:b004:l020","ordinal":166173,"en":"“You are dead, Burut,” he said."},{"id":"semetey-1-2013:p1166:b004:l021","ordinal":166174,"en":"“Fortunate Manas's blessed one,"},{"id":"semetey-1-2013:p1166:b004:l022","ordinal":166175,"en":"My fucking Burut,"},{"id":"semetey-1-2013:p1166:b004:l023","ordinal":166176,"en":"I will break your leg.”"},{"id":"semetey-1-2013:p1166:b004:l024","ordinal":166177,"en":"Roaring in fury,"},{"id":"semetey-1-2013:p1166:b004:l025","ordinal":166178,"en":"Joloy came upon him."},{"id":"semetey-1-2013:p1166:b004:l026","ordinal":166179,"en":"Your dear elder Koshoi said,"},{"id":"semetey-1-2013:p1166:b004:l027","ordinal":166180,"en":"“Kalmyk, take your turn,”"},{"id":"semetey-1-2013:p1166:b004:l028","ordinal":166181,"en":"And held out his forearm."},{"id":"semetey-1-2013:p1166:b004:l029","ordinal":166182,"en":"Joloy, huge as Opol-Too,"},{"id":"semetey-1-2013:p1166:b004:l030","ordinal":166183,"en":"Seized him by the forearm."},{"id":"semetey-1-2013:p1166:b004:l031","ordinal":166184,"en":"Was it not Koshoi who divided"},{"id":"semetey-1-2013:p1166:b004:l032","ordinal":166185,"en":"The frontier of Esenkan?"},{"id":"semetey-1-2013:p1166:b004:l033","ordinal":166186,"en":"Was it not Koshoi who had grown accustomed"},{"id":"semetey-1-2013:p1166:b004:l034","ordinal":166187,"en":"To grappling with many men?"},{"id":"semetey-1-2013:p1166:b004:l035","ordinal":166188,"en":"Was it not capable Koshoi,"},{"id":"semetey-1-2013:p1166:b004:l036","ordinal":166189,"en":"Born to be a wrestler on foot?"},{"id":"semetey-1-2013:p1166:b004:l037","ordinal":166190,"en":"Was it not renowned Koshoi,"},{"id":"semetey-1-2013:p1166:b004:l038","ordinal":166191,"en":"Who had grappled with so many giants?"},{"id":"semetey-1-2013:p1166:b004:l039","ordinal":166192,"en":"The day passed as they wrestled,"},{"id":"semetey-1-2013:p1167:b003:l001","ordinal":166193,"en":"Was it not Koshoy who came?"},{"id":"semetey-1-2013:p1167:b003:l002","ordinal":166194,"en":"Was it not Koshoy who laid out"},{"id":"semetey-1-2013:p1167:b003:l003","ordinal":166195,"en":"All the boastful Chinese"},{"id":"semetey-1-2013:p1167:b003:l004","ordinal":166196,"en":"At full length?"},{"id":"semetey-1-2013:p1167:b003:l005","ordinal":166197,"en":"Was it not Koshoy who won"},{"id":"semetey-1-2013:p1167:b003:l006","ordinal":166198,"en":"Victory in many places?"},{"id":"semetey-1-2013:p1167:b003:l007","ordinal":166199,"en":"Was it not Koshoy who fought many men"},{"id":"semetey-1-2013:p1167:b003:l008","ordinal":166200,"en":"Until he had his fill?"},{"id":"semetey-1-2013:p1167:b003:l009","ordinal":166201,"en":"Before the Kalmyk could say, \"Strike,\""},{"id":"semetey-1-2013:p1167:b003:l010","ordinal":166202,"en":"He tore the flesh from his arm."},{"id":"semetey-1-2013:p1167:b003:l011","ordinal":166203,"en":"Accursed old age!"},{"id":"semetey-1-2013:p1167:b003:l012","ordinal":166204,"en":"The skin of his arm"},{"id":"semetey-1-2013:p1167:b003:l013","ordinal":166205,"en":"Went into the hand"},{"id":"semetey-1-2013:p1167:b003:l014","ordinal":166206,"en":"Of Kalmyk champion Joloy."},{"id":"semetey-1-2013:p1167:b003:l015","ordinal":166207,"en":"\"I have lived to see old age,"},{"id":"semetey-1-2013:p1167:b003:l016","ordinal":166208,"en":"The mark of my decline;"},{"id":"semetey-1-2013:p1167:b003:l017","ordinal":166209,"en":"I have suffered shame from an infidel,\" he said."},{"id":"semetey-1-2013:p1167:b003:l018","ordinal":166210,"en":"Taking courage, Khan Koshoy,"},{"id":"semetey-1-2013:p1167:b003:l019","ordinal":166211,"en":"Old tiger Khan Koshoy,"},{"id":"semetey-1-2013:p1167:b003:l020","ordinal":166212,"en":"Seized millstone-sized Joloy"},{"id":"semetey-1-2013:p1167:b003:l021","ordinal":166213,"en":"By the quivering ribs."},{"id":"semetey-1-2013:p1167:b003:l022","ordinal":166214,"en":"From his side he tore"},{"id":"semetey-1-2013:p1167:b003:l023","ordinal":166215,"en":"A bowl-sized piece of blue flesh,"},{"id":"semetey-1-2013:p1167:b003:l024","ordinal":166216,"en":"And ripped it free."},{"id":"semetey-1-2013:p1167:b003:l025","ordinal":166217,"en":"Your old uncle Koshoy's"},{"id":"semetey-1-2013:p1167:b003:l026","ordinal":166218,"en":"Arm ran with blood;"},{"id":"semetey-1-2013:p1167:b003:l027","ordinal":166219,"en":"Kalmyk Khan Joloy's"},{"id":"semetey-1-2013:p1167:b003:l028","ordinal":166220,"en":"Side became like bread dough."},{"id":"semetey-1-2013:p1167:b003:l029","ordinal":166221,"en":"God spare us such a sight!"},{"id":"semetey-1-2013:p1167:b003:l030","ordinal":166222,"en":"They butted like blue rams,"},{"id":"semetey-1-2013:p1167:b003:l031","ordinal":166223,"en":"Tearing whatever they reached,"},{"id":"semetey-1-2013:p1167:b003:l032","ordinal":166224,"en":"Jerking like hungry stallions."},{"id":"semetey-1-2013:p1167:b003:l033","ordinal":166225,"en":"God spare us such a sight!"},{"id":"semetey-1-2013:p1167:b003:l034","ordinal":166226,"en":"They butted like blue bulls,"},{"id":"semetey-1-2013:p1167:b003:l035","ordinal":166227,"en":"Tearing whatever they saw."},{"id":"semetey-1-2013:p1167:b003:l036","ordinal":166228,"en":"Dust swirled in confusion;"},{"id":"semetey-1-2013:p1167:b003:l037","ordinal":166229,"en":"Whatever they gripped became pulp,"},{"id":"semetey-1-2013:p1167:b003:l038","ordinal":166230,"en":"And both were covered in red blood."},{"id":"semetey-1-2013:p1167:b003:l039","ordinal":166231,"en":"They tugged at their trouser cuffs."},{"id":"semetey-1-2013:p1167:b004:l001","ordinal":166232,"en":"If you are a champion, be like this:"},{"id":"semetey-1-2013:p1167:b004:l002","ordinal":166233,"en":"They crashed chest against chest,"},{"id":"semetey-1-2013:p1167:b004:l003","ordinal":166234,"en":"Tore the clothes they grasped,"},{"id":"semetey-1-2013:p1167:b004:l004","ordinal":166235,"en":"And butted harder than wild rams."},{"id":"semetey-1-2013:p1167:b004:l005","ordinal":166236,"en":"They grappled by the trouser cuffs,"},{"id":"semetey-1-2013:p1167:b004:l006","ordinal":166237,"en":"Testing the manner of their strength."},{"id":"semetey-1-2013:p1167:b004:l007","ordinal":166238,"en":"Joloy went about grieving:"},{"id":"semetey-1-2013:p1167:b004:l008","ordinal":166239,"en":"The great trousers on his legs,"},{"id":"semetey-1-2013:p1167:b004:l009","ordinal":166240,"en":"Made from sixty goatskins,"},{"id":"semetey-1-2013:p1167:b004:l010","ordinal":166241,"en":"Were ripped into shreds."},{"id":"semetey-1-2013:p1167:b004:l011","ordinal":166242,"en":"\"Those were sturdy trousers,\" he said,"},{"id":"semetey-1-2013:p1167:b004:l012","ordinal":166243,"en":"And Joloy went about grieving."},{"id":"semetey-1-2013:p1167:b004:l013","ordinal":166244,"en":"When they pulled the kangdagay trousers,"},{"id":"semetey-1-2013:p1167:b004:l014","ordinal":166245,"en":"They stretched out like a spring;"},{"id":"semetey-1-2013:p1167:b004:l015","ordinal":166246,"en":"When they let the kangdagay go,"},{"id":"semetey-1-2013:p1167:b004:l016","ordinal":166247,"en":"They gathered like a fold."},{"id":"semetey-1-2013:p1167:b004:l017","ordinal":166248,"en":"When he grasped them in fury,"},{"id":"semetey-1-2013:p1167:b004:l018","ordinal":166249,"en":"Joloy's hands were cut."},{"id":"semetey-1-2013:p1167:b004:l019","ordinal":166250,"en":"The fainthearted fled and scattered;"},{"id":"semetey-1-2013:p1167:b004:l020","ordinal":166251,"en":"Among infidel and Muslim,"},{"id":"semetey-1-2013:p1167:b004:l021","ordinal":166252,"en":"All those with courage"},{"id":"semetey-1-2013:p1167:b004:l022","ordinal":166253,"en":"Watched as entertainment."},{"id":"semetey-1-2013:p1167:b004:l023","ordinal":166254,"en":"The two champions met,"},{"id":"semetey-1-2013:p1167:b004:l024","ordinal":166255,"en":"And those who watched ached inside."},{"id":"semetey-1-2013:p1167:b004:l025","ordinal":166256,"en":"Kokotoy's abundant wealth"},{"id":"semetey-1-2013:p1167:b004:l026","ordinal":166257,"en":"Was then lavishly scattered"},{"id":"semetey-1-2013:p1167:b004:l027","ordinal":166258,"en":"For the spectacle."},{"id":"semetey-1-2013:p1167:b004:l028","ordinal":166259,"en":"The Karkyra plain,"},{"id":"semetey-1-2013:p1167:b004:l029","ordinal":166260,"en":"Where the champions' feet landed,"},{"id":"semetey-1-2013:p1167:b004:l030","ordinal":166261,"en":"Was gouged out like a trench."},{"id":"semetey-1-2013:p1167:b004:l031","ordinal":166262,"en":"All the sorrow of those watching"},{"id":"semetey-1-2013:p1167:b004:l032","ordinal":166263,"en":"Was relieved."},{"id":"semetey-1-2013:p1167:b004:l033","ordinal":166264,"en":"They wrestled for six days,"},{"id":"semetey-1-2013:p1167:b004:l034","ordinal":166265,"en":"Neither able to defeat the other."},{"id":"semetey-1-2013:p1167:b004:l035","ordinal":166266,"en":"When their wrestling"},{"id":"semetey-1-2013:p1167:b004:l036","ordinal":166267,"en":"Had lasted six full days,"},{"id":"semetey-1-2013:p1167:b004:l037","ordinal":166268,"en":"He was a man grown old—"},{"id":"semetey-1-2013:p1167:b004:l038","ordinal":166269,"en":"Your uncle, giant Koshoy,"},{"id":"semetey-1-2013:p1167:b004:l039","ordinal":166270,"en":"Of the Kalmyks' Joloy,"},{"id":"semetey-1-2013:p1168:b003:l001","ordinal":166271,"en":"Did not emerge from beneath his arm."},{"id":"semetey-1-2013:p1168:b003:l002","ordinal":166272,"en":"Accursed old age!"},{"id":"semetey-1-2013:p1168:b003:l003","ordinal":166273,"en":"Your uncle closed his eyes"},{"id":"semetey-1-2013:p1168:b003:l004","ordinal":166274,"en":"And now fell into deep sleep."},{"id":"semetey-1-2013:p1168:b003:l005","ordinal":166275,"en":"When your uncle fell asleep,"},{"id":"semetey-1-2013:p1168:b003:l006","ordinal":166276,"en":"Joloy lifted him with a grunt."},{"id":"semetey-1-2013:p1168:b003:l007","ordinal":166277,"en":"Boasting so greatly,"},{"id":"semetey-1-2013:p1168:b003:l008","ordinal":166278,"en":"He headed toward the strongest"},{"id":"semetey-1-2013:p1168:b003:l009","ordinal":166279,"en":"Of the jacket-clad Chinese:"},{"id":"semetey-1-2013:p1168:b003:l010","ordinal":166280,"en":"\"Now the Burut is dead;"},{"id":"semetey-1-2013:p1168:b003:l011","ordinal":166281,"en":"He has seen the face of Judgment Day."},{"id":"semetey-1-2013:p1168:b003:l012","ordinal":166282,"en":"Such a Burut cannot survive;"},{"id":"semetey-1-2013:p1168:b003:l013","ordinal":166283,"en":"He has seen what none have seen."},{"id":"semetey-1-2013:p1168:b003:l014","ordinal":166284,"en":"Even if he had eighty lives,"},{"id":"semetey-1-2013:p1168:b003:l015","ordinal":166285,"en":"The accursed Burut is dead."},{"id":"semetey-1-2013:p1168:b003:l016","ordinal":166286,"en":"Now I will throw the Burut down"},{"id":"semetey-1-2013:p1168:b003:l017","ordinal":166287,"en":"And drive his head into the ground,\" he said."},{"id":"semetey-1-2013:p1168:b003:l018","ordinal":166288,"en":"Poor Joloy swaggered,"},{"id":"semetey-1-2013:p1168:b003:l019","ordinal":166289,"en":"Boasting and striding proudly."},{"id":"semetey-1-2013:p1168:b003:l020","ordinal":166290,"en":"This boastful infidel"},{"id":"semetey-1-2013:p1168:b003:l021","ordinal":166291,"en":"Coughed with heavy grunts,"},{"id":"semetey-1-2013:p1168:b003:l022","ordinal":166292,"en":"Hoisted Koshoy of Katagan,"},{"id":"semetey-1-2013:p1168:b003:l023","ordinal":166293,"en":"And carried him"},{"id":"semetey-1-2013:p1168:b003:l024","ordinal":166294,"en":"To the village of Ay Jang-jung;"},{"id":"semetey-1-2013:p1168:b003:l025","ordinal":166295,"en":"He carried him again"},{"id":"semetey-1-2013:p1168:b003:l026","ordinal":166296,"en":"To the village of Kun Jang-jung."},{"id":"semetey-1-2013:p1168:b003:l027","ordinal":166297,"en":"He carried him onward again."},{"id":"semetey-1-2013:p1168:b003:l028","ordinal":166298,"en":"Ezkara, khan of the Manchus—"},{"id":"semetey-1-2013:p1168:b003:l029","ordinal":166299,"en":"Before Ezkara"},{"id":"semetey-1-2013:p1168:b003:l030","ordinal":166300,"en":"He now carried him once."},{"id":"semetey-1-2013:p1168:b003:l031","ordinal":166301,"en":"Then he rushed onward,"},{"id":"semetey-1-2013:p1168:b003:l032","ordinal":166302,"en":"And as he passed farther on,"},{"id":"semetey-1-2013:p1168:b003:l033","ordinal":166303,"en":"He was about to carry and fling him"},{"id":"semetey-1-2013:p1168:b003:l034","ordinal":166304,"en":"Before Kongurbay."},{"id":"semetey-1-2013:p1168:b003:l035","ordinal":166305,"en":"The Muslim people"},{"id":"semetey-1-2013:p1168:b003:l036","ordinal":166306,"en":"Lamented as though their backs had broken:"},{"id":"semetey-1-2013:p1168:b003:l037","ordinal":166307,"en":"\"Old Koshoy is dead,\" they cried,"},{"id":"semetey-1-2013:p1168:b003:l038","ordinal":166308,"en":"Wailing for their honor."},{"id":"semetey-1-2013:p1168:b004:l001","ordinal":166309,"en":"Joloy carried Koshoy"},{"id":"semetey-1-2013:p1168:b004:l002","ordinal":166310,"en":"And ran toward the finest"},{"id":"semetey-1-2013:p1168:b004:l003","ordinal":166311,"en":"Of the stone-bedecked Chinese."},{"id":"semetey-1-2013:p1168:b004:l004","ordinal":166312,"en":"Leopard Manas then"},{"id":"semetey-1-2013:p1168:b004:l005","ordinal":166313,"en":"Stood watching Koshoy"},{"id":"semetey-1-2013:p1168:b004:l006","ordinal":166314,"en":"And grieved in anguish:"},{"id":"semetey-1-2013:p1168:b004:l007","ordinal":166315,"en":"\"Accursed old age!"},{"id":"semetey-1-2013:p1168:b004:l008","ordinal":166316,"en":"You have experienced"},{"id":"semetey-1-2013:p1168:b004:l009","ordinal":166317,"en":"The torment of Judgment Day;"},{"id":"semetey-1-2013:p1168:b004:l010","ordinal":166318,"en":"Your strength has gone, poor man,"},{"id":"semetey-1-2013:p1168:b004:l011","ordinal":166319,"en":"And you have died.\""},{"id":"semetey-1-2013:p1168:b004:l012","ordinal":166320,"en":"He seized the black-jawed rawhide whip"},{"id":"semetey-1-2013:p1168:b004:l013","ordinal":166321,"en":"Whose strike deafened the ears,"},{"id":"semetey-1-2013:p1168:b004:l014","ordinal":166322,"en":"Swung it around,"},{"id":"semetey-1-2013:p1168:b004:l015","ordinal":166323,"en":"And charged toward Koshoy."},{"id":"semetey-1-2013:p1168:b004:l016","ordinal":166324,"en":"Your gray-maned hero Manas"},{"id":"semetey-1-2013:p1168:b004:l017","ordinal":166325,"en":"Struck the fatty flesh"},{"id":"semetey-1-2013:p1168:b004:l018","ordinal":166326,"en":"Of the fat tail."},{"id":"semetey-1-2013:p1168:b004:l019","ordinal":166327,"en":"Blood sprayed from the tail"},{"id":"semetey-1-2013:p1168:b004:l020","ordinal":166328,"en":"Of your sleeping uncle,"},{"id":"semetey-1-2013:p1168:b004:l021","ordinal":166329,"en":"And his eyes opened wide as grain mash."},{"id":"semetey-1-2013:p1168:b004:l022","ordinal":166330,"en":"He seized the tail,"},{"id":"semetey-1-2013:p1168:b004:l023","ordinal":166331,"en":"And from Khan Joloy's hands"},{"id":"semetey-1-2013:p1168:b004:l024","ordinal":166332,"en":"Made a camel-like bound."},{"id":"semetey-1-2013:p1168:b004:l025","ordinal":166333,"en":"Your uncle, hero Koshoy,"},{"id":"semetey-1-2013:p1168:b004:l026","ordinal":166334,"en":"Fell down from the back"},{"id":"semetey-1-2013:p1168:b004:l027","ordinal":166335,"en":"Of lordly Joloy."},{"id":"semetey-1-2013:p1168:b004:l028","ordinal":166336,"en":"Your practiced uncle, giant Koshoy,"},{"id":"semetey-1-2013:p1168:b004:l029","ordinal":166337,"en":"Performed the degey throw;"},{"id":"semetey-1-2013:p1168:b004:l030","ordinal":166338,"en":"Turning Joloy around,"},{"id":"semetey-1-2013:p1168:b004:l031","ordinal":166339,"en":"He slipped inside his stance."},{"id":"semetey-1-2013:p1168:b004:l032","ordinal":166340,"en":"Koshoy tripped Joloy."},{"id":"semetey-1-2013:p1168:b004:l033","ordinal":166341,"en":"\"Our Joloy will throw him,\" they said;"},{"id":"semetey-1-2013:p1168:b004:l034","ordinal":166342,"en":"The Black Kalmyks lamented,"},{"id":"semetey-1-2013:p1168:b004:l035","ordinal":166343,"en":"Shouting in separate groups,"},{"id":"semetey-1-2013:p1168:b004:l036","ordinal":166344,"en":"Calling their battle cry in waves:"},{"id":"semetey-1-2013:p1168:b004:l037","ordinal":166345,"en":"\"Burku-burku-burku!\""},{"id":"semetey-1-2013:p1168:b004:l038","ordinal":166346,"en":"\"Burku!\" cried the Black Kalmyks,"},{"id":"semetey-1-2013:p1169:b003:l001","ordinal":166347,"en":"\"Take the Burut by the legs;"},{"id":"semetey-1-2013:p1169:b003:l002","ordinal":166348,"en":"Lay him out full length,\" they said."},{"id":"semetey-1-2013:p1169:b003:l003","ordinal":166349,"en":"The Black Kalmyks said this,"},{"id":"semetey-1-2013:p1169:b003:l004","ordinal":166350,"en":"While the Muslim faithful cried:"},{"id":"semetey-1-2013:p1169:b003:l005","ordinal":166351,"en":"\"In your uncle's old age,"},{"id":"semetey-1-2013:p1169:b003:l006","ordinal":166352,"en":"May God grant his wish;"},{"id":"semetey-1-2013:p1169:b003:l007","ordinal":166353,"en":"May He put the Kalmyk beneath,"},{"id":"semetey-1-2013:p1169:b003:l008","ordinal":166354,"en":"And your uncle above,\" they said."},{"id":"semetey-1-2013:p1169:b003:l009","ordinal":166355,"en":"The Muslim people cried out."},{"id":"semetey-1-2013:p1169:b003:l010","ordinal":166356,"en":"At that very moment,"},{"id":"semetey-1-2013:p1169:b003:l011","ordinal":166357,"en":"Khan Koshoy of Katagan"},{"id":"semetey-1-2013:p1169:b003:l012","ordinal":166358,"en":"Tugged at the broad belt"},{"id":"semetey-1-2013:p1169:b003:l013","ordinal":166359,"en":"Of Joloy, khan of the Kalmyks."},{"id":"semetey-1-2013:p1169:b003:l014","ordinal":166360,"en":"Where your uncle made the throw,"},{"id":"semetey-1-2013:p1169:b003:l015","ordinal":166361,"en":"He drove his chest"},{"id":"semetey-1-2013:p1169:b003:l016","ordinal":166362,"en":"Into Kalmyk Khan Joloy."},{"id":"semetey-1-2013:p1169:b003:l017","ordinal":166363,"en":"Unable to stop the throw,"},{"id":"semetey-1-2013:p1169:b003:l018","ordinal":166364,"en":"Joloy stumbled away;"},{"id":"semetey-1-2013:p1169:b003:l019","ordinal":166365,"en":"On the yellow hard ground"},{"id":"semetey-1-2013:p1169:b003:l020","ordinal":166366,"en":"His feet could find no hold."},{"id":"semetey-1-2013:p1169:b003:l021","ordinal":166367,"en":"The infidel's bare foot"},{"id":"semetey-1-2013:p1169:b003:l022","ordinal":166368,"en":"Wedged into a hollow."},{"id":"semetey-1-2013:p1169:b003:l023","ordinal":166369,"en":"Upon that huge brute,"},{"id":"semetey-1-2013:p1169:b003:l024","ordinal":166370,"en":"Your uncle Koshoy then"},{"id":"semetey-1-2013:p1169:b003:l025","ordinal":166371,"en":"Fell pressing down."},{"id":"semetey-1-2013:p1169:b003:l026","ordinal":166372,"en":"\"Koshoy has thrown Joloy!\" they cried,"},{"id":"semetey-1-2013:p1169:b003:l027","ordinal":166373,"en":"The forty companions of Khan Manas."},{"id":"semetey-1-2013:p1169:b003:l028","ordinal":166374,"en":"All flew like arrows"},{"id":"semetey-1-2013:p1169:b003:l029","ordinal":166375,"en":"And converged upon them."},{"id":"semetey-1-2013:p1169:b003:l030","ordinal":166376,"en":"Among the forty companions"},{"id":"semetey-1-2013:p1169:b003:l031","ordinal":166377,"en":"Was the champion named Agayar;"},{"id":"semetey-1-2013:p1169:b003:l032","ordinal":166378,"en":"When he grew angry,"},{"id":"semetey-1-2013:p1169:b003:l033","ordinal":166379,"en":"He began a great tumult,"},{"id":"semetey-1-2013:p1169:b003:l034","ordinal":166380,"en":"And when truly enraged,"},{"id":"semetey-1-2013:p1169:b003:l035","ordinal":166381,"en":"He could strike down a camel."},{"id":"semetey-1-2013:p1169:b003:l036","ordinal":166382,"en":"Before one could turn about,"},{"id":"semetey-1-2013:p1169:b003:l037","ordinal":166383,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p1169:b003:l038","ordinal":166384,"en":"Where infidel and Muslim"},{"id":"semetey-1-2013:p1169:b005:l001","ordinal":166385,"en":"Were seething together,"},{"id":"semetey-1-2013:p1169:b005:l002","ordinal":166386,"en":"Champion Agayar arrived."},{"id":"semetey-1-2013:p1169:b005:l003","ordinal":166387,"en":"He shouldered your uncle Koshoy"},{"id":"semetey-1-2013:p1169:b005:l004","ordinal":166388,"en":"And ran away with him."},{"id":"semetey-1-2013:p1169:b005:l005","ordinal":166389,"en":"The strongest jacket-clad Chinese"},{"id":"semetey-1-2013:p1169:b005:l006","ordinal":166390,"en":"Roared,"},{"id":"semetey-1-2013:p1169:b005:l007","ordinal":166391,"en":"And the finest stone-bedecked Kalmyks"},{"id":"semetey-1-2013:p1169:b005:l008","ordinal":166392,"en":"Thundered."},{"id":"semetey-1-2013:p1169:b005:l009","ordinal":166393,"en":"Among the Kalmyks was Ylama,"},{"id":"semetey-1-2013:p1169:b005:l010","ordinal":166394,"en":"An interpreter for the Kalmyks—"},{"id":"semetey-1-2013:p1169:b005:l011","ordinal":166395,"en":"Do not ask what that interpreter said:"},{"id":"semetey-1-2013:p1169:b005:l012","ordinal":166396,"en":"\"The accursed Buruts'"},{"id":"semetey-1-2013:p1169:b005:l013","ordinal":166397,"en":"Best man invited us to the feast;"},{"id":"semetey-1-2013:p1169:b005:l014","ordinal":166398,"en":"What is this he has done?"},{"id":"semetey-1-2013:p1169:b005:l015","ordinal":166399,"en":"He has apparently been left"},{"id":"semetey-1-2013:p1169:b005:l016","ordinal":166400,"en":"To put on bulletproof armor;"}]
