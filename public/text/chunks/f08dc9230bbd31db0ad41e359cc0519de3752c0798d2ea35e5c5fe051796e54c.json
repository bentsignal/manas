[{"id":"seytek-2012:p0992:b002:l023","ordinal":370945,"en":"I have no reason to start talking."},{"id":"seytek-2012:p0992:b002:l024","ordinal":370946,"en":"The unbeliever did not put a word,"},{"id":"seytek-2012:p0992:b002:l025","ordinal":370947,"en":"There are many types of speech"},{"id":"seytek-2012:p0992:b002:l026","ordinal":370948,"en":"I wanted to die,"},{"id":"seytek-2012:p0992:b002:l027","ordinal":370949,"en":"Talking a lot,"},{"id":"seytek-2012:p0992:b002:l028","ordinal":370950,"en":"Tim spoke loudly."},{"id":"seytek-2012:p0992:b002:l029","ordinal":370951,"en":"When you pray, there is no soul,"},{"id":"seytek-2012:p0992:b002:l030","ordinal":370952,"en":"Sincerely,"},{"id":"seytek-2012:p0992:b002:l031","ordinal":370953,"en":"There is no blood left in the bowl,"},{"id":"seytek-2012:p0992:b002:l032","ordinal":370954,"en":"Troubled and angry,"},{"id":"seytek-2012:p0992:b002:l033","ordinal":370955,"en":"Do not start again"},{"id":"seytek-2012:p0992:b002:l034","ordinal":370956,"en":"Facing forward,"},{"id":"seytek-2012:p0992:b002:l035","ordinal":370957,"en":"If measured through the hole,"},{"id":"seytek-2012:p0992:b002:l036","ordinal":370958,"en":"Will the hero not die of war?"},{"id":"seytek-2012:p0992:b002:l037","ordinal":370959,"en":"Another one is ahead"},{"id":"seytek-2012:p0992:b002:l038","ordinal":370960,"en":"Don't you see the ugly boy?"},{"id":"seytek-2012:p0992:b002:l039","ordinal":370961,"en":"If you die, you will be shot."},{"id":"seytek-2012:p0992:b002:l040","ordinal":370962,"en":"Written on his forehead"},{"id":"seytek-2012:p0992:b003:l001","ordinal":370963,"en":"Don't you see heroes?"},{"id":"seytek-2012:p0992:b003:l002","ordinal":370964,"en":"God willing,"},{"id":"seytek-2012:p0992:b003:l003","ordinal":370965,"en":"It's a lie if you say it's necessary."},{"id":"seytek-2012:p0992:b003:l004","ordinal":370966,"en":"Will it ever happen?"},{"id":"seytek-2012:p0992:b003:l005","ordinal":370967,"en":"When the spear is outstretched,"},{"id":"seytek-2012:p0992:b003:l006","ordinal":370968,"en":"Released from the tip of the spear,"},{"id":"seytek-2012:p0992:b003:l007","ordinal":370969,"en":"I will write to you now,"},{"id":"seytek-2012:p0992:b003:l008","ordinal":370970,"en":"There is a lady named Sarybai,"},{"id":"seytek-2012:p0992:b003:l009","ordinal":370971,"en":"Counting girls like you"},{"id":"seytek-2012:p0992:b003:l010","ordinal":370972,"en":"There is a fee to cheat.\""},{"id":"seytek-2012:p0992:b003:l011","ordinal":370973,"en":"Hearing this, the girl wrestler,"},{"id":"seytek-2012:p0992:b003:l012","ordinal":370974,"en":"There was a burning ember,"},{"id":"seytek-2012:p0992:b003:l013","ordinal":370975,"en":"Sarybay, who is about to die,"},{"id":"seytek-2012:p0992:b003:l014","ordinal":370976,"en":"He did not suffer if he died."},{"id":"seytek-2012:p0992:b003:l015","ordinal":370977,"en":"Corrected rabies,"},{"id":"seytek-2012:p0992:b003:l016","ordinal":370978,"en":"There is no hostility left."},{"id":"seytek-2012:p0992:b003:l017","ordinal":370979,"en":"Before the carriage,"},{"id":"seytek-2012:p0992:b003:l018","ordinal":370980,"en":"Confused."},{"id":"seytek-2012:p0992:b003:l019","ordinal":370981,"en":"His soul turned to ashes,"},{"id":"seytek-2012:p0992:b003:l020","ordinal":370982,"en":"His eyes were like fire,"},{"id":"seytek-2012:p0992:b003:l021","ordinal":370983,"en":"No matter how many heroes"},{"id":"seytek-2012:p0992:b003:l022","ordinal":370984,"en":"Kanchyk has no name left."},{"id":"seytek-2012:p0992:b003:l023","ordinal":370985,"en":"Angry wrestler girl,"},{"id":"seytek-2012:p0992:b003:l024","ordinal":370986,"en":"He was bleeding from the inside."},{"id":"seytek-2012:p0992:b003:l025","ordinal":370987,"en":"Hearing this, the wrestler said:"},{"id":"seytek-2012:p0992:b003:l026","ordinal":370988,"en":"\"Bleeding wound,"},{"id":"seytek-2012:p0992:b003:l027","ordinal":370989,"en":"The loss of the wound,"},{"id":"seytek-2012:p0992:b003:l028","ordinal":370990,"en":"Burned my soul,"},{"id":"seytek-2012:p0992:b003:l029","ordinal":370991,"en":"It's a crazy burning night,"},{"id":"seytek-2012:p0992:b003:l030","ordinal":370992,"en":"Burned my soul."},{"id":"seytek-2012:p0992:b003:l031","ordinal":370993,"en":"A person on the tip of a spear,"},{"id":"seytek-2012:p0992:b003:l032","ordinal":370994,"en":"Your promise to yourself,"},{"id":"seytek-2012:p0992:b003:l033","ordinal":370995,"en":"Look at your hard work"},{"id":"seytek-2012:p0992:b003:l034","ordinal":370996,"en":"You did it to yourself."},{"id":"seytek-2012:p0992:b003:l035","ordinal":370997,"en":"Keep your mouth shut,"},{"id":"seytek-2012:p0992:b003:l036","ordinal":370998,"en":"Swallow when you die"},{"id":"seytek-2012:p0992:b003:l037","ordinal":370999,"en":"You are bored,"},{"id":"seytek-2012:p0992:b003:l038","ordinal":371000,"en":"Being bored,"},{"id":"seytek-2012:p0992:b003:l039","ordinal":371001,"en":"Did you kid yourself?"},{"id":"seytek-2012:p0992:b003:l040","ordinal":371002,"en":"Going to be angry,"},{"id":"seytek-2012:p0993:b002:l001","ordinal":371003,"en":"You went to your beloved, you say—"},{"id":"seytek-2012:p0993:b002:l002","ordinal":371004,"en":"With your imperious battle cry,"},{"id":"seytek-2012:p0993:b002:l003","ordinal":371005,"en":"I will snuff you out like a dying fire,"},{"id":"seytek-2012:p0993:b002:l004","ordinal":371006,"en":"Leaving not a single root,"},{"id":"seytek-2012:p0993:b002:l005","ordinal":371007,"en":"I will tear you out root and all,"},{"id":"seytek-2012:p0993:b002:l006","ordinal":371008,"en":"And bury you before you sprout."},{"id":"seytek-2012:p0993:b002:l007","ordinal":371009,"en":"If you rave, you madman,"},{"id":"seytek-2012:p0993:b002:l008","ordinal":371010,"en":"I will break your ribs."},{"id":"seytek-2012:p0993:b002:l009","ordinal":371011,"en":"If you wriggle without cause,"},{"id":"seytek-2012:p0993:b002:l010","ordinal":371012,"en":"I will spill your blood like water."},{"id":"seytek-2012:p0993:b002:l011","ordinal":371013,"en":"Whatever the hour may bring,"},{"id":"seytek-2012:p0993:b002:l012","ordinal":371014,"en":"You never cease your defiance."},{"id":"seytek-2012:p0993:b002:l013","ordinal":371015,"en":"You fawning madman,"},{"id":"seytek-2012:p0993:b002:l014","ordinal":371016,"en":"You shameless swaggerer,"},{"id":"seytek-2012:p0993:b002:l015","ordinal":371017,"en":"Straining upon the spearpoint,"},{"id":"seytek-2012:p0993:b002:l016","ordinal":371018,"en":"You bristled in fury."},{"id":"seytek-2012:p0993:b002:l017","ordinal":371019,"en":"I will bring your death upon you,"},{"id":"seytek-2012:p0993:b002:l018","ordinal":371020,"en":"Extinguish your burning soul,"},{"id":"seytek-2012:p0993:b002:l019","ordinal":371021,"en":"And send you from this world."},{"id":"seytek-2012:p0993:b002:l020","ordinal":371022,"en":"I will strike you down in battle,"},{"id":"seytek-2012:p0993:b002:l021","ordinal":371023,"en":"And settle the true account"},{"id":"seytek-2012:p0993:b002:l022","ordinal":371024,"en":"Of this crackling fool."},{"id":"seytek-2012:p0993:b002:l023","ordinal":371025,"en":"You dog of a wolf, Sarybai,"},{"id":"seytek-2012:p0993:b002:l024","ordinal":371026,"en":"Even a dog is far above you;"},{"id":"seytek-2012:p0993:b002:l025","ordinal":371027,"en":"Even a dog answers when called."},{"id":"seytek-2012:p0993:b002:l026","ordinal":371028,"en":"You are a bird, Sarybai,"},{"id":"seytek-2012:p0993:b002:l027","ordinal":371029,"en":"Even a bird is far above you;"},{"id":"seytek-2012:p0993:b002:l028","ordinal":371030,"en":"Even a bird answers a whistle."},{"id":"seytek-2012:p0993:b002:l029","ordinal":371031,"en":"You heed no spoken word,"},{"id":"seytek-2012:p0993:b002:l030","ordinal":371032,"en":"Nor do you go against distant foes."},{"id":"seytek-2012:p0993:b002:l031","ordinal":371033,"en":"Brisling in fury,"},{"id":"seytek-2012:p0993:b002:l032","ordinal":371034,"en":"You never cease your defiance!”"},{"id":"seytek-2012:p0993:b002:l033","ordinal":371035,"en":"So saying, Kuyaly"},{"id":"seytek-2012:p0993:b002:l034","ordinal":371036,"en":"Gripped the tempered spear in her hand"},{"id":"seytek-2012:p0993:b002:l035","ordinal":371037,"en":"And Sarybai upon its point"},{"id":"seytek-2012:p0993:b002:l036","ordinal":371038,"en":"She shook and violently flung."},{"id":"seytek-2012:p0993:b002:l037","ordinal":371039,"en":"Your sin is upon your own head,"},{"id":"seytek-2012:p0993:b002:l038","ordinal":371040,"en":"Your deeds fall upon your dark crown."},{"id":"seytek-2012:p0993:b002:l039","ordinal":371041,"en":"The bare-shafted tempered spear"},{"id":"seytek-2012:p0993:b002:l040","ordinal":371042,"en":"She clutched firmly,"},{"id":"seytek-2012:p0993:b004:l001","ordinal":371043,"en":"While Sarybai hung above"},{"id":"seytek-2012:p0993:b004:l002","ordinal":371044,"en":"And she swung him to and fro."},{"id":"seytek-2012:p0993:b004:l003","ordinal":371045,"en":"Thus Sarybai"},{"id":"seytek-2012:p0993:b004:l004","ordinal":371046,"en":"Was split in two upon the spear"},{"id":"seytek-2012:p0993:b004:l005","ordinal":371047,"en":"And despaired of his wretched life."},{"id":"seytek-2012:p0993:b004:l006","ordinal":371048,"en":"He lost all warrior courage;"},{"id":"seytek-2012:p0993:b004:l007","ordinal":371049,"en":"His shattered body was hurled,"},{"id":"seytek-2012:p0993:b004:l008","ordinal":371050,"en":"His backbone split in two,"},{"id":"seytek-2012:p0993:b004:l009","ordinal":371051,"en":"And jutting from the other side"},{"id":"seytek-2012:p0993:b004:l010","ordinal":371052,"en":"The tempered spearpoint appeared."},{"id":"seytek-2012:p0993:b004:l011","ordinal":371053,"en":"Kuyaly was truly adroit;"},{"id":"seytek-2012:p0993:b004:l012","ordinal":371054,"en":"She readied the tempered spear,"},{"id":"seytek-2012:p0993:b004:l013","ordinal":371055,"en":"Rent wide his dark liver,"},{"id":"seytek-2012:p0993:b004:l014","ordinal":371056,"en":"And split his heart in two."},{"id":"seytek-2012:p0993:b004:l015","ordinal":371057,"en":"His liver was sliced like cheese,"},{"id":"seytek-2012:p0993:b004:l016","ordinal":371058,"en":"And the cur knew death had come."},{"id":"seytek-2012:p0993:b004:l017","ordinal":371059,"en":"His courage fled, his strength was gone,"},{"id":"seytek-2012:p0993:b004:l018","ordinal":371060,"en":"And Sarybai’s blood poured out."},{"id":"seytek-2012:p0993:b004:l019","ordinal":371061,"en":"His life departed with his strength;"},{"id":"seytek-2012:p0993:b004:l020","ordinal":371062,"en":"She stretched him upon the spearpoint,"},{"id":"seytek-2012:p0993:b004:l021","ordinal":371063,"en":"Overturned him and cast him down,"},{"id":"seytek-2012:p0993:b004:l022","ordinal":371064,"en":"And to the true abode whence none return"},{"id":"seytek-2012:p0993:b004:l023","ordinal":371065,"en":"Sarybai had gone."},{"id":"seytek-2012:p0993:b004:l024","ordinal":371066,"en":"At the hands of the maiden wrestler"},{"id":"seytek-2012:p0993:b004:l025","ordinal":371067,"en":"The swine’s appointed death"},{"id":"seytek-2012:p0993:b004:l026","ordinal":371068,"en":"Had come in just this way."},{"id":"seytek-2012:p0993:b004:l027","ordinal":371069,"en":"Sarybai lay dead,"},{"id":"seytek-2012:p0993:b004:l028","ordinal":371070,"en":"Yet seemed as though the dead man"},{"id":"seytek-2012:p0993:b004:l029","ordinal":371071,"en":"Might revive and rise again."},{"id":"seytek-2012:p0993:b004:l030","ordinal":371072,"en":"They had clashed with thunderous blows,"},{"id":"seytek-2012:p0993:b004:l031","ordinal":371073,"en":"As though to begin the fight anew."},{"id":"seytek-2012:p0993:b004:l032","ordinal":371074,"en":"It seemed the departed man"},{"id":"seytek-2012:p0993:b004:l033","ordinal":371075,"en":"Might revive and rise again."},{"id":"seytek-2012:p0993:b004:l034","ordinal":371076,"en":"As Sarybai lay dead,"},{"id":"seytek-2012:p0993:b004:l035","ordinal":371077,"en":"Drenched in crimson blood,"},{"id":"seytek-2012:p0993:b004:l036","ordinal":371078,"en":"They advanced in their turn"},{"id":"seytek-2012:p0993:b004:l037","ordinal":371079,"en":"And plundered all his wealth."},{"id":"seytek-2012:p0993:b004:l038","ordinal":371080,"en":"His gold and possessions"},{"id":"seytek-2012:p0993:b004:l039","ordinal":371081,"en":"The teeming people seized as spoil,"},{"id":"seytek-2012:p0993:b004:l040","ordinal":371082,"en":"Precious jewels of red gold—"},{"id":"seytek-2012:p0994:b002:l001","ordinal":371083,"en":"The grateful people seized them all,"},{"id":"seytek-2012:p0994:b002:l002","ordinal":371084,"en":"Until they lay in heaps like burial mounds."},{"id":"seytek-2012:p0994:b002:l003","ordinal":371085,"en":"Kuyaly’s vengeance was not sated;"},{"id":"seytek-2012:p0994:b002:l004","ordinal":371086,"en":"She too was a surpassing gray wolf."},{"id":"seytek-2012:p0994:b002:l005","ordinal":371087,"en":"Kuyaly performed a fearsome deed"},{"id":"seytek-2012:p0994:b002:l006","ordinal":371088,"en":"And issued her command."},{"id":"seytek-2012:p0994:b002:l007","ordinal":371089,"en":"The thousand wrestlers under her"},{"id":"seytek-2012:p0994:b002:l008","ordinal":371090,"en":"She now assembled."},{"id":"seytek-2012:p0994:b002:l009","ordinal":371091,"en":"She marched them back and forth,"},{"id":"seytek-2012:p0994:b002:l010","ordinal":371092,"en":"Then formed them into a long column."},{"id":"seytek-2012:p0994:b002:l011","ordinal":371093,"en":"From the countless wrestlers"},{"id":"seytek-2012:p0994:b002:l012","ordinal":371094,"en":"Kuyaly selected one,"},{"id":"seytek-2012:p0994:b002:l013","ordinal":371095,"en":"From the thousand wrestlers"},{"id":"seytek-2012:p0994:b002:l014","ordinal":371096,"en":"Kuyaly brought forth another."},{"id":"seytek-2012:p0994:b002:l015","ordinal":371097,"en":"One by one from every group"},{"id":"seytek-2012:p0994:b002:l016","ordinal":371098,"en":"Kuyaly chose them out."},{"id":"seytek-2012:p0994:b002:l017","ordinal":371099,"en":"When their number reached ninety,"},{"id":"seytek-2012:p0994:b002:l018","ordinal":371100,"en":"Now put the words in their proper place:"},{"id":"seytek-2012:p0994:b002:l019","ordinal":371101,"en":"“Troubled times have befallen us.”"},{"id":"seytek-2012:p0994:b002:l020","ordinal":371102,"en":"With bull necks and camel-like frames,"},{"id":"seytek-2012:p0994:b002:l021","ordinal":371103,"en":"Their struggling could destroy a life."},{"id":"seytek-2012:p0994:b002:l022","ordinal":371104,"en":"Some of the wrestlers there"},{"id":"seytek-2012:p0994:b002:l023","ordinal":371105,"en":"Were broad of chest but short in stature;"},{"id":"seytek-2012:p0994:b002:l024","ordinal":371106,"en":"Some wrestlers were such"},{"id":"seytek-2012:p0994:b002:l025","ordinal":371107,"en":"That their whole bodies seemed black stone."},{"id":"seytek-2012:p0994:b002:l026","ordinal":371108,"en":"Such were some of the wrestlers."},{"id":"seytek-2012:p0994:b002:l027","ordinal":371109,"en":"Their bristling mustaches"},{"id":"seytek-2012:p0994:b002:l028","ordinal":371110,"en":"Were like the hafts of battle-axes."},{"id":"seytek-2012:p0994:b002:l029","ordinal":371111,"en":"When you looked at some,"},{"id":"seytek-2012:p0994:b002:l030","ordinal":371112,"en":"Their finely fashioned noses"},{"id":"seytek-2012:p0994:b002:l031","ordinal":371113,"en":"Were like the sheaths of sabers."},{"id":"seytek-2012:p0994:b002:l032","ordinal":371114,"en":"When you looked at others,"},{"id":"seytek-2012:p0994:b002:l033","ordinal":371115,"en":"Their lower jaws hung loose,"},{"id":"seytek-2012:p0994:b002:l034","ordinal":371116,"en":"Like great leather sacks."},{"id":"seytek-2012:p0994:b002:l035","ordinal":371117,"en":"Some heroic wrestlers"},{"id":"seytek-2012:p0994:b002:l036","ordinal":371118,"en":"Were splendidly formed."},{"id":"seytek-2012:p0994:b002:l037","ordinal":371119,"en":"“Obey whatever you are told,”"},{"id":"seytek-2012:p0994:b002:l038","ordinal":371120,"en":"And each raised his noble head,"},{"id":"seytek-2012:p0994:b002:l039","ordinal":371121,"en":"Ready to perform his service."},{"id":"seytek-2012:p0994:b002:l040","ordinal":371122,"en":"If told to dam a river, they could shatter stone"},{"id":"seytek-2012:p0994:b003:l001","ordinal":371123,"en":"And turn the river from its course;"},{"id":"seytek-2012:p0994:b003:l002","ordinal":371124,"en":"Crushing all without raising their heads,"},{"id":"seytek-2012:p0994:b003:l003","ordinal":371125,"en":"They could grind stones into meal."},{"id":"seytek-2012:p0994:b003:l004","ordinal":371126,"en":"Such wrestlers were among them."},{"id":"seytek-2012:p0994:b003:l005","ordinal":371127,"en":"They had been born into this world"},{"id":"seytek-2012:p0994:b003:l006","ordinal":371128,"en":"And come, it is said, as wrestlers."},{"id":"seytek-2012:p0994:b003:l007","ordinal":371129,"en":"They had faced grievous, burdensome trials"},{"id":"seytek-2012:p0994:b003:l008","ordinal":371130,"en":"And endured much hardship, it is said."},{"id":"seytek-2012:p0994:b003:l009","ordinal":371131,"en":"They were stationed beneath the battle standard,"},{"id":"seytek-2012:p0994:b003:l010","ordinal":371132,"en":"Ready to tie the firmest knot."},{"id":"seytek-2012:p0994:b003:l011","ordinal":371133,"en":"They could swing mattocks with sweeping strokes,"},{"id":"seytek-2012:p0994:b003:l012","ordinal":371134,"en":"Fill their broad bellies,"},{"id":"seytek-2012:p0994:b003:l013","ordinal":371135,"en":"And sustain their mighty bodies."},{"id":"seytek-2012:p0994:b003:l014","ordinal":371136,"en":"She gathered ninety wrestlers,"},{"id":"seytek-2012:p0994:b003:l015","ordinal":371137,"en":"Choosing them from the strongest."},{"id":"seytek-2012:p0994:b003:l016","ordinal":371138,"en":"That infidel Sarybai"},{"id":"seytek-2012:p0994:b003:l017","ordinal":371139,"en":"Was made to pay his true account."},{"id":"seytek-2012:p0994:b003:l018","ordinal":371140,"en":"She had the ninety mighty wrestlers"},{"id":"seytek-2012:p0994:b003:l019","ordinal":371141,"en":"Hack his body into pieces,"},{"id":"seytek-2012:p0994:b003:l020","ordinal":371142,"en":"Making a great spectacle,"},{"id":"seytek-2012:p0994:b003:l021","ordinal":371143,"en":"And gather firewood from the forest."},{"id":"seytek-2012:p0994:b003:l022","ordinal":371144,"en":"To settle his true account,"},{"id":"seytek-2012:p0994:b003:l023","ordinal":371145,"en":"They piled it mountain-high and set it ablaze."},{"id":"seytek-2012:p0994:b003:l024","ordinal":371146,"en":"The contentious villain Sarybai,"},{"id":"seytek-2012:p0994:b003:l025","ordinal":371147,"en":"Who had shown his savagery,"},{"id":"seytek-2012:p0994:b003:l026","ordinal":371148,"en":"Was cast into the fire and burned."},{"id":"seytek-2012:p0994:b003:l027","ordinal":371149,"en":"They shouted the glad tidings,"},{"id":"seytek-2012:p0994:b003:l028","ordinal":371150,"en":"Burned him and scattered his ashes."},{"id":"seytek-2012:p0994:b003:l029","ordinal":371151,"en":"For having defeated Sarybai,"},{"id":"seytek-2012:p0994:b003:l030","ordinal":371152,"en":"Maiden Kuyaly and hero Seytek"},{"id":"seytek-2012:p0994:b003:l031","ordinal":371153,"en":"Had no regret at all;"},{"id":"seytek-2012:p0994:b003:l032","ordinal":371154,"en":"There was no regret that he had died."},{"id":"seytek-2012:p0994:b003:l033","ordinal":371155,"en":"Their wish had fallen into their hands,"},{"id":"seytek-2012:p0994:b003:l034","ordinal":371156,"en":"And fortune had entered their path."},{"id":"seytek-2012:p0994:b003:l035","ordinal":371157,"en":"The offspring of the honor-bound lion,"},{"id":"seytek-2012:p0994:b003:l036","ordinal":371158,"en":"Receiving a blessing from Baabedin,"},{"id":"seytek-2012:p0994:b003:l037","ordinal":371159,"en":"To follow the path of their lion forefather,"},{"id":"seytek-2012:p0994:b003:l038","ordinal":371160,"en":"Received the blessing, “Moon-hoofed one.”"},{"id":"seytek-2012:p0994:b003:l039","ordinal":371161,"en":"They summoned all the people,"},{"id":"seytek-2012:p0994:b003:l040","ordinal":371162,"en":"And for the infidel Khan Sarybai"},{"id":"seytek-2012:p0995:b002:l001","ordinal":371163,"en":"They pitched a royal encampment,"},{"id":"seytek-2012:p0995:b002:l002","ordinal":371164,"en":"With kumiss by day and maidens by night,"},{"id":"seytek-2012:p0995:b002:l003","ordinal":371165,"en":"And held revels through the night."},{"id":"seytek-2012:p0995:b002:l004","ordinal":371166,"en":"That was a land of summer pastures,"},{"id":"seytek-2012:p0995:b002:l005","ordinal":371167,"en":"And he was the lion who brought his people joy."},{"id":"seytek-2012:p0995:b002:l006","ordinal":371168,"en":"The people’s faces brightened;"},{"id":"seytek-2012:p0995:b002:l007","ordinal":371169,"en":"After suffering great humiliation,"},{"id":"seytek-2012:p0995:b002:l008","ordinal":371170,"en":"Being held as though doomed to misery,"},{"id":"seytek-2012:p0995:b002:l009","ordinal":371171,"en":"And grieving without consolation,"},{"id":"seytek-2012:p0995:b002:l010","ordinal":371172,"en":"They were delivered from Sarybai."},{"id":"seytek-2012:p0995:b002:l011","ordinal":371173,"en":"All the assembled people—"},{"id":"seytek-2012:p0995:b002:l012","ordinal":371174,"en":"Their venerable elders,"},{"id":"seytek-2012:p0995:b002:l013","ordinal":371175,"en":"Their sages and eloquent speakers,"},{"id":"seytek-2012:p0995:b002:l014","ordinal":371176,"en":"And their many capable men—"},{"id":"seytek-2012:p0995:b002:l015","ordinal":371177,"en":"Conceived a radiant plan"},{"id":"seytek-2012:p0995:b002:l016","ordinal":371178,"en":"And held a feast in honor"},{"id":"seytek-2012:p0995:b002:l017","ordinal":371179,"en":"Of Kuyaly and the hero Seytek."},{"id":"seytek-2012:p0995:b002:l018","ordinal":371180,"en":"“That infidel Sarybai"},{"id":"seytek-2012:p0995:b002:l019","ordinal":371181,"en":"Plundered brides at his pleasure,” they said."},{"id":"seytek-2012:p0995:b002:l020","ordinal":371182,"en":"When you looked to the farthest reaches,"},{"id":"seytek-2012:p0995:b002:l021","ordinal":371183,"en":"The clouds had vanished,"},{"id":"seytek-2012:p0995:b002:l022","ordinal":371184,"en":"The night was departing and dawn breaking."},{"id":"seytek-2012:p0995:b002:l023","ordinal":371185,"en":"He had no voice left to utter a sound,"},{"id":"seytek-2012:p0995:b002:l024","ordinal":371186,"en":"No hand left to stretch forth."},{"id":"seytek-2012:p0995:b002:l025","ordinal":371187,"en":"“We have given Sarybai his due,” they said;"},{"id":"seytek-2012:p0995:b002:l026","ordinal":371188,"en":"He had vanished from this world."},{"id":"seytek-2012:p0995:b002:l027","ordinal":371189,"en":"“God has granted what we desired,” they said,"},{"id":"seytek-2012:p0995:b002:l028","ordinal":371190,"en":"And the blessed Night of Power descended."},{"id":"seytek-2012:p0995:b002:l029","ordinal":371191,"en":"Allah Most High, the one God,"},{"id":"seytek-2012:p0995:b002:l030","ordinal":371192,"en":"Had now granted it to them."},{"id":"seytek-2012:p0995:b002:l031","ordinal":371193,"en":"The oppressor of the people was subdued,"},{"id":"seytek-2012:p0995:b002:l032","ordinal":371194,"en":"Light poured down upon mankind,"},{"id":"seytek-2012:p0995:b002:l033","ordinal":371195,"en":"And the heavens shone with radiance."},{"id":"seytek-2012:p0995:b002:l034","ordinal":371196,"en":"The grievous calamity and great turmoil"},{"id":"seytek-2012:p0995:b002:l035","ordinal":371197,"en":"Subsided when Sarybai died."},{"id":"seytek-2012:p0995:b002:l036","ordinal":371198,"en":"Ruinous fury disappeared,"},{"id":"seytek-2012:p0995:b002:l037","ordinal":371199,"en":"The people prospered in exultation,"},{"id":"seytek-2012:p0995:b002:l038","ordinal":371200,"en":"And order among the folk was restored."}]
