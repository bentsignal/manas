{"id": "sayakbay-ms-current146:pdf201:l029", "source_id": "sayakbay-ms-current146", "pdf_sha256": "f13de4f4bc48f2da4eb502e29e9b2b340648255ef7769b069e86d24c617319a4", "page": 201, "folio": 584, "line_in_page": 29, "raw": "Түмөн сөзүн бурдуруп,", "text": "Түмөн сөзүн бурдуруп,", "en": "Turning the speech of the myriad host,", "classification": "narrative", "transcription_status": "uncertain", "uncertainty_note": "Provisional direct reading of difficult cursive; no secure printed counterpart identified.", "bbox": null}
