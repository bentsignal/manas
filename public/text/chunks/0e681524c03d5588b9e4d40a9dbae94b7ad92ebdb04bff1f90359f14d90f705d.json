[{"id":"semetey-1-2013:p0929:b003:l009","ordinal":147969,"en":"In his old age."},{"id":"semetey-1-2013:p0929:b003:l010","ordinal":147970,"en":"Caps of gray lynx and marten—"},{"id":"semetey-1-2013:p0929:b003:l011","ordinal":147971,"en":"Who had not worn them swaying?"},{"id":"semetey-1-2013:p0929:b003:l012","ordinal":147972,"en":"Not Kozho alone: before Bakai"},{"id":"semetey-1-2013:p0929:b003:l013","ordinal":147973,"en":"Even Beijing's khan had trembled."},{"id":"semetey-1-2013:p0929:b003:l014","ordinal":147974,"en":"Finished in anger,"},{"id":"semetey-1-2013:p0929:b003:l015","ordinal":147975,"en":"Your leopard uncle Bakai's"},{"id":"semetey-1-2013:p0929:b003:l016","ordinal":147976,"en":"Heart burned fiercely with grief."},{"id":"semetey-1-2013:p0929:b003:l017","ordinal":147977,"en":"Wishing to die, he could not die;"},{"id":"semetey-1-2013:p0929:b003:l018","ordinal":147978,"en":"He could not take his own life."},{"id":"semetey-1-2013:p0929:b003:l019","ordinal":147979,"en":"God would not take Bakai."},{"id":"semetey-1-2013:p0929:b003:l020","ordinal":147980,"en":"Stern Bakai, because of Kozho—"},{"id":"semetey-1-2013:p0929:b003:l021","ordinal":147981,"en":"If he would die, life was too sweet;"},{"id":"semetey-1-2013:p0929:b003:l022","ordinal":147982,"en":"If he would sink into the earth, the ground was hard."},{"id":"semetey-1-2013:p0929:b003:l023","ordinal":147983,"en":"Before even that much time had passed,"},{"id":"semetey-1-2013:p0929:b003:l024","ordinal":147984,"en":"Before a word could be spoken,"},{"id":"semetey-1-2013:p0929:b003:l025","ordinal":147985,"en":"In the blink of an eye,"},{"id":"semetey-1-2013:p0929:b003:l026","ordinal":147986,"en":"His father, lion and goshawk—"},{"id":"semetey-1-2013:p0929:b003:l027","ordinal":147987,"en":"Kulchoro was born surpassing him."},{"id":"semetey-1-2013:p0929:b003:l028","ordinal":147988,"en":"While Kozho stood raging,"},{"id":"semetey-1-2013:p0929:b003:l029","ordinal":147989,"en":"While he committed this outrage,"},{"id":"semetey-1-2013:p0929:b003:l030","ordinal":147990,"en":"Felt fury spread throughout his body."},{"id":"semetey-1-2013:p0929:b003:l031","ordinal":147991,"en":"Ormonbek and Kanchoro—"},{"id":"semetey-1-2013:p0929:b003:l032","ordinal":147992,"en":"He looked at those two."},{"id":"semetey-1-2013:p0929:b003:l033","ordinal":147993,"en":"Unable to withstand his wrath,"},{"id":"semetey-1-2013:p0929:b003:l034","ordinal":147994,"en":"Ormonbek and Kanchoro"},{"id":"semetey-1-2013:p0929:b003:l035","ordinal":147995,"en":"Their hearts leaped within them;"},{"id":"semetey-1-2013:p0929:b003:l036","ordinal":147996,"en":"The weapon grips slipped from their hands."},{"id":"semetey-1-2013:p0929:b003:l037","ordinal":147997,"en":"Shygai's son Chynkozho"},{"id":"semetey-1-2013:p0929:b003:l038","ordinal":147998,"en":"Seemed about to seize them both,"},{"id":"semetey-1-2013:p0929:b003:l039","ordinal":147999,"en":"And lay them across his knee."},{"id":"semetey-1-2013:p0929:b005:l001","ordinal":148000,"en":"Unable to rise, they trembled,"},{"id":"semetey-1-2013:p0929:b005:l002","ordinal":148001,"en":"And scraped the earth, quaking."},{"id":"semetey-1-2013:p0929:b005:l003","ordinal":148002,"en":"At the sight of those two,"},{"id":"semetey-1-2013:p0929:b005:l004","ordinal":148003,"en":"The adept Chynkozho"},{"id":"semetey-1-2013:p0929:b005:l005","ordinal":148004,"en":"Burst into renewed fury,"},{"id":"semetey-1-2013:p0929:b005:l006","ordinal":148005,"en":"Changing his expression in many ways,"},{"id":"semetey-1-2013:p0929:b005:l007","ordinal":148006,"en":"Worked himself into a rage,"},{"id":"semetey-1-2013:p0929:b005:l008","ordinal":148007,"en":"And muttered to himself."},{"id":"semetey-1-2013:p0929:b005:l009","ordinal":148008,"en":"While Kozho carried on thus,"},{"id":"semetey-1-2013:p0929:b005:l010","ordinal":148009,"en":"His father, Lord Alma—"},{"id":"semetey-1-2013:p0929:b005:l011","ordinal":148010,"en":"Kulchoro was born surpassing him."},{"id":"semetey-1-2013:p0929:b005:l012","ordinal":148011,"en":"Did not look about him."},{"id":"semetey-1-2013:p0929:b005:l013","ordinal":148012,"en":"While Kozho stood spurring himself on,"},{"id":"semetey-1-2013:p0929:b005:l014","ordinal":148013,"en":"He spared his life not at all."},{"id":"semetey-1-2013:p0929:b005:l015","ordinal":148014,"en":"Without glancing all around,"},{"id":"semetey-1-2013:p0929:b005:l016","ordinal":148015,"en":"While Kozho stood shouting,"},{"id":"semetey-1-2013:p0929:b005:l017","ordinal":148016,"en":"Not sparing his life in the least, he said:"},{"id":"semetey-1-2013:p0929:b005:l018","ordinal":148017,"en":"“I greeted you before your face,"},{"id":"semetey-1-2013:p0929:b005:l019","ordinal":148018,"en":"We know your treasure."},{"id":"semetey-1-2013:p0929:b005:l020","ordinal":148019,"en":"Yet you shout without cause."},{"id":"semetey-1-2013:p0929:b005:l021","ordinal":148020,"en":"Now I shall call you simply Kozho!"},{"id":"semetey-1-2013:p0929:b005:l022","ordinal":148021,"en":"You bellow, Kozho,"},{"id":"semetey-1-2013:p0929:b005:l023","ordinal":148022,"en":"As though a demon had struck your wife."},{"id":"semetey-1-2013:p0929:b005:l024","ordinal":148023,"en":"You have flown into a madness,"},{"id":"semetey-1-2013:p0929:b005:l025","ordinal":148024,"en":"As though your quarry had just escaped."},{"id":"semetey-1-2013:p0929:b005:l026","ordinal":148025,"en":"Do not rage without cause, Kozho."},{"id":"semetey-1-2013:p0929:b005:l027","ordinal":148026,"en":"You have no Oigut people in Sary-Kol."},{"id":"semetey-1-2013:p0929:b005:l028","ordinal":148027,"en":"As though stricken with the yellow sickness,"},{"id":"semetey-1-2013:p0929:b005:l029","ordinal":148028,"en":"Do not contend without cause!"},{"id":"semetey-1-2013:p0929:b005:l030","ordinal":148029,"en":"You are getting carried away, Kozho."},{"id":"semetey-1-2013:p0929:b005:l031","ordinal":148030,"en":"You have courage, braggart—"},{"id":"semetey-1-2013:p0929:b005:l032","ordinal":148031,"en":"These people whom you brought to their knees,"},{"id":"semetey-1-2013:p0929:b005:l033","ordinal":148032,"en":"To Manas, who went to the world beyond,"},{"id":"semetey-1-2013:p0929:b005:l034","ordinal":148033,"en":"You handed over as subjects."},{"id":"semetey-1-2013:p0929:b005:l035","ordinal":148034,"en":"Do not rumble, do not rage."},{"id":"semetey-1-2013:p0929:b005:l036","ordinal":148035,"en":"Do not thunder and mutter, Kozho."},{"id":"semetey-1-2013:p0929:b005:l037","ordinal":148036,"en":"If you mean trouble, Kozho,"},{"id":"semetey-1-2013:p0929:b005:l038","ordinal":148037,"en":"Name the support on which you rely;"},{"id":"semetey-1-2013:p0929:b005:l039","ordinal":148038,"en":"Name the place where you will flee and hide."},{"id":"semetey-1-2013:p0930:b003:l001","ordinal":148039,"en":"Name the pit we shall dig for you."},{"id":"semetey-1-2013:p0930:b003:l002","ordinal":148040,"en":"Give your answer without evasion!"},{"id":"semetey-1-2013:p0930:b003:l003","ordinal":148041,"en":"If you would fight, Kozho,"},{"id":"semetey-1-2013:p0930:b003:l004","ordinal":148042,"en":"Name the army you have made ready!"},{"id":"semetey-1-2013:p0930:b003:l005","ordinal":148043,"en":"Zulfiqar, left by Manas,"},{"id":"semetey-1-2013:p0930:b003:l006","ordinal":148044,"en":"I have come to grease."},{"id":"semetey-1-2013:p0930:b003:l007","ordinal":148045,"en":"With my chilling might, Chynkozho,"},{"id":"semetey-1-2013:p0930:b003:l008","ordinal":148046,"en":"I have come to lay you low."},{"id":"semetey-1-2013:p0930:b003:l009","ordinal":148047,"en":"If you call me a blood-drinker, I drink blood;"},{"id":"semetey-1-2013:p0930:b003:l010","ordinal":148048,"en":"I am that bloodthirsty lion himself."},{"id":"semetey-1-2013:p0930:b003:l011","ordinal":148049,"en":"Of your leopard Semetey"},{"id":"semetey-1-2013:p0930:b003:l012","ordinal":148050,"en":"I am the dark eye that keeps watch."},{"id":"semetey-1-2013:p0930:b003:l013","ordinal":148051,"en":"If you call me a hero, I am a hero."},{"id":"semetey-1-2013:p0930:b003:l014","ordinal":148052,"en":"Of blustering men like you,"},{"id":"semetey-1-2013:p0930:b003:l015","ordinal":148053,"en":"If my precious life does not perish,"},{"id":"semetey-1-2013:p0930:b003:l016","ordinal":148054,"en":"I am worth eighty!"},{"id":"semetey-1-2013:p0930:b003:l017","ordinal":148055,"en":"Agree to what I say."},{"id":"semetey-1-2013:p0930:b003:l018","ordinal":148056,"en":"The tribute you paid my father Manas,"},{"id":"semetey-1-2013:p0930:b003:l019","ordinal":148057,"en":"Counting twelve years,"},{"id":"semetey-1-2013:p0930:b003:l020","ordinal":148058,"en":"Pay it in full today!"},{"id":"semetey-1-2013:p0930:b003:l021","ordinal":148059,"en":"If you will not accept these words,"},{"id":"semetey-1-2013:p0930:b003:l022","ordinal":148060,"en":"If you will not give that tribute,"},{"id":"semetey-1-2013:p0930:b003:l023","ordinal":148061,"en":"I shall trample your very crown!"},{"id":"semetey-1-2013:p0930:b003:l024","ordinal":148062,"en":"I shall scatter your four kinds of livestock!"},{"id":"semetey-1-2013:p0930:b003:l025","ordinal":148063,"en":"I shall bind your champions."},{"id":"semetey-1-2013:p0930:b003:l026","ordinal":148064,"en":"If you keep blustering like this,"},{"id":"semetey-1-2013:p0930:b003:l027","ordinal":148065,"en":"I shall offer you as a sacrifice!"},{"id":"semetey-1-2013:p0930:b003:l028","ordinal":148066,"en":"If your words go crooked,"},{"id":"semetey-1-2013:p0930:b003:l029","ordinal":148067,"en":"If you keep shouting,"},{"id":"semetey-1-2013:p0930:b003:l030","ordinal":148068,"en":"I shall destroy you yourself."},{"id":"semetey-1-2013:p0930:b003:l031","ordinal":148069,"en":"You have sorely provoked my wrath."},{"id":"semetey-1-2013:p0930:b003:l032","ordinal":148070,"en":"Watch, Chynkozho:"},{"id":"semetey-1-2013:p0930:b003:l033","ordinal":148071,"en":"An orphan who has grown to strength,"},{"id":"semetey-1-2013:p0930:b003:l034","ordinal":148072,"en":"I have now come into my own!”"},{"id":"semetey-1-2013:p0930:b003:l035","ordinal":148073,"en":"So Kulchoro spoke."},{"id":"semetey-1-2013:p0930:b003:l036","ordinal":148074,"en":"“Let the slave go!”"},{"id":"semetey-1-2013:p0930:b003:l037","ordinal":148075,"en":"Kozho charged forward."},{"id":"semetey-1-2013:p0930:b003:l038","ordinal":148076,"en":"Shygai's son Kozho,"},{"id":"semetey-1-2013:p0930:b003:l039","ordinal":148077,"en":"Struggling like a woman whose husband had died,"},{"id":"semetey-1-2013:p0930:b004:l001","ordinal":148078,"en":"Bakai seized and held."},{"id":"semetey-1-2013:p0930:b004:l002","ordinal":148079,"en":"Almambet's son Choro,"},{"id":"semetey-1-2013:p0930:b004:l003","ordinal":148080,"en":"Struggling like a lion,"},{"id":"semetey-1-2013:p0930:b004:l004","ordinal":148081,"en":"Ormonbek seized and held."},{"id":"semetey-1-2013:p0930:b004:l005","ordinal":148082,"en":"Raging and wrenching about,"},{"id":"semetey-1-2013:p0930:b004:l006","ordinal":148083,"en":"Struggling without restraint,"},{"id":"semetey-1-2013:p0930:b004:l007","ordinal":148084,"en":"While Kozho thrashed in his frenzy,"},{"id":"semetey-1-2013:p0930:b004:l008","ordinal":148085,"en":"The immeasurably brave Kulchoro"},{"id":"semetey-1-2013:p0930:b004:l009","ordinal":148086,"en":"His dark-cheeked whip—"},{"id":"semetey-1-2013:p0930:b004:l010","ordinal":148087,"en":"He seized and swung it round."},{"id":"semetey-1-2013:p0930:b004:l011","ordinal":148088,"en":"Making Kozho's head ring,"},{"id":"semetey-1-2013:p0930:b004:l012","ordinal":148089,"en":"He struck him upon the crown."},{"id":"semetey-1-2013:p0930:b004:l013","ordinal":148090,"en":"Your Kozho, who thought himself a lord,"},{"id":"semetey-1-2013:p0930:b004:l014","ordinal":148091,"en":"When the whip struck his crown,"},{"id":"semetey-1-2013:p0930:b004:l015","ordinal":148092,"en":"Sat down, retching."},{"id":"semetey-1-2013:p0930:b004:l016","ordinal":148093,"en":"Hunched like frozen camels,"},{"id":"semetey-1-2013:p0930:b004:l017","ordinal":148094,"en":"The hero Kozho, who thought himself great,"},{"id":"semetey-1-2013:p0930:b004:l018","ordinal":148095,"en":"Having taken a whipping from a child,"},{"id":"semetey-1-2013:p0930:b004:l019","ordinal":148096,"en":"Grew cold and stared blankly."},{"id":"semetey-1-2013:p0930:b004:l020","ordinal":148097,"en":"For as long as it takes meat to cook,"},{"id":"semetey-1-2013:p0930:b004:l021","ordinal":148098,"en":"The hero Kozho lost consciousness."},{"id":"semetey-1-2013:p0930:b004:l022","ordinal":148099,"en":"Before Kozho regained his senses,"},{"id":"semetey-1-2013:p0930:b004:l023","ordinal":148100,"en":"Kulchoro mounted."},{"id":"semetey-1-2013:p0930:b004:l024","ordinal":148101,"en":"His father was a gray-maned hero;"},{"id":"semetey-1-2013:p0930:b004:l025","ordinal":148102,"en":"He moved without haste."},{"id":"semetey-1-2013:p0930:b004:l026","ordinal":148103,"en":"Abyke's Aktelki—"},{"id":"semetey-1-2013:p0930:b004:l027","ordinal":148104,"en":"They vaulted on like shepherds,"},{"id":"semetey-1-2013:p0930:b004:l028","ordinal":148105,"en":"Raiding and shattering his settlement,"},{"id":"semetey-1-2013:p0930:b004:l029","ordinal":148106,"en":"He attacked the hero Kozho."},{"id":"semetey-1-2013:p0930:b004:l030","ordinal":148107,"en":"Kulchoro grew wrathful."},{"id":"semetey-1-2013:p0930:b004:l031","ordinal":148108,"en":"What the champion carried upon his back"},{"id":"semetey-1-2013:p0930:b004:l032","ordinal":148109,"en":"Was his appointed ammunition."},{"id":"semetey-1-2013:p0930:b004:l033","ordinal":148110,"en":"Valiant, gray-maned Kulchoro—"},{"id":"semetey-1-2013:p0930:b004:l034","ordinal":148111,"en":"The horse he rode beneath him"},{"id":"semetey-1-2013:p0930:b004:l035","ordinal":148112,"en":"Was Abyke's peerless steed."},{"id":"semetey-1-2013:p0930:b004:l036","ordinal":148113,"en":"What he held in his hand"},{"id":"semetey-1-2013:p0930:b004:l037","ordinal":148114,"en":"Was Almambet's Oikuma;"},{"id":"semetey-1-2013:p0930:b004:l038","ordinal":148115,"en":"What he slung upon his broad shoulder"},{"id":"semetey-1-2013:p0930:b004:l039","ordinal":148116,"en":"Was Almambet's Syrbaran."},{"id":"semetey-1-2013:p0931:b003:l001","ordinal":148117,"en":"Choro broke away in a frenzy,"},{"id":"semetey-1-2013:p0931:b003:l002","ordinal":148118,"en":"And turned toward Chynkozho,"},{"id":"semetey-1-2013:p0931:b003:l003","ordinal":148119,"en":"As though to bring him utterly to his end."},{"id":"semetey-1-2013:p0931:b003:l004","ordinal":148120,"en":"If they let him go, Kozho"},{"id":"semetey-1-2013:p0931:b003:l005","ordinal":148121,"en":"He seemed ready to destroy completely."},{"id":"semetey-1-2013:p0931:b003:l006","ordinal":148122,"en":"When the boy came near,"},{"id":"semetey-1-2013:p0931:b003:l007","ordinal":148123,"en":"Bakai caught and held him."},{"id":"semetey-1-2013:p0931:b003:l008","ordinal":148124,"en":"Keeping him from reaching the hero Kozho,"},{"id":"semetey-1-2013:p0931:b003:l009","ordinal":148125,"en":"Though he struggled like a bereaved wife,"},{"id":"semetey-1-2013:p0931:b003:l010","ordinal":148126,"en":"He intervened and restrained him:"},{"id":"semetey-1-2013:p0931:b003:l011","ordinal":148127,"en":"“My darling Kulchoro!"},{"id":"semetey-1-2013:p0931:b003:l012","ordinal":148128,"en":"After six months of riding, untiring—"},{"id":"semetey-1-2013:p0931:b003:l013","ordinal":148129,"en":"Is such a noble steed not needed?"},{"id":"semetey-1-2013:p0931:b003:l014","ordinal":148130,"en":"To share counsel and confidences,"},{"id":"semetey-1-2013:p0931:b003:l015","ordinal":148131,"en":"Is a kinsman not needed?"},{"id":"semetey-1-2013:p0931:b003:l016","ordinal":148132,"en":"Shygai's son Chynkozho,"},{"id":"semetey-1-2013:p0931:b003:l017","ordinal":148133,"en":"Kozho is capable in all he does."},{"id":"semetey-1-2013:p0931:b003:l018","ordinal":148134,"en":"Be patient, my Choro, be patient."},{"id":"semetey-1-2013:p0931:b003:l019","ordinal":148135,"en":"Can a man who fights prosper?"},{"id":"semetey-1-2013:p0931:b003:l020","ordinal":148136,"en":"Can those who battle fare well?"},{"id":"semetey-1-2013:p0931:b003:l021","ordinal":148137,"en":"Every stain will cling to you."},{"id":"semetey-1-2013:p0931:b003:l022","ordinal":148138,"en":"My gray-maned Choro, hear my words:"},{"id":"semetey-1-2013:p0931:b003:l023","ordinal":148139,"en":"Where else will elder and younger brothers be found?”"},{"id":"semetey-1-2013:p0931:b003:l024","ordinal":148140,"en":"Traveling toward Talas,"},{"id":"semetey-1-2013:p0931:b003:l025","ordinal":148141,"en":"Around the spur of Kebez-Too,"},{"id":"semetey-1-2013:p0931:b003:l026","ordinal":148142,"en":"Past its jutting headland,"},{"id":"semetey-1-2013:p0931:b003:l027","ordinal":148143,"en":"On the rise covered with fescue,"},{"id":"semetey-1-2013:p0931:b003:l028","ordinal":148144,"en":"From active Kakan"},{"id":"semetey-1-2013:p0931:b003:l029","ordinal":148145,"en":"With smoke spreading in the sky,"},{"id":"semetey-1-2013:p0931:b003:l030","ordinal":148146,"en":"Yellow-mottled like starlings,"},{"id":"semetey-1-2013:p0931:b003:l031","ordinal":148147,"en":"Chynkozho's great horse herd"},{"id":"semetey-1-2013:p0931:b003:l032","ordinal":148148,"en":"Appeared along the road."},{"id":"semetey-1-2013:p0931:b003:l033","ordinal":148149,"en":"Kulchoro, born a gray-maned hero,"},{"id":"semetey-1-2013:p0931:b003:l034","ordinal":148150,"en":"Felt his heart stirred."},{"id":"semetey-1-2013:p0931:b003:l035","ordinal":148151,"en":"Kulchoro and Kanchoro,"},{"id":"semetey-1-2013:p0931:b003:l036","ordinal":148152,"en":"Complete in every way,"},{"id":"semetey-1-2013:p0931:b003:l037","ordinal":148153,"en":"Truly took after their fathers."},{"id":"semetey-1-2013:p0931:b003:l038","ordinal":148154,"en":"Except for the weight of his sacred might,"},{"id":"semetey-1-2013:p0931:b003:l039","ordinal":148155,"en":"They were greater heroes than Semetey."},{"id":"semetey-1-2013:p0931:b005:l001","ordinal":148156,"en":"Turning toward the great horse herd,"},{"id":"semetey-1-2013:p0931:b005:l002","ordinal":148157,"en":"Raising shrill cries and clamor,"},{"id":"semetey-1-2013:p0931:b005:l003","ordinal":148158,"en":"Beating the war drum,"},{"id":"semetey-1-2013:p0931:b005:l004","ordinal":148159,"en":"With the painted musket and blue musket"},{"id":"semetey-1-2013:p0931:b005:l005","ordinal":148160,"en":"The two fired in turn."},{"id":"semetey-1-2013:p0931:b005:l006","ordinal":148161,"en":"Their thunder deafened the ears."},{"id":"semetey-1-2013:p0931:b005:l007","ordinal":148162,"en":"Chynkozho's horses"},{"id":"semetey-1-2013:p0931:b005:l008","ordinal":148163,"en":"All stampeded with a roar."},{"id":"semetey-1-2013:p0931:b005:l009","ordinal":148164,"en":"Through the center Ormonbek"},{"id":"semetey-1-2013:p0931:b005:l010","ordinal":148165,"en":"Carved a way, driving them in a scattering rush."},{"id":"semetey-1-2013:p0931:b005:l011","ordinal":148166,"en":"From the right the companions"},{"id":"semetey-1-2013:p0931:b005:l012","ordinal":148167,"en":"Raised “Manas!” as their battle cry."},{"id":"semetey-1-2013:p0931:b005:l013","ordinal":148168,"en":"The weak, stunted foals and yearlings,"},{"id":"semetey-1-2013:p0931:b005:l014","ordinal":148169,"en":"Beyond broad Kashgar,"},{"id":"semetey-1-2013:p0931:b005:l015","ordinal":148170,"en":"They slaughtered on the bare ground."},{"id":"semetey-1-2013:p0931:b005:l016","ordinal":148171,"en":"Making the mares toss their heads,"},{"id":"semetey-1-2013:p0931:b005:l017","ordinal":148172,"en":"He drove along with heavy steps."},{"id":"semetey-1-2013:p0931:b005:l018","ordinal":148173,"en":"The slow-moving yearlings and foals"},{"id":"semetey-1-2013:p0931:b005:l019","ordinal":148174,"en":"They slaughtered upon the steppe."},{"id":"semetey-1-2013:p0931:b005:l020","ordinal":148175,"en":"The sleek mares"},{"id":"semetey-1-2013:p0931:b005:l021","ordinal":148176,"en":"They drove away without their young."},{"id":"semetey-1-2013:p0931:b005:l022","ordinal":148177,"en":"Shygai's son Kozho's"},{"id":"semetey-1-2013:p0931:b005:l023","ordinal":148178,"en":"Horses they took away,"},{"id":"semetey-1-2013:p0931:b005:l024","ordinal":148179,"en":"And drove sleep from his eyes."},{"id":"semetey-1-2013:p0931:b005:l025","ordinal":148180,"en":"Then Shygai's son Chynkozho—"},{"id":"semetey-1-2013:p0931:b005:l026","ordinal":148181,"en":"What could dear Kozho do?"},{"id":"semetey-1-2013:p0931:b005:l027","ordinal":148182,"en":"Wishing to die, he could not die;"},{"id":"semetey-1-2013:p0931:b005:l028","ordinal":148183,"en":"Kozho could not take his own life."},{"id":"semetey-1-2013:p0931:b005:l029","ordinal":148184,"en":"When he came out in fury,"},{"id":"semetey-1-2013:p0931:b005:l030","ordinal":148185,"en":"The tethered Black Horse—"},{"id":"semetey-1-2013:p0931:b005:l031","ordinal":148186,"en":"The raging slave Kulchoro"},{"id":"semetey-1-2013:p0931:b005:l032","ordinal":148187,"en":"Had cut its ear,"},{"id":"semetey-1-2013:p0931:b005:l033","ordinal":148188,"en":"And put Ogoy's notched earmark upon it."},{"id":"semetey-1-2013:p0931:b005:l034","ordinal":148189,"en":"He came to the pasture: there were no horses."},{"id":"semetey-1-2013:p0931:b005:l035","ordinal":148190,"en":"“He has brought utter ruin now;"},{"id":"semetey-1-2013:p0931:b005:l036","ordinal":148191,"en":"He has raided them all."},{"id":"semetey-1-2013:p0931:b005:l037","ordinal":148192,"en":"He has inflicted terrible suffering."},{"id":"semetey-1-2013:p0931:b005:l038","ordinal":148193,"en":"The Chinese killed his father,"},{"id":"semetey-1-2013:p0931:b005:l039","ordinal":148194,"en":"And he has taken revenge upon me."},{"id":"semetey-1-2013:p0932:b003:l001","ordinal":148195,"en":"My mares like white gulls"},{"id":"semetey-1-2013:p0932:b003:l002","ordinal":148196,"en":"He has let Khan Bakai raid."},{"id":"semetey-1-2013:p0932:b003:l003","ordinal":148197,"en":"The Black Horse no lasso could touch"},{"id":"semetey-1-2013:p0932:b003:l004","ordinal":148198,"en":"He has let slaves ride bareback."},{"id":"semetey-1-2013:p0932:b003:l005","ordinal":148199,"en":"I have suffered such humiliation!"},{"id":"semetey-1-2013:p0932:b003:l006","ordinal":148200,"en":"I shall bring utter ruin upon him."},{"id":"semetey-1-2013:p0932:b003:l007","ordinal":148201,"en":"The Zhediger's hero Toltoy—"},{"id":"semetey-1-2013:p0932:b003:l008","ordinal":148202,"en":"I shall go and join him."},{"id":"semetey-1-2013:p0932:b003:l009","ordinal":148203,"en":"His bloodthirsty father Manas—"},{"id":"semetey-1-2013:p0932:b003:l010","ordinal":148204,"en":"This hand of mine deceived him six times."},{"id":"semetey-1-2013:p0932:b003:l011","ordinal":148205,"en":"Fighting and shooting in earnest,"},{"id":"semetey-1-2013:p0932:b003:l012","ordinal":148206,"en":"I shall bring utter ruin upon him."},{"id":"semetey-1-2013:p0932:b003:l013","ordinal":148207,"en":"The Zhediger's Toltoy,"},{"id":"semetey-1-2013:p0932:b003:l014","ordinal":148208,"en":"From the countless troops that bend the earth,"},{"id":"semetey-1-2013:p0932:b003:l015","ordinal":148209,"en":"I shall go and gather to my side."},{"id":"semetey-1-2013:p0932:b003:l016","ordinal":148210,"en":"To Temir Khan's city"},{"id":"semetey-1-2013:p0932:b003:l017","ordinal":148211,"en":"The orphan wandered away—"},{"id":"semetey-1-2013:p0932:b003:l018","ordinal":148212,"en":"I shall sweep across all the Afghan land,"},{"id":"semetey-1-2013:p0932:b003:l019","ordinal":148213,"en":"And seize his wife."},{"id":"semetey-1-2013:p0932:b003:l020","ordinal":148214,"en":"Until the swaying stalks ripen,"},{"id":"semetey-1-2013:p0932:b003:l021","ordinal":148215,"en":"Until the autumn gossamer flies,"},{"id":"semetey-1-2013:p0932:b003:l022","ordinal":148216,"en":"Fighting firmly for six months,"},{"id":"semetey-1-2013:p0932:b003:l023","ordinal":148217,"en":"Thus I shall bring him to his end."},{"id":"semetey-1-2013:p0932:b003:l024","ordinal":148218,"en":"That fool, the son of Manas—"},{"id":"semetey-1-2013:p0932:b003:l025","ordinal":148219,"en":"Akun Khan was his father-in-law;"},{"id":"semetey-1-2013:p0932:b003:l026","ordinal":148220,"en":"Aichurok was his wife."},{"id":"semetey-1-2013:p0932:b003:l027","ordinal":148221,"en":"I shall sweep into the Afghan land,"},{"id":"semetey-1-2013:p0932:b003:l028","ordinal":148222,"en":"And bring a day of misery."},{"id":"semetey-1-2013:p0932:b003:l029","ordinal":148223,"en":"The bloodthirsty hero's orphan son—"},{"id":"semetey-1-2013:p0932:b003:l030","ordinal":148224,"en":"I shall seize his wife."}]
