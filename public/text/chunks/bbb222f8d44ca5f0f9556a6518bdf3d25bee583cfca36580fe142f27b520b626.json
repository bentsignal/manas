[{"id":"manas-2010:p1537:b001:l035","ordinal":66305,"en":"Driving them back and crushing them,"},{"id":"manas-2010:p1537:b001:l036","ordinal":66306,"en":"Dear Syrgak now entered."},{"id":"manas-2010:p1537:b001:l037","ordinal":66307,"en":"Beyond the measure of one's strength,"},{"id":"manas-2010:p1537:b001:l038","ordinal":66308,"en":"The Chinese people could not be matched;"},{"id":"manas-2010:p1537:b001:l039","ordinal":66309,"en":"Beyond one's strength in a struggle,"},{"id":"manas-2010:p1537:b001:l040","ordinal":66310,"en":"The Chinese were a stalwart people."},{"id":"manas-2010:p1537:b001:l041","ordinal":66311,"en":"Thundering and surging, Ay Jangjung"},{"id":"manas-2010:p1537:b001:l042","ordinal":66312,"en":"Had arrived at full speed."},{"id":"manas-2010:p1538:b001:l001","ordinal":66313,"en":"His shout split stones;"},{"id":"manas-2010:p1538:b001:l002","ordinal":66314,"en":"Leading troops without sparing them,"},{"id":"manas-2010:p1538:b001:l003","ordinal":66315,"en":"Leading an uncountable mighty host,"},{"id":"manas-2010:p1538:b001:l004","ordinal":66316,"en":"Bringing fresh lions to reinforce them,"},{"id":"manas-2010:p1538:b001:l005","ordinal":66317,"en":"Bringing fierce men who spared no lives,"},{"id":"manas-2010:p1538:b001:l006","ordinal":66318,"en":"Ay Jangjung had arrived."},{"id":"manas-2010:p1538:b001:l007","ordinal":66319,"en":"When the two giants arrived,"},{"id":"manas-2010:p1538:b001:l008","ordinal":66320,"en":"Army joined army;"},{"id":"manas-2010:p1538:b001:l009","ordinal":66321,"en":"The face of the earth streamed with them;"},{"id":"manas-2010:p1538:b001:l010","ordinal":66322,"en":"The multitude of Chinese became a flood."},{"id":"manas-2010:p1538:b001:l011","ordinal":66323,"en":"If you looked at their numbers,"},{"id":"manas-2010:p1538:b001:l012","ordinal":66324,"en":"Your eyes could not reach their limits;"},{"id":"manas-2010:p1538:b001:l013","ordinal":66325,"en":"The multitude of Chinese became a lake."},{"id":"manas-2010:p1538:b001:l014","ordinal":66326,"en":"Each Manchu contingent stood apart;"},{"id":"manas-2010:p1538:b001:l015","ordinal":66327,"en":"Of the countless Chinese and Manchus,"},{"id":"manas-2010:p1538:b001:l016","ordinal":66328,"en":"So many had been slaughtered."},{"id":"manas-2010:p1538:b001:l017","ordinal":66329,"en":"“If only I could slaughter the Burut,”"},{"id":"manas-2010:p1538:b001:l018","ordinal":66330,"en":"Biting through their lips,"},{"id":"manas-2010:p1538:b001:l019","ordinal":66331,"en":"The aggrieved ones stood apart;"},{"id":"manas-2010:p1538:b001:l020","ordinal":66332,"en":"Those who cast lassos from afar,"},{"id":"manas-2010:p1538:b001:l021","ordinal":66333,"en":"Their sorcerers, stood apart."},{"id":"manas-2010:p1538:b001:l022","ordinal":66334,"en":"Peoples of every kind among the Chinese,"},{"id":"manas-2010:p1538:b001:l023","ordinal":66335,"en":"A place where they would perish together,"},{"id":"manas-2010:p1538:b001:l024","ordinal":66336,"en":"When the Chinese surged upon them,"},{"id":"manas-2010:p1538:b001:l025","ordinal":66337,"en":"Unable to find a plan, their eyes darting,"},{"id":"manas-2010:p1538:b001:l026","ordinal":66338,"en":"Their resourcefulness fled, their senses gone,"},{"id":"manas-2010:p1538:b001:l027","ordinal":66339,"en":"The Chinese entered in a mass,"},{"id":"manas-2010:p1538:b001:l028","ordinal":66340,"en":"Preparing to bind them."},{"id":"manas-2010:p1538:b001:l029","ordinal":66341,"en":"Look at the cannon shrouded in haze;"},{"id":"manas-2010:p1538:b001:l030","ordinal":66342,"en":"Look at the unfailing shots!"},{"id":"manas-2010:p1538:b001:l031","ordinal":66343,"en":"Syrgak gave no thought to shots,"},{"id":"manas-2010:p1538:b001:l032","ordinal":66344,"en":"Did not reckon, “I shall die,”"},{"id":"manas-2010:p1538:b001:l033","ordinal":66345,"en":"Looked neither up nor down."},{"id":"manas-2010:p1538:b001:l034","ordinal":66346,"en":"Not one of the former men remained;"},{"id":"manas-2010:p1538:b001:l035","ordinal":66347,"en":"The Chinese who had surged in"},{"id":"manas-2010:p1538:b001:l036","ordinal":66348,"en":"Showed no sign of turning to flee."},{"id":"manas-2010:p1538:b001:l037","ordinal":66349,"en":"Charging and thrusting spears,"},{"id":"manas-2010:p1538:b001:l038","ordinal":66350,"en":"If he speared ten and brought them down,"},{"id":"manas-2010:p1538:b001:l039","ordinal":66351,"en":"From every side they thrust:"},{"id":"manas-2010:p1538:b001:l040","ordinal":66352,"en":"A hundred spears struck at once."},{"id":"manas-2010:p1538:b001:l041","ordinal":66353,"en":"When Kongurbay came thundering out,"},{"id":"manas-2010:p1538:b001:l042","ordinal":66354,"en":"No man mattered in his eyes,"},{"id":"manas-2010:p1539:b001:l001","ordinal":66355,"en":"Ay Jangjung grew fiercer."},{"id":"manas-2010:p1539:b001:l002","ordinal":66356,"en":"Behind Ay Jangjung,"},{"id":"manas-2010:p1539:b001:l003","ordinal":66357,"en":"Kün Jangjung came shouting."},{"id":"manas-2010:p1539:b001:l004","ordinal":66358,"en":"The two Jangjung khans came forth;"},{"id":"manas-2010:p1539:b001:l005","ordinal":66359,"en":"At their voices, souls fled their bodies."},{"id":"manas-2010:p1539:b001:l006","ordinal":66360,"en":"When Syrgak faced them and thrust,"},{"id":"manas-2010:p1539:b001:l007","ordinal":66361,"en":"His spear broke and bent;"},{"id":"manas-2010:p1539:b001:l008","ordinal":66362,"en":"The strain fell upon one lone soul."},{"id":"manas-2010:p1539:b001:l009","ordinal":66363,"en":"While the Chinese swarmed upon him,"},{"id":"manas-2010:p1539:b001:l010","ordinal":66364,"en":"Alabash, a peerless steed among horses,"},{"id":"manas-2010:p1539:b001:l011","ordinal":66365,"en":"They sent galloping toward Syrgak;"},{"id":"manas-2010:p1539:b001:l012","ordinal":66366,"en":"Almambet and Chubak, their names in harmony,"},{"id":"manas-2010:p1539:b001:l013","ordinal":66367,"en":"“If death is due, let us die;"},{"id":"manas-2010:p1539:b001:l014","ordinal":66368,"en":"If the two of us have the strength,"},{"id":"manas-2010:p1539:b001:l015","ordinal":66369,"en":"For dear young Syrgak,"},{"id":"manas-2010:p1539:b001:l016","ordinal":66370,"en":"Let us give support!”"},{"id":"manas-2010:p1539:b001:l017","ordinal":66371,"en":"Saying this, the two lions,"},{"id":"manas-2010:p1539:b001:l018","ordinal":66372,"en":"Not sparing their frail lives,"},{"id":"manas-2010:p1539:b001:l019","ordinal":66373,"en":"Not heeding the multitude of Chinese,"},{"id":"manas-2010:p1539:b001:l020","ordinal":66374,"en":"Charged in at a gallop,"},{"id":"manas-2010:p1539:b001:l021","ordinal":66375,"en":"Making the Chinese lose their venom."},{"id":"manas-2010:p1539:b001:l022","ordinal":66376,"en":"They charged and struck the Chinese,"},{"id":"manas-2010:p1539:b001:l023","ordinal":66377,"en":"Calling the battle cry, “Manas!”"},{"id":"manas-2010:p1539:b001:l024","ordinal":66378,"en":"The two lions roared;"},{"id":"manas-2010:p1539:b001:l025","ordinal":66379,"en":"Their shouts split stones."},{"id":"manas-2010:p1539:b001:l026","ordinal":66380,"en":"When your fierce champions entered,"},{"id":"manas-2010:p1539:b001:l027","ordinal":66381,"en":"Charging together behind them,"},{"id":"manas-2010:p1539:b001:l028","ordinal":66382,"en":"Hero Manas's forty companions,"},{"id":"manas-2010:p1539:b001:l029","ordinal":66383,"en":"When they charged and swept in,"},{"id":"manas-2010:p1539:b001:l030","ordinal":66384,"en":"Were drenched in blood upon blood."},{"id":"manas-2010:p1539:b001:l031","ordinal":66385,"en":"The multitude of Chinese who swept forward"},{"id":"manas-2010:p1539:b001:l032","ordinal":66386,"en":"Stood and fought without fleeing."},{"id":"manas-2010:p1539:b001:l033","ordinal":66387,"en":"That champion of yours, Syrgak,"},{"id":"manas-2010:p1539:b001:l034","ordinal":66388,"en":"Sped upon Kökchebich;"},{"id":"manas-2010:p1539:b001:l035","ordinal":66389,"en":"Almambet, Azizkan's son,"},{"id":"manas-2010:p1539:b001:l036","ordinal":66390,"en":"Entered their midst like a lion,"},{"id":"manas-2010:p1539:b001:l037","ordinal":66391,"en":"Spearing each man once,"},{"id":"manas-2010:p1539:b001:l038","ordinal":66392,"en":"Throwing them off their horses."},{"id":"manas-2010:p1539:b001:l039","ordinal":66393,"en":"When Almambet truly charged in,"},{"id":"manas-2010:p1539:b001:l040","ordinal":66394,"en":"When Syrgak went beside him,"},{"id":"manas-2010:p1539:b001:l041","ordinal":66395,"en":"The Chinese onslaught halted;"},{"id":"manas-2010:p1539:b001:l042","ordinal":66396,"en":"Chubak, Khan Baltay's son,"},{"id":"manas-2010:p1540:b001:l001","ordinal":66397,"en":"Went slaughtering the Chinese,"},{"id":"manas-2010:p1540:b001:l002","ordinal":66398,"en":"Poised to dart like an arrow-snake."},{"id":"manas-2010:p1540:b001:l003","ordinal":66399,"en":"Into their center, Almambet"},{"id":"manas-2010:p1540:b001:l004","ordinal":66400,"en":"Bored his way;"},{"id":"manas-2010:p1540:b001:l005","ordinal":66401,"en":"Around their edges, hero Syrgak"},{"id":"manas-2010:p1540:b001:l006","ordinal":66402,"en":"Stretched their ranks apart as he entered."},{"id":"manas-2010:p1540:b001:l007","ordinal":66403,"en":"Charging without sparing their lives,"},{"id":"manas-2010:p1540:b001:l008","ordinal":66404,"en":"Khan Manas's forty companions"},{"id":"manas-2010:p1540:b001:l009","ordinal":66405,"en":"Split them as they entered."},{"id":"manas-2010:p1540:b001:l010","ordinal":66406,"en":"The place where they made war"},{"id":"manas-2010:p1540:b001:l011","ordinal":66407,"en":"Was the desert of It-Ölbös;"},{"id":"manas-2010:p1540:b001:l012","ordinal":66408,"en":"No mountain even ankle-bone-sized,"},{"id":"manas-2010:p1540:b001:l013","ordinal":66409,"en":"No hollow even saddlecloth-sized,"},{"id":"manas-2010:p1540:b001:l014","ordinal":66410,"en":"That land was level as a blade."},{"id":"manas-2010:p1540:b001:l015","ordinal":66411,"en":"The whole plain crackled;"},{"id":"manas-2010:p1540:b001:l016","ordinal":66412,"en":"Those were the teeming Chinese people."},{"id":"manas-2010:p1540:b001:l017","ordinal":66413,"en":"Fighting the multitude of Chinese,"},{"id":"manas-2010:p1540:b001:l018","ordinal":66414,"en":"Khan Manas's forty companions,"},{"id":"manas-2010:p1540:b001:l019","ordinal":66415,"en":"Almambet, Chubak and hero Syrgak—"},{"id":"manas-2010:p1540:b001:l020","ordinal":66416,"en":"Those were lion-born champions."},{"id":"manas-2010:p1540:b001:l021","ordinal":66417,"en":"When the multitude of Chinese surged,"},{"id":"manas-2010:p1540:b001:l022","ordinal":66418,"en":"Like a river admitting no barrier,"},{"id":"manas-2010:p1540:b001:l023","ordinal":66419,"en":"That was a flood that swept all away."},{"id":"manas-2010:p1540:b001:l024","ordinal":66420,"en":"Without fleeing in fear of the multitude,"},{"id":"manas-2010:p1540:b001:l025","ordinal":66421,"en":"Having come in small numbers from Talas,"},{"id":"manas-2010:p1540:b001:l026","ordinal":66422,"en":"All six alike, without rest,"},{"id":"manas-2010:p1540:b001:l027","ordinal":66423,"en":"Those were the heroes who grappled."},{"id":"manas-2010:p1540:b001:l028","ordinal":66424,"en":"“Do not flee!” at the Chinese"},{"id":"manas-2010:p1540:b001:l029","ordinal":66425,"en":"Ay Jangjung came out shouting."},{"id":"manas-2010:p1540:b001:l030","ordinal":66426,"en":"“Slaughter them!” he bellowed,"},{"id":"manas-2010:p1540:b001:l031","ordinal":66427,"en":"And Kün Jangjung drove them forth."},{"id":"manas-2010:p1540:b001:l032","ordinal":66428,"en":"The multitude of Chinese fled a little,"},{"id":"manas-2010:p1540:b001:l033","ordinal":66429,"en":"Then turned back in a struggling mass."},{"id":"manas-2010:p1540:b001:l034","ordinal":66430,"en":"When they became intermingled,"},{"id":"manas-2010:p1540:b001:l035","ordinal":66431,"en":"Striking with battle-axes,"},{"id":"manas-2010:p1540:b001:l036","ordinal":66432,"en":"The Chinese and the forty companions,"},{"id":"manas-2010:p1540:b001:l037","ordinal":66433,"en":"The renowned lions, the three wolves,"},{"id":"manas-2010:p1540:b001:l038","ordinal":66434,"en":"Fought with thudding blows."},{"id":"manas-2010:p1540:b001:l039","ordinal":66435,"en":"Turmoil rose in clouds of dust;"},{"id":"manas-2010:p1540:b001:l040","ordinal":66436,"en":"No one could tell which was which;"},{"id":"manas-2010:p1540:b001:l041","ordinal":66437,"en":"Looking, the eye could not make them out."},{"id":"manas-2010:p1540:b001:l042","ordinal":66438,"en":"The sky became black dust;"},{"id":"manas-2010:p1541:b001:l001","ordinal":66439,"en":"The earth's surface became blood."},{"id":"manas-2010:p1541:b001:l002","ordinal":66440,"en":"Fighting the multitude of Chinese,"},{"id":"manas-2010:p1541:b001:l003","ordinal":66441,"en":"There were forty-three valiant souls."},{"id":"manas-2010:p1541:b001:l004","ordinal":66442,"en":"Rejoicing in their valor,"},{"id":"manas-2010:p1541:b001:l005","ordinal":66443,"en":"The multitude of Chinese lost their senses,"},{"id":"manas-2010:p1541:b001:l006","ordinal":66444,"en":"Lost their wits and stood stunned."},{"id":"manas-2010:p1541:b001:l007","ordinal":66445,"en":"They took no rest by day;"},{"id":"manas-2010:p1541:b001:l008","ordinal":66446,"en":"Fighting day and night,"},{"id":"manas-2010:p1541:b001:l009","ordinal":66447,"en":"In the desert of It-Ölbös,"},{"id":"manas-2010:p1541:b001:l010","ordinal":66448,"en":"They did not swallow even a taste of food."},{"id":"manas-2010:p1541:b001:l011","ordinal":66449,"en":"Much is false, much is true;"},{"id":"manas-2010:p1541:b001:l012","ordinal":66450,"en":"No one came back who saw it."},{"id":"manas-2010:p1541:b001:l013","ordinal":66451,"en":"One part false, one part true;"},{"id":"manas-2010:p1541:b001:l014","ordinal":66452,"en":"No one came back who knew it."},{"id":"manas-2010:p1541:b001:l015","ordinal":66453,"en":"No signal horn sounded from the broad expanse;"},{"id":"manas-2010:p1541:b001:l016","ordinal":66454,"en":"No small bird flew from the broad ravine;"},{"id":"manas-2010:p1541:b001:l017","ordinal":66455,"en":"No enemy escaped the spear."},{"id":"manas-2010:p1541:b001:l018","ordinal":66456,"en":"It was a land stretching flat and wide;"},{"id":"manas-2010:p1541:b001:l019","ordinal":66457,"en":"The Chinese people were uncountable."},{"id":"manas-2010:p1541:b001:l020","ordinal":66458,"en":"When the Chinese surged in,"},{"id":"manas-2010:p1541:b001:l021","ordinal":66459,"en":"When they fought without stopping,"},{"id":"manas-2010:p1541:b001:l022","ordinal":66460,"en":"“Let us trust to fate!” hero Syrgak"},{"id":"manas-2010:p1541:b001:l023","ordinal":66461,"en":"Shouted in wrath."},{"id":"manas-2010:p1541:b001:l024","ordinal":66462,"en":"“Almambet, Chubak, well done!” he said,"},{"id":"manas-2010:p1541:b001:l025","ordinal":66463,"en":"Calling the forty companions."},{"id":"manas-2010:p1541:b001:l026","ordinal":66464,"en":"“Saying, ‘The Chinese come sweeping upon us,’"},{"id":"manas-2010:p1541:b001:l027","ordinal":66465,"en":"Saying, ‘My dear life will perish,’"},{"id":"manas-2010:p1541:b001:l028","ordinal":66466,"en":"Do not slacken your resolve;"},{"id":"manas-2010:p1541:b001:l029","ordinal":66467,"en":"Do not lose your spirit."},{"id":"manas-2010:p1541:b001:l030","ordinal":66468,"en":"Along Keng-Kol and Talas,"},{"id":"manas-2010:p1541:b001:l031","ordinal":66469,"en":"While Khan Manas was there,"},{"id":"manas-2010:p1541:b001:l032","ordinal":66470,"en":"We used to slice and eat rump meat;"},{"id":"manas-2010:p1541:b001:l033","ordinal":66471,"en":"‘The Chinese people behind their gates,"},{"id":"manas-2010:p1541:b001:l034","ordinal":66472,"en":"I alone am their match,’ we used to say."},{"id":"manas-2010:p1541:b001:l035","ordinal":66473,"en":"‘Red spears and hungry steel"},{"id":"manas-2010:p1541:b001:l036","ordinal":66474,"en":"We shall smear,’ we used to say."},{"id":"manas-2010:p1541:b001:l037","ordinal":66475,"en":"‘If the forty of us stand together,"},{"id":"manas-2010:p1541:b001:l038","ordinal":66476,"en":"We shall press forward,’ we used to say."},{"id":"manas-2010:p1541:b001:l039","ordinal":66477,"en":"The time to fight has come;"},{"id":"manas-2010:p1541:b001:l040","ordinal":66478,"en":"The hour to die has come!"},{"id":"manas-2010:p1541:b001:l041","ordinal":66479,"en":"From Beijing untouched by the holy one,"},{"id":"manas-2010:p1541:b001:l042","ordinal":66480,"en":"We shall not turn back without fighting."},{"id":"manas-2010:p1542:b001:l001","ordinal":66481,"en":"Does any person remain without dying?"},{"id":"manas-2010:p1542:b001:l002","ordinal":66482,"en":"We shall not return until we die!"},{"id":"manas-2010:p1542:b001:l003","ordinal":66483,"en":"What is written on our foreheads,"},{"id":"manas-2010:p1542:b001:l004","ordinal":66484,"en":"Whenever it comes, we shall face it."},{"id":"manas-2010:p1542:b001:l005","ordinal":66485,"en":"When we set out from Talas,"},{"id":"manas-2010:p1542:b001:l006","ordinal":66486,"en":"On that very day we died!"},{"id":"manas-2010:p1542:b001:l007","ordinal":66487,"en":"Watch, forty companions:"},{"id":"manas-2010:p1542:b001:l008","ordinal":66488,"en":"Holding my spear, I shall break their ranks;"},{"id":"manas-2010:p1542:b001:l009","ordinal":66489,"en":"If death is due, I shall fall to a shot!"},{"id":"manas-2010:p1542:b001:l010","ordinal":66490,"en":"Think of it, forty companions!"},{"id":"manas-2010:p1542:b001:l011","ordinal":66491,"en":"When my Lord gives the command,"},{"id":"manas-2010:p1542:b001:l012","ordinal":66492,"en":"When the death-angel stretches out his hand,"},{"id":"manas-2010:p1542:b001:l013","ordinal":66493,"en":"Will not the dug grave receive us?"},{"id":"manas-2010:p1542:b001:l014","ordinal":66494,"en":"Will not the dark earth contain us!"},{"id":"manas-2010:p1542:b001:l015","ordinal":66495,"en":"Is there a person who will not die?"},{"id":"manas-2010:p1542:b001:l016","ordinal":66496,"en":"Charge, companions;"},{"id":"manas-2010:p1542:b001:l017","ordinal":66497,"en":"Let us enter without wavering;"},{"id":"manas-2010:p1542:b001:l018","ordinal":66498,"en":"Making the Chinese cry out,"},{"id":"manas-2010:p1542:b001:l019","ordinal":66499,"en":"Let us drive them toward Beijing!"},{"id":"manas-2010:p1542:b001:l020","ordinal":66500,"en":"Let us leave their weak men alone;"},{"id":"manas-2010:p1542:b001:l021","ordinal":66501,"en":"Let us face and aim at their khans!”"},{"id":"manas-2010:p1542:b001:l022","ordinal":66502,"en":"Hero Syrgak charged,"},{"id":"manas-2010:p1542:b001:l023","ordinal":66503,"en":"Shouting with courage,"},{"id":"manas-2010:p1542:b001:l024","ordinal":66504,"en":"“Whoever stands without charging,"},{"id":"manas-2010:p1542:b001:l025","ordinal":66505,"en":"His seven forefathers are infidels!” he said."},{"id":"manas-2010:p1542:b001:l026","ordinal":66506,"en":"Syrgak entered their midst,"},{"id":"manas-2010:p1542:b001:l027","ordinal":66507,"en":"Girded with a golden belt,"},{"id":"manas-2010:p1542:b001:l028","ordinal":66508,"en":"His moon-like face marked by a swelling,"},{"id":"manas-2010:p1542:b001:l029","ordinal":66509,"en":"He pressed into their midst."},{"id":"manas-2010:p1542:b001:l030","ordinal":66510,"en":"Smashing them to pieces and raising dust,"},{"id":"manas-2010:p1542:b001:l031","ordinal":66511,"en":"While Syrgak fought,"},{"id":"manas-2010:p1542:b001:l032","ordinal":66512,"en":"Golden-forelocked, tasseled-belted,"},{"id":"manas-2010:p1542:b001:l033","ordinal":66513,"en":"Almambet, Azizkan's son,"},{"id":"manas-2010:p1542:b001:l034","ordinal":66514,"en":"Girding his waist securely,"},{"id":"manas-2010:p1542:b001:l035","ordinal":66515,"en":"Upon seven vast hosts of Chinese clans,"},{"id":"manas-2010:p1542:b001:l036","ordinal":66516,"en":"Entered alone to attack."},{"id":"manas-2010:p1542:b001:l037","ordinal":66517,"en":"Chubak, Khan Baltay's son,"},{"id":"manas-2010:p1542:b001:l038","ordinal":66518,"en":"Charged and made battle."},{"id":"manas-2010:p1542:b001:l039","ordinal":66519,"en":"Look at the haze, look at the embers;"},{"id":"manas-2010:p1542:b001:l040","ordinal":66520,"en":"When these three brought slaughter,"},{"id":"manas-2010:p1542:b001:l041","ordinal":66521,"en":"Look at the shots that struck unfailingly!"},{"id":"manas-2010:p1542:b001:l042","ordinal":66522,"en":"Look at the trenches dug,"},{"id":"manas-2010:p1543:b001:l001","ordinal":66523,"en":"Look at the boiling misery!"},{"id":"manas-2010:p1543:b001:l002","ordinal":66524,"en":"Bellowing their battle cry,"},{"id":"manas-2010:p1543:b001:l003","ordinal":66525,"en":"Look at the Chinese army surging forward!"},{"id":"manas-2010:p1543:b001:l004","ordinal":66526,"en":"Look at the dust that hides the sky;"},{"id":"manas-2010:p1543:b001:l005","ordinal":66527,"en":"Buried within the dust,"},{"id":"manas-2010:p1543:b001:l006","ordinal":66528,"en":"Look at the flowing blood!"},{"id":"manas-2010:p1543:b001:l007","ordinal":66529,"en":"Blazing up whenever they seem exhausted,"},{"id":"manas-2010:p1543:b001:l008","ordinal":66530,"en":"Look at the deeply rooted Chinese people;"},{"id":"manas-2010:p1543:b001:l009","ordinal":66531,"en":"Never looking back or retreating,"},{"id":"manas-2010:p1543:b001:l010","ordinal":66532,"en":"Look at the people fighting to destruction!"},{"id":"manas-2010:p1543:b001:l011","ordinal":66533,"en":"Shouting in wrath,"},{"id":"manas-2010:p1543:b001:l012","ordinal":66534,"en":"When the Chinese swept upon them,"},{"id":"manas-2010:p1543:b001:l013","ordinal":66535,"en":"Again the Chinese were barred"},{"id":"manas-2010:p1543:b001:l014","ordinal":66536,"en":"By Syrgak, Ulak Khan's son."},{"id":"manas-2010:p1543:b001:l015","ordinal":66537,"en":"(His strength could match the world;"},{"id":"manas-2010:p1543:b001:l016","ordinal":66538,"en":"Manas and hero Syrgak"},{"id":"manas-2010:p1543:b001:l017","ordinal":66539,"en":"Were the sons of brothers.)"},{"id":"manas-2010:p1543:b001:l018","ordinal":66540,"en":"Then Syrgak, dear lion,"},{"id":"manas-2010:p1543:b001:l019","ordinal":66541,"en":"Straining forward and bringing slaughter,"},{"id":"manas-2010:p1543:b001:l020","ordinal":66542,"en":"Riding the swift steed Kökchebich,"},{"id":"manas-2010:p1543:b001:l021","ordinal":66543,"en":"Pressing hard without drawing back,"},{"id":"manas-2010:p1543:b001:l022","ordinal":66544,"en":"As he fought with crashing blows,"},{"id":"manas-2010:p1543:b001:l023","ordinal":66545,"en":"The dear youth of twenty-one"},{"id":"manas-2010:p1543:b001:l024","ordinal":66546,"en":"Was covered in crimson blood,"},{"id":"manas-2010:p1543:b001:l025","ordinal":66547,"en":"His dear head suffering hardship."},{"id":"manas-2010:p1543:b001:l026","ordinal":66548,"en":"Wearing a coat of blue ribbed cloth,"},{"id":"manas-2010:p1543:b001:l027","ordinal":66549,"en":"Riding a horse like Kögala,"},{"id":"manas-2010:p1543:b001:l028","ordinal":66550,"en":"Tall of body, broad of shoulder,"},{"id":"manas-2010:p1543:b001:l029","ordinal":66551,"en":"Charged in from one side"},{"id":"manas-2010:p1543:b001:l030","ordinal":66552,"en":"Chubak, Khan Baltay's son."},{"id":"manas-2010:p1543:b001:l031","ordinal":66553,"en":"Their center, Almambet"},{"id":"manas-2010:p1543:b001:l032","ordinal":66554,"en":"Bored through as he came;"},{"id":"manas-2010:p1543:b001:l033","ordinal":66555,"en":"Their two flanks, hero Syrgak"},{"id":"manas-2010:p1543:b001:l034","ordinal":66556,"en":"Drove before him as he came;"},{"id":"manas-2010:p1543:b001:l035","ordinal":66557,"en":"Among the champions, lion Chubak"},{"id":"manas-2010:p1543:b001:l036","ordinal":66558,"en":"Came slaughtering them;"},{"id":"manas-2010:p1543:b001:l037","ordinal":66559,"en":"Toward Beijing in Kakan-Chin,"},{"id":"manas-2010:p1543:b001:l038","ordinal":66560,"en":"Making the Chinese bellow,"}]
