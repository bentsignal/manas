[{"id":"manas-2010:p1678:b001:l007","ordinal":72193,"en":"The emperor's Beijing,"},{"id":"manas-2010:p1678:b001:l008","ordinal":72194,"en":"The Chinese, made to howl—"},{"id":"manas-2010:p1678:b001:l009","ordinal":72195,"en":"Riding his Sarala,"},{"id":"manas-2010:p1678:b001:l010","ordinal":72196,"en":"As a tale for his people,"},{"id":"manas-2010:p1678:b001:l011","ordinal":72197,"en":"He will drive them in their multitudes home."},{"id":"manas-2010:p1678:b001:l012","ordinal":72198,"en":"May God strike this fugitive wretch!"},{"id":"manas-2010:p1678:b001:l013","ordinal":72199,"en":"The emperor's Beijing,"},{"id":"manas-2010:p1678:b001:l014","ordinal":72200,"en":"If this fugitive grows angry,"},{"id":"manas-2010:p1678:b001:l015","ordinal":72201,"en":"He will drive and slaughter it;"},{"id":"manas-2010:p1678:b001:l016","ordinal":72202,"en":"He will wreak devastation upon it all."},{"id":"manas-2010:p1678:b001:l017","ordinal":72203,"en":"See this fugitive's measure:"},{"id":"manas-2010:p1678:b001:l018","ordinal":72204,"en":"He survives where death does not take him;"},{"id":"manas-2010:p1678:b001:l019","ordinal":72205,"en":"Managing somehow, with trickery,"},{"id":"manas-2010:p1678:b001:l020","ordinal":72206,"en":"He will take so many heads!”"},{"id":"manas-2010:p1678:b001:l021","ordinal":72207,"en":"Before he could close his mouth,"},{"id":"manas-2010:p1678:b001:l022","ordinal":72208,"en":"Six thousand Chinese and countless governors"},{"id":"manas-2010:p1678:b001:l023","ordinal":72209,"en":"He plunged among and attacked—"},{"id":"manas-2010:p1678:b001:l024","ordinal":72210,"en":"What a hero was dear Alma!"},{"id":"manas-2010:p1678:b001:l025","ordinal":72211,"en":"The steed Sarala beneath him,"},{"id":"manas-2010:p1678:b001:l026","ordinal":72212,"en":"On the plain called It-Ölbös,"},{"id":"manas-2010:p1678:b001:l027","ordinal":72213,"en":"Cotton sash and wide boots,"},{"id":"manas-2010:p1678:b001:l028","ordinal":72214,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1678:b001:l029","ordinal":72215,"en":"Was reached faster than an arrow."},{"id":"manas-2010:p1678:b001:l030","ordinal":72216,"en":"Your perfect goshawk, lion Alma,"},{"id":"manas-2010:p1678:b001:l031","ordinal":72217,"en":"From Algara's back"},{"id":"manas-2010:p1678:b001:l032","ordinal":72218,"en":"The lion-like Fierce One"},{"id":"manas-2010:p1678:b001:l033","ordinal":72219,"en":"Thrust down as he passed."},{"id":"manas-2010:p1678:b001:l034","ordinal":72220,"en":"When the Fierce One fell from his horse,"},{"id":"manas-2010:p1678:b001:l035","ordinal":72221,"en":"Six thousand governors and countless Chinese"},{"id":"manas-2010:p1678:b001:l036","ordinal":72222,"en":"Attacked together."},{"id":"manas-2010:p1678:b001:l037","ordinal":72223,"en":"When the Chinese swarmed,"},{"id":"manas-2010:p1678:b001:l038","ordinal":72224,"en":"Their bow-drawing spearmen"},{"id":"manas-2010:p1678:b001:l039","ordinal":72225,"en":"All arrived together."},{"id":"manas-2010:p1678:b001:l040","ordinal":72226,"en":"Your devastating lion Alma"},{"id":"manas-2010:p1678:b001:l041","ordinal":72227,"en":"They enclosed in their midst."},{"id":"manas-2010:p1678:b001:l042","ordinal":72228,"en":"His poor life came under strain;"},{"id":"manas-2010:p1679:b001:l001","ordinal":72229,"en":"Lances broke and bent."},{"id":"manas-2010:p1679:b001:l002","ordinal":72230,"en":"Perish, world, with your day of taking life!"},{"id":"manas-2010:p1679:b001:l003","ordinal":72231,"en":"His life held in trust came under strain."},{"id":"manas-2010:p1679:b001:l004","ordinal":72232,"en":"For sixty days he fought among them;"},{"id":"manas-2010:p1679:b001:l005","ordinal":72233,"en":"Your noble one broke free,"},{"id":"manas-2010:p1679:b001:l006","ordinal":72234,"en":"Wounded in sixty places."},{"id":"manas-2010:p1679:b001:l007","ordinal":72235,"en":"For seventy days he fought among them;"},{"id":"manas-2010:p1679:b001:l008","ordinal":72236,"en":"Dear Alma broke free,"},{"id":"manas-2010:p1679:b001:l009","ordinal":72237,"en":"Wounded in seventy places."},{"id":"manas-2010:p1679:b001:l010","ordinal":72238,"en":"When your Alma escaped,"},{"id":"manas-2010:p1679:b001:l011","ordinal":72239,"en":"See the hail, see the embers,"},{"id":"manas-2010:p1679:b001:l012","ordinal":72240,"en":"See the shots striking separately!"},{"id":"manas-2010:p1679:b001:l013","ordinal":72241,"en":"See the rain, see the downpour,"},{"id":"manas-2010:p1679:b001:l014","ordinal":72242,"en":"See the shots striking all together!"},{"id":"manas-2010:p1679:b001:l015","ordinal":72243,"en":"Crying “Zhang-Zhung!” as their battle cry,"},{"id":"manas-2010:p1679:b001:l016","ordinal":72244,"en":"See the Chinese army swarming!"},{"id":"manas-2010:p1679:b001:l017","ordinal":72245,"en":"See the mighty Kojozhash!"},{"id":"manas-2010:p1679:b001:l018","ordinal":72246,"en":"The ravenous-mouthed white short musket"},{"id":"manas-2010:p1679:b001:l019","ordinal":72247,"en":"He seized and fired a thousand times;"},{"id":"manas-2010:p1679:b001:l020","ordinal":72248,"en":"Kojozhash did not tire."},{"id":"manas-2010:p1679:b001:l021","ordinal":72249,"en":"The lacquered musket in his hand,"},{"id":"manas-2010:p1679:b001:l022","ordinal":72250,"en":"Almambet moved with it;"},{"id":"manas-2010:p1679:b001:l023","ordinal":72251,"en":"Leaning right, he fired once,"},{"id":"manas-2010:p1679:b001:l024","ordinal":72252,"en":"Felling ten or more;"},{"id":"manas-2010:p1679:b001:l025","ordinal":72253,"en":"Leaning left, he fired once,"},{"id":"manas-2010:p1679:b001:l026","ordinal":72254,"en":"Dear Alma felled their sultans."},{"id":"manas-2010:p1679:b001:l027","ordinal":72255,"en":"The distant black unbelievers"},{"id":"manas-2010:p1679:b001:l028","ordinal":72256,"en":"He struck with his musket;"},{"id":"manas-2010:p1679:b001:l029","ordinal":72257,"en":"Those who came close before him,"},{"id":"manas-2010:p1679:b001:l030","ordinal":72258,"en":"Your Alma stabbed with his lacquered lance."},{"id":"manas-2010:p1679:b001:l031","ordinal":72259,"en":"A banner of mottled gray appeared;"},{"id":"manas-2010:p1679:b001:l032","ordinal":72260,"en":"The Chinese raised a din of lamentation."},{"id":"manas-2010:p1679:b001:l033","ordinal":72261,"en":"The Chinese fled in confusion,"},{"id":"manas-2010:p1679:b001:l034","ordinal":72262,"en":"Pleading with wretched Kojozhash."},{"id":"manas-2010:p1679:b001:l035","ordinal":72263,"en":"Howling, the Chinese ran;"},{"id":"manas-2010:p1679:b001:l036","ordinal":72264,"en":"At the sight of Almambet's bearing,"},{"id":"manas-2010:p1679:b001:l037","ordinal":72265,"en":"They despaired of their dear lives."},{"id":"manas-2010:p1679:b001:l038","ordinal":72266,"en":"The lacquered lance with its steel tip,"},{"id":"manas-2010:p1679:b001:l039","ordinal":72267,"en":"Your mighty lord Alma"},{"id":"manas-2010:p1679:b001:l040","ordinal":72268,"en":"Firmly gripped and swung,"},{"id":"manas-2010:p1679:b001:l041","ordinal":72269,"en":"The pockmarked Chinese army's countless"},{"id":"manas-2010:p1679:b001:l042","ordinal":72270,"en":"Ranks he broke apart,"},{"id":"manas-2010:p1680:b001:l001","ordinal":72271,"en":"He crushed six thousand,"},{"id":"manas-2010:p1680:b001:l002","ordinal":72272,"en":"Calling, “Where is the fighting swine?”"},{"id":"manas-2010:p1680:b001:l003","ordinal":72273,"en":"He crushed seven thousand,"},{"id":"manas-2010:p1680:b001:l004","ordinal":72274,"en":"Calling, “Where is that consummate one,"},{"id":"manas-2010:p1680:b001:l005","ordinal":72275,"en":"That fool Kojozhash?”"},{"id":"manas-2010:p1680:b001:l006","ordinal":72276,"en":"The whole world was stirred;"},{"id":"manas-2010:p1680:b001:l007","ordinal":72277,"en":"Kalmyks and countless governors were slaughtered,"},{"id":"manas-2010:p1680:b001:l008","ordinal":72278,"en":"Their uproar rose in dust."},{"id":"manas-2010:p1680:b001:l009","ordinal":72279,"en":"The formidable Chinese pressed harder,"},{"id":"manas-2010:p1680:b001:l010","ordinal":72280,"en":"Stirring all the way from Beijing."},{"id":"manas-2010:p1680:b001:l011","ordinal":72281,"en":"Kojozhash, son of Karazhoy,"},{"id":"manas-2010:p1680:b001:l012","ordinal":72282,"en":"Stood in fury."},{"id":"manas-2010:p1680:b001:l013","ordinal":72283,"en":"Against your khan, lord Alma,"},{"id":"manas-2010:p1680:b001:l014","ordinal":72284,"en":"He devised a fierce stratagem."},{"id":"manas-2010:p1680:b001:l015","ordinal":72285,"en":"The reason for his fierce stratagem:"},{"id":"manas-2010:p1680:b001:l016","ordinal":72286,"en":"Kojozhash, son of Karazhoy,"},{"id":"manas-2010:p1680:b001:l017","ordinal":72287,"en":"Had become Beijing's support."},{"id":"manas-2010:p1680:b001:l018","ordinal":72288,"en":"He saddled his gray filly;"},{"id":"manas-2010:p1680:b001:l019","ordinal":72289,"en":"Before dear Alma, Kojozhash"},{"id":"manas-2010:p1680:b001:l020","ordinal":72290,"en":"Had studied some three months earlier."},{"id":"manas-2010:p1680:b001:l021","ordinal":72291,"en":"He was the expert hero,"},{"id":"manas-2010:p1680:b001:l022","ordinal":72292,"en":"A master horseman, fleet on foot;"},{"id":"manas-2010:p1680:b001:l023","ordinal":72293,"en":"Now was his time to use his arts."},{"id":"manas-2010:p1680:b001:l024","ordinal":72294,"en":"For sixty days they exchanged fire;"},{"id":"manas-2010:p1680:b001:l025","ordinal":72295,"en":"Dear Alma would not be overcome."},{"id":"manas-2010:p1680:b001:l026","ordinal":72296,"en":"Look, and nothing met the eye;"},{"id":"manas-2010:p1680:b001:l027","ordinal":72297,"en":"The unbelievers' Kojozhash,"},{"id":"manas-2010:p1680:b001:l028","ordinal":72298,"en":"Where he was could not be known."},{"id":"manas-2010:p1680:b001:l029","ordinal":72299,"en":"His strength gone, reeling,"},{"id":"manas-2010:p1680:b001:l030","ordinal":72300,"en":"Azizkhan's Almambet—"},{"id":"manas-2010:p1680:b001:l031","ordinal":72301,"en":"Sarala beneath him"},{"id":"manas-2010:p1680:b001:l032","ordinal":72302,"en":"Could not lower his head to the ground;"},{"id":"manas-2010:p1680:b001:l033","ordinal":72303,"en":"His former stride,"},{"id":"manas-2010:p1680:b001:l034","ordinal":72304,"en":"The noble Sarala could no longer take."},{"id":"manas-2010:p1680:b001:l035","ordinal":72305,"en":"Dust swept up from the earth,"},{"id":"manas-2010:p1680:b001:l036","ordinal":72306,"en":"Dear Alma's strength ebbed away."},{"id":"manas-2010:p1680:b001:l037","ordinal":72307,"en":"Hero Manas was not there;"},{"id":"manas-2010:p1680:b001:l038","ordinal":72308,"en":"United when tiny as lice,"},{"id":"manas-2010:p1680:b001:l039","ordinal":72309,"en":"Joined when small as thumbs,"},{"id":"manas-2010:p1680:b001:l040","ordinal":72310,"en":"His companions, he saw, were not there."},{"id":"manas-2010:p1680:b001:l041","ordinal":72311,"en":"Akbaltay's Chubak was not there."},{"id":"manas-2010:p1680:b001:l042","ordinal":72312,"en":"When such affliction came,"},{"id":"manas-2010:p1681:b001:l001","ordinal":72313,"en":"The one who would rescue him,"},{"id":"manas-2010:p1681:b001:l002","ordinal":72314,"en":"Auspicious Syrgak, was not there either."},{"id":"manas-2010:p1681:b001:l003","ordinal":72315,"en":"The unflinching people of forty khans"},{"id":"manas-2010:p1681:b001:l004","ordinal":72316,"en":"Pressed your Alma hard;"},{"id":"manas-2010:p1681:b001:l005","ordinal":72317,"en":"Now was their time to encircle him."},{"id":"manas-2010:p1681:b001:l006","ordinal":72318,"en":"The raging unbelievers,"},{"id":"manas-2010:p1681:b001:l007","ordinal":72319,"en":"Kojozhash, son of Karazhoy,"},{"id":"manas-2010:p1681:b001:l008","ordinal":72320,"en":"Now enclosed him in their midst."},{"id":"manas-2010:p1681:b001:l009","ordinal":72321,"en":"His prophet true, his faith true,"},{"id":"manas-2010:p1681:b001:l010","ordinal":72322,"en":"Your king Alma, the dear lion—"},{"id":"manas-2010:p1681:b001:l011","ordinal":72323,"en":"Forty tribes of Chinese were slaughtered"},{"id":"manas-2010:p1681:b001:l012","ordinal":72324,"en":"When your mighty Alma came."},{"id":"manas-2010:p1681:b001:l013","ordinal":72325,"en":"Their dead were heaped like mountains,"},{"id":"manas-2010:p1681:b001:l014","ordinal":72326,"en":"The Chinese he met screamed."},{"id":"manas-2010:p1681:b001:l015","ordinal":72327,"en":"Though Almambet was alone,"},{"id":"manas-2010:p1681:b001:l016","ordinal":72328,"en":"Those who came before him,"},{"id":"manas-2010:p1681:b001:l017","ordinal":72329,"en":"The Chinese, fled thundering away."},{"id":"manas-2010:p1681:b001:l018","ordinal":72330,"en":"When lion-like dear Alma"},{"id":"manas-2010:p1681:b001:l019","ordinal":72331,"en":"Came driving them before him,"},{"id":"manas-2010:p1681:b001:l020","ordinal":72332,"en":"They scattered in separate groups."},{"id":"manas-2010:p1681:b001:l021","ordinal":72333,"en":"Reducing them utterly to dust,"},{"id":"manas-2010:p1681:b001:l022","ordinal":72334,"en":"Driving the unbelievers without pause,"},{"id":"manas-2010:p1681:b001:l023","ordinal":72335,"en":"“Trust in God!” he cried,"},{"id":"manas-2010:p1681:b001:l024","ordinal":72336,"en":"And swept them toward Beijing."},{"id":"manas-2010:p1681:b001:l025","ordinal":72337,"en":"Taking courage, the emperor's"},{"id":"manas-2010:p1681:b001:l026","ordinal":72338,"en":"Chinese multitude assembled."},{"id":"manas-2010:p1681:b001:l027","ordinal":72339,"en":"When they counted the people,"},{"id":"manas-2010:p1681:b001:l028","ordinal":72340,"en":"With Ezkara foremost,"},{"id":"manas-2010:p1681:b001:l029","ordinal":72341,"en":"Forty thousand champions had been slain."},{"id":"manas-2010:p1681:b001:l030","ordinal":72342,"en":"The Chinese, a people with a homeland,"},{"id":"manas-2010:p1681:b001:l031","ordinal":72343,"en":"How could their fighting cease?"},{"id":"manas-2010:p1681:b001:l032","ordinal":72344,"en":"Against your lone, distinguished Alma,"},{"id":"manas-2010:p1681:b001:l033","ordinal":72345,"en":"All the Chinese assembled."},{"id":"manas-2010:p1681:b001:l034","ordinal":72346,"en":"Swarming without restraint,"},{"id":"manas-2010:p1681:b001:l035","ordinal":72347,"en":"The lone champion Alma's"},{"id":"manas-2010:p1681:b001:l036","ordinal":72348,"en":"Head they beset with hardship."},{"id":"manas-2010:p1681:b001:l037","ordinal":72349,"en":"The black-edged hungry steel"},{"id":"manas-2010:p1681:b001:l038","ordinal":72350,"en":"Rang in his hand."},{"id":"manas-2010:p1681:b001:l039","ordinal":72351,"en":"Kojozhash and Kongurbay—"},{"id":"manas-2010:p1681:b001:l040","ordinal":72352,"en":"Anyone other than those two"},{"id":"manas-2010:p1681:b001:l041","ordinal":72353,"en":"He held worth less than his boot-leg,"},{"id":"manas-2010:p1681:b001:l042","ordinal":72354,"en":"As dear Alma rushed ringing on."},{"id":"manas-2010:p1682:b001:l001","ordinal":72355,"en":"Drawing bows, raining arrows,"},{"id":"manas-2010:p1682:b001:l002","ordinal":72356,"en":"All the Chinese swarmed."},{"id":"manas-2010:p1682:b001:l003","ordinal":72357,"en":"The Fleet-Footed and Dagger-Hands"},{"id":"manas-2010:p1682:b001:l004","ordinal":72358,"en":"Prepared upon one side;"},{"id":"manas-2010:p1682:b001:l005","ordinal":72359,"en":"For sixty days they fought."},{"id":"manas-2010:p1682:b001:l006","ordinal":72360,"en":"On another side was Karazhoy;"},{"id":"manas-2010:p1682:b001:l007","ordinal":72361,"en":"The Chinese lay in wait."},{"id":"manas-2010:p1682:b001:l008","ordinal":72362,"en":"That great battlefield of combat"},{"id":"manas-2010:p1682:b001:l009","ordinal":72363,"en":"Was the desert forty days across;"},{"id":"manas-2010:p1682:b001:l010","ordinal":72364,"en":"Almambet's death came due,"},{"id":"manas-2010:p1682:b001:l011","ordinal":72365,"en":"There was the place of his ruin."},{"id":"manas-2010:p1682:b001:l012","ordinal":72366,"en":"Cotton sash and wide boots,"},{"id":"manas-2010:p1682:b001:l013","ordinal":72367,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1682:b001:l014","ordinal":72368,"en":"Came proudly from the mountain slope."},{"id":"manas-2010:p1682:b001:l015","ordinal":72369,"en":"At the sight of Kongurbay,"},{"id":"manas-2010:p1682:b001:l016","ordinal":72370,"en":"Khan Almambet, that lone soul,"},{"id":"manas-2010:p1682:b001:l017","ordinal":72371,"en":"Could not stand still in his fury."},{"id":"manas-2010:p1682:b001:l018","ordinal":72372,"en":"“If I live, grant me gathered wealth;"},{"id":"manas-2010:p1682:b001:l019","ordinal":72373,"en":"If I die, grant me faith.”"},{"id":"manas-2010:p1682:b001:l020","ordinal":72374,"en":"Sending Sarala streaming onward,"},{"id":"manas-2010:p1682:b001:l021","ordinal":72375,"en":"Illustrious Almambet,"},{"id":"manas-2010:p1682:b001:l022","ordinal":72376,"en":"In the opening and closing of an eye,"},{"id":"manas-2010:p1682:b001:l023","ordinal":72377,"en":"Before this or that could be said,"},{"id":"manas-2010:p1682:b001:l024","ordinal":72378,"en":"Reached Kongurbay."},{"id":"manas-2010:p1682:b001:l025","ordinal":72379,"en":"Upon reaching him, your lion Alma,"},{"id":"manas-2010:p1682:b001:l026","ordinal":72380,"en":"From Algara's back"},{"id":"manas-2010:p1682:b001:l027","ordinal":72381,"en":"The Manzhuu khan of the monks"},{"id":"manas-2010:p1682:b001:l028","ordinal":72382,"en":"Thrust down as he passed."},{"id":"manas-2010:p1682:b001:l029","ordinal":72383,"en":"Turning with Sarala,"},{"id":"manas-2010:p1682:b001:l030","ordinal":72384,"en":"Before dear Khan Alma could reach him,"},{"id":"manas-2010:p1682:b001:l031","ordinal":72385,"en":"The noble Sarala ran;"},{"id":"manas-2010:p1682:b001:l032","ordinal":72386,"en":"When his destined due arrived,"},{"id":"manas-2010:p1682:b001:l033","ordinal":72387,"en":"Sarala, swiftest among beasts,"},{"id":"manas-2010:p1682:b001:l034","ordinal":72388,"en":"Bent his knees to the ground."},{"id":"manas-2010:p1682:b001:l035","ordinal":72389,"en":"Falling short, stumbling,"},{"id":"manas-2010:p1682:b001:l036","ordinal":72390,"en":"When he tripped,"},{"id":"manas-2010:p1682:b001:l037","ordinal":72391,"en":"The golden shield upon his head"},{"id":"manas-2010:p1682:b001:l038","ordinal":72392,"en":"Flew down to the ground."},{"id":"manas-2010:p1682:b001:l039","ordinal":72393,"en":"A master horseman, fleet on foot,"},{"id":"manas-2010:p1682:b001:l040","ordinal":72394,"en":"The great royal marksman,"},{"id":"manas-2010:p1682:b001:l041","ordinal":72395,"en":"Kojozhash, son of Karazhoy,"},{"id":"manas-2010:p1682:b001:l042","ordinal":72396,"en":"The finest in marksmanship,"},{"id":"manas-2010:p1683:b001:l001","ordinal":72397,"en":"Steadily held his lacquered musket,"},{"id":"manas-2010:p1683:b001:l002","ordinal":72398,"en":"Its trigger ready."},{"id":"manas-2010:p1683:b001:l003","ordinal":72399,"en":"The golden shield from his head,"},{"id":"manas-2010:p1683:b001:l004","ordinal":72400,"en":"Your distinguished champion Alma,"},{"id":"manas-2010:p1683:b001:l005","ordinal":72401,"en":"Before he could lift it onto his head,"},{"id":"manas-2010:p1683:b001:l006","ordinal":72402,"en":"Secure his life held in trust,"},{"id":"manas-2010:p1683:b001:l007","ordinal":72403,"en":"And make himself firmly ready,"},{"id":"manas-2010:p1683:b001:l008","ordinal":72404,"en":"Kojozhash fired;"},{"id":"manas-2010:p1683:b001:l009","ordinal":72405,"en":"The noble head was shattered."},{"id":"manas-2010:p1683:b001:l010","ordinal":72406,"en":"When dear Alma fell to the bullet,"},{"id":"manas-2010:p1683:b001:l011","ordinal":72407,"en":"Pitch-black night descended;"},{"id":"manas-2010:p1683:b001:l012","ordinal":72408,"en":"An irreversible day of anguish came."},{"id":"manas-2010:p1683:b001:l013","ordinal":72409,"en":"Parted from the earth that sheltered him,"},{"id":"manas-2010:p1683:b001:l014","ordinal":72410,"en":"When dear Alma passed away,"},{"id":"manas-2010:p1683:b001:l015","ordinal":72411,"en":"Bereft of their dear lion,"},{"id":"manas-2010:p1683:b001:l016","ordinal":72412,"en":"The Muslims mourned."},{"id":"manas-2010:p1683:b001:l017","ordinal":72413,"en":"When Khan Almambet died,"},{"id":"manas-2010:p1683:b001:l018","ordinal":72414,"en":"The people wept, wept tears of blood,"},{"id":"manas-2010:p1683:b001:l019","ordinal":72415,"en":"All the Muslims wept."},{"id":"manas-2010:p1683:b001:l020","ordinal":72416,"en":"Saddle and saddlecloth still upon him,"},{"id":"manas-2010:p1683:b001:l021","ordinal":72417,"en":"Sarala bounded free."},{"id":"manas-2010:p1683:b001:l022","ordinal":72418,"en":"Struck by a bullet in the hip,"},{"id":"manas-2010:p1683:b001:l023","ordinal":72419,"en":"Running upon three legs,"},{"id":"manas-2010:p1683:b001:l024","ordinal":72420,"en":"His life held in trust, like this,"},{"id":"manas-2010:p1683:b001:l025","ordinal":72421,"en":"Sarala bore forth in pain."},{"id":"manas-2010:p1683:b001:l026","ordinal":72422,"en":"Cropping the tips of the fescue,"},{"id":"manas-2010:p1683:b001:l027","ordinal":72423,"en":"Sarala went grazing."},{"id":"manas-2010:p1683:b001:l028","ordinal":72424,"en":"As though his foal had been left behind,"},{"id":"manas-2010:p1683:b001:l029","ordinal":72425,"en":"Stopping and neighing,"},{"id":"manas-2010:p1683:b001:l030","ordinal":72426,"en":"Sarala went lamenting!"},{"id":"manas-2010:p1683:b001:l031","ordinal":72427,"en":"Struck from the vulnerable flank,"},{"id":"manas-2010:p1683:b001:l032","ordinal":72428,"en":"All their mighty men"},{"id":"manas-2010:p1683:b001:l033","ordinal":72429,"en":"Taken as gifts for the Chinese,"},{"id":"manas-2010:p1683:b001:l034","ordinal":72430,"en":"Affliction came upon their dear heads;"},{"id":"manas-2010:p1683:b001:l035","ordinal":72431,"en":"The sun was hidden, night descended."},{"id":"manas-2010:p1683:b001:l036","ordinal":72432,"en":"Having entered Beijing and turned back,"},{"id":"manas-2010:p1683:b001:l037","ordinal":72433,"en":"Bereft of their champions,"},{"id":"manas-2010:p1683:b001:l038","ordinal":72434,"en":"They had no cliff a goose could not circle."},{"id":"manas-2010:p1683:b001:l039","ordinal":72435,"en":"The Muslims who suffered ruin,"},{"id":"manas-2010:p1683:b001:l040","ordinal":72436,"en":"To rescue them,"},{"id":"manas-2010:p1683:b001:l041","ordinal":72437,"en":"Look—"},{"id":"manas-2010:p1683:b001:l042","ordinal":72438,"en":"Had no mountain, hero Almambet."},{"id":"manas-2010:p1684:b001:l001","ordinal":72439,"en":"“The handful of Muslims"},{"id":"manas-2010:p1684:b001:l002","ordinal":72440,"en":"Have suffered so much torment,” they said."},{"id":"manas-2010:p1684:b001:l003","ordinal":72441,"en":"With six swift horses,"},{"id":"manas-2010:p1684:b001:l004","ordinal":72442,"en":"With a letter small as a palm,"},{"id":"manas-2010:p1684:b001:l005","ordinal":72443,"en":"They sent a rider to brave Manas."},{"id":"manas-2010:p1684:b001:l006","ordinal":72444,"en":"Yraman's Singer Son,"},{"id":"manas-2010:p1684:b001:l007","ordinal":72445,"en":"With his tasselled, four-jointed drawstring,"},{"id":"manas-2010:p1684:b001:l008","ordinal":72446,"en":"Raised his voice and spoke:"},{"id":"manas-2010:p1684:b001:l009","ordinal":72447,"en":"“Lion Manas!” he said,"},{"id":"manas-2010:p1684:b001:l010","ordinal":72448,"en":"“The supports we relied upon,"}]
