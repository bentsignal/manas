[{"id":"manas-2010:p1618:b001:l013","ordinal":69633,"en":"Each upon his own front,"},{"id":"manas-2010:p1618:b001:l014","ordinal":69634,"en":"All did as they saw fit."},{"id":"manas-2010:p1618:b001:l015","ordinal":69635,"en":"Shouting in fury,"},{"id":"manas-2010:p1618:b001:l016","ordinal":69636,"en":"The three heroes put them to the sword,"},{"id":"manas-2010:p1618:b001:l017","ordinal":69637,"en":"“Drive them back!” they cried, overwhelming them."},{"id":"manas-2010:p1618:b001:l018","ordinal":69638,"en":"Bellowing and screaming,"},{"id":"manas-2010:p1618:b001:l019","ordinal":69639,"en":"The many Chinese indeed"},{"id":"manas-2010:p1618:b001:l020","ordinal":69640,"en":"Drew back and fled."},{"id":"manas-2010:p1618:b001:l021","ordinal":69641,"en":"When the Chinese people of forty khans"},{"id":"manas-2010:p1618:b001:l022","ordinal":69642,"en":"Had fled again,"},{"id":"manas-2010:p1618:b001:l023","ordinal":69643,"en":"Turning their horses' rumps,"},{"id":"manas-2010:p1618:b001:l024","ordinal":69644,"en":"From behind, Almambet"},{"id":"manas-2010:p1618:b001:l025","ordinal":69645,"en":"Came driving them onward."},{"id":"manas-2010:p1618:b001:l026","ordinal":69646,"en":"Giving them no rest, brave Syrgak"},{"id":"manas-2010:p1618:b001:l027","ordinal":69647,"en":"Came striking them."},{"id":"manas-2010:p1618:b001:l028","ordinal":69648,"en":"When Akbaltay's Chubak"},{"id":"manas-2010:p1618:b001:l029","ordinal":69649,"en":"Attacked without restraint,"},{"id":"manas-2010:p1618:b001:l030","ordinal":69650,"en":"When the forty companions behind"},{"id":"manas-2010:p1618:b001:l031","ordinal":69651,"en":"Split them off and drove them,"},{"id":"manas-2010:p1618:b001:l032","ordinal":69652,"en":"The Manzhuu, like black jackdaws,"},{"id":"manas-2010:p1618:b001:l033","ordinal":69653,"en":"Were driven back and scattered;"},{"id":"manas-2010:p1618:b001:l034","ordinal":69654,"en":"The Shibee, as many as a cow's hairs,"},{"id":"manas-2010:p1618:b001:l035","ordinal":69655,"en":"Were thrown into confusion."},{"id":"manas-2010:p1618:b001:l036","ordinal":69656,"en":"Cotton sash and wide boots,"},{"id":"manas-2010:p1618:b001:l037","ordinal":69657,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1618:b001:l038","ordinal":69658,"en":"Shouting in fury,"},{"id":"manas-2010:p1618:b001:l039","ordinal":69659,"en":"The Chinese who had fled"},{"id":"manas-2010:p1618:b001:l040","ordinal":69660,"en":"Cut off and scattered back."},{"id":"manas-2010:p1618:b001:l041","ordinal":69661,"en":"Algara's reins—"},{"id":"manas-2010:p1618:b001:l042","ordinal":69662,"en":"(Like a man whose wife a dark spirit afflicted)—"},{"id":"manas-2010:p1619:b001:l001","ordinal":69663,"en":"Kongurbay kept drawing in."},{"id":"manas-2010:p1619:b001:l002","ordinal":69664,"en":"So many Soloon and Manzhuu"},{"id":"manas-2010:p1619:b001:l003","ordinal":69665,"en":"Kongurbay slaughtered."},{"id":"manas-2010:p1619:b001:l004","ordinal":69666,"en":"When the Fierce One blocked them in front,"},{"id":"manas-2010:p1619:b001:l005","ordinal":69667,"en":"Screaming in the middle,"},{"id":"manas-2010:p1619:b001:l006","ordinal":69668,"en":"The fleeing Chinese gathered."},{"id":"manas-2010:p1619:b001:l007","ordinal":69669,"en":"When the heroes drove them on,"},{"id":"manas-2010:p1619:b001:l008","ordinal":69670,"en":"So many souls were slaughtered."},{"id":"manas-2010:p1619:b001:l009","ordinal":69671,"en":"Paying no heed to the danger,"},{"id":"manas-2010:p1619:b001:l010","ordinal":69672,"en":"Leopard Syrgak shone forth."},{"id":"manas-2010:p1619:b001:l011","ordinal":69673,"en":"“Alöökö's Kongurbay,"},{"id":"manas-2010:p1619:b001:l012","ordinal":69674,"en":"If he comes before me,"},{"id":"manas-2010:p1619:b001:l013","ordinal":69675,"en":"I shall go straight at him."},{"id":"manas-2010:p1619:b001:l014","ordinal":69676,"en":"Whatever Allah has decreed,"},{"id":"manas-2010:p1619:b001:l015","ordinal":69677,"en":"Whatever is written on my brow, I shall see.”"},{"id":"manas-2010:p1619:b001:l016","ordinal":69678,"en":"Ulak Khan's Syrgak,"},{"id":"manas-2010:p1619:b001:l017","ordinal":69679,"en":"Just reaching twenty-one,"},{"id":"manas-2010:p1619:b001:l018","ordinal":69680,"en":"The youth in his swelling prime,"},{"id":"manas-2010:p1619:b001:l019","ordinal":69681,"en":"Against the seething Chinese"},{"id":"manas-2010:p1619:b001:l020","ordinal":69682,"en":"Attacked without drawing back,"},{"id":"manas-2010:p1619:b001:l021","ordinal":69683,"en":"And stood beneath the banner."},{"id":"manas-2010:p1619:b001:l022","ordinal":69684,"en":"Kojozhash's father,"},{"id":"manas-2010:p1619:b001:l023","ordinal":69685,"en":"Karazhoy, he attacked."},{"id":"manas-2010:p1619:b001:l024","ordinal":69686,"en":"Before the man could turn back,"},{"id":"manas-2010:p1619:b001:l025","ordinal":69687,"en":"Before he could see the leopard,"},{"id":"manas-2010:p1619:b001:l026","ordinal":69688,"en":"Syrgak arrived faster than an arrow."},{"id":"manas-2010:p1619:b001:l027","ordinal":69689,"en":"As soon as brave Syrgak reached him,"},{"id":"manas-2010:p1619:b001:l028","ordinal":69690,"en":"The champion Karazhoy"},{"id":"manas-2010:p1619:b001:l029","ordinal":69691,"en":"He thrust down as he passed."},{"id":"manas-2010:p1619:b001:l030","ordinal":69692,"en":"A champion called Zhese"},{"id":"manas-2010:p1619:b001:l031","ordinal":69693,"en":"Arrived and put him on a horse."},{"id":"manas-2010:p1619:b001:l032","ordinal":69694,"en":"Before he could lead him away,"},{"id":"manas-2010:p1619:b001:l033","ordinal":69695,"en":"Golden forelock and tasseled belt,"},{"id":"manas-2010:p1619:b001:l034","ordinal":69696,"en":"Azizkhan's only son,"},{"id":"manas-2010:p1619:b001:l035","ordinal":69697,"en":"Striking Sarala with his whip,"},{"id":"manas-2010:p1619:b001:l036","ordinal":69698,"en":"Your noble Alma arrived."},{"id":"manas-2010:p1619:b001:l037","ordinal":69699,"en":"Upon reaching Karazhoy,"},{"id":"manas-2010:p1619:b001:l038","ordinal":69700,"en":"Your Alma raised a tumult;"},{"id":"manas-2010:p1619:b001:l039","ordinal":69701,"en":"After raising that tumult,"},{"id":"manas-2010:p1619:b001:l040","ordinal":69702,"en":"Of the champion Karazhoy"},{"id":"manas-2010:p1619:b001:l041","ordinal":69703,"en":"He cut off the head."},{"id":"manas-2010:p1619:b001:l042","ordinal":69704,"en":"“Of the Chinese with rank-buttons,"},{"id":"manas-2010:p1620:b001:l001","ordinal":69705,"en":"Having lost the finest,"},{"id":"manas-2010:p1620:b001:l002","ordinal":69706,"en":"How can I remain alive?!”"},{"id":"manas-2010:p1620:b001:l003","ordinal":69707,"en":"Kongurbay bellowed."},{"id":"manas-2010:p1620:b001:l004","ordinal":69708,"en":"Tossing his moustaches with a jerk,"},{"id":"manas-2010:p1620:b001:l005","ordinal":69709,"en":"Cotton sash and wide boots,"},{"id":"manas-2010:p1620:b001:l006","ordinal":69710,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1620:b001:l007","ordinal":69711,"en":"“At least that fugitive wretch,"},{"id":"manas-2010:p1620:b001:l008","ordinal":69712,"en":"Almambet, I shall slaughter!” he said."},{"id":"manas-2010:p1620:b001:l009","ordinal":69713,"en":"His great teeth, like doors,"},{"id":"manas-2010:p1620:b001:l010","ordinal":69714,"en":"Crumbled like grains of millet."},{"id":"manas-2010:p1620:b001:l011","ordinal":69715,"en":"Sending Algara racing,"},{"id":"manas-2010:p1620:b001:l012","ordinal":69716,"en":"He came thundering on."},{"id":"manas-2010:p1620:b001:l013","ordinal":69717,"en":"As he was about to reach Almambet,"},{"id":"manas-2010:p1620:b001:l014","ordinal":69718,"en":"Among the countless Chinese,"},{"id":"manas-2010:p1620:b001:l015","ordinal":69719,"en":"From Sarala's back,"},{"id":"manas-2010:p1620:b001:l016","ordinal":69720,"en":"About to thrust him down and pass,"},{"id":"manas-2010:p1620:b001:l017","ordinal":69721,"en":"Without looking all around,"},{"id":"manas-2010:p1620:b001:l018","ordinal":69722,"en":"Fired with the love of battle,"},{"id":"manas-2010:p1620:b001:l019","ordinal":69723,"en":"Not sparing his life a hair,"},{"id":"manas-2010:p1620:b001:l020","ordinal":69724,"en":"The brim of the black felt hat,"},{"id":"manas-2010:p1620:b001:l021","ordinal":69725,"en":"Khan Manas's Syrgak,"},{"id":"manas-2010:p1620:b001:l022","ordinal":69726,"en":"Whipped Kökchebich."},{"id":"manas-2010:p1620:b001:l023","ordinal":69727,"en":"From the flank, to the Fierce One,"},{"id":"manas-2010:p1620:b001:l024","ordinal":69728,"en":"Dear Syrgak arrived."},{"id":"manas-2010:p1620:b001:l025","ordinal":69729,"en":"From Algara's back,"},{"id":"manas-2010:p1620:b001:l026","ordinal":69730,"en":"Among seven great hosts of Chinese,"},{"id":"manas-2010:p1620:b001:l027","ordinal":69731,"en":"The mountain-like Fierce One"},{"id":"manas-2010:p1620:b001:l028","ordinal":69732,"en":"He thrust down as he passed."},{"id":"manas-2010:p1620:b001:l029","ordinal":69733,"en":"Sprawling broad as a hut,"},{"id":"manas-2010:p1620:b001:l030","ordinal":69734,"en":"From his horse the Fierce One, that wretch,"},{"id":"manas-2010:p1620:b001:l031","ordinal":69735,"en":"Flew off with limbs spread wide."},{"id":"manas-2010:p1620:b001:l032","ordinal":69736,"en":"When the Fierce One fell from his horse,"},{"id":"manas-2010:p1620:b001:l033","ordinal":69737,"en":"“Algara beneath him,"},{"id":"manas-2010:p1620:b001:l034","ordinal":69738,"en":"I shall seize, and break his support;"},{"id":"manas-2010:p1620:b001:l035","ordinal":69739,"en":"That monk whose horse is swift,"},{"id":"manas-2010:p1620:b001:l036","ordinal":69740,"en":"I shall quiet his soul like this,"},{"id":"manas-2010:p1620:b001:l037","ordinal":69741,"en":"I shall bring such torment upon him!”"},{"id":"manas-2010:p1620:b001:l038","ordinal":69742,"en":"Kongurbay's Algara,"},{"id":"manas-2010:p1620:b001:l039","ordinal":69743,"en":"Before he could turn and flee,"},{"id":"manas-2010:p1620:b001:l040","ordinal":69744,"en":"On the red slope, the broad road,"},{"id":"manas-2010:p1620:b001:l041","ordinal":69745,"en":"Before he could dodge and escape,"},{"id":"manas-2010:p1620:b001:l042","ordinal":69746,"en":"A hand reached his lead-rein."},{"id":"manas-2010:p1621:b001:l001","ordinal":69747,"en":"Taking Algara as booty,"},{"id":"manas-2010:p1621:b001:l002","ordinal":69748,"en":"He led him prancing alongside."},{"id":"manas-2010:p1621:b001:l003","ordinal":69749,"en":"A great trench had been dug;"},{"id":"manas-2010:p1621:b001:l004","ordinal":69750,"en":"Great misery had been stirred up."},{"id":"manas-2010:p1621:b001:l005","ordinal":69751,"en":"It was a mine where gold was dug,"},{"id":"manas-2010:p1621:b001:l006","ordinal":69752,"en":"A bad road no lone horse could pass."},{"id":"manas-2010:p1621:b001:l007","ordinal":69753,"en":"When he entered the narrow track,"},{"id":"manas-2010:p1621:b001:l008","ordinal":69754,"en":"Kökchebich, booty taken from the foe,"},{"id":"manas-2010:p1621:b001:l009","ordinal":69755,"en":"Never tired when ridden scouting;"},{"id":"manas-2010:p1621:b001:l010","ordinal":69756,"en":"This was no time for him to tire."},{"id":"manas-2010:p1621:b001:l011","ordinal":69757,"en":"Ridden to the rear camp, he never wearied."},{"id":"manas-2010:p1621:b001:l012","ordinal":69758,"en":"That day, Kökchebich—"},{"id":"manas-2010:p1621:b001:l013","ordinal":69759,"en":"It was no time for him to stumble."},{"id":"manas-2010:p1621:b001:l014","ordinal":69760,"en":"Yet Kökchebich beneath him"},{"id":"manas-2010:p1621:b001:l015","ordinal":69761,"en":"Stumbled as he passed;"},{"id":"manas-2010:p1621:b001:l016","ordinal":69762,"en":"The steel shield upon his head"},{"id":"manas-2010:p1621:b001:l017","ordinal":69763,"en":"Flew off and fell."},{"id":"manas-2010:p1621:b001:l018","ordinal":69764,"en":"Kojozhash, son of Karazhoy,"},{"id":"manas-2010:p1621:b001:l019","ordinal":69765,"en":"A master horseman, fleet on foot,"},{"id":"manas-2010:p1621:b001:l020","ordinal":69766,"en":"The champion lying in wait,"},{"id":"manas-2010:p1621:b001:l021","ordinal":69767,"en":"Exercising his surpassing marksmanship,"},{"id":"manas-2010:p1621:b001:l022","ordinal":69768,"en":"At the height straight ahead"},{"id":"manas-2010:p1621:b001:l023","ordinal":69769,"en":"Had concealed himself."},{"id":"manas-2010:p1621:b001:l024","ordinal":69770,"en":"Before the shield upon the ground"},{"id":"manas-2010:p1621:b001:l025","ordinal":69771,"en":"Could be reached and picked up,"},{"id":"manas-2010:p1621:b001:l026","ordinal":69772,"en":"Before he could put it on his head,"},{"id":"manas-2010:p1621:b001:l027","ordinal":69773,"en":"Never drawing back from what he faced,"},{"id":"manas-2010:p1621:b001:l028","ordinal":69774,"en":"Never turning from what he aimed at,"},{"id":"manas-2010:p1621:b001:l029","ordinal":69775,"en":"Red-clad and charging,"},{"id":"manas-2010:p1621:b001:l030","ordinal":69776,"en":"Syrgak at twenty-one he sighted:"},{"id":"manas-2010:p1621:b001:l031","ordinal":69777,"en":"“Between his two eyes,"},{"id":"manas-2010:p1621:b001:l032","ordinal":69778,"en":"The very place measured out,” he thought,"},{"id":"manas-2010:p1621:b001:l033","ordinal":69779,"en":"“Or, if lower, his eye.”"},{"id":"manas-2010:p1621:b001:l034","ordinal":69780,"en":"Taking steady aim, he fired once."},{"id":"manas-2010:p1621:b001:l035","ordinal":69781,"en":"Your brave Syrgak crumpled;"},{"id":"manas-2010:p1621:b001:l036","ordinal":69782,"en":"He lost the strength to utter a sound,"},{"id":"manas-2010:p1621:b001:l037","ordinal":69783,"en":"Dark blood flowed from his temple."},{"id":"manas-2010:p1621:b001:l038","ordinal":69784,"en":"When the bullet struck Syrgak,"},{"id":"manas-2010:p1621:b001:l039","ordinal":69785,"en":"Kökchebich beneath him,"},{"id":"manas-2010:p1621:b001:l040","ordinal":69786,"en":"Whose trot the wind could not match,"},{"id":"manas-2010:p1621:b001:l041","ordinal":69787,"en":"Was about to trot away."},{"id":"manas-2010:p1621:b001:l042","ordinal":69788,"en":"“At the first neck vertebra,” he thought,"},{"id":"manas-2010:p1622:b001:l001","ordinal":69789,"en":"“That is the measured place.”"},{"id":"manas-2010:p1622:b001:l002","ordinal":69790,"en":"Then, without letting him go far,"},{"id":"manas-2010:p1622:b001:l003","ordinal":69791,"en":"He fired once at Kökchebich."},{"id":"manas-2010:p1622:b001:l004","ordinal":69792,"en":"Wheeling round, he crumpled;"},{"id":"manas-2010:p1622:b001:l005","ordinal":69793,"en":"Heaven's own Kökchebich—"},{"id":"manas-2010:p1622:b001:l006","ordinal":69794,"en":"He died together with his horse,"},{"id":"manas-2010:p1622:b001:l007","ordinal":69795,"en":"Young Syrgak died among them."},{"id":"manas-2010:p1622:b001:l008","ordinal":69796,"en":"The Flood had never swept in there;"},{"id":"manas-2010:p1622:b001:l009","ordinal":69797,"en":"The surging multitude of Chinese"},{"id":"manas-2010:p1622:b001:l010","ordinal":69798,"en":"Were the people of forty khans."},{"id":"manas-2010:p1622:b001:l011","ordinal":69799,"en":"For the Chinese who had known no joy,"},{"id":"manas-2010:p1622:b001:l012","ordinal":69800,"en":"A joyful day now dawned:"},{"id":"manas-2010:p1622:b001:l013","ordinal":69801,"en":"“This Syrgak who has died,"},{"id":"manas-2010:p1622:b001:l014","ordinal":69802,"en":"Let us bind his corpse upon a mule,"},{"id":"manas-2010:p1622:b001:l015","ordinal":69803,"en":"Before the emperor-khan"},{"id":"manas-2010:p1622:b001:l016","ordinal":69804,"en":"Let us take it as a gift!”"},{"id":"manas-2010:p1622:b001:l017","ordinal":69805,"en":"The Chinese came swarming up,"},{"id":"manas-2010:p1622:b001:l018","ordinal":69806,"en":"With Kojozhash at their head,"},{"id":"manas-2010:p1622:b001:l019","ordinal":69807,"en":"And encircled him twelvefold."},{"id":"manas-2010:p1622:b001:l020","ordinal":69808,"en":"Sorrow too great for his breast to hold,"},{"id":"manas-2010:p1622:b001:l021","ordinal":69809,"en":"Your lone fierce-maned Alma's"},{"id":"manas-2010:p1622:b001:l022","ordinal":69810,"en":"Tears streamed in ten directions."},{"id":"manas-2010:p1622:b001:l023","ordinal":69811,"en":"See the ants, see the insects,"},{"id":"manas-2010:p1622:b001:l024","ordinal":69812,"en":"See the Chinese as numerous as insects,"},{"id":"manas-2010:p1622:b001:l025","ordinal":69813,"en":"See the trench they have dug,"},{"id":"manas-2010:p1622:b001:l026","ordinal":69814,"en":"See the misery they have stirred up,"},{"id":"manas-2010:p1622:b001:l027","ordinal":69815,"en":"Bellowing their battle cry,"},{"id":"manas-2010:p1622:b001:l028","ordinal":69816,"en":"See the Chinese army sweeping in!"},{"id":"manas-2010:p1622:b001:l029","ordinal":69817,"en":"Slaughter them on and they never end;"},{"id":"manas-2010:p1622:b001:l030","ordinal":69818,"en":"See the multitude, as countless as grass!"},{"id":"manas-2010:p1622:b001:l031","ordinal":69819,"en":"The leaders of ten wheeled round,"},{"id":"manas-2010:p1622:b001:l032","ordinal":69820,"en":"Their lances jutting,"},{"id":"manas-2010:p1622:b001:l033","ordinal":69821,"en":"All the warriors separated out;"},{"id":"manas-2010:p1622:b001:l034","ordinal":69822,"en":"The army swarmed, giving no rest."},{"id":"manas-2010:p1622:b001:l035","ordinal":69823,"en":"All Beijing was stirred;"},{"id":"manas-2010:p1622:b001:l036","ordinal":69824,"en":"Nothing could be caught by the eye."},{"id":"manas-2010:p1622:b001:l037","ordinal":69825,"en":"Earth flew and dust covered all;"},{"id":"manas-2010:p1622:b001:l038","ordinal":69826,"en":"One could not tell one from another!"},{"id":"manas-2010:p1622:b001:l039","ordinal":69827,"en":"Clear sky, darkened earth,"},{"id":"manas-2010:p1622:b001:l040","ordinal":69828,"en":"As though tumbleweeds were flying,"},{"id":"manas-2010:p1622:b001:l041","ordinal":69829,"en":"Armies teemed over the earth;"},{"id":"manas-2010:p1622:b001:l042","ordinal":69830,"en":"Seventy Beijings were stirred."},{"id":"manas-2010:p1623:b001:l001","ordinal":69831,"en":"Of the Chinese with rank-buttons,"},{"id":"manas-2010:p1623:b001:l002","ordinal":69832,"en":"The finest separated and swept forward."},{"id":"manas-2010:p1623:b001:l003","ordinal":69833,"en":"Of the jacket-wearing Chinese,"},{"id":"manas-2010:p1623:b001:l004","ordinal":69834,"en":"The strongest came into view."},{"id":"manas-2010:p1623:b001:l005","ordinal":69835,"en":"Kün Zhang-Zhung and Kongurbay"},{"id":"manas-2010:p1623:b001:l006","ordinal":69836,"en":"Came forward apart for single combat."},{"id":"manas-2010:p1623:b001:l007","ordinal":69837,"en":"Alöökö's Kongurbay,"},{"id":"manas-2010:p1623:b001:l008","ordinal":69838,"en":"This surpassing warrior,"},{"id":"manas-2010:p1623:b001:l009","ordinal":69839,"en":"Loomed like a mighty mountain."},{"id":"manas-2010:p1623:b001:l010","ordinal":69840,"en":"Venom poured from his mouth,"},{"id":"manas-2010:p1623:b001:l011","ordinal":69841,"en":"Dust rose wherever he moved,"},{"id":"manas-2010:p1623:b001:l012","ordinal":69842,"en":"His voice drove life from men."},{"id":"manas-2010:p1623:b001:l013","ordinal":69843,"en":"Making him leap and bound,"},{"id":"manas-2010:p1623:b001:l014","ordinal":69844,"en":"Sending the steed Algara surging,"},{"id":"manas-2010:p1623:b001:l015","ordinal":69845,"en":"Jerking the golden lead-rein,"},{"id":"manas-2010:p1623:b001:l016","ordinal":69846,"en":"The warriors' black horse,"},{"id":"manas-2010:p1623:b001:l017","ordinal":69847,"en":"That black horse indeed had"},{"id":"manas-2010:p1623:b001:l018","ordinal":69848,"en":"Wings upon his flanks."},{"id":"manas-2010:p1623:b001:l019","ordinal":69849,"en":"He threw the whole world into turmoil;"},{"id":"manas-2010:p1623:b001:l020","ordinal":69850,"en":"His ways were rich in resourcefulness."},{"id":"manas-2010:p1623:b001:l021","ordinal":69851,"en":"Cotton sash and wide boots,"},{"id":"manas-2010:p1623:b001:l022","ordinal":69852,"en":"Kongurbay, khan of the monks,"},{"id":"manas-2010:p1623:b001:l023","ordinal":69853,"en":"Was a champion who knew the enemy's tricks,"},{"id":"manas-2010:p1623:b001:l024","ordinal":69854,"en":"A fellow skilled among spearmen,"},{"id":"manas-2010:p1623:b001:l025","ordinal":69855,"en":"A mighty fellow who knew the enemy's tricks."},{"id":"manas-2010:p1623:b001:l026","ordinal":69856,"en":"He was the support they relied upon,"},{"id":"manas-2010:p1623:b001:l027","ordinal":69857,"en":"He was their fortified refuge."},{"id":"manas-2010:p1623:b001:l028","ordinal":69858,"en":"Of the forty khans under the emperor,"},{"id":"manas-2010:p1623:b001:l029","ordinal":69859,"en":"He was the hero who guarded them."},{"id":"manas-2010:p1623:b001:l030","ordinal":69860,"en":"His spectacles gleamed;"},{"id":"manas-2010:p1623:b001:l031","ordinal":69861,"en":"A bead-stone large as a flask"},{"id":"manas-2010:p1623:b001:l032","ordinal":69862,"en":"Flashed upon his head."},{"id":"manas-2010:p1623:b001:l033","ordinal":69863,"en":"A lacquered pipe with a golden stem,"},{"id":"manas-2010:p1623:b001:l034","ordinal":69864,"en":"A champion beyond other men,"},{"id":"manas-2010:p1623:b001:l035","ordinal":69865,"en":"The Fierce One, huge as a hut,"},{"id":"manas-2010:p1623:b001:l036","ordinal":69866,"en":"His stern face transformed,"},{"id":"manas-2010:p1623:b001:l037","ordinal":69867,"en":"His eyes blazed like fire."},{"id":"manas-2010:p1623:b001:l038","ordinal":69868,"en":"Six thousand Chinese and countless governors"},{"id":"manas-2010:p1623:b001:l039","ordinal":69869,"en":"He drove before him."},{"id":"manas-2010:p1623:b001:l040","ordinal":69870,"en":"That speechless, tumultuous fellow's"},{"id":"manas-2010:p1623:b001:l041","ordinal":69871,"en":"Two eyes blazed."},{"id":"manas-2010:p1623:b001:l042","ordinal":69872,"en":"Those mounted on dapple-roan horses,"},{"id":"manas-2010:p1624:b001:l001","ordinal":69873,"en":"The spearmen, he separated out;"},{"id":"manas-2010:p1624:b001:l002","ordinal":69874,"en":"The marksmen who never missed"},{"id":"manas-2010:p1624:b001:l003","ordinal":69875,"en":"He drove toward the suffering."},{"id":"manas-2010:p1624:b001:l004","ordinal":69876,"en":"The Muslims who watched,"},{"id":"manas-2010:p1624:b001:l005","ordinal":69877,"en":"When they saw the enemy's array,"},{"id":"manas-2010:p1624:b001:l006","ordinal":69878,"en":"Their misery boiled up like this."},{"id":"manas-2010:p1624:b001:l007","ordinal":69879,"en":"The reason it boiled up:"},{"id":"manas-2010:p1624:b001:l008","ordinal":69880,"en":"Hallowed Ali, the lion,"},{"id":"manas-2010:p1624:b001:l009","ordinal":69881,"en":"Had come through this place."},{"id":"manas-2010:p1624:b001:l010","ordinal":69882,"en":"The Flood had never swept in there,"},{"id":"manas-2010:p1624:b001:l011","ordinal":69883,"en":"Alexander had never touched them;"},{"id":"manas-2010:p1624:b001:l012","ordinal":69884,"en":"The Chinese people were intact."},{"id":"manas-2010:p1624:b001:l013","ordinal":69885,"en":"“So many of my giants have died!”"},{"id":"manas-2010:p1624:b001:l014","ordinal":69886,"en":"Alöökö's Kongurbay"},{"id":"manas-2010:p1624:b001:l015","ordinal":69887,"en":"To the emperor's Beijing"},{"id":"manas-2010:p1624:b001:l016","ordinal":69888,"en":"Had sent word."}]
