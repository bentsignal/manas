[{"id":"sayakbay-ms-current145:pdf099:l015","ordinal":395265,"en":"A man turns back and freezes them"},{"id":"sayakbay-ms-current145:pdf099:l016","ordinal":395266,"en":"Such red kumys"},{"id":"sayakbay-ms-current145:pdf099:l017","ordinal":395267,"en":"I set camels by thousands and hundreds"},{"id":"sayakbay-ms-current145:pdf099:l018","ordinal":395268,"en":"After the Creator gave a child"},{"id":"sayakbay-ms-current145:pdf099:l019","ordinal":395269,"en":"I arrayed countless hosts equally"},{"id":"sayakbay-ms-current145:pdf099:l020","ordinal":395270,"en":"I set out herds abundant as spring"},{"id":"sayakbay-ms-current145:pdf099:l021","ordinal":395271,"en":"I offered abundant stock and worldly wealth"},{"id":"sayakbay-ms-current145:pdf099:l022","ordinal":395272,"en":"The people appointed Bermet"},{"id":"sayakbay-ms-current145:pdf099:l023","ordinal":395273,"en":"Making both humps stand high"},{"id":"sayakbay-ms-current145:pdf099:l024","ordinal":395274,"en":"Arching its neck like a duck"},{"id":"sayakbay-ms-current145:pdf099:l025","ordinal":395275,"en":"Choosing camels from the mountain"},{"id":"sayakbay-ms-current145:pdf099:l026","ordinal":395276,"en":"The greatest and finest among them"},{"id":"sayakbay-ms-current145:pdf099:l027","ordinal":395277,"en":"Saying your child is a hero"},{"id":"sayakbay-ms-current145:pdf099:l028","ordinal":395278,"en":"They bore him upon a pole-litter"},{"id":"sayakbay-ms-current145:pdf099:l029","ordinal":395279,"en":"From among their champions"},{"id":"sayakbay-ms-current145:pdf099:l030","ordinal":395280,"en":"To win the horse-racing prize"},{"id":"sayakbay-ms-current145:pdf099:l031","ordinal":395281,"en":"So as not to miss the gathering"},{"id":"sayakbay-ms-current145:pdf099:l032","ordinal":395282,"en":"Training chargers for the contest"},{"id":"sayakbay-ms-current145:pdf100:l001","ordinal":395283,"en":"Many prizes are here"},{"id":"sayakbay-ms-current145:pdf100:l002","ordinal":395284,"en":"To hold this contest"},{"id":"sayakbay-ms-current145:pdf100:l003","ordinal":395285,"en":"Becoming a spectacle before men’s eyes"},{"id":"sayakbay-ms-current145:pdf100:l004","ordinal":395286,"en":"A feast surpassing the world"},{"id":"sayakbay-ms-current145:pdf100:l007","ordinal":395287,"en":"Ninety kinds of entertainment"},{"id":"sayakbay-ms-current145:pdf100:l009","ordinal":395288,"en":"Fathers and sons dispersed"},{"id":"sayakbay-ms-current145:pdf100:l010","ordinal":395289,"en":"The heroes reached fulfillment"},{"id":"sayakbay-ms-current145:pdf100:l011","ordinal":395290,"en":"Taking seven camel colts"},{"id":"sayakbay-ms-current145:pdf100:l012","ordinal":395291,"en":"Seven men contested them"},{"id":"sayakbay-ms-current145:pdf100:l013","ordinal":395292,"en":"Saying, where is misfortune for me"},{"id":"sayakbay-ms-current145:pdf100:l014","ordinal":395293,"en":"Striking as they surged"},{"id":"sayakbay-ms-current145:pdf100:l015","ordinal":395294,"en":"His brief clear counsel"},{"id":"sayakbay-ms-current145:pdf100:l016","ordinal":395295,"en":"Saying, beast, what happened to you"},{"id":"sayakbay-ms-current145:pdf100:l017","ordinal":395296,"en":"Coming face to face with your father"},{"id":"sayakbay-ms-current145:pdf100:l018","ordinal":395297,"en":"The many you took became few"},{"id":"sayakbay-ms-current145:pdf100:l019","ordinal":395298,"en":"They stood as equals"},{"id":"sayakbay-ms-current145:pdf100:l020","ordinal":395299,"en":"Saying, child, come here"},{"id":"sayakbay-ms-current145:pdf100:l021","ordinal":395300,"en":"Resolving it and making peace"},{"id":"sayakbay-ms-current145:pdf100:l022","ordinal":395301,"en":"The celebration was boundless"},{"id":"sayakbay-ms-current145:pdf100:l023","ordinal":395302,"en":"Much of the evening passed"},{"id":"sayakbay-ms-current145:pdf100:l024","ordinal":395303,"en":"Saying the child was named"},{"id":"sayakbay-ms-current145:pdf100:l025","ordinal":395304,"en":"Orphans, widows, and the poor"},{"id":"sayakbay-ms-current145:pdf100:l026","ordinal":395305,"en":"Receiving charity and feasting"},{"id":"sayakbay-ms-current145:pdf100:l027","ordinal":395306,"en":"The qazi received his share"},{"id":"sayakbay-ms-current145:pdf100:l028","ordinal":395307,"en":"A vast world of abundant livestock"},{"id":"sayakbay-ms-current145:pdf100:l029","ordinal":395308,"en":"His gifts were scattered among the people"},{"id":"sayakbay-ms-current145:pdf100:l030","ordinal":395309,"en":"The hero-master found peace"},{"id":"sayakbay-ms-current145:pdf100:l031","ordinal":395310,"en":"All the earth became prosperous"},{"id":"sayakbay-ms-current145:pdf100:l032","ordinal":395311,"en":"While the people shared the spoils"},{"id":"sayakbay-ms-current145:pdf101:l001","ordinal":395312,"en":"Aytolkun marked out the palace ground"},{"id":"sayakbay-ms-current145:pdf101:l002","ordinal":395313,"en":"All proceeded in a row"},{"id":"sayakbay-ms-current145:pdf101:l003","ordinal":395314,"en":"They laid down the yellow robe"},{"id":"sayakbay-ms-current145:pdf101:l004","ordinal":395315,"en":"The father rode bareback"},{"id":"sayakbay-ms-current145:pdf101:l005","ordinal":395316,"en":"The people poured from the great feast"},{"id":"sayakbay-ms-current145:pdf101:l006","ordinal":395317,"en":"The broad city of Kenen"},{"id":"sayakbay-ms-current145:pdf101:l007","ordinal":395318,"en":"The feast crossed the bounds of the land"},{"id":"sayakbay-ms-current145:pdf101:l008","ordinal":395319,"en":"If his child lives safely"},{"id":"sayakbay-ms-current145:pdf101:l009","ordinal":395320,"en":"They left saying he would rule the land"},{"id":"sayakbay-ms-current145:pdf101:l010","ordinal":395321,"en":"The shepherd looked as the khan came"},{"id":"sayakbay-ms-current145:pdf101:l011","ordinal":395322,"en":"Now splendor came from Khydyr"},{"id":"sayakbay-ms-current145:pdf101:l012","ordinal":395323,"en":"The mighty Heaven had come"},{"id":"sayakbay-ms-current145:pdf101:l013","ordinal":395324,"en":"He had consumed nine feasts"},{"id":"sayakbay-ms-current145:pdf101:l014","ordinal":395325,"en":"If this son lives safely"},{"id":"sayakbay-ms-current145:pdf101:l015","ordinal":395326,"en":"Kenen will give glory through the ages"},{"id":"sayakbay-ms-current145:pdf101:l016","ordinal":395327,"en":"White-bearded elders"},{"id":"sayakbay-ms-current145:pdf101:l017","ordinal":395328,"en":"Saying, may he live a long life"},{"id":"sayakbay-ms-current145:pdf101:l018","ordinal":395329,"en":"Heroes of the years"},{"id":"sayakbay-ms-current145:pdf101:l019","ordinal":395330,"en":"Brave warriors in companies of forty"},{"id":"sayakbay-ms-current145:pdf101:l020","ordinal":395331,"en":"Offering kumys and gray prizes"},{"id":"sayakbay-ms-current145:pdf101:l021","ordinal":395332,"en":"Many people made merry"},{"id":"sayakbay-ms-current145:pdf101:l022","ordinal":395333,"en":"Strong men and old souls"},{"id":"sayakbay-ms-current145:pdf101:l023","ordinal":395334,"en":"All kinds of people mingled"},{"id":"sayakbay-ms-current145:pdf101:l024","ordinal":395335,"en":"The master built the broad palace"},{"id":"sayakbay-ms-current145:pdf101:l025","ordinal":395336,"en":"The craftsman shaped it far and wide"},{"id":"sayakbay-ms-current145:pdf101:l026","ordinal":395337,"en":"Two heroes stood together"},{"id":"sayakbay-ms-current145:pdf101:l027","ordinal":395338,"en":"Those who took the honored meat portions"},{"id":"sayakbay-ms-current145:pdf101:l028","ordinal":395339,"en":"Rejoicing after days of grief"},{"id":"sayakbay-ms-current145:pdf101:l029","ordinal":395340,"en":"The lineage of heroic lands"},{"id":"sayakbay-ms-current145:pdf101:l030","ordinal":395341,"en":"As though to see the face of toil"},{"id":"sayakbay-ms-current145:pdf101:l031","ordinal":395342,"en":"Placing a spirit-gift in his hand"},{"id":"sayakbay-ms-current145:pdf101:l032","ordinal":395343,"en":"It became the greatest wonder in the world"},{"id":"sayakbay-ms-current145:pdf102:l001","ordinal":395344,"en":"What twisting flattery"},{"id":"sayakbay-ms-current145:pdf102:l002","ordinal":395345,"en":"That was never placed in the hand"},{"id":"sayakbay-ms-current145:pdf102:l003","ordinal":395346,"en":"Prepared and saddled for the hero"},{"id":"sayakbay-ms-current145:pdf102:l004","ordinal":395347,"en":"Saying, let the people settle in camp"},{"id":"sayakbay-ms-current145:pdf102:l005","ordinal":395348,"en":"This flattery drew many"},{"id":"sayakbay-ms-current145:pdf102:l006","ordinal":395349,"en":"Saying, let his name be Kenen"},{"id":"sayakbay-ms-current145:pdf102:l007","ordinal":395350,"en":"That Kenen’s birth would come"},{"id":"sayakbay-ms-current145:pdf102:l008","ordinal":395351,"en":"Turning toward the broad pasture"},{"id":"sayakbay-ms-current145:pdf102:l009","ordinal":395352,"en":"Khan Borum greatly admired the spectacle"},{"id":"sayakbay-ms-current145:pdf102:l010","ordinal":395353,"en":"Of this slender young child"},{"id":"sayakbay-ms-current145:pdf102:l011","ordinal":395354,"en":"We ate his feast-food"},{"id":"sayakbay-ms-current145:pdf102:l012","ordinal":395355,"en":"We truly drank his kumys"},{"id":"sayakbay-ms-current145:pdf102:l013","ordinal":395356,"en":"The lineage of this precious warrior"},{"id":"sayakbay-ms-current145:pdf102:l014","ordinal":395357,"en":"The fierce enemy was cast down"},{"id":"sayakbay-ms-current145:pdf102:l015","ordinal":395358,"en":"We received the spirit-world’s favor"},{"id":"sayakbay-ms-current145:pdf102:l016","ordinal":395359,"en":"We honored him and shared his robe"},{"id":"sayakbay-ms-current145:pdf102:l017","ordinal":395360,"en":"People held limitless thoughts"},{"id":"sayakbay-ms-current145:pdf102:l018","ordinal":395361,"en":"Seeking alliance with the sovereign"},{"id":"sayakbay-ms-current145:pdf102:l019","ordinal":395362,"en":"There had been no feast as generous as this hero’s"},{"id":"sayakbay-ms-current145:pdf102:l020","ordinal":395363,"en":"It was a deed beyond counting"},{"id":"sayakbay-ms-current145:pdf102:l021","ordinal":395364,"en":"It was weighty; let the people know"},{"id":"sayakbay-ms-current145:pdf102:l022","ordinal":395365,"en":"Kenen became a hero of the people"},{"id":"sayakbay-ms-current145:pdf102:l023","ordinal":395366,"en":"He attained the measure of his destiny"},{"id":"sayakbay-ms-current145:pdf102:l024","ordinal":395367,"en":"Spoken of as a plane-tree banner"},{"id":"sayakbay-ms-current145:pdf102:l025","ordinal":395368,"en":"Possessing strength like a dragon"},{"id":"sayakbay-ms-current145:pdf102:l026","ordinal":395369,"en":"The messenger rode through all the land"},{"id":"sayakbay-ms-current145:pdf102:l027","ordinal":395370,"en":"Saying, my dear child Kenen"},{"id":"sayakbay-ms-current145:pdf102:l028","ordinal":395371,"en":"Pouring tears from his eyes"},{"id":"sayakbay-ms-current145:pdf102:l029","ordinal":395372,"en":"Saying he would take the whole world"},{"id":"sayakbay-ms-current145:pdf102:l030","ordinal":395373,"en":"Let his elder be known to the people"},{"id":"sayakbay-ms-current145:pdf102:l031","ordinal":395374,"en":"Let the thoughtful people reflect"},{"id":"sayakbay-ms-current145:pdf102:l032","ordinal":395375,"en":"May he be khan over the commanders"},{"id":"sayakbay-ms-current145:pdf103:l001","ordinal":395376,"en":"To the child of Kyzyrkan"},{"id":"sayakbay-ms-current145:pdf103:l002","ordinal":395377,"en":"May the forty saints themselves be his allies"},{"id":"sayakbay-ms-current145:pdf103:l003","ordinal":395378,"en":"May God set his road right"},{"id":"sayakbay-ms-current145:pdf103:l004","ordinal":395379,"en":"May the forty saints grant Khydyr’s blessing"},{"id":"sayakbay-ms-current145:pdf103:l005","ordinal":395380,"en":"May he prevail over opposing hosts"},{"id":"sayakbay-ms-current145:pdf103:l006","ordinal":395381,"en":"For this dear gray wolf Kenen"},{"id":"sayakbay-ms-current145:pdf103:l007","ordinal":395382,"en":"Say it again: may it be good"},{"id":"sayakbay-ms-current145:pdf103:l008","ordinal":395383,"en":"How shall we plead for him"},{"id":"sayakbay-ms-current145:pdf103:l009","ordinal":395384,"en":"The offering we made for the child"},{"id":"sayakbay-ms-current145:pdf103:l010","ordinal":395385,"en":"Our plane-tree fortune upon his brow"},{"id":"sayakbay-ms-current145:pdf103:l011","ordinal":395386,"en":"A son of truly lofty worth"},{"id":"sayakbay-ms-current145:pdf103:l012","ordinal":395387,"en":"If this child lives safely"},{"id":"sayakbay-ms-current145:pdf103:l013","ordinal":395388,"en":"We are the encircled black city"},{"id":"sayakbay-ms-current145:pdf103:l014","ordinal":395389,"en":"Whether youth or elder"},{"id":"sayakbay-ms-current145:pdf103:l015","ordinal":395390,"en":"We bow our necks to the child"},{"id":"sayakbay-ms-current145:pdf103:l016","ordinal":395391,"en":"Saying flame shines on his brow"},{"id":"sayakbay-ms-current145:pdf103:l017","ordinal":395392,"en":"We take this as our strength"},{"id":"sayakbay-ms-current145:pdf103:l018","ordinal":395393,"en":"Our sheltering plane tree"},{"id":"sayakbay-ms-current145:pdf103:l019","ordinal":395394,"en":"My child, may his life be strong"},{"id":"sayakbay-ms-current145:pdf103:l020","ordinal":395395,"en":"We shall rest under dark protection"},{"id":"sayakbay-ms-current145:pdf103:l021","ordinal":395396,"en":"The people cried out and spoke their need"},{"id":"sayakbay-ms-current145:pdf103:l022","ordinal":395397,"en":"The elder raised his hands"},{"id":"sayakbay-ms-current145:pdf103:l023","ordinal":395398,"en":"The people departed as if in prayer"},{"id":"sayakbay-ms-current145:pdf103:l024","ordinal":395399,"en":"Kenen mounted his horse"},{"id":"sayakbay-ms-current145:pdf103:l027","ordinal":395400,"en":"May he be khan of the multitudes"},{"id":"sayakbay-ms-current145:pdf103:l031","ordinal":395401,"en":"He was ready for this life"},{"id":"sayakbay-ms-current145:pdf103:l032","ordinal":395402,"en":"His presence enriched the people"},{"id":"sayakbay-ms-current145:pdf104:l001","ordinal":395403,"en":"He made their lattice walls prosperous"},{"id":"sayakbay-ms-current145:pdf104:l002","ordinal":395404,"en":"He enriched the people for whom he was an eye"},{"id":"sayakbay-ms-current145:pdf104:l006","ordinal":395405,"en":"In the lineage of this stock"},{"id":"sayakbay-ms-current145:pdf104:l008","ordinal":395406,"en":"A man with two hundred coats"},{"id":"sayakbay-ms-current145:pdf104:l009","ordinal":395407,"en":"He raided peoples and caused ruin"},{"id":"sayakbay-ms-current145:pdf104:l010","ordinal":395408,"en":"This kinsman suffered from deceit"},{"id":"sayakbay-ms-current145:pdf104:l015","ordinal":395409,"en":"He was the man who struck down both"},{"id":"sayakbay-ms-current145:pdf104:l020","ordinal":395410,"en":"He cast tumult across this world"},{"id":"sayakbay-ms-current145:pdf104:l021","ordinal":395411,"en":"This fighter followed a ruinous road"},{"id":"sayakbay-ms-current145:pdf104:l022","ordinal":395412,"en":"Old Kuspur took one"},{"id":"sayakbay-ms-current145:pdf104:l023","ordinal":395413,"en":"He made that one into a people"},{"id":"sayakbay-ms-current145:pdf104:l024","ordinal":395414,"en":"Your son himself was absent"},{"id":"sayakbay-ms-current145:pdf104:l025","ordinal":395415,"en":"The raiders trampled out a road"},{"id":"sayakbay-ms-current145:pdf104:l026","ordinal":395416,"en":"Dwelling along the river valleys"},{"id":"sayakbay-ms-current145:pdf104:l027","ordinal":395417,"en":"Where passing men made homes"},{"id":"sayakbay-ms-current145:pdf104:l028","ordinal":395418,"en":"A thousand spears went to the mountain"},{"id":"sayakbay-ms-current145:pdf104:l029","ordinal":395419,"en":"What a man descended from Tobokel"},{"id":"sayakbay-ms-current145:pdf104:l030","ordinal":395420,"en":"From what lineage was his blood"},{"id":"sayakbay-ms-current145:pdf104:l031","ordinal":395421,"en":"Black-mace Oroybek"},{"id":"sayakbay-ms-current145:pdf105:l001","ordinal":395422,"en":"That old Oroybek accepted the faith"},{"id":"sayakbay-ms-current145:pdf105:l002","ordinal":395423,"en":"Lord Kurguk took his daughter"},{"id":"sayakbay-ms-current145:pdf105:l003","ordinal":395424,"en":"He crushed and destroyed them"},{"id":"sayakbay-ms-current145:pdf105:l004","ordinal":395425,"en":"Dear Kozoy was a khan"},{"id":"sayakbay-ms-current145:pdf105:l005","ordinal":395426,"en":"He brought all of them low"},{"id":"sayakbay-ms-current145:pdf105:l006","ordinal":395427,"en":"Ebedey and Kozoy, two giants"},{"id":"sayakbay-ms-current145:pdf105:l014","ordinal":395428,"en":"Coming with a great host to fight"},{"id":"sayakbay-ms-current145:pdf105:l015","ordinal":395429,"en":"Turning, saying, here is the black one"},{"id":"sayakbay-ms-current145:pdf105:l017","ordinal":395430,"en":"Ebedey and Kozoy set out"},{"id":"sayakbay-ms-current145:pdf105:l018","ordinal":395431,"en":"They went into hardship"},{"id":"sayakbay-ms-current145:pdf105:l021","ordinal":395432,"en":"Those men drove on in vain"},{"id":"sayakbay-ms-current145:pdf105:l022","ordinal":395433,"en":"There was no success"},{"id":"sayakbay-ms-current145:pdf105:l026","ordinal":395434,"en":"May no dark day fall upon your head"},{"id":"sayakbay-ms-current145:pdf105:l027","ordinal":395435,"en":"A road gathered toward paradise"},{"id":"sayakbay-ms-current145:pdf105:l030","ordinal":395436,"en":"Hearing the taunting words to the people"},{"id":"sayakbay-ms-current145:pdf106:l005","ordinal":395437,"en":"Tumult rose from where you camped"},{"id":"sayakbay-ms-current145:pdf106:l007","ordinal":395438,"en":"His hardening wrath was strong"},{"id":"sayakbay-ms-current145:pdf106:l008","ordinal":395439,"en":"What you saw had not existed"},{"id":"sayakbay-ms-current145:pdf106:l009","ordinal":395440,"en":"Saying that, abandon hope in life"},{"id":"sayakbay-ms-current145:pdf106:l010","ordinal":395441,"en":"Taking eighty champion companions"},{"id":"sayakbay-ms-current145:pdf106:l011","ordinal":395442,"en":"A hero remained with Olbu"},{"id":"sayakbay-ms-current145:pdf106:l012","ordinal":395443,"en":"Those who remained said, enter by oath"},{"id":"sayakbay-ms-current145:pdf106:l014","ordinal":395444,"en":"They pierced and made a path"},{"id":"sayakbay-ms-current145:pdf106:l019","ordinal":395445,"en":"His hooked nose was like a shield"},{"id":"sayakbay-ms-current145:pdf106:l020","ordinal":395446,"en":"Driving the red-necked one"},{"id":"sayakbay-ms-current145:pdf106:l021","ordinal":395447,"en":"Like a mountain set down"},{"id":"sayakbay-ms-current145:pdf106:l022","ordinal":395448,"en":"The orphan heir guarding the land"},{"id":"sayakbay-ms-current145:pdf106:l023","ordinal":395449,"en":"Among beasts that wielded bows"},{"id":"sayakbay-ms-current145:pdf106:l024","ordinal":395450,"en":"A hero who caught mankind’s eye"},{"id":"sayakbay-ms-current145:pdf106:l025","ordinal":395451,"en":"Struck down like spring lightning"},{"id":"sayakbay-ms-current145:pdf106:l026","ordinal":395452,"en":"Enduring this, he took companions"},{"id":"sayakbay-ms-current145:pdf106:l027","ordinal":395453,"en":"Chyngyr Kozoy burned with grief"},{"id":"sayakbay-ms-current145:pdf106:l028","ordinal":395454,"en":"Turning back without faltering"},{"id":"sayakbay-ms-current145:pdf106:l029","ordinal":395455,"en":"He turned away from his wrath"},{"id":"sayakbay-ms-current145:pdf106:l030","ordinal":395456,"en":"The hero prepared to mount"},{"id":"sayakbay-ms-current145:pdf106:l031","ordinal":395457,"en":"He turned toward the multitude"},{"id":"sayakbay-ms-current145:pdf107:l001","ordinal":395458,"en":"Ebedey and Kozoy, two lions"},{"id":"sayakbay-ms-current145:pdf107:l002","ordinal":395459,"en":"Holding their spears"},{"id":"sayakbay-ms-current145:pdf107:l003","ordinal":395460,"en":"The hero Seytek upon his horse"},{"id":"sayakbay-ms-current145:pdf107:l004","ordinal":395461,"en":"Clashing beneath white caps"},{"id":"sayakbay-ms-current145:pdf107:l005","ordinal":395462,"en":"Roaring like great wolves"},{"id":"sayakbay-ms-current145:pdf107:l006","ordinal":395463,"en":"Among his kin and men"},{"id":"sayakbay-ms-current145:pdf107:l007","ordinal":395464,"en":"Asking what to do among the people"},{"id":"sayakbay-ms-current145:pdf107:l008","ordinal":395465,"en":"Suffering thundered around them"},{"id":"sayakbay-ms-current145:pdf107:l009","ordinal":395466,"en":"Putting on their armor and swords"},{"id":"sayakbay-ms-current145:pdf107:l010","ordinal":395467,"en":"A red-mottled black shaft"},{"id":"sayakbay-ms-current145:pdf107:l015","ordinal":395468,"en":"Prepared to contend from then on"},{"id":"sayakbay-ms-current145:pdf107:l016","ordinal":395469,"en":"The young men went forth at sunrise"},{"id":"sayakbay-ms-current145:pdf107:l017","ordinal":395470,"en":"A thousand under the hero’s shadow went out"},{"id":"sayakbay-ms-current145:pdf107:l018","ordinal":395471,"en":"Driving the devil’s daughter by the muzzle"},{"id":"sayakbay-ms-current145:pdf107:l019","ordinal":395472,"en":"The pale one Keltet"},{"id":"sayakbay-ms-current145:pdf107:l020","ordinal":395473,"en":"The demon-devil led them astray"},{"id":"sayakbay-ms-current145:pdf107:l021","ordinal":395474,"en":"Meeting the spirit-blessed warrior"},{"id":"sayakbay-ms-current145:pdf107:l022","ordinal":395475,"en":"Keltet mounted his horse"},{"id":"sayakbay-ms-current145:pdf107:l023","ordinal":395476,"en":"They cried out before Khan Chynka"},{"id":"sayakbay-ms-current145:pdf107:l024","ordinal":395477,"en":"Those who grappled remained"},{"id":"sayakbay-ms-current145:pdf107:l025","ordinal":395478,"en":"The enemy pressed toward Talas"},{"id":"sayakbay-ms-current145:pdf107:l026","ordinal":395479,"en":"Keltet cut the road"},{"id":"sayakbay-ms-current145:pdf107:l027","ordinal":395480,"en":"Raising a sacred standard"},{"id":"sayakbay-ms-current145:pdf107:l028","ordinal":395481,"en":"Keltet launched the attack"},{"id":"sayakbay-ms-current145:pdf107:l029","ordinal":395482,"en":"Of Ebedey and Kozoy, the two"},{"id":"sayakbay-ms-current145:pdf107:l030","ordinal":395483,"en":"The Chinese enemy against the Kyrgyz"},{"id":"sayakbay-ms-current145:pdf107:l031","ordinal":395484,"en":"Keltet attacked"},{"id":"sayakbay-ms-current145:pdf108:l001","ordinal":395485,"en":"With his moon-bright sword"},{"id":"sayakbay-ms-current145:pdf108:l002","ordinal":395486,"en":"He comes saying he will take revenge"},{"id":"sayakbay-ms-current145:pdf108:l003","ordinal":395487,"en":"The red-marked one goes under the moon"},{"id":"sayakbay-ms-current145:pdf108:l004","ordinal":395488,"en":"Let him rejoice when the host meets"},{"id":"sayakbay-ms-current145:pdf108:l005","ordinal":395489,"en":"The thousands who saw the fierce one"},{"id":"sayakbay-ms-current145:pdf108:l006","ordinal":395490,"en":"The daughter of the khan of Kashgar"},{"id":"sayakbay-ms-current145:pdf108:l007","ordinal":395491,"en":"May she calm the courageous one"},{"id":"sayakbay-ms-current145:pdf108:l008","ordinal":395492,"en":"He says, I will cast your name from the palace"},{"id":"sayakbay-ms-current145:pdf108:l009","ordinal":395493,"en":"Janaly and Karak, two men"},{"id":"sayakbay-ms-current145:pdf108:l010","ordinal":395494,"en":"Saying, I will take a spoonful of his blood"},{"id":"sayakbay-ms-current145:pdf108:l011","ordinal":395495,"en":"Taking no counsel from the troubled place"},{"id":"sayakbay-ms-current145:pdf108:l012","ordinal":395496,"en":"Taking no arrow from the field"},{"id":"sayakbay-ms-current145:pdf108:l013","ordinal":395497,"en":"Saying, let the men die"},{"id":"sayakbay-ms-current145:pdf108:l014","ordinal":395498,"en":"They stood tall and advanced"},{"id":"sayakbay-ms-current145:pdf108:l015","ordinal":395499,"en":"Looking toward the steep ground"},{"id":"sayakbay-ms-current145:pdf108:l016","ordinal":395500,"en":"Ebedey and Kozoy, two men"},{"id":"sayakbay-ms-current145:pdf108:l020","ordinal":395501,"en":"Great Kongdu fastened his load"},{"id":"sayakbay-ms-current145:pdf108:l022","ordinal":395502,"en":"Crossing the pass toward the city"},{"id":"sayakbay-ms-current145:pdf108:l023","ordinal":395503,"en":"Now forced to sustain them"},{"id":"sayakbay-ms-current145:pdf108:l025","ordinal":395504,"en":"They raced them back across the plain"},{"id":"sayakbay-ms-current145:pdf108:l026","ordinal":395505,"en":"Countless men flashed their swords"},{"id":"sayakbay-ms-current145:pdf108:l027","ordinal":395506,"en":"They watched and joined battle"},{"id":"sayakbay-ms-current145:pdf108:l028","ordinal":395507,"en":"Taking round measures of grain"},{"id":"sayakbay-ms-current145:pdf108:l029","ordinal":395508,"en":"Taking nine animals for slaughter"},{"id":"sayakbay-ms-current145:pdf108:l030","ordinal":395509,"en":"Eating the finest colt of the herd"},{"id":"sayakbay-ms-current145:pdf108:l031","ordinal":395510,"en":"Consuming nine portions of rich fat"},{"id":"sayakbay-ms-current145:pdf109:l001","ordinal":395511,"en":"They pursued for two days"},{"id":"sayakbay-ms-current145:pdf109:l002","ordinal":395512,"en":"Settlements like gardens"},{"id":"sayakbay-ms-current145:pdf109:l003","ordinal":395513,"en":"As though his elder Karak had died"},{"id":"sayakbay-ms-current145:pdf109:l004","ordinal":395514,"en":"He seized it with great force"},{"id":"sayakbay-ms-current145:pdf109:l005","ordinal":395515,"en":"Lying upon every mountain"},{"id":"sayakbay-ms-current145:pdf109:l006","ordinal":395516,"en":"Thousands clashed in calamity"},{"id":"sayakbay-ms-current145:pdf109:l007","ordinal":395517,"en":"They received the enemy’s fire"},{"id":"sayakbay-ms-current145:pdf109:l008","ordinal":395518,"en":"They fell upon the road"},{"id":"sayakbay-ms-current145:pdf109:l009","ordinal":395519,"en":"There was a pacer"},{"id":"sayakbay-ms-current145:pdf109:l010","ordinal":395520,"en":"They drove hard along the road"}]
