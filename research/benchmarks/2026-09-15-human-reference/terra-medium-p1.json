{
  "lines": [
    {"line": 1, "english": "Argyn and Kyrgyz, intermingled,", "note": ""},
    {"line": 2, "english": "when they had camped along the river,", "note": ""},
    {"line": 3, "english": "when Karakan passed from this world", "note": ""},
    {"line": 4, "english": "and it was as though a fire had gone out,", "note": ""},
    {"line": 5, "english": "not a soul was left to resist,", "note": ""},
    {"line": 6, "english": "to utter words of defiance;", "note": ""},
    {"line": 7, "english": "of the great multitude, none was left.", "note": ""},
    {"line": 8, "english": "Molto Khan of the Chinese", "note": ""},
    {"line": 9, "english": "began the slaughter.", "note": ""},
    {"line": 10, "english": "Those who offered resistance", "note": ""},
    {"line": 11, "english": "he slaughtered relentlessly.", "note": ""},
    {"line": 12, "english": "He judged his strength to be greater;", "note": ""},
    {"line": 13, "english": "whoever spoke back", "note": ""},
    {"line": 14, "english": "he dyed in crimson blood.", "note": ""},
    {"line": 15, "english": "He spared not a thread of life.", "note": ""},
    {"line": 16, "english": "When he had grown emboldened,", "note": ""},
    {"line": 17, "english": "of the many Kyrgyz and Argyn", "note": ""},
    {"line": 18, "english": "the blood flowed like water.", "note": ""},
    {"line": 19, "english": "Karakan came to mind,", "note": ""},
    {"line": 20, "english": "and the many peoples wept.", "note": ""}
  ]
}
